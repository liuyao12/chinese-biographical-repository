          "end": 1,
          "surface": "頠"
        },
        "subject_resolution_seed": {
          "chapter_id": "c-jinshu-035-peikai-family",
          "paragraph_id": "c-jinshu-035-peikai-family:p019",
          "mention_id": "c-jinshu-035-peikai-family:p019:m0054",
          "surface": "頠",
          "quote": "初，裴、王二族盛于魏晉之世，時人以為八裴方八王：徽比王祥，楷比王衍，康比王綏，綽比王澄，瓚比王敦，遐比王導，頠比王戎，邈比王玄雲。",
          "chapter_path": "corpus/jinshu/035-pei-family.json"
        }
