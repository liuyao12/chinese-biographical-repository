    "person_reference_occurrences": [
      {
        "id": "c-songshu-047-meng-family-passages:p002:r0035",
        "paragraph_id": "c-songshu-047-meng-family-passages:p002",
        "start": 35,
        "end": 36,
        "surface": "己",
        "person_id": "zuf_v5v_18s",
        "referent_role": "speaker_self",
        "quote": "丁父艱，懷玉有孝性，因抱篤疾，上表陳解，不許。又自陳弟仙客出繼，喪主唯己，乃見聽。",
        "note": "依本段敘事、稱謂及語者受者定。"
      },
      {
        "id": "c-songshu-047-meng-family-passages:p005:r0013",
        "paragraph_id": "c-songshu-047-meng-family-passages:p005",
        "start": 13,
        "end": 15,
        "surface": "太祖",
        "person_id": "3bh_k4m_fg4",
        "referent_role": "third_person",
        "quote": "無子，弟仙客以子微生嗣封。太祖元嘉中，有罪奪爵，徙廣州。以微生弟彥祖子佛護襲爵。齊受禪，國除。",
        "note": "依本段敘事、稱謂及語者受者定。"
      },
      {
        "id": "c-songshu-047-meng-family-passages:p006:r0000",
        "paragraph_id": "c-songshu-047-meng-family-passages:p006",
        "start": 0,
        "end": 2,
        "surface": "孝武",
        "person_id": "hx8_st4_jdd",
        "referent_role": "third_person",
        "quote": "孝武大明初，諸流徙者悉聽還本，微生已死，子係祖歸京都，有筋榦異力，能儋負數人。",
        "note": "依本段敘事、稱謂及語者受者定。"
      }
    ]
  },
  "paragraphs": [
    {
      "id": "c-songshu-047-meng-family-passages:p001",
      "text": "孟懷玉，平昌安丘人也。高祖珩，晉河南尹。祖淵，右光祿大夫。父綽，義旗後為給事中，光祿勳，追贈金紫光祿大夫。世居京口。",
      "text_layer": "received_chapter",
      "annotation_status": "reviewed",
