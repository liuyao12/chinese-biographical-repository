        "person_id": "1b7_36b_29b_A",
        "source_quote": "謂宜更量課限，使得存立。",
        "reading": "請重定米額。",
        "note": "請重定米額。",
        "paragraph_id": "c-songshu-092-xuhuo:p003",
        "start_codepoint": 154,
        "end_codepoint": 166,
        "human_reviewed": false
      },
      {
