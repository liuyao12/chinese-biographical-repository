    "source_reading_cases": [
      {
        "id": "c-nanqishu-049-wanghui-complete:received_sentence1-0",
        "kind": "received_sentence",
        "person_id": "1tc_q18_x7v_B",
        "source_quote": "繢字叔素，宋車騎將軍景文子也。",
        "reading": "王繢字叔素，父王景文即王彧。",
        "note": "王繢字叔素，父王景文即王彧。",
        "paragraph_id": "c-nanqishu-049-wanghui-complete:p001",
        "start_codepoint": 0,
        "end_codepoint": 15,
        "human_reviewed": false
      },
      {
        "id": "c-nanqishu-049-wanghui-complete:received_sentence1-15",
        "kind": "received_sentence",
        "person_id": "1tc_q18_x7v_B",
        "source_quote": "弱冠，爲祕書郎，太子舍人，轉中書舍人。",
        "reading": "弱冠入仕，任祕書郎、太子舍人、中書舍人。",
        "note": "弱冠入仕，任祕書郎、太子舍人、中書舍人。",
        "paragraph_id": "c-nanqishu-049-wanghui-complete:p001",
        "start_codepoint": 15,
        "end_codepoint": 34,
        "human_reviewed": false
      },
      {
        "id": "c-nanqishu-049-wanghui-complete:received_sentence1-34",
        "kind": "received_sentence",
        "person_id": "1tc_q18_x7v_B",
        "source_quote": "景文以此授超階，令繢經年乃受。",
        "reading": "景文以任命越階，令兒子逾年方受。",
        "note": "景文以任命越階，令兒子逾年方受。",
        "paragraph_id": "c-nanqishu-049-wanghui-complete:p001",
        "start_codepoint": 34,
        "end_codepoint": 49,
        "human_reviewed": false
      },
      {
        "id": "c-nanqishu-049-wanghui-complete:received_sentence1-49",
        "kind": "received_sentence",
        "person_id": "1tc_q18_x7v_B",
        "source_quote": "景文封江安侯，繢襲其本爵，爲始平縣五等男。",
        "reading": "父封江安侯，繢所襲父之原爵為始平縣五等男。",
        "note": "父封江安侯，繢所襲父之原爵為始平縣五等男。",
        "paragraph_id": "c-nanqishu-049-wanghui-complete:p001",
        "start_codepoint": 49,
        "end_codepoint": 70,
        "human_reviewed": false
      },
      {
        "id": "c-nanqishu-049-wanghui-complete:received_sentence1-70",
        "kind": "received_sentence",
        "person_id": "1tc_q18_x7v_B",
        "source_quote": "遷祕書丞，司徒右長史。",
        "reading": "遷祕書丞及司徒右長史。",
        "note": "遷祕書丞及司徒右長史。",
        "paragraph_id": "c-nanqishu-049-wanghui-complete:p001",
        "start_codepoint": 70,
        "end_codepoint": 81,
        "human_reviewed": false
      },
      {
        "id": "c-nanqishu-049-wanghui-complete:received_sentence1-81",
        "kind": "received_sentence",
        "person_id": "1tc_q18_x7v_B",
        "source_quote": "元徽末，除寧朔將軍、建平王征北長史、南東海太守，黃門郎，寧朔將軍、東陽太守。",
        "reading": "元徽末出任諸官，建平王為宋宗室劉景素。",
        "note": "元徽末出任諸官，建平王為宋宗室劉景素。",
        "paragraph_id": "c-nanqishu-049-wanghui-complete:p001",
        "start_codepoint": 81,
        "end_codepoint": 119,
        "human_reviewed": false
      },
      {
        "id": "c-nanqishu-049-wanghui-complete:received_sentence1-119",
        "kind": "received_sentence",
        "person_id": "1tc_q18_x7v_B",
        "source_quote": "世祖爲撫軍，吏部尚書張岱選繢爲長史，呈選牒。",
        "reading": "齊武帝尚在撫軍府，張岱選王繢為長史。",
        "note": "齊武帝尚在撫軍府，張岱選王繢為長史。",
        "paragraph_id": "c-nanqishu-049-wanghui-complete:p001",
        "start_codepoint": 119,
        "end_codepoint": 141,
        "human_reviewed": false
      },
      {
        "id": "c-nanqishu-049-wanghui-complete:received_sentence1-141",
        "kind": "received_sentence",
        "person_id": "1tc_q18_x7v_B",
        "source_quote": "太祖笑謂岱曰：「此可謂素望。」",
        "reading": "齊高帝聞選牒，稱素望。",
        "note": "齊高帝聞選牒，稱素望。",
        "paragraph_id": "c-nanqishu-049-wanghui-complete:p001",
        "start_codepoint": 141,
        "end_codepoint": 156,
        "human_reviewed": false
      },
      {
        "id": "c-nanqishu-049-wanghui-complete:received_sentence1-156",
        "kind": "received_sentence",
        "person_id": "1tc_q18_x7v_B",
        "source_quote": "遷散騎常侍，驍騎將軍。",
        "reading": "遷散騎常侍、驍騎將軍。",
        "note": "遷散騎常侍、驍騎將軍。",
        "paragraph_id": "c-nanqishu-049-wanghui-complete:p001",
        "start_codepoint": 156,
        "end_codepoint": 167,
        "human_reviewed": false
      },
      {
        "id": "c-nanqishu-049-wanghui-complete:received_sentence2-0",
        "kind": "received_sentence",
        "person_id": "1tc_q18_x7v_B",
        "source_quote": "出補義興太守。",
        "reading": "補義興太守。",
        "note": "補義興太守。",
        "paragraph_id": "c-nanqishu-049-wanghui-complete:p002",
        "start_codepoint": 0,
        "end_codepoint": 7,
        "human_reviewed": false
      },
      {
        "id": "c-nanqishu-049-wanghui-complete:received_sentence2-7",
        "kind": "received_sentence",
        "person_id": "1tc_q18_x7v_B",
        "source_quote": "輙錄郡吏陳伯喜付陽羨獄，欲殺之，縣令孔逭不知何罪，不受繢教，爲有司所奏，繢坐白衣領職。",
        "reading": "擅押陳伯喜入陽羨獄，孔逭以不知罪拒令，繢坐白衣領職。",
        "note": "擅押陳伯喜入陽羨獄，孔逭以不知罪拒令，繢坐白衣領職。",
        "paragraph_id": "c-nanqishu-049-wanghui-complete:p002",
        "start_codepoint": 7,
        "end_codepoint": 50,
        "human_reviewed": false
      },
      {
        "id": "c-nanqishu-049-wanghui-complete:received_sentence2-50",
        "kind": "received_sentence",
        "person_id": "1tc_q18_x7v_B",
        "source_quote": "遷太子中庶子，領驍騎，轉長兼侍中。",
        "reading": "遷太子中庶子、領驍騎、長兼侍中。",
        "note": "遷太子中庶子、領驍騎、長兼侍中。",
        "paragraph_id": "c-nanqishu-049-wanghui-complete:p002",
        "start_codepoint": 50,
        "end_codepoint": 67,
        "human_reviewed": false
      },
      {
        "id": "c-nanqishu-049-wanghui-complete:received_sentence2-67",
        "kind": "received_sentence",
        "person_id": "1tc_q18_x7v_B",
        "source_quote": "世祖出射雉，繢信佛法，稱疾不從駕。",
        "reading": "武帝射雉，繢信佛、稱疾不從。",
        "note": "武帝射雉，繢信佛、稱疾不從。",
        "paragraph_id": "c-nanqishu-049-wanghui-complete:p002",
        "start_codepoint": 67,
        "end_codepoint": 84,
        "human_reviewed": false
      },
      {
        "id": "c-nanqishu-049-wanghui-complete:received_sentence2-84",
        "kind": "received_sentence",
        "person_id": "1tc_q18_x7v_B",
        "source_quote": "轉左民尚書，以母老乞解職，改授寧朔將軍、大司馬長史、淮陵太守。",
        "reading": "左民尚書時以母老乞解，改授寧朔、大司馬長史、淮陵太守。",
        "note": "左民尚書時以母老乞解，改授寧朔、大司馬長史、淮陵太守。",
        "paragraph_id": "c-nanqishu-049-wanghui-complete:p002",
        "start_codepoint": 84,
        "end_codepoint": 115,
        "human_reviewed": false
      },
      {
        "id": "c-nanqishu-049-wanghui-complete:received_sentence2-115",
        "kind": "received_sentence",
        "person_id": "1tc_q18_x7v_B",
        "source_quote": "出爲宣城太守，秩中二千石。",
        "reading": "宣城太守秩中二千石。",
        "note": "宣城太守秩中二千石。",
        "paragraph_id": "c-nanqishu-049-wanghui-complete:p002",
        "start_codepoint": 115,
        "end_codepoint": 128,
        "human_reviewed": false
      },
      {
        "id": "c-nanqishu-049-wanghui-complete:received_sentence2-128",
        "kind": "received_sentence",
        "person_id": "1tc_q18_x7v_B",
        "source_quote": "隆昌元年，遷輔國將軍、太傅長史，不拜。",
        "reading": "隆昌元年擬授輔國將軍、太傅長史，明書不拜。",
        "note": "隆昌元年擬授輔國將軍、太傅長史，明書不拜。",
        "paragraph_id": "c-nanqishu-049-wanghui-complete:p002",
        "start_codepoint": 128,
        "end_codepoint": 147,
        "human_reviewed": false
      },
      {
        "id": "c-nanqishu-049-wanghui-complete:received_sentence2-147",
        "kind": "received_sentence",
        "person_id": "1tc_q18_x7v_B",
        "source_quote": "仍爲冠軍將軍、豫章內史。",
        "reading": "仍爲冠軍將軍、豫章內史。",
        "note": "仍爲冠軍將軍、豫章內史。",
        "paragraph_id": "c-nanqishu-049-wanghui-complete:p002",
        "start_codepoint": 147,
        "end_codepoint": 159,
        "human_reviewed": false
      },
      {
        "id": "c-nanqishu-049-wanghui-complete:received_sentence2-159",
        "kind": "received_sentence",
        "person_id": "1tc_q18_x7v_B",
        "source_quote": "進號征虜。",
        "reading": "進號征虜。",
        "note": "進號征虜。",
        "paragraph_id": "c-nanqishu-049-wanghui-complete:p002",
        "start_codepoint": 159,
        "end_codepoint": 164,
        "human_reviewed": false
      },
      {
        "id": "c-nanqishu-049-wanghui-complete:received_sentence2-164",
        "kind": "received_sentence",
        "person_id": "1tc_q18_x7v_B",
        "source_quote": "又坐事免官。",
        "reading": "坐事免官，案情未載。",
        "note": "坐事免官，案情未載。",
        "paragraph_id": "c-nanqishu-049-wanghui-complete:p002",
        "start_codepoint": 164,
        "end_codepoint": 170,
        "human_reviewed": false
      },
      {
        "id": "c-nanqishu-049-wanghui-complete:received_sentence2-170",
        "kind": "received_sentence",
        "person_id": "1tc_q18_x7v_B",
        "source_quote": "除冠軍將軍，司徒左長史，散騎常侍，隨王師。",
        "reading": "後除冠軍將軍等四職，隨王未具名。",
        "note": "後除冠軍將軍等四職，隨王未具名。",
        "paragraph_id": "c-nanqishu-049-wanghui-complete:p002",
        "start_codepoint": 170,
        "end_codepoint": 191,
        "human_reviewed": false
      },
      {
        "id": "c-nanqishu-049-wanghui-complete:received_sentence2-191",
        "kind": "received_sentence",
        "person_id": "1tc_q18_x7v_B",
        "source_quote": "除征虜將軍，驃騎長史，遷散騎常侍，太常。",
        "reading": "再除征虜、驃騎長史，遷散騎常侍、太常。",
        "note": "再除征虜、驃騎長史，遷散騎常侍、太常。",
        "paragraph_id": "c-nanqishu-049-wanghui-complete:p002",
        "start_codepoint": 191,
        "end_codepoint": 211,
        "human_reviewed": false
      },
      {
        "id": "c-nanqishu-049-wanghui-complete:received_sentence2-211",
        "kind": "received_sentence",
        "person_id": "1tc_q18_x7v_B",
        "source_quote": "永元元年，卒。",
        "reading": "永元元年卒。",
        "note": "永元元年卒。",
        "paragraph_id": "c-nanqishu-049-wanghui-complete:p002",
        "start_codepoint": 211,
        "end_codepoint": 218,
        "human_reviewed": false
      },
      {
        "id": "c-nanqishu-049-wanghui-complete:received_sentence2-218",
        "kind": "received_sentence",
        "person_id": "1tc_q18_x7v_B",
        "source_quote": "年五十三。",
        "reading": "報齡五十三。",
        "note": "報齡五十三。",
        "paragraph_id": "c-nanqishu-049-wanghui-complete:p002",
        "start_codepoint": 218,
        "end_codepoint": 223,
        "human_reviewed": false
      },
      {
        "id": "c-nanqishu-049-wanghui-complete:received_sentence2-223",
        "kind": "received_sentence",
        "person_id": "1tc_q18_x7v_B",
        "source_quote": "諡靖子。",
        "reading": "卒後諡靖子。",
        "note": "卒後諡靖子。",
        "paragraph_id": "c-nanqishu-049-wanghui-complete:p002",
