      "source_position": {
        "revision_id": "cbr-ai-transcription-sha256:6284922e1941e437d1f811b09c49d6fc1c312b155cd552a31aa40634cdfafd5b",
        "source_layer": "received_biography",
        "column_projection": [
          {
            "pdf_page": 3,
            "half": "左",
            "leaf": "二上",
            "column_from_right": 7,
            "start": 1,
            "end": 21,
            "text": "后母桓氏夢吞玉勝生后時有紫光滿室以告壽之"
          },
          {
            "pdf_page": 3,
            "half": "左",
            "leaf": "二上",
            "column_from_right": 8,
            "start": 0,
            "end": 21,
            "text": "壽之曰恨非是男桓曰雖女亦足興家矣后每寢臥家"
          },
          {
            "pdf_page": 3,
            "half": "左",
            "leaf": "二上",
            "column_from_right": 9,
            "start": 0,
            "end": 21,
            "text": "人常見上如有雲氣焉年十餘歲歸太祖嚴正有禮法"
          },
          {
            "pdf_page": 3,
            "half": "左",
            "leaf": "二上",
            "column_from_right": 10,
            "start": 0,
            "end": 21,
            "text": "家庭肅然宋泰豫元年殂年五十歸葬宣帝墓側今泰"
          },
          {
            "pdf_page": 4,
            "half": "右",
            "leaf": "二下",
            "column_from_right": 1,
            "start": 0,
            "end": 21,
            "text": "安陵也門生王清與墓工始下鍤有白兔跳起尋之不"
          },
          {
            "pdf_page": 4,
            "half": "右",
            "leaf": "二下",
            "column_from_right": 2,
            "start": 0,
            "end": 21,
            "text": "得及墳成兔還棲其上昇明二年贈竟陵公國夫人三"
          },
          {
            "pdf_page": 4,
            "half": "右",
            "leaf": "二下",
            "column_from_right": 3,
            "start": 0,
            "end": 21,
            "text": "年贈齊國妃印綬如太妃建元元年尊諡昭皇后三年"
          },
          {
            "pdf_page": 4,
            "half": "右",
            "leaf": "二下",
            "column_from_right": 4,
            "start": 0,
            "end": 21,
            "text": "贈后父金紫光祿大夫母桓氏上都鄉君壽之子興道"
          },
          {
            "pdf_page": 4,
            "half": "右",
            "leaf": "二下",
            "column_from_right": 5,
            "start": 0,
            "end": 20,
            "text": "司徒屬文蔚豫章內史義徽光祿大夫義倫通直郎"
          }
        ]
      }
    }
  ],
