  "paragraphs": [
    {
      "id": "c-epitaph-wanglingyuan-excerpts:p000",
      "text": "魏故假黃鉞太傅大司馬廣陽文獻王妃墓誌銘",
      "text_layer": "received_chapter",
      "annotation_status": "in_progress",
      "mentions": [
        {
          "id": "c-epitaph-wanglingyuan-excerpts:p000:m0010",
          "start": 10,
          "end": 15,
          "surface": "廣陽文獻王",
          "kind": "person",
          "person_id": "2a3_ci1_y4y",
          "identification_status": "contextual_provisional",
          "interpretation_note": "誌題夫爵與諡號對照元湛誌題；是具指夫號。"
        }
      ],
      "witness_locator": {
        "image_parts": [
          1
        ],
        "locus": "圖版000756292右葉，右起第1欄及第2欄上端。"
      }
    },
    {
      "id": "c-epitaph-wanglingyuan-excerpts:p001",
      "text": "祖琛，齊司徒從事中郎。祖母彭城劉氏，父義恭，宋太宰江夏文獻王。父翊，魏侍中司空孝獻公。母河南元氏，父澄，假黃鉞太傅任城文宣王。妃姓王，諱令媛，琅邪臨沂人，齊尚書僕射奐之曾孫也。",
      "text_layer": "received_chapter",
      "annotation_status": "in_progress",
      "mentions": [
        {
          "id": "c-epitaph-wanglingyuan-excerpts:p001:m0001",
          "start": 1,
          "end": 2,
          "surface": "琛",
          "kind": "person",
          "person_id": "q7m_r8k_2vn_AAA",
          "identification_status": "contextual_provisional",
          "interpretation_note": "依墓誌家系、官銜及志主姓名辨識。"
        },
        {
          "id": "c-epitaph-wanglingyuan-excerpts:p001:m0032",
          "start": 32,
          "end": 33,
          "surface": "翊",
          "kind": "person",
          "person_id": "q7m_r8k_2vn_AAAA",
          "identification_status": "contextual_provisional",
          "interpretation_note": "依墓誌家系、官銜及志主姓名辨識。"
        },
        {
          "id": "c-epitaph-wanglingyuan-excerpts:p001:m0046",
          "start": 46,
          "end": 48,
          "surface": "元氏",
          "kind": "person",
          "person_id": "r2j_x7x_hhl",
          "identification_status": "contextual_provisional",
          "interpretation_note": "原誌記母之氏，未書名。"
        },
        {
          "id": "c-epitaph-wanglingyuan-excerpts:p001:m0050",
          "start": 50,
          "end": 51,
          "surface": "澄",
          "kind": "person",
          "person_id": "p3f_nlh_ukk",
          "identification_status": "contextual_provisional",
          "interpretation_note": "誌稱任城文宣王，《魏書》卷十九中〈任城王〉同載澄與文宣諡。"
        },
        {
          "id": "c-epitaph-wanglingyuan-excerpts:p001:m0068",
          "start": 68,
          "end": 70,
          "surface": "令媛",
          "kind": "person",
