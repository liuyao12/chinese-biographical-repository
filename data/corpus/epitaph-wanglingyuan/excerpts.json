          "identification_status": "contextual_provisional",
          "interpretation_note": "依墓誌家系、官銜及志主姓名辨識。"
        },
        {
          "id": "c-epitaph-wanglingyuan-excerpts:p001:m0082",
          "start": 82,
          "end": 83,
