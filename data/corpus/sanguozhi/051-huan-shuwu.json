    "source_reading_cases": [
      {
        "id": "c-sanguozhi-051-huan-shuwu:line056:reading-000-142",
        "kind": "received_sentence",
        "paragraph_id": "c-sanguozhi-051-huan-shuwu:line056",
        "start_codepoint": 0,
        "end_codepoint": 142,
        "source_quote": "　　孫桓字叔武，河之子也。年二十五，拜安東中郎將，與陸遜共拒劉備。備軍眾甚盛，彌山盈谷，桓投力奮命。與遜戮力，備遂敗走。桓斬上（兜）（夔）道，截其徑要。備逾山越險，僅乃得免，忿恚歎曰：“吾昔初至京城，桓尚小兒，而今迫孤乃至此也！”桓以功拜建武將軍，封丹徒侯，下督牛港，作橫江塢，會卒。",
        "person_id": "7dp_vzu_fpc",
        "related_person_ids": [
          "07n_fwj_5jn",
          "lii_454_vuv",
          "5f2_396_25c"
        ],
        "reading": "河之子也。年二十五與陸遜拒劉備。上（兜）（夔）道保留原括形，殿本作上夔道；終建武將軍、丹徒侯。"
      },
      {
        "id": "c-sanguozhi-051-huan-shuwu:line056-pei01-01:reading-000-094",
        "kind": "annotation_sentence",
        "paragraph_id": "c-sanguozhi-051-huan-shuwu:line056-pei01-01",
        "start_codepoint": 0,
        "end_codepoint": 94,
        "source_quote": "《吴书》曰：河有四子。长助，曲阿长。次谊，海盐长。并早卒。次桓，仪容端正，器怀聪朗，博学强记，能论议应对，权常称为宗室颜渊，擢为武卫都尉。从讨关羽於华容，诱羽餘党，得五千人，牛马器械甚众。",
        "person_id": "07n_fwj_5jn",
        "related_person_ids": [
          "07n_fwj_5jn_A",
          "07n_fwj_5jn_B",
          "7dp_vzu_fpc",
          "572_278_cba",
          "gsq_vgq_esv",
          "1c2_03c_9ea"
        ],
        "reading": "吳書稱河有四子，助長、誼次、桓次；宗室顏淵為權所作比擬，非桓名。"
      },
      {
        "id": "c-sanguozhi-051-huan-shuwu:line056-pei02-01:reading-000-071",
        "kind": "annotation_sentence",
        "paragraph_id": "c-sanguozhi-051-huan-shuwu:line056-pei02-01",
        "start_codepoint": 0,
        "end_codepoint": 71,
        "source_quote": "《吴书》曰：桓弟俊，字叔英，性度恢弘，才经文武，为定武中郎将，屯戍薄落，赤烏十三年卒。长子建袭爵，平虏将军。少子慎，镇南将军。慎子丞，字显世。",
        "person_id": "6k9_dku_2e4",
        "related_person_ids": [
          "7dp_vzu_fpc",
          "6k9_dku_2e4_B",
          "6k9_dku_2e4_A",
          "6k9_dku_2e4_AA"
        ],
        "reading": "桓之弟俊，字叔英，赤烏十三年卒。長子建、少子慎，慎子丞字顯世。與孫和子俊分號。"
      },
      {
        "id": "c-sanguozhi-051-huan-shuwu:line056-pei02-02:reading-000-137",
        "kind": "annotation_sentence",
        "paragraph_id": "c-sanguozhi-051-huan-shuwu:line056-pei02-02",
        "start_codepoint": 0,
        "end_codepoint": 137,
        "source_quote": "《文士传》曰：丞好学，有文章，作萤火赋行於世。为黄门侍郎，与顾荣俱为侍臣。归命世内侍多得罪尤，惟荣、丞独获全。常使二人记事，丞答顾问，乃下诏曰：“自今已后，用侍郎皆当如今宗室丞、顾荣畴也。”吴平赴洛，为范阳涿令，甚有称绩。永安中，陆机为成都王大都督，请丞为司马，与机俱被害。",
        "person_id": "6k9_dku_2e4_AA",
        "related_person_ids": [
          "wtz_smr_dwz",
          "05e_9bb_55a",
          "69h_uhy_hta",
          "e81_f09_000"
        ],
        "reading": "文士傳敘吳黃門侍郎及與陸機遇害；晉書作孫拯，同字顯世，與顧榮、涿令等多重合證。永安中屬引書紀年。"
      }
    ],
