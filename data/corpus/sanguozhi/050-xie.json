    "source_reading_cases": [
      {
        "id": "c-sanguozhi-050-xie:line022:reading-000-104",
        "kind": "received_sentence",
        "paragraph_id": "c-sanguozhi-050-xie:line022",
        "start_codepoint": 0,
        "end_codepoint": 104,
        "source_quote": "吳主權謝夫人，會稽山陰人也。父煚，漢尚書郎、徐令。權母吳，為權聘以為妃，愛幸有寵。後權納姑孫徐氏，欲令謝下之，謝不肯，由是失志。早卒。後十餘年，弟承拜五官郎中，稍遷長沙東部都尉、武陵太守，撰《後漢書》百餘卷。",
        "person_id": "ss4_3z5_x6g",
        "related_person_ids": [
          "572_278_cba",
          "pmj_7rz_ujq",
          "lm8_q5h_5uy",
          "75m_kfd_6qo",
          "khh_wth_u1d"
        ],
        "reading": "權母為權聘謝氏，徐氏在後。謝夫人早卒，非謝承。"
      },
      {
        "id": "c-sanguozhi-050-xie:line022-pei01-01:reading-000-050",
        "kind": "annotation_sentence",
        "paragraph_id": "c-sanguozhi-050-xie:line022-pei01-01",
        "start_codepoint": 0,
        "end_codepoint": 50,
        "source_quote": "煚子承撰《後漢書》，稱煚幼以仁孝為行，明達有令才。煚弟貞，履蹈法度，篤學尚義，舉孝廉，建昌長，卒官。",
        "person_id": "pmj_7rz_ujq",
        "related_person_ids": [
          "khh_wth_u1d",
          "47n_rbr_40l"
        ],
        "reading": "承所撰書稱其父；煚弟貞舉孝廉，建昌長、卒官。"
      },
      {
        "id": "c-sanguozhi-050-xie:line022-pei02-01:reading-000-047",
        "kind": "annotation_sentence",
        "paragraph_id": "c-sanguozhi-050-xie:line022-pei02-01",
        "start_codepoint": 0,
        "end_codepoint": 47,
        "source_quote": "《會稽典錄》曰：承字偉平，博學洽聞，嘗所知見，終身不忘。子崇揚威將軍，崇弟勗吳郡太守，竝知名。",
        "person_id": "khh_wth_u1d",
        "related_person_ids": [
          "khh_wth_u1d_A",
          "ist_8ta_63l"
        ],
        "reading": "會稽典錄載承字偉平及其子崇、崇弟勗。"
      }
    ],
    "reviewed_unit_evidence": [
      {
        "unit": "謝夫人傳",
