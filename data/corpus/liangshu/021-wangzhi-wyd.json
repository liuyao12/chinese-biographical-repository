      "source_position": {
        "revision_id": "cbr-ai-transcription-sha256:6cb11d29f5f1b17fccce41c7ab1b3a1a9407ce97bd0b109ce070c05ba50e8550",
        "source_layer": "received_biography",
        "column_projection": [
          {
            "pdf_page": 5,
            "leaf": "三下",
            "half": "右",
            "column_from_right": 9,
            "start": 8,
            "end": 21,
            "text": "志家世居建康禁中里馬蕃巷父"
          },
          {
            "pdf_page": 5,
            "leaf": "三下",
            "half": "右",
            "column_from_right": 10,
            "start": 0,
            "end": 21,
            "text": "僧虔以來門風多寬恕志尤惇厚所歷職不以罪咎劾"
          },
          {
            "pdf_page": 5,
            "leaf": "四上",
            "half": "左",
            "column_from_right": 1,
            "start": 0,
            "end": 21,
            "text": "人門下客嘗盜脫志車𨏥賣之志知而不問待之如初"
          },
          {
            "pdf_page": 5,
            "leaf": "四上",
            "half": "左",
            "column_from_right": 2,
            "start": 0,
            "end": 21,
            "text": "賓客游其門者專覆其過而稱其善兄弟子姪皆篤實"
          },
          {
            "pdf_page": 5,
            "leaf": "四上",
            "half": "左",
            "column_from_right": 3,
            "start": 0,
            "end": 21,
            "text": "謙和時人號馬蕃諸王為長者普通四年志改葬高祖"
          },
          {
            "pdf_page": 5,
            "leaf": "四上",
            "half": "左",
            "column_from_right": 4,
            "start": 0,
            "end": 19,
            "text": "厚賻賜之追諡曰安有五子緝休諲操素並知名"
          }
        ]
      }
    }
