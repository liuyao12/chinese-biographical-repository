            "pdf_page": 4,
            "leaf": "三上",
            "half": "左",
            "column_from_right": 7,
            "start": 16,
            "end": 21,
            "text": "天監元年以"
          },
          {
            "pdf_page": 4,
            "leaf": "三上",
            "half": "左",
            "column_from_right": 8,
            "start": 0,
            "end": 21,
            "text": "本官領前軍將軍其年遷冠軍將軍丹陽尹為政清靜"
          },
          {
            "pdf_page": 4,
            "leaf": "三上",
            "half": "左",
            "column_from_right": 9,
            "start": 0,
            "end": 21,
            "text": "去煩苛京師有寡婦無子姑亡舉債以斂葬既葬而無"
          },
          {
            "pdf_page": 4,
            "leaf": "三上",
            "half": "左",
            "column_from_right": 10,
            "start": 0,
            "end": 21,
            "text": "以還之志愍其義以俸錢償焉時年饑每旦為粥於郡"
          },
          {
            "pdf_page": 5,
            "leaf": "三下",
            "half": "右",
            "column_from_right": 1,
            "start": 0,
            "end": 21,
            "text": "門以賦百姓民稱之不容口三年為散騎常侍中書令"
          },
          {
            "pdf_page": 5,
            "leaf": "三下",
            "half": "右",
            "column_from_right": 2,
            "start": 0,
            "end": 21,
            "text": "領游擊將軍志為中書令及居京尹便懷止足常謂諸"
          },
          {
            "pdf_page": 5,
            "leaf": "三下",
            "half": "右",
            "column_from_right": 3,
            "start": 0,
            "end": 21,
            "text": "子姪曰謝莊在宋孝武世位止中書令吾自視豈可以"
          },
          {
            "pdf_page": 5,
            "leaf": "三下",
            "half": "右",
            "column_from_right": 4,
            "start": 0,
            "end": 21,
            "text": "過之因多謝病簡通賓客遷前將軍太常卿六年出為"
          },
          {
            "pdf_page": 5,
            "leaf": "三下",
            "half": "右",
            "column_from_right": 5,
            "start": 0,
            "end": 21,
            "text": "雲麾將軍安西始興王長史南郡太守明年遷軍師將"
          },
          {
            "pdf_page": 5,
            "leaf": "三下",
            "half": "右",
            "column_from_right": 6,
            "start": 0,
            "end": 21,
            "text": "軍平西鄱陽郡王長史江夏太守並加秩中二千石九"
          },
          {
            "pdf_page": 5,
            "leaf": "三下",
            "half": "右",
            "column_from_right": 7,
            "start": 0,
            "end": 21,
            "text": "年遷為散騎常侍金紫光祿大夫十二年卒時年五十"
          },
          {
            "pdf_page": 5,
            "leaf": "三下",
            "half": "右",
            "column_from_right": 8,
            "start": 0,
            "end": 1,
            "text": "四"
          }
        ]
