      "source_position": {
        "revision_id": "cbr-ai-transcription-sha256:6cb11d29f5f1b17fccce41c7ab1b3a1a9407ce97bd0b109ce070c05ba50e8550",
        "source_layer": "received_biography",
        "column_projection": [
          {
            "pdf_page": 3,
            "leaf": "二上",
            "half": "左",
            "column_from_right": 9,
            "start": 15,
            "end": 21,
            "text": "志年九歲居所"
          },
          {
            "pdf_page": 3,
            "leaf": "二上",
            "half": "左",
            "column_from_right": 10,
            "start": 0,
            "end": 21,
            "text": "生母憂哀容毀瘠為中表所異弱冠選尚宋孝武女安"
          },
          {
            "pdf_page": 4,
            "leaf": "二下",
            "half": "右",
            "column_from_right": 1,
            "start": 0,
            "end": 21,
            "text": "固公主拜駙馬都尉秘書郎累遷太尉行參軍太子舍"
          },
          {
            "pdf_page": 4,
            "leaf": "二下",
            "half": "右",
            "column_from_right": 2,
            "start": 0,
            "end": 21,
            "text": "人武陵王文學褚淵為司徒引志為主簿淵謂僧虔曰"
          },
          {
            "pdf_page": 4,
            "leaf": "二下",
            "half": "右",
            "column_from_right": 3,
            "start": 0,
            "end": 21,
            "text": "朝廷之恩本為殊特所可光榮在屈賢子累遷鎮北竟"
          },
          {
            "pdf_page": 4,
            "leaf": "二下",
            "half": "右",
            "column_from_right": 4,
            "start": 0,
            "end": 21,
            "text": "陵王功曹史安陸南郡二王友入為中書侍郎尋除宣"
          },
          {
            "pdf_page": 4,
            "leaf": "二下",
            "half": "右",
            "column_from_right": 5,
            "start": 0,
            "end": 21,
            "text": "城內史清謹有恩惠郡民張倪吳慶爭田經年不決志"
          },
          {
            "pdf_page": 4,
            "leaf": "二下",
            "half": "右",
            "column_from_right": 6,
            "start": 0,
            "end": 21,
            "text": "到官父老乃相謂曰王府君有德政吾曹鄉里乃有此"
          },
          {
            "pdf_page": 4,
            "leaf": "二下",
            "half": "右",
            "column_from_right": 7,
            "start": 0,
            "end": 21,
            "text": "爭倪慶相攜請罪所訟地遂為閑田徵拜黃門侍郎尋"
          },
          {
            "pdf_page": 4,
            "leaf": "二下",
            "half": "右",
            "column_from_right": 8,
            "start": 0,
            "end": 21,
            "text": "遷吏部侍郎出為寧朔將軍東陽太守郡獄有重囚十"
          },
          {
            "pdf_page": 4,
            "leaf": "二下",
            "half": "右",
            "column_from_right": 9,
            "start": 0,
            "end": 21,
            "text": "餘人冬至日悉遣還家過節皆返惟一人失期獄司以"
          },
          {
            "pdf_page": 4,
            "leaf": "二下",
            "half": "右",
            "column_from_right": 10,
            "start": 0,
            "end": 21,
            "text": "為言志曰此自太守事主者勿憂明旦果自詣獄辭以"
          },
          {
            "pdf_page": 4,
            "leaf": "三上",
            "half": "左",
            "column_from_right": 1,
            "start": 0,
            "end": 21,
            "text": "婦孕吏民益歎服之視事三年齊永明二年入為侍中"
          },
          {
            "pdf_page": 4,
            "leaf": "三上",
            "half": "左",
            "column_from_right": 2,
            "start": 0,
            "end": 21,
            "text": "未拜轉吏部尚書在選以和理稱崔慧景平以例加右"
          },
          {
            "pdf_page": 4,
            "leaf": "三上",
            "half": "左",
            "column_from_right": 3,
            "start": 0,
            "end": 17,
            "text": "軍將軍封臨汝侯固讓不受改領右衛將軍"
          }
        ]
      }
    },
