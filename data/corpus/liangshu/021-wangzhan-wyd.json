      "source_position": {
        "revision_id": "cbr-ai-transcription-sha256:590434796825e6c8212ce54153d2f891874b28625aadf377aa69ef53f6734473",
        "source_layer": "received_biography",
        "column_projection": [
          {
            "pdf_page": 3,
            "leaf": "一下",
            "half": "右",
            "column_from_right": 3,
            "start": 3,
            "end": 21,
            "text": "起家著作佐郎累遷太子舍人太尉主簿太子"
          },
          {
            "pdf_page": 3,
            "leaf": "一下",
            "half": "右",
            "column_from_right": 4,
            "start": 0,
            "end": 21,
            "text": "洗馬頃之出為鄱陽內史秩滿授太子中舍人又為齊"
          },
          {
            "pdf_page": 3,
            "leaf": "一下",
            "half": "右",
            "column_from_right": 5,
            "start": 0,
            "end": 21,
            "text": "南海王友尋轉司徒竟陵王從事中郎王甚相賓禮南"
          },
          {
            "pdf_page": 3,
            "leaf": "一下",
            "half": "右",
            "column_from_right": 6,
            "start": 0,
            "end": 21,
            "text": "海王為護軍將軍瞻為長史又出補徐州別駕從事史"
          },
          {
            "pdf_page": 3,
            "leaf": "一下",
            "half": "右",
            "column_from_right": 7,
            "start": 0,
            "end": 21,
            "text": "遷驃騎將軍王晏長史晏誅出為晉陵太守瞻潔己為"
          },
          {
            "pdf_page": 3,
            "leaf": "一下",
            "half": "右",
            "column_from_right": 8,
            "start": 0,
            "end": 21,
            "text": "政妻子不免飢寒時大司馬王敬則舉兵作亂路經晉"
          },
          {
            "pdf_page": 3,
            "leaf": "一下",
            "half": "右",
            "column_from_right": 9,
            "start": 0,
            "end": 21,
            "text": "陵郡民多附敬則軍敗臺軍討賊黨瞻言於朝曰愚人"
          },
          {
            "pdf_page": 3,
            "leaf": "一下",
            "half": "右",
            "column_from_right": 10,
            "start": 0,
            "end": 21,
            "text": "易動不足窮法明帝許之所全活者萬數徵拜給事黃"
          },
          {
            "pdf_page": 3,
            "leaf": "二上",
            "half": "左",
            "column_from_right": 1,
            "start": 0,
            "end": 14,
            "text": "門侍郎撫軍建安王長史御史中丞"
          }
        ]
      }
    },
    {
      "id": "c-liangshu-021-wangzhan-wyd:p004",
      "text": "高祖霸府開以瞻為大司馬相國諮議參軍領錄事梁臺建為侍中遷左民尚書俄轉吏部尚書瞻性率亮居選部所舉多行其意頗嗜酒每飲或竟日而精神益朗贍不廢簿領高祖每稱瞻有三術射棊酒也尋加左軍將軍以疾不拜仍為侍中領驍騎將軍未拜卒時年四十九諡康侯子長玄著作佐郎早卒",
      "text_layer": "received_chapter",
