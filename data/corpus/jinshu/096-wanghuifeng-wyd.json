  "paragraphs": [
    {
      "id": "c-jinshu-096-wanghuifeng-wyd:p001",
      "text": "愍懷太子妃王氏太尉衍女也字惠風貞婉有志節太子既廢居于金墉衍請絶婚惠風號哭而歸行路為之流涕及劉曜陷洛陽以惠風賜其將喬屬屬將妻之惠風拔劍距屬曰吾太尉公女皇太子妃義不為逆胡所辱屬遂害之",
      "annotation_status": "reviewed",
      "text_layer": "received_chapter",
      "source_position": {
        "revision_id": "cbr-ai-transcription-sha256:ead71c226112cad4ca3c9f31cb6030aacc346cd188ac683cc4104ce0e10dbf4b",
        "source_layer": "received_biography",
        "column_projection": [
          {
            "pdf_page": 46,
            "half": "左",
            "leaf": "五上",
            "column_from_right": 6,
            "start": 0,
            "end": 21,
            "text": "愍懷太子妃王氏太尉衍女也字惠風貞婉有志節太"
          },
          {
            "pdf_page": 46,
            "half": "左",
            "leaf": "五上",
            "column_from_right": 7,
            "start": 0,
            "end": 21,
            "text": "子既廢居于金墉衍請絶婚惠風號哭而歸行路為之"
          },
          {
            "pdf_page": 46,
            "half": "左",
            "leaf": "五上",
            "column_from_right": 8,
            "start": 0,
            "end": 21,
            "text": "流涕及劉曜陷洛陽以惠風賜其將喬屬屬將妻之惠"
          },
          {
            "pdf_page": 46,
            "half": "左",
            "leaf": "五上",
            "column_from_right": 9,
            "start": 0,
            "end": 21,
            "text": "風拔劍距屬曰吾太尉公女皇太子妃義不為逆胡所"
          },
          {
            "pdf_page": 46,
            "half": "左",
            "leaf": "五上",
            "column_from_right": 10,
            "start": 0,
            "end": 5,
            "text": "辱屬遂害之"
          }
        ]
      },
