      "source_position": {
        "revision_id": "cbr-ai-transcription-sha256:d9818d1eac086ac63b280410b8086334dea5855a10e057609712e3924c58be39",
        "source_layer": "received_biography",
        "column_projection": [
          {
            "pdf_page": 61,
            "half": "左",
            "leaf": "十九上",
            "column_from_right": 2,
            "text": "愔字方回少不交競弱冠除散騎侍郎不拜性至孝居",
            "start": 0,
            "end": 21
          },
          {
            "pdf_page": 61,
            "half": "左",
            "leaf": "十九上",
            "column_from_right": 3,
            "text": "父母憂殆將滅性服闋襲爵南昌公徵拜中書侍郎驃",
            "start": 0,
            "end": 21
          },
          {
            "pdf_page": 61,
            "half": "左",
            "leaf": "十九上",
            "column_from_right": 4,
            "text": "騎何充輔政征北將軍褚裒鎮京口皆以愔為長史再",
            "start": 0,
            "end": 21
          },
          {
            "pdf_page": 61,
            "half": "左",
            "leaf": "十九上",
            "column_from_right": 5,
            "text": "遷黃門侍郎時吳郡守闋欲以愔為太守愔自以資望",
            "start": 0,
            "end": 21
          },
          {
            "pdf_page": 61,
            "half": "左",
            "leaf": "十九上",
            "column_from_right": 6,
            "text": "少不宜超莅大郡朝議嘉之轉為臨海太守會弟曇卒",
            "start": 0,
            "end": 21
          },
          {
            "pdf_page": 61,
            "half": "左",
            "leaf": "十九上",
            "column_from_right": 7,
            "text": "益無處世意在郡優游頗稱簡默與姊夫王羲之高士",
            "start": 0,
            "end": 21
          },
          {
            "pdf_page": 61,
            "half": "左",
            "leaf": "十九上",
            "column_from_right": 8,
            "text": "許恂並有邁世之風俱棲心絶穀修黃老之術後以疾",
            "start": 0,
            "end": 21
          },
          {
            "pdf_page": 61,
            "half": "左",
            "leaf": "十九上",
            "column_from_right": 9,
            "text": "去職乃築宅章安有終焉之志十許年間人事頓絶簡",
            "start": 0,
            "end": 21
          },
          {
            "pdf_page": 61,
            "half": "左",
            "leaf": "十九上",
            "column_from_right": 10,
            "text": "文帝輔政與尚書僕射江虨等薦愔以為執德存正識",
            "start": 0,
            "end": 21
          },
          {
            "pdf_page": 62,
            "half": "右",
            "leaf": "十九下",
            "column_from_right": 1,
            "text": "懷沈敏而辭職遺榮有不拔之操成務須才豈得遂其",
            "start": 0,
            "end": 21
          },
          {
            "pdf_page": 62,
            "half": "右",
            "leaf": "十九下",
            "column_from_right": 2,
            "text": "獨善宜見徵引以參政術於是徵為光祿大夫加散騎",
            "start": 0,
            "end": 21
          },
          {
            "pdf_page": 62,
            "half": "右",
            "leaf": "十九下",
            "column_from_right": 3,
            "text": "常侍既到更除太常固讓不拜深抱沖退樂補遠郡從",
            "start": 0,
            "end": 21
          },
          {
            "pdf_page": 62,
            "half": "右",
            "leaf": "十九下",
            "column_from_right": 4,
            "text": "之出為輔國將軍會稽內史大司馬桓溫以愔與徐兗",
            "start": 0,
            "end": 21
          },
          {
            "pdf_page": 62,
            "half": "右",
            "leaf": "十九下",
            "column_from_right": 5,
            "text": "有故義乃遷愔都督徐兗青幽揚州之晉陵諸軍事領",
            "start": 0,
            "end": 21
          },
          {
            "pdf_page": 62,
            "half": "右",
            "leaf": "十九下",
            "column_from_right": 6,
            "text": "徐兗二州刺史假節雖居藩鎮非其好也俄屬桓溫北",
            "start": 0,
            "end": 21
          },
          {
            "pdf_page": 62,
            "half": "右",
            "leaf": "十九下",
            "column_from_right": 7,
            "text": "伐愔請督所部出河上用其子超計以己非將帥才不",
            "start": 0,
            "end": 21
          },
          {
            "pdf_page": 62,
            "half": "右",
            "leaf": "十九下",
            "column_from_right": 8,
            "text": "堪軍旅又固辭解職勸溫并領己所統轉冠軍將軍會",
            "start": 0,
            "end": 21
          },
          {
            "pdf_page": 62,
            "half": "右",
            "leaf": "十九下",
            "column_from_right": 9,
            "text": "稽內史及帝踐阼就加鎮軍都督浙江東五郡軍事久",
            "start": 0,
            "end": 21
          },
          {
            "pdf_page": 62,
            "half": "右",
            "leaf": "十九下",
            "column_from_right": 10,
            "text": "之以年老乞骸骨因居會稽徵拜司空詔書優美敦獎",
            "start": 0,
            "end": 21
          },
          {
            "pdf_page": 62,
            "half": "左",
            "leaf": "二十上",
            "column_from_right": 1,
            "text": "殷勤固辭不起大元九年卒時年七十二追贈侍中司",
            "start": 0,
            "end": 21
          },
          {
            "pdf_page": 62,
            "half": "左",
            "leaf": "二十上",
            "column_from_right": 2,
            "text": "空諡曰文穆三子超融沖超最知名",
            "start": 0,
            "end": 14
          }
        ]
      }
    }
  ],
