    "person_reference_occurrences": [
      {
        "id": "c-nanshi-044-zimao-ruan:p001:r0054",
        "surface": "阿姨",
        "start": 54,
        "end": 56,
        "person_id": "q2g_7m1_cbj",
        "referent_role": "third_person",
        "paragraph_id": "c-nanshi-044-zimao-ruan:p001",
        "quote": "年七歲時，母阮淑媛嘗病危篤，請僧行道。有獻蓮華供佛者，眾僧以銅罌盛水漬其莖，欲華不萎。子懋流涕禮佛曰：「若使阿姨因此和勝，願諸佛令華竟齋不萎。」七日齋畢，華更鮮紅，視罌中稍有根須，當世稱其孝感。",
        "note": "依同段姓名、引者及所答者。"
      },
      {
        "id": "c-nanshi-044-zimao-ruan:p002:r0027",
        "surface": "明帝",
        "start": 27,
        "end": 29,
        "person_id": "w4m_9tw_147",
        "referent_role": "third_person",
        "paragraph_id": "c-nanshi-044-zimao-ruan:p002",
        "quote": "母阮在都，遣書欲密迎上，阮報同產弟于瑤之為計。瑤之馳告明帝",
        "note": "依同段姓名、引者及所答者。"
      }
    ],
