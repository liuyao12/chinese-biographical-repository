      "source_position": {
        "revision_id": "cbr-ai-transcription-sha256:8c3b9be8631199a9cb0f24f471f4751edfa023b4f4b379eab2c198981faa5001",
        "source_layer": "received_biography",
        "column_projection": [
          {
            "pdf_page": 21,
            "half": "右",
            "leaf": "十八下",
            "column_from_right": 3,
            "start": 0,
            "end": 18,
            "text": "文安王皇后諱寶明琅邪臨沂人也祖韶之吳"
          },
          {
            "pdf_page": 21,
            "half": "右",
            "leaf": "十八下",
            "column_from_right": 4,
            "start": 0,
            "end": 18,
            "text": "興太守父曄之太宰祭酒宋世高帝為文惠太"
          },
          {
            "pdf_page": 21,
            "half": "右",
            "leaf": "十八下",
            "column_from_right": 5,
            "start": 0,
            "end": 18,
            "text": "子納后建元元年為南郡王妃四年為皇太子"
          },
          {
            "pdf_page": 21,
            "half": "右",
            "leaf": "十八下",
            "column_from_right": 6,
            "start": 0,
            "end": 18,
            "text": "妃無寵太子宮人製新麗衣裳及首飾而后牀"
          },
          {
            "pdf_page": 21,
            "half": "右",
            "leaf": "十八下",
            "column_from_right": 7,
            "start": 0,
            "end": 18,
            "text": "帷陳故古舊釵鑷十餘枚永明十一年為皇太"
          },
          {
            "pdf_page": 21,
            "half": "右",
            "leaf": "十八下",
            "column_from_right": 8,
            "start": 0,
            "end": 18,
            "text": "孫太妃鬱林即位尊為皇太后稱宣德宮置男"
          },
          {
            "pdf_page": 21,
            "half": "右",
            "leaf": "十八下",
            "column_from_right": 9,
            "start": 0,
            "end": 18,
            "text": "左右三十人前代所未有也贈后父曄之金紫"
          },
          {
            "pdf_page": 21,
            "half": "左",
            "leaf": "十九上",
            "column_from_right": 1,
            "start": 0,
            "end": 18,
            "text": "光祿大夫母桓氏豐安縣君其年十二月備法"
          },
          {
            "pdf_page": 21,
            "half": "左",
            "leaf": "十九上",
            "column_from_right": 2,
            "start": 0,
            "end": 18,
            "text": "駕謁太廟明帝即位出居鄱陽王故第為宣德"
          },
          {
            "pdf_page": 21,
            "half": "左",
            "leaf": "十九上",
            "column_from_right": 3,
            "start": 0,
            "end": 1,
            "text": "宮"
          }
        ]
      }
    },
    {
