      "source_position": {
        "revision_id": "cbr-ai-transcription-sha256:e5f39ba1264146a566b51b42437a6fcd67b1fc83792ff282e247b2c8810b47f8",
        "source_layer": "received_biography",
        "column_projection": [
          {
            "column": "20R08",
            "pdf_page": 20,
            "half": "右",
            "leaf": "17下",
            "column_from_right": 8,
            "url": "https://upload.wikimedia.org/wikipedia/commons/6/6a/NAJDA-280-0079_%E5%8D%97%E5%8F%B27.pdf#page=20",
            "start": 11,
            "end": 18,
            "text": "舊顯陽昭陽二殿"
          },
          {
            "column": "20R09",
            "pdf_page": 20,
            "half": "右",
            "leaf": "17下",
            "column_from_right": 9,
            "url": "https://upload.wikimedia.org/wikipedia/commons/6/6a/NAJDA-280-0079_%E5%8D%97%E5%8F%B27.pdf#page=20",
            "start": 0,
            "end": 18,
            "text": "太后皇后所居也永明中無太后皇后羊貴嬪"
          },
          {
            "column": "20L01",
            "pdf_page": 20,
            "half": "左",
            "leaf": "18上",
            "column_from_right": 1,
            "url": "https://upload.wikimedia.org/wikipedia/commons/6/6a/NAJDA-280-0079_%E5%8D%97%E5%8F%B27.pdf#page=20",
            "start": 0,
            "end": 18,
            "text": "居昭陽殿西范貴妃居昭陽殿東寵姬荀昭華"
          },
          {
            "column": "20L02",
            "pdf_page": 20,
            "half": "左",
            "leaf": "18上",
            "column_from_right": 2,
            "url": "https://upload.wikimedia.org/wikipedia/commons/6/6a/NAJDA-280-0079_%E5%8D%97%E5%8F%B27.pdf#page=20",
            "start": 0,
            "end": 18,
            "text": "居鳳華栢殿宮內御所居壽昌畫殿南閣置白"
          },
          {
            "column": "20L03",
            "pdf_page": 20,
            "half": "左",
            "leaf": "18上",
            "column_from_right": 3,
            "url": "https://upload.wikimedia.org/wikipedia/commons/6/6a/NAJDA-280-0079_%E5%8D%97%E5%8F%B27.pdf#page=20",
            "start": 0,
            "end": 18,
            "text": "鷺鼓吹二部乾光殿東西頭置鍾磬兩廂皆宴"
          },
          {
            "column": "20L04",
            "pdf_page": 20,
            "half": "左",
            "leaf": "18上",
            "column_from_right": 4,
            "url": "https://upload.wikimedia.org/wikipedia/commons/6/6a/NAJDA-280-0079_%E5%8D%97%E5%8F%B27.pdf#page=20",
            "start": 0,
            "end": 18,
            "text": "樂處也上數游幸諸苑囿載宮人從後車宮內"
          },
          {
            "column": "20L05",
            "pdf_page": 20,
            "half": "左",
            "leaf": "18上",
            "column_from_right": 5,
            "url": "https://upload.wikimedia.org/wikipedia/commons/6/6a/NAJDA-280-0079_%E5%8D%97%E5%8F%B27.pdf#page=20",
            "start": 0,
            "end": 18,
            "text": "深隱不聞端門鼓漏聲置鍾於景陽樓上應五"
          },
          {
            "column": "20L06",
            "pdf_page": 20,
            "half": "左",
            "leaf": "18上",
            "column_from_right": 6,
            "url": "https://upload.wikimedia.org/wikipedia/commons/6/6a/NAJDA-280-0079_%E5%8D%97%E5%8F%B27.pdf#page=20",
            "start": 0,
            "end": 18,
            "text": "鼓及三鼓宮人聞鍾聲早起莊飾車駕數幸琅"
          },
          {
            "column": "20L07",
            "pdf_page": 20,
            "half": "左",
            "leaf": "18上",
            "column_from_right": 7,
            "url": "https://upload.wikimedia.org/wikipedia/commons/6/6a/NAJDA-280-0079_%E5%8D%97%E5%8F%B27.pdf#page=20",
            "start": 0,
            "end": 18,
            "text": "邪城宮人常從早發至湖北埭雞始鳴故呼為"
          },
          {
            "column": "20L08",
            "pdf_page": 20,
            "half": "左",
            "leaf": "18上",
            "column_from_right": 8,
            "url": "https://upload.wikimedia.org/wikipedia/commons/6/6a/NAJDA-280-0079_%E5%8D%97%E5%8F%B27.pdf#page=20",
            "start": 0,
            "end": 3,
            "text": "雞鳴埭"
          }
        ]
      }
    }
