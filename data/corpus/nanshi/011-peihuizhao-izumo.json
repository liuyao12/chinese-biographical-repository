      "source_position": {
        "revision_id": "cbr-ai-transcription-sha256:e5f39ba1264146a566b51b42437a6fcd67b1fc83792ff282e247b2c8810b47f8",
        "source_layer": "received_biography",
        "column_projection": [
          {
            "column": "20R03",
            "pdf_page": 20,
            "half": "右",
            "leaf": "17下",
            "column_from_right": 3,
            "url": "https://upload.wikimedia.org/wikipedia/commons/6/6a/NAJDA-280-0079_%E5%8D%97%E5%8F%B27.pdf#page=20",
            "start": 10,
            "end": 18,
            "text": "時議欲立石誌王儉"
          },
          {
            "column": "20R04",
            "pdf_page": 20,
            "half": "右",
            "leaf": "17下",
            "column_from_right": 4,
            "url": "https://upload.wikimedia.org/wikipedia/commons/6/6a/NAJDA-280-0079_%E5%8D%97%E5%8F%B27.pdf#page=20",
            "start": 0,
            "end": 18,
            "text": "曰石誌不出禮起宋元嘉中顏延之為王球石"
          },
          {
            "column": "20R05",
            "pdf_page": 20,
            "half": "右",
            "leaf": "17下",
            "column_from_right": 5,
            "url": "https://upload.wikimedia.org/wikipedia/commons/6/6a/NAJDA-280-0079_%E5%8D%97%E5%8F%B27.pdf#page=20",
            "start": 0,
            "end": 18,
            "text": "誌素族無銘策故以紀行自爾以來共相祖習"
          },
          {
            "column": "20R06",
            "pdf_page": 20,
            "half": "右",
            "leaf": "17下",
            "column_from_right": 6,
            "url": "https://upload.wikimedia.org/wikipedia/commons/6/6a/NAJDA-280-0079_%E5%8D%97%E5%8F%B27.pdf#page=20",
            "start": 0,
            "end": 18,
            "text": "儲妃之重禮絕恒例既有哀策不煩石誌從之"
          },
          {
            "column": "20R07",
            "pdf_page": 20,
            "half": "右",
            "leaf": "17下",
            "column_from_right": 7,
            "url": "https://upload.wikimedia.org/wikipedia/commons/6/6a/NAJDA-280-0079_%E5%8D%97%E5%8F%B27.pdf#page=20",
            "start": 0,
            "end": 18,
            "text": "武帝即位追尊皇后贈父璣之金紫光祿大夫"
          },
          {
            "column": "20R08",
            "pdf_page": 20,
            "half": "右",
            "leaf": "17下",
            "column_from_right": 8,
            "url": "https://upload.wikimedia.org/wikipedia/commons/6/6a/NAJDA-280-0079_%E5%8D%97%E5%8F%B27.pdf#page=20",
            "start": 0,
            "end": 11,
            "text": "后母檀氏餘杭廣昌鄉元君"
          }
        ]
      }
    },
    {
      "id": "c-nanshi-011-peihuizhao-izumo:p004",
      "text": "舊顯陽昭陽二殿太后皇后所居也永明中無太后皇后羊貴嬪居昭陽殿西范貴妃居昭陽殿東寵姬荀昭華居鳳華栢殿宮內御所居壽昌畫殿南閣置白鷺鼓吹二部乾光殿東西頭置鍾磬兩廂皆宴樂處也上數游幸諸苑囿載宮人從後車宮內深隱不聞端門鼓漏聲置鍾於景陽樓上應五鼓及三鼓宮人聞鍾聲早起莊飾車駕數幸琅邪城宮人常從早發至湖北埭雞始鳴故呼為雞鳴埭",
      "text_layer": "received_chapter",
      "annotation_status": "reviewed",
      "mentions": [
        {
