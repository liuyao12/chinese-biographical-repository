      "text_layer": "received_chapter",
      "annotation_status": "reviewed",
      "source_position": {
        "revision_id": "cbr-ai-transcription-sha256:af3de450fdc0e9b276536e944f5eb2441b4e43d32c08efdad27bd6452c20a868",
        "source_layer": "received_biography",
        "column_projection": [
          {
            "column": "43R08",
            "pdf_page": 43,
            "half": "右",
            "leaf": "十三下",
            "column_from_right": 8,
            "start": 6,
            "end": 21,
            "text": "韶之為晉史序王珣貨殖王廞作亂珣"
          },
          {
            "column": "43R09",
            "pdf_page": 43,
            "half": "右",
            "leaf": "十三下",
            "column_from_right": 9,
            "start": 0,
            "end": 21,
            "text": "子弘廞子華並貴顯韶之懼為所陷深附結徐羨之傅"
          },
          {
            "column": "43R10",
            "pdf_page": 43,
            "half": "右",
            "leaf": "十三下",
            "column_from_right": 10,
            "start": 0,
            "end": 21,
            "text": "亮等少帝即位遷侍中出為吳郡太守羨之被誅王弘"
          },
          {
            "column": "43L01",
            "pdf_page": 43,
            "half": "左",
            "leaf": "十四上",
            "column_from_right": 1,
            "start": 0,
            "end": 21,
            "text": "入相領揚州刺史弘雖與韶之不絶諸弟未相識者皆"
          },
          {
            "column": "43L02",
            "pdf_page": 43,
            "half": "左",
            "leaf": "十四上",
            "column_from_right": 2,
            "start": 0,
            "end": 21,
            "text": "不復往來韶之在郡常慮為弘所繩夙夜勤勵政績甚"
          },
          {
            "column": "43L03",
            "pdf_page": 43,
            "half": "左",
            "leaf": "十四上",
            "column_from_right": 3,
            "start": 0,
            "end": 21,
            "text": "美弘亦抑其私憾文帝兩嘉之韶之稱為良守徵為祠"
          },
          {
            "column": "43L04",
            "pdf_page": 43,
            "half": "左",
            "leaf": "十四上",
            "column_from_right": 4,
            "start": 0,
            "end": 21,
            "text": "部尚書加給事中坐去郡長取送故免官後為吳興太"
          },
          {
            "column": "43L05",
            "pdf_page": 43,
            "half": "左",
            "leaf": "十四上",
            "column_from_right": 5,
            "start": 0,
            "end": 21,
            "text": "守卒撰孝傳三卷文集行於世宋廟歌辭韶之所制也"
          }
        ]
      }
    },
    {
      "id": "c-nanshi-024-wangshaozhi-wyd:p005",
      "text": "子曄位臨賀太守",
