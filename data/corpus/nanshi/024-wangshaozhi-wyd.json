          "interpretation_note": "對讀本傳上下文。"
        }
      ],
      "text_layer": "received_chapter",
      "annotation_status": "reviewed",
      "source_position": {
        "revision_id": "cbr-ai-transcription-sha256:af3de450fdc0e9b276536e944f5eb2441b4e43d32c08efdad27bd6452c20a868",
        "source_layer": "received_biography",
        "column_projection": [
          {
            "column": "42L05",
            "pdf_page": 42,
            "half": "左",
            "leaf": "十三上",
            "column_from_right": 5,
            "start": 16,
            "end": 21,
            "text": "韶之家貧好"
          },
          {
            "column": "42L06",
            "pdf_page": 42,
            "half": "左",
            "leaf": "十三上",
            "column_from_right": 6,
            "start": 0,
            "end": 21,
            "text": "學嘗三日絶糧而執卷不輟家人誚之曰困窮如此何"
          },
          {
            "column": "42L07",
            "pdf_page": 42,
            "half": "左",
            "leaf": "十三上",
            "column_from_right": 7,
            "start": 0,
            "end": 21,
            "text": "不耕答曰我常自耕耳父偉之為烏程令韶之因居縣"
          },
          {
            "column": "42L08",
            "pdf_page": 42,
            "half": "左",
            "leaf": "十三上",
            "column_from_right": 8,
            "start": 0,
            "end": 21,
            "text": "境好史籍博涉多聞初為衞將軍謝琰行參軍得父舊"
          },
          {
            "column": "42L09",
            "pdf_page": 42,
            "half": "左",
            "leaf": "十三上",
            "column_from_right": 9,
            "start": 0,
            "end": 21,
            "text": "書因私撰晉安帝陽秋及成時人謂宜居史職即除著"
          },
          {
            "column": "42L10",
            "pdf_page": 42,
            "half": "左",
            "leaf": "十三上",
            "column_from_right": 10,
            "start": 0,
            "end": 21,
            "text": "作佐郎使續後事訖義熙九年善敘事辭論可觀遷尚"
          },
          {
            "column": "43R01",
            "pdf_page": 43,
            "half": "右",
            "leaf": "十三下",
            "column_from_right": 1,
            "start": 0,
            "end": 4,
            "text": "書祠部郎"
          }
        ]
      }
    },
    {
      "id": "c-nanshi-024-wangshaozhi-wyd:p003",
      "text": "晉帝自孝武以來常居內殿武官主書於中通呈以省官一人管詔誥住西省因謂之西省郎傅亮羊徽相代在職義熙十一年宋武帝以韶之博學有文辭補通直郎領西省事轉中書侍郎晉安帝之崩武帝使韶之與帝左右密加酖毒恭帝即位遷黃門侍郎領著作西省如故凡諸詔黃皆其辭也武帝受命加驍騎將軍黃門如故西省職解復掌宋書坐璽制謬誤免黃門事在謝晦傳",
      "mentions": [
        {
          "id": "c-nanshi-024-wangshaozhi-wyd:p003:m0036",
          "surface": "傅亮",
          "start": 36,
          "end": 38,
          "person_id": "2dj_m53_6zg",
          "kind": "person",
          "status": "contextual_provisional",
          "interpretation_note": "對讀本傳上下文。"
        },
        {
          "id": "c-nanshi-024-wangshaozhi-wyd:p003:m0038",
          "surface": "羊徽",
          "start": 38,
          "end": 40,
          "person_id": "wc5_hn7_a5w_AAAA",
          "kind": "person",
          "status": "contextual_provisional",
          "interpretation_note": "對讀本傳上下文。"
        },
        {
          "id": "c-nanshi-024-wangshaozhi-wyd:p003:m0053",
          "surface": "韶之",
          "start": 53,
          "end": 55,
          "person_id": "yfa_tz5_3ge",
          "kind": "person",
          "status": "contextual_provisional",
          "interpretation_note": "對讀本傳上下文。"
        },
        {
          "id": "c-nanshi-024-wangshaozhi-wyd:p003:m0081",
          "surface": "韶之",
          "start": 81,
          "end": 83,
          "person_id": "yfa_tz5_3ge",
          "kind": "person",
          "status": "contextual_provisional",
          "interpretation_note": "對讀本傳上下文。"
        },
        {
          "id": "c-nanshi-024-wangshaozhi-wyd:p003:m0146",
          "surface": "謝晦",
          "start": 146,
          "end": 148,
          "person_id": "aa6_83c_juy_AAAA",
          "kind": "person",
          "status": "contextual_provisional",
          "interpretation_note": "對讀本傳上下文。"
        }
      ],
      "text_layer": "received_chapter",
      "annotation_status": "reviewed",
      "source_position": {
        "revision_id": "cbr-ai-transcription-sha256:af3de450fdc0e9b276536e944f5eb2441b4e43d32c08efdad27bd6452c20a868",
        "source_layer": "received_biography",
        "column_projection": [
          {
            "column": "43R01",
            "pdf_page": 43,
            "half": "右",
            "leaf": "十三下",
            "column_from_right": 1,
            "start": 4,
            "end": 21,
            "text": "晉帝自孝武以來常居內殿武官主書於中"
          },
          {
            "column": "43R02",
            "pdf_page": 43,
            "half": "右",
            "leaf": "十三下",
            "column_from_right": 2,
            "start": 0,
            "end": 21,
            "text": "通呈以省官一人管詔誥住西省因謂之西省郎傅亮"
          },
          {
            "column": "43R03",
            "pdf_page": 43,
            "half": "右",
            "leaf": "十三下",
            "column_from_right": 3,
            "start": 0,
            "end": 21,
            "text": "羊徽相代在職義熙十一年宋武帝以韶之博學有文"
          },
          {
            "column": "43R04",
            "pdf_page": 43,
            "half": "右",
            "leaf": "十三下",
            "column_from_right": 4,
            "start": 0,
            "end": 21,
            "text": "辭補通直郎領西省事轉中書侍郎晉安帝之崩武帝"
          },
          {
            "column": "43R05",
            "pdf_page": 43,
            "half": "右",
            "leaf": "十三下",
            "column_from_right": 5,
            "start": 0,
            "end": 21,
            "text": "使韶之與帝左右密加酖毒恭帝即位遷黃門侍郎領"
          },
          {
            "column": "43R06",
            "pdf_page": 43,
            "half": "右",
            "leaf": "十三下",
            "column_from_right": 6,
            "start": 0,
            "end": 21,
            "text": "著作西省如故凡諸詔黃皆其辭也武帝受命加驍騎"
          },
          {
            "column": "43R07",
            "pdf_page": 43,
            "half": "右",
            "leaf": "十三下",
            "column_from_right": 7,
            "start": 0,
            "end": 21,
            "text": "將軍黃門如故西省職解復掌宋書坐璽制謬誤免黃"
          },
          {
            "column": "43R08",
            "pdf_page": 43,
            "half": "右",
            "leaf": "十三下",
            "column_from_right": 8,
            "start": 0,
            "end": 6,
            "text": "門事在謝晦傳"
          }
        ]
      }
    },
    {
      "id": "c-nanshi-024-wangshaozhi-wyd:p004",
      "text": "韶之為晉史序王珣貨殖王廞作亂珣子弘廞子華並貴顯韶之懼為所陷深附結徐羨之傅亮等少帝即位遷侍中出為吳郡太守羨之被誅王弘入相領揚州刺史弘雖與韶之不絶諸弟未相識者皆不復往來韶之在郡常慮為弘所繩夙夜勤勵政績甚美弘亦抑其私憾文帝兩嘉之韶之稱為良守徵為祠部尚書加給事中坐去郡長取送故免官後為吳興太守卒撰孝傳三卷文集行於世宋廟歌辭韶之所制也",
