    "person_reference_occurrences": [
      {
        "start": 106,
        "end": 107,
        "surface": "之",
        "id": "c-nanshi-022-wangcheng-anqi:p001:r0106",
        "paragraph_id": "c-nanshi-022-wangcheng-anqi:p001",
        "person_id": "7r6_k52_qji_ABAAAAEAABA",
        "referent_role": "third_person",
        "quote": "承字安期，初為秘書郎，累遷中書黃門侍郎，兼國子博士。時膏腴貴遊，咸以文學相尚，罕以經術為業；唯承獨好儒業。遷長兼侍中，俄轉國子祭酒。承祖儉父暕皆為此職，三世為國師，前代未之有。久之，出為東陽太守。政存寬惠，吏人悅之。卒郡，諡曰章。",
        "note": "本句按敘述視點回指承。"
      },
      {
        "start": 80,
        "end": 83,
        "surface": "小東陽",
        "id": "c-nanshi-022-wangcheng-anqi:p002:r0080",
        "paragraph_id": "c-nanshi-022-wangcheng-anqi:p002",
        "person_id": "7r6_k52_qji_ABAAAAEAABB",
        "referent_role": "third_person",
        "quote": "承性簡貴，有風格。右衛朱異當朝用事，每休下，車馬填門。有魏郡申英者，門寒才俊，好危言高論以忤權右。嘗指異門曰：「此中輻湊，皆為利往，能不至者，唯大小王東陽耳。」小東陽即承弟幼也。時唯承兄弟及褚翔不至異門，世並稱之。",
        "note": "本句按敘述視點回指幼。"
      },
      {
        "start": 92,
        "end": 94,
        "surface": "兄弟",
        "id": "c-nanshi-022-wangcheng-anqi:p002:r0092",
        "paragraph_id": "c-nanshi-022-wangcheng-anqi:p002",
        "person_id": "7r6_k52_qji_ABAAAAEAABB",
        "referent_role": "third_person",
        "quote": "承性簡貴，有風格。右衛朱異當朝用事，每休下，車馬填門。有魏郡申英者，門寒才俊，好危言高論以忤權右。嘗指異門曰：「此中輻湊，皆為利往，能不至者，唯大小王東陽耳。」小東陽即承弟幼也。時唯承兄弟及褚翔不至異門，世並稱之。",
        "note": "此處與承合舉的是上文小東陽弟幼。"
      }
