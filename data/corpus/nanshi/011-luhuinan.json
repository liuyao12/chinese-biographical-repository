    "person_reference_occurrences": [
      {
        "id": "c-nanshi-011-luhuinan:p001:r0000",
        "surface": "孝武昭路太后",
        "start": 0,
        "end": 6,
        "person_id": "bfe_7hz_jcb",
        "referent_role": "third_person",
        "paragraph_id": "c-nanshi-011-luhuinan:p001",
        "quote": "孝武昭路太后諱惠男，丹陽建康人也。以色貌選入後宮，生孝武帝，拜為淑媛。及年長，無寵，常隨孝武出蕃。孝武即位，有司奏奉尊號曰太后，宮曰崇憲。太后居顯陽殿，上於閨房之內禮敬甚寡，有所禦幸，或留止太后房內，故人間咸有醜聲。宮掖事秘，亦莫能辨也。",
        "note": "依本傳時序、語者與稱號。"
      },
