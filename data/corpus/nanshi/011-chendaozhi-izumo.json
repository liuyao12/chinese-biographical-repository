      "source_position": {
        "revision_id": "cbr-ai-transcription-sha256:36587911978ee911739ffcd0b91ad573faacfbc217c26d48a78e4d14b1be2409",
        "source_layer": "received_biography",
        "column_projection": [
          {
            "pdf_page": 17,
            "half": "左",
            "leaf": "十五上",
            "column_from_right": 7,
            "start": 0,
            "end": 18,
            "text": "齊宣孝陳皇后諱道止臨淮東陽人魏司徒矯"
          },
          {
            "pdf_page": 17,
            "half": "左",
            "leaf": "十五上",
            "column_from_right": 8,
            "start": 0,
            "end": 18,
            "text": "之後也后家貧少勤織作家人矜其勞或止之"
          },
          {
            "pdf_page": 17,
            "half": "左",
            "leaf": "十五上",
            "column_from_right": 9,
            "start": 0,
            "end": 18,
            "text": "后終不改嫁于宣帝宣帝庶生子衡陽元王道"
          },
          {
            "pdf_page": 18,
            "half": "右",
            "leaf": "十五下",
            "column_from_right": 1,
            "start": 0,
            "end": 18,
            "text": "度始安貞王道生后生高帝高帝年二歲乳人"
          },
          {
            "pdf_page": 18,
            "half": "右",
            "leaf": "十五下",
            "column_from_right": 2,
            "start": 0,
            "end": 18,
            "text": "乏乳后夢人以兩甌麻粥與之覺而乳驚因此"
          },
          {
            "pdf_page": 18,
            "half": "右",
            "leaf": "十五下",
            "column_from_right": 3,
            "start": 0,
            "end": 18,
            "text": "豐足宣帝從任在外后常留家有相者謂后曰"
          },
          {
            "pdf_page": 18,
            "half": "右",
            "leaf": "十五下",
            "column_from_right": 4,
            "start": 0,
            "end": 18,
            "text": "夫人有貴子而不見之后歎曰我三子誰當應"
          },
          {
            "pdf_page": 18,
            "half": "右",
            "leaf": "十五下",
            "column_from_right": 5,
            "start": 0,
            "end": 12,
            "text": "之呼高帝小字曰政應是汝耳"
          }
        ]
      }
    },
    {
      "id": "c-nanshi-011-chendaozhi-izumo:p002",
      "text": "宣帝殂後后親執勤婢使有過皆恕而不問高帝雖從宦而家業本貧為建康令時明帝等冬月猶無縑纊而奉膳甚厚后每撤去兼肉曰於我過足矣殂于縣舍昇明二年追贈竟陵公國太夫人齊國建為齊國太妃竝蜜印畫青綬祠以太牢建元元年追尊孝皇后贈外祖父肇之金紫光祿大夫諡敬侯后母胡氏為永昌縣靖君",
      "text_layer": "received_chapter",
      "annotation_status": "reviewed",
