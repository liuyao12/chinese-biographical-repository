      "source_position": {
        "revision_id": "cbr-ai-transcription-sha256:36587911978ee911739ffcd0b91ad573faacfbc217c26d48a78e4d14b1be2409",
        "source_layer": "received_biography",
        "column_projection": [
          {
            "pdf_page": 18,
            "half": "右",
            "leaf": "十五下",
            "column_from_right": 5,
            "start": 12,
            "end": 18,
            "text": "宣帝殂後后親"
          },
          {
            "pdf_page": 18,
            "half": "右",
            "leaf": "十五下",
            "column_from_right": 6,
            "start": 0,
            "end": 18,
            "text": "執勤婢使有過皆恕而不問高帝雖從宦而家"
          },
          {
            "pdf_page": 18,
            "half": "右",
            "leaf": "十五下",
            "column_from_right": 7,
            "start": 0,
            "end": 18,
            "text": "業本貧為建康令時明帝等冬月猶無縑纊而"
          },
          {
            "pdf_page": 18,
            "half": "右",
            "leaf": "十五下",
            "column_from_right": 8,
            "start": 0,
            "end": 18,
            "text": "奉膳甚厚后每撤去兼肉曰於我過足矣殂于"
          },
          {
            "pdf_page": 18,
            "half": "右",
            "leaf": "十五下",
            "column_from_right": 9,
            "start": 0,
            "end": 18,
            "text": "縣舍昇明二年追贈竟陵公國太夫人齊國建"
          },
          {
            "pdf_page": 18,
            "half": "左",
            "leaf": "十六上",
            "column_from_right": 1,
            "start": 0,
            "end": 18,
            "text": "為齊國太妃竝蜜印畫青綬祠以太牢建元元"
          },
          {
            "pdf_page": 18,
            "half": "左",
            "leaf": "十六上",
            "column_from_right": 2,
            "start": 0,
            "end": 18,
            "text": "年追尊孝皇后贈外祖父肇之金紫光祿大夫"
          },
          {
            "pdf_page": 18,
            "half": "左",
            "leaf": "十六上",
            "column_from_right": 3,
            "start": 0,
            "end": 13,
            "text": "諡敬侯后母胡氏為永昌縣靖君"
          }
        ]
      }
    },
    {
      "id": "c-nanshi-011-chendaozhi-izumo:p003",
      "text": "永明九年詔太廟四時祭宣皇帝薦起麵餅鴨𦞦孝皇后薦笋鴨卵脯醬炙白肉高皇帝薦肉膾葅羮昭皇后薦茗粣炙魚並生平所嗜也",
