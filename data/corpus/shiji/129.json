    {
      "id": "c-shiji-129-huozhi:p010",
      "text": "猗頓用盬鹽起。而邯鄲郭縱以鐵冶成業，與王者埒富。",
      "annotation_status": "in_progress",
      "text_layer": "received_chapter",
      "mentions": [
