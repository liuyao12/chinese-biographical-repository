  "relations": [
    {
      "id": "a-liang028-ji-zhigao",
      "subject_person_id": "4kt_0ar_aqo_AAAA",
      "object_person_id": "4kt_0ar_aqo_AAA",
      "predicate": "father",
      "qualifiers": {
