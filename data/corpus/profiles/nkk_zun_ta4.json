      "evidence": [
        {
          "work_id": "w-jinshu",
          "book_id": "b-jinshu-063",
          "chapter_id": "c-jinshu-063-duanpidi",
          "source_id": "s-jinshu-063-duanpidi-ws2025242",
          "paragraph_id": "c-jinshu-063-duanpidi:p001",
          "quote": "段匹磾，東部鮮卑人也。種類勁健，世為大人。父務勿塵，遣軍助東海王越征討有功，王浚表為親晉王，封遼西公，嫁女與務勿塵，以結鄰援。懷帝即位，以務勿塵為大單于，匹磾為左賢王，率眾助國征討，假撫軍大將軍。務勿塵死，弟涉復辰以務勿塵子疾陸眷襲號。",
          "subject_person_mention_id": "c-jinshu-063-duanpidi:p001:m0112",
          "object_person_mention_id": "c-jinshu-063-duanpidi:p001:m0022"
        }
      ],
      "status": "source_attested",
      "interpretation_note": "涉復辰以疾陸眷襲號，親稱與襲號各存。",
      "reviewer": "Codex（AI代理）",
      "model": null,
      "human_reviewed": false
    },
    {
      "id": "a-jin063-duanyang-juan-brother",
      "subject_person_id": "1i0_usm_vfm",
      "object_person_id": "nkk_zun_ta4",
      "predicate": "brother",
      "qualifiers": {
        "source_term": "疾陸眷及弟文鴦"
      },
      "evidence": [
        {
          "work_id": "w-jinshu",
          "book_id": "b-jinshu-063",
          "chapter_id": "c-jinshu-063-duanpidi",
          "source_id": "s-jinshu-063-duanpidi-ws2025242",
          "paragraph_id": "c-jinshu-063-duanpidi:p002",
          "quote": "劉曜逼洛陽，王浚遣督護王昌等率疾陸眷及弟文鴦、從弟末杯攻石勒于襄國。勒敗還壘，末杯追入壘門，為勒所獲。勒質末杯，遣使求和于疾陸眷，疾陸眷將許之，文鴦諫曰：「受命討勒，寧以末杯一人，故縱成擒之冠？既失浚意，且有後憂，必不可許。」疾陸眷不聽，以鎧馬二百五十匹、金銀各一簏贈末杯。勒歸之，又厚以金寶采絹報疾陸眷。疾陸眷令文鴦與石季龍同盟，約為兄弟，遂引騎還。昌等不能獨守，亦還。",
          "subject_person_mention_id": "c-jinshu-063-duanpidi:p002:m0020",
          "object_person_mention_id": "c-jinshu-063-duanpidi:p002:m0015"
        }
      ],
      "status": "source_attested",
      "interpretation_note": "原文具弟文鴦。",
      "reviewer": "Codex（AI代理）",
      "model": null,
      "human_reviewed": false
    },
