      "kind": "received_sentence",
      "person_id": "hx8_hzi_iq5",
      "source_quote": "籍注季高，故字行於世。",
      "reading": "戶籍以季高記，遂行字。",
      "note": "戶籍以季高記，遂行字。",
      "paragraph_id": "c-songshu-049-sunchu:p001",
