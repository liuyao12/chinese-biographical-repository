    },
    {
      "id": "c-liangshu-055-hedong-wangyu-parent:p001:r0008",
      "surface": "昭明太子",
      "start": 8,
      "end": 12,
      "person_id": "0va_s3x_wb4",
      "referent_role": "third_person",
      "paragraph_id": "c-liangshu-055-hedong-wangyu-parent:p001",
      "quote": "河東王譽字重孫，昭明太子第二子也。",
      "note": "梁昭明太子蕭統。",
      "chapter_id": "c-liangshu-055-hedong-wangyu-parent",
      "book_id": "b-liangshu-055",
