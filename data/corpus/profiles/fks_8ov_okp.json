  "occurrences": [
    {
      "number": 4,
      "category": "benji",
      "title": "周本紀第四",
      "paragraph_id": "c-shiji-004-zhou:p064",
      "count": 1,
      "quote": "定王十六年，三晉滅智伯，分有其地。"
    },
    {
      "number": 5,
      "category": "benji",
      "title": "秦本紀第五",
      "paragraph_id": "c-shiji-005-qin:p047",
      "count": 1,
      "quote": "二萬伐大荔，取其王城。二十一年，初縣頻陽。晉取武成。二十四年，晉亂，殺智伯，分其國與趙、韓、魏。二十五年，智開與邑人來奔。三十三年，伐義渠，虜其王。三十四年，日食。厲共公卒，子躁公立。"
    },
    {
      "number": 6,
      "category": "benji",
      "title": "秦始皇本紀第六",
      "paragraph_id": "c-shiji-006-shihuang:p011",
      "count": 1,
      "quote": "秦王曰：「以秦之彊，諸侯譬如郡縣之君，臣但恐諸侯合從，翕而出不意，此乃智伯、夫差、湣王之所以亡也。願大王毋愛財物，賂其豪臣，以亂其謀，不過亡三十萬金，則諸侯可盡。」秦王從其計，見尉繚亢禮，衣服食飲與繚同。繚曰：「秦王為人，蜂準，長目，摯鳥膺，豺聲，少恩而虎狼心，居約易出人下"
    },
    {
      "number": 33,
      "category": "shijia",
      "title": "魯周公世家第三",
      "paragraph_id": "c-shiji-033-lu:p091",
      "count": 1,
      "quote": "十三年，三晉滅智伯，分其地有之。"
    },
    {
      "number": 34,
      "category": "shijia",
      "title": "燕召公世家第四",
      "paragraph_id": "c-shiji-034-yan:p015",
      "count": 1,
      "quote": "孝公十二年，韓、魏、趙滅知伯，分其地，三晉彊。"
    },
    {
      "number": 39,
      "category": "shijia",
      "title": "晉世家第九",
      "paragraph_id": "c-shiji-039-jin:p133",
      "count": 7,
      "quote": "出公十七年，知伯與趙、韓、魏共分范、中行地以爲邑。出公怒，告齊、魯，欲以伐四卿。四卿恐，遂反攻出公。出公奔齊，道死。故知伯乃立昭公曾孫驕爲晉君，是爲哀公。"
    },
    {
      "number": 43,
      "category": "shijia",
      "title": "趙世家第十三",
      "paragraph_id": "c-shiji-043-zhao:p035",
      "count": 9,
      "quote": "晉出公十一年，知伯伐鄭。趙簡子疾，使太子毋卹將而圍鄭。知伯醉，以酒灌撃毋卹。毋卹群臣請死之。毋卹曰：「君所以置毋卹，爲能忍訽。」然亦慍知伯。知伯歸，因謂簡子，使廢毋卹，簡子不聽。毋卹由此怨知伯。"
    },
    {
      "number": 86,
      "category": "liezhuan",
      "title": "刺客列傳第二十六",
      "paragraph_id": "c-shiji-086-cike:p009",
      "count": 16,
      "quote": "豫讓者，晉人也，故嘗事范氏及中行氏，而無所知名。去而事智伯，智伯甚尊寵之。及智伯伐趙襄子，趙襄子與韓、魏合謀滅智伯，滅智伯之後而三分其地。趙襄子最怨智伯，漆其頭以爲飲器。豫讓遁逃山中，曰：「嗟乎！士爲知己者死，女爲説己者容。今智伯知我，我必爲報讎而死，以報智"
    }
  ],
