    },
    {
      "number": 126,
      "category": "liezhuan",
      "title": "滑稽列傳第六十六",
      "paragraph_id": "c-shiji-126-huaji:p013",
      "count": 1,
      "raw_count": 1,
      "duplicate_count": 0,
      "counting_policy": "independent_fixed_witness_occurrences",
      "quote": "褚先生曰：臣幸得以經術為郎，而好讀外家傳語。竊不遜讓，復作故事滑稽之語六章，編之於左。可以覽觀揚意，以示後世好事者讀之，以游心駭耳，以附益上方太史公之三章。",
      "paragraph_ids": [
        "c-shiji-126-huaji:p013"
