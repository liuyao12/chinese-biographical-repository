  "source_reading_cases": [
    {
      "id": "c-sanguozhi-054-lvmeng:line073:reading-000-154",
      "kind": "received_sentence",
      "paragraph_id": "c-sanguozhi-054-lvmeng:line073",
      "start_codepoint": 0,
      "end_codepoint": 154,
      "source_quote": "玄之見普，具宣蒙意，普懼而聽之。玄之先出報蒙：「普尋後當至。」蒙豫敕四將，各選百人，普出，便入守城門。須臾普出，蒙迎執其手，與俱下船。語畢，出書示之。因拊手大笑。普見書，知備在公安，而羽在益陽，慚恨入地。蒙留（孫河），委以後事，即日引軍赴益陽。劉備請盟，權乃歸普等。割湘水，以零陵還之。以尋陽、陽新為蒙奉邑。",
      "person_id": "w6s_yzx_gu2",
      "related_person_ids": [
        "t5o_ymn_5ke",
        "ibt_i7u_ykp",
        "5f2_396_25c",
        "1c2_03c_9ea",
        "uqm_12h_3at",
        "572_278_cba"
      ],
      "reading": "郝普受勸後見書，得知劉備、關羽實際所在。蒙留孫河委後事，較早死於宛陵的孫河字伯海不能逕合，數位括注與殿本異。",
      "chapter_id": "c-sanguozhi-054-lvmeng",
      "source_id": "s-sanguozhi-054-lvmeng"
    }
