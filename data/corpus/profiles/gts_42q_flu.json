        {
          "chapter_id": "c-shiji-042-zheng",
          "source_id": "s-shiji-042-zheng",
          "paragraph_id": "c-shiji-042-zheng:p031",
          "quote": "悼公元年，鄦公惡鄭於楚，悼公使弟睔於楚自訟。訟不直，楚囚睔。於是鄭悼公來與晉平，遂親。睔私於楚子反，子反言歸睔於鄭。"
        }
      ],
      "qualifiers": {
        "source_term": "悼公使弟睔",
        "historicity": "historical_tradition"
      },
      "interpretation_note": "依明示子、母、兄弟及祖系保存來源主張；不把繼位當父子，不由兄弟推同母。傳說及夢中祖先主張保留敘事性，不冒稱已證史實。",
      "reviewer": "Codex（AI 代理）"
    },
    {
      "id": "a-shiji042-027",
      "subject_person_id": "1ec_jmi_32g",
      "predicate": "brother",
      "object_person_id": "gts_42q_flu",
      "status": "source_attested",
      "evidence": [
        {
          "chapter_id": "c-shiji-042-zheng",
          "source_id": "s-shiji-042-zheng",
          "paragraph_id": "c-shiji-042-zheng:p033",
          "quote": "成公三年，楚共王曰「鄭成公孤有德焉」，使人來與盟。成公私與盟。秋，成公朝晉，晉曰「鄭私平於楚」，執之。使欒書伐鄭。四年春，鄭患晉圍，公子如乃立成公庶兄繻爲君。其四月，晉聞鄭立君，乃歸成公。鄭人聞成公歸，亦殺君繻，迎成公。晉兵去。"
        }
      ],
      "qualifiers": {
        "source_term": "成公庶兄繻",
        "historicity": "historical_tradition"
      },
      "interpretation_note": "依明示子、母、兄弟及祖系保存來源主張；不把繼位當父子，不由兄弟推同母。傳說及夢中祖先主張保留敘事性，不冒稱已證史實。",
      "reviewer": "Codex（AI 代理）"
    },
    {
      "id": "a-shiji042-028",
      "subject_person_id": "gts_42q_flu_A",
      "predicate": "father",
      "object_person_id": "gts_42q_flu",
