      "evidence": [
        {
          "chapter_id": "c-shiji-042-zheng",
          "source_id": "s-shiji-042-zheng",
          "paragraph_id": "c-shiji-042-zheng:p049",
          "quote": "聲公五年，鄭相子産卒，鄭人皆哭泣，悲之如亡親戚。子産者，鄭成公少子也。爲人仁愛人，事君忠厚。孔子嘗過鄭，與子産如兄弟云。及聞子産死，孔子爲泣曰：「古之遺愛也！」"
        }
      ],
      "qualifiers": {
        "source_term": "子産者，鄭成公少子",
        "historicity": "historical_tradition"
      },
      "interpretation_note": "依明示子、少子及弟保存來源主張，繼位不獨作父子，如兄弟不作血親；不補母名、年代或同父同母。",
      "reviewer": "Codex（AI 代理）"
    }
  ],
