          "canonical_mention_id": "c-sanguozhi-058-luxun:line055:m0231",
          "mention_ids": [
            "c-sanguozhi-058-luxun:line055:m0231"
          ],
          "kind": "paragraph"
        }
      ],
      "work_id": "w-sanguozhi",
      "book_id": "b-sanguozhi-058",
      "chapter_id": "c-sanguozhi-058-luxun",
      "source_id": "s-sanguozhi-058-luxun",
      "work_title": "三國志"
    },
    {
      "number": 59,
      "category": "",
      "title": "孫和傳",
      "paragraph_id": "c-sanguozhi-059-he:line036",
      "count": 1,
      "raw_count": 1,
      "duplicate_count": 0,
      "counting_policy": "independent_fixed_witness_occurrences",
      "quote": "鼎二年七月，使守大匠薛珝營立寢堂，號曰清廟。十二月，遣守丞相孟仁、太常姚信等備官寮中軍步騎二千人，以靈輿法駕，東迎神於明陵。皓引見仁，親拜送於庭。靈輿當至，使丞相陸凱奉三牲祭於近郊，皓於金城外露宿。明日，望拜於東門之外。其翌日，拜廟薦祭，歔欷悲感。比七日三祭，倡技晝夜娛樂。",
      "paragraph_ids": [
        "c-sanguozhi-059-he:line036"
      ],
      "mention_ids": [
        "c-sanguozhi-059-he:line036:m0135"
      ],
      "mention_paragraph_ids": {
        "c-sanguozhi-059-he:line036:m0135": "c-sanguozhi-059-he:line036"
      },
      "mention_id": "c-sanguozhi-059-he:line036:m0135",
      "occurrence_groups": [
        {
          "canonical_mention_id": "c-sanguozhi-059-he:line036:m0135",
          "mention_ids": [
            "c-sanguozhi-059-he:line036:m0135"
          ],
          "kind": "paragraph"
        }
      ],
      "work_id": "w-sanguozhi",
      "book_id": "b-sanguozhi-059",
      "chapter_id": "c-sanguozhi-059-he",
      "source_id": "s-sanguozhi-059-he",
      "work_title": "三國志"
    },
    {
      "number": 61,
      "category": "",
      "title": "陸凱傳",
      "paragraph_id": "c-sanguozhi-061-lukai:line042",
      "count": 1,
      "raw_count": 1,
      "duplicate_count": 0,
      "counting_policy": "independent_fixed_witness_occurrences",
      "quote": "宣授外任，不宜委以國事。奚熙小吏，建起浦裡田，欲復嚴密故跡，亦不可聽。姚信、樓玄、賀劭、張悌、郭逴、薛瑩、滕脩及族弟喜，抗，或清白忠勤，或姿才卓茂，皆社稷之楨干，國家之良輔。願陛下重留神思，訪以時務，各盡其忠，拾遺萬一。”遂卒，時年七十二。",
      "paragraph_ids": [
        "c-sanguozhi-061-lukai:line042"
      ],
      "mention_ids": [
