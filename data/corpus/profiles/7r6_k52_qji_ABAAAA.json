          "excerpts": [
            {
              "proposed_paragraph_id": "c-songshu-042-wanghong:p001",
              "source_lines": [
                45,
                46
              ],
              "raw_quote": "王弘字休元，琅邪臨沂人也。曾祖導，晉丞相。祖洽，中領軍。父珣，司徒。",
              "raw_quote_sha256": "1807de52983c1590494d092a989d619b624965095b772a9ff0721fcb039f891d",
              "selected_text_sha256": "1807de52983c1590494d092a989d619b624965095b772a9ff0721fcb039f891d",
              "begin_anchor": "王弘字休元，琅邪臨沂人也。曾祖",
              "end_anchor": "相。祖洽，中領軍。父珣，司徒。",
