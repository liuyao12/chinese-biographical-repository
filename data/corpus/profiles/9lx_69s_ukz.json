      "source_term": "歸義馬茂懷奸，覺誅",
      "date_expression": null,
      "evidence": [
        {
          "work_id": "w-sanguozhi",
          "book_id": "b-sanguozhi-056",
          "chapter_id": "c-sanguozhi-056-zhuran",
