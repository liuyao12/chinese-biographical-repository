    {
      "id": "th-shiji066-023",
      "person_id": "q60_34y_1zh",
      "title": "楚惠王",
      "kind": "royal_rank",
      "mode": "attestation",
      "status": "source_attested",
      "evidence": [
        {
          "chapter_id": "c-shiji-066-wu",
          "source_id": "s-shiji-066-wu",
          "paragraph_id": "c-shiji-066-wu:p021",
          "quote": "伍子胥初所與俱亡故楚太子建之子勝者，在於吳。吳王夫差之時，楚惠王欲召勝歸楚。葉公諫曰：「勝好勇而陰求死士，殆有私乎！」惠王不聽。遂召勝，使居楚之邊邑鄢，號為白公。白公歸楚三年而吳誅子胥。"
        }
      ],
      "attestations": [
