  "occurrences": [
    {
      "number": 31,
      "category": "shijia",
      "title": "吳太伯世家第一",
      "paragraph_id": "c-shiji-031-wu:p016",
      "count": 1,
      "quote": "七年，楚公子圍弑其王夾敖而代立，是爲靈王。十年，楚靈王會諸侯而以伐吳之硃方，以誅齊慶封。吳亦攻楚，取三邑而去。十一年，楚伐吳，至雩婁。十二年，楚復來伐，次於乾谿，楚師敗走。",
      "work_id": "w-shiji",
      "book_id": "b-shiji-031",
      "chapter_id": "c-shiji-031-wu",
      "source_id": "s-shiji-031-wu",
      "work_title": "史記",
      "paragraph_ids": [
        "c-shiji-031-wu:p016"
      ],
