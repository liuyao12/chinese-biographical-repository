      ]
    },
    {
      "number": 35,
      "category": "shijia",
      "title": "管蔡世家第五",
      "paragraph_id": "c-shiji-035-guancai:p015",
      "count": 1,
      "quote": "靈侯二年，楚公子圍弒其王郟敖而自立，為靈王。九年，陳司徒招弒其君哀公。楚使公子棄疾滅陳而有之。十二年，楚靈王以靈侯弒其父，誘蔡靈侯于申，伏甲飲之，醉而殺之，刑其士卒七十人。令公子棄疾圍蔡。十一月，滅蔡，使棄疾為蔡公。",
      "work_id": "w-shiji",
      "book_id": "b-shiji-035",
      "chapter_id": "c-shiji-035-guancai",
      "source_id": "s-shiji-035-guancai",
      "work_title": "史記",
      "paragraph_ids": [
        "c-shiji-035-guancai:p015"
      ],
      "mention_ids": [
        "c-shiji-035-guancai:m015-0012"
      ]
    },
    {
      "number": 36,
      "category": "shijia",
      "title": "陳杞世家第六",
      "paragraph_id": "c-shiji-036-chenqi:p019",
      "count": 1,
      "quote": "哀公三年，楚圍陳，復釋之。二十八年，楚公子圍弒其君郟敖自立，為靈王。",
      "work_id": "w-shiji",
      "book_id": "b-shiji-036",
