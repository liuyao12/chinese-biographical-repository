  "titles": [
    {
      "id": "th-jin034-duyu-career_062",
      "person_id": "56f_8f7_e9f_AAB",
      "status": "source_attested",
      "evidence": [
        {
          "work_id": "w-jinshu",
          "book_id": "b-jinshu-034",
          "chapter_id": "c-jinshu-034-duyu",
          "source_id": "s-jinshu-034-ws2567662-duyu",
          "paragraph_id": "c-jinshu-034-duyu:p025",
          "quote": "錫字世嘏。少有盛名，起家長沙王乂文學，累遷太子中舍人。性亮直忠烈，屢諫湣懷太子，言辭懇切，太子患之。後置針著錫常所坐處氈中，刺之流血。他日，太子問錫：「向著何事？」錫對：「醉不知。」太子詰之曰：「君喜責人，何自作過也。」後轉衛將軍長史。趙王倫篡位，以為治書御史。孫秀求交於錫，而錫拒之，秀雖銜之，憚其名高，不敢害也。惠帝反政，遷吏部郎、城陽太守，不拜，仍遷尚書左丞。年四十八卒，贈散騎常侍。子乂嗣，在《外戚傳》。",
          "person_mention_id": "c-jinshu-034-duyu:p025:m0000"
        }
      ],
      "reviewer": "Codex（AI代理）",
      "human_reviewed": false,
