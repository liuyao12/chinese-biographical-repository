  "person_references": [
    {
      "id": "c-chenshu-023-wangyu-complete:p001:r0102",
      "paragraph_id": "c-chenshu-023-wangyu-complete:p001",
      "start": 102,
      "end": 103,
      "surface": "其",
      "person_id": "9ee_moy_m31",
      "referent_role": "third_person",
      "quote": "瑒第十三弟瑜，字子珪，亦知名，美容儀，早歷清顯，年（五）〔三〕十，官至侍中。永定元年，使於齊，以陳郡袁憲為副，齊以王琳之故，執而囚之。齊文宣帝每行，載死囚以從，齊人呼曰「供御囚」，每有他怒，則召殺之，以快其意。瑜及憲並危殆者數矣，齊僕射楊遵彥憫其無辜，每救護之。天嘉二年還朝，詔復侍中，頃之卒，時年四十。贈本官，諡曰貞子。",
      "note": "依本段敘事、稱謂及語者受者定。",
      "chapter_id": "c-chenshu-023-wangyu-complete",
      "book_id": "b-chenshu-023",
      "work_id": "w-chenshu",
      "source_id": "s-chenshu-023-wangyu-complete-ws1514496"
    },
    {
      "start": 48,
      "end": 51,
      "surface": "齊文宣",
      "id": "c-nanshi-021-wangyu:p001:r0048",
      "paragraph_id": "c-nanshi-021-wangyu:p001",
      "person_id": "9ee_moy_m31",
      "referent_role": "third_person",
      "quote": "瑒弟瑜字子珪，亦知名。美容儀。年三十，官至侍中。永定元年使齊，以陳郡袁憲爲副。齊以王琳故，囚之。齊文宣毎行，載死囚以從，齊人呼曰供禦囚。毎佗怒，則召殺之。瑜及憲並危殆者數矣，齊僕射楊遵彥毎救護之。天嘉二年還朝，復爲侍中。卒，諡曰貞子。",
      "note": "本句按敘述視點回指文宣。",
      "chapter_id": "c-nanshi-021-wangyu",
      "book_id": "b-nanshi-021",
      "work_id": "w-nanshi",
      "source_id": "s-nanshi-021-wangyu-ws1752646"
    }
