      "source_id": "s-jinshu-065-wangdao-family",
      "source": {
        "title": "《晉書》卷六十五（數位選錄）",
        "provider": "Wikisource",
        "url": "https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7065&oldid=1756144",
        "permalink": "https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7065&oldid=1756144",
