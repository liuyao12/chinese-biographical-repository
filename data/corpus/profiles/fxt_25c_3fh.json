          "mention_ids": [
            "c-jinshu-098-jin033-wangji:line081:m0008"
          ],
          "kind": "paragraph"
        }
      ],
      "work_id": "w-jinshu",
      "book_id": "b-jinshu-098",
      "chapter_id": "c-jinshu-098-jin033-wangji",
