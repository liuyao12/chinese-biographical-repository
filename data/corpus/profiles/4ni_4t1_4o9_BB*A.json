      "references": [
        {
          "work_id": "w-liangshu",
          "book_id": "b-liangshu-030",
          "chapter_id": "c-liangshu-030-peiziye",
          "source_id": "s-liang030-ws1508510",
          "paragraph_id": "c-liangshu-030-peiziye:p001",
          "quote": "裴子野字幾原，河東聞喜人，晉太子左率康八世孫。兄黎，弟楷、綽，並有盛名，所謂「四裴」也。曾祖松之，宋太中大夫。祖駰，南中郎外兵參軍。父昭明，通直散騎常侍。",
          "subject_person_mention_id": "c-liangshu-030-peiziye:p001:m0000",
          "object_person_mention_id": "c-liangshu-030-peiziye:p001:m0018",
          "assertion_id": "a-liang030-ziye-kang-ancestor",
          "scope": "遠祖報數、指定編輯世距解碼及完整近鏈；珪→昧仍屬連續祖先編輯父邊，不作來源明父。",
          "url": "https://zh.wikisource.org/w/index.php?title=%E6%A2%81%E6%9B%B8%2F%E5%8D%B730&oldid=1508510"
        },
        {
          "work_id": "w-nanshi",
          "book_id": "b-nanshi-033",
          "source_id": "s-nanshi033-ws1554233",
          "chapter_id": "c-nanshi-033-pei-family",
          "paragraph_id": "c-nanshi-033-pei-family:p013",
          "quote": "九年復北使。建武初，為王玄邈安北長史、廣陵太守。明帝以其在事無啟奏，代還責之，昭明曰：「臣不欲競執關鍵故耳。」昭明曆郡皆清勤，常謂人曰：「人生何事須聚畜，一身之外亦復何須。子孫若不才，我聚彼散。若能自立，則不如一經。」故終身一不事產業。中興二年卒。子子野。",
          "subject_person_mention_id": "c-nanshi-033-pei-family:p013:m0125",
          "object_person_mention_id": "c-nanshi-033-pei-family:p013:m0039",
          "assertion_id": "a-nanshi033-ziye-father",
          "scope": "遠祖報數、指定編輯世距解碼及完整近鏈；珪→昧仍屬連續祖先編輯父邊，不作來源明父。",
          "url": "https://zh.wikisource.org/w/index.php?title=%E5%8D%97%E5%8F%B2%2F%E5%8D%B733&oldid=1554233"
        },
        {
          "work_id": "w-nanshi",
          "book_id": "b-nanshi-033",
          "source_id": "s-nanshi033-ws1554233",
          "chapter_id": "c-nanshi-033-pei-family",
          "paragraph_id": "c-nanshi-033-pei-family:p009",
          "quote": "子駰，南中郎參軍。松之所著文論及晉記，駰注司馬遷《史記》，並行於世。駰子昭明。",
          "subject_person_mention_id": "c-nanshi-033-pei-family:p009:m0036",
          "object_person_mention_id": "c-nanshi-033-pei-family:p009:m0001",
