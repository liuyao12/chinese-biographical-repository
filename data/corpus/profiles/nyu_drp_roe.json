    {
      "id": "th-w043-guo-131-8",
      "person_id": "nyu_drp_roe",
      "title": "別駕",
      "kind": "office",
      "mode": "attestation",
      "evidence": [
        {
          "work_id": "w-jinshu",
          "book_id": "b-jinshu-043",
          "chapter_id": "c-jinshu-043-guoshu",
          "source_id": "s-jinshu-043-guoshu",
          "paragraph_id": "c-jinshu-043-guoshu:line131",
          "quote": "王澄聞其名，引為別駕。澄終日酣飲，不以眾務在意，舒常切諫之。及天下大亂，又勸澄修德養威，保完州境。澄以為亂自京都起，非復一州所能匡禦，雖不能從，然重其忠亮。荊土士人宗庾廞嘗因酒忤澄，澄怒，叱左右棒廞。舒厲色謂左右曰：「使君過醉，汝輩何敢妄動！」澄恚曰：「別駕狂邪，誑言我醉！」因遣掐其鼻，灸其眉頭，舒跪而受之。澄意少釋，而廞遂得免。",
          "person_mention_id": "c-jinshu-043-guoshu:line131:m0024"
        }
      ],
