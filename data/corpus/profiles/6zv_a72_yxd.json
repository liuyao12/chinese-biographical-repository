      "evidence": [
        {
          "work_id": "w-jinshu",
          "book_id": "b-jinshu-059",
          "chapter_id": "c-jinshu-059-prince-yue",
          "source_id": "s-jinshu-059-prince-yue-ws2650517",
          "paragraph_id": "c-jinshu-059-prince-yue:p009",
          "quote": "越專擅威權，圖為霸業，朝賢素望，選為佐吏，名將勁卒，充於己府，不臣之跡，四海所知。而公私罄乏，所在寇亂，州郡攜貳，上下崩離，禍結釁深，遂憂懼成疾。永嘉五年，薨于項。秘不發喪。以襄陽王范為大將軍，統其眾。還葬東海。石勒追及于苦縣甯平城，將軍錢端出兵距勒，戰死，軍潰。勒命焚越柩曰：「此人亂天下，吾為天下報之，故燒其骨以告天地。」於是數十萬眾，勒以騎圍而射之，相踐如山。王公士庶死者十餘萬。王彌弟璋焚其餘眾，並食之。天下歸罪於越。帝發詔貶越為縣王。",
          "subject_person_mention_id": "c-jinshu-059-prince-yue:p009:m0196",
          "object_person_mention_id": "c-jinshu-059-prince-yue:p009:m0193"
        }
      ],
      "status": "source_attested",
      "interpretation_note": "同段明具弟。",
