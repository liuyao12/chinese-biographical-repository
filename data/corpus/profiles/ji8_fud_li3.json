  "occurrences": [
    {
      "number": 44,
      "category": "",
      "title": "晉書卷四十四·鄭默傳",
      "paragraph_id": "c-jinshu-044-zhengmo:line026",
      "count": 1,
      "raw_count": 1,
      "duplicate_count": 0,
      "counting_policy": "independent_fixed_witness_occurrences",
      "quote": "兄弟以潔慎不染其流。遷太常。時僕射山濤欲舉一親親為博士，謂默曰：「卿似尹翁歸，令吾不敢復言。」默為人敦重，柔而能整，皆此類也。",
      "paragraph_ids": [
        "c-jinshu-044-zhengmo:line026"
      ],
