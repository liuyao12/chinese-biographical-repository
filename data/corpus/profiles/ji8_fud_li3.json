    {
      "number": 112,
      "category": "liezhuan",
      "title": "平津侯主父列傳第五十二",
      "paragraph_id": "c-shiji-112-pingjin:p030",
      "count": 1,
      "raw_count": 1,
      "duplicate_count": 0,
      "counting_policy": "independent_fixed_witness_occurrences",
      "quote": "、邴吉、于定國、杜延年，治民則黃霸、王成、龔遂、鄭弘、邵信臣、韓延壽、尹翁歸、趙廣漢之屬，皆有功跡見述於後。累其名臣，亦其次也。",
      "paragraph_ids": [
