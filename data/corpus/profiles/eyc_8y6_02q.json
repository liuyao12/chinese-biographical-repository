      ],
      "mention_ids": [
        "c-shiji-034-yan:m024-0021",
        "c-shiji-034-yan:m024-0083",
        "c-shiji-034-yan:m024-0096",
        "c-shiji-034-yan:m024-0102",
        "c-shiji-034-yan:m024-0117"
      ]
    },
    {
      "number": 80,
      "category": "liezhuan",
      "title": "樂毅列傳第二十",
      "paragraph_id": "c-shiji-080-leyi:p002",
      "count": 1,
      "quote": "王怨齊，未嘗一日而忘報齊也。燕國小，辟遠，力不能制，於是屈身下士，先禮郭隗以招賢者。樂毅於是為魏昭王使於燕，燕王以客禮待之。樂毅辭讓，遂委質為臣，燕昭王以為亞卿，久之。",
      "work_id": "w-shiji",
      "book_id": "b-shiji-080",
