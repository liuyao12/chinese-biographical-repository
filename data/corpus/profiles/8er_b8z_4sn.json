          "mention_ids": [
            "c-jinshu-059-prince-ying:p005:m0033"
          ],
          "kind": "paragraph"
        }
      ],
      "work_id": "w-jinshu",
      "book_id": "b-jinshu-059",
      "chapter_id": "c-jinshu-059-prince-ying",
      "source_id": "s-jinshu-059-prince-ying-ws2650517",
