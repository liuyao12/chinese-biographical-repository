    {
      "id": "c-liangshu-050-xiejiqing-family-intro:p004:r0068",
      "start": 68,
      "end": 71,
      "surface": "湘東王",
      "person_id": "rvc_bqx_v5w",
      "paragraph_id": "c-liangshu-050-xiejiqing-family-intro:p004",
      "quote": "湘東王在荊鎮",
      "referent_role": "third_person",
      "note": "蕭繹，以王號稱。",
      "chapter_id": "c-liangshu-050-xiejiqing-family-intro",
      "book_id": "b-liangshu-050",
