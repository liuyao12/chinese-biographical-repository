    {
      "id": "th-shiji120-026",
      "person_id": "jws_b08_hob",
      "title": "太史",
      "kind": "office",
      "mode": "attestation",
      "status": "source_attested",
      "evidence": [
        {
          "chapter_id": "c-shiji-120-jizheng",
          "source_id": "s-shiji120-jizheng",
          "paragraph_id": "c-shiji-120-jizheng:p017",
          "quote": "莊為太史，誡門下：「客至，無貴賤無留門者。」執賓主之禮，以其貴下人。莊廉，又不治其產業，仰奉賜以給諸公。然其餽遺人，不過算器食。每朝，候上之閒，說未嘗不言天下之長者。其推轂士及官屬丞史，誠有味其言之也，常引以為賢於己。未嘗名吏，與官屬言，若恐傷之。聞人之善言，進之上，唯恐後。山東士諸公以此翕然稱鄭莊。"
        }
      ],
      "attestations": [
        {
          "id": "th-shiji120-026:a001",
          "paragraph_id": "c-shiji-120-jizheng:p017",
          "start": 2,
          "end": 4,
          "surface": "太史",
          "person_mention_id": "c-shiji-120-jizheng:m017-0000",
          "usage": "narrative",
          "date_expression": null
        }
      ],
