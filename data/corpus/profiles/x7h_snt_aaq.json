          },
          {
            "face": "陰",
            "column_from_right": 3,
            "text": "永嘉元年逆",
            "extent": "bottom",
            "start": 43,
            "end": 48,
            "image_url": "https://img.dpm.org.cn/Uploads/Picture/dc/15338[1024].jpg"
          },
          {
            "face": "陰",
            "column_from_right": 4,
            "text": "賊汲桑破鄴都之後遂肆其凶暴東北其年九月五",
            "extent": "full_column_or_visible_clause",
            "start": 48,
            "end": 68,
            "image_url": "https://img.dpm.org.cn/Uploads/Picture/dc/15338[1024].jpg"
          },
          {
            "face": "陰",
            "column_from_right": 5,
            "text": "日奄見攻圍尠親率邑族臨危守節義舊不回眾寡",
            "extent": "full_column_or_visible_clause",
            "start": 68,
            "end": 88,
            "image_url": "https://img.dpm.org.cn/Uploads/Picture/dc/15338[1024].jpg"
          },
          {
            "face": "陰",
            "column_from_right": 6,
            "text": "不敵七日城陷薨年六十二",
            "extent": "top",
            "start": 88,
            "end": 99,
            "image_url": "https://img.dpm.org.cn/Uploads/Picture/dc/15338[1024].jpg"
          },
          {
            "face": "陰",
            "column_from_right": 7,
            "text": "二年七月十九日祔葬于皇考墓側神道",
            "extent": "after_護喪",
            "start": 100,
            "end": 116,
            "image_url": "https://img.dpm.org.cn/Uploads/Picture/dc/15338[1024].jpg"
          },
          {
            "face": "陰",
            "column_from_right": 8,
            "text": "之右",
            "extent": "top",
            "start": 116,
            "end": 118,
            "image_url": "https://img.dpm.org.cn/Uploads/Picture/dc/15338[1024].jpg"
          },
          {
