    },
    {
      "number": 97,
      "category": "liezhuan",
      "title": "酈生陸賈列傳第三十七",
      "paragraph_id": "c-shiji-097-luli:p004",
      "count": 2,
      "quote": "酈生言其弟酈商，使將數千人從沛公西南略地。酈生常為說客，馳使諸侯。"
    }
