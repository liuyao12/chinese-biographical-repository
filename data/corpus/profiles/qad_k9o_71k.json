  "occurrences": [
    {
      "number": 8,
      "category": "",
      "title": "白鹿原、枋頭、壽陽及會塗中",
      "paragraph_id": "c-jinshu-008-jin098-huanwen-fangtou:sep",
      "count": 1,
      "raw_count": 1,
      "duplicate_count": 0,
      "counting_policy": "independent_fixed_witness_occurrences",
      "quote": "九月戊寅，桓溫裨將鄧遐、朱序遇暐將傅末波于林渚，又大破之。戊子，溫至枋頭。丙申，以糧運不繼，焚舟而歸。辛丑，慕容垂追敗溫後軍于襄邑。",
