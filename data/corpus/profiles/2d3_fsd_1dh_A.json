      ],
      "mention_ids": [
        "c-shiji-036-chenqi:m014-0060",
        "c-shiji-036-chenqi:m014-0075",
        "c-shiji-036-chenqi:m030-0107"
      ]
    },
    {
      "number": 38,
      "category": "shijia",
      "title": "宋微子世家第八",
      "paragraph_id": "c-shiji-038-song:p041",
      "count": 1,
      "quote": "王伐宋，宋告急於晉。五年，晉文公救宋，楚兵去。九年，晉文公卒。十一年，楚太子商臣弒其父成王代立。十六年，秦穆公卒。",
      "work_id": "w-shiji",
