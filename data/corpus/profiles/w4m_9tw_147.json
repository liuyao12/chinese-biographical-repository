      "start": 9,
      "end": 11,
      "surface": "明帝",
      "paragraph_id": "c-nanqishu-050-xietiao-princes:p002",
      "person_id": "w4m_9tw_147",
      "referent_role": "third_person",
      "quote": "江夏王寶玄字智深，明帝第三子也。",
      "note": "依語境讀作蕭明帝。",
      "chapter_id": "c-nanqishu-050-xietiao-princes",
      "book_id": "b-nanqishu-050",
