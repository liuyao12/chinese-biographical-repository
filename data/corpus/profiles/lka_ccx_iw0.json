      },
      "evidence": [
        {
          "work_id": "w-jinshu",
          "book_id": "b-jinshu-062",
          "chapter_id": "c-jinshu-062-liukun",
          "source_id": "s-jinshu-062-liukun-ws2629226",
          "paragraph_id": "c-jinshu-062-liukun:p002",
          "quote": "趙王倫執政，以琨爲記室督，轉從事中郎。倫子荂，即琨姊婿也，故琨父子兄弟並爲倫所委任。及篡，荂爲皇太子，琨爲荂詹事。三王之討倫也，以琨爲冠軍、假節，與孫秀子會率宿衞兵三萬距成都王穎，戰于黃橋，琨大敗而還，焚河橋以自固。及齊王冏輔政，以其父兄皆有當世之望，故特宥之，拜兄輿爲中書郎，琨爲尚書左丞，轉司徒左長史。冏敗，范陽王虓鎮許昌，引爲司馬。",
          "subject_person_mention_id": "c-jinshu-062-liukun:p002:m0077",
          "object_person_mention_id": "c-jinshu-062-liukun:p002:m0074"
        }
      ],
      "status": "source_attested",
      "interpretation_note": "同率宿衞兵，明列孫秀之子。",
      "reviewer": "Codex（AI代理）",
      "model": null,
      "human_reviewed": false
    }
