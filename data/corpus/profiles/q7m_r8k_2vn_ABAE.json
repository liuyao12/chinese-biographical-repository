      "status": "source_attested",
      "qualifiers": {
        "source_term": "子寬",
        "lineage": "paternal"
      },
      "evidence": [
        {
          "work_id": "w-chenshu",
          "book_id": "b-chenshu-021",
          "chapter_id": "c-chenshu-021-chen21",
          "source_id": "s-chenshu-021-chen21-ws1511909",
          "paragraph_id": "c-chenshu-021-chen21:p005",
          "quote": "固清虛寡慾，居喪以孝聞。又崇信佛法，及丁所生母憂，遂終身蔬食，夜則坐禪，晝誦佛經，兼習成實論義，而於玄言非所長。嘗聘於西魏，因宴饗之際，請停殺一羊，羊於固前跪拜。又宴於昆明池，魏人以南人嗜魚，大設罟網，固以佛法呪之，遂一鱗不獲。",
          "object_person_mention_id": "c-chenshu-021-chen21:p005:m0000"
        },
        {
          "work_id": "w-chenshu",
          "book_id": "b-chenshu-021",
          "chapter_id": "c-chenshu-021-chen21",
          "source_id": "s-chenshu-021-chen21-ws1511909",
          "paragraph_id": "c-chenshu-021-chen21:p006",
          "quote": "子寬，官至司徒左長史、侍中。",
          "subject_person_mention_id": "c-chenshu-021-chen21:p006:m0001"
        }
      ],
      "interpretation_note": "相鄰段傳主承接，父固。",
      "reviewer": "Codex（AI代理）",
      "human_reviewed": false,
      "model": null,
