  "source_reading_cases": [
    {
      "id": "c-jinshu-057-wu-yan:source_review1-0",
      "kind": "source_review",
      "person_id": "zv2_5nr_ili",
      "source_quote": "吾彥，字士則，吳郡吳人也。出自寒微，有文武才幹。身長八尺，手格猛獸，旅力絕群。仕吳為通江吏。時將軍薛珝杖節南征，軍容甚盛，彥觀之，慨然而歎。有善相者劉劄謂之曰：「以君之相，後當至此，不足慕也。」初為小將，給吳大司馬陸抗。抗奇其勇略，將拔用之，患眾情不允，乃會諸將，密使人陽狂拔刀跳躍而來，坐上諸將皆懼而走，唯彥不動，舉幾禦之，眾服其勇，乃擢用焉。",
      "reading": "吾彥字士則，起於寒微。劉劄相之，陸抗擢用。",
      "note": "吾彥字士則，起於寒微。劉劄相之，陸抗擢用。",
      "paragraph_id": "c-jinshu-057-wu-yan:p001",
      "start_codepoint": 0,
      "end_codepoint": 173,
      "human_reviewed": false,
      "chapter_id": "c-jinshu-057-wu-yan",
      "source_id": "s-jinshu-057-wu-yan-ws2413329"
    },
    {
      "id": "c-jinshu-057-wu-yan:source_review2-0",
      "kind": "source_review",
      "person_id": "zv2_5nr_ili",
      "source_quote": "稍遷建平太守。時王濬將伐吳，造船於蜀，彥覺之，請增兵為備，皓不從，彥乃輒為鐵鎖，橫斷江路。及師臨境，緣江諸城皆望風降附，或見攻而拔，唯彥堅守，大眾攻之不能克，乃退舍禮之。",
      "reading": "吾彥守建平，察王濬造船、請益兵，迎拒而城不陷。",
      "note": "吾彥守建平，察王濬造船、請益兵，迎拒而城不陷。",
      "paragraph_id": "c-jinshu-057-wu-yan:p002",
      "start_codepoint": 0,
      "end_codepoint": 85,
      "human_reviewed": false,
      "chapter_id": "c-jinshu-057-wu-yan",
      "source_id": "s-jinshu-057-wu-yan-ws2413329"
    },
    {
      "id": "c-jinshu-057-wu-yan:source_review3-0",
      "kind": "source_review",
      "person_id": "zv2_5nr_ili",
      "source_quote": "吳亡，彥始歸降，武帝以為金城太守。帝嘗從容問薛瑩曰：「孫皓所以亡國者何也？」瑩對曰：「歸命侯臣皓之君吳，昵近小人，刑罰妄加，大臣大將無所親信，人人憂恐，各不自安，敗亡之釁，由此而作矣。」其後帝又問彥，對曰：「吳主英俊，宰輔賢明。」帝笑曰：「君明臣賢，何為亡國？」彥曰：「天祿永終，歷數有屬，所以為陛下擒。此蓋天時，豈人事也！」張華時在坐，謂彥曰：「君為吳將，積有歲年，蔑爾無聞，竊所惑矣。」彥厲聲曰：「陛下知我，而卿不聞乎？」帝甚嘉之。」",
      "reading": "武帝問薛瑩和吾彥吳亡緣由，答辭分錄，並記張華問答。",
      "note": "武帝問薛瑩和吾彥吳亡緣由，答辭分錄，並記張華問答。",
      "paragraph_id": "c-jinshu-057-wu-yan:p003",
      "start_codepoint": 0,
      "end_codepoint": 219,
      "human_reviewed": false,
      "chapter_id": "c-jinshu-057-wu-yan",
      "source_id": "s-jinshu-057-wu-yan-ws2413329"
    },
    {
      "id": "c-jinshu-057-wu-yan:source_review4-0",
      "kind": "source_review",
      "person_id": "zv2_5nr_ili",
      "source_quote": "轉在敦煌，威恩甚著。遷雁門太守。時順陽王暢驕縱，前後內史皆誣之以罪。乃彥為順陽內史，彥清身率下，威刑嚴肅，眾皆畏懼。暢不能誣，乃更薦之，冀其去職。遷員外散騎常侍。帝嘗問彥：「陸喜、陸抗二人誰多也？」彥對曰：「道德名望，抗不及喜；立功立事，喜不及抗。」",
      "reading": "吾彥為順陽內史，順陽王暢不得誣而薦之；論陸喜、陸抗各長。",
      "note": "吾彥為順陽內史，順陽王暢不得誣而薦之；論陸喜、陸抗各長。",
      "paragraph_id": "c-jinshu-057-wu-yan:p004",
      "start_codepoint": 0,
      "end_codepoint": 125,
      "human_reviewed": false,
      "chapter_id": "c-jinshu-057-wu-yan",
      "source_id": "s-jinshu-057-wu-yan-ws2413329"
    },
    {
      "id": "c-jinshu-057-wu-yan:source_review5-0",
      "kind": "source_review",
      "person_id": "zv2_5nr_ili",
      "source_quote": "會交州刺史陶璜卒，以彥為南中都督、交州刺史。重餉陸機兄弟，機將受之，雲曰：「彥本微賤，為先公所拔，而答詔不善，安可愛之！」機乃止。因此每毀之。長沙孝廉尹虞謂機等曰：「自古由賤而興者，乃有帝王，何但公卿。若何元幹、侯孝明、唐儒宗、張義允等，並起自寒役，皆內侍外鎮，人無譏者。卿以士則答詔小有不善，毀之無已，吾恐南人皆將去卿，卿便獨坐也。」於是機等意始解，毀言漸息矣。",
      "reading": "吾彥代陶璜為交州刺史。陸機、陸雲毀言，由尹虞勸釋。",
      "note": "吾彥代陶璜為交州刺史。陸機、陸雲毀言，由尹虞勸釋。",
      "paragraph_id": "c-jinshu-057-wu-yan:p005",
      "start_codepoint": 0,
      "end_codepoint": 182,
      "human_reviewed": false,
      "chapter_id": "c-jinshu-057-wu-yan",
      "source_id": "s-jinshu-057-wu-yan-ws2413329"
    },
    {
      "id": "c-jinshu-057-wu-yan:source_review6-0",
      "kind": "source_review",
      "person_id": "zv2_5nr_ili",
      "source_quote": "初，陶璜之死也，九真戍兵作亂，逐其太守，九真賊帥趙祉圍郡城，彥悉討平之。在鎮二十餘年，威恩宣著，南州寧靖。自表求代，徵為大長秋。卒於官。",
      "reading": "九真趙祉起事被吾彥平定。吾彥在交州二十餘年，徵大長秋，卒官。",
      "note": "九真趙祉起事被吾彥平定。吾彥在交州二十餘年，徵大長秋，卒官。",
      "paragraph_id": "c-jinshu-057-wu-yan:p006",
