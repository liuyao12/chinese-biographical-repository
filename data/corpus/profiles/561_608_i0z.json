          "start": 16,
          "end": 19,
          "surface": "上將軍",
          "person_mention_id": "c-shiji-009-lvhou:m020-0013",
          "usage": "narrative",
          "date_expression": "七月中"
        }
      ],
      "effective_period": {
        "start": {
          "status": "source_event",
          "event_type": "grant",
          "date_expression": "七月中",
          "evidence": [
            {
