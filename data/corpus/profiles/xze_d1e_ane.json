  "person_references": [
    {
      "id": "c-nanshi-059-wangsengru:p005:r0104",
      "surface": "妾",
      "start": 104,
      "end": 105,
      "person_id": "xze_d1e_ane",
      "referent_role": "third_person",
      "paragraph_id": "c-nanshi-059-wangsengru:p005",
      "quote": "時武帝制春景明志詩五百字，敕沈約以下辭人同作，帝以僧孺為工。曆少府卿，尚書吏部郎，參大選，請謁不行。出為仁威南康王長史、蘭陵太守，行府、州、國事。初，帝問僧孺妾媵之數，對曰：「臣室無傾視。」及在南徐州，友人以妾寓之，行還，妾遂懷孕。為王典簽湯道湣所糾，逮詣南司，坐免官，久之不調。友人廬江何炯猶為王府記室，僧孺乃與炯書以見其意。後為安成王參軍事，鎮右中記室參軍。",
      "note": "從本段發言者、受話人或所記府主覆核。",
      "chapter_id": "c-nanshi-059-wangsengru",
      "book_id": "b-nanshi-059",
      "work_id": "w-nanshi",
      "source_id": "s-nanshi-059-wangsengru-ws1553912"
    },
