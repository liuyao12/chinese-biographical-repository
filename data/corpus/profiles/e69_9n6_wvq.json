  "occurrences": [
    {
      "number": 62,
      "category": "liezhuan",
      "title": "管晏列傳第二",
      "paragraph_id": "c-shiji-062-guanyan:p005",
      "count": 1,
      "quote": "貢於周室。桓公實北征山戎，而管仲因而令燕修召公之政。於柯之會，桓公欲背曹沫之約，管仲因而信之，諸侯由是歸齊。故曰：「知與之為取，政之寶也。」"
    },
