  "person_references": [
    {
      "id": "c-liangshu-016-zhangji:p001:r0114",
      "paragraph_id": "c-liangshu-016-zhangji:p001",
      "start": 114,
      "end": 115,
      "surface": "母",
      "person_id": "tt9_0bz_xoo",
      "referent_role": "third_person",
      "quote": "張稷字公喬，吳郡人也。父永，宋右光祿大夫。稷所生母遘疾歷時，稷始年十一，夜不解衣而養，永異之。及母亡，毀瘠過人，杖而後起。性疏率，朗悟有才略，與族兄充、融、卷等俱知名，時稱之曰：「充融卷稷，是爲四張。」起家著作佐郎，不拜，頻居父母憂，六載廬于墓側。服除，爲驃騎法曹行參軍，遷外兵參軍。",
      "note": "依本段敘事、稱謂及語者受者定。",
      "chapter_id": "c-liangshu-016-zhangji",
      "book_id": "b-liangshu-016",
      "work_id": "w-liangshu",
      "source_id": "s-liangshu-016-zhangji-ws1508503"
    },
    {
      "id": "c-nanshi-031-zhangji-mothers:p002:r0003",
      "paragraph_id": "c-nanshi-031-zhangji-mothers:p002",
      "start": 3,
      "end": 6,
      "surface": "嫡母丘",
      "person_id": "tt9_0bz_xoo",
      "referent_role": "third_person",
      "quote": "父永及嫡母丘相繼殂，六年廬於墓側。",
      "note": "依本段敘事、稱謂及語者受者定。",
