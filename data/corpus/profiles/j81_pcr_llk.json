      },
      "mention_id": "c-jinshu-059-liang-son-zong:p002:m0101",
      "occurrence_groups": [
        {
          "canonical_mention_id": "c-jinshu-059-liang-son-zong:p002:m0101",
          "mention_ids": [
            "c-jinshu-059-liang-son-zong:p002:m0101"
          ],
          "kind": "paragraph"
        }
      ],
      "work_id": "w-jinshu",
      "book_id": "b-jinshu-059",
      "chapter_id": "c-jinshu-059-liang-son-zong",
