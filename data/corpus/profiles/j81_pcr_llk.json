    {
      "number": 44,
      "category": "",
      "title": "晉書卷四十四·華恆傳",
      "paragraph_id": "c-jinshu-044-huaheng:line099",
      "count": 1,
      "raw_count": 1,
      "duplicate_count": 0,
      "counting_policy": "independent_fixed_witness_occurrences",
      "quote": "輕薄無行，為恆所黜。及讓在峻軍中，任勢多所殺害，見恆輒恭敬，不肆其虐。鐘雅、劉超之死，亦將及恆，讓盡心救衛，故得免。",
      "paragraph_ids": [
        "c-jinshu-044-huaheng:line099"
      ],
      "mention_ids": [
        "c-jinshu-044-huaheng:line099:m0048"
      ],
      "mention_paragraph_ids": {
        "c-jinshu-044-huaheng:line099:m0048": "c-jinshu-044-huaheng:line099"
      },
      "mention_id": "c-jinshu-044-huaheng:line099:m0048",
      "occurrence_groups": [
        {
          "canonical_mention_id": "c-jinshu-044-huaheng:line099:m0048",
          "mention_ids": [
            "c-jinshu-044-huaheng:line099:m0048"
          ],
          "kind": "paragraph"
        }
      ],
      "work_id": "w-jinshu",
      "book_id": "b-jinshu-044",
      "chapter_id": "c-jinshu-044-huaheng",
      "source_id": "s-jinshu-044-huaheng",
      "work_title": "晉書"
    },
    {
      "number": 59,
      "category": "",
      "title": "晉書卷五十九·司馬宗",
      "paragraph_id": "c-jinshu-059-liang-son-zong:p002",
      "count": 1,
      "raw_count": 1,
      "duplicate_count": 0,
      "counting_policy": "independent_fixed_witness_occurrences",
      "quote": "，帝始悟。轉為驃騎將軍。胤為大宗正。宗遂怨望形於辭色。咸和初，御史中丞鐘雅劾宗謀反，庾亮使右衛將軍趙胤收之。宗以兵距戰，為胤所殺，貶其族為馬氏，徙妻子于晉安，既而原之。三子：綽、超、演，廢為庶人。咸康中，復其屬籍。綽為奉車都尉、奉朝請。",
      "paragraph_ids": [
        "c-jinshu-059-liang-son-zong:p002"
      ],
      "mention_ids": [
        "c-jinshu-059-liang-son-zong:p002:m0101"
      ],
      "mention_paragraph_ids": {
