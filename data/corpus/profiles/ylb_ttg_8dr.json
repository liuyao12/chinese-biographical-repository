      "source_term": "五羖大夫，荊之鄙人也",
      "evidence": [
        {
          "chapter_id": "c-shiji-068-shang",
          "source_id": "s-shiji-068-shang",
          "paragraph_id": "c-shiji-068-shang:p009",
