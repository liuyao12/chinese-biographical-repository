  "person_references": [
    {
      "start": 36,
      "end": 37,
      "surface": "母",
      "id": "c-nanshi-021-wangchong:p001:r0036",
      "paragraph_id": "c-nanshi-021-wangchong:p001",
      "person_id": "3wk_sv9_63j",
      "referent_role": "third_person",
      "quote": "沖字長深，弘玄孫也。祖僧衍，位侍中。父茂璋字胤光，仕梁位給事黃門侍郎。沖母，梁武帝妹新安公主，卒于齊世。武帝深鍾愛沖，賜爵東安亭侯。累遷侍中，南郡太守。習于法令，政號平理，雖無赫赫之譽，久而見思。曉音樂，習歌舞，善與人交，貴遊之中，聲名籍甚。",
      "note": "本句按敘述視點回指主。",
      "chapter_id": "c-nanshi-021-wangchong",
      "book_id": "b-nanshi-021",
      "work_id": "w-nanshi",
