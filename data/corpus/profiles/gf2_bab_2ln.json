  "occurrences": [
    {
      "number": 5,
      "category": "benji",
      "title": "秦本紀第五",
      "paragraph_id": "c-shiji-005-qin:p046",
      "count": 1,
      "quote": "悼公二年，齊臣田乞弒其君孺子，立其兄陽生，是為悼公。六年，吳敗齊師。齊人弒悼公，立其子簡公。九年，晉定公與吳王夫差盟，爭長於黃池，卒先吳。吳彊，陵中國。十二年，齊田常弒簡公，立其弟平公，常相之。十三年，楚滅陳。秦悼公立"
    },
    {
      "number": 32,
      "category": "shijia",
      "title": "齊太公世家第二",
      "paragraph_id": "c-shiji-032-qi:p072",
      "count": 11,
      "quote": "五十五年，范、中行反其君於晉，晉攻之急，來請粟。田乞欲為亂，樹黨於逆臣，說景公曰：「范、中行數有德於齊，不可不救。」及使乞救而輸之粟。"
    },
    {
      "number": 33,
      "category": "shijia",
      "title": "魯周公世家第三",
      "paragraph_id": "c-shiji-033-lu:p082",
      "count": 1,
      "quote": "哀公五年，齊景公卒。六年，齊田乞弒其君孺子。"
    },
    {
      "number": 37,
      "category": "shijia",
      "title": "衛康叔世家第七",
      "paragraph_id": "c-shiji-037-wei:p032",
      "count": 1,
      "quote": "出公輒四年，齊田乞弒其君孺子。八年，齊鮑子弒其君悼公。"
    }
  ],
  "table_occurrences": [
