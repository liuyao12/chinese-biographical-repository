  "occurrences": [
    {
      "number": 96,
      "category": "liezhuan",
      "title": "張丞相列傳第三十六",
      "paragraph_id": "c-shiji-096-zhang:p025",
      "count": 4,
      "quote": "邴丞相卒，黃丞相代。長安中有善相工田文者，與韋丞相、魏丞相、邴丞相微賤時會於客家，田文言曰：「今此三君者，皆丞相也。」其後三人竟更相代為丞相，何見之明也。",
      "work_id": "w-shiji",
      "book_id": "b-shiji-096",
      "chapter_id": "c-shiji-096-zhang",
      "source_id": "s-shiji-096-zhang",
