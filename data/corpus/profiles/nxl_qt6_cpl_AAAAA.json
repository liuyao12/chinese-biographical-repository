      "evidence": [
        {
          "chapter_id": "c-shiji-044-wei",
          "source_id": "s-shiji-044-wei",
          "paragraph_id": "c-shiji-044-wei:p006",
          "quote": "魏絳事晉悼公。悼公三年，會諸侯。悼公弟楊干亂行，魏絳僇辱楊干。悼公怒曰：『合諸侯以爲榮，今辱吾弟！』將誅魏絳。或説悼公，悼公止。卒任魏絳政，使和戎、翟，戎、翟親附。悼公之十一年，曰：『自吾用魏絳，八年之中，九合諸侯，戎、翟和，子之力也。』賜之樂，三讓，然後受之。徙治安邑。魏絳卒，諡爲昭子。生魏嬴。嬴生魏獻子。"
        }
      ],
      "qualifiers": {
        "source_term": "嬴生魏獻子",
        "historicity": "historical_tradition"
      },
      "interpretation_note": "明示生、孫與弟按來源保存；祖孫不改父子，苗裔不補闕代，未依先後繼位推親屬。",
      "reviewer": "Codex（AI 代理）"
    },
    {
      "id": "a-shiji044-007",
      "subject_person_id": "nxl_qt6_cpl_AAAAAA",
      "predicate": "father",
      "object_person_id": "nxl_qt6_cpl_AAAAA",
      "status": "source_attested",
      "evidence": [
        {
          "chapter_id": "c-shiji-044-wei",
          "source_id": "s-shiji-044-wei",
          "paragraph_id": "c-shiji-044-wei:p009",
          "quote": "其後十四歳而孔子相魯。後四歳，趙簡子以晉陽之亂也，而與韓、魏共攻范、中行氏。魏獻子生魏侈。魏侈與趙鞅共攻范、中行氏。"
        }
      ],
      "qualifiers": {
        "source_term": "魏獻子生魏侈",
        "historicity": "historical_tradition"
      },
      "interpretation_note": "明示生、孫與弟按來源保存；祖孫不改父子，苗裔不補闕代，未依先後繼位推親屬。",
