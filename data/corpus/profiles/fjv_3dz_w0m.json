    {
      "chapter_id": "c-nanqishu-032-ruantao",
      "work_id": "w-nanqishu",
      "book_id": "b-nanqishu-032",
      "source_id": "s-nanqishu-032-ruantao",
      "source": {
        "title": "《南齊書》卷32（阮韜傳）",
        "provider": "Wikisource",
        "url": "https://zh.wikisource.org/w/index.php?title=%E5%8D%97%E9%BD%8A%E6%9B%B8%2F%E5%8D%B732&oldid=1513918",
        "permalink": "https://zh.wikisource.org/w/index.php?title=%E5%8D%97%E9%BD%8A%E6%9B%B8%2F%E5%8D%B732&oldid=1513918",
        "revision_id": 1513918,
        "accessed_on": "2026-10-19",
        "extent": "阮韜傳完整兩原段；與同卷王延之傳分開，並非全卷完成。",
        "text_scope": "complete_biography_unit",
        "review_status": "text_checked",
        "image_verified": false,
        "rights": "古代原文及維基文庫數位轉錄；保留見證歸屬。",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "edition": "維基文庫數位轉錄，未親核底本影像",
        "wikitext_sha256": "cc9c36ced8f64c3c359c76836ae56968c8a13c4a3b3c19a416575737314b0061",
        "normalization": {
          "character_conversion": {},
          "extraction_note": "只去排版空白、展開原字形外殼及單參數年號模板及保留顯示字的維基連結外殼；數位ref另列，不改原字或標點，不以節題補姓名。",
          "excerpts": [
            {
              "proposed_paragraph_id": "c-nanqishu-032-ruantao:line092",
              "source_lines": [
                92,
                92
              ],
              "raw_quote": "　　阮韜字長明，陳留人，晉金紫光祿大夫裕玄孫也。韜少歷清官，爲南兖州別駕，刺史江夏王劉義恭逆求資費錢，韜曰：「此朝廷物。」執不與。",
              "raw_quote_sha256": "adb1fc0bc00f251d601003d4d3f553e95163bc24cf63e925449ea39243f1f3ec",
              "selected_text_sha256": "61c91b43ee82932ccc015222861da398e638707a0d7dc563ccc5cdcd0fc4c2db",
              "begin_anchor": "阮韜字長明，陳留人，晉金紫光祿大夫裕",
              "end_anchor": "資費錢，韜曰：「此朝廷物。」執不與。"
            },
            {
              "proposed_paragraph_id": "c-nanqishu-032-ruantao:line094",
              "source_lines": [
                94,
                94
              ],
              "raw_quote": "　　宋孝武選侍中四人，竝以風貌。王彧、謝莊爲一雙，韜與何偃爲一雙。常充兼假。泰始末，爲征南江州長史。桂陽王休範在鎮，數出行遊，韜性方峙，未嘗隨從。至散騎常侍，金紫光祿大夫，領始興王師。{{YL|永明二年}}，卒。",
              "raw_quote_sha256": "ab64ae4d39f2f4061eb5ca12a919c03d5bab29c8cacb2a7d192fe1ad51cadd92",
              "selected_text_sha256": "f40955d4b0013c2bf83323217dd29596873bd05d55ab80e95c3f5f4dfe368e96",
              "begin_anchor": "宋孝武選侍中四人，竝以風貌。王彧、謝",
              "end_anchor": "光祿大夫，領始興王師。永明二年，卒。"
            }
          ]
        },
        "response_sha256": "f428c7546fdd70a9eece664401433407aad6e45bcbe711a6d58ef8806c1b4ca0"
      }
    },
