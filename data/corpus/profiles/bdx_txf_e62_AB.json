      "kind": "received_sentence",
      "person_id": "bdx_txf_e62_AB",
      "source_quote": "時張超首行大逆，亦領軍隸柬。",
      "reading": "張超即二凶傳張超之，部屬張柬。",
      "note": "張超即二凶傳張超之，部屬張柬。",
      "paragraph_id": "c-songshu-050-yuan-xunzhi:p001",
      "start_codepoint": 26,
