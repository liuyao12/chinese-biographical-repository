      "kind": "source_review",
      "person_id": "kjg_7m2_c09",
      "source_quote": "吳既平，普減州郡兵，璜上言曰：",
      "reading": "天下既平，朝廷普減州郡兵，引陶璜陳議。",
      "note": "天下既平，朝廷普減州郡兵，引陶璜陳議。",
      "paragraph_id": "c-jinshu-057-tao-huang:p006",
      "start_codepoint": 0,
      "end_codepoint": 15,
      "human_reviewed": false,
      "chapter_id": "c-jinshu-057-tao-huang",
