    {
      "number": 43,
      "category": "",
      "title": "王澄傳",
      "paragraph_id": "c-jinshu-043-wangcheng:line118",
      "count": 1,
      "raw_count": 1,
      "duplicate_count": 0,
      "counting_policy": "independent_fixed_witness_occurrences",
      "quote": "時王敦、謝鯤、庾敳、阮修皆為衍所親善，號為四友，而亦與澄狎，又有光逸、胡毋輔之等亦豫焉。酣宴縱誕，窮歡極娛。",
