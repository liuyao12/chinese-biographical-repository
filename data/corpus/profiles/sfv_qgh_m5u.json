      "date_expression": null,
      "evidence": [
        {
          "work_id": "w-jinshu",
          "book_id": "b-jinshu-061",
          "chapter_id": "c-jinshu-061-liuqiao",
          "source_id": "s-jinshu-061-liuqiao-ws7903772",
          "paragraph_id": "c-jinshu-061-liuqiao:p006",
          "quote": "時河間王顒方距關東，倚喬為助，不納其言。東海王越移檄天下，帥甲士三萬，將入關迎大駕，軍次於蕭，喬懼，遣子祐距越于蕭縣之靈壁。劉琨分兵向許昌，許昌人納之。琨自滎陽率兵迎越，遇祐，眾潰見殺。喬眾遂散，與五百騎奔平氏。帝還洛陽，大赦，越復表喬為太傅軍諮祭酒。越薨，復以喬為都督豫州諸軍事、鎮東將軍、豫州刺史。卒于官，時年六十三。湣帝末，追贈司空。子挺，潁川太守。挺子耽。",
          "person_mention_id": "c-jinshu-061-liuqiao:p006:m0052"
        }
      ],
      "status": "source_attested",
      "interpretation_note": "按同段人物與次第核所屬卒事。",
