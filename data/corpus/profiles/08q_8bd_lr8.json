  "occurrences": [
    {
      "number": 121,
      "category": "liezhuan",
      "title": "儒林列傳第六十一",
      "paragraph_id": "c-shiji-121-rulin:p005",
      "count": 3,
      "quote": "太傅。言尚書自濟南伏生。言禮自魯高堂生。言易自菑川田生。言春秋於齊魯自胡毋生，於趙自董仲舒。及竇太后崩，武安侯田蚡為丞相，絀黃老、刑名百家之言，延文學儒者數百人，而公孫弘以春秋白衣為天子三公，封以平津侯。天下之學士靡然鄉風矣。"
    }
  ],
