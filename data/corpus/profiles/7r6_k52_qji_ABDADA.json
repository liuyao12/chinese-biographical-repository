  "person_references": [
    {
      "id": "c-nanshi-024-wangshaozhi-wyd:p002:r0066",
      "surface": "父",
      "start": 66,
      "end": 67,
      "person_id": "7r6_k52_qji_ABDADA",
      "referent_role": "third_person",
      "paragraph_id": "c-nanshi-024-wangshaozhi-wyd:p002",
      "quote": "韶之家貧好學嘗三日絶糧而執卷不輟家人誚之曰困窮如此何不耕答曰我常自耕耳父偉之為烏程令韶之因居縣境好史籍博涉多聞初為衞將軍謝琰行參軍得父舊書因私撰晉安帝陽秋及成時人謂宜居史職即除著作佐郎使續後事訖義熙九年善敘事辭論可觀遷尚書祠部郎",
      "note": "殿本同段所記發言者、受話人或親稱。",
      "chapter_id": "c-nanshi-024-wangshaozhi-wyd",
      "book_id": "b-nanshi-024",
      "work_id": "w-nanshi",
      "source_id": "s-nanshi-024-wangshaozhi-wyd1739"
    },
    {
      "id": "c-nanshi-024-wangshaozhi:p002:r0082",
      "surface": "父",
      "start": 82,
      "end": 83,
      "person_id": "7r6_k52_qji_ABDADA",
      "referent_role": "third_person",
      "paragraph_id": "c-nanshi-024-wangshaozhi:p002",
      "quote": "韶之家貧好學，嘗三日絶糧而執卷不輟，家人誚之曰：「困窮如此，何不耕？」答曰：「我常自耕耳。」父偉之爲烏程令，韶之因居縣境。好史籍，博涉多聞。初爲衞將軍謝琰行參軍，得父舊書，因私撰晉安帝陽秋。及成，時人謂宜居史職，即除著作佐郎，使續後事，訖義熙九年。善敘事，辭論可觀。遷尚書祠部郎。",
      "note": "承前具名的父偉之。",
      "chapter_id": "c-nanshi-024-wangshaozhi",
      "book_id": "b-nanshi-024",
      "work_id": "w-nanshi",
      "source_id": "s-nanshi-024-wangshaozhi-ws1765279"
    },
    {
      "start": 5,
      "end": 6,
      "surface": "父",
      "id": "c-songshu-060-wangshaozhi:p002:r0005",
      "paragraph_id": "c-songshu-060-wangshaozhi:p002",
      "person_id": "7r6_k52_qji_ABDADA",
      "referent_role": "third_person",
      "quote": "韶之家貧，父為烏程令，因居縣境。好史籍，博涉多聞。初為衞將軍謝琰行參軍。偉之少有志尚，當世詔命表奏，輒自書寫，太元、隆安時事，小大悉撰錄之，韶之因此私撰晉安帝陽秋。既成，時人謂宜居史職，即除著作佐郎，使續後事，訖義熙九年。善敍事，辭論可觀，為後代佳史。遷尚書祠部郎。晉帝自孝武以來，常居內殿，武官主書於中通呈，以省官一人管司詔誥，任在西省，因謂之西省郎。傅亮、羊徽相代〔在職，義熙十一年，高祖以韶之博學有文詞，補通直郎，〕領西省事。轉中書侍郎。安帝之崩也，高祖使韶之與帝左右密加酖毒。恭帝即位，遷黃門侍郎，領著作郎，西省如故。凡諸詔黃，皆其辭也。",
      "note": "本句按敘述視點回指偉。",
      "chapter_id": "c-songshu-060-wangshaozhi",
      "book_id": "b-songshu-060",
      "work_id": "w-songshu",
      "source_id": "s-songshu-060-wangshaozhi-ws1996694"
    }
  ],
