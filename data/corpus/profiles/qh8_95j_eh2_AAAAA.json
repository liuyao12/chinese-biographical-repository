      "status": "source_attested",
      "date_expression": "十二年",
      "evidence": [
        {
          "chapter_id": "c-shiji-035-guancai",
          "source_id": "s-shiji-035-guancai",
          "paragraph_id": "c-shiji-035-guancai:p015",
          "quote": "靈侯二年，楚公子圍弒其王郟敖而自立，為靈王。九年，陳司徒招弒其君哀公。楚使公子棄疾滅陳而有之。十二年，楚靈王以靈侯弒其父，誘蔡靈侯于申，伏甲飲之，醉而殺之，刑其士卒七十人。令公子棄疾圍蔡。十一月，滅蔡，使棄疾為蔡公。",
          "person_mention_id": "c-shiji-035-guancai:m015-0062"
        }
      ],
      "source_term": "醉而殺之",
      "interpretation_note": "本篇明示死亡；保存原國君年次，未知公曆日不補。",
      "reviewer": "Codex（AI 代理）",
