  "occurrences": [
    {
      "number": 47,
      "category": "",
      "title": "孟懷玉",
      "paragraph_id": "c-songshu-047-menghuaiyu:p003",
      "count": 2,
      "raw_count": 2,
      "duplicate_count": 0,
      "counting_policy": "independent_fixed_witness_occurrences",
      "quote": "盧循逼京邑，懷玉於石頭岸連戰有功，為中軍諮議參軍。賊帥徐道覆屢欲以精銳登岸，畏懷玉不敢上。及循南走，懷玉與眾軍追躡，直至嶺表。徐道覆屯結始興，懷玉攻圍之，身當矢石，旬月乃陷。仍南追循，循平，又封陽豐縣男，食邑二百五十戶。復為太尉諮議參軍，征虜將軍。八年，遷江州",
      "paragraph_ids": [
        "c-songshu-047-menghuaiyu:p003"
      ],
      "mention_ids": [
        "c-songshu-047-menghuaiyu:p003:m0027",
