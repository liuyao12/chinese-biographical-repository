  "person_references": [
    {
      "id": "c-nanshi-059-wangsengru:p002:r0058",
      "surface": "其父",
      "start": 58,
      "end": 60,
      "person_id": "59d_72d_924_AA",
      "referent_role": "third_person",
      "paragraph_id": "c-nanshi-059-wangsengru:p002",
      "quote": "僧孺幼聰慧，年五歲便機警，初讀孝經，問授者曰：「此書何所述？」曰：「論忠孝二事。」僧孺曰：「若爾，願常讀之。」又有饋其父冬李，先以一與之，僧孺不受，曰：「大人未見，不容先嘗。」七歲能讀十萬言，及長篤愛墳籍。家貧，常傭書以養母，寫畢諷誦亦了。",
      "note": "從本段發言者、受話人或所記府主覆核。",
      "chapter_id": "c-nanshi-059-wangsengru",
      "book_id": "b-nanshi-059",
      "work_id": "w-nanshi",
      "source_id": "s-nanshi-059-wangsengru-ws1553912"
    },
