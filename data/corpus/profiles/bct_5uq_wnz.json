      "evidence": [
        {
          "work_id": "w-jinshu",
          "book_id": "b-jinshu-063",
          "chapter_id": "c-jinshu-063-shaoxu",
          "source_id": "s-jinshu-063-shaoxu-ws2025242",
          "paragraph_id": "c-jinshu-063-shaoxu:p007",
          "quote": "續被獲之後，存及竺、緝等與匹磾嬰城距寇，而帝又假存揚武將軍、武邑太守。勒屢遣季龍攻之，戰守疲苦，不能自立。久之，匹磾及其弟文鴦與竺、緝等悉見獲，惟存得潰圍南奔，在道為賊所殺。續竟亦遇害。",
          "person_mention_id": "c-jinshu-063-shaoxu:p007:m0006"
        }
      ],
