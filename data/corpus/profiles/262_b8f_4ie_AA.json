    {
      "id": "c-nanshi-011-peihuizhao:p003:r0054",
      "person_id": "262_b8f_4ie_AA",
      "paragraph_id": "c-nanshi-011-peihuizhao:p003",
      "start": 54,
      "end": 56,
      "surface": "儲妃",
      "quote": "時議欲立石志，王儉曰：「石志不出禮典，起宋元嘉中顏延之為王球石志。素族無銘策，故以紀行。自爾以來，共相祖習。儲妃之重，禮絕恒例，既有哀策，不煩石志。」從之。武帝即位，追尊皇后。贈父璣之金紫光祿大夫，后母檀氏余杭廣昌鄉元君。",
      "referent_role": "third_person",
      "note": "依該段前後稱謂。",
      "chapter_id": "c-nanshi-011-peihuizhao",
