    {
      "number": 46,
      "category": "",
      "title": "張邵及敷、柬附傳（卷046選錄）",
      "paragraph_id": "c-songshu-046-zhangshao:p002",
      "count": 1,
      "raw_count": 1,
      "duplicate_count": 0,
      "counting_policy": "independent_fixed_witness_occurrences",
      "quote": "子敷演鏡有名於世敷字景𦙍生而母亡年數嵗問知之雖童䝉便有感慕之色至十嵗許求母遺物而散施已盡唯得一扇乃緘録之每至感思輒開笥流涕見從母悲感嗚咽性整貴風韻端雅好𤣥言善屬文初父邵使與南陽宗少文談繫象徃復數番少文每欲屈握",
      "paragraph_ids": [
