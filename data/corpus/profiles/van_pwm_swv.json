      "work_title": "北史"
    },
    {
      "number": 50,
      "category": "",
      "title": "垣護之祖敞、父苗選句",
      "paragraph_id": "c-songshu-050-xuanmo-yuanhuzhi:p001",
      "count": 2,
      "raw_count": 2,
      "duplicate_count": 0,
      "counting_policy": "independent_fixed_witness_occurrences",
      "quote": "垣護之字彥宗，略陽桓道人也。祖敞，仕苻氏，為長樂國郎中令。慕容德入青州，以敞為車騎長史。德兄子超襲偽位，伯父遵、父苗復見委任。",
      "paragraph_ids": [
        "c-songshu-050-xuanmo-yuanhuzhi:p001"
