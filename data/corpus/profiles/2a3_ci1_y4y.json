          "paragraph_id": "c-epitaph-wanglingyuan-excerpts:p001",
          "quote": "祖琛，齊司徒從事中郎。祖母彭城劉氏，父義恭，宋太宰江夏文獻王。父翊，魏侍中司空孝獻公。母河南元氏，父澄，假黃鉞太傅任城文宣王。妃姓王，諱令媛，琅邪臨沂人，齊尚書僕射奐之曾孫也。",
          "subject_person_mention_id": "c-epitaph-wanglingyuan-excerpts:p001:m0068"
        }
      ],
      "context": {
        "kind": "adjacent_paragraphs",
        "paragraph_ids": [
          "c-epitaph-wanglingyuan-excerpts:p000",
          "c-epitaph-wanglingyuan-excerpts:p001"
        ],
        "rationale": "誌題稱廣陽文獻王妃，下接其世系及「妃姓王，諱令媛」。"
      },
      "corroborating_evidence": [
        {
          "work_id": "w-epitaph-wanglingyuan",
          "book_id": "b-epitaph-wanglingyuan-excerpts",
          "chapter_id": "c-epitaph-wanglingyuan-excerpts",
          "source_id": "s-epitaph-wanglingyuan-daitof00792",
          "paragraph_id": "c-epitaph-wanglingyuan-excerpts:p002",
          "quote": "亦既有行，來儀蕃邸，率禮公宮，剋循法度。",
          "role": "marriage_context"
        },
        {
          "work_id": "w-epitaph-wanglingyuan",
          "book_id": "b-epitaph-wanglingyuan-excerpts",
          "chapter_id": "c-epitaph-wanglingyuan-excerpts",
          "source_id": "s-epitaph-wanglingyuan-daitof00792",
          "paragraph_id": "c-epitaph-wanglingyuan-excerpts:p003",
          "quote": "粵以武定二年歲在甲子八月庚申合葬於武城之北原。",
          "role": "joint_burial_attestation"
        },
        {
          "work_id": "w-epitaph-yuanzhan",
          "book_id": "b-epitaph-yuanzhan-excerpts",
          "chapter_id": "c-epitaph-yuanzhan-excerpts",
