  "occurrences": [
    {
      "number": 122,
      "category": "liezhuan",
      "title": "酷吏列傳第六十二",
      "paragraph_id": "c-shiji-122-kuli:p002",
      "count": 18,
      "quote": "晁錯以刻深頗用術輔其資，而七國之亂，發怒於錯，錯卒以被戮。其後有郅都、寧成之屬。"
    }
  ],
