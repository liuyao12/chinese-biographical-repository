      "kind": "variant_review",
      "person_id": "o6u_fls_sgx",
      "source_quote": "尚書右丞",
      "reading": "武英殿本及本文右丞，《南史》作左丞。",
      "note": "武英殿本及本文右丞，《南史》作左丞。",
      "paragraph_id": "c-nanqishu-053-local-officials-complete:p003",
      "start_codepoint": 54,
