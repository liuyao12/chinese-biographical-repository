    {
      "number": 62,
      "category": "",
      "title": "晉書卷六十二·劉琨",
      "paragraph_id": "c-jinshu-062-liukun:p003",
      "count": 2,
      "raw_count": 2,
      "duplicate_count": 0,
      "counting_policy": "independent_fixed_witness_occurrences",
      "quote": "百人，與虓濟河，共破東平王懋於廩丘，南走劉喬，始得其父母。又斬石超，降呂朗，因統諸軍奉迎大駕于長安。以動封廣武侯，邑二千戸。",
      "paragraph_ids": [
