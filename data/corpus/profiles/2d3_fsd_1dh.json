    {
      "number": 36,
      "category": "shijia",
      "title": "陳杞世家第六",
      "paragraph_id": "c-shiji-036-chenqi:p014",
      "count": 1,
      "raw_count": 1,
      "duplicate_count": 0,
      "counting_policy": "independent_fixed_witness_occurrences",
      "quote": "文公敗楚師于城濮。是歲，穆公卒，子共公朔立。共公六年，楚太子商臣弒其父成王代立，是為穆王。十一年，秦穆公卒。十八年，共公卒，子靈公平國立。",
      "paragraph_ids": [
