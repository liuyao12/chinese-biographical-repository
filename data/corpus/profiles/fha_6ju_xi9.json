      "evidence": [
        {
          "work_id": "w-nanqishu",
          "book_id": "b-nanqishu-052",
          "chapter_id": "c-nanqishu-052-early-literature-complete",
          "source_id": "s-nanqishu-052-early-literature-complete-ws2371079",
          "paragraph_id": "c-nanqishu-052-early-literature-complete:p014",
          "quote": "　　除南海王國郎中令，尚書比部郎，安吉令，車騎記室。彬性好飲酒，以瓠壺瓢勺杬皮爲肴，著帛冠十二年不改易，以大瓠爲火籠，什物多諸詭異。自稱「卞田居」，婦爲「傅蠶室」。或諫曰：「卿都不持操，名器何由得升？」彬曰：「擲五木子，十擲輙鞬，豈復是擲子之拙。吾好擲，政極此耳。」永元中，爲平越長史、綏建太守，卒官。",
          "subject_person_mention_id": "c-nanqishu-052-early-literature-complete:p014:m0026",
          "object_person_mention_id": "c-nanqishu-052-early-literature-complete:p014:m0077"
        }
      ],
      "status": "source_attested",
      "interpretation_note": "婦稱依原語，未見本名。",
      "reviewer": "Codex（AI代理）",
      "model": null,
