  "occurrences": [
    {
      "number": 32,
      "category": "shijia",
      "title": "齊太公世家第二",
      "paragraph_id": "c-shiji-032-qi:p076",
      "count": 2,
      "quote": "鮑子與悼公有郤，不善。四年，吳、魯伐齊南方。鮑子弒悼公，赴于吳。吳王夫差哭於軍門外三日，將從海入討齊。齊人敗之，吳師乃去。晉趙鞅伐齊，至賴而去。齊人共立悼公子壬，是為簡公。"
    },
    {
      "number": 37,
      "category": "shijia",
      "title": "衛康叔世家第七",
      "paragraph_id": "c-shiji-037-wei:p032",
      "count": 1,
      "quote": "出公輒四年，齊田乞弒其君孺子。八年，齊鮑子弒其君悼公。"
    }
  ],
