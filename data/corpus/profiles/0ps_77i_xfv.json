    {
      "number": 47,
      "category": "",
      "title": "王融（乾隆武英殿本）",
      "paragraph_id": "c-nanqishu-047-wangrong-wyd:p015",
      "count": 1,
      "raw_count": 1,
      "duplicate_count": 0,
      "counting_policy": "independent_fixed_witness_occurrences",
      "quote": "宋弁曰不容虛僞之名當是不習土地融曰周穆馬迹偏於天下若騏驥之性因地而遷則造父之策有時而躓弁曰王主客何為懃懃於千里融曰卿國既異其優劣聊復相訪若千里日至聖上當駕鼓車弁曰向意既須必不能駕鼓車也融曰買死馬之骨亦郭隗之故弁不能答",
      "paragraph_ids": [
        "c-nanqishu-047-wangrong-wyd:p015"
