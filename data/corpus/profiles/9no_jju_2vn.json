  "person_references": [
    {
      "id": "c-songshu-047-liujingxuan:p001:r0041",
      "paragraph_id": "c-songshu-047-liujingxuan:p001",
      "start": 41,
      "end": 42,
      "surface": "母",
      "person_id": "9no_jju_2vn",
      "referent_role": "third_person",
      "quote": "劉敬宣字萬壽，彭城人，漢楚元王交後也。祖建，征虜將軍。父牢之，鎮北將軍。敬宣八歲喪母，晝夜號泣，中表異之，輔國將軍桓序鎮蕪湖，牢之參序軍事。四月八日，敬宣見眾人灌佛，乃下頭上金鏡以為母灌，因悲泣不自勝。序歎息，謂牢之曰：「卿此兒既為家之孝子，必為國之忠臣。」起家為王恭前軍參軍，又參會稽世子元顯征虜軍事。",
      "note": "依本段敘事、稱謂及語者受者定。",
      "chapter_id": "c-songshu-047-liujingxuan",
      "book_id": "b-songshu-047",
      "work_id": "w-songshu",
      "source_id": "s-songshu-047-liujingxuan-ws2190557"
    },
