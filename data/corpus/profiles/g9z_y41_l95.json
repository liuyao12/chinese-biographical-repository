    }
  ],
  "person_references": [
    {
      "id": "c-nanqishu-027-wangwenhe:p001:r0023",
      "paragraph_id": "c-nanqishu-027-wangwenhe:p001",
      "start": 23,
      "end": 26,
      "surface": "義陽王",
      "person_id": "g9z_y41_l95",
      "referent_role": "third_person",
      "quote": "同族王文和，宋鎮北大將軍仲德兄孫也。景和中，為義陽王昶征北府主簿。昶于彭城奔虜，部曲皆散，文和獨送至界上。昶謂之曰：「諸人皆去，卿有老母，何不去邪！」文和乃去。昇明中，為巴陵內史。沈攸之事起，文和斬其使，馳白世祖告變，棄郡奔郢城。永明中，歷青、冀、兖、益四州刺史，平北將軍。",
      "note": "依敘事與發言者、對語方及所述役事判讀。",
      "chapter_id": "c-nanqishu-027-wangwenhe",
      "book_id": "b-nanqishu-027",
      "work_id": "w-nanqishu",
      "source_id": "s-nanqishu-027-wangwenhe-ws1508012"
    },
    {
      "id": "c-nanshi-025-wangwenhe:p001:r0014",
      "paragraph_id": "c-nanshi-025-wangwenhe:p001",
      "start": 14,
      "end": 17,
      "surface": "義陽王",
      "person_id": "g9z_y41_l95",
      "referent_role": "third_person",
      "quote": "仲德兄孫文和，景和中，為征北義陽王昶府佐。昶于彭城奔魏，部曲皆散，文和獨送至界上。昶謂曰：「諸人皆去，卿有老母，何獨不去？」文和乃去。升明中，為巴陵內史。沈攸之事起，文和斬其使，馳白齊武帝。及齊永明年中，曆青、冀、兗、益四州刺史。",
      "note": "依敘事與發言者、對語方及所述役事判讀。",
      "chapter_id": "c-nanshi-025-wangwenhe",
      "book_id": "b-nanshi-025",
      "work_id": "w-nanshi",
      "source_id": "s-nanshi-025-wangwenhe-ws12757141"
    },
    {
      "start": 108,
      "end": 111,
      "surface": "義陽王",
      "id": "c-songshu-041-wangxianyuan-family:p004:r0108",
      "paragraph_id": "c-songshu-041-wangxianyuan-family:p004",
      "person_id": "g9z_y41_l95",
      "referent_role": "third_person",
      "quote": "后父偃，字子游，晉丞相導玄孫，尚書嘏之子也。母晉孝武帝女鄱陽公主，宋受禪，封永成君。偃尚高祖第二女吳興長公主諱榮男，少歷顯官，黃門侍郎，祕書監，侍中。元嘉末，為散騎常侍、右衞將軍。世祖即位，以后父，授金紫光祿大夫，領義陽王師，常侍如故。遷右光祿大夫，常侍、王師如故。偃謙虛恭謹，不以世事關懷。孝建二年卒，時年五十四。追贈開府儀同三司，本官如故，諡曰恭公。",
      "note": "本句按敘述視點回指義陽。",
      "chapter_id": "c-songshu-041-wangxianyuan-family",
      "book_id": "b-songshu-041",
      "work_id": "w-songshu",
      "source_id": "s-songshu-041-wangxianyuan-family-ws2634831"
    }
