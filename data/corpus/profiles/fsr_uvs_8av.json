  "source_reading_cases": [
    {
      "id": "c-sanguozhi-055-jiangqin:line035:reading-000-194",
      "kind": "received_sentence",
      "paragraph_id": "c-sanguozhi-055-jiangqin:line035",
      "start_codepoint": 0,
      "end_codepoint": 194,
      "source_quote": "蔣欽字公弈，九江壽春人也。孫策之襲袁術，欽隨從給事。及策東渡，拜別部司馬，授兵。與策周旋，平定三郡，又從定豫章。調授葛陽尉，歷三縣長，討平盜賊，遷西部都尉。會稽冶賊呂合、秦狼等爲亂，欽將兵討擊，遂禽合、狼，五縣平定，徙討越中郎將，以涇拘、昭陽爲奉邑。賀齊討黝賊，欽督萬兵，與齊并力，黝賊平定。從征合肥，魏將張遼襲權於津北，欽力戰有功，遷盪寇將軍，領濡須督。後召還都，拜津右護軍，典領辭訟。",
      "person_id": "fsr_uvs_8av",
      "related_person_ids": [
        "e9c_070_567",
        "865_b69_cb0",
        "pbk_bqg_1v2",
        "nxs_1bo_80u",
        "wuz_dky_0ki",
        "9b5_3dc_f80",
        "572_278_cba"
      ],
      "reading": "蔣欽字公弈。呂合與秦狼被禽，賀齊與欽共同平黝賊。",
      "chapter_id": "c-sanguozhi-055-jiangqin",
      "source_id": "s-sanguozhi-055-jiangqin"
    },
    {
      "id": "c-sanguozhi-055-jiangqin:line037:reading-000-050",
      "kind": "received_sentence",
      "paragraph_id": "c-sanguozhi-055-jiangqin:line037",
      "start_codepoint": 0,
      "end_codepoint": 50,
      "source_quote": "權甞入其堂內，母踈帳縹被，妻妾布裙。權歎其在貴守約，即勑御府爲母作錦被，改易帷帳，妻妾衣服悉皆錦繡。",
      "person_id": "fsr_uvs_8av",
      "related_person_ids": [
        "572_278_cba",
        "dls_fcl_8bb"
      ],
      "reading": "孫權入蔣欽堂內見其母、妻妾衣服；母兩見同人，妻妾是複數。",
      "chapter_id": "c-sanguozhi-055-jiangqin",
      "source_id": "s-sanguozhi-055-jiangqin"
    },
    {
      "id": "c-sanguozhi-055-jiangqin:line039:reading-000-085",
      "kind": "received_sentence",
      "paragraph_id": "c-sanguozhi-055-jiangqin:line039",
      "start_codepoint": 0,
      "end_codepoint": 85,
      "source_quote": "初，欽屯宣城，甞討豫章賊。蕪湖令徐盛收欽屯吏，表斬之，權以欽在遠不許，盛由是自嫌於欽。曹公出濡須，欽與呂蒙持諸軍節度。盛常畏欽因事害己，而欽每稱其善。盛旣服德，論者美焉。",
      "person_id": "fsr_uvs_8av",
      "related_person_ids": [
        "1uv_h2z_yrv",
        "572_278_cba",
        "dad_b77_b38",
        "ibt_i7u_ykp"
      ],
      "reading": "受徐盛所劾者為欽屯吏，權不許斬；欽仍舉盛。",
      "chapter_id": "c-sanguozhi-055-jiangqin",
      "source_id": "s-sanguozhi-055-jiangqin"
    },
    {
      "id": "c-sanguozhi-055-jiangqin:line039-pei01-01:reading-000-090",
      "kind": "annotation_sentence",
      "paragraph_id": "c-sanguozhi-055-jiangqin:line039-pei01-01",
      "start_codepoint": 0,
      "end_codepoint": 90,
      "source_quote": "《江表傳》曰：權謂欽曰：「盛前白卿，卿今舉盛，欲慕祁奚邪？」欽對曰：「臣聞公舉不挾私怨，盛忠而勤彊，有膽略器用，好萬人督也。今大事未定，臣當助國求才，豈敢挾私恨以蔽賢乎！」權嘉之。",
      "person_id": "fsr_uvs_8av",
      "related_person_ids": [
        "572_278_cba",
        "1uv_h2z_yrv",
        "535_ed8_4fa"
      ],
      "reading": "江表傳中欽以公舉答問，祁奚為孫權所舉前例。",
      "chapter_id": "c-sanguozhi-055-jiangqin",
      "source_id": "s-sanguozhi-055-jiangqin"
    },
    {
      "id": "c-sanguozhi-055-jiangqin:line041:reading-000-086",
