    {
      "id": "th-w098-dun-main-27",
      "person_id": "4kn_kz5_zrm",
      "title": "護軍將軍",
      "kind": "office",
      "mode": "attestation",
      "evidence": [
        {
          "work_id": "w-jinshu",
          "book_id": "b-jinshu-098",
          "chapter_id": "c-jinshu-098-jin033-wangji",
          "source_id": "s-jinshu-098-jin033-wangji",
          "paragraph_id": "c-jinshu-098-jin033-wangji:line057",
          "quote": "今遣司徒導，鎮南將軍、丹陽尹嶠，建威將軍趙胤武旅三萬，十道並進；平西將軍邃率兗州刺史遐、奮武將軍峻、奮威將軍贍精銳三萬，水陸齊勢；朕親禦六軍，左衛將軍亮，右衛將軍胤，護軍將軍詹，領軍將軍瞻，中軍將軍壺，驍騎將軍艾，驃騎將軍、南頓王宗，鎮軍將軍、汝南王祐，太宰、西陽王羕被練三千，組甲三萬，總統諸軍，討鳳之罪。罪止一人，朕不濫刑。有能殺鳳送首，封五千戶侯，賞布五千匹。",
          "person_mention_id": "c-jinshu-098-jin033-wangji:line057:m0087"
        }
      ],
