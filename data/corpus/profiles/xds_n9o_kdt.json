    {
      "number": 60,
      "category": "",
      "title": "晉書卷六十·李含",
      "paragraph_id": "c-jinshu-060-lihan:p001",
      "count": 1,
      "raw_count": 1,
      "duplicate_count": 0,
      "counting_policy": "independent_fixed_witness_occurrences",
      "quote": "掾轉秦國郎中令。司徒遷含領始平中正。秦王柬薨，含依臺儀，葬訖除喪。尚書趙浚有內寵，疾含不事己，遂奏含不應除喪。本州大中正傅祗以名義貶含。中丞傅咸上表理含曰：",
      "paragraph_ids": [
