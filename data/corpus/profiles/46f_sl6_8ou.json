  "source_reading_cases": [
    {
      "id": "c-nanqishu-054-recluses-complete:source_review67-0",
      "kind": "source_review",
      "person_id": "46f_sl6_8ou",
      "source_quote": "　　沈驎士字雲禎，吳興武康人也。祖膺期，晉太中大夫。",
      "reading": "沈驎士字雲禎。祖膺期任晉太中大夫。",
      "note": "沈驎士字雲禎。祖膺期任晉太中大夫。",
      "paragraph_id": "c-nanqishu-054-recluses-complete:p067",
      "start_codepoint": 0,
      "end_codepoint": 26,
      "human_reviewed": false,
      "chapter_id": "c-nanqishu-054-recluses-complete",
      "source_id": "s-nanqishu-054-recluses-complete-ws1762878"
    },
    {
      "id": "c-nanqishu-054-recluses-complete:source_review68-0",
      "kind": "source_review",
      "person_id": "46f_sl6_8ou",
      "source_quote": "　　驎士少好學，家貧，織簾誦書，口手不息。宋元嘉末，文帝令尚書僕射何尚之抄撰五經，訪舉學士，縣以驎士應選。尚之謂子偃曰：「山東故有奇士也。」少時，驎士稱疾歸郷，更不與人物通。養孤兄子，義著郷曲。",
      "reading": "文帝元嘉末訪學士，何尚之告子偃。驎士養孤兄子不具名。",
      "note": "文帝元嘉末訪學士，何尚之告子偃。驎士養孤兄子不具名。",
      "paragraph_id": "c-nanqishu-054-recluses-complete:p068",
      "start_codepoint": 0,
      "end_codepoint": 97,
      "human_reviewed": false,
      "chapter_id": "c-nanqishu-054-recluses-complete",
      "source_id": "s-nanqishu-054-recluses-complete-ws1762878"
    },
    {
      "id": "c-nanqishu-054-recluses-complete:source_review69-0",
      "kind": "source_review",
      "person_id": "46f_sl6_8ou",
      "source_quote": "　　或勸驎士仕，答曰：「魚縣獸檻，天下一契，聖人玄悟，所以每履吉先。吾誠未能景行坐忘，何爲不希企日損。」乃作《玄散賦》以絕世。太守孔山士辟，不應。宗人徐州刺史曇慶、侍中懷文、左率勃來候之，驎士未嘗答也。隱居餘不吳差山，講經教授，從學者數十百人，各營屋宇，依止其側。驎士重陸機《連珠》，每爲諸生講之。",
      "reading": "孔山士辟與沈氏宗人來候各有行文，原文無三人親等。",
      "note": "孔山士辟與沈氏宗人來候各有行文，原文無三人親等。",
      "paragraph_id": "c-nanqishu-054-recluses-complete:p069",
      "start_codepoint": 0,
      "end_codepoint": 149,
      "human_reviewed": false,
      "chapter_id": "c-nanqishu-054-recluses-complete",
      "source_id": "s-nanqishu-054-recluses-complete-ws1762878"
    },
    {
      "id": "c-nanqishu-054-recluses-complete:source_review70-0",
      "kind": "source_review",
      "person_id": "46f_sl6_8ou",
      "source_quote": "　　征北張永爲吳興，請驎士入郡。驎士聞郡後堂有好山水，乃往停數月。永欲請爲功曹，使人致意。驎士曰：「明府德履沖素，留心山谷，民是以被褐負杖，忘其疲病。必欲飾渾沌以蛾眉，冠越客於文冕，走雖不敏，請附高節，有蹈東海而死爾。」永乃止。",
      "reading": "張永為吳興，沈驎士因好山水往，辭為功曹。",
      "note": "張永為吳興，沈驎士因好山水往，辭為功曹。",
      "paragraph_id": "c-nanqishu-054-recluses-complete:p070",
      "start_codepoint": 0,
      "end_codepoint": 114,
      "human_reviewed": false,
      "chapter_id": "c-nanqishu-054-recluses-complete",
      "source_id": "s-nanqishu-054-recluses-complete-ws1762878"
    },
    {
      "id": "c-nanqishu-054-recluses-complete:source_review71-0",
      "kind": "source_review",
      "person_id": "46f_sl6_8ou",
      "source_quote": "　　昇明末，太守王奐上表薦之，詔徵爲奉朝請，不就。永明六年，吏部郎沈淵、中書郎沈約又表薦驎士義行，曰：「吳興沈驎士，英風夙挺，峻節早樹，貞粹稟於天然，綜博生乎篤習。家世孤貧，藜藿不給，懷書而耕，白首無倦，挾琴採薪，行歌不輟。長兄早卒，孤姪數四，攝尪鞠稚，吞苦推甘。年踰七十，業行無改。元嘉以來，聘召仍疊，玉質踰潔，霜操日嚴。若使聞政王庭，服道槐掖，必能孚朝規於邊鄙，播聖澤於荒垂。」詔又徵爲太學博士，建武二年，徵著作郎，永元二年，徵太子舍人，竝不就。",
      "reading": "王奐前薦於昇明末，沈淵與沈約後薦於永明六年。年逾七十出後一表。",
      "note": "王奐前薦於昇明末，沈淵與沈約後薦於永明六年。年逾七十出後一表。",
      "paragraph_id": "c-nanqishu-054-recluses-complete:p071",
      "start_codepoint": 0,
      "end_codepoint": 225,
      "human_reviewed": false,
      "chapter_id": "c-nanqishu-054-recluses-complete",
      "source_id": "s-nanqishu-054-recluses-complete-ws1762878"
    },
    {
      "id": "c-nanqishu-054-recluses-complete:source_review72-0",
      "kind": "source_review",
      "person_id": "46f_sl6_8ou",
      "source_quote": "　　驎士負薪汲水，幷日而食，守操終老。篤學不倦，遭火，燒書數千卷，驎士年過八十，耳目猶聦明，手以反故抄寫，火下細書，復成二三千卷，滿數十篋，時人以爲養身靜嘿之所致也。著《周易兩繫莊子內篇訓》，注《易經》、《禮記》、《春秋》、《尚書》、《論語》、《孝經》、《喪服》、《老子》要略數十卷。以楊王孫、皇甫謐深達生死，而終禮矯偽，乃自作終制。年八十六，卒。",
      "reading": "沈驎士八十過後遇火續抄，報卒年齡八十六而無明紀年。",
      "note": "沈驎士八十過後遇火續抄，報卒年齡八十六而無明紀年。",
      "paragraph_id": "c-nanqishu-054-recluses-complete:p072",
      "start_codepoint": 0,
      "end_codepoint": 174,
      "human_reviewed": false,
      "chapter_id": "c-nanqishu-054-recluses-complete",
      "source_id": "s-nanqishu-054-recluses-complete-ws1762878"
    }
