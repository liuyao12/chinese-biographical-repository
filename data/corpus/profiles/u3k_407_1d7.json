      },
      "evidence": [
        {
          "work_id": "w-jinshu",
          "book_id": "b-jinshu-063",
          "chapter_id": "c-jinshu-063-guomo",
          "source_id": "s-jinshu-063-guomo-ws2025242",
          "paragraph_id": "c-jinshu-063-guomo:p001",
          "quote": "郭默，河內懷人。少微賤，以壯勇事太守裴整，為督將。永嘉之亂，默率遺眾自為塢主，以漁舟抄東歸行旅，積年遂致巨富，流人依附者漸眾。撫循將士，甚得其歡心。默婦兄同郡陸嘉取官米數石餉妹，默以為違制，將殺嘉，嘉懼，奔石勒。默乃自射殺婦，以明無私。遣使謁劉琨，琨加默河內太守。劉元海遣從子曜討默，曜列三屯圍之，欲使餓死。默送妻子為質，並請糴焉，糴畢，設守。曜怒，沈默妻子于河而攻之。默遣弟芝求救于劉琨，琨知默狡猾，留之而緩其救。默更遣人告急。會芝出城浴馬，使強與俱歸。默乃遣芝質于石勒，勒以默多詐，封默書與劉曜。默使人伺得勒書，便突圍投李矩。後與矩並力距劉、石，事見矩傳。",
          "subject_person_mention_id": "c-jinshu-063-guomo:p001:m0188",
          "object_person_mention_id": "c-jinshu-063-guomo:p001:m0000"
        }
      ],
      "status": "source_attested",
      "interpretation_note": "弟芝奉郭默命求救。",
      "reviewer": "Codex（AI代理）",
      "model": null,
      "human_reviewed": false
    },
