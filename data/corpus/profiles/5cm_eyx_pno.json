    },
    {
      "id": "c-songshu-048-zhulingshi:p010:r0077",
      "paragraph_id": "c-songshu-048-zhulingshi:p010",
      "start": 77,
      "end": 80,
      "surface": "敬皇后",
      "person_id": "5cm_eyx_pno",
      "referent_role": "third_person",
      "quote": "高祖之伐蜀也，將謀元帥而難其人，乃舉齡石。眾咸謂自古平蜀，皆雄傑重將，齡石資名尚輕，慮不克辦，諫者甚眾，高祖不從。乃分大軍之半，猛將勁卒，悉以配之。臧熹，敬皇后弟〔也。資位在齡石之右，亦令受其節度。是行亦不淹時，一戰克捷，眾〕咸服高祖之知人，又美齡石之善於其事。",
      "note": "依本段敘事、稱謂及語者受者定。",
      "chapter_id": "c-songshu-048-zhulingshi",
      "book_id": "b-songshu-048",
      "work_id": "w-songshu",
      "source_id": "s-songshu-048-zhulingshi-ws1791560"
    },
    {
      "id": "c-songshu-074-xuanmo-zangzhi:p001:r0017",
      "paragraph_id": "c-songshu-074-xuanmo-zangzhi:p001",
      "start": 17,
      "end": 21,
      "surface": "武敬皇后",
      "person_id": "5cm_eyx_pno",
      "referent_role": "third_person",
      "quote": "臧質字含文，東莞莒人。父熹字義和，武敬皇后弟也。與兄燾並好經籍。",
      "note": "依本段敘事、稱謂及語者受者定。",
      "chapter_id": "c-songshu-074-xuanmo-zangzhi",
      "book_id": "b-songshu-074",
      "work_id": "w-songshu",
      "source_id": "s-songshu-074-xuanmo-zangzhi-ws2118597"
    }
