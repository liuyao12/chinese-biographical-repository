    {
      "number": 59,
      "category": "",
      "title": "晉書卷五十九·司馬倫",
      "paragraph_id": "c-jinshu-059-prince-lun:p005",
      "count": 1,
      "raw_count": 1,
      "duplicate_count": 0,
      "counting_policy": "independent_fixed_witness_occurrences",
      "quote": "淮南王允、齊王冏以倫、秀驕僭，內懷不平。秀等亦深忌焉，乃出冏鎮許，奪允護軍。允發憤，起兵討倫。允既敗滅，倫加九錫，增封五萬戶。倫偽為飾讓，詔遣百官詣府敦勸，侍中宣詔，然後受之。加荂撫軍將軍、領軍將軍，馥鎮軍將",
      "paragraph_ids": [
        "c-jinshu-059-prince-lun:p005"
      ],
