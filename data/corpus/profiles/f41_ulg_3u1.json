  "relations": [
    {
      "id": "a-shiji115-001",
      "subject_person_id": "f41_ulg_3u1_*A",
      "predicate": "grandfather",
      "object_person_id": "f41_ulg_3u1",
      "status": "source_attested",
      "evidence": [
        {
          "chapter_id": "c-shiji-115-chaoxian",
          "source_id": "s-shiji115-chaoxian",
          "paragraph_id": "c-shiji-115-chaoxian:p002",
          "quote": "會孝惠、高后時天下初定，遼東太守即約滿為外臣，保塞外蠻夷，無使盜邊；諸蠻夷君長欲入見天子，勿得禁止。以聞，上許之，以故滿得兵威財物侵降其旁小邑，真番、臨屯皆來服屬，方數千里。"
        },
        {
          "chapter_id": "c-shiji-115-chaoxian",
          "source_id": "s-shiji115-chaoxian",
          "paragraph_id": "c-shiji-115-chaoxian:p003",
          "quote": "傳子至孫右渠，所誘漢亡人滋多，又未嘗入見；真番旁眾國欲上書見天子，又擁閼不通。元封二年，漢使涉何譙諭右渠，終不肯奉詔。何去至界上，臨浿水，使御刺殺送何者朝鮮裨王長，即渡，馳入塞，遂歸報天子曰「殺朝鮮將」。上為其名美，即不詰，拜何為遼東東部都尉。朝鮮怨何，發兵襲攻殺何。"
        }
      ],
      "qualifiers": {
        "source_term": "傳子至孫右渠"
      },
      "interpretation_note": "承接滿傳至孫右渠，兩代距離；未名父親不補造。",
      "reviewer": "Codex（AI 代理）",
