  "occurrences": [
    {
      "number": 24,
      "category": "",
      "title": "王氏跨史家系選段",
      "paragraph_id": "c-nanshi-024-wang-family:line053",
      "count": 7,
      "quote": "子綸之，字元章。爲安成王記室參軍，偃仰召會，退居僚末。司徒袁粲聞而歎曰：「格外之官，便今日爲重。」貴游居此位者，遂以不掌文記爲高，自綸之始也。齊永明中，歷位侍中，出爲豫章太守。下車祭徐孺子、許子將墓，圖畫陳",
      "work_id": "w-nanshi",
      "book_id": "b-nanshi-024",
      "chapter_id": "c-nanshi-024-wang-family",
      "source_id": "s-nanshi-024-wang-family",
      "work_title": "南史",
      "paragraph_ids": [
        "c-nanshi-024-wang-family:line053",
        "c-nanshi-024-wang-family:line057"
      ],
      "mention_ids": [
        "c-nanshi-024-wang-family:line053:m0001",
        "c-nanshi-024-wang-family:line053:m0005",
        "c-nanshi-024-wang-family:line053:m0066",
        "c-nanshi-024-wang-family:line053:m0134",
        "c-nanshi-024-wang-family:line053:m0177",
        "c-nanshi-024-wang-family:line057:m0000",
        "c-nanshi-024-wang-family:line057:m0010"
      ]
    },
