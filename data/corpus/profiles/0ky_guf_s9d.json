      ],
      "work_id": "w-songshu",
      "book_id": "b-songshu-049",
      "chapter_id": "c-songshu-049-kuaien",
      "source_id": "s-songshu-049-kuaien-ws2118585",
      "work_title": "宋書"
    },
    {
      "number": 49,
      "category": "",
      "title": "劉鍾",
      "paragraph_id": "c-songshu-049-liuzhong:p003",
      "count": 1,
      "raw_count": 1,
      "duplicate_count": 0,
      "counting_policy": "independent_fixed_witness_occurrences",
      "quote": "閉戶距之，鍾乃徐還。與仲德攻崇民，崇民敗走，鍾追討百里，燒其船乘。又隨劉藩追徐道覆於始興，斬之。補太尉行參軍、寧朔將軍、下邳太守。代孟懷玉領石頭戍事。",
      "paragraph_ids": [
