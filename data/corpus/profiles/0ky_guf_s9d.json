    {
      "number": 49,
      "category": "",
      "title": "蒯恩",
      "paragraph_id": "c-songshu-049-kuaien:p002",
      "count": 1,
      "raw_count": 1,
      "duplicate_count": 0,
      "counting_policy": "independent_fixed_witness_occurrences",
      "quote": "賊退走。與王仲德等追破循別將范崇民於南陵。循既走還廣州，恩又領千餘人隨劉藩追徐道覆於始興，斬之。遷龍驤將軍、蘭陵太守。",
      "paragraph_ids": [
