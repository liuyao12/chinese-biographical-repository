    {
      "number": 17,
      "category": "",
      "title": "陳書卷十七·王沖",
      "paragraph_id": "c-chenshu-017-wangchong-complete:p004",
      "count": 1,
      "raw_count": 1,
      "duplicate_count": 0,
      "counting_policy": "independent_fixed_witness_occurrences",
      "quote": "江陵陷，敬帝為太宰，承制以沖為左長史。紹泰中，累遷左光祿大夫、尚書右僕射。遷左僕射、開府儀同三司，侍中、將軍如故。尋復領丹陽尹、南徐州大中正，給扶。",
      "paragraph_ids": [
