    {
      "number": 23,
      "category": "",
      "title": "陳書卷二十三·王瑒",
      "paragraph_id": "c-chenshu-023-wangyang-complete:p001",
      "count": 2,
      "raw_count": 2,
      "duplicate_count": 0,
      "counting_policy": "independent_fixed_witness_occurrences",
      "quote": "掌相府管記。出為東宮內史，遷太子中庶子。丁所生母憂，歸于丹陽。江陵陷，梁敬帝承制，除仁威將軍、尚書吏部郎中。貞陽侯僭位，以敬帝為太子，授瑒散騎常侍，侍東宮。尋遷長（史）兼侍中。",
      "paragraph_ids": [
        "c-chenshu-023-wangyang-complete:p001"
