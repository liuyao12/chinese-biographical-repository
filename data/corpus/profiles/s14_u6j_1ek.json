  "person_references": [
    {
      "id": "c-chenshu-023-wangyang-complete:p001:r0129",
      "paragraph_id": "c-chenshu-023-wangyang-complete:p001",
      "start": 129,
      "end": 131,
      "surface": "太子",
      "person_id": "s14_u6j_1ek",
      "referent_role": "third_person",
      "quote": "王瑒字子璵，司空沖之第十二子也。沈靜有器局，美風儀，舉止醞藉。梁大同中，起家祕書郎，遷太子洗馬。元帝承制，徵為中書侍郎，直殿省，仍掌相府管記。出為東宮內史，遷太子中庶子。丁所生母憂，歸于丹陽。江陵陷，梁敬帝承制，除仁威將軍、尚書吏部郎中。貞陽侯僭位，以敬帝為太子，授瑒散騎常侍，侍東宮。尋遷長（史）兼侍中。",
      "note": "依本段敘事、稱謂及語者受者定。",
      "chapter_id": "c-chenshu-023-wangyang-complete",
      "book_id": "b-chenshu-023",
      "work_id": "w-chenshu",
      "source_id": "s-chenshu-023-wangyang-complete-ws1514496"
    },
    {
      "id": "c-liangshu-006-jing-consorts:p003:r0006",
      "surface": "帝",
      "start": 6,
      "end": 7,
      "person_id": "s14_u6j_1ek",
      "referent_role": "third_person",
      "paragraph_id": "c-liangshu-006-jing-consorts:p003",
      "quote": "陳王踐阼，奉帝爲江陰王，薨于外邸，時年十六，追諡敬皇帝。",
      "note": "依傳題與梁敬帝紀。",
      "chapter_id": "c-liangshu-006-jing-consorts",
      "book_id": "b-liangshu-006",
      "work_id": "w-liangshu",
      "source_id": "s-liangshu-006-jing-consorts-ws2311629"
    },
    {
      "id": "c-nanshi-012-jing-consorts:p002:r0021",
      "surface": "晉安王",
      "start": 21,
      "end": 24,
      "person_id": "s14_u6j_1ek",
      "referent_role": "third_person",
      "paragraph_id": "c-nanshi-012-jing-consorts:p002",
      "quote": "敬王皇后，琅邪臨沂人也。承聖元年十一月，拜晉安王妃。紹泰元年十月，拜皇后。明年，降為江陰王妃。父僉自有傳。",
      "note": "依傳題與梁敬帝紀。",
