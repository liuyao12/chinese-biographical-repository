  "source_reading_cases": [
    {
      "id": "c-nanqishu-055-filial-complete:source_review33-0",
      "kind": "source_review",
      "person_id": "iqu_kre_msh",
      "source_quote": "　　江泌字士清，濟陽考城人也。父亮之，員外郎。泌少貧，晝日斫屟，夜讀書，隨月光握卷升屋。性行仁義，衣弊，恐虱饑死，乃復取置衣中。數日閒，終身無復虱。母亡後，以生闕供養，遇鮭不忍食。食菜不食心，以其有生意也。",
      "reading": "孝江泌字士清，父江亮之。少貧晝夜勤學，母亡後以舊養不足自戒。",
      "note": "孝江泌字士清，父江亮之。少貧晝夜勤學，母亡後以舊養不足自戒。",
      "paragraph_id": "c-nanqishu-055-filial-complete:p033",
      "start_codepoint": 0,
      "end_codepoint": 103,
      "human_reviewed": false,
      "chapter_id": "c-nanqishu-055-filial-complete",
      "source_id": "s-nanqishu-055-filial-complete-ws1545598"
    },
    {
      "id": "c-nanqishu-055-filial-complete:source_review34-0",
      "kind": "source_review",
      "person_id": "iqu_kre_msh",
      "source_quote": "　　歷仕南中郎行參軍，所給募吏去役，得時病，莫有舍之者，吏扶杖投泌，泌親自隱卹，吏死，泌爲買棺。無僮役，兄弟共輿埋之。領國子助教。乘牽車至染烏頭，見老翁步行，下車載之，躬自步去。",
      "reading": "江泌葬所屬募吏，又下車載老翁，二者皆不具名。",
      "note": "江泌葬所屬募吏，又下車載老翁，二者皆不具名。",
      "paragraph_id": "c-nanqishu-055-filial-complete:p034",
      "start_codepoint": 0,
      "end_codepoint": 89,
      "human_reviewed": false,
      "chapter_id": "c-nanqishu-055-filial-complete",
      "source_id": "s-nanqishu-055-filial-complete-ws1545598"
    },
    {
      "id": "c-nanqishu-055-filial-complete:source_review35-0",
      "kind": "source_review",
      "person_id": "iqu_kre_msh",
      "source_quote": "　　世祖以爲南康王子琳侍讀。建武中，明帝害諸王後，泌憂念子琳，詣誌公道人問其禍福。誌公覆香鑪灰示之，曰：「都盡。無所餘。」及子琳被害，泌往哭之，淚盡，繼之以血。親視殯葬，乃去。時廣漢王侍讀嚴桓之亦哭王盡哀。",
      "reading": "江泌哭南康王子琳。嚴桓之所哭為廣漢王，另有侍讀身分。",
      "note": "江泌哭南康王子琳。嚴桓之所哭為廣漢王，另有侍讀身分。",
      "paragraph_id": "c-nanqishu-055-filial-complete:p035",
      "start_codepoint": 0,
      "end_codepoint": 103,
      "human_reviewed": false,
      "chapter_id": "c-nanqishu-055-filial-complete",
      "source_id": "s-nanqishu-055-filial-complete-ws1545598"
    },
    {
      "id": "c-nanqishu-055-filial-complete:source_review36-0",
      "kind": "source_review",
      "person_id": "iqu_kre_msh",
      "source_quote": "　　泌尋卒。泌族人兖州治中泌，黃門郎悆子也，與泌同名。世謂泌爲「孝江泌」以別之。",
      "reading": "作兖州治中的同名江泌以黃門郎悆子為別。段首卒及世稱孝江泌均指亮之子。",
      "note": "作兖州治中的同名江泌以黃門郎悆子為別。段首卒及世稱孝江泌均指亮之子。",
      "paragraph_id": "c-nanqishu-055-filial-complete:p036",
      "start_codepoint": 0,
      "end_codepoint": 40,
      "human_reviewed": false,
      "chapter_id": "c-nanqishu-055-filial-complete",
      "source_id": "s-nanqishu-055-filial-complete-ws1545598"
    },
    {
      "id": "c-nanqishu-055-filial-complete:variant_review35-88",
      "kind": "variant_review",
