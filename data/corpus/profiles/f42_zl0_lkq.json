        "c-shiji-032-qi:m060-0011"
      ]
    },
    {
      "number": 33,
      "category": "shijia",
      "title": "魯周公世家第三",
      "paragraph_id": "c-shiji-033-lu:p063",
      "count": 1,
      "quote": "襄公元年，晉立悼公。往年冬，晉欒書弒其君厲公。四年，襄公朝晉。",
      "work_id": "w-shiji",
      "book_id": "b-shiji-033",
      "chapter_id": "c-shiji-033-lu",
      "source_id": "s-shiji-033-lu",
      "work_title": "史記",
      "paragraph_ids": [
