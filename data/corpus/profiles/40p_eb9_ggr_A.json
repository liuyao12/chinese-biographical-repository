      "evidence": [
        {
          "work_id": "w-sanguozhi",
          "book_id": "b-sanguozhi-058",
          "chapter_id": "c-sanguozhi-058-lukang",
          "source_id": "s-sanguozhi-058-lukang",
          "paragraph_id": "c-sanguozhi-058-lukang:line087",
          "quote": "秋遂卒，子晏嗣。晏及弟景、玄、機、雲、分領抗兵。晏為裨將軍、夷道監。天紀四年，晉軍伐吳，龍驤將軍王浚順流東下。所至輒克，終如抗慮。景字士仁，以尚公主拜騎都尉，封毗陵侯，既領抗兵，拜偏將軍、中夏督，澡身好學，著書數十篇也。二月壬戌，晏為王浚別軍所殺。癸亥，景亦遇害，時年三十一。景妻，孫皓適妹，與景俱張承外孫也。",
          "person_mention_id": "c-sanguozhi-058-lukang:line087:m0011"
        }
      ],
