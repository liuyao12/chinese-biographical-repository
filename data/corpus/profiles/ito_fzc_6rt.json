  "source_reading_cases": [
    {
      "id": "c-nanqishu-058-southern-and-eastern-complete:source_review3-0",
      "kind": "source_review",
      "person_id": "ito_fzc_6rt",
      "source_quote": "汶陽本臨沮西界，二百里中，水陸迂狹，魚貫而行，有數處不通騎，而水白田甚肥腴。桓溫時，割以為郡。西北接梁州新城，東北接南襄城，南接巴、巫二邊，竝山蠻凶盛，據險為寇賊。宋泰始以來，巴建蠻向宗頭反，刺史沈攸之斷其鹽米，連討不剋。晉（天）〔太〕興三年，建平夷王向弘、向瓂等詣臺求拜除，尚書郎張亮議：「夷貊不可假以軍號。」元帝詔特以弘為折衝將軍、當平鄉侯，竝親晉王，賜以朝服。宗頭其後也。太祖置巴州以威靜之。",
      "reading": "汶陽沿革及鄰界為地誌。向宗頭宋泰始活動與下一附敘永明初分時。",
      "note": "汶陽沿革及鄰界為地誌。向宗頭宋泰始活動與下一附敘永明初分時。",
      "paragraph_id": "c-nanqishu-058-southern-and-eastern-complete:p003",
      "start_codepoint": 0,
      "end_codepoint": 199,
      "human_reviewed": false,
      "chapter_id": "c-nanqishu-058-southern-and-eastern-complete",
      "source_id": "s-nanqishu-058-southern-and-eastern-complete-ws2638629"
    },
    {
      "id": "c-nanqishu-058-southern-and-eastern-complete:source_review5-0",
      "kind": "source_review",
      "person_id": "ito_fzc_6rt",
      "source_quote": "永明初，向宗頭與黔陽蠻田豆渠等五千人為寇，巴東太守王圖南遣府司馬劉僧壽等斬山開道，攻其砦，宗頭夜燒砦退走。",
      "reading": "向宗頭與田豆渠聯起，巴東太守王圖南遣劉僧壽攻，宗頭燒砦退走。",
      "note": "向宗頭與田豆渠聯起，巴東太守王圖南遣劉僧壽攻，宗頭燒砦退走。",
