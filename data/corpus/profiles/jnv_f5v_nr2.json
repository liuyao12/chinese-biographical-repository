  "label": "劉楷（齊大司農、交州刺史）",
  "identity_note": "武帝紀永明三年春正月以劉楷為交州刺史。",
  "review": "ai_provisional",
  "names": [
    "劉楷",
    "楷"
  ],
  "titles": [],
  "addresses": [],
  "occurrences": [
    {
      "number": 40,
      "category": "",
      "title": "竟陵文宣王子良、邯鄲超",
      "paragraph_id": "c-nanqishu-040-ziliang:p015",
      "count": 1,
      "raw_count": 1,
      "duplicate_count": 0,
      "counting_policy": "independent_fixed_witness_occurrences",
      "quote": "宜聽從；取亂侮亡，更俟後會。雖緩歲月，必有可禽之理，差息發動費役之勞。劉楷見甲以助湘中，威力旣舉，蟻寇自服。",
      "paragraph_ids": [
