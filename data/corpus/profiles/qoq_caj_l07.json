    {
      "id": "th-jin034-duyu-career_012",
      "person_id": "qoq_caj_l07",
      "status": "source_attested",
      "evidence": [
        {
          "work_id": "w-jinshu",
          "book_id": "b-jinshu-034",
          "chapter_id": "c-jinshu-034-duyu",
          "source_id": "s-jinshu-034-ws2567662-duyu",
          "paragraph_id": "c-jinshu-034-duyu:p005",
          "quote": "司隸校尉石鑒以宿憾奏預，免職。時虜寇隴石，以預為安西軍司，給兵三百人，騎百匹。到長安，更除秦州刺史，領東羌校尉、輕車將軍、假節。屬虜兵強盛，石鑒時為安西將軍，使預出兵擊之。預以虜乘勝馬肥，而官軍懸乏，宜並力大運，須春進討，陳五不可、四不須。鑒大怒，復奏預擅飾城門官舍，稽乏軍興，遣御史檻車征詣廷尉。以預尚主，在八議，以侯贖論，。其後隴右之事卒如預策。",
          "person_mention_id": "c-jinshu-034-duyu:p005:m0004"
        }
      ],
      "reviewer": "Codex（AI代理）",
      "human_reviewed": false,
      "model": null,
      "interpretation_note": "完整固定本傳逐角色判讀；起終年未知不補、來源用稱不冒授任。",
