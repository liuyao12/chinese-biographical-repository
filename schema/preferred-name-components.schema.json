{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-scoped preferred name component display reading",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "record_type",
    "readings"
  ],
  "properties": {
    "format_version": {
      "const": "0.1"
    },
    "record_type": {
      "const": "preferred_name_component_reading_set"
    },
    "readings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "person_id",
          "field",
          "preferred_value",
          "source_values",
          "records",
          "basis",
          "coverage",
          "status",
          "human_reviewed",
          "rationale"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "person_id": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "const": "ming"
          },
          "preferred_value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1
          },
          "source_values": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1
            }
          },
          "records": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "record",
                "anchor",
                "source_id"
              ],
              "properties": {
                "record": {
                  "type": "object",
                  "required": [
                    "id",
                    "person_id",
                    "chapter_id",
                    "paragraph_id",
                    "surname",
                    "ming",
                    "quote"
                  ]
                },
                "anchor": {
                  "type": "object",
                  "required": [
                    "id",
                    "start",
                    "end",
                    "surface",
                    "person_id"
                  ]
                },
                "source_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "basis": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "source_id",
              "chapter_id",
              "paragraph_id",
              "quote",
              "anchors"
            ],
            "properties": {
              "kind": {
                "const": "same_paragraph_mixed_name_spellings"
              },
              "source_id": {
                "type": "string"
              },
              "chapter_id": {
                "type": "string"
              },
              "paragraph_id": {
                "type": "string"
              },
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "anchors": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object"
                }
              }
            }
          },
          "coverage": {
            "const": "listed_records_only"
          },
          "status": {
            "const": "editorial_provisional"
          },
          "human_reviewed": {
            "type": "boolean"
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
