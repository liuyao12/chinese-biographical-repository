  "source_clauses": [
    {
      "witness": "w59",
      "quote": "登辭疾不受",
      "raw_start": 258,
      "raw_end": 263,
      "raw_line": 12
    },
    {
      "witness": "w59",
      "quote": "蔣脩、虞翻，志節分明",
      "raw_start": 1867,
      "raw_end": 1877,
      "raw_line": 18
    },
    {
      "witness": "w59",
      "quote": "子璠、希，皆早卒，次子英",
      "raw_start": 2395,
      "raw_end": 2407,
      "raw_line": 20
    },
    {
      "witness": "w59",
      "quote": "尚書僕射存上疏曰",
      "raw_start": 2655,
      "raw_end": 2663,
      "raw_line": 25
    },
    {
      "witness": "w59",
      "quote": "後諸葛壹僞叛以誘魏將諸葛誕",
      "raw_start": 3318,
      "raw_end": 3331,
      "raw_line": 28
    },
    {
      "witness": "w59",
      "quote": "和妃叔父張休",
      "raw_start": 3876,
      "raw_end": 3882,
      "raw_line": 32
    },
    {
      "witness": "w59",
      "quote": "恪即和妃張之舅也",
      "raw_start": 4989,
      "raw_end": 4997,
      "raw_line": 34
    },
    {
      "witness": "w59",
      "quote": "和四子：皓、德、謙、俊",
      "raw_start": 5490,
      "raw_end": 5501,
      "raw_line": 36
    },
    {
      "witness": "w59",
      "quote": "俊，張承外孫",
      "raw_start": 5649,
      "raw_end": 5655,
      "raw_line": 36
    },
    {
      "witness": "w59",
      "quote": "孫霸字子威，和弟也。",
      "raw_start": 5690,
      "raw_end": 5700,
      "raw_line": 39
    },
    {
      "witness": "w59",
      "quote": "削基、壹爵土，與祖母謝姬",
      "raw_start": 6479,
      "raw_end": 6491,
      "raw_line": 43
    },
    {
      "witness": "w59",
      "quote": "孤有兄獨爾云何",
      "raw_start": 7559,
      "raw_end": 7566,
      "raw_line": 48
    },
    {
      "witness": "w59",
      "quote": "孫皓左夫人王氏卒",
      "raw_start": 7603,
      "raw_end": 7611,
      "raw_line": 50
    },
    {
      "witness": "w59",
      "quote": "誅奮及其五子，國除。",
      "raw_start": 7687,
      "raw_end": 7697,
      "raw_line": 50
    },
    {
      "witness": "w47",
      "quote": "立子[[w:孫霸|霸]]爲魯王。",
      "raw_start": 21937,
      "raw_end": 21953,
      "raw_line": 117
    },
    {
      "witness": "w47",
      "quote": "立故太子和爲南陽王，居長沙。子奮爲齊王，居武昌。",
      "raw_start": 24252,
      "raw_end": 24276,
      "raw_line": 137
    },
    {
      "witness": "w48",
      "quote": "封故齊王奮爲章安侯。",
      "raw_start": 2474,
      "raw_end": 2484,
      "raw_line": 30
    },
    {
      "witness": "w50",
      "quote": "使母養子登。",
      "raw_start": 1717,
      "raw_end": 1723,
      "raw_line": 28
    },
    {
      "witness": "w50",
      "quote": "生（孫）和",
      "raw_start": 2385,
      "raw_end": 2390,
      "raw_line": 40
    },
    {
      "witness": "w50",
      "quote": "遂拊育皓及其三弟。",
      "raw_start": 3889,
      "raw_end": 3898,
      "raw_line": 58
    },
    {
      "witness": "w50",
      "quote": "即奪純妻入宮，大有寵，拜為左夫人",
      "raw_start": 4151,
      "raw_end": 4167,
      "raw_line": 58
    },
    {
      "witness": "w52",
      "quote": "生女，權爲子和納之。",
      "raw_start": 3865,
      "raw_end": 3875,
      "raw_line": 32
    },
    {
      "witness": "w57",
      "quote": "在南十餘年，年七十卒。",
      "raw_start": 5175,
      "raw_end": 5186,
      "raw_line": 29
    },
    {
      "witness": "w58",
      "quote": "景妻，孫皓適妹，與景俱張承外孫也。",
      "raw_start": 10511,
      "raw_end": 10528,
      "raw_line": 87
    }
  ],
