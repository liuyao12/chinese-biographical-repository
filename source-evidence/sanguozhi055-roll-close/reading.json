  "source_clauses": [
    {
      "witness": "w55",
      "quote": "徐盛字文嚮，琅邪莒人也。",
      "raw_start": 8785,
      "raw_end": 8797,
      "raw_line": 104
    },
    {
      "witness": "w55",
      "quote": "黃武中卒。子楷，襲爵領兵。",
      "raw_start": 9419,
      "raw_end": 9432,
      "raw_line": 114
    },
    {
      "witness": "w55",
      "quote": "故南陽太守黃子廉之後也",
      "raw_start": 787,
      "raw_end": 798,
      "raw_line": 21
    },
    {
      "witness": "w55",
      "quote": "子綜襲侯領兵",
      "raw_start": 1922,
      "raw_end": 1928,
      "raw_line": 30
    },
    {
      "witness": "w55",
      "quote": "父操，輕俠有膽氣",
      "raw_start": 7523,
      "raw_end": 7531,
      "raw_line": 89
    },
    {
      "witness": "w55",
      "quote": "會病卒，時年四十九",
      "raw_start": 8436,
      "raw_end": 8445,
      "raw_line": 99
    },
    {
      "witness": "w55",
      "quote": "令葛光教之讀書",
      "raw_start": 8535,
      "raw_end": 8542,
      "raw_line": 101
    },
    {
      "witness": "w55",
      "quote": "二子烈、封",
      "raw_start": 8488,
      "raw_end": 8493,
      "raw_line": 101
    },
    {
      "witness": "w55",
      "quote": "并羽子平、都督趙累等",
      "raw_start": 9747,
      "raw_end": 9757,
      "raw_line": 121
    },
    {
      "witness": "w55",
      "quote": "子平，以無行徙會稽",
      "raw_start": 10113,
      "raw_end": 10122,
      "raw_line": 125
    },
    {
      "witness": "w55",
      "quote": "皓怒，斬奉導軍。三年，卒",
      "raw_start": 10977,
      "raw_end": 10989,
      "raw_line": 138
    },
    {
      "witness": "jk",
      "quote": "二十二年春，權令都尉徐祥詣曹操詐降",
      "raw_start": 12757,
      "raw_end": 12774,
      "raw_line": 106
    },
    {
      "witness": "jk",
      "quote": "是歲，偏將軍、都亭侯凌統卒。",
      "raw_start": 12849,
      "raw_end": 12863,
      "raw_line": 108
    },
    {
      "witness": "jk",
      "quote": "統為人性好接物，親賢愛士，輕財重義，有國士風。年二十九卒。權聞之驚起，哀不自勝，使張承作誄致祭。",
      "raw_start": 13052,
      "raw_end": 13100,
      "raw_line": 114
    },
    {
      "witness": "jk",
      "quote": "有二子烈、封，",
      "raw_start": 13102,
      "raw_end": 13109,
      "raw_line": 116
    },
    {
      "witness": "jk",
      "quote": "皆幼弱，權收養於宮中。年八九歲，令葛先授書，",
      "raw_start": 13170,
      "raw_end": 13192,
      "raw_line": 116
    },
    {
      "witness": "jk",
      "quote": "「烈」原作「列」，今據庫本、徐鈔本及《吳志‧凌統傳》改正。",
      "raw_start": 13135,
      "raw_end": 13164,
      "raw_line": 116
    },
    {
      "witness": "jk",
      "quote": "《吳志‧凌統傳》作「葛光」，先、光形近，未知孰是。",
      "raw_start": 13215,
      "raw_end": 13240,
      "raw_line": 116
    },
    {
      "witness": "sk",
      "quote": "是歳偏將軍都亭侯凌統卒",
      "raw_start": 6496,
      "raw_end": 6507,
      "raw_line": 23
    },
    {
      "witness": "sk",
      "quote": "有國士風年二十九卒",
      "raw_start": 6673,
      "raw_end": 6682,
      "raw_line": 23
    },
    {
      "witness": "sk",
      "quote": "有二子烈封皆幼弱權收養於宫中",
      "raw_start": 6698,
      "raw_end": 6712,
      "raw_line": 23
    },
    {
      "witness": "sk",
      "quote": "令葛先授書十日一教乗馬射",
      "raw_start": 6716,
      "raw_end": 6728,
      "raw_line": 23
    },
    {
      "witness": "w46",
      "quote": "{{ProperNoun|-{于}-麋}}東屯{{ProperNoun|橫江津}}",
      "raw_start": 18193,
      "raw_end": 18234,
      "raw_line": 37
    },
    {
      "witness": "w46",
      "quote": "{{ProperNoun|張英}}屯{{ProperNoun|當利口}}",
      "raw_start": 18235,
      "raw_end": 18271,
      "raw_line": 37
    },
    {
      "witness": "w47",
      "quote": "瑜、普爲左右督，各領萬人",
      "raw_start": 2339,
      "raw_end": 2351,
      "raw_line": 26
    },
    {
      "witness": "w47",
      "quote": "璋司馬馬忠獲羽及其子平、都督趙累等於章鄉",
      "raw_start": 4324,
      "raw_end": 4344,
      "raw_line": 44
    },
    {
      "witness": "w48",
      "quote": "殺將軍韓綜、桓嘉等",
      "raw_start": 592,
      "raw_end": 601,
      "raw_line": 16
    },
    {
      "witness": "w48",
      "quote": "右大司馬丁奉、司空孟仁卒。",
      "raw_start": 11566,
      "raw_end": 11579,
      "raw_line": 70
    },
    {
      "witness": "w48",
      "quote": "將軍丁封、孫異如沔中",
      "raw_start": 6706,
      "raw_end": 6716,
      "raw_line": 49
    },
    {
      "witness": "w48",
      "quote": "丁奉、鍾離斐以武毅稱",
      "raw_start": 19982,
      "raw_end": 19992,
      "raw_line": 107
    },
    {
      "witness": "w49",
      "quote": "繇遣樊能、張英屯江邊以拒之",
      "raw_start": 995,
      "raw_end": 1008,
      "raw_line": 13
    },
    {
      "witness": "w54",
      "quote": "蒙與淩統以死扦衛",
      "raw_start": 11668,
      "raw_end": 11676,
      "raw_line": 75
    },
    {
      "witness": "w54",
      "quote": "即父子俱獲",
      "raw_start": 12942,
      "raw_end": 12947,
      "raw_line": 79
    },
    {
      "witness": "w57",
      "quote": "及淩統死，復領其兵。",
      "raw_start": 12355,
      "raw_end": 12365,
      "raw_line": 63
    },
    {
      "witness": "w59",
      "quote": "諸葛恪、張休、顧譚、陳表等以選入",
      "raw_start": 290,
      "raw_end": 306,
      "raw_line": 12
    }
  ],
