          "text_sha256": "059d0f9939748e038bea6bc34194cb2f5d55da0b1a725acb1aee065b487a5ade"
        },
        {
          "parent_body_offset": 562,
          "text": "左氏傳曰父子兄弟罪不相及",
          "raw_runs": [
