            },
            {
              "raw_line": 112,
              "raw_start": 23,
              "raw_end": 36,
              "surface": "才賜反前書音義曰瞋目貎也史"
            },
            {
              "raw_line": 113,
              "raw_start": 1,
              "raw_end": 5,
              "surface": "記曰睚眦"
