      "raw_runs": [
        {
          "raw_line": 1,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "賈逵字梁道河東襄陵人也自為兒童戲弄常設部伍"
        },
        {
          "raw_line": 2,
          "raw_start": 0,
          "raw_end": 19,
          "start": 21,
          "end": 40,
          "surface": "祖父習異之曰汝大必為將率口授兵法數萬言"
        }
      ],
      "text": "賈逵字梁道河東襄陵人也自為兒童戲弄常設部伍祖父習異之曰汝大必為將率口授兵法數萬言"
    },
    {
      "key": "full002",
      "layer": "pei_annotation",
      "raw_window": [
        3,
        4
      ],
      "raw_runs": [
        {
          "raw_line": 3,
          "raw_start": 0,
          "raw_end": 4,
          "start": 0,
          "end": 4,
          "surface": "魏畧曰逵"
        },
        {
          "raw_line": 4,
          "raw_start": 0,
          "raw_end": 34,
          "start": 4,
          "end": 38,
          "surface": "世為著姓少孤家貧冬常無袴過其妻兄柳孚宿其明無何著孚袴去故時人謂之通健"
        }
      ],
      "text": "魏畧曰逵世為著姓少孤家貧冬常無袴過其妻兄柳孚宿其明無何著孚袴去故時人謂之通健"
    },
    {
      "key": "full003",
      "layer": "received_biography",
      "raw_window": [
        5,
        11
      ],
      "raw_runs": [
        {
          "raw_line": 5,
          "raw_start": 0,
          "raw_end": 4,
          "start": 0,
          "end": 4,
          "surface": "初為郡吏"
        },
        {
          "raw_line": 6,
          "raw_start": 0,
          "raw_end": 21,
          "start": 4,
          "end": 25,
          "surface": "守絳邑長郭援之攻河東所經城邑皆下逵堅守援攻"
        },
        {
          "raw_line": 7,
          "raw_start": 0,
          "raw_end": 21,
          "start": 25,
          "end": 46,
          "surface": "之不拔乃召單于并軍急攻之城將潰絳父老與援要"
        },
        {
          "raw_line": 8,
          "raw_start": 0,
          "raw_end": 21,
          "start": 46,
          "end": 67,
          "surface": "不害逵絳人既潰援聞逵名欲使為將以兵刼之逵不"
        },
        {
          "raw_line": 9,
          "raw_start": 0,
          "raw_end": 21,
          "start": 67,
          "end": 88,
          "surface": "動左右引逵使叩頭逵叱之曰安有國家長吏為賊叩"
        },
        {
          "raw_line": 10,
          "raw_start": 0,
          "raw_end": 21,
          "start": 88,
          "end": 109,
          "surface": "頭援怒將斬之絳吏民聞將殺逵皆乘城呼曰負要殺"
        },
        {
          "raw_line": 11,
          "raw_start": 0,
          "raw_end": 17,
          "start": 109,
          "end": 126,
          "surface": "我賢君寧俱死耳左右義逵多為請遂得免"
        }
      ],
      "text": "初為郡吏守絳邑長郭援之攻河東所經城邑皆下逵堅守援攻之不拔乃召單于并軍急攻之城將潰絳父老與援要不害逵絳人既潰援聞逵名欲使為將以兵刼之逵不動左右引逵使叩頭逵叱之曰安有國家長吏為賊叩頭援怒將斬之絳吏民聞將殺逵皆乘城呼曰負要殺我賢君寧俱死耳左右義逵多為請遂得免"
    },
    {
      "key": "full004",
      "layer": "pei_annotation",
      "raw_window": [
        12,
        15
      ],
      "raw_runs": [
        {
          "raw_line": 12,
          "raw_start": 0,
          "raw_end": 7,
          "start": 0,
          "end": 7,
          "surface": "魏畧曰援得逵逵"
        },
        {
          "raw_line": 13,
          "raw_start": 0,
          "raw_end": 42,
          "start": 7,
          "end": 49,
          "surface": "不肯拜謂援曰王府君臨郡積年不知足下曷為者也援怒曰促斬之諸將覆護乃囚於壺關閉著土窖中以"
        },
        {
          "raw_line": 14,
          "raw_start": 0,
          "raw_end": 42,
          "start": 49,
          "end": 91,
          "surface": "車輪蓋上使人固守方將殺之逵從窖中謂守者曰此間無健兒邪而當使義士死此中乎時有祝公道者與"
        },
        {
          "raw_line": 15,
          "raw_start": 0,
          "raw_end": 30,
          "start": 91,
          "end": 121,
          "surface": "逵非故人而適聞其言憐其守正危厄乃夜盜往引出折械遣去不語其名姓"
        }
      ],
      "text": "魏畧曰援得逵逵不肯拜謂援曰王府君臨郡積年不知足下曷為者也援怒曰促斬之諸將覆護乃囚於壺關閉著土窖中以車輪蓋上使人固守方將殺之逵從窖中謂守者曰此間無健兒邪而當使義士死此中乎時有祝公道者與逵非故人而適聞其言憐其守正危厄乃夜盜往引出折械遣去不語其名姓"
    },
    {
      "key": "full006",
      "layer": "received_biography",
      "raw_window": [
        16,
        20
      ],
      "raw_runs": [
        {
          "raw_line": 16,
          "raw_start": 0,
          "raw_end": 6,
          "start": 0,
          "end": 6,
          "surface": "初逵過皮氏曰"
        },
        {
          "raw_line": 17,
          "raw_start": 0,
          "raw_end": 21,
          "start": 6,
          "end": 27,
          "surface": "爭地先據者勝及圍急知不免乃使人間行送印綬歸"
        },
        {
          "raw_line": 18,
          "raw_start": 0,
          "raw_end": 21,
          "start": 27,
          "end": 48,
          "surface": "郡旦日急據皮氏援既并絳衆將進兵逵恐其先得皮"
        },
        {
          "raw_line": 19,
          "raw_start": 0,
          "raw_end": 21,
          "start": 48,
          "end": 69,
          "surface": "氏乃以他計疑援謀人祝奧援由是留七日郡從逵言"
        },
        {
          "raw_line": 20,
          "raw_start": 0,
          "raw_end": 4,
          "start": 69,
          "end": 73,
          "surface": "故得無敗"
        }
      ],
      "text": "初逵過皮氏曰爭地先據者勝及圍急知不免乃使人間行送印綬歸郡旦日急據皮氏援既并絳衆將進兵逵恐其先得皮氏乃以他計疑援謀人祝奧援由是留七日郡從逵言故得無敗"
    },
    {
      "key": "full007",
      "layer": "pei_annotation",
      "raw_window": [
        21,
        23
      ],
      "raw_runs": [
        {
          "raw_line": 21,
          "raw_start": 0,
          "raw_end": 34,
          "start": 0,
          "end": 34,
          "surface": "孫資別傳曰資舉河東計吏到許薦於相府曰逵在絳邑帥厲吏民與賊郭援交戰力盡"
        },
        {
          "raw_line": 22,
          "raw_start": 0,
          "raw_end": 42,
          "start": 34,
          "end": 76,
          "surface": "而敗為賊所停挺然直志顏辭不屈忠言聞於大衆烈節顯於當時雖古之直髮〓鼎何以加也其才兼文武"
        },
        {
          "raw_line": 23,
          "raw_start": 0,
          "raw_end": 5,
          "start": 76,
          "end": 81,
          "surface": "誠時之利用"
        }
      ],
      "text": "孫資別傳曰資舉河東計吏到許薦於相府曰逵在絳邑帥厲吏民與賊郭援交戰力盡而敗為賊所停挺然直志顏辭不屈忠言聞於大衆烈節顯於當時雖古之直髮〓鼎何以加也其才兼文武誠時之利用"
    },
    {
      "key": "full008",
      "layer": "pei_annotation",
      "raw_window": [
        24,
        25
      ],
      "raw_runs": [
        {
          "raw_line": 24,
          "raw_start": 0,
          "raw_end": 38,
          "start": 0,
          "end": 38,
          "surface": "魏畧曰郭援討破後逵乃知前出己者為祝公道公道河南人也後坐他事當伏法逵救之力不能"
        },
        {
          "raw_line": 25,
          "raw_start": 0,
          "raw_end": 6,
          "start": 38,
          "end": 44,
          "surface": "解為之改服焉"
        }
      ],
      "text": "魏畧曰郭援討破後逵乃知前出己者為祝公道公道河南人也後坐他事當伏法逵救之力不能解為之改服焉"
    },
    {
      "key": "full009",
      "layer": "received_biography",
      "raw_window": [
        26,
        35
      ],
      "raw_runs": [
        {
          "raw_line": 26,
          "raw_start": 0,
          "raw_end": 18,
          "start": 0,
          "end": 18,
          "surface": "後舉茂才除澠池令高幹之反張琰將舉兵以"
        },
        {
          "raw_line": 27,
          "raw_start": 0,
          "raw_end": 21,
          "start": 18,
          "end": 39,
          "surface": "應之逵不知其謀往見琰聞變起欲還恐見執乃為琰"
        },
        {
          "raw_line": 28,
          "raw_start": 0,
          "raw_end": 21,
          "start": 39,
          "end": 60,
          "surface": "畫計如與同謀者琰信之時縣寄治蠶城城塹不固逵"
        },
        {
          "raw_line": 29,
          "raw_start": 0,
          "raw_end": 21,
          "start": 60,
          "end": 81,
          "surface": "從琰求兵修城諸欲為亂者皆不隱其謀故逵得盡誅"
        },
        {
          "raw_line": 30,
          "raw_start": 0,
          "raw_end": 21,
          "start": 81,
          "end": 102,
          "surface": "之遂修城拒琰琰敗逵以喪祖父去官司徒辟為掾以"
        },
        {
          "raw_line": 31,
          "raw_start": 0,
          "raw_end": 21,
          "start": 102,
          "end": 123,
          "surface": "議郎參司隸軍事太祖征馬超至弘農曰此西道之要"
        },
        {
          "raw_line": 32,
          "raw_start": 0,
          "raw_end": 21,
          "start": 123,
          "end": 144,
          "surface": "以逵領弘農太守召見計事大悅之謂左右曰使天下"
        },
        {
          "raw_line": 33,
          "raw_start": 0,
          "raw_end": 21,
          "start": 144,
          "end": 165,
          "surface": "二千石悉如賈逵吾何憂其後發兵逵疑屯田都尉藏"
        },
        {
          "raw_line": 34,
          "raw_start": 0,
          "raw_end": 21,
          "start": 165,
          "end": 186,
          "surface": "士民都尉自以不屬郡言語不順逵怒收之數以罪撾"
        },
        {
          "raw_line": 35,
          "raw_start": 0,
          "raw_end": 16,
          "start": 186,
          "end": 202,
          "surface": "折脚坐免然太祖心善逵以為丞相主簿"
        }
      ],
      "text": "後舉茂才除澠池令高幹之反張琰將舉兵以應之逵不知其謀往見琰聞變起欲還恐見執乃為琰畫計如與同謀者琰信之時縣寄治蠶城城塹不固逵從琰求兵修城諸欲為亂者皆不隱其謀故逵得盡誅之遂修城拒琰琰敗逵以喪祖父去官司徒辟為掾以議郎參司隸軍事太祖征馬超至弘農曰此西道之要以逵領弘農太守召見計事大悅之謂左右曰使天下二千石悉如賈逵吾何憂其後發兵逵疑屯田都尉藏士民都尉自以不屬郡言語不順逵怒收之數以罪撾折脚坐免然太祖心善逵以為丞相主簿"
    },
    {
      "key": "full011",
      "layer": "pei_annotation",
      "raw_window": [
        36,
        43
      ],
      "raw_runs": [
        {
          "raw_line": 36,
          "raw_start": 0,
          "raw_end": 10,
          "start": 0,
          "end": 10,
          "surface": "魏畧曰太祖欲征吳而大"
        },
        {
          "raw_line": 37,
          "raw_start": 0,
          "raw_end": 42,
          "start": 10,
          "end": 52,
          "surface": "霖雨三軍多不願行太祖知其然恐外有諫者教曰今孤戒嚴未知所之有諫者死逵受教謂其同寮三主簿"
        },
        {
          "raw_line": 38,
          "raw_start": 0,
          "raw_end": 42,
          "start": 52,
          "end": 94,
          "surface": "曰今實不可出而教如此不可不諫也乃建諫草以示二人二人不獲已皆署名入白事太祖怒收逵等當送"
        },
        {
          "raw_line": 39,
          "raw_start": 0,
          "raw_end": 42,
          "start": 94,
          "end": 136,
          "surface": "獄取造意者逵即言我造意遂走詣獄獄吏以逵主簿也不即著械謂獄吏曰促械我尊者且疑我在近職求"
        },
        {
          "raw_line": 40,
          "raw_start": 0,
          "raw_end": 42,
          "start": 136,
          "end": 178,
          "surface": "緩於卿今將遣人來察我逵著械適訖而太祖果遣家中人就獄視逵既而教曰逵無惡意原復其職始逵為"
        },
        {
          "raw_line": 41,
          "raw_start": 0,
          "raw_end": 42,
          "start": 178,
          "end": 220,
          "surface": "諸生略覽大義取其可用最好春秋左傳及為牧守常自課讀之月常一遍逵前在弘農與典農校尉爭公事"
        },
        {
          "raw_line": 42,
          "raw_start": 0,
          "raw_end": 42,
          "start": 220,
          "end": 262,
          "surface": "不得理乃發憤生瘻後所病稍大自啓願欲令醫割之太祖惜逵忠恐其不活教諫止簿吾聞十人割瘻九人"
        },
        {
          "raw_line": 43,
          "raw_start": 0,
          "raw_end": 17,
          "start": 262,
          "end": 279,
          "surface": "死逵猶行其意而瘻愈逵本名衢後改為逵"
        }
      ],
      "text": "魏畧曰太祖欲征吳而大霖雨三軍多不願行太祖知其然恐外有諫者教曰今孤戒嚴未知所之有諫者死逵受教謂其同寮三主簿曰今實不可出而教如此不可不諫也乃建諫草以示二人二人不獲已皆署名入白事太祖怒收逵等當送獄取造意者逵即言我造意遂走詣獄獄吏以逵主簿也不即著械謂獄吏曰促械我尊者且疑我在近職求緩於卿今將遣人來察我逵著械適訖而太祖果遣家中人就獄視逵既而教曰逵無惡意原復其職始逵為諸生略覽大義取其可用最好春秋左傳及為牧守常自課讀之月常一遍逵前在弘農與典農校尉爭公事不得理乃發憤生瘻後所病稍大自啓願欲令醫割之太祖惜逵忠恐其不活教諫止簿吾聞十人割瘻九人死逵猶行其意而瘻愈逵本名衢後改為逵"
    },
    {
