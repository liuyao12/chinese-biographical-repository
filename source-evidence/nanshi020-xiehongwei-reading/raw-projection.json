          "raw_end": 21,
          "start": 0,
          "end": 8,
          "surface": "𢎞微少孤事兄如父"
        },
        {
          "raw_line": 75,
          "raw_start": 0,
          "raw_end": 21,
          "start": 8,
          "end": 29,
          "surface": "友睦之至舉世莫及口不言人短見兄曜好藏否人物"
        },
        {
          "raw_line": 76,
          "raw_start": 0,
          "raw_end": 8,
          "start": 29,
          "end": 37,
          "surface": "每聞之常亂以他語"
        }
      ],
      "text": "𢎞微少孤事兄如父友睦之至舉世莫及口不言人短見兄曜好藏否人物每聞之常亂以他語",
      "text_sha256": "db06daf334f8fee21c52ef1b3bdc3bb5235bcac7d407a1477a7a592c1b2a42a6"
    },
