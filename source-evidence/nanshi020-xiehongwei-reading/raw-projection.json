      ],
      "raw_runs": [
        {
          "raw_line": 63,
          "raw_start": 19,
          "raw_end": 21,
          "start": 0,
          "end": 2,
          "surface": "文帝"
        },
        {
          "raw_line": 64,
          "raw_start": 0,
          "raw_end": 21,
          "start": 2,
          "end": 23,
          "surface": "初封宜都王鎭江陵以琅邪王球為友𢎞微為文學母"
        },
        {
          "raw_line": 65,
          "raw_start": 0,
          "raw_end": 21,
          "start": 23,
          "end": 44,
          "surface": "憂去職居䘮以孝稱服闋蔬素踰時文帝即位為黄門"
        },
        {
          "raw_line": 66,
          "raw_start": 0,
          "raw_end": 21,
          "start": 44,
          "end": 65,
          "surface": "侍郎與王華王曇首殷景仁劉湛等號曰五臣遷尚書"
        },
        {
          "raw_line": 67,
          "raw_start": 0,
          "raw_end": 21,
          "start": 65,
          "end": 86,
          "surface": "吏部郎參機密尋轉右衛将軍諸故吏臣佐並委𢎞微"
        },
        {
          "raw_line": 68,
          "raw_start": 0,
          "raw_end": 19,
          "start": 86,
          "end": 105,
          "surface": "選擬居身清約器服不華而飲食滋味盡其豐美"
        }
      ],
      "text": "文帝初封宜都王鎭江陵以琅邪王球為友𢎞微為文學母憂去職居䘮以孝稱服闋蔬素踰時文帝即位為黄門侍郎與王華王曇首殷景仁劉湛等號曰五臣遷尚書吏部郎參機密尋轉右衛将軍諸故吏臣佐並委𢎞微選擬居身清約器服不華而飲食滋味盡其豐美",
      "text_sha256": "6d5027796310ef922711ad9b39cacaffbef928c4f75ac7b9b94da90ad980f87d"
    },
    {
