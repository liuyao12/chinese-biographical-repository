      "kind": "received_sentence",
      "person_id": "zz1_0tr_xni_A",
      "source_quote": "齊初，起家奉朝請。",
      "reading": "齊初起家奉朝請。",
      "note": "齊初起家奉朝請。",
      "paragraph_id": "c-liangshu-028-xiahoudan-complete:p001",
