      "kind": "received_sentence",
      "person_id": "zz1_0tr_xni_A",
      "source_quote": "宗人夏侯溢爲衡陽內史，辭日，亶侍御坐，高祖謂亶曰：「夏侯溢於卿疏近？」",
      "reading": "同宗夏侯溢為衡陽內史，辭行日武帝問二人親疏。",
      "note": "同宗夏侯溢為衡陽內史，辭行日武帝問二人親疏。",
      "paragraph_id": "c-liangshu-028-xiahoudan-complete:p003",
      "start_codepoint": 24,
      "end_codepoint": 59,
      "human_reviewed": false
    },
