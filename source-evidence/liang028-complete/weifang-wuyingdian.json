{
  "edition": "清乾隆四年武英殿刻《二十四史》第一百六十六冊《梁書》，中國國家圖書館藏，善本書號09753",
  "book_id": "NLC892-411999017142-12657",
  "catalogue_revision": 902340163,
  "permalink": "https://commons.wikimedia.org/w/index.php?oldid=902340163",
  "original_url": "https://upload.wikimedia.org/wikipedia/commons/0/09/NLC892-411999017142-12657_%E4%BA%8C%E5%8D%81%E5%9B%9B%E5%8F%B2_%E7%AC%AC166%E5%86%8A.pdf",
  "pdf_sha1": "b11514da8e27fc149ba1ddc8e42a71bd01cd4e25",
  "pdf_sha256": "82c750b714c7e5513ff512f69a324b7e8fc8cb561f255a17e664c6aac45fd932",
  "pdf_bytes": 31214377,
  "column_order": "十一上第三欄至十二下第三欄。",
  "columns": [
    {
      "pdf_page": 99,
      "half": "左",
      "leaf": "十一上",
      "column_from_right": 3,
      "text": "韋放字元直車騎將軍叡之子初為齊晉安王寧朔迎"
    },
    {
      "pdf_page": 99,
      "half": "左",
      "leaf": "十一上",
      "column_from_right": 4,
      "text": "主簿高祖臨雍州又召為主簿放身長七尺七寸腰帶"
    },
    {
      "pdf_page": 99,
      "half": "左",
      "leaf": "十一上",
      "column_from_right": 5,
      "text": "八圍容貌甚偉天監元年為盱眙太守還除通直郎尋"
    },
    {
      "pdf_page": 99,
      "half": "左",
      "leaf": "十一上",
      "column_from_right": 6,
      "text": "為輕車晉安王中兵參軍遷鎭右始興王咨議參軍以"
    },
    {
      "pdf_page": 99,
      "half": "左",
      "leaf": "十一上",
      "column_from_right": 7,
      "text": "父憂去職服闋襲封永昌縣侯出為輕車南平王長史"
    },
    {
      "pdf_page": 99,
      "half": "左",
      "leaf": "十一上",
      "column_from_right": 8,
      "text": "襄陽太守轉假節明威將軍竟陵太守在郡和理為吏"
    },
    {
      "pdf_page": 99,
      "half": "左",
      "leaf": "十一上",
      "column_from_right": 9,
      "text": "民所稱六年大舉北伐以放為貞威將軍與胡龍牙會"
    },
    {
      "pdf_page": 99,
      "half": "左",
      "leaf": "十一上",
      "column_from_right": 10,
      "text": "曹仲宗進軍七年夏侯亶攻黎漿不克高祖復使帥軍"
    },
    {
      "pdf_page": 100,
      "half": "右",
      "leaf": "十一下",
      "column_from_right": 1,
      "text": "自北道會夀春城尋遷雲麾南康王長史尋陽太守放"
    },
    {
      "pdf_page": 100,
      "half": "右",
      "leaf": "十一下",
      "column_from_right": 2,
      "text": "累為藩佐並著聲績普通八年高祖遣兼領軍曹仲宗"
    },
    {
      "pdf_page": 100,
      "half": "右",
      "leaf": "十一下",
      "column_from_right": 3,
      "text": "等攻渦陽又以放為明威將軍帥師會之魏大將費穆"
    },
    {
      "pdf_page": 100,
      "half": "右",
      "leaf": "十一下",
      "column_from_right": 4,
      "text": "帥衆奄至放軍營未立麾下止有二百餘人放從弟洵"
    },
    {
      "pdf_page": 100,
      "half": "右",
      "leaf": "十一下",
      "column_from_right": 5,
      "text": "驍果有勇力一軍所仗放令洵單騎擊刺屢折魏軍洵"
    },
    {
      "pdf_page": 100,
      "half": "右",
      "leaf": "十一下",
      "column_from_right": 6,
      "text": "馬亦被傷不能進放胄又三貫流矢衆皆失色請放突"
    },
    {
      "pdf_page": 100,
      "half": "右",
      "leaf": "十一下",
      "column_from_right": 7,
      "text": "去放厲聲叱之曰今日唯有死耳乃免胄下馬據胡牀"
    },
    {
      "pdf_page": 100,
      "half": "右",
      "leaf": "十一下",
      "column_from_right": 8,
      "text": "處分於是士皆殊死戰莫不一當百魏軍遂退放逐北"
    },
    {
      "pdf_page": 100,
      "half": "右",
      "leaf": "十一下",
      "column_from_right": 9,
      "text": "至渦陽魏又遣常山王元昭大將軍李獎乞佛寶費穆"
    },
    {
      "pdf_page": 100,
      "half": "右",
      "leaf": "十一下",
      "column_from_right": 10,
      "text": "等衆五萬來援放率所督將陳度趙伯超等夾擊大破"
    },
    {
      "pdf_page": 100,
      "half": "左",
      "leaf": "十二上",
      "column_from_right": 1,
      "text": "之渦陽城主王偉以城降放乃登城簡出降口四千二"
    },
    {
      "pdf_page": 100,
      "half": "左",
      "leaf": "十二上",
      "column_from_right": 2,
      "text": "百人器仗充牣又遣降人三十分報李獎費穆等魏人"
    },
    {
      "pdf_page": 100,
      "half": "左",
      "leaf": "十二上",
      "column_from_right": 3,
      "text": "棄諸營壘一時奔潰衆軍乘之斬獲略盡擒穆弟超并"
    },
    {
      "pdf_page": 100,
      "half": "左",
      "leaf": "十二上",
      "column_from_right": 4,
      "text": "王偉送於京師還為太子右衞率轉通直散騎常侍出"
    },
    {
      "pdf_page": 100,
      "half": "左",
      "leaf": "十二上",
      "column_from_right": 5,
      "text": "為持節督梁南秦二州諸軍事信武將軍梁南秦二州"
    },
    {
      "pdf_page": 100,
      "half": "左",
      "leaf": "十二上",
      "column_from_right": 6,
      "text": "刺史中大通二年徙督北徐州諸軍事北徐州刺史增"
    },
    {
      "pdf_page": 100,
      "half": "左",
      "leaf": "十二上",
      "column_from_right": 7,
      "text": "封四百戶持節將軍如故在鎭三年卒時年五十九諡"
    },
    {
      "pdf_page": 100,
      "half": "左",
      "leaf": "十二上",
      "column_from_right": 8,
      "text": "曰宜侯放性弘厚篤實輕財好施於諸弟尤雍睦每將"
    },
    {
      "pdf_page": 100,
      "half": "左",
      "leaf": "十二上",
      "column_from_right": 9,
      "text": "遠別及行役初還常同一室臥起時稱為三姜初放與"
    },
    {
      "pdf_page": 100,
      "half": "左",
      "leaf": "十二上",
      "column_from_right": 10,
      "text": "吳郡張率皆有側室懷孕因指為婚姻其後各産男女"
    },
    {
      "pdf_page": 101,
      "half": "右",
      "leaf": "十二下",
      "column_from_right": 1,
      "text": "未及成長而率亡遺嗣孤弱放常贍恤之及為北徐州"
    },
    {
      "pdf_page": 101,
      "half": "右",
      "leaf": "十二下",
      "column_from_right": 2,
      "text": "時有勢族請姻者放曰吾不失信於故友乃以息岐娶"
    },
    {
      "pdf_page": 101,
      "half": "右",
      "leaf": "十二下",
      "column_from_right": 3,
      "text": "率女又以女適率子時稱放能篤舊長子粲嗣別有傳"
    }
  ],
  "comparisons": [
