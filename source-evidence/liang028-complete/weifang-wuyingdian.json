  "volume_endnotes": [
    {
      "pdf_page": 101,
      "half": "左",
      "columns": [
        6,
        7,
        8,
        9,
        10
      ],
      "text": "韋放傳普通八年高祖遣兼領軍曹仲宗等攻渦陽又以放為明威將軍帥師會之○普通八年南史作大通元年臣人龍按高祖本紀大通元年冬十月庚戌魏東豫州刺史元慶和以渦陽內屬不載放帥師會仲宗事蓋兩書所以互異者普通改大通在是年三"
    },
    {
      "pdf_page": 102,
      "half": "右",
      "columns": [
        1,
        2
      ],
      "text": "月間故或作普通八年或作大通元年而放之帥師或又在未改元前也"
    }
  ]
}
