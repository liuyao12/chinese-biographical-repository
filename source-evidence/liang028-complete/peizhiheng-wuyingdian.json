  "original_url": "https://upload.wikimedia.org/wikipedia/commons/0/09/NLC892-411999017142-12657_%E4%BA%8C%E5%8D%81%E5%9B%9B%E5%8F%B2_%E7%AC%AC166%E5%86%8A.pdf",
  "pdf_sha1": "b11514da8e27fc149ba1ddc8e42a71bd01cd4e25",
  "pdf_sha256": "82c750b714c7e5513ff512f69a324b7e8fc8cb561f255a17e664c6aac45fd932",
  "pdf_bytes": 31214377,
  "column_order": "五上第五欄起至六上第六欄。",
  "columns": [
    {
      "pdf_page": 93,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 5,
      "text": "之橫字如岳之高第十三弟也少好賓遊重氣俠不事"
    },
    {
      "pdf_page": 93,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 6,
      "text": "產業之高以其縱誕乃為狹被蔬食以激厲之之橫歎"
    },
    {
      "pdf_page": 93,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 7,
      "text": "曰大丈夫富貴必作百幅被遂與僮屬數百人於芍陂"
    },
    {
      "pdf_page": 93,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 8,
      "text": "大營田墅遂致殷積太宗在東宮聞而要之以為河東"
    },
    {
      "pdf_page": 93,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 9,
      "text": "王常侍直殿主帥遷直閤將軍侯景亂出為貞威將軍"
    },
    {
      "pdf_page": 93,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 10,
      "text": "隷鄱陽王範討景景濟江仍與範長子嗣入援連營度"
    },
    {
      "pdf_page": 94,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 1,
      "text": "淮據東城京都陷退還合肥與範泝流赴湓城景遣任"
    },
    {
      "pdf_page": 94,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 2,
      "text": "約上逼晉熙範令之橫下援未及至範薨之橫乃還時"
    },
    {
      "pdf_page": 94,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 3,
      "text": "尋陽王大心在江州範副梅思立密要大心襲湓城之"
    },
    {
      "pdf_page": 94,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 4,
      "text": "橫斬思立而拒大心大心以州降景之橫率衆與兄之"
    },
    {
      "pdf_page": 94,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 5,
      "text": "高同歸元帝承制除散騎常侍廷尉卿出為河東內史"
    },
    {
      "pdf_page": 94,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 6,
      "text": "又隨王僧辯拒侯景於巴陵景退遷持節平北將軍東"
    },
    {
      "pdf_page": 94,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 7,
      "text": "徐州刺史中護軍封豫寧侯邑三千戶又隨僧辯追景"
    },
    {
      "pdf_page": 94,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 8,
      "text": "平郢魯江晉等州恒為前鋒陷陣仍至石頭破景景東"
    },
    {
      "pdf_page": 94,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 9,
      "text": "奔僧辯令之橫與杜崱入守臺城及陸納據湘州叛又"
    },
    {
      "pdf_page": 94,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 10,
      "text": "隷王僧辯南討焉於陣斬納將李賢明遂平之又破武"
    },
    {
      "pdf_page": 94,
      "half": "左",
      "leaf": "六上",
      "column_from_right": 1,
      "text": "陵王於硤口還除吳興太守乃作百幅被以成其初志"
    },
    {
      "pdf_page": 94,
      "half": "左",
      "leaf": "六上",
      "column_from_right": 2,
      "text": "後江陵陷齊遣上黨王高渙挾貞陽侯攻東關晉安王"
    },
    {
      "pdf_page": 94,
      "half": "左",
      "leaf": "六上",
      "column_from_right": 3,
      "text": "綱承制以之橫為使持節鎮北將軍徐州刺史都督衆"
    },
    {
      "pdf_page": 94,
      "half": "左",
      "leaf": "六上",
      "column_from_right": 4,
      "text": "軍給鼓吹一部出守蘄城之橫營壘未周而魏軍大至"
    },
    {
      "pdf_page": 94,
      "half": "左",
      "leaf": "六上",
      "column_from_right": 5,
      "text": "兵盡矢窮遂於陣沒時年四十一贈侍中司空諡曰忠"
    },
    {
      "pdf_page": 94,
      "half": "左",
      "leaf": "六上",
      "column_from_right": 6,
      "text": "壯子鳳寶嗣"
    }
  ],
  "comparisons": [
    {
      "locator": "五上第五欄",
