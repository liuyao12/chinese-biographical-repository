      "human_reviewed": false
    },
    {
      "id": "c-liangshu-028-xiahoukui-complete:received_sentence4-279",
      "kind": "received_sentence",
      "person_id": "zz1_0tr_xni_B",
      "source_quote": "大同四年，卒于州，時年五十六。",
      "reading": "大同四年卒於州，原報五十六。",
      "note": "大同四年卒於州，原報五十六。",
      "paragraph_id": "c-liangshu-028-xiahoukui-complete:p004",
      "start_codepoint": 279,
      "end_codepoint": 294,
      "human_reviewed": false
    },
    {
      "id": "c-liangshu-028-xiahoukui-complete:received_sentence4-294",
      "kind": "received_sentence",
      "person_id": "zz1_0tr_xni_B",
      "source_quote": "有詔舉哀，賻錢二十萬，布二百匹。",
      "reading": "詔舉哀及賻贈。",
      "note": "詔舉哀及賻贈。",
      "paragraph_id": "c-liangshu-028-xiahoukui-complete:p004",
