      "end_codepoint": 197,
      "human_reviewed": false
    },
    {
      "id": "c-liangshu-028-xiahoukui-complete:received_sentence2-0",
      "kind": "received_sentence",
      "person_id": "zz1_0tr_xni_B",
      "source_quote": "八年，敕夔帥壯武將軍裴之禮、直閤將軍任思祖出義陽道，攻平靜、穆陵、陰山三關，克之。",
      "reading": "八年從義陽道攻三關。梁武紀繫大通元年正月。",
      "note": "八年從義陽道攻三關。梁武紀繫大通元年正月。",
      "paragraph_id": "c-liangshu-028-xiahoukui-complete:p002",
