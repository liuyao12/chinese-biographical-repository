      "kind": "received_sentence",
      "person_id": "zz1_0tr_xni_B",
      "source_quote": "中興初，遷司徒屬。",
      "reading": "齊和帝中興初任司徒屬。",
      "note": "齊和帝中興初任司徒屬。",
      "paragraph_id": "c-liangshu-028-xiahoukui-complete:p001",
