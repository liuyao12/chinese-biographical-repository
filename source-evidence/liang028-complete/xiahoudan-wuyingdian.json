  "original_url": "https://upload.wikimedia.org/wikipedia/commons/0/09/NLC892-411999017142-12657_%E4%BA%8C%E5%8D%81%E5%9B%9B%E5%8F%B2_%E7%AC%AC166%E5%86%8A.pdf",
  "pdf_sha1": "b11514da8e27fc149ba1ddc8e42a71bd01cd4e25",
  "pdf_sha256": "82c750b714c7e5513ff512f69a324b7e8fc8cb561f255a17e664c6aac45fd932",
  "pdf_bytes": 31214377,
  "column_order": "六上第七欄至九下第一欄。",
  "columns": [
    {
      "pdf_page": 94,
      "half": "左",
      "leaf": "六上",
      "column_from_right": 7,
      "text": "夏侯亶字世龍車騎將軍詳長子也齊初起家奉朝請"
    },
    {
      "pdf_page": 94,
      "half": "左",
      "leaf": "六上",
      "column_from_right": 8,
      "text": "永元末詳為西中郎南康王司馬隨府鎮荆州亶留京"
    },
    {
      "pdf_page": 94,
      "half": "左",
      "leaf": "六上",
      "column_from_right": 9,
      "text": "師為東昏聽政主帥及崔惠景作亂亶以捍禦功除驍"
    },
    {
      "pdf_page": 94,
      "half": "左",
      "leaf": "六上",
      "column_from_right": 10,
      "text": "騎將軍及高祖起師詳與長史蕭穎胄協同義舉密遣"
    },
    {
      "pdf_page": 95,
      "half": "右",
      "leaf": "六下",
      "column_from_right": 1,
      "text": "信下都迎亶亶乃齎宣徳皇后令令南康王纂承大統"
    },
    {
      "pdf_page": 95,
      "half": "右",
      "leaf": "六下",
      "column_from_right": 2,
      "text": "封十郡為宣城王進位相國置僚屬選百官建康城平"
    },
    {
      "pdf_page": 95,
      "half": "右",
      "leaf": "六下",
      "column_from_right": 3,
      "text": "以亶為尚書吏部郎俄遷侍中奉璽於高祖天監元年"
    },
    {
      "pdf_page": 95,
      "half": "右",
      "leaf": "六下",
      "column_from_right": 4,
      "text": "出為宣城太守尋入為散騎常侍領右驍騎將軍六年"
    },
    {
      "pdf_page": 95,
      "half": "右",
      "leaf": "六下",
      "column_from_right": 5,
      "text": "出為平西始興王長史南郡太守父憂解職居喪盡禮"
    },
    {
      "pdf_page": 95,
      "half": "右",
      "leaf": "六下",
      "column_from_right": 6,
      "text": "廬于墓側遺財悉推諸弟八年起為持節督司州諸軍"
    },
    {
      "pdf_page": 95,
      "half": "右",
      "leaf": "六下",
      "column_from_right": 7,
      "text": "事信武將軍司州刺史領安陸太守服闋襲封豐城縣"
    },
    {
      "pdf_page": 95,
      "half": "右",
      "leaf": "六下",
      "column_from_right": 8,
      "text": "公居州甚有威惠為邊人所悅服十二年以本號還朝"
    },
    {
      "pdf_page": 95,
      "half": "右",
      "leaf": "六下",
      "column_from_right": 9,
      "text": "除都官尚書遷給事中右衞將軍領豫州大中正十五"
    },
    {
      "pdf_page": 95,
      "half": "右",
      "leaf": "六下",
      "column_from_right": 10,
      "text": "年出為信武將軍安西長史江夏太守十七年入為通"
    },
    {
      "pdf_page": 95,
      "half": "左",
      "leaf": "七上",
      "column_from_right": 1,
      "text": "直散騎常侍太子右衞率遷左衞將軍領前軍將軍俄"
    },
    {
      "pdf_page": 95,
      "half": "左",
      "leaf": "七上",
      "column_from_right": 2,
      "text": "出為明威將軍吳興太守在郡復有惠政吏民圖其像"
    },
    {
      "pdf_page": 95,
      "half": "左",
      "leaf": "七上",
      "column_from_right": 3,
      "text": "立碑頌美焉普通三年入為散騎常侍領右驍騎將軍"
    },
    {
      "pdf_page": 95,
      "half": "左",
      "leaf": "七上",
      "column_from_right": 4,
      "text": "轉太府卿常侍如故以公事免未幾優詔復職五年遷"
    },
    {
      "pdf_page": 95,
      "half": "左",
      "leaf": "七上",
      "column_from_right": 5,
      "text": "中護軍六年大舉北伐先遣豫州刺史裴邃帥譙州刺"
    },
    {
      "pdf_page": 95,
      "half": "左",
      "leaf": "七上",
      "column_from_right": 6,
      "text": "史湛僧智歷陽太守明紹世南譙太守魚弘晉熙太守"
    },
    {
      "pdf_page": 95,
      "half": "左",
      "leaf": "七上",
      "column_from_right": 7,
      "text": "張澄並世之驍將自南道伐壽陽城未克而邃卒乃加"
    },
    {
      "pdf_page": 95,
      "half": "左",
      "leaf": "七上",
      "column_from_right": 8,
      "text": "亶使持節馳驛代邃與魏將河間王元琛臨淮王元彧"
    },
    {
      "pdf_page": 95,
      "half": "左",
      "leaf": "七上",
      "column_from_right": 9,
      "text": "等相拒頻戰克捷尋有密敕班師合肥以休士馬須堰"
    },
    {
      "pdf_page": 95,
      "half": "左",
      "leaf": "七上",
      "column_from_right": 10,
      "text": "成復進七年夏淮堰水盛壽陽城將没高祖復遣北道"
    },
    {
      "pdf_page": 96,
      "half": "右",
      "leaf": "七下",
      "column_from_right": 1,
      "text": "軍元樹帥彭寶孫陳慶之等稍進亶帥湛僧智魚弘張"
    },
    {
      "pdf_page": 96,
      "half": "右",
      "leaf": "七下",
      "column_from_right": 2,
      "text": "澄等通清流澗將入淮肥魏軍夾肥築城出亶軍後亶"
    },
    {
      "pdf_page": 96,
      "half": "右",
      "leaf": "七下",
      "column_from_right": 3,
      "text": "與僧智還襲破之進攻黎漿貞威將軍韋放自北道會"
    },
    {
      "pdf_page": 96,
      "half": "右",
      "leaf": "七下",
      "column_from_right": 4,
      "text": "焉兩軍既合所向皆降下凡降城五十二獲男女七萬"
    },
    {
      "pdf_page": 96,
      "half": "右",
      "leaf": "七下",
      "column_from_right": 5,
      "text": "五千人米二十萬石詔以壽陽依前代置豫州合肥鎮"
    },
    {
      "pdf_page": 96,
      "half": "右",
      "leaf": "七下",
      "column_from_right": 6,
      "text": "改為南豫州以亶為使持節都督豫州縁淮南豫霍義"
    },
    {
      "pdf_page": 96,
      "half": "右",
      "leaf": "七下",
      "column_from_right": 7,
      "text": "定五州諸軍事雲麾將軍豫南豫二州刺史壽春久罹"
    },
    {
      "pdf_page": 96,
      "half": "右",
      "leaf": "七下",
      "column_from_right": 8,
      "text": "兵荒百姓多流散亶輕刑薄賦務農省役頃之民戶充"
    },
    {
      "pdf_page": 96,
      "half": "右",
      "leaf": "七下",
      "column_from_right": 9,
      "text": "復大通二年進號平北將軍三年卒於州鎮高祖聞之"
    },
    {
      "pdf_page": 96,
      "half": "右",
      "leaf": "七下",
      "column_from_right": 10,
      "text": "卽日素服舉哀贈車騎將軍諡曰襄州民夏侯簡等五"
    },
    {
      "pdf_page": 96,
      "half": "左",
      "leaf": "八上",
      "column_from_right": 1,
      "text": "百人表請為亶立碑置祠詔許之亶為人美風儀寬厚"
    },
    {
      "pdf_page": 96,
      "half": "左",
      "leaf": "八上",
      "column_from_right": 2,
      "text": "有器量涉獵文史辯給能專對宗人夏侯溢為衡陽內"
    },
    {
      "pdf_page": 96,
      "half": "左",
      "leaf": "八上",
      "column_from_right": 3,
      "text": "史辭日亶侍御坐高祖謂亶曰夏侯溢於卿疏近亶荅"
    },
    {
      "pdf_page": 96,
      "half": "左",
      "leaf": "八上",
      "column_from_right": 4,
      "text": "曰是臣從弟高祖知溢於亶已疏乃曰卿傖人好不辨"
    },
    {
      "pdf_page": 96,
      "half": "左",
      "leaf": "八上",
      "column_from_right": 5,
      "text": "族從亶對曰臣聞服屬易疏所以不忍言族時以為能"
    },
    {
      "pdf_page": 96,
      "half": "左",
      "leaf": "八上",
      "column_from_right": 6,
      "text": "對亶歷為六郡三州不修產業祿賜所得隨散親故性"
    },
    {
      "pdf_page": 96,
      "half": "左",
      "leaf": "八上",
      "column_from_right": 7,
      "text": "儉率居處服用充足而已不事華侈晚年頗好音樂有"
    },
    {
      "pdf_page": 96,
      "half": "左",
      "leaf": "八上",
      "column_from_right": 8,
      "text": "妓妾十數人並無被服姿容每有客常隔簾奏之時謂"
    },
    {
      "pdf_page": 96,
      "half": "左",
      "leaf": "八上",
      "column_from_right": 9,
      "text": "簾為夏侯妓衣也亶二子誼損誼襲封豐城公歷官太"
    },
    {
      "pdf_page": 96,
      "half": "左",
      "leaf": "八上",
      "column_from_right": 10,
      "text": "子舍人洗馬太清中侯景入寇誼與弟損帥部曲入城"
    },
    {
      "pdf_page": 97,
      "half": "右",
      "leaf": "八下",
      "column_from_right": 1,
      "text": "並卒圍內"
    }
  ],
