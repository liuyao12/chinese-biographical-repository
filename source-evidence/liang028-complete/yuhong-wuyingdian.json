  "column_order": "十下第六欄至十一上第二欄。",
  "columns": [
    {
      "pdf_page": 99,
      "half": "右",
      "leaf": "十下",
      "column_from_right": 6,
      "text": "魚弘襄陽人身長八尺白皙美姿容累從征討常為軍"
    },
    {
      "pdf_page": 99,
      "half": "右",
      "leaf": "十下",
      "column_from_right": 7,
      "text": "鋒歷南譙盱眙竟陵太守常語人曰我為郡所謂四盡"
    },
    {
      "pdf_page": 99,
      "half": "右",
      "leaf": "十下",
      "column_from_right": 8,
      "text": "水中魚鱉盡山中麞鹿盡田中米穀盡村里民庶盡丈"
    },
    {
      "pdf_page": 99,
      "half": "右",
      "leaf": "十下",
      "column_from_right": 9,
      "text": "夫生世如輕塵栖弱草白駒之過隙平生但歡樂富貴"
    },
    {
      "pdf_page": 99,
      "half": "右",
      "leaf": "十下",
      "column_from_right": 10,
      "text": "幾何時於是恣意酣賞侍妾百餘人不勝金翠服翫車"
    },
    {
      "pdf_page": 99,
      "half": "左",
      "leaf": "十一上",
      "column_from_right": 1,
      "text": "馬皆窮一時之絕遷為平西湘東王司馬新興永寧二"
    },
    {
      "pdf_page": 99,
      "half": "左",
      "leaf": "十一上",
      "column_from_right": 2,
      "text": "郡太守卒官"
    }
  ],
