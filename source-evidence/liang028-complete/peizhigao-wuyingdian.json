  "pdf_sha1": "b11514da8e27fc149ba1ddc8e42a71bd01cd4e25",
  "pdf_sha256": "82c750b714c7e5513ff512f69a324b7e8fc8cb561f255a17e664c6aac45fd932",
  "pdf_bytes": 31214377,
  "column_order": "四上第三欄至四下第十欄。",
  "columns": [
    {
      "pdf_page": 92,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 3,
      "text": "之高字如山邃兄中散大夫髦之子也起家州從事新"
    },
    {
      "pdf_page": 92,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 4,
      "text": "都令奉朝請遷參軍頗讀書少負意氣常隨叔父邃征"
    },
    {
      "pdf_page": 92,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 5,
      "text": "討所在立功甚為邃所器重戎政咸以委焉壽陽之役"
    },
    {
      "pdf_page": 92,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 6,
      "text": "邃卒于軍所之高隷夏侯夔平壽陽仍除平北豫章長"
    },
    {
      "pdf_page": 92,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 7,
      "text": "史梁郡太守封都城縣男邑二百五十戶時魏汝陰來"
    },
    {
      "pdf_page": 92,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 8,
      "text": "附敕之高應接仍除假節飇勇將軍潁州刺史士民夜"
    },
    {
      "pdf_page": 92,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 9,
      "text": "反踰城而入之高率家僮與麾下奮擊賊乃散走父憂"
    },
    {
      "pdf_page": 92,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 10,
      "text": "還京起為光遠將軍合討陰陵盜賊平之以為譙州刺"
    },
    {
      "pdf_page": 93,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 1,
      "text": "史又還為左軍將軍出為南譙太守監北徐州遷員外"
    },
    {
      "pdf_page": 93,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 2,
      "text": "散騎常侍尋除雄信將軍西豫州刺史餘如故侯景亂"
    },
    {
      "pdf_page": 93,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 3,
      "text": "之高率衆入援南豫州刺史鄱陽嗣王範命之高總督"
    },
    {
      "pdf_page": 93,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 4,
      "text": "江右援軍諸軍事頓于張公洲柳仲禮至横江之高遣"
    },
    {
      "pdf_page": 93,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 5,
      "text": "船舸二百餘艘迎致仲禮與韋粲等俱會青塘立營據"
    },
    {
      "pdf_page": 93,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 6,
      "text": "建興苑及城陷之高還合肥與鄱陽王範西上稍至新"
    },
    {
      "pdf_page": 93,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 7,
      "text": "蔡衆將一萬未有所屬元帝遣蕭慧正召之以為侍中"
    },
    {
      "pdf_page": 93,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 8,
      "text": "護軍將軍到江陵承制除特進金紫光祿大夫卒時年"
    },
    {
      "pdf_page": 93,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 9,
      "text": "七十三贈侍中儀同三司鼓吹一部諡曰恭子幾累官"
    },
    {
      "pdf_page": 93,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 10,
      "text": "太子右衞率雋州刺史西魏攻陷江陵幾力戰死之"
    }
  ],
  "comparisons": [
    {
      "locator": "四上第十欄",
      "printed": "合討陰陵盜賊平之",
      "digital": "合討陰陵盜賊，平之",
      "note": "卷後考證引南史「令」。"
    },
    {
      "locator": "四下第九、十欄",
      "printed": "子幾累官太子右衞率雋州刺史西魏攻陷江陵幾力戰死之",
      "digital": "子畿，累官太子右衛率、雋州刺史。西魏攻陷江陵，畿力戰死之",
      "note": "殿本兩處無田，固定梁傳、南史子畿，元帝紀巂州刺史裴畿。"
    }
  ],
  "volume_endnotes": [
    {
      "pdf_page": 101,
      "half": "左",
      "column_from_right": 4,
      "text": "之高傳合討陰陵盜賊平之○合南史作令"
    }
  ]
}
