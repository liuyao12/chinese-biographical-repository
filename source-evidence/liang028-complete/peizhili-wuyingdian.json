  "column_order": "三下第四欄中起，至四上第二欄。三下第四欄前半為邃傳末。",
  "columns": [
    {
      "pdf_page": 92,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 4,
      "text": "子之禮字子義自國子生"
    },
    {
      "pdf_page": 92,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 5,
      "text": "推第補邵陵王國左常侍信威行參軍王為南兗除長"
    },
    {
      "pdf_page": 92,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 6,
      "text": "流參軍未行乃留宿衞補直閤將軍丁父憂服闋襲封"
    },
    {
      "pdf_page": 92,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 7,
      "text": "因請隨軍討壽陽除雲麾將軍遷散騎常侍又別攻魏"
    },
    {
      "pdf_page": 92,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 8,
      "text": "廣陵城平之除信武將軍西豫州刺史加輕車將軍除"
    },
    {
      "pdf_page": 92,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 9,
      "text": "黄門侍郎遷中軍宣城王司馬尋為都督北徐仁睢三"
    },
    {
      "pdf_page": 92,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 10,
      "text": "州諸軍事信武將軍北徐州刺史徵太子左衞率兼衞"
    },
    {
      "pdf_page": 92,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 1,
      "text": "尉卿轉少府卿卒諡曰壯子政承聖中官至給事黄門"
    },
    {
      "pdf_page": 92,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 2,
      "text": "侍郎江陵陷隨例入西魏"
    }
  ],
