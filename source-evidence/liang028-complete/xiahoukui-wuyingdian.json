  "original_url": "https://upload.wikimedia.org/wikipedia/commons/0/09/NLC892-411999017142-12657_%E4%BA%8C%E5%8D%81%E5%9B%9B%E5%8F%B2_%E7%AC%AC166%E5%86%8A.pdf",
  "pdf_sha1": "b11514da8e27fc149ba1ddc8e42a71bd01cd4e25",
  "pdf_sha256": "82c750b714c7e5513ff512f69a324b7e8fc8cb561f255a17e664c6aac45fd932",
  "pdf_bytes": 31214377,
  "column_order": "八下第二欄至十下第五欄前半。",
  "columns": [
    {
      "pdf_page": 97,
      "half": "右",
      "leaf": "八下",
      "column_from_right": 2,
      "text": "夔字季龍亶弟也起家齊南康王府行參軍中興初遷"
    },
    {
      "pdf_page": 97,
      "half": "右",
      "leaf": "八下",
      "column_from_right": 3,
      "text": "司徒屬天監元年為太子洗馬中舍人中書郎丁父憂"
    },
    {
      "pdf_page": 97,
      "half": "右",
      "leaf": "八下",
      "column_from_right": 4,
      "text": "服闋除大匠卿知造太極殿事普通元年為邵陵王信"
    },
    {
      "pdf_page": 97,
      "half": "右",
      "leaf": "八下",
      "column_from_right": 5,
      "text": "威長史行府國事其年出為假節征遠將軍隨機北討"
    },
    {
      "pdf_page": 97,
      "half": "右",
      "leaf": "八下",
      "column_from_right": 6,
      "text": "還除給事黃門侍郎二年副裴邃討義州平之三年代"
    },
    {
      "pdf_page": 97,
      "half": "右",
      "leaf": "八下",
      "column_from_right": 7,
      "text": "兄亶為吳興太守尋遷假節征遠將軍西陽武昌二郡"
    },
    {
      "pdf_page": 97,
      "half": "右",
      "leaf": "八下",
      "column_from_right": 8,
      "text": "太守七年徵為衞尉未拜改授持節督司州諸軍事信"
    },
    {
      "pdf_page": 97,
      "half": "右",
      "leaf": "八下",
      "column_from_right": 9,
      "text": "武將軍司州刺史領安陸太守八年敕夔帥壯武將軍"
    },
    {
      "pdf_page": 97,
      "half": "右",
      "leaf": "八下",
      "column_from_right": 10,
      "text": "裴之禮直閤將軍任思祖出義陽道攻平靜穆陵陰山"
    },
    {
      "pdf_page": 97,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 1,
      "text": "三關克之是時譙州刺史湛僧智圍魏東豫州刺史元"
    },
    {
      "pdf_page": 97,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 2,
      "text": "慶和於廣陵入其郛魏將元顯伯率軍赴援僧智逆擊"
    },
    {
      "pdf_page": 97,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 3,
      "text": "破之夔自武陽會僧智斷魏軍歸路慶和於內築柵以"
    },
    {
      "pdf_page": 97,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 4,
      "text": "自固及夔至遂請降夔讓僧智僧智曰慶和志欲降公"
    },
    {
      "pdf_page": 97,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 5,
      "text": "不願降僧智今往必乖其意且僧智所將為烏合募人不"
    },
    {
      "pdf_page": 97,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 6,
      "text": "可御之以法公持軍素嚴必無犯令受降納附深得其"
    },
    {
      "pdf_page": 97,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 7,
      "text": "宜於是夔乃登城拔魏幟建官軍旗鼓衆莫敢妄動慶"
    },
    {
      "pdf_page": 97,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 8,
      "text": "和束兵以出軍無私焉凡降男女口四萬餘人粟六十"
    },
    {
      "pdf_page": 97,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 9,
      "text": "萬斛餘物稱是顯伯聞之夜遁衆軍追之生擒二萬餘"
    },
    {
      "pdf_page": 97,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 10,
      "text": "人斬獲不可勝數詔以僧智領東豫州鎭廣陵夔引軍"
    },
    {
      "pdf_page": 98,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 1,
      "text": "屯安陽夔又遣偏將屠楚城盡俘其衆由是義陽北道"
    },
    {
      "pdf_page": 98,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 2,
      "text": "遂與魏絕二年魏郢州刺史元願達請降高祖敕郢州"
    },
    {
      "pdf_page": 98,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 3,
      "text": "刺史元樹往迎願達夔亦自楚城會之遂留鎭焉詔改"
    },
    {
      "pdf_page": 98,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 4,
      "text": "魏郢州為北司州以夔為刺史兼督司州三年遷使持"
    },
    {
      "pdf_page": 98,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 5,
      "text": "節進號仁威將軍封保城縣侯邑一千五百戶中大通"
    },
    {
      "pdf_page": 98,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 6,
      "text": "二年徵為右衞將軍丁所生母憂去職時魏南兗州刺"
    },
    {
      "pdf_page": 98,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 7,
      "text": "史劉明以譙城入附詔遣鎭北將軍元樹帥軍應接起"
    },
    {
      "pdf_page": 98,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 8,
      "text": "夔為雲麾將軍隨機北討尋授使持節督南豫州諸軍"
    },
    {
      "pdf_page": 98,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 9,
      "text": "事南豫州刺史六年轉使持節督豫淮陳潁建霍義七"
    },
    {
      "pdf_page": 98,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 10,
      "text": "州諸軍事豫州刺史豫州積歲寇戎人頗失業夔乃帥"
    },
    {
      "pdf_page": 98,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 1,
      "text": "軍人於蒼陵立堰漑田千餘頃歲收穀百餘萬石以充"
    },
    {
      "pdf_page": 98,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 2,
      "text": "儲備兼贍貧人境內賴之夔兄亶先經此任至是夔又"
    },
    {
      "pdf_page": 98,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 3,
      "text": "居焉兄弟竝有恩惠於鄉里百姓歌之曰我之有州頻"
    },
    {
      "pdf_page": 98,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 4,
      "text": "仍夏侯前兄後弟布政優優在州七年甚有聲績遠近"
    },
    {
      "pdf_page": 98,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 5,
      "text": "多附之有部曲萬人馬二千匹竝服習精強為當時之"
    },
    {
      "pdf_page": 98,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 6,
      "text": "盛性奢豪後房伎妾曳羅縠飾金翠者亦有百數愛好"
    },
    {
      "pdf_page": 98,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 7,
      "text": "人士不以貴勢自高文武賓客常滿坐時亦以此稱之"
    },
    {
      "pdf_page": 98,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 8,
      "text": "大同四年卒於州時年五十六有詔舉哀賻錢二十萬"
    },
    {
      "pdf_page": 98,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 9,
      "text": "布二百匹追贈侍中安北將軍諡曰桓子撰嗣官至太"
    },
    {
      "pdf_page": 98,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 10,
      "text": "僕卿撰弟譒少麤險薄行常停鄉里領其父部曲為州"
    },
    {
      "pdf_page": 99,
      "half": "右",
      "leaf": "十下",
      "column_from_right": 1,
      "text": "助防刺史蕭淵明引為府長史淵明彭城戰沒復為侯"
    },
    {
      "pdf_page": 99,
      "half": "右",
      "leaf": "十下",
      "column_from_right": 2,
      "text": "景長史景尋舉兵反譒前驅濟江頓兵城西士林館破"
    },
    {
      "pdf_page": 99,
      "half": "右",
      "leaf": "十下",
      "column_from_right": 3,
      "text": "掠邸第及居人富室子女財貨盡略有之淵明在州有"
    },
    {
      "pdf_page": 99,
      "half": "右",
      "leaf": "十下",
      "column_from_right": 4,
      "text": "四妾章於王阮竝有國色淵明沒魏其妾竝還京第譒"
    },
    {
      "pdf_page": 99,
      "half": "右",
      "leaf": "十下",
      "column_from_right": 5,
      "text": "至破第納焉"
    }
  ],
