  "chronology": [
    "「六年」「七年」處於普通北伐。梁武帝紀、夏侯亶傳有北伐、壽陽及二州原年可參。",
    "普通八年與大通元年同為527年。殿本考證記本紀在冬十月記元慶和內附，並提出韋放帥軍可能始於改元前。",
    "中大通二年徙北徐，傳稱在鎮三年而卒，存相對時距。南史略卒年與年齡。"
  ],
  "readings": [
    {
      "id": "c-liangshu-028-weifang-complete:received_sentence1-0",
      "kind": "received_sentence",
      "person_id": "axs_5y7_p7w_AAA",
      "source_quote": "韋放字元直，車騎將軍叡之子。",
      "reading": "韋放字元直，為車騎將軍韋叡子。",
      "note": "韋放字元直，為車騎將軍韋叡子。",
      "paragraph_id": "c-liangshu-028-weifang-complete:p001",
      "start_codepoint": 0,
      "end_codepoint": 14,
      "human_reviewed": false
    },
    {
      "id": "c-liangshu-028-weifang-complete:received_sentence1-14",
      "kind": "received_sentence",
      "person_id": "axs_5y7_p7w_AAA",
      "source_quote": "初爲齊晉安王寧朔迎主簿，高祖臨雍州，又召爲主簿。",
      "reading": "初任齊晉安王迎主簿。梁武帝臨雍州，又召為主簿。",
      "note": "初任齊晉安王迎主簿。梁武帝臨雍州，又召為主簿。",
      "paragraph_id": "c-liangshu-028-weifang-complete:p001",
      "start_codepoint": 14,
      "end_codepoint": 38,
      "human_reviewed": false
    },
    {
      "id": "c-liangshu-028-weifang-complete:received_sentence1-38",
      "kind": "received_sentence",
      "person_id": "axs_5y7_p7w_AAA",
      "source_quote": "放身長七尺七寸，腰帶八圍，容貌甚偉。",
      "reading": "原報身長七尺七寸、腰帶八圍。",
      "note": "原報身長七尺七寸、腰帶八圍。",
      "paragraph_id": "c-liangshu-028-weifang-complete:p001",
      "start_codepoint": 38,
      "end_codepoint": 56,
      "human_reviewed": false
    },
    {
      "id": "c-liangshu-028-weifang-complete:received_sentence1-56",
      "kind": "received_sentence",
      "person_id": "axs_5y7_p7w_AAA",
      "source_quote": "天監元年，爲盱眙太守，還除通直郎，尋爲輕車晉安王中兵參軍，遷鎮右始興王諮議參軍，以父憂去職。",
      "reading": "梁天監元年出盱眙，還為通直郎，再任梁晉安王及始興王幕職，因父喪去職。",
      "note": "梁天監元年出盱眙，還為通直郎，再任梁晉安王及始興王幕職，因父喪去職。",
      "paragraph_id": "c-liangshu-028-weifang-complete:p001",
      "start_codepoint": 56,
      "end_codepoint": 102,
      "human_reviewed": false
    },
    {
      "id": "c-liangshu-028-weifang-complete:received_sentence1-102",
      "kind": "received_sentence",
      "person_id": "axs_5y7_p7w_AAA",
      "source_quote": "服闋，襲封永昌縣侯，出爲輕車南平王長史、襄陽太守。",
      "reading": "服闋襲永昌縣侯，出任南平王長史、襄陽太守。",
      "note": "服闋襲永昌縣侯，出任南平王長史、襄陽太守。",
      "paragraph_id": "c-liangshu-028-weifang-complete:p001",
      "start_codepoint": 102,
      "end_codepoint": 127,
      "human_reviewed": false
    },
    {
      "id": "c-liangshu-028-weifang-complete:received_sentence1-127",
      "kind": "received_sentence",
      "person_id": "axs_5y7_p7w_AAA",
      "source_quote": "轉假節、明威將軍、竟陵太守。",
      "reading": "轉竟陵太守並加假節、明威將軍。",
      "note": "轉竟陵太守並加假節、明威將軍。",
      "paragraph_id": "c-liangshu-028-weifang-complete:p001",
      "start_codepoint": 127,
      "end_codepoint": 141,
      "human_reviewed": false
    },
    {
      "id": "c-liangshu-028-weifang-complete:received_sentence1-141",
      "kind": "received_sentence",
      "person_id": "axs_5y7_p7w_AAA",
      "source_quote": "在郡和理，爲吏民所稱。",
      "reading": "在竟陵治郡受稱。",
      "note": "在竟陵治郡受稱。",
      "paragraph_id": "c-liangshu-028-weifang-complete:p001",
      "start_codepoint": 141,
      "end_codepoint": 152,
      "human_reviewed": false
    },
    {
      "id": "c-liangshu-028-weifang-complete:received_sentence2-0",
      "kind": "received_sentence",
      "person_id": "axs_5y7_p7w_AAA",
      "source_quote": "六年，大舉北伐，以放爲貞威將軍，與胡龍牙會曹仲宗進軍。",
      "reading": "六年以貞威將軍與胡龍牙進軍。梁武帝紀及夏侯亶傳繫普通六年北伐。",
      "note": "六年以貞威將軍與胡龍牙進軍。梁武帝紀及夏侯亶傳繫普通六年北伐。",
      "paragraph_id": "c-liangshu-028-weifang-complete:p002",
      "start_codepoint": 0,
      "end_codepoint": 27,
      "human_reviewed": false
    },
    {
      "id": "c-liangshu-028-weifang-complete:received_sentence2-27",
      "kind": "received_sentence",
      "person_id": "axs_5y7_p7w_AAA",
      "source_quote": "七年，夏侯亶攻黎漿不克，高祖復使帥軍自北道會壽春城。",
      "reading": "次年夏侯亶攻黎漿未克，韋放走北道會壽春。夏侯亶傳亦記北道來會與合兵。",
      "note": "次年夏侯亶攻黎漿未克，韋放走北道會壽春。夏侯亶傳亦記北道來會與合兵。",
      "paragraph_id": "c-liangshu-028-weifang-complete:p002",
      "start_codepoint": 27,
      "end_codepoint": 53,
      "human_reviewed": false
    },
    {
      "id": "c-liangshu-028-weifang-complete:received_sentence2-53",
      "kind": "received_sentence",
      "person_id": "axs_5y7_p7w_AAA",
      "source_quote": "尋遷雲麾南康王長史、尋陽太守。",
      "reading": "改雲麾南康王長史、尋陽太守。",
      "note": "改雲麾南康王長史、尋陽太守。",
      "paragraph_id": "c-liangshu-028-weifang-complete:p002",
      "start_codepoint": 53,
      "end_codepoint": 68,
      "human_reviewed": false
    },
    {
      "id": "c-liangshu-028-weifang-complete:received_sentence2-68",
      "kind": "received_sentence",
      "person_id": "axs_5y7_p7w_AAA",
      "source_quote": "放累爲籓佐，並著聲績。",
      "reading": "史述歷任藩佐有聲。",
      "note": "史述歷任藩佐有聲。",
