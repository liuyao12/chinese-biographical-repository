  "pdf_sha1": "b11514da8e27fc149ba1ddc8e42a71bd01cd4e25",
  "pdf_sha256": "82c750b714c7e5513ff512f69a324b7e8fc8cb561f255a17e664c6aac45fd932",
  "pdf_bytes": 31214377,
  "column_order": "一上第六欄至三下第四欄前半。",
  "columns": [
    {
      "pdf_page": 89,
      "half": "左",
      "leaf": "一上",
      "column_from_right": 6,
      "text": "裴邃字淵明河東聞喜人魏襄州刺史綽之後也祖壽"
    },
    {
      "pdf_page": 89,
      "half": "左",
      "leaf": "一上",
      "column_from_right": 7,
      "text": "孫寓居壽陽為宋武帝前軍長史父仲穆驍騎將軍邃"
    },
    {
      "pdf_page": 89,
      "half": "左",
      "leaf": "一上",
      "column_from_right": 8,
      "text": "十歲能屬文善左氏春秋齊建武初刺史蕭遙昌引為"
    },
    {
      "pdf_page": 89,
      "half": "左",
      "leaf": "一上",
      "column_from_right": 9,
      "text": "府主簿壽陽有八公山廟遙昌為立碑使邃為文甚見"
    },
    {
      "pdf_page": 89,
      "half": "左",
      "leaf": "一上",
      "column_from_right": 10,
      "text": "稱賞舉秀才對策高第奉朝請東昏踐阼始安王蕭遙"
    },
    {
      "pdf_page": 90,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 1,
      "text": "光為撫軍將軍揚州刺史引邃為參軍後遙光敗邃還"
    },
    {
      "pdf_page": 90,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 2,
      "text": "壽陽值刺史裴叔業以壽陽降魏豫州豪族皆被驅掠"
    },
    {
      "pdf_page": 90,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 3,
      "text": "邃遂隨衆北徒魏主宣武帝雅重之以為司徒屬中書"
    },
    {
      "pdf_page": 90,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 4,
      "text": "郎魏郡太守魏遣王肅鎮壽陽邃固求隨肅密圖南歸"
    },
    {
      "pdf_page": 90,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 5,
      "text": "天監初自拔還朝除後軍諮議參軍邃求邊境自效以"
    },
    {
      "pdf_page": 90,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 6,
      "text": "為輔國將軍廬江太守時魏將呂頗率衆五萬奄來攻"
    },
    {
      "pdf_page": 90,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 7,
      "text": "郡邃率麾下拒破之加右軍將軍五年征邵陽洲魏人"
    },
    {
      "pdf_page": 90,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 8,
      "text": "為長橋斷淮以濟邃築壘逼橋每戰輒克於是密作没"
    },
    {
      "pdf_page": 90,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 9,
      "text": "突艦會甚雨淮水暴溢邃乘艦徑造橋側魏衆驚潰邃"
    },
    {
      "pdf_page": 90,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 10,
      "text": "乘勝追擊大破之進克羊石城斬城主元康又破霍丘"
    },
    {
      "pdf_page": 90,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 1,
      "text": "城斬城主甯永仁平小峴攻合肥以功封夷陵縣子邑"
    },
    {
      "pdf_page": 90,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 2,
      "text": "三百戶遷冠軍長史廣陵太守邃與鄉人共入魏武廟"
    },
    {
      "pdf_page": 90,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 3,
      "text": "因論帝王功業其妻甥王篆之密啓高祖云裴邃多大"
    },
    {
      "pdf_page": 90,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 4,
      "text": "言有不臣之迹由是左遷為始安太守邃志欲立功邊"
    },
    {
      "pdf_page": 90,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 5,
      "text": "陲不願閑遠乃致書於呂僧珍曰昔阮或顏延有二始"
    },
    {
      "pdf_page": 90,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 6,
      "text": "之歎吾才不逮古人今為三始非其願也將如之何未"
    },
    {
      "pdf_page": 90,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 7,
      "text": "及至郡會魏攻宿預詔邃拒焉行次直瀆魏衆退遷右"
    },
    {
      "pdf_page": 90,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 8,
      "text": "軍諮議參軍豫章王雲麾府司馬率所領助守石頭出"
    },
    {
      "pdf_page": 90,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 9,
      "text": "為竟陵太守開置屯田公私便之遷為遊撃將軍朱衣"
    },
    {
      "pdf_page": 90,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 10,
      "text": "直閤直殿省尋遷假節明威將軍西戎校尉北梁秦二"
    },
    {
      "pdf_page": 91,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 1,
      "text": "州刺史復開創屯田數千頃倉廪盈實省息邊運民吏"
    },
    {
      "pdf_page": 91,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 2,
      "text": "獲安乃相率餉絹千餘匹邃從容曰汝等不應爾吾又"
    },
    {
      "pdf_page": 91,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 3,
      "text": "不可逆納其絹二匹而已還為給事中雲騎將軍朱衣"
    },
    {
      "pdf_page": 91,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 4,
      "text": "直閤將軍遷大匠卿普通二年義州刺史文僧明以州"
    },
    {
      "pdf_page": 91,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 5,
      "text": "叛入於魏魏軍來援以邃為假節信武將軍督衆軍討"
    },
    {
      "pdf_page": 91,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 6,
      "text": "焉邃深入魏境從邊城道出其不意魏所署義州刺史"
    },
    {
      "pdf_page": 91,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 7,
      "text": "封壽據檀公峴邃擊破之遂圍其城壽面縛請降義州"
    },
    {
      "pdf_page": 91,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 8,
      "text": "平除持節督北徐州諸軍事信武將軍北徐州刺史未"
    },
    {
      "pdf_page": 91,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 9,
      "text": "之職又遷督豫州北豫霍三州諸軍事豫州刺史鎮合"
    },
    {
      "pdf_page": 91,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 10,
      "text": "肥四年進號宣毅將軍是歲大軍北伐以邃督征討"
    },
    {
      "pdf_page": 91,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 1,
      "text": "諸軍事率騎三千先襲壽陽九月壬戌夜至壽陽攻其"
    },
    {
      "pdf_page": 91,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 2,
      "text": "郛斬關而入一日戰九合為後軍蔡秀成失道不至邃"
    },
    {
      "pdf_page": 91,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 3,
      "text": "以援絕拔還於是邃復整兵收集士卒令諸將各以服"
    },
    {
      "pdf_page": 91,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 4,
      "text": "色相別邃自為黄袍騎先攻狄丘甓城黎漿等城皆拔"
    },
    {
      "pdf_page": 91,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 5,
      "text": "之屠安成馬頭沙陵等戍是冬始修芍陂明年復破魏"
    },
    {
      "pdf_page": 91,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 6,
      "text": "新蔡郡略地至于鄭城汝潁之間所在響應魏壽陽守"
    },
    {
      "pdf_page": 91,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 7,
      "text": "將長孫稚河間王元琛率衆五萬出城挑戰邃勒諸將"
    },
    {
      "pdf_page": 91,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 8,
      "text": "為四甄以待之令直閤將軍李祖憐偽遁以引稚稚等"
    },
    {
      "pdf_page": 91,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 9,
      "text": "悉衆追之四甄競發魏衆大敗斬首萬餘級稚等奔走"
    },
    {
      "pdf_page": 91,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 10,
      "text": "閉門自固不敢復出其年五月卒於軍中追贈侍中左"
    },
    {
      "pdf_page": 92,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 1,
      "text": "衞將軍給鼓吹一部進爵為侯增邑七百戶諡曰烈邃"
    },
    {
      "pdf_page": 92,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 2,
      "text": "少言笑沈深有思略為政寛明能得士心居身方正有"
    },
    {
      "pdf_page": 92,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 3,
      "text": "威重將吏憚之少敢犯法及其卒也淮肥間莫不流涕"
    },
    {
      "pdf_page": 92,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 4,
      "text": "以為邃不死洛陽不足拔也"
    }
  ],
