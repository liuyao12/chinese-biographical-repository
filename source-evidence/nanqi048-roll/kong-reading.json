      "title": "孔稚珪",
      "raw_spans": [
        {
          "first_line": 28,
          "last_line": 28,
          "start_codepoint": 0,
          "end_codepoint": 24,
          "opening": "　　孔稚珪字德璋，會",
          "closing": "也。祖道隆，位侍中。"
        },
        {
          "first_line": 30,
          "last_line": 30,
          "start_codepoint": 0,
          "end_codepoint": 158,
          "opening": "　　稚珪少學涉，有美",
          "closing": "，從事史，本郡中正。"
        },
        {
          "first_line": 32,
          "last_line": 32,
          "start_codepoint": 0,
          "end_codepoint": 411,
          "opening": "　　{{YL|永明七",
          "closing": "至九年，稚珪上表曰："
        },
        {
          "first_line": 34,
          "last_line": 34,
          "start_codepoint": 0,
          "end_codepoint": 259,
          "opening": ":　　臣聞匠萬物者以",
          "closing": "付外施用，宣下四海。"
        },
        {
          "first_line": 36,
          "last_line": 36,
          "start_codepoint": 0,
          "end_codepoint": 323,
          "opening": ":　　臣又聞老子、仲",
          "closing": "之，其已血濺九泉矣。"
        },
        {
          "first_line": 38,
          "last_line": 38,
          "start_codepoint": 0,
          "end_codepoint": 205,
          "opening": ":　　尋古之名流，多",
          "closing": "驅，若絃栝之相接矣。"
        },
        {
          "first_line": 40,
          "last_line": 40,
          "start_codepoint": 0,
          "end_codepoint": 102,
          "opening": ":　　臣以疏短，謬司",
          "closing": "使處法職，以勸士流。"
        },
        {
          "first_line": 42,
          "last_line": 42,
          "start_codepoint": 0,
          "end_codepoint": 11,
          "opening": "詔報從納，事竟不施行",
          "closing": "報從納，事竟不施行。"
        },
        {
          "first_line": 44,
          "last_line": 44,
          "start_codepoint": 0,
          "end_codepoint": 63,
          "opening": "　　轉御史中丞，遷驃",
          "closing": "百姓死傷。乃上表曰："
        },
        {
          "first_line": 46,
          "last_line": 46,
          "start_codepoint": 0,
          "end_codepoint": 488,
          "opening": ":　　匈奴爲患，自古",
          "closing": "戰不及和，相去何若？"
        },
        {
          "first_line": 48,
          "last_line": 48,
          "start_codepoint": 0,
          "end_codepoint": 142,
          "opening": ":　　自西朝不綱，東",
          "closing": "十餘年間，邊候且息。"
        },
        {
          "first_line": 50,
          "last_line": 50,
          "start_codepoint": 0,
          "end_codepoint": 454,
          "opening": ":　　陛下張天造曆，",
          "closing": "下，而無款塞之胡哉？"
        },
        {
          "first_line": 52,
          "last_line": 52,
          "start_codepoint": 0,
          "end_codepoint": 82,
          "opening": ":　　彼之言戰旣慇懃",
          "closing": "敢肆瞽直，伏奏千里。"
        },
        {
          "first_line": 54,
          "last_line": 54,
          "start_codepoint": 0,
          "end_codepoint": 15,
          "opening": "帝不納。徵侍中，不行",
          "closing": "侍中，不行，留本任。"
        },
        {
          "first_line": 56,
          "last_line": 56,
          "start_codepoint": 0,
          "end_codepoint": 122,
          "opening": "　　稚珪風韻清疏，好",
          "closing": "吹，何必期效仲舉。」"
        },
        {
          "first_line": 58,
          "last_line": 58,
          "start_codepoint": 0,
          "end_codepoint": 70,
          "opening": "　　{{YL|永元元",
          "closing": "五。贈金紫光祿大夫。"
        }
      ],
