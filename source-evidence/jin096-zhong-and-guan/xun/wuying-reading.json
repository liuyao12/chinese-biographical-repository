      "leaf": "八下",
      "column_from_right": 10,
      "reading": "荀崧小女灌幼有奇節崧為襄城太守為杜曾所圍力",
      "start_codepoint": 0,
      "end_codepoint": 21
    },
    {
      "pdf_page": 50,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 1,
      "reading": "弱食盡欲求救於故吏平南將軍石覽計無從出灌時",
      "start_codepoint": 21,
      "end_codepoint": 42
    },
    {
      "pdf_page": 50,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 2,
      "reading": "年十三乃率勇士數十人踰城突圍夜出賊追甚急灌",
      "start_codepoint": 42,
      "end_codepoint": 63
    },
    {
      "pdf_page": 50,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 3,
      "reading": "督厲將士且戰且前得入魯陽山獲免自詣覽乞師又",
      "start_codepoint": 63,
      "end_codepoint": 84
    },
    {
      "pdf_page": 50,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 4,
      "reading": "為崧書與南中郎將周訪請援仍結為兄弟訪即遣子",
      "start_codepoint": 84,
      "end_codepoint": 105
    },
    {
      "pdf_page": 50,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 5,
      "reading": "撫率三千人會石覽俱救崧賊聞兵至散走灌之力也",
      "start_codepoint": 105,
      "end_codepoint": 126
    }
  ],
