  "columns": [
    {
      "pdf_page": 45,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 10,
      "reading": "王渾妻鍾氏字琰潁川人魏太傅繇曾孫也父徽黃門",
      "start_codepoint": 0,
      "end_codepoint": 21
    },
    {
      "pdf_page": 45,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 1,
      "reading": "郎琰數歲能屬文及長聰慧弘雅博覽記籍美容止善",
      "start_codepoint": 21,
      "end_codepoint": 42
    },
    {
      "pdf_page": 45,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 2,
      "reading": "嘯詠禮儀法度為中表所則既適渾生濟渾嘗共琰坐",
      "start_codepoint": 42,
      "end_codepoint": 63
    },
    {
      "pdf_page": 45,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 3,
      "reading": "濟趨庭而過渾欣然曰生子如此足慰人心琰笑曰若",
      "start_codepoint": 63,
      "end_codepoint": 84
    },
    {
      "pdf_page": 45,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 4,
      "reading": "使新婦得配參軍生子故不翅如此參軍謂渾中弟淪",
      "start_codepoint": 84,
      "end_codepoint": 105
    },
    {
      "pdf_page": 45,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 5,
      "reading": "也琰女亦有才淑為求賢夫時有兵家子甚俊濟欲妻",
      "start_codepoint": 105,
      "end_codepoint": 126
    },
    {
      "pdf_page": 45,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 6,
      "reading": "之白琰琰曰要令我見之濟令此兵與羣小雜處琰自",
      "start_codepoint": 126,
      "end_codepoint": 147
    },
    {
      "pdf_page": 45,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 7,
      "reading": "幃中察之既而謂濟曰緋衣者非汝所拔乎濟曰是琰",
      "start_codepoint": 147,
      "end_codepoint": 168
    },
    {
      "pdf_page": 45,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 8,
      "reading": "曰此人才足拔萃然地寒壽促不足展其器用不可與",
      "start_codepoint": 168,
      "end_codepoint": 189
    },
    {
      "pdf_page": 45,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 9,
      "reading": "婚遂止其人數年果亡琰明鑒遠識皆此類也渾弟湛",
      "start_codepoint": 189,
      "end_codepoint": 210
    },
    {
      "pdf_page": 45,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 10,
      "reading": "妻郝氏亦有德行琰雖貴門與郝雅相親重郝不以賤",
      "start_codepoint": 210,
      "end_codepoint": 231
    },
    {
      "pdf_page": 46,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 1,
      "reading": "下琰琰不以貴陵郝時人稱鍾夫人之禮郝夫人之法",
      "start_codepoint": 231,
      "end_codepoint": 252
    },
    {
      "pdf_page": 46,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 2,
      "reading": "云",
      "start_codepoint": 252,
      "end_codepoint": 253
    }
  ],
