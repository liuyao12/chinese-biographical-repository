{
  "witnesses": {
    "h": {
      "title": "王建之墓誌",
      "medium": "石",
      "findspot": "南京象山M9",
      "research_inventory_row": 20,
      "columns": [
        {
          "column_id": "h1c01",
          "page_id": "h1",
          "from_right": 1,
          "text": "晉故振威將軍鄱陽太守",
          "characters": 10
        },
        {
          "column_id": "h1c02",
          "page_id": "h1",
          "from_right": 2,
          "text": "都亭侯琅耶臨沂縣都鄉",
          "characters": 10
        },
        {
          "column_id": "h1c03",
          "page_id": "h1",
          "from_right": 3,
          "text": "南仁里王建之字榮妣故",
          "characters": 10
        },
        {
          "column_id": "h1c04",
          "page_id": "h1",
          "from_right": 4,
          "text": "散騎常侍特進衞將軍尚",
          "characters": 10
        },
        {
          "column_id": "h1c05",
          "page_id": "h1",
          "from_right": 5,
          "text": "書左僕射都亭肅侯彬之",
          "characters": 10
        },
        {
          "column_id": "h1c06",
          "page_id": "h1",
          "from_right": 6,
          "text": "孫故給事黃門侍郎都亭",
          "characters": 10
        },
        {
          "column_id": "h2c01",
          "page_id": "h2",
          "from_right": 1,
          "text": "侯彭之之長子本州迎西",
          "characters": 10
        },
        {
          "column_id": "h2c02",
          "page_id": "h2",
          "from_right": 2,
          "text": "曹不行襲封都亭侯州檄",
          "characters": 10
        },
        {
          "column_id": "h2c03",
          "page_id": "h2",
          "from_right": 3,
          "text": "主簿建威參軍太學博士",
          "characters": 10
        },
        {
          "column_id": "h2c04",
          "page_id": "h2",
          "from_right": 4,
          "text": "州別駕不行長山令廷尉",
          "characters": 10
        },
        {
          "column_id": "h2c05",
          "page_id": "h2",
          "from_right": 5,
          "text": "監尚書右丞車騎長史尚",
          "characters": 10
        },
        {
          "column_id": "h2c06",
          "page_id": "h2",
          "from_right": 6,
          "text": "書左丞中書侍郎振威將",
          "characters": 10
        },
        {
          "column_id": "h3c01",
          "page_id": "h3",
          "from_right": 1,
          "text": "軍鄱陽太守春秋五十五",
          "characters": 10
        },
        {
          "column_id": "h3c02",
          "page_id": "h3",
          "from_right": 2,
          "text": "泰和六年閏月丙寅朔十",
          "characters": 10
        },
        {
          "column_id": "h3c03",
          "page_id": "h3",
          "from_right": 3,
          "text": "二日丁丑薨于郡官舍夫",
          "characters": 10
        },
        {
          "column_id": "h3c04",
          "page_id": "h3",
          "from_right": 4,
          "text": "人南陽湦陽劉氏先建之",
          "characters": 10
        },
        {
          "column_id": "h3c05",
          "page_id": "h3",
          "from_right": 5,
          "text": "半年薨咸安二年三月甲",
          "characters": 10
        },
        {
          "column_id": "h3c06",
          "page_id": "h3",
          "from_right": 6,
          "text": "午朔十四日丁未遷神其",
          "characters": 10
        },
        {
          "column_id": "h4c01",
          "page_id": "h4",
          "from_right": 1,
          "text": "年四月癸亥朔廿六日戊",
          "characters": 10
        },
        {
          "column_id": "h4c02",
          "page_id": "h4",
          "from_right": 2,
          "text": "子合葬舊墓在丹楊建康",
          "characters": 10
        },
        {
          "column_id": "h4c03",
          "page_id": "h4",
          "from_right": 3,
          "text": "之白石丹楊令君墓之東",
          "characters": 10
        },
        {
          "column_id": "h4c04",
          "page_id": "h4",
          "from_right": 4,
          "text": "故刻石為識",
          "characters": 5
        },
        {
          "column_id": "h4c05",
          "page_id": "h4",
          "from_right": 5,
          "text": "二男未識不育大女玉龜",
          "characters": 10
        },
        {
          "column_id": "h4c06",
          "page_id": "h4",
          "from_right": 6,
          "text": "次女道末並二歲亡小女",
          "characters": 10
        },
        {
          "column_id": "h5c01",
          "page_id": "h5",
          "from_right": 1,
          "text": "張願適濟陰卞嗣之字奉",
          "characters": 10
        },
        {
          "column_id": "h5c02",
          "page_id": "h5",
          "from_right": 2,
          "text": "伯小男紀之字元萬",
          "characters": 8
        },
        {
          "column_id": "h5c03",
          "page_id": "h5",
          "from_right": 3,
          "text": "建之母弟翹之見廬陵太",
          "characters": 10
        },
        {
          "column_id": "h5c04",
          "page_id": "h5",
          "from_right": 4,
          "text": "守小弟朔之前太宰從事",
          "characters": 10
        },
        {
          "column_id": "h5c05",
          "page_id": "h5",
          "from_right": 5,
          "text": "中郎",
          "characters": 2
        }
      ],
