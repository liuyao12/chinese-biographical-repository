    "columns": [
      {
        "n": 5,
        "text": "愍懷太子妃王氏"
      },
      {
        "n": 6,
        "text": "愍懷太子妃王氏太尉衍女也字惠風貞婉有志節太"
      },
      {
        "n": 7,
        "text": "子既廢居于金墉衍請絶婚惠風號哭而歸行路為之"
      },
      {
        "n": 8,
        "text": "流涕及劉曜陷洛陽以惠風賜其將喬屬屬將妻之惠"
      },
      {
        "n": 9,
        "text": "風拔劍距屬曰吾太尉公女皇太子妃義不為逆胡所"
      },
      {
        "n": 10,
        "text": "辱屬遂害之"
      }
    ],
    "pdf_url": "https://upload.wikimedia.org/wikipedia/commons/9/9f/NLC016-HWRB201817005-3297_%E6%99%89%E6%9B%B8_%E4%B8%80%E7%99%BE%E4%B8%89%E5%8D%81%E5%8D%B7_%E9%9F%B3%E7%BE%A9%E4%B8%89%E5%8D%B7_%E7%AC%AC24%E5%86%8A.pdf#page=46",
    "file_page": "https://commons.wikimedia.org/w/index.php?oldid=979438884",
