    {
      "matter": "王曇首傳首、兄弟、園陵",
      "evidence": [
        {
          "chapter_path": "corpus/nanshi/022-wangtanshou-wyd.json",
          "source_id": "s-nanshi-022-wangtanshou-wyd1739",
          "chapter_id": "c-nanshi-022-wangtanshou-wyd",
          "paragraph_id": "c-nanshi-022-wangtanshou-wyd:p001",
          "text_sha256": "eaab56c66c39b68150f02ee5ec2f6d232b78251fc992ee89aef8d9c53f7901fd",
          "start": 0,
          "end": 130,
          "quote": "王曇首太保弘之弟也幼有素尚兄弟分財曇首唯取圖書而已辟琅邪王大司馬屬從府公修復洛陽園陵與從弟球俱詣宋武帝帝曰並膏梁世德乃能屈志戎旅曇首答曰旣從神武自使懦夫立志時謝晦在坐曰仁者果有勇帝悅及至彭城大會戲馬臺賦詩曇首文先成帝問弘曰卿弟何如卿答曰若但如下官門戶何寄帝大笑"
        },
        {
          "chapter_path": "corpus/nanshi/022-wangtanshou.json",
          "source_id": "s-nanshi-022-wangtanshou-ws1477957",
          "chapter_id": "c-nanshi-022-wangtanshou",
          "paragraph_id": "c-nanshi-022-wangtanshou:p001",
          "text_sha256": "413f0072677c004ea2f548f8849e5253c6daa5e4eb1bb616b1033691ee0ac8a8",
          "start": 0,
          "end": 5,
          "quote": "曇首有智局"
        },
        {
          "chapter_path": "corpus/songshu/063-wanghua-tanshou.json",
          "source_id": "s-songshu-063-wanghua-tanshou",
          "chapter_id": "c-songshu-063-wanghua-tanshou",
          "paragraph_id": "c-songshu-063-wanghua-tanshou:line029",
          "text_sha256": "f7040a1a9727c35816858a6b001d60127f79cc8b597a77c850f73d0da700180a",
          "start": 10,
          "end": 16,
          "quote": "太保弘少弟也"
        },
        {
          "work": "晉書/卷010",
          "revision": 2567072,
          "raw_path": "source-evidence/nanshi022-wang/jin010-ws2567072.wikitext",
          "raw_sha256": "191bbf44a05c366e9ce2ae1556f05d317245ff0d923e97e99d5aad06c81e8794",
          "line": 168,
          "start": 105,
          "end": 115,
          "quote": "以琅邪王德文爲大司馬"
        },
        {
          "work": "晉書/卷010",
          "revision": 2567072,
          "raw_path": "source-evidence/nanshi022-wang/jin010-ws2567072.wikitext",
          "raw_sha256": "191bbf44a05c366e9ce2ae1556f05d317245ff0d923e97e99d5aad06c81e8794",
          "line": 361,
          "start": 13,
          "end": 27,
          "quote": "請帥所莅，啓行戎路，修敬山陵"
        },
        {
          "work": "資治通鑑/卷117",
          "revision": 803166,
          "raw_path": "source-evidence/nanshi022-wang/tongjian117-ws803166.wikitext",
          "raw_sha256": "062ce10c119a69b19f90b7ca413d63dc71560b39c9b4d9811b4df1a6afefe580",
          "line": 112,
          "start": 47,
          "end": 62,
          "quote": "琅邪王德文請啟行戌路，修敬山陵"
        }
      ],
      "reading": "殿本傳首自第62面左半第6欄至第63面右半第2欄，固定數位南史整段闕。弘為兄，球為從弟，屬官府主為晉恭帝司馬德文。"
    },
    {
      "matter": "開廣莫門與傅隆所奏",
      "evidence": [
        {
          "chapter_path": "corpus/nanshi/022-wangtanshou.json",
          "source_id": "s-nanshi-022-wangtanshou-ws1477957",
          "chapter_id": "c-nanshi-022-wangtanshou",
          "paragraph_id": "c-nanshi-022-wangtanshou:p002",
          "text_sha256": "76b7ae6f929682e31b544cd8a637d40bf6e99b72aabe4582c08720569444ea31",
          "start": 54,
          "end": 68,
          "quote": "傅隆以下。曇首曰：「既無墨敕"
        },
        {
          "chapter_path": "corpus/nanshi/022-wangtanshou-wyd.json",
          "source_id": "s-nanshi-022-wangtanshou-wyd1739",
          "chapter_id": "c-nanshi-022-wangtanshou-wyd",
          "paragraph_id": "c-nanshi-022-wangtanshou-wyd:p003",
          "text_sha256": "7fe06d4edebf6598407394e5c9e1e277c6e405d5cb72092f67e7acad231ce8ba",
          "start": 44,
          "end": 55,
          "quote": "傅隆旨下曇首曰旣無異敕"
        },
        {
          "chapter_path": "corpus/nanshi/022-wangtanshou.json",
          "source_id": "s-nanshi-022-wangtanshou-ws1477957",
          "chapter_id": "c-nanshi-022-wangtanshou",
          "paragraph_id": "c-nanshi-022-wangtanshou:p002",
          "text_sha256": "76b7ae6f929682e31b544cd8a637d40bf6e99b72aabe4582c08720569444ea31",
          "start": 32,
          "end": 40,
          "quote": "銀字檀」。不肯開"
        },
        {
          "chapter_path": "corpus/nanshi/022-wangtanshou-wyd.json",
          "source_id": "s-nanshi-022-wangtanshou-wyd1739",
          "chapter_id": "c-nanshi-022-wangtanshou-wyd",
          "paragraph_id": "c-nanshi-022-wangtanshou-wyd:p003",
          "text_sha256": "7fe06d4edebf6598407394e5c9e1e277c6e405d5cb72092f67e7acad231ce8ba",
          "start": 25,
          "end": 31,
          "quote": "銀字棨不肯開"
        }
      ],
      "reading": "已核第63面左半，數位本以下、墨敕、檀與印本旨下、異敕、棨並存。"
    },
    {
      "matter": "卒與追封",
      "evidence": [
        {
          "chapter_path": "corpus/nanshi/022-wangtanshou.json",
          "source_id": "s-nanshi-022-wangtanshou-ws1477957",
