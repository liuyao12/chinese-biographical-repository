          "line": 65,
          "start": 44,
          "end": 59,
          "quote": "帝以儉嫡母武康公主同太初巫蠱事"
        },
        {
          "work": "南齊書/卷23",
          "revision": 1545488,
          "raw_path": "source-evidence/nanshi022-wang/nanqi023-ws1545488.wikitext",
          "raw_sha256": "aca7d279e2bec7461700ae2bfe9504272af2da8a5a13a4567635eeb30e4ec8cd",
          "line": 67,
          "start": 62,
          "end": 73,
          "quote": "母憂，服闋爲司徒右長史"
        },
        {
          "work": "王文憲集序",
          "revision": 2318179,
          "raw_path": "source-evidence/nanshi022-wang/renfang-wangwenxian-ws2318179.wikitext",
