  "comparisons": [
    {
      "anchor": {
        "paragraph_id": "c-jinshu-076-wangshu-family:line011",
        "start": 15,
        "end": 21,
        "surface": "父會，侍御史"
      },
      "reading": "劉注引《傳》明言父會、祖覽。",
      "sources": [
        {
          "witness": "shi",
          "quote": "{{ProperNoun|舒}}字{{ProperNoun|處明}}，{{ProperNoun|琅邪}}人。祖{{ProperNoun|覽}}，知名。父{{ProperNoun|會}}，-{御}-史。",
          "raw_start": 9501,
          "raw_end": 9601,
          "raw_line": 17
        }
      ]
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-076-wangshu-family:line011",
        "start": 53,
        "end": 57,
        "surface": "年四十餘"
      },
      "reading": "州禮命時的概數，不換算出生年。",
      "sources": [
        {
          "witness": "jin",
          "quote": "年四十餘，州禮命，太傅辟，皆不就。",
          "raw_start": 222,
          "raw_end": 239,
          "raw_line": 11
        }
      ]
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-076-wangshu-family:line013",
        "start": 53,
        "end": 62,
        "surface": "後將軍、宣城公褚裒"
      },
      "reading": "傳文及殿本均有褚；琅邪孝王本傳列宣城郡公、後將軍，斠注引諸史拾遺指元帝子。",
      "sources": [
        {
          "witness": "jin64",
          "quote": "裒初繼叔父長樂亭侯渾，後徙封宣城郡公，拜後將軍。",
          "raw_start": 3772,
          "raw_end": 3796,
          "raw_line": 69
        },
        {
          "witness": "jz667",
          "quote": "諸史拾遺曰：「宣城公裒，元帝子也。」此作『褚裒』，蓋校書者妄增，褚裒未嘗封宣城公，其薨在穆帝永和五年，不在元帝時也。",
          "raw_start": 433,
          "raw_end": 491,
          "raw_line": 7
        }
      ]
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-076-wangshu-family:line015",
        "start": 71,
        "end": 82,
        "surface": "於是改「會」字為「鄶」"
      },
      "reading": "王舒避父會，允之另有避祖會之表，通典載授官爭議。",
      "sources": [
        {
          "witness": "dian",
          "quote": "東晉康帝{{YL|咸康八年}}，詔以王允之為衛將軍、會稽內史，允之表郡與祖會名同，乞改授。",
          "raw_start": 13343,
          "raw_end": 13388,
          "raw_line": 94
        }
      ]
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-076-wangshu-family:line017",
        "start": 0,
        "end": 4,
        "surface": "長子晏之"
      },
      "reading": "婚書彙刻述舒夫人及晏之、允之。四庫文本作「劉〈闕〉」。本段長子死於蘇峻之亂。",
      "sources": [
        {
          "witness": "fs",
          "quote": "上祖舒散騎常侍撫軍將軍㑹稽内史鎮軍儀同三司夫人右將軍劉{{SK notes|闕}}女誕晏之允之允之建威將軍錢塘令㑹稽都尉義興太守南中郎將江州刺史衛將軍夫人散騎常侍苟文女誕希之仲之",
          "raw_start": 17400,
          "raw_end": 17489,
          "raw_line": 294
        },
        {
          "witness": "jz670",
          "quote": "《法書要錄》引《王羲之與高平郗公書》云：舒「夫人，右將軍劉口女，誕晏之、允之。」",
          "raw_start": 304,
          "raw_end": 344,
          "raw_line": 2
        }
      ]
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-076-wangshu-family:line020",
        "start": 0,
        "end": 5,
        "surface": "允之字深猷"
      },
      "reading": "兩條御覽引晉中興書俱作淵猷；斠注說唐避諱，區分原文與校者說。",
      "sources": [
        {
          "witness": "yu396",
          "quote": "《晋中興書》曰：王允之字淵猷，年在總角，從伯敦知之，謂爲似己，入則共寢。",
          "raw_start": 3086,
          "raw_end": 3122,
          "raw_line": 91
        },
        {
          "witness": "yu432",
          "quote": "《晋中興書》曰：王允之，字淵猷，年在總角，從伯敦深知之。",
          "raw_start": 3261,
          "raw_end": 3289,
          "raw_line": 139
        },
        {
          "witness": "jz670",
          "quote": "御覽三百九十六、四百三十二引《晉中興書》作「字淵猷」，案唐人避諱，改『淵』爲『深』。",
          "raw_start": 388,
          "raw_end": 430,
          "raw_line": 4
        }
      ]
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-076-wangshu-family:line022",
        "start": 117,
        "end": 128,
        "surface": "太保、安豐侯以孝聞天下"
      },
      "reading": "晉書王戎因平吳進爵安豐侯，母喪時與和嶠並舉；王祥曾居太保，此處太保仍另存疑。",
      "sources": [
        {
          "witness": "jin43",
          "quote": "吳平，進爵安豐侯，增邑六千戶，賜絹六千匹。",
          "raw_start": 5235,
          "raw_end": 5256,
          "raw_line": 72
        },
        {
          "witness": "jin43",
          "quote": "時和嶠亦居父喪，以禮法自持，量米而食，哀毀不逾於戎。",
          "raw_start": 5511,
          "raw_end": 5537,
          "raw_line": 76
        },
        {
          "witness": "jin33",
          "quote": "族孫戎歎曰：「太保可謂清達矣！」",
          "raw_start": 1797,
          "raw_end": 1813,
          "raw_line": 32
        }
      ]
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-076-wangshu-family:line024",
        "start": 0,
        "end": 12,
        "surface": "子晞之嗣。卒，子肇之嗣。"
      },
      "reading": "本傳晞之嗣允之，肇之嗣晞之。婚書以希之、仲之為允之夫人所誕。斠注校希為晞；仲之獨存來源謂稱，未與肇之通同。四庫作苟文，斠注引作荀文。",
      "sources": [
        {
          "witness": "fs",
          "quote": "上祖舒散騎常侍撫軍將軍㑹稽内史鎮軍儀同三司夫人右將軍劉{{SK notes|闕}}女誕晏之允之允之建威將軍錢塘令㑹稽都尉義興太守南中郎將江州刺史衛將軍夫人散騎常侍苟文女誕希之仲之",
          "raw_start": 17400,
          "raw_end": 17489,
          "raw_line": 294
        },
        {
          "witness": "jz671",
          "quote": "允之夫人，散騎常侍荀文女，誕希之、仲之。",
          "raw_start": 585,
          "raw_end": 605,
          "raw_line": 2
        }
      ]
    }
  ],
