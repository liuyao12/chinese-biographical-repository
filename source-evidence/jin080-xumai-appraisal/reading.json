  "items": [],
  "comparisons": [
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line120",
        "start": 7,
        "end": 10,
        "quote": "一名映"
      },
      "witnesses": [
        {
          "witness": "zh",
          "quote": "先生名邁，字叔玄，小名映，清虛懷道，遐棲世外，故自改名遠遊，與王右軍父子周旋。",
          "source_layer": "正文",
          "raw_start": 3110,
          "raw_end": 3149,
          "raw_line": 61
        },
        {
          "witness": "yj",
          "quote": "許邁字叔玄，小名映，丹陽句容人也。",
          "source_layer": "正文",
          "raw_start": 10078,
          "raw_end": 10095,
          "raw_line": 90
        }
      ],
      "reading": "晉書一名映，真誥、雲笈作小名映。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line120",
        "start": 48,
        "end": 63,
        "quote": "遇《泰》之《大畜》，其上六爻發"
      },
      "witnesses": [
        {
          "witness": "yj",
          "quote": "曾從郭璞筮卦，遇大壯之大有上六爻發。",
          "source_layer": "正文",
          "raw_start": 10116,
          "raw_end": 10134,
          "raw_line": 90
        }
      ],
      "reading": "雲笈作大壯之大有，卦名與晉書不同，存為不同敘事。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line120",
        "start": 84,
        "end": 90,
        "quote": "南海太守鮑靚"
      },
      "witnesses": [
        {
          "witness": "bao",
          "quote": "鮑靚，字太玄，東海人也。",
          "source_layer": "正文",
          "raw_start": 7991,
          "raw_end": 8003,
          "raw_line": 73
        },
        {
          "witness": "bao",
          "quote": "靚學兼內外，明天文河洛書，稍遷南陽中部都尉，為南海太守。",
          "source_layer": "正文",
          "raw_start": 8043,
          "raw_end": 8071,
          "raw_line": 73
        }
      ],
      "reading": "鮑靚字太玄，其字與許邁字叔玄分清。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line120",
        "start": 201,
        "end": 208,
        "quote": "乃遣婦孫氏還家"
      },
      "witnesses": [
        {
          "witness": "zh",
          "quote": "娶吳郡孫宏，字彥達女，即驃騎秀之孫。既離好，無子歸宗。",
          "source_layer": "正文",
          "raw_start": 3246,
          "raw_end": 3273,
          "raw_line": 61
        }
      ],
      "reading": "真誥所記妻父孫宏、字彥達，及離好。晉書未言未命名之妻有無所生子女。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line122",
        "start": 95,
        "end": 103,
        "quote": "乃改名玄，字遠遊"
      },
      "witnesses": [
        {
          "witness": "zh",
          "quote": "先生名邁，字叔玄，小名映，清虛懷道，遐棲世外，故自改名遠遊，與王右軍父子周旋。",
          "source_layer": "正文",
          "raw_start": 3110,
          "raw_end": 3149,
          "raw_line": 61
        }
      ],
      "reading": "真誥記自改名遠遊；兩書遠遊為名、字不同。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line122",
        "start": 173,
        "end": 178,
        "quote": "左元放之徒"
      },
      "witnesses": [
        {
          "witness": "hou",
          "quote": "左慈字元放，廬江人也。",
          "source_layer": "正文",
          "raw_start": 6196,
          "raw_end": 6207,
          "raw_line": 124
        }
      ],
      "reading": "引許邁書，左元放是後漢左慈，非同時相交。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line122",
        "start": 213,
        "end": 227,
        "quote": "莫測所終，好道者皆謂之羽化矣"
      },
      "witnesses": [
        {
          "witness": "jin32",
          "quote": "會有道士許邁者，朝臣時望多稱其得道。帝從容問焉，答曰：「邁是好山水人，本無道術",
          "source_layer": "正文",
          "raw_start": 5855,
          "raw_end": 5894,
          "raw_line": 76
        },
        {
          "witness": "zh",
          "quote": "而譜云：永和四年秋，絕跡於臨安西山，年四十八，此則永寧元年辛酉生，為少一年。今以自記為正，絕跡時年四十九矣。",
          "source_layer": "正文",
          "raw_start": 3192,
          "raw_end": 3246,
          "raw_line": 61
        }
      ],
      "reading": "仙去是好道者說法；永和四年絕跡的四十八與四十九是譜、陶氏按語兩種報齡，不能作卒年或卒齡。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line126",
        "start": 57,
        "end": 63,
        "quote": "師宜懸帳之奇"
      },
      "witnesses": [
        {
          "witness": "fa",
          "quote": "師宜官。後漢不知何許人、何官。",
          "source_layer": "正文",
          "raw_start": 3009,
          "raw_end": 3024,
          "raw_line": 45
        },
        {
          "witness": "fa",
          "quote": "得師宜官法。魏武重之，常以鵠書懸帳中。",
          "source_layer": "正文",
          "raw_start": 3102,
          "raw_end": 3121,
          "raw_line": 46
        }
      ],
      "reading": "此處師宜讀師宜官。羊欣錄卻將懸帳繫梁鵠之書，兩種敘述分存。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line126",
        "start": 227,
        "end": 231,
        "quote": "子雲近出"
      },
      "witnesses": [
        {
          "witness": "guang",
          "quote": "梁蕭子雲字景喬。",
          "source_layer": "太平廣記引尚書故實",
          "raw_start": 3804,
          "raw_end": 3812,
          "raw_line": 37
        }
      ],
      "reading": "子雲為梁代蕭子雲，屬後世唐人論書，與羲之、獻之無同時交往。"
    }
  ],
