    {
      "pdf_page": 55,
      "leaf": "右十五下、左十六上",
      "reading": "齊王冏有匡復之功、弟澄族弟敦、辭封武陵侯。",
      "source_url": "https://upload.wikimedia.org/wikipedia/commons/c/ce/NLC016-HWRB201817005-3303_%E6%99%89%E6%9B%B8_%E4%B8%80%E7%99%BE%E4%B8%89%E5%8D%81%E5%8D%B7_%E9%9F%B3%E7%BE%A9%E4%B8%89%E5%8D%B7_%E7%AC%AC12%E5%86%8A.pdf#page=55",
