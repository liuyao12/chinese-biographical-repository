  "account_units": 16,
  "span_map": {
    "趙倫之": [
      {
        "first_line": 11,
        "last_line": 13,
        "start_codepoint": 0,
        "end_codepoint": 121,
        "opening": "趙倫之字幼成，下邳僮",
        "closing": "五年，卒。子伯符嗣。"
      }
    ],
    "趙伯符": [
      {
        "first_line": 15,
        "last_line": 15,
        "start_codepoint": 0,
        "end_codepoint": 235,
        "opening": "伯符字潤遠。少好弓馬。倫",
        "closing": "筆吏取筆不如意，鞭五十。"
      },
      {
        "first_line": 15,
        "last_line": 15,
        "start_codepoint": 312,
        "end_codepoint": 324,
        "opening": "伯符慚懼發病卒。諡曰肅。",
        "closing": "伯符慚懼發病卒。諡曰肅。"
      }
    ],
    "趙倩": [
      {
        "first_line": 15,
        "last_line": 15,
        "start_codepoint": 235,
        "end_codepoint": 312,
        "opening": "子倩，尚文帝第四女海鹽公",
        "closing": "詔離婚，殺主所生蔣美人，"
      }
    ],
    "趙勗": [
      {
        "first_line": 15,
        "last_line": 15,
        "start_codepoint": 324,
        "end_codepoint": 337,
        "opening": "傳國至孫勗，齊受禪，國除",
        "closing": "國至孫勗，齊受禪，國除。"
      }
    ],
    "王懿": [
      {
        "first_line": 21,
        "last_line": 25,
        "start_codepoint": 0,
        "end_codepoint": 212,
        "opening": "王懿字仲德，<ref",
        "closing": "，恐不足以成大事。」"
      },
      {
        "first_line": 27,
        "last_line": 37,
        "start_codepoint": 142,
        "end_codepoint": 100,
        "opening": "以仲德為中兵參軍。",
        "closing": "童子壇，每祭必祠之。"
      }
    ],
    "王叡": [
      {
        "first_line": 27,
        "last_line": 27,
        "start_codepoint": 0,
        "end_codepoint": 142,
        "opening": "元德果敢有智略，武帝",
        "closing": "給事中，封安復縣侯，"
      }
    ],
    "王正脩": [
      {
        "first_line": 37,
        "last_line": 37,
        "start_codepoint": 100,
        "end_codepoint": 111,
        "opening": "子正脩嗣，為家僮所殺",
        "closing": "正脩嗣，為家僮所殺。"
      }
    ],
    "張邵": [
      {
        "first_line": 40,
        "last_line": 52,
        "start_codepoint": 0,
        "end_codepoint": 160,
        "opening": "張邵字茂宗，<ref",
        "closing": "、演、敬，有名於世。"
      }
    ],
    "張敷": [
      {
        "first_line": 54,
        "last_line": 58,
        "start_codepoint": 0,
        "end_codepoint": 170,
        "opening": "敷字景胤。生而母亡，",
        "closing": "，改其所居為孝張里。"
      }
    ],
    "張柬": [
      {
        "first_line": 60,
        "last_line": 60,
        "start_codepoint": 0,
        "end_codepoint": 46,
        "opening": "敷弟柬，襲父封，位通",
        "closing": "亭，柬出奔，墜淮死。"
      }
    ],
    "張式": [
      {
        "first_line": 60,
        "last_line": 60,
        "start_codepoint": 46,
        "end_codepoint": 50,
        "opening": "子式嗣。",
        "closing": "子式嗣。"
      }
    ],
    "張暢": [
      {
        "first_line": 62,
        "last_line": 62,
        "start_codepoint": 0,
        "end_codepoint": 12,
        "opening": "暢字少微，邵兄偉之子",
        "closing": "少微，邵兄偉之子也。"
      },
      {
        "first_line": 64,
        "last_line": 76,
        "start_codepoint": 0,
        "end_codepoint": 76,
        "opening": "暢少與從兄敷、演、敬",
        "closing": "與輯合墳，時議非之。"
      }
    ],
    "張偉": [
      {
        "first_line": 62,
        "last_line": 62,
        "start_codepoint": 12,
        "end_codepoint": 62,
        "opening": "偉少有操行，為晉琅邪",
        "closing": "，受命於道自飲而卒。"
      }
    ],
    "張悅": [
      {
        "first_line": 78,
        "last_line": 78,
        "start_codepoint": 0,
        "end_codepoint": 119,
        "opening": "弟悅，亦有美稱，歷侍",
        "closing": "巴郡太守。未拜，卒。"
      }
    ],
    "張浩": [
      {
        "first_line": 80,
        "last_line": 80,
        "start_codepoint": 0,
        "end_codepoint": 17,
        "opening": "暢子浩，官至義陽王昶",
        "closing": "陽王昶征北諮議參軍。"
      }
    ],
    "張淹": [
      {
        "first_line": 80,
        "last_line": 80,
        "start_codepoint": 17,
        "end_codepoint": 93,
        "opening": "浩弟淹，黃門郎，封廣",
        "closing": "勛同逆，軍敗見殺焉。"
      }
    ]
  },
