    {
      "pdf_page": 23,
      "half": "左",
      "leaf": "二十一上",
      "column_from_right": 8,
      "reading": "東昏褚皇后諱令璩河南陽翟人太常澄之女",
      "start_codepoint": 0,
      "end_codepoint": 18
    },
    {
      "pdf_page": 23,
      "half": "左",
      "leaf": "二十一上",
      "column_from_right": 9,
      "reading": "也建武二年納為皇太子妃而無寵帝謂左右",
      "start_codepoint": 18,
      "end_codepoint": 36
    },
    {
      "pdf_page": 24,
      "half": "右",
      "leaf": "二十一下",
      "column_from_right": 1,
      "reading": "曰若得如山陰主無恨矣山陰主明帝長女也",
      "start_codepoint": 36,
      "end_codepoint": 54
    },
    {
      "pdf_page": 24,
      "half": "右",
      "leaf": "二十一下",
      "column_from_right": 2,
      "reading": "後遂與之為亂明年妃謁敬后廟東昏即位為",
      "start_codepoint": 54,
      "end_codepoint": 72
    },
    {
      "pdf_page": 24,
      "half": "右",
      "leaf": "二十一下",
      "column_from_right": 3,
      "reading": "皇后帝寵潘妃后不被遇黃淑儀生太子誦而",
      "start_codepoint": 72,
      "end_codepoint": 90
    },
    {
      "pdf_page": 24,
      "half": "右",
      "leaf": "二十一下",
      "column_from_right": 4,
      "reading": "卒東昏廢后及誦並為庶人后父澄自有傳",
      "start_codepoint": 90,
      "end_codepoint": 107
    }
  ],
