      "start_codepoint": 174,
      "end_codepoint": 193,
      "human_reviewed": false
    },
    {
      "id": "c-songshu-049-liuzhong:received_sentence4-193",
      "kind": "received_sentence",
      "person_id": "vcd_ee3_q63",
      "source_quote": "今重軍卒至，出其不意，蜀人已破膽矣。",
      "reading": "鍾分析蜀方情勢。",
      "note": "鍾分析蜀方情勢。",
