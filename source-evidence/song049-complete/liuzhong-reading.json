      "human_reviewed": false
    },
    {
      "id": "c-songshu-049-liuzhong:received_sentence4-47",
      "kind": "received_sentence",
      "person_id": "vcd_ee3_q63",
      "source_quote": "偽冠軍征討督護譙亢等兩岸連營，層樓重柵，眾號三萬。",
      "reading": "譙亢等守彭模。",
