    },
    {
      "id": "c-songshu-049-kuaien:received_sentence5-9",
      "kind": "received_sentence",
      "person_id": "sn4_yf4_esv",
      "source_quote": "義真還至青埿，為佛佛虜所追，恩斷後，力戰連日。",
      "reading": "青埿受夏軍追，恩斷後。",
      "note": "青埿受夏軍追，恩斷後。",
      "paragraph_id": "c-songshu-049-kuaien:p005",
      "start_codepoint": 9,
      "end_codepoint": 32,
      "human_reviewed": false
    },
    {
