  "source_clauses": [
    {
      "witness": "w59",
      "quote": "孫登字子高，權長子也。",
      "raw_start": 216,
      "raw_end": 227,
      "raw_line": 12
    },
    {
      "witness": "w59",
      "quote": "初，登所生庶賤，徐夫人少有母養之恩",
      "raw_start": 1341,
      "raw_end": 1358,
      "raw_line": 16
    },
    {
      "witness": "w59",
      "quote": "立凡二十一年，年三十三卒。",
      "raw_start": 1507,
      "raw_end": 1520,
      "raw_line": 18
    },
    {
      "witness": "w59",
      "quote": "蔣脩、虞翻，志節分明。",
      "raw_start": 1867,
      "raw_end": 1878,
      "raw_line": 18
    },
    {
      "witness": "w59",
      "quote": "英實不知。",
      "raw_start": 2506,
      "raw_end": 2511,
      "raw_line": 20
    },
    {
      "witness": "wu50",
      "quote": "使母養子登。",
      "raw_start": 1717,
      "raw_end": 1723,
      "raw_line": 28
    },
    {
      "witness": "wu52",
      "quote": "虞翻以狂直流徙，惟瑾屢爲之説。",
      "raw_start": 9616,
      "raw_end": 9631,
      "raw_line": 72
    },
    {
      "witness": "wu57",
      "quote": "在南十餘年，年七十卒。",
      "raw_start": 5175,
      "raw_end": 5186,
      "raw_line": 29
    },
    {
      "witness": "wu58",
      "quote": "征遜輔太子",
      "raw_start": 3605,
      "raw_end": 3610,
      "raw_line": 35
    }
  ],
