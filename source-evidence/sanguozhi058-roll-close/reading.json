  "review": {
    "heading_count": 2,
    "non_biographical_heading": "【評】",
    "principle": "原題陸遜、陸抗。另收正文和明確引書中以該人為中心的自足事蹟，無題者按原段界。上疏與往復書歸傳主；卷末評、習鑿齒的評論各保留原署。",
    "remaining_mentions": [
      "陸延只記長子早夭。",
      "陸玄只列分兵，陸耽僅於裴注被收，唐修晉書另有雲弟耽的一段。",
      "謝厷只有才辯品評；潘臨與尤突列入陸遜初仕記，無各自獨立完整始末。",
      "舊吏俞贊與吳將朱喬亡詣肇、孟玖與孟超傾陷機雲均繫於所屬全文，相關人物、所言事件與所引別傳都可按各自的字位查。",
      "卷評非列傳，仍單列其覆核狀態。"
    ],
    "chronology": [
      "陸遜亡在赤烏八年春二月（吳主紀），本傳卒時六十三。",
      "陸抗鳳皇二年春拜大司馬、三年夏病、秋卒，孫皓傳將二年任官細繫三月。",
      "天紀四年二月，晏壬戌、景癸亥。晉武帝紀同繫壬戌。"
    ],
    "family_details": [
      "陸抗自稱臣父遜；孫策為其外祖父。晏、景、玄、機、雲見正文分兵，耽見裴注。",
      "陸抗、陸遜兩代的孫策女、張承女、孫皓適妹三位婦女分記；未以未見其名而相併。"
    ]
  },
