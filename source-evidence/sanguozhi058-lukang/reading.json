  "source_clauses": [
    {
      "witness": "w58",
      "quote": "抗字幼節，孫策外孫也。遜卒時，年二十",
      "raw_start": 6578,
      "raw_end": 6596,
      "raw_line": 60
    },
    {
      "witness": "w58",
      "quote": "臣父遜昔在西垂陳言",
      "raw_start": 10000,
      "raw_end": 10009,
      "raw_line": 85
    },
    {
      "witness": "w58",
      "quote": "二月壬戌，晏為王浚別軍所殺。癸亥，景亦遇害，時年三十一。",
      "raw_start": 10483,
      "raw_end": 10511,
      "raw_line": 87
    },
    {
      "witness": "w58",
      "quote": "景妻，孫皓適妹，與景俱張承外孫也。",
      "raw_start": 10511,
      "raw_end": 10528,
      "raw_line": 87
    },
    {
      "witness": "w48",
      "quote": "二年春三月，以陸抗爲大司馬。",
      "raw_start": 12442,
      "raw_end": 12456,
      "raw_line": 74
    },
    {
      "witness": "w48",
      "quote": "大司馬陸抗卒。",
      "raw_start": 13030,
      "raw_end": 13037,
      "raw_line": 76
    },
    {
      "witness": "jin3",
      "quote": "壬戌，濬又克夷道樂鄉城，殺夷道監陸晏、水軍都督陸景。",
      "raw_start": 11634,
      "raw_end": 11660,
      "raw_line": 337
    },
    {
      "witness": "jin54",
      "quote": "陸機，字士衡，吳郡人也。祖遜，吳丞相。父抗，吳大司馬。",
      "raw_start": 175,
      "raw_end": 202,
      "raw_line": 12
    },
    {
      "witness": "jin54",
      "quote": "雲弟耽為平東祭酒，亦有清譽，與雲同遇害。",
      "raw_start": 10350,
      "raw_end": 10370,
      "raw_line": 101
    },
    {
      "witness": "jin34",
      "quote": "祜與陸抗相對，使命交通",
      "raw_start": 2252,
      "raw_end": 2263,
      "raw_line": 34
    },
    {
      "witness": "w52",
      "quote": "承喪妻",
      "raw_start": 3800,
      "raw_end": 3803,
      "raw_line": 32
    },
    {
      "witness": "w52",
      "quote": "權爲子和納之",
      "raw_start": 3868,
      "raw_end": 3874,
      "raw_line": 32
    }
  ],
