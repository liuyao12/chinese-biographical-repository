  "readings": [
    {
      "topic": "卷內傳界",
      "reading": "殿本陸遜題下小注子抗；陸遜傳末追謚後另起抗字幼節。數位修訂另立陸抗題。"
    },
    {
      "topic": "陸抗轄界",
      "digital": "都督西陵，自關羽至白帝。",
      "print": "都督西陵自關羽至白帝",
      "reading": "兩本此處均作關羽。上下為轄境，無事蹟或人物角色可繫於關羽本人。"
    },
    {
      "topic": "陸晏與陸景異日",
      "digital": "晏為王浚別軍所殺。癸亥，景亦遇害，時年三十一。",
      "print": "二月壬戌晏為王濬別軍所殺癸亥景亦遇害時年三十一",
      "parallel": "晉武帝紀同列於壬戌，陸景官作水軍都督。保存兩源差異。"
    },
    {
      "topic": "張氏與兩外孫",
      "reading": "裴引文士傳的諸葛恪外生接張承女，續句仍主景母。卷52載張承娶諸葛瑾女，生女嫁孫和。未把嫁孫和者與景母合號；兩位張承外孫均依本卷明文。景祖母未具名。"
    },
    {
      "topic": "五子與耽",
      "reading": "正文晏、景、玄、機、雲五人分領兵。裴引別傳及唐修晉書另記陸耽，均未稱與五人同領兵。"
    },
    {
      "topic": "羊祜、陸抗互信",
      "reading": "兩部引書分別作祜饋藥與抗求藥。次條○習鑿齒曰係評論。冶夫以事稱錄，未補其姓名。"
    },
    {
      "topic": "自稱與官銜",
      "reading": "陸抗疏中「韓、白」引古，不併入敘事將領。太平二年所破魏將未具名。"
    }
  ],
