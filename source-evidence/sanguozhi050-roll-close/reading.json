  "source_clauses": [
    {
      "witness": "w50",
      "quote": "《會稽典錄》曰：策功曹魏騰",
      "raw_start": 691,
      "raw_end": 704,
      "raw_line": 16
    },
    {
      "witness": "w50",
      "quote": "使母養子登。",
      "raw_start": 1717,
      "raw_end": 1723,
      "raw_line": 28
    },
    {
      "witness": "w50",
      "quote": "遂拊育皓及其三弟。",
      "raw_start": 3889,
      "raw_end": 3898,
      "raw_line": 58
    },
    {
      "witness": "w50",
      "quote": "與丞相騭同族。",
      "raw_start": 1859,
      "raw_end": 1866,
      "raw_line": 31
    },
    {
      "witness": "w50",
      "quote": "全尚妻即峻姊。",
      "raw_start": 3294,
      "raw_end": 3301,
      "raw_line": 54
    },
    {
      "witness": "w50",
      "quote": "損妻是峻妹也",
      "raw_start": 3448,
      "raw_end": 3454,
      "raw_line": 54
    },
    {
      "witness": "w50",
      "quote": "生二女，長曰魯班",
      "raw_start": 1903,
      "raw_end": 1911,
      "raw_line": 31
    },
    {
      "witness": "w50",
      "quote": "前配朱據，後配劉纂。",
      "raw_start": 1937,
      "raw_end": 1947,
      "raw_line": 31
    },
    {
      "witness": "w50",
      "quote": "初適同郡陸尚。尚卒，極為討虜將軍在吳",
      "raw_start": 1693,
      "raw_end": 1711,
      "raw_line": 28
    },
    {
      "witness": "w50",
      "quote": "以景為為廣陵太守",
      "raw_start": 576,
      "raw_end": 584,
      "raw_line": 14
    },
    {
      "witness": "w50",
      "quote": "八年，景卒宮",
      "raw_start": 929,
      "raw_end": 935,
      "raw_line": 18
    },
    {
      "witness": "w50",
      "quote": "與孫賁共討樊能、於麋於橫江",
      "raw_start": 501,
      "raw_end": 514,
      "raw_line": 14
    },
    {
      "witness": "w50",
      "quote": "隨孫策討樊能、於糜等於橫江",
      "raw_start": 1381,
      "raw_end": 1394,
      "raw_line": 26
    },
    {
      "witness": "wu46",
      "quote": "{{ProperNoun|-{于}-麋}}東屯{{ProperNoun|橫江津}}",
      "raw_start": 18193,
      "raw_end": 18234,
      "raw_line": 37
    },
    {
      "witness": "wu52",
      "quote": "生女，權爲子和納之。權數令和修敬於承，執子婿之禮。",
      "raw_start": 3865,
      "raw_end": 3890,
      "raw_line": 32
    },
    {
      "witness": "wu57",
      "quote": "孫亮時，二子熊、損各復領兵",
      "raw_start": 15558,
      "raw_end": 15571,
      "raw_line": 96
    },
    {
      "witness": "wu57",
      "quote": "以熊子宣襲爵雲陽侯，尚公主。",
      "raw_start": 15591,
      "raw_end": 15605,
      "raw_line": 96
    },
    {
      "witness": "wu58",
      "quote": "景妻，孫皓適妹，與景俱張承外孫也。",
      "raw_start": 10511,
      "raw_end": 10528,
      "raw_line": 87
    },
    {
      "witness": "wu59",
      "quote": "初，登所生庶賤，徐夫人少有母養之恩",
      "raw_start": 1341,
      "raw_end": 1358,
      "raw_line": 16
    },
    {
      "witness": "wu59",
      "quote": "孫和字子孝，慮弟也。少以母王有寵見愛",
      "raw_start": 3088,
      "raw_end": 3106,
      "raw_line": 28
    }
  ],
