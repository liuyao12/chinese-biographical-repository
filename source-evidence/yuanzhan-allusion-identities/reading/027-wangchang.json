        "source_fragments": [
          {
            "line": 197,
            "raw_start": 9,
            "raw_end": 26,
            "text": "樂安任昭先淳粹履道内敏外恕推遜恭讓"
          },
          {
            "line": 198,
            "raw_start": 0,
            "raw_end": 21,
            "text": "處不避洿怯而義勇在朝忘身吾友之善之願兒子遵"
          },
