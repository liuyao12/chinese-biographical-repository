  "roles": {
    "dushu": {
      "start": 394,
      "end": 396,
      "surface": "務伯",
      "mention_id": "c-epitaph-yuanzhan-nmh-full:p001:m0394",
      "name": "杜恕",
      "confidence": "medium_high",
      "rationale": "本碑轉給事黃門侍郎後，以務伯矜嚴相擬；三國志杜恕完整本傳明恕字務伯、散騎黃門侍郎。字與同官語境支持有資格首選；矜嚴精確同語只見類聚引三輔決錄的搜尋線索，未親讀原典，不作本批主證。"
    },
    "rengu": {
      "start": 401,
      "end": 403,
      "surface": "昭先",
      "mention_id": "c-epitaph-yuanzhan-nmh-full:p001:m0401",
      "name": "任嘏",
      "confidence": "high",
      "rationale": "王昶書原文任昭先，裴注緊接昭先名嘏、完整別傳敘黃門侍郎與帝嘉其淑慎；本碑同黃門官語境的昭先淑慎相擬。此證是裴注所引別傳，未冒親讀失傳別傳。"
    },
    "huguang": {
      "start": 781,
      "end": 783,
      "surface": "伯始",
      "mention_id": "c-epitaph-yuanzhan-nmh-full:p001:m0781",
      "name": "胡廣",
      "confidence": "high",
      "rationale": "後漢書完整胡廣傳明字伯始、性溫柔謹素及天下中庸有胡公，與碑伯始溫柔、天下中庸連續對應；重用晉書漢太傅胡廣的既有來源端點。"
    },
    "huaxin": {
      "start": 786,
      "end": 788,
      "surface": "子魚",
      "mention_id": "c-epitaph-yuanzhan-nmh-full:p001:m0786",
      "name": "華歆",
      "confidence": "high",
      "rationale": "固定三國志十三完整華歆傳明字子魚，議論持平與清靜不煩等語境；碑在公輔議論以子魚和理相擬。不是一般同字猜人，也不把人物品評當湛實際性格。"
    },
    "xiaojing": {
      "start": 873,
      "end": 875,
      "surface": "天子",
      "mention_id": "c-epitaph-yuanzhan-nmh-full:p001:m0873",
      "name": "孝靜帝善見",
      "confidence": "high",
      "rationale": "魏書十二傳首明孝静皇帝諱善見、即位與車駕遷鄴；同紀武定元二年完整年度承同一紀主，二年五月丁酉明太尉廣陽王湛薨，與碑武定二年五月十四日丁酉薨鄴同事件。故本處天子舉哀首選在位孝靜帝，非齊獻武王或紀中後朝今上。"
    },
    "guojia": {
      "start": 1104,
      "end": 1106,
      "surface": "奉孝",
      "mention_id": "c-epitaph-yuanzhan-nmh-full:p001:m1104",
      "name": "郭嘉",
      "confidence": "high",
      "rationale": "完整郭嘉本傳字奉孝；裴注傅子明引太祖哀哉奉孝痛哉奉孝惜哉奉孝，本碑哀哉奉孝乃悲逝者是同語弔典。保持傅子由裴注轉引層，不冒親讀傅子。"
    },
    "jizun": {
      "start": 1114,
      "end": 1116,
      "surface": "征虜",
      "mention_id": "c-epitaph-yuanzhan-nmh-full:p001:m1114",
      "name": "祭遵",
      "confidence": "high",
      "rationale": "後漢書祭遵完整單元明拜征虜將軍，卒後光武每歎安得憂國奉公之臣如祭征虜者乎；碑安得征虜實痛良臣對應同語弔典，非因同官稱而接馬援。"
    }
  },
