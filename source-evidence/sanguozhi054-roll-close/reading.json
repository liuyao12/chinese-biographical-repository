  "source_clauses": [
    {
      "witness": "w54",
      "quote": "從祖父景，景子忠，皆為漢太尉。",
      "raw_start": 195,
      "raw_end": 210,
      "raw_line": 11
    },
    {
      "witness": "w54",
      "quote": "景父榮，章、和世為尚書令。",
      "raw_start": 333,
      "raw_end": 346,
      "raw_line": 11
    },
    {
      "witness": "w54",
      "quote": "父異，洛陽令。",
      "raw_start": 477,
      "raw_end": 484,
      "raw_line": 11
    },
    {
      "witness": "w54",
      "quote": "孫權與陸遜論周瑜、魯肅及蒙曰：",
      "raw_start": 13472,
      "raw_end": 13487,
      "raw_line": 85
    },
    {
      "witness": "w54",
      "quote": "蒙留（孫河），委以後事",
      "raw_start": 11593,
      "raw_end": 11604,
      "raw_line": 73
    },
    {
      "witness": "w54",
      "quote": "子太以旦夕之命",
      "raw_start": 11340,
      "raw_end": 11347,
      "raw_line": 71
    },
    {
      "witness": "w54",
      "quote": "即父子俱獲",
      "raw_start": 12942,
      "raw_end": 12947,
      "raw_line": 79
    },
    {
      "witness": "w54",
      "quote": "肅遣腹子淑",
      "raw_start": 8933,
      "raw_end": 8938,
      "raw_line": 57
    },
    {
      "witness": "w54",
      "quote": "領導江夏太守",
      "raw_start": 920,
      "raw_end": 926,
      "raw_line": 13
    },
    {
      "witness": "h45",
      "quote": "及竇氏敗，榮由此顯名。自郾令擢為尚書令。出為穎川太守，坐法，當下獄，和帝思榮忠節，左轉共令。歲餘，復以為山陽太守。所歷郡縣，皆見稱紀。",
      "raw_start": 7334,
      "raw_end": 7401,
      "raw_line": 143
    },
    {
      "witness": "h45",
      "quote": "以老病乞身，卒於家，詔特賜錢二十萬，除子男興為郎中。",
      "raw_start": 7403,
      "raw_end": 7429,
      "raw_line": 145
    },
    {
      "witness": "h45",
      "quote": "詔乃拜興為尚書郎。卒。興子景。",
      "raw_start": 7654,
      "raw_end": 7669,
      "raw_line": 149
    },
    {
      "witness": "h45",
      "quote": "===興子景 ===",
      "raw_start": 7671,
      "raw_end": 7681,
      "raw_line": 151
    },
    {
      "witness": "h45",
      "quote": "景字仲饗。",
      "raw_start": 7683,
      "raw_end": 7688,
      "raw_line": 153
    },
    {
      "witness": "h45",
      "quote": "忠子暉，前為洛陽令，去官歸。",
      "raw_start": 8084,
      "raw_end": 8098,
      "raw_line": 165
    },
    {
      "witness": "w47",
      "quote": "璋司馬馬忠獲羽及其子平、都督趙累等於章鄉，遂定荊州。",
      "raw_start": 4324,
      "raw_end": 4350,
      "raw_line": 44
    },
    {
      "witness": "w47",
      "quote": "獲將軍[[w:士仁|士仁]]",
      "raw_start": 4139,
      "raw_end": 4153,
      "raw_line": 44
    },
    {
      "witness": "w47",
      "quote": "九年，權弟丹楊太守[[w:孫翊|翊]]爲左右所害",
      "raw_start": 1434,
      "raw_end": 1458,
      "raw_line": 20
    },
    {
      "witness": "w47",
      "quote": "徐忠、孫規等兵二萬取長沙、零陵、桂陽三郡",
      "raw_start": 3356,
      "raw_end": 3376,
      "raw_line": 36
    },
    {
      "witness": "w51",
      "quote": "伯父河，字伯海，本姓俞氏",
      "raw_start": 5522,
      "raw_end": 5534,
      "raw_line": 47
    },
    {
      "witness": "w51",
      "quote": "及翊遇害，河馳赴宛陵",
      "raw_start": 6282,
      "raw_end": 6292,
      "raw_line": 51
    },
    {
      "witness": "w51",
      "quote": "遂殺河，使人北迎揚州刺史劉馥",
      "raw_start": 6344,
      "raw_end": 6358,
      "raw_line": 51
    },
    {
      "witness": "w51",
      "quote": "遷都護征虜將軍，代程普督夏口",
      "raw_start": 1127,
      "raw_end": 1141,
      "raw_line": 18
    },
    {
      "witness": "w14",
      "quote": "劉曄字子揚",
      "raw_start": 10918,
      "raw_end": 10923,
      "raw_line": 89
    }
  ],
