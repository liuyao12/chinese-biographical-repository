    },
    {
      "print_quote": "遷金紫光祿大夫未拜卒諡惠子",
      "start": 127,
      "end": 140,
      "columns": [
        {
          "pdf_page": 35,
          "half": "左",
          "leaf": "六上",
          "column_from_right": 3
        }
      ],
      "note": "金紫光祿大夫未拜，惠子為諡。"
    },
    {
      "print_quote": "子琮為國子生尚始興王女繁昌主",
      "start": 140,
      "end": 154,
      "columns": [
        {
          "pdf_page": 35,
          "half": "左",
          "leaf": "六上",
          "column_from_right": 3
        },
        {
          "pdf_page": 35,
          "half": "左",
          "leaf": "六上",
          "column_from_right": 4
        }
      ],
      "note": "子琮一傳在同欄接起。"
    },
    {
      "print_quote": "遂離婚",
      "start": 162,
      "end": 165,
      "columns": [
        {
          "pdf_page": 35,
          "half": "左",
          "leaf": "六上",
          "column_from_right": 4
        }
      ],
      "note": "離婚在議及姻親往事之前。"
    },
    {
      "print_quote": "下官曾祖是謝仁祖外孫",
      "start": 182,
      "end": 192,
      "columns": [
        {
          "pdf_page": 35,
          "half": "左",
          "leaf": "六上",
          "column_from_right": 5
        },
        {
