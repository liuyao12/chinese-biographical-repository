  "columns": [
    {
      "pdf_page": 35,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 7,
      "reading": "峻字茂遠秀之子也少美風姿善容止仕齊為桂陽內",
      "start_codepoint": 0,
      "end_codepoint": 21
    },
    {
      "pdf_page": 35,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 8,
      "reading": "史梁天監初為中書侍郎武帝甚悅其風采與陳郡謝",
      "start_codepoint": 21,
      "end_codepoint": 42
    },
    {
      "pdf_page": 35,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 9,
      "reading": "覽同見賞擢累遷侍中吏部尚書處選甚得名譽峻性",
      "start_codepoint": 42,
      "end_codepoint": 63
    },
    {
      "pdf_page": 35,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 10,
      "reading": "詳雅無趨競心嘗與謝覽約官至侍中不復謀進仕覽",
      "start_codepoint": 63,
      "end_codepoint": 84
    },
    {
      "pdf_page": 35,
      "half": "左",
      "leaf": "六上",
      "column_from_right": 1,
      "reading": "自吏部尚書出為吳興郡平心不畏彊禦亦由處俗情",
      "start_codepoint": 84,
      "end_codepoint": 105
    },
    {
      "pdf_page": 35,
      "half": "左",
      "leaf": "六上",
      "column_from_right": 2,
      "reading": "薄故也峻為侍中已後雖不退身亦淡然自守無所營",
      "start_codepoint": 105,
      "end_codepoint": 126
    },
    {
      "pdf_page": 35,
      "half": "左",
      "leaf": "六上",
      "column_from_right": 3,
      "reading": "務遷金紫光祿大夫未拜卒諡惠子子琮為國子生尚",
      "start_codepoint": 126,
      "end_codepoint": 147
    },
    {
      "pdf_page": 35,
      "half": "左",
      "leaf": "六上",
      "column_from_right": 4,
      "reading": "始興王女繁昌主琮不慧為學生所嗤遂離婚峻謝王",
      "start_codepoint": 147,
      "end_codepoint": 168
    },
    {
      "pdf_page": 35,
      "half": "左",
      "leaf": "六上",
      "column_from_right": 5,
      "reading": "王曰此自上意僕極不願如此峻曰下官曾祖是謝仁",
      "start_codepoint": 168,
      "end_codepoint": 189
    },
    {
      "pdf_page": 35,
      "half": "左",
      "leaf": "六上",
      "column_from_right": 6,
      "reading": "祖外孫亦不藉殿下姻媾為門戶耳",
      "start_codepoint": 189,
      "end_codepoint": 203
    }
  ],
