      "line": 43,
      "start": 0,
      "end": 8,
      "source_quote": "玄保兄子希字泰聞",
      "interpretation": "羊希字泰聞，為羊玄保兄子。"
    },
    {
      "raw_path": "source-evidence/song092-xunli/external/ws771110.wikitext",
