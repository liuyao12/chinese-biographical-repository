    {
      "title": "陸法真",
      "raw_segments": [
        {
          "first_line": 77,
          "last_line": 77,
          "start_codepoint": 0,
          "end_codepoint": 111,
          "opening": "世祖世，吳郡陸法真歷官有",
          "closing": "宗初，為南海太守，卒官。",
          "source_quote": "世祖世，吳郡陸法真歷官有清節，嘗為劉秀之安北錄事參軍。泰山羊希與安北諮議參軍孫詵書曰：「足下同僚似有陸錄事者，此生東南名地，又張玄外孫，持身至清，雅有志節。年高官下，秉操不衰，計當日夕相與申意。」太宗初，為南海太守，卒官。"
        }
      ],
      "chapter_id": "c-songshu-092-xunli-xunxing",
      "paragraph_id": "c-songshu-092-xunli-xunxing:p006",
      "print_columns": [
        [
          {
            "page": 101,
            "half": "右",
            "leaf": "十一下",
            "column": 2,
            "start_in_transcribed_column": 15,
            "text": "世祖世吳郡陸"
          },
          {
            "page": 101,
            "half": "右",
            "leaf": "十一下",
            "column": 3,
            "start_in_transcribed_column": 0,
            "text": "法真歷官有清節嘗為劉秀之安北録事參軍太山羊"
          },
          {
            "page": 101,
            "half": "右",
            "leaf": "十一下",
            "column": 4,
            "start_in_transcribed_column": 0,
            "text": "希與安北咨議參軍孫詵書曰足下同僚似有陸録事"
          },
          {
            "page": 101,
            "half": "右",
            "leaf": "十一下",
            "column": 5,
            "start_in_transcribed_column": 0,
            "text": "者此生東南名地又張𤣥外孫持身至清雅有志節年"
