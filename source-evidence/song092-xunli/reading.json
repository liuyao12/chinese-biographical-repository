    "pdf_url": "https://upload.wikimedia.org/wikipedia/commons/0/07/NLC016-HWRB201817006-2845_%E5%AE%8B%E6%9B%B8_%E4%B8%80%E7%99%BE%E5%8D%B7_%E7%AC%AC22%E5%86%8A.pdf",
    "pdf_sha1": "844dd746f6c9d4ee7b2e2e3b448263be9d91dd9f",
    "physical_id": "NLC016-HWRB201817006-2845",
    "columns": [
      {
        "page": 99,
        "half": "左",
        "leaf": "十上",
        "column": 5,
        "start": 0,
        "end": 4,
        "text": "元嘉初太"
      },
      {
        "page": 99,
        "half": "左",
        "leaf": "十上",
        "column": 6,
        "start": 4,
        "end": 25,
        "text": "祖遣大使巡行四方兼散騎常侍孔默之王歆之等上"
      },
      {
        "page": 99,
        "half": "左",
        "leaf": "十上",
        "column": 7,
        "start": 25,
        "end": 46,
        "text": "言宣威將軍陳南頓二郡太守李元德清勤均平姦盜"
      },
      {
        "page": 99,
        "half": "左",
        "leaf": "十上",
        "column": 8,
        "start": 46,
        "end": 67,
        "text": "止息彭城內史魏恭子廉恪脩慎在公忘私安約守儉"
      },
      {
        "page": 99,
        "half": "左",
        "leaf": "十上",
        "column": 9,
        "start": 67,
        "end": 88,
        "text": "久而彌固前宋縣令成浦治政寬濟遺詠在民前鮦陽"
      },
      {
        "page": 99,
        "half": "左",
        "leaf": "十上",
        "column": 10,
        "start": 88,
        "end": 109,
        "text": "令李熙國在事有方民思其政山桑令何道自少清廉"
      },
      {
        "page": 100,
        "half": "右",
        "leaf": "十下",
        "column": 1,
        "start": 109,
        "end": 130,
        "text": "白首彌厲應加褒賚以勸于後乃進元德號寧朔將軍"
      },
      {
        "page": 100,
        "half": "右",
        "leaf": "十下",
        "column": 2,
        "start": 130,
        "end": 151,
        "text": "恭子賜絹五十匹穀五百斛浦熙國道各賜絹三十匹"
      },
      {
        "page": 100,
        "half": "右",
        "leaf": "十下",
        "column": 3,
        "start": 151,
        "end": 155,
        "text": "穀二百斛"
      },
      {
        "page": 100,
        "half": "右",
        "leaf": "十下",
        "column": 4,
        "start": 155,
        "end": 176,
        "text": "王歆之字叔道河東人也曾祖愆期有名晉世官至南"
      },
      {
        "page": 100,
        "half": "右",
        "leaf": "十下",
        "column": 5,
        "start": 176,
        "end": 197,
        "text": "蠻校尉祖尋之光祿大夫父肇之豫章公相歆之被遇"
      },
      {
        "page": 100,
        "half": "右",
        "leaf": "十下",
        "column": 6,
        "start": 197,
        "end": 218,
        "text": "於太祖歷顯官左民尚書光祿大夫卒官元嘉九年豫"
      },
      {
        "page": 100,
        "half": "右",
        "leaf": "十下",
        "column": 7,
        "start": 218,
        "end": 239,
        "text": "州刺史長沙王義欣上言所統威遠將軍北譙梁二郡"
      },
      {
        "page": 100,
        "half": "右",
        "leaf": "十下",
        "column": 8,
        "start": 239,
        "end": 260,
        "text": "太守關中侯申季歷自奉職邦畿于兹五年信惠並宣"
      },
      {
        "page": 100,
        "half": "右",
        "leaf": "十下",
        "column": 9,
        "start": 260,
        "end": 281,
        "text": "威化兼著外清姦暴內輯民黎役賦均平閭井齊肅綏"
      },
      {
        "page": 100,
        "half": "右",
        "leaf": "十下",
        "column": 10,
        "start": 281,
        "end": 302,
        "text": "穆初附招攜荒遠郊境之外仰澤懷風爵賞之授績能"
      },
      {
        "page": 100,
        "half": "左",
        "leaf": "十一上",
        "column": 1,
        "start": 302,
        "end": 323,
        "text": "是顯宜升階秩以崇奬勸進號寧朔將軍其後晉壽太"
      },
      {
        "page": 100,
        "half": "左",
        "leaf": "十一上",
        "column": 2,
        "start": 323,
        "end": 344,
        "text": "守郭啓𤣥亦有清節卒官元嘉二十八年詔曰故綏遠"
      },
      {
        "page": 100,
        "half": "左",
        "leaf": "十一上",
        "column": 3,
        "start": 344,
        "end": 365,
        "text": "將軍晉壽太守郭啓𤣥往銜命虜庭秉意不屈受任白"
      },
      {
        "page": 100,
        "half": "左",
        "leaf": "十一上",
        "column": 4,
        "start": 365,
        "end": 386,
        "text": "水盡勤靡懈公奉私餼纖毫弗納布衣蔬食飭躬惟儉"
      },
      {
        "page": 100,
        "half": "左",
        "leaf": "十一上",
        "column": 5,
        "start": 386,
        "end": 407,
        "text": "故超授顯邦以甄廉績而介誠苦節終始匪貳身死之"
      },
      {
        "page": 100,
        "half": "左",
        "leaf": "十一上",
        "column": 6,
        "start": 407,
        "end": 428,
        "text": "日妻子凍餒志操殊俗良可哀悼可賜其家穀五百斛"
      },
      {
        "page": 100,
        "half": "左",
        "leaf": "十一上",
        "column": 7,
        "start": 428,
        "end": 449,
        "text": "時有北地傅僧祐潁川陳珉高平張祐並以吏才見知"
      },
      {
        "page": 100,
        "half": "左",
        "leaf": "十一上",
        "column": 8,
        "start": 449,
        "end": 470,
        "text": "僧祐事在臧燾傳珉為吳令善發姦伏境內以為神明"
      },
      {
        "page": 100,
        "half": "左",
        "leaf": "十一上",
        "column": 9,
        "start": 470,
        "end": 491,
        "text": "祐祖父湛晉孝武世以才學為中書侍郎光祿勳祐歷"
      },
      {
        "page": 100,
        "half": "左",
        "leaf": "十一上",
        "column": 10,
        "start": 491,
        "end": 512,
        "text": "臨安武康錢塘令並著能名宋世言長吏者以三人為"
      },
      {
        "page": 101,
        "half": "右",
        "leaf": "十一下",
        "column": 1,
        "start": 512,
        "end": 533,
        "text": "首元嘉中高平太守潘詞有清節子亮為昌慮令亦著"
      },
      {
        "page": 101,
        "half": "右",
        "leaf": "十一下",
        "column": 2,
        "start": 533,
        "end": 554,
        "text": "廉名大明中為徐州刺史劉道隆所表世祖世吳郡陸"
      },
      {
        "page": 101,
        "half": "右",
        "leaf": "十一下",
        "column": 3,
        "start": 554,
        "end": 575,
        "text": "法真歷官有清節嘗為劉秀之安北録事參軍太山羊"
      },
      {
        "page": 101,
        "half": "右",
        "leaf": "十一下",
        "column": 4,
        "start": 575,
        "end": 596,
        "text": "希與安北咨議參軍孫詵書曰足下同僚似有陸録事"
      },
      {
        "page": 101,
        "half": "右",
        "leaf": "十一下",
        "column": 5,
        "start": 596,
        "end": 617,
        "text": "者此生東南名地又張𤣥外孫持身至清雅有志節年"
      },
      {
        "page": 101,
        "half": "右",
        "leaf": "十一下",
        "column": 6,
        "start": 617,
        "end": 638,
        "text": "高官下秉操不衰計當日夕相與申意太宗初為南海"
      },
      {
        "page": 101,
        "half": "右",
        "leaf": "十一下",
        "column": 7,
        "start": 638,
        "end": 642,
        "text": "太守卒官"
      }
    ],
