    },
    {
      "id": "c-nanshi-025-wangyi:received_sentence6-97",
      "kind": "received_sentence",
      "person_id": "qsd_v11_ya1_AA",
      "source_quote": "仲德曰：「洛陽既敗，虎牢無以自立，理數必然也。",
      "reading": "仲德言二城形勢相屬。",
