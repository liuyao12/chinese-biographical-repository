      "paragraph_id": "c-nanshi-025-wangyi:p005",
      "start_codepoint": 48,
      "end_codepoint": 58,
      "human_reviewed": false
    },
    {
      "id": "c-nanshi-025-wangyi:received_sentence5-58",
      "kind": "received_sentence",
      "person_id": "qsd_v11_ya1_AA",
      "source_quote": "帝深納之。",
      "reading": "劉裕納議。",
