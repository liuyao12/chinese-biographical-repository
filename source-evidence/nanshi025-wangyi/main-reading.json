      "start_codepoint": 58,
      "end_codepoint": 83,
      "human_reviewed": false
    },
    {
      "id": "c-nanshi-025-wangyi:received_sentence6-83",
      "kind": "received_sentence",
      "person_id": "qsd_v11_ya1_AA",
      "source_quote": "彥之聞二城並沒，欲焚舟步走。",
      "reading": "到彥之欲焚舟步走。",
