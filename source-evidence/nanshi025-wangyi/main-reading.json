      "start_codepoint": 0,
      "end_codepoint": 15,
      "human_reviewed": false
    },
    {
      "id": "c-nanshi-025-wangyi:received_sentence5-15",
      "kind": "received_sentence",
      "person_id": "qsd_v11_ya1_AA",
      "source_quote": "仲德曰：「非常之事人所駭，今暴師經載，士有歸心，故當以建鄴為王基。",
      "reading": "仲德以士思歸，主張建鄴為基。",
