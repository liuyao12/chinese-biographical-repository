    },
    {
      "id": "c-nanshi-025-wangyi:received_sentence1-232",
      "kind": "received_sentence",
      "person_id": "qsd_v11_ya1_AA",
      "source_quote": "晉太元末，徙居彭城。",
      "reading": "晉太元末徙居彭城。",
