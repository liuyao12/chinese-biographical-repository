      "start_codepoint": 15,
      "end_codepoint": 48,
      "human_reviewed": false
    },
    {
      "id": "c-nanshi-025-wangyi:received_sentence5-48",
      "kind": "received_sentence",
      "person_id": "qsd_v11_ya1_AA",
      "source_quote": "遷都宜候文軌大同。」",
