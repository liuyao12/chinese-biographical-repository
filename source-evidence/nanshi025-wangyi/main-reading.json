    {
      "id": "c-nanshi-025-wangyi:received_sentence6-0",
      "kind": "received_sentence",
      "person_id": "qsd_v11_ya1_AA",
      "source_quote": "元嘉中，到彥之北侵，仲德同行。",
      "reading": "到彥之北侵，仲德同行。",
      "note": "到彥之北侵，仲德同行。",
