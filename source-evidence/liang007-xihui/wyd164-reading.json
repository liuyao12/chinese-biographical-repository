  "columns": [
    {
      "page": 40,
      "half": "右",
      "column": 8,
      "quote": "高祖德皇后郗氏諱徽高平金鄉人也祖紹國子祭酒"
    },
    {
      "page": 40,
      "half": "右",
      "column": 9,
      "quote": "領東海王師父燁太子舍人早卒初后母尋陽公主方"
    },
    {
      "page": 40,
      "half": "左",
      "column": 4,
      "quote": "以女疾乃止建元末高祖始娉焉生永興公主玉姚永"
    },
    {
      "page": 40,
      "half": "左",
      "column": 5,
      "quote": "世公主玉婉永康公主玉嬛建武五年高祖為雍州刺"
    },
    {
      "page": 40,
      "half": "左",
      "column": 6,
      "quote": "史先之鎮後乃迎后至州未幾永元元年八月殂于襄"
    },
    {
      "page": 40,
      "half": "左",
      "column": 7,
      "quote": "陽官舍時年三十二其年歸葬南徐州南東海武進縣"
    },
    {
      "page": 41,
      "half": "右",
      "column": 4,
      "quote": "皇后詔從之陵曰脩陵后父燁詔贈金紫光祿大夫燁"
    },
    {
      "page": 41,
      "half": "右",
      "column": 5,
      "quote": "尚宋文帝女尋陽公主齊初降封松滋縣君燁子泛中"
    },
    {
      "page": 41,
      "half": "右",
      "column": 6,
      "quote": "軍臨川王記室參軍"
    }
