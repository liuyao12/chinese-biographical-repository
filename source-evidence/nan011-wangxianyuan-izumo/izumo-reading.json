  "columns": [
    {
      "pdf_page": 12,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 2,
      "reading": "孝武文穆王皇后諱憲嫄琅邪臨沂人也元嘉",
      "start_codepoint": 0,
      "end_codepoint": 18
    },
    {
      "pdf_page": 12,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 3,
      "reading": "二十年拜武陵王妃生廢帝豫章王子尚山陰",
      "start_codepoint": 18,
      "end_codepoint": 36
    },
    {
      "pdf_page": 12,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 4,
      "reading": "公主楚玉臨淮康哀公主楚佩皇女楚琇康樂",
      "start_codepoint": 36,
      "end_codepoint": 54
    },
    {
      "pdf_page": 12,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 5,
      "reading": "公主脩明孝武在蕃后甚寵異及即位為皇后",
      "start_codepoint": 54,
      "end_codepoint": 72
    },
    {
      "pdf_page": 12,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 6,
      "reading": "焉大明四年后率六宮躬桑于西郊皇太后觀",
      "start_codepoint": 72,
      "end_codepoint": 90
    },
    {
      "pdf_page": 12,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 7,
      "reading": "禮妃主以下並加班錫廢帝即位尊曰皇太后",
      "start_codepoint": 90,
      "end_codepoint": 108
    },
    {
      "pdf_page": 12,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 8,
      "reading": "宮曰永訓其年崩于含章殿祔葬景寧陵父偃",
      "start_codepoint": 108,
      "end_codepoint": 126
    },
    {
      "pdf_page": 12,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 9,
      "reading": "別有傳",
      "start_codepoint": 126,
      "end_codepoint": 129
    }
  ],
