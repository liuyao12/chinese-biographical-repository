  "columns": [
    {
      "page": 26,
      "half": "左",
      "column": 7,
      "quote": "文沈皇后諱妙容吳興武康人也父法深梁安前中錄"
    },
    {
      "page": 26,
      "half": "左",
      "column": 8,
      "quote": "事參軍后年十歲餘以梁大同中歸于文帝武帝之討"
    },
    {
      "page": 27,
      "half": "右",
      "column": 1,
      "quote": "祿大夫加金章紫綬封建城縣侯諡曰恭追贈后母高"
    },
    {
      "page": 27,
      "half": "右",
      "column": 4,
      "quote": "師知與仲舉恒居禁中參決衆事而宣帝為揚州刺史"
    },
    {
      "page": 27,
      "half": "右",
      "column": 5,
      "quote": "與左右三百人入居尚書省師知忌宣帝權重矯敕令"
    },
    {
      "page": 27,
      "half": "左",
      "column": 6,
      "quote": "初自長安歸于江南頃之卒后兄欽襲爵建城侯位尚"
    },
    {
      "page": 27,
      "half": "左",
      "column": 7,
      "quote": "書左僕射欽素無伎能奉己而已卒諡曰成子觀嗣頗"
    },
    {
      "page": 27,
      "half": "左",
      "column": 8,
      "quote": "有學識官至御史中丞"
    }
  ]
}
