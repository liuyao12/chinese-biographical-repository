  "printed_native": "c-nanshi-024-wangshaozhi-wyd",
  "columns": [
    {
      "column": "42L03",
      "pdf_page": 42,
      "half": "左",
      "leaf": "十三上",
      "column_from_right": 3,
      "start_codepoint": 0,
      "end_codepoint": 21,
      "text": "王韶之字休泰胡之從孫而敬弘從祖弟也祖羨之鎮"
    },
    {
      "column": "42L04",
      "pdf_page": 42,
      "half": "左",
      "leaf": "十三上",
      "column_from_right": 4,
      "start_codepoint": 21,
      "end_codepoint": 42,
      "text": "軍掾父偉之少有志尚當世詔命表奏輒手自書寫泰"
    },
    {
      "column": "42L05",
      "pdf_page": 42,
      "half": "左",
      "leaf": "十三上",
      "column_from_right": 5,
      "start_codepoint": 42,
      "end_codepoint": 63,
      "text": "元隆安時事大小悉撰錄位本國郎中令韶之家貧好"
    },
    {
      "column": "42L06",
      "pdf_page": 42,
      "half": "左",
      "leaf": "十三上",
      "column_from_right": 6,
      "start_codepoint": 63,
      "end_codepoint": 84,
      "text": "學嘗三日絶糧而執卷不輟家人誚之曰困窮如此何"
    },
    {
      "column": "42L07",
      "pdf_page": 42,
      "half": "左",
      "leaf": "十三上",
      "column_from_right": 7,
      "start_codepoint": 84,
      "end_codepoint": 105,
      "text": "不耕答曰我常自耕耳父偉之為烏程令韶之因居縣"
    },
    {
      "column": "42L08",
      "pdf_page": 42,
      "half": "左",
      "leaf": "十三上",
      "column_from_right": 8,
      "start_codepoint": 105,
      "end_codepoint": 126,
      "text": "境好史籍博涉多聞初為衞將軍謝琰行參軍得父舊"
    },
    {
      "column": "42L09",
      "pdf_page": 42,
      "half": "左",
      "leaf": "十三上",
      "column_from_right": 9,
      "start_codepoint": 126,
      "end_codepoint": 147,
      "text": "書因私撰晉安帝陽秋及成時人謂宜居史職即除著"
    },
    {
      "column": "42L10",
      "pdf_page": 42,
      "half": "左",
      "leaf": "十三上",
      "column_from_right": 10,
      "start_codepoint": 147,
      "end_codepoint": 168,
      "text": "作佐郎使續後事訖義熙九年善敘事辭論可觀遷尚"
    },
    {
      "column": "43R01",
      "pdf_page": 43,
      "half": "右",
      "leaf": "十三下",
      "column_from_right": 1,
      "start_codepoint": 168,
      "end_codepoint": 189,
      "text": "書祠部郎晉帝自孝武以來常居內殿武官主書於中"
    },
    {
      "column": "43R02",
      "pdf_page": 43,
      "half": "右",
      "leaf": "十三下",
      "column_from_right": 2,
      "start_codepoint": 189,
      "end_codepoint": 210,
      "text": "通呈以省官一人管詔誥住西省因謂之西省郎傅亮"
    },
    {
      "column": "43R03",
      "pdf_page": 43,
      "half": "右",
      "leaf": "十三下",
      "column_from_right": 3,
      "start_codepoint": 210,
      "end_codepoint": 231,
      "text": "羊徽相代在職義熙十一年宋武帝以韶之博學有文"
    },
    {
      "column": "43R04",
      "pdf_page": 43,
      "half": "右",
      "leaf": "十三下",
      "column_from_right": 4,
      "start_codepoint": 231,
      "end_codepoint": 252,
      "text": "辭補通直郎領西省事轉中書侍郎晉安帝之崩武帝"
    },
    {
      "column": "43R05",
      "pdf_page": 43,
      "half": "右",
      "leaf": "十三下",
      "column_from_right": 5,
      "start_codepoint": 252,
      "end_codepoint": 273,
      "text": "使韶之與帝左右密加酖毒恭帝即位遷黃門侍郎領"
    },
    {
      "column": "43R06",
      "pdf_page": 43,
      "half": "右",
      "leaf": "十三下",
      "column_from_right": 6,
      "start_codepoint": 273,
      "end_codepoint": 294,
      "text": "著作西省如故凡諸詔黃皆其辭也武帝受命加驍騎"
    },
    {
      "column": "43R07",
      "pdf_page": 43,
      "half": "右",
      "leaf": "十三下",
      "column_from_right": 7,
      "start_codepoint": 294,
      "end_codepoint": 315,
      "text": "將軍黃門如故西省職解復掌宋書坐璽制謬誤免黃"
    },
    {
      "column": "43R08",
      "pdf_page": 43,
      "half": "右",
      "leaf": "十三下",
      "column_from_right": 8,
      "start_codepoint": 315,
      "end_codepoint": 336,
      "text": "門事在謝晦傳韶之為晉史序王珣貨殖王廞作亂珣"
    },
    {
      "column": "43R09",
      "pdf_page": 43,
      "half": "右",
      "leaf": "十三下",
      "column_from_right": 9,
      "start_codepoint": 336,
      "end_codepoint": 357,
      "text": "子弘廞子華並貴顯韶之懼為所陷深附結徐羨之傅"
    },
    {
      "column": "43R10",
      "pdf_page": 43,
      "half": "右",
      "leaf": "十三下",
      "column_from_right": 10,
      "start_codepoint": 357,
      "end_codepoint": 378,
      "text": "亮等少帝即位遷侍中出為吳郡太守羨之被誅王弘"
    },
    {
      "column": "43L01",
      "pdf_page": 43,
      "half": "左",
      "leaf": "十四上",
      "column_from_right": 1,
      "start_codepoint": 378,
      "end_codepoint": 399,
      "text": "入相領揚州刺史弘雖與韶之不絶諸弟未相識者皆"
    },
    {
      "column": "43L02",
      "pdf_page": 43,
      "half": "左",
      "leaf": "十四上",
      "column_from_right": 2,
      "start_codepoint": 399,
      "end_codepoint": 420,
      "text": "不復往來韶之在郡常慮為弘所繩夙夜勤勵政績甚"
    },
    {
      "column": "43L03",
      "pdf_page": 43,
      "half": "左",
      "leaf": "十四上",
      "column_from_right": 3,
      "start_codepoint": 420,
      "end_codepoint": 441,
      "text": "美弘亦抑其私憾文帝兩嘉之韶之稱為良守徵為祠"
    },
    {
      "column": "43L04",
      "pdf_page": 43,
      "half": "左",
      "leaf": "十四上",
      "column_from_right": 4,
      "start_codepoint": 441,
      "end_codepoint": 462,
      "text": "部尚書加給事中坐去郡長取送故免官後為吳興太"
    },
    {
      "column": "43L05",
      "pdf_page": 43,
      "half": "左",
      "leaf": "十四上",
      "column_from_right": 5,
      "start_codepoint": 462,
      "end_codepoint": 483,
      "text": "守卒撰孝傳三卷文集行於世宋廟歌辭韶之所制也"
    },
    {
      "column": "43L06",
      "pdf_page": 43,
      "half": "左",
      "leaf": "十四上",
      "column_from_right": 6,
      "start_codepoint": 483,
      "end_codepoint": 490,
      "text": "子曄位臨賀太守"
    }
  ],
