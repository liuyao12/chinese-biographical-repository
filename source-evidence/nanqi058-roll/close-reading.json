  "readings": [
    {
      "id": "c-nanqishu-058-appraisal:source_review1-0",
      "kind": "source_review",
      "person_id": "kix_r92_2ed",
      "source_quote": "史臣曰：書稱「蠻夷猾夏」，蓋總而為言矣。至於南夷雜種，分嶼建國，四方珍怪，莫此為先，藏山隱海，瓌寶溢目。商舶遠屆，委輸南州，故交、廣富實，牣積王府。充斥之事差微，聲教之道可被。若夫用德以懷遠，其在此乎？",
      "reading": "卷末論駐地外國、物產與交廣輸入，以原用語保留史家評述。",
      "note": "卷末論駐地外國、物產與交廣輸入，以原用語保留史家評述。",
      "paragraph_id": "c-nanqishu-058-appraisal:p001",
      "start_codepoint": 0,
      "end_codepoint": 101,
      "human_reviewed": false
    },
    {
      "id": "c-nanqishu-058-appraisal:source_review2-0",
      "kind": "source_review",
      "person_id": "kix_r92_2ed",
      "source_quote": "贊曰：司、雍分壃，荊及衡陽。參錯州部，地有蠻方。東夷海外，碣石、扶桑。南域憬遠，極泛溟滄。非要乃貢，竝亦來王。",
      "reading": "贊中三類地理及職貢書寫以原章收束。",
      "note": "贊中三類地理及職貢書寫以原章收束。",
      "paragraph_id": "c-nanqishu-058-appraisal:p002",
      "start_codepoint": 0,
      "end_codepoint": 55,
      "human_reviewed": false
    }
  ],
  "identity_limits": [
    {
      "source_line": 19,
      "reading": "武陵內史王文和在此事可定位，原文未見仲德世系，暫不按名字接同族王文和。"
    },
    {
      "source_line": 31,
      "reading": "楊舒墓誌原引「又監別將田益宗軍事」，本卷及魏書本傳有田益宗本人入魏與東豫州所任，旁證按各自時段查。"
    },
    {
      "source_line": 64,
      "reading": "梁書及南史敘范諸農為第一位陽邁父，齊書所記諸農則在當根純覆國後復位、永泰元年卒。現保留齊書一案，無同人斷定。"
    },
    {
      "source_line": 82,
      "reading": "交州刺史張牧只依宋末身分，與同名張暢弟的接合尚待該人任交州的引文。"
    }
  ],
