    {
      "id": "c-songshu-092-xuhuo:received_sentence3-0",
      "kind": "received_sentence",
      "person_id": "1b7_36b_29b_A",
      "source_quote": "元嘉初，為始興太守。",
      "reading": "元嘉初治始興。",
      "note": "元嘉初治始興。",
      "paragraph_id": "c-songshu-092-xuhuo:p003",
