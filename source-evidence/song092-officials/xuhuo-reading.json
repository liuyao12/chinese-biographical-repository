    {
      "id": "c-songshu-092-xuhuo:received_sentence2-141",
      "kind": "received_sentence",
      "person_id": "1b7_36b_29b_A",
      "source_quote": "歷二丞三邑，精練明理，為一世所推。",
      "reading": "「二丞三邑」為仕歷合計。",
