    },
    {
      "id": "c-songshu-092-jiangbingzhi:received_sentence2-57",
      "kind": "received_sentence",
      "person_id": "iuq_5o2_wum_AA",
      "source_quote": "宋受禪，隨例為員外散騎侍郎，補太子詹事丞。",
      "reading": "宋受禪後任員外散騎、太子詹事丞。",
      "note": "宋受禪後任員外散騎、太子詹事丞。",
