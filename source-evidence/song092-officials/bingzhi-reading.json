      "end_codepoint": 108,
      "human_reviewed": false
    },
    {
      "id": "c-songshu-092-jiangbingzhi:received_sentence2-108",
      "kind": "received_sentence",
      "person_id": "iuq_5o2_wum_AA",
      "source_quote": "徵建康令，為治嚴察，京邑肅然。",
      "reading": "徵建康令，嚴察著名。",
      "note": "徵建康令，嚴察著名。",
      "paragraph_id": "c-songshu-092-jiangbingzhi:p002",
      "start_codepoint": 108,
