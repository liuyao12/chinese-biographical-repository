      "human_reviewed": false
    },
    {
      "id": "c-songshu-092-jiangbingzhi:received_sentence2-123",
      "kind": "received_sentence",
      "person_id": "iuq_5o2_wum_AA",
      "source_quote": "殷景仁為領軍，請為司馬。",
      "reading": "領軍殷景仁請作司馬。",
      "note": "領軍殷景仁請作司馬。",
