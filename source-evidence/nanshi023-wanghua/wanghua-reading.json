  ],
  "scope_notes": [
    "本傳並未敘述皇室乳養。宋昌是劉義隆引漢初典故比擬王華，奴子是曇冰掩護華逃生時的當面假稱，均無親屬或主奴證力。",
    "南23廞父喪，晉65從兄謐告死所，各存本語。",
    "女將軍與其女人官屬分別標記。數十是杖數，十餘年為時段，兩三人為從者，皆不作人物報齡。"
  ],
  "sentence_readings": [
    {
      "source_line": 51,
      "paragraph_id": "c-nanshi-023-wanghua:p001",
      "start": 0,
      "end": 12,
      "surface": "王華字子陵，誕從祖弟也。",
      "interpretation": "王華名、字及與誕的從祖弟關係。"
    },
    {
      "source_line": 51,
      "paragraph_id": "c-nanshi-023-wanghua:p001",
      "start": 12,
      "end": 24,
      "surface": "祖薈，衛將軍、會稽內史。",
      "interpretation": "祖薈二官。"
    },
    {
      "source_line": 51,
      "paragraph_id": "c-nanshi-023-wanghua:p001",
      "start": 24,
      "end": 33,
      "surface": "父廞，司徒右長史。",
      "interpretation": "父廞，南史右長史。"
    },
    {
      "source_line": 51,
      "paragraph_id": "c-nanshi-023-wanghua:p001",
      "start": 33,
      "end": 57,
      "surface": "晉安帝隆安初，王恭起兵討王國寶，時廞丁母憂在家。",
      "interpretation": "王恭討國寶，廞居母喪。"
    },
    {
      "source_line": 51,
      "paragraph_id": "c-nanshi-023-wanghua:p001",
      "start": 57,
      "end": 85,
      "surface": "恭檄令起兵，廞即聚眾應之，以女為貞烈將軍，以女人為官屬。",
      "interpretation": "徵廞起兵、任女將軍與女官。"
    },
    {
      "source_line": 51,
      "paragraph_id": "c-nanshi-023-wanghua:p001",
      "start": 85,
      "end": 96,
      "surface": "及國寶死，恭檄廞罷兵。",
      "interpretation": "國寶既死，廞奉檄罷兵。"
    },
    {
      "source_line": 51,
      "paragraph_id": "c-nanshi-023-wanghua:p001",
      "start": 96,
      "end": 123,
      "surface": "廞起兵之際，多所誅戮，至是不復得已，因舉兵以討恭為名。",
      "interpretation": "廞舉兵名討恭。"
    },
    {
      "source_line": 51,
      "paragraph_id": "c-nanshi-023-wanghua:p001",
      "start": 123,
      "end": 140,
      "surface": "恭遣劉牢之擊廞，廞敗走，不知所在。",
      "interpretation": "劉牢之擊廞，敗走後失蹤。"
    },
    {
      "source_line": 51,
      "paragraph_id": "c-nanshi-023-wanghua:p001",
      "start": 140,
      "end": 148,
      "surface": "長子泰為恭所殺。",
      "interpretation": "長子泰遇害。"
    },
    {
      "source_line": 51,
      "paragraph_id": "c-nanshi-023-wanghua:p001",
      "start": 148,
      "end": 183,
      "surface": "華時年十三在軍中，與廞相失，隨沙門釋曇冰逃，使提衣襆從後，津邏咸疑焉。",
      "interpretation": "王華十三與父散失，沙門曇冰助逃。"
    },
    {
      "source_line": 51,
      "paragraph_id": "c-nanshi-023-wanghua:p001",
      "start": 183,
      "end": 204,
      "surface": "華行遲，曇冰罵曰：「奴子怠懈，行不及我。」",
      "interpretation": "行遲被罵，假稱奴子。"
    },
    {
      "source_line": 51,
      "paragraph_id": "c-nanshi-023-wanghua:p001",
      "start": 204,
      "end": 221,
      "surface": "以杖捶華數十，眾乃不疑，由此得免。",
      "interpretation": "杖數十使津邏消疑。"
    },
    {
      "source_line": 51,
      "paragraph_id": "c-nanshi-023-wanghua:p001",
      "start": 221,
      "end": 246,
      "surface": "遇赦還吳，以父存沒不測，布衣蔬食，不交遊者十餘年。",
      "interpretation": "受赦返吳，父存亡未卜，布衣十餘年。"
    },
    {
      "source_line": 53,
      "paragraph_id": "c-nanshi-023-wanghua:p002",
      "start": 0,
      "end": 19,
      "surface": "宋武帝欲收其才用，乃發廞喪，使華制服。",
      "interpretation": "武帝使王華行父喪。"
    },
    {
      "source_line": 53,
      "paragraph_id": "c-nanshi-023-wanghua:p002",
      "start": 19,
      "end": 48,
      "surface": "服闋，武帝北伐長安，領鎮西將軍、北徐州刺史，辟華為州主簿。",
      "interpretation": "服除，武帝領二官辟華為主簿。"
    },
    {
      "source_line": 53,
      "paragraph_id": "c-nanshi-023-wanghua:p002",
      "start": 48,
      "end": 58,
      "surface": "後為別駕，曆職著稱。",
      "interpretation": "華繼為別駕。"
    },
    {
      "source_line": 53,
      "paragraph_id": "c-nanshi-023-wanghua:p002",
      "start": 58,
      "end": 76,
      "surface": "文帝鎮江陵，為西中郎主簿、諮議參軍。",
      "interpretation": "華在文帝府任二官。"
    },
    {
      "source_line": 53,
      "paragraph_id": "c-nanshi-023-wanghua:p002",
      "start": 76,
      "end": 90,
      "surface": "文帝未親政事，悉委司馬張邵。",
      "interpretation": "文帝委政張邵。"
    },
    {
      "source_line": 53,
      "paragraph_id": "c-nanshi-023-wanghua:p002",
      "start": 90,
      "end": 102,
      "surface": "華性尚物，不欲人在己前。",
      "interpretation": "華求勝於人。"
    },
    {
      "source_line": 53,
      "paragraph_id": "c-nanshi-023-wanghua:p002",
      "start": 102,
      "end": 114,
      "surface": "邵性豪，每行來常引夾轂。",
      "interpretation": "邵儀從華盛。"
    },
    {
      "source_line": 53,
      "paragraph_id": "c-nanshi-023-wanghua:p002",
      "start": 114,
      "end": 132,
      "surface": "華出入乘牽車，從者不過兩三人以矯之。",
      "interpretation": "華以少從示異。"
    },
    {
      "source_line": 53,
      "paragraph_id": "c-nanshi-023-wanghua:p002",
      "start": 132,
      "end": 162,
      "surface": "嘗相逢，華陽若不知是邵，謂左右曰：「此鹵簿甚盛，必是殿下。」",
      "interpretation": "假呼殿下諷邵。"
    },
    {
      "source_line": 53,
      "paragraph_id": "c-nanshi-023-wanghua:p002",
      "start": 162,
      "end": 177,
      "surface": "乃下牽車立於道側，及邵至乃驚。",
      "interpretation": "華下車示敬。"
    },
    {
      "source_line": 53,
      "paragraph_id": "c-nanshi-023-wanghua:p002",
      "start": 177,
      "end": 199,
      "surface": "邵白服登城，為華所糾，邵坐被征，華代為司馬。",
      "interpretation": "糾邵，華代司馬。"
    },
    {
      "source_line": 55,
      "paragraph_id": "c-nanshi-023-wanghua:p003",
      "start": 0,
      "end": 18,
      "surface": "文帝將入奉大統，以少帝見害，不敢下。",
      "interpretation": "少帝遇害，文帝疑入繼。"
    },
    {
      "source_line": 55,
      "paragraph_id": "c-nanshi-023-wanghua:p003",
      "start": 18,
      "end": 36,
      "surface": "華曰：「先帝有大功于天下，四海所服。",
      "interpretation": "華陳先帝人望。"
    },
    {
      "source_line": 55,
      "paragraph_id": "c-nanshi-023-wanghua:p003",
      "start": 36,
      "end": 47,
      "surface": "雖嗣主不綱，人望未改。",
      "interpretation": "少帝失綱仍有人望。"
    },
    {
      "source_line": 55,
      "paragraph_id": "c-nanshi-023-wanghua:p003",
      "start": 47,
      "end": 77,
      "surface": "徐羨之中才寒士，傅亮布衣諸生，非有晉宣帝、王大將軍之心明矣。",
      "interpretation": "徐傅與晉宣、王敦之比。"
    },
    {
      "source_line": 55,
      "paragraph_id": "c-nanshi-023-wanghua:p003",
      "start": 77,
      "end": 90,
      "surface": "畏廬陵嚴斷，將來必不自容。",
      "interpretation": "廬陵指劉義真。"
    },
    {
      "source_line": 55,
      "paragraph_id": "c-nanshi-023-wanghua:p003",
      "start": 90,
      "end": 124,
      "surface": "殿下寬叡慈仁，天下所知，已且越次奉迎，冀以見德，悠悠之論，殆必不然。",
      "interpretation": "奉迎劉義隆的推測。"
    },
    {
      "source_line": 55,
      "paragraph_id": "c-nanshi-023-wanghua:p003",
      "start": 124,
      "end": 153,
      "surface": "羨之、亮、晦又要檀道濟、王弘五人同功，孰肯相讓，勢必不行。",
      "interpretation": "五名共事者。"
    },
    {
      "source_line": 55,
      "paragraph_id": "c-nanshi-023-wanghua:p003",
      "start": 153,
      "end": 164,
      "surface": "今日就征，萬無所慮。」",
      "interpretation": "華勸赴召。"
    },
    {
      "source_line": 55,
      "paragraph_id": "c-nanshi-023-wanghua:p003",
      "start": 164,
      "end": 182,
      "surface": "帝從之，曰：「卿復欲為吾之宋昌矣。」",
      "interpretation": "文帝以漢宋昌比王華。"
    },
    {
      "source_line": 55,
      "paragraph_id": "c-nanshi-023-wanghua:p003",
      "start": 182,
      "end": 189,
      "surface": "乃留華總後任。",
      "interpretation": "華總後任。"
    },
    {
      "source_line": 57,
      "paragraph_id": "c-nanshi-023-wanghua:p004",
      "start": 0,
      "end": 15,
      "surface": "上即位，以華為侍中、右衛將軍。",
      "interpretation": "文帝授華二官。"
    },
    {
      "source_line": 57,
      "paragraph_id": "c-nanshi-023-wanghua:p004",
      "start": 15,
      "end": 53,
      "surface": "先是，會稽孔甯子為文帝鎮西諮議參軍，以文義見賞，至是為黃門侍郎，領步兵校尉。",
      "interpretation": "孔甯子先後三官。"
    },
    {
      "source_line": 57,
      "paragraph_id": "c-nanshi-023-wanghua:p004",
      "start": 53,
      "end": 83,
      "surface": "甯子先為何無忌安成國侍郎，還東修宅，令門可容高蓋，鄰里笑之。",
      "interpretation": "孔早仕何無忌，造高門。"
    },
    {
      "source_line": 57,
      "paragraph_id": "c-nanshi-023-wanghua:p004",
      "start": 83,
      "end": 97,
      "surface": "甯子曰：「大丈夫何常之有。」",
      "interpretation": "孔答鄰里。"
    },
    {
      "source_line": 57,
      "paragraph_id": "c-nanshi-023-wanghua:p004",
      "start": 97,
      "end": 123,
      "surface": "甯子與華並有富貴之願，自羨之等執權，日夜構之于文帝。",
      "interpretation": "孔、王議論徐等。"
    },
    {
      "source_line": 57,
      "paragraph_id": "c-nanshi-023-wanghua:p004",
      "start": 123,
      "end": 159,
      "surface": "甯子嘗東歸至金昌亭，左右欲泊船，寧子命去之，曰：「此殺君亭，不可泊也。」",
      "interpretation": "孔東歸拒泊金昌亭。"
    },
    {
      "source_line": 57,
      "paragraph_id": "c-nanshi-023-wanghua:p004",
      "start": 159,
      "end": 191,
      "surface": "華每閒居諷詠，常誦王粲登樓賦曰：「冀王道之一平，假高衢而騁力。」",
      "interpretation": "華誦王粲賦。"
    },
    {
      "source_line": 57,
      "paragraph_id": "c-nanshi-023-wanghua:p004",
      "start": 191,
      "end": 216,
      "surface": "出入逢羨之等，每切齒憤叱，歎曰：「當見太平時否？」",
      "interpretation": "華怨徐等。"
    },
    {
      "source_line": 57,
      "paragraph_id": "c-nanshi-023-wanghua:p004",
      "start": 216,
      "end": 225,
      "surface": "元嘉二年，寧子卒。",
      "interpretation": "孔甯子卒。"
    },
    {
      "source_line": 57,
      "paragraph_id": "c-nanshi-023-wanghua:p004",
      "start": 225,
      "end": 233,
      "surface": "三年，誅羨之等。",
      "interpretation": "徐等被誅。"
    },
    {
      "source_line": 57,
      "paragraph_id": "c-nanshi-023-wanghua:p004",
      "start": 233,
      "end": 245,
      "surface": "華遷護軍將軍，侍中如故。",
      "interpretation": "華遷護軍。"
    },
    {
      "source_line": 57,
      "paragraph_id": "c-nanshi-023-wanghua:p004",
      "start": 245,
      "end": 269,
      "surface": "宋世唯華與南陽劉湛不為飾讓，得官即拜，以此為常。",
      "interpretation": "華與劉湛授官即拜。"
    },
    {
      "source_line": 59,
      "paragraph_id": "c-nanshi-023-wanghua:p005",
      "start": 0,
      "end": 13,
      "surface": "華以情事異人，未嘗預宴集。",
      "interpretation": "王華少與宴集。"
    },
    {
      "source_line": 59,
      "paragraph_id": "c-nanshi-023-wanghua:p005",
      "start": 13,
      "end": 25,
      "surface": "終身不飲酒，有宴不之詣。",
      "interpretation": "不飲酒。"
    },
    {
      "source_line": 59,
      "paragraph_id": "c-nanshi-023-wanghua:p005",
      "start": 25,
      "end": 43,
      "surface": "若有論事者，乘車造門，主人出車就之。",
      "interpretation": "乘車與主人論事。"
    },
    {
      "source_line": 59,
      "paragraph_id": "c-nanshi-023-wanghua:p005",
      "start": 43,
      "end": 65,
      "surface": "及王弘輔政，而弘弟曇首為文帝所任，與華相埒。",
      "interpretation": "王弘輔政、曇首受任。"
    },
    {
      "source_line": 59,
      "paragraph_id": "c-nanshi-023-wanghua:p005",
      "start": 65,
      "end": 94,
      "surface": "華常謂己力用不盡，每歎曰：「宰相頓有數人，天下何由得安？」",
      "interpretation": "華歎宰相多人。"
    },
    {
      "source_line": 59,
      "paragraph_id": "c-nanshi-023-wanghua:p005",
      "start": 94,
      "end": 103,
      "surface": "四年卒，年四十三。",
      "interpretation": "四年卒年四十三。"
    },
    {
      "source_line": 59,
      "paragraph_id": "c-nanshi-023-wanghua:p005",
      "start": 103,
      "end": 123,
      "surface": "九年，以誅羨之功，追封新建縣侯，諡曰宣。",
      "interpretation": "九年追封並諡。"
    },
    {
      "source_line": 59,
      "paragraph_id": "c-nanshi-023-wanghua:p005",
      "start": 123,
      "end": 135,
      "surface": "孝武即位，配享文帝廟庭。",
      "interpretation": "配享文帝廟。"
    }
  ]
}
