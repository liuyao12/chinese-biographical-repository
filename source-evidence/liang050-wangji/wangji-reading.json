  "sentence_readings": [
    {
      "paragraph_id": "c-liangshu-050-wangji:p001",
      "first_line": 77,
      "start": 0,
      "end": 12,
      "surface": "王籍字文海，琅邪臨沂人。",
      "interpretation": "籍貫、字。"
    },
    {
      "paragraph_id": "c-liangshu-050-wangji:p001",
      "first_line": 77,
      "start": 12,
      "end": 20,
      "surface": "祖遠，宋光祿勳。",
      "interpretation": "王遠宋官。"
    },
    {
      "paragraph_id": "c-liangshu-050-wangji:p001",
      "first_line": 77,
      "start": 20,
      "end": 30,
      "surface": "父僧祐，齊驍騎將軍。",
      "interpretation": "王僧祐齊官。"
    },
    {
      "paragraph_id": "c-liangshu-050-wangji:p002",
      "first_line": 79,
      "start": 0,
      "end": 7,
      "surface": "籍七歲能屬文。",
      "interpretation": "初學屬文的報齡。"
    },
    {
      "paragraph_id": "c-liangshu-050-wangji:p002",
      "first_line": 79,
      "start": 7,
      "end": 28,
      "surface": "及長，好學博涉，有才氣，樂安任昉見而稱之。",
      "interpretation": "學行與任昉稱譽。"
    },
    {
      "paragraph_id": "c-liangshu-050-wangji:p002",
      "first_line": 79,
      "start": 28,
      "end": 45,
      "surface": "嘗於沈約坐賦得《詠燭》，甚爲約賞。",
      "interpretation": "沈約席上賦詠燭。"
    },
    {
      "paragraph_id": "c-liangshu-050-wangji:p002",
      "first_line": 79,
      "start": 45,
      "end": 63,
      "surface": "齊末，爲冠軍行參軍，累遷外兵、記室。",
      "interpretation": "冠軍行參軍、外兵、記室三項。"
    },
    {
      "paragraph_id": "c-liangshu-050-wangji:p002",
      "first_line": 79,
      "start": 63,
      "end": 84,
      "surface": "天監初，除安成王主簿、尚書三公郎、廷尉正。",
      "interpretation": "安成王主簿、尚書三公郎、廷尉正。"
    },
    {
      "paragraph_id": "c-liangshu-050-wangji:p002",
      "first_line": 79,
      "start": 84,
      "end": 97,
      "surface": "歷餘姚、錢塘令，並以放免。",
      "interpretation": "二縣共有令字，並以放免。"
    },
    {
      "paragraph_id": "c-liangshu-050-wangji:p002",
      "first_line": 79,
      "start": 97,
      "end": 116,
      "surface": "久之，除輕車湘東王諮議參軍，隨府會稽。",
      "interpretation": "隨湘東王府會稽。"
    },
    {
      "paragraph_id": "c-liangshu-050-wangji:p002",
      "first_line": 79,
      "start": 116,
      "end": 137,
      "surface": "郡境有雲門、天柱山，籍嘗遊之，或累月不反。",
      "interpretation": "遊雲門、天柱二山。"
    },
    {
      "paragraph_id": "c-liangshu-050-wangji:p002",
      "first_line": 79,
      "start": 137,
      "end": 162,
      "surface": "至若邪溪賦詩，其略云：「蟬噪林逾靜，鳥鳴山更幽。」",
      "interpretation": "溪上詩引二句。"
    },
    {
      "paragraph_id": "c-liangshu-050-wangji:p002",
      "first_line": 79,
      "start": 162,
      "end": 171,
      "surface": "當時以爲文外獨絕。",
      "interpretation": "未名時評。"
    },
    {
      "paragraph_id": "c-liangshu-050-wangji:p002",
      "first_line": 79,
      "start": 171,
      "end": 203,
      "surface": "還爲大司馬從事中郎，遷中散大夫，尤不得志，遂徒行市道，不擇交遊。",
      "interpretation": "還後兩官，不得志而徒行交遊。"
    },
    {
      "paragraph_id": "c-liangshu-050-wangji:p002",
      "first_line": 79,
      "start": 203,
      "end": 225,
      "surface": "湘東王爲荊州，引爲安西府諮議參軍，帶作塘令。",
      "interpretation": "安西王府，兼管作塘。"
    },
    {
      "paragraph_id": "c-liangshu-050-wangji:p002",
      "first_line": 79,
      "start": 225,
      "end": 244,
      "surface": "不理縣事，日飲酒，人有訟者，鞭而遣之。",
      "interpretation": "縣政、日飲酒與鞭遣訟者。"
    },
    {
      "paragraph_id": "c-liangshu-050-wangji:p002",
      "first_line": 79,
      "start": 244,
      "end": 249,
      "surface": "少時，卒。",
      "interpretation": "任後短時而卒；未明卒齡月日。"
    },
    {
      "paragraph_id": "c-liangshu-050-wangji:p002",
      "first_line": 79,
      "start": 249,
      "end": 255,
      "surface": "文集行於世。",
      "interpretation": "著作流傳。"
    },
    {
      "paragraph_id": "c-liangshu-050-wangji:p003",
      "first_line": 81,
      "start": 0,
      "end": 8,
      "surface": "子碧，亦有文才，",
      "interpretation": "碧是王籍子，亦具文才。"
    },
    {
      "paragraph_id": "c-liangshu-050-wangji:p003",
      "first_line": 81,
      "start": 8,
      "end": 12,
      "surface": "先籍卒。",
      "interpretation": "碧先父卒。"
    }
  ],
