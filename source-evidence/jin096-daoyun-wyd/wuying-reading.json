{
  "pdf_url": "https://upload.wikimedia.org/wikipedia/commons/9/9f/NLC016-HWRB201817005-3297_%E6%99%89%E6%9B%B8_%E4%B8%80%E7%99%BE%E4%B8%89%E5%8D%81%E5%8D%B7_%E9%9F%B3%E7%BE%A9%E4%B8%89%E5%8D%B7_%E7%AC%AC24%E5%86%8A.pdf",
  "catalog_permalink": "https://commons.wikimedia.org/w/index.php?oldid=979438884",
  "file_description_revision": 979438884,
  "pdf_sha256": "ff08156359a3ee0208f78f95bdfc362de20de3705b115afbedaba2debfa40aaa",
  "column_file": "source-evidence/jin096-daoyun-wyd/wyd-columns.txt",
  "column_file_sha256": "505fb3b94d3ff23f1894b6d47f41de271453de9bd7574c3e2c60333ec3e61159",
  "columns": [
    {
      "pdf_page": 50,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 7,
      "reading": "王凝之妻謝氏字道韞安西將軍奕之女也聰識有才",
      "start_codepoint": 0,
      "end_codepoint": 21
    },
    {
      "pdf_page": 50,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 8,
      "reading": "辯叔父安嘗問毛詩何句最佳道韞稱吉甫作頌穆如",
      "start_codepoint": 21,
      "end_codepoint": 42
    },
    {
      "pdf_page": 50,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 9,
      "reading": "清風仲山甫永懷以慰其心安謂有雅人深致又嘗內",
      "start_codepoint": 42,
      "end_codepoint": 63
    },
    {
      "pdf_page": 50,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 10,
      "reading": "集俄而雪驟下安曰何所似也安兄子朗曰散鹽空中",
      "start_codepoint": 63,
      "end_codepoint": 84
    },
    {
      "pdf_page": 51,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 1,
      "reading": "差可擬道韞曰未若柳絮因風起安大悅初適凝之還",
      "start_codepoint": 84,
      "end_codepoint": 105
    },
    {
      "pdf_page": 51,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 2,
      "reading": "甚不樂安曰王郎逸少子不惡汝何恨也答曰一門叔",
      "start_codepoint": 105,
      "end_codepoint": 126
    },
    {
      "pdf_page": 51,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 3,
      "reading": "父則有阿大中郎羣從兄弟復有封胡羯末不意天壤",
      "start_codepoint": 126,
      "end_codepoint": 147
    },
    {
      "pdf_page": 51,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 4,
      "reading": "之中乃有王郎封謂謝歆胡謂謝朗羯謂謝玄末謂謝",
      "start_codepoint": 147,
      "end_codepoint": 168
    },
    {
      "pdf_page": 51,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 5,
      "reading": "川皆其小字也又嘗議玄學植不進曰為塵務經心為",
      "start_codepoint": 168,
      "end_codepoint": 189
    },
    {
      "pdf_page": 51,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 6,
      "reading": "天分有限邪凝之弟獻之嘗與賓客談議詞理將屈道",
      "start_codepoint": 189,
      "end_codepoint": 210
    },
    {
      "pdf_page": 51,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 7,
      "reading": "韞遣婢白獻之曰欲為小郎解圍乃施青綾步鄣自蔽",
      "start_codepoint": 210,
      "end_codepoint": 231
    },
    {
      "pdf_page": 51,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 8,
      "reading": "申獻之前議客不能屈及遭孫恩之難舉厝自若既聞",
      "start_codepoint": 231,
      "end_codepoint": 252
    },
    {
      "pdf_page": 51,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 9,
      "reading": "夫及諸子已為賊所害方命婢肩輿抽刃出門亂兵稍",
      "start_codepoint": 252,
      "end_codepoint": 273
    },
    {
      "pdf_page": 51,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 10,
      "reading": "至手殺數人乃被虜其外孫劉濤時年數歲賊又欲害",
      "start_codepoint": 273,
      "end_codepoint": 294
    },
    {
      "pdf_page": 51,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 1,
      "reading": "之道韞曰事在王門何關他族必其如此寧先見殺恩",
      "start_codepoint": 294,
      "end_codepoint": 315
    },
    {
      "pdf_page": 51,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 2,
      "reading": "雖毒虐為之改容乃不害濤自爾嫠居會稽家中莫不",
      "start_codepoint": 315,
      "end_codepoint": 336
    },
    {
      "pdf_page": 51,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 3,
      "reading": "嚴肅太守劉柳聞其名請與談議道韞素知柳名亦不",
      "start_codepoint": 336,
      "end_codepoint": 357
    },
    {
      "pdf_page": 51,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 4,
      "reading": "自阻乃簪髻素褥坐於帳中柳束脩整帶造于別榻道",
      "start_codepoint": 357,
      "end_codepoint": 378
    },
    {
      "pdf_page": 51,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 5,
      "reading": "韞風韻高邁敘致清雅先及家事慷慨流漣徐酬問旨",
      "start_codepoint": 378,
      "end_codepoint": 399
    },
    {
      "pdf_page": 51,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 6,
      "reading": "詞理無滯柳退而歎曰實頃所未見瞻察言氣使人心",
      "start_codepoint": 399,
      "end_codepoint": 420
    },
    {
      "pdf_page": 51,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 7,
      "reading": "形俱服道韞亦云親從凋亡始遇此士聽其所問殊開",
      "start_codepoint": 420,
      "end_codepoint": 441
    },
    {
      "pdf_page": 51,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 8,
      "reading": "人胸府初同郡張玄妹亦有才質適於顧氏玄每稱之",
      "start_codepoint": 441,
      "end_codepoint": 462
    },
    {
      "pdf_page": 51,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 9,
      "reading": "以敵道韞有濟尼者游於二家或問之濟尼答曰王夫",
      "start_codepoint": 462,
      "end_codepoint": 483
    },
    {
      "pdf_page": 51,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 10,
      "reading": "人神情散朗故有林下風氣顧家婦清心玉映自是閨",
      "start_codepoint": 483,
      "end_codepoint": 504
    },
    {
      "pdf_page": 52,
      "half": "右",
      "leaf": "十下",
      "column_from_right": 1,
      "reading": "房之秀道韞所著詩賦誄頌並傳於世",
      "start_codepoint": 504,
      "end_codepoint": 519
    }
  ],
