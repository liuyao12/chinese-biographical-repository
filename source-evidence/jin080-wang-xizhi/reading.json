  "comparisons": [
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line014",
        "start": 191,
        "end": 196,
        "quote": "王承、王悅"
      },
      "witnesses": [
        {
          "witness": "shang",
          "quote": "阮光祿云：「王家有三年少：右軍、安期、長豫。」",
          "source_layer": "正文",
          "raw_start": 13702,
          "raw_end": 13725,
          "raw_line": 103
        },
        {
          "witness": "shang",
          "quote": "阮裕、王悅、安期、王應並已見。",
          "source_layer": "劉注自案",
          "raw_start": 13729,
          "raw_end": 13744,
          "raw_line": 103
        },
        {
          "witness": "shi",
          "quote": "{{ProperNoun|應}}字{{ProperNoun|安期}}，{{ProperNoun|含}}子也。",
          "source_layer": "劉注引晉陽秋",
          "raw_start": 8555,
          "raw_end": 8609,
          "raw_line": 17
        },
        {
          "witness": "jin75",
          "quote": "承字安期。清虛寡欲",
          "source_layer": "正文",
          "raw_start": 918,
          "raw_end": 927,
          "raw_line": 18
        },
        {
          "witness": "duan",
          "quote": "與王承、王沉為王氏三少",
          "source_layer": "正文",
          "raw_start": 4032,
          "raw_end": 4043,
          "raw_line": 62
        }
      ],
      "reading": "王悅字長豫；第二人兩個安期並存。卷80及書斷寫王承，世說注另提王應。書斷又以沉代悅；卷80不改字。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line014",
        "start": 262,
        "end": 266,
        "quote": "獨若不聞"
      },
      "witnesses": [
        {
          "witness": "ya",
          "quote": "唯有一郎，在東床上坦腹臥，如不聞。",
          "source_layer": "正文",
          "raw_start": 8057,
          "raw_end": 8074,
          "raw_line": 21
        },
        {
          "witness": "ya",
          "quote": "{{ProperNoun|逸少}}，{{ProperNoun|羲之}}小字。{{ProperNoun|羲之}}妻，太傅{{ProperNoun|郗-{鑒}-}}女，名{{ProperNoun|璿}}，字{{ProperNoun|子房}}。",
          "source_layer": "劉注引王氏譜",
          "raw_start": 8145,
          "raw_end": 8264,
          "raw_line": 21
        },
        {
          "witness": "yu860",
          "quote": "羲之獨坦腹東床，齧胡餅，神色自若。",
          "source_layer": "正文",
          "raw_start": 1028,
          "raw_end": 1045,
          "raw_line": 34
        }
      ],
      "reading": "晉書坦腹食，世說雅量作臥，御覽所引作齧胡餅。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line014",
        "start": 147,
        "end": 155,
        "quote": "時陳留阮裕有重名"
      },
      "witnesses": [
        {
          "witness": "ruan",
          "quote": "裕字思曠。",
          "source_layer": "正文",
          "raw_start": 5381,
          "raw_end": 5386,
          "raw_line": 91
        },
        {
          "witness": "ruan",
          "quote": "大將軍王敦命爲主簿，甚被知遇。",
          "source_layer": "正文",
          "raw_start": 5410,
          "raw_end": 5425,
          "raw_line": 91
        },
        {
          "witness": "shang",
          "quote": "阮裕少有德行，王敦聞其名，召為主簿",
          "source_layer": "劉注引中興書",
          "raw_start": 9977,
          "raw_end": 9994,
          "raw_line": 62
        }
      ],
      "reading": "王敦主簿、陳留阮裕；與阮韜玄祖金紫光祿大夫裕及世說阮光祿互證。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line016",
        "start": 266,
        "end": 271,
        "quote": "尚子平之志"
      },
      "witnesses": [
        {
          "witness": "xiang",
          "quote": "向長字子平",
          "source_layer": "正文",
          "raw_start": 2150,
          "raw_end": 2155,
          "raw_line": 17
        },
        {
          "witness": "xiang",
          "quote": "《[[高士傳]]》「向」字作「尚。」",
          "source_layer": "李賢注",
          "raw_start": 2160,
          "raw_end": 2178,
          "raw_line": 17
        },
        {
          "witness": "xiang",
          "quote": "嫁旣畢，勑斷家事勿相關，當如我死也。",
          "source_layer": "正文",
          "raw_start": 2346,
          "raw_end": 2364,
          "raw_line": 17
        }
      ],
      "reading": "向長字子平，後漢書逸民傳注載高士傳作尚。羲之說兒娶女嫁後有其志。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line018",
        "start": 88,
        "end": 97,
        "quote": "浩遂行果為姚襄所敗"
      },
      "witnesses": [
        {
          "witness": "mu",
          "quote": "===永和九年===",
          "source_layer": "年題",
          "raw_start": 3851,
          "raw_end": 3861,
          "raw_line": 169
        },
        {
          "witness": "mu",
          "quote": "冬十月，中軍將軍殷浩進次山桑，使平北將軍姚襄爲前鋒，襄叛，反擊浩，浩棄輜重，退保譙城。",
          "source_layer": "正文",
          "raw_start": 4112,
          "raw_end": 4155,
          "raw_line": 182
        }
      ],
      "reading": "穆帝紀永和九年冬十月記山桑役。此年同蘭亭，戰事與春禊分開。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line052",
        "start": 49,
        "end": 60,
        "quote": "孫綽、李充、許詢、支遁"
      },
      "witnesses": [
        {
          "witness": "li",
          "quote": "李充，字弘度，江夏人。父矩，江州刺史。",
          "source_layer": "正文",
          "raw_start": 9932,
          "raw_end": 9951,
          "raw_line": 128
        }
      ],
      "reading": "李充為江夏人弘度，許詢與後文許邁有別。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line066",
        "start": 287,
        "end": 303,
        "quote": "維永和十一年三月癸卯朔，九日辛亥"
      },
      "witnesses": [
        {
          "witness": "mu",
          "quote": "===永和十一年===",
          "source_layer": "本紀年題",
          "raw_start": 4675,
          "raw_end": 4686,
          "raw_line": 201
        }
      ],
      "reading": "自誓書直記年、月、朔干支及該月初九，不以本紀年題補造同日事件。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line078",
        "start": 75,
        "end": 84,
        "quote": "陸賈、班嗣、楊王孫"
      },
      "witnesses": [
        {
          "witness": "yang",
          "quote": "楊王孫者，孝武時人也。學黃老之術",
          "source_layer": "正文",
          "raw_start": 183,
          "raw_end": 199,
          "raw_line": 10
        }
      ],
      "reading": "致謝萬書所嚮往前人，非同遊者。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line082",
        "start": 0,
        "end": 5,
        "quote": "年五十九卒"
      },
      "witnesses": [
        {
          "witness": "duan",
          "quote": "初度浙江，便有終焉之志。昇平五年卒，年五十九，贈金紫光祿大夫加常侍。",
          "source_layer": "正文",
          "raw_start": 4061,
          "raw_end": 4095,
          "raw_line": 62
        }
      ],
      "reading": "晉書年五十九而未繫年；唐書斷明記昇平五年。後世年譜各考，原文兩層皆保留，未據報齡倒推確定生年。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line014",
        "start": 16,
        "end": 22,
        "quote": "祖正，尚書郎"
      },
      "witnesses": [
        {
          "witness": "xin",
          "quote": "覽字玄通，晉宗正卿、即丘貞子。六子：栽、基、會、正、彥、琛。栽字士初，撫軍長史，襲即丘子。三子：導、穎、敞。",
          "source_layer": "正文",
          "raw_start": 502,
          "raw_end": 556,
          "raw_line": 12
        }
      ],
      "reading": "宋修新唐書世系表列正及導所自之栽，卷八十只稱正為羲之祖，兩書所出及世次分開。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line020",
        "start": 0,
        "end": 5,
        "quote": "知安西敗喪"
      },
      "witnesses": [
        {
          "witness": "mu",
          "quote": "安西將軍謝尚帥姚襄與張遇戰于許昌之誡橋，王師敗績。",
          "source_layer": "正文",
          "raw_start": 3587,
          "raw_end": 3612,
          "raw_line": 159
        },
        {
          "witness": "mu",
          "quote": "中軍將軍殷浩進次山桑，使平北將軍姚襄爲前鋒，襄叛，反擊浩",
          "source_layer": "正文",
          "raw_start": 4116,
          "raw_end": 4144,
          "raw_line": 182
        }
      ],
      "reading": "致殷浩書的受者為中軍將軍。此處安西最合安西將軍謝尚，穆帝紀分記永和八年謝尚誡橋及九年殷浩山桑。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line082",
        "start": 14,
        "end": 20,
        "quote": "諸子遵父先旨"
      },
      "witnesses": [
        {
          "witness": "duan",
          "quote": "有七子，獻之最知名。玄之、凝之、徽之、操之並工草隸。",
          "source_layer": "正文",
          "raw_start": 4287,
          "raw_end": 4313,
          "raw_line": 62
        },
        {
          "witness": "ys",
          "quote": "子七人，凝之、涣之、徽之、操之、献之，皆有書迹传世。玄之、肃之二人未見。",
          "source_layer": "正文",
          "raw_start": 4068,
          "raw_end": 4104,
          "raw_line": 71
        }
      ],
      "reading": "卷八十正史分列見於本卷的五子；書斷記七子而此句僅具五名，明人列全七名且稱其書跡傳否。肅之另有世說劉注直接譜證。渙之僅保留此晚出具名證據，未知排行。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line040",
        "start": 40,
        "end": 50,
        "quote": "又遺尚書僕射謝安書曰"
      },
      "witnesses": [
        {
          "witness": "jz",
          "quote": "《惜抱軒筆記》曰：「逸少在會稽，謝安尙爲處士，未出也，此必是與謝尙仁祖書，此或由雕本字誤。」",
          "source_layer": "斠注引清姚鼐",
          "raw_start": 378,
          "raw_end": 424,
          "raw_line": 2
        },
        {
          "witness": "jz",
          "quote": "《諸史拾遺》曰：「羲之任會稽內史日，謝安未爲僕射，當是『謝尙』之譌。",
          "source_layer": "斠注引清陳景雲",
          "raw_start": 424,
          "raw_end": 458,
          "raw_line": 2
        },
        {
          "witness": "mu",
          "quote": "夏四月，以安西將軍謝尚爲尚書僕射。",
          "source_layer": "正文",
          "raw_start": 3944,
          "raw_end": 3961,
          "raw_line": 174
        },
        {
          "witness": "j79",
          "quote": "永和中，拜尚書僕射，出為都督江西淮南諸軍事",
          "source_layer": "正文",
          "raw_start": 1454,
          "raw_end": 1475,
          "raw_line": 19
        },
        {
          "witness": "j79",
          "quote": "尋為尚書僕射，領吏部，加後將軍。",
          "source_layer": "正文",
          "raw_start": 2793,
          "raw_end": 2809,
          "raw_line": 37
        }
      ],
      "reading": "本卷題署謝安，殿本同。清姚鼐、陳景雲各校為謝尚；穆帝紀、謝尚傳有同期任官。謝安傳另有其本人的僕射任，不能據卷八十場景建立當時的謝安在任。"
    }
  ],
  "items": [
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line014",
        "start": 287,
        "end": 292,
        "quote": "遂以女妻之"
      },
      "reading": "雅量劉注引王氏譜明言名璿、字子房，又以逸少為羲之小字，晉書作字。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line016",
        "start": 259,
        "end": 263,
        "quote": "兒娶女嫁"
      },
      "reading": "家累總稱，未指定某子、某女及其配偶。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line018",
        "start": 9,
        "end": 16,
        "quote": "求宣城郡，不許"
      },
      "reading": "求職未許，另授右軍將軍、會稽內史。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line052",
        "start": 74,
        "end": 79,
        "quote": "與羲之同好"
      },
      "reading": "東土同好具名，下一句宴集只稱同志；須另核當日參加者。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line062",
        "start": 2,
        "end": 10,
        "quote": "潘岳《金谷詩序》"
      },
      "reading": "傳記所載他人以兩篇序比擬，非同時結交。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line064",
        "start": 7,
        "end": 10,
        "quote": "孤居姥"
      },
      "reading": "養鵝的孤居姥與賣扇老姥、山陰道士、門生及其父分見各敘事，皆未具名。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line066",
        "start": 332,
        "end": 336,
        "quote": "母兄鞠育"
      },
      "reading": "自誓追述母、兄鞠育，兩人皆未具名。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line068",
        "start": 23,
        "end": 32,
        "quote": "與道士許邁共修服食"
      },
      "reading": "本卷許邁附傳收其致羲之書；與下一段許詢分名。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line070",
        "start": 67,
        "end": 73,
        "quote": "令巢許遇稷契"
      },
      "reading": "以巢父許由及稷契作反事實對舉，非同時人。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line076",
        "start": 15,
        "end": 22,
        "quote": "率諸子，抱弱孫"
      },
      "reading": "無法由此句確定被抱孫名或孫父。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line080",
        "start": 115,
        "end": 122,
        "quote": "萬不能用，果敗"
      },
      "reading": "此段無戰敗年月，世系與軍職分開。"
    }
  ],
