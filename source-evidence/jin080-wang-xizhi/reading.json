  "material_witness": {
    "title": "晉王羲之快雪時晴帖　冊",
    "museum": "國立故宮博物院",
    "item_number": "故書00014100000",
    "url": "https://digitalarchive.npm.gov.tw/Collection/Detail/19?dep=P",
    "material": "唐代精摹本",
    "inscription": "羲之頓首。快雪時晴。佳想安善。未果為結。力不次。王羲之頓首。山陰張侯。",
    "reading": "本幅自署羲之、王羲之。末行山陰張侯，姓名未詳。清乾隆題籤及後副葉題跋另成後世收藏層。"
  },
