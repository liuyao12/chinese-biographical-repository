{
  "pdf_url": "https://upload.wikimedia.org/wikipedia/commons/6/6a/NAJDA-280-0079_%E5%8D%97%E5%8F%B27.pdf",
  "catalog_permalink": "https://commons.wikimedia.org/w/index.php?oldid=1298729844",
  "file_description_revision": 1298729844,
