  "column_file": "source-evidence/nan011-wangzhenfeng-izumo/izumo-columns.txt",
  "column_file_sha256": "80c2b36684dc90339438687348b987e2c3388212c5127da7c3e4b85e39544fb3",
  "columns": [
    {
      "pdf_page": 15,
      "half": "右",
      "leaf": "十二下",
      "column_from_right": 1,
      "reading": "明恭王皇后諱貞風琅邪臨沂人也初拜淮陽",
      "start_codepoint": 0,
      "end_codepoint": 18
    },
    {
      "pdf_page": 15,
      "half": "右",
      "leaf": "十二下",
      "column_from_right": 2,
      "reading": "王妃明帝改封又為湘東王妃生晉陵長公主",
      "start_codepoint": 18,
      "end_codepoint": 36
    },
    {
      "pdf_page": 15,
      "half": "右",
      "leaf": "十二下",
      "column_from_right": 3,
      "reading": "伯姒建安長公主伯媛明帝即位立為皇后上",
      "start_codepoint": 36,
      "end_codepoint": 54
    },
    {
      "pdf_page": 15,
      "half": "右",
      "leaf": "十二下",
      "column_from_right": 4,
      "reading": "嘗宮內大集而裸婦人觀之以為歡笑后以扇",
      "start_codepoint": 54,
      "end_codepoint": 72
    },
    {
      "pdf_page": 15,
      "half": "右",
      "leaf": "十二下",
      "column_from_right": 5,
      "reading": "鄣面獨無所言帝怒曰外舍家寒乞今共作笑",
      "start_codepoint": 72,
      "end_codepoint": 90
    },
    {
      "pdf_page": 15,
      "half": "右",
      "leaf": "十二下",
      "column_from_right": 6,
      "reading": "樂何獨不視后曰為樂之事其方自多豈有姑",
      "start_codepoint": 90,
      "end_codepoint": 108
    },
    {
      "pdf_page": 15,
      "half": "右",
      "leaf": "十二下",
      "column_from_right": 7,
      "reading": "姊妹集聚而裸婦人形體以此為樂外舍為歡",
      "start_codepoint": 108,
      "end_codepoint": 126
    },
    {
      "pdf_page": 15,
      "half": "右",
      "leaf": "十二下",
      "column_from_right": 8,
      "reading": "適與此不同帝大怒令后起后兄揚州刺史景",
      "start_codepoint": 126,
      "end_codepoint": 144
    },
    {
      "pdf_page": 15,
      "half": "右",
      "leaf": "十二下",
      "column_from_right": 9,
      "reading": "文以此事語從舅陳郡謝綽曰后在家為儜弱",
      "start_codepoint": 144,
      "end_codepoint": 162
    },
    {
      "pdf_page": 15,
      "half": "左",
      "leaf": "十三上",
      "column_from_right": 1,
      "reading": "婦人不知今段遂能剛正如此廢帝即位尊為",
      "start_codepoint": 162,
      "end_codepoint": 180
    },
    {
      "pdf_page": 15,
      "half": "左",
      "leaf": "十三上",
      "column_from_right": 2,
      "reading": "皇太后宮曰弘訓廢帝失德太后每加勗譬始",
      "start_codepoint": 180,
      "end_codepoint": 198
    },
    {
      "pdf_page": 15,
      "half": "左",
      "leaf": "十三上",
      "column_from_right": 3,
      "reading": "猶見順後狂慝稍甚太后嘗賜帝玉柄毛扇帝",
      "start_codepoint": 198,
      "end_codepoint": 216
    },
    {
      "pdf_page": 15,
      "half": "左",
      "leaf": "十三上",
      "column_from_right": 4,
      "reading": "嫌毛扇不華因此欲加酖害令太醫煑藥左右",
      "start_codepoint": 216,
      "end_codepoint": 234
    },
    {
      "pdf_page": 15,
      "half": "左",
      "leaf": "十三上",
      "column_from_right": 5,
      "reading": "止之曰若行此事官便作孝子豈得出入狡獪",
      "start_codepoint": 234,
      "end_codepoint": 252
    },
    {
      "pdf_page": 15,
      "half": "左",
      "leaf": "十三上",
      "column_from_right": 6,
      "reading": "帝曰汝語大有理乃止順帝即位齊高帝執權",
      "start_codepoint": 252,
      "end_codepoint": 270
    },
    {
      "pdf_page": 15,
      "half": "左",
      "leaf": "十三上",
      "column_from_right": 7,
      "reading": "宗室劉晃劉綽卜伯興等有異志太后頗與相",
      "start_codepoint": 270,
      "end_codepoint": 288
    },
    {
      "pdf_page": 15,
      "half": "左",
      "leaf": "十三上",
      "column_from_right": 8,
      "reading": "關順帝禪位太后與帝遜于東邸因遷居丹楊",
      "start_codepoint": 288,
      "end_codepoint": 306
    },
    {
      "pdf_page": 15,
      "half": "左",
      "leaf": "十三上",
      "column_from_right": 9,
      "reading": "宮拜汝陰王太妃順帝殂于丹楊更立第都下",
      "start_codepoint": 306,
      "end_codepoint": 324
    },
    {
      "pdf_page": 16,
      "half": "右",
      "leaf": "十三下",
      "column_from_right": 1,
      "reading": "建元元年薨于第追加諡葬以宋禮后父僧朗",
      "start_codepoint": 324,
      "end_codepoint": 342
    },
    {
      "pdf_page": 16,
      "half": "右",
      "leaf": "十三下",
      "column_from_right": 2,
      "reading": "別有傳",
      "start_codepoint": 342,
      "end_codepoint": 345
    }
  ],
