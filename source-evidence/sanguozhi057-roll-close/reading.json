  "nested_sources": {
    "heading": "虞翻",
    "account": "朱育",
    "source": "裴注引會稽典錄",
    "narrative_levels": [
      "濮陽興問，朱育答。",
      "朱育轉述王朗問虞翻；王府君笑曰與翻對曰相應。",
      "濮陽府君曰以下復為濮陽興問朱育，陳業至柳硃翟素等出自育答。"
    ],
    "unresolved": [
      "兩女分記原詞「或」，不指定何人逢寇。",
      "原只寫鄭公、朱公，不以姓官自行補名。",
      "「太平三年」「歲在丁丑」「積百二十九歲」保留各自原字，未換算或調整。"
    ],
    "source_corrections": [
      "「鄮莫候反」中莫候為反切用字。",
      "「靡不育焉」育為動詞。",
      "丁覽「守始平长」的平屬地名，徐平之名見後文「陵子平」。"
    ]
  },
  "other_topics": [
    "虞汜各弟屬合題子汜等，虞潭有晉陽秋記品行官歷，以其名設子題下無題附敘。",
    "張溫所附駱統申理表歸該傳，駱統另有本傳。",
    "裴引吳錄、晉陽秋間分載陸曄、陸玩，連續段各有原界。",
    "作者評七人獨立為專章，清冊傳目四階段與史評覆核另記。"
  ],
