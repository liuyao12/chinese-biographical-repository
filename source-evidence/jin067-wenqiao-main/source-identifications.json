  "source_clauses": [
    {
      "witness": "j81",
      "quote": "及蘇峻反，平南將軍溫嶠遣嶽與督護王愆期、鄱陽太守紀睦等率舟軍赴難。",
      "raw_start": 11710,
      "raw_end": 11743,
      "raw_line": 137
    },
    {
      "witness": "j81",
      "quote": "王敦素與胤交，甚欽貴之，請為右司馬。胤知敦有不臣心，枕疾不視事，以是忤敦意",
      "raw_start": 2590,
      "raw_end": 2627,
      "raw_line": 29
    },
    {
      "witness": "j81",
      "quote": "含敗，隨丹陽尹溫嶠追含至於淮南",
      "raw_start": 11219,
      "raw_end": 11234,
      "raw_line": 127
    },
    {
      "witness": "j81",
      "quote": "蘇峻作亂，溫嶠率眾而下，留胤等守溢口。事平，以勳賜爵豐城子。俄而代嶠為平南將軍、都督江州諸軍事、領江州刺史、假節。",
      "raw_start": 2706,
      "raw_end": 2763,
      "raw_line": 29
    },
    {
      "witness": "j44",
      "quote": "父恭，濟南太守。兄弟六人並知名於世，號曰「六龍」。",
      "raw_start": 9582,
      "raw_end": 9607,
      "raw_line": 122
    },
    {
      "witness": "tang",
      "quote": "生濟南太守恭。恭二子：羨、憺。",
      "raw_start": 31810,
      "raw_end": 31825,
      "raw_line": 836
    }
  ],
