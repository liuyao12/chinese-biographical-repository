  "source_clauses": [
    {
      "witness": "sg",
      "quote": "十（一）年卒，子協嗣，統騭所領",
      "raw_start": 13424,
      "raw_end": 13439,
      "raw_line": 110
    },
    {
      "witness": "sg",
      "quote": "協卒，子璣嗣侯。協弟闡",
      "raw_start": 13446,
      "raw_end": 13457,
      "raw_line": 110
    },
    {
      "witness": "sg",
      "quote": "遣璣與弟璿詣洛陽爲任",
      "raw_start": 13528,
      "raw_end": 13538,
      "raw_line": 110
    },
    {
      "witness": "sg",
      "quote": "{{另|斬|擒斬}}闡等，歩氏泯滅，惟璿紹祀。",
      "raw_start": 13657,
      "raw_end": 13680,
      "raw_line": 110
    },
    {
      "witness": "s47",
      "quote": "十年春正月，右大司馬全琮卒。",
      "raw_start": 22898,
      "raw_end": 22912,
      "raw_line": 127
    },
    {
      "witness": "s47",
      "quote": "夏五月，丞相步騭卒。",
      "raw_start": 23142,
      "raw_end": 23152,
      "raw_line": 127
    },
    {
      "witness": "s48",
      "quote": "闡及同計數十人皆夷三族。",
      "raw_start": 11993,
      "raw_end": 12005,
      "raw_line": 72
    },
    {
      "witness": "s49",
      "quote": "士燮字威彥，蒼梧廣信人也。",
      "raw_start": 5018,
      "raw_end": 5031,
      "raw_line": 37
    },
    {
      "witness": "s53",
      "quote": "又與裴玄、張承論管仲、季路。",
      "raw_start": 3381,
      "raw_end": 3395,
      "raw_line": 21
    },
    {
      "witness": "s58",
      "quote": "西陵督步闡據城以叛，遣使降晉。",
      "raw_start": 7537,
      "raw_end": 7552,
      "raw_line": 69
    },
    {
      "witness": "s58",
      "quote": "抗字幼節，孫策外孫也。遜卒時，年二十",
      "raw_start": 6578,
      "raw_end": 6596,
      "raw_line": 60
    },
    {
      "witness": "jin003",
      "quote": "吳西陵督步闡來降，拜衛將軍、開府儀同三司，封宜都公。",
      "raw_start": 7209,
      "raw_end": 7235,
      "raw_line": 175
    },
    {
      "witness": "jin034",
      "quote": "祜率兵五萬出江陵，遣荊州刺史楊肇攻抗，不克，闡竟為抗所擒。",
      "raw_start": 1815,
      "raw_end": 1844,
      "raw_line": 30
    },
    {
      "witness": "tong079",
      "quote": "遣兄子璣、璿詣洛陽爲任。",
      "raw_start": 11127,
      "raw_end": 11139,
      "raw_line": 265
    }
  ],
