    "complete_cells": [
      {
        "id": "shiji-013-t1-r003-c06",
        "column": 6,
        "rowspan": 1,
        "colspan": 1,
        "text": "高辛生禼，為殷祖。",
        "source_row": 4,
        "source_column": 7,
        "printed_page": null
      },
      {
        "id": "shiji-013-t1-r004-c06",
        "column": 6,
        "rowspan": 1,
        "colspan": 1,
        "text": "禼生昭明。",
        "source_row": 5,
        "source_column": 7,
        "printed_page": null
      }
    ],
    "yin_benji_complete_paragraphs": [
      {
        "id": "c-shiji-003-yin:p001",
        "text": "殷契，母曰簡狄，有娀氏之女，為帝嚳次妃。三人行浴，見玄鳥墮其卵，簡狄取吞之，因孕生契。契長而佐禹治水有功。帝舜乃命契曰：「百姓不親，五品不訓，汝為司徒而敬敷五教，五教在寬。」封于商，賜姓子氏。契興於唐、虞、大禹之際，功業著於百姓，百姓以平。",
        "annotation_status": "in_progress"
      },
      {
        "id": "c-shiji-003-yin:p002",
        "text": "契卒，子昭明立。昭明卒，子相土立。相土卒，子昌若立。昌若卒，子曹圉立。曹圉卒，子冥立。冥卒，子振立。振卒，子微立。微卒，子報丁立。報丁卒，子報乙立。報乙卒，子報丙立。報丙卒，子主壬立。主壬卒，子主癸立。主癸卒，子天乙立，是為成湯。",
        "annotation_status": "in_progress"
      }
    ],
    "character_reference": {
      "url": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=6980&la=0&powerMode=0",
      "provider": "教育部重編國語辭典修訂本",
      "accessed": "2026-10-30",
      "observed_tool_line": 35,
      "sense": 2,
      "entry_statement": "人名。「契」的古字。",
      "quoted_guangyun": "禼，殷祖也，或作偰，又作契。",
      "reference_layer": "官方字書字形參考；廣韻為辭典轉引，未親見廣韻原本",
      "excluded_sense": {
        "sense": 1,
        "meaning": "一種昆蟲",
        "note": "不混用說文蟲義來解本段殷祖人名"
      },
      "image_verified": false,
      "human_reviewed": false
    },
    "adopts_mythological_genealogy_as_verified_fact": false
  },
  "local_yuyi_poison_context": {
