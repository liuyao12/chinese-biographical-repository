  "external_current_rendered_units": [
    {
      "work": "晉書",
      "book": 66,
      "url": "https://zh.wikisource.org/wiki/晉書/卷066",
      "reported_revision": 1527632,
      "observed_tool_line": 165,
      "received_text": "初，庾亮少有高名，以明穆皇后之兄受顧命之重，蘇峻之禍，職亮是由。及石頭平，懼侃致討，亮用溫嶠謀，詣侃拜謝。侃遽止之，曰：「庾元規乃拜陶士行邪！」王導入石頭城，令取故節，侃笑曰：「蘇武節似不如是！」導有慚色，使人屏之。侃旋江陵，尋以為侍中、太尉，加羽葆鼓吹，改封長沙郡公，邑三千戶，賜絹八千匹，加都督交、廣、寧七州軍事。以江陵偏遠，移鎮巴陵。遣諮議參軍張誕討五溪夷，降之。",
      "fixed_body_obtained": false,
      "actual_print_edition": null,
      "image_verified": false,
      "human_reviewed": false,
      "scope": "完整拜謝及改封長沙郡公同段，僅身份橋，不在本次匯入新066章或授爵事件。"
    }
  ],
