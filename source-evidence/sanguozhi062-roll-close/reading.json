  "source_clauses": [
    {
      "witness": "w62",
      "quote": "本姓氏，初為縣吏",
      "raw_start": 205,
      "raw_end": 213,
      "raw_line": 11
    },
    {
      "witness": "w62",
      "quote": "徐詳者字子明",
      "raw_start": 4450,
      "raw_end": 4456,
      "raw_line": 48
    },
    {
      "witness": "w62",
      "quote": "先綜死",
      "raw_start": 4464,
      "raw_end": 4467,
      "raw_line": 48
    },
    {
      "witness": "w62",
      "quote": "子沖嗣",
      "raw_start": 4394,
      "raw_end": 4397,
      "raw_line": 44
    },
    {
      "witness": "w62",
      "quote": "年八十一卒",
      "raw_start": 1392,
      "raw_end": 1397,
      "raw_line": 19
    },
    {
      "witness": "w62",
      "quote": "綜乃偽質為作降文三條",
      "raw_start": 2122,
      "raw_end": 2132,
      "raw_line": 30
    },
    {
      "witness": "w62",
      "quote": "今年六月末",
      "raw_start": 2347,
      "raw_end": 2352,
      "raw_line": 32
    },
    {
      "witness": "w62",
      "quote": "吳將晉宗叛歸魏",
      "raw_start": 1558,
      "raw_end": 1565,
      "raw_line": 22
    },
    {
      "witness": "w62",
      "quote": "吴历曰：权问普",
      "raw_start": 4137,
      "raw_end": 4144,
      "raw_line": 40
    },
    {
      "witness": "w62",
      "quote": "昔遠子捨袁就曹",
      "raw_start": 3549,
      "raw_end": 3556,
      "raw_line": 36
    },
    {
      "witness": "w62",
      "quote": "今臣款款，遠授其命",
      "raw_start": 3636,
      "raw_end": 3645,
      "raw_line": 36
    },
    {
      "witness": "w62",
      "quote": "蜀聞權踐阼，遣使重申前好。綜為盟文",
      "raw_start": 2028,
      "raw_end": 2045,
      "raw_line": 28
    },
    {
      "witness": "w47",
      "quote": "權令將軍賀齊、糜芳、劉邵等襲蘄春",
      "raw_start": 11668,
      "raw_end": 11684,
      "raw_line": 61
    },
    {
      "witness": "w47",
      "quote": "蜀遣衞尉陳震慶權踐位",
      "raw_start": 14447,
      "raw_end": 14457,
      "raw_line": 79
    },
    {
      "witness": "w47",
      "quote": "造爲盟曰",
      "raw_start": 14606,
      "raw_end": 14610,
      "raw_line": 79
    },
    {
      "witness": "w47",
      "quote": "天降喪亂，皇綱失敘",
      "raw_start": 14621,
      "raw_end": 14630,
      "raw_line": 81
    },
    {
      "witness": "w61",
      "quote": "濬子翥亦与周旋",
      "raw_start": 1210,
      "raw_end": 1217,
      "raw_line": 14
    },
    {
      "witness": "w61",
      "quote": "而蕃果图叛诛夷",
      "raw_start": 1311,
      "raw_end": 1318,
      "raw_line": 14
    },
    {
      "witness": "w60",
      "quote": "詔齊督麋芳、鮮于丹等襲蘄春，遂生虜宗。",
      "raw_start": 2245,
      "raw_end": 2264,
      "raw_line": 29
    },
    {
      "witness": "han67",
      "quote": "御史遂將雲去。於是左將軍辛慶忌免冠解印綬",
      "raw_start": 4440,
      "raw_end": 4460,
      "raw_line": 32
    },
    {
      "witness": "sh43",
      "quote": "趙簡子有臣曰周-{舍}-，好直諫。",
      "raw_start": 4641,
      "raw_end": 4658,
      "raw_line": 78
    }
  ],
