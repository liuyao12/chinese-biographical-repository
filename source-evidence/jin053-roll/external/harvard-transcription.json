{
  "revision": 71,
  "holder": "哈佛燕京圖書館",
  "edition": "乾隆四年武英殿本",
  "coverage": "識典平台書影頁碼 2823–2842；保存平台轉錄及分頁標識。",
  "chapters": [
    {
      "chapter_id": "1mb9kswm56c6j",
      "url": "https://www.shidianguji.com/zh/book/HY2499/chapter/1mb9kswm56c6j",
      "html_sha256": "ab1b96cef89cb9e16966447bb1fd0464afa955b1e03bc44a268f1acbbf6abdf7",
      "paragraphs": [
        {
          "paragraphId": "7675249288952414244",
          "chapterId": "1mb9kswm56c6j",
          "startPageId": "7444729325884014644",
          "endPageId": "7444729325884014644",
          "volumeVersion": 64,
          "lines": [
            {
              "lineId": "5",
              "lineType": 9,
              "content": "愍懷太子"
            },
            {
              "lineId": "6",
              "lineType": 2,
              "content": "子虨臧尙"
            }
          ]
        },
        {
          "paragraphId": "7476875971434774528",
          "chapterId": "1mb9kswm56c6j",
          "startPageId": "7444729325884014644",
          "endPageId": "7444729321370976294",
          "volumeVersion": 64,
          "lines": [
            {
              "lineId": "7",
              "lineType": 1,
              "content": "愍懷太子遹，字熙祖，惠帝長子。"
            },
            {
              "lineId": "8",
              "lineType": 1,
              "content": "母曰謝才人。"
            },
            {
              "lineId": "9",
              "lineType": 1,
              "content": "幼而聰慧，武帝愛之，恒在左右。"
            },
            {
              "lineId": "10",
              "lineType": 1,
              "content": "嘗與諸皇子共戲殿上。"
            },
            {
              "lineId": "11",
              "lineType": 1,
              "content": "惠帝來朝，執諸皇子手，次至太子，帝曰：是汝兒也。"
            },
            {
              "lineId": "12",
              "lineType": 1,
              "content": "惠帝乃止。"
            },
            {
              "lineId": "13",
              "lineType": 1,
              "content": "宫中嘗夜失火，武帝登樓望之，太子時年五歲，牽帝裾入闇中。"
            },
            {
              "lineId": "14",
              "lineType": 1,
              "content": "帝問其故，太子曰：暮夜倉卒，宜備非常，不宜令照見人君也。"
            },
            {
              "lineId": "15",
              "lineType": 1,
              "content": "由是奇之。"
            },
            {
              "lineId": "16",
              "lineType": 1,
              "content": "嘗從帝觀豕牢，言於帝曰：豕甚肥，何"
            },
            {
              "lineId": "17",
              "lineType": 3,
              "content": "",
              "pagePass": {
                "PageId": "7444729321370976294"
              }
            },
            {
              "lineId": "18",
              "lineType": 1,
              "content": "不殺以享士，而使久費五穀？"
            },
            {
              "lineId": "19",
              "lineType": 1,
              "content": "帝嘉其意，卽使烹之，因撫其背，謂廷尉傳祗曰：此兒當興我家。"
            },
            {
              "lineId": "20",
              "lineType": 1,
              "content": "嘗對羣臣稱太子似宣帝，於是令譽流於天下。"
            },
            {
              "lineId": "21",
              "lineType": 1,
              "content": "時望氣者言廣陵有天子氣，故封爲廣陵王，邑五萬戸。"
            },
            {
              "lineId": "22",
              "lineType": 1,
              "content": "以劉寔爲師，孟珩爲友，楊準、馮蓀爲文學。"
            },
            {
              "lineId": "23",
              "lineType": 1,
              "content": "惠帝卽位，立爲皇太子，盛選德望，以爲師傅，以何劭爲太師，王戎爲太傅，楊濟爲太保，裴楷爲少師，張華爲少傅，和嶠爲少保。"
            }
          ]
        },
        {
          "paragraphId": "7476875971434790912",
          "chapterId": "1mb9kswm56c6j",
          "startPageId": "7444729321370976294",
          "endPageId": "7444729325884031028",
          "volumeVersion": 64,
          "lines": [
            {
              "lineId": "24",
              "lineType": 1,
              "content": "元康元年，出就東宫。"
            },
            {
              "lineId": "25",
              "lineType": 1,
              "content": "又詔曰：遹尙幼蒙，今出東宫，惟當賴師傅羣賢之訓。"
            },
            {
              "lineId": "26",
              "lineType": 1,
              "content": "其游處左右，宜得正人，使共周旋，能相長益者。"
            },
            {
              "lineId": "27",
              "lineType": 1,
              "content": "於是使太保衞瓘息庭、司空泰息略，太子太傅楊濟息毖，太子少師"
            },
            {
              "lineId": "28",
              "lineType": 3,
              "content": "",
              "pagePass": {
                "PageId": "7444729346436153384"
              }
            },
            {
              "lineId": "29",
              "lineType": 1,
              "content": "裴楷息憲，太子少傅張華息禕，尙書令華廙息，恒與太子游處，以相輔導焉。"
            },
            {
              "lineId": "30",
              "lineType": 1,
              "content": "及長，不好學，惟與左右嬉戲，不能尊敬保傅。"
            },
            {
              "lineId": "31",
              "lineType": 1,
              "content": "賈后素忌太子有令譽，因此密勅黃門閹宦媚諛於太子曰：殿下誠可及壯時極意所欲，何爲恒自拘束？"
            },
            {
              "lineId": "32",
              "lineType": 1,
              "content": "每見喜怒之際，輒歎曰：殿下不知用威刑，天下豈得畏服？"
            },
            {
              "lineId": "33",
              "lineType": 1,
              "content": "太子所幸蔣羙人生男，又言宜隆其賞賜，多爲皇孫造玩弄之器，太子從之，於是慢弛益彰，或廢朝侍，恒在後園游戲，愛埤車小馬，令左右馳騎，斷其鞅勒，使墮地爲樂。"
            },
            {
              "lineId": "34",
              "lineType": 1,
              "content": "或有犯忤者，手自捶擊之。"
            },
            {
              "lineId": "35",
              "lineType": 1,
              "content": "性拘小忌，不許繕壁修墙，正瓦動屋，而於宫中爲市，使人屠酤，手揣斤兩，"
            },
            {
              "lineId": "36",
              "lineType": 3,
              "content": "",
              "pagePass": {
                "PageId": "7444729325884031028"
              }
            },
            {
              "lineId": "37",
              "lineType": 1,
              "content": "輕重不差。"
            }
          ]
        },
        {
          "paragraphId": "7476875971434807296",
          "chapterId": "1mb9kswm56c6j",
          "startPageId": "7444729325884031028",
          "endPageId": "7444729321371009062",
          "volumeVersion": 64,
          "lines": [
            {
              "lineId": "38",
              "lineType": 1,
              "content": "其母本屠家女也，故太子好之。"
            },
            {
              "lineId": "39",
              "lineType": 1,
              "content": "又令西園賣葵菜、籃子、雞麪之屬，而收其利。"
            },
            {
              "lineId": "40",
              "lineType": 1,
              "content": "東宫舊制，月請錢五十萬，備於衆用，太子恒探取二月，以供嬖寵。"
            },
            {
              "lineId": "41",
              "lineType": 1,
              "content": "洗馬江統陳五事以諫之，太子不納，語在統傳中。"
            },
            {
              "lineId": "42",
              "lineType": 1,
              "content": "舎人杜錫以太子非賈后所生，而后性凶暴，深以爲憂，每盡忠䂓，勸太子修德進善，遠於讒謗。"
            },
            {
              "lineId": "43",
              "lineType": 1,
              "content": "太子怒，使人以針著錫常所坐氊中而刺之。"
            },
            {
              "lineId": "44",
              "lineType": 1,
              "content": "太子性剛，知賈謐恃后之貴，不能假借之。"
            },
            {
              "lineId": "45",
              "lineType": 1,
              "content": "謐至，東宫，或捨之，而於後庭游戲。"
            },
            {
              "lineId": "46",
              "lineType": 1,
              "content": "詹事裴權諫曰：賈謐甚有寵於中宫，而有不順之色，若一旦交構，大事去矣。"
            },
            {
              "lineId": "47",
              "lineType": 1,
              "content": "宜深自謙屈，以防其變，廣延賢士，用自輔翼。"
            },
            {
              "lineId": "48",
              "lineType": 1,
              "content": "太子不能從。"
            },
            {
              "lineId": "49",
              "lineType": 3,
              "content": "",
              "pagePass": {
                "PageId": "7444729321371009062"
              }
            },
            {
              "lineId": "50",
              "lineType": 1,
              "content": "初，賈后母郭槐，欲以韓壽女爲太子妃，太子亦欲㛰韓氏以自固，而壽妻賈午及后，皆不聽，而爲太子聘王衍小女惠風。"
            },
            {
              "lineId": "51",
              "lineType": 1,
              "content": "太子聞衍長女美，而賈后爲謐聘之，心不能平，頗以爲言。"
            }
          ]
        },
        {
          "paragraphId": "7476875971434823680",
          "chapterId": "1mb9kswm56c6j",
          "startPageId": "7444729321371009062",
          "endPageId": "7444729346436169768",
          "volumeVersion": 64,
          "lines": [
            {
              "lineId": "52",
              "lineType": 1,
              "content": "謐嘗與太子圍碁爭道，成都王潁見而訶謐，謐意愈不平，因此讃太子於后曰：太子廣買田業，多畜私財，以結小人者，爲賈后故也。"
            },
            {
              "lineId": "53",
              "lineType": 1,
              "content": "密聞其言云：皇后萬歲後，吾當魚肉之，非但如是也。"
            },
            {
              "lineId": "54",
              "lineType": 1,
              "content": "若宫車晏駕，彼居大位，依楊氏故事，誅臣等而廢后於金墉，如反手耳。"
            },
            {
              "lineId": "55",
              "lineType": 1,
              "content": "不如早爲之所，更立慈順者，以自防衞。"
            },
            {
              "lineId": "56",
              "lineType": 1,
              "content": "后納其言，又宣揚太子。"
            },
            {
              "lineId": "57",
              "lineType": 1,
              "content": "之短，布諸遠近。"
            },
            {
              "lineId": "58",
              "lineType": 1,
              "content": "于時朝野咸知賈后有害太子意。"
            },
            {
              "lineId": "59",
              "lineType": 1,
              "content": "中護"
            },
            {
              "lineId": "60",
              "lineType": 3,
              "content": "",
              "pagePass": {
                "PageId": "7444729346436169768"
              }
            },
            {
              "lineId": "61",
              "lineType": 1,
              "content": "軍趙俊請太子廢后，太子不聽。"
            }
          ]
        },
        {
          "paragraphId": "7463346778557923338",
          "chapterId": "1mb9kswm56c6j",
          "startPageId": "7444729346436169768",
          "endPageId": "7444729346436169768",
          "volumeVersion": 64,
          "lines": [
            {
              "lineId": "62",
              "lineType": 1,
              "content": "九年六月，有桑生于宫西廂，日長尺餘，數日而枯。"
            }
          ]
        },
        {
          "paragraphId": "7476875971434840064",
          "chapterId": "1mb9kswm56c6j",
          "startPageId": "7444729346436169768",
          "endPageId": "7444729324927811625",
          "volumeVersion": 64,
          "lines": [
            {
              "lineId": "63",
              "lineType": 1,
              "content": "十二月，賈后將廢太子，詐稱上不和，呼太子入朝。"
            },
            {
              "lineId": "64",
              "lineType": 1,
              "content": "旣至，后不見，置于別室，遣婢陳舞，賜以酒棗，逼飮醉之，使黄門侍郞潘岳作書草，若禱神之文，有如太子素意，因醉而書之，令小婢承福以紙筆及書草，使太子書之。"
            },
            {
              "lineId": "65",
              "lineType": 1,
              "content": "文曰：陛下宜自了，不自了，吾當入了之。"
            },
            {
              "lineId": "66",
              "lineType": 1,
              "content": "中宫又宜速自了，不了，吾當手了之。"
            },
            {
              "lineId": "67",
              "lineType": 1,
              "content": "并謝妃共要剋期而兩發，勿疑猶豫致後患。"
            },
            {
              "lineId": "68",
              "lineType": 1,
              "content": "茹毛飲血於三辰之下，皇天許當掃除患害，立道文爲王，蔣爲内主，願成當三牲祠北君，大赦天下，要疏如律令。"
            },
            {
              "lineId": "69",
              "lineType": 1,
              "content": "太子醉迷不覺，遂依"
            },
            {
              "lineId": "70",
              "lineType": 3,
              "content": "",
              "pagePass": {
                "PageId": "7444729324927811625"
              }
            },
            {
              "lineId": "71",
              "lineType": 1,
              "content": "而寫之，其字半不成，旣而補成之，后以呈帝。"
            },
            {
              "lineId": "72",
              "lineType": 1,
              "content": "帝幸式乾殿，召公卿入，使黃門令董猛以太子書及靑紙詔曰：遹書如此，今賜死。"
            },
            {
              "lineId": "73",
              "lineType": 1,
              "content": "徧示諸公王莫有言者。"
            },
            {
              "lineId": "74",
              "lineType": 1,
              "content": "惟張華、裴頠證明太子。"
            },
            {
              "lineId": "75",
              "lineType": 1,
              "content": "賈后使董猛矯以長廣公主辭白帝曰：事宜速決，而羣臣各有不同，若有不從詔，宜以軍法從事。"
            }
          ]
        },
        {
          "paragraphId": "7476875971434856448",
          "chapterId": "1mb9kswm56c6j",
          "startPageId": "7444729324927811625",
          "endPageId": "7444729316933582886",
          "volumeVersion": 64,
          "lines": [
            {
              "lineId": "76",
              "lineType": 1,
              "content": "議至日西不決。"
            },
            {
              "lineId": "77",
              "lineType": 1,
              "content": "后懼事變，乃表免太子爲庶人，詔許之。"
            },
            {
              "lineId": "78",
              "lineType": 1,
              "content": "於是使尙書和郁持節，解結爲副，及大將軍梁王肜、鎭東將軍、淮南王允、前將軍東武公澹、趙王倫、太保何劭詣東宮，廢太子爲庶人。"
            },
            {
              "lineId": "79",
              "lineType": 1,
              "content": "是日，太子游玄圃，聞有使者至，改服出崇賢門，再拜受詔，步出承華門，乘麤犢車。"
            },
            {
              "lineId": "80",
              "lineType": 1,
              "content": "澹以兵仗"
            },
            {
              "lineId": "81",
              "lineType": 3,
              "content": "",
              "pagePass": {
                "PageId": "7444729316933582886"
              }
            },
            {
              "lineId": "82",
              "lineType": 1,
              "content": "送太子妃王氏、三皇孫於金墉城，考竟謝淑妃及太子保林、蔣俊。"
            }
          ]
        },
        {
          "paragraphId": "7463346778558300170",
          "chapterId": "1mb9kswm56c6j",
          "startPageId": "7444729316933582886",
          "endPageId": "7444729316933582886",
          "volumeVersion": 64,
          "lines": [
            {
              "lineId": "83",
              "lineType": 1,
              "content": "明年正月，賈后又使黄門自首，欲與太子爲逆，詔以黃門首辭，班示公卿。"
            },
            {
              "lineId": "84",
              "lineType": 1,
              "content": "又遣澹以千兵防送太子，更幽于許昌宫之別坊，令治書御史劉振持節守之。"
            }
          ]
        },
        {
          "paragraphId": "7463346778558332938",
          "chapterId": "1mb9kswm56c6j",
          "startPageId": "7444729316933582886",
          "endPageId": "7444729316933582886",
          "volumeVersion": 64,
          "lines": [
            {
              "lineId": "85",
              "lineType": 1,
              "content": "先是，有童謡曰：東宮馬子莫聾空，前至臘月纒汝鬉。"
            },
            {
              "lineId": "86",
              "lineType": 1,
              "content": "又曰：南風起兮吹白沙，遥望魯國鬱嵯峨，千歲髑髏生齒牙。"
            },
            {
              "lineId": "87",
              "lineType": 1,
              "content": "南風，后名。"
            },
            {
              "lineId": "88",
              "lineType": 1,
              "content": "沙門，太子小字也。"
            }
          ]
        },
        {
          "paragraphId": "7476875971434872832",
          "chapterId": "1mb9kswm56c6j",
          "startPageId": "7444729316933582886",
          "endPageId": "7444729316933599270",
          "volumeVersion": 64,
          "lines": [
            {
              "lineId": "89",
              "lineType": 1,
              "content": "初，太子之廢也，妃父王衍表請離㛰。"
            },
            {
              "lineId": "90",
              "lineType": 1,
              "content": "太子至許，遺妃書曰：鄙雖頑愚，心念爲善，欲盡忠孝之節，無有惡逆之心。"
            },
            {
              "lineId": "91",
              "lineType": 1,
              "content": "雖非中宫所生，奉事有如親母。"
            },
            {
              "lineId": "92",
              "lineType": 1,
              "content": "自爲太子以來，勅見禁檢，不得見母。"
            },
            {
              "lineId": "93",
              "lineType": 1,
              "content": "自宜城君亡，"
            },
            {
              "lineId": "94",
              "lineType": 3,
              "content": "",
              "pagePass": {
                "PageId": "7444729316933599270"
              }
            },
            {
              "lineId": "95",
              "lineType": 1,
              "content": "不見存恤，恒在空室中坐。"
            },
            {
              "lineId": "96",
              "lineType": 1,
              "content": "去年十二月，道文疾病困篤，父子之情，實相憐愍。"
            },
            {
              "lineId": "97",
              "lineType": 1,
              "content": "于時表國家乞加徽號，不見聽許。"
            },
            {
              "lineId": "98",
              "lineType": 1,
              "content": "疾病旣篤，爲之求請恩福，無有惡心。"
            },
            {
              "lineId": "99",
              "lineType": 1,
              "content": "自道文病，中宫三遣左右來視，云：天敎呼汝。"
            },
            {
              "lineId": "100",
              "lineType": 1,
              "content": "到。"
            },
            {
              "lineId": "101",
              "lineType": 1,
              "content": "二十八日暮，有短函來，題言東宫發疏，云言天敎欲見汝。"
            },
            {
              "lineId": "102",
              "lineType": 1,
              "content": "卽便作表，求入。"
            },
            {
              "lineId": "103",
              "lineType": 1,
              "content": "二十九日早入見國家。"
            },
            {
              "lineId": "104",
              "lineType": 1,
              "content": "須臾，遣至中宫。"
            },
            {
              "lineId": "105",
              "lineType": 1,
              "content": "中宫左右陳舞見，語中宫：旦來吐不快，使住空屋中坐。"
            },
            {
              "lineId": "106",
              "lineType": 1,
              "content": "須臾，中宫遣陳舞見，語：聞汝表陛下爲道文乞王，不得王，是成國耳。"
            },
            {
              "lineId": "107",
              "lineType": 1,
              "content": "中宫遙呼陳舞：昨天敎與太子酒棗，便持三升酒，大盤棗來，見與使飮，酒噉棗盡。"
            }
          ]
        },
        {
          "paragraphId": "7476875971434889216",
          "chapterId": "1mb9kswm56c6j",
          "startPageId": "7444729316933599270",
          "endPageId": "7444729324927828009",
          "volumeVersion": 64,
          "lines": [
            {
              "lineId": "108",
              "lineType": 1,
              "content": "鄙素不飮酒，卽便遣舞，啓說不堪三升"
            },
            {
              "lineId": "109",
              "lineType": 3,
              "content": "",
              "pagePass": {
                "PageId": "7444729346436186152"
              }
            },
            {
              "lineId": "110",
              "lineType": 1,
              "content": "之意。"
            },
            {
              "lineId": "111",
              "lineType": 1,
              "content": "中宫遥呼曰：汝常陛下前，持酒可喜，何以不飲？"
            },
            {
              "lineId": "112",
              "lineType": 1,
              "content": "天與汝酒，當使道文差也。"
            },
            {
              "lineId": "113",
              "lineType": 1,
              "content": "便答：中宫，陛下會同，一日見賜，故不敢辭。"
            },
            {
              "lineId": "114",
              "lineType": 1,
              "content": "通曰：不飮三升酒也。"
            },
            {
              "lineId": "115",
              "lineType": 1,
              "content": "且實未食，恐不堪。"
            },
            {
              "lineId": "116",
              "lineType": 1,
              "content": "又未見殿下飲此，或至顚倒。"
            },
            {
              "lineId": "117",
              "lineType": 1,
              "content": "陳舞復傳語曰：不孝那，天與汝酒飲，不肯飲，中有惡物邪？"
            },
            {
              "lineId": "118",
              "lineType": 1,
              "content": "遂可飲二升，餘，有一升求持。"
            },
            {
              "lineId": "119",
              "lineType": 1,
              "content": "還東宮，飲盡，逼迫不得已，更飲一升。"
            },
            {
              "lineId": "120",
              "lineType": 1,
              "content": "飲已，體中荒迷，不復自覺。"
            },
            {
              "lineId": "121",
              "lineType": 1,
              "content": "須臾，有一小婢持封箱來，云：詔使寫此文書。"
            },
            {
              "lineId": "122",
              "lineType": 1,
              "content": "鄙便驚起視之，有一白紙、一靑紙，催促云：陛下停待。"
            },
            {
              "lineId": "123",
              "lineType": 1,
              "content": "又小婢承福持筆研墨、黄紙來，使寫急疾，不容復視，實不覺紙上語。"
            },
            {
              "lineId": "124",
              "lineType": 1,
              "content": "輕重。"
            },
            {
              "lineId": "125",
              "lineType": 1,
              "content": "父母至親，實不相疑。"
            },
            {
              "lineId": "126",
              "lineType": 1,
              "content": "事理如此，實爲見誣，"
            },
            {
              "lineId": "127",
              "lineType": 3,
              "content": "",
              "pagePass": {
                "PageId": "7444729324927828009"
              }
            },
            {
              "lineId": "128",
              "lineType": 1,
              "content": "想衆人見明也。"
            }
          ]
        },
        {
          "paragraphId": "7476875971434905600",
          "chapterId": "1mb9kswm56c6j",
          "startPageId": "7444729324927828009",
          "endPageId": "7444729321371041830",
          "volumeVersion": 64,
          "lines": [
            {
              "lineId": "129",
              "lineType": 1,
              "content": "太子旣廢非其罪，衆情憤怨。"
            },
            {
              "lineId": "130",
              "lineType": 1,
              "content": "右衞督司馬雅，宗室之踈屬也，與常從督許超並有寵於太子，二人深傷之，說趙王倫謀臣孫秀曰：國無適嗣，社稷將危，大臣之禍必起。"
            },
            {
              "lineId": "131",
              "lineType": 1,
              "content": "而公奉事中宫，與賈后親密，太子之廢，皆云豫知，一旦事起，禍必及矣，何不先謀之？"
            },
            {
              "lineId": "132",
              "lineType": 1,
              "content": "秀言於趙王倫，倫深納焉。"
            },
            {
              "lineId": "133",
              "lineType": 1,
              "content": "計旣定，而秀說倫曰：太子爲人剛猛，若得志之日，必肆其情性矣。"
            },
            {
              "lineId": "134",
              "lineType": 1,
              "content": "明公素事賈后，街談巷議，皆以公爲賈氏之黨。"
            },
            {
              "lineId": "135",
              "lineType": 1,
              "content": "今雖欲建大功於太子，太子雖將含忍宿忿，必不能加賞於公，當謂公逼百姓之望，翻覆以免罪耳。"
            },
            {
              "lineId": "136",
              "lineType": 1,
              "content": "若有瑕釁，猶不免誅。"
            },
            {
              "lineId": "137",
              "lineType": 1,
              "content": "不若遷延却期，賈后必害"
            },
            {
              "lineId": "138",
              "lineType": 3,
              "content": "",
              "pagePass": {
                "PageId": "7444729321371041830"
              }
            },
            {
              "lineId": "139",
              "lineType": 1,
              "content": "太子，然後廢賈后，爲太子報讎，猶足以爲功，乃可以得志。"
            },
            {
              "lineId": "140",
              "lineType": 1,
              "content": "倫然之。"
            },
            {
              "lineId": "141",
              "lineType": 1,
              "content": "秀因使反間言殿中人欲廢賈后，迎太子。"
            },
            {
              "lineId": "142",
              "lineType": 1,
              "content": "賈后聞之，憂怖，乃使太醫令程據合巴豆杏仁丸。"
            }
          ]
        },
        {
          "paragraphId": "7476875971434921984",
          "chapterId": "1mb9kswm56c6j",
          "startPageId": "7444729321371041830",
          "endPageId": "7444729325884096564",
          "volumeVersion": 64,
          "lines": [
            {
              "lineId": "143",
              "lineType": 1,
              "content": "三月，矯詔使黄門孫慮齎至許昌，以害太子。"
            },
            {
              "lineId": "144",
              "lineType": 1,
              "content": "初，太子恐見酖，恒自煑食於前。"
            },
            {
              "lineId": "145",
              "lineType": 1,
              "content": "慮以吿劉振，振乃徙太子於小坊中，絶不與食。"
            },
            {
              "lineId": "146",
              "lineType": 1,
              "content": "宫中猶於墻壁上過食與太子。"
            },
            {
              "lineId": "147",
              "lineType": 1,
              "content": "慮乃逼太子以藥，太子不肯服，因如厠，慮以藥杵椎殺之。"
            },
            {
              "lineId": "148",
              "lineType": 1,
              "content": "太子大呼，聲聞于外，時年二十三，將以庶人禮葬之。"
            },
            {
              "lineId": "149",
              "lineType": 1,
              "content": "賈后表曰：遹不幸。"
            },
            {
              "lineId": "150",
              "lineType": 1,
              "content": "喪亡，傷其迷悖，又早短折，悲痛之懷，不能自已。"
            },
            {
              "lineId": "151",
              "lineType": 1,
              "content": "妾私心冀其刻肌刻骨，更思孝道，䂓爲稽顙，正其名號，此志不"
            },
            {
              "lineId": "152",
              "lineType": 3,
              "content": "",
              "pagePass": {
                "PageId": "7444729325884096564"
              }
            },
            {
              "lineId": "153",
              "lineType": 1,
              "content": "遂，重以酸恨。"
            },
            {
              "lineId": "154",
              "lineType": 1,
              "content": "遹雖罪在莫大，猶王者子孫，便以匹庶送終，情實憐愍，特乞天恩，賜以王禮。"
            },
            {
              "lineId": "155",
              "lineType": 1,
              "content": "妾誠闇淺，不識禮義，不勝至情，冒昧陳聞。"
            },
            {
              "lineId": "156",
              "lineType": 1,
              "content": "詔以廣陵王禮葬之。"
            },
            {
              "lineId": "157",
              "lineType": 1,
              "content": "及賈庶人死，乃誅劉振孫慮、程據等，冊復太子曰：皇帝使使持節、兼司空、衞尉伊策故皇太子之靈曰：嗚呼！"
            },
            {
              "lineId": "158",
              "lineType": 1,
              "content": "維爾少資岐嶷之質，荷先帝殊異之寵，大啓土宇，奄有淮陵。"
            }
          ]
        },
        {
          "paragraphId": "7476875971434938368",
          "chapterId": "1mb9kswm56c6j",
          "startPageId": "7444729325884096564",
          "endPageId": "7444729322654547980",
          "volumeVersion": 64,
          "lines": [
            {
              "lineId": "159",
              "lineType": 1,
              "content": "朕奉遵遺旨，越建爾儲副，以光顯我祖宗。"
            },
            {
              "lineId": "160",
              "lineType": 1,
              "content": "祗爾德行，以從保傅，事親孝敬，禮無違者。"
            },
            {
              "lineId": "161",
              "lineType": 1,
              "content": "而朕昧于凶構，致爾于非命之禍，俾申生孝己，復見於今。"
            },
            {
              "lineId": "162",
              "lineType": 1,
              "content": "賴宰相賢明，人神憤怨，用啓朕心，討厥有罪，咸伏其辜，何補於荼毒，𡨚魂酷痛哉！"
            },
            {
              "lineId": "163",
              "lineType": 1,
              "content": "是用忉"
            },
            {
              "lineId": "164",
              "lineType": 3,
              "content": "",
              "pagePass": {
                "PageId": "7444729322654547980"
              }
            },
            {
              "lineId": "165",
              "lineType": 1,
              "content": "怛悼恨，震動於五內。"
            },
            {
              "lineId": "166",
              "lineType": 1,
              "content": "今追復皇太子喪禮，反葬京畿，祠以太牢，魂而有靈，尙獲爾心。"
            },
            {
              "lineId": "167",
              "lineType": 1,
              "content": "帝爲太子服長子斬衰，羣臣齊衰，使尙書和郁率東宫官屬，具吉凶之制，迎太子喪於許昌。"
            },
            {
              "lineId": "168",
              "lineType": 1,
              "content": "喪之發也，大風雷電，幃蓋飛裂。"
            },
            {
              "lineId": "169",
              "lineType": 1,
              "content": "又爲哀策曰，皇帝臨軒，使洗馬劉務吿于皇太子之殯曰：咨爾遹，幼禀英挺，芬馨誕茂，既茂髫齓，高明逸秀。"
            },
            {
              "lineId": "170",
              "lineType": 1,
              "content": "昔爾聖祖，嘉爾淑美，顯詔仍崇，名振同軌，是用建爾儲副，永統皇基。"
            },
            {
              "lineId": "171",
              "lineType": 1,
              "content": "如何凶戾濳構，禍害如玆，哀感和氣，痛貫四時。"
            }
          ]
        },
        {
          "paragraphId": "7476875971434954752",
          "chapterId": "1mb9kswm56c6j",
          "startPageId": "7444729322654547980",
          "endPageId": "7444729322654531596",
          "volumeVersion": 64,
          "lines": [
            {
              "lineId": "172",
              "lineType": 1,
              "content": "嗚呼哀哉！"
            },
            {
              "lineId": "173",
              "lineType": 1,
              "content": "爾之降廢，實我不明。"
            },
            {
              "lineId": "174",
              "lineType": 1,
              "content": "牝亂沉烖，釁結禍成。"
            },
            {
              "lineId": "175",
              "lineType": 1,
              "content": "爾之逝矣，誰百其形。"
            },
            {
              "lineId": "176",
              "lineType": 1,
              "content": "昔之申生，含枉莫訟；今爾之負，抱𡨚于東。"
            },
            {
              "lineId": "177",
              "lineType": 1,
              "content": "悠悠"
            },
            {
              "lineId": "178",
              "lineType": 3,
              "content": "",
              "pagePass": {
                "PageId": "7444729322654531596"
              }
            },
            {
              "lineId": "179",
              "lineType": 1,
              "content": "有識，孰不哀慟。"
            },
            {
              "lineId": "180",
              "lineType": 1,
              "content": "壺關干主，千秋悟己。"
            },
            {
              "lineId": "181",
              "lineType": 1,
              "content": "異世同䂓，古今一理，皇孫啓建，降祚爾子。"
            },
            {
              "lineId": "182",
              "lineType": 1,
              "content": "雖悴前終，庶榮後始。"
            },
            {
              "lineId": "183",
              "lineType": 1,
              "content": "窀空旣營，將寧爾神。"
            },
            {
              "lineId": "184",
              "lineType": 1,
              "content": "華髦電逝，戎車雷震。"
            },
            {
              "lineId": "185",
              "lineType": 1,
              "content": "芒芒羽蓋，翼翼縉紳。"
            },
            {
              "lineId": "186",
              "lineType": 1,
              "content": "同悲等痛，孰不酸辛。"
            },
            {
              "lineId": "187",
              "lineType": 1,
              "content": "庶光來葉，永世不泯。"
            },
            {
              "lineId": "188",
              "lineType": 1,
              "content": "諡曰愍懷。"
            },
            {
              "lineId": "189",
              "lineType": 1,
              "content": "六月己卯，葬于顯平陵。"
            },
            {
              "lineId": "190",
              "lineType": 1,
              "content": "帝感閻纉之言，立思子臺，故臣江統、陸機並作誄頌焉。"
            }
          ]
        },
        {
          "paragraphId": "7463346780810608677",
          "chapterId": "1mb9kswm56c6j",
          "startPageId": "7444729322654531596",
          "endPageId": "7444729322654531596",
          "volumeVersion": 64,
          "lines": [
            {
              "lineId": "191",
              "lineType": 1,
              "content": "太子三子：虨、臧、尙，並與父同幽金墉。"
            }
          ]
        },
        {
          "paragraphId": "7463346780810625061",
          "chapterId": "1mb9kswm56c6j",
          "startPageId": "7444729322654531596",
          "endPageId": "7444729322654531596",
          "volumeVersion": 64,
          "lines": [
            {
              "lineId": "192",
              "lineType": 1,
              "content": "虨字道文，永康元年正月薨。"
            },
            {
              "lineId": "193",
              "lineType": 1,
              "content": "四月，追封南陽王。"
            }
          ]
        },
        {
          "paragraphId": "7476875971434971136",
          "chapterId": "1mb9kswm56c6j",
          "startPageId": "7444729322654531596",
          "endPageId": "7444729325884129332",
          "volumeVersion": 64,
          "lines": [
            {
              "lineId": "194",
              "lineType": 1,
              "content": "臧字敬文，永康元年四月，封臨淮王。"
            },
            {
              "lineId": "195",
              "lineType": 1,
              "content": "己巳，詔曰：咎徵數發，姦囘作變，遹旣逼廢，非命而没。"
            },
            {
              "lineId": "196",
              "lineType": 1,
              "content": "今立臧爲皇太孫，還妃王氏，以母之，稱太孫太妃，太子官屬，卽轉爲太孫官"
            },
            {
              "lineId": "197",
              "lineType": 3,
              "content": "",
              "pagePass": {
                "PageId": "7444729325884129332"
              }
            },
            {
              "lineId": "198",
              "lineType": 1,
              "content": "屬。"
            },
            {
              "lineId": "199",
              "lineType": 1,
              "content": "趙王倫行太孫太傅。"
            },
            {
              "lineId": "200",
              "lineType": 1,
              "content": "五月，倫與太孫俱之東宫，太孫自西掖門出，車服侍從，皆愍懷之舊也。"
            },
            {
              "lineId": "201",
              "lineType": 1,
              "content": "到銅駞街，宫人哭，侍從者皆哽咽，路人抆淚焉。"
            },
            {
              "lineId": "202",
              "lineType": 1,
              "content": "桑復生于西廂，太孫廢，乃枯。"
            },
            {
              "lineId": "203",
              "lineType": 1,
              "content": "永寧元年正月，趙王倫篡位，廢爲濮陽王，與帝俱遷金墉，𡬶被害。"
            },
            {
              "lineId": "204",
              "lineType": 1,
              "content": "太安初，追諡曰哀。"
            }
          ]
        },
        {
          "paragraphId": "7463346780810788901",
          "chapterId": "1mb9kswm56c6j",
          "startPageId": "7444729325884129332",
          "endPageId": "7444729325884129332",
          "volumeVersion": 64,
          "lines": [
            {
              "lineId": "205",
              "lineType": 1,
              "content": "尙字敬仁，永康元年四月，封爲襄陽王，永寧元年八月，立爲皇太孫。"
            },
            {
              "lineId": "206",
              "lineType": 1,
              "content": "太安元年三月癸卯薨，帝服齊衰朞，諡曰沖太孫。"
            }
          ]
        },
        {
          "paragraphId": "7476875971434987520",
          "chapterId": "1mb9kswm56c6j",
          "startPageId": "7444729325884129332",
          "endPageId": "7444729321371058214",
          "volumeVersion": 64,
          "lines": [
            {
              "lineId": "207",
              "lineType": 1,
              "content": "史臣曰：愍懷挺岐嶷之姿，表夙成之質，武皇鍾愛，既深貽厥之謀，天下歸心，頗有後來之望。"
            },
            {
              "lineId": "208",
              "lineType": 1,
              "content": "及于繼明宸極，守"
            },
            {
              "lineId": "209",
              "lineType": 3,
              "content": "",
              "pagePass": {
                "PageId": "7444729321371058214"
              }
            },
            {
              "lineId": "210",
              "lineType": 1,
              "content": "器春坊，四敎不勤，三朝或闕。"
            },
            {
              "lineId": "211",
              "lineType": 1,
              "content": "豹姿未變，鳳德已衰，信惑姦邪，踈斥正士，好屠酤之賤役，躭苑囿之佚游，可謂靡不有初，鮮克有終者也。"
            },
            {
              "lineId": "212",
              "lineType": 1,
              "content": "旣而中宫凶忍，久懷危害之心，外戚謟諛，競進讒邪之說。"
            },
            {
              "lineId": "213",
              "lineType": 1,
              "content": "坎牲之謀已搆，斃犬之讃遂行，一人乏探隱之聰，百辟無爭臣之節，遂使𡨚逾楚建，酷甚戾園。"
            },
            {
              "lineId": "214",
              "lineType": 1,
              "content": "雖復禮備哀榮，情深憫慟，亦何補於荼毒者哉。"
            }
          ]
        },
        {
          "paragraphId": "7476875971435003904",
          "chapterId": "1mb9kswm56c6j",
          "startPageId": "7444729321371058214",
          "endPageId": "7444729325884112948",
          "volumeVersion": 64,
          "lines": [
            {
              "lineId": "215",
              "lineType": 1,
              "content": "賛曰：愍懷聰頴，諒惟天挺。"
            },
            {
              "lineId": "216",
              "lineType": 1,
              "content": "皇祖鍾心，庶僚引領。"
            },
            {
              "lineId": "217",
              "lineType": 1,
              "content": "震宫肇建，儲德不恢。"
            },
            {
              "lineId": "218",
              "lineType": 1,
              "content": "掇蜂搆隙，歸胙生災。"
            },
            {
              "lineId": "219",
              "lineType": 1,
              "content": "旣罹凶忍，徒望歸來。"
            },
            {
              "lineId": "220",
              "lineType": 3,
              "content": "",
              "pagePass": {
                "PageId": "7444729325884112948"
              }
            },
            {
              "lineId": "221",
              "lineType": 1,
              "content": "晉書卷五十三，"
            }
          ]
        }
      ]
    },
