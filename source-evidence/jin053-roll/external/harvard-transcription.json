            {
              "lineId": "223",
              "lineType": 9,
              "content": "晉書卷五十三考證："
            }
          ]
        },
        {
          "paragraphId": "7675249288952447012",
          "chapterId": "1mb9kswm56otn",
          "startPageId": "7444729324927877161",
          "endPageId": "7444729324927909929",
          "volumeVersion": 64,
          "lines": [
            {
              "lineId": "224",
              "lineType": 1,
              "content": "愍懷太子傳：先是，有童謠曰：東宮馬子莫聾空，前至臘月纒汝鬉。"
            },
            {
              "lineId": "225",
              "lineType": 1,
              "content": "○本書五行志聾空作隴哅，前作比，臘月作來年，與此小異。"
            },
            {
              "lineId": "226",
              "lineType": 1,
              "content": "不若遷延却期○却，監本作刼，綱目分注作緩，今從閣本"
            },
            {
              "lineId": "227",
              "lineType": 3,
              "content": "",
              "pagePass": {
                "PageId": "7444729324927909929"
              }
            },
            {
              "lineId": "228",
              "lineType": 1,
              "content": "晉書卷五十三考證。"
            }
          ]
        }
      ]
    }
  ]
