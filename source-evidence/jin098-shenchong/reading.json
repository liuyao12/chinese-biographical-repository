  "external_clauses": [
    {
      "witness": "j89",
      "quote": "沈勁，字世堅，吳興武康人也。父[[晉書/卷098#沈充|充]]，與王敦構逆，眾敗而逃，為部曲將吳儒所殺。",
      "raw_start": 10094,
      "raw_end": 10146,
      "raw_line": 131
    },
    {
      "witness": "j81",
      "quote": "劉遐，字正長，廣平易陽人也。",
      "raw_start": 10906,
      "raw_end": 10920,
      "raw_line": 123
    },
    {
      "witness": "j6",
      "quote": "沈充帥萬餘人來會含等，庚辰，築壘于陵口。",
      "raw_start": 10281,
      "raw_end": 10301,
      "raw_line": 201
    },
    {
      "witness": "j6",
      "quote": "劉遐又破沈充于青溪。",
      "raw_start": 10420,
      "raw_end": 10430,
      "raw_line": 201
    },
    {
      "witness": "j6",
      "quote": "沈充故將顧颺反於武康，攻燒城邑，州縣討斬之。",
      "raw_start": 10798,
      "raw_end": 10820,
      "raw_line": 207
    },
    {
      "witness": "j98",
      "quote": "既而周光斬錢鳳，吳儒斬沈充，並傳首京師。",
      "raw_start": 6824,
