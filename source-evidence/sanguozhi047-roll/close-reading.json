  "boundaries": [],
  "chronology": [
    {
      "source_line": 12,
      "reading": "正文十五歲任陽羨長。裴注江表傳只繫出生於父孫堅任下邳丞之時，未給干支或年號。"
    },
    {
      "source_line": 16,
      "reading": "本卷承建安七年，《吳夫人傳》正文亦七年，所引《志林》由會稽貢舉空白改推十二年。保留各自依據。"
    },
    {
      "source_line": 20,
      "reading": "本段正文建安九年繫孫翊死及孫瑜代。裴注開頭「是時」敘沈友被害而報二十九歲，注內未標月、日。"
    },
    {
      "source_lines": [
        48,
        49,
        53,
        59,
        77
      ],
      "reading": "魏吳王策命、黃武元年兩國事、吳主改年說及黃龍元年即帝位分段，不把吳王策封作即帝位。"
    },
    {
      "source_lines": [
        89,
        91
      ],
      "reading": "周賀出使及死在嘉禾元年，張彌、許晏、賀達次年出行，秦旦等返吳及謝宏一行有相對時間「其年」「間一年」。"
    },
    {
      "source_line": 137,
      "reading": "太元二年二月改神鳳，四月薨時年七十一，秋七月葬。《三嗣主傳》孫亮條以太元元年「明年四月」並記魏嘉平四年。"
    }
  ],
  "readings": [],
  "identity_limits": [
    {
      "source_lines": [
        44,
        59
      ],
      "reading": "卷內關羽子平之敘與早存本卷節引同事。鄭泉、趙咨、沈珩各由字、籍貫、出使行程定名。"
    },
    {
      "source_line": 65,
      "reading": "孫邵字長緒、北海人及丞相依正文、吳錄。長子熾是另注「陳化」所出，與孫邵無涉。"
    },
    {
      "source_line": 91,
      "reading": "玄菟太守王贊以任所與四吳使事定名，與後來皇太子舍人王贊分。句驪王宮照原稱，待異史紀次銜接。"
    },
    {
      "source_line": 111,
      "reading": "鄭冑字敬先，裴注記父札、子豐。殿本考證據張昭傳另見鄭禮、孫紹，指出同是撰定朝儀而名形相異，兩組原讀各保留，亦與孫策子上虞侯孫紹分開。"
    },
    {
      "source_line": 115,
      "reading": "數位稱殷禮，殿本正文注作殷札，殿本考證以張溫傳、顧雍傳等對勘疑作禮。沿用既有殷禮身分。"
    },
    {
      "source_line": 135,
      "reading": "數位同段祟、崇並見，殿本中書郎作李崇。卷六十四孫綝傳中書郎作李祟，使用孫吳既有人物。"
    }
  ],
