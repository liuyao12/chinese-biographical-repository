{
  "pdf_url": "https://upload.wikimedia.org/wikipedia/commons/2/25/NLC892-411999017142-12360_%E4%BA%8C%E5%8D%81%E5%9B%9B%E5%8F%B2_%E7%AC%AC246%E5%86%8A.pdf",
  "catalog_permalink": "https://commons.wikimedia.org/wiki/File:NLC892-411999017142-12360_二十四史_第246冊.pdf",
  "pdf_sha256": "c6b0632b046a75b94b3979d129f2efae5a478386f132326bce47db46b81105b2",
  "column_file": "source-evidence/nanshi022-wangyun/wyd-columns.txt",
  "column_file_sha256": "926ceb18b937c6612202ae0e975b51816ffe9fa93ccf09573b64985563a56669",
  "columns": [
    {
      "pdf_page": 84,
      "half": "右",
      "leaf": "二十二下",
      "column_from_right": 7,
      "reading": "筠字元禮一字德柔幼而警悟七歲能屬文年十六為",
      "start_codepoint": 0,
      "end_codepoint": 21
    },
    {
      "pdf_page": 84,
      "half": "右",
      "leaf": "二十二下",
      "column_from_right": 8,
      "reading": "芍藥賦其辭甚美及長清靜好學與從兄泰齊名沈約",
      "start_codepoint": 21,
      "end_codepoint": 42
    },
    {
      "pdf_page": 84,
      "half": "右",
      "leaf": "二十二下",
      "column_from_right": 9,
      "reading": "見筠以為似外祖袁粲謂僕射張稷曰王郎非唯額類",
      "start_codepoint": 42,
      "end_codepoint": 63
    },
    {
      "pdf_page": 84,
      "half": "右",
      "leaf": "二十二下",
      "column_from_right": 10,
      "reading": "袁公風韻都欲相似稷曰袁公見人輒矜嚴王郎見人",
      "start_codepoint": 63,
      "end_codepoint": 84
    },
    {
      "pdf_page": 84,
      "half": "左",
      "leaf": "二十三上",
      "column_from_right": 1,
      "reading": "必娛笑唯此一條不能酷似仕為尚書殿中郎王氏過",
      "start_codepoint": 84,
      "end_codepoint": 105
    },
    {
      "pdf_page": 84,
      "half": "左",
      "leaf": "二十三上",
      "column_from_right": 2,
      "reading": "江以來未有居郎署或勸不就筠曰陸平原東南之秀",
      "start_codepoint": 105,
      "end_codepoint": 126
    },
    {
      "pdf_page": 84,
      "half": "左",
      "leaf": "二十三上",
      "column_from_right": 3,
      "reading": "王文度獨步江東吾得比蹤昔人何所多恨乃欣然就",
      "start_codepoint": 126,
      "end_codepoint": 147
    },
    {
      "pdf_page": 84,
      "half": "左",
      "leaf": "二十三上",
      "column_from_right": 4,
      "reading": "職沈約每見筠文咨嗟嘗謂曰昔蔡伯喈見王仲宣稱",
      "start_codepoint": 147,
      "end_codepoint": 168
    },
    {
      "pdf_page": 84,
      "half": "左",
      "leaf": "二十三上",
      "column_from_right": 5,
      "reading": "曰王公之孫吾家書籍悉當相與僕雖不敏請附斯言",
      "start_codepoint": 168,
      "end_codepoint": 189
    },
    {
      "pdf_page": 84,
      "half": "左",
      "leaf": "二十三上",
      "column_from_right": 6,
      "reading": "自謝朓諸賢零落平生意好殆絕不謂疲暮復逢於君",
      "start_codepoint": 189,
      "end_codepoint": 210
    },
    {
      "pdf_page": 84,
      "half": "左",
      "leaf": "二十三上",
      "column_from_right": 7,
      "reading": "約於郊居宅閣齋請筠為草木十詠書之壁皆直寫文",
      "start_codepoint": 210,
      "end_codepoint": 231
    },
    {
      "pdf_page": 84,
      "half": "左",
      "leaf": "二十三上",
      "column_from_right": 8,
      "reading": "辭不加篇題約謂人曰此詩指物程形無假題署約製",
      "start_codepoint": 231,
      "end_codepoint": 252
    },
    {
      "pdf_page": 84,
      "half": "左",
      "leaf": "二十三上",
      "column_from_right": 9,
      "reading": "郊居賦構思積時猶未都畢示筠草筠讀至雌霓連",
      "start_codepoint": 252,
      "end_codepoint": 272
    },
    {
      "pdf_page": 84,
      "half": "左",
      "leaf": "二十三上",
      "column_from_right": 10,
      "reading": "蜷約撫掌欣抃曰僕常恐人呼為霓次至墜石磓星",
      "start_codepoint": 272,
      "end_codepoint": 292
    },
    {
      "pdf_page": 85,
      "half": "右",
      "leaf": "二十三下",
      "column_from_right": 1,
      "reading": "及冰懸埳而帶坻筠皆擊節稱贊約曰知音者希真賞",
      "start_codepoint": 292,
      "end_codepoint": 313
    },
    {
      "pdf_page": 85,
      "half": "右",
      "leaf": "二十三下",
      "column_from_right": 2,
      "reading": "殆絕所以相要政在此數句耳筠又嘗為詩呈約約即",
      "start_codepoint": 313,
      "end_codepoint": 334
    },
    {
      "pdf_page": 85,
      "half": "右",
      "leaf": "二十三下",
      "column_from_right": 3,
      "reading": "報書歎詠以為後進擅美筠又能用強韻每公宴並作",
      "start_codepoint": 334,
      "end_codepoint": 355
    },
    {
      "pdf_page": 85,
      "half": "右",
      "leaf": "二十三下",
      "column_from_right": 4,
      "reading": "辭必妍靡約嘗啓上言晚來名家無先筠者又於御筵",
      "start_codepoint": 355,
      "end_codepoint": 376
    },
    {
      "pdf_page": 85,
      "half": "右",
      "leaf": "二十三下",
      "column_from_right": 5,
      "reading": "謂王志曰賢弟子文章之美可謂後來獨步謝朓常見",
      "start_codepoint": 376,
      "end_codepoint": 397
    },
    {
      "pdf_page": 85,
      "half": "右",
      "leaf": "二十三下",
      "column_from_right": 6,
      "reading": "語云好詩圓美流轉如彈丸近見其數首方知此言為",
      "start_codepoint": 397,
      "end_codepoint": 418
    },
    {
      "pdf_page": 85,
      "half": "右",
      "leaf": "二十三下",
      "column_from_right": 7,
      "reading": "實累遷太子洗馬中舍人並掌東宮管記昭明太子愛",
      "start_codepoint": 418,
      "end_codepoint": 439
    },
    {
      "pdf_page": 85,
      "half": "右",
      "leaf": "二十三下",
      "column_from_right": 8,
      "reading": "文學士常與筠及劉孝綽陸倕到洽殷鈞等遊宴玄圃",
      "start_codepoint": 439,
      "end_codepoint": 460
    },
    {
      "pdf_page": 85,
      "half": "右",
      "leaf": "二十三下",
      "column_from_right": 9,
      "reading": "太子獨執筠袖撫孝綽肩曰所謂左把浮丘袖右拍洪",
      "start_codepoint": 460,
      "end_codepoint": 481
    },
    {
      "pdf_page": 85,
      "half": "右",
      "leaf": "二十三下",
      "column_from_right": 10,
      "reading": "崖肩其見重如此筠又與殷鈞以方雅見禮後為中書",
      "start_codepoint": 481,
      "end_codepoint": 502
    },
    {
      "pdf_page": 85,
      "half": "左",
      "leaf": "二十四上",
      "column_from_right": 1,
      "reading": "郎奉敕製開善寺寶誌法師碑文辭甚麗逸又敕撰中",
      "start_codepoint": 502,
      "end_codepoint": 523
    },
    {
      "pdf_page": 85,
      "half": "左",
      "leaf": "二十四上",
      "column_from_right": 2,
      "reading": "書表奏三十卷及所上賦頌都為一集後為太子家令",
      "start_codepoint": 523,
      "end_codepoint": 544
    },
    {
      "pdf_page": 85,
      "half": "左",
      "leaf": "二十四上",
      "column_from_right": 3,
      "reading": "復掌管記普通元年以母憂去職筠有孝性毀瘠過禮",
      "start_codepoint": 544,
      "end_codepoint": 565
    },
    {
      "pdf_page": 85,
      "half": "左",
      "leaf": "二十四上",
      "column_from_right": 4,
      "reading": "大通二年為司徒左長史三年昭明太子薨敕製哀策",
      "start_codepoint": 565,
      "end_codepoint": 586
    },
    {
      "pdf_page": 85,
      "half": "左",
      "leaf": "二十四上",
      "column_from_right": 5,
      "reading": "文復見嗟賞尋出為臨海太守在郡侵刻還資有芒屩",
      "start_codepoint": 586,
      "end_codepoint": 607
    },
    {
      "pdf_page": 85,
      "half": "左",
      "leaf": "二十四上",
      "column_from_right": 6,
      "reading": "兩舫他物稱是為有司奏不調累年後歷祕書監太府",
      "start_codepoint": 607,
      "end_codepoint": 628
    },
    {
      "pdf_page": 85,
      "half": "左",
      "leaf": "二十四上",
      "column_from_right": 7,
      "reading": "卿度支尚書司徒左長史及簡文卽位為太子詹事筠",
      "start_codepoint": 628,
      "end_codepoint": 649
    },
    {
      "pdf_page": 85,
      "half": "左",
      "leaf": "二十四上",
      "column_from_right": 8,
      "reading": "家累千金性儉嗇外服麤弊所乘牛嘗飼以青草及遇",
      "start_codepoint": 649,
      "end_codepoint": 670
    },
    {
      "pdf_page": 85,
      "half": "左",
      "leaf": "二十四上",
      "column_from_right": 9,
      "reading": "亂舊宅先為賊焚乃寓居國子祭酒蕭子雲宅夜忽有",
      "start_codepoint": 670,
      "end_codepoint": 691
    },
    {
      "pdf_page": 85,
      "half": "左",
      "leaf": "二十四上",
      "column_from_right": 10,
      "reading": "盜攻懼墜井卒時年六十九家人十二口同遇害人棄",
      "start_codepoint": 691,
      "end_codepoint": 712
    },
    {
      "pdf_page": 86,
      "half": "右",
      "leaf": "二十四下",
      "column_from_right": 1,
      "reading": "屍積於空井中筠狀貌寢小長不滿六尺性弘厚不以",
      "start_codepoint": 712,
      "end_codepoint": 733
    },
    {
      "pdf_page": 86,
      "half": "右",
      "leaf": "二十四下",
      "column_from_right": 2,
      "reading": "藝能高人而少擅才名與劉孝綽見重當時其自序云",
      "start_codepoint": 733,
      "end_codepoint": 754
    },
    {
      "pdf_page": 86,
      "half": "右",
      "leaf": "二十四下",
      "column_from_right": 3,
      "reading": "余少好抄書老而彌篤雖遇見瞥觀皆卽疏記後重省",
      "start_codepoint": 754,
      "end_codepoint": 775
    },
    {
      "pdf_page": 86,
      "half": "右",
      "leaf": "二十四下",
      "column_from_right": 4,
      "reading": "覽懽興彌深習與性成不覺筆倦自年十三四建武二",
      "start_codepoint": 775,
      "end_codepoint": 796
    },
    {
      "pdf_page": 86,
      "half": "右",
      "leaf": "二十四下",
      "column_from_right": 5,
      "reading": "年乙亥至梁大同六年四十載矣幼年讀五經皆七八",
      "start_codepoint": 796,
      "end_codepoint": 817
    },
    {
      "pdf_page": 86,
      "half": "右",
      "leaf": "二十四下",
      "column_from_right": 6,
      "reading": "十遍愛左氏春秋吟諷常為口實廣畧去取凡三過五",
      "start_codepoint": 817,
      "end_codepoint": 838
    },
    {
      "pdf_page": 86,
      "half": "右",
      "leaf": "二十四下",
      "column_from_right": 7,
      "reading": "抄餘經及周官儀禮國語爾雅山海經本草並再抄子",
      "start_codepoint": 838,
      "end_codepoint": 859
    },
    {
      "pdf_page": 86,
      "half": "右",
      "leaf": "二十四下",
      "column_from_right": 8,
      "reading": "史諸集皆一遍未嘗倩人假手並躬自抄錄大小百餘",
      "start_codepoint": 859,
      "end_codepoint": 880
    },
    {
      "pdf_page": 86,
      "half": "右",
      "leaf": "二十四下",
      "column_from_right": 9,
      "reading": "卷不足傳之好事蓋以備遺忘而已又與諸兒書論家",
      "start_codepoint": 880,
      "end_codepoint": 901
    },
    {
      "pdf_page": 86,
      "half": "右",
      "leaf": "二十四下",
      "column_from_right": 10,
      "reading": "門集云史傳稱安平崔氏及汝南應氏並累葉有文才",
      "start_codepoint": 901,
      "end_codepoint": 922
    },
    {
      "pdf_page": 86,
      "half": "左",
      "leaf": "二十五上",
      "column_from_right": 1,
      "reading": "所以范蔚宗云崔氏雕龍然不過父子兩三世耳非有",
      "start_codepoint": 922,
      "end_codepoint": 943
    },
    {
      "pdf_page": 86,
      "half": "左",
      "leaf": "二十五上",
      "column_from_right": 2,
      "reading": "七葉之中名德重光爵位相繼人人有集如吾門者也",
      "start_codepoint": 943,
      "end_codepoint": 964
    },
    {
      "pdf_page": 86,
      "half": "左",
      "leaf": "二十五上",
      "column_from_right": 3,
      "reading": "沈少傅約常語人云吾少好百家之言身為四代之史",
      "start_codepoint": 964,
      "end_codepoint": 985
    },
    {
      "pdf_page": 86,
      "half": "左",
      "leaf": "二十五上",
      "column_from_right": 4,
      "reading": "自開闢以來未有爵位蟬聯文才相繼如王氏之盛也",
      "start_codepoint": 985,
      "end_codepoint": 1006
    },
    {
      "pdf_page": 86,
      "half": "左",
      "leaf": "二十五上",
      "column_from_right": 5,
      "reading": "汝等仰觀堂構思各努力筠自撰其文章以一官為一",
      "start_codepoint": 1006,
      "end_codepoint": 1027
    },
    {
      "pdf_page": 86,
      "half": "左",
      "leaf": "二十五上",
      "column_from_right": 6,
      "reading": "集自洗馬中書中庶吏部左佐臨海太府各十卷尚書",
      "start_codepoint": 1027,
      "end_codepoint": 1048
    },
    {
      "pdf_page": 86,
      "half": "左",
      "leaf": "二十五上",
      "column_from_right": 7,
      "reading": "三十卷凡一百卷行於世子祥仕陳位黃門侍郎揖弟",
      "start_codepoint": 1048,
      "end_codepoint": 1069
    },
    {
      "pdf_page": 86,
      "half": "左",
      "leaf": "二十五上",
      "column_from_right": 8,
      "reading": "彬",
      "start_codepoint": 1069,
      "end_codepoint": 1070
    }
  ],
