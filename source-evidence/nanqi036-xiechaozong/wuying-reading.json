{
  "pdf_url": "https://upload.wikimedia.org/wikipedia/commons/4/4f/NLC892-411999017142-12464_%E4%BA%8C%E5%8D%81%E5%9B%9B%E5%8F%B2_%E7%AC%AC159%E5%86%8A.pdf",
  "catalog_permalink": "https://commons.wikimedia.org/w/index.php?oldid=1154634011",
  "file_description_revision": 1154634011,
  "pdf_sha256": "9bb3072ec6ab8a07612d5fa19b2dc2d272f0889cd13e0ffb55d83a6f5625c41e",
  "column_file": "source-evidence/nanqi036-xiechaozong/wyd-columns.txt",
  "column_file_sha256": "d752793ccca569b28429b050d8c65fdbf97b11cc0c1a900dea28b4c8bc588dcc",
  "columns": [
    {
      "pdf_page": 102,
      "half": "左",
      "leaf": "一上",
      "column_from_right": 5,
      "reading": "謝超宗陳郡陽夏人也祖靈運宋臨川內史父鳳元嘉",
      "start_codepoint": 0,
      "end_codepoint": 21
    },
    {
      "pdf_page": 102,
      "half": "左",
      "leaf": "一上",
      "column_from_right": 6,
      "reading": "中坐靈運事同徙嶺南早卒元嘉末超宗得還與慧休",
      "start_codepoint": 21,
      "end_codepoint": 42
    },
    {
      "pdf_page": 102,
      "half": "左",
      "leaf": "一上",
      "column_from_right": 7,
      "reading": "道人來往好學有文辭盛得名譽解褐奉朝請新安王",
      "start_codepoint": 42,
      "end_codepoint": 63
    },
    {
      "pdf_page": 102,
      "half": "左",
      "leaf": "一上",
      "column_from_right": 8,
      "reading": "子鸞孝武帝寵子超宗以選補王國常侍王母殷淑儀",
      "start_codepoint": 63,
      "end_codepoint": 84
    },
    {
      "pdf_page": 102,
      "half": "左",
      "leaf": "一上",
      "column_from_right": 9,
      "reading": "卒超宗作誄奏之帝大嗟賞曰超宗殊有鳳毛恐靈運",
      "start_codepoint": 84,
      "end_codepoint": 105
    },
    {
      "pdf_page": 102,
      "half": "左",
      "leaf": "一上",
      "column_from_right": 10,
      "reading": "復出轉新安王撫軍行參軍泰始初為建安王司徒參",
      "start_codepoint": 105,
      "end_codepoint": 126
    },
    {
      "pdf_page": 103,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 1,
      "reading": "軍事尚書殿中郎三年都令史駱宰議策秀才考格五",
      "start_codepoint": 126,
      "end_codepoint": 147
    },
    {
      "pdf_page": 103,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 2,
      "reading": "問並得為上四三為中二為下一不合與第超宗議以",
      "start_codepoint": 147,
      "end_codepoint": 168
    },
    {
      "pdf_page": 103,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 3,
      "reading": "為片辭折獄寸言挫衆魯史褒貶孔論興替皆無俟繁",
      "start_codepoint": 168,
      "end_codepoint": 189
    },
    {
      "pdf_page": 103,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 4,
      "reading": "而後秉裁夫表事之淵析理之會豈必委牘方切治道",
      "start_codepoint": 189,
      "end_codepoint": 210
    },
    {
      "pdf_page": 103,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 5,
      "reading": "非患對不盡問患以恒文弗奇必使一通峻正寧劣五",
      "start_codepoint": 210,
      "end_codepoint": 231
    },
    {
      "pdf_page": 103,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 6,
      "reading": "通而常與其俱奇必使一亦宜採詔從宰議遷司徒主",
      "start_codepoint": 231,
      "end_codepoint": 252
    },
    {
      "pdf_page": 103,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 7,
      "reading": "簿丹陽丞建安王休仁引為司徒記室正員郎兼尚書",
      "start_codepoint": 252,
      "end_codepoint": 273
    },
    {
      "pdf_page": 103,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 8,
      "reading": "左丞中郎以直言忤僕射劉康左遷通直常侍太祖為",
      "start_codepoint": 273,
      "end_codepoint": 294
    },
    {
      "pdf_page": 103,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 9,
      "reading": "領軍數與超宗共屬文愛其才翰衞將軍袁粲聞之謂",
      "start_codepoint": 294,
      "end_codepoint": 315
    },
    {
      "pdf_page": 103,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 10,
      "reading": "太祖曰超宗開亮迥悟善可與語取為長史臨淮太守",
      "start_codepoint": 315,
      "end_codepoint": 336
    },
    {
      "pdf_page": 103,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 1,
      "reading": "粲旣誅太祖以超宗為義興太守昇明二年坐公事免",
      "start_codepoint": 336,
      "end_codepoint": 357
    },
    {
      "pdf_page": 103,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 2,
      "reading": "詣東府門自通其日風寒慘厲太祖謂四座曰此客至",
      "start_codepoint": 357,
      "end_codepoint": 378
    },
    {
      "pdf_page": 103,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 3,
      "reading": "使人不衣自暖矣超宗旣坐飲酒數甌辭氣橫出太祖",
      "start_codepoint": 378,
      "end_codepoint": 399
    },
    {
      "pdf_page": 103,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 4,
      "reading": "對之甚歡板為驃騎諮議及卽位轉黃門郎有司奏撰",
      "start_codepoint": 399,
      "end_codepoint": 420
    },
    {
      "pdf_page": 103,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 5,
      "reading": "立郊廟歌敕司徒褚淵侍中謝朏散騎侍郎孔稚珪太",
      "start_codepoint": 420,
      "end_codepoint": 441
    },
    {
      "pdf_page": 103,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 6,
      "reading": "學博士王咺之總明學士劉融何法冏何曇秀等十人",
      "start_codepoint": 441,
      "end_codepoint": 462
    },
    {
      "pdf_page": 103,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 7,
      "reading": "並作超宗辭獨見用為人仗才使酒多所陵忽在直省",
      "start_codepoint": 462,
      "end_codepoint": 483
    },
    {
      "pdf_page": 103,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 8,
      "reading": "常醉上召見語及北方事超宗曰虜動來二十年矣佛",
      "start_codepoint": 483,
      "end_codepoint": 504
    },
    {
      "pdf_page": 103,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 9,
      "reading": "出亦無如何以失儀出為南郡王中軍司馬超宗怨望",
      "start_codepoint": 504,
      "end_codepoint": 525
    },
    {
      "pdf_page": 103,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 10,
      "reading": "謂人曰我今日政應為司驢為省司所奏以怨望免官",
      "start_codepoint": 525,
      "end_codepoint": 546
    },
    {
      "pdf_page": 104,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 1,
      "reading": "禁錮十年司徒褚淵送湘州刺史王僧虔閣道壞墜水",
      "start_codepoint": 546,
      "end_codepoint": 567
    },
    {
      "pdf_page": 104,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 2,
      "reading": "僕射王儉嘗牛驚跣下車超宗撫掌笑戲曰落水三公",
      "start_codepoint": 567,
      "end_codepoint": 588
    },
    {
      "pdf_page": 104,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 3,
      "reading": "墮車僕射前後言誚稍布朝野世祖卽位使掌國史除",
      "start_codepoint": 588,
      "end_codepoint": 609
    },
    {
      "pdf_page": 104,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 4,
      "reading": "竟陵王征北諮議參軍領記室愈不得志超宗娶張敬",
      "start_codepoint": 609,
      "end_codepoint": 630
    },
    {
      "pdf_page": 104,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 5,
      "reading": "兒女為子婦上甚疑之永明元年敬兒誅超宗謂丹陽",
      "start_codepoint": 630,
      "end_codepoint": 651
    },
    {
      "pdf_page": 104,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 6,
      "reading": "尹李安民曰往年殺韓信今年殺彭越尹欲何計安民",
      "start_codepoint": 651,
      "end_codepoint": 672
    },
    {
      "pdf_page": 104,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 7,
      "reading": "具啟之上積懷超宗輕慢使兼中丞袁彖奏曰風聞征",
      "start_codepoint": 672,
      "end_codepoint": 693
    },
    {
      "pdf_page": 104,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 8,
      "reading": "北諮議參軍謝超宗根性浮險率情躁薄仕近聲權務",
      "start_codepoint": 693,
      "end_codepoint": 714
    },
    {
      "pdf_page": 104,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 9,
      "reading": "先諂狎人裁疏黜亟便詆賤卒然面譽旋而背毀疑間",
      "start_codepoint": 714,
      "end_codepoint": 735
    },
    {
      "pdf_page": 104,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 10,
      "reading": "台賢每窮詭舌訕貶朝政必聲凶言腹誹口謗莫此之",
      "start_codepoint": 735,
      "end_codepoint": 756
    },
    {
      "pdf_page": 104,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 1,
      "reading": "甚不敬不諱罕與為二輒攝白從王永先到臺辨問超",
      "start_codepoint": 756,
      "end_codepoint": 777
    },
    {
      "pdf_page": 104,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 2,
      "reading": "宗有何罪過詣諸貴皆有不遜言語並依事列對永先",
      "start_codepoint": 777,
      "end_codepoint": 798
    },
    {
      "pdf_page": 104,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 3,
      "reading": "列稱主人超宗恒行來詣諸貴要每多觸忤言語怨懟",
      "start_codepoint": 798,
      "end_codepoint": 819
    },
    {
      "pdf_page": 104,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 4,
      "reading": "與張敬兒周旋許結姻好自敬兒死後惋歎忿慨今月",
      "start_codepoint": 819,
      "end_codepoint": 840
    },
    {
      "pdf_page": 104,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 5,
      "reading": "初詣李安民語論張敬兒不應死安民道敬兒書疏墨",
      "start_codepoint": 840,
      "end_codepoint": 861
    },
    {
      "pdf_page": 104,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 6,
      "reading": "迹炳然卿何忽作此語其中多有不遜之言小人不悉",
      "start_codepoint": 861,
      "end_codepoint": 882
    },
    {
      "pdf_page": 104,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 7,
      "reading": "盡羅縷諳憶如其辭列則與風聞符同超宗罪自己彰",
      "start_codepoint": 882,
      "end_codepoint": 903
    },
    {
      "pdf_page": 104,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 8,
      "reading": "宜附常准超宗少無士行長習民慝狂狡之迹聯代所",
      "start_codepoint": 903,
      "end_codepoint": 924
    },
    {
      "pdf_page": 104,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 9,
      "reading": "疾迷慠之釁累朝兼觸剗容掃轍久埋世表屬聖明廣",
      "start_codepoint": 924,
      "end_codepoint": 945
    },
    {
      "pdf_page": 104,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 10,
      "reading": "愛忍禍宣慈捨之憲外許以改過野心不悛在宥方驕",
      "start_codepoint": 945,
      "end_codepoint": 966
    },
    {
      "pdf_page": 105,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 1,
      "reading": "才性無親處恩彌戾遂連扇非端空生怨懟恣囂毒於",
      "start_codepoint": 966,
      "end_codepoint": 987
    },
    {
      "pdf_page": 105,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 2,
      "reading": "京輔之門揚凶悖於卿守之席此而不翦國章何寄此",
      "start_codepoint": 987,
      "end_codepoint": 1008
    },
    {
      "pdf_page": 105,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 3,
      "reading": "而可貸孰不可容請以見事免超宗所居官解領記室",
      "start_codepoint": 1008,
      "end_codepoint": 1029
    },
    {
      "pdf_page": 105,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 4,
      "reading": "輒勒外收付廷尉法獄治罪超宗品第未入簡奏臣輒",
      "start_codepoint": 1029,
      "end_codepoint": 1050
    },
    {
      "pdf_page": 105,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 5,
      "reading": "奉白簡以聞世祖雖可其奏以彖言辭依違大怒使左",
      "start_codepoint": 1050,
      "end_codepoint": 1071
    },
    {
      "pdf_page": 105,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 6,
      "reading": "丞王逡之奏曰臣聞行父盡忠無禮斯疾農夫去草見",
      "start_codepoint": 1071,
      "end_codepoint": 1092
    },
    {
      "pdf_page": 105,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 7,
      "reading": "惡必耘所以振纓稱良登朝著績未有尸位存私而能",
      "start_codepoint": 1092,
      "end_codepoint": 1113
    },
    {
      "pdf_page": 105,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 8,
      "reading": "保其榮名者也今月九日治書侍御史臣司馬侃啟彈",
      "start_codepoint": 1113,
      "end_codepoint": 1134
    },
    {
      "pdf_page": 105,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 9,
      "reading": "征北諮議參軍事謝超宗稱根性昏動率心險放悖議",
      "start_codepoint": 1134,
      "end_codepoint": 1155
    },
    {
      "pdf_page": 105,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 10,
      "reading": "爽眞囂辭犯實親朋忍聞衣冠掩目輒收付廷尉法獄",
      "start_codepoint": 1155,
      "end_codepoint": 1176
    },
    {
      "pdf_page": 105,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 1,
      "reading": "治罪處劾雖重文辭簡略事入主書被却還外其晚兼",
      "start_codepoint": 1176,
      "end_codepoint": 1197
    },
    {
      "pdf_page": 105,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 2,
      "reading": "御史中丞臣袁彖改奏白簡始粗詳備厥初隱衞寔彖",
      "start_codepoint": 1197,
      "end_codepoint": 1218
    },
    {
      "pdf_page": 105,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 3,
      "reading": "之由尋超宗植性險戾稟行凶詖豺狼野心久暴遐邇",
      "start_codepoint": 1218,
      "end_codepoint": 1239
    },
    {
      "pdf_page": 105,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 4,
      "reading": "張敬兒潛圖反噬罰未塞諐而稱怨痛枉形于言貌協",
      "start_codepoint": 1239,
      "end_codepoint": 1260
    },
    {
      "pdf_page": 105,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 5,
      "reading": "附姦邪疑間勳烈構扇異端譏議時政行路同忿有心",
      "start_codepoint": 1260,
      "end_codepoint": 1281
    },
    {
      "pdf_page": 105,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 6,
      "reading": "咸疾而阿昧苟容輕文畧奏又彈事舊體品第不簡而",
      "start_codepoint": 1281,
      "end_codepoint": 1302
    },
    {
      "pdf_page": 105,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 7,
      "reading": "釁戾殊常者皆命議親奏以彰深諐況超宗罪逾四凶",
      "start_codepoint": 1302,
      "end_codepoint": 1323
    },
    {
      "pdf_page": 105,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 8,
      "reading": "過窮南竹雖下輒收而文止黃案沈浮并見輕重相乖",
      "start_codepoint": 1323,
      "end_codepoint": 1344
    },
    {
      "pdf_page": 105,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 9,
      "reading": "此而不糾憲綱將替彖才識疏淺質幹無聞憑戚昇榮",
      "start_codepoint": 1344,
      "end_codepoint": 1365
    },
    {
      "pdf_page": 105,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 10,
      "reading": "因慈荷任不能克己厲情少酬恩獎撓法容非用申私",
      "start_codepoint": 1365,
      "end_codepoint": 1386
    },
    {
      "pdf_page": 106,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 1,
      "reading": "惠何以糾正邦違式明王度臣等參議請以見事免彖",
      "start_codepoint": 1386,
      "end_codepoint": 1407
    },
    {
      "pdf_page": 106,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 2,
      "reading": "所居官解兼御史中丞輒攝曹依舊下禁止視事如故",
      "start_codepoint": 1407,
      "end_codepoint": 1428
    },
    {
      "pdf_page": 106,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 3,
      "reading": "治書侍御史臣司馬侃雖承稟有由而初無疑執亦合",
      "start_codepoint": 1428,
      "end_codepoint": 1449
    },
    {
      "pdf_page": 106,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 4,
      "reading": "及咎請杖督五十奪勞百日令史卑微不足申盡啟可",
      "start_codepoint": 1449,
      "end_codepoint": 1470
    },
    {
      "pdf_page": 106,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 5,
      "reading": "奉行侃奏彈之始臣等並卽經見加推糾案入主書方",
      "start_codepoint": 1470,
      "end_codepoint": 1491
    },
    {
      "pdf_page": 106,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 6,
      "reading": "被却檢疏謬之諐伏追震悚詔曰超宗釁同大逆罪不",
      "start_codepoint": 1491,
      "end_codepoint": 1512
    },
    {
      "pdf_page": 106,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 7,
      "reading": "容誅彖匿情欺國愛朋罔主事合極法特原收治免官",
      "start_codepoint": 1512,
      "end_codepoint": 1533
    },
    {
      "pdf_page": 106,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 8,
      "reading": "如案禁錮十年超宗下廷尉一宿髮白皓首詔徙越州",
      "start_codepoint": 1533,
      "end_codepoint": 1554
    },
    {
      "pdf_page": 106,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 9,
      "reading": "行至豫章上敕豫章內史虞悰曰謝超宗令於彼賜自",
      "start_codepoint": 1554,
      "end_codepoint": 1575
    },
    {
      "pdf_page": 106,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 10,
      "reading": "盡勿傷其形骸明年超宗門生王永先又告超宗子才",
      "start_codepoint": 1575,
      "end_codepoint": 1596
    },
    {
      "pdf_page": 106,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 1,
      "reading": "卿死罪二十餘條上疑其虛妄以才卿付廷尉辯以不",
      "start_codepoint": 1596,
      "end_codepoint": 1617
    },
    {
      "pdf_page": 106,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 2,
      "reading": "實見原永先於獄自盡",
      "start_codepoint": 1617,
      "end_codepoint": 1626
    }
  ],
