  "column_file": "source-evidence/nan011-hejingying-izumo/izumo-columns.txt",
  "column_file_sha256": "42cd86d726f3a45837cf602cd64f29a4d1b2c1b5aa846ac134099ae0c048689f",
  "columns": [
    {
      "pdf_page": 21,
      "half": "左",
      "leaf": "十九上",
      "column_from_right": 6,
      "reading": "鬱林王何妃諱婧英廬江灊人撫軍將軍戢女",
      "start_codepoint": 0,
      "end_codepoint": 18
    },
    {
      "pdf_page": 21,
      "half": "左",
      "leaf": "十九上",
      "column_from_right": 7,
      "reading": "也初將納為南郡王妃文惠太子嫌戢無男門",
      "start_codepoint": 18,
      "end_codepoint": 36
    },
    {
      "pdf_page": 21,
      "half": "左",
      "leaf": "十九上",
      "column_from_right": 8,
      "reading": "孤不欲與昏王儉以南郡王妃便為將來外戚",
      "start_codepoint": 36,
      "end_codepoint": 54
    },
    {
      "pdf_page": 21,
      "half": "左",
      "leaf": "十九上",
      "column_from_right": 9,
      "reading": "唯須高胄不須強門今何氏蔭華族弱寔允外",
      "start_codepoint": 54,
      "end_codepoint": 72
    },
    {
      "pdf_page": 22,
      "half": "右",
      "leaf": "十九下",
      "column_from_right": 1,
      "reading": "戚之義永明三年乃成昏妃稟性淫亂南郡王",
      "start_codepoint": 72,
      "end_codepoint": 90
    },
    {
      "pdf_page": 22,
      "half": "右",
      "leaf": "十九下",
      "column_from_right": 2,
      "reading": "所與無賴人游妃擇其美者皆與交歡南郡王",
      "start_codepoint": 90,
      "end_codepoint": 108
    },
    {
      "pdf_page": 22,
      "half": "右",
      "leaf": "十九下",
      "column_from_right": 3,
      "reading": "侍書馬澄年少色美甚為妃悅嘗與鬥腕較力",
      "start_codepoint": 108,
      "end_codepoint": 126
    },
    {
      "pdf_page": 22,
      "half": "右",
      "leaf": "十九下",
      "column_from_right": 4,
      "reading": "南郡王以為歡笑澄者本剡縣寒人嘗於南岸",
      "start_codepoint": 126,
      "end_codepoint": 144
    },
    {
      "pdf_page": 22,
      "half": "右",
      "leaf": "十九下",
      "column_from_right": 5,
      "reading": "逼略人家女為秣陵縣所錄南郡王語縣散遣",
      "start_codepoint": 144,
      "end_codepoint": 162
    },
    {
      "pdf_page": 22,
      "half": "右",
      "leaf": "十九下",
      "column_from_right": 6,
      "reading": "之澄又逼求姨女為妾姨不與澄詣建康令沈",
      "start_codepoint": 162,
      "end_codepoint": 180
    },
    {
      "pdf_page": 22,
      "half": "右",
      "leaf": "十九下",
      "column_from_right": 7,
      "reading": "徽孚訟之徽孚曰姨女可為婦不可為妾澄曰",
      "start_codepoint": 180,
      "end_codepoint": 198
    },
    {
      "pdf_page": 22,
      "half": "右",
      "leaf": "十九下",
      "column_from_right": 8,
      "reading": "僕父為給事中門戶既盛姨家猶是寒賤政可",
      "start_codepoint": 198,
      "end_codepoint": 216
    },
    {
      "pdf_page": 22,
      "half": "右",
      "leaf": "十九下",
      "column_from_right": 9,
      "reading": "為妾耳徽孚訶而遣之十一年為皇太孫妃又",
      "start_codepoint": 216,
      "end_codepoint": 234
    },
    {
      "pdf_page": 22,
      "half": "左",
      "leaf": "二十上",
      "column_from_right": 1,
      "reading": "有女巫子楊珉之亦有美貌妃尤愛之與同寢",
      "start_codepoint": 234,
      "end_codepoint": 252
    },
    {
      "pdf_page": 22,
      "half": "左",
      "leaf": "二十上",
      "column_from_right": 2,
      "reading": "處如伉儷及太孫即帝位為皇后封后嫡母劉",
      "start_codepoint": 252,
      "end_codepoint": 270
    },
    {
      "pdf_page": 22,
      "half": "左",
      "leaf": "二十上",
      "column_from_right": 3,
      "reading": "為高昌縣都鄉君所生母宋為餘杭廣昌鄉君",
      "start_codepoint": 270,
      "end_codepoint": 288
    },
    {
      "pdf_page": 22,
      "half": "左",
      "leaf": "二十上",
      "column_from_right": 4,
      "reading": "后將拜鏡在牀無因墮地其冬與太后同日謁太",
      "start_codepoint": 288,
      "end_codepoint": 307
    },
    {
      "pdf_page": 22,
      "half": "左",
      "leaf": "二十上",
      "column_from_right": 5,
      "reading": "廟楊珉之為帝所幸常居中侍明帝為輔與王",
      "start_codepoint": 307,
      "end_codepoint": 325
    },
    {
      "pdf_page": 22,
      "half": "左",
      "leaf": "二十上",
      "column_from_right": 6,
      "reading": "晏徐孝嗣王廣之並面請不聽又令蕭諶坦之",
      "start_codepoint": 325,
      "end_codepoint": 343
    },
    {
      "pdf_page": 22,
      "half": "左",
      "leaf": "二十上",
      "column_from_right": 7,
      "reading": "固請皇后與帝同席坐流涕覆面謂坦之曰楊",
      "start_codepoint": 343,
      "end_codepoint": 361
    },
    {
      "pdf_page": 22,
      "half": "左",
      "leaf": "二十上",
      "column_from_right": 8,
      "reading": "郎好年少無罪過何可枉殺坦之耳語於帝曰",
      "start_codepoint": 361,
      "end_codepoint": 379
    },
    {
      "pdf_page": 22,
      "half": "左",
      "leaf": "二十上",
      "column_from_right": 9,
      "reading": "此事別有一意不可令人聞帝謂皇后為阿奴",
      "start_codepoint": 379,
      "end_codepoint": 397
    },
    {
      "pdf_page": 23,
      "half": "右",
      "leaf": "二十下",
      "column_from_right": 1,
      "reading": "曰阿奴蹔去坦之乃曰外間並云楊珉之與皇",
      "start_codepoint": 397,
      "end_codepoint": 415
    },
    {
      "pdf_page": 23,
      "half": "右",
      "leaf": "二十下",
      "column_from_right": 2,
      "reading": "后有異情彰聞遐邇帝不得已乃為敕坦之馳",
      "start_codepoint": 415,
      "end_codepoint": 433
    },
    {
      "pdf_page": 23,
      "half": "右",
      "leaf": "二十下",
      "column_from_right": 3,
      "reading": "報明帝即令建康行刑而果有赦原之而珉之",
      "start_codepoint": 433,
      "end_codepoint": 451
    },
    {
      "pdf_page": 23,
      "half": "右",
      "leaf": "二十下",
      "column_from_right": 4,
      "reading": "已死后既淫亂又與帝相愛褻故帝恣之又迎",
      "start_codepoint": 451,
      "end_codepoint": 469
    },
    {
      "pdf_page": 23,
      "half": "右",
      "leaf": "二十下",
      "column_from_right": 5,
      "reading": "后親戚入宮嘗賜人百數十萬以武帝曜靈殿",
      "start_codepoint": 469,
      "end_codepoint": 487
    },
    {
      "pdf_page": 23,
      "half": "右",
      "leaf": "二十下",
      "column_from_right": 6,
      "reading": "處后家屬帝廢后貶為王妃父戢自有傳",
      "start_codepoint": 487,
      "end_codepoint": 503
    }
  ],
