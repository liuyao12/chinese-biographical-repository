    "pages": [
      {
        "page": 14,
        "leaf": "十二上",
        "quote": "奕字無奕／我方外司馬／一兵帥共飲"
      },
      {
        "page": 15,
        "leaf": "十二下",
        "quote": "未幾卒官贈鎮西將軍三子泉靖玄／泉有名譽歷義興太守靖官至太常",
        "fixed_reading": "泉早有名譽"
      },
      {
        "page": 23,
        "leaf": "二十下至二十一上",
        "quote": "石字石奴／進位開府儀同三司加鼓吹未拜卒時年六十二"
      },
      {
        "page": 24,
        "leaf": "二十一下至二十二上",
        "quote": "語在弘之傳／單諡曰襄／宋受禪國除／邈字茂度／並害邈兄弟竟至滅門",
        "fixed_reading": "直以宰相弟兼有大才",
        "print_reading": "直以宰相弟兼有大勳"
      }
    ]
  },
  "item_readings": [
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xieyi-p001",
        "start": 15,
        "end": 27,
        "quote": "有老人犯法，奕以醇酒飲之"
      },
      "reading": "犯法者為不具名老人，奕為剡令。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xieyi-p001",
        "start": 33,
        "end": 49,
        "quote": "安時年七八歲，在奕膝邊，諫止之。"
      },
      "reading": "七八歲為謝安報齡範圍，諫止可攝飲老人之事。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xieyi-p001",
        "start": 62,
        "end": 69,
        "quote": "溫辟為安西司馬"
      },
      "reading": "桓溫辟奕，後稱方外司馬及狂司馬皆據同一拘禮故事。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xieyi-p001",
        "start": 132,
        "end": 145,
        "quote": "君若無狂司馬，我何由得相見"
      },
      "reading": "君是桓溫，我是南康主；桓溫本傳明載婚配。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xieyi-p001",
        "start": 166,
        "end": 175,
        "quote": "失一老兵，得一老兵"
      },
      "reading": "前語戲指遁去的桓溫，後語指被拉來共飲的無名兵帥。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xieyi-p001",
        "start": 187,
        "end": 196,
        "quote": "從兄尚有德政，既卒"
      },
      "reading": "尚為奕從兄，已故。嗣尚事承接其政事。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xieyi-p001",
        "start": 244,
        "end": 256,
        "quote": "未幾。卒官，贈鎮西將軍。"
      },
      "reading": "奕卒於官，鎮西將軍是追贈。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xieyi-p002",
        "start": 0,
        "end": 8,
        "quote": "三子：泉、靖、玄"
      },
      "reading": "這一傳列三子，非奕全部子女名錄。另有奕女道韞本傳。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xieyi-p002",
        "start": 9,
        "end": 27,
        "quote": "泉早有名譽，曆義興太守。靖官至太常。"
      },
      "reading": "義興太守屬泉，太常屬靖；吳士鑑對泉川淵的說法另存。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xieshi-p001",
        "start": 30,
        "end": 40,
        "quote": "淮肥之役，詔石解僕射"
      },
      "reading": "解僕射是卸任尚書僕射。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xieshi-p001",
        "start": 52,
        "end": 62,
        "quote": "與兄子玄、琰破苻堅。"
      },
      "reading": "玄、琰是石之兄子，各有其父，不能因並列視為同父。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xieshi-p001",
        "start": 70,
        "end": 77,
        "quote": "誰謂爾堅石打碎"
      },
      "reading": "童謠的堅、石有當事人雙關，與直書姓名分層。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xieshi-p001",
        "start": 106,
        "end": 121,
        "quote": "而成于玄、琰，然石時實為都督焉"
      },
      "reading": "原文稱功始牢之、成于玄琰，謝石其時為都督。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xieshi-p001",
        "start": 155,
        "end": 159,
        "quote": "以訓胄子"
      },
      "reading": "學校對象為胄子群體。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xieshi-p002",
        "start": 16,
        "end": 29,
        "quote": "以公事與吏部郎王恭互相短長"
      },
      "reading": "王恭與謝石相互爭議，恭自陳求還。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xieshi-p002",
        "start": 60,
        "end": 72,
        "quote": "有司奏，石輒去職，免官。"
      },
      "reading": "有司奏免，皇帝命還，兩事分記。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xieshi-p002",
        "start": 108,
        "end": 119,
        "quote": "石乞依故尚書令王彪之例"
      },
      "reading": "王彪之是援引前例，獲准於府綜攝者是石。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xieshi-p002",
        "start": 129,
        "end": 156,
        "quote": "疾篤，進位開府儀同三司，加鼓吹，未拜，卒，時年六十二。"
      },
      "reading": "生前進位、未拜、死亡與後贈分項；六十二是當時報齡。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xieshi-p003",
        "start": 38,
        "end": 41,
        "quote": "謝白面"
      },
      "reading": "面瘡痊癒而白的別稱。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xieshi-p003",
        "start": 93,
        "end": 121,
        "quote": "博士范弘之議諡曰襄墨公，語在弘之傳。朝議不從，單諡曰襄。"
      },
      "reading": "范弘之提議襄墨公，朝議未從，實諡襄；本傳明引弘之傳。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xieshi-p004",
        "start": 0,
        "end": 7,
        "quote": "子汪嗣，早卒。"
      },
      "reading": "汪是石子，嗣爵而早卒。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xieshi-p004",
        "start": 7,
        "end": 23,
        "quote": "汪從兄沖以子明慧嗣，為孫恩所害。"
      },
      "reading": "沖為汪從兄，明慧為沖親子，繼汪；遇害者是明慧。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xieshi-p004",
        "start": 23,
        "end": 41,
        "quote": "明慧從兄喻復以子暠嗣。宋受禪，國除。"
      },
      "reading": "喻為明慧從兄，暠為喻親子，繼前嗣；宋受禪時國除。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xiemiao-p001",
        "start": 5,
        "end": 12,
        "quote": "父鐵，永嘉太守"
      },
      "reading": "鐵為邈父、任永嘉太守。篇題只稱從子，不能給兩人補以謝石為父。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xiemiao-p001",
        "start": 55,
        "end": 72,
        "quote": "邈輒焚毀之，其他侍臣被詔者或宣揚之"
      },
      "reading": "所毀所宣為孝武帝文詔，兩之均非人名。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xiemiao-p001",
        "start": 93,
        "end": 107,
        "quote": "為賊胡桀、郜驃等所執，害之。"
      },
      "reading": "胡桀、郜驃等執邈，據孫恩亂事；不造全體名單。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xiemiao-p001",
        "start": 119,
        "end": 131,
        "quote": "我不得罪天子，何北面之有"
      },
      "reading": "邈自稱。我與當朝天子是不同角色；本傳較前孝武帝之後，此時安帝。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xiemiao-p001",
        "start": 137,
        "end": 149,
        "quote": "邈妻郗氏，甚妒。邈先娶妾"
      },
      "reading": "郗氏為妻，先娶的妾無姓名。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xiemiao-p001",
        "start": 170,
        "end": 181,
        "quote": "疑其門下生仇玄達為之作"
      },
      "reading": "作書是邈所疑，受託者、實際作者與妻寄絕書三層分開。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xiemiao-p001",
        "start": 196,
        "end": 207,
        "quote": "並害邈兄弟，竟至滅門。"
      },
      "reading": "敘事歸因與篇末結果，兄弟無名、數量不明。"
    }
  ],
  "principal_passages": [
