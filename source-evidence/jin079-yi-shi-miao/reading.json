    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xieyi-p002",
        "start": 0,
        "end": 8,
        "quote": "三子：泉、靖、玄"
      },
      "parallel": [
        {
          "witness": "j096",
          "raw_start": 4260,
          "raw_end": 4280,
          "quote": "王凝之妻謝氏，字道韞，安西將軍奕之女也。",
          "raw_line": 71,
          "source_layer": "傳世正文"
        },
        {
          "witness": "j096",
          "raw_start": 4472,
          "raw_end": 4498,
          "quote": "封謂謝韶，胡謂謝朗，羯謂謝玄，末謂謝川，皆其小字也。",
          "raw_line": 73,
          "source_layer": "傳世正文"
        },
        {
          "witness": "zhu",
          "raw_start": 508,
          "raw_end": 540,
          "quote": "案《謝奕傳》下『淵』避諱改『泉』，此又改作『川』，乃史臣失檢處。",
          "raw_line": 2,
          "source_layer": "吳士鑑案語"
        }
      ],
      "reading": "卷九十六明載不用三子數排除其女；泉川淵問題按證本分置。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xieshi-p003",
        "start": 105,
        "end": 110,
        "quote": "語在弘之傳"
      },
      "existing_cross_reference": "xref-jin079-xieshi-fanhongzhi",
      "parallel": [
        {
          "witness": "j091",
          "raw_start": 8184,
          "raw_end": 8201,
          "quote": "范弘之，字長文，安北將軍汪之孫也。",
          "raw_line": 99,
          "source_layer": "傳世正文"
        },
        {
          "witness": "j091",
          "raw_start": 8224,
          "raw_end": 8245,
          "quote": "時衛將軍謝石薨，請諡，下禮官議。弘之議曰：",
          "raw_line": 99,
          "source_layer": "傳世正文"
        },
        {
          "witness": "j091",
          "raw_start": 8697,
          "raw_end": 8726,
          "quote": "案諡法，因事有功曰「襄」，貪以敗官曰「墨」，宜諡曰襄墨公。",
          "raw_line": 105,
          "source_layer": "傳世正文"
        }
      ],
      "reading": "范汪是弘之祖，與石子謝汪分人。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xiemiao-p001",
        "start": 88,
        "end": 92,
        "quote": "孫恩之亂"
      },
      "parallel": [
        {
          "witness": "j010",
          "raw_start": 2004,
          "raw_end": 2025,
          "quote": "十一月甲寅，妖賊孫恩陷會稽，內史王凝之死之",
          "raw_line": 62,
          "source_layer": "傳世正文"
        },
        {
          "witness": "j010",
          "raw_start": 2089,
          "raw_end": 2106,
          "quote": "吳興太守謝邈、永嘉太守司馬逸皆遇害",
          "raw_line": 62,
          "source_layer": "傳世正文"
        },
        {
          "witness": "j010",
          "raw_start": 2111,
          "raw_end": 2164,
          "quote": "司馬逸　商榷：孫恩傳作「謝逸」。考異：[[南史]]孝義傳作「司馬逸之」。按：宋書張進之傳亦作「司馬逸之」。",
          "raw_line": 62,
          "source_layer": "校者注"
        }
      ],
      "reading": "紀文並載司馬逸，校記另有謝逸等讀法，不能據此給邈的未具名兄弟發名。"
    }
