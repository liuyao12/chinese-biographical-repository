  "source_clauses": [
    {
      "witness": "w60",
      "quote": "子達及弟景皆有令名",
      "raw_start": 2269,
      "raw_end": 2278,
      "raw_line": 29
    },
    {
      "witness": "w60",
      "quote": "吴书曰：琮长子绪，幼知名，奉朝请，出授兵，稍迁扬武将军、牛渚督。",
      "raw_start": 3789,
      "raw_end": 3821,
      "raw_line": 42
    },
    {
      "witness": "w60",
      "quote": "小子吴，孙权外孙",
      "raw_start": 3878,
      "raw_end": 3886,
      "raw_line": 42
    },
    {
      "witness": "w60",
      "quote": "兄骃，上计吏",
      "raw_start": 8801,
      "raw_end": 8807,
      "raw_line": 93
    },
    {
      "witness": "w60",
      "quote": "漢魯相意七世孫也",
      "raw_start": 8773,
      "raw_end": 8781,
      "raw_line": 93
    },
    {
      "witness": "w60",
      "quote": "子褘嗣，代領兵",
      "raw_start": 10660,
      "raw_end": 10667,
      "raw_line": 99
    },
    {
      "witness": "w60",
      "quote": "張承與岱書曰",
      "raw_start": 5270,
      "raw_end": 5276,
      "raw_line": 59
    },
    {
      "witness": "w60",
      "quote": "乞遣親人賫箋七條以誘休",
      "raw_start": 5958,
      "raw_end": 5969,
      "raw_line": 68
    },
    {
      "witness": "w60",
      "quote": "魴因別為密表曰",
      "raw_start": 7822,
      "raw_end": 7829,
      "raw_line": 84
    },
    {
      "witness": "w65",
      "quote": "邵，賀齊之孫，景之子。",
      "raw_start": 1660,
      "raw_end": 1671,
      "raw_line": 27
    },
    {
      "witness": "j68",
      "quote": "曾祖齊，仕吳為名將。祖景，滅賊校尉。父邵，中書令，為孫皓所殺，徙家屬邊郡。循少嬰家難，流放海隅，吳平，乃還本郡。",
      "raw_start": 7540,
      "raw_end": 7596,
      "raw_line": 75
    },
    {
      "witness": "j58",
      "quote": "周處，字子隱，義興陽羨人也。父魴，呉鄱陽太守。",
      "raw_start": 230,
      "raw_end": 253,
      "raw_line": 12
    },
    {
      "witness": "j58",
      "quote": "仕呉爲東觀左丞。孫皓末，爲無難督。",
      "raw_start": 591,
      "raw_end": 608,
      "raw_line": 12
    },
    {
      "witness": "w50",
      "quote": "長曰魯班，字大虎，前配周瑜子循，後配全琮",
      "raw_start": 1907,
      "raw_end": 1927,
      "raw_line": 31
    },
    {
      "witness": "w57",
      "quote": "王靖內不憂時，外不趨事",
      "raw_start": 11053,
      "raw_end": 11064,
      "raw_line": 55
    },
    {
      "witness": "w51",
      "quote": "孫靜字幼臺，堅季弟也。",
      "raw_start": 209,
      "raw_end": 220,
      "raw_line": 11
    },
    {
      "witness": "w51",
      "quote": "孫奐字季明。兄皎既卒，代統其眾",
      "raw_start": 1941,
      "raw_end": 1956,
      "raw_line": 27
    }
  ],
