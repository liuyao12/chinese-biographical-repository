      "quote": "{{ProperNoun|訥之}}字{{ProperNoun|永言}}",
      "sha256": "2b55ad5756a2642308046aa7a34ebb4230814688ddfb09efd4d82b2d65200695",
      "interpretation": "世說文學劉注引王氏譜。"
    },
    {
      "paragraph_id": "c-songshu-060-wangzhunzhi:p001",
      "start": 31,
      "end": 34,
      "surface": "祖臨之",
      "path": "source-evidence/jin079-lang-zhong-xuan-dai/external/shishuo-wenxue-ws2567461.wikitext",
      "revision_id": 2567461,
      "line": 64,
      "first_codepoint": 441,
      "end_codepoint": 479,
      "quote": "父{{ProperNoun|臨之}}，{{ProperNoun|東陽}}太守",
      "sha256": "2b55ad5756a2642308046aa7a34ebb4230814688ddfb09efd4d82b2d65200695",
      "interpretation": "譜明載訥之父臨之。"
    },
    {
      "paragraph_id": "c-songshu-060-wangzhunzhi:p001",
      "start": 4,
      "end": 6,
      "surface": "元曾",
      "path": "source-evidence/song060-wang/external/ws1518081.wikitext",
      "revision_id": 1518081,
      "line": 8,
      "first_codepoint": 2,
      "end_codepoint": 14,
      "quote": "宋王淮之字元曾，瑯琊人也",
      "sha256": "3aae58553f54182150b7a5f71ad90d3c4360bb7a621afb68c2c91796b68e58f1",
      "interpretation": "太平廣記九九引《冥祥記》，名淮之，字元曾。"
    },
    {
      "paragraph_id": "c-songshu-060-wangzhunzhi:p004",
      "start": 169,
      "end": 171,
      "surface": "十年",
      "path": "source-evidence/song060-wang/external/ws1518081.wikitext",
      "revision_id": 1518081,
      "line": 8,
      "first_codepoint": 38,
      "end_codepoint": 54,
      "quote": "元嘉中，為丹陽令。十年，得病絕氣",
      "sha256": "3aae58553f54182150b7a5f71ad90d3c4360bb7a621afb68c2c91796b68e58f1",
      "interpretation": "同記元嘉十年，職名直作丹陽令，宋傳作丹陽尹。"
    },
    {
      "paragraph_id": "c-songshu-060-wangzhunzhi:p003",
      "start": 11,
      "end": 15,
      "surface": "永初二年",
