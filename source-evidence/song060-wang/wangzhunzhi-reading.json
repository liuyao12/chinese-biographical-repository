{
  "type": "complete_fixed_biography_review",
  "title": "王准之傳及子興之",
  "revision": 1996694,
  "raw_path": "sources/songshu/songshu060-ws1996694.wikitext",
  "raw_sha256": "a9b03405240b25c24c2fa2b999e921483d7c1d78a3ed6f1eb1807a289bf02a97",
  "sentences": [
    {
      "source_line": 73,
      "paragraph_id": "c-songshu-060-wangzhunzhi:p001",
      "start": 0,
      "end": 13,
      "text": "王准之字元曾，琅邪臨沂人。",
      "interpretation": "記錄所稱准之、字元曾及郡縣籍。"
    },
    {
      "source_line": 73,
      "paragraph_id": "c-songshu-060-wangzhunzhi:p001",
      "start": 13,
      "end": 22,
      "text": "高祖彬，尚書僕射。",
      "interpretation": "高祖彬為尚書僕射。"
    },
    {
      "source_line": 73,
      "paragraph_id": "c-songshu-060-wangzhunzhi:p001",
      "start": 22,
      "end": 31,
      "text": "曾祖彪之，尚書令。",
      "interpretation": "曾祖彪之為尚書令。"
    },
    {
      "source_line": 73,
      "paragraph_id": "c-songshu-060-wangzhunzhi:p001",
      "start": 31,
      "end": 45,
      "text": "祖臨之，父訥之，並御史中丞。",
      "interpretation": "祖父臨之及父訥之都任御史中丞。"
    },
    {
      "source_line": 73,
      "paragraph_id": "c-songshu-060-wangzhunzhi:p001",
      "start": 45,
      "end": 88,
      "text": "彪之博聞多識，練悉朝儀，自是家世相傳，並諳江左舊事，緘之青箱，世人謂之「王氏青箱學」。",
      "interpretation": "彪之以朝廷儀節知名，家相傳而藏之青箱，世稱王氏青箱學。"
    },
    {
      "source_line": 75,
      "paragraph_id": "c-songshu-060-wangzhunzhi:p002",
      "start": 0,
      "end": 12,
      "text": "准之兼明禮傳，贍於文辭。",
      "interpretation": "通禮傳、能文章。"
    },
    {
      "source_line": 75,
      "paragraph_id": "c-songshu-060-wangzhunzhi:p002",
      "start": 12,
      "end": 30,
      "text": "起家為本國右常侍，桓玄大將軍行參軍。",
      "interpretation": "從本國右常侍起家，入桓玄府。"
    },
    {
      "source_line": 75,
      "paragraph_id": "c-songshu-060-wangzhunzhi:p002",
      "start": 30,
      "end": 42,
      "text": "玄篡位，以為尚書祠部郎。",
      "interpretation": "桓玄篡位，授祠部郎。"
    },
    {
      "source_line": 75,
      "paragraph_id": "c-songshu-060-wangzhunzhi:p002",
      "start": 42,
      "end": 86,
      "text": "義熙初，又為尚書中兵郎，遷參高祖車騎中軍軍事，丹陽丞，中軍太尉主簿，出為山陰令，有能名。",
      "interpretation": "義熙初至任山陰令一連串遷任。"
    },
    {
      "source_line": 75,
      "paragraph_id": "c-songshu-060-wangzhunzhi:p002",
      "start": 86,
      "end": 97,
      "text": "預討盧循功，封都亭侯。",
      "interpretation": "以討盧循功封都亭侯。"
    },
    {
      "source_line": 75,
      "paragraph_id": "c-songshu-060-wangzhunzhi:p002",
      "start": 97,
      "end": 123,
      "text": "又為高祖鎮西、平北、太尉參軍，尚書左丞，本郡大中正。",
      "interpretation": "歷高祖三府參軍及尚書左丞、本郡大中正。"
    },
    {
      "source_line": 75,
      "paragraph_id": "c-songshu-060-wangzhunzhi:p002",
      "start": 123,
      "end": 139,
      "text": "宋臺建，除御史中丞，為僚友所憚。",
      "interpretation": "建宋臺後任御史中丞，僚友憚之。"
    },
    {
      "source_line": 75,
      "paragraph_id": "c-songshu-060-wangzhunzhi:p002",
      "start": 139,
      "end": 163,
      "text": "准之父訥之、祖臨之、曾祖彪之至准之，四世居此職。",
      "interpretation": "彪之至准之四代都任御史中丞。"
    },
    {
      "source_line": 75,
      "paragraph_id": "c-songshu-060-wangzhunzhi:p002",
      "start": 163,
      "end": 185,
      "text": "准之嘗作五言，范泰謿之曰：「卿唯解彈事耳。」",
      "interpretation": "范泰以准之只知彈事戲其五言。"
    },
    {
      "source_line": 75,
      "paragraph_id": "c-songshu-060-wangzhunzhi:p002",
      "start": 185,
      "end": 201,
      "text": "准之正色答：「猶差卿世載雄狐。」",
      "interpretation": "准之引雄狐反譏范泰，兩個卿各有對象。"
    },
    {
      "source_line": 75,
      "paragraph_id": "c-songshu-060-wangzhunzhi:p002",
      "start": 201,
      "end": 217,
      "text": "坐世子右衞率謝靈運殺人不舉免官。",
      "interpretation": "謝靈運殺人，准之沒有彈劾而免官；他傳具名受害者，衞率左右有異。"
    },
    {
      "source_line": 77,
      "paragraph_id": "c-songshu-060-wangzhunzhi:p003",
      "start": 0,
      "end": 11,
      "text": "高祖受命，拜黃門侍郎。",
      "interpretation": "高祖受命後拜黃門侍郎。"
    },
    {
      "source_line": 77,
      "paragraph_id": "c-songshu-060-wangzhunzhi:p003",
      "start": 11,
      "end": 48,
      "text": "永初二年，奏曰：「鄭玄注禮，三年之喪，二十七月而吉，古今學者多謂得禮之宜。",
      "interpretation": "本傳紀永初二年，奏中陳鄭玄二十七月除喪說。"
    },
    {
      "source_line": 77,
      "paragraph_id": "c-songshu-060-wangzhunzhi:p003",
      "start": 48,
      "end": 73,
      "text": "晉初用王肅議，祥禫共月，故二十五月而除，遂以為制。",
      "interpretation": "晉初王肅議同月祥、禫，本傳計二十五月。"
    },
    {
      "source_line": 77,
      "paragraph_id": "c-songshu-060-wangzhunzhi:p003",
      "start": 73,
      "end": 94,
      "text": "江左以來，唯晉朝施用；縉紳之士，多遵玄義。",
      "interpretation": "過江後朝廷、士人所循的制度有別。"
    },
    {
      "source_line": 77,
      "paragraph_id": "c-songshu-060-wangzhunzhi:p003",
      "start": 94,
      "end": 106,
      "text": "夫先王制禮，以大順羣心。",
      "interpretation": "援引先王制禮意旨。"
    },
    {
      "source_line": 77,
      "paragraph_id": "c-songshu-060-wangzhunzhi:p003",
      "start": 106,
      "end": 116,
      "text": "喪也寧戚，著自前訓。",
      "interpretation": "引喪寧戚舊訓。"
    },
    {
      "source_line": 77,
      "paragraph_id": "c-songshu-060-wangzhunzhi:p003",
      "start": 116,
      "end": 127,
      "text": "今大宋開泰，品物遂理。",
      "interpretation": "以劉宋開國為制禮背景。"
    },
    {
      "source_line": 77,
      "paragraph_id": "c-songshu-060-wangzhunzhi:p003",
      "start": 127,
      "end": 153,
      "text": "愚謂宜同即物情，以玄義為制，朝野一禮，則家無殊俗。」",
      "interpretation": "王自請以鄭義一朝野。"
    },
    {
      "source_line": 77,
      "paragraph_id": "c-songshu-060-wangzhunzhi:p003",
      "start": 153,
      "end": 156,
      "text": "從之。",
      "interpretation": "議獲准。"
    },
    {
      "source_line": 79,
      "paragraph_id": "c-songshu-060-wangzhunzhi:p004",
      "start": 0,
      "end": 14,
      "text": "遷司徒左長史，出為始興太守。",
      "interpretation": "歷司徒左長史及始興太守。"
    },
    {
      "source_line": 79,
      "paragraph_id": "c-songshu-060-wangzhunzhi:p004",
      "start": 14,
      "end": 51,
      "text": "元嘉二年，為江夏王義恭撫軍長史、歷陽太守，行州府之任，綏懷得理，軍民便之。",
      "interpretation": "元嘉二年入江夏王府並守歷陽。"
    },
    {
      "source_line": 79,
      "paragraph_id": "c-songshu-060-wangzhunzhi:p004",
      "start": 51,
      "end": 57,
      "text": "尋入為侍中。",
      "interpretation": "入為侍中。"
    },
    {
      "source_line": 79,
      "paragraph_id": "c-songshu-060-wangzhunzhi:p004",
      "start": 57,
      "end": 72,
      "text": "明年，徙為都官尚書，改領吏部。",
      "interpretation": "元嘉三年徙都官尚書、領吏部。"
    },
    {
      "source_line": 79,
      "paragraph_id": "c-songshu-060-wangzhunzhi:p004",
      "start": 72,
      "end": 83,
      "text": "性峭急，頗失縉紳之望。",
      "interpretation": "性情峭急而失望於縉紳。"
    },
    {
      "source_line": 79,
      "paragraph_id": "c-songshu-060-wangzhunzhi:p004",
      "start": 83,
      "end": 89,
      "text": "出為丹陽尹。",
      "interpretation": "出任丹陽尹。"
    },
    {
      "source_line": 79,
      "paragraph_id": "c-songshu-060-wangzhunzhi:p004",
      "start": 89,
      "end": 144,
      "text": "准之究識舊儀，問無不對，時大將軍彭城王義康錄尚書事，每歎曰：「何須高論玄虛，正得如王准之兩三人，天下便治矣。」",
      "interpretation": "彭城王義康以得此人兩三可治天下稱許。"
    },
    {
      "source_line": 79,
      "paragraph_id": "c-songshu-060-wangzhunzhi:p004",
      "start": 144,
      "end": 157,
      "text": "然寡乏風素，不為時流所重。",
      "interpretation": "評其風素。"
    },
    {
      "source_line": 79,
      "paragraph_id": "c-songshu-060-wangzhunzhi:p004",
      "start": 157,
      "end": 169,
      "text": "撰儀注，朝廷至今遵用之。",
      "interpretation": "撰儀注，傳撰時尚沿用。"
    },
    {
      "source_line": 79,
      "paragraph_id": "c-songshu-060-wangzhunzhi:p004",
      "start": 169,
      "end": 180,
      "text": "十年，卒，時年五十六。",
      "interpretation": "元嘉十年卒，報齡五十六。"
    },
    {
      "source_line": 79,
      "paragraph_id": "c-songshu-060-wangzhunzhi:p004",
      "start": 180,
      "end": 185,
      "text": "追贈太常。",
      "interpretation": "追贈太常。"
    },
    {
      "source_line": 79,
      "paragraph_id": "c-songshu-060-wangzhunzhi:p004",
      "start": 185,
      "end": 194,
      "text": "子興之，征虜主簿。",
      "interpretation": "子興之任征虜主簿，南史作輿之。"
    }
  ],
