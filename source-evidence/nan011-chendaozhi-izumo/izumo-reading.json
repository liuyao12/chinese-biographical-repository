  "column_file": "source-evidence/nan011-chendaozhi-izumo/izumo-columns.txt",
  "column_file_sha256": "36587911978ee911739ffcd0b91ad573faacfbc217c26d48a78e4d14b1be2409",
  "columns": [
    {
      "pdf_page": 17,
      "half": "左",
      "leaf": "十五上",
      "column_from_right": 7,
      "reading": "齊宣孝陳皇后諱道止臨淮東陽人魏司徒矯",
      "start_codepoint": 0,
      "end_codepoint": 18
    },
    {
      "pdf_page": 17,
      "half": "左",
      "leaf": "十五上",
      "column_from_right": 8,
      "reading": "之後也后家貧少勤織作家人矜其勞或止之",
      "start_codepoint": 18,
      "end_codepoint": 36
    },
    {
      "pdf_page": 17,
      "half": "左",
      "leaf": "十五上",
      "column_from_right": 9,
      "reading": "后終不改嫁于宣帝宣帝庶生子衡陽元王道",
      "start_codepoint": 36,
      "end_codepoint": 54
    },
    {
      "pdf_page": 18,
      "half": "右",
      "leaf": "十五下",
      "column_from_right": 1,
      "reading": "度始安貞王道生后生高帝高帝年二歲乳人",
      "start_codepoint": 54,
      "end_codepoint": 72
    },
    {
      "pdf_page": 18,
      "half": "右",
      "leaf": "十五下",
      "column_from_right": 2,
      "reading": "乏乳后夢人以兩甌麻粥與之覺而乳驚因此",
      "start_codepoint": 72,
      "end_codepoint": 90
    },
    {
      "pdf_page": 18,
      "half": "右",
      "leaf": "十五下",
      "column_from_right": 3,
      "reading": "豐足宣帝從任在外后常留家有相者謂后曰",
      "start_codepoint": 90,
      "end_codepoint": 108
    },
    {
      "pdf_page": 18,
      "half": "右",
      "leaf": "十五下",
      "column_from_right": 4,
      "reading": "夫人有貴子而不見之后歎曰我三子誰當應",
      "start_codepoint": 108,
      "end_codepoint": 126
    },
    {
      "pdf_page": 18,
      "half": "右",
      "leaf": "十五下",
      "column_from_right": 5,
      "reading": "之呼高帝小字曰政應是汝耳宣帝殂後后親",
      "start_codepoint": 126,
      "end_codepoint": 144
    },
    {
      "pdf_page": 18,
      "half": "右",
      "leaf": "十五下",
      "column_from_right": 6,
      "reading": "執勤婢使有過皆恕而不問高帝雖從宦而家",
      "start_codepoint": 144,
      "end_codepoint": 162
    },
    {
      "pdf_page": 18,
      "half": "右",
      "leaf": "十五下",
      "column_from_right": 7,
      "reading": "業本貧為建康令時明帝等冬月猶無縑纊而",
      "start_codepoint": 162,
      "end_codepoint": 180
    },
    {
      "pdf_page": 18,
      "half": "右",
      "leaf": "十五下",
      "column_from_right": 8,
      "reading": "奉膳甚厚后每撤去兼肉曰於我過足矣殂于",
      "start_codepoint": 180,
      "end_codepoint": 198
    },
    {
      "pdf_page": 18,
      "half": "右",
      "leaf": "十五下",
      "column_from_right": 9,
      "reading": "縣舍昇明二年追贈竟陵公國太夫人齊國建",
      "start_codepoint": 198,
      "end_codepoint": 216
    },
    {
      "pdf_page": 18,
      "half": "左",
      "leaf": "十六上",
      "column_from_right": 1,
      "reading": "為齊國太妃竝蜜印畫青綬祠以太牢建元元",
      "start_codepoint": 216,
      "end_codepoint": 234
    },
    {
      "pdf_page": 18,
      "half": "左",
      "leaf": "十六上",
      "column_from_right": 2,
      "reading": "年追尊孝皇后贈外祖父肇之金紫光祿大夫",
      "start_codepoint": 234,
      "end_codepoint": 252
    },
    {
      "pdf_page": 18,
      "half": "左",
      "leaf": "十六上",
      "column_from_right": 3,
      "reading": "諡敬侯后母胡氏為永昌縣靖君永明九年詔",
      "start_codepoint": 252,
      "end_codepoint": 270
    },
    {
      "pdf_page": 18,
      "half": "左",
      "leaf": "十六上",
      "column_from_right": 4,
      "reading": "太廟四時祭宣皇帝薦起麵餅鴨𦞦孝皇后薦",
      "start_codepoint": 270,
      "end_codepoint": 288
    },
    {
      "pdf_page": 18,
      "half": "左",
      "leaf": "十六上",
      "column_from_right": 5,
      "reading": "笋鴨卵脯醬炙白肉高皇帝薦肉膾葅羮昭皇",
      "start_codepoint": 288,
      "end_codepoint": 306
    },
    {
      "pdf_page": 18,
      "half": "左",
      "leaf": "十六上",
      "column_from_right": 6,
      "reading": "后薦茗粣炙魚並生平所嗜也",
      "start_codepoint": 306,
      "end_codepoint": 318
    }
  ],
