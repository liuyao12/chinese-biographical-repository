  "comparisons": [
    {
      "anchor": {
        "paragraph_id": "c-jinshu-043-guoshu:line129",
        "start": 134,
        "end": 144,
        "surface": "舒率將士推弘子璠為主"
      },
      "reading": "此傳以郭舒為敘事主語，劉弘傳明載劉璠率府兵、斬郭勱。取劉璠父子及郭勱職為對證。",
      "sources": [
        {
          "witness": "j66",
          "quote": "及弘卒，弘司馬郭勱欲推穎為主，弘子璠追遵弘志，於是墨絰率府兵計勱，戰于濁水，斬之，襄沔肅清",
          "raw_start": 2541,
          "raw_end": 2586,
          "raw_line": 24
        },
        {
          "witness": "j66",
          "quote": "劉弘，字和季，沛國相人也。",
          "raw_start": 161,
          "raw_end": 174,
          "raw_line": 10
        }
      ]
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-043-guoshu:line129",
        "start": 31,
        "end": 39,
        "surface": "宗人武陵太守郭景"
      },
      "reading": "郭景為郭舒宗人，未言近親親等。",
      "sources": []
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-043-guoshu:line131",
        "start": 82,
        "end": 90,
        "surface": "宗庾廞嘗因酒忤澄"
      },
      "reading": "固定數位正文作宗庾廞，武英殿二十下右起第二欄明作宗廞，後兩稱廞。同一酒忤王澄獲免者，留兩寫。",
      "sources": []
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-043-guoshu:line131",
        "start": 140,
        "end": 148,
        "surface": "掐其鼻，灸其眉頭"
      },
      "reading": "郭舒為廞進諫蒙罰；末段王敦以舊事譏舒，平子是王澄。",
      "sources": []
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-043-guoshu:line137",
        "start": 79,
        "end": 90,
        "surface": "王暠。暠疑舒與甘卓同謀"
      },
      "reading": "武英殿二十一上右起第四欄「數譖之於王廙廙疑舒與」，固定本王暠。周訪傳另見王廙去荊州及王敦從事中郎郭舒。",
      "sources": [
        {
          "witness": "zhou",
          "quote": "至王廙去職，詔以訪爲荊州。",
          "raw_start": 7187,
          "raw_end": 7200,
          "raw_line": 76
        },
        {
          "witness": "zhou",
          "quote": "其從事中郎郭舒説敦曰：「鄙州雖遇寇難荒弊，實爲用武之國，若以假人，將有尾大之患，公宜自領，訪爲梁州足矣。」敦從之，訪大怒。",
          "raw_start": 7215,
          "raw_end": 7276,
          "raw_line": 76
        }
      ]
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-043-guoshu:line137",
        "start": 227,
        "end": 235,
        "surface": "周昌、汲黯、硃雲"
      },
      "reading": "郭舒舉三位直諫者為例。朱雲傳正字作朱雲，字游，因諫爭攀檻。",
      "sources": [
        {
          "witness": "han",
          "quote": "朱雲字游，魯人也，徙平陵。",
          "raw_start": 2719,
          "raw_end": 2732,
          "raw_line": 24
        },
        {
          "witness": "han",
          "quote": "雲攀殿檻，檻折。",
          "raw_start": 4301,
          "raw_end": 4309,
          "raw_line": 32
        }
      ]
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-043-guoshu:line137",
        "start": 327,
        "end": 341,
        "surface": "君曰其可，臣獻其否，以成其可"
      },
      "reading": "郭舒引晏子語，左傳昭公二十年作「君所謂可，而有否焉」。",
      "sources": [
        {
          "witness": "zuo",
          "quote": "君所謂可．而有否焉．臣獻其否．以成其可．",
          "raw_start": 41452,
          "raw_end": 41472,
          "raw_line": 596
        }
      ]
    }
  ],
