  "section_reviews": [
    {
      "id": "c-sanguozhi-063-liudun:line030:reading-000-076",
      "kind": "received_sentence",
      "paragraph_id": "c-sanguozhi-063-liudun:line030",
      "start_codepoint": 0,
      "end_codepoint": 76,
      "source_quote": "劉惇字子仁，平原人也。遭亂避地，客游廬陵，事孫輔。以明天官達占數顯於南土。每有水旱寇賊，皆先時處期，無不中者。輔異焉，以爲軍師，軍中咸敬事之，號曰神明。",
      "person_id": "7ko_vou_bwp",
      "related_person_ids": [
        "e8h_aeo_zy8"
      ],
      "reading": "平原人避地廬陵，所事是孫權從兄孫輔；神明為兵中人所號。"
    },
    {
      "id": "c-sanguozhi-063-liudun:line032:reading-000-065",
      "kind": "received_sentence",
      "paragraph_id": "c-sanguozhi-063-liudun:line032",
      "start_codepoint": 0,
      "end_codepoint": 65,
      "source_quote": "建安中，孫權在豫章，時有星變，以問惇，惇曰：「災在丹楊。」權曰：「何如？」曰：「客勝主人，到某日當得問。」是時邊鴻作亂，卒如惇言。",
      "person_id": "7ko_vou_bwp",
      "related_person_ids": [
        "572_278_cba",
        "rit_tr5_qrv"
      ],
      "reading": "建安中丹楊亂，記邊鴻；參卷51孫翊傳原號。"
    },
    {
      "id": "c-sanguozhi-063-liudun:line034:reading-000-059",
      "kind": "received_sentence",
      "paragraph_id": "c-sanguozhi-063-liudun:line034",
      "start_codepoint": 0,
      "end_codepoint": 59,
      "source_quote": "惇於諸術皆善，尤明太乙，皆能推演其事，窮盡要妙，著書百餘篇，名儒刁玄稱以爲奇。惇亦寶愛其術，不以告人，故世莫得而明也。",
      "person_id": "7ko_vou_bwp",
      "related_person_ids": [
        "s7m_pgz_fux"
      ],
      "reading": "明太乙且著書百餘篇；刁玄稱奇。"
    }
  ],
