  "readings": [
    {
      "id": "c-sanguozhi-065-weiyiao-complete:source_review1-0",
      "kind": "source_review",
      "person_id": "4qw_13i_jn6",
      "source_quote": "　　韋曜字弘嗣，吳郡雲陽人也。少好學，能屬文，從丞相掾除西安令，還為尚書郎，遷太子中庶子。時蔡穎亦在東宮，性好博奕。太子和以為無益，命曜論之。其辭曰：",
      "reading": "韋曜字弘嗣，吳郡雲陽人。丞相掾後任西安令、尚書郎、太子中庶子。太子孫和命其就蔡穎好博弈一事著論。",
      "note": "韋曜字弘嗣，吳郡雲陽人。丞相掾後任西安令、尚書郎、太子中庶子。太子孫和命其就蔡穎好博弈一事著論。",
      "paragraph_id": "c-sanguozhi-065-weiyiao-complete:p001",
      "start_codepoint": 0,
      "end_codepoint": 75,
      "human_reviewed": false
    },
    {
      "id": "c-sanguozhi-065-weiyiao-complete:source_review2-0",
      "kind": "source_review",
      "person_id": "4qw_13i_jn6",
      "source_quote": "裴松之曰：曜本名昭，史爲晉諱，改之。",
      "reading": "裴松之說本名昭，史為晉諱改曜。數位標題以作者韋昭連線，顯示作韋曜；兩字各有來源。",
      "note": "裴松之說本名昭，史為晉諱改曜。數位標題以作者韋昭連線，顯示作韋曜；兩字各有來源。",
      "paragraph_id": "c-sanguozhi-065-weiyiao-complete:p002",
