  "pdf_sha1": "5eccfd47366f90959b1568cb6b4d78348513542e",
  "pdf_sha256": "e9732568ce9c59568484ec30b7f0127fb1a6c450e6f97624139991d08e1b9910",
  "book_id": "NLC892-411999000037-306500",
  "column_order": "一上第五欄至三上第三欄，自右至左。",
  "columns": [
    {
      "pdf_page": 44,
      "half": "左",
      "leaf": "一上",
      "column_from_right": 5,
      "text": "沈君理字仲倫吳興人也祖僧畟梁左民尚書父巡素"
    },
    {
      "pdf_page": 44,
      "half": "左",
      "leaf": "一上",
      "column_from_right": 6,
      "text": "與高祖相善梁太清中為東陽太守侯景平後元帝徵"
    },
    {
      "pdf_page": 44,
      "half": "左",
      "leaf": "一上",
      "column_from_right": 7,
      "text": "為少府卿荊州陷蕭詧署金紫光祿大夫君理美風儀"
    },
    {
      "pdf_page": 44,
      "half": "左",
      "leaf": "一上",
      "column_from_right": 8,
      "text": "博涉經史有識鑒起家湘東王法曹參軍高祖鎮南徐"
    },
    {
      "pdf_page": 44,
      "half": "左",
      "leaf": "一上",
      "column_from_right": 9,
      "text": "州巡遣君理自東陽謁于高祖高祖器之命尚會稽長"
    },
    {
      "pdf_page": 44,
      "half": "左",
      "leaf": "一上",
      "column_from_right": 10,
      "text": "公主辟為府西曹掾稍遷中衛豫章王從事中郎尋加"
    },
    {
      "pdf_page": 45,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 1,
      "text": "明威將軍兼尚書吏部侍郎遷給事黃門侍郎監吳郡"
    },
    {
      "pdf_page": 45,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 2,
      "text": "高祖受禪拜駙馬都尉封永安亭侯出為吳郡太守是"
    },
    {
      "pdf_page": 45,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 3,
      "text": "時兵革未寧百姓荒弊軍國之用咸資東境君理招集"
    },
    {
      "pdf_page": 45,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 4,
      "text": "士卒脩治器械民下悅附深以幹理見稱世祖嗣位徵"
    },
    {
      "pdf_page": 45,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 5,
      "text": "為侍中遷守左民尚書未拜為明威將軍丹陽尹天嘉"
    },
    {
      "pdf_page": 45,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 6,
      "text": "三年重授左民尚書領步兵校尉尋改前軍將軍四年"
    },
    {
      "pdf_page": 45,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 7,
      "text": "侯安都徙鎮江州以本官監南徐州六年出為仁威將"
    },
    {
      "pdf_page": 45,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 8,
      "text": "軍東陽太守天康元年以父憂去職君理因自請往荊"
    },
    {
      "pdf_page": 45,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 9,
      "text": "州迎喪柩朝議以在位重臣難令出境乃令長兄君嚴"
    },
    {
      "pdf_page": 45,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 10,
      "text": "往焉及還將葬詔贈巡侍中領軍將軍諡曰敬子其年"
    },
    {
      "pdf_page": 45,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 1,
      "text": "起君理為信威將軍左衛將軍又起為持節都督東衡"
    },
    {
      "pdf_page": 45,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 2,
      "text": "衡二州諸軍事仁威將軍東衡州刺史領始興內史又"
    },
    {
      "pdf_page": 45,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 3,
      "text": "起為明威將軍中書令前後奪情者三並不就太建元"
    },
    {
      "pdf_page": 45,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 4,
      "text": "年服闋除太子詹事行東宮事遷吏部尚書二年高宗"
    },
    {
      "pdf_page": 45,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 5,
      "text": "以君理女為皇太子妃賜爵望蔡縣侯邑五百戶四年"
    },
    {
      "pdf_page": 45,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 6,
      "text": "加侍中五年遷尚書右僕射領吏部侍中如故其年有"
    },
    {
      "pdf_page": 45,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 7,
      "text": "疾輿駕親臨視九月卒時年四十九詔贈侍中太子少"
    },
    {
      "pdf_page": 45,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 8,
      "text": "傅喪事所須隨由資給重贈翊左將軍開府儀同三司"
    },
    {
      "pdf_page": 45,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 9,
      "text": "侍中如故諡曰貞憲君理子遵儉早卒以弟君高子遵"
    },
    {
      "pdf_page": 45,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 10,
      "text": "禮為嗣君理第五叔邁亦方正有幹局仕梁為尚書金"
    },
    {
      "pdf_page": 46,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 1,
      "text": "部郎永定中累遷中書侍郎天嘉中歷太僕廷尉出為"
    },
    {
      "pdf_page": 46,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 2,
      "text": "鎮東始興王長史會稽郡丞行東揚州事光大元年徐"
    },
    {
      "pdf_page": 46,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 3,
      "text": "尚書吏部郎太建元年遷為通直散騎常侍侍東宮二"
    },
    {
      "pdf_page": 46,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 4,
      "text": "年卒時年五十二贈散騎常侍君理第六弟君高字季"
    },
    {
      "pdf_page": 46,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 5,
      "text": "高少知名性剛直有吏能以家門外戚早居清顯歷太"
    },
    {
      "pdf_page": 46,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 6,
      "text": "子舍人洗馬中舍人高宗司空府從事中郎廷尉卿太"
    },
    {
      "pdf_page": 46,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 7,
      "text": "建元年東境大水百姓饑弊乃以君高為貞威將軍吳"
    },
    {
      "pdf_page": 46,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 8,
      "text": "令尋除太子中庶子尚書吏部郎衛尉卿出為宣遠將"
    },
    {
      "pdf_page": 46,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 9,
      "text": "軍平南長沙王長史南海太守行廣州事以女為王妃"
    },
    {
      "pdf_page": 46,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 10,
      "text": "固辭不行復為衛尉卿八年詔授持節都督交廣等十"
    },
    {
      "pdf_page": 46,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 1,
      "text": "八州諸軍事寧遠將軍平越中郎將廣州刺史嶺南俚"
    },
    {
      "pdf_page": 46,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 2,
      "text": "獠世相攻伐君高本文吏無武幹推心撫御甚得民和"
    },
    {
      "pdf_page": 46,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 3,
      "text": "十年卒于官時年四十七贈散騎常侍諡曰祁子"
    }
  ],
