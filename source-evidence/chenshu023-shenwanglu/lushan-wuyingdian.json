  "pdf_sha1": "5eccfd47366f90959b1568cb6b4d78348513542e",
  "pdf_sha256": "e9732568ce9c59568484ec30b7f0127fb1a6c450e6f97624139991d08e1b9910",
  "book_id": "NLC892-411999000037-306500",
  "column_order": "四上第十欄至五下第三欄，自右至左。",
  "columns": [
    {
      "pdf_page": 47,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 10,
      "text": "陸繕字士繻吳郡吳人也祖惠曉齊太常卿父任梁御"
    },
    {
      "pdf_page": 48,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 1,
      "text": "史中丞繕幼有志尚以雅正知名起家梁宣惠武陵王"
    },
    {
      "pdf_page": 48,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 2,
      "text": "法曹參軍承聖中授中書侍郎掌東宮管記江陵陷繕"
    },
    {
      "pdf_page": 48,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 3,
      "text": "微服遁還京師紹泰元年除司徒右長史御史中丞以"
    },
    {
      "pdf_page": 48,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 4,
      "text": "父任所終固辭不就高祖引繕為司徒司馬遷給事黃"
    },
    {
      "pdf_page": 48,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 5,
      "text": "門侍郎領步兵校尉通直散騎常侍兼侍中永定元年"
    },
    {
      "pdf_page": 48,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 6,
      "text": "遷侍中時留異擁割東陽新安人向文政與異連結因"
    },
    {
      "pdf_page": 48,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 7,
      "text": "據本郡朝廷以繕為貞威將軍新安太守世祖嗣位徵"
    },
    {
      "pdf_page": 48,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 8,
      "text": "為太子中庶子領步兵校尉掌東宮管記繕儀表端麗"
    },
    {
      "pdf_page": 48,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 9,
      "text": "進退閑雅世祖使太子諸王咸取則焉其趨步躡履皆"
    },
    {
      "pdf_page": 48,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 10,
      "text": "令習繕規矩除尚書吏部郎中步兵如故仍侍東宮陳"
    },
    {
      "pdf_page": 48,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 1,
      "text": "寶應平後出為貞毅將軍建安太守秩滿為散騎常侍"
    },
    {
      "pdf_page": 48,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 2,
      "text": "御史中丞猶以父之所終固辭不許乃權換廨宇徙居"
    },
    {
      "pdf_page": 48,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 3,
      "text": "之太建初遷度支尚書侍中太子詹事行東宮事領揚"
    },
    {
      "pdf_page": 48,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 4,
      "text": "州大中正及太子親蒞庶政解行事加散騎常侍改加"
    },
    {
      "pdf_page": 48,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 5,
      "text": "侍中遷尚書右僕射尋遷左僕射參掌選事侍中如故"
    },
    {
      "pdf_page": 48,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 6,
      "text": "更為尚書僕射領前將軍重授左僕射領揚州大中正"
    },
    {
      "pdf_page": 48,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 7,
      "text": "別勅令與徐陵等七人參議政事十二年卒時年六十"
    },
    {
      "pdf_page": 48,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 8,
      "text": "三贈侍中特進金紫光祿大夫諡曰安子太子以繕東"
    },
    {
      "pdf_page": 48,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 9,
      "text": "宮舊臣特賜祖奠繕子辯惠年數歲詔引入殿內辯惠"
    },
    {
      "pdf_page": 48,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 10,
      "text": "應對進止有父風高宗因賜名辯惠字敬仁云繕兄子"
    },
    {
      "pdf_page": 49,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 1,
      "text": "見賢亦方雅高宗為揚州牧乃以為治中從事史深被"
    },
    {
      "pdf_page": 49,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 2,
      "text": "知遇歷給事黃門侍郎長沙鄱陽二王長史帶尋陽太"
    },
    {
      "pdf_page": 49,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 3,
      "text": "守少府卿太建十年卒時年五十贈廷尉卿諡曰平子"
    }
  ],
