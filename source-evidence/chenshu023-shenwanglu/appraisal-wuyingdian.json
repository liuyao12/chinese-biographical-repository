      "source_heading": "陳書卷二十三考證",
      "columns": [
        {
          "column_from_right": 2,
          "text": "沈君理傳拜駙馬都尉封永安亭侯○亭監本誤定今"
        },
        {
          "column_from_right": 3,
          "text": "改從南史"
        },
        {
          "column_from_right": 4,
          "text": "陸繕傳陸繕字士繻○繻一本作儒"
        },
        {
          "column_from_right": 5,
          "text": "父任梁御史中丞○任一本作倕"
