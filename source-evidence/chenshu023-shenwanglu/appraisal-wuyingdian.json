    {
      "pdf_page": 49,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 5,
      "text": "正經曰容止可觀詩言其儀罔忒彼三子者其有斯風"
    },
    {
      "pdf_page": 49,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 6,
      "text": "焉"
    }
