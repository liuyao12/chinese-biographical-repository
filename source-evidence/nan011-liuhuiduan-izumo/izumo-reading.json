      "reading": "明敬劉皇后諱惠端彭城人光祿大夫道弘孫",
      "start_codepoint": 0,
      "end_codepoint": 18
    },
    {
      "pdf_page": 23,
      "half": "左",
      "leaf": "二十一上",
      "column_from_right": 3,
      "reading": "也高帝為明帝納之建元三年除西昌侯夫人",
      "start_codepoint": 18,
      "end_codepoint": 36
    },
    {
      "pdf_page": 23,
      "half": "左",
      "leaf": "二十一上",
      "column_from_right": 4,
      "reading": "永明七年卒葬江乘縣張山延興元年贈宣城",
      "start_codepoint": 36,
      "end_codepoint": 54
    },
    {
      "pdf_page": 23,
      "half": "左",
      "leaf": "二十一上",
      "column_from_right": 5,
      "reading": "王妃明帝即位追尊敬皇后贈父通直郎景猷",
      "start_codepoint": 54,
      "end_codepoint": 72
    },
    {
      "pdf_page": 23,
      "half": "左",
      "leaf": "二十一上",
      "column_from_right": 6,
      "reading": "為金紫光祿大夫母王氏平陽鄉君明帝崩改",
      "start_codepoint": 72,
      "end_codepoint": 90
    },
    {
      "pdf_page": 23,
      "half": "左",
      "leaf": "二十一上",
      "column_from_right": 7,
      "reading": "葬祔于興安陵",
      "start_codepoint": 90,
      "end_codepoint": 96
    }
