  "sentences": [
    {
      "id": "c-nanshi-025-wangwenhe:p001:s1",
      "kind": "received_sentence",
      "paragraph_id": "c-nanshi-025-wangwenhe:p001",
      "person_id": "726_jlm_j1k",
      "start_codepoint": 0,
      "end_codepoint": 21,
      "source_quote": "仲德兄孫文和，景和中，為征北義陽王昶府佐。",
      "reading": "仲德兄孫文和，祖父及父未具名。景和為劉子業年號（465），南齊書明主簿，《南史》只稱府佐。",
      "note": "仲德兄孫文和，祖父及父未具名。景和為劉子業年號（465），南齊書明主簿，《南史》只稱府佐。",
      "human_reviewed": false
    },
    {
      "id": "c-nanshi-025-wangwenhe:p001:s2",
      "kind": "received_sentence",
      "paragraph_id": "c-nanshi-025-wangwenhe:p001",
      "person_id": "726_jlm_j1k",
      "start_codepoint": 21,
      "end_codepoint": 41,
      "source_quote": "昶于彭城奔魏，部曲皆散，文和獨送至界上。",
      "reading": "劉昶由彭城奔魏，文和送至界。",
      "note": "劉昶由彭城奔魏，文和送至界。",
      "human_reviewed": false
    },
    {
      "id": "c-nanshi-025-wangwenhe:p001:s3",
      "kind": "received_sentence",
      "paragraph_id": "c-nanshi-025-wangwenhe:p001",
      "person_id": "726_jlm_j1k",
      "start_codepoint": 41,
      "end_codepoint": 62,
      "source_quote": "昶謂曰：「諸人皆去，卿有老母，何獨不去？」",
      "reading": "義陽王問王文和，卿是文和，老母是文和母。",
      "note": "義陽王問王文和，卿是文和，老母是文和母。",
      "human_reviewed": false
    },
    {
      "id": "c-nanshi-025-wangwenhe:p001:s4",
      "kind": "received_sentence",
      "paragraph_id": "c-nanshi-025-wangwenhe:p001",
      "person_id": "726_jlm_j1k",
      "start_codepoint": 62,
      "end_codepoint": 67,
      "source_quote": "文和乃去。",
      "reading": "文和聽言離去。",
      "note": "文和聽言離去。",
      "human_reviewed": false
    },
    {
      "id": "c-nanshi-025-wangwenhe:p001:s5",
      "kind": "received_sentence",
      "paragraph_id": "c-nanshi-025-wangwenhe:p001",
      "person_id": "726_jlm_j1k",
      "start_codepoint": 67,
      "end_codepoint": 77,
      "source_quote": "升明中，為巴陵內史。",
      "reading": "昇明在477至479間，任巴陵內史。",
      "note": "昇明在477至479間，任巴陵內史。",
      "human_reviewed": false
    },
    {
      "id": "c-nanshi-025-wangwenhe:p001:s6",
      "kind": "received_sentence",
      "paragraph_id": "c-nanshi-025-wangwenhe:p001",
      "person_id": "726_jlm_j1k",
      "start_codepoint": 77,
      "end_codepoint": 95,
      "source_quote": "沈攸之事起，文和斬其使，馳白齊武帝。",
      "reading": "沈攸之起事，文和斬其使告齊武帝；南齊書另記棄郡奔郢。",
      "note": "沈攸之起事，文和斬其使告齊武帝；南齊書另記棄郡奔郢。",
      "human_reviewed": false
    },
    {
      "id": "c-nanshi-025-wangwenhe:p001:s7",
      "kind": "received_sentence",
      "paragraph_id": "c-nanshi-025-wangwenhe:p001",
      "person_id": "726_jlm_j1k",
      "start_codepoint": 95,
      "end_codepoint": 115,
      "source_quote": "及齊永明年中，曆青、冀、兗、益四州刺史。",
      "reading": "永明在483至493間，歷四州刺史；南齊書另記平北將軍。",
      "note": "永明在483至493間，歷四州刺史；南齊書另記平北將軍。",
      "human_reviewed": false
    },
    {
      "id": "c-nanqishu-027-wangwenhe:p001:s1",
      "kind": "received_sentence",
      "paragraph_id": "c-nanqishu-027-wangwenhe:p001",
      "person_id": "726_jlm_j1k",
      "start_codepoint": 0,
      "end_codepoint": 18,
      "source_quote": "同族王文和，宋鎮北大將軍仲德兄孫也。",
      "reading": "南齊書同族王文和，指其與同傳王氏的族屬；王仲德為其祖父之弟。",
      "note": "南齊書同族王文和，指其與同傳王氏的族屬；王仲德為其祖父之弟。",
      "human_reviewed": false
    },
    {
      "id": "c-nanqishu-027-wangwenhe:p001:s2",
      "kind": "received_sentence",
      "paragraph_id": "c-nanqishu-027-wangwenhe:p001",
      "person_id": "726_jlm_j1k",
      "start_codepoint": 18,
      "end_codepoint": 33,
      "source_quote": "景和中，為義陽王昶征北府主簿。",
      "reading": "景和為劉子業年號（465），南齊書明主簿，《南史》只稱府佐。",
      "note": "景和為劉子業年號（465），南齊書明主簿，《南史》只稱府佐。",
      "human_reviewed": false
    },
    {
      "id": "c-nanqishu-027-wangwenhe:p001:s3",
      "kind": "received_sentence",
      "paragraph_id": "c-nanqishu-027-wangwenhe:p001",
      "person_id": "726_jlm_j1k",
      "start_codepoint": 33,
      "end_codepoint": 53,
      "source_quote": "昶于彭城奔虜，部曲皆散，文和獨送至界上。",
      "reading": "劉昶由彭城奔魏，文和送至界。",
      "note": "劉昶由彭城奔魏，文和送至界。",
      "human_reviewed": false
    },
    {
      "id": "c-nanqishu-027-wangwenhe:p001:s4",
      "kind": "received_sentence",
      "paragraph_id": "c-nanqishu-027-wangwenhe:p001",
      "person_id": "726_jlm_j1k",
      "start_codepoint": 53,
      "end_codepoint": 75,
      "source_quote": "昶謂之曰：「諸人皆去，卿有老母，何不去邪！」",
      "reading": "義陽王問王文和，卿是文和，老母是文和母。",
      "note": "義陽王問王文和，卿是文和，老母是文和母。",
      "human_reviewed": false
    },
    {
      "id": "c-nanqishu-027-wangwenhe:p001:s5",
      "kind": "received_sentence",
      "paragraph_id": "c-nanqishu-027-wangwenhe:p001",
      "person_id": "726_jlm_j1k",
      "start_codepoint": 75,
      "end_codepoint": 80,
      "source_quote": "文和乃去。",
      "reading": "文和聽言離去。",
      "note": "文和聽言離去。",
      "human_reviewed": false
    },
    {
      "id": "c-nanqishu-027-wangwenhe:p001:s6",
      "kind": "received_sentence",
      "paragraph_id": "c-nanqishu-027-wangwenhe:p001",
      "person_id": "726_jlm_j1k",
      "start_codepoint": 80,
      "end_codepoint": 90,
      "source_quote": "昇明中，為巴陵內史。",
      "reading": "昇明在477至479間，任巴陵內史。",
      "note": "昇明在477至479間，任巴陵內史。",
      "human_reviewed": false
    },
    {
      "id": "c-nanqishu-027-wangwenhe:p001:s7",
      "kind": "received_sentence",
      "paragraph_id": "c-nanqishu-027-wangwenhe:p001",
      "person_id": "726_jlm_j1k",
      "start_codepoint": 90,
      "end_codepoint": 115,
      "source_quote": "沈攸之事起，文和斬其使，馳白世祖告變，棄郡奔郢城。",
      "reading": "沈攸之起事，文和斬其使告齊武帝；南齊書另記棄郡奔郢。",
      "note": "沈攸之起事，文和斬其使告齊武帝；南齊書另記棄郡奔郢。",
      "human_reviewed": false
    },
    {
      "id": "c-nanqishu-027-wangwenhe:p001:s8",
      "kind": "received_sentence",
      "paragraph_id": "c-nanqishu-027-wangwenhe:p001",
      "person_id": "726_jlm_j1k",
      "start_codepoint": 115,
      "end_codepoint": 137,
      "source_quote": "永明中，歷青、冀、兖、益四州刺史，平北將軍。",
      "reading": "永明在483至493間，歷四州刺史；南齊書另記平北將軍。",
      "note": "永明在483至493間，歷四州刺史；南齊書另記平北將軍。",
      "human_reviewed": false
