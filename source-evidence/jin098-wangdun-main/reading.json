  "source_clauses": [
    {
      "witness": "j6",
      "quote": "以光祿勳應詹爲護軍將軍、假節、督朱雀橋南諸軍事，以尚書令郗鑒行衛將軍、都督從駕諸軍事，以中書監庾亮領左衛將軍，以尚書卞壼行中軍將軍。徵平北將軍、徐州刺史王邃，平西將軍、豫州刺史祖約，北中郎將、兗州刺史劉遐，奮武將軍、臨淮太守蘇峻，奮威將軍、廣陵太守陶瞻等還衛京師。",
      "raw_start": 9995,
      "raw_end": 10127,
      "raw_line": 199
    },
    {
      "witness": "sg28",
      "quote": "王凌字彥雲，太原祁人也。",
      "raw_start": 184,
      "raw_end": 196,
      "raw_line": 12
    },
    {
      "witness": "sg28",
      "quote": "乃發凌、愚塚，剖棺，暴屍於所近市三日，燒其印綬、朝服，親土埋之。",
      "raw_start": 2875,
      "raw_end": 2907,
      "raw_line": 20
    },
    {
      "witness": "sg11",
      "quote": "王脩字叔治，北海營陵人也。",
      "raw_start": 7681,
      "raw_end": 7694,
      "raw_line": 58
    },
    {
      "witness": "sg11",
      "quote": "至高密，聞譚死，下馬號哭曰：「無君焉歸？」遂詣太祖，乞收葬譚屍。",
      "raw_start": 8574,
      "raw_end": 8606,
      "raw_line": 60
    },
    {
      "witness": "chunqiu",
      "quote": "紀侯大去其國。六月乙丑，齊侯葬紀伯姬。",
      "raw_start": 648,
      "raw_end": 667,
      "raw_line": 63
    },
    {
      "witness": "hu93",
      "quote": "王應字安期斷讀曰短",
      "raw_start": 4067,
      "raw_end": 4076,
      "raw_line": 11
    },
    {
      "witness": "hu93",
      "quote": "元帝以第三子冲奉東海王越後裴妃越妃也",
      "raw_start": 3567,
      "raw_end": 3585,
      "raw_line": 11
    },
    {
      "witness": "j64",
      "quote": "元帝以東海王越世子毗沒于石勒，不知存亡，乃以沖繼毗後，稱東海世子，以毗陵郡增本封邑萬戶，又改食下邳、蘭陵，以越妃裴氏為太妃，拜長水校尉。",
      "raw_start": 4009,
      "raw_end": 4077,
      "raw_line": 72
    },
    {
      "witness": "j58",
      "quote": "勰因之欲起兵，潛結呉興郡功曹徐馥。",
      "raw_start": 3092,
      "raw_end": 3109,
      "raw_line": 36
    },
    {
      "witness": "j58",
      "quote": "劄字宣季。",
      "raw_start": 3380,
      "raw_end": 3385,
      "raw_line": 44
    },
    {
      "witness": "j70",
      "quote": "王含之難，加中軍將軍。",
      "raw_start": 7372,
      "raw_end": 7383,
      "raw_line": 74
    },
    {
      "witness": "j73",
      "quote": "及敦舉兵，加亮左衛將軍，與諸將距錢鳳。",
      "raw_start": 1516,
      "raw_end": 1535,
      "raw_line": 27
    },
    {
      "witness": "j68",
      "quote": "俄轉領軍將軍，當時服其嚴毅。",
      "raw_start": 6989,
      "raw_end": 7003,
      "raw_line": 70
    },
    {
      "witness": "ss13",
      "quote": "王處仲每酒後，輒詠「老驥伏櫪，志在千里；烈士暮年，壯心不已」，",
      "raw_start": 469,
      "raw_end": 500,
      "raw_line": 12
    },
    {
      "witness": "ss13",
      "quote": "魏武帝《樂府詩》。",
      "raw_start": 504,
      "raw_end": 513,
      "raw_line": 12
    },
    {
      "witness": "ss13",
      "quote": "王大將軍年少時，舊有田舍名，語音亦楚。武帝喚時賢，共言伎藝之事，人人皆多有所知；唯王都無所關，意色殊惡。自言知打鼓吹。帝即令取鼓與之，於坐振袖而起，揚槌奮擊，音節諧捷，神氣豪上，傍若無人。舉坐嘆其雄爽。",
      "raw_start": 115,
      "raw_end": 216,
      "raw_line": 9
    },
    {
      "witness": "ss13",
      "quote": "王處仲世許高尚之目，嘗荒恣於色，體為之弊。左右諫之，處仲曰：「吾乃不覺爾。如此者，甚易耳！」乃開內後閤，驅諸婢妾數十人出路，任其所之。時人嘆焉。",
      "raw_start": 304,
      "raw_end": 376,
      "raw_line": 10
    },
    {
      "witness": "ss30",
      "quote": "石崇廁，常有十餘婢侍列，皆麗服藻飾。",
      "raw_start": 383,
      "raw_end": 401,
      "raw_line": 10
    },
    {
      "witness": "ss30",
