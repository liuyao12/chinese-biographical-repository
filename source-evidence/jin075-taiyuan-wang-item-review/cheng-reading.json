      "reading": "性清虛寡欲。",
      "note": "性清虛寡欲。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line018:received_sentence-15",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line018",
      "source_quote": "言理辯物，但明其指要而不飾文辭，有識者服其約而能通。",
      "start_codepoint": 15,
      "end_codepoint": 41,
      "reading": "言理明要，受識者推服。",
      "note": "言理明要，受識者推服。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line018:received_sentence-41",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line018",
      "source_quote": "弱冠知名。",
      "start_codepoint": 41,
      "end_codepoint": 46,
      "reading": "弱冠已知名，沒有紀年。",
      "note": "弱冠已知名，沒有紀年。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line018:received_sentence-46",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line018",
      "source_quote": "太尉王衍雅貴異之，比南陽樂廣焉。",
      "start_codepoint": 46,
      "end_codepoint": 62,
      "reading": "王衍把王承比作南陽樂廣。",
      "note": "王衍把王承比作南陽樂廣。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line018:received_sentence-62",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line018",
      "source_quote": "永寧初，為驃騎參軍。",
      "start_codepoint": 62,
      "end_codepoint": 72,
      "reading": "永寧初任驃騎參軍。",
      "note": "永寧初任驃騎參軍。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line018:received_sentence-72",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line018",
      "source_quote": "值天下將亂，乃避難南下。",
      "start_codepoint": 72,
      "end_codepoint": 84,
      "reading": "天下將亂而避難南下。",
      "note": "天下將亂而避難南下。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line018:received_sentence-84",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line018",
      "source_quote": "遷司空從事中郎。",
      "start_codepoint": 84,
      "end_codepoint": 92,
      "reading": "遷司空從事中郎。",
      "note": "遷司空從事中郎。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line018:received_sentence-92",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line018",
      "source_quote": "豫迎大駕，賜爵藍田縣侯。",
      "start_codepoint": 92,
      "end_codepoint": 104,
      "reading": "參與迎駕，受藍田縣侯。",
      "note": "參與迎駕，受藍田縣侯。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line018:received_sentence-104",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line018",
      "source_quote": "遷尚書郎，不就。",
      "start_codepoint": 104,
      "end_codepoint": 112,
      "reading": "受尚書郎之命而不就。",
      "note": "受尚書郎之命而不就。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line018:received_sentence-112",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line018",
      "source_quote": "東海王越鎮許，以為記室參軍。",
      "start_codepoint": 112,
      "end_codepoint": 126,
      "reading": "東海王司馬越鎮許，以承為記室參軍。",
      "note": "東海王司馬越鎮許，以承為記室參軍。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line018:received_sentence-126",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line018",
      "source_quote": "雅相知重，敕其子毗曰：「夫學之所益者淺，體之所安者深。",
      "start_codepoint": 126,
      "end_codepoint": 153,
      "reading": "越敕其子司馬毗，以下為講學的話。",
      "note": "越敕其子司馬毗，以下為講學的話。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line018:received_sentence-153",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line018",
      "source_quote": "閑習禮度，不如式瞻儀形；諷味遺言，不若親承音旨。",
      "start_codepoint": 153,
      "end_codepoint": 177,
      "reading": "接上引語，論親承教益。",
      "note": "接上引語，論親承教益。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line018:received_sentence-177",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line018",
      "source_quote": "王參軍人倫之表，汝其師之。」",
      "start_codepoint": 177,
      "end_codepoint": 191,
      "reading": "越令毗師事王承。",
      "note": "越令毗師事王承。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line018:received_sentence-191",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line018",
      "source_quote": "在府數年，見朝政漸替，辭以母老，求出。",
      "start_codepoint": 191,
      "end_codepoint": 210,
      "reading": "在越府數年，以母年老求出任。",
      "note": "在越府數年，以母年老求出任。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line018:received_sentence-210",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line018",
      "source_quote": "越不許。",
      "start_codepoint": 210,
      "end_codepoint": 214,
      "reading": "越不許。",
      "note": "越不許。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line018:received_sentence-214",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line018",
      "source_quote": "久之，遷東海太守，政尚清淨，不為細察。",
      "start_codepoint": 214,
      "end_codepoint": 233,
      "reading": "後遷東海太守，尚清淨。",
      "note": "後遷東海太守，尚清淨。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line018:received_sentence-233",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line018",
      "source_quote": "小吏有盜池不魚者，綱紀推之，承曰：「文王之囿與眾共之，池魚復何足惜耶！」",
      "start_codepoint": 233,
      "end_codepoint": 269,
      "reading": "小吏、綱紀各別，未具名；「不魚」在殿本、四庫本及世說作池中魚。",
      "note": "小吏、綱紀各別，未具名；「不魚」在殿本、四庫本及世說作池中魚。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line018:received_sentence-269",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line018",
      "source_quote": "有犯夜者，為吏所拘，承問其故，答曰：「從師受書，不覺日暮。」",
      "start_codepoint": 269,
      "end_codepoint": 299,
      "reading": "犯夜者自稱從師受書；不與上句盜魚小吏合。",
      "note": "犯夜者自稱從師受書；不與上句盜魚小吏合。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line018:received_sentence-299",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line018",
      "source_quote": "承曰：「鞭撻寧越以立威名，非政化之本。」",
      "start_codepoint": 299,
      "end_codepoint": 319,
      "reading": "王承借寧越勤學故事比犯夜者。",
      "note": "王承借寧越勤學故事比犯夜者。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line018:received_sentence-319",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line018",
      "source_quote": "使吏送，令歸家。",
      "start_codepoint": 319,
      "end_codepoint": 327,
      "reading": "承使吏送被拘者歸家。",
      "note": "承使吏送被拘者歸家。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line018:received_sentence-327",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line018",
      "source_quote": "其從容寬恕若此。",
      "start_codepoint": 327,
      "end_codepoint": 335,
      "reading": "史家概括王承寬恕。",
      "note": "史家概括王承寬恕。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line020:received_sentence-0",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line020",
      "source_quote": "尋去官，東渡江。",
      "start_codepoint": 0,
      "end_codepoint": 8,
      "reading": "去東海郡官渡江。",
      "note": "去東海郡官渡江。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line020:received_sentence-8",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line020",
      "source_quote": "是時道路梗澀，人懷危懼，承每遇艱險，處之夷然，雖家人近習，不見其憂喜之色。",
      "start_codepoint": 8,
      "end_codepoint": 45,
      "reading": "王承遭艱險神色自若，家人與親近侍者為群體。",
      "note": "王承遭艱險神色自若，家人與親近侍者為群體。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line020:received_sentence-45",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line020",
      "source_quote": "既至下邳，登山北望，歎曰：「人言愁，我始欲愁矣。」",
      "start_codepoint": 45,
      "end_codepoint": 70,
      "reading": "在下邳登山，自言始愁。",
      "note": "在下邳登山，自言始愁。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line020:received_sentence-70",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line020",
      "source_quote": "及至建鄴，為元帝鎮東府從事中郎，甚見優禮。",
      "start_codepoint": 70,
      "end_codepoint": 91,
      "reading": "抵建鄴，在司馬睿鎮東府任從事中郎。",
      "note": "抵建鄴，在司馬睿鎮東府任從事中郎。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line020:received_sentence-91",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line020",
      "source_quote": "承少有重譽，而推誠接物，盡弘恕之理，故眾咸親愛焉。",
      "start_codepoint": 91,
      "end_codepoint": 116,
      "reading": "接物推誠，為人親愛。",
      "note": "接物推誠，為人親愛。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line020:received_sentence-116",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line020",
      "source_quote": "渡江名臣王導、衛玠、周顗、庾亮之徒皆出其下，為中興第一。",
      "start_codepoint": 116,
      "end_codepoint": 144,
      "reading": "史傳載渡江名臣四人及王承的中興第一之評。",
      "note": "史傳載渡江名臣四人及王承的中興第一之評。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line020:received_sentence-144",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line020",
      "source_quote": "年四十六卒，朝野痛惜之。",
      "start_codepoint": 144,
      "end_codepoint": 156,
      "reading": "卒年四十六，卒年干支、年號未載。",
      "note": "卒年四十六，卒年干支、年號未載。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line020:received_sentence-156",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line020",
      "source_quote": "自昶至承，世有高名，論者以為祖不及孫，孫不及父。",
      "start_codepoint": 156,
      "end_codepoint": 180,
      "reading": "依上文王昶至王承，祖、孫、父可按家世解為昶、承、湛。",
      "note": "依上文王昶至王承，祖、孫、父可按家世解為昶、承、湛。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line020:received_sentence-180",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line020",
      "source_quote": "子述嗣。",
      "start_codepoint": 180,
      "end_codepoint": 184,
      "reading": "子王述承嗣。",
      "note": "子王述承嗣。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line018:unnamed_imperial_procession-92",
      "kind": "unnamed_imperial_procession",
      "person_id": "a8f_ec8_e74_AAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line018",
      "source_quote": "豫迎大駕",
      "start_codepoint": 92,
      "end_codepoint": 96,
      "reading": "惠帝紀有同時越軍西迎記事，推候惠帝，紀未點王承；大駕的舊錨仍可回查。",
      "note": "惠帝紀有同時越軍西迎記事，推候惠帝，紀未點王承；大駕的舊錨仍可回查。",
      "human_reviewed": false,
      "candidate_person_ids": [
        "7e0_f69_1ac"
      ]
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line018:appointment_declined-104",
      "kind": "appointment_declined",
      "person_id": "a8f_ec8_e74_AAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line018",
      "source_quote": "遷尚書郎，不就",
      "start_codepoint": 104,
      "end_codepoint": 111,
      "reading": "不就。原有職官提名已有拒受標記。",
      "note": "不就。原有職官提名已有拒受標記。",
      "human_reviewed": false,
      "issued_proposal_id": "tp-taiyuan2-075-18-105"
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line018:unnamed_mother-202",
      "kind": "unnamed_mother",
      "person_id": "a8f_ec8_e74_AAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line018",
      "source_quote": "辭以母老",
      "start_codepoint": 202,
      "end_codepoint": 206,
      "reading": "本傳未名王承母。列女傳雖有王湛之妻郝氏，此句不足指認為王承生母。",
      "note": "本傳未名王承母。列女傳雖有王湛之妻郝氏，此句不足指認為王承生母。",
      "human_reviewed": false,
      "relationship": "mother",
      "relative_person_id": null
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line018:explicit_father_and_son-131",
      "kind": "explicit_father_and_son",
      "person_id": "9o2_vhv_r7y",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line018",
      "source_quote": "敕其子毗",
      "start_codepoint": 131,
      "end_codepoint": 135,
      "reading": "越為父、毗為子；保留毗既有人號。",
      "note": "越為父、毗為子；保留毗既有人號。",
      "human_reviewed": false,
      "subject_person_id": "1d1_298_a7e",
      "father_person_id": "9o2_vhv_r7y"
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line018:printed_text_variant-235",
      "kind": "printed_text_variant",
      "person_id": "a8f_ec8_e74_AAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line018",
      "source_quote": "有盜池不魚者",
      "start_codepoint": 235,
      "end_codepoint": 241,
      "reading": "殿本、四庫本作「盜池中魚」，《世說》同有中魚。固定原文「不」在位保全。",
      "note": "殿本、四庫本作「盜池中魚」，《世說》同有中魚。固定原文「不」在位保全。",
      "human_reviewed": false,
      "printed": "有盜池中魚者"
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line018:unnamed_actor-269",
      "kind": "unnamed_actor",
      "person_id": "a8f_ec8_e74_AAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line018",
      "source_quote": "有犯夜者",
      "start_codepoint": 269,
      "end_codepoint": 273,
