  "cases": [
    {
      "id": "c-jinshu-075-taiyuan-wang:line115:received_sentence-0",
      "kind": "received_sentence",
      "person_id": "8e8_ca8_29d_A",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line115",
      "source_quote": "嶠字開山。",
      "start_codepoint": 0,
      "end_codepoint": 5,
      "reading": "字開山。",
      "note": "字開山。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line115:received_sentence-5",
      "kind": "received_sentence",
      "person_id": "8e8_ca8_29d_A",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line115",
      "source_quote": "祖默，魏尚書。",
      "start_codepoint": 5,
      "end_codepoint": 12,
      "reading": "祖王默為魏尚書。",
      "note": "祖王默為魏尚書。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line115:received_sentence-12",
      "kind": "received_sentence",
      "person_id": "8e8_ca8_29d_A",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line115",
      "source_quote": "父佑，以才智稱，為楊駿腹心。",
      "start_codepoint": 12,
      "end_codepoint": 26,
      "reading": "父王佑為楊駿腹心。",
      "note": "父王佑為楊駿腹心。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line115:received_sentence-26",
      "kind": "received_sentence",
      "person_id": "8e8_ca8_29d_A",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line115",
      "source_quote": "駿之排汝南王亮，退衛瓘，皆佑之謀也。",
      "start_codepoint": 26,
      "end_codepoint": 44,
      "reading": "排司馬亮、退衛瓘是王佑之謀。",
      "note": "排司馬亮、退衛瓘是王佑之謀。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line115:received_sentence-44",
      "kind": "received_sentence",
      "person_id": "8e8_ca8_29d_A",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line115",
      "source_quote": "位至北軍中候。",
      "start_codepoint": 44,
      "end_codepoint": 51,
      "reading": "北軍中候為王佑末官。",
      "note": "北軍中候為王佑末官。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line115:received_sentence-51",
      "kind": "received_sentence",
      "person_id": "8e8_ca8_29d_A",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line115",
      "source_quote": "嶠少有風尚，並、司二州交辟，不就。",
      "start_codepoint": 51,
      "end_codepoint": 68,
      "reading": "并、司二州召嶠而不就。",
      "note": "并、司二州召嶠而不就。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line115:received_sentence-68",
      "kind": "received_sentence",
      "person_id": "8e8_ca8_29d_A",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line115",
      "source_quote": "永嘉末，攜其二弟避亂渡江。",
      "start_codepoint": 68,
      "end_codepoint": 81,
      "reading": "永嘉末與其二弟渡江，二弟均未署名。",
      "note": "永嘉末與其二弟渡江，二弟均未署名。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line115:received_sentence-81",
      "kind": "received_sentence",
      "person_id": "8e8_ca8_29d_A",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line115",
      "source_quote": "時元帝鎮建鄴，教曰：「王佑三息始至，名德之胄，並有操行，宜蒙飾敘。",
      "start_codepoint": 81,
      "end_codepoint": 114,
      "reading": "司馬睿稱王佑三息，指嶠與二弟。",
      "note": "司馬睿稱王佑三息，指嶠與二弟。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line115:received_sentence-114",
      "kind": "received_sentence",
      "person_id": "8e8_ca8_29d_A",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line115",
      "source_quote": "且可給錢三十萬，帛三百匹，米五十斛，親兵二十人。」",
      "start_codepoint": 114,
      "end_codepoint": 139,
      "reading": "賜錢、帛、米及親兵人數各有單位。",
      "note": "賜錢、帛、米及親兵人數各有單位。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line115:received_sentence-139",
      "kind": "received_sentence",
      "person_id": "8e8_ca8_29d_A",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line115",
      "source_quote": "尋以嶠參世子東中郎軍事。",
      "start_codepoint": 139,
      "end_codepoint": 151,
      "reading": "擬令嶠參世子東中郎軍事。",
      "note": "擬令嶠參世子東中郎軍事。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line115:received_sentence-151",
      "kind": "received_sentence",
      "person_id": "8e8_ca8_29d_A",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line115",
      "source_quote": "不就。",
      "start_codepoint": 151,
      "end_codepoint": 154,
      "reading": "此項亦未就。",
      "note": "此項亦未就。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line115:received_sentence-154",
      "kind": "received_sentence",
      "person_id": "8e8_ca8_29d_A",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line115",
      "source_quote": "湣帝徵拜著作郎，右丞相南陽王保辟，皆以道險不行。",
      "start_codepoint": 154,
      "end_codepoint": 178,
      "reading": "湣帝徵拜、司馬保辟召均因路險未行。",
      "note": "湣帝徵拜、司馬保辟召均因路險未行。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line115:received_sentence-178",
      "kind": "received_sentence",
      "person_id": "8e8_ca8_29d_A",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line115",
      "source_quote": "元帝作相，以為水曹屬，除長山令，遷太子中舍人以疾不拜。",
      "start_codepoint": 178,
      "end_codepoint": 205,
      "reading": "睿作相時為水曹屬、長山令，太子中舍人以疾不拜。",
      "note": "睿作相時為水曹屬、長山令，太子中舍人以疾不拜。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line115:received_sentence-205",
      "kind": "received_sentence",
      "person_id": "8e8_ca8_29d_A",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line115",
      "source_quote": "王敦請為參軍，爵九原縣公。",
      "start_codepoint": 205,
      "end_codepoint": 218,
      "reading": "王敦請為參軍，王嶠受九原縣公。",
      "note": "王敦請為參軍，王嶠受九原縣公。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line117:received_sentence-0",
      "kind": "received_sentence",
      "person_id": "8e8_ca8_29d_A",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line117",
      "source_quote": "敦在石頭，欲禁私伐蔡洲荻，以問群下。",
      "start_codepoint": 0,
      "end_codepoint": 18,
      "reading": "王敦欲禁取蔡洲荻，問群下。",
      "note": "王敦欲禁取蔡洲荻，問群下。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line117:received_sentence-18",
      "kind": "received_sentence",
      "person_id": "8e8_ca8_29d_A",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line117",
      "source_quote": "時王師新敗，士庶震懼，莫敢異議。",
      "start_codepoint": 18,
      "end_codepoint": 34,
      "reading": "晉軍新敗，群下懼。",
      "note": "晉軍新敗，群下懼。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line117:received_sentence-34",
      "kind": "received_sentence",
      "person_id": "8e8_ca8_29d_A",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line117",
      "source_quote": "嶠獨曰：「中原有菽，庶人采之。",
      "start_codepoint": 34,
      "end_codepoint": 49,
      "reading": "王嶠以詩句答。",
      "note": "王嶠以詩句答。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line117:received_sentence-49",
      "kind": "received_sentence",
      "person_id": "8e8_ca8_29d_A",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line117",
      "source_quote": "百姓不足，君孰與足！",
      "start_codepoint": 49,
      "end_codepoint": 59,
      "reading": "轉引百姓與君，言對王敦。",
      "note": "轉引百姓與君，言對王敦。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line117:received_sentence-59",
      "kind": "received_sentence",
      "person_id": "8e8_ca8_29d_A",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line117",
      "source_quote": "若禁人樵伐，未知其可。」",
      "start_codepoint": 59,
      "end_codepoint": 71,
      "reading": "諫勿禁樵伐。",
      "note": "諫勿禁樵伐。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line117:received_sentence-71",
      "kind": "received_sentence",
      "person_id": "8e8_ca8_29d_A",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line117",
      "source_quote": "敦不悅。",
      "start_codepoint": 71,
      "end_codepoint": 75,
      "reading": "王敦不悅。",
      "note": "王敦不悅。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line117:received_sentence-75",
      "kind": "received_sentence",
      "person_id": "8e8_ca8_29d_A",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line117",
      "source_quote": "敦將殺周顗、戴若思，嶠於坐諫曰：「濟濟多士，交王以寧。",
      "start_codepoint": 75,
      "end_codepoint": 102,
      "reading": "將殺周顗、戴若思，嶠在坐以詩句諫。",
      "note": "將殺周顗、戴若思，嶠在坐以詩句諫。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line117:received_sentence-102",
      "kind": "received_sentence",
      "person_id": "8e8_ca8_29d_A",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line117",
      "source_quote": "安可戮諸名士，以自全生！」",
      "start_codepoint": 102,
      "end_codepoint": 115,
      "reading": "繼問是否可殺人自全。",
      "note": "繼問是否可殺人自全。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line117:received_sentence-115",
      "kind": "received_sentence",
      "person_id": "8e8_ca8_29d_A",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line117",
      "source_quote": "敦大怒，欲斬嶠，賴謝鯤以免。",
      "start_codepoint": 115,
      "end_codepoint": 129,
      "reading": "王敦怒，嶠賴謝鯤得免。",
      "note": "王敦怒，嶠賴謝鯤得免。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line117:received_sentence-129",
      "kind": "received_sentence",
      "person_id": "8e8_ca8_29d_A",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line117",
      "source_quote": "敦猶銜之，出為領軍長史。",
      "start_codepoint": 129,
      "end_codepoint": 141,
      "reading": "敦銜恨，使嶠出為領軍長史。",
      "note": "敦銜恨，使嶠出為領軍長史。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line117:received_sentence-141",
      "kind": "received_sentence",
      "person_id": "8e8_ca8_29d_A",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line117",
      "source_quote": "敦平後，除中書侍郎，兼大著作，固辭。",
      "start_codepoint": 141,
      "end_codepoint": 159,
      "reading": "敦平後除中書侍郎，兼大著作，固辭。",
      "note": "敦平後除中書侍郎，兼大著作，固辭。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line117:received_sentence-159",
      "kind": "received_sentence",
      "person_id": "8e8_ca8_29d_A",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line117",
      "source_quote": "轉越騎校尉，頻遷吏部郎、御史中丞、秘書監，領本州大中正。",
      "start_codepoint": 159,
      "end_codepoint": 187,
      "reading": "歷越騎校尉、吏部郎、中丞、秘書監，領大中正。",
      "note": "歷越騎校尉、吏部郎、中丞、秘書監，領大中正。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line117:received_sentence-187",
      "kind": "received_sentence",
      "person_id": "8e8_ca8_29d_A",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line117",
      "source_quote": "咸和初，朝議欲以嶠為丹陽尹。",
      "start_codepoint": 187,
      "end_codepoint": 201,
      "reading": "咸和初擬丹陽尹。",
      "note": "咸和初擬丹陽尹。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line117:received_sentence-201",
      "kind": "received_sentence",
      "person_id": "8e8_ca8_29d_A",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line117",
      "source_quote": "嶠以京尹望重，不宜以疾居之，求補廬陵郡，乃拜嶠廬陵太守。",
      "start_codepoint": 201,
      "end_codepoint": 229,
      "reading": "病使嶠辭京尹改求廬陵，實任廬陵太守。",
      "note": "病使嶠辭京尹改求廬陵，實任廬陵太守。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line117:received_sentence-229",
      "kind": "received_sentence",
      "person_id": "8e8_ca8_29d_A",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line117",
      "source_quote": "以嶠家貧，無以上道，賜布百匹。",
      "start_codepoint": 229,
      "end_codepoint": 244,
      "reading": "賜布百匹助赴任。",
      "note": "賜布百匹助赴任。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line117:received_sentence-244",
      "kind": "received_sentence",
      "person_id": "8e8_ca8_29d_A",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line117",
      "source_quote": "錢十萬。",
      "start_codepoint": 244,
