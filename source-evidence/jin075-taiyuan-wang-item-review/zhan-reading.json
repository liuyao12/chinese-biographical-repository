    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line011:received_sentence-14",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line011",
      "source_quote": "少有識度。",
      "start_codepoint": 14,
      "end_codepoint": 19,
      "reading": "少有識度。",
      "note": "少有識度。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line011:received_sentence-19",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line011",
      "source_quote": "身長七尺八寸，龍顙大鼻，少言語。",
      "start_codepoint": 19,
      "end_codepoint": 35,
      "reading": "七尺八寸為身量，另記額鼻及少言。",
      "note": "七尺八寸為身量，另記額鼻及少言。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line011:received_sentence-35",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line011",
      "source_quote": "初有隱德，人莫能知，兄弟宗族皆以為癡，其父昶獨異焉。",
      "start_codepoint": 35,
      "end_codepoint": 61,
      "reading": "族人以為癡，父王昶獨異之。",
      "note": "族人以為癡，父王昶獨異之。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line011:received_sentence-61",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line011",
      "source_quote": "遭父喪，居於墓次。",
      "start_codepoint": 61,
      "end_codepoint": 70,
      "reading": "喪父居墓旁。",
      "note": "喪父居墓旁。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line011:received_sentence-70",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line011",
      "source_quote": "服闋，闔門守靜，不交當世，沖素簡淡，器量隤然，有公輔之望。",
      "start_codepoint": 70,
      "end_codepoint": 99,
      "reading": "除服守靜，不交當世，時人望其為公輔。",
      "note": "除服守靜，不交當世，時人望其為公輔。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line013:received_sentence-0",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line013",
      "source_quote": "兄子濟輕之，所食方丈盈前，不以及淇。",
      "start_codepoint": 0,
      "end_codepoint": 18,
      "reading": "王濟輕叔，獨享豐盛飲食。數位字淇與刊本湛分列。",
      "note": "王濟輕叔，獨享豐盛飲食。數位字淇與刊本湛分列。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line013:received_sentence-18",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line013",
      "source_quote": "湛命取菜蔬，對而食之。",
      "start_codepoint": 18,
      "end_codepoint": 29,
      "reading": "王湛命取菜蔬相對進食。",
      "note": "王湛命取菜蔬相對進食。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line013:received_sentence-29",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line013",
      "source_quote": "濟嘗詣湛，見床頭有《周易》，問曰：「叔父何用此為？」",
      "start_codepoint": 29,
      "end_codepoint": 55,
      "reading": "王濟向叔王湛問床頭《周易》。",
      "note": "王濟向叔王湛問床頭《周易》。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line013:received_sentence-55",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line013",
      "source_quote": "湛曰：「體中不佳時，脫復看耳。」",
      "start_codepoint": 55,
      "end_codepoint": 71,
      "reading": "王湛答偶爾閱讀。",
      "note": "王湛答偶爾閱讀。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line013:received_sentence-71",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line013",
      "source_quote": "濟請言之。",
      "start_codepoint": 71,
      "end_codepoint": 76,
      "reading": "王濟請其講解。",
      "note": "王濟請其講解。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line013:received_sentence-76",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line013",
      "source_quote": "湛因剖析玄理，微妙有奇趣，皆濟所未聞也。",
      "start_codepoint": 76,
      "end_codepoint": 96,
      "reading": "王湛析玄理，濟此前未聞。",
      "note": "王湛析玄理，濟此前未聞。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line013:received_sentence-96",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line013",
      "source_quote": "濟才氣抗邁，於湛略無子侄之敬。",
      "start_codepoint": 96,
      "end_codepoint": 111,
      "reading": "濟原來少盡子姪禮。",
      "note": "濟原來少盡子姪禮。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line013:received_sentence-111",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line013",
      "source_quote": "既聞其言，不覺栗然，心形俱肅。",
      "start_codepoint": 111,
      "end_codepoint": 126,
      "reading": "聽湛之言而肅然。",
      "note": "聽湛之言而肅然。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line013:received_sentence-126",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line013",
      "source_quote": "遂留連彌日累夜，自視缺然，乃歎曰：「家有名士，三十年而不知，濟之罪也。」",
      "start_codepoint": 126,
      "end_codepoint": 162,
      "reading": "王濟言三十年未識家中名士；數字是自述歷時。",
      "note": "王濟言三十年未識家中名士；數字是自述歷時。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line013:received_sentence-162",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line013",
      "source_quote": "既而辭去，湛送至門。",
      "start_codepoint": 162,
      "end_codepoint": 172,
      "reading": "辭去者為濟，送至門者湛。",
      "note": "辭去者為濟，送至門者湛。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line013:received_sentence-172",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line013",
      "source_quote": "濟有從馬絕難乘，濟問湛曰：「叔頗好騎不？」",
      "start_codepoint": 172,
      "end_codepoint": 193,
      "reading": "王濟問叔是否好騎。",
      "note": "王濟問叔是否好騎。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line013:received_sentence-193",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line013",
      "source_quote": "湛曰：「亦好之。」",
      "start_codepoint": 193,
      "end_codepoint": 202,
      "reading": "王湛自答好騎。",
      "note": "王湛自答好騎。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line013:received_sentence-202",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line013",
      "source_quote": "因騎此馬，姿容既妙，回策如縈，善騎者無以過之。",
      "start_codepoint": 202,
      "end_codepoint": 225,
      "reading": "湛能騎濟之難乘馬。",
      "note": "湛能騎濟之難乘馬。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line013:received_sentence-225",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line013",
      "source_quote": "又濟所乘馬，甚愛之，湛曰：「此馬雖快，然力薄不堪苦行。",
      "start_codepoint": 225,
      "end_codepoint": 252,
      "reading": "濟之坐騎雖快，湛評其力薄。",
      "note": "濟之坐騎雖快，湛評其力薄。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line013:received_sentence-252",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line013",
      "source_quote": "近見督郵馬當勝，但芻秣不至耳。」",
      "start_codepoint": 252,
      "end_codepoint": 268,
      "reading": "督郵所有之馬與濟馬比較，督郵未具名。",
      "note": "督郵所有之馬與濟馬比較，督郵未具名。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line013:received_sentence-268",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line013",
      "source_quote": "濟試養之，而與己馬等。",
      "start_codepoint": 268,
      "end_codepoint": 279,
      "reading": "濟試行飼養，與自己之馬相若。",
      "note": "濟試行飼養，與自己之馬相若。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line013:received_sentence-279",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line013",
      "source_quote": "湛又曰：「此馬任重方知之，平路無以別也。」",
      "start_codepoint": 279,
      "end_codepoint": 300,
      "reading": "湛認為任重始見優劣。",
      "note": "湛認為任重始見優劣。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line013:received_sentence-300",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line013",
      "source_quote": "於是當蟻封內試之，濟馬果躓，而督郵馬如常。",
      "start_codepoint": 300,
      "end_codepoint": 321,
      "reading": "濟馬蹶而督郵馬行走如常。",
      "note": "濟馬蹶而督郵馬行走如常。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line013:received_sentence-321",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line013",
      "source_quote": "濟益歎，還白其父，曰：「濟始得一叔，乃濟以上人也。」",
      "start_codepoint": 321,
      "end_codepoint": 347,
      "reading": "王濟向父王渾稱叔勝己；《世說》明書渾問。",
      "note": "王濟向父王渾稱叔勝己；《世說》明書渾問。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line013:received_sentence-347",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line013",
      "source_quote": "武帝亦以湛為癡，每見濟，輒調之曰：「卿家癡叔死未？」",
      "start_codepoint": 347,
      "end_codepoint": 373,
      "reading": "武帝以癡叔調笑王濟，卿指王濟。",
      "note": "武帝以癡叔調笑王濟，卿指王濟。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line013:received_sentence-373",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line013",
      "source_quote": "濟常無以答。",
      "start_codepoint": 373,
      "end_codepoint": 379,
      "reading": "王濟向來無以回答。",
      "note": "王濟向來無以回答。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line013:received_sentence-379",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line013",
      "source_quote": "及是，帝又問如初，濟曰：「臣叔殊不癡。」",
      "start_codepoint": 379,
      "end_codepoint": 399,
      "reading": "武帝再問，濟以臣自稱。",
      "note": "武帝再問，濟以臣自稱。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line013:received_sentence-399",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line013",
      "source_quote": "因稱其美。",
      "start_codepoint": 399,
      "end_codepoint": 404,
      "reading": "濟稱其叔之美。",
      "note": "濟稱其叔之美。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line013:received_sentence-404",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line013",
      "source_quote": "帝曰：「誰比？」",
      "start_codepoint": 404,
      "end_codepoint": 412,
      "reading": "武帝問可與誰相比。",
      "note": "武帝問可與誰相比。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line013:received_sentence-412",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line013",
      "source_quote": "濟曰：「山濤以下，魏舒以上。」",
      "start_codepoint": 412,
      "end_codepoint": 427,
      "reading": "王濟用山濤、魏舒作比。",
      "note": "王濟用山濤、魏舒作比。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line013:received_sentence-427",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line013",
      "source_quote": "時人謂湛上方山濤不足，下比魏舒有餘。",
      "start_codepoint": 427,
      "end_codepoint": 445,
      "reading": "時人具述比較次第。",
      "note": "時人具述比較次第。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line013:received_sentence-445",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line013",
      "source_quote": "湛聞曰：「欲處我于季孟之間乎？」",
      "start_codepoint": 445,
      "end_codepoint": 461,
      "reading": "王湛自稱我，用季孟之間典故。",
      "note": "王湛自稱我，用季孟之間典故。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line015:received_sentence-0",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line015",
      "source_quote": "湛少仕歷秦王文學、太子洗馬、尚書郎、太子中庶子，出為汝南內史。",
      "start_codepoint": 0,
      "end_codepoint": 31,
      "reading": "歷五官；秦王文學依原職名，未據此號實定秦王。",
      "note": "歷五官；秦王文學依原職名，未據此號實定秦王。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line015:received_sentence-31",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line015",
      "source_quote": "元康五年卒，年四十七。",
      "start_codepoint": 31,
      "end_codepoint": 42,
      "reading": "元康五年卒，年四十七。",
      "note": "元康五年卒，年四十七。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line015:received_sentence-42",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line015",
      "source_quote": "子承嗣。",
      "start_codepoint": 42,
      "end_codepoint": 46,
      "reading": "子承嗣，記事未明說所嗣爵名。",
      "note": "子承嗣，記事未明說所嗣爵名。",
      "human_reviewed": false
    },
