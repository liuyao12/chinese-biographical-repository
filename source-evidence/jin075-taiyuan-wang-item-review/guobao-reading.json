  "cases": [
    {
      "id": "c-jinshu-075-taiyuan-wang:line090:received_sentence-0",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line090",
      "source_quote": "國寶少無士操，不修廉隅。",
      "start_codepoint": 0,
      "end_codepoint": 12,
      "reading": "傳首先記國寶少時行狀。",
      "note": "傳首先記國寶少時行狀。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line090:received_sentence-12",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line090",
      "source_quote": "婦父謝安惡其傾側，每抑而不用。",
      "start_codepoint": 12,
      "end_codepoint": 27,
      "reading": "婦父謝安抑之。",
      "note": "婦父謝安抑之。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line090:received_sentence-27",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line090",
      "source_quote": "除尚書郎。",
      "start_codepoint": 27,
      "end_codepoint": 32,
      "reading": "擬授尚書郎。",
      "note": "擬授尚書郎。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line090:received_sentence-32",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line090",
      "source_quote": "國寶以中興膏腴之族，惟作吏部，不為余曹郎，甚怨望，固辭不拜。",
      "start_codepoint": 32,
      "end_codepoint": 62,
      "reading": "國寶以出身為由只願任吏部郎，實辭不拜。",
      "note": "國寶以出身為由只願任吏部郎，實辭不拜。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line090:received_sentence-62",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line090",
      "source_quote": "從妹為會稽王道子妃，由是與道子遊處，遂間毀安焉。",
      "start_codepoint": 62,
      "end_codepoint": 86,
      "reading": "從妹已為司馬道子妃，國寶與道子相從並毀謝安。",
      "note": "從妹已為司馬道子妃，國寶與道子相從並毀謝安。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line092:received_sentence-0",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line092",
      "source_quote": "及道子輔政，以為秘書丞。",
      "start_codepoint": 0,
      "end_codepoint": 12,
      "reading": "道子輔政，以國寶為秘書丞。",
      "note": "道子輔政，以國寶為秘書丞。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line092:received_sentence-12",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line092",
      "source_quote": "俄遷琅邪內史，領堂邑太守，加輔國將軍。",
      "start_codepoint": 12,
      "end_codepoint": 31,
      "reading": "遷琅邪內史，領堂邑太守，加輔國將軍。",
      "note": "遷琅邪內史，領堂邑太守，加輔國將軍。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line092:received_sentence-31",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line092",
      "source_quote": "人補侍中，遷中書令、中領軍，與道子持威權，扇動內外。",
      "start_codepoint": 31,
      "end_codepoint": 57,
      "reading": "數位「人補侍中」，武英殿本與四庫均為「入補侍郎」；後遷中書令、中領軍。",
      "note": "數位「人補侍中」，武英殿本與四庫均為「入補侍郎」；後遷中書令、中領軍。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line092:received_sentence-57",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line092",
      "source_quote": "中書郎范寧，國寶舅也，儒雅方直，疾其阿諛，勸孝武帝黜之。",
      "start_codepoint": 57,
      "end_codepoint": 85,
      "reading": "范寧既是中書郎亦是國寶舅，勸孝武帝黜國寶。",
      "note": "范寧既是中書郎亦是國寶舅，勸孝武帝黜國寶。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line092:received_sentence-85",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line092",
      "source_quote": "國寶乃使陳郡袁悅之因尼支妙音致書與太子母陳淑媛，說國寶忠謹，宜見親信。",
      "start_codepoint": 85,
      "end_codepoint": 120,
      "reading": "國寶遣袁悅之經支妙音傳書給陳淑媛；太子是德宗，其母為陳氏。",
      "note": "國寶遣袁悅之經支妙音傳書給陳淑媛；太子是德宗，其母為陳氏。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line092:received_sentence-120",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line092",
      "source_quote": "帝知之，托以他罪殺悅之。",
      "start_codepoint": 120,
      "end_codepoint": 132,
      "reading": "孝武帝以他罪殺袁悅之。",
      "note": "孝武帝以他罪殺袁悅之。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line092:received_sentence-132",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line092",
      "source_quote": "國寶大懼，遂因道子譖毀寧，寧由是出為豫章太守。",
      "start_codepoint": 132,
      "end_codepoint": 155,
      "reading": "國寶借道子毀范寧，寧出守豫章。",
      "note": "國寶借道子毀范寧，寧出守豫章。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line092:received_sentence-155",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line092",
      "source_quote": "及弟忱卒，國寶自表求解職迎母。",
      "start_codepoint": 155,
      "end_codepoint": 170,
      "reading": "弟忱卒，國寶求去職迎母。",
      "note": "弟忱卒，國寶求去職迎母。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line092:received_sentence-170",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line092",
      "source_quote": "並奔忱喪。",
      "start_codepoint": 170,
      "end_codepoint": 175,
      "reading": "接上文請求，擬奔弟喪。",
      "note": "接上文請求，擬奔弟喪。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line092:received_sentence-175",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line092",
      "source_quote": "詔特賜假，而盤桓不時進發，為御史中丞褚粲所奏。",
      "start_codepoint": 175,
      "end_codepoint": 198,
      "reading": "獲准假後滯留，褚粲彈奏。",
      "note": "獲准假後滯留，褚粲彈奏。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line092:received_sentence-198",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line092",
      "source_quote": "國寶懼罪，衣女子衣，托為王家婢，詣道子告其事。",
      "start_codepoint": 198,
      "end_codepoint": 221,
      "reading": "女衣、王家婢是國寶自為裝束。",
      "note": "女衣、王家婢是國寶自為裝束。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line092:received_sentence-221",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line092",
      "source_quote": "道子言之於帝，故得原。",
      "start_codepoint": 221,
      "end_codepoint": 232,
      "reading": "道子向孝武帝進言，國寶得免。",
      "note": "道子向孝武帝進言，國寶得免。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line092:received_sentence-232",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line092",
      "source_quote": "後驃騎參軍王徽請國寶同宴，國寶素驕貴使酒，怒尚書左丞祖台之，攘袂大呼，以盤盞樂器擲台之，台之不敢言，復為粲所彈。",
      "start_codepoint": 232,
      "end_codepoint": 288,
      "reading": "驃騎參軍王徽設宴，國寶以器物擲祖台之，褚粲彈之。",
      "note": "驃騎參軍王徽設宴，國寶以器物擲祖台之，褚粲彈之。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line092:received_sentence-288",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line092",
      "source_quote": "詔以國寶縱肆情性，甚不可長，台之懦弱，非監司體，並坐免官。",
      "start_codepoint": 288,
      "end_codepoint": 317,
      "reading": "國寶與祖台之各有免官原因。",
      "note": "國寶與祖台之各有免官原因。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line092:received_sentence-317",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line092",
      "source_quote": "頃之，復職，愈驕蹇不遵法度。",
      "start_codepoint": 317,
      "end_codepoint": 331,
      "reading": "國寶後復職。",
      "note": "國寶後復職。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line092:received_sentence-331",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line092",
      "source_quote": "起齋侔清暑殿，帝惡其僭侈。",
      "start_codepoint": 331,
      "end_codepoint": 344,
      "reading": "國寶齋比清暑殿，帝惡其僭侈。",
      "note": "國寶齋比清暑殿，帝惡其僭侈。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line092:received_sentence-344",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line092",
      "source_quote": "國寶懼，遂諂媚於帝，而頗疏道子。",
      "start_codepoint": 344,
      "end_codepoint": 360,
      "reading": "國寶轉而親孝武帝、疏道子。",
      "note": "國寶轉而親孝武帝、疏道子。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line092:received_sentence-360",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line092",
      "source_quote": "道子大怒，嘗於內省面責國寶，以劍擲之，舊好盡矣。",
      "start_codepoint": 360,
      "end_codepoint": 384,
      "reading": "道子在內省責國寶、以劍擲之。",
      "note": "道子在內省責國寶、以劍擲之。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line094:received_sentence-0",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line094",
      "source_quote": "是時王雅亦有寵，薦王珣於帝。",
      "start_codepoint": 0,
      "end_codepoint": 14,
      "reading": "王雅薦王珣於孝武帝。",
      "note": "王雅薦王珣於孝武帝。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line094:received_sentence-14",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line094",
      "source_quote": "帝夜與國寶及雅宴，帝微有酒，令召珣，將至，國寶自知才出珣下，恐至，傾其寵，因曰：「王珣當今名流，不可以酒色見。」",
      "start_codepoint": 14,
      "end_codepoint": 70,
      "reading": "夜飲時國寶恐見奪寵，以酒色為辭阻王珣入見。",
      "note": "夜飲時國寶恐見奪寵，以酒色為辭阻王珣入見。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line094:received_sentence-70",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line094",
      "source_quote": "帝遂止，而以國寶為忠。",
      "start_codepoint": 70,
      "end_codepoint": 81,
      "reading": "帝以國寶為忠。",
      "note": "帝以國寶為忠。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line094:received_sentence-81",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line094",
      "source_quote": "將納國寶女為琅邪王妃，未婚，而帝崩。",
      "start_codepoint": 81,
      "end_codepoint": 99,
      "reading": "國寶女原擬配琅邪王，孝武帝崩時未婚。當時琅邪王是皇子司馬德文。",
      "note": "國寶女原擬配琅邪王，孝武帝崩時未婚。當時琅邪王是皇子司馬德文。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line096:received_sentence-0",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line096",
      "source_quote": "安帝即位，國寶復事道子，進從祖弟緒為琅邪內史，亦以佞邪見知。",
      "start_codepoint": 0,
      "end_codepoint": 30,
      "reading": "晉安帝即位，國寶復親道子，從祖弟緒為琅邪內史。",
      "note": "晉安帝即位，國寶復親道子，從祖弟緒為琅邪內史。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line096:received_sentence-30",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line096",
      "source_quote": "道子復惑之，倚為心腹，並為時之所疾。",
      "start_codepoint": 30,
      "end_codepoint": 48,
      "reading": "道子倚之，時人疾之。",
      "note": "道子倚之，時人疾之。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line096:received_sentence-48",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line096",
      "source_quote": "國寶遂參管朝權，威震內外。",
      "start_codepoint": 48,
      "end_codepoint": 61,
      "reading": "國寶參朝權。",
      "note": "國寶參朝權。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line096:received_sentence-61",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line096",
      "source_quote": "遷尚書左僕射。",
      "start_codepoint": 61,
      "end_codepoint": 68,
      "reading": "遷尚書左僕射，安帝紀另繫隆安元年正月。",
      "note": "遷尚書左僕射，安帝紀另繫隆安元年正月。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line096:received_sentence-68",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line096",
      "source_quote": "領選，加後將軍、丹陽尹，道子悉以東宮兵配之。",
      "start_codepoint": 68,
      "end_codepoint": 90,
      "reading": "領選、加後將軍及丹陽尹，道子並配以東宮兵。",
      "note": "領選、加後將軍及丹陽尹，道子並配以東宮兵。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line098:received_sentence-0",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line098",
      "source_quote": "時王恭與殷仲堪並以才器，各居名籓。",
      "start_codepoint": 0,
      "end_codepoint": 17,
      "reading": "王恭、殷仲堪各居名藩。",
      "note": "王恭、殷仲堪各居名藩。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line098:received_sentence-17",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line098",
      "source_quote": "恭惡道子、國寶亂政，屢有憂國之言。",
      "start_codepoint": 17,
      "end_codepoint": 34,
      "reading": "王恭言道子與國寶亂政。",
      "note": "王恭言道子與國寶亂政。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line098:received_sentence-34",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line098",
      "source_quote": "道子等亦深忌憚之，將謀去其兵。",
      "start_codepoint": 34,
      "end_codepoint": 49,
      "reading": "道子等擬去其兵。",
      "note": "道子等擬去其兵。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line098:received_sentence-49",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line098",
      "source_quote": "未及行，而恭檄至，以討國寶為名，國寶惶遽不知所為。",
      "start_codepoint": 49,
      "end_codepoint": 74,
      "reading": "王恭已檄討國寶。",
      "note": "王恭已檄討國寶。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line098:received_sentence-74",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line098",
      "source_quote": "緒說國寶，令矯道子命，召王珣、車胤殺之，以除群望，因挾主相以討諸侯。",
      "start_codepoint": 74,
      "end_codepoint": 108,
      "reading": "王緒勸國寶矯命殺王珣、車胤，挾主相討諸侯。",
      "note": "王緒勸國寶矯命殺王珣、車胤，挾主相討諸侯。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line098:received_sentence-108",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line098",
      "source_quote": "國寶許之。",
      "start_codepoint": 108,
      "end_codepoint": 113,
      "reading": "國寶一度許之。",
      "note": "國寶一度許之。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line098:received_sentence-113",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line098",
      "source_quote": "珣、胤既至，而不敢害，反問計於珣。",
      "start_codepoint": 113,
      "end_codepoint": 130,
      "reading": "珣、胤至，國寶改問計。",
      "note": "珣、胤至，國寶改問計。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line098:received_sentence-130",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line098",
      "source_quote": "珣勸國寶放兵權以迎恭，國寶信之。",
      "start_codepoint": 130,
      "end_codepoint": 146,
      "reading": "王珣勸放兵權迎王恭。",
      "note": "王珣勸放兵權迎王恭。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line098:received_sentence-146",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line098",
      "source_quote": "語在《珣傳》。",
      "start_codepoint": 146,
      "end_codepoint": 153,
      "reading": "本書卷六十五王珣傳另敘，彼傳亦回指國寶傳。",
      "note": "本書卷六十五王珣傳另敘，彼傳亦回指國寶傳。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line098:received_sentence-153",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line098",
      "source_quote": "又問計於胤，胤曰：「南北同舉，而荊州未至，若朝廷遣軍，恭必城守。",
      "start_codepoint": 153,
      "end_codepoint": 185,
      "reading": "車胤答，朝廷遣軍則王恭守城。",
      "note": "車胤答，朝廷遣軍則王恭守城。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line098:received_sentence-185",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line098",
      "source_quote": "昔桓公圍壽陽，彌時乃克。",
      "start_codepoint": 185,
      "end_codepoint": 197,
      "reading": "車胤引桓溫昔圍壽陽。",
      "note": "車胤引桓溫昔圍壽陽。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line098:received_sentence-197",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line098",
      "source_quote": "若京城未拔，而上流奄至，君將何以待之？」",
      "start_codepoint": 197,
      "end_codepoint": 217,
      "reading": "車胤以城未拔、上流至設問，君指國寶。",
      "note": "車胤以城未拔、上流至設問，君指國寶。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line098:received_sentence-217",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line098",
      "source_quote": "國寶尤懼，遂上疏解職，詣闕待罪。",
      "start_codepoint": 217,
      "end_codepoint": 233,
      "reading": "國寶上疏解職，詣闕待罪。",
      "note": "國寶上疏解職，詣闕待罪。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line098:received_sentence-233",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line098",
      "source_quote": "既而悔之，祚稱詔復其本官，欲收其兵距王恭。",
      "start_codepoint": 233,
      "end_codepoint": 254,
      "reading": "後悔而假稱詔復官，武英及四庫均為詐稱。",
      "note": "後悔而假稱詔復官，武英及四庫均為詐稱。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line100:received_sentence-0",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line100",
      "source_quote": "道子既不能距諸侯，欲委罪國寶，乃遣譙王尚之收國寶，付廷尉，賜死，並斬緒於市。",
      "start_codepoint": 0,
      "end_codepoint": 38,
      "reading": "道子遣司馬尚之收國寶，廷尉賜死，另斬王緒於市。",
      "note": "道子遣司馬尚之收國寶，廷尉賜死，另斬王緒於市。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line100:received_sentence-38",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line100",
      "source_quote": "以謝王恭。",
      "start_codepoint": 38,
      "end_codepoint": 43,
      "reading": "以二人之死謝王恭。",
      "note": "以二人之死謝王恭。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line100:received_sentence-43",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAC",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line100",
      "source_quote": "國寶貪縱聚斂，不知紀極，後房伎妾以百數，天下珍玩充滿其室。",
      "start_codepoint": 43,
