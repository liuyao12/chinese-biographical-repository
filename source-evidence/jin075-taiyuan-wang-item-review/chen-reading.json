  "cases": [
    {
      "id": "c-jinshu-075-taiyuan-wang:line103:received_sentence-0",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAD",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line103",
      "source_quote": "忱字元達。",
      "start_codepoint": 0,
      "end_codepoint": 5,
      "reading": "字元達。",
      "note": "字元達。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line103:received_sentence-5",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAD",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line103",
      "source_quote": "弱冠知名，與王恭、王珣俱流譽一時。",
      "start_codepoint": 5,
      "end_codepoint": 22,
      "reading": "弱冠知名，與王恭及王珣齊譽。",
      "note": "弱冠知名，與王恭及王珣齊譽。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line103:received_sentence-22",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAD",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line103",
      "source_quote": "歷位驃騎長史。",
      "start_codepoint": 22,
      "end_codepoint": 29,
      "reading": "歷驃騎長史。",
      "note": "歷驃騎長史。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line103:received_sentence-29",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAD",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line103",
      "source_quote": "嘗造其舅范寧，與張玄相遇，寧使與玄語。",
      "start_codepoint": 29,
      "end_codepoint": 48,
      "reading": "忱到舅范寧處，遇張玄。",
      "note": "忱到舅范寧處，遇張玄。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line103:received_sentence-48",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAD",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line103",
      "source_quote": "玄正坐斂衽，待其有發，忱竟不與言，玄失望便去。",
      "start_codepoint": 48,
      "end_codepoint": 71,
      "reading": "張玄等忱先開口，等不到便走。",
      "note": "張玄等忱先開口，等不到便走。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line103:received_sentence-71",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAD",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line103",
      "source_quote": "寧讓忱曰：「張玄，吳中之秀，何不與語？」",
      "start_codepoint": 71,
      "end_codepoint": 91,
      "reading": "范寧以張玄為吳中之秀，責甥。",
      "note": "范寧以張玄為吳中之秀，責甥。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line103:received_sentence-91",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAD",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line103",
      "source_quote": "忱笑曰：「張祖希欲相識，自可見詣。」",
      "start_codepoint": 91,
      "end_codepoint": 109,
      "reading": "忱稱張玄為張祖希，稱其可自行來訪。",
      "note": "忱稱張玄為張祖希，稱其可自行來訪。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line103:received_sentence-109",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAD",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line103",
      "source_quote": "寧謂曰：「卿風流雋望，真後來之秀。」",
      "start_codepoint": 109,
      "end_codepoint": 127,
      "reading": "范寧以卿稱忱。",
      "note": "范寧以卿稱忱。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line103:received_sentence-127",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAD",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line103",
      "source_quote": "忱曰：「不有此舅，焉有此甥！」",
      "start_codepoint": 127,
      "end_codepoint": 142,
      "reading": "忱對舅自稱甥。",
      "note": "忱對舅自稱甥。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line103:received_sentence-142",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAD",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line103",
      "source_quote": "既而寧使報玄，玄束帶造之，始為賓主。",
      "start_codepoint": 142,
      "end_codepoint": 160,
      "reading": "張玄束帶拜訪王忱，兩人遂交。",
      "note": "張玄束帶拜訪王忱，兩人遂交。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line105:received_sentence-0",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAD",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line105",
      "source_quote": "太元中，出為荊州刺史、都督荊益寧三州軍事、建武將軍、假節。",
      "start_codepoint": 0,
      "end_codepoint": 29,
      "reading": "太元中授荊州刺史、三州都督、建武將軍，假節。",
      "note": "太元中授荊州刺史、三州都督、建武將軍，假節。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line105:received_sentence-29",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAD",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line105",
      "source_quote": "忱自恃才氣，放酒誕節，慕王澄之為人，又年少居方伯之任，談者憂之。",
      "start_codepoint": 29,
      "end_codepoint": 61,
      "reading": "忱慕王澄任達，本文未加字、籍、世系以辨同名。",
      "note": "忱慕王澄任達，本文未加字、籍、世系以辨同名。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line105:received_sentence-61",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAD",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line105",
      "source_quote": "及鎮荊州，威風肅然，殊得物和。",
      "start_codepoint": 61,
      "end_codepoint": 76,
      "reading": "到任後治荊州有威，物和。",
      "note": "到任後治荊州有威，物和。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line105:received_sentence-76",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAD",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line105",
      "source_quote": "桓玄時在江陵，既其本國。",
      "start_codepoint": 76,
      "end_codepoint": 88,
      "reading": "桓玄在江陵，本國指桓玄封國。",
      "note": "桓玄在江陵，本國指桓玄封國。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line105:received_sentence-88",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAD",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line105",
      "source_quote": "且奕葉故義，常以才雄駕物。",
      "start_codepoint": 88,
      "end_codepoint": 101,
      "reading": "桓氏累代故舊，桓玄恃才。",
      "note": "桓氏累代故舊，桓玄恃才。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line105:received_sentence-101",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAD",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line105",
      "source_quote": "忱每裁抑之。",
      "start_codepoint": 101,
      "end_codepoint": 107,
      "reading": "王忱對桓玄有所抑制。",
      "note": "王忱對桓玄有所抑制。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line105:received_sentence-107",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAD",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line105",
      "source_quote": "玄嘗詣忱，通人未出，乘轝直進。",
      "start_codepoint": 107,
      "end_codepoint": 122,
      "reading": "桓玄到訪，未經通報而進。",
      "note": "桓玄到訪，未經通報而進。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line105:received_sentence-122",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAD",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line105",
      "source_quote": "忱對玄鞭門幹，玄怒，去之，忱亦不留。",
      "start_codepoint": 122,
      "end_codepoint": 140,
      "reading": "忱鞭守門吏，桓玄怒而去。",
      "note": "忱鞭守門吏，桓玄怒而去。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line105:received_sentence-140",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAD",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line105",
      "source_quote": "嘗朔日見客，仗衛甚盛，玄言欲獵，借數百人，忱悉給之。",
      "start_codepoint": 140,
      "end_codepoint": 166,
      "reading": "朔日桓玄借數百人出獵，王忱給予。",
      "note": "朔日桓玄借數百人出獵，王忱給予。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line105:received_sentence-166",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAD",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line105",
      "source_quote": "玄憚而服焉。",
      "start_codepoint": 166,
      "end_codepoint": 172,
      "reading": "桓玄遂敬服王忱。",
      "note": "桓玄遂敬服王忱。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line107:received_sentence-0",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAD",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line107",
      "source_quote": "性任達不拘，末年尤嗜酒，一飲連月不醒，或裸體而遊，每歡三日不歎，便覺形神不相親。",
      "start_codepoint": 0,
      "end_codepoint": 40,
