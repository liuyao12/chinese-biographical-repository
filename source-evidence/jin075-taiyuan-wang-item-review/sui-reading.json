  "cases": [
    {
      "id": "c-jinshu-075-taiyuan-wang:line110:received_sentence-0",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAABA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line110",
      "source_quote": "綏字彥猷。",
      "start_codepoint": 0,
      "end_codepoint": 5,
      "reading": "字彥猷。",
      "note": "字彥猷。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line110:received_sentence-5",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAABA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line110",
      "source_quote": "少有美稱，厚自矜邁，實鄙而無行。",
      "start_codepoint": 5,
      "end_codepoint": 21,
      "reading": "少有美名，史家另評其矜尚。",
      "note": "少有美名，史家另評其矜尚。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line110:received_sentence-21",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAABA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line110",
      "source_quote": "愉為殷、桓所捕，綏未測存亡，在都有憂色，居處飲食，每事貶降，時人每謂為「試守孝子」。",
      "start_codepoint": 21,
      "end_codepoint": 63,
      "reading": "父王愉被殷仲堪、桓玄所捕，綏在都而懼，人稱試守孝子。",
      "note": "父王愉被殷仲堪、桓玄所捕，綏在都而懼，人稱試守孝子。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line110:received_sentence-63",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAABA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line110",
      "source_quote": "桓玄之為太尉，綏以桓氏甥甚見寵待，為太尉右長史。",
      "start_codepoint": 63,
      "end_codepoint": 87,
      "reading": "桓氏甥是母族稱謂，桓玄喜綏，任太尉右長史；不能據此判桓玄即舅父。",
      "note": "桓氏甥是母族稱謂，桓玄喜綏，任太尉右長史；不能據此判桓玄即舅父。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line110:received_sentence-87",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAABA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line110",
      "source_quote": "及玄篡，遷中書令。",
      "start_codepoint": 87,
      "end_codepoint": 96,
      "reading": "玄篡位之時任中書令。",
      "note": "玄篡位之時任中書令。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line110:received_sentence-96",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAABA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line110",
      "source_quote": "劉裕建義，以為冠軍將軍。",
      "start_codepoint": 96,
      "end_codepoint": 108,
      "reading": "劉裕起兵時綏任冠軍將軍。",
      "note": "劉裕起兵時綏任冠軍將軍。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line110:received_sentence-108",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAABA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line110",
      "source_quote": "其家夜中梁上無故有人頭墮於床，而流血滂沲。",
      "start_codepoint": 108,
      "end_codepoint": 129,
      "reading": "其家人頭墮床是史傳所記異象，無可定名者。",
      "note": "其家人頭墮床是史傳所記異象，無可定名者。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line110:received_sentence-129",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAABA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line110",
      "source_quote": "俄拜荊州刺史、假節。",
      "start_codepoint": 129,
      "end_codepoint": 139,
      "reading": "拜荊州刺史、假節。",
      "note": "拜荊州刺史、假節。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line110:received_sentence-139",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAABA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line110",
      "source_quote": "坐父愉之謀，與弟納並被誅。",
      "start_codepoint": 139,
      "end_codepoint": 152,
      "reading": "王綏坐父王愉事，與弟王納同被誅。",
      "note": "王綏坐父王愉事，與弟王納同被誅。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line112:received_sentence-0",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAABA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line112",
      "source_quote": "初，綏與王謐、桓胤齊名，為後進之秀。",
      "start_codepoint": 0,
      "end_codepoint": 18,
      "reading": "王綏、王謐、桓胤一時齊名。",
      "note": "王綏、王謐、桓胤一時齊名。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line112:received_sentence-18",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAABA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line112",
      "source_quote": "謐位官既極，保身而終。",
      "start_codepoint": 18,
      "end_codepoint": 29,
      "reading": "王謐官位極而身終。",
      "note": "王謐官位極而身終。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line112:received_sentence-29",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAABA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line112",
      "source_quote": "胤以從坐誅，聲稱猶全。",
      "start_codepoint": 29,
      "end_codepoint": 40,
      "reading": "桓胤因牽連被殺，與綏不同案。",
      "note": "桓胤因牽連被殺，與綏不同案。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line112:received_sentence-40",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAABA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line112",
      "source_quote": "綏身死，名論殆盡，亦以薄行矜峭而尚人故也。",
      "start_codepoint": 40,
      "end_codepoint": 61,
      "reading": "綏死後遭鄙議。",
      "note": "綏死後遭鄙議。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line112:received_sentence-61",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAABA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line112",
      "source_quote": "自昶父漢雁門太守澤已有名稱，忱又秀出，綏亦著稱，八葉繼軌，軒冕莫與為比焉。",
      "start_codepoint": 61,
      "end_codepoint": 98,
      "reading": "史稱從王澤至王綏八葉，王忱旁支亦受稱，不將忱當綏父。",
      "note": "史稱從王澤至王綏八葉，王忱旁支亦受稱，不將忱當綏父。",
      "human_reviewed": false
    },
    {
