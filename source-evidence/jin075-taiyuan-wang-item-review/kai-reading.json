      "source_quote": "愷字茂仁，",
      "start_codepoint": 0,
      "end_codepoint": 5,
      "reading": "王愷字茂仁，原題與弟愉合敘。",
      "note": "王愷字茂仁，原題與弟愉合敘。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line083:received_sentence-16",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line083",
      "source_quote": "愷襲父爵，",
      "start_codepoint": 16,
      "end_codepoint": 21,
      "reading": "王愷襲父王坦之之爵。",
      "note": "王愷襲父王坦之之爵。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line083:received_sentence-35",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line083",
      "source_quote": "愷太元末為侍中，領右衛將軍，多所獻替。",
      "start_codepoint": 35,
      "end_codepoint": 54,
      "reading": "太元末為侍中、右衛將軍，參預諫議。",
      "note": "太元末為侍中、右衛將軍，參預諫議。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line083:received_sentence-54",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line083",
      "source_quote": "兄弟貴盛，當時莫比。",
      "start_codepoint": 54,
      "end_codepoint": 64,
      "reading": "王愷與王愉地位皆顯。",
      "note": "王愷與王愉地位皆顯。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line085:received_sentence-0",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line085",
      "source_quote": "及王恭等討國寶，愷、愉並請解職。",
      "start_codepoint": 0,
      "end_codepoint": 16,
      "reading": "王恭舉兵時，愷、愉同請解職。",
      "note": "王恭舉兵時，愷、愉同請解職。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line085:received_sentence-16",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line085",
      "source_quote": "以與國寶異生，又素不協，故得免禍。",
      "start_codepoint": 16,
      "end_codepoint": 33,
      "reading": "稱與國寶異生，且先不合，二人得免。",
      "note": "稱與國寶異生，且先不合，二人得免。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line085:received_sentence-33",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line085",
      "source_quote": "國寶既死，出愷為吳郡內史，",
      "start_codepoint": 33,
      "end_codepoint": 46,
      "reading": "國寶死後王愷出為吳郡內史。",
      "note": "國寶死後王愷出為吳郡內史。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line085:received_sentence-68",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line085",
      "source_quote": "未幾，征愷為丹陽尹。",
      "start_codepoint": 68,
      "end_codepoint": 78,
      "reading": "王愷又任丹陽尹。",
      "note": "王愷又任丹陽尹。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line085:received_sentence-78",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line085",
      "source_quote": "及桓玄等至江寧，愷令兵守石頭。",
      "start_codepoint": 78,
      "end_codepoint": 93,
      "reading": "桓玄等抵江寧，愷命兵守石頭，殿本有石城異文。",
      "note": "桓玄等抵江寧，愷命兵守石頭，殿本有石城異文。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line085:received_sentence-93",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line085",
      "source_quote": "俄而玄等走，復為吳郡。",
      "start_codepoint": 93,
      "end_codepoint": 104,
      "reading": "玄等退，王愷復任吳郡。",
      "note": "玄等退，王愷復任吳郡。",
      "human_reviewed": false
    },
    {
      "id": "c-jinshu-075-taiyuan-wang:line085:received_sentence-104",
      "kind": "received_sentence",
      "person_id": "a8f_ec8_e74_AAAAAA",
      "paragraph_id": "c-jinshu-075-taiyuan-wang:line085",
      "source_quote": "病卒，追贈太常。",
      "start_codepoint": 104,
      "end_codepoint": 112,
      "reading": "病卒、追贈太常。",
      "note": "病卒、追贈太常。",
