  "source_clauses": [
    {
      "witness": "sg",
      "quote": "蔡伯喈從朔方還，嘗避怨於呉，雍從學琴書。",
      "raw_start": 4226,
      "raw_end": 4246,
      "raw_line": 40
    },
    {
      "witness": "sg",
      "quote": "吴录曰：雍字元叹，言为蔡雍之所叹",
      "raw_start": 4306,
      "raw_end": 4322,
      "raw_line": 40
    },
    {
      "witness": "sg",
      "quote": "江表传曰：灌常令中书郎诣雍",
      "raw_start": 4757,
      "raw_end": 4770,
      "raw_line": 42
    },
    {
      "witness": "sg",
      "quote": "其所選用文武將吏各隨能所任，心無適莫。",
      "raw_start": 4597,
      "raw_end": 4616,
      "raw_line": 42
    },
    {
      "witness": "sg47",
      "quote": "六月，以太常[[w:顧雍|顧雍]]爲丞相。",
      "raw_start": 12385,
      "raw_end": 12406,
      "raw_line": 65
    },
    {
      "witness": "sg47",
      "quote": "冬十一月，丞相顧雍卒。",
      "raw_start": 21993,
      "raw_end": 22004,
      "raw_line": 119
    },
    {
      "witness": "sg58",
      "quote": "陸遜字伯言",
      "raw_start": 185,
      "raw_end": 190,
      "raw_line": 11
    },
    {
      "witness": "sg61",
      "quote": "潘濬字承明，武陵漢壽人也。",
      "raw_start": 190,
      "raw_end": 203,
      "raw_line": 12
    },
    {
      "witness": "sg61",
      "quote": "時校事呂壹操弄威柄，奏按丞相顧雍、左將軍朱據等",
      "raw_start": 1434,
      "raw_end": 1457,
      "raw_line": 16
    },
    {
      "witness": "hh60b",
      "quote": "蔡邕字伯喈，陳留圉人也。",
      "raw_start": 158,
      "raw_end": 170,
      "raw_line": 11
    },
    {
      "witness": "hh60b",
      "quote": "乃亡命江海，遠跡吳會。",
      "raw_start": 14760,
      "raw_end": 14771,
      "raw_line": 81
    },
    {
      "witness": "hh18",
      "quote": "吳漢字子顏，南陽宛人也。",
      "raw_start": 70,
      "raw_end": 82,
      "raw_line": 4
    },
    {
      "witness": "litan",
      "quote": "及其喪也，曾點倚其門而歌。",
      "raw_start": 342,
      "raw_end": 355,
      "raw_line": 10
    },
    {
      "witness": "zuozhao",
      "quote": "秋，鄭公孫黑將作亂，欲去游氏而代其位，傷疾作而不果",
      "raw_start": 6035,
      "raw_end": 6060,
      "raw_line": 68
    },
    {
      "witness": "zuozhao",
      "quote": "不速死，司寇將至。",
      "raw_start": 6280,
      "raw_end": 6289,
      "raw_line": 68
    },
    {
      "witness": "zuozhao",
      "quote": "七月，壬寅，縊，尸諸周氏之衢，加木焉。",
      "raw_start": 6292,
      "raw_end": 6311,
      "raw_line": 70
    }
  ],
