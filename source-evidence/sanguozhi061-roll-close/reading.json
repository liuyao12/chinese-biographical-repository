      "quote": "丞相遜族子也",
      "raw_start": 1923,
      "raw_end": 1929,
      "raw_line": 21
    },
    {
      "witness": "w61",
      "quote": "濬姨兄零陵蒋琬",
      "raw_start": 1330,
      "raw_end": 1337,
      "raw_line": 14
    },
    {
      "witness": "w61",
      "quote": "臣年已六十九",
      "raw_start": 6622,
      "raw_end": 6628,
      "raw_line": 63
    },
    {
      "witness": "w61",
      "quote": "時年七十二",
      "raw_start": 3888,
      "raw_end": 3893,
      "raw_line": 42
    },
    {
      "witness": "w61",
      "quote": "虛實難明",
      "raw_start": 4439,
      "raw_end": 4443,
      "raw_line": 48
    },
    {
      "witness": "w61",
      "quote": "與從兄禕俱徙建安",
      "raw_start": 8085,
      "raw_end": 8093,
      "raw_line": 72
    },
    {
      "witness": "w61",
      "quote": "胤率，子式嗣",
      "raw_start": 8056,
      "raw_end": 8062,
      "raw_line": 72
    },
    {
      "witness": "w61",
      "quote": "濬女配建昌侯孫慮",
      "raw_start": 1730,
      "raw_end": 1738,
      "raw_line": 18
    },
    {
      "witness": "w38",
      "quote": "南陽宋仲子于荊州與蜀郡太守王商書曰",
      "raw_start": 2112,
      "raw_end": 2129,
      "raw_line": 24
    },
    {
      "witness": "w38",
      "quote": "荊州牧劉表及儒者宋忠咸聞其名",
      "raw_start": 2377,
      "raw_end": 2391,
      "raw_line": 24
    },
    {
      "witness": "w44",
      "quote": "蔣琬字公琰，零陵湘鄉人也。",
      "raw_start": 195,
      "raw_end": 208,
      "raw_line": 12
    },
    {
      "witness": "w57",
      "quote": "若乃北海郑玄，南阳宋忠",
      "raw_start": 3903,
      "raw_end": 3914,
      "raw_line": 27
    },
    {
      "witness": "w59",
      "quote": "孫慮字子智，登弟也。",
      "raw_start": 2578,
      "raw_end": 2588,
      "raw_line": 25
    },
    {
      "witness": "w54",
      "quote": "瑜兩男一女，女配太子登。",
      "raw_start": 4585,
      "raw_end": 4597,
      "raw_line": 33
    },
    {
      "witness": "shiwen",
      "quote": "字仲子南陽章陵人後漢荆州五業從事",
      "raw_start": 5923,
