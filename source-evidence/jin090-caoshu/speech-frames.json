[
  {
    "paragraph_id": "c-jinshu-090-caoshu:p001",
    "speech_anchor": {
      "paragraph_id": "c-jinshu-090-caoshu:p001",
      "start": 153,
      "end": 182,
      "surface": "「卿等不幸致此非所，如何？新歲人情所重，豈不欲暫見家邪？」"
    },
    "speaker_person_id": "h7n_w5t_i1c_AAA*A",
    "recipient_person_id": null,
    "group_or_unspecified_speaker": false,
    "group_or_unspecified_recipient": true,
    "qualification": "攄問死囚群，卿等不配單人",
    "human_reviewed": false
  },
  {
    "paragraph_id": "c-jinshu-090-caoshu:p001",
    "speech_anchor": {
      "paragraph_id": "c-jinshu-090-caoshu:p001",
      "start": 189,
      "end": 201,
      "surface": "「若得暫歸，死無恨也。」"
    },
    "speaker_person_id": null,
    "recipient_person_id": "h7n_w5t_i1c_AAA*A",
    "group_or_unspecified_speaker": true,
    "group_or_unspecified_recipient": false,
    "qualification": "死囚群答攄，死無恨不是已死",
    "human_reviewed": false
  },
  {
    "paragraph_id": "c-jinshu-090-caoshu:p001",
    "speech_anchor": {
      "paragraph_id": "c-jinshu-090-caoshu:p001",
      "start": 226,
      "end": 245,
      "surface": "「此雖小人，義不見負，自為諸君任之。」"
    },
    "speaker_person_id": "h7n_w5t_i1c_AAA*A",
    "recipient_person_id": null,
    "group_or_unspecified_speaker": false,
    "group_or_unspecified_recipient": true,
    "qualification": "攄向掾吏保證，小人為囚群非個人名",
    "human_reviewed": false
  },
  {
    "paragraph_id": "c-jinshu-090-caoshu:p001",
    "speech_anchor": {
      "paragraph_id": "c-jinshu-090-caoshu:p001",
      "start": 328,
      "end": 351,
      "surface": "「宮掖禁嚴，非外人所敢盜，必是門士以燎寒耳。」"
    },
    "speaker_person_id": "h7n_w5t_i1c_AAA*A",
    "recipient_person_id": null,
    "group_or_unspecified_speaker": false,
    "group_or_unspecified_recipient": true,
    "qualification": "攄說明門士推論，非自指外人",
    "human_reviewed": false
  },
  {
    "paragraph_id": "c-jinshu-090-caoshu:p002",
    "speech_anchor": {
      "paragraph_id": "c-jinshu-090-caoshu:p002",
      "start": 25,
      "end": 75,
      "surface": "「天子為賊臣所逼，莫有能奮。吾率四海義兵興復王室，今入輔朝廷，匡振時艱，或有勸吾還國，於卿意如何？」"
    },
    "speaker_person_id": "ee0_b2a_68e",
    "recipient_person_id": "h7n_w5t_i1c_AAA*A",
    "group_or_unspecified_speaker": false,
    "group_or_unspecified_recipient": false,
    "qualification": "冏自稱吾，卿為攄，天子為晉惠帝",
    "human_reviewed": false
  },
  {
    "paragraph_id": "c-jinshu-090-caoshu:p002",
    "speech_anchor": {
      "paragraph_id": "c-jinshu-090-caoshu:p002",
      "start": 78,
      "end": 196,
      "surface": "「蕩平國賊，匡復帝祚，古今人臣之功未有如大王之盛也。然道罔隆而不殺，物無盛而不衰，非唯人事，抑亦天理。竊預下問，敢不盡情。願大王居高慮危，在盈思沖，精選百官，存公屏欲，舉賢進善，務得其才，然後脂車秣馬，高揖歸籓，則上下同慶，攄等幸甚。」"
    },
    "speaker_person_id": "h7n_w5t_i1c_AAA*A",
    "recipient_person_id": "ee0_b2a_68e",
    "group_or_unspecified_speaker": false,
    "group_or_unspecified_recipient": false,
    "qualification": "攄答冏，大王為冏，不是曹攄或惠帝",
    "human_reviewed": false
  }
]
