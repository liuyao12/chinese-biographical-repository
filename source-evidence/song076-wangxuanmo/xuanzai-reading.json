      "kind": "received_sentence",
      "person_id": "85g_yq3_0w6_AA",
      "source_quote": "玄載仕宋，位益州刺史。",
      "reading": "仕宋任益州。",
      "note": "仕宋任益州。",
      "paragraph_id": "c-nanshi-016-wangxuanzai:p001",
