      "kind": "received_sentence",
      "person_id": "85g_yq3_0w6_AA",
      "source_quote": "六年，卒，時年七十六。",
      "reading": "永明六年488卒，原報七十六。",
      "note": "永明六年488卒，原報七十六。",
      "paragraph_id": "c-nanqishu-027-wangxuanzai:p003",
      "start_codepoint": 142,
      "end_codepoint": 153,
      "human_reviewed": false
    },
