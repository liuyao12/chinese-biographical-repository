    },
    {
      "paragraph_id": "c-jinshu-079-xielang-family:phase6-line039",
      "start": 72,
      "end": 78,
      "surface": "時帝始親萬機",
      "quote": "時帝始親萬機",
      "kind": "annal",
      "source_status": "parallel_primary_annal",
      "earliest_historical_year": 376,
      "latest_historical_year": 376,
      "parallel": {
        "work": "晉書",
        "volume": "009",
        "oldid": 13021561,
        "year_heading": "===太元元年===",
        "line": 111,
        "raw": "　　{{YL|太元元年}}春正月壬寅朔，帝加元服，見于太廟。皇太后歸政。甲辰，大赦，改元。丙午，帝始臨朝。以征西將軍桓豁爲征西大將軍，領軍將軍郗愔爲鎮軍大將軍，中軍將軍桓沖爲車騎將軍，加尚書僕射謝安中書監、錄尚書事。甲子，謁建平等四陵。",
        "permalink": "https://zh.wikisource.org/w/index.php?oldid=13021561"
      },
      "id": "jin079-xiean-time-036"
    },
