      "human_reviewed": false
    },
    {
      "id": "c-liangshu-029-xiaojian-xiaoque:received_sentence4-18",
      "kind": "received_sentence",
      "person_id": "81y_7i5_frc_B",
      "source_quote": "後從景行，見天上飛鳶，羣虜爭射不中，確射之，應弦而落。",
      "reading": "出行見飛鳶，確獨射中。",
      "note": "出行見飛鳶，確獨射中。",
      "paragraph_id": "c-liangshu-029-xiaojian-xiaoque:p004",
      "start_codepoint": 18,
