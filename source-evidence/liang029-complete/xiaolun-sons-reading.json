      "human_reviewed": false
    },
    {
      "id": "c-liangshu-029-xiaojian-xiaoque:received_sentence4-45",
      "kind": "received_sentence",
      "person_id": "81y_7i5_frc_B",
      "source_quote": "賊徒忿嫉，咸勸除之。",
      "reading": "侯景部眾忌確而勸除。",
      "note": "侯景部眾忌確而勸除。",
      "paragraph_id": "c-liangshu-029-xiaojian-xiaoque:p004",
      "start_codepoint": 45,
      "end_codepoint": 55,
      "human_reviewed": false
    },
    {
