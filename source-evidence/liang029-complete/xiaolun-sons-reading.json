    },
    {
      "id": "c-liangshu-029-xiaojian-xiaoque:received_sentence3-118",
      "kind": "received_sentence",
      "person_id": "81y_7i5_frc_B",
      "source_quote": "攜王聞之，逼確使入，確猶不肯。",
      "reading": "攜王綸逼其入。",
      "note": "攜王綸逼其入。",
