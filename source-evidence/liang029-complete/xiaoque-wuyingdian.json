  "original_url": "https://upload.wikimedia.org/wikipedia/commons/d/d9/NLC892-411999017142-12700_%E4%BA%8C%E5%8D%81%E5%9B%9B%E5%8F%B2_%E7%AC%AC167%E5%86%8A.pdf",
  "pdf_bytes": 32277607,
  "pdf_sha1": "da8d8c56b85ece30acc6e06b15e0c3fd2f082af9",
  "pdf_sha256": "050ef6eab6fa10b4e4e0505e7f1e6a7e65a11b8b5640b70648901e589b25db0d",
  "column_order": "十上第五欄後半至十一上第七欄。",
  "columns": [
    {
      "pdf_page": 11,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 5,
      "text": "弟確字仲正少驍勇有文才大同二年"
    },
    {
      "pdf_page": 11,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 6,
      "text": "封為正階侯邑五百戶後徙封永安常在第中習騎射"
    },
    {
      "pdf_page": 11,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 7,
      "text": "學兵法時人皆以為狂左右或以進諫確曰聽吾為國"
    },
    {
      "pdf_page": 11,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 8,
      "text": "家破賊使汝知之除祕書丞太子中舍人鍾山之役確"
    },
    {
      "pdf_page": 11,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 9,
      "text": "苦戰所向披靡羣虜憚之確每臨陣對敵意氣詳贍帶"
    },
    {
      "pdf_page": 11,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 10,
      "text": "甲據鞍自朝及夕馳驟往反不以為勞諸將服其壯勇"
    },
    {
      "pdf_page": 12,
      "half": "右",
      "leaf": "十下",
      "column_from_right": 1,
      "text": "及侯景乞盟確在外慮為後患啓求召確入城詔乃召"
    },
    {
      "pdf_page": 12,
      "half": "右",
      "leaf": "十下",
      "column_from_right": 2,
      "text": "確為南中郎將廣州刺史增封二千戶確知此盟多貳"
    },
    {
      "pdf_page": 12,
      "half": "右",
      "leaf": "十下",
      "column_from_right": 3,
      "text": "城必淪沒因欲南奔攜王聞之逼確使入確猶不肯攜"
    },
    {
      "pdf_page": 12,
      "half": "右",
      "leaf": "十下",
      "column_from_right": 4,
      "text": "王流涕謂曰汝欲反邪時臺使周石珍在坐確謂石珍"
    },
    {
      "pdf_page": 12,
      "half": "右",
      "leaf": "十下",
      "column_from_right": 5,
      "text": "曰侯景雖云欲去而不解長圍以意而推其事可見今"
    },
    {
      "pdf_page": 12,
      "half": "右",
      "leaf": "十下",
      "column_from_right": 6,
      "text": "召我入未見其益也石珍曰敕旨如此侯豈得辭確執"
    },
    {
      "pdf_page": 12,
      "half": "右",
      "leaf": "十下",
      "column_from_right": 7,
      "text": "意猶堅攜王大怒謂趙伯超曰譙州卿為我斬之當賚"
    },
    {
      "pdf_page": 12,
      "half": "右",
      "leaf": "十下",
      "column_from_right": 8,
      "text": "首赴闕伯超揮刃眄確曰我識君耳刀豈識君確於是"
    },
    {
      "pdf_page": 12,
      "half": "右",
      "leaf": "十下",
      "column_from_right": 9,
      "text": "流涕而出遂入城及景背盟復圍城城陷確排闥入啓"
    },
    {
      "pdf_page": 12,
      "half": "右",
      "leaf": "十下",
      "column_from_right": 10,
      "text": "高祖曰城已陷矣高祖曰猶可一戰不對曰不可臣向"
    },
    {
      "pdf_page": 12,
      "half": "左",
      "leaf": "十一上",
      "column_from_right": 1,
      "text": "者親格戰勢不能禁自縋下城僅得至此高祖歎曰自"
    },
    {
      "pdf_page": 12,
      "half": "左",
      "leaf": "十一上",
      "column_from_right": 2,
      "text": "我得之自我失之亦復何恨乃使確為慰勞文確既出"
    },
    {
      "pdf_page": 12,
      "half": "左",
      "leaf": "十一上",
      "column_from_right": 3,
      "text": "見景景愛其膂力恒令在左右後從景行見天上飛鳶"
    },
    {
      "pdf_page": 12,
      "half": "左",
      "leaf": "十一上",
      "column_from_right": 4,
      "text": "羣虜爭射不中確射之應弦而落賊徒忿嫉咸勸除之"
    },
    {
      "pdf_page": 12,
      "half": "左",
      "leaf": "十一上",
      "column_from_right": 5,
      "text": "先是攜王遣人密導確確謂使者曰侯景輕佻可一夫"
    },
    {
      "pdf_page": 12,
      "half": "左",
      "leaf": "十一上",
      "column_from_right": 6,
      "text": "力致確不惜死正欲手刃之但未得其便耳卿還啓家"
    },
    {
      "pdf_page": 12,
      "half": "左",
      "leaf": "十一上",
      "column_from_right": 7,
      "text": "王願勿以為念也事未遂而為賊所害"
    }
  ],
  "comparisons": [
    {
      "locator": "十一上第五至七欄",
      "printed": "先是攜王遣人密導確",
