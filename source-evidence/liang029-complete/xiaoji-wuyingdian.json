  "column_order": "一上第九欄至二上第五欄前半。",
  "columns": [
    {
      "pdf_page": 2,
      "half": "左",
      "leaf": "一上",
      "column_from_right": 9,
      "text": "南康簡王績字世謹高祖第四子天監八年封南康郡"
    },
    {
      "pdf_page": 2,
      "half": "左",
      "leaf": "一上",
      "column_from_right": 10,
      "text": "王邑二千戶出為輕車將軍領石頭戍軍事十年遷使"
    },
    {
      "pdf_page": 3,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 1,
      "text": "持節都督南徐州諸軍事南徐州刺史進號仁威將軍"
    },
    {
      "pdf_page": 3,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 2,
      "text": "績時年七歲主者有受貨洗改解書長史王僧孺弗之"
    },
    {
      "pdf_page": 3,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 3,
      "text": "覺績見而輒詰之便即時首服衆咸歎其聰警十六年"
    },
    {
      "pdf_page": 3,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 4,
      "text": "徵為宣毅將軍領石頭戍軍事十七年出為使持節都"
    },
    {
      "pdf_page": 3,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 5,
      "text": "督南北兗徐青冀五州諸軍事南兗州刺史在州著稱"
    },
    {
      "pdf_page": 3,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 6,
      "text": "尋有詔徵還民曹嘉樂等三百七十人詣闕上表稱績"
    },
    {
      "pdf_page": 3,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 7,
      "text": "尤異一十五條乞留州任優詔許之進號北中郎將普"
    },
    {
      "pdf_page": 3,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 8,
      "text": "通四年徵為侍中雲麾將軍領石頭戍軍事五年出為"
    },
    {
      "pdf_page": 3,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 9,
      "text": "使持節都督江州諸軍事江州刺史丁董淑儀憂居喪"
    },
    {
      "pdf_page": 3,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 10,
      "text": "過禮高祖手詔勉之使攝州任固求解職乃徵授安右"
    },
    {
      "pdf_page": 3,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 1,
      "text": "將軍領石頭戍軍事尋加護軍羸瘠弗堪視事大通三"
    },
    {
      "pdf_page": 3,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 2,
      "text": "年因感病薨于任時年二十五贈侍中中軍將軍開府"
    },
    {
      "pdf_page": 3,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 3,
      "text": "儀同三司給鼓吹一部諡曰簡績寡玩好少嗜慾居無"
    },
    {
      "pdf_page": 3,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 4,
      "text": "僕妾躬事約儉所有租秩悉寄天府及薨後府有南康"
    },
    {
      "pdf_page": 3,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 5,
      "text": "國無名錢數千萬"
    }
  ],
  "comparisons": [
