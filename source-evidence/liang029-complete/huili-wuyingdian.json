  "pdf_bytes": 32277607,
  "pdf_sha1": "da8d8c56b85ece30acc6e06b15e0c3fd2f082af9",
  "pdf_sha256": "050ef6eab6fa10b4e4e0505e7f1e6a7e65a11b8b5640b70648901e589b25db0d",
  "column_order": "二上第五欄後半至三上第八欄前半。",
  "columns": [
    {
      "pdf_page": 3,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 5,
      "text": "子會理嗣字長才少聰慧好文史年"
    },
    {
      "pdf_page": 3,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 6,
      "text": "十一而孤特為高祖所愛衣服禮秩與正王不殊年十"
    },
    {
      "pdf_page": 3,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 7,
      "text": "五拜輕車將軍湘州刺史又領石頭戍軍事遷侍中兼"
    },
    {
      "pdf_page": 3,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 8,
      "text": "領軍將軍尋除宣惠將軍丹陽尹置佐史出為使持節"
    },
    {
      "pdf_page": 3,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 9,
      "text": "都督南北兗北徐青冀東徐譙七州諸軍事平北將軍"
    },
    {
      "pdf_page": 3,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 10,
      "text": "南兗州刺史太清元年督衆軍北討至彭城為魏師所"
    },
    {
      "pdf_page": 4,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 1,
      "text": "敗退歸本鎭二年侯景圍京邑會理治嚴將入援會北"
    },
    {
      "pdf_page": 4,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 2,
      "text": "徐州刺史封山侯正表將應其兄正徳外託赴援實謀"
    },
    {
      "pdf_page": 4,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 3,
      "text": "襲廣陵會理擊破之方得進路臺城陷侯景遣前臨江"
    },
    {
      "pdf_page": 4,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 4,
      "text": "太守董紹先以高祖手敕召會理其僚佐咸勸距之會"
    },
    {
      "pdf_page": 4,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 5,
      "text": "理曰諸君心事與我不同天子年尊受制賊虜今有手"
    },
    {
      "pdf_page": 4,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 6,
      "text": "敕召我入朝臣子之心豈得違背且遠處江北功業難"
    },
    {
      "pdf_page": 4,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 7,
      "text": "成不若身赴京都圖之肘腋吾計決矣遂席卷而行以"
    },
    {
      "pdf_page": 4,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 8,
      "text": "城輸紹先至京景以為侍中司空兼中書令雖在寇手"
    },
    {
      "pdf_page": 4,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 9,
      "text": "每思匡復與西鄉侯勸等潛布腹心要結壯士時范陽"
    },
    {
      "pdf_page": 4,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 10,
      "text": "祖皓斬紹先據廣陵城起義期以會理為內應皓敗辭"
    },
    {
      "pdf_page": 4,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 1,
      "text": "相連及景矯詔免會理官猶以白衣領尚書令是冬景"
    },
    {
      "pdf_page": 4,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 2,
      "text": "往晉熙京師虛弱會理復與柳敬禮謀之敬禮曰舉大"
    },
    {
      "pdf_page": 4,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 3,
      "text": "事必有所資今無寸兵安有以動會理曰湖熟有吾舊"
    },
    {
      "pdf_page": 4,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 4,
      "text": "兵三千餘人昨來相知克期響集聽吾日定便至京師"
    },
    {
      "pdf_page": 4,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 5,
      "text": "計賊守兵不過千人耳若大兵外攻吾等內應直取王"
    },
    {
      "pdf_page": 4,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 6,
      "text": "偉事必有成縱景後歸無能為也敬禮曰善因贊成之"
    },
    {
      "pdf_page": 4,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 7,
      "text": "于時百姓厭賊咸思用命自丹陽至于京口靡不同之"
    },
    {
      "pdf_page": 4,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 8,
      "text": "後事不果與弟祈陽侯通理並遇害"
    }
  ],
  "comparisons": [
    {
      "locator": "三上第二欄",
      "printed": "京師虛弱",
      "digital": "景師虛弱",
      "note": "南史作都下虛弱。"
    },
    {
