{
  "edition": "清乾隆四年武英殿刻《二十四史》第一百六十七冊《梁書》，中國國家圖書館藏",
  "book_id": "NLC892-411999017142-12700",
  "catalogue_revision": 1129416299,
  "permalink": "https://commons.wikimedia.org/w/index.php?oldid=1129416299",
  "original_url": "https://upload.wikimedia.org/wikipedia/commons/d/d9/NLC892-411999017142-12700_%E4%BA%8C%E5%8D%81%E5%9B%9B%E5%8F%B2_%E7%AC%AC167%E5%86%8A.pdf",
  "pdf_bytes": 32277607,
  "pdf_sha1": "da8d8c56b85ece30acc6e06b15e0c3fd2f082af9",
  "pdf_sha256": "050ef6eab6fa10b4e4e0505e7f1e6a7e65a11b8b5640b70648901e589b25db0d",
  "column_order": "五上第六欄至九下第十欄「諡曰攜」。",
  "columns": [
    {
      "pdf_page": 6,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 6,
      "text": "邵陵攜王綸字世調高祖第六子也少聰穎博學善屬"
    },
    {
      "pdf_page": 6,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 7,
      "text": "文尤工尺牘天監十三年封邵陵郡王邑二千戶出為"
    },
    {
      "pdf_page": 6,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 8,
      "text": "寧遠將軍琅邪彭城二郡太守遷輕車將軍會稽太守"
    },
    {
      "pdf_page": 6,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 9,
      "text": "十八年徵為信威將軍普通元年領石頭戍軍事尋為"
    },
    {
      "pdf_page": 6,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 10,
      "text": "江州刺史五年以西中郎將權攝南兗州坐事免官奪"
    },
    {
      "pdf_page": 7,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 1,
      "text": "爵七年拜侍中大通元年復封爵尋加信威將軍置佐"
    },
    {
      "pdf_page": 7,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 2,
      "text": "史中大通元年為丹陽尹四年為侍中宣惠將軍揚州"
    },
    {
      "pdf_page": 7,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 3,
      "text": "刺史以侵漁細民少府丞何智通以事啓聞綸知之令"
    },
    {
      "pdf_page": 7,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 4,
      "text": "客戴子高於都巷刺殺之智通子訴于闕下高祖令圍"
    },
    {
      "pdf_page": 7,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 5,
      "text": "綸第捕子高綸匿之竟不出坐免為庶人頃之復封爵"
    },
    {
      "pdf_page": 7,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 6,
      "text": "大同元年為侍中雲麾將軍七年出為使持節都督郢"
    },
    {
      "pdf_page": 7,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 7,
      "text": "定霍司四州諸軍事平西將軍郢州刺史遷為安前將"
    },
    {
      "pdf_page": 7,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 8,
      "text": "軍丹陽尹中大同元年出為鎮東將軍南徐州刺史太"
    },
    {
      "pdf_page": 7,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 9,
      "text": "清二年進位中衛將軍開府儀同三司侯景構逆加征"
    },
    {
      "pdf_page": 7,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 10,
      "text": "討大都督率衆討景將發高祖誡曰侯景小豎頗習行"
    },
    {
      "pdf_page": 7,
      "half": "左",
      "leaf": "六上",
      "column_from_right": 1,
      "text": "陣未可以一戰即殄當以歲月圖之綸次鍾離景已度"
    },
    {
      "pdf_page": 7,
      "half": "左",
      "leaf": "六上",
      "column_from_right": 2,
      "text": "采石綸乃晝夜兼道遊軍入赴濟江中流風起人馬溺"
    },
    {
      "pdf_page": 7,
      "half": "左",
      "leaf": "六上",
      "column_from_right": 3,
      "text": "者十一二遂率寧遠將軍西豐公大春新淦公大成等"
    },
    {
      "pdf_page": 7,
      "half": "左",
      "leaf": "六上",
      "column_from_right": 4,
      "text": "步騎三萬發自京口將軍趙伯超曰若從黃城大道必"
    },
    {
      "pdf_page": 7,
      "half": "左",
      "leaf": "六上",
      "column_from_right": 5,
      "text": "與賊遇不如徑路直指鍾山出其不意綸從之衆軍奄"
    },
    {
      "pdf_page": 7,
      "half": "左",
      "leaf": "六上",
      "column_from_right": 6,
      "text": "至賊徒大駭分為三道攻綸綸與戰大破之斬首千餘"
    },
    {
      "pdf_page": 7,
      "half": "左",
      "leaf": "六上",
      "column_from_right": 7,
      "text": "級翌日賊又來攻相持日晚賊稍引却安南侯駿以數"
    },
    {
      "pdf_page": 7,
      "half": "左",
      "leaf": "六上",
      "column_from_right": 8,
      "text": "十騎馳之賊回拒駿駿部亂賊因逼大軍軍遂潰綸至"
    },
    {
      "pdf_page": 7,
      "half": "左",
      "leaf": "六上",
      "column_from_right": 9,
      "text": "鍾山衆裁千人賊圍之戰又敗乃奔還京口三年春綸"
    },
    {
      "pdf_page": 7,
      "half": "左",
      "leaf": "六上",
      "column_from_right": 10,
      "text": "復與東揚州刺史大連等入援至于驃騎洲進位司空"
    },
    {
      "pdf_page": 8,
      "half": "右",
      "leaf": "六下",
      "column_from_right": 1,
      "text": "臺城陷奔禹穴大寶元年綸至郢州刺史南平王恪讓"
    },
    {
      "pdf_page": 8,
      "half": "右",
      "leaf": "六下",
      "column_from_right": 2,
      "text": "州於綸綸不受乃上綸為假黃鉞都督中外諸軍事綸"
    },
    {
      "pdf_page": 8,
      "half": "右",
      "leaf": "六下",
      "column_from_right": 3,
      "text": "於是置百官改廳事為正陽殿數有災怪綸甚惡之時"
    },
    {
      "pdf_page": 8,
      "half": "右",
      "leaf": "六下",
      "column_from_right": 4,
      "text": "元帝圍河東王譽於長沙既久內外斷絕綸聞其急欲"
    },
    {
      "pdf_page": 8,
      "half": "右",
      "leaf": "六下",
      "column_from_right": 5,
      "text": "往救之為軍糧不繼遂止乃與世祖書曰伏以先朝聖"
    },
    {
      "pdf_page": 8,
      "half": "右",
      "leaf": "六下",
      "column_from_right": 6,
      "text": "德孝治天下九親雍睦四表無怨誠為國政實亦家風"
    },
    {
      "pdf_page": 8,
      "half": "右",
      "leaf": "六下",
      "column_from_right": 7,
      "text": "唯余與爾同奉神訓宜敦旨喻共承無改且道之斯美"
    },
    {
      "pdf_page": 8,
      "half": "右",
      "leaf": "六下",
      "column_from_right": 8,
      "text": "以和為貴況天時地利不及人和豈可手足肱支自相"
    },
    {
      "pdf_page": 8,
      "half": "右",
      "leaf": "六下",
      "column_from_right": 9,
      "text": "屠害日者聞譽專情失訓以幼陵長湘峽之內遂至交"
    },
    {
      "pdf_page": 8,
      "half": "右",
      "leaf": "六下",
      "column_from_right": 10,
      "text": "鋒方等身遇亂兵斃於行陣殞于吳局方此非冤聞問"
    },
    {
      "pdf_page": 8,
      "half": "左",
      "leaf": "七上",
      "column_from_right": 1,
      "text": "號怛惟增摧憤念以兼悼當何可稱吾在州所居遙隔"
    },
    {
      "pdf_page": 8,
      "half": "左",
      "leaf": "七上",
      "column_from_right": 2,
      "text": "雖知其狀未喻所然及屆此藩備加覿訪咸云譽應接"
    },
    {
      "pdf_page": 8,
      "half": "左",
      "leaf": "七上",
      "column_from_right": 3,
      "text": "多替兵糧閉壅弟教亦不悛故興師以伐譽未識大體"
    },
    {
      "pdf_page": 8,
      "half": "左",
      "leaf": "七上",
      "column_from_right": 4,
      "text": "意斷所行雖存急難豈知竊思不能禮爭復以兵來蕭"
    },
    {
      "pdf_page": 8,
      "half": "左",
      "leaf": "七上",
      "column_from_right": 5,
      "text": "牆興變體親成敵一朝至此能不鳴呼既有書問雲雨"
    },
    {
      "pdf_page": 8,
      "half": "左",
      "leaf": "七上",
      "column_from_right": 6,
      "text": "傳流噂沓其間委悉無因詳究方今社稷危恥創巨痛"
    },
    {
      "pdf_page": 8,
      "half": "左",
      "leaf": "七上",
      "column_from_right": 7,
      "text": "深人非禽蟲在知君父即日大敵猶強天讎未雪余爾"
    },
    {
      "pdf_page": 8,
      "half": "左",
      "leaf": "七上",
      "column_from_right": 8,
      "text": "昆季在外三人如不匡難安用臣子唯應剖心嘗膽泣"
    },
    {
      "pdf_page": 8,
      "half": "左",
      "leaf": "七上",
      "column_from_right": 9,
      "text": "血枕戈感誓蒼穹憑靈宗祀晝謀夕計共思康復至於"
    },
    {
      "pdf_page": 8,
      "half": "左",
      "leaf": "七上",
      "column_from_right": 10,
      "text": "其餘小忿或宜寬貸誠復子憾須臾將奈國冤未逞正"
    },
    {
      "pdf_page": 9,
      "half": "右",
      "leaf": "七下",
      "column_from_right": 1,
      "text": "當輕重相推小大易奪遣無益之情割下流之悼弘豁"
    },
    {
      "pdf_page": 9,
      "half": "右",
      "leaf": "七下",
      "column_from_right": 2,
      "text": "以理通識勉之今已喪鍾山復誅猶子將非揚湯止沸"
    },
    {
      "pdf_page": 9,
      "half": "右",
      "leaf": "七下",
      "column_from_right": 3,
      "text": "吞冰療寒若以譽之無道近遠同疾弟復效尤攸非獨"
    },
    {
      "pdf_page": 9,
      "half": "右",
      "leaf": "七下",
      "column_from_right": 4,
      "text": "罪幸寬於衆議忍以事寧如使外寇未除家禍仍構料"
    },
    {
      "pdf_page": 9,
      "half": "右",
      "leaf": "七下",
      "column_from_right": 5,
      "text": "今訪古未或弗亡夫征戰之理義在克勝至於骨肉之"
    },
    {
      "pdf_page": 9,
      "half": "右",
      "leaf": "七下",
      "column_from_right": 6,
      "text": "戰愈勝愈酷捷則非功敗則有喪勞兵損義虧失多矣"
    },
    {
      "pdf_page": 9,
      "half": "右",
      "leaf": "七下",
      "column_from_right": 7,
      "text": "侯景之軍所以未窺江外者正為藩屏盤固宗鎮強密"
    },
    {
      "pdf_page": 9,
      "half": "右",
      "leaf": "七下",
      "column_from_right": 8,
      "text": "若自相魚肉是代景行師景便不勞兵力坐致成效醜"
    },
    {
      "pdf_page": 9,
      "half": "右",
      "leaf": "七下",
      "column_from_right": 9,
      "text": "徒聞此何快如之又莊鐵小豎作亂久挾觀寧懷安二"
    },
    {
      "pdf_page": 9,
      "half": "右",
      "leaf": "七下",
      "column_from_right": 10,
      "text": "侯以為名號當陽有事克掣殊廢備境第聞征伐復致"
    },
    {
      "pdf_page": 9,
      "half": "左",
      "leaf": "八上",
      "column_from_right": 1,
      "text": "分兵便是自於瓜州至于湘雍莫非戰地悉以勞師侯"
    },
    {
      "pdf_page": 9,
      "half": "左",
      "leaf": "八上",
      "column_from_right": 2,
      "text": "景卒承虛藉釁浮江豕突豈不表裏成虞首尾難救可"
    },
    {
      "pdf_page": 9,
      "half": "左",
      "leaf": "八上",
      "column_from_right": 3,
      "text": "為寒心其事已切弟若苦陷洞庭兵戈不戢雍州疑迫"
    },
    {
      "pdf_page": 9,
      "half": "左",
      "leaf": "八上",
      "column_from_right": 4,
      "text": "何以自安必引進魏軍以求形援侯景事等內癰西秦"
    },
    {
      "pdf_page": 9,
      "half": "左",
      "leaf": "八上",
      "column_from_right": 5,
      "text": "外同瘤腫直置關中已為咽氣況復貪狼難測勢必侵"
    },
    {
      "pdf_page": 9,
      "half": "左",
      "leaf": "八上",
      "column_from_right": 6,
      "text": "吞弟若不安家國去矣吾非有深鑒獨能弘理正是採"
    },
    {
      "pdf_page": 9,
      "half": "左",
      "leaf": "八上",
      "column_from_right": 7,
      "text": "藉風謠博參物論咸以為疑皆欲解體故耳自我國五"
    },
    {
      "pdf_page": 9,
      "half": "左",
      "leaf": "八上",
      "column_from_right": 8,
      "text": "十許年恩格玄穹德彌赤縣雖有逆難未亂邕熙溥天"
    },
    {
      "pdf_page": 9,
      "half": "左",
      "leaf": "八上",
      "column_from_right": 9,
      "text": "率土忠臣憤慨比屋罹禍忠義奮發無不抱甲負戈衝"
    },
    {
      "pdf_page": 9,
      "half": "左",
      "leaf": "八上",
      "column_from_right": 10,
      "text": "冠裂眥咸欲剚刃於侯景腹中所須兵主唱耳今人皆"
    },
    {
      "pdf_page": 10,
      "half": "右",
      "leaf": "八下",
      "column_from_right": 1,
      "text": "樂死赴者如流弟英略振遠雄伯當代唯德唯藝資文"
    },
    {
      "pdf_page": 10,
      "half": "右",
      "leaf": "八下",
      "column_from_right": 2,
      "text": "資武拯溺濟難朝野咸屬一匡九合非弟而誰豈得自"
    },
    {
      "pdf_page": 10,
      "half": "右",
      "leaf": "八下",
      "column_from_right": 3,
      "text": "違物望致招羣讟其間患難具如所陳斯理皎然無勞"
    },
    {
      "pdf_page": 10,
      "half": "右",
      "leaf": "八下",
      "column_from_right": 4,
      "text": "請箸驗之以實寧須確引吾所以間關險道出自東川"
    },
    {
      "pdf_page": 10,
      "half": "右",
      "leaf": "八下",
      "column_from_right": 5,
      "text": "政謂上游諸藩必連師狎至庶以殘命預在行間及到"
    },
    {
      "pdf_page": 10,
      "half": "右",
      "leaf": "八下",
      "column_from_right": 6,
      "text": "九江安北兄遂泝流更上全由餼饋懸斷卒食半菽阻"
    },
    {
      "pdf_page": 10,
      "half": "右",
      "leaf": "八下",
      "column_from_right": 7,
      "text": "以菜色無因進取侯景方延假息復緩誅刑信增號憤"
    },
    {
      "pdf_page": 10,
      "half": "右",
      "leaf": "八下",
      "column_from_right": 8,
      "text": "啓處無地計瀟湘穀粟猶當紅委若阻弟嚴兵唯事交"
    },
    {
      "pdf_page": 10,
      "half": "右",
      "leaf": "八下",
      "column_from_right": 9,
      "text": "切至於運轉恐無暇發遣即日萬心慊望唯在民天若"
    },
    {
      "pdf_page": 10,
      "half": "右",
      "leaf": "八下",
      "column_from_right": 10,
      "text": "遂等西河時事殆矣必希令弟豁照茲途解汨川之圍"
    },
    {
      "pdf_page": 10,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 1,
      "text": "存社稷之計使其運輸糧儲應贍軍旅庶叶力一舉指"
    },
    {
      "pdf_page": 10,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 2,
      "text": "日寧泰宗廟重安天下清復推弟之功豈非幸甚吾才"
    },
    {
      "pdf_page": 10,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 3,
      "text": "懦兵寡安能為役所寄令弟庶得申情朝聞夕死萬殞"
    },
    {
      "pdf_page": 10,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 4,
      "text": "何恨聊陳聞見幸無怪焉臨紙號迷諸失次緒世祖復"
    },
    {
      "pdf_page": 10,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 5,
      "text": "書陳河東有罪不可解圍之狀綸省書流涕曰天下之"
    },
    {
      "pdf_page": 10,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 6,
      "text": "事一至於斯左右聞之莫不掩泣於是大修器甲將討"
    },
    {
      "pdf_page": 10,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 7,
      "text": "侯景元帝聞其彊盛乃遣王僧辯帥舟師一萬以逼綸"
    },
    {
      "pdf_page": 10,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 8,
      "text": "綸將劉龍武等降僧辯綸軍潰遂與子確等十餘人輕"
    },
    {
      "pdf_page": 10,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 9,
      "text": "舟走武昌時綸長史韋質司馬姜律先在于外聞綸敗"
    },
    {
      "pdf_page": 10,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 10,
      "text": "馳往迎之於是復收散卒屯于齊昌郡將引魏軍共攻"
    },
    {
      "pdf_page": 11,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 1,
      "text": "南陽侯景將任約聞之使鐵騎二百襲綸綸無備又敗"
    },
    {
      "pdf_page": 11,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 2,
      "text": "走定州定州刺史田龍祖迎綸綸以龍祖荊鎮所任懼"
    },
    {
      "pdf_page": 11,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 3,
      "text": "為所執復歸齊昌行至汝南西魏所署汝南城主李素"
    },
    {
      "pdf_page": 11,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 4,
      "text": "者綸之故吏聞綸敗開城納之綸乃修浚城池收集士"
    },
    {
      "pdf_page": 11,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 5,
      "text": "卒將攻竟陵西魏安州刺史馬岫聞之報于西魏西魏"
    },
    {
      "pdf_page": 11,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 6,
      "text": "遣大將軍楊忠儀同侯幾通率衆赴焉二年二月忠等"
    },
    {
      "pdf_page": 11,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 7,
      "text": "至于汝南綸嬰城自守會天寒大雪忠等攻之不能克"
    },
    {
      "pdf_page": 11,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 8,
      "text": "死者甚衆後李素中流矢卒城乃陷忠等執綸綸不為"
    },
    {
      "pdf_page": 11,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 9,
      "text": "屈遂害之投于江岸經日顏色不變鳥獸莫敢近焉時"
    },
    {
      "pdf_page": 11,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 10,
      "text": "年三十三百姓憐之為立祠廟後世祖追諡曰攜"
    }
  ],
