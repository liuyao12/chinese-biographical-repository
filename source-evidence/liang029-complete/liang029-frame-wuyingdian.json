  "column_order": "卷首一上第五至八欄；史臣評十一上第八至十二下第一欄；殿考證十二上第一至十欄及十三下第一至五欄。",
  "columns": [
    {
      "pdf_page": 2,
      "half": "左",
      "leaf": "一上",
      "column_from_right": 5,
      "text": "高祖八男丁貴嬪生昭明太子統太宗簡文皇帝廬陵"
    },
    {
      "pdf_page": 2,
      "half": "左",
      "leaf": "一上",
      "column_from_right": 6,
      "text": "威王續阮脩容生世祖孝元皇帝吳淑媛生豫章王綜"
    },
    {
      "pdf_page": 2,
      "half": "左",
      "leaf": "一上",
      "column_from_right": 7,
      "text": "董淑儀生南康簡王績丁充華生邵陵攜王綸葛脩容"
    },
    {
      "pdf_page": 2,
      "half": "左",
      "leaf": "一上",
      "column_from_right": 8,
      "text": "生武陵王紀綜及紀別有傳"
    },
    {
      "pdf_page": 12,
      "half": "左",
      "leaf": "十一上",
      "column_from_right": 8,
      "text": "史臣曰自周漢廣樹藩屏固本深根高祖之封建將遵"
    },
    {
      "pdf_page": 12,
      "half": "左",
      "leaf": "十一上",
      "column_from_right": 9,
      "text": "古制也南康廬陵並以宗室之貴據磐石之重績以孝"
    },
    {
      "pdf_page": 12,
      "half": "左",
      "leaf": "十一上",
      "column_from_right": 10,
      "text": "著續以勇聞綸聰警有才學性險躁屢以罪黜及太清"
    },
    {
      "pdf_page": 13,
      "half": "右",
      "leaf": "十一下",
      "column_from_right": 1,
      "text": "之亂忠孝獨存斯可嘉矣"
    },
    {
      "pdf_page": 13,
      "half": "左",
      "leaf": "十二上",
      "column_from_right": 1,
      "text": "梁書卷二十九考證"
    },
    {
      "pdf_page": 13,
      "half": "左",
      "leaf": "十二上",
      "column_from_right": 2,
      "text": "高祖三王傳董淑儀生南康簡王績○淑南史作昭"
    },
    {
      "pdf_page": 13,
      "half": "左",
      "leaf": "十二上",
      "column_from_right": 3,
      "text": "南康簡王績傳天監八年封南康郡王○八南史作七"
    },
    {
      "pdf_page": 13,
      "half": "左",
      "leaf": "十二上",
      "column_from_right": 4,
      "text": "臣人龍按高祖紀係天監七年九月事南史是也"
    },
    {
      "pdf_page": 13,
      "half": "左",
      "leaf": "十二上",
      "column_from_right": 5,
      "text": "民曹嘉樂等三百七十人詣闕上表○南史無嘉字"
    },
    {
      "pdf_page": 13,
      "half": "左",
      "leaf": "十二上",
      "column_from_right": 6,
      "text": "與弟祈陽侯通理並遇害乂理字季英會理第六弟也"
    },
    {
      "pdf_page": 13,
      "half": "左",
      "leaf": "十二上",
      "column_from_right": 7,
      "text": "○監本缺通字閣本訛乂為通臣人龍按南史通理"
    },
    {
      "pdf_page": 13,
      "half": "左",
      "leaf": "十二上",
      "column_from_right": 8,
      "text": "字仲宣今各補正之"
    },
    {
      "pdf_page": 13,
      "half": "左",
      "leaf": "十二上",
      "column_from_right": 9,
      "text": "封建安縣侯○建安南史作安樂"
    },
    {
      "pdf_page": 13,
      "half": "左",
      "leaf": "十二上",
      "column_from_right": 10,
      "text": "邵陵攜王綸傳權攝南兗州○南兗南史作南徐考本"
    },
    {
      "pdf_page": 14,
      "half": "右",
      "leaf": "十二下",
      "column_from_right": 1,
      "text": "紀不載兼攝事"
    },
    {
      "pdf_page": 14,
      "half": "右",
      "leaf": "十二下",
      "column_from_right": 2,
      "text": "綸軍潰遂與子確等十餘人輕舟走武昌○確南史作"
    },
    {
      "pdf_page": 14,
      "half": "右",
      "leaf": "十二下",
      "column_from_right": 3,
      "text": "躓"
    },
    {
      "pdf_page": 14,
      "half": "右",
      "leaf": "十二下",
      "column_from_right": 4,
      "text": "時綸長史韋質司馬姜律先在于外○律南史作偉"
    },
    {
      "pdf_page": 14,
      "half": "右",
      "leaf": "十二下",
      "column_from_right": 5,
      "text": "西魏所署汝南城主李素者○者南史作孝"
    }
  ],
