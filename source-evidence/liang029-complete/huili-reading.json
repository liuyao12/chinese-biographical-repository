      "kind": "received_sentence",
      "person_id": "fo7_f8v_rmf_CA",
      "source_quote": "少聰慧，好文史。",
      "reading": "少聰慧，好文史。",
      "note": "少聰慧，好文史。",
      "paragraph_id": "c-liangshu-029-huili-complete:p001",
