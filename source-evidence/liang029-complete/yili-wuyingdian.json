  "pdf_sha256": "050ef6eab6fa10b4e4e0505e7f1e6a7e65a11b8b5640b70648901e589b25db0d",
  "column_order": "三上第八欄後半至四上第八欄。",
  "columns": [
    {
      "pdf_page": 4,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 8,
      "text": "乂理字季英會理"
    },
    {
      "pdf_page": 4,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 9,
      "text": "第六弟也生十旬而簡王薨至三歲而能言見內人分"
    },
    {
      "pdf_page": 4,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 10,
      "text": "散涕泣相送乂理問其故或曰此簡王宮人喪畢去爾"
    },
    {
      "pdf_page": 5,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 1,
      "text": "乂理便號泣悲不自勝諸宮人見之莫不傷感為之停"
    },
    {
      "pdf_page": 5,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 2,
      "text": "者三人焉服闋後見高祖又悲泣不自勝高祖為之流"
    },
    {
      "pdf_page": 5,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 3,
      "text": "涕謂左右曰此兒大必為奇士大同八年封建安縣侯"
    },
    {
      "pdf_page": 5,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 4,
      "text": "邑五百戶乂理性慷慨慕立功名每讀書見忠臣烈士"
    },
    {
      "pdf_page": 5,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 5,
      "text": "未嘗不廢卷歎曰一生之內當無愧古人博覽多識有"
    },
    {
      "pdf_page": 5,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 6,
      "text": "文才嘗祭孔文舉墓并為立碑製文甚美太清中侯景"
    },
    {
      "pdf_page": 5,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 7,
      "text": "內寇乂理聚賓客數百輕裝赴南兗州隨兄會理入援"
    },
    {
      "pdf_page": 5,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 8,
      "text": "恒親當矢石為士卒先及城陷又隨會理還廣陵因入"
    },
    {
      "pdf_page": 5,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 9,
      "text": "齊為質乞師行二日會侯景遣董紹先據廣陵遂追會"
    },
    {
      "pdf_page": 5,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 10,
      "text": "理因為所獲紹先防之甚嚴不得與兄弟相見乃為請"
    },
    {
      "pdf_page": 5,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 1,
      "text": "先還京得入辭母謂其姊固安公主曰事既如此豈可"
    },
    {
      "pdf_page": 5,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 2,
      "text": "合家受斃兄若至願為言之善為計自勉勿顧以為念"
    },
    {
      "pdf_page": 5,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 3,
      "text": "也家國阽危雖死非恨前途亦思立效但未知天命何"
    },
    {
      "pdf_page": 5,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 4,
      "text": "如耳至京師以魏降人元貞立節忠正可以託孤乃以"
    },
    {
      "pdf_page": 5,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 5,
      "text": "玉柄扇贈之貞怪其故不受乂理曰後當見憶幸勿推"
    },
    {
      "pdf_page": 5,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 6,
      "text": "辭會祖皓起兵乂理奔長蘆收軍得千餘人其左右有"
    },
    {
      "pdf_page": 5,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 7,
      "text": "應賊者因間劫會理其衆遂駭散為景所害時年二十"
    },
    {
      "pdf_page": 5,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 8,
      "text": "一元貞始悟其前言往收葬焉"
    }
  ],
