  "pdf_sha256": "050ef6eab6fa10b4e4e0505e7f1e6a7e65a11b8b5640b70648901e589b25db0d",
  "column_order": "四上第九欄至五上第五欄。",
  "columns": [
    {
      "pdf_page": 5,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 9,
      "text": "廬陵威王續字世訢高祖第五子天監八年封廬陵郡"
    },
    {
      "pdf_page": 5,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 10,
      "text": "王邑二千戶十年拜輕車將軍南彭城琅邪太守十三"
    },
    {
      "pdf_page": 6,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 1,
      "text": "年轉會稽太守十六年為都督江州諸軍事雲麾將軍"
    },
    {
      "pdf_page": 6,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 2,
      "text": "江州刺史普通元年徵為宣毅將軍領石頭戍軍事續"
    },
    {
      "pdf_page": 6,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 3,
      "text": "少英果膂力絕人馳射游獵應發命中高祖常歎曰此"
    },
    {
      "pdf_page": 6,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 4,
      "text": "我之任城也嘗與臨賀王正徳及胡貴通趙伯超等馳"
    },
    {
      "pdf_page": 6,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 5,
      "text": "射於高祖前續冠於諸人高祖大悅三年為使持節都"
    },
    {
      "pdf_page": 6,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 6,
      "text": "督南徐梁秦沙四州諸軍事西中郎將南徐州刺史七"
    },
    {
      "pdf_page": 6,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 7,
      "text": "年加宣毅將軍中大通三年又為使持節都督雍梁秦"
    },
    {
      "pdf_page": 6,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 8,
      "text": "沙四州諸軍事平北將軍寧蠻校尉雍州刺史給鼓吹"
    },
    {
      "pdf_page": 6,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 9,
      "text": "一部續多聚馬仗蓄養驍雄金帛內盈倉廩外實四年"
    },
    {
      "pdf_page": 6,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 10,
      "text": "遷安北將軍大同元年為使持節都督江州諸軍事安"
    },
    {
      "pdf_page": 6,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 1,
      "text": "南將軍江州刺史三年徵為護軍將軍領石頭戍軍事"
    },
    {
      "pdf_page": 6,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 2,
      "text": "五年為驃騎將軍開府儀同三司又出為使持節都督"
    },
    {
      "pdf_page": 6,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 3,
      "text": "荊郢司雍西北秦梁巴華九州諸軍事荊州刺史中大"
    },
    {
      "pdf_page": 6,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 4,
      "text": "同二年薨於州時年四十四贈司空散騎常侍驃騎大"
    },
    {
      "pdf_page": 6,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 5,
      "text": "將軍鼓吹一部諡曰威長子安嗣"
    }
  ],
  "comparisons": [
    {
