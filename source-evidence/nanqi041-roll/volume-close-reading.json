  "readings": [
    {
      "id": "c-nanqishu-041-appraisal:source_review1-0",
      "kind": "source_review",
      "person_id": "vkd_5ff_i23",
      "source_quote": "　　史臣曰：弘毅存容，至仁表貌，汲黯剛戇，崔琰聲姿，然後能不憚雄桀，亟成譏犯。張融標心託旨，全等塵外，吐納風雲，不論人物，而干君會友，敦義納忠，誕不越檢，常在名教。若夫奇偉之稱，則虞飜、陸績不得獨擅於前也。",
      "reading": "蕭子顯答以張融言行之奇而不越名教，汲黯、崔琰、虞飜、陸績皆史臣舉例。",
      "note": "蕭子顯答以張融言行之奇而不越名教，汲黯、崔琰、虞飜、陸績皆史臣舉例。",
      "paragraph_id": "c-nanqishu-041-appraisal:p001",
      "start_codepoint": 0,
      "end_codepoint": 103,
      "human_reviewed": false
    },
    {
      "id": "c-nanqishu-041-appraisal:source_review2-0",
      "kind": "source_review",
      "person_id": "vkd_5ff_i23",
      "source_quote": "　　贊曰：思光矯矯，萬里千仞。升同應諧，黜同解擯。務在連衡，不謀銷印。彥倫辭辯，苦節清韻。白馬橫擒，雲梯獨振。",
      "reading": "贊用思光、彥倫稱張融、周顒。升、黜及白馬、雲梯是贊語，與推薦、任免的敘事層分別。",
      "note": "贊用思光、彥倫稱張融、周顒。升、黜及白馬、雲梯是贊語，與推薦、任免的敘事層分別。",
      "paragraph_id": "c-nanqishu-041-appraisal:p002",
      "start_codepoint": 0,
      "end_codepoint": 55,
      "human_reviewed": false
    }
  ],
