{
  "raw_sha256": "1a045e9d8ce38dbd568c45a4dec0bdb49326b2eb78c8243ab77a10c1ce0f2b95",
  "units": [
    {
      "key": "unit001",
      "layer": "received_chapter",
      "raw_window": [
        1,
        6
      ],
      "raw_runs": [
        {
          "raw_line": 1,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "劉粹字道沖沛郡蕭人也祖恢持節監河中軍事征虜"
        },
        {
          "raw_line": 2,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "將軍粹家在京口少有志幹初為州從事高祖克京城"
        },
        {
          "raw_line": 3,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "參建武軍事從平京邑轉參鎮軍事尋加建武將軍沛"
        },
        {
          "raw_line": 4,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "郡太守又領下邳太守復為車騎中軍參軍從征廣固"
        },
        {
          "raw_line": 5,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "戰功居多以義功封西安縣五等侯軍還轉中軍諮議"
        },
        {
          "raw_line": 6,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "參軍盧循逼京邑京口任重太祖時年四歲高祖使粹"
        }
      ],
      "text_sha256": "81bcfc53cb3599f35db40712715cce66838d23143c8153e9a2b8ae60e9db4d73"
    },
    {
      "key": "unit002",
      "layer": "received_chapter",
      "raw_window": [
        7,
        16
      ],
      "raw_runs": [
        {
          "raw_line": 7,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "奉太祖鎮京城轉游擊將軍遷建威將軍江夏相衞將"
        },
        {
          "raw_line": 8,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "軍毅粹族兄也粹盡心高祖不與毅同高祖欲謀毅衆"
        },
        {
          "raw_line": 9,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "並疑粹在夏口高祖愈信之及大軍至粹竭其誠力事"
        },
        {
          "raw_line": 10,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "平封灄縣男食邑五百戶母憂去職俄而高祖討司馬"
        },
        {
          "raw_line": 11,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "休之起粹為寧朔將軍竟陵太守統水軍入河明年進"
        },
        {
          "raw_line": 12,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "號輔國將軍遷相國右司馬侍中中軍司馬冠軍將軍"
        },
        {
          "raw_line": 13,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "還左衞將軍永初元年以佐命功改封建安縣侯食邑"
        },
        {
          "raw_line": 14,
          "raw_start": 0,
          "raw_end": 21,
          "start": 147,
          "end": 168,
          "surface": "千戶二年以役使監吏免官尋督江北淮南郡事征虜"
        },
        {
          "raw_line": 15,
          "raw_start": 0,
          "raw_end": 21,
          "start": 168,
          "end": 189,
          "surface": "將軍廣陵太守三年以本號督豫司雍并四州南豫州"
        },
        {
          "raw_line": 16,
          "raw_start": 0,
          "raw_end": 21,
          "start": 189,
          "end": 210,
          "surface": "之梁郡弋陽馬頭三郡諸軍事豫州刺史領梁郡太守"
        }
      ],
      "text_sha256": "78424fd8160c5b6164da8bb77ba5c2e03002710e2c2fe1712c4f77fa6fb290dc"
    },
    {
      "key": "unit003",
      "layer": "received_chapter",
      "raw_window": [
        17,
        26
      ],
      "raw_runs": [
        {
          "raw_line": 17,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "鎮壽陽治有政績少帝景平二年譙郡流離六十餘家"
        },
        {
          "raw_line": 18,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "叛沒虜趙見秦剛等六家悔倍還投陳留襄邑縣頓謀"
        },
        {
          "raw_line": 19,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "等村粹遣將苑縱夫討叛戶不及因誅殺謀等三十家"
        },
        {
          "raw_line": 20,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "男丁二百三十七人女弱一百六十二口收付作部粹"
        },
        {
          "raw_line": 21,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "坐貶號為寧朔將軍時索虜南寇粹遣將軍李德元襲"
        },
        {
          "raw_line": 22,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "許昌殺僞潁川太守庾龍於是陳留人董邈自稱小黃"
        },
        {
          "raw_line": 23,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "盟主斬僞征虜將軍廣州刺史司馬世賢傳首京都太"
        },
        {
          "raw_line": 24,
          "raw_start": 0,
          "raw_end": 21,
          "start": 147,
          "end": 168,
          "surface": "祖卽位遷使持節督雍梁南北秦四州荆州之南陽竟"
        },
        {
          "raw_line": 25,
          "raw_start": 0,
          "raw_end": 21,
          "start": 168,
          "end": 189,
          "surface": "陵順陽襄陽新野隨六郡諸軍事征虜將軍領寧蠻校"
        },
        {
          "raw_line": 26,
          "raw_start": 0,
          "raw_end": 21,
          "start": 189,
          "end": 210,
          "surface": "尉雍州刺史襄陽新野二郡太守在任簡役愛民罷諸"
        }
      ],
      "text_sha256": "e5da979f21e9f5e819e56a74f051f0fc68c0b58e5419fc26cea2fd37deb788c9"
    },
    {
      "key": "unit004",
      "layer": "received_chapter",
      "raw_window": [
        27,
        36
      ],
      "raw_runs": [
        {
          "raw_line": 27,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "沙門二千餘人以補府史元嘉二年討謝晦遣粹弟車"
        },
        {
          "raw_line": 28,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "騎從事中郎道濟龍驤將軍沈敞之就粹自陸道向江"
        },
        {
          "raw_line": 29,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "陵粹以道濟行竟陵內史與敞之及南陽太守沈道興"
        },
        {
          "raw_line": 30,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "步騎至沙橋為晦司馬周超所敗士衆傷死者過半降"
        },
        {
          "raw_line": 31,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "號寧朔將軍初晦與粹厚善以粹子曠之為參軍粹受"
        },
        {
          "raw_line": 32,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "命南討一無所顧太祖以此嘉之晦遣送曠之還粹亦"
        },
        {
          "raw_line": 33,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "不害也明年粹卒時年五十三追贈安北將軍持節本"
        },
        {
          "raw_line": 34,
          "raw_start": 0,
          "raw_end": 21,
          "start": 147,
          "end": 168,
          "surface": "官如故曠之嗣官至晉熙太守曠之卒子琛嗣琛卒無"
        },
        {
          "raw_line": 35,
          "raw_start": 0,
          "raw_end": 21,
          "start": 168,
          "end": 189,
          "surface": "子國除琛弟亮順帝昇明末尚書駕部郎粹庶長子懷"
        },
        {
          "raw_line": 36,
          "raw_start": 0,
          "raw_end": 21,
          "start": 189,
          "end": 210,
          "surface": "之為臨川內史與臧質同逆伏誅粹弟道濟尚書起部"
        }
      ],
      "text_sha256": "af27b00ffcca7a890443c0c236a3e238893889c5f62ec9687826704a849dff27"
    },
    {
      "key": "unit005",
      "layer": "received_chapter",
      "raw_window": [
        37,
        46
      ],
      "raw_runs": [
        {
          "raw_line": 37,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "郎王弘車騎從事中郎江夏王義恭撫軍司馬河東太"
        },
        {
          "raw_line": 38,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "守仍遷振武將軍益州刺史長史費謙別駕張熙參軍"
        },
        {
          "raw_line": 39,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "楊德年等並聚斂與利而道濟委任之傷政害民民皆"
        },
        {
          "raw_line": 40,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "怨毒太祖聞之與道濟詔戒之曰聞卿在任未盡清省"
        },
        {
          "raw_line": 41,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "又頗為殖貨若萬有一此必宜改之比傳人情不政〓"
        },
        {
          "raw_line": 42,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "諸當以法御下深思自警以副本望道濟雖奉此旨政"
        },
        {
          "raw_line": 43,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "化如初有司馬飛龍者自稱晉之宗室晉末走仇池元"
        },
        {
          "raw_line": 44,
          "raw_start": 0,
          "raw_end": 21,
          "start": 147,
          "end": 168,
          "surface": "嘉九年間道濟綏撫失和遂自仇池入緜竹煽動羣小"
        },
        {
          "raw_line": 45,
          "raw_start": 0,
          "raw_end": 21,
          "start": 168,
          "end": 189,
          "surface": "得千餘人破巴興縣殺令王貞之進攻陰平陰平太守"
        },
        {
          "raw_line": 46,
          "raw_start": 0,
          "raw_end": 21,
          "start": 189,
          "end": 210,
          "surface": "沈法興焚城遁走道濟遣軍擊飛龍斬之初道濟以五"
        }
      ],
      "text_sha256": "6c645614bcd1949e3784ca4b597ea3dd933e294f4442b755fd9c22b02d7c441a"
    },
    {
      "key": "unit006",
      "layer": "received_chapter",
      "raw_window": [
        47,
        56
      ],
      "raw_runs": [
        {
          "raw_line": 47,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "城人帛氏奴梁顯為參軍督護費謙固執不與遠方商"
        },
        {
          "raw_line": 48,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "人多至蜀土資貨或有直數百萬者謙等限布絲緜各"
        },
        {
          "raw_line": 49,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "不得過五十斤馬無善惡限蜀錢二萬府又立治一斷"
        },
        {
          "raw_line": 50,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "私民鼓鑄而貴賣鐵器商旅吁嗟百姓咸欲為亂氏奴"
        },
        {
          "raw_line": 51,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "旣懷恚忿因聚黨為賊盜其年七月道濟遣羅習為五"
        },
        {
          "raw_line": 52,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "城令氏奴等謀曰羅令是使君腹心而卿猶有作賊盜"
        },
        {
          "raw_line": 53,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "不止者一旦發露則為禍不測宜結要誓共相禁檢乃"
        },
        {
          "raw_line": 54,
          "raw_start": 0,
          "raw_end": 21,
          "start": 147,
          "end": 168,
          "surface": "殺牛盟誓俄而氏奴及趙廣等唱曰官禁殺牛而村中"
        },
        {
          "raw_line": 55,
          "raw_start": 0,
          "raw_end": 21,
          "start": 168,
          "end": 189,
          "surface": "公違法禁脫使羅令白使君錄吾徒更欲作賊則無餘"
        },
        {
          "raw_line": 56,
          "raw_start": 0,
          "raw_end": 21,
          "start": 189,
          "end": 210,
          "surface": "類矣因詐言司馬殿下猶在陽泉山中若能共建大事"
        }
      ],
      "text_sha256": "4b7bb09640a7c2f95a55a12c06890d69e6a23df5ab96855427cb1cc6f591695d"
    },
    {
      "key": "unit007",
      "layer": "received_chapter",
      "raw_window": [
        57,
        66
      ],
      "raw_runs": [
        {
          "raw_line": 57,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "則功名可立不然立滅不久衆旣樂亂因相率從之得"
        },
        {
          "raw_line": 58,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "數千人復向廣漢道濟遣參軍程展會治中李抗之五"
        },
        {
          "raw_line": 59,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "百人擊之並為所殺賊於是逕向涪城巴西人唐頻聚"
        },
        {
          "raw_line": 60,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "衆應之寧遠將軍巴西梓潼二郡太守王懷業再遣軍"
        },
        {
          "raw_line": 61,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "拒之戰敗失利懷業及司馬南漢中太守章處伯並棄"
        },
        {
          "raw_line": 62,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "城走涪陵太守阮惠江陽太守杜玄起遂寧太守馮遷"
        },
        {
          "raw_line": 63,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "聞涪城不守並委郡出奔蜀土僑舊翕然並反道濟惟"
        },
        {
          "raw_line": 64,
          "raw_start": 0,
          "raw_end": 21,
          "start": 147,
          "end": 168,
          "surface": "懼乃免吳兵三十六營以為平民分立宋興宋寧二郡"
        },
        {
          "raw_line": 65,
          "raw_start": 0,
          "raw_end": 21,
          "start": 168,
          "end": 189,
          "surface": "又招集商賈及免道俗奴僮東西勝兵可有四千人賊"
        },
        {
          "raw_line": 66,
          "raw_start": 0,
          "raw_end": 21,
          "start": 189,
          "end": 210,
          "surface": "衆數萬屯城西及城北道濟嬰城自守趙廣本以誑詐"
        }
      ],
      "text_sha256": "ae19fdd0496334b93efbf442246f1396f67ba66808449bdeab6df713489fd827"
    },
    {
      "key": "unit008",
      "layer": "received_chapter",
      "raw_window": [
        67,
        76
      ],
      "raw_runs": [
        {
          "raw_line": 67,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "聚兵頓兵城下不見飛龍各欲分散廣懼乃將三千人"
        },
        {
          "raw_line": 68,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "及羽儀許其衆云迎飛龍至陽泉寺中謂道人程道養"
        },
        {
          "raw_line": 69,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "曰但自言是飛龍則坐享富貴若不從卽日便斬頭道"
        },
        {
          "raw_line": 70,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "養惶怖許諾道養枹罕人也廣改名為龍興號為蜀王"
        },
        {
          "raw_line": 71,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "車騎大將軍益梁二州牧建號泰始元年備置百官以"
        },
        {
          "raw_line": 72,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "道養弟道助為驃騎將軍長沙王鎮涪城廣自號鎮軍"
        },
        {
          "raw_line": 73,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "帛氏奴征虜將軍梁顯鎮北將軍同黨大帥張尋泰州"
        },
        {
          "raw_line": 74,
          "raw_start": 0,
          "raw_end": 21,
          "start": 147,
          "end": 168,
          "surface": "刺史嚴遐前將軍奉道養還成都衆十餘萬四面圍城"
        },
        {
          "raw_line": 75,
          "raw_start": 0,
          "raw_end": 21,
          "start": 168,
          "end": 189,
          "surface": "就道濟索費謙張熙曰但送此人來我等自不復作賊"
        },
        {
          "raw_line": 76,
          "raw_start": 0,
          "raw_end": 21,
          "start": 189,
          "end": 210,
          "surface": "道濟遣中兵參軍裴方明任浪之各將千餘人出西門"
        }
      ],
      "text_sha256": "0239839edec5e39cd3139a9f11ec43ae972f3e9b9deb219a7e8f852f1a9bbc1d"
    },
    {
      "key": "unit009",
      "layer": "received_chapter",
      "raw_window": [
        77,
        86
      ],
      "raw_runs": [
        {
          "raw_line": 77,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "戰皆失利十一月方明等復出戰破賊營焚其積聚賊"
        },
        {
          "raw_line": 78,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "黨江陽人楊孟子領千餘人屯城南道濟參軍梁儁之"
        },
        {
          "raw_line": 79,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "統南樓屢與孟子交言因投書曉以禍福要使入城孟"
        },
        {
          "raw_line": 80,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "子許諾入見道濟道濟大喜卽板為主簿遣子為任克"
        },
        {
          "raw_line": 81,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "期討賊趙廣知其謀孟子懼將所領奔晉原晉原太守"
        },
        {
          "raw_line": 82,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "文仲興拾合得二千餘人與孟子并力自固廣遣同黨"
        },
        {
          "raw_line": 83,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "袁玄子攻晉原為仲興所殺廣又遣帛氏奴攻之連戰"
        },
        {
          "raw_line": 84,
          "raw_start": 0,
          "raw_end": 21,
          "start": 147,
          "end": 168,
          "surface": "仲興軍敗及孟子並死方明復出東門破賊三營斬首"
        },
        {
          "raw_line": 85,
          "raw_start": 0,
          "raw_end": 21,
          "start": 168,
          "end": 189,
          "surface": "數百級賊雖敗已復還合方明復僞出北門仍回軍擊"
        },
        {
          "raw_line": 86,
          "raw_start": 0,
          "raw_end": 21,
          "start": 189,
          "end": 210,
          "surface": "城東大營殺千餘人斬僞僕射蔡洽時天大霧方明等"
        }
      ],
      "text_sha256": "7b0df78aa474e92c00694a97a116fafdb114db180783216d3eeec1ae76072bd4"
    },
    {
      "key": "unit010",
      "layer": "received_chapter",
      "raw_window": [
        87,
        96
      ],
      "raw_runs": [
        {
          "raw_line": 87,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "獲揚聲出東門而潛自北門出攻城北城西諸營賊衆"
        },
        {
          "raw_line": 88,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "大潰於是奔散道養收合得七千人還廣漢趙廣以別"
        },
        {
          "raw_line": 89,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "卒五千餘人還涪城初別駕張熙說道濟令糶太倉穀"
        },
        {
          "raw_line": 90,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "賊以九月末圍城至十二月末廩米便盡方明將三千"
        },
        {
          "raw_line": 91,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "人出城求食為賊所敗匹馬獨還賊因追之衆復大集"
        },
        {
          "raw_line": 92,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "方明夜於城西縋上道濟為設食饋不能食唯泣涕而"
        },
        {
          "raw_line": 93,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "已道濟時有疾已篤曰力疾勉之曰卿非大丈夫小敗"
        },
        {
          "raw_line": 94,
          "raw_start": 0,
          "raw_end": 21,
          "start": 147,
          "end": 168,
          "surface": "何苦賊勢旣衰臺兵垂至但令卿還何憂於賊卽減左"
        },
        {
          "raw_line": 95,
          "raw_start": 0,
          "raw_end": 21,
          "start": 168,
          "end": 189,
          "surface": "右數十人配之賊城外云方明已死可來取喪城中大"
        },
        {
          "raw_line": 96,
          "raw_start": 0,
          "raw_end": 21,
          "start": 189,
          "end": 210,
          "surface": "恐道濟夜刈炬火方明自出衆見之乃安道濟悉出財"
        }
      ],
      "text_sha256": "26c9f5030289b0d9067b60b1e76daccc710857be1696e7da8815ad560ba2f273"
    },
    {
      "key": "unit011",
      "layer": "received_chapter",
      "raw_window": [
        97,
        106
      ],
      "raw_runs": [
        {
          "raw_line": 97,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "物於北射堂令方明募人時城中或傳道濟已凶莫有"
        },
        {
          "raw_line": 98,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "至者梁儁之說道濟曰將軍氣息綿綿而外論互有同"
        },
        {
          "raw_line": 99,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "異今軍師屢敗妖寇未殄若一旦不虞則危禍立至宜"
        },
        {
          "raw_line": 100,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "稱小損聽左右給使暫出不然敗矣道濟從之卽喚左"
        },
        {
          "raw_line": 101,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "右二十餘人告之曰吾疾久汝等扶侍疲勞今旣小損"
        },
        {
          "raw_line": 102,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "各聽歸家休息喚復還給使旣出其父兄皆問使君以"
        },
        {
          "raw_line": 103,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "來幾日子弟皆言君漸差誰言凶者傳相告語城內乃"
        },
        {
          "raw_line": 104,
          "raw_start": 0,
          "raw_end": 21,
          "start": 147,
          "end": 168,
          "surface": "安由是應募者十日千餘人十年正月賊衆大至攻逼"
        },
        {
          "raw_line": 105,
          "raw_start": 0,
          "raw_end": 21,
          "start": 168,
          "end": 189,
          "surface": "成都道濟卒梁儁之與方明等及其故舊門生數人共"
        },
        {
          "raw_line": 106,
          "raw_start": 0,
          "raw_end": 21,
          "start": 189,
          "end": 210,
          "surface": "埋尸於後齊使書與道濟相似者為教命酬答籤疏不"
        }
      ],
      "text_sha256": "e50f9775e2630b8d3a58b1feeb320f2129d709ff166a660f8a091e9f8921195c"
    },
    {
      "key": "unit012",
      "layer": "received_chapter",
      "raw_window": [
        107,
        116
      ],
      "raw_runs": [
        {
          "raw_line": 107,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "異常日故雖毋妻不知也二月道養於毀金橋升壇郊"
        },
        {
          "raw_line": 108,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "天方就柴燎方明將三千人出擊之賊列陣營前死戰"
        },
        {
          "raw_line": 109,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "日夕乃大敗臨陣斬僞征虜將軍趙石之等八百餘級"
        },
        {
          "raw_line": 110,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "道養等退保廣漢是月平西將軍臨川王義慶以揚武"
        },
        {
          "raw_line": 111,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "將軍巴東太守周籍之卽本號督巴西梓潼宕渠遂寧"
        },
        {
          "raw_line": 112,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "巴郡五郡諸軍事巴西梓潼二郡太守率平西參軍費"
        },
        {
          "raw_line": 113,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "淡龍驤將軍羅猛三千人援成都廣等屯據廣漢分守"
        },
        {
          "raw_line": 114,
          "raw_start": 0,
          "raw_end": 21,
          "start": 147,
          "end": 168,
          "surface": "郫川連營百數處處屯結籍之與方明及費淡等攻郫"
        },
        {
          "raw_line": 115,
          "raw_start": 0,
          "raw_end": 21,
          "start": 168,
          "end": 189,
          "surface": "剋之廣等退據郡城傍竹自固羅猛率隊主王昕等并"
        },
        {
          "raw_line": 116,
          "raw_start": 0,
          "raw_end": 21,
          "start": 189,
          "end": 210,
          "surface": "力追討張尋自涪城率衆二萬來助廣等方明淡斬竹"
        }
      ],
      "text_sha256": "b08c2f5bae1b4bcd0c80eba646dda076ec236fb0da4f9f654a2c636c7af00abf"
    },
    {
      "key": "unit013",
      "layer": "received_chapter",
      "raw_window": [
        117,
        126
      ],
      "raw_runs": [
        {
          "raw_line": 117,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "開逕邀之戰敗退還郫縣廣等又移營屯箭牽橋方明"
        },
        {
          "raw_line": 118,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "等破其六營乘勝追奔逕至廣漢廣等走還涪及五城"
        },
        {
          "raw_line": 119,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "四月十日發道濟喪五月方進軍向涪城張尋唐頻渡"
        },
        {
          "raw_line": 120,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "水拒戰方明擊破之生擒僞驃騎將軍雍秦二州刺史"
        },
        {
          "raw_line": 121,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "司馬龍伸斬之龍伸道助也州吏嚴道度斬嚴遐首廣"
        },
        {
          "raw_line": 122,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "等並奔散涪蜀皆平俄而張尋攻破陰平復與道養合"
        },
        {
          "raw_line": 123,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "帛氏奴攻廣漢費淡督將軍种松等與戰斬其梁州刺"
        },
        {
          "raw_line": 124,
          "raw_start": 0,
          "raw_end": 21,
          "start": 147,
          "end": 168,
          "surface": "史杜承等百餘級九月益州刺史甄法崇至成都誅費"
        },
        {
          "raw_line": 125,
          "raw_start": 0,
          "raw_end": 21,
          "start": 168,
          "end": 189,
          "surface": "謙之道濟喪及方明等並東反道養等領二千餘家逃"
        },
        {
          "raw_line": 126,
          "raw_start": 0,
          "raw_end": 21,
          "start": 189,
          "end": 210,
          "surface": "於郪山其餘羣賊亦各擁戶藏竄出為寇盜不絕十二"
        }
      ],
      "text_sha256": "6e05c096cd389e35e6d980f97ad2d74a2fca6086edcd5140f1e5817addf75e97"
    },
    {
      "key": "unit014",
      "layer": "received_chapter",
      "raw_window": [
        127,
        136
      ],
      "raw_runs": [
        {
          "raw_line": 127,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "年六月太祖遣寧朔將軍蕭汪之統軍討之軍次郪口"
        },
        {
          "raw_line": 128,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "帛氏奴斬僞衞將軍司馬飛燕歸降汪之擊破道養道"
        },
        {
          "raw_line": 129,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "養還入郪山十四年四月趙廣張尋梁顯各率部曲歸"
        },
        {
          "raw_line": 130,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "降僞輔國將軍王道恩斬道養送首餘黨悉平遷趙廣"
        },
        {
          "raw_line": 131,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "張尋等於京師十六年廣尋復與國山令司馬敬琳謀"
        },
        {
          "raw_line": 132,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "反伏誅先是道濟振武司馬蜀郡太守任薈之雖不任"
        },
        {
          "raw_line": 133,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "軍事事寧以為正員郎裴方明虎賁中郎將仍為義慶"
        },
        {
          "raw_line": 134,
          "raw_start": 0,
          "raw_end": 21,
          "start": 147,
          "end": 168,
          "surface": "平西中兵參軍龍驤將軍河東太守費淡太子屯騎校"
        },
        {
          "raw_line": 135,
          "raw_start": 0,
          "raw_end": 21,
          "start": 168,
          "end": 189,
          "surface": "尉周籍之後為益州刺史粹族弟損字子騫衞將軍毅"
        },
        {
          "raw_line": 136,
          "raw_start": 0,
          "raw_end": 21,
          "start": 189,
          "end": 210,
          "surface": "從父弟也父鎮之字仲德以毅貴歷顯位閑居京口未"
        }
      ],
      "text_sha256": "2e08523b3a9d36eaedf20e1070f691f5fdaa9201f92b217207caa5dd3fff1cee"
    },
    {
      "key": "unit015",
      "layer": "received_chapter",
      "raw_window": [
        137,
        141
      ],
      "raw_runs": [
        {
          "raw_line": 137,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "嘗應召常謂毅汝必破我家毅甚憚之每還京未嘗敢"
        },
        {
          "raw_line": 138,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "以羽儀人從入鎮之門左光祿大夫徵不就元嘉二年"
        },
        {
          "raw_line": 139,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "年九十餘卒於家損元嘉中歷職義興太守東土饑饉"
        },
        {
          "raw_line": 140,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "太祖遣揚州治中沈演之東入賑卹以損綏撫有方稱"
        },
        {
          "raw_line": 141,
          "raw_start": 0,
          "raw_end": 13,
          "start": 84,
          "end": 97,
          "surface": "為良守官至吳郡太守追贈太常"
        }
      ],
      "text_sha256": "2070d8a731a137899e2284c05915bc169d4a85ee3f3c1424e9a4f6aec53d68b3"
    }
  ]
}
