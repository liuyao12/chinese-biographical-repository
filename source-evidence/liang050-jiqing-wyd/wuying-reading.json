{
  "pdf_url": "https://upload.wikimedia.org/wikipedia/commons/f/f1/NLC892-411999017142-12780_%E4%BA%8C%E5%8D%81%E5%9B%9B%E5%8F%B2_%E7%AC%AC169%E5%86%8A.pdf",
  "catalog_permalink": "https://commons.wikimedia.org/w/index.php?oldid=703777627",
  "file_description_revision": 703777627,
  "pdf_sha256": "2f9034c44f36940a6f265f4ccf72630c5cbce13b3a5c86bf0cb87a992678a3b1",
  "column_file": "source-evidence/liang050-jiqing-wyd/wyd-columns.txt",
  "column_file_sha256": "fe27f7f79551ac89948ed19bb99252ef8e05cc5b72cd62907e1d87c4b78e3227",
  "columns": [
    {
      "pdf_page": 57,
      "half": "左",
      "leaf": "八上",
      "column_from_right": 7,
      "reading": "謝幾卿陳郡陽夏人曾祖靈運宋臨川內史父超宗齊",
      "start_codepoint": 0,
      "end_codepoint": 21
    },
    {
      "pdf_page": 57,
      "half": "左",
      "leaf": "八上",
      "column_from_right": 8,
      "reading": "黃門郎並有重名於前代幾卿幼清辯當世號曰神童",
      "start_codepoint": 21,
      "end_codepoint": 42
    },
    {
      "pdf_page": 57,
      "half": "左",
      "leaf": "八上",
      "column_from_right": 9,
      "reading": "後超宗坐事徙越州路出新亭渚幾卿不忍辭訣遂投",
      "start_codepoint": 42,
      "end_codepoint": 63
    },
    {
      "pdf_page": 57,
      "half": "左",
      "leaf": "八上",
      "column_from_right": 10,
      "reading": "赴江流左右馳救得不沉溺及居父憂哀毁過禮服闋",
      "start_codepoint": 63,
      "end_codepoint": 84
    },
    {
      "pdf_page": 58,
      "half": "右",
      "leaf": "八下",
      "column_from_right": 1,
      "reading": "召補國子生齊文惠太子自臨策試謂祭酒王儉曰幾",
      "start_codepoint": 84,
      "end_codepoint": 105
    },
    {
      "pdf_page": 58,
      "half": "右",
      "leaf": "八下",
      "column_from_right": 2,
      "reading": "卿本長玄理今可以經義訪之儉承旨發問幾卿隨事",
      "start_codepoint": 105,
      "end_codepoint": 126
    },
    {
      "pdf_page": 58,
      "half": "右",
      "leaf": "八下",
      "column_from_right": 3,
      "reading": "辨對辭無滯者文惠大稱賞焉儉謂人曰謝超宗為不",
      "start_codepoint": 126,
      "end_codepoint": 147
    },
    {
      "pdf_page": 58,
      "half": "右",
      "leaf": "八下",
      "column_from_right": 4,
      "reading": "死矣既長好學博涉有文采起家豫章王國常侍累遷",
      "start_codepoint": 147,
      "end_codepoint": 168
    },
    {
      "pdf_page": 58,
      "half": "右",
      "leaf": "八下",
      "column_from_right": 5,
      "reading": "車騎法曹行參軍相國祭酒出為寧國令入補尚書殿",
      "start_codepoint": 168,
      "end_codepoint": 189
    },
    {
      "pdf_page": 58,
      "half": "右",
      "leaf": "八下",
      "column_from_right": 6,
      "reading": "中郎太尉晉安王主簿天監初除征虜鄱陽王記室尚",
      "start_codepoint": 189,
      "end_codepoint": 210
    },
    {
      "pdf_page": 58,
      "half": "右",
      "leaf": "八下",
      "column_from_right": 7,
      "reading": "書三公侍郎尋為治書侍御史舊郎官轉為此職者世",
      "start_codepoint": 210,
      "end_codepoint": 231
    },
    {
      "pdf_page": 58,
      "half": "右",
      "leaf": "八下",
      "column_from_right": 8,
      "reading": "謂為南奔幾卿頗失志多陳疾臺事畧不復理徙為散",
      "start_codepoint": 231,
      "end_codepoint": 252
    },
    {
      "pdf_page": 58,
      "half": "右",
      "leaf": "八下",
      "column_from_right": 9,
      "reading": "騎侍郎累遷中書郎國子博士尚書左丞幾卿詳悉故",
      "start_codepoint": 252,
      "end_codepoint": 273
    },
    {
      "pdf_page": 58,
      "half": "右",
      "leaf": "八下",
      "column_from_right": 10,
      "reading": "實僕射徐勉每有疑滯多詢訪之然性通脫會意便行",
      "start_codepoint": 273,
      "end_codepoint": 294
    },
    {
      "pdf_page": 58,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 1,
      "reading": "不拘朝憲嘗預樂遊苑宴不得醉而還因詣道邊酒壚",
      "start_codepoint": 294,
      "end_codepoint": 315
    },
    {
      "pdf_page": 58,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 2,
      "reading": "停車褰幔與車前三騶對飲時觀者如堵幾卿處之自",
      "start_codepoint": 315,
      "end_codepoint": 336
    },
    {
      "pdf_page": 58,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 3,
      "reading": "若後以在省署夜著犢鼻褌與門生登閣道飲酒酣嘑",
      "start_codepoint": 336,
      "end_codepoint": 357
    },
    {
      "pdf_page": 58,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 4,
      "reading": "為有司糾奏坐免官尋起為國子博士俄除河東太守",
      "start_codepoint": 357,
      "end_codepoint": 378
    },
    {
      "pdf_page": 58,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 5,
      "reading": "秩未滿陳疾解尋除太子率更令遷鎮衛南平王長史",
      "start_codepoint": 378,
      "end_codepoint": 399
    },
    {
      "pdf_page": 58,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 6,
      "reading": "普通六年詔遣領軍將軍西昌侯蕭淵藻督衆軍北伐",
      "start_codepoint": 399,
      "end_codepoint": 420
    },
    {
      "pdf_page": 58,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 7,
      "reading": "幾卿啓求行擢為軍師長史加威戎將軍軍至渦陽退",
      "start_codepoint": 420,
      "end_codepoint": 441
    },
    {
      "pdf_page": 58,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 8,
      "reading": "敗幾卿坐免官居宅在白楊石井朝中交好者載酒從",
      "start_codepoint": 441,
      "end_codepoint": 462
    },
    {
      "pdf_page": 58,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 9,
      "reading": "之賓客滿坐時左丞庾仲容亦免歸二人意志相得並",
      "start_codepoint": 462,
      "end_codepoint": 483
    },
    {
      "pdf_page": 58,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 10,
      "reading": "肆情誕縱或乘露車歷遊郊野既醉則執鐸挽歌不屑",
      "start_codepoint": 483,
      "end_codepoint": 504
    },
    {
      "pdf_page": 59,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 1,
      "reading": "物議湘東王在荊鎮與書慰勉之幾卿答曰下官自奉",
      "start_codepoint": 504,
      "end_codepoint": 525
    },
    {
      "pdf_page": 59,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 2,
      "reading": "違南浦卷迹東郊望日臨風瞻言佇立仰尋惠渥陪奉",
      "start_codepoint": 525,
      "end_codepoint": 546
    },
    {
      "pdf_page": 59,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 3,
      "reading": "遊宴漾桂棹於清池席落英於曾岨蘭香兼御羽觴競",
      "start_codepoint": 546,
      "end_codepoint": 567
    },
    {
      "pdf_page": 59,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 4,
      "reading": "集側聽餘論沐浴玄流濤波之辯懸河不足譬春藻之",
      "start_codepoint": 567,
      "end_codepoint": 588
    },
    {
      "pdf_page": 59,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 5,
      "reading": "辭麗文無以匹莫不相顧動容服心勝口不覺春日為",
      "start_codepoint": 588,
      "end_codepoint": 609
    },
    {
      "pdf_page": 59,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 6,
      "reading": "遙更謂脩夜為促嘉會難常摶雲易遠言念如昨忽焉",
      "start_codepoint": 609,
      "end_codepoint": 630
    },
    {
      "pdf_page": 59,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 7,
      "reading": "素秋恩光不遺善謔遠降因事罷歸豈云栖缺匪商官",
      "start_codepoint": 630,
      "end_codepoint": 651
    },
    {
      "pdf_page": 59,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 8,
      "reading": "缺理就一廛田家作苦實符清誨本乏金羈之飾無假",
      "start_codepoint": 651,
      "end_codepoint": 672
    },
    {
      "pdf_page": 59,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 9,
      "reading": "玉璧為資徒以老使形疏疾令心阻沉滯牀簟彌歷七",
      "start_codepoint": 672,
      "end_codepoint": 693
    },
    {
      "pdf_page": 59,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 10,
      "reading": "旬夢幻俄頃憂傷在念竟知無益思自袪遣尋理滌意",
      "start_codepoint": 693,
      "end_codepoint": 714
    },
    {
      "pdf_page": 59,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 1,
      "reading": "即以任命為膏酥擥鏡照形翻以支離代萱樹故得仰",
      "start_codepoint": 714,
      "end_codepoint": 735
    },
    {
      "pdf_page": 59,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 2,
      "reading": "慕徽猷永言前哲鬼谷深栖接輿高舉遁名屠肆發迹",
      "start_codepoint": 735,
      "end_codepoint": 756
    },
    {
      "pdf_page": 59,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 3,
      "reading": "關市其人緬邈餘流可想若令亡者有知寧不縈悲玄",
      "start_codepoint": 756,
      "end_codepoint": 777
    },
    {
      "pdf_page": 59,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 4,
      "reading": "壤悵隔芳塵如其逝者可作必當昭被光景懽同遊豫",
      "start_codepoint": 777,
      "end_codepoint": 798
    },
    {
      "pdf_page": 59,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 5,
      "reading": "使夫一介老圃得簉虛心末席去日已疏來侍未孱連",
      "start_codepoint": 798,
      "end_codepoint": 819
    },
    {
      "pdf_page": 59,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 6,
      "reading": "劍飛鳧擬非其類懷私茂德竊用涕零幾卿雖不持檢",
      "start_codepoint": 819,
      "end_codepoint": 840
    },
    {
      "pdf_page": 59,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 7,
      "reading": "操然於家門篤睦兄才卿早卒其子藻幼孤幾卿撫養",
      "start_codepoint": 840,
      "end_codepoint": 861
    },
    {
      "pdf_page": 59,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 8,
      "reading": "甚至及藻成立歷清官公府祭酒主簿皆幾卿獎訓之",
      "start_codepoint": 861,
      "end_codepoint": 882
    },
    {
      "pdf_page": 59,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 9,
      "reading": "力也世以此稱之幾卿未及序用病卒文集行於世",
      "start_codepoint": 882,
      "end_codepoint": 902
    }
  ],
