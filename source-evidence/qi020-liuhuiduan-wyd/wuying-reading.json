      "column_from_right": 6,
      "reading": "明敬劉皇后諱惠端彭城人光祿大夫道弘孫也太祖",
      "start_codepoint": 0,
      "end_codepoint": 21
    },
    {
      "pdf_page": 6,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 7,
      "reading": "為高宗納之建元三年除西昌侯夫人永明七年卒葬",
      "start_codepoint": 21,
      "end_codepoint": 42
    },
    {
      "pdf_page": 6,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 8,
      "reading": "江乘縣張山延興元年贈宣城王妃高宗即位追尊為",
      "start_codepoint": 42,
      "end_codepoint": 63
    },
    {
      "pdf_page": 6,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 9,
      "reading": "敬皇后贈父通直郎景猷金紫光祿大夫母王氏平陽",
      "start_codepoint": 63,
      "end_codepoint": 84
    },
    {
      "pdf_page": 6,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 10,
      "reading": "鄉君永泰元年高宗崩改葬祔于興安陵",
      "start_codepoint": 84,
      "end_codepoint": 100
    }
  ],
