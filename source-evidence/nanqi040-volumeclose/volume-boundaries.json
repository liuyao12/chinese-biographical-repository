          "last_line": 97,
          "start_codepoint": 2,
          "end_codepoint": 308,
          "opening": "及陳顯達起事，",
          "closing": "與同黨皆伏誅。"
        },
        {
          "first_line": 97,
          "last_line": 97,
          "start_codepoint": 322,
          "end_codepoint": 342,
          "opening": "梁王定京邑，追",
          "closing": "侍、撫軍將軍，"
        }
