          "first_line": 102,
          "last_line": 102,
          "start_codepoint": 2,
          "end_codepoint": 185,
          "opening": "子卿在鎮，營造",
          "closing": "，使吾失氣。」"
        },
        {
          "first_line": 104,
          "last_line": 104,
          "start_codepoint": 2,
          "end_codepoint": 146,
          "opening": "五年，入爲侍中",
          "closing": "崩，不與相見。"
        },
        {
          "first_line": 106,
          "last_line": 106,
          "start_codepoint": 2,
          "end_codepoint": 76,
          "opening": "鬱林卽位，復爲",
          "closing": "，時年二十七。"
        }
      ]
