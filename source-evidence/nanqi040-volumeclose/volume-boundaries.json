          "start_codepoint": 2,
          "end_codepoint": 228,
          "opening": "{{YL|永明",
          "closing": "史，常侍如故。"
        },
        {
          "first_line": 113,
          "last_line": 113,
          "start_codepoint": 2,
          "end_codepoint": 303,
          "opening": "七年，遷使持節",
          "closing": "可全其性命。」"
        },
        {
          "first_line": 115,
          "last_line": 115,
          "start_codepoint": 0,
          "end_codepoint": 219,
          "opening": "諧之等至江津，",
          "closing": "。時年二十二。"
        },
        {
          "first_line": 117,
          "last_line": 117,
          "start_codepoint": 2,
          "end_codepoint": 246,
          "opening": "臨死，啓上曰：",
          "closing": "周彥驍騎將軍。"
        },
        {
          "first_line": 119,
          "last_line": 119,
          "start_codepoint": 2,
          "end_codepoint": 380,
          "opening": "上憐子響死，後",
          "closing": "是貶爲魚復侯。"
        }
      ]
