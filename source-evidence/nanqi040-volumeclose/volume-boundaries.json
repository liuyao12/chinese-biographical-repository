    {
      "chapter_id": "c-nanqishu-040-ziliang",
      "title": "竟陵文宣王子良",
      "unit_kind": "headed_account",
      "first_line": 12,
      "last_line": 12,
      "start_codepoint": 2,
      "end_codepoint": 83,
      "continuation_spans": [
        {
          "first_line": 14,
          "last_line": 14,
          "start_codepoint": 2,
          "end_codepoint": 92,
          "opening": "{{YL|昇明",
          "closing": "，子良陳之曰："
        },
        {
          "first_line": 16,
          "last_line": 16,
          "start_codepoint": 3,
          "end_codepoint": 493,
          "opening": "前臺使督逋切調",
          "closing": "僨，反更淹懈。"
        },
        {
          "first_line": 18,
          "last_line": 18,
          "start_codepoint": 3,
          "end_codepoint": 201,
          "opening": "凡預衣冠，荷恩",
          "closing": "竊，遠近蹔安。"
        },
        {
          "first_line": 20,
          "last_line": 20,
          "start_codepoint": 0,
          "end_codepoint": 12,
          "opening": "封聞喜縣公，邑",
          "closing": "，邑千五百戶。"
        },
        {
          "first_line": 22,
          "last_line": 22,
          "start_codepoint": 2,
          "end_codepoint": 115,
          "opening": "子良敦義愛古。",
          "closing": "歲獻扇簟而已。"
        },
        {
          "first_line": 24,
          "last_line": 24,
          "start_codepoint": 2,
          "end_codepoint": 203,
          "opening": "{{YL|建元",
          "closing": "會遷官，事寢。"
        },
        {
          "first_line": 26,
          "last_line": 26,
          "start_codepoint": 2,
          "end_codepoint": 150,
          "opening": "是年，始制東宮",
          "closing": "進號車騎將軍。"
        },
        {
          "first_line": 28,
          "last_line": 28,
          "start_codepoint": 2,
          "end_codepoint": 73,
          "opening": "子良少有清尚，",
          "closing": "，皆發教撰錄。"
        },
        {
          "first_line": 30,
          "last_line": 30,
          "start_codepoint": 2,
          "end_codepoint": 20,
          "opening": "是時上新親政，",
          "closing": "。子良密啓曰："
        },
        {
          "first_line": 32,
          "last_line": 32,
          "start_codepoint": 3,
          "end_codepoint": 159,
          "opening": "臣思水潦成患，",
          "closing": "恩，微紓民命。"
        },
        {
          "first_line": 34,
          "last_line": 34,
          "start_codepoint": 3,
          "end_codepoint": 184,
          "opening": "自宋道無章，王",
          "closing": "取，於事未遲。"
        },
        {
          "first_line": 36,
          "last_line": 36,
          "start_codepoint": 3,
          "end_codepoint": 66,
          "opening": "明詔深矜獄圄，",
          "closing": "怨，非國福矣。"
        },
        {
          "first_line": 38,
          "last_line": 38,
          "start_codepoint": 3,
          "end_codepoint": 96,
          "opening": "頃土木之務，甚",
          "closing": "危，存其命哉？"
        },
        {
          "first_line": 40,
          "last_line": 40,
          "start_codepoint": 3,
          "end_codepoint": 223,
          "opening": "湘區奧密，蠻寇",
          "closing": "舉，蟻寇自服。"
        },
        {
          "first_line": 42,
          "last_line": 42,
          "start_codepoint": 2,
          "end_codepoint": 18,
          "opening": "詔折租布，二分",
          "closing": "。子良又啓曰："
        },
        {
          "first_line": 44,
          "last_line": 44,
          "start_codepoint": 3,
          "end_codepoint": 262,
          "opening": "臣一月入朝，六",
          "closing": "而國富於上邪？"
        },
        {
          "first_line": 46,
          "last_line": 46,
          "start_codepoint": 3,
          "end_codepoint": 118,
          "opening": "又泉鑄歲遠，類",
          "closing": "科，退容姦利。"
        },
        {
          "first_line": 48,
          "last_line": 48,
          "start_codepoint": 3,
          "end_codepoint": 65,
          "opening": "八屬近縣，旣在",
          "closing": "上，許以申原。"
        },
        {
          "first_line": 50,
          "last_line": 50,
          "start_codepoint": 3,
          "end_codepoint": 85,
          "opening": "兖豫二藩，雖曰",
          "closing": "民，應加蠲減。"
        },
        {
          "first_line": 52,
          "last_line": 52,
          "start_codepoint": 3,
          "end_codepoint": 111,
          "opening": "又司市之要，自",
          "closing": "在事所以開容？"
        },
        {
          "first_line": 54,
          "last_line": 54,
          "start_codepoint": 3,
          "end_codepoint": 59,
          "opening": "夫獄訟惟平，畫",
          "closing": "先王立理之本。"
        },
        {
          "first_line": 56,
          "last_line": 56,
          "start_codepoint": 3,
          "end_codepoint": 49,
          "opening": "尚書列曹，上應",
          "closing": "郎官尤宜推擇。"
        },
        {
          "first_line": 58,
          "last_line": 58,
          "start_codepoint": 3,
          "end_codepoint": 87,
          "opening": "宋運告終，戎車",
          "closing": "間，可減太半。"
        },
        {
          "first_line": 60,
          "last_line": 60,
          "start_codepoint": 2,
          "end_codepoint": 88,
          "opening": "五年，正位司徒",
          "closing": "，江左未有也。"
        },
        {
          "first_line": 62,
          "last_line": 62,
          "start_codepoint": 2,
          "end_codepoint": 13,
          "opening": "世祖好射雉，子",
          "closing": "雉，子良諫曰："
        },
        {
          "first_line": 64,
          "last_line": 64,
          "start_codepoint": 3,
          "end_codepoint": 160,
          "opening": "鑾轝亟動，天蹕",
          "closing": "愚臣最所震迫。"
        },
        {
          "first_line": 66,
          "last_line": 66,
          "start_codepoint": 3,
          "end_codepoint": 74,
          "opening": "狡虜玩威，甫獲",
          "closing": "命，宜賜優禮。"
        },
        {
          "first_line": 68,
          "last_line": 68,
          "start_codepoint": 3,
          "end_codepoint": 68,
          "opening": "伏謂中堂雲構，",
          "closing": "敞，實允觀聽。"
        },
        {
          "first_line": 70,
          "last_line": 70,
          "start_codepoint": 3,
          "end_codepoint": 46,
          "opening": "頃市司驅扇，租",
          "closing": "司，更詳優格。"
        },
        {
          "first_line": 72,
          "last_line": 72,
          "start_codepoint": 3,
          "end_codepoint": 70,
          "opening": "臣年方朝賢，齒",
          "closing": "陛下於何聞之？"
        },
        {
          "first_line": 74,
          "last_line": 74,
          "start_codepoint": 36,
          "end_codepoint": 50,
          "opening": "永明末，上將射",
          "closing": "雉。子良諫曰："
        },
        {
          "first_line": 76,
          "last_line": 76,
          "start_codepoint": 3,
          "end_codepoint": 326,
          "opening": "忽聞外議，伏承",
          "closing": "生，實可深慎。"
        },
        {
          "first_line": 78,
          "last_line": 78,
          "start_codepoint": 3,
          "end_codepoint": 85,
          "opening": "臣聞子孝奉君，",
          "closing": "心，卽實上啓。"
        },
        {
          "first_line": 80,
          "last_line": 80,
          "start_codepoint": 0,
          "end_codepoint": 11,
          "opening": "雖不盡納，而深",
          "closing": "，而深見寵愛。"
        },
        {
          "first_line": 82,
          "last_line": 82,
          "start_codepoint": 2,
          "end_codepoint": 183,
          "opening": "又與文惠太子同",
          "closing": "令，加中書監。"
        },
        {
          "first_line": 84,
          "last_line": 84,
          "start_codepoint": 2,
          "end_codepoint": 49,
          "opening": "文惠太子薨，世",
          "closing": "聞，頗加嫌責。"
        },
        {
          "first_line": 86,
          "last_line": 86,
          "start_codepoint": 2,
          "end_codepoint": 261,
          "opening": "世祖不豫，詔子",
          "closing": "至山陵，不許。"
        },
        {
          "first_line": 88,
          "last_line": 88,
          "start_codepoint": 2,
          "end_codepoint": 524,
          "opening": "進位太傅，增班",
          "closing": "旣薨，遂葬焉。"
        },
        {
          "first_line": 90,
          "last_line": 90,
          "start_codepoint": 2,
          "end_codepoint": 47,
          "opening": "所著內外文筆數",
          "closing": "行。子昭冑嗣。"
        }
      ]
    },
