  "source_clauses": [
    {
      "witness": "tong",
      "quote": "八月，吳主封子霸為魯王。霸，和母弟也，寵愛崇特，與和無殊。",
      "raw_start": 7662,
      "raw_end": 7691,
      "raw_line": 113
    },
    {
      "witness": "sg47",
      "quote": "八月，立子[[w:孫霸|霸]]爲魯王。",
      "raw_start": 21934,
      "raw_end": 21953,
      "raw_line": 117
    },
    {
      "witness": "sg",
      "quote": "長子承已自封侯，少子休襲爵。",
      "raw_start": 3352,
      "raw_end": 3366,
      "raw_line": 24
    },
    {
      "witness": "sg",
      "quote": "子震嗣。初，承喪妻，昭欲爲索諸葛瑾女",
      "raw_start": 3794,
      "raw_end": 3812,
      "raw_line": 32
    },
    {
      "witness": "sg",
      "quote": "生女，權爲子和納之。權數令和修敬於承，執子婿之禮。",
      "raw_start": 3865,
      "raw_end": 3890,
      "raw_line": 32
    },
    {
      "witness": "sg",
      "quote": "臣松之案：承与诸葛瑾同以赤乌中卒，计承年小瑾四岁耳。",
      "raw_start": 3837,
      "raw_end": 3863,
      "raw_line": 32
    },
    {
      "witness": "sg",
      "quote": "吴录-{云}-：弘，会稽人也。",
      "raw_start": 4141,
      "raw_end": 4156,
      "raw_line": 36
    },
    {
      "witness": "sg59",
      "quote": "以恪爲左輔，休右弼，譚爲輔正，表爲翼正都尉，是爲四友",
      "raw_start": 478,
      "raw_end": 504,
      "raw_line": 12
    },
    {
      "witness": "sg59",
      "quote": "謝景者字叔發，南陽宛人。",
      "raw_start": 2522,
      "raw_end": 2534,
      "raw_line": 22
    },
    {
      "witness": "sg59",
      "quote": "和妃叔父張休居近廟，邀和過所居。",
      "raw_start": 3876,
      "raw_end": 3892,
      "raw_line": 32
    },
    {
      "witness": "sg59",
      "quote": "孫霸字子威，和弟也。",
      "raw_start": 5690,
      "raw_end": 5700,
      "raw_line": 39
    },
    {
      "witness": "sg50",
      "quote": "嫡妃張氏亦自殺。",
      "raw_start": 3865,
      "raw_end": 3873,
      "raw_line": 58
    },
    {
      "witness": "sg58",
      "quote": "《文士传》曰：陆景母张承女，诸葛恪外生。",
      "raw_start": 10430,
      "raw_end": 10450,
      "raw_line": 87
    },
    {
      "witness": "sg58",
      "quote": "景妻，孫皓適妹，與景俱張承外孫也。",
      "raw_start": 10511,
      "raw_end": 10528,
      "raw_line": 87
    },
    {
      "witness": "sg64",
      "quote": "與顧譚、張休等侍太子登講論道藝，並為賓友。",
      "raw_start": 279,
      "raw_end": 300,
      "raw_line": 12
    },
    {
      "witness": "sg47",
      "quote": "[[w:孫韶|孫韶]]、[[w:張承|張承]]等嚮廣陵、淮陽",
      "raw_start": 18640,
      "raw_end": 18670,
      "raw_line": 93
    }
  ],
