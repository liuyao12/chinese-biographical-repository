      "end_codepoint": 30,
      "human_reviewed": false
    },
    {
      "id": "c-songshu-047-liuhuaisu-received:received_sentence2-30",
      "kind": "received_sentence",
      "person_id": "olf_c6j_hmg",
      "source_quote": "聞高祖起義，棄縣來奔。",
      "reading": "聞劉裕起義，棄縣往從。",
      "note": "聞劉裕起義，棄縣往從。",
      "paragraph_id": "c-songshu-047-liuhuaisu-received:p002",
      "start_codepoint": 30,
      "end_codepoint": 41,
      "human_reviewed": false
    },
    {
      "id": "c-songshu-047-liuhuaisu-received:received_sentence2-41",
      "kind": "received_sentence",
      "person_id": "olf_c6j_hmg",
      "source_quote": "京邑平定，振武將軍道規追桓玄，以懷肅為司馬。",
      "reading": "鎮定京邑後，參劉道規討桓玄之軍。",
      "note": "鎮定京邑後，參劉道規討桓玄之軍。",
      "paragraph_id": "c-songshu-047-liuhuaisu-received:p002",
      "start_codepoint": 41,
      "end_codepoint": 63,
      "human_reviewed": false
    },
    {
      "id": "c-songshu-047-liuhuaisu-received:received_sentence2-63",
      "kind": "received_sentence",
      "person_id": "olf_c6j_hmg",
      "source_quote": "玄留何澹之、郭銓等戍桑落洲，進擊破之。",
      "reading": "何澹之、郭銓等守桑落洲，為晉軍所破。",
      "note": "何澹之、郭銓等守桑落洲，為晉軍所破。",
      "paragraph_id": "c-songshu-047-liuhuaisu-received:p002",
      "start_codepoint": 63,
      "end_codepoint": 82,
      "human_reviewed": false
    },
    {
