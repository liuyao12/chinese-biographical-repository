  "seven_proposals": [
    {
      "paragraph_id": "c-jinshu-098-huanwen:p016",
      "start": 173,
      "end": 197,
      "surface": "其一，朋黨雷同，私議沸騰，宜抑杜浮競，莫使能植。"
    },
    {
      "paragraph_id": "c-jinshu-098-huanwen:p016",
      "start": 197,
      "end": 224,
      "surface": "其二，戶口凋寡，不當漢之一郡，宜並官省職，令久於其事。"
    },
    {
      "paragraph_id": "c-jinshu-098-huanwen:p016",
      "start": 224,
      "end": 243,
      "surface": "其三，機務不可停廢，常行文案宜為限日。"
    },
    {
      "paragraph_id": "c-jinshu-098-huanwen:p016",
      "start": 243,
      "end": 259,
      "surface": "其四，宜明長幼之禮，獎忠公之吏。"
    },
    {
      "paragraph_id": "c-jinshu-098-huanwen:p016",
      "start": 259,
      "end": 272,
      "surface": "其五，褒貶賞罰，宜允其實。"
    },
    {
      "paragraph_id": "c-jinshu-098-huanwen:p016",
      "start": 272,
      "end": 286,
      "surface": "其六，宜述遵前典，敦明學業。"
    },
    {
      "paragraph_id": "c-jinshu-098-huanwen:p016",
      "start": 286,
      "end": 300,
      "surface": "其七，宜選建史官，以成晉書。"
    }
  ],
  "seven_outcome": "有司皆奏行之",
