      "title": "郭璞",
      "raw_spans": [
        {
          "first_line": 10,
          "last_line": 10,
          "start_codepoint": 0,
          "end_codepoint": 14,
          "opening": "郭璞，字景純，河東聞",
          "closing": "景純，河東聞喜人也。"
        },
        {
          "first_line": 10,
          "last_line": 10,
          "start_codepoint": 52,
          "end_codepoint": 90,
          "opening": "璞好經術，博學有高才",
          "closing": "奇字，妙於陰陽算曆。"
        },
        {
          "first_line": 12,
          "last_line": 12,
          "start_codepoint": 0,
          "end_codepoint": 61,
          "opening": "惠懷之際，河東先擾。",
          "closing": "數十家，欲避地東南。"
        },
        {
          "first_line": 16,
          "last_line": 16,
          "start_codepoint": 0,
          "end_codepoint": 16,
          "opening": "璞既過江，宣城太守殷",
          "closing": "城太守殷祐引為參軍。"
        },
        {
          "first_line": 16,
          "last_line": 16,
          "start_codepoint": 223,
          "end_codepoint": 235,
          "opening": "祐遷石頭督護，璞復隨",
          "closing": "石頭督護，璞復隨之。"
        },
        {
          "first_line": 20,
          "last_line": 20,
          "start_codepoint": 0,
          "end_codepoint": 39,
          "opening": "璞著《江賦》，其辭甚",
          "closing": "嘉之，以為著作佐郎。"
        },
        {
          "first_line": 38,
          "last_line": 38,
          "start_codepoint": 0,
          "end_codepoint": 76,
          "opening": "頃之遷尚書郎。數言便",
          "closing": "嗜酒好色，時或過度。"
        },
        {
          "first_line": 66,
          "last_line": 66,
          "start_codepoint": 53,
          "end_codepoint": 66,
          "opening": "未期，王敦起璞為記室",
          "closing": "王敦起璞為記室參軍。"
        },
        {
          "first_line": 70,
          "last_line": 70,
          "start_codepoint": 302,
          "end_codepoint": 313,
          "opening": "璞之占驗，皆如此類也",
          "closing": "之占驗，皆如此類也。"
        },
        {
          "first_line": 72,
          "last_line": 72,
          "start_codepoint": 0,
          "end_codepoint": 140,
          "opening": "璞撰前後筮驗六十餘事",
          "closing": "作詩賦誄頌亦數萬言。"
        }
      ],
