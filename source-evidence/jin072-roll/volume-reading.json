  "print_readings": [
    {
      "received_line": 10,
      "chapter_id": "1kpb3nzxydr0q",
      "paragraph_id": "7480252666968490018",
      "page_id": "7444730056385282063",
      "quote": "璞門人趙載嘗竊靑囊書",
      "start_codepoint": 157,
      "end_codepoint": 167,
      "reading": "底本作青襄書；四庫作青嚢書。"
    },
    {
      "received_line": 64,
      "chapter_id": "1kpb3nzxydr0q",
      "paragraph_id": "7480252666968752162",
      "page_id": "7444730086240337930",
      "quote": "時曁陽人任谷",
      "start_codepoint": 0,
      "end_codepoint": 6,
      "reading": "底本開頭作暨陽人任穀。"
    },
    {
      "received_line": 68,
      "chapter_id": "1mb9ku0fgtyjt",
      "paragraph_id": "7675249376361971754",
      "page_id": "7444730131735822372",
      "quote": "共脫去二十二字，今照宋本増入",
      "start_codepoint": 55,
      "end_codepoint": 69,
      "reading": "武英殿本考證記監本闕文與補入依據。"
    },
    {
      "received_line": 72,
      "chapter_id": "1kpb3nzxydr0q",
      "paragraph_id": "7480252666968834082",
      "page_id": "7444730119312310306",
      "quote": "子驁，官至臨賀太守",
      "start_codepoint": 96,
      "end_codepoint": 105,
      "reading": "同記驁。"
    },
    {
      "received_line": 75,
      "chapter_id": "1mb9ku0fgtlwp",
      "paragraph_id": "7675249376361938986",
      "page_id": "7444730119312310306",
      "quote": "祖系，吳大鴻臚。父悌",
      "start_codepoint": 13,
      "end_codepoint": 23,
      "reading": "同載祖父兩名。"
    },
    {
      "received_line": 79,
      "chapter_id": "1mb9ku0fgtlwp",
      "paragraph_id": "7480252669936795688",
      "page_id": "7444730119312326690",
      "quote": "剌史鄧嶽留，不聽去",
      "start_codepoint": 29,
      "end_codepoint": 38,
      "reading": "數位底本此處岳。"
    },
    {
      "received_line": 87,
      "chapter_id": "1mb9ku0fgtlwp",
      "paragraph_id": "7480252669936828456",
      "page_id": "7444730088689811467",
      "quote": "時年八十一",
      "start_codepoint": 258,
      "end_codepoint": 263,
      "reading": "同見卒年齡，未具卒年。"
    }
  ],
  "boundaries": [
