  "columns": [
    {
      "pdf_page": 5,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 3,
      "reading": "文安王皇后諱寶明琅邪臨沂人也祖韶之吳興太守",
      "start_codepoint": 0,
      "end_codepoint": 21
    },
    {
      "pdf_page": 5,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 4,
      "reading": "父曄之太宰祭酒宋世太祖為文惠太子納后桂陽賊",
      "start_codepoint": 21,
      "end_codepoint": 42
    },
    {
      "pdf_page": 5,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 5,
      "reading": "至太祖在新亭傳言已沒宅復為人所抄掠文惠太子",
      "start_codepoint": 42,
      "end_codepoint": 63
    },
    {
      "pdf_page": 5,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 6,
      "reading": "竟陵王子良奉穆后庾妃及后挺身送后兄昺之家事",
      "start_codepoint": 63,
      "end_codepoint": 84
    },
    {
      "pdf_page": 5,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 7,
      "reading": "平乃出建元元年為南郡王妃四年為皇太子妃無寵",
      "start_codepoint": 84,
      "end_codepoint": 105
    },
    {
      "pdf_page": 5,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 8,
      "reading": "太子為宮人製新麗衣裳及首飾而后牀帷陳設故舊",
      "start_codepoint": 105,
      "end_codepoint": 126
    },
    {
      "pdf_page": 5,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 9,
      "reading": "釵鑷十餘枚永明十一年為皇太孫太妃鬱林即位尊",
      "start_codepoint": 126,
      "end_codepoint": 147
    },
    {
      "pdf_page": 5,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 10,
      "reading": "為皇太后稱宣德宮贈后父金紫光祿大夫母桓氏豐",
      "start_codepoint": 147,
      "end_codepoint": 168
    },
    {
      "pdf_page": 5,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 1,
      "reading": "安縣君其年十二月備法駕謁太廟高宗即位出居鄱",
      "start_codepoint": 168,
      "end_codepoint": 189
    },
    {
      "pdf_page": 5,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 2,
      "reading": "陽王故第為宣德宮永元三年梁王定京邑迎后入宮",
      "start_codepoint": 189,
      "end_codepoint": 210
    },
    {
      "pdf_page": 5,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 3,
      "reading": "稱制至禪位天監十一年薨年五十八葬崇安陵諡曰",
      "start_codepoint": 210,
      "end_codepoint": 231
    },
    {
      "pdf_page": 5,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 4,
      "reading": "安后兄晃義興太守",
      "start_codepoint": 231,
      "end_codepoint": 239
    }
  ],
