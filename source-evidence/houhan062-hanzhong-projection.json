    {
      "key": "zhong-hao-body:note2:0",
      "layer": "lixian_commentary",
      "text": "孟子曰人無惻隠之心非人也無羞惡之心非人也無辭讓之心非人也無是非之心非人也",
      "raw_runs": [
        {
          "raw_line": 272,
          "raw_start": 21,
          "raw_end": 22,
          "start": 0,
          "end": 1,
          "surface": "孟"
        },
        {
          "raw_line": 272,
          "raw_start": 23,
          "raw_end": 24,
          "start": 1,
          "end": 2,
          "surface": "子"
        },
        {
          "raw_line": 273,
          "raw_start": 1,
          "raw_end": 18,
          "start": 2,
          "end": 19,
          "surface": "曰人無惻隠之心非人也無羞惡之心非人"
        },
        {
          "raw_line": 273,
          "raw_start": 19,
          "raw_end": 36,
          "start": 19,
          "end": 36,
          "surface": "也無辭讓之心非人也無是非之心非人也"
        }
      ],
