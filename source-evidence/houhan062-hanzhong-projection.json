    },
    {
      "key": "zhong-hao-body",
      "layer": "received_biography",
      "text": "鍾皓字季明潁川長社人也為郡著姓世善刑律皓少以篤行稱公府連辟為二兄未仕避隠密山以詩律敎授門徒千餘人同郡陳寔年不及皓皓引與為友皓為郡功曹會辟司徒府臨辭太守問誰可代卿者皓曰明府欲必得其人西門亭長陳寔可寔聞之曰鍾君似不察人不知何獨識我皓頃之自劾去前後九辟公府徴為廷尉正博士林慮長皆不就時皓及荀淑並為士大夫所歸慕李膺常嘆曰荀君清識難尚鍾君至徳可師皓兄子瑾母膺之姑也瑾好學慕古有退讓風與膺同年俱有聲名膺祖太尉脩常言瑾似我家性邦有道不廢邦無道免於刑戮復以膺妹妻之瑾辟州府未嘗屈志膺謂之曰孟子以為人無是非之心非人也弟何期不與孟軻同邪瑾常以膺言白皓皓曰昔國武子好昭人過以致怨本卒保身全家爾道為貴其體訓所安多此類也年六十九終於家諸儒頌之曰林慮懿徳非禮不處恱此詩書弦琴樂古五就州招九膺台輔逡巡王命卒嵗容與皓孫繇建安中為司𨽻校尉",
      "raw_runs": [
        {
          "raw_line": 260,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "鍾皓字季明潁川長社人也為郡著姓世善刑律皓少"
        },
        {
          "raw_line": 261,
          "raw_start": 0,
          "raw_end": 17,
          "start": 21,
          "end": 38,
          "surface": "以篤行稱公府連辟為二兄未仕避隠密山"
        },
        {
          "raw_line": 261,
          "raw_start": 24,
          "raw_end": 26,
          "start": 38,
          "end": 40,
          "surface": "以詩"
        },
        {
          "raw_line": 262,
          "raw_start": 0,
          "raw_end": 21,
          "start": 40,
          "end": 61,
          "surface": "律敎授門徒千餘人同郡陳寔年不及皓皓引與為友"
        },
        {
          "raw_line": 263,
          "raw_start": 0,
          "raw_end": 21,
          "start": 61,
          "end": 82,
          "surface": "皓為郡功曹會辟司徒府臨辭太守問誰可代卿者皓"
        },
        {
          "raw_line": 264,
          "raw_start": 0,
          "raw_end": 21,
          "start": 82,
          "end": 103,
          "surface": "曰明府欲必得其人西門亭長陳寔可寔聞之曰鍾君"
        },
        {
          "raw_line": 265,
          "raw_start": 0,
          "raw_end": 21,
          "start": 103,
          "end": 124,
          "surface": "似不察人不知何獨識我皓頃之自劾去前後九辟公"
        },
        {
          "raw_line": 266,
          "raw_start": 0,
          "raw_end": 21,
          "start": 124,
          "end": 145,
          "surface": "府徴為廷尉正博士林慮長皆不就時皓及荀淑並為"
        },
        {
          "raw_line": 267,
          "raw_start": 0,
          "raw_end": 21,
          "start": 145,
          "end": 166,
          "surface": "士大夫所歸慕李膺常嘆曰荀君清識難尚鍾君至徳"
        },
        {
          "raw_line": 269,
          "raw_start": 0,
          "raw_end": 21,
          "start": 166,
          "end": 187,
          "surface": "可師皓兄子瑾母膺之姑也瑾好學慕古有退讓風與"
        },
        {
          "raw_line": 270,
          "raw_start": 0,
          "raw_end": 21,
          "start": 187,
          "end": 208,
          "surface": "膺同年俱有聲名膺祖太尉脩常言瑾似我家性邦有"
        },
        {
          "raw_line": 271,
          "raw_start": 0,
          "raw_end": 21,
          "start": 208,
          "end": 229,
          "surface": "道不廢邦無道免於刑戮復以膺妹妻之瑾辟州府未"
        },
        {
          "raw_line": 272,
          "raw_start": 0,
          "raw_end": 20,
          "start": 229,
          "end": 249,
          "surface": "嘗屈志膺謂之曰孟子以為人無是非之心非人也"
        },
        {
          "raw_line": 273,
          "raw_start": 37,
          "raw_end": 41,
          "start": 249,
          "end": 253,
          "surface": "弟何期不"
        },
        {
          "raw_line": 274,
          "raw_start": 0,
          "raw_end": 21,
          "start": 253,
          "end": 274,
          "surface": "與孟軻同邪瑾常以膺言白皓皓曰昔國武子好昭人"
        },
        {
          "raw_line": 275,
          "raw_start": 0,
          "raw_end": 5,
          "start": 274,
          "end": 279,
          "surface": "過以致怨本"
        },
        {
          "raw_line": 276,
          "raw_start": 19,
          "raw_end": 32,
          "start": 279,
          "end": 292,
          "surface": "卒保身全家爾道為貴其體訓所"
        },
        {
          "raw_line": 278,
          "raw_start": 0,
          "raw_end": 21,
          "start": 292,
          "end": 313,
          "surface": "安多此類也年六十九終於家諸儒頌之曰林慮懿徳"
        },
        {
          "raw_line": 279,
          "raw_start": 0,
          "raw_end": 21,
          "start": 313,
          "end": 334,
          "surface": "非禮不處恱此詩書弦琴樂古五就州招九膺台輔逡"
        },
        {
          "raw_line": 280,
          "raw_start": 0,
          "raw_end": 18,
          "start": 334,
          "end": 352,
          "surface": "巡王命卒嵗容與皓孫繇建安中為司𨽻校尉"
        }
      ],
      "raw_window": [
        260,
        281
      ]
    },
