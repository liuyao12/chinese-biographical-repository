  "units": [
    {
      "key": "han-shao-rong-body",
      "layer": "received_biography",
      "text": "韓韶字仲黄潁川舞陽人也少仕郡辟司徒府時太山賊公孫舉偽號歴年守令不能破散多為坐法尚書選三府掾能理劇者乃以韶為贏長賊聞其賢相戒不入贏境餘縣多被寇盗廢耕桑其流入縣界求索衣糧者甚衆韶愍其飢困乃開倉賑之所稟贍萬餘戶主者爭謂不可韶曰長活溝壑之人而以此伏罪含笑入地矣太守素知韶名徳竟無所坐以病卒官同郡李膺陳寔杜密荀淑等為立碑頌焉子融字元長少能辨理而不為章句學聲名甚盛五府並辟獻帝初至太僕年七十卒",
      "raw_runs": [
        {
          "raw_line": 247,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "韓韶字仲黄潁川舞陽人也少仕郡辟司徒府時太山"
        },
        {
          "raw_line": 248,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "賊公孫舉偽號歴年守令不能破散多為坐法尚書選"
        },
        {
          "raw_line": 249,
          "raw_start": 0,
          "raw_end": 13,
          "start": 42,
          "end": 55,
          "surface": "三府掾能理劇者乃以韶為贏長"
        },
        {
          "raw_line": 249,
          "raw_start": 29,
          "raw_end": 30,
          "start": 55,
          "end": 56,
          "surface": "賊"
        },
        {
          "raw_line": 251,
          "raw_start": 0,
          "raw_end": 21,
          "start": 56,
          "end": 77,
          "surface": "聞其賢相戒不入贏境餘縣多被寇盗廢耕桑其流入"
        },
        {
          "raw_line": 252,
          "raw_start": 0,
          "raw_end": 21,
          "start": 77,
          "end": 98,
          "surface": "縣界求索衣糧者甚衆韶愍其飢困乃開倉賑之所稟"
        },
        {
          "raw_line": 253,
          "raw_start": 0,
          "raw_end": 21,
          "start": 98,
          "end": 119,
          "surface": "贍萬餘戶主者爭謂不可韶曰長活溝壑之人而以此"
        },
        {
          "raw_line": 254,
          "raw_start": 0,
          "raw_end": 21,
          "start": 119,
          "end": 140,
          "surface": "伏罪含笑入地矣太守素知韶名徳竟無所坐以病卒"
        },
        {
          "raw_line": 255,
          "raw_start": 0,
          "raw_end": 21,
          "start": 140,
          "end": 161,
          "surface": "官同郡李膺陳寔杜密荀淑等為立碑頌焉子融字元"
        },
        {
          "raw_line": 256,
          "raw_start": 0,
          "raw_end": 21,
          "start": 161,
          "end": 182,
          "surface": "長少能辨理而不為章句學聲名甚盛五府並辟獻帝"
        },
        {
          "raw_line": 257,
          "raw_start": 0,
          "raw_end": 8,
          "start": 182,
          "end": 190,
          "surface": "初至太僕年七十卒"
        }
      ],
      "raw_window": [
        247,
        257
      ]
    },
    {
      "key": "han-shao-rong-body:note1:0",
      "layer": "lixian_commentary",
      "text": "贏縣故城今在兖州愽城縣東北",
      "raw_runs": [
        {
          "raw_line": 249,
          "raw_start": 14,
          "raw_end": 21,
          "start": 0,
          "end": 7,
          "surface": "贏縣故城今在兖"
        },
        {
          "raw_line": 249,
          "raw_start": 22,
          "raw_end": 28,
          "start": 7,
          "end": 13,
          "surface": "州愽城縣東北"
        }
      ],
