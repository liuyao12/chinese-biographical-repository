  "column_file": "source-evidence/liang050-xiezheng-wyd/wyd-columns.txt",
  "column_file_sha256": "93d3d6c680a33b42bc9b39b58d3f320f659e9644cabc08c3601ab1bacf910fe8",
  "columns": [
    {
      "pdf_page": 67,
      "half": "右",
      "leaf": "十七下",
      "column_from_right": 4,
      "reading": "謝徵字玄度陳郡陽夏人高祖景仁宋尚書左僕射祖",
      "start_codepoint": 0,
      "end_codepoint": 21
    },
    {
      "pdf_page": 67,
      "half": "右",
      "leaf": "十七下",
      "column_from_right": 5,
      "reading": "稚宋司徒主簿父璟少與從叔朓俱知名齊竟陵王子",
      "start_codepoint": 21,
      "end_codepoint": 42
    },
    {
      "pdf_page": 67,
      "half": "右",
      "leaf": "十七下",
      "column_from_right": 6,
      "reading": "良開西邸招文學璟亦預焉隆昌中為明帝驃騎諮議",
      "start_codepoint": 42,
      "end_codepoint": 63
    },
    {
      "pdf_page": 67,
      "half": "右",
      "leaf": "十七下",
      "column_from_right": 7,
      "reading": "參軍領記室遷中書郎晉安內史高祖平京邑為霸府",
      "start_codepoint": 63,
      "end_codepoint": 84
    },
    {
      "pdf_page": 67,
      "half": "右",
      "leaf": "十七下",
      "column_from_right": 8,
      "reading": "諮議梁臺黄門郎天監初累遷司農卿秘書監左民尚",
      "start_codepoint": 84,
      "end_codepoint": 105
    },
    {
      "pdf_page": 67,
      "half": "右",
      "leaf": "十七下",
      "column_from_right": 9,
      "reading": "書明威將軍東陽太守高祖用為侍中固辭年老求金",
      "start_codepoint": 105,
      "end_codepoint": 126
    },
    {
      "pdf_page": 67,
      "half": "右",
      "leaf": "十七下",
      "column_from_right": 10,
      "reading": "紫未序會疾卒徵幼聰慧璟異之常謂親從曰此兒非",
      "start_codepoint": 126,
      "end_codepoint": 147
    },
    {
      "pdf_page": 67,
      "half": "左",
      "leaf": "十八上",
      "column_from_right": 1,
      "reading": "常器所憂者壽若天假其年吾無恨矣既長美風采好",
      "start_codepoint": 147,
      "end_codepoint": 168
    },
    {
      "pdf_page": 67,
      "half": "左",
      "leaf": "十八上",
      "column_from_right": 2,
      "reading": "學善屬文初為安西安成王法曹遷尚書金部三公二",
      "start_codepoint": 168,
      "end_codepoint": 189
    },
    {
      "pdf_page": 67,
      "half": "左",
      "leaf": "十八上",
      "column_from_right": 3,
      "reading": "曹郎豫章王記室兼中書舍人遷除平北諮議參軍兼",
      "start_codepoint": 189,
      "end_codepoint": 210
    },
    {
      "pdf_page": 67,
      "half": "左",
      "leaf": "十八上",
      "column_from_right": 4,
      "reading": "鴻臚卿舍人如故徵與河東裴子野沛國劉顯同官友",
      "start_codepoint": 210,
      "end_codepoint": 231
    },
    {
      "pdf_page": 67,
      "half": "左",
      "leaf": "十八上",
      "column_from_right": 5,
      "reading": "善子野嘗為寒夜直宿賦以贈徵徵為感友賦以酬之",
      "start_codepoint": 231,
      "end_codepoint": 252
    },
    {
      "pdf_page": 67,
      "half": "左",
      "leaf": "十八上",
      "column_from_right": 6,
      "reading": "時魏中山王元略還北高祖餞於武德殿賦詩三十韻",
      "start_codepoint": 252,
      "end_codepoint": 273
    },
    {
      "pdf_page": 67,
      "half": "左",
      "leaf": "十八上",
      "column_from_right": 7,
      "reading": "限三刻成徵二刻便就其辭甚美高祖再覽焉又為臨",
      "start_codepoint": 273,
      "end_codepoint": 294
    },
    {
      "pdf_page": 67,
      "half": "左",
      "leaf": "十八上",
      "column_from_right": 8,
      "reading": "汝侯淵猷製放生文亦見賞於世中大通元年以父喪",
      "start_codepoint": 294,
      "end_codepoint": 315
    },
    {
      "pdf_page": 67,
      "half": "左",
      "leaf": "十八上",
      "column_from_right": 9,
      "reading": "去職續又丁母憂詔起為貞威將軍還攝本任服闋除",
      "start_codepoint": 315,
      "end_codepoint": 336
    },
    {
      "pdf_page": 67,
      "half": "左",
      "leaf": "十八上",
      "column_from_right": 10,
      "reading": "尚書左丞三年昭明太子薨高祖立晉安王綱為皇太",
      "start_codepoint": 336,
      "end_codepoint": 357
    },
    {
      "pdf_page": 68,
      "half": "右",
      "leaf": "十八下",
      "column_from_right": 1,
      "reading": "子將出詔唯召尚書左僕射何敬容宣惠將軍孔休源",
      "start_codepoint": 357,
      "end_codepoint": 378
    },
    {
      "pdf_page": 68,
      "half": "右",
      "leaf": "十八下",
      "column_from_right": 2,
      "reading": "及徵三人與議徵時年位尚輕而任遇已重四年累遷",
      "start_codepoint": 378,
      "end_codepoint": 399
    },
    {
      "pdf_page": 68,
      "half": "右",
      "leaf": "十八下",
      "column_from_right": 3,
      "reading": "中書郎鴻臚卿舍人如故六年出為北中郎豫章王長",
      "start_codepoint": 399,
      "end_codepoint": 420
    },
    {
      "pdf_page": 68,
      "half": "右",
      "leaf": "十八下",
      "column_from_right": 4,
      "reading": "史南蘭陵太守大同二年卒官時年三十七友人琅邪",
      "start_codepoint": 420,
      "end_codepoint": 441
    },
    {
      "pdf_page": 68,
      "half": "右",
      "leaf": "十八下",
      "column_from_right": 5,
      "reading": "王籍集其文為二十卷",
      "start_codepoint": 441,
      "end_codepoint": 450
    }
  ],
