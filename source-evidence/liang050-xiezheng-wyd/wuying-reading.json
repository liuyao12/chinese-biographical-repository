  "collation_notes": [
    {
      "print_quote": "謝徵字玄度",
      "start": 0,
      "end": 5,
      "columns": [
        {
          "pdf_page": 67,
          "half": "右",
          "leaf": "十七下",
          "column_from_right": 4
        }
      ],
      "note": "殿本題徵，與梁書數位本同。南史同段姓名作微。"
    },
    {
      "print_quote": "祖稚宋司徒主簿",
      "start": 20,
      "end": 27,
      "columns": [
        {
          "pdf_page": 67,
          "half": "右",
          "leaf": "十七下",
          "column_from_right": 4
        },
        {
          "pdf_page": 67,
          "half": "右",
          "leaf": "十七下",
          "column_from_right": 5
        }
      ],
      "note": "祖名稚，官宋司徒主簿。宋書後嗣另見稺字形。"
    },
    {
      "print_quote": "用為侍中固辭年老求金紫未序會疾卒",
      "start": 116,
      "end": 132,
      "columns": [
        {
          "pdf_page": 67,
          "half": "右",
          "leaf": "十七下",
          "column_from_right": 9
        },
        {
          "pdf_page": 67,
          "half": "右",
          "leaf": "十七下",
          "column_from_right": 10
        }
      ],
      "note": "璟辭侍中、求金紫。兩事分記。"
    },
    {
      "print_quote": "尚書左僕射何敬容",
      "start": 363,
      "end": 371,
      "columns": [
        {
          "pdf_page": 68,
          "half": "右",
          "leaf": "十八下",
          "column_from_right": 1
        }
      ],
      "note": "此刻明作左。南史與梁武帝紀另有右字。"
    },
    {
      "print_quote": "製放生文",
      "start": 298,
      "end": 302,
      "columns": [
        {
          "pdf_page": 67,
          "half": "左",
          "leaf": "十八上",
          "column_from_right": 8
        }
      ],
      "note": "數位本作制。"
    },
    {
      "print_quote": "卒官時年三十七友人琅邪王籍集其文為二十卷",
      "start": 430,
      "end": 450,
      "columns": [
        {
          "pdf_page": 68,
          "half": "右",
          "leaf": "十八下",
          "column_from_right": 4
        },
        {
          "pdf_page": 68,
          "half": "右",
          "leaf": "十八下",
          "column_from_right": 5
        }
      ],
      "note": "報齡及卷數俱見。二十卷所指是謝徵之文。"
    }
