  "file_description_revision": 1298729844,
  "pdf_sha256": "020c8ce42595fcca7c41ebf3960599287aa83cffeb6dfb846cc0156a2b8793ef",
  "column_file": "source-evidence/nan011-liuzhirong-izumo/izumo-columns.txt",
  "column_file_sha256": "0cfd246d62c81533c379c68cc721666e16113417efb464ea7eafff6170379c70",
  "columns": [
    {
      "pdf_page": 18,
      "half": "左",
      "leaf": "十六上",
      "column_from_right": 7,
      "reading": "高昭劉皇后諱智容廣陵人也祖玄之父壽之",
      "start_codepoint": 0,
      "end_codepoint": 18
    },
    {
      "pdf_page": 18,
      "half": "左",
      "leaf": "十六上",
      "column_from_right": 8,
      "reading": "並員外郎后母桓氏夢吞玉勝生后時有紫光",
      "start_codepoint": 18,
      "end_codepoint": 36
    },
    {
      "pdf_page": 18,
      "half": "左",
      "leaf": "十六上",
      "column_from_right": 9,
      "reading": "滿室以告壽之壽之曰恨非是男桓笑曰雖女",
      "start_codepoint": 36,
      "end_codepoint": 54
    },
    {
      "pdf_page": 19,
      "half": "右",
      "leaf": "十六下",
      "column_from_right": 1,
      "reading": "亦足興家矣后寢臥見有羽蓋蔭其上家人試",
      "start_codepoint": 54,
      "end_codepoint": 72
    },
    {
      "pdf_page": 19,
      "half": "右",
      "leaf": "十六下",
      "column_from_right": 2,
      "reading": "察之常見其上掩藹如似雲氣年十七裴方明",
      "start_codepoint": 72,
      "end_codepoint": 90
    },
    {
      "pdf_page": 19,
      "half": "右",
      "leaf": "十六下",
      "column_from_right": 3,
      "reading": "為子求婚酬許已定后夢見先有迎車至猶如",
      "start_codepoint": 90,
      "end_codepoint": 108
    },
    {
      "pdf_page": 19,
      "half": "右",
      "leaf": "十六下",
      "column_from_right": 4,
      "reading": "常家迎法后不肯去次有迎至龍旂豹尾有異",
      "start_codepoint": 108,
      "end_codepoint": 126
    },
    {
      "pdf_page": 19,
      "half": "右",
      "leaf": "十六下",
      "column_from_right": 5,
      "reading": "於常后喜而從之既而與裴氏不成婚竟嬪于",
      "start_codepoint": 126,
      "end_codepoint": 144
    },
    {
      "pdf_page": 19,
      "half": "右",
      "leaf": "十六下",
      "column_from_right": 6,
      "reading": "上嚴整有軌度造次必依禮法生太子及豫章",
      "start_codepoint": 144,
      "end_codepoint": 162
    },
    {
      "pdf_page": 19,
      "half": "右",
      "leaf": "十六下",
      "column_from_right": 7,
      "reading": "王嶷太子初在孕后嘗歸寧遇家奉祠爾日陰",
      "start_codepoint": 162,
      "end_codepoint": 180
    },
    {
      "pdf_page": 19,
      "half": "右",
      "leaf": "十六下",
      "column_from_right": 8,
      "reading": "晦失曉舉家狼狽共營祭食后助炒胡麻始復",
      "start_codepoint": 180,
      "end_codepoint": 198
    },
    {
      "pdf_page": 19,
      "half": "右",
      "leaf": "十六下",
      "column_from_right": 9,
      "reading": "內薪未及索火火便自然宋泰豫元年殂歸葬",
      "start_codepoint": 198,
      "end_codepoint": 216
    },
    {
      "pdf_page": 19,
      "half": "左",
      "leaf": "十七上",
      "column_from_right": 1,
      "reading": "宣帝墓側則泰安陵也門生王清與墓工始下",
      "start_codepoint": 216,
      "end_codepoint": 234
    },
    {
      "pdf_page": 19,
      "half": "左",
      "leaf": "十七上",
      "column_from_right": 2,
      "reading": "鍤有白兔跳起尋之不得及墳成兔還栖其上",
      "start_codepoint": 234,
      "end_codepoint": 252
    },
    {
      "pdf_page": 19,
      "half": "左",
      "leaf": "十七上",
      "column_from_right": 3,
      "reading": "昇明二年贈竟陵公國夫人三年贈齊國妃印",
      "start_codepoint": 252,
      "end_codepoint": 270
    },
    {
      "pdf_page": 19,
      "half": "左",
      "leaf": "十七上",
      "column_from_right": 4,
      "reading": "綬齊建元元年尊諡昭皇后二年贈后父壽之",
      "start_codepoint": 270,
      "end_codepoint": 288
    },
    {
      "pdf_page": 19,
      "half": "左",
      "leaf": "十七上",
      "column_from_right": 5,
      "reading": "金紫光祿大夫母桓氏上虞都鄉君",
      "start_codepoint": 288,
      "end_codepoint": 302
    }
  ],
