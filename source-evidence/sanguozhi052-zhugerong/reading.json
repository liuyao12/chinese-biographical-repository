  "source_clauses": [
    {
      "witness": "roll",
      "quote": "恪、融皆典戎马",
      "raw_start": 10441,
      "raw_end": 10448,
      "raw_line": 76
    },
    {
      "witness": "roll",
      "quote": "弟融襲爵。攝兵業駐公安",
      "raw_start": 10587,
      "raw_end": 10598,
      "raw_line": 80
    },
    {
      "witness": "roll",
      "quote": "权以融代表，后代父瑾领摄。",
      "raw_start": 10698,
      "raw_end": 10711,
      "raw_line": 80
    },
    {
      "witness": "roll",
      "quote": "飲藥而死，三子皆伏誅。",
      "raw_start": 10937,
      "raw_end": 10948,
      "raw_line": 80
    },
    {
      "witness": "roll",
      "quote": "融果刮金印龟，服之而死。",
      "raw_start": 11002,
      "raw_end": 11014,
      "raw_line": 80
    },
    {
      "witness": "s64",
      "quote": "諸葛恪字元遜，瑾長子也。",
      "raw_start": 173,
      "raw_end": 185,
      "raw_line": 12
    },
    {
      "witness": "s64",
      "quote": "與弟公安督融書曰：",
      "raw_start": 3176,
      "raw_end": 3185,
      "raw_line": 29
    },
    {
      "witness": "s51",
      "quote": "壹與全熙、施績攻恪弟公安督融，融自殺。",
      "raw_start": 2535,
      "raw_end": 2554,
      "raw_line": 29
    },
    {
      "witness": "s55",
      "quote": "弟表，字文奧，武庶子也",
      "raw_start": 3803,
      "raw_end": 3814,
      "raw_line": 58
    },
    {
      "witness": "s48",
      "quote": "武衞將軍孫峻伏兵殺恪於殿堂。",
      "raw_start": 800,
      "raw_end": 814,
      "raw_line": 18
    }
  ],
