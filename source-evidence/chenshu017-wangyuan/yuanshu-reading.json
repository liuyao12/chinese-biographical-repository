    },
    {
      "id": "c-chenshu-017-yuanshu-complete:received_sentence2-29",
      "kind": "received_sentence",
      "person_id": "hb9_2gq_205_AA",
      "source_quote": "二年，兼吏部尚書。",
      "reading": "紹泰二年兼吏部尚書。",
