  "pdf_sha1": "32a2be96d1d8e7a5e164b2ceee48a41d402adbc9",
  "pdf_sha256": "22872bc710d5186ea471be514d109391bad12b4403da76e58e24cbbaf59fee2b",
  "book_id": "NLC892-411999000037-306499",
  "column_order": "五上第四欄至五下第四欄，逐半葉自右向左。",
  "columns": [
    {
      "pdf_page": 57,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 4,
      "text": "袁敬字子恭陳郡陽夏人也祖顗宋侍中吏部尚書雍"
    },
    {
      "pdf_page": 57,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 5,
      "text": "州刺史父昂梁侍中司空諡穆公敬純孝有風格幼便"
    },
    {
      "pdf_page": 57,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 6,
      "text": "篤學老而無倦釋褐祕書郎累遷太子舍人洗馬中舍"
    },
    {
      "pdf_page": 57,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 7,
      "text": "人江陵淪覆流寓嶺表高祖受禪敬在廣州依歐陽頠"
    },
    {
      "pdf_page": 57,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 8,
      "text": "及頠卒其子紇據州將有異志敬累諫紇為陳逆順之"
    },
    {
      "pdf_page": 57,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 9,
      "text": "理言甚切至紇終不從高宗即位遣章昭達率衆討紇"
    },
    {
      "pdf_page": 57,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 10,
      "text": "紇將敗之時恨不納敬言朝廷義之其年徵為太子中"
    },
    {
      "pdf_page": 58,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 1,
      "text": "庶子通直散騎常侍俄轉司徒左長史尋遷左民尚書"
    },
    {
      "pdf_page": 58,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 2,
      "text": "轉都官尚書領豫州大中正累遷太常卿散騎常侍金"
    },
    {
      "pdf_page": 58,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 3,
      "text": "紫光祿大夫加特進至德三年卒時年七十九贈左光"
    },
    {
      "pdf_page": 58,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 4,
      "text": "祿大夫諡曰靖德子元友嗣弟泌自有傳兄子樞"
    }
  ],
  "comparisons": [
    {
      "digital": "章昭達率红討紇",
      "printed": "章昭達率衆討紇",
      "locator": "五上第九欄"
    },
    {
      "digital": "諡曰靖德。子元友嗣",
      "printed": "諡曰靖德子元友嗣",
      "locator": "五下第四欄",
      "parallel": "南史斷作「諡靖德子。子元友嗣。」"
    }
  ]
}
