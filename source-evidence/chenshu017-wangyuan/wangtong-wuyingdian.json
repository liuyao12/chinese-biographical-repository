{
  "edition": "清乾隆四年武英殿刻《陳書》第三冊，國家圖書館藏",
  "catalogue_revision": 979553886,
  "permalink": "https://commons.wikimedia.org/w/index.php?oldid=979553886",
  "original_url": "https://upload.wikimedia.org/wikipedia/commons/f/f4/NLC892-411999000037-306499_%E9%99%B3%E6%9B%B8_%E7%AC%AC3%E5%86%8A.pdf",
  "pdf_sha1": "32a2be96d1d8e7a5e164b2ceee48a41d402adbc9",
  "pdf_sha256": "22872bc710d5186ea471be514d109391bad12b4403da76e58e24cbbaf59fee2b",
  "book_id": "NLC892-411999000037-306499",
  "column_order": "每半葉由右向左數；末二欄屬卷末考證。",
  "columns": [
    {
      "pdf_page": 55,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 8,
      "text": "王通字公達琅邪臨沂人也祖份梁左光祿大夫父琳"
    },
    {
      "pdf_page": 55,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 9,
      "text": "司空左長史琳齊代娶梁武帝妹義興長公主有子九"
    },
    {
      "pdf_page": 55,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 10,
      "text": "人並知名通梁世起家國子生舉明經為秘書郎太子"
    },
    {
      "pdf_page": 55,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 1,
      "text": "舍人以帝甥封武陽亭侯累遷王府主簿限外記室參"
    },
    {
      "pdf_page": 55,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 2,
      "text": "軍司徒主簿太子中庶子驃騎廬陵王府給事中郎中"
    },
    {
      "pdf_page": 55,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 3,
      "text": "權何敬容府長史給事黃門侍郎坐事免侯景之亂奔"
    },
    {
      "pdf_page": 55,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 4,
      "text": "于江陵元帝以為散騎常侍遷守太常卿自侯景亂後"
    },
    {
      "pdf_page": 55,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 5,
      "text": "臺內宮室並皆焚燼以通兼起部尚書歸于京師專掌"
    },
    {
      "pdf_page": 55,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 6,
      "text": "繕造江陵陷敬帝承制以通為吏部尚書紹泰元年加"
    },
    {
      "pdf_page": 55,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 7,
      "text": "侍中尚書如故尋為尚書右僕射吏部如故高祖受禪"
    },
    {
      "pdf_page": 55,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 8,
      "text": "遷左僕射侍中如故文帝嗣位領太子少傅天康元年"
    },
    {
      "pdf_page": 55,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 9,
      "text": "為翊右將軍右光祿大夫量置佐史廢帝即位號安右"
    },
    {
      "pdf_page": 55,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 10,
      "text": "將軍又領南徐州大中正太建元年遷左光祿大夫六"
    },
    {
      "pdf_page": 56,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 1,
      "text": "年加特進侍中將軍光祿佐史並如故未拜卒時年七"
    },
    {
      "pdf_page": 56,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 2,
      "text": "十二詔贈本官諡曰成葬日給鼓吹一部弟質弟固各"
    },
    {
      "pdf_page": 56,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 3,
      "text": "有傳"
    },
    {
      "pdf_page": 60,
      "half": "左",
      "leaf": "考證一上",
      "column_from_right": 2,
      "text": "王通傳父琳司空左長史○南史作司徒"
    },
    {
      "pdf_page": 60,
      "half": "左",
      "leaf": "考證一上",
      "column_from_right": 3,
      "text": "王通弟勱乃以勱監吳興郡○監一本作兼"
    }
  ]
}
