    },
    {
      "id": "c-chenshu-017-wangchong-complete:received_sentence5-62",
      "kind": "received_sentence",
      "person_id": "7r6_k52_qji_ABAAAAAABAA",
      "source_quote": "廢帝即位，給親信十人。",
      "reading": "廢帝伯宗即位，給親信十人。",
      "note": "廢帝伯宗即位，給親信十人。",
      "paragraph_id": "c-chenshu-017-wangchong-complete:p005",
