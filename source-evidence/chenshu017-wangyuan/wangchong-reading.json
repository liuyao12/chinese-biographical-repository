      "human_reviewed": false
    },
    {
      "id": "c-chenshu-017-wangchong-complete:received_sentence5-0",
      "kind": "received_sentence",
      "person_id": "7r6_k52_qji_ABAAAAAABAA",
      "source_quote": "高祖受禪，解尹，以本官領左光祿大夫。",
      "reading": "陳武帝受禪，沖解丹陽尹，有領左光祿大夫之命。",
