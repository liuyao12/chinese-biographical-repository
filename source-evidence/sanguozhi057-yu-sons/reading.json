  "section_reviews": [
    {
      "id": "c-sanguozhi-057-yu-sons:line034:reading-000-084",
      "kind": "received_sentence",
      "paragraph_id": "c-sanguozhi-057-yu-sons:line034",
      "start_codepoint": 0,
      "end_codepoint": 84,
      "source_quote": "翻有十一子。第四子汜最知名，永安初，從選曹朗為散騎中常侍，後為監軍使者，討扶嚴，病卒，汜弟忠，宜都太守。聳，越騎校尉。累遷廷尉，湘東、河間太守；昺，廷尉尚書，濟陰太守。",
      "person_id": "izi_e36_p1g",
      "related_person_ids": [
        "83b_fot_7g6",
        "izi_e36_p1g_A",
        "izi_e36_p1g_B",
        "izi_e36_p1g_C"
      ],
      "reading": "翻有十一子，正文敘第四子汜、汜弟忠、聳、昺。選曹朗為數位原字。"
    },
    {
      "id": "c-sanguozhi-057-yu-sons:line034-pei01-01:reading-000-213",
      "kind": "annotation_sentence",
      "paragraph_id": "c-sanguozhi-057-yu-sons:line034-pei01-01",
      "start_codepoint": 0,
      "end_codepoint": 213,
      "source_quote": "《会稽典录》曰：汜字世洪，生南海，年十六，父卒，还乡里。孙綝废幼主，迎立琅邪王休。休未至，綝欲入宫，图为不轨，召百官会议，皆惶怖失色，徒唯唯而已。汜对曰：“明公为国伊周，处将相之位，擅废立之威，将上安宗庙，下惠百姓，大小踊跃，自以伊霍复见。今迎王未至，而欲入宫，如是，群下摇荡，众听疑惑，非所以永终忠孝，扬名后世也。”綝不怿，竟立休。休初即位，汜与贺邵、王蕃、薛莹俱为散骑中常侍。以讨扶严功拜交州刺史、冠军将军、餘姚侯，寻卒。",
      "person_id": "83b_fot_7g6",
      "related_person_ids": [
        "hzw_vox_wvw",
        "hqp_o1w_ihy",
        "0fo_c5c_4yh",
        "itn_zi2_il4",
        "y4i_pjk_4gn_AD",
        "eug_nzm_5pu",
        "n40_190_783",
        "z8o_i3j_zja",
        "57a_8f8_a32"
      ],
      "reading": "裴引會稽典錄。汜生南海，父卒時汜十六。孫綝廢幼主、迎孫休，汜諫；討扶嚴後所拜官爵別於正文。伊周、伊霍為引古。"
    },
    {
      "id": "c-sanguozhi-057-yu-sons:line034-pei02-01:reading-000-122",
      "kind": "annotation_sentence",
      "paragraph_id": "c-sanguozhi-057-yu-sons:line034-pei02-01",
      "start_codepoint": 0,
      "end_codepoint": 122,
      "source_quote": "《会稽典录》曰：忠字世方，翻第五子。贞固幹事，好识人物，造吴郡陆机於童龀之年，称上虞魏迁於无名之初，终皆远致，为著闻之士。交同县王岐於孤宦之族，仕进先至宜都太守，忠乃代之。晋征吴，忠与夷道监陆晏、晏弟中夏督景坚守不下，城溃被害。忠子谭，字思奥。",
      "person_id": "izi_e36_p1g_A",
      "related_person_ids": [
        "izi_e36_p1g",
        "69h_uhy_hta",
        "t74_kzr_xuo",
        "cly_a7h_9rg",
        "40p_eb9_ggr_B",
        "40p_eb9_ggr_A",
        "9v9_cj5_dor"
      ],
      "reading": "裴引會稽典錄。第五子忠字世方，與夷道監陸晏、晏弟陸景守城；忠子谭字思奥。此句尚屬典錄，下段始引晉陽秋。"
    },
    {
      "id": "c-sanguozhi-057-yu-sons:line034-pei02-02:reading-000-056",
      "kind": "annotation_sentence",
      "paragraph_id": "c-sanguozhi-057-yu-sons:line034-pei02-02",
      "start_codepoint": 0,
      "end_codepoint": 56,
      "source_quote": "《晋阳秋》称谭清贞有检操，外如退弱，内坚正有胆幹。仕晋，历位内外，终於卫将军，追赠侍中左光禄大夫，开府仪同三司。",
      "person_id": "9v9_cj5_dor",
      "related_person_ids": [],
      "reading": "晉陽秋記仕晉及追贈，受贈者為忠子谭。數位本谭與晉書潭分按原字。"
    },
    {
      "id": "c-sanguozhi-057-yu-sons:line034-pei03-01:reading-000-168",
      "kind": "annotation_sentence",
      "paragraph_id": "c-sanguozhi-057-yu-sons:line034-pei03-01",
      "start_codepoint": 0,
      "end_codepoint": 168,
      "source_quote": "《会稽典录》曰：耸字世龙，翻第六子也。清虚无欲，进退以礼，在吴历清官，入晋，除河间相，王素闻耸名，厚敬礼之。耸抽引人物，务在幽隐孤陋之中。时王岐难耸，以高士所达，必合秀异，耸书与族子察曰：“世之取士，曾不招未齿於丘园，索良才於总猥，所誉依已成，所毁依已败，此吾所以叹息也。”耸疾俗丧祭无度，弟昺卒，祭以少牢，酒饭而已，当时族党并遵行之。",
      "person_id": "izi_e36_p1g_B",
      "related_person_ids": [
        "izi_e36_p1g",
        "cly_a7h_9rg",
        "2uq_gdw_tj3",
        "izi_e36_p1g_C"
      ],
      "reading": "第六子，河間相後的王與王岐分讀。與族子察書，弟昺卒祭以少牢。"
    },
    {
      "id": "c-sanguozhi-057-yu-sons:line034-pei04-01:reading-000-092",
      "kind": "annotation_sentence",
      "paragraph_id": "c-sanguozhi-057-yu-sons:line034-pei04-01",
      "start_codepoint": 0,
      "end_codepoint": 92,
      "source_quote": "《会稽典录》曰：昺字世文，翻第八子也。少有倜傥之志，仕吴黄门郎，以捷对见异，超拜尚书侍中。晋军来伐，遣昺持节都督武昌已上诸军事，昺先上还节盖印绶，然后归顺。在济阴，抑强扶弱，甚著威风。",
      "person_id": "izi_e36_p1g_C",
      "related_person_ids": [
        "izi_e36_p1g"
      ],
      "reading": "第八子世文。吳黃門郎、尚書侍中及晉濟陰施政。歸順前先還持節等；所還節印有動作先後。"
    }
  ],
