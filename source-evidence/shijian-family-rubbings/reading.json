      "column_positions": [
        {
          "face": "誌陽",
          "column_from_right": 1,
          "text": "處士樂陵厭次都鄉清明里石定字庶公太尉昌安",
          "extent": "full_column_or_visible_clause",
          "start": 0,
          "end": 20,
          "image_url": "https://img.dpm.org.cn/Uploads/Picture/dc/15341[1024].jpg"
        },
        {
          "face": "誌陽",
          "column_from_right": 2,
          "text": "元公之第三孫尚書城陽鄉侯之適子也",
          "extent": "top",
          "start": 20,
          "end": 36,
          "image_url": "https://img.dpm.org.cn/Uploads/Picture/dc/15341[1024].jpg"
        },
        {
          "face": "誌陽",
          "column_from_right": 4,
          "text": "永嘉元年逆賊汲桑破鄴都",
          "extent": "bottom",
          "start": 37,
          "end": 48,
          "image_url": "https://img.dpm.org.cn/Uploads/Picture/dc/15341[1024].jpg"
        },
        {
          "face": "誌陽",
          "column_from_right": 5,
          "text": "之後遂肆凶暴鼓行東北其年九月五日攻圍侯侯",
          "extent": "full_column_or_visible_clause",
          "start": 48,
          "end": 68,
          "image_url": "https://img.dpm.org.cn/Uploads/Picture/dc/15341[1024].jpg"
        },
        {
          "face": "誌陽",
          "column_from_right": 6,
          "text": "親率邑族臨危奮討眾寡不敵七日城陷侯薨定與",
          "extent": "full_column_or_visible_clause",
          "start": 68,
          "end": 88,
          "image_url": "https://img.dpm.org.cn/Uploads/Picture/dc/15341[1024].jpg"
        },
        {
          "face": "誌陽",
          "column_from_right": 7,
          "text": "弟邁致命左右年廿八",
          "extent": "top",
          "start": 88,
          "end": 97,
          "image_url": "https://img.dpm.org.cn/Uploads/Picture/dc/15341[1024].jpg"
        },
        {
          "face": "誌陽",
          "column_from_right": 8,
          "text": "二年七月十九日祔葬于侯墓之右次",
          "extent": "after_嗟慟",
          "start": 98,
          "end": 113,
          "image_url": "https://img.dpm.org.cn/Uploads/Picture/dc/15341[1024].jpg"
        },
        {
          "face": "誌陽",
          "column_from_right": 10,
          "text": "妻沛國劉氏字貴華父字終嘏晉故太常卿",
          "extent": "full_column_or_visible_clause",
          "start": 114,
          "end": 131,
          "image_url": "https://img.dpm.org.cn/Uploads/Picture/dc/15341[1024].jpg"
        }
