      "paragraph_id": "c-epitaph-shixian-excerpts:p001",
      "column_positions": [
        {
          "face": "陽",
          "column_from_right": 1,
          "text": "晉故尚書征虜將軍幽州刺史城陽簡侯樂陵厭次",
          "extent": "full_column_or_visible_clause",
          "start": 0,
          "end": 20,
          "image_url": "https://img.dpm.org.cn/Uploads/Picture/dc/15339[1024].jpg"
        },
        {
          "face": "陽",
          "column_from_right": 2,
          "text": "都鄉清明里石尠字處約侍中太尉昌安元公第二",
          "extent": "full_column_or_visible_clause",
          "start": 20,
          "end": 40,
          "image_url": "https://img.dpm.org.cn/Uploads/Picture/dc/15339[1024].jpg"
        },
        {
          "face": "陽",
          "column_from_right": 3,
          "text": "子也",
          "extent": "top",
          "start": 40,
          "end": 42,
          "image_url": "https://img.dpm.org.cn/Uploads/Picture/dc/15339[1024].jpg"
        },
        {
          "face": "陰",
          "column_from_right": 3,
          "text": "永嘉元年逆",
          "extent": "bottom",
          "start": 43,
          "end": 48,
          "image_url": "https://img.dpm.org.cn/Uploads/Picture/dc/15338[1024].jpg"
        },
        {
          "face": "陰",
          "column_from_right": 4,
          "text": "賊汲桑破鄴都之後遂肆其凶暴東北其年九月五",
          "extent": "full_column_or_visible_clause",
          "start": 48,
          "end": 68,
          "image_url": "https://img.dpm.org.cn/Uploads/Picture/dc/15338[1024].jpg"
        },
        {
          "face": "陰",
          "column_from_right": 5,
          "text": "日奄見攻圍尠親率邑族臨危守節義舊不回眾寡",
          "extent": "full_column_or_visible_clause",
          "start": 68,
          "end": 88,
          "image_url": "https://img.dpm.org.cn/Uploads/Picture/dc/15338[1024].jpg"
        },
        {
          "face": "陰",
          "column_from_right": 6,
          "text": "不敵七日城陷薨年六十二",
          "extent": "top",
          "start": 88,
          "end": 99,
          "image_url": "https://img.dpm.org.cn/Uploads/Picture/dc/15338[1024].jpg"
        },
        {
          "face": "陰",
          "column_from_right": 7,
          "text": "二年七月十九日祔葬于皇考墓側神道",
          "extent": "after_護喪",
          "start": 100,
          "end": 116,
          "image_url": "https://img.dpm.org.cn/Uploads/Picture/dc/15338[1024].jpg"
        },
        {
          "face": "陰",
          "column_from_right": 8,
          "text": "之右",
          "extent": "top",
          "start": 116,
          "end": 118,
          "image_url": "https://img.dpm.org.cn/Uploads/Picture/dc/15338[1024].jpg"
        },
        {
          "face": "陰",
          "column_from_right": 8,
          "text": "庶子恭嗣",
          "extent": "middle",
          "start": 119,
          "end": 123,
          "image_url": "https://img.dpm.org.cn/Uploads/Picture/dc/15338[1024].jpg"
        },
        {
          "face": "夫人側",
          "column_from_right": 1,
          "text": "夫人廣平臨水劉氏字阿容父字世穎晉故步兵校",
          "extent": "full_column_or_visible_clause",
          "start": 124,
          "end": 144,
          "image_url": "https://img.dpm.org.cn/Uploads/Picture/dc/15337[1024].jpg"
        },
        {
          "face": "夫人側",
          "column_from_right": 2,
          "text": "尉關內侯",
          "extent": "full_column_or_visible_clause",
          "start": 144,
          "end": 148,
          "image_url": "https://img.dpm.org.cn/Uploads/Picture/dc/15337[1024].jpg"
        },
        {
          "face": "夫人側",
          "column_from_right": 3,
          "text": "夫人琅邪陽都諸葛氏字男姊父字長茂晉故廷尉",
          "extent": "full_column_or_visible_clause",
          "start": 149,
          "end": 169,
          "image_url": "https://img.dpm.org.cn/Uploads/Picture/dc/15337[1024].jpg"
        },
        {
          "face": "夫人側",
          "column_from_right": 4,
          "text": "卿平陽鄉侯",
          "extent": "full_column_or_visible_clause",
          "start": 169,
          "end": 174,
          "image_url": "https://img.dpm.org.cn/Uploads/Picture/dc/15337[1024].jpg"
        },
        {
          "face": "子女側",
          "column_from_right": 1,
          "text": "長子定字庶公年廿八",
          "extent": "top",
          "start": 175,
          "end": 184,
          "image_url": "https://img.dpm.org.cn/Uploads/Picture/dc/15336[1024].jpg"
        },
        {
          "face": "子女側",
          "column_from_right": 2,
          "text": "小子邁字庶昆年廿二",
          "extent": "top",
          "start": 185,
          "end": 194,
          "image_url": "https://img.dpm.org.cn/Uploads/Picture/dc/15336[1024].jpg"
        },
        {
          "face": "子女側",
          "column_from_right": 4,
          "text": "女字令脩適黃門侍郎江安侯穎川陳世範",
          "extent": "full_column_or_visible_clause",
          "start": 195,
          "end": 212,
          "image_url": "https://img.dpm.org.cn/Uploads/Picture/dc/15336[1024].jpg"
        }
      ],
