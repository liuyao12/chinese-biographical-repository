  "readings": [
    {
      "topic": "從祖與祖父",
      "text": "正文稱陸康從祖、陸績為康子。家頌別稱紆為遜祖、駿為遜父。所謂從祖不據以填入中間缺名人。"
    },
    {
      "topic": "顧邵與陸遜之妻",
      "text": "兩傳各稱孫策女，未證同人。原人號各別保留。"
    },
    {
      "topic": "江夏太守",
      "digital": "逮式／逯立录／臣松以为……逯式",
      "print": "逯式／逯音錄／臣松之以為",
      "text": "保留兩來源姓字。文聘子休是宿不協的另一人；來歸在陸遜假書中。"
    },
    {
      "topic": "兩宮諸人",
      "digital": "而遜外生顧譚、顧承、姚信，工以親附太子",
      "print": "而遜外生顧譚顧承姚信並以親附太子",
      "text": "外生管下三名，不填三人生母或其同母。太子為孫和；吳主傳以赤烏八年春二月記遜卒，異於前段七年代丞相。"
    },
    {
      "topic": "丞相詔書",
      "digital": "懷文武之者",
      "print": "懷文武之才者",
      "text": "傅常是傳印使者；守太常所係為傅常。"
    },
    {
      "topic": "書傳與作者意見",
      "text": "吳書、吳錄、陸氏祠堂像贊、陸氏世頌、陸機銘、會稽典錄、吳歷及裴氏評語逐分來源。裴氏所談報應留在評論。"
    }
  ],
