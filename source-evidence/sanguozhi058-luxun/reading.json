  "source_clauses": [
    {
      "witness": "w58",
      "quote": "陸遜字伯言，吳郡吳人也。本名議",
      "raw_start": 185,
      "raw_end": 200,
      "raw_line": 11
    },
    {
      "witness": "w58",
      "quote": "遜少孤，隨從祖廬江太守康在官。",
      "raw_start": 264,
      "raw_end": 279,
      "raw_line": 11
    },
    {
      "witness": "w58",
      "quote": "權以兄策女配遜",
      "raw_start": 505,
      "raw_end": 512,
      "raw_line": 15
    },
    {
      "witness": "w58",
      "quote": "{{YL|赤烏七年}}，代顧雍丞相",
      "raw_start": 5935,
      "raw_end": 5952,
      "raw_line": 53
    },
    {
      "witness": "w58",
      "quote": "長子延早夭，次子抗襲爵。",
      "raw_start": 6542,
      "raw_end": 6554,
      "raw_line": 57
    },
    {
      "witness": "w47",
      "quote": "八年春二月，丞相陸遜卒。",
      "raw_start": 22411,
      "raw_end": 22423,
      "raw_line": 123
    },
    {
      "witness": "w57",
      "quote": "陸績字公紀，吳郡吳人也。父康，漢末為廬江太守。",
      "raw_start": 8028,
      "raw_end": 8051,
      "raw_line": 37
    },
    {
      "witness": "w59",
      "quote": "孫登字子高，權長子也。",
      "raw_start": 216,
      "raw_end": 227,
      "raw_line": 12
    },
    {
      "witness": "w59",
      "quote": "孫慮字子智，登弟也。",
      "raw_start": 2578,
      "raw_end": 2588,
      "raw_line": 25
    },
    {
      "witness": "w52",
      "quote": "權妻以策女。",
      "raw_start": 6708,
      "raw_end": 6714,
      "raw_line": 48
    },
    {
      "witness": "w45",
      "quote": "廖化字元儉，本名淳，襄陽人也。",
      "raw_start": 3955,
      "raw_end": 3970,
      "raw_line": 34
    }
  ],
