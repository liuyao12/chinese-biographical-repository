    },
    {
      "id": "c-nanqishu-032-wangkun-family-intro:received_sentence1-18",
      "kind": "received_sentence",
      "person_id": "7r6_k52_qji_ABAAFBA",
      "source_quote": "父懌，不慧，侍婢生琨，名爲崑崙。",
      "reading": "父懌，侍婢生琨，名崑崙。南史補母名恭心。",
      "note": "父懌，侍婢生琨，名崑崙。南史補母名恭心。",
