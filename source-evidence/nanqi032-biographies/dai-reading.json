      "end_codepoint": 23,
      "human_reviewed": false
    },
    {
      "id": "c-nanqishu-032-zhangdai-family:received_sentence9-23",
      "kind": "received_sentence",
      "person_id": "d50_8f5_wul_AAAAD",
      "source_quote": "太祖知岱歷任清直，至郡未幾，手敕岱曰：「大邦任重，乃未欲回換，但總戎務殷，宜須望實，今用卿爲護軍。」",
      "reading": "太祖使之離郡任護軍，下詔的卿指岱。",
      "note": "太祖使之離郡任護軍，下詔的卿指岱。",
      "paragraph_id": "c-nanqishu-032-zhangdai-family:p009",
      "start_codepoint": 23,
      "end_codepoint": 73,
      "human_reviewed": false
    },
    {
      "id": "c-nanqishu-032-zhangdai-family:received_sentence9-73",
      "kind": "received_sentence",
      "person_id": "d50_8f5_wul_AAAAD",
      "source_quote": "加給事中。",
      "reading": "加給事中。",
      "note": "加給事中。",
      "paragraph_id": "c-nanqishu-032-zhangdai-family:p009",
      "start_codepoint": 73,
      "end_codepoint": 78,
      "human_reviewed": false
    },
    {
