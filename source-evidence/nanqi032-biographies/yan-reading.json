      "paragraph_id": "c-nanqishu-032-wangyanzhi:line077",
      "start_codepoint": 35,
      "end_codepoint": 46,
      "source_quote": "延之出繼伯父秀才粲之。",
      "reading": "延之出繼伯父王粲之，秀才為粲之所稱，現有生、繼兩端點依原證。",
      "note": "延之出繼伯父王粲之，秀才為粲之所稱，現有生、繼兩端點依原證。",
      "human_reviewed": false
    },
    {
      "id": "qi32-yan-79-0-received_sentence",
      "kind": "received_sentence",
      "person_id": "7r6_k52_qji_ABDABAACA",
      "paragraph_id": "c-nanqishu-032-wangyanzhi:line079",
      "start_codepoint": 0,
      "end_codepoint": 12,
      "source_quote": "延之少而靜默，不交人事。",
      "reading": "少靜默少交游。",
      "note": "少靜默少交游。",
      "human_reviewed": false
    },
    {
      "id": "qi32-yan-79-12-received_sentence",
      "kind": "received_sentence",
      "person_id": "7r6_k52_qji_ABDABAACA",
      "paragraph_id": "c-nanqishu-032-wangyanzhi:line079",
      "start_codepoint": 12,
      "end_codepoint": 20,
      "source_quote": "州辟主簿，不就。",
      "reading": "州辟主簿，未就。",
      "note": "州辟主簿，未就。",
      "human_reviewed": false
    },
    {
