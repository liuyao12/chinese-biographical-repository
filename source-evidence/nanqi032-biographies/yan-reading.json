      "kind": "received_sentence",
      "person_id": "7r6_k52_qji_ABDABAACA",
      "paragraph_id": "c-nanqishu-032-wangyanzhi:line081",
      "start_codepoint": 58,
      "end_codepoint": 69,
      "source_quote": "罷郡還，家產無所增益。",
      "reading": "罷郡家產無增。",
      "note": "罷郡家產無增。",
      "human_reviewed": false
    },
    {
