      "paragraph_id": "c-nanqishu-032-wangyanzhi:line077",
      "start_codepoint": 14,
      "end_codepoint": 26,
      "source_quote": "祖裕，宋左光祿儀同三司。",
      "reading": "祖王裕的宋官。",
      "note": "祖王裕的宋官。",
      "human_reviewed": false
    },
    {
