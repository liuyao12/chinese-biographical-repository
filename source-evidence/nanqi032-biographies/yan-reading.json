      "kind": "received_sentence",
      "person_id": "7r6_k52_qji_ABDABAACA",
      "paragraph_id": "c-nanqishu-032-wangyanzhi:line077",
      "start_codepoint": 26,
      "end_codepoint": 35,
      "source_quote": "父昇之，都官尚書。",
      "reading": "父王昇之任都官尚書。",
      "note": "父王昇之任都官尚書。",
      "human_reviewed": false
    },
    {
      "id": "qi32-yan-77-35-received_sentence",
