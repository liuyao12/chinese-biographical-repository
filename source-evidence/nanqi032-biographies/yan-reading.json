      "person_id": "7r6_k52_qji_ABDABAACA",
      "paragraph_id": "c-nanqishu-032-wangyanzhi:line081",
      "start_codepoint": 154,
      "end_codepoint": 164,
      "source_quote": "昇明二年，轉左僕射。",
      "reading": "昇明二年478年轉左僕射。",
