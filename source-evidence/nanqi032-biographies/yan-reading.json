      "person_id": "7r6_k52_qji_ABDABAACA",
      "paragraph_id": "c-nanqishu-032-wangyanzhi:line081",
      "start_codepoint": 124,
      "end_codepoint": 137,
      "source_quote": "轉侍中，祕書監，晉熙王師。",
      "reading": "侍中、祕書監並為晉熙王師。",
      "note": "侍中、祕書監並為晉熙王師。",
      "human_reviewed": false
    },
    {
