  "chapter_id": "c-sanguozhi-026-guohuai",
  "units": [
    {
      "paragraph_id": "c-sanguozhi-026-guohuai:unit001",
      "text": "郭淮字伯濟太原陽曲人也",
      "text_layer": "received_chapter",
      "source_position": {
        "first_line": 302,
        "last_line": 302,
        "revision_id": "214fcafa79894355909c9d8c2c1533089e7791c6",
        "projection_sha256": "9d6e928acfe223605e3473d7ce06c4a9c98b0f5ac1053c30aa15984660f80826",
        "source_fragments": [
          {
            "line": 302,
            "raw_start": 0,
            "raw_end": 11,
            "text": "郭淮字伯濟太原陽曲人也"
          }
        ],
        "source_layer": "received_biography"
      }
    },
    {
      "paragraph_id": "c-sanguozhi-026-guohuai:unit002",
      "text": "按郭氏譜淮祖全大司農父緼鴈門太守",
      "text_layer": "witness_appended_pei_songzhi_note",
      "source_position": {
        "first_line": 302,
        "last_line": 302,
        "revision_id": "214fcafa79894355909c9d8c2c1533089e7791c6",
        "projection_sha256": "812f07703b93f010dfd6a4e5288525d6de80539747c07afe58fa67b17459a0ba",
        "source_fragments": [
          {
            "line": 302,
            "raw_start": 12,
            "raw_end": 28,
            "text": "按郭氏譜淮祖全大司農父緼鴈門太守"
          }
        ],
        "source_layer": "pei_annotation"
      }
    },
    {
      "paragraph_id": "c-sanguozhi-026-guohuai:unit003",
      "text": "建安中舉孝廉除平原府丞文帝為五官將召淮署為門下賊曹轉為丞相兵曹議令史從征漢中太祖還留征西將軍夏侯淵拒劉備以淮為淵司馬淵與備戰淮時有疾不出淵遇害軍中擾擾淮收散卒推盪冦將軍張郃為軍主諸營乃定其明日備欲渡漢水來攻諸將議衆寡不敵備便乘勝欲依水為陣以拒之淮曰此示弱而不足挫敵非筭也不如遠水為陣引而致之半濟而後擊備可破也既陣備疑不渡淮遂堅守示無還心以狀聞太祖善之假郃節復以淮為司馬文帝即王位賜爵關内侯轉為鎮西長史又行征羌䕶軍䕶左將軍張郃冠軍將軍楊秋討山賊鄭甘盧水叛胡皆破平之關中始定民得安業",
      "text_layer": "received_chapter",
      "source_position": {
        "first_line": 302,
        "last_line": 315,
        "revision_id": "214fcafa79894355909c9d8c2c1533089e7791c6",
        "projection_sha256": "de013b315cd1c034eaea95e0af6670dc725762fd5f787704e546c76de9806eba",
        "source_fragments": [
          {
            "line": 302,
            "raw_start": 29,
            "raw_end": 31,
            "text": "建安"
          },
          {
            "line": 303,
            "raw_start": 0,
            "raw_end": 21,
            "text": "中舉孝廉除平原府丞文帝為五官將召淮署為門下"
          },
          {
            "line": 304,
            "raw_start": 0,
            "raw_end": 21,
            "text": "賊曹轉為丞相兵曹議令史從征漢中太祖還留征西"
          },
          {
            "line": 305,
            "raw_start": 0,
            "raw_end": 21,
            "text": "將軍夏侯淵拒劉備以淮為淵司馬淵與備戰淮時有"
          },
          {
            "line": 306,
            "raw_start": 0,
            "raw_end": 21,
            "text": "疾不出淵遇害軍中擾擾淮收散卒推盪冦將軍張郃"
          },
          {
            "line": 307,
            "raw_start": 0,
            "raw_end": 21,
            "text": "為軍主諸營乃定其明日備欲渡漢水來攻諸將議衆"
          },
          {
            "line": 308,
            "raw_start": 0,
            "raw_end": 21,
            "text": "寡不敵備便乘勝欲依水為陣以拒之淮曰此示弱而"
          },
          {
            "line": 309,
            "raw_start": 0,
            "raw_end": 21,
            "text": "不足挫敵非筭也不如遠水為陣引而致之半濟而後"
          },
          {
            "line": 310,
            "raw_start": 0,
            "raw_end": 21,
            "text": "擊備可破也既陣備疑不渡淮遂堅守示無還心以狀"
          },
          {
            "line": 312,
            "raw_start": 0,
            "raw_end": 21,
            "text": "聞太祖善之假郃節復以淮為司馬文帝即王位賜爵"
          },
          {
            "line": 313,
            "raw_start": 0,
            "raw_end": 21,
            "text": "關内侯轉為鎮西長史又行征羌䕶軍䕶左將軍張郃"
          },
          {
            "line": 314,
            "raw_start": 0,
            "raw_end": 21,
            "text": "冠軍將軍楊秋討山賊鄭甘盧水叛胡皆破平之關中"
          },
          {
            "line": 315,
            "raw_start": 0,
            "raw_end": 6,
            "text": "始定民得安業"
          }
        ],
        "source_layer": "received_biography"
      }
    },
    {
      "paragraph_id": "c-sanguozhi-026-guohuai:unit004",
      "text": "黃初元年奉使賀文帝踐阼而道路得疾故計遠近為稽留及羣臣歡㑹帝正色責之曰昔禹㑹諸侯於塗山防風後至便行大戮今溥天同慶而卿最留遲何也淮對曰臣聞五帝先教導民以徳夏后政衰始用刑辟今臣遭唐虞之世是以自知免於防風之誅也帝悅之擢領雍州刺史封射陽亭侯五年為真安定羌大帥辟蹏反討破降之每羌胡來降淮輒先使人推問其親理男女多少年歲長幼及見一一知其欵曲訊問周至咸稱神明",
      "text_layer": "received_chapter",
      "source_position": {
        "first_line": 315,
        "last_line": 324,
        "revision_id": "214fcafa79894355909c9d8c2c1533089e7791c6",
        "projection_sha256": "9358dea2079e905b63d304ec217caa8d27e3105715d319556225d94aba532f9b",
        "source_fragments": [
          {
            "line": 315,
            "raw_start": 6,
            "raw_end": 21,
            "text": "黃初元年奉使賀文帝踐阼而道路得"
          },
          {
            "line": 316,
            "raw_start": 0,
            "raw_end": 21,
            "text": "疾故計遠近為稽留及羣臣歡㑹帝正色責之曰昔禹"
          },
          {
            "line": 317,
            "raw_start": 0,
            "raw_end": 21,
            "text": "㑹諸侯於塗山防風後至便行大戮今溥天同慶而卿"
          },
          {
            "line": 318,
            "raw_start": 0,
            "raw_end": 21,
            "text": "最留遲何也淮對曰臣聞五帝先教導民以徳夏后政"
          },
          {
            "line": 320,
            "raw_start": 0,
            "raw_end": 21,
            "text": "衰始用刑辟今臣遭唐虞之世是以自知免於防風之"
          },
          {
            "line": 321,
            "raw_start": 0,
            "raw_end": 21,
            "text": "誅也帝悅之擢領雍州刺史封射陽亭侯五年為真安"
          },
          {
            "line": 322,
            "raw_start": 0,
            "raw_end": 21,
            "text": "定羌大帥辟蹏反討破降之每羌胡來降淮輒先使人"
          },
          {
            "line": 323,
            "raw_start": 0,
            "raw_end": 21,
            "text": "推問其親理男女多少年歲長幼及見一一知其欵曲"
          },
          {
            "line": 324,
            "raw_start": 0,
            "raw_end": 8,
            "text": "訊問周至咸稱神明"
          }
        ],
        "source_layer": "received_biography"
      }
    },
    {
      "paragraph_id": "c-sanguozhi-026-guohuai:unit005",
      "text": "太和二年蜀相諸葛亮出祁山遣將軍馬謖至街亭高詳屯列柳城張郃擊謖淮攻詳營皆破之又破隴西名羌唐蹏於枹罕加建威將軍五年蜀出鹵城是時隴右無榖議欲關中大運淮以威恩撫循羌胡家使出榖平其輸調軍食用足轉揚武將軍",
      "text_layer": "received_chapter",
      "source_position": {
        "first_line": 324,
        "last_line": 328,
        "revision_id": "214fcafa79894355909c9d8c2c1533089e7791c6",
        "projection_sha256": "9194f6865511548a6d81ea40f4f660be6d4b0caa1d2cf5353de2c5a87c113bc5",
        "source_fragments": [
          {
            "line": 324,
            "raw_start": 8,
            "raw_end": 21,
            "text": "太和二年蜀相諸葛亮出祁山遣"
          },
          {
            "line": 325,
            "raw_start": 0,
            "raw_end": 21,
            "text": "將軍馬謖至街亭高詳屯列柳城張郃擊謖淮攻詳營"
          },
          {
            "line": 326,
            "raw_start": 0,
            "raw_end": 21,
            "text": "皆破之又破隴西名羌唐蹏於枹罕加建威將軍五年"
          },
          {
            "line": 327,
            "raw_start": 0,
            "raw_end": 21,
            "text": "蜀出鹵城是時隴右無榖議欲關中大運淮以威恩撫"
          },
          {
            "line": 328,
            "raw_start": 0,
            "raw_end": 20,
            "text": "循羌胡家使出榖平其輸調軍食用足轉揚武將軍"
          }
        ],
        "source_layer": "received_biography"
      }
    },
    {
      "paragraph_id": "c-sanguozhi-026-guohuai:unit006",
      "text": "青龍二年諸葛亮出斜谷並田于蘭坑是時司馬宣王屯渭南淮策亮必爭北原宜先據之議者多謂不然淮曰若亮跨渭登原連兵北山隔絶隴道搖蕩民夷此非國之利也宣王善之淮遂屯北原塹壘未成蜀兵大至淮逆擊之後數日亮盛兵西行諸將皆謂欲攻西圍淮獨以為此見形於西欲使官兵重應之必攻陽遂耳其夜果攻陽遂有備不得上",
      "text_layer": "received_chapter",
      "source_position": {
        "first_line": 328,
        "last_line": 336,
        "revision_id": "214fcafa79894355909c9d8c2c1533089e7791c6",
        "projection_sha256": "789ced4ebc7479ed6ea5a48bf868a323dc56c9c9f31597fd4f6203ab3056f0c3",
        "source_fragments": [
          {
            "line": 328,
            "raw_start": 20,
            "raw_end": 21,
            "text": "青"
          },
          {
            "line": 330,
            "raw_start": 0,
            "raw_end": 21,
            "text": "龍二年諸葛亮出斜谷並田于蘭坑是時司馬宣王屯"
          },
          {
            "line": 331,
            "raw_start": 0,
            "raw_end": 21,
            "text": "渭南淮策亮必爭北原宜先據之議者多謂不然淮曰"
          },
          {
            "line": 332,
            "raw_start": 0,
            "raw_end": 21,
            "text": "若亮跨渭登原連兵北山隔絶隴道搖蕩民夷此非國"
          },
          {
            "line": 333,
            "raw_start": 0,
            "raw_end": 21,
            "text": "之利也宣王善之淮遂屯北原塹壘未成蜀兵大至淮"
          },
          {
            "line": 334,
            "raw_start": 0,
            "raw_end": 21,
            "text": "逆擊之後數日亮盛兵西行諸將皆謂欲攻西圍淮獨"
          },
          {
            "line": 335,
            "raw_start": 0,
            "raw_end": 21,
            "text": "以為此見形於西欲使官兵重應之必攻陽遂耳其夜"
          },
          {
            "line": 336,
            "raw_start": 0,
            "raw_end": 9,
            "text": "果攻陽遂有備不得上"
          }
        ],
        "source_layer": "received_biography"
      }
    },
    {
      "paragraph_id": "c-sanguozhi-026-guohuai:unit007",
      "text": "正始元年蜀將姜維出隴西淮遂進軍追至彊中維退遂討羌迷當等按撫柔氐三千餘落拔徙以實關中遷左將軍涼州休屠胡梁元碧等率種落二千餘家附雍州淮奏請使居安定之高平為民保障其後因置西川都尉轉拜前將軍領州如故",
      "text_layer": "received_chapter",
      "source_position": {
        "first_line": 336,
        "last_line": 341,
        "revision_id": "214fcafa79894355909c9d8c2c1533089e7791c6",
        "projection_sha256": "67d1313394eaa81131de8899d67ef5dbceeca1c302c12fdb4240752b8b8059a4",
        "source_fragments": [
          {
            "line": 336,
            "raw_start": 9,
            "raw_end": 21,
            "text": "正始元年蜀將姜維出隴西淮"
          },
          {
            "line": 338,
            "raw_start": 0,
            "raw_end": 21,
            "text": "遂進軍追至彊中維退遂討羌迷當等按撫柔氐三千"
          },
          {
            "line": 339,
            "raw_start": 0,
            "raw_end": 21,
            "text": "餘落拔徙以實關中遷左將軍涼州休屠胡梁元碧等"
          },
          {
            "line": 340,
            "raw_start": 0,
            "raw_end": 21,
            "text": "率種落二千餘家附雍州淮奏請使居安定之高平為"
          },
          {
            "line": 341,
            "raw_start": 0,
            "raw_end": 20,
            "text": "民保障其後因置西川都尉轉拜前將軍領州如故"
          }
        ],
        "source_layer": "received_biography"
      }
    },
    {
      "paragraph_id": "c-sanguozhi-026-guohuai:unit008",
      "text": "五年夏侯玄伐蜀淮督諸軍為前鋒淮度勢不利輒拔軍出故不大敗還假淮節",
      "text_layer": "received_chapter",
      "source_position": {
        "first_line": 341,
        "last_line": 343,
        "revision_id": "214fcafa79894355909c9d8c2c1533089e7791c6",
        "projection_sha256": "3b60b0c1ed8bcb090d5bff0314cc2c31dea66d3da0803b6a9593fd63b194d193",
        "source_fragments": [
          {
            "line": 341,
            "raw_start": 20,
            "raw_end": 21,
            "text": "五"
          },
          {
            "line": 342,
            "raw_start": 0,
            "raw_end": 21,
            "text": "年夏侯玄伐蜀淮督諸軍為前鋒淮度勢不利輒拔軍"
          },
          {
            "line": 343,
            "raw_start": 0,
            "raw_end": 9,
            "text": "出故不大敗還假淮節"
          }
        ],
        "source_layer": "received_biography"
      }
    },
    {
      "paragraph_id": "c-sanguozhi-026-guohuai:unit009",
      "text": "八年隴西南安金城西平諸羌餓何燒戈伐同蛾遮塞等相結叛亂攻圍城邑南招蜀兵涼州名胡治無戴復叛應之討蜀䕶軍夏侯霸督諸軍屯為翅淮軍始到狄道議者僉謂宜先討定枹罕内平惡羌外折賊謀淮策維必來攻霸遂入渢中轉南迎霸維果攻為翅㑹淮軍適至維遁退進討叛羌斬餓何燒戈降服者萬餘落",
      "text_layer": "received_chapter",
      "source_position": {
        "first_line": 343,
        "last_line": 350,
        "revision_id": "214fcafa79894355909c9d8c2c1533089e7791c6",
        "projection_sha256": "2a763ae64ed9435a5fb6d56fdb10bd004288f24e37a75941fb9c32abde763954",
        "source_fragments": [
          {
            "line": 343,
            "raw_start": 9,
            "raw_end": 21,
            "text": "八年隴西南安金城西平諸羌"
          },
          {
            "line": 344,
            "raw_start": 0,
            "raw_end": 21,
            "text": "餓何燒戈伐同蛾遮塞等相結叛亂攻圍城邑南招蜀"
          },
          {
            "line": 345,
            "raw_start": 0,
            "raw_end": 21,
            "text": "兵涼州名胡治無戴復叛應之討蜀䕶軍夏侯霸督諸"
          },
          {
            "line": 346,
            "raw_start": 0,
            "raw_end": 21,
            "text": "軍屯為翅淮軍始到狄道議者僉謂宜先討定枹罕内"
          },
          {
            "line": 348,
            "raw_start": 0,
            "raw_end": 21,
            "text": "平惡羌外折賊謀淮策維必來攻霸遂入渢中轉南迎"
          },
          {
            "line": 349,
            "raw_start": 0,
            "raw_end": 21,
            "text": "霸維果攻為翅㑹淮軍適至維遁退進討叛羌斬餓何"
          },
          {
            "line": 350,
            "raw_start": 0,
            "raw_end": 8,
            "text": "燒戈降服者萬餘落"
          }
        ],
        "source_layer": "received_biography"
      }
    },
    {
      "paragraph_id": "c-sanguozhi-026-guohuai:unit010",
      "text": "九年遮塞等屯河關白土故城據河拒軍淮見形上流密於下渡兵據白土城擊大破之治無戴圍武威家屬留在西海淮進軍趣西海欲掩取其累重㑹無戴折還與戰於龍夷之北破走之令居惡虜在石頭山之西當大道止斷絶王使淮還過討大破之",
      "text_layer": "received_chapter",
      "source_position": {
        "first_line": 350,
        "last_line": 356,
        "revision_id": "214fcafa79894355909c9d8c2c1533089e7791c6",
        "projection_sha256": "ad6a4361398b27fd20ff7d1950b8e811e31f79d377beea065aad77096d890efb",
        "source_fragments": [
          {
            "line": 350,
            "raw_start": 8,
            "raw_end": 21,
            "text": "九年遮塞等屯河關白土故城據"
          },
          {
            "line": 351,
            "raw_start": 0,
            "raw_end": 21,
            "text": "河拒軍淮見形上流密於下渡兵據白土城擊大破之"
          },
          {
            "line": 352,
            "raw_start": 0,
            "raw_end": 21,
            "text": "治無戴圍武威家屬留在西海淮進軍趣西海欲掩取"
          },
          {
            "line": 353,
            "raw_start": 0,
            "raw_end": 21,
            "text": "其累重㑹無戴折還與戰於龍夷之北破走之令居惡"
          },
          {
            "line": 354,
            "raw_start": 0,
            "raw_end": 21,
            "text": "虜在石頭山之西當大道止斷絶王使淮還過討大破"
          },
          {
            "line": 356,
            "raw_start": 0,
            "raw_end": 1,
            "text": "之"
          }
        ],
        "source_layer": "received_biography"
      }
    },
    {
      "paragraph_id": "c-sanguozhi-026-guohuai:unit011",
      "text": "姜維出石營從彊川乃西迎治無戴留隂平太守廖化於成重山築城歛破羌保質淮欲分兵取之諸將以維衆西接彊胡化以據險分軍兩持兵勢轉弱進不制維退不拔化非計也不如合而俱西及胡蜀未接絶其内外此伐交之兵也淮曰今往取化出賊不意維必狼顧比維自致足以定化且使維疲於奔命兵不遠西而胡交自離此一舉而兩全之策也乃别遣夏侯霸等追維於沓中淮自率諸軍就攻化等維果馳還救化皆如淮計進封都鄉侯",
      "text_layer": "received_chapter",
      "source_position": {
        "first_line": 356,
        "last_line": 364,
        "revision_id": "214fcafa79894355909c9d8c2c1533089e7791c6",
        "projection_sha256": "f7348e7197eb831894ac3136e2b4190d4207752210add2327b2d3f3382a082d0",
        "source_fragments": [
          {
            "line": 356,
            "raw_start": 1,
            "raw_end": 21,
            "text": "姜維出石營從彊川乃西迎治無戴留隂平太守廖"
          },
          {
            "line": 357,
            "raw_start": 0,
            "raw_end": 21,
            "text": "化於成重山築城歛破羌保質淮欲分兵取之諸將以"
          },
          {
            "line": 358,
            "raw_start": 0,
            "raw_end": 21,
            "text": "維衆西接彊胡化以據險分軍兩持兵勢轉弱進不制"
          },
          {
            "line": 359,
            "raw_start": 0,
            "raw_end": 21,
            "text": "維退不拔化非計也不如合而俱西及胡蜀未接絶其"
          },
          {
            "line": 360,
            "raw_start": 0,
            "raw_end": 21,
            "text": "内外此伐交之兵也淮曰今往取化出賊不意維必狼"
          },
          {
            "line": 361,
            "raw_start": 0,
            "raw_end": 21,
            "text": "顧比維自致足以定化且使維疲於奔命兵不遠西而"
          },
          {
            "line": 362,
            "raw_start": 0,
            "raw_end": 21,
            "text": "胡交自離此一舉而兩全之策也乃别遣夏侯霸等追"
          },
          {
            "line": 363,
            "raw_start": 0,
            "raw_end": 21,
            "text": "維於沓中淮自率諸軍就攻化等維果馳還救化皆如"
          },
          {
            "line": 364,
            "raw_start": 0,
            "raw_end": 7,
            "text": "淮計進封都鄉侯"
          }
        ],
        "source_layer": "received_biography"
      }
    },
    {
      "paragraph_id": "c-sanguozhi-026-guohuai:unit012",
      "text": "嘉平元年遷征西將軍都督雍涼諸軍事是歲與雍州刺史陳泰協策降蜀牙門將句安等於翅上",
      "text_layer": "received_chapter",
      "source_position": {
        "first_line": 364,
        "last_line": 367,
        "revision_id": "214fcafa79894355909c9d8c2c1533089e7791c6",
        "projection_sha256": "588fefe64eeb594ed5ebf23f8c0b77aacb14d40dd6ddc5bd0e704df33c9933de",
        "source_fragments": [
          {
            "line": 364,
            "raw_start": 7,
            "raw_end": 21,
            "text": "嘉平元年遷征西將軍都督雍涼諸"
          },
          {
            "line": 366,
            "raw_start": 0,
            "raw_end": 21,
            "text": "軍事是歲與雍州刺史陳泰協策降蜀牙門將句安等"
          },
          {
            "line": 367,
            "raw_start": 0,
            "raw_end": 3,
            "text": "於翅上"
          }
        ],
        "source_layer": "received_biography"
      }
    },
    {
      "paragraph_id": "c-sanguozhi-026-guohuai:unit013",
      "text": "二年詔曰昔漢川之役幾至傾覆淮臨危濟難功書王府在關右三十餘年外征冦虜内綏民夷比歲以來摧破廖化禽虜句安功績顯著朕甚嘉之今以淮為車騎將軍儀同三司持節都督如故進封陽曲侯邑凡二千七百八十戸分三百戸封一子亭侯",
      "text_layer": "received_chapter",
      "source_position": {
        "first_line": 367,
        "last_line": 371,
        "revision_id": "214fcafa79894355909c9d8c2c1533089e7791c6",
        "projection_sha256": "9593c7093df81af6be5443e77e55f38005a5145139699b8776ea5003ab18728b",
        "source_fragments": [
          {
            "line": 367,
            "raw_start": 3,
            "raw_end": 21,
            "text": "二年詔曰昔漢川之役幾至傾覆淮臨危濟難"
          },
          {
            "line": 368,
            "raw_start": 0,
            "raw_end": 21,
            "text": "功書王府在關右三十餘年外征冦虜内綏民夷比歲"
          },
          {
            "line": 369,
            "raw_start": 0,
            "raw_end": 21,
            "text": "以來摧破廖化禽虜句安功績顯著朕甚嘉之今以淮"
          },
          {
            "line": 370,
            "raw_start": 0,
            "raw_end": 21,
            "text": "為車騎將軍儀同三司持節都督如故進封陽曲侯邑"
          },
          {
            "line": 371,
            "raw_start": 0,
            "raw_end": 17,
            "text": "凡二千七百八十戸分三百戸封一子亭侯"
          }
        ],
        "source_layer": "received_biography"
      }
    },
    {
      "paragraph_id": "c-sanguozhi-026-guohuai:unit014",
      "text": "世語曰淮妻王凌之妹凌誅妹當從坐御史往収督將及羌胡渠帥數千人叩頭請淮表留妻淮不從妻上道莫不流涕人人扼腕欲劫留之淮五子叩頭流血請淮淮不忍視乃命左右追妻於是追者數千騎數日而還淮以書白司馬宣王曰五子哀母不惜其身若無其母是無五子無五子亦無淮也今輒追還若於法未通當受罪於主者覲展在近書至宣王亦宥之",
      "text_layer": "witness_appended_pei_songzhi_note",
      "source_position": {
        "first_line": 371,
        "last_line": 376,
        "revision_id": "214fcafa79894355909c9d8c2c1533089e7791c6",
        "projection_sha256": "d64bf196bb5af4f2be47561b6176810453cdff30734b3ae2e54763292534cd7a",
        "source_fragments": [
          {
            "line": 371,
            "raw_start": 18,
            "raw_end": 26,
            "text": "世語曰淮妻王凌之"
          },
          {
            "line": 372,
            "raw_start": 1,
            "raw_end": 43,
            "text": "妹凌誅妹當從坐御史往収督將及羌胡渠帥數千人叩頭請淮表留妻淮不從妻上道莫不流涕人人扼腕"
          },
          {
            "line": 374,
            "raw_start": 1,
            "raw_end": 43,
            "text": "欲劫留之淮五子叩頭流血請淮淮不忍視乃命左右追妻於是追者數千騎數日而還淮以書白司馬宣王"
          },
          {
            "line": 375,
            "raw_start": 1,
            "raw_end": 43,
            "text": "曰五子哀母不惜其身若無其母是無五子無五子亦無淮也今輒追還若於法未通當受罪於主者覲展在"
          },
          {
            "line": 376,
            "raw_start": 1,
            "raw_end": 9,
            "text": "近書至宣王亦宥之"
          }
        ],
        "source_layer": "pei_annotation"
      }
    },
    {
      "paragraph_id": "c-sanguozhi-026-guohuai:unit015",
      "text": "正元二年薨追贈大將軍諡曰貞侯子統嗣統官至荆州刺史薨子正嗣咸熙中開建五等以淮著勲前朝改封汾陽子",
      "text_layer": "received_chapter",
      "source_position": {
        "first_line": 376,
        "last_line": 378,
        "revision_id": "214fcafa79894355909c9d8c2c1533089e7791c6",
        "projection_sha256": "dbf344e683c7ddc944939b1d6369ba8e6b54974c2fc1ba520d6ea9397de00374",
        "source_fragments": [
          {
            "line": 376,
            "raw_start": 10,
            "raw_end": 27,
            "text": "正元二年薨追贈大將軍諡曰貞侯子統嗣"
          },
          {
            "line": 377,
            "raw_start": 0,
            "raw_end": 21,
            "text": "統官至荆州刺史薨子正嗣咸熙中開建五等以淮著"
          },
          {
            "line": 378,
            "raw_start": 0,
            "raw_end": 8,
            "text": "勲前朝改封汾陽子"
          }
        ],
        "source_layer": "received_biography"
      }
    },
    {
      "paragraph_id": "c-sanguozhi-026-guohuai:unit016",
      "text": "晉諸公贊曰淮弟配字仲南有重名位至城陽太守裴秀賈充皆配女婿子展字泰舒有器度幹用歴職著績終於太僕次弟豫字泰寧相國參軍知名早卒女適王衍配弟鎮字季南謁者僕射鎮子奕字泰業山濤啓事稱奕高簡有雅量歴位雍州刺史尚書",
      "text_layer": "witness_appended_pei_songzhi_note",
      "source_position": {
        "first_line": 378,
        "last_line": 380,
        "revision_id": "214fcafa79894355909c9d8c2c1533089e7791c6",
        "projection_sha256": "544ebaa0b2afab06818689cbf811ac94f2a0f237c3b8cdb2ee1c7a46e15cd1ad",
        "source_fragments": [
          {
            "line": 378,
            "raw_start": 9,
            "raw_end": 35,
            "text": "晉諸公贊曰淮弟配字仲南有重名位至城陽太守裴秀賈充皆配"
          },
          {
            "line": 379,
            "raw_start": 1,
            "raw_end": 43,
            "text": "女婿子展字泰舒有器度幹用歴職著績終於太僕次弟豫字泰寧相國參軍知名早卒女適王衍配弟鎮字"
          },
          {
            "line": 380,
            "raw_start": 1,
            "raw_end": 32,
            "text": "季南謁者僕射鎮子奕字泰業山濤啓事稱奕高簡有雅量歴位雍州刺史尚書"
          }
        ],
        "source_layer": "pei_annotation"
      }
    },
    {
      "paragraph_id": "c-sanguozhi-026-guohuai:unit017",
      "text": "評曰滿寵立志剛毅勇而有謀田豫居身清白規畧明練牽招秉義壯烈威績顯著郭淮方策精詳垂問秦雍而豫位止小州招終於郡守未盡其用也",
      "text_layer": "received_chapter",
      "source_position": {
        "first_line": 381,
        "last_line": 384,
        "revision_id": "214fcafa79894355909c9d8c2c1533089e7791c6",
        "projection_sha256": "831c57b66c55674ad3a669c8e5630ef6b0a4a2bbdce99a5c92c56fd428187d41",
        "source_fragments": [
          {
            "line": 381,
            "raw_start": 0,
            "raw_end": 21,
            "text": "評曰滿寵立志剛毅勇而有謀田豫居身清白規畧明"
          },
          {
            "line": 382,
            "raw_start": 0,
            "raw_end": 21,
            "text": "練牽招秉義壯烈威績顯著郭淮方策精詳垂問秦雍"
          },
          {
            "line": 384,
            "raw_start": 0,
            "raw_end": 16,
            "text": "而豫位止小州招終於郡守未盡其用也"
          }
        ],
        "source_layer": "received_volume_appraisal"
      }
    },
    {
      "paragraph_id": "c-sanguozhi-026-guohuai:unit018",
      "text": "郭淮太原陽曲人也注父縕鴈門太守○北宋本縕作蘊既陣備疑不渡○太平御覽作不敢渡蜀兵大至淮逆擊之○太平御覽作逆擊走之",
      "text_layer": "witness_appended_qing_siku_collation",
      "source_position": {
        "first_line": 395,
        "last_line": 399,
        "revision_id": "214fcafa79894355909c9d8c2c1533089e7791c6",
        "projection_sha256": "75f3ecdb1cdb9a6813350ed92a6ae135aebe87b45c8a77050e768df57487dae6",
        "source_fragments": [
          {
            "line": 395,
            "raw_start": 0,
            "raw_end": 21,
            "text": "郭淮太原陽曲人也注父縕鴈門太守○北宋本縕作"
          },
          {
            "line": 397,
            "raw_start": 1,
            "raw_end": 2,
            "text": "蘊"
          },
          {
            "line": 398,
            "raw_start": 0,
            "raw_end": 15,
            "text": "既陣備疑不渡○太平御覽作不敢渡"
          },
          {
            "line": 399,
            "raw_start": 0,
            "raw_end": 18,
            "text": "蜀兵大至淮逆擊之○太平御覽作逆擊走之"
          }
        ],
        "source_layer": "qing_siku_collation_appendix"
      }
    }
  ],
