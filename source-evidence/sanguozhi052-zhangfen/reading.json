  "source_clauses": [
    {
      "witness": "sg",
      "quote": "昭弟子奮年二十，造作攻城大攻車，爲歩騭所薦。",
      "raw_start": 3383,
      "raw_end": 3405,
      "raw_line": 28
    },
    {
      "witness": "sg",
      "quote": "昔童汪死難，子奇治阿，奮實不才耳，於年不爲少也。",
      "raw_start": 3431,
      "raw_end": 3455,
      "raw_line": 28
    },
    {
      "witness": "sg",
      "quote": "歩騭字子山，臨淮淮陰人也。",
      "raw_start": 11028,
      "raw_end": 11041,
      "raw_line": 84
    },
    {
      "witness": "yl",
      "quote": "子奇年十六，齊君使治阿。",
      "raw_start": 2710,
      "raw_end": 2722,
      "raw_line": 125
    },
    {
      "witness": "zuo",
      "quote": "公為與其嬖僮汪錡乘．皆死皆殯．",
      "raw_start": 9171,
      "raw_end": 9186,
      "raw_line": 240
    },
    {
      "witness": "li",
      "quote": "與其鄰重汪踦往，皆死焉。",
      "raw_start": 461,
      "raw_end": 473,
      "raw_line": 10
    },
    {
      "witness": "li",
      "quote": "「重」皆當爲「童」。童，未冠者之稱。姓汪，名踦。",
      "raw_start": 492,
      "raw_end": 516,
      "raw_line": 10
    },
    {
      "witness": "li",
      "quote": "《春秋傳》曰「童汪踦」。",
      "raw_start": 525,
      "raw_end": 537,
      "raw_line": 10
    },
    {
      "witness": "yw",
      "quote": "新序曰．昔子奇年十八．齊君使之治阿．",
      "raw_start": 11253,
      "raw_end": 11271,
      "raw_line": 232
    },
    {
      "witness": "yw",
      "quote": "○本卷宋本缺．據明本補．",
      "raw_start": 78,
      "raw_end": 90,
      "raw_line": 3
    }
  ],
