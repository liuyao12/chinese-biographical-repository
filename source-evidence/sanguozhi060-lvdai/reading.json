  "section_reviews": [
    {
      "id": "c-sanguozhi-060-lvdai:line045:reading-000-142",
      "kind": "received_sentence",
      "paragraph_id": "c-sanguozhi-060-lvdai:line045",
      "start_codepoint": 0,
      "end_codepoint": 142,
      "source_quote": "　　呂岱字定公，廣陵海陵人也，為郡縣吏，避亂南渡。孫權統事，岱詣幕府，出守吳丞。權親斷諸縣倉庫及囚系，長丞皆見，岱處法應問，甚稱權意，召署錄事，出補余姚長，召募精健，得千餘人。會稽東冶五縣賊呂合、秦狼等為亂，權以岱為督軍校尉，與將軍蔣欽等將兵討之，遂擒合、狼，五縣平定，拜昭信中郎將。",
      "person_id": "2oe_qam_pq4",
      "related_person_ids": [
        "572_278_cba",
        "pbk_bqg_1v2",
        "nxs_1bo_80u",
        "fsr_uvs_8av"
      ],
      "reading": "岱吳丞、錄事、余姚長，與蔣欽討呂合及秦狼。"
    },
    {
      "id": "c-sanguozhi-060-lvdai:line045-pei01-01:reading-000-054",
      "kind": "annotation_sentence",
      "paragraph_id": "c-sanguozhi-060-lvdai:line045-pei01-01",
      "start_codepoint": 0,
      "end_codepoint": 54,
      "source_quote": "吴书曰：建安十六年，岱督郎将尹异等，以兵二千人西诱汉中贼帅张鲁到汉兴寋城，鲁嫌疑断道，事计不立，权遂召岱还。",
      "person_id": "2oe_qam_pq4",
      "related_person_ids": [
        "7mh_gim_csr",
        "nba_zrs_6tb",
        "572_278_cba"
      ],
      "reading": "吳書載誘張魯之行，建安十六年而返。"
    },
    {
      "id": "c-sanguozhi-060-lvdai:line047:reading-000-129",
      "kind": "received_sentence",
      "paragraph_id": "c-sanguozhi-060-lvdai:line047",
      "start_codepoint": 0,
      "end_codepoint": 129,
      "source_quote": "　　建安二十年，督孫茂等十將從取長沙三郡。又安成、攸、永新、茶陵四縣吏共入陰山城，合眾拒岱，岱攻圍，即降，三郡克定。權留岱鎮長沙。安成長吳碭及中郎將袁龍等首尾關羽，復為反亂。碭據攸縣，龍在醴陵。權遣橫江將軍魯肅攻攸，碭得突走。岱攻醴陵，遂禽斬龍。遷廬陵太守。",
      "person_id": "2oe_qam_pq4",
      "related_person_ids": [
        "0u0_v1h_v8v",
        "572_278_cba",
        "kgx_en4_9xg",
        "i9t_e74_y7i",
        "1c2_03c_9ea",
        "ooa_1fr_hy9"
      ],
      "reading": "建安二十年取長沙三郡後，吳碭走、袁龍死，各別。"
    },
    {
      "id": "c-sanguozhi-060-lvdai:line049:reading-000-120",
      "kind": "received_sentence",
      "paragraph_id": "c-sanguozhi-060-lvdai:line049",
      "start_codepoint": 0,
      "end_codepoint": 120,
      "source_quote": "　　延康元年，代步騭為交州刺史。到州，高涼賊帥錢博乞降，岱因承製，以博為高涼西部都尉。又鬱林夷賊攻圍郡縣，岱討破之。是時桂陽、湞陽賊王金合眾於南海界上，首亂為害，權又詔岱討之，生縛金，傳送詣都，斬首獲生凡萬餘人。遷安南將軍，假節，封都鄉侯。",
      "person_id": "2oe_qam_pq4",
      "related_person_ids": [
        "snv_2iq_jes",
        "uf5_ku8_d46",
        "7hj_hzs_aqo",
        "572_278_cba"
      ],
      "reading": "延康元年代步騭為刺史。王金見縛，集合計數斬首不直接作王金之死。"
    },
    {
      "id": "c-sanguozhi-060-lvdai:line051:reading-000-353",
      "kind": "received_sentence",
      "paragraph_id": "c-sanguozhi-060-lvdai:line051",
      "start_codepoint": 0,
      "end_codepoint": 353,
      "source_quote": "　　交阯太守士燮卒，權以燮子徽為安遠將軍，領九真太守，以校尉陳時代燮。岱表分海南三郡為交州，以將軍戴良為刺史，海東四郡為廣州，岱自為刺史。遣良與時南入，而徽不承命，舉兵戍海口以拒良等。岱於是上疏請討徽罪，督兵三千人晨夜浮海。或謂岱曰：\"徽藉累世之恩，為一州所附，未易輕也。\"岱曰：\"今徽雖懷逆計，未虞吾之卒至，若我潛軍輕舉，掩其無備，破之必也。稽留不速，使得生心，嬰城固守，七郡百蠻，雲合響應，雖有智者，誰能圖之?\"遂行，過合浦，與良俱進。徽聞岱至，果大震怖，不知所出，即率兄弟六人肉袒迎岱。岱皆斬送其首，徽大將甘醴，桓治等率吏民攻岱，岱奮擊大破之，進封番禺侯。於是除廣州，復為交州如故。岱既定交州，復進討九真，斬獲以萬數。又遣從事南宣國化，暨徼外扶南、林邑、堂明諸王，各遣使奉貢。權嘉其功，進拜鎮南將軍。",
      "person_id": "2oe_qam_pq4",
      "related_person_ids": [
        "p2p_gqb_6ar",
        "572_278_cba",
        "x6j_swp_8be",
        "z49_zy2_ymh",
        "d77_yv8_tqg",
        "d46_141_sro",
        "e94_hx9_lns"
      ],
      "reading": "士燮卒後子徽受命九真，岱請討徽。卷49士燮傳詳兄弟降與斬之，兩書同事之不同語各存。"
    },
    {
      "id": "c-sanguozhi-060-lvdai:line053:reading-000-148",
      "kind": "received_sentence",
      "paragraph_id": "c-sanguozhi-060-lvdai:line053",
      "start_codepoint": 0,
      "end_codepoint": 148,
      "source_quote": "　　黃龍三年，以南土清定，召岱還屯長沙漚口。會武陵蠻夷蠢動，岱與太常潘浚共討定之。嘉禾三年，權令岱領潘璋士眾，屯陸口，後徙蒲圻。四年，廬陵賊李桓、路合、會稽東冶賊隨春、南海賊羅厲等一時並起。權復詔岱督劉纂、唐咨等分部討擊，春即時首降，岱拜春偏將軍，使領其眾，遂為列將，桓、厲等皆見斬獲，傳首詣都。",
      "person_id": "2oe_qam_pq4",
      "related_person_ids": [
        "pac_tt7_hs3",
        "572_278_cba",
        "v4f_db2_eqv",
        "xqk_f8a_dvz",
        "cvc_zj4_1jp",
        "zep_wit_qg1",
        "psh_zpl_fps",
        "fuo_2ev_thx",
        "qc3_bcx_r3n"
      ],
      "reading": "李桓、路合、隨春、羅厲並起；春降並拜將，桓、厲見斬。"
    },
    {
      "id": "c-sanguozhi-060-lvdai:line053-pei01-01:reading-000-065",
      "kind": "annotation_sentence",
      "paragraph_id": "c-sanguozhi-060-lvdai:line053-pei01-01",
      "start_codepoint": 0,
      "end_codepoint": 65,
      "source_quote": "王隐《交广记》曰：吴后复置广州，以南阳滕脩为刺史。或语脩虾须长一丈，脩不信，其人后故至东海，取虾须长四丈四尺，封以示脩，脩乃服之。",
      "person_id": "8zw_lx6_9le",
      "related_person_ids": [
        "7er_nm9_kan"
      ],
      "reading": "王隱交廣記附敘後來的廣州刺史滕脩；未以虾须之類作官物定值。"
    },
    {
      "id": "c-sanguozhi-060-lvdai:line055:reading-000-140",
      "kind": "received_sentence",
      "paragraph_id": "c-sanguozhi-060-lvdai:line055",
      "start_codepoint": 0,
      "end_codepoint": 140,
      "source_quote": "　　權詔岱曰：“厲負險作亂，自致梟首；桓兇狡反覆，已降復叛。前後討伐，歷年不禽，非君規略，誰能梟之？忠武之節，於是益者。元惡既除，大小震懾，其餘細類，掃地族矣。自今巳去，國家永無南顧之虞，三郡晏然，無怵惕之驚。又得惡民以供賦役，重用歎息。賞不逾月，國之常典，制度所宜，君其裁之。”",
      "person_id": "572_278_cba",
      "related_person_ids": [
        "2oe_qam_pq4",
        "psh_zpl_fps",
        "xqk_f8a_dvz"
      ],
      "reading": "孫權詔呂岱稱厲桓之死，受詔的「君」是岱。"
    },
    {
      "id": "c-sanguozhi-060-lvdai:line057:reading-000-125",
      "kind": "received_sentence",
      "paragraph_id": "c-sanguozhi-060-lvdai:line057",
      "start_codepoint": 0,
      "end_codepoint": 125,
      "source_quote": "　　潘濬卒，岱代浚領荊州文書，與陸遜井在武昌，故督蒲圻。頃之，廖式作亂。攻圍城邑，零陵、蒼梧、鬱林諸郡騷擾，岱自表輒行，星夜兼路。權遣使追拜岱交州牧，及遣諸將唐咨等駱驛相繼，攻討一年破之，斬式及遣諸所偽署臨賀太守費楊等，並其支黨，郡縣悉平，復還武昌。",
      "person_id": "2oe_qam_pq4",
      "related_person_ids": [
        "pac_tt7_hs3",
        "lii_454_vuv",
        "gi6_ov3_5wd",
        "572_278_cba",
        "qc3_bcx_r3n",
        "9it_08z_2pq"
      ],
      "reading": "潘濬卒，岱繼其荊州文書；與陸遜井在武昌，殿本作並。斬廖式及所署費楊等。"
    },
    {
      "id": "c-sanguozhi-060-lvdai:line059:reading-000-030",
      "kind": "received_sentence",
      "paragraph_id": "c-sanguozhi-060-lvdai:line059",
      "start_codepoint": 0,
      "end_codepoint": 30,
      "source_quote": "　　時年已八十，然體素精勤，躬親王事。奮威將軍張承與岱書曰：",
      "person_id": "2oe_qam_pq4",
      "related_person_ids": [
        "roi_rz4_ute_B"
      ],
      "reading": "八十是書信時年，主語呂岱；張承致函，次段為函文。"
    },
    {
      "id": "c-sanguozhi-060-lvdai:line060:reading-000-130",
      "kind": "received_sentence",
      "paragraph_id": "c-sanguozhi-060-lvdai:line060",
      "start_codepoint": 0,
      "end_codepoint": 130,
      "source_quote": "昔旦奭翼同，《二南》作歌，今則足下與陸子也。忠勤相先，勞謙相讓，功以權成，化與道合，君子歎其德，小人悅其美。加以文書鞅掌，賓客終日，罷不捨事，勞不言倦。又知上馬輒自超乘，不由跨躡，如此足下過廉頗也。何其事事決也。《周易》有之，禮言恭，德言盛，足下何有盡此美耶！",
      "person_id": "roi_rz4_ute_B",
      "related_person_ids": [
        "y4i_pjk_4gn_AD",
        "7m7_qvm_4oj",
        "lii_454_vuv",
        "tfz_fnj_ejn"
      ],
      "reading": "張承致呂岱書，引周公旦、召公奭、廉頗。足下指呂岱，陸子指前文陸遜。"
    },
    {
      "id": "c-sanguozhi-060-lvdai:line061:reading-000-150",
      "kind": "received_sentence",
      "paragraph_id": "c-sanguozhi-060-lvdai:line061",
      "start_codepoint": 0,
      "end_codepoint": 150,
      "source_quote": "及陸遜卒，諸葛恪代遜，權乃分武昌為兩部，岱督右部，自武昌上至蒲圻。遷上大將軍，拜子凱副軍校尉，監兵蒲圻，孫亮即位，拜大司馬。岱清身奉公，所在可述。初在交州，歷年不餉家，妻子饑乏。權聞之歎息，以讓群臣曰：“呂岱出身萬里，為國勤事，家門內困，而孤不早知。股肱耳目，其責安在？”於是加賜錢米布絹，歲有常限。",
      "person_id": "2oe_qam_pq4",
      "related_person_ids": [
        "lii_454_vuv",
        "512_1cd_a4b",
        "572_278_cba",
        "2oe_qam_pq4_A",
        "hqp_o1w_ihy"
      ],
      "reading": "孫亮即位拜岱大司馬，子凱副軍校尉。另有蜀呂凱，官歷有別。"
    },
    {
      "id": "c-sanguozhi-060-lvdai:line063:reading-000-130",
      "kind": "received_sentence",
      "paragraph_id": "c-sanguozhi-060-lvdai:line063",
      "start_codepoint": 0,
      "end_codepoint": 130,
      "source_quote": "　　始，岱親近吳郡徐原，慷慨有才志，岱知其可成，賜巾褠，與共言論，後遂薦拔，官至侍御史。原性忠壯，好直言，岱時有得失，原輒諫諍，又公論之，人或以告岱，岱歎曰：\"是我所以貴德淵者也。\"及原死，岱哭之甚哀。曰：“德淵，呂岱之益友，今不幸，岱復於何聞過？”談者美之。",
      "person_id": "gw4_n7v_ssj",
      "related_person_ids": [
        "2oe_qam_pq4"
      ],
      "reading": "徐原官侍御史，字稱德淵；亡後岱追念直諫。"
    },
    {
      "id": "c-sanguozhi-060-lvdai:line065:reading-000-045",
      "kind": "received_sentence",
      "paragraph_id": "c-sanguozhi-060-lvdai:line065",
      "start_codepoint": 0,
      "end_codepoint": 45,
      "source_quote": "　　太平元年，年九十六卒，子凱嗣。遣令殯以素棺，疏巾布褠，葬送之制，務從儉約，凱皆奉行之。",
      "person_id": "2oe_qam_pq4",
      "related_person_ids": [
        "2oe_qam_pq4_A"
      ],
      "reading": "太平元年，年九十六而卒，子凱承爵，遵遺令節葬。"
    }
  ],
