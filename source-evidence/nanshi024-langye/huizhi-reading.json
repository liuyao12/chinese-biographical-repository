  "sentence_readings": [
    {
      "paragraph_id": "c-nanshi-024-wang-family:line023",
      "start": 0,
      "end": 23,
      "surface": "敬弘形狀短而起坐端方，桓玄謂之「彈棋發八勢」。",
      "interpretation": "桓玄戲稱敬弘姿態。"
    },
    {
      "paragraph_id": "c-nanshi-024-wang-family:line023",
      "start": 23,
      "end": 49,
      "surface": "所居舍亭山，林澗環周，備登臨之美，故時人謂之王東山。",
      "interpretation": "時人以山居稱王東山。"
    },
    {
      "paragraph_id": "c-nanshi-024-wang-family:line023",
      "start": 49,
      "end": 78,
      "surface": "文帝嘗問爲政得失，對曰：「天下有道，庶人不議。」上高其言。",
      "interpretation": "文帝問政。"
    },
    {
      "paragraph_id": "c-nanshi-024-wang-family:line023",
      "start": 78,
      "end": 103,
      "surface": "左右嘗使二老婦女，戴五條辮，著青紋絝袼，飾以朱粉。",
      "interpretation": "兩老婦妝束。"
    },
    {
      "paragraph_id": "c-nanshi-024-wang-family:line023",
      "start": 103,
      "end": 116,
      "surface": "女適尚書僕射何尚之弟述之。",
      "interpretation": "何述之娶敬弘女。"
    },
    {
      "paragraph_id": "c-nanshi-024-wang-family:line023",
      "start": 116,
      "end": 137,
      "surface": "敬弘嘗往何氏看女，遇尚之不在，因寄齋中臥。",
      "interpretation": "探女寄宿何氏。"
    },
    {
      "paragraph_id": "c-nanshi-024-wang-family:line023",
      "start": 137,
      "end": 174,
      "surface": "俄頃尚之還，敬弘使二婦女守合，不聽尚之入，云：「正熱不堪相見，君可且去」。",
      "interpretation": "命二婦拒何尚之。"
    },
    {
      "paragraph_id": "c-nanshi-024-wang-family:line023",
      "start": 174,
      "end": 183,
      "surface": "尚之於是移於他室。",
      "interpretation": "尚之移居他室。"
    },
    {
      "paragraph_id": "c-nanshi-024-wang-family:line023",
      "start": 183,
      "end": 209,
      "surface": "上將爲廬陵王納其女，辭曰：「臣女幼，既許孔淳之息。」",
      "interpretation": "廬陵王求婚，敬弘以已許孔淳之息辭。"
    },
    {
      "paragraph_id": "c-nanshi-024-wang-family:line023",
      "start": 209,
      "end": 262,
      "surface": "子恢之被召爲祕書郎，敬弘爲求奉朝請，與恢之書曰：「彼祕書有限故有競，朝請無限故無競，吾欲使汝處不競之地。」",
      "interpretation": "恢之召作祕書郎、父求奉朝請，書中吾、汝明指。"
    },
    {
      "paragraph_id": "c-nanshi-024-wang-family:line023",
      "start": 262,
      "end": 271,
      "surface": "文帝嘉之，並見許。",
      "interpretation": "文帝許。"
    },
    {
      "paragraph_id": "c-nanshi-024-wang-family:line025",
      "start": 0,
      "end": 20,
      "surface": "敬弘見兒孫，歳中不過一再相見，見輒克日。",
      "interpretation": "父子孫相見不多。"
    },
    {
      "paragraph_id": "c-nanshi-024-wang-family:line025",
      "start": 20,
      "end": 33,
      "surface": "未嘗教子孫學問，各隨所欲。",
      "interpretation": "聽任子孫自學。"
    },
    {
      "paragraph_id": "c-nanshi-024-wang-family:line025",
      "start": 33,
      "end": 57,
      "surface": "人或問之，答曰：「丹朱不應乏教，甯越不聞被捶。」",
      "interpretation": "以丹朱、甯越為例。"
    },
    {
      "paragraph_id": "c-nanshi-024-wang-family:line025",
      "start": 57,
      "end": 71,
      "surface": "恢之位新安太守，嘗請假定省。",
      "interpretation": "恢之任新安，請假省父。"
    },
    {
      "paragraph_id": "c-nanshi-024-wang-family:line025",
      "start": 71,
      "end": 84,
      "surface": "敬弘克日見之，至日輒不果。",
      "interpretation": "屢約未見。"
    },
    {
      "paragraph_id": "c-nanshi-024-wang-family:line025",
      "start": 84,
      "end": 105,
      "surface": "假日將盡，恢之求辭，敬弘呼前至合，復不見。",
      "interpretation": "假盡請辭，呼至仍不得見。"
    },
    {
      "paragraph_id": "c-nanshi-024-wang-family:line025",
      "start": 105,
      "end": 117,
      "surface": "恢之於合外拜辭流涕而去。",
      "interpretation": "在閤外拜泣而去。"
    }
  ]
}
