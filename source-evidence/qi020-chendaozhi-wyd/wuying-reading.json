  "columns": [
    {
      "pdf_page": 3,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 3,
      "reading": "宣孝陳皇后諱道正臨淮東陽人魏司徒陳矯後父肇",
      "start_codepoint": 0,
      "end_codepoint": 21
    },
    {
      "pdf_page": 3,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 4,
      "reading": "之郡孝廉后少家貧勤織作家人矜其勞或止之后終",
      "start_codepoint": 21,
      "end_codepoint": 42
    },
    {
      "pdf_page": 3,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 5,
      "reading": "不改嫁于宣帝庶生衡陽元王道度始安貞王道生后",
      "start_codepoint": 42,
      "end_codepoint": 63
    },
    {
      "pdf_page": 3,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 6,
      "reading": "生太祖太祖年二歲乳人乏乳后夢人以兩甌麻粥與",
      "start_codepoint": 63,
      "end_codepoint": 84
    },
    {
      "pdf_page": 3,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 7,
      "reading": "之覺而乳大出異而說之宣帝從仕在外后常留家治",
      "start_codepoint": 84,
      "end_codepoint": 105
    },
    {
      "pdf_page": 3,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 8,
      "reading": "事教子孫有相者謂后曰夫人有貴子而不見也后歎",
      "start_codepoint": 105,
      "end_codepoint": 126
    },
    {
      "pdf_page": 3,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 9,
      "reading": "曰我三兒誰當應之呼太祖小字曰正應是汝耳宣帝",
      "start_codepoint": 126,
      "end_codepoint": 147
    },
    {
      "pdf_page": 3,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 10,
      "reading": "殂後后親自執勤婢使有過誤恕不問也太祖雖從官",
      "start_codepoint": 147,
      "end_codepoint": 168
    },
    {
      "pdf_page": 3,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 1,
      "reading": "而家業本貧為建康令時高宗等冬月猶無縑纊而奉",
      "start_codepoint": 168,
      "end_codepoint": 189
    },
    {
      "pdf_page": 3,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 2,
      "reading": "膳甚厚后每撤去兼肉曰於我過足矣殂于縣舍年七",
      "start_codepoint": 189,
      "end_codepoint": 210
    },
    {
      "pdf_page": 3,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 3,
      "reading": "十三昇明三年追贈竟陵公國太夫人蜜印畫青綬祠",
      "start_codepoint": 210,
      "end_codepoint": 231
    },
    {
      "pdf_page": 3,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 4,
      "reading": "以太牢建元元年追尊孝皇后贈外祖父肇之金紫光",
      "start_codepoint": 231,
      "end_codepoint": 252
    },
    {
      "pdf_page": 3,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 5,
      "reading": "祿大夫諡曰敬侯后母胡氏為永昌縣靖君",
      "start_codepoint": 252,
      "end_codepoint": 269
    }
  ],
