    {
      "inventory_id": "xt-i016",
      "key": "jingzhou_interaction",
      "unit_id": "xietiao-main:u002",
      "kind": "source_report",
      "source_term": "子隆在荆州好辭賦數集僚友朓以文才尤被賞愛流連晤對不捨日夕",
      "source_start": 0,
      "source_end": 28,
      "full_quote": "子隆在荆州好辭賦數集僚友朓以文才尤被賞愛流連晤對不捨日夕長史王秀之以脁年少相動密以啟聞世祖敕曰侍讀虞雲自宜恒應侍接脁可還都脁道中為詩寄西府曰常恐鷹隼擊秋菊委嚴霜寄言罻羅者寥廓已高翔遷新安王中軍記室脁牋辭子隆曰朓聞潢汙之水思朝宗而毎竭駑蹇之乘希沃若而中疲何則臯壤摇落對之惆悵岐路東西或以嗚悒況乃服義徒擁歸志莫從邈若墜雨飃似秋蔕朓實庸流行能無算屬天地休明山川受納襃採一介搜揚小善捨耒場圃奉筆莵園東泛三江西浮七澤契闊戎旃從容讌語長裾日曵後乘載脂榮立府廷恩加顔色沐髪晞陽未測涯涘撫臆論報早誓肌骨不悟滄溟末運波臣自蕩渤澥方春旅翮先謝清切蕃房寂寥舊蓽輕舟反泝弔影獨留白雲在天龍門不見去德滋永思德滋深唯待青江可望候歸艎於春渚朱邸方開効蓬心於秋實如其簪履或存衽席無改雖復身塡溝壑猶望妻子知歸攬涕告辭悲來横集",
      "unit_text_sha256": "fc9b48a0956e61a3a8e2b5adb94a6b1e0ec15fe5811e5e0abd65d4ee9ea10964",
      "value": {
        "subject": "xietiao",
        "counterparty": "suiwang",
        "source_place": "荆州"
      },
      "roles": {},
      "date": null,
      "disposition": "source_interaction_report",
      "qualification": "不由賞愛/晤對補婚姻或其他未明關係。",
      "human_reviewed": false
    },
