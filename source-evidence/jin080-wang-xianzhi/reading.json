  "comparisons": [
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line106",
        "start": 100,
        "end": 112,
        "quote": "嘗與兄徽之、操之俱詣謝安"
      },
      "witnesses": [
        {
          "witness": "pin",
          "quote": "王黃門兄弟三人俱詣謝公，子猷、子重多說俗事",
          "source_layer": "正文",
          "raw_start": 10028,
          "raw_end": 10049,
          "raw_line": 82
        }
      ],
      "reading": "獻之與兩名兄長訪謝安，世說王氏譜引操之第六子。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line108",
        "start": 15,
        "end": 25,
        "quote": "羲之密從後掣其筆不得"
      },
      "witnesses": [],
      "reading": "年七八歲，傳說以掣筆示書力；未據此鑑定現存帖跡。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line110",
        "start": 27,
        "end": 33,
        "quote": "顧辟彊有名園"
      },
      "witnesses": [
        {
          "witness": "jian",
          "quote": "辟疆，吳郡人。歷郡功曹、平北參軍。",
          "source_layer": "劉注引顧氏譜",
          "raw_start": 2755,
          "raw_end": 2772,
          "raw_line": 25
        },
        {
          "witness": "jian",
          "quote": "王子敬自會稽經吳，聞顧辟疆",
          "source_layer": "正文",
          "raw_start": 2732,
          "raw_end": 2745,
          "raw_line": 25
        }
      ],
      "reading": "名在晉書作彊，世說作疆；同園、主人、客與逐客對話相合。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line112",
        "start": 78,
        "end": 87,
        "quote": "乃使韋仲將懸橙書之"
      },
      "witnesses": [
        {
          "witness": "qiao",
          "quote": "韋仲將能書。魏明帝起殿，欲安榜，使仲將登梯題之。",
          "source_layer": "正文",
          "raw_start": 540,
          "raw_end": 564,
          "raw_line": 11
        },
        {
          "witness": "qiao",
          "quote": "韋誕字仲將，京兆杜陵人",
          "source_layer": "劉注引文章敘錄",
          "raw_start": 597,
          "raw_end": 608,
          "raw_line": 11
        }
      ],
      "reading": "謝安舉魏人登高書榜之傳聞，獻之明加質疑；世說巧藝另載此說。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line112",
        "start": 164,
        "end": 171,
        "quote": "君書何如君家尊"
      },
      "witnesses": [
        {
          "witness": "pin",
          "quote": "謝公問王子敬：「君書何如君家尊？」答曰：「固當不同。」",
          "source_layer": "正文",
          "raw_start": 10164,
          "raw_end": 10191,
          "raw_line": 83
        }
      ],
      "reading": "世說及晉書異文各錄；家尊指王羲之。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line114",
        "start": 12,
        "end": 24,
        "quote": "惟獻之、徐邈共明安之忠勳"
      },
      "witnesses": [],
      "reading": "奏上為謝安身後禮。徐邈是東晉人，另見晉書卷91徐邈傳；獻之對陛下即孝武帝，先帝為簡文帝。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line116",
        "start": 37,
        "end": 44,
        "quote": "惟憶與郗家離婚"
      },
      "witnesses": [
        {
          "witness": "de",
          "quote": "{{ProperNoun|獻之}}娶{{ProperNoun|髙平}}{{ProperNoun|郗-{曇}-}}女，名{{ProperNoun|道茂}}，-{後}-離婚。",
          "source_layer": "劉注引王氏譜",
          "raw_start": 21714,
          "raw_end": 21799,
          "raw_line": 41
        },
        {
          "witness": "de",
          "quote": "祖父{{ProperNoun|曠}}，{{ProperNoun|淮南}}太守。父{{ProperNoun|羲之}}，右將軍。{{ProperNoun|-{咸}--{寧}-}}中，詔尚{{ProperNoun|-{餘}-姚}}公主，遷中書令，卒。",
          "source_layer": "劉注引獻之別傳",
          "raw_start": 21809,
          "raw_end": 21931,
          "raw_line": 41
        },
        {
          "witness": "yu152",
          "quote": "新安湣公主道福，簡文第三女，徐淑媛所生。適桓濟，重適王獻之。",
          "source_layer": "正文",
          "raw_start": 4327,
          "raw_end": 4357,
          "raw_line": 107
        }
      ],
      "reading": "前妻郗道茂。別傳咸寧中尚餘姚公主，咸寧與獻之年代不合，保留錯年字樣；御覽所引中興書記新安湣公主道福。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line116",
        "start": 62,
        "end": 73,
        "quote": "安僖皇后立，以後父追贈"
      },
      "witnesses": [
        {
          "witness": "jin32",
          "quote": "安僖王皇后諱神愛，琅邪臨沂人也。父獻之，[[晉書/卷080|見別傳]]；母新安愍公主。后以{{YL|太元二十一年}}納為太子妃。及安帝即位，立為皇后。無子。{{YL|義熙八年}}崩于徽音殿，時年二十九，葬休平陵。",
          "source_layer": "正文",
          "raw_start": 7073,
          "raw_end": 7179,
          "raw_line": 93
        },
        {
          "witness": "yu149",
          "quote": "安僖皇后王氏，字神受，太常王獻之女，新安公主生，即安帝姑也。",
          "source_layer": "正文",
          "raw_start": 4975,
          "raw_end": 5005,
          "raw_line": 101
        },
        {
          "witness": "yu149",
          "quote": "故中書令太常王獻之、新安公主息女，六行聿修，四德允備",
          "source_layer": "正文",
          "raw_start": 4881,
          "raw_end": 4907,
          "raw_line": 99
        },
        {
          "witness": "yu149",
          "quote": "百官朱服，會于新安公主第，秘書監王操之爲主人。",
          "source_layer": "正文",
          "raw_start": 4637,
          "raw_end": 4660,
          "raw_line": 93
        }
      ],
      "reading": "安僖王皇后是獻之與新安公主女。晉書作諱神愛，王隱晉書作字神受；父母與后號可互證，讀字及名／字之別各歸原書。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line116",
        "start": 91,
        "end": 107,
        "quote": "無子，以兄子靜之嗣，位至義興太守"
      },
      "witnesses": [],
      "reading": "靜之為獻之兄子，所承為獻之。嗣與親生父子區別；王羲之是其父系祖父。無子於此指無男嗣，非無女。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-032-wang080-xianzhi:empress",
        "start": 59,
        "end": 68,
        "quote": "義熙八年崩于徽音殿"
      },
      "witnesses": [
        {
          "witness": "an",
          "quote": "===義熙八年===",
          "source_layer": "年題",
          "raw_start": 7852,
          "raw_end": 7862,
          "raw_line": 254
        },
        {
          "witness": "an",
          "quote": "八月，皇后王氏崩。",
          "source_layer": "正文",
          "raw_start": 8081,
          "raw_end": 8090,
          "raw_line": 265
        },
        {
          "witness": "an",
          "quote": "九月癸酉，葬僖皇后于休平陵。",
          "source_layer": "正文",
          "raw_start": 8104,
          "raw_end": 8118,
          "raw_line": 267
        }
      ],
      "reading": "安帝紀載義熙八年八月崩，九月癸酉葬休平陵。卒日未載，後一句辛亥屬高密王純之。",
      "lunar_month_of_death": 8,
      "death_day": null,
      "lunar_month_of_burial": 9,
      "sexagenary_day_of_burial": "癸酉"
    }
  ],
  "items": [],
