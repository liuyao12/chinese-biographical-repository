  "comparisons": [
    {
      "anchor": {
        "paragraph_id": "c-jinshu-076-wangyi-family:p001",
        "start": 14,
        "end": 18,
        "surface": "元帝姨弟"
      },
      "reading": "本紀相反方向稱從母弟王廙。同代母系，王廙母與先后分列。",
      "sources": [
        {
          "witness": "ann",
          "quote": "從母弟王廙爲母立屋過制，流涕止之。",
          "raw_start": 7671,
          "raw_end": 7688,
          "raw_line": 154
        }
      ]
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-076-wangyi-family:line033",
        "start": 4,
        "end": 8,
        "surface": "侍於先後"
      },
      "reading": "固定本先後，殿本先后。卷31記元夏侯太妃名光姬、生元帝。",
      "sources": [
        {
          "witness": "hou",
          "quote": "元夏侯太妃名光姬，沛國譙人也。",
          "raw_start": 11758,
          "raw_end": 11773,
          "raw_line": 158
        },
        {
          "witness": "hou",
          "quote": "為世子覲納焉，生元帝。",
          "raw_start": 11835,
          "raw_end": 11846,
          "raw_line": 160
        }
      ]
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-076-wangyi-family:line033",
        "start": 137,
        "end": 146,
        "surface": "雖京房、管輅不過也"
      },
      "reading": "疏以兩人比郭璞爻筮。各自本傳核君明與公明。",
      "sources": [
        {
          "witness": "han",
          "quote": "京房字君明，東郡頓丘人也。治易，事梁人焦延壽。",
          "raw_start": 2249,
          "raw_end": 2272,
          "raw_line": 35
        },
        {
          "witness": "sg",
          "quote": "管輅字公明，平原人也。",
          "raw_start": 7903,
          "raw_end": 7914,
          "raw_line": 79
        }
      ]
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-076-wangyi-family:line035",
        "start": 24,
        "end": 33,
        "surface": "臣犬馬之年四十三矣"
      },
      "reading": "奏疏中自述，並非卒年。",
      "sources": [
        {
          "witness": "jin",
          "quote": "臣犬馬之年四十三矣",
          "raw_start": 2537,
          "raw_end": 2546,
          "raw_line": 35
        }
      ]
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-076-wangyi-family:p004",
        "start": 12,
        "end": 21,
        "surface": "頤之弟胡之，字修齡"
      },
      "reading": "本傳以修齡為字，世說言語之別傳作脩齡；賞譽劉注他處又稱小字。別傳另外記丹陽尹、祕書監等「並不就」。",
      "sources": [
        {
          "witness": "shi",
          "quote": "{{ProperNoun|胡之}}字{{ProperNoun|-{脩}-齡}}，{{ProperNoun|琅邪}}{{ProperNoun|臨沂}}人，{{ProperNoun|王廙}}之子也。",
          "raw_start": 50680,
          "raw_end": 50777,
          "raw_line": 83
        },
        {
          "witness": "shi",
          "quote": "歴{{ProperNoun|呉興}}太守，-{徴}-侍中、{{ProperNoun|丹陽}}尹、-{祕}-書監，-{並}-不就。拜使持節，都督{{ProperNoun|司州}}諸軍事、西中郎將、{{ProperNoun|司州}}刺史。",
          "raw_start": 50777,
          "raw_end": 50894,
          "raw_line": 83
        },
        {
          "witness": "shang",
          "quote": "修齡，王胡之小字也。",
          "raw_start": 16382,
          "raw_end": 16392,
          "raw_line": 138
        }
      ]
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-076-wangyi-family:p004",
        "start": 96,
        "end": 103,
        "surface": "子茂之亦有美譽"
      },
      "reading": "永嘉記另記胡之子和之字興道，稱祖「翼」。婚書收茂之及氶之。源字存據，未併異姓名。",
      "sources": [
        {
          "witness": "qing",
          "quote": "王和之字興道，琅琊人。祖翼，平南將軍。父胡之，司州刺史。和之歷永嘉太守、正員常侍。",
          "raw_start": 4985,
          "raw_end": 5026,
          "raw_line": 40
        },
        {
          "witness": "fs",
          "quote": "内兄胡之侍中丹陽尹西中郎將司州刺史妻常侍譙國夏侯女誕茂之氶之",
          "raw_start": 17531,
          "raw_end": 17561,
          "raw_line": 294
        }
      ]
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-076-wangyi-family:p004",
        "start": 111,
        "end": 121,
        "surface": "子敬弘，義熙末為尚書"
      },
      "reading": "南史數位王裕之題首缺其譜句，第15行起作敬弘；第71行另言胡之從孫鎭之祖耆之、父隨之。",
      "sources": [
        {
          "witness": "nan",
          "quote": "=王裕之=",
          "raw_start": 179,
          "raw_end": 184,
          "raw_line": 13
        },
        {
          "witness": "nan",
          "quote": "王鎭之字伯重，晉司州刺史胡之之從孫、而裕之從祖弟也。祖耆之，位中書郎，父隨之，上虞令。",
          "raw_start": 2850,
          "raw_end": 2893,
          "raw_line": 71
        },
        {
          "witness": "shang",
          "quote": "耆之字修載，琅邪人，荊州刺史廙第三子。歷中書郎、鄱陽太守、給事中。",
          "raw_start": 15789,
          "raw_end": 15822,
          "raw_line": 129
        },
        {
          "witness": "fs",
          "quote": "誕頤之胡之耆之美之",
          "raw_start": 17522,
          "raw_end": 17531,
          "raw_line": 294
        }
      ]
    }
  ],
