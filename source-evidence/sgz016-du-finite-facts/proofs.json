        "start": 19,
        "end": 23,
        "surface": "甘露二年",
        "paragraph_sha256": "73f6d9242f53fbd2b9c2aacf77c1bd61bbbb74252be2c877678426b157ddaeb8",
        "source_layer": "received_body"
      },
      "complete_body_interval": [
        {
          "id": "c-sanguozhi-016-duji-dushu:unit037",
          "text": "起家為河東太守嵗餘遷淮北都督䕶軍復以疾去恕所在務存大體而已其樹惠愛益得百姓歡心不及於畿頃之拜御史中丞恕在朝廷以不得當世之和故屢在外任復出為幽州刺史加建威將軍使持節䕶烏丸校尉時征北將軍程喜屯薊尚書袁侃等戒恕曰程申伯處先帝之世傾田園讓於青州足下今俱杖節使共屯一城宜深有以待之而恕不以為意至官未期有鮮卑大人兒不由關塞徑將數十騎詣州州斬所從來小子一人無表言上喜於是劾奏恕下廷尉當死以父畿勤事水死免為庶人徙章武郡是嵗嘉平元年",
          "source_position": {
            "source_layer": "received_body",
            "first_line": 355,
            "last_line": 365,
            "raw_projection_ref": "source-evidence/sgz016-duji-dushu/fixed-complete-unit.json"
          }
        },
        {
          "id": "c-sanguozhi-016-duji-dushu:unit039",
          "text": "恕倜儻任意而思不防患終致此敗初恕從趙郡還陳留阮武亦從清河太守徵俱自薄廷尉謂恕曰相觀才性可以由公道而持之不厲器能可以處大官而求之不順才學可以述古今而志之不一此所謂有其才而無其用今向閑暇可試潛思成一家言在章武遂著體論八篇",
          "source_position": {
            "source_layer": "received_body",
            "first_line": 373,
            "last_line": 379,
            "raw_projection_ref": "source-evidence/sgz016-duji-dushu/fixed-complete-unit.json"
          }
        },
        {
          "id": "c-sanguozhi-016-duji-dushu:unit041",
          "text": "又著興性論一篇蓋興於為已也四年卒於徙所甘露二年河東樂詳年九十餘上書訟畿之遺績朝廷感焉詔封恕子預為豐樂亭侯邑百户",
          "source_position": {
            "source_layer": "received_body",
            "first_line": 381,
            "last_line": 383,
            "raw_projection_ref": "source-evidence/sgz016-duji-dushu/fixed-complete-unit.json"
          }
        }
      ],
      "intervening_notes_not_era_antecedents": [
        "unit038",
        "unit040"
      ],
      "rationale": "同一恕主傳正文037記徙章武並指是歲嘉平元年，039續徙所著述，041四年卒於徙所後才轉甘露二年。四年是省年號紀年而非在徙四年duration。章內注034孟康的嘉平末/正始與注042樂詳年號不繼承，不能向前借之。249元年第四個中國曆年度為252；原字仍四年，不改寫原quote成嘉平四年。",
      "required_negative_cases": [
        "把252改253或甘露四259",
        "將後置甘露二年移作四年前件",
        "交換前後日期錨或跳過新增正文年號",
        "引用嵌注孟康/樂詳年號跨人回填",
        "整段raw/offset共移且重hash",
        "同一日期證據掛另一既存杜氏人物",
        "將書信52歲掛252或反推birth"
      ]
    },
    "expected_semantics": {
      "status": "source_attested"
    }
