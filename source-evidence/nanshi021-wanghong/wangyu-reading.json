    },
    {
      "paragraph_id": "c-nanshi-021-wangyu:p001",
      "first_line": 129,
      "start": 68,
      "end": 77,
      "surface": "毎佗怒，則召殺之。",
      "interpretation": "召殺死囚。"
    },
