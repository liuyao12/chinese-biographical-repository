      "quote": "祖僧衍，齊侍中。父茂璋，梁給事黃門侍郎。",
      "sha256": "8d95f1fe792049025076c024e18aec87f8fd42ac2d05afea063555680e852328",
      "note": "兩代祖父。"
    },
    {
      "path": "sources/chenshu/chenshu017-ws1544244.wikitext",
      "revision": 1544244,
      "line": 12,
      "start": 42,
      "quote": "新安穆公主",
      "sha256": "8d95f1fe792049025076c024e18aec87f8fd42ac2d05afea063555680e852328",
      "note": "早證公主多諡穆。"
    },
    {
      "path": "sources/chenshu/chenshu017-ws1544244.wikitext",
      "revision": 1544244,
      "line": 12,
      "start": 203,
      "quote": "以帝甥賜爵安東亭侯",
      "sha256": "8d95f1fe792049025076c024e18aec87f8fd42ac2d05afea063555680e852328",
      "note": "大同三年，東安／安東倒字。"
    },
    {
      "path": "sources/chenshu/chenshu017-ws1544244.wikitext",
      "revision": 1544244,
      "line": 14,
      "start": 16,
      "quote": "沖求解南郡，以讓王僧辯",
      "sha256": "8d95f1fe792049025076c024e18aec87f8fd42ac2d05afea063555680e852328",
      "note": "同一解任請求。"
    },
    {
      "path": "sources/chenshu/chenshu017-ws1544244.wikitext",
      "revision": 1544244,
      "line": 24,
      "start": 14,
      "quote": "第十二子瑒",
      "sha256": "8d95f1fe792049025076c024e18aec87f8fd42ac2d05afea063555680e852328",
      "note": "三十子中排行十二。"
    },
    {
      "path": "sources/chenshu/chenshu001-ws2576168.wikitext",
      "revision": 2576168,
      "line": 11,
      "start": 2,
      "quote": "高祖武皇帝諱霸先",
      "sha256": "40450540160edee88b976181c79aa4f492c1bee458fdfe664573c734beee59d7",
      "note": "武帝名。"
    },
    {
      "path": "sources/chenshu/chenshu001-ws2576168.wikitext",
      "revision": 2576168,
      "line": 11,
      "start": 204,
      "quote": "道巨生皇考文讚",
      "sha256": "40450540160edee88b976181c79aa4f492c1bee458fdfe664573c734beee59d7",
      "note": "與新唐陳氏序文讚子霸先同父同名，非孤立名合。"
    },
    {
      "path": "sources/chenshu/chenshu003-ws2361318.wikitext",
      "revision": 2361318,
      "line": 11,
      "start": 2,
      "quote": "世祖文皇帝諱蒨",
      "sha256": "fb5cf1e77b55ed92d52f1faefa58f43e57e2faac470a13f6bb09c6d68a129587",
      "note": "陳文帝名。"
    },
    {
      "path": "sources/liangshu/liangshu005-ws2312810.wikitext",
      "revision": 2312810,
      "line": 11,
      "start": 2,
      "quote": "世祖孝元皇帝諱繹",
      "sha256": "8db54746cef2dcc177304ef83a2e0de6384208ce216a8794e7760cf604d853e1",
      "note": "本系湘東王繹，南史此處元帝即之。"
    },
    {
      "path": "sources/liangshu/liangshu006-ws2311629.wikitext",
      "revision": 2311629,
      "line": 10,
      "start": 2,
      "quote": "敬皇帝，諱方智",
      "sha256": "19d67594794369b7a3792773604f35c1e92418e3a82bd2c6206000f954305772",
      "note": "敬帝名。"
    },
    {
      "path": "sources/liangshu/liangshu006-ws2311629.wikitext",
      "revision": 2311629,
      "line": 10,
      "start": 113,
      "quote": "以帝爲太宰、承製",
      "sha256": "19d67594794369b7a3792773604f35c1e92418e3a82bd2c6206000f954305772",
      "note": "梁承聖三年十一月江陵陷。"
    }
  ],
