  "sentence_readings": [
    {
      "paragraph_id": "c-nanshi-021-wangchong:p001",
      "first_line": 111,
      "start": 0,
      "end": 52,
      "surface": "沖字長深，弘玄孫也。祖僧衍，位侍中。父茂璋字胤光，仕梁位給事黃門侍郎。沖母，梁武帝妹新安公主，卒于齊世。",
      "interpretation": "本人字長深、弘玄孫、祖僧衍、父茂璋字胤光，母為梁武帝妹，卒於齊。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangchong:p001",
      "first_line": 111,
      "start": 52,
      "end": 76,
      "surface": "武帝深鍾愛沖，賜爵東安亭侯。累遷侍中，南郡太守。",
      "interpretation": "賜爵與任官。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangchong:p001",
      "first_line": 111,
      "start": 76,
      "end": 98,
      "surface": "習于法令，政號平理，雖無赫赫之譽，久而見思。",
      "interpretation": "法令及政績。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangchong:p001",
      "first_line": 111,
      "start": 98,
      "end": 121,
      "surface": "曉音樂，習歌舞，善與人交，貴遊之中，聲名籍甚。",
      "interpretation": "音樂與交遊。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangchong:p002",
      "first_line": 113,
      "start": 0,
      "end": 32,
      "surface": "侯景之亂，元帝承制，沖求解南郡讓王僧辯，並獻女伎十人，以助軍賞。",
      "interpretation": "讓郡、獻女伎助賞。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangchong:p002",
      "first_line": 113,
      "start": 32,
      "end": 41,
      "surface": "侯景平，授丹陽尹。",
      "interpretation": "授丹陽尹。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangchong:p002",
      "first_line": 113,
      "start": 41,
      "end": 61,
      "surface": "魏平江陵，敬帝爲太宰承制，以沖爲左長史。",
      "interpretation": "西魏平江陵；敬帝以太宰承制，沖為長史。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangchong:p002",
      "first_line": 113,
      "start": 61,
      "end": 89,
      "surface": "紹泰中，累遷左光祿大夫、尚書左僕射、開府儀同三司，給扶。",
      "interpretation": "三職及給扶。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangchong:p003",
      "first_line": 115,
      "start": 0,
      "end": 32,
      "surface": "陳武帝受禪，領太子少傅，加特進、左光祿大夫，領丹陽尹，參撰律令。",
      "interpretation": "禪代後歷官並參律。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangchong:p003",
      "first_line": 115,
      "start": 32,
      "end": 47,
      "surface": "帝以沖前代舊臣，特申長幼之敬。",
      "interpretation": "禮待前代舊臣。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangchong:p003",
      "first_line": 115,
      "start": 47,
      "end": 75,
      "surface": "文帝即位，益加尊重，嘗從幸司空徐度宅，宴筵之上，賜以幾。",
      "interpretation": "文帝赴徐度宅優禮沖。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangchong:p003",
      "first_line": 115,
      "start": 75,
      "end": 95,
      "surface": "光大元年薨，年七十六，贈司空，諡曰元簡。",
      "interpretation": "薨、報齡、追贈與諡。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangchong:p004",
      "first_line": 117,
      "start": 0,
      "end": 18,
      "surface": "沖有子三十人，並致通官；第十二子瑒。",
      "interpretation": "子三十人；瑒第十二子。"
    }
  ]
}
