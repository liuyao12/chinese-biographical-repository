  "sentence_readings": [
    {
      "paragraph_id": "c-nanshi-021-wangsengyou:p001",
      "first_line": 87,
      "start": 0,
      "end": 35,
      "surface": "遠子僧佑字胤宗，幼聰悟，叔父微撫其首曰：「兒神明意用，當不作率爾人。」",
      "interpretation": "父、名、字、叔父稱許。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangsengyou:p001",
      "first_line": 87,
      "start": 35,
      "end": 62,
      "surface": "雅爲從兄儉所重，毎鳴笳列騶到其門候之，僧佑輒稱疾不前。",
      "interpretation": "從兄儉來訪，佑稱疾。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangsengyou:p001",
      "first_line": 87,
      "start": 62,
      "end": 77,
      "surface": "儉曰：「此吾之所望於若人也。」",
      "interpretation": "儉說話及對象。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangsengyou:p001",
      "first_line": 87,
      "start": 77,
      "end": 96,
      "surface": "世皆推儉之愛名德，而重僧佑之不趨勢也。",
      "interpretation": "當世輿論。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangsengyou:p002",
      "first_line": 89,
      "start": 0,
      "end": 13,
      "surface": "未弱冠，頻經憂，居喪至孝。",
      "interpretation": "重喪。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangsengyou:p002",
      "first_line": 89,
      "start": 13,
      "end": 27,
      "surface": "服闋，發落略盡，殆不立冠帽。",
      "interpretation": "脫髮。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangsengyou:p002",
      "first_line": 89,
      "start": 27,
      "end": 44,
      "surface": "舉秀才，爲驃騎法曹，羸瘠不堪受命。",
      "interpretation": "薦舉及授官未能受命。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangsengyou:p003",
      "first_line": 91,
      "start": 0,
      "end": 15,
      "surface": "雅好博古，善老、莊，不尚繁華。",
      "interpretation": "老、莊學。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangsengyou:p003",
      "first_line": 91,
      "start": 15,
      "end": 33,
      "surface": "工草隸，善鼓琴，亭然獨立，不交當世。",
      "interpretation": "琴書、不交。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangsengyou:p003",
      "first_line": 91,
      "start": 33,
      "end": 47,
      "surface": "沛國劉瓛聞風而悅，上書薦之。",
      "interpretation": "劉瓛薦。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangsengyou:p003",
      "first_line": 91,
      "start": 47,
      "end": 67,
      "surface": "爲著作佐郎，遷司空祭酒，謝病不與公卿遊。",
      "interpretation": "任官及謝病。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangsengyou:p003",
      "first_line": 91,
      "start": 67,
      "end": 106,
      "surface": "齊高帝謂王儉曰：「卿從可謂朝隱。」答曰：「臣從非敢妄同高人，直是愛閑多病耳。」",
      "interpretation": "帝問儉答。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangsengyou:p003",
      "first_line": 91,
      "start": 106,
      "end": 138,
      "surface": "經贈儉詩云：「汝家在市門，我家在南郭；汝家饒賓侶，我家多鳥雀。」",
      "interpretation": "贈儉詩。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangsengyou:p003",
      "first_line": 91,
      "start": 138,
      "end": 162,
      "surface": "儉時聲高一代，賓客填門，僧佑不爲之屈，時人嘉之。",
      "interpretation": "賓客及時評。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangsengyou:p004",
      "first_line": 93,
      "start": 0,
      "end": 23,
      "surface": "稍遷晉安王文學，而陳郡袁利爲友，時人以爲妙選。",
      "interpretation": "王府二人任職。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangsengyou:p004",
      "first_line": 93,
      "start": 23,
      "end": 44,
      "surface": "齊武帝數閱武，僧佑獻講武賦，王儉借觀不與。",
      "interpretation": "閱武、賦、拒借。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangsengyou:p004",
      "first_line": 93,
      "start": 44,
      "end": 65,
      "surface": "竟陵王子良聞其工琴，於座取琴進之，不從命。",
      "interpretation": "命奏琴、拒命。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangsengyou:p004",
      "first_line": 93,
      "start": 65,
      "end": 88,
      "surface": "永明末，爲太子中舍人，在直屬疾，不待對人輒去。",
      "interpretation": "任中舍人及值病徑去。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangsengyou:p004",
      "first_line": 93,
      "start": 88,
      "end": 118,
      "surface": "中丞沈約彈之云：「肆情運氣，不顧朝典，揚眉闊步，直轡高驅。」",
      "interpretation": "沈約彈語。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangsengyou:p004",
      "first_line": 93,
      "start": 118,
      "end": 122,
      "surface": "坐贖論。",
      "interpretation": "論罪。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangsengyou:p004",
      "first_line": 93,
      "start": 122,
      "end": 139,
      "surface": "時何點、王思遠之徒請交，並不降意。",
      "interpretation": "求交。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangsengyou:p004",
      "first_line": 93,
      "start": 139,
      "end": 154,
      "surface": "自天子至於侯伯，未嘗與一人遊。",
      "interpretation": "不屈意交遊。"
