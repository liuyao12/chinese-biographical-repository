    {
      "path": "sources/liangshu/liangshu050-ws1514482.wikitext",
      "revision": 1514482,
      "line": 77,
      "start": 14,
      "quote": "祖遠，宋光祿勳。父僧祐，齊驍騎將軍",
      "sha256": "46f17adb85a40252096bb10bb6b90ba40178ae6da293368629eded0273320cf8",
