  "sentence_readings": [
    {
      "paragraph_id": "c-nanshi-021-wangyang:p001",
      "first_line": 121,
      "start": 0,
      "end": 15,
      "surface": "瑒字子瑛，沈靜有器局，美風儀。",
      "interpretation": "名字、性儀。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangyang:p001",
      "first_line": 121,
      "start": 15,
      "end": 27,
      "surface": "梁元帝時，位太子中庶子。",
      "interpretation": "梁末官。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangyang:p001",
      "first_line": 121,
      "start": 27,
      "end": 41,
      "surface": "陳武帝入輔，以爲司徒左長史。",
      "interpretation": "陳武帝輔政時任司徒左長史。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangyang:p001",
      "first_line": 121,
      "start": 41,
      "end": 62,
      "surface": "文帝即位，累遷太子中庶子、散騎常侍、侍中。",
      "interpretation": "陳文帝在位官。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangyang:p001",
      "first_line": 121,
      "start": 62,
      "end": 102,
      "surface": "父沖嘗爲瑒辭領中庶子，文帝顧沖曰：「所以久留瑒于承華，正欲使太子微有瑒風法耳。」",
      "interpretation": "父代辭，文帝向父交代留瑒輔太子。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangyang:p002",
      "first_line": 123,
      "start": 0,
      "end": 15,
      "surface": "宣帝即位，曆中書令，吏部尚書。",
      "interpretation": "中書令、吏部尚書。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangyang:p002",
      "first_line": 123,
      "start": 15,
      "end": 29,
      "surface": "瑒性寬和，務清靜，無所抑揚。",
      "interpretation": "居選溫和。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangyang:p002",
      "first_line": 123,
      "start": 29,
      "end": 44,
      "surface": "遷尚書左僕射，加侍中，參選事。",
      "interpretation": "左僕射加侍中參選事。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangyang:p003",
      "first_line": 125,
      "start": 0,
      "end": 17,
      "surface": "瑒居家篤睦，毎歲時饋遺，遍及近親。",
      "interpretation": "歲時餽遺近親。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangyang:p003",
      "first_line": 125,
      "start": 17,
      "end": 27,
      "surface": "敦誘諸弟，稟其規訓。",
      "interpretation": "諸弟遵其教。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangyang:p003",
      "first_line": 125,
      "start": 27,
      "end": 38,
      "surface": "卒，贈特進，諡曰光子。",
      "interpretation": "卒、贈特進、諡光子。"
    }
  ]
}
