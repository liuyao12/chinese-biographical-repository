      "revision": 8231316,
      "line": 10,
      "start": 2,
      "quote": "廢帝諱伯宗，字奉業，小字藥王，世祖嫡長子也",
      "sha256": "01b2eb26650d8ef2cfe74c20abd152d50d56b1427b5cb532d6d9377ecfb2c298",
      "note": "文帝世子。"
    },
    {
      "path": "sources/chenshu/chenshu004-ws8231316.wikitext",
      "revision": 8231316,
      "line": 10,
      "start": 68,
