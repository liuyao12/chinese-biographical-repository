    },
    {
      "path": "sources/chenshu/chenshu023-ws1514496.wikitext",
      "revision": 1514496,
      "line": 24,
      "start": 43,
      "quote": "司空沖之第十二子也",
      "sha256": "c2a284e02e38025663289282e4f2050b5f225012ab2bec7615b33105d877a4e6",
