  "sentence_readings": [
    {
      "paragraph_id": "c-nanshi-021-wangji:p001",
      "first_line": 97,
      "start": 0,
      "end": 29,
      "surface": "籍字文海，仕齊爲余杭令，政化如神，善於擿伏，自下莫能欺也。",
      "interpretation": "名、字、齊縣職與政。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangji:p001",
      "first_line": 97,
      "start": 29,
      "end": 42,
      "surface": "性頗不儉，俄然爲百姓所訟。",
      "interpretation": "不儉被訟。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangji:p001",
      "first_line": 97,
      "start": 42,
      "end": 64,
      "surface": "又爲錢唐縣，下車布政，咸謂數十年來未之有也。",
      "interpretation": "錢唐任及時譽。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangji:p002",
      "first_line": 99,
      "start": 0,
      "end": 15,
      "surface": "籍好學，有才氣，爲詩慕謝靈運。",
      "interpretation": "詩慕靈運。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangji:p002",
      "first_line": 99,
      "start": 15,
      "end": 25,
      "surface": "至其合也，殆無愧色。",
      "interpretation": "時評才力。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangji:p002",
      "first_line": 99,
      "start": 25,
      "end": 51,
      "surface": "時人咸謂康樂之有王籍，如仲尼之有丘明，老聃之有嚴周。",
      "interpretation": "三組比擬。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangji:p002",
      "first_line": 99,
      "start": 51,
      "end": 73,
      "surface": "梁天監中，爲輕車湘東王諮議參軍，隨府會稽郡。",
      "interpretation": "湘東王府及會稽。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangji:p002",
      "first_line": 99,
      "start": 73,
      "end": 95,
      "surface": "至若邪溪賦詩云：「蟬噪林逾靜，鳥鳴山更幽。」",
      "interpretation": "詩句。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangji:p002",
      "first_line": 99,
      "start": 95,
      "end": 107,
      "surface": "劉孺見之，擊節不能已已。",
      "interpretation": "稱賞。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangji:p002",
      "first_line": 99,
      "start": 107,
      "end": 112,
      "surface": "以公事免。",
      "interpretation": "免官。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangji:p003",
      "first_line": 101,
      "start": 0,
      "end": 25,
      "surface": "及爲中散大夫，彌忽忽不樂，乃至徒行市道，不擇交遊。",
      "interpretation": "中散大夫、徒行交遊。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangji:p003",
      "first_line": 101,
      "start": 25,
      "end": 40,
      "surface": "有時塗中見相識，輒以笠傘覆面。",
      "interpretation": "以傘覆面。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangji:p003",
      "first_line": 101,
      "start": 40,
      "end": 61,
      "surface": "後爲作唐侯相，小邑寡事，彌不樂，不理縣事。",
      "interpretation": "作唐侯相及縣政。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangji:p003",
      "first_line": 101,
      "start": 61,
      "end": 71,
      "surface": "人有訟者，鞭而遣之。",
      "interpretation": "拒訟。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangji:p003",
      "first_line": 101,
      "start": 71,
      "end": 76,
      "surface": "未幾而卒。",
      "interpretation": "卒。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangji:p003",
      "first_line": 101,
      "start": 76,
      "end": 96,
      "surface": "籍又甚工草書，筆勢遒放，蓋孔琳之流亞也。",
      "interpretation": "書法比孔琳之。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangji:p003",
      "first_line": 101,
      "start": 96,
      "end": 107,
      "surface": "湘東王集其文爲十卷云。",
      "interpretation": "集十卷。"
    }
  ]
}
