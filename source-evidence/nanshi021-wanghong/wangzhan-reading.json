  "sentence_readings": [
    {
      "paragraph_id": "c-nanshi-021-wangzhan:p001",
      "first_line": 101,
      "start": 0,
      "end": 41,
      "surface": "瞻字思範，弘從孫也。祖柳字休季，位光祿大夫、東亭侯。父猷字世倫，位侍中、光祿大夫。",
      "interpretation": "傳主名字、父祖及叔祖、所任官爵。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangzhan:p001",
      "first_line": 101,
      "start": 41,
      "end": 71,
      "surface": "瞻年六歲從師，時有伎經門過，同業皆出觀，瞻獨不視，習業如初。",
      "interpretation": "從師及對伎不顧。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangzhan:p001",
      "first_line": 101,
      "start": 71,
      "end": 98,
      "surface": "從父僧達聞而異之，謂其父猷曰：「大宗不衰，寄之此子。」",
      "interpretation": "從父稱許、對猷說。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangzhan:p001",
      "first_line": 101,
      "start": 98,
      "end": 109,
      "surface": "年十二居父憂，以孝聞。",
      "interpretation": "父喪。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangzhan:p001",
      "first_line": 101,
      "start": 109,
      "end": 118,
      "surface": "服闋，襲封東亭侯。",
      "interpretation": "襲爵。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangzhan:p001",
      "first_line": 101,
      "start": 118,
      "end": 134,
      "surface": "後頗好逸遊，爲閭里患，以輕薄稱。",
      "interpretation": "少時逸遊。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangzhan:p001",
      "first_line": 101,
      "start": 134,
      "end": 153,
      "surface": "及長，折節修士操，涉獵書記，善碁工射。",
      "interpretation": "改操。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangzhan:p002",
      "first_line": 103,
      "start": 0,
      "end": 11,
      "surface": "歷位驃騎將軍王晏長史。",
      "interpretation": "王晏長史。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangzhan:p002",
      "first_line": 103,
      "start": 11,
      "end": 21,
      "surface": "晏誅，出爲晉陵太守。",
      "interpretation": "赴晉陵任。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangzhan:p002",
      "first_line": 103,
      "start": 21,
      "end": 38,
      "surface": "潔己爲政，妻子不免饑寒，時號廉平。",
      "interpretation": "妻子饑寒，時號廉平。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangzhan:p002",
      "first_line": 103,
      "start": 38,
      "end": 60,
      "surface": "王敬則作亂，瞻赴都，敬則經晉陵郡，人多附之。",
      "interpretation": "舉兵途經。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangzhan:p002",
      "first_line": 103,
      "start": 60,
      "end": 82,
      "surface": "敬則敗，台軍討賊黨，瞻言愚人易動，不足窮法。",
      "interpretation": "平後請寬民罪。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangzhan:p002",
      "first_line": 103,
      "start": 82,
      "end": 88,
      "surface": "齊明帝從之。",
      "interpretation": "從其請。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangzhan:p002",
      "first_line": 103,
      "start": 88,
      "end": 93,
      "surface": "所全萬數。",
      "interpretation": "獲全人數。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangzhan:p002",
      "first_line": 103,
      "start": 93,
      "end": 99,
      "surface": "遷御史中丞。",
      "interpretation": "中丞。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangzhan:p003",
      "first_line": 105,
      "start": 0,
      "end": 13,
      "surface": "梁台建，爲侍中、吏部尚書。",
      "interpretation": "梁官。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangzhan:p003",
      "first_line": 105,
      "start": 13,
      "end": 28,
      "surface": "性率亮，居選部，所舉多行其意。",
      "interpretation": "風格與選舉。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangzhan:p003",
      "first_line": 105,
      "start": 28,
      "end": 49,
      "surface": "頗嗜酒，毎飲或彌日，而精神朗贍，不廢簿領。",
      "interpretation": "酒無廢事。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangzhan:p003",
      "first_line": 105,
      "start": 49,
      "end": 65,
      "surface": "梁武毎稱瞻有三術：射、棋、酒也。",
      "interpretation": "三術。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangzhan:p003",
      "first_line": 105,
      "start": 65,
      "end": 71,
      "surface": "卒，諡康侯。",
      "interpretation": "王瞻卒、諡。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangzhan:p003",
      "first_line": 105,
      "start": 71,
      "end": 77,
      "surface": "子長玄早卒。",
      "interpretation": "長玄早卒。"
    }
  ]
