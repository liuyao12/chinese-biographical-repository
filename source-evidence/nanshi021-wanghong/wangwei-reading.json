  "embedded_units": [],
  "unassigned": [
    "何偃亦參其議之「其」指舉微之議，遂足不履地之足是腳。",
    "數詞一間、五尺、四旬及二宿用途分記。家人、時論者未名。",
    "其服藥失度身卒屬弟，微不復自療後終；譜系載無子。"
  ],
  "sentence_readings": [
    {
      "paragraph_id": "c-nanshi-021-wangwei:p001",
      "first_line": 77,
      "start": 0,
      "end": 16,
      "surface": "微字景玄，弘弟光祿大夫孺之子也。",
      "interpretation": "父與伯父、名、字。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangwei:p001",
      "first_line": 77,
      "start": 16,
      "end": 43,
      "surface": "少好學，善屬文，工書，兼解音律及醫方卜筮陰陽數術之事。",
      "interpretation": "文、書、術數。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangwei:p001",
      "first_line": 77,
      "start": 43,
      "end": 51,
      "surface": "宋文帝賜以名蓍。",
      "interpretation": "賜名蓍。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangwei:p001",
      "first_line": 77,
      "start": 51,
      "end": 63,
      "surface": "初爲始興王友，父憂去職。",
      "interpretation": "王友、父喪。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangwei:p001",
      "first_line": 77,
      "start": 63,
      "end": 91,
      "surface": "微素無宦情，服闋，除南平王鑠右軍諮議參軍，仍爲中書侍郎。",
      "interpretation": "服闋後授二官。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangwei:p001",
      "first_line": 77,
      "start": 91,
      "end": 122,
      "surface": "時兄遠免官歷年，微歎曰：「我兄無事而屏廢，我何得而叼忝踰分？」",
      "interpretation": "兄免官與微自述。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangwei:p001",
      "first_line": 77,
      "start": 122,
      "end": 132,
      "surface": "文帝即以遠爲光祿勳。",
      "interpretation": "以遠為光祿勳。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangwei:p002",
      "first_line": 79,
      "start": 0,
      "end": 21,
      "surface": "微爲文好古，言頗抑揚，袁淑見之，謂爲訴屈。",
      "interpretation": "袁淑評論。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangwei:p002",
      "first_line": 79,
      "start": 21,
      "end": 40,
      "surface": "吏部尚書江湛舉微爲吏部郎，微確乎不拔。",
      "interpretation": "湛薦、微不就。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangwei:p002",
      "first_line": 79,
      "start": 40,
      "end": 59,
      "surface": "時論者或云微之見舉，廬江何偃亦參其議。",
      "interpretation": "有關何偃之傳言。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangwei:p002",
      "first_line": 79,
      "start": 59,
      "end": 72,
      "surface": "偃慮爲微所咎，與之書自陳。",
      "interpretation": "致微書。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangwei:p002",
      "first_line": 79,
      "start": 72,
      "end": 82,
      "surface": "微報書深言塵外之適。",
      "interpretation": "覆書。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangwei:p002",
      "first_line": 79,
      "start": 82,
      "end": 100,
      "surface": "其從弟僧綽宣文帝旨使就職，因留之宿。",
      "interpretation": "僧綽傳文帝旨。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangwei:p002",
      "first_line": 79,
      "start": 100,
      "end": 139,
      "surface": "微妙解天文，知當有大故，獨與僧綽仰視，謂曰：「此上不欺人，非智者其孰能免之。」",
      "interpretation": "觀天預警。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangwei:p002",
      "first_line": 79,
      "start": 139,
      "end": 144,
      "surface": "遂辭不就。",
      "interpretation": "辭不就。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangwei:p002",
      "first_line": 79,
      "start": 144,
      "end": 151,
      "surface": "尋有元凶之變。",
      "interpretation": "劉劭變。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangwei:p003",
      "first_line": 81,
      "start": 0,
      "end": 19,
      "surface": "微常住門屋一間，尋書玩古，遂足不履地。",
      "interpretation": "居處及閱讀。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangwei:p003",
      "first_line": 81,
      "start": 19,
      "end": 38,
      "surface": "終日端坐，床席皆生塵埃，唯當坐處獨淨。",
      "interpretation": "席上塵。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangwei:p003",
      "first_line": 81,
      "start": 38,
      "end": 72,
      "surface": "弟僧謙亦有才譽，爲太子舍人，遇疾，微躬自處療，而僧謙服藥失度，遂卒。",
      "interpretation": "弟官及因病去世。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangwei:p003",
      "first_line": 81,
      "start": 72,
      "end": 97,
      "surface": "深自咎恨，發病不復自療，哀痛僧謙不能已，以書告靈。",
      "interpretation": "微哀痛致疾及告靈。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangwei:p003",
      "first_line": 81,
      "start": 97,
      "end": 154,
      "surface": "僧謙卒後四旬而微終，遺令薄葬，不設車需旐鼓挽之屬，施五尺床爲靈，二宿便毀，以常所彈琴置床上，何長史偃來，以琴與之。",
      "interpretation": "二人卒相距四旬、遺令及贈琴。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangwei:p003",
      "first_line": 81,
      "start": 154,
      "end": 162,
      "surface": "無子，家人遵之。",
      "interpretation": "家人奉行。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangwei:p003",
      "first_line": 81,
      "start": 162,
      "end": 170,
      "surface": "所著文集傳於世。",
      "interpretation": "文集。"
    },
    {
      "paragraph_id": "c-nanshi-021-wangwei:p003",
      "first_line": 81,
      "start": 170,
      "end": 175,
      "surface": "贈秘書監。",
      "interpretation": "贈官。"
    }
  ]
}
