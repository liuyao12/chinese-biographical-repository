  "source_clauses": [
    {
      "witness": "w56",
      "quote": "朱然字義封，治姊子也，本姓施氏",
      "raw_start": 1561,
      "raw_end": 1576,
      "raw_line": 22
    },
    {
      "witness": "w56",
      "quote": "然為治行喪竟，乞復本姓，權不許",
      "raw_start": 3676,
      "raw_end": 3691,
      "raw_line": 41
    },
    {
      "witness": "w56",
      "quote": "又遣從兄慮以都下兵逆據於江都",
      "raw_start": 5638,
      "raw_end": 5652,
      "raw_line": 56
    },
    {
      "witness": "w56",
      "quote": "權謂異從父驃騎將軍據曰",
      "raw_start": 7608,
      "raw_end": 7619,
      "raw_line": 72
    },
    {
      "witness": "w56",
      "quote": "張惇子純與張儼及異俱童少",
      "raw_start": 7306,
      "raw_end": 7318,
      "raw_line": 72
    },
    {
      "witness": "w64",
      "quote": "孫綝字子通，與峻同祖",
      "raw_start": 10367,
      "raw_end": 10377,
      "raw_line": 78
    },
    {
      "witness": "w64",
      "quote": "遣從兄慮將兵逆據於江都",
      "raw_start": 10475,
      "raw_end": 10486,
      "raw_line": 78
    },
    {
      "witness": "w48",
      "quote": "遣孫憲及丁奉、施寬等以舟兵逆據於江都",
      "raw_start": 1461,
      "raw_end": 1479,
      "raw_line": 24
    },
    {
      "witness": "w48",
      "quote": "辛亥，獲呂據於新州",
      "raw_start": 1506,
      "raw_end": 1515,
      "raw_line": 24
    },
    {
      "witness": "w48",
      "quote": "綝殺惇，迫憲令自殺",
      "raw_start": 1549,
      "raw_end": 1558,
      "raw_line": 24
    },
    {
      "witness": "w59",
      "quote": "年二十，{{YL|嘉禾元年}}卒",
      "raw_start": 3049,
      "raw_end": 3065,
      "raw_line": 25
    },
    {
      "witness": "w59",
      "quote": "張純字元基，敦之子",
      "raw_start": 3387,
      "raw_end": 3396,
      "raw_line": 28
    },
    {
      "witness": "w59",
      "quote": "太常顧譚、驃騎將軍朱據",
      "raw_start": 4123,
      "raw_end": 4134,
      "raw_line": 32
    },
    {
      "witness": "w47",
      "quote": "車騎-{朱}-然爲左大司馬",
      "raw_start": 22761,
      "raw_end": 22774,
      "raw_line": 125
    },
    {
      "witness": "w47",
      "quote": "車騎將軍-{朱}-然圍樊，大將軍諸葛瑾取柤中",
      "raw_start": 21394,
