  "person_id": "7r6_k52_qji_AA",
  "source_scopes": [
    {
      "line": 14,
      "paragraph_id": "c-jinshu-033-wanglan-family:p001",
      "first": "王祥，字休徵，琅邪臨",
      "last": "。父融，公府辟不就。"
    },
    {
      "line": 16,
      "paragraph_id": "c-jinshu-033-wanglan-family:p002",
      "first": "祥性至孝。早喪親，繼",
      "last": "泣。其篤孝純至如此。"
    },
    {
      "line": 18,
      "paragraph_id": "c-jinshu-033-wanglan-family:p003",
      "first": "漢未遭亂，扶母攜弟覽",
      "last": "國不空，別駕之功。」"
    },
    {
      "line": 20,
      "paragraph_id": "c-jinshu-033-wanglan-family:p009",
      "first": "舉秀才，除溫令，累遷",
      "last": "訓之，聞者莫不砥礪。"
    },
    {
      "line": 22,
      "paragraph_id": "c-jinshu-033-wanglan-family:p010",
      "first": "及高貴鄕公之弑也，朝",
      "last": "陵侯，邑一千六百戸。"
    },
    {
      "line": 24,
      "paragraph_id": "c-jinshu-033-wanglan-family:p011",
      "first": "及武帝爲晉王，祥與荀",
      "last": "方知君見顧之重矣！」"
    },
    {
      "line": 26,
      "paragraph_id": "c-jinshu-033-wanglan-family:p012",
      "first": "武帝踐阼，拜太保，進",
      "last": "，須所賜第成乃出。」"
    },
    {
      "line": 28,
      "paragraph_id": "c-jinshu-033-wanglan-family:p013",
      "first": "及疾篤，著遺令訓子孫",
      "last": "！」其子皆奉而行之。"
    },
    {
      "line": 30,
      "paragraph_id": "c-jinshu-033-wanglan-family:p014",
      "first": "泰始五年薨，詔賜東園",
      "last": "。」明年，策諡曰元。"
    },
    {
      "line": 32,
      "paragraph_id": "c-jinshu-033-wanglan-family:p015",
      "first": "祥之薨，奔赴者非朝廷",
      "last": "肇、夏、馥、烈、芬。"
    },
    {
