  "columns": [
    {
      "pdf_page": 54,
      "half": "左",
      "leaf": "十三上",
      "column_from_right": 9,
      "reading": "王廣女者不知何許人也容質甚美慷慨有丈夫之節",
      "start_codepoint": 0,
      "end_codepoint": 21
    },
    {
      "pdf_page": 54,
      "half": "左",
      "leaf": "十三上",
      "column_from_right": 10,
      "reading": "廣仕劉聰為西揚州刺史蠻帥梅芳攻陷揚州而廣被",
      "start_codepoint": 21,
      "end_codepoint": 42
    },
    {
      "pdf_page": 55,
      "half": "右",
      "leaf": "十三下",
      "column_from_right": 1,
      "reading": "殺王時年十五芳納之俄於闇室擊芳不中芳驚起曰",
      "start_codepoint": 42,
      "end_codepoint": 63
    },
    {
      "pdf_page": 55,
      "half": "右",
      "leaf": "十三下",
      "column_from_right": 2,
      "reading": "何故反邪王罵曰蠻畜我欲誅反賊可謂反乎吾聞父",
      "start_codepoint": 63,
      "end_codepoint": 84
    },
    {
      "pdf_page": 55,
      "half": "右",
      "leaf": "十三下",
      "column_from_right": 3,
      "reading": "仇不同天母仇不同地汝反逆無狀害人父母而復以",
      "start_codepoint": 84,
      "end_codepoint": 105
    },
    {
      "pdf_page": 55,
      "half": "右",
      "leaf": "十三下",
      "column_from_right": 4,
      "reading": "無禮陵人吾所以不死者欲誅汝耳今死自吾分不待",
      "start_codepoint": 105,
      "end_codepoint": 126
    },
    {
      "pdf_page": 55,
      "half": "右",
      "leaf": "十三下",
      "column_from_right": 5,
      "reading": "汝殺但恨不得梟汝首於通達以塞大恥辭氣猛厲言",
      "start_codepoint": 126,
      "end_codepoint": 147
    },
    {
      "pdf_page": 55,
      "half": "右",
      "leaf": "十三下",
      "column_from_right": 6,
      "reading": "終乃自殺芳止之不可",
      "start_codepoint": 147,
      "end_codepoint": 156
    }
  ],
