  "section_reviews": [
    {
      "id": "c-sanguozhi-050-wu:line012:reading-000-100",
      "kind": "received_sentence",
      "paragraph_id": "c-sanguozhi-050-wu:line012",
      "start_codepoint": 0,
      "end_codepoint": 100,
      "source_quote": "孫破虜吳夫人，吳主權母也。本吳人，徙錢唐，早失父母。與弟景居。孫堅聞其才貌，欲娶之。吳氏親戚嫌堅輕狡，將拒焉，堅甚以慚恨。夫人謂親戚曰：「何愛一女以取禍乎？如有不遇，命也。」於是遂許為婚，生四男一女。",
      "person_id": "lm8_q5h_5uy",
      "related_person_ids": [
        "572_278_cba",
        "ere_ume_47r",
        "ki7_rgz_3l4"
      ],
      "reading": "吳夫人為孫權母、吳景姊、堅妻。稱四男一女，正文只逐名權，注另記策。"
    },
    {
      "id": "c-sanguozhi-050-wu:line012-pei01-01:reading-000-090",
      "kind": "annotation_sentence",
      "paragraph_id": "c-sanguozhi-050-wu:line012-pei01-01",
      "start_codepoint": 0,
      "end_codepoint": 90,
      "source_quote": "《搜神記》曰：初，夫人孕而夢月入其懷，既而生策。及權在孕，又夢日入其懷，以告堅曰：「昔妊策，夢月入我懷，今也又夢日入我懷，何也？」堅曰：「日月者陰陽之精，極貴之象，吾子孫其興乎！」",
      "person_id": "lm8_q5h_5uy",
      "related_person_ids": [
        "e9c_070_567",
        "572_278_cba",
        "ki7_rgz_3l4"
      ],
      "reading": "搜神記引吳夫人向堅述懷策與權之夢。"
    },
    {
      "id": "c-sanguozhi-050-wu:line014:reading-000-238",
      "kind": "received_sentence",
      "paragraph_id": "c-sanguozhi-050-wu:line014",
      "start_codepoint": 0,
      "end_codepoint": 238,
      "source_quote": "景常隨堅征伐有功，拜騎都尉。袁術上景領丹楊太守，討故太守周昕，遂據其郡。孫策與孫河、呂範依景，合眾共討涇縣山賊祖郎。郎敗走。會為劉繇所迫，景復北依術，術以為督軍中郎將，與孫賁共討樊能、於麋於橫江，又擊笮融、薛禮於秣陵。時策被創牛渚，降賊復反，景攻討，盡禽之。從討劉繇，繇奔豫章，策遣景、賁到壽春報術。術方與劉備爭徐州，以景為為廣陵太守。術後僭號。策以書喻術，術不納，便絕江津，不與通，使人告景。景即委郡東歸，策復以景為丹揚太守。漢遣議郎王誧銜命南行，表景為揚武將軍，領郡如故。",
      "person_id": "ere_ume_47r",
      "related_person_ids": [
        "ki7_rgz_3l4",
        "865_b69_cb0",
        "lsy_sjz_pse",
        "e9c_070_567",
        "07n_fwj_5jn",
        "908_816_219",
        "r9q_7ps_byt",
        "fvd_gis_x74",
        "8jx_b5c_t2q",
        "inu_9r1_qvc",
        "dq0_lxg_b7o",
        "brd_lue_3md",
        "fzd_d8c_9ya",
        "5f2_396_25c",
        "imu_6k9_4ay"
      ],
      "reading": "景從堅、策；術表領丹楊、後授廣陵；復歸策。兩京朝遣議郎表拜。"
    },
    {
      "id": "c-sanguozhi-050-wu:line014-pei01-01:reading-000-003",
      "kind": "annotation_sentence",
      "paragraph_id": "c-sanguozhi-050-wu:line014-pei01-01",
      "start_codepoint": 0,
      "end_codepoint": 3,
