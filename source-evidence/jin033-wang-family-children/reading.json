  "notes": [
    {
      "anchor": {
        "paragraph_id": "c-jinshu-033-wanglan-family:p016",
        "start": 0,
        "end": 11,
        "surface": "肇孽庶，夏早卒，馥嗣爵"
      },
      "reading": "肇明言孽庶，夏止記早卒；馥嗣父爵。未由列名次序補嫡長，未由嗣爵另造收養。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-033-wanglan-family:p016",
        "start": 41,
        "end": 48,
        "surface": "子根嗣，散騎郎"
      },
      "reading": "根承上文馥。另起肇官始平、肇子俊、俊子遐，兩支各有既在的父子斷言。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-033-wanglan-family:p016",
        "start": 94,
        "end": 101,
        "surface": "二子亦同時而亡"
      },
      "reading": "合敘烈與芬臨死所欲葬地；舊土與京邑是遺願，未充實葬地。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-033-wanglan-family:p007",
        "start": 47,
        "end": 51,
        "surface": "琛字士瑋"
      },
      "reading": "王覽子、字士瑋、國子祭酒。與太原另一王琛分號。",
      "excluded_person_id": "q7m_r8k_2vn_AAA"
    }
  ],
