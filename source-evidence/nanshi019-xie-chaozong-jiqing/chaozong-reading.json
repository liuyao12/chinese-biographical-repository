  "comparisons": [
    {
      "source_line": 190,
      "paragraph_id": "c-nanshi-019-chaozong:p001",
      "start": 0,
      "end": 4,
      "surface": "鳳子超宗",
      "quote": "鳳子超宗",
      "parallel_source": "nanqi036-ws1492438.wikitext",
      "revision": 1492438,
      "sha256": "92145d58d9a7c1453e31e7b0808e65506f29beee0b965519bd5b91b44abddbc9",
      "first_line": 12,
      "last_line": 12,
      "raw_lines": [
        "　　謝超宗，陳郡陽夏人也。祖靈運，宋臨川內史。父鳳，元嘉中坐靈運事，同徙嶺南，早卒。超宗元嘉末得還。與慧休道人來往，好學，有文辭，盛得名譽。解褐奉朝請。"
      ],
      "primary_quote": "祖靈運，宋臨川內史。父鳳",
      "interpretation": "父、祖有所據。",
      "url": "https://zh.wikisource.org/w/index.php?oldid=1492438"
    },
    {
      "source_line": 190,
      "paragraph_id": "c-nanshi-019-chaozong:p001",
      "start": 49,
      "end": 53,
      "surface": "殷淑儀卒",
      "quote": "殷淑儀卒",
      "parallel_source": "nanqi036-ws1492438.wikitext",
      "revision": 1492438,
      "sha256": "92145d58d9a7c1453e31e7b0808e65506f29beee0b965519bd5b91b44abddbc9",
      "first_line": 14,
      "last_line": 14,
      "raw_lines": [
        "　　新安王子鸞，孝武帝寵子，超宗以選補王國常侍。王母殷淑儀卒，超宗作誄奏之，帝大嗟賞。曰：「超宗殊有鳳毛，恐靈運復出。」轉新安王撫軍行參軍。"
      ],
      "primary_quote": "王母殷淑儀卒，超宗作誄奏之",
      "interpretation": "宋孝武帝寵子子鸞與其母殷淑儀。",
      "url": "https://zh.wikisource.org/w/index.php?oldid=1492438"
    },
    {
      "source_line": 192,
      "paragraph_id": "c-nanshi-019-chaozong:p002",
      "start": 11,
      "end": 13,
      "surface": "三年",
      "quote": "三年",
      "parallel_source": "nanqi036-ws1492438.wikitext",
      "revision": 1492438,
      "sha256": "92145d58d9a7c1453e31e7b0808e65506f29beee0b965519bd5b91b44abddbc9",
      "first_line": 16,
      "last_line": 16,
      "raw_lines": [
        "　　泰始初，爲建安王司徒參軍事，尚書殿中郎。三年，都令史駱宰議策秀才考格，五問竝得爲上，四、三爲中，二爲下，一不合與第。超宗議以爲「片辭折獄，寸言挫衆，魯史褒貶，孔《[[論語|論]]》興替，皆無俟繁而後秉裁。夫表事之淵，析理之會，豈必委牘方切治道。非患對不盡問，患以恒文弗奇。必使一通峻正，寧劣五通而常；與其俱奇，必使一亦宜採。」詔從宰議。"
      ],
      "primary_quote": "泰始初，爲建安王司徒參軍事，尚書殿中郎。三年",
      "interpretation": "據元年465換算467。",
      "url": "https://zh.wikisource.org/w/index.php?oldid=1492438"
    },
    {
      "source_line": 194,
      "paragraph_id": "c-nanshi-019-chaozong:p003",
      "start": 60,
      "end": 64,
      "surface": "昇明二年",
