  "source_clauses": [
    {
      "witness": "sg",
      "quote": "少與舅陸績齊名",
      "raw_start": 6566,
      "raw_end": 6573,
      "raw_line": 48
    },
    {
      "witness": "sg",
      "quote": "權妻以策女。",
      "raw_start": 6708,
      "raw_end": 6714,
      "raw_line": 48
    },
    {
      "witness": "sg",
      "quote": "烏程呉粲、雲陽殷禮起乎微賤",
      "raw_start": 6805,
      "raw_end": 6818,
      "raw_line": 48
    },
    {
      "witness": "sg",
      "quote": "文士传曰：礼子基，无难督，以才学知名，著通语数十篇。有三子。",
      "raw_start": 7015,
      "raw_end": 7045,
      "raw_line": 48
    },
    {
      "witness": "sg47",
      "quote": "零陵太守殷禮言於權曰",
      "raw_start": 21433,
      "raw_end": 21443,
      "raw_line": 115
    },
    {
      "witness": "sg48",
      "quote": "虞翻、陸績、張溫、張惇以諷議舉正",
      "raw_start": 19385,
      "raw_end": 19401,
      "raw_line": 107
    },
    {
      "witness": "sg57",
      "quote": "陸績字公紀，吳郡吳人也。父康，漢末為廬江太守。",
      "raw_start": 8028,
      "raw_end": 8051,
      "raw_line": 37
    },
    {
      "witness": "sg57",
      "quote": "陸瑁字子璋，丞相遜弟也。",
      "raw_start": 13251,
      "raw_end": 13263,
      "raw_line": 74
    },
    {
      "witness": "sg57",
      "quote": "吾粲字孔休，吳郡烏程人也。",
      "raw_start": 14537,
      "raw_end": 14550,
      "raw_line": 85
    },
    {
      "witness": "sg59",
      "quote": "吏民稱之，以爲前有顧劭，其次即景。",
      "raw_start": 2540,
      "raw_end": 2557,
      "raw_line": 22
    }
  ],
