      "action": "授予符節，字面假與節中間有琰字。",
      "evidence": {
        "work_id": "w-jinshu",
        "book_id": "b-jinshu-079",
        "source_id": "s-jinshu-079-xielang-family",
        "chapter_id": "c-jinshu-079-xielang-family",
        "paragraph_id": "c-jinshu-079-xielang-family:phase6-line065",
        "quote": "王恭舉兵，假琰節"
      },
      "start": 31,
      "end": 39
    },
    {
      "person_id": "aa6_83c_juy_BA",
      "source_mention_id": "c-jinshu-079-xielang-family:phase6-line065:m0140",
      "action": "琰至義興、斬許允之、迎魏鄢還郡。",
      "evidence": {
        "work_id": "w-jinshu",
        "book_id": "b-jinshu-079",
        "source_id": "s-jinshu-079-xielang-family",
        "chapter_id": "c-jinshu-079-xielang-family",
        "paragraph_id": "c-jinshu-079-xielang-family:phase6-line065",
        "quote": "討恩。至義興，斬賊許允之，迎太守魏鄢還郡。"
      },
      "start": 80,
      "end": 101
    },
    {
      "person_id": "65b_906_251",
      "source_mention_id": "c-jinshu-079-xielang-family:phase6-line065:m0106",
      "action": "吳興賊丘尪為被討者。",
      "evidence": {
        "work_id": "w-jinshu",
        "book_id": "b-jinshu-079",
        "source_id": "s-jinshu-079-xielang-family",
        "chapter_id": "c-jinshu-079-xielang-family",
        "paragraph_id": "c-jinshu-079-xielang-family:phase6-line065",
        "quote": "進討吳興賊丘尪，破之。"
      },
      "start": 101,
      "end": 112
    },
    {
      "person_id": "a7f_c0a_373",
      "source_mention_id": "c-jinshu-079-xielang-family:phase6-line065:m0128",
      "action": "逃海者孫恩。",
      "evidence": {
        "work_id": "w-jinshu",
        "book_id": "b-jinshu-079",
        "source_id": "s-jinshu-079-xielang-family",
        "chapter_id": "c-jinshu-079-xielang-family",
        "paragraph_id": "c-jinshu-079-xielang-family:phase6-line065",
        "quote": "恩逃於海島"
      },
      "start": 128,
      "end": 133
    },
    {
      "person_id": "a7f_c0a_373",
      "source_mention_id": "c-jinshu-079-xielang-family:phase6-line065:m0280",
      "action": "主語孫恩，三十五里為距離。",
      "evidence": {
        "work_id": "w-jinshu",
        "book_id": "b-jinshu-079",
        "source_id": "s-jinshu-079-xielang-family",
        "chapter_id": "c-jinshu-079-xielang-family",
        "paragraph_id": "c-jinshu-079-xielang-family:phase6-line065",
        "quote": "恩後果復寇浹口，入余姚，破上虞，進及邢浦，去山陰北三十五里。"
      },
      "start": 280,
      "end": 310
    },
    {
      "person_id": "aa6_83c_juy_BA",
      "source_mention_id": "c-jinshu-079-xielang-family:phase6-line065:m0310",
      "action": "琰遣劉宣之，受擊者孫恩。",
      "evidence": {
        "work_id": "w-jinshu",
        "book_id": "b-jinshu-079",
        "source_id": "s-jinshu-079-xielang-family",
        "chapter_id": "c-jinshu-079-xielang-family",
        "paragraph_id": "c-jinshu-079-xielang-family:phase6-line065",
        "quote": "琰遣參軍劉宣之距破恩"
      },
      "start": 310,
      "end": 320
    },
    {
      "person_id": "aa6_83c_juy_BA",
      "source_mention_id": "c-jinshu-079-xielang-family:phase6-line065:m0446",
      "action": "琰敗於千秋亭，後敘落馬被害。",
      "evidence": {
        "work_id": "w-jinshu",
        "book_id": "b-jinshu-079",
        "source_id": "s-jinshu-079-xielang-family",
        "chapter_id": "c-jinshu-079-xielang-family",
        "paragraph_id": "c-jinshu-079-xielang-family:phase6-line065",
        "quote": "琰至千秋亭，敗績。"
      },
      "start": 446,
      "end": 455
    },
    {
      "person_id": "76b_a82_793",
      "source_mention_id": "c-jinshu-079-xielang-family:phase6-line065:m0460",
      "action": "張猛斫馬；其後由劉裕軍生擒。",
      "evidence": {
