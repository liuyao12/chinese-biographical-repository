          {
            "line": 181,
            "raw_start": 0,
            "raw_end": 21,
            "text": "若夫山林之士夷叔之倫甘長饑於首陽安赴火於緜"
          },
          {
            "line": 182,
            "raw_start": 0,
            "raw_end": 21,
            "text": "山雖可以激貪勵俗然聖人不可為吾亦不願也今汝"
          },
          {
            "line": 183,
            "raw_start": 0,
            "raw_end": 21,
            "text": "先人世有冠冕惟仁義為名守慎為稱孝悌於閨門務"
          },
          {
            "line": 184,
            "raw_start": 0,
            "raw_end": 21,
            "text": "學於師友吾與時人從事雖出處不同然各有所取潁"
          },
          {
            "line": 186,
            "raw_start": 0,
            "raw_end": 21,
            "text": "川郭伯益好尚通達敏而有知其為人弘曠不足輕貴"
          },
          {
            "line": 187,
            "raw_start": 0,
            "raw_end": 21,
            "text": "有餘得其人重之如山不得其人忽之如草吾以所知"
          },
          {
            "line": 188,
            "raw_start": 0,
            "raw_end": 10,
            "text": "親之昵之不願兒子為之"
          }
        ],
