{
  "raw_sha256": "355513e59fefc781bdfef4cf7c07f8af774841fc890b300c22e8449fe5906a8b",
  "units": [
    {
      "key": "unit001",
      "layer": "received_chapter",
      "raw_window": [
        1,
        3
      ],
      "raw_runs": [
        {
          "raw_line": 1,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "王曇首琅邪臨沂人太保弘少弟也幼有業尚除著作"
        },
        {
          "raw_line": 2,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "郎不就兄弟分財曇首唯取圖書而已辟琅邪王大司"
        },
        {
          "raw_line": 3,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "馬屬從府公脩復洛陽園陵與從弟球俱詣高祖時謝"
        }
      ],
      "text_sha256": "b00351ddac76d684287547b2bd35d6e10e77352af8c86c7a516bd930d169c54c"
    },
    {
      "key": "unit002",
      "layer": "received_chapter",
      "raw_window": [
        4,
        13
      ],
      "raw_runs": [
        {
          "raw_line": 4,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "晦在坐高祖曰此君並膏粱盛德乃能屈志戎旅曇首"
        },
        {
          "raw_line": 5,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "答曰既從神武之師自使懦夫有立志晦曰仁者果有"
        },
        {
          "raw_line": 6,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "勇高祖悅行至彭城高祖大會戲馬臺豫坐者皆賦詩"
        },
        {
          "raw_line": 7,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "曇首文先成高祖覽讀因問弘曰卿弟何如卿弘答曰"
        },
        {
          "raw_line": 8,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "若但如臣門戶何寄高祖大笑曇首有識局智度喜慍"
        },
        {
          "raw_line": 9,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "不見於色閨門之內雍雍如也手不執金玉婦女不得"
        },
        {
          "raw_line": 10,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "為飾玩自非祿賜所及一毫不受於人太祖為冠軍徐"
        },
        {
          "raw_line": 11,
          "raw_start": 0,
          "raw_end": 21,
          "start": 147,
          "end": 168,
          "surface": "州刺史留鎮彭城以曇首為府功曹太祖鎮江陵自功"
        },
        {
          "raw_line": 12,
          "raw_start": 0,
          "raw_end": 21,
          "start": 168,
          "end": 189,
          "surface": "曹為長史隨府轉鎮西長史高祖甚知之謂太祖曰王"
        },
        {
          "raw_line": 13,
          "raw_start": 0,
          "raw_end": 21,
          "start": 189,
          "end": 210,
          "surface": "曇首沈毅有器度宰相才也汝每事咨之景平中有龍"
        }
      ],
      "text_sha256": "4c005f4c9f72b0a69b01c0d337c8a83a4106b533354c980a110ea0fa38c8baf6"
    },
    {
      "key": "unit003",
      "layer": "received_chapter",
      "raw_window": [
        14,
        23
      ],
      "raw_runs": [
        {
          "raw_line": 14,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "見西方牛斗騰上虛五緯雲京都遠近聚觀太史奏曰"
        },
        {
          "raw_line": 15,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "西方有天子氣太祖入奉大統上及議者皆疑不敢下"
        },
        {
          "raw_line": 16,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "曇首與到彥之從兄華固勸上猶未許曇首又固陳并"
        },
        {
          "raw_line": 17,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "言天人符應上乃下率府州文武嚴兵自衞臺所遣百"
        },
        {
          "raw_line": 18,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "官衆力不得近部伍中兵參軍朱容子抱刀在平乘戶"
        },
        {
          "raw_line": 19,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "外不解帶者數旬既下在道有黃龍出負上所乘舟左"
        },
        {
          "raw_line": 20,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "右皆失色上謂曇首曰此乃夏禹所以受天命我何堪"
        },
        {
          "raw_line": 21,
          "raw_start": 0,
          "raw_end": 21,
          "start": 147,
          "end": 168,
          "surface": "之及即位又謂曇首曰非宋昌獨見無以致此以曇首"
        },
        {
          "raw_line": 22,
          "raw_start": 0,
          "raw_end": 21,
          "start": 168,
          "end": 189,
          "surface": "為侍中尋領右衞將軍領驍騎將軍以朱容子為右軍"
        },
        {
          "raw_line": 23,
          "raw_start": 0,
          "raw_end": 21,
          "start": 189,
          "end": 210,
          "surface": "將軍誅徐羨之等平謝晦曇首及華之力也元嘉四年"
        }
      ],
      "text_sha256": "f991991de1696bc683af2d0fddc9efcd928507d0a876fc69777e82eef6c4d60e"
    },
    {
      "key": "unit004",
      "layer": "received_chapter",
      "raw_window": [
        24,
        33
      ],
      "raw_runs": [
        {
          "raw_line": 24,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "車駕出北堂嘗使三更竟開廣莫門南臺云應須白虎"
        },
        {
          "raw_line": 25,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "幡銀字棨不肯開門尚書左丞羊玄保奏免御史中丞"
        },
        {
          "raw_line": 26,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "傅隆以下曇首繼啟曰既無墨敕又闕幡棨雖稱上旨"
        },
        {
          "raw_line": 27,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "不異單刺元嘉二年雖有再開門例此乃前事之違今"
        },
        {
          "raw_line": 28,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "之守舊未為非禮但既據舊使應有疑却本末曾無此"
        },
        {
          "raw_line": 29,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "狀猶宜厥咎其不請白虎幡銀字棨致門不時開由尚"
        },
        {
          "raw_line": 30,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "書相承之失亦合糾正上特無所問更立科條還太子"
        },
        {
          "raw_line": 31,
          "raw_start": 0,
          "raw_end": 21,
          "start": 147,
          "end": 168,
          "surface": "詹事侍中如故晦平後上欲封曇首等會讌集舉酒勸"
        },
        {
          "raw_line": 32,
          "raw_start": 0,
          "raw_end": 21,
          "start": 168,
          "end": 189,
          "surface": "之因拊御牀曰此坐非卿兄弟無復今日時封詔已成"
        },
        {
          "raw_line": 33,
          "raw_start": 0,
          "raw_end": 21,
          "start": 189,
          "end": 210,
          "surface": "出以示曇首曇首曰近日之事豈難將成賴陛下英明"
        }
      ],
      "text_sha256": "72300aaa0af72c170547b996905d88a7c3b7cfc5cd6891867b6482d494c7358d"
    },
    {
      "key": "unit005",
      "layer": "received_chapter",
      "raw_window": [
        34,
        43
      ],
      "raw_runs": [
        {
          "raw_line": 34,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "速斷故罪人斯戮臣等雖得仰憑天光効其毫露豈可"
        },
        {
          "raw_line": 35,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "因國之災以為身幸陛下雖欲私臣當如直史何上不"
        },
        {
          "raw_line": 36,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "能奪故封事遂寢時兄弘錄尚書事又為揚州刺史曇"
        },
        {
          "raw_line": 37,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "首為上所親委任兼兩宮彭城王義康與弘並錄意常"
        },
        {
          "raw_line": 38,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "怏怏又欲得揚州形於辭旨以曇首居中分其權任愈"
        },
        {
          "raw_line": 39,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "不悅曇首固乞吳郡太祖曰豈有欲建大廈而遺其棟"
        },
        {
          "raw_line": 40,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "梁者哉賢兄比屢稱疾固辭州任將來若相申許者此"
        },
        {
          "raw_line": 41,
          "raw_start": 0,
          "raw_end": 21,
          "start": 147,
          "end": 168,
          "surface": "處非卿而誰亦何吳郡之有時弘久疾屢遜位不許義"
        },
        {
          "raw_line": 42,
          "raw_start": 0,
          "raw_end": 21,
          "start": 168,
          "end": 189,
          "surface": "康謂賓客曰王公久疾不起神州詎合臥治曇首勸弘"
        },
        {
          "raw_line": 43,
          "raw_start": 0,
          "raw_end": 21,
          "start": 189,
          "end": 210,
          "surface": "減府兵之半以配義康義康乃悅七年卒太祖為之慟"
        }
      ],
      "text_sha256": "36920b1ead4b08d0e57739a23cfdde879b3bae3dee4acc106ad1c61761b6f045"
    },
    {
      "key": "unit006",
      "layer": "received_chapter",
      "raw_window": [
        44,
        48
      ],
      "raw_runs": [
        {
          "raw_line": 44,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "中書舍人周起侍側曰主家欲表賢者先須上曰直是"
        },
        {
          "raw_line": 45,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "我家衰耳追贈左光祿大夫加散騎常侍詹事如故九"
        },
        {
          "raw_line": 46,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "年以預誅羨之等謀追封豫寧縣侯邑千戶諡曰文侯"
        },
        {
          "raw_line": 47,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "世祖即位配饗太祖廟庭子僧綽嗣別有傳少子僧虔"
        },
        {
          "raw_line": 48,
          "raw_start": 0,
          "raw_end": 7,
          "start": 84,
          "end": 91,
          "surface": "昇明末為尚書令"
        }
      ],
      "text_sha256": "bd1d03e8ebe18211933fbe1e0d7fbedd351e3c78182f585fcc48efb5a4df4191"
    },
    {
      "key": "unit007",
      "layer": "witness_appended_wuyingdian_collation",
      "raw_window": [
        49,
        51
      ],
      "raw_runs": [
        {
          "raw_line": 49,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "王曇首傳中書舍人周起侍側○周起南史作周赳臣"
        },
        {
          "raw_line": 50,
          "raw_start": 0,
          "raw_end": 20,
          "start": 21,
          "end": 41,
          "surface": "承蒼按張敷殷景仁傳俱有中書舍人周赳作赳為"
        },
        {
          "raw_line": 51,
          "raw_start": 0,
          "raw_end": 1,
          "start": 41,
          "end": 42,
          "surface": "是"
        }
      ],
      "text_sha256": "ad6aa23d62d636c641404d34be05a2c3df9e44f88adc0118acf52e7ae8839d22"
    }
  ]
}
