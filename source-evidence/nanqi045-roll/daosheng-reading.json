    {
      "title": "蕭遙光",
      "raw_spans": [
        {
          "first_line": 27,
          "last_line": 27,
          "start_codepoint": 0,
          "end_codepoint": 213,
          "opening": "　　'''遙光'''",
          "closing": "賞諸事唯遙光共謀議。"
        },
        {
          "first_line": 29,
          "last_line": 29,
          "start_codepoint": 0,
          "end_codepoint": 213,
          "opening": "　　建武元年，以爲持",
          "closing": "一夕見殺，遙光意也。"
        },
        {
          "first_line": 31,
          "last_line": 31,
          "start_codepoint": 0,
          "end_codepoint": 181,
          "opening": "　　帝崩，遺詔加遙光",
          "closing": "城，風飄儀繖出城外。"
        },
        {
          "first_line": 33,
          "last_line": 33,
          "start_codepoint": 0,
          "end_codepoint": 254,
          "opening": "　　遙光弟遙昌先卒壽",
          "closing": "不肯，望臺內自有變。"
        },
        {
          "first_line": 35,
          "last_line": 35,
          "start_codepoint": 0,
          "end_codepoint": 250,
          "opening": "　　至日中，臺軍稍至",
          "closing": "左興盛屯東府東籬門。"
        },
        {
          "first_line": 37,
          "last_line": 37,
          "start_codepoint": 0,
          "end_codepoint": 135,
          "opening": "　　衆軍圍東城三面，",
          "closing": "自竦踊，使殺歷生兒。"
        },
        {
          "first_line": 39,
          "last_line": 39,
          "start_codepoint": 0,
          "end_codepoint": 149,
