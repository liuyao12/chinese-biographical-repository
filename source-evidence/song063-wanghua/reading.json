      "events": [
        {
          "paragraph_id": "c-songshu-063-wanghua-tanshou:line012",
          "start": 10,
          "end": 30,
          "surface": "以父存亡不測，布衣蔬食不交游，如此十餘年"
        },
        {
          "paragraph_id": "c-songshu-063-wanghua-tanshou:line012",
          "start": 38,
          "end": 56,
          "surface": "高祖欲收其才用，乃發廞喪問，使華制服"
        }
      ]
    },
