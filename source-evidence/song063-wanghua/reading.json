      "events": [
        {
          "paragraph_id": "c-songshu-063-wanghua-tanshou:line014",
          "start": 0,
          "end": 28,
          "surface": "服闋，高祖北伐長安，領鎮西將軍、北徐州刺史，辟華為州主簿"
        },
        {
          "paragraph_id": "c-songshu-063-wanghua-tanshou:line014",
          "start": 188,
          "end": 218,
          "surface": "邵白服登城，為華所糾，坐被徵，華代為司馬、南郡太守，行府州事"
        }
      ]
    },
