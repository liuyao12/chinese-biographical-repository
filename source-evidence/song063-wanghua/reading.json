      ],
      "events": [
        {
          "paragraph_id": "c-songshu-063-wanghua-tanshou:line018",
          "start": 38,
          "end": 53,
          "surface": "甯子先為高祖太尉主簿，陳損益曰"
        },
        {
          "paragraph_id": "c-songshu-063-wanghua-tanshou:line018",
          "start": 214,
          "end": 226,
          "surface": "各舉一人堪為二千石長吏者"
        },
        {
          "paragraph_id": "c-songshu-063-wanghua-tanshou:line018",
          "start": 346,
          "end": 365,
          "surface": "治阿之宰，不必計年，免徒之守，豈限資秩"
        }
      ]
    },
    {
      "paragraph_id": "c-songshu-063-wanghua-tanshou:line020",
