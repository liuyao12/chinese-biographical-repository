      "events": [
        {
          "paragraph_id": "c-songshu-063-wanghua-tanshou:line022",
          "start": 119,
          "end": 129,
          "surface": "四年，卒，時年四十三"
        },
        {
          "paragraph_id": "c-songshu-063-wanghua-tanshou:line022",
          "start": 141,
          "end": 168,
          "surface": "九年，上思誅羨之之功，追封新建縣侯，食邑千戶，諡曰宣侯"
        },
        {
          "paragraph_id": "c-songshu-063-wanghua-tanshou:line022",
          "start": 169,
          "end": 180,
          "surface": "世祖即位，配饗太祖廟庭"
        }
      ]
    },
    {
      "paragraph_id": "c-songshu-063-wanghua-tanshou:line024",
