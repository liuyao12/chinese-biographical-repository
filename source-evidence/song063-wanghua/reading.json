        {
          "paragraph_id": "c-songshu-063-wanghua-tanshou:line016",
          "start": 72,
          "end": 82,
          "surface": "且三人勢均，莫相推伏"
        },
        {
          "paragraph_id": "c-songshu-063-wanghua-tanshou:line016",
          "start": 124,
          "end": 149,
          "surface": "以華為侍中，領驍騎將軍，未拜，轉右衞將軍，侍中如故"
        }
      ]
    },
    {
