{
  "pdf_url": "https://commons.wikimedia.org/wiki/File:NLC892-411999017142-12245_二十四史_第147冊.pdf",
  "catalog_permalink": "https://commons.wikimedia.org/wiki/File:NLC892-411999017142-12245_二十四史_第147冊.pdf",
  "pdf_sha256": "304424059f9ea958919137b190de875c0ce27497e516cce8f4c0fe164d366a76",
  "column_file": "source-evidence/song063-wanghua/wyd-columns.txt",
  "column_file_sha256": "af25bb8b41b9b5bd5d64b33097ec10c46becee267940bbdb2789a8e5effc297a",
  "columns": [
    {
      "pdf_page": 15,
      "half": "左",
      "leaf": "一上",
      "column_from_right": 5,
      "reading": "王華字子陵琅邪臨沂人太保弘從祖弟也祖薈衞將",
      "start_codepoint": 0,
      "end_codepoint": 21
    },
    {
      "pdf_page": 15,
      "half": "左",
      "leaf": "一上",
      "column_from_right": 6,
      "reading": "軍會稽內史父廞太子中庶子司徒左長史居在吳晉",
      "start_codepoint": 21,
      "end_codepoint": 42
    },
    {
      "pdf_page": 15,
      "half": "左",
      "leaf": "一上",
      "column_from_right": 7,
      "reading": "隆安初王恭起兵討王國寶時廞丁母憂在家恭檄令",
      "start_codepoint": 42,
      "end_codepoint": 63
    },
    {
      "pdf_page": 15,
      "half": "左",
      "leaf": "一上",
      "column_from_right": 8,
      "reading": "起兵廞卽聚衆應之以女為貞列將軍以女人為官屬",
      "start_codepoint": 63,
      "end_codepoint": 84
    },
    {
      "pdf_page": 15,
      "half": "左",
      "leaf": "一上",
      "column_from_right": 9,
      "reading": "國寶旣死恭檄廞起兵之際多所誅戮至是不復得已",
      "start_codepoint": 84,
      "end_codepoint": 105
    },
    {
      "pdf_page": 15,
      "half": "左",
      "leaf": "一上",
      "column_from_right": 10,
      "reading": "因舉兵以討恭為名恭遣劉牢之擊廞廞敗走不知所",
      "start_codepoint": 105,
      "end_codepoint": 126
    },
    {
      "pdf_page": 16,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 1,
      "reading": "在長子泰為恭所殺華時年十二在軍中與廞相失隨",
      "start_codepoint": 126,
      "end_codepoint": 147
    },
    {
      "pdf_page": 16,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 2,
      "reading": "沙門釋曇永逃竄時牢之搜檢覓華甚急曇永使華提",
      "start_codepoint": 147,
      "end_codepoint": 168
    },
    {
      "pdf_page": 16,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 3,
      "reading": "衣幞隨後津邏咸疑焉華行遲永呵罵云奴子怠懈行",
      "start_codepoint": 168,
      "end_codepoint": 189
    },
    {
      "pdf_page": 16,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 4,
      "reading": "不及我以杖捶華數十衆乃不疑由此得免遇赦還吳",
      "start_codepoint": 189,
      "end_codepoint": 210
    },
    {
      "pdf_page": 16,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 5,
      "reading": "少有志行以父存亡不測布衣蔬食不交游如此十餘",
      "start_codepoint": 210,
      "end_codepoint": 231
    },
    {
      "pdf_page": 16,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 6,
      "reading": "年為時人所稱美高祖欲收其才用乃發廞喪問使華",
      "start_codepoint": 231,
      "end_codepoint": 252
    },
    {
      "pdf_page": 16,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 7,
      "reading": "制服服闋高祖北伐長安領鎮西將軍北徐州刺史辟",
      "start_codepoint": 252,
      "end_codepoint": 273
    },
    {
      "pdf_page": 16,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 8,
      "reading": "華為州主簿仍轉鎮西主簿治中從事史歷職著稱太",
      "start_codepoint": 273,
      "end_codepoint": 294
    },
    {
      "pdf_page": 16,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 9,
      "reading": "祖征江陵以為西中郎主簿遷咨議參軍領錄事太祖",
      "start_codepoint": 294,
      "end_codepoint": 315
    },
    {
      "pdf_page": 16,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 10,
      "reading": "進號鎮西復隨府轉太祖未親政政事悉委司馬張邵",
      "start_codepoint": 315,
      "end_codepoint": 336
    },
    {
      "pdf_page": 16,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 1,
      "reading": "華性尚物不欲人在己前邵性豪每行來常引夾轂華",
      "start_codepoint": 336,
      "end_codepoint": 357
    },
    {
      "pdf_page": 16,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 2,
      "reading": "出入乘牽車從者不過二三以矯之嘗於城內相逢華",
      "start_codepoint": 357,
      "end_codepoint": 378
    },
    {
      "pdf_page": 16,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 3,
      "reading": "陽不知是邵謂左右此鹵簿甚盛必是殿下出行乃下",
      "start_codepoint": 378,
      "end_codepoint": 399
    },
    {
      "pdf_page": 16,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 4,
      "reading": "牽車立於道側及邵至乃驚邵白服登城為華所糾坐",
      "start_codepoint": 399,
      "end_codepoint": 420
    },
    {
      "pdf_page": 16,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 5,
      "reading": "被徵華代為司馬南郡太守行府州事太祖入奉大統",
      "start_codepoint": 420,
      "end_codepoint": 441
    },
    {
      "pdf_page": 16,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 6,
      "reading": "以少帝見害疑不敢下華建議曰羨之等受寄崇重未",
      "start_codepoint": 441,
      "end_codepoint": 462
    },
    {
      "pdf_page": 16,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 7,
      "reading": "容便敢背德廢主若存慮其將來受禍致此殺害蓋由",
      "start_codepoint": 462,
      "end_codepoint": 483
    },
    {
      "pdf_page": 16,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 8,
      "reading": "每生情多寧敢一朝頓懷逆志且三人勢均莫相推伏",
      "start_codepoint": 483,
      "end_codepoint": 504
    },
    {
      "pdf_page": 16,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 9,
      "reading": "不過欲握權自固以少主仰待耳今日就徵萬無所慮",
      "start_codepoint": 504,
      "end_codepoint": 525
    },
    {
      "pdf_page": 16,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 10,
      "reading": "太祖從之留華總後任上卽位以華為侍中領驍騎將",
      "start_codepoint": 525,
      "end_codepoint": 546
    },
    {
      "pdf_page": 17,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 1,
      "reading": "軍未拜轉右衞將軍侍中如故先是會稽孔甯子為太",
      "start_codepoint": 546,
      "end_codepoint": 567
    },
    {
      "pdf_page": 17,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 2,
      "reading": "祖鎮西咨議參軍以文義見賞至是為黃門侍郎領步",
      "start_codepoint": 567,
      "end_codepoint": 588
    },
    {
      "pdf_page": 17,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 3,
      "reading": "兵校尉甯子先為高祖太尉主簿陳損益曰隆化之道",
      "start_codepoint": 588,
      "end_codepoint": 609
    },
    {
      "pdf_page": 17,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 4,
      "reading": "莫先於官得其才枚卜之方莫若人愼其舉雖復因革",
      "start_codepoint": 609,
      "end_codepoint": 630
    },
    {
      "pdf_page": 17,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 5,
      "reading": "不同損益有物求賢審官未之或改師錫僉曰煥乎欽",
      "start_codepoint": 630,
      "end_codepoint": 651
    },
    {
      "pdf_page": 17,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 6,
      "reading": "明之誥拔茅征吉著於幽賁之爻晉師有成瓜衍作賞",
      "start_codepoint": 651,
      "end_codepoint": 672
    },
    {
      "pdf_page": 17,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 7,
      "reading": "楚乘無入蒍賈不賀今舊命惟新幽人引領韶之盡美",
      "start_codepoint": 672,
      "end_codepoint": 693
    },
    {
      "pdf_page": 17,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 8,
      "reading": "已備於振綱武之未盡或存於理目雖九官之職未可",
      "start_codepoint": 693,
      "end_codepoint": 714
    },
    {
      "pdf_page": 17,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 9,
      "reading": "備舉親民之選尤宜在先愚欲使天朝四品官外及守",
      "start_codepoint": 714,
      "end_codepoint": 735
    },
    {
      "pdf_page": 17,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 10,
      "reading": "牧各舉一人堪為二千石長吏者以付選官隨缺叙用",
      "start_codepoint": 735,
      "end_codepoint": 756
    },
    {
      "pdf_page": 17,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 1,
      "reading": "得賢受賞失舉任罰夫惟帝之難豈庸識所易然舉爾",
      "start_codepoint": 756,
      "end_codepoint": 777
    },
    {
      "pdf_page": 17,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 2,
      "reading": "所知非求多人因百官之明孰與一識之見執咎在己",
      "start_codepoint": 777,
      "end_codepoint": 798
    },
    {
      "pdf_page": 17,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 3,
      "reading": "豈容徇物之私今非以選曹所銓果於乖謬衆職所舉",
      "start_codepoint": 798,
      "end_codepoint": 819
    },
    {
      "pdf_page": 17,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 4,
      "reading": "必也惟良蓋宜使求賢闢其廣塗考績取其少殿若才",
      "start_codepoint": 819,
      "end_codepoint": 840
    },
    {
      "pdf_page": 17,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 5,
      "reading": "實拔羣進宜尚德治阿之宰不必計年免徒之守豈限",
      "start_codepoint": 840,
      "end_codepoint": 861
    },
    {
      "pdf_page": 17,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 6,
      "reading": "資秩自此以還故當才均以資資均以地宰莅之官誠",
      "start_codepoint": 861,
      "end_codepoint": 882
    },
    {
      "pdf_page": 17,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 7,
      "reading": "曰吏職然監觀民瘼翼化宣風則隱厚之求急於刀筆",
      "start_codepoint": 882,
      "end_codepoint": 903
    },
    {
      "pdf_page": 17,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 8,
      "reading": "能事之功接於德心以此論才行之年歲豈惟政無秕",
      "start_codepoint": 903,
      "end_codepoint": 924
    },
    {
      "pdf_page": 17,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 9,
      "reading": "蠹民庇手足而已將使公路日清私請漸塞士多心競",
      "start_codepoint": 924,
      "end_codepoint": 945
    },
    {
      "pdf_page": 17,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 10,
      "reading": "仁必由己處士砥自求之節仕子藏交馳之情甯子庸",
      "start_codepoint": 945,
      "end_codepoint": 966
    },
    {
      "pdf_page": 18,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 1,
      "reading": "微不識治體冒昧陳愚退懼違謬甯子與華並有富貴",
      "start_codepoint": 966,
      "end_codepoint": 987
    },
    {
      "pdf_page": 18,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 2,
      "reading": "之願自羨之等秉權日夜構之於太祖甯子嘗東歸至",
      "start_codepoint": 987,
      "end_codepoint": 1008
    },
    {
      "pdf_page": 18,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 3,
      "reading": "金昌亭左右欲泊船甯子命去之曰此弑君亭不可泊",
      "start_codepoint": 1008,
      "end_codepoint": 1029
    },
    {
      "pdf_page": 18,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 4,
      "reading": "也華每閑居諷詠常誦王粲登樓賦曰冀王道之一平",
      "start_codepoint": 1029,
      "end_codepoint": 1050
    },
    {
      "pdf_page": 18,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 5,
      "reading": "假高衢而騁力出入逢羨之等每切齒憤咤歎曰當見",
      "start_codepoint": 1050,
      "end_codepoint": 1071
    },
    {
      "pdf_page": 18,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 6,
      "reading": "太平時不元嘉二年甯子病卒三年誅羨之等華遷護",
      "start_codepoint": 1071,
      "end_codepoint": 1092
    },
    {
      "pdf_page": 18,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 7,
      "reading": "軍侍中如故宋世惟華與南陽劉湛不為飾讓得官卽",
      "start_codepoint": 1092,
      "end_codepoint": 1113
    },
    {
      "pdf_page": 18,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 8,
      "reading": "拜以此為常華以情事異人未嘗預宴集終身不飲酒",
      "start_codepoint": 1113,
      "end_codepoint": 1134
    },
    {
      "pdf_page": 18,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 9,
      "reading": "有燕不之詣若宜有論事者乘車造門主人出車就之",
      "start_codepoint": 1134,
      "end_codepoint": 1155
    },
    {
      "pdf_page": 18,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 10,
      "reading": "及王弘輔政而弟曇首為太祖所任與華相埒華嘗謂",
      "start_codepoint": 1155,
      "end_codepoint": 1176
    },
    {
      "pdf_page": 18,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 1,
      "reading": "己力用不盡每歎息曰宰相頓有數人天下何由得治",
      "start_codepoint": 1176,
      "end_codepoint": 1197
    },
    {
      "pdf_page": 18,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 2,
      "reading": "四年卒時年四十三追贈散騎常侍衞將軍九年上思",
      "start_codepoint": 1197,
      "end_codepoint": 1218
    },
    {
      "pdf_page": 18,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 3,
      "reading": "誅羨之之功追封新建縣侯食邑千戶諡曰宣侯世祖",
      "start_codepoint": 1218,
      "end_codepoint": 1239
    },
    {
      "pdf_page": 18,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 4,
      "reading": "卽位配饗太祖廟庭子宣侯嗣官至左衞將軍卒子長",
      "start_codepoint": 1239,
      "end_codepoint": 1260
    },
    {
      "pdf_page": 18,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 5,
      "reading": "嗣太宗泰始二年坐罵母奪爵以長弟終紹封後廢帝",
      "start_codepoint": 1260,
      "end_codepoint": 1281
    },
    {
      "pdf_page": 18,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 6,
      "reading": "元徽三年終上表乞以封還長許之齊受禪國除華從",
      "start_codepoint": 1281,
      "end_codepoint": 1302
    },
    {
      "pdf_page": 18,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 7,
      "reading": "父弟鴻五兵尚書會稽太守",
      "start_codepoint": 1302,
      "end_codepoint": 1313
    }
  ],
