  "columns": [
    {
      "pdf_page": 5,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 5,
      "reading": "鬱林王何妃名婧英廬江灊人撫軍將軍戢之女也永",
      "start_codepoint": 0,
      "end_codepoint": 21
    },
    {
      "pdf_page": 5,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 6,
      "reading": "明二年納為南郡王妃十一年為皇太孫妃鬱林王即",
      "start_codepoint": 21,
      "end_codepoint": 42
    },
    {
      "pdf_page": 5,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 7,
      "reading": "位為皇后嫡母劉氏為高昌縣都鄉君所生母宋氏為",
      "start_codepoint": 42,
      "end_codepoint": 63
    },
    {
      "pdf_page": 5,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 8,
      "reading": "餘杭廣昌鄉君將拜鏡在床無故墮地其冬與太后同",
      "start_codepoint": 63,
      "end_codepoint": 84
    },
    {
      "pdf_page": 5,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 9,
      "reading": "日謁太廟后稟性淫亂為妃時便與外人姦通在後宮",
      "start_codepoint": 84,
      "end_codepoint": 105
    },
    {
      "pdf_page": 5,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 10,
      "reading": "復通帝左右楊珉之與同寢處如伉儷珉之又與帝相",
      "start_codepoint": 105,
      "end_codepoint": 126
    },
    {
      "pdf_page": 6,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 1,
      "reading": "愛褻故帝恣之迎后親戚入宮賞賜人百數十萬以世",
      "start_codepoint": 126,
      "end_codepoint": 147
    },
    {
      "pdf_page": 6,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 2,
      "reading": "祖耀靈殿處后家屬帝被廢后貶為王妃",
      "start_codepoint": 147,
      "end_codepoint": 163
    }
  ],
