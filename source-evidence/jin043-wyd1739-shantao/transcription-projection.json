{
  "raw_sha256": "ef5c37602549867433d9829f259bdfa01a66bdd0ab8c1344b6f5c98d5be4c437",
  "units": [
    {
      "key": "unit001",
      "layer": "received_chapter",
      "raw_window": [
        1,
        6
      ],
      "raw_runs": [
        {
          "raw_line": 1,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "山濤字巨源河內懷人也父曜宛句令濤早孤居貧少"
        },
        {
          "raw_line": 2,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "有器量介然不羣性好莊老每隱身自晦與嵇康呂安"
        },
        {
          "raw_line": 3,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "善後遇阮籍便為竹林之遊著忘言之契康後坐事臨"
        },
        {
          "raw_line": 4,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "誅謂子紹曰巨源在汝不孤矣濤年四十始為郡主簿"
        },
        {
          "raw_line": 5,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "功曹上計掾舉孝廉州辟部河南從事與石鑒共宿濤"
        },
        {
          "raw_line": 6,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "夜起蹴鑒曰今為何等時而眠邪知太傅卧何意鑒曰"
        }
      ],
      "text_sha256": "803f508537bfbf8137e7c6c3dbd0494e03857236732897a726a2456594b566a1"
    },
    {
      "key": "unit002",
      "layer": "received_chapter",
      "raw_window": [
        7,
        16
      ],
      "raw_runs": [
        {
          "raw_line": 7,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "宰相三不朝與尺一令歸第卿何慮也濤曰咄石生無"
        },
        {
          "raw_line": 8,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "事馬蹄間邪投傳而去未二年果有曹爽之事遂隱身"
        },
        {
          "raw_line": 9,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "不交世務與宣穆后有中表親是以見景帝帝曰呂望"
        },
        {
          "raw_line": 10,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "欲仕邪命司隸舉秀才除郎中轉驃騎將軍王昶從事"
        },
        {
          "raw_line": 11,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "中郎久之拜趙國相遷尚書吏部郎文帝與濤書曰足"
        },
        {
          "raw_line": 12,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "下在事清明雅操邁時念多所乏今致錢二十萬穀二"
        },
        {
          "raw_line": 13,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "百斛魏帝嘗賜景帝春服帝以賜濤又以母老拜贈藜"
        },
        {
          "raw_line": 14,
          "raw_start": 0,
          "raw_end": 21,
          "start": 147,
          "end": 168,
          "surface": "杖一枚晚與尚書和逌交又與鍾會裴秀並申款昵以"
        },
        {
          "raw_line": 15,
          "raw_start": 0,
          "raw_end": 21,
          "start": 168,
          "end": 189,
          "surface": "二人居勢爭權濤平心處中各得其所而俱無恨焉遷"
        },
        {
          "raw_line": 16,
          "raw_start": 0,
          "raw_end": 21,
          "start": 189,
          "end": 210,
          "surface": "大將軍從事中郎鍾會作亂於蜀而文帝將西征時魏"
        }
      ],
      "text_sha256": "fcb4c1e5bda5aed7133b4267b406a1a90e04fd31b60c6a35b5d8896ff87bd259"
    },
    {
      "key": "unit003",
      "layer": "received_chapter",
      "raw_window": [
        17,
        26
      ],
      "raw_runs": [
        {
          "raw_line": 17,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "氏諸王公並在鄴帝謂濤曰西偏吾自了之後事深以"
        },
        {
          "raw_line": 18,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "委卿以本官行軍司馬給親兵五百人鎮鄴咸熙初封"
        },
        {
          "raw_line": 19,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "新沓子轉相國左長史典統別營時帝以濤鄉閭宿望"
        },
        {
          "raw_line": 20,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "命太子拜之帝以齊王攸繼景帝後素又重攸嘗問裴"
        },
        {
          "raw_line": 21,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "秀曰大將軍開建未遂吾但承奉後事耳故立攸將歸"
        },
        {
          "raw_line": 22,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "功於兄何如秀以為不可又以問濤濤對曰廢長立少"
        },
        {
          "raw_line": 23,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "違禮不祥國之安危恒必由之太子位於是乃定太子"
        },
        {
          "raw_line": 24,
          "raw_start": 0,
          "raw_end": 21,
          "start": 147,
          "end": 168,
          "surface": "親拜謝濤及武帝受禪以濤守大鴻臚護送陳留王詣"
        },
        {
          "raw_line": 25,
          "raw_start": 0,
          "raw_end": 21,
          "start": 168,
          "end": 189,
          "surface": "鄴泰始初加奉車都尉進爵新沓伯及羊祜執政時人"
        },
        {
          "raw_line": 26,
          "raw_start": 0,
          "raw_end": 21,
          "start": 189,
          "end": 210,
          "surface": "欲危裴秀濤正色保持之由是失權臣意出為冀州刺"
        }
      ],
      "text_sha256": "0c2e68a6bc231f4b0a03e6ec882411a1a87ea6d6e9daf0e08266f7c1c65f2378"
    },
    {
      "key": "unit004",
      "layer": "received_chapter",
      "raw_window": [
        27,
        36
      ],
      "raw_runs": [
        {
          "raw_line": 27,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "史加寧遠將軍冀州俗薄無相推轂濤甄拔隱屈搜訪"
        },
        {
          "raw_line": 28,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "賢才旌命三十餘人皆顯名當時人懷慕尚風俗頗革"
        },
        {
          "raw_line": 29,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "轉北中郎將督鄴城守事入為侍中遷尚書以母老辭"
        },
        {
          "raw_line": 30,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "職詔曰君雖乃心在於色養然職有上下旦夕不廢醫"
        },
        {
          "raw_line": 31,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "藥且當割情以隆在公濤心求退表疏數十上久乃見"
        },
        {
          "raw_line": 32,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "聽除議郎帝以濤清儉無以供養特給日契加賜牀帳"
        },
        {
          "raw_line": 33,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "茵褥禮秩崇重時莫為比後除太常卿以疾不就會遭"
        },
        {
          "raw_line": 34,
          "raw_start": 0,
          "raw_end": 21,
          "start": 147,
          "end": 168,
          "surface": "母喪歸鄉里濤年踰耳順居喪過禮負土成墳手植松"
        },
        {
          "raw_line": 35,
          "raw_start": 0,
          "raw_end": 21,
          "start": 168,
          "end": 189,
          "surface": "栢詔曰吾所共致化者官人之職是也方今風俗陵遲"
        },
        {
          "raw_line": 36,
          "raw_start": 0,
          "raw_end": 21,
          "start": 189,
          "end": 210,
          "surface": "人心進動宜崇明好惡鎮以退讓山太常雖尚居諒闇"
        }
      ],
      "text_sha256": "eea6d7a7b8fb5fe8ef14bc5fa217b68e7d1c138b8817ab1477126ec9e1b99104"
    },
    {
      "key": "unit005",
      "layer": "received_chapter",
      "raw_window": [
        37,
        46
      ],
      "raw_runs": [
        {
          "raw_line": 37,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "情在難奪方今務殷何得遂其志邪其以濤為吏部尚"
        },
        {
          "raw_line": 38,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "書濤辭以喪病章表懇切會元皇后崩遂扶輿還洛逼"
        },
        {
          "raw_line": 39,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "迫詔命自力就職前後選舉周遍內外而並得其才咸"
        },
        {
          "raw_line": 40,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "寧初轉太子少傅加散騎常侍除尚書僕射加侍中領"
        },
        {
          "raw_line": 41,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "吏部固辭以老疾上表陳情章表數十上久不攝職為"
        },
        {
          "raw_line": 42,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "左丞白褒所奏帝曰濤以病自聞但不聽之耳使濤坐"
        },
        {
          "raw_line": 43,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "執銓衡則可何必上下邪不得有所問濤不自安表謝"
        },
        {
          "raw_line": 44,
          "raw_start": 0,
          "raw_end": 21,
          "start": 147,
          "end": 168,
          "surface": "曰古之王道正直而已陛下不可以一老臣為加曲私"
        },
        {
          "raw_line": 45,
          "raw_start": 0,
          "raw_end": 21,
          "start": 168,
          "end": 189,
          "surface": "臣亦何心屢塵日月乞如所表以章典刑帝再手詔曰"
        },
        {
          "raw_line": 46,
          "raw_start": 0,
          "raw_end": 21,
          "start": 189,
          "end": 210,
          "surface": "白褒奏君甚妄所以不即推直不喜凶赫耳君之明度"
        }
      ],
      "text_sha256": "ba5c123c41e701c38f775128880bce6d2bc7ff5ef7a00d773e15749a23068954"
    },
    {
      "key": "unit006",
      "layer": "received_chapter",
      "raw_window": [
        47,
        56
      ],
      "raw_runs": [
        {
          "raw_line": 47,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "豈當介意邪便當攝職令斷章表也濤志必欲退因發"
        },
        {
          "raw_line": 48,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "從弟婦喪輒還外舍詔曰山僕射近日暫出遂以微苦"
        },
        {
          "raw_line": 49,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "未還豈吾側席之意其遣丞掾奉詔喻旨若體力故未"
        },
        {
          "raw_line": 50,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "平康者便以輿車輿還寺舍濤辭不獲已乃起視事濤"
        },
        {
          "raw_line": 51,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "再居選職十有餘年每一官缺輒啓擬數人詔旨有所"
        },
        {
          "raw_line": 52,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "向然後顯奏隨帝意所欲為先故帝之所用或非舉首"
        },
        {
          "raw_line": 53,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "衆情不察以濤輕重任意或譖之於帝故帝手詔戒濤"
        },
        {
          "raw_line": 54,
          "raw_start": 0,
          "raw_end": 21,
          "start": 147,
          "end": 168,
          "surface": "曰夫用人惟才不遺疎遠卑賤天下便化矣而濤行之"
        },
        {
          "raw_line": 55,
          "raw_start": 0,
          "raw_end": 21,
          "start": 168,
          "end": 189,
          "surface": "自若一年之後衆情乃寢濤所奏甄拔人物各為題目"
        },
        {
          "raw_line": 56,
          "raw_start": 0,
          "raw_end": 21,
          "start": 189,
          "end": 210,
          "surface": "時稱山公啓事濤中立於朝晚值后黨專權不欲任楊"
        }
      ],
      "text_sha256": "c302a71c9e6d6d1cad5ef751b0fa1e82fefd5c3fe25b57339553107a3251a5dc"
    },
    {
      "key": "unit007",
      "layer": "received_chapter",
      "raw_window": [
        57,
        66
      ],
      "raw_runs": [
        {
          "raw_line": 57,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "氏多有諷諫帝雖悟而不能改後以年衰疾篤上疏告"
        },
        {
          "raw_line": 58,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "退曰臣年垂八十救命旦夕若有毫末之益豈遺力於"
        },
        {
          "raw_line": 59,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "聖時迫於老耄不復任事今四海休息天下思化從而"
        },
        {
          "raw_line": 60,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "靜之百姓自正但當崇風尚教以敦之耳陛下亦復何"
        },
        {
          "raw_line": 61,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "事臣耳目聾瞑不能自勵君臣父子其間無文是以直"
        },
        {
          "raw_line": 62,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "陳愚情乞聽所請乃免冠徒跣上還印綬詔曰天下事"
        },
        {
          "raw_line": 63,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "廣加吳土初平凡百草創當共盡意化之君不深識往"
        },
        {
          "raw_line": 64,
          "raw_start": 0,
          "raw_end": 21,
          "start": 147,
          "end": 168,
          "surface": "心而以小疾求退豈所望於君邪朕猶側席未得垂拱"
        },
        {
          "raw_line": 65,
          "raw_start": 0,
          "raw_end": 21,
          "start": 168,
          "end": 189,
          "surface": "君亦何得高尚其事乎當崇至公勿復為虛飾之煩濤"
        },
        {
          "raw_line": 66,
          "raw_start": 0,
          "raw_end": 21,
          "start": 189,
          "end": 210,
          "surface": "苦表請退詔又不許尚書令衛瓘奏濤以微苦久不視"
        }
      ],
      "text_sha256": "f0f393fd8b7c1a07c3b6127483da7b4cbb05464df1cdac216dbced813ebe7e6f"
    },
    {
      "key": "unit008",
      "layer": "received_chapter",
      "raw_window": [
        67,
        76
      ],
      "raw_runs": [
        {
          "raw_line": 67,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "職手詔頻煩猶未順旨參議以為無專節之尚違在公"
        },
        {
          "raw_line": 68,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "之義若實沈篤亦不宜居位可免濤官中詔瓘曰濤以"
        },
        {
          "raw_line": 69,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "德素為朝之望而常深退讓至於懇切故比有詔欲必"
        },
        {
          "raw_line": 70,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "奪其志以匡輔不逮主者既不思明詔旨而反深加詆"
        },
        {
          "raw_line": 71,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "案虧崇賢之風以重吾不德何以示遠近邪濤不得已"
        },
        {
          "raw_line": 72,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "又起視事太康初遷右僕射加光祿大夫侍中掌選如"
        },
        {
          "raw_line": 73,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "故濤以老疾固辭手詔曰君以道德為世模表況自先"
        },
        {
          "raw_line": 74,
          "raw_start": 0,
          "raw_end": 21,
          "start": 147,
          "end": 168,
          "surface": "帝識君遠意吾將倚君以穆風俗何乃欲舍遠朝政獨"
        },
        {
          "raw_line": 75,
          "raw_start": 0,
          "raw_end": 21,
          "start": 168,
          "end": 189,
          "surface": "高其志邪吾之至懷故不足以喻乎何來言至懇切也"
        },
        {
          "raw_line": 76,
          "raw_start": 0,
          "raw_end": 21,
          "start": 189,
          "end": 210,
          "surface": "且當以時自力深副至望君不降志朕不安席濤又上"
        }
      ],
      "text_sha256": "932c47aa527678f39b8bf24c854626e5dc1b4a4355a901167e593895165305b2"
    },
    {
      "key": "unit009",
      "layer": "received_chapter",
      "raw_window": [
        77,
        86
      ],
      "raw_runs": [
        {
          "raw_line": 77,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "表固讓不許吳平之後帝詔天下罷軍役示海內大安"
        },
        {
          "raw_line": 78,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "州郡悉去兵大郡置武吏百人小郡五十人帝嘗講武"
        },
        {
          "raw_line": 79,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "于宣武場濤時有疾詔乘步輦從因與盧欽論用兵之"
        },
        {
          "raw_line": 80,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "本以為不宜去州郡武備其論甚精于時咸以濤不學"
        },
        {
          "raw_line": 81,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "孫吳而闇與之合帝稱之曰天下名言也而不能用及"
        },
        {
          "raw_line": 82,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "永寧之後屢有變難寇賊猋起郡國皆以無備不能制"
        },
        {
          "raw_line": 83,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "天下遂以大亂如濤言焉後拜司徒濤復固讓詔曰君"
        },
        {
          "raw_line": 84,
          "raw_start": 0,
          "raw_end": 21,
          "start": 147,
          "end": 168,
          "surface": "年耆德茂朝之碩老是以授君台輔之位而遠崇克讓"
        },
        {
          "raw_line": 85,
          "raw_start": 0,
          "raw_end": 21,
          "start": 168,
          "end": 189,
          "surface": "至于反覆良用於邑君當終始朝政翼輔朕躬濤又表"
        },
        {
          "raw_line": 86,
          "raw_start": 0,
          "raw_end": 21,
          "start": 189,
          "end": 210,
          "surface": "曰臣事天朝三十餘年卒無毫釐以崇大化陛下私臣"
        }
      ],
      "text_sha256": "47533f681c1b716b44ee94fd74f9f37d28093c520cf99cd24b7ee93143b2e8e7"
    },
    {
      "key": "unit010",
      "layer": "received_chapter",
      "raw_window": [
        87,
        96
      ],
      "raw_runs": [
        {
          "raw_line": 87,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "無已猥授三司臣聞德薄位高力少任重上有折足之"
        },
        {
          "raw_line": 88,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "凶下有廟門之咎願陛下垂累世之恩乞臣骸骨詔曰"
        },
        {
          "raw_line": 89,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "君翼贊朝政保乂皇家匡佐之勲朕所倚賴司徒之職"
        },
        {
          "raw_line": 90,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "實掌邦教故用敬授以答羣望豈宜沖讓以自抑損邪"
        },
        {
          "raw_line": 91,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "已敕斷章表使者乃卧加章綬濤曰垂沒之人豈可污"
        },
        {
          "raw_line": 92,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "官府乎輿疾歸家以太康四年薨時年七十九詔賜東"
        },
        {
          "raw_line": 93,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "園祕器朝服一具衣一襲錢五十萬布百匹以供喪事"
        },
        {
          "raw_line": 94,
          "raw_start": 0,
          "raw_end": 21,
          "start": 147,
          "end": 168,
          "surface": "策贈司徒蜜印紫綬侍中貂蟬新沓伯蜜印青朱綬祭"
        },
        {
          "raw_line": 95,
          "raw_start": 0,
          "raw_end": 21,
          "start": 168,
          "end": 189,
          "surface": "以太牢諡曰康將葬賜錢四十萬布百匹左長史范晷"
        },
        {
          "raw_line": 96,
          "raw_start": 0,
          "raw_end": 21,
          "start": 189,
          "end": 210,
          "surface": "等上言濤舊第屋十間子孫不相容帝為之立室初濤"
        }
      ],
      "text_sha256": "e9a6451873536139340768a76e870abd5b479700a9273e255db1320d2a97f190"
    },
    {
      "key": "unit011",
      "layer": "received_chapter",
      "raw_window": [
        97,
        106
      ],
      "raw_runs": [
        {
          "raw_line": 97,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "布衣家貧謂妻韓氏曰忍饑寒我後當作三公但不知"
        },
        {
          "raw_line": 98,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "卿堪作夫人不耳及居榮貴貞慎儉約雖爵同千乘而"
        },
        {
          "raw_line": 99,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "無嬪媵祿賜俸秩散之親故初陳郡袁毅嘗為鬲令貪"
        },
        {
          "raw_line": 100,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "濁而賂遺公卿以求虛譽亦遺濤絲百斤濤不欲異於"
        },
        {
          "raw_line": 101,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "時受而藏於閣上後毅事露檻車送廷尉凡所受賂皆"
        },
        {
          "raw_line": 102,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "見推檢濤乃取絲付吏積年塵埃印封如初濤飲酒至"
        },
        {
          "raw_line": 103,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "八斗方醉帝欲試之乃以酒八斗飲濤而密益其酒濤"
        },
        {
          "raw_line": 104,
          "raw_start": 0,
          "raw_end": 13,
          "start": 147,
          "end": 160,
          "surface": "極本量而止有五子該淳允謨簡"
        },
        {
          "raw_line": 105,
          "raw_start": 0,
          "raw_end": 21,
          "start": 160,
          "end": 181,
          "surface": "該字伯倫嗣父爵仕至并州刺史太子左率贈長水校"
        },
        {
          "raw_line": 106,
          "raw_start": 0,
          "raw_end": 21,
          "start": 181,
          "end": 202,
          "surface": "尉該子瑋字彥祖翊軍校尉次子世回吏部郎散騎常"
        }
      ],
      "text_sha256": "a2b61c14782210516c2f32445ab3aa9ffb0271c9393c26b76bec99ea326758d2"
    },
    {
      "key": "unit012",
      "layer": "received_chapter",
      "raw_window": [
        107,
        116
      ],
      "raw_runs": [
        {
          "raw_line": 107,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "侍淳字子玄不仕允字叔眞奉車都尉並少尫病形甚"
        },
        {
          "raw_line": 108,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "短小而聰敏過人武帝聞而欲見之濤不敢辭以問於"
        },
        {
          "raw_line": 109,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "允允自以尫陋不肯行濤以為勝已乃表曰臣二子尫"
        },
        {
          "raw_line": 110,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "病宜絕人事不敢受詔謨字季長明惠有才智官至司"
        },
        {
          "raw_line": 111,
          "raw_start": 0,
          "raw_end": 2,
          "start": 84,
          "end": 86,
          "surface": "空掾"
        },
        {
          "raw_line": 112,
          "raw_start": 0,
          "raw_end": 21,
          "start": 86,
          "end": 107,
          "surface": "簡字季倫性溫雅有父風年二十餘濤不之知也簡歎"
        },
        {
          "raw_line": 113,
          "raw_start": 0,
          "raw_end": 21,
          "start": 107,
          "end": 128,
          "surface": "曰吾年幾三十而不為家公所知後與譙國嵇紹沛郡"
        },
        {
          "raw_line": 114,
          "raw_start": 0,
          "raw_end": 21,
          "start": 128,
          "end": 149,
          "surface": "劉謨弘農楊準齊名初為太子舍人累遷太子庶子黃"
        },
        {
          "raw_line": 115,
          "raw_start": 0,
          "raw_end": 21,
          "start": 149,
          "end": 170,
          "surface": "門郎出為青州刺史徵拜侍中頃之轉尚書歷鎮軍將"
        },
        {
          "raw_line": 116,
          "raw_start": 0,
          "raw_end": 21,
          "start": 170,
          "end": 191,
          "surface": "軍荆州刺史領南蠻校尉不行復拜尚書光熙初轉吏"
        }
      ],
      "text_sha256": "686aa88bae971343a3fa295e4f227ff41d98ac4c6a561f242d150550086217da"
    },
    {
      "key": "unit013",
      "layer": "received_chapter",
      "raw_window": [
        117,
        126
      ],
      "raw_runs": [
        {
          "raw_line": 117,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "部尚書永嘉初出為雍州刺史鎮西將軍徵為尚書左"
        },
        {
          "raw_line": 118,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "僕射領吏部簡欲令朝臣各舉所知以廣得才之路上"
        },
        {
          "raw_line": 119,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "疏曰臣以為自古興替實在官人苟得其才則無物不"
        },
        {
          "raw_line": 120,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "理書言知人則哲惟帝難之唐虞之盛元愷登庸周室"
        },
        {
          "raw_line": 121,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "之隆濟濟多士秦漢以來風雅漸喪至於後漢女君臨"
        },
        {
          "raw_line": 122,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "朝尊官大位出於阿保斯亂之始也是以郭泰許劭之"
        },
        {
          "raw_line": 123,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "倫明清議於草野陳蕃李固之徒守忠節於朝廷然後"
        },
        {
          "raw_line": 124,
          "raw_start": 0,
          "raw_end": 21,
          "start": 147,
          "end": 168,
          "surface": "君臣名節古今遺典可得而言自初平之元訖於建安"
        },
        {
          "raw_line": 125,
          "raw_start": 0,
          "raw_end": 21,
          "start": 168,
          "end": 189,
          "surface": "之末三十年中萬姓流散死亡略盡斯亂之極也世祖"
        },
        {
          "raw_line": 126,
          "raw_start": 0,
          "raw_end": 21,
          "start": 189,
          "end": 210,
          "surface": "武皇帝應天順人受禪于魏泰始初躬親萬幾佐命之"
        }
      ],
      "text_sha256": "a980929802228660228dd29aeb6c3757920da56fd270920f0575114d6797bf01"
    },
    {
      "key": "unit014",
      "layer": "received_chapter",
      "raw_window": [
        127,
        136
      ],
      "raw_runs": [
        {
          "raw_line": 127,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "臣咸皆率職時黃門侍郎王恂庾純始於太極東堂聽"
        },
        {
          "raw_line": 128,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "政評尚書奏事多論刑獄不論選舉臣以為不先所難"
        },
        {
          "raw_line": 129,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "而辨其所易陛下初臨萬國人思盡誠每於聽政之日"
        },
        {
          "raw_line": 130,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "命公卿大臣先議選舉各言所見後進儁才鄉邑尤異"
        },
        {
          "raw_line": 131,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "才堪任用者皆以名奏主者隨缺先敘是爵人於朝與"
        },
        {
          "raw_line": 132,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "衆共之之義也朝廷從之永嘉三年出為征南將軍都"
        },
        {
          "raw_line": 133,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "督荆湘交廣四州諸軍事假節鎮襄陽于時四方寇亂"
        },
        {
          "raw_line": 134,
          "raw_start": 0,
          "raw_end": 21,
          "start": 147,
          "end": 168,
          "surface": "天下分崩王威不振朝野危懼簡優游卒歲唯酒是耽"
        },
        {
          "raw_line": 135,
          "raw_start": 0,
          "raw_end": 21,
          "start": 168,
          "end": 189,
          "surface": "諸習氏荆土豪族有佳園池簡每出遊嬉多之池上置"
        },
        {
          "raw_line": 136,
          "raw_start": 0,
          "raw_end": 21,
          "start": 189,
          "end": 210,
          "surface": "酒輒醉名之曰高陽池時有童兒歌曰山公出何許往"
        }
      ],
      "text_sha256": "8944c7dc5e6f02e112fbfc43fb270c57b0331e65a358a0485d9f2b009757a2e6"
    },
    {
      "key": "unit015",
      "layer": "received_chapter",
      "raw_window": [
        137,
        146
      ],
      "raw_runs": [
        {
          "raw_line": 137,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "至高陽池日夕倒載歸酩酊無所知時時能騎馬倒著"
        },
        {
          "raw_line": 138,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "白接䍦舉鞭向葛疆何如并州兒疆家在并州簡愛將"
        },
        {
          "raw_line": 139,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "也尋加督寧益軍事時劉聰入寇京師危逼簡遣督護"
        },
        {
          "raw_line": 140,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "王萬率師赴難次于涅陽為宛城賊王如所破遂嬰城"
        },
        {
          "raw_line": 141,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "自守及洛陽陷沒簡又為賊嚴嶷所逼乃遷于夏口招"
        },
        {
          "raw_line": 142,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "納流亡江漢歸附時華軼以江州作難或勸簡討之簡"
        },
        {
          "raw_line": 143,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "曰與彥夏舊友為之惆悵簡豈利人之機以為功伐乎"
        },
        {
          "raw_line": 144,
          "raw_start": 0,
          "raw_end": 21,
          "start": 147,
          "end": 168,
          "surface": "其篤厚如此時樂府伶人避難多奔沔漢讌會之日僚"
        },
        {
          "raw_line": 145,
          "raw_start": 0,
          "raw_end": 21,
          "start": 168,
          "end": 189,
          "surface": "佐或勸奏之簡曰社稷傾覆不能匡救有晉之罪人也"
        },
        {
          "raw_line": 146,
          "raw_start": 0,
          "raw_end": 21,
          "start": 189,
          "end": 210,
          "surface": "何作樂之有因流涕慷慨坐者咸愧焉年六十卒追贈"
        }
      ],
      "text_sha256": "d1c0f1ba741d9c680fb52267ba0dcfddb5e325809819b1a51f0c5a353224b414"
    },
    {
      "key": "unit016",
      "layer": "received_chapter",
      "raw_window": [
        147,
        156
      ],
      "raw_runs": [
        {
          "raw_line": 147,
          "raw_start": 0,
          "raw_end": 11,
          "start": 0,
          "end": 11,
          "surface": "征南大將軍儀同三司子遐"
        },
        {
          "raw_line": 148,
          "raw_start": 0,
          "raw_end": 21,
          "start": 11,
          "end": 32,
          "surface": "遐字彥林為餘姚令時江左初基法禁寬弛豪族多挾"
        },
        {
          "raw_line": 149,
          "raw_start": 0,
          "raw_end": 21,
          "start": 32,
          "end": 53,
          "surface": "藏戶口以為私附遐繩以峻法到縣八旬出口萬餘縣"
        },
        {
          "raw_line": 150,
          "raw_start": 0,
          "raw_end": 21,
          "start": 53,
          "end": 74,
          "surface": "人虞喜以藏戶當棄市遐欲繩喜諸豪彊莫不切齒於"
        },
        {
          "raw_line": 151,
          "raw_start": 0,
          "raw_end": 21,
          "start": 74,
          "end": 95,
          "surface": "遐言於執事以喜有高節不宜屈辱又以遐輒造縣舍"
        },
        {
          "raw_line": 152,
          "raw_start": 0,
          "raw_end": 21,
          "start": 95,
          "end": 116,
          "surface": "遂陷其罪遐與會稽內史何充牋乞留百日窮翦逋逃"
        },
        {
          "raw_line": 153,
          "raw_start": 0,
          "raw_end": 21,
          "start": 116,
          "end": 137,
          "surface": "退而就罪無恨也充申理不能得竟坐免官後為東陽"
        },
        {
          "raw_line": 154,
          "raw_start": 0,
          "raw_end": 21,
          "start": 137,
          "end": 158,
          "surface": "太守為政嚴猛康帝詔曰東陽頃來竟囚每多入重豈"
        },
        {
          "raw_line": 155,
          "raw_start": 0,
          "raw_end": 21,
          "start": 158,
          "end": 179,
          "surface": "郡多罪人將捶楚所求莫能自固邪遐處之自若郡境"
        },
        {
          "raw_line": 156,
          "raw_start": 0,
          "raw_end": 5,
          "start": 179,
          "end": 184,
          "surface": "肅然卒於官"
        }
      ],
      "text_sha256": "4f2422e13d6be7704af89287b55b5a253ba34d8e3f8e13a3ab36bd2fab229984"
    },
    {
      "key": "unit017",
      "layer": "received_compiler_appraisal",
      "raw_window": [
        157,
        164
      ],
      "raw_runs": [
        {
          "raw_line": 157,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "史臣曰若夫居官以潔其務欲以啓天下之方事親以"
        },
        {
          "raw_line": 158,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "終其身將以勸天下之俗非山公之具美其孰能與於"
        },
        {
          "raw_line": 159,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "此者哉自東京喪亂吏曹湮滅西園有三公之錢蒲陶"
        },
        {
          "raw_line": 160,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "有一州之任貪饕方駕寺署斯滿時移三代世歷九王"
        },
        {
          "raw_line": 161,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "拜謝私庭此焉成俗若乃餘風稍殄理或可言委以銓"
        },
        {
          "raw_line": 162,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "綜則羣情自抑通乎魚水則專用生疑將矯前失歸諸"
        },
        {
          "raw_line": 163,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "後正惠絕臣名恩馳天口世稱山公啓事者豈斯之謂"
        },
        {
          "raw_line": 164,
          "raw_start": 0,
          "raw_end": 12,
          "start": 147,
          "end": 159,
          "surface": "歟若盧子家之前代何足算也"
        }
      ],
      "text_sha256": "6c1499b0ceb09ddd9597080a82ce7d50710d008b69834be5fb9a9ec11e653d35"
    }
  ]
}
