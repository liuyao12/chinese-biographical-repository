  "source_clauses": [
    {
      "witness": "sg",
      "quote": "吴录曰：雍曾祖父奉，字季鸿，颍川太守。",
      "raw_start": 4205,
      "raw_end": 4224,
      "raw_line": 40
    },
    {
      "witness": "sg",
      "quote": "吴录曰：裕一名穆，终宜都太守。裕子荣。",
      "raw_start": 5765,
      "raw_end": 5784,
      "raw_line": 44
    },
    {
      "witness": "sg",
      "quote": "吴书曰：雍母弟徽。字子叹",
      "raw_start": 5871,
      "raw_end": 5883,
      "raw_line": 44
    },
    {
      "witness": "sg",
      "quote": "子裕，字季则，少知名，位至镇东将军。",
      "raw_start": 6216,
      "raw_end": 6234,
      "raw_line": 44
    },
    {
      "witness": "sg",
      "quote": "雍族人悌，字子通",
      "raw_start": 6234,
      "raw_end": 6242,
      "raw_line": 44
    },
    {
      "witness": "sg",
      "quote": "悌父向历四县令",
      "raw_start": 6356,
      "raw_end": 6363,
      "raw_line": 44
    },
    {
      "witness": "sg",
      "quote": "悌四子：彦、礼、谦、祕。秘，晋交州刺史。祕子众，尚书仆射。",
      "raw_start": 6504,
      "raw_end": 6533,
      "raw_line": 44
    },
    {
      "witness": "sg",
      "quote": "邵爲知人。在郡五年，卒官，子譚、承雲。",
      "raw_start": 7103,
      "raw_end": 7122,
      "raw_line": 48
    },
    {
      "witness": "j68",
      "quote": "顧榮，字彥先，吳國吳人也，為南土著姓。祖雍，吳丞相。父穆，宜都太守。",
      "raw_start": 170,
      "raw_end": 204,
      "raw_line": 11
    },
    {
      "witness": "j76",
      "quote": "顧衆，字長始，吳郡吳人，[[晉書/卷068#顧榮|驃騎將軍榮]]之族弟也。父秘，交州刺史，有文武才幹。",
      "raw_start": 8464,
      "raw_end": 8515,
      "raw_line": 114
    },
    {
      "witness": "sg47",
      "quote": "冬十一月，丞相顧雍卒。",
      "raw_start": 21993,
      "raw_end": 22004,
      "raw_line": 119
    },
    {
      "witness": "sg64",
      "quote": "與顧譚、張休等侍太子登講論道藝，並為賓友。",
      "raw_start": 279,
      "raw_end": 300,
      "raw_line": 12
    }
  ],
