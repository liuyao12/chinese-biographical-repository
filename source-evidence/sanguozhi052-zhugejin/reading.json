  "source_clauses": [
    {
      "witness": "sg",
      "quote": "孫權姊婿曲阿弘咨見而異之",
      "raw_start": 8387,
      "raw_end": 8399,
      "raw_line": 66
    },
    {
      "witness": "sg",
      "quote": "与吴书所说不同。",
      "raw_start": 8365,
      "raw_end": 8373,
      "raw_line": 66
    },
    {
      "witness": "sg",
      "quote": "二子恪、融皆典戎马",
      "raw_start": 10439,
      "raw_end": 10448,
      "raw_line": 76
    },
    {
      "witness": "sg",
      "quote": "族弟诞又显名於魏",
      "raw_start": 10454,
      "raw_end": 10462,
      "raw_line": 76
    },
    {
      "witness": "s35",
      "quote": "諸葛亮字孔明，琅邪陽都人也。",
      "raw_start": 227,
      "raw_end": 241,
      "raw_line": 12
    },
    {
      "witness": "s35",
      "quote": "瑾]]之第二子也，本字仲慎。",
      "raw_start": 13674,
      "raw_end": 13688,
      "raw_line": 90
    },
    {
      "witness": "s35",
      "quote": "初，亮未有子，求喬為嗣，瑾啟孫權遣喬來西，亮以喬為己適子，故易其字焉。",
      "raw_start": 13714,
      "raw_end": 13749,
      "raw_line": 90
    },
    {
      "witness": "s35",
      "quote": "子攀，官至行護軍翊武將軍，亦早卒。諸葛恪見誅於吳，子孫皆盡，而亮自有冑裔，故攀还復為瑾後。",
      "raw_start": 13840,
      "raw_end": 13885,
      "raw_line": 90
    },
    {
      "witness": "s35",
      "quote": "亮與兄瑾書曰",
      "raw_start": 13766,
      "raw_end": 13772,
      "raw_line": 90
    },
    {
      "witness": "s28",
      "quote": "諸葛誕字公休，琅邪陽都人，諸葛豐後也。",
      "raw_start": 8585,
      "raw_end": 8604,
      "raw_line": 41
    },
    {
      "witness": "s64",
      "quote": "諸葛恪字元遜，瑾長子也。",
      "raw_start": 173,
      "raw_end": 185,
      "raw_line": 12
    },
    {
      "witness": "s57",
      "quote": "虞翻字仲翔，會稽餘姚人也。",
      "raw_start": 207,
      "raw_end": 220,
      "raw_line": 11
    },
    {
      "witness": "s58",
      "quote": "陸遜字伯言",
      "raw_start": 185,
      "raw_end": 190,
      "raw_line": 11
    },
    {
      "witness": "s54",
      "quote": "呂蒙字子明",
      "raw_start": 9024,
      "raw_end": 9029,
      "raw_line": 60
    },
    {
      "witness": "s55",
      "quote": "潘璋字文珪",
      "raw_start": 9448,
      "raw_end": 9453,
      "raw_line": 117
    }
  ],
