    {
      "matter": "袁后之母與王夫人",
      "evidence": [
        {
          "title": "宋書/卷41",
          "revision": 2634831,
          "path": "source-evidence/nanshi022-wang/song041-ws2634831.wikitext",
          "raw_sha256": "9bbc04376eabe39a2e58ca12fb45068b667ae57102a566f557d564efb9556d55",
          "line": 213,
          "start": 50,
          "end": 57,
          "quote": "亡外祖親王夫人"
        },
        {
          "title": "宋書/卷41",
          "revision": 2634831,
          "path": "source-evidence/nanshi022-wang/song041-ws2634831.wikitext",
          "raw_sha256": "9bbc04376eabe39a2e58ca12fb45068b667ae57102a566f557d564efb9556d55",
          "line": 213,
          "start": 110,
          "end": 135,
          "quote": "乃追贈豫章郡新淦縣平樂鄉君。-{后}-之所生母也。"
        },
        {
          "title": "南史/卷11",
          "revision": 2288359,
          "path": "source-evidence/nanshi022-wang/nan011-ws2288359.wikitext",
          "raw_sha256": "056a4790420554786f40b92b14255aeec0a0eb168722bfeda19ad5f78f6363d4",
          "line": 37,
          "start": 129,
          "end": 150,
          "quote": "追后之所生外祖親王夫人為豫章郡新淦平樂鄉君"
        }
      ],
      "reading": "直接還原袁后生母王夫人，稱王夫人及平樂鄉君。沒有因此將其登成下詔者孝武帝的血緣外祖母。"
    },
    {
      "matter": "宗室正妻與嫡母稱號",
      "evidence": [
        {
          "title": "南齊書/卷23",
          "revision": 1545488,
          "path": "source-evidence/nanshi022-wang/nanqi023-ws1545488.wikitext",
          "raw_sha256": "aca7d279e2bec7461700ae2bfe9504272af2da8a5a13a4567635eeb30e4ec8cd",
          "line": 65,
          "start": 32,
          "end": 59,
          "quote": "尚陽羨公主，拜駙馬都尉。帝以儉嫡母武康公主同太初巫蠱事"
        },
        {
          "title": "王文憲集序",
          "revision": 2318179,
          "path": "source-evidence/nanshi022-wang/renfang-wangwenxian-ws2318179.wikitext",
          "raw_sha256": "fe29858b33be05d3fd7a978c92040c612218acf2419b39d92263719a4b697b5e",
          "line": 14,
          "start": 130,
          "end": 140,
          "quote": "與公母武康公主素不協"
        },
        {
          "title": "南齊書/卷23",
          "revision": 1545488,
          "path": "source-evidence/nanshi022-wang/nanqi023-ws1545488.wikitext",
          "raw_sha256": "aca7d279e2bec7461700ae2bfe9504272af2da8a5a13a4567635eeb30e4ec8cd",
          "line": 67,
          "start": 62,
          "end": 73,
          "quote": "母憂，服闋爲司徒右長史"
        }
      ],
      "reading": "王儉所尚陽羨、嫡母武康兩代分明。東陽與武康的封號先後及同一人仍有解釋之別，未有生母斷言。"
    },
