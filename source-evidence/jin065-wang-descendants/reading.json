        "paragraph_id": "c-jinshu-065-wangdao-family:line114",
        "start": 152,
        "end": 163,
        "quote": "廞眾潰奔走，遂不知所在"
      },
      "witnesses": [
        {
          "witness": "jin010",
          "raw_start": 640,
          "raw_end": 661,
          "raw_line": 22,
          "quote": "五月，前司徒長史王廞以吳郡反，王恭討平之。",
          "source_layer": "正文"
        },
        {
          "witness": "song063",
          "raw_start": 400,
          "raw_end": 425,
          "raw_line": 10,
          "quote": "恭遣劉牢之擊廞，廞敗走，不知所在。長子泰為恭所殺。",
          "source_layer": "正文"
        },
        {
          "witness": "song063",
          "raw_start": 628,
          "raw_end": 647,
          "raw_line": 12,
