  "items": [
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:p002",
        "start": 0,
        "end": 6,
        "quote": "二弟：穎、敞"
      },
      "reading": "兩人分列，皆王導弟、並早卒。世說注另名其字、官及卒齡。兩個人物的比擬對象須按不同正文保存。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line078",
        "start": 30,
        "end": 49,
        "quote": "謝掾年四十，必擁旄杖節。王掾當作黑頭公"
      },
      "reading": "桓溫預言分指謝玄、王珣；黑頭公是預言，非此時授官。珣本傳封東亭侯。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line080",
        "start": 14,
        "end": 27,
        "quote": "太傅安既與珣絶婚，又離瑉妻"
      },
      "reading": "兄弟均為謝氏婿，謝安斷婚；兩妻之父本句未明，各自父女不可憑斷婚主事者增補。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line080",
        "start": 43,
        "end": 63,
        "quote": "出珣爲豫章太守，不之官。除散騎常侍，不拜"
      },
      "reading": "兩項實際未赴授，與後遷秘書監等分列。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line082",
        "start": 78,
        "end": 88,
        "quote": "珣夢人以大筆如椽與之"
      },
      "reading": "敘夢與其後孝武帝崩、哀冊諡議分層。宋書補珣作哀策、王誕益序節物一句。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line084",
        "start": 132,
        "end": 145,
        "quote": "旬曰：「王陵廷爭，陳平慎默"
      },
      "reading": "固定文旬，殿本十三上珣，對答者為王珣；引例王陵、陳平為前人。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line084",
        "start": 186,
        "end": 189,
        "quote": "假珣節"
      },
      "reading": "王恭暫假珣節，後交還，並非永久持節。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line086",
        "start": 0,
        "end": 18,
        "quote": "四年，以疾解職。歳餘，卒，時年五十二"
      },
      "reading": "傳文未直書卒年；本紀隆安四年五月丙寅卒有衝突，不把歲餘自動換算為隆安五年。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line086",
        "start": 19,
        "end": 33,
        "quote": "追贈車騎將軍、開府，諡曰獻穆"
      },
      "reading": "死後贈官及開府、諡獻穆，後桓玄輔政改贈司徒。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:p004",
        "start": 21,
        "end": 26,
        "quote": "詣族弟獻之"
      },
      "reading": "獻之是珣族弟。獻之所稱法護為珣小字，謝公為謝安。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:p004",
        "start": 67,
        "end": 81,
        "quote": "珣五子：弘、虞、柳、孺、曇首"
      },
      "reading": "五子原名逐一連到原號，本文無排行數字、無生母。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line096",
        "start": 5,
        "end": 11,
        "quote": "元帝撫軍參軍"
      },
      "reading": "固定本與殿本同作元帝。惜抱軒筆記疑簡文為撫軍，作校者提議，不暗改帝號。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line096",
        "start": 12,
        "end": 31,
        "quote": "襲爵武岡侯，早卒，無子，以弟劭子謐爲嗣"
      },
      "reading": "協襲武岡侯；謐為其弟劭子、由協承嗣。導另封始興、王琨襲導爵的傳承仍有疑義。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line100",
        "start": 0,
        "end": 4,
        "quote": "謐字稚遠"
      },
      "reading": "傳與武英殿俱稚遠；早期世說注引中興書作雅遠。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line100",
        "start": 23,
        "end": 31,
        "quote": "拜秘書郎，襲父爵"
      },
      "reading": "父爵原詞未明寫爵號。相鄰協傳交代為嗣，中興書另證襲武岡侯；不在本句暗補父名爵名。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line100",
        "start": 80,
        "end": 83,
        "quote": "未至郡"
      },
      "reading": "拜建威將軍、呉國內史，未至郡已改官；不從授予推出實際赴任。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line100",
        "start": 127,
        "end": 132,
        "quote": "奉璽冊詣玄"
      },
      "reading": "桓玄篡位，王謐奉璽冊，封武昌縣開國公。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line102",
        "start": 36,
        "end": 41,
        "quote": "及裕破恆玄"
      },
      "reading": "按殿本及斠注此為桓玄，固定原詞恆玄留存。卿為王謐對劉裕的稱呼。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line102",
        "start": 95,
        "end": 104,
        "quote": "會王綏以桓氏甥自疑"
      },
      "reading": "桓氏甥為家族稱，不指特定舅氏。父子兄弟皆伏誅，無逐一名錄。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line102",
        "start": 116,
        "end": 120,
        "quote": "謐從弟諶"
      },
      "reading": "諶稱王謐為兄，從弟方向據敘文。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line102",
        "start": 222,
        "end": 233,
        "quote": "義熙三年卒，時年四十八"
      },
      "reading": "407年卒，原報四十八；追贈侍中、司徒，諡文恭。瓘、球、琇為三子。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line106",
        "start": 0,
        "end": 4,
        "quote": "劭字敬倫"
      },
      "reading": "名劭，王導六子名單作邵；世說雅量注排行第五，稱鳳鶵。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line106",
        "start": 83,
        "end": 94,
        "quote": "卒，贈車騎將軍，諡曰簡"
      },
      "reading": "車騎將軍是卒後贈官，簡為諡。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line106",
        "start": 95,
        "end": 103,
        "quote": "三子：穆、默、恢"
      },
      "reading": "此處列三子而協傳另載謐為劭子給協嗣。兩條各自存證；此處恢與王嘏子恢不合號。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line106",
        "start": 130,
        "end": 147,
        "quote": "穆三子：簡、智、超。默二子：鑒、惠"
      },
      "reading": "各子分屬穆、默，義熙中並歷顯職未逐名列官。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line110",
        "start": 49,
        "end": 56,
        "quote": "薈以私米作饘粥"
      },
      "reading": "王薈以私米救饑。《劭薈別傳》所引言為導最小子；小奴為薈小字。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line110",
        "start": 68,
        "end": 76,
        "quote": "征補中領軍，不拜"
      },
      "reading": "不拜中領軍；桓沖表請江州刺史亦固辭不拜。其餘實任照卷中所錄。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line110",
        "start": 147,
        "end": 155,
        "quote": "卒于官，贈衞將軍"
      },
      "reading": "卒于官與所贈衞將軍分別記錄。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line114",
        "start": 16,
        "end": 23,
        "quote": "以母喪，居於呉"
      },
      "reading": "王廞母喪；王恭起兵令其助軍，借官以假為原詞。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line114",
        "start": 158,
        "end": 163,
        "quote": "遂不知所在"
      },
      "reading": "曲阿兵敗，不知所在；長子泰遭王恭所殺。廞無確定卒日、地名，不能將戰敗作死亡。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line114",
        "start": 189,
        "end": 202,
        "quote": "後從兄謐言其死所，華始發喪"
      },
      "reading": "華從兄王謐為敘事消息來源。宋書王華傳載劉裕發喪問令華制服，兩條不同敘事保留。"
    }
  ],
  "comparisons": [
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:p002",
        "start": 14,
        "end": 29,
        "quote": "時人以穎方溫太真，以敞比鄧伯道"
      },
      "witnesses": [
        {
          "witness": "pin",
          "raw_start": 3945,
          "raw_end": 3983,
          "raw_line": 26,
          "quote": "王丞相二弟不過江，曰頴，曰敞。時論以頴比鄧伯道，敞比溫忠武。議郎、祭酒者也。",
          "source_layer": "正文"
        },
        {
          "witness": "pin",
          "raw_start": 3993,
          "raw_end": 4035,
          "raw_line": 26,
          "quote": "潁字茂英，位至議郎，年二十卒。敞字茂平，丞相祭酒，不就。襲爵堂邑公，年二十有二而卒。",
          "source_layer": "劉注引王氏譜"
        },
        {
          "witness": "jin090",
          "raw_start": 5758,
          "raw_end": 5772,
          "raw_line": 103,
          "quote": "鄧攸，字伯道，平陽襄陵人也。",
          "source_layer": "正文"
        }
      ],
      "judgment": "兩書反置比擬者：晉書穎方溫嶠、敞比鄧伯道；世說頴比鄧伯道、敞比溫忠武。比擬本身屬時論。鄧攸之字辨舊號重複問題另立檢索單。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line080",
        "start": 0,
        "end": 7,
        "quote": "珣兄弟皆謝氏婿"
      },
      "witnesses": [
        {
          "witness": "shangshi",
          "raw_start": 2236,
          "raw_end": 2271,
          "raw_line": 23,
          "quote": "珣兄弟皆婿謝氏，以猜嫌離婚。太傅既與珣絕婚，又離妻，由是二族遂成仇釁。",
          "source_layer": "劉注引中興書"
        }
      ],
      "judgment": "早期記載同述謝、王二族婚姻終止，未明妻是何人之女。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line082",
        "start": 111,
        "end": 120,
        "quote": "哀冊諡議，皆珣所草"
      },
      "witnesses": [
        {
          "witness": "song052",
          "raw_start": 1719,
          "raw_end": 1740,
          "raw_line": 22,
          "quote": "晉孝武帝崩，從叔尚書令珣為哀策文，久而未就",
          "source_layer": "正文"
        }
      ],
      "judgment": "宋書王誕傳據其主題稱珣為誕從叔；另述誕益文。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line084",
        "start": 0,
        "end": 19,
        "quote": "隆安初，國寶用事，謀黜舊臣，遷珣尚書令"
      },
      "witnesses": [
        {
          "witness": "jin010",
          "raw_start": 292,
          "raw_end": 319,
          "raw_line": 14,
          "quote": "以尚書右僕射王珣爲尚書令，領軍將軍王國寶爲尚書左僕射。",
          "source_layer": "正文"
        }
      ],
      "judgment": "安帝紀繫二人任命於隆安元年正月。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line086",
        "start": 8,
        "end": 12,
        "quote": "歳餘，卒"
      },
      "witnesses": [
        {
          "witness": "jin010",
          "raw_start": 2274,
          "raw_end": 2284,
          "raw_line": 68,
          "quote": "===隆安四年===",
          "source_layer": "年題"
        },
        {
          "witness": "jin010",
          "raw_start": 2354,
          "raw_end": 2375,
          "raw_line": 77,
          "quote": "五月丙寅，散騎常侍、衛將軍、東亭侯王珣卒。",
          "source_layer": "正文"
        }
      ],
      "judgment": "本紀明記隆安四年五月丙寅；與本傳四年解職、歲餘卒的相對時間有異。重用既有正史本紀原生死亡斷言。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:p004",
        "start": 59,
        "end": 66,
        "quote": "法護，珣小字也"
      },
      "witnesses": [
        {
          "witness": "shangshi",
          "raw_start": 2322,
          "raw_end": 2329,
          "raw_line": 23,
          "quote": "法護，珣小字。",
          "source_layer": "劉孝標注"
        },
        {
          "witness": "shangshi",
          "raw_start": 2217,
          "raw_end": 2226,
          "raw_line": 23,
          "quote": "王東亭與謝公交惡。",
          "source_layer": "正文"
        }
      ],
      "judgment": "王東亭為珣，子敬為獻之；哭謝安事有異同。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line096",
        "start": 5,
        "end": 11,
        "quote": "元帝撫軍參軍"
      },
      "witnesses": [
        {
          "witness": "z378",
          "raw_start": 785,
          "raw_end": 820,
          "raw_line": 8,
          "quote": "《惜抱軒筆記》曰：「協安能上接元帝？蓋簡文爲撫軍將軍，協爲其參軍耳。」",
          "source_layer": "斠注引姚鼐"
        }
      ],
      "judgment": "武英殿十四上與正文同作元帝，簡文為校勘意見。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line096",
        "start": 12,
        "end": 17,
        "quote": "襲爵武岡侯"
      },
      "witnesses": [
        {
          "witness": "z378",
          "raw_start": 922,
          "raw_end": 954,
          "raw_line": 8,
          "quote": "豈琨襲者始興郡公，而協襲武岡侯乎？旣進封，卽除本封，無兩襲之例。",
          "source_layer": "斠注引讀書記疑"
        },
        {
          "witness": "pin",
          "raw_start": 11392,
          "raw_end": 11422,
          "raw_line": 91,
          "quote": "謐字雅遠，丞相導孫，車騎劭子。有才器，襲爵武岡侯，位至司徒。",
          "source_layer": "劉注引中興書"
        }
      ],
      "judgment": "中興書明載謐襲武岡侯。《讀書記疑》質疑琨與協雙襲說，不補兩支授爵次第。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line100",
        "start": 0,
        "end": 4,
        "quote": "謐字稚遠"
      },
      "witnesses": [
        {
          "witness": "pin",
          "raw_start": 11392,
          "raw_end": 11422,
          "raw_line": 91,
          "quote": "謐字雅遠，丞相導孫，車騎劭子。有才器，襲爵武岡侯，位至司徒。",
          "source_layer": "劉注引中興書"
        }
      ],
      "judgment": "雅遠／稚遠為同人異文；中興書明載丞相導孫、車騎劭子。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line102",
        "start": 36,
        "end": 41,
        "quote": "及裕破恆玄"
      },
      "witnesses": [
        {
          "witness": "z379",
          "raw_start": 609,
          "raw_end": 622,
          "raw_line": 2,
          "quote": "及裕破桓𤣥，謐以本官加侍中",
          "source_layer": "正文"
        }
      ],
      "judgment": "殿本十四下作桓玄，斠注桓𤣥；固定文本恆玄留存。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line106",
