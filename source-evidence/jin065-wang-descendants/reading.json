          "source_layer": "劉注引劭薈別傳"
        }
      ],
      "judgment": "明載第五子。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line110",
        "start": 0,
        "end": 4,
        "quote": "薈字敬文"
      },
      "witnesses": [
        {
          "witness": "ya",
          "raw_start": 10800,
          "raw_end": 10872,
          "raw_line": 28,
          "quote": "{{ProperNoun|薈}}字{{ProperNoun|敬文}}，丞相{{ProperNoun|最}}小子。有淸譽，夷泰無競，仕至鎭軍將軍。",
          "source_layer": "劉注引劭薈別傳"
