  "source_clauses": [
    {
      "witness": "w51",
      "quote": "恭生峻。綽生綝",
      "raw_start": 766,
      "raw_end": 773,
      "raw_line": 11
    },
    {
      "witness": "w51",
      "quote": "皖有力焉",
      "raw_start": 1833,
      "raw_end": 1837,
      "raw_line": 24
    },
    {
      "witness": "w51",
      "quote": "據、胤皆壹皆之妹夫也",
      "raw_start": 2578,
      "raw_end": 2588,
      "raw_line": 29
    },
    {
      "witness": "w51",
      "quote": "壹入魏三年死",
      "raw_start": 2682,
      "raw_end": 2688,
      "raw_line": 29
    },
    {
      "witness": "w51",
      "quote": "父羌字聖〔臺〕",
      "raw_start": 2708,
      "raw_end": 2715,
      "raw_line": 32
    },
    {
      "witness": "w51",
      "quote": "鄰年九歲，代領豫章",
      "raw_start": 3332,
      "raw_end": 3341,
      "raw_line": 34
    },
    {
      "witness": "w51",
      "quote": "賁曾孫惠，字德施",
      "raw_start": 3717,
      "raw_end": 3725,
      "raw_line": 34
    },
    {
      "witness": "w51",
      "quote": "未試用，卒。時年二十餘",
      "raw_start": 4959,
      "raw_end": 4970,
      "raw_line": 44
    },
    {
      "witness": "w51",
      "quote": "此盖权别生弟朗",
      "raw_start": 5160,
      "raw_end": 5167,
      "raw_line": 44
    },
    {
      "witness": "w51",
      "quote": "伯父河，字伯海，本姓俞氏",
      "raw_start": 5522,
      "raw_end": 5534,
      "raw_line": 47
    },
    {
      "witness": "w51",
      "quote": "河，坚族子也，出后姑俞氏",
      "raw_start": 5565,
      "raw_end": 5577,
      "raw_line": 47
    },
    {
      "witness": "w51",
      "quote": "由亮養子喬咨述故雲",
      "raw_start": 4920,
      "raw_end": 4929,
      "raw_line": 41
    },
    {
      "witness": "w51",
      "quote": "慎子丞，字显世",
      "raw_start": 7901,
      "raw_end": 7908,
      "raw_line": 56
    },
    {
      "witness": "w51",
      "quote": "丞好学，有文章",
      "raw_start": 7916,
      "raw_end": 7923,
      "raw_line": 56
    },
    {
      "witness": "w4",
      "quote": "十一月癸卯，車騎將軍孫壹為婢所殺",
      "raw_start": 17337,
      "raw_end": 17353,
      "raw_line": 124
    },
    {
      "witness": "w35",
      "quote": "喬字伯松，亮兄[[三國志/卷52#諸葛瑾|瑾]]之第二子也，本字仲慎。",
      "raw_start": 13653,
      "raw_end": 13688,
      "raw_line": 90
    },
    {
      "witness": "w35",
      "quote": "初，亮未有子，求喬為嗣，瑾啟孫權遣喬來西，亮以喬為己適子，故易其字焉。",
      "raw_start": 13714,
      "raw_end": 13749,
      "raw_line": 90
    },
    {
      "witness": "w48",
      "quote": "夏口督孫壹奔魏",
      "raw_start": 2250,
      "raw_end": 2257,
      "raw_line": 28
    },
    {
      "witness": "w48",
      "quote": "都督孫秀奔晉。",
      "raw_start": 10846,
      "raw_end": 10853,
      "raw_line": 68
    },
    {
      "witness": "w48",
      "quote": "京下督孫楷降晉。",
      "raw_start": 13329,
      "raw_end": 13337,
      "raw_line": 80
    },
    {
      "witness": "w64",
      "quote": "孫峻字子遠，孫堅弟靜之曾孫也。",
      "raw_start": 9251,
      "raw_end": 9266,
      "raw_line": 70
    },
    {
      "witness": "w64",
      "quote": "孫綝字子通，與峻同祖。綝父綽為安民都尉。",
      "raw_start": 10367,
      "raw_end": 10387,
      "raw_line": 78
    },
    {
      "witness": "j3",
      "quote": "十二月，吳夏口督、前將軍孫秀帥眾來奔，拜驃騎將軍、開府儀同三司，封會稽公。",
      "raw_start": 6353,
      "raw_end": 6390,
      "raw_line": 141
    },
    {
      "witness": "j54",
      "quote": "孫拯者，字顯世，吳都富春人也。能屬文，仕吳為黃門郎。孫皓世，侍臣多得罪，惟拯與顧榮以智全。吳平後，為涿令，有稱績。",
      "raw_start": 7678,
      "raw_end": 7735,
      "raw_line": 75
    },
    {
      "witness": "j54",
      "quote": "拯遂死獄中，而慈、意亦死。",
      "raw_start": 7808,
      "raw_end": 7821,
      "raw_line": 75
    }
  ],
