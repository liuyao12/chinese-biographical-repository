  "column_file": "source-evidence/nanshi024-wangyanzhi/wyd-columns.txt",
  "column_file_sha256": "e34bb528b6ae95d677b1dd58aaf5e2921dd3fa3ce67cd2e3043f1dca3ad0cf8d",
  "columns": [
    {
      "pdf_page": 33,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 9,
      "reading": "延之字希季昇之子也少靜默不交人事仕宋為司徒",
      "start_codepoint": 0,
      "end_codepoint": 21
    },
    {
      "pdf_page": 33,
      "half": "左",
      "leaf": "四上",
      "column_from_right": 10,
      "reading": "左長史清貧居宇穿漏褚彦回以啓宋明帝即勅材官",
      "start_codepoint": 21,
      "end_codepoint": 42
    },
    {
      "pdf_page": 34,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 1,
      "reading": "為起三間齋屋歴吏部尚書尚書左僕射宋德旣衰齊",
      "start_codepoint": 42,
      "end_codepoint": 63
    },
    {
      "pdf_page": 34,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 2,
      "reading": "高帝輔政朝野之情人懷彼此延之與尚書令王僧虔",
      "start_codepoint": 63,
      "end_codepoint": 84
    },
    {
      "pdf_page": 34,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 3,
      "reading": "中立無所去就時人語曰二王居平不送不迎高帝以",
      "start_codepoint": 84,
      "end_codepoint": 105
    },
    {
      "pdf_page": 34,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 4,
      "reading": "此善之昇明三年出為江州刺史加都督齊建元元年",
      "start_codepoint": 105,
      "end_codepoint": 126
    },
    {
      "pdf_page": 34,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 5,
      "reading": "進號鎮南將軍延之與金紫光祿大夫阮韜俱宋領軍",
      "start_codepoint": 126,
      "end_codepoint": 147
    },
    {
      "pdf_page": 34,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 6,
      "reading": "將軍劉湛外甥並有早譽湛甚愛之曰韜後當為第一",
      "start_codepoint": 147,
      "end_codepoint": 168
    },
    {
      "pdf_page": 34,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 7,
      "reading": "延之為次也延之甚不平每致餉下都韜與朝士同例",
      "start_codepoint": 168,
      "end_codepoint": 189
    },
    {
      "pdf_page": 34,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 8,
      "reading": "高武聞之與延之書曰韜云卿未嘗有別意當由劉家",
      "start_codepoint": 189,
      "end_codepoint": 210
    },
    {
      "pdf_page": 34,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 9,
      "reading": "月旦故邪韜字長明陳留人晉金紫光祿大夫裕𤣥孫",
      "start_codepoint": 210,
      "end_codepoint": 231
    },
    {
      "pdf_page": 34,
      "half": "右",
      "leaf": "四下",
      "column_from_right": 10,
      "reading": "也為南兖州別駕刺史江夏王義恭逆求資費錢韜曰",
      "start_codepoint": 231,
      "end_codepoint": 252
    },
    {
      "pdf_page": 34,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 1,
      "reading": "此朝廷物執不與宋孝武選侍中四人並以風貌王彧",
      "start_codepoint": 252,
      "end_codepoint": 273
    },
    {
      "pdf_page": 34,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 2,
      "reading": "謝莊為一雙韜與何偃為一雙常充兼假至始興王師",
      "start_codepoint": 273,
      "end_codepoint": 294
    },
    {
      "pdf_page": 34,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 3,
      "reading": "卒延之居身簡素清靜寡慾凡所經歴務存不擾在江",
      "start_codepoint": 294,
      "end_codepoint": 315
    },
    {
      "pdf_page": 34,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 4,
      "reading": "州祿俸外一無所納獨處齋內未嘗出戸吏人罕得見",
      "start_codepoint": 315,
      "end_codepoint": 336
    },
    {
      "pdf_page": 34,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 5,
      "reading": "焉雖子弟亦不妄前時時見親舊未嘗及世事從容談",
      "start_codepoint": 336,
      "end_codepoint": 357
    },
    {
      "pdf_page": 34,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 6,
      "reading": "詠而已後為尚書左僕射尋領竟陵王師卒諡簡子",
      "start_codepoint": 357,
      "end_codepoint": 377
    },
    {
      "pdf_page": 34,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 7,
      "reading": "子綸之字元章為安成王記室參軍偃仰召會退居僚",
      "start_codepoint": 377,
      "end_codepoint": 398
    },
    {
      "pdf_page": 34,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 8,
      "reading": "末司徒袁粲聞而歎曰格外之官便今日為重貴游居",
      "start_codepoint": 398,
      "end_codepoint": 419
    },
    {
      "pdf_page": 34,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 9,
      "reading": "此位者遂以不掌文記為高自綸之始也齊永明中歴",
      "start_codepoint": 419,
      "end_codepoint": 440
    },
    {
      "pdf_page": 34,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 10,
      "reading": "位侍中出為豫章太守下車祭徐孺子許子將墓圖畫",
      "start_codepoint": 440,
      "end_codepoint": 461
    },
    {
      "pdf_page": 35,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 1,
      "reading": "陳蕃華歆謝鯤像於郡朝堂為政寛簡稱良二千石武",
      "start_codepoint": 461,
      "end_codepoint": 482
    },
    {
      "pdf_page": 35,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 2,
      "reading": "帝幸琅邪城綸之與光祿大夫全景文等二十一人坐",
      "start_codepoint": 482,
      "end_codepoint": 503
    },
    {
      "pdf_page": 35,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 3,
      "reading": "不參承為有司奏免官後位侍中都官尚書卒自敬𢎞",
      "start_codepoint": 503,
      "end_codepoint": 524
    },
    {
      "pdf_page": 35,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 4,
      "reading": "至綸之並方嚴皆尅日乃見子孫蓋家風也綸之子昕",
      "start_codepoint": 524,
      "end_codepoint": 545
    },
    {
      "pdf_page": 35,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 5,
      "reading": "有業行居父憂過禮謝𤅢欲遣參之孔珪曰何假參此",
      "start_codepoint": 545,
      "end_codepoint": 566
    },
    {
      "pdf_page": 35,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 6,
      "reading": "豈有全理以憂卒",
      "start_codepoint": 566,
      "end_codepoint": 573
    }
  ],
