    "date_expression": null,
    "source_term": "以疾病退還彭城",
    "evidence": [
      {
        "work_id": "w-jinshu",
        "book_id": "b-jinshu-079",
        "source_id": "s-jinshu-079-xielang-family",
        "chapter_id": "c-jinshu-079-xielang-family",
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xiewan-p003",
        "quote": "萬既受任北征，矜豪傲物，嘗以嘯詠自高，未嘗撫眾。兄安深憂之，自隊主將帥已下，安無不慰勉。謂萬曰：「汝為元帥，諸將宜數接對，以悅其心，豈有傲誕若斯而能濟事也！」萬乃召集諸將，都無所說，直以如意指四坐云：「諸將皆勁卒。」諸將益恨之。既而先遣征虜將軍劉建修治馬頭城池，自率眾入渦潁，以援洛陽。北中郎將郗曇以疾病退還彭城，萬以為賊盛致退，便引軍還，眾遂潰散，狼狽單歸，廢為庶人。後復以為散騎常侍，會卒，時年四十二，因以為贈。",
        "person_mention_id": "c-jinshu-079-xielang-family:exp-xiewan-p003:m0147"
      }
    ],
    "qualifiers": {},
    "interpretation_note": "只記疾病退還的移動目的地，不表示遷籍、久居或出生地。",
    "reviewer": "Codex（AI代理）",
    "human_reviewed": false,
    "model": null
  }
]
