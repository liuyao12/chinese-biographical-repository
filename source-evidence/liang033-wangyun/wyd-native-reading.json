  ],
  "gloss_transcription_path": "source-evidence/liang033-wangyun/wyd-glosses.tsv",
  "gloss_sha256": "a1dc0ad8c26449f4eff22adaccf05e54e3ea16b72a5fd93fa05ae26de8945562",
  "columns": [
    {
      "column": "58R03",
      "pdf_page": 58,
      "half": "右",
      "leaf": "十六下",
      "column_from_right": 3,
      "start_codepoint": 0,
      "end_codepoint": 21,
      "text": "王筠字元禮一字德柔琅邪臨沂人祖僧虔齊司空簡"
    },
    {
      "column": "58R04",
      "pdf_page": 58,
      "half": "右",
      "leaf": "十六下",
      "column_from_right": 4,
      "start_codepoint": 21,
      "end_codepoint": 42,
      "text": "穆公父楫太中大夫筠幼警寤七歲能屬文年十六為"
    },
    {
      "column": "58R05",
      "pdf_page": 58,
      "half": "右",
      "leaf": "十六下",
      "column_from_right": 5,
      "start_codepoint": 42,
      "end_codepoint": 63,
      "text": "芍藥賦甚美及長清靜好學與從兄泰齊名陳郡謝覽"
    },
    {
      "column": "58R06",
      "pdf_page": 58,
      "half": "右",
      "leaf": "十六下",
      "column_from_right": 6,
      "start_codepoint": 63,
      "end_codepoint": 84,
      "text": "覽弟舉亦有重譽時人為之語曰謝有覽舉王有養炬"
    },
    {
      "column": "58R07",
      "pdf_page": 58,
      "half": "右",
      "leaf": "十六下",
      "column_from_right": 7,
      "start_codepoint": 84,
      "end_codepoint": 105,
      "text": "炬是泰養卽筠並小字也起家中軍臨川王行參軍遷"
    },
    {
      "column": "58R08",
      "pdf_page": 58,
      "half": "右",
      "leaf": "十六下",
      "column_from_right": 8,
      "start_codepoint": 105,
      "end_codepoint": 126,
      "text": "太子舍人除尚書殿中郎王氏過江以來未有居郎署"
    },
    {
      "column": "58R09",
      "pdf_page": 58,
      "half": "右",
      "leaf": "十六下",
      "column_from_right": 9,
      "start_codepoint": 126,
      "end_codepoint": 147,
      "text": "者或勸逡巡不就筠曰陸平原東南之秀王文度獨步"
    },
    {
      "column": "58R10",
      "pdf_page": 58,
      "half": "右",
      "leaf": "十六下",
      "column_from_right": 10,
      "start_codepoint": 147,
      "end_codepoint": 168,
      "text": "江東吾得比蹤昔人何所多恨乃欣然就職尚書令沈"
    },
    {
      "column": "58L01",
      "pdf_page": 58,
      "half": "左",
      "leaf": "十七上",
      "column_from_right": 1,
      "start_codepoint": 168,
      "end_codepoint": 189,
      "text": "約當世辭宗每見筠文咨嗟吟咏以為不逮也嘗謂筠"
    },
    {
      "column": "58L02",
      "pdf_page": 58,
      "half": "左",
      "leaf": "十七上",
      "column_from_right": 2,
      "start_codepoint": 189,
      "end_codepoint": 210,
      "text": "昔蔡伯喈見王仲宣稱曰王公之孫也吾家書籍悉當"
    },
    {
      "column": "58L03",
      "pdf_page": 58,
      "half": "左",
      "leaf": "十七上",
      "column_from_right": 3,
      "start_codepoint": 210,
      "end_codepoint": 231,
      "text": "相與僕雖不敏請附斯言自謝朓諸賢零落已後平生"
    },
    {
      "column": "58L04",
      "pdf_page": 58,
      "half": "左",
      "leaf": "十七上",
      "column_from_right": 4,
      "start_codepoint": 231,
      "end_codepoint": 252,
      "text": "意好殆將都絕不謂疲暮復逢於君約於郊居宅造閣"
    },
    {
      "column": "58L05",
      "pdf_page": 58,
      "half": "左",
      "leaf": "十七上",
      "column_from_right": 5,
      "start_codepoint": 252,
      "end_codepoint": 273,
      "text": "齋筠為草木十詠書之於壁皆直寫文詞不加篇題約"
    },
    {
      "column": "58L06",
      "pdf_page": 58,
      "half": "左",
      "leaf": "十七上",
      "column_from_right": 6,
      "start_codepoint": 273,
      "end_codepoint": 294,
      "text": "謂人云此詩指物呈形無假題署約製郊居賦構思積"
    },
    {
      "column": "58L07",
      "pdf_page": 58,
      "half": "左",
      "leaf": "十七上",
      "column_from_right": 7,
      "start_codepoint": 294,
      "end_codepoint": 313,
      "text": "時猶未都畢乃要筠示其草筠讀至雌霓連踡約"
    },
    {
      "column": "58L08",
      "pdf_page": 58,
      "half": "左",
      "leaf": "十七上",
      "column_from_right": 8,
      "start_codepoint": 313,
      "end_codepoint": 332,
      "text": "撫掌欣抃曰僕嘗恐人呼為霓次至墜石磓星及"
    },
    {
      "column": "58L09",
      "pdf_page": 58,
      "half": "左",
      "leaf": "十七上",
      "column_from_right": 9,
      "start_codepoint": 332,
      "end_codepoint": 353,
      "text": "水懸坎而帶坻筠皆擊節稱贊約曰知音者希真賞殆"
    },
    {
      "column": "58L10",
      "pdf_page": 58,
      "half": "左",
      "leaf": "十七上",
      "column_from_right": 10,
      "start_codepoint": 353,
      "end_codepoint": 374,
      "text": "絕所以相要政在此數句耳筠又嘗為詩呈約卽報書"
    },
    {
      "column": "59R01",
      "pdf_page": 59,
      "half": "右",
      "leaf": "十七下",
      "column_from_right": 1,
      "start_codepoint": 374,
      "end_codepoint": 395,
      "text": "云覽所示詩實為麗則聲和被紙光影盈字夔牙接響"
    },
    {
      "column": "59R02",
      "pdf_page": 59,
      "half": "右",
      "leaf": "十七下",
      "column_from_right": 2,
      "start_codepoint": 395,
      "end_codepoint": 416,
      "text": "顧有餘慚孔翠羣翔豈不多愧古情拙目每佇新奇爛"
    },
    {
      "column": "59R03",
      "pdf_page": 59,
      "half": "右",
      "leaf": "十七下",
      "column_from_right": 3,
      "start_codepoint": 416,
      "end_codepoint": 437,
      "text": "然總至權輿已盡會昌昭發蘭揮玉振克諧之義寧比"
    },
    {
      "column": "59R04",
      "pdf_page": 59,
      "half": "右",
      "leaf": "十七下",
      "column_from_right": 4,
      "start_codepoint": 437,
      "end_codepoint": 458,
      "text": "笙簧思力所該一至乎此歎服吟研周流忘念昔時幼"
    },
    {
      "column": "59R05",
      "pdf_page": 59,
      "half": "右",
      "leaf": "十七下",
      "column_from_right": 5,
      "start_codepoint": 458,
      "end_codepoint": 479,
      "text": "壯頗愛斯文舍咀之間倐焉疲暮不及後進誠非一人"
    },
    {
      "column": "59R06",
      "pdf_page": 59,
      "half": "右",
      "leaf": "十七下",
      "column_from_right": 6,
      "start_codepoint": 479,
      "end_codepoint": 500,
      "text": "擅美推能實歸吾子遲比閑日清覯乃申筠為文能壓"
    },
    {
      "column": "59R07",
      "pdf_page": 59,
      "half": "右",
      "leaf": "十七下",
      "column_from_right": 7,
      "start_codepoint": 500,
      "end_codepoint": 521,
      "text": "強韻每公宴並作辭必妍美約常從容啓高祖曰晚來"
    },
    {
      "column": "59R08",
      "pdf_page": 59,
      "half": "右",
      "leaf": "十七下",
      "column_from_right": 8,
      "start_codepoint": 521,
      "end_codepoint": 542,
      "text": "名家惟見王筠獨步累遷太子洗馬中舍人並掌東宮"
    },
    {
      "column": "59R09",
      "pdf_page": 59,
      "half": "右",
      "leaf": "十七下",
      "column_from_right": 9,
      "start_codepoint": 542,
      "end_codepoint": 563,
      "text": "管記昭明太子愛文學士常與筠及劉孝綽陸倕到洽"
    },
    {
      "column": "59R10",
      "pdf_page": 59,
      "half": "右",
      "leaf": "十七下",
      "column_from_right": 10,
      "start_codepoint": 563,
      "end_codepoint": 584,
      "text": "殷芸等遊宴玄圃太子獨執筠袖撫孝綽肩而言曰所"
    },
    {
      "column": "59L01",
      "pdf_page": 59,
      "half": "左",
      "leaf": "十八上",
      "column_from_right": 1,
      "start_codepoint": 584,
      "end_codepoint": 605,
      "text": "謂左把浮丘袖右拍洪崖肩其見重如此筠又與殷芸"
    },
    {
      "column": "59L02",
      "pdf_page": 59,
      "half": "左",
      "leaf": "十八上",
      "column_from_right": 2,
      "start_codepoint": 605,
      "end_codepoint": 626,
      "text": "以方雅見禮焉出為丹陽尹丞北中郎諮議參軍遷中"
    },
    {
      "column": "59L03",
      "pdf_page": 59,
      "half": "左",
      "leaf": "十八上",
      "column_from_right": 3,
      "start_codepoint": 626,
      "end_codepoint": 647,
      "text": "書郎奉勅製開善寺寶誌大師碑文詞甚麗逸又勅撰"
    },
    {
      "column": "59L04",
      "pdf_page": 59,
      "half": "左",
      "leaf": "十八上",
      "column_from_right": 4,
      "start_codepoint": 647,
      "end_codepoint": 668,
      "text": "中書表奏三十卷及所上賦頌都為一集俄兼寧遠湘"
    },
    {
      "column": "59L05",
      "pdf_page": 59,
      "half": "左",
      "leaf": "十八上",
      "column_from_right": 5,
      "start_codepoint": 668,
      "end_codepoint": 689,
      "text": "東王長史行府國郡事除太子家令復掌管記普通元"
    },
    {
      "column": "59L06",
      "pdf_page": 59,
      "half": "左",
      "leaf": "十八上",
      "column_from_right": 6,
      "start_codepoint": 689,
      "end_codepoint": 710,
      "text": "年以母憂去職筠有孝性毀瘠過禮服闋後疾廢久之"
    },
    {
      "column": "59L07",
      "pdf_page": 59,
      "half": "左",
      "leaf": "十八上",
      "column_from_right": 7,
      "start_codepoint": 710,
      "end_codepoint": 731,
      "text": "六年除尚書吏部郎遷太子中庶子領羽林監又改領"
    },
    {
      "column": "59L08",
      "pdf_page": 59,
      "half": "左",
      "leaf": "十八上",
      "column_from_right": 8,
      "start_codepoint": 731,
      "end_codepoint": 752,
      "text": "步兵中大通二年遷司徒左長史三年昭明太子薨勅"
    },
    {
      "column": "59L09",
      "pdf_page": 59,
      "half": "左",
      "leaf": "十八上",
      "column_from_right": 9,
      "start_codepoint": 752,
      "end_codepoint": 773,
      "text": "為哀策文復見嗟賞尋出為貞威將軍臨海太守在郡"
    },
    {
      "column": "59L10",
      "pdf_page": 59,
      "half": "左",
      "leaf": "十八上",
      "column_from_right": 10,
      "start_codepoint": 773,
      "end_codepoint": 794,
      "text": "被訟不調累年大同初起為雲麾豫章王長史遷秘書"
    },
    {
      "column": "60R01",
      "pdf_page": 60,
      "half": "右",
      "leaf": "十八下",
      "column_from_right": 1,
      "start_codepoint": 794,
      "end_codepoint": 815,
      "text": "監五年除太府卿明年遷度支尚書中大同元年出為"
    },
    {
      "column": "60R02",
      "pdf_page": 60,
      "half": "右",
      "leaf": "十八下",
      "column_from_right": 2,
      "start_codepoint": 815,
      "end_codepoint": 836,
      "text": "明威將軍永嘉太守以疾固辭徙為光祿大夫俄遷雲"
    },
    {
      "column": "60R03",
      "pdf_page": 60,
      "half": "右",
      "leaf": "十八下",
      "column_from_right": 3,
      "start_codepoint": 836,
      "end_codepoint": 857,
      "text": "騎將軍司徒左長史太清二年侯景寇逼筠時不入城"
    },
    {
      "column": "60R04",
      "pdf_page": 60,
      "half": "右",
      "leaf": "十八下",
      "column_from_right": 4,
      "start_codepoint": 857,
      "end_codepoint": 878,
      "text": "明年太宗卽位為太子詹事筠舊宅先為賊所焚乃寓"
    },
    {
      "column": "60R05",
      "pdf_page": 60,
      "half": "右",
      "leaf": "十八下",
      "column_from_right": 5,
      "start_codepoint": 878,
      "end_codepoint": 899,
      "text": "居國子祭酒蕭子雲宅夜忽有盜攻之驚懼墜井卒時"
    },
    {
      "column": "60R06",
      "pdf_page": 60,
      "half": "右",
      "leaf": "十八下",
      "column_from_right": 6,
      "start_codepoint": 899,
      "end_codepoint": 920,
      "text": "年六十九家人十餘人同遇害筠狀貌寢小長不滿六"
    },
    {
      "column": "60R07",
      "pdf_page": 60,
      "half": "右",
      "leaf": "十八下",
      "column_from_right": 7,
      "start_codepoint": 920,
      "end_codepoint": 941,
      "text": "尺性弘厚不以藝能高人而少擅才名與劉孝綽見重"
    },
    {
      "column": "60R08",
      "pdf_page": 60,
      "half": "右",
      "leaf": "十八下",
      "column_from_right": 8,
      "start_codepoint": 941,
      "end_codepoint": 962,
      "text": "當世其自序曰余少好書老而彌篤雖遇見瞥觀皆卽"
    },
    {
      "column": "60R09",
      "pdf_page": 60,
      "half": "右",
      "leaf": "十八下",
      "column_from_right": 9,
      "start_codepoint": 962,
      "end_codepoint": 983,
      "text": "疏記後重省覽懽興彌深習與性成不覺筆倦自年十"
    },
    {
      "column": "60R10",
      "pdf_page": 60,
      "half": "右",
      "leaf": "十八下",
      "column_from_right": 10,
      "start_codepoint": 983,
      "end_codepoint": 1004,
      "text": "三四齊建武二年乙亥至梁大同六年四十載矣幼年"
    },
    {
      "column": "60L01",
      "pdf_page": 60,
      "half": "左",
      "leaf": "十九上",
      "column_from_right": 1,
      "start_codepoint": 1004,
      "end_codepoint": 1025,
      "text": "讀五經皆七八十遍愛左氏春秋吟諷常為口實廣略"
    },
    {
      "column": "60L02",
      "pdf_page": 60,
      "half": "左",
      "leaf": "十九上",
      "column_from_right": 2,
      "start_codepoint": 1025,
      "end_codepoint": 1046,
      "text": "去取凡三過五抄餘經及周官儀禮國語爾雅山海經"
    },
    {
      "column": "60L03",
      "pdf_page": 60,
      "half": "左",
      "leaf": "十九上",
      "column_from_right": 3,
      "start_codepoint": 1046,
      "end_codepoint": 1067,
      "text": "本草並再抄子史諸集皆一遍未嘗倩人假手並躬自"
    },
    {
      "column": "60L04",
      "pdf_page": 60,
      "half": "左",
      "leaf": "十九上",
      "column_from_right": 4,
      "start_codepoint": 1067,
      "end_codepoint": 1088,
      "text": "抄錄大小百餘卷不足傳之好事蓋以備遺忘而已又"
    },
    {
      "column": "60L05",
      "pdf_page": 60,
      "half": "左",
      "leaf": "十九上",
      "column_from_right": 5,
      "start_codepoint": 1088,
      "end_codepoint": 1109,
      "text": "與諸兒書論家世集云史傳稱安平崔氏及汝南應氏"
    },
    {
      "column": "60L06",
      "pdf_page": 60,
      "half": "左",
      "leaf": "十九上",
      "column_from_right": 6,
      "start_codepoint": 1109,
      "end_codepoint": 1130,
      "text": "並累世有文才所以范蔚宗世擅雕龍然不過父子兩"
    },
    {
      "column": "60L07",
      "pdf_page": 60,
      "half": "左",
      "leaf": "十九上",
      "column_from_right": 7,
      "start_codepoint": 1130,
      "end_codepoint": 1151,
      "text": "三世耳非有七葉之中名德重光爵位相繼人人有集"
    },
    {
      "column": "60L08",
      "pdf_page": 60,
      "half": "左",
      "leaf": "十九上",
      "column_from_right": 8,
      "start_codepoint": 1151,
      "end_codepoint": 1172,
      "text": "如吾門世者也沈少傅約語人云吾少好百家之言身"
    },
    {
      "column": "60L09",
      "pdf_page": 60,
      "half": "左",
      "leaf": "十九上",
      "column_from_right": 9,
      "start_codepoint": 1172,
      "end_codepoint": 1193,
      "text": "為四代之史自開闢已來未有爵位蟬聯文才相繼如"
