  "narrative_items": [
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xiewan-p001",
        "start": 72,
        "end": 84,
        "quote": "其旨以處者為優，出者為劣"
      },
      "interpretation": "其旨指《八賢論》，隱者、出仕者是文中兩類。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xiewan-p001",
        "start": 107,
        "end": 117,
        "quote": "嘗與蔡系送客於征虜亭"
      },
      "interpretation": "送別在征虜亭，蔡系與萬相戲。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xiewan-p002",
        "start": 0,
        "end": 16,
        "quote": "弱冠，辟司徒掾，遷右西屬，不就。"
      },
      "interpretation": "不就與右西屬相接，前職是否實任未明，弱冠無具體年齡。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xiewan-p002",
        "start": 16,
        "end": 34,
        "quote": "簡文帝作相，聞其名，召為撫軍從事中郎"
      },
      "interpretation": "簡文帝為追稱，在事件時作相。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xiewan-p002",
        "start": 60,
        "end": 77,
        "quote": "太原王述，萬之妻父也，為揚州刺史。"
      },
      "interpretation": "王述是萬的岳父。無名妻可定位為王述女，太原是王述地稱。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xiewan-p002",
        "start": 155,
        "end": 163,
        "quote": "王羲之與桓溫箋曰"
      },
      "interpretation": "王羲之致桓溫，評論謝萬任用；引語非萬自評。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xiewan-p003",
        "start": 24,
        "end": 29,
        "quote": "兄安深憂之"
      },
      "interpretation": "謝安是萬之兄；之可指其人或萬不撫眾事。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xiewan-p003",
        "start": 114,
        "end": 143,
        "quote": "既而先遣征虜將軍劉建修治馬頭城池，自率眾入渦潁，以援洛陽。"
      },
      "interpretation": "劉建奉命治馬頭城池，謝萬自率眾入渦潁援洛陽。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xiewan-p003",
        "start": 143,
        "end": 156,
        "quote": "北中郎將郗曇以疾病退還彭城"
      },
      "interpretation": "郗曇病還，萬誤以為賊盛而退。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-079-xielang-family:exp-xiewan-p003",
        "start": 180,
        "end": 208,
        "quote": "廢為庶人。後復以為散騎常侍，會卒，時年四十二，因以為贈。"
      },
      "interpretation": "萬免為庶人，復授散騎常侍時遇卒，原官改贈，報齡四十二。卒年月無載。"
    }
  ],
