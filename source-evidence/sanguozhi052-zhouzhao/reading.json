  "source_clauses": [
    {
      "witness": "sg",
      "quote": "顧豫章、諸葛使君、歩丞相、嚴衞尉、張奮威之爲美也。",
      "raw_start": 13863,
      "raw_end": 13888,
      "raw_line": 116
    },
    {
      "witness": "sg",
      "quote": "叔嗣雖親貴，言憂其敗，蔡文至雖疏賤，談稱其賢。",
      "raw_start": 14424,
      "raw_end": 14447,
      "raw_line": 118
    },
    {
      "witness": "sg",
      "quote": "休字叔嗣，弱冠",
      "raw_start": 3915,
      "raw_end": 3922,
      "raw_line": 36
    },
    {
      "witness": "sg",
      "quote": "承言終敗諸葛氏者，元遜也。",
      "raw_start": 3736,
      "raw_end": 3749,
      "raw_line": 32
    },
    {
      "witness": "sg",
      "quote": "款字文德，历位内外",
      "raw_start": 3637,
      "raw_end": 3646,
      "raw_line": 32
    },
    {
      "witness": "sg",
      "quote": "後爲濡須都督、奮威將軍",
      "raw_start": 3558,
      "raw_end": 3569,
      "raw_line": 32
    },
    {
      "witness": "sg",
      "quote": "下詔書賜休死，時年四十一。",
      "raw_start": 4164,
      "raw_end": 4177,
      "raw_line": 36
    },
    {
      "witness": "s53",
      "quote": "及橫江將軍魯肅卒，權以畯代肅，督兵萬人，鎮據陸口。",
      "raw_start": 3090,
      "raw_end": 3115,
      "raw_line": 21
    },
    {
      "witness": "s53",
      "quote": "更差韋曜、周昭、薛瑩、梁廣及臣五人",
      "raw_start": 8104,
      "raw_end": 8121,
      "raw_line": 66
    },
    {
      "witness": "s54",
      "quote": "肅初住江陵，後下屯陸口",
      "raw_start": 8061,
      "raw_end": 8072,
      "raw_line": 53
    },
    {
      "witness": "s65",
      "quote": "曜本名昭，史爲晉諱，改之。",
      "raw_start": 3970,
      "raw_end": 3983,
      "raw_line": 42
    },
    {
      "witness": "sk",
      "quote": "文叔嗣二字當作元遜蔡文至即蔡欵呉錄云欵字",
      "raw_start": 946,
      "raw_end": 966,
      "raw_line": 32
    }
  ],
