  "boundary_decisions": [
    {
      "raw_line": 16,
      "line_start": 29,
      "line_end": 49,
      "raw_start": 573,
      "raw_end": 593,
      "quote": "庶生衡陽元王道度、始安貞王道生，后生太祖",
      "note": "宣帝親子與陳后所生。"
    },
    {
      "raw_line": 21,
      "line_start": 249,
      "line_end": 278,
      "raw_start": 1292,
      "raw_end": 1321,
      "quote": "壽之子興道司徒屬，文蔚豫章內史，義徽光祿大夫，義倫通直郎。",
      "note": "傳末列壽之四子名、官；各在本段有父子及官職原句。"
    },
    {
      "raw_line": 26,
      "line_start": 3,
      "line_end": 12,
      "raw_start": 1398,
      "raw_end": 1407,
      "quote": "豫章王妃庾氏為娣姒",
      "note": "庾妃為裴后傳中的娣姒，《南史》另有附敘。"
    },
    {
      "raw_line": 28,
      "line_start": 70,
      "line_end": 99,
      "raw_start": 1611,
      "raw_end": 1640,
      "quote": "羊貴嬪居昭陽殿西，范貴妃居昭陽殿東，寵姬荀昭華居鳳華柏殿。",
      "note": "記宮殿居處，三人各隨居所出現。"
    },
    {
      "raw_line": 30,
      "line_start": 140,
      "line_end": 152,
      "raw_start": 1905,
      "raw_end": 1917,
      "quote": "世祖以為博士，教六宮書學",
      "note": "韓藺英從獻賦至入宮教書，自成一則附敘。"
    },
    {
      "raw_line": 35,
      "line_start": 379,
      "line_end": 386,
      "raw_start": 2356,
      "raw_end": 2363,
      "quote": "兄晃義興太守。",
      "note": "傳末所列兄、官，與前文「兄昺」分別存證。"
    },
    {
      "raw_line": 40,
      "line_start": 38,
      "line_end": 46,
      "raw_start": 2516,
      "raw_end": 2524,
      "quote": "珉之又與帝相愛褻",
      "note": "本段為何后敘事。《南史》卷十一另敘楊氏出身與死亡。"
    },
    {
      "raw_line": 49,
      "line_start": 60,
      "line_end": 67,
      "raw_start": 2836,
      "raw_end": 2843,
      "quote": "黃淑儀生太子誦",
      "note": "齊書下接東昏被廢，數位校記引南史另有太子先卒及所廢者的異文。"
    }
  ],
