      "sha256": "d5a3b8f8197bbc12b4dd45f1a024442f8d175084bed83e3c988393228970e572",
      "note": "鄭太即鄭泰，本段字公業。"
    },
    {
      "path": "source-evidence/nanshi022-wangci/external/houhan70-ws2589948.wikitext",
      "revision": 2589948,
      "line": 10,
      "start": 81,
      "quote": "有田四百頃，而食常不足",
      "sha256": "d5a3b8f8197bbc12b4dd45f1a024442f8d175084bed83e3c988393228970e572",
      "note": "騫所引田數。"
    },
    {
      "path": "source-evidence/nanshi022-wangci/external/qi1-ws1966967.wikitext",
      "revision": 1966967,
      "line": 10,
      "start": 0,
      "quote": "太祖高皇帝諱道成",
      "sha256": "6ea85baa24a785eaac59734fcab60b507a5d9e3456312999522621cb811ff8ed",
      "note": "偏諱成。"
    },
    {
      "path": "source-evidence/nanshi022-wangci/external/yulan0821-ws2588152.wikitext",
      "revision": 2588152,
      "line": 104,
      "start": 24,
      "quote": "有舊田在鍾山八十頃，與諸兒及故舊共佃之",
      "sha256": "53bf013aaad96e36f785ac911093a67dadf0a202526a3a242483d4a8462a3ce6",
      "note": "御覽引齊書省餘，諸兒與南本諸宅有別。"
    },
    {
      "path": "source-evidence/nanshi022-wangci/external/yulan0821-ws2588152.wikitext",
      "revision": 2588152,
      "line": 104,
      "start": 57,
      "quote": "有田四百畆而食常不周",
      "sha256": "53bf013aaad96e36f785ac911093a67dadf0a202526a3a242483d4a8462a3ce6",
      "note": "引齊書以畆作單位；南本與後漢書均作頃。"
    },
    {
      "path": "source-evidence/nanshi022-wangci/external/liang41-ws1512987.wikitext",
      "revision": 1512987,
      "line": 11,
      "start": 26,
      "quote": "父騫，金紫光祿大夫南昌安侯",
      "sha256": "c19683a05200034bc5e35a92e79d390e2653d9c6f94cc021e06719a6062a0e4f",
      "note": "王規父及封諡。"
    },
    {
      "path": "source-evidence/nanshi022-wangci/external/liang021-ws1544250.wikitext",
      "revision": 1544250,
      "line": 44,
      "start": 14,
      "quote": "父儉，齊太尉，南昌文憲公",
      "sha256": "d547d5b8e194f36e62b748cdfb6f18366378bb372ffb8d5b82e721ca2ccb3fab",
      "note": "暕父儉。"
    },
    {
      "path": "source-evidence/nanshi022-wangci/external/liang07-ws1566494.wikitext",
      "revision": 1566494,
      "line": 35,
      "start": 2,
      "quote": "太宗簡皇后王氏，諱靈賓",
      "sha256": "21670cf990a423b37ee0c2c543213171ea42439e787c2dd671af5f6868b47e3d",
      "note": "本篇早傳為王靈賓本傳附敘其父。"
    },
    {
      "path": "source-evidence/nanshi022-wangci/external/liang07-ws1566494.wikitext",
      "revision": 1566494,
      "line": 37,
      "start": 10,
      "quote": "叔父暕見之曰",
      "sha256": "21670cf990a423b37ee0c2c543213171ea42439e787c2dd671af5f6868b47e3d",
      "note": "靈賓與規同稱暕為叔父。"
    },
    {
      "path": "source-evidence/nanshi022-wangci/external/liang07-ws1566494.wikitext",
      "revision": 1566494,
      "line": 39,
      "start": 2,
      "quote": "父騫，字思寂，本名玄成，與齊高帝偏諱同",
      "sha256": "21670cf990a423b37ee0c2c543213171ea42439e787c2dd671af5f6868b47e3d",
      "note": "梁書作本名，南史作本字，勿自定。"
    },
    {
      "path": "source-evidence/nanshi022-wangci/external/liang07-ws1566494.wikitext",
      "revision": 1566494,
      "line": 39,
      "start": 41,
      "quote": "襲封南昌縣公",
      "sha256": "21670cf990a423b37ee0c2c543213171ea42439e787c2dd671af5f6868b47e3d",
      "note": "受禪前為公。"
    },
    {
      "path": "source-evidence/nanshi022-wangci/external/liang07-ws1566494.wikitext",
      "revision": 1566494,
      "line": 45,
      "start": 2,
      "quote": "{{YL|普通三年}}十月卒，時年四十九",
      "sha256": "21670cf990a423b37ee0c2c543213171ea42439e787c2dd671af5f6868b47e3d",
      "note": "補陰曆十月；南本無月。"
    },
    {
      "path": "source-evidence/nanshi022-wangci/external/liang07-ws1566494.wikitext",
      "revision": 1566494,
      "line": 45,
      "start": 39,
      "quote": "子規襲爵",
      "sha256": "21670cf990a423b37ee0c2c543213171ea42439e787c2dd671af5f6868b47e3d",
      "note": "王規襲爵。"
    },
    {
      "path": "sources/nanshi/nanshi022-ws1477957.wikitext",
      "revision": 1477957,
      "line": 56,
      "start": 85,
      "quote": "長子騫嗣",
      "sha256": "1fba4fa3cd43161db40d91f7330cd6cf685052cfaadb90d0a90869fd5ef3fa94",
      "note": "留在已收王儉篇末，不重算為本傳正文。"
    }
  ],
