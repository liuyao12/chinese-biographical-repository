  "embedded_units": [],
  "sentence_readings": [
    {
      "paragraph_id": "c-nanshi-022-wangqian:p001",
      "first_line": 60,
      "start": 0,
      "end": 22,
      "surface": "騫字思寂，本字玄成，與齊高帝偏諱同，故改焉。",
      "interpretation": "始字、改字。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangqian:p001",
      "first_line": 60,
      "start": 22,
      "end": 39,
      "surface": "性凝簡，慕樂廣為人，未嘗言人之短。",
      "interpretation": "性情、所慕。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangqian:p001",
      "first_line": 60,
      "start": 39,
      "end": 73,
      "surface": "諸女子侄皆嬪王尚主，朔望來歸，輜軿填咽，非所欲也，敕歲中不過一再見。",
      "interpretation": "家族婚姻與來歸、限制。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangqian:p001",
      "first_line": 60,
      "start": 73,
      "end": 102,
      "surface": "嘗從容謂諸子曰：「吾家本素族，自可依流平進，不須苟求也。」",
      "interpretation": "向諸子自述。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangqian:p001",
      "first_line": 60,
      "start": 102,
      "end": 113,
      "surface": "曆黃門郎、司徒右長史。",
      "interpretation": "二官。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangqian:p001",
      "first_line": 60,
      "start": 113,
      "end": 139,
      "surface": "不事產業，有舊墅在鍾山八十餘頃，與諸宅及故舊共佃之。",
      "interpretation": "舊墅與共佃。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangqian:p001",
      "first_line": 60,
      "start": 139,
      "end": 169,
      "surface": "常謂人曰：「我不如鄭公業有田四百頃，而食常不周。」以此為愧。",
      "interpretation": "鄭公業田數的譬喻。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangqian:p001",
      "first_line": 60,
      "start": 169,
      "end": 181,
      "surface": "永元末，召為侍中，不拜。",
      "interpretation": "召而不拜。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangqian:p001",
      "first_line": 60,
      "start": 181,
      "end": 197,
      "surface": "三年春，枉矢晝見西方，長十餘丈。",
      "interpretation": "天象、方位、長度。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangqian:p001",
      "first_line": 60,
      "start": 197,
      "end": 211,
      "surface": "騫曰：「此除舊佈新之象也。」",
      "interpretation": "釋兆。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangqian:p001",
      "first_line": 60,
      "start": 211,
      "end": 232,
      "surface": "及梁武起兵，騫曰：「天時人事，其在此乎。」",
      "interpretation": "起兵及騫評。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangqian:p001",
      "first_line": 60,
      "start": 232,
      "end": 252,
      "surface": "梁武霸府建，引為大司馬諮議參軍，遷侍中。",
      "interpretation": "霸府遷官。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangqian:p001",
      "first_line": 60,
      "start": 252,
      "end": 262,
      "surface": "及帝受禪，降封為侯。",
      "interpretation": "受禪降侯。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangqian:p001",
      "first_line": 60,
      "start": 262,
      "end": 273,
      "surface": "歷位度支尚書，中書令。",
      "interpretation": "兩官。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangqian:p001",
      "first_line": 60,
      "start": 273,
      "end": 300,
      "surface": "武帝於鍾山西造大愛敬寺，騫舊墅在寺側者，即王導賜田也。",
      "interpretation": "靈寺、導賜田。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangqian:p001",
      "first_line": 60,
      "start": 300,
      "end": 317,
      "surface": "帝遣主書宣旨，就騫市之，欲以施寺。",
      "interpretation": "傳命購田。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangqian:p001",
      "first_line": 60,
      "start": 317,
      "end": 336,
      "surface": "答云：「此田不賣；若敕取，所不敢言。」",
      "interpretation": "騫拒賣。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangqian:p001",
      "first_line": 60,
      "start": 336,
      "end": 358,
      "surface": "酬對又脫略。帝怒，遂付市評田價，以直逼還之。",
      "interpretation": "帝怒估價。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangqian:p001",
      "first_line": 60,
      "start": 358,
      "end": 370,
      "surface": "由是忤旨，出為吳興太守。",
      "interpretation": "出守吳興。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangqian:p002",
      "first_line": 62,
      "start": 0,
      "end": 17,
      "surface": "騫性侈於味而儉於服，頗以多忌為累。",
      "interpretation": "飲食、衣著與多忌。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangqian:p002",
      "first_line": 62,
      "start": 17,
      "end": 35,
      "surface": "又惰於接物，雖主書宣敕，或過時不見。",
      "interpretation": "不見宣敕者。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangqian:p002",
      "first_line": 62,
      "start": 35,
      "end": 54,
      "surface": "才望不及弟暕，特以儉之嫡，故不棄于時。",
      "interpretation": "弟暕及儉嫡。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangqian:p002",
      "first_line": 62,
      "start": 54,
      "end": 88,
      "surface": "暕為尚書左丞僕射，當朝用事，騫自中書令為郡，邑邑不樂，在郡臥不視事。",
      "interpretation": "弟用事而兄臥郡。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangqian:p002",
      "first_line": 62,
      "start": 88,
      "end": 107,
      "surface": "征復為度支尚書，加給事中，領射聲校尉。",
      "interpretation": "復任、加領。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangqian:p002",
      "first_line": 62,
      "start": 107,
      "end": 113,
      "surface": "以母憂去職。",
      "interpretation": "服喪去職。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangqian:p002",
      "first_line": 62,
      "start": 113,
      "end": 124,
      "surface": "普通三年卒，年四十九。",
      "interpretation": "卒年及報齡。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangqian:p002",
      "first_line": 62,
      "start": 124,
      "end": 139,
      "surface": "贈侍中、金紫光祿大夫，諡曰安。",
      "interpretation": "贈官與諡。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangqian:p002",
      "first_line": 62,
      "start": 139,
      "end": 142,
      "surface": "子規。",
      "interpretation": "子名。"
    }
  ]
}
