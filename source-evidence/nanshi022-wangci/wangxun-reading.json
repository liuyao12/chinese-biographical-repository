  "embedded_units": [],
  "sentence_readings": [
    {
      "paragraph_id": "c-nanshi-022-wangxun:p001",
      "first_line": 86,
      "start": 0,
      "end": 20,
      "surface": "訓字懷範，生而紫胞，師媼云：「法當貴」。",
      "interpretation": "字、生事、師媼。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangxun:p001",
      "first_line": 86,
      "start": 20,
      "end": 66,
      "surface": "幼聰警，有識量，僧正惠超見而奇之，謂門人羅智國曰：「四郎眉目疏朗，舉動和韻，此是興門戶者。」",
      "interpretation": "惠超稱許。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangxun:p001",
      "first_line": 86,
      "start": 66,
      "end": 88,
      "surface": "智國以白暕，暕亦曰：「不墜基業，其在文殊。」",
      "interpretation": "門人轉告父。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangxun:p001",
      "first_line": 86,
      "start": 88,
      "end": 96,
      "surface": "文殊，訓小字也。",
      "interpretation": "小字。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangxun:p001",
      "first_line": 86,
      "start": 96,
      "end": 111,
      "surface": "年十三，暕亡，憂毀，家人莫識。",
      "interpretation": "父喪。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangxun:p001",
      "first_line": 86,
      "start": 111,
      "end": 144,
      "surface": "十六召見文德殿，應對爽徹，上目送久之，謂朱異曰：「可謂相門有相。」",
      "interpretation": "召見與梁武語。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangxun:p001",
      "first_line": 86,
      "start": 144,
      "end": 156,
      "surface": "初補國子生，問說師袁昂。",
      "interpretation": "國子生。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangxun:p001",
      "first_line": 86,
      "start": 156,
      "end": 181,
      "surface": "昂曰：「久籍高名，有勞虛想，及觀容止，若披雲霧。」",
      "interpretation": "袁昂對訓。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangxun:p001",
      "first_line": 86,
      "start": 181,
      "end": 216,
      "surface": "俄而諸袁子弟來，昂謂諸助教曰：「我兒出十數，若有一子如此，實無所恨。」",
      "interpretation": "袁氏子弟與助教。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangxun:p001",
      "first_line": 86,
      "start": 216,
      "end": 230,
      "surface": "射策，除秘書郎，累遷秘書丞。",
      "interpretation": "射策任官。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangxun:p001",
      "first_line": 86,
      "start": 230,
      "end": 256,
      "surface": "嘗賦詩云：「旦奭匡世功，蕭曹佐甿俗。」追祖儉之志也。",
      "interpretation": "四相典故與祖志。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangxun:p002",
      "first_line": 88,
      "start": 0,
      "end": 10,
      "surface": "後拜侍中，入見武帝。",
      "interpretation": "入見。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangxun:p002",
      "first_line": 88,
      "start": 10,
      "end": 13,
      "surface": "帝問何",
      "interpretation": "問淵作相之年。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangxun:p002",
      "first_line": 88,
      "start": 13,
      "end": 39,
      "surface": "敬容曰：「褚彥回年幾為宰相？」敬容曰：「少過三十。」",
      "interpretation": "答。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangxun:p002",
      "first_line": 88,
      "start": 39,
      "end": 54,
      "surface": "上曰：「今之王訓，無謝彥回。」",
      "interpretation": "許訓可比淵。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangxun:p002",
      "first_line": 88,
      "start": 54,
      "end": 71,
      "surface": "訓美容儀，善進止，文章為後進領袖。",
      "interpretation": "文儀。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangxun:p002",
      "first_line": 88,
      "start": 71,
      "end": 82,
      "surface": "年二十六，卒，諡溫子。",
      "interpretation": "卒齡、諡。"
    }
  ]
}
