  "sentence_readings": [
    {
      "paragraph_id": "c-nanshi-022-wangtai:p001",
      "first_line": 134,
      "start": 0,
      "end": 9,
      "surface": "泰字仲通，幼敏悟。",
      "interpretation": "表字、幼敏。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangtai:p001",
      "first_line": 134,
      "start": 9,
      "end": 27,
      "surface": "年數歲時，祖母集諸孫侄，散棗栗於床，",
      "interpretation": "祖母分棗栗。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangtai:p001",
      "first_line": 134,
      "start": 27,
      "end": 37,
      "surface": "群兒競之，泰獨不取。",
      "interpretation": "泰與群兒。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangtai:p001",
      "first_line": 134,
      "start": 37,
      "end": 53,
      "surface": "問其故，對曰：「不取自當得賜。」",
      "interpretation": "問者未署、應者泰。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangtai:p001",
      "first_line": 134,
      "start": 53,
      "end": 60,
      "surface": "由是中表異之。",
      "interpretation": "親族異之。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangtai:p001",
      "first_line": 134,
      "start": 60,
      "end": 73,
      "surface": "少好學，手所抄寫二千許卷。",
      "interpretation": "抄寫約數。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangtai:p001",
      "first_line": 134,
      "start": 73,
      "end": 90,
      "surface": "及長，通和溫雅，家人不見喜慍之色。",
      "interpretation": "性情與家人。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangtai:p001",
      "first_line": 134,
      "start": 90,
      "end": 103,
      "surface": "姊夫齊江夏王鋒為齊明帝害，",
      "interpretation": "鋒遭害。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangtai:p001",
      "first_line": 134,
      "start": 103,
      "end": 123,
      "surface": "外生蕭子友並孤弱，泰資給撫訓，逾于子侄。",
      "interpretation": "蕭子友等孤弱及資給。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangtai:p002",
      "first_line": 136,
      "start": 0,
      "end": 10,
      "surface": "梁天監元年為秘書丞。",
      "interpretation": "元年秘書丞。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangtai:p002",
      "first_line": 136,
      "start": 10,
      "end": 32,
      "surface": "自齊永元之末，後宮火延燒秘書，圖書散亂殆盡。",
      "interpretation": "回述齊末書火。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangtai:p002",
      "first_line": 136,
      "start": 32,
      "end": 44,
      "surface": "泰表校定繕寫，武帝從之。",
      "interpretation": "泰表校書、梁武從議。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangtai:p002",
      "first_line": 136,
      "start": 44,
      "end": 58,
      "surface": "曆中書侍郎，掌吏部，仍即真。",
      "interpretation": "吏部實授。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangtai:p002",
      "first_line": 136,
      "start": 58,
      "end": 71,
      "surface": "自過江，吏部郎不復典大選，",
      "interpretation": "過江以來選制。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangtai:p002",
      "first_line": 136,
      "start": 71,
      "end": 91,
      "surface": "令史以下，小人求競者輻湊前後，少能稱職。",
      "interpretation": "求競者及稱職情形。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangtai:p002",
      "first_line": 136,
      "start": 91,
      "end": 104,
      "surface": "泰為之，不為貴賤請屬易意，",
      "interpretation": "泰不移選意。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangtai:p002",
      "first_line": 136,
      "start": 104,
      "end": 109,
      "surface": "天下稱平。",
      "interpretation": "公論。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangtai:p002",
      "first_line": 136,
      "start": 109,
      "end": 130,
      "surface": "轉黃門侍郎，每預朝宴，刻燭賦詩，文不加點，",
      "interpretation": "官與朝宴詩。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangtai:p002",
      "first_line": 136,
      "start": 130,
      "end": 135,
      "surface": "帝深賞歎。",
      "interpretation": "梁武賞歎。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangtai:p002",
      "first_line": 136,
      "start": 135,
      "end": 154,
      "surface": "沈約常曰：「王有養、炬，謝有覽、舉。」",
      "interpretation": "具名引語。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangtai:p002",
      "first_line": 136,
      "start": 154,
      "end": 167,
      "surface": "養，泰小字，炬，筠小字也。",
      "interpretation": "南本各定兩人小字。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangtai:p003",
      "first_line": 138,
      "start": 0,
      "end": 24,
      "surface": "始革大理，以泰為廷尉卿，再曆侍中，後為都官尚書。",
      "interpretation": "大理與廷尉、兩次侍中及都官。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangtai:p003",
      "first_line": 138,
      "start": 24,
      "end": 38,
      "surface": "泰能接人士，故每願其居選官。",
      "interpretation": "眾願泰掌選舉。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangtai:p003",
      "first_line": 138,
      "start": 38,
      "end": 52,
      "surface": "頃之，為吏部尚書，衣冠屬望。",
      "interpretation": "吏部尚書及衣冠期待。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangtai:p003",
      "first_line": 138,
      "start": 52,
      "end": 73,
      "surface": "未及選舉，仍疾，改除散騎常侍、左驍騎將軍，",
      "interpretation": "疾病、改兩官。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangtai:p003",
      "first_line": 138,
      "start": 73,
      "end": 81,
      "surface": "未拜，卒，諡夷。",
      "interpretation": "未拜、本傳卒、諡。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangtai:p003",
      "first_line": 138,
      "start": 81,
      "end": 84,
      "surface": "子廓。",
      "interpretation": "子廓。"
    }
  ],
  "unassigned": [
    "不取者泰，問者原文未署，不確立為祖母。祖母、中表、家人等均依正文。",
    "齊江夏王鋒的姊妻即慈女；外生蕭子友可知為泰外甥，本句不明書生父及生母姓名，未填親子雙端。",
    "過江是時代背景；二千許卷是數量；少能稱職是「少有」。",
