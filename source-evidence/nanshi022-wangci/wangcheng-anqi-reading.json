      "paragraph_id": "c-nanshi-022-wangcheng-anqi:p001",
      "first_line": 84,
      "start": 26,
      "end": 53,
      "surface": "時膏腴貴遊，咸以文學相尚，罕以經術為業；唯承獨好儒業。",
      "interpretation": "當世文學、承獨儒。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangcheng-anqi:p001",
      "first_line": 84,
      "start": 53,
      "end": 66,
      "surface": "遷長兼侍中，俄轉國子祭酒。",
      "interpretation": "官職與祭酒。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangcheng-anqi:p001",
      "first_line": 84,
      "start": 66,
      "end": 88,
      "surface": "承祖儉父暕皆為此職，三世為國師，前代未之有。",
      "interpretation": "三代祭酒。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangcheng-anqi:p001",
      "first_line": 84,
      "start": 88,
      "end": 98,
      "surface": "久之，出為東陽太守。",
      "interpretation": "出東陽。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangcheng-anqi:p001",
      "first_line": 84,
      "start": 98,
      "end": 108,
      "surface": "政存寬惠，吏人悅之。",
      "interpretation": "政績、郡民。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangcheng-anqi:p001",
      "first_line": 84,
      "start": 108,
      "end": 115,
      "surface": "卒郡，諡曰章。",
      "interpretation": "卒所及諡。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangcheng-anqi:p002",
      "first_line": 86,
      "start": 0,
      "end": 9,
      "surface": "承性簡貴，有風格。",
      "interpretation": "品性。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangcheng-anqi:p002",
      "first_line": 86,
      "start": 9,
      "end": 27,
      "surface": "右衛朱異當朝用事，每休下，車馬填門。",
      "interpretation": "朱異用事。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangcheng-anqi:p002",
      "first_line": 86,
      "start": 27,
      "end": 49,
      "surface": "有魏郡申英者，門寒才俊，好危言高論以忤權右。",
      "interpretation": "申英籍貫、門第、性情。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangcheng-anqi:p002",
      "first_line": 86,
      "start": 49,
      "end": 80,
      "surface": "嘗指異門曰：「此中輻湊，皆為利往，能不至者，唯大小王東陽耳。」",
      "interpretation": "申英對朱宅的評語。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangcheng-anqi:p002",
      "first_line": 86,
      "start": 80,
      "end": 89,
      "surface": "小東陽即承弟幼也。",
      "interpretation": "承弟幼的稱呼。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangcheng-anqi:p002",
      "first_line": 86,
      "start": 89,
      "end": 107,
      "surface": "時唯承兄弟及褚翔不至異門，世並稱之。",
      "interpretation": "史家另列褚翔。"
    }
  ]
}
