  "embedded_units": [],
  "sentence_readings": [
    {
      "paragraph_id": "c-nanshi-022-wanggui:p001",
      "first_line": 66,
      "start": 0,
      "end": 19,
      "surface": "規字威明，八歲丁所生母憂，居喪有至性。",
      "interpretation": "表字、母喪。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p001",
      "first_line": 66,
      "start": 19,
      "end": 40,
      "surface": "齊太尉徐孝嗣每見必為流涕，稱曰：「孝童」。",
      "interpretation": "徐評。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p001",
      "first_line": 66,
      "start": 40,
      "end": 63,
      "surface": "叔父暕亦深器重之，常曰：「此兒吾家千里駒也。」",
      "interpretation": "暕評。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p001",
      "first_line": 66,
      "start": 63,
      "end": 74,
      "surface": "年十二，略通五經大義，",
      "interpretation": "五經。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p001",
      "first_line": 66,
      "start": 74,
      "end": 84,
      "surface": "及長，遂博涉有口辯。",
      "interpretation": "才辯。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p001",
      "first_line": 66,
      "start": 84,
      "end": 104,
      "surface": "為本州迎主簿。起家秘書郎，累遷太子洗馬。",
      "interpretation": "初官。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p002",
      "first_line": 68,
      "start": 0,
      "end": 24,
      "surface": "天監十二年，改造太極殿畢，規獻新殿賦，其辭甚工。",
      "interpretation": "造殿及獻賦。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p002",
      "first_line": 68,
      "start": 24,
      "end": 46,
      "surface": "後為晉安王綱雲麾諮議參軍，久之，為新安太守。",
      "interpretation": "晉安府官、新安。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p002",
      "first_line": 68,
      "start": 46,
      "end": 61,
      "surface": "父憂去職，服闋，襲封南昌縣侯。",
      "interpretation": "服喪、襲爵。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p002",
      "first_line": 68,
      "start": 61,
      "end": 99,
      "surface": "除中書黃門侍郎，敕與陳郡殷芸、琅邪王錫、范陽張緬同侍東宮，俱為昭明太子所禮。",
      "interpretation": "東宮同官及太子。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p002",
      "first_line": 68,
      "start": 99,
      "end": 121,
      "surface": "湘東王繹時為丹陽尹，與朝士宴集，屬規為酒令。",
      "interpretation": "宴、命酒令。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p002",
      "first_line": 68,
      "start": 121,
      "end": 138,
      "surface": "規從容曰：「江左以來，未有茲舉。」",
      "interpretation": "規言。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p002",
      "first_line": 68,
      "start": 138,
      "end": 160,
      "surface": "特進蕭琛、金紫光祿大夫傅昭在坐，並謂為知言。",
      "interpretation": "兩人在座。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p002",
      "first_line": 68,
      "start": 160,
      "end": 174,
      "surface": "朱異嘗因酒卿規，規責以無禮。",
      "interpretation": "卿規失禮。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p003",
      "first_line": 70,
      "start": 0,
      "end": 19,
      "surface": "普通初，陳慶之北侵，陷洛陽，百僚稱慶。",
      "interpretation": "傳載洛陽役的時間與稱慶。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p003",
      "first_line": 70,
      "start": 19,
      "end": 33,
      "surface": "規退曰：「可吊也，又何賀焉。",
      "interpretation": "吊賀之辨。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p003",
      "first_line": 70,
      "start": 33,
      "end": 48,
      "surface": "道家有云：非為功難，成功難也。",
      "interpretation": "所引言。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p003",
      "first_line": 70,
      "start": 48,
      "end": 63,
      "surface": "昔桓溫得而復失，宋武竟無成功。",
      "interpretation": "桓、劉舊事。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p003",
      "first_line": 70,
      "start": 63,
      "end": 80,
      "surface": "我孤軍無援，深入寇境，將為亂階。」",
      "interpretation": "評孤軍深入。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p003",
      "first_line": 70,
      "start": 80,
      "end": 85,
      "surface": "俄見覆沒。",
      "interpretation": "結果。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p004",
      "first_line": 72,
      "start": 0,
      "end": 30,
      "surface": "六年，武帝於文德殿餞廣州刺史元景隆，詔群臣賦詩，同用五十韻。",
      "interpretation": "餞元及詩韻。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p004",
      "first_line": 72,
      "start": 30,
      "end": 52,
      "surface": "規援筆立奏，其文又美，武帝嘉焉，即日授侍中。",
      "interpretation": "賦成受官。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p004",
      "first_line": 72,
      "start": 52,
      "end": 60,
      "surface": "後為晉安王長史。",
      "interpretation": "王府長史。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p004",
      "first_line": 72,
      "start": 60,
      "end": 83,
      "surface": "王立為太子，仍為散騎常侍、太子中庶子，侍東宮。",
      "interpretation": "東宮職。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p004",
      "first_line": 72,
      "start": 83,
      "end": 102,
      "surface": "太子賜以所服貂蟬，並降令書，悅是舉也。",
      "interpretation": "貂蟬、令書。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p004",
      "first_line": 72,
      "start": 102,
      "end": 127,
      "surface": "尋為吳郡太守，主書芮珍宗家在吳，前守宰皆傾意附之。",
      "interpretation": "吳郡任與主書。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p004",
      "first_line": 72,
      "start": 127,
      "end": 153,
      "surface": "至是珍宗假還，規遇之甚薄，珍宗還都，密奏規不理郡事。",
      "interpretation": "珍宗告狀。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p004",
      "first_line": 72,
      "start": 153,
      "end": 161,
      "surface": "俄徵為左戶尚書。",
      "interpretation": "徵尚書。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p004",
      "first_line": 72,
      "start": 161,
      "end": 177,
      "surface": "郡境千餘人詣闕請留，表三奏不許。",
      "interpretation": "留任之請三奏。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p004",
      "first_line": 72,
      "start": 177,
      "end": 186,
      "surface": "求于郡樹碑，許之。",
      "interpretation": "樹碑獲允。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p005",
      "first_line": 74,
      "start": 0,
      "end": 13,
      "surface": "規常以門宗貴盛，恒思減退。",
      "interpretation": "門宗、欲退。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p005",
      "first_line": 74,
      "start": 13,
      "end": 44,
      "surface": "後為太子中庶子，領步兵校尉，辭疾不拜，遂于鍾山宋熙寺築室居焉。",
      "interpretation": "末官不拜、寺中築室。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p005",
      "first_line": 74,
      "start": 44,
      "end": 56,
      "surface": "卒，贈光祿大夫，諡曰文。",
      "interpretation": "卒、贈、諡。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p005",
      "first_line": 74,
      "start": 56,
      "end": 72,
      "surface": "皇太子出臨哭，與湘東王繹令曰：「",
      "interpretation": "臨哭致令。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p005",
      "first_line": 74,
      "start": 72,
      "end": 100,
      "surface": "王威明風韻遒上，神峰標映，千里絕跡，百尺無枝，實俊人也。",
      "interpretation": "令中評規。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p005",
      "first_line": 74,
      "start": 100,
      "end": 120,
      "surface": "一爾過隙，永歸長夜，金刀掩芒，長淮絕涸。",
      "interpretation": "哀辭。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p005",
      "first_line": 74,
      "start": 120,
      "end": 140,
      "surface": "去歲冬中，已傷劉子，今茲寒孟，復悼王生。",
      "interpretation": "兩冬所哀。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p005",
      "first_line": 74,
      "start": 140,
      "end": 151,
      "surface": "俱往之傷，信非虛說。」",
      "interpretation": "令結。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p005",
      "first_line": 74,
      "start": 151,
      "end": 168,
      "surface": "規集後漢眾家異同，注續漢書二百卷。",
      "interpretation": "史注。"
    },
    {
      "paragraph_id": "c-nanshi-022-wanggui:p005",
      "first_line": 74,
      "start": 168,
      "end": 174,
      "surface": "文集二十卷。",
      "interpretation": "文集二十卷。"
    }
  ]
}
