  "embedded_units": [],
  "sentence_readings": [
    {
      "paragraph_id": "c-nanshi-022-wangci:p001",
      "first_line": 126,
      "start": 0,
      "end": 5,
      "surface": "慈字伯寶。",
      "interpretation": "字。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangci:p001",
      "first_line": 126,
      "start": 5,
      "end": 24,
      "surface": "年八歲，外祖宋太宰江夏王義恭迎之內齋，",
      "interpretation": "外祖義恭迎外孫入齋。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangci:p001",
      "first_line": 126,
      "start": 24,
      "end": 44,
      "surface": "施寶物恣所取，慈取素琴石硯及孝子圖而已，",
      "interpretation": "選琴、硯、圖。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangci:p001",
      "first_line": 126,
      "start": 44,
      "end": 49,
      "surface": "義恭善之。",
      "interpretation": "外祖稱善。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangci:p001",
      "first_line": 126,
      "start": 49,
      "end": 69,
      "surface": "袁淑見其幼時，撫其背曰；「叔慈內潤也。」",
      "interpretation": "袁淑借荀靖舊評稱許。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangci:p002",
      "first_line": 128,
      "start": 0,
      "end": 9,
      "surface": "少與從弟儉共書學。",
      "interpretation": "與從弟共學。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangci:p002",
      "first_line": 128,
      "start": 9,
      "end": 26,
      "surface": "謝鳳子超宗嘗候僧虔，仍往東齋詣慈。",
      "interpretation": "謝氏父子、超宗先訪僧虔再詣慈。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangci:p002",
      "first_line": 128,
      "start": 26,
      "end": 36,
      "surface": "慈正學書，未即放筆，",
      "interpretation": "學書不放筆。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangci:p002",
      "first_line": 128,
      "start": 36,
      "end": 49,
      "surface": "超宗曰：「卿書何如虔公？」",
      "interpretation": "問卿和虔公書藝。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangci:p002",
      "first_line": 128,
      "start": 49,
      "end": 66,
      "surface": "慈曰：「慈書比大人，如雞之比鳳。」",
      "interpretation": "自稱慈，以大人指父。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangci:p002",
      "first_line": 128,
      "start": 66,
      "end": 73,
      "surface": "超宗狼狽而退。",
      "interpretation": "客退。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangci:p002",
      "first_line": 128,
      "start": 73,
      "end": 88,
      "surface": "十歲時，與蔡興宗子約入寺禮佛，",
      "interpretation": "與蔡氏子入寺。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangci:p002",
      "first_line": 128,
      "start": 88,
      "end": 94,
      "surface": "正遇沙門懺，",
      "interpretation": "僧懺。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangci:p002",
      "first_line": 128,
      "start": 94,
      "end": 110,
      "surface": "約戲慈曰：「眾僧今日可謂虔虔。」",
      "interpretation": "借語戲及友父。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangci:p002",
      "first_line": 128,
      "start": 110,
      "end": 129,
      "surface": "慈應聲曰：「卿如此，何以興蔡氏之宗。」",
      "interpretation": "答之亦借約父名。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangci:p002",
      "first_line": 128,
      "start": 129,
      "end": 157,
      "surface": "歷位吳郡太守，大司馬長史，侍中，領步兵校尉，司徒左長史。",
      "interpretation": "先後五官。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangci:p002",
      "first_line": 128,
      "start": 157,
      "end": 186,
      "surface": "慈患腳，齊武帝敕王晏：「慈有微疾，不能騎，聽乘車在仗後。」",
      "interpretation": "腳患、武帝詔王晏特許。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangci:p002",
      "first_line": 128,
      "start": 186,
      "end": 194,
      "surface": "江左以來少例也。",
      "interpretation": "史評少例。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangci:p003",
      "first_line": 130,
      "start": 0,
      "end": 7,
      "surface": "慈妻劉彥節女，",
      "interpretation": "婚姻與妻父。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangci:p003",
      "first_line": 130,
      "start": 7,
      "end": 29,
      "surface": "子觀尚武帝長女吳縣公主，修婦禮，姑未嘗交答。",
      "interpretation": "觀娶齊武長女，觀妻、婆母。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangci:p003",
      "first_line": 130,
      "start": 29,
      "end": 45,
      "surface": "江夏王鋒為南徐州，王妃，慈女也，",
      "interpretation": "齊江夏王及妃、妃父。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangci:p003",
      "first_line": 130,
      "start": 45,
      "end": 61,
      "surface": "以慈為東海太守，行南徐州府州事。",
      "interpretation": "東海、行南徐。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangci:p003",
      "first_line": 130,
      "start": 61,
      "end": 79,
      "surface": "還為冠軍將軍、廬陵王中軍長史，未拜，",
      "interpretation": "末除未拜。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangci:p003",
      "first_line": 130,
      "start": 79,
      "end": 85,
      "surface": "永明九年卒。",
      "interpretation": "卒年。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangci:p003",
      "first_line": 130,
      "start": 85,
      "end": 92,
      "surface": "贈太常，諡懿。",
      "interpretation": "贈官、諡。"
    },
    {
      "paragraph_id": "c-nanshi-022-wangci:p003",
      "first_line": 130,
      "start": 92,
      "end": 95,
      "surface": "子泰。",
      "interpretation": "又一子泰。"
    }
  ],
  "unassigned": [
    "大人是慈父；超宗所說卿指慈、慈對蔡約所說卿指蔡約。齊武敕令中的慈為第三人。",
    "取物者慈；「善之」也可按所為解。修婦禮者為觀妻，姑是王慈妻。未書子女生母。",
    "孝子圖是圖名；雞、鳳、虔虔、興蔡氏之宗各照語境，未使戲語變成人的別名。"
  ]
}
