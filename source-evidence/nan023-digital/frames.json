            "evidence": [
              {
                "work_id": "w-nanshi",
                "book_id": "b-nanshi-023",
                "source_id": "s-nanshi-023-wangdan-gu-yan-ws2478204",
                "chapter_id": "c-nanshi-023-wangdan-gu-yan",
