      "disposition": "deferred_appointment",
      "note": "帝為撫軍指武帝生涯；琇受命參軍事。"
    },
    {
      "paragraph_id": "c-jinshu-093-yangxiu:p001",
      "quote": "擢琇為左衛將軍",
      "start": 244,
      "end": 251,
      "disposition": "deferred_appointment",
      "note": "王位後，不填未核年份。"
    },
    {
      "paragraph_id": "c-jinshu-093-yangxiu:p001",
      "quote": "封甘露亭侯",
      "start": 252,
      "end": 257,
      "disposition": "deferred_grant",
      "note": "隨前王位後封爵；不與關內侯混。"
    },
    {
      "paragraph_id": "c-jinshu-093-yangxiu:p001",
      "quote": "累遷中護軍",
      "start": 262,
      "end": 267,
      "disposition": "deferred_office",
      "note": "帝踐阼後累遷，無確切始年。"
