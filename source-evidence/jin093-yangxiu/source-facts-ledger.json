    {
      "paragraph_id": "c-jinshu-093-yangxiu:p001",
      "quote": "參鎮西鐘會軍事",
      "start": 40,
      "end": 47,
      "disposition": "deferred_office",
      "note": "參軍事並從平蜀；鎮西是鍾會銜，不是琇。"
    },
    {
      "paragraph_id": "c-jinshu-093-yangxiu:p001",
      "quote": "賜爵關內侯",
      "start": 65,
      "end": 70,
      "disposition": "deferred_grant",
      "note": "會反諫後還賜爵，無精確年月。"
    },
    {
      "paragraph_id": "c-jinshu-093-yangxiu:p001",
      "quote": "任領護各十年",
      "start": 108,
      "end": 114,
      "disposition": "excluded_actual_tenure",
      "note": "昔日對未即帝位武帝戲言；非任領軍/護軍實任各十年。"
    },
    {
      "paragraph_id": "c-jinshu-093-yangxiu:p001",
      "quote": "及帝為撫軍，命琇參軍事",
