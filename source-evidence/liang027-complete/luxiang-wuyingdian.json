  "original_url": "https://upload.wikimedia.org/wikipedia/commons/0/09/NLC892-411999017142-12657_%E4%BA%8C%E5%8D%81%E5%9B%9B%E5%8F%B2_%E7%AC%AC166%E5%86%8A.pdf",
  "pdf_sha1": "b11514da8e27fc149ba1ddc8e42a71bd01cd4e25",
  "pdf_sha256": "82c750b714c7e5513ff512f69a324b7e8fc8cb561f255a17e664c6aac45fd932",
  "pdf_bytes": 31214377,
  "column_order": "八下第七欄至十下第九欄，自右向左。",
  "columns": [
    {
      "pdf_page": 85,
      "half": "右",
      "leaf": "八下",
      "column_from_right": 7,
      "text": "陸襄字師卿吳郡吳人也父閑齊始安王遙光揚州治"
    },
    {
      "pdf_page": 85,
      "half": "右",
      "leaf": "八下",
      "column_from_right": 8,
      "text": "中永元末遙光據東府作亂或勸閑去之閑曰吾為人"
    },
    {
      "pdf_page": 85,
      "half": "右",
      "leaf": "八下",
      "column_from_right": 9,
      "text": "吏何所逃死臺軍攻陷城閑見執將刑第二子絳求代"
    },
    {
      "pdf_page": 85,
      "half": "右",
      "leaf": "八下",
      "column_from_right": 10,
      "text": "死不獲遂以身蔽刃刑者俱害之襄痛父兄之酷喪過"
    },
    {
      "pdf_page": 85,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 1,
      "text": "于禮服釋後猶若居憂天監三年都官尚書范岫表薦"
    },
    {
      "pdf_page": 85,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 2,
      "text": "襄起家擢拜著作佐郎除永寧令秩滿累遷司空臨川"
    },
    {
      "pdf_page": 85,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 3,
      "text": "王法曹外兵輕車廬陵王記室參軍昭明太子聞襄業"
    },
    {
      "pdf_page": 85,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 4,
      "text": "行啓高祖引與遊處除太子洗馬遷中舍人並掌管記"
    },
    {
      "pdf_page": 85,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 5,
      "text": "出為揚州治中襄父終此官固辭職高祖不許聽與府"
    },
    {
      "pdf_page": 85,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 6,
      "text": "司馬換廨居之昭明太子敬耆老襄母年將八十與蕭"
    },
    {
      "pdf_page": 85,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 7,
      "text": "琛傅昭陸杲每月常遣存問加賜珍羞衣服襄母嘗卒"
    },
    {
      "pdf_page": 85,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 8,
      "text": "患心痛醫方須三升粟漿是時冬月日又逼暮求索無"
    },
    {
      "pdf_page": 85,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 9,
      "text": "所忽有老人詣門貨漿量如方劑始欲酬直無何失之"
    },
    {
      "pdf_page": 85,
      "half": "左",
      "leaf": "九上",
      "column_from_right": 10,
      "text": "時以襄孝感所致也累遷國子博士太子家令復掌管"
    },
    {
      "pdf_page": 86,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 1,
      "text": "記母憂去職襄年已五十毁頓過禮太子憂之日遣使"
    },
    {
      "pdf_page": 86,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 2,
      "text": "誡喻服闋除太子中庶子復掌管記中大通三年昭明"
    },
    {
      "pdf_page": 86,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 3,
      "text": "太子薨官屬罷妃蔡氏別居金華宮以襄為中散大夫"
    },
    {
      "pdf_page": 86,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 4,
      "text": "領步兵校尉金華宮家令知金華宮事七年出為鄱陽"
    },
    {
      "pdf_page": 86,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 5,
      "text": "內史先是郡民鮮于琛服食修道法嘗入山採藥拾得"
    },
    {
      "pdf_page": 86,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 6,
      "text": "五色幡毦又於地中得石璽竊怪之琛先與妻別室望"
    },
    {
      "pdf_page": 86,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 7,
      "text": "琛所處常有異氣益以為神大同元年遂結其門徒殺"
    },
    {
      "pdf_page": 86,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 8,
      "text": "廣晉令王筠號上願元年署置官屬其黨轉相誑惑有"
    },
    {
      "pdf_page": 86,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 9,
      "text": "衆萬餘人將出攻郡襄先已帥民吏修城隍為備禦及"
    },
    {
      "pdf_page": 86,
      "half": "右",
      "leaf": "九下",
      "column_from_right": 10,
      "text": "賊至連戰破之生獲琛餘衆逃散時鄰郡豫章安成等"
    },
    {
      "pdf_page": 86,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 1,
      "text": "守宰案治黨與因求賄貨皆不得其實或有善人盡室"
    },
    {
      "pdf_page": 86,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 2,
      "text": "離禍惟襄郡部枉直無濫民作歌曰鮮于平後善惡分"
    },
    {
      "pdf_page": 86,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 3,
      "text": "民無枉死賴有陸君又有彭李二家先因忿爭遂相誣"
    },
    {
      "pdf_page": 86,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 4,
      "text": "告襄引入內室不加責誚但和言解喻之二人感恩深"
    },
    {
      "pdf_page": 86,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 5,
      "text": "自咎悔乃為設酒食令其盡歡酒罷同載而還因相親"
    },
    {
      "pdf_page": 86,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 6,
      "text": "厚民又歌曰陸君政無怨家鬪旣罷讐共車在政六年"
    },
    {
      "pdf_page": 86,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 7,
      "text": "郡中大治民李睍等四百二十人詣闕拜表陳襄德化"
    },
    {
      "pdf_page": 86,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 8,
      "text": "求於郡立碑降勑許之又表乞留襄襄固求還徵為吏"
    },
    {
      "pdf_page": 86,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 9,
      "text": "部郎遷秘書監領揚州大中正太清元年遷度支尚書"
    },
    {
      "pdf_page": 86,
      "half": "左",
      "leaf": "十上",
      "column_from_right": 10,
      "text": "中正如故二年侯景舉兵圍宮城以襄直侍中省三年"
    },
    {
      "pdf_page": 87,
      "half": "右",
      "leaf": "十下",
      "column_from_right": 1,
      "text": "三月城陷襄逃還吳賊尋寇東境沒吳郡景將宋子仙"
    },
    {
      "pdf_page": 87,
      "half": "右",
      "leaf": "十下",
      "column_from_right": 2,
      "text": "進攻錢塘會海鹽人陸黯舉義有衆數千人夜出襲郡"
    },
    {
      "pdf_page": 87,
      "half": "右",
      "leaf": "十下",
      "column_from_right": 3,
      "text": "殺偽太守蘇單于推襄行郡事時淮南太守文成侯蕭"
    },
    {
      "pdf_page": 87,
      "half": "右",
      "leaf": "十下",
      "column_from_right": 4,
      "text": "寧逃賊入吳襄遣迎寧為盟主遣黯及兄子映公帥衆"
    },
    {
      "pdf_page": 87,
      "half": "右",
      "leaf": "十下",
      "column_from_right": 5,
      "text": "拒子仙子仙聞兵起乃退還與黯等戰於松江黯敗走"
    },
    {
      "pdf_page": 87,
      "half": "右",
      "leaf": "十下",
      "column_from_right": 6,
      "text": "吳下軍聞之亦各奔散襄匿于墓下一夜憂憤卒時年"
    },
    {
      "pdf_page": 87,
      "half": "右",
      "leaf": "十下",
      "column_from_right": 7,
      "text": "七十襄弱冠遭家禍終身蔬食布衣不聽音樂口不言"
    },
    {
      "pdf_page": 87,
      "half": "右",
      "leaf": "十下",
      "column_from_right": 8,
      "text": "殺害五十許年侯景平世祖追贈侍中雲麾將軍以建"
    },
    {
      "pdf_page": 87,
      "half": "右",
      "leaf": "十下",
      "column_from_right": 9,
      "text": "義功追封餘干縣侯邑五百戶"
    }
  ],
