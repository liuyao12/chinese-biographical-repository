      "end_codepoint": 89,
      "human_reviewed": false
    },
    {
      "id": "c-liangshu-027-mingshanbin-complete:received_sentence5-89",
      "kind": "received_sentence",
      "person_id": "nbb_y6s_bfz_AAA",
      "source_quote": "又與前司徒左長史殷芸令曰：「北兗信至，明常侍遂至殞逝，聞之傷怛。",
      "reading": "太子致前司徒左長史殷芸，令稱亡者明常侍。",
      "note": "太子致前司徒左長史殷芸，令稱亡者明常侍。",
