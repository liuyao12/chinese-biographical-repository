      "end_codepoint": 56,
      "human_reviewed": false
    },
    {
      "id": "c-liangshu-027-mingshanbin-complete:received_sentence5-56",
      "kind": "received_sentence",
      "person_id": "nbb_y6s_bfz_AAA",
      "source_quote": "諡曰質子。",
      "reading": "諡質子。",
      "note": "諡質子。",
      "paragraph_id": "c-liangshu-027-mingshanbin-complete:p005",
      "start_codepoint": 56,
      "end_codepoint": 61,
      "human_reviewed": false
    },
    {
      "id": "c-liangshu-027-mingshanbin-complete:received_sentence5-61",
      "kind": "received_sentence",
      "person_id": "nbb_y6s_bfz_AAA",
      "source_quote": "昭明太子爲舉哀，賻錢十萬，布百匹，並使舍人王顒監護喪事。",
      "reading": "昭明太子舉哀，賻錢十萬、布百匹，命舍人王顒監護。",
      "note": "昭明太子舉哀，賻錢十萬、布百匹，命舍人王顒監護。",
      "paragraph_id": "c-liangshu-027-mingshanbin-complete:p005",
