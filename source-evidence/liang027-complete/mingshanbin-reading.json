    },
    {
      "id": "c-liangshu-027-mingshanbin-complete:received_sentence5-121",
      "kind": "received_sentence",
      "person_id": "nbb_y6s_bfz_AAA",
      "source_quote": "此賢儒術該通，志用稽古，溫厚淳和，倫雅弘篤。",
      "reading": "稱山賓儒術、德行。",
      "note": "稱山賓儒術、德行。",
      "paragraph_id": "c-liangshu-027-mingshanbin-complete:p005",
      "start_codepoint": 121,
      "end_codepoint": 143,
      "human_reviewed": false
    },
    {
