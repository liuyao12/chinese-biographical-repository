  "original_url": "https://upload.wikimedia.org/wikipedia/commons/0/09/NLC892-411999017142-12657_%E4%BA%8C%E5%8D%81%E5%9B%9B%E5%8F%B2_%E7%AC%AC166%E5%86%8A.pdf",
  "pdf_sha1": "b11514da8e27fc149ba1ddc8e42a71bd01cd4e25",
  "pdf_sha256": "82c750b714c7e5513ff512f69a324b7e8fc8cb561f255a17e664c6aac45fd932",
  "pdf_bytes": 31214377,
  "column_order": "一上第六欄至三上第六欄。三上第五欄前半至行於世屬倕，後半起第四子纘。",
  "columns": [
    {
      "pdf_page": 77,
      "half": "左",
      "leaf": "一上",
      "column_from_right": 6,
      "text": "陸倕字佐公吳郡吳人也晉太尉玩六世孫祖子眞宋"
    },
    {
      "pdf_page": 77,
      "half": "左",
      "leaf": "一上",
      "column_from_right": 7,
      "text": "東陽太守父慧曉齊太常卿倕少勤學善屬文於宅內"
    },
    {
      "pdf_page": 77,
      "half": "左",
      "leaf": "一上",
      "column_from_right": 8,
      "text": "起兩間茅屋杜絶往來晝夜讀書如此者數載所讀一"
    },
    {
      "pdf_page": 77,
      "half": "左",
      "leaf": "一上",
      "column_from_right": 9,
      "text": "遍必誦於口嘗借人漢書失五行志四卷乃暗寫還之"
    },
    {
      "pdf_page": 77,
      "half": "左",
      "leaf": "一上",
      "column_from_right": 10,
      "text": "略無遺脱幼為外祖張岱所異岱常謂諸子曰此兒汝"
    },
    {
      "pdf_page": 78,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 1,
      "text": "家之陽元也十七舉本州秀才刺史竟陵王子良開西"
    },
    {
      "pdf_page": 78,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 2,
      "text": "邸延英俊倕亦預焉辟議曹從事參軍廬陵王法曹行"
    },
    {
      "pdf_page": 78,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 3,
      "text": "參軍天監初為右軍安成王外兵參軍轉主簿倕與樂"
    },
    {
      "pdf_page": 78,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 4,
      "text": "安任昉友善為感知己賦以贈昉昉因此名以報之曰"
    },
    {
      "pdf_page": 78,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 5,
      "text": "信偉人之世篤本侯服於陸鄉緬風流於道素襲袞衣"
    },
    {
      "pdf_page": 78,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 6,
      "text": "與繡裳還伊人而世載並三駿而龍光過龍津而一息"
    },
    {
      "pdf_page": 78,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 7,
      "text": "望鳳條而會翔彼白玉之雖潔此幽蘭之信芳思在物"
    },
    {
      "pdf_page": 78,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 8,
      "text": "而取譬非斗斛之能量匹聳峙於東岳比凝厲於秋霜"
    },
    {
      "pdf_page": 78,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 9,
      "text": "不一飯以妄過每三錢以投渭匪蒙袂之敢嗟豈溝壑"
    },
    {
      "pdf_page": 78,
      "half": "右",
      "leaf": "一下",
      "column_from_right": 10,
      "text": "之能衣旣藴藉其有餘又淡然而無味得意同乎卷懷"
    },
    {
      "pdf_page": 78,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 1,
      "text": "違方似乎仗氣類平叔而靡雕似子雲之不朴冠衆善"
    },
    {
      "pdf_page": 78,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 2,
      "text": "而貽操綜羣言而名學折高戴於后臺異鄒顔乎董幄"
    },
    {
      "pdf_page": 78,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 3,
      "text": "採三詩於河間訪九師於淮曲術兼口傳之書藝廣鏗"
    },
    {
      "pdf_page": 78,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 4,
      "text": "鏘之樂時坐睡而梁懸裁枝梧而錐握旣文過而意深"
    },
    {
      "pdf_page": 78,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 5,
      "text": "又理勝而辭縟咨余生之荏苒迫歲暮而傷情測徂陰"
    },
    {
      "pdf_page": 78,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 6,
      "text": "於堂下聽鳴鍾於洛城唯忘年之陸子定一遇於班荊"
    },
    {
      "pdf_page": 78,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 7,
      "text": "余獲田蘇之價爾等海上之名信落魄而無產終長對"
    },
    {
      "pdf_page": 78,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 8,
      "text": "於短生飢虚表於徐步逃責顯於疾行子比我於叔則"
    },
    {
      "pdf_page": 78,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 9,
      "text": "又方余於耀卿心照情交流言靡惑萬類闇求千里懸"
    },
    {
      "pdf_page": 78,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 10,
      "text": "得言象可廢蹄筌自默居非連棟行則同車冬日不足"
    },
    {
      "pdf_page": 79,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 1,
      "text": "夏日靡餘肴核非餌絲竹豈娛我未捨駕子已回輿中"
    },
    {
      "pdf_page": 79,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 2,
      "text": "飯相顧悵然動色邦壤旣殊離會莫測存異山陽之居"
    },
    {
      "pdf_page": 79,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 3,
      "text": "沒非要離之側似膠投漆中離婁豈能識其為士友所"
    },
    {
      "pdf_page": 79,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 4,
      "text": "重如此遷驃騎臨川王東曹掾是時禮樂制度多所創"
    },
    {
      "pdf_page": 79,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 5,
      "text": "革高祖雅愛倕才乃勅撰新漏刻銘其文甚美遷太子"
    },
    {
      "pdf_page": 79,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 6,
      "text": "中舍人管東宮書記又詔為石闕銘記奏之勅曰太子"
    },
    {
      "pdf_page": 79,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 7,
      "text": "中舍人陸倕所製石闕銘辭義典雅足為佳作昔虞丘"
    },
    {
      "pdf_page": 79,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 8,
      "text": "辨物邯鄲獻賦賞以金帛前史美談可賜絹三十匹遷"
    },
    {
      "pdf_page": 79,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 9,
      "text": "太子庶子國子博士母憂去職服闋為中書侍郎給事"
    },
    {
      "pdf_page": 79,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 10,
      "text": "黄門侍郎揚州別駕從事史以疾陳解遷鴻臚卿入為"
    },
    {
      "pdf_page": 79,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 1,
      "text": "吏部郎參選事出為雲麾晉安王長史晉陽太守行江"
    },
    {
      "pdf_page": 79,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 2,
      "text": "州府州事以公事免左遷中書侍郎司徒司馬太子中"
    },
    {
      "pdf_page": 79,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 3,
      "text": "庶子廷尉卿又為中庶子加給事中揚州大中正復除"
    },
    {
      "pdf_page": 79,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 4,
      "text": "國子博士中庶子中正並如故守太常卿中正如故普"
    },
    {
      "pdf_page": 79,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 5,
      "text": "通七年卒年五十七文集二十卷行於世第四子纘早"
    },
    {
      "pdf_page": 79,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 6,
      "text": "慧十歲通經為童子奉車郎卒"
    }
  ],
