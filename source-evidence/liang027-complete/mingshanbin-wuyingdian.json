  "original_url": "https://upload.wikimedia.org/wikipedia/commons/0/09/NLC892-411999017142-12657_%E4%BA%8C%E5%8D%81%E5%9B%9B%E5%8F%B2_%E7%AC%AC166%E5%86%8A.pdf",
  "pdf_sha1": "b11514da8e27fc149ba1ddc8e42a71bd01cd4e25",
  "pdf_sha256": "82c750b714c7e5513ff512f69a324b7e8fc8cb561f255a17e664c6aac45fd932",
  "pdf_bytes": 31214377,
  "column_order": "五上第十欄至七上第六欄，自右向左。",
  "columns": [
    {
      "pdf_page": 81,
      "half": "左",
      "leaf": "五上",
      "column_from_right": 10,
      "text": "明山賓字孝若平原鬲人也父僧紹隱居不仕宋末徵"
    },
    {
      "pdf_page": 82,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 1,
      "text": "國子博士不就山賓七歲能言玄理十三博通經傳居"
    },
    {
      "pdf_page": 82,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 2,
      "text": "喪盡禮服闋州辟從事史起家奉朝請兄仲璋嬰痼疾"
    },
    {
      "pdf_page": 82,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 3,
      "text": "家道屢空山賓乃行干祿齊始安王蕭遙光引為撫軍"
    },
    {
      "pdf_page": 82,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 4,
      "text": "行參軍後為廣陽令頃之去官義師至高祖引為相府"
    },
    {
      "pdf_page": 82,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 5,
      "text": "田曹參軍梁臺建為尚書駕部郎遷治書侍御史右軍"
    },
    {
      "pdf_page": 82,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 6,
      "text": "記室參軍掌治吉禮時初置五經博士山賓首膺其選"
    },
    {
      "pdf_page": 82,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 7,
      "text": "遷北中郎諮議參軍侍皇太子讀累遷中書侍郎國子"
    },
    {
      "pdf_page": 82,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 8,
      "text": "博士太子率更令中庶子博士如故天監十五年出為"
    },
    {
      "pdf_page": 82,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 9,
      "text": "持節督縁淮諸軍事征遠將軍北兖州刺史普通二年"
    },
    {
      "pdf_page": 82,
      "half": "右",
      "leaf": "五下",
      "column_from_right": 10,
      "text": "徵為太子右衞率加給事中遷御史中丞以公事左遷"
    },
    {
      "pdf_page": 82,
      "half": "左",
      "leaf": "六上",
      "column_from_right": 1,
      "text": "黄門侍郎司農卿四年遷散騎常侍領青冀二州大中"
    },
    {
      "pdf_page": 82,
      "half": "左",
      "leaf": "六上",
      "column_from_right": 2,
      "text": "正東宮新置學士又以山賓居之俄以本官兼國子祭"
    },
    {
      "pdf_page": 82,
      "half": "左",
      "leaf": "六上",
      "column_from_right": 3,
      "text": "酒初山賓在州所部平陸縣不稔啓出倉米以贍人後"
    },
    {
      "pdf_page": 82,
      "half": "左",
      "leaf": "六上",
      "column_from_right": 4,
      "text": "刺史檢州曹失簿書以山賓為耗闕有司追責籍其宅"
    },
    {
      "pdf_page": 82,
      "half": "左",
      "leaf": "六上",
      "column_from_right": 5,
      "text": "入官山賓默不自理更市地造宅昭明太子聞築室不"
    },
    {
      "pdf_page": 82,
      "half": "左",
      "leaf": "六上",
      "column_from_right": 6,
      "text": "就有令曰明祭酒雖出撫大藩擁旄推轂珥金拖紫而"
    },
    {
      "pdf_page": 82,
      "half": "左",
      "leaf": "六上",
      "column_from_right": 7,
      "text": "恒事屢空聞構宇未成今送薄助並貽詩曰平仲古稱"
    },
    {
      "pdf_page": 82,
      "half": "左",
      "leaf": "六上",
      "column_from_right": 8,
      "text": "奇夷吾昔擅美令則挺伊賢東秦固多士築室非道傍"
    },
    {
      "pdf_page": 82,
      "half": "左",
      "leaf": "六上",
      "column_from_right": 9,
      "text": "置宅歸仁里庚桑方有係原生今易擬必來三徑人將"
    },
    {
      "pdf_page": 82,
      "half": "左",
      "leaf": "六上",
      "column_from_right": 10,
      "text": "招五經士山賓性篤實家中嘗乏用貨所乘牛旣售受"
    },
    {
      "pdf_page": 83,
      "half": "右",
      "leaf": "六下",
      "column_from_right": 1,
      "text": "錢乃謂買主曰此牛經患漏蹄治差已久恐後脱發無"
    },
    {
      "pdf_page": 83,
      "half": "右",
      "leaf": "六下",
      "column_from_right": 2,
      "text": "容不相語買主遽追取錢處士阮孝緒聞之歎曰此言"
    },
    {
      "pdf_page": 83,
      "half": "右",
      "leaf": "六下",
      "column_from_right": 3,
      "text": "足使還淳反朴激薄停澆矣五年又為國子博士常侍"
    },
    {
      "pdf_page": 83,
      "half": "右",
      "leaf": "六下",
      "column_from_right": 4,
      "text": "中正如故其年以本官假節權攝北兖州事大通元年"
    },
    {
      "pdf_page": 83,
      "half": "右",
      "leaf": "六下",
      "column_from_right": 5,
      "text": "卒時年八十五詔贈侍中信威將軍諡曰質子昭明太"
    },
    {
      "pdf_page": 83,
      "half": "右",
      "leaf": "六下",
      "column_from_right": 6,
      "text": "子為舉哀賻錢十萬布百匹並使舍人王顒監護喪事"
    },
    {
      "pdf_page": 83,
      "half": "右",
      "leaf": "六下",
      "column_from_right": 7,
      "text": "又與前司徒左長史殷芸令曰北兖信至明常侍遂至"
    },
    {
      "pdf_page": 83,
      "half": "右",
      "leaf": "六下",
      "column_from_right": 8,
      "text": "殞逝聞之傷怛此賢儒術該通志用稽古温厚淳和倫"
    },
    {
      "pdf_page": 83,
      "half": "右",
      "leaf": "六下",
      "column_from_right": 9,
      "text": "雅弘篤授經以來迄今二紀若其上交不諂造膝忠規"
    },
    {
      "pdf_page": 83,
      "half": "右",
      "leaf": "六下",
      "column_from_right": 10,
      "text": "非顯外迹得之胷懷者蓋亦積矣攝官連率行當言歸"
    },
    {
      "pdf_page": 83,
      "half": "左",
      "leaf": "七上",
      "column_from_right": 1,
      "text": "不謂長往眇成疇日追憶談緒皆為悲端往矣如何昔"
    },
    {
      "pdf_page": 83,
      "half": "左",
      "leaf": "七上",
      "column_from_right": 2,
      "text": "經聯事理當酸愴也山賓累居學官甚有訓導之益然"
    },
    {
      "pdf_page": 83,
      "half": "左",
      "leaf": "七上",
      "column_from_right": 3,
      "text": "性頗疎通接於諸生多所狎比人皆愛之所著吉禮儀"
    },
    {
      "pdf_page": 83,
      "half": "左",
      "leaf": "七上",
      "column_from_right": 4,
      "text": "注二百二十四卷禮儀二十卷孝經喪禮服儀十五卷"
    },
    {
      "pdf_page": 83,
      "half": "左",
      "leaf": "七上",
      "column_from_right": 5,
      "text": "子震字興道亦傳父業歷官太學博士太子舍人尚書"
    },
    {
      "pdf_page": 83,
      "half": "左",
      "leaf": "七上",
      "column_from_right": 6,
      "text": "祠部郎餘姚令"
    }
  ],
