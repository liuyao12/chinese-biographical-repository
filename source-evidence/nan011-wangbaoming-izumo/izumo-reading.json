  "columns": [
    {
      "pdf_page": 21,
      "half": "右",
      "leaf": "十八下",
      "column_from_right": 3,
      "reading": "文安王皇后諱寶明琅邪臨沂人也祖韶之吳",
      "start_codepoint": 0,
      "end_codepoint": 18
    },
    {
      "pdf_page": 21,
      "half": "右",
      "leaf": "十八下",
      "column_from_right": 4,
      "reading": "興太守父曄之太宰祭酒宋世高帝為文惠太",
      "start_codepoint": 18,
      "end_codepoint": 36
    },
    {
      "pdf_page": 21,
      "half": "右",
      "leaf": "十八下",
      "column_from_right": 5,
      "reading": "子納后建元元年為南郡王妃四年為皇太子",
      "start_codepoint": 36,
      "end_codepoint": 54
    },
    {
      "pdf_page": 21,
      "half": "右",
      "leaf": "十八下",
      "column_from_right": 6,
      "reading": "妃無寵太子宮人製新麗衣裳及首飾而后牀",
      "start_codepoint": 54,
      "end_codepoint": 72
    },
    {
      "pdf_page": 21,
      "half": "右",
      "leaf": "十八下",
      "column_from_right": 7,
      "reading": "帷陳故古舊釵鑷十餘枚永明十一年為皇太",
      "start_codepoint": 72,
      "end_codepoint": 90
    },
    {
      "pdf_page": 21,
      "half": "右",
      "leaf": "十八下",
      "column_from_right": 8,
      "reading": "孫太妃鬱林即位尊為皇太后稱宣德宮置男",
      "start_codepoint": 90,
      "end_codepoint": 108
    },
    {
      "pdf_page": 21,
      "half": "右",
      "leaf": "十八下",
      "column_from_right": 9,
      "reading": "左右三十人前代所未有也贈后父曄之金紫",
      "start_codepoint": 108,
      "end_codepoint": 126
    },
    {
      "pdf_page": 21,
      "half": "左",
      "leaf": "十九上",
      "column_from_right": 1,
      "reading": "光祿大夫母桓氏豐安縣君其年十二月備法",
      "start_codepoint": 126,
      "end_codepoint": 144
    },
    {
      "pdf_page": 21,
      "half": "左",
      "leaf": "十九上",
      "column_from_right": 2,
      "reading": "駕謁太廟明帝即位出居鄱陽王故第為宣德",
      "start_codepoint": 144,
      "end_codepoint": 162
    },
    {
      "pdf_page": 21,
      "half": "左",
      "leaf": "十九上",
      "column_from_right": 3,
      "reading": "宮永元三年梁武帝定建鄴迎入宮后稱制至",
      "start_codepoint": 162,
      "end_codepoint": 180
    },
    {
      "pdf_page": 21,
      "half": "左",
      "leaf": "十九上",
      "column_from_right": 4,
      "reading": "禪位遜居外宮梁天監十一年薨葬崇安陵諡",
      "start_codepoint": 180,
      "end_codepoint": 198
    },
    {
      "pdf_page": 21,
      "half": "左",
      "leaf": "十九上",
      "column_from_right": 5,
      "reading": "曰安后祖韶之自有傳",
      "start_codepoint": 198,
      "end_codepoint": 207
    }
  ],
