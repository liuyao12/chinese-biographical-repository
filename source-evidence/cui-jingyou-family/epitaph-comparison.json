  "decisions": [
    {
      "subject": "崔鷫",
      "candidate_father": "崔敬友",
      "relation_type": "father",
      "status": "contextual_provisional",
      "directly_attested": [
        "鷫誌自稱「梁郡府君之第二子」。",
        "鴻誌稱鷫為次弟，載輕車將軍、太尉記室，與鷫誌官歷吻合。",
        "混誌具名祖敬友、官梁郡太守，另記亡父鴻；魏書又具名敬友、除梁郡太守及子鴻。"
      ],
      "identification": "以鴻、鷫兄弟姓名及記室官歷鎖定二誌的同一鷫；鴻誌亦稱父梁郡，混誌與魏傳把此父系世代的梁郡太守繫於敬友。可暫組鷫為敬友子。鷫誌該句未寫敬友姓名，其父識別需保留對讀限定。",
      "limits": "第二子限定男嗣。本批無母親證據。魏書於敬友除梁郡太守後明言因母憂不拜，墓誌用官稱不能反推實任。",
      "sources": [
        "su-rubbing",
        "su-web",
        "hong-rubbing",
        "hun",
        "wei"
      ],
      "subject_person_id": "u3z_kcn_2cf_B",
      "candidate_father_person_id": "u3z_kcn_2cf"
    },
    {
      "subject": "崔鵾",
      "candidate_father": "崔敬友",
      "relation_type": "father",
      "status": "contextual_provisional",
      "directly_attested": [
        "博誌以博為主，原文作祖敬友、父鶤、伯父鴻；祖父與父親各自指向博。",
        "德誌以德為主，同列祖敬友、奉朝請鵾之子；轉載拓片作鵾，交流用網頁錄文作鶤。",
        "鴻誌列「君第四弟鵾奉朝請」；混誌列祖敬友與父鴻。"
      ],
      "identification": "博、德兩方各自的祖父與父親次序相合。奉朝請職、伯父鴻及鴻誌第四弟鵾交叉鎖定此父。可由父系連續世次暫組鵾父敬友。這一步為祖孫與父子兩原句的編者推合。",
      "limits": "博誌和德誌都未直接寫出「鵾，敬友之子」；兄弟本人同母、敬友妻為鵾母均未見明文。博、德兩方的現代輯錄同屬趙超編本。",
      "sources": [
