  "items": [
    {
      "anchor": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line064",
        "start": 0,
        "end": 4,
        "quote": "悅字長豫"
      },
      "reading": "傳述事親，導與悅對弈。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line064",
        "start": 68,
        "end": 73,
        "quote": "勿使大郎知"
      },
      "reading": "王導所稱大郎是悅；《中興書》列為長子。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line064",
        "start": 82,
        "end": 100,
        "quote": "歷呉王友、中書侍郎，先導卒，諡貞世子"
      },
      "reading": "兩官名。中書侍郎的中書是官名一部分，非獨立人名。先導卒、諡貞世子。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line064",
        "start": 104,
        "end": 113,
        "quote": "導夢人以百萬錢買悅"
      },
      "reading": "夢中買者未名；其後掘錢及甲士顯形分層。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line064",
        "start": 184,
        "end": 189,
        "quote": "僕是蔣侯也"
      },
      "reading": "敘事中的持刀人自稱蔣侯，未將異聞等同史實，或據此認定為另一史書的蔣子文。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line064",
        "start": 277,
        "end": 289,
        "quote": "又恆爲母曹氏襞斂箱篋中物"
      },
      "reading": "曹氏是悅母。德行注《王氏譜》記其名及父。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line066",
        "start": 0,
        "end": 11,
        "quote": "悅無子，以弟恬子琨爲嗣"
      },
      "reading": "悅無子；恬是悅弟，琨為恬子而承悅。兩書名作混時仍用本卷原名錨。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line066",
        "start": 12,
        "end": 24,
        "quote": "襲導爵丹陽尹，卒，贈太常"
      },
      "reading": "爵為導爵，丹陽尹為琨官；原句在兩者間無標點，以早期譜注及宋書核定。太常是所贈。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line066",
        "start": 25,
        "end": 34,
        "quote": "子嘏嗣，尚鄱陽公主"
      },
      "reading": "嘏是琨子，繼其爵，娶鄱陽公主。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line066",
        "start": 43,
        "end": 58,
        "quote": "卒，子恢嗣，義熙末，爲遊擊將軍"
      },
      "reading": "卒指嘏；恢乃其子，嗣爵；與王劭同名子恢有別。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line070",
        "start": 5,
        "end": 15,
        "quote": "少好武，不爲公門所重"
      },
      "reading": "後文指父王導待恬、悅不同，文字志言不為導所重。「公門」保留門第範圍。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line070",
        "start": 37,
        "end": 42,
        "quote": "襲爵即丘子"
      },
      "reading": "即丘子為恬實襲之爵。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line070",
        "start": 52,
        "end": 57,
        "quote": "謝萬嘗造恬"
      },
      "reading": "恬散髮曬頭，萬悵然而歸；世說簡傲以阿螭稱恬。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line070",
        "start": 145,
        "end": 159,
        "quote": "帝欲以爲中書令，導固讓，從之"
      },
      "reading": "擬以恬任中書令，父導固讓，帝從之，未任。王導在世，原句無帝號，既有成帝說據仕歷還原。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line070",
        "start": 181,
        "end": 193,
        "quote": "導薨，去官。俄起爲後將軍"
      },
      "reading": "導薨致恬去官，後起復，非恬此時卒。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line070",
        "start": 214,
        "end": 225,
        "quote": "卒，贈中軍將軍，諡曰憲"
      },
      "reading": "中軍將軍是追贈，憲為諡。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-065-wangdao-family:p003",
        "start": 13,
        "end": 20,
        "quote": "與荀羨俱有美稱"
      },
      "reading": "荀羨與王洽並稱。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-065-wangdao-family:p003",
        "start": 53,
        "end": 66,
        "quote": "徵拜領軍，尋加中書令，固讓"
      },
      "reading": "領軍獲拜。中書令累表辭拒，最終不受。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-065-wangdao-family:p003",
        "start": 72,
        "end": 76,
        "quote": "穆帝詔曰"
      },
      "reading": "詔中吾是穆帝，敬和、友臣所指為洽。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-065-wangdao-family:p003",
        "start": 162,
        "end": 182,
        "quote": "昇平二年卒於官，年三十六。二子：珣、瑉。"
      },
      "reading": "358年；正史及殿本報齡三十六，世說賞譽注引中興書、品藻注皆報二十六。兩子珣、瑉。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line092",
        "start": 27,
        "end": 38,
        "quote": "法護非不佳，僧彌難爲兄"
      },
      "reading": "法護為珣小字，僧彌為瑉小字；時人以兄弟較優劣。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line092",
        "start": 50,
        "end": 58,
        "quote": "外國沙門，名提婆"
      },
      "reading": "提婆為珣兄弟講毗曇經，法綱是參預聽瑉轉講之人。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line092",
        "start": 173,
        "end": 189,
        "quote": "世謂獻之爲「大令」，瑉爲「小令」"
      },
      "reading": "獻之、瑉相繼任中書令，二人稱號有別。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line092",
        "start": 190,
        "end": 215,
        "quote": "太元十三年卒，時年三十八，追贈太常。二子：朗、練。"
      },
      "reading": "388年。固定卷65同斠注三十八，武英殿十四上二十八；二子朗練義熙中歷侍中。"
    }
  ],
  "comparisons": [
    {
      "anchor": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line064",
        "start": 249,
        "end": 260,
        "quote": "悅與導語，恆以慎密爲端"
      },
      "sources": [
        {
          "witness": "de",
          "raw_start": 17179,
          "raw_end": 17208,
          "raw_line": 31,
          "quote": "{{ProperNoun|長豫}}與丞相語，恒以愼密爲端。",
          "source_layer": "正文"
        }
      ],
      "reading": "同一送父出門、曹氏箱篋故事；世說文、所附三種古注分錄。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line064",
        "start": 21,
        "end": 27,
        "quote": "導嘗共悅奕棋"
      },
      "sources": [
        {
          "witness": "pai",
          "raw_start": 3380,
          "raw_end": 3413,
          "raw_line": 24,
          "quote": "王長豫幼便和令，丞相愛恣甚篤。每共圍棊，丞相欲舉行，長豫按指不聽。",
          "source_layer": "正文"
        }
      ],
      "reading": "世說排調亦記導悅父子執棋。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line066",
        "start": 0,
        "end": 11,
        "quote": "悅無子，以弟恬子琨爲嗣"
      },
      "sources": [
        {
          "witness": "pai",
          "raw_start": 6712,
          "raw_end": 6730,
          "raw_line": 50,
          "quote": "混字奉正，中軍將軍恬子。仕至丹陽尹。",
          "source_layer": "劉注引王氏譜"
        },
        {
          "witness": "song052",
          "raw_start": 1697,
          "raw_end": 1711,
          "raw_line": 20,
          "quote": "祖恬，中軍將軍。父混，太常。",
          "source_layer": "正文"
        },
        {
          "witness": "z372",
          "raw_start": 112,
          "raw_end": 127,
          "raw_line": 2,
          "quote": "案『琨』當從《王氏譜》作『混』",
          "source_layer": "吳士鑑案語"
        }
      ],
      "reading": "以恬子、丹陽尹、太常三條交證，保存琨與混兩個見證，名奉正為字。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line070",
        "start": 93,
        "end": 101,
        "quote": "據胡床於庭中曬發"
      },
      "sources": [
        {
          "witness": "jian",
          "raw_start": 2118,
          "raw_end": 2142,
          "raw_line": 20,
          "quote": "謝公嘗與謝萬共出西，過吳郡。阿萬欲相與共萃王恬許",
          "source_layer": "正文"
        },
        {
          "witness": "jian",
          "raw_start": 2284,
          "raw_end": 2292,
          "raw_line": 20,
          "quote": "王恬，小字螭虎。",
          "source_layer": "劉孝標注"
        }
      ],
      "reading": "對訪者、職地、曬髮事相合，螭虎另有注據。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line070",
        "start": 181,
        "end": 186,
        "quote": "導薨，去官"
      },
      "sources": [
        {
          "witness": "jin007",
          "raw_start": 6491,
          "raw_end": 6520,
          "raw_line": 257,
          "quote": "秋七月庚申，使持節、侍中、丞相、領揚州刺史、始興公王導薨。",
          "source_layer": "正文"
        },
        {
          "witness": "jin007",
          "raw_start": 6235,
          "raw_end": 6245,
          "raw_line": 250,
          "quote": "===咸康五年===",
          "source_layer": "數位年題"
        }
      ],
      "reading": "導薨咸康五年七月庚申；王恬去官的日子未明。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-065-wangdao-family:p003",
        "start": 170,
        "end": 174,
        "quote": "年三十六"
      },
      "sources": [
        {
          "witness": "shang",
          "raw_start": 15254,
          "raw_end": 15302,
          "raw_line": 121,
          "quote": "王洽字敬和，丞相導第三子，累遷吳郡內史，為士民所懷。徵拜中領軍，尋加中書令，不拜。年二十六而卒。",
          "source_layer": "劉注引中興書"
        },
        {
          "witness": "pin",
          "raw_start": 11476,
          "raw_end": 11492,
          "raw_line": 91,
          "quote": "領軍王洽，珣之父也。年二十六卒。",
          "source_layer": "劉孝標注"
        },
        {
          "witness": "z373",
          "raw_start": 861,
          "raw_end": 874,
          "raw_line": 4,
          "quote": "升平二年卒於官，年三十六。",
          "source_layer": "正文"
        }
      ],
      "reading": "同人有兩種報齡；武英殿十一下作三十六。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line092",
        "start": 27,
        "end": 32,
        "quote": "法護非不佳"
      },
      "sources": [
        {
          "witness": "shangshi",
          "raw_start": 2322,
          "raw_end": 2329,
          "raw_line": 23,
          "quote": "法護，珣小字。",
          "source_layer": "劉孝標注"
        }
      ],
      "reading": "王悅、王洽、王瑉與同名之王朗/先世區別。法護可接珣。"
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line092",
        "start": 197,
        "end": 202,
        "quote": "時年三十八"
      },
      "sources": [
        {
          "witness": "z378",
          "raw_start": 632,
          "raw_end": 650,
          "raw_line": 2,
          "quote": "太元十三年卒，時年三十八，追贈太常。",
          "source_layer": "正文"
        }
      ],
      "reading": "殿本十四上作二十八，與本次數位正文並列。"
    }
  ],
