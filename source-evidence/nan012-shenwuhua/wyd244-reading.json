  "columns": [
    {
      "page": 28,
      "half": "左",
      "column": 9,
      "quote": "後主沈皇后諱婺華吳興武康人也父君理自有傳后"
    },
    {
      "page": 28,
      "half": "左",
      "column": 10,
      "quote": "母卽武帝女會稽穆公主早亡時后尚幼而毀瘠過甚"
    },
    {
      "page": 29,
      "half": "右",
      "column": 2,
      "quote": "焉大建二年拜為皇太子妃後主卽位立為皇后后性"
    },
    {
      "page": 29,
      "half": "右",
      "column": 8,
      "quote": "應時雨降無子養孫姬子胤為己子數上書諫爭後主"
    },
    {
      "page": 29,
      "half": "左",
      "column": 1,
      "quote": "從駕及煬帝被殺后自廣陵過江於毗陵天靜寺為尼"
    },
    {
      "page": 29,
      "half": "左",
      "column": 2,
      "quote": "名觀音貞觀初卒"
    }
  ]
}
