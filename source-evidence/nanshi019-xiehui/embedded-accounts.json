      "title": "謝世基",
      "person_id": "aa6_83c_juy_AAABA",
      "source": {
        "path": "sources/nanshi/nanshi019-ws1531762.wikitext",
        "revision": 1531762,
        "sha256": "2f1bbb6150c723a3839e2f5a81f1a7522e3414465b8d8a11e23a164b43368964",
