  "columns": [
    {
      "pdf_page": 3,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 6,
      "reading": "高昭劉皇后諱智容廣陵人也祖玄之父壽之竝員外",
      "start_codepoint": 0,
      "end_codepoint": 21
    },
    {
      "pdf_page": 3,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 7,
      "reading": "郎后母桓氏夢吞玉勝生后時有紫光滿室以告壽之",
      "start_codepoint": 21,
      "end_codepoint": 42
    },
    {
      "pdf_page": 3,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 8,
      "reading": "壽之曰恨非是男桓曰雖女亦足興家矣后每寢臥家",
      "start_codepoint": 42,
      "end_codepoint": 63
    },
    {
      "pdf_page": 3,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 9,
      "reading": "人常見上如有雲氣焉年十餘歲歸太祖嚴正有禮法",
      "start_codepoint": 63,
      "end_codepoint": 84
    },
    {
      "pdf_page": 3,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 10,
      "reading": "家庭肅然宋泰豫元年殂年五十歸葬宣帝墓側今泰",
      "start_codepoint": 84,
      "end_codepoint": 105
    },
    {
      "pdf_page": 4,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 1,
      "reading": "安陵也門生王清與墓工始下鍤有白兔跳起尋之不",
      "start_codepoint": 105,
      "end_codepoint": 126
    },
    {
      "pdf_page": 4,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 2,
      "reading": "得及墳成兔還棲其上昇明二年贈竟陵公國夫人三",
      "start_codepoint": 126,
      "end_codepoint": 147
    },
    {
      "pdf_page": 4,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 3,
      "reading": "年贈齊國妃印綬如太妃建元元年尊諡昭皇后三年",
      "start_codepoint": 147,
      "end_codepoint": 168
    },
    {
      "pdf_page": 4,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 4,
      "reading": "贈后父金紫光祿大夫母桓氏上都鄉君壽之子興道",
      "start_codepoint": 168,
      "end_codepoint": 189
    },
    {
      "pdf_page": 4,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 5,
      "reading": "司徒屬文蔚豫章內史義徽光祿大夫義倫通直郎",
      "start_codepoint": 189,
      "end_codepoint": 209
    }
  ],
