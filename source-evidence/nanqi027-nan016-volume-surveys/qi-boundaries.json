  "contextual_passages": [
    {
      "line": 11,
      "start": 21,
      "end": 59,
      "source_quote": "祖昶，宋武帝平齊，以為青州治中，至員外常侍。伯父奉伯，宋世為陳南頓二郡太守。",
      "decision": "傳首家系，隨後奉伯評懷珍。"
    },
    {
      "line": 25,
      "start": 48,
      "end": 57,
      "source_quote": "休賓，懷珍從弟也。",
      "decision": "敘劉休賓告急時交代親屬，沒有獨立傳段。"
    },
    {
      "line": 45,
      "start": 2,
      "end": 11,
      "source_quote": "嫡母崔氏及兄子景煥",
      "decision": "與第43行所生母分別，兄子與母在同一贖親事內。"
    },
    {
      "line": 68,
      "start": 78,
      "end": 87,
      "source_quote": "乃遣族弟馬軍主長文",
      "decision": "李長文參與孫溪渚之戰，親屬在李安民指揮的同一件軍事內。"
    },
    {
      "line": 79,
      "start": 15,
      "end": 32,
      "source_quote": "祖宰，偽北地太守。父蕤，東莞太守。",
      "decision": "玄載已核傳首祖父原句，附家屬不增傳目。"
    },
    {
      "line": 104,
      "start": 8,
      "end": 19,
      "source_quote": "宋鎮北大將軍仲德兄孫也",
      "decision": "主語文和，與另敘文和所在句同存。"
    }
  ],
