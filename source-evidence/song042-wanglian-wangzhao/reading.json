  "facts": [
    {
      "start": 0,
      "end": 14,
      "surface": "弘從父弟練，晉中書令珉子也。",
      "kind": "家世",
      "note": "王練為王弘從父弟、晉中書令王珉子；從父弟是父系同輩較少，排行未載。",
      "occurrence_ids": [
        "c-songshu-042-wanghong:line097:m0000",
        "c-songshu-042-wanghong:line097:m0004",
        "c-songshu-042-wanghong:line097:m0010"
      ]
    },
    {
      "start": 14,
      "end": 30,
      "surface": "元嘉中，歷顯官，侍中，度支尚書。",
      "kind": "歷官",
      "note": "王練之侍中及度支尚書；可置元嘉424–453，未載月日。",
      "occurrence_ids": []
    },
    {
      "start": 30,
      "end": 34,
      "surface": "練子釗，",
      "kind": "父子",
      "note": "王練是王釗之父；其母下文明載。",
      "occurrence_ids": [
        "c-songshu-042-wanghong:line097:m0030",
        "c-songshu-042-wanghong:line097:m0032"
      ]
    },
    {
      "start": 34,
      "end": 49,
      "surface": "世祖大明中，亦經清職，黃門郎，",
      "kind": "官職",
      "note": "世祖劉駿大明457–464；黃門郎。",
      "occurrence_ids": [
        "c-songshu-042-wanghong:line097:m0034"
      ]
    },
    {
      "start": 49,
      "end": 72,
      "surface": "臨海王子頊晉安王子勛征虜、前軍長史，左民尚書。",
      "kind": "王府長史",
      "note": "王釗歷兩王府，征虜與前軍共用長史，子頊及子勛各自先後皆曾任征虜、前將軍。依本文次序可配讀，缺任命日期。左民尚書亦為釗。",
      "occurrence_ids": [
        "c-songshu-042-wanghong:line097:m0049",
        "c-songshu-042-wanghong:line097:m0054"
      ]
    },
    {
      "start": 72,
      "end": 83,
      "surface": "太宗初，為司徒左長史。",
      "kind": "官職",
      "note": "太宗劉彧初期為司徒左長史，465即位；出軍前或同年。",
      "occurrence_ids": [
        "c-songshu-042-wanghong:line097:m0072"
      ]
    },
    {
      "start": 83,
      "end": 106,
      "surface": "隨司徒建安王休仁出赭圻，時居母憂，加冠軍將軍。",
      "kind": "隨征與居喪",
      "note": "隨建安王劉休仁出赭圻，時居其母喪，官加冠軍。可與泰始二年戰事比讀，無奉加之日。",
      "occurrence_ids": [
        "c-songshu-042-wanghong:line097:m0086",
        "c-songshu-042-wanghong:line097:m0097"
      ]
    },
    {
      "start": 106,
      "end": 117,
      "surface": "忤犯休仁，出為始興相。",
      "kind": "外調",
      "note": "王釗忤休仁，外任始興相。",
      "occurrence_ids": [
        "c-songshu-042-wanghong:line097:m0108"
      ]
    },
    {
      "start": 117,
      "end": 135,
      "surface": "休仁恚之不已，太宗乃收付廷尉，賜死。",
      "kind": "賜死",
      "note": "休仁繼續怨王釗，宋明帝下令付廷尉賜死。明帝在位、赭圻事後可界於466–472；不由征討日定死日。",
      "occurrence_ids": [
        "c-songshu-042-wanghong:line097:m0117",
        "c-songshu-042-wanghong:line097:m0124"
      ]
    }
  ],
