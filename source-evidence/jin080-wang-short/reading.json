  "revision_id": 2603570,
  "chapter_id": "c-jinshu-080-wangxizhi-family",
  "source_scope": "王玄之、凝之、徽之、楨之、操之；新年、對話、官稱、校異與異聞分錄。",
  "item_interpretations": [
    {
      "paragraph_id": "c-jinshu-080-wangxizhi-family:line086",
      "start": 0,
      "end": 18,
      "quote": "有七子，知名者五人。玄之早卒。次凝之",
      "reading": "羲之子總數七、知名五，玄之早卒，凝之在後；其餘二人此處不列姓名。"
    },
    {
      "paragraph_id": "c-jinshu-080-wangxizhi-family:line086",
      "start": 40,
      "end": 50,
      "quote": "王氏世事張氏五斗米道",
      "reading": "家族所奉道派。張氏之名不指明祖師身份。"
    },
    {
      "paragraph_id": "c-jinshu-080-wangxizhi-family:line086",
      "start": 90,
      "end": 101,
      "quote": "吾已請大道，許鬼兵相助",
      "reading": "凝之自稱請鬼兵；以當事人言論存錄。"
    },
    {
      "paragraph_id": "c-jinshu-080-wangxizhi-family:line090",
      "start": 56,
      "end": 60,
      "quote": "似是馬曹",
      "reading": "對所署何曹的答語；前段實任桓沖騎兵參軍。"
    },
    {
      "paragraph_id": "c-jinshu-080-wangxizhi-family:line092",
      "start": 91,
      "end": 99,
      "quote": "何可一日無此君邪",
      "reading": "其所指為竹。"
    },
    {
      "paragraph_id": "c-jinshu-080-wangxizhi-family:line092",
      "start": 121,
      "end": 137,
      "quote": "獨酌酒詠左思《招隱詩》，忽憶戴逵",
      "reading": "左思為所詠詩作者；戴逵即安道，雪夜未相見。"
    },
    {
      "paragraph_id": "c-jinshu-080-wangxizhi-family:line092",
      "start": 216,
      "end": 223,
      "quote": "獻之賞井丹高潔",
      "reading": "世說劉注引嵇康高士傳，井丹字大春，長卿指司馬相如，兩人均為所讀古人。"
    },
    {
      "paragraph_id": "c-jinshu-080-wangxizhi-family:line094",
      "start": 59,
      "end": 65,
      "quote": "請以餘年代之",
      "reading": "術者說可代死；徽之提出以年相代。幽明錄說法另列為志怪。"
    },
    {
      "paragraph_id": "c-jinshu-080-wangxizhi-family:line094",
      "start": 162,
      "end": 170,
      "quote": "月餘亦卒。子楨之",
      "reading": "先獻之卒、徽之月餘後卒；不據月餘倒推出確日。"
    },
    {
      "paragraph_id": "c-jinshu-080-wangxizhi-family:line098",
      "start": 33,
      "end": 39,
      "quote": "我何如君亡叔",
      "reading": "桓玄問楨之，亡叔即王獻之。世說正文稱第七叔，劉孝標識其為獻之。"
    },
    {
      "paragraph_id": "c-jinshu-080-wangxizhi-family:line098",
      "start": 0,
      "end": 5,
      "quote": "楨之字公幹",
      "reading": "晉書公幹，劉注引王氏譜公榦；與劉楨之字同形並非同人。"
    },
    {
      "paragraph_id": "c-jinshu-080-wangxizhi-family:line102",
      "start": 0,
      "end": 17,
      "quote": "操之字子重，歷侍中、尚書、豫章太守",
      "reading": "操之與徽之是獻之兄，獻之傳106行有兄名。"
    }
  ],
  "comparisons": [
    {
      "local": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line086",
        "start": 113,
        "end": 118,
        "quote": "遂為孫所害"
      },
      "anchors": [
        {
          "witness": "an",
          "quote": "十一月甲寅，妖賊孫恩陷會稽，內史王凝之死之",
          "source_layer": "正文",
          "raw_start": 2004,
          "raw_end": 2025,
          "raw_line": 62
        },
        {
          "witness": "lie",
          "quote": "及遭孫恩之難，舉厝自若，既聞夫及諸子已為賊所害",
          "source_layer": "正文",
          "raw_start": 4581,
          "raw_end": 4604,
          "raw_line": 75
        }
      ],
      "source_date": {
        "regnal_year": "隆安三年",
        "modern_year": 399,
        "lunar_month": 11,
        "sexagenary_day": "甲寅"
      },
      "reading": "安帝紀同日陷會稽、內史凝之死。列女謝氏傳另載夫及諸子被害；不從此推各子姓名。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line092",
        "start": 229,
        "end": 236,
        "quote": "未若長卿慢世也"
      },
      "anchors": [
        {
          "witness": "pin",
          "quote": "王子猷、子敬兄弟共賞高士傳人及贊。子敬賞井丹高潔，子猷云：「未若長卿慢世。」",
          "source_layer": "正文",
          "raw_start": 10633,
          "raw_end": 10671,
          "raw_line": 88
        },
        {
          "witness": "pin",
          "quote": "司馬相如者，蜀郡成都人，字長卿。",
          "source_layer": "劉注引嵇康高士傳",
          "raw_start": 10990,
          "raw_end": 11006,
          "raw_line": 88
        },
        {
          "witness": "pin",
          "quote": "丹字大春，扶風郿人。",
          "source_layer": "劉注引嵇康高士傳",
          "raw_start": 10683,
          "raw_end": 10693,
          "raw_line": 88
        }
      ],
      "reading": "長卿確為司馬相如。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line098",
        "start": 17,
        "end": 22,
        "quote": "桓玄為太尉"
      },
      "anchors": [
        {
          "witness": "pin",
          "quote": "桓玄為太傅，大會，朝臣畢集。坐裁竟，問王楨之曰：「我何如卿第七叔？」",
          "source_layer": "正文",
          "raw_start": 11614,
          "raw_end": 11648,
          "raw_line": 94
        },
        {
          "witness": "pin",
          "quote": "楨之字公榦，琅邪人，徽之子。歷侍中、大司馬長史。",
          "source_layer": "劉注引王氏譜",
          "raw_start": 11658,
          "raw_end": 11682,
          "raw_line": 94
        },
        {
          "witness": "pin",
          "quote": "第七叔，獻之也。",
          "source_layer": "劉孝標注",
          "raw_start": 11683,
          "raw_end": 11691,
          "raw_line": 94
        }
      ],
      "reading": "晉書太尉、世說太傅；史料各自限定。劉注所引王氏譜止於大司馬長史；第七叔的解說是劉注本文。",
      "nephew_person_id": "326_faf_cd3_BA",
      "paternal_uncle_person_id": "sm1_jfi_7k2",
      "father_person_id": "326_faf_cd3_B"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line094",
        "start": 162,
        "end": 166,
        "quote": "月餘亦卒"
      },
      "anchors": [
        {
          "witness": "shang",
          "quote": "王子猷、子敬俱病篤，而子敬先亡。",
          "source_layer": "正文",
          "raw_start": 2424,
          "raw_end": 2440,
          "raw_line": 24
        },
        {
          "witness": "shang",
          "quote": "獻之以泰元十三年卒，年四十五。",
          "source_layer": "劉孝標注",
          "raw_start": 2444,
          "raw_end": 2459,
          "raw_line": 24
        },
        {
          "witness": "shang",
          "quote": "王子猷、子敬兄弟，特相和睦。",
          "source_layer": "劉注引幽明錄",
          "raw_start": 2622,
          "raw_end": 2636,
          "raw_line": 24
        }
      ],
      "reading": "卒及相對時間依晉書敘事；泰元十三年、四十五為劉注。幽明錄屬術者異聞。"
    },
    {
      "local": {
        "paragraph_id": "c-jinshu-080-wangxizhi-family:line102",
        "start": 6,
        "end": 17,
        "quote": "歷侍中、尚書、豫章太守"
      },
      "anchors": [
        {
          "witness": "pin",
          "quote": "操之字子重，羲之第六子。歷秘書監、侍中、尚書、豫章太守。",
          "source_layer": "劉注引王氏譜",
          "raw_start": 10060,
          "raw_end": 10088,
          "raw_line": 82
        }
      ],
      "reading": "劉注王氏譜載操之羲之第六子，除晉書三官並載秘書監。"
    }
  ],
  "external_scope": [
    "卷96本傳「字道韞」；父謝奕、夫王凝之兩條照原詞。",
    "書蹟摹錄、唐代皇室書評與本次任官生卒分層。"
  ],
