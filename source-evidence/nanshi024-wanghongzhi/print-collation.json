  "columns": [
    {
      "page_url": "https://upload.wikimedia.org/wikipedia/commons/a/a5/NLC892-411999017142-12361_%E4%BA%8C%E5%8D%81%E5%9B%9B%E5%8F%B2_%E7%AC%AC247%E5%86%8A.pdf#page=36",
      "column": "L01",
      "quote": "𢎞之字方平少孤貧為外祖徵士何準所撫育從叔獻",
      "interpretation_note": "殿本何準有十底，數位作何准，宋書殿本何淮。"
    },
    {
      "page_url": "https://upload.wikimedia.org/wikipedia/commons/a/a5/NLC892-411999017142-12361_%E4%BA%8C%E5%8D%81%E5%9B%9B%E5%8F%B2_%E7%AC%AC247%E5%86%8A.pdf#page=36",
      "column": "L03",
      "quote": "山水求為烏傷令桓𤣥輔晉桓謙以為衞軍參軍時殷",
      "interpretation_note": "南史傳作烏傷令；宋書正文作烏程。"
    },
    {
      "page_url": "https://upload.wikimedia.org/wikipedia/commons/a/a5/NLC892-411999017142-12361_%E4%BA%8C%E5%8D%81%E5%9B%9B%E5%8F%B2_%E7%AC%AC247%E5%86%8A.pdf#page=36",
      "column": "L06",
      "quote": "母隨兄鎮之之安成郡𢎞之解職同行義熙中何無忌",
      "interpretation_note": "南史殿本有母，其兄鎮之與弘之赴安成。"
    },
    {
      "page_url": "https://upload.wikimedia.org/wikipedia/commons/a/a5/NLC892-411999017142-12361_%E4%BA%8C%E5%8D%81%E5%9B%9B%E5%8F%B2_%E7%AC%AC247%E5%86%8A.pdf#page=37",
      "column": "R07",
      "quote": "隱約窮岫自始迄今阮萬齡辭事就閑纂戎先業既遠",
      "interpretation_note": "比宋書纂成。"
    },
    {
      "page_url": "https://upload.wikimedia.org/wikipedia/commons/a/a5/NLC892-411999017142-12361_%E4%BA%8C%E5%8D%81%E5%9B%9B%E5%8F%B2_%E7%AC%AC247%E5%86%8A.pdf#page=37",
      "column": "R08",
      "quote": "同羲唐亦激貪厲競若遣一介有以相存真可謂千載",
      "interpretation_note": "南史殿本一介；數位只作一。"
    },
    {
      "page_url": "https://upload.wikimedia.org/wikipedia/commons/a/a5/NLC892-411999017142-12361_%E4%BA%8C%E5%8D%81%E5%9B%9B%E5%8F%B2_%E7%AC%AC247%E5%86%8A.pdf#page=37",
      "column": "R09",
      "quote": "盛美也𢎞之元嘉四年卒顏延之欲為作誄書與其子",
      "interpretation_note": "明書元嘉四年，但不報卒齡。"
    }
  ]
}
