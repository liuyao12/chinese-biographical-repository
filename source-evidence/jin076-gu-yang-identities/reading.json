  "source_clauses": [
    {
      "witness": "j6",
      "quote": "===太寧二年===",
      "raw_start": 9582,
      "raw_end": 9592,
      "raw_line": 190
    },
    {
      "witness": "j6",
      "quote": "沈充故將顧颺反於武康，攻燒城邑，州縣討斬之。",
      "raw_start": 10798,
      "raw_end": 10820,
      "raw_line": 207
    },
    {
      "witness": "j98",
      "quote": "充司馬顧揚說充曰",
      "raw_start": 6643,
      "raw_end": 6651,
      "raw_line": 79
    },
    {
      "witness": "j98",
      "quote": "充不能用，揚逃歸於吳。",
      "raw_start": 6787,
      "raw_end": 6798,
      "raw_line": 79
    },
    {
      "witness": "z93",
      "quote": "沈充帥眾萬餘人與王含軍合，司馬顧颺說充曰",
      "raw_start": 3091,
      "raw_end": 3111,
      "raw_line": 49
    },
    {
      "witness": "j",
      "quote": "前義興太守顧衆、護軍參軍顧颺等，皆起義軍以應舒。",
      "raw_start": 783,
      "raw_end": 807,
      "raw_line": 15
    },
    {
      "witness": "j",
      "quote": "衆從弟護軍將軍颺為威遠將軍、前鋒督護。",
      "raw_start": 9017,
      "raw_end": 9036,
      "raw_line": 118
    }
  ],
