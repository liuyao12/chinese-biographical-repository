  "source_clauses": [
    {
      "witness": "sg",
      "quote": "時琮群子緒、端亦並爲將",
      "raw_start": 7790,
      "raw_end": 7801,
      "raw_line": 58
    },
    {
      "witness": "sg",
      "quote": "著《[[新言]]》仁十篇。其《[[知難篇]]》",
      "raw_start": 8004,
      "raw_end": 8027,
      "raw_line": 58
    },
    {
      "witness": "sg48",
      "quote": "以武昌督范慎爲太尉。",
      "raw_start": 11556,
      "raw_end": 11566,
      "raw_line": 70
    },
    {
      "witness": "sg50",
      "quote": "生二女，長曰魯班，字大虎，前配周瑜子循，後配全琮。",
      "raw_start": 1903,
      "raw_end": 1928,
      "raw_line": 31
    },
    {
      "witness": "sg53",
      "quote": "薛綜字敬文，沛郡竹邑人也。",
      "raw_start": 4719,
      "raw_end": 4732,
      "raw_line": 39
    },
    {
      "witness": "sg58",
      "quote": "琮子寄，果阿附魯王",
      "raw_start": 6226,
      "raw_end": 6235,
      "raw_line": 55
    },
    {
      "witness": "sg59",
      "quote": "謝景、范慎、刁玄、羊衜等皆爲賔客",
      "raw_start": 506,
      "raw_end": 522,
      "raw_line": 12
    },
    {
      "witness": "sg60",
      "quote": "吴书曰：琮长子绪，幼知名，奉朝请",
      "raw_start": 3789,
      "raw_end": 3805,
      "raw_line": 42
    },
    {
      "witness": "sg64",
      "quote": "初用侍中偏將軍徐詳",
      "raw_start": 1207,
      "raw_end": 1216,
      "raw_line": 12
    },
    {
      "witness": "wei",
      "quote": "琮子懌、孫靜、從子端、翩、緝等，皆將兵來救誕。",
      "raw_start": 20079,
      "raw_end": 20102,
      "raw_line": 107
    }
  ],
