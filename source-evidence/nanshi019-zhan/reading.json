  "place_occurrences": [
    {
      "paragraph_id": "c-nanshi-019-nan19:zhan-l042",
      "start": 25,
      "end": 27,
      "surface": "吳郡",
      "quote": "劉弟柳爲吳郡，將姊俱行，瞻不能違遠，自楚臺秘書郎解職隨從，故爲柳建威長史。"
    },
    {
      "paragraph_id": "c-nanshi-019-nan19:zhan-l042",
      "start": 84,
      "end": 86,
      "surface": "彭城",
      "quote": "晦時爲宋臺右衛，權遇已重，於彭城還都迎家，賓客輻湊。"
    },
    {
      "paragraph_id": "c-nanshi-019-nan19:zhan-l042",
      "start": 87,
      "end": 88,
      "surface": "都",
      "quote": "晦時爲宋臺右衛，權遇已重，於彭城還都迎家，賓客輻湊。"
    },
    {
      "paragraph_id": "c-nanshi-019-nan19:zhan-l044",
      "start": 2,
      "end": 4,
      "surface": "彭城",
      "quote": "及還彭城，言於武帝曰：「臣本素士，父祖位不過二千石。"
    },
    {
      "paragraph_id": "c-nanshi-019-nan19:zhan-l044",
      "start": 68,
      "end": 71,
      "surface": "吳興郡",
      "quote": "帝欲以瞻爲吳興郡，又自陳請，乃爲豫章太守。"
    },
    {
      "paragraph_id": "c-nanshi-019-nan19:zhan-l044",
      "start": 79,
      "end": 81,
      "surface": "豫章",
      "quote": "帝欲以瞻爲吳興郡，又自陳請，乃爲豫章太守。"
    },
    {
      "paragraph_id": "c-nanshi-019-nan19:zhan-l046",
      "start": 43,
      "end": 45,
      "surface": "在郡",
      "quote": "永初二年，在郡遇疾不療，幸於不永。"
    },
    {
      "paragraph_id": "c-nanshi-019-nan19:zhan-l048",
      "start": 22,
      "end": 24,
      "surface": "南郡",
      "quote": "瞻疾篤還都，帝以晦禁旅，不得出宿，使瞻居於晉南郡公主婿羊賁故第，在領軍府東門。"
    },
    {
      "paragraph_id": "c-nanshi-019-nan19:zhan-l048",
      "start": 27,
      "end": 31,
      "surface": "羊賁故第",
      "quote": "瞻疾篤還都，帝以晦禁旅，不得出宿，使瞻居於晉南郡公主婿羊賁故第，在領軍府東門。"
    },
    {
      "paragraph_id": "c-nanshi-019-nan19:zhan-l048",
      "start": 33,
      "end": 38,
      "surface": "領軍府東門",
      "quote": "瞻疾篤還都，帝以晦禁旅，不得出宿，使瞻居於晉南郡公主婿羊賁故第，在領軍府東門。"
    },
