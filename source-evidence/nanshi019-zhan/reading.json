  "anonymous_and_group_occurrences": [
    {
      "paragraph_id": "c-nanshi-019-nan19:p002",
      "id": "c-nanshi-019-nan19:p002:m0035",
      "start": 35,
      "end": 39,
      "surface": "當時才士",
      "quote": "六歲能屬文，爲紫石英贊、果然詩，爲當時才士歎異。",
      "note": "當時讀詩諸人，未逐名"
    },
    {
      "paragraph_id": "c-nanshi-019-nan19:p002",
      "id": "c-nanshi-019-nan19:p002:m0078",
      "start": 78,
      "end": 80,
      "surface": "三絕",
      "quote": "王弘在坐，以爲三絕。",
      "note": "詩、書寫與吟詠三者並稱，分別為瞻、靈運及混，非三個別名"
    },
    {
      "paragraph_id": "c-nanshi-019-nan19:zhan-l042",
      "id": "c-nanshi-019-nan19:zhan-l042:m0012",
      "start": 12,
      "end": 14,
      "surface": "兄弟",
      "quote": "瞻幼孤，叔母劉撫養有恩，兄弟事之同於至親。",
      "note": "以謝瞻及其兄弟為主語，未列全員"
    },
    {
      "paragraph_id": "c-nanshi-019-nan19:zhan-l042",
      "id": "c-nanshi-019-nan19:zhan-l042:m0091",
      "start": 91,
      "end": 93,
      "surface": "賓客",
      "quote": "晦時爲宋臺右衛，權遇已重，於彭城還都迎家，賓客輻湊。",
      "note": "拜訪謝家者"
    },
    {
      "paragraph_id": "c-nanshi-019-nan19:zhan-l042",
      "id": "c-nanshi-019-nan19:zhan-l042:m0268",
      "start": 268,
      "end": 270,
      "surface": "君子",
      "quote": "君子以明哲保身，其在此乎。",
      "note": "引通義"
    },
    {
      "paragraph_id": "c-nanshi-019-nan19:zhan-l044",
      "id": "c-nanshi-019-nan19:zhan-l044:m0017",
      "start": 17,
      "end": 19,
      "surface": "父祖",
      "quote": "及還彭城，言於武帝曰：「臣本素士，父祖位不過二千石。",
      "note": "指謝瞻父祖；本卷前文朗子重、重生瞻可對讀，不將二千石分為各人的確切官職"
    },
    {
      "paragraph_id": "c-nanshi-019-nan19:zhan-l046",
      "id": "c-nanshi-019-nan19:zhan-l046:m0013",
      "start": 13,
      "end": 15,
      "surface": "親舊",
      "quote": "晦或以朝廷密事語瞻，瞻輒向親舊說以爲戲笑，以絕其言。",
      "note": "受告者未逐名"
    },
    {
      "paragraph_id": "c-nanshi-019-nan19:zhan-l046",
      "id": "c-nanshi-019-nan19:zhan-l046:m0096",
      "start": 96,
      "end": 97,
      "surface": "者",
      "quote": "」時果有詐告晦反者。",
      "note": "匿名誣告者"
    },
    {
      "paragraph_id": "c-nanshi-019-nan19:zhan-l048",
      "id": "c-nanshi-019-nan19:zhan-l048:m0045",
      "start": 45,
      "end": 47,
      "surface": "先人",
      "quote": "瞻曰：「吾有先人弊廬，何爲於此？",
      "note": "先人所遺居處，不定父或祖"
    },
    {
      "paragraph_id": "c-nanshi-019-nan19:zhan-l050",
      "id": "c-nanshi-019-nan19:zhan-l050:m0039",
      "start": 39,
      "end": 41,
      "surface": "人物",
      "quote": "靈運父瑍無才能，爲祕書郎早卒，而靈運好臧否人物。",
      "note": "品評對象泛稱"
    },
    {
      "paragraph_id": "c-nanshi-019-nan19:zhan-l050",
      "id": "c-nanshi-019-nan19:zhan-l050:m0075",
      "start": 75,
      "end": 76,
      "surface": "等",
      "quote": "」乃與晦、曜、弘微等共遊戲，使瞻與靈運共車。",
      "note": "同行諸人未列全"
    },
    {
      "paragraph_id": "c-nanshi-019-nan19:zhan-l050",
      "id": "c-nanshi-019-nan19:zhan-l050:m0095",
      "start": 95,
      "end": 97,
      "surface": "人物",
      "quote": "靈運登車便商較人物，瞻謂曰：「祕書早亡，談者亦互有同異。",
      "note": "議論對象泛稱"
    },
    {
      "paragraph_id": "c-nanshi-019-nan19:zhan-l050",
      "id": "c-nanshi-019-nan19:zhan-l050:m0108",
      "start": 108,
      "end": 110,
      "surface": "談者",
      "quote": "靈運登車便商較人物，瞻謂曰：「祕書早亡，談者亦互有同異。",
      "note": "評其才能者未名"
    }
