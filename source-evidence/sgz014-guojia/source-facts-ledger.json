  "items": [
    {
      "paragraph_id": "c-sanguozhi-014-guojia:p001",
      "quote": "郭嘉字奉孝潁川陽翟人也",
      "start": 0,
      "end": 11,
      "category": "name_and_origin",
      "status": "candidate_not_runtime_assertion",
      "boundary": "明字奉孝及籍貫，後批typed；不套給兒孫"
    },
    {
      "paragraph_id": "c-sanguozhi-014-guojia:p002",
      "quote": "年二十七辟司徒府",
      "start": 41,
      "end": 49,
      "category": "reported_age_and_recruitment",
      "status": "candidate_not_runtime_assertion",
      "boundary": "傅子/傳子注，不當本傳卒齡、不倒生年"
    },
    {
      "paragraph_id": "c-sanguozhi-014-guojia:p003",
      "quote": "表為司空軍祭酒",
      "start": 156,
      "end": 163,
      "category": "office",
      "status": "candidate_not_runtime_assertion",
      "boundary": "主體太祖表嘉；無明任始年"
    },
    {
      "paragraph_id": "c-sanguozhi-014-guojia:p009",
      "quote": "封嘉洧陽亭侯",
      "start": 145,
      "end": 151,
      "category": "rank",
      "status": "candidate_not_runtime_assertion",
      "boundary": "不以冀州平背景任意補精確始年"
    },
    {
      "paragraph_id": "c-sanguozhi-014-guojia:p011",
      "quote": "年三十八自柳城還疾篤",
      "start": 271,
      "end": 281,
      "category": "reported_age",
      "status": "candidate_not_runtime_assertion",
      "boundary": "本傳卒事前報齡38，不反推生年"
    },
    {
      "paragraph_id": "c-sanguozhi-014-guojia:p011",
      "quote": "及薨臨其喪哀甚",
      "start": 288,
      "end": 295,
      "category": "death",
      "status": "candidate_not_runtime_assertion",
      "boundary": "接郭嘉病篤，無明年號；本包不換算死亡年"
    },
    {
      "paragraph_id": "c-sanguozhi-014-guojia:p011",
      "quote": "可增邑八百尸并前千户",
      "start": 386,
      "end": 396,
      "category": "grant_count",
      "status": "candidate_not_runtime_assertion",
      "boundary": "原尸/户保原，不默正字；未typed增邑數量"
    },
    {
      "paragraph_id": "c-sanguozhi-014-guojia:p013",
      "quote": "諡曰貞侯子奕嗣",
      "start": 0,
      "end": 7,
      "category": "posthumous_and_succession",
      "status": "candidate_not_runtime_assertion",
      "boundary": "諡嘉貞侯；子奕不等於嘉只有一子"
    },
    {
      "paragraph_id": "c-sanguozhi-014-guojia:p014",
      "quote": "奕字伯益見王昶家誡",
      "start": 8,
      "end": 17,
      "category": "name_and_cross_chapter",
      "status": "candidate_not_runtime_assertion",
      "boundary": "接027潁川郭伯益，不合泰業/大業"
    },
    {
      "paragraph_id": "c-sanguozhi-014-guojia:p018",
      "quote": "年不滿四十相與周旋十二年",
      "start": 16,
      "end": 28,
      "category": "reported_age_upper_bound",
      "status": "candidate_not_runtime_assertion",
      "boundary": "曹操追傷書，與38並存，不作周歲或同一數字"
    },
    {
      "paragraph_id": "c-sanguozhi-014-guojia:p019",
      "quote": "奕為太子文學早薨子深嗣深薨子獵嗣",
      "start": 0,
      "end": 16,
      "category": "offspring_office_deaths",
      "status": "candidate_not_runtime_assertion",
      "boundary": "奕受官；深/獵兩明子序，不推唯一子或絕對排行/日期"
    },
    {
      "paragraph_id": "c-sanguozhi-014-guojia:p020",
      "quote": "嘉孫敞字泰中有才識位散騎常侍",
      "start": 3,
      "end": 17,
      "category": "grandson_style_office",
      "status": "candidate_not_runtime_assertion",
      "boundary": "敞明嘉孫但父未名，不選奕/深作父"
    }
