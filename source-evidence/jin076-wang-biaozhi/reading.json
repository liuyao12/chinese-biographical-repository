  "comparisons": [
    {
      "anchor": {
        "paragraph_id": "c-jinshu-076-wangbiaozhi:line055",
        "start": 0,
        "end": 5,
        "surface": "彪之字叔武"
      },
      "reading": "本傳武，王氏譜虎；譜小字虎犢，本傳外號王白須，譜本王白鬚。",
      "sources": [
        {
          "witness": "qing",
          "quote": "虎犢，彪之小字也。彪之字叔虎，彭之第三弟。年二十而頭鬚皓白，時人謂之王白鬚。",
          "raw_start": 1648,
          "raw_end": 1686,
          "raw_line": 16
        }
      ]
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-076-wangbiaozhi:line055",
        "start": 36,
        "end": 41,
        "surface": "從伯導謂曰"
      },
      "reading": "劉注引王彪之別傳重見同一人及所談尚書郎。",
      "sources": [
        {
          "witness": "fang",
          "quote": "{{ProperNoun|彪之}}從伯{{ProperNoun|導}}謂{{ProperNoun|彪}}之曰：『選曹舉汝爲尚書郎，幸可作諸王佐邪？』",
          "raw_start": 33065,
          "raw_end": 33139,
          "raw_line": 48
        }
      ]
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-076-wangbiaozhi:line079",
        "start": 156,
        "end": 163,
        "surface": "溫又廢武陵王遵"
      },
      "reading": "本傳與殿本作遵。本紀記溫奏廢晞；王晞傳記三子及遵繼嗣。保留事件指涉晞與原文用名。",
      "sources": [
        {
          "witness": "ann",
          "quote": "溫奏廢太宰、武陵王晞及子總",
          "raw_start": 1120,
          "raw_end": 1133,
          "raw_line": 21
        },
        {
          "witness": "jin64",
          "quote": "晞三子：綜、㻱、遵。以遵嗣。",
          "raw_start": 5051,
          "raw_end": 5065,
          "raw_line": 81
        }
      ]
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-076-wangbiaozhi:line083",
        "start": 58,
        "end": 65,
        "surface": "又頻使巨集改之"
      },
      "reading": "固定本巨集映袁宏，殿本兩處皆宏；劉注引安帝紀亦直書袁宏，記謝安使具草。",
      "sources": [
        {
          "witness": "yan",
          "quote": "{{ProperNoun|温}}在{{ProperNoun|姑孰}}，諷朝廷，求九錫。{{ProperNoun|謝安}}使吏部郎{{ProperNoun|袁宏}}具其草，以示-{僕}-射{{ProperNoun|王彪之}}。{{ProperNoun|彪之}}作色曰：『丈夫豈可以此事語人邪？』{{ProperNoun|安}}徐問其計。{{ProperNoun|彪之}}曰：『聞其疾已篤，且可緩其事。』{{ProperNoun|安}}從之，故不行。",
          "raw_start": 58564,
          "raw_end": 58787,
          "raw_line": 103
        }
      ]
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-076-wangbiaozhi:line087",
        "start": 243,
        "end": 254,
        "surface": "故終彪之之世，不改營焉"
      },
      "reading": "本傳載彪之反對更營，徐廣晉紀載寧康二年（374）王彪之等啓改，太元三年（378）始築。本紀記彪之太元二年冬卒。",
      "sources": [
        {
          "witness": "fang",
          "quote": "{{ProperNoun|孝武}}{{ProperNoun|-{寧}-康}}二年，尚書令{{ProperNoun|王彪之}}等啓改作新宮。{{ProperNoun|太元}}三年二月，内外軍六千人始營-{築}-，至七月而成。",
          "raw_start": 37994,
          "raw_end": 38105,
          "raw_line": 64
        },
        {
          "witness": "ann",
          "quote": "壬寅。散騎常侍、左光祿大夫、尚書令王彪之卒。",
          "raw_start": 5377,
          "raw_end": 5399,
          "raw_line": 142
        }
      ]
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-076-wangbiaozhi:line089",
        "start": 70,
        "end": 77,
        "surface": "臨之，東陽太守"
      },
      "reading": "王准之本傳追敘曾祖彪之，祖臨之與父訥之並御史中丞；晉書記臨之東陽太守，資料各按來源。",
      "sources": [
        {
          "witness": "nan",
          "quote": "王准之字元魯，晉尚書僕射彬玄孫也。曾祖彪之，位尚書令，祖臨之、父訥之並御史中丞。",
          "raw_start": 7335,
          "raw_end": 7375,
          "raw_line": 153
        }
      ]
    },
    {
      "anchor": {
        "paragraph_id": "c-jinshu-076-wangbiaozhi:line089",
        "start": 37,
        "end": 47,
        "surface": "太元二年卒，年七十三"
      },
      "reading": "本紀同年十月壬寅，卒時稱左光祿大夫；本傳加光祿大夫未拜，卒後以光祿贈。",
      "sources": [
        {
          "witness": "ann",
          "quote": "壬寅。散騎常侍、左光祿大夫、尚書令王彪之卒。",
          "raw_start": 5377,
          "raw_end": 5399,
          "raw_line": 142
        }
      ]
    }
  ],
