  "reading_cases": [
    {
      "paragraph_id": "c-jinshu-076-wangbiaozhi:line059",
      "start": 27,
      "end": 29,
      "surface": "奚郎",
      "reading": "殿本初出、下文皆朗。本修訂初郎後朗，保留舊人號。"
    },
    {
      "paragraph_id": "c-jinshu-076-wangbiaozhi:line061",
      "start": 189,
      "end": 191,
      "surface": "猖蹶",
      "reading": "殿本無故下用匆促義疊字，原讀存疑；固定本作匆匆。"
    },
    {
      "paragraph_id": "c-jinshu-076-wangbiaozhi:line067",
      "start": 155,
      "end": 159,
      "surface": "凡余諸官",
      "reading": "余為剩餘的官，非自稱。"
    },
    {
      "paragraph_id": "c-jinshu-076-wangbiaozhi:line069",
      "start": 70,
      "end": 74,
      "surface": "不復人宮",
      "reading": "殿本不復入宮。"
    },
    {
      "paragraph_id": "c-jinshu-076-wangbiaozhi:line071",
      "start": 15,
      "end": 20,
      "surface": "苻健、苻眉",
      "reading": "詐言害人，不作死亡。清刻字苻堅，固定本苻健；事件同讀，字形有異，未據清刻改固定錄文。"
    },
    {
      "paragraph_id": "c-jinshu-076-wangbiaozhi:line071",
      "start": 116,
      "end": 119,
      "surface": "張、陳",
      "reading": "本傳、殿本均只給張、陳兩姓。以謀臣稱，張良陳平候選，暫保留舊未定兩號。"
    },
    {
      "paragraph_id": "c-jinshu-076-wangbiaozhi:line073",
      "start": 53,
      "end": 58,
      "surface": "簡文以彪之",
      "reading": "殿本簡文以問彪之。"
    },
    {
      "paragraph_id": "c-jinshu-076-wangbiaozhi:line079",
      "start": 3,
      "end": 7,
      "surface": "復僕為射",
      "reading": "殿本復為僕射。"
    },
    {
      "paragraph_id": "c-jinshu-076-wangbiaozhi:line079",
      "start": 97,
      "end": 100,
      "surface": "作元凱",
      "reading": "舊身份暫繫杜預（字元凱），兩本只有元凱。亦可能為高陽、高辛時八元八凱的群臣用典，此處缺明文。"
    },
    {
      "paragraph_id": "c-jinshu-076-wangbiaozhi:line085",
      "start": 92,
      "end": 96,
      "surface": "從嫂臨朝",
      "reading": "褚太后為孝武帝父簡文的兄子康帝之妻；此處僅記說話人的原稱與指涉。"
    },
    {
      "paragraph_id": "c-jinshu-076-wangbiaozhi:line089",
      "start": 62,
      "end": 78,
      "surface": "越之，撫軍參軍；臨之，東陽太守。",
      "reading": "二子所列分任二官。"
    }
  ]
}
