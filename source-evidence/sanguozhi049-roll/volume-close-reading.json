  "edition_notes": [
    {
      "location": "考證首葉上",
      "reading": "劉寵續漢書山陰「民」正舊本「氏」；毛本「入居九列」。濟南相「循」冊府作「脩」。劉繇兵眾殿本作萬餘，宋本及數位見證作數萬。朱皓注「命」冊府無，數位以括號存命。"
    },
    {
      "location": "考證首葉上尾",
      "reading": "笮融殺趙昱，殿考證正監本誤作「阻誅」。"
    },
    {
      "location": "考證首葉下",
      "reading": "太史慈「通章」監本作「有章」，裴注「不達」宋本作「不遵」。太史享殿考證校監本「亨」為「享」。吳書注士壹「入關」，考證疑「閣」；士武海南，宋本作南海。"
    },
    {
      "location": "考證首葉下至次葉上",
      "reading": "葛洪書殿本「捧其頤搖稍之」，考證疑稍當作捎並釋捧頭搖動；數位作「捧其头摇（捎）之」。雍闓遙東附，考證校監本搖字。卷末評「阻險」，毛本無阻。"
    }
  ],
  "parallel_readings": [
    "呂岱傳說士徽先受九真任，及出拒戴良。士燮傳詳士徽自署交阯，明桓治為被殺桓鄰之兄，又明士匡居間與孫盛評。兩傳事件先後與官名各存。",
    "薛綜上疏說朱符遭逐走海流亡，士燮傳說為夷賊所殺；措辭分別出於奏疏與正文，保留兩引。"
  ],
