      "end_codepoint": 32,
      "human_reviewed": false
    },
    {
      "id": "c-liangshu-016-wangliang-family-clauses:received_sentence4-32",
      "kind": "received_sentence",
      "person_id": "7r6_k52_qji_ABAACAABDA",
      "source_quote": "及城內旣定，獨推亮爲首。",
      "reading": "城定後獨推亮為首。",
      "note": "城定後獨推亮為首。",
