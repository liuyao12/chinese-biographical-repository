  "items": [
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:p001",
        "start": 0,
        "end": 23,
        "quote": "王導，字茂弘，光祿大夫覽之孫也。父裁，鎮軍司馬"
      },
      "reading": "王覽孫、王裁子，從兄王敦；十四歲為陳留高士張公所識，張公全名未載。初襲祖爵即丘子。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:p001",
        "start": 92,
        "end": 109,
        "quote": "遷秘書郎、太子舍人、尚書郎，並不行"
      },
      "reading": "前列東閣祭酒等依原有未受項目處理；參東海王越軍事另敘。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line014",
        "start": 273,
        "end": 283,
        "quote": "顧榮、賀循，此土之望"
      },
      "reading": "三月上巳窺視者為紀瞻、顧榮；後召顧榮、賀循，「二子」「二人」均指後二人。不可換成前組。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line016",
        "start": 84,
        "end": 90,
        "quote": "號爲「仲父」"
      },
      "reading": "仲父為當時對王導的敬稱。元帝以蕭何比王導，導舉管仲、樂毅以及江南俊傑為答。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line016",
        "start": 256,
        "end": 272,
        "quote": "顧榮、賀循、紀贍、周圮皆南土之秀"
      },
      "reading": "固定本紀贍、周圮。武英殿兩字作瞻、玘。卷68與卷58本傳亦能與同一時地、同事顧榮交證，周玘與汝南周顗分號。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line018",
        "start": 32,
        "end": 41,
        "quote": "荀文若，功臣之最也"
      },
      "reading": "王導上箋引曹操、荀彧、曹沖為對比，並非東晉同一項授官。寡、孤等須依發話者。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line018",
        "start": 248,
        "end": 260,
        "quote": "湣帝即位，征吏部郎，不拜"
      },
      "reading": "對王導的徵命未受。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line020",
        "start": 80,
        "end": 90,
        "quote": "向見管夷吾，無復憂矣"
      },
      "reading": "桓彝向周顗以管夷吾比王導；《世說》相似語歸於溫嶠。原典人物與受比對象另記。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line020",
        "start": 110,
        "end": 117,
        "quote": "周顗中坐而歎曰"
      },
      "reading": "新亭周顗歎山河之異，王導有楚囚之語；與世說言語分原句互校。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line022",
        "start": 12,
        "end": 16,
        "quote": "導上書曰"
      },
      "reading": "引下設學奏書，行24、26為奏本內容，行28復敘。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line024",
        "start": 265,
        "end": 269,
        "quote": "孟軻所謂"
      },
      "reading": "奏書引易、周禮、孟軻；父子兄弟、王與世子在禮制論述中均為類稱。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line026",
        "start": 105,
        "end": 112,
        "quote": "殿下以命世之資"
      },
      "reading": "上書對元帝為晉王時。「文武之道」有文王武王／文治武功二讀；不從現有短詞强定人物。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line028",
        "start": 0,
        "end": 4,
        "quote": "帝甚納之"
      },
      "reading": "承設學上書，帝為元帝。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line030",
        "start": 11,
        "end": 18,
        "quote": "命導升御床共坐"
      },
      "reading": "導固辭同坐非登位，仍進驃騎大將軍等。華軼之功封武岡侯，舉羊鑒敗績請貶未許。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line030",
        "start": 240,
        "end": 244,
        "quote": "導始啟立"
      },
      "reading": "啟立史官；又議孝懷太子三朝之哀。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line032",
        "start": 66,
        "end": 75,
        "quote": "逆臣賊子，何世無之"
      },
      "reading": "王敦起兵，導率從族待罪。逆臣為類稱；「臣族」之臣才是導自稱。臨末「不從吾言」為敦對導。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line034",
        "start": 65,
        "end": 78,
        "quote": "自後公卿無爵而諡，導所議也"
      },
      "reading": "奏疏論無爵之公卿議諡，非特定人物的賜諡清單。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line036",
        "start": 0,
        "end": 15,
        "quote": "初，帝愛琅邪王裒，將有奪嫡之議"
      },
      "reading": "本傳爭於紹、裒之間；早期世說正文載欲立簡文，其劉注所引中興書及注者案語另說裒。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line036",
        "start": 102,
        "end": 116,
        "quote": "導便率子弟發哀，眾聞，謂敦死"
      },
      "reading": "敦病時導先假發哀安軍心，不能當敦實際卒日；明帝崩以後導與庾亮輔成帝。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line038",
        "start": 189,
        "end": 200,
        "quote": "導乃攜二子隨永奔于白石"
      },
      "reading": "奔者導、二子、路永。二子本段無名，不能拿六子名單或首二子補入。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line040",
        "start": 13,
        "end": 20,
        "quote": "溫嶠議遷都豫章"
      },
      "reading": "對手不同建議：溫嶠豫章；三吳豪會稽；導主留建康，以孫仲謀、劉玄德等前言為據。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line042",
        "start": 49,
        "end": 59,
        "quote": "乃與朝賢俱制練布單衣"
      },
      "reading": "導倡練布衣，售庫練濟國用，主者未具名。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line044",
        "start": 0,
        "end": 11,
        "quote": "六年冬，烝，詔歸胙於導"
      },
      "reading": "年號本句未出，另與成帝紀同時代編年對讀；毋以成帝拜導推君臣親屬。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line046",
        "start": 42,
        "end": 55,
        "quote": "朕荷祖宗之重，托于王公之上"
      },
      "reading": "詔中朕、予為成帝，王公為泛指。「公體道」「公宜」所指是受詔的導。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line048",
        "start": 16,
        "end": 24,
        "quote": "帝知之，給布萬匹"
      },
      "reading": "成帝賜導布，另載幸其府，令導輿車入殿。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line050",
        "start": 72,
        "end": 82,
        "quote": "依漢制罷司徒官以並之"
      },
      "reading": "導既拜丞相，並罷司徒官，與先後大司馬及中外大都督分開。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line052",
        "start": 3,
        "end": 13,
        "quote": "妻曹氏卒，贈金章紫綬"
      },
      "reading": "導妻曹淑据世說德行劉注王氏譜。蔡謨戲稱九錫，不建實賞；蔡克兒是謨。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line054",
        "start": 93,
        "end": 99,
        "quote": "庾公帝之元舅"
      },
      "reading": "導書與陶稱說庾亮是成帝舅。另有或勸導者姓名不見；「如君言」不可據為陶稱。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line056",
        "start": 13,
        "end": 21,
        "quote": "導以元帝睠同布衣"
      },
      "reading": "導每進位拜元帝陵，是元帝君臣恩舊，非父子。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line058",
        "start": 0,
        "end": 11,
        "quote": "咸康五年薨，時年六十四"
      },
      "reading": "殿本九下作咸和，中宗肅祖為元明二帝；成帝紀有咸康五年七月庚申王導薨。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line058",
        "start": 388,
        "end": 398,
        "quote": "錫諡曰文獻，祠乙太牢"
      },
      "reading": "文獻是王導諡，任瞻為奉冊者；殿本十上作祠以太牢。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:p002",
        "start": 34,
        "end": 49,
        "quote": "導六子：悅、恬、洽、協、邵、薈"
      },
      "reading": "王導傳收尾列六子，兩弟穎敞共敘由對讀包覆核。原文邵與本卷其小傳劭並存。"
    },
    {
      "source": {
        "paragraph_id": "c-jinshu-065-wangdao-family:line116",
        "start": 25,
        "end": 32,
        "quote": "淮水絶，王氏滅"
      },
      "reading": "廞傳後回敘王導請郭璞筮淮，卦辭及史家評述分列。王氏指家族，非個人事件或已證亡族。"
    }
  ],
