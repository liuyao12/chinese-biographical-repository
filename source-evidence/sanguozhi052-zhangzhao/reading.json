  "source_clauses": [
    {
      "witness": "sg",
      "quote": "張昭字子布，彭城人也。",
      "raw_start": 229,
      "raw_end": 240,
      "raw_line": 12
    },
    {
      "witness": "sg",
      "quote": "昭与孙绍、滕胤、郑礼等，采周、汉，撰定朝仪。",
      "raw_start": 1698,
      "raw_end": 1720,
      "raw_line": 14
    },
    {
      "witness": "sg",
      "quote": "臣松之以为张昭劝迎曹公",
      "raw_start": 2069,
      "raw_end": 2080,
      "raw_line": 18
    },
    {
      "witness": "sg",
      "quote": "习凿齿曰：张昭於是乎不臣矣！",
      "raw_start": 2972,
      "raw_end": 2986,
      "raw_line": 22
    },
    {
      "witness": "sg",
      "quote": "余曩闻刘荆州尝自作书欲与孙伯符",
      "raw_start": 3225,
      "raw_end": 3240,
      "raw_line": 24
    },
    {
      "witness": "sg7",
      "quote": "孫策遣軍攻登於匡琦城。",
      "raw_start": 7692,
      "raw_end": 7703,
      "raw_line": 41
    },
    {
      "witness": "sg13",
      "quote": "王朗字景興，東海郡人也。",
      "raw_start": 10721,
      "raw_end": 10733,
      "raw_line": 43
    },
    {
      "witness": "sg47",
      "quote": "合肥，使張昭攻九江之當塗。",
      "raw_start": 2532,
      "raw_end": 2545,
      "raw_line": 26
    },
    {
      "witness": "sg47",
      "quote": "討逆將軍策爲長沙桓王。",
      "raw_start": 14333,
      "raw_end": 14344,
      "raw_line": 77
    },
    {
      "witness": "sg47",
      "quote": "丞相[[w:孫邵|孫邵]]卒。",
      "raw_start": 12142,
      "raw_end": 12157,
      "raw_line": 65
    },
    {
      "witness": "sg47",
      "quote": "輔吳將軍張昭卒。",
      "raw_start": 19002,
      "raw_end": 19010,
      "raw_line": 97
    },
    {
      "witness": "sg50",
      "quote": "孫破虜吳夫人，吳主權母也。",
      "raw_start": 213,
      "raw_end": 226,
      "raw_line": 12
    },
    {
      "witness": "sg54",
      "quote": "魯肅字子敬，臨淮東城人也。",
      "raw_start": 5353,
      "raw_end": 5366,
      "raw_line": 41
    },
    {
      "witness": "sg64",
      "quote": "滕胤字承嗣，北海劇人也。",
      "raw_start": 8607,
      "raw_end": 8619,
      "raw_line": 65
    },
    {
      "witness": "yin",
      "quote": "三月，公及邾儀父盟于蔑，邾子克也。",
      "raw_start": 360,
      "raw_end": 377,
      "raw_line": 35
    },
    {
      "witness": "j76",
      "quote": "吳輔吳將軍昭之曾孫也。",
      "raw_start": 9738,
      "raw_end": 9749,
      "raw_line": 129
    },
    {
      "witness": "ss",
      "quote": "闓字敬緒，丹陽人，張昭孫也。",
      "raw_start": 3826,
      "raw_end": 3840,
      "raw_line": 21
    }
  ],
