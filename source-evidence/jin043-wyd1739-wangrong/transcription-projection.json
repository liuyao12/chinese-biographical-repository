{
  "raw_sha256": "a83b9c867852fb34a0ed3e4b9e9ec76b1edc7c4e7c527aed81153a898ce624ae",
  "units": [
    {
      "key": "unit001",
      "layer": "received_chapter",
      "raw_window": [
        1,
        1
      ],
      "raw_runs": [
        {
          "raw_line": 1,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "王戎字濬沖琅邪臨沂人也祖雄幽州刺史父渾涼州"
        }
      ],
      "text_sha256": "84ae5a4bd97b1d7519f5b037f59884b948420cd4be822a53dc9f78456d9a14a8"
    },
    {
      "key": "unit002",
      "layer": "received_chapter",
      "raw_window": [
        2,
        11
      ],
      "raw_runs": [
        {
          "raw_line": 2,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "刺史貞陵亭侯戎幼而穎悟神彩秀徹視日不眩裴楷"
        },
        {
          "raw_line": 3,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "見而目之曰戎眼爛爛如巖下電年六七歲於宣武場"
        },
        {
          "raw_line": 4,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "觀戲猛獸在檻中虓吼震地衆皆奔走戎獨立不動神"
        },
        {
          "raw_line": 5,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "色自若魏明帝於閣上見而奇之又嘗與羣兒戲於道"
        },
        {
          "raw_line": 6,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "側見李樹多實等輩競趣之戎獨不往或問其故戎曰"
        },
        {
          "raw_line": 7,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "樹在道邊而多子必苦李也取之信然阮籍與渾為友"
        },
        {
          "raw_line": 8,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "戎年十五隨渾在郎舍戎少籍二十歲而籍與之交籍"
        },
        {
          "raw_line": 9,
          "raw_start": 0,
          "raw_end": 21,
          "start": 147,
          "end": 168,
          "surface": "每適渾俄頃輒去過視戎良久然後出謂渾曰濬沖清"
        },
        {
          "raw_line": 10,
          "raw_start": 0,
          "raw_end": 21,
          "start": 168,
          "end": 189,
          "surface": "賞非卿倫也共卿言不如共阿戎談及渾卒於涼州故"
        },
        {
          "raw_line": 11,
          "raw_start": 0,
          "raw_end": 21,
          "start": 189,
          "end": 210,
          "surface": "吏賻贈數百萬戎辭而不受由是顯名為人短小任率"
        }
      ],
      "text_sha256": "861ab60ff85c09032b6b4e45b6273c937f51ddc753080e0ff3f69a00e5a80381"
    },
    {
      "key": "unit003",
      "layer": "received_chapter",
      "raw_window": [
        12,
        21
      ],
      "raw_runs": [
        {
          "raw_line": 12,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "不修威儀善發談端賞其要會朝賢嘗上巳〓洛或問"
        },
        {
          "raw_line": 13,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "王濟曰昨游有何言談濟曰張華善說史漢裴頠論前"
        },
        {
          "raw_line": 14,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "言往行衮衮可聽王戎談子房季札之間超然玄著其"
        },
        {
          "raw_line": 15,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "為識鑒者所賞如此戎嘗與阮籍飲時兗州刺史劉昶"
        },
        {
          "raw_line": 16,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "字公榮在坐籍以酒少酌不及昶昶無恨色戎異之他"
        },
        {
          "raw_line": 17,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "日問籍曰彼何如人也答曰勝公榮不可不與飲若減"
        },
        {
          "raw_line": 18,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "公榮則不敢不共飲惟公榮可不與飲戎每與籍為竹"
        },
        {
          "raw_line": 19,
          "raw_start": 0,
          "raw_end": 21,
          "start": 147,
          "end": 168,
          "surface": "林之游戎嘗後至籍曰俗物已復來敗人意戎笑曰卿"
        },
        {
          "raw_line": 20,
          "raw_start": 0,
          "raw_end": 21,
          "start": 168,
          "end": 189,
          "surface": "輩意亦復易敗耳鍾會伐蜀過與戎別問計將安出戎"
        },
        {
          "raw_line": 21,
          "raw_start": 0,
          "raw_end": 21,
          "start": 189,
          "end": 210,
          "surface": "曰道家有言為而不恃非成功難保之難也及會敗議"
        }
      ],
      "text_sha256": "0d374c7a384c538a14593bca1f7768785c44bb39b4eac52838ab2e101b0c0612"
    },
    {
      "key": "unit004",
      "layer": "received_chapter",
      "raw_window": [
        22,
        31
      ],
      "raw_runs": [
        {
          "raw_line": 22,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "者以為知言襲父爵辟相國掾歷吏部黃門郎散騎常"
        },
        {
          "raw_line": 23,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "侍河東太守荆州刺史坐遣吏修園宅應免官詔以贖"
        },
        {
          "raw_line": 24,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "論遷豫州刺史加建威將軍受詔伐吳戎遣參軍羅尚"
        },
        {
          "raw_line": 25,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "劉喬領前鋒進攻武昌吳將楊雍孫述江夏太守劉朗"
        },
        {
          "raw_line": 26,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "各率衆詣戎降戎督大軍臨江吳牙門將孟泰以蘄春"
        },
        {
          "raw_line": 27,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "邾二縣降吳平進爵安豐縣侯增邑六千戶賜絹六千"
        },
        {
          "raw_line": 28,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "匹戎渡江綏慰新附宣揚威惠吳光祿勲石偉方直不"
        },
        {
          "raw_line": 29,
          "raw_start": 0,
          "raw_end": 21,
          "start": 147,
          "end": 168,
          "surface": "容皓朝稱疾歸家戎嘉其清節表薦之詔拜偉為議郎"
        },
        {
          "raw_line": 30,
          "raw_start": 0,
          "raw_end": 21,
          "start": 168,
          "end": 189,
          "surface": "以二千石祿終其身荆土悅服徵為侍中南郡太守劉"
        },
        {
          "raw_line": 31,
          "raw_start": 0,
          "raw_end": 21,
          "start": 189,
          "end": 210,
          "surface": "肇賂戎筩中細布五十端為司隸所糾以知而未納故"
        }
      ],
      "text_sha256": "8ccf9d03a342b97ef24ba5d4bbf7d00732eba842cf72373eb0befd86c5f2ce72"
    },
    {
      "key": "unit005",
      "layer": "received_chapter",
      "raw_window": [
        32,
        41
      ],
      "raw_runs": [
        {
          "raw_line": 32,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "得不坐然議者尤之帝謂朝臣曰戎之為行豈懷私苟"
        },
        {
          "raw_line": 33,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "得正當不欲為異耳帝雖以是言釋之然為清愼者所"
        },
        {
          "raw_line": 34,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "鄙由是損名戎在職雖無殊能而庶績脩理後遷光祿"
        },
        {
          "raw_line": 35,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "勲吏部尚書以母憂去職性至孝不拘禮制飲酒食肉"
        },
        {
          "raw_line": 36,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "或觀奕棊而容親毀悴杖然後起裴頠往弔之謂人曰"
        },
        {
          "raw_line": 37,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "若使一慟能傷人濬沖不免滅性之譏也時和嶠亦居"
        },
        {
          "raw_line": 38,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "父喪以禮法自持量米而食哀毁不踰於戎帝謂劉毅"
        },
        {
          "raw_line": 39,
          "raw_start": 0,
          "raw_end": 21,
          "start": 147,
          "end": 168,
          "surface": "曰和嶠毀頓過禮使人憂之毅曰嶠雖寢苫食粥乃生"
        },
        {
          "raw_line": 40,
          "raw_start": 0,
          "raw_end": 21,
          "start": 168,
          "end": 189,
          "surface": "孝耳至於王戎所謂死孝陛下當先憂之戎先有吐疾"
        },
        {
          "raw_line": 41,
          "raw_start": 0,
          "raw_end": 21,
          "start": 189,
          "end": 210,
          "surface": "居喪增甚帝遣醫療之并賜藥物又斷賓客楊駿執政"
        }
      ],
      "text_sha256": "db4e212ea1333d3747d600d594683b0f41c836147c1440b1dcdb4b8861e04f86"
    },
    {
      "key": "unit006",
      "layer": "received_chapter",
      "raw_window": [
        42,
        51
      ],
      "raw_runs": [
        {
          "raw_line": 42,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "拜太子太傅駿誅之後東安公繇專斷刑賞威振外內"
        },
        {
          "raw_line": 43,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "戎誡繇曰大事之後宜深遠之繇不從果得罪轉中書"
        },
        {
          "raw_line": 44,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "令加光祿大夫給恩信五十人遷尚書左僕射領吏部"
        },
        {
          "raw_line": 45,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "戎始為甲午制凡選舉皆先治百姓然後授用司隸傅"
        },
        {
          "raw_line": 46,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "咸奏戎曰書稱三載考績三載黜陟幽明今內外羣官"
        },
        {
          "raw_line": 47,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "居職未期而戎奏還既未定其優劣且送故迎新相望"
        },
        {
          "raw_line": 48,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "道路巧詐由生傷農害政戎不仰依堯舜典謨而驅動"
        },
        {
          "raw_line": 49,
          "raw_start": 0,
          "raw_end": 21,
          "start": 147,
          "end": 168,
          "surface": "浮華虧敗風俗非徒無益乃有大損宜免戎官以敦風"
        },
        {
          "raw_line": 50,
          "raw_start": 0,
          "raw_end": 21,
          "start": 168,
          "end": 189,
          "surface": "俗戎與賈郭通親竟得不坐尋轉司徒以王政將圮苟"
        },
        {
          "raw_line": 51,
          "raw_start": 0,
          "raw_end": 21,
          "start": 189,
          "end": 210,
          "surface": "媚取容屬愍懷太子之廢竟無一言匡諫裴頠戎之婿"
        }
      ],
      "text_sha256": "fbf4c72180f341e8ba0abcc2a3f3ef8976f0f3a2554189a10c7016fa6a075b86"
    },
    {
      "key": "unit007",
      "layer": "received_chapter",
      "raw_window": [
        52,
        61
      ],
      "raw_runs": [
        {
          "raw_line": 52,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "也頠誅戎坐免官齊王冏起義孫秀錄戎於城內趙王"
        },
        {
          "raw_line": 53,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "倫子欲取戎為軍司博士王繇曰濬沖譎詐多端安肯"
        },
        {
          "raw_line": 54,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "為少年用乃止惠帝反宮以戎為尚書令既而河間王"
        },
        {
          "raw_line": 55,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "顒遣使就說成都王穎將誅齊王冏檄書至冏謂戎曰"
        },
        {
          "raw_line": 56,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "孫秀作逆天子幽逼孤糾合義兵掃除元惡臣子之節"
        },
        {
          "raw_line": 57,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "信著神明二王聽讒造構大難當賴忠謀以和不協卿"
        },
        {
          "raw_line": 58,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "其善為我籌之戎曰公首舉義衆匡定大業開闢已來"
        },
        {
          "raw_line": 59,
          "raw_start": 0,
          "raw_end": 21,
          "start": 147,
          "end": 168,
          "surface": "未始有也然論功報賞不及有勞朝野失望人懷貳志"
        },
        {
          "raw_line": 60,
          "raw_start": 0,
          "raw_end": 21,
          "start": 168,
          "end": 189,
          "surface": "今二王帶甲百萬其鋒不可當若以王就第不失故爵"
        },
        {
          "raw_line": 61,
          "raw_start": 0,
          "raw_end": 21,
          "start": 189,
          "end": 210,
          "surface": "委權崇讓此求安之計也冏謀臣葛旟怒曰漢魏以來"
        }
      ],
      "text_sha256": "ed747cbd7783f85af1fcd31c93de1c111f12dc0c8a72a48bcfeb338373241736"
    },
    {
      "key": "unit008",
      "layer": "received_chapter",
      "raw_window": [
        62,
        71
      ],
      "raw_runs": [
        {
          "raw_line": 62,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "王公就第寧有得保妻子乎議者可斬於是百官震悚"
        },
        {
          "raw_line": 63,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "戎偽藥發墮廁得不及禍戎以晉室方亂慕蘧伯玉之"
        },
        {
          "raw_line": 64,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "為人與時舒卷無蹇諤之節自經典選未嘗進寒素退"
        },
        {
          "raw_line": 65,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "虛名但與時浮沈戶調門選而已尋拜司徒雖位總鼎"
        },
        {
          "raw_line": 66,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "司而委事僚寀間乘小馬從便門而出游見者不知其"
        },
        {
          "raw_line": 67,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "三公也故吏多至大官道路相遇輒避之性好興利廣"
        },
        {
          "raw_line": 68,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "收八方園田水碓周徧天下積實聚錢不知紀極每自"
        },
        {
          "raw_line": 69,
          "raw_start": 0,
          "raw_end": 21,
          "start": 147,
          "end": 168,
          "surface": "執牙籌晝夜算計恒若不足而又儉嗇不自奉養天下"
        },
        {
          "raw_line": 70,
          "raw_start": 0,
          "raw_end": 21,
          "start": 168,
          "end": 189,
          "surface": "人謂之膏肓之疾女適裴頠貸錢數萬久而未還女後"
        },
        {
          "raw_line": 71,
          "raw_start": 0,
          "raw_end": 21,
          "start": 189,
          "end": 210,
          "surface": "歸寧戎色不悅女遽還直然後乃懽從子將婚戎遺其"
        }
      ],
      "text_sha256": "ed12d1d0e1473d9e426094831e9b7b9d9bf550a08d0f54caf6847ab30db93e1c"
    },
    {
      "key": "unit009",
      "layer": "received_chapter",
      "raw_window": [
        72,
        81
      ],
      "raw_runs": [
        {
          "raw_line": 72,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "一單衣婚訖而更責取家有好李常出貨之恐人得種"
        },
        {
          "raw_line": 73,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "恒鑽其核以此獲譏於世其後從帝北伐王師敗績於"
        },
        {
          "raw_line": 74,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "蕩陰戎復詣鄴隨帝還洛陽車駕之西遷也戎出奔于"
        },
        {
          "raw_line": 75,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "郟在危難之間親接鋒刃談笑自若未嘗有懼容時召"
        },
        {
          "raw_line": 76,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "親賓歡娛永日永興二年薨于郟縣時年七十二諡曰"
        },
        {
          "raw_line": 77,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "元戎有人倫鑒識常目山濤如璞玉渾金人皆欽其寳"
        },
        {
          "raw_line": 78,
          "raw_start": 0,
          "raw_end": 21,
          "start": 126,
          "end": 147,
          "surface": "莫知名其器王衍神姿高徹如瑤林瓊樹自然是風塵"
        },
        {
          "raw_line": 79,
          "raw_start": 0,
          "raw_end": 21,
          "start": 147,
          "end": 168,
          "surface": "表物謂裴頠拙於用長荀勖工於用短陳道寧〓〓如"
        },
        {
          "raw_line": 80,
          "raw_start": 0,
          "raw_end": 21,
          "start": 168,
          "end": 189,
          "surface": "束長竿族弟敦有高名戎惡之敦每候戎輒託疾不見"
        },
        {
          "raw_line": 81,
          "raw_start": 0,
          "raw_end": 21,
          "start": 189,
          "end": 210,
          "surface": "敦後果為逆亂其鑒賞先見如此嘗經黃公酒壚下過"
        }
      ],
      "text_sha256": "7d76d12dc4e79a52286df58fbaa44d1420bc294d0749e5fa9c77ec1b3b425b7b"
    },
    {
      "key": "unit010",
      "layer": "received_chapter",
      "raw_window": [
        82,
        88
      ],
      "raw_runs": [
        {
          "raw_line": 82,
          "raw_start": 0,
          "raw_end": 21,
          "start": 0,
          "end": 21,
          "surface": "顧為後車客曰吾昔與嵇叔夜阮嗣宗酣暢於此竹林"
        },
        {
          "raw_line": 83,
          "raw_start": 0,
          "raw_end": 21,
          "start": 21,
          "end": 42,
          "surface": "之游亦預其末自嵇阮云亡吾便為時之所羈紲今日"
        },
        {
          "raw_line": 84,
          "raw_start": 0,
          "raw_end": 21,
          "start": 42,
          "end": 63,
          "surface": "視之雖近邈若山河初孫秀為琅邪郡吏求品於鄉議"
        },
        {
          "raw_line": 85,
          "raw_start": 0,
          "raw_end": 21,
          "start": 63,
          "end": 84,
          "surface": "戎從弟衍將不許戎勸品之及秀得志朝士有宿怨者"
        },
        {
          "raw_line": 86,
          "raw_start": 0,
          "raw_end": 21,
          "start": 84,
          "end": 105,
          "surface": "皆被誅而戎衍獲濟焉子萬有美名少而大肥戎令食"
        },
        {
          "raw_line": 87,
          "raw_start": 0,
          "raw_end": 21,
          "start": 105,
          "end": 126,
          "surface": "糠而肥愈甚年十九卒有庶子興戎所不齒以從弟陽"
        },
        {
          "raw_line": 88,
          "raw_start": 0,
          "raw_end": 7,
          "start": 126,
          "end": 133,
          "surface": "平太守愷子為嗣"
        }
      ],
      "text_sha256": "4e089133d3d10f4b44a5926d31d6a3e18d2eb076e9f3b129d76f337b0c4e8f9b"
    }
  ]
}
