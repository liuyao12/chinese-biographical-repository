      "end_codepoint": 320,
      "human_reviewed": false
    },
    {
      "id": "c-songshu-050-zhangxingshi-complete:received_sentence4-320",
      "kind": "received_sentence",
      "person_id": "ykp_uqh_6be_A",
      "source_quote": "停一宿，劉胡自領水步二十六軍平旦來攻。",
      "reading": "再宿一晚，劉胡領二十六軍來攻。",
      "note": "再宿一晚，劉胡領二十六軍來攻。",
      "paragraph_id": "c-songshu-050-zhangxingshi-complete:p004",
