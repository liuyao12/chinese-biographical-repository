    },
    {
      "id": "c-songshu-050-zhangxingshi-complete:received_sentence4-122",
      "kind": "received_sentence",
      "person_id": "ykp_uqh_6be_A",
      "source_quote": "劉胡聞興世欲上，笑之曰：「我尚不敢越彼下取揚州，張興世何物人，欲輕據我上！」",
      "reading": "劉胡聞訊譏張興世。",
      "note": "劉胡聞訊譏張興世。",
      "paragraph_id": "c-songshu-050-zhangxingshi-complete:p004",
      "start_codepoint": 122,
      "end_codepoint": 160,
      "human_reviewed": false
    },
