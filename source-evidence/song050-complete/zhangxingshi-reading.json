      "end_codepoint": 79,
      "human_reviewed": false
    },
    {
      "id": "c-songshu-050-zhangxingshi-complete:received_sentence4-79",
      "kind": "received_sentence",
      "person_id": "ykp_uqh_6be_A",
      "source_quote": "乃分戰士七千配興世，興世乃令輕舸泝流而上，旋復回還，一二日中，輒復如此，使賊不為之備。",
      "reading": "配興世七千兵，反覆出船。",
      "note": "配興世七千兵，反覆出船。",
