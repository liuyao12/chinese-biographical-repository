    {
      "id": "c-songshu-050-liukangzu:received_sentence2-55",
      "kind": "received_sentence",
      "person_id": "kd4_921_4cr",
      "source_quote": "每犯法，為郡縣所錄，輙越屋踰牆，莫之能禽。",
      "reading": "屢犯郡縣，亦屢脫。",
      "note": "屢犯郡縣，亦屢脫。",
      "paragraph_id": "c-songshu-050-liukangzu:p002",
