      "paragraph_id": "c-songshu-050-liukangzu:p004",
      "start_codepoint": 38,
      "end_codepoint": 57,
      "human_reviewed": false
    },
    {
      "id": "c-songshu-050-liukangzu:received_sentence4-57",
      "kind": "received_sentence",
      "person_id": "kd4_921_4cr",
      "source_quote": "虜眾大至，奮擊破之，斬偽殿中尚書任城公乞地真，去縣瓠四十里，燾燒營退走。",
      "reading": "斬乞地真，距縣瓠四十里，魏帝退走。",
      "note": "斬乞地真，距縣瓠四十里，魏帝退走。",
      "paragraph_id": "c-songshu-050-liukangzu:p004",
      "start_codepoint": 57,
      "end_codepoint": 93,
      "human_reviewed": false
    },
    {
      "id": "c-songshu-050-liukangzu:received_sentence4-93",
      "kind": "received_sentence",
      "person_id": "kd4_921_4cr",
      "source_quote": "轉左軍將軍。",
      "reading": "康祖轉左軍將軍。",
      "note": "康祖轉左軍將軍。",
      "paragraph_id": "c-songshu-050-liukangzu:p004",
