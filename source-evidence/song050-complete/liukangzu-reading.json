    },
    {
      "id": "c-songshu-050-liukangzu:received_sentence3-79",
      "kind": "received_sentence",
      "person_id": "kd4_921_4cr",
      "source_quote": "久之，遷南平王鑠安蠻府司馬。",
      "reading": "遷南平王鑠安蠻府司馬。",
      "note": "遷南平王鑠安蠻府司馬。",
      "paragraph_id": "c-songshu-050-liukangzu:p003",
