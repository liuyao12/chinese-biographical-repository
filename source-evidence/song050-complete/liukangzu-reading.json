      "end_codepoint": 71,
      "human_reviewed": false
    },
    {
      "id": "c-songshu-050-liukangzu:received_sentence3-71",
      "kind": "received_sentence",
      "person_id": "kd4_921_4cr",
      "source_quote": "轉太子翊軍校尉。",
      "reading": "轉太子翊軍校尉。",
      "note": "轉太子翊軍校尉。",
      "paragraph_id": "c-songshu-050-liukangzu:p003",
      "start_codepoint": 71,
      "end_codepoint": 79,
