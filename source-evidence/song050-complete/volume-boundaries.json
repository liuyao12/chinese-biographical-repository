      "first_line": 42,
      "last_line": 42,
      "start_codepoint": 14,
      "end_codepoint": 44,
      "opening": "祖敞，仕苻氏，為長樂國郎",
      "closing": "入青州，以敞為車騎長史。",
      "parent_heading": "垣護之"
    },
    {
      "book_id": "b-songshu-050",
      "title": "垣遵、垣苗",
      "unit_kind": "embedded_account",
      "chapter_id": null,
      "entry_checked": true,
