      "source_layout": "wikisource_mixed_indented_prose",
      "first_line": 42,
      "last_line": 42,
      "start_codepoint": 0,
      "end_codepoint": 14,
      "opening": "垣護之字彥宗，略陽桓道人",
      "closing": "之字彥宗，略陽桓道人也。",
      "continuation_spans": [
        {
          "first_line": 44,
          "last_line": 52,
          "start_codepoint": 0,
          "end_codepoint": 369,
          "opening": "護之少倜儻，不拘小節，形",
          "closing": "，封益陽縣侯，食邑千戶。"
        },
        {
          "first_line": 56,
          "last_line": 58,
          "start_codepoint": 0,
          "end_codepoint": 180,
          "opening": "二年，護之坐論功挾私，免",
          "closing": "追贈冠軍將軍、豫州刺史。"
        }
      ],
      "heading_line": 41,
      "heading_raw": "==垣護之=="
    },
    {
      "book_id": "b-songshu-050",
      "title": "垣敞",
