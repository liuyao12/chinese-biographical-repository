      "last_line": 54,
      "start_codepoint": 0,
      "end_codepoint": 301,
      "opening": "弟詢之，驍敢有氣力，元凶",
      "closing": "所中，死，追贈冀州刺史。",
      "parent_heading": "垣護之"
    },
