  "section_reviews": [
    {
      "id": "c-sanguozhi-051-shao:line047:reading-000-050",
      "kind": "received_sentence",
      "paragraph_id": "c-sanguozhi-051-shao:line047",
      "start_codepoint": 0,
      "end_codepoint": 50,
      "source_quote": "　　孫韶字公禮。伯父河，字伯海，本姓俞氏，亦吳人也。孫策愛之，賜姓為孫，列之屬籍，後為將軍，屯京城。",
      "person_id": "d3p_59x_4er",
      "related_person_ids": [
        "07n_fwj_5jn",
        "e9c_070_567"
      ],
      "reading": "伯父河字伯海。正文稱本姓俞、孫策賜姓列屬籍；吳書別稱出後姑俞氏再復姓孫。"
    },
    {
      "id": "c-sanguozhi-051-shao:line047-pei01-01:reading-000-104",
      "kind": "annotation_sentence",
      "paragraph_id": "c-sanguozhi-051-shao:line047-pei01-01",
      "start_codepoint": 0,
      "end_codepoint": 104,
      "source_quote": "《吴书》曰：河，坚族子也，出后姑俞氏，后复姓为孙。河质性忠直，讷言敏行，有气幹，能服勤。少从坚征讨，常为前驱，后领左右兵，典知内事，待以腹心之任。又从策平定吴、会，从权讨李术，术破，拜威寇中郎将，领庐江太守。",
      "person_id": "07n_fwj_5jn",
      "related_person_ids": [
        "ki7_rgz_3l4",
        "e9c_070_567",
        "572_278_cba",
        "b6b_498_bfc"
      ],
      "reading": "吳書作堅族子、出後姑俞氏；未言韶父姓名。"
    },
    {
      "id": "c-sanguozhi-051-shao:line049:reading-000-052",
      "kind": "received_sentence",
      "paragraph_id": "c-sanguozhi-051-shao:line049",
      "start_codepoint": 0,
      "end_codepoint": 52,
      "source_quote": "　　初，孫權殺吳郡太守盛憲，憲故孝廉媯覽、戴員亡匿山中，孫翊為丹楊，皆禮致之。覽為大都督督兵，員為郡丞。",
      "person_id": "d3p_59x_4er",
      "related_person_ids": [
        "572_278_cba",
        "827_uo5_c9z",
        "syg_4kw_bmq",
        "ohq_g9f_aas",
        "iyi_e4b_ig6"
      ],
      "reading": "盛憲被權所殺。其故孝廉媯覽、戴員為翊禮致。"
    },
    {
      "id": "c-sanguozhi-051-shao:line049-pei01-01:reading-000-540",
      "kind": "annotation_sentence",
      "paragraph_id": "c-sanguozhi-051-shao:line049-pei01-01",
      "start_codepoint": 0,
      "end_codepoint": 540,
      "source_quote": "《会稽典录》曰：宪字孝章，器量雅伟，举孝廉，补尚书郎，稍迁吴郡太守，以疾去官。孙策平定吴、会，诛其英豪，宪素有高名，策深忌之。初，宪与少府孔融善，融忧其不免祸，乃与曹公书曰：“岁月不居，时节如流，五十之年，忽焉已至。公为始满，融又过二，海内知识，零落殆尽，惟会稽盛孝章尚存。其人困於孙氏，妻孥湮没，单孑独立，孤危愁苦，若使忧能伤人，此子不得复永年矣。春秋传曰：‘诸侯有相灭亡者，桓公不能救，则桓公耻之。’今孝章实丈夫之雄也，天下谭士依以扬声，而身不免於幽执，命不期於旦夕，是吾祖不当复论损益之友，而硃穆所以绝交也。公诚能驰一介之使，加咫尺之书，则孝章可致，友道可弘也。今之少年，喜谤前辈，或能讥平皮柄反。孝章；孝章要为有天下大名，九牧之民所共称叹。燕君市骏马之骨，非欲以骋道里，乃当以招绝足也。惟公匡复汉室，宗社将绝，又能正之，正之之术，实须得贤。珠玉无胫而自至者，以人好之也，况贤者之有足乎？昭王筑台以尊郭隗，隗虽小才，而逢大遇，竟能发明主之至心，故乐毅自魏往，剧辛自赵往，邹衍自齐往。乡使郭隗倒县而王不解，临溺而王不拯，则士亦将高翔远引，莫有北首燕路者矣。凡所称引，自公所知，而有云者，欲公崇笃斯义也，因表不悉。”由是徵为骑都尉。制命未至，果为权所害。子匡奔魏，位至征东司马。",
      "person_id": "827_uo5_c9z",
      "related_person_ids": [
        "e9c_070_567",
        "1e4_e5b_007",
        "dad_b77_b38",
        "9w2_c77_53m",
        "m4s_ykm_bt3",
        "5pw_05i_uhv",
        "eyc_8y6_02q",
        "gz0_xuu_ont",
        "qsp_sme_975",
        "toi_62h_6fm",
        "572_278_cba",
        "827_uo5_c9z_A"
      ],
      "reading": "會稽典錄附孔融與曹公書，薦盛孝章，並引齊桓公、朱穆、燕昭王招士等。盛憲子匡奔魏，與正文孫匡異人。"
    },
    {
      "id": "c-sanguozhi-051-shao:line051:reading-000-108",
      "kind": "received_sentence",
      "paragraph_id": "c-sanguozhi-051-shao:line051",
      "start_codepoint": 0,
      "end_codepoint": 108,
      "source_quote": "　　及翊遇害，河馳赴宛陵，責怒覽、員，以不能全權，令使奸變得施。二人議曰：\"伯海與將軍疏遠，而責我乃耳。討虜若來，吾屬無遺矣。\"遂殺河，使人北迎揚州刺史劉馥，令住歷陽，以丹陽應之。會翊帳下徐元、孫高、傅嬰等殺覽、員。",
      "person_id": "07n_fwj_5jn",
      "related_person_ids": [
        "iyi_e4b_ig6",
        "syg_4kw_bmq",
        "ohq_g9f_aas",
        "572_278_cba",
        "ofy_r4x_l1b",
        "vs7_jyy_z31",
        "qvz_x0y_5s8",
        "hv7_sng_erh"
      ],
      "reading": "翊、河相繼遇害，覽員欲迎劉馥。正文列徐元、孫高、傅嬰等，吳歷另詳徐夫人與二人籌事。"
    },
    {
      "id": "c-sanguozhi-051-shao:line051-pei01-01:reading-000-602",
      "kind": "annotation_sentence",
      "paragraph_id": "c-sanguozhi-051-shao:line051-pei01-01",
      "start_codepoint": 0,
