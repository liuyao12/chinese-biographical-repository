      "kind": "received_sentence",
      "person_id": "92a_026_432",
      "source_quote": "又參何無忌輔國右軍軍事。",
      "reading": "參何無忌軍事。",
      "note": "參何無忌軍事。",
      "paragraph_id": "c-songshu-048-zhuchaoshi:p001",
