      "start_codepoint": 0,
      "end_codepoint": 31,
      "opening": "朱齡石字伯兒，沛郡沛人也",
      "closing": "騰，建威將軍、吳國內史。",
      "continuation_spans": [
        {
          "first_line": 10,
          "last_line": 24,
          "start_codepoint": 177,
          "end_codepoint": 208,
          "opening": "沖諸子遇齡石如兄弟。",
          "closing": "。</ref>斬于軍門。"
        },
        {
          "first_line": 26,
          "last_line": 32,
          "start_codepoint": 0,
          "end_codepoint": 138,
          "opening": "高祖之伐蜀也，將謀元帥而",
          "closing": "還長安，見殺，時年四十。"
        }
      ],
      "heading_line": 9,
      "heading_raw": "==朱齡石=="
    },
