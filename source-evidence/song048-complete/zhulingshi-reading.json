      "kind": "received_sentence",
      "person_id": "wip_vh5_2zm_A",
      "source_quote": "舅雖危懼戰慄，為畏齡石，終不敢動。",
      "reading": "其舅畏懼不敢動。",
      "note": "其舅畏懼不敢動。",
      "paragraph_id": "c-songshu-048-zhulingshi:p003",
      "start_codepoint": 68,
      "end_codepoint": 85,
      "human_reviewed": false
    },
