    },
    {
      "id": "c-songshu-048-fuhongzhi:received_sentence2-20",
      "kind": "received_sentence",
      "person_id": "258_ae3_26e_AAA",
      "source_quote": "桓玄將篡，新野人庾仄起兵於南陽，襲雍州刺史馮該，該走。",
