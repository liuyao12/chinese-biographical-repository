      "sentences": [
        {
          "id": "song092-zhen-14-0",
          "kind": "received_sentence",
          "person_id": "7r6_k52_qji_ABDACAA",
          "paragraph_id": "c-songshu-092-wangzhenzhi:line014",
          "start_codepoint": 0,
          "end_codepoint": 26,
          "source_quote": "鎮之初為琅邪王衞軍行參軍，出補剡、上虞令，並有能名。",
          "reading": "琅邪王府初官，出補剡、上虞兩縣。本段只以王號稱其府主。",
          "human_reviewed": false
        },
        {
          "id": "song092-zhen-14-26",
          "kind": "received_sentence",
          "person_id": "7r6_k52_qji_ABDACAA",
          "paragraph_id": "c-songshu-092-wangzhenzhi:line014",
          "start_codepoint": 26,
          "end_codepoint": 41,
          "source_quote": "內史謝輶請為山陰令，復有殊績。",
          "reading": "內史謝輶所請為山陰令，後句記治績。",
          "human_reviewed": false
        },
        {
          "id": "song092-zhen-14-41",
          "kind": "received_sentence",
          "person_id": "7r6_k52_qji_ABDACAA",
          "paragraph_id": "c-songshu-092-wangzhenzhi:line014",
          "start_codepoint": 41,
          "end_codepoint": 59,
          "source_quote": "遷衞軍參軍，本國郎中令，加寧朔將軍。",
          "reading": "衞軍參軍、本國郎中令，加寧朔將軍。",
          "human_reviewed": false
        },
        {
          "id": "song092-zhen-14-59",
          "kind": "received_sentence",
          "person_id": "7r6_k52_qji_ABDACAA",
          "paragraph_id": "c-songshu-092-wangzhenzhi:line014",
          "start_codepoint": 59,
          "end_codepoint": 74,
          "source_quote": "桓玄輔晉，以為大將軍錄事參軍。",
          "reading": "桓玄輔晉時任大將軍錄事參軍。",
          "human_reviewed": false
        },
        {
          "id": "song092-zhen-14-74",
          "kind": "received_sentence",
          "person_id": "7r6_k52_qji_ABDACAA",
          "paragraph_id": "c-songshu-092-wangzhenzhi:line014",
          "start_codepoint": 74,
          "end_codepoint": 107,
          "source_quote": "時三吳飢荒，遣鎮之銜命賑卹，而會稽內史王愉不奉符旨，鎮之依事糾奏。",
          "reading": "三吳饑荒，桓玄遣鎮之賑卹。會稽內史王愉不奉符旨，鎮之糾奏。",
          "human_reviewed": false
        },
        {
          "id": "song092-zhen-14-107",
          "kind": "received_sentence",
          "person_id": "7r6_k52_qji_ABDACAA",
          "paragraph_id": "c-songshu-092-wangzhenzhi:line014",
          "start_codepoint": 107,
          "end_codepoint": 138,
          "source_quote": "愉子綏，玄之外甥，當時貴盛，鎮之為所排抑，以母老求補安成太守。",
          "reading": "王綏為王愉之子、桓玄外甥。受排抑而求補安成太守者鎮之。",
          "human_reviewed": false
        },
        {
          "id": "song092-zhen-14-138",
          "kind": "received_sentence",
          "person_id": "7r6_k52_qji_ABDACAA",
          "paragraph_id": "c-songshu-092-wangzhenzhi:line014",
          "start_codepoint": 138,
          "end_codepoint": 169,
          "source_quote": "及玄敗，玄將苻宏寇亂郡境，鎮之拒戰彌年，子弟五人，並臨陣見殺。",
          "reading": "桓玄敗後苻宏寇郡。五名子弟臨陣遇害，姓名與各人的親屬身分未載。",
          "human_reviewed": false
        },
        {
          "id": "song092-zhen-14-169",
          "kind": "received_sentence",
          "person_id": "7r6_k52_qji_ABDACAA",
          "paragraph_id": "c-songshu-092-wangzhenzhi:line014",
          "start_codepoint": 169,
          "end_codepoint": 197,
          "source_quote": "母憂去職，在官清潔，妻子無以自給，乃棄家致喪還上虞舊墓。",
          "reading": "鎮之為母服喪，妻子無以自給。校訂本墓、葬兩字分據兩項校勘。",
          "human_reviewed": false
        },
        {
          "id": "song092-zhen-14-197",
          "kind": "received_sentence",
          "person_id": "7r6_k52_qji_ABDACAA",
          "paragraph_id": "c-songshu-092-wangzhenzhi:line014",
          "start_codepoint": 197,
          "end_codepoint": 214,
          "source_quote": "葬畢，為子標之求安復令，隨子之官。",
          "reading": "為子標之求安復令，鎮之隨子之官。四庫宋書作摽之。",
          "human_reviewed": false
        },
        {
          "id": "song092-zhen-14-214",
          "kind": "received_sentence",
          "person_id": "7r6_k52_qji_ABDACAA",
          "paragraph_id": "c-songshu-092-wangzhenzhi:line014",
          "start_codepoint": 214,
          "end_codepoint": 230,
          "source_quote": "服闋，為征西道規司馬、南平太守。",
          "reading": "服闋任劉道規司馬、南平太守。",
          "human_reviewed": false
        },
        {
          "id": "song092-zhen-14-230",
          "kind": "received_sentence",
          "person_id": "7r6_k52_qji_ABDACAA",
          "paragraph_id": "c-songshu-092-wangzhenzhi:line014",
          "start_codepoint": 230,
          "end_codepoint": 271,
          "source_quote": "徐道覆逼江陵，加鎮之建威將軍，統檀道濟、到彥之等討道覆，以不經將帥，固辭，不見聽。",
          "reading": "統檀道濟、到彥之以討徐道覆。固辭而不見聽，敘事續有領職。",
          "human_reviewed": false
        },
        {
          "id": "song092-zhen-14-271",
          "kind": "received_sentence",
          "person_id": "7r6_k52_qji_ABDACAA",
          "paragraph_id": "c-songshu-092-wangzhenzhi:line014",
          "start_codepoint": 271,
          "end_codepoint": 288,
          "source_quote": "既而前軍失利，白衣領職，尋復本官。",
          "reading": "前軍失利，白衣領職，旋復本官。",
          "human_reviewed": false
        },
        {
          "id": "song092-zhen-14-288",
          "kind": "received_sentence",
          "person_id": "7r6_k52_qji_ABDACAA",
          "paragraph_id": "c-songshu-092-wangzhenzhi:line014",
          "start_codepoint": 288,
          "end_codepoint": 306,
          "source_quote": "以討道覆功，封華容縣五等男，徵廷尉。",
          "reading": "封華容縣五等男，徵廷尉。",
          "human_reviewed": false
        },
        {
          "id": "song092-zhen-14-306",
          "kind": "received_sentence",
          "person_id": "7r6_k52_qji_ABDACAA",
          "paragraph_id": "c-songshu-092-wangzhenzhi:line014",
          "start_codepoint": 306,
          "end_codepoint": 321,
          "source_quote": "晉穆帝何皇后山陵，領將作大匠。",
          "reading": "領將作大匠係何皇后山陵。晉紀祔葬在元興三年，早於義熙六年與徐道覆戰，保存兩書次序。",
          "human_reviewed": false
        },
        {
          "id": "song092-zhen-14-321",
          "kind": "received_sentence",
          "person_id": "7r6_k52_qji_ABDACAA",
          "paragraph_id": "c-songshu-092-wangzhenzhi:line014",
          "start_codepoint": 321,
          "end_codepoint": 337,
          "source_quote": "遷御史中丞，秉正不撓，百僚憚之。",
          "reading": "遷御史中丞。",
          "human_reviewed": false
        }
      ]
    },
    {
      "paragraph_id": "c-songshu-092-wangzhenzhi:line016",
