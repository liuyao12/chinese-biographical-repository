        "c-songshu-092-wangzhenzhi:line016:m0180"
      ],
      "sentences": [
        {
          "id": "song092-zhen-16-0",
          "kind": "received_sentence",
          "person_id": "7r6_k52_qji_ABDACAA",
          "paragraph_id": "c-songshu-092-wangzhenzhi:line016",
          "start_codepoint": 0,
          "end_codepoint": 32,
          "source_quote": "出為使持節、都督交廣二州諸軍事、建威將軍、平越中郎將、廣州刺史。",
          "reading": "使持節、都督交廣二州諸軍事，出任廣州刺史等。",
          "human_reviewed": false
        },
        {
          "id": "song092-zhen-16-32",
          "kind": "received_sentence",
          "person_id": "7r6_k52_qji_ABDACAA",
          "paragraph_id": "c-songshu-092-wangzhenzhi:line016",
          "start_codepoint": 32,
          "end_codepoint": 55,
          "source_quote": "高祖謂人曰：「王鎮之少著清績，必將繼美吳隱之。",
          "reading": "宋武帝劉裕稱鎮之清績，可繼吳隱之。",
          "human_reviewed": false
        },
        {
          "id": "song092-zhen-16-55",
          "kind": "received_sentence",
          "person_id": "7r6_k52_qji_ABDACAA",
          "paragraph_id": "c-songshu-092-wangzhenzhi:line016",
          "start_codepoint": 55,
          "end_codepoint": 67,
          "source_quote": "嶺南之弊，非此不康也。」",
          "reading": "嶺南為所論治理區域。",
          "human_reviewed": false
        },
        {
          "id": "song092-zhen-16-67",
          "kind": "received_sentence",
          "person_id": "7r6_k52_qji_ABDACAA",
          "paragraph_id": "c-songshu-092-wangzhenzhi:line016",
          "start_codepoint": 67,
          "end_codepoint": 90,
          "source_quote": "在鎮不受俸祿，蕭然無所營，去官之日，不異始至。",
          "reading": "離鎮時與初至相同，任內不受俸祿。",
          "human_reviewed": false
        },
        {
          "id": "song092-zhen-16-90",
          "kind": "received_sentence",
          "person_id": "7r6_k52_qji_ABDACAA",
          "paragraph_id": "c-songshu-092-wangzhenzhi:line016",
          "start_codepoint": 90,
          "end_codepoint": 109,
          "source_quote": "高祖初建相國府，以為諮議參軍，領錄事。",
          "reading": "劉裕初建相國府，以鎮之為諮議參軍，領錄事。",
          "human_reviewed": false
        },
        {
          "id": "song092-zhen-16-109",
          "kind": "received_sentence",
          "person_id": "7r6_k52_qji_ABDACAA",
          "paragraph_id": "c-songshu-092-wangzhenzhi:line016",
          "start_codepoint": 109,
          "end_codepoint": 119,
          "source_quote": "善於吏職，嚴而不殘。",
          "reading": "記其為吏持法。",
          "human_reviewed": false
        },
        {
          "id": "song092-zhen-16-119",
          "kind": "received_sentence",
          "person_id": "7r6_k52_qji_ABDACAA",
          "paragraph_id": "c-songshu-092-wangzhenzhi:line016",
          "start_codepoint": 119,
          "end_codepoint": 127,
          "source_quote": "遷宋臺祠部尚書。",
          "reading": "遷宋臺祠部尚書。",
          "human_reviewed": false
        },
        {
          "id": "song092-zhen-16-127",
          "kind": "received_sentence",
          "person_id": "7r6_k52_qji_ABDACAA",
          "paragraph_id": "c-songshu-092-wangzhenzhi:line016",
          "start_codepoint": 127,
          "end_codepoint": 165,
          "source_quote": "高祖踐阼，鎮之以脚患自陳，出為輔國將軍、琅邪太守，遷宣訓衞尉，領本州大中正。",
          "reading": "劉裕踐阼後鎮之以脚患自陳，出守琅邪，其後任宣訓衞尉並領本州大中正。",
          "human_reviewed": false
        },
        {
          "id": "song092-zhen-16-165",
          "kind": "received_sentence",
          "person_id": "7r6_k52_qji_ABDACAA",
          "paragraph_id": "c-songshu-092-wangzhenzhi:line016",
          "start_codepoint": 165,
          "end_codepoint": 179,
          "source_quote": "永初三年，卒官，時年六十六。",
          "reading": "永初三年卒於官，原報六十六歲。",
          "human_reviewed": false
        },
        {
          "id": "song092-zhen-16-179",
          "kind": "received_sentence",
          "person_id": "7r6_k52_qji_ABDACAA",
          "paragraph_id": "c-songshu-092-wangzhenzhi:line016",
          "start_codepoint": 179,
          "end_codepoint": 188,
          "source_quote": "弟弘之，在隱逸傳。",
          "reading": "王弘之為其弟，所指隱逸傳在宋書卷九十三。",
          "human_reviewed": false
        }
      ]
    }
  ],
