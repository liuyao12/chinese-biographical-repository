      "sentences": [
        {
          "id": "song092-zhen-12-0",
          "kind": "received_sentence",
          "person_id": "7r6_k52_qji_ABDACAA",
          "paragraph_id": "c-songshu-092-wangzhenzhi:line012",
          "start_codepoint": 0,
          "end_codepoint": 20,
          "source_quote": "王鎮之字伯重，琅邪臨沂人，徵士弘之兄也。",
          "reading": "王鎮之字伯重、籍琅邪臨沂，是徵士王弘之之兄。四庫宋書此字作伯仲。",
          "human_reviewed": false
        },
        {
          "id": "song092-zhen-12-20",
          "kind": "received_sentence",
          "person_id": "7r6_k52_qji_ABDACAA",
          "paragraph_id": "c-songshu-092-wangzhenzhi:line012",
          "start_codepoint": 20,
          "end_codepoint": 30,
          "source_quote": "曾祖廙，晉驃騎將軍。",
          "reading": "曾祖王廙任晉驃騎將軍。",
          "human_reviewed": false
        },
        {
          "id": "song092-zhen-12-30",
          "kind": "received_sentence",
          "person_id": "7r6_k52_qji_ABDACAA",
          "paragraph_id": "c-songshu-092-wangzhenzhi:line012",
          "start_codepoint": 30,
          "end_codepoint": 38,
          "source_quote": "祖耆之，中書郎。",
          "reading": "祖王耆之任中書郎。",
          "human_reviewed": false
        },
        {
          "id": "song092-zhen-12-38",
          "kind": "received_sentence",
          "person_id": "7r6_k52_qji_ABDACAA",
          "paragraph_id": "c-songshu-092-wangzhenzhi:line012",
          "start_codepoint": 38,
          "end_codepoint": 46,
          "source_quote": "父隨之，上虞令。",
          "reading": "父王隨之任上虞令。",
          "human_reviewed": false
        }
      ]
    },
