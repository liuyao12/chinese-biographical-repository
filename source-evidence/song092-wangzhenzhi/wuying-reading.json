  "column_file": "source-evidence/song092-wangzhenzhi/wyd-columns.txt",
  "column_file_sha256": "316503bbf73485e119ac53b41c67206cb3224497dff86f5264f4b3cf3b0d6af6",
  "columns": [
    {
      "pdf_page": 91,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 9,
      "start_codepoint": 0,
      "end_codepoint": 21,
      "reading": "王鎮之字伯重琅邪臨沂人徵士𢎞之兄也曾祖廙晉"
    },
    {
      "pdf_page": 91,
      "half": "左",
      "leaf": "二上",
      "column_from_right": 10,
      "start_codepoint": 21,
      "end_codepoint": 42,
      "reading": "驃騎將軍祖耆之中書郎父隨之上虞令鎮之初為琅"
    },
    {
      "pdf_page": 92,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 1,
      "start_codepoint": 42,
      "end_codepoint": 63,
      "reading": "邪王衞軍行參軍出補剡上虞令並有能名內史謝輶"
    },
    {
      "pdf_page": 92,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 2,
      "start_codepoint": 63,
      "end_codepoint": 84,
      "reading": "請為山陰令復有殊績遷衞軍參軍本國郎中令加寧"
    },
    {
      "pdf_page": 92,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 3,
      "start_codepoint": 84,
      "end_codepoint": 105,
      "reading": "朔將軍桓𤣥輔晉以為大將軍録事參軍時三吳饑荒"
    },
    {
      "pdf_page": 92,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 4,
      "start_codepoint": 105,
      "end_codepoint": 126,
      "reading": "遣鎮之銜命賑卹而會稽內史王愉不奉符旨鎮之依"
    },
    {
      "pdf_page": 92,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 5,
      "start_codepoint": 126,
      "end_codepoint": 147,
      "reading": "事糺奏愉子綏𤣥之外甥當時貴盛鎮之為所排抑以"
    },
    {
      "pdf_page": 92,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 6,
      "start_codepoint": 147,
      "end_codepoint": 168,
      "reading": "母老求補安成太守及𤣥敗𤣥將苻宏寇亂郡境鎮之"
    },
    {
      "pdf_page": 92,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 7,
      "start_codepoint": 168,
      "end_codepoint": 189,
      "reading": "拒戰彌年子弟五人並臨陣見殺母憂去職在官清潔"
    },
    {
      "pdf_page": 92,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 8,
      "start_codepoint": 189,
      "end_codepoint": 210,
      "reading": "妻子無以自給乃棄家致喪還上虞舊基畢為子標之"
    },
    {
      "pdf_page": 92,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 9,
      "start_codepoint": 210,
      "end_codepoint": 231,
      "reading": "求安復令隨子之官服闋為征西道規司馬南平太守"
    },
    {
      "pdf_page": 92,
      "half": "右",
      "leaf": "二下",
      "column_from_right": 10,
      "start_codepoint": 231,
      "end_codepoint": 252,
      "reading": "徐道覆逼江陵加鎮之建威將軍統檀道濟到彦之等"
    },
    {
      "pdf_page": 92,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 1,
      "start_codepoint": 252,
      "end_codepoint": 273,
      "reading": "討道覆以不經將帥固辭不見聽旣而前軍失利白衣"
    },
    {
      "pdf_page": 92,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 2,
      "start_codepoint": 273,
      "end_codepoint": 294,
      "reading": "領職尋復本官以討道覆功封華容縣五等男徵廷尉"
    },
    {
      "pdf_page": 92,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 3,
      "start_codepoint": 294,
      "end_codepoint": 315,
      "reading": "晉穆帝何皇后山陵領將作大匠遷御史中丞秉正不"
    },
    {
      "pdf_page": 92,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 4,
      "start_codepoint": 315,
      "end_codepoint": 336,
      "reading": "撓百寮憚之出為使持節都督交廣二州諸軍事建威"
    },
    {
      "pdf_page": 92,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 5,
      "start_codepoint": 336,
      "end_codepoint": 357,
      "reading": "將軍平越中郎將廣州刺史高祖謂人曰王鎮之少著"
    },
    {
      "pdf_page": 92,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 6,
      "start_codepoint": 357,
      "end_codepoint": 378,
      "reading": "清績必將繼美吳隱之嶺南之弊非此不康也在鎮不"
    },
    {
      "pdf_page": 92,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 7,
      "start_codepoint": 378,
      "end_codepoint": 399,
      "reading": "受俸祿蕭然無所營去官之日不異始至高祖初建相"
    },
    {
      "pdf_page": 92,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 8,
      "start_codepoint": 399,
      "end_codepoint": 420,
      "reading": "國府以為諮議參軍領録事善於吏職嚴而不殘遷宋"
    },
    {
      "pdf_page": 92,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 9,
      "start_codepoint": 420,
      "end_codepoint": 441,
      "reading": "臺祠部尚書高祖踐阼鎮之以脚患自陳出為輔國將"
    },
    {
      "pdf_page": 92,
      "half": "左",
      "leaf": "三上",
      "column_from_right": 10,
      "start_codepoint": 441,
      "end_codepoint": 462,
      "reading": "軍琅邪太守遷宣訓衞尉領本州大中正永初三年卒"
    },
    {
      "pdf_page": 93,
      "half": "右",
      "leaf": "三下",
      "column_from_right": 1,
      "start_codepoint": 462,
      "end_codepoint": 475,
      "reading": "官時年六十六弟𢎞之在隱逸傳"
    }
  ],
