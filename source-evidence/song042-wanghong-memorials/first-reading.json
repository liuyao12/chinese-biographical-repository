  "revision": 1478172,
  "paragraphs": [
    {
      "raw_line": 45,
      "paragraph_id": "c-songshu-042-wanghong:p001",
      "facts": [
        {
          "start": 0,
          "end": 34,
          "surface": "王弘字休元，琅邪臨沂人也。曾祖導，晉丞相。祖洽，中領軍。父珣，司徒。",
          "kind": "家世",
          "note": "王弘字休元，琅邪臨沂。晉丞相王導是其曾祖，中領軍王洽是其祖，司徒王珣是其父。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:p001:m0000",
            "c-songshu-042-wanghong:p001:m0003",
            "c-songshu-042-wanghong:p001:m0015",
            "c-songshu-042-wanghong:p001:m0022",
            "c-songshu-042-wanghong:p001:m0029"
          ]
        }
      ],
      "paragraph_sha256": "1807de52983c1590494d092a989d619b624965095b772a9ff0721fcb039f891d"
    },
    {
      "raw_line": 47,
      "paragraph_id": "c-songshu-042-wanghong:line047",
      "facts": [
        {
          "start": 0,
          "end": 38,
          "surface": "弘少好學，以清恬知名，與尚書僕射謝混善。弱冠，為會稽王司馬道子驃騎參軍主簿。",
          "kind": "早年",
          "note": "王弘少時以清恬聞，友謝混。弱冠任司馬道子驃騎參軍主簿。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line047:m0000",
            "c-songshu-042-wanghong:line047:m0016",
            "c-songshu-042-wanghong:line047:m0024"
          ]
        },
        {
          "start": 38,
          "end": 98,
          "surface": "時農務頓息，末役繁興，弘以為宜建屯田，陳之曰：「近面所諮立屯田事，已具簡聖懷。南畝事興，時不可失，宜早督田畯，以要歲功。",
          "kind": "屯田陳議",
          "note": "因農務衰而徭役興，向道子建議屯田，請及時督田畯。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line047:m0049",
            "c-songshu-042-wanghong:line047:r0074"
          ]
        },
        {
          "start": 98,
          "end": 176,
          "surface": "而府資役單刻，控引無所，雖復厲以重勸，肅以嚴威，適足令囹圄充積，而無救於事實也。伏見南局諸冶，募吏數百，雖資以廩贍，收入甚微。愚謂若回以配農，必功利百倍矣。",
          "kind": "轉募冶工",
          "note": "刑督無救，南局諸冶數百募吏收效甚微，請轉配農役。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line047:r0161"
          ]
        },
        {
          "start": 176,
          "end": 235,
          "surface": "然軍器所須，不可都廢，今欲留銅官大冶及都邑小冶各一所，重其功課，一准揚州，州之求取，亦當無乏，餘者罷之，以充東作之要。",
          "kind": "保留冶作",
          "note": "建議留銅官大冶、都邑小冶各一，參照揚州；餘募吏務農。",
          "occurrence_ids": []
        },
        {
          "start": 235,
          "end": 303,
          "surface": "又欲二局田曹，各立典軍募吏，依冶募比例，并聽取山湖人，此皆無損於私，有益於公者也。其中亦應疇量，分判番假，及給廩多少，自可一以委之本曹。",
          "kind": "田曹募吏",
          "note": "二局田曹設典軍募吏，取山湖人，番假與給廩委本曹。",
          "occurrence_ids": []
        },
        {
          "start": 303,
          "end": 342,
          "surface": "親局所統，必當練悉，且近東曹板水曹參軍納之領此任，其人頗有幹能，自足了其事耳。",
          "kind": "納之",
          "note": "東曹已板水曹參軍納之領此任，認為能辦。未見其姓。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line047:m0322",
            "c-songshu-042-wanghong:line047:r0328"
          ]
        },
        {
          "start": 342,
          "end": 442,
          "surface": "頃年以來，斯務弛廢，田蕪廩虛，實亦由此。弘過蒙飾擢，志輸短効，豈可相與寢默，有懷弗聞邪！至於當否，尊自當裁以遠鑒。若所啟謬允者，伏願便以時施行，庶歲有務農之勤，倉有盈廩之實，禮節之興，可以垂拱待也。」",
          "kind": "請裁",
          "note": "田荒廩虛，稱名自陳小效，請道子裁決施行。百倍等為奏議估辭。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line047:m0362",
            "c-songshu-042-wanghong:line047:m0391"
          ]
        },
        {
          "start": 442,
          "end": 460,
          "surface": "道子欲以為黃門侍郎，珣以其年少固辭。",
          "kind": "未受",
          "note": "道子欲以王弘為黃門侍郎，王珣以子年少固辭；不成為實任。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line047:m0442",
            "c-songshu-042-wanghong:line047:m0452",
            "c-songshu-042-wanghong:line047:r0454"
          ]
        }
      ],
      "paragraph_sha256": "26f7ca8ead0407052b4b5422d5ee42d6f2351b74af61281bdde9b4e16b61895e"
    },
    {
      "raw_line": 49,
      "paragraph_id": "c-songshu-042-wanghong:line049",
      "facts": [
        {
          "start": 0,
          "end": 38,
          "surface": "珣頗好積聚，財物布在民間。珣薨，弘悉燔燒券書，一不收責；餘舊業悉以委付諸弟。",
          "kind": "父喪",
          "note": "王珣薨，王弘焚券罷索舊債，舊業委予諸弟。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line049:m0000",
            "c-songshu-042-wanghong:line049:m0013",
            "c-songshu-042-wanghong:line049:m0016",
            "c-songshu-042-wanghong:line049:m0035"
          ]
        },
        {
          "start": 38,
          "end": 96,
          "surface": "未免喪，後將軍司馬元顯以為諮議參軍，加寧遠將軍，知記室事，固辭不就。道子復以為諮議參軍，加建威將軍，領中兵，又固辭。",
          "kind": "兩次不就",
          "note": "司馬元顯先授諮議參軍、寧遠將軍、知記室事，王弘固辭；道子復用諮議參軍、建威將軍、領中兵，又辭。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line049:m0045",
            "c-songshu-042-wanghong:line049:m0072"
          ]
        },
        {
          "start": 96,
          "end": 118,
          "surface": "時內外多難，在喪者皆不終其哀，唯弘固執得免。",
          "kind": "守喪",
          "note": "敘時人遭亂多未終喪，弘獲免起復。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line049:m0112"
          ]
        },
        {
          "start": 118,
          "end": 163,
          "surface": "桓玄剋京邑，收道子付廷尉，臣吏畏恐，莫敢瞻送。弘時尚在喪，獨於道側拜，攀車涕泣，論者稱焉。",
          "kind": "送道子",
          "note": "桓玄收司馬道子付廷尉，眾不敢送，仍居喪的弘獨拜送。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line049:m0118",
            "c-songshu-042-wanghong:line049:m0125",
            "c-songshu-042-wanghong:line049:m0141"
          ]
        }
      ],
      "paragraph_sha256": "4b653f0d10552f6934dd3b31071ae072c2e65d723549eda19cb0e60413e248b8"
    },
    {
      "raw_line": 51,
      "paragraph_id": "c-songshu-042-wanghong:line051",
      "facts": [
        {
          "start": 0,
          "end": 35,
          "surface": "高祖為鎮軍，召補諮議參軍。以功封華容縣五等侯。遷琅邪王大司馬從事中郎。",
          "kind": "仕宦",
          "note": "劉裕補王弘諮議參軍，封華容縣五等侯；遷琅邪王德文大司馬從事中郎。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line051:m0000",
            "c-songshu-042-wanghong:line051:m0024"
          ]
        },
        {
          "start": 35,
          "end": 71,
          "surface": "出為寧遠將軍、琅邪內史，尚書吏部郎中，豫章相。盧循寇南康諸郡，弘奔尋陽。",
          "kind": "內外遷轉",
          "note": "寧遠將軍、琅邪內史、吏部郎中、豫章相，盧循寇南康，弘奔尋陽。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line051:m0058",
            "c-songshu-042-wanghong:line051:m0066"
          ]
        },
        {
          "start": 71,
          "end": 115,
          "surface": "高祖復命為中軍諮議參軍，遷大司馬右長史，轉吳國內史。義熙十一年，徵為太尉長史，轉左長史。",
          "kind": "軍府諸官",
          "note": "劉裕再任中軍諮議參軍，遷右長史、吳國內史；義熙十一年415為太尉長史轉左長史。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line051:m0071"
          ]
        },
        {
          "start": 115,
          "end": 169,
          "surface": "從北征，前鋒已平洛陽，而未遣九錫，弘銜使還京師，諷旨朝廷。時劉穆之掌留任，而旨反從北來，穆之愧懼，發病遂卒。",
          "kind": "九錫與留任",
          "note": "前鋒平洛陽，弘奉使還京，留任劉穆之以旨出北方愧懼病卒。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line051:m0132",
            "c-songshu-042-wanghong:line051:m0145",
            "c-songshu-042-wanghong:line051:m0159"
          ]
        },
        {
          "start": 169,
          "end": 183,
          "surface": "而高祖還彭城，弘領彭城太守。",
          "kind": "彭城",
          "note": "劉裕還彭城，王弘領彭城太守。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line051:m0176",
            "c-songshu-042-wanghong:line051:m0170"
          ]
        }
      ],
      "paragraph_sha256": "f3ad82e426edab50da26b0913e53a2f623ff53024dc75d8036c295d3727b34d0"
    },
    {
      "raw_line": 53,
      "paragraph_id": "c-songshu-042-wanghong:line053",
      "facts": [
        {
          "start": 0,
          "end": 18,
          "surface": "宋國初建，遷尚書僕射領選，太守如故。",
          "kind": "任職",
          "note": "王弘遷尚書僕射領選，仍領太守。",
          "occurrence_ids": []
        },
        {
          "start": 18,
          "end": 100,
          "surface": "奏彈謝靈運曰：「臣聞閑厥有家，垂訓大易，作威專戮，致誡周書。斯典或違，刑茲無赦。世子左衞率康樂縣公謝靈運，力人桂興淫其嬖妾，殺興江涘，棄尸洪流。事發京畿，播聞遐邇。",
          "kind": "謝靈運案",
          "note": "王弘引易、周書，奏劾謝靈運；桂興是其力人，私通其嬖妾，謝殺興棄屍。妾無名。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line053:m0020",
            "c-songshu-042-wanghong:line053:m0067",
            "c-songshu-042-wanghong:line053:m0073",
            "c-songshu-042-wanghong:line053:m0081",
            "c-songshu-042-wanghong:line053:r0026",
            "c-songshu-042-wanghong:line053:r0076",
            "c-songshu-042-wanghong:line053:m0077"
          ]
        },
        {
          "start": 100,
          "end": 200,
          "surface": "宜加重劾，肅正朝風。案世子左衞率康樂縣公謝靈運過蒙恩奬，頻叨榮授，聞禮知禁，為日已久。而不能防閑閫闈，致茲紛穢，罔顧憲軌，忿殺自由。此而勿治，典刑將替。請以見事免靈運所居官，上臺削爵土，收付大理治罪。",
          "kind": "請免削",
          "note": "奏請免謝靈運職、削爵土、交大理，所請與裁決分開。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line053:m0120",
            "c-songshu-042-wanghong:line053:m0181"
          ]
        },
        {
          "start": 200,
          "end": 280,
          "surface": "御史中丞都亭侯王准之，顯居要任，邦之司直，風聲噂𠴲，曾不彈舉。若知而弗糾，則情法斯撓；如其不知，則尸昧已甚。豈可復預班清階，式是國憲。請免所居官，以侯還散輩中。",
          "kind": "王准之案",
          "note": "王准之任御史中丞、都亭侯；因未彈舉，王弘請免其官、以侯還散輩。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line053:m0207",
            "c-songshu-042-wanghong:line053:r0244"
          ]
        },
        {
          "start": 280,
          "end": 372,
          "surface": "內臺舊體，不得用風聲舉彈，此事彰赫，曝之朝野，執憲蔑聞，羣司循舊，國典既頹，所虧者重。臣弘忝承人乏，位副朝端，若復謹守常科，則終莫之糾正。所以不敢拱默，自同秉彝。違舊之愆，伏須准裁。」",
          "kind": "違例理由",
          "note": "內臺舊體不據風聲彈劾；弘自陳事已彰赫、自己任尚書僕射不應不糾。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line053:m0324",
            "c-songshu-042-wanghong:line053:r0323"
          ]
        },
        {
          "start": 372,
          "end": 413,
          "surface": "高祖令曰：「靈運免官而已，餘如奏。端右肅正風軌，誠副所期，豈拘常儀。自今為永制。」",
          "kind": "裁決",
          "note": "劉裕命謝靈運免官而已，其餘依奏；肯定端右肅風軌，令為永制。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line053:m0378",
            "c-songshu-042-wanghong:line053:m0372",
            "c-songshu-042-wanghong:line053:r0389"
          ]
        }
      ],
      "paragraph_sha256": "a934cb6840a0a8d259bf3002c332db746d4251b190121826b7114ecd6bad2e9b"
    },
    {
      "raw_line": 55,
      "paragraph_id": "c-songshu-042-wanghong:line055",
      "facts": [
        {
          "start": 0,
          "end": 46,
          "surface": "十四年，遷監江州、豫州之西陽、新蔡二郡諸軍事、撫軍將軍、江州刺史。至州，省賦簡役，百姓安之。",
          "kind": "江州",
          "note": "承義熙十四年418，王弘任監江州、豫州之西陽、新蔡二郡諸軍事、撫軍將軍、江州刺史，省賦簡役。",
          "occurrence_ids": []
        },
        {
          "start": 46,
          "end": 74,
          "surface": "永初元年，加散騎常侍。以佐命功，封華容縣公，食邑二千戶。",
          "kind": "封爵",
          "note": "永初元年420加散騎常侍，封華容縣公，食邑二千戶。",
          "occurrence_ids": []
        },
        {
          "start": 74,
          "end": 93,
          "surface": "三年，入朝，進號衞將軍、開府儀同三司。",
          "kind": "進號",
          "note": "永初三年422入朝，進號衞將軍、開府儀同三司。",
          "occurrence_ids": []
        }
      ],
      "paragraph_sha256": "50d3fdfeba007aa596fe6afec4a4e4fd8350bd7a2f973e322ba7779e13756a5a"
    },
    {
      "raw_line": 57,
      "paragraph_id": "c-songshu-042-wanghong:line057",
      "facts": [
        {
          "start": 0,
          "end": 36,
          "surface": "高祖因宴集，謂羣公曰：「我布衣，始望不至此。」傅亮之徒並撰辭欲盛稱功德。",
          "kind": "宴對",
          "note": "劉裕對群公自言布衣，初無此望。傅亮等欲頌功德。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line057:m0023",
            "c-songshu-042-wanghong:line057:m0000",
            "c-songshu-042-wanghong:line057:m0012"
          ]
        },
        {
          "start": 36,
          "end": 69,
          "surface": "弘率爾對曰：「此所謂天命，求之不可得，推之不可去。」時人稱其簡舉。",
          "kind": "對答",
          "note": "弘稱天命無可求推，時人稱賞其簡舉。宴年月未記。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line057:m0036",
            "c-songshu-042-wanghong:line057:r0065"
          ]
        }
      ],
      "paragraph_sha256": "fa813114c1b99ed6f8977fb2ef20248133f574b0725cb549eb27824f2ea44b27"
    }
  ],
