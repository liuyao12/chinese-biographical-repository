{
  "source_path": "sources/calendar-context/songshu042-fixed1478172.wikitext",
  "revision": 1478172,
  "paragraphs": [
    {
      "raw_line": 71,
      "paragraph_id": "c-songshu-042-wanghong:line071",
      "sha256": "57990966db55704a399087d32fc137c6588dd6ec0648494167b2e8a69b117b65",
      "facts": [
        {
          "start": 0,
          "end": 30,
          "surface": "弘博練治體，留心庶事，斟酌時宜，每存優允。與八座丞郎疏曰：「",
          "kind": "立議",
          "note": "斟酌政務，向八座丞郎徵詢。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line071:m0000",
            "c-songshu-042-wanghong:line071:m0022"
          ]
        },
        {
          "start": 30,
          "end": 92,
          "surface": "同伍犯法，無士人不罪之科，然每至詰謫，輒有請訴。若垂恩宥，則法廢不可行；依事糾責，則物以為苦怨。宜更為其制，使得優苦之衷也。",
          "kind": "符伍",
          "note": "現制士人連坐，請訴及寬貸、責罰兩難，議調整。",
          "occurrence_ids": []
        },
        {
          "start": 92,
          "end": 140,
          "surface": "又主守偷五匹，常偷四十匹，並加大辟，議者咸以為重，宜進主守偷十匹、常偷五十匹死，四十匹降以補兵。",
          "kind": "盜贓",
          "note": "舊制主守五匹、常偷四十匹均死；擬提高至十匹、五十匹，四十匹補兵。",
          "occurrence_ids": []
        },
        {
          "start": 140,
          "end": 161,
          "surface": "既得小寬民命，亦足以有懲也。想各言所懷。」",
          "kind": "徵詢",
          "note": "保全民命並懲戒，請群臣各言。",
          "occurrence_ids": []
        }
      ],
      "speaker_person_id": "7r6_k52_qji_ABAAAAA",
      "second_speaker_person_id": null
    },
    {
      "raw_line": 73,
      "paragraph_id": "c-songshu-042-wanghong:line073",
      "sha256": "cee5bb6e0ee79c75f6994f196920ea2fca3e7371fd30f725677ac3567ec56c13",
      "facts": [
        {
          "start": 0,
          "end": 56,
          "surface": "左丞江奧議：「士人犯盜贓不及棄市者，刑竟，自在贓汙淫盜之目，清議終身，經赦不原。當之者足以塞愆，聞之者足以鑒誡。",
          "kind": "士人",
          "note": "江奧論士人盜未至死刑，行刑後終身清議不因赦免。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line073:m0002"
          ]
        },
        {
          "start": 56,
          "end": 73,
          "surface": "若復雷同羣小，謫以兵役，愚謂為苦。",
          "kind": "刑罰",
          "note": "反對再加兵役。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line073:r0068"
          ]
        },
        {
          "start": 73,
          "end": 103,
          "surface": "符伍雖比屋鄰居，至於士庶之際，實自天隔，舍藏之罪，無以相關。",
          "kind": "符伍",
          "note": "士庶隔絕，不能就舍藏同罪。",
          "occurrence_ids": []
        },
        {
          "start": 103,
          "end": 154,
          "surface": "奴客與符伍交接，有所藏蔽，可以得知，是以罪及奴客。自是客身犯愆，非代郎主受罪也。如其無奴，則不應坐。」",
          "kind": "奴客",
          "note": "奴客可知藏匿，因自身犯罪，並非代郎主；無奴家不坐。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line073:m0137"
          ]
        }
      ],
      "speaker_person_id": "6f2_3da_060",
      "second_speaker_person_id": null
    },
    {
      "raw_line": 75,
      "paragraph_id": "c-songshu-042-wanghong:line075",
      "sha256": "62d831e71a52683f2c7d0248b3a3c992c34d664b46182fee4b7e361686fbf11c",
      "facts": [
        {
          "start": 0,
          "end": 69,
          "surface": "右丞孔默之議：「君子小人，既雜為符伍，不得不以相檢為義。士庶雖殊，而理有聞察，譬百司居上，所以下不必躬親而後同坐。是故犯違之日，理自相關。",
          "kind": "符伍",
          "note": "孔默之以士庶混居應互相檢察，百司不必親自檢察始負責。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line075:m0002"
          ]
        },
        {
          "start": 69,
          "end": 85,
          "surface": "今罪其養子、典計者，蓋義存戮僕。",
          "kind": "法律身分",
          "note": "養子、典計與戮僕是法例中的受罰身分；無個別養親、養子姓名，亦無領養事件。",
          "occurrence_ids": []
        },
        {
          "start": 85,
          "end": 110,
          "surface": "如此，則無奴之室，豈得宴安。但既云復士，宜令輸贖。",
          "kind": "無奴與輸贖",
          "note": "無奴不能免，復士應輸贖。",
          "occurrence_ids": []
        },
        {
          "start": 110,
          "end": 126,
          "surface": "常盜四十匹，主守五匹，降死補兵。",
          "kind": "盜與兵役",
          "note": "討論常盜四十匹、主守五匹降死補兵。",
          "occurrence_ids": []
        },
        {
          "start": 126,
          "end": 185,
          "surface": "雖大存寬惠，以紓民命，然官及二千石及失節士大夫，時有犯者，罪乃可戮，恐不可以補兵也。謂此制可施小人，士人自還用舊律。」",
          "kind": "官長與士庶",
          "note": "二千石及失節士大夫有不當補兵者，主張只有小人適用，士人仍從舊律。",
          "occurrence_ids": []
        }
      ],
      "speaker_person_id": "vhw_07a_wzm_AB",
      "second_speaker_person_id": null
    },
    {
      "raw_line": 77,
      "paragraph_id": "c-songshu-042-wanghong:line077",
      "sha256": "c4b7a1779c4d4f7d2f401cfd2c053093f6267456f2e799c746b570a785519d3f",
      "facts": [
        {
          "start": 0,
          "end": 59,
          "surface": "尚書王准之議：「昔為山陰令，士人在伍，謂之押符。同伍有愆，得不及坐，士人有罪，符伍糾之。此非士庶殊制，實使即刑當罪耳。",
          "kind": "山陰實務",
          "note": "王准之昔任山陰令稱士人押符，同伍及士人有罪各按責檢。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line077:m0002"
          ]
        },
        {
          "start": 59,
          "end": 108,
          "surface": "夫束脩之冑，與小人隔絕，防檢無方，宜及不逞之士，事接羣細，既同符伍，故使糾之。于時行此，非唯一處。",
          "kind": "按實情",
          "note": "士人與庶民交隔，與群細相接者方可責糾。",
          "occurrence_ids": []
        },
        {
          "start": 108,
          "end": 213,
          "surface": "左丞議奴客與鄰伍相關，可得檢察，符中有犯，使及刑坐。即事而求，有乖實理。有奴客者，類多使役，東西分散，住家者少。其有停者，左右驅馳，動止所須，出門甚寡，典計者在家十無其一。奴客坐伍，濫刑必眾，恐非立法當罪本旨。",
          "kind": "反對江奧",
          "note": "轉述江奧關於奴客連坐的理由；本人以奴客使役分散、鮮有在家而駁之。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line077:m0108"
          ]
        },
        {
          "start": 213,
          "end": 231,
          "surface": "右丞議士人犯偷，不及大辟者，宥補兵。",
          "kind": "反對孔默之",
          "note": "轉述孔默之關於不及大辟者寬免補兵的意見。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line077:m0213"
          ]
        },
        {
          "start": 231,
          "end": 299,
          "surface": "雖欲弘士，懼無以懲邪。乘理則君子，違之則小人。制嚴於上，猶冒犯之，以其宥科，犯者或眾。使畏法革心，乃所以大宥也。且士庶異制，意所不同。」",
          "kind": "刑政",
          "note": "弘士為厚待士人；准之主張嚴制懲邪。",
          "occurrence_ids": []
        }
      ],
      "speaker_person_id": "72e_1a7_3ac",
      "second_speaker_person_id": null
    },
    {
      "raw_line": 79,
      "paragraph_id": "c-songshu-042-wanghong:line079",
      "sha256": "9c78144691f1d2a5b44aff820a7bf09a6b70fa9790a16bf8e8865675e256eeda",
      "facts": [
        {
          "start": 0,
          "end": 51,
          "surface": "殿中郎謝元議謂：「事必先正其本，然後其末可理。本所以押士大夫於符伍者，所以檢小人邪？為使受檢於小人邪？",
          "kind": "檢察方向",
          "note": "謝元先辨符伍之設究竟士檢小人或受檢於小人。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line079:m0003"
          ]
        },
        {
          "start": 51,
          "end": 185,
          "surface": "案左丞稱士庶天隔，則士無弘庶之由，以不知而押之於伍，則是受檢於小人也。然則小人有罪，士人無事，僕隸何罪，而令坐之。若以實相交關，責其聞察，則意有未因。何者？名實殊章，公私異令，奴不押符，是無名也，民乏貲財，是私賤也。以私賤無名之人，豫公家有實之任，公私混淆，名實非允。",
          "kind": "名實",
          "note": "引江奧士庶天隔之說，辨奴無押符之名、不得以私賤受公責。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line079:m0052"
          ]
        },
        {
          "start": 185,
          "end": 265,
          "surface": "由此而言，謂不宜坐。還從其主，於事為宜。無奴之士，不在此例。若士人本檢小人，則小人有過，己應獲罪，而其奴則義歸戮僕，然則無奴之士，未合宴安，使之輸贖，於事非謬。",
          "kind": "應否坐奴",
          "note": "若士人受檢，奴不應坐；若士本檢小人，士與奴得各有責，無奴可贖。",
          "occurrence_ids": []
        },
        {
          "start": 265,
          "end": 313,
          "surface": "二科所附，惟制之本耳。此自是辯章二本，欲使各從其分。至於求之管見，宜附前科，區別士庶，於義為美。",
          "kind": "取捨",
          "note": "兩讀取決於立制初衷，謝元偏前一義分別士庶。",
          "occurrence_ids": []
        },
        {
          "start": 313,
          "end": 350,
          "surface": "盜制，按左丞議，士人既終不為兵革，幸可同寬宥之惠，不必依舊律，於議咸允。」",
          "kind": "盜法",
          "note": "引江奧，主張士人亦同享寬宥。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line079:m0317"
          ]
        }
      ],
      "speaker_person_id": "5e5_71f_e6a",
      "second_speaker_person_id": null
    },
    {
      "raw_line": 81,
      "paragraph_id": "c-songshu-042-wanghong:line081",
      "sha256": "7b6983bf11d15d2da65152ea408fbd10576df52a0e507089ff22f4273db8a608",
      "facts": [
        {
          "start": 0,
          "end": 61,
          "surface": "吏部郎何尚之議：「按孔右丞議，士人坐符伍為罪，有奴罪奴，無奴輸贖。既許士庶緬隔，則聞察自難，不宜以難知之事，定以必知之法。",
          "kind": "孔默之議",
          "note": "何尚之辨有奴罪奴、無奴輸贖以及士庶相隔、難強令聞知。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line081:m0003",
            "c-songshu-042-wanghong:line081:m0010"
          ]
        },
        {
          "start": 61,
          "end": 127,
          "surface": "夫有奴不賢，無奴不必不賢。今多僮者傲然於王憲，無僕者怵迫於時網，是為恩之所霑，恒在程、卓，法之所設，必加顏、原，求之鄙懷，竊所未愜。",
          "kind": "貧富",
          "note": "指出有僮者得免、無僕者受罰，富以程鄭卓王孫、貧以顏回原憲為例，皆古人。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line081:m0102",
            "c-songshu-042-wanghong:line081:m0104",
            "c-songshu-042-wanghong:line081:m0113",
            "c-songshu-042-wanghong:line081:m0115",
            "c-songshu-042-wanghong:line081:r0119"
          ]
        },
        {
          "start": 127,
          "end": 174,
          "surface": "謝殿中謂奴不隨主，於名分不明，誠是有理。然奴僕實與閭里相關，今都不問，恐有所失。意同左丞議。」",
          "kind": "相互檢察",
          "note": "附同謝元對名分的問題，認奴與里相接仍需問，結語同江奧。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line081:m0127",
            "c-songshu-042-wanghong:line081:m0169"
          ]
        }
      ],
      "speaker_person_id": "d84_kqu_2g5",
      "second_speaker_person_id": null
    },
    {
      "raw_line": 83,
      "paragraph_id": "c-songshu-042-wanghong:line083",
      "sha256": "74bd13162b6f21a347bfe3cd3963c9c2282ba681d70125367cc95328740ca9b3",
      "facts": [
        {
          "start": 0,
          "end": 44,
          "surface": "弘議曰：「尋律令既不分別士庶，又士人坐同伍罹謫者，無處無之，多為時恩所宥，故不盡親謫耳。",
          "kind": "舊制",
          "note": "王弘指出律令未分士庶，士人實有連坐，多因恩宥。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line083:m0000"
          ]
        },
        {
          "start": 44,
          "end": 99,
          "surface": "吳及義興適有許、陸之徒，以同符合給，二千石論啟丹書。己未間，會稽士人云十數年前，亦有四族坐此被責，以時恩獲停。",
          "kind": "吳會事例",
          "note": "許陸之徒、二千石、會稽士人與四族，均未具個體名；古事以己未、十數年前分層。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line083:m0050",
            "c-songshu-042-wanghong:line083:m0052"
          ]
        },
        {
          "start": 99,
          "end": 130,
          "surface": "而王尚書云人舊無同伍坐，所未之解。恐莅任之日，偶不值此事故邪。",
          "kind": "駁准之",
          "note": "引王准之舊無連坐之說，以任內偶未值此事詰之。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line083:m0100"
          ]
        },
        {
          "start": 130,
          "end": 173,
          "surface": "聖明御世，士人誠不憂至苦，然要須臨事論通，上干天聽為紛擾，不如近為定科，使輕重有節也。",
          "kind": "立科",
          "note": "主張定科以免零碎奏請至君前。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line083:m0130",
            "c-songshu-042-wanghong:line083:r0153"
          ]
        },
        {
          "start": 173,
          "end": 222,
          "surface": "又尋甲符制，蠲士人不傳符耳，令史復除，亦得如之。共相押領，有違糾列，了無等衰，非許士人閭里之外也。",
          "kind": "押符",
          "note": "蠲不傳符不等於脫離鄉里，糾列無等差。",
          "occurrence_ids": []
        },
        {
          "start": 222,
          "end": 301,
          "surface": "諸議云士庶緬絕，不相參知，則士人犯法，庶民得不知。若庶民不許不知，何許士人不知。小民自非超然簡獨，永絕塵粃者，比門接棟，小以為意，終自聞知，不必須日夕來往也。",
          "kind": "知情責任",
          "note": "反詰士庶互不知，近鄰實可耳聞。",
          "occurrence_ids": []
        },
        {
          "start": 301,
          "end": 413,
          "surface": "右丞百司之言，粗是其況。如衰陵士人，實與里巷關接，相知情狀，乃當於冠帶小民。今謂之士人，便無小人之坐；署為小民，輒受士人之罰。於情於法，不其頗歟？且都令不及士流，士流為輕，則小人令使徵預其罰，便事至相糾，閭伍之防，亦為不同。",
          "kind": "地位與處分",
          "note": "同意孔默之百司類比，檢視衰陵士人與冠帶小民、士名庶罰的失衡。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line083:m0301"
          ]
        },
        {
          "start": 413,
          "end": 472,
          "surface": "謂士人可不受同伍之讁耳，罪其奴客，庸何傷邪？無奴客，可令輸贖，又或無奴僮為眾所明者，官長二千石便當親臨列上，依事遣判。",
          "kind": "奴客",
          "note": "士人免同伍讁、罪奴或無奴輸贖；無奴僮可由二千石親報候裁。",
          "occurrence_ids": []
        },
        {
          "start": 472,
          "end": 536,
          "surface": "又主偷五匹，常偷四十匹，謂應見優量者，實以小吏無知，臨財易昧，或由疏慢，事蹈重科，求之於心，常有可愍，故欲小進匹數，寬其性命耳。",
          "kind": "盜贓",
          "note": "小吏無知或疏慢，擬提高刑額。",
          "occurrence_ids": []
        },
        {
          "start": 536,
          "end": 583,
          "surface": "至於官長以上，荷蒙祿榮，付以局任，當正己明憲，檢下防非，而親犯科律，亂法冒利，五匹乃已為弘矣。",
          "kind": "官長",
          "note": "官長責任較重，冒利五匹已大。弘字作寬多。",
          "occurrence_ids": []
        },
        {
          "start": 583,
          "end": 642,
          "surface": "士人無私相偷四十匹理，就使至此，致以明罰，固其宜耳，並何容復加哀矜。且此輩士人，可殺不可讁，有如諸論，本意自不在此也。",
          "kind": "士人犯法",
          "note": "士人私偷四十匹理應受明罰，可殺不可讁所指處分不同。",
          "occurrence_ids": []
        },
        {
          "start": 642,
          "end": 692,
          "surface": "近聞之道路，聊欲共論，不呼乃爾難精。既眾議糾紛，將不如其已。若呼不應停寢，謂宜集議奏聞，決之聖旨。」",
          "kind": "奏裁",
          "note": "諸議不同，如不停議，宜上奏帝裁。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line083:r0688"
          ]
        },
        {
          "start": 692,
          "end": 704,
          "surface": "太祖詔：「衞軍議為允。」",
          "kind": "君裁",
          "note": "劉義隆詔可衛將軍王弘議。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line083:m0692",
            "c-songshu-042-wanghong:line083:m0697"
          ]
        }
      ],
      "speaker_person_id": "7r6_k52_qji_ABAAAAA",
      "second_speaker_person_id": "3bh_k4m_fg4"
    },
    {
      "raw_line": 85,
      "paragraph_id": "c-songshu-042-wanghong:line085",
      "sha256": "7826195a17784be1bebbbfea06ee76d441b90366c44f507370b9af1040cc8753",
      "facts": [
        {
          "start": 0,
          "end": 40,
          "surface": "弘又上言：「舊制，民年十三半役，十六全役。當以十三以上，能自營私及公，故以充役。",
          "kind": "舊役齡",
          "note": "以民十三半役、十六全役；議其原意在能兼公私。",
          "occurrence_ids": [
            "c-songshu-042-wanghong:line085:m0000"
          ]
        },
        {
          "start": 40,
          "end": 117,
          "surface": "而考之見事，猶或未盡。體有強弱，不皆稱年。且在家自隨，力所能堪，不容過苦。移之公役，動有定科，循吏隱恤，可無其患，庸宰守常，已有勤劇，況值苛政，豈可稱言。",
          "kind": "量力",
          "note": "個別體力不同，私役能自量，公役有定科，苛政更重。",
          "occurrence_ids": []
        },
        {
          "start": 117,
          "end": 181,
          "surface": "乃有務在豐役，增進年齒，孤遠貧弱，其敝尤深。至令依寄無所，生死靡告，一身之切，逃竄求免，家人遠討，胎孕不育，巧避羅憲，實亦由之。",
          "kind": "實害",
          "note": "增報年齒、弱者受役、逃匿牽家與胎孕不育。",
          "occurrence_ids": []
        },
        {
          "start": 181,
          "end": 224,
          "surface": "今皇化惟新，四方無事，役召之宜，應存乎消息。十五至十六，宜為半丁，十七為全丁。」從之。",
          "kind": "新役齡",
          "note": "提出十五至十六半丁、十七全丁；從之為制度採行。",
          "occurrence_ids": []
        }
      ],
      "speaker_person_id": "7r6_k52_qji_ABAAAAA",
      "second_speaker_person_id": null
    }
  ],
