{
  "unit": "xiu",
  "title": "王秀之",
  "subject_id": "7r6_k52_qji_ABDABAABA",
  "notes": [
    {
      "id": "n24-xiu-33-0-received_sentence",
      "kind": "received_sentence",
      "person_id": "7r6_k52_qji_ABDABAABA",
      "paragraph_id": "c-nanshi-024-wang-family:line033",
      "start_codepoint": 0,
      "end_codepoint": 18,
      "source_quote": "秀之字伯奮，幼時，祖父敬弘愛其風采。",
      "reading": "秀之字伯奮，祖父敬弘愛其風采。",
      "note": "秀之字伯奮，祖父敬弘愛其風采。",
      "human_reviewed": false
    },
    {
      "id": "n24-xiu-33-18-received_sentence",
      "kind": "received_sentence",
      "person_id": "7r6_k52_qji_ABDABAABA",
      "paragraph_id": "c-nanshi-024-wang-family:line033",
      "start_codepoint": 18,
      "end_codepoint": 26,
      "source_quote": "仕宋爲太子舍人。",
      "reading": "宋官太子舍人。",
      "note": "宋官太子舍人。",
      "human_reviewed": false
    },
    {
      "id": "n24-xiu-33-26-received_sentence",
      "kind": "received_sentence",
      "person_id": "7r6_k52_qji_ABDABAABA",
      "paragraph_id": "c-nanshi-024-wang-family:line033",
      "start_codepoint": 26,
      "end_codepoint": 40,
      "source_quote": "父卒，廬於墓側，服闋，復職。",
      "reading": "秀之父瓚之卒，結廬墓側，服闋復職。",
      "note": "秀之父瓚之卒，結廬墓側，服闋復職。",
      "human_reviewed": false
    },
    {
      "id": "n24-xiu-33-40-received_sentence",
      "kind": "received_sentence",
      "person_id": "7r6_k52_qji_ABDABAABA",
      "paragraph_id": "c-nanshi-024-wang-family:line033",
      "start_codepoint": 40,
      "end_codepoint": 68,
      "source_quote": "吏部尚書褚彥回欲與結婚，秀之不肯，以此頻爲兩府外兵參軍。",
      "reading": "褚彥回欲聯姻，秀之拒絕，屢任兩府外兵參軍。",
      "note": "褚彥回欲聯姻，秀之拒絕，屢任兩府外兵參軍。",
      "human_reviewed": false
    },
    {
      "id": "n24-xiu-33-68-received_sentence",
      "kind": "received_sentence",
      "person_id": "7r6_k52_qji_ABDABAABA",
      "paragraph_id": "c-nanshi-024-wang-family:line033",
      "start_codepoint": 68,
      "end_codepoint": 122,
      "source_quote": "後爲晉平太守，期年求還，或問其故，答曰：「此郡沃壤，珍阜日至，人所昧者財，財生則禍逐，智者不昧財，亦不逐禍。",
      "reading": "出守晉平一年請還，答人以財能生禍。",
      "note": "出守晉平一年請還，答人以財能生禍。",
      "human_reviewed": false
    },
    {
      "id": "n24-xiu-33-122-received_sentence",
      "kind": "received_sentence",
      "person_id": "7r6_k52_qji_ABDABAABA",
      "paragraph_id": "c-nanshi-024-wang-family:line033",
      "start_codepoint": 122,
      "end_codepoint": 139,
      "source_quote": "吾山資已足，豈可久留，以妨賢路。」",
      "reading": "自稱山中資業已足，不應妨礙賢者進身。",
      "note": "自稱山中資業已足，不應妨礙賢者進身。",
      "human_reviewed": false
    },
    {
      "id": "n24-xiu-33-139-received_sentence",
      "kind": "received_sentence",
      "person_id": "7r6_k52_qji_ABDABAABA",
      "paragraph_id": "c-nanshi-024-wang-family:line033",
      "start_codepoint": 139,
      "end_codepoint": 145,
      "source_quote": "乃上表請代。",
      "reading": "上表請人接任。",
      "note": "上表請人接任。",
      "human_reviewed": false
    },
    {
      "id": "n24-xiu-33-145-received_sentence",
      "kind": "received_sentence",
      "person_id": "7r6_k52_qji_ABDABAABA",
      "paragraph_id": "c-nanshi-024-wang-family:line033",
      "start_codepoint": 145,
      "end_codepoint": 157,
      "source_quote": "時人以爲王晉平恐富求歸。",
      "reading": "時人以晉平太守之官號稱其恐富求歸。",
      "note": "時人以晉平太守之官號稱其恐富求歸。",
      "human_reviewed": false
    },
    {
      "id": "n24-xiu-35-0-received_sentence",
      "kind": "received_sentence",
      "person_id": "7r6_k52_qji_ABDABAABA",
      "paragraph_id": "c-nanshi-024-wang-family:line035",
      "start_codepoint": 0,
      "end_codepoint": 12,
      "source_quote": "仕齊爲豫章王嶷驃騎長史。",
      "reading": "入齊任豫章王嶷驃騎長史。",
      "note": "入齊任豫章王嶷驃騎長史。",
      "human_reviewed": false
    },
    {
      "id": "n24-xiu-35-12-received_sentence",
      "kind": "received_sentence",
      "person_id": "7r6_k52_qji_ABDABAABA",
      "paragraph_id": "c-nanshi-024-wang-family:line035",
      "start_codepoint": 12,
      "end_codepoint": 28,
      "source_quote": "嶷於荊州立學，以秀之領儒林祭酒。",
      "reading": "嶷在荊州立學，秀之領儒林祭酒。",
      "note": "嶷在荊州立學，秀之領儒林祭酒。",
      "human_reviewed": false
    },
    {
      "id": "n24-xiu-35-28-received_sentence",
      "kind": "received_sentence",
      "person_id": "7r6_k52_qji_ABDABAABA",
      "paragraph_id": "c-nanshi-024-wang-family:line035",
      "start_codepoint": 28,
      "end_codepoint": 46,
      "source_quote": "武帝即位，累遷侍中祭酒，轉都官尚書。",
      "reading": "齊武帝即位後，任侍中祭酒，轉都官尚書。",
      "note": "齊武帝即位後，任侍中祭酒，轉都官尚書。",
      "human_reviewed": false
    },
    {
      "id": "n24-xiu-37-0-received_sentence",
      "kind": "received_sentence",
      "person_id": "7r6_k52_qji_ABDABAABA",
      "paragraph_id": "c-nanshi-024-wang-family:line037",
      "start_codepoint": 0,
      "end_codepoint": 24,
      "source_quote": "秀之祖父敬弘性貞正，徐羨之、傅亮當朝，不與來往。",
      "reading": "追敘祖父敬弘與徐羨之、傅亮不相交往。",
      "note": "追敘祖父敬弘與徐羨之、傅亮不相交往。",
      "human_reviewed": false
    },
    {
      "id": "n24-xiu-37-24-received_sentence",
      "kind": "received_sentence",
      "person_id": "7r6_k52_qji_ABDABAABA",
      "paragraph_id": "c-nanshi-024-wang-family:line037",
      "start_codepoint": 24,
      "end_codepoint": 45,
      "source_quote": "及致仕隱呉興，與秀之父瓚之書，深勖以靜退。",
      "reading": "敬弘退居吳興，致書秀之父瓚之，勉以靜退。",
      "note": "敬弘退居吳興，致書秀之父瓚之，勉以靜退。",
      "human_reviewed": false
    },
    {
      "id": "n24-xiu-37-96-received_sentence",
      "kind": "received_sentence",
      "person_id": "7r6_k52_qji_ABDABAABA",
      "paragraph_id": "c-nanshi-024-wang-family:line037",
      "start_codepoint": 96,
      "end_codepoint": 111,
      "source_quote": "至秀之爲尚書，又不與王儉款接。",
      "reading": "秀之為尚書時不與王儉款接。",
      "note": "秀之為尚書時不與王儉款接。",
      "human_reviewed": false
    },
    {
      "id": "n24-xiu-37-111-received_sentence",
      "kind": "received_sentence",
      "person_id": "7r6_k52_qji_ABDABAABA",
      "paragraph_id": "c-nanshi-024-wang-family:line037",
      "start_codepoint": 111,
      "end_codepoint": 123,
      "source_quote": "三世不事權貴，時人稱之。",
      "reading": "三世遠權貴，得時人稱許。",
      "note": "三世遠權貴，得時人稱許。",
      "human_reviewed": false
    },
    {
      "id": "n24-xiu-37-123-received_sentence",
      "kind": "received_sentence",
      "person_id": "7r6_k52_qji_ABDABAABA",
      "paragraph_id": "c-nanshi-024-wang-family:line037",
      "start_codepoint": 123,
      "end_codepoint": 133,
      "source_quote": "轉侍中，領射聲校尉。",
      "reading": "轉侍中，領射聲校尉。",
      "note": "轉侍中，領射聲校尉。",
      "human_reviewed": false
    },
    {
      "id": "n24-xiu-39-0-received_sentence",
      "kind": "received_sentence",
      "person_id": "7r6_k52_qji_ABDABAABA",
      "paragraph_id": "c-nanshi-024-wang-family:line039",
      "start_codepoint": 0,
      "end_codepoint": 14,
      "source_quote": "出爲隨王鎭西長史、南郡內史。",
      "reading": "隨王鎭西長史、南郡內史。",
      "note": "隨王鎭西長史、南郡內史。",
      "human_reviewed": false
    },
    {
      "id": "n24-xiu-39-14-received_sentence",
      "kind": "received_sentence",
      "person_id": "7r6_k52_qji_ABDABAABA",
      "paragraph_id": "c-nanshi-024-wang-family:line039",
      "start_codepoint": 14,
      "end_codepoint": 26,
      "source_quote": "後爲輔國將軍、呉興太守。",
      "reading": "後為輔國將軍與吳興太守。",
      "note": "後為輔國將軍與吳興太守。",
      "human_reviewed": false
    },
    {
      "id": "n24-xiu-39-26-received_sentence",
      "kind": "received_sentence",
      "person_id": "7r6_k52_qji_ABDABAABA",
      "paragraph_id": "c-nanshi-024-wang-family:line039",
      "start_codepoint": 26,
      "end_codepoint": 54,
      "source_quote": "秀之先爲諸王長史、行事，便歎曰：「仲祖之識，見於已多。」",
      "reading": "歷任諸王長史、行事，引仲祖自歎。",
      "note": "歷任諸王長史、行事，引仲祖自歎。",
      "human_reviewed": false
    },
    {
      "id": "n24-xiu-39-54-received_sentence",
      "kind": "received_sentence",
      "person_id": "7r6_k52_qji_ABDABAABA",
      "paragraph_id": "c-nanshi-024-wang-family:line039",
      "start_codepoint": 54,
      "end_codepoint": 74,
      "source_quote": "便無復仕進，止營理舍亭山宅，有終焉之志。",
      "reading": "遂營舍亭山宅，有終老之志。",
      "note": "遂營舍亭山宅，有終老之志。",
      "human_reviewed": false
    },
    {
      "id": "n24-xiu-39-74-received_sentence",
      "kind": "received_sentence",
      "person_id": "7r6_k52_qji_ABDABAABA",
      "paragraph_id": "c-nanshi-024-wang-family:line039",
      "start_codepoint": 74,
      "end_codepoint": 90,
      "source_quote": "及除呉興郡，隱業所在，心願爲之。",
      "reading": "吳興有其隱業，願任本郡。",
      "note": "吳興有其隱業，願任本郡。",
      "human_reviewed": false
    },
    {
      "id": "n24-xiu-39-90-received_sentence",
      "kind": "received_sentence",
      "person_id": "7r6_k52_qji_ABDABAABA",
      "paragraph_id": "c-nanshi-024-wang-family:line039",
      "start_codepoint": 90,
      "end_codepoint": 101,
      "source_quote": "到郡修舊山，移置輜重。",
      "reading": "至郡修山宅、移置輜重。",
      "note": "至郡修山宅、移置輜重。",
      "human_reviewed": false
    },
    {
      "id": "n24-xiu-39-101-received_sentence",
      "kind": "received_sentence",
      "person_id": "7r6_k52_qji_ABDABAABA",
      "paragraph_id": "c-nanshi-024-wang-family:line039",
      "start_codepoint": 101,
      "end_codepoint": 124,
      "source_quote": "隆昌元年卒，遺令「朱服不得入棺，祭則酒脯而已。",
      "reading": "隆昌元年卒；遺令不用朱服入棺，祭用酒脯。",
      "note": "隆昌元年卒；遺令不用朱服入棺，祭用酒脯。",
      "human_reviewed": false
    },
    {
      "id": "n24-xiu-39-124-received_sentence",
      "kind": "received_sentence",
      "person_id": "7r6_k52_qji_ABDABAABA",
      "paragraph_id": "c-nanshi-024-wang-family:line039",
      "start_codepoint": 124,
      "end_codepoint": 150,
      "source_quote": "世人以僕妾直靈助哭，當由喪主不能淳至，欲以多聲相亂。",
      "reading": "談僕妾助哭，認為喪主當自盡哀。",
      "note": "談僕妾助哭，認為喪主當自盡哀。",
      "human_reviewed": false
    },
    {
      "id": "n24-xiu-39-150-received_sentence",
      "kind": "received_sentence",
      "person_id": "7r6_k52_qji_ABDABAABA",
      "paragraph_id": "c-nanshi-024-wang-family:line039",
      "start_codepoint": 150,
      "end_codepoint": 161,
      "source_quote": "魂而有靈，吾當笑之」。",
      "reading": "以自己身後有靈則當笑之作結。",
      "note": "以自己身後有靈則當笑之作結。",
      "human_reviewed": false
    },
    {
      "id": "n24-xiu-39-161-received_sentence",
      "kind": "received_sentence",
      "person_id": "7r6_k52_qji_ABDABAABA",
      "paragraph_id": "c-nanshi-024-wang-family:line039",
      "start_codepoint": 161,
      "end_codepoint": 166,
      "source_quote": "諡曰簡子。",
      "reading": "諡簡子。",
      "note": "諡簡子。",
      "human_reviewed": false
    },
    {
