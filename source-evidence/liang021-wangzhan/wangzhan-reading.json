      "revision": 2311630,
      "first_line": 57,
      "last_line": 57,
      "start_codepoint": 248,
      "end_codepoint": 259,
      "primary_quote": "丙辰，尚書令王晏伏誅。",
      "interpretation": "齊明帝紀建武四年（497）正月記伏誅干支。"
    },
    {
