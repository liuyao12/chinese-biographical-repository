      "revision": 1752646,
      "first_line": 105,
      "last_line": 105,
      "start_codepoint": 65,
      "end_codepoint": 77,
      "primary_quote": "卒，諡康侯。子長玄早卒。",
      "interpretation": "兩書均言子長玄早卒，無具年。"
    },
    {
      "source_line": 15,
      "paragraph_id": "c-liangshu-021-wangzhan:p003",
      "start": 105,
