    "exact_death_year": null,
    "birth_year": null,
    "readings": [
      "梁書報數歲、十二、四十九，未給確切卒年。",
      "限採《南史》受傳本「六歲」「從父僧達」，且兩個年數一概作虛歲時，僧達至遲458年已卒，推王瞻生年至遲453。從502年梁臺建後卒、年四十九推得生年至早454，兩端不同。殿本作僧遠，該見證無從套用僧達卒年。",
      "若只以末年暫設502，虛歲四十九的條件生年454，滿歲四十九則為452至453。未以條件算例建立生年。"
    ]
  },
  "clauses": [
    {
      "source_line": 11,
      "paragraph_id": "c-liangshu-021-wangzhan:p001",
      "start": 0,
      "end": 20,
      "quote": "王瞻字思範，琅邪臨沂人，宋太保弘從孫也。"
    },
    {
      "source_line": 11,
      "paragraph_id": "c-liangshu-021-wangzhan:p001",
      "start": 20,
      "end": 32,
      "quote": "祖柳，光祿大夫、東亭侯。"
    },
    {
      "source_line": 11,
      "paragraph_id": "c-liangshu-021-wangzhan:p001",
      "start": 32,
      "end": 39,
      "quote": "父猷，廷尉卿。"
    },
    {
      "source_line": 11,
      "paragraph_id": "c-liangshu-021-wangzhan:p001",
      "start": 39,
      "end": 73,
      "quote": "瞻年數歲，嘗從師受業，時有伎經其門，同學皆出觀，瞻獨不視，習誦如初。"
    },
    {
      "source_line": 11,
      "paragraph_id": "c-liangshu-021-wangzhan:p001",
      "start": 73,
      "end": 103,
      "quote": "從父尚書僕射僧達聞而異之，謂瞻父曰：「吾宗不衰，寄之此子。」"
    },
    {
      "source_line": 11,
      "paragraph_id": "c-liangshu-021-wangzhan:p001",
      "start": 103,
      "end": 115,
      "quote": "年十二，居父憂，以孝聞。"
    },
    {
      "source_line": 11,
      "paragraph_id": "c-liangshu-021-wangzhan:p001",
      "start": 115,
      "end": 124,
      "quote": "服闋，襲封東亭侯。"
    },
    {
      "source_line": 13,
      "paragraph_id": "c-liangshu-021-wangzhan:p002",
      "start": 0,
      "end": 16,
      "quote": "瞻幼時輕薄，好逸遊，爲閭里所患。"
    },
    {
      "source_line": 13,
      "paragraph_id": "c-liangshu-021-wangzhan:p002",
      "start": 16,
      "end": 37,
      "quote": "及長，頗折節有士操，涉獵書記，於朞射尤善。"
    },
    {
      "source_line": 15,
      "paragraph_id": "c-liangshu-021-wangzhan:p003",
      "start": 0,
      "end": 24,
      "quote": "起家著作佐郎，累遷太子舍人、太尉主簿、太子洗馬。"
    },
    {
      "source_line": 15,
      "paragraph_id": "c-liangshu-021-wangzhan:p003",
      "start": 24,
      "end": 44,
      "quote": "頃之，出爲鄱陽內史，秩滿，授太子中舍人。"
    },
    {
      "source_line": 15,
      "paragraph_id": "c-liangshu-021-wangzhan:p003",
      "start": 44,
      "end": 70,
      "quote": "又爲齊南海王友，尋轉司徒竟陵王從事中郎，王甚相賓禮。"
    },
    {
      "source_line": 15,
      "paragraph_id": "c-liangshu-021-wangzhan:p003",
      "start": 70,
      "end": 84,
      "quote": "南海王爲護軍將軍，瞻爲長史。"
    },
    {
      "source_line": 15,
      "paragraph_id": "c-liangshu-021-wangzhan:p003",
      "start": 84,
      "end": 105,
      "quote": "又出補徐州別駕從事史，遷驃騎將軍王晏長史。"
    },
    {
      "source_line": 15,
      "paragraph_id": "c-liangshu-021-wangzhan:p003",
      "start": 105,
      "end": 115,
      "quote": "晏誅，出爲晉陵太守。"
    },
    {
      "source_line": 15,
      "paragraph_id": "c-liangshu-021-wangzhan:p003",
      "start": 115,
      "end": 128,
      "quote": "瞻潔己爲政，妻子不免饑寒。"
    },
    {
      "source_line": 15,
      "paragraph_id": "c-liangshu-021-wangzhan:p003",
      "start": 128,
      "end": 152,
      "quote": "時大司馬王敬則舉兵作亂，路經晉陵，郡民多附敬則。"
    },
    {
      "source_line": 15,
      "paragraph_id": "c-liangshu-021-wangzhan:p003",
      "start": 152,
      "end": 179,
      "quote": "軍敗，臺軍討賊黨，瞻言於朝曰：「愚人易動，不足窮法。」"
    },
    {
      "source_line": 15,
      "paragraph_id": "c-liangshu-021-wangzhan:p003",
      "start": 179,
      "end": 191,
      "quote": "明帝許之，所全活者萬數。"
    },
    {
      "source_line": 15,
      "paragraph_id": "c-liangshu-021-wangzhan:p003",
      "start": 191,
      "end": 213,
      "quote": "徵拜給事黃門侍郎，撫軍建安王長史，御史中丞。"
    },
    {
      "source_line": 17,
      "paragraph_id": "c-liangshu-021-wangzhan:p004",
      "start": 0,
      "end": 23,
      "quote": "高祖霸府開，以瞻爲大司馬相國諮議參軍，領錄事。"
    },
    {
      "source_line": 17,
      "paragraph_id": "c-liangshu-021-wangzhan:p004",
      "start": 23,
      "end": 44,
      "quote": "梁臺建，爲侍中，遷左民尚書，俄轉吏部尚書。"
    },
    {
      "source_line": 17,
      "paragraph_id": "c-liangshu-021-wangzhan:p004",
      "start": 44,
      "end": 60,
      "quote": "瞻性率亮，居選部，所舉多行其意。"
    },
    {
      "source_line": 17,
      "paragraph_id": "c-liangshu-021-wangzhan:p004",
      "start": 60,
      "end": 82,
      "quote": "頗嗜酒，每飲或竟日，而精神益朗贍，不廢簿領。"
    },
    {
      "source_line": 17,
      "paragraph_id": "c-liangshu-021-wangzhan:p004",
      "start": 82,
      "end": 98,
      "quote": "高祖每稱瞻有三術，射、朞、酒也。"
    },
    {
      "source_line": 17,
      "paragraph_id": "c-liangshu-021-wangzhan:p004",
      "start": 98,
      "end": 132,
      "quote": "尋加左軍將軍，以疾不拜，仍爲侍中，領驍騎將軍，未拜，卒，時年四十九。"
    },
    {
      "source_line": 17,
      "paragraph_id": "c-liangshu-021-wangzhan:p004",
      "start": 132,
      "end": 136,
      "quote": "諡康侯。"
    },
    {
      "source_line": 17,
      "paragraph_id": "c-liangshu-021-wangzhan:p004",
      "start": 136,
      "end": 148,
      "quote": "子長玄，著作佐郎，早卒。"
    }
  ],
  "print_witness": "source-evidence/liang021-wangzhan/wuying-reading.json"
}
