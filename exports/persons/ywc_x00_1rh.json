ragraph_id":"c-shiji-128-guice:p013","chapter_id":"c-shiji-128-guice"},{"id":"c-shiji-128-guice:m014-0000","start":0,"end":2,"surface":"使者","kind":"person","person_id":"ywc_x00_1rh","status":"contextual_provisional","paragraph_id":"c-shiji-128-guice:p014","chapter_id":"c-shiji-128-guice"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-128-guice:p013","text":"於是王乃使人馳而往問泉陽令曰：「漁者幾何家？名誰為豫且？豫且得龜，見夢於王，王故使我求之。」泉陽令乃使吏案籍視圖，水上漁者五十五家，上流之廬，名為豫且。泉陽令曰：「諾。」乃與使者馳而問豫且曰：「今昔汝漁何得？」豫且曰：「夜半時舉網得龜。」使者曰：「今龜安在？」曰：「在籠中。」使者曰：「王知子得龜，故使我求之。」豫且曰：「諾。」即繋龜而出之籠中，獻使者。","annotation_status":"in_progress","text_layer":"witness_appended_chu_note","mentions":[{"id":"c-shiji-128-guice:m013-0002","start":2,"end":3,"surface":"王","kind":"person","person_id":"a4t_7hv_0s6","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m013-0010","start":10,"end":13,"surface":"泉陽令","kind":"person","person_id":"4sb_h3r_tey","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m013-0025","start":25,"end":27,"surface":"豫且","kind":"person","person_id":"uiq_fxy_s78","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m013-0028","start":28,"end":30,"surface":"豫且","kind":"person","person_id":"uiq_fxy_s78","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m013-0036","start":36,"end":37,"surface":"王","kind":"person","person_id":"a4t_7hv_0s6","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m013-0038","start":38,"end":39,"surface":"王","kind":"person","person_id":"a4t_7hv_0s6","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m013-0046","start":46,"end":49,"surface":"泉陽令","kind":"person","person_id":"4sb_h3r_tey","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m013-0073","start":73,"end":75,"surface":"豫且","kind":"person","person_id":"uiq_fxy_s78","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m013-0076","start":76,"end":79,"surface":"泉陽令","kind":"person","person_id":"4sb_h3r_tey","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m013-0087","start":87,"end":89,"surface":"使者","kind":"person","person_id":"ywc_x00_1rh","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m013-0092","start":92,"end":94,"surface":"豫且","kind":"person","person_id":"uiq_fxy_s78","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m013-0105","start":105,"end":107,"surface":"豫且","kind":"person","person_id":"uiq_fxy_s78","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m013-0119","start":119,"end":121,"surface":"使者","kind":"person","person_id":"ywc_x00_1rh","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m013-0138","start":138,"end":140,"surface":"使者","kind":"person","person_id":"ywc_x00_1rh","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m013-0143","start":143,"end":144,"surface":"王","kind":"person","person_id":"a4t_7hv_0s6","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m013-0156","start":156,"end":158,"surface":"豫且","kind":"person","person_id":"uiq_fxy_s78","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m013-0174","start":174,"end":176,"surface":"使者","kind":"person","person_id":"ywc_x00_1rh","status":"contextual_provisional"}],"chapter_id":"c-shiji-128-guice","book_id":"b-shiji-128","work_id":"w-shiji","source_id":"s-shiji128-guice"},{"id":"c-shiji-128-guice:p014","text":"使者載行，出於泉陽之門。正晝無見，風雨晦冥。雲蓋其上，五采青黃；雷雨并起，風將而行。入於端門，見於東箱。身如流水，潤澤有光。望見元王，延頸而前，三步而止，縮頸而卻，復其故處。元王見而怪之，問衛平曰：「龜見寡人，延頸而前，以何望也？縮頸而復，是何當也？」衛平對曰：「龜在患中，而終昔囚，王有德義，使人活之。今延頸而前，以當謝也，縮頸而卻，欲亟去也。」元王曰：「善哉！神至如此乎，不可久留；趣駕送龜，勿令失期。」衛平對曰：「龜者是天下之寶也，先得此龜者為天子，且十言十當，十戰十勝。生於深淵，長於黃土。知天之道，明於上古。游三千歲，不出其域。安平靜正，動不用力。壽蔽天地，莫知其極。與物變化，四時變色。居而自匿，伏而不食。春倉夏黃，秋白冬黑。明於陰陽，審於刑德。先知利害，察於禍福，以言而當，以戰而勝，王能寶之，諸侯盡服。王勿遣也，以安社稷。」元王曰：「龜甚神靈，降于上天，陷於深淵。在患難中。以我為賢。德厚而忠信，故來告寡人。寡人若不遣也，是漁者也。漁者利其肉，寡人貪其力，下為不仁，上為無德。君臣無禮，何從有福？寡人不忍，柰何勿遣！」衛平對曰：「不然。臣聞盛德不報，重寄不歸；天與不受，天奪之寶。今龜周流天下，還復其所，上至蒼天，下薄泥涂。還遍九州，未嘗愧辱，無所稽留。今至泉陽，漁者辱而囚之。王雖遣之，江河必怒，務求報仇。自以為侵，因神與謀。淫雨不霽，水不可治。若為枯旱，風而揚埃，蝗蟲暴生，百姓失時。王行仁義，其罰必來。此無佗故，其祟在龜。後雖悔之，豈有及哉！王勿遣也。」","annotation_status":"in_progress","text_layer":"witness_appended_chu_note","mentions":[{"id":"c-shiji-128-guice:m014-0000","start":0,"end":2,"surface":"使者","kind":"person","person_id":"ywc_x00_1rh","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m014-0064","start":64,"end":66,"surface":"元王","kind":"person","person_id":"a4t_7hv_0s6","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m014-0087","start":87,"end":89,"surface":"元王","kind":"person","person_id":"a4t_7hv_0s6","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m014-0095","start":95,"end":97,"surface":"衛平","kind":"person","person_id":"p27_7v5_rgy","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m014-0126","start":126,"end":128,"surface":"衛平","kind":"person","person_id":"p27_7v5_rgy","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m014-0142","start":142,"end":143,"surface":"王","kind":"person","person_id":"a4t_7hv_0s6","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m014-0174","start":174,"end":176,"surface":"元王","kind":"person","person_id":"a4t_7hv_0s6","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m014-0204","start":204,"end":206,"surface":"衛平","kind":"person","person_id":"p27_7v5_rgy","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m014-0349","start":349,"end":350,"surface":"王","kind":"person","person_id":"a4t_7hv_0s6","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m014-0359","start":359,"end":360,"surface":"王","kind":"person","person_id":"a4t_7hv_0s6","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m014-0370","start":370,"end":372,"surface":"元王","kind":"person","person_id":"a4t_7hv_0s6","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m014-0467","start":467,"end":469,"surface":"衛平","kind":"person","person_id":"p27_7v5_rgy","status":"con