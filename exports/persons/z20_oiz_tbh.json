passages":[{"id":"c-nanqishu-040-zixiang:p004","text":"諧之等至江津，築城燕尾洲，遣傳詔石伯兒入城慰勞。子響曰：「我不作賊，長史等見負，今政當受殺人罪耳。」乃殺牛具酒饌，餉臺軍。而諧之等疑畏，執錄其吏。子響怒，遣所養數十人收集府州器仗，令二千人從靈溪西渡，克明旦與臺軍對陣南岸。子響自與百餘人袍騎，將萬鈞弩三四張，宿江堤上。明日，凶黨與臺軍戰，子響於堤上放弩，亡命王充天等蒙楯陵城，臺軍大敗，尹略死之，官軍引退。上又遣丹陽尹蕭順之領兵繼至，子響部下恐懼，各逃散，子響乃白服降，賜死。時年二十二。","mentions":[{"id":"c-nanqishu-040-zixiang:p004:m0000","surface":"諧之","start":0,"end":2,"person_id":"2yz_7xj_cx7","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-040-zixiang:p004:m0016","surface":"石伯兒","start":16,"end":19,"person_id":"v70_w6g_f8w","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-040-zixiang:p004:m0024","surface":"子響","start":24,"end":26,"person_id":"kix_r92_2ed_G","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-040-zixiang:p004:m0062","surface":"諧之","start":62,"end":64,"person_id":"2yz_7xj_cx7","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-040-zixiang:p004:m0073","surface":"子響","start":73,"end":75,"person_id":"kix_r92_2ed_G","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-040-zixiang:p004:m0111","surface":"子響","start":111,"end":113,"person_id":"kix_r92_2ed_G","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-040-zixiang:p004:m0144","surface":"子響","start":144,"end":146,"person_id":"kix_r92_2ed_G","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-040-zixiang:p004:m0154","surface":"王充天","start":154,"end":157,"person_id":"z20_oiz_tbh","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-040-zixiang:p004:m0168","surface":"尹略","start":168,"end":170,"person_id":"xto_ews_eyo","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id