{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000661","identity_policy":"contextual_provisional","person_ids":["cbr-p000661"],"persons":[{"id":"cbr-p000661","label":"餘樊君","status":"active","historicity":"historical_tradition","aliases":[{"surface":"餘樊君","mention_ids":["c-shiji-007-xiangyu:m005-0134","c-shiji-007-xiangyu:m005-0140"]}],"evidence":[{"mention_id":"c-shiji-007-xiangyu:m005-0134","chapter_id":"c-shiji-007-xiangyu","paragraph_id":"c-shiji-007-xiangyu:p005","quote":"餘樊君"},{"mention_id":"c-shiji-007-xiangyu:m005-0140","chapter_id":"c-shiji-007-xiangyu","paragraph_id":"c-shiji-007-xiangyu:p005","quote":"餘樊君"}]}],"mentions":[{"id":"c-shiji-007-xiangyu:m005-0134","start":134,"end":137,"surface":"餘樊君","kind":"person","person_id":"cbr-p000661","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p005","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-007-xiangyu:m005-0140","start":140,"end":143,"surface":"餘樊君","kind":"person","person_id":"cbr-p000661","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p005","chapter_id":"c-shiji-007-xiangyu"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-007-xiangyu:p005","text":"當是時，秦嘉已立景駒為楚王，軍彭城東，欲距項梁。項梁謂軍吏曰：「陳王先首事，戰不利，未聞所在。今秦嘉倍陳王而立景駒，逆無道。」乃進兵擊秦嘉。秦嘉軍敗走，追之至胡陵。嘉還戰一日，嘉死，軍降。景駒走死梁地。項梁已幷秦嘉軍，軍胡陵，將引軍而西。章邯軍至栗，項梁使別將朱雞石、餘樊君與戰。餘樊君死。朱雞石軍敗，亡走胡陵。項梁乃引兵入薛，誅雞石。項梁前使項羽別攻襄城，襄城堅守不下。已拔，皆阬之。還報項梁。項梁聞陳王定死，召諸別將會薛計事。此時沛公亦起沛，往焉。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-007-xiangyu:m005-0004","start":4,"end":6,"surface":"秦嘉","kind":"person","person_id":"cbr-p000658","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m005-0008","start":8,"end":10,"surface":"景駒","kind":"person","person_id":"cbr-p000659","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m005-0021","start":21