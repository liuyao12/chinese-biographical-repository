,2255,2256,2257,2258,2259,2260,2261,2262,2263,2264,2265,2266,2267,2268,2269,2270,2271,2272,2273,2274,2275,2276,2277,2278,2279,2280,2281,2282,2283,2284,2285,2286,2287,2288,2289,2290,2291,2292,2293,2294,2295,2296,2297,2298,2299,2300,2301],"revision_id":2087360},"mentions":[{"id":"c-liangshu-043-jiangziyi:p003:m0001","start":1,"end":3,"surface":"侯景","kind":"person","person_id":"5d1_8jg_amy","status":"contextual_provisional"},{"id":"c-liangshu-043-jiangziyi:p003:m0016","start":16,"end":18,"surface":"子一","kind":"person","person_id":"z8m_9y0_s2w_*****AA","status":"contextual_provisional"},{"id":"c-liangshu-043-jiangziyi:p003:m0034","start":34,"end":37,"surface":"董桃生","kind":"person","person_id":"2xt_gzg_xmn","status":"contextual_provisional"},{"id":"c-liangshu-043-jiangziyi:p003:m0049","start":49,"end":51,"surface":"子一","kind":"person","person_id":"z8m_9y0_s2w_*****AA","status":"contextual_provisional"},{"id":"c-liangshu-043-jiangziyi:p003:m0073","start":73,"end":75,"surface":"子一","kind":"person","person_id":"z8m_9y0_s2w_*****AA","status":"contextual_provisional"},{"id":"c-liangshu-043-jiangziyi:p003:m0107","start":107,"end":109,"surface":"子四","kind":"person","person_id":"z8m_9y0_s2w_*****AB","status":"contextual_provisional"},{"id":"c-liangshu-043-jiangziyi:p003:m0110","start":110,"end":112,"surface":"子五","kind":"person","person_id":"z8m_9y0_s2w_*****AC","status":"contextual_provisional"},{"id":"c-liangshu-043-jiangziyi:p003:m0129","start":129,"end":131,"surface":"子一","kind":"person","person_id":"z8m_9y0_s2w_*****AA","status":"contextual_provisional"}],"chapter_id":"c-liangshu-043-jiangziyi","book_id":"b-liangshu-043","work_id":"w-liangshu","source_id":"s-liangshu-043-jiangziyi-ws2087360"},{"id":"c-liangshu-043-jiangziyi:p004","text":"詔曰：「故戎昭將軍、通直散騎侍郎、南津校尉江子一，前尚書右丞江子四，東宮直殿主帥子五，禍故有聞，良以矜惻，死事加等，抑惟舊章。可贈子一給事黃門侍郎，子四中書侍郎，子五散騎侍郎。」侯景平，世祖又追贈子一侍中，諡義子；子四黃門侍郎，諡毅子；子五中書侍郎，諡烈子。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":28,"last_line"