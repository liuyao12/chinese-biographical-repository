al_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-051-huan:line027:m0055","start":55,"end":57,"surface":"閭舉","kind":"person","person_id":"vqw_kae_8k5","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-051-huan:line027","chapter_id":"c-sanguozhi-051-huan"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-051-huan:line027","text":"　　孫奐字季明。兄皎既卒，代統其眾，以揚武中郎將領江夏太守。在事一年，遵皎舊跡，禮劉靖、李允、吳碩、張梁及江夏閭舉等，並納其善。奐訥於造次而敏於當宮，軍民稱之。黃武五年，權攻石陽，奐以地主，使所部將軍鮮于丹帥五千人先斷淮道。自帥吳碩、張梁五千人為軍前鋒，降高城，得三將。大軍引還，權詔使在前住，駕過其軍，見奐軍陳整齊，權歎曰：「初吾憂其遲鈍，今治軍，諸將少能及者，吾無憂矣。」拜揚威將軍，封沙羨侯。吳碩、張梁皆裨將軍，賜爵關內侯。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-051-huan:line027:m0002","start":2,"end":4,"surface":"孫奐","kind":"person","person_id":"y4x_cmp_976_C","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-huan:line027:m0005","start":5,"end":7,"surface":"季明","kind":"person","person_id":"y4x_cmp_976_C","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-huan:line027:m0009","start":9,"end":10,"surface":"皎","kind":"person","person_id":"y4x_cmp_976_B","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-huan:line027:m0036","start":36,"end":37,"surface":"皎","kind":"person","person_id":"y4x_cmp_976_B","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-huan:line027:m0041","start":41,"end":43,"surface":"劉靖","kind":"person","person_id":"qfh_ozo_ufz","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-huan:line027:m0044","start":44,"end":46,"surface":"李允","kind":"person