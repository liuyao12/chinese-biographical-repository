ue:m009-0275","start":275,"end":278,"surface":"漢使者","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-113-nanyue:m009-0282","start":282,"end":286,"surface":"蒼梧秦王","kind":"person","person_id":"8m2_avf_zfe","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m009-0293","start":293,"end":295,"surface":"明王","kind":"person","person_id":"f4l_jyl_oqv","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m009-0297","start":297,"end":299,"surface":"越妻","kind":"person","person_id":"97h_5h5_tks","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m009-0303","start":303,"end":305,"surface":"建德","kind":"person","person_id":"f4l_jyl_oqv_C","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m009-0309","start":309,"end":312,"surface":"韓千秋","kind":"person","person_id":"8xz_mlj_r3c","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m009-0341","start":341,"end":343,"surface":"千秋","kind":"person","person_id":"8xz_mlj_r3c","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m009-0353","start":353,"end":356,"surface":"漢使者","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-113-nanyue:m009-0377","start":377,"end":379,"surface":"天子","kind":"person","person_id":"g0x_vmx_2lg","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m009-0382","start":382,"end":385,"surface":"韓千秋","kind":"person","person_id":"8xz_mlj_r3c","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m009-0400","start":400,"end":402,"surface":"延年","kind":"person","person_id":"8xz_mlj_r3c_A","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m009-0407","start":407,"end":409,"surface":"樛樂","kind":"person","person_id":"tz9_dhl_ifo","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m009-0413","start":413,"end":416,"surface":"王太后","kind":"person","person_id":"3q4_zsp_jwy","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m009-0425","start":425,"end":427,"surface":"廣德","kind":"person","person_id":"tz9_dhl_ifo_A","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m009-0438","start":438,"end":440,"surface":"天子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-113-nanyue:m009-0454","start":454,"end":456,"surface":"呂嘉","kind":"person","person_id":"jfm_184_2yb","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m009-0457","start":457,"end":459,"surface":"建德","kind":"person","person_id":"f4l_jyl_oqv_C","status":"contextual_provisional"}],"chapter_id":"c-shiji-113-nanyue","book_id":"b-shiji-113","work_id":"w-shiji","source_id":"s-shiji113-nanyue"},{"id":"c-shiji-113-nanyue:p011","text":"元鼎六年冬，樓船將軍將精卒先陷尋陜，破石門，得越船粟，因推而前，挫越鋒，以數萬人待伏波。伏波將軍將罪人，道遠，會期後，與樓船會乃有千餘人，遂俱進。樓船居前，至番禺。建德、嘉皆城守。樓船自擇便處，居東南面；伏波居西北面。會暮，樓船攻敗越人，縱火燒城。越素聞伏波名，日暮，不知其兵多少。伏波乃為營，遣使者招降者，賜印，復縱令相招。樓船力攻燒敵，反驅而入伏波營中。犁旦，城中皆降伏波。呂嘉、建德已夜與其屬數百人亡入海，以船西去。伏波又因問所得降者貴人，以知呂嘉所之，遣人追之。以其故校尉司馬蘇弘得建德，封為海常侯；越郎都稽得嘉，封為臨蔡侯。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-113-nanyue:m011-0006","start":6,"end":10,"surface":"樓船將軍","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0041","start":41,"end":43,"surface":"伏波","kind":"person","person_id":"vib_10x_51n","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0044","start":44,"end":48,"surface":"伏波將軍","kind":"person","person_id":"vib_10x_51n","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0060","start":60,"end":62,"surface":"樓船","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0073","start":73,"end":75,"surface":"樓船","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0082","start":82,"end":84,"surface":"建德","kind":"person","person_id":"f4l_jyl_oqv_C","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0085","start":85,"end":86,"surface":"嘉","kind":"person","person_id":"jfm_184_2yb","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0090","start":90,"end":92,"surface":"樓船","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0102","start":102,"end":104,"surface":"伏波","kind":"person","person_id":"vib_10x_51n","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0112","start":112,"end":114,"surface":"樓船","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0127","start":127,"end":129,"surface":"伏波","kind":"person","person_id":"vib_10x_51n","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0141","start":141,"end":143,"surface":"伏波","kind":"person","person_id":"vib_10x_51n","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0163","start":163,"end":165,"surface":"樓船","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0174","start":174,"end":176,"surface":"伏波","kind":"person","person_id":"vib_10x_51n","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0186","start":186,"end":188,"surface":"伏波","kind":"person","person_id":"vib_10x_51n","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0189","start":189,"end":191,"surface":"呂嘉","kind":"person","person_id":"jfm_184_2yb","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0192","start":192,"end":194,"surface":"建德","kind":"person","person_id":"f4l_jyl_oqv_C","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0211","start":211,"end":213,"surface":"伏波","kind":"person","person_id":"vib_10x_51n","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0225","start":225,"end":227,"surface":"呂嘉","kind":"person","person_id":"jfm_184_2yb","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0242","start":242,"end":244,"surface":"蘇弘","kind":"person","person_id":"m08_4xt_opo","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0245","start":245,"end":247,"surface":"建德","kind":"person","person_id":"f4l_jyl_oqv_C","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0256","start":256,"end":258,"surface":"都稽","kind":"person","person_id":"6m0_ze7_hl0","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0259","start":259,"end":260,"surface":"嘉","kind":"person","person_id":"jfm_184_2yb","status":"contextual_provisional"}],"chapter_id":"c-shiji-113-nanyue","book_id":"b-shiji-113","work_id":"w-shiji","source_id":"s-shiji113-nanyue"},{"id":"c-shiji-113-nanyue:p013","text":"尉佗之王，本由任囂。遭漢初定，列為諸侯。隆慮離溼疫，佗得以益驕。甌駱相攻，南越動搖。漢兵臨境，嬰齊入朝。其後亡國，徵自樛女；呂嘉小忠，令佗無後。樓船從欲，怠傲失惑；伏波困窮，智慮愈殖，因禍為福。成敗之轉，譬若糾墨。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-113-nanyue:m013-0000","start":0,"end":2,"surface":"尉佗","kind":"person","person_id":"bvb_d1z_fd0","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m013-0007","start":7,"end":9,"surface":"任囂","kind":"person","person_id":"e8q_4ar_5bh","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m013-0020","start":20,"end":22,"surface":"隆慮","kind":"person","person_id":"cnz_t0f_oaz","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m013-0026","start":26,"end":27,"surface":"佗","kind":"person","person_id":"bvb_d1z_fd0","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m013-0047","start":47,"end":49,"surface":"嬰齊","kind":"person","person_id":"f4l_jyl_oqv","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m013-0059","start":59,"end":61,"surface":"樛女","kind":"person","person_id":"3q4_zsp_jwy","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m013-0062","start":62,"end":64,"surface":"呂嘉","kind":"person","person_id":"jfm_184_2yb","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m013-0068","start":68,"end":69,"surface":"佗","kind":"person","person_id":"bvb_d1z_fd0","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m013-0072","start":72,"end":74,"surface":"樓船","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m013-0082","start":82,"end":84,"surface":"伏波","kind":"person","person_id":"vib_10x_51n","status":"contextual_provisional"}],"chapter_id":"c-shiji-113-nanyue","book_id":"b-shiji-113","work_id":"w-shiji","source_id":"s-shiji113-nanyue"},{"id":"c-shiji-113-nanyue:p014","text":"中原鹿走，群雄莫制。漢事西驅，越權南裔。陸賈騁說，尉他去帝。嫪後內朝，呂嘉狼戾。君臣不協，卒從剿棄。","annotation_status":"in_progress","text_layer":"witness_appended_suoyin_zan","mentions":[{"id":"c-shiji-113-nanyue:m014-0020","start":20,"end":22,"surface":"陸賈","kind":"person","person_id":"fpv_2sb_uay","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m014-0025","start":25,"end":27,"surface":"尉他","kind":"person","person_id":"bvb_d1z_fd0","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m014-0030","start":30,"end":32,"surface":"嫪後","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-113-nanyue:m014-0035","start":35,"end":37,"surface":"呂嘉","kind":"person","person_id":"jfm_184_2yb","status":"contextual_provisional"}],"chapter_id":"c-shiji-113-nanyue","book_id":"b-shiji-113","work_id":"w-shiji","source_id":"s-shiji113-nanyue"},{"id":"c-shiji-114-dongyue:p006","text":"至元鼎五年，南越反，東越王餘善上書，請以卒八千人從樓船將軍擊呂嘉等。兵至揭揚，以海風波為解，不行，持兩端，陰使南越。及漢破番禺，不至。是時樓船將軍楊仆使使上書，願便引兵擊東越。上曰士卒勞倦，不許，罷兵，令諸校屯豫章梅領待命。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-114-dongyue:m006-0013","start":13,"end":15,"surface":"餘善","kind":"person","person_id":"ub3_zen_skw","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m006-0025","start":25,"end":29,"surface":"樓船將軍","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m006-0030","start":30,"end":32,"surface":"呂嘉","kind":"person","person_id":"jfm_184_2yb","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m006-0069"