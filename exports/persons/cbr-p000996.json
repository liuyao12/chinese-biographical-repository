wed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-012-wudi:m021-0228","start":228,"end":230,"surface":"申功","kind":"person","person_id":"6jz_eg8_plz","status":"contextual_provisional","paragraph_id":"c-shiji-012-wudi:p021","chapter_id":"c-shiji-012-wudi"},{"id":"c-shiji-012-wudi:m021-0231","start":231,"end":233,"surface":"申功","kind":"person","person_id":"6jz_eg8_plz","status":"contextual_provisional","paragraph_id":"c-shiji-012-wudi:p021","chapter_id":"c-shiji-012-wudi"},{"id":"c-shiji-012-wudi:m021-0241","start":241,"end":243,"surface":"申功","kind":"person","person_id":"6jz_eg8_plz","status":"contextual_provisional","paragraph_id":"c-shiji-012-wudi:p021","chapter_id":"c-shiji-012-wudi"},{"id":"c-shiji-012-wudi:m021-0252","start":252,"end":254,"surface":"申功","kind":"person","person_id":"6jz_eg8_plz","status":"contextual_provisional","paragraph_id":"c-shiji-012-wudi:p021","chapter_id":"c-shiji-012-wudi"},{"id":"c-shiji-012-wudi:m021-0332","start":332,"end":334,"surface":"申功","kind":"person","person_id":"6jz_eg8_plz","status":"contextual_provisional","paragraph_id":"c-shiji-012-wudi:p021","chapter_id":"c-shiji-012-wudi"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-012-wudi:p021","text":"其秋，上幸雍，且郊。或曰「五帝，泰一之佐也。宜立泰一而上親郊之」。上疑未定。齊人公孫卿曰：「今年得寶鼎，其冬辛巳朔旦冬至，與黃帝時等。」卿有札書曰：「黃帝得寶鼎宛（侯）［朐］，問於鬼臾區。區對曰：『（黃）帝得寶鼎神筴，是歲己酉朔旦冬至，得天之紀，終而復始。』於是黃帝迎日推筴，後率二十歲得朔旦冬至，凡二十推，三百八十年。黃帝僊登于天。」卿因所忠欲奏之。所忠視其書不經，疑其妄書，謝曰：「寶鼎事已決矣，尚何以為！」卿因嬖人奏之。上大說，召問卿。對曰：「受此書申功，申功已死。」上曰：「申功何人也？」卿曰：「申功，齊人也。與安期生通，受黃帝言，無書，獨有此鼎書。曰『漢興復當黃帝之時。漢之聖者在高祖之孫且曾孫也。寶鼎出而與神通，封禪。封禪七十二王，唯黃帝得上泰山封』。申功曰：『漢主亦當上封，上封則能僊登天矣。黃帝時萬諸侯，而神靈之封居七千。天下名山八，而三在蠻夷，五在中國。中國華山、首山、太室、泰山、東萊，此五山黃帝之所常遊，與神會。黃帝且戰且學僊。患百姓非其道，乃斷斬非鬼神者。百餘歲然後得與神通。黃帝郊雍上帝，宿三月。鬼臾區號大鴻，死葬雍，故鴻冢是也。其後於黃帝接萬靈明廷。明廷者，甘泉也。所謂寒門者，谷口也。黃帝采首山銅，鑄鼎荊山下。鼎既成，有龍垂胡髯下迎黃帝。黃帝上騎，群臣後宮從上龍七十餘人，乃上去。餘小臣不得上，乃悉持龍髯，龍髯拔，墮黃帝之弓。百姓仰望黃帝既上天，乃抱其弓與龍胡髯號。故後世因名其處曰鼎湖，其弓曰烏號。』」於是天子曰：「嗟乎！吾誠得如黃帝，吾視去妻子如脫屣耳。」乃拜卿為郎，東使候神於太室。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-012-wudi:m021-0013","start":13,"end":15,"surface":"五帝","kind":"unresolved","person_id":null,"status":"unresolved","note":"神祇、群體、匿名者或未定指代，保留來源，不補未見姓名與成員。"},{"id":"c-shiji-012-wudi:m021-0016","start":16,"end":18,"surface":"泰一","kind":"unresolved","person_id":null,"status":"unresolved","note":"神祇、群體、匿名者或未定指代，保留來源，不補未見姓名與成員。"},{"id":"c-shiji-012-wudi:m021-0024","start":24,"end":26,"surface":"泰一","kind":"unresolved","person_id":null,"status":"unresolved","note":"神祇、群體、匿名者或未定指代，保留來源，不補未見姓名與成員。"},{"id":"c-shiji-012-wudi:m021-0040","start":40,"end":43,"surface":"公孫卿","kind":"person","person_id":"lgo_cwi_085","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m021-0062","start":62,"end":64,"surface":"黃帝","kind":"person","person_id":"8jz_o3s_obt","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m021-0068","start":68,"end":69,"surface":"卿","kind":"person","person_id":"lgo_cwi_085","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m021-0075","start":75,"end":77,"surface":"黃帝","kind":"person","person_id":"8jz_o3s_obt","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m021-0090","start":90,"end":93,"surface":"鬼臾區","kind":"person","person_id":"jdu_syy_7s5","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m021-0094","start":94,"end":95,"surface":"區","kind":"person","person_id":"jdu_syy_7s5","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m021-0131","start":131,"end":133,"surface":"黃帝","kind":"person","person_id":"8jz_o3s_obt","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m021-0160","start":160,"end":162,"surface":"黃帝","kind":"person","person_id":"8jz_o3s_obt","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m021-0168","start":168,"end":169,"surface":"卿","kind":"person","person_id":"lgo_cwi_085",