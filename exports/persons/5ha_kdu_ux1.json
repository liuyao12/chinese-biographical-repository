d":"person","person_id":"93v_ypp_gkw","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m024-0100","start":100,"end":102,"surface":"田信","kind":"person","person_id":"chz_6r7_teu","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m024-0103","start":103,"end":104,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m024-0105","start":105,"end":106,"surface":"湯","kind":"person","person_id":"1ex_se1_yef_A","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m024-0111","start":111,"end":113,"surface":"安世","kind":"person","person_id":"1ex_se1_yef_AA","status":"contextual_provisional"}],"chapter_id":"c-shiji-122-kuli","book_id":"b-shiji-122","work_id":"w-shiji","source_id":"s-shiji122-kuli"}],"sources":[{"chapter_id":"c-hanshu-059-zhangtang","work_id":"w-hanshu","book_id":"b-hanshu-059","source_id":"s-hanshu-059-zhangtang","source":{"title":"前漢書卷五十九（文淵閣四庫本數位轉錄）","provider":"Kanripo","url":"https://github.com/kanripo/KR2a0007/blob/683113d4baf6febecaf2ccb7913df87c4d68d454/KR2a0007_059.txt","permalink":"https://github.com/kanripo/KR2a0007/blob/683113d4baf6febecaf2ccb7913df87c4d68d454/KR2a0007_059.txt","revision_id":"683113d4baf6febecaf2ccb7913df87c4d68d454","source_commit":"683113d4baf6febecaf2ccb7913df87c4d68d454","source_blob_sha":"a57e021de28732b2cb6ceeb88520f179a5e54e70","response_sha256":"c804bcdd7481b8646e4025f17f8f4e90a2c7e644a8348a955b3ff0d19a2d71fd","accessed_on":"2026-10-18","edition":"WYG（文淵閣四庫全書）","extent":"只錄張湯父親、早期任官、死後母子及張安世昭宣任職四處選錄，非全卷完成。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代正文及古注；保留Kanripo數位轉錄與固定文淵閣見證來源歸屬。","license_url":"https://www.kanripo.org/","response_extent":{"first_line":1,"last_line":349,"partial_file":false},"normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"正文不補標點、不轉字；分離圓括號古注、頁標與版面空白，按唯一首尾原字選取。完整取得數位檔並驗blob，僅核本四段，不宣稱全卷已讀或已校書影。","excerpts":[{"proposed_paragraph_id":"c-hanshu-059-zhangtang:zhangtang:p-intro-001","source_lines":[13,22],"raw_quote":"張湯杜陵人也父為長安丞出湯為兒守舍(師古曰稱/為兒者言)¶\n(其尚幼/少也)還䑕盗肉父怒笞湯湯掘熏得䑕及餘肉劾䑕¶\n掠治傳爰書訊鞫論報(師古曰傳謂傳逮若今之追逮/赴對也爰換也以文書代換其)¶\n<pb:KR2a0007_WYG_059-1b>¶\n(口辭也訊考問也鞫窮也謂窮覈之/也論報謂上論之而獲報也訊音信)并取䑕與肉具獄¶\n磔堂下(師古曰具為治獄之文處正其罪而磔䑕也○/宋祁曰顔觧具獄似失其意直謂成按耳于定)¶\n(國杜緩兩傳已/觧緩延年之子)父見之視文辭如老獄吏大驚遂使書¶\n獄(如淳曰決獄之書謂律令也○劉奉世曰傳非逮也/若傳逮則不當先言掠治矣傳者傳囚辭也爰書者)¶\n(盖趙髙作爰歴教學𨽻書時獄吏書體盖用此故從俗/呼為爰書也以此父使之書獄謂案牘耳非律令也)¶\n父死後湯為長安吏周陽侯為諸卿時(師古曰/姓趙)嘗繫長¶","raw_quote_sha256":"f6cb327b4dda48184f86b2ff075d539fa715b3f3cc2670cca8fd3dc36ce6d60d","body_before_excerpt_selection":"張湯杜陵人也父為長安丞出湯為兒守舍還䑕盗肉父怒笞湯湯掘熏得䑕及餘肉劾䑕掠治傳爰書訊鞫論報并取䑕與肉具獄磔堂下父見之視文辭如老獄吏大驚遂使書獄父死後湯為長安吏周陽侯為諸卿時嘗繫長","body_selection":{"start":0,"end":78,"begin_anchor":"張湯杜陵人也","end_anchor":"父死後湯為長安吏"},"commentary":[{"raw_quote":"(師古曰稱/為兒者言)","body_offset":17,"raw_start":17,"raw_end":28,"excerpt_body_offset":17},{"raw_quote":"(其尚幼/少也)","body_offset":17,"raw_start":30,"raw_end":38,"excerpt_body_offset":17},{"raw_quote":"(師古曰傳謂傳逮若今之追逮/赴對也爰換也以文書代換其)","body_offset":44,"raw_start":67,"raw_end":94,"excerpt_body_offset":44},{"raw_quote":"(口辭也訊考問也鞫窮也謂窮覈之/也論報謂上論之而獲報也訊音信)","body_offset":44,"raw_start":122,"raw_end":153,"excerpt_body_offset":44},{"raw_quote":"(師古曰具為治獄之文處正其罪而磔䑕也○/宋祁曰顔觧具獄似失其意直謂成按耳于定)","body_offset":54,"raw_start":165,"raw_end":204,"excerpt_body_offset":54},{"raw_quote":"(國杜緩兩傳已/觧緩延年之子)","body_offset":54,"raw_start":206,"raw_end":221,"excerpt_body_offset":54},{"raw_quote":"(如淳曰決獄之書謂律令也○劉奉世曰傳非逮也/若傳逮則不當先言掠治矣傳者傳囚辭也爰書者)","body_offset":70,"raw_start":239,"raw_end":282,"excerpt_body_offset":70},{"raw_quote":"(盖趙髙作爰歴教學𨽻書時獄吏書體盖用此故從俗/呼為爰書也以此父使之書獄謂案牘耳非律令也)","body_offset":70,"raw_start":284,"raw_end":328,"excerpt_body_offset":70}],"page_markers":[{"raw_quote":"<pb:KR2a0007_WYG_059-1b>","body_offset":44,"raw_offset":96}]},{"proposed_paragraph_id":"c-hanshu-059-zhangtang:zhangtang:p-office-001","source_lines":[22,32],"raw_quote":"父死後湯為長安吏周陽侯為諸卿時(師古曰/姓趙)嘗繫長¶\n安湯傾身事之及出為侯大與湯交徧見貴人湯給事¶\n内史為寗成掾以湯為無害言大府(師古曰大府丞相/府也無害言其最)¶\n<pb:KR2a0007_WYG_059-2a>¶\n(勝也觧在/蕭何傳)調茂陵尉(師古曰調選也選以為/此官也調音徒釣反)治方中(孟/康)¶\n(曰方中陵上土作方也湯主治之蘓林曰天子即位豫/作陵諱之故言方中或言斥土如淳曰漢注陵方中用)¶\n(地一頃深十二丈師古曰蘓說非也古謂掘地為阬曰/方今荆楚俗土功築作筭程課者猶以方計之非謂避)¶\n(諱/也)武安侯為丞相(師古曰/田蚡)徴湯為史薦補侍御史治陳¶\n皇后巫蠱獄深竟黨與上以為能遷太中大夫與趙禹¶\n共定諸律令務在深文拘守職之吏(蘓林曰拘刻/於守職之吏)已而¶\n禹至少府湯為廷尉兩人交驩兄事禹(師古曰事/之如兄)禹志¶","raw_quote_sha256":"e61793acd23771fc5b994b65b6c91921251352f9a948a0c6ccd9089025aabf2b","body_before_excerpt_selection":"父死後湯為長安吏周陽侯為諸卿時嘗繫長安湯傾身事之及出為侯大與湯交徧見貴人湯給事内史為寗成掾以湯為無害言大府調茂陵尉治方中武安侯為丞相徴湯為史薦補侍御史治陳皇后巫蠱獄深竟黨與上以為能遷太中大夫與趙禹共定諸律令務在深文拘守職之吏已而禹至少府湯為廷尉兩人交驩兄事禹禹志","body_selection":{"start":8,"end":129,"begin_anchor":"周陽侯為諸卿時","end_anchor":"兄事禹"},"commentary":[{"raw_quote":"(師古曰/姓趙)","body_offset":15,"raw_start":15,"raw_end":23,"excerpt_body_offset":7},{"raw_quote":"(師古曰大府丞相/府也無害言其最)","body_offset":53,"raw_start":65,"raw_end":82,"excerpt_body_offset":45},{"raw_quote":"(勝也觧在/蕭何傳)","body_offset":53,"raw_start":110,"raw_end":120,"excerpt_body_offset":45},{"raw_quote":"(師古曰調選也選以為/此官也調音徒釣反)","body_offset":57,"raw_start":124,"raw_end":144,"excerpt_body_offset":49},{"raw_quote":"(孟/康)","body_offset":60,"raw_start":147,"raw_end":152,"excerpt_body_offset":52},{"raw_quote":"(曰方中陵上土作方也湯主治之蘓林曰天子即位豫/作陵諱之故言方中或言斥土如淳曰漢注陵方中用)","body_offset":60,"raw_start":154,"raw_end":199,"excerpt_body_offset":52},{"raw_quote":"(地一頃深十二丈師古曰蘓說非也古謂掘地為阬曰/方今荆楚俗土功築作筭程課者猶以方計之非謂避)","body_offset":60,"raw_start":201,"raw_end":246,"excerpt_body_offset":52},{"raw_quote":"(諱/也)","body_offset":60,"raw_start":248,"raw_end":253,"excerpt_body_offset":52},{"raw_quote":"(師古曰/田蚡)","body_offset":66,"raw_start":259,"raw_end":267,"excerpt_body_offset":58},{"raw_quote":"(蘓林曰拘刻/於守職之吏)","body_offset":112,"raw_start":317,"raw_end":330,"excerpt_body_offset":104},{"raw_quote":"(師古曰事/之如兄)","body_offset":129,"raw_start":349,"raw_end":359,"excerpt_body_offset":121}],"page_markers":[{"raw_quote":"<pb:KR2a0007_WYG_059-2a>","body_offset":53,"raw_offset":84}]},{"proposed_paragraph_id":"c-hanshu-059-zhangtang:zhangtang:p-death-001","source_lines":[148,156],"raw_quote":"(師古曰言/何用多對)湯廼為書謝曰湯無尺寸之功起刀筆吏陛¶\n下幸致三公(○宋祁曰越本/作致位三公)無以塞責(師古曰/塞當也)然謀陷¶\n湯者三長史也遂自殺湯死家産直不過五百金皆所¶\n<pb:KR2a0007_WYG_059-9a>¶\n得奉賜(師古曰奉/音扶用反)無它贏(師古曰/贏餘也)昆弟諸子欲厚葬湯¶\n湯母曰湯為天子大臣被惡言而死(師古曰被加/也音皮義反)何厚¶\n葬為載以牛車有棺而無槨上聞之曰非此母不生此¶\n子乃盡按誅三長史丞相青翟自殺出田信上惜湯復¶\n稍進其子安世¶","raw_quote_sha256":"b521e147869b183af435ddc5648391b36f423ecf93e03919c663e248a7f59570","body_before_excerpt_selection":"湯廼為書謝曰湯無尺寸之功起刀筆吏陛下幸致三公無以塞責然謀陷湯者三長史也遂自殺湯死家産直不過五百金皆所得奉賜無它贏昆弟諸子欲厚葬湯湯母曰湯為天子大臣被惡言而死何厚葬為載以牛車有棺而無槨上聞之曰非此母不生此子乃盡按誅三長史丞相青翟自殺出田信上惜湯復稍進其子安世","body_selection":{"start":0,"end":128,"begin_anchor":"湯廼為書謝曰","end_anchor":"稍進其子安世"},"commentary":[{"raw_quote":"(師古曰言/何用多對)","body_offset":0,"raw_start":0,"raw_end":11,"excerpt_body_offset":0},{"raw_quote":"(○宋祁曰越本/作致位三公)","body_offset":22,"raw_start":35,"raw_end":49,"excerpt_body_offset":22},{"raw_quote":"(師古曰/塞當也)","body_offset":26,"raw_start":53,"raw_end":62,"excerpt_body_offset":26},{"raw_quote":"(師古曰奉/音扶用反)","body_offset":53,"raw_start":119,"raw_end":130,"excerpt_body_offset":53},{"raw_quote":"(師古曰/贏餘也)","body_offset":56,"raw_start":133,"raw_end":142,"excerpt_body_offset":56},{"raw_quote":"(師古曰被加/也音皮義反)","body_offset":78,"raw_start":166,"raw_end":179,"excerpt_body_offset":78}],"page_markers":[{"raw_quote":"<pb:KR2a0007_WYG_059-9a>","body_offset":50,"raw_offset":90}]},{"proposed_paragraph_id":"c-hanshu-059-zhangtang:zhanganshi:p-intro-001","source_lines":[157,174],"raw_quote":"安世字子孺少以父任為郎用善書給事尚書(師古曰/於尚書)¶\n(中給事也/給供也)精力於職休沐未嘗出上行幸河東嘗亡書¶\n三篋詔問莫能知惟安世識之(師古曰識記/也音式志反)具作其事¶\n<pb:KR2a0007_WYG_059-9b>¶\n後購求得書以相校無所遺失上竒其材擢為尚書令¶\n遷光禄大夫昭帝即位大將軍霍光秉政以安世篤行¶\n(師古曰/篤厚也)光親重之㑹左將軍上官桀父子及御史大夫¶\n桑𢎞羊皆與燕王蓋主謀反誅光以朝無舊臣白用安¶\n世為右將軍光禄勲以自副焉久之天子下詔曰右將¶\n軍光禄勲安世輔政宿衛肅敬不怠十有三年咸以康¶\n寜夫親親任賢唐虞之道也其封安世為富平侯明年¶\n昭帝崩未葬大將軍光白太后徙安世為車騎將軍與¶\n<pb:KR2a0007_WYG_059-10a>¶\n共徴立昌邑王王行滛亂光復與安世謀廢王尊立宣¶\n帝帝初即位襃賞大臣下詔曰夫襃有徳賞有功古今¶\n之通義也車騎將軍光禄勲富平侯安世宿衛忠正宣¶\n徳明恩勤勞國家守職秉義以安宗廟其益封萬六百¶\n戸功次大將軍光安世子千秋延夀彭祖皆中郎将侍¶","raw_quote_sha256":"b8c3e3e2bfa787fd5ef31e9a8204aed12ac8dd3302120e48c7b5f5d7c0e026e0","body_before_excerpt_selection":"安世字子孺少以父任為郎用善書給事尚書精力於職休沐未嘗出上行幸河東嘗亡書三篋詔問莫能知惟安世識之具作其事後購求得書以相校無所遺失上竒其材擢為尚書令遷光禄大夫昭帝即位大將軍霍光秉政以安世篤行光親重之㑹左將軍上官桀父子及御史大夫桑𢎞羊皆與燕王蓋主謀反誅光以朝無舊臣白用安世為右將軍光禄勲以自副焉久之天子下詔曰右將軍光禄勲安世輔政宿衛肅敬不怠十有三年咸以康寜夫親親任賢唐虞之道也其封安世為富平侯明年昭帝崩未葬大將軍光白太后徙安世為車騎將軍與共徴立昌邑王王行滛亂光復與安世謀廢王尊立宣帝帝初即位襃賞大臣下詔曰夫襃有徳賞有功古今之通義也車騎將軍光禄勲富平侯安世宿衛忠正宣徳明恩勤勞國家守職秉義以安宗廟其益封萬六百戸功次大將軍光安世子千秋延夀彭祖皆中郎将侍","body_selection":{"start":0,"end":307,"begin_anchor":"安世字子孺","end_anchor":"戸功次大將軍光"},"commentary":[{"raw_quote":"(師古曰/於尚書)","body_offset":18,"raw_start":18,"raw_end":27,"excerpt_body_offset":18},{"raw_quote":"(中給事也/給供也)","body_offset":18,"raw_start":29,"raw_end":39,"excerpt_body_offset":18},{"raw_quote":"(師古曰識記/也音式志反)","body_offset":47,"raw_start":70,"raw_end":83,"excerpt_body_offset":47},{"raw_quote":"(師古曰/篤厚也)","body_offset":93,"raw_start":161,"raw_end":170,"excerpt_body_offset":93}],"page_markers":[{"raw_quote":"<pb:KR2a0007_WYG_059-9b>","body_offset":51,"raw_offset":89},{"raw_quote":"<pb:KR2a0007_WYG_059-10a>","body_offset":216,"raw_offset":305}]}]}}},{"chapter_id":"c-shiji-122-kuli","work_id":"w-shiji","book_id":"b-shiji-122","source_id":"s-shiji122-kuli","source":{"title":"史記／卷122","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷122","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷122&oldid=7904124","revision_id":7904124,"accessed_on":"2026-10-11","extent":"固定修訂全文44段，包括末段索隱述贊。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"去header2及現代節標、字形控制外殼而保留其中原字與異文；未核影像。","note":"末段索隱述贊分層，太史公論贊屬篇文。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true}}
