tion_note":"本篇明示父子共根，未名父親保持未名，分支字母不表示長幼；出生母親另存來源關係。","reviewer":"Codex（AI 代理）"}},{"id":"5ha_kdu_ux1","label":"張湯母（未名）（酷吏列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"湯母","mention_ids":["c-shiji-122-kuli:m024-0031"]}],"evidence":[{"mention_id":"c-shiji-122-kuli:m024-0031","chapter_id":"c-shiji-122-kuli","paragraph_id":"c-shiji-122-kuli:p024","quote":"湯母"}]}],"source_mention_summary":[{"source_id":"s-shiji122-kuli","work_id":"w-shiji","book_id":"b-shiji-122","chapter_id":"c-shiji-122-kuli","mention_count":1,"mention_ids":["c-shiji-122-kuli:m024-0031"],"paragraph_ids":["c-shiji-122-kuli:p024"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji122-kuli"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji122-003","subject_person_id":"1ex_se1_yef_A","predicate":"mother","object_person_id":"5ha_kdu_ux1","status":"source_attested","evidence":[{"chapter_id":"c-shiji-122-kuli","source_id":"s-shiji122-kuli","paragraph_id":"c-shiji-122-kuli:p024","quote":"湯死，家産直不過五百金，皆所得奉賜，無他業。昆弟諸子欲厚葬湯，湯母曰：「湯爲天子大臣，被汙惡言而死，何厚葬乎！」載以牛車，有棺無槨。天子聞之，曰：「非此母不能生此子。」乃盡案誅三長史。丞相靑翟自殺。出田信。上惜湯。稍遷其子安世。"}],"qualifiers":{"source_term":"湯母"},"interpretation_note":"保留明示父母子與姊稱謂；不補未名者姓名、婚姻、同母或出生排行。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-122-kuli:m024-0031","start":31,"end":33,"surface":"湯母","kind":"person","person_id":"5ha_kdu_ux1","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p024","chapter_id":"c-shiji-122-kuli"}],"relations":[{"id":"a-shiji122-003","subject_person_id":"1ex_se1_yef_A","predicate":"mother","object_person_id":"5ha_kdu