uote":"秦將章邯圍魏王咎於臨濟，急。魏王請救於齊，齊王田儋將兵救魏。章邯夜銜枚擊，大破齊、魏軍，殺田儋於臨濟下。儋弟田榮收儋餘兵東走東阿。齊人聞王田儋死，乃立故齊王建之弟田假為齊王、田角為相、田間為將，以距諸侯。"}],"attestations":[{"id":"th-shiji094-004:a001","paragraph_id":"c-shiji-094-tiandan:p003","start":5,"end":7,"surface":"魏王","person_mention_id":"c-shiji-094-tiandan:m003-0005","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"實授、自立、用稱分存；擬封蒯通安期生及拒受、田橫來大者王小者侯均不作已授。王膠東保留原稱王，不造正文未見膠東王字串；死亡被虜亡走不自動終止爵位。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji094-004","person_id":"cbr-p005216","surfaces":["魏王","魏王咎"],"scope":"same_chapter","chapter_ids":["c-shiji-094-tiandan"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-094-tiandan:p003","quote":"秦將章邯圍魏王咎於臨濟，急。魏王請救於齊，齊王田儋將兵救魏。章邯夜銜枚擊，大破齊、魏軍，殺田儋於臨濟下。儋弟田榮收儋餘兵東走東阿。齊人聞王田儋死，乃立故齊王建之弟田假為齊王、田角為相、田間為將，以距諸侯。"}],"rationale":"明示姓名與局部敘事承接，短稱及田間田閒等異字仍待覆核，不按全域同名合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-094-tiandan:p003","text":"秦將章邯圍魏王咎於臨濟，急。魏王請救於齊，齊王田儋將兵救魏。章邯夜銜枚擊，大破齊、魏軍，殺田儋於臨濟下。儋弟田榮收儋餘兵東走東阿。齊人聞王田儋死，乃立故齊王建之弟田假為齊王、田角為相、田間為將，以距諸侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-094-tiandan:m003-0002","start":2,"end":4,"surface":"章邯","kind":"person","person_id":"cbr-p005230","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0005","start":5,"end":8,"surface":"魏王咎","kind":"person","person_id":"cbr-p005216","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0014","start":14,"end":16,"surface":"魏王","kind":"person","person_id":"cbr-p005216","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0023","start":23,"end":25,"surface":"田儋","kind":"person","person_id":"cbr-p005225","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan: