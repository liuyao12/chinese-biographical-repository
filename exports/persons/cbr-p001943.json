{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p001943","canonical_person_id":"teh_acc_5xb","id_aliases":["cbr-p001943"],"identity_policy":"contextual_provisional","person_ids":["teh_acc_5xb"],"persons":[{"id":"teh_acc_5xb","label":"葉公（救楚惠王者）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"葉公","mention_ids":["c-shiji-040-chu:m055-0194"]}],"evidence":[{"mention_id":"c-shiji-040-chu:m055-0194","chapter_id":"c-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p055","quote":"葉公"}],"id_aliases":["cbr-p001943"]}],"source_mention_summary":[{"source_id":"s-shiji-040-chu","work_id":"w-shiji","book_id":"b-shiji-040","chapter_id":"c-shiji-040-chu","mention_count":1,"mention_ids":["c-shiji-040-chu:m055-0194"],"paragraph_ids":["c-shiji-040-chu:p055"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-040-chu"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-040-chu:m055-0194","start":194,"end":196,"surface":"葉公","kind":"person","person_id":"teh_acc_5xb","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p055","chapter_id":"c-shiji-040-chu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-040-chu:p055","text":"惠王二年，子西召故平王太子建之子勝於呉，以爲巣大夫，號曰白公。白公好兵而下士，欲報仇。六年，白公請兵令尹子西伐鄭。初，白公父建亡在鄭，鄭殺之，白公亡走呉，子西復召之，故以此怨鄭，欲伐之。子西許而未爲發兵。八年，晉伐鄭，鄭告急楚，楚使子西救鄭，受賂而去。白公勝怒，乃遂與勇力死士石乞等襲殺令尹子西、子綦於朝，因劫惠王，置之髙府，欲弒之。惠王從者屈固負王亡走昭王夫人宮。白公自立爲王。月餘，會葉公來救楚，楚惠王之徒與共攻白公，殺之。惠王乃復位。是歳也，滅陳而縣之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m055-0000","start":0,"end":2,"surface":"惠王","kind":"person","person_id":"q60_34y_1zh","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m055-0005","start":5,"end":7,"surface":"子西","kind":"person","person_id":"yfx_myv_qft","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m055-0009","start":9,"end":11,"surface":"平王","kind":"person","person_id":"0va_zus_2zt_AAE","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m055-0011","start":11,"end":14,"surface":"太子建","kind":"person","person_id":"gau_cq7_7g1","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m055-0016","start":16,"end":17,"surface":"勝","kind":"person","person_id":"gau_cq7_7g1_A","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m055-0028","start":28,"end":30,"surface":"白公","kind":"person","person_id":"gau_cq7_7g1_A","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m055-0031","start":31,"end":33,"surface":"白公","kind":"person","person_id":"gau_cq7_7g1_A","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m055-0046","start":46,"end":48,"surface":"白公","kind":"person","person_id":"gau_cq7_7g1_A","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m055-0052","start":52,"end":54,"surface":"子西","kind":"person","person_id":"yfx_myv_qft","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m055-0059","start":59,"end":61,"surface":"白公","kind":"person","person_id":"gau_cq7_7g1_A","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m055-0062","start":62,"end":63,"surface":"建","kind":"person","person_id":"gau_cq7_7g1","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m055-0071","start":71,"end":73,"surface":"白公","kind":"person","person_id":"gau_cq7_7g1_A","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m055-0077","start":77,"end":79,"surface":"子西","kind":"person","person_id":"yf