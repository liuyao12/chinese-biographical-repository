angshu","source_id":"s-liangshu-007-xihui-ws1566494"},{"id":"c-nanshi-012-xihui:p001","text":"武德郗皇后諱徽，高平金鄉人也。祖紹，宋國子祭酒、領東海王師。父曄，太子舍人，早卒。后母宋文帝女尋陽公主也，方娠，夢當生貴子。及后生，有赤光照室，器物盡明，家人怪之。巫言此女光高，將有所妨，乃于水濱祓除之。","mentions":[{"id":"c-nanshi-012-xihui:p001:m0006","surface":"徽","start":6,"end":7,"person_id":"4qz_j9r_edj","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-012-xihui:p001:m0016","surface":"紹","start":16,"end":17,"person_id":"jb9_h01_fds","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-012-xihui:p001:m0031","surface":"曄","start":31,"end":32,"person_id":"wch_0gk_whm","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-012-xihui:p001:m0047","surface":"尋陽公主","start":47,"end":51,"person_id":"3bh_k4m_fg4_H","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":2060595,"source_layer":"received_biography","first_line":24,"last_line":24,"line_start":0,"line_end":114,"raw_start":676,"raw_end":790,"raw_character_offsets":[676,677,678,679,682,685,686,687,688,689,690,691,692,693,694,695,696,697,698,699,700,701,702,703,704,705,706,707,708,709,710,711,712,713,714,715,716,717,718,719,720,723,726,727,728,729,730,731,732,733,734,735,736,737,738,739,740,741,742,743,744,745,746,749,752,753,754,755,756,757,758,759,760,761,762,763,764,765,766,767,768,769,770,771,772,773,774,775,776,777,778,779,780,781,782,783,784,785,786,787,788,789],"projection_sha256":"52ee822e6ed9d5187a68ffd0d2582df509ceaaa7d2a266d3ea3d5d730b521b87","editorial_excerpt_boundary":true},"chapter_id":"c-nanshi-012-xihui","book_id":"b-nanshi-012","work_id":"w-nanshi","source_id":"s-nanshi-012-xihui-ws2060595"},{"id":"c-nanshi-012-xihui:p002","text":"后幼明慧，善隸書，讀史傳。女工之事，無不閑習。宋後廢帝將納為后，齊初，安陸王緬又欲結婚，郗氏並辭以女疾，乃止。齊建元末，嬪于武帝，生永興公主玉姚、永世公主玉婉、永康公主玉嬛。及武帝為雍州刺史，殂于襄陽官舍，年三十二。其年歸葬南徐州南東海武進縣東城裏山。中興二年，武帝為梁公，齊帝詔贈后為梁公妃。及武帝踐阼，追崇為皇后，諡曰德。陵曰修陵。后父曄，贈金紫光祿大夫。","mentions":[{"id":"c-nanshi-012-xihui:p002:m0023","surface":"宋後廢帝","start":23,"end":27,"person_id":"91d_607_b0a","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-012-xihui:p002:m0038","surface":"緬","start":38,"end":39,"person_id":"98q_mll_d6v_B","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-012-xihui:p002:m0070","surface":"玉姚","start":70,"end":72,"person_id":"fo7_f8v_rmf_A","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-012-xihui:p002:m0077","surface":"玉婉","start":77,"end":79,"person_id":"fo7_f8v_rmf_B","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-012-xihui:p002:m0084","surface":"玉嬛","start":84,"end":86,"person_id":"fo7_f8v_rmf_H","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-012-xihui:p002:m0143","surface":"梁公妃","start":143,"end":146,"person_id":"4qz_j9r_edj","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-012-xihui:p002:m0170","surface":"曄","start":170,"end":171,"person_id":"wch_0gk_whm","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":2060595,"source_layer":"received_biography","first_line":26,"last_line":26,"line_start":0,"line_end":212,"raw_start":792,"raw_end":1004,"raw_character_offsets":[794,797,798,799,800,801,802,803,804,805,806,807,808,809,810,811,812,813,814,815,816,817,818,819,820,821,822,823,824,825,828,831,832,833,834,835,836,837,838,839,840,841,842,843,844,845,846,847,848,849,850,851,852,853,854,855,856,857,858,859,860,861,862,863,864,865,866,867,868,869,870,871,872,873,874,875,876,877,878,879,880,881,882,883,884,885,886,88