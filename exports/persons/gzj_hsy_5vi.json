person","person_id":"eng_0y0_ha6","status":"contextual_provisional"},{"id":"c-shiji-111-wei-huo:m006-0634","start":634,"end":636,"surface":"李沮","kind":"person","person_id":"jgc_i1f_kii","status":"contextual_provisional"},{"id":"c-shiji-111-wei-huo:m006-0637","start":637,"end":639,"surface":"李息","kind":"person","person_id":"tmv_5d7_bx2","status":"contextual_provisional"},{"id":"c-shiji-111-wei-huo:m006-0642","start":642,"end":645,"surface":"豆如意","kind":"person","person_id":"qce_nje_g73","status":"contextual_provisional"},{"id":"c-shiji-111-wei-huo:m006-0673","start":673,"end":675,"surface":"朱英","kind":"person","person_id":"o62_y1u_i8r","status":"contextual_provisional"}],"chapter_id":"c-shiji-111-wei-huo","book_id":"b-shiji-111","work_id":"w-shiji","source_id":"s-shiji111-wei-huo"},{"id":"c-shiji-111-wei-huo:p007","text":"其明年春，大將軍青出定襄，合騎侯敖為中將軍，太僕賀為左將軍，翕侯趙信為前將軍，衛尉蘇建為右將軍，郎中令李廣為後將軍，右內史李沮為彊弩將軍，咸屬大將軍，斬首數千級而還。月餘，悉復出定襄擊匈奴，斬首虜萬餘人。右將軍建、前將軍信并軍三千餘騎，獨逢單于兵，與戰一日餘，漢兵且盡。前將軍故胡人，降為翕侯，見急，匈奴誘之，遂將其餘騎可八百，奔降單于。右將軍蘇建盡亡其軍，獨以身得亡去，自歸大將軍。大將軍問其罪正閎、長史安、議郎周霸等：「建當云何？」霸曰：「自大將軍出，未嘗斬裨將。今建棄軍，可斬以明將軍之威。」閎、安曰：「不然。兵法『小敵之堅，大敵之禽也』。今建以數千當單于數萬，力戰一日餘，士盡，不敢有二心，自歸。自歸而斬之，是示後無反意也。不當斬。」大將軍曰：「青幸得以肺腑待罪行閒，不患無威，而霸說我以明威，甚失臣意。且使臣職雖當斬將，以臣之尊寵而不敢自擅專誅於境外，而具歸天子，天子自裁之，於是以見為人臣不敢專權，不亦可乎？」軍吏皆曰「善」。遂囚建詣行在所。入塞罷兵。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-111-wei-huo:m007-0005","start":5,"end":8,"surface":"大將軍","kind":"person","person_id":"5dd_l1c_6g8","status":"contextual_provisional"},{"id":"c-shiji-111-wei-huo:m007-0008","start":8,"end":9,"surface":"青","kind":"person","person_id":"5dd_l1c_6g8","status":"contextual_provisional"},{"id":"c-shiji-111-wei-huo:m007-0016","start":16,"end":17,"surface":"敖","kind":"person","person_id":"zuf_oll_649","status":"contextual_provisional"},{"id":"c-shiji-111-wei-huo:m007-0024","start":24,"end":25,"surface":"賀","kind":"person","person_id":"yay_w6f_lis_A","status":"contextual_provisional"},{"id":"c-shiji-111-wei-huo:m007-0032","start":32,"end":34,"