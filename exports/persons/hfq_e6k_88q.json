ttestation","person_id":"hfq_e6k_88q","attestations":[{"id":"th-sanguozhi-064-zhugeke-complete-22-2:a","paragraph_id":"c-sanguozhi-064-zhugeke-complete:p022","start":2,"end":6,"surface":"丹楊太守","person_mention_id":"c-sanguozhi-064-zhugeke-complete:p022:m0006","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-064","chapter_id":"c-sanguozhi-064-zhugeke-complete","source_id":"s-sanguozhi-064-zhugeke-complete-ws2263487","paragraph_id":"c-sanguozhi-064-zhugeke-complete:p022","quote":"　　丹楊太守聶友素與恪善。書諫恪曰：「大行皇帝本有遏東關之計，計未施行。今公輔贊大業，成先帝之志。寇遠自送，將士憑賴威德，出身用命，一旦有非常之功，豈非宗廟神靈社稷之福邪！宜且案兵養銳，觀釁而動。今乘此勢欲復大出，天時未可。而苟任盛意，私心以為不安。」恪題論後，為書答友曰：「足下雖有自然之理，然未見大數。熟省此論，可以開悟矣。」於是違眾出軍，大發州郡二十萬眾，百姓騷動，始失人心。","person_mention_id":"c-sanguozhi-064-zhugeke-complete:p022:m0006"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-064-nieyou-complete:p001","text":"　　始恪退軍還，聶友知其將敗。書與滕胤曰：「當人強盛，河山可拔，一朝羸縮，人情萬端，言之悲歎。」恪誅後，孫峻忌友，欲以為鬱林太守。友發病憂死。友字文悌，豫章人也。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":62,"last_line":62,"raw_start":8326,"raw_end":8596,"raw_character_offsets":[8326,8327,8328,8329,8330,8331,8332,8333,8334,8335,8336,8337,8338,8339,8340,8341,8342,8343,8344,8345,8346,8347,8348,8349,8350,8351,8352,8353,8354,8355,8356,8357,8358,8359,8360,8361,8362,8363,8364,8365,8366,8367,8368,8369,8370,8371,8372,8373,8374,8375,8376,8377,8378,8379,8380,8381,8382,8383,8384,8385,8386,8387,8388,8389,8390,8391,8392,8393,8394,8395,8396,8397,8398,8399,8400,8401,8402,8403,8404,8405,8406],"revisio