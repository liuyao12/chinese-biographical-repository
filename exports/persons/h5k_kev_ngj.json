ahoudan-complete:p002:m0161","start":161,"end":164,"surface":"湛僧智","kind":"person","person_id":"ahs_b64_hpl","status":"contextual_provisional"},{"id":"c-liangshu-028-xiahoudan-complete:p002:m0165","start":165,"end":167,"surface":"魚弘","kind":"person","person_id":"awq_0ji_ba2","status":"contextual_provisional"},{"id":"c-liangshu-028-xiahoudan-complete:p002:m0168","start":168,"end":170,"surface":"張澄","kind":"person","person_id":"ttt_6h8_hoa","status":"contextual_provisional"},{"id":"c-liangshu-028-xiahoudan-complete:p002:m0190","start":190,"end":191,"surface":"亶","kind":"person","person_id":"zz1_0tr_xni_A","status":"contextual_provisional"},{"id":"c-liangshu-028-xiahoudan-complete:p002:m0194","start":194,"end":195,"surface":"亶","kind":"person","person_id":"zz1_0tr_xni_A","status":"contextual_provisional"},{"id":"c-liangshu-028-xiahoudan-complete:p002:m0196","start":196,"end":198,"surface":"僧智","kind":"person","person_id":"ahs_b64_hpl","status":"contextual_provisional"},{"id":"c-liangshu-028-xiahoudan-complete:p002:m0213","start":213,"end":215,"surface":"韋放","kind":"person","person_id":"axs_5y7_p7w_AAA","status":"contextual_provisional"},{"id":"c-liangshu-028-xiahoudan-complete:p002:m0276","start":276,"end":277,"surface":"亶","kind":"person","person_id":"zz1_0tr_xni_A","status":"contextual_provisional"},{"id":"c-liangshu-028-xiahoudan-complete:p002:m0326","start":326,"end":327,"surface":"亶","kind":"person","person_id":"zz1_0tr_xni_A","status":"contextual_provisional"},{"id":"c-liangshu-028-xiahoudan-complete:p002:m0364","start":364,"end":366,"surface":"高祖","kind":"person","person_id":"fo7_f8v_rmf","status":"contextual_provisional"},{"id":"c-liangshu-028-xiahoudan-complete:p002:m0388","start":388,"end":391,"surface":"夏侯簡","kind":"person","person_id":"lxe_8bu_2sv","status":"contextual_provisional"},{"id":"c-liangshu-028-xiahoudan-complete:p002:m0398","start":398,"end":399,"surface":"亶","kind":"person","person_id":"zz1_0tr_xni_A","status":"contextual_provisional"}],"chapter_id":"c-liangshu-028-xiahoudan-complete","book_id":"b-liangshu-028","work_id":"w-liangshu","source_id":"s-liangshu-028-xiahoudan-complete-ws1511902"},{"id":"c-nanshi-022-wanggui:p003","text":"普通初，陳慶之北侵，陷洛陽，百僚稱慶。規退曰：「可吊也，又何賀焉。道家有云：非為功難，成功難也。昔桓溫得而復失，宋武竟無成功。我孤軍無援，深入寇境，將為亂階。」俄見覆沒。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"start":4,"end":7,"surface":"陳慶之","id":"c-nanshi-022-wanggui:p003:m0004","person_id":"h5k_kev_ngj","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作陳。"},{"start":14,"end":16,"surface":"百僚","id":"c-nanshi-022-wanggui:p003:u0014","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"稱慶百官。"},{"start":19,"end":20,"surface":"規","id":"c-nanshi-022-wanggui:p003:m0019","person_id":"7r6_k52_qji_ABAAAAEAAAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作規。"},{"start":49,"end":51,"surface":"桓溫","id":"c-nanshi-022-wanggui:p003:m0049","person_id":"u9s_w6j_8mc_AA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作桓。"}],"source_position":{"revision_id":1477957,"source_layer":"received_biography","raw_start":5750,"raw_end":5835,"raw_character_offsets":[5750,5751,5752,5753,5754,5755,5756,5757,5758,5759,5760,5761,5762,5763,5764,5765,5766,5767,5768,5769,5770,5771,5772,5773,5774,5775,5776,5777,5778,5779,5780,5781,5782,5783,5784,5785,5786,5787,5788,5789,5790,5791,5792,5793,5794,5795,5796,5797,5798,5799,5800,5801,5802,5803,5804,5805,5806,5807,5808,5809,5810,5811,5812,5813,5814,5815,5816,5817,5818,5819,5820,5821,5822,5823,5824,5825,5826,5827,5828,5829,5830,5831,5832,5833,5834],"projection_sha256":"c06da9a34268ad65624a1be9ff71dff3c7be0c835cc2acea6adb87efb0d05b64"},"chapter_id":"c-nanshi-022-wanggui","book_id":"b-nanshi-022","work_id":"w-nanshi","source_id":"s-nanshi-022-wanggui-ws1477957"},{"id":"c-weishu-weishou-058-yangbo-yangkan:p011","text":"及車駕南還，顥令蕭衍將陳慶之守北中城，自據南岸。有夏州義士為顥守河中渚，乃密信通款，求破橋立效，尒朱榮率軍赴之。及橋破，應接不果，皆為顥所屠滅。榮因悵然，將為還計，欲更圖後舉。侃曰：「未審明大王發并州之日，已知有夏州義士指來相應，為欲廣申經略，寧復帝基乎？夫兵散而更合，瘡愈而更戰，持此收功，自古不少，豈可以一圖不全，而眾慮頓廢。今事不果，乃是兩賊相殺，則大王之利矣。若今即還，民情失望，去就之心，何由可保？未若召發民材，惟多縛筏，間以舟楫，沿河廣布，令數百里中，皆為渡勢。首尾既遠，顥復知防何處，一旦得渡，必立大功。」榮大笑曰：「黃門即奏行此計。」於是尒朱兆與侃等遂與馬渚諸楊南渡，破顥子領軍將軍冠受，擒之。顥便南走。車駕入都，侃解尚書，正黃門，加征東將軍、金紫光祿大夫。以濟河之功，進爵濟北郡開國公，增邑五百戶，復除其長子師沖為祕書郎。","text_layer":"received_chapter","annotation_status":"in_progress","source_position":{"revision_id":2087998,"raw_start":2343,"raw_end":3021,"source_layer":"received_biography","raw_character_offsets":[2343,2344,2345,2346,2347,2348,2349,2350,2351,2352,2353,2354,2355,2356,2357,2358,2359,2360,2361,2362,2363,2364,2365,2366,2367,2368,2369,2370,2371,2372,2373,2374,2375,2376,2377,2378,2379,2380,2381,2382,2383,2384,2385,2386,2387,2388,2389,2390,2391,2392,2393,2394,2395,2396,2397,2398,2399,2400,2401,2402,2403,2404,2405,2406,2407,2408,2409,2410,2411,2412,2413,2414,2415,2416,2417,2418,2419,2420,2421,2422,2423,2424,2425,2426,2427,2428,2429,2430,2431,2432,2433,2434,2435,2436,2437,2438,2439,2440,2441,2442,2443,2444,2445,2446,2447,2448,2449,2450,2451,2452,2453,2454,2455,2456,2457,2458,2459,2460,2461,2462,2463,2464,2465,2466,2467,2468,2469,2470,2471,2472,2473,2474,2475,2476,2477,2478,2479,2480,2481,2482,2483,2484,2485,2486,2487,2488,2489,2490,2491,2492,2493,2494,2495,2496,2497,2498,2499,2500,2501,2502,2503,2504,2505,2506,2507,2508,2509,2510,2511,2512,2513,2514,2515,2516,2517,2518,2519,2520,2521,2522,2523,2524,2525,2526,2527,2528,2529,2530,2531,2532,2533,2534,2535,2536,2537,2538,2539,2540,2541,2542,2543,2544,2545,2546,2547,2548,2549,2550,2551,2552,2553,2660,2661,2662,2663,2664,2665,2666,2667,2668,2669,2670,2671,2672,2673,2674,2675,2676,2677,2678,2679,2680,2681,2682,2683,2684,2685,2686,2687,2688,2689,2690,2691,2692,2693,2694,2695,2696,2697,2698,2699,2700,2701,2702,2703,2704,2705,2706,2707,2708,2709,2710,2711,2712,2713,2714,2715,2716,2717,2718,2719,2720,2721,2722,2723,2724,2725,2726,2727,2728,2729,2730,2731,2732,2733,2734,2735,2736,2737,2738,2739,2740,2943,2944,2945,2946,2947,2948