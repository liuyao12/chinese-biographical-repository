_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-074-huan-family:p014:m0069","start":69,"end":72,"surface":"王稚徽","kind":"person","person_id":"xv1_zb5_ps2","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。","paragraph_id":"c-jinshu-074-huan-family:p014","chapter_id":"c-jinshu-074-huan-family"},{"id":"c-jinshu-074-huan-family:p014:m0076","start":76,"end":78,"surface":"稚徽","kind":"person","person_id":"xv1_zb5_ps2","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。","paragraph_id":"c-jinshu-074-huan-family:p014","chapter_id":"c-jinshu-074-huan-family"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-074-huan-family:p014","text":"振字道全。少果銳，而無行。玄為荊州，以振為揚武將軍、淮南太守。轉江夏相，以凶橫見黜。及玄之敗也，桓謙匿於沮中，振逃于華容之沮中。玄先令將軍王稚徽戍巴陵，稚徽遣人報振云：「桓欽已克京邑，馮稚等復平尋陽，劉毅諸軍並敗于中路。」振大喜。時安帝在江陵，振乃聚黨數十人襲江陵。比至城，有眾二百。謙亦聚眾而出，遂陷江陵，迎帝於行宮。振聞桓升死，大怒，將肆逆於帝，謙苦禁之，乃止。遂命群臣，辭以楚祚不終，百姓之心復歸於晉，更奉進璽綬，以琅邪王領徐州刺史，振為都督八州、鎮西將軍、荊州刺史。帝侍御左右，皆振之腹心，既而歎曰：「公昔早不用我，遂致此敗。若使公在，我為前鋒，天下不足定。今獨作此，安歸乎！」遂肆意酒色，暴虐無道，多所殘害。","source_position":{"kind":"wikitext_codepoint_positions","raw_path":"sources/jinshu/wikisource-1536331-raw.wikitext","raw_start":3283,"raw_end":3638,"character_positions":[3285,3286,