i_provisional","identity_note":"《三國志·辛毗傳》裴注所錄「子琇」見於憲英家事及鍾會參軍敘述；《晉書·羊琇傳》明書羊琇、字稚舒、父耽、兄瑾，並記參鎮西鐘會軍事，據姓名、任事及家庭上下文接為同人。兩篇原稱分存；父子依《晉書》明文，母子依裴注所錄「子琇」，不由婚姻補出生母或瑾的父親；敞字泰雍不移給琇。"}],"source_mention_summary":[{"source_id":"s-jinshu-093-ws1548000-yangxiu","work_id":"w-jinshu","book_id":"b-jinshu-093","chapter_id":"c-jinshu-093-yangxiu","raw_mention_count":1,"mention_ids":["c-jinshu-093-yangxiu:p001:m0005"],"paragraph_ids":["c-jinshu-093-yangxiu:p001"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-093-yangxiu:p001:m0005","mention_ids":["c-jinshu-093-yangxiu:p001:m0005"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-093-ws1548000-yangxiu"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin093-yangxiu-brother","subject_person_id":"dqd_5q9_pkz_CB","predicate":"brother","object_person_id":"dqd_5q9_pkz_CA","qualifiers":{"received_family_frame":{"kind":"punctuated_received_family_frame","rule":"collateral_head_named_father_brother","roles":{"child":"c-jinshu-093-yangxiu:p001:m0001","zi":"c-jinshu-093-yangxiu:p001:m0002","senior":"c-jinshu-093-yangxiu:p001:m0003","father":"c-jinshu-093-yangxiu:p001:m0004","brother":"c-jinshu-093-yangxiu:p001:m0005"},"clause_start":0,"clause_end":34,"paragraph_sha256":"613f8028248a26f8c7c97ea084edf30d4d2e9ee97a832cf0f79d1146cb22f971","revision_id":1548000},"source_term":"兄","relative_age":"younger","relative_birth_order":{"older_person_id":"dqd_5q9_pkz_CA","younger_person_id":"dqd_5q9_pkz_CB","operator":"lt","older_ordinal":null,"younger_ordinal":null,"scope":"siblings"}},"status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-093","source_id":"s-jinshu-093-ws1548000-yangxiu","chapter_id":"c-jinshu-093-yangxiu","paragraph_id":"c-jinshu-093-yangxiu:p001","quote":"羊琇，字稚舒，景獻皇后之從父弟也。父耽，官至太常。兄瑾，尚書右僕射。琇少舉郡計，參鎮西鐘會軍事，從平蜀。及會謀反，琇正言苦諫，還，賜爵關內侯。琇涉學有智算，少與武帝通門，甚相親狎，每接筵同席，嘗謂帝曰：「若富貴見用，任領護各十年。」帝戲而許之。初，帝未立為太子，而聲論不及弟攸，文帝素意重攸，恆有代宗之議。琇密為武帝畫策，甚有匡救。又觀察文帝為政損益，揆度應所顧問之事，皆令武帝默而識之。其後文帝與武帝論當世之務及人間可否，武帝答無不允，由是儲位遂定。及帝為撫軍，命琇參軍事。帝即王位後，擢琇為左衛將軍，封甘露亭侯。帝踐阼，累遷中護軍，加散騎常侍。琇在職十三年，典禁兵，豫機密，寵遇甚厚。","subject_person_mention_id":"c-jinshu-093-yangxiu:p001:m0001","object_person_mention_id":"c-jinshu-093-yangxiu:p001:m0005"}],"interpretation_note":"父耽、兄瑾明文分角色；從父弟沿既有古典正常語義首選父系同代較幼堂親，親等屬literary_usage資格非遺傳驗證，不造共祖人物或雙方父鏈。母、籍貫不補。","reviewer":"Codex（AI代理）","human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"id":"n-jin093-yangxiu-brother-name","person_id":"dqd_5q9_pkz_CA","status":"contextual_provisional","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-093","source_id":"s-jinshu-093-ws1548000-yangxiu","chapter_id":"c-jinshu-093-yangxiu","paragraph_id":"c-jinshu-093-yangxiu:p001","quote":"羊琇，字稚舒，景獻皇后之從父弟也。父耽，官至太常。兄瑾，尚書右僕射。琇少舉郡計，參鎮西鐘會軍事，從平蜀。及會謀反，琇正言苦諫，還，賜爵關內侯。琇涉學有智算，少與武帝通門，甚相親狎，每接筵同席，嘗謂帝曰：「若富貴見用，任領護各十年。」帝戲而許之。初，帝未立為太子，而聲論不及弟攸，文帝素意重攸，恆有代宗之議。琇密為武帝畫策，甚有匡救。又觀察文帝為政損益，揆度應所顧問之事，皆令武帝默而識之。其後文帝與武帝論當世之務及人間可否，武帝答無不允，由是儲位遂定。及帝為撫軍，命琇參軍事。帝即王位後，擢琇為左衛將軍，封甘露亭侯。帝踐阼，累遷中護軍，加散騎常侍。琇在職十三年，典禁兵，豫機密，寵遇甚厚。","person_mention_id":"c-jinshu-093-yangxiu:p001:m0005"}],"reviewer":"Codex（AI代理）","human_reviewed":false,"model":null,"interpretation_note":"頭名及字直接原證；父/兄羊姓只沿本源已驗近親與明姓種子，不由ID/標籤/婚姻推。","fixed_source_fact