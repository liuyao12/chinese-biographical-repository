shiji-101-yuanchao"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji101-024","person_id":"n1j_kbh_u02","surfaces":["丞史"],"scope":"same_chapter","chapter_ids":["c-shiji-101-yuanchao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-101-yuanchao:p012","quote":"吳楚反，聞，鼂錯謂丞史曰：「夫袁盎多受吳王金錢，專為蔽匿，言不反。今果反，欲請治盎宜知計謀。」丞史曰：「事未發，治之有絕。今兵西鄉，治之何益！且袁盎不宜有謀。」鼂錯猶與未決。人有告袁盎者，袁盎恐，夜見竇嬰，為言吳所以反者，願至上前口對狀。竇嬰入言上，上乃召袁盎入見。鼂錯在前，及盎請辟人賜閒，錯去，固恨甚。袁盎具言吳所以反狀，以錯故，獨急斬錯以謝吳，吳兵乃可罷。其語具在吳事中。使袁盎為太常，竇嬰為大將軍。兩人素相與善。逮吳反。諸陵長者長安中賢大夫爭附兩人，車隨者日數百乘。"}],"rationale":"按本傳明示姓名、字及敘事承接；皇帝上字逐處依文景敘事核定，建元上另留未名。兄噲不合樊噲，兄子種不補具名父親。身份及官稱回指為代理首輪判讀，非人工覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-101-yuanchao:p012","text":"吳楚反，聞，鼂錯謂丞史曰：「夫袁盎多受吳王金錢，專為蔽匿，言不反。今果反，欲請治盎宜知計謀。」丞史曰：「事未發，治之有絕。今兵西鄉，治之何益！且袁盎不宜有謀。」鼂錯猶與未決。人有告袁盎者，袁盎恐，夜見竇嬰，為言吳所以反者，願至上前口對狀。竇嬰入言上，上乃召袁盎入見。鼂錯在前，及盎請辟人賜閒，錯去，固恨甚。袁盎具言吳所以反狀，以錯故，獨急斬錯以謝吳，吳兵乃可罷。其語具在吳事中。使袁盎為太常，竇嬰為大將軍。兩人素相與善。逮吳反。諸陵長者長安中賢大夫爭附兩人，車隨者日數百乘。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-101-yuanchao:m012-0006","start":6,"end":8,"surface":"鼂錯","kind":"person","person_id":"04u_gq0_nke_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m012-0009","start":9,"end":11,"surface":"丞史","kind":"person","person_id":"n1j_kbh_u02","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m012-0015","start":15,"end":17,"surface":"袁盎","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m012-0019","start":19,"end":21,"surface":"吳王","kind":"person","person_id":"7l9_yz7_nwv","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m012-0040","start":40,"end":41,"surface":"盎","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m012-0047","start":4