u:m012-0215","start":215,"end":217,"surface":"閼氏","kind":"person","person_id":"32k_yr7_5kv","status":"contextual_provisional","paragraph_id":"c-shiji-110-xiongnu:p012","chapter_id":"c-shiji-110-xiongnu"},{"id":"c-shiji-110-xiongnu:m012-0291","start":291,"end":293,"surface":"閼氏","kind":"person","person_id":"32k_yr7_5kv","status":"contextual_provisional","paragraph_id":"c-shiji-110-xiongnu:p012","chapter_id":"c-shiji-110-xiongnu"}],"relations":[],"title_holdings":[{"id":"th-shiji110-023","person_id":"32k_yr7_5kv","title":"閼氏","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-110-xiongnu","source_id":"s-shiji110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p012","quote":"是時漢初定中國，徙韓王信於代，都馬邑。匈奴大攻圍馬邑，韓王信降匈奴。匈奴得信，因引兵南踰句注，攻太原，至晉陽下。高帝自將兵往擊之。會冬大寒雨雪，卒之墮指者十二三，於是冒頓詳敗走，誘漢兵。漢兵逐擊冒頓，冒頓匿其精兵，見其羸弱，於是漢悉兵，多步兵，三十二萬，北逐之。高帝先至平城，步兵未盡到，冒頓縱精兵四十萬騎圍高帝於白登，七日，漢兵中外不得相救餉。匈奴騎，其西方盡白馬，東方盡青駹馬，北方盡烏驪馬，南方盡騂馬。高帝乃使使閒厚遺閼氏，閼氏乃謂冒頓曰：「兩主不相困。今得漢地，而單于終非能居之也。且漢王亦有神，單于察之。」冒頓與韓王信之將王黃、趙利期，而黃、利兵又不來，疑其與漢有謀，亦取閼氏之言，乃解圍之一角。於是高帝令士皆持滿傅矢外鄉，從解角直出，竟與大軍合，而冒頓遂引兵而去。漢亦引兵而罷，使劉敬結和親之約。"}],"attestations":[{"id":"th-shiji110-023:a001","paragraph_id":"c-shiji-110-xiongnu:p012","start":212,"end":214,"surface":"閼氏","person_mention_id":"c-shiji-110-xiongnu:m012-0212","usage":"retrospective"},{"id":"th-shiji110-023:a002","paragraph_id":"c-shiji-110-xiongnu:p012","start":215,"end":217,"surface":"閼氏","person_mention_id":"c-shiji-110-xiongnu:m012-0215","usage":"retrospective"},{"id":"th-shiji110-023:a003","paragraph_id":"c-shiji-110-xiongnu:p012","start":291,"end":293,"surface":"閼氏","person_mention_id":"c-shiji-110-xiongnu:m012-0291","usage":"retrospective"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"保存本段來源用稱；完整個人任期與授任日期未知。宗室女稱公主不推漢帝親生女，閼氏不同敘事不自動同指。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"prefer