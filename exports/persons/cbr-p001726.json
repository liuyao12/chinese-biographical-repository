_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji039-164","person_id":"5sp_ts1_az0","surfaces":["冀芮"],"scope":"same_chapter","chapter_ids":["c-shiji-039-jin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-039-jin:p035","quote":"二十三年，獻公遂發賈華等伐屈，屈潰。夷吾將奔翟。冀芮曰：「不可，重耳已在矣，今往，晉必移兵伐翟，翟畏晉，禍且及。不如走梁，梁近於秦，秦彊，吾君百歳後可以求入焉。」遂奔梁。二十五年，晉伐翟，翟以重耳故，亦撃晉於齧桑，晉兵解而去。"},{"paragraph_id":"c-shiji-039-jin:p042","quote":"邳鄭使秦，聞裏克誅，乃説秦繆公曰：「呂省、郤稱、冀芮實爲不從。若重賂與謀，出晉君，入重耳，事必就。」秦繆公許之，使人與歸報晉，厚賂三子。三子曰：「幣厚言甘，此必邳鄭賣我於秦。」遂殺邳鄭及裏克、邳鄭之黨七輿大夫。邳鄭子豹奔秦，言伐晉，繆公弗聽。"}],"rationale":"按本篇明示名與稱號、晉世系與具體事件暫定所列提及同指；附各段原文，未按同字短名全域合併；紀年與版本差異待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-039-jin:p035","text":"二十三年，獻公遂發賈華等伐屈，屈潰。夷吾將奔翟。冀芮曰：「不可，重耳已在矣，今往，晉必移兵伐翟，翟畏晉，禍且及。不如走梁，梁近於秦，秦彊，吾君百歳後可以求入焉。」遂奔梁。二十五年，晉伐翟，翟以重耳故，亦撃晉於齧桑，晉兵解而去。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m035-0005","start":5,"end":7,"surface":"獻公","kind":"person","person_id":"6di_ywz_ju4_AA","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m035-0009","start":9,"end":11,"surface":"賈華","kind":"person","person_id":"4we_dkh_dzr","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m035-0018","start":18,"end":20,"surface":"夷吾","kind":"person","person_id":"a9v_t0d_3va","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m035-0024","start":24,"end":26,"surface":"冀芮","kind":"person","person_id":"5sp_ts1_az0","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m035-0032","start":32,"end":34,"surface":"重耳","kind":"person","person_id":"6di_ywz_ju4_AAA","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m035-0096","start":96,"end":98,"surface":"重耳","kind":"person","person_id":"6di_ywz_ju4_AAA","status":"contextual_provisional"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"},{"id":"c-shiji-039-jin:p042","text":"邳鄭使秦，聞裏克誅，乃説秦繆公曰：「呂省、郤稱、冀芮實爲不從。若重賂與謀，出晉君，入重耳，事必就。」秦繆公許之，使人與歸報晉，厚賂三子。三子曰：「幣厚言甘，此必邳鄭賣我於秦。」遂殺邳鄭及裏克、邳鄭之黨七輿大夫。邳鄭子豹奔秦，言伐晉，繆公弗聽。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m042-0000","start":0,"end":2,"surface":"邳鄭","kind":"person","person_id":"rlv_clg_euu","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m042-0006","start":6,"end":8,"surface":"裏克","kind":"person","person_id":"uon_qea_38x","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m042-0012","start":12,"end":15,"surface":"秦繆公","kind":"person","person_id":"y97_huh_vuz_AAAAA","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m042-0018","start":18,"end":20,"surface":"呂省","kind":"person","person_id":"iwp_3ea_wpr","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m042-0021","start":21,"end":23,"surface":"郤稱","kind":"person","person_id":"syy_h2t_4ie","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m042-0024","start":24,"end":26,"surface":"冀芮","kind":"person","person_id":"5sp_ts1_az0","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m042-0038","start":38,"end":40,"surface":"晉君","kind":"person","person_id":"a9v_t0d_3va","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m042-0050","start":50,"end":53,"surface":"秦繆公","kind":"person","person_id":"y97_huh_vuz_AAAAA","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m042-0065","start":65,"end":67,"surface":"三子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m042-0068","start":68,"end":70,"surface":"三子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m042-0080","start":80,"end":82,"surface":"邳鄭","kind":"person","person_id":"rlv_clg_euu","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m042-0090","start":90,"e