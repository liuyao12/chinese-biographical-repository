son_id":"tvk_3qo_6n5","status":"contextual_provisional","paragraph_id":"c-shiji-121-rulin:p001","chapter_id":"c-shiji-121-rulin"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-121-rulin:p001","text":"太史公曰：余讀功令，至於廣厲學官之路，未嘗不廢書而嘆也。曰：嗟乎！夫周室衰而關雎作，幽厲微而禮樂壞，諸侯恣行，政由彊國。故孔子閔王路廢而邪道興，於是論次詩書，修起禮樂。適齊聞韶，三月不知肉味。自衛返魯，然後樂正，雅頌各得其所。世以混濁莫能用，是以仲尼干七十餘君無所遇，曰「茍有用我者，期月而已矣」。西狩獲麟，曰「吾道窮矣」。故因史記作春秋，以當王法，其辭微而指博，後世學者多錄焉。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m001-0000","start":0,"end":3,"surface":"太史公","kind":"person","person_id":"tvk_3qo_6n5","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m001-0042","start":42,"end":43,"surface":"幽","kind":"person","person_id":"fd5_uxa_0c9","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m001-0043","start":43,"end":44,"surface":"厲","kind":"person","person_id":"jps_m3k_hu4","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m001-0061","start":61,"end":63,"surface":"孔子","kind":"person","person_id":"fp6_ia6_7yw","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m001-0123","start":123,"end":125,"surface":"仲尼","kind":"person","person_id":"fp6_ia6_7yw","status":"contextual_provisional"}],"chapter_id":"c-shiji-121-rulin","book_id":"b-shiji-121","work_id":"w-shiji","source_id":"s-shiji121-rulin"}],"sources":[{"chapter_id":"c-shiji-121-rulin","work_id":"w-shiji","book_id":"b-shiji-121","source_id":"s-shiji121-rulin","source":{"title":"史記／卷121","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷121","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷121&oldid=8735621","revision_id":8735621,"accessed_on":"2026-10-11","extent":"固定修訂全文25段，包括末段索隱述贊。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://crea