extual_provisional"},{"id":"c-shiji-047-kong:m014-0043","start":43,"end":46,"surface":"季桓子","kind":"person","person_id":"cbr-p002843","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m014-0047","start":47,"end":49,"surface":"桓子","kind":"person","person_id":"cbr-p002843","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m014-0055","start":55,"end":57,"surface":"定公","kind":"person","person_id":"cbr-p002842","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m014-0060","start":60,"end":62,"surface":"陽虎","kind":"person","person_id":"cbr-p002853","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m014-0071","start":71,"end":73,"surface":"孔子","kind":"person","person_id":"cbr-p002851","status":"contextual_provisional"}],"chapter_id":"c-shiji-047-kong","book_id":"b-shiji-047","work_id":"w-shiji","source_id":"s-shiji-047-kong"},{"id":"c-shiji-047-kong:p016","text":"其後定公以孔子為中都宰，一年，四方皆則之。由中都宰為司空，由司空為大司寇。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-047-kong:m016-0002","start":2,"end":4,"surface":"定公","kind":"person","person_id":"cbr-p002842","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m016-0005","start":5,"end":7,"surface":"孔子","kind":"person","person_id":"cbr-p002851","status":"contextual_provisional"}],"chapter_id":"c-shiji-047-kong","book_id":"b-shiji-047","work_id":"w-shiji","source_id":"s-shiji-047-kong"},{"id":"c-shiji-047-kong:p017","text":"定公十年春，及齊平。夏，齊大夫黎鉏言於景公曰：「魯用孔丘，其勢危齊。」乃使使告魯為好會，會於夾谷。魯定公且以乘車好往。孔子攝相事，曰：「臣聞有文事者必有武備，有武事者必有文備。古者諸侯出疆，必具官以從。請具左右司馬。」定公曰：「諾。」具左右司馬。會齊侯夾谷，為壇位，土階三等，以會遇之禮相見，揖讓而登。獻酬之禮畢，齊有司趨而進曰：「請奏四方之樂。」景公曰：「諾。」於是旍旄羽袚矛戟劍撥鼓噪而至。孔子趨而進，歷階而登，不盡一等，舉袂而言曰：「吾兩君為好會，夷狄之樂何為於此！請命有司！」有司卻之，不去，則左右視晏子與景公。景公心怍，麾而去之。有頃，齊有司趨而進曰：「請奏宮中之樂。」景公曰：「諾。」優倡侏儒為戲而前。孔子趨而進，歷階而登，不盡一等，曰：「匹夫而營惑諸侯者罪當誅！請命有司！」有司加法焉，手足異處。景公懼而動，知義不若，歸而大恐，告其羣臣曰：「魯以君子之道輔其君，而子獨以夷狄之道敎寡人，使得罪於魯君，為之奈何？」有司進對曰：「君子有過則謝以質，小人有過則謝以文。君若悼之，則謝以質。」於是齊侯乃歸所侵魯之鄆、汶陽、龜陰之田以謝過。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-047-kong:m017-0000","start":0,"end":2,"surface":"定公","kind":"person","person_id":"cbr-p002842","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m017-0015","start":15,"end":17,"surface":"黎鉏","kind":"person","person_id":"cbr-p002863","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m017-0019","start":19,"end":21,"surface":"景公","kind":"person","person_id":"cbr-p002837","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m017-0026","start":26,"end":28,"surface":"孔丘","kind":"person","person_id":"cbr-p002851","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m017-0049","start":49,"end":52,"surface":"魯定公","kind":"person","person_id":"cbr-p002842","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m017-0059","start":59,"end":61,"surface":"孔子","kind":"person","person_id":"cbr-p002851","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m017-0103","start":103,"end":107,"surface":"左右司馬","kind":"unresolved","person_id":null,"status":"unresolved","note":"宗族、群體、神怪、官稱或說話對象未定，不補成員姓名及親屬。"},{"id":"c-shiji-047-kong:m017-0109","start":109,"end":111,"surface":"定公","kind":"person","person_id":"cbr-p002842","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m017-0118","start":118,"end":122,"surface":"左右司馬","kind":"unresolved","person_id":null,"status":"unresolved","note":"宗族、群體、神怪、官稱或說話對象未定，不補成員姓名及親屬。"},{"id":"c-shiji-047-kong:m017-0124","start":124,"end":126,"surface":"齊侯","kind":"person","person_id":"cbr-p002837","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m017-0157","start":157,"end":160,"surface":"齊有司","kind":"unresolved","person_id":null,"status":"unresolved","note":"宗族、群體、神怪、官稱或說話對象未定，不補成員姓名及親屬。"},{"id":"c-shiji-047-kong:m017-0174","start":174,"end":176,"surface":"景公","kind":"person","person_id":"cbr-p002837","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m017-0197","start":197,"end":199,"surface":"孔子","kind":"person","person_id":"cbr-p002851","s