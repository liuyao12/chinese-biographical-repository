sional","interpretation_note":"原文具名或局部代稱；身份依全傳及具體來源橋接，不按同字跨世代配人。","identity_decision_id":"d-nanqi043-xieyue-wangyan","paragraph_id":"c-nanqishu-043-xieyue:p005","chapter_id":"c-nanqishu-043-xieyue"},{"start":6,"end":8,"surface":"王晏","id":"c-nanshi-021-wangzhan:p002:m0006","person_id":"i08_s4b_5bb","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作王晏。","paragraph_id":"c-nanshi-021-wangzhan:p002","chapter_id":"c-nanshi-021-wangzhan"},{"start":11,"end":12,"surface":"晏","id":"c-nanshi-021-wangzhan:p002:m0011","person_id":"i08_s4b_5bb","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作王晏。","paragraph_id":"c-nanshi-021-wangzhan:p002","chapter_id":"c-nanshi-021-wangzhan"}],"relations":[],"title_holdings":[{"id":"th-liang021-wangzhan-15-96","person_id":"i08_s4b_5bb","title":"驃騎將軍","kind":"office","mode":"attestation","attestations":[{"id":"th-liang021-wangzhan-15-96:a","paragraph_id":"c-liangshu-021-wangzhan:p003","start":96,"end":100,"surface":"驃騎將軍","person_mention_id":"c-liangshu-021-wangzhan:p003:m0100","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-021","chapter_id":"c-liangshu-021-wangzhan","source_id":"s-liangshu-021-wangzhan-ws1544250","paragraph_id":"c-liangshu-021-wangzhan:p003","quote":"起家著作佐郎，累遷太子舍人、太尉主簿、太子洗馬。頃之，出爲鄱陽內史，秩滿，授太子中舍人。又爲齊南海王友，尋轉司徒竟陵王從事中郎，王甚相賓禮。南海王爲護軍將軍，瞻爲長史。又出補徐州別駕從事史，遷驃騎將軍王晏長史。晏誅，出爲晉陵太守。瞻潔己爲政，妻子不免饑寒。時大司馬王敬則舉兵作亂，路經晉陵，郡民多附敬則。軍敗，臺軍討賊黨，瞻言於朝曰：「愚人易動，不足窮法。」明帝許之，所全活者萬數。徵拜給事黃門侍郎，撫軍建安王長史，御史中丞。","person_mention_id":"c-liangshu-021-wangzhan:p003:m0100"}],"status":"source_attested","interpretation_note":"本句所載官名，任期無確切年月。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"th-nanqi023-85-18","person_id":"i08_s4b_5bb","title":"吏部尚書","kind":"office","mode":"attestation","attestations":[{"id":"th-nanqi023-85-18:a","paragraph_id":"c-nanqishu-023-wangjian:p012","start":18,"end":22,"surface":"吏部尚書","person_mention_id":"c-nanqishu-023-wangjian:p012:m0022","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-023","source_id":"s-nanqishu-023-wangjian-ws1545488","chapter_id":"c-nanqishu-023-wangjian","paragraph_id":"c-nanqishu-023-wangjian:p012","quote":"　　其年疾，上親臨視，薨，年三十八。吏部尚書王晏啓及儉喪，上答曰：「儉年德富盛，志用方隆，豈意暴疾，不展救護，便爲異世，奄忽如此，痛酷彌深。其契闊艱運，義重常懷，言尋悲切，不能自勝。痛矣奈何！往矣奈何！」詔衞軍文武及臺所兵仗可悉停待葬。","person_mention_id":"c-nanqishu-023-wangjian:p012:m0022"}],"status":"source_attested","interpretation_note":"本段原字及敘述次序。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"status":"source_attested","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null,"id":"th-nanqi043-xieyue-yan-shangshu","person_id":"i08_s4b_5bb","title":"尚書令","kind":"office","mode":"attestation","evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-043","source_id":"s-nanqishu043-ws2400356","chapter_id":"c-nanqishu-043-xieyue","paragraph_id":"c-nanqishu-043-xieyue:p005","quote":"服闋，爲吏部尚書。高宗廢鬱林，領兵入殿，左右驚走報𤅢。與客圍棊，每下子，輙云「其當有意」。竟局，乃還齋卧，竟不問外事也。明帝卽位，𤅢又屬疾不視事。後上讌會，功臣上酒，尚書令王晏等興席，𤅢獨不起，曰：「陛下受命，應天從民，王晏妄叨天功以爲己力。」上大笑解之。座罷，晏呼𤅢共載還令省，欲相撫悅。又正色曰：「君巢窟在何處？」晏初得班劔，𤅢謂之曰：「身家太傅裁得六人。君亦何事一朝至此。」晏甚憚之。","person_mention_id":"c-nanqishu-043-xieyue:p005:m0086"}],"attestations":[{"id":"th-nanqi043-xieyue-yan-shangshu:a001","paragraph_id":"c-nanqishu-043-xieyue:p005","start":83,"end":86,"surface":"尚書令","person_mention_id":"c-nanqishu-043-xieyue:p005:m0086","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"明文官稱原字；用稱與任官起訖分開，未明日期留空，不取卒年填任期。"},{"id":"th-nanshi021-wangzhan-103-2","person_id":"i08_s4b_5bb","title":"驃騎將軍","kind":"office","mode":"attestation","attestations":[{"id":"th-nanshi021-wangzhan-103-2:a","paragraph_id":"c-nanshi-021-wangzhan:p002","start":2,"end":6,"surface":"驃騎將軍","person_mention_id":"c-nanshi-021-wangzhan:p002:m0006","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-021","chapter_id":"c-nanshi-021-wangzhan","source_id":"s-nanshi-021-wangzhan-ws1752646","paragraph_id":"c-nanshi-021-wangzhan:p002","quote":"歷位驃騎將軍王晏長史。晏誅，出爲晉陵太守。潔己爲政，妻子不免饑寒，時號廉平。王敬則作亂，瞻赴都，敬則經晉陵郡，人多附之。敬則敗，台軍討賊黨，瞻言愚人易動，不足窮法。齊明帝從之。所全萬數。遷御史中丞。","person_mention_id":"c-nanshi-021-wangzhan:p002:m0006"}],"status":"source_attested","interpretation_note":"本句所載官名，任期無確切年月。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-nanqi043-xieyue-wangyan","person_id":"i08_s4b_5bb","surfaces":["王晏","晏","君","之"],"scope":"same_chapter","chapter_ids":["c-nanqishu-043-xieyue"],"status":"contextual_provisional","evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-043","chapter_id":"c-nanqishu-043-xieyue","source_id":"s-nanqishu043-ws2400356","paragraph_id":"c-nanqishu-043-xieyue:p005","quote":"服闋，爲吏部尚書。高宗廢鬱林，領兵入殿，左右驚走報𤅢。與客圍棊，每下子，輙云「其當有意」。竟局，乃還齋卧，竟不問外事也。明帝卽位，𤅢又屬疾不視事。後上讌會，功臣上酒，尚書令王晏等興席，𤅢獨不起，曰：「陛下受命，應天從民，王晏妄叨天功以爲己力。」上大笑解之。座罷，晏呼𤅢共載還令省，欲相撫悅。又正色曰：「君巢窟在何處？」晏初得班劔，𤅢謂之曰：「身家太傅裁得六人。君亦何事一朝至此。」晏甚憚之。"}],"rationale":"尚書令王晏及後晏、君，均同一建武初功臣宴會、班劍與𤅢交鋒者；registry無該同身份，不合古代晏嬰。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null}],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-021-wangzhan-wyd:p003","text":"起家著作佐郎累遷太子舍人太尉主簿太子洗馬頃之出為鄱陽內史秩滿授太子中舍人又為齊南海王友尋轉司徒竟陵王從事中郎王甚相賓禮南海王為護軍將軍瞻為長史又出補徐州別駕從事史