relations":[],"title_holdings":[{"status":"source_attested","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null,"id":"th-nanqi043-xieyue-yan-shangshu","person_id":"i08_s4b_5bb","title":"尚書令","kind":"office","mode":"attestation","evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-043","source_id":"s-nanqishu043-ws2400356","chapter_id":"c-nanqishu-043-xieyue","paragraph_id":"c-nanqishu-043-xieyue:p005","quote":"服闋，爲吏部尚書。高宗廢鬱林，領兵入殿，左右驚走報𤅢。與客圍棊，每下子，輙云「其當有意」。竟局，乃還齋卧，竟不問外事也。明帝卽位，𤅢又屬疾不視事。後上讌會，功臣上酒，尚書令王晏等興席，𤅢獨不起，曰：「陛下受命，應天從民，王晏妄叨天功以爲己力。」上大笑解之。座罷，晏呼𤅢共載還令省，欲相撫悅。又正色曰：「君巢窟在何處？」晏初得班劔，𤅢謂之曰：「身家太傅裁得六人。君亦何事一朝至此。」晏甚憚之。","person_mention_id":"c-nanqishu-043-xieyue:p005:m0086"}],"attestations":[{"id":"th-nanqi043-xieyue-yan-shangshu:a001","paragraph_id":"c-nanqishu-043-xieyue:p005","start":83,"end":86,"surface":"尚書令","person_mention_id":"c-nanqishu-043-xieyue:p005:m0086","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"明文官稱原字；用稱與任官起訖分開，未明日期留空，不取卒年填任期。"}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-nanqi043-xieyue-wangyan","person_id":"i08_s4b_5bb","surfaces":["王晏","晏","君","之"],"scope":"same_chapter","chapter_ids":["c-nanqishu-043-xieyue"],"status":"contextual_provisional","evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-043","chapter_id":"c-nanqishu-043-xieyue","source_id":"s-nanqishu043-ws2400356","paragraph_id":"c-nanqishu-043-xieyue:p005","quote":"服闋，爲吏部尚書。高宗廢鬱林，領兵入殿，左右驚走報𤅢。與客圍棊，每下子，輙云「其當有意」。竟局，乃還齋卧，竟不問外事也。明帝卽位，𤅢又屬疾不視事。後上讌會，功臣上酒，尚書令王晏等興席，𤅢獨不起，曰：「陛下受命，應天從民，王晏妄叨天功以爲己力。」上大笑解之。座罷，晏呼𤅢共載還令省，欲相撫悅。又正色曰：「君巢窟在何處？」晏初得班劔，𤅢謂之曰：「身家太傅裁得六人。君亦何事一朝至此。」晏甚憚之。"}],"rationale":"尚書令王晏及後晏、君，均同一建武初功臣宴會、班劍與𤅢交鋒者；registry無該同身份，不合古代晏嬰。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null}],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-043-xieyue:p005","unit_id":"xieyue-complete","text":"服闋，爲吏部尚書。高宗廢鬱林，領兵入殿，左右驚走報𤅢。與客圍棊，每下子，輙云「其當有意」。竟局，乃還齋卧，竟不問外事也。明帝卽位，𤅢又屬疾不視事。後上讌會，功臣上酒，尚書令王晏等興席，𤅢獨不起，曰：「陛下受命，應天從民，王晏妄叨天功以爲己力。」上大笑解之。座罷，晏呼𤅢共載還令省，欲相撫悅。又正色曰：「君巢窟在何處？」晏初得班劔，𤅢謂之曰：「身家太傅裁得六人。君亦何事一朝至此。」晏甚憚之。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","source_position":{"first_line":61,"last_line":61,"revision_id":2400356,"editorial_excerpt_boundary":true},"mentions":[{"id":"c-nanqishu-043-xieyue:p005:m0009","start":9,"end":11,"surface":"高宗","kind":"person","person_id":"w4m_9tw_147","status":"contextual_provisional","interpretation_note":"原文具名或局部代稱；身份依全傳及具體來源橋接，不按同字跨世代配人。","identity_decision_id":"d-nanqi043-xieyue-mingdi"},{"id":"c-nanqishu-043-xieyue:p005:m0012","start":12,"end":14,"surface":"鬱林","kind":"person","person_id":"iop_ybd_afm","status":"contextual_provisional","interpretation_note":"原文具名或局部代稱；身份依全傳及具體來源橋接，不按同字跨世代配人。","identity_decision_id":"d-nanqi043-xieyue-yulin"},{"id":"c-nanqishu-043-xieyue:p005:m0020","start":20,"end":22,"surface":"左右","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"未名角色/群體，未找到足夠證據唯一定位；不造名字或合併匿名人。"},{"id":"c-nanqishu-043-xieyue:p005:m0025","start":25,"end":26,"surface":"𤅢","kind":"person","person_id":"aa6_83c_juy_DBABAC","status":"contextual_provisional","interpretation_note":"原文具名或局部代稱；身份依全傳及具體來源橋接，不按同字跨世代配人。","identity_decision_id":"d-nanqi043-xieyue-yue"},{"id":"c-nanqishu-043-xieyue:p005:m0028","start":28,"end":29,"surface":"客","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"未名角色/群體，未找到足夠證據唯一定位；不造名字或合併匿名人。"},{"id":"c-nanqishu-043-xieyue:p005:m0060","start":60,"end":62,"surface":"明帝","kind":"person","person_id":"w4m_9tw_147","status":"contextual_provisional","interpretation_note":"原文具名或局部代稱；身份依全傳及具體來源橋接，不按同字跨世代配人。","identity_decision_id":"d-nanqi043-xieyue-mingdi"},{"id":"c-nanqishu-043-xieyue:p005:m0065","start":65,"end":66,"sur