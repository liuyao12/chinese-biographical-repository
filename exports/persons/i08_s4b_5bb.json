on_note":"依本段實名及敘述視點。","start":22,"end":24,"surface":"王晏"},{"id":"c-nanqishu-023-wangjian:p012:m0026","person_id":"7r6_k52_qji_ABAAAAEAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段實名及敘述視點。","start":26,"end":27,"surface":"儉"},{"id":"c-nanqishu-023-wangjian:p012:m0034","person_id":"7r6_k52_qji_ABAAAAEAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段實名及敘述視點。","start":34,"end":35,"surface":"儉"}],"source_position":{"revision_id":1545488,"first_line":85,"last_line":85,"raw_start":6641,"raw_end":6759,"line_start":0,"line_end":118,"source_layer":"received_biography"},"chapter_id":"c-nanqishu-023-wangjian","book_id":"b-nanqishu-023","work_id":"w-nanqishu","source_id":"s-nanqishu-023-wangjian-ws1545488"},{"id":"c-nanqishu-043-xieyue:p005","unit_id":"xieyue-complete","text":"服闋，爲吏部尚書。高宗廢鬱林，領兵入殿，左右驚走報𤅢。與客圍棊，每下子，輙云「其當有意」。竟局，乃還齋卧，竟不問外事也。明帝卽位，𤅢又屬疾不視事。後上讌會，功臣上酒，尚書令王晏等興席，𤅢獨不起，曰：「陛下受命，應天從民，王晏妄叨天功以爲己力。」上大笑解之。座罷，晏呼𤅢共載還令省，欲相撫悅。又正色曰：「君巢窟在何處？」晏初得班劔，𤅢謂之曰：「身家太傅裁得六人。君亦何事一朝至此。」晏甚憚之。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","source_position":{"first_line":61,"last_line":61,"revision_id":2400356,"editorial_excerpt_boundary":true},"mentions":[{"id":"c-nanqishu-043-xieyue:p005:m0009","start":9,"end":11,"surface":"高宗","kind":"person","person_id":"w4m_9tw_147","status":"contextual_provisional","interpretation_note":"原文具名或局部代稱；身份依全傳及具體來源橋接，不按同字跨世代配人。","identity_decision_id":"d-nanqi043-xieyue-mingdi"},{"id":"c-nanqishu-043-xieyue:p005:m0012","start":12,"end":14,"surface":"鬱林","kind":"person","person_id":"iop_ybd_afm","status":"contextual_provisional","interpretation_note":"原文具名或局部代稱；身份依全傳及具體來源橋接，不按同字跨世代配人。","identity_decision_id":"d-nanqi043-xieyue-yulin"},{"id":"c-nanqishu-043-xieyue:p005:m0020","start":20,"end":22,"surface":"左右","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"未名角色/群體，未找到足夠證據唯一定位；不造名字或合併匿名人。"},{"id":"c-nanqishu-043-xieyue:p005:m0025","start":25,