sertions":[{"id":"pa-nanshi059-sengru-9-54","person_id":"re3_grx_ei8","relation":"biographical_origin","place":{"source_name":"吳興","place_id":null,"modern_identification":null},"source_term":"丘令楷，吳興人","status":"source_attested","date_expression":null,"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-059","source_id":"s-nanshi-059-wangsengru-ws1553912","chapter_id":"c-nanshi-059-wangsengru","paragraph_id":"c-nanshi-059-wangsengru:p009","quote":"虞羲字士光，會稽余姚人，盛有才藻，卒于晉安王侍郎。丘國賓，吳興人，以才志不遇，著書以譏揚雄。蕭文琰，蘭陵人。丘令楷，吳興人。江洪，濟陽人。竟陵王子良嘗夜集學士，刻燭為詩，四韻者則刻一寸，以此為率。文琰曰：「頓燒一寸燭，而成四韻詩，何難之有。」乃與令楷、江洪等共打銅缽立韻，響滅則詩成，皆可觀覽。劉孝孫，彭城人，博學通敏，而仕多不遂，常歎曰：「古人或開一說而致卿相，立談間而降白璧，書籍妄耳。」徐夤，高平人，有學行。父榮祖位秘書監，嘗有罪繫獄，旦日原之，而發皓白。齊武問其故，曰：「臣思愆於內，而發變於外。」當時稱之。","person_mention_id":"c-nanshi-059-wangsengru:p009:m0054"}],"interpretation_note":"本傳直載郡縣或郡望，保留其稱。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanshi-059-wangsengru:p003","text":"仕齊為太學博士，尚書僕射王晏深相賞好。晏為丹陽尹，召補功曹，使撰東宮新記。司徒竟陵王子良開西邸，招文學，僧孺與太學生虞羲、丘國賓、蕭文琰、丘令楷、江洪、劉孝孫並以善辭藻遊焉。而僧孺與高平徐夤俱為學林。文惠太子欲以為宮僚，乃召入直崇明殿。會薨，出為晉安郡丞，仍除候官令。建武初舉士，為始安王遙光所薦，除儀曹郎，遷書侍御史，出為錢唐令。初僧孺與樂安任昉遇于竟陵王西邸，以文學會友，及將之縣，昉贈詩曰：「唯子見知，唯餘知子，觀行視言，要終猶始。敬之重之，如蘭如芷，形應影隨，曩行今止。百行之首，立人斯著，子之有之，誰毀誰譽。修名既立，老至何遽，誰其執鞭，吾為子禦。劉略班藝，虞志荀錄，伊昔有懷，交相欣勖。下帷無倦，升高有屬，嘉爾晨登，惜餘夜燭。」其為士友推重如此。","mentions":[{"id":"c-nanshi-059-wangsengru:p003:m0012","surface":"王晏","start":12,"end":14,"person_id":"i08_s4b_5bb","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0019","surface":"晏","start":19,"end":20,"person_id":"i08_s4b_5bb","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0042","surface":"子良","start":42,"end":44,"person_id":"x3q_cqm_dup","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0052","surface":"僧孺","start":52,"end":54,"person_id":"59d_72d_924_AAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0058","surface":"虞羲","start":58,"end":60,"person_id":"ziv_5l7_sp6","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0061","surface":"丘國賓","start":61,"end":64,"person_id":"gdr_uqp_pps","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0065","surface":"蕭文琰","start":65,"end":68,"person_id":"dvz_fqs_wbq","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0069","surface":"丘令楷","start":69,"end":72,"person_id":"re3_grx_ei8","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0073","surface":"江洪","start":73,"end":75,"person_id":"u3l_j15_ybs","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0076","surface":"劉孝孫","start":76,"end":79,"person_id":"x9x_svk_kwg","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0088","surface":"僧孺","start":88,"end":90,"person_id":"59d_72d_924_AAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0093","surface":"徐夤","start":93,"end":95,"person_id":"1up_vyo_s9g_A","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0144","surface":"遙光","start":144,"end":146,"person_id":"98q_mll_d6v_AA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0167","surface":"僧孺","start":167,"end":169,"pe