ru:p001"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-083-luzou","s-shiji112-pingjin","s-shiji117-xiangru"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-083-luzou:m015-0023","start":23,"end":25,"surface":"枚生","kind":"person","person_id":"e1m_xt0_8w7","status":"contextual_provisional","paragraph_id":"c-shiji-083-luzou:p015","chapter_id":"c-shiji-083-luzou"},{"id":"c-shiji-112-pingjin:m030-0092","start":92,"end":94,"surface":"枚生","kind":"person","person_id":"e1m_xt0_8w7","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p030","chapter_id":"c-shiji-112-pingjin"},{"id":"c-shiji-117-xiangru:m001-0103","start":103,"end":105,"surface":"枚乘","kind":"person","person_id":"e1m_xt0_8w7","status":"contextual_provisional","paragraph_id":"c-shiji-117-xiangru:p001","chapter_id":"c-shiji-117-xiangru"}],"relations":[],"title_holdings":[],"address_assertions":[{"id":"pa-shiji117-003","person_id":"e1m_xt0_8w7","relation":"biographical_origin","place":{"source_name":"淮陰","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-117-xiangru","source_id":"s-shiji117-xiangru","paragraph_id":"c-shiji-117-xiangru:p001","quote":"司馬相如者，蜀郡成都人也，字長卿。少時好讀書，學擊劍，故其親名之曰犬子。相如既學，慕藺相如之為人，更名相如。以貲為郎，事孝景帝，為武騎常侍，非其好也。會景帝不好辭賦，是時梁孝王來朝，從遊說之士齊人鄒陽、淮陰枚乘、吳莊忌夫子之徒，相如見而說之，因病免，客游梁。梁孝王令與諸生同舍，相如得與諸生游士居數歲，乃著子虛之賦。"}],"source_term":"淮陰枚乘","interpretation_note":"來源人地稱謂，保留原字與地名範圍；不推出生地或現代轄區。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji083-036","person_id":"e1m_xt0_8w7","scope":"same_chapter","chapter_ids":["c-shiji-083-luzou"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"按獄中上書引古與梁廷敘事分層，保留原稱。枚生及衛先生未以記憶補姓名；王奢不改作趙奢。燕丹與丹限荊軻句群，臣與大王限鄒陽對梁孝王的上書。","surfaces":["枚生"],"evidence":[{"paragraph_id":"c-shiji-083-luzou:p015","quote":"鄒陽者，齊人也。游於梁，與故吳人莊忌夫子、淮陰枚生之徒交。上書而介於羊勝、公孫詭之閒。勝等嫉鄒陽，惡之梁孝王。孝王怒，下之吏，將欲殺之。鄒陽客游，以讒見禽，恐死而負累，乃從獄中上書曰："}]}],"equivalence_decisions":[{"id":"eq-shiji112-panegyric-meisheng","person_ids":["e1m_xt0_8w7"],"canonical_person_id":"e1m_xt0_8w7","status":"contextual_provisional","scope":"cross_chapter","chapter_ids":["c-shiji-112-pingjin","c-shiji-117-xiangru"],"evidence":[{"chapter_id":"c-shiji-112-pingjin","source_id":"s-shiji112-pingjin","paragraph_id":"c-shiji-112-pingjin:p030","quote":"班固稱曰：公孫弘、卜式、兒寬皆以鴻漸之翼困於燕雀，遠跡羊豕之閒，非遇其時，焉能致此位乎？是時漢興六十餘載，海內乂安，府庫充實，而四夷未賓，制度多闕，上方欲用文武，求之如弗及。始以蒲輪迎枚生，見主父而嘆息。群臣慕向，異人并出。卜式試於芻牧，弘羊擢於賈豎，衛青奮於奴仆，日磾出於降虜，斯亦曩時版筑飯牛之朋矣。漢之得人，於茲為盛。儒雅則公孫弘、董仲舒、兒寬，篤行則石建、石慶，質直則汲黯、卜式，推賢則韓安國、鄭當時，定令則趙禹、張湯，文章則司馬遷、相如，滑稽則東方朔、枚皋，應對則嚴助、朱買臣，歷數則唐都、落下閎，協律則李延年，運籌則桑弘羊，奉使則張騫、蘇武，將帥則衛青、霍去病，受遺則霍光、金日磾。其餘不可勝紀。是以興造功業，制度遺文，後世莫及。孝宣承統，纂修洪業，亦講論六藝，招選茂異，而蕭望之、梁丘賀、夏侯勝、韋玄成、嚴彭祖、尹更始以儒術進，劉向、王褒以文章顯。將相則張安世、趙充國、魏相、邴吉、于定國、杜延年，治民則黃霸、王成、龔遂、鄭弘、邵信臣、韓延壽、尹翁歸、趙廣漢之屬，皆有功跡見述於後。累其名臣，亦其次也。","mention_ids":["c-shiji-112-pingjin:m030-0092"],"text_layer":"witness_appended_bangu_note"},{"chapter_id":"c-shiji-117-xiangru","source_id":"s-shiji117-xiangru","paragraph_id":"c-shiji-117-xiangru:p001","quote":"司馬相如者，蜀郡成都人也，字長卿。少時好讀書，學擊劍，故其親名之曰犬子。相如既學，慕藺相如之為人，更名相如。以貲為郎，事孝景帝，為武騎常侍，非其好也。會景帝不好辭賦，是時梁孝王來朝，從遊說之士齊人鄒陽、淮陰枚乘、吳莊忌夫子之徒，相如見而說之，因病免，客游梁。梁孝王令與諸生同舍，相如得與諸生游士居數歲，乃著子虛之賦。","mention_ids":["c-shiji-117-xiangru:m001-0103"],"text_layer":"received_chapter"}],"references":[{"title":"《前漢書》卷五十一（文淵閣數位見證）","url":"https://github.com/kanripo/KR2a0007/blob/683113d4baf6febecaf2ccb7913df87c4d68d454/KR2a0007_051.txt#L604-L606","quote":"安車蒲輪徴乘","raw_quote":"乘歸淮隂武帝自為太子聞乘名及即位乘年老廼以¶\n安車蒲輪徴乘(師古曰蒲輪以蒲裹輪○/宋祁曰注末當有也字)道死(師古曰/在道病)¶\n(死/也)詔問乘子無能為文者後廼得其孽子臯(師古曰/孽庶也)臯¶","scope":"same_imperial_summons_not_son","image_verified":false,"response_sha256":"385b55433cb345483bdc1c643abab6fe86e7ad3c291d871ca5e5e15e66f6d3e6","source_blob_sha":"92416f8920f5ce475fc78664fef6a92a143f4429","response_extent":{"first_line":520,"last_line":650,"partial_file":true},"note":"quote為原行連續字，不改字；raw_quote保留原行與注。雜湊只指部分回應，不是全檔指紋，未核書影。"}],"rationale":"附贊蒲輪迎枚生，漢書51明武帝即位以安車蒲輪徴乘，與司馬相如傳梁孝王客淮陰枚乘暫接。漢書隨後另敘其子皋，不將枚生接枚皋，不由附贊推生卒年。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true},{"id":"eq-shiji117-opening-meisheng","person_ids":["e1m_xt0_8w7"],"canonical_person_id":"e1m_xt0_8w7","scope":"cross_chapter","chapter_ids":["c-shiji-117-xiangru","c-shiji-083-luzou"],"status":"contextual_provisional","confidence_level":"high","evidence":[{"chapter_id":"c-shiji-117-xiangru","source_id":"s-shiji117-xiangru","paragraph_id":"c-shiji-117-xiangru:p001","quote":"司馬相如者，蜀郡成都人也，字長卿。少時好讀書，學擊劍，故其親名之曰犬子。相如既學，慕藺相如之為人，更名相如。以貲為郎，事孝景帝，為武騎常侍，非其好也。會景帝不好辭賦，是時梁孝王來朝，從遊說之士齊人鄒陽、淮陰枚乘、吳莊忌夫子之徒，相如見而說之，因病免，客游梁。梁孝王令與諸生同舍，相如得與諸生游士居數歲，乃著子虛之賦。","mention_ids":["c-shiji-117-xiangru:m001-0103"]},{"chapter_id":"c-shiji-083-luzou","source_id":"s-shiji-083-luzou","paragraph_id":"c-shiji-083-luzou:p015","quote":"鄒陽者，齊人也。游於梁，與故吳人莊忌夫子、淮陰枚生之徒交。上書而介於羊勝、公孫詭之閒。勝等嫉鄒陽，惡之梁孝王。孝王怒，下之吏，將欲殺之。鄒陽客游，以讒見禽，恐死而負累，乃從獄中上書曰：","mention_ids":["c-shiji-083-luzou:m015-0023"]}],"rationale":"鄒陽篇淮陰枚生與本篇淮陰枚乘，同列梁客鄒陽及吳莊忌夫子；依籍里、活動及同伴接合，不將所有枚姓短稱全域合併。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true}],"identity_distinctions":[{"id":"distinct-shiji112-meicheng-meigao","person_ids":["e1m_xt0_8w7","f16_k0n_4q2"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-112-pingjin:p030","quote":"班固稱曰：公孫弘、卜式、兒寬皆以鴻漸之翼困於燕雀，遠跡羊豕之閒，非遇其時，焉能致此位乎？是時漢興六十餘載，海內乂安，府庫充實，而四夷未賓，制度多闕，上方欲用文武，求之如弗及。始以蒲輪迎枚生，見主父而嘆息。群臣慕向，異人并出。卜式試於芻牧，弘羊擢於賈豎，衛青奮於奴仆，日磾出於降虜，斯亦曩時版筑飯牛之朋矣。漢之得人，於茲為盛。儒雅則公孫弘、董仲舒、兒寬，篤行則石建、石慶，質直則汲黯、卜式，推賢則韓安國、鄭當時，定令則趙禹、張湯，文章則司馬遷、相如，滑稽則東方朔、枚皋，應對則嚴助、朱買臣，歷數則唐都、落下閎，協律則李延年，運籌則桑弘羊，奉使則張騫、蘇武，將帥則衛青、霍去病，受遺則霍光、金日磾。其餘不可勝紀。是以興造功業，制度遺文，後世莫及。孝宣承統，纂修洪業，亦講論六藝，招選茂異，而蕭望之、梁丘賀、夏侯勝、韋玄成、嚴彭祖、尹更始以儒術進，劉向、王褒以文章顯。將相則張安世、趙充國、魏相、邴吉、于定國、杜延年，治民則黃霸、王成、龔遂、鄭弘、邵信臣、韓延壽、尹翁歸、趙廣漢之屬，皆有功跡見述於後。累其名臣，亦其次也。","chapter_id":"c-shiji-112-pingjin","work_id":"w-shiji","book_id":"b-shiji-112","source_id":"s-shiji112-pingjin"}],"references":[{"title":"《前漢書》卷五十一（文淵閣數位見證）","url":"https://github.com/kanripo/KR2a0007/blob/683113d4baf6febecaf2ccb7913df87c4d68d454/KR2a0007_051.txt#L604-L606","quote":"安車蒲輪徴乘","raw_quote":"乘歸淮隂武帝自為太子聞乘名及即位乘年老廼以¶\n安車蒲輪徴乘(師古曰蒲輪以蒲裹輪○/宋祁曰注末當有也字)道死(師古曰/在道病)¶\n(死/也)詔問乘子無能為文者後廼得其孽子臯(師古曰/孽庶也)臯¶","scope":"same_imperial_summons_not_son","image_verified":false,"response_sha256":"385b55433cb345483bdc1c643abab6fe86e7ad3c291d871ca5e5e15e66f6d3e6","source_blob_sha":"92416f8920f5ce475fc78664fef6a92a143f4429","response_extent":{"first_line":520,"last_line":650,"partial_file":true},"note":"quote為原行連續字，不改字；raw_quote保留原行與注。雜湊只指部分回應，不是全檔指紋，未核書影。"}],"rationale":"本段蒲輪迎枚生與滑稽枚皋分列。漢書51安車蒲輪徴乘，續述詔問乘子後得其孽子皋，故暫分枚乘與枚皋，不以枚姓或枚生同字混合。此只作身份區分；未新增無正文段落支持的父子斷言。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-083-luzou:p015","text":"鄒陽者，齊人也。游於梁，與故吳人莊忌夫子、淮陰枚生之徒交。上書而介於羊勝、公孫詭之閒。勝等嫉鄒陽，惡之梁孝王。孝王怒，下之吏，將欲殺之。鄒陽客游，以讒見禽，恐死而負累，乃從獄中上書曰：","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-083-luzou:m015-0000","start":0,"end":2,"surface":"鄒陽","kind":"person","person_id":"06n_ttw_xgt","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m015-0016","start":16,"end":20,"surface":"莊忌夫子","kind":"person","person_id":"g8d_9kf_uqg","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m015-0023","start":23,"end":25,"surface":"枚生","kind":"person","person_id":"e1m_xt0_8w7","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m015-0025","start":25,"end":2