},{"id":"c-shiji-118-huainan:m011-0007","start":7,"end":10,"surface":"淮南王","kind":"person","person_id":"yqp_nlb_p1p_AF","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m011-0011","start":11,"end":14,"surface":"淮南王","kind":"person","person_id":"yqp_nlb_p1p_AF","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m011-0015","start":15,"end":18,"surface":"子四人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-118-huainan:m011-0026","start":26,"end":28,"surface":"子安","kind":"person","person_id":"yqp_nlb_p1p_AFA","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m011-0033","start":33,"end":35,"surface":"子勃","kind":"person","person_id":"yqp_nlb_p1p_AFB","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m011-0040","start":40,"end":42,"surface":"子賜","kind":"person","person_id":"yqp_nlb_p1p_AFC","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m011-0047","start":47,"end":49,"surface":"子良","kind":"person","person_id":"yqp_nlb_p1p_AFD","status":"contextual_provisional"}],"chapter_id":"c-shiji-118-huainan","book_id":"b-shiji-118","work_id":"w-shiji","source_id":"s-shiji118-huainan"},{"id":"c-shiji-118-huainan:p012","text":"孝文十二年，民有作歌歌淮南厲王曰：「一尺布，尚可縫；一斗粟，尚可舂。兄弟二人不能相容。」上聞之，乃嘆曰：「堯舜放逐骨肉，周公殺管蔡，天下稱聖。何者？不以私害公。天下豈以我為貪淮南王地邪？」乃徙城陽王王淮南故地，而追尊謚淮南王為厲王，置園復如諸侯儀。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-118-huainan:m012-0000","start":0,"end":2,"surface":"孝文","kind":"person","person_id":"wef_drj_j44","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m012-0011","start":11,"end":15,"surface":"淮南厲王","kind":"person","person_id":"yqp_nlb_p1p_AF","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m012-0034","start":34,"end":38,"surface":"兄弟二人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-118-huainan:m012-0044","start":44,"end":45,"surface":"上","kind":"person","person_id":"wef_drj_j44","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m012-0053","start":53,"end":54,"surface":"堯","kind":"person","person_id":"3rn_zwc_d5j","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m012-0054","start":54,"end":55,"surface":"舜","kind":"person","person_id":"a8k_u91_d8m","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m012-0060","start":60,"end":62,"surface":"周公","kind":"person","person_id":"l6h_c2o_giv","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m012-0063","start":63,"end":64,"surface":"管","kind":"person","person_id":"wkq_pb7_afj","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m012-0064","start":64,"end":65,"surface":"蔡","kind":"person","person_id":"won_vq8_gwj","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m012-0087","start":87,"end":90,"surface":"淮南王","kind":"person","person_id":"yqp_nlb_p1p_AF","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m012-0096","start":96,"end":99,"surface":"城陽王","kind":"person","person_id":"f6m_8uv_uww","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m012-0109","start":109,"end":112,"surface":"淮南王","kind":"person","person_id":"yqp_nlb_p1p_AF","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m012-0113","start":113,"end":115,"surface":"厲王","kind":"person","person_id":"yqp_nlb_p1p_AF","status":"contextual_provisional"}],"chapter_id":"c-shiji-118-huainan","book_id":"b-shiji-118","work_id":"w-shiji","source_id":"s-shiji118-huainan"},{"id":"c-shiji-118-huainan:p013","text":"孝文十六年，徙淮南王喜復故城陽。上憐淮南厲王廢法不軌，自使失國蚤死，乃立其三子：阜陵侯安為淮南王，安陽侯勃為衡山王，陽周侯賜為廬江王，皆復得厲王時地，參分之。東城侯良前薨，無後也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-118-huainan:m013-0000","start":0,"end":2,"surface":"孝文","kind":"person","person_id":"wef_drj_j44","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m013-0007","start":7,"end":11,"surface":"淮南王喜","kind":"person","person_id":"f6m_8uv_uww","status":"contextual_provisional"},{"id":"c-