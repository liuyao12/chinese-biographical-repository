m005-0004","start":4,"end":5,"surface":"朕","kind":"person","person_id":"wef_drj_j44","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m005-0010","start":10,"end":11,"surface":"王","kind":"person","person_id":"yqp_nlb_p1p_AF","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m005-0014","start":14,"end":16,"surface":"列侯","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-118-huainan:m005-0016","start":16,"end":19,"surface":"二千石","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-118-huainan","book_id":"b-shiji-118","work_id":"w-shiji","source_id":"s-shiji118-huainan"},{"id":"c-shiji-118-huainan:p006","text":"「臣倉、臣敬、臣逸、臣福、臣賀昧死言：臣謹與列侯吏二千石臣嬰等四十三人議，皆曰『長不奉法度，不聽天子詔，乃陰聚徒黨及謀反者，厚養亡命，欲以有為』。臣等議論如法。」","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-118-huainan:m006-0001","start":1,"end":3,"surface":"臣倉","kind":"person","person_id":"d8n_9iq_w4h","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m006-0004","start":4,"end":6,"surface":"臣敬","kind":"person","person_id":"74s_z7l_t28","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m006-0007","start":7,"end":9,"surface":"臣逸","kind":"person","person_id":"vhn_2qv_ziz","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m006-0010","start":10,"end":12,"surface":"臣福","kind":"person","person_id":"nzy_rlh_hfw","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m006-0013","start":13,"end":15,"surface":"臣賀","kind":"person","person_id":"nqg_1hv_y1j","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m006-0022","start":22,"end":24,"surface":"列侯","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-118-huainan:m006-0028","start":28,"end":30,"surface":"臣嬰","kind":"person","person_id":"ixa_izg_wta","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m006-0031","start":31,"end":35,"surface":"四十三人","kind":"unresolved","person_id":null,"statu