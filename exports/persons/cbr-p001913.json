{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p001913","identity_policy":"contextual_provisional","person_ids":["cbr-p001913"],"persons":[{"id":"cbr-p001913","label":"曼成然（告初王者）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"曼成然","mention_ids":["c-shiji-040-chu:m037-0122"]}],"evidence":[{"mention_id":"c-shiji-040-chu:m037-0122","chapter_id":"c-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p037","quote":"曼成然"}]}],"mentions":[{"id":"c-shiji-040-chu:m037-0122","start":122,"end":125,"surface":"曼成然","kind":"person","person_id":"cbr-p001913","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p037","chapter_id":"c-shiji-040-chu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-040-chu:p037","text":"是時楚國雖已立比爲王，畏靈王復來，又不聞靈王死，故觀從謂初王比曰：「不殺棄疾，雖得國猶受禍。」王曰：「余不忍。」從曰：「人將忍王。」王不聽，乃去。棄疾歸。國人毎夜驚，曰：「靈王入矣！」乙卯夜，棄疾使船人從江上走呼曰：「靈王至矣！」國人愈驚。又使曼成然告初王比及令尹子皙曰：「王至矣！國人將殺君，司馬將至矣！君蚤自圖，無取辱焉。衆怒如水火，不可救也。」初王及子皙遂自殺。丙辰，棄疾卽位爲王，改名熊居，是爲平王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m037-0007","start":7,"end":8,"surface":"比","kind":"person","person_id":"cbr-p001890","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m037-0012","start":12,"end":14,"surface":"靈王","kind":"person","person_id":"cbr-p001889","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m037-0020","start":20,"end":22,"surface":"靈王","kind":"person","person_id":"cbr-p001889","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m037-0025","start":25,"end":27,"surface":"觀從","kind":"person","person_id":"cbr-p001909","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m037-0028","start":28,"end":31,"surface":"初王比","kind":"person","person_id":"cbr-p001890","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m037-0036","start