],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji046-039","person_id":"rwc_uls_sr7","surfaces":["御鞅"],"scope":"same_chapter","chapter_ids":["c-shiji-046-tian"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-046-tian:p012","quote":"鮑牧與齊悼公有郄，弒悼公。齊人共立其子壬，是爲簡公。田常成子與監止倶爲左右相，相簡公。田常心害監止，監止幸於簡公，權弗能去。於是田常復修釐子之政，以大斗出貸，以小斗收。齊人歌之曰：「嫗乎采芑，歸乎田成子！」齊大夫朝，御鞅諫簡公曰：「田、監不可并也，君其擇焉。」君弗聽。"},{"paragraph_id":"c-shiji-046-tian:p014","quote":"簡公出奔，田氏之徒追執簡公于徐州。簡公曰：「蚤從御鞅之言，不及此難。」田氏之徒恐簡公復立而誅己，遂殺簡公。簡公立四年而殺。於是田常立簡公弟驁，是爲平公。平公卽位，田常爲相。"}],"rationale":"限本篇明示姓名、是為、繼位及局部事件暫接；姜齊與田齊桓公、不同時段未名王及同字忌分開。孫子不先補孫臏，子守髙唐不補闕字，索隱短稱與代詞仍待核；未跨篇按同名接人。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-046-tian:p012","text":"鮑牧與齊悼公有郄，弒悼公。齊人共立其子壬，是爲簡公。田常成子與監止倶爲左右相，相簡公。田常心害監止，監止幸於簡公，權弗能去。於是田常復修釐子之政，以大斗出貸，以小斗收。齊人歌之曰：「嫗乎采芑，歸乎田成子！」齊大夫朝，御鞅諫簡公曰：「田、監不可并也，君其擇焉。」君弗聽。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-046-tian:m012-0000","start":0,"end":2,"surface":"鮑牧","kind":"person","person_id":"nka_xcg_d5x","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m012-0003","start":3,"end":6,"surface":"齊悼公","kind":"person","person_id":"yht_8tu_hv4_B","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m012-0010","start":10,"end":12,"surface":"悼公","kind":"person","person_id":"yht_8tu_hv4_B","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m012-0019","start":19,"end":20,"surface":"壬","kind":"person","person_id":"yht_8tu_hv4_BA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m012-0023","start":23,"end":25,"surface":"簡公","kind":"person","person_id":"yht_8tu_hv4_BA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m012-0026","start":26,"end":30,"surface":"田常成子","kind":"person","person_id":"zan_qcc_jy5_AAAAAABA","status":"contextual_provisional"},{