53-zhanghong:line018:m0174","start":174,"end":176,"surface":"孫策","kind":"person","person_id":"e9c_070_567","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"}],"annotation_status":"reviewed","source_position":{"first_line":18,"last_line":18,"revision_id":2086397,"raw_start":2349,"raw_end":2970,"character_positions":[2349,2350,2351,2352,2353,2354,2355,2356,2357,2358,2359,2360,2560,2561,2562,2563,2564,2565,2566,2567,2568,2569,2570,2571,2572,2599,2600,2601,2602,2623,2624,2625,2626,2627,2628,2629,2630,2631,2632,2633,2634,2635,2636,2637,2638,2639,2640,2641,2642,2643,2644,2645,2646,2647,2648,2649,2650,2651,2652,2653,2654,2655,2656,2657,2658,2659,2660,2661,2662,2663,2664,2665,2666,2667,2668,2669,2670,2671,2672,2673,2674,2675,2676,2677,2678,2679,2680,2681,2682,2683,2684,2685,2686,2687,2688,2689,2690,2691,2692,2693,2694,2695,2696,2697,2698,2699,2700,2701,2702,2703,2704,2705,2706,2707,2708,2709,2710,2711,2712,2713,2714,2715,2716,2717,2718,2719,2720,2721,2722,2723,2724,2725,2726,2727,2728,2729,2730,2921,2922,2923,2924,2925,2926,2927,2928,2929,2930,2931,2932,2933,2934,2935,2936,2937,2938,2939,2940,2941,2942,2943,2944,2945,2946,2947,2948,2949,2950,2951,2952,2953,2954,2955,2956,2957,2958,2959,2960,2961,2962,2963,2964,2965,2966,2967,2968,2969]},"chapter_id":"c-sanguozhi-053-zhanghong","book_id":"b-sanguozhi-053","work_id":"w-sanguozhi","source_id":"s-sanguozhi-053-zhanghong"},{"id":"c-sanguozhi-054-zhouyu:line029-pei01-01","text":"《江表傳》曰：普頗以年長，數陵侮瑜。瑜折節容下，終不與校。普後自敬服而親重之，乃告人曰：「與周公瑾交，若飲醇醪，不覺自醉。」時人以其謙讓服人如此。初曹公聞瑜年少有美才，謂可遊說動也，乃密下揚州，遣九江蔣幹往見瑜。幹有儀容，以才辯見稱，獨步江、淮之間，莫與為對。乃布衣葛巾，自託私行詣瑜。瑜出迎之，立謂幹曰：「子翼良苦，遠涉江湖為曹氏作說客邪？」幹曰：「吾與足下州里，中間別隔，遙聞芳烈，故來敘闊，並觀雅規，而云說客，無乃逆詐乎？」瑜曰：「吾雖不及夔、曠，聞弦賞音，足知雅曲也。」因延幹入，為設酒食。畢，遣之曰：「適吾有密事，且出就館，事了，別自相請。」後三日，瑜請幹與周觀營中，行視倉庫軍資器仗訖，還宴飲，示之侍者服飾珍玩之物，因謂幹曰：「丈夫處世，遇知己之主，外託君臣之義，內結骨肉之恩，言行計從，禍福共之，假使蘇張更生，酈叟復出，猶撫其背而折其辭，豈足下幼生所能移乎？」幹但笑，終無所言。幹還，稱瑜雅量高致，非言辭所間。中州之士，亦以此多之。劉備之自京還也，權乘飛雲大船，與張昭、秦松、魯肅等十餘人共追送之，大宴會敘別。昭、肅等先出，權獨與備留語，因言次，嘆瑜曰：「公瑾文武籌略，萬人之英，顧其器量廣大，恐不久為人臣耳。」瑜之破魏軍也，曹公曰：「孤不羞走。」後書與權曰：「赤壁之役，值有疾病，孤燒船自退，橫使周瑜虛獲此名。」瑜威聲遠著，故曹公、劉備咸欲疑譖之。及卒，權流涕曰：「公瑾有王佐之資，今忽短命，孤何賴哉！」後權稱尊號，謂公卿曰：「孤非周公瑾，不帝矣。」","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-054-zhouyu:line029-pei01-01:m0007","start":7,"end":8,"surface":"普","kind":"person","person_id":"p6n_a0q_flh","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-zhouyu:line029-pei01-01:m0016","start":16,"end":17,"surface":"瑜","kind":"person","person_id":"f56_938_997","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-zhouyu:line029-pei01-01:m0018","start":18,"end":19,"surface":"瑜","kind":"person","person_id":"f56_938_997","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-zhouyu:line029-pei01-01:m0029","start":29,"end":30,"surface":"普","kind":"person","person_id":"p6n_a0q_flh","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-zhouyu:line029-pei01-01:m0046","start":46,"end":49,"surface":"周公瑾","kind":"person","person_id":"f56_938_997","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-zhouyu:line029-pei01-01:m0074","start":74,"end":76,"surface":"曹公","kind":"person","person_id":"dad_b77_b38","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-zhouyu:line029-pei01-01:m0077","start":77,"end":78,"surface":"瑜","kind":"person","person_id":"f56_938_997","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-zhouyu:line029-pei01-01:m0100","start":100,"end":102,"surface":"蔣幹","kind":"person","person_id":"bd0_fc7_d6f","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-zhouyu:line029-pei01-01:m0104","start":104,"end":105,"surface":"瑜","kind":"person","person_id":"f56_938_997","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-0