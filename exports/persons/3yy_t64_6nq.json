sanguozhi-064-puyangxing-complete:p001","text":"　　濮陽興字子元，陳留人也。父逸，漢末避亂江東，官至長沙太守。興少有士名，孫權時除上虞令，稍遷至尚書左曹，以五官中郎將使蜀，還為會稽太守。時琅邪王休居會稽，興深與相結。及休即位，徵興為太常衛將軍、平軍國事，封外黃侯。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":98,"last_line":98,"raw_start":13534,"raw_end":13672,"raw_character_offsets":[13534,13535,13536,13537,13538,13539,13540,13541,13542,13543,13544,13545,13546,13547,13548,13549,13550,13551,13552,13553,13554,13555,13556,13557,13558,13559,13560,13561,13562,13563,13564,13595,13596,13597,13598,13599,13600,13601,13602,13603,13604,13605,13606,13607,13608,13609,13610,13611,13612,13613,13614,13615,13616,13617,13618,13619,13620,13621,13622,13623,13624,13625,13626,13627,13628,13629,13630,13631,13632,13633,13634,13635,13636,13637,13638,13639,13640,13641,13642,13643,13644,13645,13646,13647,13648,13649,13650,13651,13652,13653,13654,13655,13656,13657,13658,13659,13660,13661,13662,13663,13664,13665,13666,13667,13668,13669,13670,13671],"revision_id":2263487},"mentions":[{"id":"c-sanguozhi-064-puyangxing-complete:p001:m0002","surface":"濮陽興","start":2,"end":5,"kind":"person","person_id":"u44_7nr_99a","status":"contextual_provisional"},{"id":"c-sanguozhi-064-puyangxing-complete:p001:m0006","surface":"子元","start":6,"end":8,"kind":"person","person_id":"u44_7nr_99a","status":"contextual_provisional"},{"id":"c-sanguozhi-064-puyangxing-complete:p001:m0015","surface":"逸","start":15,"end":16,"kind":"person","person_id":"3yy_t64_6nq","status":"contextual_provisional"},{"id":"c-sanguozhi-064-puyangxing-complete:p001:m0031","surface":"興","start":31,"end":32,"kind":"person","person_id":"u44_7nr_99a","status":"contextual_provisional"},{"id":"c-sanguozhi-064-puyangxing-complete:p001:m0037","surface":"孫權","start":37,"end":39,"kind":"person","person_id":"572_278_cba","status":"contextual_provisional"},{"id":"c-sanguozhi-064-puyangxing-complete:p001:m0073","surface":"休","start":73,"end":74,"kind":"person","person_id":"0fo_c5c_4yh","status":"contextual_prov