urrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-qi055-wangli-wife","subject_person_id":"29c_p9s_xo8","object_person_id":"ktr_d0k_prp","predicate":"spouse","qualifiers":{"source_term":"王禮妻徐氏"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-055","chapter_id":"c-nanqishu-055-filial-complete","source_id":"s-nanqishu-055-filial-complete-ws1545598","paragraph_id":"c-nanqishu-055-filial-complete:p014","quote":"　　永明元年，會稽永興倪翼之母丁氏，少喪夫，性仁愛，遭年荒，分衣食以飴里中饑餓者，隣里求借，未嘗違。同里陳穰父母死，孤單無親戚，丁氏收養之，及長，爲營婚娶。又同里王禮妻徐氏，荒年客死山陰，丁爲買棺器，自往歛葬。元徽末，大雪，商旅斷行，村里比屋饑餓，丁自出鹽米，計口分賦。同里左僑家露四喪，無以葬，丁爲辦塚槨。有三調不登者，代爲輸送。丁長子婦王氏守寡執志不再醮。州郡上言，詔表門閭，蠲租稅。","subject_person_mention_id":"c-nanqishu-055-filial-complete:p014:m0081","object_person_mention_id":"c-nanqishu-055-filial-complete:p014:m0084"}],"status":"source_attested","interpretation_note":"荒年客死山陰，丁氏備棺。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-qi055-xushi-death","person_id":"ktr_d0k_prp","event_type":"death","source_term":"死","source_anchor":{"paragraph_id":"c-nanqishu-055-filial-complete:p014","start":90,"end":91,"surface":"死"},"date_expression":null,"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-055","chapter_id":"c-nanqishu-055-filial-complete","source_id":"s-nanqishu-055-filial-complete-ws1545598","paragraph_id":"c-nanqishu-055-filial-complete:p014","quote":"　　永明元年，會稽永興倪翼之母丁氏，少喪夫，性仁愛，遭年荒，分衣食以飴里中饑餓者，隣里求借，未嘗違。同里陳穰父母死，孤單無親戚，丁氏收養之，及長，爲營婚娶。又同里王禮妻徐氏，荒年客死山陰，丁爲買棺器，自往歛葬。元徽末，大雪，商旅斷行，村里比屋饑餓，丁自出