":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin058-volume-zhou-fang-grandfather","subject_person_id":"c6b_s71_vt7","object_person_id":"kqb_qol_og1","predicate":"grandfather","qualifiers":{"source_term":"祖纂"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-058","chapter_id":"c-jinshu-058-zhou-fang","source_id":"s-jinshu-058-zhou-fang-ws1775463","paragraph_id":"c-jinshu-058-zhou-fang:p001","quote":"周訪，字士達，本汝南安城人也。漢末避地江南，至訪四世。呉平，因家廬江尋陽焉。祖纂，呉威遠將軍。父敏，左中郎將。訪少沈毅，謙而能讓，果於斷割，周窮振乏，家無餘財。爲縣功曹，時陶侃爲散吏，訪薦爲主簿，相與結友，以女妻侃子瞻。訪察孝廉，除郎中、上甲令，皆不之官。鄕人盜訪牛於塚間殺之，訪得之，密埋其肉，不使人知。","subject_person_mention_id":"c-jinshu-058-zhou-fang:p001:m0000","object_person_mention_id":"c-jinshu-058-zhou-fang:p001:m0039"}],"status":"source_attested","interpretation_note":"祖吳威遠將軍纂。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-058-zhou-fang:p001:m0039","surface":"纂","start":39,"end":40,"person_id":"kqb_qol_og1","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-058-zhou-fang:p001","chapter_id":"c-jinshu-058-zhou-fang"}],"relations":[{"id":"a-jin058-volume-zhou-fang-grandfather","subject_person_id":"c6b_s71_vt7","object_person_id":"kqb_qol_og1","predicate":"grandfather","qualifiers":{"source_term":"祖纂"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-058","chapter_id":"c-jinshu-058-zhou-fang","source_id":"s-jinshu-058-zhou-fang-ws1775463","paragraph_id":"c-jinshu-058-zhou-fang:p001","quote":"周訪，字士達，本汝南安城人也。漢末避地江南，至訪四世。呉平，因家廬江尋陽焉。祖纂，呉威遠將軍。父敏，左中郎將。訪少沈毅，謙而能讓，果於斷割，周窮振乏，家無餘財。爲縣功曹，時陶侃爲散吏，訪薦爲主簿，相與結友，以女妻侃子瞻。訪察孝廉，除郎中、上甲令，皆不之官。鄕人盜訪牛於塚間殺之，訪得之，密埋其肉，不使人知。","subject_person_mention_id":"c-jinshu-058-zhou-fang:p001:m0000","object_person_mention_id":"c-jinshu-058-zhou-fang:p001:m0039"}],"status":"sou