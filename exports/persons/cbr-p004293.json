{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004293","canonical_person_id":"qrk_ln3_p0h","id_aliases":["cbr-p004293"],"identity_policy":"contextual_provisional","person_ids":["qrk_ln3_p0h"],"persons":[{"id":"qrk_ln3_p0h","label":"禹（孟子荀卿列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"禹","mention_ids":["c-shiji-074-mengxun:m004-0243"]}],"evidence":[{"mention_id":"c-shiji-074-mengxun:m004-0243","chapter_id":"c-shiji-074-mengxun","paragraph_id":"c-shiji-074-mengxun:p004","quote":"禹"}],"id_aliases":["cbr-p004293"]}],"source_mention_summary":[{"source_id":"s-shiji-074-mengxun","work_id":"w-shiji","book_id":"b-shiji-074","chapter_id":"c-shiji-074-mengxun","mention_count":1,"mention_ids":["c-shiji-074-mengxun:m004-0243"],"paragraph_ids":["c-shiji-074-mengxun:p004"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-074-mengxun"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-074-mengxun:m004-0243","start":243,"end":244,"surface":"禹","kind":"person","person_id":"qrk_ln3_p0h","status":"contextual_provisional","paragraph_id":"c-shiji-074-mengxun:p004","chapter_id":"c-shiji-074-mengxun"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji074-017","person_id":"qrk_ln3_p0h","surfaces":["禹"],"scope":"same_chapter","chapter_ids":["c-shiji-074-mengxun"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-074-mengxun:p004","quote":"其次騶衍，後孟子。騶衍睹有國者益淫侈，不能尚德，若大雅整之於身，施及黎庶矣。乃深觀陰陽消息而作怪迂之變，終始、大聖之篇十餘萬言。其語閎大不經，必先驗小物，推而大之，至於無垠。先序今以上至黃帝，學者所共術，大并世盛衰，因載其禨祥度制，推而遠之，至天地未生，窈冥不可考而原也。先列中國名山大川，通谷禽獸，水土所殖，物類所珍，因而推之，及海外人之所不能睹。稱引天地剖判以來，五德轉移，治各有宜，而符應若茲。以為儒者所謂中國者，於天下乃八十一分居其一分耳。中國名曰赤縣神州。赤縣神州內自有九州，禹之序九州是也，不得為州數。中國外如赤縣神州者九，乃所謂九州也。於是有裨海環之，人民禽獸莫能相通者，如一區中者，乃為一州。如此者九，乃有大瀛海環其外，天地之際焉。其術皆此類也。然要其歸，必止乎仁義節儉，君臣上下六親之施，始也濫耳。王公大人初見其術，懼然顧化，其後不能行之。"}],"rationale":"依前5段明示稱名與局部敘事暫接，孟軻與孟子人稱分辨書名；第5段騶子限接前段騶衍。騶忌、騶衍與三騶群體不混，齊宣王威王與燕昭王分開。夫子引言、孫子、大王去邠與繆公不按記憶補名字；仲尼與孔子已發ID各保留，跨篇暫同指另存於本篇equivalences記錄。引古與傳說保持來源層，不作已確證年代與事實。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-074-mengxun:p004","text":"其次騶衍，後孟子。騶衍睹有國者益淫侈，不能尚德，若大雅整之於身，施及黎庶矣。乃深觀陰陽消息而作怪迂之變，終始、大聖之篇十餘萬言。其語閎大不經，必先驗小物，推而大之，至於無垠。先序今以上至黃帝，學者所共術，大并世盛衰，因載其禨祥度制，推而遠之，至天地未生，窈冥不可考而原也。先列中國名山大川，通谷禽獸，水土所殖，物類所珍，因而推之，及海外人之所不能睹。稱引天地剖判以來，五德轉移，治各有宜，而符應若茲。以為儒者所謂中國者，於天下乃八十一分居其一分耳。中國名曰赤縣神州。赤縣神州內自有九州，禹之序九州是也，不得為州數。中國外如赤縣神州者九，乃所謂九州也。於是有裨海環之，人民禽獸莫能相通者，如一區中者，乃為一州。如此者九，乃有大瀛海環其外，天地之際焉。其術皆此類也。然要其歸，必止乎仁義節儉，君臣上下六親之施，始也濫耳。王公大人初見其術，懼然顧化，其後不能行之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-074-mengxun:m004-0002","start":2,"end":4,"surface":"騶衍","kind":"person","person_id":"k22_9pd_uu4","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m004-0006","start":6,"end":8,"surface":"孟子","kind":"person","person_id":"1h5_8jc_qp7","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m004-0009","start":9,"end":11,"surface":"騶衍","kind":"person","person_id":"k22_9pd_uu4","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m004-0093","start":93,"end":95,"surface":"黃帝","kind":"person","person_id":"9pr_pid_8tj","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m004-0166","start":166,"end":169,"surface":"海外人","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名群體、時代合稱或匿名說話者，不補成員與姓名；子思之門人不當子思本人。"},{"id":"c-shiji-074-mengxun:m004-0243","start":243,"end":244,"surface":"禹","kind":"person