17},{"line":80,"column":18},{"line":80,"column":19},{"line":80,"column":20},{"line":81,"column":0},{"line":81,"column":1},{"line":81,"column":2},{"line":81,"column":3},{"line":81,"column":4},{"line":81,"column":5},{"line":81,"column":6},{"line":81,"column":7},{"line":81,"column":8},{"line":81,"column":9},{"line":81,"column":10},{"line":81,"column":11},{"line":81,"column":12},{"line":81,"column":13},{"line":81,"column":14},{"line":81,"column":15},{"line":81,"column":16},{"line":81,"column":17},{"line":81,"column":18},{"line":81,"column":19},{"line":81,"column":20},{"line":82,"column":0},{"line":82,"column":1},{"line":82,"column":2},{"line":82,"column":3},{"line":82,"column":4},{"line":82,"column":5},{"line":82,"column":6},{"line":82,"column":7},{"line":82,"column":8},{"line":82,"column":9},{"line":82,"column":10},{"line":82,"column":11},{"line":82,"column":12},{"line":82,"column":13},{"line":82,"column":14},{"line":82,"column":15},{"line":82,"column":16},{"line":82,"column":17},{"line":82,"column":18},{"line":82,"column":19},{"line":82,"column":20},{"line":83,"column":0},{"line":83,"column":1},{"line":83,"column":2},{"line":83,"column":3},{"line":83,"column":4},{"line":83,"column":5},{"line":83,"column":6},{"line":83,"column":7},{"line":83,"column":8},{"line":83,"column":9},{"line":83,"column":10},{"line":83,"column":11},{"line":83,"column":12},{"line":83,"column":13},{"line":83,"column":14},{"line":83,"column":15},{"line":83,"column":16},{"line":83,"column":17},{"line":83,"column":18},{"line":83,"column":19},{"line":83,"column":20},{"line":84,"column":0},{"line":84,"column":1},{"line":84,"column":2},{"line":84,"column":3},{"line":84,"column":4},{"line":84,"column":5},{"line":84,"column":6},{"line":84,"column":7},{"line":84,"column":8},{"line":84,"column":9},{"line":84,"column":10},{"line":84,"column":11}],"boundary_is_editorial":true,"projected_start":688,"projected_end":810},"chapter_id":"c-songshu-046-wangyi","book_id":"b-songshu-046","work_id":"w-songshu","source_id":"s-songshu-046-wangyi"},{"id":"c-songshu-053-yu-dengzhi:line062","text":"太祖猶優游之，使尚之更陳其意。尚之乃備言炳之愆過，曰：「尚書舊有增置幹二十人，以元、凱丞郎幹之假疾病，炳之常取十人私使，詢處幹闕，不得時補。近得王師，猶不遣還，臣令人語之，『先取人使，意常未安，今既有手力，不宜復留』。得臣此信，方復遣耳。大都為人好率懷行事，有諸紜紜，不悉可曉。臣思張遼之言，關羽雖兄弟，曹公父子，豈得不言。觀今人憂國實寡，臣復結舌，日月之明，或有所蔽。然不知臣者，豈不謂臣有爭競之迹，追以悵悵。臣與炳之周旋，俱被恩接，不宜復生厚薄。太尉昨與臣言，說炳之有諸不可，非唯一條，遠近相崇畏，震動四海，凡短人辦得致此，更復可嘉。虞秀之門生事之，累味珍肴，未嘗有乏，其外別貢，豈可具詳。炳之門中不問大小，誅求張幼緒，幼緒轉無以堪命。炳之先與劉德願殊惡，德願自持琵琶甚精麗。遺之，便復款然。市令盛馥進數百口材助營宅，恐人知，作虛買券。劉道錫驟有所輸，傾南俸之半。劉雍自謂得其力助，事之如父，夏中送甘蔗，若新發於州。國吏運載樵荻，無輟於道。諸見人有物，鮮或不求，聞劉遵考有材，便乞材，見好燭盤，便復乞之。選用不平，不可一二。太尉又云，炳之都無共事之體，凡所選舉，悉是其意，政令太尉知耳。論虞秀之作黃門，太尉不正答和，故得停。太尉近與炳之疏，欲用德願兒作州西曹，炳之乃啟用為主簿，即語德願，德願謝太尉。前後漏泄賣恩，亦復何極，縱不加罪，故宜出之。士庶忿疾之，非直項羽楚歌而已也。自從裴、劉刑罰以來，諸將陳力百倍，今日事實好惡可問。若赫然發憤，顯明法憲，陛下便可閑臥紫闥，無復一事也。」","annotation_status":"in_progress","mentions":[{"start":0,"end":2,"surface":"太祖","kind":"person","person_id":"3bh_k4m_fg4","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line062:m0000"},{"start":8,"end":10,"surface":"尚之","kind":"person","person_id":"d84_kqu_2g5","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line062:m0008"},{"start":15,"end":17,"surface":"尚之","kind":"person","person_id":"d84_kqu_2g5","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line062:m0015"},{"start":20,"end":22,"surface":"炳之","kind":"person","person_id":"4qr_wrk_3vd_DDBB","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line062:m0020"},{"start":40,"end":43,"surface":"元、凱","kind":"unresolved","person_id":null,"status":"unresolved","note":"尚書丞郎語境；不能因元凱同字接為杜預，可能制度比喻／人名待核。","candidate_person_ids":[],"id":"c-songshu-053-yu-dengzhi:line062:m0040"},{"start":51,"end":53,"surface":"炳之","kind":"person","person_id":"4qr_wrk_3vd_DDBB","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line062:m0051"},{"start":60,"end":61,"surface":"詢","kind":"unresolved","person_id":null,"status":"unresolved","note":"數位注推樂詢；未核其平行記載，正文僅詢字。","candidate_person_ids":[],"id":"c-songshu-053-yu-dengzhi:line062:m0060"},{"start":72,"end":74,