xtual_provisional","paragraph_id":"c-shiji-109-liguang:p006","chapter_id":"c-shiji-109-liguang"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-109-liguang:p006","text":"頃之，家居數歳。廣家與故潁陰侯孫屏野居藍田南山中射獵。嘗夜從一騎出，從人田間飲。還至霸陵亭，霸陵尉醉，呵止廣。廣騎曰：「故李將軍。」尉曰：「今將軍尚不得夜行，何乃故也！」止廣宿亭下。居無何，匈奴入殺遼西太守，敗韓將軍，後韓將軍徙右北平。於是天子乃召拜廣爲右北平太守。廣即請霸陵尉與俱，至軍而斬之。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-109-liguang:m006-0008","start":8,"end":9,"surface":"廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m006-0012","start":12,"end":15,"surface":"潁陰侯","kind":"person","person_id":"gqv_vyi_jao","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m006-0015","start":15,"end":16,"surface":"孫","kind":"person","person_id":"gqv_vyi_jao_*A","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m006-0030","start":30,"end":32,"surface":"一騎","kind":"person","person_id":"8tg_glo_yg2","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m006-0034","start":34,"end":36,"surface":"從人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-109-liguang:m006-0046","start":46,"end":49,"surface":"霸陵尉","kind":"person","person_id":"b3j_bwz_6eq","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m006-0053","start":53,"end":54,"surface":"廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m006-0055","start":55,"end":56,"surface":"廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m006-0056","start":56,"end":57,"surface":"騎","kind":"person","person_id":"8tg_glo_yg2","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m006-0061","start":61,"end":64,"surfa