":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-liangshu-050-xiejiqing-family-intro-wyd:p004:m0023","start":23,"end":26,"surface":"庾仲容","person_id":"fem_1hn_uxl","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。","paragraph_id":"c-liangshu-050-xiejiqing-family-intro-wyd:p004","chapter_id":"c-liangshu-050-xiejiqing-family-intro-wyd"},{"id":"c-liangshu-050-xiejiqing-family-intro:p004:m0026","start":26,"end":29,"surface":"庾仲容","person_id":"fem_1hn_uxl","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。","paragraph_id":"c-liangshu-050-xiejiqing-family-intro:p004","chapter_id":"c-liangshu-050-xiejiqing-family-intro"},{"start":25,"end":28,"surface":"庾仲容","id":"c-nanshi-019-jiqing:p005:m0025","person_id":"fem_1hn_uxl","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作庾仲容。","paragraph_id":"c-nanshi-019-jiqing:p005","chapter_id":"c-nanshi-019-jiqing"}],"relations":[],"title_holdings":[{"id":"th-liang050-jiqing-25","person_id":"fem_1hn_uxl","title":"左丞","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-050","chapter_id":"c-liangshu-050-xiejiqing-family-intro","source_id":"s-liangshu-050-xiejiqing-family-intro-ws1514482","paragraph_id":"c-liangshu-050-xiejiqing-family-intro:p004","quote":"居宅在白楊石井，朝中交好者載酒從之，賓客滿坐。時左丞庾仲容亦免歸，二人意志相得，並肆情誕縱，或乘露車歷遊郊野，旣醉則執鐸輓歌，不屑物議。湘東王在荊鎮，與書慰勉之。幾卿答曰：「下官自奉違南浦，卷迹東郊，望日臨風，瞻言佇立。仰尋惠渥，陪奉遊宴，漾桂棹於清池，席落英於曾岨。蘭香兼御，羽觴競集，側聽餘論，沐浴玄流。濤波之辯，懸河不足譬；春藻之辭，麗文無以匹。莫不相顧動容，服心勝口，不覺春日爲遙，更謂脩夜爲促。嘉會難常，摶雲易遠，言念如昨，忽焉素秋。恩光不遺，善謔遠降。因事罷歸，豈雲棲息。旣匪高官，理就一廛。田家作苦，實符清誨。本乏金羈之飾，無假玉璧爲資；徒以老使形疏，疾令心阻，沉滯床簟，彌歷七旬。夢幻俄頃，憂傷在念，竟知無益，思自袪遣。尋理滌意，即以任命爲膏酥；攬鏡照形，翻以支離代萱樹。故得仰慕徽猷，永言前哲；鬼穀深棲，接輿高舉；遁名屠肆，發迹關市；其人緬邈，餘流可想。若令亡者有知，寧不縈悲玄壤，悵隔芳塵；如其逝者可作，必當昭被光景，歡同遊豫；使夫一介老圃，得簉虛心末席。去日已疏，來侍未孱；連劍飛鳧，擬非其類；懷私茂德，竊用涕零。」","person_mention_id":"c-liangshu-050-xiejiqing-family-intro:p004:m0026"}],"attestations":[{"paragraph_id":"c-liangshu-050-xiejiqing-family-intro:p004","surface":"左丞","start":24,"end":26,"id":"th-liang050-jiqing-25:a","person_mention_id":"c-liangshu-050-xiejiqing-family-intro:p004:m0026","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"庾仲容在此段的官序。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"th-liang050-jiqing-25-wyd","person_id":"fem_1hn_uxl","title":"左丞","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-050","chapter_id":"c-liangshu-050-xiejiqing-family-intro-wyd","source_id":"s-liangshu-050-jiqing-wyd1739","paragraph_id":"c-liangshu-050-xiejiqing-family-intro-wyd:p004","quote":"居宅在白楊石井朝中交好者載酒從之賓客滿坐時左丞庾仲容亦免歸二人意志相得並肆情誕縱或乘露車歷遊郊野既醉則執鐸挽歌不屑物議湘東王在荊鎮與書慰勉之幾卿答曰下官自奉違南浦卷迹東郊望日臨風瞻言佇立仰尋惠渥陪奉遊宴漾桂棹於清池席落英於曾岨蘭香兼御羽觴競集側聽餘論沐浴玄流濤波之辯懸河不足譬春藻之辭麗文無以匹莫不相顧動容服心勝口不覺春日為遙更謂脩夜為促嘉會難常摶雲易遠言念如昨忽焉素秋恩光不遺善謔遠降因事罷歸豈云栖缺匪商官缺理就一廛田家作苦實符清誨本乏金羈之飾無假玉璧為資徒以老使形疏疾令心阻沉滯牀簟彌歷七旬夢幻俄頃憂傷在念竟知無益思自袪遣尋理滌意即以任命為膏酥擥鏡照形翻以支離代萱樹故得仰慕徽猷永言前哲鬼谷深栖接輿高舉遁名屠肆發迹關市其人緬邈餘流可想若令亡者有知寧不縈悲玄壤悵隔芳塵如其逝者可作必當昭被光景懽同遊豫使夫一介老圃得簉虛心末席去日已疏來侍未孱連劍飛鳧擬非其類懷私茂德竊用涕零","person_mention_id":"c-liangshu-050-xiejiqing-family-intro-wyd:p004:m0023"}],"attestations":[{"paragraph_id":"c-liangshu-050-xiejiqing-family-intro-wyd:p004","surface":"左丞","start":21,"end":23,"id":"th-liang050-jiqing-25-wyd:a1","person_mention_id":"c-liangshu-050-xiejiqing-family-intro-wyd:p004:m0023","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","d