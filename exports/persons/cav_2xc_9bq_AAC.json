-liang-close-family:p001:m0010"}],"interpretation_note":"只按明皇考/生/子原詞，君主身份由限定本紀/追尊鏈交證；不補母親、婚配或字母排行。","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[{"connection":"father","parent_person_id":"cav_2xc_9bq_AA","source_assertion_id":"a-liang-close-family-ji-father-liangwu","status":"contextual_provisional","human_reviewed":false,"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-055","source_id":"s-liangshu055-liang-close-family","chapter_id":"c-liangshu-055-liang-close-family","paragraph_id":"c-liangshu-055-liang-close-family:p001","quote":"　　武陵王紀字世詢，高祖第八子也。少勤學，有文才，屬辭不好輕華，甚有骨氣。天監十三年，封爲武陵郡王，邑二千戶。歷位寧遠將軍、琅邪彭城二郡太守、輕車將軍、丹陽尹。出爲會稽太守，尋以其郡爲東揚州，仍爲刺史，加使持節、東中郎將。徵爲侍中，領石頭戍軍事。出爲宣惠將軍、江州刺史。徵爲使持節、宣惠將軍、都督揚南徐二州諸軍事、揚州刺史。尋改授持節、都督益梁等十三州諸軍事、安西將軍、益州刺史，加鼓吹一部。大同十一年，授散騎常侍、征西大將軍、開府儀同三司。","subject_person_mention_id":"c-liangshu-055-liang-close-family:p001:m0002","object_person_mention_id":"c-liangshu-055-liang-close-family:p001:m0010","source_term":"高祖第八子"}],"interpretation_note":"明父子來源支援的一代家族路徑；字母為身份配置，不是全體/嫡子出生排行，不由同姓或帝號推祖先。","person_id":"cav_2xc_9bq_AAC"}],"name_components":[{"id":"name-zhou041-ji-source-qualified","person_id":"cav_2xc_9bq_AAC","surname":"蕭","ming":"紀","title":"武陵王","additional_names":[],"chapter_id":"c-zhoushu-041-wangbao-ws2432538","paragraph_id":"c-zhoushu-041-wangbao-ws2432538:p004","person_mention_id":"c-zhoushu-041-wangbao-ws2432538:p004:m0009","source_anchor":{"start":9,"end":13,"surface":"武陵王紀"},"quote":"初，元帝平侯景及擒武陵王紀之後，以建業彫殘，方須修復；江陵殷盛，便欲安之。又其故府臣寮，皆楚人也，竝願即都荊郢。嘗召羣臣議之。領軍將軍胡僧祐、吏部尚書宗懍、太府卿黃羅漢、御史中丞劉瑴等曰：「建業雖是舊都，王氣已盡。且與北寇鄰接，止隔一江。若有不虞，悔無及矣。臣等又嘗聞之，荊南之地，有天子氣。今陛下龍飛纘業，其應斯乎。天時人事，徵祥如此。臣等所見，遷徙非宜。」元帝深以為然。時襃及尚書周弘正咸侍座。乃顧謂襃等曰：「卿意以為何如？」襃性謹慎，知元帝多猜忌，弗敢公言其非。當時唯唯而已。後因清閒密諫，言辭甚切。元帝頗納之。然其意好荊、楚，已從僧祐等策。明日，乃於眾中謂襃曰：「卿昨日勸還建業，不為無理。」襃以宣室之言，豈宜顯之於眾。知其計之不用也，於是止不復言。","status":"editorial_provisional","human_reviewed":false,"model":null,"surname_basis":{"kind":"contextual_surname_from_fixed_zhou041_imperial_roles","status":"contextual_provisional","human_reviewed":false,"scope":"biographical_original_surname_not_exclusive_lifetime_surname","primary_reading_keys":["liang055_ji"],"surname":"蕭","literal_in_current_mention":false,"not_inferred_from_rank":true,"reason":"梁55同人本傳與史臣評語直接稱蕭紀，與周書元帝擒武陵王紀的同一事件語境相符；不用頁面維基百科蕭紀連結。","reported_later_surname":"饕餮氏","reported_surname_event_not_structured":true},"name_source_binding":{"kind":"contextual_surname_preserved_rank_and_ming","source_name_kind":"rank_plus_ming","person_mention_id":"c-zhoushu-041-wangbao-ws2432538:p004:m0009","ming_anchor":{"paragraph_id":"c-zhoushu-041-wangbao-ws2432538:p004","start":12,"end":13,"surface":"紀"},"title_anchor":{"paragraph_id":"c-zhoushu-041-wangbao-ws2432538:p004","start":9,"end":12,"surface":"武陵王"},"surname_literal_anchor":null,"human_reviewed":false},"note":"原周書王號、名字及字位全保；姓蕭是有據編輯復姓。非字面蕭紀錨、不向registry aliases拼造全名；title僅本源姓名稱謂構件，非default_title選讀或持爵事件。","work_id":"w-zhoushu","book_id":"b-zhoushu-041","source_id":"s-zhoushu041-ws2432538"}],"mentions":[{"id":"c-liangshu-055-liang-close-family:p001:m0002","start":2,"end":6,"surface":"武陵王紀","kind":"person","person_id":"cav_2xc_9bq_AAC","status":"contextual_provisional","source_role":"ji","interpretation_note":"完整收到來源單元限定父祖與君主稱名角色；同人外證與取得資格另存有限契約，不依全域廟號猜人。","paragraph_id":"c-liangshu-055-liang-close-family:p001","chapter_id":"c-liangshu-055-liang-close-family"},{"id":"c-zhoushu-041-wangbao-ws2432538:p004:m0009","start":9,"end":13,"surface":"武陵王紀","kind":"person","person_id":"cav_2xc_9bq_AAC","status":"contextual_provisional","source_role":"ji","interpretation_note":"依完整本傳及書信換聲/政權時間的來源角色辨識；不由全域單字、近名或同廟號自動選人。","identity_decision_id":"d-zhou041-ji","paragraph_id":"c-zhoushu-041-wangbao-ws2432538:p004","chapter_id":"c-zhoushu-041-wangbao-ws2432538"}],"relations":[{"id":"a-liang-close-family-ji-father-liangwu","subject_person_id":"cav_2xc_9bq_AAC","predicate":"father","object_person_id":"cav_2xc_9bq_AA","status":"source_attested","qualifiers":{"lineage":"paternal","source_term":"高祖第八子","source_clause_binding":{"kind":"fixed_liang_xiao_close_family","case":"ji-father-liangwu","contract_ref":"source-evidence/liang-xiao-close-family/family-source-contract.json"}},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-055","source_id":"s-liangshu055-liang-close-family","chapter_id":"c-liangshu-055-liang-close-family","paragraph_id":"c-liangshu-055-liang-close-family:p001","quote":"　　武陵王紀字世詢，高祖第八子也。少勤學，有文才，屬辭不好輕華，甚有骨氣。天監十三年，封爲武陵郡王，邑二千戶。歷位寧遠將軍、琅邪彭城二郡太守、輕車將軍、丹陽尹。出爲會稽太守，尋以其郡爲東揚州，仍爲刺史，加使持節、東中郎將。徵爲侍中，領石頭戍軍事。出爲宣惠將軍、江州刺史。徵爲使持節、宣惠將軍、都督揚南徐二州諸軍事、揚州刺史。尋改授持節、都督益梁等十三州諸軍事、安西將軍、益州刺史，加鼓吹一部。大同十一年，授散騎常侍、征西大將軍、開府儀同三司。","subject_person_mention_id":"c-liangshu-055-liang-close-family:p001:m0002","object_person_mention_id":"c-liangshu-055-liang-close-family:p001:m0010"}],"interpretation_note":"只按明皇考/生/子原詞，君主身份由限定本紀/追尊鏈交證；不補母親、婚配或字母排行。","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-zhou041-ji","person_id":"cav_2xc_9bq_AAC","surfaces":["武陵王紀"],"scope":"same_chapter","chapter_ids":["c-zhoushu-041-wangbao-ws2432538"],"status":"contextual_provisional","evidence":[{"work_id":"w-zhoushu","book_id":"b-zhoushu-041","source_id":"s-zhoushu041-ws2432538","chapter_id":"c-zhoushu-041-wangbao-ws2432538","paragraph_id":"c-zhoushu-041-wangbao-ws2432538:p004","quote":"初，元帝平侯景及擒武陵王紀之後，以建業彫殘，方須修復；江陵殷盛，便欲安之。又其故府臣寮，皆楚人也，竝願即都荊郢。嘗召羣臣議之。領軍將軍胡僧祐、吏部尚書宗懍、太府卿黃羅漢、御史中丞劉瑴等曰：「建業雖是舊都，王氣已盡。且與北寇鄰接，止隔一江。若有不虞，悔無及矣。臣等又嘗聞之，荊南之地，有天子氣。今陛下龍飛纘業，其應斯乎。天時人事，徵祥如此。臣等所見，遷徙非宜。」元帝深以為然。時襃及尚書周弘正咸侍座。乃顧謂襃等曰：「卿意以為何如？」襃性謹慎，知元帝多猜忌，弗敢公言其非。當時唯唯而已。後因清閒密諫，言辭甚切。元帝頗納之。然其意好荊、楚，已從僧祐等策。明日，乃於眾中謂襃曰：「卿昨日勸還建業，不為無理。」襃以宣室之言，豈宜顯之於眾。知其計之不用也，於是止不復言。","mention_ids":["c-zhoushu-041-wangbao-ws2432538:p004:m0009"]}],"rationale":"