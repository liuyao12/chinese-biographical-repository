tus":"contextual_provisional"},{"id":"c-jinshu-057-luo-shang:p001:m0236","surface":"孫阜","start":236,"end":238,"person_id":"dt6_eci_z9s","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-luo-shang:p001:m0248","surface":"阜","start":248,"end":249,"person_id":"dt6_eci_z9s","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-luo-shang:p001:m0271","surface":"任銳","start":271,"end":273,"person_id":"z81_k2j_jcr","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-luo-shang:p001:m0295","surface":"李特","start":295,"end":297,"person_id":"yvq_bp2_1pg","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-luo-shang:p001:m0303","surface":"特","start":303,"end":304,"person_id":"yvq_bp2_1pg","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-luo-shang:p001:m0305","surface":"雄","start":305,"end":306,"person_id":"oiw_ao2_epd","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-luo-shang:p001:m0318","surface":"隗伯","start":318,"end":320,"person_id":"qd6_ual_tdf","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-057-luo-shang","book_id":"b-jinshu-057","work_id":"w-jinshu","source_id":"s-jinshu-057-luo-shang-ws2413329"},{"id":"c-jinshu-060-sunqi:p001","text":"孫旂，字伯旗，樂安人也。父曆，魏晉際為幽州刺史、右將軍。旂潔靜，少自修立。察孝廉，累遷黃門侍郎，出為荊州刺史，名位與二解相亞。永熙中，徵拜太子詹事，轉衛尉，坐武庫火，免官。歲餘，出為兗州刺史，遷平南將軍、假節。旂子弼及弟子髦、輔、琰四人，並有吏材，稱於當世，遂與孫秀合族。及趙王倫起事，夜從秀開神武門下觀閱器械。兄弟旬月相次為公府掾、尚書郎。弼又為中堅將軍，領尚書左丞，轉為上將軍，領射聲校尉。髦為武衛將軍，領太子詹事。琰為武威將軍，領太子左率。皆賜爵開國郡侯。推崇旂為車騎將軍、開府。初，旂以弼等受署偽朝，遣小息回責讓弼等，以過差之事，必為家禍。弼等終不從，旂制之不可，但慟哭而已。及齊王冏起義，四子皆伏誅。襄陽太守宗岱承冏檄斬旂，夷三族。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":20,"last_line":20,"raw_start":1164,"raw_end":1487,"raw_character_offsets":[1166,1167,1168,1169,1170,1171,1172,1173,1174,1175,1176,1177,1178,1179,1180,1181,1182,1183,1184,1185,1186,1187,1188,1189,1190,1191,1192,1193,1194,1195,1196,1197,1198,1199,1200,1201,1202,1203,1204,1205,1206,1207,1208