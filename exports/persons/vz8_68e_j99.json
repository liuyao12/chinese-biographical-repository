ons":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-121-rulin:m004-0197","start":197,"end":199,"surface":"孝文","kind":"person","person_id":"vz8_68e_j99","status":"contextual_provisional","paragraph_id":"c-shiji-121-rulin:p004","chapter_id":"c-shiji-121-rulin"},{"id":"c-shiji-121-rulin:m004-0205","start":205,"end":208,"surface":"孝文帝","kind":"person","person_id":"vz8_68e_j99","status":"contextual_provisional","paragraph_id":"c-shiji-121-rulin:p004","chapter_id":"c-shiji-121-rulin"},{"id":"c-shiji-121-rulin:m013-0008","start":8,"end":11,"surface":"孝文帝","kind":"person","person_id":"vz8_68e_j99","status":"contextual_provisional","paragraph_id":"c-shiji-121-rulin:p013","chapter_id":"c-shiji-121-rulin"},{"id":"c-shiji-121-rulin:m014-0015","start":15,"end":18,"surface":"孝文帝","kind":"person","person_id":"vz8_68e_j99","status":"contextual_provisional","paragraph_id":"c-shiji-121-rulin:p014","chapter_id":"c-shiji-121-rulin"},{"id":"c-shiji-121-rulin:m018-0008","start":8,"end":11,"surface":"孝文帝","kind":"person","person_id":"vz8_68e_j99","status":"contextual_provisional","paragraph_id":"c-shiji-121-rulin:p018","chapter_id":"c-shiji-121-rulin"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-121-rulin:p004","text":"及高皇帝誅項籍，舉兵圍魯，魯中諸儒尚講誦習禮樂，弦歌之音不絕，豈非聖人之遺化，好禮樂之國哉？故孔子在陳曰：「歸與！歸與！吾黨之小子狂簡，斐然成章，不知所以裁之。」夫齊魯之閒於文學，自古以來，其天性也。故漢興，然後諸儒始得修其經藝，講習大射鄉飲之禮。叔孫通作漢禮儀，因為太常，諸生弟子共定者，咸為選首，於是喟然嘆興於學。然尚有干戈，平定四海，亦未暇遑庠序之事也。孝惠、呂后時，公卿皆武力有功之臣。孝文時頗徵用，然孝文帝本好刑名之言。及至孝景，不任儒者，而竇太后又好黃老之術，故諸博士具官待問，未有進者。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m004-0001","start":1,"end":4,"surface":"高皇帝","kind":"person","person_id":"x85_w53_dyq","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m004-0005","start":5,"end":7,"surface":"項籍","kind":"person","person_id":"mtg_mtp_8oz","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m004-0013","start":13,"end":17,"surface":"魯中諸儒","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m004-0033","start":33,"end":35,"surface":"聖人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m004-0047","start":47,"end":49,"surface":"孔子","kind":"person","person_id":"t0d_uf0_f2f","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m004-0124","start":124,"end":127,"surface":"叔孫通","kind":"person","person_id":"o57_ilh_v3i","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m004-0137","start":137,"end":141,"surface":"諸生弟子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m004-0180","start":180,"end":182,"surface":"孝惠","kind":"person","person_id":"f2v_ue2_c9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m004-0183","start":183,"end":185,"surface":"呂后","kind":"person","person_id":"neq_81h_l49","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m004-0187","start":187,"end":189,"surface":"公卿","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m004-0197","start":197,"end":199,"surface":"孝文","kind":"person","person_id":"vz8_68e_j99","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m004-0205","start":205,"end":208,"surface":"孝文帝","kind":"person","person_id":"vz8_68e_j99","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m004-0217","start":217,"end":219,"surface":"孝景","kind":"person","person_id":"8s8_8m3_upb","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m004-0226","start":226,"end":229,"surface":"竇太后","kind":"person","person_id":"r4k_my1_3w5","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m004-0237","start":237,"end":240,"surface":"諸博士","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-121-rulin","book_id":"b-shiji-121","work_id":"w-shiji","source_id":"s-shiji121-rulin"},{"id":"c-shiji-121-rulin:p013","text":"韓生者，燕人也。孝文帝時為博士，景帝時為常山王太傅。韓生推詩之意而為內外傳數萬言，其語頗與齊魯閒殊，然其歸一也。淮南賁生受之。自是之後，而燕趙閒言詩者由韓生。韓生孫商為今上博士。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m013-0000","start":0,"end":2,"surface":"韓生","kind":"person","person_id":"r6c_fhk_jo9","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m013-0008","start":8,"end":11,"surface":"孝文帝","kind":"person","person_id":"vz8_68e_j99","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m013-0016","start":16,"end":18,"surface":"景帝","kind":"person","person_id":"8s8_8m3_upb","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m013-0026","start":26,"end":28,"surface":"韓生","kind":"person","person_id":"r6c_fhk_jo9","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m013-0058","start":58,"end":60,"surface":"賁生","kind":"person","person_id":"lls_je1_d6d","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m013-0076","start":76,"end":78,"surface":"韓生","kind":"person","person_id":"r6c_fhk_jo9","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m013-0079","start":79,"end":81,"surface":"韓生","kind":"person","person_id":"r6c_fhk_jo9","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m013-0082","start":82,"end":83,"surface":"商","kind":"person","person_id":"r6c_fhk_jo9_*A","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m013-0084","start":84,"end":86,"surface":"今上","kind":"person","person_id":"o7s_89o_zka","status":"contextual_provisional"}],"chapter_id":"c-shiji-121-rulin","book_id":"b-shiji-121","work_id":"w-shiji","source_id":"s-shiji121-rulin"},{"id":"c-shiji-121-rulin:p014","text":"伏生者，濟南人也。故為秦博士。孝文帝時，欲求能治尚書者，天下無有，乃聞伏生能治，欲召之。是時伏生年九十餘，老，不能行，於是乃詔太常使掌故晁錯往受之。秦時焚書，伏生壁藏之。其後兵大起，流亡，漢定，伏生求其書，亡數十篇，獨得二十九篇，即以教于齊魯之閒。學者由是頗能言尚書，諸山東大師無不涉尚書以教矣。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m014-0000","start":0,"end":2,"surface":"伏生","kind":"person","person_id":"t6q_oe6_hom","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m014-0015","start":15,"end":18,"surface":"孝文帝","kind":"person","person_id":"vz8_68e_j99","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m014-0035","start":35,"end":37,"surface":"伏生","kind":"person","person_id":"t6q_oe6_hom","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m014-0046","start":46,"end":48,"surface":"伏生","kind":"person","person_id":"t6q_oe6_hom","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m014-0068","start":68,"end":70,"surface":"晁錯","kind":"person","person_id":"ef9_2e4_amv","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m014-0079","start":79,"end":81,"surface":"伏生","kind":"person","person_id":"t6q_oe6_hom","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m014-0097","start":97,"end":99,"surface":"伏生","kind":"person","person_id":"t6q_oe6_hom","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m014-0124","start":124,"end":126,"surface":"學者","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m014-0134","start":134,"end":139,"surface":"諸山東大師","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-121-rulin","book_id":"b-shiji-121","work_id":"w-shiji","source_id":"s-shiji121-rulin"},{"id":"c-shiji-121-rulin:p018","text":"而魯徐生善為容。孝文帝時，徐生以容為禮官大夫。傳子至孫延、徐襄。襄，其天姿善為容，不能通禮經；延頗能，未善也。襄以容為漢禮官大夫，至廣陵內史。延及徐氏弟子公戶滿意、桓生、單次，皆嘗為漢禮官大夫。而瑕丘蕭奮以禮為淮陽太守。是後能言禮為容者，由徐氏焉。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m018-0002","start":2,"end":4,"surface":"徐生","kind":"person","person_id":"sjw_4mo_dlf","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m018-0008","start":8,"end":11,"surface":"孝文帝","kind":"person","person_id":"vz8_68e_j99","sta