n","person_id":"530_f9d_4bd","status":"contextual_provisional"},{"id":"c-jinshu-053-minhuai-yu:p002:m0190","start":190,"end":191,"surface":"憲","kind":"person","person_id":"c6e_8f3_014","status":"contextual_provisional"},{"id":"c-jinshu-053-minhuai-yu:p002:m0196","start":196,"end":198,"surface":"張華","kind":"person","person_id":"1dq_vh2_eru","status":"contextual_provisional"},{"id":"c-jinshu-053-minhuai-yu:p002:m0199","start":199,"end":200,"surface":"禕","kind":"person","person_id":"1dq_vh2_eru_A","status":"contextual_provisional"},{"id":"c-jinshu-053-minhuai-yu:p002:m0204","start":204,"end":206,"surface":"華暠","kind":"person","person_id":"e5e_8ac_f12","status":"contextual_provisional"},{"id":"c-jinshu-053-minhuai-yu:p002:m0207","start":207,"end":208,"surface":"恆","kind":"person","person_id":"eom_42c_5zd","status":"contextual_provisional"}],"chapter_id":"c-jinshu-053-minhuai-yu","book_id":"b-jinshu-053","work_id":"w-jinshu","source_id":"s-jinshu-053-minhuai-yu-ws2595666"},{"id":"c-jinshu-062-zuti:p002","text":"辟齊王冏大司馬掾、長沙王乂驃騎祭酒，轉主簿，累遷太子中舍人、豫章王從事中郎。從惠帝北伐，王師敗績于蕩陰，遂退還洛。大駕西幸長安，關東諸侯范陽王虓、高密王略、平昌公模等競召之，皆不就。東海王越以逖爲典兵參軍、濟陰太守，母喪不之官。及京師大亂，逖率親黨數百家避地淮泗，以所乘車馬載同行老疾，躬自徒步，藥物衣糧與眾共之，又多權略，是以少長咸宗之，推逖爲行主。達泗口，元帝拟用爲徐州刺史，尋徵軍諮祭酒，居丹徒之京口。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":85,"last_line":85,"raw_start":8428,"raw_end":8634,"raw_character_offsets":[8430,8431,8432,8433,8434,8435,8436,8437,8438,8439,8440,8441,8442,8443,8444,8445,8446,8447,8448,8449,8450,8451,8452,8453,8454,8455,8456,8457,8458,8459,8460,8461,8462,8463,8464,8465,8466,8467,8468,8469,8470,8471,8472,8473,8474,8475,8476,8477,8478,8479,8480,8481,8482,8483,8484,8485,8486,8487,8488,8489,8490,8491,8492,8493,8494,8495,8496,8497,8498,8499,8500,8501,8502,8503,8504,8505,8506,8507,8508,8509,8510,8511,8512,8513,8514,8515,8516,8517,8518,8519,8520,8521,8522,8523,8524,8525,8526,8527,8528,8529,8530,8531,8532,8533,8534,8535,8536,8537,8538,8539,8540,8541,8542,8543,8544,8545,8546,8547,8548,8549,85