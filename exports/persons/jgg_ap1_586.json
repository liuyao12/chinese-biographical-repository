"元帝","start":180,"end":182,"person_id":"dkn_ge4_286_AAAAAAA","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-062-zuti","book_id":"b-jinshu-062","work_id":"w-jinshu","source_id":"s-jinshu-062-zuti-ws2629226"},{"id":"c-jinshu-066-liuhong:p009","text":"以高密王略代鎮，寇盜不禁，詔起璠為順陽內史，江漢之間翕然歸心。及略薨，山簡代之。簡至，知璠得眾心，恐百姓逼以為主，表陳之，由是征璠為越騎校尉。璠亦深慮逼迫，被書，便輕至洛陽，然後遣迎家累。僑人侯脫、路難等相率衛送至都，然後辭去。南夏遂亂。父老追思弘，雖《甘棠》之詠召伯，無以過也。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":26,"last_line":26,"raw_start":2650,"raw_end":2792,"raw_character_offsets":[2652,2653,2654,2655,2656,2657,2658,2659,2660,2661,2662,2663,2664,2665,2666,2667,2668,2669,2670,2671,2672,2673,2674,2675,2676,2677,2678,2679,2680,2681,2682,2683,2684,2685,2686,2687,2688,2689,2690,2691,2692,2693,2694,2695,2696,2697,2698,2699,2700,2701,2702,2703,2704,2705,2706,2707,2708,2709,2710,2711,2712,2713,2714,2715,2716,2717,2718,2719,2720,2721,2722,2723,2724,2725,2726,2727,2728,2729,2730,2731,2732,2733,2734,2735,2736,2737,2738,2739,2740,2741,2742,2743,2744,2745,2746,2747,2748,2749,2750,2751,2752,2753,2754,2755,2756,2757,2758,2759,2760,2761,2762,2763,2764,2765,2766,2767,2768,2769,2770,2771,2772,2773,2774,2775,2776,2777,2778,2779,2780,2781,2782,2783,2784,2785,2786,2787,2788,2789,2790,2791],"revision_id":1527632},"mentions":[{"id":"c-jinshu-066-liuhong:p009:m0001","surface":"高密王略","start":1,"end":5,"person_id":"jgg_ap1_586","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-liuhong:p009:m0015","surface":"璠","start":15,"end":16,"person_id":"5is_zik_jbp_A","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-liuhong:p009:m0035","surface":"山簡","start":35,"end":37,"person_id":"82k_3oi_qf8","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-liuhong:p009:m0096","surface":"侯脫","start":96,"end":98,"person_id":"w5u_0yi_d9x","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-liuhong:p009:m0099","surface":"路難","start":99,