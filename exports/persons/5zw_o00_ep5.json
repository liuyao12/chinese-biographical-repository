son_id":"5zw_o00_ep5","source_quote":"　　又會稽人陳氏，有三女，無男。祖父母年八九十，老耄無所知，父篤癃病，母不安其室。值歲飢，三女相率於西湖採菱蓴，更日至市貨賣，未嘗虧怠。鄉里稱爲義門，多欲取爲婦，長女自傷煢獨，誓不肯行。祖父母尋相繼卒，三女自營殯葬，爲菴舍墓側。","reading":"會稽陳氏三女共同奉養祖父母並營葬。文中長女一人誓不嫁，名不載。","note":"會稽陳氏三女共同奉養祖父母並營葬。文中長女一人誓不嫁，名不載。","paragraph_id":"c-nanqishu-055-filial-complete:p016","start_codepoint":0,"end_codepoint":114,"human_reviewed":false,"chapter_id":"c-nanqishu-055-filial-complete","source_id":"s-nanqishu-055-filial-complete-ws1545598"},{"id":"c-nanqishu-055-filial-complete:variant_review16-6","kind":"variant_review","person_id":"5zw_o00_ep5","source_quote":"陳氏，有三女，無男","reading":"三女不具名，長女另有誓不嫁。共同謀生及營祖父母葬地留合傳。","note":"三女不具名，長女另有誓不嫁。共同謀生及營祖父母葬地留合傳。","paragraph_id":"c-nanqishu-055-filial-complete:p016","start_codepoint":6,"end_codepoint":15,"human_reviewed":false,"chapter_id":"c-nanqishu-055-filial-complete","source_id":"s-nanqishu-055-filial-complete-ws1545598"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-055-filial-complete:p016:m0081","start":81,"end":83,"surface":"長女","kind":"person","person_id":"5zw_o00_ep5","status":"contextual_provisional","paragraph_id":"c-nanqishu-055-filial-complete:p016","chapter_id":"c-nanqishu-055-filial-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-055-filial-complete:p016","text":"　　又會稽人陳氏，有三女，無男。祖父母年八九十，老耄無所知，父篤癃病，母不安其室。值歲飢，三女相率於西湖採菱蓴，更日至市貨賣，未嘗虧怠。鄉里稱爲義門，多欲取爲婦，長女自傷煢獨，誓不肯行。祖父母尋相繼卒，三女自營殯葬，爲菴舍墓側。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":73,"last_line":73,"raw_start":2172,"raw_end":2290,"raw_character_offsets":[2172,21