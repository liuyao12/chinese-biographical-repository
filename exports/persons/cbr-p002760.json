an"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji046-054","person_id":"29i_iqg_x15","scope":"same_chapter","chapter_ids":["c-shiji-046-tian"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["段干朋"],"evidence":[{"paragraph_id":"c-shiji-046-tian:p024","quote":"齊侯太公和立二年，和卒，子桓公午立。桓公午五年，秦、魏攻韓，韓求救於齊。齊桓公召大臣而謀曰：「蚤救之孰與晩救之？」騶忌曰：「不若勿救。」段干朋曰：「不救，則韓且折而入於魏，不若救之。」田臣思曰：「過矣君之謀也！秦、魏攻韓、楚，趙必救之，是天以燕予齊也。」桓公曰：「善」。乃陰告韓使者而遣之。韓自以爲得齊之救，因與秦、魏戰。楚、趙聞之，果起兵而救之。齊因起兵襲燕國，取桑丘。"},{"paragraph_id":"c-shiji-046-tian:p031","quote":"二十六年，魏惠王圍邯鄲，趙求救於齊。齊威王召大臣而謀曰：「救趙孰與勿救？」騶忌子曰：「不如勿救。」段干朋曰：「不救則不義，且不利。」威王曰：「何也？」對曰：「夫魏氏并邯鄲，其於齊何利哉？且夫救趙而軍其郊，是趙不伐而魏全也。故不如南攻襄陵以獘魏，邯鄲拔而乘魏之獘。」威王從其計。"}],"rationale":"限本篇明示姓名、是為、繼位及局部事件暫接；姜齊與田齊桓公、不同時段未名王及同字忌分開。孫子不先補孫臏，子守髙唐不補闕字，索隱短稱與代詞仍待核；未跨篇按同名接人。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-046-tian:p024","text":"齊侯太公和立二年，和卒，子桓公午立。桓公午五年，秦、魏攻韓，韓求救於齊。齊桓公召大臣而謀曰：「蚤救之孰與晩救之？」騶忌曰：「不若勿救。」段干朋曰：「不救，則韓且折而入於魏，不若救之。」田臣思曰：「過矣君之謀也！秦、魏攻韓、楚，趙必救之，是天以燕予齊也。」桓公曰：「善」。乃陰告韓使者而遣之。韓自以爲得齊之救，因與秦、魏戰。楚、趙聞之，果起兵而救之。齊因起兵襲燕國，取桑丘。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-046-tian:m024-0000","start":0,"end":5,"surface":"齊侯太公和","kind":"person","person_id":"zan_qcc_jy5_AAAAAABAAAA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m024-0009","start":9,"end":10,"surface":"和","kind":"person","person_id":"zan_qcc_jy5_AAAAAABAAAA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m024-0013","start":13,"end":16,"surface":"桓公午","kind":"person","person_id":"zan_qcc_jy5_AAAAAABAAAAA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m024-0018","start":18,"end":21,"surface":"桓公午","kind":"person","person_id":"zan_qcc_jy5_AAAAAABAAAAA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m024-0036","start":36,"end":39,"surface":"齊桓公","kind":"person","person_id":"