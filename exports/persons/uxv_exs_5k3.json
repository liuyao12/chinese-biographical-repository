{"id":"c-shiji-095-fankuang:m024-0024","start":24,"end":26,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0030","start":30,"end":31,"surface":"嬰","kind":"person","person_id":"sj9_pfu_fwh","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0039","start":39,"end":41,"surface":"王武","kind":"person","person_id":"qxu_jqe_evi","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0044","start":44,"end":46,"surface":"申徒","kind":"person","person_id":"hds_rdm_z1p","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0071","start":71,"end":73,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0095","start":95,"end":97,"surface":"李必","kind":"person","person_id":"aru_qbv_1vo","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0098","start":98,"end":100,"surface":"駱甲","kind":"person","person_id":"dda_1pf_g3o","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0114","start":114,"end":116,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0120","start":120,"end":121,"surface":"必","kind":"person","person_id":"aru_qbv_1vo","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0122","start":122,"end":123,"surface":"甲","kind":"person","person_id":"dda_1pf_g3o","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0151","start":151,"end":153,"surface":"灌嬰","kind":"person","person_id":"sj9_pfu_fwh","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0163","start":163,"end":165,"surface":"灌嬰","kind":"person","person_id":"sj9_pfu_fwh","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0171","start":171,"end":173,"surface":"李必","kind":"person","person_id":"aru_qbv_1vo","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0174","start":174,"end":176,"surface":"駱甲","kind":"person","person_id":"dda_1pf_g3o","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0220","start":220,"end":222,"surface":"項羽","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0224","start":224,"end":226,"surface":"項冠","kind":"person","person_id":"uxv_exs_5k3","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0251","start":251,"end":253,"surface":"王武","kind":"person","person_id":"qxu_jqe_evi","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0275","start":275,"end":277,"surface":"王武","kind":"person","person_id":"qxu_jqe_evi","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0279","start":279,"end":281,"surface":"桓嬰","kind":"person","person_id":"snk_jy6_dgf","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0304","start":304,"end":306,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0315","start":315,"end":317,"surface":"韓信","kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0327","start":327,"end":328,"surface":"嬰","kind":"person","person_id":"sj9_pfu_fwh","status":"contextual_provisional"}],"chapter_id":"c-shiji-095-fankuang","book_id":"b-shiji-095","work_id":"w-shiji","source_id":"s-shiji-095-fankuang"},{"id":"c-shiji-098-fujin:p001","text":"陽陵侯傅寬，以魏五大夫騎將從，為舍人，起橫陽。從攻安陽、杠里，擊趙賁軍於開封，及擊楊熊曲遇、陽武，斬首十二級，賜爵卿。從至霸上。沛公立為漢王，漢王賜寬封號共德君。從入漢中，遷為右騎將。從定三秦，賜食邑雕陰。從擊項籍，待懷，賜爵通德侯。從擊項冠、周蘭、龍且，所將卒斬騎將一人敖下，益食邑。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-098-fujin:m001-0000","start":0,"end":3,"surface":"陽陵侯","kind":"person","person_id":"w8j_vnd_rs4","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m001-0003","start":3,"end":5,"surface":"傅寬","kind":"person","person_id":"w8j_vnd_rs4","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m001-0032","start":32,"end":34,"surface":"趙賁","kind":"person","person_id":"bwv_p3h_q1j","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m001-0041","start":41,"end":43,"surface":"楊熊","kind":"person","person_id":"v4m_7yp_xr3","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m001-0064","start":64,"end":66,"surface":"沛公","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m001-0068","start":68,"end":70,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m001-0071","start":71,"end":73,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m001-0074","start":74,"end":75,"surface":"寬","kind":"person","person_id":"w8j_vnd_rs4","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m001-0105","start":105,"end":107,"surface":"項籍","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m001-0119","start":119,"end":121,"surface":"項冠","kind":"person","person_id":"uxv_exs_5k3","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m001-0122","start":122,"end":124,"surface":"周蘭","kind":"person","person_id":"639_jt7_ns0","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m001-0125","start":125,"end":127,"surface":"龍且","kind":"person","person_id":"sr6_5zr_1f3","status":"contextual_provisional"}],"chapter_id":"c-shiji-098-fujin","book_id":"b-shiji-098","work_id":"w-shiji","source_id":"s-shiji-098-fujin"},{"id":"c-shiji-098-fujin:p007","text":"別之河內，擊趙將賁郝軍朝歌，破之，所將卒得騎將二人，車馬二百五十匹。從攻安陽以東，至棘蒲，下七縣。別攻破趙軍，得其將司馬二人，候四人，降吏卒二千四百人。從攻下邯鄲。別下平陽，身斬守相，所將卒斬兵守、郡守各一人，降鄴。從攻朝歌、邯鄲，及別擊破趙軍，降邯鄲郡六縣。還軍敖倉，破項籍軍成皋南，擊絕楚饟道，起滎陽至襄邑。破項冠軍魯下。略地東至繒、郯、下邳，南至蘄、竹邑。擊項悍濟陽下。還擊項籍陳下，破之。別定江陵，降江陵柱國、大司馬以下八人，身得江陵王，生致之雒陽，因定南郡。從至陳，取楚王信，剖符世世勿絕，定食四千六百戶，號信武侯。","annotation_status":"named_mentions_first_pass","