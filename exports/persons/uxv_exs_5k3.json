0063","start":63,"end":65,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-hanshu-041-fanli:m-fu-001-0067","start":67,"end":68,"surface":"寬","kind":"person","person_id":"w8j_vnd_rs4","status":"contextual_provisional"},{"id":"c-hanshu-041-fanli:m-fu-001-0070","start":70,"end":73,"surface":"共德君","kind":"person","person_id":"w8j_vnd_rs4","status":"contextual_provisional"},{"id":"c-hanshu-041-fanli:m-fu-001-0080","start":80,"end":83,"surface":"右騎將","kind":"person","person_id":"w8j_vnd_rs4","status":"contextual_provisional"},{"id":"c-hanshu-041-fanli:m-fu-001-0096","start":96,"end":98,"surface":"項籍","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-hanshu-041-fanli:m-fu-001-0104","start":104,"end":107,"surface":"通德侯","kind":"person","person_id":"w8j_vnd_rs4","status":"contextual_provisional"},{"id":"c-hanshu-041-fanli:m-fu-001-0110","start":110,"end":112,"surface":"項冠","kind":"person","person_id":"uxv_exs_5k3","status":"contextual_provisional"},{"id":"c-hanshu-041-fanli:m-fu-001-0113","start":113,"end":115,"surface":"周蘭","kind":"person","person_id":"639_jt7_ns0","status":"contextual_provisional"},{"id":"c-hanshu-041-fanli:m-fu-001-0116","start":116,"end":118,"surface":"龍且","kind":"person","person_id":"sr6_5zr_1f3","status":"contextual_provisional"}],"chapter_id":"c-hanshu-041-fanli","book_id":"b-hanshu-041","work_id":"w-hanshu","source_id":"s-hanshu-041-fanli"},{"id":"c-hanshu-041-fanli:p-jin-003","text":"別之河內，擊趙賁軍朝歌，破之，所將卒得騎將二人，車馬二百五十匹。從攻安陽以東，至棘蒲，下十縣。別攻破趙軍，得其將司馬二人，候四人，降吏卒二千四百人。從降下邯鄲。別下平陽，身斬守相，所將卒斬兵守郡一人，降鄴。從攻朝歌、邯鄲，又別擊破趙郡，降邯鄲郡六縣。還軍敖倉，破項籍軍成皋南，擊絕楚饟道，起滎陽至襄邑。破項冠魯下。略地東至觞、郯、下邳，南至蘄、竹邑。擊項悍濟陽下。還擊項籍軍陳下，破之。別定江陵，降柱國、大司馬以下八人，身得江陵王，致雒陽，因定南郡。從至陳，取楚王信，剖符世世勿絕，定食四千六百戶，為信武侯。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-hanshu-041-fanli:m-jin-003-0007","start":7,"end":8,"surface":"賁","kind":"person","person_id":"phx_lyu_9ym","status":"contextual_p