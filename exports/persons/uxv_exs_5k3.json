t_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-hanshu-041-fanli:m-fu-001-0110","start":110,"end":112,"surface":"項冠","kind":"person","person_id":"uxv_exs_5k3","status":"contextual_provisional","paragraph_id":"c-hanshu-041-fanli:p-fu-001","chapter_id":"c-hanshu-041-fanli"},{"id":"c-hanshu-041-fanli:m-jin-003-0152","start":152,"end":154,"surface":"項冠","kind":"person","person_id":"uxv_exs_5k3","status":"contextual_provisional","paragraph_id":"c-hanshu-041-fanli:p-jin-003","chapter_id":"c-hanshu-041-fanli"},{"id":"c-shiji-095-fankuang:m024-0224","start":224,"end":226,"surface":"項冠","kind":"person","person_id":"uxv_exs_5k3","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p024","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-098-fujin:m001-0119","start":119,"end":121,"surface":"項冠","kind":"person","person_id":"uxv_exs_5k3","status":"contextual_provisional","paragraph_id":"c-shiji-098-fujin:p001","chapter_id":"c-shiji-098-fujin"},{"id":"c-shiji-098-fujin:m007-0157","start":157,"end":159,"surface":"項冠","kind":"person","person_id":"uxv_exs_5k3","status":"contextual_provisional","paragraph_id":"c-shiji-098-fujin:p007","chapter_id":"c-shiji-098-fujin"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-hanshu041-fujin-022","person_id":"uxv_exs_5k3","surfaces":["項冠"],"scope":"cross_chapter","chapter_ids":["c-hanshu-041-fanli","c-shiji-098-fujin"],"status":"contextual_provisional","evidence":[{"work_id":"w-hanshu","book_id":"b-hanshu-041","chapter_id":"c-hanshu-041-fanli","source_id":"s-hanshu-041-fanli","paragraph_id":"c-hanshu-041-fanli:p-fu-001","quote":"傅寬，以魏五大夫騎將從，為舍人，起橫陽。從攻安陽、杠里，趙賁軍於開封，及擊楊熊曲遇、陽武，斬首十二級，賜爵卿。從至霸上。沛公為漢王，賜寬封號共德君。從入漢中，為右騎將。定三秦，賜食邑雕陰。從擊項籍，待懷，賜爵通德侯。從擊項冠、周蘭、龍且，所將卒斬騎將一人敖下，益食邑。","mention_ids":["c-hanshu-041-fanli:m-fu-001-0110"]},{"work_id":"w-hanshu","book_id":"b-hanshu-041","chapter_id":"c-hanshu-041-fanli","source_id":"s-hanshu-041-fanli","paragraph_id":"c-hanshu-041-fanli:p-jin-003","quote":"別之河內，擊趙賁軍朝歌，破之，所將卒得騎將二人，車馬二百五十匹。從攻安陽以東，至棘蒲，下十縣。別攻破趙軍，得其將司馬二人，候四人，降吏卒二千四百人。從降下邯鄲。別下平陽，身斬守相，所將卒斬兵守郡一人，降鄴。從攻朝歌、邯鄲，又別擊破趙郡，降邯鄲郡六縣。還軍敖倉，破項籍軍成皋南，擊絕楚饟道，起滎陽至襄邑。破項冠魯下。略地東至觞、郯、下邳，南至蘄、竹邑。擊項悍濟陽下。還擊項籍軍陳下，破之。別定江陵，降柱國、大司馬以下八人，身得江陵王，致雒陽，因定南郡。從至陳，取楚王信，剖符世世勿絕，定食四千六百戶，為信武侯。","mention_ids":["c-hanshu-041-fanli:m-jin-003-0152"]},{"work_id":"w-shiji","book_id":"b-shiji-098","chapter_id":"c-shiji-098-fujin","source_id":"s-shiji-098-fujin","paragraph_id":"c-shiji-098-fujin:p001","quote":"陽陵侯傅寬，以魏五大夫騎將從，為舍人，起橫陽。從攻安陽、杠里，擊趙賁軍於開封，及擊楊熊曲遇、陽武，斬首十二級，賜爵卿。從至霸上。沛公立為漢王，漢王賜寬封號共德君。從入漢中，遷為右騎將。從定三秦，賜食邑雕陰。從擊項籍，待懷，賜爵通德侯。從擊項冠、周蘭、龍且，所將卒斬騎將一人敖下，益食邑。","mention_ids":["c-shiji-098-fujin:m001-0119"]},{"work_id":"w-shiji","book_id":"b-shiji-098","chapter_id":"c-shiji-098-fujin","source_id":"s-shiji-098-fujin","paragraph_id":"c-shiji-098-fujin:p007","quote":"別之河內，擊趙將賁郝軍朝歌，破之，所將卒得騎將二人，車馬二百五十匹。從攻安陽以東，至棘蒲，下七縣。別攻破趙軍，得其將司馬二人，候四人，降吏卒二千四百人。從攻下邯鄲。別下平陽，身斬守相，所將卒斬兵守、郡守各一人，降鄴。從攻朝歌、邯鄲，及別擊破趙軍，降邯鄲郡六縣。還軍敖倉，破項籍軍成皋南，擊絕楚饟道，起滎陽至襄邑。破項冠軍魯下。略地東至繒、郯、下邳，南至蘄、竹邑。擊項悍濟陽下。還擊項籍陳下，破之。別定江陵，降江陵柱國、大司馬以下八人，身得江陵王，生致之雒陽，因定南郡。從至陳，取楚王信，剖符世世勿絕，定食四千六百戶，號信武侯。","mention_ids":["c-shiji-098-fujin:m007-0157"]}],"rationale":"依傅寬、靳歙兩傳主語及與史記同一戰事、同官同名對讀；官稱依其修飾的人分辨，不由最近姓名或全域字串決定。 兩書及同書版本互見不計獨立史實票數；原字與錨點分存。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"d-shiji095-092","person_id":"uxv_exs_5k3","scope":"same_chapter","chapter_ids":["c-shiji-095-fankuang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["項冠"],"evidence":[{"paragraph_id":"c-shiji-095-fankuang:p024","quote":"復以中謁者從降下碭，以至彭城。項羽擊，大破漢王。漢王遁而西，嬰從還，軍於雍丘。王武、魏公申徒反，從擊破之。攻下黃，西收兵，軍於滎陽。楚騎來眾，漢王乃擇軍中可為（車）騎將者，皆推故秦騎士重泉人李必、駱甲習騎兵，今為校尉，可為騎將。漢王欲拜之，必、甲曰：「臣故秦民，恐軍不信臣，臣願得大王左右善騎者傅之。」灌嬰雖少，然數力戰，乃拜灌嬰為中大夫，令李必、駱甲為左右校尉，將郎中騎兵擊楚騎於滎陽東，大破之。受詔別擊楚軍後，絕其餉道，起陽武至襄邑。擊項羽之將項冠於魯下，破之，所將卒斬右司馬、騎將各一人。擊破柘公王武，軍於燕西，所將卒斬樓煩將五人，連尹一人。擊王武別將桓嬰白馬下，破之，所將卒斬都尉一人。以騎渡河南，送漢王到雒陽，使北迎相國韓信軍於邯鄲。還至敖倉，嬰遷為御史大夫。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定異稱。酈寄字況據第14段；夏侯嬰的嬰限定第16至21段，灌嬰限定第22至33段，桓嬰另人。第6與20、28段楚王信和反韓王信分人；未詳名王侯不補名。同名跨篇同指另待逐項證據。"},{"id":"d-shiji098-013","person_id":"uxv_exs_5k3","surfaces":["項冠"],"scope":"same_chapter","chapter_ids":["c-shiji-098-fujin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-098-fujin:p001","quote":"陽陵侯傅寬，以魏五大夫騎將從，為舍人，起橫陽。從攻安陽、杠里，擊趙賁軍於開封，及擊楊熊曲遇、陽武，斬首十二級，賜爵卿。從至霸上。沛公立為漢王，漢王賜寬封號共德君。從入漢中，遷為右騎將。從定三秦，賜食邑雕陰。從擊項籍，待懷，賜爵通德侯。從擊項冠、周蘭、龍且，所將卒斬騎將一人敖下，益食邑。"},{"paragraph_id":"c-shiji-098-fujin:p007","quote":"別之河內，擊趙將賁郝軍朝歌，破之，所將卒得騎將二人，車馬二百五十匹。從攻安陽以東，至棘蒲，下七縣。別攻破趙軍，得其將司馬二人，候四人，降吏卒二千四百人。從攻下邯鄲。別下平陽，身斬守相，所將卒斬兵守、郡守各一人，降鄴。從攻朝歌、邯鄲，及別擊破趙軍，降邯鄲郡六縣。還軍敖倉，破項籍軍成皋南，擊絕楚饟道，起滎陽至襄邑。破項冠軍魯下。略地東至繒、郯、下邳，南至蘄、竹邑。擊項悍濟陽下。還擊項籍陳下，破之。別定江陵，降江陵柱國、大司馬以下八人，身得江陵王，生致之雒陽，因定南郡。從至陳，取楚王信，剖符世世勿絕，定食四千六百戶，號信武侯。"}],"rationale":"依傅寬、靳歙、周緤分段敘事及明示姓名定位；楚王信與平城下韓信分存，單稱參勃哙敞不補姓，兩位信武侯分持有人，周昌不按同名跨篇合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji095-remaining-xiangguan","person_ids":["uxv_exs_5k3"],"canonical_person_id":"uxv_exs_5k3","scope":"cross_chapter","chapter_ids":["c-shiji-095-fankuang","c-shiji-098-fujin"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-095-fankuang","source_id":"s-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p024","quote":"復以中謁者從降下碭，以至彭城。項羽擊，大破漢王。漢王遁而西，嬰從還，軍於雍丘。王武、魏公申徒反，從擊破之。攻下黃，西收兵，軍於滎陽。楚騎來眾，漢王乃擇軍中可為（車）騎將者，皆推故秦騎士重泉人李必、駱甲習騎兵，今為校尉，可為騎將。漢王欲拜之，必、甲曰：「臣故秦民，恐軍不信臣，臣願得大王左右善騎者傅之。」灌嬰雖少，然數力戰，乃拜灌嬰為中大夫，令李必、駱甲為左右校尉，將郎中騎兵擊楚騎於滎陽東，大破之。受詔別擊楚軍後，絕其餉道，起陽武至襄邑。擊項羽之將項冠於魯下，破之，所將卒斬右司馬、騎將各一人。擊破柘公王武，軍於燕西，所將卒斬樓煩將五人，連尹一人。擊王武別將桓嬰白馬下，破之，所將卒斬都尉一人。以騎渡河南，送漢王到雒陽，使北迎相國韓信軍於邯鄲。還至敖倉，嬰遷為御史大夫。","mention_ids":["c-shiji-095-fankuang:m024-0224"]},{"chapter_id":"c-shiji-098-fujin","source_id":"s