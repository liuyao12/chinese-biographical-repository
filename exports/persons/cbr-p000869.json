dicate":"spouse","object_person_id":"vfv_a3d_lsq","status":"source_attested","evidence":[{"paragraph_id":"c-shiji-009-lvhou:p022","quote":"朱虛侯婦，呂祿女","chapter_id":"c-shiji-009-lvhou","source_id":"s-shiji-009-lvhou"}],"qualifiers":{"source_term":"婦","historicity":"historical_tradition"},"interpretation_note":"僅保存原文明示主張，不補闕代、同父同母或未見姓名；不推導少帝生物父親。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-009-lvhou:p022","text":"朱虛侯劉章有氣力，東牟侯興居其弟也。皆齊哀王弟，居長安。當是時，諸呂用事擅權，欲為亂，畏高帝故大臣絳、灌等，未敢發。朱虛侯婦，呂祿女，陰知其謀。恐見誅，乃陰令人告其兄齊王，欲令發兵西，誅諸呂而立。朱虛侯欲從中與大臣為應。齊王欲發兵，其相弗聽。八月丙午，齊王欲使人誅相，相召平乃反，舉兵欲圍王，王因殺其相，遂發兵東，詐奪瑯邪王兵，并將之而西。語在齊王語中。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-009-lvhou:m022-0000","start":0,"end":3,"surface":"朱虛侯","kind":"person","person_id":"vfv_a3d_lsq","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m022-0003","start":3,"end":5,"surface":"劉章","kind":"person","person_id":"vfv_a3d_lsq","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m022-0012","start":12,"end":14,"surface":"興居","kind":"person","person_id":"pdj_awg_50i","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m022-0019","start":19,"end":22,"surface":"齊哀王","kind":"person","person_id":"9z1_xoi_i0i","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m022-0044","start":44,"end":46,"surface":"高帝","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m022-0049","start":49,"end":50,"surface":"絳","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定官稱；不補造姓名或把身世指控當定論。"},{"id":"c-shiji-009-lvhou:m022-0051","start":51,"end":52,"surface":"灌","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定官稱；不補造姓名或把身世指控當定論。"},{"id":"c-shiji-009-lvhou:m022-0058","start