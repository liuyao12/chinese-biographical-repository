{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"vsc_abq_hpr","canonical_person_id":"vsc_abq_hpr","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["vsc_abq_hpr"],"persons":[{"id":"vsc_abq_hpr","label":"安陸王子敬","status":"active","historicity":"historical_tradition","aliases":[{"surface":"安陸王","mention_ids":["c-nanqishu-042-jiangshi-complete:p002:m0097"]}],"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-021","chapter_id":"c-nanshi-021-wangrong","source_id":"s-nanshi-021-wangrong-ws1752646","paragraph_id":"c-nanshi-021-wangrong:p006","quote":"安陸王","kind":"person_reference","mention_id":"c-nanshi-021-wangrong:p006:r0215"},{"mention_id":"c-nanqishu-042-jiangshi-complete:p002:m0097","paragraph_id":"c-nanqishu-042-jiangshi-complete:p002","chapter_id":"c-nanqishu-042-jiangshi-complete","quote":"安陸王"}],"review":"ai_provisional","identity_note":"與南齊47王融傳及南史21校讀，詳本文來源記錄。"}],"source_mention_summary":[{"source_id":"s-nanqishu-042-jiangshi-complete-ws1507997","work_id":"w-nanqishu","book_id":"b-nanqishu-042","chapter_id":"c-nanqishu-042-jiangshi-complete","raw_mention_count":1,"mention_ids":["c-nanqishu-042-jiangshi-complete:p002:m0097"],"paragraph_ids":["c-nanqishu-042-jiangshi-complete:p002"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-nanqishu-042-jiangshi-complete:p002:m0097","mention_ids":["c-nanqishu-042-jiangshi-complete:p002:m0097"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-nanqishu-042-jiangshi-complete-ws1507997"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-042-jiangshi-complete:p002:m0097","start":97,"end":100,"surface":"安陸王","kind":"person","person_id":"vsc_abq_hpr","status":"contextual_provisional","paragraph_id":"c-nanqishu-042-jiangshi-complete:p002","chapter_id":"c-nanqishu-042-jiangshi-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"person_references":[{"start":215,"end":218,"surface":"安陸王","id":"c-nanshi-021-wangrong:p006:r0215","paragraph_id":"c-nanshi-021-wangrong:p006","person_id":"vsc_abq_hpr","referent_role":"third_person","quote":"郁林深怨融，即位十餘日，收下廷尉獄。使中丞孔珪倚爲奏曰：「融姿性剛險，立身浮競，動跡驚群，抗言異類。近塞外微塵，苦求將領，遂招納不逞，扇誘荒傖。狡弄威聲，專行權利，反復唇齒之間，傾動頰舌之內，威福自己，無所忌憚，誹謗朝政，曆毀王公。謂己才流，無所推下，事暴遠近，使融依源據答。」融辭曰：「囚實頑蔽，觸行多愆。但夙忝門素，得奉教君子。爰自總發，迄將立年，州閭鄉党，見許愚慎。過蒙大行皇帝獎育之恩，又荷文皇帝識擢之重，司徒公賜預士林，安陸王曲垂盼接，前後陳伐虜之計，亦仰簡先朝。今段犬羊乍擾，令囚草撰符詔。及司徒宣敕招募，同例非一，實以戎事不小，不敢承教。續蒙軍號，賜使招集，銜敕而行，非敢虛扇。且'張弄威聲'，應有形跡。'專行權利'，又無贓賄。'反復唇齒之間'，未審悉與誰言？'傾動頰舌之內'，不容都無主此。自上甘露頌及銀甕啟、三日詩序、接虜使語辭，竭思稱揚，得非誹謗。囚才分本劣，謬被策用，悚怍之情，夙宵兢惕，自循自省，並愧流言。伏惟明皇臨宇，普天蒙澤，戊寅赦恩，輕重必宥，百日曠期，始蒙旬日，一介罪身，獨嬰憲劾。」融被收，朋友部曲，參問北寺，相繼於道；請救於子良，子良不敢救；西昌侯固爭不得。詔于獄賜死，時年二十七。臨死歎曰：「我若不爲百歲老母，當吐一言。」融意欲指斥帝在東宮時過失也。先是，太學生會稽魏准，以才學爲融所賞，既欲奉子良，而准鼓成其事。太學生虞羲、丘國賓竊相謂曰：「竟陵才弱，王中書無斷，敗在眼中矣。」及融誅，召准入舍人省詰問，遂懼而死，舉體皆青，時人以准膽破。融文集行于時。","note":"本句按敘述視點回指安陸。","chapter_id":"c-nanshi-021-wangrong","book_id":"b-nanshi-021","work_id":"w-nanshi","source_id":"s-nanshi-021-wangrong-ws1752646"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-042-jiangshi-complete:p002","text":"　　祏姑爲景皇后，少爲高宗所親，恩如兄弟。宋末，解褐晉熙國常侍，太祖徐州西曹，員外郎，高宗冠軍參軍，帶灄陽令，竟陵王征北參軍，尚書水部郎。高宗爲吳興，以祏爲郡丞，加宣威將軍，廬陵王中軍功曹記室，安陸王左軍諮議，領錄事，帶京兆太守。除通直郎，補南徐州別駕。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":70,"last_line":70,"raw_start":4718,"raw_end":4845,"raw_character_offsets":[4718,4719,4720,4721,4722,4723,4724,4725,4726,4727,4728,4729,4730,4731,4732,4733,4734,4735,4736,4737,4738,4739,4740,4741,4742,4743,4744,4745,4746,4747,4748,4749,4750,4751,4752,4753,4754,4755,4756,4757,4758,4759,4760,4761,4762,4763,4764,4765,4766,4767,4768,4769,4770,4771,4772,4773,4774,4775,4776,4777,4778,4779,4780,4781,4782,4783,4784,4785,4786,4787,4788,4789,4790,4791,4792,4793,4794,4795,4796,4797,4798,4799,4800,4801,4802,4803,4804,4805,4806,4807,4808,4809,4810,4811,4812,4813,4814,4815,4816,4817,4818,4819,4820,4821,4822,4823,4824,4825,4826,4827,4828,4829,4830,4831,4832,4833,4834,4835,4836,4837,4838,4839,4840,4841,4842,4843,4844],"revision_id":1507997},"mentions":[{"id":"c-nanqishu-042-jiangshi-complete:p002:m0002","start":2,"end":3,"surface":"祏","kind":"person","person_id":"q63_4br_3of_A","status":"contextual_provisional"},{"id":"c-nanqishu-042-jiangshi-complete:p002:m0005","start":5,"end":8,"surface":"景皇后","kind":"person","person_id":"069_dn8_o4r_A","status":"contextual_provisional"},{"id":"c-nanqishu-042-jiangshi-complete:p002:m0011","start":11,"end":13,"surface":"高宗","kind":"person","person_id":"w4m_9tw_147","status":"contextual_provisional"},{"id":"c-nanqishu-042-jiangshi-complete:p002:m0032","start":32,"end":34,"surface":"太祖","kind":"person","person_id":"47p_kjh_ez7","status":"contextual_provisional"},{"id":"c-nanqishu-042-jiangshi-complete:p002:m0043","start":43,"end":45,"surface":"高宗","kind":"person","person_id":"w4m_9tw_147","status":"contextual_provisional"},{"id":"c-nanqishu-042-jiangshi-complete:p002:m0055","start":55,"end":58,"surface":"竟陵王","kind":"person","person_id":"x3q_cqm_dup","status":"contextual_provisional"},{"id":"c-nanqishu-042-jiangshi-complet