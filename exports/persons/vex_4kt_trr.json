ntions":[{"id":"c-jinshu-066-taokan:p002:m0193","surface":"黃慶","start":193,"end":195,"person_id":"vex_4kt_trr","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-066-taokan:p002","chapter_id":"c-jinshu-066-taokan"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-066-taokan:p002","text":"夔察侃為孝廉，至洛陽，數詣張華。華初以遠人，不甚接遇。侃每往，神無忤色。華後與語，異之。除郎中。伏波將軍孫秀以亡國支庶，府望不顯，中華人士恥為掾屬，以侃寒宦，召為舍人。時豫章國郎中令楊晫，侃州裏也，為鄉論所歸。侃詣之，晫曰：「《易》稱『貞固足以幹事』，陶士行是也。」與同乘見中書郎顧榮，榮甚奇之。吏部郎溫雅謂晫曰：「奈何與小人共載？」晫曰：「此人非凡器也。」尚書樂廣欲會荊揚士人，武庫令黃慶進侃於廣。人或非之，慶曰：「此子終當遠到，復何疑也！」慶後為吏部令史，舉侃補武岡令。與太守呂岳有嫌，棄官歸，為郡小中正。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":31,"last_line":31,"raw_start":3128,"raw_end":3389,"raw_character_offsets":[3130,3131,3132,3133,3134,3135,3136,3137,3138,3139,3140,3141,3142,3143,3144,3145,3146,3147,3148,3149,3150,3151,3152,3153,3154,3155,3156,3157,3158,3159,3160,3161,3162,3163,3164,3165,3166,3167,3168,3169,3170,3171,3172,3173,3174,3175,3176,3177,3178,3179,3180,3181,3182,3183,3184,3185,3186,3187,3188,3189,3190,3191,3192,3193,3194,3195,3196,3197,3198,3199,3200,3201,3202,3203,3204,3205,3206,3207,3208,3209,3210,3211,3212,3213,3214,3215,3216,3217,3218,3219,3220,3221,3222,3223,3224,3225,3226,3227,3228,3229,3230,3231,3232,3233,3234,3235,3236,3237,3238,3239,3240,3241,3242,3243,3246,3249,3250,3251,3252,3253,3254,3255,3256,3257,3258,3259,3260,3261,3262,3263,3264,3265,3266,3267,3268,3269,3270,3271,3272,3273,3274,3275,3276,3277,3278,3279,3280,3281,3282,3283,3284,3285,3286,3287,3288,3289,3290,3291,3292,3293,3294,3295,3296,3297,3298,3299,3300,3301,3302,3303,3304,3305,3306,3307,3308,3309,3310,3311,3312,3313,3314,3315,3316,3317,3318,3319,3320,3321,3322,3323,3324,3325,3326,3327,3328,3329,3330,3331,3332,3333,3334,3335,3336,3337,3338,3339,3340,3341,3342,3343,3344