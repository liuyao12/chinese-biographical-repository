","family_path":{"connection":"father","generation_distance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-038-song","source_id":"s-shiji-038-song","paragraph_id":"c-shiji-038-song:p001","quote":"微子開者，殷帝乙之首子而帝紂之庶兄也。紂既立，不明，淫亂於政，微子數諫，紂不聽。及祖伊以周西伯昌之修德，滅黎國，懼禍至，以告紂。紂曰：「我生不有命在天乎？是何能爲！」於是微子度紂終不可諫，欲死之，及去，未能自決，乃問於太師、少師曰：「殷不有治政，不治四方。我祖遂陳於上，紂沈湎於酒，婦人是用，亂敗湯德於下。殷既小大好草竊姦宄，卿士師師非度，皆有罪辜，乃无維獲，小民乃并興，相爲敵讎。今殷其典喪！若涉水无津涯。殷遂喪，越至于今。」曰：「太師，少師，我其發出往？吾家保于喪？今女无故告予，顛躋，如之何其？」太師若曰：「王子，天篤下菑亡殷國，乃毋畏畏，不用老長。今殷民乃陋淫神祇之祀。今誠得治國，國治身死不恨。爲死，終不得治，不如去。」遂亡。","source_term":"殷帝乙之首子"}],"source_assertion_id":"a-shiji038-001","interpretation_note":"以此受傳正文的明示近親主張配置局部家族；不合併跨篇候選身份、不補闕名世代，不表示遠祖世系已核實。分支字元不是長幼排行。","reviewer":"Codex（AI 代理）","parent_person_id":"buv_igi_gpn"},"id_aliases":["cbr-p000135"]}],"source_mention_summary":[{"source_id":"s-shiji-003-yin","work_id":"w-shiji","book_id":"b-shiji-003","chapter_id":"c-shiji-003-yin","mention_count":1,"mention_ids":["c-shiji-003-yin:m027-0010"],"paragraph_ids":["c-shiji-003-yin:p027"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-003-yin"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji003-049","subject_person_id":"buv_igi_gpn_A","predicate":"mother","object_person_id":"3co_cqa_4uq","status":"source_attested","evidence":[{"paragraph_id":"c-shiji-003-yin:p027","quote":"微子啓，啓母賤","chapter_id":"c-shiji-003-yin","source_id":"s-shiji-003-yin"}],"qualifiers":{"source_term":"母","historicity":"historical_tradition"},"interpretation_note":"保存原文明示關係；不把繼位本身當作父子證據，未與出土材料對讀。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sh