:[{"mention_id":"c-shiji-113-nanyue:m006-0097","chapter_id":"c-shiji-113-nanyue","paragraph_id":"c-shiji-113-nanyue:p006","quote":"次公"}],"family_path":{"connection":"father","generation_distance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-113-nanyue","source_id":"s-shiji113-nanyue","paragraph_id":"c-shiji-113-nanyue:p006","quote":"嬰齊代立，即藏其先武帝璽。嬰齊其入宿衛在長安時，取邯鄲樛氏女，生子興。及即位，上書請立樛氏女為后，興為嗣。漢數使使者風諭嬰齊，嬰齊尚樂擅殺生自恣，懼入見要用漢法，比內諸侯，固稱病，遂不入見。遣子次公入宿衛。嬰齊薨，謚為明王。"}],"source_assertion_id":"a-shiji113-006","interpretation_note":"分支字元不表排行；只接明示父系來源，闕代不造父親。","reviewer":"Codex（AI 代理）","parent_person_id":"f4l_jyl_oqv"}},{"id":"f4l_jyl_oqv_C","label":"建德（南越列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"建德","mention_ids":["c-shiji-113-nanyue:m009-0303","c-shiji-113-nanyue:m009-0457","c-shiji-113-nanyue:m011-0082","c-shiji-113-nanyue:m011-0192","c-shiji-113-nanyue:m011-0245"]}],"evidence":[{"mention_id":"c-shiji-113-nanyue:m009-0303","chapter_id":"c-shiji-113-nanyue","paragraph_id":"c-shiji-113-nanyue:p009","quote":"建德"},{"mention_id":"c-shiji-113-nanyue:m009-0457","chapter_id":"c-shiji-113-nanyue","paragraph_id":"c-shiji-113-nanyue:p009","quote":"建德"},{"mention_id":"c-shiji-113-nanyue:m011-0082","chapter_id":"c-shiji-113-nanyue","paragraph_id":"c-shiji-113-nanyue:p011","quote":"建德"},{"mention_id":"c-shiji-113-nanyue:m011-0192","chapter_id":"c-shiji-113-nanyue","paragraph_id":"c-shiji-113-nanyue:p011","quote":"建德"},{"mention_id":"c-shiji-113-nanyue:m011-0245","chapter_id":"c-shiji-113-nanyue","paragraph_id":"c-shiji-113-nanyue:p011","quote":"建德"}],"family_path":{"connection":"father","generation_distance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-113-nanyue","source_id":"s-shiji113-nanyue","paragraph_id":"c-shiji-113-nanyue:p009","quote":"天子聞嘉不聽王，王、王太后弱孤不能制，使者怯無決。又以為王、王太后已附漢，獨呂嘉為亂，不足以興兵，欲使莊參以二千人往使。參曰：「以好往，數人足矣；以武往，二千人無足以為也。」辭不可，天子罷參也。郟壯士故濟北相韓千秋奮曰：「以區區之越，又有王、太后應，獨相呂嘉為害，願得勇士二百人，必斬嘉以報。」於是天子遣千秋與王太后弟樛樂將二千人往，入越境。呂嘉等乃遂反，下令國中曰：「王年少。太後，中國人也，又與使者亂，專欲內屬，盡持先王寶器入獻天子以自媚，多從人，行至長安，虜賣以為僮仆。取自脫一時之利，無顧趙氏社稷，為萬世慮計之意。」乃與其弟將卒攻殺王、太后及漢使者。遣人告蒼梧秦王及其諸郡縣，立明王長男越妻子術陽侯建德為王。而韓千秋兵入，破數小邑。其後越直開道給食，未至番禺四十里，越以兵擊千秋等，遂滅之。使人函封漢使者節置塞上，好為謾辭謝罪，發兵守要害處。於是天子曰：「韓千秋雖無成功，亦軍鋒之冠。」封其子延年為成安侯。樛樂，其姊為王太后，首願屬漢，封其子廣德為龍亢侯。乃下赦曰：「天子微，諸侯力政，譏臣不討賊。今呂嘉、建德等反，自立晏如，令罪人及江淮以南樓船十萬師往討之。」"}],"source_assertion_id":"a-shiji113-007","interpretation_note":"分支字元不表排行；只接明示父系來源，闕代不造父親。","reviewer":"Codex（AI 代理）","parent_person_id":"f4l_jyl_oqv"}}],"source_mention_summary":[{"source_id":"s-shiji113-nanyue","work_id":"w-shiji","book_id":"b-shiji-113","chapter_id":"c-shiji-113-nanyue","mention_count":11,"mention_ids":["c-shiji-113-nanyue:m005-0039","c-shiji-113-nanyue:m005-0160","c-shiji-113-nanyue:m006-0000","c-shiji-113-nanyue:m006-0013","c-shiji-113-nanyue:m006-0060","c-shiji-113-nanyue:m006-0063","c-shiji-113-nanyue:m006-0103","c-shiji-113-nanyue:m007-0017","c-shiji-113-nanyue:m007-0034","c-shiji-113-nanyue:m009-0293","c-shiji-113-nanyue:m013-0047"],"paragraph_ids":["c-shiji-113-nanyue:p005","c-shiji-113-nanyue:p006","c-shiji-113-nanyue:p007","c-shiji-113-nanyue:p009","c-shiji-113-nanyue:p013"],"table_cell_ids":[],"passage_count":5}],"most_mentioned_source_ids":["s-shiji113-nanyue"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji113-003","subject_person_id":"f4l_jyl_oqv","predicate":"spouse","object_person_id":"3q4_zsp_jwy","status":"source_attested","evidence":[{"chapter_id":"c-shiji-113-nanyue","source_id":"s-shiji113-nanyue","paragraph_id":"c-shiji-113-nanyue:p006","quote":"嬰齊代立，即藏其先武帝璽。嬰齊其入宿衛在長安時，取邯鄲樛氏女，生子興。及即位，上書請立樛氏女為后，興為嗣。漢數使使者風諭嬰齊，嬰齊尚樂擅殺生自恣，懼入見要用漢法，比內諸侯，固稱病，遂不入見。遣子次公入宿衛。嬰齊薨，謚為明王。"}],"qualifiers":{"source_term":"取邯鄲樛氏女"