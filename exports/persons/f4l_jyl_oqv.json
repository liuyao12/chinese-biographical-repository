25","start":425,"end":427,"surface":"廣德","kind":"person","person_id":"tz9_dhl_ifo_A","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m009-0438","start":438,"end":440,"surface":"天子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-113-nanyue:m009-0454","start":454,"end":456,"surface":"呂嘉","kind":"person","person_id":"jfm_184_2yb","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m009-0457","start":457,"end":459,"surface":"建德","kind":"person","person_id":"f4l_jyl_oqv_C","status":"contextual_provisional"}],"chapter_id":"c-shiji-113-nanyue","book_id":"b-shiji-113","work_id":"w-shiji","source_id":"s-shiji113-nanyue"},{"id":"c-shiji-113-nanyue:p013","text":"尉佗之王，本由任囂。遭漢初定，列為諸侯。隆慮離溼疫，佗得以益驕。甌駱相攻，南越動搖。漢兵臨境，嬰齊入朝。其後亡國，徵自樛女；呂嘉小忠，令佗無後。樓船從欲，怠傲失惑；伏波困窮，智慮愈殖，因禍為福。成敗之轉，譬若糾墨。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-113-nanyue:m013-0000","start":0,"end":2,"surface":"尉佗","kind":"person","person_id":"r3c_eue_cqn","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m013-0007","start":7,"end":9,"surface":"任囂","kind":"person","person_id":"e8q_4ar_5bh","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m013-0020","start":20,"end":22,"surface":"隆慮","kind":"person","person_id":"cnz_t0f_oaz","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m013-0026","start":26,"end":27,"surface":"佗","kind":"person","person_id":"r3c_eue_cqn","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m013-0047","start":47,"end":49,"surface":"嬰齊","kind":"person","person_id":"f4l_jyl_oqv","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m013-0059","start":59,"end":61,"surface":"樛女","kind":"person","person_id":"3q4_zsp_jwy","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m013-0062","start":62,"end":64,"surface":"呂嘉","kind":"person","person_id":"jfm_184_2yb","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m013-0068","start":68,"end":69,"surface