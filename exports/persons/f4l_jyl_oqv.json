"person","person_id":"f4l_jyl_oqv","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m005-0165","start":165,"end":166,"surface":"胡","kind":"person","person_id":"r3c_eue_cqn_*A","status":"contextual_provisional"}],"chapter_id":"c-shiji-113-nanyue","book_id":"b-shiji-113","work_id":"w-shiji","source_id":"s-shiji113-nanyue"},{"id":"c-shiji-113-nanyue:p006","text":"嬰齊代立，即藏其先武帝璽。嬰齊其入宿衛在長安時，取邯鄲樛氏女，生子興。及即位，上書請立樛氏女為后，興為嗣。漢數使使者風諭嬰齊，嬰齊尚樂擅殺生自恣，懼入見要用漢法，比內諸侯，固稱病，遂不入見。遣子次公入宿衛。嬰齊薨，謚為明王。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-113-nanyue:m006-0000","start":0,"end":2,"surface":"嬰齊","kind":"person","person_id":"f4l_jyl_oqv","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m006-0009","start":9,"end":11,"surface":"武帝","kind":"person","person_id":"r3c_eue_cqn","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m006-0013","start":13,"end":15,"surface":"嬰齊","kind":"person","person_id":"f4l_jyl_oqv","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m006-0027","start":27,"end":30,"surface":"樛氏女","kind":"person","person_id":"3q4_zsp_jwy","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m006-0033","start":33,"end":34,"surface":"興","kind":"person","person_id":"f4l_jyl_oqv_A","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m006-0043","start":43,"end":46,"surface":"樛氏女","kind":"person","person_id":"3q4_zsp_jwy","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m006-0049","start":49,"end":50,"surface":"興","kind":"person","person_id":"f4l_jyl_oqv_A","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m006-0060","start":60,"end":62,"surface":"嬰齊","kind":"person","person_id":"f4l_jyl_oqv","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m006-0063","start":63,"end":65,"surface":"嬰齊","kind":"person","person_id":"f4l_jyl_oqv","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m006-0097","start":97,"end":99,"surface":"次公","kind":"person","person_id":"f4l_jyl_oqv_B","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m006-0103","start":103,"end":105,"surface":"嬰齊","kind":"person","person_id":"f4l_jyl_oqv","status":"contextual_provisional"}],"chapter_id":"c-shiji-113-nanyue","book_id":"b-shiji-113","work_id":"w-shiji","source_id":"s-shiji113-nanyue"},{"id":"c-shiji-113-nanyue:p007","text":"太子興代立，其母為太后。太后自未為嬰齊姬時，嘗與霸陵人安國少季通。及嬰齊薨後，元鼎四年，漢使安國少季往諭王、王太后以入朝，比內諸侯；令辯士諫大夫終軍等宣其辭，勇士魏臣等輔其缺，衛尉路博德將兵屯桂陽，待使者。王年少，太後中國人也，嘗與安國少季通，其使復私焉。國人頗知之，多不附太后。太后恐亂起，亦欲倚漢威，數勸王及群臣求內屬。即因使者上書，請比內諸侯，三歲一朝，除邊關。於是天子許之，賜其丞相呂嘉銀印，及內史、中尉、太傅印，餘得自置。除其故黥劓刑，用漢法，比內諸侯。使者皆留填撫之。王、王太后飭治行裝重齎，為入朝具。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-113-nanyue:m007-0002","start":2,"end":3,"surface":"興","kind":"person","person_id":"f4l_jyl_oqv_A","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m007-0009","start":9,"end":11,"surface":"太后","kind":"person","person_id":"3q4_zsp_jwy","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m007-0012","start":12,"end":14,"surface":"太后","kind":"person","person_id":"3q4_zsp_jwy","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m007-0017","start":17,"end":19,"surface":"嬰齊","kind":"person","person_id":"f4l_jyl_oqv","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m007-0027","start":27,"end":31,"surface":"安國少季","kind":"person","person_id":"u20_r6q_88g","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m007-0034","start":34,"end":36,"surface":"嬰齊","kind":"person","person_id":"f4l_jyl_oqv","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m007-0046","start":46,"end":50,"surface":"安國少季","kind":"person","person_id":"u20_r6q_88g","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m007-0052","start":52,"end":53,"surface":"王","kind":"person","person_id":"f4l_jyl_oqv_A","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m007-0054","start":54,"end":57,"surface":"王太后","kind":"person","person_id":"3q4_zsp_jwy","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m007-0072","start":72,"end":74,"surface":"終軍","kind":"person","person_id":"0zx_6sy_dup","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m007-0081","start":81,"end":83,"surface":"魏臣","kind":"person","person_id":"mc3_mrl_iii","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m007-0090","start":90,"end":93,"surface":"路博德","kind":"person","person_id":"vib_10x_51n","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m007-0103","start":103,"end":104,"surface":"王","kind":"person","person_id":"f4l_jyl_oqv_A","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m007-0107","start":107,"end":109,"surface":"太後","kind":"person","person_id":"3q4_zsp_jwy","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m007-0116","start":116,"end":120,"surface":"安國少季","kind":"person","person_id":"u20_r6q_88g","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m007-0137","start":137,"end":139,"surface":"太后","kind":"person","person_id":"3q4_zsp_jwy","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m007-0140","start":140,"end":142,"surface":"太后","kind":"person","person_id":"3q4_zsp_jwy","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m007-0154","start":154,"end":155,"surface":"王","kind":"person","person_id":"f4l_jyl_oqv_A","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m007-0186","start":186,"end":188,"surface":"天子","kind":"person","person_id":"g0x_vmx_2lg","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m007-0195","start":195,"end":197,"surface":"呂嘉","kind":"person","person_id":"jfm_184_2yb","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m007-0240","start":240,"end":241,"surface":"王","kind":"person","person_id":"f4l_jyl_oqv_A","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m007-0242","start":242,"end":245,"surface":"王太后","kind":"person","person_id":"3q4_zsp_jwy","status":"contextual_provisional"}],"chapter_id":"c-shiji-113-nanyue","book_id":"b-shiji-113","work_id":"w-shiji","source_id":"s-shiji113-nanyue"},{"id":"c-shiji-113-nanyue:p009","text":"天子聞嘉不聽王，王、王太后弱孤不能制，使者怯無決。又以為王、王太后已附漢，獨呂嘉為亂，不足以興兵，欲使莊參以二千人往使。參曰：「以好往，數人足矣；以武往，二千人無足以為也。」辭不可，天子罷參也。郟壯士故濟北相韓千秋奮曰：「以區區之越，又有王、太后應，獨相呂嘉為害，願得勇士二百人，必斬嘉以報。」於是天子遣千秋與王太后弟樛樂將二千人往，入越境。呂嘉等乃遂反，下令國中曰：「王年少。太後，中國人也，又與使者亂，專欲內屬，盡持先王寶器入獻天子以自媚，多從人，行至長安，虜賣以為僮仆。取自脫一時之利，無顧趙氏社稷，為萬世慮計之意。」乃與其弟將卒攻殺王、太后及漢使者。遣人告蒼梧秦王及其諸郡縣，立明王長男越妻子術陽侯建德為王。而韓千秋兵入，破數小邑。其後越直開道給食，未至番禺四十里，越以兵擊千秋等，遂滅之。使人函封漢使者節置塞上，好為謾辭謝罪，發兵守要害處。於是天子曰：「韓千秋雖無成功，亦軍鋒之冠。」封其子延年為成安侯。樛樂，其姊為王太后，首願屬漢，封其子廣德為龍亢侯。乃下赦曰：「天子微，諸侯力政，譏臣不討賊。今呂嘉、建德等反，自立晏如，令罪人及江淮以南樓船十萬師往討之。」","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-113-nanyue:m009-0000","start":0,"end":2,"surface":"天子","kind":"person","person_id":"g0x_vmx_2lg","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m009-0003","start":3,"end":4,"surface":"嘉","kind":"person","person_id":"jfm_184_2yb","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m009-0010","start":10,"end":13,"surface":"王太后","kind":"person","person_id":"3q4_zsp_jwy","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m009-0030","start":30,"end":33,"surface":"王太后","kind":"person","person_id":"3q4_zsp_jwy","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m009-0038","start":38,"end":40,"surface":"呂嘉","kind":"person","person_id":"jfm_184_2yb","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m009-0051","start":51,"end":53,"surface":"莊參","kind":"person","person_id":"o6s_s07_5s6","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m009-0060","start":60,"end":61,"surface":"參","kind":"person","person_id":"o6s_s07_5s6","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m009-0091","start":91,"end":93,"surface":"天子","kind":"person","person_id":"g0x_vmx_2lg","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m009-0094","start":94,"end":95,"surface":"參","kind":"person"