orted_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-053-zhanghong:line014-pei02-01:m0365","start":365,"end":367,"surface":"孫叔","kind":"person","person_id":"b8n_gxh_u7t","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-053-zhanghong:line014-pei02-01","chapter_id":"c-sanguozhi-053-zhanghong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-053-zhanghong:line014-pei02-01","text":"《吳書》曰：權初承統，春秋方富，太夫人以方外多難，深懷憂勞，數有優令辭謝，付屬以輔助之義。纮輒拜箋答謝，思惟補察。每有異事密計及章表書記，與四方交結，常令纮與張昭草創撰作。纮以破虜有破走董卓，扶持漢室之勳；討逆平定江外，建立大業，宜有紀頌以昭公義。既成，呈權，權省讀悲感，曰：「君真識孤家門閥閱也。」乃遣纮之部。或以纮本受北任，嫌其志趣不止於此，權不以介意。初，琅邪趙昱為廣陵太守，察纮孝廉，昱後為笮融所殺，纮甚傷憤，而力不能討。昱門戶絕滅，及纮在東部，遣主簿至琅邪設祭，並求親戚為之後，以書屬琅邪相臧宣，宣以趙宗中五歲男奉昱祀，權聞而嘉之。及討江夏，以東部少事，命纮居守，遙領所職。孔融遺纮書曰：「聞大軍西征，足下留鎮。不有居者，誰守社稷？深固折衝，亦大勳也。無乃李廣之氣，倉發益怒，樂一當單于，以盡餘憤乎？南北並定，世將無事，孫叔投戈，絳、灌俎豆，亦在今日，但用離析，無緣會面，為愁嘆耳。道直途清，相見豈复難哉？」權以纮有鎮守之勞，欲論功加賞。纮厚自挹損，不敢蒙寵，權不奪其志。每從容侍燕，微言密指，常有以規諷。","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-053-zhanghong:line014-pei02-01:m0006","start":6,"end":7,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-zhanghong:line014-pei02-01:m0016","start":16,"end":19,"surface":"太夫人","kind":"person","person_id":"lm8_q5h_5uy","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-zhanghong:line014-pei02-01:m0045","start":45,"end":46,"surface":"纮","kind":"person","person_id":"6bz_2xv_ow3","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。