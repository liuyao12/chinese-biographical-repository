897},"mentions":[{"id":"c-nanqishu-046-caiyue-complete:p003:m0022","start":22,"end":24,"surface":"世祖","kind":"person","person_id":"kix_r92_2ed","status":"contextual_provisional"},{"id":"c-nanqishu-046-caiyue-complete:p003:m0025","start":25,"end":26,"surface":"約","kind":"person","person_id":"fcu_pw8_tkw_A","status":"contextual_provisional"},{"id":"c-nanqishu-046-caiyue-complete:p003:m0045","start":45,"end":46,"surface":"約","kind":"person","person_id":"fcu_pw8_tkw_A","status":"contextual_provisional"},{"id":"c-nanqishu-046-caiyue-complete:p003:m0082","start":82,"end":83,"surface":"約","kind":"person","person_id":"fcu_pw8_tkw_A","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-046-caiyue-complete","book_id":"b-nanqishu-046","work_id":"w-nanqishu","source_id":"s-nanqishu-046-caiyue-complete-ws1511897"},{"id":"c-nanqishu-046-caiyue-complete:p004","text":"　　遷司徒左長史。高宗爲錄尚書輔政，百僚屣履到席，約躡屐不改。帝謂江祏曰：「蔡氏故是禮度之門，故自可悅。」祏曰：「大將軍有揖客，復見於今。」建武元年，遷侍中。明年，遷西陽王撫軍長史，加冠軍將軍，徙廬陵王右軍長史，將軍如故。轉都官尚書，遷邵陵王師，加給事中，江夏王車騎長史，加征虜將軍，竝不拜。好飲酒，夷淡不與世雜。遷太子詹事。永元二年，卒。年四十四。贈太常。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":41,"last_line":41,"raw_start":3011,"raw_end":3197,"raw_character_offsets":[3011,3012,3013,3014,3015,3016,3017,3018,3019,3020,3021,3022,3023,3024,3025,3026,3027,3028,3029,3030,3031,3032,3033,3034,3035,3036,3037,3038,3039,3040,3041,3042,3043,3044,3045,3046,3047,3048,3049,3050,3051,3052,3053,3054,3055,3056,3057,3058,3059,3060,3061,3062,3063,3064,3065,3066,3067,3068,3069,3070,3071,3072,3073,3074,3075,3076,3077,3078,3079,3080,3081,3082,3083,3084,3085,3086,3087,3088,3089,3090,3091,3092,3093,3094,3095,3096,3097,3098,3099,3100,3101,3102,3103,3104,3105,3106,3107,3108,3109,3110,3111,3112,3113,3114,3115,3116,3117,3118,3119,3120,3121,3122,3123,3124,3125,3126,3127,3128,3129,3130,3131,3132,3133,3134,3135,3136,3137,3138,3139,3140,3141,3142,3143,3144,3145,3146,3147,3148,3149,3150,3151,3152,3153,3154,3155,3156,3157,3158,3159,3160,3161,3162,3163,3164,3165,3