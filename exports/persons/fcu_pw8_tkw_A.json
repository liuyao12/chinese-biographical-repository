i:p002:m0078","relationship_anchor":{"paragraph_id":"c-nanshi-022-wangci:p002","start":78,"end":83,"surface":"蔡興宗子約"},"source_term":"蔡興宗子約"}],"status":"contextual_provisional","human_reviewed":false,"interpretation_note":"原句父子／父女。"}},{"id":"sx5_u87_kik","label":"安吉公主（宋孝武帝女，蔡約妻）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"安吉公主","mention_ids":["c-nanqishu-046-caiyue-complete:p002:m0009"]}],"evidence":[{"mention_id":"c-nanqishu-046-caiyue-complete:p002:m0009","paragraph_id":"c-nanqishu-046-caiyue-complete:p002","chapter_id":"c-nanqishu-046-caiyue-complete","quote":"安吉公主"}],"review":"ai_provisional","identity_note":"安吉公主（宋孝武帝女，蔡約妻），見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-nanqishu-046-caiyue-complete-ws1511897","work_id":"w-nanqishu","book_id":"b-nanqishu-046","chapter_id":"c-nanqishu-046-caiyue-complete","raw_mention_count":8,"mention_ids":["c-nanqishu-046-caiyue-complete:p001:m0002","c-nanqishu-046-caiyue-complete:p001:m0005","c-nanqishu-046-caiyue-complete:p002:m0002","c-nanqishu-046-caiyue-complete:p002:m0167","c-nanqishu-046-caiyue-complete:p003:m0025","c-nanqishu-046-caiyue-complete:p003:m0045","c-nanqishu-046-caiyue-complete:p003:m0082","c-nanqishu-046-caiyue-complete:p004:m0025"],"paragraph_ids":["c-nanqishu-046-caiyue-complete:p001","c-nanqishu-046-caiyue-complete:p002","c-nanqishu-046-caiyue-complete:p003","c-nanqishu-046-caiyue-complete:p004"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-nanqishu-046-caiyue-complete:p001:m0002","mention_ids":["c-nanqishu-046-caiyue-complete:p001:m0002"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-046-caiyue-complete:p001:m0005","mention_ids":["c-nanqishu-046-caiyue-complete:p001:m0005"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-046-caiyue-complete:p002:m0002","mention_ids":["c-nanqishu-046-caiyue-complete:p002:m0002"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-046-caiyue-complete:p002:m0167","mention_ids":["c-nanqi