n:m003-0047","start":47,"end":49,"surface":"王戊","kind":"person","person_id":"n7i_i5n_lay_AA","status":"contextual_provisional"}],"chapter_id":"c-shiji-050-chuyuan","book_id":"b-shiji-050","work_id":"w-shiji","source_id":"s-shiji-050-chuyuan"},{"id":"c-shiji-050-chuyuan:p004","text":"王戊立二十年，冬，坐為薄太后服私姦，削東海郡。春，戊與吳王合謀反，其相張尚、太傅趙夷吾諫，不聽。戊則殺尚、夷吾，起兵與吳西攻梁，破棘壁。至昌邑南，與漢將周亞夫戰。漢絕吳楚糧道，士卒饑，吳王走，楚王戊自殺，軍遂降漢。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-050-chuyuan:m004-0000","start":0,"end":2,"surface":"王戊","kind":"person","person_id":"n7i_i5n_lay_AA","status":"contextual_provisional"},{"id":"c-shiji-050-chuyuan:m004-0011","start":11,"end":14,"surface":"薄太后","kind":"person","person_id":"jko_7a4_o8v","status":"contextual_provisional"},{"id":"c-shiji-050-chuyuan:m004-0025","start":25,"end":26,"surface":"戊","kind":"person","person_id":"n7i_i5n_lay_AA","status":"contextual_provisional"},{"id":"c-shiji-050-chuyuan:m004-0027","start":27,"end":29,"surface":"吳王","kind":"person","person_id":"hev_8tu_w4k","status":"contextual_provisional"},{"id":"c-shiji-050-chuyuan:m004-0035","start":35,"end":37,"surface":"張尚","kind":"person","person_id":"i8p_f0y_kea","status":"contextual_provisional"},{"id":"c-shiji-050-chuyuan:m004-0040","start":40,"end":43,"surface":"趙夷吾","kind":"person","person_id":"d1q_nn7_fvn","status":"contextual_provisional"},{"id":"c-shiji-050-chuyuan:m004-0048","start":48,"end":49,"surface":"戊","kind":"person","person_id":"n7i_i5n_lay_AA","status":"contextual_provisional"},{"id":"c-shiji-050-chuyuan:m004-0051","start":51,"end":52,"surface":"尚","kind":"person","person_id":"i8p_f0y_kea","status":"contextual_provisional"},{"id":"c-shiji-050-chuyuan:m004-0053","start":53,"end":55,"surface":"夷吾","kind":"person","person_id":"d1q_nn7_fvn","status":"contextual_provisional"},{"id":"c-shiji-050-chuyuan:m004-0076","start":76,"end":79,"surface":"周亞夫","kind":"person","person_id":"e5f_wil_2zp","status":"contextual_provisional"},{"id":"c