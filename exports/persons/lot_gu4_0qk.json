-lingtong","work_id":"w-sanguozhi","book_id":"b-sanguozhi-055","chapter_id":"c-sanguozhi-055-lingtong","raw_mention_count":5,"mention_ids":["c-sanguozhi-055-lingtong:line091:m0079","c-sanguozhi-055-lingtong:line091:m0085","c-sanguozhi-055-lingtong:line091:m0120","c-sanguozhi-055-lingtong:line091:m0141","c-sanguozhi-055-lingtong:line091:m0161"],"paragraph_ids":["c-sanguozhi-055-lingtong:line091"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-sanguozhi-055-lingtong:line091:m0079","mention_ids":["c-sanguozhi-055-lingtong:line091:m0079"],"kind":"paragraph"},{"canonical_mention_id":"c-sanguozhi-055-lingtong:line091:m0085","mention_ids":["c-sanguozhi-055-lingtong:line091:m0085"],"kind":"paragraph"},{"canonical_mention_id":"c-sanguozhi-055-lingtong:line091:m0120","mention_ids":["c-sanguozhi-055-lingtong:line091:m0120"],"kind":"paragraph"},{"canonical_mention_id":"c-sanguozhi-055-lingtong:line091:m0141","mention_ids":["c-sanguozhi-055-lingtong:line091:m0141"],"kind":"paragraph"},{"canonical_mention_id":"c-sanguozhi-055-lingtong:line091:m0161","mention_ids":["c-sanguozhi-055-lingtong:line091:m0161"],"kind":"paragraph"}],"mention_count":5,"duplicate_mention_count":0,"paragraph_occurrence_count":5,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"5處獨立位置，5個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-sanguozhi-055-lingtong"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-wu055-lingtong1","person_id":"lot_gu4_0qk","event_type":"death","source_term":"數日乃死","date_expression":null,"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-055","chapter_id":"c-sanguozhi-055-lingtong","source_id":"s-sanguozhi-055-lingtong","paragraph_id":"c-sanguozhi-055-lingtong:line091","quote":"統年十五，左右多稱述者，權亦以操死國事，拜統別部司馬，行破賊都尉，使攝父兵。後從擊山賊，權破保屯先還，餘麻屯萬人，統與督張異等留攻圍之，克日當攻。先期，統與督陳勤會飲酒，勤剛勇任氣，因督祭酒，陵轢一坐，舉罰不以其道。統疾其侮慢，面折不爲用。勤怒詈統，及其父操，統流涕不荅，衆因罷出。勤乘酒凶悖，又於道路辱統。統不忍，引刀斫勤，數日乃死。及當攻屯，統曰：「非死無以謝罪。」乃率厲士卒，身當矢石，所次一面，應時披壞，諸將乘勝，遂大破之。還，自拘於軍正。權壯其果毅，使得以功贖罪。","person_mention_id":"c-sanguozhi-055-lingtong:line091:m0079"}],"interpretation_note":"本來源所記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-sanguozhi-055-lingtong:line091:m0079","start":79,"end":81,"surface":"陳勤","kind":"person","person_id":"lot_gu4_0qk","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-055-lingtong:line091","chapter_id":"c-sanguozhi-055-lingtong"},{"id":"c-sanguozhi-055-lingtong:line091:m0085","start":85,"end":86,"surface":"勤","kind":"person","person_id":"lot_gu4_0qk","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-055-lingtong:line091","chapter_id":"c-sanguozhi-055-lingtong"},{"id":"c-sanguozhi-055-lingtong:line091:m0120","start":120,"end":121,"surface":"勤","kind":"person","person_id":"lot_gu4_0qk","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-055-lingtong:line091","chapter_id":"c-sanguozhi-055-lingtong"},{"id":"c-sanguozhi-055-lingtong:line091:m0141","start":141,"end":142,"surface":"勤","kind":"person","person_id":"lot_gu4_0qk","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-055-lingtong:line091","chapter_id":"c-sanguozhi-0