{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"hb8_6rj_lsf","canonical_person_id":"hb8_6rj_lsf","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["hb8_6rj_lsf"],"persons":[{"id":"hb8_6rj_lsf","label":"梁芬","status":"active","historicity":"historical_tradition","aliases":[{"surface":"梁芬","mention_ids":["c-jinshu-060-yanding:p002:m0260"]}],"evidence":[{"mention_id":"c-jinshu-060-yanding:p002:m0260","paragraph_id":"c-jinshu-060-yanding:p002","chapter_id":"c-jinshu-060-yanding","quote":"梁芬"}],"review":"ai_provisional","identity_note":"梁芬，見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-jinshu-060-yanding-ws2413335","work_id":"w-jinshu","book_id":"b-jinshu-060","chapter_id":"c-jinshu-060-yanding","raw_mention_count":1,"mention_ids":["c-jinshu-060-yanding:p002:m0260"],"paragraph_ids":["c-jinshu-060-yanding:p002"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-060-yanding:p002:m0260","mention_ids":["c-jinshu-060-yanding:p002:m0260"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-060-yanding-ws2413335"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-060-yanding:p002:m0260","surface":"梁芬","start":260,"end":262,"person_id":"hb8_6rj_lsf","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-060-yanding:p002","chapter_id":"c-jinshu-060-yanding"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-060-yanding:p002","text":"鼎少有大志，因西土人思歸，欲立功鄉里，乃與撫軍長史王毗、司馬傳遜懷翼戴秦王之計，謂疇、捷等曰：「山東非霸王處，不如關中。」河陽令傅暢遺鼎書，勸奉秦王過洛陽，謁拜山陵，徑據長安，綏合夷晉，興起義眾，克復宗廟，雪社稷之恥。鼎得書，便欲詣洛，流人謂北道近河，懼有抄截，欲南自武關向長安。疇等皆山東人，咸不願西入，荀籓及疇、捷等並逃散。鼎追籓不及，暅等見殺，唯顗、述走得免。遂奉秦王行，止上洛，為山賊所襲，殺百餘人，率餘眾西至藍田。時劉聰向長安，為雍州刺史賈疋所逐，走還平陽。疋遣人奉迎秦王，遂至長安，而與大司馬南陽王保、衛將軍梁芬、京兆尹梁綜等並同心推戴，立王為皇太子，登壇告天，立社稷宗廟，以鼎為太子詹事，總攝百揆。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":94,"last_line":94,"raw_start":7949,"raw_end":8257,"raw_character_offsets":[7951,7952,7953,7954,7955,7956,7957,7958,7959,7960,7961,7962,7963,7964,7965,7966,7967,7968,7969,7970,7971,7972,7973,7974,7975,7976,7977,7978,7979,7980,7981,7982,7983,7984,7985,7986,7987,7988,7989,7990,7991,7992,7993,7994,7995,7996,7997,7998,7999,8000,8001,8002,8003,8004,8005,8006,8007,8008,8009,8010,8011,8012,8013,8014,8015,8016,8017,8018,8019,8020,8021,8022,8023,8024,8025,8026,8027,8028,8029,8030,8031,8032,8033,8034,8035,8036,8037,8038,8039,8040,8041,8042,8043,8044,8045,8046,8047,8048,8049,8050,8051,8052,8053,8054,8055,8056,8057,8058,8059,8060,8061,8062,8063,8064,8065,8066,8067,8068,8069,8070,8071,8072,8073,8074,8075,8076,8077,8078,8079,8080,8081,8082,8083,8084,8085,8086,8087,8088,8089,8090,8091,8092,8093,8094,8095,8096,8097,8098,8099,8100,8101,8102,8103,8104,8105,8106,8107,8108,8109,8110,8111,8112,8113,8114,8115,8116,8117,8118,8119,8120,8121,8122,8123,8124,8125,8126,8127,8128,8129,8130,8131,8132,8133,8134,8135,8136,8137,8138,8139,8140,8141,8142,8143,8144,8145,8146,8147,814