d":"person","person_id":"h9d_f3h_20h","status":"contextual_provisional","paragraph_id":"c-liangshu-028-xiahoukui-complete:p003","chapter_id":"c-liangshu-028-xiahoukui-complete"},{"id":"c-liangshu-028-xiahoukui-complete:p004:m0021","start":21,"end":23,"surface":"元樹","kind":"person","person_id":"h9d_f3h_20h","status":"contextual_provisional","paragraph_id":"c-liangshu-028-xiahoukui-complete:p004","chapter_id":"c-liangshu-028-xiahoukui-complete"}],"relations":[],"title_holdings":[{"id":"th-liangshu-028-xiahoukui-complete-3-19","title":"郢州刺史","kind":"office","mode":"attestation","person_id":"h9d_f3h_20h","attestations":[{"id":"th-liangshu-028-xiahoukui-complete-3-19:a","paragraph_id":"c-liangshu-028-xiahoukui-complete:p003","start":19,"end":23,"surface":"郢州刺史","person_mention_id":"c-liangshu-028-xiahoukui-complete:p003:m0023","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-028","chapter_id":"c-liangshu-028-xiahoukui-complete","source_id":"s-liangshu-028-xiahoukui-complete-ws1511902","paragraph_id":"c-liangshu-028-xiahoukui-complete:p003","quote":"大通二年，魏郢州刺史元願達請降，高祖敕郢州刺史元樹往迎願達，夔亦自楚城會之，遂留鎮焉。詔改魏郢州爲北司州，以夔爲刺史，兼督司州。三年，遷使持節，進號仁威將軍，封保城縣侯，邑一千五百戶。中大通二年，徵爲右衛將軍，丁所生母憂去職。","person_mention_id":"c-liangshu-028-xiahoukui-complete:p003:m0023"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"th-liangshu-028-xiahoukui-complete-4-17","title":"鎮北將軍","kind":"office","mode":"attestation","person_id":"h9d_f3h_20h","attestations":[{"id":"th-liangshu-028-xiahoukui-complete-4-17:a","paragraph_id":"c-liangshu-028-xiahoukui-complete:p004","start":17,"end":21,"surface":"鎮北將軍","person_mention_id":"c-liangshu-028-xiahoukui-complete:p004:m0021","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-028","chapter_id":"c-liangshu-028-xiahoukui-complete","source_id":"s-liangshu-028-xiahoukui-complete-ws1511902","paragraph_id":"c-liangshu-028-xiahoukui-complete:p004","quote":"時魏南兗州刺史劉明以譙城入附，詔遣鎮北將軍元樹帥軍應接，起夔爲雲麾將軍，隨機北討。尋授使持節、督南豫州諸軍事、南豫州刺史。六年，轉使持節、督豫淮陳潁建霍義七州諸軍事、豫州刺史。豫州積歲寇戎，人頗失業，夔乃帥軍人于蒼陵立堰，溉田千餘頃。歲收穀百餘萬石，以充儲備，兼贍貧人，境內賴之。夔兄亶先經此任，至是夔又居焉。兄弟並有恩惠於鄉里，百姓歌之曰：「我之有州，頻仍夏侯；前兄後弟，布政優優。」在州七年，甚有聲績，遠近多附之。有部曲萬人，馬二千匹，並服習精強，爲當時之盛。性奢豪，後房伎妾曳羅縠飾金翠者亦有百數。愛好人士，不以貴勢自高，文武賓客常滿坐，時亦以此稱之。大同四年，卒于州，時年五十六。有詔舉哀，賻錢二十萬，布二百匹。追贈侍中、安北將軍。諡曰桓。","person_mention_id":"c-liangshu-028-xiahoukui-complete:p004:m0021"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-028-xiahoudan-complete:p002","text":"六年，大舉北伐。先遣豫州刺史裴邃帥譙州刺史湛僧智、歷陽太守明紹世、南譙太守魚弘、晉熙太守張澄，並世之驍將，自南道伐壽陽城，未克而邃卒。乃加亶使持節，馳驛代邃，與魏將河間王元琛、臨淮王元彧等相拒，頻戰克捷。尋有密敕，班師合肥，以休士馬，須堰成復進。七年夏，淮堰水盛，壽陽城將沒，高祖復遣北道軍元樹帥彭寶孫、陳慶之等稍進，亶帥湛僧智、魚弘、張澄等通清流澗，將入淮、肥。魏軍夾肥築城，出亶軍後，亶與僧智還襲，破之。進攻黎漿，貞威將軍韋放自北道會焉。兩軍既合，所向皆降下。凡降城五十二，獲男女口七萬五千人，米二十萬石。詔以壽陽依前代置豫州，合肥鎮改爲南豫州，以亶爲使持節、都督豫州緣淮南豫霍義定五州諸軍事、雲麾將軍、豫、南豫二州刺史。壽春久罹兵荒，百姓多流散，亶輕刑薄賦，務農省役，頃之民戶充復。大通二年，進號平北將軍。三年，卒於州鎮。高祖聞之，卽日素服舉哀，贈車騎將軍。諡曰襄。州民夏侯簡等五百人表請爲亶立碑置祠，詔許之。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":53,"last_line":53,"raw_start":3488,"raw_end":3903,"raw_character_offsets":[3488,3489,3490,3491,3492,3493,3494,3495,3496,3497,3498,3499,3500,3501,3502,3503,3504,3505,3506,3507,3508,3509,3510,3511,3512,3513,3514,3515,3516,3517,3518,3519,3520,3521,3522,3523,3524,3525,3526,3527,3528,3529,3530,3531,3532,3533,3534,3535,3536,3537,3538,3539,3540,3541,3542,3543,35