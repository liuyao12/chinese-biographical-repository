complete:p002:m0388","start":388,"end":391,"surface":"夏侯簡","kind":"person","person_id":"lxe_8bu_2sv","status":"contextual_provisional"},{"id":"c-liangshu-028-xiahoudan-complete:p002:m0398","start":398,"end":399,"surface":"亶","kind":"person","person_id":"zz1_0tr_xni_A","status":"contextual_provisional"}],"chapter_id":"c-liangshu-028-xiahoudan-complete","book_id":"b-liangshu-028","work_id":"w-liangshu","source_id":"s-liangshu-028-xiahoudan-complete-ws1511902"},{"id":"c-liangshu-028-xiahoukui-complete:p003","text":"大通二年，魏郢州刺史元願達請降，高祖敕郢州刺史元樹往迎願達，夔亦自楚城會之，遂留鎮焉。詔改魏郢州爲北司州，以夔爲刺史，兼督司州。三年，遷使持節，進號仁威將軍，封保城縣侯，邑一千五百戶。中大通二年，徵爲右衛將軍，丁所生母憂去職。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":66,"last_line":66,"raw_start":4707,"raw_end":4827,"raw_character_offsets":[4707,4708,4709,4710,4711,4712,4713,4714,4715,4716,4717,4718,4719,4720,4721,4722,4723,4724,4725,4726,4727,4728,4729,4730,4731,4732,4733,4734,4735,4736,4737,4738,4739,4740,4741,4742,4743,4744,4745,4746,4747,4748,4749,4750,4751,4752,4753,4754,4755,4756,4757,4758,4759,4760,4761,4762,4763,4764,4765,4766,4767,4768,4769,4770,4771,4772,4773,4774,4775,4776,4777,4778,4779,4780,4781,4782,4783,4784,4785,4786,4787,4788,4789,4790,4791,4792,4793,4794,4795,4796,4797,4798,4804,4805,4806,4807,4808,4811,4812,4813,4814,4815,4816,4817,4818,4819,4820,4821,4822,4823,4824,4825,4826],"revision_id":1511902},"mentions":[{"id":"c-liangshu-028-xiahoukui-complete:p003:m0010","start":10,"end":13,"surface":"元願達","kind":"person","person_id":"zbr_1m4_7pb","status":"contextual_provisional"},{"id":"c-liangshu-028-xiahoukui-complete:p003:m0016","start":16,"end":18,"surface":"高祖","kind":"person","person_id":"fo7_f8v_rmf","status":"contextual_provisional"},{"id":"c-liangshu-028-xiahoukui-complete:p003:m0023","start":23,"end":25,"surface":"元樹","kind":"person","person_id":"h9d_f3h_20h","status":"contextual_provisional"},{"id":"c-liangshu-028-xiahoukui-complete:p003:m0027","start":27,"end":29,"surface":"願達","kind":"person","person_id":"zbr_1m4_7pb","status":"contextual_provisional"},{"id":"c-liangshu-028-xiahoukui-complete:p003:m0030","start":30,"end":31,"surface":"夔","kind":"person","person_id":"zz1_0tr_xni_B","status":"contextual_provisional"},{"id":"c-liangshu-028-xiahoukui-complete:p003:m0054","start":54,"end":55,"surface":"夔","kind":"person","person_id":"zz1_0tr_xni_B","status":"contextual_provisional"}],"chapter_id":"c-liangshu-028-xiahoukui-complete","book_id":"b-liangshu-028","work_id":"w-liangshu","source_id":"s-liangshu-028-xiahoukui-complete-ws1511902"},{"id":"c-liangshu-028-xiahoukui-complete:p004","text":"時魏南兗州刺史劉明以譙城入附，詔遣鎮北將軍元樹帥軍應接，起夔爲雲麾將軍，隨機北討。尋授使持節、督南豫州諸軍事、南豫州刺史。六年，轉使持節、督豫淮陳潁建霍義七州諸軍事、豫州刺史。豫州積歲寇戎，人頗失業，夔乃帥軍人于蒼陵立堰，溉田千餘頃。歲收穀百餘萬石，以充儲備，兼贍貧人，境內賴之。夔兄亶先經此任，至是夔又居焉。兄弟並有恩惠於鄉里，百姓歌之曰：「我之有州，頻仍夏侯；前兄後弟，布政優優。」在州七年，甚有聲績，遠近多附之。有部曲萬人，馬二千匹，並服習精強，爲當時之盛。性奢豪，後房伎妾曳羅縠飾金翠者亦有百數。愛好人士，不以貴勢自高，文武賓客常滿坐，時亦以此稱之。大同四年，卒于州，時年五十六。有詔舉哀，賻錢二十萬，布二百匹。追贈侍中、安北將軍。諡曰桓。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":68,"last_line":68,"raw_start":4831,"raw_end":5162,"raw_character_offsets":[4831,4832,4833,4834,4835,4836,4837,4838,4839,4840,4841,4842,4843,4844,4845,4846,4847,4848,4849,4850,4851,4852,4853,4854,4855,4856,4857,4858,4859,4860,4861,4862,4863,4864,4865,4866,4867,4868,4869,4870,4871,4872,4873,4874,4875,4876,4877,4878,4879,4880,4881,4882,4883,4884,4885,4886,4887,4888,4889,4890,4891,4892,4893,4894,4895,4896,4897,4898,4899,4900,4901,4902,4903,4904,4905,4906,4907,4908,4909,4910,4911,4912,4913,4914,4915,4916,4917,4918,4919,4920,4921,4922,4923,4924,4925,4926,4927,4928,4929,4930,4931,4932,4933,4934,4935,4936,4937,4938,4939,4940,4941,4942,4943,4944,4945,4946,4947,4948,4949,4950,4951,4952,4953,4954,4955,4956,4957,4958,4959,4960,4961,4962,4963,4964,4965,4966,4967,4968,4969,4970,4971,4972,4973,4974,4975,4976,4977,4978,4979,4980,4981,4982,4983,4984,4985,4986,4987,4988,4989,4990,4991,4992,4993,4994,4995,4996,4997,4998,4999,5000,5001,5002,5003,5004,5005,5006,5007,5008,500