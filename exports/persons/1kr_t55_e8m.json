start":72,"end":73,"surface":"王","kind":"person","person_id":"1kr_t55_e8m","status":"contextual_provisional","paragraph_id":"c-shiji-119-xunli:p004","chapter_id":"c-shiji-119-xunli"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-119-xunli:p002","text":"孫叔敖者，楚之處士也。虞丘相進之於楚莊王，以自代也。三月爲楚相，施教導民，上下和合，世俗盛美，政緩禁止，吏無姦邪，盜賊不起。秋冬則勸民山採，春夏以水，各得其所便，民皆樂其生。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-119-xunli:m002-0000","start":0,"end":3,"surface":"孫叔敖","kind":"person","person_id":"fom_gr9_c8v","status":"contextual_provisional"},{"id":"c-shiji-119-xunli:m002-0011","start":11,"end":14,"surface":"虞丘相","kind":"person","person_id":"q9v_ucd_uj4","status":"contextual_provisional"},{"id":"c-shiji-119-xunli:m002-0017","start":17,"end":20,"surface":"楚莊王","kind":"person","person_id":"1kr_t55_e8m","status":"contextual_provisional"},{"id":"c-shiji-119-xunli:m002-0035","start":35,"end":36,"surface":"民","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-119-xunli:m002-0052","start":52,"end":53,"surface":"吏","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-119-xunli:m002-0057","start":57,"end":59,"surface":"盜賊","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-119-xunli:m002-0066","start":66,"end":67,"surface":"民","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-119-xunli:m002-0081","start":81,"end":82,"surface":"民","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-119-xunli","book_id":"b-shiji-119","work_id":"w-shiji","source_id":"s-shiji119-xunli"},{"id":"c-shiji-119-xunli:p003","text":"莊王以爲幣輕，更以小爲大，百姓不便，皆去其業。市令言之相曰：「市亂，民莫安其處，次行不定。」相曰：「如此幾何頃乎？」市令曰：「三月頃。」相曰：「罷，吾今令之復矣。」後五日，朝，相言之王曰：「前日更幣，以爲輕。今市令來言曰『市亂，民莫安其處，次行之不定』。臣請遂令復如故。」王許之，下令三日而市復如故。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-119-xunli:m003-0000","start":0,"end":2,"surface":"莊王","kind":"person","person_id":"1kr_t55_e8m","status":"contextual_provisional"},{"id":"c-shiji-119-xunli:m003-0023","start":23,"end":25,"surface":"市令","kind":"person","person_id":"wir_j3b_dg1","status":"contextual_provisional"},{"id":"c-shiji-119-xunli:m003-0027","start":27,"end":28,"surface":"相","kind":"person","person_id":"fom_gr9_c8v","status":"contextual_provisional"},{"id":"c-shiji-119-xunli:m003-0046","start":46,"end":47,"surface":"相","kind":"person","person_id":"fom_gr9_c8v","status":"contextual_provisional"},{"id":"c-shiji-119-xunli:m003-0058","start":58,"end":60,"surface":"市令","kind":"person","person_id":"wir_j3b_dg1","status":"contextual_provisional"},{"id":"c-shiji-119-xunli:m003-0068","start":68,"end":69,"surface":"相","kind":"person","person_id":"fom_gr9_c8v","status":"contextual_provisional"},{"id":"c-shiji-119-xunli:m003-0088","start":88,"end":89,"surface":"相","kind":"person","person_id":"fom_gr9_c8v","status":"contextual_provisional"},{"id":"c-shiji-119-xunli:m003-0091","start":91,"end":92,"surface":"王","kind":"person","person_id":"1kr_t55_e8m","status":"contextual_provisional"},{"id":"c-shiji-119-xunli:m003-0105","start":105,"end":107,"surface":"市令","kind":"person","person_id":"wir_j3b_dg1","status":"contextual_provisional"},{"id":"c-shiji-119-xunli:m003-0136","start":136,"end":137,"surface":"王","kind":"person","person_id":"1kr_t55_e8m","status":"contextual_provisional"}],"chapter_id":"c-shiji-119-xunli","book_id":"b-shiji-119","work_id":"w-shiji","source_id":"s-shiji119-xunli"},{"id":"c-shiji-119-xunli:p004","text":"楚民俗好庳車，王以爲庳車不便馬，欲下令使髙之。相曰：「令數下，民不知所從，不可。王必欲髙車，臣請教閭里使髙其梱。乘車者皆君子，君子不能數下車。」王許之。居半歳，民悉自髙其車。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-119-xunli:m004-0007","start":7,"end":8,"surface":"王","kind":"person","person_id":"1kr_t55_