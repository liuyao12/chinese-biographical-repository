ce-lun:p005:m0240","surface":"肜","start":240,"end":241,"person_id":"dkn_ge4_286_AAAAF","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-059-prince-lun","book_id":"b-jinshu-059","work_id":"w-jinshu","source_id":"s-jinshu-059-prince-lun-ws2650517"},{"id":"c-jinshu-060-mengguan:p002","text":"趙王倫篡位，以觀所在著績，署為安南將軍、監河北諸軍事、假節，屯宛。觀子平為淮南王允前鋒將軍，討倫，戰死。孫秀以觀杖兵在外，假言平為允兵所害，贈積弩將軍以安觀。義軍既起，多勸觀應齊王冏，觀以紫宮帝坐無他變，謂倫應之，遂不從眾議而為倫守。及帝反正，永饒冶令空桐機斬觀首，傳於洛陽，遂夷三族。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":27,"last_line":27,"raw_start":1807,"raw_end":1952,"raw_character_offsets":[1809,1810,1811,1812,1813,1814,1815,1816,1817,1818,1819,1820,1821,1822,1823,1824,1825,1826,1827,1828,1829,1830,1831,1832,1833,1834,1835,1836,1837,1838,1839,1840,1841,1842,1843,1844,1845,1846,1847,1848,1849,1850,1851,1852,1853,1854,1855,1856,1857,1858,1859,1860,1861,1862,1863,1864,1865,1866,1867,1868,1869,1870,1871,1872,1873,1874,1875,1876,1877,1878,1879,1880,1881,1882,1883,1884,1885,1886,1887,1888,1889,1890,1891,1892,1893,1894,1895,1896,1897,1898,1899,1900,1901,1902,1903,1904,1905,1906,1907,1908,1909,1910,1911,1912,1913,1914,1915,1916,1917,1918,1919,1920,1921,1922,1923,1924,1925,1926,1927,1928,1929,1930,1931,1932,1933,1934,1935,1936,1937,1938,1939,1940,1941,1942,1943,1944,1945,1946,1947,1948,1949,1950,1951],"revision_id":2413335},"mentions":[{"id":"c-jinshu-060-mengguan:p002:m0000","surface":"趙王倫","start":0,"end":3,"person_id":"dkn_ge4_286_AAAAG","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-mengguan:p002:m0007","surface":"觀","start":7,"end":8,"person_id":"dwy_q6y_ar9","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-mengguan:p002:m0033","surface":"觀","start":33,"end":34,"person_id":"dwy_q6y_ar9","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-mengguan:p002:m0035","surface":"平","start":35,"end":36,"person_id":"k5x_o86_phz","kind":"person","status":"contextual_provisional"},{"id":