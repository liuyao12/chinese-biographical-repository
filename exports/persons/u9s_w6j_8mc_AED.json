sional","identity_note":"四晉完整選定單元來源內身份暫定；不把近似人名、同姓、遠祖報說變成近親或同人。"}],"source_mention_summary":[{"source_id":"s-jinshu-074-ws1536331","work_id":"w-jinshu","book_id":"b-jinshu-074","chapter_id":"c-jinshu-074-huan-family","raw_mention_count":1,"mention_ids":["c-jinshu-074-huan-family:p034:m0222"],"paragraph_ids":["c-jinshu-074-huan-family:p034"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-074-huan-family:p034:m0222","mention_ids":["c-jinshu-074-huan-family:p034:m0222"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-074-ws1536331"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-huan-close-021","subject_person_id":"u9s_w6j_8mc_AED","predicate":"father","object_person_id":"u9s_w6j_8mc_AE","status":"source_attested","qualifiers":{"source_term":"有七子"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-074","source_id":"s-jinshu-074-ws1536331","chapter_id":"c-jinshu-074-huan-family","paragraph_id":"c-jinshu-074-huan-family:p034","quote":"沖性儉素，而謙虛愛士。嘗浴後，其妻送以新衣，沖大怒，促令持去。其妻復送之，而謂曰：「衣不經新，何緣得故！」沖笑而服之。命處士南陽劉鄰之為長史，鄰之不屈，親往迎之，禮之甚厚。又辟處士長沙鄧粲為別駕，備禮盡恭。粲感其好賢，乃起應命。初，郗鑒、庾亮、庾翼臨終皆有表，樹置親戚，唯沖獨與謝安書云：「妙靈、靈寶尚小，亡兄寄託不終，以此為恨！」言不及私，論者益嘉之。及喪下江陵，士女老幼皆臨江瞻送，號哭盡哀。後玄篡位，追贈太傅、宣城王。有七子：嗣、謙、修、崇、弘、羨、怡。","subject_person_mention_id":"c-jinshu-074-huan-family:p034:m0222","object_person_mention_id":"c-jinshu-074-huan-family:p034:m0000"}],"interpretation_note":"依完整原段與具體錨點辨識；未補原文未述父母、配偶、世系或排行。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-074-huan-family:p034:m0222","start":222,"end":223,"surface":"崇","kind":"person","person_id":"u9s_w6j_8mc_AED","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。","paragraph_id":"c-jinshu-074-huan-family:p034","chapter_id":"c-jinshu-074-huan-family"}],"relations":[{"id":"a-huan-close-021","subject_person_id":"u9s_w6j_8mc_AED","predicate":"father","object_person_id":"u9s_w6j_8mc_AE","status":"source_attested","qualifiers":{"source_term":"有七子"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-074","source_id":"s-jinshu-074-ws1536331","chapter_id":"c-jinshu-074-huan-family","paragraph_id":"c-jinshu-074-huan-family:p034","quote":"沖性儉素，而謙虛愛士。嘗浴後，其妻送以新衣，沖大怒，促令持去。其妻復送之，而謂曰：「衣不經新，何緣得故！」沖笑而服之。命處士南陽劉鄰之為長史，鄰之不屈，親往迎之，禮之甚厚。又辟處士長沙鄧粲為別駕，備禮盡恭。粲感其好賢，乃起應命。初，郗鑒、庾亮、庾翼臨終皆有表，樹置親戚，唯沖獨與謝安書云：「妙靈、靈寶尚小，亡兄寄託不終，以此為恨！」言不及私，論者益嘉之。及喪下江陵，士女老幼皆臨江瞻送，號哭盡哀。後玄篡位，追贈太傅、宣城王。有七子：嗣、謙、修、崇、弘、羨、怡。","subject_person_mention_id":"c-jinshu-074-huan-family:p034:m0222","object_person_mention_id":"c-jinshu-074-huan-family:p034:m0000"}],"interpretation_note":"依完整原段與具體錨點辨識；未補原文未述父母、配偶、世系或排行。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-074-huan-family:p034","text":"沖性儉素，而謙虛愛士。嘗浴後，其妻送以新衣，沖大怒，促令持去。其妻復送之，而謂曰：「衣不經新，何緣得故！」沖笑而服之。命處士南陽劉鄰之為長史，鄰之不屈，親往迎之，禮之甚厚。又辟處士長沙鄧粲為別駕，備禮盡恭。粲感其好賢，乃起應命。初，郗鑒、庾亮、庾翼臨終皆有表，樹置親戚，唯沖獨與謝安書云：「妙靈、靈寶尚小，亡兄寄託不終，以此為恨！」言不及私，論者益嘉之。及喪下江陵，士女老幼皆臨江瞻送，號哭盡哀。後玄篡位，追贈太傅、宣城王。有七子：嗣、謙、修、崇、