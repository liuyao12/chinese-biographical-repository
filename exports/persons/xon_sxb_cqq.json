1%E5%9B%9B%E5%8F%B2_%E7%AC%AC158%E5%86%8A.pdf#page=4","start":0,"end":21,"text":"鍾唯應五鼓及三鼓也車駕數幸琅邪城宮人常從早"},{"column":"4L10","pdf_page":4,"half":"左","leaf":"3上","column_from_right":10,"url":"https://upload.wikimedia.org/wikipedia/commons/0/01/NLC892-411999017142-12428_%E4%BA%8C%E5%8D%81%E5%9B%9B%E5%8F%B2_%E7%AC%AC158%E5%86%8A.pdf#page=4","start":0,"end":8,"text":"發至湖北埭鷄始鳴"}]},"chapter_id":"c-nanqishu-020-peihuizhao-wyd","book_id":"b-nanqishu-020","work_id":"w-nanqishu","source_id":"s-nanqishu-020-peihuizhao-wyd"},{"id":"c-nanqishu-020-peihuizhao:p003","text":"舊顯陽、昭陽〔二〕殿，太后、皇后所居也。永明中無太后、皇后，羊貴嬪居昭陽殿西，范貴妃居昭陽殿東，寵姬荀昭華居鳳華柏殿。宮內御所居壽昌畫殿南閣，置白鷺鼓吹二部；乾光殿東西頭，置鍾磬兩廂：皆宴樂處也。上數遊幸諸苑囿，載宮人從後車，宮內深隱，不聞端門鼓漏聲，置鍾於景陽樓上，宮人聞鍾聲，早起裝飾，至今此鍾唯應五鼓及三鼓也。車駕數幸琅邪城，宮人常從，早發至湖北埭，鷄始鳴。","mentions":[{"id":"c-nanqishu-020-peihuizhao:p003:m0030","person_id":"wu6_k7p_4dn","start":30,"end":31,"surface":"羊","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanqishu-020-peihuizhao:p003:m0039","person_id":"xbm_e9e_uv2","start":39,"end":40,"surface":"范","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanqishu-020-peihuizhao:p003:m0050","person_id":"xon_sxb_cqq","start":50,"end":51,"surface":"荀","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":2074177,"first_line":28,"last_line":28,"line_start":0,"line_end":222,"raw_start":1541,"raw_end":1763,"raw_character_offsets":[1541,1542,1543,1544,1545,1546,1547,1548,1549,1550,1551,1592,1593,1594,1595,1596,1597,1598,1599,1600,1601,1602,1603,1604,1605,1606,1607,1608,1609,1610,1611,1612,1613,1614,1615,1616,1617,1618,1619,1620,1621,1622,1623,1624,1625,1626,1627,1628,1629,1630,1631,1632,1633,1634,1635,1636,1637,1638,1639,1640,1641,1642,1643,1644,1645,1646,1647,1648,1649,1650,1651,1652,1653,1654,1655,1656,1657,1658,1659,1660,1661,1662,1663,1664,1665,1666,1667,1668,1669,