i-093-hanlu:m007-0007","start":7,"end":9,"surface":"太子","kind":"person","person_id":"xnj_cjk_pcj_*AA","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m007-0023","start":23,"end":25,"surface":"穨當","kind":"person","person_id":"xnj_cjk_pcj_*AB","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m007-0026","start":26,"end":29,"surface":"韓太子","kind":"person","person_id":"xnj_cjk_pcj_*AA","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m007-0035","start":35,"end":36,"surface":"嬰","kind":"person","person_id":"xnj_cjk_pcj_*AAA","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m007-0038","start":38,"end":40,"surface":"孝文","kind":"person","person_id":"66o_td0_2ox","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m007-0044","start":44,"end":46,"surface":"穨當","kind":"person","person_id":"xnj_cjk_pcj_*AB","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m007-0047","start":47,"end":48,"surface":"嬰","kind":"person","person_id":"xnj_cjk_pcj_*AAA","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m007-0056","start":56,"end":58,"surface":"穨當","kind":"person","person_id":"xnj_cjk_pcj_*AB","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m007-0063","start":63,"end":64,"surface":"嬰","kind":"person","person_id":"xnj_cjk_pcj_*AAA","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m007-0094","start":94,"end":95,"surface":"嬰","kind":"person","person_id":"xnj_cjk_pcj_*AAA","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m007-0102","start":102,"end":104,"surface":"穨當","kind":"person","person_id":"xnj_cjk_pcj_*AB","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m007-0106","start":106,"end":108,"surface":"韓嫣","kind":"person","person_id":"xnj_cjk_pcj_*AB*A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m007-0121","start":121,"end":122,"surface":"說","kind":"person","person_id":"gh3_d07_hkt","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m007-0137","st