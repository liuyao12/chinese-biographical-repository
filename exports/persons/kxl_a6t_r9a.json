ations":[{"id":"a-shiji101-007","subject_person_id":"ugq_ldt_klj","predicate":"mother","object_person_id":"kxl_a6t_r9a","status":"source_attested","evidence":[{"chapter_id":"c-shiji-101-yuanchao","source_id":"s-shiji-101-yuanchao","paragraph_id":"c-shiji-101-yuanchao:p014","quote":"吳楚已破，上更以元王子平陸侯禮為楚王，袁盎為楚相。嘗上書有所言，不用。袁盎病免居家，與閭里浮沈，相隨行，鬬雞走狗。雒陽劇孟嘗過袁盎，盎善待之。安陵富人有謂盎曰：「吾聞劇孟博徒，將軍何自通之？」盎曰：「劇孟雖博徒，然母死，客送葬車千餘乘，此亦有過人者。且緩急人所有。夫一旦有急叩門，不以親為解，不以存亡為辭，天下所望者，獨季心、劇孟耳。今公常從數騎，一旦有緩急，寧足恃乎！」罵富人，弗與通。諸公聞之，皆多袁盎。"}],"qualifiers":{"source_term":"然母死","historicity":"historical_tradition"},"interpretation_note":"明示父、母、子、兄、弟及兄子分存。兄子以侄為主體、父系叔父為客體，不補種父的姓名；不由兄弟推定同父同母，不由太子推定長子。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-101-yuanchao:m014-0107","start":107,"end":108,"surface":"母","kind":"person","person_id":"kxl_a6t_r9a","status":"contextual_provisional","paragraph_id":"c-shiji-101-yuanchao:p014","chapter_id":"c-shiji-101-yuanchao"}],"relations":[{"id":"a-shiji101-007","subject_person_id":"ugq_ldt_klj","predicate":"mother","object_person_id":"kxl_a6t_r9a","status":"source_attested","evidence":[{"chapter_id":"c-shiji-101-yuanchao","source_id":"s-shiji-101-yuanchao","paragraph_id":"c-shiji-101-yuanchao:p014","quote":"吳楚已破，上更以元王子平陸侯禮為楚王，袁盎為楚相。嘗上書有所言，不用。袁盎病免居家，與閭里浮沈，相隨行，鬬雞走狗。雒陽劇孟嘗過袁盎，盎善待之。安陵富人有謂盎曰：「吾聞劇孟博徒，將軍何自通之？」盎曰：「劇孟雖博徒，然母死，客送葬車千餘乘，此亦有過人者。且緩急人所有。夫一旦有急叩門，不以親為解，不以存亡為辭，天下所望者，獨季心、劇孟耳。今公常從數騎，一旦有緩急，寧足恃乎！」罵富人，弗與通。諸公聞之，皆多袁盎。"}],"qualifiers":{"source_term":"然母死","historicity":"historical_tradition"},"interpretation_note":"明示父、母、子、兄、弟及兄子分存。兄子以侄為主體、父系叔父為客體，不補種父的姓名；不由兄弟推定同父同母，不由太子推定長子。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji101-042","person_id":"kxl_a6t_r9a","surfaces":["