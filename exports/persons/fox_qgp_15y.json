se},"family_paths":[],"mentions":[{"id":"c-jinshu-052-hua-tan:p012:m0070","start":70,"end":72,"surface":"范珧","kind":"person","person_id":"fox_qgp_15y","status":"contextual_provisional","paragraph_id":"c-jinshu-052-hua-tan:p012","chapter_id":"c-jinshu-052-hua-tan"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-052-hua-tan:p012","text":"建興初，元帝命為鎮東軍諮祭酒。譚博學多通，在府無事，乃著書三十卷，名曰《辨道》，上箋進之，帝親自覽焉。轉丞相軍諮祭酒，領郡大中正。譚薦干寶、范珧於朝，乃上箋求退曰：「譚聞霸主遠聽，以求才為務；僚屬量身，以審己為分。故疏廣告老，漢宣不違其志；幹木偃息，文侯就式其廬。譚無古人之賢，竊有懷遠之慕。自登清顯，出入二載，執筆無贊事之功，拾遺無補闕之績；過在納言，暗於舉善；狂寇未賓，復乏謀策。年向七十，志力日衰，素餐無勞，實宜辭退。謹奉還所假左丞相軍諮祭酒版。」不聽。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":80,"last_line":80,"raw_start":7923,"raw_end":8153,"raw_character_offsets":[7923,7924,7925,7926,7927,7928,7929,7930,7931,7932,7933,7934,7935,7936,7937,7938,7939,7940,7941,7942,7943,7944,7945,7946,7947,7948,7949,7950,7951,7952,7953,7954,7955,7956,7957,7958,7959,7960,7961,7962,7963,7964,7965,7966,7967,7968,7969,7970,7971,7972,7973,7974,7975,7976,7977,7978,7979,7980,7981,7982,7983,7984,7985,7986,7987,7988,7989,7990,7991,7992,7993,7994,7995,7996,7997,7998,7999,8000,8001,8002,8003,8004,8005,8006,8007,8008,8009,8010,8011,8012,8013,8014,8015,8016,8017,8018,8019,8020,8021,8022,8023,8024,8025,8026,8027,8028,8029,8030,8031,8032,8033,8034,8035,8036,8037,8038,8039,8040,8041,8042,8043,8044,8045,8046,8047,8048,8049,8050,8051,8052,8053,8054,8055,8056,8057,8058,8059,8060,8061,8062,8063,8064,8065,8066,8067,8068,8069,8070,8071,8072,8073,8074,8075,8076,8077,8078,8079,8080,8081,8082,8083,8084,8085,8086,8087,8088,8089,8090,8091,8092,8093,8094,8095,8096,8097,8098,8099,8100,8101,8102,8103,8104,8105,8106,8107,8108,8109,8110,8111,8112,8113,8114,8115,8116,8117,8118,8119,8120,8121,8122,8123,8124,8125,8126,8127,8128,8129,8130,8131,8132,81