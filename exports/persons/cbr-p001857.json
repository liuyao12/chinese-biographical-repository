ntextual_provisional"}],"chapter_id":"c-shiji-040-chu","book_id":"b-shiji-040","work_id":"w-shiji","source_id":"s-shiji-040-chu"},{"id":"c-shiji-040-chu:p004","text":"熊繹生熊艾，熊艾生熊亶，熊亶生熊勝。熊勝以弟熊楊爲後。熊楊生熊渠。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m004-0000","start":0,"end":2,"surface":"熊繹","kind":"person","person_id":"cbr-p001857","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m004-0003","start":3,"end":5,"surface":"熊艾","kind":"person","person_id":"cbr-p001858","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m004-0006","start":6,"end":8,"surface":"熊艾","kind":"person","person_id":"cbr-p001858","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m004-0009","start":9,"end":11,"surface":"熊亶","kind":"person","person_id":"cbr-p001859","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m004-0012","start":12,"end":14,"surface":"熊亶","kind":"person","person_id":"cbr-p001859","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m004-0015","start":15,"end":17,"surface":"熊勝","kind":"person","person_id":"cbr-p001860","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m004-0018","start":18,"end":20,"surface":"熊勝","kind":"person","person_id":"cbr-p001860","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m004-0022","start":22,"end":24,"surface":"熊楊","kind":"person","person_id":"cbr-p001861","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m004-0027","start":27,"end":29,"surface":"熊楊","kind":"person","person_id":"cbr-p001861","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m004-0030","start":30,"end":32,"surface":"熊渠","kind":"person","person_id":"cbr-p001862","status":"contextual_provisional"}],"chapter_id":"c-shiji-040-chu","book_id":"b-shiji-040","work_id":"w-shiji","source_id":"s-shiji-040-chu"},{"id":"c-shiji-040-chu:p033","text":"十一年，伐徐以恐呉。靈王次於乾豀以待之。王曰：「齊、晉、魯、衞，其封皆受寶器，我獨不。今吾使使周求鼎以爲分，其予我乎？」析父對曰：「其予君王哉！昔我先王熊繹辟在荊山，蓽露藍蔞以處草莽，跋渉山林以事天子，唯是桃弧棘矢以共王事。齊，王舅也；晉及魯、衞，王母弟也：楚是以無分而彼皆有。周今與四國服事君王，將惟命是從，豈敢愛鼎？」靈王曰：「昔我皇祖伯父昆吾舊許是宅，今鄭人貪其田，不我予，今我求之，其予我乎？」對曰：「周不愛鼎，鄭安敢愛田？」靈王曰：「昔諸侯遠我而畏晉，今吾大城陳、蔡、不羹，賦皆千乘，諸侯畏我乎？」對曰：「畏哉！」靈王喜曰：「析父善言古事焉。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m033-0010","start":10,"end":12,"surface":"靈王","kind":"person","person_id":"cbr-p001889","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m033-0020","start":20,"end":21,"surface":"王","kind":"person","person_id":"cbr-p001889","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m033-0060","start":60,"end":62,"surface":"析父","kind":"person","person_id":"cbr-p001906","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m033-0076","start":76,"end":78,"surface":"熊繹","kind":"person","person_id":"cbr-p001857","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m033-0161","start":161,"end":163,"surface":"靈王","kind":"person","person_id":"cbr-p001889","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m033-0172","start":172,"end":174,"surface":"昆吾","kind":"person","person_id":"cbr-p001846","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m033-0217","start":217,"end":219,"surface":"靈王","kind":"person","person_id":"cbr-p001889","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m033-0262","start":262,"end":264,"surface":"靈王","kind":"person","person_id":"cbr-p001889","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m033-0268","start":268,"end":270,"surface":"析父","kind":"person","person_id":"cbr-p001906","status":"contextual_provisional"}],"chapter_id":"c-shiji-040-chu","book_id":"b-shiji-040","work_id":"w-shiji","source_id":"s-shiji-040-chu"}],"sources":[{"chapter_id":"c-shiji-040-chu","work_id":"w-shiji","book_id":"b-shiji-040","source_id":"s-shiji-040-chu","source":{"title":"史記／卷040","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷040","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷040&oldid=8736796","revision_id":873