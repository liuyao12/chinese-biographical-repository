{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004284","identity_policy":"contextual_provisional","person_ids":["cbr-p004284"],"persons":[{"id":"cbr-p004284","label":"吳起（孟子荀卿列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"吳起","mention_ids":["c-shiji-074-mengxun:m002-0073"]}],"evidence":[{"mention_id":"c-shiji-074-mengxun:m002-0073","chapter_id":"c-shiji-074-mengxun","paragraph_id":"c-shiji-074-mengxun:p002","quote":"吳起"}]}],"mentions":[{"id":"c-shiji-074-mengxun:m002-0073","start":73,"end":75,"surface":"吳起","kind":"person","person_id":"cbr-p004284","status":"contextual_provisional","paragraph_id":"c-shiji-074-mengxun:p002","chapter_id":"c-shiji-074-mengxun"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji074-008","person_id":"cbr-p004284","surfaces":["吳起"],"scope":"same_chapter","chapter_ids":["c-shiji-074-mengxun"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-074-mengxun:p002","quote":"孟軻，騶人也。受業子思之門人。道既通，游事齊宣王，宣王不能用。適梁，梁惠王不果所言，則見以為迂遠而闊於事情。當是之時，秦用商君，富國彊兵；楚、魏用吳起，戰勝弱敵；齊威王、宣王用孫子、田忌之徒，而諸侯東面朝齊。天下方務於合從連衡，以攻伐為賢，而孟軻乃述唐、虞、三代之德，是以所如者不合。退而與萬章之徒序詩書，述仲尼之意，作孟子七篇。其後有騶子之屬。"}],"rationale":"依前5段明示稱名與局部敘事暫接，孟軻與孟子人稱分辨書名；第5段騶子限接前段騶衍。騶忌、騶衍與三騶群體不混，齊宣王威王與燕昭王分開。夫子引言、孫子、大王去邠與繆公不按記憶補名字；仲尼與孔子已發ID各保留，跨篇暫同指另存於本篇equivalences記錄。引古與傳說保持來源層，不作已確證年代與事實。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-074-mengxun:p002","text":"孟軻，騶人也。受業子思之門人。道既通，游事齊宣王，宣王不能用。適梁，梁惠王不果所言，則見以為迂遠而闊於事情。當是之時，秦用商君，富國彊兵；楚、魏用吳起，戰勝弱敵；齊威王、宣王用孫子、田忌之徒，而諸侯東面朝齊。天下方務於合從連衡，以攻伐為賢，而孟軻乃述唐、虞、三代之德，是以所如者不合。退而與萬章之徒序詩書，述仲尼之意，作孟子七篇。其後有騶子之屬。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-074-mengxun:m002-0000","start":0,"end":2,"surface":"孟軻","kind":"person","person_id":"cbr-p004280","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m002-0009","start":9,"end":11,"surface":"子思","kind":"person","person_id":"cbr-p004281","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m002-0012","start":12,"end":14,"surface":"門人","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名群體、時代合稱或匿名說話者，不補成員與姓名；子思之門人不當子思本人。"},{"id":"c-shiji-074-mengxun:m002-0021","start":21,"end":24,"surface":"齊宣王","kind":"person","person_id":"cbr-p004282","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m002-0025","start":25,"end":27,"surface":"宣王","kind":"person","person_id":"cbr-p004282","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m002-0034","start":34,"end":37,"surface":"梁惠王","kind":"person","person_id":"cbr-p004278","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m002-0061","start":61,"end":63,"surface":"商君","kind":"person","person_id":"cbr-p004283","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m002-0073","start":73,"end":75,"surface":"吳起","kind":"person","person_id":"cbr-p004284","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m002-0081","start":81,"end":84,"surface":"齊威王","kind":"person","person_id":"cbr-p004285","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m002-0085","start":85,"end":87,"surface":"宣王","kind":"person","person_id":"cbr-p004282","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m002-0088","start":88,"end":90,"surface":"孫子","kind":"person","person_id":"cbr-p004286","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m002-0091","start":91,"end":93,"surface":"田忌","kind":"person","person_id":"cbr-p004287","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m002-0121","start":121,"end":123,"surface":"孟軻","kind":"person","person_id":"cbr-p004280","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m002-0125","start":125,"end":131,"surface":"唐、虞、三代","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名群體、時代合稱或匿名說話者，不補成員與姓名；子思之門人不當子思本人。"},{"id":"c-sh