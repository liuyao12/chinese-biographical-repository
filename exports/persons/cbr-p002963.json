{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p002963","identity_policy":"contextual_provisional","person_ids":["cbr-p002963"],"persons":[{"id":"cbr-p002963","label":"扶蘇（陳涉世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"公子扶蘇","mention_ids":["c-shiji-048-chenshe:m002-0116","c-shiji-048-chenshe:m002-0195","c-shiji-048-chenshe:m003-0141"]},{"surface":"扶蘇","mention_ids":["c-shiji-048-chenshe:m002-0121"]}],"evidence":[{"mention_id":"c-shiji-048-chenshe:m002-0116","chapter_id":"c-shiji-048-chenshe","paragraph_id":"c-shiji-048-chenshe:p002","quote":"公子扶蘇"},{"mention_id":"c-shiji-048-chenshe:m002-0195","chapter_id":"c-shiji-048-chenshe","paragraph_id":"c-shiji-048-chenshe:p002","quote":"公子扶蘇"},{"mention_id":"c-shiji-048-chenshe:m003-0141","chapter_id":"c-shiji-048-chenshe","paragraph_id":"c-shiji-048-chenshe:p003","quote":"公子扶蘇"},{"mention_id":"c-shiji-048-chenshe:m002-0121","chapter_id":"c-shiji-048-chenshe","paragraph_id":"c-shiji-048-chenshe:p002","quote":"扶蘇"}]}],"mentions":[{"id":"c-shiji-048-chenshe:m002-0116","start":116,"end":120,"surface":"公子扶蘇","kind":"person","person_id":"cbr-p002963","status":"contextual_provisional","paragraph_id":"c-shiji-048-chenshe:p002","chapter_id":"c-shiji-048-chenshe"},{"id":"c-shiji-048-chenshe:m002-0121","start":121,"end":123,"surface":"扶蘇","kind":"person","person_id":"cbr-p002963","status":"contextual_provisional","paragraph_id":"c-shiji-048-chenshe:p002","chapter_id":"c-shiji-048-chenshe"},{"id":"c-shiji-048-chenshe:m002-0195","start":195,"end":199,"surface":"公子扶蘇","kind":"person","person_id":"cbr-p002963","status":"contextual_provisional","paragraph_id":"c-shiji-048-chenshe:p002","chapter_id":"c-shiji-048-chenshe"},{"id":"c-shiji-048-chenshe:m003-0141","start":141,"end":145,"surface":"公子扶蘇","kind":"person","person_id":"cbr-p002963","status":"contextual_provisional","paragraph_id":"c-shiji-048-chenshe:p003","chapter_id":"c-shiji-048-chenshe"}],"relations":[],"title_holdings":[{"id":"th-shiji048-003","person_id":"cbr-p002963","title":"公子","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-048-chenshe","source_id":"s-shiji-048-chenshe","paragraph_id":"c-shiji-048-chenshe:p002","quote":"二世元年七月，發閭左適戍漁陽，九百人屯大澤鄉。陳勝、吳廣皆次當行，為屯長。會天大雨，道不通，度已失期。失期，法皆斬。陳勝、吳廣乃謀曰：「今亡亦死，舉大計亦死，等死，死國可乎？」陳勝曰：「天下苦秦久矣。吾聞二世少子也，不當立，當立者乃公子扶蘇。扶蘇以數諫故，上使外將兵。今或聞無罪，二世殺之。百姓多聞其賢，未知其死也。項燕為楚將，數有功，愛士卒，楚人憐之。或以為死，或以為亡。今誠以吾眾詐自稱公子扶蘇、項燕，為天下唱，宜多應者。」吳廣以為然。乃行卜。卜者知其指意，曰：「足下事皆成，有功。然足下卜之鬼乎！」陳勝、吳廣喜，念鬼，曰：「此教我先威眾耳。」乃丹書帛曰「陳勝王」，置人所罾魚腹中。卒買魚烹食，得魚腹中書，固以怪之矣。又间令吳廣之次所旁叢祠中，夜篝火，狐鳴呼曰「大楚興，陳勝王」。卒皆夜驚恐。旦日，卒中往往語，皆指目陳勝。"}],"attestations":[{"id":"th-shiji048-003:a001","paragraph_id":"c-shiji-048-chenshe:p002","start":116,"end":118,"surface":"公子","person_mention_id":"c-shiji-048-chenshe:m002-0116","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予、自立、既有用稱與冒稱分開；未知任期不由戰敗、被殺、歸報或首次提及推端點。詐稱與矯命不證合法或真實身份，制度種類仍待核。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji048-001","person_id":"cbr-p002963","surfaces":["公子扶蘇","扶蘇"],"scope":"same_chapter","chapter_ids":["c-shiji-048-chenshe"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-048-chenshe:p002","quote":"二世元年七月，發閭左適戍漁陽，九百人屯大澤鄉。陳勝、吳廣皆次當行，為屯長。會天大雨，道不通，度已失期。失期，法皆斬。陳勝、吳廣乃謀曰：「今亡亦死，舉大計亦死，等死，死國可乎？」陳勝曰：「天下苦秦久矣。吾聞二世少子也，不當立，當立者乃公子扶蘇。扶蘇以數諫故，上使外將兵。今或聞無罪，二世殺之。百姓多聞其賢，未知其死也。項燕為楚將，數有功，愛士卒，楚人憐之。或以為死，或以為亡。今誠以吾眾詐自稱公子扶蘇、項燕，為天下唱，宜多應者。」吳廣以為然。乃行卜。卜者知其指意，曰：「足下事皆成，有功。然足下卜之鬼乎！」陳勝、吳廣喜，念鬼，曰：「此教我先威眾耳。」乃丹書帛曰「陳勝王」，置人所罾魚腹中。卒買魚烹食，得魚腹中書，固以怪之矣。又间令吳廣之次所旁叢祠中，夜篝火，狐鳴呼曰「大楚興，陳勝王」。卒皆夜驚恐。旦日，卒中往往語，皆指目陳勝。"},{"paragraph_id":"c-shiji-048-chenshe:p003","quote":"吳廣素愛人，士卒多為用者。將尉醉，廣故數言欲亡，忿恚尉，令辱之，以激怒其眾。尉果笞廣。尉劍挺，廣起，奪而殺尉。陳勝佐之，并殺兩尉。召令徒屬曰：「公等遇雨，皆已失期，失期當斬。藉第令毋斬，而戍死者固十六七。且壯士不死即已，死即舉大名耳，王侯將相寧有種乎！」徒屬皆曰：「敬受命。」乃詐稱公子扶蘇、項燕，從民欲也。袒右，稱大楚。為壇而盟，祭以尉首。陳勝自立為將軍，吳廣為都尉。攻大澤鄉，收而攻蘄。蘄下，乃令符離人葛嬰將兵徇蘄以東。攻銍、酇、苦、柘、譙皆下之。行收兵。比至陳，車六七百乘，騎千余，卒數萬人。攻陳，陳守令皆不在，獨守丞與戰譙門中。弗勝，守丞死，乃入據陳。數日，號令召三老、豪傑與皆來會計事。三老、豪傑皆曰：「將軍身被堅執銳，伐無道，誅暴秦，復立楚國之社稷，功宜為王。」陳涉乃立為王，號為張楚。"}],"rationale":"限明示名、字及局部軍事角色；陳勝涉、吳廣叔、蔡賜房君與周文周章暫接，吳廣韓廣分開。引文四君短稱及比擬人物另留候選，詐稱扶蘇項燕不合陳吳，褚賈署稱不補姓名。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-048-chenshe:p002","text":"二世元年七月，發閭左適戍漁陽，九百人屯大澤鄉。陳勝、吳廣皆次當行，為屯長。會天大雨，道不通，度已失期。失期，法皆斬。陳勝、吳廣乃謀曰：「今亡亦死，舉大計亦死，等死，死國可乎？」陳勝曰：「天下苦秦久矣。吾聞二世少子也，不當立，當立者乃公子扶蘇。扶蘇以數諫故，上使外將兵。今或聞無罪，二世殺之。百姓多聞其賢，未知其死也。項燕為楚將，數有功，愛士卒，楚人憐之。或以為死，或以為亡。今誠以吾眾詐自稱公子扶蘇、項燕，為天下唱，宜多應者。」吳廣以為然。乃行卜。卜者知其指意，曰：「足下事皆成，有功。然足下卜之鬼乎！」陳勝、吳廣喜，念鬼，曰：「此教我先威眾耳。」乃丹書帛曰「陳勝王」，置人所罾魚腹中。卒買魚烹食，得魚腹中書，固以怪之矣。又间令吳廣之次所旁叢祠中，夜篝火，狐鳴呼曰「大楚興，陳勝王」。卒皆夜驚恐。旦日，卒中往往語，皆指目陳勝。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-048-chenshe:m002-0000","start":0,"end":2,"surface":"二世","kind":"person","person_id":"cbr-p002981","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m002-0015","start":15,"end":18,"surface":"九百人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱、對話或未名者待核；普通動詞、詐稱與矯命不當真實人物身份。"},{"id":"c-shiji-048-chenshe:m002-0023","start":23,"end":25,"surface":"陳勝","kind":"person","person_id":"cbr-p002979","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m002-0026","start":26,"end":28,"surface":"吳廣","kind":"person","person_id":"cbr-p002980","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m002-0058","start":58,"end":60,"surface":"陳勝","kind":"person","person_id":"cbr-p002979","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m002-0061","start":61,"end":63,"surface":"吳廣","kind":"person","person_id":"cbr-p002980","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m002-0088","start":88,"end":90,"surface":"陳勝","kind":"person","person_id":"cbr-p002979","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m002-0102","start":1