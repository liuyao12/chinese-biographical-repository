id":"c-shiji-092-hanxin:m019-0439","start":439,"end":441,"surface":"龍且","kind":"person","person_id":"xxs_ub0_7rv","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m019-0532","start":532,"end":534,"surface":"韓信","kind":"person","person_id":"v8v_2nz_wdy","status":"contextual_provisional"}],"chapter_id":"c-shiji-092-hanxin","book_id":"b-shiji-092","work_id":"w-shiji","source_id":"s-shiji-092-hanxin"},{"id":"c-shiji-092-hanxin:p021","text":"漢王之困固陵，用張良計，召齊王信，遂將兵會垓下。項羽已破，髙祖襲奪齊王軍。漢五年正月，徙齊王信爲楚王，都下邳。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-092-hanxin:m021-0000","start":0,"end":2,"surface":"漢王","kind":"person","person_id":"cz8_no4_4jl","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m021-0008","start":8,"end":10,"surface":"張良","kind":"person","person_id":"lpu_67y_ydz","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m021-0013","start":13,"end":16,"surface":"齊王信","kind":"person","person_id":"v8v_2nz_wdy","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m021-0024","start":24,"end":26,"surface":"項羽","kind":"person","person_id":"47s_3n9_u3c","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m021-0029","start":29,"end":31,"surface":"髙祖","kind":"person","person_id":"cz8_no4_4jl","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m021-0044","start":44,"end":47,"surface":"齊王信","kind":"person","person_id":"v8v_2nz_wdy","status":"contextual_provisional"}],"chapter_id":"c-shiji-092-hanxin","book_id":"b-shiji-092","work_id":"w-shiji","source_id":"s-shiji-092-hanxin"},{"id":"c-shiji-092-hanxin:p023","text":"項王亡將鐘離眛家在伊廬，素與信善。項王死後，亡歸信。漢王怨眛，聞其在楚，詔楚捕眛。信初之國，行縣邑，陳兵出入。漢六年，人有上書告楚王信反。髙帝以陳平計，天子巡狩會諸侯，南方有雲夢，發使告諸侯會陳：『吾將游雲夢。』實欲襲信，信弗知。髙祖且至楚，信欲發兵反，自度無罪，欲謁上，恐見禽。人或說信曰：『斬眛謁上，上必喜，無患。』信見眛計事。眛曰：『漢所以不擊取楚，以眛在公所。若欲捕我以自媚於漢，吾今日死，公亦隨手亡矣。』乃罵信曰：『公非長者！』卒自剄。信持其首，謁髙祖於陳。上令武士縛信，載後車。信曰：『果若人言，「狡兔死，良狗亨；髙鳥盡，良弓藏；敵國破，謀臣亡。」天下已定，我固當亨！』上曰：『人告公反。』遂械系信。至雒陽，赦信罪，以爲淮陰侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-092-hanxin:m023-0000","start":0,"end":2,"surface":"項王","kind":"person","person_id":"47s_3n9_u3c","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m023-0004","start":4,"end":7,"surface":"鐘離眛","kind":"person","person_id":"23z_9xy_hzo","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m023-0014","start":14,"end":15,"surface":"信","kind":"person","person_id":"v8v_2nz_wdy","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m023-0017","start":17,"end":19,"surface":"項王","kind":"person","person_id":"47s_3n9_u3c","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m023-0024","start":24,"end":25,"surface":"信","kind":"person","person_id":"v8v_2nz_wdy","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m023-0026","start":26,"end":28,"surface":"漢王","kind":"person","person_id":"cz8_no4_4jl","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m023-0029","start":29,"end":30,"surface":"眛","kind":"person","person_id":"23z_9xy_hzo","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m023-0039","start":39,"end":40,"surface":"眛","kind":"person","person_id":"23z_9xy_hzo","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m023-0041","start":41,"end":42,"surface":"信","kind":"person","person_id":"v8v_2nz_wdy","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m023-0059","start":59,"end":63,"surface":"人有上書","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定指代保留原文，不補姓名成員。"},{"id":"c-shiji-092-hanxin:m023-0064","start":64,"end":67,"surface":"楚王信","kind":"person","person_id":"v8v_2nz_wdy","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m023-0069","start":69,"end":71,"surface":"髙帝","kind":"person","person_id":"cz8_no4_4jl","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m023-0072","start":72,"end":74,"surface":"陳平","kind":"person","person_id":"km5_8u3_9yt","status":"contextual_prov