:[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji009-048","person_id":"e8y_ush_o9u","surfaces":["典客","劉揭"],"scope":"same_chapter","chapter_ids":["c-shiji-009-lvhou"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-009-lvhou:p027","quote":"八月庚申旦，平陽侯窋行御史大夫事，見相國產計事。郎中令賈壽使從齊來，因數產曰：「王不蚤之國，今雖欲行，尚可得邪？」具以灌嬰與齊楚合從，欲誅諸呂告產，乃趣產急入宮。平陽侯頗聞其語，乃馳告丞相、太尉。太尉欲入北軍，不得入。襄平侯通尚符節。乃令持節矯內太尉北軍。太尉復令酈寄與典客劉揭先說呂祿曰：「帝使太尉守北軍，欲足下之國，急歸將印辭去，不然，禍且起。」呂祿以為酈兄不欺己，遂解印屬典客，而以兵授太尉。太尉將之入軍門，行令軍中曰：「為呂氏右袒，為劉氏左袒。」軍中皆左袒為劉氏。太尉行至，將軍呂祿亦已解上將印去，太尉遂將北軍。"}],"rationale":"所列漢初諸王分封、平呂及接任敘事中暫定同指；同名不作全庫匹配，匿名者不補未見姓名，仍待異源覆核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji010-017","person_id":"e8y_ush_o9u","surfaces":["典客揭","劉揭"],"scope":"cross_chapter","chapter_ids":["c-shiji-009-lvhou","c-shiji-010-wendi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-009-lvhou:p027","quote":"八月庚申旦，平陽侯窋行御史大夫事，見相國產計事。郎中令賈壽使從齊來，因數產曰：「王不蚤之國，今雖欲行，尚可得邪？」具以灌嬰與齊楚合從，欲誅諸呂告產，乃趣產急入宮。平陽侯頗聞其語，乃馳告丞相、太尉。太尉欲入北軍，不得入。襄平侯通尚符節。乃令持節矯內太尉北軍。太尉復令酈寄與典客劉揭先說呂祿曰：「帝使太尉守北軍，欲足下之國，急歸將印辭去，不然，禍且起。」呂祿以為酈兄不欺己，遂解印屬典客，而以兵授太尉。太尉將之入軍門，行令軍中曰：「為呂氏右袒，為劉氏左袒。」軍中皆左袒為劉氏。太尉行至，將軍呂祿亦已解上將印去，太尉遂將北軍。"},{"paragraph_id":"c-shiji-010-wendi:p003","quote":"昌至渭橋，丞相以下皆迎。宋昌還報。代王馳至渭橋，群臣拜謁稱臣。代王下車拜。太尉勃進曰：「願請閒言。」宋昌曰：「所言公，公言之。所言私，王者不受私。」太尉乃跪上天子璽符。代王謝曰：「至代邸而議之。」遂馳入代邸。群臣從至。丞相陳平、太尉周勃、大將軍陳武、御史大夫張蒼、宗正劉郢、朱虛侯劉章、東牟侯劉興居、典客劉揭皆再拜言曰：「子弘等皆非孝惠帝子，不當奉宗廟。臣謹請（與）陰安侯列侯頃王后與瑯邪王、宗室、大臣、列侯、吏二千石議曰：『大王高帝長子，宜為高帝嗣。』願大王即天子位。」代王曰：「奉高帝宗廟，重事也。寡人不佞，不足以稱宗廟。願請楚王計宜者，寡人不敢當。」群臣皆伏固請。代王西鄉讓者三，南鄉讓者再。丞相平等皆曰：「臣伏計之，大王奉高帝宗廟最宜稱，雖天下諸侯萬民以為宜。臣等為宗廟社稷計，不敢忽。願大王幸聽臣等。臣謹奉天子璽符再拜上。」代王曰：「宗室將相王列侯以為莫宜寡人，寡人不敢辭。」遂即天子位。"},{"paragraph_id":"c-shiji-010-wendi:p007","quote":"壬子，遣車騎將軍薄昭迎皇太后於代。皇帝曰：「呂產自置為相國，呂祿為上將軍，擅矯遣灌將軍嬰將兵擊齊，欲代劉氏，嬰留滎陽弗擊，與諸侯合謀以誅呂氏。呂產欲為不善，丞相陳平與太尉周勃謀奪呂產等軍。朱虛侯劉章首先捕呂產等。太尉身率襄平侯通持節承詔入北軍。典客劉揭身奪趙王呂祿印。益封太尉勃萬戶，賜金五千斤。丞相陳平、灌將軍嬰邑各三千戶，金二千斤。朱虛侯劉章、襄平侯通、東牟侯劉興居邑各二千戶，金千斤。封典客揭為陽信侯，賜金千斤。」"}],"rationale":"本篇迎立代王與前卷平呂、分封及接任敘事相接，所列人物依事件與職事暫定同指；同名不作全庫替換，仍待異源及可靠版本覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-009-lvhou:p027","text":"八月庚申旦，平陽侯窋行御史大夫事，見相國產計事。郎中令賈壽使從齊來，因數產曰：「王不蚤之國，今雖欲行，尚可得邪？」具以灌嬰與齊楚合從，欲誅諸呂告產，乃趣產急入宮。平陽侯頗聞其語，乃馳告丞相、太尉。太尉欲入北軍，不得入。襄平侯通尚符節。乃令持節矯內太尉北軍。太尉復令酈寄與典客劉揭先說呂祿曰：「帝使太尉守北軍，欲足下之國，急歸將印辭去，不然，禍且起。」呂祿以為酈兄不欺己，遂解印屬典客，而以兵授太尉。太尉將之入軍門，行令軍中曰：「為呂氏右袒，為劉氏左袒。」軍中皆左袒為劉氏。太尉行至，將軍呂祿亦已解上將印去，太尉遂將北軍。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-009-lvhou:m027-0006","start":6,"end":10,"surface":"平陽侯窋","kind":"person","person_id":"865_tu4_a4b","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m027-0018","start":18,"end":21,"surface":"相國產","kind":"person","person_id":"acg_se3_w5x_B","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m027-0027","start":27,"end":29,"surface":"賈壽","kind":"person","person_id":"43x_4at_fj2","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m027-0036","start":36,"end":37,"surface":"產","kind":"person","person_id":"acg_se3_w5x_B","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m027-0059","start":59,"end":61,"surface":"灌嬰","kind":"person","person_id":"sj9_pfu_fwh","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m027-0072","start":72,"end":73,"surface":"產","kind":"person","person_id":"acg_se3_w5x_B","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m027-0076","start":76,"end":77,"surface":"產","kind":"person","person_id":"acg_se3_w5x_B","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m027-0081","start":81,"end":84,"surface":"平陽侯","kind":"person","person_id":"865_tu4_a4b","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m027-0092","start":92,"end":94,"surface":"丞相","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定官稱；不補造姓名或把身世指控當定論。"},{"id":"c-shiji-009-lvhou:m027-0095","start":95,"end":97,"surface":"太尉","kind":"person","person_id":"koy_6jg_gcc","status":"contextual_provisional"},{"id":"