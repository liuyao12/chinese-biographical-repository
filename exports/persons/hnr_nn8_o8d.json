s":[{"id":"c-jinshu-059-prince-wei:p004:m0000","surface":"瑋","start":0,"end":1,"person_id":"20b_1c2_a06","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-wei:p004:m0026","surface":"賈后","start":26,"end":28,"person_id":"c27_590_7e3_A","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-wei:p004:m0030","surface":"瓘","start":30,"end":31,"person_id":"67b_2b2_4b8","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-wei:p004:m0032","surface":"亮","start":32,"end":33,"person_id":"dkn_ge4_286_AAAAC","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-wei:p004:m0036","surface":"瑋","start":36,"end":37,"person_id":"20b_1c2_a06","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-wei:p004:m0061","surface":"范","start":61,"end":62,"person_id":"hnr_nn8_o8d","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-wei:p004:m0075","surface":"石勒","start":75,"end":77,"person_id":"0c9_95a_18b","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-059-prince-wei","book_id":"b-jinshu-059","work_id":"w-jinshu","source_id":"s-jinshu-059-prince-wei-ws2650517"},{"id":"c-jinshu-059-prince-yue:p009","text":"越專擅威權，圖為霸業，朝賢素望，選為佐吏，名將勁卒，充於己府，不臣之跡，四海所知。而公私罄乏，所在寇亂，州郡攜貳，上下崩離，禍結釁深，遂憂懼成疾。永嘉五年，薨于項。秘不發喪。以襄陽王范為大將軍，統其眾。還葬東海。石勒追及于苦縣甯平城，將軍錢端出兵距勒，戰死，軍潰。勒命焚越柩曰：「此人亂天下，吾為天下報之，故燒其骨以告天地。」於是數十萬眾，勒以騎圍而射之，相踐如山。王公士庶死者十餘萬。王彌弟璋焚其餘眾，並食之。天下歸罪於越。帝發詔貶越為縣王。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":199,"last_line":199,"raw_start":20784,"raw_end":21015,"raw_character_offsets":[20786,20787,20788,20789,20790,20791,20792,20793,20794,20795,20796,20797,20798,20799,20800,20801,20802,20803,20804,20805,20806,20807,20808,20809,20810,20811,20812,20813,20814,20815,20816,20817,20818,20819,20820,20821,20822,20823,20824,20825,20826,20827,20828,20829,20830,20831,20832,20833,20834,20835,20836,20837,20838,20839,20840,20