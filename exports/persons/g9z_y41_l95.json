on_mention_id":"c-nanqishu-032-chuxuan:p002:m0038"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"person_references":[{"id":"c-nanqishu-027-wangwenhe:p001:r0023","paragraph_id":"c-nanqishu-027-wangwenhe:p001","start":23,"end":26,"surface":"義陽王","person_id":"g9z_y41_l95","referent_role":"third_person","quote":"同族王文和，宋鎮北大將軍仲德兄孫也。景和中，為義陽王昶征北府主簿。昶于彭城奔虜，部曲皆散，文和獨送至界上。昶謂之曰：「諸人皆去，卿有老母，何不去邪！」文和乃去。昇明中，為巴陵內史。沈攸之事起，文和斬其使，馳白世祖告變，棄郡奔郢城。永明中，歷青、冀、兖、益四州刺史，平北將軍。","note":"依敘事與發言者、對語方及所述役事判讀。","chapter_id":"c-nanqishu-027-wangwenhe","book_id":"b-nanqishu-027","work_id":"w-nanqishu","source_id":"s-nanqishu-027-wangwenhe-ws1508012"},{"id":"c-nanshi-025-wangwenhe:p001:r0014","paragraph_id":"c-nanshi-025-wangwenhe:p001","start":14,"end":17,"surface":"義陽王","person_id":"g9z_y41_l95","referent_role":"third_person","quote":"仲德兄孫文和，景和中，為征北義陽王昶府佐。昶于彭城奔魏，部曲皆散，文和獨送至界上。昶謂曰：「諸人皆去，卿有老母，何獨不去？」文和乃去。升明中，為巴陵內史。沈攸之事起，文和斬其使，馳白齊武帝。及齊永明年中，曆青、冀、兗、益四州刺史。","note":"依敘事與發言者、對語方及所述役事判讀。","chapter_id":"c-nanshi-025-wangwenhe","book_id":"b-nanshi-025","work_id":"w-nanshi","source_id":"s-nanshi-025-wangwenhe-ws12757141"},{"start":108,"end":111,"surface":"義陽王","id":"c-songshu-041-wangxianyuan-family:p004:r0108","paragraph_id":"c-songshu-041-wangxianyuan-family:p004","person_id":"g9z_y41_l95","referent_role":"third_person","quote":"后父偃，字子游，晉丞相導玄孫，尚書嘏之子也。母晉孝武帝女鄱陽公主，宋受禪，封永成君。偃尚高祖第二女吳興長公主諱榮男，少歷顯官，黃門侍郎，祕書監，侍中。元嘉末，為散騎常侍、右衞將軍。世祖即位，以后父，授金紫光祿大夫，領義陽王師，常侍如故。遷右光祿大夫，常侍、王師如故。偃謙虛恭謹，不以世事關懷。孝建二年卒，時年五十四。追贈開府儀同三司，本官如故，諡曰恭公。","note":"本句按敘述視點回指義陽。","chapter_id":"c-songshu-041-wangxianyuan-family","book_id":"b-songshu-041","work_id":"w-songshu","source_id":"s-songshu-041-wangxianyuan-family-ws2634831"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-027-wangwenhe:p001","text":"同族王文和，宋鎮北大將軍仲德兄孫也。景和中，為義陽王昶征北府主簿。昶于彭城奔虜，部曲皆散，文和獨送至界上。昶謂之曰：「諸人皆去，卿有老母，何不去邪！」文和乃去。昇明中，為巴陵內史。沈攸之事起，文和斬其使，馳白世祖告變，棄郡奔郢城。永明中，歷青、冀、兖、益四州刺史，平北將軍。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-nanqishu-027-wangwenhe:p001:m0002","start":2,"end":5,"surface":"王文和","kind":"person","person_id":"726_jlm_j1k","status":"contextual_provisional"},{"id":"c-nanqishu-027-wangwenhe:p001:m0012","start":12,"end":14,"surface":"仲德","kind":"person","person_id":"qsd_v11_ya1_AA","status":"contextual_provisional"},{"id":"c-nanqishu-027-wangwenhe:p001:m0026","start":26,"end":27,"surface":"昶","kind":"person","person_id":"g9z_y41_l95","status":"contextual_provisional"},{"id":"c-nanqishu-027-wangwenhe:p001:m0033","start":33,"end":34,"surface":"昶","kind":"person","person_id":"g9z_y41_l95","status":"contextual_provisional"},{"id":"c-nanqishu-027-wangwenhe:p001:m0045","start":45,"end":47,"surface":"文和","kind":"person","person_id":"726_jlm_j1k","status":"contextual_provisional"},{"id":"c-nanqishu-027-wangwenhe:p001:m0053","start":53,"end":54,"surface":"昶","kind":"person","person_id":"g9z_y41_l95","status":"contextual_provisional"},{"id":"c-nanqishu-027-wangwenhe:p001:u0066","start":66,"end":68,"surface":"老母","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"義陽王指王文和的母親，未載名。"},{"id":"c-nanqishu-027-wangwenhe:p001:m0075","start":75,"end":77,"surface":"文和","kind":"person","person_id":"726_jlm_j1k","status":"contextual_provisional"},{"id":"c-nanqishu-027-wangwenhe:p001:m0090","start":90,"end":93,"surface":"沈攸之","kind":"person","person_id":"16c_0og_lvl_A","status":"contextual_provisional"},{"id":"c-nanqishu-027-wangwenhe:p001:m0096","start":96,"end":98,"surface":"文和","kind":"person","person_id":"726_jlm_j1k","status":"contextual_provisional"},{"id":"c-nanqishu-027-wangwenhe:p001:u0100","start":100,"end":101,"surface":"使","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"沈攸之所遣使者，未載名。"}],"source_position":{"first_line":104,"last_line":104,"revision_id":1508012,"raw_start":6989,"raw_end":7126,"raw_character_offsets":[6989,6990,6991,6992,6993,6994,6995,6996,6997,6998,6999,7000,7001,7002,7003,7004,7005,7006,7007,7008,7009,7010,7011,7012,7013,7014,7015,7016,7017,7018,7019,7020,7021,7022,7023,7024,7025,7026,7027,7028,7029,7030,7031,7032,7033,7034,7035,7036,7037,7038,7039,7040,7041,7042,7043,7044,7045,7046,7047,7048,7049,7050,7051,7052,7053,7054,7055,7056,7057,7058,7059,7060,7061,7062,7063,7064,7065,7066,7067,7068,7069,7070,7071,7072,7073,7074,7075,7076,7077,7078,7079,7080,7081,7082,7083,7084,7085,7086,7087,7088,7089,7090,7091,7092,7093,7094,7095,7096,7097,7098,7099,7100,7101,7102,7103,7104,7105,7106,7107,7108,7109,7110,7111,7112,7113,7114,7115,7116,7117,7118,7119,7120,7121,7122,7123,7124,7125]},"chapter_id":"c-nanqishu-027-wangwenhe","book_id":"b-nanqishu-027","work_id":"w-nanqishu","source_id":"s-nanqishu-027-wangwenhe-ws1508012"},{"id":"c-nanqishu-032-chuxuan:p002","text":"炫少清簡，爲從舅王景文所知。從兄淵謂人曰：「從弟廉勝獨立，乃十倍於我也。」宋義陽王昶爲太常，板炫補五官，累遷太子舍人，撫軍車騎記室，正員郎。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":55,"last_line":55,"raw_start":2613,"raw_end":2683,"raw_character_offsets":[2613,2614,2615,2616,2617,2618,2619,2620,2621,2622,2623,2624,2625,2626,2627,2628,2629,2630,2631,2632,2633,2634,2635,2636,2637,2638,2639,2640,2641,2642,2643,2644,2645,2646,2647,2648,2649,2650,2651,2652,2653,2654,2655,2656,2657,2658,2659,2660,2661,2662,2663,2664,2665,2666,2667,2668,2669,2670,2671,2672,2673,2674,2675,2676,2677,2678,2679,2680,2681,2682],"revision_id":1513918},"mentions":[{"id":"c-nanqishu-032-chuxuan:p002:m0000","start":0,"end":1,"surface":"炫","kind":"person","person_id":"fxb_jh0_jba","status":"contextual_provisional"},{"id":"c-nanqishu-032-chuxuan:p002:m0008","start":8,"end":11,"surface":"王景文","kind":"person","person_id":"1tc_q18_x7v","status":"contextual_provisional"},{"id":"c-nanqishu-032-chuxuan:p002:m0016","start":16,"end":17,"surface":"淵","kind":"person","person_id":"jyx_72x_8t2","status":"contextual_provisional"},{"id":"c-nanqishu-032-chuxuan:p002:m0038","start":38,"end":42,"surface":"義陽王昶","kind":"person","person_id":"g9z_y41_l95","status":"contextual_provisional"},{"id":"c-nanqishu-032-chuxuan:p002:m0047","start":47,"end":48,"surface":"炫","kind":"person","person_id":"fxb_jh0_jba","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-032-chuxuan","book_id":"b-nanqishu-032","work_id":"w-nanqishu","source_id":"s-nanqishu-032-chuxuan-ws1513918"},{"id":"c-nanshi-023-wangkun:p008","text":"琨謙恭謹慎，老而不渝，朝會必早起，簡閱衣裳，料數冠幘，如此數四，或為輕薄所笑。大明中，尚書僕射顏師伯豪貴，下省設女樂，琨時為度支尚書，要琨同聽，傳酒行炙，皆悉內妓。琨以男女無親授，傳行每至，令置床上，回面避之然後取，畢又如此，坐上莫不撫手嗤笑，琨容色自若。師伯後為設樂邀琨，琨不往。中領軍劉勉，晚節有棲退志，表求東陽郡，尚書令袁粲以下莫不讚美之。琨曰：「永初、景平，唯謝晦、殷景仁為中領軍，元嘉有到彥之，為人望才譽，勉不及也。近聞加侍中，已為怏怏，便求東陽，臣恐子房赤松未易輕擬。」其鯁直如此。而儉於財用，設酒不過兩碗，輒云：「此酒難遇」。鹽豉薑蒜之屬，並掛屏風，酒漿悉置床下，內外有求，琨手自賦之。景和中，討義陽王昶，六軍戒嚴，應須紫標，左右欲營辦，琨曰：「元嘉初征謝晦，有紫標在匣中，不須更作。」檢取果得焉。而避諱過甚，父名懌，母名恭心，並不得犯焉，時咸謂矯枉過正。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"start":0,"end":1,"surface":"琨","id":"c-nanshi-023-wangkun:p008:m0000","person_id":"7r6_k52_qji_ABAAFBA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作琨。"},{"start":47,"end":50,"surface":"顏師伯","id":"c-nanshi-023-wangkun:p008:m0047","person_id":"bw8_zlf_p2e","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作師伯。"},{"start":59,"end":60,"surface":"琨","id":"c-nanshi-023-wangkun:p008:m0059","person_id":"7r6_k52_qji_ABAAFBA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作琨。"},{"start":68,"end":69,"surface":"琨","id":"c-nanshi-023-wangkun:p008:m0068","person_id":"7r6_k52_qji_ABAAFBA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作琨。"},{"start":82,"end":83,"surface":"琨","id":"c-nanshi-023-wangkun:p008:m0082","person_id":"7r6_k52_qji_ABAAFBA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作琨。"},{"start":122