ngshu-059-zhangchang:p017:m0017"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-nanshi-023-wangkun-ws2478204","s-songshu-059-zhangchang"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"start":305,"end":309,"surface":"義陽王昶","id":"c-nanshi-023-wangkun:p008:m0305","person_id":"g9z_y41_l95","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作昶。","paragraph_id":"c-nanshi-023-wangkun:p008","chapter_id":"c-nanshi-023-wangkun"},{"id":"c-songshu-059-zhangchang:p017:m0017","start":17,"end":21,"surface":"義陽王昶","kind":"person","person_id":"g9z_y41_l95","status":"contextual_provisional","interpretation_note":"完整張暢本傳及對話語境判讀；同字不跨篇自動合人，未圖校。","paragraph_id":"c-songshu-059-zhangchang:p017","chapter_id":"c-songshu-059-zhangchang"}],"relations":[],"title_holdings":[],"address_assertions":[],"person_references":[{"start":108,"end":111,"surface":"義陽王","id":"c-songshu-041-wangxianyuan-family:p004:r0108","paragraph_id":"c-songshu-041-wangxianyuan-family:p004","person_id":"g9z_y41_l95","referent_role":"third_person","quote":"后父偃，字子游，晉丞相導玄孫，尚書嘏之子也。母晉孝武帝女鄱陽公主，宋受禪，封永成君。偃尚高祖第二女吳興長公主諱榮男，少歷顯官，黃門侍郎，祕書監，侍中。元嘉末，為散騎常侍、右衞將軍。世祖即位，以后父，授金紫光祿大夫，領義陽王師，常侍如故。遷右光祿大夫，常侍、王師如故。偃謙虛恭謹，不以世事關懷。孝建二年卒，時年五十四。追贈開府儀同三司，本官如故，諡曰恭公。","note":"本句按敘述視點回指義陽。","chapter_id":"c-songshu-041-wangxianyuan-family","book_id":"b-songshu-041","work_id":"w-songshu","source_id":"s-songshu-041-wangxianyuan-family-ws2634831"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanshi-023-wangkun:p008","text":"琨謙恭謹慎，老而不渝，朝會必早起，簡閱衣裳，料數冠幘，如此數四，或為輕薄所笑。大明中，尚書僕射顏師伯豪貴，下省設女樂，琨時為度支尚書，要琨同聽，傳酒行炙，皆悉內妓。琨以男女無親授，傳行每至，令置床上，回面避之然後取，畢又如此，坐上莫不撫手嗤笑，琨容色自若。師伯後為設樂邀琨，琨不往。中領軍劉勉，晚節有棲退志，表求東陽郡，尚書令袁粲以下莫不讚美之。琨曰：「永初、景平，唯謝晦、殷景仁為中領軍，元嘉有到彥之，為人望才譽，勉不及也。近聞加侍中，已為怏怏，便求東陽，臣恐子房赤松未易輕擬。」其鯁直如此。而儉於財用，設酒不過兩碗，輒云：「此酒難遇」。鹽豉薑蒜之屬，並掛屏風，酒漿悉置床下，內外有求，琨手自賦之。景和中，討義陽王昶，六軍戒嚴，應須紫標，左右欲營辦，琨曰：「元嘉初征謝晦，有紫標在匣中，不須更作。」檢取果得焉。而避諱過甚，父名懌，母名恭心，並不得犯焉，時咸謂矯枉過正。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"start":0,"end":1,"surface":"琨","id":"c-nanshi-023-wangkun:p008:m0000","person_id":"7r6_k52_qji_ABAAFBA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作琨。"},{"start":47,"end":50,"surface":"顏師伯","id":"c-nanshi-023-wangkun:p008:m0047","person_id":"bw8_zlf_p2e","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作師伯。"},{"start":59,"end":60,"surface":"琨","id":"c-nanshi-023-wangkun:p008:m0059","person_id":"7r6_k52_qji_ABAAFBA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作琨。"},{"start":68,"end":69,"surface":"琨","id":"c-nanshi-023-wangkun:p008:m0068","person_id":"7r6_k52_qji_ABAAFBA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作琨。"},{"start":82,"end":83,"surface":"琨","id":"c-nanshi-023-wangkun:p008:m0082","person_id":"7r6_k52_qji_ABAAFBA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作琨。"},{"start":122,"end":123,"surface":"琨","id":"c-nanshi-023-wangkun: