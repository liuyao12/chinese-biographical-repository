ind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-059-prince-lun","book_id":"b-jinshu-059","work_id":"w-jinshu","source_id":"s-jinshu-059-prince-lun-ws2650517"},{"id":"c-jinshu-059-prince-lun:p011","text":"秀本與張林有隙，雖外相推崇，內實忌之。及林為衛將軍，深怨不得開府，潛與荂箋，具說秀專權，動違眾心，而功臣皆小人，撓亂朝廷，要一時誅之。荂以書白倫，倫以示秀。秀勸倫誅林，倫從之。於是倫請宗室會于華林園，召林、秀及王輿入，因收林，殺之，誅三族。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":79,"last_line":79,"raw_start":7532,"raw_end":7654,"raw_character_offsets":[7534,7535,7536,7537,7538,7539,7540,7541,7542,7543,7544,7545,7546,7547,7548,7549,7550,7551,7552,7553,7554,7555,7556,7557,7558,7559,7560,7561,7562,7563,7564,7565,7566,7567,7568,7569,7570,7571,7572,7573,7574,7575,7576,7577,7578,7579,7580,7581,7582,7583,7584,7585,7586,7587,7588,7589,7590,7591,7592,7593,7594,7595,7596,7597,7598,7599,7600,7601,7602,7603,7604,7605,7606,7607,7608,7609,7610,7611,7612,7613,7614,7615,7616,7617,7618,7619,7620,7621,7622,7623,7624,7625,7626,7627,7628,7629,7630,7631,7632,7633,7634,7635,7636,7637,7638,7639,7640,7641,7642,7643,7644,7645,7646,7647,7648,7649,7650,7651,7652,7653],"revision_id":2650517},"mentions":[{"id":"c-jinshu-059-prince-lun:p011:m0000","surface":"秀","start":0,"end":1,"person_id":"8x5_e5i_yle","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-lun:p011:m0003","surface":"張林","start":3,"end":5,"person_id":"vzq_uuy_14d","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-lun:p011:m0020","surface":"林","start":20,"end":21,"person_id":"vzq_uuy_14d","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-lun:p011:m0035","surface":"荂","start":35,"end":36,"person_id":"5js_p45_eky","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-lun:p011:m0040","surface":"秀","start":40,"end":41,"person_id":"8x5_e5i_yle","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-lun:p011:m0067","surface":"荂","start":67,"end":68