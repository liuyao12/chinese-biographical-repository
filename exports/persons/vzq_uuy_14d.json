0111","surface":"林","start":111,"end":112,"person_id":"vzq_uuy_14d","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-059-prince-lun","book_id":"b-jinshu-059","work_id":"w-jinshu","source_id":"s-jinshu-059-prince-lun-ws2650517"},{"id":"c-jinshu-059-prince-lun:p016","text":"凡與倫為逆豫謀大事者：張林為秀所殺；許超、士猗、孫弼、謝惔、殷渾與秀為王輿所誅；張衡、閭和、孫髦、高越自陽翟還，伏胤戰敗還洛陽，皆斬於東市；蔡璜自陽翟降齊王冏，還洛自殺；王輿以功免誅，後與東萊王蕤謀殺冏，又伏法。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":89,"last_line":89,"raw_start":9094,"raw_end":9202,"raw_character_offsets":[9096,9097,9098,9099,9100,9101,9102,9103,9104,9105,9106,9107,9108,9109,9110,9111,9112,9113,9114,9115,9116,9117,9118,9119,9120,9121,9122,9123,9124,9125,9126,9127,9128,9129,9130,9131,9132,9133,9134,9135,9136,9137,9138,9139,9140,9141,9142,9143,9144,9145,9146,9147,9148,9149,9150,9151,9152,9153,9154,9155,9156,9157,9158,9159,9160,9161,9162,9163,9164,9165,9166,9167,9168,9169,9170,9171,9172,9173,9174,9175,9176,9177,9178,9179,9180,9181,9182,9183,9184,9185,9186,9187,9188,9189,9190,9191,9192,9193,9194,9195,9196,9197,9198,9199,9200,9201],"revision_id":2650517},"mentions":[{"id":"c-jinshu-059-prince-lun:p016:m0002","surface":"倫","start":2,"end":3,"person_id":"dkn_ge4_286_AAAAG","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-lun:p016:m0011","surface":"張林","start":11,"end":13,"person_id":"vzq_uuy_14d","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-lun:p016:m0014","surface":"秀","start":14,"end":15,"person_id":"8x5_e5i_yle","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-lun:p016:m0018","surface":"許超","start":18,"end":20,"person_id":"zps_5n7_3sk","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-lun:p016:m0021","surface":"士猗","start":21,"end":23,"person_id":"grn_uyo_3c1","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-lun:p016:m0024","surface":"孫弼","start":24,"end":26,"p