tion_id":"c-songshu-086-liumian:p001:m0000","object_person_mention_id":"c-songshu-086-liumian:p001:m0021"}],"interpretation_note":"《宋書》傳首明文。","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null}],"title_holdings":[],"address_assertions":[],"person_references":[{"id":"c-songshu-088-fulingyue:p001:r0062","paragraph_id":"c-songshu-088-fulingyue:p001","start":62,"end":64,"surface":"躬自","person_id":"e2r_5iw_ui0_A","referent_role":"third_person","quote":"勔躬自慰勞","note":"敘述劉勔親自慰勞傅靈越。","chapter_id":"c-songshu-088-fulingyue","book_id":"b-songshu-088","work_id":"w-songshu","source_id":"s-songshu-088-fulingyue-ws2069210"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-songshu-086-liumian:p001","text":"劉勔字伯猷，彭城人也。祖懷義，始興太守。父穎之，汝南、新蔡二郡太守，征林邑，遇疾卒。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-songshu-086-liumian:p001:m0000","start":0,"end":2,"surface":"劉勔","kind":"person","person_id":"e2r_5iw_ui0_A","identification_status":"contextual_provisional"},{"id":"c-songshu-086-liumian:p001:m0003","start":3,"end":5,"surface":"伯猷","kind":"person","person_id":"e2r_5iw_ui0_A","identification_status":"contextual_provisional"},{"id":"c-songshu-086-liumian:p001:m0012","start":12,"end":14,"surface":"懷義","kind":"person","person_id":"77k_fav_cfn","identification_status":"contextual_provisional"},{"id":"c-songshu-086-liumian:p001:m0021","start":21,"end":23,"surface":"穎之","kind":"person","person_id":"e2r_5iw_ui0","identification_status":"contextual_provisional"}],"chapter_id":"c-songshu-086-liumian","book_id":"b-songshu-086","work_id":"w-songshu","source_id":"s-songshu-086-liumian-ws2069103"},{"id":"c-songshu-088-fulingyue:p001","text":"時武衞將軍王廣之領軍隸劉勔，攻殷琰於壽陽，傅靈越奔逃，為廣之軍人所生禽，厲聲曰：「我傅靈越也。汝得賊何不即殺。」生送詣勔，勔躬自慰勞，詰其叛逆，對曰：「九州唱義，豈獨在我。」勔又問：「四方阻逆，無戰不禽，主上皆加以曠蕩，即其才用。卿何不早歸天闕，乃逃命草間乎？」靈越答曰：「薛公舉兵淮北，威震天下，不能專任智勇，委付子姪，致敗之由，實在於此。然事之始末，備皆參豫，人生歸於一死，實無面求活。」勔壯其意，送還京師。太宗欲加原宥，靈越辭對如一，終不回改，乃殺之。靈越，清河人也。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-songshu-088-fulingyue:p001:m0005","start":5,"end":8,"surface":"王廣之","kind":"person","person_id":"m4d_lon_pyg","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:m0011","start":11,"end":13,"surface":"劉勔","kind":"person","person_id":"e2r_5iw_ui0_A","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:m0015","start":15,"end":17,"surface":"殷琰","kind":"person","person_id":"mj8_5ic_4kk_A","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:m0021","start":21,"end":24,"surface":"傅靈越","kind":"person","person_id":"kfw_r30_lgz","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:m0028","start":28,"end":30,"surface":"廣之","kind":"person","person_id":"m4d_lon_pyg","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:u0030","start":30,"end":32,"surface":"軍人","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"王廣之部下，姓名、人數未詳。"},{"id":"c-songshu-088-fulingyue:p001:m0042","start":42,"end":45,"surface":"傅靈越","kind":"person","person_id":"kfw_r30_lgz","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:u0047","start":47,"end":48,"surface":"汝","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"靈越呼擒獲者；未能定位到具名者。"},{"id":"c-songshu-088-fulingyue:p001:m0059","start":59,"end":60,"surface":"勔","kind":"person","person_id":"e2r_5iw_ui0_A","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:m0061","start":61,"end":62,"surface":"勔","kind":"person","person_id":"e2r_5iw_ui0_A","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:m0087","start":87,"end":88,"surface":"勔","kind":"person","person_id":"e2r_5iw_ui0_A","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:u0111","start":111,"end":112,"surface":"其","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"劉勔泛指前句所說各方被俘者。"},{"id":"c-songshu-088-fulingyue:p001:m0131","start":131,"end":133,"surface":"靈越","kind":"person","person_id":"kfw_r30_lgz","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:u0158","start":158,"end":160,"surface":"子姪","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"靈越泛稱薛安都委任的子姪，未逐一指名，保留群體。"},{"id":"c-songshu-088-fulingyue:p001:m0196","start":196,"end":197,"surface":"勔","kind":"person","person_id":"e2r_5iw_ui0_A","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:m0213","start":213,"end":215,"surface":"靈越","kind":"person","person_id":"kfw_r30_lgz","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:m0229","start":229,"end":231,"surface":"靈越","kind":"person","person_id":"kfw_r30_lgz","identification_status":"contextual_provisional"}],"chapter_id":"c-songshu-088-fulingyue","book_id":"b-songshu-088","work_id":"w-songshu","source_id":"s-songshu-088-fulingyue-ws2069210"}],"sources":[{"chapter_id":"c-songshu-086-liumian","work_id":"w-songshu","book_id":"b-songshu-086","source_id":"s-songshu-086-liumian-ws2069103","source":{"title":"宋書卷86・劉勔","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=宋書/卷86&oldid=2069103","permalink":"https://zh.wikisource.org/w/index.php?title=宋書/卷86&oldid=2069103","revision_id":2069103,"accessed_on":"2026-11-20","edition":"維基文庫固定修訂原始文字，底本待考，未核書影。","extent":"傳首一完整原段，供卷八十八壽陽人物及父祖覆核。","section_locator":"劉勔","text_scope":"partial_chapter","image_verified":false,"review_status":"text_checked","rights":"古代正文；維基文庫貢獻者數位轉錄與標點。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","raw_url":"https://zh.wikisource.org/w/index.php?title=宋書/卷86&oldid=2069103&action=raw","raw_line":20,"ra