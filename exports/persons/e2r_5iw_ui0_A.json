liangshu","book_id":"b-liangshu-033","chapter_id":"c-liangshu-033-liuhui-grandfather","source_id":"s-liangshu-033-liuhui-grandfather-ws1514481","paragraph_id":"c-liangshu-033-liuhui-grandfather:p001","quote":"劉孝綽字孝綽，彭城人，本名冉。祖勔，宋司空忠昭公。父繪，齊大司馬霸府從事中郎。","subject_person_mention_id":"c-liangshu-033-liuhui-grandfather:p001:m0026","object_person_mention_id":"c-liangshu-033-liuhui-grandfather:p001:m0016"}],"status":"source_attested","interpretation_note":"孝綽父繪及祖勔，齊48另證父勉異字。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"a-songshu-086-liumian-grandfather","subject_person_id":"e2r_5iw_ui0_A","predicate":"grandfather","object_person_id":"77k_fav_cfn","status":"source_attested","qualifiers":{"source_term":"祖懷義","lineage":"paternal"},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-086","chapter_id":"c-songshu-086-liumian","source_id":"s-songshu-086-liumian-ws2069103","paragraph_id":"c-songshu-086-liumian:p001","quote":"劉勔字伯猷，彭城人也。祖懷義，始興太守。父穎之，汝南、新蔡二郡太守，征林邑，遇疾卒。","subject_person_mention_id":"c-songshu-086-liumian:p001:m0000","object_person_mention_id":"c-songshu-086-liumian:p001:m0012"}],"interpretation_note":"《宋書》傳首明文。","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null},{"id":"a-songshu-086-liumian-father","subject_person_id":"e2r_5iw_ui0_A","predicate":"father","object_person_id":"e2r_5iw_ui0","status":"source_attested","qualifiers":{"source_term":"父穎之","lineage":"paternal"},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-086","chapter_id":"c-songshu-086-liumian","source_id":"s-songshu-086-liumian-ws2069103","paragraph_id":"c-songshu-086-liumian:p001","quote":"劉勔字伯猷，彭城人也。祖懷義，始興太守。父穎之，汝南、新蔡二郡太守，征林邑，遇疾卒。","subject_person_mention_id":"c-songshu-086-liumian:p001:m0000","object_person_mention_id":"c-songshu-086-liumian:p001:m0021"}],"interpretation_note":"《宋書》傳首明文。","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null}],"title_holdings":[{"id":"th-nanshi023-wangkun-77-141","person_id":"e2r_5iw_ui0_A","title":"中領軍","kind":"office","mode":"attestation","attestations":[{"id":"th-nanshi023-wangkun-77-141:a","paragraph_id":"c-nanshi-023-wangkun:p008","start":141,"end":144,"surface":"中領軍","person_mention_id":"c-nanshi-023-wangkun:p008:m0144","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-023","chapter_id":"c-nanshi-023-wangkun","source_id":"s-nanshi-023-wangkun-ws2478204","paragraph_id":"c-nanshi-023-wangkun:p008","quote":"琨謙恭謹慎，老而不渝，朝會必早起，簡閱衣裳，料數冠幘，如此數四，或為輕薄所笑。大明中，尚書僕射顏師伯豪貴，下省設女樂，琨時為度支尚書，要琨同聽，傳酒行炙，皆悉內妓。琨以男女無親授，傳行每至，令置床上，回面避之然後取，畢又如此，坐上莫不撫手嗤笑，琨容色自若。師伯後為設樂邀琨，琨不往。中領軍劉勉，晚節有棲退志，表求東陽郡，尚書令袁粲以下莫不讚美之。琨曰：「永初、景平，唯謝晦、殷景仁為中領軍，元嘉有到彥之，為人望才譽，勉不及也。近聞加侍中，已為怏怏，便求東陽，臣恐子房赤松未易輕擬。」其鯁直如此。而儉於財用，設酒不過兩碗，輒云：「此酒難遇」。鹽豉薑蒜之屬，並掛屏風，酒漿悉置床下，內外有求，琨手自賦之。景和中，討義陽王昶，六軍戒嚴，應須紫標，左右欲營辦，琨曰：「元嘉初征謝晦，有紫標在匣中，不須更作。」檢取果得焉。而避諱過甚，父名懌，母名恭心，並不得犯焉，時咸謂矯枉過正。","person_mention_id":"c-nanshi-023-wangkun:p008:m0144"}],"status":"source_attested","interpretation_note":"本句所載官名，任期無確切年月。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"th-nanshi023-wangkun-77-216","person_id":"e2r_5iw_ui0_A","title":"侍中","kind":"office","mode":"attestation","attestations":[{"id":"th-nanshi023-wangkun-77-216:a","paragraph_id":"c-nanshi-023-wangkun:p008","start":216,"end":218,"surface":"侍中","person_mention_id":"c-nanshi-023-wangkun:p008:m0208","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-023","chapter_id":"c-nanshi-023-wangkun","source_id":"s-nanshi-023-wangkun-ws2478204","paragraph_id":"c-nanshi-023-wangkun:p008","quote":"琨謙恭謹慎，老而不渝，朝會必早起，簡閱衣裳，料數冠幘，如此數四，或為輕薄所笑。大明中，尚書僕射顏師伯豪貴，下省設女樂，琨時為度支尚書，要琨同聽，傳酒行炙，皆悉內妓。琨以男女無親授，傳行每至，令置床上，回面避之然後取，畢又如此，坐上莫不撫手嗤笑，琨容色自若。師伯後為設樂邀琨