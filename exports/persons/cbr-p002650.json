itle_holdings":[{"id":"th-shiji045-015","person_id":"r6c_fbu_uos","title":"太子","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-045-han","source_id":"s-shiji-045-han","paragraph_id":"c-shiji-045-han:p025","quote":"襄王四年，與秦武王會臨晉。其秋，秦使甘茂攻我宜陽。五年，秦拔我宜陽，斬首六萬。秦武王卒。六年，秦復與我武遂。九年，秦復取我武遂。十年，太子嬰朝秦而歸。十一年，秦伐我，取穰。與秦伐楚，敗楚將唐眛。"}],"attestations":[{"id":"th-shiji045-015:a001","paragraph_id":"c-shiji-045-han:p025","start":67,"end":69,"surface":"太子","person_mention_id":"c-shiji-045-han:m025-0067","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予、既有用稱與任事分開；三世、初見、被俘、出質或死亡不推全部官爵起訖，爭太子不記持有。未知曆日不換算。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji045-028","person_id":"r6c_fbu_uos","surfaces":["太子嬰"],"scope":"same_chapter","chapter_ids":["c-shiji-045-han"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-045-han:p025","quote":"襄王四年，與秦武王會臨晉。其秋，秦使甘茂攻我宜陽。五年，秦拔我宜陽，斬首六萬。秦武王卒。六年，秦復與我武遂。九年，秦復取我武遂。十年，太子嬰朝秦而歸。十一年，秦伐我，取穰。與秦伐楚，敗楚將唐眛。"},{"paragraph_id":"c-shiji-045-han:p026","quote":"十二年，太子嬰死。公子咎、公子蟣蝨爭爲太子。時蟣蝨質於楚。蘇代謂韓咎曰：「蟣蝨亡在楚，楚王欲内之甚。今楚兵十餘萬在方城之外，公何不令楚王筑萬室之都雍氏之旁，韓必起兵以救之，公必將矣。公因以韓楚之兵奉蟣蝨而内之，其聽公必矣，必以楚韓封公也。」韓咎從其計。"}],"rationale":"限本篇明示姓名、號稱、是為與連續敘事；兩位韓武子、韓趙簡子、韓魏文侯及不同時段未名楚王分開。原字及韓姬弒悼公、蟣蝨等疑點不訂正；裸王與回敘指代留待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-045-han:p025","text":"襄王四年，與秦武王會臨晉。其秋，秦使甘茂攻我宜陽。五年，秦拔我宜陽，斬首六萬。秦武王卒。六年，秦復與我武遂。九年，秦復取我武遂。十年，太子嬰朝秦而歸。十一年，秦伐我，取穰。與秦伐楚，敗楚將唐眛。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-045-han:m025-0000","start":0,"end":2,"surface":"襄王","kind":"person","person_id":"l9e_fbr_36a","status":"contextual_provisional"},{"id":"c-shiji-045-han:m025-0006","start":6,"end":9,"surface":"秦武王","kind":"person","person_id":"uxa_zs4_qpz","status":"contextual_provisional"},{"id":"c-shiji-045-han:m025-0018","start":18,"end":20,"surface":"甘茂","kind":"person","person_id":"fqw_nka_rjt","status":"contextual_provisional"},{"id":"c-shiji-045-han:m025-0039","start":39,"end":42,"surface":"秦武王","kind":"person","person_id":"uxa_zs4_qpz","status":"contextual_provisional"},{"id":"c-shiji-045-han:m025-0067","start":67,"end":70,"surface":"太子嬰","kind":"person","person_id":"r6c_fbu_uos","status":"contextual_provisional"},{"id":"c-shiji-045-han:m025-0094","start":94,"end":96,"surface":"唐眛","kind":"person","person_id":"tbv_g3c_03d","status":"contextual_provisional"}],"chapter_id":"c-shiji-045-han","book_id":"b-shiji-045","work_id":"w-shiji","source_id":"s-shiji-045-han"},{"id":"c-shiji-045-han:p026","text":"十二年，太子嬰死。公子咎、公子蟣蝨爭爲太子。時蟣蝨質於楚。蘇代謂韓咎曰：「蟣蝨亡在楚，楚王欲内之甚。今楚兵十餘萬在方城之外，公何不令楚王筑萬室之都雍氏之旁，韓必起兵以救之，公必將矣。公因以韓楚之兵奉蟣蝨而内之，其聽公必矣，必以楚韓封公也。」韓咎從其計。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-045-han:m026-0004","start":4,"end":7,"surface":"太子嬰","kind":"person","person_id":"r6c_fbu_uos","status":"contextual_provisional"},{"id":"c-shiji-045-han:m026-0009","start":9,"end":12,"surface":"公子咎","kind":"person","person_id":"c0i_eah_y59","status":"contextual_provisional"},{"id":"c-shiji-045-han:m026-0013","start":13,"end":17,"surface":"公子蟣蝨","kind":"person","person_id":"g2j_v25_c9b","status":"contextual_provisional"},{"id":"c-shiji-045-han:m026-0019","start":19,"end":21,"surface":"太子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱、對話指代或未名者保留；當前與引語回敘秦王不預接，爭太子不作已授太子，大業不先定祖名。"},{"id":"c-shiji-045-han:m026-0023","start":23,"end":25,"surface":"蟣蝨","kind":"person","person_id":"g2j_v25_c9b","status":"contextual_provisional"},{"id":"c-shiji-045-han:m026-0029","start":29,"end":31,"surface":"蘇代","kind":"person","person_id":"mx3_571_55a","status":"contextual_provisional"},{"id":"c-