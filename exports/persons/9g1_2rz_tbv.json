nshu-055-pan-yue"},{"id":"c-jinshu-060-xiexi:p002:m0146","surface":"歐陽建","start":146,"end":149,"person_id":"9g1_2rz_tbv","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-060-xiexi:p002","chapter_id":"c-jinshu-060-xiexi"},{"id":"c-jinshu-062-liukun:p001:m0157","surface":"歐陽建","start":157,"end":160,"person_id":"9g1_2rz_tbv","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-062-liukun:p001","chapter_id":"c-jinshu-062-liukun"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-055-pan-yue:p020","text":"初，芘為琅邪內史，孫秀為小史給岳，而狡黠自喜。岳惡其為人，數撻辱之，秀常銜忿。及趙王倫輔政，秀為中書令。岳於省內謂秀曰：「孫令猶憶疇昔周旋不？」答曰：「中心藏之，何日忘之！」岳於是自知不免。俄而秀遂誣岳及石崇、歐陽建謀奉淮南王允、齊王冏為亂，誅之，夷三族。岳將詣市，與母別曰：「負阿母！」初被收，俱不相知，石崇已送在市，岳後至，崇謂之曰：「安仁，卿亦復爾邪！」岳曰：「可謂白首同所歸。」岳《金穀詩》云：「投分寄石友，白首同所歸。」乃成其讖。岳母及兄侍御史釋、弟燕令豹、司徒掾據、據弟詵，兄弟之子，己出之女，無長幼一時被害，唯釋子伯武逃難得免。而豹女與其母相抱號呼不可解，會詔原之。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":96,"last_line":96,"raw_start":8279,"raw_end":8569,"raw_character_offsets":[8279,8280,8281,8282,8283,8284,8285,8286,8287,8288,8289,8290,8291,8292,8293,8294,8295,8296,8297,8298,8299,8300,8301,8302,8303,8304,8305,8306,8307,8308,8309,8310,8311,8312,8313,8314,8315,8316,8317,8318,8319,8320,8321,8322,8323,8324,8325,8326,8327,8328,8329,8330,8331,8332,8333,8334,8335,8336,8337,8338,8339,8340,8341,8342,8343,8344,8345,8346,8347,8348,8349,8350,8351,8352,8353,8354,8355,8356,8357,8358,8359,8360,8361,8362,8363,8364,8365,8366,8367,8368,8369,8370,8371,8372,8373,8374,8375,8376,8377,8378,8379,8380,8381,8382,8383,8384,8385,8386,8387,8388,8389,8390,8391,8392,8393,8394,8395,8396,8397,8398,8399,8400,8401,8402,8403,8404,8405,8406,8407,8408,8409,8410,8411,8412,8413,8414,8415,8416,8417,8418,8419,8420,8421,8422,8423,8424,8425,8426,8427,8428,8429,8430,8431,8432,8433,8434