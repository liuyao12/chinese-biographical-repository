tions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"start":86,"end":88,"surface":"華暠","kind":"person","person_id":"e5e_8ac_f12","id":"c-jinshu-059-liang-yang:line024:m0086","paragraph_id":"c-jinshu-059-liang-yang:line024","chapter_id":"c-jinshu-059-liang-yang"}],"relations":[],"title_holdings":[{"id":"th-phase4-j-067","person_id":"e5e_8ac_f12","title":"中書監","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-059","source_id":"s-jinshu-059-liang-yang","chapter_id":"c-jinshu-059-liang-yang","paragraph_id":"c-jinshu-059-liang-yang:line024","quote":"及武帝寢疾，為楊駿所排，乃以亮為侍中、大司馬、假黃鉞、大都督、督豫州諸軍事，出鎮許昌，加軒懸之樂，六佾之舞。封子羕為西陽公。未發，帝大漸，詔留亮委以後事。楊駿聞之，從中書監華暠索詔視，遂不還。帝崩，亮懼駿疑己，辭疾不入，于大司馬門外敘哀而已，表求過葬。駿欲討亮，亮知之，問計于廷尉何勖。勖曰：「今朝廷皆歸心於公，公何不討人而懼為人所討！」或說亮率所領入廢駿，亮不能用，夜馳赴許昌，故得免。及駿誅，詔曰：「大司馬、汝南王亮體道沖粹，通識政理，宣翼之績，顯於本朝，《二南》之風，流于方夏，將憑遠猷，以康王化。其以亮為太宰、錄尚書事，入朝不趨，劍履上殿，增掾屬十人，給千兵百騎，與太保衛瓘對掌朝政。」亮論賞誅楊駿之功過差，欲以苟悅眾心，由是失望。","person_mention_id":"c-jinshu-059-liang-yang:line024:m0086"}],"attestations":[{"id":"th-phase4-j-067:a001","paragraph_id":"c-jinshu-059-liang-yang:line024","start":83,"end":86,"surface":"中書監","person_mention_id":"c-jinshu-059-liang-yang:line024:m0086","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"來源限定用稱或任授；不把未載紀年補成單年，不以死亡結束全部職爵。兼領與職掌按原詞保留。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-jinshu059-new-e5e_8ac_f12","person_id":"e5e_8ac_f12","surfaces":["華暠"],"scope":"same_chapter","chapter_ids":["c-jinshu-059-liang-yang"],"status":"contextual_provisional","confidence_level":"moderate","evidence":[{"work_id":"w-jinshu","book