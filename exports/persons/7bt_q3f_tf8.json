{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"7bt_q3f_tf8","canonical_person_id":"7bt_q3f_tf8","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["7bt_q3f_tf8"],"persons":[{"id":"7bt_q3f_tf8","label":"單豹（莊子達生所舉）","status":"active","historicity":"historical_tradition","aliases":[],"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-023","source_id":"s-nanshi-023-wangyu-jingwen-ws2478204","chapter_id":"c-nanshi-023-wangyu-jingwen","paragraph_id":"c-nanshi-023-wangyu-jingwen:p008","quote":"單","kind":"person_reference","mention_id":"c-nanshi-023-wangyu-jingwen:p008:r0198"}],"review":"ai_provisional","identity_note":"魯人，與張毅作對舉。"}],"source_mention_summary":[],"most_mentioned_source_ids":[],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[],"relations":[],"title_holdings":[],"address_assertions":[],"person_references":[{"id":"c-nanshi-023-wangyu-jingwen:p008:r0198","surface":"單","start":198,"end":199,"person_id":"7bt_q3f_tf8","referent_role":"third_person","paragraph_id":"c-nanshi-023-wangyu-jingwen:p008","quote":"人居貴要，但問心若為耳。大明之世，巢、徐二戴位不過執戟，權亢人主；顏師伯白衣僕射，橫行尚書中。袁粲作僕射領選，而人往往不知有粲。粲遷為令，居之不疑。今既省錄，令便居昔之錄任，置省事及幹僮，並依錄格。粲作令來亦不異為僕射，人情向粲，淡然亦復不改常。以此居貴位要任，當有致憂兢不？卿今雖作揚州、太子太傅，位雖貴而不關朝政，可安不懼，差於粲也。卿虛心受榮，有而不為累。貴高有危殆之懼，卑賤有溝壑之憂，張單雙災，木雁兩失。有心于避禍，不如無心于任運。夫千仞之木，既摧於斧斤，一寸之草，亦悴於踐蹋。高崖之修幹，與深谷之淺條，存亡之要，巨細一揆耳。晉將畢萬七戰皆獲，死於牖下，蜀相費禕從容坐談，斃于刺客。故甘心于履危，未必逢禍，縱意于處安，不必全福。但貴者自惜，故每憂其身，賤者自輕，故易忘其己。然為教者每誡貴不誡賤，言其貴滿好自恃也。凡名位貴達，人以存懷，泰則觸人改容，否則行路嗟愕。至如賤者，否泰不足以動人，存亡不足以絓數，死於溝瀆，困于塗路者，天地之間，亦復何限，人不系意耳。以此而推，貴何必難處，賤何必易安。但人生自應卑慎為道，行己用心，務思謹惜。","note":"按說話人、受話人及詔內上下文。","chapter_id":"c-nanshi-023-wangyu-jingwen","book_id":"b-nanshi-023","work_id":"w-nanshi","source_id":"s-nanshi-023-wangyu-jingwen-ws2478204"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanshi-023-wangyu-jingwen:p008","text":"人居貴要，但問心若為耳。大明之世，巢、徐二戴位不過執戟，權亢人主；顏師伯白衣僕射，橫行尚書中。袁粲作僕射領選，而人往往不知有粲。粲遷為令，居之不疑。今既省錄，令便居昔之錄任，置省事及幹僮，並依錄格。粲作令來亦不異為僕射，人情向粲，淡然亦復不改常。以此居貴位要任，當有致憂兢不？卿今雖作揚州、太子太傅，位雖貴而不關朝政，可安不懼，差於粲也。卿虛心受榮，有而不為累。貴高有危殆之懼，卑賤有溝壑之憂，張單雙災，木雁兩失。有心于避禍，不如無心于任運。夫千仞之木，既摧於斧斤，一寸之草，亦悴於踐蹋。高崖之修幹，與深谷之淺條，存亡之要，巨細一揆耳。晉將畢萬七戰皆獲，死於牖下，蜀相費禕從容坐談，斃于刺客。故甘心于履危，未必逢禍，縱意于處安，不必全福。但貴者自惜，故每憂其身，賤者自輕，故易忘其己。然為教者每誡貴不誡賤，言其貴滿好自恃也。凡名位貴達，人以存懷，泰則觸人改容，否則行路嗟愕。至如賤者，否泰不足以動人，存亡不足以絓數，死於溝瀆，困于塗路者，天地之間，亦復何限，人不系意耳。以此而推，貴何必難處，賤何必易安。但人生自應卑慎為道，行己用心，務思謹惜。","mentions":[{"id":"c-nanshi-023-wangyu-jingwen:p008:m0033","surface":"顏師伯","start":33,"end":36,"person_id":"bw8_zlf_p2e","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangyu-jingwen:p008:m0047","surface":"袁粲","start":47,"end":49,"person_id":"ez7_i28_72u","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangyu-jingwen:p008:m0062","surface":"粲","start":62,"end":63,"person_id":"ez7_i28_72u","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangyu-jingwen:p008:m0064","surface":"粲","start":64,"end":65,"person_id":"ez7_i28_72u","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangyu-jingwen:p008:m0099","surface":"粲","start":99,"end":100,"person_id":"ez7_i28_72u","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id"