ation_note":"景明後劾播借民田，北魏語境；現魏將伯輿與西晉王覽子基時代不合，不按名合。"},{"id":"c-weishu-weishou-058-yangbo-yangkan:p005:m0079","start":79,"end":80,"surface":"侃","kind":"person","person_id":"fum_370_iq6_AAAAA","status":"contextual_provisional","interpretation_note":"子侃正文停柩及襲華陰伯；下完整侃傳、同北史士業與裴邃／濟河／韋義遠事件。"},{"id":"c-weishu-weishou-058-yangbo-yangkan:p005:m0109","start":109,"end":110,"surface":"其","kind":"person","person_id":"fum_370_iq6_AAAA","status":"contextual_provisional","interpretation_note":"本傳明楊播字延慶本元休；父懿、子侃、華陰子進伯；北史同事鏈首選，外參不合字異人。"}],"chapter_id":"c-weishu-weishou-058-yangbo-yangkan","book_id":"b-weishu-weishou-058","work_id":"w-weishu-weishou","source_id":"s-weishu-weishou-058-yangbo-ws2087998"}],"sources":[{"chapter_id":"c-weishu-weishou-058-yangbo-yangkan","work_id":"w-weishu-weishou","book_id":"b-weishu-weishou-058","source_id":"s-weishu-weishou-058-yangbo-ws2087998","source":{"title":"魏書卷五十八楊播及子侃完整敘事","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E9%AD%8F%E6%9B%B8%2F%E5%8D%B758&oldid=2087998","permalink":"https://zh.wikisource.org/w/index.php?title=%E9%AD%8F%E6%9B%B8%2F%E5%8D%B758&oldid=2087998","revision_id":2087998,"raw_path":"sources/weishu-weishou/weishu058-ws2087998.wikitext","raw_file_sha256":"a53ae2dbced88decaa460fbf34f87bb5e65a0b37b524480cb362a3bebb1bc19d","accessed_on":"2026-10-22","edition":"維基文庫固定數位轉錄；實際版本底本未確認，未圖校","extent":"楊播開篇至楊侃末子純陀襲，止弟椿獨立傳前；另完整本卷史臣共評。非全058卷。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"license_url":"https://creativecommons.org/licenses/by-sa/4.0/","rights":"古代正文；數位見證及網站校勘署名依維基文庫CC BY-SA4.0與附加條款保留","normalization":{"character_conversion":{},"extraction_note":"保原字與標點；段落按固定raw非空正文行。只分離網站ref校勘，原ref全文連raw位於annotation，逐字映射無摘要。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year