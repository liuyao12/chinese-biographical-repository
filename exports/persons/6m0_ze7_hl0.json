entions":[{"id":"shiji-020-t1-r062-c06-m000","start":10,"end":12,"surface":"孫都","person_id":"6m0_ze7_hl0","status":"contextual_provisional","interpretation_note":"按同列封國、封爵事由及本傳相同事件接合；不以數位年份作另一件事件證據，授爵與戰役、父死分開。 本傳都稽、表孫都，徐廣明釋表曰孫都；保留分源姓名。","identity_evidence":[{"work_id":"w-shiji","book_id":"b-shiji-113","chapter_id":"c-shiji-113-nanyue","source_id":"s-shiji113-nanyue","source_revision":8735632,"paragraph_id":"c-shiji-113-nanyue:p011","person_id":"6m0_ze7_hl0","quote":"元鼎六年冬，樓船將軍將精卒先陷尋陜，破石門，得越船粟，因推而前，挫越鋒，以數萬人待伏波。伏波將軍將罪人，道遠，會期後，與樓船會乃有千餘人，遂俱進。樓船居前，至番禺。建德、嘉皆城守。樓船自擇便處，居東南面；伏波居西北面。會暮，樓船攻敗越人，縱火燒城。越素聞伏波名，日暮，不知其兵多少。伏波乃為營，遣使者招降者，賜印，復縱令相招。樓船力攻燒敵，反驅而入伏波營中。犁旦，城中皆降伏波。呂嘉、建德已夜與其屬數百人亡入海，以船西去。伏波又因問所得降者貴人，以知呂嘉所之，遣人追之。以其故校尉司馬蘇弘得建德，封為海常侯；越郎都稽得嘉，封為臨蔡侯。"}]}],"table_id":"shiji-020","table_fragment_id":"shiji-020-digital-table-1","table_row_id":"shiji-020-t1-r062","table_cell_id":"shiji-020-t1-r062-c06","work_id":"w-shiji","book_id":"b-shiji-020","chapter_id":"table-chapter-shiji-020","source_id":"table-witness-shiji-020","source_revision":"2607036","source_header":["國名","侯功","元光","元朔","元狩","元鼎","元封","太初已後"],"row_year":null}],"sources":[{"chapter_id":"c-shiji-113-nanyue","work_id":"w-shiji","book_id":"b-shiji-113","source_id":"s-shiji113-nanyue","source":{"title":"史記／卷113","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷113","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷113&oldid=8735632","revision_id":8735632,"accessed_on":"2026-10-11","extent":"固定數位見證14段，末段索隱述贊分層。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"去header2及現代節標題，YL紀年模板僅去外殼保留原字。未核底本影像。","note":"索隱述贊另層，不混作正文。"}}},{"chapter_id":"table-chapter-shiji-020","work_id":"w-shiji","book_id":"b-shiji-020","source_id":"table-witness-shiji-020","source":{"id":"table-witness-shiji-020","work_id":"w-shiji","book_id":"b-shiji-020","chapter_id":"