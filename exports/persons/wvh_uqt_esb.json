wvh_uqt_esb","kind":"office","title":"黃門侍郎","mode":"attestation","status":"source_attested","effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本句所載職官，任免時間未詳。","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-061","chapter_id":"c-sanguozhi-061-panjun","source_id":"s-sanguozhi-061-panjun","paragraph_id":"c-sanguozhi-061-panjun:line016","quote":"　　先是，濬與陸遜俱駐武昌，共掌留事，還復故。時校事呂壹操弄威柄，奏按丞相顧雍、左將軍朱據等，皆見禁止。黃門侍郎謝厷語次問壹：「顧公事何如?」壹答：「不能佳。」厷又問：「若此公免退，誰當代之?」壹未答厷，厷曰：「得無潘太常得之乎?」壹良久曰：「君語近之也。」厷謂曰：「潘太常常切齒於君，但道遠無因耳。今日代顧公，恐明日便擊君矣。」壹大懼，遂解散雍事。濬求朝，詣建業，欲盡辭極諫。至，聞太子登已數言之而不見從。濬乃大請百寮，欲因會手刃殺壹，以身當之，為國除患。壹密聞知，稱疾不行。濬每進見，無不陳壹之姦險也。由此壹寵漸衰，後遂誅戮。權引咎責躬，因誚讓大臣，語在《權傳》。","person_mention_id":"c-sanguozhi-061-panjun:line016:m0056"}],"attestations":[{"id":"t-wu061-t-wu061-panjun21:a","paragraph_id":"c-sanguozhi-061-panjun:line016","person_mention_id":"c-sanguozhi-061-panjun:line016:m0056","start":52,"end":56,"surface":"黃門侍郎","usage":"narrative","date_expression":null}],"human_reviewed":false,"reviewer":"Codex（AI 代理）","model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-058-luxun:line050","text":"時謝淵、謝厷等各陳便宜，欲興利改作，以事下遜。遜議曰：","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-058-luxun:line050:m0001","start":1,"end":3,"surface":"謝淵","kind":"person","person_id":"vh6_zk6_7cl","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line050:m0004","start":4,"end":6,"surface":"謝厷","kind":"person","person_id":"wvh_uqt_esb","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line050:m0021","start":21,"end":22,"surface":"遜","kind":"person","person_id":"lii_454_vuv","status":"contextual_provisional","interpretat