nd":"person","person_id":"esh_e0a_jrw_AD","status":"contextual_provisional"}],"chapter_id":"c-shiji-103-wanshi","book_id":"b-shiji-103","work_id":"w-shiji","source_id":"s-shiji-103-wanshi"},{"id":"c-shiji-103-wanshi:p005","text":"建老白首，萬石君尚無恙。建爲郎中令，毎五日洗沐歸謁親，入子舍，竊問侍者，取親中帬廁牏，身自浣滌，復與侍者，不敢令萬石君知，以爲常。建爲郎中令，事有可言，屛人恣言，極切；至廷見，如不能言者。是以上乃親尊禮之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-103-wanshi:m005-0000","start":0,"end":1,"surface":"建","kind":"person","person_id":"esh_e0a_jrw_AA","status":"contextual_provisional"},{"id":"c-shiji-103-wanshi:m005-0005","start":5,"end":8,"surface":"萬石君","kind":"person","person_id":"esh_e0a_jrw_A","status":"contextual_provisional"},{"id":"c-shiji-103-wanshi:m005-0012","start":12,"end":13,"surface":"建","kind":"person","person_id":"esh_e0a_jrw_AA","status":"contextual_provisional"},{"id":"c-shiji-103-wanshi:m005-0056","start":56,"end":59,"surface":"萬石君","kind":"person","person_id":"esh_e0a_jrw_A","status":"contextual_provisional"},{"id":"c-shiji-103-wanshi:m005-0065","start":65,"end":66,"surface":"建","kind":"person","person_id":"esh_e0a_jrw_AA","status":"contextual_provisional"}],"chapter_id":"c-shiji-103-wanshi","book_id":"b-shiji-103","work_id":"w-shiji","source_id":"s-shiji-103-wanshi"},{"id":"c-shiji-103-wanshi:p006","text":"萬石君徙居陵裏。内史慶醉歸，入外門不下車。萬石君聞之，不食。慶恐，肉袒請罪，不許。舉宗及兄建肉袒，萬石君讓曰：「内史貴人，入閭里，里中長老皆走匿，而内史坐車中自如，固當！」乃謝罷慶。慶及諸子弟入里門，趨至家。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-103-wanshi:m006-0000","start":0,"end":3,"surface":"萬石君","kind":"person","person_id":"esh_e0a_jrw_A","status":"contextual_provisional"},{"id":"c-shiji-103-wanshi:m006-0010","start":10,"end":11,"surface":"慶","kind":"person","person_id":"esh_e0a_jrw_AD","status":"contextual_provisional"},{"id":"c-shiji-103-wanshi:m006-0021","start":21,"end":24,"surface":"萬石君","kind":"person","person_id":"esh_e0a_jrw_A","status":"contextual_provisional"},{"id":"c-shiji-103-wanshi:m006-0030","start":30,"end":31,"surface":"慶","kind":"person","person_id":"esh_e0a_jrw_AD","status":"contextual_provisional"},{"id":"c-shiji-103-wanshi:m006-0045","start":45,"end":46,"surface":"建","kind":"person","person_id":"esh_e0a_jrw_AA","status":"contextual_provisional"},{"id":"c-shiji-103-wanshi:m006-0049","start":49,"end":52,"surface":"萬石君","kind":"person","person_id":"esh_e0a_jrw_A","status":"contextual_provisional"},{"id":"c-shiji-103-wanshi:m006-0089","start":89,"end":90,"surface":"慶","kind":"person","person_id":"esh_e0a_jrw_AD","status":"contextual_provisional"},{"id":"c-shiji-103-wanshi:m006-0091","start":91,"end":92,"surface":"慶","kind":"person","person_id":"esh_e0a_jrw_AD","status":"contextual_provisional"}],"chapter_id":"c-shiji-103-wanshi","book_id":"b-shiji-103","work_id":"w-shiji","source_id":"s-shiji-103-wanshi"},{"id":"c-shiji-103-wanshi:p007","text":"萬石君以元朔五年中卒。長子郎中令建哭泣哀思，扶杖乃能行。歳餘，建亦死。諸子孫咸孝，然建最甚，甚於萬石君。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-103-wanshi:m007-0000","start":0,"end":3,"surface":"萬石君","kind":"person","person_id":"esh_e0a_jrw_A","status":"contextual_provisional"},{"id":"c-shiji-103-wanshi:m007-0016","start":16,"end":17,"surface":"建","kind":"person","person_id":"esh_e0a_jrw_AA","status":"contextual_provisional"},{"id":"c-shiji-103-wanshi:m007-0031","start":31,"end":32,"surface":"建","kind":"person","person_id":"esh_e0a_jrw_AA","status":"contextual_provisional"},{"id":"c-shiji-103-wanshi:m007-0042","start":42,"end":43,"surface":"建","kind":"person","person_id":"esh_e0a_jrw_AA","status":"contextual_provisional"},{"id":"c-shiji-103-wanshi:m007-0048","start":48,"end":51,"surface":"萬石君","kind":"person","person_id":"esh_e0a_jrw_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-103-wanshi","book_id":"b-shiji-103","work_id":"w-shiji","source_id":"s-shiji-103-wanshi"},{"id":"c-shiji-103-wanshi:p008","text":"建爲郎中令，書奏事，事下，建讀之，曰：「誤書！『馬』者與尾當五，今乃四，不足一。上譴死矣！」甚惶恐。其爲謹愼，雖他皆如是。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-103-wanshi:m008-0000","start":0,"end":1,"surface":"建","kind":"person","person_id":"esh_e0a_jrw_AA","status":"contextual_provisional"},{"id":"c-shiji-103-wanshi:m008-0013","start":13,"end":14,"surface":"建","kind":"person","person_id":"esh_e0a_jrw_AA","status":"contextual_provisional"}],"chapter_id":"c-shiji-103-wanshi","book_id":"b-shiji-103","work_id":"w-shiji","source_id":"s-shiji-103-wanshi"}],"sources":[{"chapter_id":"c-shiji-103-wanshi","work_id":"w-shiji","book_id":"b-shiji-103","source_id":"s-shiji-103-wanshi","source":{"title":"史記／卷103","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷103","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷103&oldid=2096814","revision_id":2096814,"accessed_on":"2026-10-10","extent":"26段正文含太史公論及1段見證附載索隱贊。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"僅去外緣空白；髙、衞、温、内、爲、呉、甐及原標點保留。","note":"已核讀全27段數位正文，未核底本影像。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical"}}
