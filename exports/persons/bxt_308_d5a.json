_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-074-huan-family:p015:m0181","start":181,"end":183,"surface":"索邈","kind":"person","person_id":"bxt_308_d5a","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。","paragraph_id":"c-jinshu-074-huan-family:p015","chapter_id":"c-jinshu-074-huan-family"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-074-huan-family:p015","text":"振營於江津。南陽太守魯宗之自襄陽破振將溫楷於柞溪，進屯紀南。振聞楷敗，留其將馮該守營，自率眾與宗之大戰。振勇冠三軍，眾莫能禦，宗之敗績。振追奔，遇宗之單騎於道，弗之識也，乃問宗之所在。紿曰：「已前走矣。」宗之於是自後而退。尋而劉毅等破馮該，平江陵。振聞該敗，眾潰而走。後與該子宏出自溳城，復襲江陵。荊州刺史司馬休之奔襄陽，振自號荊州刺史。建威將軍劉懷肅率甯遠將軍索邈，與振戰于沙橋。振兵雖少，左右皆力戰，每一合，振輒瞋目奮擊，眾莫敢當。振時醉，且中流矢，廣武將軍唐興臨陣斬之。","source_position":{"kind":"wikitext_codepoint_positions","raw_path":"sources/jinshu/wikisource-1536331-raw.wikitext","raw_start":3640,"raw_end":3939,"character_positions":[3642,3643,3644,3645,3646,3647,3648,3649,3650,3651,3652,3653,3654,3655,3656,3657,3658,3659,3660,3661,3662,3663,3664,3665,3666,3667,3668,3669,3670,3671,3672,3673,3674,3675,3676,3677,3678,3679,3680,3681,3682,3683,3684,3685,3686,3687,3688,3689,3690,3691,3692,3693,3694,3695,3696,3697,3698,3699,3700,3701,3702,3703,3704,3705,3706,3707,3708,3709,3710,3711,3712,3713,3714,3715,3716,3717,3718,3719,3720,3721,3722,3723,3724,3725,3726,3727,3728,3729,3730,3731,3732,3733,3734,3735,3736,3737,3738,3739,3740,3741,3742,3743,3744,3745,3746,3747,3748,3749,3750,3751,3811,3812,3813,3814,3815,3816,3817,3818,3819,3820,3821,3822,3823,3824,3825,3826,3827,3828,3829,3830,3831,3832,3833,3834,3835,3836,3837,3838,3839,3840,3841,3842,3843,3844,3845,3846,3847,3848,3849,3850,3851,3852,3853,3854,3855,3856,3857,3858,3859,3860,3861,3862,3863,3864,3865,3866,3867,3868,3869,3870,3871,3872