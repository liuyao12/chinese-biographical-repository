w6j_8mc_AAF","status":"contextual_provisional"},{"id":"c-songshu-047-liujingxuan:p006:m0185","start":185,"end":188,"surface":"孫無終","kind":"person","person_id":"2dc_1ae_eyw","status":"contextual_provisional"},{"id":"c-songshu-047-liujingxuan:p006:m0193","start":193,"end":195,"surface":"劉軌","kind":"person","person_id":"iaa_8y5_xpc","status":"contextual_provisional"},{"id":"c-songshu-047-liujingxuan:p006:m0196","start":196,"end":197,"surface":"軌","kind":"person","person_id":"iaa_8y5_xpc","status":"contextual_provisional"},{"id":"c-songshu-047-liujingxuan:p006:m0198","start":198,"end":200,"surface":"敬宣","kind":"person","person_id":"er7_nw6_n6w","status":"contextual_provisional"},{"id":"c-songshu-047-liujingxuan:p006:m0201","start":201,"end":203,"surface":"雅之","kind":"person","person_id":"3mo_ush_dt8","status":"contextual_provisional"},{"id":"c-songshu-047-liujingxuan:p006:m0234","start":234,"end":237,"surface":"慕容德","kind":"person","person_id":"van_pwm_swv","status":"contextual_provisional"}],"chapter_id":"c-songshu-047-liujingxuan","book_id":"b-songshu-047","work_id":"w-songshu","source_id":"s-songshu-047-liujingxuan-ws2190557"},{"id":"c-songshu-047-liujingxuan:p007","text":"敬宣素曉天文，知必有興復晉室者。尋夢丸土服之，既覺，喜曰：「丸者桓也。桓既吞矣，吾復本土乎。」乃結青州大姓諸崔、封，并要鮮卑大帥免逵，謀滅德，推休之為主，剋日垂發。時劉軌為德司空，大被委任，雅之又欲要軌，敬宣曰：「此公年老，吾觀其有安齊志，必不動，不可告也。」雅之以為不然，遂告軌，軌果不從。謀頗泄，相與殺軌而去。至淮、泗間，會高祖平京口，手書召敬宣，左右疑其詐，敬宣曰：「吾固知其然矣。下邳不誘我也。」即便馳還。既至京師，以敬宣為輔國將軍、晉陵太守，襲封武岡縣男。是歲，安帝元興三年也。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":57,"last_line":57,"raw_start":5225,"raw_end":5525,"raw_character_offsets":[5225,5226,5227,5228,5229,5230,5231,5232,5233,5234,5235,5236,5237,5238,5239,5240,5241,5242,5243,5244,5245,5246,5247,5248,5249,5250,5251,5252,5253,5254,5255,5256,5257,5258,5259,5260,5261,5262,5263,5264,5265,5266,5267,5268,5269,5270,5271,5272,5273,5274,5275,5276,5277,5278,5279,5280,5281,5282,5339,5340,5341,5342,5343,5344,5345,5346,5347,5348,5349,5350,5351,5352,5353,5354,5355,5356,5357,5358,535