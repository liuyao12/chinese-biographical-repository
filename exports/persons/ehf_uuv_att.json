ation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-066-wu:m022-0032","start":32,"end":37,"surface":"楚令尹子西","kind":"person","person_id":"ehf_uuv_att","status":"contextual_provisional","paragraph_id":"c-shiji-066-wu:p022","chapter_id":"c-shiji-066-wu"},{"id":"c-shiji-066-wu:m022-0056","start":56,"end":58,"surface":"子西","kind":"person","person_id":"ehf_uuv_att","status":"contextual_provisional","paragraph_id":"c-shiji-066-wu:p022","chapter_id":"c-shiji-066-wu"},{"id":"c-shiji-066-wu:m022-0079","start":79,"end":81,"surface":"子西","kind":"person","person_id":"ehf_uuv_att","status":"contextual_provisional","paragraph_id":"c-shiji-066-wu:p022","chapter_id":"c-shiji-066-wu"},{"id":"c-shiji-066-wu:m022-0106","start":106,"end":108,"surface":"子西","kind":"person","person_id":"ehf_uuv_att","status":"contextual_provisional","paragraph_id":"c-shiji-066-wu:p022","chapter_id":"c-shiji-066-wu"},{"id":"c-shiji-066-wu:m022-0110","start":110,"end":112,"surface":"子西","kind":"person","person_id":"ehf_uuv_att","status":"contextual_provisional","paragraph_id":"c-shiji-066-wu:p022","chapter_id":"c-shiji-066-wu"},{"id":"c-shiji-066-wu:m023-0013","start":13,"end":18,"surface":"楚令尹子西","kind":"person","person_id":"ehf_uuv_att","status":"contextual_provisional","paragraph_id":"c-shiji-066-wu:p023","chapter_id":"c-shiji-066-wu"}],"relations":[],"title_holdings":[{"id":"th-shiji066-024","person_id":"ehf_uuv_att","title":"令尹","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-066-wu","source_id":"s-shiji-066-wu","paragraph_id":"c-shiji-066-wu:p022","quote":"白公勝既歸楚，怨鄭之殺其父，乃陰養死士求報鄭。歸楚五年，請伐鄭，楚令尹子西許之。兵未發而晉伐鄭，鄭請救於楚。楚使子西往救，與盟而還。白公勝怒曰：「非鄭之仇，乃子西也。」勝自礪劍，人問曰：「何以為？」勝曰：「欲以殺子西。」子西聞之，笑曰：「勝如卵耳，何能為也。」"}],"attestations":[{"id":"th-shiji066-024:a001","paragraph_id":"c-shiji-066-wu:p022","start":33,"end":35,"surface":"令尹","person_mention_id":"c-shiji-066-wu:m022-0032","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授官事件與文獻用稱分存。首次提及、逃亡、死亡不推定任期終點；平王、昭王、闔廬、夫差王稱隨敘事分辨。夫概自立王不作合法授爵，封堂谿未補侯爵；王子綦佯充王及石乞事成為卿的未遂條件均不當實際任職。白公的號與封邑分存，未確定爵級。來源相對年序未換算為精確紀年，版本及稱號性質仍待覆核。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji066-046","person_id":"ehf_uuv_att","scope":"same_chapter","chapter_ids":["c-shiji-066-wu"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["子西","楚令尹子西"],"evidence":[{"paragraph_id":"c-shiji-066-wu:p022","quote":"白公勝既歸楚，怨鄭之殺其父，乃陰養死士求報鄭。歸楚五年，請伐鄭，楚令尹子西許之。兵未發而晉伐鄭，鄭請救於楚。楚使子西往救，與盟而還。白公勝怒曰：「非鄭之仇，乃子西也。」勝自礪劍，人問曰：「何以為？」勝曰：「欲以殺子西。」子西聞之，笑曰：「勝如卵耳，何能為也。」"},{"paragraph_id":"c-shiji-066-wu:p023","quote":"其後四歲，白公勝與石乞襲殺楚令尹子西、司馬子綦於朝。石乞曰：「不殺王，不可。」乃劫（之）王如高府。石乞從者屈固負楚惠王亡走昭夫人之宮。葉公聞白公為亂，率其國人攻白公。白公之徒敗，亡走山中，自殺。而虜石乞，而問白公尸處，不言將亨。石乞曰：「事成為卿，不成而亨，固其職也。」終不肯告其尸處。遂亨石乞，而求惠王復立之。"}],"rationale":"依本篇明示姓名及局部敘事暫接異稱：公子光自立為闔廬、軫立為昭王、勝號白公；王稱隨敘事主體分段。王子綦佯充王不接昭王，與後文司馬子綦暫分候選但不斷言異人。悼公與陽生按本文分存，矛盾待版本覆核；鮑氏不強接鮑牧。未名父子只按本段明示保存，不補姓名。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-066-wu:p022","text":"白公勝既歸楚，怨鄭之殺其父，乃陰養死士求報鄭。歸楚五年，請伐鄭，楚令尹子西許之。兵未發而晉伐鄭，鄭請救於楚。楚使子西往救，與盟而還。白公勝怒曰：「非鄭之仇，乃子西也。」勝自礪劍，人問曰：「何以為？」勝曰：「欲以殺子西。」子西聞之，笑曰：「勝如卵耳，何能為也。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-066-wu:m022-0000","start":0,"end":3,"surface":"白公勝","kind":"person","person_id":"h69_ln7_f94_A","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m022-0012","start":12,"end":13,"surface":"父","kind":"person","person_id":"h69_ln7_f94","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m022-0017","start":