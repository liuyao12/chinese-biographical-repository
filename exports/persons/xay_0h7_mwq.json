:2,"table_occurrence_count":0,"passage_count":2,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"2處獨立位置，2個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu037-gaomi-nanyang-ws2630018"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"id":"name-jin037-near-huang","person_id":"xay_0h7_mwq","surname":"司馬","ming":"晃","additional_names":[],"chapter_id":"c-jinshu-037-gaomi-nanyang-ws2630018","paragraph_id":"c-jinshu-037-gaomi-nanyang-ws2630018:p001","person_mention_id":"c-jinshu-037-gaomi-nanyang-ws2630018:p001:m0157","source_anchor":{"start":157,"end":161,"surface":"下邳王晃"},"quote":"高密文獻王泰，字子舒，彭城穆王權之弟，魏陽亭侯，補陽翟令，遷扶風太守。武帝受禪，封隴西王，邑三千二百戶，拜遊擊將軍。出為兗州刺史，加鷹揚將軍。遷使持節、都督甯益二州諸軍事、安西將軍，領益州刺史，稱疾不行。轉安北將軍，代兄權督鄴城守事。安西將軍、都督關中事。太康初，入為散騎常侍、前將軍，領鄴城門校尉，以疾去官。後代下邳王晃為尚書左僕射。出為鎮西將軍，領護西戎校尉、假節，代扶風王駿都督關中軍事，以疾還京師。永熙初，代石鑒為司空，尋領太子太保。及楊駿誅，泰領駿營，加侍中，給步兵二千五百人，騎五百匹。泰固辭，乃給千兵百騎。","note":"下邳王晃依宗室近系編輯復姓司馬，原文非全名；不由封國推籍貫。","status":"editorial_provisional","human_reviewed":false,"model":null,"surname_interpretation":{"kind":"royal_house_near_family_context","status":"editorial_provisional","human_reviewed":false,"literal_surname_in_this_mention":false,"scope":"本固定宗室近系單元，不由結構ID或一般同姓自動擴及他人"},"work_id":"w-jinshu","book_id":"b-jinshu-037","source_id":"s-jinshu037-gaomi-nanyang-ws2630018"}],"mentions":[{"id":"c-jinshu-037-gaomi-nanyang-ws2630018:p001:m0157","start"