9-0072","start":72,"end":76,"surface":"彊弩都尉","kind":"person","person_id":"wxg_pg3_wk0","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m059-0090","start":90,"end":92,"surface":"李陵","kind":"person","person_id":"8mo_ts5_9rp","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m059-0108","start":108,"end":110,"surface":"單于","kind":"person","person_id":"aok_z9g_2q0","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m059-0115","start":115,"end":116,"surface":"陵","kind":"person","person_id":"8mo_ts5_9rp","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m059-0135","start":135,"end":136,"surface":"陵","kind":"person","person_id":"8mo_ts5_9rp","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m059-0137","start":137,"end":138,"surface":"陵","kind":"person","person_id":"8mo_ts5_9rp","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m059-0154","start":154,"end":156,"surface":"單于","kind":"person","person_id":"aok_z9g_2q0","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m059-0158","start":158,"end":159,"surface":"陵","kind":"person","person_id":"8mo_ts5_9rp","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m059-0161","start":161,"end":163,"surface":"其女","kind":"person","person_id":"kkp_u3c_w4l","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m059-0163","start":163,"end":165,"surface":"妻之","kind":"person","person_id":"8mo_ts5_9rp","status":"contextual_provisional"}],"chapter_id":"c-shiji-110-xiongnu","book_id":"b-shiji-110","work_id":"w-shiji","source_id":"s-shiji110-xiongnu"},{"id":"c-shiji-110-xiongnu:p060","text":"後二歳，復使貳師將軍將六萬騎，步兵十萬，出朔方。彊弩都尉路博德將萬餘人，與貳師會。游擊將軍說將步騎三萬人，出五原。因杅將軍敖將萬騎步兵三萬人，出鴈門。匈奴聞，悉遠其累重於余吾水北，而單于以十萬騎待水南，與貳師將軍接戰。貳師乃解而引歸，與單于連戰十餘日。貳師聞其家以巫蠱族滅，因并眾降匈奴，得來還千人一兩人耳。游擊說無所得。因杅敖與左賢王戰，不利，引歸。是歳漢兵之出擊匈奴者不得言功多少，功不得御。有詔捕太醫令隨但，言貳師將軍家室族滅，使廣利得降匈奴。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-110-xiongnu:m060-0006","start":6,"end":10