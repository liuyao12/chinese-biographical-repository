_id":"cbr-p003826","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m006-0291","start":291,"end":293,"surface":"吳王","kind":"person","person_id":"cbr-p003825","status":"contextual_provisional"}],"chapter_id":"c-shiji-066-wu","book_id":"b-shiji-066","work_id":"w-shiji","source_id":"s-shiji-066-wu"},{"id":"c-shiji-066-wu:p007","text":"久之，楚平王以其邊邑鐘離與吳邊邑卑梁氏俱蠶，兩女子爭桑相攻，乃大怒，至於兩國舉兵相伐。吳使公子光伐楚，拔其鐘離、居巢而歸。伍子胥說吳王僚曰：「楚可破也。願復遣公子光。」公子光謂吳王曰：「彼伍胥父兄為戮於楚，而勸王伐楚者，欲以自報其讎耳。伐楚未可破也。」伍胥知公子光有內志，欲殺王而自立，未可說以外事，乃進專諸於公子光，退而與太子建之子勝耕於野。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-066-wu:m007-0003","start":3,"end":6,"surface":"楚平王","kind":"person","person_id":"cbr-p003813","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m007-0022","start":22,"end":25,"surface":"兩女子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代，未補姓名及成員；鮑氏不直接等同鮑牧。"},{"id":"c-shiji-066-wu:m007-0045","start":45,"end":48,"surface":"公子光","kind":"person","person_id":"cbr-p003826","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m007-0061","start":61,"end":64,"surface":"伍子胥","kind":"person","person_id":"cbr-p003808","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m007-0065","start":65,"end":68,"surface":"吳王僚","kind":"person","person_id":"cbr-p003825","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m007-0079","start":79,"end":82,"surface":"公子光","kind":"person","person_id":"cbr-p003826","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m007-0084","start":84,"end":87,"surface":"公子光","kind":"person","person_id":"cbr-p003826","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m007-0088","start":88,"end":90,"surface":"吳王","kind":"person","person_id":"cbr-p003825","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m007-0094","start":94,"end":96,"surface":"伍胥","kind":"person","person_id":"cbr-p003808","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m007-0096","start":96,"end":98,"surface":"父兄","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代，未補姓名及成員；鮑氏不直接等同鮑牧。"},{"id":"c-shiji-066-wu:m007-0105","start":105,"end":106,"surface":"王","kind":"person","person_id":"cbr-p003825","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m007-0126","start":126,"end":128,"surface":"伍胥","kind":"person","person_id":"cbr-p003808","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m007-0129","start":129,"end":132,"surface":"公子光","kind":"person","person_id":"cbr-p003826","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m007-0138","start":138,"end":139,"surface":"王","kind":"person","person_id":"cbr-p003825","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m007-0152","start":152,"end":154,"surface":"專諸","kind":"person","person_id":"cbr-p003828","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m007-0155","start":155,"end":158,"surface":"公子光","kind":"person","person_id":"cbr-p003826","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m007-0162","start":162,"end":165,"surface":"太子建","kind":"person","person_id":"cbr-p003814","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m007-0167","start":167,"end":168,"surface":"勝","kind":"person","person_id":"cbr-p003823","status":"contextual_provisional"}],"chapter_id":"c-shiji-066-wu","book_id":"b-shiji-066","work_id":"w-shiji","source_id":"s-shiji-066-wu"},{"id":"c-shiji-066-wu:p021","text":"伍子胥初所與俱亡故楚太子建之子勝者，在於吳。吳王夫差之時，楚惠王欲召勝歸楚。葉公諫曰：「勝好勇而陰求死士，殆有私乎！」惠王不聽。遂召勝，使居楚之邊邑鄢，號為白公。白公歸楚三年而吳誅子胥。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-066-wu:m021-0000","start":0,"end":3,"surface":"伍子胥","kind":"person","person_id":"cbr-p003808","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m021-0009","start":9,"end":13,"surface":"楚太子建","kind":"person","person_id":"cbr-p003814","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m021-0015","start":15,"end":16,"surface":"勝","kind":"person","person_id":"cbr-p003823","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m021-0022","start":22,"end":26,"surface":"吳王夫差","kind":"person","person_id":"cbr-p003840","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m021-0029","start":29,"end":32,"surface":"楚惠王","kind":"person","person_id":"cbr-p003851","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m021-0034","start":34,"end":35,"surface":"勝","kind":"person","person_id":"cbr-p003823","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m021-0038","start":38,"end":40,"surface":"葉公","kind":"person","person_id":"cbr-p003852","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m021-0044","start":44,"end":45,"surface":"勝","kind":"person","person_id":"cbr-p003823","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m021-0050","start":50,"end":52,"surface":"死士","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代，未補姓名及成員；鮑氏不直接等同鮑牧。"},{"id":"c-shiji-066-wu:m021-0059","start":59,"end":61,"surface":"惠王","kind":"person","person_id":"cbr-p003851","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m021-0066","start":66,"end":67,"surface":"勝","kind":"person","person_id":"cbr-p003823","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m021-0078","start":78,"end":80,"surface":"白公","kind":"person","person_id":"cbr-p003823","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m021-0081","start":81,"end":83,"surface":"白公","kind":"person","person_id":"cbr-p003823","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m021-0090","start":90,"end":92,"surface":"子胥","kind":"person","person_id":"cbr-p003808","status":"contextual_provisional"}],"chapter_id":"c-shiji-066-wu","book_id":"b-shiji-066","work_id":"w-shiji","source_id":"s-shiji-066-wu"},{"id":"c-shiji-066-wu:p022","text":"白公勝既歸楚，怨鄭之殺其父，乃陰養死士求報鄭。歸楚五年，請伐鄭，楚令尹子西許之。兵未發而晉伐鄭，鄭請救於楚。楚使子西往救，與盟而還。白公勝怒曰：「非鄭之仇，乃子西也。」勝自礪劍，人問曰：「何以為？」勝曰：「欲以殺子西。」子西聞之，笑曰：「勝如卵耳，何能為也。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-066-wu:m022-0000","start":0,"end":3,"surface":"白公勝","kind":"person","person_id":"cbr-p003823","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m022-0012","start":12,"end":13,"surface":"父","kind":"person","person_id":"cbr-p003814","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m022-0017","start":17,"end":19,"surface":"死士","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代，未補姓名及成員；鮑氏不直接等同鮑牧。"},{"id":"c-shiji-066-wu:m022-0032","start":32,"end":37,"surface":"楚令尹子西","kind":"person","person_id":"cbr-p003853","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m022-0056","start":56,"end":58,"surface":"子西","kind":"person","person_id":"cbr-p003853","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m022-0066","start":66,"end":69,"surface":"白公勝","kind":"person","person_id":"cbr-p003823","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m022-0079","start":79,"end":81,"surface":"子西","kind":"person","person_id":"cbr-p003853","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m022-0084","start":84,"end":85,"surface":"勝","kind":"person","person_id":"cbr-p003823","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m022-0089","start":89,"end":91,"surface":"人問","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代，未補姓名及成員；鮑氏不直接等同鮑牧。"},{"id":"c-shiji-066-wu:m022-0099","start":99,"end":100,"surface":"勝","kind":"person","person_id":"cbr-p003823","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m022-0106","start":106,"end":108,"surface":"子西","kind":"person","person_id":"cbr-p003853","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m022-0110","start":110,"end":112,"surface":"子西","kind":"person","person_id":"cbr-p003853","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m022-0119","start":119,"end":120,"surface":"勝","kind":"person","person_id":"cbr-p003823","status":"contextual_provisional"}],"chapter_id":"c-shiji-066-wu","book_id":"b-shiji-066","work_id":"w-shiji","source_id":"s-shiji-066-wu"},{"id":"c-shiji-066-wu:p023","text":"其後四歲，白公勝與石乞襲殺楚令尹子西、司馬子綦於朝。石乞曰：「不殺王，不可。」乃劫（之）王如高府。石乞從者屈固負楚惠王亡走昭夫人之宮。葉公聞白公為亂，率其國人攻白公。白公之徒敗，亡走山中，自殺。而虜石乞，而問白公尸處，不言將亨。石乞曰：「事成為卿，不成而亨，固其職也。」終不肯告其尸處。遂亨石乞，而求惠王復立之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-066-wu:m023-0005","start":5,"end":8,"surface":"白公勝","kind":"person","person_id":"cbr-p003823","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m023-0009","start":9,"end":11,"surface":"石乞","kind":"person","person_id":"cbr-p003854","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m023-0013","start":13,"end":18,"surface":"楚令尹子西","kind":"person","person_id":"cbr-p003853","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m023-0019","start":19,"end":23,"surface":"司馬子綦","kind":"person","person_id":"cbr-p003855","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m023-0026","start":26,"end":28,"surface":"石乞","kind":"person","person_id":"cbr-p003854","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m023-0033","start":33,"end":34,"surface":"王","kind":"person","person_id":"cbr-p003851","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m023-0044","start":44,"end":45,"surface":"王","kind":"person","person_id":"cbr-p003851","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m023-0049","start":49,"end":51,"surface":"石乞","kind":"person","person_id":"cbr-p003854","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m023-0051","start":51,"end":53,"surface":"從者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代，未補姓名及成員；鮑氏不直接等同鮑牧。"},{"id":"c-shiji-066-wu:m023-0053","start":53,"end":55,"surface":"屈固","kind":"person","person_id":"cbr-p003856","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m023-0056","start":56,"end":59,"surface":"楚惠王","kind":"person","person_id":"cbr-p003851","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m023-0061","start":61,"end":64,"surface":"昭夫人","kind":"person","person_id":"cbr-p003857","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m023-0067","start":67,"end":69,"surface":"葉公","kind":"person","person_id":"cbr-p003852","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m023-0070","start":70,"end":72,"surface":"白公","kind":"person","person_id":"cbr-p003823","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m023-0077","start":77,"end":79,"surface":"國人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代，未補姓名及成員；鮑氏不直接等同鮑牧。"},{"id":"c-shiji-066-wu:m023-0080","start":80,"end":82,"surface":"白公","kind":"person","person_id":"cbr-p003823","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m023-0083","start":83,"end":85,"surface":"白公","kind":"person","person_id":"cbr-p003823","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m023-0099","start":99,"end":101,"surface":"石乞","kind":"person","person_id":"cbr-p003854","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m023-0104","start":104,"end":106,"surface":"白公","kind":"person","person_id":"cbr-p003823","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m023-0114","start":114,"end":116,"surface":"石乞","kind":"person","person_id":"cbr-p003854","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m023-0145","start":145,"end":147,"surface":"石乞","kind":"person","person_id":"cbr-p003854","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m023-0150","start":150,"end":152,"surface":"惠王","kind":"person","person_id":"cbr-p003851","status":"contextual_provisional"}],"chapter_id":"c-shiji-066-wu","book_id":"b-shiji-066","work_id":"w-shiji","source_id":"s-shiji-066-wu"},{"id":"c-shiji-066-wu:p024","text":"太史公曰：怨毒之於人甚矣哉！王者尚不能行之於臣下，況同列乎！向令伍子胥從奢俱死，何異螻蟻。棄小義，雪大恥，名垂於後世，悲夫！方子胥窘於江上，道乞食，志豈嘗須臾忘郢邪？故隱忍就功名，非烈丈夫孰能致此哉？白公如不自立為君者，其功謀亦不可勝道者哉！","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-066-wu:m024-0000","star