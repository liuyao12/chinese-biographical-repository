ess_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji039-187","person_id":"b6y_c2c_kp6","surfaces":["侍者"],"scope":"same_chapter","chapter_ids":["c-shiji-039-jin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-039-jin:p054","quote":"至齊，齊桓公厚禮，而以宗女妻之，有馬二十乘，重耳安之。重耳至齊二歳而桓公卒，會豎刀等爲内亂，齊孝公之立，諸侯兵數至。留齊凡五歳。重耳愛齊女，毋去心。趙衰、咎犯乃於桑下謀行。齊女侍者在桑上聞之，以告其主。其主乃殺侍者，勸重耳趣行。重耳曰：「人生安樂，孰知其他！必死於此，不能去。」齊女曰：「子一國公子，窮而來此，數士者以子爲命。子不疾反國，報勞臣，而懷女德，竊爲子羞之。且不求，何時得功？」乃與趙衰等謀，醉重耳，載以行。行遠而覺，重耳大怒，引戈欲殺咎犯。咎犯曰：「殺臣成子，偃之願也。」重耳曰：「事不成，我食舅氏之肉。」咎犯曰：「事不成，犯肉腥臊，何足食！」乃止，遂行。"}],"rationale":"按本篇明示名與稱號、晉世系與具體事件暫定所列提及同指；附各段原文，未按同字短名全域合併；紀年與版本差異待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-039-jin:p054","text":"至齊，齊桓公厚禮，而以宗女妻之，有馬二十乘，重耳安之。重耳至齊二歳而桓公卒，會豎刀等爲内亂，齊孝公之立，諸侯兵數至。留齊凡五歳。重耳愛齊女，毋去心。趙衰、咎犯乃於桑下謀行。齊女侍者在桑上聞之，以告其主。其主乃殺侍者，勸重耳趣行。重耳曰：「人生安樂，孰知其他！必死於此，不能去。」齊女曰：「子一國公子，窮而來此，數士者以子爲命。子不疾反國，報勞臣，而懷女德，竊爲子羞之。且不求，何時得功？」乃與趙衰等謀，醉重耳，載以行。行遠而覺，重耳大怒，引戈欲殺咎犯。咎犯曰：「殺臣成子，偃之願也。」重耳曰：「事不成，我食舅氏之肉。」咎犯曰：「事不成，犯肉腥臊，何足食！」乃止，遂行。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m054-0003","start":3,"end":6,"surface":"齊桓公","kind":"person","person_id":"9w2_c77_53m","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m054-0011","start":11,"end":13,"surface":"宗女","kind":"person","person_id":"mua_01m_5ng","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m054-0022","start":22,"end":24,"surface":"重耳","kind":"person","person_id":"6di_ywz_ju4_AAA","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m054-0027","start":27,"end":29,"surface":"重耳","kind":"person","person_id":"6di_ywz_ju4_AAA","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m054-0034","start":34,"end":36,"surface":"桓公","kind":"person","person_id":"9w2_c77_53m","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m054-0039","start":39,"end":41,"surface":"豎刀","ki