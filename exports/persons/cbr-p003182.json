{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003182","identity_policy":"contextual_provisional","person_ids":["cbr-p003182"],"persons":[{"id":"cbr-p003182","label":"欒布（楚元王世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"欒布","mention_ids":["c-shiji-050-chuyuan:m009-0136"]}],"evidence":[{"mention_id":"c-shiji-050-chuyuan:m009-0136","chapter_id":"c-shiji-050-chuyuan","paragraph_id":"c-shiji-050-chuyuan:p009","quote":"欒布"}]}],"source_mention_summary":[{"source_id":"s-shiji-050-chuyuan","work_id":"w-shiji","book_id":"b-shiji-050","chapter_id":"c-shiji-050-chuyuan","mention_count":1,"mention_ids":["c-shiji-050-chuyuan:m009-0136"],"paragraph_ids":["c-shiji-050-chuyuan:p009"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-050-chuyuan"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-050-chuyuan:m009-0136","start":136,"end":138,"surface":"欒布","kind":"person","person_id":"cbr-p003182","status":"contextual_provisional","paragraph_id":"c-shiji-050-chuyuan:p009","chapter_id":"c-shiji-050-chuyuan"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji050-036","person_id":"cbr-p003182","surfaces":["欒布"],"scope":"same_chapter","chapter_ids":["c-shiji-050-chuyuan"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-050-chuyuan:p009","quote":"遂既王趙二十六年，孝景帝時坐晁錯以適削趙王常山之郡。吳楚反，趙王遂與合謀起兵。其相建德、內史王悍諫，不聽。遂燒殺建德、王悍，發兵屯其西界，欲待吳與俱西。北使匈奴，與連和攻漢。漢使曲周侯酈寄擊之。趙王遂還，城守邯鄲，相距七月。吳楚敗於梁，不能西。匈奴聞之，亦止，不肯入漢邊。欒布自破齊還，乃并兵引水灌趙城。趙城壞，趙王自殺，邯鄲遂降。趙幽王絕後。"}],"rationale":"明示名、字與楚趙世系局部回指暫接；兩支文王分開，副詞遂降不當劉遂，王作動詞不當人稱。索隱述贊保留自身層次，未名署稱不補姓名。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-050-chuyuan:p009","text":"遂既王趙二十六年，孝景帝時坐晁錯以適削趙王常山之郡。吳楚反，趙王遂與合謀起兵。其相建德、內史王悍諫，不聽。遂燒殺建德、王悍，發兵屯其西界，欲待吳與俱西。北使匈奴，與連和攻漢。漢使曲周侯酈寄擊之。趙王遂還，城守邯鄲，相距七月。吳楚敗於梁，不能西。匈奴聞之，亦止，不肯入漢邊。欒布自破齊還，乃并兵引水灌趙城。趙城壞，趙王自殺，邯鄲遂降。趙幽王絕後。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-050-chuyuan:m009-0000","start":0,"end":1,"surface":"遂","kind":"person","person_id":"cbr-p003161","status":"contextual_provisional"},{"id":"c-shiji-050-chuyuan:m009-0009","start":9,"end":12,"surface":"孝景帝","kind":"person","person_id":"cbr-p003155","status":"contextual_provisional"},{"id":"c-shiji-050-chuyuan:m009-0014","start":14,"end":16,"surface":"晁錯","kind":"person","person_id":"cbr-p003179","status":"contextual_provisional"},{"id":"c-shiji-050-chuyuan:m009-0030","start":30,"end":33,"surface":"趙王遂","kind":"person","person_id":"cbr-p003161","status":"contextual_provisional"},{"id":"c-shiji-050-chuyuan:m009-0041","start":41,"end":43,"surface":"建德","kind":"person","person_id":"cbr-p003180","status":"contextual_provisional"},{"id":"c-shiji-050-chuyuan:m009-0046","start":46,"end":48,"surface":"王悍","kind":"person","person_id":"cbr-p003181","status":"contextual_provisional"},{"id":"c-shiji-050-chuyuan:m009-0053","start":53,"end":54,"surface":"遂","kind":"person","person_id":"cbr-p003161","status":"contextual_provisional"},{"id":"c-shiji-050-chuyuan:m009-0056","start":56,"end":58,"surface":"建德","kind":"person","person_id":"cbr-p003180","status":"contextual_provisional"},{"id":"c-shiji-050-chuyuan:m009-0059","start":59,"end":61,"surface":"王悍","kind":"person","person_id":"cbr-p003181","status":"contextual_provisional"},{"id":"c-shiji-050-chuyuan:m009-0078","start":78,"end":80,"surface":"匈奴","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、泛稱或未定指代；不補未見人物成員與姓名。"},{"id":"c-shiji-050-chuyuan:m009-0089","start":89,"end":94,"surface":"曲周侯酈寄","kind":"person","person_id":"cbr-p003164","status":"contextual_provisional"},{"id":"c-shiji-050-chuyuan:m009-0097","start":97,"end":100,"surface":"趙王遂","kind":"person","pers