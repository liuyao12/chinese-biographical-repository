person_id":"cbr-p002758","status":"contextual_provisional","paragraph_id":"c-shiji-046-tian:p024","chapter_id":"c-shiji-046-tian"},{"id":"c-shiji-046-tian:m025-0006","start":6,"end":8,"surface":"桓公","kind":"person","person_id":"cbr-p002758","status":"contextual_provisional","paragraph_id":"c-shiji-046-tian:p025","chapter_id":"c-shiji-046-tian"}],"relations":[{"id":"a-shiji046-025","subject_person_id":"cbr-p002758","predicate":"father","object_person_id":"cbr-p002733","status":"source_attested","evidence":[{"chapter_id":"c-shiji-046-tian","source_id":"s-shiji-046-tian","paragraph_id":"c-shiji-046-tian:p024","quote":"齊侯太公和立二年，和卒，子桓公午立。桓公午五年，秦、魏攻韓，韓求救於齊。齊桓公召大臣而謀曰：「蚤救之孰與晩救之？」騶忌曰：「不若勿救。」段干朋曰：「不救，則韓且折而入於魏，不若救之。」田臣思曰：「過矣君之謀也！秦、魏攻韓、楚，趙必救之，是天以燕予齊也。」桓公曰：「善」。乃陰告韓使者而遣之。韓自以爲得齊之救，因與秦、魏戰。楚、趙聞之，果起兵而救之。齊因起兵襲燕國，取桑丘。"}],"qualifiers":{"source_term":"和卒，子桓公午立","historicity":"historical_tradition"},"interpretation_note":"明示子、女及生子語境保存；繼位、太子或後宮數量不單獨補世系，其他篇世系仍待核。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji046-026","subject_person_id":"cbr-p002762","predicate":"father","object_person_id":"cbr-p002758","status":"source_attested","evidence":[{"chapter_id":"c-shiji-046-tian","source_id":"s-shiji-046-tian","paragraph_id":"c-shiji-046-tian:p025","quote":"六年，救衞。桓公卒，子威王因齊立。是歳，故齊康公卒，絶無後，奉邑皆入田氏。"}],"qualifiers":{"source_term":"桓公卒，子威王因齊立","historicity":"historical_tradition"},"interpretation_note":"明示子、女及生子語境保存；繼位、太子或後宮數量不單獨補世系，其他篇世系仍待核。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji046-052","person_id":"cbr-p002758","scope":"same_chapter","chapter_ids":["c-shiji-046-tian"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["桓公","桓公午","齊桓公"],"evidence":[{"paragraph_id":"c-shiji-046-tian:p024","quote":"齊侯太公和立二年，和卒，子桓公午立。桓公午五年，秦、魏攻韓，韓求救於齊。齊桓公召大臣而謀曰：「蚤救之孰與晩救之？」騶忌曰：「不若勿救。」段干朋曰：「不救，則韓且折而入於魏，不若救之。」田臣思曰：「過矣君之謀也！秦、魏攻韓、楚，趙必救之，是天以燕予齊也。」桓公曰：「善」。乃陰告韓使者而遣之。韓自以爲得齊之救，因與秦、魏戰。楚、趙聞之，果起兵而救之。齊因起兵襲燕國，取桑丘。"},{"p