-062-liukun-ws2629226"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin062-liukun-grandfather","subject_person_id":"b21_e55_8bd","object_person_id":"3oq_dy4_3iu","predicate":"grandfather","qualifiers":{"source_term":"祖邁"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-062","chapter_id":"c-jinshu-062-liukun","source_id":"s-jinshu-062-liukun-ws2629226","paragraph_id":"c-jinshu-062-liukun:p001","quote":"劉琨，字越石，中山魏昌人，漢中山靖王勝之後也。祖邁，有經國之才，爲相國參軍、散騎常侍。父蕃，清高沖儉，位至光祿大夫。琨少得俊朗之目，與范陽祖納俱以雄豪著名。年二十六，爲司隸從事。時征虜將軍石崇河南金谷澗中有別廬，冠絕時輩，引致賓客，日以賦詩。琨預其間，文詠頗爲當時所許。秘書監賈謐參管朝政，京師人士無不傾心。石崇、歐陽建、陸機、陸雲之徒，並以文才降節事謐，琨兄弟亦在其間，號曰「二十四友」。太尉高密王泰辟爲掾，頻遷著作郎、太學博士、尚書郎。","subject_person_mention_id":"c-jinshu-062-liukun:p001:m0000","object_person_mention_id":"c-jinshu-062-liukun:p001:m0024"}],"status":"source_attested","interpretation_note":"具名邁，且記經國才及官職。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-062-liukun:p001:m0024","surface":"邁","start":24,"end":25,"person_id":"3oq_dy4_3iu","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-062-liukun:p001","chapter_id":"c-jinshu-062-liukun"}],"relations":[{"id":"a-jin062-liukun-grandfather","subject_person_id":"b21_e55_8bd","object_person_id":"3oq_dy4_3iu","predicate":"grandfather","qualifiers":{"source_term":"祖邁"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-062","chapter_id":"c-jinshu-062-liukun","source_id":"s-j