m005-0079","chapter_id":"c-shiji-114-dongyue","paragraph_id":"c-shiji-114-dongyue:p005","quote":"繇王"}],"family_path":{"connection":"grandfather","generation_distance":2,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-114-dongyue","source_id":"s-shiji114-dongyue","paragraph_id":"c-shiji-114-dongyue:p004","quote":"至建元六年，閩越擊南越。南越守天子約，不敢擅發兵擊而以聞。上遣大行王恢出豫章，大農韓安國出會稽，皆為將軍。兵未踰嶺，閩越王郢發兵距險。其弟餘善乃與相、宗族謀曰：「王以擅發兵擊南越，不請，故天子兵來誅。今漢兵眾彊，今即幸勝之，后來益多，終滅國而止。今殺王以謝天子。天子聽，罷兵，固一國完；不聽，乃力戰；不勝，即亡入海。」皆曰「善」。即鏦殺王，使使奉其頭致大行。大行曰：「所為來者誅王。今王頭至，謝罪，不戰而耘，利莫大焉。」乃以便宜案兵告大農軍，而使使奉王頭馳報天子。詔罷兩將兵，曰：「郢等首惡，獨無諸孫繇君丑不與謀焉。」乃使郎中將立丑為越繇王，奉閩越先祭祀。"}],"source_assertion_id":"a-shiji114-004","interpretation_note":"分支字元不表排行，依明示父系記載接線；未名世代以星號留空。","reviewer":"Codex（AI 代理）","ancestor_person_id":"e00_pe1_zri","parent_person_id":null,"intermediate_person_ids":[null]}}],"source_mention_summary":[{"source_id":"s-shiji114-dongyue","work_id":"w-shiji","book_id":"b-shiji-114","chapter_id":"c-shiji-114-dongyue","raw_mention_count":4,"mention_ids":["c-shiji-114-dongyue:m004-0252","c-shiji-114-dongyue:m004-0265","c-shiji-114-dongyue:m005-0022","c-shiji-114-dongyue:m005-0079"],"paragraph_ids":["c-shiji-114-dongyue:p004","c-shiji-114-dongyue:p005"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-shiji-114-dongyue:m004-0252","mention_ids":["c-shiji-114-dongyue:m004-0252"],"kind":"paragraph"},{"canonical_mention_id":"c-shiji-114-dongyue:m004-0265","mention_ids":["c-shiji-114-dongyue:m004-0265"],"kind":"paragraph"},{"canonical_mention_id":"c-shiji-114-dongyue:m005-0022","mention_ids":["c-shiji-114-dongyue:m005-0022"],"kind":"paragraph"},{"canonical_mention_id":"c-shiji-114-dongyue:m005-0079","mention_ids":["c-shiji-114-dongyue:m005-0079"],"kind":"paragraph"}],"mention_count":4,"duplicate_mention_count":0,"paragraph_occurrence_count":4,"table_occurrence_count":0,"passage_count":2,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"4處獨立位置，4個