ce_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-035-peixiu-peiwei-ws2506399","s-shiji-033-lu"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-035-peixiu-peiwei:p019:m0142","start":142,"end":144,"surface":"穆叔","kind":"person","person_id":"18r_wn6_nhh","status":"contextual_provisional","interpretation_note":"不拜越禮之饗指魯穆叔；現役穆叔為昭公立時人物。此為有資格首選，事件本身另需平行原文覆核，不新增不拜事件。","paragraph_id":"c-jinshu-035-peixiu-peiwei:p019","chapter_id":"c-jinshu-035-peixiu-peiwei"},{"id":"c-shiji-033-lu:m072-0011","start":11,"end":13,"surface":"穆叔","kind":"person","person_id":"18r_wn6_nhh","status":"contextual_provisional","paragraph_id":"c-shiji-033-lu:p072","chapter_id":"c-shiji-033-lu"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-jin035-allusion-p019-142","person_id":"18r_wn6_nhh","surfaces":["穆叔"],"scope":"same_chapter","chapter_ids":["c-jinshu-035-peixiu-peiwei"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-jinshu-035-peixiu-peiwei","paragraph_id":"c-jinshu-035-peixiu-peiwei:p019","quote":"遷尚書左僕射，侍中如故。頠雖後之親屬，然雅望素隆，四海不謂之以親戚進也，惟恐其不居位。俄復使頠專任門下事，固讓，不聽。頠上言：「賈模適亡，復以臣代，崇外戚之望，彰偏私之舉。後族何常有能自保，皆知重親無脫者也。然漢二十四帝惟孝文、光武、明帝不重外戚，皆保其宗，豈將獨賢，實以安理故也。昔穆叔不拜越禮之饗，臣亦不敢聞殊常之詔。」又表云：「咎繇謨虞，伊尹相商，呂望翊周，蕭張佐漢，咸播功化，光格四極。暨于繼體，咎單、傅說，祖己、樊仲，亦隆中興。或明揚側陋，或起自庶族，豈非尚德之舉，以臻斯美哉！曆觀近世，不能慕遠，溺於近情，多任後親，以致不靜。昔疏廣戒太子以舅氏為官屬，前世以為知禮。況朝廷何取于外戚，正復才均，尚當先其疏者，以明至公。漢世不用馮野王，即其事也。」表上，皆優詔敦譬。","mention_ids":["c-jinshu-035-peixiu-peiwei:p019:m0142"]}],"rationale":"不拜越禮之饗指魯穆叔；現役穆叔為昭公立時人物。此為有資格首選，事件本身另需平行原文覆核，不新增不拜事件。","human_reviewed":false,"reviewer":"Codex（AI代理）"},{"id":"d-shiji033-148","person_id":"18r_wn6_nhh","surfaces":["穆叔"],"scope":"same_chapter","chapter_ids":["c-shiji-033-lu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-033-lu:p072","quote":"昭公年十九，猶有童心。穆叔不欲立，曰：『太子死，有母弟可立，不即立長。年鈞擇賢，義鈞則卜之。今裯非適嗣，且又居喪意不在戚而有喜色，若果立，必爲季氏憂。』季武子弗聽，卒立之。比及葬，三易衰。君子曰：『是不終也。』"}],"rationale":"按文公以後立嗣、昭公出奔、夾谷會盟、徵百牢與魯君世系的具體事件及國別暫定異稱，後期同爵稱不與先君混同。身份、匿名指代與數位疑讀待覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-035-peixiu-peiwei:p019","text":"遷尚書左僕射，侍中如故。頠雖後之親屬，然雅望素隆，四海不謂之以親戚進也，惟恐其不居位。俄復使頠專任門下事，固讓，不聽。頠上言：「賈模適亡，復以臣代，崇外戚之望，彰偏私之舉。後族何常有能自保，皆知重親無脫者也。然漢二十四帝惟孝文、光武、明帝不重外戚，皆保其宗，豈將獨賢，實以安理故也。昔穆叔不拜越禮之饗，臣亦不敢聞殊常之詔。」又表云：「咎繇謨虞，伊尹相商，呂望翊周，蕭張佐漢，咸播功化，光格四極。暨于繼體，咎單、傅說，祖己、樊仲，亦隆中興。或明揚側陋，或起自庶族，豈非尚德之舉，以臻斯美哉！曆觀近世，不能慕遠，溺於近情，多任後親，以致不靜。昔疏廣戒太子以舅氏為官屬，前世以為知禮。況朝廷何取于外戚，正復才均，尚當先其疏者，以明至公。漢世不用馮野王，即其事也。」表上，皆優詔敦譬。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-035-peixiu-peiwei:p019:m0012","start":12,"end":13,"surface":"頠","kind":"person","person_id":"kbq_kjc_n2f_AAB","status":"source_explicit"},{"id":"c-jinshu-035-peixiu-peiwei:p019:m0014","start":14,"end":15,"surface":"後","kind":"person","person_id":"jmv_vc4_gep_*AAA","status":"contextual_provisional","interpretation_note":"頠雖後之親屬承賈后；後族/後親是群體，不各標后個體。"},{"id":"c-jinshu-035-peixiu-peiwei:p019:m0046","start":46,"end":47,"surface":"頠","kind":"person","person_id":"kbq_kjc_n2f_AAB","status":"source_explicit"},{"id":"c-jinshu-035-peixiu-peiwei:p019:m0059","start":59,"end":60,"surf