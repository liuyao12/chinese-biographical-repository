s":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-057-northern-wei-complete:p028:m0017","start":17,"end":19,"surface":"沈宏","kind":"person","person_id":"ow2_whv_jf3","status":"contextual_provisional","paragraph_id":"c-nanqishu-057-northern-wei-complete:p028","chapter_id":"c-nanqishu-057-northern-wei-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-057-northern-wei-complete:p028","text":"隆昌元年，遣司徒參軍劉斅、車騎參軍沈宏報使至北。宏稱字玄覽。其夏，虜平北將軍魯直清率眾降，以為督洛州軍事，領平戎校尉、征虜將軍、洛州刺史。是歲，宏徙都洛陽，改姓元氏。初，匈奴女名托跋，妻李陵，胡俗以母名為姓，故虜為李陵之後，虜甚諱之，有言其是陵後者，輒見殺，至是乃改姓焉。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":64,"last_line":64,"raw_start":7366,"raw_end":7509,"raw_character_offsets":[7371,7372,7373,7374,7377,7378,7379,7380,7381,7382,7383,7384,7385,7386,7387,7388,7389,7390,7391,7392,7393,7394,7395,7396,7397,7398,7399,7400,7401,7402,7403,7404,7405,7406,7407,7408,7409,7410,7411,7412,7413,7414,7415,7416,7417,7418,7419,7420,7421,7422,7423,7424,7425,7426,7427,7428,7429,7430,7431,7432,7433,7434,7435,7436,7437,7438,7439,7440,7441,7442,7443,7444,7445,7446,7447,7448,7449,7450,7451,7452,7453,7454,7455,7456,7457,7458,7459,7460,7461,7462,7463,7464,7465,7466,7467,7468,7469,7470,7471,7472,7473,7474,7475,7476,7477,7478,7479,7480,7481,7482,7483,7484,7485,7486,7487,7488,7489,7490,7491,7492,7493,7494,7495,7496,7497,7498,7499,7500,7501,7502,7503,7504,7505,7506,7507,7508],"revision_id":1999801},"mentions":[{"id":"c-nanqishu-057-northern-wei-complete:p028:m0010","start":10,"end":12,"surface":"劉斅","kind":"person","person_id":"tvj_4kg_n8i","status":"contextual_provisional"},{"id":"c-nan