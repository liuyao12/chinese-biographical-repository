-032-qi:m061-0010"]}],"evidence":[{"mention_id":"c-shiji-032-qi:m061-0010","chapter_id":"c-shiji-032-qi","paragraph_id":"c-shiji-032-qi:p061","quote":"魯女"}]}],"source_mention_summary":[{"source_id":"s-shiji-032-qi","work_id":"w-shiji","book_id":"b-shiji-032","chapter_id":"c-shiji-032-qi","mention_count":1,"mention_ids":["c-shiji-032-qi:m061-0010"],"paragraph_ids":["c-shiji-032-qi:p061"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-032-qi"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-032-qi:m061-0010","start":10,"end":12,"surface":"魯女","kind":"person","person_id":"cbr-p001159","status":"contextual_provisional","paragraph_id":"c-shiji-032-qi:p061","chapter_id":"c-shiji-032-qi"}],"relations":[{"id":"a-shiji032-043","subject_person_id":"cbr-p000264","predicate":"mother","object_person_id":"cbr-p001159","status":"source_attested","evidence":[{"chapter_id":"c-shiji-032-qi","source_id":"s-shiji-032-qi","paragraph_id":"c-shiji-032-qi:p061","quote":"二十八年，初，靈公取魯女，生子光，以為太子。仲姬，戎姬。戎姬嬖，仲姬生子牙，屬之戎姬。戎姬請以為太子，公許之。仲姬曰：「不可。光之立，列於諸侯矣，今無故廢之，君必悔之。」公曰：「在我耳。」遂東太子光，使高厚傅牙為太子。靈公疾，崔杼迎故太子光而立之，是為莊公。莊公殺戎姬。五月壬辰，靈公卒，莊公即位，執太子牙於句竇之丘，殺之。八月，崔杼殺高厚。晉聞齊亂，伐齊，至高唐。"}],"qualifiers":{"source_term":"生子光","historicity":"historical_tradition"},"interpretation_note":"逐項保存本文父母、異母兄弟、婚姻及曾祖關係；無咎父未名，偃之其弟指代未定，不由熟知世系補名或闕代。來源記載不當已確證身世。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-032-qi:p061","text":"二十八年，初，靈公取魯女，生子光，以為太子。仲姬，戎姬。戎姬嬖，仲姬生子牙，屬之戎姬。戎姬請以為太子，公許之。仲姬曰：「不可。光之立，列於諸侯矣，今無故廢之，君必悔之。」公曰：「在我耳。」遂東太子光，使高厚傅牙為太子。靈公疾，崔杼迎故太子光而立之，是為莊公。莊公殺戎姬。五月壬辰，靈公卒，莊公即位，執太子牙於句竇之丘，殺之。八月，崔杼殺高厚。晉聞齊亂，伐齊，至高唐。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-032-qi:m