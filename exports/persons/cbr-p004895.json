{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004895","identity_policy":"contextual_provisional","person_ids":["cbr-p004895"],"persons":[{"id":"cbr-p004895","label":"胡亥客奉偽書未名（李斯列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"胡亥客","mention_ids":["c-shiji-087-lisi:m016-0179"]},{"surface":"使者","mention_ids":["c-shiji-087-lisi:m017-0000","c-shiji-087-lisi:m017-0061","c-shiji-087-lisi:m017-0090","c-shiji-087-lisi:m017-0130","c-shiji-087-lisi:m018-0000"]}],"evidence":[{"mention_id":"c-shiji-087-lisi:m016-0179","chapter_id":"c-shiji-087-lisi","paragraph_id":"c-shiji-087-lisi:p016","quote":"胡亥客"},{"mention_id":"c-shiji-087-lisi:m017-0000","chapter_id":"c-shiji-087-lisi","paragraph_id":"c-shiji-087-lisi:p017","quote":"使者"},{"mention_id":"c-shiji-087-lisi:m017-0061","chapter_id":"c-shiji-087-lisi","paragraph_id":"c-shiji-087-lisi:p017","quote":"使者"},{"mention_id":"c-shiji-087-lisi:m017-0090","chapter_id":"c-shiji-087-lisi","paragraph_id":"c-shiji-087-lisi:p017","quote":"使者"},{"mention_id":"c-shiji-087-lisi:m017-0130","chapter_id":"c-shiji-087-lisi","paragraph_id":"c-shiji-087-lisi:p017","quote":"使者"},{"mention_id":"c-shiji-087-lisi:m018-0000","chapter_id":"c-shiji-087-lisi","paragraph_id":"c-shiji-087-lisi:p018","quote":"使者"}]}],"mentions":[{"id":"c-shiji-087-lisi:m016-0179","start":179,"end":182,"surface":"胡亥客","kind":"person","person_id":"cbr-p004895","status":"contextual_provisional","paragraph_id":"c-shiji-087-lisi:p016","chapter_id":"c-shiji-087-lisi"},{"id":"c-shiji-087-lisi:m017-0000","start":0,"end":2,"surface":"使者","kind":"person","person_id":"cbr-p004895","status":"contextual_provisional","paragraph_id":"c-shiji-087-lisi:p017","chapter_id":"c-shiji-087-lisi"},{"id":"c-shiji-087-lisi:m017-0061","start":61,"end":63,"surface":"使者","kind":"person","person_id":"cbr-p004895","status":"contextual_provisional","paragraph_id":"c-shiji-087-lisi:p017","chapter_id":"c-shiji-087-lisi"},{"id":"c-shiji-087-lisi:m017-0090","start":90,"end":92,"surface":"使者","kind":"person","person_id":"cbr-p004895","status":"contextual_provisional","paragraph_id":"c-shiji-087-lisi:p017","chapter_id":"c-shiji-087-lisi"},{"id":"c-shiji-087-lisi:m017-0130","start":130,"end":132,"surface":"使者","kind":"person","person_id":"cbr-p004895","status":"contextual_provisional","paragraph_id":"c-shiji-087-lisi:p017","chapter_id":"c-shiji-087-lisi"},{"id":"c-shiji-087-lisi:m018-0000","start":0,"end":2,"surface":"使者","kind":"person","person_id":"cbr-p004895","status":"contextual_provisional","paragraph_id":"c-shiji-087-lisi:p018","chapter_id":"c-shiji-087-lisi"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji087-028","person_id":"cbr-p004895","scope":"same_chapter","chapter_ids":["c-shiji-087-lisi"],"status":"contextual_provisional","rationale":"依沙丘謀及奉偽書局部承接暫接，趙高之高只限第14、15、18段並排除功高普通詞；奉書胡亥客與使者暫依連續事件連結。衛君及其父未補名，齊桓引古身死敘事未強合其他桓公。擬用蒙恬為相與偽詔不當已實任，嵌套指代仍待核。","reviewer":"Codex（AI 代理）","surfaces":["使者","胡亥客"],"evidence":[{"paragraph_id":"c-shiji-087-lisi:p016","quote":"於是乃相與謀，詐為受始皇詔丞相，立子胡亥為太子。更為書賜長子扶蘇曰：「朕巡天下，禱祠名山諸神以延壽命。今扶蘇與將軍蒙恬將師數十萬以屯邊，十有餘年矣，不能進而前，士卒多秏，無尺寸之功，乃反數上書直言誹謗我所為，以不得罷歸為太子，日夜怨望。扶蘇為人子不孝，其賜劍以自裁！將軍恬與扶蘇居外，不匡正，宜知其謀。為人臣不忠，其賜死，以兵屬裨將王離。」封其書以皇帝璽，遣胡亥客奉書賜扶蘇於上郡。"},{"paragraph_id":"c-shiji-087-lisi:p017","quote":"使者至，發書，扶蘇泣，入內舍，欲自殺。蒙恬止扶蘇曰：「陛下居外，未立太子，使臣將三十萬眾守邊，公子為監，此天下重任也。今一使者來，即自殺，安知其非詐？請復請，復請而後死，未暮也。」使者數趣之。扶蘇為人仁，謂蒙恬曰：「父而賜子死，尚安復請！」即自殺。蒙恬不肯死，使者即以屬吏，系於陽周。"},{"paragraph_id":"c-shiji-087-lisi:p018","quote":"使者還報，胡亥、斯、高大喜。至咸陽，發喪，太子立為二世皇帝。以趙高為郎中令，常侍中用事。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-087-lisi:p016","text":"於是乃相與謀，詐為受始皇詔丞相，立子胡亥為太子。更為書賜長子扶蘇曰：「朕巡天下，禱祠名山諸神以延壽命。今扶蘇與將軍蒙恬將師數十萬以屯邊，十有餘年矣，不能進而前，士卒多秏，無尺寸之功，乃反數上書直言誹謗我所為，以不得罷歸為太子，日夜怨望。扶蘇為人子不孝，其賜劍以自裁！將軍恬與扶蘇居外，不匡正，宜知其謀。為人臣不忠，其賜死，以兵屬裨將王離。」封其書以皇帝璽，遣胡亥客奉書賜扶蘇於上郡。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"i