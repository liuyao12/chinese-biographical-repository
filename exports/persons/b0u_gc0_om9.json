eferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-040-zilun:p001:m0088","surface":"綦母珍之","start":88,"end":92,"person_id":"b0u_gc0_om9","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-nanqishu-040-zilun:p001","chapter_id":"c-nanqishu-040-zilun"}],"relations":[],"title_holdings":[{"id":"th-nanqi040-wudifive-lun1-84","person_id":"b0u_gc0_om9","title":"中書舍人","kind":"office","mode":"attestation","attestations":[{"id":"th-nanqi040-wudifive-lun1-84:a","person_mention_id":"c-nanqishu-040-zilun:p001:m0088","usage":"narrative","date_expression":null,"paragraph_id":"c-nanqishu-040-zilun:p001","surface":"中書舍人","start":84,"end":88}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-040","source_id":"s-nanqishu-040-zilun-ws2272748","chapter_id":"c-nanqishu-040-zilun","paragraph_id":"c-nanqishu-040-zilun:p001","quote":"巴陵王子倫字雲宗，世祖第十三子也。永明七年，爲持節、都督南豫司二州軍事、南中郎將、南豫州刺史。十年，遷北中郎將、南琅邪彭城二郡太守。鬱林卽位，以南彭城祿力優厚，奪子倫與中書舍人綦母珍之，更以南蘭陵代之。隆昌元年，遷散騎常侍、左將軍。延興元年，遣中書舍人茹法亮殺子倫，子倫正衣冠出受詔，曰：「鳥之將死，其鳴也哀；人之將死，其言也善。先朝昔滅劉氏，今日之事，理數固然。君是身家舊人，今銜此使，當由事不獲已。」法亮不敢荅而退。年十六。","person_mention_id":"c-nanqishu-040-zilun:p001:m0088"}],"status":"source_attested","interpretation_note":"按本見證原職名及其所屬人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-040-zilun:p001","text":"巴陵王子倫字雲宗，世祖第十三子也。永明七年，爲持節、都督南豫司二州軍事、南中郎將、南豫州刺史。十年，遷北中郎將、南琅邪彭城二郡太守。鬱林卽位，以南彭城祿力優厚，奪子倫與中書舍人綦母珍之，更以南蘭陵代之。隆昌元年，遷散騎常侍、左將軍。延興元年，遣中書舍人茹法亮殺子倫，子倫正衣冠出受詔，曰：「鳥之將死，其鳴也哀；人之將死，其言也善。先朝昔滅劉氏，今日之事，理數固然。君是身家舊人，今銜此使，當由事不獲已。」法亮不敢荅而退。年十六。","mentions":[{"id":"c-nanqishu-040-zilun:p001:m0003","surface":"子倫","start":3,"end":5,"person_id":"kix_r92_2ed_K","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-040-zilun:p001:m0006","surface":"雲宗","start":6,"end":8,"person_id":"kix_r92_2ed_K","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-040-zilun:p001:m0081","surface":"子倫","start":81,"end":83,"person_id":"kix_r92_2ed_K","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-040-zilun:p001:m0088","surface":"綦母珍之","start":88,"end":92,"person_id":"b0u_gc0_om9","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-040-zilun:p001:m0126","surface":"茹法亮","start":126,"end":129,"person_id":"u4m_so3_3c0","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-040-zilun:p001:m0130","surface":"子倫","start":130,"end":132,"person_id":"kix_r92_2ed_K","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-040-zilun:p001:m0133","surface":"子倫","start":133,"end":135,"person_id":"kix_r92_2ed_K","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-040-zilun:p001:m0202","surface":"法亮","start":202,"end":204,"person_id":"u4m_so3_3c0","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":2272748,"source_layer":"received_biography","first_line":150,"last_line":150,"line_start":2,"line_end":230,"raw_start":11011,"raw_end":11239,"raw_character_offsets":[11011,11012,11013,11014,11015,11016,11017,11018,11019,11020,11021,11022,11023,11024,11025,11026,11027,11028,11029,11030,11031,11032,11033,11034,11035,11036,11037,11038,11039,11040,11041,11042,11043,11044,11045,11046,1