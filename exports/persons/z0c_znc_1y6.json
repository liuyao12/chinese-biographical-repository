s":"contextual_provisional"},{"id":"c-liangshu-029-eight-sons:p001:m0062","start":62,"end":67,"surface":"邵陵攜王綸","kind":"person","person_id":"81y_7i5_frc","status":"contextual_provisional"},{"id":"c-liangshu-029-eight-sons:p001:m0068","start":68,"end":71,"surface":"葛脩容","kind":"person","person_id":"1eh_wqx_875","status":"contextual_provisional"},{"id":"c-liangshu-029-eight-sons:p001:m0072","start":72,"end":76,"surface":"武陵王紀","kind":"person","person_id":"fo7_f8v_rmf_D","status":"contextual_provisional"},{"id":"c-liangshu-029-eight-sons:p001:m0077","start":77,"end":78,"surface":"綜","kind":"person","person_id":"syn_jn4_wiu","status":"contextual_provisional"},{"id":"c-liangshu-029-eight-sons:p001:m0079","start":79,"end":80,"surface":"紀","kind":"person","person_id":"fo7_f8v_rmf_D","status":"contextual_provisional"}],"chapter_id":"c-liangshu-029-eight-sons","book_id":"b-liangshu-029","work_id":"w-liangshu","source_id":"s-liangshu-029-eight-sons-ws1538079"},{"id":"c-liangshu-029-xiaoji-complete:p001","text":"南康簡王績字世謹，高祖第四子。天監八年，封南康郡王，邑二千戶。出爲輕車將軍，領石頭戍軍事。十年，遷使持節、都督南徐州諸軍事、南徐州刺史，進號仁威將軍。績時年七歲，主者有受貨，洗改解書，長史王僧孺弗之覺，績見而輒詰之，便卽時首服，衆咸歎其聰警。十六年，徵爲宣毅將軍、領石頭戍軍事。十七年，出爲使持節、都督南北兗徐青冀五州諸軍事、南兗州刺史，在州著稱。尋有詔徵還，民曹嘉樂等三百七十人詣闕上表，稱績尤異一十五條，乞留州任，優詔許之，進號北中郎將。普通四年，徵爲侍中、雲麾將軍，領石頭戍軍事。五年，出爲使持節、都督江州諸軍事、江州刺史。丁董淑儀憂，居喪過禮，高祖手詔勉之，使攝州任，固求解職，乃徵授安右將軍、領石頭戍軍事，尋加護軍。羸瘠弗堪視事。大通三年，因感病薨于任，時年二十五。贈侍中、中軍將軍、開府儀同三司，給鼓吹一部。諡曰簡。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":13,"last_line":13,"raw_start":317,"raw_end":702,"raw_character_offsets":[317,318,319,320,321,322,323,324,325,326,327,328,329,330,331,337,338,339,340,343,344,345,346,347,348,349,350,351,352,353,354,355,356,357,358,359,360,361,362,363,364,365,366,367,368,369,370,371,372,373,374,375,376,377,378,379,380,381,382,383,384,385,386,387,388,389,390,391,392,393,394,395,396,397,398,399,400,401,402,403,404,405,406,407,408,409,410,411,412,413,414,415,416,417,418,419,420,421,422,423,424,425,426,427,428,429,430,431,432,433,434,435,4