-0030","c-shiji-040-chu:m001-0032"]}],"evidence":[{"mention_id":"c-shiji-040-chu:m001-0030","chapter_id":"c-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p001","quote":"稱"},{"mention_id":"c-shiji-040-chu:m001-0032","chapter_id":"c-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p001","quote":"稱"}]},{"id":"cbr-p001844","label":"巻章（楚篇祖系）","status":"active","historicity":"legendary_tradition","aliases":[{"surface":"巻章","mention_ids":["c-shiji-040-chu:m001-0034","c-shiji-040-chu:m001-0037"]}],"evidence":[{"mention_id":"c-shiji-040-chu:m001-0034","chapter_id":"c-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p001","quote":"巻章"},{"mention_id":"c-shiji-040-chu:m001-0037","chapter_id":"c-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p001","quote":"巻章"}]}],"mentions":[{"id":"c-shiji-040-chu:m001-0030","start":30,"end":31,"surface":"稱","kind":"person","person_id":"cbr-p001843","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p001","chapter_id":"c-shiji-040-chu"},{"id":"c-shiji-040-chu:m001-0032","start":32,"end":33,"surface":"稱","kind":"person","person_id":"cbr-p001843","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p001","chapter_id":"c-shiji-040-chu"}],"relations":[{"id":"a-shiji040-002","subject_person_id":"cbr-p001844","predicate":"father","object_person_id":"cbr-p001843","status":"source_attested","evidence":[{"chapter_id":"c-shiji-040-chu","source_id":"s-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p001","quote":"楚之先祖出自帝顓頊髙陽。髙陽者，黃帝之孫，昌意之子也。髙陽生稱，稱生巻章，巻章生重黎。重黎爲帝嚳髙辛居火正，甚有功，能光融天下，帝嚳命曰祝融。共工氏作亂，帝嚳使重黎誅之而不盡。帝乃以庚寅日誅重黎，而以其弟呉回爲重黎後，復居火正，爲祝融。"}],"qualifiers":{"source_term":"稱生巻章","historicity":"legendary_tradition"},"interpretation_note":"依本段明示生育、兄弟、母子及苗裔敘事；祖先不作直接父親，繼位不自動推父子，不補未見母名或闕代。來源主張不等於版本與史實已覆核。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji040-063","subject_person_id":"cbr-p001843","predicate":"father","object_person_id":"cbr-p000013","status":"source_attested","evidence":[{"chapter_id":"c-shiji-040-chu","source_id":"s-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p001","quote":"楚之先祖出自帝顓頊髙陽。髙陽者，黃帝之孫，昌意之子也。髙陽生稱，稱生巻章，巻章生重黎。重黎爲帝嚳髙辛居火正，甚有功，能光融天下，帝嚳命曰祝融。共工氏作亂，帝嚳使重黎誅之而不盡。帝乃以庚寅日誅重黎，而以其弟呉回爲重黎後，復居火正，爲祝融。"}],"qualifiers":{"source_term":"髙陽生稱","historicity":"legendary_tradition"},"interpretation_note":"保存楚篇明示祖系傳說；不將傳說敘事或跨篇暫同指當成已核定史實。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-040-chu:p001","text":"楚之先祖出自帝顓頊髙陽。髙陽者，黃帝之孫，昌意之子也。髙陽生稱，稱生巻章，巻章生重黎。重黎爲帝嚳髙辛居火正，甚有功，能光融天下，帝嚳命曰祝融。共工氏作亂，帝嚳使重黎誅之而不盡。帝乃以庚寅日誅重黎，而以其弟呉回爲重黎後，復居火正，爲祝融。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m001-0006","start":6,"end":11,"surface":"帝顓頊髙陽","kind":"person","person_id":"cbr-p000013","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m001-0012","start":12,"end":14,"surface":"髙陽","kind":"person","person_id":"cbr-p000013","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m001-0016","start":16,"end":18,"surface":"黃帝","kind":"person","person_id":"cbr-p000001","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m001-0021","start":21,"end":23,"surface":"昌意","kind":"person","person_id":"cbr-p000011","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m001-0027","start":27,"end":29,"surface":"髙陽","kind":"person","person_id":"cbr-p000013","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m001-0030","start":30,"end":31,"surface":"稱","kind":"person","person_id":"cbr-p001843","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m001-0032","start":32,"end":33,"surface":"稱","kind":"person","person_id":"cbr-p001843","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m001-0034","start":34,"end":36,"surface":"巻章","kind":"person","person_id":"cbr-p001844","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m001-0037","start":37,"end":39,"surface":"巻章","kind":"person","person_id":"cbr-p0