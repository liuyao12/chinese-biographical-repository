_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-043-wangyan:p006:m0165","start":165,"end":166,"surface":"澄","kind":"person","person_id":"rlk_lzd_86c","status":"contextual_provisional","resolution_note":"趙王倫篡誅至成都王穎/東海王越，澄與敦分為弟/族弟；原文齊王乂爵名抵牾另保候選。","paragraph_id":"c-jinshu-043-wangyan:p006","chapter_id":"c-jinshu-043-wangyan"},{"id":"c-jinshu-043-wangyan:p006:m0179","start":179,"end":180,"surface":"澄","kind":"person","person_id":"rlk_lzd_86c","status":"contextual_provisional","resolution_note":"趙王倫篡誅至成都王穎/東海王越，澄與敦分為弟/族弟；原文齊王乂爵名抵牾另保候選。","paragraph_id":"c-jinshu-043-wangyan:p006","chapter_id":"c-jinshu-043-wangyan"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-043-wangyan:p006","text":"衍素輕趙王倫之為人。及倫篡位，衍陽狂斫婢以自免。及倫誅，拜河南尹，轉尚書，又為中書令。時齊王乂有匡復之功，而專權自恣，公卿皆為之拜，衍獨長揖焉。以病去官。成都王穎以衍為中軍師，累遷尚書僕射，領吏部，後拜尚書令、司空、司徒。衍雖居宰輔之重，不以經國為念，而思自全之計。說東海王越曰：「中國已亂，當賴方伯，宜得文武兼資以任之。」乃以弟澄為荊州，族弟敦為青州。因謂澄、敦曰：「荊州有江、漢之固，青州有負海之險，卿二人在外，而吾留此，足以為三窟矣。」識者鄙之。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-043-wangyan:p006:m0000","start":0,"end":1,"surface":"衍","kind":"person","person_id":"b0c_13f_c3a","status":"contextual_provisional","resolution_note":"趙王倫篡誅至成都王穎/東海王越，澄與敦分為弟/族弟；原文齊王乂爵名抵牾另保候選。"},{"id":"c-jinshu-043-wangyan:p006:m0003",