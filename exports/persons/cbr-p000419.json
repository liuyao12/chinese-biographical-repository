","text_layer":"received_chapter","mentions":[{"id":"c-shiji-032-qi:m066-0005","start":5,"end":7,"surface":"慶封","kind":"person","person_id":"cbr-p000419","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m066-0012","start":12,"end":14,"surface":"慶封","kind":"person","person_id":"cbr-p000419","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m066-0016","start":16,"end":18,"surface":"崔杼","kind":"person","person_id":"cbr-p000263","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m066-0032","start":32,"end":34,"surface":"慶舍","kind":"person","person_id":"cbr-p001176","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m066-0042","start":42,"end":45,"surface":"田文子","kind":"person","person_id":"cbr-p001164","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m066-0046","start":46,"end":48,"surface":"桓子","kind":"person","person_id":"cbr-p001177","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m066-0056","start":56,"end":64,"surface":"田、鮑、高、欒氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、族稱或未定指代；齊秉意茲等疑讀待版本校勘，不補熟知姓名。"},{"id":"c-shiji-032-qi:m066-0070","start":70,"end":72,"surface":"慶舍","kind":"person","person_id":"cbr-p001176","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m066-0075","start":75,"end":77,"surface":"慶封","kind":"person","person_id":"cbr-p000419","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m066-0087","start":87,"end":89,"surface":"慶封","kind":"person","person_id":"cbr-p000419","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m066-0103","start":103,"end":104,"surface":"封","kind":"person","person_id":"cbr-p000419","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m066-0132","start":132,"end":134,"surface":"莊公","kind":"person","person_id":"cbr-p000264","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m066-0136","start":136,"end":138,"surface":"崔杼","kind":"person","person_id":"cbr-p000263","status":"contextual_provisional"}],"chapter_id":"c-shiji-032-qi","book_id":"b-shiji-032","work_id":"w-shiji","source_id":"s-shiji-032-qi"},{"id":"c-shiji-040-chu:p031","text":"七月，楚以諸侯兵伐呉，圍朱方。八月，克之，囚慶封，滅其族。以封徇，曰：「無效齊慶封弒其君而弱其孤，以盟諸大夫！」封反曰：「莫如楚共王庶子圍弒其君兄之子員而代之立！」於是靈王使（棄）疾殺之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m031-0022","start":22,"end":24,"surface":"慶封","kind":"person","person_id":"cbr-p000419","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m031-0030","start":30,"end":31,"surface":"封","kind":"person","person_id":"cbr-p000419","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m031-0039","start":39,"end":41,"surface":"慶封","kind":"person","person_id":"cbr-p000419","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m031-0056","start":56,"end":57,"surface":"封","kind":"person","person_id":"cbr-p000419","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m031-0063","start":63,"end":66,"surface":"楚共王","kind":"person","person_id":"cbr-p001886","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m031-0068","start":68,"end":69,"surface":"圍","kind":"person","person_id":"cbr-p001889","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m031-0075","start":75,"end":76,"surface":"員","kind":"person","person_id":"cbr-p001888","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m031-0084","start":84,"end":86,"surface":"靈王","kind":"person","person_id":"cbr-p001889","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m031-0087","start":87,"end":91,"surface":"（棄）疾","kind":"person","person_id":"cbr-p001892","status":"contextual_provisional"}],"chapter_id":"c-shiji-040-chu","book_id":"b-shiji-040","work_id":"w-shiji","source_id":"s-shiji-040-chu"},{"id":"c-shiji-040-chu:p096","text":"太史公曰：楚靈王方會諸侯於申，誅齊慶封，作章華臺，求周九鼎之時，志小天下；及餓死于申亥之家，爲天下笑。操行之不得，悲夫！勢之於人也，可不愼與？棄疾以亂立，嬖淫秦女，甚乎哉，幾再亡國！","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m096-0005","start":5,"end":8,"surface":"楚靈王","kind":"person","person_id":"cbr-p001889","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m096-0017","start":17,"end":19,"surface":"慶封","kind":"person","person_id":"cbr-p000419","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m096-0041","start":41,"end":43,"surface":"申亥","kind":"person","person_id":"cbr-p001912","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m096-0071","start":71,"end":73,"surface":"棄疾","kind":"person","person_id":"cbr-p001892","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m096-0079","start":79,"end":81,"surface":"秦女","kind":"person","person_id":"cbr-p001957","status":"contextual_provisional"}],"chapter_id":"c-shiji-040-chu","book_id":"b-shiji-040","work_id":"w-shiji","source_id":"s-shiji-040-chu"},{"id":"c-shiji-042-zheng:p041","text":"二十七年夏，鄭簡公朝晉。冬，畏楚靈王之彊，又朝楚，子産從。二十八年，鄭君病，使子産會諸侯，與楚靈王盟於申，誅齊慶封。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-042-zheng:m041-0006","start":6,"end":9,"surface":"鄭簡公","kind":"person","person_id":"cbr-p002187","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m041-0015","start":15,"end":18,"surface":"楚靈王","kind":"person","person_id":"cbr-p002201","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m041-0025","start":25,"end":27,"surface":"子産","kind":"person","person_id":"cbr-p002190","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m041-0034","start":34,"end":36,"surface":"鄭君","kind":"person","person_id":"cbr-p002187","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m041-0039","start":39,"end":41,"surface":"子産","kind":"person","person_id":"cbr-p002190","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m041-0046","start":46,"end":49,"surface":"楚靈王","kind":"person","person_id":"cbr-p002201","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m041-0054","start":54,"end":57,"surface":"齊慶封","kind":"person","person_id":"cbr-p002202","status":"contextual_provisional"}],"chapter_id":"c-shiji-042-zheng","book_id":"b-shiji-042","work_id":"w-shiji","source_id":"s-shiji-042-zheng"}],"sources":[{"chapter_id":"c-shiji-005-qin","work_id":"w-shiji","book_id":"b-shiji-005","source_id":"s-shiji-005-qin","source":{"title":"史記／卷005","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷005","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷005&oldid=8744286","revision_id":8744286,"accessed_on":"2026-10-09","extent":"77段數位正文；排除註釋版導覽與註號，見證行內校勘符號暫原樣保留。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫 CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{"铚":"銍","绖":"絰","龁":"齕"},"note":"第9段編者重複標記另存，其餘行內校勘符號仍待逐處分離；不稱已核讀底本。","editorial_readings":[{"paragraph_id":"c-shiji-005-qin:p009","witness_form":"（世父）世父","body_reading":"世父","note":"數位見證重複的括號標記另存；不作第二個正文人物提及。"},{"paragraph_id":"c-shiji-005-qin:p022","witness_form":"铚","body_reading":"銍","note":"數位見證混入簡體字，轉繁體並保留字形轉換記錄；未核讀影像。"},{"paragraph_id":"c-shiji-005-qin:p028","witness_form":"绖","body_reading":"絰","note":"數位見證混入簡體字，轉繁體並保留字形轉換記錄；未核讀影像。"},{"paragraph_id":"c-shiji-005-qin:p033","witness_form":"绖","body_reading":"絰","note":"數位見證混入簡體字，轉繁體並保存原字；未核影像。"},{"paragraph_id":"c-shiji-005-qin:p070","witness_form":"龁","body_reading":"齕","note":"數位見證簡體字轉繁體，原字保留；未核影像。"},{"paragraph_id":"c-shiji-005-qin:p072","witness_form":"绖","body_reading":"絰","note":"數位見證簡體字轉繁體，原字保留；未核影像。"},{"paragraph_id":"c-shiji-005-qin:p074","witness_form":"龁","body_reading":"齕","note":"數位見證簡體字轉繁體，原字保留；未核影像。"},{"paragraph_id":"c-shiji-005-qin:p070","witness_form":"胡（傷）［陽］","body_reading":"胡傷","note":"行內校勘標記另存，成對讀法保留改讀前的字；身份與底本待核。"},{"paragraph_id":"c-shiji-005-qin:p070","witness_form":"南（郡）［陽］","body_reading":"南郡","note":"行內校勘標記另存，成對讀法保留改讀前的字；身份與底本待核。"},{"paragraph_id":"c-shiji-005-qin:p070","witness_form":"（武安）","body_reading":"","note":"行內校勘標記另存，成對讀法保留改讀前的字；身份與底本待核。"}]}}},{"chapter_id":"c-shiji-031-wu","work_id":"w-shiji","book_id":"b-