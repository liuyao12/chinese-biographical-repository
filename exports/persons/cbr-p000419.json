":"c-shiji-040-chu"},{"id":"c-shiji-040-chu:m031-0056","start":56,"end":57,"surface":"封","kind":"person","person_id":"cbr-p000419","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p031","chapter_id":"c-shiji-040-chu"},{"id":"c-shiji-040-chu:m096-0017","start":17,"end":19,"surface":"慶封","kind":"person","person_id":"cbr-p000419","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p096","chapter_id":"c-shiji-040-chu"},{"id":"c-shiji-042-zheng:m041-0054","start":54,"end":57,"surface":"齊慶封","kind":"person","person_id":"cbr-p002202","status":"contextual_provisional","paragraph_id":"c-shiji-042-zheng:p041","chapter_id":"c-shiji-042-zheng"}],"relations":[],"title_holdings":[{"id":"th-shiji031-004","person_id":"cbr-p000419","title":"齊相","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-031-wu","source_id":"s-shiji-031-wu","paragraph_id":"c-shiji-031-wu:p009","quote":"王餘祭三年，齊相慶封有罪，自齊來犇吳。"}],"attestations":[{"id":"th-shiji031-004:a001","paragraph_id":"c-shiji-031-wu:p009","start":6,"end":8,"surface":"齊相","person_mention_id":"c-shiji-031-wu:m009-0008","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"稱王、自號與用稱分開；延陵封邑不擅補正式爵等，未知時段不補造，不以卒日結束爵位。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji032-026","person_id":"cbr-p000419","title":"左相","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-032-qi","source_id":"s-shiji-032-qi","paragraph_id":"c-shiji-032-qi:p064","quote":"景公立，以崔杼為右相，慶封為左相。"}],"attestations":[{"id":"th-shiji032-026:a001","paragraph_id":"c-shiji-032-qi:p064","start":45,"end":47,"surface":"左相","person_mention_id":"c-shiji-032-qi:m064-0042","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-032-qi","source_id":"s-shiji-032-qi","paragraph_id":"c-shiji-032-qi:p064","quote":"景公立，以崔杼為右相，慶封為左相。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"來源授任、家族／王家太子與公稱追稱分開；崔氏太子不推皇家繼承身份，敘事為相不自動當任命。日期原表述未換算，未知端點不按死亡補造。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji032-027","person_id":"cbr-p000419","title":"相國","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-032-qi","source_id":"s-shiji-032-qi","paragraph_id":"c-shiji-032-qi:p065","quote":"慶封為相國，專權。"}],"attestations":[{"id":"th-shiji032-027:a001","paragraph_id":"c-shiji-032-qi:p065","start":200,"end":202,"surface":"相國","person_mention_id":"c-shiji-032-qi:m065-0197","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"來源授任、家族／王家太子與公稱追稱分開；崔氏太子不推皇家繼承身份，敘事為相不自動當任命。日期原表述未換算，未知端點不按死亡補造。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji031-010","person_id":"cbr-p000419","surfaces":["慶封"],"scope":"cross_chapter","chapter_ids":["c-shiji-005-qin","c-shiji-031-wu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-005-qin:p043","quote":"景公四年，晉欒書弒其君厲公。十五年，救鄭，敗晉兵於櫟。是時晉悼公為盟主。十八年，晉悼公彊，數會諸侯，率以伐秦，敗秦軍。秦軍走，晉兵追之，遂渡涇，至棫林而還。二十七年，景公如晉，與平公盟，已而背之。三十六年，楚公子圍弒其君而自立，是為靈王。景公母弟後子鍼有寵，景公母弟富，或譖之，恐誅，乃奔晉，車重千乘。晉平公曰：「后子富如此，何以自亡？」對曰：「秦公無道，畏誅，欲待其後世乃歸。」三十九年，楚靈王彊，會諸侯於申，為盟主，殺齊慶封。景公立四十年卒，子哀公立。后子復來歸秦。"},{"paragraph_id":"c-shiji-031-wu:p009","quote":"王餘祭三年，齊相慶封有罪，自齊來犇吳。吳予慶封硃方之縣，以爲奉邑，以女妻之，富於在齊。"},{"paragraph_id":"c-shiji-031-wu:p016","quote":"七年，楚公子圍弑其王夾敖而代立，是爲靈王。十年，楚靈王會諸侯而以伐吳之硃方，以誅齊慶封。吳亦攻楚，取三邑而去。十一年，楚伐吳，至雩婁。十二年，楚復來伐，次於乾谿，楚師敗走。"}],"rationale":"按本篇周初、吳世系、楚亡臣與列國稱號的敘事語境暫定異稱；同名不全庫替換，仲雍與周章弟虞仲分開。論樂的祖君稱號另保留候選，未按熟知故事合併。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji032-080","person_id":"cbr-p000419","surfaces":["封","慶封"],"scope":"cross_chapter","chapter_ids":["c-shiji-005-qin","c-shiji-032-qi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-005-qin:p043","quote":"景公四年，晉欒書弒其君厲公。十五年，救鄭，敗晉兵於櫟。是時晉悼公為盟主。十八年，晉悼公彊，數會諸侯，率以伐秦，敗秦軍。秦軍走，晉兵追之，遂渡涇，至棫林而還。二十七年，景公如晉，與平公盟，已而背之。三十六年，楚公子圍弒其君而自立，是為靈王。景公母弟後子鍼有寵，景公母弟富，或譖之，恐誅，乃奔晉，車重千乘。晉平公曰：「后子富如此，何以自亡？」對曰：「秦公無道，畏誅，欲待其後世乃歸。」三十九年，楚靈王彊，會諸侯於申，為盟主，殺齊慶封。景公立四十年卒，子哀公立。后子復來歸秦。"},{"paragraph_id":"c-shiji-032-qi:p064","quote":"丁丑，崔杼立莊公異母弟杵臼，是為景公。景公母，魯叔孫宣伯女也。景公立，以崔杼為右相，慶封為左相。二相恐亂起，乃與國人盟曰：「不與崔慶者死！」晏子仰天曰：「嬰所不（獲）唯忠於君利社稷者是從！」不肯盟。慶封欲殺晏子，崔杼曰：「忠臣也，捨之。」齊太史書曰「崔杼弒莊公」，崔杼殺之。其弟復書，崔杼復殺之。少弟復書，崔杼乃捨之。"},{"paragraph_id":"c-shiji-032-qi:p065","quote":"景公元年，初，崔杼生子成及彊，其母死，取東郭女，生明。東郭女使其前夫子無咎與其弟偃相崔氏。成有罪，二相急治之，立明為太子。成請老於崔［杼］，崔杼許之，二相弗聽，曰：「崔，宗邑，不可。」成、彊怒，告慶封。慶封與崔杼有郤，欲其敗也。成、彊殺無咎、偃於崔杼家，家皆奔亡。崔杼怒，無人，使一宦者御，見慶封。慶封曰：「請為子誅之。」使崔杼仇盧蒲嫳攻崔氏，殺成、彊，盡滅崔氏，崔杼婦自殺。崔杼毋歸，亦自殺。慶封為相國，專權。"},{"paragraph_id":"c-shiji-032-qi:p066","quote":"三年十月，慶封出獵。初，慶封已殺崔杼，益驕，嗜酒好獵，不聽政令。慶舍用政，已有內郤。田文子謂桓子曰：「亂將作。」田、鮑、高、欒氏相與謀慶氏。慶舍發甲圍慶封宮，四家徒共擊破之。慶封還，不得入，奔魯。齊人讓魯，封奔吳。吳與之朱方，聚其族而居之，富於在齊。其秋，齊人徙葬莊公，僇崔杼尸於市以說眾。"}],"rationale":"按齊君繼位、家族明示與田氏政變的具體敘事暫定異稱。晉／魯昭公、齊／吳公子光分開，鮑子、鮑牧及監止、子我暫不合併，所錄或曰及疑讀仍待版本覆核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji040-103","person_id":"cbr-p000419","surfaces":["封","慶封"],"scope":"cross_chapter","chapter_ids":["c-shiji-032-qi","c-shiji-040-chu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-032-qi:p066","quote":"三年十月，慶封出獵。初，慶封已殺崔杼，益驕，嗜酒好獵，不聽政令。慶舍用政，已有內郤。田文子謂桓子曰：「亂將作。」田、鮑、高、欒氏相與謀慶氏。慶舍發甲圍慶封宮，四家徒共擊破之。慶封還，不得入，奔魯。齊人讓魯，封奔吳。吳與之朱方，聚其族而居之，富於在齊。其秋，齊人徙葬莊公，僇崔杼尸於市以說眾。"},{"paragraph_id":"c-shiji-040-chu:p031","quote":"七月，楚以諸侯兵伐呉，圍朱方。八月，克之，囚慶封，滅其族。以封徇，曰：「無效齊慶封弒其君而弱其孤，以盟諸大夫！」封反曰：「莫如楚共王庶子圍弒其君兄之子員而代之立！」於是靈王使（棄）疾殺之。"},{"paragraph_id":"c-shiji-040-chu:p096","quote":"太史公曰：楚靈王方會諸侯於申，誅齊慶封，作章華臺，求周九鼎之時，志小天下；及餓死于申亥之家，爲天下笑。操行之不得，悲夫！勢之於人也，可不愼與？棄疾以亂立，嬖淫秦女，甚乎哉，幾再亡國！"}],"rationale":"齊篇慶封奔吳居朱方，與楚篇克朱方囚慶封、譏齊弒君而被殺的具體人物去向相接；未據同指決定全部事件年代。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji042-108","person_id":"cbr-p002202","scope":"same_chapter","chapter_ids":["c-shiji-042-zheng"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["齊慶封"],"evidence":[{"paragraph_id":"c-shiji-042-zheng:p041","quote":"二十七年夏，鄭簡公朝晉。冬，畏楚靈王之彊，又朝楚，子産從。二十八年，鄭君病，使子産會諸侯，與楚靈王盟於申，誅齊慶封。"}],"rationale":"依本篇名字、是為、世系及連續事件暫接異稱；同諡不同國分開，建子勝與聲公勝不合併，如兄弟為譬喻不作親屬。述贊與正文不算獨立來源，省稱、古字與校勘仍待核。"}],"equivalence_decisions":[{"id":"eq-shiji042-qingfeng","person_ids":["cbr-p000419","cbr-p002202"],"canonical_person_id":"cbr-p000419","scope":"cross_chapter","chapter_ids":["c-shiji-040-chu","c-shiji-042-zheng"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-040-chu","source_id":"s-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p096","quote":"太史公曰：楚靈王方會諸侯於申，誅齊慶封，作章華臺，求周九鼎之時，志小天下；及餓死于申亥之家，爲天下笑。操行之不得，悲夫！勢之於人也，可不愼與？棄疾以亂立，嬖淫秦女，甚乎哉，幾再亡國！","mention_ids":["c-shiji-040-chu:m096-0017"]},{"chapter_id":"c-shiji-042-zheng","source_id":"s-shiji-042-zheng","paragraph_id":"c-shiji-042-zheng:p041","quote":"二十七年夏，鄭簡公朝晉。冬，畏楚靈王之彊，又朝楚，子産從。二十八年，鄭君病，使子産會諸侯，與楚靈王盟於申，誅齊慶封。","mention_ids":["c-shiji-042-zheng:m041-0054"]}],"rationale":"同記楚靈王會於申並誅齊慶封，暫同指，保留楚篇正文及論贊層次，不能算兩個獨立見證。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-005-qin:p043","text":"景公四年，晉欒書弒其君厲公。十五年，救鄭，敗晉兵於櫟。是時晉悼公為盟主。十八年，晉悼公彊，數會諸侯，率以伐秦，敗秦軍。秦軍走，晉兵追之，遂渡涇，至棫林而還。二十七年，景公如晉，與平公盟，已而背之。三十六年，楚公子圍弒其君而自立，是為靈王。景公母弟後子鍼有寵，景公母弟富，或譖之，恐誅，乃奔晉，車重千乘。晉平公曰：「后子富如此，何以自亡？」對曰：「秦公無道，畏誅，欲待其後世乃歸。」三十九年，楚靈王彊，會諸侯於申，為盟主，殺齊慶封。景公立四十年卒，子哀公立。后子復來歸秦。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m043-0000","start":0,"end":2,"surface":"景公","kind":"person","person_id":"cbr-p000414","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0005","start":5,"end":8,"surface":"晉欒書","kind":"person","person_id":"cbr-p000415","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0009","start":9,"end":11,"surface":"其君","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或待核指代；不由官稱或熟知世系補造個人。"},{"id":"c-shiji-005-qin:m043-0011","start":11,"end":13,"surface":"