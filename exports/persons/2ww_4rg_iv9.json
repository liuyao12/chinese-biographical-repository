ferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-106-wuwang:m005-0062","start":62,"end":64,"surface":"應高","kind":"person","person_id":"2ww_4rg_iv9","status":"contextual_provisional","paragraph_id":"c-shiji-106-wuwang:p005","chapter_id":"c-shiji-106-wuwang"},{"id":"c-shiji-106-wuwang:m005-0111","start":111,"end":112,"surface":"高","kind":"person","person_id":"2ww_4rg_iv9","status":"contextual_provisional","paragraph_id":"c-shiji-106-wuwang:p005","chapter_id":"c-shiji-106-wuwang"},{"id":"c-shiji-106-wuwang:m005-0284","start":284,"end":285,"surface":"高","kind":"person","person_id":"2ww_4rg_iv9","status":"contextual_provisional","paragraph_id":"c-shiji-106-wuwang:p005","chapter_id":"c-shiji-106-wuwang"},{"id":"c-shiji-106-wuwang:m005-0378","start":378,"end":379,"surface":"高","kind":"person","person_id":"2ww_4rg_iv9","status":"contextual_provisional","paragraph_id":"c-shiji-106-wuwang:p005","chapter_id":"c-shiji-106-wuwang"},{"id":"c-shiji-106-wuwang:m005-0562","start":562,"end":563,"surface":"高","kind":"person","person_id":"2ww_4rg_iv9","status":"contextual_provisional","paragraph_id":"c-shiji-106-wuwang:p005","chapter_id":"c-shiji-106-wuwang"}],"relations":[],"title_holdings":[{"id":"th-shiji106-020","person_id":"2ww_4rg_iv9","title":"中大夫","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-106-wuwang","source_id":"s-shiji-106-wuwang","paragraph_id":"c-shiji-106-wuwang:p005","quote":"漢廷臣方議削吳。吳王濞恐削地無已，因以此發謀，欲舉事。念諸侯無足與計謀者，聞膠西王勇，好氣，喜兵，諸齊皆憚畏，於是乃使中大夫應高誂膠西王。無文書，口報曰：「吳王不肖，有宿夕之憂，不敢自外，使喻其驩心。」王曰：「何以教之？」高曰：「今者主上興於姦，飾於邪臣，好小善，聽讒賊，擅變更律令，侵奪諸侯之地，徵求滋多，誅罰良善，日以益甚。里語有之，『舐糠及米』。吳與膠西，知名諸侯也，一時見察，恐不得安肆矣。吳王身有內病，不能朝請二十餘年，嘗患見疑，無以自白，今脅肩累足，猶懼不見釋。竊聞大王以爵事有適，所聞諸侯削地，罪不至此，此恐不得削地而已。」王曰：「然，有之。子將柰何？」高曰：「同惡相助，同好相留，同情相成，同欲相趨，同利相死。今吳王自以為與大王同憂，願因時循理，棄軀以除患害於天下，億亦可乎？」王瞿然駭曰：「寡人何敢如是？今主上雖急，固有死耳，安得不戴？」高曰：「御史大夫晁錯，熒惑天子，侵奪諸侯，蔽忠塞賢，朝廷疾怨，諸侯皆有倍畔之意，人事極矣。彗星出，蝗蟲數起，此萬世一時，而愁勞聖人之所以起也。故吳王欲內以晁錯為討，外隨大王後車，彷徉天下，所鄉者降，所指者下，天下莫敢不服。大王誠幸而許之一言，則吳王率楚王略函谷關，守滎陽敖倉之粟，距漢兵。治次舍，須大王。大王有幸而臨之，則天下可并，兩主分割，不亦可乎？」王曰：「善。」高歸報吳王，吳王猶恐其不與，乃身自為使，使於膠西，面結之。"}],"attestations":[{"id":"th-shiji106-020:a001","paragraph_id":"c-shiji-106-wuwang:p005","start":59,"end":62,"surface":"中大夫","person_mention_id":"c-shiji-106-wuwang:m005-0062","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"東帝為吳王明示自稱，不作漢廷授爵。少將保留原稱，不套現代軍階。韓安國、張羽為將軍依並列任命記事件；其餘用稱不補起訖。官職、封爵及親屬原詞分存。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji106-018","person_id":"2ww_4rg_iv9","surfaces":["應高","高"],"scope":"same_chapter","chapter_ids":["c-shiji-106-wuwang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-106-wuwang:p005","quote":"漢廷臣方議削吳。吳王濞恐削地無已，因以此發謀，欲舉事。念諸侯無足與計謀者，聞膠西王勇，好氣，喜兵，諸齊皆憚畏，於是乃使中大夫應高誂膠西王。無文書，口報曰：「吳王不肖，有宿夕之憂，不敢自外，使喻其驩心。」王曰：「何以教之？」高曰：「今者主上興於姦，飾於邪臣，好小善，聽讒賊，擅變更律令，侵奪諸侯之地，徵求滋多，誅罰良善，日以益甚。里語有之，『舐糠及米』。吳與膠西，知名諸侯也，一時見察，恐不得安肆矣。吳王身有內病，不能朝請二十餘年，嘗患見疑，無以自白，今脅肩累足，猶懼不見釋。竊聞大王以爵事有適，所聞諸侯削地，罪不至此，此恐不得削地而已。」王曰：「然，有之。子將柰何？」高曰：「同惡相助，同好相留，同情相成，同欲相趨，同利相死。今吳王自以為與大王同憂，願因時循理，棄軀以除患害於天下，億亦可乎？」王瞿然駭曰：「寡人何敢如是？今主上雖急，固有死耳，安得不戴？」高曰：「御史大夫晁錯，熒惑天子，侵奪諸侯，蔽忠塞賢，朝廷疾怨，諸侯皆有倍畔之意，人事極矣。彗星出，蝗蟲數起，此萬世一時，而愁勞聖人之所以起也。故吳王欲內以晁錯為討，外隨大王後車，彷徉天下，所鄉者降，所指者下，天下莫敢不服。大王誠幸而許之一言，則吳王率楚王略函谷關，守滎陽敖倉之粟，距漢兵。治次舍，須大王。大王有幸而臨之，則天下可并，兩主分割，不亦可乎？」王曰：「善。」高歸報吳王，吳王猶恐其不與，乃身自為使，使於膠西，面結之。"}],"rationale":"依本篇姓名、原稱及敘事回指暫定；書信、制詔與附載述贊保留上下文，未按同名自動跨篇合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-106-wuwang:p005","text":"漢廷臣方議削吳。吳王濞恐削地無已，因以此發謀，欲舉事。念諸侯無足與計謀者，聞膠西王勇，好氣，喜兵，諸齊皆憚畏，於是乃使中大夫應高誂膠西王。無文書，口報曰：「吳王不肖，有宿夕之憂，不敢自外，使喻其驩心。」王曰：「何以教之？」高曰：「今者主上興於姦，飾於邪臣，好小善，聽讒賊，擅變更律令，侵奪諸侯之地，徵求滋多，誅罰良善，日以益甚。里語有之，『舐糠及米』。吳與膠西，知名諸侯也，一時見察，恐不得安肆矣。吳王身有內病，不能朝請二十餘年，嘗患見疑，無以自白，今脅肩累足，猶懼不見釋。竊聞大王以爵事有適，所聞