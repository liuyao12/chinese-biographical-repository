詹事周舍、鴻臚卿劉之遴、中書侍郎朱異集壽光殿以觀之，時並嘆服。武帝目子野曰：「其形雖弱，其文甚壯。」俄又敕為書喻魏相元叉。其夜受旨，子野謂可待旦方奏，未之為也，及五鼓，敕催令速上。子野徐起操筆，昧爽便就。及奏，武帝深嘉焉。自是諸符檄皆令具草。","subject_person_mention_id":"c-nanshi-033-pei-family:p020:m0031","object_person_mention_id":"c-nanshi-033-pei-family:p020:m0002"}],"qualifiers":{"source_term":"繼母"},"interpretation_note":"保留繼母原詞，不改為生母，不自動補父親婚姻。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanshi-033-pei-family:p020:m0002","start":2,"end":4,"surface":"曹氏","kind":"person","person_id":"l1o_9k9_jyk","status":"contextual_provisional","interpretation_note":"子野敘事繼母曹氏亡、居喪過禮，暫登其繼母未名個人，不與其他曹氏、生母魏或祖母殷合併。","paragraph_id":"c-nanshi-033-pei-family:p020","chapter_id":"c-nanshi-033-pei-family"}],"relations":[{"id":"a-nanshi033-ziye-stepmother","subject_person_id":"4ni_4t1_4o9_BB*AAAAAA","predicate":"stepmother","object_person_id":"l1o_9k9_jyk","status":"source_attested","evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-033","source_id":"s-nanshi033-ws1554233","chapter_id":"c-nanshi-033-pei-family","paragraph_id":"c-nanshi-033-pei-family:p020","quote":"繼母曹氏亡，居喪過禮，服闋，再遷員外郎。普通七年，大舉北侵，敕子野為移魏文，受詔立成。武帝以其事體大，召尚書僕射徐勉、太子詹事周舍、鴻臚卿劉之遴、中書侍郎朱異集壽光殿以觀之，時並嘆服。武帝目子野曰：「其形雖弱，其文甚壯。」俄又敕為書喻魏相元叉。其夜受旨，子野謂可待旦方奏，未之為也，及五鼓，敕催令速上。子野徐起操筆，昧爽便就。及奏，武帝深嘉焉。自是諸符檄皆令具草。","subject_person_mention_id":"c-nanshi-033-pei-family:p020:m0031","object_person_mention_id":"c-nanshi-033-pei-family:p020:m0002"}],"qualifiers":{"source_term":"繼母"},"interpretation_note":"保留繼母原詞，不改為生母，不自動補父親婚姻。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-nanshi033-曹氏","person_id":"l1o_9k9_jyk","surfaces":["曹氏"],"scope":"same_chapter","status":