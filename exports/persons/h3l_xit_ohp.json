{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"h3l_xit_ohp","canonical_person_id":"h3l_xit_ohp","id_aliases":["cbr-p000549"],"identity_policy":"contextual_provisional","person_ids":["h3l_xit_ohp"],"persons":[{"id":"h3l_xit_ohp","label":"佐弋竭","status":"active","historicity":"historical_tradition","aliases":[{"surface":"佐弋竭","mention_ids":["c-shiji-006-shihuang:m010-0218"]}],"evidence":[{"mention_id":"c-shiji-006-shihuang:m010-0218","chapter_id":"c-shiji-006-shihuang","paragraph_id":"c-shiji-006-shihuang:p010","quote":"佐弋竭"}],"identity_note":"依本卷特定時代與事件暫定人物；不以同稱、官號或短名全域合併，未見本名不補造。","review":"ai_provisional","id_aliases":["cbr-p000549"]}],"source_mention_summary":[{"source_id":"s-shiji-006-shihuang","work_id":"w-shiji","book_id":"b-shiji-006","chapter_id":"c-shiji-006-shihuang","mention_count":1,"mention_ids":["c-shiji-006-shihuang:m010-0218"],"paragraph_ids":["c-shiji-006-shihuang:p010"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-006-shihuang"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-006-shihuang:m010-0218","start":218,"end":221,"surface":"佐弋竭","kind":"person","person_id":"h3l_xit_ohp","status":"contextual_provisional","paragraph_id":"c-shiji-006-shihuang:p010","chapter_id":"c-shiji-006-shihuang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-006-shihuang:p010","text":"嫪毐封為長信侯。予之山陽地，令毐居之。宮室車馬衣服苑囿馳獵恣毐。事無小大皆決於毐。又以河西太原郡更為毐國。九年，彗星見，或竟天。攻魏垣、蒲陽。四月，上宿雍。己酉，王冠，帶劍。長信侯毐作亂而覺，矯王御璽及太后璽以發縣卒及衛卒、官騎、戎翟君公、舍人，將欲攻蘄年宮為亂。王知之，令相國昌平君、昌文君發卒攻毐。戰咸陽，斬首數百，皆拜爵，及宦者皆在戰中，亦拜爵一級。毐等敗走。即令國中：有生得毐，賜錢百萬；殺之，五十萬。盡得毐等。衛尉竭、內史肆、佐弋竭、中大夫令齊等二十人皆梟首。車裂以徇，滅其宗。及其舍人，輕者為鬼薪。及奪爵遷蜀四千餘家，家房陵。四月寒凍，有死者。楊端和攻衍氏。彗星見西方，又見北方，從斗以南八十日。十年，相國呂不韋坐嫪毐免。桓齮為將軍。齊、趙來置酒。齊人茅焦說秦王曰：「秦方以天下為事，而大王有遷母太后之名，恐諸侯聞之，由此倍秦也。」秦王乃迎太后於雍而入咸陽，復居甘泉宮。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:m010-0000","start":0,"end":2,"surface":"嫪毐","kind":"person","person_id":"hzt_j3d_1r3","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m010-0004","start":4,"end":7,"surface":"長信侯","kind":"person","person_id":"hzt_j3d_1r3","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m010-0015","start":15,"end":16,"surface":"毐","kind":"person","person_id":"hzt_j3d_1r3","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m010-0030","start":30,"end":31,"surface":"毐","kind":"person","person_id":"hzt_j3d_1r3","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m010-0039","start":39,"end":40,"surface":"毐","kind":"person","person_id":"hzt_j3d_1r3","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m010-0074","start":74,"end":75,"surface":"上","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官稱或句讀疑問待核；不補造姓名或直接同稱合併。"},{"id":"c-shiji-006-shihuang:m010-0081","start":81,"end":82,"surface":"王","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官稱或句讀疑問待核；不補造姓名或直接同稱合併。"},{"id":"c-shiji-006-shihuang:m010-0087","start":87,"end":91,"surface":"長信侯毐","kind":"person","person_id":"hzt_j3d_1r3","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m010-0097","start":97,"end":98,"surface":"王","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官稱或句讀疑問待核；不補造姓名或直接同稱合併。"},{"id":"c-shiji-006-shihuang:m010-0101","start":101,"end":103,"surface":"太后","kind":"unresolved","person_id":null,"status":"unresolved",