{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p002809","canonical_person_id":"chp_5kd_7fb","id_aliases":["cbr-p002809"],"identity_policy":"contextual_provisional","person_ids":["chp_5kd_7fb"],"persons":[{"id":"chp_5kd_7fb","label":"魏冉（田世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"魏冉","mention_ids":["c-shiji-046-tian:m044-0047"]}],"evidence":[{"mention_id":"c-shiji-046-tian:m044-0047","chapter_id":"c-shiji-046-tian","paragraph_id":"c-shiji-046-tian:p044","quote":"魏冉"}],"id_aliases":["cbr-p002809"]}],"source_mention_summary":[{"source_id":"s-shiji-046-tian","work_id":"w-shiji","book_id":"b-shiji-046","chapter_id":"c-shiji-046-tian","mention_count":1,"mention_ids":["c-shiji-046-tian:m044-0047"],"paragraph_ids":["c-shiji-046-tian:p044"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-046-tian"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-046-tian:m044-0047","start":47,"end":49,"surface":"魏冉","kind":"person","person_id":"chp_5kd_7fb","status":"contextual_provisional","paragraph_id":"c-shiji-046-tian:p044","chapter_id":"c-shiji-046-tian"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji046-103","person_id":"chp_5kd_7fb","scope":"same_chapter","chapter_ids":["c-shiji-046-tian"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["魏冉"],"evidence":[{"paragraph_id":"c-shiji-046-tian:p044","quote":"三十六年，王爲東帝，秦昭王爲西帝。蘇代自燕來，入齊，見於章華東門。齊王曰：「嘻，善，子來！秦使魏冉致帝，子以爲何如？」對曰：「王之問臣也卒，而患之所從來微，願王受之而勿備稱也。秦稱之，天下安之，王乃稱之，無後也。且讓爭帝名，無傷也。秦稱之，天下惡之，王因勿稱，以收天下，此大資也。且天下立兩帝，王以天下爲尊齊乎？尊秦乎？」王曰：「尊秦。」曰：「釋帝，天下愛齊乎？愛秦乎？」王曰：「愛齊而憎秦。」曰：「兩帝立約伐趙，孰與伐桀宋之利？」王曰：「伐桀宋利。」對曰：「夫約鈞，然與秦爲帝而天下獨尊秦而輕齊，釋帝則天下愛齊而憎秦，伐趙不如伐桀宋之利，故願王明釋帝以收天下，倍約賓秦，無爭重，而王以其閒舉宋。夫有宋，衞之陽地危；有濟西，趙之阿東國危；有淮北，楚之東國危；有陶、平陸，梁門不開。釋帝而貸之以伐桀宋之事，國重而名尊，燕楚所以形服，天下莫敢不聽，此湯武之舉也。敬秦以爲名，而後使天下憎之，此所謂以卑爲尊者也。願王孰慮之。」於是齊去帝復爲王，秦亦去帝位。"}],"rationale":"限本篇明示姓名、是為、繼位及局部事件暫接；姜齊與田齊桓公、不同時段未名王及同字忌分開。孫子不先補孫臏，子守髙唐不補闕字，索隱短稱與代詞仍待核；未跨篇按同名接人。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-046-tian:p044","text":"三十六年，王爲東帝，秦昭王爲西帝。蘇代自燕來，入齊，見於章華東門。齊王曰：「嘻，善，子來！秦使魏冉致帝，子以爲何如？」對曰：「王之問臣也卒，而患之所從來微，願王受之而勿備稱也。秦稱之，天下安之，王乃稱之，無後也。且讓爭帝名，無傷也。秦稱之，天下惡之，王因勿稱，以收天下，此大資也。且天下立兩帝，王以天下爲尊齊乎？尊秦乎？」王曰：「尊秦。」曰：「釋帝，天下愛齊乎？愛秦乎？」王曰：「愛齊而憎秦。」曰：「兩帝立約伐趙，孰與伐桀宋之利？」王曰：「伐桀宋利。」對曰：「夫約鈞，然與秦爲帝而天下獨尊秦而輕齊，釋帝則天下愛齊而憎秦，伐趙不如伐桀宋之利，故願王明釋帝以收天下，倍約賓秦，無爭重，而王以其閒舉宋。夫有宋，衞之陽地危；有濟西，趙之阿東國危；有淮北，楚之東國危；有陶、平陸，梁門不開。釋帝而貸之以伐桀宋之事，國重而名尊，燕楚所以形服，天下莫敢不聽，此湯武之舉也。敬秦以爲名，而後使天下憎之，此所謂以卑爲尊者也。願王孰慮之。」於是齊去帝復爲王，秦亦去帝位。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-046-tian:m044-0005","start":5,"end":6,"surface":"王","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、對話、稱謂或索隱述贊短稱待核，不補姓名及成員。"},{"id":"c-shiji-046-tian:m044-0010","start":10,"end":13,"surface":"秦昭王","kind":"person","person_id":"xvq_2vi_og2","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m044-0017","start":17,"end":19,"surface":"蘇代","kind":"person","person_id":"wti_7m6_wi5","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m044-0033","start":33,"end":35,"surface":"齊王","kind":"person","person_id":"zan_qcc_jy5_AAAAAABAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m044-0047","start":47,"end":49,"surface":"魏冉","kind":"person","person_id":"chp_5kd_7fb","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m044-0063","start":63,"end":64,"surface":"王","kind":"unresolved","person_id":null,"status":"un