ndent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-liangshu-015-xiefei:p004:m0105","start":105,"end":108,"surface":"新安王","kind":"person","person_id":"79g_3gx_htk","status":"contextual_provisional","interpretation_note":"依完整本傳敘事及身份閱讀記錄逐人辨識；原字不改，非由同字自動合併。","identity_decision_id":"d-liang015-xiefei-xinan","paragraph_id":"c-liangshu-015-xiefei:p004","chapter_id":"c-liangshu-015-xiefei"},{"id":"c-nanqishu-042-jiangshi-near-family-rendered:p002:m0005","start":66,"end":68,"surface":"海陵","kind":"person","person_id":"79g_3gx_htk","status":"contextual_provisional","paragraph_id":"c-nanqishu-042-jiangshi-near-family-rendered:p002","chapter_id":"c-nanqishu-042-jiangshi-near-family-rendered"},{"id":"c-nanqishu-047-xietiao-rendered:p003:m0009","start":112,"end":115,"surface":"新安王","kind":"person","person_id":"79g_3gx_htk","status":"contextual_provisional","paragraph_id":"c-nanqishu-047-xietiao-rendered:p003","chapter_id":"c-nanqishu-047-xietiao-rendered"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-liang015-xiefei-xinan","person_id":"79g_3gx_htk","surfaces":["新安王"],"scope":"same_chapter","chapter_ids":["c-liangshu-015-xiefei"],"status":"contextual_provisional","evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-015","chapter_id":"c-liangshu-015-xiefei","source_id":"s-liangshu015-ws1506954","paragraph_id":"c-liangshu-015-xiefei:p004","quote":"永明元年，起家拜通直散騎常侍，累遷侍中，領國子博士。五年，出爲冠軍將軍、義興太守，加秩中二千石。在郡不省雜事，悉付綱紀，曰：「吾不能作主者吏，但能作太守耳。」視事三年，徵都官尚書、中書令。隆昌元年，復爲侍中，領新安王師。未拜，固求外出。仍爲征虜將軍、吳興太守，受召便述職。時明帝謀入嗣位，朝之舊臣皆引參謀策。朏內圖止足，且實避事。弟𤅢，時爲吏部尚書。朏至郡，致𤅢數斛酒，遺書曰：「可力飲此，勿豫人事。」朏居郡每不治，而常務聚斂，衆頗譏之，亦不屑也。"}],"rationale":"隆昌元年朏領新安王師，固定南齊005完整首段海陵恭王昭文、鬱林即位封新安王、隆昌元年為揚州刺史而後被立；定位昭文，非宋新安王子鸞。registry未有齊昭文身份，僅標原王號不加正文諱。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null,"external_reference_readings":[{"id":"r-nanqi005-156","title":"南齊書/卷5","revision_id":1767525,"url":"https://zh.wikisource.org/w/index.php?title=%E5%8D%97%E9%BD%8A%E6%9B%B8%2F%E5%8D%B75&oldid=1767525","raw_path":"source-evidence/liang015-xiefei-reading/external/nanqi005-fixed.wikitext","metadata_path":"source-evidence/liang015-xiefei-reading/external/nanqi005-metadata.json","raw_sha256":"acb70c64b51623ed9e4d80279274cf91648e3d2253f9dd2cccfa934d4bb3bd4f","raw_start":156,"raw_end":329,"quote":"海陵恭王昭文字季尚，文惠太子第二子也。永明四年，封臨汝公，邑千五百戶。初為輔國將軍、濟陽太守。十年，轉持節、督南豫州諸軍事、南豫州刺史，將軍如故。十一年，進號冠軍將軍。文惠太子薨，還都。鬱林王即位，為中軍將軍，領兵置佐。封新安王，邑二千戶。隆昌元年，為使持節、都督揚南徐二州諸軍事、揚州刺史，將軍如故。其年，鬱林王廢，尚書令西昌侯鸞議立昭文為帝。","text_layer":"received_chapter","read_scope":"完整首段含封新安王至隆昌元年立帝。","image_verified":false,"human_reviewed":false}]},{"id":"d-nanqi047-xietiao-xinan","person_id":"79g_3gx_htk","surfaces":["新安王"],"scope":"same_chapter","chapter_ids":["c-nanqishu-047-xietiao-rendered"],"status":"contextual_provisional","evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-047","source_id":"s-nanqishu-047-current-rendered-xietiao","chapter_id":"c-nanqishu-047-xietiao-rendered","paragraph_id":"c-nanqishu-047-xietiao-rendered:p003","quote":"子隆在荊州，好辭賦，數集僚友，朓以文才，尤被賞愛，流連晤對，不捨日夕。長史王秀之以朓年少相動，密以啓聞。世祖敕曰：「侍讀虞雲自宜恒應侍接。朓可還都。」朓道中爲詩寄西府曰：「常恐鷹隼擊，秋菊委嚴霜。寄言罻羅者，寥廓已高翔。」遷新安王中軍記室。朓牋辭子隆曰：「朓聞潢汙之水，思朝宗而每竭；駑蹇之乘，希沃若而中疲。何則？皐壤搖落，對之惆悵；岐路東西，或以嗚悒。況乃服義徒擁，歸志莫從，邈若墜雨，飄似秋蔕。朓實庸流，行能無算，屬天地休明，山川受納，褒採一介，搜揚小善，捨耒場圃，奉筆菟園。東亂三江，西浮七澤，契闊戎旃，從容讌語。長裾日曳，後乘載脂，榮立府廷，恩加顏色。沐髮晞陽，未測涯涘；撫臆論報，早誓肌骨。不悟滄溟未運，波臣自蕩；渤澥方春，旅翮先謝。清切蕃房，寂寥舊蓽。輕舟反泝，弔影獨留，白雲在天，龍門不見。去德滋永，思德滋深。唯待青江可望，候歸艎於春渚；朱邸方開，效蓬心於秋實。如其簪履或存，衽席無改，雖復身填溝壑，猶望妻子知歸。攬涕告辭，悲來橫集。」","mention_ids":["c-nanqishu-047-xietiao-rendered:p003:m0009"]}],"rationale":"依此完整傳文的明名、時序及語境稱謂辨識；原詞不改，未移轉引古人物的當代事件。","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-015-xiefei:p004","unit_id":"xiefei-complete","text":"永明元年，起家拜通直散騎常侍，累遷侍中，領國子博士。五年，出爲冠軍將軍、義興太守，加秩中二千石。在郡不省雜事，悉付綱紀，曰：「吾不能作主者吏，但能作太守耳。」視事三年，徵都官尚書、中書令。隆昌元年，復爲侍中，領新安王師。未拜，固求外出。仍爲征虜將軍、吳興太守，受召便述職。時明帝謀入嗣位，朝之舊臣皆引參謀策。朏內圖止足，且實避事。弟𤅢，時爲吏部尚書。朏至郡，致𤅢數斛酒，遺書曰：「可力飲此，勿豫人事。」朏居郡每不治，而常務聚斂，衆頗譏之，亦不屑也。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","source_position":{"first_line":17,"last_line":17,"revision_id":1506954,"editorial_excerpt_boundary":true},"mentions":[{"id":"c-liangshu-015-xiefei:p004:m0063","start":63,"end":64,"surface":"吾","kind":"person","person_id":"aa6_83c_juy_DBABAB","status":"contextual_provisional","interpretation_note":"依完整本傳敘事及身份閱讀記錄逐人辨識；原字不改，非由同字自動合併。","identity_decision_id":"d-liang015-xiefei-fei"},{"id":"c-liangshu-015-xiefei:p004:m0105","start":105,"end":108,"surface":"新安王","kind":"person","person_id":"79g_3gx_htk","status":"contextual_provisional","interpretation_note":"依完整本傳敘事及身份閱讀記錄逐人辨識；原字不改，非由同字自動合併。","identity_decision_id":"d-liang015-xiefei-xinan"},{"id":"c-liangshu-015-xiefei:p004:m0137","start":137,"end":139,"surface":"明帝","kind":"person","person_id":"z5d_9zy_u5h_B","status":"contextual_provisional","interpretation_note":"依完整本傳敘事及身份閱讀記錄逐人辨識；原字不改，非由同字自動合併。","identity_decision_id":"d-liang015-xiefei-mingdi"},{"id":"c-liangshu-015-xiefei:p004:m0154","start":154,"end":155,"surface":"朏","kind":"person","person_id":"aa6_83c_juy_DBABAB","status":"contextual_provisional","interpretation_note":"依完整本傳敘事及身份閱讀記錄逐人辨識；原字不改，非由同字自動合併。","identity_decision_id":"d-liang015-xiefei-fei"},{"id":"c-liangshu-015-xiefei:p004:m0166","start":166,"end":167,"surface":"𤅢","kind":"person","person_id":"aa6_83c_juy_DBABAC","status":"contextual_provisional","interpretation_note":"依完整本傳敘事及身份閱讀記錄逐人辨識；原字不改，非由同字自動合併。","identity_decision_id":"d-liang015-xiefei-yue"},{"id":"c-liangshu-015-xiefei:p004:m0175","start":175,"end":176,"surface":"朏","kind":"person","person_id":"aa6_83c_juy_DBABAB","status":"contextual_provisional","interpretation_note":"依完整本傳敘事及身份閱讀記錄逐人辨識；原字不改，非由同字自動合併。","identity_decision_id":"d-liang015-xiefei-fei"},{"id":"c-liangshu-015-xiefei:p004:m0180","start":180,"end":181,"surface":"𤅢","kind":"person","person_id":"aa6_83c_juy_DBABAC","status":"contextual_provisional","interpretation_note":"依完整本傳敘事及身份閱讀記錄逐人辨識；原字不改，非由同字自動合併。","identity_decision_id":"d-liang015-xiefei-yue"},{"id":"c-liangshu-015-xiefei:p004:m0201","start":201,"end":202,"surface":"朏","kind":"person","person_id":"aa6_83c_juy_DBABAB","status":"contextual_provisional","interpretation_note":"依完整本傳敘事及身份閱讀記錄逐人辨識；原字不改，非由同字自動合併。","identity_decision_id":"d-liang015-xiefei-fei"},{"id":"c-liangshu-015-xiefei:p004:m0217","start":217,"end":218,"surface":"之","kind":"pronoun","person_id":"aa6_83c_juy_DBABAB","status":"contextual_provisional","interpretation_note":"衆頗譏之承朏居郡聚斂之人；不把不治改字。","identity_decision_id":"d-liang015-xiefei-fei"}],"chapter_id":"c-liangshu-015-xiefei","book_id":"b-liangshu-015","work_id":"w-liangshu","source_id":"s-liangshu015-ws1506954"},{"id":"c-nanqishu-042-jiangshi-near-family-rendered:p002","text":"高宗輔政，委以心腹。隆昌元年，自正員郎補丹陽丞，中書郎。高宗爲驃騎，鎮東府，以祏爲諮議參軍，領南平昌太守，與蕭誄對直東府省內。時新立海陵，人情未服，高宗胛上有赤誌，常祕不傳，祏勸帝出以示人。晉壽太守王洪範罷任還，上袒示之，曰：「人皆謂此是日月相。卿幸無泄言。」洪範曰：「公日月之相在軀，如何可隱。轉當言之公卿。」上大悅。會直後張伯、尹瓚等屢謀竊發，祏、誄憂虞無計，每夕輙託事外出。及入纂議定，加祏寧朔將軍。高宗爲宣城王，太史密奏圖緯云「一號當得十四年」。祏入，帝喜以示祏曰：「得此復何所望。」及卽位，遷守衞尉，將軍如故。封安陸縣侯，邑千戶。祏祖遵，以后父贈金紫光祿大夫；父德隣，以帝舅亦贈光祿大夫。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-nanqishu-042-jiangshi-near-family-rendered:p002:m0001","start":0,"end":2,"surface":"高宗","kind":"person","person_id":"z5d_9zy_u5h_B","status":"contextual_provisional"},{"id":"c-nanqishu-042-jiangshi-near-family-rendered:p002:m0002","start":28,"e