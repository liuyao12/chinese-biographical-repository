r":"Codex（AI 代理）","human_reviewed":false,"model":null}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-043-shantao:line019","text":"咸熙初，封新遝子。轉相國左長史，典統別營。時帝以濤鄉閭宿望，命太子拜之。帝以齊王攸繼景帝后，素又重攸，嘗問裴秀曰：「大將軍開建未遂，吾但承奉後事耳。故立攸，將歸功於兄，何如？」秀以為不可，又以問濤。濤對曰：「廢長立少，違禮不祥。國之安危，恆必由之。」太子位於是乃定。太子親拜謝濤。及武帝受禪，以濤守大鴻臚，護送陳留王詣鄴。泰始初，加奉車都尉，進爵新遝伯。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-043-shantao:line019:m0024","start":24,"end":25,"surface":"濤","kind":"person","person_id":"96a_987_925","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-shantao:line019:m0038","start":38,"end":41,"surface":"齊王攸","kind":"person","person_id":"cac_ca2_008","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-shantao:line019:m0042","start":42,"end":44,"surface":"景帝","kind":"person","person_id":"dkn_ge4_286_AAAAH","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-shantao:line019:m0049","start":49,"end":50,"surface":"攸","kind":"person","person_id":"cac_ca2_008","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-shantao:line019:m0053","start":53,"end":55,"surface":"裴秀","kind":"person","person_id":"057_a27_29b","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-shantao:line019:m0076","start":76,"end":77,"surface":"攸","kind":"person","person_id":"cac_ca2_008","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-shantao:line019:m0088","start":88,"end":89,"surface":"秀","kind":"person","person_id":"057_a27_29b","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-shantao:line019:m0097","start":97,"end":98,"surface":"濤","kind":"person","person_id":"96a_987_925","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-shantao:line019:m0099","start":99,"end":100,"surface":"濤","kind":"person","person_id":"96a_987_925","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-shantao:line019:m0138","start":138,"end":139,"surface":"濤","kind":"person","person_id":"96a_987_925","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-shantao:line019:m0141","start":141,"end":143,"surface":"武帝","kind":"person","person_id":"hgm_jvn_hle","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-shantao:line019:m0147","start":147,"end":148,"surface":"濤","kind":"person","person_id":"96a_987_925","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-shantao:line019:m0155","start":155,"end":158,"surface":"陳留王","kind":"person","person_id":"gke_14h_1xk_A","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"source_position":{"first_line":19,"last_line":19,"raw_start":695,"raw_end":874,"revision_id":2618531},"chapter_id":"c-jinshu-043-shantao","book_id":"b-jinshu-043","work_id":"w-jinshu","source_id":"s-jinshu-043-shantao"},{"id":"c-jinshu-044-zhengmao:line015","text":"毌丘儉作亂，景帝自出征之，百官祖送於城東，袤疾病不任會。帝謂中領軍王肅曰：「唯不見鄭光祿為恨。」肅以語袤，袤自輿追帝，及於近道。帝笑曰：「故知侯生必來也。」遂與袤共載，曰：「計將何先？」袤曰：「昔與儉俱為台郎，特所知悉。其人好謀而不達事情，自昔建勳幽州，志望無限。文欽勇而無算。今大軍出其不意，江、淮之卒銳而不能固，深溝高壘以挫其氣，此亞夫之長也。」帝稱善。轉太常。高貴鄉公議立明堂辟雍，精選博士，袤舉劉毅、劉寔、程咸、庾峻，後並至公輔大位。及常道鄉公立，與議定策，進封安城鄉侯，邑千戶。景元初，疾病失明，屢乞骸骨，不許。拜光祿大夫。五等初建，封密陵伯。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-044-zhengmao:line015:m0000","start":0,"end":3,"surface":"毌丘儉","kind":"person","person_id":"b61_784_cbb","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-zhengmao:line015:m0006","start":6,"end":8,"surface":"景帝","kind":"person","person_id":"dkn_ge4_286_AAAAH","status":"contextual_provisional