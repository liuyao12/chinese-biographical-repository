tus":"contextual_provisional","paragraph_id":"c-shiji-094-tiandan:p009","chapter_id":"c-shiji-094-tiandan"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji094-031","person_id":"cbr-p005243","surfaces":["龍且"],"scope":"same_chapter","chapter_ids":["c-shiji-094-tiandan"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-094-tiandan:p009","quote":"橫定齊三年，漢王使酈生往說下齊王廣及其相國橫。橫以為然，解其歷下軍。漢將韓信引兵且東擊齊。齊初使華無傷、田解軍於歷下以距漢，漢使至，乃罷守戰備，縱酒，且遣使與漢平。漢將韓信已平趙、燕，用蒯通計，度平原，襲破齊歷下軍，因入臨淄。齊王廣、相橫怒，以酈生賣己，而亨酈生。齊王廣東走高密，相橫走博（陽），守相田光走城陽，將軍田既軍於膠東。楚使龍且救齊，齊王與合軍高密。漢將韓信與曹參破殺龍且，虜齊王廣。漢將灌嬰追得齊守相田光。至博（陽），而橫聞齊王死，自立為齊王，還擊嬰，嬰敗橫之軍於嬴下。田橫亡走梁，歸彭越。彭越是時居梁地，中立，且為漢，且為楚。韓信已殺龍且，因令曹參進兵破殺田既於膠東，使灌嬰破殺齊將田吸於千乘。韓信遂平齊，乞自立為齊假王，漢因而立之。"}],"rationale":"明示姓名與局部敘事承接，短稱及田間田閒等異字仍待覆核，不按全域同名合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-094-tiandan:p009","text":"橫定齊三年，漢王使酈生往說下齊王廣及其相國橫。橫以為然，解其歷下軍。漢將韓信引兵且東擊齊。齊初使華無傷、田解軍於歷下以距漢，漢使至，乃罷守戰備，縱酒，且遣使與漢平。漢將韓信已平趙、燕，用蒯通計，度平原，襲破齊歷下軍，因入臨淄。齊王廣、相橫怒，以酈生賣己，而亨酈生。齊王廣東走高密，相橫走博（陽），守相田光走城陽，將軍田既軍於膠東。楚使龍且救齊，齊王與合軍高密。漢將韓信與曹參破殺龍且，虜齊王廣。漢將灌嬰追得齊守相田光。至博（陽），而橫聞齊王死，自立為齊王，還擊嬰，嬰敗橫之軍於嬴下。田橫亡走梁，歸彭越。彭越是時居梁地，中立，且為漢，且為楚。韓信已殺龍且，因令曹參進兵破殺田既於膠東，使灌嬰破殺齊將田吸於千乘。韓信遂平齊，乞自立為齊假王，漢因而立之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-094-tiandan:m009-0000","start":0,"end":1,"surface":"橫","kind":"person","person_id":"cbr-p005227","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m009-0006","start":6,"end":8,"surface":"漢王","kind":"person","person_id":"cbr-p005221","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m009-0009","start":9,"end":11,"surface":"酈生","kind":"person","person_id":"cbr-p005237","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m009-0014","start":14,"end":17,"surface":"齊王廣","kind":"person","person_id":"cbr-p005215","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m00