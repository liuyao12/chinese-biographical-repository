{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"hpw_2ip_uqk","canonical_person_id":"hpw_2ip_uqk","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["hpw_2ip_uqk"],"persons":[{"id":"hpw_2ip_uqk","label":"王然于（西南夷列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"王然于","mention_ids":["c-shiji-116-xinanyi:m005-0114","c-shiji-116-xinanyi:m009-0002"]}],"evidence":[{"mention_id":"c-shiji-116-xinanyi:m005-0114","chapter_id":"c-shiji-116-xinanyi","paragraph_id":"c-shiji-116-xinanyi:p005","quote":"王然于"},{"mention_id":"c-shiji-116-xinanyi:m009-0002","chapter_id":"c-shiji-116-xinanyi","paragraph_id":"c-shiji-116-xinanyi:p009","quote":"王然于"}]}],"source_mention_summary":[{"source_id":"s-shiji116-xinanyi","work_id":"w-shiji","book_id":"b-shiji-116","chapter_id":"c-shiji-116-xinanyi","mention_count":2,"mention_ids":["c-shiji-116-xinanyi:m005-0114","c-shiji-116-xinanyi:m009-0002"],"paragraph_ids":["c-shiji-116-xinanyi:p005","c-shiji-116-xinanyi:p009"],"passage_count":2}],"most_mentioned_source_ids":["s-shiji116-xinanyi"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-116-xinanyi:m005-0114","start":114,"end":117,"surface":"王然于","kind":"person","person_id":"hpw_2ip_uqk","status":"contextual_provisional","paragraph_id":"c-shiji-116-xinanyi:p005","chapter_id":"c-shiji-116-xinanyi"},{"id":"c-shiji-116-xinanyi:m009-0002","start":2,"end":5,"surface":"王然于","kind":"person","person_id":"hpw_2ip_uqk","status":"contextual_provisional","paragraph_id":"c-shiji-116-xinanyi:p009","chapter_id":"c-shiji-116-xinanyi"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-116-xinanyi:p005","text":"及元狩元年，博望侯張騫使大夏來，言居大夏時見蜀布、邛竹、杖，使問所從來，曰「從東南身毒國，可數千里，得蜀賈人市」。或聞邛西可二千里有身毒國。騫因盛言大夏在漢西南，慕中國，患匈奴隔其道，誠通蜀，身毒國道便近，有利無害。於是天子乃令王然于、柏始昌、呂越人等，使閒出西夷西，指求身毒國。至滇，滇王嘗羌乃留，為求道西十餘輩。歲餘，皆閉昆明，莫能通身毒國。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-116-xinanyi:m005-0009","start":9,"end":11,"surface":"張騫","kind":"person","person_id":"yxf_zou_iwk","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m005-0070","start":70,"end":71,"surface":"騫","kind":"person","person_id":"yxf_zou_iwk","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m005-0110","start":110,"end":112,"surface":"天子","kind":"person","person_id":"nvi_c32_k29","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m005-0114","start":114,"end":117,"surface":"王然于","kind":"person","person_id":"hpw_2ip_uqk","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m005-0118","start":118,"end":121,"surface":"柏始昌","kind":"person","person_id":"11q_2yl_qzt","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m005-0122","start":122,"end":125,"surface":"呂越人","kind":"person","person_id":"miw_t0v_k64","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m005-0145","start":145,"end":147,"surface":"嘗羌","kind":"person","person_id":"h0h_wsl_1nf","status":"contextual_provisional"}],"chapter_id":"c-shiji-116-xinanyi","book_id":"b-shiji-116","work_id":"w-shiji","source_id":"s-shiji116-xinanyi"},{"id":"c-shiji-116-xinanyi:p009","text":"上使王然于以越破及誅南夷兵威風喻滇王入朝。滇王者，其眾數萬人，其旁東北有勞寖、靡莫，皆同姓相扶，未肯聽。勞寖、靡莫數侵犯使者吏卒。元封二年，天子發巴蜀兵擊滅勞寖、靡莫，以兵臨滇。滇王始首善，以故弗誅。滇王離難西南夷，舉國降，請置吏入朝。於是以為益州郡，賜滇王王印，復長其民。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-116-xinanyi:m009-0000","start":0,"end":1,"surface":"上","kind":"person","person_id":"nvi_c32_k29","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m009-0002","start":2,"end":5,"surface":"王然于","kind":"person","person_id":"hpw_2ip_uqk","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m009-0016","start":16,"end":18,"surface":"滇王","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-116-xinanyi:m009-0021","start":21,"end":23,"surface":"滇王","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-116-xinanyi:m009-0070","start":70,"end":72,"surface":"天子","kind":"person","person_id":"nvi_c32_k29","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m009-0089","start":89,"end":91,"surface":"滇王","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-116-xinanyi:m009-0100","start":100,"end":102,"surface":"滇王","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-116-xinanyi:m009-0127","start":127,"end":129,"surface":"滇王","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-116-xinanyi","book_id":"b-shiji-116","work_id":"w-shiji","source_id":"s-shiji116-xinanyi"}],"sources":[{"chapter_id":"c-shiji-116-xinanyi","work_id":"w-shiji","book_id":"b-shiji-116","source_id":"s-shiji116-xinanyi","source":{"title":"史記／卷116","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷116","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷116&oldid=7903636","revision_id":7903636,"accessed_on":"2026-10-11","extent":"固定數位修訂全文12段，末段索隱述贊另層。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"去header2與現代節標題；YL紀年模板保留第一參數，第二參數編輯年標不納正文。正文原字不改，未核影像。","note":"第11段太史公評語仍正文；第12段索隱述贊分層。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_n