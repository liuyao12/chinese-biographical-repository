editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-116-xinanyi:m005-0114","start":114,"end":117,"surface":"王然于","kind":"person","person_id":"hpw_2ip_uqk","status":"contextual_provisional","paragraph_id":"c-shiji-116-xinanyi:p005","chapter_id":"c-shiji-116-xinanyi"},{"id":"c-shiji-116-xinanyi:m009-0002","start":2,"end":5,"surface":"王然于","kind":"person","person_id":"hpw_2ip_uqk","status":"contextual_provisional","paragraph_id":"c-shiji-116-xinanyi:p009","chapter_id":"c-shiji-116-xinanyi"},{"id":"c-shiji-117-xiangru:m035-0182","start":182,"end":185,"surface":"王然於","kind":"person","person_id":"okx_tik_f6o","status":"contextual_provisional","paragraph_id":"c-shiji-117-xiangru:p035","chapter_id":"c-shiji-117-xiangru"}],"relations":[],"title_holdings":[{"id":"th-shiji117-009","person_id":"okx_tik_f6o","title":"副使","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-117-xiangru","source_id":"s-shiji117-xiangru","paragraph_id":"c-shiji-117-xiangru:p035","quote":"相如還報。唐蒙已略通夜郎，因通西南夷道，發巴、蜀、廣漢卒，作者數萬人。治道二歲，道不成，士卒多物故，費以巨萬計。蜀民及漢用事者多言其不便。是時邛筰之君長聞南夷與漢通，得賞賜多，多欲原為內臣妾，請吏，比南夷。天子問相如，相如曰：「邛、筰、厓、駹者近蜀，道亦易通，秦時嘗通為郡縣，至漢興而罷。今誠複通，為置郡縣，愈於南夷。」天子以為然，乃拜相如為中郎將，建節往使。副使王然於、壺充國、呂越人馳四乘之傳，因巴蜀吏幣物以賂西夷。至蜀，蜀太守以下郊迎，縣令負弩矢先驅，蜀人以為寵。於是卓王孫、臨邛諸公皆因門下獻牛酒以交驩。卓王孫喟然而歎，自以得使女尚司馬長卿晚，而厚分與其女財，與男等同。司馬長卿便略定西夷，邛、筰、厓、駹、斯榆之君皆請為內臣。除邊關，關益斥，西至沬、若水，南至牂柯為徼，通零關道，橋孫水以通邛都。還報天子，天子大說。"}],"attestations":[{"id":"th-shiji117-009:a001","paragraph_id":"c-shiji-117-xiangru:p035","start":180,"end":182,"surface":"副使","person_mention_id":"c-shiji-117-xiangru:m035-0182","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授任與文獻用稱分存；受金失官與歲餘復召為郎分事件。原文未明示公元日期，不補年份或任期；死亡不自動終止全部官爵。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[{"id":"eq-shiji117-wangranyu","person_ids":["hpw_2ip_uqk","okx_tik_f6o"],"canonical_person_id":"hpw_2ip_uqk","scope":"cross_chapter","chapter_ids":["c-shiji-116-xinanyi","c-shiji-117-xiangru"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-116-xinanyi","source_id":"s-shiji116-xinanyi","paragraph_id":"c-shiji-116-xinanyi:p005","quote":"及元狩元年，博望侯張騫使大夏來，言居大夏時見蜀布、邛竹、杖，使問所從來，曰「從東南身毒國，可數千里，得蜀賈人市」。或聞邛西可二千里有身毒國。騫因盛言大夏在漢西南，慕中國，患匈奴隔其道，誠通蜀，身毒國道便近，有利無害。於是天子乃令王然于、柏始昌、呂越人等，使閒出西夷西，指求身毒國。至滇，滇王嘗羌乃留，為求道西十餘輩。歲餘，皆閉昆明，莫能通身毒國。","mention_ids":["c-shiji-116-xinanyi:m005-0114"]},{"chapter_id":"c-shiji-117-xiangru","source_id":"s-shiji117-xiangru","paragraph_id":"c-shiji-117-xiangru:p035","quote":"相如還報。唐蒙已略通夜郎，因通西南夷道，發巴、蜀、廣漢卒，作者數萬人。治道二歲，道不成，士卒多物故，費以巨萬計。蜀民及漢用事者多言其不便。是時邛筰之君長聞南夷與漢通，得賞賜多，多欲原為內臣妾，請吏，比南夷。天子問相如，相如曰：「邛、筰、厓、駹者近蜀，道亦易通，秦時嘗通為郡縣，至漢興而罷。今誠複通，為置郡縣，愈於南夷。」天子以為然，乃拜相如為中郎將，建節往使。副使王然於、壺充國、呂越人馳四乘之傳，因巴蜀吏幣物以賂西夷。至蜀，蜀太守以下郊迎，縣令負弩矢先驅，蜀人以為寵。於是卓王孫、臨邛諸公皆因門下獻牛酒以交驩。卓王孫喟然而歎，自以得使女尚司馬長卿晚，而厚分與其女財，與男等同。司馬長卿便略定西夷，邛、筰、厓、駹、斯榆之君皆請為內臣。除邊關，關益斥，西至沬、若水，南至牂柯為徼，通零關道，橋孫水以通邛都。還報天子，天子大說。","mention_ids":["c-shiji-117-xiangru:m035-0182"]}],"rationale":"兩篇漢廷通夜郎及出使西夷的相連敘事、姓名與任務互證；王然于／王然於保留來源異字。原始人物ID保留，同書平行篇章不當獨立見證，其他生平仍待核。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-116-xinanyi:p005","text":"及元狩元年，博望侯張騫使大夏來，言居大夏時見蜀布、邛竹、杖，使問所從來，曰「從東南身毒國，可數千里，得蜀賈人市」。或聞邛西可二千里有身毒國。騫因盛言大夏在漢西南，慕中國，患匈奴隔其道，誠通蜀，身毒國道便近，有利無害。於是天子乃令王然于、柏始昌、呂越人等，使閒出西夷西，指求身毒國。至滇，滇王嘗羌乃留，為求道西十餘輩。歲餘，皆閉昆明，莫能通身毒國。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-116-xinanyi:m005-0009","start":9,"end":11,"surface":"張騫","kind":"person","person_id":"yxf_zou_iwk","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m005-0070","start":70,"end":71,"surface":"騫","kind":"person","person_id":"yxf_zou_iwk","status":"contextu