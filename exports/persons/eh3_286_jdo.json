{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"eh3_286_jdo","canonical_person_id":"eh3_286_jdo","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["eh3_286_jdo"],"persons":[{"id":"7r6_k52_qji_ABAAAAEAAAAAAAAB","label":"王晙","status":"active","historicity":"historical_tradition","aliases":[{"surface":"晙","mention_ids":["c-jiutangshu-089-tang89:p002:m0146"]}],"evidence":[{"work_id":"w-jiutangshu","book_id":"b-jiutangshu-089","chapter_id":"c-jiutangshu-089-tang89","source_id":"s-jiutangshu-089-tang89-ws2589393","paragraph_id":"c-jiutangshu-089-tang89:p002","quote":"晙","mention_id":"c-jiutangshu-089-tang89:p002:m0146"}],"identity_note":"《舊唐書》本傳載王方慶少子晙；原文未明數字排行。","review":"ai_provisional","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"7r6_k52_qji_ABAAAAEAAAAAAAA","source_assertion_id":"a-jiutangshu-089-tang89-m0146-death-father","evidence":[{"work_id":"w-jiutangshu","book_id":"b-jiutangshu-089","chapter_id":"c-jiutangshu-089-tang89","source_id":"s-jiutangshu-089-tang89-ws2589393","paragraph_id":"c-jiutangshu-089-tang89:p002","quote":"長安二年五月卒，贈袞州都督，諡曰貞。中宗即位，以宮僚之舊，追贈吏部尚書。方慶博學好著述，所撰雜書凡二百餘卷。尤精《三禮》，好事者多詢訪之。每所酬答，鹹有典據，故時人編次，名曰《禮雜答問》。聚書甚多，不減秘閣，至於圖畫，亦多異本。諸子莫能守其業，卒後尋亦散亡。長子光輔，開元中官至潞州刺史。少子晙，工書知名，尤善琴棋，而性多嚴整，官至殿中侍御史。","subject_person_mention_id":"c-jiutangshu-089-tang89:p002:m0146","object_person_mention_id":"c-jiutangshu-089-tang89:p002:m0036","source_term":"少子晙"}],"status":"contextual_provisional","human_reviewed":false,"interpretation_note":"王方慶本傳稱少子，序號與生母留空。"}},{"id":"eh3_286_jdo","label":"王晙〔滄州景城〕","status":"active","historicity":"historical_tradition","aliases":[{"surface":"王晙","mention_ids":["c-jiutangshu-093-tang93:p001:m0000"]},{"surface":"晙","mention_ids":["c-jiutangshu-093-tang93:p001:m0024"]}],"evidence":[{"work_id":"w-jiutangshu","book_id":"b-jiutangshu-093","chapter_id":"c-jiutangshu-093-tang93","source_id":"s-jiutangshu-093-tang93-ws2588711","paragraph_id":"c-jiutangshu-093-tang9