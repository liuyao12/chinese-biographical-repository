ived_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jiutangshu-089-tang89:p002:m0036","start":36,"end":38,"surface":"方慶","kind":"person","person_id":"7r6_k52_qji_ABAAAAEAAAAAAAA","identification_status":"contextual_provisional","interpretation_note":"《舊唐書》稱王方慶，《新唐書》本傳明載王綝字方慶，兩傳均稱父弘直。"},{"id":"c-jiutangshu-089-tang89:p002:m0131","start":131,"end":133,"surface":"光輔","kind":"person","person_id":"7r6_k52_qji_ABAAAAEAAAAAAAAA","identification_status":"contextual_provisional","interpretation_note":"《舊唐書》本傳載王方慶長子光輔。"},{"id":"c-jiutangshu-089-tang89:p002:m0146","start":146,"end":147,"surface":"晙","kind":"person","person_id":"7r6_k52_qji_ABAAAAEAAAAAAAAB","identification_status":"contextual_provisional","interpretation_note":"《舊唐書》本傳載王方慶少子晙；原文未明數字排行。"}],"chapter_id":"c-jiutangshu-089-tang89","book_id":"b-jiutangshu-089","work_id":"w-jiutangshu","source_id":"s-jiutangshu-089-tang89-ws2589393"},{"id":"c-jiutangshu-093-tang93:p001","text":"王晙，滄州景城人，徙家於洛陽。祖有方，岷州刺史。晙弱冠明經擢第，曆遷殿中侍御史，加朝散大夫。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jiutangshu-093-tang93:p001:m0000","start":0,"end":2,"surface":"王晙","kind":"person","person_id":"eh3_286_jdo","identification_status":"contextual_provisional","interpretation_note":"《舊唐書》卷九十三景城王晙，祖有方。與卷八十九所記王方慶少子王晙分錄。"},{"id":"c-jiutangshu-093-tang93:p001:m0024","start":24,"end":25,"surface":"晙","kind":"person","person_id":"eh3_286_jdo","identification_status":"contextual_provisional","interpretation_note":"《舊唐書》卷九十三景城王晙，祖有方。與卷八十九所記王方慶少子王晙分錄。"}],"chapter_id":"c-jiutangshu-093-tang93","book_id":"b-jiutangshu-093","work_id":"w-jiutangshu","source_id":"s-jiutangshu-093-tang93-ws2588711"}],"sources":[{"chapter_id":"c-jiutangshu-089-tang89","work_id":"w-jiutangshu","book_id":"b-jiutangshu-089","source_id":"s-jiutangshu-089-tang89-ws2589393","source":{"title":"舊唐書卷89·王方慶傳","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=舊唐書/卷89&oldid=2589393","permalink":"https://zh.wikisou