licy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-042-xiaochen-complete:p007:m0029","start":29,"end":33,"surface":"司馬迪之","kind":"person","person_id":"irx_d0m_f4r","status":"contextual_provisional","paragraph_id":"c-nanqishu-042-xiaochen-complete:p007","chapter_id":"c-nanqishu-042-xiaochen-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-042-xiaochen-complete:p007","text":"　　諶兄誕，字彥偉，初爲殿中將軍。永明中爲建康令，與秣陵令司馬迪之同乘行，車前導四卒，左丞沈昭略奏：「凡有鹵簿官，共乘不得兼列騶寺。請免誕等官。」詔贖論。延興元年，自輔國徐州爲持節督司州剌史，將軍如故。明帝立，封安德侯，五百戶。進號冠軍。建武二年春，虜攻司州，誕盡力拒守，虜退。增封四百戶。徵左衞將軍。上欲殺諶，以誕在邊鎮拒虜，故未及行。虜退六旬，諶誅，遣黃門郎梁王爲司州別駕，使誅誕，束身受戮，家口繫尚方。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":44,"last_line":44,"raw_start":3377,"raw_end":3588,"raw_character_offsets":[3377,3378,3379,3380,3381,3382,3383,3384,3385,3386,3387,3388,3389,3390,3391,3392,3393,3394,3395,3396,3397,3398,3399,3400,3401,3402,3403,3404,3405,3406,3407,3408,3409,3410,3411,3412,3413,3414,3415,3416,3417,3418,3419,3420,3421,3422,3423,3424,3425,3426,3427,3428,3429,3430,3431,3432,3433,3434,3435,3436,3437,3438,3439,3440,3441,3442,3443,3444,3445,3446,3447,3448,3449,3450,3451,3452,3453,3454,3455,3456,3457,3458,3459,3460,3461,3462,3463,3464,3465,3466,3467,3468,3469,3470,3471,3472,3473,3474,3475,3476,3477,3478,3479,3480,3481,3482,3483,3484,3485,3486,3487,3488,3489,3490,3491,3492,3493,3494,3495,3501,3502,3503,3504,3507,3508,3509,3510,3511,3512,3513,3514,3515,3516,3517,3518,3519,3520,3521,3522,3523,3524,3525,3526,3527,3528,3529,3530,3531,3532,3533,3534,3535,3536,3537,3538,3539,3540,3541,3542,3543,3544,3545,3546,3547,3548,3549,3550,3551,3552,3553,3554,3555,3556,3557,3558,3559,3560,356