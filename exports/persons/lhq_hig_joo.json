","start":59,"end":61,"surface":"道固","kind":"person","person_id":"23q_wcp_hny","identification_status":"contextual_provisional","interpretation_note":"承傳首，檢得焦恭所得玉鎧。"},{"id":"c-songshu-088-song88:p001:m0069","start":69,"end":70,"surface":"恭","kind":"person","person_id":"lhq_hig_joo","identification_status":"contextual_provisional","interpretation_note":"前句破冢人焦恭。"},{"id":"c-songshu-088-song88:p001:m0076","start":76,"end":78,"surface":"子鸞","kind":"person","person_id":"9b9_9ba_01d","identification_status":"contextual_provisional","interpretation_note":"北中郎府主，與謝莊傳所見新安王子鸞官號相合。"},{"id":"c-songshu-088-song88:p001:m0089","start":89,"end":91,"surface":"子仁","kind":"person","person_id":"hx8_st4_jdd_B","identification_status":"contextual_provisional","interpretation_note":"左軍府主，卷八十〈永嘉王〉本傳明記子仁。"}],"source_position":{"raw_character_offsets":[6090,6091,6092,6093,6094,6095,6096,6097,6098,6099,6100,6101,6102,6103,6104,6105,6106,6107,6108,6109,6110,6111,6112,6113,6114,6115,6116,6117,6118,6119,6120,6121,6122,6123,6124,6125,6126,6127,6128,6129,6130,6131,6132,6133,6134,6135,6136,6137,6138,6139,6140,6141,6142,6143,6144,6145,6146,6147,6148,6149,6150,6151,6152,6153,6154,6155,6156,6157,6158,6159,6160,6161,6162,6163,6164,6165,6166,6167,6168,6169,6170,6171,6172,6173,6174,6175,6176,6177,6178,6179,6180,6181,6182,6183,6184,6185],"raw_start":6090,"raw_end":6186,"revision_id":2069210,"projection_sha256":"9508469a7a15a1686c7371361ff84a6efaa5f4551956a1a5589e98f04fa3e744","source_layer":"received_biography"},"chapter_id":"c-songshu-088-song88","book_id":"b-songshu-088","work_id":"w-songshu","source_id":"s-songshu-088-song88-ws2069210"}],"sources":[{"chapter_id":"c-songshu-088-song88","work_id":"w-songshu","book_id":"b-songshu-088","source_id":"s-songshu-088-song88-ws2069210","source":{"title":"宋書卷88·崔道固傳","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=宋書/卷88&oldid=2069210","permalink":"https://zh.wikisource.org/w/index.php?title=宋書/卷88&oldid=2069210","revision_id":2069210,"