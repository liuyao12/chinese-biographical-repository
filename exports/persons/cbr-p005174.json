ji-093-hanlu:m015-0109","start":109,"end":111,"surface":"王黃","kind":"person","person_id":"cbr-p005174","status":"contextual_provisional","paragraph_id":"c-shiji-093-hanlu:p015","chapter_id":"c-shiji-093-hanlu"},{"id":"c-shiji-093-hanlu:m015-0145","start":145,"end":147,"surface":"王黃","kind":"person","person_id":"cbr-p005174","status":"contextual_provisional","paragraph_id":"c-shiji-093-hanlu:p015","chapter_id":"c-shiji-093-hanlu"},{"id":"c-shiji-093-hanlu:m016-0302","start":302,"end":304,"surface":"王黃","kind":"person","person_id":"cbr-p005174","status":"contextual_provisional","paragraph_id":"c-shiji-093-hanlu:p016","chapter_id":"c-shiji-093-hanlu"},{"id":"c-shiji-093-hanlu:m017-0015","start":15,"end":17,"surface":"王黃","kind":"person","person_id":"cbr-p005174","status":"contextual_provisional","paragraph_id":"c-shiji-093-hanlu:p017","chapter_id":"c-shiji-093-hanlu"},{"id":"c-shiji-093-hanlu:m017-0090","start":90,"end":92,"surface":"王黃","kind":"person","person_id":"cbr-p005174","status":"contextual_provisional","paragraph_id":"c-shiji-093-hanlu:p017","chapter_id":"c-shiji-093-hanlu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji093-024","person_id":"cbr-p005174","scope":"same_chapter","chapter_ids":["c-shiji-093-hanlu"],"status":"contextual_provisional","rationale":"明示姓名及局部敘事承接；引古、未名者及短稱另存候選。臧茶與臧荼、高后與呂后待跨稱判讀，不因近形或熟知姓名自動合併。","reviewer":"Codex（AI 代理）","surfaces":["王黃"],"evidence":[{"paragraph_id":"c-shiji-093-hanlu:p005","quote":"七年冬，上自往擊，破信軍銅鞮，斬其將王喜。信亡走匈奴。（與）其與白土人曼丘臣、王黃等立趙苗裔趙利為王，復收信敗散兵，而與信及冒頓謀攻漢。匈奴仗左右賢王將萬餘騎與王黃等屯廣武以南，至晉陽，與漢兵戰，漢大破之，追至于離石，復破之。匈奴復聚兵樓煩西北，漢令車騎擊破匈奴。匈奴常敗走，漢乘勝追北，聞冒頓居代（上）谷，高皇帝居晉陽，使人視冒頓，還報曰「可擊」。上遂至平城。上出白登，匈奴騎圍上，上乃使人厚遺閼氏。閼氏乃說冒頓曰：「今得漢地，猶不能居；且兩主不相緱」居七日，胡騎稍引去。時天大霧，漢使人往來，胡不覺。護軍中尉陳平言上曰：「胡者全兵，請令彊弩傅兩矢外向，徐行出圍。」入平城，漢救兵亦到，胡騎遂解去。漢亦罷兵歸。韓信為匈奴將兵往來擊邊。"},{"paragraph_id":"c-shiji-093-hanlu:p006","quote":"漢十年，信令王黃等說誤陳豨。十一年春，故韓王信復與胡騎入居參合，距漢。漢使柴將軍擊之，遺信書曰：「陛下寬仁，諸侯雖有畔亡，而復歸，輒復故位號，不誅也。大王所知。今王以敗亡走胡，非有大罪，急自歸！」韓王信報曰：「陛下擢仆起閭巷，南面稱孤，此仆之幸也。滎陽之事，仆不能死，囚於項籍，此一罪也。及寇攻馬邑，仆不能堅守，以城降之，此二罪也。今反為寇將兵，與將軍爭一旦之命，此三罪也。夫種、蠡無一罪，身死亡；今仆有三罪於陛下，而欲求活於世，此伍子胥所以僨於吳也。今仆亡匿山谷閒，旦暮乞貸蠻夷，仆之思歸，如痿人不忘起，盲者不忘視也，勢不可耳。」遂戰。柴將軍屠參合，斬韓王信。"},{"paragraph_id":"c-shiji-093-hanlu:p010","quote":"漢十一年秋，陳豨反代地，高祖如邯鄲擊豨兵，燕王綰亦擊其東北。當是時，陳豨使王黃求救匈奴。燕王綰亦使其臣張勝於匈奴，言豨等軍破。張勝至胡，故燕王臧茶子衍出亡在胡，見張勝曰：「公所以重於燕者，以習胡事也。燕所以久存者，以諸侯數反，兵連不決也。今公為燕欲急滅豨等，豨等已盡，次亦至燕，公等亦且為虜矣。公何不令燕且緩陳豨而與胡和？事寬，得長王燕；即有漢急，可以安國。」張勝以為然，豨私令匈奴助豨等擊燕。燕王綰疑張勝與胡反，上書請族張勝。勝還，具道所以為者。燕王寤，乃詐論它人，脫勝家屬，使得為匈奴閒，而陰使范齊之陳豨所，欲令久亡，連兵勿決。"},{"paragraph_id":"c-shiji-093-hanlu:p015","quote":"豨常告歸過趙，趙相周昌見豨賓客隨之者千餘乘，邯鄲官舍皆滿。豨所以待賓客布衣交，皆出客下。豨還之代，周昌乃求入見。見上，具言豨賓客盛甚，擅兵於外數歲，恐有變。上乃令人覆案豨客居代者財物諸不法事，多連引豨。豨恐，陰令客通使王黃、曼丘臣所。及高祖十年七月，太上皇崩，使人召豨，豨稱病甚。九月，遂與王黃等反，自立為代王，劫略趙、代。"},{"paragraph_id":"c-shiji-093-hanlu:p016","quote":"上聞，乃赦趙、代吏人為豨所詿誤劫略者，皆赦之。上自往，至邯鄲，喜曰：「豨不南據漳水，北守邯鄲，知其無能為也。」趙相奏斬常山守、尉，曰：「常山二十五城，豨反，亡其二十城。」上問曰：「守、尉反乎？」對曰：「不反。」上曰：「是力不足也。」赦之，復以為常山守、尉。上問周昌曰：「趙亦有壯士可令將者乎？」對曰：「有四人。」四人謁，上謾罵曰：「豎子能為將乎？」四人慚伏。上封之各千戶，以為將。左右諫曰：「從入蜀、漢，伐楚，功未遍行，今此何功而封？」上曰：「非若所知！陳豨反，邯鄲以北皆豨有，吾以羽檄徵天下兵，未有至者，今唯獨邯鄲中兵耳。吾胡愛四千戶封四人，不以慰趙子弟！」皆曰：「善。」於是上曰：「陳豨將誰？」曰：「王黃、曼丘臣，皆故賈人。」上曰：「吾知之矣。」乃各以千金購黃、臣等。"},{"paragraph_id":"c-shiji-093-hanlu:p017","quote":"十一年冬，漢兵擊斬陳豨將侯敞、王黃於曲逆下，破豨將張春於聊城，斬首萬餘。太尉勃入定太原、代地。十二月，上自擊東垣，東垣不下，卒罵上；東垣降，卒罵者斬之，不罵者黥之。更命東垣為真定。王黃、曼丘臣其麾下受購賞之，皆生得，以故陳豨軍遂敗。"}]}],"equivalence_decisions":[{"id":"eq-shiji093-huang","person_ids":["cbr-p000797","cbr-p005174"],"canonical_person_id":"cbr-p000797","scope":"cross_chapter","chapter_ids":["c-shiji-008-gaozu","c-shiji-093-hanlu"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-008-gaozu","source_id":"s-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p064","quote":"七年，匈奴攻韓王信馬邑，信因與謀反太原。白土曼丘臣、王黃立故趙將趙利為王以反，高祖自往擊之。會天寒，士卒墮指者什二三，遂至平城。匈奴圍我平城，七日而後罷去。令樊噲止定代地。立兄劉仲為代王。","mention_ids":["c-shiji-008-gaozu:m064-0026"]},{"chapter_id":"c-shiji-093-hanlu","source_id":"s-shiji-093-hanlu","paragraph_id":"c-shiji-093-hanlu:p005","quote":"七年冬，上自往擊，破信軍銅鞮，斬其將王喜。信亡走匈奴。（與）其與白土人曼丘臣、王黃等立趙苗裔趙利為王，復收信敗散兵，而與信及冒頓謀攻漢。匈奴仗左右賢王將萬餘騎與王黃等屯廣武以南，至晉陽，與漢兵戰，漢大破之，追至于離石，復破之。匈奴復聚兵樓煩西北，漢令車騎擊破匈奴。匈奴常敗走，漢乘勝追北，聞冒頓居代（上）谷，高皇帝居晉陽，使人視冒頓，還報曰「可擊」。上遂至平城。上出白登，匈奴騎圍上，上乃使人厚遺閼氏。閼氏乃說冒頓曰：「今得漢地，猶不能居；且兩主不相緱」居七日，胡騎稍引去。時天大霧，漢使人往來，胡不覺。護軍中尉陳平言上曰：「胡者全兵，請令彊弩傅兩矢外向，徐行出圍。」入平城，漢救兵亦到，胡騎遂解去。漢亦罷兵歸。韓信為匈奴將兵往來擊邊。","mention_ids":["c-shiji-093-hanlu:m005-0039","c-shiji-093-hanlu:m005-0080"]}],"rationale":"白土曼丘臣王黃立趙利反漢的姓名與共同事件相配，後續斬與生得不調和。 各篇原字、原文與已發ID保留，同書不視為獨立見證；同指不確證所有紀年、任職、親屬或敘事，不按全域同名批量改號。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-008-gaozu:p064","text":"七年，匈奴攻韓王信馬邑，信因與謀反太原。白土曼丘臣、王黃立故趙將趙利為王以反，高祖自往擊之。會天寒，士卒墮指者什二三，遂至平城。匈奴圍我平城，七日而後罷去。令樊噲止定代地。立兄劉仲為代王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m064-0006","start":6,"end":9,"surface":"韓王信","kind":"person","person_id":"cbr-p000774","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m064-0012","start":12,"end":13,"surface":"信","kind":"person","person_id":"cbr-p000774","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m064-0022","start":22,"end":25,"surface":"曼丘臣","kind":"person","person_id":"cbr-p000796","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m064-0026","start":26,"end":28,"surface":"王黃","kind":"person","person_id":"cbr-p000797","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m064-0032","start":32,"end":34,"surface":"趙利","kind":"person","person_id":"cbr-p000798","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m064-0039","start":39,"end":41,"surface":"高祖","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m064-0079","start":79,"end":81,"surface":"樊噲","kind":"person","person_id":"cbr-p000691","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m064-0088","start":88,"end":90,"surface":"劉仲","kind":"person","person_id":"cbr-p000799","status":"contextual_provisional"}],"chapter_id":"c-shiji-008-gaozu","book_id":"b-shiji-008","work_id":"w-shiji","source_id":"s-shiji-008-gaozu"},{"id":"c-shiji-008-gaozu:p073","text":"八月，趙相國陳豨反代地。上曰：「豨嘗為吾使，甚有信。代地吾所急也，故封豨為列侯，以相國守代，今乃與王黃等劫掠代地！代地吏民非有罪也。其赦代吏民。」九月，上自東往擊之。至邯鄲，上喜曰：「豨不南據邯鄲而阻漳水，吾知其無能為也。」聞豨將皆故賈人也，上曰：「吾知所以與之。」乃多以金啗豨將，豨將多降者。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m073-0006","start":6,"end":8,"surface":"陳豨","kind":"person","person_id":"cbr-p000801","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m073-0012","start":12,"end":13,"surface":"上","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m073-0016","start":16,"end":17,"surface":"豨","kind":"person","person_id":"cbr-p000801","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m073-0035","start":35,"end":36,"surface":"豨","kind":"person","person_id":"cbr-p000801","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m073-0049","start":49,"end":51,"surface":"王黃","kind":"person","person_id":"cbr-p000797","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m073-0076","start":76,"end":77,"surface":"上","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m073-0087","start":87,"end":88,"surface":"上","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m073-0092","start":92,"end":93,"surface":"豨","kind":"person","person_id":"cbr-p000801","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m073-0113","start":113,"end":114,"surface":"豨","kind":"person","person_id":"cbr-p000801","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m073-0121","start":121,"end":122,"surface":"上","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m073-0138","start":138,"end":139,"surface":"豨","kind":"person","person_id":"cbr-p000801","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m073-0141","start":141,"end":142,"surface":"豨","kind":"person","person_id":"cbr-p000801","status":"contextual_provisional"}],"chapter_id":"c-shiji-008-gaozu","book_id":"b-shiji-008","work_id":"w-shiji","source_id":"s-shiji-008-gaozu"},{"id":"c-shiji-008-gaozu:p074","text":"十一年，高祖在邯鄲誅豨等未畢，豨將侯敞將萬餘人游行，王黃軍曲逆，張春渡河擊聊城。漢使將軍郭蒙與齊將擊，大破之。太尉周勃道太原入，定代地。至馬邑，馬邑不下，即攻殘之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m074-0004","start":4,"end":6,"surface":"高祖","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m074-0010","start":10,"end":11,"surface":"豨","kind":"person","person_id":"cbr-p000801","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m074-0015","start":15,"end":16,"surface":"豨","kind":"person","person_id":"cbr-p000801","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m074-0017","start":17,"end":19,"surface":"侯敞","kind":"person","person_id":"cbr-p000802","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m074-0026","start":26,"end":28,"surface":"王黃","kind":"person","person_id":"cbr-p000797","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m074-0032","start":32,"end":34,"surface":"張春","kind":"person","person_id":"cbr-p000803","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m074-0044","start":44,"end":46,"surface":"郭蒙","kind":"person","person_id":"cbr-p000804","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m074-0057","start":57,"end":59,"surface":"周勃","kind":"person","person_id":"cbr-p000805","status":"contextual_provisional"}],"chapter_id":"c-shiji-008-gaozu","book_id":"b-shiji-008","work_id":"w-shiji","source_id":"s-shiji-008-gaozu"},{"id":"c-shiji-093-hanlu:p005","text":"七年冬，上自往擊，破信軍銅鞮，斬其將王喜。信亡走匈奴。（與）其與白土人曼丘臣、王黃等立趙苗裔趙利為王，復收信敗散兵，而與信及冒頓謀攻漢。匈奴仗左右賢王將萬餘騎與王黃等屯廣武以南，至晉陽，與漢兵戰，漢大破之，追至于離石，復破之。匈奴復聚兵樓煩西北，漢令車騎擊破匈奴。匈奴常敗走，漢乘勝追北，聞冒頓居代（上）谷，高皇帝居晉陽，使人視冒頓，還報曰「可擊」。上遂至平城。上出白登，匈奴騎圍上，上乃使人厚遺閼氏。閼氏乃說冒頓曰：「今得漢地，猶不能居；且兩主不相緱」居七日，胡騎稍引去。時天大霧，漢使人往來，胡不覺。護軍中尉陳平言上曰：「胡者全兵，請令彊弩傅兩矢外向，徐行出圍。」入平城，漢救兵亦到，胡騎遂解去。漢亦罷兵歸。韓信為匈奴將兵往來擊邊。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-093-hanlu:m005-0004","start":4,"end":5,"surface":"上","kind":"person","person_id":"cbr-p005157","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m005-0010","start":10,"end":11,"surface":"信","kind":"person","person_id":"cbr-p005152","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m005-0018","start":18,"end":20,"surface":"王喜","kind":"person","person_id":"cbr-p005173","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m005-0021","start":21,"end":22,"surface":"信","kind":"person","person_id":"cbr-p005152","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m005-0035","start":35,"end":38,"surface":"曼丘臣","kind":"person","person_id":"cbr-p005161","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m005-0039","start":39,"end":41,"surface":"王黃","kind":"person","person_id":"cbr-p005174","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m005-0046","start":46,"end":48,"surface":"趙利","kind":"person","person_id":"cbr-p005175","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m005-0053","start":53,"end":54,"surface":"信","kind":"person","person_id":"cbr-p005152","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m005-0060","start":60,"end":61,"surface":"信","kind":"person","person_id":"cbr-p005152","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m005-0062","start":62,"end":64,"surface":"冒頓","kind":"person","person_id":"cbr-p005172","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m005-0080","start":80,"end":82,"surface":"王黃","kind":"person","person_id":"cbr-p005174","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m005-0145","start":145,"end":147,"surface":"冒頓","kind":"person","person_id":"cbr-p005172","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m005-0154","start":154,"end":157,"surface":"高皇帝","kind":"person","person_id":"cbr-p005157","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m005-0164","start":164,"end":166,"surface":"冒頓","kind":"person","person_id":"cbr-p005172","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m005-0175","start":175,"end":176,"surface":"上","kind":"person","person_id":"cbr-p005157","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m005-0181","start":181,"end":182,"surface":"上","kind":"person","person_id":"cbr-p005157","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m005-0190","start":190,"end":191,"surface":"上","kind":"person","person_id":"cbr-p005157","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m005-0192","start":192,"end":193,"surface":"上","kind":"person","person_id":"cbr-p005157","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m005-0198","start":198,"end":200,"surface":"閼氏","kind":"person","person_id":"cbr-p005176","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m005-0201","start":201,"end":203,"surface":"閼氏","kind":"person","person_id":"cbr-p005176","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m005-0205","start":205,"end":207,"surface":"冒頓","kind":"person","person_id":"cbr-p005172","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m005-0256","start":256,"end":258,"surface":"陳平","kind":"person","person_id":"cbr-p005177","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m005-0259","start":259,"end":260,"surface":"上","kind":"person","person_id":"cbr-p005157","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m005-0306","start":306,"end":308,"surface":"韓信","kind":"person","person_id":"cbr-p005152","status":"contextual_provisional"}],"chapter_id":"c-shiji-093-hanlu","book_id":"b-shiji-093","work_id":"w-shiji","source_id":"s-shiji-093-hanlu"},{"id":"c-shiji-093-hanlu:p006","text":"漢十年，信令王黃等說誤陳豨。十一年春，故韓王信復與胡騎入居參合，距漢。漢使柴將軍擊之，遺信書曰：「陛下寬仁，諸侯雖有畔亡，而復歸，輒復故位號，不誅也。大王所知。今王以敗亡走胡，非有大罪，急自歸！」韓王信報曰：「陛下擢仆起閭巷，南面稱孤，此仆之幸也。滎陽之事，仆不能死，囚於項籍，此一罪也。及寇攻馬邑，仆不能堅守，以城降之，此二罪也。今反為寇將兵，與將軍爭一旦之命，此三罪也。夫種、蠡無一罪，身死亡；今仆有三罪於陛下，而欲求活於世，此伍子胥所以僨於吳也。今仆亡匿山谷閒，旦暮乞貸蠻夷，仆之思歸，如痿人不忘起，盲者不忘視也，勢不可耳。」遂戰。柴將軍屠參合，斬韓王信。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-093-hanlu:m006-0004","start":4,"end":5,"surface":"信","kind":"person","person_id":"cbr-p005152","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m006-0006","start":6,"end":8,"surface":"王黃","kind":"person","person_id":"cbr-p005174","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m006-0011","start":11,"end":13,"surface":"陳豨","kind":"person","person_id":"cbr-p005178","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m006-0019","start":19,"end":23,"surface":"故韓王信","kind":"person","person_id":"cbr-p005152","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m006-0037","start":37,"end":40,"surface":"柴將軍","kind":"person","person_id":"cbr-p005162","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m006-0044","start":44,"end":45,"surface":"信","kind":"person","person_id":"cbr-p005152","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m006-0098","start":98,"end":101,"surface":"韓王信","kind":"person","person_id":"cbr-p005152","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m006-0136","start":136,"end":138,"surface":"項籍","kind":"person","person_id":"cbr-p005159","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m006-0188","start":188,"end":189,"surface":"種","kind":"person","person_id":"cbr-p005203","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m006-0190","start":190,"end":191,"surface":"蠡","kind":"person","person_id":"cbr-p005204","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m006-0216","start":216,"end":219,"surface":"伍子胥","kind":"person","person_id":"cbr-p005163","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m006-0269","start":269,"end":272,"surface":"柴將軍","kind":"person","person_id":"cbr-p005162","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m006-0277","start":277,"end":280,"surface":"韓王信","kind":"person","person_id":"cbr-p005152","status":"contextual_provisional"}],"chapter_id":"c-shiji-093-hanlu","book_id":"b-shiji-093","work_id":"w-shiji","source_id":"s-shiji-093-hanlu"},{"id":"c-shiji-093-hanlu:p010","text":"漢十一年秋，陳豨反代地，高祖如邯鄲擊豨兵，燕王綰亦擊其東北。當是時，陳豨使王黃求救匈奴。燕王綰亦使其臣張勝於匈奴，言豨等軍破。張勝至胡，故燕王臧茶子衍出亡在胡，見張勝曰：「公所以重於燕者，以習胡事也。燕所以久存者，以諸侯數反，兵連不決也。今公為燕欲急滅豨等，豨等已盡，次亦至燕，公等亦且為虜矣。公何不令燕且緩陳豨而與胡和？事寬，得長王燕；即有漢急，可以安國。」張勝以為然，豨私令匈奴助豨等擊燕。燕王綰疑張勝與胡反，上書請族張勝。勝還，具道所以為者。燕王寤，乃詐論它人，脫勝家屬，使得為匈奴閒，而陰使范齊之陳豨所，欲令久亡，連兵勿決。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-093-hanlu:m010-0006","start":6,"end":8,"surface":"陳豨","kind":"person","person_id":"cbr-p005178","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m010-0012","start":12,"end":14,"surface":"高祖","kind":"person","person_id":"cbr-p005157","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m010-0018","start":18,"end":19,"surface":"豨","kind":"person","person_id":"cbr-p005178","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m010-0021","start":21,"end":24,"surface":"燕王綰","kind":"person","person_id":"cbr-p005166","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m010-0034","start":34,"end":36,"surface":"陳豨","kind":"person","person_id":"cbr-p005178","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m010-0037","start":37,"end":39,"surface":"王黃","kind":"person","person_id":"cbr-p005174","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m010-0044","start":44,"end":47,"surface":"燕王綰","kind":"person","person_id":"cbr-p005166","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m010-0051","start":51,"end":53,"surface":"張勝","kind":"person","person_id":"cbr-p005186","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m010-0058","start":58,"end":59,"surface":"豨","kind":"person","person_id":"cbr-p005178","status":"con