-luxun:line013:m0044","start":44,"end":45,"surface":"遜","kind":"person","person_id":"lii_454_vuv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line013:m0076","start":76,"end":77,"surface":"遜","kind":"person","person_id":"lii_454_vuv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line013:m0092","start":92,"end":94,"surface":"潘臨","kind":"person","person_id":"tjr_ao0_x0b","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line013:m0107","start":107,"end":108,"surface":"遜","kind":"person","person_id":"lii_454_vuv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line013:m0137","start":137,"end":139,"surface":"尤突","kind":"person","person_id":"3xr_2xg_fsn","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"}],"annotation_status":"reviewed","source_position":{"first_line":13,"last_line":13,"revision_id":2131313,"raw_start":318,"raw_end":501,"character_positions":[320,321,322,323,324,325,326,327,328,329,330,331,332,333,334,335,336,337,338,339,340,341,342,343,344,345,346,347,348,349,350,351,352,353,354,355,356,357,381,382,383,384,385,386,387,388,389,390,391,392,393,394,395,396,397,398,399,400,401,402,403,404,405,406,407,408,409,410,411,412,413,414,415,416,417,418,419,420,421,422,423,424,425,426,427,428,429,430,431,432,433,434,435,436,437,438,439,440,441,442,443,444,445,446,447,448,449,450,451,452,453,454,455,456,457,458,459,460,461,462,463,464,465,466,467,468,469,470,471,472,473,474,475,476,477,478,479,480,481,482,483,484,485,486,487,488,489,490,491,492,493,494,495,496,497,498,499,500]},"chapter_id":"c-sanguozhi-058-luxun","book_id":"b-sanguozhi-058","work_id":"w-sanguozhi","source_id":"s-sanguozhi-058-luxun"},{"id":"c-sanguozhi-060-heqi:line023","text":"　　二十一年，鄱陽民尤突受曹公印綬，化民為賊，陵陽、始安、涇縣皆與突相應。齊與陸遜討破突，斬首數千，餘黨震服，丹楊三縣皆降，料得精兵八千人。拜安東將軍，封山陰侯，出鎮江上，督扶州以上至皖。