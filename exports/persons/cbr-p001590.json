,"end":38,"surface":"良夫","kind":"person","person_id":"cbr-p001590","status":"contextual_provisional","paragraph_id":"c-shiji-037-wei:p034","chapter_id":"c-shiji-037-wei"},{"id":"c-shiji-037-wei:m034-0051","start":51,"end":53,"surface":"良夫","kind":"person","person_id":"cbr-p001590","status":"contextual_provisional","paragraph_id":"c-shiji-037-wei:p034","chapter_id":"c-shiji-037-wei"},{"id":"c-shiji-037-wei:m034-0060","start":60,"end":62,"surface":"良夫","kind":"person","person_id":"cbr-p001590","status":"contextual_provisional","paragraph_id":"c-shiji-037-wei:p034","chapter_id":"c-shiji-037-wei"},{"id":"c-shiji-037-wei:m034-0102","start":102,"end":104,"surface":"良夫","kind":"person","person_id":"cbr-p001590","status":"contextual_provisional","paragraph_id":"c-shiji-037-wei:p034","chapter_id":"c-shiji-037-wei"}],"relations":[],"title_holdings":[{"id":"th-shiji037-070","person_id":"cbr-p001590","title":"豎","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-037-wei","source_id":"s-shiji-037-wei","paragraph_id":"c-shiji-037-wei:p034","quote":"孔氏之豎渾良夫美好，孔文子卒，良夫通於悝母。"}],"attestations":[{"id":"th-shiji037-070:a001","paragraph_id":"c-shiji-037-wei:p034","start":24,"end":25,"surface":"豎","person_mention_id":"c-shiji-037-wei:m034-0025","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"孔氏之豎原角色，未推正式宦官或官品；許妻不作婚成。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji037-107","person_id":"cbr-p001590","surfaces":["渾良夫","良夫"],"scope":"same_chapter","chapter_ids":["c-shiji-037-wei"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-037-wei:p034","quote":"十二年，初，孔圉文子取太子蒯聵之姊，生悝。孔氏之豎渾良夫美好，孔文子卒，良夫通於悝母。太子在宿，悝母使良夫於太子。太子與良夫言曰：「茍能入我國，報子以乘軒，免子三死，毋所與。」與之盟，許以悝母爲妻。閏月，良夫與太子入，舍孔氏之外圃。昏，二人蒙衣而乘，宦者羅御，如孔氏。孔氏之老欒甯問之，稱姻妾以告。遂入，適伯姬氏。旣食，悝母杖戈而先，太子與五人介，輿猳從之。伯姬劫悝於廁，彊盟之，遂劫以登臺。欒甯將飲酒，炙未熟，聞亂，使告仲由。召護駕乘車，行爵食炙，奉出公輒奔魯。"}],"rationale":"按本篇明示名與追稱、衛世系及具體事件暫定所列提及同指；每段原文附存，不按同名字面跨篇合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-037-wei:p034","text":"十二年，初，孔圉文子取太子蒯聵之姊，生悝。孔氏之豎渾良夫美好，孔文子卒，良夫通於悝母。太子在宿，悝母使良夫於太子。太子與良夫言曰：「茍能入我國，報子以乘軒，免子三死，毋所與。」與之盟，許以悝母爲妻。閏月，良夫與太子入，舍孔氏之外圃。昏，二人蒙衣而乘，宦者羅御，如孔氏。孔氏之老欒甯問之，稱姻妾以告。遂入，適伯姬氏。旣食，悝母杖戈而先，太子與五人介，輿猳從之。伯姬劫悝於廁，彊盟之，遂劫以登臺。欒甯將飲酒，炙未熟，聞亂，使告仲由。召護駕乘車，行爵食炙，奉出公輒奔魯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-037-wei:m034-0006","start":6,"end":10,"surface":"孔圉文子","kind":"person","person_id":"cbr-p001587","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m034-0011","start":11,"end":15,"surface":"太子蒯聵","kind":"person","person_id":"cbr-p001585","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m034-0016","start":16,"end":17,"surface":"姊","kind":"person","person_id":"cbr-p001588","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m034-0019","start":19,"end":20,"surface":"悝","kind":"person","person_id":"cbr-p001589","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m034-0025","start":25,"end":28,"surface":"渾良夫","kind":"person","person_id":"cbr-p001590","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m034-0031","start":31,"end":34,"surface":"孔文子","kind":"person","person_id":"cbr-p001587","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m034-0036","start":36,"end":38,"surface":"良夫","kind":"person","person_id":"cbr-p001590","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m034-0040","start":40,"end":42,"surface":"悝母","kind":"person","person_id":"cbr-p001588","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m034-0043","start":43,"end":45,"surface":"太子","kind":"person","person_id":"cbr-p001585","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m034-0048","start":48,"end":50,"surface":"悝母","kind":"person","