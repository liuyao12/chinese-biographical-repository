合家見誅慧龍年十四為沙門僧彬所匿百餘日將慧龍過江為津人所疑曰行意怱怱徬徨得非王氏諸子乎僧彬曰貧道從師有年止西岸今暫欲定省還期無逺此隨吾受業者何至如君言既濟遂西上江陵依叔祖忱故吏荆州前治中習辟疆時刺史魏詠之卒辟疆與江陵令羅脩前别駕劉期公土人王騰等謀舉兵推慧龍為盟主尅日襲州城而劉裕聞詠之卒亦懼江陵有變遣其弟道規為荆州衆遂不果羅脩將慧龍又與僧彬北詣襄陽司馬徳宗雍州刺史魯宗之資給慧龍送渡江遂自虎牢奔于姚興其自言也如此","text_layer":"received_chapter","annotation_status":"in_progress","source_position":{"first_line":225,"last_line":238,"revision_id":"17b6525eb5aaa878b9640f5a61e90da934ce5fc4","source_layer":"received_biography","projection_sha256":"61e1c463ed6baeef76c77f33a276423199f8a0e7aa765f7949b6ad2d64afb6a0","raw_character_positions":[{"line":225,"column":0},{"line":225,"column":1},{"line":225,"column":2},{"line":225,"column":3},{"line":225,"column":4},{"line":225,"column":5},{"line":225,"column":6},{"line":225,"column":7},{"line":225,"column":8},{"line":225,"column":9},{"line":225,"column":10},{"line":225,"column":11},{"line":225,"column":12},{"line":225,"column":13},{"line":225,"column":14},{"line":225,"column":15},{"line":225,"column":16},{"line":225,"column":17},{"line":225,"column":18},{"line":225,"column":19},{"line":225,"column":20},{"line":226,"column":0},{"line":226,"column":1},{"line":226,"column":2},{"line":226,"column":3},{"line":226,"column":4},{"line":226,"column":5},{"line":226,"column":6},{"line":226,"column":7},{"line":226,"column":8},{"line":226,"column":9},{"line":226,"column":10},{"line":226,"column":11},{"line":226,"column":12},{"line":226,"column":13},{"line":226,"column":14},{"line":226,"column":15},{"line":226,"column":16},{"line":226,"column":17},{"line":226,"column":18},{"line":226,"column":19},{"line":226,"column":20},{"line":227,"column":0},{"line":227,"column":1},{"line":227,"column":2},{"line":227,"column":3},{"line":227,"column":4},{"line":227,"column":5},{"line":227,"column":6},{"line":227,"column":7},{"line":227,"column":8},{"line":227,"column":9},{"line":227,"column":10},{"line":227,"column":11},{"line":227,"column":12},{"line":227,"column":13},{"line":227,"column":14},{"line":227,"column":15},{"line":227,"column":16},{"line":227,"column":1