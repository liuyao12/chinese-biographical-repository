entified","paragraph_id":"c-shiji-004-zhou:p081","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-004-zhou:m081-0127","start":127,"end":128,"surface":"犯","kind":"person","person_id":"cbr-p000305","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p081","chapter_id":"c-shiji-004-zhou"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-004-zhou:p081","text":"四十二年，秦破華陽約。馬犯謂周君曰：「請令梁城周。」乃謂梁王曰：「周王病若死，則犯必死矣。犯請以九鼎自入於王，王受九鼎而圖犯。」梁王曰：「善。」遂與之卒，言戍周。因謂秦王曰：「梁非戍周也，將伐周也。王試出兵境以觀之。」秦果出兵。又謂梁王曰：「周王病甚矣，犯請後可而復之。今王使卒之周，諸侯皆生心，後舉事且不信。不若令卒為周城，以匿事端。」梁王曰：「善。」遂使城周。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-004-zhou:m081-0011","start":11,"end":13,"surface":"馬犯","kind":"person","person_id":"cbr-p000305","status":"source_identified"},{"id":"c-shiji-004-zhou:m081-0014","start":14,"end":16,"surface":"周君","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官號或文字疑讀；保留錨點，不補熟知姓名或假定同指。"},{"id":"c-shiji-004-zhou:m081-0028","start":28,"end":30,"surface":"梁王","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官號或文字疑讀；保留錨點，不補熟知姓名或假定同指。"},{"id":"c-shiji-004-zhou:m081-0033","start":33,"end":35,"surface":"周王","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官號或文字疑讀；保留錨點，不補熟知姓名或假定同指。"},{"id":"c-shiji-004-zhou:m081-0040","start":40,"end":41,"surface":"犯","kind":"person","person_id":"cbr-p000305","status":"source_identified"},{"id":"c-shiji-004-zhou:m081-0045","start":45,"end":46,"surface":"犯","kind":"person","person_id":"cbr-p000305","status":"source_identified"},{"id":"c-shiji-004-zhou:m081-0053","start":53,"end":54,"surface":"王","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官號或文字疑讀；保留錨點，不補熟知姓名或假定同指。"},{"id":"c-shiji-004-zhou:m081-0055","start":55,"end":56,"surface":"王","kind":"unresolved","person_id":null,"status":"unresolved","note"