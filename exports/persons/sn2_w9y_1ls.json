ou:p018","chapter_id":"c-shiji-004-zhou"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-004-zhou:p018","text":"封商紂子祿父殷之餘民。武王為殷初定未集，乃使其弟管叔鮮、蔡叔度相祿父治殷。已而命召公釋箕子之囚。命畢公釋百姓之囚，表商容之閭。命南宮括散鹿臺之財，發鉅橋之粟，以振貧弱萌隸。命南宮括、史佚展九鼎保玉。命閎夭封比干之墓。命宗祝享祠于軍。乃罷兵西歸。行狩，記政事，作《武成》。封諸侯，班賜宗彝，作《分殷之器物》。武王追思先聖王，乃褒封神農之後於焦，黃帝之後於祝，帝堯之後於薊，帝舜之後於陳，大禹之後於杞。於是封功臣謀士，而師尚父為首封。封尚父於營丘，曰齊。封弟周公旦於曲阜，曰魯。封召公奭於燕。封弟叔鮮于管，弟叔度於蔡。餘各以次受封。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-004-zhou:m018-0001","start":1,"end":3,"surface":"商紂","kind":"person","person_id":"lwx_9yq_ad7","status":"source_identified"},{"id":"c-shiji-004-zhou:m018-0004","start":4,"end":6,"surface":"祿父","kind":"person","person_id":"lwx_9yq_ad7_A","status":"source_identified"},{"id":"c-shiji-004-zhou:m018-0011","start":11,"end":13,"surface":"武王","kind":"person","person_id":"y4i_pjk_4gn_AA","status":"source_identified"},{"id":"c-shiji-004-zhou:m018-0024","start":24,"end":27,"surface":"管叔鮮","kind":"person","person_id":"y4i_pjk_4gn_AB","status":"source_identified"},{"id":"c-shiji-004-zhou:m018-0028","start":28,"end":31,"surface":"蔡叔度","kind":"person","person_id":"y4i_pjk_4gn_AC","status":"source_identified"},{"id":"c-shiji-004-zhou:m018-0032","start":32,"end":34,"surface":"祿父","kind":"person","person_id":"lwx_9yq_ad7_A","status":"source_identified"},{"id":"c-shiji-004-zhou:m018-0040","start":40,"end":42,"surface":"召公","kind":"person","person_id":"7m7_qvm_4oj","status":"source_identified"},{"id":"c-shiji-004-zhou:m018-0043","start":43,"end":45,"surface":"箕子","kind":"person","person_id":"8a9_tj8_6i7","status":"source_identified"},{"id":"c-shiji-004-zhou:m018-0049","start":49,"end":51,"surface":"畢公","kind":"person","person_id":"ngh_196_gz6","status":"source_identified"},{"id":"c-shiji-004-zhou:m018-0058","start":58,"end":60,"surface":"商容","kind":"person","pe