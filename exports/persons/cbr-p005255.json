{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p005255","identity_policy":"contextual_provisional","person_ids":["cbr-p005255"],"persons":[{"id":"cbr-p005255","label":"李由（樊酈滕灌列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"李由","mention_ids":["c-shiji-095-fankuang:m002-0127","c-shiji-095-fankuang:m017-0091"]}],"evidence":[{"mention_id":"c-shiji-095-fankuang:m002-0127","chapter_id":"c-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p002","quote":"李由"},{"mention_id":"c-shiji-095-fankuang:m017-0091","chapter_id":"c-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p017","quote":"李由"}]}],"mentions":[{"id":"c-shiji-095-fankuang:m002-0127","start":127,"end":129,"surface":"李由","kind":"person","person_id":"cbr-p005255","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p002","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:m017-0091","start":91,"end":93,"surface":"李由","kind":"person","person_id":"cbr-p005255","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p017","chapter_id":"c-shiji-095-fankuang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji095-005","person_id":"cbr-p005255","surfaces":["李由"],"scope":"same_chapter","chapter_ids":["c-shiji-095-fankuang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-095-fankuang:p002","quote":"初從高祖起豐，攻下沛。高祖為沛公，以噲為舍人。從攻胡陵、方與，還守豐，擊泗水監豐下，破之。復東定沛，破泗水守薛西。與司馬夷戰碭東，卻敵，斬首十五級，賜爵國大夫。常從，沛公擊章邯軍濮陽，攻城先登，斬首二十三級，賜爵列大夫。復常從，從攻城陽，先登。下戶牖，破李由軍，斬首十六級，賜上閒爵。從攻圍東郡守尉於成武，卻敵，斬首十四級，捕虜十一人，賜爵五大夫。從擊秦軍，出亳南。河閒守軍於杠里，破之。擊破趙賁軍開封北，以卻敵先登，斬候一人，首六十八級，捕虜二十七人，賜爵卿。從攻破楊熊軍於曲遇。攻宛陵，先登，斬首八級，捕虜四十四人，賜爵封號賢成君。從攻長社、轘轅，絕河津，東攻秦軍於尸，南攻秦軍於犨。破南陽守齮於陽城。東攻宛城，先登。西至酈，以卻敵，斬首二十四級，捕虜四十人，賜重封。攻武關，至霸上，斬都尉一人，首十級，捕虜百四十六人，降卒二千九百人。"},{"paragraph_id":"c-shiji-095-fankuang:p017","quote":"高祖之初與徒屬欲攻沛也，嬰時以縣令史為高祖使。上降沛一日，高祖為沛公，賜嬰爵七大夫，以為太僕。從攻胡陵，嬰與蕭何降泗水監平，平以胡陵降，賜嬰爵五大夫。從擊秦軍碭東，攻濟陽，下戶牖，破李由軍雍丘下，以兵車趣攻戰疾，賜爵執帛。常以太僕奉車從擊章邯軍東阿、濮陽下，以兵車趣攻戰疾，破之，賜爵執珪。復常奉車從擊趙賁軍開封，楊熊軍曲遇。嬰從捕虜六十八人，降卒八百五十人，得印一匱。因復常奉車從擊秦軍雒陽東，以兵車趣攻戰疾，賜爵封轉為滕公。因復奉車從攻南陽，戰於藍田、芷陽，以兵車趣攻戰疾，至霸上。項羽至，滅秦，立沛公為漢王。漢王賜嬰爵列侯，號昭平侯，復為太僕，從入蜀、漢。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定異稱。酈寄字況據第14段；夏侯嬰的嬰限定第16至21段，灌嬰限定第22至33段，桓嬰另人。第6與20、28段楚王信和反韓王信分人；未詳名王侯不補名。同名跨篇同指另待逐項證據。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-095-fankuang:p002","text":"初從高祖起豐，攻下沛。高祖為沛公，以噲為舍人。從攻胡陵、方與，還守豐，擊泗水監豐下，破之。復東定沛，破泗水守薛西。與司馬夷戰碭東，卻敵，斬首十五級，賜爵國大夫。常從，沛公擊章邯軍濮陽，攻城先登，斬首二十三級，賜爵列大夫。復常從，從攻城陽，先登。下戶牖，破李由軍，斬首十六級，賜上閒爵。從攻圍東郡守尉於成武，卻敵，斬首十四級，捕虜十一人，賜爵五大夫。從擊秦軍，出亳南。河閒守軍於杠里，破之。擊破趙賁軍開封北，以卻敵先登，斬候一人，首六十八級，捕虜二十七人，賜爵卿。從攻破楊熊軍於曲遇。攻宛陵，先登，斬首八級，捕虜四十四人，賜爵封號賢成君。從攻長社、轘轅，絕河津，東攻秦軍於尸，南攻秦軍於犨。破南陽守齮於陽城。東攻宛城，先登。西至酈，以卻敵，斬首二十四級，捕虜四十人，賜重封。攻武關，至霸上，斬都尉一人，首十級，捕虜百四十六人，降卒二千九百人。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m002-0002","start":2,"end":4,"surface":"高祖","kind":"person","person_id":"cbr-p005253","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m002-0011","start":11,"end":13,"surface":"高祖","kind":"person","person_id":"cbr-p005253","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m002-0014","start":14,"end":16,"surface":"沛公","kind":"person","person_id":"cbr-p005253","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m002-0018","start":18,"end":19,"surface":"噲","kind":"person","person_id":"cbr-p005252","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m002-0058","start":58,"end":61,"surface":"司馬夷","kind":"person","person_id":"cbr-p005251","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m002-0083","start":83,"end":85,"surface":"沛公","kind":"person","person_id":"cbr-p005253","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m002-0086","start":86,"end":88,"surface":"章邯","kind":"person","person_id":"cbr-p005254","status":"contextual_provisional"},{"id":"c-shiji-095-f