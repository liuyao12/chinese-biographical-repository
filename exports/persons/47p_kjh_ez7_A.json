ty_note":"《南史》卷二十二明載齊高帝女、王彬（字思文）妻，未載私名。","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"47p_kjh_ez7","source_assertion_id":"a-nanshi022-wangbin-digital-174-54","evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-022","chapter_id":"c-nanshi-022-wangbin-digital","source_id":"s-nanshi-022-wangbin-digital-ws1477957","paragraph_id":"c-nanshi-022-wangbin-digital:p001","quote":"彬字思文，好文章，習篆隸，與志齊名。時人為之語曰：「三真六草，為天下寶。」齊武帝起舊宮，彬獻賦，文辭典麗。尚齊高帝女臨海長公主，拜駙馬都尉。仕齊，曆太子中庶子，徙永嘉太守。卜室于積穀山，有終焉之志。梁天監中，曆吏部尚書、秘書監。卒，諡惠。彬立身清白，推賢接士，有士君子風。彬弟寂。","subject_person_mention_id":"c-nanshi-022-wangbin-digital:p001:m0058","object_person_mention_id":"c-nanshi-022-wangbin-digital:p001:m0054","relationship_anchor":{"paragraph_id":"c-nanshi-022-wangbin-digital:p001","start":54,"end":63,"surface":"齊高帝女臨海長公主"}}],"status":"contextual_provisional","human_reviewed":false,"interpretation_note":"明稱齊高帝女，未列排行。"}},{"id":"7r6_k52_qji_ABAAAAEBD","label":"王彬（字思文）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"彬","mention_ids":["c-nanshi-022-wangbin-digital:p001:m0000","c-nanshi-022-wangbin-digital:p001:m0044","c-nanshi-022-wangbin-digital:p001:m0119","c-nanshi-022-wangbin-digital:p001:m0136"]},{"surface":"思文","mention_ids":["c-nanshi-022-wangbin-digital:p001:m0002"]}],"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-022","chapter_id":"c-nanshi-022-wangbin-digital","source_id":"s-nanshi-022-wangbin-digital-ws1477957","paragraph_id":"c-nanshi-022-wangbin-digital:p001","quote":"彬","mention_id":"c-nanshi-022-wangbin-digital:p001:m0000"},{"work_id":"w-nanshi","book_id":"b-nanshi-022","chapter_id":"c-nanshi-022-wangbin-digital","source_id":"s-nanshi-022-wangbin-digital-ws1477957","paragraph_id":"c-nanshi-022-wangbin-digital:p001","quote":"思文","mention_id":"c-nanshi-022-wangbin-digital:p001:m0002"},{"work_id":"w-nanshi","book_id":"b-nanshi-022","chapter_id":"c-nanshi-022-wangbin-digital","source_id":"s-nanshi-022-wangbin-digital-ws1477957","paragraph_id":"c-nanshi-022-wangbin-digital:p001","quote":"彬","mention_id":"c-nanshi-022-wangbin-digital:p001:m0044"},{"work_id":"w-nanshi","book_id":"b-nanshi-022","chapter_id":"c-nanshi-022-wangbin-digital","source_id":"s-nanshi-022-wangbin-digital-ws1477957","paragraph_id":"c-nanshi-022-wangbin-digital:p001","quote":"彬","mention_id":"c-nanshi-022-wangbin-digital:p001:m0119"},{"work_id":"w-nanshi","book_id":"b-nanshi-022","chapter_id":"c-nanshi-022-wangbin-digital","source_id":"s-nanshi-022-wangbin-digital-ws1477957","paragraph_id":"c-nanshi-022-wangbin-digital:p001","quote":"彬","mention_id":"c-nanshi-022-wangbin-digital:p001:m0136"}],"review":"ai_provisional","identity_note":"《南史》卷二十二王彬傳，字思文，王寂兄，尚齊高帝女臨海長公主。與東晉王彬（字世儒）分號。","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"7r6_k52_qji_ABAAAAEB","source_assertion_id":null,"parent_connection":{"type":"shared_father_through_siblings","sibling_assertion_ids":["a-nanshi022-wangbin-digital-174-136"],"sibling_father_assertion_id":"a-nanqi033-wangsengqian-016"},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-022","chapter_id":"c-nanshi-022-wangbin-digital","source_id":"s-nanshi-022-wangbin-digital-ws1477957","paragraph_id":"c-nanshi-022-wangbin-digital:p001","quote":"彬字思文，好文章，習篆隸，與志齊名。時人為之語曰：「三真六草，為天下寶。」齊武帝起舊宮，彬獻賦，文辭典麗。尚齊高帝女臨海長公主，拜駙馬都尉。仕齊，曆太子中庶子，徙永嘉太守。卜室于積穀山，有終焉之志。梁天監中，曆吏部尚書、秘書監。卒，諡惠。彬立身清白，推賢接士，有士君子風。彬弟寂。","subject_person_mention_id":"c-nanshi-022-wangbin-digital:p001:m0138","object_person_mention_id":"c-nanshi-022-wangbin-digital:p001:m0136","relationship_anchor":{"paragraph_id":"c-nanshi-022-wangbin-digital:p001","start":136,"end":139,"surface":"彬弟寂"},"source_assertion_id":"a-nanshi022-wangbin-digital-174-136","source_term":"彬弟寂"},{"work_id":"w-nanqishu","book_id":"b-nanqishu-033","source_id":"s-nanqishu-033-wangsengqian","chapter_id":"c-nanqishu-033-wangsengqian","paragraph_id":"c-nanqishu-033-wangsengqian:p014","quote":"其論書曰宋文帝書自云可比王子敬時議者云天然勝羊欣功夫少於欣王平南廙右軍叔過江之前以為最亡曽祖領軍書右軍云弟書遂不減吾變古制今唯右軍領軍不爾至今猶法鍾張亡從祖中書令書子敬云弟書如騎騾駸駸恒欲度驊騮前庾征西翼書少時與右軍齊名右軍後進庾猶不分在荆州與都下人書云小兒軰賤家雞皆學逸少書湏吾下當比之張翼王右軍自書表晉穆帝令翼寫題後答右軍當時不别久後方悟云小人㡬欲亂真張芝索靖韋誕鍾㑹二衛並得名前代無以辨其優劣唯見其筆力驚異耳張澄當時亦呼有意郗惜章草亞於右軍郗嘉賔草亞於二王緊媚其父桓𤣥自謂右軍之流論者以比孔琳之謝安亦入能書録亦自重為子敬書嵇康詩羊欣書見重一時親受子敬行書尤善正乃不稱名孔琳之書天然放縱極有筆力規矩恐在羊欣後丘道䕶與羊欣俱面受子敬故當在欣後范曅與蕭思話同師羊欣後小叛既失故歩為復小有意耳蕭思話書羊欣之影風流趣好殆當不減筆力恨弱謝綜書其舅云緊生起是得賞也恨少媚好謝靈運乃不倫遇其合時亦得入流賀道力書亞丘道䕶庾昕學右軍亦欲亂真矣又著書賦傳於世","object_person_mention_id":"c-nanqishu-033-wangsengqian:p014:m0000","source_assertion_id":"a-nanqi033-wangsengqian-016","source_term":"第九子寂"}],"status":"contextual_provisional","human_reviewed":false,"interpretation_note":"南史稱彬弟寂；南齊書稱寂王僧虔第九子。跨兩條原證暫接父支，無彬的明示排行。"}}],"source_mention_summary":[{"source_id":"s-nanshi-022-wangbin-digital-ws1477957","work_id":"w-nanshi","book_id":"b-nanshi-022","chapter_id":"c-nanshi-022-wangbin-digital","raw_mention_count":1,"mention_ids":["c-nanshi-022-wangbin-digital:p001:m0058"],"paragraph_ids":["c-nanshi-022-wangbin-digital:p001"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-nanshi-022-wangbin-digital:p001:m0058","mention_ids":["c-nanshi-022-wangbin-digital:p001:m0058"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-nanshi-022-wangbin-digital-ws1477957"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-nanshi022-wangbin-digital-174-53","subject_person_id":"7r6_k52_qji_ABAAAAEBD","object_person_id":"47p_kjh_ez7_A","pr