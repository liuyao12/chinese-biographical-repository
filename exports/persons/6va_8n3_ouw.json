rmalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-066-taokan:p008","text":"韜將王貢精卒三千，出武陵江，誘五溪夷，以舟師斷官運，徑向武昌。侃使鄭攀及伏波將軍陶延夜趣巴陵，潛師掩其不備，大破之，斬千餘級，降萬餘口。貢遁還湘城。賊中離阻，杜弢遂疑張奕而殺之，眾情益懼，降者滋多。王貢復挑戰，侃遙謂之曰：「杜弢為益州吏，盜用庫錢，父死不奔喪。卿本佳人，何為隨之也？天下寧有白頭賊乎！」貢初橫腳馬上，侃言訖，貢斂容下腳，辭色甚順。侃知其可動，復令諭之，截髮為信，貢遂來降。而韜敗走。進克長沙，獲其將毛寶、高寶、梁堪而還。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":43,"last_line":43,"raw_start":5074,"raw_end":5294,"raw_character_offsets":[5076,5077,5078,5079,5080,5081,5082,5083,5084,5085,5086,5087,5088,5089,5090,5091,5092,5093,5094,5095,5096,5097,5098,5099,5100,5101,5102,5103,5104,5105,5106,5107,5108,5109,5110,5111,5112,5113,5114,5115,5116,5117,5118,5119,5120,5121,5122,5123,5124,5125,5126,5127,5128,5129,5130,5131,5132,5133,5134,5135,5136,5137,5138,5139,5140,5141,5142,5143,5144,5145,5146,5147,5148,5149,5150,5151,5152,5153,5154,5155,5156,5157,5158,5159,5160,5161,5162,5163,5164,5165,5166,5167,5168,5169,5170,5171,5172,5173,5174,5175,5176,5177,5178,5179,5180,5181,5182,5183,5184,5185,5186,5187,5188,5189,5190,5191,5192,5193,5194,5195,5196,5197,5198,5199,5200,5201,5202,5203,5204,5205,5206,5207,5208,5209,5210,5211,5212,5213,5214,5215,5216,5217,5218,5219,5220,5221,5222,5223,5224,5225,5226,5227,5228,5229,5230,5231,5232,5233,5234,5235,5236,5237,5238,5239,5240,5241,5242,5243,5244,5245,5246,5247,5248,5249,5250,5251,5252,5253,5254,5255,5256,5257,5258,5259,5260,5261,5262,5263,5264,5265,5266,5267,5268,5269,5270,5271,5272,5273,5274,5275,5276,5277,5278,5279,5280,5281,5282,5283,5284,5285,5286,5287,5288,5289,5290,5291,5292,5293],"revision_id":1527632},"mentions":[{"id":"c-jinshu-066-taokan:p008:m0002","surface":"王貢","start":2,"end":4,"person_id":"1zq_her_sxc","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p008:m0031","surface":"侃","start":31,"end":32,"person_id":"twd_erg_kmz","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p008:m0033","surface":"鄭攀","start":33,"end":35,"person_id":"200_oqy_d7c","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p008:m0040","surface":"陶延","start":40,"end":42,"person_id":"lyc_yq1_blx","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p008:m0079","surface":"杜弢","start":79,"end":81,"person_id":"7dv_udy_955","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p008:m0083","surface":"張奕","start":83,"end":85,"person_id":"9u8_20z_zdq","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p008:m0099","surface":"王貢","start":99,"end":101,"person_id":"1zq_her_sxc","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p008:m0112","surface":"杜弢","start":112,"end":114,"person_id":"7dv_udy_955","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p008:m0207","surface":"毛寶","start":207,"end":209,"person_id":"d9b_790_9f0","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p008:m0210","surface":"高寶","start":210,"end":212,"person_id":"6va_8n3_ouw","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p008:m0213","surface":"梁堪","start":213,"end":215,"person_id":"1pl_dsu_hq6","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-066-taokan","book_id":"b-jinshu-066","work_id":"w-jinshu","source_id":"s-jinshu-066-taokan-ws1527632"},{"id":"c-jinshu-066-taokan:p012","text":"太興初，進號平南將軍，尋加都督交州軍事。及王敦舉兵反，詔侃以本官領江州刺史，尋轉都督、湘州刺史。敦得志，上侃復本職，加散騎常侍。時交州刺史王諒為賊梁碩所陷，侃遣將高寶進擊平之。以侃領交州刺史。錄前後功，封次子夏為都亭侯，進號征南大將軍、開府儀同三司。及王敦平，遷都督荊、雍、益、梁州諸軍事，領護南蠻校尉、征西大將軍、荊州刺史，余如故。楚郢士女莫不相慶。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":51,"last_line":51,"raw_start":5864,"raw_end":6042,"raw_character_offsets":[5866,5867,5868,5869,5870,5871,5872,5873,5874,5875,5876,5877,5878,5879,5880,5881,5882,5883,5884,5885,5886,5887,5888,5889,5890,5891,5892,5893,5894,5895,5896,5897,5898,5899,5900,5901,5902,5903,5904,5905,5906,5907,5908,5909,5910,5911,5912,5913,5914,5915,5916,5917,5918,5919,5920,5921,5922,5923,5924,5925,5926,5927,5928,5929,5930,5931,5932,5933,5934,5935,5936,5937,5938,5939,5940,5941,5942,5943,5944,5945,5946,5947,5948,5949,5950,5951,5952,5953,5954,5955,5956,5957,5958,5959,5960,5961,5962,5963,5964,5965,5966,5967,5968,5969,5970,5971,5972,5973,5974,5975,5976,5977,5978,5979,5980,5981,5982,5983,5984,5985,5986,5987,5988,5989,5990,5991,5992,5993,5994,5995,5996,5997,5998,5999,6000,6001,6002,6003,6004,6005,6006,6007,6008,6009,6010,6011,6012,6013,6014,6015,6016,6017,6018,6019,6020,6021,6022,6023,6024,6025,6026,6027,6028,6029,6030,6031,6032,6033,6034,6035,6036,6037,6038,6039,6040,6041],"revision_id":1527632},"mentions":[{"id":"c-jinshu-066-taokan:p012:m0021","surface":"王敦","start":21,"end":23,"person_id":"39o_b6y_n74","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p012:m0028","surface":"侃","start":28,"end":29,"person_id":"twd_erg_kmz","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p012:m0069","surface":"王諒","start":69,"end":71,"person_id":"t48_v4e_tjf","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p012:m0073","surface":"梁碩","start":73,"end":75,"person_id":"wpp_5do_1oy","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p012:m0081","surface":"高寶","start":81,"end":83,"person_id":"6va_8n3_ouw","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p012:m0104","surface":"夏","start":104,"end":105,"person_id":"cgr_q7b_cos","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p012:m0126","surface":"王敦","start":126,"end":128,"person_id":"39o_b6y_n74","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-066-taokan","book_id":"b-jinshu-066","work_id":"w-jinshu","source_id":"s-jinshu-066-taokan-ws1527632"},{"id":"c-jinshu-070-ganzhuo:p007","text":"時敦以卓不至，慮在後爲變，遣參軍樂道融苦要卓俱下。道融本欲背敦，因說卓襲之，語在融傳。卓既素不欲從敦，得道融說，遂決曰：「吾本意也。」乃與巴東監軍柳純、南平太守夏侯承、宜都太守譚該等十餘人，俱露檄遠近，陳敦肆逆，率所統致討。遣參軍司馬讚、孫雙奉表詣臺，參軍羅英至廣州，與陶侃剋期，參軍鄧騫、虞沖至長沙，令譙王承堅守。征西將軍戴若思在江西，先得卓書，表上之，臺內皆稱萬歲。武昌大驚，傳卓軍至，人皆奔散。詔書遷卓爲鎮南大將軍、侍中、都督荊梁二州諸軍事、荊州牧，梁州刺史如故，陶侃得卓信，即遣參軍高寶率兵下。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":48,"last_line":48,"raw_start":4516,"raw_end":4774,"raw_character_offsets":[4523,4524,4525,4526,4527,4528,4529,4530,4531,4532,4533,4534,4535,4536,4537,4538,4539,4540,4541,4542,4543,4544,4545,4546,4547,4548,4549,4550,4551,4552,4553,4554,4555,4556,4557,4558,4559,4560,4561,4562,4563,4564,4565,4566,4567,4568,4569,4570,4571,4572,4573,4574,4575,4576,4577,4578,4579,4580,4581,4582,4583,4584,4585,4586,4587,4588,4589,4590,4591,4592,4593,4594,4595,4596,4597,4598,4599,4600,4601,4602,4603,4604,4605,4606,4607,4608,4609,4610,4611,4612,4613,4614,4615,4616,4617,4618,4619,4620,4621,4622,4623,4624,4625,4626,4627,4628,4629,4630,4631,4632,4633,4634,4635,4636,4637,4638,4639,4640,4641,4642,4643,4644,4645,4646,4647,4648,4649,4650,4651,4652,4653,4654,4655,4656,4657,4658,4659,4660,4661,4662,4663,4664,4665,4666,4667,4668,4669,4670,4671,4672,4673,4674,4675,4676,4677,4678,4679,4680,4681,4682,4683,4684,4685,4686,4687,4688,4689,4690,4691,4692,4693,4694,4695,4696,4697,4698,4699,4700,4701,4702,4703,4704,4705,4706,4707,4708,4709,4710,4711,4712,4713,4714,4715,4716,4717,4718,4719,4720,4721,4722,4723,4724,4725,4726,4727,4728,4729,4730,4731,4732,4733,4734,4735,4736,4737,4738,4739,4740,4741,4742,4743,4744,4745,4746,4747,4748,4749,4750,4751,4752,4753,4754,4755,4756,4757,4758,4759,4760,4761,4762,4763,4764,4765,4766,4767,4768,4769,4770,4771,4772,4773],"revision_id":2595540},"mentions":[{"id":"c-jinshu-070-ganzhuo:p007:m0016","surface":"樂道融","start":16,"end":19,"person_id":"bqd_2sl_nhe","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-070-ganzhuo:p007:m0073","surface":"柳純","start":73,"end":75,"person_id":"xzj_9xb_s9b",