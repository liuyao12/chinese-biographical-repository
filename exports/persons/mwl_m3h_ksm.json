焉。酣宴縱誕，窮歡極娛。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-043-wangcheng:line118:m0007","start":7,"end":11,"surface":"成都王穎","kind":"person","person_id":"e81_f09_000","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line118:m0016","start":16,"end":17,"surface":"穎","kind":"person","person_id":"e81_f09_000","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line118:m0019","start":19,"end":21,"surface":"孟玖","kind":"person","person_id":"bmo_6e2_cfl","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line118:m0023","start":23,"end":25,"surface":"陸機","kind":"person","person_id":"69h_uhy_hta","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line118:u0025","start":25,"end":27,"surface":"兄弟","kind":"unresolved","person_id":null,"status":"unresolved","unresolved_kind":"unresolved_source_person","interpretation_note":"此處以兄弟統稱同遭誅者，字面未列個別弟名。"},{"id":"c-jinshu-043-wangcheng:line118:m0033","start":33,"end":34,"surface":"澄","kind":"person","person_id":"rlk_lzd_86c","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line118:m0035","start":35,"end":36,"surface":"玖","kind":"person","person_id":"bmo_6e2_cfl","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line118:m0040","start":40,"end":41,"surface":"穎","kind":"person","person_id":"e81_f09_000","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line118:m0042","start":42,"end":43,"surface":"玖","kind":"person","person_id":"bmo_6e2_cfl","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line118:m0044","start":44,"end":45,"surface":"穎","kind":"person","person_id":"e81_f09_000","status":"contextual_provisional","interpre