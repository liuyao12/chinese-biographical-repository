ime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-079-fancai:m006-0033","start":33,"end":35,"surface":"湣王","kind":"person","person_id":"zzu_ykb_79u","status":"contextual_provisional","paragraph_id":"c-shiji-079-fancai:p006","chapter_id":"c-shiji-079-fancai"},{"id":"c-shiji-079-fancai:m015-0121","start":121,"end":124,"surface":"齊湣王","kind":"person","person_id":"zzu_ykb_79u","status":"contextual_provisional","paragraph_id":"c-shiji-079-fancai:p015","chapter_id":"c-shiji-079-fancai"},{"id":"c-shiji-079-fancai:m015-0197","start":197,"end":198,"surface":"王","kind":"person","person_id":"zzu_ykb_79u","status":"contextual_provisional","paragraph_id":"c-shiji-079-fancai:p015","chapter_id":"c-shiji-079-fancai"},{"id":"c-shiji-079-fancai:m015-0210","start":210,"end":211,"surface":"王","kind":"person","person_id":"zzu_ykb_79u","status":"contextual_provisional","paragraph_id":"c-shiji-079-fancai:p015","chapter_id":"c-shiji-079-fancai"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji079-017","person_id":"zzu_ykb_79u","surfaces":["湣王","王","齊湣王"],"scope":"same_chapter","chapter_ids":["c-shiji-079-fancai"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-079-fancai:p006","quote":"當是時，昭王已立三十六年。南拔楚之鄢郢，楚懷王幽死於秦。秦東破齊。湣王嘗稱帝，後去之。數困三晉。厭天下辯士，無所信。"},{"paragraph_id":"c-shiji-079-fancai:p015","quote":"然左右多竊聽者，范睢恐，未敢言內，先言外事，以觀秦王之俯仰。因進曰：「夫穰侯越韓、魏而攻齊綱壽，非計也。少出師則不足以傷齊，多出師則害於秦。臣意王之計，欲少出師而悉韓、魏之兵也，則不義矣。今見與國之不親也，越人之國而攻，可乎？其於計疏矣。且昔齊湣王南攻楚，破軍殺將，再辟地千里，而齊尺寸之地無得焉者，豈不欲得地哉，形勢不能有也。諸侯見齊之罷獘，君臣之不和也，興兵而伐齊，大破之。士辱兵頓，皆咎其王，曰：『誰為此計者乎？』王曰：『文子為之。』大臣作亂，文子出走。攻齊所以大破者，以其伐楚而肥韓、魏也。此所謂借賊兵而齎盜糧者也。王不如遠交而近攻，得寸則王之寸也，得尺亦王之尺也。今釋此而遠攻，不亦繆乎！且昔者中山之國地方五百里，趙獨吞之，功成名立而利附焉，天下莫之能害也。今夫韓、魏，中國之處而天下之樞也，王其欲霸，必親中國以為天下樞，以威楚、趙。楚彊則附趙，趙彊則附楚，楚、趙皆附，齊必懼矣。齊懼，必卑辭重幣以事秦。齊附而韓、魏因可虜也。」昭王曰：「吾欲親魏久矣，而魏多變之國也，寡人不能親。請問親魏柰何？」對曰：「王卑詞重幣以事之；不可，則割地而賂之；不可，因舉兵而伐之。」王曰：「寡人敬聞命矣。」乃拜范睢為客卿，謀兵事。卒聽范睢謀，使五大夫綰伐魏，拔懷。後二歲，拔邢丘。"}],"rationale":"按全35段明示姓名與局部引語暫接，范睢張祿范叔范君應侯分說話範圍；蔡澤先生綱成君依具體敘事。越王事大夫種與句踐敘事相配，更新候選標籤保留ID。馬服／馬服子依同段長平角色暫接未補姓名，白公仍未定，韓子未強接韓非，喬松不補神仙，范中行族稱不接范睢。王之弟、改讀前止足及引古異說各留，預言與擬議方案不當史實核定。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-079-fancai:p006","text":"當是時，昭王已立三十六年。南拔楚之鄢郢，楚懷王幽死於秦。秦東破齊。湣王嘗稱帝，後去之。數困三晉。厭天下辯士，無所信。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-079-fancai:m006-0004","start":4,"end":6,"surface":"昭王","kind":"person","person_id":"cn8_id5_95v","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m006-0020","start":20,"end":23,"surface":"楚懷王","kind":"person","person_id":"edg_w12_1tw","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m006-0033","start":33,"end":35,"surface":"湣王","kind":"person","person_id":"zzu_ykb_79u","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m006-0051","start":51,"end":53,"surface":"辯士","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名角色或泛論保存，文武合稱不補個人錨點；韓盧犬喻不當人物，王者泛論不套秦昭王。"}],"chapter_id":"c-shiji-079-fancai","book_id":"b-shiji-079","work_id":"w-shiji","source_id":"s-shiji-079-fancai"},{"id":"c-shiji-079-fancai:p015","text":"然左右多竊聽者，范睢恐，未敢言內，先言外事，以觀秦王之俯仰。因進曰：「夫穰侯越韓、魏而攻齊綱壽，非計也。少出師則不足以傷齊，多出師則害於秦。臣意王之計，欲少出師而悉韓、魏之兵也，則不義矣。今見與國之不親也，越人之國而攻，可乎？其於計疏矣。且昔齊湣王南攻楚，破軍殺將，再辟地千里，而齊尺寸之地無得焉者，豈不欲得地哉，形勢不能有也。諸侯見齊之罷獘，君臣之不和也，興兵而伐齊，大破之。士辱兵頓，皆咎其王，曰：『誰為此計者乎？』王曰：『文子為之。』大臣作亂，文子出走。攻齊所以大破者，以其伐楚而肥韓、魏也。此所謂借賊兵而齎盜糧者也。王不如遠交而近攻，得寸則王之寸也，得尺亦王之尺也。今釋此而遠攻，不亦繆乎！且昔者中山之國地方五百里，趙獨吞之，功成名立而利附焉，天下莫之能害也。今夫韓、魏，中國之處而天下之樞也，王其欲霸，必親中國以為天下樞，以威楚、趙。楚彊則附趙，趙彊則附楚，楚、趙皆附，齊必懼矣。齊懼，必卑辭重幣以事秦。齊附而韓、魏因可虜也。」昭王曰：「吾欲親魏久矣，而魏多變之國也，寡人不能親。請問親魏柰何？」對曰：「王卑詞重幣以事之；不可，則割地而賂之；不可，因舉兵而伐之。」王曰：「寡人敬聞命矣。」乃拜范睢為客卿，謀兵事。卒聽范睢謀，使五大夫綰伐魏，拔懷。後二歲，拔邢丘。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-079-fancai:m015-0001","start":1,"end":3,"surface":"左右","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名角