i-122-kuli:p003","chapter_id":"c-shiji-122-kuli"},{"id":"c-shiji-122-kuli:m010-0035","start":35,"end":37,"surface":"孝文","kind":"person","person_id":"9gv_44u_szv","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p010","chapter_id":"c-shiji-122-kuli"},{"id":"c-shiji-122-kuli:m019-0075","start":75,"end":78,"surface":"孝文帝","kind":"person","person_id":"9gv_44u_szv","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p019","chapter_id":"c-shiji-122-kuli"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-122-kuli:p003","text":"郅都者，楊人也。以郎事孝文帝。孝景時，都爲中郎將，敢直諫，面折大臣於朝。嘗從入上林，賈姬如廁，野彘卒入廁。上目都，都不行。上欲自持兵救賈姬，都伏上前曰：「亡一姬復一姬進，天下所少寧賈姬等乎？陛下縱自輕，柰宗廟太后何！」上還，彘亦去。太后聞之，賜都金百斤，由此重郅都。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-122-kuli:m003-0000","start":0,"end":2,"surface":"郅都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m003-0011","start":11,"end":14,"surface":"孝文帝","kind":"person","person_id":"9gv_44u_szv","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m003-0015","start":15,"end":17,"surface":"孝景","kind":"person","person_id":"av9_5kt_rys","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m003-0019","start":19,"end":20,"surface":"都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m003-0031","start":31,"end":33,"surface":"大臣","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m003-0042","start":42,"end":44,"surface":"賈姬","kind":"person","person_id":"hm5_fxv_gts","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m003-0053","start":53,"end":54,"surface":"上","kind":"person","person_id":"av9_5kt_rys","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m003-0055","start":55,"end":56,"surface":"都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m003-0057","start":57,"end":58,"surface":"都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m003-0061","start":61,"end":62,"surface":"上","kind":"person","person_id":"av9_5kt_rys","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m003-0067","start":67,"end":69,"surface":"賈姬","kind":"person","person_id":"hm5_fxv_gts","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m003-0070","start":70,"end":71,"surface":"都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m003-0072","start":72,"end":73,"surface":"上","kind":"person","person_id":"av9_5kt_rys","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m003-0090","start":90,"end":92,"surface":"賈姬","kind":"person","person_id":"hm5_fxv_gts","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m003-0095","start":95,"end":97,"surface":"陛下","kind":"person","person_id":"av9_5kt_rys","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m003-0104","start":104,"end":106,"surface":"太后","kind":"person","person_id":"zcn_zyw_flp","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m003-0109","start":109,"end":110,"surface":"上","kind":"person","person_id":"av9_5kt_rys","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m003-0116","start":116,"end":118,"surface":"太后","kind":"person","person_id":"zcn_zyw_flp","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m003-0122","start":122,"end":123,"surface":"都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m003-0130","start":130,"end":132,"surface":"郅都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"}],"chapter_id":"c-shiji-122-kuli","book_id":"b-shiji-122","work_id":"w-shiji","source_id":"s-shiji122-kuli"},{"id":"c-shiji-122-kuli:p010","text":"周陽由者，其父趙兼以淮南王舅父侯周陽，故因姓周陽氏。由以宗家任爲郎，事孝文及景帝。景帝時，由爲郡守。武帝卽位，吏治尚循謹甚，然由居二千石中，最爲暴酷驕恣。所愛者，撓法活之；所憎者，曲法誅滅之。所居郡，必夷其豪。爲守，視都尉如令。爲都尉，必陵太守，奪之治。與汲黯倶爲忮，司馬安之文惡，倶在二千石列，同車未嘗敢均茵伏。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-122-kuli:m010-0000","start":0,"end":3,"surface":"周陽由","kind":"person","person_id":"xgx_g4a_c28_A","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m010-0007","start":7,"end":9,"surface":"趙兼","kind":"person","person_id":"xgx_g4a_c28","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m010-0010","start":10,"end":13,"surface":"淮南王","kind":"person","person_id":"g0j_yhl_z02","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m010-0022","start":22,"end":25,"surface":"周陽氏","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m010-0026","start":26,"end":27,"surface":"由","kind":"person","person_id":"xgx_g4a_c28_A","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m010-0028","start":28,"end":30,"surface":"宗家","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m010-0035","start":35,"end":37,"surface":"孝文","kind":"person","person_id":"9gv_44u_szv","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m010-0038","start":38,"end":40,"surface":"景帝","kind":"person","person_id":"av9_5kt_rys","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m010-0041","start":41,"end":43,"surface":"景帝","kind":"person","person_id":"av9_5kt_rys","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m010-0045","start":45,"end":46,"surface":"由","kind":"person","person_id":"xgx_g4a_c28_A","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m010-0050","start":50,"end":52,"surface":"武帝","kind":"person","person_id":"ln1_tyi_kei","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m010-0063","start":63,"end":64,"surface":"由","kind":"person","person_id":"xgx_g4a_c28_A","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m010-0128","start":128,"end":130,"surface":"汲黯","kind":"person","person_id":"9u7_1oo_f9u","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m010-0134","start":134,"end":137,"surface":"司馬安","kind":"person","person_id":"40l_mfp_yr6","status":"contextual_provisional"}],"chapter_id":"c-shiji-122-kuli","book_id":"b-shiji-122","work_id":"w-shiji","source_id":"s-shiji122-kuli"},{"id":"c-shiji-122-kuli:p019","text":"匈奴來請和親，群臣議上前。博士狄山曰：「和親便。」上問其便，山曰：「兵者凶器，未易數動。髙帝欲伐匈奴，大困平城，乃遂結和親。孝惠、髙后時，天下安樂。及孝文帝欲事匈奴，北邊蕭然苦兵矣。孝景時，呉楚七國反，景帝往來兩宮閒，寒心者數月。呉楚已破，竟景帝不言兵，天下富實。今自陛下舉兵撃匈奴，中國以空虚，邊民大困貧。由此觀之，不如和親。」上問湯，湯曰：「此愚儒，無知。」狄山曰：「臣固愚忠，若御史大夫湯乃詐忠。若湯之治淮南、江都，以深文痛詆諸侯，別疎骨肉，使蕃臣不自安。臣固知湯之爲詐忠。」於是上作色曰：「吾使生居一郡，能無使虜入盜乎？」曰：「不能。」曰：「居一縣？」對曰：「不能。」復曰：「居一障閒？」山自度辯窮且下吏，曰：「能。」於是上遣山乘鄣。至月餘，匈奴斬山頭而去。自是以後，群臣震慴。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-122-kuli:m019-0000","start":0,"end":2,"surface":"匈奴","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m019-0007","start":7,"end":9,"surface":"群臣","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m019-0010","start":10,"end":11,"surface":"上","kind":"person","person_id":"ln1_tyi_kei","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m019-0015","start":15,"end":17,"surface":"狄山","kind":"person","person_id":"8t3_qf9_2if","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m019-0025","start":25,"end":26,"surface":"上","kind":"person","person_id":"ln1_tyi_kei","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m019-0030","start":30,"end":31,"surface":"山","kind":"person","person_id":"8t3_qf9_2if","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m019-0044","start":44,"end":46,"surface":"髙帝","kind":"person","person_id":"glp_y7r_wy4","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m019-0048","start":48,"end":50,"surface":"匈奴","kind":"unresolved","person_id":null,"status":"unresolved