_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-060-qianxiu:p002:m0050","surface":"王粹","start":50,"end":52,"person_id":"imv_t2i_9ae","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-060-qianxiu:p002","chapter_id":"c-jinshu-060-qianxiu"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-060-qianxiu:p002","text":"秀任氣，好為將帥。張昌作亂，長沙王乂遣秀討昌，秀出關，因奔成都王穎。穎伐乂，以秀為冠軍將軍，與陸機、王粹等共為河橋之役。機戰敗，秀證成其罪，又諂事黃門孟玖，故見親於穎。惠帝西幸長安，以秀為尚書。秀少在京輦，見司隸劉毅奏事而扼腕慷慨，自謂居司直之任，當能激濁揚清；處鼓鞞之間，必建將帥之勳。及在常伯納言，亦未曾有規獻弼違之奇也。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":32,"last_line":32,"raw_start":2129,"raw_end":2294,"raw_character_offsets":[2131,2132,2133,2134,2135,2136,2137,2138,2139,2140,2141,2142,2143,2144,2145,2146,2147,2148,2149,2150,2151,2152,2153,2154,2155,2156,2157,2158,2159,2160,2161,2162,2163,2164,2165,2166,2167,2168,2169,2170,2171,2172,2173,2174,2175,2176,2177,2178,2179,2180,2181,2182,2183,2184,2185,2186,2187,2188,2189,2190,2191,2192,2193,2194,2195,2196,2197,2198,2199,2200,2201,2202,2203,2204,2205,2206,2207,2208,2209,2210,2211,2212,2213,2214,2215,2216,2217,2218,2219,2220,2221,2222,2223,2224,2225,2226,2227,2228,2229,2230,2231,2232,2233,2234,2235,2236,2237,2238,2239,2240,2241,2242,2243,2244,2245,2246,2247,2248,2249,2250,2251,2252,2253,2254,2255,2256,2257,2258,2259,2260,2261,2262,2263,2264,2265,2266,2267,2268,2269,2270,2271,2272,2273,2274,2275,2276,2277,2278,2279,2280,2281,2282,2283,2284,2285,2286,2287,2288,2289,2290,2291,2292,2293],"revision_id":2413335},"mentions":[{"id":"c-jinshu-060-qianxiu:p002:m0000","surface":"秀","start":0,"end":1,"person_id":"6uy_inn_u8g","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-qianxiu:p002:m0009","surface":"張昌","start":9,"end":11,"person_id":"3sv_fgo_jtc","kind