4-wangsiyuan-older-xuan"],"sibling_father_assertion_id":"a-nanshi024-wangsiyuan-siyuan-father"},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-024","source_id":"s-nanshi-024-wangsiyuan-ws1765279","chapter_id":"c-nanshi-024-wangsiyuan","paragraph_id":"c-nanshi-024-wangsiyuan:p001","quote":"思遠，晏從父弟也。父羅雲，平西長史。思遠八歳父卒，祖弘之及外祖新安太守羊敬元並棲退高尚，故思遠少無仕心。宋建平王景素辟南徐州主簿，深見禮遇。景素被誅，左右離散，思遠親視殯葬，手種松柏，與廬江何昌宇、沛郡劉璡上表理之，事感朝廷。景素女廢爲庶人，思遠分衣食以相資贍。年長，爲備笄總，訪求素對，傾家送遣。","subject_person_mention_id":"c-nanshi-024-wangsiyuan:p001:m0000","object_person_mention_id":"c-nanshi-024-wangsiyuan:p001:m0010","source_assertion_id":"a-nanshi024-wangsiyuan-siyuan-father","source_term":"父羅雲"},{"work_id":"w-nanshi","book_id":"b-nanshi-024","source_id":"s-nanshi-024-wangsiyuan-ws1765279","chapter_id":"c-nanshi-024-wangsiyuan","paragraph_id":"c-nanshi-024-wangsiyuan:p002","quote":"齊建元初，曆竟陵王司徒録事參軍、太子中舍人。文惠太子與竟陵王子良素好士，並蒙賞接。思遠求出爲遠郡，除建安內史。長兄思玄卒，思遠友于甚至，表乞自解，不許。及祥日又固陳，武帝乃許之。仍除中書郎、大司馬諮議。詔舉士，竟陵王子良薦思遠及呉郡顧暠之、陳郡殷叡。時邵陵王子貞爲呉郡，除思遠爲呉郡丞，以本官行郡事，論者以爲得人。後拜御史中丞。臨海太守沈昭略贓私，思遠依事劾奏，明帝及思遠從兄晏、昭略叔父文季並請止之，思遠不從，案事如故。","subject_person_mention_id":"c-nanshi-024-wangsiyuan:p002:m0057","object_person_mention_id":"c-nanshi-024-wangsiyuan:p002:m0061","source_assertion_id":"a-nanshi024-wangsiyuan-older-xuan","source_term":"長兄思玄"}],"status":"contextual_provisional","interpretation_note":"具名父子與兄弟原句相接，各條另存。","human_reviewed":false}}],"source_mention_summary":[{"source_id":"s-nanshi-024-wangsiyuan-ws1765279","work_id":"w-nanshi","book_id":"b-nanshi-024","chapter_id":"c-nanshi-024-wangsiyuan","raw_mention_count":1,"mention_ids":["c-nanshi-024-wangsiyuan:p002:m0057"],"paragraph_ids":["c-nanshi-024-wangsiyuan:p002"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-nanshi-024-wangsiyuan:p002:m0057","mention_ids":["c-nanshi-024-wangsiyuan:p002:m0057"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_