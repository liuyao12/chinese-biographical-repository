extual_provisional"},{"id":"c-shiji-005-qin:m050-0046","start":46,"end":48,"surface":"簡公","kind":"person","person_id":"cbr-p000443","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m050-0049","start":49,"end":51,"surface":"昭子","kind":"person","person_id":"cbr-p000441","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m050-0054","start":54,"end":56,"surface":"懷公","kind":"person","person_id":"cbr-p000439","status":"contextual_provisional"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-005-qin:p053","text":"出子二年，庶長改迎靈公之子獻公于河西而立之。殺出子及其母，沈之淵旁。秦以往者數易君，君臣乖亂，故晉復彊，奪秦河西地。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m053-0000","start":0,"end":2,"surface":"出子","kind":"person","person_id":"cbr-p000445","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m053-0005","start":5,"end":8,"surface":"庶長改","kind":"person","person_id":"cbr-p000446","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m053-0009","start":9,"end":11,"surface":"靈公","kind":"person","person_id":"cbr-p000442","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m053-0013","start":13,"end":15,"surface":"獻公","kind":"person","person_id":"cbr-p000287","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m053-0023","start":23,"end":25,"surface":"出子","kind":"person","person_id":"cbr-p000445","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m053-0026","start":26,"end":28,"surface":"其母","kind":"unresolved","person_id":null,"status":"unresolved","note":"未定指代、群體或官稱；商君語為篇章指引，不當作獨立個人。"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-005-qin:p054","text":"獻公元年，止從死。二年，城櫟陽。四年正月庚寅，孝公生。十一年，周太史儋見獻公曰：「周故與秦國合而別，別五百歲復合，合（七）十七歲而霸王出。」十六年，桃冬花。十八年，雨金櫟陽。二十一年，與晉戰於石門，斬首六萬，天子賀以黼黻。二十三年，與魏晉戰少梁，虜其將公孫痤。二十四年，獻公卒，子孝公立，年已二十一歲矣。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m054-0000","start":0,"end":2,"surface":"獻公","kind":"person","person_id":"cbr-p000287","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m054-0023","start":23,"end":25,"surface":"孝公","kind":"person","person_id":"cbr-p000289","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m054-0031","start":31,"end":35,"surface":"周太史儋","kind":"person","person_id":"cbr-p000286","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m054-0036","start":36,"end":38,"surface":"獻公","kind":"person","person_id":"cbr-p000287","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m054-0104","start":104,"end":106,"surface":"天子","kind":"unresolved","person_id":null,"status":"unresolved","note":"未定指代、群體或官稱；商君語為篇章指引，不當作獨立個人。"},{"id":"c-shiji-005-qin:m054-0126","start":126,"end":129,"surface":"公孫痤","kind":"person","person_id":"cbr-p000447","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m054-0135","start":135,"end":137,"surface":"獻公","kind":"person","person_id":"cbr-p000287","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m054-0140","start":140,"end":142,"surface":"孝公","kind":"person","person_id":"cbr-p000289","status":"contextual_provisional"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-005-qin:p055","text":"孝公元年，河山以東彊國六，與齊威、楚宣、魏惠、燕悼、韓哀、趙成侯并。淮泗之閒小國十餘。楚、魏與秦接界。魏筑長城，自鄭濱洛以北，有上郡。楚自漢中，南有巴、黔中。周室微，諸侯力政，爭相併。秦僻在雍州，不與中國諸侯之會盟，夷翟遇之。孝公於是布惠，振孤寡，招戰士，明功賞。下令國中曰：「昔我繆公自岐雍之閒，修德行武，東平晉亂，以河為界，西霸戎翟，廣地千里，天子致伯，諸侯畢賀，為後世開業，甚光美。會往者厲、躁、簡公、出子之不寧，國家內憂，未遑外事，三晉攻奪我先君河西地，諸侯卑秦、醜莫大焉。獻公即位，鎮撫邊境，徙治櫟陽，且欲東伐，復繆公之故地，修繆公之政令。寡人思念先君之意，常痛於心。賓客群臣有能出奇計彊秦者，吾且尊官，與之分土。」於是乃出兵東圍陜城，西斬戎之獂王。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m055-0000","start":0,"end":2,"surface":"孝公","kind":"person","person_id":"cbr-p000289","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m055-0014","start":14,"end":16,"surface":"齊威","kind":"person","person_id":"cbr-p000448","status":"contextual_provisional"},{"