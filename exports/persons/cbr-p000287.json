sional"},{"id":"c-shiji-034-yan:m017-0017","start":17,"end":19,"surface":"桓公","kind":"person","person_id":"cbr-p001344","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m017-0021","start":21,"end":23,"surface":"桓公","kind":"person","person_id":"cbr-p001344","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m017-0028","start":28,"end":30,"surface":"文公","kind":"person","person_id":"cbr-p001345","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m017-0035","start":35,"end":38,"surface":"秦獻公","kind":"person","person_id":"cbr-p000287","status":"contextual_provisional"}],"chapter_id":"c-shiji-034-yan","book_id":"b-shiji-034","work_id":"w-shiji","source_id":"s-shiji-034-yan"},{"id":"c-shiji-063-laohan:p006","text":"自孔子死之後百二十九年，而史記周太史儋見秦獻公曰：「始秦與周合，合五百歲而離，離七十歲而霸王者出焉。」或曰儋即老子，或曰非也，世莫知其然否。老子，隱君子也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-063-laohan:m006-0001","start":1,"end":3,"surface":"孔子","kind":"person","person_id":"cbr-p003721","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m006-0015","start":15,"end":19,"surface":"周太史儋","kind":"person","person_id":"cbr-p003724","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m006-0020","start":20,"end":23,"surface":"秦獻公","kind":"person","person_id":"cbr-p003725","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m006-0053","start":53,"end":54,"surface":"儋","kind":"person","person_id":"cbr-p003724","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m006-0055","start":55,"end":57,"surface":"老子","kind":"person","person_id":"cbr-p003720","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m006-0063","start":63,"end":64,"surface":"世","kind":"unresolved","person_id":null,"status":"unresolved","note":"引例、群體、泛稱、學說或未定指代；不補姓名、成員或肯定史實。"},{"id":"c-shiji-063-laohan:m006-0070","start":70,"end":72,"surface":"老子","kind":"person","person_id":"cbr-p003720","status":"contextual_provisional"}],"chapter_id":"c-shiji