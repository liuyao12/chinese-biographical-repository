"王惇","start":278,"end":280,"kind":"person","person_id":"han_c2p_04e","status":"contextual_provisional","paragraph_id":"c-sanguozhi-048-sun-liang:p010","chapter_id":"c-sanguozhi-048-sun-liang"},{"id":"c-sanguozhi-048-sun-liang:p010:m0289","surface":"惇","start":289,"end":290,"kind":"person","person_id":"han_c2p_04e","status":"contextual_provisional","paragraph_id":"c-sanguozhi-048-sun-liang:p010","chapter_id":"c-sanguozhi-048-sun-liang"},{"id":"c-sanguozhi-064-suncong-complete:p004:m0075","surface":"王惇","start":75,"end":77,"kind":"person","person_id":"han_c2p_04e","status":"contextual_provisional","paragraph_id":"c-sanguozhi-064-suncong-complete:p004","chapter_id":"c-sanguozhi-064-suncong-complete"},{"id":"c-sanguozhi-064-suncong-complete:p004:m0083","surface":"惇","start":83,"end":84,"kind":"person","person_id":"han_c2p_04e","status":"contextual_provisional","paragraph_id":"c-sanguozhi-064-suncong-complete:p004","chapter_id":"c-sanguozhi-064-suncong-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-048-sun-liang:p010","text":"太平元年春二月朔，建業火。峻用征北大將軍文欽計，將征魏。八月，先遣欽及驃騎呂據、車騎劉纂、鎮南朱異、前將軍唐咨軍自江都入淮、泗。九月丁亥，峻卒，以從弟偏將軍綝爲侍中、武衞將軍，領中外諸軍事，召還據等。據聞綝代峻，大怒。己丑，大司馬呂岱卒。壬辰，太白犯南斗。據、欽、咨等表薦衞將軍滕胤爲丞相，綝不聽。癸卯，更以胤爲大司馬，代呂岱駐武昌。據引兵還，欲討綝。綝遣使以詔書告喻欽、咨等，使取據。冬十月丁未，遣孫憲及丁奉、施寬等以舟兵逆據於江都，遣將軍劉丞督步騎攻胤。胤兵敗夷滅。己酉，大赦，改年。辛亥，獲呂據於新州。十一月，以綝爲大將軍、假節，封永康侯。孫憲與將軍王惇謀殺綝，事覺，綝殺惇，迫憲令自殺。十二月，使五官中郎將刁玄告亂于蜀。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":24,"last_line":24,"raw_start":1218,"raw_end":1576,"raw_character_offsets":[1230,1231,1232,1233,1241,1267,1268,1269,1270,1271,1272,1273,1274,1275,1276,1277,1278,1279,1280,1281,1282,1283,1284,1285,1286,1287,1288,1289,1290,1291,1292,1293,1294,1295,1296,1297,1298,1299,1300,1301,1302,1303,1304,1305,1306,1307,1308,1309,1310,1311,1312,