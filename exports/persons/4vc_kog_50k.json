天下，何此不決乎！」因起如廁。諮議參軍梅陶、長史陳頒言於敦曰：「周訪與侃親姻，如左右手，安有斷人左手而右手不應者乎！」敦意遂解，於是設盛饌以餞之。侃便夜發。敦引其子瞻參軍。侃既達豫章，見周訪，流涕曰：「非卿外援，我殆不免！」侃因進至始興。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":45,"last_line":45,"raw_start":5296,"raw_end":5562,"raw_character_offsets":[5298,5299,5300,5301,5302,5303,5304,5305,5306,5307,5308,5309,5310,5311,5312,5313,5314,5315,5316,5317,5318,5319,5320,5321,5322,5323,5324,5325,5326,5327,5328,5329,5330,5331,5332,5333,5334,5335,5336,5337,5338,5339,5340,5341,5342,5343,5344,5345,5346,5347,5348,5349,5350,5351,5352,5353,5354,5355,5356,5357,5358,5359,5360,5361,5362,5363,5364,5365,5366,5367,5368,5369,5370,5371,5372,5373,5374,5375,5376,5377,5378,5379,5380,5381,5382,5383,5384,5385,5386,5387,5388,5389,5390,5391,5392,5393,5394,5395,5396,5397,5398,5399,5400,5401,5402,5403,5404,5405,5406,5407,5408,5409,5410,5411,5412,5413,5414,5415,5416,5417,5418,5419,5420,5421,5422,5423,5424,5425,5426,5427,5428,5429,5430,5431,5432,5433,5434,5435,5436,5437,5438,5439,5440,5441,5442,5443,5444,5445,5446,5447,5448,5449,5450,5451,5452,5453,5454,5455,5456,5457,5458,5459,5460,5461,5462,5463,5464,5465,5466,5467,5468,5469,5470,5471,5472,5473,5474,5475,5476,5477,5478,5479,5480,5481,5482,5483,5484,5485,5486,5487,5488,5489,5490,5491,5492,5493,5494,5495,5496,5497,5498,5499,5500,5501,5502,5503,5504,5505,5506,5507,5508,5509,5510,5511,5512,5513,5514,5515,5516,5517,5518,5519,5520,5521,5522,5523,5524,5525,5526,5527,5528,5529,5530,5531,5532,5533,5534,5535,5536,5537,5538,5539,5540,5541,5542,5543,5544,5545,5546,5547,5548,5549,5550,5551,5552,5553,5554,5555,5556,5557,5558,5559,5560,5561],"revision_id":1527632},"mentions":[{"id":"c-jinshu-066-taokan:p009:m0000","surface":"王敦","start":0,"end":2,"person_id":"39o_b6y_n74","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p009:m0004","surface":"侃","start":4,"end":5,"person_id":"twd_erg_kmz","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p009:m0017","surface":"皇甫方回",