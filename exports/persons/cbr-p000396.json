":28,"end":30,"surface":"襄公","kind":"person","person_id":"kat_48c_thr","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m078-0042","start":42,"end":45,"surface":"王孫滿","kind":"person","person_id":"fie_vij_hw2","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m078-0055","start":55,"end":57,"surface":"絃髙","kind":"person","person_id":"v8l_ue6_un4","status":"contextual_provisional"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"},{"id":"c-shiji-039-jin:p079","text":"晉先軫曰：「秦伯不用蹇叔，反其衆心，此可撃。」欒枝曰：「未報先君施於秦，撃之，不可。」先軫曰：「秦侮吾孤，伐吾同姓，何德之報？」遂撃之。襄公墨衰絰。四月，敗秦師于殽，虜秦三將孟明視、西乞秫、白乙丙以歸。遂墨以葬文公。文公夫人秦女，謂襄公曰：「秦欲得其三將戮之。」公許，遣之。先軫聞之，謂襄公曰：「患生矣。」軫乃追秦將。秦將渡河，已在船中，頓首謝，卒不反。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m079-0001","start":1,"end":3,"surface":"先軫","kind":"person","person_id":"zql_k3t_8ro","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m079-0006","start":6,"end":8,"surface":"秦伯","kind":"person","person_id":"y97_huh_vuz_AAAAA","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m079-0010","start":10,"end":12,"surface":"蹇叔","kind":"person","person_id":"7du_pfa_2s5","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m079-0023","start":23,"end":25,"surface":"欒枝","kind":"person","person_id":"sar_gso_hyw","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m079-0043","start":43,"end":45,"surface":"先軫","kind":"person","person_id":"zql_k3t_8ro","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m079-0068","start":68,"end":70,"surface":"襄公","kind":"person","person_id":"kat_48c_thr","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m079-0084","start":84,"end":87,"surface":"秦三將","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m079-0087","start":87,"end":90,"surface":"孟明視","kind":"person","person_id":"ylb_ttg_8dr_A","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m079-0091","start":91,"end":94,"surface":"西乞秫","kind":"person","person_id":"7du_pfa_2s5_A","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m079-0095","start":95,"end":98,"surface":"白乙丙","kind":"person","person_id":"7du_pfa_2s5_B","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m079-0105","start":105,"end":107,"surface":"文公","kind":"person","person_id":"6di_ywz_ju4_AAA","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m079-0108","start":108,"end":110,"surface":"文公","kind":"person","person_id":"6di_ywz_ju4_AAA","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m079-0110","start":110,"end":112,"surface":"夫人","kind":"person","person_id":"jgd_o1y_l7r","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m079-0116","start":116,"end":118,"surface":"襄公","kind":"person","person_id":"kat_48c_thr","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m079-0137","start":137,"end":139,"surface":"先軫","kind":"person","person_id":"zql_k3t_8ro","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m079-0143","start":143,"end":145,"surface":"襄公","kind":"person","person_id":"kat_48c_thr","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m079-0153","start":153,"end":154,"surface":"軫","kind":"person","person_id":"zql_k3t_8ro","status":"contextual_provisional"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"},{"id":"c-shiji-039-jin:p082","text":"七年八月，襄公卒。太子夷皋少。晉人以難故，欲立長君。趙盾曰：「立襄公弟雍。好善而長，先君愛之；且近於秦，秦故好也。立善則固，事長則順，奉愛則孝，結舊好則安。」賈季曰：「不如其弟樂。辰嬴嬖於二君，立其子，民必安之。」趙盾曰：「辰嬴賤，班在九人下，其子何震之有！且爲二君嬖，淫也。爲先君子，不能求大而出在小國，僻也。母淫子僻，無威；陳小而遠，無援：將何可乎！」使士會如秦迎公子雍。賈季亦使人召公子樂於陳。趙盾廢賈季，以其殺陽處父。十月，葬襄公。十一月，賈季奔翟。是歳，秦繆公亦卒。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m082-0005","start":5,"end":7,"surface":"襄公","kind":"person","person_id":"kat_48c_thr","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m