nshu:m015-0003","c-shiji-104-tianshu:m015-0026","c-shiji-104-tianshu:m015-0071","c-shiji-104-tianshu:m015-0089","c-shiji-104-tianshu:m016-0012","c-shiji-104-tianshu:m016-0085"],"paragraph_ids":["c-shiji-104-tianshu:p008","c-shiji-104-tianshu:p015","c-shiji-104-tianshu:p016"],"passage_count":3}],"most_mentioned_source_ids":["s-shiji-104-tianshu"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-104-tianshu:m008-0086","start":86,"end":88,"surface":"太子","kind":"person","person_id":"64t_pmo_3d4","status":"contextual_provisional","paragraph_id":"c-shiji-104-tianshu:p008","chapter_id":"c-shiji-104-tianshu"},{"id":"c-shiji-104-tianshu:m008-0110","start":110,"end":112,"surface":"太子","kind":"person","person_id":"64t_pmo_3d4","status":"contextual_provisional","paragraph_id":"c-shiji-104-tianshu:p008","chapter_id":"c-shiji-104-tianshu"},{"id":"c-shiji-104-tianshu:m015-0003","start":3,"end":5,"surface":"太子","kind":"person","person_id":"64t_pmo_3d4","status":"contextual_provisional","paragraph_id":"c-shiji-104-tianshu:p015","chapter_id":"c-shiji-104-tianshu"},{"id":"c-shiji-104-tianshu:m015-0026","start":26,"end":28,"surface":"太子","kind":"person","person_id":"64t_pmo_3d4","status":"contextual_provisional","paragraph_id":"c-shiji-104-tianshu:p015","chapter_id":"c-shiji-104-tianshu"},{"id":"c-shiji-104-tianshu:m015-0071","start":71,"end":73,"surface":"太子","kind":"person","person_id":"64t_pmo_3d4","status":"contextual_provisional","paragraph_id":"c-shiji-104-tianshu:p015","chapter_id":"c-shiji-104-tianshu"},{"id":"c-shiji-104-tianshu:m015-0089","start":89,"end":91,"surface":"太子","kind":"person","person_id":"64t_pmo_3d4","status":"contextual_provisional","paragraph_id":"c-shiji-104-tianshu:p015","chapter_id":"c-shiji-104-tianshu"},{"id":"c-shiji-104-tianshu:m016-0012","start":12,"end":14,"surface":"太子","kind":"person","person_id":"64t_pmo_3d4","status":"contextual_provisional","paragraph_id":"c-shiji-104-tianshu:p016","chapter_id":"c-shiji-104-tianshu"},{"id":"c-shiji-104-tianshu:m016-0085","start":85,"end":87,"surface":"太子","kind":"person","person_id":"64t_pmo_3d4","status":"contextual_provisional","paragraph_id":"c-shiji-104-tianshu:p016","chapter_id":"c-shiji-104-tianshu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji104-019","person_id":"64t_pmo_3d4","surfaces":["太子"],"scope":"same_chapter","chapter_ids":["c-shiji-104-tianshu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-104-tianshu:p008","quote":"仁以壯健為衛將軍舍人，數從擊匈奴。衛將軍進言仁，仁為郎中。數歲，為二千石丞相長史，失官。其後使刺舉三河。上東巡，仁奏事有辭，上說，拜為京輔都尉。月餘，上遷拜為司直。數歲，坐太子事。時左相自將兵，令司直田仁主閉守城門，坐縱太子，下吏誅死。仁發兵，長陵令車千秋上變仁，仁族死。陘城今在中山國。"},{"paragraph_id":"c-shiji-104-tianshu:p015","quote":"其後逢太子有兵事，丞相自將兵，使司直主城門。司直以為太子骨肉之親，父子之閒不甚欲近，去之諸陵過。是時武帝在甘泉，使御史大夫暴君下責丞相「何為縱太子」，丞相對言「使司直部守城門而開太子」。上書以聞，請捕系司直。司直下吏，誅死。"},{"paragraph_id":"c-shiji-104-tianshu:p016","quote":"是時任安為北軍使者護軍，太子立車北軍南門外，召任安，與節令發兵。安拜受節，入，閉門不出。武帝聞之，以為任安為詳邪，不傅事，何也？任安笞辱北軍錢官小吏，小吏上書言之，以為受太子節，言「幸與我其鮮好者」。書上聞，武帝曰：「是老吏也，見兵事起，欲坐觀成敗，見勝者欲合從之，有兩心。安有當死之罪甚眾，吾常活之，今懷詐，有不忠之心。」下安吏，誅死。夫月滿則虧，物盛則衰，天地之常也。知進而不知退，久乘富貴，禍積為祟。故范蠡之去越，辭不受官位，名傳後世，萬歲不忘，豈可及哉！後進者慎戒之。"}],"rationale":"依本篇姓名、原稱及敘事回指暫定；褚補與正文分層，未按同名自動跨篇合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-104-tianshu:p008","text":"仁以壯健為衛將軍舍人，數從擊匈奴。衛將軍進言仁，仁為郎中。數歲，為二千石丞相長史，失官。其後使刺舉三河。上東巡，仁奏事有辭，上說，拜為京輔都尉。月餘，上遷拜為司直。數歲，坐太子事。時左相自將兵，令司直田仁主閉守城門，坐縱太子，下吏誅死。仁發兵，長陵令車千秋上變仁，仁族死。陘城今在中山國。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-104-tianshu:m008-0000","start":0,"end":1,"surface":"仁","kind":"person","person_id":"gyt_axg_s7t_A","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m008-0005","start":5,"end":8,"surface":"衛將軍","kind":"person","person_id":"hmf_0gk_k9w","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m008-0017","start":17,"end":20,"surface":"衛將軍","kind":"person","person_id":"hmf_0gk_k9w","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m008-0022","start":22,"end":23,"surface":"仁","kind":"person","person_id":"gyt_axg_s7t_A","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m008-0024","start":24,"end":25,"surface":"仁","kind":"person","person_id":"gyt_axg_s7t_A","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m008-0056","start":56,"end":57,"surface":"仁","kind":"person","person_id":"gyt_axg_s7t_A","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m008-0086","start":86,"end":88,"surface":"太子","kind":"person","person_id":"64t_pmo_3d4","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m008-0091","start":91,"end":93,"surface":"左相","kind":"person","person_id":"x8h_4i8_xwm","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m008-0100","start":100,"end":102,"surface":"田仁","kind":"person","person_id":"gyt_axg_s7t_A","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m008-0110","start":110,"end":112,"surface":"太子","kind":"person","person_id":"64t_pmo_3d4","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m008-0118","start":118,"end":119,"surface":"仁","kind":"person","person_id":"gyt_axg_s7t_A","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m008-0125","start":125,"end":128,"surface":"車千秋","kind":"person","person_id":"14z_ay0_40z","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m008-0130","start":130,"end":131,"surface":"仁","kind":"person","person_id":"gyt_axg_s7t_A","status":"contextual_provisional"},{"id"