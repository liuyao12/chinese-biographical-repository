假鬼道以惑後主，置淫祀於宮中，聚諸妖巫使之鼓舞，因參訪外事，人閒有一言一事，妃必先知之，以白後主，由是益重妃，內外宗族，多被引用。及隋軍陷臺城，妃與後主俱入于井，隋軍出之，晉王廣命斬貴妃，牓於青溪中橋。","mentions":[{"id":"c-chenshu-007-zhanglihua:p001:m0006","surface":"麗華","start":6,"end":8,"person_id":"3jv_fyp_o96","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-chenshu-007-zhanglihua:p001:m0038","surface":"龔貴嬪","start":38,"end":41,"person_id":"zab_l1p_azm","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-chenshu-007-zhanglihua:p001:m0074","surface":"深","start":74,"end":75,"person_id":"icd_mkz_d9n_AA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-chenshu-007-zhanglihua:p001:m0230","surface":"晉王廣","start":230,"end":233,"person_id":"ce8_yhf_283_AAAAAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":2015446,"source_layer":"received_biography","first_line":58,"last_line":58,"line_start":2,"line_end":247,"raw_start":3475,"raw_end":3720,"raw_character_offsets":[3475,3476,3477,3478,3479,3480,3481,3482,3483,3484,3485,3486,3487,3488,3489,3490,3491,3492,3493,3494,3495,3496,3497,3498,3499,3500,3501,3502,3503,3504,3505,3506,3507,3508,3509,3510,3511,3512,3513,3514,3515,3516,3517,3518,3519,3520,3521,3522,3523,3524,3525,3526,3527,3528,3529,3530,3531,3532,3533,3534,3535,3536,3537,3538,3539,3540,3541,3542,3543,3544,3545,3546,3547,3548,3549,3550,3551,3552,3553,3554,3555,3556,3557,3558,3559,3560,3561,3562,3563,3564,3565,3566,3567,3568,3569,3570,3571,3572,3573,3574,3575,3576,3577,3578,3579,3580,3581,3582,3583,3584,3585,3586,3587,3588,3589,3590,3591,3592,3593,3594,3595,3596,3597,3598,3599,3600,3601,3602,3603,3604,3605,3606,3607,3608,3609,3610,3611,3612,3613,3614,3615,3616,3617,3618,3619,3620,3621,3622,3623,3624,3625,3626,3627,3628,3629,3630,3631,3632,3633,3634,3635,3636,3637,3638,3639,3640,3641,3642,3643,3644,3645