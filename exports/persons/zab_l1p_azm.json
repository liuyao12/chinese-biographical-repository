:null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-chenshu","book_id":"b-chenshu-007","source_id":"s-chenshu-007-zhanglihua-ws2015446","chapter_id":"c-chenshu-007-zhanglihua","paragraph_id":"c-chenshu-007-zhanglihua:p001","quote":"後主張貴妃名麗華，兵家女也。家貧，父兄以織席為事。後主為太子，以選入宮。是時龔貴嬪為良娣，貴妃年十歲，為之給使，後主見而說焉，因得幸，遂有娠，生太子深。後主即位，拜為貴妃。性聰惠，甚被寵遇。後主每引貴妃與賓客遊宴，貴妃薦諸宮女預焉，後宮等咸德之，競言貴妃之善，由是愛傾後宮。又好厭魅之術，假鬼道以惑後主，置淫祀於宮中，聚諸妖巫使之鼓舞，因參訪外事，人閒有一言一事，妃必先知之，以白後主，由是益重妃，內外宗族，多被引用。及隋軍陷臺城，妃與後主俱入于井，隋軍出之，晉王廣命斬貴妃，牓於青溪中橋。","person_mention_id":"c-chenshu-007-zhanglihua:p001:m0038"}],"status":"source_attested","interpretation_note":"按本見證原職名及其所屬人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"th-nan012-zhanglihua-v1-258-zab_l1p_azm","person_id":"zab_l1p_azm","title":"貴嬪","kind":"imperial_rank","mode":"attestation","attestations":[{"id":"th-nan012-zhanglihua-v1-258-zab_l1p_azm:a","person_mention_id":"c-chenshu-007-zhanglihua-weizheng:p001:m0254","usage":"narrative","date_expression":null,"paragraph_id":"c-chenshu-007-zhanglihua-weizheng:p001","surface":"貴嬪","start":258,"end":260}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-chenshu","book_id":"b-chenshu-007","source_id":"s-chenshu-007-zhanglihua-weizheng-ws2015446","chapter_id":"c-chenshu-007-zhanglihua-weizheng","paragraph_id":"c-chenshu-007-zhanglihua-weizheng:p001","quote":"史臣侍中鄭國公魏徵考覽記書，參詳故老，云後主初即位，以始興王叔陵之亂，被傷臥于承香閣下，時諸姬嵭不得進，唯張貴妃侍焉。而柳太后猶居柏梁殿，即皇后之正殿也。後主沈皇后素無寵，不得侍疾，別居求賢殿。至德二年，乃於光照殿前起臨春、結綺、望仙三閣。閣高數丈，嵭數十間，其窗牖、壁帶、懸楣、欄檻之類，嵭以沈檀香木為之，又飾以金玉，間以珠翠，外施珠簾，內有寶祷、寶帳，其服玩之屬，瑰奇珍麗，近古所未有。每微風暫至，香聞數里，朝日初照，光谟後庭。其下積石為山，引水為池，植以奇樹，雜以花藥。後主自居臨春閣，張貴妃居結綺閣，龔、孔二貴嬪居望仙閣，嵭復道交相往來。又有王、李二美人、張、薛二淑媛、袁昭儀、何婕妤、江脩容等七人，嵭有寵，遞代以遊其上。以宮人有文學者袁大捨等為女學士。後主每引賓客對貴妃等遊宴，則使諸貴人及女學士與狎客共賦新詩，互相贈答，採其尤豔麗者以為曲詞，被以新聲，選宮女有容色者以千百數，令習而哥之，分部迭進，持以相樂。其曲有玉樹後庭花、臨春樂等，大指所歸，皆美張貴妃、孔貴嬪之容色也。其略曰：「璧月夜夜滿，瓊樹朝朝新。」而張貴妃髮長七尺，鬒黑如漆，其光可鑒。特聰惠，有神采，進止閑暇，容色端麗。每瞻視盼睞，光采溢目，照谟左右。常於閣上靚粧，臨于軒檻，宮中遙望，飄若神仙。才辯彊記，善候人主顏色。是時，後主怠於政事，百司啟奏，嵭因宦者蔡脫兒、李善度進請，後主置張貴妃於膝上共決之。李、蔡所不能記者，貴妃嵭為條疏，無所遺脫。由是益加寵異，冠絕後庭。而後宮之家，不遵法度，有挂於理者，但求哀於貴妃，貴妃則令李、蔡先啟其事，而後從容為言之。大臣有不從者，亦因而譖之，所言無不聽。於是張、孔之勢，薰灼四方，大臣執政，亦從風而靡。閹宦便佞之徒，內外交結，轉相引進，賄賂公行，賞罰無常，綱紀瞀亂矣。","person_mention_id":"c-chenshu-007-zhanglihua-weizheng:p001:m0254"}],"status":"source_attested","interpretation_note":"按本見證原職名及其所屬人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"th-nan012-zhanglihua-m1-36","person_id":"zab_l1p_azm","title":"良娣","kind":"imperial_rank","mode":"attestation","attestations":[{"id":"th-nan012-zhanglihua-m1-36:a","person_mention_id":"c-nanshi-012-zhanglihua:p001:m0032","usage":"narrative","date_expression":null,"paragraph_id":"c-nanshi-012-zhanglihua:p001","surface":"良娣","start":36,"end":38}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-012","source_id":"s-nanshi-012-zhanglihua-ws2060595","chapter_id":"c-nanshi-012-zhanglihua","paragraph_id":"c-nanshi-012-zhanglihua:p001","quote":"張貴妃名麗華，兵家女也。父兄以織席為業。後主為太子，以選入宮。時龔貴嬪為良娣，貴妃年十歲，為之給使。後主見而悅之，因得幸，遂有娠，生太子深。後主即位，拜為貴妃。性聰慧，甚被寵遇。","person_mention_id":"c-nanshi-012-zhanglihua:p001:m0032"}],"status":"source_attested","interpretation_note":"按本見證原職名及其所屬人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"th-nan012-zhanglihua-m3-156-zab_l1p_azm","person_id":"zab_l1p_azm","title":"貴嬪","kind":"imperial_rank","mode":"attestation","attestations":[{"id":"th-nan012-zhanglihua-m3-156-zab_l1p_azm:a","person_mention_id":"c-nanshi-012-zhanglihua:p003:m0152","usage":"narrative","date_expression":null,"paragraph_id":"c-nanshi-012-zhanglihua:p003","surface":"貴嬪","start":156,"end":158}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-012","source_id":"s-nanshi-012-zhanglihua-ws2060595","chapter_id":"c-nanshi-012-zhanglihua","paragraph_id":"c-nanshi-012-zhanglihua:p003","quote":"至德二年，乃於光昭殿前起臨春、結綺、望仙三閣，高數十丈，並數十間。其窗牖、壁帶、縣楣、欄檻之類，皆以沈檀香為之，又飾以金玉，間以珠翠，外施珠簾。內有寶床寶帳，其服玩之屬，瑰麗皆近古未有。每微風暫至，香聞數里，朝日初照，光映後庭。其下積石為山，引水為池，植以奇樹，雜以花藥。後主自居臨春閣，張貴妃居結綺閣，龔、孔二貴嬪居望仙閣，並復道交相往來。又有王、季二美人，張、薛二淑媛，袁昭儀、何婕妤、江修容等七人，並有寵，遞代以遊其上。以宮人有文學者袁大舍等為女學士。後主每引賓客，對貴妃等游宴，則使諸貴人及女學士與狎客共賦新詩，互相贈答。采其尤豔麗者，以為曲調，被以新聲。選宮女有容色者以千百數，令習而歌之，分部疊進，持以相樂。其曲有玉樹後庭花、臨春樂等。其略云：「璧月夜夜滿，瓊樹朝朝新。」大抵所歸，皆美張貴妃、孔貴嬪之容色。","person_mention_id":"c-nanshi-012-zhanglihua:p003:m0152"}],"status":"source_attested","interpretation_note":"按本見證原職名及其所屬人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-chenshu-007-wuying-consorts:p033","text":"龔貴嬪為良娣貴妃年十歲為之給使後主見而說焉因得幸遂有娠生太子深","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-chenshu-007-wuying-consorts:p033:m0000","surface":"龔貴嬪","start":0,"end":3,"person_id":"zab_l1p_azm","kind":"person","status":"contextual_provisional","interpretation_note":"據同傳已定位的姓名及此刻字面。"},{"id":"c-chenshu-007-wuying-consorts:p033:m0030","surface":"深","start":30,"end":31,"person_id":"icd_mkz_d9n_AA","kind":"person","status":"contextual_provisional","interpretation_note":"據同傳已定位的姓名及此刻字面。"}],"source_position":{"revision_id":"cbr-ai-transcription-sha256:af8dccf903767b99c9a789debedbd5e19b346e21cea98059d5bc194c76e387d9","source_layer":"received_biography","column_projection":[{"column":"50R06","pdf_page":50,"half":"右","leaf":"6下","column_from_right":6,"url":"https://upload.wikimedia.org/wikipedia/commons/c/c7/NLC892-411999000037-306536_%E9%99%B3%E6%9B%B8_%E7%AC%AC2%E5%86%8A.pdf#page=50","start":11,"end":21,"text":"龔貴嬪為良娣貴妃年十"},{"column":"50R07","pdf_page":50,"half":"右","leaf":"6下","column_from_right":7,"url":"https://upload.wikimedia.org/wikipedia/commons/c/c7/NLC892-411999000037-306536_%E9%99%B3%E6%9B%B8_%E7%AC%AC2%E5%86%8A.pdf#page=50","start":0,"end":21,"text":"歲為之給使後主見而說焉因得幸遂有娠生太子深"}]},"chapter_id":"c-chenshu-007-wuying-consorts","book_id":"b-chenshu-007","work_id":"w-chenshu","source_id":"s-chenshu-007-wuying-consorts-1739"},{"id":"c-chenshu-007-zhanglihua-weizheng:p001","text":"史臣侍中鄭國公魏徵考覽記書，參詳故老，云後主初即位，以始興王叔陵之亂，被傷臥于承香閣下，時諸姬嵭不得進，唯張貴妃侍焉。而柳太后猶居柏梁殿，即皇后之正殿也。後主沈皇后素無寵，不得侍疾，別居求賢殿。至德二年，乃於光照殿前起臨春、結綺、望仙三閣。閣高數丈，嵭數十間，其窗牖、壁帶、懸楣、欄檻之類，嵭以沈檀香木為之，又飾以金玉，間以珠翠，外施珠簾，內有寶祷、寶帳，其服玩之屬，瑰奇珍麗，近古所未有。每微風暫至，香聞數里，朝日初照，光谟後庭。其下積石為山，引水為池，植以奇樹，雜以花藥。後主自居臨春閣，張貴妃居結綺閣，龔、孔二貴嬪居望仙閣，嵭復道交相往來。又有王、李二美人、張、薛二淑媛、袁昭儀、何婕妤、江脩容等七人，嵭有寵，遞代以遊其上。以宮人有文學者袁大捨等為女學士。後主每引賓客對貴妃等遊宴，則使諸貴人及女學士與狎客共賦新詩，互相贈答，採其尤豔麗者以為曲詞，被以新聲，選宮女有容色者以千百數，令習而哥之，分部迭進，持以相樂。其曲有玉樹後庭花、臨春樂等，大指所歸，皆美張貴妃、孔貴嬪之容色也。其略曰：「璧月夜夜滿，瓊樹朝朝新。」而張貴妃髮長七尺，鬒黑如漆，其光可鑒。特聰惠，有神采，進止閑暇，容色端麗。每瞻視盼睞，光采溢目，照谟左右。常於閣上靚粧，臨于軒檻，宮中遙望，飄若神仙。才辯彊記，善候人主顏色。是時，後主怠於政事，百司啟奏，嵭因宦者蔡脫兒、李善度進請，後主置張貴妃於膝上共決之。李、蔡所不能記者，貴妃嵭為條疏，無所遺脫。由是益加寵異，冠絕後庭。而後宮之家，不遵法度，有挂於理者，但求哀於貴妃，貴妃則令李、蔡先啟其事，而後從容為言之。大臣有不從者，亦因而譖之，所言無不聽。於是張、孔之勢，薰灼四方，大臣執政，亦從風而靡。閹宦便佞之徒，內外交結，轉相引進，賄賂公行，賞罰無常，綱紀瞀亂矣。","mentions":[{"id":"c-chenshu-007-zhanglihua-weizheng:p001:m0007","surface":"魏徵","start":7,"end":9,"person_id":"8ql_kox_3mb_A","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-chenshu-007-zhanglihua-weizheng:p001:m0027","surface":"始興王叔陵","start":27,"end":32,"person_id":"icd_mkz_d9n_B","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-chenshu-007-zhanglihua-weizheng:p001:m0053","surface":"張貴妃","start":53,"end":56,"person_id":"3jv_fyp_o96","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-chenshu-007-zhanglihua-weizheng:p001:m0060","surface":"柳太后","start":60,"end":63,"person_id":"5jc_z9b_i2n_AAAAAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-chenshu-007-zhanglihua-weizheng:p001:m0079","surface":"沈皇后","start":79,"end":82,"person_id":"9wm_vgh_vz1_AAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-chenshu-007-zhanglihua-weizheng:p001:m0246","surface":"張貴妃","start":246,"end":249,"person_id":"3jv_fyp_o96","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-chenshu-007-zhanglihua-weizheng:p001:m0254","surface":"龔","start":254,"end":255,"person_id":"zab_l1p_azm","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-chenshu-007-zhanglihua-weizheng:p001:m0256","surface":"孔","start":256,"end":257,"person_id":"j45_9y3_n2f","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-chenshu-007-zhanglihua-weizheng:p001:m0275","surface":"王","start":275,"end":276,"person_id":"meq_xgm_dkp","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-chenshu-007-zhanglihua-weizheng:p001:m0277","surface":"李","start":277,"end":278,"person_id":"hus_42d_uq4","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-chenshu-007-zhanglihua-weizheng:p001:m0282","surface":"張","start":282,"end":283,"person_id":"afc_4l3_wg5","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-chenshu-007-zhanglihua-weizheng:p001:m0284","surface":"薛","start":284,"end":285,"person_id":"yqq_oj0_o5l","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-chenshu-007-zhanglihua-weizheng:p001:m0289","surface":"袁昭儀","start":289,"end":292,"person_id":"efb_9pe_vr6","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-chenshu-007-zhanglihua-weizheng:p001:m0293","surface":"何婕妤","start":293,"end":296,"person_id":"7jg_d0e_nal","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-chenshu-007-zhang