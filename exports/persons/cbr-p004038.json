-shiji-069-su:p021","text":"於是韓王勃然作色，攘臂瞋目，按劍仰天太息曰；「寡人雖不肖，必不能事秦。今主君詔以趙王之敎，敬奉社稷以從。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m021-0002","start":2,"end":4,"surface":"韓王","kind":"person","person_id":"7eu_sd1_8qe","status":"contextual_provisional"},{"id":"c-shiji-069-su:m021-0036","start":36,"end":38,"surface":"主君","kind":"person","person_id":"98y_02x_z6o","status":"contextual_provisional"},{"id":"c-shiji-069-su:m021-0040","start":40,"end":42,"surface":"趙王","kind":"person","person_id":"ho4_me8_not","status":"contextual_provisional"}],"chapter_id":"c-shiji-069-su","book_id":"b-shiji-069","work_id":"w-shiji","source_id":"s-shiji-069-su"}],"sources":[{"chapter_id":"c-shiji-069-su","work_id":"w-shiji","book_id":"b-shiji-069","source_id":"s-shiji-069-su","source":{"title":"史記／卷069","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷069","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷069&oldid=2621145","revision_id":2621145,"accessed_on":"2026-10-09","extent":"67段正文，自蘇秦者至太史公論贊；排除ws-header弟名導覽與空段、後附索隱述贊及現代版權告示。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"取得時HTML與固定修訂一致，只去外緣空白。保留雒、衞、嘑、敎、㕹等原字及數位標點疑點，未按現代研究改寫時序。","note":"全67段已核讀，人物標註待逐段處理；未核底本、影像、出土縱橫家材料或現代研究。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical"}}
