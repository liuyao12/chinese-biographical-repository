,"family_paths":[],"mentions":[{"id":"c-jinshu-064-simahuan:p001:m0052","surface":"邢顒","start":52,"end":54,"person_id":"3qk_k7x_x4r","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-064-simahuan:p001","chapter_id":"c-jinshu-064-simahuan"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-064-simahuan:p001","text":"琅邪悼王煥，字耀祖。母有寵，元帝特所鍾愛。初繼帝弟長樂亭侯渾，後封顯義亭侯。尚書令刁協奏：「昔魏臨淄侯以邢顒為家丞，劉楨為庶子。今侯幼弱，宜選明德。」帝令曰：「臨淄萬戶封，又植少有美才，能同游田蘇者。今晚生矇弱，何論於此！間封此兒，不以寵稚子也。亡弟當應繼嗣，不獲已耳。家丞、庶子，足以攝祠祭而已，豈宜屈賢才以受無用乎！」及煥疾篤，帝為之撤膳，乃下詔封為琅邪王，嗣恭王後，俄而薨，年二歲。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":88,"last_line":88,"raw_start":5678,"raw_end":5874,"raw_character_offsets":[5680,5681,5682,5683,5684,5685,5686,5687,5688,5689,5690,5691,5692,5693,5694,5695,5696,5697,5698,5699,5700,5701,5702,5703,5704,5705,5706,5707,5708,5709,5710,5711,5712,5713,5714,5715,5716,5717,5718,5719,5720,5721,5722,5723,5724,5725,5726,5727,5728,5729,5730,5731,5732,5733,5734,5735,5736,5737,5738,5739,5740,5741,5742,5743,5744,5745,5746,5747,5748,5749,5750,5751,5752,5753,5754,5755,5756,5757,5758,5759,5760,5761,5762,5763,5764,5765,5766,5767,5768,5769,5770,5771,5772,5773,5774,5775,5776,5777,5778,5779,5780,5781,5782,5783,5784,5785,5786,5787,5788,5789,5790,5791,5792,5793,5794,5795,5796,5797,5798,5799,5800,5801,5802,5803,5804,5805,5806,5807,5808,5809,5810,5811,5812,5813,5814,5815,5816,5817,5818,5819,5820,5821,5822,5823,5824,5825,5826,5827,5828,5829,5830,5831,5832,5833,5834,5835,5836,5837,5838,5839,5840,5841,5842,5843,5844,5845,5846,5847,5848,5849,5850,5851,5852,5853,5854,5855,5856,5857,5858,5859,5860,5861,5862,5863,5864,5865,5866,5867,5868,5869,5870,5871,5872,5873],"revision_id":2622004},"mentions":[{"id":"c-jinshu-064-simahuan:p001:m0000","surface":"琅邪悼王煥","start":0,"end":5,"per