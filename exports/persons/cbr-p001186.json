":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-032-qi:p073","text":"五十八年夏，景公夫人燕姬適子死。景公寵妾芮姬生子荼，荼少，其母賤，無行，諸大夫恐其為嗣，乃言願擇諸子長賢者為太子。景公老，惡言嗣事，又愛荼母，欲立之，憚發之口，乃謂諸大夫曰：「為樂耳，國何患無君乎？」秋，景公病，命國惠子、高昭子立少子荼為太子，逐群公子，遷之萊。景公卒，太子荼立，是為晏孺子。冬，未葬，而群公子畏誅，皆出亡。荼諸異母兄公子壽、駒、黔奔衛，公子駔、陽生奔魯。萊人歌之曰：「景公死乎弗與埋，三軍事乎弗與謀，師乎師乎，胡黨之乎？」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-032-qi:m073-0006","start":6,"end":8,"surface":"景公","kind":"person","person_id":"cbr-p001072","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m073-0010","start":10,"end":12,"surface":"燕姬","kind":"person","person_id":"cbr-p001184","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m073-0012","start":12,"end":14,"surface":"適子","kind":"unresolved","person_id":null,"status":"unresolved","note":"燕姬所生適子未名，與荼及異母兄群體分開，未補姓名。"},{"id":"c-shiji-032-qi:m073-0016","start":16,"end":18,"surface":"景公","kind":"person","person_id":"cbr-p001072","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m073-0020","start":20,"end":22,"surface":"芮姬","kind":"person","person_id":"cbr-p001185","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m073-0023","start":23,"end":25,"surface":"子荼","kind":"person","person_id":"cbr-p000432","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m073-0026","start":26,"end":27,"surface":"荼","kind":"person","person_id":"cbr-p000432","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m073-0057","start":57,"end":59,"surface":"景公","kind":"person","person_id":"cbr-p001072","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m073-0068","start":68,"end":70,"surface":"荼母","kind":"person","person_id":"cbr-p001185","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m073-0102","start":102,"end":104,"surface":"景公","kind":"person","person_id":"cbr-p001072","status":"contextual_provisional"},{"id":"c-shiji-03