2-qi:m073-0177","start":177,"end":180,"surface":"公子駔","kind":"person","person_id":"cbr-p001191","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m073-0181","start":181,"end":183,"surface":"陽生","kind":"person","person_id":"cbr-p000433","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m073-0193","start":193,"end":195,"surface":"景公","kind":"person","person_id":"cbr-p001072","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m073-0201","start":201,"end":203,"surface":"三軍","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、族稱或未定指代；齊秉意茲等疑讀待版本校勘，不補熟知姓名。"}],"chapter_id":"c-shiji-032-qi","book_id":"b-shiji-032","work_id":"w-shiji","source_id":"s-shiji-032-qi"},{"id":"c-shiji-032-qi:p074","text":"晏孺子元年春，田乞偽事高、國者，每朝，乞驂乘，言曰：「子得君，大夫皆自危，欲謀作亂。」又謂諸大夫曰：「高昭子可畏，及未發，先之。」大夫從之。六月，田乞、鮑牧乃與大夫以兵入公宮，攻高昭子。昭子聞之，與國惠子救公。公師敗，田乞之徒追之，國惠子奔莒，遂反殺高昭子。晏圉奔魯。八月，齊秉意茲。田乞敗二相，乃使人之魯召公子陽生。陽生至齊，私匿田乞家。十月戊子，田乞請諸大夫曰：「常之母有魚菽之祭，幸來會飲。」會飲，田乞盛陽生橐中，置坐中央，發橐出陽生，曰：「此乃齊君矣！」大夫皆伏謁。將與大夫盟而立之，鮑牧醉，乞誣大夫曰：「吾與鮑牧謀共立陽生。」鮑牧怒曰：「子忘景公之命乎？」諸大夫相視欲悔，陽生前，頓首曰：「可則立之，否則已。」鮑牧恐禍起，乃復曰：「皆景公子也，何為不可！」乃與盟，立陽生，是為悼公。悼公入宮，使人遷晏孺子於駘，殺之幕下，而逐孺子母芮子。芮子故賤而孺子少，故無權，國人輕之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-032-qi:m074-0000","start":0,"end":3,"surface":"晏孺子","kind":"person","person_id":"cbr-p000432","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m074-0007","start":7,"end":9,"surface":"田乞","kind":"person","person_id":"cbr-p000431","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m074-0011","start":11,"end":14,"surface":"高、國","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、族稱或未定指代；齊秉意茲等疑讀待版本校勘，不補熟知姓名。"},{"id":"c-shiji-032-qi:m074-0019","start":19,"end":20,"surface":"乞","kind":"person","person_id":"cbr-p000431","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m074-0051","start":51,"end":54,"surface":"高昭子","kind":"person","person_id":"cbr-p001187","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m