087-lisi:m029-0190","start":190,"end":192,"surface":"子罕","kind":"person","person_id":"1z3_l69_xi9","status":"contextual_provisional","paragraph_id":"c-shiji-087-lisi:p029","chapter_id":"c-shiji-087-lisi"},{"id":"c-shiji-087-lisi:m029-0214","start":214,"end":216,"surface":"子罕","kind":"person","person_id":"1z3_l69_xi9","status":"contextual_provisional","paragraph_id":"c-shiji-087-lisi:p029","chapter_id":"c-shiji-087-lisi"}],"relations":[],"title_holdings":[{"id":"th-shiji087-022","person_id":"1z3_l69_xi9","title":"司城","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-087-lisi","source_id":"s-shiji-087-lisi","paragraph_id":"c-shiji-087-lisi:p029","quote":"是時二世在甘泉，方作觳抵優俳之觀。李斯不得見，因上書言趙高之短曰：「臣聞之，臣疑其君，無不危國；妾疑其夫，無不危家。今有大臣於陛下擅利擅害，與陛下無異，此甚不便。昔者司城子罕相宋，身行刑罰，以威行之，朞年遂劫其君。田常為簡公臣，爵列無敵於國，私家之富與公家均，布惠施德，下得百姓，上得群臣，陰取齊國，殺宰予於庭，即弑簡公於朝，遂有齊國。此天下所明知也。今高有邪佚之志，危反之行，如子罕相宋也；私家之富，若田氏之於齊也。兼行田常、子罕之逆道而劫陛下之威信，其志若韓玘為韓安相也。陛下不圖，臣恐其為變也。」二世曰：「何哉？夫高，故宦人也，然不為安肆志，不以危易心，潔行修善，自使至此，以忠得進，以信守位，朕實賢之，而君疑之，何也？且朕少失先人，無所識知，不習治民，而君又老，恐與天下絕矣。朕非屬趙君，當誰任哉？且趙君為人精廉彊力，下知人情，上能適朕，君其勿疑。」李斯曰：「不然。夫高，故賤人也，無識於理，貪欲無厭，求利不止，列勢次主，求欲無窮，臣故曰殆。」二世已前信趙高，恐李斯殺之，乃私告趙高。高曰：「丞相所患者獨高，高已死，丞相即欲為田常所為。」於是二世曰：「其以李斯屬郎中令！」"}],"attestations":[{"id":"th-shiji087-022:a001","paragraph_id":"c-shiji-087-lisi:p029","start":83,"end":85,"surface":"司城","person_mention_id":"c-shiji-087-lisi:m029-0083","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"實際授任、引古、追述與文獻用稱分存；未定日期、死亡、下獄與首次用稱不推定任期端點。假御史謁者侍中、擬任蒙恬相與擬裂地王不作實授。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji087-050","person_id":"1z3_l69_xi9","scope":"same_chapter","chapter_ids":["c-shiji-087-lisi"],"status":"contextual_provisional","rationale":"依李斯下獄及秦末局部承接暫接；始皇弟暫依下一段子嬰既位承接，本篇世系主張保留待跨篇覆核。其