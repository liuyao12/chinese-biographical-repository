orial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-056-zhuzhi:line011:m0060","start":60,"end":62,"surface":"蘇馬","kind":"person","person_id":"wga_nfd_wce","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-056-zhuzhi:line011","chapter_id":"c-sanguozhi-056-zhuzhi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-056-zhuzhi:line011","text":"　　朱治字君理，丹楊故鄣人也。初為縣吏，後察孝廉，州辟從事，隨孫堅征伐。中平五年，拜司馬。從討長沙、零、桂等三郡賊周朝、蘇馬等。有功，堅表治行都尉。從破董卓於陽人，入洛陽。表治行督軍校尉，特將步騎，東助徐州牧陶謙討黃巾。會堅薨，治扶冀策，依就袁術。後知術政德不立，乃勸策還平江東。時太傅馬日碑在壽春，辟治為掾，遷吳郡都尉。是時吳景已在丹楊，而策為術攻廬江。於是劉繇恐為袁、孫所並，遂構嫌隙。而策家門盡在州下，治乃使人於曲阿迎太妃及權兄弟。所以供奉輔護，甚有恩紀。治從錢唐欲進到吳，吳郡太守許貢拒之於由拳，治與戰，大破之。貢南就山賊嚴自虎，治遂入郡，領太守事。策既走劉繇，東定會稽。權年十五，治舉為孝廉。後策薨，治與張昭等共尊奉權。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-056-zhuzhi:line011:m0002","start":2,"end":4,"surface":"朱治","kind":"person","person_id":"oix_a6t_ovk","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-056-zhuzhi:line011:m0005","start":5,"end":7,"surface":"君理","kind":"person","person_id":"oix_a6t_ovk","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-056-zhuzhi:line011:m0031","start":31,"end":33,"surface":"孫堅","kind":"person","person_id":"ki7_rgz_3l4","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-056-zhuzhi:line011:m0057","start":57,"end":59,"surface":"周朝","kind":"person","person_id":"eaw_5zp_7wn","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-056-zhuzhi:line011:m0060","start":60,"end":62,"surface":"蘇馬","kind":"person","person_id":"wga_nfd_wce","status":"contextual_provis