textual_provisional"},{"id":"c-nanqishu-031-xuanmiao-xunboyu:p001:m0013","start":13,"end":14,"surface":"永","kind":"person","person_id":"5we_446_pbb","status":"contextual_provisional"},{"id":"c-nanqishu-031-xuanmiao-xunboyu:p001:m0021","start":21,"end":23,"surface":"闡之","kind":"person","person_id":"5we_446_pbb_A","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-031-xuanmiao-xunboyu","book_id":"b-nanqishu-031","work_id":"w-nanqishu","source_id":"s-nanqishu-031-xuanmiao-xunboyu-ws2062531"},{"id":"c-nanqishu-054-recluses-complete:p010","text":"　　僧胤子惠照，元徽中，爲太祖平南主簿，從拒桂陽，累至驃騎中兵，與荀伯玉對領直。建元元年，爲巴州刺史，綏懷蠻蜑，上許爲益州，未遷，卒。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":42,"last_line":42,"raw_start":1594,"raw_end":1661,"raw_character_offsets":[1594,1595,1596,1597,1598,1599,1600,1601,1602,1603,1604,1605,1606,1607,1608,1609,1610,1611,1612,1613,1614,1615,1616,1617,1618,1619,1620,1621,1622,1623,1624,1625,1626,1627,1628,1629,1630,1631,1632,1633,1634,1635,1636,1637,1638,1639,1640,1641,1642,1643,1644,1645,1646,1647,1648,1649,1650,1651,1652,1653,1654,1655,1656,1657,1658,1659,1660],"revision_id":1762878},"mentions":[{"id":"c-nanqishu-054-recluses-complete:p010:m0002","start":2,"end":4,"surface":"僧胤","kind":"person","person_id":"myp_54w_ksk","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p010:m0005","start":5,"end":7,"surface":"惠照","kind":"person","person_id":"mex_5i1_v70","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p010:m0013","start":13,"end":15,"surface":"太祖","kind":"person","person_id":"47p_kjh_ez7","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p010:m0022","start":22,"end":24,"surface":"桂陽","kind":"person","person_id":"fjv_3dz_w0m","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p010:m0033","start":33,"end":36,"surface":"荀伯玉","kind":"person","person_id":"5we_446_pbb_AA","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-054-recluses-complete","book_id":"b-nanqishu-054","work_id":"w-nanqishu","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanshi-016-wangxuanmiao:p001","text":"玄載弟玄邈字彦遠，仕宋位靑州刺史。齊髙帝之鎭淮陰，爲宋明帝所疑，乃北勸魏，遣書結玄邈。玄邈長史房叔安進曰：「夫布衣韋帶之士，銜一餐而不忘，義使之然也。今將軍居方州之重，托君臣之義，無故舉忠孝而棄之，三齊之士寧蹈東海死耳，不敢隨將軍也。」玄邈意乃定。仍使叔安使建鄴，發髙帝謀。髙帝于路執之，並求玄邈表。叔安答曰：「寡君使表上天子，不上將軍。且僕之所言，利國家而不利將軍，無所應問。」荀伯玉勸殺之，髙帝曰：「物各爲主，無所責也。」玄邈罷州還，髙帝塗中要之，玄邈嚴軍直過。還都，啓宋明帝，稱髙帝有異謀，髙帝不恨也。升明中，髙帝引爲驃騎司馬、泰山太守。玄邈甚懼，髙帝待之如初。再遷西戎校尉、梁南秦二州刺史，封河陽縣侯，兄弟同時爲方伯。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":139,"last_line":139,"raw_start":8396,"raw_end":8733,"raw_character_offsets":[8396,8397,8398,8399,8400,8401,8402,8403,8404,8405,8406,8407,8408,8409,8410,8411,8412,8413,8414,8415,8416,8417,8418,8419,8420,8421,8422,8423,8424,8425,8426,8427,8428,8429,8430,8431,8432,8433,8434,8435,8436,8437,8438,8439,8440,8441,8442,8443,8444,8445,8446,8447,8448,8449,8450,8451,8452,8453,8454,8455,8456,8457,8458,8459,8460,8461,8462,8463,8464,8465,8466,8467,8468,8469,8470,8471,8472,8473,8474,8475,8476,8477,8478,8479,8482,8485,8486,8487,8488,8489,8490,8491,8492,8493,8494,8495,8496,8497,8498,8499,8500,8501,8502,8505,8508,8509,8510,8511,8512,8513,8514,8515,8516,8517,8518,8519,8520,8521,8522,8523,8524,8525,8526,8527,8528,8529,8530,8531,8532,8533,8534,8535,8538,8541,8542,8543,8544,8545,8546,8549,8552,8553,8554,8555,8558,8561,8562,8563,8564,8565,8566,8567,8568,8569,8570,8571,8572,8573,8574,8575,8576,8577,8578,8579,8580,8581,8582,8583,8584,8585,8588,8591,8592,8593,8594,8595,8596,8597,8598,8599,8600,8601,8602,8603,8604,8605,8606,8607,8608,8609,8610,8611,8612,8613,8614,8615,8616,8617,8618,8619,8620,8621,8622,8623,8624,8625,8626,8627,8628,8629,8630,8631,8632,8633,8634,8635,8636,8637,8638,8639,8640,8641,8642,8643,8644,8645,8646,8647,8648,8649,8650,8651,8652,8653,8654,8655,8656,8657,8658,8659,8660,8661,8662,8663,8664,8665,8666,8667,8668,8669,8670,8671,8672,8673,8674,8675,8676,8677,8678,8679,8680,8681,8682,8683,8