son_id":"5dm_e40_rqh_AAAAAAAAAAAAAAAAAAAA","status":"source_attested","evidence":[{"chapter_id":"c-shiji-066-wu","source_id":"s-shiji-066-wu","paragraph_id":"c-shiji-066-wu:p011","quote":"九年，吳王闔廬謂子胥、孫武曰：「始子言郢未可入，今果何如？」二子對曰：「楚將囊瓦貪，而唐、蔡皆怨之。王必欲大伐之，必先得唐、蔡乃可。」闔廬聽之，悉興師與唐、蔡伐楚，與楚夾漢水而陳。吳王之弟夫概將兵請從，王不聽，遂以其屬五千人擊楚將子常。己卯，楚昭王出奔。庚辰，吳王入郢。子常敗走，奔鄭。於是吳乘勝而前，五戰，遂至郢。"}],"qualifiers":{"source_term":"吳王之弟夫概","historicity":"historical_tradition"},"interpretation_note":"按本文明示父、母、兄弟、祖先與孫稱保存。伍舉只記祖先，伯州犁只記祖父，不補闕代；兄弟不推定同父同母。懷父之稱按本人引語，未補姓名或另推鄖公父。引語及敘事屬來源陳述，未作獨立史實確證。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-066-wu:m011-0094","start":94,"end":96,"surface":"夫概","kind":"person","person_id":"9j5_0wx_64h","status":"contextual_provisional","paragraph_id":"c-shiji-066-wu:p011","chapter_id":"c-shiji-066-wu"},{"id":"c-shiji-066-wu:m013-0279","start":279,"end":281,"surface":"夫概","kind":"person","person_id":"9j5_0wx_64h","status":"contextual_provisional","paragraph_id":"c-shiji-066-wu:p013","chapter_id":"c-shiji-066-wu"},{"id":"c-shiji-066-wu:m013-0304","start":304,"end":306,"surface":"夫概","kind":"person","person_id":"9j5_0wx_64h","status":"contextual_provisional","paragraph_id":"c-shiji-066-wu:p013","chapter_id":"c-shiji-066-wu"},{"id":"c-shiji-066-wu:m013-0307","start":307,"end":309,"surface":"夫概","kind":"person","person_id":"9j5_0wx_64h","status":"contextual_provisional","paragraph_id":"c-shiji-066-wu:p013","chapter_id":"c-shiji-066-wu"},{"id":"c-shiji-066-wu:m013-0331","start":331,"end":333,"surface":"夫概","kind":"person","person_id":"9j5_0wx_64h","status":"contextual_provisional","paragraph_id":"c-shiji-066-wu:p013","chapter_id":"c-shiji-066-wu"}],"relations":[{"id":"a-shiji066-010","subject_person_id":"9j5_0wx_64h","predicate":"brother","object_person_id":"5dm_e40_rqh_AAAAAAAAAAAAAAAAAAAA","status":"source_attested","evidence":[{"chapter_id":"c-shiji-066-wu","source_id":"s-shiji-066-wu","paragraph_id":"c-shiji-066-wu:p011","quote":"九年，吳王闔廬謂子胥、孫武曰：「始子言郢未可入，今果何如？」二子對曰：「楚將囊瓦貪，而唐、蔡皆怨之。王必欲大伐之，必先得唐、蔡乃可。」闔廬聽之，悉興師與唐、蔡伐楚，與楚夾漢水而陳。吳王之弟夫概將兵請從，王不聽，遂以其屬五千人擊楚將子常。己卯，楚昭王出奔。庚辰，吳王入郢。子常敗走，奔鄭。於是吳乘勝而前，五戰，遂至郢。"}],"qualifiers":{"source_term":"吳王之弟夫概","historicity":"historical_tradition"},"interpretation_note":"按本文明示父、母、兄弟、祖先與孫稱保存。伍舉只記祖先，伯州犁只記祖父，不補闕代；兄弟不推定同父同母。懷父之稱按本人引語，未補姓名或另推鄖公父。引語及敘事屬來源陳述，未作獨立史實確證。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji066-014","person_id":"9j5_0wx_64h","title":"王","kind":"royal_rank","mode":"self_proclamation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-066-wu","source_id":"s-shiji-066-wu","paragraph_id":"c-shiji-066-wu:p013","quote":"始伍員與申包胥為交，員之亡也，謂包胥曰：「我必覆楚。」包胥曰：「我必存之。」及吳兵入郢，伍子胥求昭王。既不得，乃掘楚平王墓，出其尸，鞭之三百，然後已。申包胥亡於山中，使人謂子胥曰：「子之報讎，其以甚乎！吾聞之，人眾者勝天，天定亦能破人。今子故平王之臣，親北面而事之，今至於僇死人，此豈其無天道之極乎！」伍子胥曰：「為我謝申包胥曰，吾日莫途遠，吾故倒行而逆施之。」於是申包胥走秦告急，求救於秦。秦不許。包胥立於秦廷，晝夜哭，七日七夜不絕其聲。秦哀公憐之，曰：「楚雖無道，有臣若是，可無存乎！」乃遣車五百乘救楚擊吳。六月，敗吳兵於稷。會吳王久留楚求昭王，而闔廬弟夫概乃亡歸，自立為王。闔廬聞之，乃釋楚而歸，擊其弟夫概。夫概敗走，遂奔楚。楚昭王見吳有內亂，乃復入郢。封夫概於堂谿，為堂谿氏。楚復與吳戰，敗吳，吳王乃歸。"}],"attestations":[{"id":"th-shiji066-014:a001","paragraph_id":"c-shiji-066-wu:p013","start":288,"end":289,"surface":"王","person_mention_id":"c-shiji-066-wu:m013-0279","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"self_proclamation","date_expression":null,"evidence":[{"chapter_id":"c-shiji-066-wu","source_id":"s-shiji-066-wu","paragraph_id":"c-shiji-066-wu:p013","quote":"始伍員與申包胥為交，員之亡也，謂包胥曰：「我必覆楚。」包胥曰：「我必存之。」及吳兵入郢，伍子胥求昭王。既不得，乃掘楚平王墓，出其尸，鞭之三百，然後已。申包胥亡於山中，使人謂子胥曰：「子之報讎，其以甚乎！吾聞之，人眾者勝天，天定亦能破人。今子故平王之臣，親北面而事之，今至於僇死人，此豈其無天道之極乎！」伍子胥曰：「為我謝申包胥曰，吾日莫途遠，吾故倒行而逆施之。」於是申包胥走秦告急，求救於秦。秦不許。包胥立於秦廷，晝夜哭，七日七夜不絕其聲。秦哀公憐之，曰：「楚雖無道，有臣若是，可無存乎！」乃遣車五百乘救楚擊吳。六月，敗吳兵於稷。會吳王久留楚求昭王，而闔廬弟夫概乃亡歸，自立為王。闔廬聞之，乃釋楚而歸，擊其弟夫概。夫概敗走，遂奔楚。楚昭王見吳有內亂，乃復入郢。封夫概於堂谿，為堂谿氏。楚復與吳戰，敗吳，吳王乃歸。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授官事件與文獻用稱分存。首次提及、逃亡、死亡不推定任期終點；平王、昭王、闔廬、夫差王稱隨敘事分辨。夫概自立王不作合法授爵，封堂谿未補侯爵；王子綦佯充王及石乞事成為卿的未遂條件均不當實際任職。白公的號與封邑分存，未確定爵級。來源相對年序未換算為精確紀年，版本及稱號性質仍待覆核。","reviewer":"Codex（AI 代理）"}],"address_assertions":[{"id":"pa-shiji066-011","person_id":"9j5_0wx_64h","relation":"migration_destination","place":{"source_name":"楚","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"source_term":"夫概敗走，遂奔楚","evidence":[{"chapter_id":"c-shiji-066-wu","source_id":"s-shiji-066-wu","paragraph_id":"c-shiji-066-wu:p013","quote":"始伍員與申包胥為交，員之亡也，謂包胥曰：「我必覆楚。」包胥曰：「我必存之。」及吳兵入郢，伍子胥求昭王。既不得，乃掘楚平王墓，出其尸，鞭之三百，然後已。申包胥亡於山中，使人謂子胥曰：「子之報讎，其以甚乎！吾聞之，人眾者勝天，天定亦能破人。今子故平王之臣，親北面而事之，今至於僇死人，此豈其無天道之極乎！」伍子胥曰：「為我謝申包胥曰，吾日莫途遠，吾故倒行而逆施之。」於是申包胥走秦告急，求救於秦。秦不許。包胥立於秦廷，晝夜哭，七日七夜不絕其聲。秦哀公憐之，曰：「楚雖無道，有臣若是，可無存乎！」乃遣車五百乘救楚擊吳。六月，敗吳兵於稷。會吳王久留楚求昭王，而闔廬弟夫概乃亡歸，自立為王。闔廬聞之，乃釋楚而歸，擊其弟夫概。夫概敗走，遂奔楚。楚昭王見吳有內亂，乃復入郢。封夫概於堂谿，為堂谿氏。楚復與吳戰，敗吳，吳王乃歸。","person_mention_id":"c-shiji-066-wu:m013-0279"}],"interpretation_note":"按本篇敘事保存原地名及人物範圍，不由同段提及推所有人物到訪；山中不定位現代行政區，未知日期不補。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji066-027","person_id":"9j5_0wx_64h","scope":"same_chapter","chapter_ids":["c-shiji-066-wu"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["夫概"],"evidence":[{"paragraph_id":"c-shiji-066-wu:p011","quote":"九年，吳王闔廬謂子胥、孫武曰：「始子言郢未可入，今果何如？」二子對曰：「楚將囊瓦貪，而唐、蔡皆怨之。王必欲大伐之，必先得唐、蔡乃可。」闔廬聽之，悉興師與唐、蔡伐楚，與楚夾漢水而陳。吳王之弟夫概將兵請從，王不聽，遂以其屬五千人擊楚將子常。己卯，楚昭王出奔。庚辰，吳王入郢。子常敗走，奔鄭。於是吳乘勝而前，五戰，遂至郢。"},{"paragraph_id":"c-shiji-066-wu:p013","quote":"始伍員與申包胥為交，員之亡也，謂包胥曰：「我必覆楚。」包胥曰：「我必存之。」及吳兵入郢，伍子胥求昭王。既不得，乃掘楚平王墓，出其尸，鞭之三百，然後已。申包胥亡於山中，使人謂子胥曰：「子之報讎，其以甚乎！吾聞之，人眾者勝天，天定亦能破人。今子故平王之臣，親北面而事之，今至於僇死人，此豈其無天道之極乎！」伍子胥曰：「為我謝申包胥曰，吾日莫途遠，吾故倒行而逆施之。」於是申包胥走秦告急，求救於秦。秦不許。包胥立於秦廷，晝夜哭，七日七夜不絕其聲。秦哀公憐之，曰：「楚雖無道，有臣若是，可無存乎！」乃遣車五百乘救楚擊吳。六月，敗吳兵於稷。會吳王久留楚求昭王，而闔廬弟夫概乃亡歸，自立為王。闔廬聞之，乃釋楚而歸，擊其弟夫概。夫概敗走，遂奔楚。楚昭王見吳有內亂，乃復入郢。封夫概於堂谿，為堂谿氏。楚復與吳戰，敗吳，吳王乃歸。"}],"rational