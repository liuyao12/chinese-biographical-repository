u-057-hu-fen:p003:m0015"],"kind":"paragraph"}],"mention_count":4,"duplicate_mention_count":0,"paragraph_occurrence_count":4,"table_occurrence_count":0,"passage_count":2,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"4處獨立位置，4個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-057-hu-fen-ws2413329"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin057-volume-hu-guang","subject_person_id":"z0n_1jd_fda","object_person_id":"xml_q9d_qco","predicate":"brother","qualifiers":{"source_term":"兄廣"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-057","chapter_id":"c-jinshu-057-hu-fen","source_id":"s-jinshu-057-hu-fen-ws2413329","paragraph_id":"c-jinshu-057-hu-fen:p002","quote":"泰始末，武帝怠政事而耽於色，大采擇公卿女以充六宮，奮女選入為貴人。奮唯有一子，為南陽王友，早亡。及聞女為貴人，哭曰：「老奴不死，唯有二兒，男入九地之下，女上九天之上。」奮既舊臣，兼有椒房之助，甚見寵待。遷左僕射，加鎮軍大將軍、開府儀同三司。時楊駿以後父驕傲自得，奮謂駿曰：「卿恃女更益豪邪？曆觀前代，與天家婚，未有不滅門者，但早晚事耳。觀卿舉措，適所以速禍。」駿曰：「卿女不在天家乎？」奮曰：「我女與卿女作婢耳，何能損益！」時人皆為之懼，駿雖銜之，而不能害。後卒于官，贈車騎將軍，諡曰壯。奮兄弟六人，兄廣，弟烈，並知名。","subject_person_mention_id":"c-jinshu-057-hu-fen:p002:m0025","object_person_mention_id":"c-jinshu-057-hu-fen:p002:m0251"}],"status":"source_attested","interpretation_note":"原文以廣為奮兄，字宣祖見下。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"a-jin057-volume-hu-xi","subject_person_id":"tix_70m_v3e","object_person_id":"xml_q9d_qco","predicate":"father","qualifiers":{"source_term":"廣子喜"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-057","chapter_id":"c-jinshu-057-hu-fen","source_id":"s-jinshu-057-hu-fen-ws2413329","paragraph_id":"c-jinshu-057-hu-fen:p003","quote":"廣字宣祖，位至散騎常侍、少府。廣子喜，字林甫，亦以開濟為稱，仕至涼州刺史、建武將軍、假節、護羌校尉。","subject_person_mention_id":"c-jinshu-057-hu-fen:p003:m0017","object_person_mention_id":"c-jinshu-057-hu-fen:p003:m0000"}],"status":"source_attested","interpretation_note":"同段具廣名與子喜。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-057-hu-fen:p002:m0251","surface":"廣","start":251,"end":252,"person_id":"xml_q9d_qco","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-057-hu-fen:p002","chapter_id":"c-jinshu-057-hu-fen"},{"id":"c-jinshu-057-hu-fen:p003:m0000","surface":"廣","start":0,"end":1,"person_id":"xml_q9d_qco","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-057-hu-fen:p003","chapter_id":"c-jinshu-057-hu-fen"},{"id":"c-jinshu-057-hu-fen:p003:m0002","surface":"宣祖","start":2,"end":4,"person_id":"xml_q9d_qco","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-057-hu-fen:p003","chapter_id":"c-jinshu-057-hu-fen"},{"id":"c-jinshu-057-hu-fen:p003:m0015","surface":"廣","start":15,"end":16,"person_id":"xml_q9d_qco","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-057-hu-fen:p003","chapter_id":"c-jinshu-057-hu-fen"}],"relations":[{"id":"a-jin057-volume-hu-guang","subject_person_id":"z0n_1jd_fda","object_person_id":"xml_q9d_qco","predicate":"brother","qualifiers":{"source_term":"兄廣"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-057","chapter_id":"c-jinshu-057-hu-fen","source_id":"s-jinshu-057-hu-fen-ws2413329","paragraph_id":"c-jinshu-057-hu-fen:p002","quote":"泰始末，武帝怠政事而耽於色，大采擇公卿女以充六宮，奮女選入為貴人。奮唯有一子，為南陽王友，早亡。及聞女為貴人，哭曰：「老奴不死，唯有二兒，男入九地之下，女上九天之上。」奮既舊臣，兼有椒房之助，甚見寵待。遷左僕射，加鎮軍大將軍、開府儀同三司。時楊駿以後父驕傲自得，奮謂駿曰：「卿恃女更益豪邪？曆觀前代，與天家婚，未有不滅門者，但早晚事耳。觀卿舉措，適所以速禍。」駿曰：「卿女不在天家乎？」奮曰：「我女與卿女作婢耳，何能損益！」時人皆為之懼，駿雖銜之，而不能