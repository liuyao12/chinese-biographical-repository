erson_id":"8w9_x0s_cyf","status":"contextual_provisional","paragraph_id":"c-shiji-034-yan:p022","chapter_id":"c-shiji-034-yan"},{"id":"c-shiji-034-yan:m022-0204","start":204,"end":206,"surface":"子之","kind":"person","person_id":"8w9_x0s_cyf","status":"contextual_provisional","paragraph_id":"c-shiji-034-yan:p022","chapter_id":"c-shiji-034-yan"},{"id":"c-shiji-034-yan:m022-0207","start":207,"end":209,"surface":"子之","kind":"person","person_id":"8w9_x0s_cyf","status":"contextual_provisional","paragraph_id":"c-shiji-034-yan:p022","chapter_id":"c-shiji-034-yan"},{"id":"c-shiji-034-yan:m022-0231","start":231,"end":233,"surface":"子之","kind":"person","person_id":"8w9_x0s_cyf","status":"contextual_provisional","paragraph_id":"c-shiji-034-yan:p022","chapter_id":"c-shiji-034-yan"},{"id":"c-shiji-034-yan:m023-0024","start":24,"end":26,"surface":"子之","kind":"person","person_id":"8w9_x0s_cyf","status":"contextual_provisional","paragraph_id":"c-shiji-034-yan:p023","chapter_id":"c-shiji-034-yan"},{"id":"c-shiji-034-yan:m023-0130","start":130,"end":132,"surface":"子之","kind":"person","person_id":"8w9_x0s_cyf","status":"contextual_provisional","paragraph_id":"c-shiji-034-yan:p023","chapter_id":"c-shiji-034-yan"},{"id":"c-shiji-034-yan:m023-0245","start":245,"end":247,"surface":"子之","kind":"person","person_id":"8w9_x0s_cyf","status":"contextual_provisional","paragraph_id":"c-shiji-034-yan:p023","chapter_id":"c-shiji-034-yan"}],"relations":[],"title_holdings":[{"id":"th-shiji034-044","person_id":"8w9_x0s_cyf","title":"相","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-034-yan","source_id":"s-shiji-034-yan","paragraph_id":"c-shiji-034-yan:p021","quote":"蘇秦之在燕，與其相子之爲婚，而蘇代與子之交。"}],"attestations":[{"id":"th-shiji034-044:a001","paragraph_id":"c-shiji-034-yan:p021","start":19,"end":20,"surface":"相","person_mention_id":"c-shiji-034-yan:m021-0020","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"燕相用稱；為婚方向未明，不把子之與蘇秦判為配偶或直接父子。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji034-039","person_id":"8w9_x0s_cyf","surfaces":["子之"],"scope":"cross_chapter","chapter_ids":["c-shiji-005-qin","c-shiji-034-yan"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-005-qin:p066","quote":"十四年，更為元年。二年，張儀與齊、楚大臣會齧桑。三年，韓、魏太子來朝。張儀相魏。五年，王游至北河。七年，樂池相秦。韓、趙、魏、燕、齊帥匈奴共攻秦。秦使庶長疾與戰修魚，虜其將申差，敗趙公子渴、韓太子奐，斬首八萬二千。八年，張儀復相秦。九年，司馬錯伐蜀，滅之。伐取趙中都、西陽十年，韓太子蒼來質。伐取韓石章。伐敗趙將泥。伐取義渠二十五城。十一年，摢裏疾攻魏焦，降之。敗韓岸門，斬首萬，其將犀首走。公子通封於蜀。燕君讓其臣子之。十二年，王與梁王會臨晉。庶長疾攻趙，虜趙將莊。張儀相楚。十三年，庶長章擊楚於丹陽，虜其將屈丐，斬首八萬；又攻楚漢中，取地六百里，置漢中郡。楚圍雍氏，秦使庶長疾助韓而東攻齊，到滿助魏攻燕。十四年，伐楚，取召陵。丹、犁臣，蜀相壯殺蜀侯來降。"},{"paragraph_id":"c-shiji-034-yan:p021","quote":"燕噲旣立，齊人殺蘇秦。蘇秦之在燕，與其相子之爲婚，而蘇代與子之交。及蘇秦死，而齊宣王復用蘇代。燕噲三年，與楚、三晉攻秦，不勝而還。子之相燕，貴重，主斷。蘇代爲齊使於燕，燕王問曰：「齊王奚如？」對曰：「必不霸。」燕王曰：「何也？」對曰：「不信其臣。」蘇代欲以激燕王以尊子之也。於是燕王大信子之。子之因遺蘇代百金，而聽其所使。"},{"paragraph_id":"c-shiji-034-yan:p022","quote":"鹿毛壽謂燕王：「不如以國讓相子之。人之謂堯賢者，以其讓天下於許由，許由不受，有讓天下之名而實不失天下。今王以國讓於子之，子之必不敢受，是王與堯同行也。」燕王因屬國於子之，子之大重。或曰：「禹薦益，已而以啓人爲吏。及老，而以啓人爲不足任乎天下，傳之於益。已而啓與交黨攻益，奪之。天下謂禹名傳天下於益，已而實令啓自取之。今王言屬國於子之，而吏無非太子人者，是名屬子之而實太子用事也。」王因收印自三百石吏已上而效之子之。子之南面行王事，而噲老不聽政，顧爲臣，國事皆決於子之。"},{"paragraph_id":"c-shiji-034-yan:p023","quote":"三年，國大亂，百姓恫恐。將軍市被與太子平謀，將攻子之。諸將謂齊湣王曰：「因而赴之，破燕必矣。」齊王因令人謂燕太子平曰：「寡人聞太子之義，將廢私而立公，飭君臣之義，明父子之位。寡人之國小，不足以爲先後。雖然，則唯太子所以令之。」太子因要黨聚衆，將軍市被圍公宮，攻子之，不克。將軍市被及百姓反攻太子平，將軍市被死，以徇。因搆難數月，死者數萬，衆人恫恐，百姓離志。孟軻謂齊王曰：「今伐燕，此文、武之時，不可失也。」王因令章子將五都之兵，以因北地之衆以伐燕。士卒不戰，城門不閉，燕君噲死，齊大勝。燕子之亡二年，而燕人共立太子平，是爲燕昭王。"}],"rationale":"依周初封建、燕君世系、割地救燕、讓國及秦滅諸國的具體語境暫定異稱。繼位不自動證父子；同爵者分國別與前後世代。太子平／燕昭王依本篇明示，不表示年代及世系已校定。作君奭為書名，君奭不説之君奭才暫解召公稱呼。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-005-qin:p066","text":"十四年，更為元年。二年，張儀與齊、楚大臣會齧桑。三年，韓、魏太子來朝。張儀相魏。五年，王游至北河。七年，樂池相秦。韓、趙、魏、燕、齊帥匈奴共攻秦。秦使庶長疾與戰修魚，虜其將申差，敗趙公子渴、韓太子奐，斬首八萬二千。八年，張儀復相秦。九年，司馬錯伐蜀，滅之。伐取趙中都、西陽十年，韓太子蒼來質。伐取韓石章。伐敗趙將泥。伐取義渠二十五城。十一年，摢裏疾攻魏焦，降之。敗韓岸門，斬首萬，其將犀首走。公子通封於蜀。燕君讓其臣子之。十二年，王與梁王會臨晉。庶長疾攻趙，虜趙將莊。張儀相楚。十三年，庶長章擊楚於丹陽，虜其將屈丐，斬首八萬；又攻楚漢中，取地六百里，置漢中郡。楚圍雍氏，秦使庶長疾助韓而東攻齊，到滿助魏攻燕。十四年，伐楚，取召陵。丹、犁臣，蜀相壯殺蜀侯來降。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m066-0012","start":12,"end":14,"surface":"張儀","kind":"person","person_id":"uq6_74z_vtv","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0027","start":27,"end":32,"surface":"韓、魏太子","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、氏族、群體或未核指代；不補造個人或按熟知世系自動合併。"},{"id":"c-shiji-005-qin:m066-0035","start":35,"end":37,"surface":"張儀","kind":"person","person_id":"uq6_74z_vtv","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0052","start":52,"end":54,"surface":"樂池","kind":"person","person_id":"h40_rtd_6ut","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0075","start":75,"end":78,"surface":"庶長疾","kind":"person","person_id":"r9n_0vc_ywa","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0086","start":86,"end":88,"surface":"申差","kind":"person","person_id":"icp_nrn_7pl","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0090","start":90,"end":94,"surface":"趙公子渴","kind":"person","person_id":"gy6_lx6_eb2","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0095","start":95,"end":99,"surface":"韓太子奐","kind":"person","person_id":"ux0_nvd_s8f","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0110","start":110,"end":112,"surface":"張儀","kind":"person","person_id":"uq6_74z_vtv","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0119","start":119,"end":122,"surface":"司馬錯","kind":"person","person_id":"rec_qtq_9ve","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0139","start":139,"end":143,"surface":"韓太子蒼","kind":"person","person_id":"xsl_5ma_w95","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0154","start":154,"end":157,"surface"