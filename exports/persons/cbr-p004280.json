d":"c-shiji-074-mengxun:m005-0191","start":191,"end":193,"surface":"繆公","kind":"person","person_id":"cbr-p004305","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m005-0207","start":207,"end":209,"surface":"騶衍","kind":"person","person_id":"cbr-p004291","status":"contextual_provisional"}],"chapter_id":"c-shiji-074-mengxun","book_id":"b-shiji-074","work_id":"w-shiji","source_id":"s-shiji-074-mengxun"},{"id":"c-shiji-074-mengxun:p012","text":"而趙亦有公孫龍為堅白同異之辯，劇子之言；魏有李悝，盡地力之教；楚有尸子、長盧；阿之吁子焉。自如孟子至于吁子，世多有其書，故不論其傳云。蓋墨翟，宋之大夫，善守御，為節用。或曰并孔子時，或曰在其後。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-074-mengxun:m012-0004","start":4,"end":7,"surface":"公孫龍","kind":"person","person_id":"cbr-p004323","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m012-0015","start":15,"end":17,"surface":"劇子","kind":"person","person_id":"cbr-p004324","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m012-0022","start":22,"end":24,"surface":"李悝","kind":"person","person_id":"cbr-p004325","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m012-0033","start":33,"end":35,"surface":"尸子","kind":"person","person_id":"cbr-p004326","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m012-0036","start":36,"end":38,"surface":"長盧","kind":"person","person_id":"cbr-p004327","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m012-0041","start":41,"end":43,"surface":"吁子","kind":"person","person_id":"cbr-p004328","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m012-0047","start":47,"end":49,"surface":"孟子","kind":"person","person_id":"cbr-p004280","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m012-0051","start":51,"end":53,"surface":"吁子","kind":"person","person_id":"cbr-p004328","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m012-0068","start":68,"end":70,"surface":"墨翟","kind":"person","person_id":"cbr-p004329","status":"contextual_provisional"},{"i