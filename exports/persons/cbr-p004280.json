-mengxun:m003-0033","start":33,"end":35,"surface":"孟子","kind":"person","person_id":"cbr-p004280","status":"contextual_provisional","paragraph_id":"c-shiji-074-mengxun:p003","chapter_id":"c-shiji-074-mengxun"},{"id":"c-shiji-074-mengxun:m004-0006","start":6,"end":8,"surface":"孟子","kind":"person","person_id":"cbr-p004280","status":"contextual_provisional","paragraph_id":"c-shiji-074-mengxun:p004","chapter_id":"c-shiji-074-mengxun"},{"id":"c-shiji-074-mengxun:m005-0087","start":87,"end":89,"surface":"孟軻","kind":"person","person_id":"cbr-p004280","status":"contextual_provisional","paragraph_id":"c-shiji-074-mengxun:p005","chapter_id":"c-shiji-074-mengxun"},{"id":"c-shiji-074-mengxun:m005-0136","start":136,"end":138,"surface":"孟軻","kind":"person","person_id":"cbr-p004280","status":"contextual_provisional","paragraph_id":"c-shiji-074-mengxun:p005","chapter_id":"c-shiji-074-mengxun"},{"id":"c-shiji-074-mengxun:m012-0047","start":47,"end":49,"surface":"孟子","kind":"person","person_id":"cbr-p004280","status":"contextual_provisional","paragraph_id":"c-shiji-074-mengxun:p012","chapter_id":"c-shiji-074-mengxun"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji044-073","person_id":"cbr-p002572","surfaces":["孟軻"],"scope":"same_chapter","chapter_ids":["c-shiji-044-wei"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-044-wei:p039","quote":"惠王數被於軍旅，卑禮厚幣以招賢者。鄒衍、淳于髡、孟軻皆至梁。梁惠王曰：『寡人不佞，兵三折於外，太子虜，上將死，國以空虚，以羞先君宗廟社稷，寡人甚丑之，叟不遠千里，辱幸至獘邑之廷，將何利吾國？』孟軻曰：『君不可以言利若是。夫君欲利則大夫欲利，大夫欲利則庶人欲利，上下爭利，國則危矣。爲人君，仁義而已矣，何以利爲！』"}],"rationale":"限本篇明示姓名、是為及同段連續語境；外黃徐子／客按同一勸還對話暫接，龐涓／涓按同一馬陵戰暫接。孫子與孫臏、公子赫與襄王、齊王與齊宣王仍分候選；武下將識國別待核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji074-004","person_id":"cbr-p004280","surfaces":["孟子","孟軻"],"scope":"same_chapter","chapter_ids":["c-shiji-074-mengxun"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-074-mengxun:p002","quote":"孟軻，騶人也。受業子思之門人。道既通，游事齊宣王，宣王不能用。適梁，梁惠王不果所言，則見以為迂遠而闊於事情。當是之時，秦用商君，富國彊兵；楚、魏用吳起，戰勝弱敵；齊威王、宣王用孫子、田忌之徒，而諸侯東面朝齊。天下方務於合從連衡，以攻伐為賢，而孟軻乃述唐、虞、三代之德，是以所如者不合。退而與萬章之徒序詩書，述仲尼之意，作孟子七篇。其後有騶子之屬。"},{"paragraph_id":"c-shiji-074-mengxun:p003","quote":"齊有三騶子。其前騶忌，以鼓琴干威王，因及國政，封為成侯而受相印，先孟子。"},{"paragraph_id":"c-shiji-074-mengxun:p004","quote":"其次騶衍，後孟子。騶衍睹有國者益淫侈，不能尚德，若大雅整之於身，施及黎庶矣。乃深觀陰陽消息而作怪迂之變，終始、大聖之篇十餘萬言。其語閎大不經，必先驗小物，推而大之，至於無垠。先序今以上至黃帝，學者所共術，大并世盛衰，因載其禨祥度制，推而遠之，至天地未生，窈冥不可考而原也。先列中國名山大川，通谷禽獸，水土所殖，物類所珍，因而推之，及海外人之所不能睹。稱引天地剖判以來，五德轉移，治各有宜，而符應若茲。以為儒者所謂中國者，於天下乃八十一分居其一分耳。中國名曰赤縣神州。赤縣神州內自有九州，禹之序九州是也，不得為州數。中國外如赤縣神州者九，乃所謂九州也。於是有裨海環之，人民禽獸莫能相通者，如一區中者，乃為一州。如此者九，乃有大瀛海環其外，天地之際焉。其術皆此類也。然要其歸，必止乎仁義節儉，君臣上下六親之施，始也濫耳。王公大人初見其術，懼然顧化，其後不能行之。"},{"paragraph_id":"c-shiji-074-mengxun:p005","quote":"是以騶子重於齊。適梁，惠王郊迎，執賓主之禮。適趙，平原君側行撇席。如燕，昭王擁彗先驅，請列弟子之座而受業，筑碣石宮，身親往師之。作主運。其游諸侯見尊禮如此，豈與仲尼菜色陳蔡，孟軻困於齊梁同乎哉！故武王以仁義伐紂而王，伯夷餓不食周粟；衛靈公問陳，而孔子不答；梁惠王謀欲攻趙，孟軻稱大王去邠。此豈有意阿世俗茍合而已哉！持方枘欲內圜鑿，其能入乎？或曰，伊尹負鼎而勉湯以王，百里奚飯牛車下而繆公用霸，作先合，然後引之大道。騶衍其言雖不軌，儻亦有牛鼎之意乎？"},{"paragraph_id":"c-shiji-074-mengxun:p012","quote":"而趙亦有公孫龍為堅白同異之辯，劇子之言；魏有李悝，盡地力之教；楚有尸子、長盧；阿之吁子焉。自如孟子至于吁子，世多有其書，故不論其傳云。蓋墨翟，宋之大夫，善守御，為節用。或曰并孔子時，或曰在其後。"}],"rationale":"依前5段明示稱名與局部敘事暫接，孟軻與孟子人稱分辨書名；第5段騶子限接前段騶衍。騶忌、騶衍與三騶群體不混，齊宣王威王與燕昭王分開。夫子引言、孫子、大王去邠與繆公不按記憶補名字；仲尼與孔子已發ID各保留，跨篇暫同指另存於本篇equivalences記錄。引古與傳說保持來源層，不作已確證年代與事實。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji074-meng","person_ids":["cbr-p002572","cbr-p004280"],"canonical_person_id":"cbr-p002572","scope":"cross_chapter","chapter_ids":["c-shiji-044-wei","c-shiji-074-mengxun"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-044-wei","source_id":"s-shiji-044-wei","paragraph_id":"c-shiji-044-wei:p039","quote":"惠王數被於軍旅，卑禮厚幣以招賢者。鄒衍、淳于髡、孟軻皆至梁。梁惠王曰：『寡人不佞，兵三折於外，太子虜，上將死，國以空虚，以羞先君宗廟社稷，寡人甚丑之，叟不遠千里，辱幸至獘邑之廷，將何利吾國？』孟軻曰：『君不可以言利若是。夫君欲利則大夫欲利，大夫欲利則庶人欲利，上下爭利，國則危矣。爲人君，仁義而已矣，何以利爲！』","mention_ids":["c-shiji-044-wei:m039-0024","c-shiji-044-wei:m039-0096"]},{"chapter_id":"c-shiji-074-mengxun","source_id":"s-shiji-074-mengxun","paragraph_id":"c-shiji-074-mengxun:p002","quote":"孟軻，騶人也。受業子思之門人。道既通，游事齊宣王，宣王不能用。適梁，梁惠王不果所言，則見以為迂遠而闊於事情。當是之時，秦用商君，富國彊兵；楚、魏用吳起，戰勝弱敵；齊威王、宣王用孫子、田忌之徒，而諸侯東面朝齊。天下方務於合從連衡，以攻伐為賢，而孟軻乃述唐、虞、三代之德，是以所如者不合。退而與萬章之徒序詩書，述仲尼之意，作孟子七篇。其後有騶子之屬。","mention_ids":["c-shiji-074-mengxun:m002-0000","c-shiji-074-mengxun:m002-0121"]}],"rationale":"兩篇孟軻至梁與梁惠王論利，姓名、相見王及義利論說相配，不以孟子書名當另一人物。 原字、原文與已發ID保留，同書篇章不視為獨立見證；同指不確證全部紀年、任職或敘事，也不作全域同名批量合併。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-044-wei:p039","text":"惠王數被於軍旅，卑禮厚幣以招賢者。鄒衍、淳于髡、孟軻皆至梁。梁惠王曰：『寡人不佞，兵三折於外，太子虜，上將死，國以空虚，以羞先君宗廟社稷，寡人甚丑之，叟不遠千里，辱幸至獘邑之廷，將何利吾國？』孟軻曰：『君不可以言利若是。夫君欲利則大夫欲利，大夫欲利則庶人欲利，上下爭利，國則危矣。爲人君，仁義而已矣，何以利爲！』","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-044-wei:m039-0000","start":0,"end":2,"surface":"惠王","kind":"person","person_id":"cbr-p002534","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m039-0014","start":14,"end":16,"surface":"賢者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱與未定指代保留；公中緩爭太子不作已授太子，將識國別及孫子身份待核。"},{"id":"c-shiji-044-wei:m039-0017","start":17,"end":19,"surface":"鄒衍","kind":"person","person_id":"cbr-p002570","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m039-0020","start":20,"end":23,"surface":"淳于髡","kind":"person","person_id":"cbr-p002571","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m039-0024","start":24,"end":26,"surface":"孟軻","kind":"person","person_id":"cbr-p002572","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m039-0030","start":30,"end":33,"surface":"梁惠王","kind":"person","person_id":"cbr-p002534","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m039-0047","start":47,"end":50,"surface":"太子虜","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱與未定指代保留；公中緩爭太子不作已授太子，將識國別及孫子身份待核。"},{"id":"c-shiji-044-wei:m039-0051","start":51,"end":53,"surface":"上將","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱與未定指代保留；公中緩爭太子不作已授太子，將