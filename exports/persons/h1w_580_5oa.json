i-089-zhanger"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-089-zhanger:m012-0120","start":120,"end":122,"surface":"張黡","kind":"person","person_id":"h1w_580_5oa","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p012","chapter_id":"c-shiji-089-zhanger"},{"id":"c-shiji-089-zhanger:m015-0132","start":132,"end":134,"surface":"張黶","kind":"person","person_id":"h1w_580_5oa","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p015","chapter_id":"c-shiji-089-zhanger"},{"id":"c-shiji-089-zhanger:m015-0255","start":255,"end":257,"surface":"張黶","kind":"person","person_id":"h1w_580_5oa","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p015","chapter_id":"c-shiji-089-zhanger"},{"id":"c-shiji-089-zhanger:m015-0305","start":305,"end":307,"surface":"張黶","kind":"person","person_id":"h1w_580_5oa","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p015","chapter_id":"c-shiji-089-zhanger"},{"id":"c-shiji-089-zhanger:m017-0038","start":38,"end":40,"surface":"張黶","kind":"person","person_id":"h1w_580_5oa","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p017","chapter_id":"c-shiji-089-zhanger"},{"id":"c-shiji-089-zhanger:m017-0052","start":52,"end":54,"surface":"張黶","kind":"person","person_id":"h1w_580_5oa","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p017","chapter_id":"c-shiji-089-zhanger"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji089-035","person_id":"h1w_580_5oa","scope":"same_chapter","chapter_ids":["c-shiji-089-zhanger"],"status":"contextual_provisional","rationale":"按明示姓名及局部語境承接；武臣與趙歇、張敖的趙王用稱限各段，張黡張黶按同行事件暫接但原字分存。未名者不補姓名。","reviewer":"Codex（AI 代理）","surfaces":["張黡","張黶"],"evidence":[{"paragraph_id":"c-shiji-089-zhanger:p012","quote":"陳王使使者賀趙，令趣發兵西入關。張耳、陳餘説武臣曰：「王王趙，非楚意，特以計賀王。楚已滅秦，必加兵於趙。願王毋西兵，北徇燕、代，南收河内以自廣。趙南據大河，北有燕、代，楚雖勝秦，必不敢制趙。」趙王以爲然，因不西兵，而使韓廣略燕，李良略常山，張黡略上黨。"},{"paragraph_id":"c-shiji-089-zhanger:p015","quote":"章邯引兵至邯鄲，皆徙其民河内，夷其城郭。張耳與趙王歇走入鉅鹿城，王離圍之。陳餘北收常山兵，得數萬人，軍鉅鹿北。章邯軍鉅鹿南棘原，筑甬道屬河，餉王離。王離兵食多，急攻鉅鹿。鉅鹿城中食盡兵少，張耳數使人召前陳餘，陳餘自度兵少，不敵秦，不敢前。數月，張耳大怒，怨陳餘，使張黶、陳澤往讓陳餘曰：「始吾與公爲刎頸交，今王與耳旦暮且死，而公擁兵數萬，不肯相救，安在其相爲死！茍必信，胡不赴秦軍倶死？且有十一二相全。」陳餘曰：「吾度前終不能救趙，徒盡亡軍。且餘所以不倶死，欲爲趙王、張君報秦。今必倶死，如以肉委餓虎，何益？」張黶、陳澤曰：「事已急，要以倶死立信，安知後慮！」陳餘曰：「吾死顧以爲無益。必如公言。」乃使五千人令張黶、陳澤先嘗秦軍，至皆沒。"},{"paragraph_id":"c-shiji-089-zhanger:p017","quote":"於是趙王歇、張耳乃得出鉅鹿，謝諸侯。張耳與陳餘相見，責讓陳餘以不肯救趙，及問張黶、陳澤所在。陳餘怒曰：「張黶、陳澤以必死責臣，臣使將五千人先嘗秦軍，皆沒不出。」張耳不信，以爲殺之，數問陳餘。陳餘怒曰：「不意君之望臣深也！豈以臣爲重去將哉？」乃脱解印綬，推予張耳。張耳亦愕不受。陳餘起如廁。客有説張耳曰：「臣聞『天與不取，反受其咎』。今陳將軍與君印，君不受，反天不祥。急取之！」張耳乃佩其印，收其麾下。而陳餘還，亦望張耳不讓，遂趨出。張耳遂收其兵。陳餘獨與麾下所善數百人之河上澤中漁獵。由此陳餘、張耳遂有卻。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-089-zhanger:p012","text":"陳王使使者賀趙，令趣發兵西入關。張耳、陳餘説武臣曰：「王王趙，非楚意，特以計賀王。楚已滅秦，必加兵於趙。願王毋西兵，北徇燕、代，南收河内以自廣。趙南據大河，北有燕、代，楚雖勝秦，必不敢制趙。」趙王以爲然，因不西兵，而使韓廣略燕，李良略常山，張黡略上黨。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-089-zhanger:m012-0000","start":0,"end":2,"surface":"陳王","kind":"person","person_id":"0wd_9iu_71i","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m012-0016","start":16,"end":18,"surface":"張耳","kind":"person","person_id":"net_rj0_wi8","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m012-0019","start":19,"end":21,"surface":"陳餘","kind":"person","person_id":"n7i_lqk_3xi","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m012-0022","start":22,"end":24,"surface":"武臣","kind":"person","person_id":"21i_ev7_c9u","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m012-0070","start":70,"end":71,"surface":"廣","kind":"person","person_id":"zbm_00e_awj","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m012-0096","start":96,"end":98,"surface":"趙王","kind":"person","person_id":"21i_ev7_c9u","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m012-0109","start":109,"end":111,"surface":"韓廣","kind":"person","person_id":"zbm_00e_awj","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m012-0114","start":114,"end":116,"surface":"李良","kind":"person","person_id":"l3x_dtn_i0u","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m012-0120","start":120,"end":122,"surface":"張黡","kind":"person","person_id":"h1w_580_5oa","status":"contextual_provisional"}],"chapter_id":"c-shiji-089-zhanger","book_id":"b-shiji-089","work_id":"w-shiji","source_id":"s-shiji-089-zhanger"},{"id":"c-shiji-089-zhanger:p015","text":"章邯引兵至邯鄲，皆徙其民河内，夷其城郭。張耳與趙王歇走入鉅鹿城，王離圍之。陳餘北收常山兵，得數萬人，軍鉅鹿北。章邯軍鉅鹿南棘原，筑甬道屬河，餉王離。王離兵食多，急攻鉅鹿。鉅鹿城中食盡兵少，張耳數使人召前陳餘，陳餘自度兵少，不敵秦，不敢前。數月，張耳大怒，怨陳餘，使張黶、陳澤往讓陳餘曰：「始吾與公爲刎頸交，今王與耳旦暮且死，而公擁兵數萬，不肯相救，安在其相爲死！茍必信，胡不赴秦軍倶死？且有十一二相全。」陳餘曰：「吾度前終不能救趙，徒盡亡軍。且餘所以不倶死，欲爲趙王、張君報秦。今必倶死，如以肉委餓虎，何益？」張黶、陳澤曰：「事已急，要以倶死立信，安知後慮！」陳餘曰：「吾死顧以爲無益。必如公言。」乃使五千人令張黶、陳澤先嘗秦軍，至皆沒。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-089-zhanger:m015-0000","start":0,"end":2,"surface":"章邯","kind":"person","person_id":"oba_urn_khk","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m015-0020","start":20,"end":22,"surface":"張耳","kind":"person","person_id":"net_rj0_wi8","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m015-0023","start":23,"end":26,"surface":"趙王歇","kind":"person","person_id":"gew_3f0_q9o","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m015-0032","start":32,"end":34,"surface":"王離","kind":"person","person_id":"knn_gc3_gey","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m015-0037","start":37,"end":39,"surface":"陳餘","kind":"person","person_id":"n7i_lqk_3xi","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m015-0055","start":55,"end":57,"surface":"章邯","kind":"person","person_id":"oba_urn_khk","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m015-0071","start":71,"end":73,"surface":"王離","kind":"person","person_id":"knn_gc3_gey","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m015-0074","start":74,"end":76,"surface":"王離","kind":"person","person_id":"knn_gc3_gey","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m015-0094","start":94,"end":96,"surface":"張耳","kind":"person","person_id":"net_rj0_wi8","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m015-0101","start":101,"end":103,"surface":"陳餘","kind":"person","person_id":"n7i_lqk_3xi","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m015-0104","start":104,"end":106,"surface":"陳餘","kind":"person","person_id":"n7i_lqk_3xi","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m015-0122","start":122,"end":124,"surface":"張耳","kind":"person","person_id":"net_rj0_wi8","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m015-0128","start":128,"end":130,"surface":"陳餘","kind":"person","person_id":"n7i_lqk_3xi","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m015-0132","start":132,"end":134,"surface":"張黶","kind":"person","person_id":"h1w_580_5oa","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m015-0135","start":135,"end":137,"surface":"陳澤","kind":"person","person_id":"hnx_2zc_ixj","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m015-0139","start":139,"end":141,"surface":"陳餘","kind":"person","person_id":"n7i_lqk_3xi","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m015-0202","start":202,"end":204,"surface":"陳餘","kind":"person","person_id":"n7i_lqk_3xi","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m015-0234","start":234,"end":236,"surface":"張君","kind":"person","person_id":"net_rj0_wi8","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m015-0255","start":255,"end":257,"surface":"張黶","kind":"person","person_id":"h1w_580_5oa","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m015-0258","start":258,"end":260,"surface":"陳澤","kind":"person","person_id":"hnx_2zc_ixj","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m015-0280","start":280,"end":282,"surface":"陳餘","kind":"person","person_id":"n7i_lqk_3xi","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m015-0305","start":305,"end":307,"surface":"張黶","kind":"person","person_id":"h1w_580_5oa","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m015-0308","start":308,"end":310,"surface":"陳澤","kind":"person","person_id":"hnx_2zc_ixj","status":"contextual_provisional"}],"chapter_id":"c-shiji-089-zhanger","book_id":"b-shiji-089","work_id":"w-shiji","source_id":"s-shiji-089-zhanger"},{"id":"c-shiji-089-zhanger:p017","text":"於是趙王歇、張耳乃得出鉅鹿，謝諸侯。張耳與陳餘相見，責讓陳餘以不肯救趙，及問張黶、陳澤所在。陳餘怒曰：「張黶、陳澤以必死責臣，臣使將五千人先嘗秦軍，皆沒不出。」張耳不信，以爲殺之，數問陳餘。陳餘怒曰：「不意君之望臣深也！豈以臣爲重去將哉？」乃脱解印綬，推予張耳。張耳亦愕不受。陳餘起如廁。客有説張耳曰：「臣聞『天與不取，反受其咎』。今陳將軍與君印，君不受，反天不祥。急取之！」張耳乃佩其印，收其麾下。而陳餘還，亦望張耳不讓，遂趨出。張耳遂收其兵。陳餘獨與麾下所善數百人之河上澤中漁獵。由此陳餘、張耳遂有卻。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-089-zhanger:m017-0002","start":2,"end":5,"surface":"趙王歇","kind":"person","person_id":"gew_3f0_q9o","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m017-0006","start":6,"end":8,"surface":"張耳","kind":"person","person_id":"net_rj0_wi8","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m017-0018","start":18,"end":20,"surface":"張耳","kind":"person","person_id":"net_rj0_wi8","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m017-0021","start":21,"end":23,"surface":"陳餘","kind":"person","person_id":"n7i_lqk_3xi","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m017-0028","s