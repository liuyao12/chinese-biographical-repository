":"c-shiji-130-taishigong","paragraph_id":"c-shiji-130-taishigong:p126","quote":"濞"}]},{"id":"yqp_nlb_p1p_CAA","label":"吳太子被殺未名（吳王濞列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"吳太子","mention_ids":["c-shiji-106-wuwang:m003-0004","c-shiji-106-wuwang:m003-0018","c-shiji-106-wuwang:m003-0049","c-hanshu-035-jingyanwu:wuwang:m003-0004","c-hanshu-035-jingyanwu:wuwang:m003-0018","c-hanshu-035-jingyanwu:wuwang:m003-0048"]}],"evidence":[{"mention_id":"c-shiji-106-wuwang:m003-0004","chapter_id":"c-shiji-106-wuwang","paragraph_id":"c-shiji-106-wuwang:p003","quote":"吳太子"},{"mention_id":"c-shiji-106-wuwang:m003-0018","chapter_id":"c-shiji-106-wuwang","paragraph_id":"c-shiji-106-wuwang:p003","quote":"吳太子"},{"mention_id":"c-shiji-106-wuwang:m003-0049","chapter_id":"c-shiji-106-wuwang","paragraph_id":"c-shiji-106-wuwang:p003","quote":"吳太子"},{"mention_id":"c-hanshu-035-jingyanwu:wuwang:m003-0004","chapter_id":"c-hanshu-035-jingyanwu","paragraph_id":"c-hanshu-035-jingyanwu:wuwang:p003","quote":"吳太子"},{"mention_id":"c-hanshu-035-jingyanwu:wuwang:m003-0018","chapter_id":"c-hanshu-035-jingyanwu","paragraph_id":"c-hanshu-035-jingyanwu:wuwang:p003","quote":"吳太子"},{"mention_id":"c-hanshu-035-jingyanwu:wuwang:m003-0048","chapter_id":"c-hanshu-035-jingyanwu","paragraph_id":"c-hanshu-035-jingyanwu:wuwang:p003","quote":"吳太子"}],"family_path":{"connection":"father","parent_person_id":"yqp_nlb_p1p_CA","status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-106-wuwang","source_id":"s-shiji-106-wuwang","paragraph_id":"c-shiji-106-wuwang:p003","quote":"孝文時，吳太子入見，得侍皇太子飲博。吳太子師傅皆楚人，輕悍，又素驕，博，爭道，不恭，皇太子引博局提吳太子，殺之。於是遣其喪歸葬。至吳，吳王慍曰：「天下同宗，死長安即葬長安，何必來葬為！」復遣喪之長安葬。吳王由此稍失藩臣之禮，稱病不朝。京師知其以子故稱病不朝，驗問實不病，諸吳使來，輒系責治之。吳王恐，為謀滋甚。及後使人為秋請，上復責問吳使者，使者對曰：「王實不病，漢系治使者數輩，以故遂稱病。且夫『察見淵中魚，不祥』。今王始詐病，及覺，見責急，愈益閉，恐上誅之，計乃無聊。唯上棄之而與更始。」於是天子乃赦吳使者歸之，而賜吳王几杖，老，不朝。吳得釋其罪，謀亦益解。然其居國以銅鹽故，百姓無賦。卒踐更，輒與平賈。歲時存問茂材，賞賜閭里。佗郡國吏欲來捕亡人者，訟共禁弗予。如此者四十餘年，以故能使其眾。"}],"interpretation_note":"依本文子、少子或所事王的太子稱謂保存父子；未記母親。被殺太子與起兵太子駒分存；少子是否為駒或子華仍待核，子華與駒不合併。起兵太子與駒依漢書035平行事件暫接，不以候選分槽當排行或確證不同人物。 家族分支為候選分配槽，不作出生排行。","reviewer":"Codex（AI 代理）","human_reviewed":false}}],"source_mention_summary":[{"source_id":"s-hanshu-035-jingyanwu","work_id":"w-hanshu","book_id":"b-hanshu-035","chapter_id":"c-hanshu-035-jingyanwu","raw_mention_count":3,"mention_ids":["c-hanshu-035-jingyanwu:wuwang:m003-0004","c-hanshu-035-jingyanwu:wuwang:m003-0018","c-hanshu-035-jingyanwu:wuwang:m003-0048"],"paragraph_ids":["c-hanshu-035-jingyanwu:wuwang:p003"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-hanshu-035-jingyanwu:wuwang:m003-0004","mention_ids":["c-hanshu-035-jingyanwu:wuwang:m003-0004"],"kind":"paragraph"},{"canonical_mention_id":"c-hanshu-035-jingyanwu:wuwang:m003-0018","mention_ids":["c-hanshu-035-jingyanwu:wuwang:m003-0018"],"kind":"paragraph"},{"canonical_mention_id":"c-hanshu-035-jingyanwu:wuwang:m003-0048","mention_ids":["c-hanshu-035-jingyanwu:wuwang:m003-0048"],"kind":"paragraph"}],"mention_count":3,"duplicate_mention_count":0,"paragraph_occurrence_count":3,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"3處獨立位置，3個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"},{"source_id":"s-shiji-106-wuwang","work_id":"w-shiji","book_id":"b-shiji-106","chapter_id":"c-shiji-106-wuwang","raw_mention_count":3,"mention_ids":["c-shiji-106-wuwang:m003-0004","c-shiji-106-wuwang:m003-0018","c-shiji-106-wuwang:m003-0049"],"paragraph_ids":["c-shiji-106-wuwang:p003"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-shiji-106-wuwang:m003-0004","mention_ids":["c-shiji-106-wuwang:m003-0004"],"kind":"paragraph"},{"canonical_mention_id":"c-shiji-106-wuwang:m003-0018","mention_ids":["c-shiji-106-wuwang:m003-0018"],"kind":"paragraph"},{"canonical_mention_id":"c-shiji-106-wuwang:m003-0049","mention_ids":["c-shiji-106-wuwang:m003-0049"],"kind":"paragraph"}],"mention_count":3,"duplicate_mention_count":0,"paragraph_occurr