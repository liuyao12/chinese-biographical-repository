ces":[{"id":"c-nanqishu-020-liuzhirong-ancestry:p001:r0000","person_id":"gm4_alk_hn7_AA","paragraph_id":"c-nanqishu-020-liuzhirong-ancestry:p001","start":0,"end":5,"surface":"高昭劉皇后","quote":"高昭劉皇后諱智容，廣陵人也。祖玄之，父壽之，竝員外郎。","referent_role":"third_person","note":"依該段前後稱謂。","chapter_id":"c-nanqishu-020-liuzhirong-ancestry","book_id":"b-nanqishu-020","work_id":"w-nanqishu","source_id":"s-nanqishu-020-liuzhirong-ancestry-ws2074177"},{"id":"c-nanqishu-020-peihuizhao:p002:r0024","person_id":"gm4_alk_hn7_AA","paragraph_id":"c-nanqishu-020-peihuizhao:p002","start":24,"end":26,"surface":"昭后","quote":"后少與豫章王妃庾氏為娣姒，庾氏勤女工，奉事太祖、昭后恭謹不倦，后不能及，故不為舅姑所重，世祖家好亦薄焉。性剛嚴，竟陵王子良妃袁氏布衣時有過，后加訓罰。昇明三年，為齊世子妃。建元元年，為皇太子妃。三年，后薨。諡穆妃，葬休安陵。世祖即位，追尊皇后。贈璣之金紫光祿大夫，后母檀氏餘杭廣昌鄉元君。","referent_role":"third_person","note":"依該段前後稱謂。","chapter_id":"c-nanqishu-020-peihuizhao","book_id":"b-nanqishu-020","work_id":"w-nanqishu","source_id":"s-nanqishu-020-peihuizhao-ws2074177"},{"id":"c-nanqishu-020-peihuizhao:p002:r0040","person_id":"gm4_alk_hn7_AA","paragraph_id":"c-nanqishu-020-peihuizhao:p002","start":40,"end":41,"surface":"姑","quote":"后少與豫章王妃庾氏為娣姒，庾氏勤女工，奉事太祖、昭后恭謹不倦，后不能及，故不為舅姑所重，世祖家好亦薄焉。性剛嚴，竟陵王子良妃袁氏布衣時有過，后加訓罰。昇明三年，為齊世子妃。建元元年，為皇太子妃。三年，后薨。諡穆妃，葬休安陵。世祖即位，追尊皇后。贈璣之金紫光祿大夫，后母檀氏餘杭廣昌鄉元君。","referent_role":"third_person","note":"依該段前後稱謂。","chapter_id":"c-nanqishu-020-peihuizhao","book_id":"b-nanqishu-020","work_id":"w-nanqishu","source_id":"s-nanqishu-020-peihuizhao-ws2074177"},{"id":"c-nanshi-011-peihuizhao:p001:r0054","person_id":"gm4_alk_hn7_AA","paragraph_id":"c-nanshi-011-peihuizhao:p001","start":54,"end":57,"surface":"高昭後","quote":"武穆裴皇后諱惠昭，河東聞喜人也。祖封之，給事中。父璣之，左軍參軍。后少與豫章王妃庾氏為娣姒，庾氏勤女工，奉事高昭後恭謹不倦，后不能及，故不為舅姑所重，武帝亦薄焉。","referent_role":"third_person","note":"依該段前後稱謂。","chapter_id":"c-nanshi-011-peihuizhao","book_id":"b-nanshi-011","work_id":"w-nanshi","source_id":"s-nanshi-011-peihuizhao-ws2288359"},{"id":"c-nanshi-011-peihuizhao:p001:r0071","person_id":"gm4_alk_hn7_AA","paragraph_id":"c-nanshi-011-peihuizhao:p001","start":71,"end":72