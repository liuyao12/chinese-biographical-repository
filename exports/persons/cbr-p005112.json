{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p005112","identity_policy":"contextual_provisional","person_ids":["cbr-p005112"],"persons":[{"id":"cbr-p005112","label":"翳（翟王）（淮陰侯列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"翳","mention_ids":["c-shiji-092-hanxin:m006-0420"]},{"surface":"翟王翳","mention_ids":["c-shiji-092-hanxin:m008-0011"]}],"evidence":[{"mention_id":"c-shiji-092-hanxin:m006-0420","chapter_id":"c-shiji-092-hanxin","paragraph_id":"c-shiji-092-hanxin:p006","quote":"翳"},{"mention_id":"c-shiji-092-hanxin:m008-0011","chapter_id":"c-shiji-092-hanxin","paragraph_id":"c-shiji-092-hanxin:p008","quote":"翟王翳"}]}],"mentions":[{"id":"c-shiji-092-hanxin:m006-0420","start":420,"end":421,"surface":"翳","kind":"person","person_id":"cbr-p005112","status":"contextual_provisional","paragraph_id":"c-shiji-092-hanxin:p006","chapter_id":"c-shiji-092-hanxin"},{"id":"c-shiji-092-hanxin:m008-0011","start":11,"end":14,"surface":"翟王翳","kind":"person","person_id":"cbr-p005112","status":"contextual_provisional","paragraph_id":"c-shiji-092-hanxin:p008","chapter_id":"c-shiji-092-hanxin"}],"relations":[],"title_holdings":[{"id":"th-shiji092-009","person_id":"cbr-p005112","title":"翟王","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-092-hanxin","source_id":"s-shiji-092-hanxin","paragraph_id":"c-shiji-092-hanxin:p008","quote":"漢之敗卻彭城，塞王欣、翟王翳亡漢降楚，齊、趙亦反漢與楚和。六月，魏王豹謁歸視親疾，至國，即絕河關反漢，與楚約和。漢王使酈生說豹，不下。其八月，以信爲左丞相，擊魏。魏王盛兵蒲阪，塞臨晉，信乃益爲疑兵，陳船欲度臨晉，而伏兵從夏陽以木罌缻渡軍，襲安邑。魏王豹驚，引兵迎信，信遂虜豹，定魏爲河東郡。漢王遣張耳與信俱，引兵東，北擊趙、代。後九月，破代兵，禽夏說閼與。信之下魏破代，漢輒使人收其精兵，詣滎陽以距楚。"}],"attestations":[{"id":"th-shiji092-009:a001","paragraph_id":"c-shiji-092-hanxin:p008","start":11,"end":13,"surface":"翟王","person_mention_id":"c-shiji-092-hanxin:m008-0011","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予與用稱分存；假王請求不作已授，稱病被捕死亡不自動補任期終點。連敖依頁面註記保留改字前形，不宣稱已核底本。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji092-016","person_id":"cbr-p005112","scope":"same_chapter","chapter_ids":["c-shiji-092-hanxin"],"status":"contextual_provisional","rationale":"按明示姓名及局部事件承接；王號限敘事主體，酈食其酈生及蒯通蒯生暫接，未名者與引古人物各存。不補邯欣翳及周召等短稱完整姓名。","reviewer":"Codex（AI 代理）","surfaces":["翟王翳","翳"],"evidence":[{"paragraph_id":"c-shiji-092-hanxin:p006","quote":"信拜禮畢，上坐。王曰：『丞相數言將軍，將軍何以教寡人計策？』信謝，因問王曰：『今東鄉爭權天下，豈非項王邪？』漢王曰：『然。』曰：『大王自料勇悍仁彊孰與項王？』漢王默然良久，曰：『不如也。』信再拜賀曰：『惟信亦爲大王不如也。然臣嘗事之，請言項王之爲人也。項王喑噁叱咤，千人皆廢，然不能任屬賢將，此特匹夫之勇耳。項王見人恭敬慈愛，言語嘔嘔，人有疾病，涕泣分食飲，至使人有功當封爵者，印刓敝，忍不能予，此所謂婦人之仁也。項王雖霸天下而臣諸侯，不居關中而都彭城。有背義帝之約，而以親愛王，諸侯不平。諸侯之見項王遷逐義帝置江南，亦皆歸逐其主而自王善地。項王所過無不殘滅者，天下多怨，百姓不親附，特劫於威彊耳。名雖爲霸，實失天下心。故曰其彊易弱。今大王誠能反其道：任天下武勇，何所不誅！以天下城邑封功臣，何所不服！以義兵從思東歸之士，何所不散！且三秦王爲秦將，將秦子弟數歲矣，所殺亡不可勝計，又欺其眾降諸侯，至新安，項王詐阬秦降卒二十餘萬，唯獨邯、欣、翳得脫，秦父兄怨此三人，痛入骨髓。今楚彊以威王此三人，秦民莫愛也。大王之入武關，秋豪無所害，除秦苛法，與秦民約，法三章耳，秦民無不欲得大王王秦者。於諸侯之約，大王當王關中，關中民咸知之。大王失職入漢中，秦民無不恨者。今大王舉而東，三秦可傳檄而定也。』於是漢王大喜，自以爲得信晚。遂聽信計，部署諸將所擊。"},{"paragraph_id":"c-shiji-092-hanxin:p008","quote":"漢之敗卻彭城，塞王欣、翟王翳亡漢降楚，齊、趙亦反漢與楚和。六月，魏王豹謁歸視親疾，至國，即絕河關反漢，與楚約和。漢王使酈生說豹，不下。其八月，以信爲左丞相，擊魏。魏王盛兵蒲阪，塞臨晉，信乃益爲疑兵，陳船欲度臨晉，而伏兵從夏陽以木罌缻渡軍，襲安邑。魏王豹驚，引兵迎信，信遂虜豹，定魏爲河東郡。漢王遣張耳與信俱，引兵東，北擊趙、代。後九月，破代兵，禽夏說閼與。信之下魏破代，漢輒使人收其精兵，詣滎陽以距楚。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-092-hanxin:p006","text":"信拜禮畢，上坐。王曰：『丞相數言將軍，將軍何以教寡人計策？』信謝，因問王曰：『今東鄉爭權天下，豈非項王邪？』漢王曰：『然。』曰：『大王自料勇悍仁彊孰與項王？』漢王默然良久，曰：『不如也。』信再拜賀曰：『惟信亦爲大王不如也。然臣嘗事之，請言項王之爲人也。項王喑噁叱咤，千人皆廢，然不能任屬賢將，此特匹夫之勇耳。項王見人恭敬慈愛，言語嘔嘔，人有疾病，涕泣分食飲，至使人有功當封爵者，印刓敝，忍不能予，此所謂婦人之仁也。項王雖霸天下而臣諸侯，不居關中而都彭城。有背義帝之約，而以親愛王，諸侯不平。諸侯之見項王遷逐義帝置江南，亦皆歸逐其主而自王善地。項王所過無不殘滅者，天下多怨，百姓不親附，特劫於威彊耳。名雖爲霸，實失天下心。故曰其彊易弱。今大王誠能反其道：任天下武勇，何所不誅！以天下城邑封功臣，何所不服！以義兵從思東歸之士，何所不散！且三秦王爲秦將，將秦子弟數歲矣，所殺亡不可勝計，又欺其眾降諸侯，至新安，項王詐阬秦降卒二十餘萬，唯獨邯、欣、翳得脫，秦父兄怨此三人，痛入骨髓。今楚彊以威王此三人，秦民莫愛也。大王之入武關，秋豪無所害，除秦苛法，與秦民約，法三章耳，秦民無不欲得大王王秦者。於諸侯之約，大王當王關中，關中民咸知之。大王失職入漢中，秦民無不恨者。今大王舉而東，三秦可傳檄而定也。』於是漢王大喜，自以爲得信晚。遂聽信計，部署諸將所擊。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-092-hanxin:m006-0000","start":0,"end":1,"surface":"信","kind":"person","person_id":"cbr-p005099","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m006-0030","start":30,"end":31,"surface":"信","kind":"person","person_id":"cbr-p005099","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m006-0049","start":49,"end":51,"surface":"項王","kind":"person","person_id":"cbr-p005104","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m006-0054","start":54,"end":56,"surface":"漢王","kind":"person","person_id":"cbr-p005105","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m006-0075","start":75,"end":77,"surface":"項王","kind":"person","person_id":"cbr-p005104","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m006-0079","start":79,"end":81,"surface":"漢王","kind":"person","person_id":"cbr-p005105","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m006-0094","start":94,"end":95,"surface":"信","kind":"person","person_id":"cbr-p005099","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m006-0102","start":102,"end":103,"surface":"信","kind":"person","person_id":"cbr-p005099","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m006-0119","start":119,"end":121,"surface":"項王","kind":"person","person_id":"cbr-p005104","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m006-0126","start":126,"end":128,"surface":"項王","kind":"person","person_id":"cbr-p005104","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m006-0154","start":154,"end":156,"surface":"項王","kind":"person","person_id":"cbr-p005104","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m006-0207","start":207,"end":209,"surface":"項王","kind":"person","person_id":"cbr-p005104","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m006-0229","start":229,"end":231,"surface":"義帝","kind":"person","person_id":"cbr-p0