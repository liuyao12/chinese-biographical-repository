-038-wen-nine-you-rendered:p002","paragraph_sha256":"a10f4d40c106384814823ac423df43150d76d35ddf74f80b5657ab17347762bc","speaker_mention_id":"c-jinshu-038-wen-nine-you-rendered:p002:m0346"}}],"chapter_id":"c-jinshu-038-wen-nine-you-rendered","book_id":"b-jinshu-038","work_id":"w-jinshu","source_id":"s-jinshu-038-wen-nine-you-rendered"},{"id":"c-shiji-067-disciples:p001","text":"孔子曰「受業身通者七十有七人」，皆異能之士也。德行：顏淵，閔子騫，冉伯牛，仲弓。政事：冉有，季路。言語：宰我，子貢。文學：子游，子夏。師也辟，參也魯，柴也愚，由也喭，回也屢空。賜不受命而貨殖焉，億則屢中。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-067-disciples:m001-0000","start":0,"end":2,"surface":"孔子","kind":"person","person_id":"fp6_ia6_7yw","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0004","start":4,"end":9,"surface":"受業身通者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者、氏族或未定指代，尚未補姓名及成員。"},{"id":"c-shiji-067-disciples:m001-0017","start":17,"end":21,"surface":"異能之士","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者、氏族或未定指代，尚未補姓名及成員。"},{"id":"c-shiji-067-disciples:m001-0026","start":26,"end":28,"surface":"顏淵","kind":"person","person_id":"gsq_vgq_esv","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0029","start":29,"end":32,"surface":"閔子騫","kind":"person","person_id":"we8_mkq_luc","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0033","start":33,"end":36,"surface":"冉伯牛","kind":"person","person_id":"n7v_qo9_v4f","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0037","start":37,"end":39,"surface":"仲弓","kind":"person","person_id":"5bo_dxd_69k_A","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0043","start":43,"end":45,"surface":"冉有","kind":"person","person_id":"wnp_vk6_qhe","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0046","start":46,"end":48,"surface":"季路","kind":"person","person_id":"t7x_2x7_1fc","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0052","start":52,"end":54,"surface":"宰我","kind":"person","person_id":"sng_c8u_vn9","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0055","start":55,"end":57,"surface":"子貢","kind":"person","person_id":"7c4_6v2_yvm","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0061","start":61,"end":63,"surface":"子游","kind":"person","person_id":"mqt_zhu_byy","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0064","start":64,"end":66,"surface":"子夏","kind":"person","person_id":"z8l_wje_08d","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0067","start":67,"end":68,"surface":"師","kind":"person","person_id":"482_ly0_otk","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0071","start":71,"end":72,"surface":"參","kind":"person","person_id":"c7w_nyj_95u","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0075","start":75,"end":76,"surface":"柴","kind":"person","person_id":"b7o_fu7_sjf","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0079","start":79,"end":80,"surface":"由","kind":"person","person_id":"t7x_2x7_1fc","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0083","start":83,"end":84,"surface":"回","kind":"person","person_id":"gsq_vgq_esv","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0088","start":88,"end":89,"surface":"賜","kind":"person","person_id":"7c4_6v2_yvm","status":"contextual_provisional"}],"chapter_id":"c-shiji-067-disciples","book_id":"b-shiji-067","work_id":"w-shiji","source_id":"s-shiji-067-disciples"},{"id":"c-shiji-067-disciples:p008","text":"閔損字子騫。少孔子十五歳。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-067-disciples:m008-0000","start":0,"end":2,"surface":"閔損","kind":"person","person_id":"we8_mkq_luc","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m008-0003","start":3,"end":5,"surface":"子騫","kind":"person","person_id":"we8_mkq_luc","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m008-0007","start":7,"end":9,"surface":"孔子","kind":"person","person_id":"fp6_ia6_7yw","status":"contextual_provisional"}],"chapter_id":"c-shiji-067-disciples","book_id":"b-shiji-067","work_id":"w-shiji","source_id":"s-shiji-067-disciples"},{"id":"c-shiji-067-disciples:p009","text":"孔子曰：「孝哉閔子騫！人不閒於其父母昆弟之言。」不仕大夫，不食汙君之祿。「如有復我者，必在汶上矣。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-067-disciples:m009-0000","start":0,"end":2,"surface":"孔子","kind":"person","person_id":"fp6_ia6_7yw","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m009-0007","start":7,"end":10,"surface":"閔子騫","kind":"person","person_id":"we8_mkq_luc","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m009-0016","start":16,"end":20,"surface":"父母昆弟","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者、氏族或未定指代，尚未補姓名及成員。"},{"id":"c-shiji-067-disciples:m009-0026","start":26,"end":28,"surface":"大夫","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者、氏族或未定指代，尚未補姓名及成員。"},{"id":"c-shiji-067-disciples:m009-0031","start":31,"end":33,"surface":"汙君","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者、氏族或未定指代，尚未補姓名及成員。"}],"chapter_id":"c-shiji-067-disciples","book_id":"b-shiji-067","work_id":"w-shiji","source_id":"s-shiji-067-disciples"}],"sources":[{"chapter_id":"c-jinshu-033-wanglan-family","work_id":"w-jinshu","book_id":"b-jinshu-033","source_id":"s-jinshu-033-wanglan-family","source":{"title":"《晉書》卷三十三（數位選錄）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7033&oldid=2650519","permalink":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7033&oldid=2650519","revision_id":2650519,"accessed_on":"2026-10-18","extent":"王祥完整本傳及王覽完整附傳；卷三十三後續鄭沖、何曾、石苞諸傳不在本單元。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，未親核底本影像","response_sha256":"15791b8bdf731793ef02dbe27caed43b97631ae988fec2592c751dd3e7b5434a","wikitext_sha256":"2b422c350bf028f5d9b50e9791cc1b0caacd543dec80ad6fac445d99ae168721","normalization":{"character_conversion":{},"extraction_note":"去首部排版空白、展開連結顯示字、去單字-{字}-顯示語法、展開YL日期模板，不改漢未、乙太中大夫等見證原字；數位小標題不作正文證據。","excerpts":[{"proposed_paragraph_id":"c-jinshu-033-wanglan-family:p001","source_lines":[14,15],"raw_quote":"　　王祥，字休-{徵}-，琅邪臨沂人，漢諫議大夫吉之-{後}-也。祖仁，青州刺史。父融，公府-{辟}-不就。","raw_quote_sha256":"bbf3dd7ae2f5ab69161265874e14fa45662b17d748b0ed9dfb4277f51673ead8","selected_text_sha256":"2606dc497056559dfc79b2f4306effd4edc63587573a624f0c635c9a7f933c31","begin_anchor":"王祥，字休徵，琅邪臨沂人，漢諫","end_anchor":"，青州刺史。父融，公府辟不就。"},{"proposed_paragraph_id":"c-jinshu-033-wanglan-family:p002","source_lines":[16,17],"raw_quote":"　　祥性至孝。早喪親，繼母朱氏不慈，數譖之，由是失愛-{於}-父。每使掃除牛下，祥愈恭謹。父母有疾，衣不解帶，湯藥必親嘗。母常欲生魚，時天寒冰凍，祥解衣將剖冰求之，冰忽自解，雙鯉躍出，持之而歸。母又思黃雀灸，復有黃雀數十飛入其幕，復以供母。鄕里驚歎，以爲孝感所致焉。有丹柰結實，母命守之，每風雨，祥輒抱樹而泣。其篤孝純至如此。","raw_quote_sha256":"dc9ce1d26c53c2956277a237beac6ec091d02d12f4606c6b73b296e1bc2ed704","selected_text_sha256":"2c688093a5217867f6e7925af5ae73722c0240557d6321d8a26953b0a416c14d","begin_anchor":"祥性至孝。早喪親，繼母朱氏不慈","end_anchor":"祥輒抱樹而泣。其篤孝純至如此。"},{"proposed_paragraph_id":"c-jinshu-033-wanglan-family:p003","source_lines":[18,19],"raw_quote":"　　漢未遭亂，扶母攜弟覽避地廬江，隱居三十餘年，不應州郡之命。母終，居喪毀瘁，杖而-{後}-起。徐州刺史呂虔檄爲別駕，祥年垂耳順，固辭不受。覽勸之，爲具車牛，祥乃應召，虔委以州事。-{於}-時寇盜充斥，祥率勵兵士，頻討破之。州界清靜，政化大行。時人歌之曰：「海沂之康，實賴王祥。邦國不空，別駕之功。」","raw_quote_sha256":"be7909ef408ce89591e54a8b243d6e39e557934ae40e27ee69e51e7c14dd5fe7","selected_text_sha256":"49c4e1966467f962ddb1b0209c8b1574fc0e4528d48774c223f602768ad8c03f","begin_anchor":"漢未遭亂，扶母攜弟覽避地廬江，","end_anchor":"賴王祥。邦國不空，別駕之功。」"},{"proposed_paragraph_id":"c-jinshu-033-wanglan-family:p004","source_lines":[39,40],"raw_quote":"　　覽字玄通。母朱，遇祥無道。覽年數歲，見祥被楚撻，輒涕泣抱持。至-{於}-成童，每諫其母，其母少止凶虐。朱屢以非理使祥，覽輒與祥俱。又虐使祥妻，覽妻亦趨而共之。朱患之，乃止。祥喪父之-{後}-，漸有時譽。朱深疾之，密使鴆祥。覽知之，徑起取酒。祥疑其有毒，爭而不與，朱遽奪反之。自-{後}-朱賜祥饌，覽輒先嘗。朱懼覽致斃，遂止。","raw_quote_sha256":"64f4e0b8e61d56fdb63938babaa9bcfd88586084f2d432448f1ba052757a7b48","selected_text_sha256":"314bb9c6889d6f15a84853e4a5d0c19a45fb4b62c31e33688f473d06c21e4f8d","begin_anchor":"覽字玄通。母朱，遇祥無道。覽年","end_anchor":"，覽輒先嘗。朱懼覽致斃，遂止。"},{"proposed_paragraph_id":"c-jinshu-033-wanglan-family:p005","source_lines":[41,42],"raw_quote":"　　覽孝友恭恪，名亞-{於}-祥。及祥仕進，覽亦應本郡之召，稍遷司徒西曹掾、清河太守。五等建，封即丘子，邑六百戸。泰始末，除弘訓少府。職省，轉太中大夫，祿賜與卿同。咸甯初，詔曰：「覽少篤至行，服仁履義，貞素之操，長而彌固。其以覽爲宗正卿。」頃之，以疾上疏乞骸骨。詔聽之，乙太中大夫歸老，賜錢二十萬，床帳薦褥，遣殿中醫療疾給藥。-{後}-轉光祿大夫，門施行馬。","raw_quote_sha256":"40419a8eb7ece09dddabc61f0bd52c592e894e00ff14dcf36cdcc4135176b321","selected_text_sha256":"0236e27239e1247db380e51e73fef7d1df04e1132d77d32644b7c8e24878789a","begin_anchor":"覽孝友恭恪，名亞於祥。及祥仕進","end_anchor":"給藥。後轉光祿大夫，門施行馬。"},{"proposed_paragraph_id":"c-jinshu-033-wanglan-family:p006","source_lines":[43,44],"raw_quote":"　　{{YL|咸寧四年}}卒，時年七十三，諡曰貞。有六子：裁、基、會、正、彥、琛。","raw_quote_sha256":"1b676a2f07bf1dcf5ca27b5af4d9912c1d31377fc3a8e6ce355ff58306231c0b","selected_text_sha256":"e490f9134a325ad7545ba632b20b15665e49864e2da4018e00c8bae8b0ea31b7","begin_anchor":"咸寧四年卒，時年七十三，諡曰貞","end_anchor":"六子：裁、基、會、正、彥、琛。"},{"proposed_paragraph_id":"c-jinshu-033-wanglan-family:p007","source_lines":[45,46],"raw_quote":"　　裁字士初，撫軍長史。[[晉書/卷098#王敦|基]]字士先，治書御史。[[晉書/卷076#王舒|會]]字士和，侍御史。正字士則，尚書郎。彥字士治，中護軍。琛字士瑋，國子祭酒。","raw_quote_sha256":"46758aedb5388938223c2d591ce503993c0f591832c8a420457d713e3e252407","selected_text_sha256":"242d4aeb39a37bc009c4fdb993964b5808dc99a4da29a349c17e8d9c5ba3342c","begin_anchor":"裁字士初，撫軍長史。基字士先，","end_anchor":"，中護軍。琛字士瑋，國子祭酒。"},{"proposed_paragraph_id":"c-jinshu-033-wanglan-family:p008","source_lines":[47,48],"raw_quote":"　　初，呂虔有佩刀，工相之，以爲必登三公，可服此刀。虔謂祥曰：「苟非其人，刀或爲害。卿有公輔之量，故以相與。」祥固辭，強之乃受。祥臨薨，以刀授覽，曰：「汝-{後}-必興，足稱此刀。」覽-{後}-奕世多賢才，興-{於}-江左矣。裁子導，[[晉書/卷065|別有傳]]。","raw_quote_sha256":"a43f33c97b30853834d357d68a90d5e08fd1668a05e8469de66623b9d3c5efbe","selected_text_sha256":"19ba4970c1e7d6440a46690f3e567bf0af4efe92c07358ffca2a20c540acb2d0","begin_anchor":"初，呂虔有佩刀，工相之，以爲必","end_anchor":"，興於江左矣。裁子導，別有傳。"}],"completion_appendix":"同固定修訂2650519補入原始行20–35八段；原八段全文、ID與mentions全值保留。原字漢未、乙太保、Я脯等不靜改。"}}},{"chapter_id":"c-jinshu-034-yanghu-comparison","work_id":"w-jinshu","book_id":"b-jinshu-034","source_id":"s-jinshu-034-yanghu-ws2567662-rendered-comparison","source":{"title":"《晉書》卷三十四〈羊祜傳〉","provider":"維基文庫固定修訂頁呈現文字","url":"https://zh.wikisource.org/wiki/晉書/卷034","permalink":"https://zh.wikisource.org/w/index.php?title=晉書/卷034&oldid=2567662","revision_id":2567662,"accessed_on":"2026-10-28","edition":null,"edition_qualification":"印本未核的固定數位比較見證；非首選底本，非武英殿，未核書影。未確認是否出於四庫，不採為preferred base。","preferred_text_base":false,"image_verified":false,"human_reviewed":false,"extent":"羊祜題下至杜預題頭前完整單元，含羊發、秘、亮、陶及承嗣附敘；41呈現文字段，非全卷，不含杜預及卷末評贊。","text_scope":"partial_chapter","review_status":"text_checked","capture_ref":"source-evidence/jin034-yanghu-comparison/rendered-extract.txt","capture_sha256":"35dc69590312f9b13541d3df2c8cd75c43721cd22251530def3d6acda41ec5b6","capture_kind":"fixed_revision_webtool_rendered_text_extract","original_wikitext_obtained":false,"rights":"古代原文；維基文庫數位轉錄依CC BY-SA 4.0保留署名與固定修訂。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"extraction_note":"去數位題頭/工具行號/blockquote呈現符與行首排版縮排；工具連結標記僅保可見詞，未改正文標點、字形或疑字。未取得HTML或wikitext。"}}},{"chapter_id":"c-jinshu-038-wen-nine-you-rendered","work_id":"w-jinshu","book_id":"b-jinshu-038","source_id":"s-jinshu-038-wen-nine-you-rendered","source":{"title":"晉書·卷三十八·列傳第八","provider":"Wikisource","url":"https://zh.wikisource.org/wiki/晉書/卷038","permalink":"https://zh.wikisource.org/w/index.php?title=晉書/卷038&oldid=2444513","revision_id":2444513,"accessed_on":"2026-10-30","edition":null,"extent":"文帝九男完整段及齊獻王攸傳首完整一段；普通頁工具L243、L248。非全卷、非完整攸本傳。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,