{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p005220","identity_policy":"contextual_provisional","person_ids":["cbr-p005220"],"persons":[{"id":"cbr-p005220","label":"楚懷王（田儋列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"楚懷王","mention_ids":["c-shiji-094-tiandan:m005-0054"]}],"evidence":[{"mention_id":"c-shiji-094-tiandan:m005-0054","chapter_id":"c-shiji-094-tiandan","paragraph_id":"c-shiji-094-tiandan:p005","quote":"楚懷王"}]}],"mentions":[{"id":"c-shiji-094-tiandan:m005-0054","start":54,"end":57,"surface":"楚懷王","kind":"person","person_id":"cbr-p005220","status":"contextual_provisional","paragraph_id":"c-shiji-094-tiandan:p005","chapter_id":"c-shiji-094-tiandan"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji094-008","person_id":"cbr-p005220","surfaces":["楚懷王"],"scope":"same_chapter","chapter_ids":["c-shiji-094-tiandan"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-094-tiandan:p005","quote":"項梁既追章邯，章邯兵益盛，項梁使使告趙、齊，發兵共擊章邯。田榮曰：「使楚殺田假，趙殺田角、田閒，閒肯出兵。」楚懷王曰：「田假與國之王，窮而歸我，殺之不義。」趙亦不殺田角、田閒以市於齊。齊曰：「蝮螫手則斬手，螫足則斬足。何者？為害於身也。今田假、田角、田閒於楚、趙，非直手足戚也，何故不殺？且秦復得志於天下，則齮齕用事者墳墓矣。」楚、趙不聽，齊亦怒，終不肯出兵。章邯果敗殺項梁，破楚兵，楚兵東走，而章邯渡河圍趙於鉅鹿。項羽往救趙，由此怨田榮。"}],"rationale":"明示姓名與局部敘事承接，短稱及田間田閒等異字仍待覆核，不按全域同名合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-094-tiandan:p005","text":"項梁既追章邯，章邯兵益盛，項梁使使告趙、齊，發兵共擊章邯。田榮曰：「使楚殺田假，趙殺田角、田閒，閒肯出兵。」楚懷王曰：「田假與國之王，窮而歸我，殺之不義。」趙亦不殺田角、田閒以市於齊。齊曰：「蝮螫手則斬手，螫足則斬足。何者？為害於身也。今田假、田角、田閒於楚、趙，非直手足戚也，何故不殺？且秦復得志於天下，則齮齕用事者墳墓矣。」楚、趙不聽，齊亦怒，終不肯出兵。章邯果敗殺項梁，破楚兵，楚兵東走，而章邯渡河圍趙於鉅鹿。項羽往救趙，由此怨田榮。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-094-tiandan:m005-0000","start":0,"end":2,"surface":"項梁","kind":"person","person_id":"cbr-p005233","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m005-0004","start