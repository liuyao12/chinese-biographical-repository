valence_decisions":[],"passages":[{"id":"c-shiji-053-xiao:p004","text":"及高祖起為沛公，何常為丞督事。沛公至咸陽，諸將皆爭走金帛財物之府分之，何獨先入收秦丞相御史律令圖書藏之。沛公為漢王，以何為丞相。項王與諸侯屠燒咸陽而去。漢王所以具知天下阸塞，戶口多少，彊弱之處，民所疾苦者，以何具得秦圖書也。何進言韓信，漢王以信為大將軍。語在淮陰侯事中。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-053-xiao:m004-0001","start":1,"end":3,"surface":"高祖","kind":"person","person_id":"cbt_w9x_a7e","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m004-0005","start":5,"end":7,"surface":"沛公","kind":"person","person_id":"cbt_w9x_a7e","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m004-0008","start":8,"end":9,"surface":"何","kind":"person","person_id":"ic8_7be_6x3","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m004-0015","start":15,"end":17,"surface":"沛公","kind":"person","person_id":"cbt_w9x_a7e","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m004-0021","start":21,"end":23,"surface":"諸將","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、官署或未定回指；不補姓名或後嗣成員。"},{"id":"c-shiji-053-xiao:m004-0035","start":35,"end":36,"surface":"何","kind":"person","person_id":"ic8_7be_6x3","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m004-0041","start":41,"end":43,"surface":"丞相","kind":"unresolved","person_id":null,"status":"unresolved","note":"秦丞相御史圖書屬秦官署或舊官稱，未當蕭何。"},{"id":"c-shiji-053-xiao:m004-0052","start":52,"end":54,"surface":"沛公","kind":"person","person_id":"cbt_w9x_a7e","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m004-0055","start":55,"end":57,"surface":"漢王","kind":"person","person_id":"cbt_w9x_a7e","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m004-0059","start":59,"end":60,"surface":"何","kind":"person","person_id":"ic8_7be_6x3","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m004-0061","start":61,"end":63,"surface":"丞相","kind":"person","person_id":"ic8_7be_6x3","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m004-0064","start":64,"end":66,"sur