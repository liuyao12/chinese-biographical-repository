tart":395,"end":397,"surface":"毛遂","kind":"person","person_id":"cbr-p004383","status":"contextual_provisional","paragraph_id":"c-shiji-076-pingyu:p004","chapter_id":"c-shiji-076-pingyu"},{"id":"c-shiji-076-pingyu:m004-0414","start":414,"end":416,"surface":"毛遂","kind":"person","person_id":"cbr-p004383","status":"contextual_provisional","paragraph_id":"c-shiji-076-pingyu:p004","chapter_id":"c-shiji-076-pingyu"},{"id":"c-shiji-076-pingyu:m004-0434","start":434,"end":436,"surface":"毛遂","kind":"person","person_id":"cbr-p004383","status":"contextual_provisional","paragraph_id":"c-shiji-076-pingyu:p004","chapter_id":"c-shiji-076-pingyu"},{"id":"c-shiji-076-pingyu:m004-0463","start":463,"end":464,"surface":"遂","kind":"person","person_id":"cbr-p004383","status":"contextual_provisional","paragraph_id":"c-shiji-076-pingyu:p004","chapter_id":"c-shiji-076-pingyu"},{"id":"c-shiji-076-pingyu:m004-0473","start":473,"end":475,"surface":"毛遂","kind":"person","person_id":"cbr-p004383","status":"contextual_provisional","paragraph_id":"c-shiji-076-pingyu:p004","chapter_id":"c-shiji-076-pingyu"},{"id":"c-shiji-076-pingyu:m005-0050","start":50,"end":53,"surface":"毛先生","kind":"person","person_id":"cbr-p004383","status":"contextual_provisional","paragraph_id":"c-shiji-076-pingyu:p005","chapter_id":"c-shiji-076-pingyu"},{"id":"c-shiji-076-pingyu:m005-0058","start":58,"end":61,"surface":"毛先生","kind":"person","person_id":"cbr-p004383","status":"contextual_provisional","paragraph_id":"c-shiji-076-pingyu:p005","chapter_id":"c-shiji-076-pingyu"},{"id":"c-shiji-076-pingyu:m005-0075","start":75,"end":78,"surface":"毛先生","kind":"person","person_id":"cbr-p004383","status":"contextual_provisional","paragraph_id":"c-shiji-076-pingyu:p005","chapter_id":"c-shiji-076-pingyu"}],"relations":[],"title_holdings":[{"id":"th-shiji076-003","person_id":"cbr-p004383","title":"舍人","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-076-pingyu","source_id":"s-shiji-076-pingyu","paragraph_id":"c-shiji-076-pingyu:p004","quote":"毛遂比至楚，與十九人論議，十九人皆服。平原君與楚合從，言其利害，日出而言之，日中不決。十九人謂毛遂曰：「先生上。」毛遂按劍歷階而上，謂平原君曰：「從之利害，兩言而決耳。今日出而言從，日中不決，何也？」楚王謂平原君曰：「客何爲者也？」平原君曰：「是勝之舍人也。」楚王叱曰：「胡不下！吾乃與而君言，汝何爲者也！」毛遂按劍而前曰：「王之所以叱遂者，以楚國之眾也。今十步之內，王不得恃楚國之眾也，王之命縣於遂手。吾君在前，叱者何也？且遂聞湯以七十里之地王天下，文王以百里之壤而臣諸侯，豈其士卒眾多哉，誠能據其勢而奮其威。今楚地方五千里，持戟百萬，此霸王之資也。以楚之彊，天下弗能當。白起，小豎子耳，率數萬之眾，興師以與楚戰，一戰而舉鄢郢，再戰而燒夷陵，三戰而辱王之先人。此百世之怨而趙之所羞，而王弗知惡焉。合從者爲楚，非爲趙也。吾君在前，叱者何也？」楚王曰：「唯唯，誠若先生之言，謹奉社稷而以從。」毛遂曰：「從定乎？」楚王曰：「定矣。」毛遂謂楚王之左右曰：「取雞狗馬之血來。」毛遂奉銅槃而跪進之楚王曰：「王當歃血而定從，次者吾君，次者遂。」遂定從於殿上。毛遂左手持槃血而右手招十九人曰：「公相與歃此血於堂下。公等錄錄，所謂因人成事者也。」"}],"attestations":[{"id":"th-shiji076-003:a001","paragraph_id":"c-shiji-076-pingyu:p004","start":125,"end":127,"surface":"舍人","person_mention_id":"c-shiji-076-pingyu:m004-0154","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授官、爵位、門下用稱與敘事稱呼分存；未知起訖不補，死亡、亡去或爵印評語不直接終止所有稱號。三去相三復位不合成單一任期，擬爲平原請封而不聽不當實授。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji076-004","person_id":"cbr-p004383","title":"上客","kind":"unclassified","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-076-pingyu","source_id":"s-shiji-076-pingyu","paragraph_id":"c-shiji-076-pingyu:p005","quote":"平原君已定從而歸，歸至於趙，曰：「勝不敢復相士。勝相士多者千人，寡者百數，自以爲不失天下之士，今乃於毛先生而失之也。毛先生一至楚，而使趙重於九鼎大呂。毛先生以三寸之舌，彊於百萬之師。勝不敢復相士。」遂以爲上客。"}],"attestations":[{"id":"th-shiji076-004:a001","paragraph_id":"c-shiji-076-pingyu:p005","start":102,"end":104,"surface":"上客","person_mention_id":"c-shiji-076-pingyu:m005-0075","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-076-pingyu","source_id":"s-shiji-076-pingyu","paragraph_id":"c-shiji-076-pingyu:p005","quote":"平原君已定從而歸，歸至於趙，曰：「勝不敢復相士。勝相士多者千人，寡者百數，自以爲不失天下之士，今乃於毛先生而失之也。毛先生一至楚，而使趙重於九鼎大呂。毛先生以三寸之舌，彊於百萬之師。勝不敢復相士。」遂以爲上客。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授官、爵位、門下用稱與敘事稱呼分存；未知起訖不補，死亡、亡去或爵印評語不直接終止所有稱號。三去相三復位不合成單一任期，擬爲平原請封而不聽不當實授。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji076-010","person_id":"cbr-p004383","surfaces":["先生","毛先生","毛遂","遂"],"scope":"same_chapter","chapter_ids":["c-shiji-076-pingyu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-076-pingyu:p003","quote":"秦之圍邯鄲，趙使平原君求救，合從於楚，約與食客門下有勇力文武備具者二十人偕。平原君曰：「使文能取勝，則善矣。文不能取勝，則歃血於華屋之下，必得定從而還。士不外索，取於食客門下足矣。」得十九人，餘無可取者，無以滿二十人。門下有毛遂者，前，自贊於平原君曰：「遂聞君將合從於楚，約與食客門下二十人偕，不外索。今少一人，願君即以遂備員而行矣。」平原君曰：「先生處勝之門下幾年於此矣？」毛遂曰：「三年於此矣。」平原君曰：「夫賢士之處世也，譬若錐之處囊中，其末立見。今先生處勝之門下三年於此矣，左右未有所稱誦，勝未有所聞，是先生無所有也。先生不能，先生留。」毛遂曰：「臣乃今日請處囊中耳。使遂蚤得處囊中，乃穎脫而出，非特其末見而已。」平原君竟與毛遂偕。十九人相與目笑之而未廢也。"},{"paragraph_id":"c-shiji-076-pingyu:p004","quote":"毛遂比至楚，與十九人論議，十九人皆服。平原君與楚合從，言其利害，日出而言之，日中不決。十九人謂毛遂曰：「先生上。」毛遂按劍歷階而上，謂平原君曰：「從之利害，兩言而決耳。今日出而言從，日中不決，何也？」楚王謂平原君曰：「客何爲者也？」平原君曰：「是勝之舍人也。」楚王叱曰：「胡不下！吾乃與而君言，汝何爲者也！」毛遂按劍而前曰：「王之所以叱遂者，以楚國之眾也。今十步之內，王不得恃楚國之眾也，王之命縣於遂手。吾君在前，叱者何也？且遂聞湯以七十里之地王天下，文王以百里之壤而臣諸侯，豈其士卒眾多哉，誠能據其勢而奮其威。今楚地方五千里，持戟百萬，此霸王之資也。以楚之彊，天下弗能當。白起，小豎子耳，率數萬之眾，興師以與楚戰，一戰而舉鄢郢，再戰而燒夷陵，三戰而辱王之先人。此百世之怨而趙之所羞，而王弗知惡焉。合從者爲楚，非爲趙也。吾君在前，叱者何也？」楚王曰：「唯唯，誠若先生之言，謹奉社稷而以從。」毛遂曰：「從定乎？」楚王曰：「定矣。」毛遂謂楚王之左右曰：「取雞狗馬之血來。」毛遂奉銅槃而跪進之楚王曰：「王當歃血而定從，次者吾君，次者遂。」遂定從於殿上。毛遂左手持槃血而右手招十九人曰：「公相與歃此血於堂下。公等錄錄，所謂因人成事者也。」"},{"paragraph_id":"c-shiji-076-pingyu:p005","quote":"平原君已定從而歸，歸至於趙，曰：「勝不敢復相士。勝相士多者千人，寡者百數，自以爲不失天下之士，今乃於毛先生而失之也。毛先生一至楚，而使趙重於九鼎大呂。毛先生以三寸之舌，彊於百萬之師。勝不敢復相士。」遂以爲上客。"}],"rationale":"依前3段明示姓名與局部回指暫接，平原君趙勝、毛遂先生及明示遂短名限定範圍，取勝為普通詞不當趙勝。躄者、美人及門下前對者各存未名角色，不補名字；齊孟嘗魏信陵楚春申只存本篇所見，待另核跨篇對應。趙諸公子不補父親，三去相三復位未合成單一任期，諸君及十九二十食客群體不補成員。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-076-pingyu:p003","text":"秦之圍邯鄲，趙使平原君求救，合從於楚，約與食客門下有勇力文武備具者二十人偕。平原君曰：「使文能取勝，則善矣。文不能取勝，則歃血於華屋之下，必得定從而還。士不外索，取於食客門下足矣。」得十九人，餘無可取者，無以滿二十人。門下有毛遂者，前，自贊於平原君曰：「遂聞君將合從於楚，約與食客門下二十人偕，不外索。今少一人，願君即以遂備員而行矣。」平原君曰：「先生處勝之門下幾年於此矣？」毛遂曰：「三年於此