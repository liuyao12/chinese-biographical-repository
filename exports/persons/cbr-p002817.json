xima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-046-tian:m049-0022","start":22,"end":23,"surface":"建","kind":"person","person_id":"cbr-p002817","status":"contextual_provisional","paragraph_id":"c-shiji-046-tian:p049","chapter_id":"c-shiji-046-tian"},{"id":"c-shiji-046-tian:m051-0019","start":19,"end":20,"surface":"建","kind":"person","person_id":"cbr-p002817","status":"contextual_provisional","paragraph_id":"c-shiji-046-tian:p051","chapter_id":"c-shiji-046-tian"},{"id":"c-shiji-046-tian:m052-0000","start":0,"end":2,"surface":"王建","kind":"person","person_id":"cbr-p002817","status":"contextual_provisional","paragraph_id":"c-shiji-046-tian:p052","chapter_id":"c-shiji-046-tian"},{"id":"c-shiji-046-tian:m052-0182","start":182,"end":184,"surface":"齊王","kind":"person","person_id":"cbr-p002817","status":"contextual_provisional","paragraph_id":"c-shiji-046-tian:p052","chapter_id":"c-shiji-046-tian"},{"id":"c-shiji-046-tian:m054-0010","start":10,"end":12,"surface":"齊王","kind":"person","person_id":"cbr-p002817","status":"contextual_provisional","paragraph_id":"c-shiji-046-tian:p054","chapter_id":"c-shiji-046-tian"},{"id":"c-shiji-046-tian:m054-0028","start":28,"end":30,"surface":"王建","kind":"person","person_id":"cbr-p002817","status":"contextual_provisional","paragraph_id":"c-shiji-046-tian:p054","chapter_id":"c-shiji-046-tian"},{"id":"c-shiji-046-tian:m054-0101","start":101,"end":103,"surface":"王建","kind":"person","person_id":"cbr-p002817","status":"contextual_provisional","paragraph_id":"c-shiji-046-tian:p054","chapter_id":"c-shiji-046-tian"},{"id":"c-shiji-046-tian:m054-0194","start":194,"end":196,"surface":"王建","kind":"person","person_id":"cbr-p002817","status":"contextual_provisional","paragraph_id":"c-shiji-046-tian:p054","chapter_id":"c-shiji-046-tian"},{"id":"c-shiji-046-tian:m054-0207","start":207,"end":209,"surface":"王建","kind":"person","person_id":"cbr-p002817","status":"contextual_provisional","paragraph_id":"c-shiji-046-tian:p054","chapter_id":"c-shiji-046-tian"},{"id":"c-shiji-046-tian:m056-0072","start":72,"end":74,"surface":"王建","kind":"person","person_id":"cbr-p002817","status":"contextual_provisional","paragraph_id":"c-shiji-046-tian:p056","chapter_id":"c-shiji-046-tian"}],"relations":[{"id":"a-shiji046-031","subject_person_id":"cbr-p002817","predicate":"mother","object_person_id":"cbr-p002778","status":"source_attested","evidence":[{"chapter_id":"c-shiji-046-tian","source_id":"s-shiji-046-tian","paragraph_id":"c-shiji-046-tian:p049","quote":"襄王旣立，立太史氏女爲王后，是爲君王后，生子建。太史敫曰：「女不取媒因自嫁，非吾種也，汙吾世。」終身不睹君王后。君王后賢，不以不睹故失人子之禮。"}],"qualifiers":{"source_term":"君王后，生子建","historicity":"historical_tradition"},"interpretation_note":"明示子、女及生子語境保存；繼位、太子或後宮數量不單獨補世系，其他篇世系仍待核。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji046-032","subject_person_id":"cbr-p002817","predicate":"father","object_person_id":"cbr-p002815","status":"source_attested","evidence":[{"chapter_id":"c-shiji-046-tian","source_id":"s-shiji-046-tian","paragraph_id":"c-shiji-046-tian:p051","quote":"十四年，秦撃我剛壽。十九年，襄王卒，子建立。"}],"qualifiers":{"source_term":"襄王卒，子建立","historicity":"historical_tradition"},"interpretation_note":"明示子、女及生子語境保存；繼位、太子或後宮數量不單獨補世系，其他篇世系仍待核。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji046-111","person_id":"cbr-p002817","scope":"same_chapter","chapter_ids":["c-shiji-046-tian"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["建","王建","齊王"],"evidence":[{"paragraph_id":"c-shiji-046-tian:p049","quote":"襄王旣立，立太史氏女爲王后，是爲君王后，生子建。太史敫曰：「女不取媒因自嫁，非吾種也，汙吾世。」終身不睹君王后。君王后賢，不以不睹故失人子之禮。"},{"paragraph_id":"c-shiji-046-tian:p052","quote":"王建立六年，秦攻趙，齊楚救之。秦計曰：「齊楚救趙，親則退兵，不親遂攻之。」趙無食，請粟於齊，齊不聽。周子曰：「不如聽之以退秦兵，不聽則秦兵不卻，是秦之計中而齊楚之計過也。且趙之於齊楚，捍蔽也，猶齒之有脣也，脣亡則齒寒。今日亡趙，明日患及齊楚。且救趙之務，宜若奉漏甕沃焦釜也。夫救趙，髙義也；卻秦兵，顯名也。義救亡國，威卻彊秦之兵，不務爲此而務愛粟，爲國計者過矣。」齊王弗聽。秦破趙於長平四十餘萬，遂圍邯鄲。"},{"paragraph_id":"c-shiji-046-tian:p054","quote":"四十四年，秦兵撃齊。齊王聽相后勝計，不戰，以兵降秦。秦虜王建，遷之共。遂滅齊爲郡。天下壹并於秦，秦王政立號爲皇帝。始，君王后賢，事秦謹，與諸侯信，齊亦東邊海上，秦日夜攻三晉、燕、楚，五國各自救於秦，以故王建立四十餘年不受兵。君王后死，后勝相齊，多受秦閒金，多使賓客入秦，秦又多予金，客皆爲反閒，勸王去從朝秦，不修攻戰之備，不助五國攻秦，秦以故得滅五國。五國已亡，秦兵卒入臨淄，民莫敢格者。王建遂降，遷於共。故齊人怨王建不蚤與諸侯合從攻秦，聽姦臣賓客以亡其國，歌之曰：「松耶柏耶？住建共者客耶？」疾建用客之不詳也。"},{"paragraph_id":"c-shiji-046-tian:p056","quote":"田完避難，奔于大姜；始辭羈旅，終然鳳皇。物莫兩盛，代五其昌。二君比犯，三晉爭強。和始擅命，威遂稱王。祭急燕、趙，弟列康、莊。秦假東帝，莒立法章。王建失國，松柏蒼蒼。"},{"paragraph_id":"c-shiji-046-tian:p051","quote":"十四年，秦撃我剛壽。十九年，襄王卒，子建立。"}],"rationale":"限本篇明示姓名、是為、繼位及局部事件暫接；姜齊與田齊桓公、不同時段未名王及同字忌分開。孫子不先補孫臏，子守髙唐不補闕字，索隱短稱與代詞仍待核；未跨篇按同名接人。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-046-tian:p049","text":"襄王旣立，立太史氏女爲王后，是爲君王后，生子建。太史敫曰：「女不取媒因自嫁，非吾種也，汙吾世。」終身不睹君王后。君王后賢，不以不睹故失人子之禮。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-046-tian:m049-0000","start":0,"end":2,"surface":"襄王","kind":"person","person_id":"cbr-p002815","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m049-0006","start":6,"end":10,"surface":"太史氏女","kind":"person","person_id":"cbr-p002778","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m049-0016","start":16,"end":19,"surface":"君王后","kind":"person","person_id":"cbr-p002778","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m049-0022","start":22,"end":23,"surface":"建","kind":"person","person_id":"cbr-p002817","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m049-0024","start":24,"end":27,"surface":"太史敫","kind":"person","person_id":"cbr-p002777","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m049-0052","start":52,"end":55,"surface":"君王后","kind":"person","person_id":"cbr-p002778","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m049-0056","start":56,"end":59,"surface":"君王后","kind":"person","person_id":"cbr-p002778","status":"contextual_provisional"}],"chapter_id":"c-shiji-046-tian","book_id":"b-shiji-046","work_id":"w-shiji","source_id":"s-shiji-046-tian"},{"id":"c-shiji-046-tian:p051","text":"十四年，秦撃我剛壽。十九年，襄王卒，子建立。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-046-tian:m051-0014","start":14,"end":16,"surface":"襄王","kind":"person","person_id":"cbr-p002815","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m051-0019","start":19,"end":20,"surface":"建","kind":"person","person_id":"cbr-p002817","status":"contextual_provisional"}],"chapter_id":"c-shiji-046-tian","book_id":"b-shiji-046","work_id":"w-shiji","source_id":"s-shiji-046-tian"},{"id":"c-shiji-046-tian:p052","text":"王建立六年，秦攻趙，齊楚救之。秦計曰：「齊楚救趙，親則退兵，不親遂攻之。」趙無食，請粟於齊，齊不聽。周子曰：「不如聽之以退秦兵，不聽則秦兵不卻，是秦之計中而齊楚之計過也。且趙之於齊楚，捍蔽也，猶齒之有脣也，脣亡則齒寒。今日亡趙，明日患及齊楚。且救趙之務，宜若奉漏甕沃焦釜也。夫救趙，髙義也；卻秦兵，顯名也。義救亡國，威卻彊秦之兵，不務爲此而務愛粟，爲國計者過矣。」齊王弗聽。秦破趙於長平四十餘萬，遂圍邯鄲。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-046-tian:m052-0000","start":0,"end":2,"surface":"王建","kind":"person","person_id":"cbr-p002817","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m052-0050","start":50,"end":52,"surface":"周子","kind":"person","person_id":"cbr-p002818","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m052-0182","start":182,"end":184,"surface":"齊王","kind":"person","person_id":"cbr-p002817","status":"contextual_provisional"}],"chapter_id":"c-shiji-046-tian","book_id":"b-shiji-046","work_id":"w-shiji","source_id":"s-shiji-046-tian"},{"id":"c-shiji-046-tian:p054","text":"四十四年，秦兵撃齊。齊王聽相后勝計，不戰，以兵降秦。秦虜王建，遷之共。遂滅齊爲郡。天下壹并於秦，秦王政立號爲皇帝。始，君王后賢，事秦謹，與諸侯信，齊亦東邊海上，秦日夜攻三晉、燕、楚，五國各自救於秦，以故王建立四十餘年不受兵。君王后死，后勝相齊，多受秦閒金，多使賓客入秦，秦又多予金，客皆爲反閒，勸王去從朝秦，不修攻戰之備，不助五國攻秦，秦以故得滅五國。五國已亡，秦兵卒入臨淄，民莫敢格者。王建遂降，遷於共。故齊人怨王建不蚤與諸侯合從攻秦，聽姦臣賓客以亡其國，歌之曰：「松耶柏耶？住建共者客耶？」疾建用客之不詳也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-046-tian:m054-0010","start":10,"end":12,"surface":"齊王","kind":"person","person_id":"cbr-p002817","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m054-0014","start":14,"end":16,"surface":"后勝","kind":"person","perso