id":"cbr-p004806","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m010-0202","start":202,"end":207,"surface":"舍人千餘人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未分成員，保留原稱不補姓名。"}],"chapter_id":"c-shiji-085-lubuwei","book_id":"b-shiji-085","work_id":"w-shiji","source_id":"s-shiji-085-lubuwei"},{"id":"c-shiji-085-lubuwei:p012","text":"始皇九年，有告嫪毐實非宦者，常與太后私亂，生子二人，皆匿之。與太后謀曰「王即薨，以子為後」。於是秦王下吏治，具得情實，事連相國呂不韋。九月，夷嫪毐三族，殺太后所生兩子，而遂遷太后於雍。諸嫪毐舍人皆沒其家而遷之蜀。王欲誅相國，為其奉先王功大，及賓客辯士為游說者眾，王不忍致法。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-085-lubuwei:m012-0000","start":0,"end":2,"surface":"始皇","kind":"person","person_id":"cbr-p004796","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m012-0007","start":7,"end":9,"surface":"嫪毐","kind":"person","person_id":"cbr-p004806","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m012-0016","start":16,"end":18,"surface":"太后","kind":"person","person_id":"cbr-p004798","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m012-0022","start":22,"end":25,"surface":"子二人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定局部指代保留，未補姓名。"},{"id":"c-shiji-085-lubuwei:m012-0031","start":31,"end":33,"surface":"太后","kind":"person","person_id":"cbr-p004798","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m012-0048","start":48,"end":50,"surface":"秦王","kind":"person","person_id":"cbr-p004796","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m012-0061","start":61,"end":66,"surface":"相國呂不韋","kind":"person","person_id":"cbr-p004790","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m012-0071","start":71,"end":73,"surface":"嫪毐","kind":"person","person_id":"cbr-p004806","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m012-0073","start":73,"end":75,"surface":"三族","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定局部指代保留，未補姓名。"},{"id":"c-shiji-085-lubuwei:m012-0077","start":77,"end":79,"surface":"太后","kind":"person","person_id":"cbr-p004798","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m012-0079","start":79,"end":83,"surface":"所生兩子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定局部指代保留，未補姓名。"},{"id":"c-shiji-085-lubuwei:m012-0087","start":87,"end":89,"surface":"太后","kind":"person","person_id":"cbr-p004798","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m012-0093","start":93,"end":95,"surface":"嫪毐","kind":"person","person_id":"cbr-p004806","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m012-0095","start":95,"end":97,"surface":"舍人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定局部指代保留，未補姓名。"},{"id":"c-shiji-085-lubuwei:m012-0115","start":115,"end":117,"surface":"先王","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定局部指代保留，未補姓名。"},{"id":"c-shiji-085-lubuwei:m012-0121","start":121,"end":125,"surface":"賓客辯士","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定局部指代保留，未補姓名。"}],"chapter_id":"c-shiji-085-lubuwei","book_id":"b-shiji-085","work_id":"w-shiji","source_id":"s-shiji-085-lubuwei"},{"id":"c-shiji-085-lubuwei:p014","text":"歲餘，諸侯賓客使者相望於道，請文信侯。秦王恐其為變，乃賜文信侯書曰：「君何功於秦？秦封君河南，食十萬戶。君何親於秦？號稱仲父。其與家屬徙處蜀！」呂不韋自度稍侵，恐誅，乃飲酖而死。秦王所加怒呂不韋、嫪毐皆已死，乃皆復歸嫪毐舍人遷蜀者。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-085-lubuwei:m014-0003","start":3,"end":9,"surface":"諸侯賓客使者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定局部指代保留，未補姓名。"},{"id":"c-shiji-085-lubuwei:m014-0015","start":15,"end":18,"surface":"文信侯","kind":"person","person_id":"cbr-p004790","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m014-0019","start":19,"end":21,"surface":"秦王","kind":"person","person_id":"cbr-p004796","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m014-0028","start":28,"end":31,"surface":"文信侯","kind":"person","person_id":"cbr-p004790","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m014-0065","start":65,"end":67,"surface":"家屬","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定局部指代保留，未補姓名。"},{"id":"c-shiji-085-lubuwei:m014-0072","start":72,"end":75,"surface":"呂不韋","kind":"person","person_id":"cbr-p004790","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m014-0089","start":89,"end":91,"surface":"秦王","kind":"person","person_id":"cbr-p004796","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m014-0094","start":94,"end":97,"surface":"呂不韋","kind":"person","person_id":"cbr-p004790","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m014-0098","start":98,"end":100,"surface":"嫪毐","kind":"person","person_id":"cbr-p004806","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m014-0108","start":108,"end":110,"surface":"嫪毐","kind":"person","person_id":"cbr-p004806","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m014-0110","start":110,"end":112,"surface":"舍人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定局部指代保留，未補姓名。"}],"chapter_id":"c-shiji-085-lubuwei","book_id":"b-shiji-085","work_id":"w-shiji","source_id":"s-shiji-085-lubuwei"},{"id":"c-shiji-085-lubuwei:p016","text":"太史公曰：不韋及嫪毐貴，封號文信侯。人之告嫪毐，毐聞之。秦王驗左右，未發。上之雍郊，毐恐禍起，乃與黨謀，矯太后璽發卒以反蘄年宮。發吏攻毐，毐敗亡走，追斬之好畤，遂滅其宗。而呂不韋由此絀矣。孔子之所謂「聞」者，其呂子乎？","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-085-lubuwei:m016-0000","start":0,"end":3,"surface":"太史公","kind":"person","person_id":"cbr-p004810","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m016-0005","start":5,"end":7,"surface":"不韋","kind":"person","person_id":"cbr-p004790","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m016-0008","start":8,"end":10,"surface":"嫪毐","kind":"person","person_id":"cbr-p004806","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m0