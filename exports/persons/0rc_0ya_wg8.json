"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-067-xijian","s-shiji-005-qin"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-067-xijian:line076:m0197","start":197,"end":199,"surface":"申胥","kind":"person","person_id":"0rc_0ya_wg8","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-067-xijian:line076","chapter_id":"c-jinshu-067-xijian"},{"id":"c-shiji-005-qin:m044-0122","start":122,"end":125,"surface":"申包胥","kind":"person","person_id":"0rc_0ya_wg8","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p044","chapter_id":"c-shiji-005-qin"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-067-xijian:line076","text":"既而錢鳳攻逼京都，假鑒節，加衛將軍、都督從駕諸軍事。鑒以無益事實，固辭不受軍號。時議者以王含、錢鳳眾力百倍，苑城小而不固，宜及軍勢未成，大駕自出距戰。鑒曰：「群逆縱逸，其勢不可當，可以算屈，難以力競。且含等號令不一，抄盜相尋，百姓懲往年之暴，皆人自為守。乘逆順之勢，何往不剋！且賊無經略遠圖，惟恃豕突一戰，曠日持久，必啟義士之心，令謀猷得展。今以此弱力敵彼彊寇，決勝負於一朝，定成敗於呼吸，雖有申胥之徒，義存投袂，何補於既往哉！」帝從之。鑒以尚書令領諸屯營。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-067-xijian:line076:m0002","start":2,"end":4,"surface":"錢鳳","kind":"person","person_id":"762_5c8_663","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-xijian:line076:m0010","start":10,"end":11,"surface":"鑒","kind":"person","person_id":"6lr_zci_i0j","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-xijian:line076:m0026","start":26,"end":27,"surface":"鑒","kind":"person","person_id":"6lr_zci_i0j","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-xijian:line076:m0044","start":44,"end":46,"surface":"王含","kind":"person","person_id":"mwc_md4_l0g","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-xijian:line076:m0047","start":47,"end":49,"surface":"錢鳳","kind":"person","person_id":"762_5c8_663","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-xijian:line076:m0075","start":75,"end":76,"surface":"鑒","kind":"person","person_id":"6lr_zci_i0j","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-xijian:line076:m0101","start":101,"end":102,"surface":"含","kind":"person","person_id":"mwc_md4_l0g","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-xijian:line076:m0197","start":197,"end":199,"surface":"申胥","kind":"person","person_id":"0rc_0ya_wg8","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-xijian:line076:m0219","start":219,"end":220,"surface":"鑒","kind":"person","person_id":"6lr_zci_i0j","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"source_position":{"first_line":76,"last_line":76,"revision_id":2592755},"source_quote":{"witness":"j67","quote":"既而錢鳳攻逼京都，假鑒節，加衛將軍、都督從駕諸軍事。鑒以無益事實，固辭不受軍號。時議者以王含、錢鳳眾力百倍，苑城小而不固，宜及軍勢未成，大駕自出距戰。鑒曰：「群逆縱逸，其勢不可當，可以算屈，難以力競。且含等號令不一，抄盜相尋，百姓懲往年之暴，皆人自為守。乘逆順之勢，何往不剋！且賊無經略遠圖，惟恃豕突一戰，曠日持久，必啟義士之心，令謀猷得展。今以此弱力敵彼彊寇，決勝負於一朝，定成敗於呼吸，雖有申胥之徒，義存投袂，何補於既往哉！」帝從之。鑒以尚書令領諸屯營。","raw_start":7367,"raw_end":7596,"raw_line":76},"chapter_id":"c-jinshu-067-xijian","book_id":"b-jinshu-067","work_id":"w-jinshu","source_id":"s-jinshu-067-xijian"},{"id":"c-shiji-005-qin:p044","text":"哀公八年，楚公子棄疾弒靈王而自立，是為平王。十一年，楚平王來求秦女為太子建妻。至國，女好而自娶之。十五年，楚平王欲誅建，建亡；伍子胥奔吳。晉公室卑而六卿彊，欲內相攻，是以久秦晉不相攻。三十一年，吳王闔閭與伍子胥伐楚，楚王亡奔隨，吳遂入郢。楚大夫申包胥來告急，七日不食，日夜哭泣。於是秦乃發五百乘救楚，敗吳師。吳師歸，楚昭王乃得復入郢。哀公立三十六年卒。太子夷公，夷公蚤死，不得立，立夷公子，是為惠公。","annotation_status":"in_progress","mentions":[{"id":"c-shiji-005-qin:m044-0000","start":0,"end":2,"surface":"哀公","kind":"person","person_id":"y97_huh_vuz_AAAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m044-0005","start":5,"end":10,"surface":"楚公子棄疾","kind":"person","person_id":"q8m_d0c_kq3_AE","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m044-0011","start":11,"end":13,"surface":"靈王","kind":"person","person_id":"glu_u6e_lf4","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m044-0019","start":19,"end":21,"surface":"平王","kind":"person","person_id":"q8m_d0c_kq3_AE","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m044-0026","start":26,"end":29,"surface":"楚平王","kind":"person","person_id":"q8m_d0c_kq3_AE","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m044-0031","start":31,"end":33,"surface":"秦女","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或待核指代；不由官稱或熟知世系補造個人。"},{"id":"c-shiji-005-qin:m044-0034","start":34,"end":37,"surface":"太子建","kind":"person","person_id":"q8m_d0c_kq3_AEB","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m044-0042","start":42,"end":43,"surface":"女","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或待核指代；不由官稱或熟知世系補造個人。"},{"id":"c-shiji-005-qin:m044-0053","start":53,"end":56,"surface":"楚平王","kind":"person","person_id":"q8m_d0c_kq3_AE","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m044-0058","start":58,"end":59,"surface":"建","kind":"person","person_id":"q8m_d0c_kq3_AEB",