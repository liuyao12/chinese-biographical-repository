id":"c-nanqishu-057-northern-wei-complete"},{"id":"c-nanqishu-057-northern-wei-complete:p037:m0054","start":54,"end":57,"surface":"房伯玉","kind":"person","person_id":"iwp_oqm_zh8","status":"contextual_provisional","paragraph_id":"c-nanqishu-057-northern-wei-complete:p037","chapter_id":"c-nanqishu-057-northern-wei-complete"},{"id":"c-nanqishu-057-northern-wei-complete:p037:m0087","start":87,"end":89,"surface":"伯玉","kind":"person","person_id":"iwp_oqm_zh8","status":"contextual_provisional","paragraph_id":"c-nanqishu-057-northern-wei-complete:p037","chapter_id":"c-nanqishu-057-northern-wei-complete"},{"id":"c-nanqishu-057-northern-wei-complete:p037:m0315","start":315,"end":317,"surface":"伯玉","kind":"person","person_id":"iwp_oqm_zh8","status":"contextual_provisional","paragraph_id":"c-nanqishu-057-northern-wei-complete:p037","chapter_id":"c-nanqishu-057-northern-wei-complete"},{"id":"c-nanqishu-057-northern-wei-complete:p037:m0472","start":472,"end":474,"surface":"伯玉","kind":"person","person_id":"iwp_oqm_zh8","status":"contextual_provisional","paragraph_id":"c-nanqishu-057-northern-wei-complete:p037","chapter_id":"c-nanqishu-057-northern-wei-complete"},{"id":"c-nanqishu-057-northern-wei-complete:p038:m0096","start":96,"end":99,"surface":"房伯玉","kind":"person","person_id":"iwp_oqm_zh8","status":"contextual_provisional","paragraph_id":"c-nanqishu-057-northern-wei-complete:p038","chapter_id":"c-nanqishu-057-northern-wei-complete"},{"id":"c-nanqishu-057-northern-wei-complete:p038:m0293","start":293,"end":296,"surface":"房伯玉","kind":"person","person_id":"iwp_oqm_zh8","status":"contextual_provisional","paragraph_id":"c-nanqishu-057-northern-wei-complete:p038","chapter_id":"c-nanqishu-057-northern-wei-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-057-northern-wei-complete:p029","text":"宏聞高宗踐阼非正，既新移都，兼欲大示威力。是冬，自率大眾分寇豫、徐、司、梁四州。遣偽荊州刺史薛真度、尚書郗祁阿婆出南陽，向沙堨，築壘開溝，為南陽太守房伯玉、新野太守劉思忌所破。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":66,"last_line":66,"raw_start":7511,"raw_end":7599,"raw_character_offsets":[7511,7512,7513,7514,7515,7516,7517,7518,7519,7520,7521,7522,7523,7524,7525,7526,7527,7528,7529,7530,7531,7532,7533,7534,7535,7536,7537,7538,7539,7540,7541,7542,7543,7544,7545,7546,7547,7548,7549,7550,7551,7552,7553,7554,7555,7556,7557,7558,7559,7560,7561,7562,7563,7564,7565,7566,7567,7568,7569,7570,7571,7572,7573,7574,7575,7576,7577,7578,7579,7580,7581,7582,7583,7584,7585,7586,7587,7588,7589,7590,7591,7592,7593,7594,7595,7596,7597,7598],"revision_id":1999801},"mentions":[{"id":"c-nanqishu-057-northern-wei-complete:p029:m0000","start":0,"end":1,"surface":"宏","kind":"person","person_id":"8dc_745_f37","status":"contextual_provisional"},{"id":"c-nanqishu-057-northern-wei-complete:p029:m0002","start":2,"end":4,"surface":"高宗","kind":"person","person_id":"w4m_9tw_147","status":"contextual_provisional"},{"id":"c-nanqishu-057-northern-wei-complete:p029:m0074","start":74,"end":77,"surface":"房伯玉","kind":"person","person_id":"iwp_oqm_zh8","status":"contextual_provisional"},{"id":"c-nanqishu-057-northern-wei-complete:p029:m0082","start":82,"end":85,"surface":"劉思忌","kind":"person","person_id":"eo0_i57_7we","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-057-northern-wei-complete","book_id":"b-nanqishu-057","work_id":"w-nanqishu","source_id":"s-nanqishu-057-northern-wei-complete-ws1999801"},{"id":"c-nanqishu-057-northern-wei-complete:p037","text":"先是偽荊州刺史薛真度、尚書郄祁阿婆為房伯玉所破，宏怒，以南陽小郡，誓取滅之。四年，自率軍向雍州。宏先至南陽，房伯玉嬰城拒守。宏從數萬騎，罩黃繖，去城一里。遣偽中書舍人公孫雲謂伯玉曰：「我今蕩一六合，與先（後）行異。先行冬去春還，不為停久；今誓不有所剋，終不還北，停此或三五年。卿此城是我六龍之首，無容不先攻取。遠一年，中不過百日，近不過一月，非為難殄。若不改迷，當斬卿首，梟之軍門。闔城無貳，幸可改禍為福。但卿有三罪，今令卿知。卿先事武帝，蒙在左右，不能盡節前主，而盡節今主，此是一罪。前歲遣偏師薛真度暫來此，卿遂破傷，此是二罪。武帝之胤悉被誅戮，初無報効，而反為今主盡節，違天害理，此是三罪。不可容恕。聽卿三思，勿令闔城受苦。」伯玉遣軍副樂稚柔答曰：「承欲見攻圍，期於必剋，卑微常人，得抗大威，真可謂獲其死所。先蒙武帝（徒）採〔拔〕，賜預左右，犬馬知恩，寧容無感。但隆昌延興，昏悖違常，聖明纂業，家國不殊。此則進不負心，退不愧幽。前歲薛真度導誘邊氓，遂見陵突，既荷國恩，聊耳撲掃。回己而言，應略此責。」宏引軍向城南寺前頓止，從東南角溝橋上過，伯玉先遣勇士數人著斑衣虎頭帽，從伏竇下忽出，宏人馬驚退，殺數人，宏呼善射將原靈度射之，應弦而倒。宏乃過。宏時大舉南寇，偽咸陽王元憘、彭城王元勰、常侍王元嵩、寶掌王元麗、廣陵侯元燮、都督大將軍劉昶、王肅、楊大眼、奚康生、長孫稚等三十六軍，前後相繼，眾號百萬。其諸王軍朱色鼓，公侯綠色鼓，伯子男黑色鼓，竝有鼙角，吹脣沸地。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":82,"last_line":82,"raw_start":9456,"raw_end":10262,"raw_character_offsets":[9456,9457,9458,9459,9460,9461,9462,9463,9464,9465,9466,9467,9468,9469,9470,9471,9472,9473,9474,9475,9476,9477,9478,9479,9480,9481,9482,9483,9484,9485,9486,9487,9488,9489,9490,9491,9492,9493,9524,9525,9526,9527,9528,9529,9530,9531,9532,9533,9534,9535,9536,9537,9538,9539,9540,9541,9542,9543,9544,9545,9546,9547,9548,9549,9550,9551,9552,9553,9554,9555,9556,9557,9558,9559,9560,9561,9562,9563,9564,9565,9566,9567,9568,9569,9570,9571,9572,9573,9574,9575,9576,9643,9644,9645,9646,9647,9648,9649,9650,9651,9652,9653,9654,9655,9656,9657,9658,9690,9691,9692,9693,9694,9695,9696,9697,9698,9699,9700,9701,9702,9703,9704,9705,9706,9707,9708,9709,9710,9711,9712,9713,9714,9715,9716,9717,9718,9719,9720,9721,9722,9723,9724,9725,9726,9727,9728,9729,9730,9731,9732,9733,9734,9735,9736,9737,9738,9739,9740,9741,9742,9743,9744,9745,9746,9747,9748,9749,9750,9751,9752,9753,9754,9755,9756,9757,9758,9759,9760,9761,9762,9763,9764,9765,9766,9767,9768,9769,9770,9771,9772,9773,9774,9775,9776,9777,9778,9779,9780,9781,9782,9783,9784,9785,9786,9787,9788,9789,9790,9791,9792,9793,9794,9795,9796,9797,9798,9799,9800,9801,9802,9803,9804,9805,9806,9807,9808,9809,9810,9811,9812,9813,9814,9815,9816,9817,9818,9819,9820,9821,9822,9823,9824,9825,9826,9827,9828,9829,9830,9831,9832,9833,9834,9835,9836,9837,9838,9839,9840,9841,9842,9843,9844,9845,9846,9847,9848,9849,9850,9851,9852,9853,9854,9855,9856,9857,9858,9859,9860,9861,9862,9863,9864,9865,9866,9867,9868,9869,9870,9871,9872,9873,9874,9875,9876,9877,9878,9879,9880,9881,9882,9883,9884,9885,9886,9887,9888,9889,9890,9891