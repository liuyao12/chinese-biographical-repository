erson_id":"381_md0_q41","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。"}],"chapter_id":"c-jinshu-099-huanxuan","book_id":"b-jinshu-099","work_id":"w-jinshu","source_id":"s-jinshu-099-huanxuan-ws2644703"},{"id":"c-songshu-048-fuhongzhi:p002","text":"少倜儻有大志，為本州主簿，舉秀才，不行。桓玄將篡，新野人庾仄起兵於南陽，襲雍州刺史馮該，該走。弘之時在江陵，與仄兄子彬謀殺荊州刺史桓石康，以荊州刺史應仄。彬從弟宏知其謀，以告石康，石康收彬殺之，繫弘之於獄。桓玄以弘之非造謀，又白衣無兵眾，原不罪。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":69,"last_line":69,"raw_start":6066,"raw_end":6189,"raw_character_offsets":[6066,6067,6068,6069,6070,6071,6072,6073,6074,6075,6076,6077,6078,6079,6080,6081,6082,6083,6084,6085,6086,6087,6088,6089,6090,6091,6092,6093,6094,6095,6096,6097,6098,6099,6100,6101,6102,6103,6104,6105,6106,6107,6108,6109,6110,6111,6112,6113,6114,6115,6116,6117,6118,6119,6120,6121,6122,6123,6124,6125,6126,6127,6128,6129,6130,6131,6132,6133,6134,6135,6136,6137,6138,6139,6140,6141,6142,6143,6144,6145,6146,6147,6148,6149,6150,6151,6152,6153,6154,6155,6156,6157,6158,6159,6160,6161,6162,6163,6164,6165,6166,6167,6168,6169,6170,6171,6172,6173,6174,6175,6176,6177,6178,6179,6180,6181,6182,6183,6184,6185,6186,6187,6188],"revision_id":1791560},"mentions":[{"id":"c-songshu-048-fuhongzhi:p002:m0020","start":20,"end":22,"surface":"桓玄","kind":"person","person_id":"u9s_w6j_8mc_AAF","status":"contextual_provisional"},{"id":"c-songshu-048-fuhongzhi:p002:m0028","start":28,"end":30,"surface":"庾仄","kind":"person","person_id":"g3n_ce4_ubd","status":"contextual_provisional"},{"id":"c-songshu-048-fuhongzhi:p002:m0041","start":41,"end":43,"surface":"馮該","kind":"person","person_id":"qfe_gev_wl7","status":"contextual_provisional"},{"id":"c-songshu-048-fuhongzhi:p002:m0044","start":44,"end":45,"surface":"該","kind":"person","person_id":"qfe_gev_wl7","status":"contextual_provisional"},{"id":"c-songshu-048-fuhongzhi:p002:m0047","start":47,"end":49,"surface":"弘之","kind":"person","person_id":"258_ae3_26e_AAA","status":"contextual