:"c-shiji-096-zhang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji096-036","person_id":"ht8_t4d_vbc","scope":"same_chapter","chapter_ids":["c-shiji-096-zhang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["陳豨"],"evidence":[{"paragraph_id":"c-shiji-096-zhang:p007","quote":"既行久之，高祖持御史大夫印弄之，曰：「誰可以為御史大夫者？」孰視趙堯，曰：「無以易堯。」遂拜趙堯為御史大夫。堯亦前有軍功食邑，及以御史大夫從擊陳豨有功，封為江邑侯。"},{"paragraph_id":"c-shiji-096-zhang:p010","quote":"任敖者，故沛獄吏。高祖嘗辟吏，吏系呂后，遇之不謹。任敖素善高祖，怒，擊傷主呂后吏。及高祖初起，敖以客從為御史，守豐二歲，高祖立為漢王，東擊項籍，敖遷為上黨守。陳豨反時，敖堅守，封為廣阿侯，食千八百戶。高后時為御史大夫。三歲免，以平陽侯曹窋為御史大夫。高后崩，（不）與大臣共誅呂祿等。免，以淮南相張蒼為御史大夫。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定短稱；韋賢與韋玄成分傳區別，第23段掾陳平另候選，第25段長安相工田文不與孟嘗君合併。趙堯、任敖、申屠嘉、鄧通、晁錯的短名依各段人物語境，王陵夫人與王陵分人。張蒼父長不滿五尺的長為身長敘述，不作父名。王侯與太子未詳名不補名，跨篇同指另待證據。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-096-zhang:p007","text":"既行久之，高祖持御史大夫印弄之，曰：「誰可以為御史大夫者？」孰視趙堯，曰：「無以易堯。」遂拜趙堯為御史大夫。堯亦前有軍功食邑，及以御史大夫從擊陳豨有功，封為江邑侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhang:m007-0005","start":5,"end":7,"surface":"高祖","kind":"person","person_id":"h8q_zyo_i2l","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m007-0032","start":32,"end":34,"surface":"趙堯","kind":"person","person_id":"afb_ahe_sqp","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m007-0041","start":41,"end":42,"surface":"堯","kind":"person","person_id":"afb_ahe_sqp","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m007-0046","start":46,"end":48,"surface":"趙堯","kind":"person","person_id":"afb_ahe_sqp","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m007-0054","start":54,"end":55,"surface":"堯","kind":"person","person_id":"afb_ahe_sqp","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m007-0071","start":71,"end":73,"surface":"陳豨","kind":"person","person_id":"ht8_t4d_vbc","status":"contextual_provisional"}],"chapter_id":"c-shiji-096-zhang","book_id":"b-shiji-096","work_id":"w-shiji","source_id":"s-shiji-096-zhang"},{"id":"c-shiji-096-zhang:p010","text":"任敖者，故沛獄吏。高祖嘗辟吏，吏系呂后，遇之不謹。任敖素善高祖，怒，擊傷主呂后吏。及高祖初起，敖以客從為御史，守豐二歲，高祖立為漢王，東擊項籍，敖遷為上黨守。陳豨反時，敖堅守，封為廣阿侯，食千八百戶。高后時為御史大夫。三歲免，以平陽侯曹窋為御史大夫。高后崩，（不）與大臣共誅呂祿等。免，以淮南相張蒼為御史大夫。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhang:m010-0000","start":0,"end":2,"surface":"任敖","kind":"person","person_id":"yka_hay_sdj","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m010-0009","start":9,"end":11,"surface":"高祖","kind":"person","person_id":"h8q_zyo_i2l","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m010-0017","start":17,"end":19,"surface":"呂后","kind":"person","person_id":"7p1_uko_gaz","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m010-0025","start":25,"end":27,"surface":"任敖","kind":"person","person_id":"yka_hay_sdj","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m010-0029","start":29,"end":31,"surface":"高祖","kind":"person","person_id":"h8q_zyo_i2l","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m010-0037","start":37,"end":39,"surface":"呂后","kind":"person","person_id":"7p1_uko_gaz","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m010-0042","start":42,"end":44,"surface":"高祖","kind":"person","person_id":"h8q_zyo_i2l","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m010-0047","start":47,"end":48,"surface":"敖","kind":"person","person_id":"yka_hay_sdj","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m010-0060","start":60,"end":62,"surface":"高祖","kind":"person","person_id":"h8q_zyo_i2l","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m010-0064","start":64,"end":66,"surface":"漢王","kind":"person","person_id":"h8q_zyo_i2l","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m010-0072","start":72,"end":73,"surface":"敖","kind":"person","person