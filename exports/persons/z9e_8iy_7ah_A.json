t_person_mention_id":"c-weishu-weishou-024-cuidaogu:p001:m0051","object_person_mention_id":"c-weishu-weishou-024-cuidaogu:p001:m0005"}]}],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-beishi-044-cuidaogu:p002","text":"道固字季堅，其母卑賤，嫡母兄攸之、目連等輕侮之。父輯謂攸之曰：「此兒姿識，或能興人門戶，汝等何以輕之？」攸之等遇之彌薄。輯乃資給道固，令其南仕。時宋孝武為徐、兗二州刺史，以道固為從事。道固美形貌，善舉止，習武事，孝武嘉之。會青州刺史新除，過彭城，孝武謂曰：「崔道固人身如此，豈可為寒士？而世人以其偏庶侮之，可為歎息。」刺史至州，辟為主簿。後為宋諸王參軍，被遣青州募人，長史以下並詣道固。道固諸兄等逼其所生自致酒炙於客前。道固驚起接取，謂客曰：「家無人力，老親自執劬勞。」諸客皆知其兄所作，咸拜其母。母謂道固曰：「我賤，不足以報貴賓，汝宜答拜。」諸客皆歎美道固母子，賤其諸兄。後為冀州刺史，鎮曆城。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-beishi-044-cuidaogu:p002:m0000","start":0,"end":2,"surface":"道固","kind":"person","person_id":"23q_wcp_hny","identification_status":"contextual_provisional","interpretation_note":"據本段發言、親屬或任事語境辨識。"},{"id":"c-beishi-044-cuidaogu:p002:m0003","start":3,"end":5,"surface":"季堅","kind":"person","person_id":"23q_wcp_hny","identification_status":"contextual_provisional","interpretation_note":"據本段發言、親屬或任事語境辨識。"},{"id":"c-beishi-044-cuidaogu:p002:m0014","start":14,"end":16,"surface":"攸之","kind":"person","person_id":"z9e_8iy_7ah_A","identification_status":"contextual_provisional","interpretation_note":"據本段發言、親屬或任事語境辨識。"},{"id":"c-beishi-044-cuidaogu:p002:m0017","start":17,"end":19,"surface":"目連","kind":"person","person_id":"z9e_8iy_7ah_B","identification_status":"contextual_provisional","interpretation_note":"據本段發言、親屬或任事語境辨識。"},{"id":"c-beishi-044-cuidaogu:p002:m0025","start":25,"end":26,"surface":"輯","kind":"person","person_id":"z9e_8iy_7ah","identification_status":"contextual_provisional","interpretation_note":"據本段發言、親屬或任事語境辨識。"},{"id":"c-beishi-044-cuidaogu:p002:m0027","start":27,"end":29,"surface":"攸之","kind":"person","person_id":"z9e_8iy_7ah_A","identification_status":"contextual_provisional","interpretation_note":"據本段發言、親屬或任事語境辨識。"},{"id":"c-beishi-044-cuidaogu:p002:m0052","start":52,"end":54,"surface":"攸之","kind":"person","person_id":"z9e_8iy_7ah_A","id