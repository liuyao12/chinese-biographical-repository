{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"syj_umb_ll5","canonical_person_id":"syj_umb_ll5","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["syj_umb_ll5"],"persons":[{"id":"syj_umb_ll5","label":"楊贛（酷吏列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"楊贛","mention_ids":["c-shiji-122-kuli:m030-0241"]}],"evidence":[{"mention_id":"c-shiji-122-kuli:m030-0241","chapter_id":"c-shiji-122-kuli","paragraph_id":"c-shiji-122-kuli:p030","quote":"楊贛"}]}],"source_mention_summary":[{"source_id":"s-shiji122-kuli","work_id":"w-shiji","book_id":"b-shiji-122","chapter_id":"c-shiji-122-kuli","mention_count":1,"mention_ids":["c-shiji-122-kuli:m030-0241"],"paragraph_ids":["c-shiji-122-kuli:p030"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji122-kuli"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-122-kuli:m030-0241","start":241,"end":243,"surface":"楊贛","kind":"person","person_id":"syj_umb_ll5","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p030","chapter_id":"c-shiji-122-kuli"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-122-kuli:p030","text":"素居廣平時，皆知河内豪姦之家，及往，九月而至。令郡具私馬五十匹，爲驛自河内至長安，部吏如居廣平時方略，捕郡中豪猾，郡中豪猾相連坐千餘家。上書請，大者至族，小者乃死，家盡沒入償臧。奏行不過二三日，得可事。論報，至流血十餘里。河内皆怪其奏，以爲神速。盡十二月，郡中毋聲，毋敢夜行，野無犬吠之盜。其頗不得，失之旁郡國，黎來，會春，温舒頓足嘆曰：「嗟乎，令冬月益展一月，足吾事矣！」其好殺伐行威不愛人如此。天子聞之，以爲能，遷爲中尉。其治復放河内，徙諸名禍猾吏與從事，河内則楊皆、麻戊，關中楊贛、成信等。義縱爲内史，憚未敢恣治。及縱死，張湯敗後，徙爲廷尉，而尹齊爲中尉。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-122-kuli:m030-0052","start":52,"end":56,"surface":"郡中豪猾","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m030-0057","start":57,"end":61,"surface":"郡中豪猾","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m030-0064","start":64,"end":67,"surface":"千餘家","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m030-0162","start":162,"end":164,"surface":"温舒","kind":"person","person_id":"6ym_eva_k4a","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m030-0199","start":199,"end":201,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m030-0222","start":222,"end":226,"surface":"名禍猾吏","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m030-0233","start":233,"end":235,"surface":"楊皆","kind":"person","person_id":"i94_cco_pt9","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m030-0236","start":236,"end":238,"surface":"麻戊","kind":"person","person_id":"jfj_ky5_9lg","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m030-0241","start":241,"end":243,"surface":"楊贛","kind":"person","person_id":"syj_umb_ll5","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m030-0244","start":244,"end":246,"surface":"成信","kind":"person","person_id":"gbb_0p6_20p","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m030-0248","start":248,"end":250,"surface":"義縱","kind":"person","person_id":"sg1_243_d92","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m030-0261","start":261,"end":262,"surface":"縱","kind":"person","person_id":"sg1_243_d92","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m030-0264","start":