"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"start":69,"end":72,"surface":"張法順","id":"c-nanshi-019-xieyu-descendants:p001:m0069","person_id":"xee_hex_u4o","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作張法順。","paragraph_id":"c-nanshi-019-xieyu-descendants:p001","chapter_id":"c-nanshi-019-xieyu-descendants"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanshi-019-xieyu-descendants:p001","text":"謝裕字景仁，朗弟允之子、而晦從父也。名與宋武帝諱同，故以字行。允字令度，位宣城內史。景仁幼爲從祖安所知，始爲前軍行參軍，會稽王世子元顯嬖人張法順權傾一時，內外無不造門，唯景仁不至，年三十而方爲著作佐郎。桓玄誅元顯，見景仁，謂四坐曰：「司馬庶人父子雲何不敗，遂令謝景仁三十而方佐著作郎。」玄建楚臺，以補黃門侍郎。及篡位，領驍騎將軍。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"start":0,"end":2,"surface":"謝裕","id":"c-nanshi-019-xieyu-descendants:p001:m0000","person_id":"684_eaa_511","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作謝裕。"},{"start":3,"end":5,"surface":"景仁","id":"c-nanshi-019-xieyu-descendants:p001:m0003","person_id":"684_eaa_511","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作謝裕。"},{"start":6,"end":7,"surface":"朗","id":"c-nanshi-019-xieyu-descendants:p001:m0006","person_id":"aa6_83c_juy_AA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作謝朗。"},{"start":8,"end":9,"surface":"允","id":"c-nanshi-019-xieyu-descendants:p001:m0008","person_id":"aa6_83c_juy_AB","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作謝允。"},{"start":13,"end":14,"surface":"晦","id":"c-nanshi-019-xieyu-descendants:p001:m0013","person_id":"aa6_83c_juy_AAAA","kin