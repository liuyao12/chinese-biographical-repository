{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"s8f_r7z_fb9","canonical_person_id":"s8f_r7z_fb9","id_aliases":["cbr-p002752"],"identity_policy":"contextual_provisional","person_ids":["s8f_r7z_fb9"],"persons":[{"id":"s8f_r7z_fb9","label":"晏圉（田世家校改讀法未定候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"晏（孺子）［圉］","mention_ids":["c-shiji-046-tian:m009-0227"]}],"evidence":[{"mention_id":"c-shiji-046-tian:m009-0227","chapter_id":"c-shiji-046-tian","paragraph_id":"c-shiji-046-tian:p009","quote":"晏（孺子）［圉］"}],"id_aliases":["cbr-p002752"]}],"source_mention_summary":[{"source_id":"s-shiji-046-tian","work_id":"w-shiji","book_id":"b-shiji-046","chapter_id":"c-shiji-046-tian","mention_count":1,"mention_ids":["c-shiji-046-tian:m009-0227"],"paragraph_ids":["c-shiji-046-tian:p009"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-046-tian"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-046-tian:m009-0227","start":227,"end":235,"surface":"晏（孺子）［圉］","kind":"person","person_id":"s8f_r7z_fb9","status":"contextual_provisional","paragraph_id":"c-shiji-046-tian:p009","chapter_id":"c-shiji-046-tian"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji046-046","person_id":"s8f_r7z_fb9","surfaces":["晏（孺子）［圉］"],"scope":"same_chapter","chapter_ids":["c-shiji-046-tian"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-046-tian:p009","quote":"景公太子死，後有寵姬曰芮子，生子荼。景公病，命其相國惠子與髙昭子以子荼爲太子。景公卒，兩相髙、國立荼，是爲晏孺子。而田乞不説，欲立景公他子陽生。陽生素與乞歡。晏孺子之立也，陽生奔魯。田乞偽事髙昭子、國惠子者，毎朝代參乘，言曰：「始諸大夫不欲立孺子。孺子旣立，君相之，大夫皆自危，謀作亂。」又紿大夫曰：「髙昭子可畏也，及未發先之。」諸大夫從之。田乞、鮑牧與大夫以兵入公室，攻髙昭子。昭子聞之，與國惠子救公。公師敗。田乞之衆追國惠子，惠子奔莒，遂返殺髙昭子。晏（孺子）［圉］奔魯。"}],"rationale":"限本篇明示姓名、是為、繼位及局部事件暫接；姜齊與田齊桓公、不同時段未名王及同字忌分開。孫子不先補孫臏，子守髙唐不補闕字，索隱短稱與代詞仍待核；未跨篇按同名接人。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-046-tian:p009","text":"景公太子死，後有寵姬曰芮子，生子荼。景公病，命其相國惠子與髙昭子以子荼爲太子。景公卒，兩相髙、國立荼，是爲晏孺子。而田乞不説，欲立景公他子陽生。陽生素與乞歡。晏孺子之立也，陽生奔魯。田乞偽事髙昭子、國惠子者，毎朝代參乘，言曰：「始諸大夫不欲立孺子。孺子旣立，君相之，大夫皆自危，謀作亂。」又紿大夫曰：「髙昭子可畏也，及未發先之。」諸大夫從之。田乞、鮑牧與大夫以兵入公室，攻髙昭子。昭子聞之，與國惠子救公。公師敗。田乞之衆追國惠子，惠子奔莒，遂返殺髙昭子。晏（孺子）［圉］奔魯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-046-tian:m009-0000","start":0,"end":2,"surface":"景公","kind":"person","person_id":"yht_8tu_hv4","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m009-0002","start":2,"end":4,"surface":"太子","kind":"person","person_id":"taq_82s_0na","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m009-0011","start":11,"end":13,"surface":"芮子","kind":"person","person_id":"x4n_p1z_u9i","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m009-0015","start":15,"end":17,"surface":"子荼","kind":"person","person_id":"yht_8tu_hv4_A","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m009-0018","start":18,"end":20,"surface":"景公","kind":"person","person_id":"yht_8tu_hv4","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m009-0025","start":25,"end":28,"surface":"國惠子","kind":"person","person_id":"v2h_v2x_1au","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m009-0029","start":29,"end":32,"surface":"髙昭子","kind":"person","person_id":"y56_c4g_fbf","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m009-0033","start":33,"end":35,"surface":"子荼","kind":"person","person_id":"yht_8tu_hv4_A","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m009-0039","start":39,"end