ceived_sentence2-0","kind":"received_sentence","person_id":"601_nk5_c8m","source_quote":"元嘉九年，豫州刺史長沙王義欣上言：「所統威遠將軍、北譙梁二郡太守關中侯申季歷，自奉職邦畿，于茲五年，信惠並宣，威化兼著，外清姦暴，內輯民黎，役賦均平，閭井齊肅，綏穆初附，招攜荒遠，郊境之外，仰澤懷風，爵賞之授，績能是顯，宜升階秩，以崇奬勸。」","reading":"元嘉九年，長沙王劉義欣奏申季歷治北譙、梁二郡，在任五年。","note":"元嘉九年，長沙王劉義欣奏申季歷治北譙、梁二郡，在任五年。","paragraph_id":"c-songshu-092-xunli-xunxing:p002","start_codepoint":0,"end_codepoint":121,"human_reviewed":false,"chapter_id":"c-songshu-092-xunli-xunxing","source_id":"s-songshu-092-xunli-xunxing-ws2195614"},{"id":"c-songshu-092-xunli-xunxing:received_sentence2-121","kind":"received_sentence","person_id":"601_nk5_c8m","source_quote":"進號寧朔將軍。","reading":"記治績及進寧朔將軍，不據五年推始任月日。","note":"記治績及進寧朔將軍，不據五年推始任月日。","paragraph_id":"c-songshu-092-xunli-xunxing:p002","start_codepoint":121,"end_codepoint":128,"human_reviewed":false,"chapter_id":"c-songshu-092-xunli-xunxing","source_id":"s-songshu-092-xunli-xunxing-ws2195614"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-songshu-092-xunli-xunxing:p002:m0035","start":35,"end":38,"surface":"申季歷","kind":"person","person_id":"601_nk5_c8m","status":"contextual_provisional","paragraph_id":"c-songshu-092-xunli-xunxing:p002","chapter_id":"c-songshu-092-xunli-xunxing"}],"relations":[],"title_holdings":[{"id":"th-songshu-092-xunli-xunxing-2-20","title":"威遠將軍","kind":"office","mode":"attestation","person_id":"601_nk5_c8m","attestations":[{"id":"th-songshu-092-xunli-xunxing-2-20:a","paragraph_id":"c-songshu-092-xunli-xunxing:p002","start":20,"end":24,"surface":"威遠將軍","person_mention_id":"c-songshu-092-xunli-xunxing:p002:m0035","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{