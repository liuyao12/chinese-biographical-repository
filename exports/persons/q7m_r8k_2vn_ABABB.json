gxi-qian:p002","quote":"錫","mention_id":"c-nanshi-023-wangxi-qian:p002:m0157"},{"work_id":"w-nanshi","book_id":"b-nanshi-023","source_id":"s-nanshi-023-wangxi-qian-ws2478204","chapter_id":"c-nanshi-023-wangxi-qian","paragraph_id":"c-nanshi-023-wangxi-qian:p003","quote":"錫","mention_id":"c-nanshi-023-wangxi-qian:p003:m0117"}],"identity_note":"《梁書》稱琳之第二子，字公嘏；與《宋書》王弘之子王錫為異人。","review":"ai_provisional","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"q7m_r8k_2vn_ABA","source_assertion_id":"a-liangshu-021-wangfen-m0000-xi-father","evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-021","chapter_id":"c-liangshu-021-wangfen","source_id":"s-liangshu-021-wangfen-ws1544250","paragraph_id":"c-liangshu-021-wangfen:p005","quote":"錫字公嘏，琳之第二子也。幼而警悟，與兄弟受業，至應休散，常獨留不起。年七八歲，猶隨公主入宮，高祖嘉其聰敏，常爲朝士說之。精力不倦，致損右目。公主每節其業，爲飾居宇。雖童稚之中，一無所好。十二，爲國子生。十四，舉清茂，除秘書郎，與范陽張伯緒齊名，俱爲太子舍人。丁父憂，居喪盡禮。服闋，除太子洗馬。時昭明尚幼，未與臣僚相接。高祖敕：「太子洗馬王錫、秘書郎張纘，親表英華，朝中髦俊，可以師友事之。」以戚屬封永安侯，除晉安王友，稱疾不行，敕許受詔停都。王冠日，以府僚攝事。","subject_person_mention_id":"c-liangshu-021-wangfen:p005:m0000","object_person_mention_id":"c-liangshu-021-wangfen:p005:m0005","source_term":"琳之第二子"}],"status":"contextual_provisional","human_reviewed":false,"interpretation_note":"原文同句具名父子及排行。"}},{"id":"q7m_r8k_2vn_ABABA","label":"王㳬","status":"active","historicity":"historical_tradition","aliases":[{"surface":"王㳬","mention_ids":["c-zhoushu-048-zhou48:p001:m0000"]},{"surface":"㳬","mention_ids":["c-zhoushu-048-zhou48:p001:m0025","c-zhoushu-048-zhou48:p001:m0109"]},{"surface":"泛","mention_ids":["c-liangshu-021-liang21:p001:m0001","c-liangshu-021-wangfen:p011:m0001"]},{"surface":"涉","mention_ids":["c-nanshi-023-nan23:p001:m0009","c-nanshi-023-wangxi-qian:p003:m0097"]}],"evidence":[{"work_id":"w-zhoushu","book_id":"b-zhoushu-048","chapter_id":"c-zhoushu-048-zhou48","source_id":"s-zhoushu-048-zhou48-ws2432546","paragraph_id":"c-zhoushu-048-zhou48:p001","quote":"王㳬","mention_id":"c-zhoushu-048-zhou48:p001:m0000"},{"work_id":"w-zhoushu","book_id":"b-zhoushu-048","chapter_id":"c-zhoushu-048-zhou48","source_id":"s-zhoushu-048-zhou48-ws2432546","paragraph_id":"c-zhoushu-048-zhou48:p001","quote":"㳬","mention_id":"c-zhoushu-048-zhou48:p001:m0025"},{"work_id":"w-zhoushu","book_id":"b-zhoushu-048","chapter_id":"c-zhoushu-048-zhou48","source_id":"s-zhoushu-048-zhou48-ws2432546","paragraph_id":"c-zhoushu-048-zhou48:p001","quote":"㳬","mention_id":"c-zhoushu-048-zhou48:p001:m0109"},{"work_id":"w-liangshu","book_id":"b-liangshu-021","chapter_id":"c-liangshu-021-liang21","source_id":"s-liangshu-021-liang21-ws1544250","paragraph_id":"c-liangshu-021-liang21:p001","quote":"泛","mention_id":"c-liangshu-021-liang21:p001:m0001"},{"work_id":"w-nanshi","book_id":"b-nanshi-023","chapter_id":"c-nanshi-023-nan23","source_id":"s-nanshi-023-nan23-ws2478204","paragraph_id":"c-nanshi-023-nan23:p001","quote":"涉","mention_id":"c-nanshi-023-nan23:p001:m0009"},{"work_id":"w-liangshu","book_id":"b-liangshu-021","source_id":"s-liangshu-021-wangfen-ws1544250","chapter_id":"c-liangshu-021-wangfen","paragraph_id":"c-liangshu-021-wangfen:p011","quote":"泛","mention_id":"c-liangshu-021-wangfen:p011:m0001"},{"work_id":"w-nanshi","book_id":"b-nanshi-023","source_id":"s-nanshi-023-wangxi-qian-ws2478204","chapter_id":"c-nanshi-023-wangxi-qian","paragraph_id":"c-nanshi-023-wangxi-qian:p003","quote":"涉","mention_id":"c-nanshi-023-wangxi-qian:p003:m0097"}],"identity_note":"《周書》明記祖琳、父錫、弟湜。梁書作泛，南史作涉；父子敘事及弟湜相合。","review":"ai_provisional","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"q7m_r8k_2vn_ABAB","source_assertion_id":"a-zhoushu-048-zhou48-m0000-family-father","evidence":[{"work_id":"w-zhoushu","book_id":"b-zhoushu-048","chapter_id":"c-zhoushu-048-zhou48","source_id":"s-zhoushu-048-zhou48-ws2432546","paragraph_id":"c-zhoushu-048-zhou48:p001","quote":"王㳬，琅邪臨沂人。祖琳，侍中、太府卿。父錫，侍中。㳬少有令譽，尚詧妹廬陵長公主。歷祕書郎、太子舍人、宣成王友、廬陵內史。詧踐位，授侍中、吏部尚書。巋之四年，使詣闕，卒於賓館。贈侍中、右光祿大夫。子瓘，有文詞，黃門侍郎。㳬弟湜，方雅有器識。位至都官尚書。巋之二十年，卒。子懷，祕書郎，隋沔陽令。","subject_person_mention_id":"c-zhoushu-048-zhou48:p001:m0000","object_person_mention_id":"c-zhoushu-048-zhou48:p001:m0020","source_term":"父錫"}],"status":"contextual_provisional","human_reviewed":false,"interpretation_note":"王㳬傳首具名父錫。"}},{"id":"q7m_r8k_2vn_ABABB","label":"王湜","status":"active","historicity":"historical_tradition","aliases":[{"surface":"湜","mention_ids":["c-zhoushu-048-zhou48:p001:m0111","c-liangshu-021-liang21:p001:m0003","c-nanshi-023-nan23:p001:m0011","c-liangshu-021-wangfen:p011:m0003","c-nanshi-023-wangxi-qian:p003:m0099"]}],"evidence":[{"work_id":"w-zhoushu","book_id":"b-zhoushu-048","chapter_id":"c-zhoushu-048-zhou48","source_id":"s-zhoushu-048-zhou48-ws2432546","paragraph_id":"c-zhoushu-048-zhou48:p001","quote":"湜","mention_id":"c-zhoushu-048-zhou48:p001:m0111"},{"work_id":"w-liangshu","book_id":"b-liangshu-021","chapter_id":"c-liangshu-021-liang21","source_id":"s-liangshu-021-liang21-ws1544250","paragraph_id":"c-liangshu-021-liang21:p001","quote":"湜","mention_id":"c-liangshu-021-liang21:p001:m0003"},{"work_id":"w-nanshi","book_id":"b-nanshi-023","chapter_id":"c-nanshi-023-nan23","source_id":"s-nanshi-023-nan23-ws2478204","paragraph_id":"c-nanshi-023-nan23:p001","quote":"湜","mention_id":"c-nanshi-023-nan23:p001:m0011"},{"work_id":"w-liangshu","book_id":"b-liangshu-021","source_id":"s-liangshu-021-wangfen-ws1544250","chapter_id":"c-liangshu-021-wangfen","paragraph_id":"c-liangshu-021-wangfen:p011","quote":"湜","mention_id":"c-liangshu-021-wangfen:p011:m0003"},{"work_id":"w-nanshi","book_id":"b-nanshi-023","source_id":"s-nanshi-023-wangxi-qian-ws2478204","chapter_id":"c-nanshi-023-wangxi-qian","paragraph_id":"c-nanshi-023-wangxi-qian:p003","quote":"湜","mention_id":"c-nanshi-023-wangxi-qian:p003:m0099"}],"identity_note":"《周書》明記王㳬之弟；梁書、南史附王錫傳均列湜。","review":"ai_provisional"},{"id":"q7m_r8k_2vn_ABABBA","label":"王懷","status":"active","historicity":"historical_tradition","aliases":[{"surface":"懷","mention_ids":["c-zhoushu-048-zhou48:p001:m0135"]}],"evidence":[{"work_id":"