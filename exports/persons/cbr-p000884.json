extual_provisional"}],"chapter_id":"c-shiji-010-wendi","book_id":"b-shiji-010","work_id":"w-shiji","source_id":"s-shiji-010-wendi"},{"id":"c-shiji-010-wendi:p022","text":"濟北王興居聞帝之代，欲往擊胡，乃反，發兵欲襲滎陽。於是詔罷丞相兵，遣棘蒲侯陳武為大將軍，將十萬往擊之。祁侯賀為將軍，軍滎陽。七月辛亥，帝自太原至長安。乃詔有司曰：「濟北王背德反上，詿誤吏民，為大逆。濟北吏民兵未至先自定，及以軍地邑降者，皆赦之，復官爵。與王興居去來，亦赦之。」八月，破濟北軍，虜其王。赦濟北諸吏民與王反者。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-010-wendi:m022-0000","start":0,"end":5,"surface":"濟北王興居","kind":"person","person_id":"cbr-p000851","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m022-0006","start":6,"end":7,"surface":"帝","kind":"person","person_id":"cbr-p000806","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m022-0037","start":37,"end":39,"surface":"陳武","kind":"person","person_id":"cbr-p000884","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m022-0051","start":51,"end":54,"surface":"祁侯賀","kind":"person","person_id":"cbr-p000900","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m022-0067","start":67,"end":68,"surface":"帝","kind":"person","person_id":"cbr-p000806","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m022-0082","start":82,"end":85,"surface":"濟北王","kind":"person","person_id":"cbr-p000851","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m022-0127","start":127,"end":130,"surface":"王興居","kind":"person","person_id":"cbr-p000851","status":"contextual_provisional"}],"chapter_id":"c-shiji-010-wendi","book_id":"b-shiji-010","work_id":"w-shiji","source_id":"s-shiji-010-wendi"}],"sources":[{"chapter_id":"c-shiji-010-wendi","work_id":"w-shiji","book_id":"b-shiji-010","source_id":"s-shiji-010-wendi","source":{"title":"史記／卷010","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷010","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷010&oldid=2599229","revision_id":2599229,"accessed_on":"2026-10-09","extent":"正文41個p區塊，自孝文皇帝至太史公論贊；排除前置跨站dd及末尾索隱述贊。","image_verified":false,"rights":