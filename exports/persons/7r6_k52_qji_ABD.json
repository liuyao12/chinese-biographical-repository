jinshu-076-wangyi-family","source_id":"s-jinshu-076-wangyi-family","paragraph_id":"c-jinshu-076-wangyi-family:p001","quote":"王廙，字世將，丞相導從弟，而元帝姨弟也。父正，尚書郎。廙少能屬文，多所通涉，工書畫，善音樂、射御、博弈、雜伎。辟太傅掾，轉參軍。豫迎大駕，封武陵縣侯，拜尚書郎，出為濮陽太守。元帝作鎮江左，廙棄郡過江。帝見之大悅，以為司馬。頻守廬江、鄱陽二郡。豫討周馥、杜韜，以功累增封邑，除冠軍將軍，鎮石頭，領丞相軍諮祭酒。王敦啟為甯遠將軍、荊州刺史。","person_mention_id":"c-jinshu-076-wangyi-family:p001:m0021"}],"attestations":[{"id":"th-jinshu076-wang-002:a001","paragraph_id":"c-jinshu-076-wangyi-family:p001","start":23,"end":26,"surface":"尚書郎","person_mention_id":"c-jinshu-076-wangyi-family:p001:m0021","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"只按本段任官、授爵或用稱；未知起訖不補。義熙末保留晚期原語，不選定某一年。未將疑缺平南將領字串補成平南將軍。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-jinshu-076-cross-001","person_id":"7r6_k52_qji_ABD","surfaces":["正"],"scope":"cross_chapter","chapter_ids":["c-jinshu-076-wangyi-family","c-jinshu-033-wanglan-family"],"status":"contextual_provisional","confidence_level":"high","identification_basis":{"kind":"source_context","target_mention_ids":["c-jinshu-076-wangyi-family:p001:m0021","c-jinshu-033-wanglan-family:p006:m0026"]},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-076","chapter_id":"c-jinshu-076-wangyi-family","source_id":"s-jinshu-076-wangyi-family","paragraph_id":"c-jinshu-076-wangyi-family:p001","quote":"王廙，字世將，丞相導從弟，而元帝姨弟也。父正，尚書郎。廙少能屬文，多所通涉，工書畫，善音樂、射御、博弈、雜伎。辟太傅掾，轉參軍。豫迎大駕，封武陵縣侯，拜尚書郎，出為濮陽太守。元帝作鎮江左，廙棄郡過江。帝見之大悅，以為司馬。頻守廬江、鄱陽二郡。豫討周馥、杜韜，以功累增封邑，除冠軍將軍，鎮石頭，領丞相軍諮祭酒。王敦啟為甯遠將軍、荊州刺史。"},{"work_id":"w-jinshu","book_id":"b-jinshu-033","chapter_id":"c-jinshu-033-wanglan-family","source_id":"s-jinshu-033-wanglan-family","paragraph_id":"c-jinshu-033-wanglan-family:p006","quote":"咸寧四年卒，時年七十三，諡曰貞。有六子：裁、基、會、正、彥、琛。"}],"rationale":"卷76廙父正尚書郎與卷33王覽六子之正尚書郎相合；另有廙為導從弟，導父裁與正同屬覽六子，按具名家世及官職接合，不憑正字孤立合人。","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-033-wanglan-family:p005","text":"覽孝友恭恪，名亞於祥。及祥仕進，覽亦應本郡之召，稍遷司徒西曹掾、清河太守。五等建，封即丘子，邑六百戸。泰始末，除弘訓少府。職省，轉太中大夫，祿賜與卿同。咸甯初，詔曰：「覽少篤至行，服仁履義，貞素之操，長而彌固。其以覽爲宗正卿。」頃之，以疾上疏乞骸骨。詔聽之，乙太中大夫歸老，賜錢二十萬，床帳薦褥，遣殿中醫療疾給藥。後轉光祿大夫，門施行馬。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-033-wanglan-family:p005:m0000","start":0,"end":1,"surface":"覽","kind":"person","person_id":"7r6_k52_qji_AB","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p005:m0009","start":9,"end":10,"surface":"祥","kind":"person","person_id":"7r6_k52_qji_AA","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p005:m0012","start":12,"end":13,"surface":"祥","kind":"person","person_id":"7r6_k52_qji_AA","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p005:m0016","start":16,"end":17,"surface":"覽","kind":"person","person_id":"7r6_k52_qji_AB","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p005:m0084","start":84,"end":85,"surface":"覽","kind":"person","person_id":"7r6_k52_qji_AB","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p005:m0107","start":107,"end":108,"surface":"覽","kind":"person","person_id":"7r6_k52_qji_AB","status":"contextual_provisional"}],"source_position":{"first_line":41,"last_line":42,"revision_id":2650519,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-033-wanglan-family","book_id":"b-jinshu-033","work_id":"w-jinshu","source_id":"s-jinshu-033-wanglan-family"},{"id":"c-jinshu-033-wanglan-family:p006","text":"咸寧四年卒，時年七十三，諡曰貞。有六子：裁、基、會、正、彥、琛。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-033-wanglan-family:p006:m0020","start":20,"end":21,"surface":"裁","kind":"person","person_id":"7r6_k52_qji_ABA","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p006:m0022","start":22,"end":23,"surface":"基","kind":"person","person_id":"7r6_k52_qji_ABB","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p006:m0024","start":24,"end":25,"surface":"會","kind":"person","person_id":"7r6_k52_qji_ABC","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p006:m0026","start":26,"end":27,"surface":"正","kind":"person","person_id":"7r6_k52_qji_ABD","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p006:m0028","start":28,"end":29,"surface":"彥","kind":"person","person_id":"7r6_k52_qji_ABE","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p006:m0030","start":30,"end":31,"surface":"琛","kind":"person","person_id":"7r6_k52_qji_ABF","status":"contextual_provisional"}],"source_position":{"first_line":43,"last_line":44,"revision_id":2650519,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-033-wanglan-family","book_id":"b-jinshu-033","work_id":"w-jinshu","source_id":"s-jinshu-033-wanglan-family"},{"id":"c-jinshu-033-wanglan-family:p007","text":"裁字士初，撫軍長史。基字士先，治書御史。會字士和，侍御史。正字士則，尚書郎。彥字士治，中護軍。琛字士瑋，國子祭酒。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-033-wanglan-family:p007:m0000","start":0,"end":1,"surface":"裁","kind":"person","person_id":"7r6_k52_qji_ABA","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p007:m0002","start":2,"end":4,"surface":"士初","kind":"person","person_id":"7r6_k52_qji_ABA","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p007:m0010","start":10,"end":11,"surface":"基","kind":"person","person_id":"7r6_k52_qji_ABB","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p007:m0012","start":12,"end":14,"surface":"士先","kind":"person","person_id":"7r6_k52_qji_ABB","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p007:m0020","start":20,"end":21,"surface":"會","kind":"person","person_id":"7r6_k52_qji_ABC","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p007:m0022","start":22,"end":24,"surface":"士和","kind":"person","person_id":"7r6_k52_qji_ABC","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p007:m0029","start":29,"end":30,"surface":"正","kind":"person","person_id":"7r6_k52_qji_ABD","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p007:m0031","start":31,"end":33,"surface":"士則","kind":"person","person_id":"7r6_k52_qji_ABD","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p007:m0038","start":38,"end":39,"surface":"彥","kind":"person","person_id":"7r6_k52_qji_ABE","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p007:m0040","start":40,"end":42,"surface":"士治","kind":"person","person_id":"7r6_k52_qji_ABE","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p007:m0047","start":47,"end":48,"surface":"琛","kind":"person","person_id":"7r6_k52_qji_ABF","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p007:m0049","start":49,"end":51,"surface":"士瑋","kind":"person","person_id":"7r6_k52_qji_ABF","status":"contextual_provisional"}],"source_position":{"first_line":45,"last_line":46,"revision_id":2650519,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-033-wanglan-family","book_id":"b-jinshu-033","work_id":"w-jinshu","source_id":"s-jinshu-033-wanglan-family"},{"id":"c-jinshu-076-wangyi-family:p001","text":"王廙，字世將，丞相導從弟，而元帝姨弟也。父正，尚書郎。廙少能屬文，多所通涉，工書畫，善音樂、射御、博弈、雜伎。辟太傅掾，轉參軍。豫迎大駕，封武陵縣侯，拜尚書郎，出為濮陽太守。元帝作鎮江左，廙棄郡過江。帝見之大悅，以為司馬。頻守廬江、鄱陽二郡。豫討周馥、杜韜，以功累增封邑，除冠軍將軍，鎮石頭，領丞相軍諮祭酒。王敦啟為甯遠將軍、荊州刺史。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-076-wangyi-family:p001:m0000","start":0,"end":2,"surface":"王廙","kind":"person","person_id":"7r6_k52_qji_ABDA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p001:m0004","start":4,"end":6,"surface":"世將","kind":"person","person_id":"7r6_k52_qji_ABDA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p001:m0009","start":9,"end":10,"surface":"導","kind":"person","person_id":"7r6_k52_qji_ABAA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p001:m0014","start":14,"end":16,"surface":"元帝","kind":"person","person_id":"dkn_ge4_286_AAAAAAA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p001:m0021","start":21,"end":22,"surface":"正","kind":"person","person_id":"7r6_k52_qji_ABD","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p001:m0027","start":27,"end":28,"surface":"廙","kind":"person","person_id":"7r6_k52_qji_ABDA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p001:m0087","start":87,"end":89,"surface":"元帝","kind":"person","person_id":"dkn_ge4_286_AAAAAAA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p001:m0094","start":94,"end":95,"surface":"廙","kind":"person","person_id":"7r6_k52_qji_ABDA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p001:m0100","start":100,"end":101,"surface":"帝","kind":"person","person_id":"dkn_ge4_286_AAAAAAA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p001:m0123","start":123,"end":125,"surface":"周馥","kind":"person","person_id":"tl4_ams_1tg","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p001:m0126","start":126,"end":128,"surface":"杜韜","kind":"person","person_id":"8v6_1vp_sfc","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p001:m0154","start":154,"end":156,"surface":"王敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional"}],"source_position":{"first_line":27,"last_line":28,"revision_id":2180533,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-076-wangyi-family","book_id":"b-jinshu-076","work_id":"w-jinshu","source_id":"s-jinshu-076-wangyi-family"}],"sources":[{"chapter_id":"c-jinshu-033-wanglan-family","work_id":"w-jinshu","book_id":"b-jinshu-033","source_id":"s-jinshu-033-wanglan-family","source":{"title":"《晉書》卷三十三（數位選錄）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7033&oldid=2650519","permalink":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7033&oldid=2650519","revision_id":2650519,"accessed_on":"2026-10-18","extent":"王祥開篇三段及王覽完整附傳五段；不是全卷。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，未親核底本影像","response_sha256":"15791b8bdf731793ef02dbe27caed43b97631ae988fec2592c751dd3e7b5434a","wikitext_sha256":"2b422c350bf028f5d9b50e9791cc1b0caacd543dec80ad6fac445d99ae168721","normalization":{"character_conversion":{},"extraction_note":"去首部排版空白、展開連結顯示字、去單字-{字}-顯示語法、展開YL日期模板，不改漢未、乙太中大夫等見證原字；數位小標題不作正文證據。","excerpts":[{"proposed_paragraph_id":"c-jinshu-033-wanglan-family:p001","source_lines":[14,15],"raw_quote":"　　王祥，字休-{徵}-，琅邪臨沂人，漢諫議大夫吉之-{後}-也。祖仁，青州刺史。父融，公府-{辟}-不就。","raw_quote_sha256":"bbf3dd7ae2f5ab69161265874e14fa45662b17d748b0ed9dfb4277f51673ead8","selected_text_sha256":"2606dc497056559dfc79b2f4306effd4edc63587573a624f0c635c9a7f933c31","begin_anchor":"王祥，字休徵，琅邪臨沂人，漢諫","end_anchor":"，青州刺史。父融，公府辟不就。"},{"proposed_paragraph_id":"c-jinshu-033-wanglan-family:p002","source_lines":[16,17],"raw_quote":"　　祥性至孝。早喪親，繼母朱氏不慈，數譖之，由是失愛-{於}-父。每使掃除牛下，祥愈恭謹。父母有疾，衣不解帶，湯藥必親嘗。母常欲生魚，時天寒冰凍，祥解衣將剖冰求之，冰忽自解，雙鯉躍出，持之而歸。母又思黃雀灸，復有黃雀數十飛入其幕，復以供母。鄕里驚歎，以爲孝感所致焉。有丹柰結實，母命守之，每風雨，祥輒抱樹而泣。其篤孝純至如此。","raw_quote_sha256":"dc9ce1d26c53c2956277a237beac6ec091d02d12f4606c6b73b296e1bc2ed704","selected_text_sha256":"2c688093a5217867f6e7925af5ae73722c0240557d6321d8a26953b0a416c14d","begin_anchor":"祥性至孝。早喪親，繼母朱氏不慈","end_anchor":"祥輒抱樹而泣。其篤孝純至如此。"},{"proposed_paragraph_id":"c-jinshu-033-wanglan-family:p003","source_lines":[18,19],"raw_quote":"　　漢未遭亂，扶母攜弟覽避地廬江，隱居三十餘年，不應州郡之命。母終，居喪毀瘁，杖而-{後}-起。徐州刺史呂虔檄爲別駕，祥年垂耳順，固辭不受。覽勸之，爲具車牛，祥乃應召，虔委以州事。-{於}-時寇盜充斥，祥率勵兵士，頻討破之。州界清靜，政化大行。時人歌之曰：「海沂之康，實賴王祥。邦國不空，別駕之功。」","raw_quote_sha256":"be7909ef408ce89591e54a8b243d6e39e557934ae40e27ee69e51e7c14dd5fe7","selected_text_sha256":"49c4e1966467f962ddb1b0209c8b1574fc0e4528d48774c223f602768ad8c03f","begin_anchor":"漢未遭亂，扶母攜弟覽避地廬江，","end_anchor":"賴王祥。邦國不空，別駕之功。」"},{"proposed_paragraph_id":"c-jinshu-033-wanglan-family:p004","source_lines":[39,40],"raw_quote":"　　覽字玄通。母朱，遇祥無道。覽年數歲，見祥被楚撻，輒涕泣抱持。至-{於}-成童，每諫其母，其母少止凶虐。朱屢以非理使祥，覽輒與祥俱。又虐使祥妻，覽妻亦趨而共之。朱患之，乃止。祥喪父之-{後}-，漸有時譽。朱深疾之，密使鴆祥。覽知之，徑起取酒。祥疑其有毒，爭而不與，朱遽奪反之。自-{後}-朱賜祥饌，覽輒先嘗。朱懼覽致斃，遂止。","raw_quote_sha256":"64f4e0b8e61d56fdb63938babaa9bcfd88586084f2d432448f1ba052757a7b48","selected_text_sha256":"314bb9c6889d6f15a84853e4a5d0c19a45fb4b62c31e33688f473d06c21e4f8d","begin_anchor":"覽字玄通。母朱，遇祥無道。覽年","end_anchor":"，覽輒先嘗。朱懼覽致斃，遂止。"},{"proposed_paragraph_id":"c-jinshu-033-wanglan-family:p005","source_lines":[41,42],"raw_quote":"　　覽孝友恭恪，名亞-{於}-祥。及祥仕進，覽亦應本郡之召，稍遷司徒西曹掾、清河太守。五等建，封即丘子，邑六百戸。泰始末，除弘訓少府。職省，轉太中大夫，祿賜與卿同。咸甯初，詔曰：「覽少篤至行，服仁履義，貞素之操，長而彌固。其以覽爲宗正卿。」頃之，以疾上疏乞骸骨。詔聽之，乙太中大夫歸老，賜錢二十萬，床帳薦褥，遣殿中醫療疾給藥。-{後}-轉光祿大夫，門施行馬。","raw_quote_sha256":"40419a8eb7ece09dddabc61f0bd52c592e894e00ff14dcf36cdcc4135176b321","selected_text_sha256":"0236e27239e1247db380e51e73fef7d1df04e1132d77d32644b7c8e24878789a","begin_anchor":"覽孝友恭恪，名亞於祥。及祥仕進","end_anchor":"給藥。後轉光祿大夫，門施行馬。"},{"proposed_paragraph_id":"c-jinshu-033-wanglan-family:p006","source_lines":[43,44],"raw_quote":"　　{{YL|咸寧四年}}卒，時年七十三，諡曰貞。有六子：裁、基、會、正、彥、琛。","raw_quote_sha256":"1b676a2f07bf1dcf5ca27b5af4d9912c1d31377fc3a8e6ce355ff58306231c0b","selected_text_sha256":"e490f9134a325ad7545ba632b20b15665e49864e2da4018e00c8bae8b0ea31b7","begin_anchor":"咸寧四年卒，時年七十三，諡曰貞","end_anchor":"六子：裁、基、會、正、彥、琛。"},{"proposed_paragraph_id":"c-jinshu-033-wanglan-family:p007","source_lines":[45,46],"raw_quote":"　　裁字士初，撫軍長史。[[晉書/卷098#王敦|基]]字士先，治書御史。[[晉書/卷076#王舒|會]]字士和，侍御史。正字士則，尚書郎。彥字士治，中護軍。琛字士瑋，國子祭酒。","raw_quote_sha256":"46758aedb5388938223c2d591ce503993c0f591832c8a420457d713e3e252407","selected_text_sha256":"242d4aeb39a37bc009c4fdb993964b5808dc99a4da29a349c17e8d9c5ba3342c","begin_anchor":"裁字士初，撫軍長史。基字士先，","end_anchor":"，中護軍。琛字士瑋，國子祭酒。"},{"proposed_paragraph_id":"c-jinshu-033-wanglan-family:p008","source_lines":[47,48],"raw_quote":"　　初，呂虔有佩刀，工相之，以爲必登三公，可服此刀。虔謂祥曰：「苟非其人，刀或爲害。卿有公輔之量，故以相與。」祥固辭，強之乃受。祥臨薨，以刀授覽，曰：「汝-{後}-必興，足稱此刀。」覽-{後}-奕世多賢才，興-{於}-江左矣。裁子導，[[晉書/卷065|別有傳]]。","raw_quote_sha256":"a43f33c97b30853834d357d68a90d5e08fd1668a05e8469de66623b9d3c5efbe","selected_text_sha256":"19ba4970c1e7d6440a46690f3e567bf0af4efe92c07358ffca2a20c540acb2d0","begin_anchor":"初，呂虔有佩刀，工相之，以爲必","end_anchor":"，興於江左矣。裁子導，別有傳。"}]}}},{"chapter_id":"c-jinshu-076-wangyi-family","work_id":"w-jinshu","book_id":"b-jinshu-076","source_id":"s-jinshu-076-wangyi-family","source":{"title":"《晉書》卷七十六（數位選錄）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7076&oldid=2180533","permalink":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7076&oldid=2180533","revision_id":2180533,"accessed_on":"2026-10-18","extent":"王廙傳首、末段及子嗣共四段，中興賦等中段未錄，非完整列傳。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，未親核底本影像","response_sha256":"c6c7c41bf93c491f6f69b058ecc493e979d65f3e65397d20055284f2e829cd30","wikitext_sha256":"872701db949f6f58ea6f183425617dfa82353177d2cc026037bfad953a60cd71","normalization":{"character_conversion":{},"extraction_note":"去首部空白，宋書ref校勘記另存，正文原字不改；不補平南將領的疑缺字。","excerpts":[{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:p001","source_lines":[27,28],"raw_quote":"王廙，字世將，丞相導從弟，而元帝姨弟也。父正，尚書郎。廙少能屬文，多所通涉，工書畫，善音樂、射御、博弈、雜伎。辟太傅掾，轉參軍。豫迎大駕，封武陵縣侯，拜尚書郎，出為濮陽太守。元帝作鎮江左，廙棄郡過江。帝見之大悅，以為司馬。頻守廬江、鄱陽二郡。豫討周馥、杜韜，以功累增封邑，除冠軍將軍，鎮石頭，領丞相軍諮祭酒。王敦啟為甯遠將軍、荊州刺史。","raw_quote_sha256":"8147d33d3202efaa1adf4a1c6aa137d71d239827b11033011846a53f38708001","selected_text_sha256":"8147d33d3202efaa1adf4a1c6aa137d71d239827b11033011846a53f38708001","begin_anchor":"王廙，字世將，丞相導從弟，而元","end_anchor":"。王敦啟為甯遠將軍、荊州刺史。"},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:p002","source_lines":[39,40],"raw_quote":"初，王敦左遷陶侃，使廙代為荊州。將吏馬俊、鄭攀等上書請留侃，敦不許。廙為俊等所襲，奔于江安。賊杜曾與俊、攀北迎第五猗以距廙。廙督諸軍討曾，又為曾所敗。敦命湘州刺史甘卓、豫章太守周廣等助廙擊曾，曾衆潰，廙得到州。廙性俊率，嘗從南下，旦自尋陽，迅風飛帆，暮至都，倚舫樓長嘯，神氣甚逸。王導謂庾亮曰：「世將為傷時識事。」亮曰：「正足舒其逸氣耳。」廙在州大誅戮侃時將佐，及征士皇甫方回，於是大失荊土之望，人情乖阻。帝乃征廙為輔國將軍，加散騎常侍。以母喪去職。服闋，拜征虜將軍，進左衛將軍。","raw_quote_sha256":"713e46789dcf7fe1c521542418159b142d29f81e58c3e6357597be46caf9c662","selected_text_sha256":"713e46789dcf7fe1c521542418159b142d29f81e58c3e6357597be46caf9c662","begin_anchor":"初，王敦左遷陶侃，使廙代為荊州","end_anchor":"服闋，拜征虜將軍，進左衛將軍。"},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:p003","source_lines":[41,42],"raw_quote":"及王敦構禍，帝遣廙喻敦，既不能諫其悖逆，乃為敦所留，受任助亂。敦得志，以廙為平南將領護南蠻校尉、荊州刺史。尋病卒。帝猶以親故，深痛湣之。喪還京都，皇太子親臨拜柩，如家人之禮。贈侍中、驃騎將軍，諡曰康。明帝與大將軍溫嶠書曰：「痛謝鯤未絕於口，世將復至於此。並盛年雋才，不遂其志，痛切於心。廙明古多通，鯤遠有識致。其言雖未足令人改聽，然味之不倦，近未易有也。坐相視盡，如何！」","raw_quote_sha256":"b2c8c3b975ba6ac7732d8b4a11f0ec1be353f9f1fb577963a649d9140d52c2bb","selected_text_sha256":"b2c8c3b975ba6ac7732d8b4a11f0ec1be353f9f1fb577963a649d9140d52c2bb","begin_anchor":"及王敦構禍，帝遣廙喻敦，既不能","end_anchor":"近未易有也。坐相視盡，如何！」"},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:p004","source_lines":[43,44],"raw_quote":"子頤之嗣，仕至東海內史。頤之弟胡之，字修齡，弱冠有聲譽，歷郡守、侍中、丹陽尹。素有風眩疾，發動甚數，而神明不損。石季龍死，朝廷欲綏輯河洛，以胡之為西中郎將、司州刺史、假節，以疾固辭，未行而卒。子茂之亦有美譽，官至晉陵太守。子敬弘，義熙末為尚書。","raw_quote_sha256":"07b3bbc4071f24625a64510a17080b7ab063923ca9f6d5febeb0893dfefef0c6","selected_text_sha256":"07b3bbc4071f24625a64510a17080b7ab063923ca9f6d5febeb0893dfefef0c6","begin_anchor":"子頤之嗣，仕至東海內史。頤之弟","end_anchor":"陵太守。子敬弘，義熙末為尚書。"}]}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true},"assembled_identity":{"person_id":"7r6_k52_qji_ABD","representative_source_person_id":"7r6_k52_qji_ABD","source_person_ids":["7r6_k52_qji_ABD"],"identity_equivalence_decision_ids":[],"parent_person_id":"7r6_k52_qji_AB","source_assertion_id":"a-jinshu033-wang-012","assembly_id":"family-langye-wang-dao","root_person_id":"7r6_k52_qji","status":"editorial_preferred","human_reviewed":false},"assembled_children":[{"person_id":"7r6_k52_qji_ABDB","representative_source_person_id":"7r6_k52_qji_ABDB","source_person_ids":["7r6_k52_qji_ABDB"],"identity_equivalence_decision_ids":[],"parent_person_id":"7r6_k52_qji_ABD","source_assertion_id":null,"connection":"father","parent_connection":{"type":"shared_father_through_sibling","status":"contextual_provisional","human_reviewed":false,"sibling_person_id":"7r6_k52_qji_ABDA","sibling_assertion_id":"a-jinshu076-yi-bin-brother","sibling_father_assertion_id":"a-jinshu076-wang-001","references":[{"work_id":"w-jinshu","book_id":"b-jinshu-076","source_id":"s-jinshu-076-wangbin","chapter_id":"c-jinshu-076-wangbin","paragraph_id":"c-jinshu-076-wangbin:line046","quote":"彬字世儒。少稱雅正，弱冠，不就州郡之命。光祿大夫傅祗辟為掾。後與兄廙俱渡江，為揚州刺史劉機建武長史。元帝引為鎮東賊曹參軍，轉典兵參軍。豫討華軼功，封都亭侯，湣帝召為尚書郎，以道險不就。遷建安太守，徙義興內史，未之職，轉軍諮祭酒。","subject_person_mention_id":"c-jinshu-076-wangbin:line046:m0033","object_person_mention_id":"c-jinshu-076-wangbin:line046:m0000","assertion_id":"a-jinshu076-yi-bin-brother","scope":"same_paternal_family_source_and_sibling_context","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7076&oldid=2180533"},{"work_id":"w-jinshu","book_id":"b-jinshu-076","chapter_id":"c-jinshu-076-wangyi-family","source_id":"s-jinshu-076-wangyi-family","paragraph_id":"c-jinshu-076-wangyi-family:p001","quote":"王廙，字世將，丞相導從弟，而元帝姨弟也。父正，尚書郎。廙少能屬文，多所通涉，工書畫，善音樂、射御、博弈、雜伎。辟太傅掾，轉參軍。豫迎大駕，封武陵縣侯，拜尚書郎，出為濮陽太守。元帝作鎮江左，廙棄郡過江。帝見之大悅，以為司馬。頻守廬江、鄱陽二郡。豫討周馥、杜韜，以功累增封邑，除冠軍將軍，鎮石頭，領丞相軍諮祭酒。王敦啟為甯遠將軍、荊州刺史。","assertion_id":"a-jinshu076-wang-001","scope":"same_paternal_family_source_and_sibling_context","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7076&oldid=2180533"}],"rationale":"原文明示同族兄弟，具名兄弟的父親另有直接原文；同父為可撤回編輯組裝，不造直接父子引句、不推同母。"},"assembly_id":"family-langye-wang-dao","root_person_id":"7r6_k52_qji","status":"editorial_preferred","human_reviewed":false}]}
