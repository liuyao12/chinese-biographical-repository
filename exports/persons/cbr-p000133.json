on"},"interpretation_note":"保存原文明示關係；不把繼位本身當作父子證據，未與出土材料對讀。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-003-yin:p026","text":"帝武乙無道，為偶人，謂之天神。與之博，令人為行。天神不勝，乃僇辱之。為革囊，盛血，卬而射之，命曰「射天」。武乙獵於河渭之閒，暴雷，武乙震死。子帝太丁立。帝太丁崩，子帝乙立。帝乙立，殷益衰。","mentions":[{"id":"c-shiji-003-yin:m026-0000","start":0,"end":3,"surface":"帝武乙","kind":"person","person_id":"cbr-p000132","status":"source_identified"},{"id":"c-shiji-003-yin:m026-0053","start":53,"end":55,"surface":"武乙","kind":"person","person_id":"cbr-p000132","status":"source_identified"},{"id":"c-shiji-003-yin:m026-0065","start":65,"end":67,"surface":"武乙","kind":"person","person_id":"cbr-p000132","status":"source_identified"},{"id":"c-shiji-003-yin:m026-0071","start":71,"end":74,"surface":"帝太丁","kind":"person","person_id":"cbr-p000133","status":"source_identified"},{"id":"c-shiji-003-yin:m026-0076","start":76,"end":79,"surface":"帝太丁","kind":"person","person_id":"cbr-p000133","status":"source_identified"},{"id":"c-shiji-003-yin:m026-0082","start":82,"end":84,"surface":"帝乙","kind":"person","person_id":"cbr-p000134","status":"source_identified"},{"id":"c-shiji-003-yin:m026-0086","start":86,"end":88,"surface":"帝乙","kind":"person","person_id":"cbr-p000134","status":"source_identified"}],"chapter_id":"c-shiji-003-yin","book_id":"b-shiji-003","work_id":"w-shiji","source_id":"s-shiji-003-yin"}],"sources":[{"chapter_id":"c-shiji-003-yin","work_id":"w-shiji","book_id":"b-shiji-003","source_id":"s-shiji-003-yin","source":{"title":"史記／卷003","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷003","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷003&oldid=7909145","revision_id":7909145,"accessed_on":"2026-10-09","extent":"正文全文；不含現代章節標題與註號。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫 CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","nor