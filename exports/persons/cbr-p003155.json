{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003155","canonical_person_id":"ip4_hu8_94t","id_aliases":["cbr-p003155"],"identity_policy":"contextual_provisional","person_ids":["ip4_hu8_94t"],"persons":[{"id":"ip4_hu8_94t","label":"孝景帝（楚元王世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"孝景帝","mention_ids":["c-shiji-050-chuyuan:m005-0006","c-shiji-050-chuyuan:m009-0009"]}],"evidence":[{"mention_id":"c-shiji-050-chuyuan:m005-0006","chapter_id":"c-shiji-050-chuyuan","paragraph_id":"c-shiji-050-chuyuan:p005","quote":"孝景帝"},{"mention_id":"c-shiji-050-chuyuan:m009-0009","chapter_id":"c-shiji-050-chuyuan","paragraph_id":"c-shiji-050-chuyuan:p009","quote":"孝景帝"}],"id_aliases":["cbr-p003155"]}],"source_mention_summary":[{"source_id":"s-shiji-050-chuyuan","work_id":"w-shiji","book_id":"b-shiji-050","chapter_id":"c-shiji-050-chuyuan","mention_count":2,"mention_ids":["c-shiji-050-chuyuan:m005-0006","c-shiji-050-chuyuan:m009-0009"],"paragraph_ids":["c-shiji-050-chuyuan:p005","c-shiji-050-chuyuan:p009"],"passage_count":2}],"most_mentioned_source_ids":["s-shiji-050-chuyuan"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-050-chuyuan:m005-0006","start":6,"end":9,"surface":"孝景帝","kind":"person","person_id":"ip4_hu8_94t","status":"contextual_provisional","paragraph_id":"c-shiji-050-chuyuan:p005","chapter_id":"c-shiji-050-chuyuan"},{"id":"c-shiji-050-chuyuan:m009-0009","start":9,"end":12,"surface":"孝景帝","kind":"person","person_id":"ip4_hu8_94t","status":"contextual_provisional","paragraph_id":"c-shiji-050-chuyuan:p009","chapter_id":"c-shiji-050-chuyuan"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji050-009","person_id":"ip4_hu8_94t","surfaces":["孝景帝"],"scope":"same_chapter","chapter_ids":["c-shiji-050-chuyuan"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-050-chuyuan:p005","quote":"漢已平吳楚，孝景帝欲以德侯子續吳，以元王子禮續楚。竇太后曰：「吳王，老人也，宜為宗室順善。今乃首率七國，紛亂天下，柰何續其後！」不許吳，許立楚後。是時禮為漢宗正。乃拜禮為楚王，奉元王宗廟，是為楚文王。"},{"paragraph_id":"c-shiji-050-chuyuan:p009","quote":"遂既王趙二十六年，孝景帝時坐晁錯以適削趙王常山之郡。吳楚反，趙王遂與合謀起兵。其相建德、內史王悍諫，不聽。遂燒殺建德、王悍，發兵屯其西界，欲待吳與俱西。北使匈奴，與連和攻漢。漢使曲周侯酈寄擊之。趙王遂還，城守邯鄲，相距七月。吳楚敗於梁，不能西。匈奴聞之，亦止，不肯入漢邊。欒布自破齊還，乃并兵引水灌趙城。趙城壞，趙王自殺，邯鄲遂降。趙幽王絕後。"}],"rationale":"明示名、字與楚趙世系局部回指暫接；兩支文王分開，副詞遂降不當劉遂，王作動詞不當人稱。索隱述贊保留自身層次，未名署稱不補姓名。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-050-chuyuan:p005","text":"漢已平吳楚，孝景帝欲以德侯子續吳，以元王子禮續楚。竇太后曰：「吳王，老人也，宜為宗室順善。今乃首率七國，紛亂天下，柰何續其後！」不許吳，許立楚後。是時禮為漢宗正。乃拜禮為楚王，奉元王宗廟，是為楚文王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-050-chuyuan:m005-0006","start":6,"end":9,"surface":"孝景帝","kind":"person","person_id":"ip4_hu8_94t","status":"contextual_provisional"},{"id":"c-shiji-050-chuyuan:m005-0011","start":11,"end":14,"surface":"德侯子","kind":"person","person_id":"v2q_x8x_vdu","status":"contextual_provisional"},{"id":"c-shiji-050-chuyuan:m005-0018","start":18,"end":20,"surface":"元王","kind":"person","person_id":"n7i_i5n_lay","status":"contextual_provisional"},{"id":"c-shiji-050-chuyuan:m005-0021","start":21,"end":22,"surface":"禮","kind":"person","person_id":"n7i_i5n_lay_B","status":"contextual_provisional"},{"id":"c-shiji-050-chuyuan:m005-0025","start":25,"end":28,"surface":"竇太后","kind":"person","person_id":"0of_7ly_ddz","status":"contextual_provisional"},{"id":"c-shiji-050-chuyuan:m005-0031","start":31,"end":33,"surface":"吳王","kind":"person","person_id":"hev_8tu_w4k","status":"contextual_provisional"},{"id":"c-shiji-050-chuyuan:m005-0040","start":40,"end":42,"surface":"宗室","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、泛稱或未定指代；不補未見人物成員與姓名。"},{"id":"c-shiji-050-chuyuan:m005-0070","start":70,"end":72,"surface":"楚後","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、泛稱或未定指代；不補未見人物成員與姓名。"},{"id":"c-shiji-050-chuyuan:m005-0075","start":75,"end":76,"surface":"禮","kind":"person","person_id":"n7i_i5n_lay_B","status":"contextual_provisional"},{"id":"c-shiji-050-chuyuan:m005-0083","start":83,"end":84,"surface":"禮","kind":"person","person_id":"n7i_i5n_lay_B","status":"contextual_provisional"},{"id":"c-shiji-050-chuyuan:m005-0089","start":89,"end":91,"surface":"元王","kind":"person","person_id":"n7i_i5n_lay","status":"contextual_provisional"},{"id":"c-shiji-050-chuyuan:m005-0096","start":96,"end":99,"surface":"楚文王","kind":"person","person_id":"n7i_i5n_lay_B","status":"contextual_provisional"}],"chapter_id":"c-shiji-050-chuyuan","book_id":"b-shiji-050","work_id":"w-shiji","source_id":"s-shiji-050-chuyuan"},{"id":"c-shiji-050-chuyuan:p009","text":"遂既王趙二十六年，孝景帝時坐晁錯以適削趙王常山之郡。吳楚反，趙王遂與合謀起兵。其相建德、內史王悍諫，不聽。遂燒殺建德、王悍，發兵屯其西界，欲待吳與俱西。北使匈奴，與連和攻漢。漢使曲周侯酈寄擊之。趙王遂還，城守邯鄲，相距七月。吳楚敗於梁，不能西。匈奴聞之，亦止，不肯入漢邊。欒布自破齊還，乃并兵引水灌趙城。趙城壞，趙王自殺，邯鄲遂降。趙幽王絕後。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-050-chuyuan:m009-0000","start":0,"end":1,"surface":"遂","kind":"person","person_id":"lfb_885_np1_AA","status":"contextual_provisional"},{"id":"c-shiji-050-chuyuan:m009-0009","start":9,"end":12,"surface":"孝景帝","kind":"person","person_id":"ip4_hu8_94t","status":"contextual_provisional"},{"id":"c-shiji-050-chuyuan:m009-0014","start":14,"end":16,"surface":"晁錯","kind":"person","person_id":"uqv_78v_j7w","status":"contextual_provisional"},{"id":"c-shiji-050-chuyuan:m009-0030","start":30,"end":33,"surface":"趙王遂","kind":"person","person_id":"lfb_885