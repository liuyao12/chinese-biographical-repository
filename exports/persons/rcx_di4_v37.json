ed_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-075-xunsong-families:xunsong-intro:p001","text":"荀崧，字景猷，潁川臨潁人，魏太尉彧之玄孫也。父頵，羽林右監、安陵鄉侯，與王濟、何劭為拜親之友。崧志操清純，雅好文學。齠齔時，族曾祖顗見而奇之，以為必興頵門。弱冠，太原王濟甚相器重，以方其外祖陳郡袁侃，謂侃弟奧曰：「近見荀監子，清虛名理，當不及父，德性純粹，是賢兄輩人也。」其為名流所賞如此。泰始中，詔以崧代兄襲父爵，補濮陽王允文學。與王敦、顧榮、陸機等友善，趙王倫引為相國參軍。倫篡，轉護軍司馬、給事中，稍遷尚書吏部郎、太弟中庶子，累遷侍中、中護軍。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-075-xunsong-families:xunsong-intro:p001:m0000","start":0,"end":2,"surface":"荀崧","kind":"person","person_id":"yoo_ox0_545_BABAAA","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-intro:p001:m0004","start":4,"end":6,"surface":"景猷","kind":"person","person_id":"yoo_ox0_545_BABAAA","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-intro:p001:m0016","start":16,"end":17,"surface":"彧","kind":"person","person_id":"yoo_ox0_545_BA","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-intro:p001:m0023","start":23,"end":24,"surface":"頵","kind":"person","person_id":"yoo_ox0_545_BABAA","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-intro:p001:m0036","start":36,"end":38,"surface":"王濟","kind":"person","person_id":"rcx_di4_v37","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-intro:p001:m0039","start":39,"end":41,"surface":"何劭","kind":"person","person_id":"ij0_gmq_io0","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-intro:p001:m0047","start":47,"end":48,"surface":"崧","kind":"person","person_id":"yoo_ox0_545_BABAAA","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-intro:p001:m0065","start":65,"end":66,"surface":"顗","kind":"person","person_id":"yoo_ox0_545_BAA","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-intro:p001:m0075","start":75,"end":76,"surface":"頵","kind":"perso