70-zhang"},{"id":"c-shiji-070-zhang:m050-0177","start":177,"end":179,"surface":"秦王","kind":"person","person_id":"cbr-p004123","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p050","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-070-zhang:m050-0314","start":314,"end":316,"surface":"秦王","kind":"person","person_id":"cbr-p004123","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p050","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-070-zhang:m050-0321","start":321,"end":322,"surface":"王","kind":"person","person_id":"cbr-p004123","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p050","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-070-zhang:m050-0333","start":333,"end":334,"surface":"王","kind":"person","person_id":"cbr-p004123","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p050","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-070-zhang:m050-0392","start":392,"end":393,"surface":"王","kind":"person","person_id":"cbr-p004123","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p050","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-070-zhang:m050-0434","start":434,"end":436,"surface":"秦王","kind":"person","person_id":"cbr-p004123","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p050","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-070-zhang:m050-0486","start":486,"end":488,"surface":"秦王","kind":"person","person_id":"cbr-p004123","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p050","chapter_id":"c-shiji-070-zhang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji070-040","person_id":"cbr-p004123","scope":"same_chapter","chapter_ids":["c-shiji-070-zhang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"依第46至51段明示名字與引語範圍暫接，趙襄子姊與代王的故事另存未名；秦武王與秦惠王依卒立語境分開。韓王趙王及趙先王不按年代記憶補名；蘇秦謀齊的燕王齊王另存候選，不強與其他王同指或斷為異人。孟賁烏獲是比擬人物，不作在場者；紂為引古。擬議秦楚太子質子與秦女婚姻保留未解。","surfaces":["太子","武王","王","秦武王","秦王"],"evidence":[{"paragraph_id":"c-shiji-070-zhang:p049","quote":"燕王曰：「寡人蠻夷僻處，雖大男子裁如嬰兒，言不足以采正計。今上客幸教之，請西面而事秦，獻恒山之尾五城。」燕王聽儀。儀歸報，未至咸陽而秦惠王卒，武王立。武王自為太子時不說張儀，及即位，群臣多讒張儀曰：「無信，左右賣國以取容。秦必復用之，恐為天下笑。」諸侯聞張儀有卻武王，皆畔衡，復合從。"},{"paragraph_id":"c-shiji-070-zhang:p050","quote":"秦武王元年，群臣日夜惡張儀未已，而齊讓又至。張儀懼誅，乃因謂秦武王曰：「儀有愚計，願效之。」王曰：「柰何？」對曰：「為秦社稷計者，東方有大變，然後王可以多割得地也。今聞齊王甚憎儀，儀之所在，必興師伐之。故儀願乞其不肖之身之梁，齊必興師而伐梁。梁齊之兵連於城下而不能相去，王以其閒伐韓，入三川，出兵函谷而毋伐，以臨周，祭器必出。挾天子，按圖籍，此王業也。」秦王以為然，乃具革車三十乘，入儀之梁。齊果興師伐之。梁哀王恐。張儀曰：「王勿患也，請令罷齊兵。」乃使其舍人馮喜之楚，借使之齊，謂齊王曰：「王甚憎張儀；雖然，亦厚矣王之託儀於秦也！」齊王曰：「寡人憎儀，儀之所在，必興師伐之，何以託儀？」對曰：「是乃王之託儀也。夫儀之出也，固與秦王約曰：『為王計者，東方有大變，然後王可以多割得地。今齊王甚憎儀，儀之所在，必興師伐之。故儀願乞其不肖之身之梁，齊必興師伐之。齊梁之兵連於城下而不能相去，王以其閒伐韓，入三川，出兵函谷而無伐，以臨周，祭器必出。挾天子，案圖籍，此王業也。』秦王以為然，故具革車三十乘而入之梁也。今儀入梁，王果伐之，是王內罷國而外伐與國，廣鄰敵以內自臨，而信儀於秦王也。此臣之所謂『託儀』也。」齊王曰：「善。」乃使解兵。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-070-zhang:p049","text":"燕王曰：「寡人蠻夷僻處，雖大男子裁如嬰兒，言不足以采正計。今上客幸教之，請西面而事秦，獻恒山之尾五城。」燕王聽儀。儀歸報，未至咸陽而秦惠王卒，武王立。武王自為太子時不說張儀，及即位，群臣多讒張儀曰：「無信，左右賣國以取容。秦必復用之，恐為天下笑。」諸侯聞張儀有卻武王，皆畔衡，復合從。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-070-zhang:m049-0000","start":0,"end":2,"surface":"燕王","kind":"person","person_id":"cbr-p004119","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m049-0030","start":30,"end":32,"surface":"上客","kind":"person","person_id":"cbr-p004084","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m049-0052","start":52,"end":54,"surface":"燕王","kind":"person","person_id":"cbr-p004119","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m049-0055","start":55,"end":56,"surface":"儀","kind":"person","person_id":"cbr-p004084","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m049-0057","start":57,"end":58,"surface":"儀","kind":"person","person_id":"cbr-p004084","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m049-0066","start":66,"end":69,"surface":"秦惠王","kind":"person","person_id":"cbr-p004090","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m049-0071","start":71,"end":73,"surface":"武王","kind":"person","person_id":"cbr-p004123","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m049-0075","start":75,"end":77,"surface":"武王","kind":"person","person_id":"cbr-p004123","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m049-0079","start":79,"end":81,"surface":"太子","kind":"person","person_id":"cbr-p004123","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m049-0084","start":84,"end":86,"surface":"張儀","kind":"person","person_id":"cbr-p004084","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m049-0091","start":91,"end":93,"surface":"群臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名故事人物或群體，未補姓名及成員。"},{"id":"c-shiji-070-zhang:m049-0095","start":95,"end":97,"surface":"張儀","kind":"person","person_id":"cbr-p004084","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m049-0124","start":124,"end":126,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名故事人物或群體，未補姓名及成員。"},{"id":"c-shiji-070-zhang:m049-0127","start":127,"end":129,"surface":"張儀","kind":"person","person_id":"cbr-p004084","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m049-0131","start":131,"end":133,"surface":"武王","kind":"person","person_id":"cbr-p004123","status":"contextual_provisional"}],"chapter_id":"c-shiji-070-zhang","book_id":"b-shiji-070","work_id":"w-shiji","source_id":"s-shiji-070-zhang"},{"id":"c-shiji-070-zhang:p050","text":"秦武王元年，群臣日夜惡張儀未已，而齊讓又至。張儀懼誅，乃因謂秦武王曰：「儀有愚計，願效之。」王曰：「柰何？」對曰：「為秦社稷計者，東方有大變，然後王可以多割得地也。今聞齊王甚憎儀，儀之所在，必興師伐之。故儀願乞其不肖之身之梁，齊必興師而伐梁。梁齊之兵連於城下而不能相去，王以其閒伐韓，入三川，出兵函谷而毋伐，以臨周，祭器必出。挾天子，按圖籍，此王業也。」秦王以為然，乃具革車三十乘，入儀之梁。齊果興師伐之。梁哀王恐。張儀曰：「王勿患也，請令罷齊兵。」乃使其舍人馮喜之楚，借使之齊，謂齊王曰：「王甚憎張儀；雖然，亦厚矣王之託儀於秦也！」齊王曰：「寡人憎儀，儀之所在，必興師伐之，何以託儀？」對曰：「是乃王之託儀也。夫儀之出也，固與秦王約曰：『為王計者，東方有大變，然後王可以多割得地。今齊王甚憎儀，儀之所在，必興師伐之。故儀願乞其不肖之身之梁，齊必興師伐之。齊梁之兵連於城下而不能相去，王以其閒伐韓，入三川，出兵函谷而無伐，以臨周，祭器必出。挾天子，案圖籍，此王業也。』秦王以為然，故具革車三十乘而入之梁也。今儀入梁，王果伐之，是王內罷國而外伐與國，廣鄰敵以內自臨，而信儀於秦王也。此臣之所謂『託儀』也。」齊王曰：「善。」乃使解兵。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-070-zhang:m050-0000","start":0,"end":3,"surface":"秦武王","kind":"person","person_id":"cbr-p004123","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m050-0006","start":6,"end":8,"surface":"群臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名故事人物或群體，未補姓名及成員。"},{"id":"c-shiji-070-zhang:m050-0011","start":11,"end":13,"surface":"張儀","kind":"person","person_id":"cbr-p004084","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m050-0022","start":22,"end":24,"surface":"張儀","kind":"person","person_id":"cbr-p004084","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m050-0030","start":30,"end":33,"surface":"秦武王","kind":"person","person_id":"cbr-p004123","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m050-0036","start":36,"end":37,"surface":"儀","kind":"person","person_id":"cbr-p004084","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m050-0046","start":46,"end":47,"surface":"王","kind":"person","person_id":"cbr-p004123","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m050-0073","start":73,"end":74,"surface":"王","kind":"person","person_id":"cbr-p004123","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m050-0084","start":84,"end":86,"surface":"齊王","kind":"person","person_id":"cbr-p004125","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m050-0088","start":88,"end":89,"surface":"儀","kind":"person","person_id":"cbr-p004084","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m050-0090","start":90,"end":91,"surface":"儀","kind":"person","person_id":"cbr-p004084","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m050-0102","start":102,"end":103,"surface":"儀","kind":"person","person_id":"cbr-p004084","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m050-0135","start":135,"end":136,"surf