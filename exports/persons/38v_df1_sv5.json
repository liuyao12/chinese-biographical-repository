textual_provisional"},{"id":"c-sanguozhi-022-luyu:p005:m0446","start":446,"end":447,"surface":"毓","kind":"person","person_id":"m8n_ntm_79h_A","status":"contextual_provisional"},{"id":"c-sanguozhi-022-luyu:p005:m0447","start":447,"end":448,"surface":"毓","kind":"person","person_id":"m8n_ntm_79h_A","status":"contextual_provisional"},{"id":"c-sanguozhi-022-luyu:p005:m0482","start":482,"end":483,"surface":"豐","kind":"person","person_id":"wj9_6bo_o54","status":"contextual_provisional"}],"source_position":{"first_line":460,"last_line":487,"source_layer":"received_body","unit_key":"luyu-unit-05","raw_projection_ref":"source-evidence/sanguozhi022-luyu-projection.json"},"chapter_id":"c-sanguozhi-022-luyu","book_id":"b-sanguozhi-022","work_id":"w-sanguozhi","source_id":"s-sanguozhi-022-luyu"},{"id":"c-sanguozhi-023-peiqian:p017","text":"韓宣字景然渤海人也為人短小建安中丞相召置軍謀掾冗散在鄴嘗於鄴出入宫於東掖門内與臨菑侯植相遇時天新雨地有泥潦宣欲避之閡潦不得去乃以扇自障住於道邊植嫌宣既不去又不為禮乃駐車使其常從問宣何官宣云丞相軍謀掾也植又問曰應得唐突列侯否宣曰春秋之義王人雖微列于諸侯之上未聞宰士而為下土諸侯禮也植又曰即如所言為人父吏見其子應有禮否宣又曰於禮臣子一例也而宣年又長植知其枝柱難窮乃釋去具為太子言以為辯黃初中為尚書郎嘗以職事當受罰於殿前已縳束杖未行文帝輦過問此為誰左右對曰尚書郎渤海韓宣也帝追念前臨菑侯所說乃寤曰是子建所道韓宣邪特原之遂解其縳時天大寒宣前以當受杖豫脫袴纒褌面縛及其原褌腰不下乃趨而去帝目而送之笑曰此家有瞻諦之士也後出為清河東郡太守明帝時為尚書大鴻臚數歲卒宣前後當官在能否之間然善以已恕人始南陽韓暨以宿徳在宣前為大鴻臚暨為人賢及宣在後亦稱職故鴻臚中為之語曰大鴻臚小鴻臚前後治行曷相如","text_layer":"witness_appended_pei_songzhi_note","annotation_status":"in_progress","mentions":[{"id":"c-sanguozhi-023-peiqian:p017:m0000","start":0,"end":2,"surface":"韓宣","kind":"person","person_id":"w16_6fw_jhh","status":"contextual_provisional","resolution_note":"逐單元上下文首讀，不作跨全庫字串規則"},{"id":"c-sanguozhi-023-peiqian:p017:m0003","start":3,"end":5,"surface":"景然","kind":"person","person_id":"w16_6fw_jhh","status":"contextual_provisional","resolution_note":"逐單元上下文首讀，不作跨全庫字串規則"},{"id":"c-sanguozhi-023-peiqian:p017:m0016","start":16,"end":18,"surface":"丞相","kind":"person","person_id":"dad_b77_b38","status":"contextual_provisional","resolution_note":"依本完整句內時代與承接作局部人物辨識；原字不改，不作全域簡稱規則。"},{"id":"c-sanguozhi-023-peiqian:p017:m0039","start":39,"end":43,"surface":"臨菑侯植","kind