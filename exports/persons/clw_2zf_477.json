,"object_person_id":"clw_2zf_477","status":"source_attested","evidence":[{"chapter_id":"c-shiji-097-luli","source_id":"s-shiji-097-luli","paragraph_id":"c-shiji-097-luli:p017","quote":"平原君為人辯有口，刻廉剛直，家於長安。行不茍合，義不取容。辟陽侯行不正，得幸呂太后。時辟陽侯欲知平原君，平原君不肯見。及平原君母死，陸生素與平原君善，過之。平原君家貧，未有以發喪，方假貸服具，陸生令平原君發喪。陸生往見辟陽侯，賀曰：「平原君母死。」辟陽侯曰：「平原君母死，何乃賀我乎？」陸賈曰：「前日君侯欲知平原君，平原君義不知君，以其母故。今其母死，君誠厚送喪，則彼為君死矣。」辟陽侯乃奉百金往稅。列侯貴人以辟陽侯故，往稅凡五百金。"}],"qualifiers":{"source_term":"平原君母死","historicity":"historical_tradition"},"interpretation_note":"原文明示親屬，未名人物保留原稱；兩處朱建子未先合併。疥嗣三世不補中間父系或將武遂侯平直接當疥子。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-097-luli:m017-0063","start":63,"end":64,"surface":"母","kind":"person","person_id":"clw_2zf_477","status":"contextual_provisional","paragraph_id":"c-shiji-097-luli:p017","chapter_id":"c-shiji-097-luli"},{"id":"c-shiji-097-luli:m017-0120","start":120,"end":121,"surface":"母","kind":"person","person_id":"clw_2zf_477","status":"contextual_provisional","paragraph_id":"c-shiji-097-luli:p017","chapter_id":"c-shiji-097-luli"},{"id":"c-shiji-097-luli:m017-0133","start":133,"end":134,"surface":"母","kind":"person","person_id":"clw_2zf_477","status":"contextual_provisional","paragraph_id":"c-shiji-097-luli:p017","chapter_id":"c-shiji-097-luli"},{"id":"c-shiji-097-luli:m017-0168","start":168,"end":169,"surface":"母","kind":"person","person_id":"clw_2zf_477","status":"contextual_provisional","paragraph_id":"c-shiji-097-luli:p017","chapter_id":"c-shiji-097-luli"},{"id":"c-shiji-097-luli:m017-0173","start":173,"end":174,"surface":"母","kind":"person","person_id":"clw_2zf_477","status":"contextual_provisional","paragraph_id":"c-shiji-097-luli:p017","chapter_id":"c-shiji-097-luli"}],"relations":[{"id":"a-shiji097-003","subject_person_id":"tkc_9z3_91l","predicate":"mother","object_person_id":"clw_2zf_477","status":"so