[{"id":"c-sanguozhi-052-guyong-complete:line042-pei02-01","text":"江表传曰：权嫁从女，女顾氏甥，故请雍父子及孙谭，谭时为选曹尚书，见任贵重。是日，权极欢。谭醉酒，三起舞，舞不知止。雍内怒之。明日，召谭，诃责之曰：「君王以含垢为德，臣下以恭谨为节。昔萧何、吴汉并有大功，何每见高帝，似不能言；汉奉光武，亦信恪勤。汝之於国，宁有汗马之劳，可书之事邪？但阶门户之资，遂见宠任耳，何有舞不复知止？虽为酒后，亦由恃恩忘敬，谦虚不足。损吾家者必尔也。」因背向壁卧，谭立过一时，乃见遣。","text_layer":"witness_appended_pei_songzhi_note","annotation_status":"reviewed","mentions":[{"id":"c-sanguozhi-052-guyong-complete:line042-pei02-01:m0005","start":5,"end":6,"surface":"权","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-guyong-complete:line042-pei02-01:m0017","start":17,"end":18,"surface":"雍","kind":"person","person_id":"syc_ik6_bq5_**A","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-guyong-complete:line042-pei02-01:m0022","start":22,"end":23,"surface":"谭","kind":"person","person_id":"syc_ik6_bq5_**AAA","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-guyong-complete:line042-pei02-01:m0024","start":24,"end":25,"surface":"谭","kind":"person","person_id":"syc_ik6_bq5_**AAA","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-guyong-complete:line042-pei02-01:m0040","start":40,"end":41,"surface":"权","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-guyong-complete:line042-pei02-01:m0044","start":44,"end":45,"surface":"谭","kind":"person","person_id":"syc_ik6_bq5_**AAA","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-guyong-complete:line042-pei02-01:m0057","start":57,"end":58,"surface":"雍","kind":"person","person_id":"syc_ik6_bq5_**A","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-guyong-complete:line042-pei02-01:m0066","start":66,"end":67,"surface":"谭","kind":"person","person_id":"syc_ik6_bq5_**AAA","status":"contextua