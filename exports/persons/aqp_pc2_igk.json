ons":[{"id":"c-shiji-056-chen:m002-0241","start":241,"end":242,"surface":"嫂","kind":"person","person_id":"aqp_pc2_igk","status":"contextual_provisional","paragraph_id":"c-shiji-056-chen:p002","chapter_id":"c-shiji-056-chen"},{"id":"c-shiji-056-chen:m007-0040","start":40,"end":41,"surface":"嫂","kind":"person","person_id":"aqp_pc2_igk","status":"contextual_provisional","paragraph_id":"c-shiji-056-chen:p007","chapter_id":"c-shiji-056-chen"},{"id":"c-shiji-056-chen:m007-0195","start":195,"end":196,"surface":"嫂","kind":"person","person_id":"aqp_pc2_igk","status":"contextual_provisional","paragraph_id":"c-shiji-056-chen:p007","chapter_id":"c-shiji-056-chen"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji056-057","person_id":"aqp_pc2_igk","surfaces":["嫂"],"scope":"same_chapter","chapter_ids":["c-shiji-056-chen"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-056-chen:p002","quote":"張負誡其孫曰：「毋以貧故，事人不謹。事兄伯如事父，事嫂如母。」"},{"paragraph_id":"c-shiji-056-chen:p007","quote":"絳侯、灌嬰等咸讒陳平曰：「平雖美丈夫，如冠玉耳，其中未必有也。臣聞平居家時，盜其嫂；事魏不容，亡歸楚；歸楚不中，又亡歸漢。」漢王疑之，召讓魏無知。無知曰：「臣所言者，能也；陛下所問者，行也。今有尾生、孝己之行而無益處於勝負之數，陛下何暇用之乎？楚漢相距，臣進奇謀之士，顧其計誠足以利國家不耳。且盜嫂受金又何足疑乎？」"}],"rationale":"卷002張負所告誡的「嫂」與卷007兩處同一「盜嫂」指控，均指陳平家中的嫂，故同一後段來源角色暫接；卷007第二處是魏無知重述該指控，非獨立證明。卷001所載伯已逐其婦，因此後段候選與卷001嫂的同指另列未決，不把指控當史實。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-056-chen:p001","text":"陳丞相平者，陽武戸牖鄕人也。少時家貧，好讀書，有田三十畝，獨與兄伯居。伯常耕田，縱平使遊學。平爲人長美色。人或謂陳平曰：「貧何食而肥若是？」其嫂嫉平之不視家生產，曰：「亦食糠覈耳。有叔如此，不如無有。」伯聞之，逐其婦而棄之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-056-chen:m001-0000","start":0,"end":4,"surface":"陳丞相平","kind":"person","person_id":"i3f_9l9_g53","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m001-0032","start":32,"end":33,"surface":"伯","kind":"person","person_id":"p62_q55_4wr","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m001-0035","start":35,"end":36,"surface":"伯","kind":"person","person_id":"p62_q55_4wr","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m001-0041","start":41,"end":42,"surface":"平","kind":"person","person_id":"i3f_9l9_g53","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m001-0046","start":46,"end":47,"surface":"平","kind":"person","person_id":"i3f_9l9_g53","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m001-0053","start":53,"end":54,"surface":"人","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、泛稱官職、氏族或代詞待覆核，不補姓名或未見家屬。"},{"id":"c-shiji-056-chen:m001-0056","start":56,"end":58,"surface":"陳平","kind":"person","person_id":"i3f_9l9_g53","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m001-0071","start":71,"end":72,"surface":"嫂","kind":"person","person_id":"8xv_ax8_bpe","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m001-0073","start":73,"end":74,"surface":"平","kind":"person","person_id":"i3f_9l9_g53","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m001-0091","start":91,"end":92,"surface":"叔","kind":"person","person_id":"i3f_9l9_g53","status":"contextual_provisional","note":"嫂對伯評論陳平有叔如此，指丈夫之弟陳平，非新增叔父。"},{"id":"c-shiji-056-chen:m001-0101","start":101,"end":102,"surface":"伯","kind":"person","person_id":"p62_q55_4wr","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m001-0106","start":106,"end":108,"surface":"其婦","kind":"person","person_id":"8xv_ax8_bpe","status":"contextual_provisional"}],"chapter_id":"c-shiji-056-chen","book_id":"b-shiji-056","work_id":"w-shiji","source_id":"s-shiji-056-chen"},{"id":"c-shiji-056-chen:p002","text":"及平長，可娶妻，富人莫肯與者，貧者平亦恥之。久之，戸牖富人有張負，張負女孫五嫁而夫輒死，人莫敢娶。平欲得之。邑中有喪，平貧，侍喪，以先往後罷爲助。張負既見之喪所，獨視偉平，平亦以故後去。負隨平至其家，家乃負郭窮巷，以弊席爲門，然門外多有長者車轍。張負歸，謂其子仲曰：「吾欲以女孫予陳平。」張仲曰：「平貧不事事，一縣中盡笑其所爲，獨奈何予女乎？」負曰：「人固有好美如陳平而長貧賤者乎？」卒與女。爲平貧，乃假貸幣以聘，予酒肉之資以內婦。負誡其孫曰：「毋以貧故，事人不謹。事兄伯如事父，事嫂如母。」平既娶張氏女，齎用益饒，遊道日廣。","annota