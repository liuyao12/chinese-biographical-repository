ce","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-009-lvhou","source_id":"s-shiji-009-lvhou","paragraph_id":"c-shiji-009-lvhou:p031","quote":"東牟侯興居曰：「誅呂氏吾無功，請得除宮。」乃與太仆汝陰侯滕公入宮，前謂少帝曰：「足下非劉氏，不當立。」乃顧麾左右執戟者掊兵罷去。有數人不肯去兵，宦者令張澤諭告，亦去兵。滕公乃召乘輿車載少帝出。少帝曰：「欲將我安之乎？」滕公曰「出就舍。」舍少府。乃奉天子法駕，迎代王於邸。報曰：「宮謹除。」代王即夕入未央宮。有謁者十人持戟衛端門，曰：「天子在也，足下何為者而入？」代王乃謂太尉。太尉往諭，謁者十人皆掊兵而去。代王遂入而聽政。夜，有司分部誅滅梁、淮陽、常山王及少帝於邸。代王立為天子。二十三年崩，謚為孝文皇帝。"}],"attestations":[{"id":"th-shiji009-024:a001","paragraph_id":"c-shiji-009-lvhou:p031","start":72,"end":75,"surface":"宦者令","person_mention_id":"c-shiji-009-lvhou:m031-0075","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"原文明示官爵用稱；起點未知，死亡不自動當官爵終點。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"address_assertions":[],"table_occurrences":[{"id":"shiji-019-t2-r030-c02-m000","start":8,"end":10,"surface":"張澤","person_id":"h55_n0n_dfm","status":"contextual_provisional","interpretation_note":"依本格國別、事件與本篇時間範圍核讀的完整名字暫定同指；非全域字串配對，省稱與世襲稱號另行核讀。","table_id":"shiji-019","table_fragment_id":"shiji-019-digital-table-2","table_row_id":"shiji-019-t2-r030","table_cell_id":"shiji-019-t2-r030-c02","work_id":"w-shiji","book_id":"b-shiji-019","chapter_id":"table-chapter-shiji-019","source_id":"table-witness-shiji-019","source_revision":"6359260","kind":"table_person_mention","quote":"八年亖月丁酉，侯張澤元年。。九月，奪侯，國除。"}],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-009-lvhou:p031","text":"東牟侯興居曰：「誅呂氏吾無功，請得除宮。」乃與太仆汝陰侯滕公入宮，前謂少帝曰：「足下非劉氏，不當立。」乃顧麾左右執戟者掊兵罷去。有數人不肯去兵，宦者令張澤諭告，亦去兵。滕公乃召乘輿車載少帝出。少帝曰：「欲將我安之乎？」滕公曰「出就舍。」舍少府。乃奉天子法駕，迎代王於邸。報曰：「宮謹除。」代王即夕入未央宮。有謁者十人持戟衛端門，曰：「天子在也，足下何為者而入？」代王乃謂太尉。太尉往諭，謁者十人皆掊兵而去。代王遂入而聽政。夜，有司分部誅滅梁、淮陽、常山王及少帝於邸。代王立為天子。二十三年崩，謚為孝文皇帝。","annotation_status":"in_progress","text