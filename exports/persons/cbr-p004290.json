ntextual_provisional"},{"id":"c-shiji-046-tian:m029-0023","start":23,"end":24,"surface":"髡","kind":"person","person_id":"g2o_10m_zsp","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m029-0034","start":34,"end":37,"surface":"騶忌子","kind":"person","person_id":"drb_gcn_28e","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m029-0045","start":45,"end":48,"surface":"淳于髡","kind":"person","person_id":"g2o_10m_zsp","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m029-0062","start":62,"end":65,"surface":"騶忌子","kind":"person","person_id":"drb_gcn_28e","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m029-0079","start":79,"end":82,"surface":"淳于髡","kind":"person","person_id":"g2o_10m_zsp","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m029-0105","start":105,"end":108,"surface":"騶忌子","kind":"person","person_id":"drb_gcn_28e","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m029-0122","start":122,"end":125,"surface":"淳于髡","kind":"person","person_id":"g2o_10m_zsp","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m029-0149","start":149,"end":152,"surface":"騶忌子","kind":"person","person_id":"drb_gcn_28e","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m029-0168","start":168,"end":171,"surface":"淳于髡","kind":"person","person_id":"g2o_10m_zsp","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m029-0189","start":189,"end":192,"surface":"騶忌子","kind":"person","person_id":"drb_gcn_28e","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m029-0213","start":213,"end":216,"surface":"淳于髡","kind":"person","person_id":"g2o_10m_zsp","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m029-0244","start":244,"end":247,"surface":"騶忌子","kind":"person","person_id":"drb_gcn_28e","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m029-0265","start":265,"end":268,"surface":"淳于髡","kind":"person","person_id":"g2o_10m_zsp","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m029-0279","start":279,"end":281,"surface":"其仆","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、對話、稱謂或索隱述贊短稱待核，不補姓名及成員。"},{"id":"c-shiji-046-tian:m029-0323","start":323,"end":325,"surface":"成侯","kind":"person","person_id":"drb_gcn_28e","status":"contextual_provisional"}],"chapter_id":"c-shiji-046-tian","book_id":"b-shiji-046","work_id":"w-shiji","source_id":"s-shiji-046-tian"},{"id":"c-shiji-046-tian:p031","text":"二十六年，魏惠王圍邯鄲，趙求救於齊。齊威王召大臣而謀曰：「救趙孰與勿救？」騶忌子曰：「不如勿救。」段干朋曰：「不救則不義，且不利。」威王曰：「何也？」對曰：「夫魏氏并邯鄲，其於齊何利哉？且夫救趙而軍其郊，是趙不伐而魏全也。故不如南攻襄陵以獘魏，邯鄲拔而乘魏之獘。」威王從其計。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-046-tian:m031-0005","start":5,"end":8,"surface":"魏惠王","kind":"person","person_id":"nht_c38_x7o","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m031-0018","start":18,"end":21,"surface":"齊威王","kind":"person","person_id":"zan_qcc_jy5_AAAAAABAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m031-0037","start":37,"end":40,"surface":"騶忌子","kind":"person","person_id":"drb_gcn_28e","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m031-0049","start":49,"end":52,"surface":"段干朋","kind":"person","person_id":"29i_iqg_x15","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m031-0066","start":66,"end":68,"surface":"威王","kind":"person","person_id":"zan_qcc_jy5_AAAAAABAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m031-0132","start":132,"end":134,"surface":"威王","kind":"person","person_id":"zan_qcc_jy5_AAAAAABAAAAAA","status":"contextual_provisional"}],"chapter_id":"c-shiji-046-tian","book_id":"b-shiji-046","work_id":"w-shiji","source_id":"s-shiji-046-tian"},{"id":"c-shiji-046-tian:p032","text":"其後成侯騶忌與田忌不善，公孫閲謂成侯忌曰：「公何不謀伐魏，田忌必將。戰勝有功，則公之謀中也；戰不勝，非前死則後北，而命在公矣。」於是成侯言威王，使田忌南攻襄陵。十月，邯鄲拔，齊因起兵撃魏，大敗之桂陵。于是齊最彊于諸侯，自稱爲王，以令天下。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-046-tian:m032-0002","start":2,"end":6,"surface":"成侯騶忌","kind":"person","person_id":"drb_gcn_28e","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m032-0007","start":7,"end":9,"surface":"田忌","kind":"person","person_id":"16n_czk_thg","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m032-0012","start":12,"end":15,"surface":"公孫閲","kind":"person","person_id":"6f9_sts_981","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m032-0016","start":16,"end":19,"surface":"成侯忌","kind":"person","person_id":"drb_gcn_28e","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m032-0022","start":22,"end":23,"surface":"公","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、對話、稱謂或索隱述贊短稱待核，不補姓名及成員。"},{"id":"c-shiji-046-tian:m032-0029","start":29,"end":31,"surface":"田忌","kind":"person","person_id":"16n_czk_thg","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m032-0040","start":40,"end":41,"surface":"公","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、對話、稱謂或索隱述贊短稱待核，不補姓名及成員。"},{"id":"c-shiji-046-tian:m032-0060","start":60,"end":61,"surface":"公","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、對話、稱謂或索隱述贊短稱待核，不補姓名及成員。"},{"id":"c-shiji-046-tian:m032-0066","start":66,"end":68,"surface":"成侯","kind":"person","person_id":"drb_gcn_28e","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m032-0069","start":69,"end":71,"surface":"威王","kind":"person","person_id":"zan_qcc_jy5_AAAAAABAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m032-0073","start":73,"end":75,"surface":"田忌","kind":"person","person_id":"16n_czk_thg","status":"contextual_provisional"}],"chapter_id":"c-shiji-046-tian","book_id":"b-shiji-046","work_id":"w-shiji","source_id":"s-shiji-046-tian"},{"id":"c-shiji-046-tian:p034","text":"三十五年，公孫閲又謂成侯忌曰：「公何不令人操十金卜於市，曰『我田忌之人也。吾三戰而三勝，聲威天下。欲爲大事，亦吉乎不吉乎』？」卜者出，因令人捕爲之卜者，驗其辭於王之所。田忌聞之，因率其徒襲攻臨淄，求成侯，不勝而奔。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-046-tian:m034-0005","start":5,"end":8,"surface":"公孫閲","kind":"person","person_id":"6f9_sts_981","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m034-0010","start":10,"end":13,"surface":"成侯忌","kind":"person","person_id":"drb_gcn_28e","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m034-0016","start":16,"end":17,"surface":"公","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、對話、稱謂或索隱述贊短稱待核，不補姓名及成員。"},{"id":"c-shiji-046-tian:m034-0031","start":31,"end":33,"surface":"田忌","kind":"person","person_id":"16n_czk_thg","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m034-0063","start":63,"end":65,"surface":"卜者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、對話、稱謂或索隱述贊短稱待核，不補姓名及成員。"},{"id":"c-shiji-046-tian:m034-0073","start":73,"end":75,"surface":"卜者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、對話、稱謂或索隱述贊短稱待核，不補姓名及成員。"},{"id":"c-shiji-046-tian:m034-0080","start":80,"end":81,"surface":"王","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、對話、稱謂或索隱述贊短稱待核，不補姓名及成員。"},{"id":"c-shiji-046-tian:m034-0084","start":84,"end":86,"surface":"田忌","kind":"person","person_id":"16n_czk_thg","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m034-0099","start":99,"end":101,"surface":"成侯","kind":"person","person_id":"drb_gcn_28e","status":"contextual_provisional"}],"chapter_id":"c-shiji-046-tian","book_id":"b-shiji-046","work_id":"w-shiji","source_id":"s-shiji-046-tian"},{"id":"c-shiji-046-tian:p037","text":"二年，魏伐趙。趙與韓親，共撃魏。趙不利，戰於南梁。宣王召田忌復故位。韓氏請救於齊。宣王召大臣而謀曰：「蚤救孰與晩救？」騶忌子曰：「不如勿救。」田忌曰：「弗救，則韓且折而入於魏，不如蚤救之。」孫子曰：「夫韓、魏之兵未獘而救之，是吾代韓受魏之兵，顧反聽命於韓也。且魏有破國之志，韓見亡，必東面而愬於齊矣。吾因深結韓之親而晩承魏之獘，則可重利而得尊名也。」宣王曰：「善。」乃陰告韓之使者而遣之。韓因恃齊，五戰不勝，而東委國於齊。齊因起兵，使田忌、田嬰將，孫子爲（帥）［師］，救韓、趙以撃魏，大敗之馬陵，殺其將龐涓，虜魏太子申。其後三晉之王皆因田嬰朝齊王於博望，盟而去。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-046-tian:m037-0025","start":25,"end":27,"surface":"宣王","kind":"person","person_id":"zan_qcc_jy5_AAAAAABAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m037-0028","start":28,"end":30,"surface":"田忌","kind":"person","person_id":"16n_czk_thg","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m037-0041","start":41,"end":43,"surface":"宣王","kind":"person","person_id":"zan_qcc_jy5_AAAAAABAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m037-0059","start":59,"end":62,"surface":"騶忌子","kind":"person","person_id":"drb_gcn_28e","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m037-0071","start":71,"end":73,"surface":"田忌","kind":"person","person_id":"16n_czk_thg","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m037-0095","start":95,"end":97,"surface":"孫子","kind":"person","person_id":"u4r_ktr_4qm","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m037-0175","start":175,"end":177,"surface":"宣王","kind":"person","person_id":"zan_qcc_jy5_AAAAAABAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m037-0186","start":186,"end":190,"surface":"韓之使者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、對話、稱謂或索隱述贊短稱待核，不補姓名及成員。"},{"id":"c-shiji-046-tian:m037-0217","start":217,"end":219,"surface":"田忌","kind":"person","person_id":"16n_czk_thg","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m037-0220","start":220,"end":222,"surface":"田嬰","kind":"person","person_id":"quo_167_x2v","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m037-0224","start":224,"end":226,"surface":"孫子","kind":"person","person_id":"u4r_ktr_4qm","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m037-0251","start":251,"end":253,"surface":"龐涓","kind":"person","person_id":"5v8_amk_emn","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m037-0255","start":255,"end":259,"surface":"魏太子申","kind":"person","person_id":"2jb_t1c_fpa","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m037-0262","start":262,"end":266,"surface":"三晉之王","kind":"unresolved","person_id":nu