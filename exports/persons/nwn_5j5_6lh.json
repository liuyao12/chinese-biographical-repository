,"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-053-xuezong:line041","text":"　　時交土始開，刺史呂岱率師討伐，綜與俱行，越海南征，及到九真。事畢還都，守遏者僕射。西使張奉於權前列尚書闞澤姓名以嘲澤，澤不能答。綜下行酒，因勸酒曰：「蜀者何也？有犬為獨，無犬為蜀，橫目苟身，蟲入其腹。」奉曰：「不當復列君吳邪？」綜應聲曰：「無口為天，有口為吴，君臨萬邦，天子之都。」於是眾坐喜笑，而奉無以對。其樞機敏捷，皆此類也。呂岱從交州召出，綜懼繼岱者非其人，上疏曰：","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-053-xuezong:line041:m0010","start":10,"end":12,"surface":"呂岱","kind":"person","person_id":"2oe_qam_pq4","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xuezong:line041:m0017","start":17,"end":18,"surface":"綜","kind":"person","person_id":"yt7_qwp_k7p","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xuezong:line041:m0045","start":45,"end":47,"surface":"張奉","kind":"person","person_id":"nwn_5j5_6lh","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xuezong:line041:m0048","start":48,"end":49,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xuezong:line041:m0053","start":53,"end":55,"surface":"闞澤","kind":"person","person_id":"r2b_2xl_58l","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xuezong:line041:m0059","start":59,"end":60,"surface":"澤","kind":"person","person_id":"r2b_2xl_58l","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xuezong:line041:m0061","start":61,"end":62,"surface":"澤","kind":"person","person_id":"r2b_2xl_58l","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xuezong:line041:m0066","start":66,"end":67,"surface":"綜","kind":"person","person_id":"yt7_qwp_k7p","status":"c