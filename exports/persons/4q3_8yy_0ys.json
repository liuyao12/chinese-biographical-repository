:133,"end":134,"surface":"豨","kind":"person","person_id":"1xx_s1v_svn","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m015-0135","start":135,"end":136,"surface":"豨","kind":"person","person_id":"1xx_s1v_svn","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m015-0145","start":145,"end":147,"surface":"王黃","kind":"person","person_id":"4q3_8yy_0ys","status":"contextual_provisional"}],"chapter_id":"c-shiji-093-hanlu","book_id":"b-shiji-093","work_id":"w-shiji","source_id":"s-shiji-093-hanlu"},{"id":"c-shiji-093-hanlu:p016","text":"上聞，乃赦趙、代吏人為豨所詿誤劫略者，皆赦之。上自往，至邯鄲，喜曰：「豨不南據漳水，北守邯鄲，知其無能為也。」趙相奏斬常山守、尉，曰：「常山二十五城，豨反，亡其二十城。」上問曰：「守、尉反乎？」對曰：「不反。」上曰：「是力不足也。」赦之，復以為常山守、尉。上問周昌曰：「趙亦有壯士可令將者乎？」對曰：「有四人。」四人謁，上謾罵曰：「豎子能為將乎？」四人慚伏。上封之各千戶，以為將。左右諫曰：「從入蜀、漢，伐楚，功未遍行，今此何功而封？」上曰：「非若所知！陳豨反，邯鄲以北皆豨有，吾以羽檄徵天下兵，未有至者，今唯獨邯鄲中兵耳。吾胡愛四千戶封四人，不以慰趙子弟！」皆曰：「善。」於是上曰：「陳豨將誰？」曰：「王黃、曼丘臣，皆故賈人。」上曰：「吾知之矣。」乃各以千金購黃、臣等。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-093-hanlu:m016-0000","start":0,"end":1,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m016-0011","start":11,"end":12,"surface":"豨","kind":"person","person_id":"1xx_s1v_svn","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m016-0023","start":23,"end":24,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m016-0035","start":35,"end":36,"surface":"豨","kind":"person","person_id":"1xx_s1v_svn","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m016-0055","start":55,"end":57,"surface":"趙相","kind":"person","person_id":"gfr_55l_72s","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m016-0059","start":59,"end":62,"surface":"常山守","kind":"person","person_id":"q9f_hno_txx","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m016-0063","start":63,"end":64,"surface":"尉","kind":"person","person_id":"w3g_k4m_zrn","status":"contex