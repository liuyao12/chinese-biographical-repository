anlu:m010-0186","start":186,"end":187,"surface":"豨","kind":"person","person_id":"1xx_s1v_svn","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m010-0192","start":192,"end":193,"surface":"豨","kind":"person","person_id":"1xx_s1v_svn","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m010-0197","start":197,"end":200,"surface":"燕王綰","kind":"person","person_id":"jjl_irg_zke_A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m010-0201","start":201,"end":203,"surface":"張勝","kind":"person","person_id":"h15_bnp_8ii","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m010-0211","start":211,"end":213,"surface":"張勝","kind":"person","person_id":"h15_bnp_8ii","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m010-0249","start":249,"end":251,"surface":"范齊","kind":"person","person_id":"bz6_7ka_tht","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m010-0252","start":252,"end":254,"surface":"陳豨","kind":"person","person_id":"1xx_s1v_svn","status":"contextual_provisional"}],"chapter_id":"c-shiji-093-hanlu","book_id":"b-shiji-093","work_id":"w-shiji","source_id":"s-shiji-093-hanlu"},{"id":"c-shiji-093-hanlu:p015","text":"豨常告歸過趙，趙相周昌見豨賓客隨之者千餘乘，邯鄲官舍皆滿。豨所以待賓客布衣交，皆出客下。豨還之代，周昌乃求入見。見上，具言豨賓客盛甚，擅兵於外數歲，恐有變。上乃令人覆案豨客居代者財物諸不法事，多連引豨。豨恐，陰令客通使王黃、曼丘臣所。及高祖十年七月，太上皇崩，使人召豨，豨稱病甚。九月，遂與王黃等反，自立為代王，劫略趙、代。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-093-hanlu:m015-0000","start":0,"end":1,"surface":"豨","kind":"person","person_id":"1xx_s1v_svn","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m015-0007","start":7,"end":9,"surface":"趙相","kind":"person","person_id":"gfr_55l_72s","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m015-0009","start":9,"end":11,"surface":"周昌","kind":"person","person_id":"gfr_55l_72s","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m015-0012","start":12,"end":13,"surface":"豨","kind":"person","person_id":"1xx_s1v_svn","status":"con