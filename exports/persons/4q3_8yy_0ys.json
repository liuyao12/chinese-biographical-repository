","start":289,"end":290,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m016-0293","start":293,"end":295,"surface":"陳豨","kind":"person","person_id":"1xx_s1v_svn","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m016-0302","start":302,"end":304,"surface":"王黃","kind":"person","person_id":"4q3_8yy_0ys","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m016-0305","start":305,"end":308,"surface":"曼丘臣","kind":"person","person_id":"w0d_2f6_1ih","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m016-0315","start":315,"end":316,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-093-hanlu","book_id":"b-shiji-093","work_id":"w-shiji","source_id":"s-shiji-093-hanlu"},{"id":"c-shiji-093-hanlu:p017","text":"十一年冬，漢兵擊斬陳豨將侯敞、王黃於曲逆下，破豨將張春於聊城，斬首萬餘。太尉勃入定太原、代地。十二月，上自擊東垣，東垣不下，卒罵上；東垣降，卒罵者斬之，不罵者黥之。更命東垣為真定。王黃、曼丘臣其麾下受購賞之，皆生得，以故陳豨軍遂敗。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-093-hanlu:m017-0009","start":9,"end":11,"surface":"陳豨","kind":"person","person_id":"1xx_s1v_svn","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m017-0012","start":12,"end":14,"surface":"侯敞","kind":"person","person_id":"3jk_04c_cyw","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m017-0015","start":15,"end":17,"surface":"王黃","kind":"person","person_id":"4q3_8yy_0ys","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m017-0023","start":23,"end":24,"surface":"豨","kind":"person","person_id":"1xx_s1v_svn","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m017-0025","start":25,"end":27,"surface":"張春","kind":"person","person_id":"qf1_qbc_81g","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m017-0038","start":38,"end":39,"surface":"勃","kind":"person","person_id":"koy_6jg_gcc","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m017-0051","start":51,"end":52,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m017-0064","start":64,"end":65,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m017-0090","start":90,"end":92,"surface":"王黃","kind":"person","person_id":"4q3_8yy_0ys","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m017-0093","start":93,"end":96,"surface":"曼丘臣","kind":"person","person_id":"w0d_2f6_1ih","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m017-0110","start":110,"end":112,"surface":"陳豨","kind":"person","person_id":"1xx_s1v_svn","status":"contextual_provisional"}],"chapter_id":"c-shiji-093-hanlu","book_id":"b-shiji-093","work_id":"w-shiji","source_id":"s-shiji-093-hanlu"},{"id":"c-shiji-110-xiongnu:p012","text":"是時漢初定中國，徙韓王信於代，都馬邑。匈奴大攻圍馬邑，韓王信降匈奴。匈奴得信，因引兵南踰句注，攻太原，至晉陽下。高帝自將兵往擊之。會冬大寒雨雪，卒之墮指者十二三，於是冒頓詳敗走，誘漢兵。漢兵逐擊冒頓，冒頓匿其精兵，見其羸弱，於是漢悉兵，多步兵，三十二萬，北逐之。高帝先至平城，步兵未盡到，冒頓縱精兵四十萬騎圍高帝於白登，七日，漢兵中外不得相救餉。匈奴騎，其西方盡白馬，東方盡青駹馬，北方盡烏驪馬，南方盡騂馬。高帝乃使使閒厚遺閼氏，閼氏乃謂冒頓曰：「兩主不相困。今得漢地，而單于終非能居之也。且漢王亦有神，單于察之。」冒頓與韓王信之將王黃、趙利期，而黃、利兵又不來，疑其與漢有謀，亦取閼氏之言，乃解圍之一角。於是高帝令士皆持滿傅矢外鄉，從解角直出，竟與大軍合，而冒頓遂引兵而去。漢亦引兵而罷，使劉敬結和親之約。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-110-xiongnu:m012-0009","start":9,"end":12,"surface":"韓王信","kind":"person","person_id":"l9e_fbr_36a_*A","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m012-0027","start":27,"end":30,"surface":"韓王信","kind":"person","person_id":"l9e_fbr_36a_*A","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m012-0037","start":37,"end":38,"surface":"信","kind":"person","person_id":"l9e_fbr_36a_*A","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m012-0056","start":56,"end":58,"surface":"高帝","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m012-0083","start":83,"end":85,"surface":"冒頓","kind":"person","pers