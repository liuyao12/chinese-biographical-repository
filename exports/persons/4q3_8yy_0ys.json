d":"wjt_htu_081_A","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m012-0261","start":261,"end":264,"surface":"韓王信","kind":"person","person_id":"l9e_fbr_36a_*A","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m012-0266","start":266,"end":268,"surface":"王黃","kind":"person","person_id":"4q3_8yy_0ys","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m012-0269","start":269,"end":271,"surface":"趙利","kind":"person","person_id":"ibi_qk6_07w","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m012-0274","start":274,"end":275,"surface":"黃","kind":"person","person_id":"4q3_8yy_0ys","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m012-0276","start":276,"end":277,"surface":"利","kind":"person","person_id":"ibi_qk6_07w","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m012-0291","start":291,"end":293,"surface":"閼氏","kind":"person","person_id":"32k_yr7_5kv","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m012-0305","start":305,"end":307,"surface":"高帝","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m012-0330","start":330,"end":332,"surface":"冒頓","kind":"person","person_id":"wjt_htu_081_A","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m012-0346","start":346,"end":348,"surface":"劉敬","kind":"person","person_id":"e5s_bwt_y45","status":"contextual_provisional"}],"chapter_id":"c-shiji-110-xiongnu","book_id":"b-shiji-110","work_id":"w-shiji","source_id":"s-shiji110-xiongnu"},{"id":"c-shiji-110-xiongnu:p013","text":"是後韓王信爲匈奴將，及趙利、王黃等數倍約，侵盜代、雲中。居無幾何，陳豨反，又與韓信合謀擊代。漢使樊噲往擊之，復拔代、鴈門、雲中郡縣，不出塞。是時匈奴以漢將眾往降，故冒頓常往來侵盜代地。於是漢患之，高帝乃使劉敬奉宗室女公主爲單于閼氏，歳奉匈奴絮繒酒米食物各有數，約爲昆弟以和親，冒頓乃少止。後燕王盧綰反，率其黨數千人降匈奴，往來苦上谷以東。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-110-xiongnu:m013-0002","start":2,"end":5,"surface":"韓王信","kind":"person","person_id":"l9e_fbr_36a_*A","status":"contextual_provisional"},{"id":"c-shiji-1