tity_cases":[{"id":"u-shiji110-hanguiren","candidate_person_ids":["l9a_lun_z7u","czy_wmj_0wb"],"status":"unresolved","paragraph_ids":["c-shiji-110-xiongnu:p048"],"mention_ids":["c-shiji-110-xiongnu:m048-0136"],"note":"此漢貴人緊接路充國佩印送喪，但示詞可能稱出使者或送葬的貴人；保留兩個已見候選，不暗以漢字、二千石印綬或死者先行詞選人，不據此新增稱號。","chapter_id":"c-shiji-110-xiongnu","source_id":"s-shiji110-xiongnu"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-shiji110-guishi","person_id":"czy_wmj_0wb","event_type":"death","status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-110-xiongnu","source_id":"s-shiji110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p048","quote":"楊信既歸，漢使王烏，而單于復肴甘言，欲多得漢財物，紿謂王烏曰：「吾欲入漢見天子，面相約爲兄弟。」王烏歸報漢，漢爲單于築邸于長安。匈奴曰：「非得漢貴人使，吾不與誠語。」匈奴使其貴人至漢，病，漢予藥，欲愈之，不幸而死。而漢使路充國佩二千石印綬往使，因送其喪，厚葬直數千金，曰「此漢貴人也」。單于以爲漢殺吾貴使者，乃留路充國不歸。諸所言者，單于特空紿王烏，殊無意入漢及遣太子來質。於是匈奴數使奇兵侵犯邊。漢乃拜郭昌爲拔胡將軍，及浞野侯屯朔方以東，備胡。路充國留匈奴三歳，單于死。","person_mention_id":"c-shiji-110-xiongnu:m048-0086"}],"interpretation_note":"保存明示死亡及原有相對敘事；使事與征服背景跨年，未定數字卒年。貴使在漢病死，不把單于以為漢殺判為已證實謀殺，不猜卒地城名或葬地。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"mentions":[{"id":"c-shiji-110-xiongnu:m048-0086","start":86,"end":89,"surface":"其貴人","kind":"person","person_id":"czy_wmj_0wb","status":"contextual_provisional","paragraph_id":"c-shiji-110-xiongnu:p048","chapter_id":"c-shiji-110-xiongnu"},{"id":"c-shiji-110-xiongnu:m048-0150","start":150,"end":153,"surface":"貴使者","kind":"person","person_id":"czy_wmj_0wb","status":"contextual_provisional","paragraph_id":"c-shiji-110-xiongnu:p048","chapter_id":"c-shiji-110-xiongnu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji110-007","person_id":"czy_wmj