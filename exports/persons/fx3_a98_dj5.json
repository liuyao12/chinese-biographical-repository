:20,"text":"綽嘗謂宅無吉凶請以爲第始造未及居而敗子儉"}]},"chapter_id":"c-nanshi-022-wangsengchuo-wyd","book_id":"b-nanshi-022","work_id":"w-nanshi","source_id":"s-nanshi-022-wangsengchuo-wyd1739"},{"id":"c-nanshi-022-wangsengchuo:p005","text":"初，太社西空地，本吳時丁奉宅，孫皓流徙其家。江左初，為周顗、蘇峻宅，後為袁悅宅，又為章武王司馬秀宅，皆以凶終；及給臧燾，亦頻遇禍，故世稱凶地。僧綽嘗謂宅無吉凶，請以為第，始造，未及居而敗。子儉。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"start":11,"end":13,"surface":"丁奉","id":"c-nanshi-022-wangsengchuo:p005:m0011","person_id":"nd1_eoc_wrb","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作丁奉。"},{"start":15,"end":17,"surface":"孫皓","id":"c-nanshi-022-wangsengchuo:p005:m0015","person_id":"05e_9bb_55a","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作孫皓。"},{"start":27,"end":29,"surface":"周顗","id":"c-nanshi-022-wangsengchuo:p005:m0027","person_id":"3xx_gdy_or6_AAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作周顗。"},{"start":30,"end":32,"surface":"蘇峻","id":"c-nanshi-022-wangsengchuo:p005:m0030","person_id":"lrg_cze_g1l","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作蘇峻。"},{"start":36,"end":38,"surface":"袁悅","id":"c-nanshi-022-wangsengchuo:p005:m0036","person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"此地諸宅前後相承，可核同段所記宅主；晉書具名袁悅之的傳文未言此宅。二者同指待考。","candidate_person_ids":["c72_605_73c"]},{"start":45,"end":48,"surface":"司馬秀","id":"c-nanshi-022-wangsengchuo:p005:m0045","person_id":"0vi_pxk_rw2","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作章武王司馬秀。"},{"start":57,"end":59,"surface":"臧燾","id":"c-nanshi-022-wangsengchuo:p005:m0057","person_id":"fx3_a98_dj5","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作臧夀（卷71原字）。"},{"start":71,"end":73,"surface":"僧綽","id":"c-nanshi-022-wangsengchuo:p005:m0071","person_id":"7r6_k52_qji_ABAAAAEA","kind":"person","status":"contextual_provisio