i1","status":"contextual_provisional"},{"id":"c-jinshu-052-xi-shen:p012:m0067","start":67,"end":68,"surface":"詵","kind":"person","person_id":"79d_btn_di1","status":"contextual_provisional"},{"id":"c-jinshu-052-xi-shen:p012:m0086","start":86,"end":87,"surface":"詵","kind":"person","person_id":"79d_btn_di1","status":"contextual_provisional"},{"id":"c-jinshu-052-xi-shen:p012:m0106","start":106,"end":108,"surface":"延登","kind":"person","person_id":"m7s_vpf_3kt","status":"contextual_provisional"}],"chapter_id":"c-jinshu-052-xi-shen","book_id":"b-jinshu-052","work_id":"w-jinshu","source_id":"s-jinshu-052-xi-shen-ws2604575"},{"id":"c-jinshu-070-biandun:p001","text":"敦字仲仁。父俊，清真有檢識，以名理著稱。其鄉人郤詵恃才陵傲俊兄弟，俊等亦以門盛輕詵，相視如讎。詵以楊駿故吏被繫，俊時爲尚書郎，案其獄，詵懼不免，俊平心斷決正之，詵卒以免，而猶不悛。後爲左丞，復奏陷卞氏。俊歷位汝南相、廷尉卿。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":91,"last_line":91,"raw_start":9466,"raw_end":9585,"raw_character_offsets":[9473,9474,9475,9476,9477,9478,9479,9480,9481,9482,9483,9484,9485,9486,9487,9488,9489,9490,9491,9492,9493,9494,9495,9496,9497,9498,9499,9500,9501,9502,9503,9504,9505,9506,9507,9508,9509,9510,9511,9512,9513,9514,9515,9516,9517,9518,9519,9520,9521,9522,9523,9524,9525,9526,9527,9528,9529,9530,9531,9532,9533,9534,9535,9536,9537,9538,9539,9540,9541,9542,9543,9544,9545,9546,9547,9548,9549,9550,9551,9552,9553,9554,9555,9556,9557,9558,9559,9560,9561,9562,9563,9564,9565,9566,9567,9568,9569,9570,9571,9572,9573,9574,9575,9576,9577,9578,9579,9580,9581,9582,9583,9584],"revision_id":2595540},"mentions":[{"id":"c-jinshu-070-biandun:p001:m0000","surface":"敦","start":0,"end":1,"person_id":"ag0_yix_pet","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-070-biandun:p001:m0006","surface":"俊","start":6,"end":7,"person_id":"dh7_epf_8e7","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-070-biandun:p001:m0023","surface":"郤詵","start":23,"end":25,"person_id":"79d_btn_di1","kind":"person","status":"contextual_provisional"},{"id