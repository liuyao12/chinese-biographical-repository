楷奉書於休曰：","person_mention_id":"c-sanguozhi-064-suncong-complete:p009:m0022"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-064-suncong-complete:p009","text":"　　典軍施正勸綝徵立琅邪王休，綝從之。遣宗正楷奉書於休曰：","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":86,"last_line":86,"raw_start":12120,"raw_end":12149,"raw_character_offsets":[12120,12121,12122,12123,12124,12125,12126,12127,12128,12129,12130,12131,12132,12133,12134,12135,12136,12137,12138,12139,12140,12141,12142,12143,12144,12145,12146,12147,12148],"revision_id":2263487},"mentions":[{"id":"c-sanguozhi-064-suncong-complete:p009:m0004","surface":"施正","start":4,"end":6,"kind":"person","person_id":"h0e_ifn_9ue","status":"contextual_provisional"},{"id":"c-sanguozhi-064-suncong-complete:p009:m0007","surface":"綝","start":7,"end":8,"kind":"person","person_id":"hzw_vox_wvw","status":"contextual_provisional"},{"id":"c-sanguozhi-064-suncong-complete:p009:m0013","surface":"休","start":13,"end":14,"kind":"person","person_id":"0fo_c5c_4yh","status":"contextual_provisional"},{"id":"c-sanguozhi-064-suncong-complete:p009:m0015","surface":"綝","start":15,"end":16,"kind":"person","person_id":"hzw_vox_wvw","status":"contextual_provisional"},{"id":"c-sanguozhi-064-suncong-complete:p009:m0022","surface":"楷","start":22,"end":23,"kind":"person","person_id":"sz5_fmo_y3h","status":"contextual_provisional"},{"id":"c-sanguozhi-064-suncong-complete:p009:m0026","surface":"休","start":26,"end":27,"kind":"person","person_id":"0fo_c5c_4yh","status":"contextual_provisional"}],"chapter_id":"c-sanguozhi-064-suncong-complete","book_id":"b-sanguozhi-064","work_id":"w-sanguozhi","source_id":"s-sanguozhi-064-suncong-complete-ws2263487"},{"id":"c-sanguozhi-064-suncong-complete:p010","text":"綝以薄才，見授大任，不能輔導陛下。頃月以來，多所造立。親近劉承，悅於美色；發吏民婦女，料其好者，留於宮內，取兵弟十八已下三千餘人，習之苑中，連日續夜，大小呼嗟，敗壞藏中矛戈五千餘枚，以作戲具。朱據先帝舊臣，子男熊、損皆承父之基，以忠議自立，昔殺小主。自是大主所創，帝不復精其本未，便殺熊、損，諫不見用。諸下莫不側息。帝於宮中作小船三百餘艘，成以金銀，師工晝夜不息。太常全尚，累世受恩，不能督諸宗親，而全端等委城就魏。尚位過重，曾無一言以諫陛下，而與敵往來，使傳國消息，懼必傾危社稷。推案舊典，運集大王，輒以今月二十七日擒尚斬承。以帝為會稽王，遣楷牽迎。百寮喁喁。立任道側。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":87,"last_line":87,"raw_start":12150,"raw_end":12446,"raw_character_offsets":[12158,12159,12160,12161,12162,12163,12164,12165,12166,12167,12168,12169,12170,12171,12172,12173,12174,12175,12176,12177,12178,12179,12180,12181,12182,12183,12184,12185,12186,12187,12188,12189,12190,12191,12192,12193,12194,12195,12196,12197,12198,12199,12200,12201,12202,12203,12204,12205,12206,12207,12208,12209,12210,12211,12212,12213,12214,12215,12216,12217,12218,12219,12220,12221,12222,12223,12224,12225,12226,12227,12228,12229,12230,12231,12232,12233,12234,12235,12236,12237,12238,12239,12240,12241,12242,12243,12244,12245,12246,12247,12248,12249,12250,12251,12252,12253,12254,12255,12256,12257,12258,12259,12260,12261,12262,12263,12264,12265,12266,12267,12268,12269,12270,12271,12272,12273,12274,12275,12276,12277,12278,12279,12280,12281,12282,12283,12284,12285,12286,12287,12288,12289,12290,12291,12292,12293,12294,12295,12296,12297,12298,12299,12300,12301,12302,12303,12304,12305,12306,12307,12308,12309,12310,12311,12312,12313,12314,12315,12316,12317,12318,12319,12320,12321,12322,12323,12324,12325,12326,12327,12328,12329,12330,12331,12332,12333,12334,12335,12336,12337,12338,12339,12340,12341,12342,12343,12344,12345,12346,12347,12348,12349,12350,12351,12352,12353,12354,12355,12356,12357,12358,12359,12360,12361,12362,12363,12364,12365,12366,12367,12368,12369,12370,12371,12372,12373,12374,12375,12376,12377,12378,12379,12380,12381,12382,12383,12384,12385,12386,12387,12388,12389,12390,12391,12392,12393,12394,12395,12396,12397,12398,12399,12400,12401,12402,12403,12