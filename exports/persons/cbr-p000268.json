核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-004-zhou:p059","text":"二十七年，靈王崩，子景王貴立。景王十八年，后太子聖而蚤卒。二十年，景王愛子朝，欲立之，會崩，子丐之黨與爭立，國人立長子猛為王，子朝攻殺猛。猛為悼王。晉人攻子朝而立丐，是為敬王。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-004-zhou:m059-0005","start":5,"end":7,"surface":"靈王","kind":"person","person_id":"6a7_li3_zwm","status":"source_identified"},{"id":"c-shiji-004-zhou:m059-0010","start":10,"end":13,"surface":"景王貴","kind":"person","person_id":"ary_z8m_f18","status":"source_identified"},{"id":"c-shiji-004-zhou:m059-0015","start":15,"end":17,"surface":"景王","kind":"person","person_id":"ary_z8m_f18","status":"source_identified"},{"id":"c-shiji-004-zhou:m059-0021","start":21,"end":25,"surface":"后太子聖","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官號或文字疑讀；保留錨點，不補熟知姓名或假定同指。"},{"id":"c-shiji-004-zhou:m059-0033","start":33,"end":35,"surface":"景王","kind":"person","person_id":"ary_z8m_f18","status":"source_identified"},{"id":"c-shiji-004-zhou:m059-0036","start":36,"end":38,"surface":"子朝","kind":"person","person_id":"9oe_ish_fuj","status":"source_identified"},{"id":"c-shiji-004-zhou:m059-0047","start":47,"end":48,"surface":"丐","kind":"person","person_id":"sq3_9p2_9n3","status":"source_identified"},{"id":"c-shiji-004-zhou:m059-0057","start":57,"end":59,"surface":"長子","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官號或文字疑讀；保留錨點，不補熟知姓名或假定同指。"},{"id":"c-shiji-004-zhou:m059-0059","start":59,"end":60,"surface":"猛","kind":"person","person_id":"nec_2vd_5tr","status":"source_identified"},{"id":"c-shiji-004-zhou:m059-0063","start":63,"end":65,"surface":"子朝","kind":"person","person_id":"9oe_ish_fuj","status":"source_identified"},{"id":"c-shiji-004-zhou:m059-0067","start":67,"end":68,"surface":"猛","kind":"person","person_id":"nec_2vd_5tr","status":"source_identified"},{"id":"c-shiji-004-zhou:m059-0069","start":69,"end":70,"surface":"猛","kind":"person","person_id":"nec_2vd_5tr","status":"