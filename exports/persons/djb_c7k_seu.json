lete:p078:m0065","mention_ids":["c-nanqishu-054-recluses-complete:p078:m0065"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-054-recluses-complete:p078:m0104","mention_ids":["c-nanqishu-054-recluses-complete:p078:m0104"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-054-recluses-complete:p078:m0146","mention_ids":["c-nanqishu-054-recluses-complete:p078:m0146"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-054-recluses-complete:p079:m0018","mention_ids":["c-nanqishu-054-recluses-complete:p079:m0018"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-054-recluses-complete:p079:m0105","mention_ids":["c-nanqishu-054-recluses-complete:p079:m0105"],"kind":"paragraph"}],"mention_count":9,"duplicate_mention_count":0,"paragraph_occurrence_count":9,"table_occurrence_count":0,"passage_count":3,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"9處獨立位置，9個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-nanqishu-054-recluses-complete-ws1762878"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-nanqishu-054-recluses-complete:source_review77-0","kind":"source_review","person_id":"djb_c7k_seu","source_quote":"　　徐伯珍字文楚，東陽太末人也。祖父竝郡掾史。","reading":"徐伯珍祖父竝郡掾史，皆無名。","note":"徐伯珍祖父竝郡掾史，皆無名。","paragraph_id":"c-nanqishu-054-recluses-complete:p077","start_codepoint":0,"end_codepoint":23,"human_reviewed":false,"chapter_id":"c-nanqishu-054-recluses-complete","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:source_review78-0","kind":"source_review","person_id":"djb_c7k_seu","source_quote":"　　伯珍少孤貧，書竹葉及地學書。山水暴出，漂溺宅舍，村隣皆奔走，伯珍累牀而止，讀書不輟。叔父璠之與顏延之友善，還祛蒙山立精舍講授，伯珍往從學，積十年，究尋經史，遊學者多依之。太守琅邪王曇生、吳郡張淹竝加禮辟，伯珍應召便退，如此者凡十二焉。徵士沈儼造膝談論，申以素交。吳郡顧歡擿出《尚書》滯義，伯珍訓答甚有條理，儒者宗之。","reading":"叔父璠之與顏延之友善。沈儼依《南史》同句注文接合本卷沈儼之；兩種名字各存原字。","note":"叔父璠之與顏延之友善。沈儼依《南史》同句注文接合本卷沈儼之；兩種名字各存原字。","paragraph_id":"c-nanqishu-054-recluses-complete:p078","start_codepoint":0,"end_codepoint":160,"human_reviewed":false,"chapter_id":"c-nanqishu-054-recluses-complete","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:source_review79-0","kind":"source_review","person_id":"djb_c7k_seu","source_quote":"　　好釋氏、老莊，兼明道術，歲常旱，伯珍筮之，如期雨澍。舉動有禮，過曲木之下，趨而避之。早喪妻，晚不復重娶，自比曾參。宅南九里有高山，班固謂之九巖山，後漢龍丘萇隱處也。山多龍鬚柏，望之五采，世呼爲婦人巖。二年，伯珍移居之。門前生梓樹，一年便合抱。館東石壁夜忽有赤光洞照，俄爾而滅。白雀一雙栖其戶牖，論者以爲隱德之感焉。永明二年，刺史豫章王辟議曹從事，不就。家甚貧窶，兄弟四人，皆白首相對，時人呼爲「四皓」。建武四年，卒。年八十四。受業生凡千餘人。","reading":"早喪妻及兄弟四人皆無全名。移居之二年保留原稱，建武四年卒報年八十四。","note":"早喪妻及兄弟四人皆無全名。移居之二年保留原稱，建武四年卒報年八十四。","paragraph_id":"c-nanqishu-054-recluses-complete:p079","start_codepoint":0,"end_codepoint":223,"human_reviewed":false,"chapter_id":"c-nanqishu-054-recluses-complete","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:variant_review79-203","kind":"variant_review","person_id":"djb_c7k_seu","source_quote":"建武四年，卒。年八十四","reading":"確切卒年和原年齡獨立。前「二年伯珍移居」依原時序而不補年號。","note":"確切卒年和原年齡獨立。前「二年伯珍移居」依原時序而不補年號。","paragraph_id":"c-nanqishu-054-recluses-complete:p079","start_codepoint":203,"end_codepoint":214,"human_reviewed":false,"chapter_id":"c-nanqishu-054-recluses-complete","source_id":"s-nanqishu-054-recluses-complete-ws1762878"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-qi054-xubozhen-death","person_id":"djb_c7k_seu","event_type":"death","source_term":"卒","source_anchor":{"paragraph_id":"c-nanqishu-054-recluses-complete:p079","start":208,"end":209,"surface":"卒"},"date_expression":"建武四年","evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-054","chapter_id":"c-nanqishu-054-recluses-complete","source_id":"s-nanqishu-054-recluses-complete-ws1762878","paragraph_id":"c-nanqishu-054-recluses-complete:p079","quote":"　　好釋氏、老莊，兼明道術，歲常旱，伯珍筮之，如期雨澍。舉動有禮，過曲木之下，趨而避之。早喪妻，晚不復重娶，自比曾參。宅南九里有高山，班固謂之九巖山，後漢龍丘萇隱處也。山多龍鬚柏，望之五采，世呼爲婦人巖。二年，伯珍移居之。門前生梓樹，一年便合抱。館東石壁夜忽有赤光洞照，俄爾而滅。白雀一雙栖其戶牖，論者以爲隱德之感焉。永明二年，刺史豫章王辟議曹從事，不就。家甚貧窶，兄弟四人，皆白首相對，時人呼爲「四皓」。建武四年，卒。年八十四。受業生凡千餘人。","person_mention_id":"c-nanqishu-054-recluses-complete:p079:m0018"}],"status":"source_attested","interpretation_note":"按同段人物與次第核所屬卒事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"age_assertions":[{"id":"age-qi054-xubozhen-death","person_id":"djb_c7k_seu","source_number":"八十四","source_term":"年八十四","value":84,"unit":"source_age_years","counting":"unspecified_source_age","birth_year":null,"date_expression":"建武四年","source_anchor":{"paragraph_id":"c-nanqishu-054-recluses-complete:p079","start":210,"end":214,"surface":"年八十四"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-054","chapter_id":"c-nanqishu-054-recluses-complete","source_id":"s-nanqishu-054-recluses-complete-ws1762878","paragraph_id":"c-nanqishu-054-recluses-complete:p079","quote":"　　好釋氏、老莊，兼明道術，歲常旱，伯珍筮之，如期雨澍。舉動有禮，過曲木之下，趨而避之。早喪妻，晚不復重娶，自比曾參。宅南九里有高山，班固謂之九巖山，後漢龍丘萇隱處也。山多龍鬚柏，望之五采，世呼爲婦人巖。二年，伯珍移居之。門前生梓樹，一年便合抱。館東石壁夜忽有赤光洞照，俄爾而滅。白雀一雙栖其戶牖，論者以爲隱德之感焉。永明二年，刺史豫章王辟議曹從事，不就。家甚貧窶，兄弟四人，皆白首相對，時人呼爲「四皓」。建武四年，卒。年八十四。受業生凡千餘人。","person_mention_id":"c-nanqishu-054-recluses-complete:p079:m0018"}],"age_context":{"kind":"at_death","life_event_id":"le-qi054-xubozhen-death"},"status":"source_attested","interpretation_note":"同段卒事所繫原報年齡。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"mentions":[{"id":"c-nanqishu-054-recluses-complete:p077:m0002","start":2,"end":5,"surface":"徐伯珍","kind":"person","person_id":"djb_c7k_seu","status":"contextual_provisional","parag