nd":106,"surface":"伯珍","kind":"person","person_id":"djb_c7k_seu","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p078:m0121","start":121,"end":123,"surface":"沈儼","kind":"person","person_id":"yvy_ggc_5tk","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p078:m0135","start":135,"end":137,"surface":"顧歡","kind":"person","person_id":"bn8_cdi_hv9","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p078:m0146","start":146,"end":148,"surface":"伯珍","kind":"person","person_id":"djb_c7k_seu","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-054-recluses-complete","book_id":"b-nanqishu-054","work_id":"w-nanqishu","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:p079","text":"　　好釋氏、老莊，兼明道術，歲常旱，伯珍筮之，如期雨澍。舉動有禮，過曲木之下，趨而避之。早喪妻，晚不復重娶，自比曾參。宅南九里有高山，班固謂之九巖山，後漢龍丘萇隱處也。山多龍鬚柏，望之五采，世呼爲婦人巖。二年，伯珍移居之。門前生梓樹，一年便合抱。館東石壁夜忽有赤光洞照，俄爾而滅。白雀一雙栖其戶牖，論者以爲隱德之感焉。永明二年，刺史豫章王辟議曹從事，不就。家甚貧窶，兄弟四人，皆白首相對，時人呼爲「四皓」。建武四年，卒。年八十四。受業生凡千餘人。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":200,"last_line":200,"raw_start":10293,"raw_end":10516,"raw_character_offsets":[10293,10294,10295,10296,10297,10298,10299,10300,10301,10302,10303,10304,10305,10306,10307,10308,10309,10310,10311,10312,10313,10314,10315,10316,10317,10318,10319,10320,10321,10322,10323,10324,10325,10326,10327,10328,10329,10330,10331,10332,10333,10334,10335,10336,10337,10338,10339,10340,10341,10342,10343,10344,10345,10346,10347,10348,10349,10350,10351,10352,10353,10354,10355,10356,10357,10358,10359,10360,10361,10362,10363,10364,10365,10366,10367,10368,10369,10370,10371,10372,10373,10374,10375,10376,10377,10378,10379,10380,10381,10382,10383,10384,10385,10386,10387,10388,10389,10390,10391,10392,10393,10394,10395,10396,10397,10398,10399,10400,10401,10402,10403,10404,10405,10406,10407,10408,10409,10410,10411,10412,10413,10414,10415,10416,10417,10418,10419,10420,10421,10422,10423,10424,