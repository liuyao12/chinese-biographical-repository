ts":[],"identity_decisions":[{"id":"d-sgz023-fourner-huanglang","person_id":"pix_akk_jz0","surfaces":["黃朗","文達","朗","黃"],"scope":"same_chapter","chapter_ids":["c-sanguozhi-023-peiqian-ws2376966"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-sanguozhi-023-peiqian-ws2376966","paragraph_id":"c-sanguozhi-023-peiqian-ws2376966:p010","quote":"《魏略列傳》以徐福、嚴幹、李義、張既、游楚、梁習、趙儼、裴潛、韓宣、黃朗十人共卷，其既、習、儼、潛四人自有傳，徐福事在《諸葛亮傳》，游楚事在《張既傳》。餘韓等四人載之於後。","mention_ids":["c-sanguozhi-023-peiqian-ws2376966:p010:m0034"]},{"chapter_id":"c-sanguozhi-023-peiqian-ws2376966","paragraph_id":"c-sanguozhi-023-peiqian-ws2376966:p013","quote":"◎黃朗字文達，沛郡人也。爲人弘通有性實。父爲本縣卒，朗感其如此，抗志游學，由是爲方國及其郡士大夫所禮異。特與東平右姓王惠陽爲碩交，惠陽親拜朗母於牀下。朗始仕黃初中，爲長吏，遷長安令，會喪母不赴，復爲魏令，遷襄城典農中郎將、涿郡太守。以明帝時疾病卒。始朗爲君長，自以父故，常忌不呼鈴下伍伯，而呼其姓字，至於忿怒，亦終不言。朗既仕至二千石，而惠陽亦歷長安令、酒泉太守。故時人謂惠陽外似粗疏而內堅密，能不顧朗之本末，事朗母如己母，爲通度也。","mention_ids":["c-sanguozhi-023-peiqian-ws2376966:p013:m0001","c-sanguozhi-023-peiqian-ws2376966:p013:m0004","c-sanguozhi-023-peiqian-ws2376966:p013:m0026","c-sanguozhi-023-peiqian-ws2376966:p013:m0069","c-sanguozhi-023-peiqian-ws2376966:p013:m0075","c-sanguozhi-023-peiqian-ws2376966:p013:m0125","c-sanguozhi-023-peiqian-ws2376966:p013:m0160","c-sanguozhi-023-peiqian-ws2376966:p013:m0200","c-sanguozhi-023-peiqian-ws2376966:p013:m0206"]},{"chapter_id":"c-sanguozhi-023-peiqian-ws2376966","paragraph_id":"c-sanguozhi-023-peiqian-ws2376966:p014","quote":"魚豢曰：世稱君子之德其猶龍乎，蓋以其善變也。昔長安巿儈有劉仲始者，一爲巿吏所辱，乃感激，蹋其尺折之，遂行學問，經明行脩，流名海內。後以有道徵，不肯就，衆人歸其高。余以爲前世偶有此耳，而今徐、嚴復參之，若皆非似龍之志也，其何能至於此哉？李推至道，張工度主，韓見識異，黃能拔萃，各著根於石上，而垂陰乎千里，亦未爲易也。游翁慷慨，展布腹心，全軀保郡，見延帝王，又放陸生，優遊宴戲，亦一實也。梁、趙及裴，雖張、楊不足，至於檢己，老而益明，亦難能也。","mention_ids":["c-sanguozhi-023-peiqian-ws2376966:p014:m0132"]}],"rationale":"依完整裴潛單元及具體上下文辨識；原字及見證層次保留。","human_reviewed":false,"reviewer":"Codex（AI代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-023-peiqian-ws2376966:p010","text":"《魏略列傳》以徐福、嚴幹、李義、張既、游楚、梁習、趙儼、裴潛、韓宣、黃朗十人共卷，其既、習、儼、潛四人自有傳，徐福事在《諸葛亮傳》，游楚事在《張既傳》。餘韓等四人載之於後。","text_layer":"witness_appended_pei_songzhi_note","annotation_status":"in_progress","mentions":[{"id":"c-sanguozhi-023-peiqian-ws2376966:p010:m0000","start":0,"end":6,"surface":"《魏略列傳》","kind":"work","person_id":null,"status":"source_explicit","interpretation_note":"魏略列傳指魏略的列傳部分與十人目次，非獨立新書；此句是裴注安排說明。 原文、MID與字位不變；不拆題中人名。","work_id":"w-weilue-sgz028-reference","cited_part":"列傳"},{"id":"c-sanguozhi-023-peiqian-ws2376966:p010:m0007","start":7,"end":9,"surface":"徐福","kind":"person","person_id":"d1c_f9d_yc9","status":"contextual_provisional","interpretation_note":"卷023明指諸葛亮傳的徐福；對讀固定卷035明徐庶元直及庶先名福，沿既有元直身份；絕非秦方士徐巿。"},{"id":"c-sanguozhi-023-peiqian-ws2376966:p010:m0010","start":10,"end":12,"surface":"嚴幹","kind":"person","person_id":"v2q_174_14w","status":"contextual_provisional","interpretation_note":"依完整裴潛單元及具體上下文辨識；原字及見證層次保留。"},{"id":"c-sanguozhi-023-peiqian-ws2376966:p010:m0013","start":13,"end":15,"surface":"李義","kind":"person","person_id":"lwm_a4z_q9p","status":"contextual_provisional","interpretation_note":"依完整裴潛單元及具體上下文辨識；原字及見證層次保留。"},{"id":"c-sanguozhi-023-peiqian-ws2376966:p010:m0016","start":16,"end":18,"surface":"張既","kind":"person","person_id":"lpc_1gj_ahs","status":"contextual_provisional","interpretation_note":"依完整裴潛單元及具體上下文辨識；原字及見證層次保留。"},{"id":"c-sanguozhi-023-peiqian-ws2376966:p010:m0019","start":19,"end":21,"surface":"游楚","kind":"person","person_id":"d40_cx2_vot","status":"contextual_provisional","interpretation_note":"依完整裴潛單元及具體上下文辨識；原字及見證層次保留。"},{"id":"c-sanguozhi-023-peiqian-ws2376966:p010:m0022","start":22,"end":24,"surface":"梁習","kind":"person","person_id":"y6r_ljn_vv8","status":"contextual_provisional","interpretation_note":"依完整裴潛單元及具體上下文辨識；原字及見證層次保留。"},{"id":"c-sanguozhi-023-peiqian-ws2376966:p010:m0025","start":25,"end":27,"surface":"趙儼","kind":"person","person_id":"9ce_e37_1dc","status":"contextual_provisional","interpretation_note":"依完整裴潛單元及具體上下文辨識；原字及見證層次保留。"},{"id":"c-sanguozhi-023-peiqian-ws2376966:p010:m0028","start":28,"end":30,"surface":"裴潛","kind":"person","person_id":"kbq_kjc_n2f_A