{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"chz_6r7_teu","canonical_person_id":"chz_6r7_teu","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["chz_6r7_teu"],"persons":[{"id":"chz_6r7_teu","label":"田信（酷吏列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"田信","mention_ids":["c-shiji-122-kuli:m023-0274","c-shiji-122-kuli:m024-0100"]},{"surface":"信","mention_ids":["c-shiji-122-kuli:m023-0285"]}],"evidence":[{"mention_id":"c-shiji-122-kuli:m023-0274","chapter_id":"c-shiji-122-kuli","paragraph_id":"c-shiji-122-kuli:p023","quote":"田信"},{"mention_id":"c-shiji-122-kuli:m023-0285","chapter_id":"c-shiji-122-kuli","paragraph_id":"c-shiji-122-kuli:p023","quote":"信"},{"mention_id":"c-shiji-122-kuli:m024-0100","chapter_id":"c-shiji-122-kuli","paragraph_id":"c-shiji-122-kuli:p024","quote":"田信"}]}],"source_mention_summary":[{"source_id":"s-shiji122-kuli","work_id":"w-shiji","book_id":"b-shiji-122","chapter_id":"c-shiji-122-kuli","mention_count":3,"mention_ids":["c-shiji-122-kuli:m023-0274","c-shiji-122-kuli:m023-0285","c-shiji-122-kuli:m024-0100"],"paragraph_ids":["c-shiji-122-kuli:p023","c-shiji-122-kuli:p024"],"passage_count":2}],"most_mentioned_source_ids":["s-shiji122-kuli"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-122-kuli:m023-0274","start":274,"end":276,"surface":"田信","kind":"person","person_id":"chz_6r7_teu","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p023","chapter_id":"c-shiji-122-kuli"},{"id":"c-shiji-122-kuli:m023-0285","start":285,"end":286,"surface":"信","kind":"person","person_id":"chz_6r7_teu","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p023","chapter_id":"c-shiji-122-kuli"},{"id":"c-shiji-122-kuli:m024-0100","start":100,"end":102,"surface":"田信","kind":"person","person_id":"chz_6r7_teu","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p024","chapter_id":"c-shiji-122-kuli"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-122-kuli:p023","text":"始長史朱買臣，會稽人也。讀春秋。莊助使人言買臣，買臣以楚辭與助倶幸，侍中，爲太中大夫，用事；而湯乃爲小吏，跪伏使買臣等前。已而湯爲廷尉，治淮南獄，排擠莊助，買臣固心望。及湯爲御史大夫，買臣以會稽守爲主爵都尉，列於九卿。數年，坐法廢，守長史，見湯，湯坐床上，丞史遇買臣弗爲禮。買臣楚士，深怨，常欲死之。王朝，齊人也。以術至右内史。邊通，學長短，剛暴彊人也，官再至濟南相。故皆居湯右，已而失官，守長史，詘體於湯。湯數行丞相事，知此三長史素貴，常淩折之。以故三長史合謀曰：「始湯約與君謝，已而賣君；今欲劾君以宗廟事，此欲代君耳。吾知湯陰事。」使吏捕案湯左田信等，曰湯且欲奏請，信輒先知之，居物致富，與湯分之，及他姦事。事辭頗聞。上問湯曰：「吾所爲，賈人輒先知之，益居其物，是類有以吾謀告之者。」湯不謝。湯又詳驚曰：「固宜有。」減宣亦奏謁居等事。天子果以湯懷詐面欺，使使八輩簿責湯。湯具自道無此，不服。於是上使趙禹責湯。禹至，讓湯曰：「君何不知分也。君所治夷滅者幾何人矣？今人言君皆有狀，天子重致君獄，欲令君自爲計，何多以對簿爲？」湯乃爲書謝曰：「湯無尺寸功，起刀筆吏，陛下幸致爲三公，無以塞責。然謀陷湯罪者，三長史也。」遂自殺。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-122-kuli:m023-0003","start":3,"end":6,"surface":"朱買臣","kind":"person","person_id":"gni_7gn_c4a","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m023-0016","start":16,"end":18,"surface":"莊助","kind":"person","person_id":"71j_ydc_ly7","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m023-0021","start":21,"end":23,"surface":"買臣","kind":"person","person_id":"gni_7gn_c4a","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m023-0024","start":24,"end":26,"surface":"買臣","kind":"person","person_id":"gni_7gn_c4a","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m023-0030","start":30,"end":31,"surface":"助","kind":"person","person_id":"71j_ydc_ly7","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m0