_6r7_teu","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p023","chapter_id":"c-shiji-122-kuli"},{"id":"c-shiji-122-kuli:m023-0285","start":285,"end":286,"surface":"信","kind":"person","person_id":"chz_6r7_teu","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p023","chapter_id":"c-shiji-122-kuli"},{"id":"c-shiji-122-kuli:m024-0100","start":100,"end":102,"surface":"田信","kind":"person","person_id":"chz_6r7_teu","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p024","chapter_id":"c-shiji-122-kuli"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-hanshu059-context-11","person_id":"chz_6r7_teu","surfaces":["田信"],"scope":"cross_chapter","chapter_ids":["c-hanshu-059-zhangtang","c-shiji-122-kuli"],"status":"contextual_provisional","confidence_level":"high","identification_basis":{"kind":"source_context","target_mention_ids":["c-hanshu-059-zhangtang:zhangtang:p-death-001:m0116"]},"evidence":[{"work_id":"w-hanshu","book_id":"b-hanshu-059","chapter_id":"c-hanshu-059-zhangtang","source_id":"s-hanshu-059-zhangtang","paragraph_id":"c-hanshu-059-zhangtang:zhangtang:p-death-001","quote":"湯廼為書謝曰湯無尺寸之功起刀筆吏陛下幸致三公無以塞責然謀陷湯者三長史也遂自殺湯死家産直不過五百金皆所得奉賜無它贏昆弟諸子欲厚葬湯湯母曰湯為天子大臣被惡言而死何厚葬為載以牛車有棺而無槨上聞之曰非此母不生此子乃盡按誅三長史丞相青翟自殺出田信上惜湯復稍進其子安世"},{"work_id":"w-shiji","book_id":"b-shiji-122","chapter_id":"c-shiji-122-kuli","source_id":"s-shiji122-kuli","paragraph_id":"c-shiji-122-kuli:p023","quote":"始長史朱買臣，會稽人也。讀春秋。莊助使人言買臣，買臣以楚辭與助倶幸，侍中，爲太中大夫，用事；而湯乃爲小吏，跪伏使買臣等前。已而湯爲廷尉，治淮南獄，排擠莊助，買臣固心望。及湯爲御史大夫，買臣以會稽守爲主爵都尉，列於九卿。數年，坐法廢，守長史，見湯，湯坐床上，丞史遇買臣弗爲禮。買臣楚士，深怨，常欲死之。王朝，齊人也。以術至右内史。邊通，學長短，剛暴彊人也，官再至濟南相。故皆居湯右，已而失官，守長史，詘體於湯。湯數行丞相事，知此三長史素貴，常淩折之。以故三長史合謀曰：「始湯約與君謝，已而賣君；今欲劾君以宗廟事，此欲代君耳。吾知湯陰事。」使吏捕案湯左田信等，曰湯且欲奏請，信輒先知之，居物致富，與湯分之，及他姦事。事辭頗聞。上問湯曰：「吾所爲，賈人輒先知之，益居其物，是類有以吾謀告之者。」湯不謝。湯又詳驚曰：「固宜有。」減宣亦奏謁居等事。天子果以湯懷詐面欺，使使八輩簿責湯。湯具自道無此，不服。於是上使趙禹責湯。禹至，讓湯曰：「君何不知分也。君所治夷滅者幾何人矣？今人言君皆有狀，天子重致君獄，欲令君自爲計，何多以對簿爲？」湯乃爲書謝曰：「湯無尺寸功，起刀筆吏，陛下幸致爲三公，無以塞責。然謀陷湯罪者，三長史也。」遂自殺。"}],"rationale":"張湯死後出田信，與史記同一案件釋放者相接，不與一般同名者合併。","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-hanshu-059-zhangtang:zhangtang:p-death-001","text":"湯廼為書謝曰湯無尺寸之功起刀筆吏陛下幸致三公無以塞責然謀陷湯者三長史也遂自殺湯死家産直不過五百金皆所得奉賜無它贏昆弟諸子欲厚葬湯湯母曰湯為天子大臣被惡言而死何厚葬為載以牛車有棺而無槨上聞之曰非此母不生此子乃盡按誅三長史丞相青翟自殺出田信上惜湯復稍進其子安世","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-hanshu-059-zhangtang:zhangtang:p-death-001:m0000","start":0,"end":1,"surface":"湯","kind":"person","person_id":"1ex_se1_yef_A","status":"contextual_provisional"},{"id":"c-hanshu-059-zhangtang:zhangtang:p-death-001:m0006","start":6,"end":7,"surface":"湯","kind":"person","person_id":"1ex_se1_yef_A","status":"contextual_provisional"},{"id":"c-hanshu-059-zhangtang:zhangtang:p-death-001:m0016","start":16,"end":18,"surface":"陛下","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-hanshu-059-zhangtang:zhangtang:p-death-001:m0029","start":29,"end":30,"surface":"湯","kind":"person","person_id":"1ex_se1_yef_A","status":"contextual_provisional"},{"id":"c-hanshu-059-zhangtang:zhangtang:p-death-001:m0031","start":31,"end":34,"surface":"三長史","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-hanshu-059-zhangtang:zhangtang:p-death-001:m0038","start":38,"end":39,"surface":"湯","kind":"person","person_id":"1ex_se1_yef_A","status":"contextual_provisional"},{"id":"c-hanshu-059-zhangtang:zhangtang:p-death-001:m0056","start":56,"end":60,"surface":"昆弟諸子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-hanshu-059-zhangtang:zhangtang:p-death-001:m0063","start":63,"end":64,"surface":"湯","kind":"person","person_id":"1ex_se1_yef_A","status":"contextual_provisional"},{"id":"c-hanshu-059-zhangtang:zhangtang:p-death-001:m0064","start":64,"end":66,"surface":"湯母","kind":"person","person_id":"5ha_kdu_ux1","status":"contextual_provi