{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003478","identity_policy":"contextual_provisional","person_ids":["cbr-p003478"],"persons":[{"id":"cbr-p003478","label":"趙賁（絳侯周勃世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"趙賁","mention_ids":["c-shiji-057-zhou:m002-0284","c-shiji-057-zhou:m003-0055"]}],"evidence":[{"mention_id":"c-shiji-057-zhou:m002-0284","chapter_id":"c-shiji-057-zhou","paragraph_id":"c-shiji-057-zhou:p002","quote":"趙賁"},{"mention_id":"c-shiji-057-zhou:m003-0055","chapter_id":"c-shiji-057-zhou","paragraph_id":"c-shiji-057-zhou:p003","quote":"趙賁"}]}],"source_mention_summary":[{"source_id":"s-shiji-057-zhou","work_id":"w-shiji","book_id":"b-shiji-057","chapter_id":"c-shiji-057-zhou","mention_count":2,"mention_ids":["c-shiji-057-zhou:m002-0284","c-shiji-057-zhou:m003-0055"],"paragraph_ids":["c-shiji-057-zhou:p002","c-shiji-057-zhou:p003"],"passage_count":2}],"most_mentioned_source_ids":["s-shiji-057-zhou"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-057-zhou:m002-0284","start":284,"end":286,"surface":"趙賁","kind":"person","person_id":"cbr-p003478","status":"contextual_provisional","paragraph_id":"c-shiji-057-zhou:p002","chapter_id":"c-shiji-057-zhou"},{"id":"c-shiji-057-zhou:m003-0055","start":55,"end":57,"surface":"趙賁","kind":"person","person_id":"cbr-p003478","status":"contextual_provisional","paragraph_id":"c-shiji-057-zhou:p003","chapter_id":"c-shiji-057-zhou"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji057-011","person_id":"cbr-p003478","surfaces":["趙賁"],"scope":"same_chapter","chapter_ids":["c-shiji-057-zhou"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-057-zhou:p002","quote":"高祖之為沛公初起，勃以中涓從攻胡陵，下方與。方與反，與戰，卻適。攻豐。擊秦軍碭東。還軍留及蕭。復攻碭，破之。下下邑，先登。賜爵五大夫。攻蒙、虞，取之。擊章邯車騎，殿。定魏地。攻爰戚、東緡，以往至栗，取之。攻齧桑，先登。擊秦軍阿下，破之。追至濮陽，下甄城。攻都關、定陶，襲取宛朐，得單父令。夜襲取臨濟，攻張，以前至卷，破之。擊李由軍雍丘下。攻開封，先至城下為多。後章邯破殺項梁，沛公與項羽引兵東如碭。自初起沛還至碭，一歲二月。楚懷王封沛公號安武侯，為碭郡長。沛公拜勃為虎賁令，以令從沛公定魏地。攻東郡尉於城武，破之。擊王離軍，破之。攻長社，先登。攻潁陽、緱氏，絕河津。擊趙賁軍尸北。南攻南陽守齮，破武關、峣關。破秦軍於藍田，至咸陽，滅秦。"},{"paragraph_id":"c-shiji-057-zhou:p003","quote":"項羽至，以沛公為漢王。漢王賜勃爵為威武侯。從入漢中，拜為將軍。還定三秦，至秦，賜食邑懷德。攻槐裏、好畤，最。擊趙賁、內史保於咸陽，最。北攻漆。擊章平、姚卬軍。西定汧。還下郿、頻陽。圍章邯廢丘。破西丞。擊盜巴軍，破之。攻上邽。東守峣關。轉擊項籍。攻曲逆，最。還守敖倉，追項籍。籍已死，因東定楚地泗（川）［水］、東海郡，凡得二十二縣。還守雒陽、櫟陽，賜與潁（陽）［陰］侯共食鐘離。以將軍從高帝反者燕王臧荼，破之易下。所將卒當馳道為多。賜爵列侯，剖符世世勿絕。食絳八千一百八十戶，號絳侯。"}],"rationale":"按明示姓名、軍事近接、父子承爵與局部皇帝敘事暫接。周勃和勝之的絳侯分開，亞夫條侯與平曲支不混；代地韓信依韓王信近接而不接淮陰侯。未名人物、單名官員不補姓，校勘字不作定本，相術預言不作史實已驗。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-057-zhou:p002","text":"高祖之為沛公初起，勃以中涓從攻胡陵，下方與。方與反，與戰，卻適。攻豐。擊秦軍碭東。還軍留及蕭。復攻碭，破之。下下邑，先登。賜爵五大夫。攻蒙、虞，取之。擊章邯車騎，殿。定魏地。攻爰戚、東緡，以往至栗，取之。攻齧桑，先登。擊秦軍阿下，破之。追至濮陽，下甄城。攻都關、定陶，襲取宛朐，得單父令。夜襲取臨濟，攻張，以前至卷，破之。擊李由軍雍丘下。攻開封，先至城下為多。後章邯破殺項梁，沛公與項羽引兵東如碭。自初起沛還至碭，一歲二月。楚懷王封沛公號安武侯，為碭郡長。沛公拜勃為虎賁令，以令從沛公定魏地。攻東郡尉於城武，破之。擊王離軍，破之。攻長社，先登。攻潁陽、緱氏，絕河津。擊趙賁軍尸北。南攻南陽守齮，破武關、峣關。破秦軍於藍田，至咸陽，滅秦。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-057-zhou:m002-0000","start":0,"end":2,"surface":"高祖","kind":"person","person_id":"cbr-p003471","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0004","start":4,"end":6,"surface":"沛公","kind":"person","person_id":"cbr-p003471","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0009","start":9,"end":10,"surface":"勃","kind":"person","person_id":"cbr-p003468","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0076","start":76,"end":78,"surface":"章邯","kind":"person","person_id":"cbr-p003472","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0140","start":140,"end":143,"surface":"單父令","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者、假設侯嗣、職署或未定回指；不補姓名、親屬成員或爵位所指。"},{"id":"c-shiji-057-zhou:m002-0162","start":162,"end":164,"surface":"李由","kind":"person","person_id":"cbr-p003473","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0181","start":181,"end":183,"surface":"章邯","kind":"person","person_id":"cbr-p003472","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0185","start":185,"end":187,"surface":"項梁","kind":"person","person_id":"cbr-p003474","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0188","start":188,"end":190,"surface":"沛公","kind":"person","person_id":"cbr-p003471","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0191","start":191,"end":193,"surface":"項羽","kind":"person","person_id":"cbr-p003475","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0212","start":212,"end":215,"surface":"楚懷王","kind":"person","person_id":"cbr-p003476","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0216","start":216,"end":218,"surface":"沛公","kind":"person","person_id":"cbr-p003471","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0228","start":228,"end":230,"surface":"沛公","kind":"person","person_id":"cbr-p003471","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0231","start":231,"end":232,"surface":"勃","kind":"person","person_id":"cbr-p003468","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0240","start":240,"end":242,"surface":"沛公","kind":"person","person_id":"cbr-p003471","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0247","start":247,"end":250,"surface":"東郡尉","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者、假設侯嗣、職署或未定回指；不補姓名、親屬成員或爵位所指。"},{"id":"c-shiji-057-zhou:m002-0258","start":258,"end":260,"surface":"王離","kind":"person","person_id":"cbr-p003477","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0284","start":284,"end":286,"surface":"趙賁","kind":"person","person_id":"cbr-p003478","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0292