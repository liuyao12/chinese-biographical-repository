art":34,"end":35,"surface":"鞅","kind":"person","person_id":"cbr-p000429","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p129","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m129-0104","start":104,"end":106,"surface":"趙鞅","kind":"person","person_id":"cbr-p000429","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p129","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m129-0112","start":112,"end":114,"surface":"趙鞅","kind":"person","person_id":"cbr-p000429","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p129","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m130-0018","start":18,"end":20,"surface":"趙鞅","kind":"person","person_id":"cbr-p000429","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p130","chapter_id":"c-shiji-039-jin"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji033-110","person_id":"cbr-p000429","surfaces":["趙簡子"],"scope":"cross_chapter","chapter_ids":["c-shiji-005-qin","c-shiji-033-lu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-005-qin:p045","quote":"惠公元年，孔子行魯相事。五年，晉卿中行、范氏反晉，晉使智氏、趙簡子攻之，范、中行氏亡奔齊。惠公立十年卒，子悼公立。"},{"paragraph_id":"c-shiji-033-lu:p078","quote":"定公立，趙簡子問史墨曰：『季氏亡乎？』史墨對曰：『不亡。季友有大功於魯，受鄪爲上卿，至于文子、武子，世增其業。魯文公卒，東門遂殺適立庶，魯君於是失國政。政在季氏，於今四君矣。民不知君，何以得國！是以爲君慎器與名，不可以假人。』"}],"rationale":"按文公以後立嗣、昭公出奔、夾谷會盟、徵百牢與魯君世系的具體事件及國別暫定異稱，後期同爵稱不與先君混同。身份、匿名指代與數位疑讀待覆核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji037-028","person_id":"cbr-p000429","surfaces":["簡子","趙簡子"],"scope":"cross_chapter","chapter_ids":["c-shiji-005-qin","c-shiji-037-wei"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-005-qin:p045","quote":"惠公元年，孔子行魯相事。五年，晉卿中行、范氏反晉，晉使智氏、趙簡子攻之，范、中行氏亡奔齊。惠公立十年卒，子悼公立。"},{"paragraph_id":"c-shiji-037-wei:p031","quote":"六月乙酉，趙簡子欲入蒯聵，乃令陽虎詐命衞十餘人衰絰歸，簡子送蒯聵。衞人聞之，發兵撃蒯聵。蒯聵不得入，入宿而保，衞人亦罷兵。"},{"paragraph_id":"c-shiji-037-wei:p038","quote":"三年，莊公上城，見戎州。曰：「戎虜何爲是？」戎州病之。十月，戎州告趙簡子，簡子圍衞。十一月，莊公出奔，衞人立公子斑師爲衞君。齊伐衞，虜斑師，更立公子起爲衞君。"}],"rationale":"按本篇明示名與追稱、衛世系及具體事件暫定所列提及同指；每段原文附存，不按同名字面跨篇合併。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji039-079","person_id":"cbr-p000429","surfaces":["趙鞅","趙鞅簡子","鞅"],"scope":"cross_chapter","chapter_ids":["c-shiji-005-qin","c-shiji-039-jin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-005-qin:p045","quote":"惠公元年，孔子行魯相事。五年，晉卿中行、范氏反晉，晉使智氏、趙簡子攻之，范、中行氏亡奔齊。惠公立十年卒，子悼公立。"},{"paragraph_id":"c-shiji-039-jin:p128","quote":"十四年，頃公卒，子定公午立。定公十一年，魯陽虎奔晉，趙鞅簡子捨之。十二年，孔子相魯。"},{"paragraph_id":"c-shiji-039-jin:p129","quote":"十五年，趙鞅使邯鄲大夫午，不信，欲殺午，午與中行寅、范吉射親攻趙鞅，鞅走保晉陽。定公圍晉陽。荀櫟、韓不信、魏侈與范、中行爲仇，乃移兵伐范、中行。范、中行反，晉君撃之，敗范、中行。范、中行走朝歌，保之。韓、魏爲趙鞅謝晉君，乃赦趙鞅，復位。二十二年，晉敗范、中行氏，二子奔齊。"},{"paragraph_id":"c-shiji-039-jin:p130","quote":"三十年，定公與呉王夫差會黃池，爭長，趙鞅時從，卒長呉。"}],"rationale":"按本篇明示名與稱號、晉世系與具體事件暫定所列提及同指；附各段原文，未按同字短名全域合併；紀年與版本差異待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-005-qin:p045","text":"惠公元年，孔子行魯相事。五年，晉卿中行、范氏反晉，晉使智氏、趙簡子攻之，范、中行氏亡奔齊。惠公立十年卒，子悼公立。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m045-0000","start":0,"end":2,"surface":"惠公","kind":"person","person_id":"cbr-p000428","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m045-0005","start":5,"end":7,"surface":"孔子","kind":"person","person_id":"cbr-p000056","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m045-0017","start":17,"end":22,"surface":"中行、范氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或待核指代；不由官稱或熟知世系補造個人。"},{"id":"c-shiji-005-qin:m045-0027","start":27,"end":29,"surface":"智氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或待核指代；不由官稱或熟知世系補造個人。"},{"id":"c-shiji-005-qin:m045-0030","start":30,"end":33,"surface":"趙簡子","kind":"person","person_id":"cbr-p000429","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m045-0036","start":36,"end":41,"surface":"范、中行氏","kind":"unresolved","person_id":null