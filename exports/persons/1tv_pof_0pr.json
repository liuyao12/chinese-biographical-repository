rial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-040-ziliang:p007:m0104","surface":"劉僧瑗","start":104,"end":107,"person_id":"1tv_pof_0pr","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-nanqishu-040-ziliang:p007","chapter_id":"c-nanqishu-040-ziliang"}],"relations":[],"title_holdings":[{"id":"th-nanqi040-ziliang-m7-102","person_id":"1tv_pof_0pr","title":"典籤","kind":"office","mode":"attestation","attestations":[{"id":"th-nanqi040-ziliang-m7-102:a","person_mention_id":"c-nanqishu-040-ziliang:p007:m0104","usage":"narrative","date_expression":null,"paragraph_id":"c-nanqishu-040-ziliang:p007","surface":"典籤","start":102,"end":104}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-040","source_id":"s-nanqishu-040-ziliang-ws2272748","chapter_id":"c-nanqishu-040-ziliang","paragraph_id":"c-nanqishu-040-ziliang:p007","quote":"建元二年，穆妃薨，去官。仍爲征虜將軍、丹陽尹。開私倉賑屬縣貧民。明年，上表曰：「京尹雖居都邑，而境壤兼跨，廣袤周輪，幾將千里。縈原抱隰，其處甚多，舊遏古塘，非唯一所。而民貧業廢，地利久蕪。近啓遣五官殷濔、典籤劉僧瑗到諸縣循履，得丹陽、溧陽、永世等四縣解，并村耆辭列，堪墾之田，合計荒熟有八千五百五十四頃，脩治塘遏，可用十一萬八千餘夫，一春就功，便可成立。」上納之。會遷官，事寢。","person_mention_id":"c-nanqishu-040-ziliang:p007:m0104"}],"status":"source_attested","interpretation_note":"按本見證原職名及其所屬人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-040-ziliang:p007","text":"建元二年，穆妃薨，去官。仍爲征虜將軍、丹陽尹。開私倉賑屬縣貧民。明年，上表曰：「京尹雖居都邑，而境壤兼跨，廣袤周輪，幾將千里。縈原抱隰，其處甚多，舊遏古塘，非唯一所。而民貧業廢，地利久蕪。近啓遣五官殷濔、典籤劉僧瑗到諸縣循履，得丹陽、溧陽、永世等四縣解，并村耆辭列，堪墾之田，合計荒熟有八千五百五十四頃，脩治塘遏，可用十一萬八千餘夫，一春就功，便可成立。」上納之。會遷官，事寢。","mentions":[{"id":"c-nanq