陳之，何也？」儁曰：「副相國，非臣所堪也。遷都非計，臣之所急也。辭所不堪，進臣所急，臣之所宜也。」有司曰：「遷都之事，初無此計也，就有，未露，何所受聞？」儁曰：「相國董卓爲臣説之，臣聞之於相國。」有司不能屈，朝廷稱服焉。後爲太尉。李傕、郭汜相攻，劫質天子公卿，儁性剛，卽發病而卒。","text_layer":"witness_appended_pei_songzhi_note","annotation_status":"reviewed","source_position":{"first_line":17,"last_line":17,"raw_start":2348,"raw_end":3017,"raw_character_offsets":[2363,2364,2365,2368,2369,2370,2384,2387,2401,2402,2405,2419,2420,2423,2424,2425,2426,2427,2428,2429,2430,2431,2432,2433,2434,2435,2436,2437,2438,2439,2440,2441,2455,2458,2459,2460,2461,2462,2463,2464,2465,2466,2467,2468,2469,2470,2471,2485,2486,2489,2490,2504,2505,2508,2522,2525,2526,2527,2528,2529,2530,2531,2532,2533,2534,2535,2549,2552,2553,2554,2555,2556,2570,2573,2574,2575,2576,2590,2593,2594,2595,2596,2610,2613,2614,2628,2631,2645,2648,2649,2663,2666,2667,2668,2669,2670,2671,2672,2673,2674,2675,2676,2679,2682,2683,2684,2685,2699,2702,2703,2704,2705,2706,2707,2708,2709,2710,2711,2712,2713,2714,2715,2716,2717,2718,2719,2720,2721,2722,2723,2724,2725,2739,2742,2743,2744,2745,2746,2747,2748,2749,2750,2751,2752,2753,2754,2755,2756,2757,2758,2759,2760,2761,2762,2763,2764,2765,2766,2767,2768,2769,2770,2771,2772,2773,2774,2775,2776,2777,2778,2779,2780,2781,2795,2798,2799,2800,2801,2802,2803,2804,2805,2806,2807,2808,2809,2810,2811,2812,2813,2814,2815,2816,2817,2818,2819,2820,2821,2822,2823,2824,2825,2826,2827,2828,2829,2830,2831,2832,2833,2834,2835,2836,2837,2838,2839,2840,2841,2842,2843,2844,2845,2846,2847,2848,2849,2850,2851,2852,2853,2854,2855,2856,2857,2858,2859,2860,2861,2862,2863,2864,2865,2866,2880,2883,2884,2885,2886,2887,2901,2902,2905,2906,2907,2908,2909,2910,2911,2912,2915,2918,2919,2920,2921,2922,2923,2924,2925,2926,2927,2928,2929,2930,2931,2932,2933,2936,2939,2940,2941,2942,2956,2957,2960,2974,2975,2978,2979,2980,2981,2982,2983,2984,2985,2986,2987,3001,3004,3005,3006,3009,3012,3013,3014,3015,3016],"revision_id":2629010},"mentions":[{"id":"c-sanguozhi-046-sun-jian:p009:m0006","surface":"儁","start":6,"end":7,"kind":"person","person_id":"