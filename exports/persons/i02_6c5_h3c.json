status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本句所載職官，任免時間未詳。","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-053","chapter_id":"c-sanguozhi-053-zhanghong","source_id":"s-sanguozhi-053-zhanghong","paragraph_id":"c-sanguozhi-053-zhanghong:line012-pei02-01","quote":"吳書曰：大將軍何進、太尉硃俊、司空荀爽三府辟為掾，皆稱疾不就。","person_mention_id":"c-sanguozhi-053-zhanghong:line012-pei02-01:m0012"}],"attestations":[{"id":"t-wu053-t-wu053-zhanghong3:a","paragraph_id":"c-sanguozhi-053-zhanghong:line012-pei02-01","person_mention_id":"c-sanguozhi-053-zhanghong:line012-pei02-01:m0012","start":10,"end":12,"surface":"太尉","usage":"narrative","date_expression":null}],"human_reviewed":false,"reviewer":"Codex（AI 代理）","model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-046-sun-jian:p006","text":"　　中平元年，黃巾賊師張角起於魏郡。託有神靈，遣八使以善道教化天下，而潛相連結，自稱黃天泰平。三月甲子，三十六（萬）一旦俱發，天下響應，燔燒郡縣，殺害長吏。漢朝遣車騎將軍皇甫崧、中郎將朱儁將兵討擊之。儁表請堅爲佐軍司馬，鄕里少年隨在下邳者皆願從。堅又募諸商旅及淮泗精兵，合千許人，與儁並力奮擊，所向無前。汝穎賊困迫，走保宛城。堅身當一面，登城先入，衆乃蟻附，遂大破之。儁具以狀聞上，拜堅別部司馬。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":17,"last_line":17,"raw_start":1381,"raw_end":3019,"raw_character_offsets":[1381,1382,1388,1389,1390,1391,1394,1403,1404,1405,1408,1429,1430,1435,1438,1461,1462,1467,1470,1473,1474,1475,1476,1477,1478,1479,1480,1481,1482,1483,1484,1485,1486,1487,1488,1489,1490,1491,1492,1493,1494,1495,1509,1510,1511,1512,1515,1516,1517,1518,1519,1520,1521,1522,1523,1524,1525,1526,1527,1528,1529,1530,1531,1532,1533,1534,1535,1536,1537,1538,1539,1540,1541,1542,1543,1544,1545,1546,1695,1698,1699,1700,1701,1702,1703,1725,1726,1729,1736,1737,1738,1739,1760,1761,1766,1767,1768,1769,1770,1771,1785,1788,1789,1803,1806,1807,1808,1809,1810,1811,1812,1815,1818,1819,1820,1821,1835,1836,1839,1840,1841,1842,1843,1857,1860,1861,1862,1