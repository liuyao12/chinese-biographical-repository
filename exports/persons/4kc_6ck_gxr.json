ource_reading_cases":[{"id":"c-nanqishu-059-western-polities-complete:source_review16-0","kind":"source_review","person_id":"4kc_6ck_gxr","source_quote":"氐楊氏，與苻氐同出略陽，漢世居仇池，地號百頃。建安中，有百頃氐王是也。晉世有楊茂𤟫，後轉彊盛，事見前史。仇池四方壁立，自然有樓櫓卻敵狀，高竝數丈。有二十二道可攀緣而升，東西二門，盤道可七里。上有岡阜泉源。氐於上平地立宮室菓園倉庫，無貴賤皆為板屋土牆，所治處名洛谷。","reading":"仇池氐楊與略陽、百頃、楊茂𤟫及地勢、地名照見證。","note":"仇池氐楊與略陽、百頃、楊茂𤟫及地勢、地名照見證。","paragraph_id":"c-nanqishu-059-western-polities-complete:p016","start_codepoint":0,"end_codepoint":132,"human_reviewed":false,"chapter_id":"c-nanqishu-059-western-polities-complete","source_id":"s-nanqishu-059-western-polities-complete-ws1748911"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-059-western-polities-complete:p016:m0038","start":38,"end":41,"surface":"楊茂𤟫","kind":"person","person_id":"4kc_6ck_gxr","status":"contextual_provisional","paragraph_id":"c-nanqishu-059-western-polities-complete:p016","chapter_id":"c-nanqishu-059-western-polities-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-059-western-polities-complete:p016","text":"氐楊氏，與苻氐同出略陽，漢世居仇池，地號百頃。建安中，有百頃氐王是也。晉世有楊茂𤟫，後轉彊盛，事見前史。仇池四方壁立，自然有樓櫓卻敵狀，高竝數丈。有二十二道可攀緣而升，東西二門，盤道可七里。上有岡阜泉源。氐於上平地立宮室菓園倉庫，無貴賤皆為板屋土牆，所治處名洛谷。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":43,"last_line":43,"raw_start":2603,"raw_end":2735,"raw_character_offsets":[2603,2604,2605,2606,2607,2608,2609,2610,2611,2612,2613,2614,2615,2616,2617,2618,2619,2620,2621,2622,2623,2624,2625,2626,2627,2628,2629,2630,2631,2632,2633,2634,2635,2636,2637,2638,2639,2640,2641,2642,2643,2644,2645,2646,2647,2648,2