k_id":"b-shiji-100","work_id":"w-shiji","source_id":"s-shiji-100-jibu"},{"id":"c-shiji-124-youxia:p005","text":"古布衣之俠，靡得而聞已。近世延陵、孟嘗、春申、平原、信陵之徒，皆因王者親屬，藉於有土卿相之富厚，招天下賢者，顯名諸侯，不可謂不賢者矣。比如順風而呼，聲非加疾，其埶激也。至如閭巷之俠，脩行砥名，聲施於天下，莫不稱賢，是為難耳。然儒、墨皆排擯不載。自秦以前，匹夫之俠，湮滅不見，余甚恨之。以余所聞，漢興有朱家、田仲、王公、劇孟、郭解之徒，雖時扞當世之文罔，然其私義廉絜退讓，有足稱者。名不虛立，士不虛附。至如朋黨宗彊比周，設財役貧，豪暴侵淩孤弱，恣欲自快，游俠亦醜之。余悲世俗不察其意，而猥以朱家、郭解等令與暴豪之徒同類而共笑之也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-124-youxia:m005-0014","start":14,"end":16,"surface":"延陵","kind":"person","person_id":"5dm_e40_rqh_AAAAAAAAAAAAAAAAAAD","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m005-0017","start":17,"end":19,"surface":"孟嘗","kind":"person","person_id":"7pl_s0g_rkh","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m005-0020","start":20,"end":22,"surface":"春申","kind":"person","person_id":"e79_ty0_mkx","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m005-0023","start":23,"end":25,"surface":"平原","kind":"person","person_id":"03v_bhv_img","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m005-0026","start":26,"end":28,"surface":"信陵","kind":"person","person_id":"h8u_hld_5su","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m005-0113","start":113,"end":116,"surface":"儒、墨","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-124-youxia:m005-0150","start":150,"end":152,"surface":"朱家","kind":"person","person_id":"766_5dq_zws","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m005-0153","start":153,"end":155,"surface":"田仲","kind":"person","person_id":"qg3_81p_5ti","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m005-0156","start":156,"end":158,"surface":"王公","kind":"person","person_id":"t00_u9v_yvd","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m005-0159","start":159,"end":161,"surface":"劇孟","kind":"person","person_id":"5se_9f5_u2q","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m005-0162","start":162,"end":164,"surface":"郭解","kind":"person","person_id":"5if_pf6_zos_A","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m005-0244","start":244,"end":246,"surface":"朱家","kind":"person","person_id":"766_5dq_zws","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m005-0247","start":247,"end":249,"surface":"郭解","kind":"person","person_id":"5if_pf6_zos_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-124-youxia","book_id":"b-shiji-124","work_id":"w-shiji","source_id":"s-shiji124-youxia"},{"id":"c-shiji-124-youxia:p006","text":"魯朱家者，與高祖同時。魯人皆以儒教，而朱家用俠聞。所藏活豪士以百數，其餘庸人不可勝言。然終不伐其能，歆其德，諸所嘗施，唯恐見之。振人不贍，先從貧賤始。家無餘財，衣不完采，食不重味，乘不過軥牛。專趨人之急，甚己之私。既陰脫季布將軍之阸，及布尊貴，終身不見也。自關以東，莫不延頸願交焉。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-124-youxia:m006-0001","start":1,"end":3,"surface":"朱家","kind":"person","person_id":"766_5dq_zws","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m006-0006","start":6,"end":8,"surface":"高祖","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m006-0019","start":19,"end":21,"surface":"朱家","kind":"person","person_id":"766_5dq_zws","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m006-0110","start":110,"end":112,"surface":"季布","kind":"person","person_id":"udu_dyy_4wd","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m006-0118","start":118,"end":119,"surface":"布","kind":"person","person_id":"udu_dyy_4wd","status":"contextual_provisional"}],"chapter_id":"c-shiji-124-youxia","book_id":"b-shiji-124","work_id":"w-shiji","source_id":"s-shiji124-youxia"},{"id":"c-shiji-124-youxia:p007","text":"楚田仲以俠聞，喜劍，父事朱家，自以為行弗及。田仲已死，而雒陽有劇孟。周人以商賈為資，而劇孟以任俠顯諸侯。吳楚反時，條侯為太尉，乘傳車將至河南，得劇孟，喜曰：「吳楚舉大事而不求孟，吾知其無能為已矣。」天下騷動，宰相得之若得一敵國云。劇孟行大類朱家，而好博，多少年之戲。然劇孟母死，自遠方送喪蓋千乘。及劇孟死，家無餘十金之財。而符離人王孟亦以俠稱江淮之間。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-124-youxia:m007-0001","start":1,"end":3,"surface":"田仲","kind":"person","person_id":"qg3_81p_5ti","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m007-0012","start":12,"end":14,"surface":"朱家","kind":"person","person_id":"766_5dq_zws","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m007-0022","start":22,"end":24,"surface":"田仲","kind":"person","person_id":"qg3_81p_5ti","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m007-0031","start":31,"end":33,"surface":"劇孟","kind":"person","person_id":"5se_9f5_u2q","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m007-0043","start":43,"end":45,"surface":"劇孟","kind":"person","person_id":"5se_9f5_u2q","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m007-0057","start":57,"end":59,"surface":"條侯","kind":"person","person_id":"koy_6jg_gcc_C","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m007-0072","start":72,"end":74,"surface":"劇孟","kind":"person","person_id":"5se_9f5_u2q","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m007-0087","start":87,"end":88,"surface":"孟","kind":"person","person_id":"5se_9f5_u2q","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m007-0115","start":115,"end":117,"surface":"劇孟","kind":"person","person_id":"5se_9f5_u2q","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m007-0120","start":120,"end":122,"surface":"朱家","kind":"person","person_id":"766_5dq_zws","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m007-0134","start":134,"end":137,"surface":"劇孟母","kind":"person","person_id":"qel_t1a_itz","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m007-0149","start":149,"end":151,"surface":"劇孟","kind":"person","person_id":"5se_9f5_u2q","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m007-0165","start":165,"end":167,"surface":"王孟","kind":"person","person_id":"06k_nhd_cnj","status":"contextual_provisional"}],"chapter_id":"c-shiji-124-youxia","book_id":"b-shiji-124","work_id":"w-shiji","source_id":"s-shiji124-youxia"},{"id":"c-shiji-124-youxia:p015","text":"自是之後，為俠者極眾，敖而無足數者。然關中長安樊仲子，槐裏趙王孫，長陵高公子，西河郭公仲，太原鹵公孺，臨淮兒長卿，東陽田君孺，雖為俠而逡逡有退讓君子之風。至若北道姚氏，西道諸杜，南道仇景，東道趙他、羽公子，南陽趙調之徒，此盜跖居民間者耳，曷足道哉！此乃鄉者朱家之羞也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-124-youxia:m015-0023","start":23,"end":26,"surface":"樊仲子","kind":"person","person_id":"m0p_dd3_54x","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m015-0029","start":29,"end":32,"surface":"趙王孫","kind":"person","person_id":"zt8_dt2_n3j","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m015-0035","start":35,"end":38,"surface":"高公子","kind":"person","person_id":"sng_yg9_3qc","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m015-0041","start":41,"end":44,"surface":"郭公仲","kind":"person","person_id":"jpu_12d_8pa","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m015-0047","start":47,"end":50,"surface":"鹵公孺","kind":"person","person_id":"ew3_ltd_qbv","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m015-0053","start":53,"end":56,"surface":"兒長卿","kind":"person","person_id":"wzh_fbx_a70","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m015-0059","start":59,"end":62,"surface":"田君孺","kind":"person","person_id":"j5o_q26_hwv","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m015-0081","start":81,"end":83,"surface":"姚氏","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-124-youxia:m015-0086","start":86,"end":88,"surface":"諸杜","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-124-youxia:m015-0091","start":91,"end":93,"surface":"仇景","kind":"person","person_id":"w95_we2_wu2","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m015-0096","start":96,"end":98,"surface":"趙他","kind":"person","person_id":"k66_l92_10i","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m015-0099","start":99,"end":102,"surface":"羽公子","kind":"person","person_id":"k66_l92_10i","status":"conte