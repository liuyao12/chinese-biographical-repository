{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004448","canonical_person_id":"tdk_stf_mcl","id_aliases":["cbr-p004448"],"identity_policy":"contextual_provisional","person_ids":["tdk_stf_mcl"],"persons":[{"id":"tdk_stf_mcl","label":"越王引古未名（春申君列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"越王","mention_ids":["c-shiji-078-chunshen:m003-0197"]}],"evidence":[{"mention_id":"c-shiji-078-chunshen:m003-0197","chapter_id":"c-shiji-078-chunshen","paragraph_id":"c-shiji-078-chunshen:p003","quote":"越王"}],"id_aliases":["cbr-p004448"]}],"source_mention_summary":[{"source_id":"s-shiji-078-chunshen","work_id":"w-shiji","book_id":"b-shiji-078","chapter_id":"c-shiji-078-chunshen","mention_count":1,"mention_ids":["c-shiji-078-chunshen:m003-0197"],"paragraph_ids":["c-shiji-078-chunshen:p003"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-078-chunshen"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-078-chunshen:m003-0197","start":197,"end":199,"surface":"越王","kind":"person","person_id":"tdk_stf_mcl","status":"contextual_provisional","paragraph_id":"c-shiji-078-chunshen:p003","chapter_id":"c-shiji-078-chunshen"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji078-010","person_id":"tdk_stf_mcl","surfaces":["越王"],"scope":"same_chapter","chapter_ids":["c-shiji-078-chunshen"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-078-chunshen:p003","quote":"王若能持功守威，絀攻取之心而肥仁義之地，使無後患，三王不足四，五伯不足六也。王若負人徒之眾，仗兵革之彊，乘毀魏之威，而欲以力臣天下之主，臣恐其有後患也。《詩》曰「靡不有初，鮮克有終」。《易》曰「狐涉水，濡其尾」。此言始之易，終之難也。何以知其然也？昔智氏見伐趙之利而不知榆次之禍，吳見伐齊之便而不知干隧之敗。此二國者，非無大功也，沒利於前而易患於後也。吳之信越也，從而伐齊，既勝齊人於艾陵，還為越王禽三渚之浦。智氏之信韓、魏也，從而伐趙，攻晉陽城，勝有日矣，韓、魏叛之，殺智伯瑤於鑿臺之下。今王妒楚之不毀也，而忘毀楚之彊韓、魏也，臣為王慮而不取也。"}],"rationale":"按全22段明示姓名與局部敘事暫接。太子完考烈王、李園女弟與所生太子楚幽王按明示敘事分存，血緣不當已核定史實。更立君後的君未解，實楚王評論指春申權勢，王長反政與君子為王只作假設；未把方案當實授。秦楚齊王稱分範圍，先君善秦未強接頃襄；朱英郎中未行，伊尹周公引古不補未見身份。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-078-chunshen:p003","text":"王若能持功守威，絀攻取之心而肥仁義之地，使無後患，三王不足四，五伯不足六也。王若負人徒之眾，仗兵革之彊，乘毀魏之威，而欲以力臣天下之主，臣恐其有後患也。《詩》曰「靡不有初，鮮克有終」。《易》曰「狐涉水，濡其尾」。此言始之易，終之難也。何以知其然也？昔智氏見伐趙之利而不知榆次之禍，吳見伐齊之便而不知干隧之敗。此二國者，非無大功也，沒利於前而易患於後也。吳之信越也，從而伐齊，既勝齊人於艾陵，還為越王禽三渚之浦。智氏之信韓、魏也，從而伐趙，攻晉陽城，勝有日矣，韓、魏叛之，殺智伯瑤於鑿臺之下。今王妒楚之不毀也，而忘毀楚之彊韓、魏也，臣為王慮而不取也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-078-chunshen:m003-0000","start":0,"end":1,"surface":"王","kind":"person","person_id":"kd7_n5o_quo","status":"contextual_provisional"},{"id":"c-shiji-078-chunshen:m003-0026","start":26,"end":27,"surface":"王","kind":"person","person_id":"kd7_n5o_quo","status":"contextual_provisional"},{"id":"c-shiji-078-chunshen:m003-0031","start":31,"end":33,"surface":"五伯","kind":"unresolved","person_id":null,"status":"unresolved","note":"引古群體、氏族、國稱或未定指代；智氏不整批當智伯瑤，三王五伯不補成員，文王莊王未由記憶補國別姓名。"},{"id":"c-shiji-078-chunshen:m003-0038","start":38,"end":39,"surface":"王","kind":"person","person_id":"kd7_n5o_quo","status":"contextual_provisional"},{"id":"c-shiji-078-chunshen:m003-0062","start":62,"end":63,"surface":"臣","kind":"person","person_id":"zun_s94_rgs","status":"contextual_provisional"},{"id":"c-shiji-078-chunshen:m003-0063","start":63,"end":67,"surface":"天下之主","kind":"unresolved","person_id":null,"status":"unresolved","note":"引古群體、氏族、國稱或未定指代；智氏不整批當智伯瑤，三王五伯不補成員，文王莊王未由記憶補國別姓名。"},{"id":"c-shiji-078-chunshen:m003-0068","start":68,"end":69,"surface":"臣","kind"