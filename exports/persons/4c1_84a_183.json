":"person","person_id":"ugw_szo_u9e","status":"contextual_provisional"},{"id":"c-nanqishu-046-xiaohuiji-complete:p006:m0253","start":253,"end":258,"surface":"竟陵王子良","kind":"person","person_id":"x3q_cqm_dup","status":"contextual_provisional"},{"id":"c-nanqishu-046-xiaohuiji-complete:p006:m0259","start":259,"end":261,"surface":"惠基","kind":"person","person_id":"ph1_ms8_hyq_ABAA","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-046-xiaohuiji-complete","book_id":"b-nanqishu-046","work_id":"w-nanqishu","source_id":"s-nanqishu-046-xiaohuiji-complete-ws1511897"},{"id":"c-nanshi-022-wangtanshou-wyd:p003","text":"元嘉四年車駕出北堂使三更竟開廣莫門南臺云應須白獸幡銀字棨不肯開尚書左丞羊𤣥保奏免御史中丞傅隆旨下曇首曰旣無異敕又闕幡棨雖稱上旨不異單刺元嘉元年二年雖有再開門例此乃前事之違今之守舊未爲非禮其不請白獸幡銀字棨致開門不時由尚書相承之失亦合糾正上特無問更立科條遷太子詹事侍中如故","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-nanshi-022-wangtanshou-wyd:p003:m0035","start":35,"end":38,"surface":"羊𤣥保","person_id":"4c1_84a_183","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作羊玄保。"},{"id":"c-nanshi-022-wangtanshou-wyd:p003:m0044","start":44,"end":46,"surface":"傅隆","person_id":"c1d_31f_070","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作傅隆。"},{"id":"c-nanshi-022-wangtanshou-wyd:p003:m0048","start":48,"end":50,"surface":"曇首","person_id":"7r6_k52_qji_ABAAAAE","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作王曇首。"}],"source_position":{"revision_id":"cbr-ai-transcription-sha256:e230275bc589cf0c3e2f9aea984d7dbf5508b56aee6f973e8c91095ece6481d6","source_layer":"received_chapter","column_projection":[{"column":"63L1","start":17,"end":21,"text":"元嘉四年"},{"column":"63L2","start":0,"end":21,"text":"車駕出北堂使三更竟開廣莫門南臺云應須白獸幡"},{"column":"63L3","start":0,"end":21,"text":"銀字棨不肯開尚書左丞羊𤣥保奏免御史中丞傅隆"},{"column":"63L4","start":0,"end":21,"text":"旨下曇首曰旣無異敕又闕幡棨雖稱上旨不異單刺"},{"column":"63L5","start":0,"end":21,"text":"元嘉元年二年雖有再開門例此乃前事之違今之守"},{"column":"63L6","start":0,"end":21,"text":"舊未爲非禮其不請白獸幡銀字棨致開門不時由尚"},{"column":"63L7","start":0,"end":21,"text":"書相承之失亦合糾正上特無問更立科條遷太子詹"},{"column":"63L8","start":0,"end":5,"text":"事侍中如故"}]},"chapter_id":"c-nanshi-022-wangtanshou-wyd","book_id":"b-nanshi-022","work_id":"w-nanshi","source_id":"s-nanshi-022-wangtanshou-wyd1739"},{"id":"c-nanshi-022-wangtanshou:p002","text":"元嘉四年，車駕出北堂，使三更竟，開廣莫門。南台雲，「應須白獸幡、銀字檀」。不肯開。尚書左丞羊玄保奏免御史中丞傅隆以下。曇首曰：「既無墨敕，又闕幡檀，雖稱上旨，不異單刺。元嘉元年、二年，雖有再開門例，此乃前事之違。今之守舊，未為非禮。其不請白獸幡、銀字檀，致開門不時，由尚書相承之失，亦合糾正。」上特無問，更立科條。遷太子詹事，侍中如故。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"start":45,"end":48,"surface":"羊玄保","id":"c-nanshi-022-wangtanshou:p002:m0045","person_id":"4c1_84a_183","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作羊玄保。"},{"start":54,"end":56,"surface":"傅隆","id":"c-nanshi-022-wangtanshou:p002:m0054","person_id":"c1d_31f_070","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作傅隆。"},{"start":59,"end":61,"surface":"曇首","id":"c-nanshi-022-wangtanshou:p002:m0059","person_id":"7r6_k52_qji_ABAAAAE","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作王曇首。"}],"source_position":{"revision_id":1477957,"source_layer":"received_biography","raw_start":379,"raw_end":547,"raw_character_offsets":[379,380,381,382,383,384,385,386,387,388,389,390,391,392,393,394,395,396,397,398,399,400,401,402,403,404,405,406,407,408,409,410,411,412,413,414,415,416,417,418,419,420,421,422,423,424,425,426,427,428,429,430,431,432,433,434,435,436,437,438,439,440,441,442,443,444,445,446,447,448,449,450,451,452,453,454,455,456,457,458,459,460,461,462,463,464,465,466,467,468,469,470,471,472,473,474,475,476,477,478,479,480,481,482,483,484,485,486,487,488,489,490,491,492,493,494,495,496,497,498,499,500,501,502,503,504,505,506,507,508,509,510,511,512,513,514,515,516,517,518,519,520,521,522,523,524,525,526,527,528,529,530,531,532,533,534,535,536,537,538,539,540,541,542,543,544,545,546],"projection_sha256":"327cf75a4789c6d1b24915bc19f68a5bc53a37aaaa24195f7d98095cad684240","first_line":8,"last_line":8,"editorial_excerpt_boundary":true},"chapter_id":"c-nanshi-022-wangtanshou","book_id":"b-nanshi-022","work_id":"w-nanshi","source_id":"s-nanshi-022-wangtanshou-ws1477957"},{"id":"c-songshu-063-wanghua-tanshou:line035","text":"元嘉四年，車駕出北堂，嘗使三更竟開廣莫門，南臺云：「應須白虎幡，銀字棨。」不肯開門。尚書左丞羊玄保奏免御史中丞傅隆以下，曇首繼啟曰：「既無墨敕，又闕幡棨，雖稱上旨，不異單刺。元嘉元年、二年，雖有再開門例，此乃前事之違。今之守舊，未為非禮。但既據舊史，應有疑却本末，曾無此狀，猶宜反咎其不請白虎幡、銀字棨，致門不時開，由尚書相承之失，亦合糾正。」上特無所問，更立科條。遷太子詹事，侍中如故。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-songshu-063-wanghua-tanshou:line035:m0005","start":5,"end":7,"surface":"車駕","kind":"person","person_id":"3bh_k4m_fg4","status":"contextual_provisional"},{"id":"c-songshu-063-wanghua-tanshou:line035:m0046","start":46,"end":49,"surface":"羊玄保","kind":"person","person_id":"4c1_84a_183","status":"contextual_provisional"},{"id":"c-songshu-063-wanghua-tanshou:line035:m0051","start":51,"end":55,"surface":"御史中丞","kind":"person","person_id":"c1d_31f_070","status":"contextual_provisional"},{"id":"c-songshu-063-wanghua-tanshou:line035:m0055","start":55,"end":57,"surface":"傅隆","kind":"person","person_id":"c1d_31f_070","status":"contextual_provisional"},{"id":"c-songshu-063-wanghua-tanshou:line035:m0060","start":60,"end":62,"surface":"曇首","kind":"person","person_id":"7r6_k52_qji_ABAAAAE","status":"contextual_provisional"},{"id":"c-songshu-063-wanghua-tanshou:line035:m0079","start":79,"end":80,"surface":"上","kind":"person","person_id":"3bh_k4m_fg4","status":"contextual_provisional"},{"id":"c-songshu-063-wanghua-tanshou:line035:m0172","start":172,"end":173,"surface":"上","kind":"person","person_id":"3bh_k4m_fg4","status":"contextual_provisional"}],"source_position":{"first_line":35,"last_line":35,"revision_id":2118589,"editorial_excerpt_boundary":false},"chapter_id":"c-songshu-063-wanghua-tanshou","book_id":"b-songshu-063","work_id":"w-songshu","source_id":"s-songshu-063-wanghua-tanshou"},{"id":"c-songshu-063-wangtanshou-wyd:p004","text":"元嘉四年車駕出北堂嘗使三更竟開廣莫門南臺云應須白虎幡銀字棨不肯開門尚書左丞羊玄保奏免御史中丞傅隆以下曇首繼啓曰旣無墨敕又闕幡棨雖稱上旨不異單刺元嘉二年雖有再開門例此乃前事之違今之守舊未爲非禮但旣據舊使應有疑却本末曾無此狀猶宜厥咎其不請白虎幡銀字棨致門不時開由尚書相承之失亦合糾正上特無所問更立科條遷太子詹事侍中如故","mentions":[{"id":"c-songshu-063-wangtanshou-wyd:p004:m0037","surface":"羊玄保","start":37,"end":40,"person_id":"4c1_84a_183","kind":"person","status":"contextual_provisional","interpretation_note":"按刊本原字及同傳敘事。"},{"id":"c-songshu-063-wangtanshou-wyd:p004:m0046","surface":"傅隆","start":46,"end":48,"person_id":"c1d_31f_070","kind":"person","status":"contextual_provisional","interpretation_note":"按刊本原字及同傳敘事。"},{"id":"c-songshu-063-wangtanshou-wyd:p004:m0050","surface":"曇首","start":50,"end":52,"person_id":"7r6_k52_qji_ABAAAAE","kind":"person","status":"contextual_provisional","interpretation_note":"按刊本原字及同傳敘事。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":"cbr-ai-transcription-sha256:a3ae53ead4a5ba2ebf8aa47e120cc69353f39fd44f82d0cd41d25b5d91fcb275","source_layer":"received_biography","column_projection":[{"column":"19L10","start":17,"end":21,"text":"元嘉四年"},{"column":"20R01","start":0,"end":21,"text":"車駕出北堂嘗使三更竟開廣莫門南臺云應須白虎"},{"column":"20R02","start":0,"end":21,"text":"幡銀字棨不肯開門尚書左丞羊玄保奏免御史中丞"},{"column":"20R03","start":0,"end":21,"text":"傅隆以下曇首繼啓曰旣無墨敕又闕幡棨雖稱上旨"},{"column":"20R04","start":0,"end":21,"text":"不異單刺元嘉二年雖有再開門例此乃前事之違今"},{"column":"20R05","start":0,"end":21,"text":"之守舊未爲非禮但旣據舊使應有疑却本末曾無此"},{"column":"20R06","start":0,"end":21,"text":"狀猶宜厥咎其不請白虎幡銀字棨致門不時開由尚"},{"column":"20R07","start":0,"end":21,"text":"書相承之失亦合糾正上特無所問更立科條遷太子"},{"column":"20R08","start":0,"end":6,"text":"詹事侍中如故"}]},"chapter_id":"c-songshu-063-wangtanshou-wyd","book_id":"b-songshu-063","work_id":"w-songshu","source_id":"s-songshu-063-wangtanshou-wyd1739"}],"sources":[{"chapter_id":"c-nanqishu-046-xiaohuiji-complete","work_id":"w-nanqishu","book_id":"b-nanqishu-046","source_id":"s-nanqishu-046-xiaohuiji-complete-ws1511897","source":{"title":"南齊書卷四十六·蕭惠基、弈棊附敘、惠休與惠朗","provider":"Wikisource","permalink":"https://zh.wikisource.org/w/index.php?oldid=1511897","url":"https://zh.wikisource.org/w/index.php?oldid=1511897","revision_id":1511897,"edition":"維基文庫固定修訂","accessed_on":"2026-11-21","review_status":"text_checked","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫授權。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","extent":"南齊書卷四十六·蕭惠基、弈棊附敘、惠休與惠朗","text_scope":"complete_biography_unit","raw_path":"sources/nanqishu/nanqishu046-ws1511897.wikitext","raw_file_sha256":"d109243a343e069b8ce98cb0607567b69305574aa59ecc8776b9ea70ca0fd537","collation_witnesses":["source-evidence/nanqi046-roll/xiao-reading.json"]}},{"chapter_id":"c-nanshi-022-wangtanshou","work_id":"w-nanshi","book_id":"b-nanshi-022","source_id":"s-nanshi-022-wangtanshou-ws1477957","source":{"title":"南史卷二十二·王曇首傳","provider":"Wikisource","url":"https://zh.wikisource.org/wiki/南史/卷22","permalink":"https://zh.wikisource.org/w/index.php?title=南史/卷22&oldid=1477957","revision_id":1477957,"accessed_on":"2026-11-20","edition":"固定數位本；乾隆四年武英殿本另在逐段校核附表。","extent":"逐讀第4行分題至第16行分題前。","text_scope":"partial_chapter","image_verified":false,"review_status":"text_checked","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","rights":"古代正文及維基文庫數位轉錄，保留見證歸屬。","section_locator":"==王曇首==","raw_path":"sources/nanshi/nanshi022-ws1477957.wikitext","raw_file_sha256":"1fba4fa3cd43161db40d91f7330cd6cf685052cfaadb90d0a90869fd5ef3fa94","normalization":{"character_conversion":{},"verified_blank_line_gaps":[{"source_lines":[5,5],"raw_quote":"","raw_quote_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","revision_id":1477957},{"source_lines":[7,7],"raw_quote":"","raw_quote_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","revision_id":1477957},{"source_lines":[9,9],"raw_quote":"","raw_quote_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","revision_id":1477957},{"source_lines":[11,11],"raw_quote":"","raw_quote_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","revision_id":1477957},{"source_lines":[13,13],"raw_quote":"","raw_quote_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","revision_id":1477957},{"source_lines":[15,15],"raw_quote":"","raw_quote_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","revision_id":1477957}]},"response_sha256":"a9329eb7f1262a2ab6b59da77efbd73f4f7edd0beeb5fb6c4694eb9e28ffa1c2","wikitext_sha256":"1fba4fa3cd43161db40d91f7330cd6cf685052cfaadb90d0a90869fd5ef3fa94"}},{"chapter_id":"c-nanshi-022-wangtanshou-wyd","work_id":"w-nanshi","book_id":"b-nanshi-022","source_id":"s-nanshi-022-wangtanshou-wyd1739","source":{"title":"武英殿本《南史》卷二十二","provider":"中國國家圖書館館藏，Wikimedia Commons書影","url":"https://commons.wikimedia.org/wiki/File:NLC892-411999017142-12360_二十四史_第246冊.pdf","permalink":"https://commons.wikimedia.org/wiki/File:NLC892-411999017142-12360_二十四史_第246冊.pdf","revision_id":"cbr-ai-transcription-sha256:e230275bc589cf0c3e2f9aea984d7dbf5508b56aee6f973e8c91095ece6481d6","raw_path":"source-evidence/nanshi022-wang/wyd-columns.txt","raw_file_sha256":"e230275bc589cf0c3e2f9aea984d7dbf5508b56aee6f973e8c91095ece6481d6","accessed_on":"2026-11-20","text_scope":"complete_biography_unit","extent":"乾隆四年武英殿校刊本卷二十二列傳第十二。第246冊第62至66面，分傳主及隨傳小題。","review_status":"AI_image_transcription_draft","image_verified":true,"edition":"清乾隆四年（1739）武英殿校刊《二十四史》，國圖館藏第246冊。","rights":"古籍原文與自行核讀轉寫；影像連回館藏網址。","license_url":"https://commons.wikimedia.org/wiki/File:NLC892-411999017142-12360_二十四史_第246冊.pdf","normalization":{"character_conversion":{},"extraction_note":"直行右起轉寫，保留欄。原刻異體按本次逐欄讀定編碼；正文不加標點。"}}},{"chapter_id":"c-songshu-063-wanghua-tanshou","work_id":"w-songshu","book_id":"b-songshu-063","source_id":"s-songshu-063-wanghua-tanshou","source":{"title":"《宋書》卷63","provider":"Wikisource","url":"https://zh.wikisource.org/wiki/宋書/卷63","permalink":"https://zh.wikisource.org/w/index.php?title=宋書/卷63&oldid=2118589","revision_id":2118589,"accessed_on":"2026-10-19","extent":"王華完整單元（原wikitext第10—26行）；王曇首完整單元（原wikitext第29—39行）；非全卷。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，未親核底本影像","response_sha256":"73181cb2abd08fb475660bffe338d44821810a3d29bffcce92d7480001b348ab","wikitext_sha256":"6eb0151b62e732d5d4ab564a92b9dc62fe7f2f765b66436f8560c963a014c223","normalization":{"character_conversion":{},"extraction_note":"逐個完整傳主單元收錄；去除ref並另存數位校勘記、展開YL年號模板、保留異體與數位括補原字。數位題頭另存，不當正文或親屬證據。","excerpts":[{"proposed_paragraph_id":"c-songshu-063-wanghua-tanshou:line010","source_lines":[10,10],"raw_quote":"王華字子陵，琅邪臨沂人，太保弘從祖弟也。祖薈，衞將軍，會稽內史。父廞，太子中庶子，司徒左長史。居在吳，晉隆安初，王恭起兵討王國寶，時廞丁母憂在家，恭檄令起兵，廞即聚眾應之，以女為貞烈將軍，以女人為官屬。國寶既死，恭檄廞罷兵。<ref>恭檄廞罷兵　各本並脫「廞罷兵」三字，義不可通，今據南史補，又參校晉書王導傳孫廞附傳。</ref>廞起兵之際，多所誅戮，至是不復得已，因舉兵以討恭為名。恭遣劉牢之擊廞，廞敗走，不知所在。長子泰為恭所殺。華時年十三，<ref>年十三　「十三」各本並作「十二」，據南史改。張森楷校勘記云：「華以元嘉四年卒，年四十三，逆數至隆安元年，凡三十年。作年十三是。」</ref>在軍中，與廞相失，隨沙門釋曇永逃竄。時牢之搜檢覔華甚急，曇永使華提衣幞隨後，津邏咸疑焉。華行遲，永呵罵云：「奴子怠懈，行不及我！」以杖捶華數十，眾乃不疑，由此得免。","raw_quote_sha256":"29c833223b3a0ddcb78ac0e256780d5a59f683a8ffc67e8a4ca7804b11869123","selected_text_sha256":"3a4116af5e0dbdfe06533280028275fcd9aa92d1537d2cd118cc6cd1721dbdf2","begin_anchor":"王華字子陵，琅邪臨沂人，太保弘從祖弟也。祖薈，衞","end_anchor":"，行不及我！」以杖捶華數十，眾乃不疑，由此得免。","digital_editorial_notes":["恭檄廞罷兵　各本並脫「廞罷兵」三字，義不可通，今據南史補，又參校晉書王導傳孫廞附傳。","年十三　「十三」各本並作「十二」，據南史改。張森楷校勘記云：「華以元嘉四年卒，年四十三，逆數至隆安元年，凡三十年。作年十三是。」"],"biographical_unit":"王華"},{"proposed_paragraph_id":"c-songshu-063-wanghua-tanshou:line012","source_lines":[12,12],"raw_quote":"遇赦還吳。少有志行，以父存亡不測，布衣蔬食不交游，如此十餘年，為時人所稱美。高祖欲收其才用，乃發廞喪問，使華制服。","raw_quote_sha256":"6ee78cb643991348fc224766cd3e072c2f008bc3163157ae0b802652494006a6","selected_text_sha256":"6ee78cb643991348fc224766cd3e072c2f008bc3163157ae0b802652494006a6","begin_anchor":"遇赦還吳。少有志行，以父存亡不測，布衣蔬食不交游","end_anchor":"人所稱美。高祖欲收其才用，乃發廞喪問，使華制服。","digital_editorial_notes":[],"biographical_unit":"王華"},{"proposed_paragraph_id":"c-songshu-063-wanghua-tanshou:line014","source_lines":[14,14],"raw_quote":"服闋，高祖北伐長安，領鎮西將軍、北徐州刺史，辟華為州主簿，仍轉鎮西主簿，治中從事史，歷職著稱。太祖鎮江陵，<ref>太祖鎮江陵　「鎮」各本並作「征」，按文帝未即位前，未嘗征江陵，「征」當是「鎮」之譌，今改正。</ref>以為西中郎主簿，遷諮議參軍，領錄事。太祖進號鎮西，復隨府轉。太祖未親政，政事悉委司馬張邵。華性尚物，不欲人在己前，邵性豪，每行來常引夾轂，華出入乘牽車，從者不過二三以矯之。嘗於城內相逢，華陽不知是邵，謂左右：「此鹵簿甚盛，必是殿下出行。」乃下牽車，立於道側，及邵至乃驚。邵白服登城，為華所糾，坐被徵，華代為司馬、南郡太守，行府州事。","raw_quote_sha256":"17d9d136697dade1e79a0e36e85857e2a9dcc6d9568cab9309af36bdf2f21a50","selected_text_sha256":"a17aa5471506add1cdcba350ae8bafee987c0c1aedd6984b8efc39a5b7401aae","begin_anchor":"服闋，高祖北伐長安，領鎮西將軍、北徐州刺史，辟華","end_anchor":"華所糾，坐被徵，華代為司馬、南郡太守，行府州事。","digital_editorial_notes":["太祖鎮江陵　「鎮」各本並作「征」，按文帝未即位前，未嘗征江陵，「征」當是「鎮」之譌，今改正。"],"biographical_unit":"王華"},{"proposed_paragraph_id":"c-songshu-063-wanghua-tanshou:line016","source_lines":[16,16],"raw_quote":"太祖入奉大統，以少帝見害，疑不敢下。華建議曰：「羨之等受寄崇重，未容便敢背德，廢主若存，慮其將來受禍，致此殺害。蓋由每生情多，<ref>蓋由每生情多　「每」通鑑宋元嘉元年作「貪」。元龜七一七此句下注云：「每，貪也。」按漢書賈誼傳所載鵩鳥賦有「品庶每生」語。孟康云：「每，貪也。」</ref>寧敢一朝頓懷逆志。且三人勢均，莫相推伏，不過欲握權自固，以少主仰待耳。今日就徵，萬無所慮。」太祖從之，留華總後任。上即位，以華為侍中，領驍騎將軍，未拜，轉右衞將軍，侍中如故。","raw_quote_sha256":"356420653b7db599b624dd790273df7edabd32ce6d5f1121eb1eca3b1cc352cc","selected_text_sha256":"59a76797fb4c56374b5b0d96fcba030420888fd9a39486058238c09fc856d77b","begin_anchor":"太祖入奉大統，以少帝見害，疑不敢下。華建議曰：「","end_anchor":"為侍中，領驍騎將軍，未拜，轉右衞將軍，侍中如故。","digital_editorial_notes":["蓋由每生情多　「每」通鑑宋元嘉元年作「貪」。元龜七一七此句下注云：「每，貪也。」按漢書賈誼傳所載鵩鳥賦有「品庶每生」語。孟康云：「每，貪也。」"],"biographical_unit":"王華"},{"proposed_paragraph_id":"c-songshu-063-wanghua-tanshou:line018","source_lines":[18,18],"raw_quote":"先是，會稽孔甯子為太祖鎮西諮議參軍，以文義見賞，至是為黃門侍郎，領步兵校尉。甯子先為高祖太尉主簿，陳損益曰：「隆化之道，莫先於官得其才；枚卜之方，莫若人慎其舉。雖復因革不同，損益有物，求賢審官，未之或改。師錫僉曰，煥乎欽明之誥，拔茅征吉，著於幽賁之爻。晉師有成，瓜衍作賞，楚乘無入，蒍賈不賀。今舊命惟新，幽人引領，韶之盡美，已備於振綱；武之未盡，或存於理目。雖九官之職，未可備舉，親民之選，尤宜在先。愚欲使天朝四品官，外及守牧，各舉一人堪為二千石長吏者，以付選官，隨缺敍用，得賢受賞，失舉任罰。夫惟帝之難，豈庸識所易，然舉爾所知，非求多人，因百官之明，孰與一識之見，執咎在己，豈容徇物之私。今非以選曹所銓，果於乖謬，眾職所舉，必也惟良，蓋宜使求賢闢其廣塗，考績取其少殿。若才實拔羣，進宜尚德，治阿之宰，不必計年，免徒之守，豈限資秩。自此以還，故當才均以資，資均以地。宰莅之官，誠曰吏職，然監觀民瘼，翼化宣風，則隱厚之求，急於刀筆，能事之功，接於德心，以此論才，行之年歲，豈惟政無秕蠹，民庇手足而已，將使公路日清，私請漸塞。士多心競，仁必由己，處士砥自求之節，仕子藏交馳之情。甯子庸微，不識治體，冒昧陳愚，退懼違謬。」","raw_quote_sha256":"deea865bbde8d4f6cfbe0da71cebdc0cce3d33d4a026f4342bf2347085254d3d","selected_text_sha256":"deea865bbde8d4f6cfbe0da71cebdc0cce3d33d4a026f4342bf2347085254d3d","begin_anchor":"先是，會稽孔甯子為太祖鎮西諮議參軍，以文義見賞，","end_anchor":"之情。甯子庸微，不識治體，冒昧陳愚，退懼違謬。」","digital_editorial_notes":[],"biographical_unit":"王華"},{"proposed_paragraph_id":"c-songshu-063-wanghua-tanshou:line020","source_lines":[20,20],"raw_quote":"甯子與華並有富貴之願，自羨之等秉權，日夜構之於太祖。甯子嘗東歸，至金昌亭，左右欲泊船，甯子命去之，曰：「此弒君亭，不可泊也。」華每閑居諷詠，常誦王粲登樓賦曰：「冀王道之一平，假高衢而騁力。」出入逢羨之等，每切齒憤咤，歎曰：「當見太平時不？」元嘉二年，甯子病卒。三年，誅羨之等，華遷護軍，侍中如故。","raw_quote_sha256":"fcf8d5841ee94016bb560bc5e72ade895b20b81707333ba120d765515fa972d9","selected_text_sha256":"fcf8d5841ee94016bb560bc5e72ade895b20b81707333ba120d765515fa972d9","begin_anchor":"甯子與華並有富貴之願，自羨之等秉權，日夜構之於太","end_anchor":"，甯子病卒。三年，誅羨之等，華遷護軍，侍中如故。","digital_editorial_notes":[],"biographical_unit":"王華"},{"proposed_paragraph_id":"c-songshu-063-wanghua-tanshou:line022","source_lines":[22,22],"raw_quote":"宋世惟華與南陽劉湛不為飾讓，得官即拜，以此為常。華以情事異人，未嘗預宴集，終身不飲酒，有燕不之詣。若宜有論事者，乘車造門，主人出車就之。及王弘輔政，而弟曇首為太祖所任，與華相埒，華嘗謂己力用不盡，每歎息曰：「宰相頓有數人，天下何由得治！」四年，卒，時年四十三。追贈散騎常侍、衞將軍。九年，上思誅羨之之功，追封新建縣侯，食邑千戶，諡曰宣侯。世祖即位，配饗太祖廟庭。","raw_quote_sha256":"13c85f1221253e18a00cd88ae740fb552dc8f3aaf68e946c3abfe0c8e633bd26","selected_text_sha256":"13c85f1221253e18a00cd88ae740fb552dc8f3aaf68e946c3abfe0c8e633bd26","begin_anchor":"宋世惟華與南陽劉湛不為飾讓，得官即拜，以此為常。","end_anchor":"侯，食邑千戶，諡曰宣侯。世祖即位，配饗太祖廟庭。","digital_editorial_notes":[],"biographical_unit":"王華"},{"proposed_paragraph_id":"c-songshu-063-wanghua-tanshou:line024","source_lines":[24,24],"raw_quote":"子定侯嗣，<ref>子定侯嗣　「定侯」各本並作「宣侯」，據南史改。按王華諡宣侯，子不當復諡宣侯。「嗣」，王華子之名。錢大昕廿二史考異云：「王僧綽傳云，王華子新建侯嗣，才劣，位遇亦輕。則嗣乃華子之名。」</ref>官至左衞將軍，卒。子長嗣，太宗泰始二年，坐罵母奪爵，以長弟終紹封。<ref>以長弟終紹封　「終」南史作「佟」。</ref>後廢帝元徽三年，終上表乞以封還長，許之。齊受禪，國除。","raw_quote_sha256":"4991273f502a699f1483b17755a6f6b2de4f9aa5c13485f764ea22a7c7ead08d","selected_text_sha256":"48e9c45b16911b49fbeca496128873fc92dcdedce0b5f456238ac457a57160d4","begin_anchor":"子定侯嗣，官至左衞將軍，卒。子長嗣，太宗泰始二年","end_anchor":"元徽三年，終上表乞以封還長，許之。齊受禪，國除。","digital_editorial_notes":["子定侯嗣　「定侯」各本並作「宣侯」，據南史改。按王華諡宣侯，子不當復諡宣侯。「嗣」，王華子之名。錢大昕廿二史考異云：「王僧綽傳云，王華子新建侯嗣，才劣，位遇亦輕。則嗣乃華子之名。」","以長弟終紹封　「終」南史作「佟」。"],"biographical_unit":"王華"},{"proposed_paragraph_id":"c-songshu-063-wanghua-tanshou:line026","source_lines":[26,26],"raw_quote":"華從父弟鴻，五兵尚書，會稽太守。","raw_quote_sha256":"a17c109ef2e881170fbc83b2552c645510e90c01991015ec43310b76ae12d18b","selected_text_sha256":"a17c109ef2e881170fbc83b2552c645510e90c01991015ec43310b76ae12d18b","begin_anchor":"華從父弟鴻，五兵尚書，會稽太守。","end_anchor":"華從父弟鴻，五兵尚書，會稽太守。","digital_editorial_notes":[],"biographical_unit":"王華"},{"proposed_paragraph_id":"c-songshu-063-wanghua-tanshou:line029","source_lines":[29,29],"raw_quote":"王曇首，琅邪臨沂人，太保弘少弟也。","raw_quote_sha256":"f7040a1a9727c35816858a6b001d60127f79cc8b597a77c850f73d0da700180a","selected_text_sha256":"f7040a1a9727c35816858a6b001d60127f79cc8b597a77c850f73d0da700180a","begin_anchor":"王曇首，琅邪臨沂人，太保弘少弟也。","end_anchor":"王曇首，琅邪臨沂人，太保弘少弟也。","digital_editorial_notes":[],"biographical_unit":"王曇首"},{"proposed_paragraph_id":"c-songshu-063-wanghua-tanshou:line031","source_lines":[31,31],"raw_quote":"幼有業尚，除著作郎，不就。兄弟分財，曇首唯取圖書而已。辟琅邪王大司馬屬，從府公修復洛陽園陵。與從弟球俱詣高祖，時謝晦在坐，高祖曰：「此君並膏粱盛德，乃能屈志戎旅。」曇首答曰：「既從神武之師，自使懦夫有立志。」晦曰：「仁者果有勇。」高祖悅。行至彭城，高祖大會戲馬臺，豫坐者皆賦詩，曇首文先成，高祖覽讀，因問弘曰：「卿弟何如卿？」弘答曰：「若但如民，<ref>若但如民　「民」宋本殘葉作「民」；弘治本、北監本、毛本、殿本、局本作「臣」；南史、元龜九一七作「下官」。涵芬樓影印百衲本宋書時，以各本並作「臣」，謂宋本殘葉作「民」為誤，謬改為「臣」。按時劉裕尚未稱帝，王弘不當稱臣，宋書殘葉稱「民」，南史稱下官，並不誤。今改回。</ref>門戶何寄。」高祖大笑。曇首有識局智度，喜慍不見於色，閨門之內，雍雍如也。手不執金玉，婦女不得為飾玩，自非祿賜所及，一毫不受於人。","raw_quote_sha256":"e2a75fe90106a9841e7fdc037cfa2fd1e99d18d6cdc5be9c6f6dc1d76e22ff38","selected_text_sha256":"cef05c8432582ea28d6622a6a6a01439c7a61834b1cb162ec2ca4fd82c88ecdf","begin_anchor":"幼有業尚，除著作郎，不就。兄弟分財，曇首唯取圖書","end_anchor":"玉，婦女不得為飾玩，自非祿賜所及，一毫不受於人。","digital_editorial_notes":["若但如民　「民」宋本殘葉作「民」；弘治本、北監本、毛本、殿本、局本作「臣」；南史、元龜九一七作「下官」。涵芬樓影印百衲本宋書時，以各本並作「臣」，謂宋本殘葉作「民」為誤，謬改為「臣」。按時劉裕尚未稱帝，王弘不當稱臣，宋書殘葉稱「民」，南史稱下官，並不誤。今改回。"],"biographical_unit":"王曇首"},{"proposed_paragraph_id":"c-songshu-063-wanghua-tanshou:line033","source_lines":[33,33],"raw_quote":"太祖為冠軍、徐州刺史，留鎮彭城，以曇首為府功曹。太祖鎮江陵，自功曹為長史，隨府轉鎮西長史。高祖甚知之，謂太祖曰：「王曇首，沈毅有器度，宰相才也。汝每事咨之。」景平中，有龍見西方，半天騰上，廕五綵雲，京都遠近聚觀，太史奏曰：「西方有天子氣。」太祖入奉大統，上及議者皆疑不敢下，曇首與到彥之、從兄華固勸，上猶未許。曇首又固陳，并言天人符應，上乃下。率府州文武嚴兵自衞，臺所遣百官眾力，不得近部伍，中兵參軍朱容子抱刀在平乘戶外，不解帶者數旬。既下在道，有黃龍出負上所乘舟，左右皆失色，上謂曇首曰：「此乃夏禹所以受天命，我何德以堪之。」<ref>我何德以堪之　各本並脫「德以」二字，據藝文類聚九八引、建康實錄補。</ref>及即位，又謂曇首曰：「非宋昌獨見，無以致此。」以曇首為侍中，尋領右衞將軍，領驍騎將軍。以朱容子為右軍將軍。誅徐羨之等，平謝晦，曇首及華之力也。","raw_quote_sha256":"c98ae970f9b765b6c8ea8c95f691ff4b19cae3145ca44b043e88462adda1c353","selected_text_sha256":"cedce3d7d785b9554d03c7e29e918e8cbcfbbc4a0fcad40edc8b0796e4544844","begin_anchor":"太祖為冠軍、徐州刺史，留鎮彭城，以曇首為府功曹。","end_anchor":"為右軍將軍。誅徐羨之等，平謝晦，曇首及華之力也。","digital_editorial_notes":["我何德以堪之　各本並脫「德以」二字，據藝文類聚九八引、建康實錄補。"],"biographical_unit":"王曇首"},{"proposed_paragraph_id":"c-songshu-063-wanghua-tanshou:line035","source_lines":[35,35],"raw_quote":"元嘉四年，車駕出北堂，嘗使三更竟開廣莫門，南臺云：「應須白虎幡，銀字棨。」不肯開門。尚書左丞羊玄保奏免御史中丞傅隆以下，曇首繼啟曰：「既無墨敕，又闕幡棨，雖稱上旨，不異單刺。元嘉元年、二年，雖有再開門例，<ref>元嘉元年二年雖有再開門例　宋本殘葉脫「元」字，弘治本、北監本、毛本、殿本、局本脫「元年」二字，據南史、元龜四六０、御覽三四一引訂補。</ref>此乃前事之違。今之守舊，未為非禮。但既據舊史，<ref>但既據舊史　「史」各本並作「使」，據元龜四六０改。</ref>應有疑却本末，曾無此狀，猶宜反咎其不請白虎幡、銀字棨，致門不時開，由尚書相承之失，亦合糾正。」上特無所問，更立科條。遷太子詹事，侍中如故。","raw_quote_sha256":"ff957ac68de90f64a56407be420f8b7a6ea7f35db0289e2489576dfdc5a6ad4c","selected_text_sha256":"c25283a041a06cbf89c939ef756ce417559260b66600c0204fd2e86ae42c6193","begin_anchor":"元嘉四年，車駕出北堂，嘗使三更竟開廣莫門，南臺云","end_anchor":"。」上特無所問，更立科條。遷太子詹事，侍中如故。","digital_editorial_notes":["元嘉元年二年雖有再開門例　宋本殘葉脫「元」字，弘治本、北監本、毛本、殿本、局本脫「元年」二字，據南史、元龜四六０、御覽三四一引訂補。","但既據舊史　「史」各本並作「使」，據元龜四六０改。"],"biographical_unit":"王曇首"},{"proposed_paragraph_id":"c-songshu-063-wanghua-tanshou:line037","source_lines":[37,37],"raw_quote":"晦平後，上欲封曇首等，會讌集，舉酒勸之，因拊御牀曰：「此坐非卿兄弟，無復今日。」時封詔已成，出以示曇首，曇首曰：「近日之事，釁難將成，賴陛下英明速斷，故罪人斯戮。臣等雖得仰憑天光，効其毫露，豈可因國之災，以為身幸。陛下雖欲私臣，當如直史何。」上不能奪，故封事遂寢。時兄弘錄尚書事，又為揚州刺史，曇首為上所親委，任兼兩宮。彭城王義康與弘並錄，意常怏怏，又欲得揚州，形於辭旨。以曇首居中，分其權任，愈不悅。曇首固乞吳郡，太祖曰：「豈有欲建大厦而遺其棟梁者哉。賢兄比屢稱疾，固辭州任，將來若相申許者，此處非卿而誰？亦何吳郡之有。」時弘久疾，屢遜位，不許。義康謂賓客曰：「王公久疾不起，神州詎合臥治。」曇首勸弘減府兵力之半以配義康，<ref>曇首勸弘減府兵力之半以配義康　各本並脫「力」字，據南史補。</ref>義康乃悅。","raw_quote_sha256":"8d85c5518a8e5bf1bc8dd7e63ef4ea86abfec9cde5d62a11add6d667041789e5","selected_text_sha256":"e36328a376fdd83aab2dfd9884e9c28aac33148b75a372984e7dee012d4261f4","begin_anchor":"晦平後，上欲封曇首等，會讌集，舉酒勸之，因拊御牀","end_anchor":"臥治。」曇首勸弘減府兵力之半以配義康，義康乃悅。","digital_editorial_notes":["曇首勸弘減府兵力之半以配義康　各本並脫「力」字，據南史補。"],"biographical_unit":"王曇首"},{"proposed_paragraph_id":"c-songshu-063-wanghua-tanshou:line039","source_lines":[39,39],"raw_quote":"七年，卒。太祖為之慟，中書舍人周赳侍側，<ref>中書舍人周赳侍側　「周赳」各本並作「周起」，據南史、元龜二０四、四六一改。按本書殷景仁傳、張敷傳均作「周赳」。</ref>曰：「王家欲衰，賢者先殞。」上曰：「直是我家衰耳。」追贈左光祿大夫，加散騎常侍，詹事如故。九年，以預誅羨之等謀，追封豫寧縣侯，邑千戶，諡曰文侯。世祖即位，配饗太祖廟庭。子僧綽嗣，別有傳。少子僧虔，昇明末，為尚書令。","raw_quote_sha256":"e725cc5ee8d1f9357359c0d63e97f7bd883520ff7bed2371d773ad5412fa0fe4","selected_text_sha256":"32cd47a281ddafa2567a6b0e6a8cd8267f02e3c69772a3be15bb8106159ba06e","begin_anchor":"七年，卒。太祖為之慟，中書舍人周赳侍側，曰：「王","end_anchor":"。子僧綽嗣，別有傳。少子僧虔，昇明末，為尚書令。","digital_editorial_notes":["中書舍人周赳侍側　「周赳」各本並作「周起」，據南史、元龜二０四、四六一改。按本書殷景仁傳、張敷傳均作「周赳」。"],"biographical_unit":"王曇首"}]}}},{"chapter_id":"c-songshu-063-wangtanshou-wyd","work_id":"w-songshu","book_id":"b-songshu-063","source_id":"s-songshu-063-wangtanshou-wyd1739","source":{"title":"武英殿本《宋書》卷六十三王曇首傳","provider":"中國國家圖書館藏乾隆四年武英殿刊本，Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:NLC892-411999017142-12245_二十四史_第147冊.pdf","permalink":"https://commons.wikimedia.org/wiki/File:NLC892-411999017142-12245_二十四史_第147冊.pdf","revision_id":"cbr-ai-transcription-sha256:a3ae53ead4a5ba2ebf8aa47e120cc69353f39fd44f82d0cd41d25b5d91fcb275","accessed_on":"2026-11-21","raw_path":"source-evidence/song063-wang/wyd-columns.txt","raw_file_sha256":"a3ae53ead4a5ba2ebf8aa47e120cc69353f39fd44f82d0cd41d25b5d91fcb275","edition":"乾隆四年武英殿刊《二十四史》第147冊","extent":"卷六十三葉四上至六下，PDF第18面左第8欄至第21面右第5欄。","text_scope":"complete_biography_unit","image