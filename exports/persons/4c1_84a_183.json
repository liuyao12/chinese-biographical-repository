n":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-022","chapter_id":"c-nanshi-022-wangtanshou-wyd","source_id":"s-nanshi-022-wangtanshou-wyd1739","paragraph_id":"c-nanshi-022-wangtanshou-wyd:p003","quote":"元嘉四年車駕出北堂使三更竟開廣莫門南臺云應須白獸幡銀字棨不肯開尚書左丞羊𤣥保奏免御史中丞傅隆旨下曇首曰旣無異敕又闕幡棨雖稱上旨不異單刺元嘉元年二年雖有再開門例此乃前事之違今之守舊未爲非禮其不請白獸幡銀字棨致開門不時由尚書相承之失亦合糾正上特無問更立科條遷太子詹事侍中如故","person_mention_id":"c-nanshi-022-wangtanshou-wyd:p003:m0035"}],"status":"source_attested","interpretation_note":"原句標明本官或封爵；金紫光祿大夫為追贈。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"th-songwang7-63-35-42-37","person_id":"4c1_84a_183","title":"尚書左丞","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"work_id":"w-songshu","book_id":"b-songshu-063","chapter_id":"c-songshu-063-wanghua-tanshou","source_id":"s-songshu-063-wanghua-tanshou","paragraph_id":"c-songshu-063-wanghua-tanshou:line035","quote":"元嘉四年，車駕出北堂，嘗使三更竟開廣莫門，南臺云：「應須白虎幡，銀字棨。」不肯開門。尚書左丞羊玄保奏免御史中丞傅隆以下，曇首繼啟曰：「既無墨敕，又闕幡棨，雖稱上旨，不異單刺。元嘉元年、二年，雖有再開門例，此乃前事之違。今之守舊，未為非禮。但既據舊史，應有疑却本末，曾無此狀，猶宜反咎其不請白虎幡、銀字棨，致門不時開，由尚書相承之失，亦合糾正。」上特無所問，更立科條。遷太子詹事，侍中如故。","person_mention_id":"c-songshu-063-wanghua-tanshou:line035:m0046"}],"attestations":[{"id":"th-songwang7-63-35-42-37:a","paragraph_id":"c-songshu-063-wanghua-tanshou:line035","start":42,"end":46,"surface":"尚書左丞","person_mention_id":"c-songshu-063-wanghua-tanshou:line035:m0046","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"依本傳明文記錄；不補未知始末，不以死亡結束其他職銜；原字及爵官省稱保留。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"th-wyd-song063-4-33","person_id":"4c1_84a_183","title":"尚書左丞","kind":"office","mode":"attestation","attestations":[{"id":"th-wyd-song063-4-33:a","paragraph_id":"c-songshu-063-wangtanshou-wyd:p004","start":33,"end":37,"surface":"尚書左丞","usage":"narrative","date_expression":null,"person_mention_id":"c-songshu-063-wangtanshou-wyd:p004:m0037"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-063","source_id":"s-songshu-063-wangtanshou-wyd1739","chapter_id":"c-songshu-063-wangtanshou-wyd","paragraph_id":"c-songshu-063-wangtanshou-wyd:p004","quote":"元嘉四年車駕出北堂嘗使三更竟開廣莫門南臺云應須白虎幡銀字棨不肯開門尚書左丞羊玄保奏免御史中丞傅隆以下曇首繼啓曰旣無墨敕又闕幡棨雖稱上旨不異單刺元嘉二年雖有再開門例此乃前事之違今之守舊未爲非禮但旣據舊使應有疑却本末曾無此狀猶宜厥咎其不請白虎幡銀字棨致門不時開由尚書相承之失亦合糾正上特無所問更立科條遷太子詹事侍中如故","person_mention_id":"c-songshu-063-wangtanshou-wyd:p004:m0037"}],"status":"source_attested","interpretation_note":"按刊本受任者及職稱字位。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-046-xiaohuiji-complete:p006","text":"　　五年，遷太常，加給事中。自宋大明以來，聲伎所尚，多鄭衞淫俗，雅樂正聲，鮮有好者。惠基解音律，尤好魏三祖曲及《相和歌》，每奏，輙賞悅不能已。當時能棊人琅邪王抗第一品，吳郡褚思莊、會稽夏赤松竝第二品。赤松思速，善於大行；思莊思遲，巧於鬬棊。宋文帝世，羊玄保爲會稽太守，帝遣思莊入東與玄保戲，因製局圖，還於帝前覆之。太祖使思莊與王抗交賭，自食時至日暮，一局始竟。上倦，遣還省，至五更方決。抗睡於局後，思莊達曉不寐。世或云：「思莊所以品第致高，緣其用思深久，人不能對也。」抗、思莊竝至給事中。永明中，敕抗品棊，竟陵王子良使惠基掌其事。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":78,"last_line":78,"raw_start":6181,"raw_end":6446,"raw_character_offsets":[6181,6182,6183,6184,6185,6186,6187,6188,6189,6190,6191,6192,6193,6194,6195,6196,6197,6198,6199,6200,6201,6202,6203,6204,6205,6206,6207,6208,6209,6210,6211,6212,6213,6214,6215,6216,6217,6218,6219,6220,6221,6222,6223,6224,6225,6226,6227,6228,6229,6230,6231,6232,6233,6234,6235,6236,6237,6238,6239,6240,6241,6242,6243,6244,6245,6246,6247,6248,6249,6250,6251,6252,6253,6254,6255,6256,6257,6258,6259,6260,6261,6262,6263,6264,6265,6266,6267,6268,6269,6270,6271,6272,