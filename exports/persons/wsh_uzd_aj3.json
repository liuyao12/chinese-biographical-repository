{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"wsh_uzd_aj3","canonical_person_id":"wsh_uzd_aj3","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["wsh_uzd_aj3"],"persons":[{"id":"wsh_uzd_aj3","label":"孔（平津侯主父列傳上書候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"孔","mention_ids":["c-shiji-112-pingjin:m015-0066"]},{"surface":"仲尼","mention_ids":["c-shiji-112-pingjin:m029-0083"]},{"surface":"孔子","mention_ids":["c-shiji-112-pingjin:m029-0208"]}],"evidence":[{"mention_id":"c-shiji-112-pingjin:m015-0066","chapter_id":"c-shiji-112-pingjin","paragraph_id":"c-shiji-112-pingjin:p015","quote":"孔"},{"mention_id":"c-shiji-112-pingjin:m029-0083","chapter_id":"c-shiji-112-pingjin","paragraph_id":"c-shiji-112-pingjin:p029","quote":"仲尼"},{"mention_id":"c-shiji-112-pingjin:m029-0208","chapter_id":"c-shiji-112-pingjin","paragraph_id":"c-shiji-112-pingjin:p029","quote":"孔子"}]}],"source_mention_summary":[{"source_id":"s-shiji112-pingjin","work_id":"w-shiji","book_id":"b-shiji-112","chapter_id":"c-shiji-112-pingjin","mention_count":3,"mention_ids":["c-shiji-112-pingjin:m015-0066","c-shiji-112-pingjin:m029-0083","c-shiji-112-pingjin:m029-0208"],"paragraph_ids":["c-shiji-112-pingjin:p015","c-shiji-112-pingjin:p029"],"table_cell_ids":[],"passage_count":2}],"most_mentioned_source_ids":["s-shiji112-pingjin"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-112-pingjin:m015-0066","start":66,"end":67,"surface":"孔","kind":"person","person_id":"wsh_uzd_aj3","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p015","chapter_id":"c-shiji-112-pingjin"},{"id":"c-shiji-112-pingjin:m029-0083","start":83,"end":85,"surface":"仲尼","kind":"person","person_id":"wsh_uzd_aj3","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p029","chapter_id":"c-shiji-112-pingjin"},{"id":"c-shiji-112-pingjin:m029-0208","start":208,"end":210,"surface":"孔子","kind":"person","person_id":"wsh_uzd_aj3","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p029","chapter_id":"c-shiji-112-pingjin"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-112-pingjin:p015","text":"臣聞天下之患在於土崩，不在於瓦解，古今一也。何謂土崩？秦之末世是也。陳涉無千乘之尊，尺土之地，身非王公大人名族之后，無鄉曲之譽，非有孔、墨、曾子之賢，陶朱、猗頓之富也，然起窮巷，奮棘矜，偏袒大呼而天下從風，此其故何也？由民困而主不恤，下怨而上不知（也），俗已亂而政不修，此三者陳涉之所以為資也。是之謂土崩。故曰天下之患在於土崩。何謂瓦解？吳、楚、齊、趙之兵是也。七國謀為大逆，號皆稱萬乘之君，帶甲數十萬，威足以嚴其境內，財足以勸其士民，然不能西攘尺寸之地而身為禽於中原者，此其故何也？非權輕於匹夫而兵弱於陳涉也，當是之時，先帝之德澤未衰而安土樂俗之民眾，故諸侯無境外之助。此之謂瓦解，故曰天下之患不在瓦解。由是觀之，天下誠有土崩之勢，雖布衣窮處之士或首惡而危海內，陳涉是也。況三晉之君或存乎！天下雖未有大治也，誠能無土崩之勢，雖有彊國勁兵不得旋踵而身為禽矣，吳、楚、齊、趙是也。況群臣百姓能為亂乎哉！此二體者，安危之明要也，賢主所留意而深察也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-112-pingjin:m015-0034","start":34,"end":36,"surface":"陳涉","kind":"person","person_id":"b74_xpn_elo","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0066","start":66,"end":67,"surface":"孔","kind":"person","person_id":"wsh_uzd_aj3","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0068","start":68,"end":69,"surface":"墨","kind":"person","person_id":"lni_lzq_7s0","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0070","start":70,"end":72,"surface":"曾子","kind":"person","person_id":"zvp_ubd_334","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0075","start":75,"end":77,"surface":"陶朱","kind":"person","person_id":"2n9_bsn_ad1","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0078","start":78,"end":80,"surface":"猗頓","kind":"person","person_id":"3r9_0to_we7","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0138","start":138,"end":140,"surface":"陳涉","kind":"person","person_id":"b74_xpn_elo","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0181","start":181,"end":183,"surface":"七國","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-112-pingjin:m015-0252","start":252,"end":254,"surface":"陳涉","kind":"person","person_id":"b74_xpn_elo","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0261","start":261,"end":263,"surface":"先帝","kind":"person","person_id":"moo_r04_tz1","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0332","start":332,"end":334,"surface":"陳涉","kind":"person","person_id":"b74_xpn_elo","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0338","start":338,"end":342,"surface":"三晉之君","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-112-pingjin","book_id":"b-shiji-112","work_id":"w-shiji","source_id":"s-shiji112-pingjin"},{"id":"c-shiji-112-pingjin:p029","text":"太皇太后詔大司徒大司空：「蓋聞治國之道，富民為始；富民之要，在於節儉。《孝經》曰『安上治民，莫善於禮』。『禮，與奢也寧儉』。昔者管仲相齊桓，霸諸侯，有九合一匡之功，而仲尼謂之不知禮，以其奢泰侈擬於君故也。夏禹卑宮室，惡衣服，后聖不循。由此言之，治之盛也，德優矣，莫高於儉。儉化俗民，則尊卑之序得，而骨肉之恩親，爭訟之原息。斯乃家給人足，刑錯之本也歟？可不務哉！夫三公者，百寮之率，萬民之表也。未有樹直表而得曲影者也。孔子不云乎，『子率而正，孰敢不正』。『舉善而教不能則勸』。維漢興以來，股肱宰臣身行儉約，輕財重義，較然著明，未有若故丞相平津侯公孫弘者也。位在丞相而為布被，脫粟之飯，不過一肉。故人所善賓客皆分奉祿以給之，無有所餘。誠內自克約而外從制。汲黯詰之，乃聞于朝，此可謂減於制度而可施行者也。德優則行，否則止，與內奢泰而外為詭服以釣虛譽者殊科。以病乞骸骨，孝武皇帝即制曰『賞有功，褒有德，善善惡惡，君宜知之。其省思慮，存精神，輔以醫藥』。賜告治病，牛酒雜帛。居數月，有瘳，視事。至元狩二年，竟以善終于相位。夫知臣莫若君，此其效也。弘子度嗣爵，后為山陽太守，坐法失侯。夫表德章義，所以率俗厲化，聖王之制，不易之道也。其賜弘後子孫之次當為後者爵關內侯，食邑三百戶，徵詣公車，上名尚書，朕親臨拜焉。」","annotation_status":"in_progress","text_layer":"witness_appended_edict","mentions":[{"id":"c-shiji-112-pingjin:m029-0000","start":0,"end":4,"surface":"太皇