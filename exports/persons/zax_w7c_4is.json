aodu-complete:p001","chapter_id":"c-nanqishu-045-daodu-complete"},{"id":"c-nanqishu-054-recluses-complete:p011:m0193","start":193,"end":196,"surface":"雷次宗","kind":"person","person_id":"zax_w7c_4is","status":"contextual_provisional","paragraph_id":"c-nanqishu-054-recluses-complete:p011","chapter_id":"c-nanqishu-054-recluses-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-045-daodu-complete:p001","text":"　　衡陽元王道度，太祖長兄也。與太祖俱受學雷次宗。宣帝問二兒學業，次宗答曰：「其兄外朗，其弟內潤，皆良璞也。」隨宣帝征伐，仕至安定太守，卒於宋世。建元二年，追加封謚。無子，太祖以第十一子鈞繼道度後。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":13,"last_line":13,"raw_start":184,"raw_end":295,"raw_character_offsets":[184,185,186,187,188,189,190,191,192,193,194,195,196,197,198,199,200,201,202,203,204,205,206,207,208,209,210,211,212,213,214,215,216,217,218,219,220,221,222,223,224,225,226,227,228,229,230,231,232,233,234,235,236,237,238,239,240,241,242,243,244,245,246,247,248,249,250,251,252,253,254,255,256,262,263,264,265,273,274,275,276,277,278,279,280,281,282,283,284,285,286,287,288,289,290,291,292,293,294],"revision_id":2273185},"mentions":[{"id":"c-nanqishu-045-daodu-complete:p001:m0002","start":2,"end":8,"surface":"衡陽元王道度","kind":"person","person_id":"egx_xax_4ic_A","status":"contextual_provisional"},{"id":"c-nanqishu-045-daodu-complete:p001:m0009","start":9,"end":11,"surface":"太祖","kind":"person","person_id":"47p_kjh_ez7","status":"contextual_provisional"},{"id":"c-nanqishu-045-daodu-complete:p001:m0016","start":16,"end":18,"surface":"太祖","kind":"person","person_id":"47p_kjh_ez7","status":"contextual_provisional"},{"id":"c-nanqishu-045-daodu-complete:p001:m0021","start":21,"end":24,"surface":"雷次宗","kind":"person","person_id":"zax_w7c_4is","status":"contextual_provisional"},{"id":"c-nanqishu-045-daodu-complete:p001:m0025","start":25,"end":27,"surface":"宣帝","kind":"person","person_id":"egx_xax_4ic","status":"contextual_provisional"},{"id":"c-nanqishu-045-daodu-complete:p001:m0033","start":33,"end":35,"surface":"次宗","kind":"person","person_id":"zax_w7c_4is","status":"contextual_provisional"},{"id":"c-nanqishu-045-daodu-complete:p001:m0056","start":56,"end":58,"surface":"宣帝","kind":"person","person_id":"egx_xax_4ic","status":"contextual_provisional"},{"id":"c-nanqishu-045-daodu-complete:p001:m0086","start":86,"end":88,"surface":"太祖","kind":"person","person_id":"47p_kjh_ez7","status":"contextual_provisional"},{"id":"c-nanqishu-045-daodu-complete:p001:m0093","start":93,"end":94,"surface":"鈞","kind":"person","person_id":"47p_kjh_ez7_G","status":"contextual_provisional"},{"id":"c-nanqishu-045-daodu-complete:p001:m0095","start":95,"end":97,"surface":"道度","kind":"person","person_id":"egx_xax_4ic_A","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-045-daodu-complete","book_id":"b-nanqishu-045","work_id":"w-nanqishu","source_id":"s-nanqishu-045-daodu-complete-ws2273185"},{"id":"c-nanqishu-054-recluses-complete:p011","text":"　　顧歡字景怡，吳郡鹽官人也。祖赳，晉隆安末，避亂徙居。歡年六七歲書甲子，有簡三篇，歡析計，遂知六甲。家貧，父使驅田中雀，歡作《黃雀賦》而歸，雀食過半，父怒，欲撻之，見賦乃止。郷中有學舍，歡貧無以受業，於舍壁後倚聽，無遺忘者。八歲，誦《孝經》、《詩》、《論》。及長，篤志好學。母年老，躬耕誦書，夜則燃糠自照。同郡顧顗之臨縣，見而異之，遣諸子與遊，及孫憲之，竝受經句。歡年二十餘，更從豫章雷次宗諮玄儒諸義。母亡，水漿不入口六七日，廬于墓次，遂隱遁不仕。於剡天台山開館聚徒，受業者常近百人。歡早孤，每讀《詩》至「哀哀父母」。輙執書慟泣，學者由是廢《蓼莪篇》不復講。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":46,"last_line":46,"raw_start":1671,"raw_end":1955,"raw_character_offsets":[1671,1672,1673,1674,1675,1676,1677,1678,1679,1680,1681,1682,1683,1684,1685,1686,1687,1688,1689,1690,1691,1692,1693,1694,1695,1696,1697,1698,1699,1700,1701,1702,1703,1704,1705,1706,1707,1708,1709,1710,1711,1712,1713,1714,1715,1716,1717,1718,1719,1720,1721,1722,1723,1724,1725,1726,1727,1728,1729,1730,1731,1732,1733,1734,1737,1738,1739,1742,1743,1744,1745,1746,1747,1748,1749,1750,1751,1752,1753,1754