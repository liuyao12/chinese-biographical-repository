-009-lvhou:m029-0123","start":123,"end":125,"surface":"呂媭","kind":"person","person_id":"cbr-p000845","status":"contextual_provisional","paragraph_id":"c-shiji-009-lvhou:p029","chapter_id":"c-shiji-009-lvhou"}],"relations":[{"id":"a-shiji009-013","subject_person_id":"cbr-p000845","predicate":"sister","object_person_id":"cbr-p000717","status":"source_attested","evidence":[{"paragraph_id":"c-shiji-009-lvhou:p013","quote":"太后女弟呂媭","chapter_id":"c-shiji-009-lvhou","source_id":"s-shiji-009-lvhou"}],"qualifiers":{"source_term":"女弟","historicity":"historical_tradition"},"interpretation_note":"僅保存原文明示主張，不補闕代、同父同母或未見姓名；不推導少帝生物父親。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji009-014","subject_person_id":"cbr-p000854","predicate":"mother","object_person_id":"cbr-p000845","status":"source_attested","evidence":[{"paragraph_id":"c-shiji-009-lvhou:p013","quote":"太后女弟呂媭有女為營陵侯劉澤妻","chapter_id":"c-shiji-009-lvhou","source_id":"s-shiji-009-lvhou"}],"qualifiers":{"source_term":"女","historicity":"historical_tradition"},"interpretation_note":"僅保存原文明示主張，不補闕代、同父同母或未見姓名；不推導少帝生物父親。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji009-042","person_id":"cbr-p000845","surfaces":["呂媭","媭"],"scope":"same_chapter","chapter_ids":["c-shiji-009-lvhou"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-009-lvhou:p013","quote":"二月，徙梁王恢為趙王。呂王產徙為梁王，梁王不之國，為帝太傅。立皇子平昌侯太為呂王。更名梁曰呂，呂曰濟川。太后女弟呂媭有女為營陵侯劉澤妻，澤為大將軍。太后王諸呂，恐即崩後劉將軍為害，乃以劉澤為瑯邪王，以慰其心。"},{"paragraph_id":"c-shiji-009-lvhou:p025","quote":"太尉絳侯勃不得入軍中主兵。曲周侯酈商老病，其子寄與呂祿善。絳侯乃與丞相陳平謀，使人劫酈商。令其子寄往紿說呂祿曰：「高帝與呂后共定天下，劉氏所立九王，呂氏所立三王，皆大臣之議，事已布告諸侯，諸侯皆以為宜。今太后崩，帝少，而足下佩趙王印，不急之國守藩，乃為上將，將兵留此，為大臣諸侯所疑。足下何不歸印，以兵屬太尉？請梁王歸相國印，與大臣盟而之國，齊兵必罷，大臣得安，足下高枕而王千里，此萬世之利也。」呂祿信然其計，欲歸將印，以兵屬太尉。使人報呂產及諸呂老人，或以為便，或曰不便，計猶豫未有所決。呂祿信酈寄，時與出游獵。過其姑呂媭，媭大怒，曰：「若為將而棄軍，呂氏今無處矣。」乃悉出珠玉寶器散堂下，曰：「毋為他人守也」"},{"paragraph_id":"c-shiji-009-lvhou:p029","quote":"朱虛侯已殺產，帝命謁者持節勞朱虛侯。朱虛侯欲奪節信，謁者不肯，朱虛侯則從與載，因節信馳走，斬長樂衛尉呂更始。還，馳入北軍，報太尉。太尉起，拜賀朱虛侯曰：「所患獨呂產，今已誅，天下定矣。」遂遣人分部悉捕諸呂男女，無少長皆斬之。辛酉，捕斬呂祿，而笞殺呂媭。使人誅燕王呂通，而廢魯王偃。壬戌，以帝太傅食其復為左丞相。戊辰，徙濟川王王梁，立趙幽王子遂為趙王。遣朱虛侯章以誅諸呂氏事告齊王，令罷兵。灌嬰兵亦罷滎陽而歸。"}],"rationale":"所列漢初諸王分封、平呂及接任敘事中暫定同指；同名不作全庫匹配，匿名者不補未見姓名，仍待異源覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-009-lvhou:p009","text":"太后欲王呂氏，先立孝惠後宮子彊為淮陽王，子不疑為常山王，子山為襄城侯，子朝為軹侯，子武為壺關侯。太后風大臣，大臣請立酈侯呂台為呂王，太后許之。建成康侯釋之卒，嗣子有罪，廢，立其弟呂祿為胡陵侯，續康侯後。二年，常山王薨，以其弟襄城侯山為常山王，更名義。十一月，呂王台薨，謚為肅王，太子嘉代立為王。三年，無事。四年，封呂媭為臨光侯，呂他為俞侯，呂更始為贅其侯，呂忿為呂城侯，及諸侯丞相五人。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-009-lvhou:m009-0000","start":0,"end":2,"surface":"太后","kind":"person","person_id":"cbr-p000717","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m009-0009","start":9,"end":11,"surface":"孝惠","kind":"person","person_id":"cbr-p000713","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m009-0013","start":13,"end":15,"surface":"子彊","kind":"person","person_id":"cbr-p000838","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m009-0021","start":21,"end":23,"surface":"不疑","kind":"person","person_id":"cbr-p000839","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m009-0024","start":24,"end":27,"surface":"常山王","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或稱號仍待逐處覆核，不補熟知名字。"},{"id":"c-shiji-009-lvhou:m009-0028","start":28,"end":30,"surface":"子山","kind":"person","person_id":"cbr-p000840","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m009-0035","start":35,"end":37,"surface":"子朝","kind":"person","person_id":"cbr-p000841","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m009-0041","start":41,"end":43,"surface":"子武","kind":"person","person_id":"cbr-p000842","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m009-0048","start":48,"end":50,"surface":"太后","kind":"person","person_id":"cbr-p000717","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m009-0058","start":58,"end":62