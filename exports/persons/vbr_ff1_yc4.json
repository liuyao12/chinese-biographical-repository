,"family_paths":[],"life_events":[{"id":"le-shiji112-p007-vbr_ff1_yc4","person_id":"vbr_ff1_yc4","event_type":"death","status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-112-pingjin","source_id":"s-shiji112-pingjin","paragraph_id":"c-shiji-112-pingjin:p007","quote":"弘為人意忌，外寬內深。諸嘗與弘有卻者，雖詳與善，陰報其禍。殺主父偃，徙董仲舒於膠西，皆弘之力也。食一肉脫粟之飯。故人所善賓客，仰衣食，弘奉祿皆以給之，家無所餘。士亦以此賢之。","person_mention_id":"c-shiji-112-pingjin:m007-0030"}],"interpretation_note":"殺主父偃明記死亡，行文位置不作公孫弘任官年；續核本篇主父偃敘事。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"mentions":[{"id":"c-shiji-112-pingjin:m007-0030","start":30,"end":33,"surface":"主父偃","kind":"person","person_id":"vbr_ff1_yc4","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p007","chapter_id":"c-shiji-112-pingjin"},{"id":"c-shiji-112-pingjin:m010-0000","start":0,"end":3,"surface":"主父偃","kind":"person","person_id":"vbr_ff1_yc4","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p010","chapter_id":"c-shiji-112-pingjin"},{"id":"c-shiji-112-pingjin:m011-0000","start":0,"end":1,"surface":"臣","kind":"person","person_id":"vbr_ff1_yc4","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p011","chapter_id":"c-shiji-112-pingjin"},{"id":"c-shiji-112-pingjin:m011-0036","start":36,"end":37,"surface":"臣","kind":"person","person_id":"vbr_ff1_yc4","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p011","chapter_id":"c-shiji-112-pingjin"}],"relations":[],"title_holdings":[],"address_assertions":[{"id":"pa-shiji112-002","person_id":"vbr_ff1_yc4","relation":"biographical_origin","place":{"source_name":"齊臨菑","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-112-pingjin","source_id":"s-shiji112-pingjin","paragraph_id":"c-shiji-112-pingjin:p010","quote":"主父偃者，齊臨菑人也。學長短縱橫之術，晚乃學易、春秋、百家言。游齊諸生閒，莫能厚遇也。齊諸儒生相與排擯，不容於齊。家貧，假貸無所得，乃北游燕、趙、中山，皆莫能厚遇，為客甚困。孝武元光元年中，以為諸侯莫足游者，乃西入關見衛將軍。衛將軍數言上，上不召。資用乏，留久，諸公賓客多厭之，乃上書闕下。朝奏，暮召入見。所言九事，其八事為律令，一事諫伐匈奴。其辭曰："}],"source_term":"齊臨菑人","interpretation_note":"保存原文出身，不推現代轄區或出生地。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-112-pingjin:p007","text":"弘為人意忌，外寬內深。諸嘗與弘有卻者，雖詳與善，陰報其禍。殺主父偃，徙董仲舒於膠西，皆弘之力也。食一肉脫粟之飯。故人所善賓客，仰衣食，弘奉祿皆以給之，家無所餘。士亦以此賢之。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-112-pingjin:m007-0000","start":0,"end":1,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m007-0014","start":14,"end":15,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m007-0030","start":30,"end":33,"surface":"主父偃","kind":"person","person_id":"vbr_ff1_yc4","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m007-0035","start":35,"end":38,"surface":"董仲舒","kind":"person","person_id":"lss_951_wm9","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m007-0043","start":43,"end":44,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m007-0067","start":67,"end":68,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"}],"chapter_id":"c-shiji-112-pingjin","book_id":"b-shiji-112","work_id":"w-shiji","source_id":"s-shiji112-pingjin"},{"id":"c-shiji-112-pingjin:p010","text":"主父偃者，齊臨菑人也。學長短縱橫之術，晚乃學易、春秋、百家言。游齊諸生閒，莫能厚遇也。齊諸儒生相與排擯，不容於齊。家貧，假貸無所得，乃北游燕、趙、中山，皆莫能厚遇，為客甚困。孝武元光元年中，以為諸侯莫足游者，乃西入關見衛將軍。衛將軍數言上，上不召。資用乏，留久，諸公賓客多厭之，乃上書闕下。朝奏，暮召入見。所言九事，其八事為律令，一事諫伐匈奴。其辭曰：","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-112-pingjin:m010-0000","start":0,"end":3,"surface":"主父偃","kind":"person","person_id":"vbr_ff1_yc4","status":"contextual_provisional"},{"id":"c-shiji-112-p