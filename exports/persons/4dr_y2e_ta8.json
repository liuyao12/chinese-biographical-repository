，澹臺子羽居楚，子夏居西河，子貢終於齊。如田子方、段干木、吳起、禽滑釐之屬，皆受業於子夏之倫，為王者師。是時獨魏文侯好學。后陵遲以至于始皇，天下并爭於戰國，懦術既絀焉，然齊魯之閒，學者獨不廢也。於威、宣之際，孟子、荀卿之列，咸遵夫子之業而潤色之，以學顯於當世。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m002-0001","start":1,"end":3,"surface":"孔子","kind":"person","person_id":"fp6_ia6_7yw","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m002-0006","start":6,"end":11,"surface":"七十子之徒","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m002-0013","start":13,"end":15,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m002-0028","start":28,"end":31,"surface":"士大夫","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m002-0039","start":39,"end":41,"surface":"子路","kind":"person","person_id":"t7x_2x7_1fc","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m002-0044","start":44,"end":46,"surface":"子張","kind":"person","person_id":"482_ly0_otk","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m002-0049","start":49,"end":53,"surface":"澹臺子羽","kind":"person","person_id":"oxa_rta_lvd","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m002-0056","start":56,"end":58,"surface":"子夏","kind":"person","person_id":"z8l_wje_08d","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m002-0062","start":62,"end":64,"surface":"子貢","kind":"person","person_id":"7c4_6v2_yvm","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m002-0069","start":69,"end":72,"surface":"田子方","kind":"person","person_id":"3lq_wm9_1ov","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m002-0073","start":73,"end":76,"surface":"段干木","kind":"person","person_id":"4dr_y2e_ta8","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m002-0077","start":77,"end":79,"surface":"吳起","kind":"person","person_id":"61h_0sk_4pb","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m002-0080","start":80,"end":83,"sur