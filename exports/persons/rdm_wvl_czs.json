ion_note":"逐單元上下文首讀，不作跨全庫字串規則"},{"id":"c-sanguozhi-023-peiqian:p020:m0025","start":25,"end":28,"surface":"劉仲始","kind":"person","person_id":"cky_knj_wof","status":"contextual_provisional","resolution_note":"逐單元上下文首讀，不作跨全庫字串規則"},{"id":"c-sanguozhi-023-peiqian:p020:m0068","start":68,"end":69,"surface":"余","kind":"person","person_id":"h7h_hrt_880","status":"contextual_provisional","resolution_note":"魚豢曰內作者自指"},{"id":"c-sanguozhi-023-peiqian:p020:m0079","start":79,"end":80,"surface":"徐","kind":"person","person_id":"iy5_kbn_8lt","status":"contextual_provisional","resolution_note":"魚豢論回徐福"},{"id":"c-sanguozhi-023-peiqian:p020:m0080","start":80,"end":81,"surface":"嚴","kind":"person","person_id":"h6y_1yv_a99","status":"contextual_provisional","resolution_note":"魚豢論回嚴幹"},{"id":"c-sanguozhi-023-peiqian:p020:m0099","start":99,"end":100,"surface":"李","kind":"person","person_id":"5fz_7u8_d00","status":"contextual_provisional","resolution_note":"評李義"},{"id":"c-sanguozhi-023-peiqian:p020:m0103","start":103,"end":104,"surface":"張","kind":"person","person_id":"kfo_nh8_to3","status":"contextual_provisional","resolution_note":"評張既"},{"id":"c-sanguozhi-023-peiqian:p020:m0107","start":107,"end":108,"surface":"韓","kind":"person","person_id":"w16_6fw_jhh","status":"contextual_provisional","resolution_note":"評韓宣"},{"id":"c-sanguozhi-023-peiqian:p020:m0111","start":111,"end":112,"surface":"黃","kind":"person","person_id":"rdm_wvl_czs","status":"contextual_provisional","resolution_note":"評黃朗"},{"id":"c-sanguozhi-023-peiqian:p020:m0132","start":132,"end":134,"surface":"游翁","kind":"person","person_id":"n1b_arb_w8t","status":"contextual_provisional","resolution_note":"評游楚"},{"id":"c-sanguozhi-023-peiqian:p020:m0150","start":150,"end":152,"surface":"陸生","kind":"person","person_id":"fpv_2sb_uay","status":"contextual_provisional","resolution_note":"魚豢論引古比擬游楚；史記097 p013/014陸賈安車歌舞酒食游居/與絳侯戲具體相合，首選陸賈，非本源明全名，不建同時交友或全域別名規則。"},{"id":"c-sanguozhi-023-peiqian:p020:m0160","start":160,"end":161,"surface":"梁","kind":"person","person_id":"ef8_jl5_5er","status":"contextual_provisional","resolution_note":"評梁習"},{"id":"c-sanguozhi-023-peiqian:p020:m0161","start":161,"end":162,"surface":"趙","kind":"person","person_id":"9ce_e37_1dc","status":"contextual_provisional","resolution_note":"評趙儼"},{"id":"c-sanguozhi-023-peiqian:p020:m0163","start":163,"end":164,"surface":"裴","kind":"person","person_id":"4ni_4t1_4o9_A","status":"contextual_provisional","resolution_note":"評裴潛"}],"source_position":{"first_line":459,"last_line":463,"source_layer":"pei_annotation","unit_key":"peiqian-unit-20","raw_projection_ref":"source-evidence/sgz023-peiqian/complete-unit-projection.json"},"chapter_id":"c-sanguozhi-023-peiqian","book_id":"b-sanguozhi-023","work_id":"w-sanguozhi","source_id":"s-sanguozhi-023-peiqian-kr214fcafa"},{"id":"c-sanguozhi-023-qing-collation:p001","text":"　魏志卷二十三考證和洽洽獨以冀州土平兵彊○毛本兵彊作民彊必有讒慝間其中者○毛本無必字太祖定荆州○定監本訛作奪今改正天下大器在位與人不可以一節儉也○冊府作不可　以一節論也所謂悅武無震古人之誡也○悅武冊府作玩武臣照　按國語云武不可覿文不可匿覿武無震匿文不祥　此必引此語自當作覿悅玩二字俱非明帝時為尚書注召李叔才鄉閭之間○叔宋本作淑　又注莫不頼劭顧歎之榮○毛本作顧採　又注劭宗人許栩沉没榮利致位司徒○何焯曰按　後漢書言劭從祖敬敬子訓訓子相並為三公相以　能諂事宦官故自致台司封侯數遣請劭劭惡其薄　行終不候之栩疑相之誤也靈帝初為三公者亦有　許栩史不詳其何所人建寧元年由大鴻臚為司空　二年免時許訓為司徒四年訓免橋玄代之是年栩　代玄為司徒名輩在子將之前蓋先賢傳失之也常林峕弟靜紹封注未是夫窮理盡性陶冶變化之實　論也○是冊府作臻　又注於叙人才不能寛○太平御覽作至於叙人才　不能寛大杜襲彊識博聞○元本彊上有粲字嘗獨見至於夜半○元本嘗上多一襲字時將軍許攸擁部曲不附太祖○此非南陽許攸也太　平御覽作許遊增邑三百戸○毛本無戸字趙儼太祖遣將軍劉柱將二千人當須到乃發遣○二　千人下通鑑有往字舊兵既少東兵未到○東兵監本誤䇿兵今改正如有緩救之戮余為諸軍當之○諸軍通鑑作諸君便作地道箭飛書與仁○箭字上太平御覽多射字孫權冦邊征東大將軍曹休統五州軍禦之○監本作　曹仁臣明楷按曹休傳云帝征孫權以休為征東大　將軍仁未嘗為征東也監本誤今改正轉大司馬軍師入為大司農○大司馬監本訛作大司　農今改正裴潛諡曰貞侯注潛為人材博有雅要容○要字疑衍咸熙中為尚書僕射注餘幹等四人載之於後○監本　作徐韓等四人臣明楷按此即指下嚴幹李義韓宣　黃朗等四人也且上文已云徐福事在諸葛亮傳不　應又云徐韓監本誤今改正　又注馮翊甲族桓田吉郭○桓田監本誤桓甲今改　正　魏志卷二十三考證","text_layer":"witness_appended_qing_siku_collation","annotation_status":"in_progress","mentions":[{"id":"c-sanguozhi-023-qing-collation:p001:m0009","start":9,"end":11,"surface":"和洽","kind":"person","person_id":"x6x_j37_rl0","status":"contextual_provisional","resolution_note":"考證人物提及，未以後出按語重寫主文"},{"id":"c-sanguozhi-023-qing-collation:p001:m0011","start":11,"end":12,"surface":"洽","kind":"per