-zizhitongjian-094-xiyang-kinship:line126","chapter_id":"c-zizhitongjian-094-xiyang-kinship"},{"id":"c-zizhitongjian-094-xiyang-kinship:line126:m0085","start":85,"end":87,"surface":"滕含","kind":"person","person_id":"9ef_a32_155","paragraph_id":"c-zizhitongjian-094-xiyang-kinship:line126","chapter_id":"c-zizhitongjian-094-xiyang-kinship"}],"relations":[],"title_holdings":[{"id":"th-phase4-t-002","person_id":"9ef_a32_155","title":"建成長史","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"work_id":"w-zizhitongjian","book_id":"b-zizhitongjian-094","source_id":"s-zizhitongjian-094-xiyang-kinship","chapter_id":"c-zizhitongjian-094-xiyang-kinship","paragraph_id":"c-zizhitongjian-094-xiyang-kinship:line126","person_mention_id":"c-zizhitongjian-094-xiyang-kinship:line126:m0016","quote_passage_ref":"data/corpus/zizhitongjian/094.json"}],"attestations":[{"id":"th-phase4-t-002:a001","paragraph_id":"c-zizhitongjian-094-xiyang-kinship:line126","start":12,"end":16,"surface":"建成長史","person_mention_id":"c-zizhitongjian-094-xiyang-kinship:line126:m0016","usage":"narrative","date_expression":"二月，丙戌","normalized_date":{"era":"CE","era_year":329,"year":329,"year_numbering":"astronomical","precision":"year","calendar":"chinese_civil","status":"editorial_provisional","source_expression":"二月，丙戌","original_quote":"二月，丙戌，諸軍攻石頭。建成長史滕含擊蘇逸，大破之。蘇碩帥驍勇數百，渡准而戰，溫嶠擊斬之。韓晃等懼，以其眾就張健於曲阿，門隘不得出，更相蹈藉，死者萬數。西軍獲蘇逸，斬之。滕含部將曹據抱帝奔溫嶠船，群臣見帝，頓首號泣請罪。殺西陽王羕，並其二子播、充、孫崧及彭城王雄。陶侃與任讓有舊，為請其死。帝曰：「是殺吾侍中、右衛者，不可赦也。」乃殺之。司徒導入石頭，令取故節，陶侃笑曰：「蘇武節似不如是。」導有慚色。丁亥，大赦。","evidence":[{"work_id":"w-zizhitongjian","book_id":"b-zizhitongjian-094","source_id":"s-zizhitongjian-094-xiyang-kinship","chapter_id":"c-zizhitongjian-094-xiyang-kinship","paragraph_id":"c-zizhitongjian-094-xiyang-kinship:line126","person_mention_id":"c-zizhitongjian-094-xiyang-kinship:line126:m0016","quote_passage_ref":"data/corpus/zizhitongjian/094.json"}],"references":[{"title":"固定修訂原行紀年語境","url":"https://zh.wikisource.org/w/index.php?title=資治通鑑/卷094&oldid=2312212","quote":" 顯宗成皇帝上之下咸和四年（己丑、公元三二九年）","scope":"calendar_context_layer","image_verified":false}],"calendar_context":{"context_id":"cal-context-phase5-002","event_anchor":{"paragraph_id":"c-zizhitongjian-094-xiyang-kinship:line126","start":12,"end":16,"surface":"建成長史"}},"rationale":"年數依獨立固定來源語境；僅適用精確事件錨點，正文不補字。","reviewer":"Codex","human_reviewed":false,"model":null}}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"來源限定用稱或任授；不把未載紀年補成單年，不以死亡結束全部職爵。兼領與職掌按原詞保留。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"calendar_context_assertions":[{"id":"cal-context-phase5-002","anchor":{"paragraph_id":"c-zizhitongjian-094-xiyang-kinship:line126","start":0,"end":5,"surface":"二月，丙戌"},"original_expression":"二月，丙戌","normalized_date":{"year":329,"calendar":"chinese_civil","precision":"year","status":"editorial_provisional"},"source":{"file":"sources/calendar-context/parallel-zztj094.wikitext","sha256":"2c7a63d04baed933030f750f5983e99ffbfb1aa97f1cef693e1ac5632e41b24a","revision_id":2312212,"url":"https://zh.wikisource.org/w/index.php?title=資治通鑑/卷094&oldid=2312212"},"raw_line":126,"full_paragraph":"二月，丙戌，諸軍攻石頭。建成長史滕含擊蘇逸，大破之。蘇碩帥驍勇數百，渡准而戰，溫嶠擊斬之。韓晃等懼，以其眾就張健於曲阿，門隘不得出，更相蹈藉，死者萬數。西軍獲蘇逸，斬之。滕含部將曹據抱帝奔溫嶠船，群臣見帝，頓首號泣請罪。殺西陽王羕，並其二子播、充、孫崧及彭城王雄。陶侃與任讓有舊，為請其死。帝曰：「是殺吾侍中、右衛者，不可赦也。」乃殺之。司徒導入石頭，令取故節，陶侃笑曰：「蘇武節似不如是。」導有慚色。丁亥，大赦。","context_lines":[{"line":112,"text":"是歲，成漢獻王驤卒，其子征東將軍壽以喪還成都。成主雄以李玝為征北將軍、梁州刺史，代壽屯晉壽。","sha256":"bbc84e24bad78393ad992e885329457dc91d52c87cee989574e493012bda59e4"},{"line":113,"text":"<BR>","sha256":"9fb6a48344093ca5ffc4332132a9b093721a9abac69679811d756ba0a909f9cf"},{"line":114,"text":" 顯宗成皇帝上之下咸和四年（己丑、公元三二九年）","sha256":"15050f4ea6f408ac1b94ec8dacd1d626a6b62bd35404efc9b34bc8073dfba86b"},{"line":115,"text":"<BR>","sha256":"9fb6a48344093ca5ffc4332132a9b093721a9abac69679811d756ba0a909f9cf"},{"line":116,"text":"春，正月，光祿大夫陸曄及弟尚書左僕射玩說匡術，以苑城附於西軍；百官皆赴之，推曄督宮城軍事。陶侃命毛寶守南城，鄧岳守西城。","sha256":"c0d8718b054be6666d5f567afb62c9ea79b66cb26802453dc60b902164f783b8"},{"line":117,"text":"<BR>","sha256":"9fb6a48344093ca5ffc4332132a9b093721a9abac69679811d756ba0a909f9cf"},{"line":118,"text":"右衛將軍齊超、侍中鐘雅與建康令管旆等謀奉帝出赴西軍；事洩，蘇逸使其將平原任讓將兵入宮收超、雅。帝抱持悲泣曰：「還我侍中、右衛！」讓奪而殺之。初，讓少無行，太常華恆為本州大中正，黜其品。及讓為蘇峻將，乘勢多所誅殺，見恆輒恭敬，不敢縱暴。及鐘、劉之死，蘇逸欲並殺恆，讓盡心救衛，恆乃得免。","sha256":"e1157eab74ff0b2ff4b09891be6e292632f37085c4fc44ae24df8d5137dca679"},{"line":119,"text":"<BR>","sha256":"9fb6a48344093ca5ffc4332132a9b093721a9abac69679811d756ba0a909f9cf"},{"line":120,"text":"冠軍將軍趙胤遣部將甘苗擊祖約於歷陽，戊辰，約夜帥左右數百人奔後趙，其將牽騰帥眾出降。","sha256":"bafef1596f9a8359d0a389f979cfcfd27436641d836eb0cca89d453eb47f40a8"},{"line":121,"text":"<BR>","sha256":"9fb6a48344093ca5ffc4332132a9b093721a9abac69679811d756ba0a909f9cf"},{"line":122,"text":"蘇逸、蘇碩、韓晃並力攻台城，焚太極東堂及秘閣，毛寶登城，射殺數十人。晃謂寶曰：「君名勇果，何不出鬥？」寶曰：「君名健將，何不入鬥？」晃笑而退。","sha256":"a28d3b343e0c43602ce54d0c91b08eea75dde7361a92e8187f22ed2083775fb6"},{"line":123,"text":"<BR>","sha256":"9fb6a48344093ca5ffc4332132a9b093721a9abac69679811d756ba0a909f9cf"},{"line":124,"text":"趙太子熙聞趙主曜被擒，大懼，與南陽王胤謀西保秦州。尚書胡勳曰：「今雖喪君，境土尚完，將士不叛，且當並力拒之；力不能拒，走未晚也。」胤怒，以為沮眾，斬之，遂帥百官奔上邽，諸征鎮亦皆棄所守從之，關中大亂。將軍蔣英、辛恕擁眾數十萬據長安，遣使降後趙，後趙遣石生帥洛陽之眾赴之。","sha256":"84f2ed706b5cb8f8f2b739d1a1ff022158138a3c6d48d9390e96c5836b048e1d"},{"line":125,"text":"<BR>","sha256":"9fb6a48344093ca5ffc4332132a9b093721a9abac69679811d756ba0a909f9cf"},{"line":126,"text":"二月，丙戌，諸軍攻石頭。建成長史滕含擊蘇逸，大破之。蘇碩帥驍勇數百，渡准而戰，溫嶠擊斬之。韓晃等懼，以其眾就張健於曲阿，門隘不得出，更相蹈藉，死者萬數。西軍獲蘇逸，斬之。滕含部將曹據抱帝奔溫嶠船，群臣見帝，頓首號泣請罪。殺西陽王羕，並其二子播、充、孫崧及彭城王雄。陶侃與任讓有舊，為請其死。帝曰：「是殺吾侍中、右衛者，不可赦也。」乃殺之。司徒導入石頭，令取故節，陶侃笑曰：「蘇武節似不如是。」導有慚色。丁亥，大赦。","sha256":"950e50f8c9d7df345359d5ad82385ac08c4389ba97996ceba197f5c570c0fca0"},{"line":127,"text":"<BR>","sha256":"9fb6a48344093ca5ffc4332132a9b093721a9abac69679811d756ba0a909f9cf"},{"line":128,"text":"張健疑弘徽等貳於己，皆殺之，帥舟師自延陵將入吳興。乙未，揚烈將軍王允之與戰，大破之，獲男女萬餘口。健復與韓晃、馬雄等輕軍西趨故鄣，郗鑒遣軍李閎追之，及於平陵山，皆斬之。","sha256":"ae13b938ec291369a15279e9dfdd9c5e27ca50c2f0c099cb0459ec252006df8f"},{"line":129,"text":"<BR>","sha256":"9fb6a48344093ca5ffc4332132a9b093721a9abac69679811d756ba0a909f9cf"},{"line":130,"text":"是時宮闕灰燼，以建平園為宮。溫嶠欲遷都豫章，三吳之豪請都會稽，二論紛紜未決。司徒導曰：「孫仲謀、劉玄德俱言：『建康，王者之宅。』古之帝王，不必以豐儉移都。苟務本節用，何憂凋弊！若農事不修，則樂土為墟矣。且北寇遊魂，伺我之隙，一旦示弱，竄於蠻越，求之望實，懼非良計。今特宜鎮之以靜，群情自安。」由是不復徙都。以褚翜為丹楊尹。時兵火之後，民物凋殘，翜收集散亡，京邑遂安。","sha256":"6e31ca34da9f5c636d35c1c95f34fbb65ddf63921feba2cb2089e006992d4925"}],"basis":{"kind":"digital_editorial_year_heading","reference":"094-year-context.json"},"scope":{"start":0,"end":201,"quote":"二月，丙戌，諸軍攻石頭。建成長史滕含擊蘇逸，大破之。蘇碩帥驍勇數百，渡准而戰，溫嶠擊斬之。韓晃等懼，以其眾就張健於曲阿，門隘不得出，更相蹈藉，死者萬數。西軍獲蘇逸，斬之。滕含部將曹據抱帝奔溫嶠船，群臣見帝，頓首號泣請罪。殺西陽王羕，並其二子播、充、孫崧及彭城王雄。陶侃與任讓有舊，為請其死。帝曰：「是殺吾侍中、右衛者，不可赦也。」乃殺之。司徒導入石頭，令取故節，陶侃笑曰：「蘇武節似不如是。」導有慚色。"},"reviewer":"Codex","human_reviewed":false,"image_verified":false,"model":null,"paratext":{"layer":"digital_editorial_paratext","heading_line":114,"raw_heading":" 顯宗成皇帝上之下咸和四年（己丑、公元三二九年）","heading_sha256":"15050f4ea6f408ac1b94ec8dacd1d626a6b62bd35404efc9b34bc8073dfba86b","era":"咸和","regnal_year":4,"sexagenary_year":"己丑","numeral_ce":329,"heading_is_body":false}}],"date_normalizations":[{"era":"CE","era_year":329,"year":329,"year_numbering":"astronomical","precision":"year","calendar":"chinese_civil","status":"editorial_provisional","source_expression":"二月，丙戌","original_quote":"二月，丙戌，諸軍攻石頭。建成長史滕含擊蘇逸，大破之。蘇碩帥驍勇數百，渡准而戰，溫嶠擊斬之。韓晃等懼，以其眾就張健於曲阿，門隘不得出，更相蹈藉，死者萬數。西軍獲蘇逸，斬之。滕含部將曹據抱帝奔溫嶠船，群臣見帝，頓首號泣請罪。殺西陽王羕，並其二子播、充、孫崧及彭城王雄。陶侃與任讓有舊，為請其死。帝曰：「是殺吾侍中、右衛者，不可赦也。」乃殺之。司徒導入石頭，令取故節，陶侃笑曰：「蘇武節似不如是。」導有慚色。丁亥，大赦。","evidence":[{"work_id":"w-zizhitongjian","book_id":"b-zizhitongjian-094","source_id":"s-zizhitongjian-094-xiyang-kinship","chapter_id":"c-zizhitongjian-094-xiyang-kinship","paragraph_id":"c-zizhitongjian-094-xiyang-kinship:line126","person_mention_id":"c-zizhitongjian-094-xiyang-kinship:line126:m0016","quote_passage_ref":"data/corpus/zizhitongjian/094.json"}],"references":[{"title":"固定修訂原行紀年語境","url":"https://zh.wikisource.org/w/index.