id":"eq-shiji111-household-wangfuren","person_ids":["3eo_u7e_pxx"],"canonical_person_id":"3eo_u7e_pxx","status":"contextual_provisional","scope":"cross_chapter","chapter_ids":["c-shiji-111-wei-huo","c-shiji-049-waiqi","c-shiji-060-sanwang","c-shiji-126-huaji"],"rationale":"卷49趙之王夫人幸武帝、生子為齊王，卷60褚補明趙人王夫人生閎、求王雒陽而改齊、卒賜齊王太后；卷126褚補王夫人臨病求子王洛陽、改齊及卒稱齊王太后，為同一具體母子與問封故事。卷111方幸王夫人、衛青奉五百金為其親壽與卷126同敘事暫接此人。卷111獻策者甯乘、卷126東郭先生各存，不因王夫人同指就合併獻策者或統一軍役年份與郡都尉／東海都尉。她與景帝王夫人（武帝之母）分開；齊王太后為卒後稱，不補生前持號。","evidence":[{"chapter_id":"c-shiji-111-wei-huo","source_id":"s-shiji111-wei-huo","paragraph_id":"c-shiji-111-wei-huo:p009","mention_ids":["c-shiji-111-wei-huo:m009-0012","c-shiji-111-wei-huo:m009-0058","c-shiji-111-wei-huo:m009-0078"],"quote_passage_ref":"data/corpus/shiji/111.json"},{"chapter_id":"c-shiji-049-waiqi","source_id":"s-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p030","mention_ids":["c-shiji-049-waiqi:m030-0008"],"quote_passage_ref":"data/corpus/shiji/049.json"},{"chapter_id":"c-shiji-049-waiqi","source_id":"s-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p031","mention_ids":["c-shiji-049-waiqi:m031-0000"],"quote_passage_ref":"data/corpus/shiji/049.json"},{"chapter_id":"c-shiji-060-sanwang","source_id":"s-shiji-060-sanwang","paragraph_id":"c-shiji-060-sanwang:p020","mention_ids":["c-shiji-060-sanwang:m020-0000","c-shiji-060-sanwang:m020-0056","c-shiji-060-sanwang:m020-0094","c-shiji-060-sanwang:m020-0154","c-shiji-060-sanwang:m020-0207","c-shiji-060-sanwang:m020-0223","c-shiji-060-sanwang:m020-0255","c-shiji-060-sanwang:m020-0258"],"quote_passage_ref":"data/corpus/shiji/060.json"},{"chapter_id":"c-shiji-126-huaji","source_id":"s-shiji126-huaji","paragraph_id":"c-shiji-126-huaji:p019","mention_ids":["c-shiji-126-huaji:m019-0106","c-shiji-126-huaji:m019-0194"],"quote_passage_ref":"data/corpus/shiji/126.json"},{"chapter_id":"c-shiji-126-huaji","source_id":"s-shiji126-huaji","paragraph_id":"c-shiji-126-huaji:p020","mention_ids":["c-shiji-126-huaji:m020-0000","c-shiji-126-huaj