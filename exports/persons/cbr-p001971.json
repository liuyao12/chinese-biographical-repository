{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p001971","identity_policy":"contextual_provisional","person_ids":["cbr-p001971"],"persons":[{"id":"cbr-p001971","label":"公孫衍（楚篇合秦議者）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"公孫衍","mention_ids":["c-shiji-040-chu:m075-0063","c-shiji-040-chu:m075-0082"]}],"evidence":[{"mention_id":"c-shiji-040-chu:m075-0063","chapter_id":"c-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p075","quote":"公孫衍"},{"mention_id":"c-shiji-040-chu:m075-0082","chapter_id":"c-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p075","quote":"公孫衍"}]}],"mentions":[{"id":"c-shiji-040-chu:m075-0063","start":63,"end":66,"surface":"公孫衍","kind":"person","person_id":"cbr-p001971","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p075","chapter_id":"c-shiji-040-chu"},{"id":"c-shiji-040-chu:m075-0082","start":82,"end":85,"surface":"公孫衍","kind":"person","person_id":"cbr-p001971","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p075","chapter_id":"c-shiji-040-chu"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji040-069","person_id":"cbr-p001971","surfaces":["公孫衍"],"scope":"same_chapter","chapter_ids":["c-shiji-040-chu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-040-chu:p075","quote":"二十〈六〉年，齊湣王欲爲從長，惡楚之與秦合，乃使使遺楚王書曰：「寡人患楚之不察於尊名也。今秦惠王死，武王立，張儀走魏，樗裏疾、公孫衍用，而楚事秦。夫樗裏疾善乎韓，而公孫衍善乎魏；楚必事秦，韓、魏恐，必因二人求合於秦，則燕、趙亦宜事秦。四國爭事秦，則楚爲郡縣矣。王何不與寡人并力收韓、魏、燕、趙，與爲從而尊周室，以案兵息民，令於天下？莫敢不樂聽，則王名成矣。王率諸侯并伐，破秦必矣。王取武關、蜀、漢之地，私呉、越之富而擅江海之利，韓、魏割上黨，西薄函谷，則楚之彊百萬也。且王欺於張儀，亡地漢中，兵銼藍田，天下莫不代王懷怒。今乃欲先事秦！願大王孰計之。」"}],"rationale":"本篇具名出使、合秦或說楚事件內暫接，未與他篇同名候選批量合併；短稱及未見名字仍待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-040-chu:p075","text":"二十〈六〉年，齊湣王欲爲從長，惡楚之與秦合，乃使使遺楚王書曰：「寡人患楚之不察於尊名也。今秦惠王死，武王立，張儀走魏，樗裏疾、公孫衍用，而楚事秦。夫樗裏疾善乎韓，而公孫衍善乎魏；楚必事秦，韓、魏恐，必因二人求合於秦，則燕、趙亦宜事秦。四國爭事秦，則楚爲郡縣矣。王何不與寡人并力收韓、魏、燕、趙，與爲從而尊周室，以案兵息民，令於天下？莫敢不樂聽，則王名成矣。王率諸侯并伐，破秦必矣。王取武關、蜀、漢之地，私呉、越之富而擅江海之利，韓、魏割上黨，西薄函谷，則楚之彊百萬也。且王欺於張儀，亡地漢中，兵銼藍田，天下莫不代王懷怒。今乃欲先事秦！願大王孰計之。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m075-0007","start":7,"end":10,"surface":"齊湣王","kind":"person","person_id":"cbr-p002034","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m075-0026","start":26,"end":28,"surface":"楚王","kind":"person","person_id":"cbr-p001923","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m075-0045","start":45,"end":48,"surface":"秦惠王","kind":"person","person_id":"cbr-p000290","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m075-0050","start":50,"end":52,"surface":"武王","kind":"person","person_id":"cbr-p000480","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m075-0054","start":54,"end":56,"surface":"張儀","kind":"person","person_id":"cbr-p000464","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m075-0059","start":59,"end":62,"surface":"樗裏疾","kind":"person","person_id":"cbr-p001972","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m075-0063","start":63,"end":66,"surface":"公孫衍","kind":"person","person_id":"cbr-p001971","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m075-0074","start":74,"end":77,"surface":"樗裏疾","kind":"person","person_id":"cbr-p001972","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m075-0082","start":82,"end":85,"surface":"公孫衍","kind":"person","person_id":"cbr-p001971","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m075-0130","start":130,"end":131,"surface":"王","kind":"person","person_id":"cbr-p001923","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m075-0173","start":173,"end":174,"surface":"王","kind":"person","person_id":"cbr-p001923","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m075-0178","start":178,"end":179,"surface":"王","kind":"person","person_id":"cbr-p001923","status":"contextual_provisional"},{"id":"c-sh