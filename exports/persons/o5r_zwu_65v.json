{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"o5r_zwu_65v","canonical_person_id":"o5r_zwu_65v","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["o5r_zwu_65v"],"persons":[{"id":"o5r_zwu_65v","label":"鄧光（大宛列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"鄧光","mention_ids":["c-shiji-123-dayuan:m032-0089"]}],"evidence":[{"mention_id":"c-shiji-123-dayuan:m032-0089","chapter_id":"c-shiji-123-dayuan","paragraph_id":"c-shiji-123-dayuan:p032","quote":"鄧光"}]}],"source_mention_summary":[{"source_id":"s-shiji123-dayuan","work_id":"w-shiji","book_id":"b-shiji-123","chapter_id":"c-shiji-123-dayuan","mention_count":1,"mention_ids":["c-shiji-123-dayuan:m032-0089"],"paragraph_ids":["c-shiji-123-dayuan:p032"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji123-dayuan"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-123-dayuan:m032-0089","start":89,"end":91,"surface":"鄧光","kind":"person","person_id":"o5r_zwu_65v","status":"contextual_provisional","paragraph_id":"c-shiji-123-dayuan:p032","chapter_id":"c-shiji-123-dayuan"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-123-dayuan:p032","text":"其夏，漢亡浞野之兵二萬餘於匈奴。公卿及議者皆願罷擊宛軍，專力攻胡。天子已業誅宛，宛小國而不能下，則大夏之屬輕漢，而宛善馬絕不來，烏孫、侖頭易苦漢使矣，為外國笑。乃案言伐宛尤不便者鄧光等，赦囚徒材官，益發惡少年及邊騎，歲餘而出敦煌者六萬人，負私從者不與。牛十萬，馬三萬餘匹，驢騾橐它以萬數。多齎糧，兵弩甚設，天下騷動，傳相奉伐宛，凡五十餘校尉。宛王城中無井，皆汲城外流水，於是乃遣水工徙其城下水空以空其城。益發戍甲卒十八萬，酒泉、張掖北，置居延、休屠以衛酒泉，而發天下七科適，及載糒給貳師。轉車人徒相連屬至敦煌。而拜習馬者二人為執驅校尉，備破宛擇取其善馬云。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-123-dayuan:m032-0005","start":5,"end":7,"surface":"浞野","kind":"person","person_id":"z0l_1wp_de1","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m032-0033","start":33,"end":35,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m032-0089","start":89,"end":91,"surface":"鄧光","kind":"person","person_id":"o5r_zwu_65v","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m032-0171","start":171,"end":173,"surface":"宛王","kind":"person","person_id":"2l2_58b_q4i","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m032-0257","start":257,"end":262,"surface":"習馬者二人","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-123-dayuan","book_id":"b-shiji-123","work_id":"w-shiji","source_id":"s-shiji123-dayuan"}],"sources":[{"chapter_id":"c-shiji-123-dayuan","work_id":"w-shiji","book_id":"b-shiji-123","source_id":"s-shiji123-dayuan","source":{"title":"史記／卷123","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷123","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷123&oldid=8736799","revision_id":8736799,"accessed_on":"2026-10-11","extent":"固定修訂全文39段，包括末段索隱述贊。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"去header2、現代節標、blockquote排版及分類；維基連結保留顯示文字，原字未轉換，未核影像。","note":"末段索隱述贊另分層。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical"}}
