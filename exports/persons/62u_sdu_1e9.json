{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"62u_sdu_1e9","canonical_person_id":"62u_sdu_1e9","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["62u_sdu_1e9"],"persons":[{"id":"62u_sdu_1e9","label":"李斯（平津侯主父列傳上書候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"李斯","mention_ids":["c-shiji-112-pingjin:m012-0155"]}],"evidence":[{"mention_id":"c-shiji-112-pingjin:m012-0155","chapter_id":"c-shiji-112-pingjin","paragraph_id":"c-shiji-112-pingjin:p012","quote":"李斯"}]}],"source_mention_summary":[{"source_id":"s-shiji112-pingjin","work_id":"w-shiji","book_id":"b-shiji-112","chapter_id":"c-shiji-112-pingjin","mention_count":1,"mention_ids":["c-shiji-112-pingjin:m012-0155"],"paragraph_ids":["c-shiji-112-pingjin:p012"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji112-pingjin"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-112-pingjin:m012-0155","start":155,"end":157,"surface":"李斯","kind":"person","person_id":"62u_sdu_1e9","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p012","chapter_id":"c-shiji-112-pingjin"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-112-pingjin:p012","text":"《司馬法》曰：「國雖大，好戰必亡；天下雖平，忘戰必危。」天下既平，天子大凱，春蒐秋狝，諸侯春振旅，秋治兵，所以不忘戰也。且夫怒者逆德也，兵者凶器也，爭者末節也。古之人君一怒必伏尸流血，故聖王重行之。夫務戰勝窮武事者，未有不悔者也。昔秦皇帝任戰勝之威，蠶食天下，并吞戰國，海內為一，功齊三代。務勝不休，欲攻匈奴，李斯諫曰：「不可。夫匈奴無城郭之居，委積之守，遷徙鳥舉，難得而制也。輕兵深入，糧食必絕；踵糧以行，重不及事。得其地不足以為利也，遇其民不可役而守也。勝必殺之，非民父母也。靡獘中國，快心匈奴，非長策也。」秦皇帝不聽，遂使蒙恬將兵攻胡，辟地千里，以河為境。地固澤（咸）鹵，不生五穀。然後發天下丁男以守北河。暴兵露師十有餘年，死者不可勝數，終不能踰河而北。是豈人眾不足，兵革不備哉？其勢不可也。又使天下蜚芻輓粟，起於黃、腄、瑯邪負海之郡，轉輸北河，率三十鐘而致一石。男子疾耕不足於糧馕，女子紡績不足於帷幕。百姓靡敝，孤寡老弱不能相養，道路死者相望，蓋天下始畔秦也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-112-pingjin:m012-0116","start":116,"end":119,"surface":"秦皇帝","kind":"person","person_id":"ny0_svo_ifn","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m012-0155","start":155,"end":157,"surface":"李斯","kind":"person","person_id":"62u_sdu_1e9","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m012-0256","start":256,"end":259,"surface":"秦皇帝","kind":"person","person_id":"ny0_svo_ifn","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m012-0264","start":264,"end":266,"surface":"蒙恬","kind":"person","person_id":"8kz_4ad_0fq","status":"contextual_provisional"}],"chapter_id":"c-shiji-112-pingjin","book_id":"b-shiji-112","work_id":"w-shiji","source_id":"s-shiji112-pingjin"}],"sources":[{"chapter_id":"c-shiji-112-pingjin","work_id":"w-shiji","book_id":"b-shiji-112","source_id":"s-shiji112-pingjin","source":{"title":"史記／卷112","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷112","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷112&oldid=2089420","revision_id":2089420,"accessed_on":"2026-10-11","extent":"固定數位見證31段；末三段分為後附詔書、班固贊及索隱述贊。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"去header2、__TOC__與現代節標題；去行首冒號排版符號，保留正文、異體、方括弧與圓括弧校字。未核底本影像。","note":"太皇太后詔及班固贊均按見證附載分層，不自行確認編入者。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normal