hip_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-wu062-huzong-0","subject_person_id":"qfk_09j_fhe","object_person_id":"buv_kye_kd0","predicate":"mother","qualifiers":{"source_term":"母將避難江東"},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-062","chapter_id":"c-sanguozhi-062-huzong","source_id":"s-sanguozhi-062-huzong","paragraph_id":"c-sanguozhi-062-huzong:line022","quote":"　　胡綜字偉則。汝南固始人也。少孤，母將避難江東。孫策領會稽太守，綜年十四，為門下循行，留吳與孫權共讀書。策薨，權為討虜將軍，以綜為金曹從事，從討黃祖，拜鄂長。權為將軍，都京，召綜還，為書部。與是儀、徐詳俱典軍國密事。劉備下白帝，權以見兵少，使綜料諸縣，得六千人，立解煩兩部，詳領左部、綜領右部督。吳將晉宗叛歸魏，魏以宗為蘄春太守，去江數百里，數為寇害。權使綜與賀齊輕行掩襲，生虜得宗。加建武中郎將。魏拜權為吳王，封綜、儀、詳皆為亭侯。","subject_person_mention_id":"c-sanguozhi-062-huzong:line022:m0002","object_person_mention_id":"c-sanguozhi-062-huzong:line022:m0018"}],"interpretation_note":"以此來源所述兩端為據。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-062-huzong:line022:m0018","surface":"母","start":18,"end":19,"kind":"person","person_id":"buv_kye_kd0","status":"contextual_provisional","interpretation_note":"按本段具名及前後親稱、官職定位。","paragraph_id":"c-sanguozhi-062-huzong:line022","chapter_id":"c-sanguozhi-062-huzong"}],"relations":[{"id":"a-wu062-huzong-0","subject_person_id":"qfk_09j_fhe","object_person_id":"buv_kye_kd0","predicate":"mother","qualifiers":{"source_term":"母將避難江東"},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-062","chapter_id":"c-sanguozhi-062-huzong","source_id":"s-sanguozhi-062-huzong","paragraph_id":"c-sanguozhi-062-huzong:line022","quote":"　　胡綜字偉則。汝南固始人也。少孤，母將避難江東。孫策領會稽太守，綜年十四，為門下循行，留吳與孫權共讀書。策薨，權為討虜將軍，以綜為金曹從事，從討黃祖，拜鄂長。權為將軍，都京，召綜還，為書部。與是儀、徐詳俱典軍國密事。劉備下白帝，權以見兵少，使綜料諸縣，得六千人，立解煩兩部，詳領左部、綜領右部督。吳將晉宗叛歸魏，魏以宗為蘄春太守，去江數百里，數為寇害。權使綜與賀齊輕行掩襲，生虜得宗。加建武中郎將。魏拜權為吳王，封綜、儀、詳皆為亭侯。","subject_perso