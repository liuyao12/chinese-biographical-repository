57,2558,2559,2560,2561,2562,2563,2564,2565,2566,2567,2568,2569,2570,2571,2572,2573,2574,2575,2576,2577,2578,2579,2580,2581,2582,2583,2584,2585,2586,2587,2588,2589,2590,2591,2592,2593,2594,2595,2596,2597,2598,2599,2600,2601,2602,2603,2604,2605,2606,2607,2608,2609,2610,2611,2612,2613,2614,2615,2616,2617,2618,2619,2620,2621,2622,2623,2624,2625,2626,2627,2628,2629,2630,2631,2632,2633,2634,2635,2636,2637,2638,2639,2640,2641,2642,2643,2644,2645,2646,2647],"revision_id":1527632},"mentions":[{"id":"c-jinshu-066-liuhong:p008:m0002","surface":"成都王穎","start":2,"end":6,"person_id":"x4m_ygm_1d3","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-liuhong:p008:m0014","surface":"弘","start":14,"end":15,"person_id":"5is_zik_jbp","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-liuhong:p008:m0025","surface":"郭勱","start":25,"end":27,"person_id":"92p_bwy_o71","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-liuhong:p008:m0029","surface":"穎","start":29,"end":30,"person_id":"x4m_ygm_1d3","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-liuhong:p008:m0033","surface":"弘","start":33,"end":34,"person_id":"5is_zik_jbp","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-liuhong:p008:m0035","surface":"璠","start":35,"end":36,"person_id":"5is_zik_jbp_A","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-liuhong:p008:m0066","surface":"東海王越","start":66,"end":70,"person_id":"9o2_vhv_r7y","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-liuhong:p008:m0073","surface":"劉喬","start":73,"end":75,"person_id":"7xd_7vq_fwl","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-066-liuhong","book_id":"b-jinshu-066","work_id":"w-jinshu","source_id":"s-jinshu-066-liuhong-ws1527632"},{"id":"c-jinshu-066-liuhong:p009","text":"以高密王略代鎮，寇盜不禁，詔起璠為順陽內史，江漢之間翕然歸心。及略薨，山簡代之。簡至，知璠得眾心，恐百姓逼以為主，表陳之，由是征璠為越騎校尉。璠亦深慮逼迫，被書，便輕至洛陽，然後遣迎家累。僑人侯脫、路難等相率衛送至都，然後辭去。南夏遂亂。父老追思弘，雖《甘棠》之詠召伯，無以過也。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":26,"last_line":26,"raw_start":2650,"raw_end":2792,"raw_character_offsets":[2652,2653,2654,2655,2656,2657,2658,2659,2660,2661,2662,2663,2664,2665,2666,2667,2668,2669,2670,2671,2672,2673,2674,2675,2676,2677,2678,2679,2680,2681,2682,2683,2684,2685,2686,2687,2688,2689,2690,2691,2692,2693,2694,2695,2696,2697,2698,2699,2700,2701,2702,2703,2704,2705,2706,2707,2708,2709,2710,2711,2712,2713,2714,2715,2716,2717,2718,2719,2720,2721,2722,2723,2724,2725,2726,2727,2728,2729,2730,2731,2732,2733,2734,2735,2736,2737,2738,2739,2740,2741,2742,2743,2744,2745,2746,2747,2748,2749,2750,2751,2752,2753,2754,2755,2756,2757,2758,2759,2760,2761,2762,2763,2764,2765,2766,2767,2768,2769,2770,2771,2772,2773,2774,2775,2776,2777,2778,2779,2780,2781,2782,2783,2784,2785,2786,2787,2788,2789,2790,2791],"revision_id":1527632},"mentions":[{"id":"c-jinshu-066-liuhong:p009:m0001","surface":"高密王略","start":1,"end":5,"person_id":"jgg_ap1_586","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-liuhong:p009:m0015","surface":"璠","start":15,"end":16,"person_id":"5is_zik_jbp_A","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-liuhong:p009:m0035","surface":"山簡","start":35,"end":37,"person_id":"82k_3oi_qf8","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-liuhong:p009:m0096","surface":"侯脫","start":96,"end":98,"person_id":"w5u_0yi_d9x","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-liuhong:p009:m0099","surface":"路難","start":99,"end":101,"person_id":"698_5ut_4jr","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-liuhong:p009:m0123","surface":"弘","start":123,"end":124,"person_id":"5is_zik_jbp","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-066-liuhong","book_id":"b-jinshu-066","work_id":"w-jinshu","source_id":"s-jinshu-066-liuhong-ws1527632"}],"sources":[{"chapter_id":"c-jin