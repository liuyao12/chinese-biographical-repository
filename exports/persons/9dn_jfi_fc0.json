{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"9dn_jfi_fc0","canonical_person_id":"9dn_jfi_fc0","id_aliases":["cbr-p004385"],"identity_policy":"contextual_provisional","person_ids":["9dn_jfi_fc0"],"persons":[{"id":"9dn_jfi_fc0","label":"湯引古（平原君虞卿列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"湯","mention_ids":["c-shiji-076-pingyu:m004-0215"]}],"evidence":[{"mention_id":"c-shiji-076-pingyu:m004-0215","chapter_id":"c-shiji-076-pingyu","paragraph_id":"c-shiji-076-pingyu:p004","quote":"湯"}],"id_aliases":["cbr-p004385"]}],"source_mention_summary":[{"source_id":"s-shiji-076-pingyu","work_id":"w-shiji","book_id":"b-shiji-076","chapter_id":"c-shiji-076-pingyu","mention_count":1,"mention_ids":["c-shiji-076-pingyu:m004-0215"],"paragraph_ids":["c-shiji-076-pingyu:p004"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-076-pingyu"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-076-pingyu:m004-0215","start":215,"end":216,"surface":"湯","kind":"person","person_id":"9dn_jfi_fc0","status":"contextual_provisional","paragraph_id":"c-shiji-076-pingyu:p004","chapter_id":"c-shiji-076-pingyu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji076-012","person_id":"9dn_jfi_fc0","scope":"same_chapter","chapter_ids":["c-shiji-076-pingyu"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"依毛遂合從與邯鄲救援的姓名、稱呼及局部回指暫接，楚王留未名，湯文王保存引古。毛遂明示遂短稱與敘事遂副詞分開；相士非任相。李同父邯鄲傳舍吏及李侯按同段父稱暫接，不把父封爵改成李同追贈。第7段舉平原君之趙王未逕接惠文或孝成，親戚、子孫與食客群體未補個別世系。","surfaces":["湯"],"evidence":[{"paragraph_id":"c-shiji-076-pingyu:p004","quote":"毛遂比至楚，與十九人論議，十九人皆服。平原君與楚合從，言其利害，日出而言之，日中不決。十九人謂毛遂曰：「先生上。」毛遂按劍歷階而上，謂平原君曰：「從之利害，兩言而決耳。今日出而言從，日中不決，何也？」楚王謂平原君曰：「客何爲者也？」平原君曰：「是勝之舍人也。」楚王叱曰：「胡不下！吾乃與而君言，汝何爲者也！」毛遂按劍而前曰：「王之所以叱遂者，以楚國之眾也。今十步之內，王不得恃楚國之眾也，王之命縣於遂手。吾君在前，叱者何也？且遂聞湯以七十里之地王天下，文王以百里之壤而臣諸侯，豈其士卒眾多哉，誠能據其勢而奮其威。今楚地方五千里，持戟百萬，此霸王之資也。以楚之彊，天下弗能當。白起，小豎子耳，率數萬之眾，興師以與楚戰，一戰而舉鄢郢，再戰而燒夷陵，三戰而辱王之先人。此百世之怨而趙之所羞，而王弗知惡焉。合從者爲楚，非爲趙也。吾君在前，叱者何也？」楚王曰：「唯唯，誠若先生之言，謹奉社稷而以從。」毛遂曰：「從定乎？」楚王曰：「定矣。」毛遂謂楚王之左右曰：「取雞狗馬之血來。」毛遂奉銅槃而跪進之楚王曰：「王當歃血而定從，次者吾君，次者遂。」遂定從於殿上。毛遂左手持槃血而右手招十九人曰：「公相與歃此血於堂下。公等錄錄，所謂因人成事者也。」"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-076-pingyu:p004","text":"毛遂比至楚，與十九人論議，十九人皆服。平原君與楚合從，言其利害，日出而言之，日中不決。十九人謂毛遂曰：「先生上。」毛遂按劍歷階而上，謂平原君曰：「從之利害，兩言而決耳。今日出而言從，日中不決，何也？」楚王謂平原君曰：「客何爲者也？」平原君曰：「是勝之舍人也。」楚王叱曰：「胡不下！吾乃與而君言，汝何爲者也！」毛遂按劍而前曰：「王之所以叱遂者，以楚國之眾也。今十步之內，王不得恃楚國之眾也，王之命縣於遂手。吾君在前，叱者何也？且遂聞湯以七十里之地王天下，文王以百里之壤而臣諸侯，豈其士卒眾多哉，誠能據其勢而奮其威。今楚地方五千里，持戟百萬，此霸王之資也。以楚之彊，天下弗能當。白起，小豎子耳，率數萬之眾，興師以與楚戰，一戰而舉鄢郢，再戰而燒夷陵，三戰而辱王之先人。此百世之怨而趙之所羞，而王弗知惡焉。合從者爲楚，非爲趙也。吾君在前，叱者何也？」楚王曰：「唯唯，誠若先生之言，謹奉社稷而以從。」毛遂曰：「從定乎？」楚王曰：「定矣。」毛遂謂楚王之左右曰：「取雞狗馬之血來。」毛遂奉銅槃而跪進之楚王曰：「王當歃血而定從，次者吾君，次者遂。」遂定從於殿上。毛遂左手持槃血而右手招十九人曰：「公相與歃此血於堂下。公等錄錄，所謂因人成事者也。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-076-pingyu:m004-0000","start":0,"end":2,"surface":"毛遂","kind":"person","person_id":"kik_w6y_owb","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m004-0007","start":7,"end":10,"surface":"十九人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未定祖先或親屬回指，未補姓名及成員；親戚不直接推出父子，子孫代不補世系。"},{"id":"c-shiji-076-pingyu:m004-0013","start":13,"end":16,"surface":"十九人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未定祖先或親屬回指，未補姓名及成員；親戚不直接推出父子，子孫代不補世系。"},{"id":"c-shiji-076-pingyu:m004-0019","start":19,"end":22,"surface":"平原君","kind":"person","person_id":"lrj_utu_y6w","