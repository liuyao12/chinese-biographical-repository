apter_id":"c-jinshu-043-guoshu"},{"id":"c-jinshu-069-zhouyi:p008:m0117","start":117,"end":119,"surface":"繆坦","kind":"person","person_id":"rxv_s4u_4uj","status":"contextual_provisional","paragraph_id":"c-jinshu-069-zhouyi:p008","chapter_id":"c-jinshu-069-zhouyi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-jin043-guoshu-miutan","person_id":"rxv_s4u_4uj","surfaces":["繆坦"],"scope":"cross_chapter","chapter_ids":["c-jinshu-043-guoshu","c-jinshu-069-zhouyi"],"status":"contextual_provisional","confidence_level":"moderate","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-043","source_id":"s-jinshu-043-ws2618531-guoshu","chapter_id":"c-jinshu-043-guoshu","paragraph_id":"c-jinshu-043-guoshu:p005","quote":"王敦召為參軍，轉從事中郎。襄陽都督周訪卒，敦遣舒監襄陽軍。甘卓至，乃還。朝廷征舒為右丞，敦留不遣。敦謀為逆，舒諫不從，使守武昌。荊州別駕宗澹忌舒才能，數譖之于王暠。暠疑舒與甘卓同謀，密以白敦，敦不受。高官督護繆坦嘗請武昌城西地為營，太守樂凱言於敦曰：「百姓久買此地，種菜自贍，不宜奪之。」敦大怒曰：「王處仲不來江湖，當有武昌地不，而人云是我地邪！」凱懼，不敢言。舒曰：「公聽舒一言。」敦曰：「平子以卿病狂，故掐鼻灸眉頭，舊疢復發邪！」舒曰：「古之狂也直，周昌、汲黯、硃雲不狂也。昔堯立誹謗之木，舜置敢諫之鼓，然後事無枉縱。公為勝堯、舜邪？乃逆折舒，使不得言。何與古人相遠！」敦曰：「卿欲何言？」舒曰：「繆坦可謂小人，疑誤視聽，奪人私地，以強陵弱。晏子稱：君曰其可，臣獻其否，以成其可。是以舒等不敢不言。」敦即使還地，眾咸壯之。敦重舒公亮，給賜轉豐，數詣其家。表為梁州刺史。病卒。"},{"work_id":"w-jinshu","book_id":"b-jinshu-069","source_id":"s-jinshu-069-zhouyi","chapter_id":"c-jinshu-069-zhouyi","paragraph_id":"c-jinshu-069-zhouyi:p008","quote":"顗之死也，敦坐有一參軍樗蒱，馬於博頭被殺，因謂敦曰：「周家奕世令望，而位不至公，及伯仁將登而墜，有似下官此馬。」敦曰：「伯仁總角於東宮相遇，一面披襟，便許之三事，何圖不幸自貽王法。」敦素憚顗，每見顗輒面熱，雖復冬月，扇面手不得休。敦使繆坦籍顗家，收得素簏數枚，盛故絮而已，酒五甕，米數石，在位者服其清約。敦卒後，追贈左光祿大夫、儀同三司，諡曰康，祀以少牢。"}],"rationale":"069周顗死後王敦使繆坦籍其家；本段王敦部下督護繆坦請奪地，同一敦部屬、政局/姓名一致首選，非不同姓族譜。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null,"external_reference_file":"source-evidence/jin043-guoshu-source/identity-review.json"},{"id":"d-jin069-zhouyi-rxv-s4u-4uj","person_id":"rxv_s4u_4uj","surfaces":["繆坦"],"scope":"same_chapter","chapter_ids":["c-jinshu-069-zhouyi"],"status":"contextual_provisional","confidence_level":"moderate","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-069","chapter_id":"c-jinshu-069-zhouyi","source_id":"s-jinshu-069-zhouyi","paragraph_id":"c-jinshu-069-zhouyi:p008","quote":"顗之死也，敦坐有一參軍樗蒱，馬於博頭被殺，因謂敦曰：「周家奕世令望，而位不至公，及伯仁將登而墜，有似下官此馬。」敦曰：「伯仁總角於東宮相遇，一面披襟，便許之三事，何圖不幸自貽王法。」敦素憚顗，每見顗輒面熱，雖復冬月，扇面手不得休。敦使繆坦籍顗家，收得素簏數枚，盛故絮而已，酒五甕，米數石，在位者服其清約。敦卒後，追贈左光祿大夫、儀同三司，諡曰康，祀以少牢。"}],"rationale":"親讀完整周顗及附閔單元，依說話受話及人物延續辨識；短字嵇阮限王導對顗引古語境，田蘇與無鹽不補未核外名。周穆及周文與既有古人同字候選分立。先帝／二宮／匿名群體保未決；親屬與為嗣提案未在此形式化。","references":[],"human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-043-guoshu:p005","text":"王敦召為參軍，轉從事中郎。襄陽都督周訪卒，敦遣舒監襄陽軍。甘卓至，乃還。朝廷征舒為右丞，敦留不遣。敦謀為逆，舒諫不從，使守武昌。荊州別駕宗澹忌舒才能，數譖之于王暠。暠疑舒與甘卓同謀，密以白敦，敦不受。高官督護繆坦嘗請武昌城西地為營，太守樂凱言於敦曰：「百姓久買此地，種菜自贍，不宜奪之。」敦大怒曰：「王處仲不來江湖，當有武昌地不，而人云是我地邪！」凱懼，不敢言。舒曰：「公聽舒一言。」敦曰：「平子以卿病狂，故掐鼻灸眉頭，舊疢復發邪！」舒曰：「古之狂也直，周昌、汲黯、硃雲不狂也。昔堯立誹謗之木，舜置敢諫之鼓，然後事無枉縱。公為勝堯、舜邪？乃逆折舒，使不得言。何與古人相遠！」敦曰：「卿欲何言？」舒曰：「繆坦可謂小人，疑誤視聽，奪人私地，以強陵弱。晏子稱：君曰其可，臣獻其否，以成其可。是以舒等不敢不言。」敦即使還地，眾咸壯之。敦重舒公亮，給賜轉豐，數詣其家。表為梁州刺史。病卒。","text_layer":"received_chapter","mentions":[{"id":"c-jinshu-043-guoshu:p005:m0000","kind":"person","start":0,"end":2,"surface":"王敦","person_id":"39o_b6y_n74","status":"contextual_provisional","resolution_note":"完整敘事內的具名/省稱/字稱，原字保留；同指理由見逐人identity-review。"},{"id":"c-jinshu-043-guoshu:p005:m0017","kind":"person","start":17,"end":19,"surface":"周訪","person_id":"c6b_s71_vt7","status":"contextual_provisional","resolution_note":"完整敘事內的具名/省稱/字稱，原字保留；同指理由見逐人identity-review。"},{"id":"c-jinshu-043-guoshu:p005:m0021","kind":"person","start":21,"end":22,"surface":"敦","person_id":"39o_b6y_n74","status":"contextual_provisional","resolution_note":"完整敘事內的具名/省稱/字稱，原字保留；同指理由見逐人identity-review。"},{"id":"c-jinshu-043-guoshu:p005:m0023","kind":"person","start":23,"end":24,"surface":"舒","person_id":"7mp_r23_bds","status":"contextual_provisional","resolution_note":"完整敘事內的具名/省稱/字稱，原字保留；同指理由見逐人identity-review。"},{"id":"c-jinshu-043-guoshu:p005:m0029","kind":"person","start":29,"e