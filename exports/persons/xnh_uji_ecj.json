b3e","object_person_id":"xnh_uji_ecj","predicate":"father","qualifiers":{"source_term":"父悝，少孤"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-071","chapter_id":"c-jinshu-071-gaosong","source_id":"s-jinshu-071-gaosong-ws2595541","paragraph_id":"c-jinshu-071-gaosong:p001","quote":"高崧，字茂琰，廣陵人也。父悝，少孤，事母以孝聞。年十三，值歲饑，悝菜蔬不饜，每致甘肥於母。撫幼弟以友愛稱。寓居江州，刺史華軼辟為西曹書佐。及軼敗，悝藏匿軼子經年，會赦乃出。元帝嘉而宥之，以為參軍，遂曆顯位，至丹陽尹、光祿大夫，封建昌伯。","subject_person_mention_id":"c-jinshu-071-gaosong:p001:m0000","object_person_mention_id":"c-jinshu-071-gaosong:p001:m0013"}],"status":"source_attested","interpretation_note":"次段詔亦以崧為高悝子。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-061-huayi:p003:m0004","surface":"高悝","start":4,"end":6,"person_id":"xnh_uji_ecj","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-061-huayi:p003","chapter_id":"c-jinshu-061-huayi"},{"id":"c-jinshu-061-huayi:p003:m0023","surface":"悝","start":23,"end":24,"person_id":"xnh_uji_ecj","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-061-huayi:p003","chapter_id":"c-jinshu-061-huayi"},{"id":"c-jinshu-061-huayi:p003:m0042","surface":"悝","start":42,"end":43,"person_id":"xnh_uji_ecj","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-061-huayi:p003","chapter_id":"c-jinshu-061-huayi"},{"id":"c-jinshu-071-gaosong:p001:m0013","surface":"悝","start":13,"end":14,"person_id":"xnh_uji_ecj","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-071-gaosong:p001","chapter_id":"c-jinshu-071-gaosong"},{"id":"c-jinshu-071-gaosong:p002:m0062","surface":"悝","start":62,"end":63,"person_id":"xnh_uji_ecj","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-071-gaosong:p002","chapter_id":"c-jinshu-071-gaosong"}],"relations":[{"id":"