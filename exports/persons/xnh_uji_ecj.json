e":"悝","start":23,"end":24,"person_id":"xnh_uji_ecj","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-huayi:p003:m0026","surface":"軼","start":26,"end":27,"person_id":"p86_bh6_jm2","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-huayi:p003:m0042","surface":"悝","start":42,"end":43,"person_id":"xnh_uji_ecj","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-061-huayi","book_id":"b-jinshu-061","work_id":"w-jinshu","source_id":"s-jinshu-061-huayi-ws7903772"},{"id":"c-jinshu-071-gaosong:p001","text":"高崧，字茂琰，廣陵人也。父悝，少孤，事母以孝聞。年十三，值歲饑，悝菜蔬不饜，每致甘肥於母。撫幼弟以友愛稱。寓居江州，刺史華軼辟為西曹書佐。及軼敗，悝藏匿軼子經年，會赦乃出。元帝嘉而宥之，以為參軍，遂曆顯位，至丹陽尹、光祿大夫，封建昌伯。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":90,"last_line":90,"raw_start":7122,"raw_end":7240,"raw_character_offsets":[7122,7123,7124,7125,7126,7127,7128,7129,7130,7131,7132,7133,7134,7135,7136,7137,7138,7139,7140,7141,7142,7143,7144,7145,7146,7147,7148,7149,7150,7151,7152,7153,7154,7155,7156,7157,7158,7159,7160,7161,7162,7163,7164,7165,7166,7167,7168,7169,7170,7171,7172,7173,7174,7175,7176,7177,7178,7179,7180,7181,7182,7183,7184,7185,7186,7187,7188,7189,7190,7191,7192,7193,7194,7195,7196,7197,7198,7199,7200,7201,7202,7203,7204,7205,7206,7207,7208,7209,7210,7211,7212,7213,7214,7215,7216,7217,7218,7219,7220,7221,7222,7223,7224,7225,7226,7227,7228,7229,7230,7231,7232,7233,7234,7235,7236,7237,7238,7239],"revision_id":2595541},"mentions":[{"id":"c-jinshu-071-gaosong:p001:m0000","surface":"高崧","start":0,"end":2,"person_id":"745_5cb_b3e","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-071-gaosong:p001:m0013","surface":"悝","start":13,"end":14,"person_id":"xnh_uji_ecj","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-071-gaosong:p001:m0060","surface":"華軼","start":60,"end":62,"person_id":"p86_bh6_jm2","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-071-gaosong:p001:m0086","surface":"元帝","start":86,"end":88,"person_id":"dkn_ge4_286_AAAAAAA","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-071-gaosong","book_id":"b-jinshu-071","work_id":"w-jinshu","source_id":"s-jinshu-071-gaosong-ws2595541"},{"id":"c-jinshu-071-gaosong:p002","text":"崧少好學，善史書。總角時，司空何充稱其明惠。充為揚州，引崧為主簿，益相欽重。轉驃騎主簿，舉州秀才，除太學博士，父艱去職。初，悝以納妾致訟被黜，及終，崧乃自系廷尉訟冤，遂停喪五年不葬，表疏數十上。帝哀之，乃下詔曰：「悝備位大臣，違憲被黜，事已久判。其子崧求直無已。今特聽傳侯爵。」由是見稱。拜中書郎、黃門侍郎。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":92,"last_line":92,"raw_start":7242,"raw_end":7396,"raw_character_offsets":[7242,7243,7244,7245,7246,7247,7248,7249,7250,7251,7252,7253,7254,7255,7256,7257,7258,7259,7260,7261,7262,7263,7264,7265,7266,7267,7268,7269,7270,7271,7272,7273,7274,7275,7276,7277,7278,7279,7280,7281,7282,7283,7284,7285,7286,7287,7288,7289,7290,7291,7292,7293,7294,7295,7296,7297,7298,7299,7300,7301,7302,7303,7304,7305,7306,7307,7308,7309,7310,7311,7312,7313,7314,7315,7316,7317,7318,7319,7320,7321,7322,7323,7324,7325,7326,7327,7328,7329,7330,7331,7332,7333,7334,7335,7336,7337,7338,7339,7340,7341,7342,7343,7344,7345,7346,7347,7348,7349,7350,7351,7352,7353,7354,7355,7356,7357,7358,7359,7360,7361,7362,7363,7364,7365,7366,7367,7368,7369,7370,7371,7372,7373,7374,7375,7376,7377,7378,7379,7380,7381,7382,7383,7384,7385,7386,7387,7388,7389,7390,7391,7392,7393,7394,7395],"revision_id":2595541},"mentions":[{"id":"c-jinshu-071-gaosong:p002:m0015","surface":"何充","start":15,"end":17,"person_id":"0os_htj_jqc","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-071-gaosong:p002:m0062","surface":"悝","start":62,"end":63,"person_id":"xnh_uji_ecj","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-071-gaosong:p002:m0125","surface":"崧","start":125,"end":126,"person_id":"745_5cb_b3e","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-071-gaosong","book_id":"b-jinshu-071","work_id":"w-jinshu","source_id":"s-jinshu-071-gaosong-ws2595541"}],"sources":[{"