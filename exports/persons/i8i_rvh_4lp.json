94,"end":96,"surface":"戴公","kind":"person","person_id":"kt8_3kv_44r_A","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m020-0097","start":97,"end":99,"surface":"戴公","kind":"person","person_id":"kt8_3kv_44r_A","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m020-0105","start":105,"end":106,"surface":"燬","kind":"person","person_id":"i8i_rvh_4lp","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m020-0107","start":107,"end":109,"surface":"文公","kind":"person","person_id":"i8i_rvh_4lp","status":"contextual_provisional"}],"chapter_id":"c-shiji-037-wei","book_id":"b-shiji-037","work_id":"w-shiji","source_id":"s-shiji-037-wei"},{"id":"c-shiji-037-wei:p021","text":"文公初立，輕賦平罪，身自勞，與百姓同苦，以收衞民。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-037-wei:m021-0000","start":0,"end":2,"surface":"文公","kind":"person","person_id":"i8i_rvh_4lp","status":"contextual_provisional"}],"chapter_id":"c-shiji-037-wei","book_id":"b-shiji-037","work_id":"w-shiji","source_id":"s-shiji-037-wei"},{"id":"c-shiji-037-wei:p022","text":"十六年，晉公子重耳過，無禮。十七年，齊桓公卒。二十五年，文公卒，子成公鄭立。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-037-wei:m022-0004","start":4,"end":9,"surface":"晉公子重耳","kind":"person","person_id":"6di_ywz_ju4_AAA","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m022-0018","start":18,"end":21,"surface":"齊桓公","kind":"person","person_id":"9w2_c77_53m","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m022-0028","start":28,"end":30,"surface":"文公","kind":"person","person_id":"i8i_rvh_4lp","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m022-0033","start":33,"end":36,"surface":"成公鄭","kind":"person","person_id":"i8i_rvh_4lp_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-037-wei","book_id":"b-shiji-037","work_id":"w-shiji","source_id":"s-shiji-037-wei"},{"id":"c-shiji-038-song:p035","text":"桓公二年，諸矦伐宋，至郊而去。三年，齊桓公始霸。二十三年，迎衛公子燬於齊，立之，是爲衛文公。文公女弟爲桓公夫人。秦穆公即位。三十年，桓公病，太子茲甫讓其庶兄目夷爲嗣。桓公義太子意，竟不聽。三十一年春，桓公卒，太子茲甫立，是爲襄公。以其庶兄目夷爲相。未葬，而齊桓公會諸矦于葵丘，襄公往會。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-038-song:m035-0000","start":0,"end":2,"surface":"桓公","kind":"person","person_id":"aa9_8gx_l6j","status":"contextual_provisional"},{"id":"c-shiji-038-song:m035-0005","start":5,"end":7,"surface":"諸矦","kind":"unresolved","person_id":null,"status":"unresolved","note":"泛稱、政制、群體、神異、匿名者或未定指代；不補未見人名、闕代、制度爵等或成員。"},{"id":"c-shiji-038-song:m035-0018","start":18,"end":21,"surface":"齊桓公","kind":"person","person_id":"9w2_c77_53m","status":"contextual_provisional"},{"id":"c-shiji-038-song:m035-0030","start":30,"end":34,"surface":"衛公子燬","kind":"person","person_id":"i8i_rvh_4lp","status":"contextual_provisional"},{"id":"c-shiji-038-song:m035-0042","start":42,"end":45,"surface":"衛文公","kind":"person","person_id":"i8i_rvh_4lp","status":"contextual_provisional"},{"id":"c-shiji-038-song:m035-0046","start":46,"end":48,"surface":"文公","kind":"person","person_id":"i8i_rvh_4lp","status":"contextual_provisional"},{"id":"c-shiji-038-song:m035-0048","start":48,"end":50,"surface":"女弟","kind":"person","person_id":"b2s_jfq_0ra","status":"contextual_provisional"},{"id":"c-shiji-038-song:m035-0051","start":51,"end":53,"surface":"桓公","kind":"person","person_id":"aa9_8gx_l6j","status":"contextual_provisional"},{"id":"c-shiji-038-song:m035-0053","start":53,"end":55,"surface":"夫人","kind":"person","person_id":"b2s_jfq_0ra","status":"contextual_provisional"},{"id":"c-shiji-038-song:m035-0056","start":56,"end":59,"surface":"秦穆公","kind":"person","person_id":"y97_huh_vuz_AAAAA","status":"contextual_provisional"},{"id":"c-shiji-038-song:m035-0066","start":66,"end":68,"surface":"桓公","kind":"person","person_id":"aa9_8gx_l6j","status":"contextual_provisional"},{"id":"c-shiji-038-song:m035-0070","start":70,"end":74,"surface":"太子茲甫","kind":"person","person_id":"l3c_zg4_f7z","status":"contextual_provisional"},{"id":"c-shiji-038-song:m035-0076","start":76,"end":78,"surface":"庶兄","kind":"unresolved","person_id":null,"status":"unresolved","note":"泛稱、政制、群體、神異、匿名者或未定指代；不補未見人名、闕代、制度爵等或成員。"},{"id":"c-shiji-038-song:m035-0078","start":78,"end":80,"surface":"目夷","kind":"person","person_id":"vwi_95l_l6d","status":"contextual_provisional"},{"id":"c-shiji-038-song:m035-0083","start":83,"end":85,"surface":"桓公","kind":"person","person_id":"aa9_8gx_l6j","status":"contextual_provisional"},{"id":"c-shiji-038-song:m035-0086","start":86,"end":88,"surface":"太子","kind":"person","person_id":"l3c_zg4_f7z","status":"contextual_provisional"},{"id":"c-shiji-038-song:m035-0100","start":100,"end":102,"surface":"桓公","kind":"person","person_id":"aa9_8gx_l6j","status":"contextual_provisional"},{"id":"c-shiji-038-song:m035-0104","start":104,"end":108,"surface":"太子茲甫","kind":"person","person_id":"l3c_zg4_f7z","status":"contextual_provisional"},{"id":"c-shiji-038-song:m035-0112","start":112,"end":114,"surface":"襄公","kind":"person","person_id":"l3c_zg4_f7z","status":"contextual_provisional"},{"id":"c-shiji-038-song:m035-0117","start":117,"end":119,"surface":"庶兄","kind":"unresolved","person_id":null,"status":"unresolved","note":"泛稱、政制、群體、神異、匿名者或未定指代；不補未見人名、闕代、制度爵等或成員。"},{"id":"c-shiji-038-song:m035-0119","start":119,"end":121,"surface":"目夷","kind":"person","person_id":"vwi_95l_l6d","status":"contextual_provisional"},{"id":"c-shiji-038-song:m035-0128","start":128,"end":131,"surface":"齊桓公","kind":"person","person_id":"9w2_c77_53m","status":"contextual_provisional"},{"id":"c-shiji-038-song:m035-0132","start":132,"end":134,"surface":"諸矦","kind":"unresolved","person_id":null,"status":"unresolved","note":"泛稱、政制、群體、神異、匿名者或未定指代；不補未見人名、闕代、制度爵等或成員。"},{"id":"c-shiji-038-song:m035-0138","start":138,"end":140,"surface":"襄公","kind":"person","person_id":"l3c_zg4_f7z","status":"contextual_provisional"}],"chapter_id":"c-shiji-038-song","book_id":"b-shiji-038","work_id":"w-shiji","source_id":"s-shiji-038-song"},