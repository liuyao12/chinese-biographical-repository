ion"},"interpretation_note":"保存本篇明示父、子、生、夫人與兄弟原稱，不由繼位推父子、不補同父同母或闕代；來源主張並非已確證史實。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji038-027","subject_person_id":"b2s_jfq_0ra","predicate":"sister","object_person_id":"i8i_rvh_4lp","status":"source_attested","evidence":[{"chapter_id":"c-shiji-038-song","source_id":"s-shiji-038-song","paragraph_id":"c-shiji-038-song:p035","quote":"桓公二年，諸矦伐宋，至郊而去。三年，齊桓公始霸。二十三年，迎衛公子燬於齊，立之，是爲衛文公。文公女弟爲桓公夫人。秦穆公即位。三十年，桓公病，太子茲甫讓其庶兄目夷爲嗣。桓公義太子意，竟不聽。三十一年春，桓公卒，太子茲甫立，是爲襄公。以其庶兄目夷爲相。未葬，而齊桓公會諸矦于葵丘，襄公往會。"}],"qualifiers":{"source_term":"文公女弟","historicity":"historical_tradition"},"interpretation_note":"保存本篇明示父、子、兄弟、夫人及曾庶孫說；不由繼位補父子，不補母名、共父母或闕代。來源主張與確證史實分開。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-037-wei:m019-0025","start":25,"end":26,"surface":"燬","kind":"person","person_id":"i8i_rvh_4lp","status":"contextual_provisional","paragraph_id":"c-shiji-037-wei:p019","chapter_id":"c-shiji-037-wei"},{"id":"c-shiji-037-wei:m019-0032","start":32,"end":34,"surface":"文公","kind":"person","person_id":"i8i_rvh_4lp","status":"contextual_provisional","paragraph_id":"c-shiji-037-wei:p019","chapter_id":"c-shiji-037-wei"},{"id":"c-shiji-037-wei:m019-0035","start":35,"end":37,"surface":"文公","kind":"person","person_id":"i8i_rvh_4lp","status":"contextual_provisional","paragraph_id":"c-shiji-037-wei:p019","chapter_id":"c-shiji-037-wei"},{"id":"c-shiji-037-wei:m020-0105","start":105,"end":106,"surface":"燬","kind":"person","person_id":"i8i_rvh_4lp","status":"contextual_provisional","paragraph_id":"c-shiji-037-wei:p020","chapter_id":"c-shiji-037-wei"},{"id":"c-shiji-037-wei:m020-0107","start":107,"end":109,"surface":"文公","kind":"person","person_id":"i8i_rvh_4lp","status":"contextual_provisional","paragraph_id":"c-shiji-037-wei:p020","chapter_id":"c-shiji-037-wei"},{"id":"c-shiji-037-wei:m021-0000","sta