ial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-liangshu-028-peisui-complete:p003:m0148","start":148,"end":150,"surface":"呂頗","kind":"person","person_id":"d07_0sc_nev","status":"contextual_provisional","paragraph_id":"c-liangshu-028-peisui-complete:p003","chapter_id":"c-liangshu-028-peisui-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-028-peisui-complete:p003","text":"東昏踐阼，始安王蕭遙光爲撫軍將軍、揚州刺史，引邃爲參軍。後遙光敗，邃還壽陽，值刺史裴叔業以壽陽降魏，豫州豪族皆被驅掠，邃遂隨衆北徙。魏主宣武帝雅重之，以爲司徒屬，中書郎，魏郡太守。魏遣王肅鎮壽陽，邃固求隨肅，密圖南歸。天監初，自拔還朝，除後軍諮議參軍。邃求邊境自效，以爲輔國將軍、廬江太守。時魏將呂頗率衆五萬奄來攻郡，邃率麾下拒破之，加右軍將軍。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":16,"last_line":16,"raw_start":503,"raw_end":676,"raw_character_offsets":[503,504,505,506,507,508,509,510,511,512,513,514,515,516,517,518,519,520,521,522,523,524,525,526,527,528,529,530,531,532,533,534,535,536,537,538,539,540,541,542,543,544,545,546,547,548,549,550,551,552,553,554,555,556,557,558,559,560,561,562,563,564,565,566,567,568,569,570,571,572,573,574,575,576,577,578,579,580,581,582,583,584,585,586,587,588,589,590,591,592,593,594,595,596,597,598,599,600,601,602,603,604,605,606,607,608,609,610,611,612,613,614,615,616,617,618,619,620,621,622,623,624,625,626,627,628,629,630,631,632,633,634,635,636,637,638,639,640,641,642,643,644,645,646,647,648,649,650,651,652,653,654,655,656,657,658,659,660,661,662,663,664,665,666,667,668,669,670,671,672,673,674,675],"revision_id":1511902},"mentions":[{"id":"c-liangshu-028-peisui-complete:p003:m0000","start":0,"end":2,"surface":"東昏","kind":"person","person_id":"w4m_9tw_147_A","status":"contextual_provisional"},{"id":"c-liangshu-028-peisui-complete:p003:m0005","start":5,"en