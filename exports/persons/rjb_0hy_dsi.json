24-0577","start":577,"end":578,"surface":"龍","kind":"person","person_id":"rjb_0hy_dsi","status":"source_identified"},{"id":"c-shiji-001-wudi:m024-0609","start":609,"end":610,"surface":"舜","kind":"person","person_id":"ddb_l4j_4j2","status":"source_identified"},{"id":"c-shiji-001-wudi:m024-0652","start":652,"end":654,"surface":"三苗","kind":"unresolved","person_id":null,"status":"unresolved","note":"可能為個人、官職、群體、氏族或國號；不憑本篇未明示的外部對應補造身份。"}],"annotation_status":"in_progress","chapter_id":"c-shiji-001-wudi","book_id":"b-shiji-001","work_id":"w-shiji","source_id":"s-shiji-001-wudi"},{"id":"c-shiji-001-wudi:p025","text":"此二十二人咸成厥功：皋陶爲大理，平，民各伏得其實；伯夷主禮，上下咸讓；垂主工師，百工致功；益主虞，山澤辟；棄主稷，百穀時茂；契主司徒，百姓親和；龍主賓客，遠人至；十二牧行而九州莫敢辟違；唯禹之功爲大，披九山，通九澤，決九河，定九州，各以其職來貢，不失厥宜。方五千里，至于荒服。南撫交阯、北發，西戎、析枝、渠廋、氐、羌，北山戎、發、息慎，東長、鳥夷，四海之內咸戴帝舜之功。於是禹乃興九招之樂，致異物，鳳皇來翔。天下明德皆自虞帝始。","mentions":[{"id":"c-shiji-001-wudi:m025-0010","start":10,"end":12,"surface":"皋陶","kind":"person","person_id":"p3l_pp3_n6i","status":"source_identified"},{"id":"c-shiji-001-wudi:m025-0025","start":25,"end":27,"surface":"伯夷","kind":"person","person_id":"uxv_pg9_8rm","status":"source_identified"},{"id":"c-shiji-001-wudi:m025-0035","start":35,"end":36,"surface":"垂","kind":"person","person_id":"kp0_vu0_i9h","status":"source_identified"},{"id":"c-shiji-001-wudi:m025-0045","start":45,"end":46,"surface":"益","kind":"person","person_id":"gec_tof_7li","status":"source_identified"},{"id":"c-shiji-001-wudi:m025-0053","start":53,"end":54,"surface":"棄","kind":"person","person_id":"jqy_1fv_u7v","status":"source_identified"},{"id":"c-shiji-001-wudi:m025-0055","start":55,"end":56,"surface":"稷","kind":"person","person_id":"jqy_1fv_u7v","status":"source_identified"},{"id":"c-shiji-001-wudi:m025-0062","start":62,"end":63,"surface":"契","kind":"person","person_id":"ea8_yum_lvj","status":"source_identified"},{"id":"c-shiji-001-wudi:m025-0072","start":72,"end":73,"surface":"龍","kind":"person","person_id":"rjb_0hy_dsi","status":"source_identified"},{"id":"c-shiji-001-wudi:m025-0081","start":81,"end":84,"surface":"十二牧","kind":"unresolved","person_id":null,"status":"unresolved","note":"可能為個人、官職、群體、氏族或國號；不憑本篇未明示的外部對應補造身份。"},{"id":"c-shiji-001-wudi:m025-0094","start":94,"end":95,"surface":"禹","kind":"person","person_id":"6ip_dr3_fbl","status":"source_identified"},{"id":"c-shiji-001-wudi:m025-0180","start":180,"end":182,"surface":"帝舜","kind":"person","person_id":"ddb_l4j_4j2","status":"source_identified"},{"id":"c-shiji-001-wudi:m025-0187","start":187,"end":188,"surface":"禹","kind":"person","person_id":"6ip_dr3_fbl","status":"source_identified"},{"id":"c-shiji-001-wudi:m025-0210","start":210,"end":212,"surface":"虞帝","kind":"person","person_id":"ddb_l4j_4j2","status":"source_identified"}],"annotation_status":"in_progress","chapter_id":"c-shiji-001-wudi","book_id":"b-shiji-001","work_id":"w-shiji","source_id":"s-shiji-001-wudi"},{"id":"c-shiji-036-chenqi:p030","text":"舜之後，周武王封之陳，至楚惠王滅之，有世家言。禹之後，周武王封之杞，楚惠王滅之，有世家言。契之後為殷，殷有本紀言。殷破，周封其後於宋，齊湣王滅之，有世家言。后稷之後為周，秦昭王滅之，有本紀言。皋陶之後，或封英、六，楚穆王滅之，無譜。伯夷之後，至周武王復封於齊，曰太公望，陳氏滅之，有世家言。伯翳之後，至周平王時封為秦，項羽滅之，有本紀言。垂、益、夔、龍，其後不知所封，不見也。右十一人者，皆唐虞之際名有功德臣也；其五人之後皆至帝王，餘乃為顯諸侯。滕、薛、騶，夏、殷、周之閒封也，小，不足齒列，弗論也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-036-chenqi:m030-0000","start":0,"end":1,"surface":"舜","kind":"person","person_id":"ddb_l4j_4j2","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m030-0004","start":4,"end":7,"surface":"周武王","kind":"person","person_id":"y4i_pjk_4gn_AA","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m030-0012","start":12,"end":15,"surface":"楚惠王","kind":"person","person_id":"bff_e4b_8yv","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m030-0023","start":23,"end":24,"surface":"禹","kind":"person","person_id":"6ip_dr3_fbl","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m030-0027","start":27,"end":30,"surface":"周武王","kind":"person","person_id":"y4i_pjk_4gn_AA","status":"contextual_provisional"},{"id":"c-shiji-