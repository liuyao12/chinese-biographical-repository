rly-literature-complete:p009:m0013"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-052-early-literature-complete:p009:m0403","mention_ids":["c-nanqishu-052-early-literature-complete:p009:m0403"],"kind":"paragraph"}],"mention_count":9,"duplicate_mention_count":0,"paragraph_occurrence_count":9,"table_occurrence_count":0,"passage_count":4,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"9處獨立位置，9個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"},{"source_id":"s-nanqishu-048-yuantuan-complete-ws1511898","work_id":"w-nanqishu","book_id":"b-nanqishu-048","chapter_id":"c-nanqishu-048-yuantuan-complete","raw_mention_count":2,"mention_ids":["c-nanqishu-048-yuantuan-complete:p004:m0050","c-nanqishu-048-yuantuan-complete:p004:m0097"],"paragraph_ids":["c-nanqishu-048-yuantuan-complete:p004"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-nanqishu-048-yuantuan-complete:p004:m0050","mention_ids":["c-nanqishu-048-yuantuan-complete:p004:m0050"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-048-yuantuan-complete:p004:m0097","mention_ids":["c-nanqishu-048-yuantuan-complete:p004:m0097"],"kind":"paragraph"}],"mention_count":2,"duplicate_mention_count":0,"paragraph_occurrence_count":2,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"2處獨立位置，2個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-nanqishu-052-early-literature-complete-ws2371079"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-nanqishu-052-early-literature-complete:source_review6-0","kind":"source_review","person_id":"61p_q6z_g9r","source_quote":"　　檀超字悅祖，高平金郷人也。祖弘宗，宋南琅邪太守。","reading":"檀超字悅祖。殿本與固定數位稱其祖弘宗，南史具名嶷之、字弘宗，南琅邪太守相合。","note":"檀超字悅祖。殿本與固定數位稱其祖弘宗，南史具名嶷之、字弘宗，南琅邪太守相合。","paragraph_id":"c-nanqishu-052-early-literature-complete:p006","start_codepoint":0,"end_codepoint":26,"human_reviewed":false,"chapter_id":"c-nanqishu-052-early-literature-complete","source_id":"s-nanqishu-052-early-literature-complete-ws2371079"},{"id":"c-nanqishu-052-early-literature-complete:source_review7-0","kind":"source_review","person_id":"61p_q6z_g9r","source_quote":"　　超少好文學，放誕任氣，解褐州西曹。嘗與別駕蕭惠開共事，不爲之下。謂惠開曰：「我與卿俱起一老姥，何足相誇？」蕭太后，惠開之祖姑，長沙王道憐妃，超祖姑也。舉秀才。孝建初，坐事徙梁州，板宣威府參軍。孝武聞超有文章，敕還直東宮，除驃騎參軍、寧蠻主簿，鎮北諮議。超累佐蕃職，不得志，轉尚書度支郎，車騎功曹，桂陽內史。入爲殿中郎，兼中書郎，零陵內史，征北驃騎記室，國子博士，兼左丞。","reading":"蕭太后蕭文壽是蕭惠開祖姑。長沙景王劉道憐的妃檀氏是檀超祖姑。宋書后妃傳明記蕭文壽生道憐，兩位祖姑須分讀。","note":"蕭太后蕭文壽是蕭惠開祖姑。長沙景王劉道憐的妃檀氏是檀超祖姑。宋書后妃傳明記蕭文壽生道憐，兩位祖姑須分讀。","paragraph_id":"c-nanqishu-052-early-literature-complete:p007","start_codepoint":0,"end_codepoint":187,"human_reviewed":false,"chapter_id":"c-nanqishu-052-early-literature-complete","source_id":"s-nanqishu-052-early-literature-complete-ws2371079"},{"id":"c-nanqishu-052-early-literature-complete:source_review8-0","kind":"source_review","person_id":"61p_q6z_g9r","source_quote":"　　超嗜酒，好言詠，舉止和靡，自比晉郗超，爲「高平二超」。謂人曰：「猶覺我爲優也。」太祖賞愛之。遷驍騎將軍，常侍，司徒右長史。","reading":"「高平二超」是檀超自比晉郗超，明別二人。","note":"「高平二超」是檀超自比晉郗超，明別二人。","paragraph_id":"c-nanqishu-052-early-literature-complete:p008","start_codepoint":0,"end_codepoint":63,"human_reviewed":false,"chapter_id":"c-nanqishu-052-early-literature-complete","source_id":"s-nanqishu-052-early-literature-complete-ws2371079"},{"id":"c-nanqishu-052-early-literature-complete:source_review9-0","kind":"source_review","person_id":"61p_q6z_g9r","source_quote":"　　建元二年，初置史官，以超與驃騎記室江淹掌史職。上表立條例，開元紀號，不取宋年。封爵各詳本傳，無假年表。立十志：《律曆》、《禮樂》、《天文》、《五行》、《郊祀》、《刑法》、《藝文》依班固，《朝會》、《輿服》依蔡邕、司馬彪，《州郡》依徐爰。《百官》依范曄，合《州郡》。班固五星載《天文》，日蝕載《五行》；改日蝕入《天文志》。以建元爲始。帝女體自皇宗，立傳以備甥舅之重。又立《處士》、《列女》傳。詔內外詳議。左僕射王儉議：「金粟之重，八政所先，食貨通則國富民實，宜加編錄，以崇務本。《朝會志》前史不書，蔡邕稱先師胡廣說《漢舊儀》，此乃伯喈一家之意，曲碎小儀，无煩錄。宜立《食貨》，省《朝會》。《洪範》九疇，一曰五行。五行之本，先乎水火之精，是爲日月五行之宗也。今宜憲章前軌，無所改革。又立《帝女傳》，亦非淺識所安。若有高德異行，自當載在《列女》，若止於常美，則仍舊不書。」詔：「日月災隷《天文》，餘如儉議。」超史功未就，卒官。江淹撰成之，猶不備也。","reading":"建元二年檀超與江淹共掌史職。立十志、帝女、處士、列女以及王儉駁議均按原段收錄。","note":"建元二年檀超與江淹共掌史職。立十志、帝女、處士、列女以及王儉駁議均按原段收錄。","paragraph_id":"c-nanqishu-052-early-literature-complete:p009","start_codepoint":0,"end_codepoint":423,"human_reviewed":false,"chapter_id":"c-nanqishu-052-early-literature-complete","source_id":"s-nanqishu-052-early-literature-complete-ws2371079"},{"id":"c-nanqishu-052-early-literature-complete:source_review7-55","kind":"source_review","person_id":"61p_q6z_g9r","source_quote":"蕭太后，惠開之祖姑，長沙王道憐妃，超祖姑也","reading":"兩句分讀。同段對話說兩家各由一位長輩而興；宋書後妃明記蕭文壽生道憐。檀氏為道憐妃。","note":"兩句分讀。同段對話說兩家各由一位長輩而興；宋書後妃明記蕭文壽生道憐。檀氏為道憐妃。","paragraph_id":"c-nanqishu-052-early-literature-complete:p007","start_codepoint":55,"end_codepoint":76,"human_reviewed":false,"chapter_id":"c-nanqishu-052-early-literature-complete","source_id":"s-nanqishu-052-early-literature-complete-ws2371079"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-qi052-tanchao-grandfather","subject_person_id":"61p_q6z_g9r","object_person_id":"o83_in7_hh6","predicate":"grandfather","qualifiers":{"source_term":"祖弘宗","lineage":"paternal"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-052","chapter_id":"c-nanqishu-052-early-literature-complete","source_id":"s-nanqishu-052-early-literature-complete-ws2371079","paragraph_id":"c-nanqishu-052-early-literature-complete:p006","quote":"　　檀超字悅祖，高平金郷人也。祖弘宗，宋南琅邪太守。","subject_person_mention_id":"c-nanqishu-052-early-literature-complete:p006:m0002","object_person_mention_id":"c-nanqishu-052-early-literature-complete:p006:m0016"}],"status":"source_attested","interpretation_note":"南史明名嶷之、字弘宗，官地同。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-qi052-tanchao-death","person_id":"61p_q6z_g9r","event_type":"death","source_term":"卒官","source_anchor":{"paragraph_id":"c-nanqishu-052-early-literature-complete:p009","start":409,"end":411,"surface":"卒官"},"date_expression":null,"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-052","chapter_id":"c-nanqishu-052-early-literature-complete","source_id":"s-nanqishu-052-early-literature-complete-ws2371079","paragraph_id":"c-nanqishu-052-early-literature-complete:p009","quote":"　　建元二年，初置史官，以超與驃騎記室江淹掌史職。上表立條例，開元紀號，不取宋年。封爵各詳本傳，無假年表。立十志：《律曆》、《禮樂》、《天文》、《五行》、《郊祀》、《刑法》、《藝文》依班固，《朝會》、《輿服》依蔡邕、司馬彪，《州郡》依徐爰。《百官》依范曄，合《州郡》。班固五星載《天文》，日蝕載《五行》；改日蝕入《天文志》。以建元爲始。帝女體自皇宗，立傳以備甥舅之重。又立《處士》、《列女》傳。詔內外詳議。左僕射王儉議：「金粟之重，八政所先，食貨通則國富民實，宜加編錄，以崇務本。《朝會志》前史不書，蔡邕稱先師胡廣說《漢舊儀》，此乃伯喈一家之意，曲碎小儀，无煩錄。宜立《食貨》，省《朝會》。《洪範》九疇，一曰五行。五行之本，先乎水火之精，是爲日月五行之宗也。今宜憲章前軌，無所改革。又立《帝女傳》，亦非淺識所安。若有高德異行，自當載在《列女》，若止於常美，則仍舊不書。」詔：「日月災隷《天文》，餘如儉議。」超史功未就，卒官。江淹撰成之，猶不備也。","person_mention_id":"c-nanqishu-052-early-literature-complete:p009:m0013"}],"status":"source_attested","interpretation_note":"按同段人物與次第核所屬卒事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"mentions":[{"id":"c-nanqishu-048-yuantuan-complete:p004:m0050","start":50,"end":52,"surface":"檀超","kind":"person","person_id":"61p_q6z_g9r","status":"contextual_provisional","paragraph_id":"c-nanqishu-048-yuantuan-complete:p004","chapter_id":"c-nanqishu-048-yuantuan-complete"},{"id":"c-nanqishu-048-yuantuan-complete:p004:m0097","start":97,"end":98,"surface":"超","kind":"person","person_id":"61p_q6z_g9r","status":"contextual_provisional","paragraph_id":"c-nanqishu-048-yuantuan-complete:p004","chapter_id":"c-nanqishu-048-yuantuan-complete"},{"id":"c-nanqishu-052-early-literature-complete:p006:m0002","start":2,"end":4,"surface":"檀超","kind":"person","person_id":"61p_q6z_g9r","status":"contextual_provisional","paragraph_id":"c-nanqishu-052-early-literature-complete:p006","chapter_id":"c-nanqishu-052-