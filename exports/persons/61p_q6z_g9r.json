kind":"person","person_id":"61p_q6z_g9r","status":"contextual_provisional"},{"id":"c-nanqishu-052-early-literature-complete:p006:m0016","start":16,"end":18,"surface":"弘宗","kind":"person","person_id":"o83_in7_hh6","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-052-early-literature-complete","book_id":"b-nanqishu-052","work_id":"w-nanqishu","source_id":"s-nanqishu-052-early-literature-complete-ws2371079"},{"id":"c-nanqishu-052-early-literature-complete:p007","text":"　　超少好文學，放誕任氣，解褐州西曹。嘗與別駕蕭惠開共事，不爲之下。謂惠開曰：「我與卿俱起一老姥，何足相誇？」蕭太后，惠開之祖姑，長沙王道憐妃，超祖姑也。舉秀才。孝建初，坐事徙梁州，板宣威府參軍。孝武聞超有文章，敕還直東宮，除驃騎參軍、寧蠻主簿，鎮北諮議。超累佐蕃職，不得志，轉尚書度支郎，車騎功曹，桂陽內史。入爲殿中郎，兼中書郎，零陵內史，征北驃騎記室，國子博士，兼左丞。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":25,"last_line":25,"raw_start":824,"raw_end":1011,"raw_character_offsets":[824,825,826,827,828,829,830,831,832,833,834,835,836,837,838,839,840,841,842,843,844,845,846,847,848,849,850,851,852,853,854,855,856,857,858,859,860,861,862,863,864,865,866,867,868,869,870,871,872,873,874,875,876,877,878,879,880,881,882,883,884,885,886,887,888,889,890,891,892,893,894,895,896,897,898,899,900,901,902,903,904,905,906,907,908,909,910,911,912,913,914,915,916,917,918,919,920,921,922,923,924,925,926,927,928,929,930,931,932,933,934,935,936,937,938,939,940,941,942,943,944,945,946,947,948,949,950,951,952,953,954,955,956,957,958,959,960,961,962,963,964,965,966,967,968,969,970,971,972,973,974,975,976,977,978,979,980,981,982,983,984,985,986,987,988,989,990,991,992,993,994,995,996,997,998,999,1000,1001,1002,1003,1004,1005,1006,1007,1008,1009,1010],"revision_id":2371079},"mentions":[{"id":"c-nanqishu-052-early-literature-complete:p007:m0002","start":2,"end":3,"surface":"超","kind":"person","person_id":"61p_q6z_g9r","status":"contextual_provisional"},{"id":"c-nanqishu-052-early-literature-complete:p007:m0023","start":23,"end":26,"surface":"蕭惠開","kind":"person","person_id":"q3q_fgx_aqx","status":"contextual_provisional"},{"id":"c-nanqishu-052-