":"person","person_id":"lcu_lvw_vlk","status":"contextual_provisional","paragraph_id":"c-shiji-031-wu:p007","chapter_id":"c-shiji-031-wu"},{"id":"c-shiji-031-wu:m007-0045","start":45,"end":47,"surface":"子臧","kind":"person","person_id":"lcu_lvw_vlk","status":"contextual_provisional","paragraph_id":"c-shiji-031-wu:p007","chapter_id":"c-shiji-031-wu"},{"id":"c-shiji-031-wu:m007-0090","start":90,"end":92,"surface":"子臧","kind":"person","person_id":"lcu_lvw_vlk","status":"contextual_provisional","paragraph_id":"c-shiji-031-wu:p007","chapter_id":"c-shiji-031-wu"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-jin049-role-zizang","person_id":"lcu_lvw_vlk","surfaces":["子臧"],"scope":"cross_chapter","chapter_ids":["c-jinshu-049-jikang-rendered-comparison","c-shiji-031-wu"],"status":"contextual_provisional","confidence_level":"moderate","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-049","source_id":"s-jinshu049-jikang-web-rendered-comparison","chapter_id":"c-jinshu-049-jikang-rendered-comparison","paragraph_id":"c-jinshu-049-jikang-rendered-comparison:p005","quote":"老子、莊周，吾之師也，親居賤職；柳下惠、東方朔，達人也，安乎卑位。吾豈敢短之哉！又仲尼兼愛，不羞執鞭；子文無欲卿相，而三爲令尹，是乃君子思濟物之意也。所謂達能兼善而不渝，窮則自得而無悶。以此觀之，故知堯、舜之居世，許由之巖棲，子房之佐漢，接輿之行歌，其揆一也。仰瞻數君，可謂能遂其志者也。故君子百行，殊途同致，循性而動，各附所安。故有「處朝廷而不出，入山林而不反」之論。且延陵髙子臧之風，長卿慕相如之節，意氣所先，亦不可奪也。","person_mention_id":"c-jinshu-049-jikang-rendered-comparison:p005:m0189"},{"work_id":"w-shiji","book_id":"b-shiji-031","source_id":"s-shiji-031-wu","chapter_id":"c-shiji-031-wu","paragraph_id":"c-shiji-031-wu:p007","quote":"王諸樊元年，諸樊已除喪，讓位季札。季札謝曰：「曹宣公之卒也，諸侯與曹人不義曹君，將立子臧，子臧去之，以成曹君，君子曰『能守節矣』。君義嗣，誰敢干君！有國，非吾節也。劄雖不材，原附於子臧之義。」吳人固立季札，季札棄其室而耕，乃舍之。秋，吳伐楚，楚敗我師。四年，晉平公初立。","person_mention_id":"c-shiji-031-wu:m007-0042"}],"rationale":"來源本單元角色與語境；保原詞，不按名稱近似補全身份或生平。","source_identity_key":"zizang","human_reviewed":false,"model":null}],"equivalence_decisions"