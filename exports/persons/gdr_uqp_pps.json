retation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0019","surface":"晏","start":19,"end":20,"person_id":"i08_s4b_5bb","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0042","surface":"子良","start":42,"end":44,"person_id":"x3q_cqm_dup","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0052","surface":"僧孺","start":52,"end":54,"person_id":"59d_72d_924_AAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0058","surface":"虞羲","start":58,"end":60,"person_id":"ziv_5l7_sp6","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0061","surface":"丘國賓","start":61,"end":64,"person_id":"gdr_uqp_pps","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0065","surface":"蕭文琰","start":65,"end":68,"person_id":"dvz_fqs_wbq","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0069","surface":"丘令楷","start":69,"end":72,"person_id":"re3_grx_ei8","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0073","surface":"江洪","start":73,"end":75,"person_id":"u3l_j15_ybs","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0076","surface":"劉孝孫","start":76,"end":79,"person_id":"x9x_svk_kwg","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0088","surface":"僧孺","start":88,"end":90,"person_id":"59d_72d_924_AAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0093","surface":"徐夤","start":93,"e