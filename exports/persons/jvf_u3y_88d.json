或死亡。"},{"id":"c-jinshu-049-jikang-rendered-comparison:p001:m0588","start":588,"end":590,"surface":"阮籍","kind":"person","person_id":"6d5_075_29b","status":"contextual_provisional","role_key":"ruanji","source_scope":"received_biographical_narration"},{"id":"c-jinshu-049-jikang-rendered-comparison:p001:m0593","start":593,"end":595,"surface":"山濤","kind":"person","person_id":"4kf_elm_6ww_A","status":"contextual_provisional","role_key":"shantao","source_scope":"received_biographical_narration"},{"id":"c-jinshu-049-jikang-rendered-comparison:p001:m0602","start":602,"end":604,"surface":"向秀","kind":"person","person_id":"jvf_u3y_88d","status":"contextual_provisional","role_key":"xiangxiu","source_scope":"received_biographical_narration"},{"id":"c-jinshu-049-jikang-rendered-comparison:p001:m0607","start":607,"end":609,"surface":"劉伶","kind":"person","person_id":"9py_tkd_wro","status":"contextual_provisional","role_key":"liuling","source_scope":"received_biographical_narration"},{"id":"c-jinshu-049-jikang-rendered-comparison:p001:m0613","start":613,"end":614,"surface":"咸","kind":"person","person_id":"ues_5wk_8tg","status":"contextual_provisional","role_key":"ruanxian","source_scope":"received_biographical_narration"},{"id":"c-jinshu-049-jikang-rendered-comparison:p001:m0617","start":617,"end":619,"surface":"王戎","kind":"person","person_id":"ehx_cqg_nfx_AA","status":"contextual_provisional","role_key":"wangrong","source_scope":"received_biographical_narration"},{"id":"c-jinshu-049-jikang-rendered-comparison:p001:m0638","start":638,"end":639,"surface":"戎","kind":"person","person_id":"ehx_cqg_nfx_AA","status":"contextual_provisional","role_key":"wangrong","source_scope":"received_biographical_narration"},{"id":"c-jinshu-049-jikang-rendered-comparison:p001:m0642","start":642,"end":643,"surface":"康","kind":"person","person_id":"6fg_r6l_5a5","status":"contextual_provisional","role_key":"jikang","source_scope":"received_biographical_narration"}],"chapter_id":"c-jinshu-049-jikang-rendered-comparison","book_id":"b-jinshu-049","work_id":"w-jinshu","source_id":"s-jinshu049-jikang-web-rendered-comparison"},{"id":"c-jinshu-049-jikang-rendered-comparison:p015","text":"初，康居貧，嘗與向秀共鍛於大樹之下，以自贍給。潁川鍾會，貴公子也，精練有才辯，故往造焉。康不爲之禮，而鍛不輟。良久會去，康謂曰：「何所聞而來？何所見而去？」會曰：「聞所聞而來，見所見而去。」會以此憾之。及是，言于文帝曰：「嵇康，臥龍也，不可起。公無憂天下，顧以康爲慮耳。」因譖「康欲助毌丘儉，賴山濤不聽。昔齊戮華士，魯誅少正卯，誠以害時亂教，故聖賢去之。康、安等言論放蕩，非毀典謨，帝王者所不宜容。宜因釁除之，以淳風俗」。帝既昵聽信會，遂并害之。","text_layer":"received_chapter","annotation_status":"in_progress","captured_source_position":{"capture_ref":"source-evidence/jin049-jikang-rendered-comparison/web-rendered-extract.txt","capture_sha256":"29c47ce1cafc7ab2c1318b007e5fd9a4f92bc4c6610cc85d604422533bdfa8eb","projection_ref":"source-evidence/jin049-jikang-rendered-comparison/capture-projection.json","unit_key":"p015","coordinate_scope":"captured_web_tool_output_not_original_or_printed_lines","rendered_reference_line":250},"mentions":[{"id":"c-jinshu-049-jikang-rendered-comparison:p015:m0002","start":2,"end":3,"surface":"康","kind":"person","person_id":"6fg_r6l_5a5","status":"contextual_provisional","role_key":"jikang","source_scope":"received_biographical_narration"},{"id":"c-jinshu-049-jikang-rendered-comparison:p015:m0008","start":8,"end":10,"surface":"向秀","kind":"person","person_id":"jvf_u3y_88d","status":"contextual_provisional","role_key":"xiangxiu","source_scope":"received_biographical_narration"},{"id":"c-jinshu-049-jikang-rendered-comparison:p015:m0025","start":25,"end":27,"surface":"鍾會","kind":"person","person_id":"a6a_4c2_670","status":"contextual_provisional","role_key":"zhonghui","source_scope":"received_biographical_narration"},{"id":"c-jinshu-049-jikang-rendered-comparison:p015:m0044","start":44,"end":45,"surface":"康","kind":"person","person_id":"6fg_r6l_5a5","status":"contextual_provisional","role_key":"jikang","source_scope":"received_biographical_narration"},{"id":"c-jinshu-049-jikang-rendered-comparison:p015:m0057","start":57,"end":58,"surface":"會","kind":"person","person_id":"a6a_4c2_670","st