{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"jvf_u3y_88d","canonical_person_id":"jvf_u3y_88d","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["jvf_u3y_88d"],"persons":[{"id":"jvf_u3y_88d","label":"向秀","status":"active","historicity":"historical_tradition","aliases":[{"surface":"向秀","mention_ids":["c-jinshu-049-jikang-rendered-comparison:p001:m0602","c-jinshu-049-jikang-rendered-comparison:p015:m0008"]}],"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-049","source_id":"s-jinshu049-jikang-web-rendered-comparison","chapter_id":"c-jinshu-049-jikang-rendered-comparison","paragraph_id":"c-jinshu-049-jikang-rendered-comparison:p001","mention_id":"c-jinshu-049-jikang-rendered-comparison:p001:m0602","quote":"向秀"},{"work_id":"w-jinshu","book_id":"b-jinshu-049","source_id":"s-jinshu049-jikang-web-rendered-comparison","chapter_id":"c-jinshu-049-jikang-rendered-comparison","paragraph_id":"c-jinshu-049-jikang-rendered-comparison:p015","mention_id":"c-jinshu-049-jikang-rendered-comparison:p015:m0008","quote":"向秀"}]}],"source_mention_summary":[{"source_id":"s-jinshu049-jikang-web-rendered-comparison","work_id":"w-jinshu","book_id":"b-jinshu-049","chapter_id":"c-jinshu-049-jikang-rendered-comparison","raw_mention_count":2,"mention_ids":["c-jinshu-049-jikang-rendered-comparison:p001:m0602","c-jinshu-049-jikang-rendered-comparison:p015:m0008"],"paragraph_ids":["c-jinshu-049-jikang-rendered-comparison:p001","c-jinshu-049-jikang-rendered-comparison:p015"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-049-jikang-rendered-comparison:p001:m0602","mention_ids":["c-jinshu-049-jikang-rendered-comparison:p001:m0602"],"kind":"paragraph"},{"canonical_mention_id":"c-jinshu-049-jikang-rendered-comparison:p015:m0008","mention_ids":["c-jinshu-049-jikang-rendered-comparison:p015:m0008"],"kind":"paragraph"}],"mention_count":2,"duplicate_mention_count":0,"paragraph_occurrence_count":2,"table_occurrence_count":0,"passage_count":2,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"2處獨立位置，2個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu049-jikang-web-rendered-comparison"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"id":"nc-jin049-literal-xiangxiu","person_id":"jvf_u3y_88d","title":null,"surname":"向","ming":"秀","additional_names":[],"work_id":"w-jinshu","book_id":"b-jinshu-049","chapter_id":"c-jinshu-049-jikang-rendered-comparison","source_id":"s-jinshu049-jikang-web-rendered-comparison","paragraph_id":"c-jinshu-049-jikang-rendered-comparison:p001","person_mention_id":"c-jinshu-049-jikang-rendered-comparison:p001:m0602","quote":"嵇康，字叔夜，譙國銍人也。其先姓奚，會稽上虞人，以避怨，徙焉。銍有嵇山，家於其側，因而命氏。兄喜，有當世才，暦太僕、宗正。康早孤，有奇才，遠邁不群。身長七尺八寸，美詞氣，有風儀，而土木形骸，不自藻飾，人以爲龍章鳳姿，天質自然。恬靜寡欲，含垢匿瑕，寬簡有大量。學不師受，博覽無不該通，長好《老》《莊》。與魏宗室婚，拜中散大夫。常脩養性服食之事，彈琴詠詩，自足於懷。以爲神仙稟之自然，非積學所得，至於導養得理，則安期、彭祖之倫可及，乃著《養生論》。又以爲君子無私，其論曰：「夫稱君子者，心不措乎是非，而行不違乎道者也。何以言之？夫氣靜神虚者，心不存于矜尚；體亮心達者，情不繫於所欲。矜尚不存乎心，故能越名教而任自然；情不繫於所欲，故能審貴賤而通物情。物情順通，故大道無違；越名任心，故是非無措也。是故言君子則以無措爲主，以通物爲美；言小人則以匿情爲非，以違道爲闕。何者？匿情矜吝，小人之至惡；虚心無措，君子之篤行也。是以大道言『及吾無身，吾又何患』。無以生爲貴者，是賢於貴生也。由斯而言，夫至人之用心，固不存有措矣。故曰『君子行道，忘其爲身』，斯言是矣。君子之行賢也，不察於有度而後行也；任心無邪，不議於善而後正也；顯情無措，不論於是而後爲也。是故傲然忘賢，而賢與度會；忽然任心，而心與善遇；儻然無措，而事與是倶也。」其略如此。蓋其胸懷所寄，以髙契難期，毎思郢質。所與神交者惟陳留阮籍、河内山濤，豫其流者河内向秀、沛國劉伶、籍兄子咸、琅邪王戎，遂爲竹林之遊，世所謂「竹林七賢」也。戎自言與康居山陽二十年，未嘗見其喜慍之色。","status":"editorial_provisional","human_reviewed":false,"model":null,"note":"本地web-rendered比較擷取，非固定原raw／武英殿；明文姓名手工分欄。"}],"mentions":[{"id":"c-jinshu-049-jikang-rendered-comparison:p001:m0602","start":602,"end":604,"surface":"向秀","kind":"person","person_id":"jvf_u3y_88d","status":"contextual_provisional","role_key":"xiangxiu","source_scope":"received_biographical_narration","paragraph_id":"c-jinshu-049-jikang-rendered-comparison:p001","chapter_id":"c-jinshu-049-jikang-rendered-comparison"},{"id":"c-jinshu-049-jikang-rendered-comparison:p015:m0008","start":8,"end":10,"surface":"向秀","kind":"person","person_id":"jvf_u3y_88d","status":"contextual_provisional","role_key":"xiangxiu","source_scope":"received_biographical_narration","paragraph_id":"c-jinshu-049-jikang-rendered-comparison:p015","chapter_id":"c-jinshu-049-jikang-rendered-comparison"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-jin049-role-xiangxiu","person_id":"jvf_u3y_88d","surfaces":["向秀"],"scope":"same_chapter","chapter_ids":["c-jinshu-049-jikang-rendered-comparison"],"status":"contextual_provisional","confidence_level":"moderate","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-049","source_id":"s-jinshu049-jikang-web-rendered-comparison","chapter_id":"c-jinshu-049-jikang-rendered-comparison","paragraph_id":"c-jinshu-049-jikang-rendered-comparison:p001","quote":"嵇康，字叔夜，譙國銍人也。其先姓奚，會稽上虞人，以避怨，徙焉。銍有嵇山，家於其側，因而命氏。兄喜，有當世才，暦太僕、宗正。康早孤，有奇才，遠邁不群。身長七尺八寸，美詞氣，有風儀，而土木形骸，不自藻飾，人以爲龍章鳳姿，天質自然。恬靜寡欲，含垢匿瑕，寬簡有大量。學不師受，博覽無不該通，長好《老》《莊》。與魏宗室婚，拜中散大夫。常脩養性服食之事，彈琴詠詩，自足於懷。以爲神仙稟之自然，非積學所得，至於導養得理，則安期、彭祖之倫可及，乃著《養生論》。又以爲君子無私，其論曰：「夫稱君子者，心不措乎是非，而行不違乎道者也。何以言之？夫氣靜神虚者，心不存于矜尚；體亮心達者，情不繫於所欲。矜尚不存乎心，故能越名教而任自然；情不繫於所欲，故能審貴賤而通物情。物情順通，故大道無違；越名任心，故是非無措也。是故言君子則以無措爲主，以通物爲美；言小人則以匿情爲非，以違道爲闕。何者？匿情矜吝，小人之至惡；虚心無措，君子之篤行也。是以大道言『及吾無身，吾又何患』。無以生爲貴者，是賢於貴生也。由斯而言，夫至人之用心，固不存有措矣。故曰『君子行道，忘其爲身』，斯言是矣。君子之行賢也，不察於有度而後行也；任心無邪，不議於善而後正也；顯情無措，不論於是而後爲