_revision":7904122,"paragraph_id":"c-shiji-118-huainan:p006","mention_ids":["c-shiji-118-huainan:m006-0004"],"quote_passage_ref":"data/corpus/shiji/118.json"}],"references":[{"title":"KR2a0002_084.txt所讀133至138行","url":"https://github.com/kanripo/KR2a0002/blob/73c4d2ba067d99a6de924ac952fd6921a958c7e7/KR2a0002_084.txt#L133-L138","source_commit":"73c4d2ba067d99a6de924ac952fd6921a958c7e7","source_blob":"afc3a61a4ff33e6191a04ea465cc403318fc3196","response_sha256":"110b015d9bbb28e0d488826868c2451fcb7c5ac17a99c6aa3697a9fceaac0adf","quote":"<pb:KR2a0002_WYG_084-8a>¶\n令所更定及列侯悉就國其説皆自賈生發之於是天¶\n子議以為賈生任公卿之位絳灌東陽侯馮敬之屬盡¶\n害之乃短賈生曰雒陽之人年少初學專欲擅權紛亂¶\n諸事於是天子後亦疏之不用其議乃以賈生為長沙¶\n王太𫝊賈生旣辭往行聞長沙卑溼自以夀不得長又¶","read_line_range":[133,138],"fetched_line_count":222,"image_verified":false,"quote_format":"kanripo_line_wrapped","display_quote":"令所更定及列侯悉就國其説皆自賈生發之於是天子議以為賈生任公卿之位絳灌東陽侯馮敬之屬盡害之乃短賈生曰雒陽之人年少初學專欲擅權紛亂諸事於是天子後亦疏之不用其議乃以賈生為長沙王太𫝊賈生旣辭往行聞長沙卑溼自以夀不得長又"},{"title":"KR2a0007_048.txt所讀26至32行","url":"https://github.com/kanripo/KR2a0007/blob/683113d4baf6febecaf2ccb7913df87c4d68d454/KR2a0007_048.txt#L26-L32","source_commit":"683113d4baf6febecaf2ccb7913df87c4d68d454","source_blob":"a5a26d8ea2cd894c96f99a3c7cbcecf6bf8f0125","response_sha256":"a0f5a6745124b043065ee02201298382bf14164a41cc2d0d9a134c56f95545f5","quote":"五為官名悉更奏之(師古曰/更改也)文帝謙讓未皇也(師古曰/皇暇也)¶\n(自以為不/當改制)然諸法令所更定及列侯就國其說皆誼發¶\n之于是天子議以誼任公卿之位絳灌東陽侯馮敬之¶\n屬盡害之(師古曰絳絳侯周勃也灌灌嬰也東/陽侯張相如也馮敬時為御史大夫)廼毁誼¶\n曰雒陽之人年少初學専欲擅權紛亂諸事于是天子¶\n後亦疎之不用其議以誼為長沙王太傅誼既以適去¶\n(師古曰適音/謫其下亦同)意不自得及渡湘水(師古曰湘水出零陵/陽海山北流入江也)¶","read_line_range":[26,32],"fetched_line_count":763,"image_verified":false,"quote_format":"kanripo_line_wrapped","display_quote":"五為官名悉更奏之(師古曰更改也)文帝謙讓未皇也(師古曰皇暇也)(自以為不當改制)然諸法令所更定及列侯就國其說皆誼發之于是天子議以誼任公卿之位絳灌東陽侯馮敬之屬盡害之(師古曰絳絳侯周勃也灌灌嬰也東陽侯張相如也馮敬時為御史大夫)廼毁誼曰雒陽之人年少初學専欲擅權紛亂諸事于是天子後亦疎之不用其議以誼為長沙王太傅誼既以適去(師古曰適音謫其下亦同)意不自得及渡湘水(師古曰湘水出零陵陽海山北流入江也)"},{"title":"KR2a0007_048.txt所讀219至224行","url":"https://github.com/kanripo/KR2a0007/blob/683113d4baf6febecaf2ccb7913df87c4d68d454/KR2a0007_048.txt#L219-L224","source_commit":"683113d4baf6febecaf2ccb7913df87c4d68d454","source_blob":"a5a26d8ea2cd894c96f99a3c7cbcecf6bf8f0125","response_sha256":"a0f5a6745124b043065ee02201298382bf14164a41cc2d0d9a134c56f95545f5","quote":"(師古曰不軌謂不/修法制也致至也)幸而來至法安可得加動一親戚天¶\n下圜視而起(應劭曰圜精正視也/師古曰言驚愕也)陛下之臣雖有悍如¶\n馮敬者(如淳曰馮無擇子名忠直為御史大夫奏淮南/厲王誅之師古曰悍勇也○宋祁曰案功臣表)¶\n(非馮無擇子孝文七年/自典客為御史大夫)適啓其口匕首已陷其匈矣(師/古)¶\n<pb:KR2a0007_WYG_048-13a>¶\n(曰始欲發言節制諸/侯王則為刺客所殺)陛下雖賢誰與領此(師古曰/領理也)故疏¶","read_line_range":[219,224],"fetched_line_count":763,"image_verified":false,"quote_format":"kanripo_line_wrapped","display_quote":"(師古曰不軌謂不修法制也致至也)幸而來至法安可得加動一親戚天下圜視而起(應劭曰圜精正視也師古曰言驚愕也)陛下之臣雖有悍如馮敬者(如淳曰馮無擇子名忠直為御史大夫奏淮南厲王誅之師古曰悍勇也○宋祁曰案功臣表)(非馮無擇子孝文七年自典客為御史大夫)適啓其口匕首已陷其匈矣(師古)(曰始欲發言節制諸侯王則為刺客所殺)陛下雖賢誰與領此(師古曰領理也)故疏"}],"rationale":"兩篇均為文帝朝廷馮敬；顏師古釋賈誼事馮敬時為御史大夫，如淳更明連奏淮南厲王之事，據具體事件接合，非全域同名匹配。原典客及代理御史大夫記錄保留，不以時為等注語或宋祁七年說補成無縫任期。父系如淳、宋祁不同說僅列參考，未核所指功臣表原格，不接馮無擇為父。","parentage_reference_disagreement":{"status":"reference_only","default_graph_action":"omit_unproved_parent_edge","source_claims":[{"attribution":"如淳","source_term":"馮無擇子","reference_url":"https://github.com/kanripo/KR2a0007/blob/683113d4baf6febecaf2ccb7913df87c4d68d454/KR2a0007_048.txt#L219-L224","polarity":"affirms_parentage","status":"not_adopted_as_genealogical_edge","source_attribution_term":"如淳曰","raw_quote_span":{"start":73,"end":77,"surface":"馮無擇子"}},{"attribution":"宋祁","source_term":"非馮無擇子","reference_url":"https://github.com/kanripo/KR2a0007/blob/683113d4baf6febecaf2ccb7913df87c4d68d454/KR2a0007_048.txt#L219-L224","polarity":"denies_parentage","status":"not_adopted_as_genealogical_edge","source_attribution_term":"宋祁曰","raw_quote_span":{"start":111,"end":116,"surface":"非馮無擇子"}}],"primary_table_checked":false,"human_reviewed":false},"reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"equivalence_decisions":[],"sources":[{"chapter_id":"c-shiji-084-qujia","work_id":"w-shiji","book_id":"b-shiji-084","source_id":"s-shiji-084-qujia","source_ref":"corpus/shiji/084.json"},{"chapter_id":"c-shiji-118-huain