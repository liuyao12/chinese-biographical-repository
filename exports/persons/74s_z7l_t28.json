tion_ids":["c-shiji-084-qujia:m022-0128"],"paragraph_ids":["c-shiji-084-qujia:p022"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-shiji-084-qujia:m022-0128","mention_ids":["c-shiji-084-qujia:m022-0128"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-shiji118-huainan"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"person_id":"74s_z7l_t28","title":"御史大夫","surname":"馮","ming":"敬","additional_names":[],"chapter_id":"c-shiji-084-qujia","paragraph_id":"c-shiji-084-qujia:p022","quote":"賈生以為漢興至孝文二十餘年，天下和洽，而固當改正朔，易服色，法制度，定官名，興禮樂，乃悉草具其事儀法，色尚黃，數用五，為官名，悉更秦之法。孝文帝初即位，謙讓未遑也。諸律令所更定，及列侯悉就國，其說皆自賈生發之。於是天子議以為賈生任公卿之位。絳、灌、東陽侯、馮敬之屬盡害之，乃短賈生曰：「雒陽之人，年少初學，專欲擅權，紛亂諸事。」於是天子後亦疏之，不用其議，乃以賈生為長沙王太傅。","references":[{"title":"KR2a0002_084.txt所讀133至138行","url":"https://github.com/kanripo/KR2a0002/blob/73c4d2ba067d99a6de924ac952fd6921a958c7e7/KR2a0002_084.txt#L133-L138","source_commit":"73c4d2ba067d99a6de924ac952fd6921a958c7e7","source_blob":"afc3a61a4ff33e6191a04ea465cc403318fc3196","response_sha256":"110b015d9bbb28e0d488826868c2451fcb7c5ac17a99c6aa3697a9fceaac0adf","quote":"<pb:KR2a0002_WYG_084-8a>¶\n令所更定及列侯悉就國其説皆自賈生發之於是天¶\n子議以為賈生任公卿之位絳灌東陽侯馮敬之屬盡¶\n害之乃短賈生曰雒陽之人年少初學專欲擅權紛亂¶\n諸事於是天子後亦疏之不用其議乃以賈生為長沙¶\n王太𫝊賈生旣辭往行聞長沙卑溼自以夀不得長又¶","read_line_range":[133,138],"fetched_line_count":222,"image_verified":false,"quote_format":"kanripo_line_wrapped","display_quote":"令所更定及列侯悉就國其説皆自賈生發之於是天子議以為賈生任公卿之位絳灌東陽侯馮敬之屬盡害之乃短賈生曰雒陽之人年少初學專欲擅權紛亂諸事於是天子後亦疏之不用其議乃以賈生為長沙王太𫝊賈生旣辭往行聞長沙卑溼自以夀不得長又"},{"title":"KR2a0007_048.txt所讀26至32行","url":"https://github.com/kanripo/KR2a0007/blob/683113d4baf6febecaf2ccb7913df87c4d68d454/KR2a0007_048.txt#L26-L32","source_commit":"683113d4baf6febecaf2ccb7913df87c4d68d454","source_blob":"a5a26d8ea2cd894c96f99a3c7cbcecf6bf8f0125","response_sha256":"a0f5a6745124b043065ee02201298382bf14164a41cc2d0d9a134c56f95545f5","quote":"五為官名悉更奏之(師古曰/更改也)文帝謙讓未皇也(師古曰/皇暇也)¶\n(自以為不/當改制)然諸法令所更定及列侯就國其說皆誼發¶\n之于是天子議以誼任公卿之位絳灌東陽侯馮敬之¶\n屬盡害之(師古曰絳絳侯周勃也灌灌嬰也東/陽侯張相如也馮敬時為御史大夫)廼毁誼¶\n曰雒陽之人年少初學専欲擅權紛亂諸事于是天子¶\n後亦疎之不用其議以誼為長沙王太傅誼既以適去¶\n(師古曰適音/謫其下亦同)意不自得及渡湘水(師古曰湘水出零陵/陽海山北流入江也)¶","read_line_range":[26,32],"fetched_line_count":763,"image_verified":false,"quote_format":"kanripo_line_wrapped","display_quote":"五為官名悉更奏之(師古曰更改也)文帝謙讓未皇也(師古曰皇暇也)(自以為不當改制)然諸法令所更定及列侯就國其說皆誼發之于是天子議以誼任公卿之位絳灌東陽侯馮敬之屬盡害之(師古曰絳絳侯周勃也灌灌嬰也東陽侯張相如也馮敬時為御史大夫)廼毁誼曰雒陽之人年少初學専欲擅權紛亂諸事于是天子後亦疎之不用其議以誼為長沙王太傅誼既以適去(師古曰適音謫其下亦同)意不自得及渡湘水(師古曰湘水出零陵陽海山北流入江也)"},{"title":"KR2a0007_048.txt所讀219至224行","url":"https://github.com/kanripo/KR2a0007/blob/683113d4baf6febecaf2ccb7913df87c4d68d454/KR2a0007_048.txt#L219-L224","source_commit":"683113d4baf6febecaf2ccb7913df87c4d68d454","source_blob":"a5a26d8ea2cd894c96f99a3c7cbcecf6bf8f0125","response_sha256":"a0f5a6745124b043065ee02201298382bf14164a41cc2d0d9a134c56f95545f5","quote":"(師古曰不軌謂不/修法制也致至也)幸而來至法安可得加動一親戚天¶\n下圜視而起(應劭曰圜精正視也/師古曰言驚愕也)陛下之臣雖有悍如¶\n馮敬者(如淳曰馮無擇子名忠直為御史大夫奏淮南/厲王誅之師古曰悍勇也○宋祁曰案功臣表)¶\n(非馮無擇子孝文七年/自典客為御史大夫)適啓其口匕首已陷其匈矣(師/古)¶\n<pb:KR2a0007_WYG_048-13a>¶\n(曰始欲發言節制諸/侯王則為刺客所殺)陛下雖賢誰與領此(師古曰/領理也)故疏¶","read_line_range":[219,224],"fetched_line_count":763,"image_verified":false,"quote_format":"kanripo_line_wrapped","display_quote":"(師古曰不軌謂不修法制也致至也)幸而來至法安可得加動一親戚天下圜視而起(應劭曰圜精正視也師古曰言驚愕也)陛下之臣雖有悍如馮敬者(如淳曰馮無擇子名忠直為御史大夫奏淮南厲王誅之師古曰悍勇也○宋祁曰案功臣表)(非馮無擇子孝文七年自典客為御史大夫)適啓其口匕首已陷其匈矣(師古)(曰始欲發言節制諸侯王則為刺客所殺)陛下雖賢誰與領此(師古曰領理也)故疏"}],"note":"原文馮敬按漢代通行姓名形式分存姓馮、名敬；御史大夫據漢書顏師古注與如淳奏淮南事說。此為人物辨讀及常用官稱，非指定賈誼被短當年的精確任期；代理與正授仍分層。","status":"editorial_provisional","human_reviewed":false,"work_id":"w-shiji","book_id":"b-shiji-084","source_id":"s-shiji-084-qujia"}],"mentions":[{"id":"c-shiji-084-qujia:m022-0128","start":128,"end":130,"surface":"馮敬","kind":"person","person_id":"74s_z7l_t28","status":"contextual_provisional","paragraph_id":"c-shiji-084-qujia:p022","chapter_id":"c-shiji-084-qujia"},{"id":"c-shiji-118-huainan:m004-0010","start":10,"end":12,"surface":"馮敬","kind":"person","person_id":"74s_z7l_t28","status":"contextual_provisional","paragraph_id":"c-shiji-118-huainan:p004","chapter_id":"c-shiji-118-huainan"},{"id":"c-shiji-118-huainan:m006-0004","start":4,"end":6,"surface":"臣敬","kind":"person","person_id":"74s_z7l_t28","status":"contextual_provisional","paragraph_id":"c-shiji-118-huainan:p006","chapter_id":"c-shiji-118-huainan"}],"relations":[],"title_holdings":[{"id":"th-shiji118-010","person_id":"74s_z7l_t28","title":"典客","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-118-huainan","source_id":"s-shiji118-huainan","paragraph_id":"c-shiji-118-huainan:p004","quote":"「丞相臣張倉、典客臣馮敬、行御史大夫事宗正臣逸、廷尉臣賀、備盜賊中尉臣福昧死言：淮南王長廢先帝法，不聽天子詔，居處無度，為黃屋蓋乘輿，出入擬於天子，擅為法令，不用漢法。及所置吏，以其郎中春為丞相，聚收漢諸侯人及有罪亡者，匿與居，為治家室，賜其財物爵祿田宅，爵或至關內侯，奉以二千石，所不當得，欲以有為。大夫但、士五開章等七十人與棘蒲侯太子奇謀反，欲以危宗廟社稷。使開章陰告長，與謀使閩越及匈奴發其兵。開章之淮南見長，長數與坐語飲食，為家室娶婦，以二千石俸奉之。開章使人告但，已言之王。春使使報但等。吏覺知，使長安尉奇等往捕開章。長匿不予，與故中尉蕑忌謀，殺以閉口。為棺槨衣衾，葬之肥陵邑，謾吏曰『不知安在』。又詳聚土，樹表其上，曰『開章死，埋此下』。及長身自賊殺無罪者一人；令吏論殺無罪者六人；為亡命棄市罪詐捕命者以除罪；擅罪人，罪人無告劾，繋治城旦舂以上十四人；赦免罪人，死罪十八人，城旦舂以下五十八人；賜人爵關內侯以下九十四人。前日長病，陛下憂苦之，使使者賜書、棗脯。長不欲受賜，不肯見拜使者。南海民處廬江界中者反，淮南吏卒擊之。陛下以淮南民貧苦，遣使者賜長帛五千匹，以賜吏卒勞苦者。長不欲受賜，謾言曰『無勞苦者』。南海民王織上書獻璧皇帝，忌擅燔其書，不以聞。吏請召治忌，長不遣，謾言曰『忌病』。春又請長，願入見，長怒曰『女欲離我自附漢』。長當棄市，臣請論如法。」"}],"attestations":[{"id":"th-shiji118-010:a001","paragraph_id":"c-shiji-118-huainan:p004","start":7,"end":9,"surface":"典客","person_mention_id":"c-shiji-118-huainan:m004-0010","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"明示授封與文獻用稱分存，紀年承接及換算待補；廢勿王明示終點，不以死亡自動終止全部稱號。厲王追謚用稱不等同生前即位。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji118-fengjing-acting-yushi","person_id":"74s_z7l_t28","title":"御史大夫","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-118-huainan","source_id":"s-shiji118-huainan","paragraph_id":"c-shiji-118-huainan:p004","quote":"「丞相臣張倉、典客臣馮敬、行御史大夫事宗正臣逸、廷尉臣賀、備盜賊中尉臣福昧死言：淮南王長廢先帝法，不聽天子詔，居處無度，為黃屋蓋乘輿，出入擬於天子，擅為法令，不用漢法。及所置吏，以其郎中春為丞相，聚收漢諸侯人及有罪亡者，匿與居，為治家室，賜其財物爵祿田宅，爵或至關內侯，奉以二千石，所不當得，欲以有為。大夫但、士五開章等七十人與棘蒲侯太子奇謀反，欲以危宗廟社稷。使開章陰告長，與謀使閩越及匈奴發其兵。開章之淮南見長，長數與坐語飲食，為家室娶婦，以二千石俸奉之。開章使人告但，已言之王。春使使報但等。吏覺知，使長安尉奇等往捕開章。長匿不予，與故中尉蕑忌謀，殺以閉口。為棺槨衣衾，葬之肥陵邑，謾吏曰『不知安在』。又詳聚土，樹表其上，曰『開章死，埋此下』。及長身自賊殺無罪者一人；令吏論殺無罪者六人；為亡命棄市罪詐捕命者以除罪；擅罪人，罪人無告劾，繋治城旦舂以上十四人；赦免罪人，死罪十八人，城旦舂以下五十八人；賜人爵關內侯以下九十四人。前日長病，陛下憂苦之，使使者賜書、棗脯。長不欲受賜，不肯見拜使者。南海民處廬江界中者反，淮南吏卒擊之。陛下以淮南民貧苦，遣使者賜長帛五千匹，以賜吏卒勞苦者。長不欲受賜，謾言曰『無勞苦者』。南海民王織上書獻璧皇帝，忌擅燔其書，不以聞。吏請召治忌，長不遣，謾言曰『忌病』。春又請長，願入見，長怒曰『女欲離我自附漢』。長當棄市，臣請論如法。」"}],"attestations":[{"id":"th-shiji118-fengjing-acting-yushi:a001","paragraph_id":"c-shiji-118-huainan:p004","start":14,"end":18,"surface":"御史大夫","person_mention_id":"c-shiji-118-huainan:m004-0010","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"收到標點保留。依《漢書》同事署名與《史記集解》未句讀原字，暫取馮敬行御史大夫事；宗正逸另職仍存。此為代理任事用稱，不補正式授官年月或任期；宋祁所記三年／七年是注語，不混入正文事件。","reviewer":"Codex（AI 代理）","source_term":"行御史大夫事","appointment_role":"acting","punctuation_attribution":{"kind":"punctuation_resegmentation","source_term":"行御史大夫事","received_segment":"行御史大夫事宗正臣逸","preferred_segmentation":"典客臣馮敬行御史大夫事、宗正臣逸","person_mention_id":"c-shiji-118-huainan:m004-0010","alternative_person_mention_id":"c-shiji-118-huainan:m004-0021","status":"editorial_provisional","human_reviewed":false,"model":null,"rationale":"漢書44明作馮敬行御史大夫事、與宗正廷尉雜奏；集解118無句讀文字亦可如此斷句。不能只按維基底本頓號宣稱兩書在行事者上有實質異文。","references":[{"url":"https://github.com/kanripo/KR2a0007/blob/683113d4baf6febecaf2ccb7913df87c4d68d454/KR2a0007_044.txt#L101-L103","quote":"之廼使使召淮南王王至長安丞相張蒼典客馮敬行¶\n御史大夫事(○宋祁曰孝文三年馮敬/為典客七年為御史大夫)與宗正廷尉雜¶\n奏長廢先帝法不聽天子詔居處無度為黄屋蓋儗天¶","source_blob":"e2143a58b312e7963377044e56322795ef02b5c4","read_line_range":[101,103],"cached_response_sha256":"797f8b04ad85adee4e2bcee68e0ab632ce36eaf212996fee552fffc8e2ae2591","image_verified":false,"title":"《漢書》卷44同事官職署名","source_commit":"683113d4baf6febecaf2ccb7913df87c4d68d454","display_quote":"之廼使使召淮南王王至長安丞相張蒼典客馮敬行御史大夫事(○宋祁曰孝文三年馮敬為典客七年為御史大夫)與宗正廷尉雜奏長廢先帝法不聽天子詔居處無度為黄屋蓋儗天","display_normalization":"僅移除數位頁標、分行、¶與分行用斜線；原字及注語保留，完整排版見quote。"},{"url":"https://github.com/kanripo/KR2a0002/blob/73c4d2ba067d99a6de924ac952fd6921a958c7e7/KR2a0002_118.txt#L42-L45","quote":"匈奴事覺治之使使召淮南王淮南王至長安丞相臣¶\n<pb:KR2a0002_WYG_118-3a>¶\n張蒼典客臣馮敬行御史大夫事宗正臣逸廷尉臣賀¶\n備盜賊中尉臣福昧死言淮南王長廢先帝法不聴天¶","source_blob":"9d2ddd755bfb7f9cca5664cbd23393bc203cb5c9","read_line_range":[42,45],"cached_response_sha256":"8bac741b6f2b3b79e7e1271a6dc0a9ec0bef3f8aa5ee8343e91bb71a042765b0","image_verified":false,"title":"《史記集解》卷118未句讀署名","source_commit":"73c4d2ba067d99a6de924ac952fd6921a958c7e7","display_quote":"匈奴事覺治之使使召淮南王淮南王至長安丞相臣張蒼典客臣馮敬行御史大夫事宗正臣逸廷尉臣賀備盜賊中尉臣福昧死言淮南王長廢先帝法不聴天","display_normalization":"僅移除數位頁標、分行、¶與分行用斜線；原字及注語保留，完整排版見quote。"}]}}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji084-032","person_id":"74s_z7l_t28","scope":"same_chapter","chapter_ids":["c-shiji-084-qujia"],"status":"contextual_provisional","rationale":"本段列名馮敬為短賈誼者；與淮南衡山篇同人另據漢書直接官稱及奏治淮南事件核讀，不由賈生、吳公或列名位置推姓名。","reviewer":"Codex（AI 代理）","surfaces":["馮敬"],"evidence":[{"paragraph_id":"c-shiji-084-qujia:p022","quote":"賈生以為漢興至孝文二十餘年，天下和洽，而固當改正朔，易服色，法制度，定官名，興禮樂，乃悉草具其事儀法，色尚黃，數用五，為官名，悉更秦之法。孝文帝初即位，謙讓未遑也。諸律令所更定，及列侯悉就國，其說皆自賈生發之。於是天子議以為賈生任公卿之位。絳、灌、東陽侯、馮敬之屬盡害之，乃短賈生曰：「雒陽之人，年少初學，專欲擅權，紛亂諸事。」於是天子後亦疏之，不用其議，乃以賈生為長沙王太傅。"}],"human_reviewed":false,"model":null},{"id":"d-shiji118-fengjing-jia-context","person_id":"74s_z7l_t28","surfaces":["馮敬","臣敬"],"scope":"cross_chapter","chapter_ids":["c-shiji-084-qujia","c-shiji-118-huainan"],"status":"contextual_provisional","confidence_level":"high","identification_basis":{"kind":"source_context","target_mention_ids":["c-shiji-084-qujia:m022-0128","c-shiji-118-huainan:m004-0010","c-shiji-118-huainan:m006-0004"]},"evidence":[{"work_id":"w-shiji","book_id":"b-shiji-084","chapter_id":"c-shiji-084-qujia","source_id":"s-shiji-084-qujia","source_revision":1568305,"paragraph_id":"c-shiji-084-qujia:p022","quote":"賈生以為漢興至孝文二十餘年，天下和洽，而固當改正朔，易服色，法制度，定官名，興禮樂，乃悉草具其事儀法，色尚黃，數用五，為官名，悉更秦之法。孝文帝初即位，謙讓未遑也。諸律令所更定，及列侯悉就國，其說皆自賈生發之。於是天子議以為賈生任公卿之位。絳、灌、東陽侯、馮敬之屬盡害之，乃短賈生曰：「雒陽之人，年少初學，專欲擅權，紛亂諸事。」於是天子後亦疏之，不用其議，乃以賈生為長沙王太傅。","mention_ids":["c-shiji-084-qujia:m022-0128"]},{"work_id":"w-shiji","book_id":"b-shiji-118","chapter_id":"c-shiji-118-huainan","source_id":"s-shiji118-huainan","source_revision":7904122,"paragraph_id":"c-shiji-118-huainan:p004","quote":"「丞相臣張倉、典客臣馮敬、行御史大夫事宗正臣逸、廷尉臣賀、備盜賊中尉臣福昧死言：淮南王長廢先帝法，不聽天子詔，居處無度，為黃屋蓋乘輿，出入擬於天子，擅為法令，不用漢法。及所置吏，以其郎中春為丞相，聚收漢諸侯人及有罪亡者，匿與居，為治家室，賜其財物爵祿田宅，爵或至關內侯，奉以二千石，所不當得，欲以有為。大夫但、士五開章等七十人與棘蒲侯太子奇謀反，欲以危宗廟社稷。使開章陰告長，與謀使閩越及匈奴發其兵。開章之淮南見長，長數與坐語飲食，為家室娶婦，以二千石俸奉之。開章使人告但，已言之王。春使使報但等。吏覺知，使長安尉奇等往捕開章。長匿不予，與故中尉蕑忌謀，殺以閉口。為棺槨衣衾，葬之肥陵邑，謾吏曰『不知安在』。又詳聚土，樹表其上，曰『開章死，埋此下』。及長身自賊殺無罪者一人；令吏論殺無罪者六人；為亡命棄市罪詐捕命者以除罪；擅罪人，罪人無告劾，繋治城旦舂以上十四人；赦免罪人，死罪十八人，城旦舂以下五十八人；賜人爵關內侯以下九十四人。前日長病，陛下憂苦之，使使者賜書、棗脯。長不欲受賜，不肯見拜使者。南海民處廬江界中者反，淮南吏卒擊之。陛下以淮南民貧苦，遣使者賜長帛五千匹，以賜吏卒勞苦者。長不欲受賜，謾言曰『無勞苦者』。南海民王織上書獻璧皇帝，忌擅燔其書，不以聞。吏請召治忌，長不遣，謾言曰『忌病』。春又請長，願入見，長怒曰『女欲離我自附漢』。長當棄市，臣請論如法。」","mention_ids":["c-shiji-118-huainan:m004-0010"]},{"work_id":"w-shiji","book_id":"b-shiji-118","chapter_id":"c-shiji-118-huainan","source_id":"s-shiji118-huainan","source_revision":7904122,"paragraph_id":"c-shiji-118-huainan:p006","quote":"「臣倉、臣敬、臣逸、臣福、臣賀昧死言：臣謹與列侯吏二千石臣嬰等四十三人議，皆曰『長不奉法度，不聽天子詔，乃陰聚徒黨及謀反者，厚養亡命，欲以有為』。臣等議論如法。」","mention_ids":["c-shiji-118-huainan:m006-0004"]}],"references":[{"title":"KR2a0002_084.txt所讀133至138行","url":"https://github.com/kanripo/KR2a0002/blob/73c4d2ba067d99a6de924ac952fd6921a958c7e7/KR2a0002_084.txt#L133-L138","source_commit":"73c4d2ba067d99a6de924ac952fd6921a958c7e7","source_blob":"afc3a61a4ff33e6191a04ea465cc403318fc3196","response_sha256":"110b015d9bbb28e0d488826868c2451fcb7c5ac17a99c6aa3697a9fceaac0adf","quote":"<pb:KR2a0002_WYG_084-8a>¶\n令所更定及列侯悉就國其説皆自賈生發之於是天¶\n子議以為賈生任公卿之位絳灌東陽侯馮敬之屬盡¶\n害之乃短賈生曰雒陽之人年少初學專欲擅權紛亂¶\n諸事於是天子後亦疏之不用其議乃以賈生為長沙¶\n王太𫝊賈生旣辭往行聞長沙卑溼自以夀不得長又¶","read_line_range":[133,138],"fetched_line_count":222,"image_verified":false,"quote_format":"kanripo_line_wrapped","display_quote":"令所更定及列侯悉就國其説皆自賈生發之於是天子議以為賈生任公卿之位絳灌東陽侯馮敬之屬盡害之乃短賈生曰雒陽之人年少初學專欲擅權紛亂諸事於是天子後亦疏之不用其議乃以賈生為長沙王太𫝊賈生旣辭往行聞長沙卑溼自以夀不得長又"},{"title":"KR2a0007_048.txt所讀26至32行","url":"https://github.com/kanripo/KR2a0007/blob/683113d4baf6febecaf2ccb7913df87c4d68d454/KR2a0007_048.txt#L26-L32","source_commit":"683113d4baf6febecaf2ccb7913df87c4d68d454","source_blob":"a5a26d8ea2cd894c96f99a3c7cbcecf6bf8f0125","response_sha256":"a0f5a6745124b043065ee02201298382bf14164a41cc2d0d9a134c56f95545f5","quote":"五為官名悉更奏之(師古曰/更改也)文帝謙讓未皇也(師古曰/皇暇也)¶\n(自以為不/當改制)然諸法令所更定及列侯就國其說皆誼發¶\n之于是天子議以誼任公卿之位絳灌東陽侯馮敬之¶\n屬盡害之(師古曰絳絳侯周勃也灌灌嬰也東/陽侯張相如也馮敬時為御史大夫)廼毁誼¶\n曰雒陽之人年少初學専欲擅權紛亂諸事于是天子¶\n後亦疎之不用其議以誼為長沙王太傅誼既以適去¶\n(師古曰適音/謫其下亦同)意不自得及渡湘水(師古曰湘水出零陵/陽海山北流入江也)¶","read_line_range":[26,32],"fetched_line_count":763,"image_verified":false,"quote_format":"kanripo_line_wrapped","display_quote":"五為官名悉更奏之(師古曰更改也)文帝謙讓未皇也(師古曰皇暇也)(自以為不當改制)然諸法令所更定及列侯就國其說皆誼發之于是天子議以誼任公卿之位絳灌東陽侯馮敬之屬盡害之(師古曰絳絳侯周勃也灌灌嬰也東陽侯張相如也馮敬時為御史大夫)廼毁誼曰雒陽之人年少初學専欲擅權紛亂諸事于是天子後亦疎之不用其議以誼為長沙王太傅誼既以適去(師古曰適音謫其下亦同)意不自得及渡湘水(師古曰湘水出零陵陽海山北流入江也)"},{"title":"KR2a0007_048.txt所讀219至224行","url":"https://github.com/kanripo/KR2a0007/blob/683113d4baf6febecaf2ccb7913df87c4d68d454/KR2a0007_048.txt#L219-L224","source_commit":"683113d4baf6febecaf2ccb7913df87c4d68d454","source_blob":"a5a26d8ea2cd894c96f99a3c7cbcecf6bf8f0125","response_sha256":"a0f5a6745124b043065ee02201298382bf14164a41cc2d0d9a134c56f95545f5","quote":"(師古曰不軌謂不/修法制也致至也)幸而來至法安可得加動一親戚天¶\n下圜視而起(應劭曰圜精正視也/師古曰言驚愕也)陛下之臣雖有悍如¶\n馮敬者(如淳曰馮無擇子名忠直為御史大夫奏淮南/厲王誅之師古曰悍勇也○宋祁曰案功臣表)¶\n(非馮無擇子孝文七年/自典客為御史大夫)適啓其口匕首已陷其匈矣(師/古)¶\n<pb:KR2a0007_WYG_048-13a>¶\n(曰始欲發言節制諸/侯王則為刺客所殺)陛下雖賢誰與領此(師古曰/領理也)故疏¶","read_line_range":[219,224],"fetched_line_count":763,"image_verified":false,"quote_format":"kanripo_line_wrapped","display_quote":"(師古曰不軌謂不修法制也致至也)幸而來至法安可得加動一親戚天下圜視而起(應劭曰圜精正視也師古曰言驚愕也)陛下之臣雖有悍如馮敬者(如淳曰馮無擇子名忠直為御史大夫奏淮南厲王誅之師古曰悍勇也○宋祁曰案功臣表)(非馮無擇子孝文七年自典客為御史大夫)適啓其口匕首已陷其匈矣(師古)(曰始欲發言節制諸侯王則為刺客所殺)陛下雖賢誰與領此(師古曰領理也)故疏"}],"rationale":"兩篇均為文帝朝廷馮敬；顏師古釋賈誼事馮敬時為御史大夫，如淳更明連奏淮南厲王之事，據具體事件接合，非全域同名匹配。原典客及代理御史大夫記錄保留，不以時為等注語或宋祁七年說補成無縫任期。父系如淳、宋祁不同說僅列參考，未核所指功臣表原格，不接馮無擇為父。","parentage_reference_disagreement":{"status":"reference_only","default_graph_action":"omit_unproved_parent_edge","source_claims":[{"attribution":"如淳","source_term":"馮無擇子","reference_url":"https://github.com/kanripo/KR2a0007/blob/683113d4baf6febecaf2ccb7913df87c4d68d454/KR2a0007_048.txt#L219-L224","polarity":"affirms_parentage","status":"not_adopted_as_genealogical_edge","source_attribution_term":"如淳曰","raw_quote_span":{"start":73,"end":77,"surface":"馮無擇子"}},{"attribution":"宋祁","source_term":"非馮無擇子","reference_url":"https://github.com/kanripo/KR2a0007/blob/683113d4baf6febecaf2ccb7913df87c4d68d454/KR2a0007_048.txt#L219-L224","polarity":"denies_parentage","status":"not_adopted_as_genealogical_edge","source_attribution_term":"宋祁曰","raw_quote_span":{"start":111,"end":116,"surface":"非馮無擇子"}}],"primary_table_checked":false,"human_reviewed":false},"reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-084-qujia:p022","text":"賈生以為漢興至孝文二十餘年，天下和洽，而固當改正朔，易服色，法制度，定官名，興禮樂，乃悉草具其事儀法，色尚黃，數用五，為官名，悉更秦之法。孝文帝初即位，謙讓未遑也。諸律令所更定，及列侯悉就國，其說皆自賈生發之。於是天子議以為賈生任公卿之位。絳、灌、東陽侯、馮敬之屬盡害之，乃短賈生曰：「雒陽之人，年少初學，專欲擅權，紛亂諸事。」於是天子後亦疏之，不用其議，乃以賈生為長沙王太傅。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m022-0000","start":0,"end":2,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m022-0069","start":69,"end":72,"surface":"孝文帝","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m022-0090","start":90,"end":92,"surface":"列侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代保持未解。"},{"id":"c-shiji-084-qujia:m022-0100","start":100,"end":102,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m022-0107","start":107,"end":109,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m022-0112","start":112,"end":114,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m022-0120","start":120,"end":121,"surface":"絳","kind":"person","person_id":"rjw_tpy_t2f","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m022-0122","start":122,"end":123,"surface":"灌","kind":"person","person_id":"t2y_z4k_z0m","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m022-0124","start":124,"end":127,"surface":"東陽侯","kind":"person","person_id":"08j_zgn_g6d","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m022-0128","start":128,"end":130,"surface":"馮敬","kind":"person","person_id":"74s_z7l_t28","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m022-0130","start":130,"end":132,"surface":"之屬","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代保持未解。"},{"id":"c-shiji-084-qujia:m022-0138","start":138,"end":140,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m022-0166","start":166,"end":168,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m022-0180","start":180,"end":182,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"},{"id":"c-shiji-118-huainan:p004","text":"「丞相臣張倉、典客臣馮敬、行御史大夫事宗正臣逸、廷尉臣賀、備盜賊中尉臣福昧死言：淮南王長廢先帝法，不聽天子詔，居處無度，為黃屋蓋乘輿，出入擬於天子，擅為法令，不用漢法。及所置吏，以其郎中春為丞相，聚收漢諸侯人及有罪亡者，匿與居，為治家室，賜其財物爵祿田宅，爵或至關內侯，奉以二千石，所不當得，欲以有為。大夫但、士五開章等七十人與棘蒲侯太子奇謀反，欲以危宗廟社稷。使開章陰告長，與謀使閩越及匈奴發其兵。開章之淮南見長，長數與坐語飲食，為家室娶婦，以二千石俸奉之。開章使人告但，已言之王。春使使報但等。吏覺知，使長安尉奇等往捕開章。長匿不予，與故中尉蕑忌謀，殺以閉口。為棺槨衣衾，葬之肥陵邑，謾吏曰『不知安在』。又詳聚土，樹表其上，曰『開章死，埋此下』。及長身自賊殺無罪者一人；令吏論殺無罪者六人；為亡命棄市罪詐捕命者以除罪；擅罪人，罪人無告劾，繋治城旦舂以上十四人；赦免罪人，死罪十八人，城旦舂以下五十八人；賜人爵關內侯以下九十四人。前日長病，陛下憂苦之，使使者賜書、棗脯。長不欲受賜，不肯見拜使者。南海民處廬江界中者反，淮南吏卒擊之。陛下以淮南民貧苦，遣使者賜長帛五千匹，以賜吏卒勞苦者。長不欲受賜，謾言曰『無勞苦者』。南海民王織上書獻璧皇帝，忌擅燔其書，不以聞。吏請召治忌，長不遣，謾言曰『忌病』。春又請長，願入見，長怒曰『女欲離我自附漢』。長當棄市，臣請論如法。」","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-118-huainan:m004-0004","start":4,"end":6,"surface":"張倉","kind":"person","person_id":"796_nkw_0jz_A","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m004-0010","start":10,"end":12,"surface":"馮敬","kind":"person","person_id":"74s_z7l_t28","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m004-0021","start":21,"end":23,"surface":"臣逸","kind":"person","person_id":"vhn_2qv_ziz","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m004-0026","start":26,"end":28,"surface":"臣賀","kind":"person","person_id":"nqg_1hv_y1j","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m004-0034","start":34,"end":36,"surface":"臣福","kind":"person","person_id":"nzy_rlh_hfw","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m004-0040","s