{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"t0p_jv4_1p6","canonical_person_id":"t0p_jv4_1p6","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["t0p_jv4_1p6"],"persons":[{"id":"t0p_jv4_1p6","label":"桓彝","status":"active","historicity":"historical_tradition","aliases":[{"surface":"桓彝","mention_ids":["c-jinshu-079-xielang-family:p001:m0027","c-jinshu-093-chupou:line051:m0025"]}],"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-079","chapter_id":"c-jinshu-079-xielang-family","source_id":"s-jinshu-079-xielang-family","paragraph_id":"c-jinshu-079-xielang-family:p001","mention_id":"c-jinshu-079-xielang-family:p001:m0027","quote":"桓彝"},{"work_id":"w-jinshu","book_id":"b-jinshu-093","chapter_id":"c-jinshu-093-chupou","source_id":"s-jinshu-093-chupou","paragraph_id":"c-jinshu-093-chupou:line051","mention_id":"c-jinshu-093-chupou:line051:m0025","quote":"桓彝"}],"identity_note":"固定晉書正文人物；未知母系及父系不補，未名舅不當已知名人，數位小標題不是家世證據。","review":"ai_provisional"}],"source_mention_summary":[{"source_id":"s-jinshu-079-xielang-family","work_id":"w-jinshu","book_id":"b-jinshu-079","chapter_id":"c-jinshu-079-xielang-family","mention_count":1,"mention_ids":["c-jinshu-079-xielang-family:p001:m0027"],"paragraph_ids":["c-jinshu-079-xielang-family:p001"],"table_cell_ids":[],"passage_count":1},{"source_id":"s-jinshu-093-chupou","work_id":"w-jinshu","book_id":"b-jinshu-093","chapter_id":"c-jinshu-093-chupou","mention_count":1,"mention_ids":["c-jinshu-093-chupou:line051:m0025"],"paragraph_ids":["c-jinshu-093-chupou:line051"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-jinshu-079-xielang-family","s-jinshu-093-chupou"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"person_id":"t0p_jv4_1p6","title":null,"surname":"桓","ming":"彝","additional_names":[],"work_id":"w-jinshu","book_id":"b-jinshu-079","chapter_id":"c-jinshu-079-xielang-family","source_id":"s-jinshu-079-xielang-family","paragraph_id":"c-jinshu-079-xielang-family:p001","quote":"謝安，字安石，尚從弟也。父裒，太常卿。安年四歲時，譙郡桓彝見而歎曰：「此兒風神秀徹，後當不減王東海。」及總角，神識沈敏，風宇條暢，善行書。弱冠，詣王蒙，清言良久，既去，蒙子修曰：「向客何如大人？」蒙曰：「此客亹亹，為來逼人。」王導亦深器之。由是少有重名。","note":"按正文具名傳主及親屬語境分姓名；字與名分開，未知日期、世系或稱號不補。胡之為完整雙字名，不將之誤拆為屬格。","status":"editorial_provisional","human_reviewed":false,"model":null}],"mentions":[{"id":"c-jinshu-079-xielang-family:p001:m0027","start":27,"end":29,"surface":"桓彝","kind":"person","person_id":"t0p_jv4_1p6","status":"contextual_provisional","paragraph_id":"c-jinshu-079-xielang-family:p001","chapter_id":"c-jinshu-079-xielang-family"},{"id":"c-jinshu-093-chupou:line051:m0025","start":25,"end":27,"surface":"桓彝","kind":"person","person_id":"t0p_jv4_1p6","status":"contextual_provisional","paragraph_id":"c-jinshu-093-chupou:line051","chapter_id":"c-jinshu-093-chupou"}],"relations":[],"title_holdings":[],"address_assertions":[{"id":"pa-jinshu-093-chupou-51-source_locality_designation-t0p_jv4_1p6","person_id":"t0p_jv4_1p6","relation":"source_locality_designation","place":{"source_name":"譙國","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"source_term":"譙國桓彝","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-093","source_id":"s-jinshu-093-chupou","chapter_id":"c-jinshu-093-chupou","paragraph_id":"c-jinshu-093-chupou:line051","quote":"裒少有簡貴之風，與京兆杜乂俱有盛名，冠于中興。譙國桓彝見而目之曰：「季野有皮裏春秋。」言其外無臧否，而內有所褒貶也。謝安亦雅重之，恆云：「裒雖不言，而四時之氣亦備矣。」初辟西陽王掾、吳王文學。蘇峻之構逆也，車騎將軍郗鑒以裒為參軍。峻平，以功封都鄉亭侯，稍遷司徒從事中郎，除給事黃門侍郎。康帝為琅邪王時，將納妃，妙選素望，詔娉裒女為妃，於是出為豫章太守。及康帝即位，徵拜侍中，遷尚書。以后父，苦求外出，除建威將軍、江州刺史，鎮半洲。在官清約，雖居方伯，恆使私童樵採。頃之，徵為衛將軍，領中書令。裒以中書銓管詔命，不宜以姻戚居之，固讓，詔以為左將卦、兗州刺史、都督兗州徐州之琅邪諸軍事、假節，鎮金城，又領琅邪內史。","person_mention_id":"c-jinshu-093-chupou:line051:m0025"}],"interpretation_note":"只記傳首地望、原文地稱、明示死亡或祔葬地；不換現代行政區，不以官名當籍貫或卒地，也不將親族地望複製給全族。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"qualifiers":{"designation_kind":"geographical_person_reference","origin_or_residence":null}}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-079-xielang-family:p001","text":"謝安，字安石，尚從弟也。父裒，太常卿。安年四歲時，譙郡桓彝見而歎曰：「此兒風神秀徹，後當不減王東海。」及總角，神識沈敏，風宇條暢，善行書。弱冠，詣王蒙，清言良久，既去，蒙子修曰：「向客何如大人？」蒙曰：「此客亹亹，為來逼人。」王導亦深器之。由是少有重名。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-079-xielang-family:p001:m0000","start":0,"end":2,"surface":"謝安","kind":"person","person_id":"aa6_83c_juy_B","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p001:m0004","start":4,"end":6,"surface":"安石","kind":"person","person_id":"aa6_83c_juy_B","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p001:m0007","start":7,"end":8,"surface":"尚","kind":"person","person_id":"e3f_d0s_c13","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p001:m0013","start":13,"end":14,"surface":"裒","kind":"person","person_id":"aa6_83c_juy","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p001:m0019","start":19,"end":20,"surface":"安","kind":"person","person_id":"aa6_83c_juy_B","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p001:m0027","start":27,"end":29,"surface":"桓彝","kind":"person","person_id":"t0p_jv4_1p6","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p001:m0035","start":35,"end":37,"surface":"此兒","kind":"person","person_id":"aa6_83c_juy_B","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p001:m0046","start":46,"end":49,"surface":"王東海","kind":"person","person_id":"xee_d7v_hv2","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p001:m0073","start":73,"end":75,"surface":"王蒙","kind":"person","person_id":"2pg_br4_mcl","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p001:m0084","start":84,"end":85,"surface":"蒙","kind":"person","person_id":"2pg_br4_mcl","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p001:m0086","start":86,"end":87,"surface":"修","kind":"person","person_id":"2pg_br4_mcl_A","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p001:m0098","start":98,"end":99,"surface":"蒙","kind":"person","person_id":"2pg_br4_mcl","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p001:m0113","start":113,"end":115,"surface":"王導","kind":"person","person_id":"7r6_k52_qji_ABAA","status":"contextual_provisional"}],"source_position":{"first_line":27,"last_line":28,"revision_id":2645985,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-079-xielang-family","book_id":"b-jinshu-079","work_id":"w-jinshu","source_id":"s-jinshu-079-xielang-family"},{"id":"c-jinshu-093-chupou:line051","text":"裒少有簡貴之風，與京兆杜乂俱有盛名，冠于中興。譙國桓彝見而目之曰：「季野有皮裏春秋。」言其外無臧否，而內有所褒貶也。謝安亦雅重之，恆云：「裒雖不言，而四時之氣亦備矣。」初辟西陽王掾、吳王文學。蘇峻之構逆也，車騎將軍郗鑒以裒為參軍。峻平，以功封都鄉亭侯，稍遷司徒從事中郎，除給事黃門侍郎。康帝為琅邪王時，將納妃，妙選素望，詔娉裒女為妃，於是出為豫章太守。及康帝即位，徵拜侍中，遷尚書。以后父，苦求外出，除建威將軍、江州刺史，鎮半洲。在官清約，雖居方伯，恆使私童樵採。頃之，徵為衛將軍，領中書令。裒以中書銓管詔命，不宜以姻戚居之，固讓，詔以為左將卦、兗州刺史、都督兗州徐州之琅邪諸軍事、假節，鎮金城，又領琅邪內史。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-093-chupou:line051:m0000","start":0,"end":1,"surface":"裒","kind":"person","person_id":"xke_dj3_6ba_AA","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line051:m0011","start":11,"end":13,"surface":"杜乂","kind":"person","person_id":"a2u_2ji_h68","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line051:m0025","start":25,"end":27,"surface":"桓彝","kind":"person","person_id":"t0p_jv4_1p6","status":"contextual_provi