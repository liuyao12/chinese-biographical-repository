{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"fzy_q9r_vft","canonical_person_id":"fzy_q9r_vft","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["fzy_q9r_vft"],"persons":[{"id":"fzy_q9r_vft","label":"觀寧侯（蕭綸書所稱，未具名）","status":"active","historicity":"historical_tradition","aliases":[],"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-029","chapter_id":"c-liangshu-029-xiaolun-complete","source_id":"s-liangshu-029-xiaolun-complete-ws1538079","paragraph_id":"c-liangshu-029-xiaolun-complete:p006","quote":"觀寧","kind":"person_reference","mention_id":"c-liangshu-029-xiaolun-complete:p006:r0111"}],"review":"ai_provisional","identity_note":"觀寧侯（蕭綸書所稱，未具名），見本組原文及身份互校。"}],"source_mention_summary":[],"most_mentioned_source_ids":[],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[],"relations":[],"title_holdings":[],"address_assertions":[],"person_references":[{"id":"c-liangshu-029-xiaolun-complete:p006:r0111","paragraph_id":"c-liangshu-029-xiaolun-complete:p006","start":111,"end":113,"surface":"觀寧","person_id":"fzy_q9r_vft","referent_role":"third_person","quote":"夫征戰之理，義在克勝；至於骨肉之戰，愈勝愈酷，捷則非功，敗則有喪，勞兵損義，虧失多矣。侯景之軍所以未窺江外者，正爲籓屏盤固，宗鎮強密。若自相魚肉，是代景行師。景便不勞兵力，坐致成效，醜徒聞此，何快如之！又莊鐵小豎作亂，久挾觀寧、懷安二侯，以爲名號，當陽有事克掣，殊廢備境。第聞征伐，復致分兵，便是自於瓜州至於湘、雍，莫非戰地，悉以勞師。侯景卒承虛藉釁，浮江豕突，豈不表裹成虞，首尾難救？可爲寒心，其事已切。弟若苦陷洞庭，兵戈不戢，雍州疑迫，何以自安？必引進魏軍，以求形援。侯景事等內癰，西秦外同瘤腫。直置關中，已爲咽氣，況復貪狼難測，勢必侵吞。弟若不安，家國去矣。吾非有深鑒，獨能弘理，正是採藉風謠，博參物論，咸以爲疑，皆欲解體故耳。","note":"依本段敘事、稱謂及語者受者定。","chapter_id":"c-liangshu-029-xiaolun-complete","book_id":"b-liangshu-029","work_id":"w-liangshu","source_id":"s-liangshu-029-xiaolun-complete-ws1538079"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-029-xiaolun-complete:p006","text":"夫征戰之理，義在克勝；至於骨肉之戰，愈勝愈酷，捷則非功，敗則有喪，勞兵損義，虧失多矣。侯景之軍所以未窺江外者，正爲籓屏盤固，宗鎮強密。若自相魚肉，是代景行師。景便不勞兵力，坐致成效，醜徒聞此，何快如之！又莊鐵小豎作亂，久挾觀寧、懷安二侯，以爲名號，當陽有事克掣，殊廢備境。第聞征伐，復致分兵，便是自於瓜州至於湘、雍，莫非戰地，悉以勞師。侯景卒承虛藉釁，浮江豕突，豈不表裹成虞，首尾難救？可爲寒心，其事已切。弟若苦陷洞庭，兵戈不戢，雍州疑迫，何以自安？必引進魏軍，以求形援。侯景事等內癰，西秦外同瘤腫。直置關中，已爲咽氣，況復貪狼難測，勢必侵吞。弟若不安，家國去矣。吾非有深鑒，獨能弘理，正是採藉風謠，博參物論，咸以爲疑，皆欲解體故耳。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":49,"last_line":49,"raw_start":3784,"raw_end":4101,"raw_character_offsets":[3784,3785,3786,3787,3788,3789,3790,3791,3792,3793,3794,3795,3796,3797,3798,3799,3800,3801,3802,3803,3804,3805,3806,3807,3808,3809,3810,3811,3812,3813,3814,3815,3816,3817,3818,3819,3820,3821,3822,3823,3824,3825,3826,3827,3828,3829,3830,3831,3832,3833,3834,3835,3836,3837,3838,3839,3840,3841,3842,3843,3844,3845,3846,3847,3848,3849,3850,3851,3852,3853,3854,3855,3856,3857,3858,3859,3860,3861,3862,3863,3864,3865,3866,3867,3868,3869,3870,3871,3872,3873,3874,3875,3876,3877,3878,3879,3880,3881,3882,3883,3884,3885,3886,3887,3888,3889,3890,3891,3892,3893,3894,3895,3896,3897,3898,3899,3900,3901,3902,3903,3904,3905,3906,3907,3908,3909,3910,3911,3912,3913,3914,3915,3916,3917,3918,3919,3920,3921,3922,3923,3924,3925,3926,3927,3928,3929,3930,3931,3932,3933,3934,3935,3936,3937,3938,3939,3940,3941,3942,3943,3944,3945,3946,3947,3948,3949,3950,3951,3952,3953,3954,3955,3956,3957,3958,3959,3960,3961,3962,3963,3964,3965,3966,3967,3968,3969,3970,3971,3972,3973,3974,3975,3976,3977,3978,3979,3980,3981,3982,3983,3984,3985,3986,3987,3988,3989,3990,3991,3992,3993,3994,