08-0098","start":98,"end":99,"surface":"王","kind":"person","person_id":"cbr-p002474","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p108","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m108-0125","start":125,"end":126,"surface":"王","kind":"person","person_id":"cbr-p002474","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p108","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m108-0149","start":149,"end":151,"surface":"燕王","kind":"person","person_id":"cbr-p002474","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p108","chapter_id":"c-shiji-043-zhao"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji043-245","person_id":"cbr-p002474","surfaces":["燕王","王"],"scope":"same_chapter","chapter_ids":["c-shiji-043-zhao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-043-zhao:p108","quote":"十五年，以尉文封相國廉頗爲信平君。燕王令丞相栗腹約驤，以五百金爲趙王酒，還歸，報燕王曰：「趙氏壯者皆死長平，其孤未壯，可伐也。」王召昌國君樂閒而問之。對曰：「趙，四戰之國也，其民習兵，伐之不可。」王曰：「吾以衆伐寡，二而伐一，可乎？」對曰：「不可。」王曰：「吾卽以五而伐一，可乎？」對曰：「不可。」燕王大怒。群臣皆以爲可。燕卒起二軍，車二千乘，栗腹將而攻鄗，卿秦將而攻代。廉頗爲趙將，破殺栗腹，虜卿秦、樂閒。"}],"rationale":"限本篇姓名、封授、繼位及連續事件暫接；偃／悼襄王、遷／幽繆王及樂乘／武襄君按明示上下文保存。篇末長安君、燕王、未名太子及文信侯不補名字或按同爵跨時段合併；徒父祺讀法仍待底本核查。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-043-zhao:p108","text":"十五年，以尉文封相國廉頗爲信平君。燕王令丞相栗腹約驤，以五百金爲趙王酒，還歸，報燕王曰：「趙氏壯者皆死長平，其孤未壯，可伐也。」王召昌國君樂閒而問之。對曰：「趙，四戰之國也，其民習兵，伐之不可。」王曰：「吾以衆伐寡，二而伐一，可乎？」對曰：「不可。」王曰：「吾卽以五而伐一，可乎？」對曰：「不可。」燕王大怒。群臣皆以爲可。燕卒起二軍，車二千乘，栗腹將而攻鄗，卿秦將而攻代。廉頗爲趙將，破殺栗腹，虜卿秦、樂閒。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-043-zhao:m108-0010","start":10,"end":12,"surface":"廉頗","kind":"person","person_id":"cbr-p002439","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m108-0013","start":13,"end":16,"surface":"信平君","kind":"person","person_id":"cbr-p002439","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m