angjian:p009:m0023","person_id":"7r6_k52_qji_ABAAAAEAA","start":23,"end":24,"surface":"儉","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanshi-022-wangjian:p009:m0065","person_id":"jyx_72x_8t2","start":65,"end":68,"surface":"褚彥回","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanshi-022-wangjian:p009:m0072","person_id":"7r6_k52_qji_ABAAAAEB","start":72,"end":75,"surface":"王僧虔","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanshi-022-wangjian:p009:m0076","person_id":"5jc_z9b_i2n_AAAA","start":76,"end":79,"surface":"柳世隆","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanshi-022-wangjian:p009:m0082","person_id":"408_ce3_5d8_A","start":82,"end":85,"surface":"沈文季","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanshi-022-wangjian:p009:m0090","person_id":"stv_g27_gl2","start":90,"end":93,"surface":"張敬兒","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanshi-022-wangjian:p009:m0095","person_id":"7r6_k52_qji_ABAAAAEAA","start":95,"end":96,"surface":"儉","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanshi-022-wangjian:p009:m0115","person_id":"usb_lgr_ksa","start":115,"end":117,"surface":"相如","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanshi-022-wangjian:p009:m0142","person_id":"77h_id3_a0i_AA","start":142,"end":144,"surface":"陸澄","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanshi-022-wangjian:p009:m0151","person_id":"fp6_ia6_7yw","start":151,"end":153,"surface":"仲尼","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanshi-022-wangjian:p009:m0156","person_id":"7r6_k52_qji_ABAAAAEAA","start":156,"end