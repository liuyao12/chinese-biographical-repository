","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-nanshi019-chaozong-200-48","person_id":"stv_g27_gl2","event_type":"death","source_term":"誅","date_expression":null,"source_anchor":{"paragraph_id":"c-nanshi-019-chaozong:p006","start":48,"end":49,"surface":"誅"},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-019","chapter_id":"c-nanshi-019-chaozong","source_id":"s-nanshi-019-chaozong-ws1531762","paragraph_id":"c-nanshi-019-chaozong:p006","quote":"武帝即位，使掌國史。除竟陵王征北諮議，領記室，愈不得志。超宗爲子娶張敬兒女爲婦，帝甚疑之。及敬兒誅，超宗謂丹陽尹李安人曰：「往年殺韓信，今年殺彭越，君欲何計？」安人具啟之。上積懷超宗輕慢，使兼中丞袁彖奏超宗請付廷尉。武帝雖可其奏，以彖言辭依違，使左丞王逡之奏彖「輕文略奏，撓法容非，請免彖所居官」。詔「彖匿情欺國，愛朋罔主，免官，禁錮十年」。超宗下廷尉，一宿發白皓首。詔徙越嶲，行至豫章，上敕豫章內史虞悰賜盡，勿傷其形骸。","person_mention_id":"c-nanshi-019-chaozong:p006:m0046"}],"status":"source_attested","interpretation_note":"依傳內死亡動詞；紀年平行正文另存。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"mentions":[{"id":"c-nanqishu-023-wangjian:p008:m0037","person_id":"stv_g27_gl2","kind":"person","status":"contextual_provisional","interpretation_note":"依本段實名及敘述視點。","start":37,"end":40,"surface":"張敬兒","paragraph_id":"c-nanqishu-023-wangjian:p008","chapter_id":"c-nanqishu-023-wangjian"},{"start":33,"end":36,"surface":"張敬兒","id":"c-nanshi-019-chaozong:p006:m0033","person_id":"stv_g27_gl2","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作張敬兒。","paragraph_id":"c-nanshi-019-chaozong:p006","chapter_id":"c-nanshi-019-chaozong"},{"start":46,"end":48,"surface":"敬兒","id":"c-nanshi-019-chaozong:p006:m0046","person_id":"stv_g27_gl2","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作張敬兒。","paragraph_id":"c-nanshi-019-chaozong:p006","chapter_id":"c-nanshi