ldings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji043-200","person_id":"7f0_iw2_xq3","surfaces":["信期"],"scope":"same_chapter","chapter_ids":["c-shiji-043-zhao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-043-zhao:p079","quote":"異日肥義謂信期曰：「公子與田不禮甚可憂也。其於義也聲善而實惡，此爲人也不子不臣。吾聞之也，姦臣在朝，國之殘也；讒臣在中，主之蠹也。此人貪而欲大，内得主而外爲暴。矯令爲慢，以擅一旦之命，不難爲也，禍且逮國。今吾憂之，夜而忘寐，饑而忘食。盜賊出入不可不備。自今以來，若有召王者必見吾面，我將先以身當之，無故而王乃入。」信期曰：「善哉，吾得聞此也！」"}],"rationale":"限本篇人物、連續政治事件及明示生子是為敘事；武靈王／主父、王子何／惠文王及惠后吳娃按本文連接。公子章不與早期敬侯章合併，何不與較早趙何合併；髙信與信期、趙袑與周袑分候選。王賁不按熟知秦將同名接人。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-043-zhao:p079","text":"異日肥義謂信期曰：「公子與田不禮甚可憂也。其於義也聲善而實惡，此爲人也不子不臣。吾聞之也，姦臣在朝，國之殘也；讒臣在中，主之蠹也。此人貪而欲大，内得主而外爲暴。矯令爲慢，以擅一旦之命，不難爲也，禍且逮國。今吾憂之，夜而忘寐，饑而忘食。盜賊出入不可不備。自今以來，若有召王者必見吾面，我將先以身當之，無故而王乃入。」信期曰：「善哉，吾得聞此也！」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-043-zhao:m079-0002","start":2,"end":4,"surface":"肥義","kind":"person","person_id":"5c1_xyw_n3t","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m079-0005","start":5,"end":7,"surface":"信期","kind":"person","person_id":"7f0_iw2_xq3","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m079-0010","start":10,"end":12,"surface":"公子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、代詞、未名君主或版本疑字保留；不把帝王泛稱、父子群體與未決分封當已確證身份或任期。"},{"id":"c-shiji-043-zhao:m079-0013","start":13,"end":16,"surface":"田不禮","kind":"person","person_id":"or0_qxv_dk6","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m079-0023","start":23,"end":24,"surface":"義","kind":"person","person_id":"5c1_xyw_n3t","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m079-0060","start":60,"end":61,"surface":"主","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、代詞、未名君主或版本疑字保留；不把帝王泛稱、父子群體與未決分封當已確證身份或任期。"},{"id":"c-shiji-043-