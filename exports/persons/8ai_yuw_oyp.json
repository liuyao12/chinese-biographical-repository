itle_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji080-003","person_id":"8ai_yuw_oyp","surfaces":["魏文侯"],"scope":"same_chapter","chapter_ids":["c-shiji-080-leyi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-080-leyi:p001","quote":"樂毅者，其先祖曰樂羊。樂羊為魏文侯將，伐取中山，魏文侯封樂羊以靈壽。樂羊死，葬於靈壽，其後子孫因家焉。中山復國，至趙武靈王時復滅中山，而樂氏後有樂毅。"}],"rationale":"樂閒明示為樂毅子，樂叔明示為孫，不補闕代父親；樂乘為樂閒宗不補兄弟。燕王喜來書及趙襄王君序各限本段，曹相國未見名字不回填。河上丈人至蓋公師承不作父子。依本篇明示姓名、君序與來書答書範圍暫接；燕惠王來書寡人指惠王、將軍指樂毅，樂毅答書先王指昭王、足下君王指惠王。伍子胥引古首吳王指闔閭，後吳王在夫差賜鴟夷後指夫差。父兄與群臣不補具體親屬，王齊為反間假說不作授王爵。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-080-leyi:p001","text":"樂毅者，其先祖曰樂羊。樂羊為魏文侯將，伐取中山，魏文侯封樂羊以靈壽。樂羊死，葬於靈壽，其後子孫因家焉。中山復國，至趙武靈王時復滅中山，而樂氏後有樂毅。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-080-leyi:m001-0000","start":0,"end":2,"surface":"樂毅","kind":"person","person_id":"idh_bo6_4kq","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m001-0008","start":8,"end":10,"surface":"樂羊","kind":"person","person_id":"ird_cqk_5eh","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m001-0011","start":11,"end":13,"surface":"樂羊","kind":"person","person_id":"ird_cqk_5eh","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m001-0014","start":14,"end":17,"surface":"魏文侯","kind":"person","person_id":"8ai_yuw_oyp","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m001-0024","start":24,"end":27,"surface":"魏文侯","kind":"person","person_id":"8ai_yuw_oyp","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m001-0028","start":28,"end":30,"surface":"樂羊","kind":"person","person_id":"ird_cqk_5eh","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m001-0034","start":34,"end":36,"surface":"樂羊","kind":"person","person_id":"ird_cqk_5eh","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m001-0043","start":43