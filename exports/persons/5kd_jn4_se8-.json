6,"end":18,"surface":"高祖","kind":"person","person_id":"5kd_jn4_se8","status":"contextual_provisional","paragraph_id":"c-shiji-098-fujin:p010","chapter_id":"c-shiji-098-fujin"},{"id":"c-shiji-098-fujin:m010-0095","start":95,"end":97,"surface":"高祖","kind":"person","person_id":"5kd_jn4_se8","status":"contextual_provisional","paragraph_id":"c-shiji-098-fujin:p010","chapter_id":"c-shiji-098-fujin"},{"id":"c-shiji-098-fujin:m013-0021","start":21,"end":23,"surface":"高祖","kind":"person","person_id":"5kd_jn4_se8","status":"contextual_provisional","paragraph_id":"c-shiji-098-fujin:p013","chapter_id":"c-shiji-098-fujin"}],"relations":[],"title_holdings":[{"id":"th-shiji098-006","person_id":"5kd_jn4_se8","title":"漢王","kind":"royal_rank","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-098-fujin","source_id":"s-shiji-098-fujin","paragraph_id":"c-shiji-098-fujin:p001","quote":"陽陵侯傅寬，以魏五大夫騎將從，為舍人，起橫陽。從攻安陽、杠里，擊趙賁軍於開封，及擊楊熊曲遇、陽武，斬首十二級，賜爵卿。從至霸上。沛公立為漢王，漢王賜寬封號共德君。從入漢中，遷為右騎將。從定三秦，賜食邑雕陰。從擊項籍，待懷，賜爵通德侯。從擊項冠、周蘭、龍且，所將卒斬騎將一人敖下，益食邑。"}],"attestations":[{"id":"th-shiji098-006:a001","paragraph_id":"c-shiji-098-fujin:p001","start":68,"end":70,"surface":"漢王","person_mention_id":"c-shiji-098-fujin:m001-0068","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-098-fujin","source_id":"s-shiji-098-fujin","paragraph_id":"c-shiji-098-fujin:p001","quote":"陽陵侯傅寬，以魏五大夫騎將從，為舍人，起橫陽。從攻安陽、杠里，擊趙賁軍於開封，及擊楊熊曲遇、陽武，斬首十二級，賜爵卿。從至霸上。沛公立為漢王，漢王賜寬封號共德君。從入漢中，遷為右騎將。從定三秦，賜食邑雕陰。從擊項籍，待懷，賜爵通德侯。從擊項冠、周蘭、龍且，所將卒斬騎將一人敖下，益食邑。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"逐傳區分持有人；用稱與授予分存。五歲、一月、二歲等紀年保持原語待換算，死亡不自動作任期終點，字母不作長幼排行。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji098-011","person_id":"5kd_jn4_se8","surfaces":["沛公","漢王","高祖"],"scope":"same_chapter","chapter_ids":["c-shiji-098-fujin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-098-fujin:p001","quote":"陽陵侯傅寬，以魏五大夫騎將從，為舍人，起橫陽。從攻安陽、杠里，擊趙賁軍於開封，及擊楊熊曲遇、陽武，斬首十二級，賜爵卿。從至霸上。沛公立為漢王，漢王賜寬封號共德君。從入漢中，遷為右騎將。從定三秦，賜食邑雕陰。從擊項籍，待懷，賜爵通德侯。從擊項冠、周蘭、龍且，所將卒斬騎將一人敖下，益食邑。"},{"paragraph_id":"c-shiji-098-fujin:p005","quote":"信武侯靳歙，以中涓從，起宛朐。攻濟陽。破李由軍。擊秦軍亳南、開封東北，斬騎千人將一人，首五十七級，捕虜七十三人，賜爵封號臨平君。又戰藍田北，斬車司馬二人，騎長一人，首二十八級，捕虜五十七人。至霸上。沛公立為漢王，賜歙爵建武侯，遷為騎都尉。"},{"paragraph_id":"c-shiji-098-fujin:p010","quote":"蒯成侯緤者，沛人也，姓周氏。常為高祖參乘，以舍人從起沛。至霸上，西入蜀、漢，還定三秦，食邑池陽。東絕甬道，從出度平陰，遇淮陰侯兵襄國，軍乍利乍不利，終無離上心。以緤為信武侯，食邑三千三百戶。高祖十二年，以緤為蒯成侯，除前所食邑。"},{"paragraph_id":"c-shiji-098-fujin:p013","quote":"太史公曰：陽陵侯傅寬、信武侯靳歙皆高爵，從高祖起山東，攻項籍，誅殺名將，破軍降城以十數，未嘗困辱，此亦天授也。蒯成侯周緤操心堅正，身不見疑，上欲有所之，未嘗不垂涕，此有傷心者然，可謂篤厚君子矣。"}],"rationale":"依傅寬、靳歙、周緤分段敘事及明示姓名定位；楚王信與平城下韓信分存，單稱參勃哙敞不補姓，兩位信武侯分持有人，周昌不按同名跨篇合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-098-fujin:p001","text":"陽陵侯傅寬，以魏五大夫騎將從，為舍人，起橫陽。從攻安陽、杠里，擊趙賁軍於開封，及擊楊熊曲遇、陽武，斬首十二級，賜爵卿。從至霸上。沛公立為漢王，漢王賜寬封號共德君。從入漢中，遷為右騎將。從定三秦，賜食邑雕陰。從擊項籍，待懷，賜爵通德侯。從擊項冠、周蘭、龍且，所將卒斬騎將一人敖下，益食邑。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-098-fujin:m001-0000","start":0,"end":3,"surface":"陽陵侯","kind":"person","person_id":"w8j_vnd_rs4","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m001-0003","start":3,"end":5,"surface":"傅寬","kind":"person","person_id":"w8j_vnd_rs4","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m001-0032","start":32,"end":34,"surface":"趙賁","kind":"person","person_id":"hpy_6lu_tc5","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m001-0041","start":41,"end":43,"surface":"楊熊","kind":"person","person_id":"6ek_pen_a4x","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m001-0064","start":64,"end":66,"surface":"沛公","kind":"person","person_id":"5kd_jn4_se8","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m001-0068","start":68