licy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-044-xuxiaosi-complete:p009:m0028","start":28,"end":30,"surface":"許准","kind":"person","person_id":"j3g_eey_m0l","status":"contextual_provisional","paragraph_id":"c-nanqishu-044-xuxiaosi-complete:p009","chapter_id":"c-nanqishu-044-xuxiaosi-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-044-xuxiaosi-complete:p009","text":"　　孝嗣文人，不顯同異，名位雖大，故得未及禍。虎賁中郎將許准有膽力，領軍隷孝嗣，陳說事機，勸行廢立。孝嗣遲疑久之，謂必無用干戈理，須少主出遊，閉城門召百僚集議廢之，雖有此懷，終不能決。羣小亦稍憎孝嗣，勸帝召百僚集議，因誅之。冬，召孝嗣入華林省，遣茹法珍賜藥，孝嗣容色不異，少能飲酒，藥至斗餘，方卒。乃下詔曰：「周德方熙，三監迷叛，漢歷載昌，宰臣構戾，皆身膏斧鉞，族同煙燼。殷鑒上代，垂戒後昆。徐孝嗣憑藉世資，早蒙殊遇，階緣際會，遂登台鉉。匡翼之誠無聞，諂黷之迹屢著。沈文季門世原闕」","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":28,"last_line":28,"raw_start":1867,"raw_end":2108,"raw_character_offsets":[1867,1868,1869,1870,1871,1872,1873,1874,1875,1876,1877,1878,1879,1880,1881,1882,1883,1884,1885,1886,1887,1888,1889,1890,1891,1892,1893,1894,1895,1896,1897,1898,1899,1900,1901,1902,1903,1904,1905,1906,1907,1908,1909,1910,1911,1912,1913,1914,1915,1916,1917,1918,1919,1920,1921,1922,1923,1924,1925,1926,1927,1928,1929,1930,1931,1932,1933,1934,1935,1936,1937,1938,1939,1940,1941,1942,1943,1944,1945,1946,1947,1948,1949,1950,1951,1952,1953,1954,1955,1956,1957,1958,1959,1960,1961,1962,1963,1964,1965,1966,1967,1968,1969,1970,1971,1972,1973,1974,1975,1976,1977,1978,1979,1980,1981,1982,1983,1984,1985,1986,1987,1988,1989,1990,1991,1992,1993,1994,1995,1996,1997,1998,1999,2000,2001,2002,2003,2004,2005,2006,2007,2008,2009,2010,2011,2012,2013,2014,2015,2016,2017,2018,2019,2020,2021,2022,2023,2024,2025,2026,2027,2028,2029,2030,2031,2032,2033,2034,2035,2036,203