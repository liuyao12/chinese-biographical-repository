i-003-yin","book_id":"b-shiji-003","work_id":"w-shiji","source_id":"s-shiji-003-yin"},{"id":"c-shiji-004-zhou:p007","text":"公季卒，子昌立，是為西伯。西伯曰文王，遵后稷、公劉之業，則古公、公季之法，篤仁，敬老，慈少。禮下賢者，日中不暇食以待士，士以此多歸之。伯夷、叔齊在孤竹，聞西伯善養老，盍往歸之。太顛、閎夭、散宜生、鬻子、辛甲大夫之徒皆往歸之。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-004-zhou:m007-0000","start":0,"end":2,"surface":"公季","kind":"person","person_id":"y4i_pjk_4gn","status":"source_identified"},{"id":"c-shiji-004-zhou:m007-0005","start":5,"end":6,"surface":"昌","kind":"person","person_id":"y4i_pjk_4gn_A","status":"source_identified"},{"id":"c-shiji-004-zhou:m007-0010","start":10,"end":12,"surface":"西伯","kind":"person","person_id":"y4i_pjk_4gn_A","status":"source_identified"},{"id":"c-shiji-004-zhou:m007-0013","start":13,"end":15,"surface":"西伯","kind":"person","person_id":"y4i_pjk_4gn_A","status":"source_identified"},{"id":"c-shiji-004-zhou:m007-0016","start":16,"end":18,"surface":"文王","kind":"person","person_id":"y4i_pjk_4gn_A","status":"source_identified"},{"id":"c-shiji-004-zhou:m007-0020","start":20,"end":22,"surface":"后稷","kind":"person","person_id":"jqy_1fv_u7v","status":"source_identified"},{"id":"c-shiji-004-zhou:m007-0023","start":23,"end":25,"surface":"公劉","kind":"person","person_id":"ubt_idy_jr8","status":"source_identified"},{"id":"c-shiji-004-zhou:m007-0029","start":29,"end":31,"surface":"古公","kind":"person","person_id":"5dm_e40_rqh","status":"source_identified"},{"id":"c-shiji-004-zhou:m007-0032","start":32,"end":34,"surface":"公季","kind":"person","person_id":"y4i_pjk_4gn","status":"source_identified"},{"id":"c-shiji-004-zhou:m007-0067","start":67,"end":69,"surface":"伯夷","kind":"person","person_id":"ob6_rla_gka","status":"source_identified"},{"id":"c-shiji-004-zhou:m007-0070","start":70,"end":72,"surface":"叔齊","kind":"person","person_id":"dzg_1wj_d9x","status":"source_identified"},{"id":"c-shiji-004-zhou:m007-0077","start":77,"end":79,"surface":"西伯","kind":"person","person_id":"y4i_pjk_4gn_A","status":"source_identified"},{"id":"c-shiji-004-zhou:m007-0088","start":88,"end":90,"surface":"太顛","kind":"person","person_id":"5pr_wl7_dk1","status":"source_identified"},{"id":"c-shiji-004-zhou:m007-0091","start":91,"end":93,"surface":"閎夭","kind":"person","person_id":"hv8_0ce_lw9","status":"source_identified"},{"id":"c-shiji-004-zhou:m007-0094","start":94,"end":97,"surface":"散宜生","kind":"person","person_id":"1dm_ebc_uzk","status":"source_identified"},{"id":"c-shiji-004-zhou:m007-0098","start":98,"end":100,"surface":"鬻子","kind":"person","person_id":"yql_pki_bko","status":"source_identified"},{"id":"c-shiji-004-zhou:m007-0101","start":101,"end":103,"surface":"辛甲","kind":"person","person_id":"wdr_m9a_k1r","status":"source_identified"}],"chapter_id":"c-shiji-004-zhou","book_id":"b-shiji-004","work_id":"w-shiji","source_id":"s-shiji-004-zhou"},{"id":"c-shiji-004-zhou:p008","text":"崇侯虎譖西伯於殷紂曰：「西伯積善累德，諸侯皆向之，將不利於帝。」帝紂乃囚西伯於羑里。閎夭之徒患之。乃求有莘氏美女，驪戎之文馬，有熊九駟，他奇怪物，因殷嬖臣費仲而獻之紂。紂大說，曰：「此一物足以釋西伯，況其多乎！」乃赦西伯，賜之弓矢斧鉞，使西伯得征伐。曰：「譖西伯者，崇侯虎也。」西伯乃獻洛西之地，以請紂去炮格之刑。紂許之。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-004-zhou:m008-0000","start":0,"end":3,"surface":"崇侯虎","kind":"person","person_id":"hka_te6_9q1","status":"source_identified"},{"id":"c-shiji-004-zhou:m008-0004","start":4,"end":6,"surface":"西伯","kind":"person","person_id":"y4i_pjk_4gn_A","status":"source_identified"},{"id":"c-shiji-004-zhou:m008-0007","start":7,"end":9,"surface":"殷紂","kind":"person","person_id":"lwx_9yq_ad7","status":"source_identified"},{"id":"c-shiji-004-zhou:m008-0012","start":12,"end":14,"surface":"西伯","kind":"person","person_id":"y4i_pjk_4gn_A","status":"source_identified"},{"id":"c-shiji-004-zhou:m008-0032","start":32,"end":34,"surface":"帝紂","kind":"person","person_id":"lwx_9yq_ad7","status":"source_identified"},{"id":"c-shiji-004-zhou:m008-0036","start":36,"end":38,"surface":"西伯","kind":"person","person_id":"y4i_pjk_4gn_A","status":"source_identified"},{"id":"c-shiji-004-zhou:m008-0042","start":42,"end":44,"