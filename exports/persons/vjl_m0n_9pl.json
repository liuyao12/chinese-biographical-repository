hiji-129-huozhi"}],"relations":[],"title_holdings":[{"id":"th-shiji129-004","person_id":"vjl_m0n_9pl","title":"秦始皇帝","kind":"imperial_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-129-huozhi","source_id":"s-shiji129-huozhi","paragraph_id":"c-shiji-129-huozhi:p011","quote":"烏氏倮牧，及眾，斥賣，求奇繒物，閒獻遺戎王。戎王什倍其償，與之畜，畜至用谷量馬牛。秦始皇帝令倮比封君，以時與列臣朝請。而巴[蜀]寡婦清，其先得丹穴，而擅其利數世，家亦不訾。清，寡婦也，能守其業，用財自衛，不見侵犯。秦皇帝以為貞婦而客之，為筑女懷清臺。夫倮鄙人牧長，清窮鄉寡婦，禮抗萬乘，名顯天下，豈非以富邪？"}],"attestations":[{"id":"th-shiji129-004:a001","paragraph_id":"c-shiji-129-huozhi:p011","start":41,"end":45,"surface":"秦始皇帝","person_mention_id":"c-shiji-129-huozhi:m011-0041","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"原句官爵或尊稱用語按原字保存，不推授任年月；比封君、擬於人君與素封是比擬，不記實際爵位。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-129-huozhi:p011","text":"烏氏倮牧，及眾，斥賣，求奇繒物，閒獻遺戎王。戎王什倍其償，與之畜，畜至用谷量馬牛。秦始皇帝令倮比封君，以時與列臣朝請。而巴[蜀]寡婦清，其先得丹穴，而擅其利數世，家亦不訾。清，寡婦也，能守其業，用財自衛，不見侵犯。秦皇帝以為貞婦而客之，為筑女懷清臺。夫倮鄙人牧長，清窮鄉寡婦，禮抗萬乘，名顯天下，豈非以富邪？","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-129-huozhi:m011-0000","start":0,"end":3,"surface":"烏氏倮","kind":"person","person_id":"vlm_env_ap8","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m011-0019","start":19,"end":21,"surface":"戎王","kind":"person","person_id":"vzn_byk_trr","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m011-0022","start":22,"end":24,"surface":"戎王","kind":"person","person_id":"vzn_byk_trr","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m011-0041","start":41,"end":45,"surface":"秦始皇帝","kind":"person","person_id":"vjl_m0n_9pl","status":"contextual_provisional"},{"id":"