visional","paragraph_id":"c-shiji-117-xiangru:p002","chapter_id":"c-shiji-117-xiangru"},{"id":"c-shiji-117-xiangru:m002-0290","start":290,"end":292,"surface":"文君","kind":"person","person_id":"2ph_uqm_vm3","status":"contextual_provisional","paragraph_id":"c-shiji-117-xiangru:p002","chapter_id":"c-shiji-117-xiangru"},{"id":"c-shiji-117-xiangru:m002-0328","start":328,"end":330,"surface":"文君","kind":"person","person_id":"2ph_uqm_vm3","status":"contextual_provisional","paragraph_id":"c-shiji-117-xiangru:p002","chapter_id":"c-shiji-117-xiangru"},{"id":"c-shiji-117-xiangru:m002-0389","start":389,"end":391,"surface":"文君","kind":"person","person_id":"2ph_uqm_vm3","status":"contextual_provisional","paragraph_id":"c-shiji-117-xiangru:p002","chapter_id":"c-shiji-117-xiangru"},{"id":"c-shiji-117-xiangru:m002-0448","start":448,"end":450,"surface":"文君","kind":"person","person_id":"2ph_uqm_vm3","status":"contextual_provisional","paragraph_id":"c-shiji-117-xiangru:p002","chapter_id":"c-shiji-117-xiangru"},{"id":"c-shiji-117-xiangru:m002-0514","start":514,"end":516,"surface":"文君","kind":"person","person_id":"2ph_uqm_vm3","status":"contextual_provisional","paragraph_id":"c-shiji-117-xiangru:p002","chapter_id":"c-shiji-117-xiangru"},{"id":"c-shiji-117-xiangru:m002-0564","start":564,"end":566,"surface":"文君","kind":"person","person_id":"2ph_uqm_vm3","status":"contextual_provisional","paragraph_id":"c-shiji-117-xiangru:p002","chapter_id":"c-shiji-117-xiangru"},{"id":"c-shiji-117-xiangru:m002-0583","start":583,"end":585,"surface":"文君","kind":"person","person_id":"2ph_uqm_vm3","status":"contextual_provisional","paragraph_id":"c-shiji-117-xiangru:p002","chapter_id":"c-shiji-117-xiangru"},{"id":"c-shiji-117-xiangru:m045-0016","start":16,"end":18,"surface":"卓氏","kind":"person","person_id":"2ph_uqm_vm3","status":"contextual_provisional","interpretation_note":"依開篇文君婚姻與卓王孫女尚長卿的連續敘事暫接；不把所有卓氏都當文君，篇末未名妻另留候選。","paragraph_id":"c-shiji-117-xiangru:p045","chapter_id":"c-shiji-117-xiangru"}],"relations":