0488","start":488,"end":490,"surface":"昆弟","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m002-0494","start":494,"end":496,"surface":"王孫","kind":"person","person_id":"lh2_c9g_7vs","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m002-0500","start":500,"end":504,"surface":"一男兩女","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m002-0514","start":514,"end":516,"surface":"文君","kind":"person","person_id":"2ph_uqm_vm3","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m002-0520","start":520,"end":524,"surface":"司馬長卿","kind":"person","person_id":"usb_lgr_ksa","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m002-0525","start":525,"end":527,"surface":"長卿","kind":"person","person_id":"usb_lgr_ksa","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m002-0555","start":555,"end":558,"surface":"卓王孫","kind":"person","person_id":"lh2_c9g_7vs","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m002-0564","start":564,"end":566,"surface":"文君","kind":"person","person_id":"2ph_uqm_vm3","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m002-0583","start":583,"end":585,"surface":"文君","kind":"person","person_id":"2ph_uqm_vm3","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m002-0587","start":587,"end":589,"surface":"相如","kind":"person","person_id":"usb_lgr_ksa","status":"contextual_provisional"}],"chapter_id":"c-shiji-117-xiangru","book_id":"b-shiji-117","work_id":"w-shiji","source_id":"s-shiji117-xiangru"},{"id":"c-shiji-117-xiangru:p045","text":"相如口吃而善著書。常有消渴疾。與卓氏婚，饒於財。其進仕宦，未嘗肯與公卿國家之事，稱病間居，不慕官爵。常從上至長楊獵，是時天子方好自擊熊彘，馳逐野獸，相如上疏諫之。其辭曰：\n臣聞物有同類而殊能者，故力稱烏獲，捷言慶忌，勇期賁、育。臣之愚，竊以為人誠有之，獸亦宜然。今陛下好陵阻險，射猛獸，卒然遇軼材之獸，駭不存之地，犯屬車之清塵，輿不及還轅，人不暇施巧，雖有烏獲、逢蒙之伎，力不得用，枯木朽株盡為害矣。是胡越起於轂下，而羌夷接軫也，豈不殆哉！雖萬全無患，然本非天子之所宜近也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m045-0000","start":0,"end":2,"surface":"相如","kind":"person","person_id":"usb_lgr_ksa","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0016","start":16,"end":18,"surface":"卓氏","kind":"person","person_id":"2ph_uqm_vm3","status":"contextual_provisional","interpretation_note":"依開篇文君婚姻與卓王孫女尚長卿的連續敘事暫接；不把所有卓氏都當文君，篇末未名妻另留候選。"},{"id":"c-shiji-117-xiangru:m045-0052","start":52,"end":53,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0060","start":60,"end":62,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0074","start":74,"end":76,"surface":"相如","kind":"person","person_id":"usb_lgr_ksa","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0100","start":100,"end":102,"surface":"烏獲","kind":"person","person_id":"rzv_0ll_3ty","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0105","start":105,"end":107,"surface":"慶忌","kind":"person","person_id":"n7l_j5p_4wl","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0110","start":110,"end":111,"surface":"賁","kind":"person","person_id":"dwv_5hn_680","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0112","start":112,"end":113,"surface":"育","kind":"person","person_id":"66l_m67_5ie","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0132","start":132,"end":134,"surface":"陛下","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0178","start":178,"end":180,"surface":"烏獲","kind":"person","person_id":"rzv_0ll_3ty","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0181","start":181,"end":183,"surface":"逢蒙","kind":"person","person_id":"11c_i8z_674","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0229","start":229,"end":231,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"}],"chapter_id":"c-shiji-117-xiangru","book_id":"b-shiji-117","work_id":"w-shiji","source_id":"s-shiji117-xiangru"},{"id":"c-shiji-117-xiangru:p056","text":"相如既病免，家居茂陵。天子曰：「司馬相如病甚，可往從悉取其書；若不然，後失之矣。」使所忠往，而相如已死，家無書。問其妻，對曰：「長卿固未嘗有書也。時時著書，人又取去，即空居。長卿未死時，為一卷書，曰有使者來求書，奏之。無他書。」其遺劄書言封禪事，奏所忠。忠奏其書，天子異之。其書曰：","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m056-0000","start":0,"end":2,"surface":"相如","kind":"person","person_id":"usb_lgr_ksa","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m056-0011","start":11,"end":13,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m056-0016","start":16,"end":20,"surface":"司馬相如","kind":"person","person_id":"usb_lgr_ksa","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m056-0042","start":42,"end":44,"surface":"所忠","kind":"person","person_id":"gns_w0b_kfj","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m056-0047","start":47,"end":49,"surface":"相如","kind":"person","person_id":"usb_lgr_ksa","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m056-0057","start":57,"end":59,"surface":"其妻","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"前文文君與相如婚姻可列候選，但取遺書時僅稱其妻，原段未重出姓名，也未明示此間婚姻是否變動，故不把唯一已名配偶自動當作篇末妻子。"},{"id":"c-shiji-117-xiangru:m056-0064","start":64,"end":66,"surface":"長卿","kind":"person","person_id":"usb_lgr_ksa","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m056-0087","start":87,"end":89,"surface":"長卿","kind":"person","person_id":"usb_lgr_ksa","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m056-0124","start":124,"end":126,"surface":"所忠","kind":"person","person_id":"gns_w0b_kfj","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m056-0127","start":127,"end":128,"surface":"忠","kind":"person","person_id":"gns_w0b_kfj","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m056-0132","start":132,"end":134,"su