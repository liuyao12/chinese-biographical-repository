ds":["c-shiji-066-wu:p016","c-shiji-066-wu:p017","c-shiji-066-wu:p018","c-shiji-066-wu:p020"],"passage_count":4}],"most_mentioned_source_ids":["s-shiji-066-wu"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-066-wu:m016-0007","start":7,"end":11,"surface":"越王句踐","kind":"person","person_id":"cbr-p003842","status":"contextual_provisional","paragraph_id":"c-shiji-066-wu:p016","chapter_id":"c-shiji-066-wu"},{"id":"c-shiji-066-wu:m016-0045","start":45,"end":47,"surface":"句踐","kind":"person","person_id":"cbr-p003842","status":"contextual_provisional","paragraph_id":"c-shiji-066-wu:p016","chapter_id":"c-shiji-066-wu"},{"id":"c-shiji-066-wu:m016-0101","start":101,"end":105,"surface":"越王句踐","kind":"person","person_id":"cbr-p003842","status":"contextual_provisional","paragraph_id":"c-shiji-066-wu:p016","chapter_id":"c-shiji-066-wu"},{"id":"c-shiji-066-wu:m016-0154","start":154,"end":156,"surface":"越王","kind":"person","person_id":"cbr-p003842","status":"contextual_provisional","paragraph_id":"c-shiji-066-wu:p016","chapter_id":"c-shiji-066-wu"},{"id":"c-shiji-066-wu:m017-0037","start":37,"end":39,"surface":"句踐","kind":"person","person_id":"cbr-p003842","status":"contextual_provisional","paragraph_id":"c-shiji-066-wu:p017","chapter_id":"c-shiji-066-wu"},{"id":"c-shiji-066-wu:m018-0012","start":12,"end":16,"surface":"越王句踐","kind":"person","person_id":"cbr-p003842","status":"contextual_provisional","paragraph_id":"c-shiji-066-wu:p018","chapter_id":"c-shiji-066-wu"},{"id":"c-shiji-066-wu:m020-0073","start":73,"end":77,"surface":"越王句踐","kind":"person","person_id":"cbr-p003842","status":"contextual_provisional","paragraph_id":"c-shiji-066-wu:p020","chapter_id":"c-shiji-066-wu"},{"id":"c-shiji-066-wu:m020-0107","start":107,"end":111,"surface":"越王句踐","kind":"person","person_id":"cbr-p003842","status":"contextual_provisional","paragraph_id":"c-shiji-066-wu:p020","chapter_id":"c-shiji-066-wu"}],"relations":[],"title_holdings":[{"id":"th-shiji066-017","person_id":"cbr-p003842","title":"越王","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-066-wu","source_id":"s-shiji-066-wu","paragraph_id":"c-shiji-066-wu:p016","quote":"後五年，伐越。越王句踐迎擊，敗吳於姑蘇，傷闔廬指，軍卻。闔廬病創將死，謂太子夫差曰：「爾忘句踐殺爾父乎？」夫差對曰：「不敢忘。」是夕，闔廬死。夫差既立為王，以伯嚭為太宰，習戰射。二年後伐越，敗越於夫湫。越王句踐乃以餘兵五千人棲於會稽之上，使大夫種厚幣遺吳太宰嚭以請和，求委國為臣妾。吳王將許之。伍子胥諫曰：「越王為人能辛苦。今王不滅，後必悔之。」吳王不聽，用太宰嚭計，與越平。"}],"attestations":[{"id":"th-shiji066-017:a001","paragraph_id":"c-shiji-066-wu:p016","start":7,"end":9,"surface":"越王","person_mention_id":"c-shiji-066-wu:m016-0007","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授官事件與文獻用稱分存。首次提及、逃亡、死亡不推定任期終點；平王、昭王、闔廬、夫差王稱隨敘事分辨。夫概自立王不作合法授爵，封堂谿未補侯爵；王子綦佯充王及石乞事成為卿的未遂條件均不當實際任職。白公的號與封邑分存，未確定爵級。來源相對年序未換算為精確紀年，版本及稱號性質仍待覆核。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji066-035","person_id":"cbr-p003842","scope":"same_chapter","chapter_ids":["c-shiji-066-wu"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["句踐","越王","越王句踐"],"evidence":[{"paragraph_id":"c-shiji-066-wu:p016","quote":"後五年，伐越。越王句踐迎擊，敗吳於姑蘇，傷闔廬指，軍卻。闔廬病創將死，謂太子夫差曰：「爾忘句踐殺爾父乎？」夫差對曰：「不敢忘。」是夕，闔廬死。夫差既立為王，以伯嚭為太宰，習戰射。二年後伐越，敗越於夫湫。越王句踐乃以餘兵五千人棲於會稽之上，使大夫種厚幣遺吳太宰嚭以請和，求委國為臣妾。吳王將許之。伍子胥諫曰：「越王為人能辛苦。今王不滅，後必悔之。」吳王不聽，用太宰嚭計，與越平。"},{"paragraph_id":"c-shiji-066-wu:p017","quote":"其後五年，而吳王聞齊景公死而大臣爭寵，新君弱，乃興師北伐齊。伍子胥諫曰：「句踐食不重味，弔死問疾，且欲有所用之也。此人不死，必為吳患。今吳之有越，猶人之有腹心疾也。而王不先越而乃務齊，不亦謬乎！」吳王不聽，伐齊，大敗齊師於艾陵，遂威鄒魯之君以歸。益疏子胥之謀。"},{"paragraph_id":"c-shiji-066-wu:p018","quote":"其後四年，吳王將北伐齊，越王句踐用子貢之謀，乃率其眾以助吳，而重寶以獻遺太宰嚭。太宰嚭既數受越賂，其愛信越殊甚，日夜為言於吳王。吳王信用嚭之計。伍子胥諫曰：「夫越，腹心之病，今信其浮辭詐偽而貪齊。破齊，譬猶石田，無所用之。且盤庚之誥曰：『有顛越不恭，劓殄滅之，俾無遺育，無使易種于茲邑。』此商之所以興。願王釋齊而先越；若不然，後將悔之無及。」而吳王不聽，使子胥於齊。子胥臨行，謂其子曰：「吾數諫王，王不用，吾今見吳之亡矣。汝與吳俱亡，無益也。」乃屬其子於齊鮑牧，而還報吳。"},{"paragraph_id":"c-shiji-066-wu:p020","quote":"吳王既誅伍子胥，遂伐齊。齊鮑氏殺其君悼公而立陽生。吳王欲討其賊，不勝而去。其後二年，吳王召魯衛之君會之橐皋。其明年，因北大會諸侯於黃池，以令周室。越王句踐襲殺吳太子，破吳兵。吳王聞之，乃歸，使使厚幣與越平。後九年，越王句踐遂滅吳，殺王夫差；而誅太宰嚭，以不忠於其君，而外受重賂，與己比周也。"}],"rationale":"依本篇明示姓名及局部敘事暫接異稱：公子光自立為闔廬、軫立為昭王、勝號白公；王稱隨敘事主體分段。王子綦佯充王不接昭王，與後文司馬子綦暫分候選但不斷言異人。悼公與陽生按本文分存，矛盾待版本覆核；鮑氏不強接鮑牧。未名父子只按本段明示保存，不補姓名。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-066-wu:p016","text":"後五年，伐越。越王句踐迎擊，敗吳於姑蘇，傷闔廬指，軍卻。闔廬病創將死，謂太子夫差曰：「爾忘句踐殺爾父乎？」夫差對曰：「不敢忘。」是夕，闔廬死。夫差既立為王，以伯嚭為太宰，習戰射。二年後伐越，敗越於夫湫。越王句踐乃以餘兵五千人棲於會稽之上，使大夫種厚幣遺吳太宰嚭以請和，求委國為臣妾。吳王將許之。伍子胥諫曰：「越王為人能辛苦。今王不滅，後必悔之。」吳王不聽，用太宰嚭計，與越平。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-066-wu:m016-0007","start":7,"end":11,"surface":"越王句踐","kind":"person","person_id":"cbr-p003842","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m016-0021","start":21,"end":23,"surface":"闔廬","kind":"person","person_id":"cbr-p003826","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m016-0028","start":28,"end":30,"surface":"闔廬","kind":"person","person_id":"cbr-p003826","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m016-0036","start":36,"end":40,"surface":"太子夫差","kind":"person","person_id":"cbr-p003840","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m016-0045","start":45,"end":47,"surface":"句踐","kind":"person","person_id":"cbr-p003842","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m016-0049","start":49,"end":50,"surface":"父","kind":"person","person_id":"cbr-p003826","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m016-0053","start":53,"end":55,"surface":"夫差","kind":"person","person_id":"cbr-p003840","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m016-0067","start":67,"end":69,"surface":"闔廬","kind":"person","person_id":"cbr-p003826","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m016-0071","start":71,"end":73,"surface":"夫差","kin