kind":"person","person_id":"ecl_t01_cwr","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m010-0190","start":190,"end":192,"surface":"田橫","kind":"person","person_id":"gcd_ek1_6jn","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m010-0215","start":215,"end":217,"surface":"田橫","kind":"person","person_id":"gcd_ek1_6jn","status":"contextual_provisional"}],"chapter_id":"c-shiji-094-tiandan","book_id":"b-shiji-094","work_id":"w-shiji","source_id":"s-shiji-094-tiandan"},{"id":"c-shiji-094-tiandan:p011","text":"未至三十里，至尸鄉廄置，橫謝使者曰：「人臣見天子當洗沐。」止留。謂其客曰：「橫始與漢王俱南面稱孤，今漢王為天子，而橫乃為亡虜而北面事之，其恥固已甚矣。且吾亨人之兄，與其弟并肩而事其主，縱彼畏天子之詔，不敢動我，我獨不愧於心乎？且陛下所以欲見我者，不過欲一見吾面貌耳。今陛下在洛陽，今斬吾頭，馳三十里閒，形容尚未能敗，猶可觀也。」遂自剄，令客奉其頭，從使者馳奏之高帝。高帝曰：「嗟乎，有以也夫！起自布衣，兄弟三人更王，豈不賢乎哉！」為之流涕，而拜其二客為都尉，發卒二千人，以王者禮葬田橫。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-094-tiandan:m011-0012","start":12,"end":13,"surface":"橫","kind":"person","person_id":"gcd_ek1_6jn","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m011-0038","start":38,"end":39,"surface":"橫","kind":"person","person_id":"gcd_ek1_6jn","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m011-0041","start":41,"end":43,"surface":"漢王","kind":"person","person_id":"m1e_wr1_vgx","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m011-0050","start":50,"end":52,"surface":"漢王","kind":"person","person_id":"m1e_wr1_vgx","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m011-0057","start":57,"end":58,"surface":"橫","kind":"person","person_id":"gcd_ek1_6jn","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m011-0180","start":180,"end":182,"surface":"高帝","kind":"person","person_id":"m1e_wr1_vgx","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m011-0183","start":183,"end":185,"surface":"高帝","kind":"person","person_id":"m1e_wr1_vgx","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m011-0240","start":240,"end":242,"surface":"田橫","kind":"person","person_id":"gcd_ek1_6jn","status":"contextual_provisional"}],"chapter_id":"c-shiji-094-tiandan","book_id":"b-shiji-094","work_id":"w-shiji","source_id":"s-shiji-094-tiandan"},{"id":"c-shiji-094-tiandan:p012","text":"既葬，二客穿其冢旁孔，皆自剄，下從之。高帝聞之，乃大驚，大田橫之客皆賢。吾聞其餘尚五百人在海中，使使召之。至則聞田橫死，亦皆自殺。於是乃知田橫兄弟能得士也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-094-tiandan:m012-0019","start":19,"end":21,"surface":"高帝","kind":"person","person_id":"m1e_wr1_vgx","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m012-0029","start":29,"end":31,"surface":"田橫","kind":"person","person_id":"gcd_ek1_6jn","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m012-0056","start":56,"end":58,"surface":"田橫","kind":"person","person_id":"gcd_ek1_6jn","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m012-0069","start":69,"end":71,"surface":"田橫","kind":"person","person_id":"gcd_ek1_6jn","status":"contextual_provisional"}],"chapter_id":"c-shiji-094-tiandan","book_id":"b-shiji-094","work_id":"w-shiji","source_id":"s-shiji-094-tiandan"}],"sources":[{"chapter_id":"c-shiji-094-tiandan","work_id":"w-shiji","book_id":"b-shiji-094","source_id":"s-shiji-094-tiandan","source":{"title":"史記／卷094","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷094","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷094&oldid=2171897","revision_id":2171897,"accessed_on":"2026-10-09","extent":"13段傳世正文含太史公論，另附1段分層索隱述贊；排除導覽與空白。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{"龁":"齕"},"editorial_readings":[],"extraction_note":"只去外緣空白並明記龁轉齕；田間田閒、大田橫之客皆賢及博（陽）原字保留。","note":"全16個HTML區塊已讀；未核底本影像。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numberin