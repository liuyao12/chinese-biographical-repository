:0,"paragraph_occurrence_count":2,"table_occurrence_count":0,"passage_count":2,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"2處獨立位置，2個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-sanguozhi-046-sun-jian-ws2629010"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-wu046-韶-father","subject_person_id":"s3q_t5v_5oh","object_person_id":"q9f_cb5_6q3","predicate":"father","qualifiers":{"source_term":"與其子韶","lineage":"paternal"},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-046","chapter_id":"c-sanguozhi-046-sun-jian","source_id":"s-sanguozhi-046-sun-jian-ws2629010","paragraph_id":"c-sanguozhi-046-sun-jian:p003","quote":"　　少爲縣吏。年十七，與父共載船至錢唐，會海賊胡玉等從匏里上掠取賈人財物，方於岸上分之，行旅皆住，船不敢進。堅謂父曰：「此賊可擊，請討之。」父曰：「非爾所圖也。」堅行操刀上岸，以手東西指麾，若分部人兵以羅遮賊狀。賊望見，以爲官兵捕之，卽委財物散走。堅追，斬得一級以還。父大驚。由是顯聞，府召署假尉。會稽妖賊許昌起於句章，自稱陽明皇帝，與其子韶扇動諸縣，衆以萬數。堅以郡司馬募召精勇，得千餘人，與州郡合討破之。是歳，熹平元年也。刺史臧旻列上功狀，詔書除堅鹽瀆丞，數歳徙盱眙丞，又徙下邳丞。","subject_person_mention_id":"c-sanguozhi-046-sun-jian:p003:m0170","object_person_mention_id":"c-sanguozhi-046-sun-jian:p003:m0153"}],"status":"source_attested","interpretation_note":"依同段原稱及列名次序。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-046-sun-jian:p003:m0153","surface":"許昌","start":153,"end":155,"kind":"person","person_id":"q9f_cb5_6q3","status":"contextual_provisional","paragraph_id":"c-sanguozhi-046-sun-