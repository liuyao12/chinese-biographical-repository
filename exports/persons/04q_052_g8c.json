{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"04q_052_g8c","canonical_person_id":"04q_052_g8c","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["04q_052_g8c"],"persons":[{"id":"04q_052_g8c","label":"黎晃〔李祚舅、吳將〕","status":"active","historicity":"historical_tradition","aliases":[{"surface":"黎晃","mention_ids":["c-jinshu-057-tao-huang:p004:m0023"]}],"evidence":[{"mention_id":"c-jinshu-057-tao-huang:p004:m0023","paragraph_id":"c-jinshu-057-tao-huang:p004","chapter_id":"c-jinshu-057-tao-huang","quote":"黎晃"}],"review":"ai_provisional","identity_note":"黎晃〔李祚舅、吳將〕，見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-jinshu-057-tao-huang-ws2413329","work_id":"w-jinshu","book_id":"b-jinshu-057","chapter_id":"c-jinshu-057-tao-huang","raw_mention_count":1,"mention_ids":["c-jinshu-057-tao-huang:p004:m0023"],"paragraph_ids":["c-jinshu-057-tao-huang:p004"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-057-tao-huang:p004:m0023","mention_ids":["c-jinshu-057-tao-huang:p004:m0023"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-057-tao-huang-ws2413329"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-057-tao-huang:p004:m0023","surface":"黎晃","start":23,"end":25,"person_id":"04q_052_g8c","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-057-tao-huang:p004","chapter_id":"c-jinshu-057-tao-huang"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-057-tao-huang:p004","text":"九真郡功曹李祚保郡內附，璜遣將攻之，不克。祚舅黎晃隨軍。勸祚令降。祚答曰：「舅自吳將，祚自晉臣，唯力是視耳。」逾時乃拔。皓以璜為使持節、都督交州諸軍事、前將軍、交州牧。武平、九德、新昌土地阻險，夷獠勁悍，曆世不賓，璜征討，開置三郡，及九真屬國三十餘縣。征璜為武昌都督，以合浦太守修允代之。交土人請留璜以千數，於是遣還。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":54,"last_line":54,"raw_start":4454,"raw_end":4613,"raw_character_offsets":[4454,4455,4456,4457,4458,4459,4460,4461,4462,4463,4464,4465,4466,4467,4468,4469,4470,4471,4472,4473,4474,4475,4476,4477,4478,4479,4480,4481,4482,4483,4484,4485,4486,4487,4488,4489,4490,4491,4492,4493,4494,4495,4496,4497,4498,4499,4500,4501,4502,4503,4504,4505,4506,4507,4508,4509,4510,4511,4512,4513,4514,4515,4516,4517,4518,4519,4520,4521,4522,4523,4524,4525,4526,4527,4528,4529,4530,4531,4532,4533,4534,4535,4536,4537,4538,4539,4540,4541,4542,4543,4544,4545,4546,4547,4548,4549,4550,4551,4552,4553,4554,4555,4556,4557,4558,4559,4560,4561,4562,4563,4564,4565,4566,4567,4568,4569,4570,4571,4572,4573,4574,4575,4576,4577,4578,4579,4580,4581,4582,4583,4584,4585,4586,4587,4588,4589,4590,4591,4592,4593,4594,4595,4596,4597,4598,4599,4600,4601,4602,4603,4604,4605,4606,4607,4608,4609,4610,4611,4612],"revision_id":2413329},"mentions":[{"id":"c-jinshu-057-tao-huang:p004:m0005","surface":"李祚","start":5,"end":7,"person_id":"hcp_5hg_l7r","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-tao-huang:p004:m0012","surface":"璜","start":12,"end":13,"person_id":"kjg_7m2_c09","kind"