"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji045-037","person_id":"7r3_beh_4ty","surfaces":["秦昭王"],"scope":"same_chapter","chapter_ids":["c-shiji-045-han"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-045-han:p030","quote":"釐王三年，使公孫喜率周、魏攻秦。秦敗我二十四萬，虜喜伊闕。五年，秦拔我宛。六年，與秦武遂地二百里。十年，秦敗我師于夏山。十二年，與秦昭王會西周而佐秦攻齊。齊敗，湣王出亡。十四年，與秦會兩周閒。二十一年，使暴捐救魏，爲秦所敗，捐走開封。"},{"paragraph_id":"c-shiji-045-han:p032","quote":"桓惠王元年，伐燕。九年，秦拔我陘，城汾旁。十年，秦撃我於太行，我上黨郡守以上黨郡降趙。十四年，秦拔趙上黨，殺馬服子卒四十餘萬於長平。十七年，秦拔我陽城、負黍。二十二年，秦昭王卒。二十四年，秦拔我城皋、滎陽。二十六年，秦悉拔我上黨。二十九年，秦拔我十三城。"}],"rationale":"限本篇明示姓名、號稱、是為與連續敘事；兩位韓武子、韓趙簡子、韓魏文侯及不同時段未名楚王分開。原字及韓姬弒悼公、蟣蝨等疑點不訂正；裸王與回敘指代留待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-045-han:p030","text":"釐王三年，使公孫喜率周、魏攻秦。秦敗我二十四萬，虜喜伊闕。五年，秦拔我宛。六年，與秦武遂地二百里。十年，秦敗我師于夏山。十二年，與秦昭王會西周而佐秦攻齊。齊敗，湣王出亡。十四年，與秦會兩周閒。二十一年，使暴捐救魏，爲秦所敗，捐走開封。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-045-han:m030-0000","start":0,"end":2,"surface":"釐王","kind":"person","person_id":"c0i_eah_y59","status":"contextual_provisional"},{"id":"c-shiji-045-han:m030-0006","start":6,"end":9,"surface":"公孫喜","kind":"person","person_id":"nzo_n0u_8s5","status":"contextual_provisional"},{"id":"c-shiji-045-han:m030-0025","start":25,"end":26,"surface":"喜","kind":"person","person_id":"nzo_n0u_8s5","status":"contextual_provisional"},{"id":"c-shiji-045-han:m030-0065","start":65,"end":68,"surface":"秦昭王","kind":"person","person_id":"7r3_beh_4ty","status":"contextual_provisional"},{"id":"c-shiji-045-han:m030-0080","start":80,"end":82,"surface":"湣王","kind":"person","person_id":"q4s_qe2_uq2","status":"contextual_provisional"},{"id":"c-shiji-045-han:m030-0102","start":102,"end":104,"surface":"暴捐","kind":"person","person_id":"kr3_soq_kkq","status":"contextual_provisional"},{"id":"c-shiji-045-han:m030-0112","start":112,"end":113,"surface":"捐","kind":"person","person_id":"kr3_soq_kkq","status":"contextual_provisional"}],"chapter_id":"c-shiji-045-han","book_id":"b-shiji-045","work_id":"w-shiji","source_id":"s-shiji-045-han"},{"id":"c-shiji-045-han:p032","text":"桓惠王元年，伐燕。九年，秦拔我陘，城汾旁。十年，秦撃我於太行，我上黨郡守以上黨郡降趙。十四年，秦拔趙上黨，殺馬服子卒四十餘萬於長平。十七年，秦拔我陽城、負黍。二十二年，秦昭王卒。二十四年，秦拔我城皋、滎陽。二十六年，秦悉拔我上黨。二十九年，秦拔我十三城。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-045-han:m032-0000","start":0,"end":3,"surface":"桓惠王","kind":"person","person_id":"c0i_eah_y59_A","status":"contextual_provisional"},{"id":"c-shiji-045-han:m032-0032","start":32,"end":36,"surface":"上黨郡守","kind":"person","person_id":"vud_z3k_zfc","status":"contextual_provisional"},{"id":"c-shiji-045-han:m032-0054","start":54,"end":57,"surface":"馬服子","kind":"person","person_id":"7fj_v15_1ej","status":"contextual_provisional"},{"id":"c-shiji-045-han:m032-0084","start":84,"end":87,"surface":"秦昭王","kind":"person","person_id":"7r3_beh_4ty","status":"contextual_provisional"}],"chapter_id":"c-shiji-045-han","book_id":"b-shiji-045","work_id":"w-shiji","source_id":"s-shiji-045-han"}],"sources":[{"chapter_id":"c-shiji-045-han","work_id":"w-shiji","book_id":"b-shiji-045","source_id":"s-shiji-045-han","source":{"title":"史記／卷045","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷045","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷045&oldid=7903607","revision_id":7903607,"accessed_on":"2026-10-09","extent":"36段正文；排除註釋版導覽、2個dd及現代分節標題，只去除段落外緣空白。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"取得時HTML與固定修訂一致；現代分節標題及導覽不當古代正文。保留蟣蝨、韓姬、韓嚴、韓非與非等原字。","note":"已讀全36段數位正文；未核古籍影像、可靠底本或現代研究，首輪不是完成覆核。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":fals