policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin063-liuchang-cousin","subject_person_id":"lop_ice_zia","object_person_id":"d96_1fa_e9a","predicate":"agnatic_cousin","qualifiers":{"source_term":"劉聰遣從弟暢"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-063","chapter_id":"c-jinshu-063-liju","source_id":"s-jinshu-063-liju-ws2025242","paragraph_id":"c-jinshu-063-liju:p004","quote":"時劉琨所假河內太守郭默為劉元海所逼，乞歸於矩，矩將使其甥郭誦迎致之，而不敢進。會劉琨遣參軍張肇，率鮮卑範勝等五百餘騎往長安，屬默被圍，道路不通，將還依邵續，行至矩營，矩謂肇曰：「默是劉公所授，公家之事，知無不為。」屠各舊畏鮮卑，遂邀肇為聲援，肇許之。賊望見鮮卑，不戰而走。誦潛遣輕舟濟河，使勇士夜襲懷城，掩賊留營，又大破之。默遂率其屬歸於矩。後劉聰遣從弟暢步騎三萬討矩，屯于韓王故壘，相去七里，遣使招矩。時暢卒至，矩未暇為備，遣使奉牛酒詐降於暢，潛匿精勇，見其老弱。暢不以為虞，大饗渠帥，人皆醉飽。矩謀夜襲之，兵士以賊眾，皆有懼色。矩令郭誦禱鄭子產祠曰：「君昔相鄭，惡鳥不鳴。凶胡臭羯，何得過庭！」使巫揚言：「東裏有教，當遣神兵相助。」將士聞之，皆踴躍爭進。乃使誦及督護楊璋等選勇敢千人，夜掩暢營，獲鎧馬甚多，斬首數千級，暢僅以身免。","subject_person_mention_id":"c-jinshu-063-liju:p004:m0177","object_person_mention_id":"c-jinshu-063-liju:p004:m0172"}],"status":"source_attested","interpretation_note":"暢明稱從弟。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-063-liju:p004:m0177","surface":"暢","start":177,"end":178,"person_id":"lop_ice_zia","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-063-liju:p004","chapter_id":"c-jinshu-063-liju"},{"id":"c-jinshu-063-liju:p004:m0203","surface":"暢","start":203,"end":204,"person_id":"lop_ice_zia","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-063-liju:p004","chapte