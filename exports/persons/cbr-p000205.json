ntified"},{"id":"c-shiji-004-zhou:m029-0030","start":30,"end":32,"surface":"三女","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官號或文字疑讀；保留錨點，不補熟知姓名或假定同指。"},{"id":"c-shiji-004-zhou:m029-0036","start":36,"end":37,"surface":"母","kind":"person","person_id":"is6_glb_qw5","status":"contextual_provisional","interpretation_note":"依密康公與其母的本段對話；不補姓名。"},{"id":"c-shiji-004-zhou:m029-0124","start":124,"end":126,"surface":"康公","kind":"person","person_id":"ojk_hex_iha","status":"source_identified"},{"id":"c-shiji-004-zhou:m029-0132","start":132,"end":134,"surface":"共王","kind":"person","person_id":"x2m_k5j_fdz","status":"source_identified"},{"id":"c-shiji-004-zhou:m029-0137","start":137,"end":139,"surface":"共王","kind":"person","person_id":"x2m_k5j_fdz","status":"source_identified"},{"id":"c-shiji-004-zhou:m029-0142","start":142,"end":145,"surface":"懿王艱","kind":"person","person_id":"3jt_de3_wuf","status":"source_identified"}],"chapter_id":"c-shiji-004-zhou","book_id":"b-shiji-004","work_id":"w-shiji","source_id":"s-shiji-004-zhou"},{"id":"c-shiji-004-zhou:p030","text":"懿王之時，王室遂衰，詩人作刺。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-004-zhou:m030-0000","start":0,"end":2,"surface":"懿王","kind":"person","person_id":"3jt_de3_wuf","status":"source_identified"}],"chapter_id":"c-shiji-004-zhou","book_id":"b-shiji-004","work_id":"w-shiji","source_id":"s-shiji-004-zhou"},{"id":"c-shiji-004-zhou:p031","text":"懿王崩，共王弟辟方立，是為孝王。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-004-zhou:m031-0000","start":0,"end":2,"surface":"懿王","kind":"person","person_id":"3jt_de3_wuf","status":"source_identified"},{"id":"c-shiji-004-zhou:m031-0004","start":4,"end":6,"surface":"共王","kind":"person","person_id":"x2m_k5j_fdz","status":"source_identified"},{"id":"c-shiji-004-zhou:m031-0007","start":7,"end":9,"surface":"辟方","kind":"person","person_id":"3s4_d8d_8v7","status":"source_identified"},{"id":"c-shiji-004-zhou:m031-0013","start":