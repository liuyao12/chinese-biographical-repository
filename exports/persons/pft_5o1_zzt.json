-jin:m067-0123","start":123,"end":126,"surface":"釐負羈","kind":"person","person_id":"pft_5o1_zzt","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p067","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m067-0144","start":144,"end":147,"surface":"僖負羈","kind":"person","person_id":"pft_5o1_zzt","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p067","chapter_id":"c-shiji-039-jin"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji035-093","person_id":"pft_5o1_zzt","surfaces":["僖負羈","釐負羈"],"scope":"same_chapter","chapter_ids":["c-shiji-035-guancai"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-035-guancai:p036","quote":"共公十六年，初，晉公子重耳其亡過曹，曹君無禮，欲觀其駢脅。釐負羈諫，不聽，私善於重耳。二十一年，晉文公重耳伐曹，虜共公以歸，令軍毋入釐負羈之宗族閭。或說晉文公曰：「昔齊桓公會諸侯，復異姓；今君囚曹君，滅同姓，何以令於諸侯？」晉乃復歸共公。"},{"paragraph_id":"c-shiji-035-guancai:p043","quote":"太史公曰：余尋曹共公之不用僖負羈，乃乘軒者三百人，知唯德之不建。及振鐸之夢，豈不欲引曹之祀者哉？如公孫彊不修厥政，叔鐸之祀忽諸。"}],"rationale":"依文王子同母十人、蔡曹君世系、蔡女船中事件、楚公子圍弒其王及城濮／伐曹的具體敘事暫定異稱。郟敖／夾敖按同一事件、釐／僖負羈按本卷論贊暫同指；不同國與同國不同世代的同名者分開。匿名者、校勘及跨篇同指仍待核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji039-112","person_id":"pft_5o1_zzt","surfaces":["僖負羈","曹大夫釐負羈","負羈","釐負羈"],"scope":"cross_chapter","chapter_ids":["c-shiji-035-guancai","c-shiji-039-jin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-035-guancai:p036","quote":"共公十六年，初，晉公子重耳其亡過曹，曹君無禮，欲觀其駢脅。釐負羈諫，不聽，私善於重耳。二十一年，晉文公重耳伐曹，虜共公以歸，令軍毋入釐負羈之宗族閭。或說晉文公曰：「昔齊桓公會諸侯，復異姓；今君囚曹君，滅同姓，何以令於諸侯？」晉乃復歸共公。"},{"paragraph_id":"c-shiji-039-jin:p055","quote":"過曹，曹共公不禮，欲觀重耳駢脅。曹大夫釐負羈曰：「晉公子賢，又同姓，窮來過我，柰何不禮！」共公不從其謀。負羈乃私遺重耳食，置璧其下。重耳受其食，還其璧。"},{"paragraph_id":"c-shiji-039-jin:p067","quote":"五年春，晉文公欲伐曹，假道於衞，衞人弗許。還自河南度，侵曹，伐衞。正月，取五鹿。二月，晉侯、齊侯盟于斂盂。衞侯請盟晉，晉人不許。衞侯欲與楚，國人不欲，故出其君以説晉。衞侯居襄牛，公子買守衞。楚救衞，不卒。晉侯圍曹。三月丙午，晉師入曹，數之以其不用釐負羈言，而用美女乘軒者三百人也。令軍毋入僖負羈宗家以報德。楚圍宋，宋復告急晉。文公欲救則攻楚，爲楚嘗有德，不欲伐也；欲釋宋，宋又嘗有德於晉：患之。先軫曰：「執曹伯，分曹、衞地以與宋，楚急曹、衞，其勢宜釋宋。」於是文公從之，而楚成王乃引兵歸。"}],"rationale":"按本篇明示名與稱號、晉世系與具體事件暫定所列提及同指；附各段原文，未按同字短名全域合併；紀年與版本差異待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-035-guancai:p036","text":"共公十六年，初，晉公子重耳其亡過曹，曹君無禮，欲觀其駢脅。釐負羈諫，不聽，私善於重耳。二十一年，晉文公重耳伐曹，虜共公以歸，令軍毋入釐負羈之宗族閭。或說晉文公曰：「昔齊桓公會諸侯，復異姓；今君囚曹君，滅同姓，何以令於諸侯？」晉乃復歸共公。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-035-guancai:m036-0000","start":0,"end":2,"surface":"共公","kind":"person","person_id":"vs4_n7e_1qh_AAAAA","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m036-0008","start":8,"end":13,"surface":"晉公子重耳","kind":"person","person_id":"6di_ywz_ju4_AAA","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m036-0018","start":18,"end":20,"surface":"曹君","kind":"person","person_id":"vs4_n7e_1qh_AAAAA","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m036-0029","start":29,"end":32,"surface":"釐負羈","kind":"person","person_id":"pft_5o1_zzt","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m036-0040","start":40,"end":42,"surface":"重耳","kind":"person","person_id":"6di_ywz_ju4_AAA","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m036-0048","start":48,"end":53,"surface":"晉文公重耳","kind":"person","person_id":"6di_ywz_ju4_AAA","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m036-0057","start":57,"end":59,"surface":"共公","kind":"person","person_id":"vs4_n7e_1qh_AAAAA","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m036-0066","start":66,"end":69,"surface":"釐負羈","kind":"person","person_id":"pft_5o1_zzt","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m036-0076","start":76,"end":79,"surface":"晉文公","kind":"person","person_id":"6di_ywz_ju4_AAA","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m036-0083","start":83,"end":86,"surface":"齊桓公","kind":"person","person_id":"9w2_c77_53m","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m036-0097","start":