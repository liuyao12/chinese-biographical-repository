{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p005236","identity_policy":"contextual_provisional","person_ids":["cbr-p005236"],"persons":[{"id":"cbr-p005236","label":"陳餘（田儋列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"陳餘","mention_ids":["c-shiji-094-tiandan:m006-0131","c-shiji-094-tiandan:m007-0018"]}],"evidence":[{"mention_id":"c-shiji-094-tiandan:m006-0131","chapter_id":"c-shiji-094-tiandan","paragraph_id":"c-shiji-094-tiandan:p006","quote":"陳餘"},{"mention_id":"c-shiji-094-tiandan:m007-0018","chapter_id":"c-shiji-094-tiandan","paragraph_id":"c-shiji-094-tiandan:p007","quote":"陳餘"}]}],"mentions":[{"id":"c-shiji-094-tiandan:m006-0131","start":131,"end":133,"surface":"陳餘","kind":"person","person_id":"cbr-p005236","status":"contextual_provisional","paragraph_id":"c-shiji-094-tiandan:p006","chapter_id":"c-shiji-094-tiandan"},{"id":"c-shiji-094-tiandan:m007-0018","start":18,"end":20,"surface":"陳餘","kind":"person","person_id":"cbr-p005236","status":"contextual_provisional","paragraph_id":"c-shiji-094-tiandan:p007","chapter_id":"c-shiji-094-tiandan"}],"relations":[],"title_holdings":[{"id":"th-shiji094-015","person_id":"cbr-p005236","title":"將","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-094-tiandan","source_id":"s-shiji-094-tiandan","paragraph_id":"c-shiji-094-tiandan:p006","quote":"項羽既存趙，降章邯等，西屠咸陽，滅秦而立侯王也，乃徙齊王田市更王膠東，治即墨。齊將田都從共救趙，因入關，故立都為齊王，治臨淄。故齊王建孫田安，項羽方渡河救趙，田安下濟北數城，引兵降項羽，項羽立田安為濟北王，治博陽。田榮以負項梁不肯出兵助楚、趙攻秦，故不得王；趙將陳餘亦失職，不得王：二人俱怨項王。"}],"attestations":[{"id":"th-shiji094-015:a001","paragraph_id":"c-shiji-094-tiandan:p006","start":130,"end":131,"surface":"將","person_mention_id":"c-shiji-094-tiandan:m006-0131","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"實授、自立、用稱分存；擬封蒯通安期生及拒受、田橫來大者王小者侯均不作已授。王膠東保留原稱王，不造正文未見膠東王字串；死亡被虜亡走不自動終止爵位。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji094-024","person_id":"cbr-p005236","surfaces":["陳餘"],"scope":"same_chapter","chapter_ids":["c-shiji-094-tiandan"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-094-tiandan:p006","quote":"項羽既存趙，降章邯等，西屠咸陽，滅秦而立侯王也，乃徙齊王田市更王膠東，治即墨。齊將田都從共救趙，因入關，故立都為齊王，治臨淄。故齊王建孫田安，項羽方渡河救趙，田安下濟北數城，引兵降項羽，項羽立田安為濟北王，治博陽。田榮以負項梁不肯出兵助楚、趙攻秦，故不得王；趙將陳餘亦失職，不得王：二人俱怨項王。"},{"paragraph_id":"c-shiji-094-tiandan:p007","quote":"項王既歸，諸侯各就國，田榮使人將兵助陳餘，令反趙地，而榮亦發兵以距擊田都，田都亡走楚。田榮留齊王市，無令之膠東。市之左右曰：「項王彊暴，而王當之膠東，不就國，必危。」市懼，乃亡就國。田榮怒，追擊殺齊王市於即墨，還攻殺濟北王安。於是田榮乃自立為齊王，盡并三齊之地。"}],"rationale":"明示姓名與局部敘事承接，短稱及田間田閒等異字仍待覆核，不按全域同名合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-094-tiandan:p006","text":"項羽既存趙，降章邯等，西屠咸陽，滅秦而立侯王也，乃徙齊王田市更王膠東，治即墨。齊將田都從共救趙，因入關，故立都為齊王，治臨淄。故齊王建孫田安，項羽方渡河救趙，田安下濟北數城，引兵降項羽，項羽立田安為濟北王，治博陽。田榮以負項梁不肯出兵助楚、趙攻秦，故不得王；趙將陳餘亦失職，不得王：二人俱怨項王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-094-tiandan:m006-0000","start":0,"end":2,"surface":"項羽","kind":"person","person_id":"cbr-p005234","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m006-0007","start":7,"end":9,"surface":"章邯","kind":"person","person_id":"cbr-p005230","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m006-0026","start":26,"end":30,"surface":"齊王田市","kind":"person","person_id":"cbr-p005213","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m006-0041","start":41,"end":43,"surface":"田都","kind":"person","person_id":"cbr-p005235","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m006-0054","start":54,"end":55,"surface":"都","kind":"person","person_id":"cbr-p005235","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m006-0064","start":64,"end":67,"surface":"齊王建","kind":"person","person_id":"cbr-p005217","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m006-0068","start":68,"end":70,"surface":"田安","kind":"person","person_id":"cbr-p005214","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m006-0071","start":71,"end":73,"surface":"項羽","kind":"person","person_id":"cbr-p005234","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m006-0079","start":79,"end":81,"surface":"田安","kind":"person","person_id":"cbr-p005214","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m006-0090","start":90,"end":92,"surface":"項羽","kind":"person","person_id":"cbr-p005234","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m006-0093","start":93,"end":95,"surface":"項羽","kind":"person","person_id":"cbr-p005234","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m006-0096","start":96,"end":98,"surface":"田安","kind":"person","person_id":"cbr-p005214","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m006-0107","start":107,"end":109,"surface":"田榮","kind":"person","person_id":"cbr-p005226","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m006-0111","start":111,"end":113,"surface":"項梁","kind":"person","person_id":"cbr-p005233","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m006-0131","start":131,"end":133,"surface":"陳餘","kind":"person","person_id":"cbr-p005236","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m006-0145","start":145,"end":147,"surface":"項王","kind":"person","person_id":"cbr-p005234","status":"contextual_provisional"}],"chapter_id":"c-shiji-094-tiandan","book_id":"b-shiji-094","work_id":"w-shiji","source_id":"s-shiji-094-tiandan"},{"id":"c-shiji-094-tiandan:p007","text":"項王既歸，諸侯各就國，田榮使人將兵助陳餘，令反趙地，而榮亦發兵以距擊田都，田都亡走楚。田榮留齊王市，無令之膠東。市之左右曰：「項王彊暴，而王當之膠東，不就國，必危。」市懼，乃亡就國。田榮怒，追擊殺齊王市於即墨，還攻殺濟北王安。於是田榮乃自立為齊王，盡并三齊之地。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-094-tiandan:m007-0000","start":0,"end":2,"surface":"項王","kind":"person","