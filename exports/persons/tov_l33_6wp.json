ths":[],"mentions":[{"id":"c-jinshu-066-liuhong:p005:m0066","surface":"辛冉","start":66,"end":68,"person_id":"tov_l33_6wp","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-066-liuhong:p005","chapter_id":"c-jinshu-066-liuhong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-066-liuhong:p005","text":"惠帝幸長安，河間王顒挾天子，詔弘為劉喬繼援。弘以張方殘暴，知顒必敗，遣使受東海王越節度。時天下大亂，弘專督江漢，威行南服。前廣漢太守辛冉說弘以從橫之事，弘大怒，斬之。河間王顒使張光為順陽太守，南陽太守衛展說弘曰：「彭城王前東奔，有不善之言。張光，太宰腹心，宜斬光以明向背。」弘曰：「宰輔得失，豈張光之罪！危人自安，君子弗為也。」展深恨之。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":18,"last_line":18,"raw_start":1998,"raw_end":2169,"raw_character_offsets":[2000,2001,2002,2003,2004,2005,2006,2007,2008,2009,2010,2011,2012,2013,2014,2015,2016,2017,2018,2019,2020,2021,2022,2023,2024,2025,2026,2027,2028,2029,2030,2031,2032,2033,2034,2035,2036,2037,2038,2039,2040,2041,2042,2043,2044,2045,2046,2047,2048,2049,2050,2051,2052,2053,2054,2055,2056,2057,2058,2059,2060,2061,2062,2063,2064,2065,2066,2067,2068,2069,2070,2071,2072,2073,2074,2075,2076,2077,2078,2079,2080,2081,2082,2083,2084,2085,2086,2087,2088,2089,2090,2091,2092,2093,2094,2095,2096,2097,2098,2099,2100,2101,2102,2103,2104,2105,2106,2107,2108,2109,2110,2111,2112,2113,2114,2115,2116,2117,2118,2119,2120,2121,2122,2123,2124,2125,2126,2127,2128,2129,2130,2131,2132,2133,2134,2135,2136,2137,2138,2139,2140,2141,2142,2143,2144,2145,2146,2147,2148,2149,2150,2151,2152,2153,2154,2155,2156,2157,2158,2159,2160,2161,2162,2163,2164,2165,2166,2167,2168],"revision_id":1527632},"mentions":[{"id":"c-jinshu-066-liuhong:p005:m0000","surface":"惠帝","start":0,"end":2,"person_id":"7e0_f69_1ac","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-liuhong:p005:m0006","surface":"河間王顒","start":6,"end":10,"person_id":"ed0_313