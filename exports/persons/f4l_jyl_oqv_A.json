:"contextual_provisional"},{"id":"c-shiji-113-nanyue:m007-0240","start":240,"end":241,"surface":"王","kind":"person","person_id":"f4l_jyl_oqv_A","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m007-0242","start":242,"end":245,"surface":"王太后","kind":"person","person_id":"3q4_zsp_jwy","status":"contextual_provisional"}],"chapter_id":"c-shiji-113-nanyue","book_id":"b-shiji-113","work_id":"w-shiji","source_id":"s-shiji113-nanyue"},{"id":"c-shiji-113-nanyue:p008","text":"其相呂嘉年長矣，相三王，宗族官仕為長吏者七十餘人，男盡尚王女，女盡嫁王子兄弟宗室，及蒼梧秦王有連。其居國中甚重，越人信之，多為耳目者，得眾心愈於王。王之上書，數諫止王，王弗聽。有畔心，數稱病不見漢使者。使者皆注意嘉，勢未能誅。王、王太后亦恐嘉等先事發，乃置酒，介漢使者權，謀誅嘉等。使者皆東鄉，太后南鄉，王北鄉，相嘉、大臣皆西鄉，侍坐飲。嘉弟為將，將卒居宮外。酒行，太后謂嘉曰：「南越內屬，國之利也，而相君苦不便者，何也？」以激怒使者。使者狐疑相杖，遂莫敢發。嘉見耳目非是，即起而出。太后怒，欲鏦嘉以矛，王止太後。嘉遂出，分其弟兵就舍，稱病，不肯見王及使者。乃陰與大臣作亂。王素無意誅嘉，嘉知之，以故數月不發。太后有淫行，國人不附，欲獨誅嘉等，力又不能。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-113-nanyue:m008-0002","start":2,"end":4,"surface":"呂嘉","kind":"person","person_id":"jfm_184_2yb","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m008-0009","start":9,"end":11,"surface":"三王","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-113-nanyue:m008-0012","start":12,"end":14,"surface":"宗族","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-113-nanyue:m008-0028","start":28,"end":30,"surface":"王女","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-113-nanyue:m008-0034","start":34,"end":40,"surface":"王子兄弟宗室","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-113-nanyue:m008-0042","start":42,"end":46,"surface":"蒼梧秦王","kind":"person","person_id":"8m2_avf_zfe","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m008-0072","start":72,"end":73,"surface":"王","kind":"person","person_id":"f4l_jyl_oqv_A","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m008-0074","start":74,"end":75,"surface":"王","kind":"person","person_id":"f4l_jyl_oqv_A","status":"contex