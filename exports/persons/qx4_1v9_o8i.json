l_provisional","paragraph_id":"c-shiji-111-wei-huo:p003","chapter_id":"c-shiji-111-wei-huo"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji111-003","person_id":"qx4_1v9_o8i","surfaces":["陳掌","掌"],"scope":"same_chapter","chapter_ids":["c-shiji-111-wei-huo"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-111-wei-huo:p003","quote":"青壯，為侯家騎，從平陽主。建元二年春，青姊子夫得入宮幸上。皇后，堂邑大長公主女也，無子，妒。大長公主聞衛子夫幸，有身，妒之，乃使人捕青。青時給事建章，未知名。大長公主執囚青，欲殺之。其友騎郎公孫敖與壯士往篡取之，以故得不死。上聞，乃召青為建章監，侍中，及同母昆弟貴，賞賜數日閒累千金。孺為太僕公孫賀妻。少兒故與陳掌通，上召貴掌。公孫敖由此益貴。子夫為夫人。青為大中大夫。"}],"rationale":"少兒故與陳掌通後，上召貴掌接同一敘事姓名；通不作正式婚姻。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-111-wei-huo:p003","text":"青壯，為侯家騎，從平陽主。建元二年春，青姊子夫得入宮幸上。皇后，堂邑大長公主女也，無子，妒。大長公主聞衛子夫幸，有身，妒之，乃使人捕青。青時給事建章，未知名。大長公主執囚青，欲殺之。其友騎郎公孫敖與壯士往篡取之，以故得不死。上聞，乃召青為建章監，侍中，及同母昆弟貴，賞賜數日閒累千金。孺為太僕公孫賀妻。少兒故與陳掌通，上召貴掌。公孫敖由此益貴。子夫為夫人。青為大中大夫。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-111-wei-huo:m003-0000","start":0,"end":1,"surface":"青","kind":"person","person_id":"5dd_l1c_6g8","status":"contextual_provisional"},{"id":"c-shiji-111-wei-huo:m003-0004","start":4,"end":5,"surface":"侯","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-111-wei-huo:m003-0009","start":9,"end":12,"surface":"平陽主","kind":"person","person_id":"nad_18h_5jc","status":"contextual_provisional"},{"id":"c-shiji-111-wei-huo:m003-0019","start":19,"end":20,"surface":"青","kind":"person","person_id":"5dd_l1c_6g8","status":"contextual_provisional"},{"id":"c-shiji-111-wei-huo:m003-0021","start":21,"end":23,"surface":"子夫","kind":"person","person_id":"l5c_h8i_d5q","status":"contextual_provisional"},{"id":"c-shiji-111-wei-huo:m003-0027","start":27,"end":28,"surface":"上","kind":"person","person_id":"yqp_nlb_p1