[],"mentions":[{"id":"c-jinshu-064-simaxi:p002:m0151","surface":"新蔡王晃","start":151,"end":155,"person_id":"l0b_vw0_lp6","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-064-simaxi:p002","chapter_id":"c-jinshu-064-simaxi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-064-simaxi:p002","text":"晞無學術而有武幹，為桓溫所忌。及簡文帝即位，溫乃表晞曰：「晞體自皇極，故寵靈光世，不能率由王度，修己慎行，而聚納輕剽，苞藏亡命。又息綜矜忍，虐加於人。袁真叛逆，事相連染。頃自猜懼，將成亂階。請免晞官，以王歸籓，免其世子綜官，解子㻱散騎常侍。」㻱以梁王隨晞，晞既見黜，送馬八十五匹、三百人杖以歸溫。溫又逼新蔡王晃使自誣與晞、綜及著作郎殷涓、太宰長史庾倩、掾曹秀、舍人劉彊等謀逆，遂收付廷尉，請誅之。簡文帝不許，溫於是奏徙新安郡，家屬悉從之，而族誅殷涓等，廢晃徙沖陽郡。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":79,"last_line":79,"raw_start":4555,"raw_end":4927,"raw_character_offsets":[4557,4558,4559,4560,4561,4562,4563,4564,4565,4566,4567,4568,4569,4570,4571,4572,4573,4574,4575,4576,4577,4578,4579,4580,4581,4582,4583,4584,4585,4586,4587,4588,4589,4590,4591,4592,4593,4594,4595,4596,4597,4598,4599,4600,4601,4602,4603,4604,4605,4606,4607,4608,4609,4610,4611,4612,4613,4614,4615,4616,4617,4618,4619,4620,4621,4622,4623,4624,4625,4666,4667,4668,4669,4670,4671,4672,4673,4674,4675,4676,4677,4678,4679,4680,4681,4682,4683,4684,4685,4686,4687,4688,4689,4690,4691,4692,4693,4694,4695,4696,4697,4698,4699,4700,4701,4702,4703,4704,4705,4706,4707,4708,4709,4710,4711,4712,4713,4714,4715,4716,4717,4718,4719,4720,4721,4722,4723,4724,4725,4726,4727,4728,4729,4730,4731,4732,4733,4734,4735,4736,4737,4738,4739,4740,4741,4742,4743,4744,4745,4746,4747,4748,4749,4750,4751,4752,4753,4754,4755,4756,4757,4758,4759,4760,4761,4762,4763,4764,4765,4766,4767,4768,4769,4770,4771,4869,4870,4871,4872,4873,4874,4875,4876,4877,4878,4879,4880,4881,4882,4883,4884,4885,4886,4887,4888,4889,4890,4891,4892,4893,4894,4895,4896,4897,4898,4899,4900,4901,4902,4903,4904,4905,4906,490