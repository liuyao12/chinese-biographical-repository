y_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-099-yinzhongwen:p004:m0176","start":176,"end":178,"surface":"殷闡","kind":"person","person_id":"czz_na9_r50","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。","paragraph_id":"c-jinshu-099-yinzhongwen:p004","chapter_id":"c-jinshu-099-yinzhongwen"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-099-yinzhongwen:p004","text":"仲文因月朔與眾至大司馬府，府中有老槐樹，顧之良久而歎曰：「此樹婆娑，無復生意！」仲文素有名望，自謂必當朝政，又謝混之徒疇昔所輕者，並皆比肩，常怏怏不得志。忽遷為東陽太守，意彌不平。劉毅愛才好士，深相禮接，臨當之郡，遊宴彌日。行至富陽，慨然歎曰：「看此山川形勢，當復出一伯符。」何無忌甚慕之。東陽，無忌所統，仲文許當便道修謁，無忌故益飲遲之，令府中命文人殷闡、孔寧子之徒撰義構文，以俟其至。仲文失志恍惚，遂不過府。無忌疑其薄己，大怒，思中傷之。時屬慕容超南侵，無忌言于劉裕曰：「桓胤、殷仲文並乃腹心之疾，北虜不足為憂。」義熙三年，又以仲文與駱球等謀反，及其弟南蠻校尉叔文伏誅。仲文時照鏡不見其面，數日而遇禍。","source_position":{"kind":"wikitext_codepoint_positions","raw_path":"sources/jinshu/wikisource-2644703-raw.wikitext","raw_start":11357,"raw_end":11669,"character_positions":[11359,11360,11361,11362,11363,11364,11365,11366,11367,11368,11369,11370,11371,11372,11373,11374,11375,11376,11377,11378,11379,11380,11381,11382,11383,11384,11385,11386,11387,11388,11389,11390,11391,11392,11393,11394,11395,11396,11397,11398,11399,11400,11401,11402,11403,11404,11405,11406,11407,11408,11409,11410,11411,11412,11413,11414,11415,11416,11417,11418,11419,11420,11421,11422,11423,11424,11425,11426,11427,11428,11429,11430,11431,11432,11433,11434,11435,11436,11437,11438,11439,11440,11441,11442,11443,11444,11445,11446,11447,11448,11449,11450,11451,11452,11453,11454,11455,11456,11457,11458,11459,11460,11461,11462,11463,11464,11465,11466,11467,11468,11469,11470,11471,11472,11473,11474,11475,11476,11477,11478,11479,11480,11481,11482,11483,11484,