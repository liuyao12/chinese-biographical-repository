p002","chapter_id":"c-shiji-085-lubuwei"},{"id":"c-shiji-085-lubuwei:m006-0000","start":0,"end":3,"surface":"秦昭王","kind":"person","person_id":"btm_i0w_9n1","status":"contextual_provisional","paragraph_id":"c-shiji-085-lubuwei:p006","chapter_id":"c-shiji-085-lubuwei"},{"id":"c-shiji-085-lubuwei:m006-0082","start":82,"end":85,"surface":"秦昭王","kind":"person","person_id":"btm_i0w_9n1","status":"contextual_provisional","paragraph_id":"c-shiji-085-lubuwei:p006","chapter_id":"c-shiji-085-lubuwei"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji085-002","person_id":"btm_i0w_9n1","surfaces":["秦昭王"],"scope":"same_chapter","chapter_ids":["c-shiji-085-lubuwei"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-085-lubuwei:p002","quote":"秦昭王四十年，太子死。其四十二年，以其次子安國君為太子。安國君有子二十餘人。安國君有所甚愛姬，立以為正夫人，號曰華陽夫人。華陽夫人無子。安國君中男名子楚，子楚母曰夏姬，毋愛。子楚為秦質子於趙。秦數攻趙，趙不甚禮子楚。"},{"paragraph_id":"c-shiji-085-lubuwei:p006","quote":"秦昭王五十年，使王齮圍邯鄲，急，趙欲殺子楚。子楚與呂不韋謀，行金六百斤予守者吏，得脫，亡赴秦軍，遂以得歸。趙欲殺子楚妻子，子楚夫人趙豪家女也，得匿，以故母子竟得活。秦昭王五十六年，薨，太子安國君立為王，華陽夫人為王后，子楚為太子。趙亦奉子楚夫人及子政歸秦。"}],"rationale":"依前5段子楚質趙與呂不韋游說敘事暫接；死亡太子與後立安國君分開，華陽姊與子政母各保留未名。王稱、太子及嵌套代詞待逐處核定。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-085-lubuwei:p002","text":"秦昭王四十年，太子死。其四十二年，以其次子安國君為太子。安國君有子二十餘人。安國君有所甚愛姬，立以為正夫人，號曰華陽夫人。華陽夫人無子。安國君中男名子楚，子楚母曰夏姬，毋愛。子楚為秦質子於趙。秦數攻趙，趙不甚禮子楚。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-085-lubuwei:m002-0000","start":0,"end":3,"surface":"秦昭王","kind":"person","person_id":"btm_i0w_9n1","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m002-0007","start":7,"end":9,"surface":"太子","kind":"person","person_id":"lje_891_3sg","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m002-0021","start":21,"end":24,"surface":"安國君","kind":"person","person_id":"mby_4zh_oni","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m002-0028","start":28,"end":31,"surface":"安國君","kind":"person","person_id":"mby_4zh_oni","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m002-0031","start":31,"end":37,"surface":"有子二十餘人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未能區分成員，未補姓名。"},{"id":"c-shiji-085-lubuwei:m002-0038","start":38,"end":41,"surface":"安國君","kind":"person","person_id":"mby_4zh_oni","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m002-0056","start":56,"end":60,"surface":"華陽夫人","kind":"person","person_id":"jb2_tak_5p8","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m002-0061","start":61,"end":65,"surface":"華陽夫人","kind":"person","person_id":"jb2_tak_5p8","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m002-0068","start":68,"end":71,"surface":"安國君","kind":"person","person_id":"mby_4zh_oni","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m002-0074","start":74,"end":76,"surface":"子楚","kind":"person","person_id":"mby_4zh_oni_A","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m002-0077","start":77,"end":79,"surface":"子楚","kind":"person","person_id":"mby_4zh_oni_A","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m002-0081","start":81,"end":83,"surface":"夏姬","kind":"person","person_id":"lef_ipu_r6b","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m002-0087","start":87,"end":89,"surface":"子楚","kind":"person","person_id":"mby_4zh_oni_A","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m002-0105","start":105,"end":107,"surface":"子楚","kind":"person","person_id":"mby_4zh_oni_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-085-lubuwei","book_id":"b-shiji-085","work_id":"w-shiji","source_id":"s-shiji-085-lubuwei"},{"id":"c-shiji-085-lubuwei:p006","text":"秦昭王五十年，使王齮圍邯鄲，急，趙欲殺子楚。子楚與呂不韋謀，行金六百斤予守者吏，得脫，亡赴秦軍，遂以得歸。趙欲殺子楚妻子，子楚夫人趙豪家女也，得匿，以故母子竟得活。秦昭王五十六年，薨，太子安國君立為王，華陽夫人為王后，子楚為太子。趙亦奉子楚夫人及子政歸秦。","annotat