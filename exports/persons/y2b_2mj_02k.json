，無所是非。性好內，不能接士大夫。及楚王瑋之舉兵也，使遐收衛瓘，而瓘故吏榮晦遂盡殺瓘子孫，遐不能禁，為世所尤。永康元年薨，時年二十八。四子：覃、籥、銓、端。覃嗣立。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","source_position":{"acquisition":"current_rendered_tool_text","reported_revision_id":2622004,"fixed_body_obtained":false,"tool_line":191},"mentions":[{"id":"c-jinshu-064-wudi-sons-rendered:p013:m0000","start":0,"end":5,"surface":"清河康王遐","kind":"person","person_id":"dkn_ge4_286_AAAAIAF","status":"contextual_provisional","source_role":"xia"},{"id":"c-jinshu-064-wudi-sons-rendered:p013:m0007","start":7,"end":9,"surface":"深度","kind":"person","person_id":"dkn_ge4_286_AAAAIAF","status":"contextual_provisional","source_role":"xia"},{"id":"c-jinshu-064-wudi-sons-rendered:p013:m0018","start":18,"end":20,"surface":"武帝","kind":"person","person_id":"dkn_ge4_286_AAAAIA","status":"contextual_provisional","source_role":"wu"},{"id":"c-jinshu-064-wudi-sons-rendered:p013:m0021","start":21,"end":22,"surface":"之","kind":"pronoun","person_id":"dkn_ge4_286_AAAAIAF","status":"contextual_provisional","source_role":"xia","voice":"reported_object_pronoun","source_reference_binding":{"kind":"received_sima_family_pronoun","paragraph_id":"c-jinshu-064-wudi-sons-rendered:p013","paragraph_sha256":"4af6d74e29cb89314d98d00e688e4b132dfe52d95a974b33f3c6a0b4c86aec55","role":"xia"}},{"id":"c-jinshu-064-wudi-sons-rendered:p013:m0031","start":31,"end":36,"surface":"城陽哀王兆","kind":"person","person_id":"dkn_ge4_286_AAAAIC","status":"contextual_provisional","source_role":"zhao"},{"id":"c-jinshu-064-wudi-sons-rendered:p013:m0075","start":75,"end":76,"surface":"遐","kind":"person","person_id":"dkn_ge4_286_AAAAIAF","status":"contextual_provisional","source_role":"xia"},{"id":"c-jinshu-064-wudi-sons-rendered:p013:m0098","start":98,"end":101,"surface":"楚王瑋","kind":"person","person_id":"dkn_ge4_286_AAAAIAB","status":"contextual_provisional","source_role":"wei"},{"id":"c-jinshu-064-wudi-sons-rendered:p013:m0107","start":107,"end":108,"surface":"遐","kind":