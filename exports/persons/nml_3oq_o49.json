{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"nml_3oq_o49","canonical_person_id":"nml_3oq_o49","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["nml_3oq_o49"],"persons":[{"id":"nml_3oq_o49","label":"趙王遷（張釋之馮唐列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"趙王遷","mention_ids":["c-shiji-102-zhangfeng:m012-0224"]},{"surface":"王遷","mention_ids":["c-shiji-102-zhangfeng:m012-0234"]}],"evidence":[{"mention_id":"c-shiji-102-zhangfeng:m012-0224","chapter_id":"c-shiji-102-zhangfeng","paragraph_id":"c-shiji-102-zhangfeng:p012","quote":"趙王遷"},{"mention_id":"c-shiji-102-zhangfeng:m012-0234","chapter_id":"c-shiji-102-zhangfeng","paragraph_id":"c-shiji-102-zhangfeng:p012","quote":"王遷"}]},{"id":"ur3_6rb_cp2","label":"趙王遷母未名（張釋之馮唐列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"母","mention_ids":["c-shiji-102-zhangfeng:m012-0230"]}],"evidence":[{"mention_id":"c-shiji-102-zhangfeng:m012-0230","chapter_id":"c-shiji-102-zhangfeng","paragraph_id":"c-shiji-102-zhangfeng:p012","quote":"母"}]}],"source_mention_summary":[{"source_id":"s-shiji-102-zhangfeng","work_id":"w-shiji","book_id":"b-shiji-102","chapter_id":"c-shiji-102-zhangfeng","mention_count":2,"mention_ids":["c-shiji-102-zhangfeng:m012-0224","c-shiji-102-zhangfeng:m012-0234"],"paragraph_ids":["c-shiji-102-zhangfeng:p012"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-102-zhangfeng"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji102-007","subject_person_id":"nml_3oq_o49","predicate":"mother","object_person_id":"ur3_6rb_cp2","status":"source_attested","evidence":[{"chapter_id":"c-shiji-102-zhangfeng","source_id":"s-shiji-102-zhangfeng","paragraph_id":"c-shiji-102-zhangfeng:p012","quote":"當是之時，匈奴新大入朝那，殺北地都尉卬。上以胡寇爲意，乃卒復問唐曰：「公何以知吾不能用廉頗、李牧也？」唐對曰：「臣聞上古王者之遣將也，跪而推轂，曰閫以內者，寡人制之；閫以外者，將軍制之。軍功爵賞皆決於外，歸而奏之。此非虛言也。臣大父言，李牧爲趙將居邊，軍市之租皆自用饗士，賞賜決於外，不從中擾也。委任而責成功，故李牧乃得盡其智能，遣選車千三百乘，彀騎萬三千，百金之士十萬，是以北逐單于，破東胡，滅澹林，西抑彊秦，南支韓、魏。當是之時，趙幾霸。其後會趙王遷立，其母倡也。王遷立，乃用郭開讒，卒誅李牧，令顏聚代之。是以兵破士北，爲秦所禽滅。今臣竊聞魏尚爲雲中守，其軍市租盡以饗士卒，［出］私養錢，五日一椎牛，饗賓客軍吏舍人，是以匈奴遠避，不近雲中之塞。虜曾一入，尚率車騎擊之，所殺其眾。夫士卒盡家人子，起田中從軍，安知尺籍伍符。終日力戰，斬首捕虜，上功莫府，一言不相應，文吏以法繩之。其賞不行而吏奉法必用。臣愚，以爲陛下法太明，賞太輕，罰太重。且雲中守魏尚坐上功首虜差六級，陛下下之吏，削其爵，罰作之。由此言之，陛下雖得廉頗、李牧，弗能用也。臣誠愚，觸忌諱，死罪死罪！」文帝説。是日令馮唐持節赦魏尚，復以爲雲中守，而拜唐爲車騎都尉，主中尉及郡國車士。"}],"qualifiers":{"source_term":"其母倡也","historicity":"historical_tradition"},"interpretation_note":"明示父子、祖父、母與兄分存；不補共同父親、匿名姓名或排行數字。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-102-zhangfeng:m012-0224","start":224,"end":227,"surface":"趙王遷","kind":"person","person_id":"nml_3oq_o49","status":"contextual_provisional","paragraph_id":"c-shiji-102-zhangfeng:p012","chapter_id":"c-shiji-102-zhangfeng"},{"id":"c-shiji-102-zhangfeng:m012-0234","start":234,"end":236,"surface":"王遷","kind":"person","person_id":"nml_3oq_o49","status":"contextual_provisional","paragraph_id":"c-shiji-102-zhangfeng:p012","chapter_id":"c-shiji-102-zhangfeng"}],"relations":[{"id":"a-shiji102-007","subject_person_id":"nml_3oq_o49","predicate":"mother","object_person_id":"ur3_6rb_cp2","status":"source_attested","evidence":[{"chapter_id":"c-shiji-102-zhangfeng","source_id":"s-shiji-102-zhangfeng","paragraph_id":"c-shiji-102-zhangfeng:p012","quote":"當是之時，匈奴新大入朝那，殺北地都尉卬。上以胡寇爲意，乃卒復問唐曰：「公何以知吾不能用廉頗、李牧也？」唐對曰：「臣聞上古王者之遣將也，跪而推轂，曰閫以內者，寡人制之；閫以外者，將軍制之。軍功爵賞皆決於外，歸而奏之。此非虛言也。臣大父言，李牧爲趙將居邊，軍市之租皆自用饗士，賞賜決於外，不從中擾也。委任而責成功，故李牧乃得盡其智能，遣選車千三百乘，彀騎萬三千，百金之士十萬，是以北逐單于，破東胡，滅澹林，西抑彊秦，南支韓、魏。當是之時，趙幾霸。其後會趙王遷立，其母倡也。王遷立，乃用郭開讒，卒誅李牧，令顏聚代之。是以兵破士北，爲秦所禽滅。今臣竊聞魏尚爲雲中守，其軍市租盡以饗士卒，［出］私養錢，五日一椎牛，饗賓客軍吏舍人，是以匈奴遠避，不近雲中之塞。虜曾一入，尚率車騎擊之