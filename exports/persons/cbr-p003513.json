iji-057-zhou:p012","chapter_id":"c-shiji-057-zhou"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji057-046","person_id":"cbr-p003513","surfaces":["許負","負"],"scope":"same_chapter","chapter_ids":["c-shiji-057-zhou"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-057-zhou:p012","quote":"條侯亞夫自未侯為河內守時，許負相之，曰：「君後三歲而侯。侯八歲為將相，持國秉，貴重矣，於人臣無兩。其後九歲而君餓死。」亞夫笑曰：「臣之兄已代父侯矣，有如卒，子當代，亞夫何說侯乎？然既已貴如負言，又何說餓死？指示我。」許負指其口曰：「有從理入口，此餓死法也。」居三歲，其兄絳侯勝之有罪，孝文帝擇絳侯子賢者，皆推亞夫，乃封亞夫為條侯，續絳侯後。"}],"rationale":"按明示姓名、軍事近接、父子承爵與局部皇帝敘事暫接。周勃和勝之的絳侯分開，亞夫條侯與平曲支不混；代地韓信依韓王信近接而不接淮陰侯。未名人物、單名官員不補姓，校勘字不作定本，相術預言不作史實已驗。 許負為歷史敘事中的相者，預言不當已驗史實，不據相術把人物本身判為神異存在。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-057-zhou:p012","text":"條侯亞夫自未侯為河內守時，許負相之，曰：「君後三歲而侯。侯八歲為將相，持國秉，貴重矣，於人臣無兩。其後九歲而君餓死。」亞夫笑曰：「臣之兄已代父侯矣，有如卒，子當代，亞夫何說侯乎？然既已貴如負言，又何說餓死？指示我。」許負指其口曰：「有從理入口，此餓死法也。」居三歲，其兄絳侯勝之有罪，孝文帝擇絳侯子賢者，皆推亞夫，乃封亞夫為條侯，續絳侯後。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-057-zhou:m012-0000","start":0,"end":4,"surface":"條侯亞夫","kind":"person","person_id":"cbr-p003470","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m012-0013","start":13,"end":15,"surface":"許負","kind":"person","person_id":"cbr-p003513","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m012-0059","start":59,"end":61,"surface":"亞夫","kind":"person","person_id":"cbr-p003470","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m012-0078","start":78,"end":81,"surface":"子當代","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者、假設侯嗣、職署或未定回指；不補姓名、親屬成員或爵位所指。"},{"id":"c-shiji-057-zhou:m012-0082","start":82,"end":84,"surface":"亞夫","kind":"person","person_id":"cbr-p003470","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m012-0094","start":94,"end":95,"surface":"負","kind":"person","person_id":"cbr-p003513","status":"contextual_