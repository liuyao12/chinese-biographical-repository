,"kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、未名者、未核官稱或代詞，不補姓名及家屬成員。"},{"id":"c-shiji-052-qidaohui:m014-0049","start":49,"end":52,"surface":"瑯邪王","kind":"person","person_id":"8st_c0j_4fk","status":"contextual_provisional"}],"chapter_id":"c-shiji-052-qidaohui","book_id":"b-shiji-052","work_id":"w-shiji","source_id":"s-shiji-052-qidaohui"},{"id":"c-shiji-052-qidaohui:p033","text":"城陽景王章，齊悼惠王子，以朱虛侯與大臣共誅諸呂，而章身首先斬相國呂王產於未央宮。孝文帝既立，益封章二千戶，賜金千斤。孝文二年，以齊之城陽郡立章為城陽王。立二年卒，子喜立，是為共王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-052-qidaohui:m033-0000","start":0,"end":5,"surface":"城陽景王章","kind":"person","person_id":"yqp_nlb_p1p_ABF","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m033-0006","start":6,"end":10,"surface":"齊悼惠王","kind":"person","person_id":"yqp_nlb_p1p_AB","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m033-0013","start":13,"end":16,"surface":"朱虛侯","kind":"person","person_id":"yqp_nlb_p1p_ABF","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m033-0017","start":17,"end":19,"surface":"大臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、官稱、未名者或待核回指；不補姓名，王作動詞不當人名。"},{"id":"c-shiji-052-qidaohui:m033-0025","start":25,"end":26,"surface":"章","kind":"person","person_id":"yqp_nlb_p1p_ABF","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m033-0030","start":30,"end":35,"surface":"相國呂王產","kind":"person","person_id":"gx0_1xv_0gm","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m033-0040","start":40,"end":43,"surface":"孝文帝","kind":"person","person_id":"28d_4fi_xdp","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m033-0048","start":48,"end":49,"surface":"章","kind":"person","person_id":"yqp_nlb_p1p_ABF","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m033-0058","start":58,"end":60,"surface":"孝文","kind":"person","person_id":"28d_4fi_xdp","status":"contextual_provisional"},{"id