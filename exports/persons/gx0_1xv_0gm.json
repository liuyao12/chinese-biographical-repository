e_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予、任事、提議、回敘及用稱分開；年號僅留原語，不反算公曆起訖。朱虛、東牟許封趙梁而未實現不記實授，死亡不自動終止全部稱號。章與興居授王兩處年表述各留原段，不擅調和。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji052-015","person_id":"gx0_1xv_0gm","title":"相國","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-052-qidaohui","source_id":"s-shiji-052-qidaohui","paragraph_id":"c-shiji-052-qidaohui:p009","quote":"其明年，高后崩。趙王呂祿為上將軍，呂王產為相國，皆居長安中，聚兵以威大臣，欲為亂。朱虛侯章以呂祿女為婦，知其謀，乃使人陰出告其兄齊王，欲令發兵西，朱虛侯、東牟侯為內應，以誅諸呂，因立齊王為帝。"}],"attestations":[{"id":"th-shiji052-015:a001","paragraph_id":"c-shiji-052-qidaohui:p009","start":21,"end":23,"surface":"相國","person_mention_id":"c-shiji-052-qidaohui:m009-0017","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予、任事、提議、回敘及用稱分開；年號僅留原語，不反算公曆起訖。朱虛、東牟許封趙梁而未實現不記實授，死亡不自動終止全部稱號。章與興居授王兩處年表述各留原段，不擅調和。","reviewer":"Codex（AI 代理）"}],"address_assertions":[{"id":"pa-shiji052-005","person_id":"gx0_1xv_0gm","relation":"residence","place":{"source_name":"長安","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-052-qidaohui","source_id":"s-shiji-052-qidaohui","paragraph_id":"c-shiji-052-qidaohui:p009","quote":"其明年，高后崩。趙王呂祿為上將軍，呂王產為相國，皆居長安中，聚兵以威大臣，欲為亂。朱虛侯章以呂祿女為婦，知其謀，乃使人陰出告其兄齊王，欲令發兵西，朱虛侯、東牟侯為內應，以誅諸呂，因立齊王為帝。","person_mention_id":"c-shiji-052-qidaohui:m009-0017"}],"source_term":"皆居長安中","interpretation_note":"來源實行行程、居處、籍貫及死地分存；封地、許封與計畫不作住所，不補現代定位或未見目的地。","reviewer":"Codex（AI 代理）","human_reviewed":false},{"id":"pa-shiji052-016","person_id":"gx0_1xv_0gm","relation":"death_place","place":{"source_name":"未央宮","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-052-qidaohui","source_id":"s-shiji-052-qidaohui","paragraph_id":"c-shiji-052-qidaohui:p033","quote":"城陽景王章，齊悼惠王子，以朱虛侯與大臣共誅諸呂，而章身首先斬相國呂王產於未央宮。孝文帝既立，益封章二千戶，賜金千斤。孝文二年，以齊之城陽郡立章為城陽王。立二年卒，子喜立，是為共王。","person_mention_id":"c-shiji-052-qidaohui:m033-0030"}],"source_term":"斬相國呂王產於未央宮","interpretation_note":"來源實行行程、居處、籍貫及死地分存；封地、許封與計畫不作住所，不補現代定位或未見目的地。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji052-015","person_id":"gx0_1xv_0gm","surfaces":["呂王產","呂產","相國呂王產"],"scope":"same_chapter","chapter_ids":["c-shiji-052-qidaohui"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-052-qidaohui:p009","quote":"其明年，高后崩。趙王呂祿為上將軍，呂王產為相國，皆居長安中，聚兵以威大臣，欲為亂。朱虛侯章以呂祿女為婦，知其謀，乃使人陰出告其兄齊王，欲令發兵西，朱虛侯、東牟侯為內應，以誅諸呂，因立齊王為帝。"},{"paragraph_id":"c-shiji-052-qidaohui:p013","quote":"漢聞齊發兵而西，相國呂產乃遣大將軍灌嬰東擊之。灌嬰至滎陽，乃謀曰：「諸呂將兵居關中，欲危劉氏而自立。我今破齊還報，是益呂氏資也。」乃留兵屯滎陽，使使喻齊王及諸侯，與連和，以待呂氏之變而共誅之。齊王聞之，乃西取其故濟南郡，亦屯兵於齊西界以待約。"},{"paragraph_id":"c-shiji-052-qidaohui:p014","quote":"呂祿、呂產欲作亂關中，朱虛侯與太尉勃、丞相平等誅之。朱虛侯首先斬呂產，於是太尉勃等乃得盡誅諸呂。而瑯邪王亦從齊至長安。"},{"paragraph_id":"c-shiji-052-qidaohui:p033","quote":"城陽景王章，齊悼惠王子，以朱虛侯與大臣共誅諸呂，而章身首先斬相國呂王產於未央宮。孝文帝既立，益封章二千戶，賜金千斤。孝文二年，以齊之城陽郡立章為城陽王。立二年卒，子喜立，是為共王。"}],"rationale":"依明示名與王國、世次的局部敘事暫接；齊、城陽與菑川同諡者分開，興居與志分開。校勘建延及內史勳士未擅選讀法，未名帝后不補姓名，案件只保存來源敘事。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-052-qidaohui:p009","text":"其明年，高后崩。趙王呂祿為上將軍，呂王產為相國，皆居長安中，聚兵以威大臣，欲為亂。朱虛侯章以呂祿女為婦，知其謀，乃使人陰出告其兄齊王，欲令發兵西，朱虛侯、東牟侯為內應，以誅諸呂，因立齊王為帝。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-052-qidaohui:m009-0004","start":4,"end":6,"surface":"高后","kind":"person","person_id":"fwf_1wp_wzg","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m009-0008","start":8,"end":12,"surface":"趙王呂祿","kind":"person","person_id":"h29_d0o_1td","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m009-0017","start":17,"end":20,"surface":"呂王產","kind":"person","person_id":"gx0_1xv_0gm","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m009-0034","start":34,"end":36,"surface":"大臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、未名者、未核官稱或代詞，不補姓名及家屬成員。"},{"id":"c-shiji-052-qidaohui:m009-0041","start":41,"end":45,"surface":"朱虛侯章","kind":"person","person_id":"yqp_nlb_p1p_ABF","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m009-0046","start":46,"end":49,"surface":"呂祿女","kind":"person","person_id":"iv0_705_1c6","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m009-0064","start":64,"end":66,"surface":"齊王","kind":"person","person_id":"yqp_nlb_p1p_ABA","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m009-0073","start":73,"end":76,"surface":"朱虛侯","kind":"person","person_id":"yqp_nlb_p1p_ABF","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m009-0077","start":77,"end":80,"surface":"東牟侯","kind":"person","person_id":"yqp_nlb_p1p_ABC","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m009-0091","start":91,"end":93,"surface":"齊王","kind":"person","person_id":"yqp_nlb_p1p_ABA","status":"contextual_provisional"}],"chapter_id":"c-shiji-052-qidaohui","book_id":"b-shiji-052","work_id":"w-shiji","source_id":"s-shiji-052-qidaohui"},{"id":"c-shiji-052-qidaohui:p013","text":"漢聞齊發兵而西，相國呂產乃遣大將軍灌嬰東擊之。灌嬰至滎陽，乃謀曰：「諸呂將兵居關中，欲危劉氏而自立。我今破齊還報，是益呂氏資也。」乃留兵屯滎陽，使使喻齊王及諸侯，與連和，以待呂氏之變而共誅之。齊王聞之，乃西取其故濟南郡，亦屯兵於齊西界以待約。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-052-qidaohui:m013-0010","start":10,"end":12,"surface":"呂產","kind":"person","person_id":"gx0_1xv_0gm","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m013-0017","start":17,"end":19,"surface":"灌嬰","kind":"person","person_id":"ju6_1ic_2zu","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m013-0023","start":23,"end":25,"sur