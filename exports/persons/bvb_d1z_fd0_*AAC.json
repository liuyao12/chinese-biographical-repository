郭吉在漢平南越後向單于稱南越王頭懸北闕；卷113明記呂嘉立明王長男建德，漢元鼎六年破番禺，追得建德。依末代王與平南越的事件接合，不泛合歷代南越王。卷113只明記得建德，北闕懸首保留為卷110郭吉之語，不偽稱兩篇都明記斬首，也不補精確死亡日期。","evidence":[{"chapter_id":"c-shiji-110-xiongnu","source_id":"s-shiji110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p045","mention_ids":["c-shiji-110-xiongnu:m045-0074"],"quote_passage_ref":"data/corpus/shiji/110.json"},{"chapter_id":"c-shiji-113-nanyue","source_id":"s-shiji113-nanyue","paragraph_id":"c-shiji-113-nanyue:p009","mention_ids":["c-shiji-113-nanyue:m009-0303","c-shiji-113-nanyue:m009-0457"],"quote_passage_ref":"data/corpus/shiji/113.json"},{"chapter_id":"c-shiji-113-nanyue","source_id":"s-shiji113-nanyue","paragraph_id":"c-shiji-113-nanyue:p011","mention_ids":["c-shiji-113-nanyue:m011-0082","c-shiji-113-nanyue:m011-0192","c-shiji-113-nanyue:m011-0245"],"quote_passage_ref":"data/corpus/shiji/113.json"}],"reviewer":"Codex（AI 代理）","model":null,"human_reviewed":false,"identity_materialized":true}],"sources":[{"chapter_id":"c-shiji-110-xiongnu","work_id":"w-shiji","book_id":"b-shiji-110","source_id":"s-shiji110-xiongnu","source_ref":"corpus/shiji/110.json"},{"chapter_id":"c-shiji-113-nanyue","work_id":"w-shiji","book_id":"b-shiji-113","source_id":"s-shiji113-nanyue","source_ref":"corpus/shiji/113.json"}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true},"passage_refs":[{"chapter":"corpus/shiji/110.json","id":"c-shiji-110-xiongnu:p045"},{"chapter":"corpus/shiji/113.json","id":"c-shiji-113-nanyue:p009"},{"chapter":"corpus/shiji/113.json","id":"c-shiji-113-nanyue:p011"}]}
