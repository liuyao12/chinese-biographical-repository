-shiji-086-cike:m007-0029","start":29,"end":30,"surface":"光","kind":"person","person_id":"cbr-p004819","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p007","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m007-0061","start":61,"end":64,"surface":"公子光","kind":"person","person_id":"cbr-p004819","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p007","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m007-0124","start":124,"end":127,"surface":"公子光","kind":"person","person_id":"cbr-p004819","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p007","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m007-0150","start":150,"end":152,"surface":"闔閭","kind":"person","person_id":"cbr-p004819","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p007","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m007-0153","start":153,"end":155,"surface":"闔閭","kind":"person","person_id":"cbr-p004819","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p007","chapter_id":"c-shiji-086-cike"}],"relations":[{"id":"a-shiji086-001","subject_person_id":"cbr-p004819","predicate":"father","object_person_id":"cbr-p004820","status":"source_attested","evidence":[{"chapter_id":"c-shiji-086-cike","source_id":"s-shiji-086-cike","paragraph_id":"c-shiji-086-cike:p005","quote":"光之父曰呉王諸樊。諸樊弟三人：次曰餘祭，次曰夷眛，次曰季子札。諸樊知季子札賢而不立太子，以次傳三弟，欲卒致國于季子札。諸樊既死，傳餘祭。餘祭死，傳夷眛。夷眛死，當傳季子札；季子札逃不肯立，呉人乃立夷眛之子僚爲王。公子光曰：「使以兄弟次邪，季子當立；必以子乎，則光眞適嗣，當立。」故嘗陰養謀臣以求立。"}],"qualifiers":{"source_term":"光之父曰呉王諸樊","historicity":"historical_tradition"},"interpretation_note":"僅記錄明示父子、母、姊弟、兄弟及局部婚配來源主張；夷眛之子僚等異說尚待跨篇校核，母老子弱與季父不補未名世系。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji086-003","person_id":"cbr-p004819","title":"王","kind":"royal_rank","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-086-cike","source_id":"s-shiji-086-cike","paragraph_id":"c-shiji-086-cike:p007","quote":"四月丙子，光伏甲士於窟室中，而具酒請王僚。王僚使兵陳自宮至光之家，門戸階陛左右，皆王僚之親戚也。夾立侍，皆持長鈹。酒既酣，公子光詳爲足疾，入窟室中，使專諸置匕首魚炙之腹中而進之。既至王前，專諸擘魚，因以匕首刺王僚，王僚立死。左右亦殺專諸，王人擾亂。公子光出其伏甲以攻王僚之徒，盡滅之，遂自立爲王，是爲闔閭。闔閭乃封專諸之子以爲上卿。"}],"attestations":[{"id":"th-shiji086-003:a001","paragraph_id":"c-shiji-086-cike:p007","start":146,"end":147,"surface":"王","person_mention_id":"c-shiji-086-cike:m007-0150","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":"四月丙子","evidence":[{"chapter_id":"c-shiji-086-cike","source_id":"s-shiji-086-cike","paragraph_id":"c-shiji-086-cike:p007","quote":"四月丙子，光伏甲士於窟室中，而具酒請王僚。王僚使兵陳自宮至光之家，門戸階陛左右，皆王僚之親戚也。夾立侍，皆持長鈹。酒既酣，公子光詳爲足疾，入窟室中，使專諸置匕首魚炙之腹中而進之。既至王前，專諸擘魚，因以匕首刺王僚，王僚立死。左右亦殺專諸，王人擾亂。公子光出其伏甲以攻王僚之徒，盡滅之，遂自立爲王，是爲闔閭。闔閭乃封專諸之子以爲上卿。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"實際授任與文獻用稱分存；四月丙子依本段事件，不換算絕對年。皇帝其明年保留相對日期；上客為禮遇。懸賞金邑、職稱首見、死亡、被虜或亡逃不推定任期起訖。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji086-008","person_id":"cbr-p004819","surfaces":["光","公子光","呉公子光","闔閭"],"scope":"same_chapter","chapter_ids":["c-shiji-086-cike"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-086-cike:p004","quote":"專諸者，呉堂邑人也。伍子胥之亡楚而如呉也，知專諸之能。伍子胥既見呉王僚，説以伐楚之利。呉公子光曰：「彼伍員父兄皆死於楚而員言伐楚，欲自爲報私讎也，非能爲呉。」呉王乃止。伍子胥知公子光之欲殺呉王僚，乃曰：「彼光將有内志，未可説以外事。」乃進專諸於公子光。"},{"paragraph_id":"c-shiji-086-cike:p005","quote":"光之父曰呉王諸樊。諸樊弟三人：次曰餘祭，次曰夷眛，次曰季子札。諸樊知季子札賢而不立太子，以次傳三弟，欲卒致國于季子札。諸樊既死，傳餘祭。餘祭死，傳夷眛。夷眛死，當傳季子札；季子札逃不肯立，呉人乃立夷眛之子僚爲王。公子光曰：「使以兄弟次邪，季子當立；必以子乎，則光眞適嗣，當立。」故嘗陰養謀臣以求立。"},{"paragraph_id":"c-shiji-086-cike:p006","quote":"光既得專諸，善客待之。九年而楚平王死。春，呉王僚欲因楚喪，使其二弟公子蓋餘、屬庸將兵圍楚之灊；使延陵季子於晉，以觀諸侯之變。楚發兵絶呉將蓋餘、屬庸路，呉兵不得還。於是公子光謂專諸曰：「此時不可失，不求何獲！且光眞王嗣，當立，季子雖來，不吾廢也。」專諸曰：「王僚可殺也。母老子弱，而兩弟將兵伐楚，楚絶其後。方今呉外困於楚，而内空無骨鯁之臣，是無如我何。」公子光頓首曰：「光之身，子之身也。」"},{"paragraph_id":"c-shiji-086-cike:p007","quote":"四月丙子，光伏甲士於窟室中，而具酒請王僚。王僚使兵陳自宮至光之家，門戸階陛左右，皆王僚之親戚也。夾立侍，皆持長鈹。酒既酣，公子光詳爲足疾，入窟室中，使專諸置匕首魚炙之腹中而進之。既至王前，專諸擘魚，因以匕首刺王僚，王僚立死。左右亦殺專諸，王人擾亂。公子光出其伏甲以攻王僚之徒，盡滅之，遂自立爲王，是爲闔閭。闔閭乃封專諸之子以爲上卿。"}],"rationale":"依曹沫盟柯與專諸引介、公子光及吳王兄弟王序語境暫接；伍子胥伍員明示同段承接，原字呉眛爲保留，王稱與嵌套指代待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-086-cike:p004","text":"專諸者，呉堂邑人也。伍子胥之亡楚而如呉也，知專諸之能。伍子胥既見呉王僚，説以伐楚之利。呉公子光曰：「彼伍員父兄皆死於楚而員言伐楚，欲自爲報私讎也，非能爲呉。」呉王乃止。伍子胥知公子光之欲殺呉王僚，乃曰：「彼光將有内志，未可説以外事。」乃進專諸於公子光。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-086-cike:m004-0000","start":0,"end":2,"surface":"專諸","kind":"person","person_id":"cbr-p004816","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m004-0010","start":10,"end":13,"surface":"伍子胥","kind":"person","person_id":"cbr-p004817","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m004-0022","start":22,"end":24,"surface":"專諸","kind":"person","person_id":"cbr-p004816","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m004-0027","start":27,"end":30,"surface":"伍子胥","kind":"person","person_id":"cbr-p004817","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m004-0032","start":32,"end":35,"surface":"呉王僚","kind":"person","person_id":"cbr-p004818","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m004-0043","start":43,"end":47,"surface":"呉公子光","kind":"person","person_id":"cbr-p004819","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m004-0051","start":51,"end":53,"surface":"伍員","kind":"person","person_id":"cbr-p004817","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m004-0053","start":53,"end":55,"surface":"父兄","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未能辨識成員，保留原稱。"},{"id":"c-shiji-086-cike:m004-0060","start":60,"end":61,"surface":"員","kind":"person","person_id":"cbr-p004817","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m004-0084","start":84,"end":87,"surface":"伍子胥","kind":"person","person_id":"cbr-p004817","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m004-0088","start":88,"end":91,"surface":"公子光","kind"