-101-yuanchao"}],"relations":[],"title_holdings":[{"id":"th-shiji101-036","person_id":"orq_rdx_tgp","title":"秦博士","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-101-yuanchao","source_id":"s-shiji-101-yuanchao","paragraph_id":"c-shiji-101-yuanchao:p017","quote":"錯為人陗直刻深。孝文帝時，天下無治尚書者，獨聞濟南伏生故秦博士，治尚書，年九十餘，老不可徵，乃詔太常使人往受之。太常遣錯受尚書伏生所。還，因上便宜事，以書稱說。詔以為太子舍人、門大夫、家令。以其辯得幸太子，太子家號曰「智囊」。數上書孝文時，言削諸侯事，及法令可更定者。書數十上，孝文不聽，然奇其材，遷為中大夫。當是時，太子善錯計策，袁盎諸大功臣多不好錯。"}],"attestations":[{"id":"th-shiji101-036:a001","paragraph_id":"c-shiji-101-yuanchao:p017","start":28,"end":31,"surface":"秦博士","person_mention_id":"c-shiji-101-yuanchao:m017-0025","usage":"retrospective"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"實授、任事、敘事用稱與先前官職分存。欲使將而不肯不作已任，九卿只記類別，智囊為稱號，死亡不自動終止官爵。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji101-032","person_id":"orq_rdx_tgp","surfaces":["伏生"],"scope":"same_chapter","chapter_ids":["c-shiji-101-yuanchao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-101-yuanchao:p017","quote":"錯為人陗直刻深。孝文帝時，天下無治尚書者，獨聞濟南伏生故秦博士，治尚書，年九十餘，老不可徵，乃詔太常使人往受之。太常遣錯受尚書伏生所。還，因上便宜事，以書稱說。詔以為太子舍人、門大夫、家令。以其辯得幸太子，太子家號曰「智囊」。數上書孝文時，言削諸侯事，及法令可更定者。書數十上，孝文不聽，然奇其材，遷為中大夫。當是時，太子善錯計策，袁盎諸大功臣多不好錯。"}],"rationale":"按本傳明示姓名、字及敘事承接；皇帝上字逐處依文景敘事核定，建元上另留未名。兄噲不合樊噲，兄子種不補具名父親。身份及官稱回指為代理首輪判讀，非人工覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-101-yuanchao:p017","text":"錯為人陗直刻深。孝文帝時，天下無治尚書者，獨聞濟南伏生故秦博士，治尚書，年九十餘，老不可徵，乃詔太常使人往受之。太常遣錯受尚書伏生所。還，因上便宜事，以書稱說。詔以為太子舍人、門大夫、家令。以其辯得幸太子，太子家號曰「智囊」。數上書孝文時，言削諸侯事，及法令可更定者。書數十上，孝文不聽，然奇其材，遷為中大夫。當是時，太子善錯計策，袁盎諸大功臣多不好錯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-101-yuanchao: