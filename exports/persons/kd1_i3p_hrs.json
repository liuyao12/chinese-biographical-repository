與訪同姓名者，罪當死，吏誤收訪，訪奮擊收者，數十人皆散走，而自歸於帝，帝不之罪。尋以爲揚烈將軍，領兵一千二百，屯尋陽鄂陵，與甘卓、趙誘討華軼。所統厲武將軍丁乾與軼所統武昌太守馮逸交通，訪收斬之。逸來攻訪，訪率眾擊破之。逸遁保柴桑，訪乘勝進討。軼遣其党王約、傅劄等萬餘人助逸，大戰於湓口，約等又敗。訪與甘卓等會於彭澤，與軼水軍將硃矩等戰，又敗之。軼將周廣燒城以應訪，軼眾潰，訪執軼，斬之，遂平江州。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":70,"last_line":70,"raw_start":5785,"raw_end":6004,"raw_character_offsets":[5787,5788,5789,5790,5791,5792,5793,5794,5795,5796,5797,5798,5799,5800,5801,5802,5803,5804,5805,5806,5807,5808,5809,5810,5811,5812,5813,5814,5815,5816,5817,5818,5819,5820,5821,5822,5823,5824,5825,5826,5827,5828,5829,5830,5831,5832,5833,5834,5835,5836,5837,5838,5839,5840,5841,5842,5843,5844,5845,5846,5847,5848,5849,5850,5851,5852,5853,5854,5855,5856,5857,5858,5859,5860,5861,5862,5863,5864,5865,5866,5867,5868,5869,5870,5871,5872,5873,5874,5875,5876,5877,5878,5879,5880,5881,5882,5883,5884,5885,5886,5887,5888,5889,5890,5891,5892,5893,5894,5895,5896,5897,5898,5899,5900,5901,5902,5903,5904,5905,5906,5907,5908,5909,5910,5911,5912,5913,5914,5915,5916,5917,5918,5919,5920,5921,5922,5923,5924,5925,5926,5927,5928,5929,5930,5931,5932,5933,5934,5935,5936,5937,5938,5939,5940,5941,5942,5943,5944,5945,5946,5947,5948,5949,5950,5951,5952,5953,5954,5955,5958,5961,5962,5963,5964,5965,5966,5967,5968,5969,5970,5971,5972,5973,5974,5975,5976,5977,5978,5979,5980,5981,5982,5983,5984,5985,5986,5987,5988,5989,5990,5991,5992,5993,5994,5995,5996,5997,5998,5999,6000,6001,6002,6003],"revision_id":1775463},"mentions":[{"id":"c-jinshu-058-zhou-fang:p002:m0001","surface":"元帝","start":1,"end":3,"person_id":"dkn_ge4_286_AAAAAAA","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-fang:p002:m0016","surface":"訪","start":16,"end":17,"person_id":"c6b_s71_vt7","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-fang:p002:m0017","surface":"同姓名者","start":17,"end":21,"person_id":"bnj_8hf_jy5","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-fang:p002:m0029","surface":"訪","sta