ph"},{"canonical_mention_id":"c-nanqishu-059-western-polities-complete:p014:m0020","mention_ids":["c-nanqishu-059-western-polities-complete:p014:m0020"],"kind":"paragraph"}],"mention_count":4,"duplicate_mention_count":0,"paragraph_occurrence_count":4,"table_occurrence_count":0,"passage_count":3,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"4處獨立位置，4個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-nanqishu-059-western-polities-complete-ws1748911"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-nanqishu-059-western-polities-complete:source_review12-0","kind":"source_review","person_id":"21y_bxj_34g","source_quote":"宋初始受爵命，至宋末，河南王吐谷渾拾寅為使持節、散騎常侍、都督西秦河沙三州諸軍事、車騎大將軍、開府儀同三司、領護羌校尉、西秦河二州刺史。","reading":"河南王拾寅宋末已有軍號、開府等，受命朝代依明文。","note":"河南王拾寅宋末已有軍號、開府等，受命朝代依明文。","paragraph_id":"c-nanqishu-059-western-polities-complete:p012","start_codepoint":0,"end_codepoint":68,"human_reviewed":false,"chapter_id":"c-nanqishu-059-western-polities-complete","source_id":"s-nanqishu-059-western-polities-complete-ws1748911"},{"id":"c-nanqishu-059-western-polities-complete:source_review13-0","kind":"source_review","person_id":"21y_bxj_34g","source_quote":"建元元年，太祖即本官進號驃騎大將軍。宋世遣武衞將軍王世武使河南，是歲隨拾寅使來獻。詔答曰：「皇帝敬問使持節、散騎常侍、都督西秦河沙三州諸軍事、車騎大將軍、開府儀同三司、領護羌校尉、西秦河二州刺史、新除驃騎大將軍、河南王：寶命革授，爰集朕躬，猥當大業，祗惕兼懷。夏中增感。王世武至，得元徽五年五月二十一日表，聞之濕熱，想比平安。又卿乃誠遙著，保寧遐壃。今詔升徽號，以酬忠款。遣王世武銜命拜授。又仍使王世武等往芮芮，想即資遣，使得時達。又奏所上馬等物悉至，今往別牒錦絳紫碧綠黃青等紋各十匹。」","reading":"建元元年進號驃騎，王世武先為宋使後隨使入貢，答書所列拾寅早官別保。","note":"建元元年進號驃騎，王世武先為宋使後隨使入貢，答書所列拾寅早官別保。","paragraph_id":"c-nanqishu-059-western-polities-complete:p013","start_codepoint":0,"end_codepoint":244,"human_reviewed":false,"chapter_id":"c-nanqishu-059-western-polities-complete","source_id":"s-nanqishu-059-western-polities-complete-ws1748911"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-qi059-yiduhou-father","subject_person_id":"qed_p8w_clt","object_person_id":"21y_bxj_34g","predicate":"father","qualifiers":{"source_term":"拾寅子易度侯"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-059","chapter_id":"c-nanqishu-059-western-polities-complete","source_id":"s-nanqishu-059-western-polities-complete-ws1748911","paragraph_id":"c-nanqishu-059-western-polities-complete:p014","quote":"拾寅子易度侯好星文，甞求星書，朝議不給。寅卒，三年，以河南王世子吐谷渾易度侯為使持節、都督西秦河沙三州諸軍事、鎮西將軍、領護羌校尉、西秦河二州刺史、河南王。永明三年，詔曰：「易度侯守職西蕃，綏懷允緝，忠績兼舉，朕有嘉焉。可進號車騎大將軍。」遣給事中丘冠先使河南道，并送芮芮使。至六年乃還。得玉長三尺二寸，厚一尺一寸。","subject_person_mention_id":"c-nanqishu-059-western-polities-complete:p014:m0003","object_person_mention_id":"c-nanqishu-059-western-polities-complete:p014:m0000"}],"status":"source_attested","interpretation_note":"魏書作度易侯，亦記父子繼立。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-qi059-shiyin-death","person_id":"21y_bxj_34g","event_type":"death","source_term":"卒","source_anchor":{"paragraph_id":"c-nanqishu-059-western-polities-complete:p014","start":21,"end":22,"surface":"卒"},"date_expression":null,"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-059","chapter_id":"c-nanqishu-059-western-polities-complete","source_id":"s-nanqishu-059-western-polities-complete-ws1748911","paragraph_id":"c-nanqishu-059-western-polities-complete:p014","quote":"拾寅子易度侯好星文，甞求星書，朝議不給。寅卒，三年，以河南王世子吐谷渾易度侯為使持節、都督西秦河沙三州諸軍事、鎮西將軍、領護羌校尉、西秦河二州刺史、河南王。永明三年，詔曰：「易度侯守職西蕃，綏懷允緝，忠績兼舉，朕有嘉焉。可進號車騎大將軍。」遣給事中丘冠先使河南道，并送芮芮使。至六年乃還。得玉長三尺二寸，厚一尺一寸。","person_mention_id":"c-nanqishu-059-western-polities-complete:p01