_xm5_xvj","status":"contextual_provisional"},{"id":"c-nanqishu-059-western-polities-complete:p013:m0198","start":198,"end":201,"surface":"王世武","kind":"person","person_id":"ubc_xm5_xvj","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-059-western-polities-complete","book_id":"b-nanqishu-059","work_id":"w-nanqishu","source_id":"s-nanqishu-059-western-polities-complete-ws1748911"},{"id":"c-nanqishu-059-western-polities-complete:p014","text":"拾寅子易度侯好星文，甞求星書，朝議不給。寅卒，三年，以河南王世子吐谷渾易度侯為使持節、都督西秦河沙三州諸軍事、鎮西將軍、領護羌校尉、西秦河二州刺史、河南王。永明三年，詔曰：「易度侯守職西蕃，綏懷允緝，忠績兼舉，朕有嘉焉。可進號車騎大將軍。」遣給事中丘冠先使河南道，并送芮芮使。至六年乃還。得玉長三尺二寸，厚一尺一寸。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":38,"last_line":38,"raw_start":2096,"raw_end":2307,"raw_character_offsets":[2096,2097,2098,2099,2100,2101,2102,2103,2104,2105,2106,2107,2108,2109,2110,2111,2112,2113,2114,2115,2116,2117,2118,2119,2120,2121,2122,2123,2124,2125,2126,2127,2128,2129,2130,2131,2132,2133,2134,2135,2136,2137,2138,2139,2140,2141,2142,2143,2144,2145,2146,2147,2148,2149,2150,2204,2205,2206,2207,2208,2209,2210,2211,2212,2213,2214,2215,2216,2217,2218,2219,2220,2221,2222,2223,2224,2225,2226,2227,2228,2229,2230,2231,2232,2233,2234,2235,2236,2237,2238,2239,2240,2241,2242,2243,2244,2245,2246,2247,2248,2249,2250,2251,2252,2253,2254,2255,2256,2257,2258,2259,2260,2261,2262,2263,2264,2265,2266,2267,2268,2269,2270,2271,2272,2273,2274,2275,2276,2277,2278,2279,2280,2281,2282,2283,2284,2285,2286,2287,2288,2289,2290,2291,2292,2293,2294,2295,2296,2297,2298,2299,2300,2301,2302,2303,2304,2305,2306],"revision_id":1748911},"mentions":[{"id":"c-nanqishu-059-western-polities-complete:p014:m0000","start":0,"end":2,"surface":"拾寅","kind":"person","person_id":"21y_bxj_34g","status":"contextual_provisional"},{"id":"c-nanqishu-059-western-polities-complete:p014:m0003","start":3,"end":6,"surface":"易度侯","kind":"person","person_id":"qed_p8w_clt","status":"contextual_provisional"},{"id":"c-nanqishu-059-western-polities-complete: