,"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"id":"name-jin037-near-zhangluo","person_id":"49x_26r_hmt","surname":"張","ming":"洛","additional_names":[],"chapter_id":"c-jinshu-037-gaomi-nanyang-ws2630018","paragraph_id":"c-jinshu-037-gaomi-nanyang-ws2630018:p004","person_mention_id":"c-jinshu-037-gaomi-nanyang-ws2630018:p004:m0229","source_anchor":{"start":229,"end":231,"surface":"張洛"},"quote":"孝王略，字元簡，孝敬慈順，小心下士，少有父風。元康初，湣懷太子在東宮，選大臣子弟有名稱者以為賓友，略與華恆等並侍左右。曆散騎黃門侍郎、散騎常侍、秘書監，出為安南將軍、持節、都督沔南諸軍事，遷安北將軍、都督青州諸軍事。略逼青州刺史程牧，牧避之，略自領州。永興初，㡉令劉根起兵東萊，誑惑百姓，眾以萬數，攻略於臨淄，略不能距，走保聊城。懷帝即位，遷使持節、都督荊州諸軍事、征南大將軍、開府儀同三司。京兆流人王逌與叟人郝洛聚眾數千，屯于冠軍。略遣參軍崔曠率將軍皮初、張洛等討逌，為逌所譎，戰敗。略更遣左司馬曹攄統曠等進逼逌。將大戰，曠在後密自退走，攄軍無繼，戰敗，死之。略乃赦曠罪，復遣部將韓松又督曠攻逌，逌降。尋進開府，加散騎常侍。永嘉三年薨，追贈侍中、太尉，子據立。薨，無子，以彭城康王子紘為嗣。其後紘歸本宗，立紘子俊以奉其祀。","note":"來源具名原字；氏稱不補本名，所報異文分見數位校記，不加成無資格全域異名。","status":"editorial_provisional","human_reviewed":false,"model":null,"work_id":"w-jinshu","book_id":"b-jinshu-037","source_id":"s-jinshu037-gaomi-nanyang-ws2630018"}],"mentions":[{"id":"c-jinshu-037-gaomi-nanyang-ws2630018:p004:m0229","start":229,"end":231,"surface":"張洛","kind":"person","person_id":"49x_26r_hmt","status":"contextual_provisional","source_identity_role":"zhangluo","identity_reading_ref":"source-evidence/jin037-gaomi-nanyang/identity-readings.json#zhangluo","paragraph_id":"c-jinshu-037-gaomi-nanyang-ws2630018:p004","chapter_id":"c-jinshu-037-gaomi-nanyang-ws2630018"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-037-gaomi-nanyang-ws2630018:p004","text":"孝王略，字元簡，孝敬慈順，小心下士，少有父風。元康初，湣懷太子在東宮，選大臣子弟有名稱者以為賓