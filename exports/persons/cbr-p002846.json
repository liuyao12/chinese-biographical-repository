":"c-shiji-047-kong:m013-0021","start":21,"end":25,"surface":"公山不狃","kind":"person","person_id":"ia8_8tw_gey","status":"contextual_provisional","paragraph_id":"c-shiji-047-kong:p013","chapter_id":"c-shiji-047-kong"},{"id":"c-shiji-047-kong:m014-0005","start":5,"end":9,"surface":"公山不狃","kind":"person","person_id":"ia8_8tw_gey","status":"contextual_provisional","paragraph_id":"c-shiji-047-kong:p014","chapter_id":"c-shiji-047-kong"},{"id":"c-shiji-047-kong:m015-0000","start":0,"end":4,"surface":"公山不狃","kind":"person","person_id":"ia8_8tw_gey","status":"contextual_provisional","paragraph_id":"c-shiji-047-kong:p015","chapter_id":"c-shiji-047-kong"},{"id":"c-shiji-047-kong:m018-0058","start":58,"end":62,"surface":"公山不狃","kind":"person","person_id":"ia8_8tw_gey","status":"contextual_provisional","paragraph_id":"c-shiji-047-kong:p018","chapter_id":"c-shiji-047-kong"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji047-024","person_id":"ia8_8tw_gey","surfaces":["公山不狃"],"scope":"same_chapter","chapter_ids":["c-shiji-047-kong"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-047-kong:p013","quote":"桓子嬖臣曰仲梁懷，與陽虎有隙。陽虎欲逐懷，公山不狃止之。其秋，懷益驕，陽虎執懷。桓子怒，陽虎因囚桓子，與盟而醳之。陽虎由此益輕季氏。季氏亦僭於公室，陪臣執國政，是以魯自大夫以下皆僭離於正道。故孔子不仕，退而脩詩書禮樂，弟子彌衆，至自遠方，莫不受業焉。"},{"paragraph_id":"c-shiji-047-kong:p014","quote":"定公八年，公山不狃不得意於季氏，因陽虎為亂，欲廢三桓之適，更立其庶孽陽虎素所善者，遂執季桓子。桓子詐之，得脫。定公九年，陽虎不勝，奔于齊。是時孔子年五十。"},{"paragraph_id":"c-shiji-047-kong:p015","quote":"公山不狃以費畔季氏，使人召孔子。孔子循道彌久，溫溫無所試，莫能己用，曰：「蓋周文武起豐鎬而王，今費雖小，儻庶幾乎！」欲往。子路不說，止孔子。孔子曰：「夫召我者豈徒哉？如用我，其為東周乎！」然亦卒不行。"},{"paragraph_id":"c-shiji-047-kong:p018","quote":"定公十三年夏，孔子言於定公曰：「臣無藏甲，大夫毋百雉之城。」使仲由為季氏宰，將墮三都。於是叔孫氏先墮郈。季氏將墮費，公山不狃、叔孫輒率費人襲魯。公與三子入于季氏之宮，登武子之臺。費人攻之，弗克，入及公側。孔子命申句須、樂頎下伐之，費人北。國人追之，敗諸姑蔑。二子奔齊，遂墮費。將墮成，公歛處父謂孟孫曰：「墮成，齊人必至于北門。且成，孟氏之保鄣，無成是無孟氏也。我將弗墮。」十二月，公圍成，弗克。"}],"rationale":"限本篇明示名、字、對話自稱、世系及附贊局部對應；世系求與冉求分開，武不接漢武帝，今皇帝與高皇帝不補姓名。子路仲由明示同指另存，冉有冉求與秦繆秦穆仍待核；附贊不當獨立作者正文或獨立見證。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-047-kong:p013","text":"桓子嬖臣曰仲梁懷，與陽虎有隙。陽虎欲逐懷，公山不狃止之。其秋，懷益驕，陽虎執懷。桓子怒，陽虎因囚桓子，與盟而醳之。陽虎由此益輕季氏。季氏亦僭於公室，陪臣執國政，是以魯自大夫以下皆僭離於正道。故孔子不仕，退而脩詩書禮樂，弟子彌衆，至自遠方，莫不受業焉。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-047-kong:m013-0000","start":0,"end":2,"surface":"桓子","kind":"person","person_id":"6u6_x1f_xgg","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m013-0005","start":5,"end":8,"surface":"仲梁懷","kind":"person","person_id":"mz9_446_wux","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m013-0010","start":10,"end":12,"surface":"陽虎","kind":"person","person_id":"wnf_7c0_qa3","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m013-0015","start":15,"end":17,"surface":"陽虎","kind":"person","person_id":"wnf_7c0_qa3","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m013-0019","start":19,"end":20,"surface":"懷","kind":"person","person_id":"mz9_446_wux","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m013-0021","start":21,"end":25,"surface":"公山不狃","kind":"person","person_id":"ia8_8tw_gey","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m013-0031","start":31,"end":32,"surface":"懷","kind":"person","person_id":"mz9_446_wux","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m013-0035","start":35,"end":37,"surface":"陽虎","kind":"person","person_id":"wnf_7c0_qa3","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m013-0038","start":38,"end":39,"surface":"懷","kind":"person","person_id":"mz9_446_wux","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m013-0040","start":40,"end":42,"surface":"桓子","kind":"person","person_id":"6u6_x1f_xgg","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m013-0044","start":44,"end":46,"surface":"陽虎","kind":"person","person_id":"wnf_7c0_qa3","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m013