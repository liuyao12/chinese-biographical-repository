ertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-052-buzhi-complete:line090","text":"延康元年，權遣呂岱代騭，騭將交州義士萬人出長沙。會劉備東下，武陵蠻夷蠢動，權遂命騭上益陽。備既敗績，而零、桂諸郡猶相驚擾，處處阻兵，騭周旋征討，皆平之。黃武二年，遷右將軍、左護軍，改封臨湘侯。五年，假節，徙屯漚口。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-sanguozhi-052-buzhi-complete:line090:m0005","start":5,"end":6,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line090:m0007","start":7,"end":9,"surface":"呂岱","kind":"person","person_id":"2oe_qam_pq4","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line090:m0010","start":10,"end":11,"surface":"騭","kind":"person","person_id":"snv_2iq_jes","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line090:m0012","start":12,"end":13,"surface":"騭","kind":"person","person_id":"snv_2iq_jes","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line090:m0025","start":25,"end":27,"surface":"劉備","kind":"person","person_id":"5f2_396_25c","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line090:m0037","start":37,"end":38,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line090:m0040","start":40,"end":41,"surface":"騭","kind":"person","person_id":"snv_2iq_jes","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line090:m0045","start":45,"end":46,"surface":"備","kind":"person","person_id":"5f2_396_25c","status":"contextual_provisional","interpretation_note":"以來源原字標記