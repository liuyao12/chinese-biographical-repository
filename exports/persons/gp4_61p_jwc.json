後遂與之為亂明年妃謁敬后廟東昏即位為皇后帝寵潘妃后不被遇黃淑儀生太子誦而卒東昏廢后及誦並為庶人后父澄自有傳","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-nanshi-011-chulingqu-izumo:p001:m0000","start":0,"end":2,"surface":"東昏","person_id":"w4m_9tw_147_A","kind":"person","status":"contextual_provisional","interpretation_note":"篇首冠所配君主之號。"},{"id":"c-nanshi-011-chulingqu-izumo:p001:m0002","start":2,"end":5,"surface":"褚皇后","person_id":"6fs_tis_zoa_AA","kind":"person","status":"contextual_provisional","interpretation_note":"傳主后號。"},{"id":"c-nanshi-011-chulingqu-izumo:p001:m0006","start":6,"end":8,"surface":"令璩","person_id":"6fs_tis_zoa_AA","kind":"person","status":"contextual_provisional","interpretation_note":"傳主名字。"},{"id":"c-nanshi-011-chulingqu-izumo:p001:m0015","start":15,"end":16,"surface":"澄","person_id":"6fs_tis_zoa_A","kind":"person","status":"contextual_provisional","interpretation_note":"父名。"},{"id":"c-nanshi-011-chulingqu-izumo:p001:m0040","start":40,"end":43,"surface":"山陰主","person_id":"w4m_9tw_147_G","kind":"person","status":"contextual_provisional","interpretation_note":"依本段字位。"},{"id":"c-nanshi-011-chulingqu-izumo:p001:m0046","start":46,"end":49,"surface":"山陰主","person_id":"w4m_9tw_147_G","kind":"person","status":"contextual_provisional","interpretation_note":"依本段字位。"},{"id":"c-nanshi-011-chulingqu-izumo:p001:m0049","start":49,"end":51,"surface":"明帝","person_id":"w4m_9tw_147","kind":"person","status":"contextual_provisional","interpretation_note":"依本段字位。"},{"id":"c-nanshi-011-chulingqu-izumo:p001:m0064","start":64,"end":66,"surface":"敬后","person_id":"gjl_f5h_2a6_A","kind":"person","status":"contextual_provisional","interpretation_note":"廟中所祀者為明敬皇后惠端。"},{"id":"c-nanshi-011-chulingqu-izumo:p001:m0076","start":76,"end":78,"surface":"潘妃","person_id":"gp4_61p_jwc","kind":"person","status":"contextual_provisional","interpretation_note":"東昏所寵潘氏。"},{"id":"c-nanshi-011-chulingqu-izumo:p001:m0082","start":82,"end":85,"surface":"黃淑儀","person_id":"nxr_ok6_sn7","kind":"person","statu