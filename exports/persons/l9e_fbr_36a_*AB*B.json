e_fbr_36a_*AB*A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m007-0121","start":121,"end":122,"surface":"說","kind":"person","person_id":"l9e_fbr_36a_*AB*B","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m007-0137","start":137,"end":138,"surface":"子","kind":"person","person_id":"l9e_fbr_36a_*AB*BA","status":"contextual_provisional","note":"子為韓說之子；代是承襲用語，不作名字。古注報名長君另存，不加入正文名。"},{"id":"c-shiji-093-hanlu:m007-0150","start":150,"end":153,"surface":"說孫曾","kind":"person","person_id":"l9e_fbr_36a_*AB*B*A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m007-0160","start":160,"end":161,"surface":"說","kind":"person","person_id":"l9e_fbr_36a_*AB*B","status":"contextual_provisional"}],"chapter_id":"c-shiji-093-hanlu","book_id":"b-shiji-093","work_id":"w-shiji","source_id":"s-shiji-093-hanlu"},{"id":"c-shiji-110-xiongnu:p054","text":"呴犁湖單于立，漢使光祿徐自爲出五原塞數百里，遠者千餘里，築城鄣列亭至廬朐，而使游擊將軍韓說、長平侯衛伉屯其旁，使彊弩都尉路博德築居延澤上。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-110-xiongnu:m054-0000","start":0,"end":3,"surface":"呴犁湖","kind":"person","person_id":"wjt_htu_081_AABB","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m054-0011","start":11,"end":14,"surface":"徐自爲","kind":"person","person_id":"3jt_wmb_7c3","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m054-0043","start":43,"end":45,"surface":"韓說","kind":"person","person_id":"tvo_aez_7nt","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m054-0049","start":49,"end":51,"surface":"衛伉","kind":"person","person_id":"1n0_bu8_jv2","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m054-0060","start":60,"end":63,"surface":"路博德","kind":"person","person_id":"wxg_pg3_wk0","status":"contextual_provisional"}],"chapter_id":"c-shiji-110-xiongnu","book_id":"b-shiji-110","work_id":"w-shiji","source_id":"s-shiji110-xiongnu"},{"id":"c-shiji-125-ningxing:p003","text":"嫣者，弓高侯孽孫也。今上為膠東王時，嫣與上學書相愛。及上為太子，愈益親嫣。嫣善騎射，善佞。上即位，欲事伐匈奴，而嫣先習胡兵，以故益尊貴，官至上大夫，賞賜擬於鄧通。時嫣常與上臥起。江都王入朝，有詔得從入獵上林中。天子車駕蹕道未行，而先使嫣乘副車，從數十百騎，騖馳視獸。江都王望見，以為天子，辟從者，伏謁道傍。嫣驅不見。既過，江都王怒，為皇太后泣曰：「請得歸國入宿衛，比韓嫣。」太后由此嗛嫣。嫣侍上，出入永巷不禁，以姦聞皇太后。皇太后怒，使使賜嫣死。上為謝，終不能得，嫣遂死。而案道侯韓說，其弟也，亦佞幸。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-125-ningxing:m003-0000","start":0,"end":1,"surface":"嫣","kind":"person","person_id":"l9e_fbr_36a_*AB*A","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m003-0003","start":3,"end":6,"surface":"弓高侯","kind":"person","person_id":"l9e_fbr_36a_*AB","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m003-0010","start":10,"end":12,"surface":"今上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m003-0018","start":18,"end":19,"surface":"嫣","kind":"person","person_id":"l9e_fbr_36a_*AB*A","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m003-0020","start":20,"end":21,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m003-0027","start":27,"end":28,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m003-0035","start":35,"end":36,"surface":"嫣","kind":"person","person_id":"l9e_fbr_36a_*AB*A","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m003-0037","start":37,"end":38,"surface":"嫣","kind":"person","person_id":"l9e_fbr_36a_*AB*A","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m003-0045","start":45,"end":46,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m003-0056","start":56,"end":57,"surface":"嫣","kind":"person","person_id":"l9e_fbr_36a_*AB*A","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m003-0070","start":70,"end":71,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-125-ningxin