{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"2zg_srk_2oc","canonical_person_id":"2zg_srk_2oc","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["2zg_srk_2oc"],"persons":[{"id":"2zg_srk_2oc","label":"韓子（游俠列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"韓子","mention_ids":["c-shiji-124-youxia:m001-0000"]}],"evidence":[{"mention_id":"c-shiji-124-youxia:m001-0000","chapter_id":"c-shiji-124-youxia","paragraph_id":"c-shiji-124-youxia:p001","quote":"韓子"}]}],"source_mention_summary":[{"source_id":"s-shiji124-youxia","work_id":"w-shiji","book_id":"b-shiji-124","chapter_id":"c-shiji-124-youxia","mention_count":1,"mention_ids":["c-shiji-124-youxia:m001-0000"],"paragraph_ids":["c-shiji-124-youxia:p001"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji124-youxia"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-124-youxia:m001-0000","start":0,"end":2,"surface":"韓子","kind":"person","person_id":"2zg_srk_2oc","status":"contextual_provisional","paragraph_id":"c-shiji-124-youxia:p001","chapter_id":"c-shiji-124-youxia"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-124-youxia:p001","text":"韓子曰：「儒以文亂法，而俠以武犯禁。」二者皆譏，而學士多稱於世云。至如以術取宰相卿大夫，輔翼其世主，功名俱著於春秋，固無可言者。及若季次、原憲，閭巷人也，讀書懷獨行君子之德，義不苟合當世，當世亦笑之。故季次、原憲終身空室蓬戶，褐衣疏食不厭。死而已四百餘年，而弟子志之不倦。今遊俠，其行雖不軌於正義，然其言必信，其行必果，已諾必誠，不愛其軀，赴士之阨困，既已存亡死生矣，而不矜其能，羞伐其德，蓋亦有足多者焉。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-124-youxia:m001-0000","start":0,"end":2,"surface":"韓子","kind":"person","person_id":"2zg_srk_2oc","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m001-0066","start":66,"end":68,"surface":"季次","kind":"person","person_id":"bng_j1i_9o1","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m001-0069","start":69,"end":71,"surface":"原憲","kind":"person","person_id":"1uz_uup_f9o","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m001-0101","start":101,"end":103,"surface":"季次","kind":"person","person_id":"bng_j1i_9o1","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m001-0104","start":104,"end":106,"surface":"原憲","kind":"person","person_id":"1uz_uup_f9o","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m001-0129","start":129,"end":131,"surface":"弟子","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-124-youxia","book_id":"b-shiji-124","work_id":"w-shiji","source_id":"s-shiji124-youxia"}],"sources":[{"chapter_id":"c-shiji-124-youxia","work_id":"w-shiji","book_id":"b-shiji-124","source_id":"s-shiji124-youxia","source":{"title":"史記／卷124","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷124","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷124&oldid=367994","revision_id":367994,"accessed_on":"2026-10-11","extent":"固定修訂全文17段，包括末段索隱述贊。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"去header2、現代節標、Textquality及wikipedia導覽模板；原文字面保留，原字未轉換，未核影像。","note":"末段索隱述贊另分層。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical"}}
