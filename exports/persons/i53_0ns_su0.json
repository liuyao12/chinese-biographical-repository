63487"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-064-tengyin-complete:p001:m0122","surface":"公主","start":122,"end":124,"kind":"person","person_id":"i53_0ns_su0","status":"contextual_provisional","paragraph_id":"c-sanguozhi-064-tengyin-complete:p001","chapter_id":"c-sanguozhi-064-tengyin-complete"},{"id":"c-sanguozhi-064-tengyin-complete:p003:m0032","surface":"公主","start":32,"end":34,"kind":"person","person_id":"i53_0ns_su0","status":"contextual_provisional","paragraph_id":"c-sanguozhi-064-tengyin-complete:p003","chapter_id":"c-sanguozhi-064-tengyin-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-064-tengyin-complete:p001","text":"　　滕胤字承嗣，北海劇人也。伯父耽，父冑，與劉繇州裡通家。以世擾亂，渡江依繇。孫權為車騎將軍，拜耽右司馬，以寬厚稱，早卒，無嗣。冑善屬文，權待以賓禮，軍國書疏，常令損益潤色之，亦不幸短命。權為吳王，迫錄舊恩，封胤都亭侯。少有節操，美容儀。弱冠尚公主。年三十，起家為丹楊太守，徙吳郡、會稽，所在見稱。太元元年，權寢疾，詣都，留為太常；與諾葛恪等俱受遺詔輔政。孫亮即位，加衛將軍。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":65,"last_line":65,"raw_start":8605,"raw_end":8946,"raw_character_offsets":[8605,8606,8607,8608,8609,8610,8611,8612,8613,8614,8615,8616,8617,8618,8619,8620,8621,8622,8623,8624,8625,8626,8627,8628,8629,8630,8631,8632,8633,8634,8635,8636,8637