":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-047-sun-quan:p029:m0321","surface":"梁寓","start":321,"end":323,"kind":"person","person_id":"vrg_gxr_yq4","status":"contextual_provisional","paragraph_id":"c-sanguozhi-047-sun-quan:p029","chapter_id":"c-sanguozhi-047-sun-quan"},{"id":"c-sanguozhi-047-sun-quan:p030:m0006","surface":"梁寓","start":6,"end":8,"kind":"person","person_id":"vrg_gxr_yq4","status":"contextual_provisional","paragraph_id":"c-sanguozhi-047-sun-quan:p030","chapter_id":"c-sanguozhi-047-sun-quan"},{"id":"c-sanguozhi-047-sun-quan:p030:m0009","surface":"孔儒","start":9,"end":11,"kind":"person","person_id":"vrg_gxr_yq4","status":"contextual_provisional","paragraph_id":"c-sanguozhi-047-sun-quan:p030","chapter_id":"c-sanguozhi-047-sun-quan"},{"id":"c-sanguozhi-047-sun-quan:p030:m0018","surface":"寓","start":18,"end":19,"kind":"person","person_id":"vrg_gxr_yq4","status":"contextual_provisional","paragraph_id":"c-sanguozhi-047-sun-quan:p030","chapter_id":"c-sanguozhi-047-sun-quan"},{"id":"c-sanguozhi-047-sun-quan:p048:m0174","surface":"梁寓","start":174,"end":176,"kind":"person","person_id":"vrg_gxr_yq4","status":"contextual_provisional","paragraph_id":"c-sanguozhi-047-sun-quan:p048","chapter_id":"c-sanguozhi-047-sun-quan"},{"id":"c-sanguozhi-047-sun-quan:p048:m0369","surface":"梁寓","start":369,"end":371,"kind":"person","person_id":"vrg_gxr_yq4","status":"contextual_provisional","paragraph_id":"c-sanguozhi-047-sun-quan:p048","chapter_id":"c-sanguozhi-047-sun-quan"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-047-sun-quan:p029","text":"　　二十四年，關羽圍曹仁於襄陽，曹公遣左將軍于禁救之。會漢水暴起，羽以舟兵盡生虜禁等步騎三萬送江陵，惟城未拔。權內憚羽，外欲以爲己功，箋與曹公，乞以討羽自效。曹公且欲使羽與權相持以鬬之，驛傳權書，使曹仁以弩射示羽。羽猶豫不能去。閏月，權征羽，先遣呂蒙襲公安，獲將軍士仁。蒙到南郡，南郡太守糜芳以城降，蒙據江陵，撫其老弱，釋於禁之囚。陸遜別取宜都，獲秭歸、枝江、夷道，還屯夷陵，守峽口以備蜀。關羽還當陽，西保麥城。權使誘之。羽偽降，立幡旗爲像人於城上，因遁走，兵皆解散，尚十餘騎。權先使朱然、潘璋斷其徑路。十二月，璋司馬馬忠獲羽及其子平、都督趙累等於章鄉，遂定荊州。是歳大疫，盡除荊州民租稅。曹公表權爲驃騎將軍，假節領荊州牧，封南昌侯。權遣校尉梁寓奉貢於漢。及令王惇市馬，又遣朱光等歸。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":44,"last_line":44,"raw_start":3988,"raw_end":4480,"raw_character_offsets":[3988,3989,3990,3991,3992,3993,3994,3995,3996,3997,4005,4006,4009,4010,4011,4012,4013,4014,4015,4016,4017,4018,4026,4027,4030,4031,4032,4033,4034,4035,4036,4037,4038,4039,4040,4041,4042,4043,4044,4045,4046,4047,4048,4049,4050,4051,4052,4053,4054,4055,4056,4057,4058,4059,4060,4061,4062,4063,4064,4065,4066,4067,4068,4069,4070,4071,4072,4073,4074,4075,4076,4077,4078,4079,4080,4081,4082,4083,4084,4085,4086,4087,4088,4089,4090,4091,4092,4093,4094,4095,4096,4097,4098,4099,4100,4101,4102,4103,4104,4105,4106,4107,4108,4109,4110,4111,4112,4113,4114,4115,4116,4117,4118,4119,4120,4121,4122,4123,4126,4129,4130,4131,4132,4133,4134,4135,4136,4137,4138,4139,4140,4141,4149,4150,4153,4154,4155,4156,4157,4158,4159,4160,4161,4162,4170,4171,4174,4175,4176,4177,4178,4179,4180,4181,4182,4183,4184,4185,4186,4187,4188,4189,4190,4191,4192,4193,4201,4202,4205,4206,4207,4208,4209,4210,4211,4212,4213,4214,4215,4216,4217,4218,4219,4220,4221,4222,4223,4224,4225,4226,4227,4228,4229,4230,4231,4232,4233,4234,4242,4243,4246,4247,4248,4256,4257,4260,4261,4262,4263,4264,4265,4266,4267,4268,4269,4270,4271,4272,4273,4274,4275,4276,4277,4278,4279,4280,4281,4282,4283,4284,4285,4286,4287,4288,4289,4290,4291,4292,4293,4294,4295,4296,4306,4309,4312,4313,4314,4315,4316,4317,4318,4319,4320,4321,4322,4323,4324,4325,4326,4327,4328,4329,4330,4331,4332,4333,4334,4335,4336,4337,4338,4339,4340,4341,4342,4343,4344,4345,4346,4347,4348,4349,4350,4351,4352,4353,4354,4355,4356,4357,4358,4359,4360,4361,4362,4363,4364,4365,4366,4367,4377,4378,4379,4380,4383,4384,4385,4386,4387,4388,4389,4390,4391,4392,4393,4394,4395,4396,4397,4398,4399,4407,4408,4411,4412,4413,4414,4415,4416,4417,4418,4419,4420,4421,4422,4423,4424,4427,4430,4431,44