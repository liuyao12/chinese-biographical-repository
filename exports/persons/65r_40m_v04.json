{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"65r_40m_v04","canonical_person_id":"65r_40m_v04","id_aliases":["cbr-p005365"],"identity_policy":"contextual_provisional","person_ids":["65r_40m_v04"],"persons":[{"id":"65r_40m_v04","label":"陳餘（張丞相列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"陳餘","mention_ids":["c-shiji-096-zhang:m001-0117","c-shiji-096-zhang:m001-0150"]}],"evidence":[{"mention_id":"c-shiji-096-zhang:m001-0117","chapter_id":"c-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p001","quote":"陳餘"},{"mention_id":"c-shiji-096-zhang:m001-0150","chapter_id":"c-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p001","quote":"陳餘"}],"id_aliases":["cbr-p005365"]}],"source_mention_summary":[{"source_id":"s-shiji-096-zhang","work_id":"w-shiji","book_id":"b-shiji-096","chapter_id":"c-shiji-096-zhang","mention_count":2,"mention_ids":["c-shiji-096-zhang:m001-0117","c-shiji-096-zhang:m001-0150"],"paragraph_ids":["c-shiji-096-zhang:p001"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-096-zhang"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-096-zhang:m001-0117","start":117,"end":119,"surface":"陳餘","kind":"person","person_id":"65r_40m_v04","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p001","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m001-0150","start":150,"end":152,"surface":"陳餘","kind":"person","person_id":"65r_40m_v04","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p001","chapter_id":"c-shiji-096-zhang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji096-007","person_id":"65r_40m_v04","surfaces":["陳餘"],"scope":"same_chapter","chapter_ids":["c-shiji-096-zhang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-096-zhang:p001","quote":"張丞相蒼者，陽武人也。好書律歷。秦時為御史，主柱下方書。有罪，亡歸。及沛公略地過陽武，蒼以客從攻南陽。蒼坐法當斬，解衣伏質，身長大，肥白如瓠，時王陵見而怪其美士，乃言沛公，赦勿斬。遂從西入武關，至咸陽。沛公立為漢王，入漢中，還定三秦。陳餘擊走常山王張耳，耳歸漢，漢乃以張蒼為常山守。從淮陰侯擊趙，蒼得陳餘。趙地已平，漢王以蒼為代相，備邊寇。已而徙為趙相，相趙王耳。耳卒，相趙王敖。復徙相代王。燕王臧荼反，高祖往擊之。蒼以代相從攻臧荼有功，以六年中封為北平侯，食邑千二百戶。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定短稱；韋賢與韋玄成分傳區別，第23段掾陳平另候選，第25段長安相工田文不與孟嘗君合併。趙堯、任敖、申屠嘉、鄧通、晁錯的短名依各段人物語境，王陵夫人與王陵分人。張蒼父長不滿五尺的長為身長敘述，不作父名。王侯與太子未詳名不補名，跨篇同指另待證據。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-096-zhang:p001","text":"張丞相蒼者，陽武人也。好書律歷。秦時為御史，主柱下方書。有罪，亡歸。及沛公略地過陽武，蒼以客從攻南陽。蒼坐法當斬，解衣伏質，身長大，肥白如瓠，時王陵見而怪其美士，乃言沛公，赦勿斬。遂從西入武關，至咸陽。沛公立為漢王，入漢中，還定三秦。陳餘擊走常山王張耳，耳歸漢，漢乃以張蒼為常山守。從淮陰侯擊趙，蒼得陳餘。趙地已平，漢王以蒼為代相，備邊寇。已而徙為趙相，相趙王耳。耳卒，相趙王敖。復徙相代王。燕王臧荼反，高祖往擊之。蒼以代相從攻臧荼有功，以六年中封為北平侯，食邑千二百戶。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhang:m001-0003","start":3,"end":4,"surface":"蒼","kind":"person","person_id":"796_nkw_0jz_A","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m001-0035","start":35,"end":37,"surface":"沛公","kind":"person","person_id":"h8q_zyo_i2l","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m001-0043","start":43,"end":44,"surface":"蒼","kind":"person","person_id":"796_nkw_0jz_A","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m001-0051","start":51,"end":52,"surface":"蒼","kind":"person","person_id":"796_nkw_0jz_A","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m001-0072","start":72,"end":74,"surface":"王陵","kind":"person","person_id":"rta_39f_d5q","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m001-00