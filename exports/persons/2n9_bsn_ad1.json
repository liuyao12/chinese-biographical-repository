{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"2n9_bsn_ad1","canonical_person_id":"2n9_bsn_ad1","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["2n9_bsn_ad1"],"persons":[{"id":"2n9_bsn_ad1","label":"陶朱（平津侯主父列傳上書候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"陶朱","mention_ids":["c-shiji-112-pingjin:m015-0075"]}],"evidence":[{"mention_id":"c-shiji-112-pingjin:m015-0075","chapter_id":"c-shiji-112-pingjin","paragraph_id":"c-shiji-112-pingjin:p015","quote":"陶朱"}]}],"source_mention_summary":[{"source_id":"s-shiji112-pingjin","work_id":"w-shiji","book_id":"b-shiji-112","chapter_id":"c-shiji-112-pingjin","mention_count":1,"mention_ids":["c-shiji-112-pingjin:m015-0075"],"paragraph_ids":["c-shiji-112-pingjin:p015"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji112-pingjin"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-112-pingjin:m015-0075","start":75,"end":77,"surface":"陶朱","kind":"person","person_id":"2n9_bsn_ad1","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p015","chapter_id":"c-shiji-112-pingjin"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-112-pingjin:p015","text":"臣聞天下之患在於土崩，不在於瓦解，古今一也。何謂土崩？秦之末世是也。陳涉無千乘之尊，尺土之地，身非王公大人名族之后，無鄉曲之譽，非有孔、墨、曾子之賢，陶朱、猗頓之富也，然起窮巷，奮棘矜，偏袒大呼而天下從風，此其故何也？由民困而主不恤，下怨而上不知（也），俗已亂而政不修，此三者陳涉之所以為資也。是之謂土崩。故曰天下之患在於土崩。何謂瓦解？吳、楚、齊、趙之兵是也。七國謀為大逆，號皆稱萬乘之君，帶甲數十萬，威足以嚴其境內，財足以勸其士民，然不能西攘尺寸之地而身為禽於中原者，此其故何也？非權輕於匹夫而兵弱於陳涉也，當是之時，先帝之德澤未衰而安土樂俗之民眾，故諸侯無境外之助。此之謂瓦解，故曰天下之患不在瓦解。由是觀之，天下誠有土崩之勢，雖布衣窮處之士或首惡而危海內，陳涉是也。況三晉之君或存乎！天下雖未有大治也，誠能無土崩之勢，雖有彊國勁兵不得旋踵而身為禽矣，吳、楚、齊、趙是也。況群臣百姓能為亂乎哉！此二體者，安危之明要也，賢主所留意而深察也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-112-pingjin:m015-0034","start":34,"end":36,"surface":"陳涉","kind":"person","person_id":"b74_xpn_elo","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0066","start":66,"end":67,"surface":"孔","kind":"person","person_id":"wsh_uzd_aj3","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0068","start":68,"end":69,"surface":"墨","kind":"person","person_id":"lni_lzq_7s0","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0070","start":70,"end":72,"surface":"曾子","kind":"person","person_id":"zvp_ubd_334","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0075","start":75,"end":77,"surface":"陶朱","kind":"person","person_id":"2n9_bsn_ad1","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0078","start":78,"end":80,"surface":"猗頓","kind":"person","person_id":"3r9_0to_we7","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0138","start":138,"end":140,"surface":"陳涉","kind":"person","person_id":"b74_xpn_elo","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0181","start":181,"end":183,"surface":"七國","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-112-pingjin:m015-0252","start":252,"end":254,"surface":"陳涉","kind":"person","person_id":"b74_xpn_elo","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0261","start":261,"end":263,"surface":"先帝","kind":"person","person_id":"moo_r04_tz1","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0332","start":332,"end":334,"surface":"陳涉","kind":"person","person_id":"b74_xpn_elo","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015