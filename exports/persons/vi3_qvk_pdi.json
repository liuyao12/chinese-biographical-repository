n_note":"以來源原字標記。"},{"id":"c-sanguozhi-048-jin043-shiwei:wuoffice:m0007","start":7,"end":8,"surface":"偉","kind":"person","person_id":"vi3_qvk_pdi","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"text_layer":"witness_appended_pei_songzhi_note","source_quote":{"witness":"sg","quote":"孫休即位，特徵偉，累遷至光祿勳。","raw_start":5211,"raw_end":5227,"raw_line":45,"source_layer":"裴注引楚國先賢傳"},"attribution":{"annotator":"裴松之","quoted_work":"楚國先賢傳"},"chapter_id":"c-sanguozhi-048-jin043-shiwei","book_id":"b-sanguozhi-048","work_id":"w-sanguozhi","source_id":"s-sanguozhi-048-jin043-shiwei"},{"id":"c-sanguozhi-048-sun-xiu:p011","text":"四年夏五月，大雨，水泉涌溢。秋八月，遣光祿大夫周弈、石偉巡行風俗，察將吏清濁，民所疾苦，爲黜陟之詔。九月，布山言白龍見。是歲，安吳民陳焦死，埋之，六日更生，穿土中出。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":45,"last_line":45,"raw_start":5097,"raw_end":5406,"raw_character_offsets":[5104,5105,5106,5107,5108,5109,5110,5111,5112,5113,5114,5115,5116,5117,5118,5119,5120,5121,5122,5123,5124,5125,5126,5127,5128,5129,5130,5131,5132,5133,5134,5135,5136,5137,5138,5139,5140,5141,5142,5143,5144,5145,5146,5147,5148,5149,5150,5151,5152,5153,5373,5374,5375,5376,5377,5378,5379,5380,5381,5382,5383,5384,5385,5386,5387,5388,5389,5390,5391,5392,5393,5394,5395,5396,5397,5398,5399,5400,5401,5402,5403,5404,5405],"revision_id":2085142},"mentions":[{"id":"c-sanguozhi-048-sun-xiu:p011:m0026","surface":"石偉","start":26,"end":28,"kind":"person","person_id":"vi3_qvk_pdi","status":"contextual_provisional"}],"chapter_id":"c-sanguozhi-048-sun-xiu","book_id":"b-sanguozhi-048","work_id":"w-sanguozhi","source_id":"s-sanguozhi-048-sun-xiu-ws2085142"},{"id":"c-sanguozhi-048-sun-xiu:p012","text":"《楚國先賢傳》曰：石偉字公操，南郡人。少好學，脩節不怠，介然獨立，有不可奪之志。舉茂才、賢良方正，皆不就。孫休即位，特徵偉，累遷至光祿勳。及皓即位，朝政昏亂，偉乃辭老耄痼疾乞身，就拜光祿大夫。吳平，建威將軍王戎親詣偉。太康二年，詔曰：「吳故光祿大夫石偉，秉志清白，皓首不渝，難處危亂，廉節可紀。年已過邁，不堪遠涉，其以偉爲議郎，加二千石秩，以終厥世。」偉遂陽狂及盲，不受晉爵。年八十三，太熙元年卒。","text_layer":"witness_appended_pei_songzhi_note","annotation_status":"reviewed","source_position":{"first_line":45,"last_line":45,"raw_start":5158,"raw_end":5371,"raw_character_offsets":[5158,5159,5160,5161,5162,5163,5164,5165,5166,5167,5168,5169,5170,5171,5172,5173,5174,5175,5176,5177,5178,5179,5180,5181,5182,5183,5184,5185,5186,5187,5188,5189,5190,5191,5192,5193,5194,5195,5196,5197,5198,5199,5200,5201,5202,5203,5204,5205,5206,5207,5208,5209,5210,5211,5212,5213,5214,5215,5216,5217,5218,5219,5220,5221,5222,5223,5224,5225,5226,5227,5228,5229,5230,5231,5232,5233,5234,5235,5236,5237,5238,5239,5240,5241,5242,5243,5244,5245,5246,5247,5248,5249,5250,5251,5252,5253,5254,5255,5256,5257,5258,5259,5260,5261,5262,5263,5264,5265,5266,5272,5273,5274,5275,5278,5279,5280,5281,5282,5283,5284,5285,5286,5287,5288,5289,5290,5291,5292,5293,5294,5295,5296,5297,5298,5299,5300,5301,5302,5303,5304,5305,5306,5307,5308,5309,5310,5311,5312,5313,5314,5315,5316,5317,5318,5319,5320,5321,5322,5323,5324,5325,5326,5327,5328,5329,5330,5331,5332,5333,5334,5335,5336,5337,5338,5339,5340,5341,5342,5343,5344,5345,5346,5347,5348,5349,5350,5351,5352,5353,5354,5355,5356,5357,5363,5364,5365,5366,5369,5370],"revision_id":2085142},"mentions":[{"id":"c-sanguozhi-048-sun-xiu:p012:m0009","surface":"石偉","start":9,"end":11,"kind":"person","person_id":"vi3_qvk_pdi","status":"contextual_provisional"},{"id":"c-sanguozhi-048-sun-xiu:p012:m0012","surface":"公操","start":12,"end":14,"kind":"person","person_id":"vi3_qvk_pdi","status":"contextual_provisional"},{"id":"c-sanguozhi-048-sun-xiu:p012:m0053","surface":"孫休","start":53,"end":55,"kind":"person","person_id":"0fo_c5c_4yh","status":"contextual_provisional"},{"id":"c-sanguozhi-048-sun-xiu:p012:m0060","surface":"偉","start":60,"end":61,"kind":"person","person_id":"vi3_qvk_pdi","status":"contextual_provisional"},{"id":"c-sanguozhi-048-sun-xiu:p012:m0079","surface":"偉","start":79,"end":80,"kind":"person","person_id":"vi3_qvk_pdi","status":"contextual_provisional"},{"id":"c-sanguozhi-048-sun-xiu:p012:m0096","surface":"吳平","start":96,"end":98,"kind":"person","person_id":"ata_5q8_tld","st