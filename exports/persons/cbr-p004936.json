{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004936","identity_policy":"contextual_provisional","person_ids":["cbr-p004936"],"persons":[{"id":"cbr-p004936","label":"太史公（李斯列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"太史公","mention_ids":["c-shiji-087-lisi:m038-0000"]}],"evidence":[{"mention_id":"c-shiji-087-lisi:m038-0000","chapter_id":"c-shiji-087-lisi","paragraph_id":"c-shiji-087-lisi:p038","quote":"太史公"}]}],"mentions":[{"id":"c-shiji-087-lisi:m038-0000","start":0,"end":3,"surface":"太史公","kind":"person","person_id":"cbr-p004936","status":"contextual_provisional","paragraph_id":"c-shiji-087-lisi:p038","chapter_id":"c-shiji-087-lisi"}],"relations":[],"title_holdings":[{"id":"th-shiji087-032","person_id":"cbr-p004936","title":"太史公","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-087-lisi","source_id":"s-shiji-087-lisi","paragraph_id":"c-shiji-087-lisi:p038","quote":"太史公曰：李斯以閭閻歷諸侯，入事秦，因以瑕釁，以輔始皇，卒成帝業，斯為三公，可謂尊用矣。斯知六藝之歸，不務明政以補主上之缺；持爵祿之重，阿順苟合，嚴威酷刑，聽高邪說，廢適立庶。諸侯已畔，斯乃欲諫爭，不亦末乎？人皆以斯極忠而被五刑死，察其本，乃與俗議之異。不然，斯之功且與周、召列矣。"}],"attestations":[{"id":"th-shiji087-032:a001","paragraph_id":"c-shiji-087-lisi:p038","start":0,"end":3,"surface":"太史公","person_mention_id":"c-shiji-087-lisi:m038-0000","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"實際授任、引古、追述與文獻用稱分存；未定日期、死亡、下獄與首次用稱不推定任期端點。假御史謁者侍中、擬任蒙恬相與擬裂地王不作實授。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji087-069","person_id":"cbr-p004936","scope":"same_chapter","chapter_ids":["c-shiji-087-lisi"],"status":"contextual_provisional","rationale":"依李斯下獄及秦末局部承接暫接；始皇弟暫依下一段子嬰既位承接，本篇世系主張保留待跨篇覆核。其子與妻子仍待核指，不補父子或配偶；中子、太卜、行人保留未名。韓玘原字保留，宰予與簡公引古不以同名確證全部事實。趙高短稱高限後段敘事，官稱及嵌套指代待核。","reviewer":"Codex（AI 代理）","surfaces":["太史公"],"evidence":[{"paragraph_id":"c-shiji-087-lisi:p038","quote":"太史公曰：李斯以閭閻歷諸侯，入事秦，因以瑕釁，以輔始皇，卒成帝業，斯為三公，可謂尊用矣。斯知六藝之歸，不務明政以補主上之缺；持爵祿之重，阿順苟合，嚴威酷刑，聽高邪說，廢適立庶。諸侯已畔，斯乃欲諫爭，不亦末乎？人皆以斯極忠而被五刑死，察其本，乃與俗議之異。不然，斯之功且與周、召列矣。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-087-lisi:p038","text":"太史公曰：李斯以閭閻歷諸侯，入事秦，因以瑕釁，以輔始皇，卒成帝業，斯為三公，可謂尊用矣。斯知六藝之歸，不務明政以補主上之缺；持爵祿之重，阿順苟合，嚴威酷刑，聽高邪說，廢適立庶。諸侯已畔，斯乃欲諫爭，不亦末乎？人皆以斯極忠而被五刑死，察其本，乃與俗議之異。不然，斯之功且與周、召列矣。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-087-lisi:m038-0000","start":0,"end":3,"surface":"太史公","kind":"person","person_id":"cbr-p004936","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m038-0005","start":5,"end":7,"surface":"李斯","kind":"person","person_id":"cbr-p004868","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m038-0011","start":11,"end":13,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、引古短稱、未定親屬或泛稱保留未解，不補名、世系或神名。"},{"id":"c-shiji-087-lisi:m038-0025","start":25,"end":27,"surface":"始皇","kind":"person","person_id":"cbr-p004874","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m038-0033","start":33,"end":34,"surface":"斯","kind":"person","person_id":"cbr-p004868","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m038-0044","start":44,"end":45,"surface":"斯","kind":"person","person_id":"cbr-p004868","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m038-0079","start":79,"end":80,"surface":"高","kind":"person","person_id":"cbr-p004896","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m038-0088","start":88,"end":90,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、引古短稱、未定親屬或泛稱保留未解，不補名、世系或神名。"},{"id":"c-shiji-087-lisi:m038-0093","start":93,"end":94,"surface":"斯","kind":"person","person_id":"cbr-p004868","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m038-0107","start":107,"end":108,"surface":"斯","kind"