":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-058-luxun:line015","text":"權以兄策女配遜，數訪世務。遜建議曰：「方今英雄棋跱，豺狼規望，克敵寧亂。非眾不濟，而山寇舊惡，依阻深地。夫腹心未平，難以圖遠，可大部伍，取其精銳。」權納其策，以為帳下右部督。會丹楊賊帥費棧受曹公印綬，扇動山越，為作內應，權遣遜討棧。棧支黨多而往兵少，遜乃益施牙幢，分佈鼓角，夜潛山谷間，鼓噪而前，應時破散。遂部伍東三郡，強者為兵，羸者補戶，得精卒數萬人，宿惡蕩除，所過肅清，還屯蕪湖。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-058-luxun:line015:m0000","start":0,"end":1,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line015:m0003","surface":"策","start":3,"end":4,"kind":"person","person_id":"e9c_070_567","status":"contextual_provisional","interpretation_note":"按本段具名及前後親稱、官職定位。"},{"id":"c-sanguozhi-058-luxun:line015:m0004","surface":"女","start":4,"end":5,"kind":"person","person_id":"e9c_070_567_B","status":"contextual_provisional","interpretation_note":"按本段具名及前後親稱、官職定位。"},{"id":"c-sanguozhi-058-luxun:line015:m0006","start":6,"end":7,"surface":"遜","kind":"person","person_id":"lii_454_vuv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line015:m0013","start":13,"end":14,"surface":"遜","kind":"person","person_id":"lii_454_vuv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line015:m0074","start":74,"end":75,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line015:m0093","start":93,"end":94,"surface":"棧","kind":"person","person_id":"uhj_aly_vyh","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line015:m0095","start":95,"end":97,"surface":"曹公","kind":"person","person_id":"dad_b77_b38","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line015:m0110","start":110,"end":111,"sur