id":"c-liangshu-033-wangyun"},{"id":"c-liangshu-033-wangyun:p004:m0088","person_id":"8d4_fth_d4l","surface":"殷芸","start":88,"end":90,"kind":"person","status":"contextual_provisional","interpretation_note":"按同一見證的原字和敘事。","paragraph_id":"c-liangshu-033-wangyun:p004","chapter_id":"c-liangshu-033-wangyun"},{"start":73,"end":75,"surface":"殷芸","id":"c-nanshi-022-wanggui:p002:m0073","person_id":"8d4_fth_d4l","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作芸。","paragraph_id":"c-nanshi-022-wanggui:p002","chapter_id":"c-nanshi-022-wanggui"},{"id":"c-nanshi-033-pei-family:p019:m0135","start":135,"end":137,"surface":"殷芸","kind":"person","person_id":"8d4_fth_d4l","status":"contextual_provisional","interpretation_note":"陳郡殷芸與子野賞好的博學名列，梁030同地望、同友人序列。","paragraph_id":"c-nanshi-033-pei-family:p019","chapter_id":"c-nanshi-033-pei-family"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-liang030-yinyun","person_id":"8d4_fth_d4l","surfaces":["殷芸"],"scope":"same_chapter","status":"contextual_provisional","confidence_level":"medium","identification_basis":{"kind":"source_context","target_mention_ids":["c-liangshu-030-peiziye:p005:m0016"]},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-030","source_id":"s-liang030-ws1508510","chapter_id":"c-liangshu-030-peiziye","paragraph_id":"c-liangshu-030-peiziye:p005","quote":"子野與沛國劉顯、南陽劉之遴、陳郡殷芸、陳留阮孝緒、吳郡顧協、京兆韋棱，皆博極羣書，深相賞好，顯尤推重之。時吳平侯蕭勱、范陽張纘，每討論墳籍，咸折中於子野焉。普通七年，王師北伐，敕子野爲喻魏文，受詔立成，高祖以其事體大，召尚書僕射徐勉、太子詹事周捨、鴻臚卿劉之遴、中書侍郎朱异，集壽光殿以觀之，時並嘆服。高祖目子野而言曰：「其形雖弱，其文甚壯。」俄又敕爲書喻魏相元乂，其夜受旨，子野謂可待旦方奏，未之爲也。及五鼓，敕催令開齋速上，子野徐起操筆，昧爽便就。旣奏，高祖深嘉焉。自是凡諸符檄，皆令草創。子野爲文典而速，不尚麗靡之詞。其制作多法古，與今文體異，當時或有詆訶者，及其末皆翕然重之。或問其爲文速者，子野答云：「人皆成於手，我獨成於心，雖有見否之異，其於刊改一也。」"}],"rationale":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null},{"id":"d-nanshi033-殷芸","person_id":"8d4_fth_d4l","surfaces":["殷芸"],"scope":"same_chapter","status":"contextual_provisional","confidence_level":"medium","identification_basis":{"kind":"source_context","target_mention_ids":["c-nanshi-033-pei-family:p019:m0135"]},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-033","chapter_id":"c-nanshi-033-pei-family","source_id":"s-nanshi033-ws1554233","paragraph_id":"c-nanshi-033-pei-family:p019","quote":"時西北遠邊有白題及滑國遣使由岷山道入貢，此二國歷代弗賓，莫知所出。子野曰：「漢潁陰侯斬胡白題將一人。服虔注云：'白題，胡名也。'又漢定遠侯擊虜，八滑從之，此其後乎。」時人服其博識。敕仍使撰方國使圖，廣述懷來之盛，自要服至於海表，凡二十國。子野與沛國劉顯、南陽劉之遴、陳郡殷芸、陳留阮孝緒、吳郡顧協、京兆韋棱皆博學，深相賞好，顯尤推重之。時吳平侯蕭勱、范陽張纘每討論墳籍，咸折衷於子野。"}],"rationale":"陳郡殷芸與子野賞好的博學名列，梁030同地望、同友人序列。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null}],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-030-peiziye:p005","text":"子野與沛國劉顯、南陽劉之遴、陳郡殷芸、陳留阮孝緒、吳郡顧協、京兆韋棱，皆博極羣書，深相賞好，顯尤推重之。時吳平侯蕭勱、范陽張纘，每討論墳籍，咸折中於子野焉。普通七年，王師北伐，敕子野爲喻魏文，受詔立成，高祖以其事體大，召尚書僕射徐勉、太子詹事周捨、鴻臚卿劉之遴、中書侍郎朱异，集壽光殿以觀之，時並嘆服。高祖目子野而言曰：「其形雖弱，其文甚壯。」俄又敕爲書喻魏相元乂，其夜受旨，子野謂可待旦方奏，未之爲也。及五鼓，敕催令開齋速上，子野徐起操筆，昧爽便就。旣奏，高祖深嘉焉。自是凡諸符檄，皆令草創。子野爲文典而速，不尚麗靡之詞。其制作多法古，與今文體異，當時或有詆訶者，及其末皆翕然重之。或問其爲文速者，子野答云：「人皆成於手，我獨成於心，雖有見否之異，其於刊改一也。」","source_position":{"start":1324,"end":1666,"raw":"　　子野與沛國劉顯、南陽劉之遴、陳郡殷芸、陳留阮孝緒、吳郡顧協、京兆韋棱，皆博極羣書，深相賞好，顯尤推重之。時吳平侯蕭勱、范陽張纘，每討論墳籍，咸折中於子野焉。{{YL|普通七年}}，王師北伐，敕子野爲喻魏文，受詔立成，高祖以其事體大，召尚書僕射徐勉、太子詹事周捨、鴻臚卿劉之遴、中書侍郎朱异，集壽光殿以觀之，時並嘆服。高祖目子野而言曰：「其形雖弱，其文甚壯。」俄又敕爲書喻魏相元乂，其夜受旨，子野謂可待旦方奏，未之爲也。及五鼓，敕催令開齋速上，子野徐起操筆，昧爽便就。旣奏，高祖深嘉焉。自是凡諸符檄，皆令草創。子野爲文典而速，不尚麗靡之詞。其制作多法古，與今文體異，當時或有詆訶者，及其末皆翕然重之。或問其爲文速者，子野答云：「人皆成於手，我獨成於心，雖有見否之異，其於刊改一也。」","raw_path":"sources/liangshu/wikisource-1508510-raw.wikitext"},"mentions":[{"id":"c-liangshu-030-peiziye:p005:m0000","start":0,"end":2,"surface":"子野","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p005:m0005","start":5,"end":7,"surface":"劉顯","kind":"person","person_id":"mcd_vna_05k","status":"contextual_provisional","interpretation