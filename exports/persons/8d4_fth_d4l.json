1,5702,5703,5704,5705,5706,5707,5708,5709,5710,5711,5712,5713,5714,5715,5716,5717,5718,5719,5720,5721,5722,5723,5724,5725,5726,5727,5728,5729,5730,5731,5732,5733,5734,5735,5736,5737,5738,5739,5740,5741,5742,5743,5744,5745,5746,5747],"projection_sha256":"3f47b3a846644547e4f93db76a358698e31551b481075a9fff832a9500130628"},"chapter_id":"c-nanshi-022-wanggui","book_id":"b-nanshi-022","work_id":"w-nanshi","source_id":"s-nanshi-022-wanggui-ws1477957"},{"text":"時西北遠邊有白題及滑國遣使由岷山道入貢，此二國歷代弗賓，莫知所出。子野曰：「漢潁陰侯斬胡白題將一人。服虔注云：'白題，胡名也。'又漢定遠侯擊虜，八滑從之，此其後乎。」時人服其博識。敕仍使撰方國使圖，廣述懷來之盛，自要服至於海表，凡二十國。子野與沛國劉顯、南陽劉之遴、陳郡殷芸、陳留阮孝緒、吳郡顧協、京兆韋棱皆博學，深相賞好，顯尤推重之。時吳平侯蕭勱、范陽張纘每討論墳籍，咸折衷於子野。","source_position":{"start":10762,"end":10954,"raw":"時西北遠邊有白題及滑國遣使由岷山道入貢，此二國歷代弗賓，莫知所出。子野曰：「漢潁陰侯斬胡白題將一人。服虔注云：'白題，胡名也。'又漢定遠侯擊虜，八滑從之，此其後乎。」時人服其博識。敕仍使撰方國使圖，廣述懷來之盛，自要服至於海表，凡二十國。子野與沛國劉顯、南陽劉之遴、陳郡殷芸、陳留阮孝緒、吳郡顧協、京兆韋棱皆博學，深相賞好，顯尤推重之。時吳平侯蕭勱、范陽張纘每討論墳籍，咸折衷於子野。","raw_path":"sources/nanshi/wikisource-1554233-raw.wikitext"},"id":"c-nanshi-033-pei-family:p019","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-nanshi-033-pei-family:p019:m0033","start":33,"end":35,"surface":"子野","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"字幾原、父昭明、著宋略、掌國史及中大通卒，梁030同字、同家系、同著述與朝事。"},{"id":"c-nanshi-033-pei-family:p019:m0038","start":38,"end":42,"surface":"漢潁陰侯","kind":"person","person_id":"sj9_pfu_fwh","status":"contextual_provisional","interpretation_note":"白題斬將的漢潁陰侯，梁030同一白題引古已用灌嬰身份，並保漢初潁陰侯的原稱；不是新授爵事件。"},{"id":"c-nanshi-033-pei-family:p019:m0044","start":44,"end":49,"surface":"白題將一人","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"漢潁陰侯所斬一名未名胡將；個人可分而無名，保原稱未決，不據白題族名造具名人物。"},{"id":"c-nanshi-033-pei-family:p019:m0050","start":50,"end":52,"surface":"服虔","kind":"person","person_id":"rxm_wwu_6ns","status":"contextual_provisional","interpretation_note":"白題胡名也的注者服虔，梁030同一引漢書注字句、同作者，不由單姓任配。"},{"id":"c-nanshi-033-pei-family:p019:m0065","start":65,"end":69,"surface":"漢定遠侯","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"引文不足唯一定位：保留未決候選，不配新人物。"},{"id":"c-nanshi-033-pei-family:p019:m0075","start":75,"end":76,"surface":"之","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"原文明示此稱謂，但本次不足唯一定位；保留未決，不新增臆測身份。"},{"id":"c-nanshi-033-pei-family:p019:m0086","start":86,"end":87,"surface":"其","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"字幾原、父昭明、著宋略、掌國史及中大通卒，梁030同字、同家系、同著述與朝事。"},{"id":"c-nanshi-033-pei-family:p019:m0119","start":119,"end":121,"surface":"子野","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"字幾原、父昭明、著宋略、掌國史及中大通卒，梁030同字、同家系、同著述與朝事。"},{"id":"c-nanshi-033-pei-family:p019:m0124","start":124,"end":126,"surface":"劉顯","kind":"person","person_id":"mcd_vna_05k","status":"contextual_provisional","interpretation_note":"沛國劉顯與子野交好且推師道，梁030同地望、同交遊名列及顯推重短稱。"},{"id":"c-nanshi-033-pei-family:p019:m0129","start":129,"end":132,"surface":"劉之遴","kind":"person","person_id":"q7n_s7f_1cs","status":"contextual_provisional","interpretation_note":"南陽劉之遴先在交遊列、後鴻臚卿觀移魏文，梁030同地望、同官、同文事。"},{"id":"c-nanshi-033-pei-family:p019:m0135","start":135,"end":137,"surface":"殷芸","kind":"person","person_id":"8d4_fth_d4l","status":"contextual_provisional","interpretation_note":"陳郡殷芸與子野賞好的博學名列，梁030同地望、同友人序列。"},{"id":"c-nanshi-033-pei-family:p019:m0140","start":140,"end":143,"surface":"阮孝緒","kind":"person","person_id":"372_tla_k26","status":"contextual_provisional","interpretation_note":"陳留阮孝緒與子野博學賞好，梁030同地望、同友人列。"},{"id":"c-nanshi-033-pei-family:p019:m0146","start":146,"end":148,"surface":"顧協","kind":"person","person_id":"jc6_fqx_h6v","status":"contextual_provisional","interpretation_note":"吳郡顧協與子野博學賞好，梁030同地望、同友人列。"},{"id":"c-nanshi-033-pei-family:p019:m0151","start":151,"end":153,"surface":"韋棱","kind":"person","person_id":"g1o_tw1_xj8","status":"contextual_provisional","interpretation_note":"京兆韋棱在劉顯至顧協的交遊人列末，梁030同地望、同人列與子野交遊脈絡。"},{"id":"c-nanshi-033-pei-family:p019:m0162","start":162,"end":163,"surface":"顯","kind":"person","person_id":"mcd_vna_05k","status":"contextual_provisional","interpretation_note":"沛國劉顯與子野交好且推師道，梁030同地望、同交遊名列及顯推重短稱。"},{"id":"c-nanshi-033-pei-family:p019:m0166","start":166,"end":167,"surface":"之","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"字幾原、父昭明、著宋略、掌國史及中大通卒，梁030同字、同家系、同著述與朝事。"},{"id":"c-nanshi-033-pei-family:p019:m0172","start":172,"end":174,"surface":"蕭勱","kind":"person","person_id":"ik4_l58_n7y","status":"contextual_provisional","interpretation_note":"吳平侯蕭勱與張纘折衷墳籍於子野，梁030同爵、同對談人物和文事。"},{"id":"c-nanshi-033-pei-family:p019:m0177","start":177,"end":179,"surface":"張纘","kind":"person","person_id":"wec_66y_sxi","status":"contextual_provisional","interpretation_note":"范陽張纘與吳平侯蕭勱討論墳籍於子野，梁030同地望、同伴及事件。"},{"id":"c-nanshi-033-pei-family:p019:m0189","start":189,"end":191,"surface":"子野","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"字幾原、父昭明、著宋略、掌國史及中大通卒，梁030同字、同家系、同著述與朝事。"}],"chapter_id":"c-nanshi-033-pei-family","book_id":"b-nanshi-033","work_id":"w-nanshi","source_id":"s-nanshi033-ws1554233"}],"sources":[{"chapter_id":"c-liangshu-030-peiziye","work_id":"w-liangshu","book_id":"b-liangshu-030","source_id":"s-liang030-ws1508510","source":{"title":"梁書/卷30","revision_id":1508510,"revision_timestamp":"2018-10-23T11:04:54Z","status":200,"response_sha256":"a0c2fde0d659c9579a74194db70540c89ea4ff8160f8761aecdeeeec25530db4","raw_sha256":"930b640ef553931a6d0f2c2b8c548fbd69e0f0db12dd6637222764518d1b871f","url":"https://zh.wikisource.org/w/index.php?title=%E6%A2%81%E6%9B%B8%2F%E5%8D%B730&oldid=1508510","api_url":"https://zh.wikisource.org/w/api.php?action=query&format=json&formatversion=2&prop=revisions&rvprop=ids%7Ctimestamp%7Ccontent&rvslots=main&titles=%E6%A2%81%E6%9B%B8%2F%E5%8D%B730","image_verified":false,"human_reviewed":false,"