:"9dc8d9a41a5d458d2a0f51366eb51868bdb7dc041d8a2f35a33fbf7683551dd0"},"chapter_id":"c-liangshu-033-wangyun","book_id":"b-liangshu-033","work_id":"w-liangshu","source_id":"s-liangshu-033-wangyun-ws1514481"},{"id":"c-nanshi-022-wanggui:p002","text":"天監十二年，改造太極殿畢，規獻新殿賦，其辭甚工。後為晉安王綱雲麾諮議參軍，久之，為新安太守。父憂去職，服闋，襲封南昌縣侯。除中書黃門侍郎，敕與陳郡殷芸、琅邪王錫、范陽張緬同侍東宮，俱為昭明太子所禮。湘東王繹時為丹陽尹，與朝士宴集，屬規為酒令。規從容曰：「江左以來，未有茲舉。」特進蕭琛、金紫光祿大夫傅昭在坐，並謂為知言。朱異嘗因酒卿規，規責以無禮。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"start":13,"end":14,"surface":"規","id":"c-nanshi-022-wanggui:p002:m0013","person_id":"7r6_k52_qji_ABAAAAEAAAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作規。"},{"start":29,"end":30,"surface":"綱","id":"c-nanshi-022-wanggui:p002:m0029","person_id":"rtd_v0b_nyn","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作綱。"},{"start":73,"end":75,"surface":"殷芸","id":"c-nanshi-022-wanggui:p002:m0073","person_id":"8d4_fth_d4l","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作芸。"},{"start":78,"end":80,"surface":"王錫","id":"c-nanshi-022-wanggui:p002:m0078","person_id":"q7m_r8k_2vn_ABAB","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作錫。"},{"start":83,"end":85,"surface":"張緬","id":"c-nanshi-022-wanggui:p002:m0083","person_id":"0lf_ggf_5xo_A","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作緬。"},{"start":102,"end":103,"surface":"繹","id":"c-nanshi-022-wanggui:p002:m0102","person_id":"rvc_bqx_v5w","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作繹。"},{"start":110,"end":112,"surface":"朝士","id":"c-nanshi-022-wanggui:p002:u0110","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"宴集群體未具名。"},{"start":116,"end":117,"surface":"規","id":"c-nanshi-022-wanggui:p002:m0116","person_id":"7r6_k52_qji_ABAAAAEAAAA","kind":"person","status":"contextual_provisional","int