operator":"lt","older_ordinal":null,"younger_ordinal":null,"scope":"siblings","interpretation_status":"source_attested","comparison_basis":"birth_chronology","assertion_id":"a-shiji004-050","person_id":"3hy_4xq_wqu","evidence":[{"paragraph_id":"c-shiji-004-zhou:p055","quote":"匡王六年，崩，弟瑜立","chapter_id":"c-shiji-004-zhou","source_id":"s-shiji-004-zhou"}]}],"identity_decisions":[{"id":"d-shiji004-036","person_id":"3hy_4xq_wqu","surfaces":["瑜","定王"],"scope":"same_chapter","chapter_ids":["c-shiji-004-zhou"],"status":"source_explicit","evidence":[{"paragraph_id":"c-shiji-004-zhou:p055","quote":"三十二年，襄王崩，子頃王壬臣立。頃王六年，崩，子匡王班立。匡王六年，崩，弟瑜立，是為定王。"}],"rationale":"本文同段明示即位稱號或在同一事件中使用全稱與簡稱；判斷僅適用此處，不作全庫字串匹配。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"identity_distinctions":[{"id":"d-shiji004-distinct-004","person_ids":["3hy_4xq_wqu","mww_f6f_st9"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-004-zhou:p055","quote":"三十二年，襄王崩，子頃王壬臣立。頃王六年，崩，子匡王班立。匡王六年，崩，弟瑜立，是為定王。","chapter_id":"c-shiji-004-zhou","work_id":"w-shiji","book_id":"b-shiji-004","source_id":"s-shiji-004-zhou"},{"paragraph_id":"c-shiji-004-zhou:p063","quote":"四十二年，敬王崩，子元王仁立。元王八年，崩，子定王介立。","chapter_id":"c-shiji-004-zhou","work_id":"w-shiji","book_id":"b-shiji-004","source_id":"s-shiji-004-zhou"}],"rationale":"本文分別稱瑜與介為定王，置於不同世代。","reviewer":"Codex（AI 代理）"}],"passages":[{"id":"c-sanguozhi-052-zhangzhao-complete:line012-pei01-02","text":"昭著论曰：「客有见大国之议，士君子之论，云起元建武已来，旧君名讳五十六人，以为后生不得协也。取乎经论，譬诸行事，义高辞丽，甚可嘉羡。愚意褊浅，窃有疑焉。盖乾坤剖分，万物定形，肇有父子君臣之经。故圣人顺天之性，制礼尚敬，在三之义，君实食之，在丧之哀，君亲临之，厚莫重焉，恩莫大焉，诚臣子所尊仰，万夫所天恃，焉得而同之哉？然亲亲有衰，尊尊有杀，故礼服上不尽高祖，下不尽玄孙。又传记四世而缌麻，服之穷也；五世袒免，降杀同姓也；六世而亲属竭矣。又曲礼有不逮事之义则不讳，不讳者，盖名之谓，属绝之义，不拘於协，况乃古君五十六哉！邾子会盟，季友来归，不称其名，咸书字者，是时鲁人嘉之也。何解臣子为君父讳乎？周穆王讳满，至定王时有王孙满者，其为大夫，是臣协君也。又厉王讳胡，及庄王之子名胡，其比众多。夫类事建议，经有明据，传有徵案，然后进攻退守，万无奔北，垂示百世，永无咎失。今应劭虽上尊旧君之名，而下无所断齐，犹归之疑云。曲礼之篇，疑事无质，观省上下，阙义自证，文辞可为，倡而不法，将来何观？言声一放，犹拾瀋也，过辞在前，悔其何追！」","text_layer":"witness_appended_pei_songzhi_note","annotation_status":"reviewed","mentions":[{"id":"c-sanguozhi-052-zhangzhao-complete:line012-pei01-02:m0000","start":0,"end":1,"surface":"昭","kind":"person","person_id":"roi_rz4_ute","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhangzhao-complete:line012-pei01-02:m0259","start":259,"end":261,"surface":"邾子","kind":"person","person_id":"ka0_mig_exb","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhangzhao-complete:line012-pei01-02:m0264","start":264,"end":266,"surface":"季友","kind":"person","person_id":"lc6_cup_v9c_ABA","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhangzhao-complete:line012-pei01-02:m0297","start":297,"end":300,"surface":"周穆王","kind":"person","person_id":"sx2_wyn_nhr","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhangzhao-complete:line012-pei01-02:m0301","start":301,"end":302,"surface":"满","kind":"person","person_id":"sx2_wyn_nhr","status":"contextual_provisional","interpretation_note":"讀本段前後及對話，所指按此處記。"},{"id":"c-sanguozhi-052-zhangzhao-complete:line012-pei01-02:m0304","start":304,"end":306,"surface":"定王","kind":"person","person_id":"3hy_4xq_wqu","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhangzhao-complete:line012-pei01-02:m0308","start":308,"end":311,"surface":"王孙满","kind":"person","person_id":"fie_vij_hw2","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhangzhao-complete:line012-pei01-02:m0325","start":325,"end":327,"surface":"厉王","kind":"person","person_id":"jps_m3k_hu4","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhangzhao-complete:line012-pei01-02:m0328","start":328,"end":329,"surface":"胡","kind":"person","person_id":"jps_m3k_hu4","status":"contextual_provisional","interpretation_note":"讀本段前後及對話，所指按此處記。"},{"id":"c-sanguozhi-052-zhangzhao-complete:line012-pei01-02:m0331","start":331