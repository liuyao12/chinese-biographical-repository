,"start":42,"end":44,"surface":"定王","kind":"person","person_id":"3hy_4xq_wqu","status":"source_identified"}],"chapter_id":"c-shiji-004-zhou","book_id":"b-shiji-004","work_id":"w-shiji","source_id":"s-shiji-004-zhou"},{"id":"c-shiji-004-zhou:p056","text":"定王元年，楚莊王伐陸渾之戎，次洛，使人問九鼎。王使王孫滿應設以辭，楚兵乃去。十年，楚莊王圍鄭，鄭伯降，已而復之。十六年，楚莊王卒。","annotation_status":"in_progress","mentions":[{"id":"c-shiji-004-zhou:m056-0000","start":0,"end":2,"surface":"定王","kind":"person","person_id":"3hy_4xq_wqu","status":"source_identified"},{"id":"c-shiji-004-zhou:m056-0005","start":5,"end":8,"surface":"楚莊王","kind":"person","person_id":"q8m_d0c_kq3","status":"source_identified"},{"id":"c-shiji-004-zhou:m056-0025","start":25,"end":28,"surface":"王孫滿","kind":"person","person_id":"fie_vij_hw2","status":"source_identified"},{"id":"c-shiji-004-zhou:m056-0041","start":41,"end":44,"surface":"楚莊王","kind":"person","person_id":"q8m_d0c_kq3","status":"source_identified"},{"id":"c-shiji-004-zhou:m056-0047","start":47,"end":49,"surface":"鄭伯","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官號或文字疑讀；保留錨點，不補熟知姓名或假定同指。"},{"id":"c-shiji-004-zhou:m056-0060","start":60,"end":63,"surface":"楚莊王","kind":"person","person_id":"q8m_d0c_kq3","status":"source_identified"}],"chapter_id":"c-shiji-004-zhou","book_id":"b-shiji-004","work_id":"w-shiji","source_id":"s-shiji-004-zhou"},{"id":"c-shiji-004-zhou:p057","text":"二十一年，定王崩，子簡王夷立。簡王十三年，晉殺其君厲公，迎子周於周，立為悼公。","annotation_status":"in_progress","mentions":[{"id":"c-shiji-004-zhou:m057-0005","start":5,"end":7,"surface":"定王","kind":"person","person_id":"3hy_4xq_wqu","status":"source_identified"},{"id":"c-shiji-004-zhou:m057-0010","start":10,"end":13,"surface":"簡王夷","kind":"person","person_id":"s4y_bc6_4ay","status":"source_identified"},{"id":"c-shiji-004-zhou:m057-0015","start":15,"end":17,"surface":"簡王","kind":"person","person_id":"s4y_bc6_4ay","status":"source_identified"},{"id":"c-shiji-004-zhou:m057-0025","start":25,"end":27,"surface":"厲公","kind":"person","pers