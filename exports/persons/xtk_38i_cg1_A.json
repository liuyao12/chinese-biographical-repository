k_id":"b-nanshi-057","chapter_id":"c-nanshi-057-shentianzi-zhao-family","source_id":"s-nanshi-057-shentianzi-zhao-family-ws1484916","paragraph_id":"c-nanshi-057-shentianzi-zhao-family:p001","quote":"唯穆夫子深子、雲子、田子、林子、虔子獲全。","subject_person_mention_id":"c-nanshi-057-shentianzi-zhao-family:p001:m0010","object_person_mention_id":"c-nanshi-057-shentianzi-zhao-family:p001:m0001"}],"status":"source_attested","interpretation_note":"穆夫五子中列田子，據同卷字敬光及扶風太守對讀。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"title_holdings":[{"id":"th-songshu-046-zhaolunzhi-complete-1-69","title":"扶風太守","kind":"office","mode":"attestation","person_id":"xtk_38i_cg1_A","attestations":[{"id":"th-songshu-046-zhaolunzhi-complete-1-69:a","paragraph_id":"c-songshu-046-zhaolunzhi-complete:p001","start":69,"end":73,"surface":"扶風太守","person_mention_id":"c-songshu-046-zhaolunzhi-complete:p001:m0073","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-046","chapter_id":"c-songshu-046-zhaolunzhi-complete","source_id":"s-songshu-046-zhaolunzhi-complete-ws2118581","paragraph_id":"c-songshu-046-zhaolunzhi-complete:p001","quote":"趙倫之字幼成，下邳僮人也。孝穆皇后之弟。幼孤貧，事母以孝稱。武帝起兵，以軍功封閬中縣五等侯，累遷雍州刺史。武帝北伐，倫之遣順陽太守傅弘之、扶風太守沈田子出嶢柳，大破姚泓於藍田。及武帝受命，以佐命功，封霄城縣侯，安北將軍，鎮襄陽。少帝即位，徵拜護軍。元嘉三年，拜鎮軍將軍，尋遷左光祿大夫，領軍將軍。","person_mention_id":"c-songshu-046-zhaolunzhi-complete:p001:m0073"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"th-songshu-048-fuhongzhi-4-8","title":"扶風太守","kind":"office","mode":"attestation","person_id":"xtk_38i_cg1_A","attestations":[{"id":"th-songshu-048-fuhongzhi-4-8:a","paragraph_id":"c-songshu-048-fuhongzhi:p004","start":8,"end":12,"surface":"扶風太守","person_mention_id":"c-songshu-048-fuhongzhi:p004:m0012","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-048","chapter_id":"c-songshu-048-fuhongzhi","source_id":"s-songshu-048-fuhongzhi-ws1791560","paragraph_id":"c-songshu-048-fuhongzhi:p004","quote":"高祖北伐，弘之與扶風太守沈田子等七軍自武關入，偽上洛太守脫身奔走，進據藍田，招懷戎、晉。晉人龐斌之、戴養、胡人康橫等各率部落歸化。弘之素善騎乘，高祖至長安，弘之於姚泓馳道內，緩服戲馬，或馳或驟，往反二十里中，甚有姿制，羌胡聚觀者數千人，並驚惋歎息。初上馬，以馬鞭柄策，挽致兩股內，及下馬，柄孔猶存。","person_mention_id":"c-songshu-048-fuhongzhi:p004:m0012"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanshi-057-shentianzi-zhao-family:p001","text":"唯穆夫子深子、雲子、田子、林子、虔子獲全。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":20,"last_line":20,"raw_start":1362,"raw_end":1383,"raw_character_offsets":[1362,1363,1364,1365,1366,1367,1368,1369,1370,1371,1372,1373,1374,1375,1376,1377,1378,1379,1380,1381,1382],"revision_id":1484916},"mentions":[{"id":"c-nanshi-057-shentianzi-zhao-family:p001:m0001","start":1,"end":3,"surface":"穆夫","kind":"person","person_id":"xtk_38i_cg1","status":"contextual_provisional"},{"id":"c-nanshi-057-shentianzi-zhao-family:p001:m0010","start":10,"end":12,"surface":"田子","kind":"person","person_id":"xtk_38i_cg1_A","status":"contextual_provisional"},{"id":"c-nanshi-057-shentianzi-zhao-family:p001:m0013","start":13,"end":15,"surface":"林子","kind":"person","person_id":"r3p_0a4_n85","status":"contextual_provisional"}],"chapter_id":"c-nanshi-057-shentianzi-zhao-family","book_id":"b-nanshi-057","work_id":"w-nanshi","source_id":"s-nanshi-057-shentianzi-zhao-family-ws1484916"},{"id":"c-songshu-046-zhaolunzhi-complete:p001","text":"趙倫之字幼成，下邳僮人也。孝穆皇后之弟。幼孤貧，事母以孝稱。武帝起兵，以軍功封閬中縣五等侯，累遷雍州刺史。武帝北伐，倫之遣順陽太守傅弘之、扶風太守沈田子出嶢柳，大破姚泓於藍田。及武帝受命，以佐命功，封霄城縣侯，安北將軍，鎮襄陽。少帝即位，徵拜護軍。元嘉三年，拜鎮軍將軍，尋遷左光祿大夫，領軍將軍。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":11,"last_line":11,"raw_start":300,"raw_end":514,"raw_character_offsets":[300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,318,319,386,387,388,389,390,391,392,393,394,395,396,397,398,399,400,401,402,403,404,405,406,407,408,409,410,411,412,413,414,415,416,417,418,419,420,421,422,423,424,425,426,427,428,429,430,431,432,433,434,435,436,437,438,439,440,441,442,443,444,445,446,447,448,449,450,451,452,453,454,455,456,457,458,459,460,461,462,463,464,465,466,467,468,469,470,471,472,473,474,475,476,477,478,479,480,481,482,483,484,485,486,487,488,489,490,491,492,493,494,495,496,497,498,499,500,501,502,503,504,505,506,507,508,509,510,511,512,513],"revision_id":2118581},"mentions":[{"id":"c-songshu-046-zhaolunzhi-complete:p001:m0000","start":0,"end":3,"surface":"趙倫之","kind":"person","person_id":"r5n_x7v_cwf_AC","status":"contextual_provisional"},{"id":"c-songshu-046-zhaolunzhi-complete:p001:m0004","start":4,"end":6,"surface":"幼成","kind":"person","person_id":"r5n_x7v_cwf_AC","status":"contextual_provisional"},{"id":"c-songshu-046-zhaolunzhi-complete:p001:m0058","start":58,"end":60,"surface":"倫之","kind":"person","person_id":"r5n_x7v_cwf_AC","status":"contextual_provisional"},{"id":"c-songshu-046-zhaolunzhi-complete:p001:m0065","start":65,"end":68,"surface":"傅弘之","kind":"person","person_id":"258_ae3_26e_AAA","status":"contextual_provisional"},{"id":"c-songshu-046-zhaolunzhi-complete:p001:m0073","start":73,"end":76,"surface":"沈田子","kind":"person","person_id":"xtk_38i_cg1_A","status":"contextual_provisional"},{"id":"c-songshu-046-zhaolunzhi-complete:p001:m0082","start":82,"end":84,"surface":"姚泓","kind":"person","person_id":"a6e_1b1_44e","status":"contextual_provisional"}],"chapter_id":"c-songshu-046-zhao