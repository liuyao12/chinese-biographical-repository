"},{"id":"c-jinshu-061-gouxi:p008:m0020","surface":"石世龍","start":20,"end":23,"person_id":"0c9_95a_18b","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p008:m0079","surface":"晞","start":79,"end":80,"person_id":"v5s_1ew_vh0","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p008:m0141","surface":"丁嶷","start":141,"end":143,"person_id":"y6u_wtb_9k6","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p008:m0146","surface":"李惲","start":146,"end":148,"person_id":"2fc_57a_e44","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p008:m0149","surface":"陳午","start":149,"end":151,"person_id":"dcs_ymm_847","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p008:m0175","surface":"裴整","start":175,"end":177,"person_id":"li4_5gz_fcs","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p008:m0212","surface":"晞","start":212,"end":213,"person_id":"v5s_1ew_vh0","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p008:m0302","surface":"晞","start":302,"end":303,"person_id":"v5s_1ew_vh0","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-061-gouxi","book_id":"b-jinshu-061","work_id":"w-jinshu","source_id":"s-jinshu-061-gouxi-ws7903772"},{"id":"c-jinshu-063-guomo:p001","text":"郭默，河內懷人。少微賤，以壯勇事太守裴整，為督將。永嘉之亂，默率遺眾自為塢主，以漁舟抄東歸行旅，積年遂致巨富，流人依附者漸眾。撫循將士，甚得其歡心。默婦兄同郡陸嘉取官米數石餉妹，默以為違制，將殺嘉，嘉懼，奔石勒。默乃自射殺婦，以明無私。遣使謁劉琨，琨加默河內太守。劉元海遣從子曜討默，曜列三屯圍之，欲使餓死。默送妻子為質，並請糴焉，糴畢，設守。曜怒，沈默妻子于河而攻之。默遣弟芝求救于劉琨，琨知默狡猾，留之而緩其救。默更遣人告急。會芝出城浴馬，使強與俱歸。默乃遣芝質于石勒，勒以默多詐，封默書與劉曜。默使人伺得勒書，便突圍投李矩。後與矩並力距劉、石，事見矩傳。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":71,"last_line":71,"raw_start":6200,"raw_end":6482,"raw_character_offsets":[6202,6203,6204,6205,6206,6207,6208,6209,6210,6211,6212,6213,6214,6215,6216,6217,6218,6219,6220,6221,6222,6223,6224,6225,6226,6227,6228,6229,6230,6231,6232,6233,6234,6235,