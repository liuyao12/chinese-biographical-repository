cheng-wuji/identity-decisions.json#xun"},{"id":"c-jinshu-037-qiao-cheng-wuji-ws2630018:p001:m0009","start":9,"end":11,"surface":"宣帝","kind":"person","person_id":"dkn_ge4_286_AAAA","status":"contextual_provisional","source_identity_role":"xuandi","identity_reading_ref":"source-evidence/jin037-qiao-cheng-wuji/identity-decisions.json#xuandi"},{"id":"c-jinshu-037-qiao-cheng-wuji-ws2630018:p001:m0015","start":15,"end":16,"surface":"進","kind":"person","person_id":"dkn_ge4_286_AAAF","status":"contextual_provisional","source_identity_role":"jin","identity_reading_ref":"source-evidence/jin037-qiao-cheng-wuji/identity-decisions.json#jin"},{"id":"c-jinshu-037-qiao-cheng-wuji-ws2630018:p001:m0060","start":60,"end":62,"surface":"武帝","kind":"person","person_id":"dkn_ge4_286_AAAAIA","status":"contextual_provisional","source_identity_role":"wudi","identity_reading_ref":"source-evidence/jin037-qiao-cheng-wuji/identity-decisions.json#wudi"},{"id":"c-jinshu-037-qiao-cheng-wuji-ws2630018:p001:m0085","start":85,"end":86,"surface":"隨","kind":"person","person_id":"dkn_ge4_286_AAAFAA","status":"contextual_provisional","source_identity_role":"sui","identity_reading_ref":"source-evidence/jin037-qiao-cheng-wuji/identity-decisions.json#sui"},{"id":"c-jinshu-037-qiao-cheng-wuji-ws2630018:p001:m0087","start":87,"end":88,"surface":"承","kind":"person","person_id":"dkn_ge4_286_AAAFAB","status":"contextual_provisional","source_identity_role":"cheng","identity_reading_ref":"source-evidence/jin037-qiao-cheng-wuji/identity-decisions.json#cheng"},{"id":"c-jinshu-037-qiao-cheng-wuji-ws2630018:p001:m0089","start":89,"end":92,"surface":"定王隨","kind":"person","person_id":"dkn_ge4_286_AAAFAA","status":"contextual_provisional","source_identity_role":"sui","identity_reading_ref":"source-evidence/jin037-qiao-cheng-wuji/identity-decisions.json#sui"},{"id":"c-jinshu-037-qiao-cheng-wuji-ws2630018:p001:m0097","start":97,"end":98,"surface":"邃","kind":"person","person_id":"dkn_ge4_286_AAAFAAA","status":"contextual_provisional","source_identity_role":"sui2","identity_reading_ref":"source-evidence/jin037-qiao-cheng-wuji/identity-decisions.json#sui2"},{"id":"c-jinshu-037-qiao-cheng-wuji-ws2630018:p001:m0102","start":102,"end":104,"surface":"石勒","kind":"person","person_id":"0c9_95a_18b","status":"contextual_provisional","source_identity_role":"shile","identity_reading_ref":"source-evidence/jin037-qiao-cheng-wuji/identity-decisions.json#shile"},{"id":"c-jinshu-037-qiao-cheng-wuji-ws2630018:p001:m0105","start":105,"end":107,"surface":"元帝","kind":"person","person_id":"dkn_ge4_286_AAAAAAA","status":"contextual_provisional","source_identity_role":"yuandi","identity_reading_ref":"source-evidence/jin037-qiao-cheng-wuji/identity-decisions.json#yuandi"},{"id":"c-jinshu-037-qiao-cheng-wuji-ws2630018:p001:m0108","start":108,"end":109,"surface":"承","kind":"person","person_id":"dkn_ge4_286_AAAFAB","status":"contextual_provisional","source_identity_role":"cheng","identity_reading_ref":"source-evidence/jin037-qiao-cheng-wuji/identity-decisions.json#cheng"},{"id":"c-jinshu-037-qiao-cheng-wuji-ws2630018:p001:m0110","start":110,"end":111,"surface":"遜","kind":"person","person_id":"dkn_ge4_286_AAAFA","status":"contextual_provisional","source_identity_role":"xun","identity_reading_ref":"source-evidence/jin037-qiao-cheng-wuji/identity-decisions.json#xun"}],"chapter_id":"c-jinshu-037-qiao-cheng-wuji-ws2630018","book_id":"b-jinshu-037","work_id":"w-jinshu","source_id":"s-jinshu037-qiao-cheng-wuji-ws2630018"}],"sources":[{"chapter_id":"c-jinshu-037-phase5-pengcheng","work_id":"w-jinshu","book_id":"b-jinshu-037","source_id":"s-jinshu-037-phase5","source":{"title":"彭城穆王權及植、釋、雄、紘完整段","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7037&oldid=2630018","permalink":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7037&oldid=2630018","revision_id":2630018,"accessed_on":"2026-10-19","extent":"固定修訂完整一段；非全卷或完整列傳。 另收孚傳首完整段；未稱全傳。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文與維基文庫數位轉錄；保留歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，未核底本影像","wikitext_sha256":"557274fb21e7041782d93622e5fc32d67cf56ed38d6f5a3994e238b60b9638d6","response_sha256":"4243cada96dbf78f0732f8facb678ff8a24a639f87d18592edd7b4ae2c9e2453","normalization":{"character_conversion":{},"extraction_note":"僅移除段首縮排，不改正文異體、疑字或標點。","excerpts":[{"proposed_paragraph_id":"c-jinshu-037-phase5-pengcheng:phase6-line014","source_lines":[14,15],"raw_quote":"安平獻王孚，字叔達，宣帝次弟也。初，孚長兄朗字伯達，[[晉書/卷001|宣帝]]字仲達，孚弟馗字季達，恂字顯達，進字惠達，通字雅達，敏字幼達，俱知名，故時號為'''「八達」'''焉。孚溫厚廉讓，博涉經史。漢末喪亂，與兄弟處危亡之中，簞食瓢飲，而披閱不倦。性通恕，以貞白自立，未嘗有怨於人。陳留殷武有名於海內，嘗罹罪譴，孚往省之，遂與同處分食，談者稱焉。","raw_quote_sha256":"500c8ffe1ea2d99d15e16fddd2d6bc548efa5f1f02ffbfb5553ff153e32c618a","selected_text_sha256":"9614a72ca513f185c40464b625e888c4104f110cb1c51cfc67ac65a49fd8adbd","begin_anchor":"安平獻王孚，字叔達，宣帝次弟也。","end_anchor":"往省之，遂與同處分食，談者稱焉。"},{"source_lines":[100,100],"raw_quote":"彭城穆王權，字子輿，宣帝弟魏魯相東武城侯馗之子也。初襲封，拜冗從僕射。武帝受禪，封彭城王，邑二千九百戶。出為北中郎將、都督鄴城守諸軍事。泰始中入朝，賜袞冕之服。咸甯元年薨，子元王植立。歷位後將軍，尋拜國子祭酒、太僕卿、侍中、尚書。出為安東將軍、都督揚州諸軍事，代淮南王允鎮壽春，未發。或云植助允攻趙王倫，遂以憂薨。贈車騎將軍，增封萬五千戶。子康王釋立，官至南中郎將、持節、平南將軍，分魯國蕃、薛二縣以益其國，心二萬三千戶。薨，子雄立，坐奔蘇峻伏誅，更以釋子紘嗣。","raw_sha256":"478e3f93771c1ff000c00bd9ae03e56bd01e67dabd16ed7471e8937194ff10a4"}]}}},{"chapter_id":"c-jinshu-037-qiao-cheng-wuji-ws2630018","work_id":"w-jinshu","book_id":"b-jinshu-037","source_id":"s-jinshu037-qiao-cheng-wuji-ws2630018","source":{"title":"晉書·卷三十七","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=晉書/卷037&oldid=2630018","revision_id":2630018,"edition":"既存固定數位文字；實際印本未知","extent":"5完整選段：譙遜近系開篇、承傳首及末、無忌完整本人2段；承傳中間省略另存reference，不冒全傳或全卷。","text_scope":"partial_chapter","image_verified":false,"review_status":"text_checked","permalink":"https://zh.wikisource.org/w/index.php?title=晉書/卷037&oldid=2630018","license_url":"https://creativecommons.org/licenses/by-sa/4.0/"}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true},"assembled_identity":{"person_id":"dkn_ge4_286_AAAF","representative_source_person_id":"dkn_ge4_286_AAAF","source_person_ids":["dkn_ge4_286_AAAF"],"identity_equivalence_decision_ids":[],"parent_person_id":"dkn_ge4_286_AAA","source_assertion_id":null,"connection":"father","parent_connection":{"type":"shared_father_through_sibling_chain","sibling_person_ids":["dkn_ge4_286_AAAC","dkn_ge4_286_AAAA"],"sibling_assertion_ids":["a-phase6-kuai-37-進-brother-孚","a-phase6-kuai-37-孚-brother-懿"],"sibling_father_assertion_id":"a-jinshu001-near-father-4","status":"contextual_provisional","human_reviewed":false,"rationale":"037八達完整兄弟名單、001懿父防、015裴注引序傳防有八子且首二子朗/懿交互限定，暫採同父。這是可撤回跨篇推論，不稱本句明載每人父防；若有異父／嗣父材料重覆核。","references":[{"work_id":"w-jinshu","book_id":"b-jinshu-037","source_id":"s-jinshu-037-phase5","chapter_id":"c-jinshu-037-phase5-pengcheng","paragraph_id":"c-jinshu-037-phase5-pengcheng:phase6-line014","quote":"安平獻王孚，字叔達，宣帝次弟也。初，孚長兄朗字伯達，宣帝字仲達，孚弟馗字季達，恂字顯達，進字惠達，通字雅達，敏字幼達，俱知名，故時號為「八達」焉。孚溫厚廉讓，博涉經史。漢末喪亂，與兄弟處危亡之中，簞食瓢飲，而披閱不倦。性通恕，以貞白自立，未嘗有怨於人。陳留殷武有名於海內，嘗罹罪譴，孚往省之，遂與同處分食，談者稱焉。","subject_person_mention_id":"c-jinshu-037-phase5-pengcheng:phase6-line014:m0044","object_person_mention_id":"c-jinshu-037-phase5-pengcheng:phase6-line014:m0000","assertion_id":"a-phase6-kuai-37-進-brother-孚","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7037&oldid=2630018","scope":"孚弟具名名單"},{"work_id":"w-jinshu","book_id":"b-jinshu-037","source_id":"s-jinshu-037-phase5","chapter_id":"c-jinshu-037-phase5-pengcheng","paragraph_id":"c-jinshu-037-phase5-pengcheng:phase6-line014","quote":"安平獻王孚，字叔達，宣帝次弟也。初，孚長兄朗字伯達，宣帝字仲達，孚弟馗字季達，恂字顯達，進字惠達，通字雅達，敏字幼達，俱知名，故時號為「八達」焉。孚溫厚廉讓，博涉經史。漢末喪亂，與兄弟處危亡之中，簞食瓢飲，而披閱不倦。性通恕，以貞白自立，未嘗有怨於人。陳留殷武有名於海內，嘗罹罪譴，孚往省之，遂與同處分食，談者稱焉。","subject_person_mention_id":"c-jinshu-037-phase5-pengcheng:phase6-line014:m0000","object_person_mention_id":"c-jinshu-037-phase5-pengcheng:phase6-line014:m0010","assertion_id":"a-phase6-kuai-37-孚-brother-懿","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7037&oldid=2630018","scope":"孚為宣帝次弟"},{"work_id":"w-jinshu","book_id":"b-jinshu-001","chapter_id":"c-jinshu-001-sima-near-ancestry","source_id":"s-jinshu-001-sima-near-ancestry","paragraph_id":"c-jinshu-001-sima-near-ancestry:p001","quote":"宣皇帝諱懿，字仲達，河內溫縣孝敬里人，姓司馬氏。其先出自帝高陽之子重黎，為夏官祝融。歷唐、虞、夏、商，世序其職。及周，以夏官為司馬。其後程伯休父，周宣王時，以世官克平徐方，錫以官族，因而為氏。楚漢間，司馬卬為趙將，與諸侯伐秦。秦亡，立為殷王，都河內。漢以其地為郡，子孫遂家焉。自卬八世，生征西將軍鈞，字叔平。鈞生豫章太守量，字公度。量生潁川太守儁，字元異。儁生京兆尹防，字建公。帝即防之第二子也。少有奇節，聰朗多大略，博學洽聞，伏膺儒教。漢末大亂，常慨然有憂天下心。南陽太守同郡楊俊名知人，見帝，未弱冠，以為非常之器。尚書清河崔琰與帝兄朗善，亦謂朗曰：「君弟聰亮明允，剛斷英特，非子所及也。」","subject_person_mention_id":"c-jinshu-001-sima-near-ancestry:p001:m0000","object_person_mention_id":"c-jinshu-001-sima-near-ancestry:p001:m0183","assertion_id":"a-jinshu001-near-father-4","url":"https://zh.wikisource.org/w/index.php?oldid=2603565","scope":"懿父防為單句明文"},{"url":"https://zh.wikisource.org/w/index.php?title=%E4%B8%89%E5%9C%8B%E5%BF%97%2F%E5%8D%B715&oldid=2085075","quote":"司馬彪序傳曰：朗祖父雋，字元異，博學好古，倜儻有大度。長八尺三寸，腰帶十圍，儀狀魁岸，與眾有異，鄉黨宗族咸景附焉。位至穎川太守。父防，字建公，性質直公方，雖閑居宴處，威儀不忒。雅好《漢書名臣列傳》，所諷誦者數十萬言。少仕州郡，歷官洛陽令、京兆尹，以年老轉拜騎都尉。養志閭巷，闔門自守。諸子雖冠成人，不命曰進不敢進，不命曰坐不敢坐，不指有所問不敢言，父子之間肅如也。年七十一，建安二十四年終。有子八人，朗最長，次即晉宣皇帝也。","scope":"裴注引司馬彪序傳，防有子八人、朗最長、次晉宣皇帝；完整古注層。","chapter_id":"c-sanguozhi-015-pei-simabiao-xuzhuan","paragraph_id":"c-sanguozhi-015-pei-simabiao-xuzhuan:line023-pei-note","source_id":"s-sanguozhi-015-pei-simabiao-xuzhuan"}]},"assembly_id":"family-sima-jun-near-ancestry","root_person_id":"dkn_ge4_286","status":"contextual_provisional","human_reviewed":false}}
