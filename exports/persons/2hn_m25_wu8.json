es":[{"id":"c-jinshu-069-liuwei:kinship5-321","kind":"kinship","person_id":"2hn_m25_wu8","source_quote":"孫波嗣","reading":"所嗣劉隗。先書綏卒，正文未以波明稱綏子。","note":"所嗣劉隗。先書綏卒，正文未以波明稱綏子。","paragraph_id":"c-jinshu-069-liuwei:p005","start_codepoint":321,"end_codepoint":324,"human_reviewed":false,"chapter_id":"c-jinshu-069-liuwei","source_id":"s-jinshu-069-liuwei-ws2012453"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin069-liubo-grandfather","subject_person_id":"2hn_m25_wu8","object_person_id":"hnd_3at_h4i","predicate":"grandfather","qualifiers":{"source_term":"孫波嗣"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-069","chapter_id":"c-jinshu-069-liuwei","source_id":"s-jinshu-069-liuwei-ws2012453","paragraph_id":"c-jinshu-069-liuwei:p005","quote":"初，隗以王敦威權太盛，終不可制，勸帝出腹心以鎮方隅，故以譙王承為湘州，續用隗及戴若思為都督。敦甚惡之，與隗書曰：「頃承聖上顧眄足下，今大賊未滅，中原鼎沸，欲與足下周生之徒戮力王室，共靜海內。若其泰也，則帝祚於是乎隆；若其否也，則天下永無望矣。」隗答曰：「魚相忘於江湖，人相忘於道術。竭股肱之力，效之以忠貞，吾之志也。」敦得書甚怒。及敦作亂，以討隗為名，詔征隗還京師，百官迎之於道，隗岸幘大言，意氣自若。及入見，與刁協奏請誅王氏。不從，有懼色，率眾屯金城。及敦克石頭，隗攻之不拔，入宮告辭，帝雪涕與之別。隗至淮陰，為劉遐所襲，攜妻子及親信二百餘人奔于石勒，勒以為從事中郎、太子太傅。卒年六十一。子綏，初舉秀才，除駙馬都尉、奉朝請。隨隗奔勒，卒。孫波嗣。","subject_person_mention_id":"c-jinshu-069-liuwei:p005:m0322","object_person_mention_id":"c-jinshu-069-liuwei:p005:m0002"}],"status":"source_attested","interpretation_note":"本傳末稱孫，劉波疏又自言亡祖隗；未明言其父為綏。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-069-liubo:p001:m0000","surface":"波","start":0,"end":1,"person_id":"2hn_m25_wu8","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-069-liubo:p001","chapter_id":"c-jinshu-069-liubo"},{"id":"c-jinshu-069-liubo:p002:m0013","surface":"波","start":13,"end":14,"person_id":"2hn_m25_wu8","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-069-liubo:p002","chapter_id":"c-jinshu-06