":6095,"raw_end":6151,"character_positions":[6097,6098,6099,6100,6101,6102,6103,6104,6105,6106,6107,6108,6109,6110,6111,6112,6113,6114,6115,6116,6117,6118,6119,6120,6121,6122,6123,6124,6125,6126,6127,6128,6129,6130,6131,6132,6133,6134,6135,6136,6137,6138,6139,6140,6141,6142,6143,6144,6145,6146,6147,6148,6149,6150]},"mentions":[{"id":"c-jinshu-074-huan-family:p027:m0002","start":2,"end":4,"surface":"苻堅","kind":"person","person_id":"1bd_b18_3c0","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。"},{"id":"c-jinshu-074-huan-family:p027:m0008","start":8,"end":9,"surface":"沖","kind":"person","person_id":"u9s_w6j_8mc_AE","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。"},{"id":"c-jinshu-074-huan-family:p027:m0014","start":14,"end":16,"surface":"朱序","kind":"person","person_id":"qad_k9o_71k","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。"},{"id":"c-jinshu-074-huan-family:p027:m0021","start":21,"end":23,"surface":"桓伊","kind":"person","person_id":"655_49c_8b1","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。"},{"id":"c-jinshu-074-huan-family:p027:m0033","start":33,"end":35,"surface":"劉波","kind":"person","person_id":"2hn_m25_wu8","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。"}],"chapter_id":"c-jinshu-074-huan-family","book_id":"b-jinshu-074","work_id":"w-jinshu","source_id":"s-jinshu-074-ws1536331"},{"id":"c-jinshu-074-huan-family:p031","text":"沖既到江陵，時苻堅強盛，沖欲移阻江南，乃上疏曰：「自中興以來，荊州所鎮，隨宜回轉。臣亡兄溫以石季龍死，經略中原，因江陵路便，即而鎮之。事與時遷，勢無常定。且兵者詭道，示之以弱，今宜全重江南，輕戍江北。南平孱陵縣界，地名上明，田土膏良，可以資業軍人。在吳時樂鄉城以上四十餘里，北枕大江，西接三峽。若狂狡送死，則舊郢以北堅壁不戰，接會濟江，路不云遠，乘其疲墮，撲翦為易。臣司存閫外，輒隨宜處分。」於是移鎮上明，使冠軍將軍劉波守江陵，諮議參軍楊亮守江夏。詔以荊州水旱饑荒，又沖新移草創，歲運米三十萬斛以供軍資，須年豐乃止。","source_position":{"kind":"wikitext_codepoint_positions","raw_path":"sources/jinshu/wikisource-1536331-raw.wikitext","raw_start":6776,"raw_end":7049,"character_positions":[6778,6779,6780,6781,6782,6783,