{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"8a8_f4u_it7","canonical_person_id":"8a8_f4u_it7","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["8a8_f4u_it7"],"persons":[{"id":"8a8_f4u_it7","label":"吳廣（平津侯主父列傳上書候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"吳廣","mention_ids":["c-shiji-112-pingjin:m019-0342"]}],"evidence":[{"mention_id":"c-shiji-112-pingjin:m019-0342","chapter_id":"c-shiji-112-pingjin","paragraph_id":"c-shiji-112-pingjin:p019","quote":"吳廣"}]}],"source_mention_summary":[{"source_id":"s-shiji112-pingjin","work_id":"w-shiji","book_id":"b-shiji-112","chapter_id":"c-shiji-112-pingjin","mention_count":1,"mention_ids":["c-shiji-112-pingjin:m019-0342"],"paragraph_ids":["c-shiji-112-pingjin:p019"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji112-pingjin"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-112-pingjin:m019-0342","start":342,"end":344,"surface":"吳廣","kind":"person","person_id":"8a8_f4u_it7","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p019","chapter_id":"c-shiji-112-pingjin"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-112-pingjin:p019","text":"及至秦王，蠶食天下，并吞戰國，稱號曰皇帝，主海內之政，壞諸侯之城，銷其兵，鑄以為鐘虡，示不復用。元元黎民得免於戰國，逢明天子，人人自以為更生。向使秦緩其刑罰，薄賦斂，省繇役，貴仁義，賤權利，上篤厚，下智巧，變風易俗，化於海內，則世世必安矣。秦不行是風而修其故俗，為智巧權利者進，篤厚忠信者退；法嚴政峻，諂諛者眾，日聞其美，意廣心軼。欲肆威海外，乃使蒙恬將兵以北攻胡，辟地進境，戍於北河，蜚芻芻粟以隨其后。又使尉[佗]屠睢將樓船之士南攻百越，使監祿鑿渠運糧，深入越，越人遁逃。曠日持久，糧食絕乏，越人擊之，秦兵大敗。秦乃使尉佗將卒以戍越。當是時，秦禍北構於胡，南掛於越，宿兵無用之地，進而不得退。行十餘年，丁男被甲，丁女轉輸，苦不聊生，自經於道樹，死者相望。及秦皇帝崩，天下大叛。陳勝、吳廣舉陳，武臣、張耳舉趙，項梁舉吳，田儋舉齊，景駒舉郢，周市舉魏，韓廣舉燕，窮山通谷豪士并起，不可勝載也。然皆非公侯之后，非長官之吏也。無尺寸之勢，起閭巷，杖棘矜，應時而皆動，不謀而俱起，不約而同會，壤長地進，至于霸王，時教使然也。秦貴為天子，富有天下，滅世絕祀者，窮兵之禍也。故周失之弱，秦失之彊，不變之患也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-112-pingjin:m019-0002","start":2,"end":4,"surface":"秦王","kind":"person","person_id":"ao3_0fy_d45_AAA","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m019-0059","start":59,"end":62,"surface":"明天子","kind":"person","person_id":"ao3_0fy_d45_AAA","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m019-0174","start":174,"end":176,"surface":"蒙恬","kind":"person","person_id":"k2p_5ol_dwh_AA","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m019-0204","start":204,"end":208,"surface":"尉[佗]","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-112-pingjin:m019-0208","start":208,"end":210,"surface":"屠睢","kind":"person","person_id":"5ep_xih_trk","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m019-0221","start":221,"end":223,"surface":"監祿","kind":"person","person_id":"a1r_v0c_ghw","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m019-0260","start":260,"end":262,"surface":"尉佗","kind":"person","person_id":"qig_axh_3z6","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m019-0329","start":329,"end":332,"surface":"秦皇帝","kind":"person","person_id":"ao3_0fy_d45_AAA","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m019-0339","start":339,"end":341,"surface":"陳勝","kind":"person","person_id":"pom_ycp_ha5","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m019-0342","start":342,"end":344,"surface":"吳廣","kind":"person","person_id":"8a8_f4u_it7","status":"contextual_provi