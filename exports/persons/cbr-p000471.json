{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000471","canonical_person_id":"xsl_5ma_w95","id_aliases":["cbr-p000471"],"identity_policy":"contextual_provisional","person_ids":["xsl_5ma_w95"],"persons":[{"id":"xsl_5ma_w95","label":"韓太子蒼","status":"active","historicity":"historical_tradition","aliases":[{"surface":"韓太子蒼","mention_ids":["c-shiji-005-qin:m066-0139"]}],"evidence":[{"mention_id":"c-shiji-005-qin:m066-0139","chapter_id":"c-shiji-005-qin","paragraph_id":"c-shiji-005-qin:p066","quote":"韓太子蒼"}],"identity_note":"依本卷特定時代與事件暫定人物；不以同稱、官號或短名全域合併，未見本名不補造。","review":"ai_provisional","id_aliases":["cbr-p000471"]}],"source_mention_summary":[{"source_id":"s-shiji-005-qin","work_id":"w-shiji","book_id":"b-shiji-005","chapter_id":"c-shiji-005-qin","mention_count":1,"mention_ids":["c-shiji-005-qin:m066-0139"],"paragraph_ids":["c-shiji-005-qin:p066"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-005-qin"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-005-qin:m066-0139","start":139,"end":143,"surface":"韓太子蒼","kind":"person","person_id":"xsl_5ma_w95","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p066","chapter_id":"c-shiji-005-qin"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-005-qin:p066","text":"十四年，更為元年。二年，張儀與齊、楚大臣會齧桑。三年，韓、魏太子來朝。張儀相魏。五年，王游至北河。七年，樂池相秦。韓、趙、魏、燕、齊帥匈奴共攻秦。秦使庶長疾與戰修魚，虜其將申差，敗趙公子渴、韓太子奐，斬首八萬二千。八年，張儀復相秦。九年，司馬錯伐蜀，滅之。伐取趙中都、西陽十年，韓太子蒼來質。伐取韓石章。伐敗趙將泥。伐取義渠二十五城。十一年，摢裏疾攻魏焦，降之。敗韓岸門，斬首萬，其將犀首走。公子通封於蜀。燕君讓其臣子之。十二年，王與梁王會臨晉。庶長疾攻趙，虜趙將莊。張儀相楚。十三年，庶長章擊楚於丹陽，虜其將屈丐，斬首八萬；又攻楚漢中，取地六百里，置漢中郡。楚圍雍氏，秦使庶長疾助韓而東攻齊，到滿助魏攻燕。十四年，伐楚，取召陵。丹、犁臣，蜀相壯殺蜀侯來降。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m066-0012","start":12,"end":14,"surface":"張儀","kind":"person","person_id":"uq6_74z_vtv","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0027","start":27,"end":32,"surface":"韓、魏太子","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、氏族、群體或未核指代；不補造個人或按熟知世系自動合併。"},{"id":"c-shiji-005-qin:m066-0035","start":35,"end":37,"surface":"張儀","kind":"person","person_id":"uq6_74z_vtv","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0052","start":52,"end":54,"surface":"樂池","kind":"person","person_id":"h40_rtd_6ut","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0075","start":75,"end":78,"surface":"庶長疾","kind":"person","person_id":"r9n_0vc_ywa","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0086","start":86,"end":88,"surface":"申差","kind":"person","person_id":"icp_nrn_7pl","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0090","start":90,"end":94,"surface":"趙公子渴","kind":"person","person_id":"gy6_lx6_eb2","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0095","start":95,"end":99,"surface":"韓太子奐","kind":"person","person_id":"ux0_nvd_s8f","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0110","start":110,"end":112,"surface":"張儀","kind":"person","person_id":"uq6_74z_vtv","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0119","start":119,"end":122,"surface":"司馬錯","kind":"person","person_id":"rec_qtq_9ve","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0139","start":139,"end":143,"surface":"韓太子蒼","kind":"person","person_id":"xsl_5ma_w95","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0154","start":154,"end":157,"surface"