ntime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-064-simadaozi:p011:m0061","surface":"孫泰","start":61,"end":63,"person_id":"zqm_qqw_e5j","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-064-simadaozi:p011","chapter_id":"c-jinshu-064-simadaozi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-064-simadaozi:p011","text":"既而楊佺期、桓玄、殷仲堪等復至石頭，元顯於竹裏馳還京師，遣丹陽尹王愷、鄱陽太守桓放之、新蔡內史何嗣、潁川太守溫詳、新安太守孫泰等，發京邑士庶數萬人，據石頭以距之。道子將出頓中堂，忽有驚馬蹂藉軍中，因而擾亂，赴江而死者甚眾。仲堪既知王恭敗死，狼狽西走，與桓玄屯于尋陽。朝廷嚴兵相距，內外騷然。詔元顯甲杖百人入殿，尋加散騎常侍、中書令，又領中領軍，持節、都督如故。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":133,"last_line":133,"raw_start":10393,"raw_end":10575,"raw_character_offsets":[10395,10396,10397,10398,10399,10400,10401,10402,10403,10404,10405,10406,10407,10408,10409,10410,10411,10412,10413,10414,10415,10416,10417,10418,10419,10420,10421,10422,10423,10424,10425,10426,10427,10428,10429,10430,10431,10432,10433,10434,10435,10436,10437,10438,10439,10440,10441,10442,10443,10444,10445,10446,10447,10448,10449,10450,10451,10452,10453,10454,10455,10456,10457,10458,10459,10460,10461,10462,10463,10464,10465,10466,10467,10468,10469,10470,10471,10472,10473,10474,10475,10476,10477,10478,10479,10480,10481,10482,10483,10484,10485,10486,10487,10488,10489,10490,10491,10492,10493,10494,10495,10496,10497,10498,10499,10500,10501,10502,10503,10504,10505,10506,10507,10508,10509,10510,10511,10512,10513,10514,10515,10516,10517,10518,10519,10520,10521,10522,10523,10524,10525,10526,10527,10528,10529,10530,10531,10532,10533,10534,10535,10536,10537,10538,10539,10540,10541,10542,10543,10544,10545,10546,10547,10548,10549,10550,10551,10552,10553,10554,10555,10556,10557,10558,10559,10560,10561,10562,10563,10564,10565,10566,10567,10568,10569,10570,10571,10572,