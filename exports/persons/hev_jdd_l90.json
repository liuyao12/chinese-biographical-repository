onflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-shiji110-mengtian","person_id":"hev_jdd_l90","event_type":"death","status":"source_attested","date_expression":"十餘年而蒙恬死","evidence":[{"chapter_id":"c-shiji-110-xiongnu","source_id":"s-shiji110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p005","quote":"十餘年而蒙恬死","person_mention_id":"c-shiji-110-xiongnu:m005-0034"}],"interpretation_note":"沿前段敘事的相對年數，起算點與精確年未定；不由本句補公元年、死亡方式或截斷官爵。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"mentions":[{"id":"c-shiji-110-xiongnu:m004-0378","start":378,"end":380,"surface":"蒙恬","kind":"person","person_id":"hev_jdd_l90","status":"contextual_provisional","paragraph_id":"c-shiji-110-xiongnu:p004","chapter_id":"c-shiji-110-xiongnu"},{"id":"c-shiji-110-xiongnu:m005-0034","start":34,"end":36,"surface":"蒙恬","kind":"person","person_id":"hev_jdd_l90","status":"contextual_provisional","paragraph_id":"c-shiji-110-xiongnu:p005","chapter_id":"c-shiji-110-xiongnu"},{"id":"c-shiji-110-xiongnu:m007-0390","start":390,"end":392,"surface":"蒙恬","kind":"person","person_id":"hev_jdd_l90","status":"contextual_provisional","paragraph_id":"c-shiji-110-xiongnu:p007","chapter_id":"c-shiji-110-xiongnu"},{"id":"c-shiji-110-xiongnu:m031-0307","start":307,"end":309,"surface":"蒙恬","kind":"person","person_id":"hev_jdd_l90","status":"contextual_provisional","paragraph_id":"c-shiji-110-xiongnu:p031","chapter_id":"c-shiji-110-xiongnu"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-110-xiongnu:p004","text":"自是之後百有餘年，晉悼公使魏絳和戎翟，戎翟朝晉。後百有餘年，趙襄子踰句注而破并代以臨胡貉。其後既與韓魏共滅智伯，分晉地而有之，則趙有代、句注之北，魏有河西、上郡，以與戎界邊。其後義渠之戎築城郭以自守，而秦稍蠶食，至於惠王，遂拔義渠二十五城。惠王擊魏，魏盡入西河及上郡于秦。秦昭王時，義渠戎王與宣太后亂，有二子。宣太后詐而殺義渠戎王於甘泉，遂起兵伐殘義渠。於是秦有隴西、北地、上郡，築長城以拒胡。而趙武靈王亦變俗胡服，習騎射，北破林胡、樓煩。築長城，自代并陰山下，至高闕爲塞。而置雲中、鴈門、代郡。其後燕有賢將秦開，爲質於胡，胡甚信之。歸而襲破走東胡，東胡卻千餘里。與荊軻刺秦王秦舞陽者，開之孫也。燕亦築長城，自造陽至襄平。置上谷、漁陽、右北平、遼西、遼東郡以拒胡。當是之時，冠帶戰國七，而三國邊於匈奴。其後趙將李牧時，匈奴不敢入趙邊。後秦滅六國，而始皇帝使蒙恬將十萬之眾北擊胡，悉收河南地。因河爲塞，築四十四縣城臨河，徙適戍以充之。而通直道，自九原至雲陽，因邊山險塹谿谷可繕者治之，起臨洮至遼東萬餘里。又度河據陽山北假中。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-110-xiongnu:m004-0009","start":9,"end":12,"surface":"晉悼公","kind":"person","person_id":"i45_w2y_9x9","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m004-0013","start":13,"end":15,"surface":"魏絳","kind":"person","person_id":"nit_fmb_fqz","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m004-0030","start":30,"end":33,"surface":"趙襄子","kind":"person","person_id":"n79_j93_xiu","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m004-0053","start":53,"end":55,"surface":"智伯","kind":"person","person_id":"dg5_xe0_sdd","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m004-0108","start":108,"end":110,"surface":"惠王","kind":"person","person_id":"lvl_qjo_kig","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m004-0120","start":120,"end":122,"surface":"惠王","kind":"person","person_id":"lvl_qjo_kig","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m004-0136","start":136,"end":139,"surface":"秦昭王","kind":"person","person_id":"8sb_2ue_1nf","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m004-0141","start":141,"end":145,"surface":"義渠戎王","kind":"person","person_id":"g9z_9e2_jex","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m004-0146","start":146,"end":149,"surface":"宣太后","kind":"person","person_id":"7w8_il9_9fv","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m004-0152","start":152,"end":154,"surface":"二子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-110-xiongnu:m004-0155","start":155,"end":158,"surface":"宣太后","kind":"person","person_id":"7w8_il9_9fv","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m004-0161","start":161,"end":165,"surface":"義渠戎王","kind":"person","person_id":"g9z_9e2_jex","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m004-0198","start":198,"end":202,"surface":"趙武靈王","kind":"person","person_id":"qah_j22_ega","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m004-0254","start":254,"end":256,"surface":"秦開","kind":"person","person_id":"505_n4y_p39","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m004-0283","start":283,"end":285,"surface":"荊軻","kind":"person","person_id":"2af_4tx_pil","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m004-0286","start":286,"end":288,"surface":"秦王","kind":"person","person_id":"gcj_0vc_72s","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m004-0288","start":288,"end":291,"surface":"秦舞陽","kind":"person","person_id":"505_n4y_p39_*A","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m004-0293","start":293,"end":294,"surface":"開","kind":"person","person_id":"505_n4y_p39","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m004-0355","start":355,"end":357,"surface":"李牧","kind":"person","person_id":"tdz_63e_0nm","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m004-0374","start":374,"end":377,"surface":"始皇帝","kind":"person","person_id":"jio_w3a_ic4","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m004-0378","start":378,"end":380,"surface":"蒙恬","kind":"person","person_id":"hev_jdd_l90","status":"contextual_provisional"}],"chapter_id":"c-shiji-110-xiongnu","book_id":"b-shiji-110","work_id":"w-shiji","source_id":"s-shiji110-xiongnu"},{"id":"c-shiji-110-xiongnu:p005","text":"當是之時，東胡彊而月氏盛。匈奴單于曰頭曼，頭曼不勝秦，北徙。十餘年而蒙恬死，諸侯畔秦，中國擾亂，諸秦所徙適戍邊者皆復去，於是匈奴得寬，復稍度河南與中國界於故塞。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-110-xiongnu:m005-0015","start":15,"end":17,"surface":"單于","kind":"person","person_id":"wjt_htu_081","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m005-0018","start":18,"end":20,"surface":"頭曼","kind":"person","person_id":"wjt_htu_081","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m005-0021","start":21,"end":23,"surface":"頭曼","kind":"person","person_id":"wjt_htu_081","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m005-0034","start":34,"end":36,"surface":"蒙恬","kind":"person","person_id":"hev_jdd_l90","status":"contextual_provisional"}],"chapter_id":"c-shiji-110-xiongnu","book_id":"b-shiji-110","work_id":"w-shiji","source_id":"s-shiji110-xiongnu"},{"id":"c-shiji-110-xiongnu:p007","text":"冒頓既立，是時東胡彊盛，聞冒頓殺父自立，乃使使謂冒頓，欲得頭曼時有千里馬。冒頓問群臣，群臣皆曰：「千里馬，匈奴寶馬也，勿與。」冒頓曰：「柰何與人鄰國而愛一馬乎？」遂與之千里馬。居頃之，東胡以爲冒頓畏之，乃使使謂冒頓，欲得單于一閼氏。冒頓復問左右，左右皆怒曰：「東胡無道，乃求閼氏！請擊之。」冒頓曰：「柰何與人鄰國愛一女子乎？」遂取所愛閼氏予東胡。東胡王愈益驕，西侵。與匈奴閒，中有棄地，莫居，千餘里，各居其邊爲甌脫。東胡使使謂冒頓曰：「匈奴所與我界甌脫外棄地，匈奴非能至也，吾欲有之。」冒頓問群臣，群臣或曰：「此棄地，予之亦可，勿予亦可。」於是冒頓大怒曰：「地者，國之本也，柰何予之！」諸言予之者，皆斬之。冒頓上馬，令國中有後者斬，遂東襲擊東胡。東胡初輕冒頓，不爲備。及冒頓以兵至，擊，大破滅東胡王，而虜其民人及畜產。既歸，西擊走月氏，南并樓煩、白羊河南王。［侵燕代］悉復收秦所使蒙恬所奪匈奴地者，與漢關故河南塞，至朝那、膚施，遂侵燕、代。是時漢兵與項羽相距，中國罷於兵革，以故冒頓得自彊，控弦之士三十餘萬。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-110-xiongnu:m007-0000","start":0,"end":2,"surface":"冒頓","kind":"person","person_id":"wjt_htu_081_A","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m007-0013","start":13,"end":15,"surface":"冒頓","kind":"person","person_id":"wjt_htu_081_A","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m007-0024","start":24,"end":26,"surface":"冒頓","kind":"person","person_id":"wjt_htu_081_A","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m007-0029","start":29,"end":31,"surface":"頭曼","kind":"person","person_id":"wjt_htu_081","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m007-0037","start":37,"end":39,"surface":"冒頓","kind":"person","person_id":"wjt_htu_081_A","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m007-0063","start":63,"end":65,"surface":"冒頓","kind":"person","person_id":"wjt_htu_081_A","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m00