ayer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":35,"last_line":35,"raw_start":3033,"raw_end":3945,"raw_character_offsets":[3045,3046,3047,3048,3056,3057,3058,3059,3060,3061,3062,3063,3064,3065,3072,3073,3074,3075,3076,3077,3078,3079,3080,3081,3082,3083,3084,3085,3086,3087,3088,3089,3090,3091,3092,3093,3094,3095,3096,3097,3098,3099,3100,3101,3102,3103,3104,3105,3106,3107,3108,3109,3110,3111,3112,3113,3114,3115,3116,3117,3118,3119,3120,3121,3122,3123,3124,3125,3126,3127,3128,3129,3130,3131,3132,3133,3134,3135,3136,3137,3138,3139,3140,3141,3142,3143,3144,3145,3146,3147,3148,3149,3150,3151,3152,3153,3154,3155,3156,3157,3158,3159,3160,3161,3162,3163,3164,3165,3166,3167,3168,3169,3170,3171,3172,3173,3174,3175,3176,3177,3178,3179,3180,3181,3182,3183,3186,3187,3188,3189,3190,3191,3198,3199,3200,3201,3202,3203,3204,3205,3206,3207,3208,3209,3210,3211,3212,3213,3214,3215,3216,3217,3218,3219,3220,3221,3222,3223,3224,3225,3226,3227,3228,3229,3230,3231,3232,3233,3234,3235,3236,3239,3834,3835,3836,3837,3838,3839,3840,3841,3842,3843,3844,3845,3846,3847,3848,3849,3850,3851,3852,3853,3854,3855,3856],"revision_id":2085142},"mentions":[{"id":"c-sanguozhi-048-sun-xiu:p002:m0030","surface":"綝","start":30,"end":31,"kind":"person","person_id":"hzw_vox_wvw","status":"contextual_provisional"},{"id":"c-sanguozhi-048-sun-xiu:p002:m0048","surface":"恩","start":48,"end":49,"kind":"person","person_id":"dpj_he6_heq","status":"contextual_provisional"},{"id":"c-sanguozhi-048-sun-xiu:p002:m0071","surface":"授","start":71,"end":72,"kind":"person","person_id":"1q9_qs3_kcl","status":"contextual_provisional"},{"id":"c-sanguozhi-048-sun-xiu:p002:m0083","surface":"幹","start":83,"end":84,"kind":"person","person_id":"cyq_b4j_4k0","status":"contextual_provisional"},{"id":"c-sanguozhi-048-sun-xiu:p002:m0096","surface":"張布","start":96,"end":98,"kind":"person","person_id":"vzp_xqn_w3p","status":"contextual_provisional"},{"id":"c-sanguozhi-048-sun-xiu:p002:m0116","surface":"董