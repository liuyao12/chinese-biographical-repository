[{"id":"th-song044-xiehui-digital-39-1","person_id":"sxm_uv1_fvi","title":"益州刺史","kind":"office","mode":"attestation","attestations":[{"id":"th-song044-xiehui-digital-39-1:a","paragraph_id":"c-songshu-044-xiehui-digital:p016","start":1,"end":5,"surface":"益州刺史","person_mention_id":"c-songshu-044-xiehui-digital:p016:m0005","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-044","source_id":"s-songshu-044-xiehui-digital-ws1746033","chapter_id":"c-songshu-044-xiehui-digital","paragraph_id":"c-songshu-044-xiehui-digital:p016","quote":"時益州刺史蕭摹之、巴西太守劉道產被徵還，始至江陵，晦並繫縶，沒其財貨，以充軍資。竟陵內史殷道鸞未之郡，以為諮議參軍。以弟遯為冠軍、竟陵內史，總留任，兄子世猷為建威將軍、南平太守。劉粹若至，周超能破之者，即以為龍驤將軍、雍州刺史。晦率眾二萬，發自江陵，舟艦列自江津至于破冢，旍旂相照，蔽奪日光。晦乃歎曰：「恨不得以此為勤王之師！」自領湘州刺史，以張邵為輔國將軍，邵不受命。","person_mention_id":"c-songshu-044-xiehui-digital:p016:m0005"}],"status":"source_attested","interpretation_note":"原行列於該人名下，職稱與權限依當時敘法。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-song044-wyd-role-xiaomozhi","person_id":"sxm_uv1_fvi","surfaces":["蕭摹之"],"scope":"same_chapter","chapter_ids":["c-songshu-044-wyd1739-xiehui"],"status":"contextual_provisional","confidence_level":"medium","identification_basis":{"kind":"source_context","target_mention_ids":["c-songshu-044-wyd1739-xiehui:p008:m0061"]},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-044","source_id":"s-songshu-044-wyd1739-xiehui","chapter_id":"c-songshu-044-wyd1739-xiehui","paragraph_id":"c-songshu-044-wyd1739-xiehui:p008","quote":"之諸姪咸無所染況彼府州文武並列王職荷國榮任身雖在外乃心辰極夫轉禍貴速後機則凶遂使王師臨郊雷電皆至噬臍之恨亦將何及時益州刺史蕭摹之巴西太守劉道產被徵還始至江陵晦並繫縶沒其財貨以充軍資竟陵內史殷道鸞未之郡以為諮議參軍以弟遯為冠軍竟陵內史總留任兄子世猷為建威將軍南平太守劉粹若至周超能破之者卽以為龍驤將軍雍州刺史晦率二萬發自江陵舟艦列自江津至于破冢旍旂相照蔽奪日光晦乃歎曰恨不得以此為勤王之師自領湘州刺史以張劭為輔國將軍劭不受命晦檄京邑曰王室多故禍難薦臻營陽失德自絶宗廟廬陵王構鬩有本屢被猜嫌且居喪失禮遐邇所具積怨犯上自貽非道羣后釋位爰登聖明亂之未乂職有所係按車騎大將軍王弘侍中王曇首謬蒙時私叨竊權要弘於永初之始實荷不世之恩元嘉之讓自謂任遇浮淺進誣先皇委誠之寄退長嫌隙異同之端曇首往因使下訪以今上起居不能光揚令德彰於朝聽其言多誣故不具說王華賊亡之餘賞擢之次先帝常見訪逮庶有一分可取而華禀性凶猜多所忍害曩者縱人入城託疾辭事此都士庶咸所聞知以其所啟及"}],"rationale":"本源明確個體已暫分登記；現有召回尚不足以接合他篇，不代表已證異人或歷史上無完整姓名。 本源確指個體採暫分登記；跨篇同指保留覆核，不斷言必為新人。","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-songshu-044-wyd1739-xiehui:p008","text":"之諸姪咸無所染況彼府州文武並列王職荷國榮任身雖在外乃心辰極夫轉禍貴速後機則凶遂使王師臨郊雷電皆至噬臍之恨亦將何及時益州刺史蕭摹之巴西太守劉道產被徵還始至江陵晦並繫縶沒其財貨以充軍資竟陵內史殷道鸞未之郡以為諮議參軍以弟遯為冠軍竟陵內史總留任兄子世猷為建威將軍南平太守劉粹若至周超能破之者卽以為龍驤將軍雍州刺史晦率二萬發自江陵舟艦列自江津至于破冢旍旂相照蔽奪日光晦乃歎曰恨不得以此為勤王之師自領湘州刺史以張劭為輔國將軍劭不受命晦檄京邑曰王室多故禍難薦臻營陽失德自絶宗廟廬陵王構鬩有本屢被猜嫌且居喪失禮遐邇所具積怨犯上自貽非道羣后釋位爰登聖明亂之未乂職有所係按車騎大將軍王弘侍中王曇首謬蒙時私叨竊權要弘於永初之始實荷不世之恩元嘉之讓自謂任遇浮淺進誣先皇委誠之寄退長嫌隙異同之端曇首往因使下訪以今上起居不能光揚令德彰於朝聽其言多誣故不具說王華賊亡之餘賞擢之次先帝常見訪逮庶有一分可取而華禀性凶猜多所忍害曩者縱人入城託疾辭事此都士庶咸所聞知以其所啟及","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-songshu-044-wyd1739-xiehui:p008:m0000","start":0,"end":1,"surface":"之","kind":"person","person_id":"4y6_myv_ojh","source_role_key":"xuxianzhi","status":"contextual_provisional","interpretation_note":"承p007末羡，本字之為同名之第二字。"},{"id":"c-songshu-044-wyd1739-xiehui:p008:m0061","start":61,"end":64,"surface":"蕭摹之","status":"contextual_provisional","interpretation_note":"原文明指單一人物，已登記為可查來源暫分個體；跨篇同指仍可覆核，本號不表示已證另人。","kind":"person","person_id":"sxm_uv1_fvi","source_role_key":"xiaomozhi"},{"id":"c-songshu-044-wyd1739-xiehui:p008:m0068","start":68,"end":71,"surface":"劉道產","status":"contextual_provisional","interpretation_note":"原文明指單一人物，已登記為可查來源暫分個體；跨篇同指仍可覆核，本號不表示已證另人。","kind":"person","person_id":"nkg_gf7_8tm","source_role_key":"liudaochan"},{"id":"c-songshu-044-wyd1739-xiehui:p008:m0078","start":78,"end":79,"surface":"晦","status":"contextual_provisional","interpretation_note":"依本傳實指語境及已收近系/同事件角色辨識；精確種子附canonical-seeds，不據同名單獨合併。","kind":"person","person_id":"aa6_83c_juy_AAAA","source_role_key":"hui"},{"id":"c-songshu-044-wyd1739-xi