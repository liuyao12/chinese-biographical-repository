ll_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-weishu-weishou-058-yangjin:p014:m0241","kind":"person","start":241,"end":245,"surface":"臨淮王彧","person_id":"umc_875_z2t","status":"contextual_provisional","human_reviewed":false,"reviewer":"Codex（AI代理）","interpretation_note":"依本完整來源單元具名與角色時序；逐項身份資格見identity-review。","paragraph_id":"c-weishu-weishou-058-yangjin:p014","chapter_id":"c-weishu-weishou-058-yangjin"}],"relations":[],"title_holdings":[{"reviewer":"Codex（AI代理）","human_reviewed":false,"model":null,"id":"th-ws058-jin-080","person_id":"umc_875_z2t","title":"尚書令","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"work_id":"w-weishu-weishou","book_id":"b-weishu-weishou-058","source_id":"s-weishu-weishou-058-yangjin-ws2087998","chapter_id":"c-weishu-weishou-058-yangjin","paragraph_id":"c-weishu-weishou-058-yangjin:p014","quote":"尋除吏部郎中，出為平西將軍、南秦州刺史，加散騎常侍。時年二十九，於時方伯之少未有先之者。仍以路阻不行，改除平東將軍、光州刺史。逸折節綏撫，乃心民務，或日昃不食，夜分不寢。至於兵人從役，必親自送之，或風日之中，雨雪之下，人不堪其勞，逸曾無倦色。又法令嚴明，寬猛相濟，於是合境肅然，莫敢干犯。時災儉連歲，人多餓死，逸欲以倉粟賑給，而所司懼罪不敢。逸曰：「國以人為本，人以食為命，百姓不足，君孰與足？假令以此獲戾，吾所甘心。」遂出粟，然後申表。右僕射元羅以下謂公儲難闕，並執不許。尚書令、臨淮王彧以為宜貸二萬。詔聽二萬。逸既出粟之後，其老小殘疾不能自存活者，又於州門煮粥飯之，將死而得濟者以萬數。帝聞而善之。逸為政愛人，尤憎豪猾，廣設耳目。其兵吏出使下邑，皆自持糧，人或為設食者，雖在闇室，終不進，咸言楊使君有千里眼，那可欺之。在州政績尤美。","person_mention_id":"c-weishu-weishou-058-yangjin:p014:m0241"}],"attestations":[{"paragraph_id":"c-weishu-weishou-058-yangjin:p014","start":237,"end":240,"surface":"尚書令","id":"th-ws058-jin-080:a","person_mention_id":"c-weishu-weishou-058-yangjin:p014:m0241","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"inte