{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003385","identity_policy":"contextual_provisional","person_ids":["cbr-p003385"],"persons":[{"id":"cbr-p003385","label":"鯫生（留侯世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"鯫生","mention_ids":["c-shiji-055-liu:m009-0095"]}],"evidence":[{"mention_id":"c-shiji-055-liu:m009-0095","chapter_id":"c-shiji-055-liu","paragraph_id":"c-shiji-055-liu:p009","quote":"鯫生"}]}],"mentions":[{"id":"c-shiji-055-liu:m009-0095","start":95,"end":97,"surface":"鯫生","kind":"person","person_id":"cbr-p003385","status":"contextual_provisional","paragraph_id":"c-shiji-055-liu:p009","chapter_id":"c-shiji-055-liu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji055-027","person_id":"cbr-p003385","surfaces":["鯫生"],"scope":"same_chapter","chapter_ids":["c-shiji-055-liu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-055-liu:p009","quote":"項羽至鴻門下，欲擊沛公，項伯乃夜馳入沛公軍，私見張良，欲與俱去。良曰：「臣為韓王送沛公，今事有急，亡去不義。」乃具以語沛公。沛公大驚，曰：「為將奈何？」良曰：「沛公誠欲背項羽邪？」沛公曰：「鯫生敎我距關無內諸侯，秦地可盡王，故聽之。」良曰：「沛公自度能卻項羽乎？」沛公默然良久，曰：「固不能也。今為奈何？」良乃固要項伯。項伯見沛公。沛公與飲為壽，結賓婚。令項伯具言沛公不敢倍項羽，所以距關者，備他盜也。及見項羽後解，語在項羽事中。"}],"rationale":"依明示名字、局部任事、授封及引語暫接；良久、每上冢與愛子之上排除人物短稱。老父場景的父不接張良父平；韓悼惠王不接齊王，秦王子嬰不接博浪沙秦皇帝，未名者不補姓名。神異與古代比擬不表示人物當時在場或神蹟已證。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-055-liu:p009","text":"項羽至鴻門下，欲擊沛公，項伯乃夜馳入沛公軍，私見張良，欲與俱去。良曰：「臣為韓王送沛公，今事有急，亡去不義。」乃具以語沛公。沛公大驚，曰：「為將奈何？」良曰：「沛公誠欲背項羽邪？」沛公曰：「鯫生敎我距關無內諸侯，秦地可盡王，故聽之。」良曰：「沛公自度能卻項羽乎？」沛公默然良久，曰：「固不能也。今為奈何？」良乃固要項伯。項伯見沛公。沛公與飲為壽，結賓婚。令項伯具言沛公不敢倍項羽，所以距關者，備他盜也。及見項羽後解，語在項羽事中。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-055-liu:m009-0000","start":0,"end":2,"surface":"項羽","kind":"person","person_id":"cbr-p003384","status":"contextual_provisional"},{"id":"c-shiji-055-liu:m009-0009","st