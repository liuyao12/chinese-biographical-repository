red","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-061-lukai:line054:m0108","start":108,"end":110,"surface":"詹廉","kind":"person","person_id":"hrs_xdv_obm","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-061-lukai:line054","chapter_id":"c-sanguozhi-061-lukai"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-061-lukai:line054","text":"　　先帝每宴見群臣，抑損醇（酉農），臣下終日無失慢之尤，百寮庶尹，並展所陳。而陛下拘以視瞻之敬，懼以不盡之酒。夫酒以成札，過則敗德，此無異商辛長夜之飲也，是不遵先帝九也；　　昔漢之桓、靈，親近宦豎。大失民心。今高通、詹廉、羊度，黃門小人，而陛下賞以重爵，權以戰兵。若江渚有難，烽燧互起，則度等之武不能禦侮明也，是不遵先帝十也；　　今宮女曠積，而黃門復走州郡，條牒民女，有錢則捨，無錢則取，怨呼道路，母子死訣，是不遵先帝十一也；　　先帝在時，亦養諸王太子，若取乳母，其夫復役，賜與錢財，給其資糧，時遣歸來，視其弱息。今則不然，夫婦生離，夫故作役，兒從後死，家為空戶，是不遵先帝十二也；　　先帝歎曰：‘國以民為本，民以食為天，衣其次也，三者，孤存之於心。’今則不然，農桑並廢，是不遵先帝十三也；","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-061-lukai:line054:m0069","start":69,"end":71,"surface":"商辛","kind":"person","person_id":"lwx_9yq_ad7","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line054:m0090","surface":"桓","start":90,"end":91,"kind":"person","person_id":"cq3_2gy_twf","status":"contextual_provisional","interpretation_note":"按本段具名及前後親稱、官職定位。"},{"id":"c-sanguozhi-061-lukai:line054:m0092","surface":"靈","start":92,"end":93,"kind":"person","person_id":"0wg_vtn_yqb","status":"contextual_provisional","interpretation_note":"按本段具名及前後親稱、官職定位。"},{"id":"c-sanguozhi-061-lukai:line054:m0105","start":105,"end":107,"surface":"高通","kind":"person","person_id":"lky_we8_r5v","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line054:m0108","start":108,"end":110,"surface":"詹廉","kind":"person","person_id":"hrs_xdv_obm","s