tatus":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-059-he:line032-pei03-01","chapter_id":"c-sanguozhi-059-he"}],"relations":[],"title_holdings":[{"id":"t-wu050-pan-1","person_id":"gb5_61l_46e","kind":"office","title":"中書令","mode":"attestation","status":"source_attested","effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本句所載職官，任免時間未詳。","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-050","chapter_id":"c-sanguozhi-050-pan","source_id":"s-sanguozhi-050-pan","paragraph_id":"c-sanguozhi-050-pan:line046","quote":"吳主權潘夫人，會稽句章人也。父為吏，坐法死。夫人與姊俱輸織室，權見而異之，召充後宮。得幸有娠，夢有以龍頭授己者，己以蔽膝受之，遂生（孫）亮。赤烏十三年，亮立為太子，請出嫁夫人之姊，權聽許之。明年，立夫人為皇后。性險妒容媚，自始至卒，譖害袁夫人等甚眾。權不豫，夫人使問中書令孫弘呂后專制故事。侍疾疲勞，因以羸疾，諸宮人伺其昏臥，共縊殺之，託言中惡。後事洩，坐死者六七人。權尋薨，合葬蔣陵。孫亮即位，以夫人姊婿譚紹為騎都尉，授兵。亮廢，紹與家屬送本部廬陵。","person_mention_id":"c-sanguozhi-050-pan:line046:m0136"}],"attestations":[{"id":"t-wu050-pan-1:a","paragraph_id":"c-sanguozhi-050-pan:line046","person_mention_id":"c-sanguozhi-050-pan:line046:m0136","start":133,"end":136,"surface":"中書令","usage":"narrative","date_expression":null}],"human_reviewed":false,"reviewer":"Codex（AI 代理）","model":null},{"id":"th-wu052-zx-8","person_id":"gb5_61l_46e","title":"中書令","kind":"office","mode":"attestation","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-052","chapter_id":"c-sanguozhi-052-zhangxiu-complete","source_id":"s-sanguozhi-052-zhangxiu-complete","paragraph_id":"c-sanguozhi-052-zhangxiu-complete:line036","quote":"休字叔嗣，弱冠與諸葛恪、顧譚等俱爲太子登僚友，以《漢書》授登。從中庶子轉爲右弼都尉。權常遊獵，迨幕乃歸，休上疏諫戒，權大善之，以示於昭。及登卒後，爲侍中，拜羽林都督，平三典軍事，遷揚武將軍。爲魯王霸友黨所譖，與顧譚、承俱以芍陂論功事，休、承與典軍陳恂通情，詐增其伐，並徙交州。中書令孫弘佞偽險詖，休素所忿，弘因是譖訴，下詔書賜休死，時年四十一。","person_mention_id":"c-sanguozhi-052-zhangxiu-complete:line036:m0141"}],"attestations":[{"id":"th-wu052-zx-8:a","paragraph_id":"c-sanguozhi-052-zhangxiu-complete:line036","start":138,"end":141,"surface":"中書令","person_mention_id":"c-sanguozhi-052-zhangxiu-complete:line036:m0141","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-050-pan:line046","text":"吳主權潘夫人，會稽句章人也。父為吏，坐法死。夫人與姊俱輸織室，權見而異之，召充後宮。得幸有娠，夢有以龍頭授己者，己以蔽膝受之，遂生（孫）亮。赤烏十三年，亮立為太子，請出嫁夫人之姊，權聽許之。明年，立夫人為皇后。性險妒容媚，自始至卒，譖害袁夫人等甚眾。權不豫，夫人使問中書令孫弘呂后專制故事。侍疾疲勞，因以羸疾，諸宮人伺其昏臥，共縊殺之，託言中惡。後事洩，坐死者六七人。權尋薨，合葬蔣陵。孫亮即位，以夫人姊婿譚紹為騎都尉，授兵。亮廢，紹與家屬送本部廬陵。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-050-pan:line046:m0002","start":2,"end":3,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-pan:line046:m0003","start":3,"end":6,"surface":"潘夫人","kind":"person","person_id":"21k_qde_yg6","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-pan:line046:m0031","start":31,"end":32,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-pan:line046:m0068","start":68,"end":69,"surface":"亮","kind":"person","person_id":"hqp_o1w_ihy","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-pan:line046:m0076","start":76,"end":77,"surface":"亮","kind":"person","person_id":"hqp_o1w_ihy","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-pan:line046:m0088","surface":"姊","start":88,"end":89,"kind":"person","person_id":"r50_exn_l3s","status":"contextual_provisional","inte