e","book_id":"b-sanguozhi-052","work_id":"w-sanguozhi","source_id":"s-sanguozhi-052-zhangxiu-complete"},{"id":"c-sanguozhi-057-zhuju:line096","text":"赤烏九年，遷驃騎將軍。遭二宮構爭，據擁護太子，言則懇至，義形於色，守之以死，遂左遷新都郡丞。未到，中書令孫弘譖潤據，因權寢疾，弘為詔書追賜死，時年五十七。孫亮時，二子熊、損各復領兵，為全公主所謂，皆死。永安中，迫錄前功，以熊子宣襲爵雲陽侯，尚公主。孫皓時，宣至驃騎將軍。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-057-zhuju:line096:m0017","start":17,"end":18,"surface":"據","kind":"person","person_id":"ejj_vdz_hxw","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-zhuju:line096:m0020","start":20,"end":22,"surface":"太子","kind":"person","person_id":"572_278_cba_A","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-zhuju:line096:m0053","start":53,"end":54,"surface":"弘","kind":"person","person_id":"gb5_61l_46e","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-zhuju:line096:m0056","start":56,"end":57,"surface":"據","kind":"person","person_id":"ejj_vdz_hxw","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-zhuju:line096:m0059","start":59,"end":60,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-zhuju:line096:m0063","start":63,"end":64,"surface":"弘","kind":"person","person_id":"gb5_61l_46e","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-zhuju:line096:m0077","start":77,"end":79,"surface":"孫亮","kind":"person","person_id":"hqp_o1w_ihy","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-zhuju:line096:m0083","start":83,"end":84,"surface":"熊","kind":"person","person_id":"ejj_vdz_hxw_A","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-zhuju:line096:m0085","start":85,"end":86,"surface":"損","kind":"person","person_id":"ejj_vdz_hxw_B","stat