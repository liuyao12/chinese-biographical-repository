{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p002023","identity_policy":"contextual_provisional","person_ids":["cbr-p002023"],"persons":[{"id":"cbr-p002023","label":"公子光（楚篇吳伐楚者）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"公子光","mention_ids":["c-shiji-040-chu:m044-0017","c-shiji-040-chu:m044-0112"]}],"evidence":[{"mention_id":"c-shiji-040-chu:m044-0017","chapter_id":"c-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p044","quote":"公子光"},{"mention_id":"c-shiji-040-chu:m044-0112","chapter_id":"c-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p044","quote":"公子光"}]}],"mentions":[{"id":"c-shiji-040-chu:m044-0017","start":17,"end":20,"surface":"公子光","kind":"person","person_id":"cbr-p002023","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p044","chapter_id":"c-shiji-040-chu"},{"id":"c-shiji-040-chu:m044-0112","start":112,"end":115,"surface":"公子光","kind":"person","person_id":"cbr-p002023","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p044","chapter_id":"c-shiji-040-chu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji040-147","person_id":"cbr-p002023","surfaces":["公子光"],"scope":"same_chapter","chapter_ids":["c-shiji-040-chu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-040-chu:p044","quote":"十年，楚太子建母在居巣，開呉。呉使公子光伐楚，遂敗陳、蔡，取太子建母而去。楚恐，城郢。初，呉之邊邑卑梁與楚邊邑鐘離小童爭桑，兩家交怒相攻，滅卑梁人。卑梁大夫怒，發邑兵攻鐘離。楚王聞之怒，發國兵滅卑梁。呉王聞之大怒，亦發兵，使公子光因建母家攻楚，遂滅鐘離、居巣。楚乃恐而城郢。"}],"rationale":"本篇具名角色先保存候選；尚未與他篇同名或同稱人物完成事件、世系與版本比對，不作確定不同人或確定同人的結論。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-040-chu:p044","text":"十年，楚太子建母在居巣，開呉。呉使公子光伐楚，遂敗陳、蔡，取太子建母而去。楚恐，城郢。初，呉之邊邑卑梁與楚邊邑鐘離小童爭桑，兩家交怒相攻，滅卑梁人。卑梁大夫怒，發邑兵攻鐘離。楚王聞之怒，發國兵滅卑梁。呉王聞之大怒，亦發兵，使公子光因建母家攻楚，遂滅鐘離、居巣。楚乃恐而城郢。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-