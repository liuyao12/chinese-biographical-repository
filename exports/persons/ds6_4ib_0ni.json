rn-and-eastern-complete:p033:m0180"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-058-southern-and-eastern-complete:p033:m0188","mention_ids":["c-nanqishu-058-southern-and-eastern-complete:p033:m0188"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-058-southern-and-eastern-complete:p033:m0244","mention_ids":["c-nanqishu-058-southern-and-eastern-complete:p033:m0244"],"kind":"paragraph"}],"mention_count":11,"duplicate_mention_count":0,"paragraph_occurrence_count":11,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"11處獨立位置，11個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-nanqishu-058-southern-and-eastern-complete-ws2638629"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-nanqishu-058-southern-and-eastern-complete:source_review33-0","kind":"source_review","person_id":"ds6_4ib_0ni","source_quote":"六年，以始興太守房法乘代楷。法乘至鎮，屬疾不理事，專好讀書。長史伏登之因此擅權，改易將吏，不令法乘知。錄事房季文白之，法乘大怒，繫登之於獄。十餘日，登之厚賂法乘妹夫崔景叔得出，將部曲襲州執法乘，謂之曰：「使君既有疾，不宜勞。」囚之別室。法乘無事，復就登之求書讀，登之曰：「使君靜處猶恐動疾，豈可看書。」遂不與。乃啟法乘心疾動，不任視事，世祖仍以登之為交州刺史。法乘還至嶺而卒。法乘，清河人。昇明中，為太祖驃騎中兵，至左中郎將。性方簡，身長八尺三寸，行出人上，常自俯屈。青州刺史明慶符亦長與法乘等，朝廷唯此二人。","reading":"房法乘與伏登之的獄、奪權和朝廷任用連成一則，崔景叔所稱妹夫有明文。末具房法乘籍貫、仕履與身長。","note":"房法乘與伏登之的獄、奪權和朝廷任用連成一則，崔景叔所稱妹夫有明文。末具房法乘籍貫、仕履與身長。","paragraph_id":"c-nanqishu-058-southern-and-eastern-complete:p033","start_codepoint":0,"end_codepoint":255,"human_reviewed":false,"chapter_id":"c-nanqishu-058-southern-and-eastern-complete","source_id":"s-nanqishu-058-southern-and-eastern-complete-ws2638629"},{"id":"c-nanqishu-058-southern-and-eastern-complete:variant_review33-76","kind":"variant_review","person_id":"ds6_4ib_0ni","source_quote":"厚賂法乘妹夫崔景叔","reading":"崔景叔是房法乘妹夫，原女未具名；房季文是錄事，兩人作用不同。","note":"崔景叔是房法乘妹夫，原女未具名；房季文是錄事，兩人作用不同。","paragraph_id":"c-nanqishu-058-southern-and-eastern-complete:p033","start_codepoint":76,"end_codepoint":85,"human_reviewed":false,"chapter_id":"c-nanqishu-058-southern-and-eastern-complete","source_id":"s-nanqishu-058-southern-and-eastern-complete-ws2638629"},{"id":"c-nanqishu-058-southern-and-eastern-complete:variant_review33-248","kind":"variant_review","person_id":"ds6_4ib_0ni","source_quote":"朝廷唯此二人","reading":"法乘清河人，身長原報八尺三寸；與青州刺史明慶符並稱，非同族依據。","note":"法乘清河人，身長原報八尺三寸；與青州刺史明慶符並稱，非同族依據。","paragraph_id":"c-nanqishu-058-southern-and-eastern-complete:p033","start_codepoint":248,"end_codepoint":254,"human_reviewed":false,"chapter_id":"c-nanqishu-058-southern-and-eastern-complete","source_id":"s-nanqishu-058-southern-and-eastern-complete-ws2638629"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-qi058-fang-facheng-death","person_id":"ds6_4ib_0ni","event_type":"death","source_term":"卒","source_anchor":{"paragraph_id":"c-nanqishu-058-southern-and-eastern-complete:p033","start":186,"end":187,"surface":"卒"},"date_expression":null,"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-058","chapter_id":"c-nanqishu-058-southern-and-eastern-complete","source_id":"s-nanqishu-058-southern-and-eastern-complete-ws2638629","paragraph_id":"c-nanqishu-058-southern-and-eastern-complete:p033","quote":"六年，以始興太守房法乘代楷。法乘至鎮，屬疾不理事，專好讀書。長史伏登之因此擅權，改易將吏，不令法乘知。錄事房季文白之，法乘大怒，繫登之於獄。十餘日，登之厚賂法乘妹夫崔景叔得出，將部曲襲州執法乘，謂之曰：「使君既有疾，不宜勞。」囚之別室。法乘無事，復就登之求書讀，登之曰：「使君靜處猶恐動疾，豈可看書。」遂不與。乃啟法乘心疾動，不任視事，世祖仍以登之為交州刺史。法乘還至嶺而卒。法乘，清河人。昇明中，為太祖驃騎中兵，至左中郎將。性方簡，身長八尺三寸，行出人上，常自俯屈。青州刺史明慶符亦長與法乘等，朝廷唯此二人。","person_mention_id":"c-nanqishu-058-sout