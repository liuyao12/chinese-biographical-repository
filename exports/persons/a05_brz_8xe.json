","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p016","chapter_id":"c-shiji-112-pingjin"},{"id":"c-shiji-112-pingjin:m016-0201","start":201,"end":203,"surface":"陛下","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p016","chapter_id":"c-shiji-112-pingjin"},{"id":"c-shiji-112-pingjin:m016-0291","start":291,"end":293,"surface":"陛下","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p016","chapter_id":"c-shiji-112-pingjin"},{"id":"c-shiji-112-pingjin:m016-0313","start":313,"end":315,"surface":"陛下","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p016","chapter_id":"c-shiji-112-pingjin"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-112-pingjin:p002","text":"建元元年，天子初即位，招賢良文學之士。是時弘年六十，徵以賢良為博士。使匈奴，還報，不合上意，上怒，以為不能，弘乃病免歸。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-112-pingjin:m002-0005","start":5,"end":7,"surface":"天子","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m002-0021","start":21,"end":22,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m002-0043","start":43,"end":44,"surface":"上","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m002-0046","start":46,"end":47,"surface":"上","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m002-0054","start":54,"end":55,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"}],"chapter_id":"c-shiji-112-pingjin","book_id":"b-shiji-112","work_id":"w-shiji","source_id":"s-shiji112-pingjin"},{"id":"c-shiji-112-pingjin:p003","text":"元光五年，有詔徵文學，菑川國復推上公孫弘。弘讓謝國人曰：「臣已嘗西應命，以不能罷歸，願更推選。」國人固推弘，弘至太常。太常令所徵儒士各對策，百餘人，弘第居下。策奏，天子擢弘對為第一。召入見，狀貌甚麗，拜為博士。是時通西南夷道，置郡，巴蜀民苦之，詔使弘視之。還奏事，盛毀西南夷無所用，上不聽。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-112-pingjin:m003-0017","start":17,"end":20,"surface":"公孫弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m003-0021","start":21,"end":22,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m003-0052","start":52,"end":53,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m003-0054","start":54,"end":55,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m003-0056","start":56,"end":58,"surface":"太常","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-112-pingjin:m003-0059","start":59,"end":61,"surface":"太常","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-112-pingjin:m003-0074","start":74,"end":75,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m003-0082","start":82,"end":84,"surface":"天子","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m003-0085","start":85,"end":86,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m003-0124","start":124,"end":125,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"}],"chapter_id":"c-shiji-112-pingjin","book_id":"b-shiji-112","work_id":"w-shiji","source_id":"s-shiji112-pingjin"},{"id":"c-shiji-112-pingjin:p004","text":"弘為人恢奇多聞，常稱以為人主病不廣大，人臣病不儉節。弘為布被，食不重肉。后母死，服喪三年。每朝會議，開陳其端，令人主自擇，不肯面折庭爭。於是天子察其行敦厚，辯論有餘，習文法吏事，而又緣飾以儒術，上大說之。二歲中，至左內史。弘奏事，有不可，不庭辯之。嘗與主爵都尉汲黯請閒，汲黯先發之，弘推其後，天子常說，所言皆聽，以此日益親貴。嘗與公卿約議，至上前，皆倍其約以順上旨。汲黯庭詰弘曰：「齊人多詐而無情實，始與臣等建此議，今皆倍之，不忠。」上問弘。弘謝曰：「夫知臣者以臣為忠，不知臣者以臣為不忠。」上然弘言。左右幸臣每毀弘，上益厚遇之。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-112-pingjin:m004-0000","start":0,"end":1,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0026","start":26,"end":27,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0036","start":36,"end":38,"surface":"后母","kind":"person","person_id":"fyw_e6a_8dl","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0070","start":70,"end":72,"surface":"天子","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0097","start":97,"end":98,"surface":"上","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0111","start":111,"end":112,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0130","start":130,"end":132,"surface":"汲黯","kind":"person","person_id":"fmh_dmt_cql","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0135","start":135,"end":137,"surface":"汲黯","kind":"person","person_id":"fmh_dmt_cql","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0141","start":141,"end":142,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0146","start":146,"end":148,"surface":"天子","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0171","start":171,"end":172,"surface":"上","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0180","start":180,"end":181,"surface":"上","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0183","start":183,"end":185,"surface":"汲黯","kind":"person","person_id":"fmh_dmt_cql","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0187","start":187,"end":188,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0217","start":217,"end":218,"surface":"上","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0219","start":219,"end":220,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0221","start":221,"end":222,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0246","start":246,"end":247,"surface":"上","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0248","start":248,"end":249,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0257","start":257,"end":258,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0259","start":259,"end":260,"surface":"上","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"}],"chapter_id":"c-shiji-112-pingjin","book_id":"b-shiji-112","work_id":"w-shiji","source_id":"s-shiji112-pingjin"},{"id":"c-shiji-112-pingjin:p005","text":"元朔三年，張歐免，以弘為御史大夫。是時通西南夷，東置滄海，北筑朔方之郡。弘數諫，以為罷敝中國以奉無用之地，願罷之。於是天子乃使朱買臣等難弘置朔方之便。發十策，弘不得一。弘乃謝曰：「山東鄙人，不知其便若是，願罷西南夷、滄海而專奉朔方。」上乃許之。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-112-pingjin:m005-0005","start":5,"end":7,"surface":"張歐","kind":"person","person_id":"0ad_530_yth","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m005-0010","start":10,"end":11,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m005-0036","start":36,"end":37,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m005-0059","start":59,"end":61,"surface":"天子","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m005-0063","start":63,"end":66,"surface":"朱買臣","kind":"person","person_id":"bvn_k2n_f84","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m005-0068","start":68,"end":69,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m005-0079","start":79,"end":80,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m005-0084","start":84,"end":85,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m005-0117","start":117,"end":118,"surface":"上","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"}],"chapter_id":"c-shiji-112-pingjin","book_id":"b-shiji-112","work_id":"w-shiji","source_id":"s-shiji112-pingjin"},{"id":"c-shiji-112-pingjin:p006","text":"汲黯曰：「弘位在三公，奉祿甚多。然為布被，此詐也。」上問弘。弘謝曰：「有之。夫九卿與臣善者無過黯，然今日庭詰弘，誠中弘之病。夫以三公為布被，誠飾詐欲以釣名。且臣聞管仲相齊，有三歸，侈擬於君，桓公以霸，亦上僭於君。晏嬰相景公，食不重肉，妾不衣絲，齊國亦治，此下比於民。今臣弘位為御史大夫，而為布被，自九卿以下至於小吏，無差，誠如汲黯言。且無汲黯忠，陛下安得聞此言。」天子以為謙讓，愈益厚之。卒以弘為丞相，封平津侯。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-112-pingjin:m006-0000","start":0,"end":2,"surface":"汲黯","kind":"person","person_id":"fmh_dmt_cql","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m006-0005","start":5,"end":6,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m006-0026","start":26,"end":27,"surface":"上","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m006-0028","start":28,"end":29,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m006-0030","start":30,"end":31,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m006-0047","start":47,"end":48,"surface":"黯","kind":"person","person_id":"fmh_dmt_cql","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m006-0054","start":54,"end":55,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m006-0058","start":58,"end":59,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m006-0081","start":81,"end":83,"surface":"管仲","kind":"person","person_id":"zgg_ncu_lxg","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m006-0095","start":95,"end":97,"surface":"桓公","kind":"person","person_id":"6ua_ti1_4bc","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m006-0106","start":106,"end":108,"surface":"晏嬰","kind":"person","person_id":"811_det_o9f","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m006-0109","start":109,"end":111,"surface":"景公","kind":"person","person_id":"i8v_5et_i28","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m006-0135","start":135,"end":136,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m006-0163","start":163,"end":165,"surface":"汲黯","kind":"person","person_id":"fmh_dmt_cql","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m006-0169","start":169,"end":171,"surface":"汲黯","kind":"person","person_id":"fmh_dmt_cql","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m006-0182","start":182,"end":184,"surface":"天子","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m006-0196","start":196,"end":197,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"}],"chapter_id":"c-shiji-112-pingjin","book_id":"b-shiji-112","work_id":"w-shiji","source_id":"s-shiji112-pingjin"},{"id":"c-shiji-112-pingjin:p008","text":"淮南、衡山謀反，治黨與方急。弘病甚，自以為無功而封，位至丞相，宜佐明主填撫國家，使人由臣子之道。今諸侯有畔逆之計，此皆宰相奉職不稱，恐竊病死，無以塞責。乃上書曰：「臣聞天下之通道五，所以行之者三。曰君臣，父子，兄弟，夫婦，長幼之序，此五者天下之通道也。智，仁，勇，此三者天下之通德，所以行之者也。故曰『力行近乎仁，好問近乎智，知恥近乎勇』。知此三者，則知所以自治；知所以自治，然後知所以治人。天下未有不能自治而能治人者也，此百世不易之道也。今陛下躬行大孝，鑒三王，建周道，兼文武，厲賢予祿，量能授官。今臣弘罷駑之質，無汗馬之勞，陛下過意擢臣弘卒伍之中，封為列侯，致位三公。臣弘行能不足以稱，素有負薪之病，恐先狗馬填溝壑，終無以報德塞責。願歸侯印，乞骸骨，避賢者路。」天子報曰：「古者賞有功，襃德，守成尚文，遭遇右武，未有易此者也。朕宿昔庶幾獲承尊位，懼不能寧，惟所與共為治者，君宜知之。蓋君子善善惡惡，（君宜知之）君若謹行，常在朕躬。君不幸罹霜露之病，何恙不已，乃上書歸侯，乞骸骨，是章朕之不德也。今事少閒，君其省思慮，一精神，輔以醫藥。」因賜告牛酒雜帛。居數月，病有瘳，視事。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-112-pingjin:m008-0000","start":0,"end":2,"surface":"淮南","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-112-pingjin:m008-0003","start":3,"end":5,"surface":"衡山","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-112-pingjin:m008-0014","start":14,"end":15,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m008-0221","start":221,"end":223,"surface":"陛下","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m008-0229","start":229,"end":231,"surface":"三王","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-112-pingjin:m008-0237","start":237,"end":239,"surface":"文武","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-112-pingjin:m008-0252","start":252,"end":253,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m008-0264","start":264,"end":266,"surface":"陛下","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m008-0270","start":270,"end":271,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m008-0287","start":287,"end":288,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m008-0333","start":333,"end":335,"surface":"天子","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m008-0365","start":365,"end":366,"surface":"朕","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m008-0388","start":388,"end":389,"surface":"君","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m008-0394","start":394,"end":395,"surface":"君","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m008-0402","start":402,"end":403,"surface":"君","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m008-0407","start":407,"end":408,"surface":"君","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m008-0414","start":414,"end":415,"surface":"朕","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m008-0417","start":417,"end":418,"surface":"君","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m008-0443","start":443,"end":444,"surface":"朕","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m008-0454","start":454,"end":455,"surface":"君","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"}],"chapter_id":"c-shiji-112-pingjin","book_id":"b-shiji-112","work_id":"w-shiji","source_id":"s-shiji112-pingjin"},{"id":"c-shiji-112-pingjin:p010","text":"主父偃者，齊臨菑人也。學長短縱橫之術，晚乃學易、春秋、百家言。游齊諸生閒，莫能厚遇也。齊諸儒生相與排擯，不容於齊。家貧，假貸無所得，乃北游燕、趙、中山，皆莫能厚遇，為客甚困。孝武元光元年中，以為諸侯莫足游者，乃西入關見衛將軍。衛將軍數言上，上不召。資用乏，留久，諸公賓客多厭之，乃上書闕下。朝奏，暮召入見。所言九事，其八事為律令，一事諫伐匈奴。其辭曰：","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-112-pingjin:m010-0000","start":0,"end":3,"surface":"主父偃","kind":"person","person_id":"vbr_ff1_yc4","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m010-0087","start":87,"end":89,"surface":"孝武","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m010-0109","start":109,"end":112,"surface":"衛將軍","kind":"person","person_id":"sg8_94p_jik","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m010-0113","start":113,"end":116,"surface":"衛將軍","kind":"person","person_id":"sg8_94p_jik","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m010-0118","start":118,"end":119,"surface":"上","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m010-0120","start":120,"end":121,"surface":"上","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"}],"chapter_id":"c-shiji-112-pingjin","book_id":"b-shiji-112","work_id":"w-shiji","source_id":"s-shiji112-pingjin"},{"id":"c-shiji-112-pingjin:p011","text":"臣聞明主不惡切諫以博觀，忠臣不敢避重誅以直諫，是故事無遺策而功流萬世。今臣不敢隱忠避死以效愚計，願陛下幸赦而少察之。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-112-pingjin:m011-0000","start":0,"end":1,"surface":"臣","kind":"person","person_id":"vbr_ff1_yc4","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m011-0036","start":36,"end":37,"surface":"臣","kind":"person","person_id":"vbr_ff1_yc4","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m011-0049","start":49,"end":51,"surface":"陛下","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"}],"chapter_id":"c-shiji-112-pingjin","book_id":"b-shiji-112","work_id":"w-shiji","source_id":"s-shiji112-pingjin"},{"id":"c-shiji-112-pingjin:p013","text":"及至高皇帝定天下，略地於邊，聞匈奴聚於代谷之外而欲擊之。御史成進諫曰：「不可。夫匈奴之性，獸聚而鳥散，從之如搏影。今以陛下盛德攻匈奴，臣竊危之。」高帝不聽，遂北至於代谷，果有平城之圍。高皇帝蓋悔之甚，乃使劉敬往結和親之約，然後天下忘干戈之事。故兵法曰「興師十萬，日費千金」。夫秦常積眾暴兵數十萬人，雖有覆軍殺將系虜單于之功，亦適足以結怨深讎，不足以償天下之費。夫上虛府庫，下敝百姓，甘心於外國，非完事也。夫匈奴難得而制，非一世也。行盜侵驅，所以為業也，天性固然。上及虞夏殷周，固弗程督，禽獸畜之，不屬為人。夫上不觀虞夏殷周之統，而下（修）［循］近世之失，此臣之所大憂，百姓之所疾苦也。且夫兵久則變生，事苦則慮易。乃使邊境之民獘靡愁苦而有離心，將吏相疑而外市，故尉佗、章邯得以成其私也。夫秦政之所以不行者，權分乎二子，此得失之效也。故《周書》曰「安危在出令，存亡在所用」。願陛下詳察之，少加意而熟慮焉。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-112-pingjin:m013-0002","start":2,"end":5,"surface":"高皇帝","kind":"person","person_id":"1c0_c3k_jno","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m013-0030","start":30,"end":32,"surface":"成進","kind":"person","person_id":"lve_fqh_8v6","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m013-0059","start":59,"end":61,"surface":"陛下","kind":"person","person_id":"1c0_c3k_jno","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m013-0073","start":73,"end":75,"surface":"高帝","kind":"person","person_id":"1c0_c3k_jno","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m013-0092","start":92,"end":95,"surface":"高皇帝","kind":"person","person_id":"1c0_c3k_jno","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m013-0102","start":102,"end":104,"surface":"劉敬","kind":"person","person_id":"5vm_33p_472","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m013-0157","start":157,"end":159,"surface":"單于","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-112-pingjin:m013-0330","start":330,"end":332,"surface":"尉佗","kind":"person","person_id":"qig_axh_3z6","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m013-0333","start":333,"end":335,"surface":"章邯","kind":"person","person_id":"rxf_qqr_to2","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m013-0355","start":355,"end":357,"surface":"二子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-112-pingjin:m013-0386","start":386,"end":388,"surface":"陛下","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"}],"chapter_id":"c-shiji-112-pingjin","book_id":"b-shiji-112","work_id":"w-shiji","source_id":"s-shiji112-pingjin"},{"id":"c-shiji-112-pingjin:p016","text":"閒者關東五穀不登，年歲未復，民多窮困，重之以邊境之事，推數循理而觀之，則民且有不安其處者矣。不安故易動。易動者，土崩之勢也。故賢主獨觀萬化之原，明於安危之機，修之廟堂之上，而銷未形之患。其要，期使天下無土崩之勢而已矣。故雖有彊國勁兵，陛下逐走獸，射蜚鳥，弘游燕之囿，淫縱恣之觀，極馳騁之樂，自若也。金石絲竹之聲不絕於耳，帷帳之私俳優侏儒之笑不乏於前，而天下無宿憂。名何必湯武，俗何必成康！雖然，臣竊以為陛下天然之聖，寬仁之資，而誠以天下為務，則湯武之名不難侔，而成康之俗可復興也。此二體者立，然後處尊安之實，揚名廣譽於當世，親天下而服四夷，餘恩遺德為數世隆，南面負扆攝袂而揖王公，此陛下之所服也。臣聞圖王不成，其敝足以安。安則陛下何求而不得，何為而不成，何征而不服乎哉！","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-112-pingjin:m016-0117","start":117,"end":119,"surface":"陛下","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m016-0185","start":185,"end":186,"surface":"湯","kind":"person","person_id":"oil_hwe_l58","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m016-0186","start":186,"end":187,"surface":"武","kind":"person","person_id":"9nw_rct_r8j","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m016-0191","start":191,"end":192,"surface":"成","kind":"person","person_id":"rb8_xqe_j0t","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m016-0192","start":192,"end":193,"surface":"康","kind":"person","person_id":"rwy_lxz_2cv","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m016-0201","start":201,"end":203,"surface":"陛下","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m016-0222","start":222,"end":223,"surface":"湯","kind":"person","person_id":"oil_hwe_l58","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m016-0223","start":223,"end":224,"surface":"武","kind":"person","person_id":"9nw_rct_r8j","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m016-0231","start":231,"end":232,"surface":"成","kind":"p