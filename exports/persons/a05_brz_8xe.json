,"status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p008","chapter_id":"c-shiji-112-pingjin"},{"id":"c-shiji-112-pingjin:m008-0365","start":365,"end":366,"surface":"朕","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p008","chapter_id":"c-shiji-112-pingjin"},{"id":"c-shiji-112-pingjin:m008-0414","start":414,"end":415,"surface":"朕","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p008","chapter_id":"c-shiji-112-pingjin"},{"id":"c-shiji-112-pingjin:m008-0443","start":443,"end":444,"surface":"朕","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p008","chapter_id":"c-shiji-112-pingjin"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-112-pingjin:p002","text":"建元元年，天子初即位，招賢良文學之士。是時弘年六十，徵以賢良為博士。使匈奴，還報，不合上意，上怒，以為不能，弘乃病免歸。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-112-pingjin:m002-0005","start":5,"end":7,"surface":"天子","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m002-0021","start":21,"end":22,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m002-0043","start":43,"end":44,"surface":"上","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m002-0046","start":46,"end":47,"surface":"上","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m002-0054","start":54,"end":55,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"}],"chapter_id":"c-shiji-112-pingjin","book_id":"b-shiji-112","work_id":"w-shiji","source_id":"s-shiji112-pingjin"},{"id":"c-shiji-112-pingjin:p003","text":"元光五年，有詔徵文學，菑川國復推上公孫弘。弘讓謝國人曰：「臣已嘗西應命，以不能罷歸，願更推選。」國人固推弘，弘至太常。太常令所徵儒士各對策，百餘人，弘第居下。策奏，天子擢弘對為第一。召入見，狀貌甚麗，拜為博士。是時通西南夷道，置郡，巴蜀民苦之，詔使弘視之。還奏事，盛毀西南夷無所用，上不聽。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-112-pingjin:m003-0017","start":17,"end":20,"surface":"公孫弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m003-0021","start":21,"end":22,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m003-0052","start":52,"end":53,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m003-0054","start":54,"end":55,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m003-0056","start":56,"end":58,"surface":"太常","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-112-pingjin:m003-0059","start":59,"end":61,"surface":"太常","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-112-pingjin:m003-0074","start":74,"end":75,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m003-0082","start":82,"end":84,"surface":"天子","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m003-0085","start":85,"end":86,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m003-0124","start":124,"end":125,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"}],"chapter_id":"c-shiji-112-pingjin","book_id":"b-shiji-112","work_id":"w-shiji","source_id":"s-shiji112-pingjin"},{"id":"c-shiji-112-pingjin:p004","text":"弘為人恢奇多聞，常稱以為人主病不廣大，人臣病不儉節。弘為布被，食不重肉。后母死，服喪三年。每朝會議，開陳其端，令人主自擇，不肯面折庭爭。於是天子察其行敦厚，辯論有餘，習文法吏事，而又緣飾以儒術，上大說之。二歲中，至左內史。弘奏事，有不可，不庭辯之。嘗與主爵都尉汲黯請閒，汲黯先發之，弘推其後，天子常說，所言皆聽，以此日益親貴。嘗與公卿約議，至上前，皆倍其約以順上旨。汲黯庭詰弘曰：「齊人多詐而無情實，始與臣等建此議，今皆倍之，不忠。」上問弘。弘謝曰：「夫知臣者以臣為忠，不知臣者以臣為不忠。」上然弘言。左右幸臣每毀弘，上益厚遇之。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-112-pingjin:m004-0000","start":0,"end":1,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0026","start":26,"end":27,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0036","start":36,"end":38,"surface":"后母","kind":"person","person_id":"fyw_e6a_8dl","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0070","start":70,"end":72,"surface":"天子","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0097","start":97,"end":98,"surface":"上","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0111","start":111,"end":112,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0130","start":130,"end":132,"surface":"汲黯","kind":"person","person_id":"fmh_dmt_cql","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0135","start":135,"end":137,"surface":"汲黯","kind":"person","person_id":"fmh_dmt_cql","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0141","start":141,"end":142,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0146","start":146,"end":148,"surface":"天子","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0171","start":171,"end":172,"surface":"上","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0180","start":180,"end":181,"surf