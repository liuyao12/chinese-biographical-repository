ention_ids":["c-nanqishu-058-southern-and-eastern-complete:p032:m0141"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-058-southern-and-eastern-complete:p032:m0154","mention_ids":["c-nanqishu-058-southern-and-eastern-complete:p032:m0154"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-058-southern-and-eastern-complete:p032:m0208","mention_ids":["c-nanqishu-058-southern-and-eastern-complete:p032:m0208"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-058-southern-and-eastern-complete:p032:m0239","mention_ids":["c-nanqishu-058-southern-and-eastern-complete:p032:m0239"],"kind":"paragraph"}],"mention_count":7,"duplicate_mention_count":0,"paragraph_occurrence_count":7,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"7處獨立位置，7個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"},{"source_id":"s-nanqishu-040-ziliang-ws2272748","work_id":"w-nanqishu","book_id":"b-nanqishu-040","chapter_id":"c-nanqishu-040-ziliang","raw_mention_count":1,"mention_ids":["c-nanqishu-040-ziliang:p015:m0160"],"paragraph_ids":["c-nanqishu-040-ziliang:p015"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-nanqishu-040-ziliang:p015:m0160","mention_ids":["c-nanqishu-040-ziliang:p015:m0160"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-nanqishu-058-southern-and-eastern-complete-ws2638629"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-nanqishu-058-southern-and-eastern-complete:source_review32-0","kind":"source_review","person_id":"gy7_lbd_q1p","source_quote":"交州斗絕海島，控帶外國，故恃險數不賓。宋泰始初，刺史張牧卒，交趾人李長仁殺牧北來部曲，據交州叛，數年病死，從弟叔獻嗣事，號令未行，遣使求刺史。宋朝以南海太守沈煥為交州刺史，以叔獻為煥寧遠司馬、武平新昌二郡太守。叔獻得朝命，人情服從，遂發兵守險不納煥，煥停鬱林病卒。太祖建元元年，仍以叔獻為交州刺史，就安慰之。叔獻受命，既而斷割外國，貢獻寡少。世祖欲討之，永明三年，以司農劉楷為交州刺史，發南康、廬陵、始興郡兵征交州。叔獻聞之，遣使願更申數年，獻十二隊純銀兜鍪及孔雀毦，世祖不許。叔獻懼為楷所襲，間道自湘川還朝。","reading":"交州李長仁據州及從弟叔獻承事，張牧、沈煥、劉楷官與死事別記，齊本紀核劉楷永明三年。","note":"交州李長仁據州及從弟叔獻承事，張牧、沈煥、劉楷官與死事別記，齊本紀核劉楷永明三年。","paragraph_id":"c-nanqishu-058-southern-and-eastern-complete:p032","start_codepoint":0,"end_codepoint":255,"human_reviewed":false,"chapter_id":"c-nanqishu-058-southern-and-eastern-complete","source_id":"s-nanqishu-058-southern-and-eastern-complete-ws2638629"},{"id":"c-nanqishu-058-southern-and-eastern-complete:variant_review32-53","kind":"variant_review","person_id":"gy7_lbd_q1p","source_quote":"從弟叔獻嗣事","reading":"原語從弟，父系中間人和確切親等無據。永明三年任劉楷在本紀可證，殿本永明元年照錄。","note":"原語從弟，父系中間人和確切親等無據。永明三年任劉楷在本紀可證，殿本永明元年照錄。","paragraph_id":"c-nanqishu-058-southern-and-eastern-complete:p032","start_codepoint":53,"end_codepoint":59,"human_reviewed":false,"chapter_id":"c-nanqishu-058-southern-and-eastern-complete","source_id":"s-nanqishu-058-southern-and-eastern-complete-ws2638629"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-040-ziliang:p015:m0160","surface":"叔獻","start":160,"end":162,"person_id":"gy7_lbd_q1p","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-nanqishu-040-ziliang:p015","chapter_id":"c-nanqishu-040-ziliang"},{"id":"c-nanqishu-058-southern-and-eastern-complete:p032:m0055","start":55,"end":57,"surface":"叔獻","kind":"person","person_id":"gy7_