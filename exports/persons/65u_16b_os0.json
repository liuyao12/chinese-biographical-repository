al_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-060-heqi:line015:m0052","start":52,"end":54,"surface":"金奇","kind":"person","person_id":"65u_16b_os0","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-060-heqi:line015","chapter_id":"c-sanguozhi-060-heqi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-060-heqi:line015","text":"　　十三年，遷威武中郎將，討丹陽黟、歙。時武強、葉鄉、東陽、豐浦四鄉先降，齊表言以葉鄉為始新縣。而歙賊帥金奇萬戶屯安勒山，毛甘萬戶屯烏聊山，黟帥陳僕，祖山等二萬戶屯林歷山。林歷山四面壁立，高數十丈，逕路危狹，不容刀楯，賊臨高下石，不可得攻。軍住經日，將吏患之。齊身出周行，觀視形便，陰募輕捷士，為作鐵弋，密於隱險賊所不備處，以戈拓斬山為緣道，夜令潛上，乃多縣布以援下人，得上百數人，四面流布，俱鳴鼓角，齊勒兵待之。賊夜聞鼓聲四合，謂大軍悉已得上，驚懼惑亂，不知所為，守路備險者，皆走還依眾。大軍因是得上，大破僕等，其餘皆降，凡斬首七千。齊復表分歙為新定；黎陽、休陽。並黟、歙凡六縣。權遂割為新都郡，齊為太守，立府於始新，加偏將軍。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-060-heqi:line015:m0037","start":37,"end":38,"surface":"齊","kind":"person","person_id":"wuz_dky_0ki","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-heqi:line015:m0052","start":52,"end":54,"surface":"金奇","kind":"person","person_id":"65u_16b_os0","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-heqi:line015:m0061","start":61,"end":63,"surface":"毛甘","kind":"person","person_id":"2ea_7dr_syz","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-heqi:line015:m0072","start":72,"end":74,"surface":"陳僕","kind":"person","person_id":"0j2_agp_0fz","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-heqi:line015:m0075","start":75,"end":77,"surface":"祖山","kind":"person","person_id":"rt3_xex_kan","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文