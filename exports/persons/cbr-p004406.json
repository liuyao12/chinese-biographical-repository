{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004406","identity_policy":"contextual_provisional","person_ids":["cbr-p004406"],"persons":[{"id":"cbr-p004406","label":"公甫家相室未名（平原君虞卿列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"其相室","mention_ids":["c-shiji-076-pingyu:m014-0114"]}],"evidence":[{"mention_id":"c-shiji-076-pingyu:m014-0114","chapter_id":"c-shiji-076-pingyu","paragraph_id":"c-shiji-076-pingyu:p014","quote":"其相室"}]}],"mentions":[{"id":"c-shiji-076-pingyu:m014-0114","start":114,"end":117,"surface":"其相室","kind":"person","person_id":"cbr-p004406","status":"contextual_provisional","paragraph_id":"c-shiji-076-pingyu:p014","chapter_id":"c-shiji-076-pingyu"}],"relations":[],"title_holdings":[{"id":"th-shiji076-013","person_id":"cbr-p004406","title":"相室","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-076-pingyu","source_id":"s-shiji-076-pingyu","paragraph_id":"c-shiji-076-pingyu:p014","quote":"趙王計未定，樓緩從秦來，趙王與樓緩計之，曰：「予秦地何如毋予，孰吉？」緩辭讓曰：「此非臣之所能知也。」王曰：「雖然，試言公之私。」樓緩對曰：「王亦聞夫公甫文伯母乎？公甫文伯仕於魯，病死，女子爲自殺於房中者二人。其母聞之，弗哭也。其相室曰：『焉有子死而弗哭者乎？』其母曰：『孔子，賢人也，逐於魯，而是人不隨也。今死而婦人爲之自殺者二人，若是者必其於長者薄而於婦人厚也。』故從母言之，是爲賢母；從妻言之，是必不免爲妒妻。故其言一也，言者異則人心變矣。今臣新從秦來而言勿予，則非計也；言予之，恐王以臣爲爲秦也：故不敢對。使臣得爲大王計，不如予之。」王曰：「諾。」"}],"attestations":[{"id":"th-shiji076-013:a001","paragraph_id":"c-shiji-076-pingyu:p014","start":115,"end":117,"surface":"相室","person_mention_id":"c-shiji-076-pingyu:m014-0114","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授官、爵位、門下用稱與敘事稱呼分存；未知起訖不補，死亡、亡去或爵印評語不直接終止所有稱號。三去相三復位不合成單一任期，擬爲平原請封而不聽不當實授。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji076-033","person_id":"cbr-p004406","scope":"same_chapter","chapter_ids":["c-shiji-07