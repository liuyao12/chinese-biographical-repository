rmalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-007-wanglingbin:p005","text":"時高祖於鐘山造大愛敬寺，騫舊墅在寺側，有良田八十餘頃，卽晉丞相王導賜田也。高祖遣主書宣旨就騫求市，欲以施寺。騫答旨云：「此田不賣；若是敕取，所不敢言。」酬對又脫略。高祖怒，遂付市評田價，以直逼還之。由是忤旨，出爲吳興太守。在郡臥疾不視事。徵還，復爲度支尚書，加給事中，領射聲校尉。以母憂去職。","mentions":[{"id":"c-liangshu-007-wanglingbin:p005:m0012","surface":"騫","start":12,"end":13,"person_id":"7r6_k52_qji_ABAAAAEAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-liangshu-007-wanglingbin:p005:m0031","surface":"王導","start":31,"end":33,"person_id":"7r6_k52_qji_ABAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-liangshu-007-wanglingbin:p005:m0045","surface":"騫","start":45,"end":46,"person_id":"7r6_k52_qji_ABAAAAEAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-liangshu-007-wanglingbin:p005:m0054","surface":"騫","start":54,"end":55,"person_id":"7r6_k52_qji_ABAAAAEAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":1566494,"source_layer":"received_biography","first_line":43,"last_line":43,"line_start":2,"line_end":148,"raw_start":2266,"raw_end":2412,"raw_character_offsets":[2266,2267,2268,2269,2270,2271,2272,2273,2274,2275,2276,2277,2278,2279,2280,2281,2282,2283,2284,2285,2286,2287,2288,2289,2290,2291,2292,2293,2294,2295,2296,2297,2298,2299,2300,2301,2302,2303,2304,2305,2306,2307,2308,2309,2310,2311,2312,2313,2314,2315,2316,2317,2318,2319,2320,2321,2322,2323,2324,2325,2326,2327,2328,2329,2330,2331,2332,2333,2334,2335,2336,2337,2338,2339,2340,2341,2342,2343,2344,2345,2346,2347,2348,2349,2350,2351,2352,2353,2354,2355,2356,2357,2358,2359,2360,2361,2362,2363,2364,2365,2366,2367,2368,2369,2370,2371,2372,2373,2374,2375,2376,2377,2378,2379,2380,2381,23