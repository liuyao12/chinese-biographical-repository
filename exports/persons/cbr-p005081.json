birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji091-022","person_id":"cbr-p005081","scope":"same_chapter","chapter_ids":["c-shiji-091-qingbu"],"status":"contextual_provisional","rationale":"按本段明示姓名及局部敘事承接；布與兩王號按英布主線暫接。番君與長沙哀王分候選，所幸姬不與番君女合併；皋陶引古疑問不作祖先定論。","reviewer":"Codex（AI 代理）","surfaces":["楚使者"],"evidence":[{"paragraph_id":"c-shiji-091-qingbu:p008","quote":"楚使者在，方急責英布發兵，舍傳舍。隨何直入，坐楚使者上坐，曰：「九江王已歸漢，楚何以得發兵？」布愕然。楚使者起。何因說布曰：「事已搆，可遂殺楚使者，無使歸，而疾走漢并力。」布曰：「如使者教，因起兵而擊之耳。」於是殺使者，因起兵而攻楚。楚使項聲、龍且攻淮南，項王留而攻下邑。數月，龍且擊淮南，破布軍。布欲引兵走漢，恐楚王殺之，故閒行與何俱歸漢。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-091-qingbu:p008","text":"楚使者在，方急責英布發兵，舍傳舍。隨何直入，坐楚使者上坐，曰：「九江王已歸漢，楚何以得發兵？」布愕然。楚使者起。何因說布曰：「事已搆，可遂殺楚使者，無使歸，而疾走漢并力。」布曰：「如使者教，因起兵而擊之耳。」於是殺使者，因起兵而攻楚。楚使項聲、龍且攻淮南，項王留而攻下邑。數月，龍且擊淮南，破布軍。布欲引兵走漢，恐楚王殺之，故閒行與何俱歸漢。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-091-qingbu:m008-0000","start":0,"end":3,"surface":"楚使者","kind":"person","person_id":"cbr-p005081","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m008-0008","start":8,"end":10,"surface":"英布","kind":"person","person_id":"cbr-p005060","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m008-0017","start":17,"end":19,"surface":"隨何","kind":"person","person_id":"cbr-p005087","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m008-0023","start":23,"end":26,"surface":"楚使者","kind":"person","person_id":"cbr-p005081","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m008-0032","start":32,"end":35,"surface":"九江王","kind":"person","person_id":"cbr-p005060","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m008-0047","start":47,"end":48,"surface":"布","kind":"person","person_id":"cbr-p005060","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m008-0051","start":51,"end":54,"surface":"楚使者","kind":"person","person_id":"cbr-p005081","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m008-0056","start":56,"end":57,