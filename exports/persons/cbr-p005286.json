uang","paragraph_id":"c-shiji-095-fankuang:p010","quote":"孝惠六年，樊噲卒，謚為武侯。子伉代侯。而伉母呂須亦為臨光侯，高后時用事專權，大臣盡畏之。伉代侯九歲，高后崩。大臣誅諸呂、呂須婘屬，因誅伉。舞陽侯中絕數月。孝文帝既立，乃復封噲他庶子市人為舞陽侯，復故爵邑。市人立二十九歲卒，謚為荒侯。子他廣代侯。六歲，侯家舍人得罪他廣，怨之，乃上書曰：「荒侯市人病不能為人，令其夫人與其弟亂而生他廣，他廣實非荒侯子，不當代後。」詔下吏。孝景中六年，他廣奪侯為庶人，國除。"}],"qualifiers":{"source_term":"伉母呂須","historicity":"historical_tradition"},"interpretation_note":"按原文明示親屬保存，不由繼侯推父子，不補同母、排行數字或闕代。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-095-fankuang:m007-0006","start":6,"end":8,"surface":"呂須","kind":"person","person_id":"vqw_ylp_5mq","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p007","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:m010-0022","start":22,"end":24,"surface":"呂須","kind":"person","person_id":"vqw_ylp_5mq","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p010","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:m010-0060","start":60,"end":62,"surface":"呂須","kind":"person","person_id":"vqw_ylp_5mq","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p010","chapter_id":"c-shiji-095-fankuang"}],"relations":[{"id":"a-shiji095-001","subject_person_id":"vqw_ylp_5mq","predicate":"sister","object_person_id":"mrj_1jl_2tk","status":"source_attested","evidence":[{"chapter_id":"c-shiji-095-fankuang","source_id":"s-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p007","quote":"噲以呂后女弟呂須為婦，生子伉，故其比諸將最親。"}],"qualifiers":{"source_term":"呂后女弟呂須","historicity":"historical_tradition","relative_birth_order":{"older_person_id":"mrj_1jl_2tk","younger_person_id":"vqw_ylp_5mq","operator":"lt","older_ordinal":null,"younger_ordinal":null,"scope":"siblings","interpretation_status":"source_attested","comparison_basis":"birth_chronology"}},"interpretation_note":"按原文明示親屬保存，不由繼侯推父子，不補同母、排行數字或闕代。","review