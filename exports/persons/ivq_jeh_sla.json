{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"ivq_jeh_sla","canonical_person_id":"ivq_jeh_sla","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["ivq_jeh_sla"],"persons":[{"id":"ivq_jeh_sla","label":"王瑩母（梁書卷十六未名）","status":"active","historicity":"historical_tradition","aliases":[],"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-016","chapter_id":"c-liangshu-016-wangying","source_id":"s-liangshu-016-wangying-ws1508503","paragraph_id":"c-liangshu-016-wangying:p003","quote":"母","kind":"person_reference","mention_id":"c-liangshu-016-wangying:p003:r0097"}],"review":"ai_provisional","identity_note":"梁書十六記王瑩丁母憂；王懋為其父，未見此母名。"}],"source_mention_summary":[],"most_mentioned_source_ids":[],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[],"relations":[],"title_holdings":[],"address_assertions":[],"person_references":[{"id":"c-liangshu-016-wangying:p003:r0097","paragraph_id":"c-liangshu-016-wangying:p003","start":97,"end":98,"surface":"母","person_id":"ivq_jeh_sla","referent_role":"third_person","quote":"齊高帝爲驃騎將軍，引爲從事中郎。頃之，出爲義興太守，代謝超宗。超宗去郡，與瑩交惡，旣還，間瑩於懋。懋言之於朝廷，以瑩供養不足，坐失郡廢棄。久之，爲前軍諮議參軍，中書侍郎，大司馬從事中郎，未拜，丁母憂。服闋，爲給事黃門郎，出爲宣城太守，遷爲驃騎長史。復爲黃門侍郎、司馬、太子中庶子，仍遷侍中，父憂去職。服闋，復爲侍中，領射聲校尉，又爲冠軍將軍、東陽太守。居郡有惠政，遷吳興太守。明帝勤憂庶政，瑩頻處二郡，皆有能名。甚見褒美。還爲太子詹事、中領軍。","note":"依本段敘事、稱謂及語者受者定。","chapter_id":"c-liangshu-016-wangying","book_id":"b-liangshu-016","work_id":"w-liangshu","source_id":"s-liangshu-016-wangying-ws1508503"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-016-wangying:p003","text":"齊高帝爲驃騎將軍，引爲從事中郎。頃之，出爲義興太守，代謝超宗。超宗去郡，與瑩交惡，旣還，間瑩於懋。懋言之於朝廷，以瑩供養不足，坐失郡廢棄。久之，爲前軍諮議參軍，中書侍郎，大司馬從事中郎，未拜，丁母憂。服闋，爲給事黃門郎，出爲宣城太守，遷爲驃騎長史。復爲黃門侍郎、司馬、太子中庶子，仍遷侍中，父憂去職。服闋，復爲侍中，領射聲校尉，又爲冠軍將軍、東陽太守。居郡有惠政，遷吳興太守。明帝勤憂庶政，瑩頻處二郡，皆有能名。甚見褒美。還爲太子詹事、中領軍。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":51,"last_line":51,"raw_start":3247,"raw_end":3469,"raw_character_offsets":[3247,3248,3249,3250,3251,3252,3253,3254,3255,3256,3257,3258,3259,3260,3261,3262,3263,3264,3265,3266,3267,3268,3269,3270,3271,3272,3273,3274,3275,3276,3277,3278,3279,3280,3281,3282,3283,3284,3285,3286,3287,3288,3289,3290,3291,3292,3293,3294,3295,3296,3297,3298,3299,3300,3301,3302,3303,3304,3305,3306,3307,3308,3309,3310,3311,3312,3313,3314,3315,3316,3317,3318,3319,3320,3321,3322,3323,3324,3325,3326,3327,3328,3329,3330,3331,3332,3333,3334,3335,3336,3337,3338,3339,3340,3341,3342,3343,3344,3345,3346,3347,3348,3349,3350,3351,3352,3353,3354,3355,3356,3357,3358,3359,3360,3361,3362,3363,3364,3365,3366,3367,3368,3369,3370,3371,3372,3373,3374,3375,3376,3377,3378,3379,3380,3381,3382,3383,3384,3385,3386,3387,3388,3389,3390,3391,3392,3393,3394,3395,3396,3397,3398,3399,3400,3401,3402,3403,3404,3405,3406,3407,3408,3409,3410,3411,3412,3413,3414,3415,3416,3417,3418,3419,3420,3421,3422,3423,3424,3425,3426,3427,3428,3429,3430,3431,3432,3433,3434,3435,3436,3437,3438,3439,3440,3441,3442,3443,3444,3445,3446,3447,3448,3449,3450,3451,3452,3453,3454,3455,3456,3457,3458,3459,3460,3461,3462,3463,3464,3465,3466,3467,3468],"revision_id":1508503},"mentions":[{"id":"c-liangshu-016-wangying:p003:m0027","start":27,"end":30,"surface":"謝超宗","kind":"person","person_id":"aa6_83c_juy_CDAABA","status":"contextual_provisional"},{"id":"c-liangshu