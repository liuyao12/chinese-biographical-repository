{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"p1g_3h6_97x","canonical_person_id":"p1g_3h6_97x","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["p1g_3h6_97x"],"persons":[{"id":"p1g_3h6_97x","label":"茄（白起王翦列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"趙裨將茄","mention_ids":["c-shiji-073-baiwang:m004-0064"]}],"evidence":[{"mention_id":"c-shiji-073-baiwang:m004-0064","chapter_id":"c-shiji-073-baiwang","paragraph_id":"c-shiji-073-baiwang:p004","quote":"趙裨將茄"}]}],"source_mention_summary":[{"source_id":"s-shiji-073-baiwang","work_id":"w-shiji","book_id":"b-shiji-073","chapter_id":"c-shiji-073-baiwang","raw_mention_count":1,"mention_ids":["c-shiji-073-baiwang:m004-0064"],"paragraph_ids":["c-shiji-073-baiwang:p004"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-shiji-073-baiwang:m004-0064","mention_ids":["c-shiji-073-baiwang:m004-0064"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-shiji-073-baiwang"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-shiji073-001","person_id":"p1g_3h6_97x","event_type":"death","status":"source_attested","date_expression":"四十七年","source_term":"斬趙裨將茄","evidence":[{"chapter_id":"c-shiji-073-baiwang","source_id":"s-shiji-073-baiwang","paragraph_id":"c-shiji-073-baiwang:p004","person_mention_id":"c-shiji-073-baiwang:m004-0064","quote_passage_ref":"data/corpus/shiji/073.json"}],"interpretation_note":"僅保存具名者明示死亡；被虜、王降、病及群體死亡不轉為個人死亡。秦二世時皆已死是已死陳述，不當兩人同年或秦二世年內死亡；原月日不轉公曆。","reviewer":"Codex（AI 代理）","human_reviewed":false,"normalized_date":{"era":"BCE","era_year":260,"year":-259,"year_numbering":"astronomical","precision":"year","status":"editorial_provisional","original_quote":"四十七年，秦使左庶長王龁攻韓，取上黨。上黨民走趙。趙軍長平，以按據上黨民。四月，龁因攻趙。趙使廉頗將。趙軍士卒犯秦斥兵，秦斥兵斬趙裨將茄。六月，陷趙軍，取二鄣四尉。七月，趙軍筑壘壁而守之。秦又攻其壘，取二尉，敗其陣，奪西壘壁。廉頗堅壁以待秦，秦數挑戰，趙兵不出。趙王數以為讓。而秦相應侯又使人行千金於趙為反閒，曰：「秦之所惡，獨畏馬服子趙括將耳，廉頗易與，且降矣。」趙王既怒廉頗軍多失亡，軍數敗，又反堅壁不敢戰，而又聞秦反閒之言，因使趙括代廉頗將以擊秦。秦聞馬服子將，乃陰使武安君白起為上將軍。而王龁為尉裨將，令軍中有敢泄武安君將者斬。趙括至，則出兵擊秦軍。秦軍詳敗而走，張二奇兵以劫之。趙軍逐勝，追造秦壁。壁堅拒不得入，而秦奇兵二萬五千人絕趙軍後，又一軍五千騎絕趙壁閒，趙軍分而為二，糧道絕。而秦出輕兵擊之。趙戰不利，因筑壁堅守，以待救至。秦王聞趙食道絕，王自之河內，賜民爵各一級，發年十五以上悉詣長平，遮絕趙救及糧食。","evidence":[{"chapter_id":"c-shiji-073-baiwang","source_id":"s-shiji-073-baiwang","paragraph_id":"c-shiji-073-baiwang:p004","person_mention_id":"c-shiji-073-baiwang:m004-0064","quote_passage_ref":"data/corpus/shiji/073.json"}],"references":[{"title":"〈六國年表〉秦紀年欄","url":"https://zh.wikisource.org/w/index.php?title=史記/卷015&oldid=2607002","quote":"四十七。白起破趙長平，殺卒四十五萬。","scope":"received_regnal_year_attestation","image_verified":false,"table_cell_id":"shiji-015-r217-c02"},{"title":"〈六國年表〉數位年欄","url":"https://zh.wikisource.org/w/index.php?title=史記/卷015&oldid=2607002","quote":"260","scope":"digital_editorial_regnal_year_equivalence_only","image_verified":false,"table_cell_id":"shiji-015-r217-c00"}],"rationale":"本篇四十七年長平戰事中趙裨將茄被斬，年表秦四十七與數位年欄對照前260年；年表沒有單獨記茄，不冒作同名死亡平行事件。僅為原紀年之年尺度數字對照，不把原十一月或四月當公曆月，不指定公曆日期，未核底本影像及曆表。","reviewer":"Codex（AI 代理）","human_reviewed":false}}],"mentions":[{"id":"c-shiji-073-baiwang:m004-0064","start":64,"end":68,"surface":"趙裨將茄","kind":"person","p