","reviewer":"Codex（AI 代理）","rationale":"依長平敘事明示姓名、替將次序與局部回指暫接；王龁龁、趙括馬服子與白起武安君按本篇明示。應侯不補未見姓名，趙王接前段趙孝成王、秦王接開篇秦昭王，各限此敘事。反閒廉頗且降的話語及趙卒數保留來源層，不作已確證事實或跨篇調和。","surfaces":["趙裨將茄"],"evidence":[{"paragraph_id":"c-shiji-073-baiwang:p004","quote_passage_ref":"data/corpus/shiji/073.json"}]}],"equivalence_decisions":[],"sources":[{"chapter_id":"c-shiji-073-baiwang","work_id":"w-shiji","book_id":"b-shiji-073","source_id":"s-shiji-073-baiwang","source_ref":"corpus/shiji/073.json"}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true},"passage_refs":[{"chapter":"corpus/shiji/073.json","id":"c-shiji-073-baiwang:p004"}]}
