{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"s5w_nth_ege","canonical_person_id":"s5w_nth_ege","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["s5w_nth_ege"],"persons":[{"id":"s5w_nth_ege","label":"夏侯長〔郗鑒將軍〕","status":"active","historicity":"historical_tradition","aliases":[{"surface":"夏侯長","mention_ids":["c-jinshu-067-xijian:line080:m0325"]}],"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-067","chapter_id":"c-jinshu-067-xijian","source_id":"s-jinshu-067-xijian","paragraph_id":"c-jinshu-067-xijian:line080","mention_id":"c-jinshu-067-xijian:line080:m0325","quote":"夏侯長"}],"identity_note":"郗鑒遣將軍夏侯長間行告溫嶠。","review":"ai_provisional"}],"source_mention_summary":[{"source_id":"s-jinshu-067-xijian","work_id":"w-jinshu","book_id":"b-jinshu-067","chapter_id":"c-jinshu-067-xijian","raw_mention_count":1,"mention_ids":["c-jinshu-067-xijian:line080:m0325"],"paragraph_ids":["c-jinshu-067-xijian:line080"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-067-xijian:line080:m0325","mention_ids":["c-jinshu-067-xijian:line080:m0325"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-067-xijian"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-067-xijian:line080:m0325","start":325,"end":328,"surface":"夏侯長","kind":"person","person_id":"s5w_nth_ege","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-067-xijian:line080","chapter_id":"c-jinshu-067-xijian"}],"relations":[],"title_holdings":[{"id":"th-w067-jian-30","person_id":"s5w_nth_ege","title":"將軍","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-067","chapter_id":"c-jinshu-067-xijian","source_id":"s-jinshu-067-xijian","paragraph_id":"c-jinshu-067-xijian:line080","quote":"咸和初，領徐州刺史。及祖約、蘇峻反，鑒聞難，便欲率所領東赴。詔以北寇不許。於是遣司馬劉矩領三千人宿衛京都。尋而王師敗績，矩遂退還。中書令庾亮宣太后口詔，進鑒為司空。鑒去賊密邇，城孤糧絕，人情業業，莫有固志，奉詔流涕，設壇場，刑白馬，大誓三軍曰：「賊臣祖約、蘇峻不恭天命，不畏王誅，凶戾肆逆，干國之紀，陵汩五常，侮弄神器，遂制脅幽主，拔本塞原，殘害忠良，禍虐黎庶，使天地神祇靡所依歸。是以率土怨酷，兆庶泣血，咸願奉辭罰罪，以除元惡。昔戎狄泯周，齊桓糾盟；董卓陵漢，群后致討。義存君親，古今一也。今主上幽危，百姓倒懸，忠臣正士志存報國。凡我同盟，既盟之後，戮力一心，以救社稷。若二寇不梟，義無偷安。有渝此盟，明神殛之！」鑒登壇慷慨，三軍爭為用命。乃遣將軍夏侯長等間行，謂平南將軍溫嶠曰：「今賊謀欲挾天子東入會稽，宜先立營壘，屯據要害，既防其越逸，又斷賊糧運，然後靜鎮京口，清壁以待賊。賊攻城不拔，野無所掠，東道既斷，糧運自絕，不過百日，必自潰矣。」嶠深以為然。","person_mention_id":"c-jinshu-067-xijian:line080:m0325"}],"attestations":[{"id":"th-w043-jian-30:a","paragraph_id":"c-jinshu-067-xijian:line080","start":323,"end":325,"surface":"將軍","person_mention_id":"c-jinshu-067-xijian:line080:m0325","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-067-xijian:line080","text":"咸和初，領徐州刺史。及祖約、蘇峻反，鑒聞難，便欲率所領東赴。詔以北寇不許。於是遣司馬劉矩領三千人宿衛京都。尋而王師敗績，矩遂退還。中書令庾亮宣太后口詔，進鑒為司空。鑒去賊密邇，城孤糧絕，人情業業，莫有固志，奉詔流涕，設壇場，刑白馬，大誓三軍曰：「賊臣祖約、蘇峻不恭天命，不畏王誅，凶戾肆逆，干國之紀，陵汩五常，侮弄神器，遂制脅幽主，拔本塞原，殘害忠良，禍虐黎庶，使天地神祇靡所依歸。是以率土怨酷，兆庶泣血，咸願奉辭罰罪，以除元惡。昔戎狄泯周，齊桓糾盟；董卓陵漢，群后致討。義存君親，古今一也。今主上幽危，百姓倒懸，忠臣正士志存報國。凡我同盟，既盟之後，戮力一心，以救社稷。若二寇不梟，義無偷安。有渝此盟，明神殛之！」鑒登壇慷慨，三軍爭為用命。乃遣將軍夏侯長等間行，謂平南將軍溫嶠曰：「今賊謀欲挾天子東入會稽，宜先立營壘，屯據要害，既防其越逸，又斷賊糧運，然後靜鎮京口，清壁以待賊。賊攻城不拔，野無所掠，東道既斷，糧運自絕，不過百日，必自潰矣。」嶠深以為然。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-067-xijian:line080:m0011","start":11,"end":13,"surface":"祖約","kind":"person","person_id":"024_3ec_48b","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-xijian:line080:m0014","start":14,"end":16,"surface":"蘇峻","kind":"person","person_id":"lrg_cze_g1l","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-xijian:line080:m0018","start":18,"end":19,"surface":"鑒","kind":"person","person_id":"6lr_zci_i0j","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-xijian:line080:m0042","start":42,"end":44,"surface":"劉矩","kind":"person","person_id":"0mt_gpf_b45","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-xijian:line080:m0060","start":60,"end":61,"surface":"矩","kind":"person","person_id":"0mt_gpf_b45","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-xijian:line080:m0068","start":68,"end":70,"surface":"庾亮","kind":"person","person_id":"4qr_wrk_3vd_B","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-xijian:line080:m0077","start":77,"end":78,"surface":"鑒","kind":"person","person_id":"6lr_zci_i0j","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-xijian:line080:m0082","start":82,"end":83,"surface":"鑒","kind":"person","person_id":"6lr_zci_i0j","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-xijian:line080:m0125","start":125,"end":127,"surface":"