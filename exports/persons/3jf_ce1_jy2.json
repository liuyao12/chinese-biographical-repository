c-shiji-123-dayuan:p018","quote":"昆莫"},{"mention_id":"c-shiji-123-dayuan:m025-0027","chapter_id":"c-shiji-123-dayuan","paragraph_id":"c-shiji-123-dayuan:p025","quote":"昆莫"},{"mention_id":"c-shiji-123-dayuan:m025-0041","chapter_id":"c-shiji-123-dayuan","paragraph_id":"c-shiji-123-dayuan:p025","quote":"昆莫"},{"mention_id":"c-shiji-123-dayuan:m025-0044","chapter_id":"c-shiji-123-dayuan","paragraph_id":"c-shiji-123-dayuan:p025","quote":"昆莫"},{"mention_id":"c-shiji-123-dayuan:m025-0052","chapter_id":"c-shiji-123-dayuan","paragraph_id":"c-shiji-123-dayuan:p025","quote":"昆莫"}],"family_path":{"connection":"father","generation_distance":1,"parent_person_id":"3jf_ce1_jy2","status":"contextual_provisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-123-dayuan","source_id":"s-shiji123-dayuan","paragraph_id":"c-shiji-123-dayuan:p017","quote":"是後天子數問騫大夏之屬。騫既失侯，因言曰：「臣居匈奴中，聞烏孫王號昆莫，昆莫之父，匈奴西邊小國也。匈奴攻殺其父，而昆莫生棄於野。烏嗛肉蜚其上，狼往乳之。單于怪以為神，而收長之。及壯，使將兵，數有功，單于復以其父之民予昆莫，令長守於西（城）［域］。昆莫收養其民，攻旁小邑，控弦數萬，習攻戰。單于死，昆莫乃率其眾遠徙，中立，不肯朝會匈奴。匈奴遣奇兵擊，不勝，以為神而遠之，因羈屬之，不大攻。今單于新困於漢，而故渾邪地空無人。蠻夷俗貪漢財物，今誠以此時而厚幣賂烏孫，招以益東，居故渾邪之地，與漢結昆弟，其勢宜聽，聽則是斷匈奴右臂也。既連烏孫，自其西大夏之屬皆可招來而為外臣。」天子以為然，拜騫為中郎將，將三百人，馬各二匹，牛羊以萬數，齎金幣帛直數千巨萬，多持節副使，道可使，使遺之他旁國。"}],"source_assertion_id":"a-shiji123-004","interpretation_note":"依本篇明示父子接家族根；未名保持未名，分支字母不表示出生排行，生母與婚姻另存。","reviewer":"Codex（AI 代理）"}}],"source_mention_summary":[{"source_id":"s-shiji123-dayuan","work_id":"w-shiji","book_id":"b-shiji-123","chapter_id":"c-shiji-123-dayuan","mention_count":3,"mention_ids":["c-shiji-123-dayuan:m017-0036","c-shiji-123-dayuan:m017-0053","c-shiji-123-dayuan:m017-0103"],"paragraph_ids":["c-shiji-123-dayuan:p017"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji123-dayuan"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family