rt":58,"end":62,"surface":"豫章內史","id":"th-wyd-qi036-chao-40:a1","person_mention_id":"c-nanqishu-036-xiechaozong-wyd:p017:m0062","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"虞悰於此處具此官稱。","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null},{"id":"th-nanshi019-chaozong-200-196","person_id":"lo2_l7i_fa4","title":"豫章內史","kind":"office","mode":"attestation","attestations":[{"id":"th-nanshi019-chaozong-200-196:a","paragraph_id":"c-nanshi-019-chaozong:p006","start":196,"end":200,"surface":"豫章內史","person_mention_id":"c-nanshi-019-chaozong:p006:m0200","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-019","chapter_id":"c-nanshi-019-chaozong","source_id":"s-nanshi-019-chaozong-ws1531762","paragraph_id":"c-nanshi-019-chaozong:p006","quote":"武帝即位，使掌國史。除竟陵王征北諮議，領記室，愈不得志。超宗爲子娶張敬兒女爲婦，帝甚疑之。及敬兒誅，超宗謂丹陽尹李安人曰：「往年殺韓信，今年殺彭越，君欲何計？」安人具啟之。上積懷超宗輕慢，使兼中丞袁彖奏超宗請付廷尉。武帝雖可其奏，以彖言辭依違，使左丞王逡之奏彖「輕文略奏，撓法容非，請免彖所居官」。詔「彖匿情欺國，愛朋罔主，免官，禁錮十年」。超宗下廷尉，一宿發白皓首。詔徙越嶲，行至豫章，上敕豫章內史虞悰賜盡，勿傷其形骸。","person_mention_id":"c-nanshi-019-chaozong:p006:m0200"}],"status":"source_attested","interpretation_note":"本句所載官名，任期無確切年月。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"person_references":[{"start":196,"end":200,"surface":"豫章內史","id":"c-nanshi-019-chaozong:p006:r0196","paragraph_id":"c-nanshi-019-chaozong:p006","person_id":"lo2_l7i_fa4","referent_role":"third_person","quote":"武帝即位，使掌國史。除竟陵王征北諮議，領記室，愈不得志。超宗爲子娶張敬兒女爲婦，帝甚疑之。及敬兒誅，超宗謂丹陽尹李安人曰：「往年殺韓信，今年殺彭越，君欲何計？」安人具啟之。上積懷超宗輕慢，使兼中丞袁彖奏超宗請付廷尉。武帝雖可其奏，以彖言辭依違，使左丞王逡之奏彖「輕文略奏，撓法容非，請免彖所居官」。詔「彖匿情欺國，愛朋罔主，免官，禁錮十年」。超宗下廷尉，一宿發白皓首。詔徙越嶲，行至豫章，上敕豫章內史虞悰賜盡，勿傷其形骸。","note":"本句按敘述視點回指虞悰。","chapter