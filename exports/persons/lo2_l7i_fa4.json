019-chaozong:p006:m0200"}],"status":"source_attested","interpretation_note":"本句所載官名，任期無確切年月。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"person_references":[{"start":196,"end":200,"surface":"豫章內史","id":"c-nanshi-019-chaozong:p006:r0196","paragraph_id":"c-nanshi-019-chaozong:p006","person_id":"lo2_l7i_fa4","referent_role":"third_person","quote":"武帝即位，使掌國史。除竟陵王征北諮議，領記室，愈不得志。超宗爲子娶張敬兒女爲婦，帝甚疑之。及敬兒誅，超宗謂丹陽尹李安人曰：「往年殺韓信，今年殺彭越，君欲何計？」安人具啟之。上積懷超宗輕慢，使兼中丞袁彖奏超宗請付廷尉。武帝雖可其奏，以彖言辭依違，使左丞王逡之奏彖「輕文略奏，撓法容非，請免彖所居官」。詔「彖匿情欺國，愛朋罔主，免官，禁錮十年」。超宗下廷尉，一宿發白皓首。詔徙越嶲，行至豫章，上敕豫章內史虞悰賜盡，勿傷其形骸。","note":"本句按敘述視點回指虞悰。","chapter_id":"c-nanshi-019-chaozong","book_id":"b-nanshi-019","work_id":"w-nanshi","source_id":"s-nanshi-019-chaozong-ws1531762"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-036-xiechaozong-wyd:p017","text":"詔曰超宗釁同大逆罪不容誅彖匿情欺國愛朋罔主事合極法特原收治免官如案禁錮十年超宗下廷尉一宿髮白皓首詔徙越州行至豫章上敕豫章內史虞悰曰謝超宗令於彼賜自盡勿傷其形骸","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-nanqishu-036-xiechaozong-wyd:p017:m0002","start":2,"end":4,"surface":"超宗","person_id":"aa6_83c_juy_CDAABA","kind":"person","status":"contextual_provisional","interpretation_note":"依同句、職稱與說話角色。"},{"id":"c-nanqishu-036-xiechaozong-wyd:p017:m0012","start":12,"end":13,"surface":"彖","person_id":"x6r_6az_6zn","kind":"person","status":"contextual_provisional","interpretation_note":"依同句、職稱與說話角色。"},{"id":"c-nanqishu-036-xiechaozong-wyd:p017:m0037","start":37,"end":39,"surface":"超宗","person_id":"aa6_83c_juy_CDAABA","kind":"person","status":"contextual_provisional","interpretation_note":"依同句、職稱與說話角色。"},{"id":"c-nanqishu-036-xiechaozong-wyd:p017:m0062","start":62,"end":64,"surface":"虞悰","person_id":"lo2_l7i_fa4","kind":"person","status":"contextual_provisional","interpretation_note":"依同句、職稱與說話角色。"},{"id":"c-nanqishu-036-xiechaozong-wyd:p017:m0065","start":65,"end":68,"surface":"謝超宗","person_id":"aa6_83c_juy_CDAABA","kind":"person","status":"contextual_provisional","interpretation_note":"依同句、職稱與說話角色。"}],"source_position":{"revision_id":"cbr-ai-transcription-sha256:d752793ccca569b28429b050d8c65fdbf97b11cc0c1a900dea28b4c8bc588dcc","source_layer":"received_biography","column_projection":[{"pdf_page":106,"half":"右","leaf":"四下","column_from_right":6,"start":11,"end":21,"text":"詔曰超宗釁同大逆罪不"},{"pdf_page":106,"half":"右","leaf":"四下","column_from_right":7,"start":0,"end":21,"text":"容誅彖匿情欺國愛朋罔主事合極法特原收治免官"},{"pdf_page":106,"half":"右","leaf":"四下","column_from_right":8,"start":0,"end":21,"text":"如案禁錮十年超宗下廷尉一宿髮白皓首詔徙越州"},{"pdf_page":106,"half":"右","leaf":"四下","column_from_right":9,"start":0,"end":21,"text":"行至豫章上敕豫章內史虞悰曰謝超宗令於彼賜自"},{"pdf_page":106,"half":"右","leaf":"四下","column_from_right":10,"start":0,"end":6,"text":"盡勿傷其形骸"}]},"chapter_id":"c-nanqishu-036-xiechaozong-wyd","book_id":"b-nanqishu-036","work_id":"w-nanqishu","source_id":"s-nanqishu-036-xiechaozong-wyd1739"},{"id":"c-nanqishu-036-xiechaozong:p017","text":"詔曰：「超宗釁同大逆，罪不容誅。彖匿情欺國，愛朋罔主，事合極法，特原收治，免官如案，禁錮十年。」超宗下廷尉，一宿髮白皓首。詔徙越州，行至豫章，上敕豫章內史虞悰曰：「謝超宗令於彼賜自盡，勿傷其形骸。」","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-nanqishu-036-xiechaozong:p017:m0004","start":4,"end":6,"surface":"超宗","person_id":"aa6_83c_juy_CDAABA","kind":"person","status":"contextual_provisional","interpretation_note":"依同句、職稱與說話角色。"},{"id":"c-nanqishu-036-xiechaozong:p017:m0016","start":16,"end":17,"surface":"彖","person_id":"x6r_6az_6zn","kind":"person","status":"contextual_provisional","interpretation_note":"依同句、職稱與說話角色。"},{"id":"c-nanqishu-036-xiechaozong:p017:m0048","start":48,"end":50,"surface":"超宗","person_id":"aa6_83c_juy_CDAABA","kind":"person","status":"contextual_provisional","interpretation_note":"依同句、職稱與說話角色。"},{"id":"c-nanqishu-036-xiechaozong:p017:m0077","start":77,"end":79,"surface":"虞悰","person_id":"lo2_l7i_fa4","kind":"person","status":"contextual_provisio