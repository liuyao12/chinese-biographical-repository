m011-0090","chapter_id":"c-shiji-073-baiwang","paragraph_id":"c-shiji-073-baiwang:p011","quote":"將軍"},{"mention_id":"c-shiji-073-baiwang:m011-0127","chapter_id":"c-shiji-073-baiwang","paragraph_id":"c-shiji-073-baiwang:p011","quote":"將軍"},{"mention_id":"c-shiji-073-baiwang:m011-0170","chapter_id":"c-shiji-073-baiwang","paragraph_id":"c-shiji-073-baiwang:p011","quote":"將軍"},{"mention_id":"c-shiji-073-baiwang:m011-0247","chapter_id":"c-shiji-073-baiwang","paragraph_id":"c-shiji-073-baiwang:p011","quote":"將軍"}]},{"id":"cbr-p004263","label":"王賁（白起王翦列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"王賁","mention_ids":["c-shiji-073-baiwang:m009-0107","c-shiji-073-baiwang:m012-0201"]},{"surface":"賁","mention_ids":["c-shiji-073-baiwang:m014-0011"]}],"evidence":[{"mention_id":"c-shiji-073-baiwang:m009-0107","chapter_id":"c-shiji-073-baiwang","paragraph_id":"c-shiji-073-baiwang:p009","quote":"王賁"},{"mention_id":"c-shiji-073-baiwang:m012-0201","chapter_id":"c-shiji-073-baiwang","paragraph_id":"c-shiji-073-baiwang:p012","quote":"王賁"},{"mention_id":"c-shiji-073-baiwang:m014-0011","chapter_id":"c-shiji-073-baiwang","paragraph_id":"c-shiji-073-baiwang:p014","quote":"賁"}]}],"mentions":[{"id":"c-shiji-073-baiwang:m009-0107","start":107,"end":109,"surface":"王賁","kind":"person","person_id":"cbr-p004263","status":"contextual_provisional","paragraph_id":"c-shiji-073-baiwang:p009","chapter_id":"c-shiji-073-baiwang"},{"id":"c-shiji-073-baiwang:m012-0201","start":201,"end":203,"surface":"王賁","kind":"person","person_id":"cbr-p004263","status":"contextual_provisional","paragraph_id":"c-shiji-073-baiwang:p012","chapter_id":"c-shiji-073-baiwang"},{"id":"c-shiji-073-baiwang:m014-0011","start":11,"end":12,"surface":"賁","kind":"person","person_id":"cbr-p004263","status":"contextual_provisional","paragraph_id":"c-shiji-073-baiwang:p014","chapter_id":"c-shiji-073-baiwang"}],"relations":[{"id":"a-shiji073-001","subject_person_id":"cbr-p004263","predicate":"father","object_person_id":"cbr-p004258","status":"source_attested","evidence":[{"chapter_id":"c-shiji-073-baiwang","source_id":"s-shiji-073-baiwang","paragraph_id":"c-shiji-073-baiwang:p009","quote":"王翦者，頻陽東鄉人也。少而好兵，事秦始皇。始皇十一年，翦將攻趙閼與，破之，拔九城，十八年，翦將攻趙。歲餘，遂拔趙，趙王降，盡定趙地為郡。明年，燕使荊軻為賊於秦，秦王使王翦攻燕。燕王喜走遼東，翦遂定燕薊而還。秦使翦子王賁擊荊，荊兵敗。還擊魏，魏王降，遂定魏地。"}],"qualifiers":{"source_term":"秦使翦子王賁","historicity":"historical_tradition"},"interpretation_note":"按本篇明示子與孫保存；王離祖父王翦不推出王離父親為王賁，三代將敘事不補闕代或親屬鏈。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji073-032","person_id":"cbr-p004263","scope":"same_chapter","chapter_ids":["c-shiji-073-baiwang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"依局部敘事明示姓名、受話稱呼與回指暫接，秦昭王敘事與秦始皇敘事分段，降秦趙王與鉅鹿趙王分候選。周召引功與呂望保存引古，不補周召全名；應侯、春申君及魏公子不從記憶補名。王翦王賁王離依明示分存，孫不推出父親；將軍受話按李信與王翦對話範圍辨認。王氏蒙氏及匿名說話者未全域接個別人物。","surfaces":["王賁","賁"],"evidence":[{"paragraph_id":"c-shiji-073-baiwang:p009","quote":"王翦者，頻陽東鄉人也。少而好兵，事秦始皇。始皇十一年，翦將攻趙閼與，破之，拔九城，十八年，翦將攻趙。歲餘，遂拔趙，趙王降，盡定趙地為郡。明年，燕使荊軻為賊於秦，秦王使王翦攻燕。燕王喜走遼東，翦遂定燕薊而還。秦使翦子王賁擊荊，荊兵敗。還擊魏，魏王降，遂定魏地。"},{"paragraph_id":"c-shiji-073-baiwang:p012","quote":"王翦果代李信擊荊。荊聞王翦益軍而來，乃悉國中兵以拒秦。王翦至，堅壁而守之，不肯戰。荊兵數出挑戰，終不出。王翦日休士洗沐，而善飲食撫循之，親與士卒同食。久之，王翦使人問軍中戲乎？對曰：「方投石超距。」於是王翦曰：「士卒可用矣。」荊數挑戰而秦不出，乃引而東。翦因舉兵追之，令壯士擊，大破荊軍。至蘄南，殺其將軍項燕，荊兵遂敗走。秦因乘勝略定荊地城邑。歲餘，虜荊王負芻，竟平荊地為郡縣。因南征百越之君。而王翦子王賁，與李信破定燕、齊地。"},{"paragraph_id":"c-shiji-073-baiwang:p014","quote":"秦二世之時，王翦及其子賁皆已死，而又滅蒙氏。陳勝之反秦，秦使王翦之孫王離擊趙，圍趙王及張耳鉅鹿城。或曰：「王離，秦之名將也。今將彊秦之兵，攻新造之趙，舉之必矣。」客曰：「不然。夫為將三世者必敗。必敗者何也？必其所殺伐多矣，其後受其不祥。今王離已三世將矣。」居無何，項羽救趙，擊秦軍，果虜王離，王離軍遂降諸侯。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-073-baiwang:p009","text":"王翦者，頻陽東鄉人也。少而好兵，事秦始皇。始皇十一年，翦將攻趙閼與，破之，拔九城，十八年，翦將攻趙。歲餘，遂拔趙，趙王降，盡定趙地為郡。明年，燕使荊軻為賊於秦，秦王使王翦攻燕。燕王喜走遼東，翦遂定燕薊而還。秦使翦子王賁擊荊，荊兵敗。還擊魏，魏王降，遂定魏地。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-073-baiwang:m009-0000","start":0,"end":2,"surface":"王翦","kind":"person","person_id":"cbr-p004258","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m009-0017","start":17,"end":20,"surface":"秦始皇","kind":"person","person_id":"cbr-p004259","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m009-0021","start":21,"end":23,"surface":"始皇","kind":"person","person_id":"cbr-p004259","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m009-0027","start":27,"end":28,"surface":"翦","kind":"person","person_id":"cbr-p004258","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m009-0045","start":45,"end":46,"surface":"翦","kind":"person","person_id":"cbr-p004258","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m009-0057","start":57,"end":59,"surface":"趙王","kind":"person","person_id":"cbr-p004260","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m009-0073","start":73,"end":75,"surface":"荊軻","kind":"person","person_id":"cbr-p004261","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m009-0080","start":80,"end":82,"surface":"秦王","kind":"person","person_id":"cbr-p004259","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m009-0083","start":83,"end":85,"surface":"王翦","kind":"person","person_id":"cbr-p004258","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m009-0088","start":88,"end":91,"surface":"燕王喜","kind":"person","person_id":"cbr-p004262","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m009-0095","start":95,"end":96,"surface":"翦","kind":"person","person_id":"cbr-p004258","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m009-0105","start":105,"end":106,"surface":"翦","kind":"person","person_id":"cbr-p004258","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m009-0107","start":107,"end":109,"surface":"王賁","kind":"person","person_id":"cbr-p004263","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m009-0120","start":120,"end":122,"surface":"魏王","kind":"person","person_id":"cbr-p004264","status":"contextual_provisional"}],"chapter_id":"c-shiji-073-baiwang","book_id":"b-shiji-073","work_id":"w-shiji","source_id":"s-shiji-073-baiwang"},{"id":"c-shiji-073-baiwang:p012","text":"王翦果代李信擊荊。荊聞王翦益軍而來，乃悉國中兵以拒秦。王翦至，堅壁而守之，不肯戰。荊兵數出挑戰，終不出。王翦日休士洗沐，而善飲食撫循之，親與士卒同食。久之，王翦使人問軍中戲乎？對曰：「方投石超距。」於是王翦曰：「士卒可用矣。」荊數挑戰而秦不出，乃引而東。翦因舉兵追之，令壯士擊，大破荊軍。至蘄南，殺其將軍項燕，荊兵遂敗走。秦因乘勝略定荊地城邑。歲餘，虜荊王負芻，竟平荊地為郡縣。因南征百越之君。而王翦子王賁，與李信破定燕、齊地。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-073-baiwang:m012-0000","start":0,"end":2,"surface":"王翦","kind":"person","person_id":"cbr-p004258","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m012-0004","start":4,"end":6,"surface":"李信","kind":"person","person_id":"cbr-p004265","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m012-0011","start":11,"end":13,"surface":"王翦","kind":"person","person_id":"cbr-p004258","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m012-0027","start":27,"end":29,"surface":"王翦","kind":"person","person_id":"cbr-p004258","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m012-0052","start":52,"end":54,"surface":"王翦","kind":"person","person_id":"cbr-p004258","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m012-0078","start":78,"end":80,"surface":"王翦","kind":"person","person_id":"cbr-p004258","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m012-0101","start":101,"end":103,"surface":"王翦","kind":"person","person_id":"cbr-p004258","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m012-0127","start":127,"end":128,"surface":"翦","kind":"person","person_id":"cbr-p004258","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m012-0150","start":150,"end":154,"surface":"將軍項燕","kind":"person","person_id":"cbr-p004268","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m012-0176","start":176,"end":180,"surface":"荊王負芻","kind":"person","person_id":"cbr-p004269","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m012-0192","start":192,"end":196,"surface":"百越之君","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名使者、說話者、群體或族屬保持未定；不補成員及姓名，不將相近語句視為同一匿名人物。"},{"id":"c-shiji-073-baiwang:m012-0198","start":198,"end":200,"surface":"王翦","kind":"person","person_id":"cbr-p004258","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m012-0201","start":201,"end":203,"surface":"王賁","kind":"person","person_id":"cbr-p004263","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m012-0205","start":205,"end":207,"surface":"李信","kind":"person","person_id":"cbr-p004265","status":"contextual_provisional"}],"chapter_id":"c-shiji-073-baiwang","book_id":"b-shiji-073","work_id":"w-shiji","source_id":"s-shiji-073-baiwang"},{"id":"c-shiji-073-baiwang:p014","text":"秦二世之時，王翦及其子賁皆已死，而又滅蒙氏。陳勝之反秦，秦使王翦之孫王離擊趙，圍趙王及張耳鉅鹿城。或曰：「王離，秦之名將也。今將彊秦之兵，攻新造之趙，舉之必矣。」客曰：「不然。夫為將三世者必敗。必敗者何也？必其所殺伐多矣，其後受其不祥。今王離已三世將矣。」居無何，項羽救趙，擊秦軍，果虜王離，王離軍遂降諸侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-073-baiwang:m014-0000","start":0,"end":3,"surface":"秦二世","kind":"person","person_id":"cbr-p004270","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m014-0006","start":6,"end":8,"surface":"王翦","kind":"person","person_id":"cbr-p004258","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m014-0011","start":11,"end":12,"surface":"賁","kind":"person","person_id":"cbr-p004263","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m014-0019","start":19,"end":21,"surface":"蒙氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名使者、說話者、群體或族屬保持未定；不補成員及姓名，不將相近語句視為同一匿名人物。"},{"id":"c-shiji-073-baiwang:m014-0022","start":22,"end":24,"surface":"陳勝","kind":"person","person_id":"cbr-p004271","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m014-0030","start":30,"end":32,"surface":"王翦","kind":"person","person_id":"cbr-p004258","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m014-