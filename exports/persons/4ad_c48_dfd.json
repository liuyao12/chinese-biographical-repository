er":"received_chapter","first_line":47,"last_line":56},"chapter_id":"c-jinshu-040-wyd1739-jiachong","book_id":"b-jinshu-040","work_id":"w-jinshu","source_id":"s-jinshu-040-wyd1739-jiachong"},{"id":"c-jinshu-040-wyd1739-jiachong:p009","text":"及齊王攸荀勗參醫藥及疾愈賜絹各五百匹初帝疾篤朝廷屬意於攸河南尹夏侯和謂充曰卿二女壻親疏等耳立人當立德充不答及是帝聞之徙和光祿勲乃奪充兵權而位遇無替尋轉太尉行太子太保錄尚書事咸寧三年日食於三朝充請遜位不許更以沛國之公丘益其封寵倖愈甚朝臣咸側目焉河南尹王恂上言弘訓太后入廟合食於景皇帝齊王攸不得行其子禮充議以為禮諸侯不得祖天子公子不得禰先君皆謂奉統承祀非謂不得復其父祖也攸身宜服三年喪事自如臣制有司奏若如充議服子服行臣制未有","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-040-wyd1739-jiachong:p009:m0001","start":1,"end":4,"surface":"齊王攸","kind":"person","person_id":"cac_ca2_008","status":"contextual_provisional"},{"id":"c-jinshu-040-wyd1739-jiachong:p009:m0004","start":4,"end":6,"surface":"荀勗","kind":"person","person_id":"yoo_ox0_545_FAAA","status":"contextual_provisional"},{"id":"c-jinshu-040-wyd1739-jiachong:p009:m0019","start":19,"end":20,"surface":"帝","kind":"person","person_id":"hgm_jvn_hle","status":"contextual_provisional"},{"id":"c-jinshu-040-wyd1739-jiachong:p009:m0027","start":27,"end":28,"surface":"攸","kind":"person","person_id":"cac_ca2_008","status":"contextual_provisional"},{"id":"c-jinshu-040-wyd1739-jiachong:p009:m0031","start":31,"end":34,"surface":"夏侯和","kind":"person","person_id":"o2z_243_fci","status":"contextual_provisional"},{"id":"c-jinshu-040-wyd1739-jiachong:p009:m0035","start":35,"end":36,"surface":"充","kind":"person","person_id":"jmv_vc4_gep_*AA","status":"contextual_provisional"},{"id":"c-jinshu-040-wyd1739-jiachong:p009:m0038","start":38,"end":41,"surface":"二女壻","kind":"unresolved","person_id":null,"status":"unresolved","reason":"群體，語境齊王攸與皇太子兩女婿；不合成一人。"},{"id":"c-jinshu-040-wyd1739-jiachong:p009:m0050","start":50,"end":51,"surface":"充","kind":"person","person_id":"jmv_vc4_gep_*AA","status":"contextual_provisional"},{"id":"c-jinshu-040-wyd1739-jiachong:p009:m0055","start":55,"end":56,"surface":"帝","kind":"person","person_id":"hgm_jvn_hle","status":"contextual_provision