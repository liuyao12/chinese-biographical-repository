40","work_id":"w-jinshu","source_id":"s-jinshu-040-wyd1739-jiachong"},{"id":"c-jinshu-040-wyd1739-jiachong:p010","text":"前比宜如恂表攸喪服從諸侯之例帝從充議伐吳之役詔充為使持節假黃鉞大都督總統六師給羽葆鼓吹緹幢兵萬人騎二千置左右長史司馬從事中郎增參軍騎司馬各十人帳下司馬二十人大車官騎各三十人充慮大功不捷表陳西有昆夷之患北有幽并之戍天下勞擾年穀不登興軍致討懼非其時又臣老邁非所克堪詔曰君不行吾便自出充不得已乃受節鉞將中軍為諸軍節度以冠軍將軍楊濟為副南屯襄陽吳江陵諸守皆降充乃徙屯項王濬之克武昌也充遣使表曰吳未可悉定方夏江淮下濕疾疫必起宜召諸","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-040-wyd1739-jiachong:p010:m0004","start":4,"end":5,"surface":"恂","kind":"person","person_id":"4ad_c48_dfd","status":"contextual_provisional"},{"id":"c-jinshu-040-wyd1739-jiachong:p010:m0006","start":6,"end":7,"surface":"攸","kind":"person","person_id":"cac_ca2_008","status":"contextual_provisional"},{"id":"c-jinshu-040-wyd1739-jiachong:p010:m0014","start":14,"end":15,"surface":"帝","kind":"person","person_id":"hgm_jvn_hle","status":"contextual_provisional"},{"id":"c-jinshu-040-wyd1739-jiachong:p010:m0016","start":16,"end":17,"surface":"充","kind":"person","person_id":"jmv_vc4_gep_*AA","status":"contextual_provisional"},{"id":"c-jinshu-040-wyd1739-jiachong:p010:m0023","start":23,"end":24,"surface":"充","kind":"person","person_id":"jmv_vc4_gep_*AA","status":"contextual_provisional"},{"id":"c-jinshu-040-wyd1739-jiachong:p010:m0086","start":86,"end":87,"surface":"充","kind":"person","person_id":"jmv_vc4_gep_*AA","status":"contextual_provisional"},{"id":"c-jinshu-040-wyd1739-jiachong:p010:m0139","start":139,"end":140,"surface":"充","kind":"person","person_id":"jmv_vc4_gep_*AA","status":"contextual_provisional"},{"id":"c-jinshu-040-wyd1739-jiachong:p010:m0160","start":160,"end":162,"surface":"楊濟","kind":"person","person_id":"e3f_e69_af5","status":"contextual_provisional"},{"id":"c-jinshu-040-wyd1739-jiachong:p010:m0175","start":175,"end":176,"surface":"充","kind":"person","person_id":"jmv_vc4_gep_*AA","status":"contextual_provisional"},{"id":"c-jinshu-040-wyd1739-jiachong:p010:m0180","start":180,"end":182,"surface":"王濬","kind":"person","person_id":"36c_6b6_4b3","status":"contextual_provisional"},{"id":"c-jinshu-040-wyd1739-jiachong:p010:m0187","start":187,"end":188,"surface":"充","kind":"person","person_id":"jmv_vc4_gep_*AA","status":"contextual_provisional"}],"source_position":{"raw_projection_ref":"source-evidence/jin040-wyd1739-jiachong/transcription-projection.json","raw_file_sha256":"209d9b8a8a2f183a7ad3ed749da0273d85e177f9ff7feaf3ceea7edc3ffeabd0","unit_key":"unit010","source_layer":"received_chapter","first_line":87,"last_line":96},"chapter_id":"c-jinshu-040-wyd1739-jiachong","book_id":"b-jinshu-040","work_id":"w-jinshu","source_id":"s-jinshu-040-wyd1739-jiachong"},{"id":"c-jinshu-042-taiyuan-wang:line028","text":"濟字武子。少有逸才，風姿英爽，氣蓋一時，好弓馬，勇力絕人，善《易》及《莊》、《老》，文詞俊茂，伎藝過人，有名當世，與姊夫和嶠及裴楷齊名。尚常山公主。年二十，起家拜中書郎，以母憂去官。起為驍騎將軍，累遷侍中，與侍中孔恂、王恂、楊濟同列，為一時秀彥。武帝嘗會公卿籓牧於式乾殿，顧濟、恂而謂諸公曰：「朕左右可謂恂恂濟濟矣！」每侍見，未嘗不諮論人物及萬機得失。濟善於清言，修飾辭令，諷議將順，朝臣莫能尚焉。帝益親貴之。仕進雖速，論者不以主婿之故，咸謂才能致之。然外雖弘雅，而內多忌刻，好以言傷物，儕類以此少之。以其父之故，每排王濬，時議譏焉。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-042-taiyuan-wang:line028:m0000","start":0,"end":1,"surface":"濟","kind":"person","person_id":"a8f_ec8_e74_ABB","status":"contextual_provisional"},{"id":"c-jinshu-042-taiyuan-wang:line028:m0060","start":60,"end":62,"surface":"和嶠","kind":"person","person_id":"3fc_362_06e","status":"contextual_provisional","resolution_note":"逐段核讀本名、短稱、官爵或引語上下文。"},{"id":"c-jinshu-042-taiyuan-wang:line028:m0063","start":63,"end":65,"surface":"裴楷","kind":"person","person_id":"530_f9d_4bd","status":"contextual_provisional","resolution_note":"逐段核讀本名、短稱、官爵或引語上下文。"},{"id":"c-jinshu-042-taiyuan-wang:line028:m0069","start":69,"end":73,"surface":"常山公主","kind":"person","person_id":"d81_e53_85b","status":"contextual_provisional","resolution_note":"逐段核讀本名、短稱、官爵或引語上下文。"},{"id":"c-jinshu-042-taiyuan-wang:line028:m0106","start":106,"end":108,"surface":"孔恂","kind":"person","person_id":"f78_14f_905","status":"contextual_provisional","resolution_note":"逐段核讀本名、短稱、官爵或引語上下文。"},{"id":"c-jinshu-042-taiyuan-wang:line028:m0109","start":109,"end":111,"surface":"王恂","kind":"person","person_id":"4ad_c48_dfd","status":"contextual_provisional","resolution_note":"逐段核讀本名、短稱、官爵或引語上下文。"},{"id":"c-jinshu-042-taiyuan-wang:line028:m0112","start":112,"end":114,"surface":"楊濟","kind":"person","person_id":"e3f_e69_af5","status":"contextual_provisional","resolution_note":"逐段核讀本名、短稱、官爵或引語上下文。"},{"id":"c-jinshu-042-taiyuan-wang:line028:m0123","start":123,"end":125,"surface":"武帝","kind":"person","person_id":"hgm_jvn_hle","status":"contextual_provisional","resolution_note":"逐段核讀本名、短稱、官爵或引語上下文。"},{"id":"c-jinshu-042-taiyuan-wang:line028:m0137","start":137,"end":138,"surface":"濟","kind":"person","person_id":"a8f_ec8_e74_ABB","status":"contextual_provisional"},{"id":"c-jinshu-042-taiyuan-wang:line028:m0139","start":139,"end":140,"surface":"恂","kind":"unresolved","person_id":null,"status":"unresolved","resolution_note":"逐段核讀本名、短稱、官爵或引語上下文。","candidate_person_ids":["f78_14f_905","4ad_c48_dfd"],"unresolved_reason":"同段列孔恂與王恂，後「顧濟、恂」不足僅以最近姓名決定；兩位新候選見本批人物提案。"},{"id":"c-jinshu-042-taiyuan-wang:line028:m0147","start":147,"end":148,"surface":"朕","kind":"person","person_id":"hgm_jvn_hle","status":"contextual_provisional","resolution_note":"逐句辨發話者及受話者，限此引語範圍。"},{"id":"c-jinshu-042-taiyuan-wang:line028:m0176","start":176,"end":177,"surface":"濟","kind":"person","person_id":"a8f_ec8_e74_ABB","status":"contextual_provisional"},{"id":"c-jinshu-042-taiyuan-wang:line028:m0199","start":199,"end":200,"surface":"帝","kind":"person","person_id":"hgm_jvn_hle","status":"contextual_provisional","resolution_note":"逐段核讀本名、短稱、官爵或引語上下文。"},{"id":"c-jinshu-042-taiyuan-wang:line028:m0259","start":259,"end":261,"surface":"王濬","kind":"person","person_id":"36c_6b6_4b3","status":"contextual_provisional","resolution_note":"逐段核讀本名、短稱、官爵或引語上下文。"}],"source_position":{"first_line":28,"last_line":28,"revision_id":2180524,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-042-taiyuan-wang","book_id":"b-jinshu-042","work_id":"w-jinshu","source_id":"s-jinshu-042-taiyuan-wang"},{"id":"c-jinshu-043-wyd1739-shantao:p014","text":"臣咸皆率職時黃門侍郎王恂庾純始於太極東堂聽政評尚書奏事多論刑獄不論選舉臣以為不先所難而辨其所易陛下初臨萬國人思盡誠每於聽政之日命公卿大臣先議選舉各言所見後進儁才鄉邑尤異才堪任用者皆以名奏主者隨缺先敘是爵人於朝與衆共之之義也朝廷從之永嘉三年出為征南將軍都督荆湘交廣四州諸軍事假節鎮襄陽于時四方寇亂天下分崩王威不振朝野危懼簡優游卒歲唯酒是耽諸習氏荆土豪族有佳園池簡每出遊嬉多之池上置酒輒醉名之曰高陽池時有童兒歌曰山公出何許往","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-043-wyd1739-shantao:p014:m0010","start":10,"end":12,"surface":"王恂","kind":"person","person_id":"4ad_c48_dfd","status":"contextual_provisional","resolution_note":"固定完整山濤單元逐處語境角色；原字、時層、引語主客與來源限定見本源role ledger。"},{"id":"c-jinshu-043-wyd1739-shantao:p014:m0012","start":12,"end":14,"surface":"庾純","kind":"person","person_id":"u6c_3lq_78b","status":"contextual_provisional","resolution_note":"固定完整山濤單元逐處語境角色；原字、時層、引語主客與來源限定見本源role ledger。"},{"id":"c-jinshu-043-wyd1739-shantao:p014:m0035","start":35,"end":36,"surface":"臣","kind":"person","person_id":"4kf_elm_6ww_AE","status":"contextual_provisional","resolution_note":"固定完整山濤單元逐處語境角色；原字、時層、引語主客與來源限定見本源role ledger。"},{"id":"c-jinshu-043-wyd1739-shantao:p014:m0047","start":47,"end":49,"surface":"陛下","kind":"person","person_id":"83d_b6e_058","status":"contextual_provisional","resolution_note":"固定完整山濤單元逐處語境角色；原字、時層、引語主客與來源限定見本源role ledger。"},{"id":"c-jinshu-043-wyd1739-shantao:p014:m0159","start":159,"end":160,"surface":"簡","kind":"person","person_id":"4kf_elm_6ww_AE","status":"contextual_provisional","resolution_note":"固定完整山濤單元逐處語境角色；原字、時層、引語主客與來源限定見本源role ledger。"},{"id":"c-jinshu-043-wyd1739-shantao:p014:m0179","start":179,"end":180,"surface":"簡","kind":"person","person_id":"4kf_elm_6ww_AE","status":"contextual_provisional","resolution_note":"固定完整山濤單元逐處語境角色；原字、時層、引語主客與來源限定見本源role ledger。"},{"id":"c-jinshu-043-wyd1739-shantao:p014:m0204","start":204,"end":206,"surface":"山公","kind":"person","person_id":"4kf_elm_6ww_AE","status":"contextual_provisional","resolution_note":"固定完整山濤單元逐處語境角色；原字、時層、引語主客與來源限定見本源role ledger。"}],"