物如方相，俄而疽發背。疾篤，表第二子爰之行輔國將軍、荊州刺史，司馬硃燾為南蠻校尉，以千人守巴陵。永和元年卒，時年四十一。追贈車騎將軍，諡曰肅。翼卒未幾，部將干瓚、戴羲等作亂，殺將軍曹據。翼長史江[A170]、司馬硃燾、將軍袁真等共誅之。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":142,"last_line":142,"raw_start":11651,"raw_end":11823,"raw_character_offsets":[11653,11654,11655,11656,11657,11658,11659,11660,11661,11662,11663,11664,11665,11666,11667,11668,11669,11670,11671,11672,11673,11674,11675,11676,11677,11678,11679,11680,11681,11682,11683,11684,11685,11686,11687,11688,11689,11690,11691,11692,11693,11694,11695,11696,11697,11698,11699,11700,11701,11702,11703,11704,11705,11706,11712,11713,11714,11715,11718,11719,11720,11721,11722,11723,11724,11725,11726,11727,11728,11729,11730,11731,11732,11733,11734,11735,11736,11737,11738,11739,11740,11741,11742,11743,11746,11749,11785,11786,11787,11788,11789,11790,11791,11792,11793,11794,11795,11796,11797,11798,11799,11800,11801,11802,11803,11804,11805,11806,11807,11808,11809,11810,11811,11812,11813,11814,11815,11816,11817,11818,11819,11820,11821,11822],"revision_id":2296501},"mentions":[{"id":"c-jinshu-073-yuyi:p012:m0000","surface":"翼","start":0,"end":1,"person_id":"4qr_wrk_3vd_F","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-073-yuyi:p012:m0024","surface":"爰之","start":24,"end":26,"person_id":"h97_qdy_lan","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-073-yuyi:p012:m0039","surface":"硃燾","start":39,"end":41,"person_id":"9je_3rs_0oj","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-073-yuyi:p012:m0084","surface":"干瓚","start":84,"end":86,"person_id":"b5k_1co_7pq","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-073-yuyi:p012:m0087","surface":"戴羲","start":87,"end":89,"person_id":"nbn_f7w_yt1","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-073-yuyi:p012:m0096","surface":"曹據","start":96,"end":98,"person_id":"05e_1c3_fff","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-073-yuyi:p012:m01