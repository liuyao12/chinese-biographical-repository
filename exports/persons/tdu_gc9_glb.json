":1,"parent_person_id":"72e_1a7_3ac_AAA","source_assertion_id":"a-nanshi024-wangqing-meng-father","evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-024","source_id":"s-nanshi-024-wangqing-ws1765279","chapter_id":"c-nanshi-024-wangqing","paragraph_id":"c-nanshi-024-wangqing:p001","quote":"進之子清，位散騎常侍，金紫光祿大夫，鎭東府長史，新野、東陽二郡太守，安南將軍，封中廬公。承聖末，陳武帝殺太尉王僧辯，遣文帝攻僧辯婿杜龕，龕告難於清，引兵援龕，大敗陳文帝于呉興，追奔至晉陵。時廣州刺史歐陽頠亦同清援龕，中更改異，殺清而歸陳武帝。子猛。","subject_person_mention_id":"c-nanshi-024-wangqing:p001:m0122","object_person_mention_id":"c-nanshi-024-wangqing:p001:m0114","relationship_anchor":{"paragraph_id":"c-nanshi-024-wangqing:p001","surface":"子猛","start":121,"end":123}}],"status":"contextual_provisional","interpretation_note":"傳尾子猛承王清，後王猛本題於173行重記父清。","human_reviewed":false}},{"id":"tdu_gc9_glb","label":"鄧暠（王勇同產弟）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"鄧暠","mention_ids":["c-chenshu-014-wangyong:p002:m0132"]}],"evidence":[{"work_id":"w-chenshu","book_id":"b-chenshu-014","source_id":"s-chenshu-014-wangyong-ws2262003","chapter_id":"c-chenshu-014-wangyong","paragraph_id":"c-chenshu-014-wangyong:p002","quote":"鄧暠","mention_id":"c-chenshu-014-wangyong:p002:m0132"}],"review":"ai_provisional","identity_note":"本批依鄧暠（王勇同產弟）所繫傳首、原爵或出生世系；見登記中的原字錨。"}],"source_mention_summary":[{"source_id":"s-chenshu-014-wangyong-ws2262003","work_id":"w-chenshu","book_id":"b-chenshu-014","chapter_id":"c-chenshu-014-wangyong","raw_mention_count":1,"mention_ids":["c-chenshu-014-wangyong:p002:m0132"],"paragraph_ids":["c-chenshu-014-wangyong:p002"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-chenshu-014-wangyong:p002:m0132","mention_ids":["c-chenshu-014-wangyong:p002:m0132"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-chenshu-014-wangyong-ws2262003"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-nanshi024-wangmeng-deng-yong","subject_person_id":"tdu_gc9_glb","object_person_id":"72e_1a7_3ac_AAAA","predicate":"brother","qualifiers":{"source_term":"同產弟鄧暠","nanshi024_wangmeng_reading":"deng-yong","relative_birth_order":{"older_person_id":"72e_1a7_3ac_AAAA","younger_person_id":"tdu_gc9_glb","operator":"lt","scope":"siblings","older_ordinal":null,"younger_ordinal":null},"shared_mother":true},"evidence":[{"work_id":"w-chenshu","book_id":"b-chenshu-014","source_id":"s-chenshu-014-wangyong-ws2262003","chapter_id":"c-chenshu-014-wangyong","paragraph_id":"c-chenshu-014-wangyong:p002","quote":"王勇，太建中為晉陵太守，在職有能名。方慶之襲馬靖也，朝廷以勇為超武將軍、東衡州刺史，領始興內史，以為方慶聲勢。靖誅，以功封龍陽縣子。及隋軍臨江，詔授勇使持節、光勝將軍、總督衡廣交桂武等二十四州諸軍事、平越中郎將，仍入援。會京城陷、勇因移檄管內，徵兵據守，使其同產弟鄧暠將兵五千，頓于嶺上。又遣使迎方慶，欲假以為名，而自執兵要。及方慶敗績，虜其妻子，收其貲產，分賞將帥。又令其將王仲宣、曾孝武迎西衡州刺史衡陽王伯信，伯信懼，奔于清遠郡，孝武追殺之。是時韋洸兵已上嶺，豐州刺史鄭萬頃據州不受勇召，而高梁女子（浩）〔洗〕氏舉兵以應隋軍，攻陷傍郡，勇計無所出，乃以其眾降。行至荊州，道病卒，隋贈大將軍、宋州刺史，歸仁縣公。","subject_person_mention_id":"c-chenshu-014-wangyong:p002:m0132","object_person_mention_id":"c-chenshu-014-wangyong:p002:m0000","relationship_anchor":{"paragraph_id":"c-chenshu-014-wangyong:p002","surface":"同產弟鄧暠","start":129,"end":134}}],"status":"source_attested","interpretation_note":"同產弟，異姓。只定同母、長幼；此傳未名其母與生父。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-chensh