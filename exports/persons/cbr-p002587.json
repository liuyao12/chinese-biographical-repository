ons":[],"title_holdings":[{"id":"th-shiji044-034","person_id":"cbr-p002587","title":"魏相","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-044-wei","source_id":"s-shiji-044-wei","paragraph_id":"c-shiji-044-wei:p049","quote":"九年，與秦王會臨晉。張儀、魏章皆歸于魏。魏相田需死，楚害張儀、犀首、薛公。楚相昭魚謂蘇代曰：『田需死，吾恐張儀、犀首、薛公有一人相魏者也。』代曰：『然相者欲誰而君便之？』昭魚曰：『吾欲太子之自相也。』代曰：『請爲君北，必相之。』昭魚曰：『柰何？』對曰：『君其爲梁王，代請説君。』昭魚曰：『柰何？』對曰：『代也從楚來，昭魚甚憂，曰：「田需死，吾恐張儀、犀首、薛公有一人相魏者也。」代曰：「梁王，長主也，必不相張儀。張儀相，必右秦而左魏。犀首相，必右韓而左魏。薛公相，必右齊而左魏。梁王，長主也，必不便也。」王曰：「然則寡人孰相？」代曰：「莫若太子之自相。太子之自相，是三人者皆以太子爲非常相也，皆將務以其國事魏，欲得丞相璽也。以魏之彊，而三萬乘之國輔之，魏必安矣。故曰莫若太子之自相也。」』遂北見梁王，以此告之。太子果相魏。"}],"attestations":[{"id":"th-shiji044-034:a001","paragraph_id":"c-shiji-044-wei:p049","start":20,"end":22,"surface":"魏相","person_mention_id":"c-shiji-044-wei:m049-0022","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予、文獻用稱及明示去號分開。罷兵或終身不見不推所有爵位終止；移除相位、出質與失兵各不同，未知端點不補曆日。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji044-088","person_id":"cbr-p002587","surfaces":["田需"],"scope":"same_chapter","chapter_ids":["c-shiji-044-wei"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-044-wei:p049","quote":"九年，與秦王會臨晉。張儀、魏章皆歸于魏。魏相田需死，楚害張儀、犀首、薛公。楚相昭魚謂蘇代曰：『田需死，吾恐張儀、犀首、薛公有一人相魏者也。』代曰：『然相者欲誰而君便之？』昭魚曰：『吾欲太子之自相也。』代曰：『請爲君北，必相之。』昭魚曰：『柰何？』對曰：『君其爲梁王，代請説君。』昭魚曰：『柰何？』對曰：『代也從楚來，昭魚甚憂，曰：「田需死，吾恐張儀、犀首、薛公有一人相魏者也。」代曰：「梁王，長主也，必不相張儀。張儀相，必右秦而左魏。犀首相，必右韓而左魏。薛公相，必右齊而左魏。梁王，長主也，必不便也。」王曰：「然則寡人孰相？」代曰：「莫若太子之自相。太子之自相，是三人者皆以太子爲非常相也，皆將務以其國事魏，欲得丞相璽也。以魏之彊，而三萬乘之國輔之，魏必安矣。故曰莫若太子之自相也。」』遂北見梁王，以此告之。太子果相魏。"}],"rationale":"限本篇明示姓名、封號、繼位與連續對話。无忌／信陵君及增／景湣王按明示語句暫接；公子政不與秦王政按同名合併。太子自相、蘇代扮演梁王與秦王未名時段各保留，不補姓名；中旗馮琴讀法待底本核查。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-044-wei:p049","text":"九年，與秦王會臨晉。張儀、魏章皆歸于魏。魏