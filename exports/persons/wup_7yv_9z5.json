fuhongzhi-ws1791560","paragraph_id":"c-songshu-048-fuhongzhi:p001","quote":"傅弘之字仲度，北地泥陽人。傅氏舊屬靈州，漢末郡境為虜所侵，失土寄寓馮翊，置泥陽、富平二縣，靈州廢不立，故傅氏悉屬泥陽。晉武帝太康三年，復立靈州縣，傅氏還屬靈州。弘之高祖晉司徒祗，後封靈州公，不欲封本縣，故祗一門還復泥陽。曾祖暢，祕書丞，沒胡，生子洪，晉穆帝永和中，胡亂得還。洪生韶，梁州刺史，散騎常侍。韶生弘之。","person_mention_id":"c-songshu-048-fuhongzhi:p001:m0139"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"th-songshu-048-fuhongzhi-3-65","title":"梁州","kind":"office","mode":"attestation","person_id":"258_ae3_26e_AA","attestations":[{"id":"th-songshu-048-fuhongzhi-3-65:a","paragraph_id":"c-songshu-048-fuhongzhi:p003","start":65,"end":67,"surface":"梁州","person_mention_id":"c-songshu-048-fuhongzhi:p003:m0063","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-048","chapter_id":"c-songshu-048-fuhongzhi","source_id":"s-songshu-048-fuhongzhi-ws1791560","paragraph_id":"c-songshu-048-fuhongzhi:p003","quote":"義旗建，輔國將軍道規以為參軍、寧遠將軍、魏興太守。盧循作亂，桓石綏自上洛甲口自號荊州刺史，徵陽令王天恩自號梁州刺史，襲西城。時韶為梁州，遣弘之討石綏等，並斬之。除太尉行參軍。從征司馬休之，署後部賊曹，仍為建威將軍、順陽太守。","person_mention_id":"c-songshu-048-fuhongzhi:p003:m0063"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[{"id":"d-song048-fushao-xin-xinzhi","person_ids":["258_ae3_26e_AA","wup_7yv_9z5","n7r_86a_a7r"],"canonical_person_id":"258_ae3_26e_AA","scope":"cross_chapter","chapter_ids":["c-songshu-048-fuhongzhi","c-jinshu-074-huan-family","c-jinshu-099-huanxuan"],"status":"contextual_provisional","evidence":[{"work_id":"w-songshu","book_id":"b-songshu-048","chapter_id":"c-songshu-048-fuhongzhi","source_id":"s-songshu-048-fuhongzhi-ws1791560","paragraph_id":"c-songshu-048-fuhongzhi:p001","quote":"傅弘之字仲度，北地泥陽人。傅氏舊屬靈州，漢末郡境為虜所侵，失土寄寓馮翊，置泥陽、富平二縣，靈州廢不立，故傅氏悉屬泥陽。晉武帝太康三年，復立靈州縣，傅氏還屬靈州。弘之高祖晉司徒祗，後封靈州公，不欲封本縣，故祗一門還復泥陽。曾祖暢，祕書丞，沒胡，生子洪，晉穆帝永和中，胡亂得還。洪生韶，梁州刺史，散騎常侍。韶生弘之。","mention_ids":["c-songshu-048-fuhongzhi:p001:m0139"]},{"work_id":"w-songshu","book_id":"b-songshu-048","chapter_id":"c-songshu-048-fuhongzhi","source_id":"s-songshu-048-fuhongzhi-ws1791560","paragraph_id":"c-songshu-048-fuhongzhi:p003","quote":"義旗建，輔國將軍道規以為參軍、寧遠將軍、魏興太守。盧循作亂，桓石綏自上洛甲口自號荊州刺史，徵陽令王天恩自號梁州刺史，襲西城。時韶為梁州，遣弘之討石綏等，並斬之。除太尉行參軍。從征司馬休之，署後部賊曹，仍為建威將軍、順陽太守。","mention_ids":["c-songshu-048-fuhongzhi:p003:m0063"]},{"work_id":"w-jinshu","book_id":"b-jinshu-074","chapter_id":"c-jinshu-074-huan-family","source_id":"s-jinshu-074-ws1536331","paragraph_id":"c-jinshu-074-huan-family:p020","quote":"石綏，元顯時為司徒左長史。玄用事，拜黃門郎、左衛將軍。玄敗，石綏走江西塗中，聚眾攻曆陽，後為梁州刺史傅歆之所殺。","mention_ids":["c-jinshu-074-huan-family:p020:m0050"]},{"work_id":"w-jinshu","book_id":"b-jinshu-099","chapter_id":"c-jinshu-099-huanxuan","source_id":"s-jinshu-099-huanxuan-ws2644703","paragraph_id":"c-jinshu-099-huanxuan:p037","quote":"三年，東陽太守殷仲文與永嘉太守駱球謀反，欲建桓胤為嗣，曹靖之、桓石鬆、卞承之、劉延祖等潛相交結，劉裕以次收斬之，並誅其家屬。後桓謙走入蜀，蜀賊譙縱以謙為荊州刺史，使率兵而下，荊楚之眾多應之。謙至枝江，荊州刺史劉道規斬之，梁州刺史傅歆又斬桓石綏，桓氏遂滅。","mention_ids":["c-jinshu-099-huanxuan:p037:m0114"]}],"rationale":"宋48以傅暢子洪、洪生韶、韶生弘之明父子，又以韶為梁州刺史、遣子討桓石綏。南16同祖及子而字作歆；晉99與晉74在同一事分書梁州刺史傅歆、傅歆之，均把斬石綏概歸刺史。通鑑115同條父名先詔後韶，明其子弘之討石綏、暢之孫。據同地、同官、同事、子名及兩代家世判為同一人。宋傳父系原號作代表；三個已發號與原書錨點各自保留。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"passages":[{"id":"c-jinshu-074-huan-family:p020","text":"石綏，元顯時為司徒左長史。玄用事，拜黃門郎、左衛將軍。玄敗，石綏走江西塗中，聚眾攻曆陽，後為梁州刺史傅歆之所殺。","source_position":{"kind":"wikitext_codepoint_positions","raw_path":"sources/jinshu/wikisource-1536331-raw.wikitext","raw_start":4737,"raw_end":4873,"character_positions":[4739,4740,4741,4742,4743,4744,4745,4746,4747,4748,4749,4750,4751,4752,4753,4754,4755,4756,4757,4758,4759,4760,4761,4762,4763,4764,4765,4766,