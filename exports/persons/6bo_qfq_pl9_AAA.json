曰：「所謂左把浮丘袖，右拍洪崖肩。」其見重如此。筠又與殷芸以方雅見禮焉。出爲丹陽尹丞、北中郎諮議參軍，遷中書郎。奉敕制《開善寺寶誌大師碑文》，詞甚麗逸。又敕撰《中書表奏》三十卷，及所上賦頌，都爲一集。俄兼寧遠湘東王長史，行府、國、郡事。除太子家令，復掌管記。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-liangshu-033-wangyun-rendered:p004:m0001","kind":"person","start":18,"end":22,"surface":"昭明太子","person_id":"cav_2xc_9bq_AAE","status":"contextual_provisional","source_role":"zhaoming"},{"id":"c-liangshu-033-wangyun-rendered:p004:m0002","kind":"person","start":29,"end":30,"surface":"筠","person_id":"7r6_k52_qji_ABAAAAEBDA","status":"contextual_provisional","source_role":"wangyun"},{"id":"c-liangshu-033-wangyun-rendered:p004:m0003","kind":"person","start":31,"end":34,"surface":"劉孝綽","person_id":"va5_2sy_7kk_AA","status":"contextual_provisional","source_role":"liu_xiaochuo"},{"id":"c-liangshu-033-wangyun-rendered:p004:m0004","kind":"person","start":35,"end":37,"surface":"陸倕","person_id":"9jp_jmf_6jv_**BAA","status":"contextual_provisional","source_role":"lu_chui"},{"id":"c-liangshu-033-wangyun-rendered:p004:m0005","kind":"person","start":38,"end":40,"surface":"到洽","person_id":"6bo_qfq_pl9_AAA","status":"contextual_provisional","source_role":"dao_qia"},{"id":"c-liangshu-033-wangyun-rendered:p004:m0006","kind":"person","start":41,"end":43,"surface":"殷芸","person_id":"8d4_fth_d4l","status":"contextual_provisional","source_role":"yin_yun"},{"id":"c-liangshu-033-wangyun-rendered:p004:m0007","kind":"person","start":49,"end":51,"surface":"太子","person_id":"cav_2xc_9bq_AAE","status":"contextual_provisional","source_role":"zhaoming"},{"id":"c-liangshu-033-wangyun-rendered:p004:m0008","kind":"person","start":53,"end":54,"surface":"筠","person_id":"7r6_k52_qji_ABAAAAEBDA","status":"contextual_provisional","source_role":"wangyun"},{"id":"c-liangshu-033-wangyun-rendered:p004:m0009","kind":"person","start":56,"end":58,"surface":"孝綽","person_id":"va5_2sy_7kk_AA","status":"contextual_provisional","source_role":"liu_xiaochuo"},{"id":"c-liangshu-033-wangyun-rende