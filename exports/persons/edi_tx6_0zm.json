{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"edi_tx6_0zm","canonical_person_id":"edi_tx6_0zm","id_aliases":["cbr-p004253"],"identity_policy":"contextual_provisional","person_ids":["edi_tx6_0zm"],"persons":[{"id":"edi_tx6_0zm","label":"召引功（白起王翦列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"召","mention_ids":["c-shiji-073-baiwang:m006-0138"]}],"evidence":[{"mention_id":"c-shiji-073-baiwang:m006-0138","chapter_id":"c-shiji-073-baiwang","paragraph_id":"c-shiji-073-baiwang:p006","quote":"召"}],"id_aliases":["cbr-p004253"]}],"source_mention_summary":[{"source_id":"s-shiji-073-baiwang","work_id":"w-shiji","book_id":"b-shiji-073","chapter_id":"c-shiji-073-baiwang","mention_count":1,"mention_ids":["c-shiji-073-baiwang:m006-0138"],"paragraph_ids":["c-shiji-073-baiwang:p006"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-073-baiwang"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-073-baiwang:m006-0138","start":138,"end":139,"surface":"召","kind":"person","person_id":"edi_tx6_0zm","status":"contextual_provisional","paragraph_id":"c-shiji-073-baiwang:p006","chapter_id":"c-shiji-073-baiwang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji073-022","person_id":"edi_tx6_0zm","scope":"same_chapter","chapter_ids":["c-shiji-073-baiwang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"依局部敘事明示姓名、受話稱呼與回指暫接，秦昭王敘事與秦始皇敘事分段，降秦趙王與鉅鹿趙王分候選。周召引功與呂望保存引古，不補周召全名；應侯、春申君及魏公子不從記憶補名。王翦王賁王離依明示分存，孫不推出父親；將軍受話按李信與王翦對話範圍辨認。王氏蒙氏及匿名說話者未全域接個別人物。","surfaces":["召"],"evidence":[{"paragraph_id":"c-shiji-073-baiwang:p006","quote":"四十八年十月，秦復定上黨郡。秦分軍為二：王龁攻皮牢，拔之；司馬梗定太原。韓、趙恐，使蘇代厚幣說秦相應侯曰：「武安君禽馬服子乎？」曰：「然。」又曰：「即圍邯鄲乎？」曰：「然。」「趙亡則秦王王矣，武安君為三公。武安君所為秦戰勝攻取者七十餘城，南定鄢、郢、漢中，北禽趙括之軍，雖周、召、呂望之功不益於此矣。今趙亡，秦王王，則武安君必為三公，君能為之下乎？雖無欲為之下，固不得已矣。秦嘗攻韓，圍邢丘，困上黨，上黨之民皆反為趙，天下不樂為秦民之日久矣。今亡趙，北地入燕，東地入齊，南地入韓、魏，則君之所得民亡幾何人。故不如因而割之，無以為武安君功也。」於是應侯言於秦王曰：「秦兵勞，請許韓、趙之割地以和，且休士卒。」王聽之，割韓垣雍、趙六城以和。正月，皆罷兵。武安君聞之，由是與應侯有隙。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-073-baiwang:p006","text":"四十八年十月，秦復定上黨郡。秦分軍為二：王龁攻皮牢，拔之；司馬梗定太原。韓、趙恐，使蘇代厚幣說秦相應侯曰：「武安君禽馬服子乎？」曰：「然。」又曰：「即圍邯鄲乎？」曰：「然。」「趙亡則秦王王矣，武安君為三公。武安君所為秦戰勝攻取者七十餘城，南定鄢、郢、漢中，北禽趙括之軍，雖周、召、呂望之功不益於此矣。今趙亡，秦王王，則武安君必為三公，君能為之下乎？雖無欲為之下，固不得已矣。秦嘗攻韓，圍邢丘，困上黨，上黨之民皆反為趙，天下不樂為秦民之日久矣。今亡趙，北地入燕，東地入齊，南地入韓、魏，則君之所得民亡幾何人。故不如因而割之，無以為武安君功也。」於是應侯言於秦王曰：「秦兵勞，請許韓、趙之割地以和，且休士卒。」王聽之，割韓垣雍、趙六城以和。正月，皆罷兵。武安君聞之，由是與應侯有隙。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-073-baiwang:m006-0020","start":20,"end":22,"surface":"王龁","kind":"person","person_id":"0th_8iq_2q0","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m006-0029","start":29,"end":32,"surface":"司馬梗","kind":"person","person_id":"ckv_ev3_1vi","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m006-0042","start":42,"end":44,"surface":"蘇代","kind":"person","person_id":"7c7_u2o_px7","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m006-0047","start":47,"end":51,"surface":"秦相應侯","kind":"person","person_id":"5av_w6l_zea","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m006-0054","start":54,"end":57,"surface":"武安君","kind":"person","person_id":"0xk_jpf_0xw","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m006-0058","start":58,"end":61,"surface":"馬服子","kind":"person","person_id":"l9s_24a_7a3","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m006-0091","start":91