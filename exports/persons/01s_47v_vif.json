"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-048-sun-hao:p017","text":"建衡元年春正月，立子瑾爲太子，及淮陽、東平王。冬十月，改年，大赦。十一月，左丞相陸凱卒。遣監軍虞汜、威南將軍薛珝、蒼梧太守陶璜由荊州，監軍李勗、督軍徐存從建安海道，皆就合浦擊交阯。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":66,"last_line":66,"raw_start":10624,"raw_end":10728,"raw_character_offsets":[10636,10637,10638,10639,10642,10643,10644,10645,10646,10647,10648,10649,10650,10651,10652,10653,10654,10655,10656,10657,10658,10659,10660,10661,10662,10663,10664,10665,10666,10667,10668,10669,10670,10671,10672,10673,10674,10675,10676,10677,10678,10679,10680,10681,10682,10683,10684,10685,10686,10687,10688,10689,10690,10691,10692,10693,10694,10695,10696,10697,10698,10699,10700,10701,10702,10703,10704,10705,10706,10707,10708,10709,10710,10711,10712,10713,10714,10715,10716,10717,10718,10719,10720,10721,10722,10723,10724,10725,10726,10727],"revision_id":2085142},"mentions":[{"id":"c-sanguozhi-048-sun-hao:p017:m0009","surface":"子瑾","start":9,"end":11,"kind":"person","person_id":"05e_9bb_55a_A","status":"contextual_provisional"},{"id":"c-sanguozhi-048-sun-hao:p017:m0040","surface":"陸凱","start":40,"end":42,"kind":"person","person_id":"61q_ogq_ueq","status":"contextual_provisional"},{"id":"c-sanguozhi-048-sun-hao:p017:m0069","surface":"李勗","start":69,"end":71,"kind":"person","person_id":"01s_47v_vif","status":"contextual_provisional"},{"id":"c-sanguozhi-048-sun-hao:p017:m0074","surface":"徐存","start":74,"end":76,"kind":"person","person_id":"6kt_lok_xhg","status":"contextual_provisional"}],"chapter_id":"c-sanguozhi-048-sun-hao","book_id":"b-sanguozhi-048","work_id":"w-sanguozhi","source_id":"s-sanguozhi-048-sun-hao-ws2085142"},{"id":"c-sanguozhi-048-sun-hao:p018","text":"二年春。萬彧還建業。李勗以建安道不通利，殺導將馮斐，引軍還。三月，天火燒萬餘家，死者七百人。夏四月，左大司馬施績卒。殿中列將何定曰：「少府李勗枉殺馮斐，擅徹軍退還。」勗及徐存家屬皆伏誅。秋九月，何定將兵五千人上夏口獵。都督孫秀奔晉。是歲大赦。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":68,"last_line":68,"raw_start":10730,"raw_end":10858,"raw_character_offsets":[10737,10738,10739,10740,10741,10742,10743,10744,10745,10746,10747,10748,10749,10750,10751,10752,10753,10754,10755,10756,10757,10758,10759,10760,10761,10762,10763,10764,10765,10766,10767,10768,10769,10770,10771,10772,10773,10774,10775,10776,10777,10778,10779,10780,10781,10782,10783,10784,10785,10786,10787,10788,10789,10790,10791,10792,10793,10794,10795,10796,10797,10798,10799,10800,10801,10802,10803,10804,10805,10806,10807,10808,10809,10810,10811,10812,10813,10814,10815,10816,10817,10818,10819,10820,10821,10822,10823,10824,10825,10826,10827,10828,10829,10830,10831,10832,10833,10834,10835,10836,10837,10838,10839,10840,10841,10842,10843,10844,10845,10846,10847,10848,10849,10850,10851,10852,10853,10854,10855,10856,10857],"revision_id":2085142},"mentions":[{"id":"c-sanguozhi-048-sun-hao:p018:m0004","surface":"萬彧","start":4,"end":6,"kind":"person","person_id":"bmy_4x8_vlh","status":"contextual_provisional"},{"id":"c-sanguozhi-048-sun-hao:p018:m0010","surface":"李勗","start":10,"end":12,"kind":"person","person_id":"01s_47v_vif","status":"contextual_provisional"},{"id":"c-sanguozhi-048-sun-hao:p018:m0023","surface":"馮斐","start":23,"end":25,"kind":"person","person_id":"qi3_ikf_dyd","status":"contextual_provisional"},{"id":"c-sanguozhi-048-sun-hao:p018:m0062","surface":"何定","start":62,"end":64,"kind":"person","person_id":"h6n_ozv_ytl","status":"contextual_provisional"},{"id":"c-sanguozhi-048-sun-hao:p018:m0069","surface":"李勗","start":69,"end":71,"kind":"person","person_id":"01s_47v_vif","status":"contextual_provisional"},{"id":"c-sanguozhi-048-sun-hao:p018:m0073","surface":"馮斐","start":73,"end":75,"kind":"person","person_id":"qi3_ikf_dyd","status":"contextual_provisional"},{"id":"c-sanguozhi-048-sun-hao:p018:m0083","surface":"勗","start":83,"end":84,"kind":"person","person_id":"01s_47v_vif","status":"contextual_provisional"},{"id":"c-sanguozhi-048-sun-hao:p018:m0085","surface":"徐存","start":85,"end":87,"kind":"person","person_id":"6kt_lok_xhg","status":"contextual_provisional"},{"id":"c-sanguozhi-048-sun-hao:p018:m0097","surface":"何定","start":97,"end":99,"kind":"person","person_id":"h6n_ozv_ytl","status":"contextual_provisional"},{"id":"c-sanguozhi-048-sun-hao:p018:m0111","surface":"孫秀","start":111,"end":113,"kind":"person","person_id":"icr_lwq_9mp_AA","status":"contextual_provisional"}],"chapter_id":"c-sanguozhi-048-sun-hao","book_id":"b-sanguozhi-048","work_id":"w-sanguozhi","source_id":"s-sanguozhi-048-sun-hao-ws2085142"},{"id":"c-sanguozhi-048-sun-hao:p025","text":"《江表傳》曰：定，汝南人，本孫權給使也，後出補吏。定佞邪僭媚，自表先帝舊人，求還內侍，皓以爲樓下都尉，典知酤糴事，專爲威福。而皓信任，委以衆事。定爲子求少府李勗女，不許。定挾忿譖勗於皓，皓尺口誅之，焚其尸。定又使諸將各上好犬，皆千里遠求，一犬至直數千匹。御犬率具纓，直錢一萬。一犬一兵，養以捕兎供厨。所獲無幾。吳人皆歸罪於定，而皓以爲忠勤，賜爵列侯。　《吳歷》曰：中書郎奚熙譖宛陵令賀惠。惠，劭弟也。遣使者徐粲訊治，熙又譖粲顧護不即決斷。皓遣使就宛陵斬粲，收惠付獄。會赦得免。","text_layer":"witness_appended_pei_songzhi_note","annotation_status":"reviewed","source_position":{"first_line":72,"last_line":72,"raw_start":12189,"raw_end":12431,"raw_character_offsets":[12189,12192,12193,12194,12197,12198,12199,12200,12201,12202,12203,12204,12205,12206,12207,12208,12209,12210,12211,12212,12213,12214,12215,12216,12217,12218,12219,12220,12221,12222,12223,12224,12225,12226,12227,12228,12229,12230,12231,12232,12233,12234,12235,12236,12237,12238,12239,12240,12241,12242,12243,12244,12245,12246,12247,12248,12249,12250,12251,12252,12253,12254,12255,12256,12257,12258,12259,12260,12261,12262,12263,12264,12265,12266,12267,12268,12269,12270,12271,12272,12273,12274,12275,12276,12277,12278,12279,12280,12281,12282,12283,12284,12285,12286,12287,12288,12289,12290,12291,12292,12293,12294,12295,12296,12297,12298,12299,12300,12301,12302,12303,12304,12305,12306,12307,12308,12309,12310,12311,12312,12313,12314,12315,12316,12317,12318,12319,12320,12321,12322,12323,12324,12325,12326,12327,12328,12329,12330,12331,12332,12333,12334,12335,12336,12337,12338,12339,12340,12341,12342,12343,12344,12345,12346,12347,12348,12349,12350,12351,12352,12353,12354,12355,12356,12357,12358,12359,12360,12361,12362,12363,12364,12365,12366,12367,12368,12369,12370,12371,12372,12373,12374,12375,12376,12377,12378,12379,12380,12381,12382,12383,12384,12385,12386,12387,12388,12389,12390,12391,12392,12393,12394,12395,12396,12397,12398,12399,12400,12401,12402,12403,12404,12405,12406,12407,12408,12409,12410,12411,12412,12413,12414,12415,12416,12417,12418,12419,12420,12421,12422,12423,12424,12425,12426,12427,12428,12429,12430],"revision_id":2085142},"mentions":[{"id":"c-sanguozhi-048-sun-hao:p025:m0014","surface":"孫權","start":14,"end":16,"kind":"person","person_id":"572_278_cba","status":"contextual_provisional"},{"id":"c-sanguozhi-048-sun-hao:p025:m0078","surface":"李勗","start":78,"end":80,"kind":"person","person_id":"01s_47v_vif","status":"contextual_provisional"},{"id":"c-sanguozhi-048-sun-hao:p025:m0185","surface":"奚熙","start":185,"end":187,"kind":"person","person_id":"vjc_vgm_hc3","status":"contextual_provisional"},{"id":"c-sanguozhi-048-sun-hao:p025:m0191","surface":"賀惠","start":191,"end":193,"kind":"person","person_id":"1zr_qhp_xhn","status":"contextual_provisional"},{"id":"c-sanguozhi-048-sun-hao:p025:m0203","surface":"徐粲","start":203,"end":205,"kind":"person","person_id":"bmb_892_2jj","status":"contextual_provisional"}],"chapter_id":"c-sanguozhi-048-sun-hao","book_id":"b-sanguozhi-048","work_id":"w-sanguozhi","source_id":"s-sanguozhi-048-sun-hao-ws2085142"},{"id":"c-sanguozhi-058-lukang:line075","text":"夫俊乂者，國家之良寶，社稷之貴資。庶政所以倫敘，四門所以穆清也。故大司農樓玄、散騎中常侍王蕃、少府李勖，皆當世秀穎，一時顯器，既蒙初寵，從容列位，而並旋受誅殛，或圮族替祀，或投棄荒裔。蓋《周禮》有赦賢之辟，《春秋》有宥善之義。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-058-lukang:line075:m0036","start":36,"end":38,"surface":"樓玄","kind":"person","person_id":"30b_08l_rxm","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-lukang:line075:m0044","start":44,"end":46,"surface":"王蕃","kind":"person","person_id":"z8o_i3j_zja","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"