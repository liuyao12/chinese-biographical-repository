n:p012"],"note":"兩篇遼西太守被殺、鴈門遭入及安國屯漁陽敘事相近，但本篇此事在右北平任官之前、卷108繫於李廣被俘敘事之明年；年代與事件對讀尚未完成，保留兩名未名候選，不補姓名或同指。","chapter_id":"c-shiji-109-liguang","source_id":"s-shiji-109-liguang"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-shiji109-liaoxi","person_id":"cl9_dgs_geu","event_type":"death","status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-109-liguang","source_id":"s-shiji-109-liguang","paragraph_id":"c-shiji-109-liguang:p006","quote":"匈奴入殺遼西太守","person_mention_id":"c-shiji-109-liguang:m006-0099"}],"interpretation_note":"保存原文明示被殺事件，日期未知，不據此推定其他官爵終點。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"mentions":[{"id":"c-shiji-109-liguang:m006-0099","start":99,"end":103,"surface":"遼西太守","kind":"person","person_id":"cl9_dgs_geu","status":"contextual_provisional","paragraph_id":"c-shiji-109-liguang:p006","chapter_id":"c-shiji-109-liguang"}],"relations":[],"title_holdings":[{"id":"th-shiji109-043","person_id":"cl9_dgs_geu","title":"遼西太守","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-109-liguang","source_id":"s-shiji-109-liguang","paragraph_id":"c-shiji-109-liguang:p006","quote":"頃之，家居數歳。廣家與故潁陰侯孫屏野居藍田南山中射獵。嘗夜從一騎出，從人田間飲。還至霸陵亭，霸陵尉醉，呵止廣。廣騎曰：「故李將軍。」尉曰：「今將軍尚不得夜行，何乃故也！」止廣宿亭下。居無何，匈奴入殺遼西太守，敗韓將軍，後韓將軍徙右北平。於是天子乃召拜廣爲右北平太守。廣即請霸陵尉與俱，至軍而斬之。"}],"attestations":[{"id":"th-shiji109-043:a001","paragraph_id":"c-shiji-109-liguang:p006","start":99,"end":103,"surface":"遼西太守","person_mention_id":"c-shiji-109-liguang:m006-0099","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"保存明示用稱或授任；故稱不重建現任，飛將軍為匈奴敘事稱，二千石為秩稱，四十餘年不推精確起訖。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-108-han:p012","text":"車騎將軍衞青擊匈奴，出上谷，破胡蘢城。將軍李廣爲匈奴所得，復失之；公孫敖大亡卒：皆當斬，贖爲庶人。明年，匈奴大入邊，殺遼西太守，及入鴈門，所殺略數千人。車騎將軍衞青擊之，出鴈門。衞尉安國爲材官將軍，屯於漁陽。安國捕生虜，言匈奴遠去。即上書言方田作時，請且罷軍屯。罷軍屯月餘，匈奴大入上谷、漁陽。安國壁乃有七百餘人，出與戰，不勝，復入壁。匈奴虜略千餘人及畜產而去。天子聞之，怒，使使責讓安國。徒安國益東，屯右北平。是時匈奴虜言當入東方。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-108-han:m012-0004","start":4,"end":6,"surface":"衞青","kind":"person","person_id":"5dd_l1c_6g8","status":"contextual_provisional"},{"id":"c-shiji-108-han:m012-0021","start":21,"end":23,"surface":"李廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-108-han:m012-0033","start":33,"end":36,"surface":"公孫敖","kind":"person","person_id":"zuf_oll_649","status":"contextual_provisional"},{"id":"c-shiji-108-han:m012-0059","start":59,"end":63,"surface":"遼西太守","kind":"person","person_id":"tpa_vui_ddb","status":"contextual_provisional"},{"id":"c-shiji-108-han:m012-0080","start":80,"end":82,"surface":"衞青","kind":"person","person_id":"5dd_l1c_6g8","status":"contextual_provisional"},{"id":"c-shiji-108-han:m012-0091","start":91,"end":93,"surface":"安國","kind":"person","person_id":"6hy_i1z_hu2","status":"contextual_provisional"},{"id":"c-shiji-108-han:m012-0104","start":104,"end":106,"surface":"安國","kind":"person","person_id":"6hy_i1z_hu2","status":"contextual_provisional"},{"id":"c-shiji-108-han:m012-0147","start":147,"end":149,"surface":"安國","kind":"person","person_id":"6hy_i1z_hu2","status":"contextual_provisional"},{"id":"c-shiji-108-han:m012-0181","start":181,"end":183,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-108-han:m012-0192","start":192,"end":194,"surface":"安國","kind":"person","person_id":"6hy_i1z_hu2","status":"contextual_provisional"},{"id":"c-shiji-108-han:m012-0196","start":196,"end":198,"surface":"安國","kind":"person","person_id":"6hy_i1z_hu2","status":"contextual_provisional"}],"chapter_id":"c-shiji-108-han","book_id":"b-shiji-108","work_id":"w-shiji","source_id":"s-shiji-108-han"},{"id":"c-shiji-109-liguang:p006","text":"頃之，家居數歳。廣家與故潁陰侯孫屏野居藍田南山中射獵。嘗夜從一騎出，從人田間飲。還至霸陵亭，霸陵尉醉，呵止廣。廣騎曰：「故李將軍。」尉曰：「今將軍尚不得夜行，何乃故也！」止廣宿亭下。居無何，匈奴入殺遼西太守，敗韓將軍，後韓將軍徙右北平。於是天子乃召拜廣爲右北平太守。廣即請霸陵尉與俱，至軍而斬之。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-109-liguang:m006-0008","start":8,"end":9,"surface":"廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m006-0012","start":12,"end":15,"surface":"潁陰侯","kind":"person","person_id":"gqv_vyi_jao","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m006-0015","start":15,"end":16,"surface":"孫","kind":"person","person_id":"gqv_vyi_jao_*A","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m006-0030","start":30,"end":32,"surface":"一騎","kind":"person","person_id":"8tg_glo_yg2","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m006-0034","start":34,"end":36,"surface":"從人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-109-liguang:m006-0046","start":46,"end":49,"surface":"霸陵尉","kind":"person","person_id":"b3j_bwz_6eq","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m006-0053","start":53,"end":54,"surface":"廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m006-0055","start":55,"end":56,"surface":"廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m006-0056","start":56,"end":57,"surface":"騎","kind":"person","person_id":"8tg_glo_yg2","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m006-0061","start":61,"end":64,"surface":"李將軍","kind":"person","person_id":"27j_f4p_jwp","status":"cont