xtual_provisional"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-005-qin:p004","text":"非子居犬丘，好馬及畜，善養息之。犬丘人言之周孝王，孝王召使主馬于汧渭之間，馬大蕃息。孝王欲以為大駱適嗣。申侯之女為大駱妻，生子成為適。申侯乃言孝王曰：「昔我先酈山之女，為戎胥軒妻，生中潏，以親故歸周，保西垂，西垂以其故和睦。今我復與大駱妻，生適子成。申駱重婚，西戎皆服，所以為王。王其圖之。」於是孝王曰：「昔伯翳為舜主畜，畜多息，故有土，賜姓嬴。今其後世亦為朕息馬，朕其分土為附庸。」邑之秦，使復續嬴氏祀，號曰秦嬴。亦不廢申侯之女子為駱適者，以和西戎。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m004-0000","start":0,"end":2,"surface":"非子","kind":"person","person_id":"cbr-p000334","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m004-0021","start":21,"end":24,"surface":"周孝王","kind":"person","person_id":"cbr-p000206","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m004-0025","start":25,"end":27,"surface":"孝王","kind":"person","person_id":"cbr-p000206","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m004-0042","start":42,"end":44,"surface":"孝王","kind":"person","person_id":"cbr-p000206","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m004-0047","start":47,"end":49,"surface":"大駱","kind":"person","person_id":"cbr-p000333","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m004-0052","start":52,"end":54,"surface":"申侯","kind":"person","person_id":"cbr-p000335","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m004-0055","start":55,"end":56,"surface":"女","kind":"person","person_id":"cbr-p000366","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m004-0057","start":57,"end":59,"surface":"大駱","kind":"person","person_id":"cbr-p000333","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m004-0063","start":63,"end":64,"surface":"成","kind":"person","person_id":"cbr-p000336","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m004-0067","start":67,"end":69,"surface":"申侯","kind":"person","person_id":"cbr-p000335","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m004-0071","start":71,"end":73,"surface":"孝王","kind":"person","person_id":"cbr-p000206","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m004-0079","start":79,"end":83,"surface":"酈山之女","kind":"person","person_id":"cbr-p000337","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m004-0085","start":85,"end":88,"surface":"戎胥軒","kind":"person","person_id":"cbr-p000338","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m004-0091","start":91,"end":93,"surface":"中潏","kind":"person","person_id":"cbr-p000322","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m004-0116","start":116,"end":118,"surface":"大駱","kind":"person","person_id":"cbr-p000333","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m004-0123","start":123,"end":124,"surface":"成","kind":"person","person_id":"cbr-p000336","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m004-0148","start":148,"end":150,"surface":"孝王","kind":"person","person_id":"cbr-p000206","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m004-0154","start":154,"end":156,"surface":"伯翳","kind":"person","person_id":"cbr-p000316","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m004-0157","start":157,"end":158,"surface":"舜","kind":"person","person_id":"cbr-p000030","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m004-0174","start":174,"end":177,"surface":"其後世","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或未核定指代；未由熟知世系補造人物。"},{"id":"c-shiji-005-qin:m004-0205","start":205,"end":207,"surface":"秦嬴","kind":"person","person_id":"cbr-p000334","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m004-0211","start":211,"end":213,"surface":"申侯","kind":"person","person_id":"cbr-p000335","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m004-0214","start":214,"end":215,"surface":"女","kind":"person","person_id":"cbr-p000366","status":"contextual_provisional"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-005-qin:p005","text":"秦嬴生秦侯。秦侯立十年，卒。生公伯。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m005-0000","start":0,"end":2,"surface":"秦嬴","kind":"person","person_id":"cbr-p000334","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m005-0003","start":3,"end":5,"surface":"秦侯","kind":"person","person_id":"cbr-p000339","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m005-0006","start":6,"end":8,"surface":"秦侯","kind":"person","person_id":"cbr-p000339","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m005-0015","start":15,"end":17,"surface":"公伯","kind":"person","person_id":"cbr-p000340","status":"contextual_provisional"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-005-qin:p010","text":"文公元年，居西垂宮。三年，文公以兵七百人東獵。四年，至汧渭之會。曰：「昔周邑我先秦嬴於此，後卒獲為諸侯。」乃卜居之，占曰吉，即營邑之。十年，初為鄜畤，用三牢。十三年，初有史以紀事，民多化者。十六年，文公以兵伐戎，戎敗走。於是文公遂收周餘民有之，地至岐，岐以東獻之周。十九年，得陳寶。二十年，法初有三族之罪。二十七年，伐南山大梓，豐大特。四十八年，文公太子卒，賜謚為竫公。竫公之長子為太子，是文公孫也。五十年，文公卒，葬西山。竫公子立，是為寧公。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m010-0000","start":0,"end":2,"surface":"文公","kind":"person","person_id":"cbr-p000347","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m010-0013","start":13,"end":15,"surface":"文公","kind":"person","person_id":"cbr-p000347","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m010-0040","start":40,"end":42,"surface":"秦嬴","kind":"person","person_id":"cbr-p000334","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m010-0099","start":99,"end":101,"surface":"文公","kind":"person","person_id":"cbr-p000347","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m010-0112","start":112,"end":114,"surface":"文公","kind":"person","person_id":"cbr-p000347","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m010-0173","start":173,"end":175,"surface":"文公","kind":"person","person_id":"cbr-p000347","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m010-0182","start":182,"e