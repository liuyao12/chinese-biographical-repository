8_1y0","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m019-0321","start":321,"end":324,"surface":"成安君","kind":"person","person_id":"qdr_5yn_8kr","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m019-0336","start":336,"end":339,"surface":"大夫種","kind":"person","person_id":"xp8_oo8_cjo","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m019-0340","start":340,"end":342,"surface":"范蠡","kind":"person","person_id":"y5m_als_o73","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m019-0344","start":344,"end":346,"surface":"句踐","kind":"person","person_id":"epq_pym_fky","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m019-0400","start":400,"end":402,"surface":"魏王","kind":"person","person_id":"d9u_3uy_sms","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m019-0404","start":404,"end":406,"surface":"夏說","kind":"person","person_id":"4hf_tdv_ju8","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m019-0414","start":414,"end":417,"surface":"成安君","kind":"person","person_id":"qdr_5yn_8kr","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m019-0439","start":439,"end":441,"surface":"龍且","kind":"person","person_id":"xxs_ub0_7rv","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m019-0532","start":532,"end":534,"surface":"韓信","kind":"person","person_id":"v8v_2nz_wdy","status":"contextual_provisional"}],"chapter_id":"c-shiji-092-hanxin","book_id":"b-shiji-092","work_id":"w-shiji","source_id":"s-shiji-092-hanxin"},{"id":"c-shiji-092-hanxin:p020","text":"後數日，蒯通復說曰：『夫聽者事之候也，計者事之機也，聽過計失而能久安者，鮮矣。聽不失一二者，不可亂以言；計不失本末者，不可紛以辭。夫隨廝養之役者，失萬乘之權；守儋石之祿者，闕卿相之位。故知者決之斷也，疑者事之害也，審豪氂之小計，遺天下之大數，智誠知之，決弗敢行者，百事之禍也。故曰「猛虎之猶豫，不若蜂蠆之致螫；騏驥之跼躅，不如駑馬之安步；孟賁之狐疑，不如庸夫之必至也；雖有舜禹之智，吟而不言，不如瘖聾之指麾也」。此言貴能行之。夫功者難成而易敗，時者難得而易失也。時乎時，不再來。願足下詳察之。』韓信猶豫不忍倍漢，又自以爲功多，漢終不奪我齊，遂謝蒯通。蒯通說不聽，已詳狂爲巫。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-092-hanxin:m020-0004","start":4,"end":6,"surface":"蒯通","kind":"person","person_id":"x9q_ghs_z2s","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m020-0169","start":169,"end":171,"surface":"孟賁","kind":"person","person_id":"7oz_44p_91g","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m020-0186","start":186,"end":187,"surface":"舜","kind":"person","person_id":"gnq_vre_5v8","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m020-0187","start":187,"end":188,"surface":"禹","kind":"person","person_id":"1by_i1o_3pu","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m020-0247","start":247,"end":249,"surface":"韓信","kind":"person","person_id":"v8v_2nz_wdy","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m020-0272","start":272,"end":274,"surface":"蒯通","kind":"person","person_id":"x9q_ghs_z2s","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m020-0275","start":275,"end":277,"surface":"蒯通","kind":"person","person_id":"x9q_ghs_z2s","status":"contextual_provisional"}],"chapter_id":"c-shiji-092-hanxin","book_id":"b-shiji-092","work_id":"w-shiji","source_id":"s-shiji-092-hanxin"},{"id":"c-shiji-092-hanxin:p025","text":"陳豨拜爲鉅鹿守，辭於淮陰侯。淮陰侯挈其手，辟左右與之步於庭，仰天歎曰：『子可與言乎？欲與子有言也。』豨曰：『唯將軍令之。』淮陰侯曰：『公之所居，天下精兵處也；而公，陛下之信幸臣也。人言公之畔，陛下必不信；再至，陛下乃疑矣；三至，必怒而自將。吾爲公從中起，天下可圖也。』陳豨素知其能也，信之，曰：『謹奉教！』漢十年，陳豨果反。上自將而往，信病不從。陰使人至豨所，曰：『弟舉兵，吾從此助公。』信乃謀與家臣夜詐詔赦諸官徒奴，欲發以襲呂后、太子。部署已定，待豨報。其舍人得罪於信，信囚，欲殺之。舍人弟上變，告信欲反狀於呂后。呂后欲召，恐其黨不就，乃與蕭相國謀，詐令人從上所來，言豨已得死，列侯群臣皆賀。相國紿信曰：『雖疾，彊入賀。』信入，呂后使武士縛信，斬之長樂鐘室。信方斬，曰：『吾悔不用蒯通之計，乃爲兒女子所詐，豈非天哉！』遂夷信三族。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-092-hanxin:m025-0000","start":0,"end":2,"surface":"陳豨","kind":"person","person_id":"fgp_e4n_xnh","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m025-0010","start":10,"end":13,"surface":"淮陰侯","kind":"person","person_id":"v8v_2nz_wdy","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m025-0014","start":14,"end":17,"surface":"淮陰侯","kind":"person","person_id":