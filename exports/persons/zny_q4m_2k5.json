{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"zny_q4m_2k5","canonical_person_id":"zny_q4m_2k5","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["zny_q4m_2k5"],"persons":[{"id":"zny_q4m_2k5","label":"範賁〔隗文等所立〕","status":"active","historicity":"historical_tradition","aliases":[{"surface":"賁","mention_ids":["c-jinshu-058-zhou-fu:p002:m0224"]}],"evidence":[{"mention_id":"c-jinshu-058-zhou-fu:p002:m0224","paragraph_id":"c-jinshu-058-zhou-fu:p002","chapter_id":"c-jinshu-058-zhou-fu","quote":"賁"}],"review":"ai_provisional","identity_note":"範賁〔隗文等所立〕，見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-jinshu-058-zhou-fu-ws1775463","work_id":"w-jinshu","book_id":"b-jinshu-058","chapter_id":"c-jinshu-058-zhou-fu","raw_mention_count":1,"mention_ids":["c-jinshu-058-zhou-fu:p002:m0224"],"paragraph_ids":["c-jinshu-058-zhou-fu:p002"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-058-zhou-fu:p002:m0224","mention_ids":["c-jinshu-058-zhou-fu:p002:m0224"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-058-zhou-fu-ws1775463"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-058-zhou-fu:p002:m0224","surface":"賁","start":224,"end":225,"person_id":"zny_q4m_2k5","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-058-zhou-fu:p002","chapter_id":"c-jinshu-058-zhou-fu"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-058-zhou-fu:p002","text":"咸和初，司徒王導以撫爲從事中郎，出爲甯遠將軍、江夏相。蘇峻作逆，率所領從溫嶠討之。峻平，遷監沔北軍事、南中郎將，鎮襄陽。石勒將郭敬率騎攻撫，撫不能守，率所領奔於武昌，坐免官。尋遷振威將軍、豫章太守，後代毌丘奧監巴東諸軍事、益州刺史、假節，將軍如故。尋進征虜將軍，加督甯州諸軍事。永和初，桓溫征蜀，進撫督梁州之漢中、巴西、梓潼、陰平四郡軍事，鎮彭模。撫擊破蜀余寇隗文、鄧定等，斬偽尚書僕射王誓、平南將軍王潤，以功遷平西將軍。隗文、鄧定等復反，立範賢子賁爲帝。初，賢爲李雄國師，以左道惑百姓，人多事之，賁遂有眾一萬。撫與龍驤將軍硃燾擊破斬之，以功進爵建城縣公。征西督護蕭敬文作亂，殺征虜將軍楊謹，據涪城，自號益州牧。恆溫使督護鄧遐助撫討之，不能拔，引退。溫又令梁州刺史司馬勳等會撫伐之。敬文固守，自二月至於八月，乃出降，撫斬之，傳首京師。升平中，進鎮西將軍。在州三十餘年，興寧三年卒，贈征西將軍，諡曰襄。子楚嗣。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":84,"last_line":84,"raw_start":7940,"raw_end":8381,"raw_character_offsets":[7942,7943,7944,7945,7946,7947,7948,7949,7950,7951,7952,7953,7954,7955,7956,7957,7958,7959,7960,7961,7962,7963,7964,7965,7966,7967,7968,7969,7970,7971,7972,7973,7974,7975,7976,7977,7978,7979,7980,7981,7982,7983,7984,7985,7986,7987,7988,7989,7990,7991,7992,7993,7994,7995,7996,7997,7998,7999,8000,8001,8002,8003,8004,8005,8006,8007,8008,8009,8010,8011,8012,8013,8014,8015,8016,8017,8018,8019,8020,8023,8026,8027,8028,8029,8030,8031,8032,8033,8034,8035,8036,8037,8038,8039,8040,8041,8042,8043,8044,8047,8050,8051,8052,8053,8054,8055,8056,8057,8058,8059,8060,8061,8062,8063,8064,8065,8066,8067,8068,8069,8070,8071,8072,8073,8074,8075,8078,8081,8082,8083,8084,8085,8086,8087,8088,8089,8090,8091,8092,8093,8094,8095,8096,8097,8098,8101,8104,8105,8106,8107,8108,8109,8110,8111,8112,8113,8114,8115,8116,8117,8118,8119,8120,8121,8122,8123,8124,8125,8126,8127,8128,8129,8130,8131,8132,8133