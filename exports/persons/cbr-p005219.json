"},{"id":"c-shiji-094-tiandan:m003-0030","start":30,"end":32,"surface":"章邯","kind":"person","person_id":"504_piy_j5v","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0045","start":45,"end":47,"surface":"田儋","kind":"person","person_id":"j80_2bm_4af","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0052","start":52,"end":53,"surface":"儋","kind":"person","person_id":"j80_2bm_4af","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0054","start":54,"end":56,"surface":"田榮","kind":"person","person_id":"t9b_1eg_mqs","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0057","start":57,"end":58,"surface":"儋","kind":"person","person_id":"j80_2bm_4af","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0069","start":69,"end":71,"surface":"田儋","kind":"person","person_id":"j80_2bm_4af","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0076","start":76,"end":79,"surface":"齊王建","kind":"person","person_id":"30v_zf2_l7l","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0081","start":81,"end":83,"surface":"田假","kind":"person","person_id":"wrp_npf_kym","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0087","start":87,"end":89,"surface":"田角","kind":"person","person_id":"rz7_xfo_xse","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0092","start":92,"end":94,"surface":"田間","kind":"person","person_id":"dgh_7wa_4c5","status":"contextual_provisional"}],"chapter_id":"c-shiji-094-tiandan","book_id":"b-shiji-094","work_id":"w-shiji","source_id":"s-shiji-094-tiandan"},{"id":"c-shiji-094-tiandan:p004","text":"田榮之走東阿，章邯追圍之。項梁聞田榮之急，乃引兵擊破章邯軍東阿下。章邯走而西，項梁因追之。而田榮怒齊之立假，乃引兵歸，擊逐齊王假。假亡走楚。齊相角亡走趙；角弟田閒前求救趙，因留不敢歸。田榮乃立田儋子市為齊王。榮相之，田橫為將，平齊地。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-094-tiandan:m004-0000","start":0,"end":2,"surface":"田榮","kind":"person","person_id":"t9b_1eg_mqs","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0007","start":7,"end":9,"surface":"章邯","kind":"person","person_id":"504_piy_j5v","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0013","start":13,"end":15,"surface":"項梁","kind":"person","person_id":"8h7_82d_vjr","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0016","start":16,"end":18,"surface":"田榮","kind":"person","person_id":"t9b_1eg_mqs","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0026","start":26,"end":28,"surface":"章邯","kind":"person","person_id":"504_piy_j5v","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0033","start":33,"end":35,"surface":"章邯","kind":"person","person_id":"504_piy_j5v","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0039","start":39,"end":41,"surface":"項梁","kind":"person","person_id":"8h7_82d_vjr","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0046","start":46,"end":48,"surface":"田榮","kind":"person","person_id":"t9b_1eg_mqs","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0052","start":52,"end":53,"surface":"假","kind":"person","person_id":"wrp_npf_kym","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0061","start":61,"end":64,"surface":"齊王假","kind":"person","person_id":"wrp_npf_kym","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0065","start":65,"end":66,"surface":"假","kind":"person","person_id":"wrp_npf_kym","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0070","start":70,"end":73,"surface":"齊相角","kind":"person","person_id":"rz7_xfo_xse","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0079","start":79,"end":81,"surface":"田閒","kind":"person","person_id":"v0s_cot_5c5","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0092","start":92,"end":94,"surface":"田榮","kind":"person","person_id":"t9b_1eg_mqs","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0096","start":96,"end":100,"surface":"田儋子市","kind":"person","person_id":"j80_2bm_4af_A","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0104","start":104,"end":105,"surface":"榮","kind":"person","person_id":"t9b_1eg_mqs","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0108","start":108,"end":110,"surface":"田橫","kind":"person","person_id":"gcd_ek1_6jn","status":"contextual_provisional"}],"chapter_id":"c-shiji-094-tiandan","book_id":"b-shiji-094","work_id":"w-shiji","source_id":"s-shiji-094-tiandan"},{"id":"c-shiji-094-tiandan:p005","text":"項梁既追章邯，章邯兵益盛，項梁使使告趙、齊，發兵共擊章邯。田榮曰：「使楚殺田假，趙殺田角、田閒，閒肯出兵。」楚懷王曰：「田假與國之王，窮而歸我，殺之不義。」趙亦不殺田角、田閒以市於齊。齊曰：「蝮螫手則斬手，螫足則斬足。何者？為害於身也。今田假、田角、田閒於楚、趙，非直手足戚也，何故不殺？且秦復得志於天下，則齮齕用事者墳墓矣。」楚、趙不聽，齊亦怒，終不肯出兵。章邯果敗殺項梁，破楚兵，楚兵東走，而章邯渡河圍趙於鉅鹿。項羽往救趙，由此怨田榮。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-094-tiandan:m005-0000","start":0,"end":2,"surface":"項梁","kind":"person","person_id":"8h7_82d_vjr","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m005-0004","start":4,"end":6,"surface":"章邯","kind":"person","person_id":"504_piy_j5v","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m005-0007","start":7,"end":9,"surface":"章邯","kind":"person","person_id":"504_piy_j5v","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m005-0013","start":13,"end":15,"surface":"項梁","kind":"person","person_id":"8h7_82d_vjr","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m005-0026","start":26,"end":28,"surface":"章邯","kind":"person","person_id":"504_piy_j5v","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m005-0029","start":29,"end":31,"surface":"田榮","kind":"person","person_id":"t9b_1eg_mqs","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m005-0037","start":37,"end":39,"surface":"田假","kind":"person","person_id":"wrp_npf_kym","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m005-0042","start":42,"end":44,"surf