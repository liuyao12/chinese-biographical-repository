ishu-057-northern-wei-complete:p014:m0035","c-nanqishu-057-northern-wei-complete:p035:m0011"],"paragraph_ids":["c-nanqishu-057-northern-wei-complete:p014","c-nanqishu-057-northern-wei-complete:p035"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-nanqishu-057-northern-wei-complete:p014:m0004","mention_ids":["c-nanqishu-057-northern-wei-complete:p014:m0004"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-057-northern-wei-complete:p014:m0016","mention_ids":["c-nanqishu-057-northern-wei-complete:p014:m0016"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-057-northern-wei-complete:p014:m0027","mention_ids":["c-nanqishu-057-northern-wei-complete:p014:m0027"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-057-northern-wei-complete:p014:m0035","mention_ids":["c-nanqishu-057-northern-wei-complete:p014:m0035"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-057-northern-wei-complete:p035:m0011","mention_ids":["c-nanqishu-057-northern-wei-complete:p035:m0011"],"kind":"paragraph"}],"mention_count":5,"duplicate_mention_count":0,"paragraph_occurrence_count":5,"table_occurrence_count":0,"passage_count":2,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"5處獨立位置，5個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-nanqishu-057-northern-wei-complete-ws1999801"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-nanqishu-057-northern-wei-complete:source_review14-0","kind":"source_review","person_id":"d91_oe3_mrc","source_quote":"偽昌黎王馮莎向司州，荒人桓天生說莎云：「諸蠻皆響應。」莎至，蠻竟不動。莎大怒，於淮邊獵而去。及壽春摧敗，朐山不拔，虜主出定州，大治道路，聲欲南行，不敢進。迺與偽梁郡王計曰：「兵出彭、泗間，無復鬬志，要當一兩戰得還歸。」既於淮陽被破，一時奔走。青、徐間赴義民，先是或抄虜運車，更相殺掠，往往得南歸者數千家。","reading":"馮莎與桓天生和司州敘事依原人分；定州治道、淮陽兵敗及青徐之人另是形勢。","note":"馮莎與桓天生和司州敘事依原人分；定州治道、淮陽兵敗及青徐之人另是形勢。","paragraph_id":"c-nanqishu-057-northern-wei-complete:p014","start_codepoint":0,"end_codepoint":152,"human_reviewed":false,"chapter_id":"c-nanqishu-057-northern-wei-complete","source_id":"s-nanqishu-057-northern-wei-complete-ws1999801"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-qi057-feng-elder-father","subject_person_id":"m8o_vkl_aua","object_person_id":"d91_oe3_mrc","predicate":"father","qualifiers":{"source_term":"昌黎王馮莎二女"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-057","chapter_id":"c-nanqishu-057-northern-wei-complete","source_id":"s-nanqishu-057-northern-wei-complete-ws1999801","paragraph_id":"c-nanqishu-057-northern-wei-complete:p035","quote":"初，偽太后馮氏兄昌黎王馮莎二女，大馮美而有疾，為尼，小馮為宏皇后，生偽太子詢。後大馮疾差，宏納為昭儀。宏初徙都，詢意不樂，思歸桑乾。宏制衣冠與之，詢竊毀裂，解髮為編服左衽。大馮有寵，日夜讒詢。宏出鄴城馬射，詢因是欲叛北歸，密選宮中御馬三千疋置河陰渚。皇后聞之，召執詢，馳使告宏，宏徙詢無鼻城，在河橋北二里，尋殺之，以庶人禮葬。立大馮為皇后，便立偽太子恪，是歲，偽太和二十年也。","subject_person_mention_id":"c-nanqishu-057-northern-wei-complete:p035:m0016","object_person_mention_id":"c-nanqishu-057-northern-wei-complete:p035:m0011"}],"status":"source_attested","interpretation_note":"齊書作馮莎，魏書同官系統馮熙另校。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"a-qi057-feng-younger-father","subject_person_id":"qfs_0c0_p7d","object_person_id":"d91_oe3_mrc","predicate":"father","qualifiers":{"source_term":"昌黎王馮莎二女"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-057","chapter_id":"c-nanqishu-057-northern-wei-complete","source_id":"s-nanqishu-057-northern-wei-complete-ws1999801","paragraph_id":"c-nanqishu-057-northern-wei-complete:p035","quote":"初，偽太后馮氏兄昌黎王馮莎二女，大馮美而有疾，為尼，小馮為宏皇后，生偽太子詢。後大馮疾差，宏納為昭儀。宏初徙都，詢意不樂，思歸桑乾。宏制衣冠與之，詢竊毀裂，解髮為編服左衽。大馮有寵，日夜讒詢。宏出鄴城馬射，詢因是欲叛北歸，密選宮中御馬三千疋置河陰渚。皇后聞之，召執詢，馳使告宏，宏徙詢無鼻城，在河橋北二里，尋殺之，以庶人禮葬。立大馮為皇后，便立偽太子恪，是歲，偽太和二十年也。","subject_person_mention_id":"c-nanqishu-057-northern-wei-complete:p035:m0026","object_person_mention_id":"c-nanqishu-057-northern-wei-complete:p035:m0011"}],"status":"source_attested","interpretation_note":"同段分大小馮。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-057-northern-wei-complete:p014:m0004","start":4,"end":6,"surface":"馮莎","kind":"person","person_id":"d91_oe3_mrc","status":"contextual_provisional","paragraph_id":"c-nanqishu-057-northern-wei-complete:p014","chapter_id":"c-nanqishu-057-northern-wei-complete"},{"id":"c-nanqishu-057-northern-wei-complete:p014:m0016","start":16,"end":17,"surface":"莎","kind":"person","person_id":"d91_oe3_mrc","status":"contextual_provisional","paragraph_id":"c-nanqishu-057-northern-wei-complete:p014","chapter_id":"c-nanqishu-057-northern-wei-complete"},{"id":"c-nanqishu-057-northern-wei-complete:p014:m0027","start":27,"end":28,"surface":"莎","kind":"person","person_id":"d91_oe3_mrc","status":"contextual_provisional","paragraph_id":"c-nanqishu-057-northern-wei-complete:p014","chapter_id":"c-nanqishu-057-northern-wei-complete"},{"id":"c-nanqishu-057-northern-wei-complete:p014:m0035","start":35,"end":36,"surface":"莎","kind":"person","person_id":"d91_oe3_mrc","status":"contextual_provisional","paragraph_id":"c-nanqishu-057-northern-wei-complete:p014","chapter_id":"c-nanqishu-057-northern-wei-complete"},{"id":"c-nanqishu-057-northern-wei-complete:p035:m0011","start":11,"end":13,"surface":"馮莎","kind":"person","person_id":"d91_oe3_mrc","status":"contextual_provisional","paragraph_id":"c-nanqishu-057-northern-wei-complete:p035","chapter_id":"c-nanqishu-057-northern-wei-complete"}],"relations":[{"id":"a-qi057-feng-elder-father","subject_person_id":"m8o_vkl_aua","object_person_id":"d91_oe3_mrc","predicate":"father","qualifiers":{"source_term":"昌黎王馮莎二女"},"evidence":[{"work_i