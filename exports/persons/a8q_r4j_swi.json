urface":"棄","kind":"person","person_id":"ys8_rdi_f0i","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m016-0003","start":3,"end":4,"surface":"稷","kind":"person","person_id":"ys8_rdi_f0i","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m016-0007","start":7,"end":9,"surface":"西伯","kind":"person","person_id":"yi5_jym_uoz","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m016-0010","start":10,"end":12,"surface":"武王","kind":"person","person_id":"a8q_r4j_swi","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m016-0020","start":20,"end":22,"surface":"幽厲","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-130-taishigong:m016-0033","start":33,"end":34,"surface":"赧","kind":"person","person_id":"esj_qgu_9r9","status":"contextual_provisional"}],"chapter_id":"c-shiji-130-taishigong","book_id":"b-shiji-130","work_id":"w-shiji","source_id":"s-shiji130-taishigong"},{"id":"c-shiji-130-taishigong:p037","text":"非兵不彊，非德不昌，黃帝、湯、武以興，桀、紂、二世以崩，可不慎歟？司馬法所從來尚矣，太公、孫、吳、王子能紹而明之，切近世，極人變。作律書第三。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m037-0010","start":10,"end":12,"surface":"黃帝","kind":"person","person_id":"ocd_ibe_at1","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m037-0013","start":13,"end":14,"surface":"湯","kind":"person","person_id":"0np_0mp_q1l","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m037-0015","start":15,"end":16,"surface":"武","kind":"person","person_id":"a8q_r4j_swi","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m037-0019","start":19,"end":20,"surface":"桀","kind":"person","person_id":"91n_mvc_uix","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m037-0021","start":21,"end":22,"surface":"紂","kind":"person","person_id":"y3l_45z_mfp","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m037-0023","start":23,"end":25,"surface":"二世","kind":"person","person_id":"hem_zeh_251","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m037-0042","start":42,"end":44,"surface":"太公","kind":"person","person_id":"hnu_8zd_5n9","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m037-0045","start":45,"end":46,"surface":"孫","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-130-taishigong:m037-0047","start":47,"end":48,"surface":"吳","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-130-taishigong:m037-0049","start":49,"end":51,"surface":"王子","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-130-taishigong","book_id":"b-shiji-130","work_id":"w-shiji","source_id":"s-shiji130-taishigong"},{"id":"c-shiji-130-taishigong:p046","text":"武王克紂，天下未協而崩。成王既幼，管蔡疑之，淮夷叛之，於是召公率德，安集王室，以寧東土。燕噲之禪，乃成禍亂。嘉甘棠之詩，作燕世家第四。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m046-0000","start":0,"end":2,"surface":"武王","kind":"person","person_id":"a8q_r4j_swi","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m046-0003","start":3,"end":4,"surface":"紂","kind":"person","person_id":"y3l_45z_mfp","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m046-0012","start":12,"end":14,"surface":"成王","kind":"person","person_id":"9mr_can_2hq","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m046-0017","start":17,"end":19,"surface":"管蔡","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-130-taishigong:m046-0029","start":29,"end":31,"surface":"召公","kind":"person","person_id":"w26_or9_i7l","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m046-0044","start":44,"end":46,"surface":"燕噲","kind":"person","person_id":"whn_b4z_p9v","status":"contextual_provisional"}],"chapter_id":"c-shiji-130-taishigong","book_id":"b-shiji-130","work_id":"w-shiji","source_id":"s-shiji130-taishigong"},{"id":"c-shiji-130-taishigong:p051","text":"武王既崩，叔虞邑唐。君子譏名，卒滅武公。驪姬之愛，亂者五世；重耳不得意，乃能成霸。六卿專權，晉國以秏。嘉文公錫珪鬯，作晉世家第九。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m051-0000","start":0,"end":2,"surface":"武王","kind":"person","person_id":"a8q_r4j_swi","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m051-0005","start":5,"end":7,"surface":"叔虞","kind":"person","person_id":"5js_3ib_k9o","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m051-0017","start":17,"end":19,"surface":"武公","kind":"person","person_id":"55n_duj_naz","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m051-0020","start":20,"end":22,"surface":"驪姬","kind":"person","person_id":"mzj_kli_tfn","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m051-0030","start":30,"end":32,"surface":"重耳","kind":"person","person_id":"xnk_yt8_2uc","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m051-0041","start":41,"end":43,"surface":"六卿","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-130-taishigong:m051-0052","start":52,"end":54,"surface":"文公","kind":"person","person_id":"xnk_yt8_2uc","status":"contextual_provisional"}],"chapter_id":"c-shiji-130-taishigong","book_id":"b-shiji-130","work_id":"w-shiji","source_id":"s-shiji130-taishigong"},{"id":"c-shiji-130-taishigong:p060","text":"桀、紂失其道而湯、武作，周失其道而春秋作。秦失其政，而陳涉發跡，諸侯作難，風起雲蒸，卒亡秦族。天下之端，自涉發難。作陳涉世家第十八。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m060-0000","start":0,"end":1,"surface":"桀","kind":"person","person_id":"91n_mvc_uix","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m060-0002","start":2,"end":3,"surface":"紂","kind":"person","person_id":"y3l_45z_mfp","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m060-0007","start":7,"end":8,"surface":"湯","kind":"person","person_id":"0np_0mp_q1l","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m060-0009","start":9,"end