:"cbr-p004634","status":"contextual_provisional","paragraph_id":"c-shiji-081-lianlin:p026","chapter_id":"c-shiji-081-lianlin"},{"id":"c-shiji-081-lianlin:m026-0105","start":105,"end":108,"surface":"趙王遷","kind":"person","person_id":"cbr-p004634","status":"contextual_provisional","paragraph_id":"c-shiji-081-lianlin:p026","chapter_id":"c-shiji-081-lianlin"}],"relations":[{"id":"a-shiji043-063","subject_person_id":"cbr-p002490","predicate":"father","object_person_id":"cbr-p002480","status":"source_attested","evidence":[{"chapter_id":"c-shiji-043-zhao","source_id":"s-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p115","quote":"九年，趙攻燕，取貍、陽城。兵未罷，秦攻鄴，拔之。悼襄王卒，子幽繆王遷立。"}],"qualifiers":{"source_term":"子幽繆王遷立","historicity":"historical_tradition"},"interpretation_note":"明示子、適子、其母保存來源主張；太史公所引馮王孫是引述敘事，未當獨立多份證據，嬖不推法定配偶。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji043-064","subject_person_id":"cbr-p002490","predicate":"mother","object_person_id":"cbr-p002497","status":"source_attested","evidence":[{"chapter_id":"c-shiji-043-zhao","source_id":"s-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p121","quote":"太史公曰：吾聞馮王孫曰：「趙王遷，其母倡也，嬖於悼襄王。悼襄王廢適子嘉而立遷。遷素無行，信讒，故誅其良將李牧，用郭開。」豈不繆哉！秦旣虜遷，趙之亡大夫共立嘉爲王，王代六歳，秦進兵破嘉，遂滅趙以爲郡。"}],"qualifiers":{"source_term":"其母倡也","historicity":"historical_tradition"},"interpretation_note":"明示子、適子、其母保存來源主張；太史公所引馮王孫是引述敘事，未當獨立多份證據，嬖不推法定配偶。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji043-261","person_id":"cbr-p002490","surfaces":["幽繆王遷","王遷","趙王遷","遷"],"scope":"same_chapter","chapter_ids":["c-shiji-043-zhao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-043-zhao:p115","quote":"九年，趙攻燕，取貍、陽城。兵未罷，秦攻鄴，拔之。悼襄王卒，子幽繆王遷立。"},{"paragraph_id":"c-shiji-043-zhao:p116","quote":"幽繆王遷元年，城柏人。二年，秦攻武城，扈輒率師救之，軍敗，死焉。"},{"paragraph_id":"c-shiji-043-zhao:p119","quote":"七年，秦人攻趙，趙大將李牧、將軍司馬尚將，撃之。李牧誅，司馬尚免，趙怱及齊將顏聚代之。趙怱軍破，顏聚亡去。以王遷降。"},{"paragraph_id":"c-shiji-043-zhao:p121","quote":"太史公曰：吾聞馮王孫曰：「趙王遷，其母倡也，嬖於悼襄王。悼襄王廢適子嘉而立遷。遷素無行，信讒，故誅其良將李牧，用郭開。」豈不繆哉！秦旣虜遷，趙之亡大夫共立嘉爲王，王代六歳，秦進兵破嘉，遂滅趙以爲郡。"},{"paragraph_id":"c-shiji-043-zhao:p122","quote":"趙氏之系，與秦同祖。周穆平徐，乃封造父。帶始事晉，夙初有土。岸賈矯誅，韓厥立武。寶符臨代，卒居伯魯。簡夢翟犬，靈歌處女。胡服雖強，建立非所。頗、牧不用，王遷囚虜。"}],"rationale":"限本篇姓名、封授、繼位及連續事件暫接；偃／悼襄王、遷／幽繆王及樂乘／武襄君按明示上下文保存。篇末長安君、燕王、未名太子及文信侯不補名字或按同爵跨時段合併；徒父祺讀法仍待底本核查。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji081-035","person_id":"cbr-p004634","scope":"same_chapter","chapter_ids":["c-shiji-081-lianlin"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["趙王","趙王遷"],"evidence":[{"paragraph_id":"c-shiji-081-lianlin:p026","quote":"趙王遷七年，秦使王翦攻趙，趙使李牧、司馬尚禦之。秦多與趙王寵臣郭開金，爲反間，言李牧、司馬尚欲反。趙王乃使趙蔥及齊將顏聚代李牧。李牧不受命，趙使人微捕得李牧，斬之。廢司馬尚。後三月，王翦因急撃趙，大破殺趙蔥，虜趙王遷及其將顏聚，遂滅趙。"}],"rationale":"依本篇明示姓名、國別君序與代將敘事暫接；李牧牧在明示北邊主題內同指，趙王遷王稱限定末次代將。北邊早年趙王、他人及單于未名分存，不強接悼襄；太史公讓頗承接廉藺敘事，其他引語指代待逐處覆核。"}],"equivalence_decisions":[{"id":"eq-shiji081-qian","person_ids":["cbr-p002490","cbr-p004634"],"canonical_person_id":"cbr-p002490","scope":"cross_chapter","chapter_ids":["c-shiji-043-zhao","c-shiji-081-lianlin"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-043-zhao","source_id":"s-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p119","quote":"七年，秦人攻趙，趙大將李牧、將軍司馬尚將，撃之。李牧誅，司馬尚免，趙怱及齊將顏聚代之。趙怱軍破，顏聚亡去。以王遷降。","mention_ids":["c-shiji-043-zhao:m119-0054"]},{"chapter_id":"c-shiji-081-lianlin","source_id":"s-shiji-081-lianlin","paragraph_id":"c-shiji-081-lianlin:p026","quote":"趙王遷七年，秦使王翦攻趙，趙使李牧、司馬尚禦之。秦多與趙王寵臣郭開金，爲反間，言李牧、司馬尚欲反。趙王乃使趙蔥及齊將顏聚代李牧。李牧不受命，趙使人微捕得李牧，斬之。廢司馬尚。後三月，王翦因急撃趙，大破殺趙蔥，虜趙王遷及其將顏聚，遂滅趙。","mention_ids":["c-shiji-081-lianlin:m026-0000","c-shiji-081-lianlin:m026-0027","c-shiji-081-lianlin:m026-0049","c-shiji-081-lianlin:m026-0105"]}],"rationale":"兩篇趙王遷在李牧司馬尚去職、趙怱蔥顏聚代將後秦破趙降虜，王名、國別與同一亡國事件支持同指。 各篇原字、原文與已發ID保留，同書不視為獨立見證；同指不確證所有紀年、任職、親屬或敘事，不按全域同名批量改號。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-043-zhao:p115","text":"九年，趙攻燕，取貍、陽城。兵未罷，秦攻鄴，拔之。悼襄王卒