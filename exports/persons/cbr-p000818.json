}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-008-gaozu:p086","text":"四月甲辰，高祖崩長樂宮。四日不發喪。呂后與審食其謀曰：「諸將與帝為編戶民，今北面為臣，此常怏怏，今乃事少主，非盡族是，天下不安。」人或聞之，語酈將軍。酈將軍往見審食其，曰：「吾聞帝已崩，四日不發喪，欲誅諸將。誠如此，天下危矣。陳平、灌嬰將十萬守滎陽，樊噲、周勃將二十萬定燕、代，此聞帝崩，諸將皆誅，必連兵還鄉以攻關中。大臣內叛，諸侯外反，亡可翹足而待也。」審食其入言之，乃以丁未發喪，大赦天下。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m086-0005","start":5,"end":7,"surface":"高祖","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m086-0018","start":18,"end":20,"surface":"呂后","kind":"person","person_id":"i30_mjq_6q8_A","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m086-0021","start":21,"end":24,"surface":"審食其","kind":"person","person_id":"qg7_n12_fne","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m086-0031","start":31,"end":32,"surface":"帝","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m086-0051","start":51,"end":53,"surface":"少主","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、群體、校勘符號或未定指代；不補未見姓名或世系。"},{"id":"c-shiji-008-gaozu:m086-0071","start":71,"end":74,"surface":"酈將軍","kind":"person","person_id":"mnl_60k_4y2","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m086-0075","start":75,"end":78,"surface":"酈將軍","kind":"person","person_id":"mnl_60k_4y2","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m086-0080","start":80,"end":83,"surface":"審食其","kind":"person","person_id":"qg7_n12_fne","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m086-0089","start":89,"end":90,"surface":"帝","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m086-0113","start":113,"end":115,"surface":"陳平","kind":"person","per