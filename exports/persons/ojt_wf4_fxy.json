mily_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-118-huainan:m029-0032","start":32,"end":34,"surface":"白嬴","kind":"person","person_id":"ojt_wf4_fxy","status":"contextual_provisional","paragraph_id":"c-shiji-118-huainan:p029","chapter_id":"c-shiji-118-huainan"},{"id":"c-shiji-118-huainan:m029-0059","start":59,"end":61,"surface":"白嬴","kind":"person","person_id":"ojt_wf4_fxy","status":"contextual_provisional","paragraph_id":"c-shiji-118-huainan:p029","chapter_id":"c-shiji-118-huainan"},{"id":"c-shiji-118-huainan:m029-0072","start":72,"end":73,"surface":"嬴","kind":"person","person_id":"ojt_wf4_fxy","status":"contextual_provisional","paragraph_id":"c-shiji-118-huainan:p029","chapter_id":"c-shiji-118-huainan"},{"id":"c-shiji-118-huainan:m029-0084","start":84,"end":86,"surface":"白嬴","kind":"person","person_id":"ojt_wf4_fxy","status":"contextual_provisional","paragraph_id":"c-shiji-118-huainan:p029","chapter_id":"c-shiji-118-huainan"},{"id":"c-shiji-118-huainan:m029-0199","start":199,"end":201,"surface":"白嬴","kind":"person","person_id":"ojt_wf4_fxy","status":"contextual_provisional","paragraph_id":"c-shiji-118-huainan:p029","chapter_id":"c-shiji-118-huainan"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-118-huainan:p029","text":"元朔六年中，衡山王使人上書請廢太子爽，立孝為太子。爽聞，即使所善白嬴之長安上書，言孝作輣車鏃矢，與王御者姦，欲以敗孝。白嬴至長安，未及上書，吏捕嬴，以淮南事繋。王聞爽使白嬴上書，恐言國陰事，即上書反告太子爽所為不道棄市罪事。事下沛郡治。元（朔七）［狩元］年冬，有司公卿下沛郡求捕所與淮南謀反者未得，得陳喜於衡山王子孝家。吏劾孝首匿喜。孝以為陳喜雅數與王計謀反，恐其發之，聞律先自告除其罪，又疑太子使白嬴上書發其事，即先自告，告所與謀反者救赫、陳喜等。廷尉治驗，公卿請逮捕衡山王治之。天子曰：「勿捕。」遣中尉安、大行息即問王，王具以情實對。吏皆圍王宮而守之。中尉大行還，以聞，公卿請遣宗正、大行與沛郡雜治王。王聞，即自剄殺。孝先自告反，除其罪；坐與王御婢姦，棄市。王后徐來亦坐蠱殺前王后乘舒，及太子爽坐王告不孝，皆棄市。諸與衡山王謀反者皆族。國除為衡山郡。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-118-huainan:m029-0006","start":6,"end":9,"surface":"衡山王","kind":"person","person_id":"yqp_nlb_p1p_AFC","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m029-0015","start":15,"end":18,"surface":"太子爽","kind":"person","person_id":"yqp_nlb_p1p_AFCA","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m029-0020","start":20,"end":21,"surface":"孝","kind":"person","person_id":"yqp_nlb_p1p_AFCB","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m029-0022","start":22,"end":24,"surface":"太子","kind":"person","person_id":"yqp_nlb_p1p_AFCB","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m029-0025","start":25,"end":26,"surface":"爽","kind":"person","person_id":"yqp_nlb_p1p_AFCA","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m029-0032","start":32,"end":34,"surface":"白嬴","kind":"person","person_id":"ojt_wf4_fxy","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m029-0041","start":41,"end":42,"surface":"孝","kind":"person","person_id":"yqp_nlb_p1p_AFCB","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m029-0049","start":49,"end":52,"surface":"王御者","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-118-huainan:m029-0057","start":57,"end":58,"surface":"孝","kind":"person","person_id":"yqp_nlb_p1p_AFCB","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m029-0059","start":59,"end":61,"surface":"白嬴","kind":"person","person_id":"ojt_wf4_fxy","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m029-0072","start":72,"end":73,"surface":"嬴","kind":"person","person_id":"ojt_wf4_fxy","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m029-0082","start":82,"end":83,"surface":"爽","kind":"person","person_id":"yqp_nlb_p1p_AFCA","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m029-0084","start":84,"end":86,"surface":"白嬴"