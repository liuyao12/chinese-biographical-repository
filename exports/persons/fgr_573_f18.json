52-qidaohui:p010","chapter_id":"c-shiji-052-qidaohui"},{"id":"c-shiji-052-qidaohui:m010-0159","start":159,"end":161,"surface":"祝午","kind":"person","person_id":"fgr_573_f18","status":"contextual_provisional","paragraph_id":"c-shiji-052-qidaohui:p010","chapter_id":"c-shiji-052-qidaohui"},{"id":"c-shiji-052-qidaohui:m010-0172","start":172,"end":174,"surface":"祝午","kind":"person","person_id":"fgr_573_f18","status":"contextual_provisional","paragraph_id":"c-shiji-052-qidaohui:p010","chapter_id":"c-shiji-052-qidaohui"},{"id":"c-shiji-052-qidaohui:m010-0302","start":302,"end":304,"surface":"祝午","kind":"person","person_id":"fgr_573_f18","status":"contextual_provisional","paragraph_id":"c-shiji-052-qidaohui:p010","chapter_id":"c-shiji-052-qidaohui"},{"id":"c-shiji-130-taishigong:m063-0032","start":32,"end":33,"surface":"午","kind":"person","person_id":"fgr_573_f18","status":"contextual_provisional","paragraph_id":"c-shiji-130-taishigong:p063","chapter_id":"c-shiji-130-taishigong"}],"relations":[],"title_holdings":[{"id":"th-shiji052-016","person_id":"fgr_573_f18","title":"郎中令","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-052-qidaohui","source_id":"s-shiji-052-qidaohui","paragraph_id":"c-shiji-052-qidaohui:p010","quote":"齊王既聞此計，乃與其舅父駟鈞、郎中令祝午、中尉魏勃陰謀發兵。齊相召平聞之，乃發卒衛王宮。魏勃紿召平曰：「王欲發兵，非有漢虎符驗也。而相君圍王，固善。勃請為君將兵衛衛王。」召平信之，乃使魏勃將兵圍王宮。勃既將兵，使圍相府。召平曰：「嗟乎！道家之言『當斷不斷，反受其亂』，乃是也。」遂自殺。於是齊王以駟鈞為相，魏勃為將軍，祝午為內史，悉發國中兵。使祝午東詐瑯邪王曰：「呂氏作亂，齊王發兵欲西誅之。齊王自以兒子，年少，不習兵革之事，願舉國委大王。大王自高帝將也，習戰事。齊王不敢離兵，使臣請大王幸之臨菑見齊王計事，并將齊兵以西平關中之亂。」瑯邪王信之，以為然，（西）［迺］馳見齊王。齊王與魏勃等因留瑯邪王，而使祝午盡發瑯邪國而并將其兵。"}],"attestations":[{"id":"th-shiji052-016:a001","paragraph_id":"c-shiji-052-qidaohui:p010","start":15,"end":18,"surface":"郎中令","person_mention_id":"c-shiji-052-qidaohui:m010-0018","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予、任事、提議、回敘及用稱分開；年號僅留原語，不反算公曆起訖。朱虛、東牟許封趙梁而未實現不記實授，死亡不自動終止全部稱號。章與興居授王兩處年表述各留原段，不擅調和。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji052-021","person_id":"fgr_573_f18","title":"內史","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-052-qidaohui","source_id":"s-shiji-052-qidaohui","paragraph_id":"c-shiji-052-qidaohui:p010","quote":"齊王既聞此計，乃與其舅父駟鈞、郎中令祝午、中尉魏勃陰謀發兵。齊相召平聞之，乃發卒衛王宮。魏勃紿召平曰：「王欲發兵，非有漢虎符驗也。而相君圍王，固善。勃請為君將兵衛衛王。」召平信之，乃使魏勃將兵圍王宮。勃既將兵，使圍相府。召平曰：「嗟乎！道家之言『當斷不斷，反受其亂』，乃是也。」遂自殺。於是齊王以駟鈞為相，魏勃為將軍，祝午為內史，悉發國中兵。使祝午東詐瑯邪王曰：「呂氏作亂，齊王發兵欲西誅之。齊王自以兒子，年少，不習兵革之事，願舉國委大王。大王自高帝將也，習戰事。齊王不敢離兵，使臣請大王幸之臨菑見齊王計事，并將齊兵以西平關中之亂。」瑯邪王信之，以為然，（西）［迺］馳見齊王。齊王與魏勃等因留瑯邪王，而使祝午盡發瑯邪國而并將其兵。"}],"attestations":[{"id":"th-shiji052-021:a001","paragraph_id":"c-shiji-052-qidaohui:p010","start":162,"end":164,"surface":"內史","person_mention_id":"c-shiji-052-qidaohui:m010-0159","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-052-qidaohui","source_id":"s-shiji-052-qidaohui","paragraph_id":"c-shiji-052-qidaohui:p010","quote":"齊王既聞此計，乃與其舅父駟鈞、郎中令祝午、中尉魏勃陰謀發兵。齊相召平聞之，乃發卒衛王宮。魏勃紿召平曰：「王欲發兵，非有漢虎符驗也。而相君圍王，固善。勃請為君將兵衛衛王。」召平信之，乃使魏勃將兵圍王宮。勃既將兵，使圍相府。召平曰：「嗟乎！道家之言『當斷不斷，反受其亂』，乃是也。」遂自殺。於是齊王以駟鈞為相，魏勃為將軍，祝午為內史，悉發國中兵。使祝午東詐瑯邪王曰：「呂氏作亂，齊王發兵欲西誅之。齊王自以兒子，年少，不習兵革之事，願舉國委大王。大王自高帝將也，習戰事。齊王不敢離兵，使臣請大王幸之臨菑見齊王計事，并將齊兵以西平關中之亂。」瑯邪王信之，以為然，（西）［迺］馳見齊王。齊王與魏勃等因留瑯邪王，而使祝午盡發瑯邪國而并將其兵。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予、任事、提議、回敘及用稱分開；年號僅留原語，不反算公曆起訖。朱虛、東牟許封趙梁而未實現不記實授，死亡不自動終止全部稱號。章與興居授王兩處年表述各留原段，不擅調和。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji052-026","person_id":"fgr_573_f18","surfaces":["祝午"],"scope":"same_chapter","chapter_ids":["c-shiji-052-qidaohui"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-052-qidaohui:p010","quote":"齊王既聞此計，乃與其舅父駟鈞、郎中令祝午、中尉魏勃陰謀發兵。齊相召平聞之，乃發卒衛王宮。魏勃紿召平曰：「王欲發兵，非有漢虎符驗也。而相君圍王，固善。勃請為君將兵衛衛王。」召平信之，乃使魏勃將兵圍王宮。勃既將兵，使圍相府。召平曰：「嗟乎！道家之言『當斷不斷，反受其亂』，乃是也。」遂自殺。於是齊王以駟鈞為相，魏勃為將軍，祝午為內史，悉發國中兵。使祝午東詐瑯邪王曰：「呂氏作亂，齊王發兵欲西誅之。齊王自以兒子，年少，不習兵革之事，願舉國委大王。大王自高帝將也，習戰事。齊王不敢離兵，使臣請大王幸之臨菑見齊王計事，并將齊兵以西平關中之亂。」瑯邪王信之，以為然，（西）［迺］馳見齊王。齊王與魏勃等因留瑯邪王，而使祝午盡發瑯邪國而并將其兵。"}],"rationale":"依明示名與王國、世次的局部敘事暫接；齊、城陽與菑川同諡者分開，興居與志分開。校勘建延及內史勳士未擅選讀法，未名帝后不補姓名，案件只保存來源敘事。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji130-late45-063","person_id":"fgr_573_f18","scope":"cross_chapter","chapter_ids":["c-shiji-130-taishigong","c-shiji-052-qidaohui"],"status":"contextual_provisional","confidence_level":"high","source_context_confidence":"high_contextual","surfaces":["午"],"identification_basis":{"kind":"source_context","target_mention_ids":["c-shiji-130-taishigong:m063-0032"]},"evidence":[{"chapter_id":"c-shiji-130-taishigong","paragraph_id":"c-shiji-130-taishigong:p063","quote":"維祖師旅，劉賈是與；為布所襲，喪其荊、吳。營陵激呂，乃王瑯邪；怵午信齊，往而不歸，遂西入關，遭立孝文，獲復王燕。天下未集，賈、澤以族，為漢藩輔。作荊燕世家第二十一。"},{"chapter_id":"c-shiji-052-qidaohui","paragraph_id":"c-shiji-052-qidaohui:p010","quote":"齊王既聞此計，乃與其舅父駟鈞、郎中令祝午、中尉魏勃陰謀發兵。齊相召平聞之，乃發卒衛王宮。魏勃紿召平曰：「王欲發兵，非有漢虎符驗也。而相君圍王，固善。勃請為君將兵衛衛王。」召平信之，乃使魏勃將兵圍王宮。勃既將兵，使圍相府。召平曰：「嗟乎！道家之言『當斷不斷，反受其亂』，乃是也。」遂自殺。於是齊王以駟鈞為相，魏勃為將軍，祝午為內史，悉發國中兵。使祝午東詐瑯邪王曰：「呂氏作亂，齊王發兵欲西誅之。齊王自以兒子，年少，不習兵革之事，願舉國委大王。大王自高帝將也，習戰事。齊王不敢離兵，使臣請大王幸之臨菑見齊王計事，并將齊兵以西平關中之亂。」瑯邪王信之，以為然，（西）［迺］馳見齊王。齊王與魏勃等因留瑯邪王，而使祝午盡發瑯邪國而并將其兵。"}],"prior_source_qualifications":[{"source_mention_ids":["c-shiji-130-taishigong:m063-0032"],"metadata":{"label":"午（荊燕提要）（太史公自序候選）","status":"active","historicity":"historical_tradition"},"original_registry_record_sha256":"4582109b333b37747b06b4479d1806a17d10361085bff13a7e848775e8d67742","qualification":"合併前來源限定人物label/status/historicity逐值保留；非對現役人物資格的改寫。"}],"rationale":"齊郎中令祝午詐留琅邪王，同怵午信齊；非楚王戊。 僅辨同一來源人物，保原字、篇題引用、人名錨及頻次；不由此新增親屬或紀年。","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-052-qidaohui:p010","text":"齊王既聞此計，乃與其舅父駟鈞、郎中令祝午、中尉魏勃陰謀發兵。齊相召平聞之