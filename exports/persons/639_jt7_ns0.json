{"source_id":"s-shiji-098-fujin","work_id":"w-shiji","book_id":"b-shiji-098","chapter_id":"c-shiji-098-fujin","mention_count":1,"mention_ids":["c-shiji-098-fujin:m001-0122"],"paragraph_ids":["c-shiji-098-fujin:p001"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-095-fankuang"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-008-gaozu:m044-0085","start":85,"end":87,"surface":"周蘭","kind":"person","person_id":"639_jt7_ns0","status":"contextual_provisional","paragraph_id":"c-shiji-008-gaozu:p044","chapter_id":"c-shiji-008-gaozu"},{"id":"c-shiji-054-cao:m005-0272","start":272,"end":274,"surface":"周蘭","kind":"person","person_id":"639_jt7_ns0","status":"contextual_provisional","paragraph_id":"c-shiji-054-cao:p005","chapter_id":"c-shiji-054-cao"},{"id":"c-shiji-095-fankuang:m025-0165","start":165,"end":167,"surface":"周蘭","kind":"person","person_id":"639_jt7_ns0","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p025","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:m026-0160","start":160,"end":162,"surface":"周蘭","kind":"person","person_id":"639_jt7_ns0","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p026","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-098-fujin:m001-0122","start":122,"end":124,"surface":"周蘭","kind":"person","person_id":"639_jt7_ns0","status":"contextual_provisional","paragraph_id":"c-shiji-098-fujin:p001","chapter_id":"c-shiji-098-fujin"}],"relations":[],"title_holdings":[{"id":"th-shiji054-033","person_id":"639_jt7_ns0","title":"將軍","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-054-cao","source_id":"s-shiji-054-cao","paragraph_id":"c-shiji-054-cao:p005","quote":"高祖（三）［二］年，拜為假左丞相，入屯兵關中。月餘，魏王豹反，以假左丞相別與韓信東攻魏將軍孫遬軍東張，大破之。因攻安邑，得魏將王襄。擊魏王於曲陽，追至武垣，生得魏王豹。取平陽，得魏王母妻子，盡定魏地，凡五十二城。賜食邑平陽。因從韓信擊趙相國夏說軍於鄔東，大破之，斬夏說。韓信與故常山王張耳引兵下井陘，擊成安君，而令參還圍趙別將戚將軍於鄔城中。戚將軍出走，追斬之。乃引兵詣敖倉漢王之所。韓信已破趙，為相國，東擊齊。參以右丞相屬韓信，攻破齊歷下軍，遂取臨菑。還定濟北郡，攻著、漯陰、平原、鬲、盧。已而從韓信擊龍且軍於上假密，大破之，斬龍且，虜其將軍周蘭。定齊，凡得七十餘縣。得故齊王田廣相田光，其守相許章，及故齊膠東將軍田既。韓信為齊王，引兵詣陳，與漢王共破項羽，而參留平齊未服者。"}],"attestations":[{"id":"th-shiji054-033:a001","paragraph_id":"c-shiji-054-cao:p005","start":270,"end":272,"surface":"將軍","person_mention_id":"c-shiji-054-cao:m005-0272","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"明示授予、改官、爵秩、任事與追稱分開，原校勘字不改作定論；任期不由首見、死亡或後嗣承爵自動推端點。執帛、執珪、戚公等性質待制度與版本覆核；食邑調整不自造另一爵名。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji054-031","person_id":"639_jt7_ns0","surfaces":["周蘭"],"scope":"same_chapter","chapter_ids":["c-shiji-054-cao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-054-cao:p005","quote":"高祖（三）［二］年，拜為假左丞相，入屯兵關中。月餘，魏王豹反，以假左丞相別與韓信東攻魏將軍孫遬軍東張，大破之。因攻安邑，得魏將王襄。擊魏王於曲陽，追至武垣，生得魏王豹。取平陽，得魏王母妻子，盡定魏地，凡五十二城。賜食邑平陽。因從韓信擊趙相國夏說軍於鄔東，大破之，斬夏說。韓信與故常山王張耳引兵下井陘，擊成安君，而令參還圍趙別將戚將軍於鄔城中。戚將軍出走，追斬之。乃引兵詣敖倉漢王之所。韓信已破趙，為相國，東擊齊。參以右丞相屬韓信，攻破齊歷下軍，遂取臨菑。還定濟北郡，攻著、漯陰、平原、鬲、盧。已而從韓信擊龍且軍於上假密，大破之，斬龍且，虜其將軍周蘭。定齊，凡得七十餘縣。得故齊王田廣相田光，其守相許章，及故齊膠東將軍田既。韓信為齊王，引兵詣陳，與漢王共破項羽，而參留平齊未服者。"}],"rationale":"依本篇明示姓名與局部軍事、任官及子嗣敘事暫接；曹氏時、襄不按單字全域配對。未名者不補姓名，秦司馬夷字待底本核定，田既與田溉不擅同指。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji095-096","person_id":"639_jt7_ns0","scope":"same_chapter","chapter_ids":["c-shiji-095-fankuang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["周蘭"],"evidence":[{"paragraph_id":"c-shiji-095-fankuang:p025","quote":"三年，以列侯食邑杜平鄉。以御史大夫受詔將郎中騎兵東屬相國韓信，擊破齊軍於歷下，所將卒虜車騎將軍華毋傷及將吏四十六人。降下臨菑，得齊守相田光。追齊相田橫至嬴、博，破其騎，所將卒斬騎將一人，生得騎將四人。攻下嬴、博，破齊將軍田吸於千乘，所將卒斬吸。東從韓信攻龍且、留公旋於高密，卒斬龍且，生得右司馬、連尹各一人，樓煩將十人，身生得亞將周蘭。"},{"paragraph_id":"c-shiji-095-fankuang:p026","quote":"齊地已定，韓信自立為齊王，使嬰別將擊楚將公杲於魯北，破之。轉南，破薛郡長，身虜騎將一人。攻（博）［傅］陽，前至下相以東南僮、取慮、徐。度淮，盡降其城邑，至廣陵。項羽使項聲、薛公、郯公復定淮北。嬰度淮北，擊破項聲、郯公下邳，斬薛公，下下邳，擊破楚騎於平陽，遂降彭城，虜柱國項佗，降留、薛、沛、酂、蕭、相。攻苦、譙，復得亞將周蘭。與漢王會頤鄉。從擊項籍軍於陳下，破之，所將卒斬樓煩將二人，虜騎將八人。賜益食邑二千五百戶。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定異稱。酈寄字況據第14段；夏侯嬰的嬰限定第16至21段，灌嬰限定第22至33段，桓嬰另人。第6與20、28段楚王信和反韓王信分人；未詳名王侯不補名。同名跨篇同指另待逐項證據。"},{"id":"d-shiji098-014","person_id":"639_jt7_ns0","surfaces":["周蘭"],"scope":"same_chapter","chapter_ids":["c-shiji-098-fujin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-098-fujin:p001","quote":"陽陵侯傅寬，以魏五大夫騎將從，為舍人，起橫陽。從攻安陽、杠里，擊趙賁軍於開封，及擊楊熊曲遇、陽武，斬首十二級，賜爵卿。從至霸上。沛公立為漢王，漢王賜寬封號共德君。從入漢中，遷為右騎將。從定三秦，賜食邑雕陰。從擊項籍，待懷，賜爵通德侯。從擊項冠、周蘭、龍且，所將卒斬騎將一人敖下，益食邑。"}],"rationale":"依傅寬、靳歙、周緤分段敘事及明示姓名定位；楚王信與平城下韓信分存，單稱參勃哙敞不補姓，兩位信武侯分持有人，周昌不按同名跨篇合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji095-remaining-zhoulan","person_ids":["639_jt7_ns0"],"canonical_person_id":"639_jt7_ns0","scope":"cross_chapter","chapter_ids":["c-shiji-095-fankuang","c-shiji-054-cao","c-shiji-098-fujin","c-shiji-008-gaozu"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-095-fankuang","source_id":"s-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p025","quote":"三年，以列侯食邑杜平鄉。以御史大夫受詔將郎中騎兵東屬相國韓信，擊破齊軍於歷下，所將卒虜車騎將軍華毋傷及將吏四十六人。降下臨菑，得齊守相田光。追齊相田橫至嬴、博，破其騎，所將卒斬騎將一人，生得騎將四人。攻下嬴、博，破齊將軍田吸於千乘，所將卒斬吸。東從韓信攻龍且、留公旋於高密，卒斬龍且，生得右司馬、連尹各一人，樓煩將十人，身生得亞將周蘭。","mention_ids":["c-shiji-095-fankuang:m025-0165"]},{"chapter_id":"c-shiji-095-fankuang","source_id":"s-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p026","quote":"齊地已定，韓信自立為齊王，使嬰別將擊楚將公杲於魯北，破之。轉南，破薛郡長，身虜騎將一人。攻（博）［傅］陽，前至下相以東南僮、取慮、徐。度淮，盡降其城邑，至廣陵。項羽使項聲、薛公、郯公復定淮北。嬰度淮北，擊破項聲、郯公下邳，斬薛公，下下邳，擊破楚騎於平陽，遂降彭城，虜柱國項佗，降留、薛、沛、酂、蕭、相。攻苦、譙，復得亞將周蘭。與漢王會頤鄉。從擊項籍軍於陳下，破之，所將卒斬樓煩將二人，虜騎將八人。賜益食邑二千五百戶。","mention_ids":["c-shiji-095-fankuang:m026-0160"]},{"chapter_id":"c-shiji-054-cao","source_id":"s-shiji-054-cao","paragraph_id":"c-shiji-054-cao:p005","quote":"高祖（三）［二］年，拜為假左丞相，入屯兵關中。月餘，魏王豹反，以假左丞相別與韓信東攻魏將軍孫遬軍東張，大破之。因攻安邑，得魏將王襄。擊魏王於曲陽，追至武垣，生得魏王豹。取平陽，得魏王母妻子，盡定魏地，凡五十二城。賜食邑平陽。因從韓信擊趙相國夏說軍於鄔東，大破之，斬夏說。韓信與故常山王張耳引兵下井陘，擊成安君，而令參還圍趙別將戚將軍於鄔城中。戚將軍出走，追斬之。乃引兵詣敖倉漢王之所。韓信已破趙，為相國，東擊齊。參以右丞相屬韓信，攻破齊歷下軍，遂取臨菑。還定濟北郡，攻著、漯陰、平原、鬲、盧。已而從韓信擊龍且軍於上假密，大破之，斬龍且，虜其將軍周蘭。定齊，凡得七十餘縣。得故齊王田廣相田光，其守相許章，及故齊膠東將軍田既。韓信為齊王，引兵詣陳，與漢王共破項羽，而參留平齊未服者。","mention_ids":["c-shiji-054-cao:m005-0272"]},{"chapter_id":"c-shiji-098-fujin","source_id":"s-shiji-098-fujin","paragraph_id":"c-shiji-098-fujin:p001","quote":"陽陵侯傅寬，以魏五大夫騎將從，為舍人，起橫陽。從攻安陽、杠里，擊趙賁軍於開封，及擊楊熊曲遇、陽武，斬首十二級，賜爵卿。從至霸上。沛公立為漢王，漢王賜寬封號共德君。從入漢中，遷為右騎將。從定三秦，賜食邑雕陰。從擊項籍，待懷，賜爵通德侯。從擊項冠、周蘭、龍且，所將卒斬騎將一人敖下，益食邑。","mention_ids":["c-shiji-098-fujin:m001-0122"]},{"chapter_id":"c-shiji-008-gaozu","source_id":"s-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p044","quote":"淮陰已受命東，未渡平原。漢王使酈生往說齊王田廣，廣叛楚，與漢和，共擊項羽。韓信用蒯通計，遂襲破齊。齊王烹酈生，東走高密。項羽聞韓信已舉河北兵破齊、趙，且欲擊楚，則使龍且、周蘭往擊之。韓信與戰，騎將灌嬰擊，大破楚軍，殺龍且。齊王廣奔彭越。當此時，彭越將兵居梁地，往來苦楚兵，絕其糧食。","mention_ids":["c-shiji-008-gaozu:m044-0085"]}],"rationale":"龍且及周蘭赴齊與韓信軍交戰、周蘭被俘的連續敘事與傅寬所擊楚將名單相配。本篇兩處得亞將周蘭原文各留，不合成單次被俘，不因各人記功重疊而添兩名同名者。 原字與錨點保留，同書不作獨立見證，未核書影。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true}],"passages":[{"id":"c-shiji-008-gaozu:p044","text":"淮陰已受命東，未渡平原。漢王使酈生往說齊王田廣，廣叛楚，與漢和，共擊項羽。韓信用蒯通計，遂襲破齊。齊王烹酈生，東走高密。項羽聞韓信已舉河北兵破齊、趙，且欲擊楚，則使龍且、周蘭往擊之。韓信與戰，騎將灌嬰擊，大破楚軍，殺龍且。齊王廣奔彭越。當此時，彭越將兵居梁地，往來苦楚兵，絕其糧食。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m044-0000","start":0,"end":2,"surface":"淮陰","kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m044-0012","start":12,"end":14,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m044