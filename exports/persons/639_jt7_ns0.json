cao:m005-0323","start":323,"end":325,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m005-0327","start":327,"end":329,"surface":"項羽","kind":"person","person_id":"s5o_lxl_fqe","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m005-0331","start":331,"end":332,"surface":"參","kind":"person","person_id":"37j_16p_7n8","status":"contextual_provisional"}],"chapter_id":"c-shiji-054-cao","book_id":"b-shiji-054","work_id":"w-shiji","source_id":"s-shiji-054-cao"},{"id":"c-shiji-095-fankuang:p025","text":"三年，以列侯食邑杜平鄉。以御史大夫受詔將郎中騎兵東屬相國韓信，擊破齊軍於歷下，所將卒虜車騎將軍華毋傷及將吏四十六人。降下臨菑，得齊守相田光。追齊相田橫至嬴、博，破其騎，所將卒斬騎將一人，生得騎將四人。攻下嬴、博，破齊將軍田吸於千乘，所將卒斬吸。東從韓信攻龍且、留公旋於高密，卒斬龍且，生得右司馬、連尹各一人，樓煩將十人，身生得亞將周蘭。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m025-0028","start":28,"end":30,"surface":"韓信","kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m025-0047","start":47,"end":50,"surface":"華毋傷","kind":"person","person_id":"bbt_vs5_5ka","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m025-0067","start":67,"end":69,"surface":"田光","kind":"person","person_id":"pew_ob7_n0k","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m025-0073","start":73,"end":75,"surface":"田橫","kind":"person","person_id":"6r7_9o6_c1i","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m025-0110","start":110,"end":112,"surface":"田吸","kind":"person","person_id":"kfh_9sk_v4e","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m025-0120","start":120,"end":121,"surface":"吸","kind":"person","person_id":"kfh_9sk_v4e","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m025-0124","start":124,"end":126,"surface":"韓信","kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m025-0127","start":127,"end":129,"surface":"龍且","kind":"person","person_id":"sr6_5zr_1f3","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m025-0130","start":130,"end":133,"surface":"留公旋","kind":"person","person_id":"bcq_8mf_d5t","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m025-0139","start":139,"end":141,"surface":"龍且","kind":"person","person_id":"sr6_5zr_1f3","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m025-0165","start":165,"end":167,"surface":"周蘭","kind":"person","person_id":"639_jt7_ns0","status":"contextual_provisional"}],"chapter_id":"c-shiji-095-fankuang","book_id":"b-shiji-095","work_id":"w-shiji","source_id":"s-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:p026","text":"齊地已定，韓信自立為齊王，使嬰別將擊楚將公杲於魯北，破之。轉南，破薛郡長，身虜騎將一人。攻（博）［傅］陽，前至下相以東南僮、取慮、徐。度淮，盡降其城邑，至廣陵。項羽使項聲、薛公、郯公復定淮北。嬰度淮北，擊破項聲、郯公下邳，斬薛公，下下邳，擊破楚騎於平陽，遂降彭城，虜柱國項佗，降留、薛、沛、酂、蕭、相。攻苦、譙，復得亞將周蘭。與漢王會頤鄉。從擊項籍軍於陳下，破之，所將卒斬樓煩將二人，虜騎將八人。賜益食邑二千五百戶。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m026-0005","start":5,"end":7,"surface":"韓信","kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0014","start":14,"end":15,"surface":"嬰","kind":"person","person_id":"sj9_pfu_fwh","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0020","start":20,"end":22,"surface":"公杲","kind":"person","person_id":"p3e_kto_76o","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0080","start":80,"end":82,"surface":"項羽","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0083","start":83,"end":85,"surface":"項聲","kind":"person","person_id":"myr_tln_x5c","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0086","start":86,"end":88,"surface":"薛公","kind":"person","person_id":"1wy_ygt_gre","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0089","start":89,"end":91,"surface":"郯公","kind":"person","person_id":"bhy_6ln_wvi","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0096","start":96,"end":97,"surface":"嬰","kind":"person","person_id":"sj9_pfu_fwh","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0103","start":103,"end":105,"surface":"項聲","kind":"person","person_id":"myr_tln_x5c","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0106","start":106,"end":108,"surface":"郯公","kind":"person","person_id":"bhy_6ln_wvi","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0112","start":112,"end":114,"surface":"薛公","kind":"person","person_id":"1wy_ygt_gre","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0135","start":135,"end":137,"surface":"項佗","kind":"person","person_id":"9pq_9wn_9y1","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0160","start":160,"end":162,"surface":"周蘭","kind":"person","person_id":"639_jt7_ns0","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0164","start":164,"end":166,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0172","start":172,"end":174,"surface":"項籍","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"}],"chapter_id":"c-shiji-095-fankuang","book_id":"b-shiji-095","work_id":"w-shiji","source_id":"s-shiji-095-fankuang"},{"id":"c-shiji-098-fujin:p001","text":"陽陵侯傅寬，以魏五大夫騎將從，為舍人，起橫陽。從攻安陽、杠里，擊趙賁軍於開封，及擊楊熊曲遇、陽武，斬首十二級，賜爵卿。從至霸上。沛公立為漢王，漢王賜寬封號共德君。從入漢中，遷為右騎將。從定三秦，賜食邑雕陰。從擊項籍，待懷，賜爵通德侯。從擊項冠、周蘭、龍且，所將卒斬騎將一人敖下，益食邑。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-098-fujin:m001-0000","start":0,"end":3,"surface":"陽陵侯","kind":"person","person_id":"w8j_vnd_rs4","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m001-0003","start":3,"end":5,"surface":"傅寬","kind":"person","person_id":"w8j_vnd_rs4","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m001-0032","start":32,"end":34,"surfac