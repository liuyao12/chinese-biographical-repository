州都，揚州士，作天子，四世治，太平始」。又吳興陽羨山有空石，長十餘丈，名曰石室，在所表爲大瑞。乃遣兼司徒董朝、兼太常周處至陽羨縣，封襌國山。明年改元，大赦，以恊石文。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":80,"last_line":80,"raw_start":13110,"raw_end":13667,"raw_character_offsets":[13122,13123,13124,13125,13133,13134,13135,13136,13137,13138,13139,13140,13141,13142,13143,13144,13145,13146,13147,13148,13149,13150,13151,13152,13153,13154,13155,13156,13157,13158,13159,13160,13161,13162,13163,13164,13165,13166,13167,13168,13169,13170,13171,13172,13173,13174,13175,13176,13177,13178,13179,13180,13181,13182,13183,13184,13185,13186,13187,13188,13189,13190,13191,13192,13193,13194,13195,13196,13197,13198,13199,13200,13201,13202,13203,13204,13205,13206,13207,13208,13209,13210,13211,13212,13213,13214,13215,13216,13217,13218,13219,13220,13221,13222,13223,13224,13225,13226,13227,13228,13229,13230,13231,13232,13233,13234,13235,13236,13237,13238,13239,13240,13241,13242,13243,13325,13326,13327,13328,13329,13330,13331,13332,13333,13334,13335,13336,13337,13338,13339,13340,13341,13342,13343,13344,13345,13346,13347,13348,13349,13350,13351,13352,13353,13354,13355,13356,13357,13358,13359,13360,13361,13362,13363,13364,13365,13366,13367,13368,13369,13370,13371,13372,13373,13374,13375,13376,13377,13378,13379,13380,13381,13604,13605,13606,13607,13608,13609,13610,13611,13612,13613,13614,13615,13616,13617,13618,13619,13620,13621,13622,13623,13624,13625,13626,13627,13628,13629,13630,13631,13632,13633,13634,13635,13636,13637,13638,13639,13640,13641,13642,13643,13644,13645,13646,13647,13648,13649,13650,13651,13652,13653,13654,13655,13656,13657,13658,13659,13660,13661,13662,13663,13664,13665,13666],"revision_id":2085142},"mentions":[{"id":"c-sanguozhi-048-sun-hao:p030:m0090","surface":"車浚","start":90,"end":92,"kind":"person","person_id":"106_c4l_bao","status":"contextual_provisional"},{"id":"c-sanguozhi-048-sun-hao:p030:m0097","surface":"張詠","start":97,"end":99,"kind":"person","person_id":"u21_22e_tjl","status":"contextual_p