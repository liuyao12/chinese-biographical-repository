iji-099-liushu:p008","quote":"懷王"},{"mention_id":"c-shiji-099-liushu:m008-0353","chapter_id":"c-shiji-099-liushu","paragraph_id":"c-shiji-099-liushu:p008","quote":"義帝"}],"family_path":{"connection":"grandfather","generation_distance":2,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"paragraph_id":"c-shiji-007-xiangyu:p006","quote":"居鄛人范增，年七十，素居家，好奇計，往說項梁曰：「陳勝敗固當。夫秦滅六國，楚最無罪。自懷王入秦不反，楚人憐之至今，故楚南公曰『楚雖三戶，亡秦必楚』也。今陳勝首事，不立楚後而自立，其勢不長。今君起江東，楚蠭起之將皆爭附君者，以君世世楚將，為能復立楚之後也。」於是項梁然其言，乃求楚懷王孫心民間，為人牧羊，立以為楚懷王，從民所望也。陳嬰為楚上柱國，封五縣，與懷王都盱台。項梁自號為武信君。","chapter_id":"c-shiji-007-xiangyu","source_id":"s-shiji-007-xiangyu","source_term":"孫"}],"source_assertion_id":"a-shiji007-004","interpretation_note":"以此受傳正文的明示近親主張配置局部家族；不合併跨篇候選身份、不補闕名世代，不表示遠祖世系已核實。分支字元不是長幼排行。","reviewer":"Codex（AI 代理）","ancestor_person_id":"c2w_s7g_en0","parent_person_id":null,"intermediate_person_ids":[null]}}],"source_mention_summary":[{"source_id":"s-shiji-048-chenshe","work_id":"w-shiji","book_id":"b-shiji-048","chapter_id":"c-shiji-048-chenshe","mention_count":1,"mention_ids":["c-shiji-048-chenshe:m018-0055"],"paragraph_ids":["c-shiji-048-chenshe:p018"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-048-chenshe"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji048-003","subject_person_id":"c2w_s7g_en0_*A","predicate":"grandfather","object_person_id":"acp_p3n_gli","status":"source_attested","evidence":[{"chapter_id":"c-shiji-048-chenshe","source_id":"s-shiji-048-chenshe","paragraph_id":"c-shiji-048-chenshe:p018","quote":"秦左右校復攻陳，下之。呂將軍走，收兵復聚。鄱盜當陽君黥布之兵相收，復擊秦左右校，破之青波，復以陳為楚。會項梁立懷王孫心為楚王。"}],"qualifiers":{"source_term":"懷王孫心","historicity":"historical_tradition"},"interpretation_note":"子、母、孫分型保存；祖孫不改直接父子，