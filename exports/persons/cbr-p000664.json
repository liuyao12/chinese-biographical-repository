懷王孫心民間，為人牧羊，立以為楚懷王，從民所望也。陳嬰為楚上柱國，封五縣，與懷王都盱台。項梁自號為武信君。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-007-xiangyu:m006-0003","start":3,"end":5,"surface":"范增","kind":"person","person_id":"uw6_a0a_tjp","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m006-0020","start":20,"end":22,"surface":"項梁","kind":"person","person_id":"5xt_rg8_7zs_A","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m006-0025","start":25,"end":27,"surface":"陳勝","kind":"person","person_id":"pom_ycp_ha5","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m006-0043","start":43,"end":45,"surface":"懷王","kind":"person","person_id":"c2w_s7g_en0","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m006-0058","start":58,"end":61,"surface":"楚南公","kind":"person","person_id":"asz_r1c_0yz","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m006-0076","start":76,"end":78,"surface":"陳勝","kind":"person","person_id":"pom_ycp_ha5","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m006-0100","start":100,"end":105,"surface":"楚蠭起之將","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱或短稱尚待逐處覆核；不補姓名或推造個別成員。"},{"id":"c-shiji-007-xiangyu:m006-0122","start":122,"end":125,"surface":"楚之後","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱或短稱尚待逐處覆核；不補姓名或推造個別成員。"},{"id":"c-shiji-007-xiangyu:m006-0130","start":130,"end":132,"surface":"項梁","kind":"person","person_id":"5xt_rg8_7zs_A","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m006-0138","start":138,"end":141,"surface":"楚懷王","kind":"person","person_id":"c2w_s7g_en0","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m006-0142","start":142,"end":143,"surface":"心","kind":"person","person_id":"c2w_s7g_en0_*A","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m006-0154","start":154,"end":157,"surface":"楚懷王","kind":"person","person_id":"c2w_s7g_en0_*A","status":"contextual_p