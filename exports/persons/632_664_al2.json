l"},{"id":"c-shiji-054-cao:m005-0323","start":323,"end":325,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m005-0327","start":327,"end":329,"surface":"項羽","kind":"person","person_id":"s5o_lxl_fqe","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m005-0331","start":331,"end":332,"surface":"參","kind":"person","person_id":"37j_16p_7n8","status":"contextual_provisional"}],"chapter_id":"c-shiji-054-cao","book_id":"b-shiji-054","work_id":"w-shiji","source_id":"s-shiji-054-cao"},{"id":"c-shiji-054-cao:p019","text":"【索隱述贊】曹參初起，為沛豪吏。始從中涓，先圍善置。執珪執帛，攻城掠地。衍氏既誅，昆陽失位。北禽夏說，東討田溉。剖符定封，功無與二。市獄勿擾，清淨不事。尚主平陽，代享其利。","annotation_status":"named_mentions_first_pass","text_layer":"witness_appended_suoyin_zan","mentions":[{"id":"c-shiji-054-cao:m019-0006","start":6,"end":8,"surface":"曹參","kind":"person","person_id":"37j_16p_7n8","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m019-0048","start":48,"end":50,"surface":"夏說","kind":"person","person_id":"632_664_al2","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m019-0053","start":53,"end":55,"surface":"田溉","kind":"person","person_id":"vw5_ynq_5fx","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m019-0076","start":76,"end":80,"surface":"尚主平陽","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名家屬、官吏群體或索隱短稱待覆核，不補姓名或尚主者。"}],"chapter_id":"c-shiji-054-cao","book_id":"b-shiji-054","work_id":"w-shiji","source_id":"s-shiji-054-cao"},{"id":"c-shiji-092-hanxin:p008","text":"漢之敗卻彭城，塞王欣、翟王翳亡漢降楚，齊、趙亦反漢與楚和。六月，魏王豹謁歸視親疾，至國，即絕河關反漢，與楚約和。漢王使酈生說豹，不下。其八月，以信爲左丞相，擊魏。魏王盛兵蒲阪，塞臨晉，信乃益爲疑兵，陳船欲度臨晉，而伏兵從夏陽以木罌缻渡軍，襲安邑。魏王豹驚，引兵迎信，信遂虜豹，定魏爲河東郡。漢王遣張耳與信俱，引兵東，北擊趙、代。後九月，破代兵，禽夏說閼與。信之下魏破代，漢輒使人收其精兵，詣滎陽以距楚。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-092-hanxin:m008-0007","start":7,"end":10,"surface":"塞王欣","kind":"person","person_id":"o8z_o5j_2e8","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m008-0011","start":11,"end":14,"surface":"翟王翳","kind":"person","person_id":"3j2_4x7_nzr","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m008-0032","start":32,"end":35,"surface":"魏王豹","kind":"person","person_id":"6ve_ik8_jv8","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m008-0056","start":56,"end":58,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m008-0059","start":59,"end":61,"surface":"酈生","kind":"person","person_id":"eya_qj3_tev","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m008-0062","start":62,"end":63,"surface":"豹","kind":"person","person_id":"6ve_ik8_jv8","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m008-0072","start":72,"end":73,"surface":"信","kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m008-0081","start":81,"end":83,"surface":"魏王","kind":"person","person_id":"6ve_ik8_jv8","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m008-0092","start":92,"end":93,"surface":"信","kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m008-0123","start":123,"end":126,"surface":"魏王豹","kind":"person","person_id":"6ve_ik8_jv8","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m008-0131","start":131,"end":132,"surface":"信","kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m008-0133","start":133,"end":134,"surface":"信","kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m008-0136","start":136,"end":137,"surface":"豹","kind":"person","person_id":"6ve_ik8_jv8","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m008-0145","start":145,"end":147,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m008-0148","start":148,"end":150,"surface":"張耳","kind":"person","person_id":"agx_sqm_4ou","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m008-0151","start":151,"end":152,"surface":"信","kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m008-0173","start":173,"end":175,"surface":"夏說","kind":"person","person_id":"632_664_al2","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m008-0178","start":178,"end":179,"surface":"信","kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional"}],"chapter_id":"c-shiji-092-hanxin","book_id":"b-shiji-092","work_id":"w-shiji","source_id":"s-shiji-092-hanxin"},{"id":"c-shiji-092-hanxin:p009","text":"信與張耳以兵數萬，欲東下井陘擊趙。趙王、成安君陳餘聞漢且襲之也，聚兵井陘口，號稱二十萬。廣武君李左車說成安君曰：『聞漢將韓信涉西河，虜魏王，禽夏說，新喋血閼與，今乃輔以張耳，議欲下趙，此乘勝而去國遠鬬，其鋒不可當。臣聞千里餽糧，士有飢色，樵蘇後爨，師不宿飽。今井陘之道，車不得方軌，騎不得成列，行數百里，其勢糧食必在其後。願足下假臣奇兵三萬人，從閒道絕其輜重；足下深溝髙壘，堅營勿與戰。彼前不得鬬，退不得還，吾奇兵絕其後，使野無所掠，不至十日，而兩將之頭可致於戲下。願君留意臣之計。否，必爲二子所禽矣。』成安君，儒者也，常稱義兵不用詐謀奇計，曰：『吾聞兵法十則圍之，倍則戰。今韓信兵號數萬，其實不過數千。能千里而襲我，亦已罷極。今如此避而不擊，後有大者，何以加之！則諸侯謂吾怯，而輕來伐我。』不聽廣武君策，廣武君策不用。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-092-hanxin:m009-0000","start":0,"end":1,"surface":"信","kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m009-0002","start":2,"end":4,"surface":"張耳","kind":"person","person_id":"agx_sqm_4ou","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m009-0017","start":17,"end":19,"surface":"趙王","kind":"person","person_id":"8k3_wi8_pth","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m009-0020","start":20,"end":25,"surface":"成安君陳餘","kind":"person","person_id":"rx0_vif_1xq","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m009-0044","start":44,"end":50,"surface":"廣武君李左車","kind":"person","person_id":"wd1_1f4_qgv","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m009-0051","start":51,"end":54,"surface":"成安君","kind":"person","person_id":"rx0_vif_1xq","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m009-0060","start":60,"end":62,"surface":"韓信","kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m009-0067","start":67,"end":69,"surface":"魏王","kind":"person","person_id":"6ve_ik8_jv8","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m009-0071","start":71,"end":73,"surface":"夏說","kind":"person","person_id":"632_664_al2","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m009-0084","start":84,"end":86,"surface":"張耳","kind":"person","person_id":"agx_sqm_4ou","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m009-0223","start":223,"end":225,"surface":"兩將","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定指代保留原文，不補姓名成員。"},{"id":"c-shiji-092-hanxin:m009-0245","start":245,"end":247,"surface":"二子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定指代保留原文，不補姓名成員。"},{"id":"c-shiji-092-hanxin:m009-0252","start":252,"end":255,"surface":"成安君","kind":"person","person_id":"rx0_vif_1xq","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m009-0288","start":288,"end":290,"surface":"韓信","kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m009-0348","start":348,"end":351,"surface":"廣武君","kind":"person","person_id":"wd1_1f4_qgv","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m009-0353","start":353,"end":356,"surface":"廣武君","kind":"person","person_id":"wd1_1f4_qgv","status":"contextual_provisional"}],"chapter_id":"c-shiji-092-hanxin","book_id":"b-shiji-092","work_id":"w-shiji","source_id":"s-shiji-092-hanxin"},{"id":"c-shiji-092-hanxin:p012","text":"於是信問廣武君曰：『仆欲北攻燕，東伐齊，何若而有功？』廣武君辭謝曰：『臣聞敗軍之將，不可以言勇，亡國之大夫，不可以圖存。今臣敗亡之虜，何足以權大事乎！』信曰：『仆聞之，百里奚居虞而虞亡，在秦而秦霸，非愚於虞而智於秦也，用與不用，聽與不聽也。誠令成安君聽足下計，若信者亦已爲禽矣。以不用足下，故信得侍耳。』因固問曰：『仆委心歸計，願足下勿辭。』廣武君曰：『臣聞智者千慮，必有一失；愚者千慮，必有一得。故曰「狂夫之言，聖人擇焉」。顧恐臣計未必足用，願效愚忠。夫成安君有百戰百勝之計，一旦而失之，軍敗鄗下，身死泜上。今將軍涉西河，虜魏王，禽夏說閼與，一舉而下井陘，不終朝破趙二十萬眾，誅成安君。名聞海內，威震天下，農夫莫不輟耕釋耒，褕衣甘食，傾耳以待命者。若此，將軍之所長也。然而眾勞卒罷，其實難用。今將軍欲舉倦獘之兵，頓之燕堅城之下，欲戰恐久力不能拔，情見勢屈，曠日糧竭，而弱燕不服，齊必距境以自彊也。燕齊相持而不下，則劉項之權未有所分也。若此者，將軍所短也。臣愚，竊以爲亦過矣。故善用兵者不以短擊長，而以長擊短。』韓信曰：『然則何由？』廣武君對曰：『方今爲將軍計，莫如案甲休兵，鎮趙撫其孤，百里之內，牛酒日至，以饗士大夫醳兵，北首燕路，而後遣辯士奉咫尺之書，暴其所長於燕，燕必不敢不聽從。燕已從，使諠言者東告齊，齊必從風而服，雖有智者，亦不知爲齊計矣。如是，則天下事皆可圖也。兵固有先聲而後實者，此之謂也。』韓信曰：『善。』從其策，發使使燕，燕從風而靡。乃遣使報漢，因請立張耳爲趙王，以鎮撫其國。漢王許之，乃立張耳爲趙王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-092-hanxin:m012-0002","start":2,"end":3,"surface":"信","kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m012-0004","start":4,"end":7,"surface":"廣武君","kind":"person","person_id":"wd1_1f4_qgv","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m012-0027","start":27,"end":30,"surface":"廣武君","kind":"person","person_id":"wd1_1f4_qgv","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m012-0076","start":76,"end":77,"surface":"信","kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m012-0084","start":84,"end":87,"surface":"百里奚","kind":"person","person_id":"ylb_ttg_8dr","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m012-0122","start":122,"end":125,"surface":"成安君","kind":"person","person_id":"rx0_vif_1xq","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m012-0131","start":131,"end":132,"surface":"信","kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m012-0146","start":146,"end":147,"surface":"信","kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m012-0171","start":171,"end":174,"surface":"廣武君","kind":"person","person_id":"wd1_1f4_qgv","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m012-0228","start":228,"end":231,"surface":"成安君","kind":"person","person_id":"rx0_vif_1xq","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m012-0263","start":263,"end":265,"surface":"魏王","kind":"person","person_id":"6ve_ik8_jv8","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m012-0267","start":267,"end":269,"surface":"夏說","kind":"person","person_id":"632_664_al2","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m012-0290","start":290,"end":293,"surface":"成安君","kind":"person","person_id":"rx0_vif_1xq","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m012-0408","start":408,"end":410,"surface":"劉項","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定指代保留原文，不補姓名成員。"},{"id":"c-shiji-092-hanxin:m012-0456","start":456,"end":458,"surface":"韓信","kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m012-0467","start":467,"end":470,"surface":"廣武君","kind":"person","person_id":"wd1_1f4_qgv","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m012-0603","start":603,"end":605,"surface":"韓信","kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m012-0635","start":635,"end":637,"surface":"張耳","kind":"person","person_id":"agx_sqm_4ou","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m012-0647","start":647,"end":649,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m012-0654","start":654,"end":656,"surface":"張耳","kind":"person","person_id":"agx_sqm_4ou","status":"contextual_provisional"}],"chapter_id":"c-shiji-092-hanxin","book_id":"b-shiji-092","work_id":"w-shiji","source_id":"s-shiji-092-hanxin"},{"id":"c-shiji-092-hanxin:p019","text":"韓信曰：『漢王遇我甚厚，載我以其車，衣我以其衣，食我以其食。吾聞之，乘人之車者載人之患，衣人之衣者懷人之憂，食人之食者死人之事，吾豈可以鄉利倍義乎！』蒯生曰：『足下自以爲善漢王，欲建萬世之業，臣竊以爲誤矣。始常山王、成安君爲布衣時，相與爲刎頸之交，後爭張黶、陳澤之事，二人相怨。常山王背項王，奉項嬰頭而竄，逃歸於漢王。漢王借兵而東下，殺成安君泜水之南，頭足異處，卒爲天下笑。此二人相與，天下至驩也。然而卒相禽者，何也？患生於多欲而人心難測也。今足下欲行忠信以交於漢王，必不能固於二君之相與也，而事多大於張黶、陳澤。故臣以爲足下必漢王之不危己，亦誤矣。大夫種、范蠡存亡越，霸句踐，立功成名而身死亡。野獸已盡而獵狗亨。夫以交友言之，則不如張耳之與成安君者也；以忠信言之，則不過大夫種、范蠡之於句踐也。此二人者，足以觀矣。願足下深慮之。且臣聞勇略震主者身危，而功蓋天下者不賞。臣請言大王功略：足下涉西河，虜魏王，禽夏說，引兵下井陘，誅成安君，徇趙，脅燕，定齊，南摧楚人之兵二十萬，東殺龍且，西鄉以報，此所謂功無二於天下，而略不世出者也。今足下戴震主之威，挾不賞之功，歸楚，楚人不信；歸漢，漢人震恐：足下欲持是安歸乎？夫勢在人臣之位而有震主之威，名髙天下，竊爲足下危之。』韓信謝曰：『先生且休矣，吾將念之。』","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-092-hanxin:m019-0000","start":0,"end":2,"surface":"韓信","kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m019-0005","start":5,"end":7,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m019-0075","start":75,"end":77,"surface":"蒯生","kind":"person","person_id":"x9q_ghs_z2s","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m019-0086","start":86,"end":88,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m019-0104","start":104,"end":107,"surface":"常山王","kind":"person","person_id":"agx_sqm_4ou","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m019-0108","start":108,"end":111,"surface":"成安君","kind":"person","person_id":"rx0_vif_1xq","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m019-0126","start":126,"end":128,"surface":"張黶","kind":"person","person_id":"h1w_580_5oa","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m019-0129","start":129,"end":131,"surface":"陳澤","kind":"person","person_id":"hnx_2zc_ixj","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m019-0139","start":139,"end":142,"surface":"常山王","kind":"person","person_id":"agx_sqm_4ou","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m019-0143","start":143,"end":145,"surface":"項王","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m019-0147","start":147,"end":149,"surface":"項嬰","kind":"person","person_id":"kre_n61_feg","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m019-0156","star