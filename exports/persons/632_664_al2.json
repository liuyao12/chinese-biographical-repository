{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"632_664_al2","canonical_person_id":"632_664_al2","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["632_664_al2"],"persons":[{"id":"632_664_al2","label":"夏說（曹相國世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"夏說","mention_ids":["c-shiji-054-cao:m005-0120","c-shiji-054-cao:m005-0132","c-shiji-054-cao:m019-0048","c-shiji-092-hanxin:m008-0173","c-shiji-092-hanxin:m009-0071","c-shiji-092-hanxin:m012-0267","c-shiji-092-hanxin:m019-0404"]}],"evidence":[{"mention_id":"c-shiji-054-cao:m005-0120","chapter_id":"c-shiji-054-cao","paragraph_id":"c-shiji-054-cao:p005","quote":"夏說"},{"mention_id":"c-shiji-054-cao:m005-0132","chapter_id":"c-shiji-054-cao","paragraph_id":"c-shiji-054-cao:p005","quote":"夏說"},{"mention_id":"c-shiji-054-cao:m019-0048","chapter_id":"c-shiji-054-cao","paragraph_id":"c-shiji-054-cao:p019","quote":"夏說"},{"mention_id":"c-shiji-092-hanxin:m008-0173","chapter_id":"c-shiji-092-hanxin","paragraph_id":"c-shiji-092-hanxin:p008","quote":"夏說"},{"mention_id":"c-shiji-092-hanxin:m009-0071","chapter_id":"c-shiji-092-hanxin","paragraph_id":"c-shiji-092-hanxin:p009","quote":"夏說"},{"mention_id":"c-shiji-092-hanxin:m012-0267","chapter_id":"c-shiji-092-hanxin","paragraph_id":"c-shiji-092-hanxin:p012","quote":"夏說"},{"mention_id":"c-shiji-092-hanxin:m019-0404","chapter_id":"c-shiji-092-hanxin","paragraph_id":"c-shiji-092-hanxin:p019","quote":"夏說"}]}],"source_mention_summary":[{"source_id":"s-shiji-092-hanxin","work_id":"w-shiji","book_id":"b-shiji-092","chapter_id":"c-shiji-092-hanxin","mention_count":4,"mention_ids":["c-shiji-092-hanxin:m008-0173","c-shiji-092-hanxin:m009-0071","c-shiji-092-hanxin:m012-0267","c-shiji-092-hanxin:m019-0404"],"paragraph_ids":["c-shiji-092-hanxin:p008","c-shiji-092-hanxin:p009","c-shiji-092-hanxin:p012","c-shiji-092-hanxin:p019"],"table_cell_ids":[],"passage_count":4},{"source_id":"s-shiji-054-cao","work_id":"w-shiji","book_id":"b-shiji-054","chapter_id":"c-shiji-054-cao","mention_count":3,"mention_ids":["c-shiji-054-cao:m005-0120","c-shiji-054-cao:m005-0132","c-shiji-054-cao:m019-0048"],"paragraph_ids":["c-shiji-054-cao:p005","c-shiji-054-cao:p019"],"table_cell_ids":[],"passage_count":2}],"most_mentioned_source_ids":["s-shiji-092-hanxin"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-shiji054-003","person_id":"632_664_al2","event_type":"death","status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-054-cao","source_id":"s-shiji-054-cao","paragraph_id":"c-shiji-054-cao:p005","quote":"高祖（三）［二］年，拜為假左丞相，入屯兵關中。月餘，魏王豹反，以假左丞相別與韓信東攻魏將軍孫遬軍東張，大破之。因攻安邑，得魏將王襄。擊魏王於曲陽，追至武垣，生得魏王豹。取平陽，得魏王母妻子，盡定魏地，凡五十二城。賜食邑平陽。因從韓信擊趙相國夏說軍於鄔東，大破之，斬夏說。韓信與故常山王張耳引兵下井陘，擊成安君，而令參還圍趙別將戚將軍於鄔城中。戚將軍出走，追斬之。乃引兵詣敖倉漢王之所。韓信已破趙，為相國，東擊齊。參以右丞相屬韓信，攻破齊歷下軍，遂取臨菑。還定濟北郡，攻著、漯陰、平原、鬲、盧。已而從韓信擊龍且軍於上假密，大破之，斬龍且，虜其將軍周蘭。定齊，凡得七十餘縣。得故齊王田廣相田光，其守相許章，及故齊膠東將軍田既。韓信為齊王，引兵詣陳，與漢王共破項羽，而參留平齊未服者。","person_mention_id":"c-shiji-054-cao:m005-0120"}],"source_term":"斬夏說","interpretation_note":"本篇明示出生或死亡，原句與人物錨點分存；擊破、虜、出走不推死亡，持爵年數不倒推生年，死亡不自動終止全部官爵。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"mentions":[{"id":"c-shiji-054-cao:m005-0120","start":120,"end":122,"surface":"夏說","kind":"person","person_id":"632_664_al2","status":"contextual_provisional","paragraph_id":"c-shiji-054-cao:p005","chapter_id":"c-shiji-054-cao"},{"id":"c-shiji-054-cao:m005-0132","start":132,"end":134,"surface":"夏說","kind":"person","person_id":"632_664_al2","status":"contextual_provisional","paragraph_id":"c-shiji-054-cao:p005","chapter_id":"c-shiji-054-cao"},{"id":"c-shiji-054-cao:m019-0048","start":48,"end":50,"surface":"夏說","kind":"person","person_id":"632_664_al2","status":"contextual_provisional","paragraph_id":"c-shiji-054-cao:p019","chapter_id":"c-shiji-054-cao"},{"id":"c-shiji-092-hanxin:m008-0173","start":173,"end":175,"surface":"夏說","kind":"person","person_id":"632_664_al2","status":"contextual_provisional","paragraph_id":"c-shiji-092-hanxin:p008","chapter_id":"c-shiji-092-hanxin"},{"id":"c-shiji-092-hanxin:m009-0071","start":71,"end":73,"surface":"夏說","kind":"person","person_id":"632_664_al2","status":"contextual_provisional","paragraph_id":"c-shiji-092-hanxin:p009","chapter_id":"c-shiji-092-hanxin"},{"id":"c-shiji-092-hanxin:m012-0267","start":267,"end":269,"surface":"夏說","kind":"person","person_id":"632_664_al2","status":"contextual_provisional","paragraph_id":"c-shiji-092-hanxin:p012","chapter_id":"c-shiji-092-hanxin"},{"id":"c-shiji-092-hanxin:m019-0404","start":404,"end":406,"surface":"夏說","kind":"person","person_id":"632_664_al2","status":"contextual_provisional","paragraph_id":"c-shiji-092-hanxin:p019","chapter_id":"c-shiji-092-hanxin"}],"relations":[],"title_holdings":[{"id":"th-shiji054-027","person_id":"632_664_al2","title":"相國","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-054-cao","source_id":"s-shiji-054-cao","paragraph_id":"c-shiji-054-cao:p005","quote":"高祖（三）［二］年，拜為假左丞相，入屯兵關中。月餘，魏王豹反，以假左丞相別與韓信東攻魏將軍孫遬軍東張，大破之。因攻安邑，得魏將王襄。擊魏王於曲陽，追至武垣，生得魏王豹。取平陽，得魏王母妻子，盡定魏地，凡五十二城。賜食邑平陽。因從韓信擊趙相國夏說軍於鄔東，大破之，斬夏說。韓信與故常山王張耳引兵下井陘，擊成安君，而令參還圍趙別將戚將軍於鄔城中。戚將軍出走，追斬之。乃引兵詣敖倉漢王之所。韓信已破趙，為相國，東擊齊。參以右丞相屬韓信，攻破齊歷下軍，遂取臨菑。還定濟北郡，攻著、漯陰、平原、鬲、盧。已而從韓信擊龍且軍於上假密，大破之，斬龍且，虜其將軍周蘭。定齊，凡得七十餘縣。得故齊王田廣相田光，其守相許章，及故齊膠東將軍田既。韓信為齊王，引兵詣陳，與漢王共破項羽，而參留平齊未服者。"}],"attestations":[{"id":"th-shiji054-027:a001","paragraph_id":"c-shiji-054-cao:p005","start":118,"end":120,"surface":"相國","person_mention_id":"c-shiji-054-cao:m005-0120","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"明示授予、改官、爵秩、任事與追稱分開，原校勘字不改作定論；任期不由首見、死亡或後嗣承爵自動推端點。執帛、執珪、戚公等性質待制度與版本覆核；食邑調整不自造另一爵名。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji054-027","person_id":"632_664_al2","surfaces":["夏說"],"scope":"same_chapter","chapter_ids":["c-shiji-054-cao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-054-cao:p005","quote":"高祖（三）［二］年，拜為假左丞相，入屯兵關中。月餘，魏王豹反，以假左丞相別與韓信東攻魏將軍孫遬軍東張，大破之。因攻安邑，得魏將王襄。擊魏王於曲陽，追至武垣，生得魏王豹。取平陽，得魏王母妻子，盡定魏地，凡五十二城。賜食邑平陽。因從韓信擊趙相國夏說軍於鄔東，大破之，斬夏說。韓信與故常山王張耳引兵下井陘，擊成安君，而令參還圍趙別將戚將軍於鄔城中。戚將軍出走，追斬之。乃引兵詣敖倉漢王之所。韓信已破趙，為相國，東擊齊。參以右丞相屬韓信，攻破齊歷下軍，遂取臨菑。還定濟北郡，攻著、漯陰、平原、鬲、盧。已而從韓信擊龍且軍於上假密，大破之，斬龍且，虜其將軍周蘭。定齊，凡得七十餘縣。得故齊王田廣相田光，其守相許章，及故齊膠東將軍田既。韓信為齊王，引兵詣陳，與漢王共破項羽，而參留平齊未服者。"},{"paragraph_id":"c-shiji-054-cao:p019","quote":"【索隱述贊】曹參初起，為沛豪吏。始從中涓，先圍善置。執珪執帛，攻城掠地。衍氏既誅，昆陽失位。北禽夏說，東討田溉。剖符定封，功無與二。市獄勿擾，清淨不事。尚主平陽，代享其利。"}],"rationale":"依本篇明示姓名與局部軍事、任官及子嗣敘事暫接；曹氏時、襄不按單字全域配對。未名者不補姓名，秦司馬夷字待底本核定，田既與田溉不擅同指。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji092-028","person_id":"632_664_al2","scope":"same_chapter","chapter_ids":["c-shiji-092-hanxin"],"status":"contextual_provisional","rationale":"按明示姓名及局部事件承接；王號限敘事主體，酈食其酈生及蒯通蒯生暫接，未名者與引古人物各存。不補邯欣翳及周召等短稱完整姓名。","reviewer":"Codex（AI 代理）","surfaces":["夏說"],"evidence":[{"paragraph_id":"c-shiji-092-hanxin:p008","quote":"漢之敗卻彭城，塞王欣、翟王翳亡漢降楚，齊、趙亦反漢與楚和。六月，魏王豹謁歸視親疾，至國，即絕河關反漢，與楚約和。漢王使酈生說豹，不下。其八月，以信爲左丞相，擊魏。魏王盛兵蒲阪，塞臨晉，信乃益爲疑兵，陳船欲度臨晉，而伏兵從夏陽以木罌缻渡軍，襲安邑。魏王豹驚，引兵迎信，信遂虜豹，定魏爲河東郡。漢王遣張耳與信俱，引兵東，北擊趙、代。後九月，破代兵，禽夏說閼與。信之下魏破代，漢輒使人收其精兵，詣滎陽以距楚。"},{"paragraph_id":"c-shiji-092-hanxin:p009","quote":"信與張耳以兵數萬，欲東下井陘擊趙。趙王、成安君陳餘聞漢且襲之也，聚兵井陘口，號稱二十萬。廣武君李左車說成安君曰：『聞漢將韓信涉西河，虜魏王，禽夏說，新喋血閼與，今乃輔以張耳，議欲下趙，此乘勝而去國遠鬬，其鋒不可當。臣聞千里餽糧，士有飢色，樵蘇後爨，師不宿飽。今井陘之道，車不得方軌，騎不得成列，行數百里，其勢糧食必在其後。願足下假臣奇兵三萬人，從閒道絕其輜重；足下深溝髙壘，堅營勿與戰。彼前不得鬬，退不得還，吾奇兵絕其後，使野無所掠，不至十日，而兩將之頭可致於戲下。願君留意臣之計。否，必爲二子所禽矣。』成安君，儒者也，常稱義兵不用詐謀奇計，曰：『吾聞兵法十則圍之，倍則戰。今韓信兵號數萬，其實不過數千。能千里而襲我，亦已罷極。今如此避而不擊，後有大者，何以加之！則諸侯謂吾怯，而輕來伐我。』不聽廣武君策，廣武君策不用。"},{"paragraph_id":"c-shiji-092-hanxin:p012","quote":"於是信問廣武君曰：『仆欲北攻燕，東伐齊，何若而有功？』廣武君辭謝曰：『臣聞敗軍之將，不可以言勇，亡國之大夫，不可以圖存。今臣敗亡之虜，何足以權大事乎！』信曰：『仆聞之，百里奚居虞而虞亡，在秦而秦霸，非愚於虞而智於秦也，用與不用，聽與不聽也。誠令成安君聽足下計，若信者亦已爲禽矣。以不用足下，故信得侍耳。』因固問曰：『仆委心歸計，願足下勿辭。』廣武君曰：『臣聞智者千慮，必有一失；愚者千慮，必有一得。故曰「狂夫之言，聖人擇焉」。顧恐臣計未必足用，願效愚忠。夫成安君有百戰百勝之計，一旦而失之，軍敗鄗下，身死泜上。今將軍涉西河，虜魏王，禽夏說閼與，一舉而下井陘，不終朝破趙二十萬眾，誅成安君。名聞海內，威震天下，農夫莫不輟耕釋耒，褕衣甘食，傾耳以待命者。若此，將軍之所長也。然而眾勞卒罷，其實難用。今將軍欲舉倦獘之兵，頓之燕堅城之下，欲戰恐久力不能拔，情見勢屈，曠日糧竭，而弱燕不服，齊必距境以自彊也。燕齊相持而不下，則劉項之權未有所分也。若此者，將軍所短也。臣愚，竊以爲亦過矣。故善用兵者不以短擊長，而以長擊短。』韓信曰：『然則何由？』廣武君對曰：『方今爲將軍計，莫如案甲休兵，鎮趙撫其孤，百里之內，牛酒日至，以饗士大夫醳兵，北首燕路，而後遣辯士奉咫尺之書，暴其所長於燕，燕必不敢不聽從。燕已從，使諠言者東告齊，齊必從風而服，雖有智者，亦不知爲齊計矣。如是，則天下事皆可圖也。兵固有先聲而後實者，此之謂也。』韓信曰：『善。』從其策，發使使燕，燕從風而靡。乃遣使報漢，因請立張耳爲趙王，以鎮撫其國。漢王許之，乃立張耳爲趙王。"},{"paragraph_id":"c-shiji-092-hanxin:p019","quote":"韓信曰：『漢王遇我甚厚，載我以其車，衣我以其衣，食我以其食。吾聞之，乘人之車者載人之患，衣人之衣者懷人之憂，食人之食者死人之事，吾豈可以鄉利倍義乎！』蒯生曰：『足下自以爲善漢王，欲建萬世之業，臣竊以爲誤矣。始常山王、成安君爲布衣時，相與爲刎頸之交，後爭張黶、陳澤之事，二人相怨。常山王背項王，奉項嬰頭而竄，逃歸於漢王。漢王借兵而東下，殺成安君泜水之南，頭足異處，卒爲天下笑。此二人相與，天下至驩也。然而卒相禽者，何也？患生於多欲而人心難測也。今足下欲行忠信以交於漢王，必不能固於二君之相與也，而事多大於張黶、陳澤。故臣以爲足下必漢王之不危己，亦誤矣。大夫種、范蠡存亡越，霸句踐，立功成名而身死亡。野獸已盡而獵狗亨。夫以交友言之，則不如張耳之與成安君者也；以忠信言之，則不過大夫種、范蠡之於句踐也。此二人者，足以觀矣。願足下深慮之。且臣聞勇略震主者身危，而功蓋天下者不賞。臣請言大王功略：足下涉西河，虜魏王，禽夏說，引兵下井陘，誅成安君，徇趙，脅燕，定齊，南摧楚人之兵二十萬，東殺龍且，西鄉以報，此所謂功無二於天下，而略不世出者也。今足下戴震主之威，挾不賞之功，歸楚，楚人不信；歸漢，漢人震恐：足下欲持是安歸乎？夫勢在人臣之位而有震主之威，名髙天下，竊爲足下危之。』韓信謝曰：『先生且休矣，吾將念之。』"}]}],"equivalence_decisions":[{"id":"eq-shiji092-review-xiashuo","person_ids":["632_664_al2"],"canonical_person_id":"632_664_al2","scope":"cross_chapter","chapter_ids":["c-shiji-092-hanxin","c-shiji-054-cao"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-092-hanxin","source_id":"s-shiji-092-hanxin","paragraph_id":"c-shiji-092-hanxin:p008","quote":"漢之敗卻彭城，塞王欣、翟王翳亡漢降楚，齊、趙亦反漢與楚和。六月，魏王豹謁歸視親疾，至國，即絕河關反漢，與楚約和。漢王使酈生說豹，不下。其八月，以信爲左丞相，擊魏。魏王盛兵蒲阪，塞臨晉，信乃益爲疑兵，陳船欲度臨晉，而伏兵從夏陽以木罌缻渡軍，襲安邑。魏王豹驚，引兵迎信，信遂虜豹，定魏爲河東郡。漢王遣張耳與信俱，引兵東，北擊趙、代。後九月，破代兵，禽夏說閼與。信之下魏破代，漢輒使人收其精兵，詣滎陽以距楚。","mention_ids":["c-shiji-092-hanxin:m008-0173"]},{"chapter_id":"c-shiji-054-cao","source_id":"s-shiji-054-cao","paragraph_id":"c-shiji-054-cao:p005","quote":"高祖（三）［二］年，拜為假左丞相，入屯兵關中。月餘，魏王豹反，以假左丞相別與韓信東攻魏將軍孫遬軍東張，大破之。因攻安邑，得魏將王襄。擊魏王於曲陽，追至武垣，生得魏王豹。取平陽，得魏王母妻子，盡定魏地，凡五十二城。賜食邑平陽。因從韓信擊趙相國夏說軍於鄔東，大破之，斬夏說。韓信與故常山王張耳引兵下井陘，擊成安君，而令參還圍趙別將戚將軍於鄔城中。戚將軍出走，追斬之。乃引兵詣敖倉漢王之所。韓信已破趙，為相國，東擊齊。參以右丞相屬韓信，攻破齊歷下軍，遂取臨菑。還定濟北郡，攻著、漯陰、平原、鬲、盧。已而從韓信擊龍且軍於上假密，大破之，斬龍且，虜其將軍周蘭。定齊，凡得七十餘縣。得故齊王田廣相田光，其守相許章，及故齊膠東將軍田既。韓信為齊王，引兵詣陳，與漢王共破項羽，而參留平齊未服者。","mention_ids":["c-shiji-054-cao:m005-0120","c-shiji-054-cao:m005-0132"]}],"rationale":"兩篇完整稱夏說，均在韓信下魏後北攻代趙、張耳下井陘前的共同軍事進程，暫接此處身份。淮陰侯篇禽夏說閼與，曹相國篇趙相國夏說軍於鄔東及斬夏說，分存被擒／被斬與地點、官稱差別，不把禽改死亡，不創一項連續代趙任期。使齊的另一夏說仍待獨立覆核，不憑同名擴大接合。同書平行敘述不當獨立見證，未核書影。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true}],"passages":[{"id":"c-shiji-054-cao:p005","text":"高祖（三）［二］年，拜為假左丞相，入屯兵關中。月餘，魏王豹反，以假左丞相別與韓信東攻魏將軍孫遬軍東張，大破之。因攻安邑，得魏將王襄。擊魏王於曲陽，追至武垣，生得魏王豹。取平陽，得魏王母妻子，盡定魏地，凡五十二城。賜食邑平陽。因從韓信擊趙相國夏說軍於鄔東，大破之，斬夏說。韓信與故常山王張耳引兵下井陘，擊成安君，而令參還圍趙別將戚將軍於鄔城中。戚將軍出走，追斬之。乃引兵詣敖倉漢王之所。韓信已破趙，為相國，東擊齊。參以右丞相屬韓信，攻破齊歷下軍，遂取臨菑。還定濟北郡，攻著、漯陰、平原、鬲、盧。已而從韓信擊龍且軍於上假密，大破之，斬龍且，虜其將軍周蘭。定齊，凡得七十餘縣。得故齊王田廣相田光，其守相許章，及故齊膠東將軍田既。韓信為齊王，引兵詣陳，與漢王共破項羽，而參留平齊未服者。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-054-cao:m005-0000","start":0,"end":2,"surface":"高祖","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m005-0026","start":26,"end":29,"surface":"魏王豹","kind":"person","person_id":"esh_8wg_qx0","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m005-0038","start":38,"end":40,"surface":"韓信","kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m005-0045","start":45,"end":47,"surface":"孫遬","kind":"person","person_id":"62z_e94_uw5","status":"contextual_provisional"},{"id":"c-