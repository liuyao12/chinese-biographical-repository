255,8256,8257,8258,8259,8260,8261,8262,8263,8264,8265,8266,8267,8268,8269,8270,8271,8272,8273,8274,8275,8276,8277,8278,8279,8280,8281,8282,8283,8284,8285,8286,8287,8288,8289,8290,8291,8292,8293,8294,8295,8296,8297,8298,8299,8300,8301,8302,8303,8304,8305,8306,8307,8308,8309,8310,8311,8312,8313,8314,8315,8316,8317,8318,8319,8320,8321,8322,8323],"revision_id":2581578},"mentions":[{"id":"c-jinshu-068-hexun:p003:m0001","surface":"陳敏","start":1,"end":3,"person_id":"kok_m7n_tux","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-068-hexun:p003:m0012","surface":"循","start":12,"end":13,"person_id":"626_bb5_ba2","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-068-hexun:p003:m0078","surface":"硃誕","start":78,"end":80,"person_id":"mey_7y5_atx","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-068-hexun:p003:m0093","surface":"周馥","start":93,"end":95,"person_id":"3xx_gdy_or6_BA","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-068-hexun","book_id":"b-jinshu-068","work_id":"w-jinshu","source_id":"s-jinshu-068-hexun-ws2581578"},{"id":"c-jinshu-076-guzhong:line114","text":"顧衆，字長始，吳郡吳人，驃騎將軍榮之族弟也。父秘，交州刺史，有文武才幹。衆出後伯父，早終，事伯母以孝聞。光祿硃誕器之。州辟主簿，舉秀才，除余杭、秣陵令，並不行。元帝為鎮東將軍。命為參軍。以討華軼功，封東鄉侯，辟丞相掾。秘卒，州人立衆兄壽為刺史，為州人所害，衆往交州迎喪，值杜弢之亂，崎嶇六年乃還。秘曾蒞吳興，吳興義故以衆經離寇難，共遺錢二百萬，一無所受。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-076-guzhong:line114:m0000","start":0,"end":2,"surface":"顧衆","kind":"person","person_id":"jfc_0dt_42a_A","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-076-guzhong:line114:m0004","start":4,"end":6,"surface":"長始","kind":"person","person_id":"jfc_0dt_42a_A","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-076-guzhong:line114:m0016","start":16,"end":17,"surface":"榮","kind":"person","person_id":"wtz_smr_dwz","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-076-guzhong:line1