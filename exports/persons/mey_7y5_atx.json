ed":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-076-guzhong:line114:m0054","start":54,"end":56,"surface":"硃誕","kind":"person","person_id":"mey_7y5_atx","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-076-guzhong:line114","chapter_id":"c-jinshu-076-guzhong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-076-guzhong:line114","text":"顧衆，字長始，吳郡吳人，驃騎將軍榮之族弟也。父秘，交州刺史，有文武才幹。衆出後伯父，早終，事伯母以孝聞。光祿硃誕器之。州辟主簿，舉秀才，除余杭、秣陵令，並不行。元帝為鎮東將軍。命為參軍。以討華軼功，封東鄉侯，辟丞相掾。秘卒，州人立衆兄壽為刺史，為州人所害，衆往交州迎喪，值杜弢之亂，崎嶇六年乃還。秘曾蒞吳興，吳興義故以衆經離寇難，共遺錢二百萬，一無所受。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-076-guzhong:line114:m0000","start":0,"end":2,"surface":"顧衆","kind":"person","person_id":"jfc_0dt_42a_A","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-076-guzhong:line114:m0004","start":4,"end":6,"surface":"長始","kind":"person","person_id":"jfc_0dt_42a_A","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-076-guzhong:line114:m0016","start":16,"end":17,"surface":"榮","kind":"person","person_id":"wtz_smr_dwz","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-076-guzhong:line114:m0023","start":23,"end":24,"surface":"秘","kind":"person","person_id":"jfc_0dt_42a","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-076-guzhong:line114:m0036","start":36,"end":37,"surface":"衆","kind":"person","person_id":"jfc_0dt_42a_A","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-076-guzhong:line114:m0054","start":54,"end":56,"surface":"硃誕","kind":"person","person_id":"mey_7y5_atx","status":"contextual_provi