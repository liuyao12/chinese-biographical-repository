s":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line058:m0381"},{"start":390,"end":392,"surface":"劉湛","kind":"person","person_id":"h3c_ulm_pto","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line058:m0390"},{"start":398,"end":400,"surface":"景仁","kind":"person","person_id":"740_57f_3ec","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line058:m0398"},{"start":435,"end":437,"surface":"賈充","kind":"person","person_id":"c27_590_7e3","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line058:m0435"},{"start":443,"end":444,"surface":"臣","kind":"person","person_id":"d84_kqu_2g5","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line058:m0443"},{"start":458,"end":459,"surface":"臣","kind":"person","person_id":"d84_kqu_2g5","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line058:m0458"},{"start":467,"end":469,"surface":"陛下","kind":"person","person_id":"3bh_k4m_fg4","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line058:m0467"},{"start":479,"end":481,"surface":"炳之","kind":"person","person_id":"4qr_wrk_3vd_DDBB","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line058:m0479"},{"start":515,"end":517,"surface":"范曄","kind":"person","person_id":"bxh_oop_5ic","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line058:m0515"},{"start":549,"end":551,"surface":"陛下","kind":"person","person_id":"3bh_k4m_fg4","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line058:m0549"},{"start":590,"end":591,"surface":"臣","kind":"person","person_id":"d84_kqu_2g5","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line058:m0590"}],"source_position":{"first_line":58,"last_line":58,"revision_id":1996685,"editorial_excerpt_boundary":false},"text_layer":"received_chapter","chapter_id":"c-songshu-053-yu-dengzhi","book_id":"b-songshu-053","work_id":"w-songshu","source_id":"s-songshu-053-yu-dengzhi"},{"id":"c-songshu-053-yu-dengzhi:line064","text":"太祖欲出炳之為丹陽，又以問尚之，尚之答曰：「臣既乏賈生應對之才，又謝汲公犯顏之直，至於侍坐仰酬，每不能盡。昨出伏復深思，祇有愚滯，今之事跡，異口同音，便是彰著，政未測得物之數耳。可為蹈罪負恩，無所復少。且居官失和，未有此比。陛下遲遲舊恩，未忍窮法，為弘之大，莫復過此。方復有尹京赫赫之授，恐悉心奉國之人，於此而息；貪狼恣意者，歲月滋甚。非但虧點王化，乃治亂所由。如臣所聞天下論議，炳之常塵累日月，未見一豪增輝。今曲阿在水南，恩寵無異，而協首郡之榮，乃更成其形勢，便是老王雅也。古人云：『無賞罰，雖堯、舜不能為治也。』陛下豈可坐損皇家之重，迷一凡人。事若復在可否之間，亦不敢苟陳穴管。今之枉直，明白灼然，而叡王令王，反更不悟，令賈誼、劉向重生，豈不慷慨流涕於聖世邪。臣昔啟范曄，當時亦懼犯觸之尤，苟是愚懷所挹，政自不能不舒達，所謂雖九死而不悔者也。謂炳之且外出，若能修改，在職著稱，還亦不難，而可得少明國典，粗酬四海之誚。今愆釁如山，榮任不損，炳之若復有彰大之罪，誰復敢以聞述。且自非殊勳異績，亦何足塞今日之尤。歷觀古今，未有眾過藉藉，受貨數百萬，更得高官厚祿如今者也。臣每念聖化中有此事，未嘗不痛心疾首。設令臣等數人縱橫狼藉復如此，不審當復云何處之。近啟賈充遠鎮，今亦何足分，外出恐是策之良者。臣知陛下不能採臣言，故是臣不能盡己之愚至耳。今蒙恩榮者不少，臣何為獨懇懇於斯，實是尊主樂治之意。伏願試更垂察。」","annotation_status":"in_progress","mentions":[{"start":0,"end":2,"surface":"太祖","kind":"person","person_id":"3bh_k4m_fg4","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line064:m0000"},{"start":4,"end":6,"surface":"炳之","kind":"person","person_id":"4qr_wrk_3vd_DDBB","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line064:m0004"},{"start":13,"end":15,"surface":"尚之","kind":"person","person_id":"d84_kqu_2g5","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line064:m0013"},{"start":16,"end":18,"surface":"尚之","kind":"person","person_id":"d84_kqu_2g5","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line064:m0016"},{"start":22,"end":23,"surface":"臣","kind":"person","person_id":"d84_kqu_2g5","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line064:m0022"},{"start":25,"end":27,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line064:m0025"},{"start":34,"end":36,"surface":"汲公","kind":"person","person_id":"fmh_dmt_cql","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line064:m0034"},{"start":112,"end":114,"surface":"陛下","kind":"person","person_id":"3bh_k4m_fg4","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line064:m0112"},{"start":182,"end":183,"surface":"臣","kind":"person","person_id":"d84_