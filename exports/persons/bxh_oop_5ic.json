ble_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-songshu-053-yu-dengzhi"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"start":515,"end":517,"surface":"范曄","kind":"person","person_id":"bxh_oop_5ic","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line058:m0515","paragraph_id":"c-songshu-053-yu-dengzhi:line058","chapter_id":"c-songshu-053-yu-dengzhi"},{"start":335,"end":337,"surface":"范曄","kind":"person","person_id":"bxh_oop_5ic","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line064:m0335","paragraph_id":"c-songshu-053-yu-dengzhi:line064","chapter_id":"c-songshu-053-yu-dengzhi"},{"id":"c-songshu-093-recluses:line084:m0008","start":8,"end":10,"surface":"范曄","kind":"person","person_id":"bxh_oop_5ic","status":"contextual_provisional","paragraph_id":"c-songshu-093-recluses:line084","chapter_id":"c-songshu-093-recluses"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-songshu-053-yu-dengzhi:line058","text":"炳之為人強急而不耐煩，賓客干訴非理者，忿詈形於辭色。素無術學，不為眾望所推。性好潔，士大夫造之者，去未出戶，輒令人拭席洗牀。時陳郡殷沖亦好淨，小史非淨浴新衣，不得近左右。士大夫小不整潔，每容接之。炳之好潔反是，沖每以此譏焉。領選既不緝眾論，又頗通貨賄。炳之請急還家，吏部令史錢泰、主客令史周伯齊出炳之宅諮事。泰能彈琵琶，伯齊善歌，炳之因留停宿。尚書舊制，令史諮事，不得宿停外，雖有八座命，亦不許。為有司所奏。上於炳之素厚，將恕之，召問尚書右僕射何尚之，尚之具陳炳之得失。又密奏曰：「夫為國為家，何嘗不謹用前典，今苟欲通一人，慮非哲王御世之長術。炳之所行，非曖昧而已，臣所聞既非一旦，又往往眼見，事如丘山，彰彰若此，遂縱而不糾，不知復何以為治。晉武不曰明主，斷鬲令事，遂能奮發，華廙見待不輕，廢錮累年，後起，止作城門校尉耳。若言炳之有誠於國，未知的是何事？政當云與殷景仁不失其舊，與劉湛亦復不疏。且景仁當時事意，豈復可蔑，朝士兩邊相推，亦復何限，縱有微誠，復何足掩其惡。今賈充勳烈，晉之重臣，雖事業不勝，不聞有大罪，諸臣進說，便遠出之。陛下聖叡，反更遲遲於此。炳之身上之釁，既自藉藉，交結朋黨，構扇是非，實足亂俗傷風。諸惡紛紜，過於范曄，所少賊一事耳。伏願深加三思，試以諸聲傳，普訪諸可顧問者。羣下見陛下顧遇既重，恐不敢苦相侵傷，顧問之日，宜布嫌責之旨。若不如此，亦當不辯有所得失。臣憃，既有所啟，要欲盡其心，如無可納，伏願宥其觸忤之罪。」","annotation_status":"in_progress","mentions":[{"start":0,"end":2,"surface":"炳之","kind":"person","person_id":"4qr_wrk_3vd_DDBB","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line058:m0000"},{"start":65,"end":67,"surface":"殷沖","kind":"person","person_id":"0f2_bd2_db3","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line058:m0065"},{"start":98,"end":100,"surface":"炳之","kind":"person","person_id":"4qr_wrk_3vd_DDBB","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line058:m0098"},{"start":105,"end":106,"surface":"沖","kind":"person","person_id":"0f2_bd2_db3","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line058:m0105"},{"start":126,"end":128,"surface":"炳之","kind":"person","person_id":"4qr_wrk_3vd_DDBB","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line058:m0126"},{"start":137,"end":139,"surface":"錢泰","kind":"person","person_id":"7fd_845_97f","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line058:m0137"},{"start":144,"end":147,"surface":"周伯齊","kind":"person","person_id":"a68_095_73d","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line058:m0144"},{"start":148,"end":150,"surface":"炳之","kind":"person","person_id":"4qr_wrk_3vd_DDBB","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line058:m0148"},{"start":154,"end":155,"surface":"泰","kind":"person","person_id":"7fd_845_97f","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line058:m0154"},{"start":160,"end":162,"surface":"伯齊","kind":"person","person_id":"a68_095_73d","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line058:m0160"},{"start":165,"end":167,"surface":"炳之","kind":"person","person_id":"4qr_wrk_3vd_DDB