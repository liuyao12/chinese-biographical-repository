3-yu-dengzhi:line064:m0374"},{"start":421,"end":423,"surface":"炳之","kind":"person","person_id":"4qr_wrk_3vd_DDBB","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line064:m0421"},{"start":484,"end":485,"surface":"臣","kind":"person","person_id":"d84_kqu_2g5","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line064:m0484"},{"start":504,"end":505,"surface":"臣","kind":"person","person_id":"d84_kqu_2g5","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line064:m0504"},{"start":527,"end":529,"surface":"賈充","kind":"person","person_id":"c27_590_7e3","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line064:m0527"},{"start":547,"end":548,"surface":"臣","kind":"person","person_id":"d84_kqu_2g5","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line064:m0547"},{"start":549,"end":551,"surface":"陛下","kind":"person","person_id":"3bh_k4m_fg4","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line064:m0549"},{"start":554,"end":555,"surface":"臣","kind":"person","person_id":"d84_kqu_2g5","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line064:m0554"},{"start":559,"end":560,"surface":"臣","kind":"person","person_id":"d84_kqu_2g5","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line064:m0559"},{"start":577,"end":578,"surface":"臣","kind":"person","person_id":"d84_kqu_2g5","status":"contextual_provisional","id":"c-songshu-053-yu-dengzhi:line064:m0577"}],"source_position":{"first_line":64,"last_line":64,"revision_id":1996685,"editorial_excerpt_boundary":false},"text_layer":"received_chapter","chapter_id":"c-songshu-053-yu-dengzhi","book_id":"b-songshu-053","work_id":"w-songshu","source_id":"s-songshu-053-yu-dengzhi"},{"id":"c-songshu-093-recluses:line084","text":"默之子熙先，事在范曄傳。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-songshu-093-recluses:line084:m0000","start":0,"end":2,"surface":"默之","kind":"person","person_id":"vhw_07a_wzm_AB","status":"contextual_provisional"},{"id":"c-songshu-093-recluses:line084:m0003","start":3,"end":5,"surface":"熙先","kind":"person","person_id":"vhw_07a_wzm_ABA","status":"contextual_provisional"},{"id":"c-songshu-093-recluses:line084:m0008","start":8,"end":10,"surface":"范曄","kind":"person","person_id":"bxh_oop_5ic","status":"contextual_provisional"}],"source_position":{"first_line":84,"last_line":84,"revision_id":1962755,"editorial_excerpt_boundary":false},"chapter_id":"c-songshu-093-recluses","book_id":"b-songshu-093","work_id":"w-songshu","source_id":"s-songshu-093-recluses"}],"sources":[{"chapter_id":"c-songshu-053-yu-dengzhi","work_id":"w-songshu","book_id":"b-songshu-053","source_id":"s-songshu-053-yu-dengzhi","source":{"title":"《宋書》卷五十三〈庾登之、沖遠及附弟炳之〉","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?oldid=1996685","permalink":"https://zh.wikisource.org/w/index.php?oldid=1996685","revision_id":1996685,"accessed_on":"2026-10-19","extent":"庾登之及子沖遠、附弟炳之完整傳文單元；非全卷。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"edition":"維基文庫數位轉錄；未核底本影像","response_sha256":"3cc63ab23c4ef74af4b62e3f025df8ce78559d0850089ac074aba95be474403c","wikitext_sha256":"95226c86fe13d535c410f8134c09048a22423305a5a65c8111dbde136802cbae","rights":"古代正文；維基文庫數位轉錄保留來源及共享授權資訊。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"extraction_note":"刪除段首縮排、維基連結語法與粗體符號；YL年號模板取顯示字；-{字}-取實際指定字；ref數位校勘注另存，正文不校改。","excerpts":[{"paragraph_id":"c-songshu-053-yu-dengzhi:line043","source_lines":[43,43],"raw_quote":"庾登之字元龍，潁川𨻳陵人也。曾祖冰，晉司空。祖蘊，廣州刺史。父廓，<ref>父廓　「廓」晉書作「廓之」。東晉南北朝人名後之「之」字，有時可省去。</ref>東陽太守。","raw_quote_sha256":"d9b9e240fc08766daff5dac9021eb4834d5a687d8c64d4d6e465acb02b7e7b9d","selected_text_sha256":"cc847aba6a2c46ee29930fd865091013d8ba3b7cdc9dc3900f34038b26f704d5","removed_digital_editorial_notes":[{"text":"父廓　「廓」晉書作「廓之」。東晉南北朝人名後之「之」字，有時可省去。","independently_verified":false,"text_layer":"modern_digital_apparatus"}]},{"paragraph_id":"c-songshu-053-yu-dengzhi:line045","source_lines":[45,45],"raw_quote":"登之少以強濟自立。初為晉會稽王道子太傅參軍。義旗初，又為高祖鎮軍參軍。以預討桓玄功，封曲江縣五等男。參大司馬琅邪王軍事，豫州別駕從事史，大司馬主簿，司徒左西曹屬。登之雖不涉學，善於世事，王弘、謝晦、江夷之徒，皆相知友。轉太尉主簿。義熙十二年，高祖北伐，登之擊節驅馳，退告劉穆之，以母老求郡。于時士庶咸憚遠役，而登之二三其心，高祖大怒，除吏名。大軍發後，乃以補鎮蠻護軍、西陽太守。入為太子庶子，尚書左丞。出為新安太守。","raw_quote_sha256":"c8a56bae481f5e2fb48ec824f9785b6fd34fca69571ae87953db807cc69f235c","selected_text_sha256":"c8a56bae481f5e2fb48ec824f9785b6fd34fca69571ae87953db807cc69f235c","removed_digital_editorial_notes":[]},{"paragraph_id":"c-songshu-053-yu-dengzhi:line047","source_lines":[47,47],"raw_quote":"謝晦為撫軍將軍、荊州刺史，請為長史、南郡太守，仍為衞軍長史，太守如故。登之與晦俱曹氏壻，名位本同，一旦為之佐，意甚不愜。到廳牋，唯云「即日恭到」，初無感謝之言。每入覲見，備持箱囊几席之屬，一物不具不坐。晦常優容之。晦拒王師，欲使登之留守，登之不許，語在晦傳。晦敗，登之以無任免罪，禁錮還家。","raw_quote_sha256":"f3dd2e6299c4f6e1a133cf8282221cf41002765c44dd60ab73af7d769adde5dd","selected_text_sha256":"f3dd2e6299c4f6e1a133cf8282221cf41002765c44dd60ab73af7d769adde5dd","removed_digital_editorial_notes":[]},{"paragraph_id":"c-songshu-053-yu-dengzhi:line049","source_lines":[49,49],"raw_quote":"元嘉五年，起為衡陽王義季征虜長史。義季年少，未親政，眾事一以委之。尋加南東海太守。入為司徒右長史，尚書吏部郎，司徒左長史，南東海太守。府公彭城王義康專覽政事，不欲自下厝懷，而登之性剛，每陳己意，義康甚不悅，出為吳郡太守。州郡相臨，執意無改，因其莅任贓貨，以事免官。弟炳之時為臨川內史，登之隨弟之郡，優游自適。俄而除豫章太守，便道之官。登之初至臨川，吏民咸相輕侮，豫章與臨川接境，郡又華大，儀迓光赫，土人並驚歎焉。十八年，遷江州刺史。疾篤，徵為中護軍，未拜。二十年，卒，時年六十二。即以為贈。","raw_quote_sha256":"3531e5e5485303ada50bd1358a4eca85ee8a71e407fe12213b215c71c7c1c3b5","selected_text_sha256":"3531e5e5485303ada50bd1358a4eca85ee8a71e407fe12213b215c71c7c1c3b5","removed_digital_editorial_notes":[]},{"paragraph_id":"c-songshu-053-yu-dengzhi:line051","source_lines":[51,51],"raw_quote":"子沖遠，<ref>子沖遠　「沖遠」南史作「仲遠」。</ref>太宗鎮姑孰，為衞軍長史，卒於豫章太守，追贈侍中。","raw_quote_sha256":"9af951a4e7da4833c2603a6792e784523f0c31b60964266553ce38be3130674e","selected_text_sha256":"9c299def46c7915590ef0d67201f166ca8ff37bdcb9f44110c10912a6f3322b2","removed_digital_editorial_notes":[{"text":"子沖遠　「沖遠」南史作「仲遠」。","independently_verified":false,"text_layer":"modern_digital_apparatus"}]},{"paragraph_id":"c-songshu-053-yu-dengzhi:line054","source_lines":[54,54],"raw_quote":"炳之字仲文，初為祕書、太子舍人，劉粹征北長史、廣平太守。兄登之為謝晦長史，炳之往省之。晦時位高權重，朝士莫不加敬，炳之獨與抗禮，時論健之。為尚書度支郎，不拜。出補錢唐令，治民有績。轉彭城王義康驃騎主簿，未就，徙為丹陽丞。炳之既未到府，疑於府公禮敬，下禮官博議。中書侍郎裴松之議曰：「案春秋桓八年，祭公逆王后于紀。公羊傳曰：『女在國稱女，此其稱王后何？王者無外，其辭成矣。』推此而言，則炳之為吏之道，定於受命之日矣，其辭已成，在官無外，名器既正，則禮亦從之。且今宰牧之官，拜不之職，未接之民，必有其敬者，以既受王命，則成君民之義故也。吏之被勑，猶除者受拜，民不以未見闕其被禮，吏安可以未到廢其節乎？愚懷所見，宜執吏禮。」從之。遷司徒左西屬。左將軍竟陵王義宣未親府板炳之為諮議參軍，<ref>左將軍竟陵王義宣未親府板炳之為諮議參軍　疑「未親」下脫「政」字，「府」字屬下句。</ref>眾務悉委焉。後將軍長沙王義欣鎮壽陽，炳之為長史、南梁郡太守，轉鎮軍長史，太守如故。出為臨川內史。後將軍始興王濬鎮湘州，以炳之為司馬，領長沙內史。濬不之任，除南泰山太守，<ref>除南泰山太守　南史作「南梁太守」。</ref>司馬如故。","raw_quote_sha256":"b68076e566b2135671b720d72a576d9d899d4a9782dfbebea50eeb3faf508f7e","selected_text_sha256":"9447cc5934a090f8cf2d5a658cdc5b64efca42d03e382c5bfc34cfa3a1a4af60","removed_digital_editorial_notes":[{"text":"左將軍竟陵王義宣未親府板炳之為諮議參軍　疑「未親」下脫「政」字，「府」字屬下句。","independently_verified":false,"text_layer":"modern_digital_apparatus"},{"text":"除南泰山太守　南史作「南梁太守」。","independently_verified":false,"text_layer":"modern_digital_apparatus"}]},{"paragraph_id":"c-songshu-053-yu-dengzhi:line056","source_lines":[56,56],"raw_quote":"于時領軍將軍劉湛協附大將軍彭城王義康，而與僕射殷景仁有隙，凡朝士遊殷氏者，不得入劉氏之門，獨炳之遊二人之間，密盡忠於朝廷。景仁稱疾不朝見者歷年，太祖常令炳之銜命去來，湛不疑也。義康出藩，湛伏誅，以炳之為尚書吏部郎，與右衞將軍沈演之俱參機密。頃之，轉侍中，本州大中正。遷吏部尚書，領義陽王師。內外歸附，勢傾朝野。","raw_quote_sha256":"f3acb129af6f68db159ce62e6d866d181d35305c057106ab897d8b97bd54fece","selected_text_sha256":"f3acb129af6f68db159ce62e6d866d181d35305c057106ab897d8b97bd54fece","removed_digital_editorial_notes":[]},{"paragraph_id":"c-songshu-053-yu-dengzhi:line058","source_lines":[58,58],"raw_quote":"炳之為人強急而不耐煩，賓客干訴非理者，忿詈形於辭色。素無術學，不為眾望所推。性好潔，士大夫造之者，去未出戶，輒令人拭席洗牀。時陳郡殷沖亦好淨，小史非淨浴新衣，不得近左右。士大夫小不整潔，每容接之。炳之好潔反是，<ref>炳之好潔反是　局本作「炳之好潔反是」，三朝本、北監本、毛本作「炳之潔反是」。殿本作「炳之反是」。今從局本。</ref>沖每以此譏焉。領選既不緝眾論，又頗通貨賄。炳之請急還家，吏部令史錢泰、主客令史周伯齊出炳之宅諮事。<ref>吏部令史錢泰主客令史周伯齊出炳之宅諮事　「出」元龜四六０同宋書。通典職官典作「詣」。按六朝人云「出都」，意即至都。此云「出炳之宅」，謂自省出至炳之宅。出字本不誤，或杜佑恐後人不解此字義，遂改作「詣」。</ref>泰能彈琵琶，伯齊善歌，炳之因留停宿。尚書舊制，令史諮事，不得宿停外，雖有八座命，亦不許。為有司所奏。上於炳之素厚，將恕之，召問尚書右僕射何尚之，尚之具陳炳之得失。又密奏曰：「夫為國為家，何嘗不謹用前典，今苟欲通一人，慮非哲王御世之長術。炳之所行，非曖昧而已，臣所聞既非一旦，又往往眼見，事如丘山，彰彰若此，遂縱而不糾，不知復何以為治。晉武不曰明主，斷鬲令事，遂能奮發，華廙見待不輕，廢錮累年，後起，止作城門校尉耳。若言炳之有誠於國，未知的是何事？政當云與殷景仁不失其舊，與劉湛亦復不疏。且景仁當時事意，豈復可蔑，朝士兩邊相推，亦復何限，縱有微誠，復何足掩其惡。今賈充勳烈，<ref>今賈充勳烈　孫虨宋書考論云：「今字疑誤。」</ref>晉之重臣，雖事業不勝，不聞有大罪，諸臣進說，便遠出之。陛下聖叡，反更遲遲於此。炳之身上之釁，既自藉藉，交結朋黨，構扇是非，實足亂俗傷風。諸惡紛紜，過於范曄，所少賊一事耳。伏願深加三思，試以諸聲傳，普訪諸可顧問者。羣下見陛下顧遇既重，恐不敢苦相侵傷，顧問之日，宜布嫌責之旨。若不如此，亦當不辯有所得失。臣憃，既有所啟，要欲盡其心，如無可納，伏願宥其觸忤之罪。」","raw_quote_sha256":"ad117d9b39d4ea6428bc4bdbc9df3e87439e002ab08010509369ab8018956940","selected_text_sha256":"b02772c7e3750a8e95830b3635ebb3d9423a28a7d63949f2bea0af22e9fc9546","removed_digital_editorial_notes":[{"text":"炳之好潔反是　局本作「炳之好潔反是」，三朝本、北監本、毛本作「炳之潔反是」。殿本作「炳之反是」。今從局本。","independently_verified":false,"text_layer":"modern_digital_apparatus"},{"text":"吏部令史錢泰主客令史周伯齊出炳之宅諮事　「出」元龜四六０同宋書。通典職官典作「詣」。按六朝人云「出都」，意即至都。此云「出炳之宅」，謂自省出至炳之宅。出字本不誤，或杜佑恐後人不解此字義，遂改作「詣」。","independently_verified":false,"text_layer":"modern_digital_apparatus"},{"text":"今賈充勳烈　孫虨宋書考論云：「今字疑誤。」","independently_verified":false,"text_layer":"modern_digital_apparatus"}]},{"paragraph_id":"c-songshu-053-yu-dengzhi:line060","source_lines":[60,60],"raw_quote":"時炳之自理：「不諳臺制，令史並言停外非嫌。」太祖以炳之信受失所，小事不足傷大臣。尚之又陳曰：「炳之呼二令史出宿，令史諮都令史駱宰，宰云不通，吏部曹亦咸知不可，令史具向炳之說不得停之意，炳之了不聽納。此非為不解，直是苟相留耳。由外悉知此，<ref>由外悉知此　「由」嚴可均全宋文改作「內」，疑是。</ref>而誣於信受，羣情豈了，陛下不假為之辭。雖是令史，出乃遠虧朝典，又不得謂之小事。謝晦望實，非今者之疇，一事錯誤，免侍中官。王珣時賢小失，桓胤春蒐之謬，皆白衣領職。況公犯憲制者邪？不審可有同王、桓白衣例不？於任使無損，兼可得以為肅戒。孔萬祀居左丞之局，不念相當，語駱宰云：『炳之貴要，異他尚書身，政可得無言耳。』又云：『不癡不聾，不成姑公。』敢作此言，亦為異也。」","raw_quote_sha256":"bbb35967b09bdff859e3620cab2a866420c7e64b1870e67c798e254ad5ec05a4","selected_text_sha256":"47ca5385de015841dd23c3e1948be5c74951c4899b5c3604c2e29ae01d210b48","removed_digital_editorial_notes":[{"text":"由外悉知此　「由」嚴可均全宋文改作「內」，疑是。","independently_verified":false,"text_layer":"modern_digital_apparatus"}]},{"paragraph_id":"c-songshu-053-yu-dengzhi:line062","source_lines":[62,62],"raw_quote":"太祖猶優游之，使尚之更陳其意。尚之乃備言炳之愆過，曰：「尚書舊有增置幹二十人，以元、凱丞郎幹之假疾病，炳之常取十人私使，詢處幹闕，不得時補。<ref>詢處幹闕不得時補　孫虨宋書考論云：「詢蓋當時為尚書者名也。北堂書鈔歲時部引元嘉起居注有尚書郎樂詢。」</ref>近得王師，猶不遣還，臣令人語之，『先取人使，意常未安，今既有手力，不宜復留』。得臣此信，方復遣耳。大都為人好率懷行事，有諸紜紜，不悉可曉。臣思張遼之言，關羽雖兄弟，曹公父子，豈得不言。觀今人憂國實寡，臣復結舌，日月之明，或有所蔽。然不知臣者，豈不謂臣有爭競之迹，追以悵悵。臣與炳之周旋，俱被恩接，不宜復生厚薄。太尉昨與臣言，說炳之有諸不可，非唯一條，遠近相崇畏，震動四海，凡短人辦得致此，更復可嘉。虞秀之門生事之，累味珍肴，未嘗有乏，其外別貢，豈可具詳。炳之門中不問大小，誅求張幼緒，幼緒轉無以堪命。炳之先與劉德願殊惡，德願自持琵琶甚精麗。遺之，便復款然。市令盛馥進數百口材助營宅，恐人知，作虛買券。劉道錫驟有所輸，傾南俸之半。劉雍自謂得其力助，事之如父，夏中送甘蔗，若新發於州。國吏運載樵荻，無輟於道。諸見人有物，鮮或不求，聞劉遵考有材，便乞材，見好燭盤，便復乞之。選用不平，不可一二。太尉又云，炳之都無共事之體，凡所選舉，悉是其意，政令太尉知耳。論虞秀之作黃門，太尉不正答和，故得停。太尉近與炳之疏，欲用德願兒作州西曹，炳之乃啟用為主簿，即語德願，德願謝太尉。前後漏泄賣恩，亦復何極，縱不加罪，故宜出之。士庶忿疾之，非直項羽楚歌而已也。自從裴、劉刑罰以來，諸將陳力百倍，今日事實好惡可問。若赫然發憤，顯明法憲，陛下便可閑臥紫闥，無復一事也。」","raw_quote_sha256":"6a4a68f4ce86f3bdd49583c29ce3af0efcc9cd1946ea089020304179efdd61ac","selected_text_sha256":"0836bb58e88afdba2813a9b4fe792380dbdaa8a92450e91c16b8ad5a2b10a2b2","removed_digital_editorial_notes":[{"text":"詢處幹闕不得時補　孫虨宋書考論云：「詢蓋當時為尚書者名也。北堂書鈔歲時部引元嘉起居注有尚書郎樂詢。」","independently_verified":false,"text_layer":"modern_digital_apparatus"}]},{"paragraph_id":"c-songshu-053-yu-dengzhi:line064","source_lines":[64,64],"raw_quote":"太祖欲出炳之為丹陽，又以問尚之，尚之答曰：「臣既乏賈生應對之才，又謝汲公犯顏之直，至於侍坐仰酬，每不能盡。昨出伏復深思，祇有愚滯，今之事跡，異口同音，便是彰著，政未測得物之數耳。可為蹈罪負恩，無所復少。且居官失和，未有此比。陛下遲遲舊恩，未忍窮法，為弘之大，莫復過此。方復有尹京赫赫之授，恐悉心奉國之人，於此而息；貪狼恣意者，歲月滋甚。非但虧點王化，乃治亂所由。如臣所聞天下論議，炳之常塵累日月，未見一豪增輝。今曲阿在水南，恩寵無異，而協首郡之榮，乃更成其形勢，便是老王雅也。古人云：『無賞罰，雖堯、舜不能為治也。』陛下豈可坐損皇家之重，迷一凡人。事若復在可否之間，亦不敢苟陳穴管。今之枉直，明白灼然，而叡王令王，反更不悟，令賈誼、劉向重生，豈不慷慨流涕於聖世邪。臣昔啟范曄，當時亦懼犯觸之尤，苟是愚懷所挹，政自不能不舒達，<ref>政自不能不舒達　下一「不」字，各本並脫，據南史補。</ref>所謂雖九死而不悔者也。謂炳之且外出，若能修改，在職著稱，還亦不難，而可得少明國典，粗酬四海之誚。今愆釁如山，榮任不損，炳之若復有彰大之罪，誰復敢以聞述。且自非殊勳異績，亦何足塞今日之尤。歷觀古今，未有眾過藉藉，受貨數百萬，更得高官厚祿如今者也。臣每念聖化中有此事，未嘗不痛心疾首。設令臣等數人縱橫狼藉復如此，不審當復云何處之。近啟賈充遠鎮，今亦何足分，外出恐是策之良者。臣知陛下不能採臣言，故是臣不能盡己之愚至耳。今蒙恩榮者不少，臣何為獨懇懇於斯，實是尊主樂治之意。伏願試更垂察。」","raw_quote_sha256":"c645d9a8678dd9b87b4bb70fbcec621b4e02348272ecfe45e9417a4c4a5413d5","selected_text_sha256":"01d85d732d0cf55bbeffbbee2e69ced7bb0f57af0ab2be1e57d3ce9e8a5aaf44","removed_digital_editorial_notes":[{"text":"政自不能不舒達　下一「不」字，各本並脫，據南史補。","independently_verified":false,"text_layer":"modern_digital_apparatus"}]},{"paragraph_id":"c-songshu-053-yu-dengzhi:line066","source_lines":[66,66],"raw_quote":"又曰：「臣見劉伯寵大慷慨炳之所行，<ref>臣見劉伯寵大慷慨炳之所行　「劉伯寵」南史作「劉伯龍」。張森楷校勘記云：「劉伯寵見王僧虔帖，劉伯龍有鬼笑營利事，未知此處當是何人。」</ref>云有人送張幼緒，幼緒語人，吾雖得一縣，負三十萬錢，庾沖遠乃當送至新林，見縛束，猶未得解手。荀萬秋嘗詣炳之，值一客姓夏侯，主人問：『有好牛不？』云：『無。』問：『有好馬不？』又云：『無。政有佳驢耳。』炳之便答：『甚是所欲。』客出門，遂與相聞索之。劉道錫云是炳之所舉，就道錫索嫁女具及祠器，乃當百萬數。猶謂不然。選令史章龍向臣說，亦歎其受納之過，言『實得嫁女具，銅鑪四人舉乃勝，細葛斗帳等物，不可稱數』。在尚書中，令奴酤酃酒，利其百十，亦是立臺閣所無，不審少簡聖聽不？恐仰傷日月之明，臣竊為之歎息。」","raw_quote_sha256":"9ce0f7f9ab418f4e2ff0b3a04699fcedfdd560e72031074047c22aeaf407e129","selected_text_sha256":"1452fea3825feeafb01dad28e0e245090312bc3ce3bcd727556add64c6953200","removed_digital_editorial_notes":[{"text":"臣見劉伯寵大慷慨炳之所行　「劉伯寵」南史作「劉伯龍」。張森楷校勘記云：「劉伯寵見王僧虔帖，劉伯龍有鬼笑營利事，未知此處當是何人。」","independently_verified":false,"text_layer":"modern_digital_apparatus"}]},{"paragraph_id":"c-songshu-053-yu-dengzhi:line068","source_lines":[68,68],"raw_quote":"太祖乃可有司之奏，免炳之官。是歲，元嘉二十五年也。二十七年，卒於家。時年六十三。太祖錄其宿誠，追復本官。二子季遠、弘遠。","raw_quote_sha256":"958ffdfd1a037cb5f00b4a49c4fd349c293cbf284d92cef3c688618dff4b7c11","selected_text_sha256":"958ffdfd1a037cb5f00b4a49c4fd349c293cbf284d92cef3c688618dff4b7c11","removed_digital_editorial_notes":[]}],"verified_interparagraph_blank_lines":[{"source_lines":[50,50],"raw_quote":"","raw_quote_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","revision_id":1996685,"scope":"完整原段之間的空白，不是省略敘事"}]}}},{"chapter_id":"c-songshu-093-recluses","work_id":"w-songshu","book_id":"b-songshu-093","source_id":"s-songshu-093-recluses","source":{"title":"《宋書》卷93（王弘之、曇生與孔淳之傳）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E5%AE%8B%E6%9B%B8%2F%E5%8D%B793&oldid=1962755","permalink":"https://zh.wikisource.org/w/index.php?title=%E5%AE%8B%E6%9B%B8%2F%E5%8D%B793&oldid=1962755","revision_id":1962755,"accessed_on":"2026-10-19","extent":"王弘之及子曇生五原段、孔淳之四原段；同卷其他隱逸傳文未錄，不代表全卷完成。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，未親核底本影像","wikitext_sha256":"006115bbb0fa72042b9926f19b6ffbc952b7955b7f3a9fdf9c6fb3be71cb98aa","normalization":{"character_conversion":{},"extraction_note":"只去排版空白、展開原字形外殼及單參數年號模板及保留顯示字的維基連結外殼；數位ref另列，不改原字或標點，不以節題補姓名。","excerpts":[{"proposed_paragraph_id":"c-songshu-093-recluses:line060","source_lines":[60,60],"raw_quote":"王弘之字方平，琅邪臨沂人，宣訓衞尉鎭之弟也。","raw_quote_sha256":"8c856e8ccc99168f02ddf727d1cc7360f066ff7b1d918cc8820e2d5c8c989ba3","selected_text_sha256":"8c856e8ccc99168f02ddf727d1cc7360f066ff7b1d918cc8820e2d5c8c989ba3","begin_anchor":"王弘之字方平，琅邪臨沂人，宣訓衞尉鎭","end_anchor":"方平，琅邪臨沂人，宣訓衞尉鎭之弟也。"},{"proposed_paragraph_id":"c-songshu-093-recluses:line062","source_lines":[62,62],"raw_quote":"少孤貧，爲外祖-{徴}-士何准所撫育。從叔獻之及太原王恭，-{並}-貴重之。晉安帝隆安中，爲琅邪王中軍參軍，遷司徒主簿。家貧，而性好山水，求爲烏程令，<ref>求爲烏程令　「烏程」南史、-{御}-覽四八七引宋書作「烏傷」。</ref>尋以病歸。桓玄輔晉，桓謙以爲衞軍參軍。時琅邪殷仲文還姑孰，祖送傾朝，謙要弘之同行，答曰：「凡祖離送別，必在有情，下官與殷風馬不接，無縁扈從。」謙貴其言。母隨兄鎭之之安成郡，<ref>母隨兄鎭之之安成郡　「母」各本-{並}-作「毎」，據南史改。</ref>弘之解職同行，荊州刺史桓偉請爲南蠻長史。義熙初，何無忌又請爲右軍司馬。髙祖命爲徐州治中從事史，除員外散騎常侍，-{並}-不就。家在會稽上虞。從兄敬弘爲吏部尚書，奏曰：「聖明司契，載德惟新，垂-{鑑}-仄微，表揚隱介，默語仰風，荒遐傾首。前員外散騎常侍琅邪王弘之，恬漠丘園，放心居逸。前衞將軍參軍武昌郭希林，素履純潔，嗣徽前武。-{並}-撃壤聖朝，未蒙表飾，宜加旌聘，賁-{于}-丘園，以彰止遜之美，以祛動求之累。臣愚謂弘之可太子庶子，希林可著作郎。」即-{徴}-弘之爲庶子，不就。太祖即位，敬弘爲左-{僕}-射，又陳：「弘之髙行表-{於}-初筮，苦節彰-{於}-暮年，今内外晏然，當修太平之化，宜招空-{谷}-，以敦-{沖}-退之美。」元嘉四年，-{徴}-爲通直散騎常侍，又不就。敬弘嘗解貂裘與之，即着以采藥。","raw_quote_sha256":"5e9e34ead4450a6f958991d467c045c56c683116e9681d063cccb6e9f254406e","selected_text_sha256":"248af234d06e7504a83c195a1a44b8300db5859cac149dac227a6ea287164ad5","begin_anchor":"少孤貧，爲外祖徴士何准所撫育。從叔獻","end_anchor":"不就。敬弘嘗解貂裘與之，即着以采藥。","removed_digital_editorial_notes":[{"text":"求爲烏程令　「烏程」南史、-{御}-覽四八七引宋書作「烏傷」。","text_layer":"modern_digital_apparatus"},{"text":"母隨兄鎭之之安成郡　「母」各本-{並}-作「毎」，據南史改。","text_layer":"modern_digital_apparatus"}]},{"proposed_paragraph_id":"c-songshu-093-recluses:line064","source_lines":[64,64],"raw_quote":"性好釣，上虞江有一處名三石頭，弘之常垂綸-{於}-此。經過者不識之，或問：「漁師得魚賣不？」弘之曰：「亦自不得，得亦不賣。」日夕載魚入上虞郭，經親故門，各以一兩頭置門内而去。始-{寧}-沃川有佳山水，<ref>始-{寧}-沃川有佳山水　「沃川」各本-{並}-作「汰川」，據南史、建康實録改。按沃川即沃洲，在始-{寧}-縣境。</ref>弘之又依巖-{築}-室。謝靈運、顏延之-{並}-相欽重，靈運與廬陵王義眞牋曰：「會境既-{豐}-山水，是以江左嘉遁，-{並}-多居之。但季世慕榮，幽棲者寡，或-{復}--{才}-爲時求，弗獲從-{志}-。至若王弘之拂衣歸耕，踰歴三紀；孔淳之隱約窮岫，自始迄今；阮萬齡辭事就閑，纂成先業；浙河之外，棲遲山澤，如斯而已。既遠同羲、唐，亦激貪厲競。殿下愛素好古，常若布衣，毎意昔聞，虚想巖穴，若遣一介，<ref>若遣一介　「介」南史作「个」。禮大學：「若有一个臣。」</ref>有以相存，眞可謂千載盛美也。」","raw_quote_sha256":"b4d03a846ba2b52abeb67270ef29705a7d6fde817083a011223a00d46c632b39","selected_text_sha256":"aa35732151a46e13b0d137efc864128dcc084b43010eddd0913efef54c4677d7","begin_anchor":"性好釣，上虞江有一處名三石頭，弘之常","end_anchor":"一介，有以相存，眞可謂千載盛美也。」","removed_digital_editorial_notes":[{"text":"始-{寧}-沃川有佳山水　「沃川」各本-{並}-作「汰川」，據南史、建康實録改。按沃川即沃洲，在始-{寧}-縣境。","text_layer":"modern_digital_apparatus"},{"text":"若遣一介　「介」南史作「个」。禮大學：「若有一个臣。」","text_layer":"modern_digital_apparatus"}]},{"proposed_paragraph_id":"c-songshu-093-recluses:line066","source_lines":[66,66],"raw_quote":"弘之四年卒，時年六十三。顏延之欲爲作誄，書與弘之子-{曇}-生曰：「君家髙世之節，有識歸重，豫染豪翰，所應載述。況-{僕}--{託}-慕末風，竊以敍德爲事，但恨短筆不足書美。」誄竟不就。","raw_quote_sha256":"98d2c8d4eb6c22e79f7d479ae5d598e986bdbedb101070eac30c0301bedd4101","selected_text_sha256":"3611e6a3574731689ae1ac65d52e8b0c3a03604eb21da2bbe13db6b283d60a0d","begin_anchor":"弘之四年卒，時年六十三。顏延之欲爲作","end_anchor":"爲事，但恨短筆不足書美。」誄竟不就。"},{"proposed_paragraph_id":"c-songshu-093-recluses:line068","source_lines":[68,68],"raw_quote":"-{曇}-生好文義，以謙和見稱。歴顯位，吏部尚書，太常卿。大明末，爲呉興太守。太宗初，四方同逆，戰敗奔會稽，歸降被宥，終-{於}-中散大夫。","raw_quote_sha256":"b0e7f54131ac37dc3949d1fd531bfc9e68b733a103dfe9f33a7a38ab935f4226","selected_text_sha256":"6a721c25ec2686b96c803cac0863381cd5fb6950cb75723f1fd8f9a93ac13bf3","begin_anchor":"曇生好文義，以謙和見稱。歴顯位，吏部","end_anchor":"戰敗奔會稽，歸降被宥，終於中散大夫。"},{"proposed_paragraph_id":"c-songshu-093-recluses:line078","source_lines":[78,78],"raw_quote":"孔淳之字彦深，魯郡魯人也。祖惔，尚書祠部郎。父粲，祕書監-{徴}-，不就。","raw_quote_sha256":"e08c332904a4263abf24d68123effc7e91eb997d0dbb823d6267f592a180ce9d","selected_text_sha256":"e91afa096164f2f1d11d56487cdfc4433017fcfffc8a478318771a93701e5f27","begin_anchor":"孔淳之字彦深，魯郡魯人也。祖惔，尚書","end_anchor":"，尚書祠部郎。父粲，祕書監徴，不就。"},{"proposed_paragraph_id":"c-songshu-093-recluses:line080","source_lines":[80,80],"raw_quote":"淳之少有髙尚，愛好墳籍，爲太原王恭所稱。居會稽剡縣，性好山水，毎有所-{游}-，必窮其幽峻，或旬日忘歸。嘗-{游}-山，遇沙門釋法崇，因留共止，遂停三載。法崇嘆曰：「緬想人外，三十年矣，今乃傾蓋-{于}-茲，不覺老之將至也。」及淳之還反，不告以姓。除著作佐郎，太尉參軍，-{並}-不就。","raw_quote_sha256":"930341c337dbeecd9d8b216daa7189b76145cbb8643eb87b59c6bf6978ae1c41","selected_text_sha256":"bb58aefe079d98c9bd867b70ad3dd715329619bc4f330d2efd9e356b44e6dd4a","begin_anchor":"淳之少有髙尚，愛好墳籍，爲太原王恭所","end_anchor":"以姓。除著作佐郎，太尉參軍，並不就。"},{"proposed_paragraph_id":"c-songshu-093-recluses:line082","source_lines":[82,82],"raw_quote":"居喪至孝，廬-{于}-墓側。服闋，與-{徴}-士戴顒、王弘之及王敬弘等共爲人外之-{游}-。敬弘以女-{適}-淳之子尚。會稽太守謝方明苦要入郡，終不肯往。茅室蓬戸，庭草蕪逕，唯牀上有數巻書。元嘉初，-{復}--{徴}-爲散騎侍郎，乃逃-{于}-上虞縣界，家人莫知所之。弟默之爲廣州刺史，出都與別。司徒王弘要淳之集冶城，即日命駕東歸，遂不顧也。元嘉七年，卒，時年五十九。默之儒學，注-{穀}-梁春秋。","raw_quote_sha256":"73c664d828d9e0764d966cd39cd7142c7a72b29f1ef9838c9d8634d0d2ba931b","selected_text_sha256":"cf11977a38578aa5cd8bbd507915a88d95d2224b01716b291291fcba8991d6a7","begin_anchor":"居喪至孝，廬于墓側。服闋，與徴士戴顒","end_anchor":"，時年五十九。默之儒學，注穀梁春秋。"},{"proposed_paragraph_id":"c-songshu-093-recluses:line084","source_lines":[84,84],"raw_quote":"默之子熙先，事在-{范}-曄傳。","raw_quote_sha256":"37b3392ab143e5b7b6f3432d3bf2deab473549a21a82ada3841c15a08a22570e","selected_text_sha256":"fa4cadbde259d1c7f84f4b90f20828d9a568b83907295532e6b46ab7fceb9e81","begin_anchor":"默之子熙先，事在范曄傳。","end_anchor":"默之子熙先，事在范曄傳。"}]},"response_sha256":"e715e1ac86b592e0b9f1ff085b7018abc415de6b534dceb093ab0d2e9e5cdd7d"}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true}}
