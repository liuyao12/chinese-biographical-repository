{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004627","identity_policy":"contextual_provisional","person_ids":["cbr-p004627"],"persons":[{"id":"cbr-p004627","label":"李牧北邊所事趙王未名（廉頗藺相如列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"趙王","mention_ids":["c-shiji-081-lianlin:m022-0137","c-shiji-081-lianlin:m022-0148","c-shiji-081-lianlin:m023-0043"]},{"surface":"王","mention_ids":["c-shiji-081-lianlin:m023-0057","c-shiji-081-lianlin:m023-0072"]}],"evidence":[{"mention_id":"c-shiji-081-lianlin:m022-0137","chapter_id":"c-shiji-081-lianlin","paragraph_id":"c-shiji-081-lianlin:p022","quote":"趙王"},{"mention_id":"c-shiji-081-lianlin:m022-0148","chapter_id":"c-shiji-081-lianlin","paragraph_id":"c-shiji-081-lianlin:p022","quote":"趙王"},{"mention_id":"c-shiji-081-lianlin:m023-0043","chapter_id":"c-shiji-081-lianlin","paragraph_id":"c-shiji-081-lianlin:p023","quote":"趙王"},{"mention_id":"c-shiji-081-lianlin:m023-0057","chapter_id":"c-shiji-081-lianlin","paragraph_id":"c-shiji-081-lianlin:p023","quote":"王"},{"mention_id":"c-shiji-081-lianlin:m023-0072","chapter_id":"c-shiji-081-lianlin","paragraph_id":"c-shiji-081-lianlin:p023","quote":"王"}]}],"mentions":[{"id":"c-shiji-081-lianlin:m022-0137","start":137,"end":139,"surface":"趙王","kind":"person","person_id":"cbr-p004627","status":"contextual_provisional","paragraph_id":"c-shiji-081-lianlin:p022","chapter_id":"c-shiji-081-lianlin"},{"id":"c-shiji-081-lianlin:m022-0148","start":148,"end":150,"surface":"趙王","kind":"person","person_id":"cbr-p004627","status":"contextual_provisional","paragraph_id":"c-shiji-081-lianlin:p022","chapter_id":"c-shiji-081-lianlin"},{"id":"c-shiji-081-lianlin:m023-0043","start":43,"end":45,"surface":"趙王","kind":"person","person_id":"cbr-p004627","status":"contextual_provisional","paragraph_id":"c-shiji-081-lianlin:p023","chapter_id":"c-shiji-081-lianlin"},{"id":"c-shiji-081-lianlin:m023-0057","start":57,"end":58,"surface":"王","kind":"person","person_id":"cbr-p004627","status":"contextual_provisional","paragraph_id":"c-shiji-081-lianlin:p023","chapter_id":"c-shiji-081-lianlin"},{"id":"c-shiji-081-lianlin:m023-0072","start":72,"end":73,"surface":"王","kind":"person","person_id":"cbr-p004627","status":"contextual_provisional","paragraph_id":"c-shiji-081-lianlin:p023","chapter_id":"c-shiji-081-lianlin"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji081-028","person_id":"cbr-p004627","scope":"same_chapter","chapter_ids":["c-shiji-081-lianlin"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["王","趙王"],"evidence":[{"paragraph_id":"c-shiji-081-lianlin:p022","quote":"李牧者，趙之北邊良將也。常居代鴈門，備匈奴。以便宜置吏，市租皆輸入莫府，爲士卒費。日撃數牛饗士，習射騎，謹烽火，多間諜，厚遇戰士。爲約曰：「匈奴即入盜，急入收保，有敢捕虜者斬。」匈奴毎入，烽火謹，輒入收保，不敢戰。如是數歳，亦不亡失。然匈奴以李牧爲怯，雖趙邊兵亦以爲吾將怯。趙王讓李牧，李牧如故。趙王怒，召之，使他人代將。"},{"paragraph_id":"c-shiji-081-lianlin:p023","quote":"歳餘，匈奴毎來，出戰。出戰，數不利，失亡多，邊不得田畜。復請李牧。牧杜門不出，固稱疾。趙王乃復彊起使將兵。牧曰：「王必用臣，臣如前，乃敢奉令。」王許之。"}],"rationale":"依本篇明示姓名、國別君序與代將敘事暫接；李牧牧在明示北邊主題內同指，趙王遷王稱限定末次代將。北邊早年趙王、他人及單于未名分存，不強接悼襄；太史公讓頗承接廉藺敘事，其他引語指代待逐處覆核。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-081-lianlin:p022","text":"李牧者，趙之北邊良將也。常居代鴈門，備匈奴。以便宜置吏，市租皆輸入莫府，爲士卒費。日撃數牛饗士，習射騎，謹烽火，多間諜，厚遇戰士。爲約曰：「匈奴即入盜，急入收保，有敢捕虜者斬。」匈奴毎入，烽火謹，輒入收保，不敢戰。如是數歳，亦不亡失。然匈奴以李牧爲怯，雖趙邊兵亦以爲吾將怯。趙王讓李牧，李牧如故。趙王怒，召之，使他人代將。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-081-lianlin:m022-0000","start":0,"end":2,"surface":"李牧","kind":"person","person_id":"cbr-p004624","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m022-0019","start":19,"end":21,"surface":"匈奴","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未定角色或泛論保存，不補姓名。"},{"id":"c-shiji-081-lianlin:m022-0037","start":37,"end":39,"surface":"士卒","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未定角色或泛論保存，不補姓名。"},{"id":"c-shiji-081-lianlin