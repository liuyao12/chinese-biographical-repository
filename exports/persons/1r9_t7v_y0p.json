063-weigai:p003:m0082"}],"status":"source_attested","interpretation_note":"按同段人物與次第核所屬卒事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"mentions":[{"id":"c-jinshu-063-weigai:p002:m0038","surface":"馬瞻","start":38,"end":40,"person_id":"1r9_t7v_y0p","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-063-weigai:p002","chapter_id":"c-jinshu-063-weigai"},{"id":"c-jinshu-063-weigai:p002:m0047","surface":"瞻","start":47,"end":48,"person_id":"1r9_t7v_y0p","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-063-weigai:p002","chapter_id":"c-jinshu-063-weigai"},{"id":"c-jinshu-063-weigai:p003:m0082","surface":"馬瞻","start":82,"end":84,"person_id":"1r9_t7v_y0p","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-063-weigai:p003","chapter_id":"c-jinshu-063-weigai"},{"id":"c-jinshu-063-weigai:p003:m0097","surface":"瞻","start":97,"end":98,"person_id":"1r9_t7v_y0p","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-063-weigai:p003","chapter_id":"c-jinshu-063-weigai"},{"id":"c-jinshu-063-weigai:p003:m0118","surface":"瞻","start":118,"end":119,"person_id":"1r9_t7v_y0p","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-063-weigai:p003","chapter_id":"c-jinshu-063-weigai"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-063-weigai:p002","text":"時杜預子尹為弘農太守，屯宜陽界一泉塢，數為諸賊所抄掠。尹要該共距之，該遣其將馬瞻將三百人赴尹。瞻知其無備，夜襲尹殺之，迎該據塢。塢人震懼，並服從之。乃與李炬、郭默相結以距賊。荀籓即以該為武威將軍，統城西雍涼人，使討劉曜。元帝承制，加冠軍將軍、河東太守。督護河東、河南、平陽三郡。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":64,"last_line":64,"raw_start":5782,"raw_end":5923,"raw_character_offsets":[5784,5785,5786,5787,5788,5789,5790,5791,5792,5793,5794,5795,5796,5797,5798,5799,5800,5801,5802,5803,5804