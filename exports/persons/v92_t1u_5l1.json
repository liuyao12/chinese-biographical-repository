{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"v92_t1u_5l1","canonical_person_id":"v92_t1u_5l1","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["v92_t1u_5l1"],"persons":[{"id":"v92_t1u_5l1","label":"會稽太守（東越列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"會稽太守","mention_ids":["c-shiji-114-dongyue:m003-0220"]}],"evidence":[{"mention_id":"c-shiji-114-dongyue:m003-0220","chapter_id":"c-shiji-114-dongyue","paragraph_id":"c-shiji-114-dongyue:p003","quote":"會稽太守"}]}],"source_mention_summary":[{"source_id":"s-shiji114-dongyue","work_id":"w-shiji","book_id":"b-shiji-114","chapter_id":"c-shiji-114-dongyue","mention_count":1,"mention_ids":["c-shiji-114-dongyue:m003-0220"],"paragraph_ids":["c-shiji-114-dongyue:p003"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji114-dongyue"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-114-dongyue:m003-0220","start":220,"end":224,"surface":"會稽太守","kind":"person","person_id":"v92_t1u_5l1","status":"contextual_provisional","paragraph_id":"c-shiji-114-dongyue:p003","chapter_id":"c-shiji-114-dongyue"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-114-dongyue:p003","text":"吳王子子駒亡走閩越，怨東甌殺其父，常勸閩越擊東甌。至建元三年，閩越發兵圍東甌。東甌食盡，困，且降，乃使人告急天子。天子問太尉田蚡，蚡對曰：「越人相攻擊，固其常，又數反覆，不足以煩中國往救也。自秦時棄弗屬。」於是中大夫莊助詰蚡曰：「特患力弗能救，德弗能覆；誠能，何故棄之？且秦舉咸陽而棄之，何乃越也！今小國以窮困來告急天子，天子弗振，彼當安所告愬？又何以子萬國乎？」上曰：「太尉未足與計。吾初即位，不欲出虎符發兵郡國。」乃遣莊助以節發兵會稽。會稽太守欲距不為發兵，助乃斬一司馬，諭意指，遂發兵浮海救東甌。未至，閩越引兵而去。東甌請舉國徙中國，乃悉舉眾來，處江淮之閒。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-114-dongyue:m003-0000","start":0,"end":2,"surface":"吳王","kind":"person","person_id":"qfq_48j_lpj","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m003-0003","start":3,"end":5,"surface":"子駒","kind":"person","person_id":"qfq_48j_lpj_A","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m003-0054","start":54,"end":56,"surface":"天子","kind":"person","person_id":"y1h_fo3_brs","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m003-0057","start":57,"end":59,"surface":"天子","kind":"person","person_id":"y1h_fo3_brs","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m003-0062","start":62,"end":64,"surface":"田蚡","kind":"person","person_id":"al0_ke0_9c7","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m003-0065","start":65,"end":66,"surface":"蚡","kind":"person","person_id":"al0_ke0_9c7","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m003-0108","start":108,"end":110,"surface":"莊助","kind":"person","person_id":"i7l_4us_u58","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m003-0111","start":111,"end":112,"surface":"蚡","kind":"person","person_id":"al0_ke0_9c7","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m003-0158","start":158,"end":160,"surface":"天子","kind":"person","person_id":"y1h_fo3_brs","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m003-0161","start":161,"end":163,"surface":"天子","kind":"person","person_id":"y1h_fo3_brs","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m003-0182","start":182,"end":183,"surface":"上","kind":"person","person_id":"y1h_fo3_brs","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m003-0211","start":211,"end":213,"surf