":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-054-recluses-complete:p043","text":"　　何求字子有，廬江灊人也。祖尚之，宋司空，父鑠，宜都太守。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":114,"last_line":114,"raw_start":6385,"raw_end":6415,"raw_character_offsets":[6385,6386,6387,6388,6389,6390,6391,6392,6393,6394,6395,6396,6397,6398,6399,6400,6401,6402,6403,6404,6405,6406,6407,6408,6409,6410,6411,6412,6413,6414],"revision_id":1762878},"mentions":[{"id":"c-nanqishu-054-recluses-complete:p043:m0002","start":2,"end":4,"surface":"何求","kind":"person","person_id":"4j6_p4t_4k9","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p043:m0005","start":5,"end":7,"surface":"子有","kind":"person","person_id":"4j6_p4t_4k9","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p043:m0015","start":15,"end":17,"surface":"尚之","kind":"person","person_id":"d84_kqu_2g5","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p043:m0023","start":23,"end":24,"surface":"鑠","kind":"person","person_id":"o7e_h2m_qed","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-054-recluses-complete","book_id":"b-nanqishu-054","work_id":"w-nanqishu","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:p044","text":"　　求元嘉末爲宋文帝挽郎，解褐著作郎，中軍衞軍行佐，太子舍人，平南參軍，撫軍主簿，太子洗馬，丹陽、吳郡丞。清退無嗜欲。又除征北參軍事，司徒主簿，太子中舍人。泰始中，妻亡，還吳葬舊墓，除中書郎，不拜。仍住吳，居波若寺，足不踰戶，人莫見其面。明帝崩，出奔國哀，除爲司空從事中郎，不就。乃除永嘉太守。求時寄住南澗寺，不肯詣臺，乞於寺拜受，見許。一夜忽乘小船逃歸吳，隱虎丘山，復除黃門郎，不就。永明四年，世祖以爲太中大夫，又不就。七年，卒。年五十六。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":116,"last_line":116,"raw_start":6417,"raw_end":6638,"raw_character_offsets":[6417,6418,6419,6420,6421,6422,6423,6424,6425,6426,6427,6428,6429,6430,6431,6432,6433,6434,6435,6436,6437,6438,6439,6440,6441,6442,6443,644