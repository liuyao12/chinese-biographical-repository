start":7,"end":8,"surface":"潛","kind":"person","person_id":"kbq_kjc_n2f_A","status":"contextual_provisional","interpretation_note":"依完整裴潛單元及既有具名近系原錨交讀；印本未知、未圖校，非人工覆核。"},{"id":"c-sanguozhi-023-peiqian-ws2376966:p004:m0014","start":14,"end":21,"surface":"烏丸王及其大人","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"三名單于群稱，未名，不造單一王名或三個具名ID。"},{"id":"c-sanguozhi-023-peiqian-ws2376966:p004:m0045","start":45,"end":47,"surface":"太祖","kind":"person","person_id":"dad_b77_b38","status":"contextual_provisional","interpretation_note":"依完整裴潛單元及具體上下文辨識；原字及見證層次保留。"},{"id":"c-sanguozhi-023-peiqian-ws2376966:p004:m0049","start":49,"end":50,"surface":"潛","kind":"person","person_id":"kbq_kjc_n2f_A","status":"contextual_provisional","interpretation_note":"依完整裴潛單元及既有具名近系原錨交讀；印本未知、未圖校，非人工覆核。"},{"id":"c-sanguozhi-023-peiqian-ws2376966:p004:m0057","start":57,"end":58,"surface":"潛","kind":"person","person_id":"kbq_kjc_n2f_A","status":"contextual_provisional","interpretation_note":"依完整裴潛單元及既有具名近系原錨交讀；印本未知、未圖校，非人工覆核。"},{"id":"c-sanguozhi-023-peiqian-ws2376966:p004:m0139","start":139,"end":140,"surface":"潛","kind":"person","person_id":"kbq_kjc_n2f_A","status":"contextual_provisional","interpretation_note":"依完整裴潛單元及既有具名近系原錨交讀；印本未知、未圖校，非人工覆核。"},{"id":"c-sanguozhi-023-peiqian-ws2376966:p004:m0169","start":169,"end":170,"surface":"潛","kind":"person","person_id":"kbq_kjc_n2f_A","status":"contextual_provisional","interpretation_note":"依完整裴潛單元及既有具名近系原錨交讀；印本未知、未圖校，非人工覆核。"},{"id":"c-sanguozhi-023-peiqian-ws2376966:p004:m0183","start":183,"end":185,"surface":"郝溫","kind":"person","person_id":"47o_y0u_5jq","status":"contextual_provisional","interpretation_note":"依完整裴潛單元及具體上下文辨識；原字及見證層次保留。"},{"id":"c-sanguozhi-023-peiqian-ws2376966:p004:m0186","start":186,"end":188,"surface":"郭端","kind":"person","person_id":"g5o_m57_tuz","status":"contextual_provisional","interpretation_note":"依完整裴潛單元及具體上下文辨識；原字及見證層次保留。"},{"id":"c-sanguozhi-023-peiqian-ws2376966:p004:m0216","start":216,"end":21