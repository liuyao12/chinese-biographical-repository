":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-shiji097-013","person_id":"wfk_n4m_6x9","event_type":"death","status":"source_attested","date_expression":null,"source_term":"夜半時斬陳留令首","evidence":[{"chapter_id":"c-shiji-097-luli","source_id":"s-shiji-097-luli","paragraph_id":"c-shiji-097-luli:p023","quote":"於是酈生乃夜見陳留令，說之曰：「夫秦為無道而天下畔之，今足下與天下從則可以成大功。今獨為亡秦嬰城而堅守，臣竊為足下危之。」陳留令曰：「秦法至重也，不可以妄言，妄言者無類，吾不可以應。先生所以教臣者，非臣之意也，願勿復道。」酈生留宿臥，夜半時斬陳留令首，踰城而下報沛公。沛公引兵攻城，縣令首於長竿以示城上人，曰：「趣下，而令頭已斷矣！今後下者必先斬之！」於是陳留人見令已死，遂相率而下沛公。沛公舍陳留南城門上，因其庫兵，食積粟，留出入三月，從兵以萬數，遂入破秦。","person_mention_id":"c-shiji-097-luli:m023-0121"}],"interpretation_note":"本篇後段陳留敘事，與第3段說下陳留分存，不改前段為已記殺令。 未核書影。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"mentions":[{"id":"c-shiji-097-luli:m023-0007","start":7,"end":10,"surface":"陳留令","kind":"person","person_id":"wfk_n4m_6x9","status":"contextual_provisional","paragraph_id":"c-shiji-097-luli:p023","chapter_id":"c-shiji-097-luli"},{"id":"c-shiji-097-luli:m023-0061","start":61,"end":64,"surface":"陳留令","kind":"person","person_id":"wfk_n4m_6x9","status":"contextual_provisional","paragraph_id":"c-shiji-097-luli:p023","chapter_id":"c-shiji-097-luli"},{"id":"c-shiji-097-luli:m023-0121","start":121,"end":124,"surface":"陳留令","kind":"person","person_id":"wfk_n4m_6x9","status":"contextual_provisional","paragraph_id":"c-shiji-097-luli:p023","chapter_id":"c-shiji-097-luli"},{"id":"c-shiji-097-luli:m023-0142","start":142,"end":143,"surface":"令","kind":"person","person_id":"wfk_n4m_6x9","status":"contextual_provisional","paragraph_id":"c-shiji-097-luli:p023","chapter_id":"c-shiji-097-luli"},{"id":"c-shiji-097-luli:m023-0160","start":160,"end":161,"surface":"令","kind":"person","person_id":"wfk_n4m_6x9","status":"contextual_provisional","paragraph_id":"c-shiji-097-luli:p023","chapter_id":"c-shiji-097-luli"}],"relations":[],"title_holdings":[],"address_assertions":[],"tabl