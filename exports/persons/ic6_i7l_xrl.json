tus":"contextual_provisional"},{"id":"c-songshu-049-kuaien:p002:m0102","start":102,"end":105,"surface":"范崇民","kind":"person","person_id":"ic6_i7l_xrl","status":"contextual_provisional"},{"id":"c-songshu-049-kuaien:p002:m0109","start":109,"end":110,"surface":"循","kind":"person","person_id":"m8n_ntm_79h_ABBA**A","status":"contextual_provisional"},{"id":"c-songshu-049-kuaien:p002:m0116","start":116,"end":117,"surface":"恩","kind":"person","person_id":"sn4_yf4_esv","status":"contextual_provisional"},{"id":"c-songshu-049-kuaien:p002:m0123","start":123,"end":125,"surface":"劉藩","kind":"person","person_id":"0ky_guf_s9d","status":"contextual_provisional"},{"id":"c-songshu-049-kuaien:p002:m0126","start":126,"end":129,"surface":"徐道覆","kind":"person","person_id":"bt2_eqz_i4y","status":"contextual_provisional"}],"chapter_id":"c-songshu-049-kuaien","book_id":"b-songshu-049","work_id":"w-songshu","source_id":"s-songshu-049-kuaien-ws2118585"},{"id":"c-songshu-049-liuzhong:p003","text":"從征廣固。孟龍符陷沒，鍾率左右直入，取其尸而反。除振武將軍、中兵參軍，代龍符領廣川太守。盧循逼京邑，徐赤特軍違處分，敗于南岸，鍾率麾下距柵，身被重創，賊不得入。循南走，鍾與輔國將軍王仲德追之。循先留別帥范崇民以精兵高艦據南陵，夾屯兩岸。鍾自行覘賊，天霧，賊鉤得其舸，鍾因率左右攻艦戶，賊遽閉戶距之，鍾乃徐還。與仲德攻崇民，崇民敗走，鍾追討百里，燒其船乘。又隨劉藩追徐道覆於始興，斬之。補太尉行參軍、寧朔將軍、下邳太守。代孟懷玉領石頭戍事。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":32,"last_line":32,"raw_start":2200,"raw_end":2491,"raw_character_offsets":[2200,2201,2202,2203,2204,2205,2206,2207,2208,2209,2210,2211,2212,2213,2214,2215,2216,2217,2218,2219,2220,2221,2222,2223,2224,2225,2226,2227,2228,2229,2230,2231,2232,2233,2234,2235,2236,2237,2238,2239,2240,2241,2242,2243,2244,2245,2246,2247,2248,2249,2250,2251,2252,2253,2254,2255,2256,2257,2258,2259,2260,2261,2262,2263,2264,2265,2266,2267,2268,2269,2270,2271,2272,2273,2274,2275,2276,2277,2278,2279,2280,2281,2282,2283,2284,2285,2286,2287,2288,2289,2290,2291,2292,2293,2294,2295,2296,2297,2298,2299,2300,2301,2302,2303,2304,2305,2306,2307,2308,2309,2310,2311,2312,2313,2314,2315,2316,2317,2318,2319,2320,2321,2322,2323,2324,