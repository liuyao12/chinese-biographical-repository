4_xg5","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m006-0127","start":127,"end":128,"surface":"紂","kind":"person","person_id":"lwx_9yq_ad7","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m006-0149","start":149,"end":151,"surface":"比干","kind":"person","person_id":"xtq_oi8_w82","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m006-0154","start":154,"end":156,"surface":"箕子","kind":"person","person_id":"8a9_tj8_6i7","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m006-0172","start":172,"end":175,"surface":"師尚父","kind":"person","person_id":"1g3_02y_oor","status":"contextual_provisional"}],"chapter_id":"c-shiji-032-qi","book_id":"b-shiji-032","work_id":"w-shiji","source_id":"s-shiji-032-qi"},{"id":"c-shiji-038-song:p003","text":"王子比干者，亦紂之親戚也。見箕子諫不聽而爲奴，則曰：「君有過而不以死爭，則百姓何辜！」乃直言諫紂。紂怒曰：「吾聞聖人之心有七竅，信有諸乎？」乃遂殺王子比干，刳視其心。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-038-song:m003-0000","start":0,"end":4,"surface":"王子比干","kind":"person","person_id":"xtq_oi8_w82","status":"contextual_provisional"},{"id":"c-shiji-038-song:m003-0007","start":7,"end":8,"surface":"紂","kind":"person","person_id":"lwx_9yq_ad7","status":"contextual_provisional"},{"id":"c-shiji-038-song:m003-0014","start":14,"end":16,"surface":"箕子","kind":"person","person_id":"8a9_tj8_6i7","status":"contextual_provisional"},{"id":"c-shiji-038-song:m003-0027","start":27,"end":30,"surface":"君有過","kind":"unresolved","person_id":null,"status":"unresolved","note":"泛稱、政制、群體、神異、匿名者或未定指代；不補未見人名、闕代、制度爵等或成員。"},{"id":"c-shiji-038-song:m003-0037","start":37,"end":39,"surface":"百姓","kind":"unresolved","person_id":null,"status":"unresolved","note":"泛稱、政制、群體、神異、匿名者或未定指代；不補未見人名、闕代、制度爵等或成員。"},{"id":"c-shiji-038-song:m003-0047","start":47,"end":48,"surface":"紂","kind":"person","person_id":"lwx_9yq_ad7","status":"contextual_provisional"},{"id":"c-shiji-038-song:m003-0049","start":49,"end":50,"surface":"紂","kind":"person","person_id":"lwx_9yq_ad7","status":"contextual_provisional"},{"id":"c-shiji-038-song:m003-0073","start":73,"end":77,"surface":"王子比干","kind":"person","person_id":"xtq_oi8_w82","status":"contextual_provisional"}],"chapter_id":"c-shiji-038-song","book_id":"b-shiji-038","work_id":"w-shiji","source_id":"s-shiji-038-song"},{"id":"c-shiji-038-song:p059","text":"太史公曰：孔子稱「微子去之，箕子爲之奴，比干諫而死，殷有三仁焉」。春秋譏宋之亂自宣公廢太子而立弟，國以不寧者十世。襄公之時，修行仁義，欲爲盟主。其大夫正考父美之，故追道契、湯、髙宗，殷所以興，作商頌。襄公既敗於泓，而君子或以爲多，傷中國闕禮義，褒之也，宋襄之有禮讓也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-038-song:m059-0000","start":0,"end":3,"surface":"太史公","kind":"unresolved","person_id":null,"status":"unresolved","note":"泛稱、政制、群體、神異、匿名者或未定指代；不補未見人名、闕代、制度爵等或成員。"},{"id":"c-shiji-038-song:m059-0005","start":5,"end":7,"surface":"孔子","kind":"person","person_id":"fp6_ia6_7yw","status":"contextual_provisional"},{"id":"c-shiji-038-song:m059-0009","start":9,"end":11,"surface":"微子","kind":"person","person_id":"buv_igi_gpn_A","status":"contextual_provisional"},{"id":"c-shiji-038-song:m059-0014","start":14,"end":16,"surface":"箕子","kind":"person","person_id":"8a9_tj8_6i7","status":"contextual_provisional"},{"id":"c-shiji-038-song:m059-0020","start":20,"end":22,"surface":"比干","kind":"person","person_id":"xtq_oi8_w82","status":"contextual_provisional"},{"id":"c-shiji-038-song:m059-0028","start":28,"end":30,"surface":"三仁","kind":"unresolved","person_id":null,"status":"unresolved","note":"泛稱、政制、群體、神異、匿名者或未定指代；不補未見人名、闕代、制度爵等或成員。"},{"id":"c-shiji-038-song:m059-0040","start":40,"end":42,"surface":"宣公","kind":"person","person_id":"2v6_0g1_ve2_AAAAAAAAAB","status":"contextual_provisional"},{"id":"c-shiji-038-song:m059-0057","start":57,"end":59,"surface":"襄公","kind":"person","person_id":"l3c_zg4_f7z","status":"contextual_provisional"},{"id":"c-shiji-038-song:m059-0069","start":69,"end":71,"surface":"盟主","kind":"unresolved","person_id":null,"status":"unresolved","note":"泛稱、政制、群體、神異、匿名者或未定指代；不補未見人名、闕代、制度爵等或成員。"},{"id":"c-