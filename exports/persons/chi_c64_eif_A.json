pter_id":"c-sanguozhi-050-xu","book_id":"b-sanguozhi-050","work_id":"w-sanguozhi","source_id":"s-sanguozhi-050-xu"},{"id":"c-sanguozhi-050-xu:line026-pei02-01","text":"《江表傳》曰：初，袁術遣從弟胤為丹楊，策令琨討而代之。會景還，以景前在（仕）丹楊，寬仁得眾，吏民所思，而琨手下兵多，策嫌其太重，且方攻伐，宜得琨眾，乃復用景，召琨還吳。","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-050-xu:line026-pei02-01:m0009","start":9,"end":11,"surface":"袁術","kind":"person","person_id":"865_b69_cb0","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-xu:line026-pei02-01:m0014","start":14,"end":15,"surface":"胤","kind":"person","person_id":"1gw_2zv_6ot","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-xu:line026-pei02-01:m0019","start":19,"end":20,"surface":"策","kind":"person","person_id":"e9c_070_567","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-xu:line026-pei02-01:m0021","start":21,"end":22,"surface":"琨","kind":"person","person_id":"chi_c64_eif_A","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-xu:line026-pei02-01:m0028","start":28,"end":29,"surface":"景","kind":"person","person_id":"ere_ume_47r","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-xu:line026-pei02-01:m0032","start":32,"end":33,"surface":"景","kind":"person","person_id":"ere_ume_47r","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-xu:line026-pei02-01:m0052","start":52,"end":53,"surface":"琨","kind":"person","person_id":"chi_c64_eif_A","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-xu:line026-pei02-01:m0058","start":58,"end":59,"surface":"策","kind":"person","person_id":"e9c_070_567","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-xu:line026-pei02-01:m0071","start":71,"end":72,"surface":"琨","kind":"perso