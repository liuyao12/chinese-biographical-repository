":[],"life_events":[{"id":"le-shiji123-009","person_id":"0w0_eh2_loq","event_type":"death","status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-123-dayuan","source_id":"s-shiji123-dayuan","paragraph_id":"c-shiji-123-dayuan:p034","quote":"初，貳師起敦煌西，以為人多，道上國不能食，乃分為數軍，從南北道。校尉王申生、故鴻臚壺充國等千餘人，別到郁成。郁成城守，不肯給食其軍。王申生去大軍二百里，（偵）［偩］而輕之，責郁成。郁成食不肯出，窺知申生軍日少，晨用三千人攻，戮殺申生等，軍破，數人脫亡，走貳師。貳師令搜粟都尉上官桀往攻破郁成。郁成王亡走康居，桀追至康居。康居聞漢已破宛，乃出郁成王予桀，桀令四騎士縛守詣大將軍。四人相謂曰：「郁成王漢國所毒，今生將去，卒失大事。」欲殺，莫敢先擊。上邽騎士趙弟最少，拔劍擊之，斬郁成王，齎頭。弟、桀等逐及大將軍。","person_mention_id":"c-shiji-123-dayuan:m034-0034"}],"source_term":"戮殺申生等","interpretation_note":"原文明示個人死亡；相對年月未換算公元年，泛論與群體未另造個人事件。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"mentions":[{"id":"c-shiji-123-dayuan:m034-0034","start":34,"end":37,"surface":"王申生","kind":"person","person_id":"0w0_eh2_loq","status":"contextual_provisional","paragraph_id":"c-shiji-123-dayuan:p034","chapter_id":"c-shiji-123-dayuan"},{"id":"c-shiji-123-dayuan:m034-0066","start":66,"end":69,"surface":"王申生","kind":"person","person_id":"0w0_eh2_loq","status":"contextual_provisional","paragraph_id":"c-shiji-123-dayuan:p034","chapter_id":"c-shiji-123-dayuan"},{"id":"c-shiji-123-dayuan:m034-0099","start":99,"end":101,"surface":"申生","kind":"person","person_id":"0w0_eh2_loq","status":"contextual_provisional","paragraph_id":"c-shiji-123-dayuan:p034","chapter_id":"c-shiji-123-dayuan"},{"id":"c-shiji-123-dayuan:m034-0114","start":114,"end":116,"surface":"申生","kind":"person","person_id":"0w0_eh2_loq","status":"contextual_provisional","paragraph_id":"c-shiji-123-dayuan:p034","chapter_id":"c-shiji-123-dayuan"}],"relations":[],"title_holdings":[{"id":"th-shiji123-029","person_id":"0w0_eh2_loq","title":"校尉","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-123-dayuan","source_id":"s-shiji123-dayuan","paragraph_id":"c-shiji-123-dayuan:p034","quote":"初，貳師起敦煌西，以為人多，道上國不能食，乃分為數軍，從南北道。校尉王申生、故鴻臚壺充國等千餘人，別到郁成。郁成城守，不肯給食其軍。王申生去大軍二百里，（偵）［偩］而輕之，責郁成。郁成食不肯出，窺知申生軍日少，晨用三千人攻，戮殺申生等，軍破，數人脫亡，走貳師。貳師令搜粟都尉上官桀往攻破郁成。郁成王亡走康居，桀追至康居。康居聞漢已破宛，乃出郁成王予桀，桀令四騎士縛守詣大將軍。四人相謂曰：「郁成王漢國所毒，今生將去，卒失大事。」欲殺，莫敢先擊。上邽騎士趙弟最少，拔劍擊之，斬郁成王，齎頭。弟、桀等逐及大將軍。"}],"attestations":[{"id":"th-shiji123-029:a001","paragraph_id":"c-shiji-123-dayuan:p034","start":32,"end":34,"surface":"校尉","person_mention_id":"c-shiji-123-dayuan:m034-0034","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"原文授任、繼位與用稱分存；未知起訖保持未知，不因死亡自動終止。從驃侯等原稱不默改。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-123-dayuan:p034","text":"初，貳師起敦煌西，以為人多，道上國不能食，乃分為數軍，從南北道。校尉王申生、故鴻臚壺充國等千餘人，別到郁成。郁成城守，不肯給食其軍。王申生去大軍二百里，（偵）［偩］而輕之，責郁成。郁成食不肯出，窺知申生軍日少，晨用三千人攻，戮殺申生等，軍破，數人脫亡，走貳師。貳師令搜粟都尉上官桀往攻破郁成。郁成王亡走康居，桀追至康居。康居聞漢已破宛，乃出郁成王予桀，桀令四騎士縛守詣大將軍。四人相謂曰：「郁成王漢國所毒，今生將去，卒失大事。」欲殺，莫敢先擊。上邽騎士趙弟最少，拔劍擊之，斬郁成王，齎頭。弟、桀等逐及大將軍。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-123-dayuan:m034-0002","start":2,"end":4,"surface":"貳師","kind":"person","person_id":"pez_8dn_r76","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m034-0034","start":34,"end":37,"surface":"王申生","kind":"person","person_id":"0w0_eh2_loq","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m034-0041","start":41,"end":44,"surface":"壺充國","kind":"person","person_id":"jfb_bu6_k54","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m034-0066","start":66,"end":69,"surface":"王申生","kind":"person","person_id":"0w0_eh2_loq","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m034-0099","start":99,"end":101,"surface":"申生","kind":"person","person_id":"0w0_eh2_loq","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m034-0114","start