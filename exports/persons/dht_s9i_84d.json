69","surface":"馥","start":169,"end":170,"person_id":"oc0_z6e_st4","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-xie:p001:m0174","surface":"孫弼","start":174,"end":176,"person_id":"w6c_hkg_1ry","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-xie:p001:m0184","surface":"陶猷","start":184,"end":186,"person_id":"hni_1nz_att","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-xie:p001:m0189","surface":"元帝","start":189,"end":191,"person_id":"dkn_ge4_286_AAAAAAA","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-xie:p001:m0214","surface":"勰","start":214,"end":215,"person_id":"o1j_w2l_0gv","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-xie:p001:m0216","surface":"劄","start":216,"end":217,"person_id":"1a4_h3u_5rc","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-058-zhou-xie","book_id":"b-jinshu-058","work_id":"w-jinshu","source_id":"s-jinshu-058-zhou-xie-ws1775463"},{"id":"c-jinshu-071-chenyun:p004","text":"齊王冏起義，州遣頵將兵赴之，拜駙馬都尉。遭賊避難於江西。曆陽內史朱彥引為參軍。鎮東從事中郎袁琇薦頵於元帝，遷鎮東行參軍事，典法兵二曹。頵與王導書曰：「中華所以傾弊，四海所以土崩者，正以取才失所，先白望而後實事，浮競驅馳，互相貢薦，言重者先顯，言輕者後敘，遂相波扇，乃至陵遲。加有莊老之俗傾惑朝廷，養望者為弘雅，政事者為俗人，王職不恤，法物墜喪。夫欲制遠，先由近始。故出其言善，千里應之。今宜改張，明賞信罰，拔卓茂於密縣，顯硃邑於桐鄉，然後大業可舉，中興可冀耳。」","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":79,"last_line":79,"raw_start":6170,"raw_end":6401,"raw_character_offsets":[6170,6171,6172,6173,6174,6175,6176,6177,6178,6179,6180,6181,6182,6183,6184,6185,6186,6187,6188,6189,6190,6191,6192,6193,6194,6195,6196,6197,6198,6199,6200,6201,6202,6203,6204,6205,6206,6207,6208,6209,6210,6211,6212,6213,6214,6215,6216,6217,6218,6219,6220,6221,6222,6223,6224,6225,6226,6227,6228,6229,6230,6231,6232,6233,6234,6235,6236,6237,6238,6239,6240,6241,6242,6243,6244,6245,6246,6247,6248,6249,6250,6251,6252,6253,6254,6255,6256,6257,6258,6259,6260,6261,6262,6263,6264,6265,6266,6267,6268,6269,6270,6271,6272,6273,6274,6