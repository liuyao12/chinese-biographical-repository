,4938,4939,4940,4941,4942,4943,4944,4945,4946,4947,4948,4949],"projection_sha256":"7fb283cae99647883e7e4ee040c7ddde8e9972b6887c2b734bb92f620e5d017d"},"chapter_id":"c-liangshu-022-nanping-xiejiqing","book_id":"b-liangshu-022","work_id":"w-liangshu","source_id":"s-liangshu-022-nanping-ws1513347"},{"id":"c-liangshu-050-xiejiqing-family-intro-wyd:p003","text":"既長好學博涉有文采起家豫章王國常侍累遷車騎法曹行參軍相國祭酒出為寧國令入補尚書殿中郎太尉晉安王主簿天監初除征虜鄱陽王記室尚書三公侍郎尋為治書侍御史舊郎官轉為此職者世謂為南奔幾卿頗失志多陳疾臺事畧不復理徙為散騎侍郎累遷中書郎國子博士尚書左丞幾卿詳悉故實僕射徐勉每有疑滯多詢訪之然性通脫會意便行不拘朝憲嘗預樂遊苑宴不得醉而還因詣道邊酒壚停車褰幔與車前三騶對飲時觀者如堵幾卿處之自若後以在省署夜著犢鼻褌與門生登閣道飲酒酣嘑為有司糾奏坐免官尋起為國子博士俄除河東太守秩未滿陳疾解尋除太子率更令遷鎮衛南平王長史普通六年詔遣領軍將軍西昌侯蕭淵藻督衆軍北伐幾卿啓求行擢為軍師長史加威戎將軍軍至渦陽退敗幾卿坐免官","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-liangshu-050-xiejiqing-family-intro-wyd:p003:u0011","start":11,"end":14,"surface":"豫章王","person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"齊初任國常侍，未具王名、年月。"},{"id":"c-liangshu-050-xiejiqing-family-intro-wyd:p003:m0086","start":86,"end":88,"surface":"幾卿","person_id":"aa6_83c_juy_CDAABAB","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"},{"id":"c-liangshu-050-xiejiqing-family-intro-wyd:p003:m0119","start":119,"end":121,"surface":"幾卿","person_id":"aa6_83c_juy_CDAABAB","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"},{"id":"c-liangshu-050-xiejiqing-family-intro-wyd:p003:m0127","start":127,"end":129,"surface":"徐勉","person_id":"r9i_hp1_yo6","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"},{"id":"c-liangshu-050-xiejiqing-family-intro-wyd:p003:u0173","start":173,"end":175,"surface":"三騶","person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"車前三人，共飲，均未具名。"},{"id":"c-liangshu-050-xiejiqing-family-intro-wyd:p003:m0182","start":182,"end":184,"surface":"幾卿","person_id":"aa6_83c_juy_CDAABAB","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"},{"id":"c-liangshu-050-xiejiqing-family-intro-wyd:p003:u0199","start":199,"end":201,"surface":"門生","person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"同登閣道，姓名、數量未載。"},{"id":"c-liangshu-050-xiejiqing-family-intro-wyd:p003:m0263","start":263,"end":266,"surface":"蕭淵藻","person_id":"cfe_3jn_uof","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"},{"id":"c-liangshu-050-xiejiqing-family-intro-wyd:p003:m0271","start":271,"end":273,"surface":"幾卿","person_id":"aa6_83c_juy_CDAABAB","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"},{"id":"c-liangshu-050-xiejiqing-family-intro-wyd:p003:m0293","start":293,"end":295,"surface":"幾卿","person_id":"aa6_83c_juy_CDAABAB","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"}],"source_position":{"revision_id":"cbr-ai-transcription-sha256:fe27f7f79551ac89948ed19bb99252ef8e05cc5b72cd62907e1d87c4b78e3227","source_layer":"received_biography","column_projection":[{"pdf_page":58,"half":"右","leaf":"八下","column_from_right":4,"start":2,"end":21,"text":"既長好學博涉有文采起家豫章王國常侍累遷"},{"pdf_page":58,"half":"右","leaf":"八下","column_from_right":5,"start":0,"end":21,"text":"車騎法曹行參軍相國祭酒出為寧國令入補尚書殿"},{"pdf_page":58,"half":"右","leaf":"八下","column_from_right":6,"start":0,"end":21,"text":"中郎太尉晉安王主簿天監初除征虜鄱陽王記室尚"},{"pdf_page":58,"half":"右","leaf":"八下","column_from_right":7,"start":0,"end":21,"text":"書三公侍郎尋為治書侍御史舊郎官轉為此職者世"},{"pdf_page":58,"half":"右","leaf":"八下","column_from_right":8,"start":0,"end":21,"text":"謂為南奔幾卿頗失志多陳疾臺事畧不復理徙為散"},{"pdf_page":58,"half":"右","leaf":"八下","column_from_right":9,"start":0,"end":21,"text":"騎侍郎累遷中書郎國子博士尚書左丞幾卿詳悉故"},{"pdf_page":58,"half":"右","leaf":"八下","column_from_right":10,"start":0,"end":21,"text":"實僕射徐勉每有疑滯多詢訪之然性通脫會意便行"},{"pdf_page":58,"half":"左","leaf":"九上","column_from_right":1,"start":0,"end":21,"text":"不拘朝憲嘗預樂遊苑宴不得醉而還因詣道邊酒壚"},{"pdf_page":58,"half":"左","leaf":"九上","column_from_right":2,"start":0,"end":21,"text":"停車褰幔與車前三騶對飲時觀者如堵幾卿處之自"},{"pdf_page":58,"half":"左","leaf":"九上","column_from_right":3,"start":0,"end":21,"text":"若後以在省署夜著犢鼻褌與門生登閣道飲酒酣嘑"},{"pdf_page":58,"half":"左","leaf":"九上","column_from_right":4,"start":0,"end":21,"text":"為有司糾奏坐免官尋起為國子博士俄除河東太守"},{"pdf_page":58,"half":"左","leaf":"九上","column_from_right":5,"start":0,"end":21,"text":"秩未滿陳疾解尋除太子率更令遷鎮衛南平王長史"},{"pdf_page":58,"half":"左","leaf":"九上","column_from_right":6,"start":0,"end":21,"text":"普通六年詔遣領軍將軍西昌侯蕭淵藻督衆軍北伐"},{"pdf_page":58,"half":"左","leaf":"九上","column_from_right":7,"start":0,"end":21,"text":"幾卿啓求行擢為軍師長史加威戎將軍軍至渦陽退"},{"pdf_page":58,"half":"左","leaf":"九上","column_from_right":8,"start":0,"end":6,"text":"敗幾卿坐免官"}]},"chapter_id":"c-liangshu-050-xiejiqing-family-intro-wyd","book_id":"b-liangshu-050","work_id":"w-liangshu","source_id":"s-liangshu-050-jiqing-wyd1739"},{"id":"c-liangshu-050-xiejiqing-family-intro:p003","text":"旣長好學，博涉有文采。起家豫章王國常侍，累遷車騎法曹行參軍、相國祭酒。出爲寧國令，入補尚書殿中郎、太尉晉安王主簿。天監初，除征虜鄱陽王記室、尚書三公侍郎，尋爲治書侍御史。舊郎官轉爲此職者，世謂爲南奔。幾卿頗失志，多陳疾，臺事略不復理。徙爲散騎侍郎，累遷中書郎、國子博士、尚書左丞。幾卿詳悉故實，僕射徐勉每有疑滯，多詢訪之。然性通脫，會意便行，不拘朝憲。嘗預樂游苑宴，不得醉而還，因詣道邊酒壚，停車褰幔，與車前三騶對飲，時觀者如堵，幾卿處之自若。後以在省署，夜著犢鼻褌，與門生登閣道飲酒酣嘑，爲有司糾奏，坐免官。尋起爲國子博士，俄除河東太守，秩未滿，陳疾解。尋除太子率更令，遷鎮衛南平王長史。普通六年，詔遣領軍將軍西昌侯蕭淵藻督衆軍北伐，幾卿啓求行，擢爲軍師長史，加威戎將軍。軍至渦陽退敗，幾卿坐免官。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-liangshu-050-xiejiqing-family-intro:p003:u0013","start":13,"end":16,"surface":"豫章王","person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"齊初任國常侍，未具王名、年月。"},{"id":"c-liangshu-050-xiejiqing-family-intro:p003:m0100","start":100,"end":102,"surface":"幾卿","person_id":"aa6_83c_juy_CDAABAB","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"},{"id":"c-liangshu-050-xiejiqing-family-intro:p003:m0140","start":140,"end":142,"surface":"幾卿","person_id":"aa6_83c_juy_CDAABAB","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"},{"id":"c-liangshu-050-xiejiqing-family-intro:p003:m0149","start":149,"end":151,"surface":"徐勉","person_id":"r9i_hp1_yo6","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"},{"id":"c-liangshu-050-xiejiqing-family-intro:p003:u0204","start":204,"end":206,"surface":"三騶","person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"車前三人，共飲，均未具名。"},{"id":"c-liangshu-050-xiejiqing-family-intro:p003:m0215","start":215,"end":217,"surface":"幾卿","person_id":"aa6_83c_juy_CDAABAB","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"},{"id":"c-liangshu-050-xiejiqing-family-intro:p003:u0235","start":235,"end":237,"surface":"門生","person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"同登閣道，姓名、數量未載。"},{"id":"c-liangshu-050-xiejiqing-family-intro:p003:m0309","start":309,"end":312,"surface":"蕭淵藻","person_id":"cfe_3jn_uof","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"},{"id":"c-liangshu-050-xiejiqing-family-intro:p003:m0318","start":318,"end":320,"surface":"幾卿","person_id":"aa6_83c_juy_CDAABAB","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"},{"id":"c-liangshu-050-xiejiqing-family-intro:p003:m0344","start":344,"end":346,"surface":"幾卿","person_id":"aa6_83c_juy_CDAABAB","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"}],"source_position":{"first_line":45,"last_line":45,"revision_id":1514482,"source_layer":"received_biography","raw_start":3989,"raw_end":4339,"raw_character_offsets":[3989,3990,3991,3992,3993,3994,3995,3996,3997,3998,3999,4000,4001,4002,4003,4004,4005,4006,4007,4008,4009,4010,4011,4012,4013,4014,4015,4016,4017,4018,4019,4020,4021,4022,4023,4024,4025,4026,4027,4028,4029,4030,4031,4032,4033,4034,4035,4036,4037,4038,4039,4040,4041,4042,4043,4044,4045,4046,4047,4048,4049,4050,4051,4052,4053,4054,4055,4056,4057,4058,4059,4060,4061,4062,4063,4064,4065,4066,4067,406