chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m006-0107","start":107,"end":109,"surface":"趙堯","kind":"person","person_id":"cbr-p005393","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p006","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m006-0133","start":133,"end":135,"surface":"趙堯","kind":"person","person_id":"cbr-p005393","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p006","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m006-0198","start":198,"end":199,"surface":"堯","kind":"person","person_id":"cbr-p005393","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p006","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m006-0253","start":253,"end":254,"surface":"堯","kind":"person","person_id":"cbr-p005393","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p006","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m007-0032","start":32,"end":34,"surface":"趙堯","kind":"person","person_id":"cbr-p005393","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p007","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m007-0041","start":41,"end":42,"surface":"堯","kind":"person","person_id":"cbr-p005393","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p007","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m007-0046","start":46,"end":48,"surface":"趙堯","kind":"person","person_id":"cbr-p005393","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p007","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m007-0054","start":54,"end":55,"surface":"堯","kind":"person","person_id":"cbr-p005393","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p007","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m009-0014","start":14,"end":16,"surface":"趙堯","kind":"person","person_id":"cbr-p005393","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p009","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m009-0029","start":29,"end":30,"surface":"堯","kind":"person","person_id":"cbr-p005393","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p009","chapter_id":"c-shiji-096-zhang"}],"relations":[],"title_holdings":[{"id":"th-shiji096-020","person_id":"cbr-p005393","title":"符璽御史","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-096-zhang","source_id":"s-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p006","quote":"是後戚姬子如意為趙王，年十歲，高祖憂即萬歲之後不全也。趙堯年少，為符璽御史。趙人方與公謂御史大夫周昌曰：「君之史趙堯，年雖少，然奇才也，君必異之，是且代君之位。」周昌笑曰；「堯年少，刀筆吏耳，何能至是乎！」居頃之，趙堯侍高祖。高祖獨心不樂，悲歌，群臣不知上之所以然。趙堯進請問曰：「陛下所為不樂，非為趙王年少而戚夫人與呂后有卻邪？備萬歲之後而趙王不能自全乎？」高祖曰：「然。吾私憂之，不知所出。」堯曰：「陛下獨宜為趙王置貴彊相，及呂后、太子、群臣素所敬憚乃可。」高祖曰：「然。吾念之欲如是，而群臣誰可者？」堯曰：「御史大夫周昌，其人堅忍質直，且自呂后、太子及大臣皆素敬憚之。獨昌可。」高祖曰：「善。」於是乃召周昌，謂曰：「吾欲固煩公，公彊為我相趙王。」周昌泣曰：「臣初起從陛下，陛下獨柰何中道而棄之於諸侯乎？」高祖曰：「吾極知其左遷，然吾私憂趙王，念非公無可者。公不得已彊行！」於是徙御史大夫周昌為趙相。"}],"attestations":[{"id":"th-shiji096-020:a001","paragraph_id":"c-shiji-096-zhang:p006","start":33,"end":37,"surface":"符璽御史","person_mention_id":"c-shiji-096-zhang:m006-0027","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"原文實授、轉任、用稱與諡稱分存；未明示時任期起訖未知。欲任竇廣國及欲令周苛將皆不作實授；死亡或首次用稱不自動作任期端點。十四年、四年、二年等先保留原語，不擅定年號或西曆。曹窋免職段含（不）異文，未先強定其終點。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji096-022","person_id":"cbr-p005393","title":"御史大夫","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-096-zhang","source_id":"s-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p007","quote":"既行久之，高祖持御史大夫印弄之，曰：「誰可以為御史大夫者？」孰視趙堯，曰：「無以易堯。」遂拜趙堯為御史大夫。堯亦前有軍功食邑，及以御史大夫從擊陳豨有功，封為江邑侯。"}],"attestations":[{"id":"th-shiji096-022:a001","paragraph_id":"c-shiji-096-zhang:p007","start":49,"end":53,"surface":"御史大夫","person_mention_id":"c-shiji-096-zhang:m007-0046","usage":"narrative"}],"effective_period":{"start