wed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-w098-fangtou-zhu","person_id":"rzi_blt_mvz","event_type":"death","source_term":"硃輔送於京都而斬之","date_expression":null,"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-098","chapter_id":"c-jinshu-098-huanwen","source_id":"s-jinshu-098-ws2614273","paragraph_id":"c-jinshu-098-huanwen:p023","quote":"袁真病死，其將朱輔立其子瑾以嗣事。慕容暐、苻堅並遣軍授瑾，溫使督護竺瑤、矯陽之等與水軍擊之。時暐軍已至，瑤等與戰于武丘，破之。溫率二萬人自廣陵又至，瑾嬰城固守，溫築長圍守之。苻堅乃使其將王鑒、張蠔等率兵以救瑾，屯洛澗，先遣精騎五千次於肥水北。溫遣桓伊及弟子石虔等逆擊，大破之，瑾眾遂潰，生擒之，並其宗族數十人及硃輔送於京都而斬之，所侍養乞活數百人悉坑之，以妻子為賞。溫以功，詔加班劍十人，犒軍于路次，文武論功賞賜各有差。","person_mention_id":"c-jinshu-098-huanwen:p023:m0007"}],"interpretation_note":"依本來源登記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-jinshu-008-jin098-huanwen-fangtou:370:m0013","start":13,"end":15,"surface":"朱輔","kind":"person","person_id":"rzi_blt_mvz","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-008-jin098-huanwen-fangtou:370","chapter_id":"c-jinshu-008-jin098-huanwen-fangtou"},{"id":"c-jinshu-098-huanwen:p023:m0007","start":7,"end":9,"surface":"朱輔","kind":"person","person_id":"rzi_blt_mvz","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。","paragraph_id":"c-jinshu-098-huanwen:p023","chapter_id":"c-jinshu-098-huanwen"},{"id":"c-jinshu-098-huanwen:p023:m0155","start":155,"end":157,"surface":"硃輔","kind":"person","person_id":"rzi_blt_mvz","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。","paragraph_id":"c-jinshu-098-huanwen:p023","chapter_id":"c-jinshu-098-huanwen"},{"id":"c-zizhitongjian-102-jin098-huanwen-fangtou:yuan:m0014","start":14,"end":16,"surface":"朱輔","kind":"person","person_id":"rzi_blt_mvz","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-zizhitongjian-102-jin098-huanwen-fangtou:yuan","chapter_id":"c-zizhitongjian-102-jin098-huanwen-fan