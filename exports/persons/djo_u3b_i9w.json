":"source-evidence/jin008077/jin077-yinhao-projection.json","unit_key":"p001","first_line":116,"last_line":117,"revision_id":"8750392","editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-077-yinhao","book_id":"b-jinshu-077","work_id":"w-jinshu","source_id":"s-jinshu-077-yinhao"},{"id":"c-jinshu-077-yinhao:p005","text":"時桓溫既滅蜀，威勢轉振，朝廷憚之。簡文以浩有盛名，朝野推伏，故引為心膂，以抗于溫，於是與溫頗相疑貳。會遭父憂，去職，時以蔡謨攝揚州，以俟浩，服闋，徵為尚書僕射，不拜。復為建武將軍、揚州刺史，遂參綜朝權。潁川荀羨少有令聞，浩擢為義興、吳郡，以為羽翼。王羲之密說浩、羨，令與桓溫和同，不宜內構嫌隙，浩不從。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-jinshu-077-yinhao:p005:m0001","start":1,"end":3,"surface":"桓溫","kind":"person","person_id":"u9s_w6j_8mc_AA","status":"contextual_provisional","interpretation_note":"依完整敘事／引語主語逐段辨識；原字不校改。"},{"id":"c-jinshu-077-yinhao:p005:m0015","start":15,"end":16,"surface":"之","kind":"person","person_id":"u9s_w6j_8mc_AA","status":"contextual_provisional","interpretation_note":"依完整敘事／引語主語逐段辨識；原字不校改。"},{"id":"c-jinshu-077-yinhao:p005:m0017","start":17,"end":19,"surface":"簡文","kind":"person","person_id":"dkn_ge4_286_AAAAAAAF","status":"contextual_provisional","interpretation_note":"依完整敘事／引語主語逐段辨識；原字不校改。"},{"id":"c-jinshu-077-yinhao:p005:m0020","start":20,"end":21,"surface":"浩","kind":"person","person_id":"djo_u3b_i9w_A","status":"contextual_provisional","interpretation_note":"依完整敘事／引語主語逐段辨識；原字不校改。"},{"id":"c-jinshu-077-yinhao:p005:m0039","start":39,"end":40,"surface":"溫","kind":"person","person_id":"u9s_w6j_8mc_AA","status":"contextual_provisional","interpretation_note":"依完整敘事／引語主語逐段辨識；原字不校改。"},{"id":"c-jinshu-077-yinhao:p005:m0044","start":44,"end":45,"surface":"溫","kind":"person","person_id":"u9s_w6j_8mc_AA","status":"contextual_provisional","interpretation_note":"依完整敘事／引語主語逐段辨識；原字不校改。"},{"id":"c-jinshu-077-yinhao:p005:m0052","start":52,"end":53,"surface":"父","kind":"person","person_id":"djo_u3b_i9w","status":"contextual_provisional","interpretation_note":"依完整敘事／引語主語逐段辨識；原字不校改。"},{"id":"c-jinshu-077-yinhao:p005:m0060","start":