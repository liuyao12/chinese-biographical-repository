{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004591","identity_policy":"contextual_provisional","person_ids":["cbr-p004591"],"persons":[{"id":"cbr-p004591","label":"老子引古（樂毅列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"老子","mention_ids":["c-shiji-080-leyi:m019-0090","c-shiji-080-leyi:m020-0039"]}],"evidence":[{"mention_id":"c-shiji-080-leyi:m019-0090","chapter_id":"c-shiji-080-leyi","paragraph_id":"c-shiji-080-leyi:p019","quote":"老子"},{"mention_id":"c-shiji-080-leyi:m020-0039","chapter_id":"c-shiji-080-leyi","paragraph_id":"c-shiji-080-leyi:p020","quote":"老子"}]}],"mentions":[{"id":"c-shiji-080-leyi:m019-0090","start":90,"end":92,"surface":"老子","kind":"person","person_id":"cbr-p004591","status":"contextual_provisional","paragraph_id":"c-shiji-080-leyi:p019","chapter_id":"c-shiji-080-leyi"},{"id":"c-shiji-080-leyi:m020-0039","start":39,"end":41,"surface":"老子","kind":"person","person_id":"cbr-p004591","status":"contextual_provisional","paragraph_id":"c-shiji-080-leyi:p020","chapter_id":"c-shiji-080-leyi"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji080-037","person_id":"cbr-p004591","scope":"same_chapter","chapter_ids":["c-shiji-080-leyi"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["老子"],"evidence":[{"paragraph_id":"c-shiji-080-leyi:p019","quote":"其後二十餘年，高帝過趙，問：「樂毅有後世乎？」對曰：「有樂叔。」高帝封之樂卿，號曰華成君。華成君，樂毅之孫也。而樂氏之族有樂瑕公、樂臣公，趙且為秦所滅，亡之齊高密。樂臣公善修黃帝、老子之言，顯聞於齊，稱賢師。"},{"paragraph_id":"c-shiji-080-leyi:p020","quote":"太史公曰：始齊之蒯通及主父偃讀樂毅之報燕王書，未嘗不廢書而泣也。樂臣公學黃帝、老子，其本師號曰河上丈人，不知其所出。河上丈人教安期生，安期生教毛翕公，毛翕公教樂瑕公，樂瑕公教樂臣公，樂臣公教蓋公。蓋公教於齊高密、膠西，為曹相國師。"}],"rationale":"樂閒明示為樂毅子，樂叔明示為孫，不補闕代父親；樂乘為樂閒宗不補兄弟。燕王喜來書及趙襄王君序各限本段，曹相國未見名字不回填。河上丈人至蓋公師承不作父子。依本篇明示姓名、君序與來書答書範圍暫接；燕惠王來書寡人指惠王、將軍指樂毅，樂毅答書先王指昭王、足下君王指惠王。伍子胥引古首吳王指闔閭，後吳王在夫差賜鴟夷後指夫差。父兄與群臣不補具體親屬，王齊為反間假說不作授王爵。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-080-leyi:p019","text":"其後二十餘年，高帝過趙，問：「樂毅有後世乎？」對曰：「有樂叔。」高帝封之樂卿，號曰華成君。華成君，樂毅之孫也。而樂氏之族有樂瑕公、樂臣公，趙且為秦所滅，亡之齊高密。樂臣公善修黃帝、老子之言，顯聞於齊，稱賢師。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-080-leyi:m019-0007","start":7,"end":9,"surface":"高帝","kind":"person","person_id":"cbr-p004586","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m019-0015","start":15,"end":17,"surface":"樂毅","kind":"person","person_id":"cbr-p004555","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m019-0018","start":18,"end":20,"surface":"後世","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未定後裔保留，不補未見姓名或直接父親。"},{"id":"c-shiji-080-leyi:m019-0028","start":28,"end":30,"surface":"樂叔","kind":"person","person_id":"cbr-p004587","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m019-0032","start":32,"end":34,"surface":"高帝","kind":"person","person_id":"cbr-p004586","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m019-0041","start":41,"end":44,"surface":"華成君","kind":"person","person_id":"cbr-p004587","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m019-0045","start":45,"end":48,"surface":"華成君","kind":"person","person_id":"cbr-p004587","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m019-0049","start":49,"end":51,"surface":"樂毅","kind":"person","person_id":"cbr-p004555","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m019-0056","start":56,"end":60,"surface":"樂氏之族","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未定後裔保留，不補未見姓名或直接父親。"},{"id":"c-shiji-080-leyi:m019-0061","start":61,"end":64,"surface":"樂瑕公","kind":"person","person_id":"cbr-p004588","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m019-0065","start":65,"end":68,"surface":"樂臣公","kind":"person","person_id":"cbr-p004589","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m019-0082","start":82,"end":85,"surface":"樂臣公","kind":"person","person_id":"cbr-p004589","statu