emain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-051-jingyan:m001-0042","start":42,"end":44,"surface":"項籍","kind":"person","person_id":"3sg_fes_hit","status":"contextual_provisional","paragraph_id":"c-shiji-051-jingyan:p001","chapter_id":"c-shiji-051-jingyan"},{"id":"c-shiji-051-jingyan:m002-0065","start":65,"end":67,"surface":"項王","kind":"person","person_id":"3sg_fes_hit","status":"contextual_provisional","paragraph_id":"c-shiji-051-jingyan:p002","chapter_id":"c-shiji-051-jingyan"},{"id":"c-shiji-051-jingyan:m003-0007","start":7,"end":9,"surface":"項籍","kind":"person","person_id":"3sg_fes_hit","status":"contextual_provisional","paragraph_id":"c-shiji-051-jingyan:p003","chapter_id":"c-shiji-051-jingyan"},{"id":"c-shiji-051-jingyan:m003-0063","start":63,"end":65,"surface":"項籍","kind":"person","person_id":"3sg_fes_hit","status":"contextual_provisional","paragraph_id":"c-shiji-051-jingyan:p003","chapter_id":"c-shiji-051-jingyan"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji051-012","person_id":"3sg_fes_hit","surfaces":["項王","項籍"],"scope":"same_chapter","chapter_ids":["c-shiji-051-jingyan"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-051-jingyan:p001","quote":"荊王劉賈者，諸劉，不知其何屬。初起時，漢王元年，還定三秦，劉賈為將軍，定塞地，從東擊項籍。"},{"paragraph_id":"c-shiji-051-jingyan:p002","quote":"漢四年，漢王之敗成皋，北渡河，得張耳、韓信軍，軍修武，深溝高壘，使劉賈將二萬人，騎數百，渡白馬津入楚地，燒其積聚，以破其業，無以給項王軍食。已而楚兵擊劉賈，賈輒壁不肯與戰，而與彭越相保。"},{"paragraph_id":"c-shiji-051-jingyan:p003","quote":"漢五年，漢王追項籍至固陵，使劉賈南渡淮圍壽春。還至，使人閒招楚大司馬周殷。周殷反楚，佐劉賈舉九江，迎武王黥布兵，皆會垓下，共擊項籍。漢王因使劉賈將九江兵，與太尉盧綰西南擊臨江王共尉。共尉已死，以臨江為南郡。"}],"rationale":"明示名與局部授封、游說角色暫接；劉賈劉澤分開，諸劉疏屬不補支系，田生子不改父名，定國案保存來源敘事不冒稱獨立核定。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-051-jingyan:p001","text":"荊王劉賈者，諸劉，不知其何屬。初起時，漢王元年，還定三秦，劉賈為將軍，定塞地，從東擊項籍。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-051-jingyan:m001-0000","start":0,"end":4,"surface":"荊王劉賈","kind":"person","person_id":"w6d_z7t_geq","status":"contextual_provisional"},{"id":"c-shiji-051-jingyan:m001-0006","start":6,"end":8,"surface":"諸劉","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名家屬、條件稱號或未定指代，不補成員姓名及支系。"},{"id":"c-shiji-051-jingyan:m001-0019","start":19,"end":21,"surface":"漢王","kind":"person","person_id":"1j8_2zh_zqz","status":"contextual_provisional"},{"id":"c-shiji-051-jingyan:m001-0029","start":29,"end":31,"surface":"劉賈","kind":"person","person_id":"w6d_z7t_geq","status":"contextual_provisional"},{"id":"c-shiji-051-jingyan:m001-0042","start":42,"end":44,"surface":"項籍","kind":"person","person_id":"3sg_fes_hit","status":"contextual_provisional"}],"chapter_id":"c-shiji-051-jingyan","book_id":"b-shiji-051","work_id":"w-shiji","source_id":"s-shiji-051-jingyan"},{"id":"c-shiji-051-jingyan:p002","text":"漢四年，漢王之敗成皋，北渡河，得張耳、韓信軍，軍修武，深溝高壘，使劉賈將二萬人，騎數百，渡白馬津入楚地，燒其積聚，以破其業，無以給項王軍食。已而楚兵擊劉賈，賈輒壁不肯與戰，而與彭越相保。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-051-jingyan:m002-0004","start":4,"end":6,"surface":"漢王","kind":"person","person_id":"1j8_2zh_zqz","status":"contextual_provisional"},{"id":"c-shiji-051-jingyan:m002-0016","start":16,"end":18,"surface":"張耳","kind":"person","person_id":"i8m_w3r_o5f","status":"contextual_provisional"},{"id":"c-shiji-051-jingyan:m002-0019","start":19,"end":21,"surface":"韓信","kind":"person","person_id":"ubx_l5x_nk3","status":"contextual_provisional"},{"id":"c-shiji-051-jingyan:m002-0033","start":33,"end":35,"surface":"劉賈","kind":"person","person_id":"w6d_z7t_geq","status":"contextual_provisional"},{"id":"c-shiji-051-jingyan:m002-0065","start":65,"end":67,"surface":"項王","kind":"person","person_id":"3sg_fes_hit","status":"contextual_provisional"},{"id":"c-shiji-051-jingyan:m002-0075","start":75,"end":77,"surface":"劉賈","kind":"pe