-052-gucheng-complete:line062:m0028","start":28,"end":30,"surface":"子直","kind":"person","person_id":"syc_ik6_bq5_**AAB","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-gucheng-complete:line062:m0072","start":72,"end":75,"surface":"諸葛恪","kind":"person","person_id":"512_1cd_a4b","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-gucheng-complete:line062:m0129","start":129,"end":130,"surface":"譚","kind":"person","person_id":"syc_ik6_bq5_**AAA","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-gucheng-complete:line062:m0131","start":131,"end":133,"surface":"張休","kind":"person","person_id":"roi_rz4_ute_A","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"source_position":{"first_line":62,"last_line":62,"revision_id":2085149,"raw_start":8065,"raw_end":8216,"character_positions":[8067,8068,8069,8070,8071,8072,8073,8074,8075,8076,8077,8078,8079,8080,8081,8084,8087,8088,8089,8090,8091,8092,8093,8094,8095,8096,8097,8098,8099,8100,8101,8102,8103,8104,8105,8106,8107,8108,8109,8110,8111,8112,8113,8114,8115,8116,8117,8118,8119,8120,8121,8122,8123,8124,8125,8126,8127,8128,8129,8130,8131,8132,8133,8134,8135,8136,8137,8138,8139,8140,8141,8142,8143,8144,8145,8146,8147,8148,8149,8150,8151,8152,8153,8154,8155,8156,8157,8158,8159,8160,8161,8162,8163,8164,8165,8166,8167,8168,8169,8170,8171,8172,8173,8174,8175,8176,8177,8178,8179,8180,8181,8182,8183,8184,8185,8186,8187,8188,8189,8190,8191,8192,8193,8194,8195,8196,8197,8198,8199,8200,8201,8202,8203,8204,8205,8206,8207,8208,8209,8210,8211,8212,8213,8214,8215]},"chapter_id":"c-sanguozhi-052-gucheng-complete","book_id":"b-sanguozhi-052","work_id":"w-sanguozhi","source_id":"s-sanguozhi-052-gucheng-complete"},{"id":"c-sanguozhi-052-gutan-complete:line052","text":"譚字子默，弱冠與諸葛恪等爲太子四友，從中庶子轉輔正都尉。赤烏中，代恪爲左節度。每省簿書，未嘗下籌，徒屈指心計，盡發疑謬，下吏以此服之。加奉車都尉。薛綜爲選曹尚書，固讓譚曰：「譚心精體密，貫道達微，才照人物，德允眾望，誠非愚臣所可越先。」後遂代綜。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-sanguozhi-052-gutan-complete:line052:m0000","start":0,"end":1,"surface":"譚","kind":"person","person_id":"syc_ik6_bq5_**AAA","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-gutan-complete:line052:m0002","start":2,"end":4,"surface":"子默","kind":"person","person_id":"syc_ik6_bq5_**AAA","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-gutan-complete:line052:m0008","start":8,"end":11,"surface":"諸葛恪","kind":"person","person_id":"512_1cd_a4b","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-gutan-complete:line052:m0013","start":13,"end":15,"surface":"太子","kind":"person","person_id":"572_278_cba_C","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-gutan-complete:line052:m0033","start":33,"end":34,"surface":"恪","kind":"person","person_id":"512_1cd_a4b","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-gutan-complete:line052:m0073","start":73,"end":75,"surface":"薛綜","kind":"person","person_id":"yt7_qwp_k7p","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-gutan-complete:line052:m0083","start":83,"end":84,"surface":"譚","kind":"person","person_id":"syc_ik6_bq5_**AAA","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-gutan-complete:line052:m0087","start":87,"end":88,"surface":"譚","kind":"person","person_id":"syc_ik6_bq5_**AAA","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-gutan-complete:line052:m0121","start":121,"end":122,"surface":"綜","kind":"person","person_id":"yt7_qwp_k7p","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"source_position":{"first_line":52,"last_line":52,"revision_id":2085149,"raw_start":7138,"raw_end":7433,"character_positions":[7140,7141,714