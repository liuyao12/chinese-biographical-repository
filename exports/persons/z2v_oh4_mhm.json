:143,"end":144,"surface":"恢","kind":"person","person_id":"z2v_oh4_mhm","status":"contextual_provisional"},{"id":"c-shiji-108-han:m010-0154","start":154,"end":155,"surface":"上","kind":"person","person_id":"zgv_3zp_3tg","status":"contextual_provisional"},{"id":"c-shiji-108-han:m010-0156","start":156,"end":158,"surface":"太后","kind":"person","person_id":"a9j_o55_q8g","status":"contextual_provisional"},{"id":"c-shiji-108-han:m010-0159","start":159,"end":161,"surface":"太后","kind":"person","person_id":"a9j_o55_q8g","status":"contextual_provisional"},{"id":"c-shiji-108-han:m010-0166","start":166,"end":167,"surface":"上","kind":"person","person_id":"zgv_3zp_3tg","status":"contextual_provisional"},{"id":"c-shiji-108-han:m010-0168","start":168,"end":169,"surface":"上","kind":"person","person_id":"zgv_3zp_3tg","status":"contextual_provisional"},{"id":"c-shiji-108-han:m010-0179","start":179,"end":180,"surface":"恢","kind":"person","person_id":"z2v_oh4_mhm","status":"contextual_provisional"},{"id":"c-shiji-108-han:m010-0200","start":200,"end":202,"surface":"單于","kind":"person","person_id":"hn9_gz8_uyk","status":"contextual_provisional"},{"id":"c-shiji-108-han:m010-0206","start":206,"end":207,"surface":"恢","kind":"person","person_id":"z2v_oh4_mhm","status":"contextual_provisional"},{"id":"c-shiji-108-han:m010-0229","start":229,"end":230,"surface":"恢","kind":"person","person_id":"z2v_oh4_mhm","status":"contextual_provisional"},{"id":"c-shiji-108-han:m010-0240","start":240,"end":241,"surface":"恢","kind":"person","person_id":"z2v_oh4_mhm","status":"contextual_provisional"}],"chapter_id":"c-shiji-108-han","book_id":"b-shiji-108","work_id":"w-shiji","source_id":"s-shiji-108-han"},{"id":"c-shiji-110-xiongnu:p030","text":"漢使馬邑下人聶翁壹奸蘭出物與匈奴交，詳爲賣馬邑城以誘單于。單于信之，而貪馬邑財物，乃以十萬騎入武州塞。漢伏兵三十餘萬馬邑旁，御史大夫韓安國爲護軍，護四將軍以伏單于。單于既入漢塞，未至馬邑百餘里，見畜布野而無人牧者，怪之，乃攻亭。是時鴈門尉史行徼，見寇，葆此亭，知漢兵謀，單于得，欲殺之，尉史乃告單于漢兵所居。單于大驚曰：「吾固疑之。」乃引兵還。出曰：「吾得尉史，天也，天使若言。」以尉史爲「天王」。漢兵約單于入馬邑而縱，單于不至，以故漢兵無所得。漢將軍王恢部出代擊胡輜重，聞單于還，兵多，不敢出。漢以恢本造兵謀而不進，斬恢。自是之後，匈奴絕和親，攻當路塞，往往入盜於漢邊，不可勝數。然匈奴貪，尚樂關市，嗜漢財物，漢亦尚關市不絕以中之。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-110-xiongnu:m030-0006","start":6,"end":9,"surface":"聶翁壹","kind":"person","person_id":"88n_whb_ht0","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m030-0026","start":26,"end":28,"surface":"單于","kind":"person","person_id":"b0u_k4p_a3y","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m030-0029","start":29,"end":31,"surface":"單于","kind":"person","person_id":"b0u_k4p_a3y","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m030-0066","start":66,"end":69,"surface":"韓安國","kind":"person","person_id":"zwl_mxs_t2o","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m030-0074","start":74,"end":77,"surface":"四將軍","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-110-xiongnu:m030-0079","start":79,"end":81,"surface":"單于","kind":"person","person_id":"b0u_k4p_a3y","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m030-0082","start":82,"end":84,"surface":"單于","kind":"person","person_id":"b0u_k4p_a3y","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m030-0116","start":116,"end":120,"surface":"鴈門尉史","kind":"person","person_id":"xlo_zpy_reo","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m030-0135","start":135,"end":137,"surface":"單于","kind":"person","person_id":"b0u_k4p_a3y","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m030-0143","start":143,"end":145,"surface":"尉史","kind":"person","person_id":"xlo_zpy_reo","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m030-0147","start":147,"end":149,"surface":"單于","kind":"person","person_id":"b0u_k4p_a3y","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m030-0154","start":154,"end":156,"surface":"單于","kind":"person","person_id":"b0u_k4p_a3y","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m030-0178","start":178,"end":180,"surface":"尉史","kind