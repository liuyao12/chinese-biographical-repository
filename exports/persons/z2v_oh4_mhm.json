{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"z2v_oh4_mhm","canonical_person_id":"z2v_oh4_mhm","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["z2v_oh4_mhm"],"persons":[{"id":"z2v_oh4_mhm","label":"王恢（韓長孺列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"王恢","mention_ids":["c-shiji-108-han:m006-0072","c-shiji-108-han:m007-0014","c-shiji-108-han:m008-0021"]}],"evidence":[{"mention_id":"c-shiji-108-han:m006-0072","chapter_id":"c-shiji-108-han","paragraph_id":"c-shiji-108-han:p006","quote":"王恢"},{"mention_id":"c-shiji-108-han:m007-0014","chapter_id":"c-shiji-108-han","paragraph_id":"c-shiji-108-han:p007","quote":"王恢"},{"mention_id":"c-shiji-108-han:m008-0021","chapter_id":"c-shiji-108-han","paragraph_id":"c-shiji-108-han:p008","quote":"王恢"}]}],"source_mention_summary":[{"source_id":"s-shiji-108-han","work_id":"w-shiji","book_id":"b-shiji-108","chapter_id":"c-shiji-108-han","mention_count":3,"mention_ids":["c-shiji-108-han:m006-0072","c-shiji-108-han:m007-0014","c-shiji-108-han:m008-0021"],"paragraph_ids":["c-shiji-108-han:p006","c-shiji-108-han:p007","c-shiji-108-han:p008"],"passage_count":3}],"most_mentioned_source_ids":["s-shiji-108-han"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-108-han:m006-0072","start":72,"end":74,"surface":"王恢","kind":"person","person_id":"z2v_oh4_mhm","status":"contextual_provisional","paragraph_id":"c-shiji-108-han:p006","chapter_id":"c-shiji-108-han"},{"id":"c-shiji-108-han:m007-0014","start":14,"end":16,"surface":"王恢","kind":"person","person_id":"z2v_oh4_mhm","status":"contextual_provisional","paragraph_id":"c-shiji-108-han:p007","chapter_id":"c-shiji-108-han"},{"id":"c-shiji-108-han:m008-0021","start":21,"end":23,"surface":"王恢","kind":"person","person_id":"z2v_oh4_mhm","status":"contextual_provisional","paragraph_id":"c-shiji-108-han:p008","chapter_id":"c-shiji-108-han"}],"relations":[],"title_holdings":[{"id":"th-shiji108-019","person_id":"z2v_oh4_mhm","title":"大行","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-108-han","source_id":"s-shiji-108-han","paragraph_id":"c-shiji-108-han:p006","quote":"建元中，武安侯田蚡爲漢太尉，親貴用事，安國以五百金物遺蚡。蚡言安國太后，天子亦素聞其賢，即召以爲北地都尉，遷爲大司農。閩越、東越相攻，安國及大行王恢將。未至越，越殺其王降，漢兵亦罷。建元六年，武安侯爲丞相，安國爲御史大夫。"},{"chapter_id":"c-shiji-108-han","source_id":"s-shiji-108-han","paragraph_id":"c-shiji-108-han:p007","quote":"匈奴來請和親，天子下議。大行王恢，燕人也，數爲邊吏，習知胡事。議曰：「漢與匈奴和親，率不過數歳即復倍約。不如勿許，興兵擊之。」安國曰：「千里而戰，兵不獲利。今匈奴負戎馬之足，懷禽獸之心，遷徙鳥舉，難得而制也。得其地不足以爲廣，有其眾不足以爲彊，自上古不屬爲人。漢數千里爭利，則人馬罷，虜以全制其敝。且彊弩之極，矢不能穿魯縞；沖風之末，力不能漂鴻毛。非初不勁，末力衰也。擊之不便，不如和親。」群臣議者多附安國，於是上許和親。"},{"chapter_id":"c-shiji-108-han","source_id":"s-shiji-108-han","paragraph_id":"c-shiji-108-han:p008","quote":"其明年，則元光元年，鴈門馬邑豪聶翁壹因大行王恢言上曰：「匈奴初和親，親信邊，可誘以利。」陰使聶翁壹爲閒，亡入匈奴，謂單于曰：「吾能斬馬邑令丞吏，以城降，財物可盡得。」單于愛信之，以爲然，許聶翁壹。聶翁壹乃還，詐斬死罪囚，縣其頭馬邑城，示單于使者爲信。曰：「馬邑長吏已死，可急來。」於是單于穿塞將十餘萬騎，入武州塞。"}],"attestations":[{"id":"th-shiji108-019:a001","paragraph_id":"c-shiji-108-han:p006","start":70,"end":72,"surface":"大行","person_mention_id":"c-shiji-108-han:m006-0072","usage":"narrative"},{"id":"th-shiji108-019:a002","paragraph_id":"c-shiji-108-han:p007","start":12,"end":14,"surface":"大行","person_mention_id":"c-shiji-108-han:m007-0014","usage":"narrative"},{"id":"th-shiji108-019:a003","paragraph_id":"c-shiji-108-han:p008","start":19,"end":21,"surface":"大行","person_mention_id":"c-shiji-108-han:m008-0021","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"保存本文任官或用稱；未知端點不補日期。邊吏為歷任泛稱，豪與單于暫不套用漢官爵階序。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji108-020","person_id":"z2v_oh4_mhm","title":"邊吏","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-108-han","source_id":"s-shiji-108-han","paragraph_id":"c-shiji-108-han:p007","quote":"匈奴來請和親，天子下議。大行王恢，燕人也，數爲邊吏，習知胡事。議曰：「漢與匈奴和親，率不過數歳即復倍約。不如勿許，興兵擊之。」安國曰：「千里而戰，兵不獲利。今匈奴負戎馬之足，懷禽獸之心，遷徙鳥舉，難得而制也。得其地不足以爲廣，有其眾不足以爲彊，自上古不屬爲人。漢數千里爭利，則人馬罷，虜以全制其敝。且彊弩之極，矢不能穿魯縞；沖風之末，力不能漂鴻毛。非初不勁，末力衰也。擊之不便，不如和親。」群臣議者多附安國，於是上許和親。"}],"attestations":[{"id":"th-shiji108-020:a001","paragraph_id":"c-shiji-108-han:p007","start":23,"end":25,"surface":"邊吏","person_mention_id":"c-shiji-108-han:m007-0014","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"保存本文任官或用稱；未知端點不補日期。邊吏為歷任泛稱，豪與單于暫不套用漢官爵階序。","reviewer":"Codex（AI 代理）"}],"address_assertions":[{"id":"pa-shiji108-006","person_id":"z2v_oh4_mhm","relation":"native_place","place":{"source_name":"燕","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-108-han","source_id":"s-shiji-108-han","paragraph_id":"c-shiji-108-han:p007","quote":"匈奴來請和親，天子下議。大行王恢，燕人也，數爲邊吏，習知胡事。議曰：「漢與匈奴和親，率不過數歳即復倍約。不如勿許，興兵擊之。」安國曰：「千里而戰，兵不獲利。今匈奴負戎馬之足，懷禽獸之心，遷徙鳥舉，難得而制也。得其地不足以爲廣，有其眾不足以爲彊，自上古不屬爲人。漢數千里爭利，則人馬罷，虜以全制其敝。且彊弩之極，矢不能穿魯縞；沖風之末，力不能漂鴻毛。非初不勁，末力衰也。擊之不便，不如和親。」群臣議者多附安國，於是上許和親。"}],"source_term":"燕人也","interpretation_note":"來源出身，不補出生地或現代行政區。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-108-han:p006","text":"建元中，武安侯田蚡爲漢太尉，親貴用事，安國以五百金物遺蚡。蚡言安國太后，天子亦素聞其賢，即召以爲北地都尉，遷爲大司農。閩越、東越相攻，安國及大行王恢將。未至越，越殺其王降，漢兵亦罷。建元六年，武安侯爲丞相，安國爲御史大夫。","annotat