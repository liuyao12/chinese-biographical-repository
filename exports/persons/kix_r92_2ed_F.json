0-xiaozizhen-wangjun"},{"id":"c-nanshi-024-wangsiyuan:p002:m0129","surface":"子貞","start":129,"end":131,"person_id":"kix_r92_2ed_F","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-nanshi-024-wangsiyuan:p002","chapter_id":"c-nanshi-024-wangsiyuan"}],"relations":[{"id":"a-liang021-wangjun-zizhen-father","subject_person_id":"kix_r92_2ed_F","object_person_id":"kix_r92_2ed","predicate":"father","qualifiers":{"source_term":"世祖第十四子","liang021_jun_reading":"zizhen-father","lineage":"paternal","birth_order":{"parent_person_id":"kix_r92_2ed","ordinal":14,"scope":"sons_of_parent","position":"unspecified","source_term":"第十四子","interpretation_status":"source_attested"}},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-040","source_id":"s-nanqishu-040-xiaozizhen-wangjun-ws2272748","chapter_id":"c-nanqishu-040-xiaozizhen-wangjun","paragraph_id":"c-nanqishu-040-xiaozizhen-wangjun:p001","quote":"邵陵王子貞字雲松，世祖第十四子也。","subject_person_mention_id":"c-nanqishu-040-xiaozizhen-wangjun:p001:m0003","object_person_reference_id":"c-nanqishu-040-xiaozizhen-wangjun:p001:r0009"}],"status":"source_attested","interpretation_note":"子貞是南齊世祖第十四子。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"title_holdings":[],"address_assertions":[],"person_references":[{"id":"c-liangshu-021-wangjun-wangcong:p002:r0038","surface":"邵陵王","start":38,"end":41,"person_id":"kix_r92_2ed_F","referent_role":"third_person","paragraph_id":"c-liangshu-021-wangjun-wangcong:p002","quote":"峻少美風姿，善舉止。起家著作佐郎，不拜，累遷中軍廬陵王法曹行參軍，太子舍人，邵陵王文學，太傅主簿。府主齊竟陵王子良甚相賞遇。遷司徒主簿，以父憂去職。服闋，除太子洗馬，建安王友。出爲寧遠將軍、桂陽內史。會義師起，上流諸郡多相驚擾，峻閉門靜坐，一郡帖然，百姓賴之。","note":"子良為太傅的前任，子貞的齊王府。","chapter_id":"c-liangshu-021-wangjun-wangcong","book_id":"b-liangshu-021","work_id":"w-liangshu","source_id":"s-liangshu-021-wangjun-wangcong-ws1544250"},{"id":"c-nanqishu-040-xiaozizhen-wangjun:p001:r0000","surface":"邵陵王","start":0,"end":3,"person_id":"kix_r92_2ed_F","referent_role":"third_person","paragraph_id":"c-nanqishu-040-xiaozizhen-wangjun:p001","quote":"邵陵王子貞字雲松，世祖第十四子也。","note":"依本段敘事及王府原卷。","chapter_id":"c-nanqishu-040-xiaozizhen-wangjun","book_id":"b-nanqishu-040","work_id":"w-nanqishu","source_id":"s-nanqishu-040-xiaozizhen-wangjun-ws2272748"},{"id":"c-nanshi-024-wangsiyuan:p002:r0126","surface":"邵陵王","start":126,"end":129,"person_id":"kix_r92_2ed_F","referent_role":"third_person","paragraph_id":"c-nanshi-024-wangsiyuan:p002","quote":"齊建元初，曆竟陵王司徒録事參軍、太子中舍人。文惠太子與竟陵王子良素好士，並蒙賞接。思遠求出爲遠郡，除建安內史。長兄思玄卒，思遠友于甚至，表乞自解，不許。及祥日又固陳，武帝乃許之。仍除中書郎、大司馬諮議。詔舉士，竟陵王子良薦思遠及呉郡顧暠之、陳郡殷叡。時邵陵王子貞爲呉郡，除思遠爲呉郡丞，以本官行郡事，論者以爲得人。後拜御史中丞。臨海太守沈昭略贓私，思遠依事劾奏，明帝及思遠從兄晏、昭略叔父文季並請止之，思遠不從，案事如故。","note":"按本句行事、說話與受話兩端。","chapter_id":"c-nanshi-024-wangsiyuan","book_id":"b-nanshi-024","work_id":"w-nanshi","source_id":"s-nanshi-024-wangsiyuan-ws1765279"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[{"parent_person_id":"kix_r92_2ed","ordinal":14,"scope":"sons_of_parent","position":"unspecified","source_term":"第十四子","interpretation_status":"source_attested","assertion_id":"a-liang021-wangjun-zizhen-father","person_id":"kix_r92_2ed_F","evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-040","source_id":"s-nanqishu-040-xiaozizhen-wangjun-ws2272748","chapter_id":"c-nanqishu-040-xiaozizhen-wangjun","paragraph_id":"c-nanqishu-040-xiaozizhen-wangjun:p001","quote":"邵陵王子貞字雲松，世祖第十四子也。","subject_person_mention_id":"c-nanqishu-040-xiaozizhen-wangjun:p001:m0003","object_person_reference_id":"c-nanqishu-040-xiaozizhen-wangjun:p001:r0009"}]}],"preferred_birth_order_constraints":[{"parent_person_id":"kix_r92_2ed","ordinal":14,"scope":"sons_of_parent","position":"unspecified","source_term":"第十四子","interpretation_status":"source_attested","assertion_id":"a-liang021-wangjun-zizhen-father","person_id":"kix_r92_2ed_F","evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-040","source_id":"s-nanqishu-040-xiaozizhen-wangjun-ws2272748","chapter_id":"c-nanqishu-040-xiaozizhen-wangjun","paragraph_id":"c