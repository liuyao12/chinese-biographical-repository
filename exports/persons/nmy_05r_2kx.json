","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-qi059-qiuxiong-father","subject_person_id":"nmy_05r_2kx","object_person_id":"8j7_pns_4lu","predicate":"father","qualifiers":{"source_term":"世祖敕其子雄"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-059","chapter_id":"c-nanqishu-059-western-polities-complete","source_id":"s-nanqishu-059-western-polities-complete-ws1748911","paragraph_id":"c-nanqishu-059-western-polities-complete:p015","quote":"易度侯卒，八年，立其世子休留茂為使持節、督西秦河沙三州諸軍事、鎮西將軍、領護羌校尉、西秦河二州刺史。復遣振武將軍丘冠先拜授，并行弔禮。冠先至河南，休留茂逼令先拜，冠先厲色不肯，休留茂恥其國人，執冠先於絕巖上推墮深谷而死。冠先字道玄，吳興人，晉吏部郎傑六世孫也。上初遣冠先，示尚書令王儉，儉答上曰：「此人不啻堪行。」乃再銜命。及死，世祖敕其子雄曰：「卿父受使河南，秉忠守死，不辱王命，我甚賞惜，喪屍絕域，不可復尋，於卿後宦塗無妨，甚有高比。」賜錢十萬，布三十匹。","subject_person_mention_id":"c-nanqishu-059-western-polities-complete:p015:m0170","object_person_mention_id":"c-nanqishu-059-western-polities-complete:p015:m0056"}],"status":"source_attested","interpretation_note":"詔書以卿父指丘冠先。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-059-western-polities-complete:p015:m0170","start":170,"end":171,"surface":"雄","kind":"person","person_id":"nmy_05r_2kx","status":"contextual_provisional","paragraph_id":"c-nanqishu-059-western-polities-complete:p015","chapter_id":"c-nanqishu-059-western-polities-complete"}],"relations":[{"id":"a-qi059-qiuxiong-father","subject_person_id":"nmy_05r_2kx","object_person_id":"8j7_pns_4lu","predicate":"father","qualifiers":{"source_term":"世祖敕其子雄"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-059","chapter_id":"c-nanqishu-059-western-polities-complete","source_id":"s-nanqishu-059-western-polities-complete-ws1748911","paragraph_id":"c-nanqishu-059-western-polities-complete:p015","quote":"易度侯卒，八年，立其世