_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-songshu-041-dinglingguang-chen-rank:p001:m0006","mention_ids":["c-songshu-041-dinglingguang-chen-rank:p001:m0006"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-liangshu-007-dinglingguang-ws1566494","s-songshu-041-dinglingguang-chen-rank-ws2634831"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-liang007-dinglingguang-m-chen-mother","subject_person_id":"91d_607_b0a","object_person_id":"989_en9_fv0_A","predicate":"mother","qualifiers":{"source_term":"帝所生陳太妃","liang007_dinglingguang_reading":"m-chen-mother"},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-007","source_id":"s-liangshu-007-dinglingguang-ws1566494","chapter_id":"c-liangshu-007-dinglingguang","paragraph_id":"c-liangshu-007-dinglingguang:p003","quote":"禮，母以子貴。皇儲所生，不容無敬。宋泰豫元年六月，議百官以吏敬敬帝所生陳太妃，則宋明帝在時，百官未有敬。臣竊謂「母以子貴」，義著《春秋》。皇太子副貳宸極，率土咸執吏禮，旣盡禮皇儲，則所生不容無敬。但帝王妃嬪，義與外隔，以理以例，無致敬之道也。今皇太子聖睿在躬，儲禮夙備，子貴之道，抑有舊章。王侯妃主常得通信問者，及六宮三夫人雖與貴嬪同列，並應以敬皇太子之禮敬貴嬪。宋元嘉中，始興、武陵國臣並以吏敬敬所生潘淑妃、路淑媛。貴嬪于宮臣雖非小君，其義不異，與宋泰豫朝議百官以吏敬敬帝所生，事義正同。謂宮閹施敬宜同吏禮，詣神虎門奉牋致謁；年節稱慶，亦同如此。婦人無閫外之事，賀及問訊牋什，所由官報聞而已。夫婦人之道，義無自專，若不仰繫於夫，則當俯繫於子。榮親之道，應極其所榮，未有子所行而所從不足者也。故《春秋》凡王命爲夫人，則禮秩與子等。列國雖異於儲貳，而從尊之義不殊。前代依准，布在舊事。貴嬪載誕元良，克固大業，禮同儲君，實惟舊典。尋前代始置貴嬪，位次皇后，爵無所視；其次職者，位視相國，爵比諸侯王。此貴嬪之禮，已高朝列；況母儀春宮，義絕常算。且儲妃作配，率由盛則；以婦逾姑，彌乖從序。謂貴嬪典章，一與太子不異。","subject_person_reference_id":"c-liangshu-007-dinglingguang:p003:r0032","object_person_mention_id":"c-liangshu-007-dinglingguang:p003:m0035","relationship_anchor":{"paragraph_id":"c-liangshu-007-dinglingguang:p003","surface":"帝所生陳太妃","start":32,"end":38}}],"status":"source_attested","interpretation_note":"泰豫元年時新帝即宋後廢帝。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"a-liang007-dinglingguang-c-father","subject_person_id":"989_en9_fv0_A","object_person_id":"989_en9_fv0","predicate":"father","qualifiers":{"source_term":"太妃父金寶","liang007_dinglingguang_reading":"c-father","lineage":"paternal"},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-041","source_id":"s-songshu-041-dinglingguang-chen-rank-ws2634831","chapter_id":"c-songshu-041-dinglingguang-chen-rank","paragraph_id":"c-songshu-041-dinglingguang-chen-rank:p003","quote":"追贈太妃父金寶散騎常侍","subject_person_reference_id":"c-songshu-041-dinglingguang-chen-rank:p003:r0002","object_person_mention_id":"c-songshu-041-dinglingguang-chen-rank:p003:m0005","relationship_anchor":{"paragraph_id":"c-songshu-041-dinglingguang-chen-rank:p003","surface":"太妃父金寶","start":2,"end":7}}],"status":"source_attested","interpretation_note":"太妃父金寶。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[{"connection":"father","generation_distance":1,"parent_person_id":"989_en9_fv0","source_assertion_id":"a-liang007-dinglingguang-c-father","evidence":[{"work_id":"w-songshu","book_id":"b-songshu-041","source_id":"s-songshu-041-dinglingguang-chen-rank-ws2634831","chapter_id":"c-songshu-041-dinglingguang-chen-rank","paragraph_id":"c-songshu-041-dinglingguang-chen-rank:p003","quote":"追贈太妃父金寶散騎常侍","subject_person_reference_id":"c-songshu-041-dinglingguang-chen-rank:p003:r0002","object_person_mention_id":"c-songshu-041-dinglingguang-chen-rank:p003:m0005","relationshi