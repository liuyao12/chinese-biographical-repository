in":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-123-dayuan:m016-0114","start":114,"end":117,"surface":"渾邪王","kind":"person","person_id":"20n_l53_kkr","status":"contextual_provisional","paragraph_id":"c-shiji-123-dayuan:p016","chapter_id":"c-shiji-123-dayuan"},{"id":"c-shiji-123-dayuan:m017-0203","start":203,"end":205,"surface":"渾邪","kind":"person","person_id":"20n_l53_kkr","status":"contextual_provisional","paragraph_id":"c-shiji-123-dayuan:p017","chapter_id":"c-shiji-123-dayuan"},{"id":"c-shiji-123-dayuan:m017-0237","start":237,"end":239,"surface":"渾邪","kind":"person","person_id":"20n_l53_kkr","status":"contextual_provisional","paragraph_id":"c-shiji-123-dayuan:p017","chapter_id":"c-shiji-123-dayuan"},{"id":"c-shiji-123-dayuan:m018-0068","start":68,"end":70,"surface":"渾邪","kind":"person","person_id":"20n_l53_kkr","status":"contextual_provisional","paragraph_id":"c-shiji-123-dayuan:p018","chapter_id":"c-shiji-123-dayuan"}],"relations":[],"title_holdings":[{"id":"th-shiji123-012","person_id":"20n_l53_kkr","title":"渾邪王","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-123-dayuan","source_id":"s-shiji123-dayuan","paragraph_id":"c-shiji-123-dayuan:p016","quote":"騫以校尉從大將軍擊匈奴，知水草處，軍得以不乏，乃封騫為博望侯。是歲元朔六年也。其明年，騫為衛尉，與李將軍俱出右北平擊匈奴。匈奴圍李將軍，軍失亡多；而騫後期當斬，贖為庶人。是歲漢遣驃騎破匈奴西（城）［域］數萬人，至祁連山。其明年，渾邪王率其民降漢，而金城、河西西并南山至鹽澤空無匈奴。匈奴時有候者到，而希矣。其後二年，漢擊走單于於幕北。"}],"attestations":[{"id":"th-shiji123-012:a001","paragraph_id":"c-shiji-123-dayuan:p016","start":114,"end":117,"surface":"渾邪王","person_mention_id":"c-shiji-123-dayuan:m016-0114","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"原文授任、繼位與用稱分存；未知起訖保持未知，不因死亡自動終止。從驃侯等原稱不默改。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-123-dayuan:p016","text":"騫以校尉從大將軍擊匈奴，知水草處，軍得以不乏，乃封騫為博望侯。是歲元朔六年也。其明年，騫為衛尉，與李將軍俱出右北平擊匈奴。匈奴圍李將軍，軍失亡多；而騫後期當斬，贖為庶人。是歲漢遣驃騎破匈奴西（城）［域］數萬人，至祁連山。其明年，渾邪王率其民降漢，而金城、河西西并南山至鹽澤空無匈奴。匈奴時有候者到，而希矣。其後二年，漢擊走單于於幕北。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-123-dayuan:m016-0000","start":0,"end":1,"surface":"騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m016-0005","start":5,"end":8,"surface":"大將軍","kind":"person","person_id":"5dd_l1c_6g8","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m016-0025","start":25,"end":26,"surface":"騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m016-0043","start":43,"end":44,"surface":"騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m016-0049","start":49,"end":52,"surface":"李將軍","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m016-0064","start":64,"end":67,"surface":"李將軍","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m016-0074","start":74,"end":75,"surface":"騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m016-0089","start":89,"end":91,"surface":"驃騎","kind":"person","person_id":"3tw_nq2_gyn","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m016-0114","start":114,"end":117,"surface":"渾邪王","kind":"person","person_id":"20n_l53_kkr","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m016-0161","start":161,"end":163,"surface":"單于","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-123-dayuan","book_id":"b-shiji-123","work_id":"w-shiji","source_id":"s-shiji123-dayuan"},{"id":"c-shiji-123-dayuan:p017","text":"是後天子數問騫大夏之屬。騫既失侯，因言曰：「臣居匈奴中，聞烏孫王號昆莫，昆莫之父，匈奴西邊小國也。匈奴攻殺其父，而昆莫生棄於野。烏嗛肉蜚其上，狼往乳之。單于怪以為神，而收長之。及壯，使將兵，數有功，單于復以其父之民予昆莫，令長守於西（城）［域］。昆莫收養其民，攻旁小邑，控弦數萬，習攻戰。單于死，昆莫乃率其眾遠徙，中立，不肯朝會匈奴。匈奴遣奇兵擊，不勝，以為神而遠之，因羈屬之，不大攻。今單于新困於漢，而故渾邪地空無人。蠻夷俗貪漢財物，今誠以此時而厚幣賂烏孫，招以益東，居故渾邪之地，與漢結昆弟，其勢宜聽，聽則是斷匈奴右臂也。既連烏孫，自其西大夏之屬皆可招來而為外臣。」天子以為然，拜騫為中郎將，將三百人，馬各二匹，牛羊以萬數，齎金幣帛直數千巨萬，多持節副使，道可使，使遺之他旁國。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-123-dayuan:m017-0002","start":2,"end":4,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m017-0006","start":6,"end":7,"surface":"騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m017-0012","start":12,"end":13,"surface":"騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m017-0033","start":33,"end":35,"surface":"昆莫","kind":"person","person_id":"3jf_ce1_jy2_A","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m017-0036","start":36,"end":40,"surface":"昆莫之父","kind":"person","person_id":"3jf_ce1_jy2","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m017-0053","start":53,"end":55,"surface":"其父","kind":"person","person_id":"3jf_ce1_jy2","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m017-0057","start":57,"end":59,"surface":"昆莫","kind":"person","person_id":"3jf_ce1_jy2_A","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m017-0076","start":76,"end":78,"surface":"單于","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-123-dayuan:m017-0099","start":99,"end":101,"surface":"單于","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-123-dayuan:m017-0103","start":103,"end":105,"surface":"其父","kind":"person","person_id":"3jf_ce1_jy2","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m017-0108","start":108,"end":110,"surface":"昆莫","kind":"person","person_id":"3jf_ce1_jy2_A","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m017-0123","start":123,"end":125,"surface":"昆莫","kind":"person","person_id":"3jf_ce1_jy2_A","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m017-0144","start":144,"end":146,"surface":"單于","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-123-dayuan:m017-0148","start":148,"end":150,"surface":"昆莫","kind":"person","person_id":"3jf_ce1_jy2_A","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m017-0194","start":194,"end":196,"surface":"單于","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-123-dayuan:m017-0203","start":203,"end":205,"surface":"渾邪","kind":"person","person_id":"20n_l53_kkr","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m017-0237","start":237,"end":239,"surface":"渾邪","kind":"person","person_id":"20n_l53_kkr","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m017-0242","start":242,"end":247,"surface":"與漢結昆弟","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-123-dayuan:m017-0285","start":285,"end":287,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m017-0292","start":292,"end":293,"surface":"騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"}],"chapter_id":"c-shiji-123-dayuan","book_id":"b-shiji-123","work_id":"w-shiji","source_id":"s-shiji123-dayuan"},{"id":"c-shiji-123-dayuan:p018","text":"騫既至烏孫，烏孫王昆莫見漢使如單于禮，騫大慚，知蠻夷貪，乃曰：「天子致賜，王不拜則還賜。」昆莫起拜賜，其他如故。騫諭使指曰：「烏孫能東居渾邪地，則漢遣翁主為昆莫夫人。」烏孫國分，王老，而遠漢，未知其大小，素服屬匈奴日久矣，且又近之，其大臣皆畏胡，不欲移徙，王不能專制。騫不得其要領。昆莫有十餘子，其中子曰大祿，彊，善將眾，將眾別居萬餘騎。大祿兄為太子，太子有子曰岑娶，而太子蚤死。臨死謂其父昆莫曰：「必以岑娶為太子，無令他人代之。」昆莫哀而許之，卒以岑娶為太子。大祿怒其不得代太子也，乃收其諸昆弟，將其眾畔，謀攻岑娶及昆莫。昆莫老，常恐大祿殺岑娶，予岑娶萬餘騎別居，而昆莫有萬餘騎自備，國眾分為三，而其大總取羈屬昆莫，昆莫亦以此不敢專約於騫。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-123-dayuan:m018-0000","start":0,"end":1,"surface":"騫","kind":"person