tus":"contextual_provisional","paragraph_id":"c-shiji-129-huozhi:p004","chapter_id":"c-shiji-129-huozhi"},{"id":"c-shiji-129-huozhi:m004-0122","start":122,"end":124,"surface":"太公","kind":"person","person_id":"o6i_h2h_p8x","status":"contextual_provisional","paragraph_id":"c-shiji-129-huozhi:p004","chapter_id":"c-shiji-129-huozhi"},{"id":"c-shiji-129-huozhi:m009-0174","start":174,"end":176,"surface":"呂尚","kind":"person","person_id":"o6i_h2h_p8x","status":"contextual_provisional","paragraph_id":"c-shiji-129-huozhi:p009","chapter_id":"c-shiji-129-huozhi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-129-huozhi:p004","text":"《周書》曰：「農不出則乏其食，工不出則乏其事，商不出則三寶絕，虞不出則財匱少。」財匱少而山澤不辟矣。此四者，民所衣食之原也。原大則饒，原小則鮮。上則富國，下則富家。貧富之道，莫之奪予，而巧者有餘，拙者不足。故太公望封於營丘，地澙鹵，人民寡，於是太公勸其女功，極技巧，通魚鹽，則人物歸之，繦至而輻湊。故齊冠帶衣履天下，海岱之閒斂袂而往朝焉。其後齊中衰，管子修之，設輕重九府，則桓公以霸，九合諸侯，一匡天下；而管氏亦有三歸，位在陪臣，富於列國之君。是以齊富彊至於威、宣也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-129-huozhi:m004-0104","start":104,"end":107,"surface":"太公望","kind":"person","person_id":"o6i_h2h_p8x","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m004-0122","start":122,"end":124,"surface":"太公","kind":"person","person_id":"o6i_h2h_p8x","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m004-0175","start":175,"end":177,"surface":"管子","kind":"person","person_id":"s42_8cl_8n4","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m004-0187","start":187,"end":189,"surface":"桓公","kind":"person","person_id":"j1b_ffs_x7d","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m004-0203","start":203,"end":205,"surface":"管氏","kind":"person","person_id":"s42_8cl_8n4","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m004-0229","start":229,"end":230,"surface":"威","kind":"person","person_id":"1jw_cyx_37h","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m004-0231","start":231,"end":232,"surface":"宣","kind":"person","person_id":"i4l_q6t_81o","status":"contextual_provisional"}],"chapter_id":"c-shiji-129-huozhi","book_id":"b-shiji-129","work_id":"w-shiji","source_id":"s-shiji129-huozhi"},{"id":"c-shiji-129-huozhi:p009","text":"白圭，周人也。當魏文侯時，李克務盡地力，而白圭樂觀時變，故人棄我取，人取我與。夫歲孰取穀，予之絲漆；繭出取帛絮，予之食。太陰在卯，穰；明歲衰惡。至午，旱；明歲美。至酉，穰；明歲衰惡。至子，大旱；明歲美，有水。至卯，積著率歲倍。欲長錢，取下穀；長石斗，取上種。能薄飲食，忍嗜欲，節衣服，與用事僮仆同苦樂，趨時若猛獸摯鳥之發。故曰：「吾治生產，猶伊尹、呂尚之謀，孫吳用兵，商鞅行法是也。是故其智不足與權變，勇不足以決斷，仁不能以取予，彊不能有所守，雖欲學吾術，終不告之矣。」蓋天下言治生祖白圭。白圭其有所試矣，能試有所長，非茍而已也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-129-huozhi:m009-0000","start":0,"end":2,"surface":"白圭","kind":"person","person_id":"evw_7hk_sqo","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m009-0008","start":8,"end":11,"surface":"魏文侯","kind":"person","person_id":"ip4_v3x_bup","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m009-0013","start":13,"end":15,"surface":"李克","kind":"person","person_id":"38y_k8l_cla","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m009-0021","start":21,"end":23,"surface":"白圭","kind":"person","person_id":"evw_7hk_sqo","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m009-0171","start":171,"end":173,"surface":"伊尹","kind":"person","person_id":"08a_jo3_plo","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m009-0174","start":174,"end":176,"surface":"呂尚","kind":"person","person_id":"o6i_h2h_p8x","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m009-0179","start":179,"end":181,"surface":"孫吳","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-129-huozhi:m009-0184","start":184,"end":186,"surface":"商鞅","kind":"person","person_id":"eoz_084_vwg","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m009-0242","start":242,"end":244,"surface":"白圭","kind":"person","person_id":"evw_7hk_sqo"