5862,5863,5864,5865,5866,5867,5868,5869,5870,5871,5872,5873,5874,5875,5876,5877,5878,5879,5880,5881,5882,5883,5884,5885,5886,5887,5888,5889,5890,5891,5892,5893,5894,5895,5896,5897,5898,5899,5900,5901,5902,5903,5904,5905,5906,5907,5908,5909,5910,5911,5912,5913,5914,5915,5916,5917,5918,5919,5920,5921,5922,5923,5924,5925,5926,5927,5928,5929,5930],"projection_sha256":"31cb529e1416ad138b47a81eb3ac45b87e8a68ef7f144c43f3b858455ed9517f","editorial_excerpt_boundary":true},"chapter_id":"c-nanqishu-040-zhaozhou","book_id":"b-nanqishu-040","work_id":"w-nanqishu","source_id":"s-nanqishu-040-zhaozhou-ws2272748"},{"id":"c-nanshi-024-wangyan:p008","text":"晏人望未重，又與上素疎，中興初，雖以事計委任，而內相疑阻，晏無防意。既居朝端，事多專決，內外要職，並用周旋門義，毎與上爭用人。數呼相工自視，雲當大貴。與客語，好屏人。上聞，疑晏欲反，遂有誅晏意。有鮮于文粲與晏子德元往來，密探朝旨，告晏有異志。又左右單景雋、陳世范等采巫覡言啟上，雲晏懷異圖。是時南郊應親奉，景雋等言晏因此與武帝故主帥于道中竊發。會獸犯郊壇，帝愈懼，未郊前一日，上乃停行，先報晏及徐孝嗣，孝嗣奉旨，而晏陳郊祀事大，必宜自力。景雋言益見信，元會畢，乃召晏于華林省誅之。下詔顯其罪，稱以河東王鉉識用微弱，欲令守以虛器，並令收付廷尉。","mentions":[{"id":"c-nanshi-024-wangyan:p008:m0000","surface":"晏","start":0,"end":1,"person_id":"i08_s4b_5bb","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangyan:p008:m0029","surface":"晏","start":29,"end":30,"person_id":"i08_s4b_5bb","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangyan:p008:m0087","surface":"晏","start":87,"end":88,"person_id":"i08_s4b_5bb","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangyan:p008:m0094","surface":"晏","start":94,"end":95,"person_id":"i08_s4b_5bb","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangyan:p008:m0098","surface":"鮮于文粲","start":98,"end":102,"person_id":"m81_zhd_6kd","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangyan:p008:m0103","surface":"晏","start":103,"end":104,"person_id":"i08_s4b_5bb","kind":"person","status":"contextual_p