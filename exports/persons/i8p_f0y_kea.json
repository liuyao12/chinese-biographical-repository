_id":"c-shiji-108-han:p001","quote":"張羽"},{"mention_id":"c-shiji-108-han:m001-0092","chapter_id":"c-shiji-108-han","paragraph_id":"c-shiji-108-han:p001","quote":"張羽"},{"mention_id":"c-hanshu-035-jingyanwu:wuwang:m018-0097","chapter_id":"c-hanshu-035-jingyanwu","paragraph_id":"c-hanshu-035-jingyanwu:wuwang:p018","quote":"張羽"},{"mention_id":"c-shiji-120-jizheng:m016-0009","chapter_id":"c-shiji-120-jizheng","paragraph_id":"c-shiji-120-jizheng:p016","quote":"張羽"}]}],"source_mention_summary":[{"source_id":"s-shiji-050-chuyuan","work_id":"w-shiji","book_id":"b-shiji-050","chapter_id":"c-shiji-050-chuyuan","mention_count":2,"mention_ids":["c-shiji-050-chuyuan:m004-0035","c-shiji-050-chuyuan:m004-0051"],"paragraph_ids":["c-shiji-050-chuyuan:p004"],"table_cell_ids":[],"passage_count":1},{"source_id":"s-hanshu-035-jingyanwu","work_id":"w-hanshu","book_id":"b-hanshu-035","chapter_id":"c-hanshu-035-jingyanwu","mention_count":1,"mention_ids":["c-hanshu-035-jingyanwu:wuwang:m018-0092"],"paragraph_ids":["c-hanshu-035-jingyanwu:wuwang:p018"],"table_cell_ids":[],"passage_count":1},{"source_id":"s-shiji-106-wuwang","work_id":"w-shiji","book_id":"b-shiji-106","chapter_id":"c-shiji-106-wuwang","mention_count":1,"mention_ids":["c-shiji-106-wuwang:m017-0095"],"paragraph_ids":["c-shiji-106-wuwang:p017"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-050-chuyuan"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji106-010","subject_person_id":"o6h_ba5_gno","predicate":"brother","object_person_id":"i8p_f0y_kea","status":"source_attested","evidence":[{"chapter_id":"c-shiji-106-wuwang","source_id":"s-shiji-106-wuwang","paragraph_id":"c-shiji-106-wuwang:p017","quote":"初，吳王之度淮，與楚王遂西敗棘壁，乘勝前，銳甚。梁孝王恐，遣六將軍擊吳，又敗梁兩將，士卒皆還走梁。梁數使使報條侯求救，條侯不許。又使使惡條侯於上，上使人告條侯救梁，復守便宜不行。梁使韓安國及楚死事相弟張羽為將軍，乃得頗敗吳兵。吳兵欲西，梁城守堅，不敢西，即走條侯軍，會下邑。欲戰，條侯壁，不肯戰。吳糧絕，卒饑，數挑戰，遂夜奔條侯壁，驚東南。條侯使備西北，果從西北入。吳大敗，士卒多饑死，乃畔散。於是吳王乃與其麾下壯士數千人夜亡去，度江走丹徒，保東越。東越兵可萬餘人，乃使人收聚亡卒。漢使人以利啗東越，東越即紿吳王，吳王出勞軍，即使人鏦殺吳王，盛其頭，馳傳以聞。吳王子子華、子駒亡走閩越。吳王之棄其軍亡也，軍遂潰，往往稍降太尉、梁軍。楚王戊軍敗，自殺。"}],"qualifiers":{"source_term":"楚死事相弟張羽","historicity":"historical_tradition","relative_birth_order":{"older_person_id":"i8p_f0y_kea","younger_person_id":"o6h_ba5_gno","operator":"lt","older_ordinal":null,"younger_ordinal":null,"scope":"siblings","interpretation_status":"source_attested","comparison_basis":"birth_chronology"}},"interpretation_note":"明稱弟張羽，不補楚死事相姓名或共同父母。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-shiji050-004","person_id":"i8p_f0y_kea","event_type":"death","status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-050-chuyuan","source_id":"s-shiji-050-chuyuan","paragraph_id":"c-shiji-050-chuyuan:p004","quote":"王戊立二十年，冬，坐為薄太后服私姦，削東海郡。春，戊與吳王合謀反，其相張尚、太傅趙夷吾諫，不聽。戊則殺尚、夷吾，起兵與吳西攻梁，破棘壁。至昌邑南，與漢將周亞夫戰。漢絕吳楚糧道，士卒饑，吳王走，楚王戊自殺，軍遂降漢。","person_mention_id":"c-shiji-050-chuyuan:m004-0051"}],"source_term":"戊則殺尚、夷吾","interpretation_note":"來源明示死亡；同段省略主體按前後繼位敘事判讀。立若干年是來源任期，不倒推生日或完整公曆時長，數字紀年待核。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"mentions":[{"id":"c-hanshu-035-jingyanwu:wuwang:m018-0092","start":92,"end":96,"surface":"楚死事相","kind":"person","person_id":"i8p_f0y_kea","status":"contextual_provisional","paragraph_id":"c-hanshu-035-jingyanwu:wuwang:p018","chapter_id":"c-hanshu-035-jingyanwu"},{"id":"c-shiji-050-chuyuan:m004-0035","start":35,"end":37,"surface":"張尚","kind":"person","person_id":"i8p_f0y_kea","status":"contextual_provisional","paragraph_id":"c-shiji-050-chuyuan:p004","chapter_id":"c-shiji-050-chuyuan"},{"id":"c-shiji-050-chuyuan:m004-0051","start