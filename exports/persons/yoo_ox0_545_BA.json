ox0_545_B","status":"contextual_provisional"},{"id":"c-sanguozhi-010-xunyu-xunyou-jiaxu:intro:p001:m0045","start":45,"end":46,"surface":"爽","kind":"person","person_id":"yoo_ox0_545_F","status":"contextual_provisional"}],"source_position":{"first_line":19,"last_line":21,"editorial_excerpt_boundary":true,"source_commit":"214fcafa79894355909c9d8c2c1533089e7791c6"},"chapter_id":"c-sanguozhi-010-xunyu-xunyou-jiaxu","book_id":"b-sanguozhi-010","work_id":"w-sanguozhi","source_id":"s-sanguozhi-010-xunyu-xunyou-jiaxu"}],"sources":[{"chapter_id":"c-houhanshu-062-xunhan-zhongchen","work_id":"w-houhanshu","book_id":"b-houhanshu-062","source_id":"s-houhanshu-062-xunhan-zhongchen","source":{"title":"荀韓鍾陳列傳第五十二（數位選錄）","provider":"Kanripo","url":"https://github.com/kanripo/KR2a0009/blob/6db36b6dcbe843b825354c22e9be9193d0137c04/KR2a0009_092.txt","permalink":"https://github.com/kanripo/KR2a0009/blob/6db36b6dcbe843b825354c22e9be9193d0137c04/KR2a0009_092.txt","revision_id":"6db36b6dcbe843b825354c22e9be9193d0137c04","accessed_on":"2026-10-18","extent":"荀氏家族相關局部選錄；不是全卷轉錄或完整人物覆核。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文；保留固定數位見證及轉錄來源歸屬。","license_url":"https://www.kanripo.org/","normalization":{"character_conversion":{},"excerpts":[{"proposed_paragraph_id":"c-houhanshu-062-xunhan-zhongchen:eight-sons:p001","source_lines":[14,27],"raw_quote":"荀淑字季和潁川潁隂人也荀卿十一世孫也(卿名况/趙人也)¶\n(為楚蘭陵令著書二十二篇號/荀卿子避宣帝諱故改曰孫也)少有髙行博學而不好¶\n<pb:KR2a0009_WYG_092-1b>¶\n章句多為俗儒所非而州里稱其知人安帝時徴拜郎¶\n中後再遷當塗長(當塗縣名故/城在今宣州)去職還鄉里當世名賢¶\n李固李膺等皆師宗之及梁太后臨朝有日食地震之¶\n變詔公卿舉賢良方正光禄勲杜喬少府房植舉淑對¶\n䇿譏刺貴倖為大將軍梁冀所忌出補朗陵侯相(續漢/書曰)¶\n(淑對䇿刺梁/氏故出也)莅事明理稱為神君頃之弃官歸閒居養¶\n志產業每增輒以贍宗族知友年六十七建和三年卒¶\n李膺時為尚書自表師喪(禮記曰事師無犯無隠左右/就養無方服勤至死心喪三)¶\n<pb:KR2a0009_WYG_092-2a>¶\n(年/)二縣皆為立祠有子八人儉緄靖燾汪爽肅專並有¶\n名稱時人謂八龍(緄音昆燾音道汪音烏光反說文云/汪深廣也俗本改作注非專本或作)¶\n","raw_quote_sha256":"32cbd6d66f071e4bd39abb7c5ecb54b874a5d556ab67f26824718decc4186d3d","body_before_excerpt_selection":"荀淑字季和潁川潁隂人也荀卿十一世孫也少有髙行博學而不好章句多為俗儒所非而州里稱其知人安帝時徴拜郎中後再遷當塗長去職還鄉里當世名賢李固李膺等皆師宗之及梁太后臨朝有日食地震之變詔公卿舉賢良方正光禄勲杜喬少府房植舉淑對䇿譏刺貴倖為大將軍梁冀所忌出補朗陵侯相莅事明理稱為神君頃之弃官歸閒居養志產業每增輒以贍宗族知友年六十七建和三年卒李膺時為尚書自表師喪二縣皆為立祠有子八人儉緄靖燾汪爽肅專並有名稱時人謂八龍","body_selection":{"start":0,"end":199,"begin_anchor":"荀淑字季和潁川潁隂人","end_anchor":"專並有名稱時人謂八龍"},"commentary":[{"raw_quote":"(卿名况/趙人也)","body_offset":18,"raw_start":18,"raw_end":27,"excerpt_body_offset":18},{"raw_quote":"(為楚蘭陵令著書二十二篇號/荀卿子避宣帝諱故改曰孫也)","body_offset":18,"raw_start":29,"raw_end":56,"excerpt_body_offset":18},{"raw_quote":"(當塗縣名故/城在今宣州)","body_offset":55,"raw_start":123,"raw_end":136,"excerpt_body_offset":55},{"raw_quote":"(續漢/書曰)","body_offset":125,"raw_start":212,"raw_end":219,"excerpt_body_offset":125},{"raw_quote":"(淑對䇿刺梁/氏故出也)","body_offset":125,"raw_start":221,"raw_end":233,"excerpt_body_offset":125},{"raw_quote":"(禮記曰事師無犯無隠左右/就養無方服勤至死心喪三)","body_offset":172,"raw_start":284,"raw_end":309,"excerpt_body_offset":172},{"raw_quote":"(年/)","body_offset":172,"raw_start":337,"raw_end":341,"excerpt_body_offset":172},{"raw_quote":"(緄音昆燾音道汪音烏光反說文云/汪深廣也俗本改作注非專本或作)","body_offset":199,"raw_start":370,"raw_end":401,"excerpt_body_offset":199}],"page_markers":[{"raw_quote":"<pb:KR2a0009_WYG_092-1b>","body_offset":27,"raw_offset":67},{"raw_quote":"<pb:KR2a0009_WYG_092-2a>","body_offset":172,"raw_offset":311}]},{"proposed_paragraph_id":"c-houhanshu-062-xunhan-zhongchen:yue-intro:p001","source_lines":[166,170],"raw_quote":"恱字仲豫儉之子也儉早卒恱年十二能說春秋家貧¶\n無書每之人間所見篇牘一覽多能誦記性沈静羙姿¶\n容尤好著述靈帝時閹官用權士多退身窮處恱乃託¶\n<pb:KR2a0009_WYG_092-10a>¶\n疾隠居時人莫之識從弟彧特稱敬焉初辟鎮東將軍¶\n","raw_quote_sha256":"d03913956ac729e11ec7392af76ae270a2055a7416ca9b03d6f9a262b649046b","body_before_excerpt_selection":"恱字仲豫儉之子也儉早卒恱年十二能說春秋家貧無書每之人間所見篇牘一覽多能誦記性沈静羙姿容尤好著述靈帝時閹官用權士多退身窮處恱乃託疾隠居時人莫之識從弟彧特稱敬焉初辟鎮東將軍","body_selection":{"start":0,"end":78,"begin_anchor":"恱字仲豫儉之子也儉早","end_anchor":"莫之識從弟彧特稱敬焉"},"commentary":[],"page_markers":[{"raw_quote":"<pb:KR2a0009_WYG_092-10a>","body_offset":63,"raw_offset":69}]},{"proposed_paragraph_id":"c-houhanshu-062-xunhan-zhongchen:shuang-intro:p001","source_lines":[39,40],"raw_quote":"爽字慈明一名諝(音息/汝反)幼而好學年十二能通春秋論¶\n語太尉杜喬見而稱之曰可為人師爽遂耽思經書慶¶\n","raw_quote_sha256":"c34ff57d97f368f452ed948bc4b27c64e7159eda09ffb300b9b8aa965e5c71dc","body_before_excerpt_selection":"爽字慈明一名諝幼而好學年十二能通春秋論語太尉杜喬見而稱之曰可為人師爽遂耽思經書慶","body_selection":{"start":0,"end":20,"begin_anchor":"爽字慈明一名諝","end_anchor":"能通春秋論語"},"commentary":[{"raw_quote":"(音息/汝反)","raw_start":7,"raw_end":14,"body_offset":7,"excerpt_body_offset":7}],"page_markers":[]}],"extraction_note":"按明列首尾選錄；保留原字，Kanripo正文與括號古注、頁標分離，維基文庫選句沒有模板轉換。未核書影，未完成全卷。"},"source_commit":"6db36b6dcbe843b825354c22e9be9193d0137c04","source_blob_sha":"614feff3bc8a94d5dc145f9cbdfcc3b5e43857dc","response_sha256":"55aac81cecc80987ab95b4bab053720595f4124c8fcb6f3c3ac3ebe7725018c6","edition":"WYG（文淵閣四庫全書）","response_extent":{"first_line":1,"last_line":421,"partial_file":false},"numbering_note":"通行卷六十二、列傳第五十二；此固定WYG數位見證題卷九十二，檔名KR2a0009_092.txt，兩者分存，不改原檔。"}},{"chapter_id":"c-jinshu-039-wangxun-feng","work_id":"w-jinshu","book_id":"b-jinshu-039","source_id":"s-jinshu-039-wangxun-feng","source":{"title":"王沈荀顗荀勖馮紞列傳第九（數位選錄）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=晉書/卷039&oldid=2108782","permalink":"https://zh.wikisource.org/w/index.php?title=晉書/卷039&oldid=2108782","revision_id":2108782,"accessed_on":"2026-10-18","extent":"荀氏家族相關局部選錄；不是全卷轉錄或完整人物覆核。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文；保留固定數位見證及轉錄來源歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"excerpts":[{"proposed_paragraph_id":"c-jinshu-039-wangxun-feng:yi-intro:p001","source_lines":[51,51],"raw_quote":"　　荀顗，字景倩，潁川人，魏太尉彧之第六子也。幼為姊婿陳群所賞。性至孝，總角知名，博學洽聞，理思周密。魏時以父勳除中郎。宣帝輔政，見顗奇之，曰：「荀令君之子也。」擢拜散騎侍郎，累遷侍中。為魏少帝執經，拜騎都尉，賜爵關內侯。難鍾會《[[易]]》無互體，又與扶風王駿論仁孝孰先，見稱於世。","raw_quote_sha256":"fedbb794aa1c1174185546521a49178136a04bd36fed9a12009545cc3b6125d6","body_before_excerpt_selection":"　　荀顗，字景倩，潁川人，魏太尉彧之第六子也。幼為姊婿陳群所賞。性至孝，總角知名，博學洽聞，理思周密。魏時以父勳除中郎。宣帝輔政，見顗奇之，曰：「荀令君之子也。」擢拜散騎侍郎，累遷侍中。為魏少帝執經，拜騎都尉，賜爵關內侯。難鍾會《[[易]]》無互體，又與扶風王駿論仁孝孰先，見稱於世。","body_selection":{"start":2,"end":23,"begin_anchor":"荀顗，字景倩，潁川人","end_anchor":"魏太尉彧之第六子也。"}},{"proposed_paragraph_id":"c-jinshu-039-wangxun-feng:xu-intro:p001","source_lines":[66,66],"raw_quote":"　　荀勖，字公曾，潁川潁陰人，漢司空爽曾孫也。祖棐，射聲校尉。父肸，早亡。勖依于舅氏。岐嶷夙成，年十餘歲能屬文。從外祖魏太傅鍾繇曰：「此兒當及其曾祖。」既長，遂博學，達于從政。仕魏，辟大將軍曹爽掾，遷中書通事郎。爽誅，門生故吏無敢往者，勖獨臨赴，眾乃從之。為安陽令，轉驃騎從事中郎。勖有遺愛，安陽生為立祠。遷廷尉正，參文帝大將軍軍事，賜爵關內侯，轉從事中郎，領記室。","raw_quote_sha256":"d0f17b8ec321eb24cc8ff6c1d4d0d28a85ec48c3b5e48c394b9403d523f9ea1f","body_before_excerpt_selection":"　　荀勖，字公曾，潁川潁陰人，漢司空爽曾孫也。祖棐，射聲校尉。父肸，早亡。勖依于舅氏。岐嶷夙成，年十餘歲能屬文。從外祖魏太傅鍾繇曰：「此兒當及其曾祖。」既長，遂博學，達于從政。仕魏，辟大將軍曹爽掾，遷中書通事郎。爽誅，門生故吏無敢往者，勖獨臨赴，眾乃從之。為安陽令，轉驃騎從事中郎。勖有遺愛，安陽生為立祠。遷廷尉正，參文帝大將軍軍事，賜爵關內侯，轉從事中郎，領記室。","body_selection":{"start":2,"end":37,"begin_anchor":"荀勖，字公曾，潁川潁","end_anchor":"聲校尉。父肸，早亡。"}}],"extraction_note":"按明列首尾選錄；保留原字，Kanripo正文與括號古注、頁標分離，維基文庫選句沒有模板轉換。未核書影，未完成全卷。"},"response_sha256":"6024484babc384e46d119f771afcfcc00dda04e96dfd57c6e2e220bfc11ca63f","wikitext_sha256":"93fdc36293b084a3693b073808ba92095e730973f8e4c5b2b4dd19fb1e9cea4c","edition":"維基文庫數位轉錄，底本影像未核"}},{"chapter_id":"c-sanguozhi-010-xunyu-xunyou-jiaxu","work_id":"w-sanguozhi","book_id":"b-sanguozhi-010","source_id":"s-sanguozhi-010-xunyu-xunyou-jiaxu","source":{"title":"荀彧荀攸賈詡傳第十（數位選錄）","provider":"Kanripo","url":"https://github.com/kanripo/KR2a0012/blob/214fcafa79894355909c9d8c2c1533089e7791c6/KR2a0012_010.txt","permalink":"https://github.com/kanripo/KR2a0012/blob/214fcafa79894355909c9d8c2c1533089e7791c6/KR2a0012_010.txt","revision_id":"214fcafa79894355909c9d8c2c1533089e7791c6","accessed_on":"2026-10-18","extent":"荀氏家族相關局部選錄；不是全卷轉錄或完整人物覆核。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文；保留固定數位見證及轉錄來源歸屬。","license_url":"https://www.kanripo.org/","normalization":{"character_conversion":{},"excerpts":[{"proposed_paragraph_id":"c-sanguozhi-010-xunyu-xunyou-jiaxu:intro:p001","source_lines":[1