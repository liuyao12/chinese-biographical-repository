ue"},{"id":"c-shiji-114-dongyue:m004-0131","start":131,"end":133,"surface":"天子","kind":"person","person_id":"y1h_fo3_brs","status":"contextual_provisional","paragraph_id":"c-shiji-114-dongyue:p004","chapter_id":"c-shiji-114-dongyue"},{"id":"c-shiji-114-dongyue:m004-0229","start":229,"end":231,"surface":"天子","kind":"person","person_id":"y1h_fo3_brs","status":"contextual_provisional","paragraph_id":"c-shiji-114-dongyue:p004","chapter_id":"c-shiji-114-dongyue"},{"id":"c-shiji-114-dongyue:m005-0032","start":32,"end":34,"surface":"天子","kind":"person","person_id":"y1h_fo3_brs","status":"contextual_provisional","paragraph_id":"c-shiji-114-dongyue:p005","chapter_id":"c-shiji-114-dongyue"},{"id":"c-shiji-114-dongyue:m006-0088","start":88,"end":89,"surface":"上","kind":"person","person_id":"y1h_fo3_brs","status":"contextual_provisional","paragraph_id":"c-shiji-114-dongyue:p006","chapter_id":"c-shiji-114-dongyue"},{"id":"c-shiji-114-dongyue:m008-0019","start":19,"end":21,"surface":"天子","kind":"person","person_id":"y1h_fo3_brs","status":"contextual_provisional","paragraph_id":"c-shiji-114-dongyue:p008","chapter_id":"c-shiji-114-dongyue"},{"id":"c-shiji-114-dongyue:m010-0002","start":2,"end":4,"surface":"天子","kind":"person","person_id":"y1h_fo3_brs","status":"contextual_provisional","paragraph_id":"c-shiji-114-dongyue:p010","chapter_id":"c-shiji-114-dongyue"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-114-dongyue:p003","text":"吳王子子駒亡走閩越，怨東甌殺其父，常勸閩越擊東甌。至建元三年，閩越發兵圍東甌。東甌食盡，困，且降，乃使人告急天子。天子問太尉田蚡，蚡對曰：「越人相攻擊，固其常，又數反覆，不足以煩中國往救也。自秦時棄弗屬。」於是中大夫莊助詰蚡曰：「特患力弗能救，德弗能覆；誠能，何故棄之？且秦舉咸陽而棄之，何乃越也！今小國以窮困來告急天子，天子弗振，彼當安所告愬？又何以子萬國乎？」上曰：「太尉未足與計。吾初即位，不欲出虎符發兵郡國。」乃遣莊助以節發兵會稽。會稽太守欲距不為發兵，助乃斬一司馬，諭意指，遂發兵浮海救東甌。未至，閩越引兵而去。東甌請舉國徙中國，乃悉舉眾來，處江淮之閒。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-114-dongyue:m003-0000","start":0,"end":2,"surface":"吳王","kind":"person","person_id":"qfq_48j_lpj","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m003-0003","start":3,"end":5,"surface":"子駒","kind":"person","person_id":"qfq_48j_lpj_A","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m003-0054","start":54,"end":56,"surface":"天子","kind":"person","person_id":"y1h_fo3_brs","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m003-0057","start":57,"end":59,"surface":"天子","kind":"person","person_id":"y1h_fo3_brs","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m003-0062","start":62,"end":64,"surface":"田蚡","kind":"person","person_id":"al0_ke0_9c7","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m003-0065","start":65,"end":66,"surface":"蚡","kind":"person","person_id":"al0_ke0_9c7","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m003-0108","start":108,"end":110,"surface":"莊助","kind":"person","person_id":"i7l_4us_u58","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m003-0111","start":111,"end":112,"surface":"蚡","kind":"person","person_id":"al0_ke0_9c7","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m003-0158","start":158,"end":160,"surface":"天子","kind":"person","person_id":"y1h_fo3_brs","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m003-0161","start":161,"end":163,"surface":"天子","kind":"person","person_id":"y1h_fo3_brs","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m003-0182","start":182,"end":183,"surface":"上","kind":"person","person_id":"y1h_fo3_brs","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m003-0211","start":211,"end":213,"surface":"莊助","kind":"person","person_id":"i7l_4us_u58","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m003-0220","start":220,"end":224,"surface":"會稽太守","kind":"person","person_id":"v92_t1u_5l1","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m003-0231","start":231,"end":232,"surface":"助","kind":"person","person_id":"i7l_4us_u58","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m003-0234","start":234,"end":237,"surface":"一司馬","kind":"person","person_id":"tvi_05j_cxc","status":"contextual_provisional"}],"chapter_id":"c-shiji-114-dongyue","book_id":"b-shiji-114","work_id":"w-shiji","source_id":"s-shiji114-dongyue"},{"id":"c-shiji-114-dongyue:p004","text":"至建元六年，閩越擊南越。南越守天子約，不敢擅發兵擊而以聞。上遣大行王恢出豫章，大農韓安國出會稽，皆為將軍。兵未踰嶺，閩越王郢發兵距險。其弟餘善乃與相、宗族謀曰：「王以擅發兵擊南越，不請，故天子兵來誅。今漢兵眾彊，今即幸勝之，后來益多，終滅國而止。今殺王以謝天子。天子聽，罷兵，固一國完；不聽，乃力戰；不勝，即亡入海。」皆曰「善」。即鏦殺王，使使奉其頭致大行。大行曰：「所為來者誅王。今王頭至，謝罪，不戰而耘，利莫大焉。」乃以便宜案兵告大農軍，而使使奉王頭馳報天子。詔罷兩將兵，曰：「郢等首惡，獨無諸孫繇君丑不與謀焉。」乃使郎中將立丑為越繇王，奉閩越先祭祀。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-114-dongyue:m004-0015","start":15,"end":17,"surface":"天子","kind":"person","person_id":"y1h_fo3_brs","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m004-0033","start":33,"end":35,"surface":"王恢","kind":"person","person_id":"z2v_oh4_mhm","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m004-0041","start":41,"end":44,"surface":"韓安國","kind":"person","person_id":"oj7_6jw_4hs","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m004-0061","start":61,"end":62,"surface":"郢","kind":"person","person_id":"xp5_39k_w5w","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m004-0069","start":69,"end":71,"surface":"餘善","kind":"person","person_id":"ub3_zen_skw","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m004-0073","start":73,"end":74,"surface":"相","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-114-dongyue:m004-0075","start":75,"end":77,"surface":"宗族","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-114-dongyue:m004-0094","start":94,"end":96,"surface":"天子","kind":"person","person_id":"y1h_fo3_brs","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m004-0128","start":128,"end":130,"surface":"天子","kind":"person","person_id":"y1h_fo3_brs","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m004-0131","start":131,"end":133,"surface":"天子","kind":"person","person_id":"y1h_fo3_brs","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m004-0229","start":229,"end":231,"surface":"天子","kind":"person","person_id":"y1h_fo3_brs","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m004-0241","start":241,"end":242,"surface":"郢","kind":"person","person_id":"xp5_39k_w5w","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m004-0247","start":247,"end":249,"surface":"無諸","kind":"person","person_id":"e00_pe1_zri","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m004-0252","start":252,"end":253,"surface":"丑","kind":"person","person_id":"e00_pe1_zri_*A","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m004-0261","start":261,"end":264,"surface":"郎中將","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-114-dongyue:m004-0265","start":265,"end":266,"surface":"丑","kind":"person","person_id":"e00_pe1_zri_*A","status":"contextual_provisional"}],"chapter_id":"c-shiji-114-dongyue","book_id":"b-shiji-114","work_id":"w-shiji","source_id":"s-shiji114-dongyue"},{"id":"c-shiji-114-dongyue:p005","text":"餘善已殺郢，威行於國，國民多屬，竊自立為王。繇王不能矯其眾持正。天子聞之，為餘善不足復興師，曰：「餘善數與郢謀亂，而後首誅郢，師得不勞。」因立餘善為東越王，與繇王并處。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-114-dongyue:m005-0000","start":0,"end":2,"surface":"餘善","kind":"person","person_id":"ub3_zen_skw","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m005-0004","start":4,"end":5,"surface":"郢","kind":"person","person_id":"xp5_39k_w5w","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m005-0022","start":22,"end":24,"surface":"繇王","kind":"person","person_id":"e00_pe1_zri_*A","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m005-0032","start":32,"end":34,"surface":"天子","kind":"person","person_id":"y1h_fo3_brs","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m005-0038","start":38,"end":40,"surface":"餘善","kind":"person","person_id":"ub3_zen_skw","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m005-0049","start":49,"end":51,"surface":"餘善","kind":"person","person_id":"ub3_zen_skw","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m005-0053","start":53,"end":54,"surface":"郢","kind":"person","person_id":"xp5_39k_w5w","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m005-0061","start":61,"end":62,"surface":"郢","kind":"person","person_id":"xp5_39k_w5w","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m005-0071","start":71,"end":73,"surface":"餘善","kind":"person","person_id":"ub3_zen_skw","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m005-0079","start":79,"end":81,"surface":"繇王","kind":"person","person_id":"e00_pe1_zri_*A","status":"contextual_provisional"}],"chapter_id":"c-shiji-114-dongyue","book_id":"b-shiji-114","work_id":"w-shiji","source_id":"s-shiji114-dongyue"},{"id":"c-shiji-114-dongyue:p006","text":"至元鼎五年，南越反，東越王餘善上書，請以卒八千人從樓船將軍擊呂嘉等。兵至揭揚，以海風波為解，不行，持兩端，陰使南越。及漢破番禺，不至。是時樓船將軍楊仆使使上書，願便引兵擊東越。上曰士卒勞倦，不許，罷兵，令諸校屯豫章梅領待命。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-114-dongyue:m006-0013","start":13,"end":15,"surface":"餘善","kind":"person","person_id":"ub3_zen_skw","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m006-0025","start":25,"end":29,"surface":"樓船將軍","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m006-0030","start":30,"end":32,"surface":"呂嘉","kind":"person","person_id":"jfm_184_2yb","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m006-0069","start":69,"end":73,"surface":"樓船將軍","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m006-0073","start":73,"end":75,"surface":"楊仆","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m006-0088","start":88,"end":89,"surface":"上","kind":"person","person_id":"y1h_fo3_brs","status":"contextual_provisional"}],"chapter_id":"c-shiji-114-dongyue","book_id":"b-shiji-114","work_id":"w-shiji","source_id":"s-shiji114-dongyue"},{"id":"c-shiji-114-dongyue:p008","text":"餘善刻「武帝」璽自立，詐其民，為妄言。天子遣橫海將軍韓說出句章，浮海從東方往；樓船將軍楊仆出武林；中尉王溫舒出梅嶺；越侯為戈船、下瀨將軍，出若邪、白沙。元封元年冬，咸入東越。東越素發兵距險，使徇北將軍守武林，敗樓船軍數校尉，殺長吏。樓船將軍率錢唐轅終古斬徇北將軍，為御兒侯。自兵未往。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-114-dongyue:m008-0000","start":0,"end":2,"surface":"餘善","kind":"person","person_id":"ub3_zen_skw","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m008-0019","start":19,"end":21,"surface":"天子","kind":"person","person_id":"y1h_fo3_brs","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m008-0026","start":26,"end":28,"surface":"韓說","kind":"person","person_id":"haa_dor_26n","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m008-0039","start":39,"end":43,"surface":"樓船將軍","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m008-0043","start":43,"end":45,"surface":"楊仆","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m008-0051","start":51,"end":54,"surface":"王溫舒","kind":"person","person_id":"0c3_ttl_f14","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m008-0061","start":61,"end":63,"surface":"戈船","kind":"person","person_id":"ys3_xrq_d6u","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m008-0064","start":64,"end":66,"surface":"下瀨","kind":"person","person_id":"905_rao_ff0","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m008-0096","start":96,"end":100,"surface":"徇北將軍","kind":"person","person_id":"u5g_scl_2bs","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m008-0105","start":105,"end":107,"surface":"樓船","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m008-0116","start":116,"end":120,"surface":"樓船將軍","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m008-0123","start":123,"end":126,"surface":"轅終古","kind":"person","person_id":"08e_bwz_ync","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m008-0127","start":127,"end":131,"surface":"徇北將軍","kind":"person","person_id":"u5g_scl_2bs","status":"contextual_provisional"}],"chapter_id":"c-shiji-114-dongyue","book_id":"b-shiji-114","work_id":"w-shiji","source_id":"s-shiji114-dongyue"},{"id":"c-shiji-114-dongyue:p010","text":"於是天子曰東越狹多阻，閩越悍，數反覆，詔軍吏皆將其民徙處江淮閒。東越地遂虛。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-114-dongyue:m010-0002","start":2,"end":4,"surface":"天子","kind":"person","person_id":"y1h_fo3_brs","status":"contextual_provisional"}],"chapter_id":"c-shiji-114-dongyue","book_id":"b-shiji-114","work_id":"w-shiji","source_id":"s-shiji114-dongyue"}],"sources":[{"chapter_id":"c-shiji-114-dongyue","work_id":"w-shiji","book_id":"b-shiji-114","source_id":"s-shiji114-dongyue","source":{"title":"史記／卷114","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷114","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷114&oldid=8735633","revision_id":8735633,"accessed_on":"2026-10-11","extent":"固定數位見證11段正文，沒有索隱述贊。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"去header2、現代節標題與YL模板外殼，紀年及正文原字保留，未核底本影像。","note":"太史公曰仍屬正文，未補此見證未載的索隱述贊。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical"}}
