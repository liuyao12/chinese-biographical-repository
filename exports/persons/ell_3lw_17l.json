sage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"3處獨立位置，3個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-sanguozhi-046-sun-jian-ws2629010"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-046-sun-jian:p018:m0215","surface":"祖茂","start":215,"end":217,"kind":"person","person_id":"ell_3lw_17l","status":"contextual_provisional","paragraph_id":"c-sanguozhi-046-sun-jian:p018","chapter_id":"c-sanguozhi-046-sun-jian"},{"id":"c-sanguozhi-046-sun-jian:p018:m0224","surface":"茂","start":224,"end":225,"kind":"person","person_id":"ell_3lw_17l","status":"contextual_provisional","paragraph_id":"c-sanguozhi-046-sun-jian:p018","chapter_id":"c-sanguozhi-046-sun-jian"},{"id":"c-sanguozhi-046-sun-jian:p018:m0234","surface":"茂","start":234,"end":235,"kind":"person","person_id":"ell_3lw_17l","status":"contextual_provisional","paragraph_id":"c-sanguozhi-046-sun-jian:p018","chapter_id":"c-sanguozhi-046-sun-jian"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-046-sun-jian:p018","text":"　　前到魯陽，與袁術相見。術表堅行破虜將軍，領豫州刺史。遂治兵於魯陽城。當進軍討卓，遣長史公仇稱將兵從事還州督促軍糧。施帳幔於城東門外，祖道送稱，官屬並會。卓遣歩騎數萬人逆堅，輕騎數十先到。堅方行酒談笑，敕部曲整頓行陳，無得妄動。後騎漸益，堅徐罷坐，導引入城。乃謂左右曰：「向堅所以不卽起者，恐兵相蹈藉，諸君不得入耳。」卓兵見堅士衆甚整，不敢攻城，乃引還。堅移屯梁東，大爲卓軍所攻，堅與數十騎潰圍而出。堅常著赤罽幘，乃脫幘令親近將祖茂著之。卓騎爭逐茂，故堅從間道得免。茂困迫，下馬，以幘冠塚閒燒柱，因伏草中。卓騎望見，圍繞數重，定近覺是柱，乃去。堅復相收兵，合戰於陽人，大破卓軍，梟其都督華雄等。是時，或間堅於術，術懷疑，不運軍糧。陽人去魯陽百餘里，堅夜馳見術，畫地計校，曰：「所以出身不顧，上爲國家討賊，下慰將軍家門之私仇。堅與卓非有骨肉之怨也，而將軍受譖潤之言，還相嫌疑！」術踧踖，卽調發軍糧。堅還屯。卓憚堅猛壯，乃遣將軍李傕等來求和親。令堅列疏子弟任刺史、郡守者，許表用之。堅曰：「卓逆天無道，蕩覆王室。今不夷汝三族，懸示四海，則吾死不瞑目。豈將與乃和親邪？」復進軍大谷。拒雒九十里。卓尋徙都西入關，焚燒雒邑。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":23,"last_line":23,"raw_start":6901,"raw_end":10769,"raw_character_offsets":[6901,6902,6903,6904,6925,6926,6931,6932,6953,6956,6963,6964,6965,6981,6986,7000,7003,7013,7014,7015,7016,7019,7020,7041,7042,7047,7048,7049,7050,7051,7052,7055,7071,7072,7075,7076,7077,7078,7079,7080,7094,7097,7098,7099,7100,7114,7115,7116,7119,7120,7121,7122,7123,7124,7125,7126,7127,7128,7129,7130,7131,7132,7135,7138,7139,7140,7141,7142,7143,7144,7145,7159,7162,7163,7164,7167,7170,7171,7185,7188,7189,7190,7191,7192,7193,7194,7208,7211,7212,7213,7214,7215,7216,7217,7218,7232,7235,7236,7237,7238,7239,7240,7241,7242,7243,7244,7245,7246,7247,7248,7249,7250,7251,7252,7253,7256,7259,7260,7261,7262,7276,7279,7280,7281,7282,7283,7284,7285,7286,7287,7288,7289,7290,7291,7292,7293,7294,7295,7309,7312,7313,7314,7317,7320,7321,7322,7323,7324,7325,7326,7327,7328,7329,7330,7331,7332,7333,7334,7335,7336,7350,7353,7354,7368,7371,7372,7373,7374,7375,7376,7377,7378,7379,7380,7381,7382,7383,7384,8035,8038,8039,8053,8056,8057,8058,8059,8073,8076,8077,8078,8079,8093,8096,8097,8098,8099,8100,8101,8102,8103,8104,8118,8121,8122,8123,8124,8125,8126,8127,8128,8129,8130,8131,8132,8133,8154,8155,8160,8161,8162,8176,8179,8180,8181,8195,8198,8199,8213,8216,8217,8218,8219,8220,8221,8235,8238,8239,8240,8241,8242,8243,8244,8245,8246,8247,8248,8249,8250,8251,8252,8253,8254,8255,8256,8270,8273,8274,8275,8276,8277,8278,8279,8280,8281,8282,8283,8284,8285,8286,8287,8288,8289,8290,8304,8307,8308,8309,8310,8311,8312,8313,8316,8339,8340,8345,8346,8347,8361,8364,8365,8366,8367