gyi-family:line033:m0141"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-072-guopu-ws2595548","s-jinshu-076-wangyi-family"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-072-guopu:p001:m0153","surface":"管輅","start":153,"end":155,"person_id":"r7r_kq9_iap","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-072-guopu:p001","chapter_id":"c-jinshu-072-guopu"},{"id":"c-jinshu-076-wangyi-family:line033:m0141","start":141,"end":143,"surface":"管輅","kind":"person","person_id":"r7r_kq9_iap","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-076-wangyi-family:line033","chapter_id":"c-jinshu-076-wangyi-family"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-072-guopu:p001","text":"郭璞，字景純，河東聞喜人也。父瑗，尚書都令史。時尚書杜預有所增損，瑗多駁正之，以公方著稱。終於建平太守。璞好經術，博學有高才，而訥於言論，詞賦為中興之冠。好古文奇字，妙於陰陽算曆。有郭公者，客居河東，精于卜筮，璞從之受業。公以《青囊中書》九卷與之，由是遂洞五行、天文、卜筮之術，攘災轉禍，通致無方，雖京房、管輅不能過也。璞門人趙載嘗竊《青襄書》，未及讀，而為火所焚。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":10,"last_line":10,"raw_start":169,"raw_end":352,"raw_character_offsets":[169,170,171,172,173,174,175,176,177,178,179,180,181,182,183,184,185,186,187,188,189,190,191,192,193,194,195,196,197,198,199,200,201,202,203,204,205,206,207,208,209,210,211,212,213,214,215,216,217,218,219,220,221,222,223,224,225,226,227,228,229,230,231,232,233,234,235,236,237,238,239,240,241,242,243,244,245,246,247,248,249,250,251,252,253,254,255,256,257,258,259,260,261,262,263,264,265,266,267,268,269,270,271,272,273,274,275,276,277,278,279,280,281,282,283,284,285,286,287,288,289,290,291,292,293,294,295,296,297,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,318,319,320,321,322,323,324,325,326,327,328,329,330,331,332,333,334,335,336,337,338,339,340,341,342,343,344,345,346,347,348,349,350,351],"revision_id":2595548},"mentions":[{"id":"c-jinshu-072-guopu:p001:m0000","surface":"郭璞","start":0,"end":2,"person_id":"2i5_4eo_tve","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-072-guopu:p001:m0015","surface":"瑗","start":15,"end":16,"person_id":"f1g_lsv_jzc","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-072-guopu:p001:m0026","surface":"杜預","start":26,"end":28,"person_id":"yh6_z1j_fsd","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-072-guopu:p001:m0091","surface":"郭公","start":91,"end":93,"person_id":"ius_q75_ooi","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-072-guopu:p001:m0150","surface":"京房","start":150,"end":152,"person_id":"s4d_48y_jxn","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-072-guopu:p001:m0153","surface":"管輅","start":153,"end":155,"person_id":"r7r_kq9_iap","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-072-guopu:p001:m0163","surface":"趙載","start":163,"end":165,"person_id":"ftr_qk4_3r9","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-072-guopu","book_id":"b-jinshu-072","work_id":"w-jinshu","source_id":"s-jinshu-072-guopu-ws2595548"},{"id":"c-jinshu-076-wangyi-family:line033","text":"又臣昔嘗侍於先後，說陛下誕育之日，光明映室，白毫生於額之左，相者謂當王有四海。又臣以壬申歲見用為鄱陽內史，七月，四星聚於牽牛。又臣郡有枯樟更生。及臣後還京都，陛下見臣白兔，命臣作賦。時琅邪郡又獻甘露，陛下命臣嘗之。又驃騎將軍導向臣說晉陵有金鐸之瑞，郭璞雲必致中興。璞之爻筮，雖京房、管輅不過也。明天之歷數在陛下矣。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-076-wangyi-family:line033:u0006","start":6,"end":8,"surface":"先後","kind":"unresolved","person_id":null,"status":"unresolved","unresolved_kind":"source_variant_identity","interpretation_note":"殿本先后，憶元帝生時，與元夏侯太妃本傳對讀；本疏此處無名，與王廙自言老母分列。"},{"id":"c-jinshu-076-wangyi-family:line033:m0112","start":112,"end":113,"surface":"導","kind":"person","person_id":"7r6_k52_qji_ABAA","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-076-wangyi-family:line033:m0124","start":124,"end":126,"surface":"郭璞","kind":"person","person_id":"2i5_4eo_tve","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-076-wangyi-family:line033:m0132","start":132,"end":133,"surface":"璞","kind":"person","person_id":"2i5_4eo_tve","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-076-wangyi-family:line033:m0138","start":138,"end":140,"surface":"京房","kind":"person","person_id":"s4d_48y_jxn","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-076-wangyi-family:line033:m0141","start":141,"end":143,"surface":"管輅","kind":"person","person_id":"r7r_kq9_iap","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"source_position":{"first_line":33,"last_line":33,"raw_start":2354,"raw_end":2511,"revision_id":2180533},"chapter_id":"c-jinshu-076-wangyi-family","book_id":"b-jinshu-076","work_id":"w-jinshu","source_id":"s-jinshu-076-wangyi-family"}],"sources":[{"chapter_id":"c-jinshu-072-guopu","work_id":"w-jinshu","book_id":"b-jinshu-072","source_id":"s-jinshu-072-guopu-ws2595548","source":{"title":"晉書卷七十二·郭璞","provider":"Wikisource","permalink":"https://zh.wikisource.org/w/index.php?oldid=2595548","url":"https://zh.wikisource.org/w/index.php?oldid=2595548","revision_id":2595548,"edition":"維基文庫固定修訂","accessed_on":"2026-11-22","review_status":"text_checked","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫授權。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","extent":"晉書卷七十二·郭璞","text_scope":"complete_biography_unit","raw_path":"source-evidence/jin072-roll/ws2595548.wikitext","raw_file_sha256":"4fa157e9f49821ae870d4ba23cf9f1254be040fd709d9407ae6f515187a6fc44","collation_witnesses":["source-evidence/jin072-roll/volume-reading.json"]}},{"chapter_id":"c-jinshu-076-wangyi-family","work_id":"w-jinshu","book_id":"b-jinshu-076","source_id":"s-jinshu-076-wangyi-family","source":{"title":"《晉書》卷七十六（數位選錄）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7076&oldid=2180533","permalink":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7076&oldid=2180533","revision_id":2180533,"accessed_on":"2026-10-18","extent":"王廙題自第27至43行全文，含中興賦疏與附敘子孫。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，未親核底本影像","response_sha256":"c6c7c41bf93c491f6f69b058ecc493e979d65f3e65397d20055284f2e829cd30","wikitext_sha256":"872701db949f6f58ea6f183425617dfa82353177d2cc026037bfad953a60cd71","normalization":{"character_conversion":{},"extraction_note":"去首部空白，宋書ref校勘記另存，正文原字不改；不補平南將領的疑缺字。","excerpts":[{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:p001","source_lines":[27,28],"raw_quote":"王廙，字世將，丞相導從弟，而元帝姨弟也。父正，尚書郎。廙少能屬文，多所通涉，工書畫，善音樂、射御、博弈、雜伎。辟太傅掾，轉參軍。豫迎大駕，封武陵縣侯，拜尚書郎，出為濮陽太守。元帝作鎮江左，廙棄郡過江。帝見之大悅，以為司馬。頻守廬江、鄱陽二郡。豫討周馥、杜韜，以功累增封邑，除冠軍將軍，鎮石頭，領丞相軍諮祭酒。王敦啟為甯遠將軍、荊州刺史。","raw_quote_sha256":"8147d33d3202efaa1adf4a1c6aa137d71d239827b11033011846a53f38708001","selected_text_sha256":"8147d33d3202efaa1adf4a1c6aa137d71d239827b11033011846a53f38708001","begin_anchor":"王廙，字世將，丞相導從弟，而元","end_anchor":"。王敦啟為甯遠將軍、荊州刺史。"},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:line029","source_lines":[29,29],"raw_quote":"及帝即位，廙奏《中興賦》，上疏曰：","raw_quote_sha256":"561a1b9943833462648e1a80c82c5b21545b67f168b95ab6fcd1b0b706c38cb3","begin_anchor":"及帝即位，廙奏《中興賦》，上","end_anchor":"位，廙奏《中興賦》，上疏曰："},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:line031","source_lines":[31,31],"raw_quote":"{{quote|臣托備肺腑，幼蒙洪潤，愛自齠齔，至於弱冠，陛下之所撫育，恩侔于兄弟，義同于交友，思欲攀龍鱗附鳳翼者，有年矣，是以昔忝濮陽，棄官遠跡，扶持老母，攜將細弱，越長江歸陛下者，誠以道之所存，願託餘廕故也。天誘其願，遇陛下中興，當大明之盛，而守局遐外，不得奉瞻大禮，聞問之日，悲喜交集。昔司馬相如不得睹封禪之事，慷慨發憤，況臣情則骨肉，服膺聖化哉！","raw_quote_sha256":"9c582a92a469b985f92ae4aa27b0923109fe382bfd152e7e946d5908dd879e1b","begin_anchor":"臣托備肺腑，幼蒙洪潤，愛自齠","end_anchor":"，況臣情則骨肉，服膺聖化哉！"},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:line033","source_lines":[33,33],"raw_quote":"又臣昔嘗侍於先後，說陛下誕育之日，光明映室，白毫生於額之左，相者謂當王有四海。又臣以壬申歲見用為鄱陽內史，七月，四星聚於牽牛。又臣郡有枯樟更生。及臣後還京都，陛下見臣白兔，命臣作賦。時琅邪郡又獻甘露，陛下命臣嘗之。又驃騎將軍導向臣說晉陵有金鐸之瑞，郭璞雲必致中興。璞之爻筮，雖京房、管輅不過也。明天之歷數在陛下矣。","raw_quote_sha256":"bcbf3609e16aec908eb74b7bbfdb2b537098914823eeadaa9c2c2a2584c5535e","begin_anchor":"又臣昔嘗侍於先後，說陛下誕育","end_anchor":"不過也。明天之歷數在陛下矣。"},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:line035","source_lines":[35,35],"raw_quote":"臣少好文學，志在史籍，而飄放遐外，嘗與桀寇為對。臣犬馬之年四十三矣，未能上報天施，而愆負屢彰。恐先朝露，填溝壑，令微情不得上達，謹竭其頑，獻《[[中興賦]]》一篇。雖未雖以宣揚盛美，亦是詩人嗟歎詠歌之義也。}}","raw_quote_sha256":"13767a378d657e26ab2c4bdf3c61b8cc9d445b23d36464fb24b1a9c385026fda","begin_anchor":"臣少好文學，志在史籍，而飄放","end_anchor":"美，亦是詩人嗟歎詠歌之義也。"},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:line037","source_lines":[37,37],"raw_quote":"文多不載。","raw_quote_sha256":"3cec09c8474251e248ac71bdc8dc6bf63032579c75e9016438e0480dd0821c80","begin_anchor":"文多不載。","end_anchor":"文多不載。"},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:p002","source_lines":[39,40],"raw_quote":"初，王敦左遷陶侃，使廙代為荊州。將吏馬俊、鄭攀等上書請留侃，敦不許。廙為俊等所襲，奔于江安。賊杜曾與俊、攀北迎第五猗以距廙。廙督諸軍討曾，又為曾所敗。敦命湘州刺史甘卓、豫章太守周廣等助廙擊曾，曾衆潰，廙得到州。廙性俊率，嘗從南下，旦自尋陽，迅風飛帆，暮至都，倚舫樓長嘯，神氣甚逸。王導謂庾亮曰：「世將為傷時識事。」亮曰：「正足舒其逸氣耳。」廙在州大誅戮侃時將佐，及征士皇甫方回，於是大失荊土之望，人情乖阻。帝乃征廙為輔國將軍，加散騎常侍。以母喪去職。服闋，拜征虜將軍，進左衛將軍。","raw_quote_sha256":"713e46789dcf7fe1c521542418159b142d29f81e58c3e6357597be46caf9c662","selected_text_sha256":"713e46789dcf7fe1c521542418159b142d29f81e58c3e6357597be46caf9c662","begin_anchor":"初，王敦左遷陶侃，使廙代為荊州","end_anchor":"服闋，拜征虜將軍，進左衛將軍。"},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:p003","source_lines":[41,42],"raw_quote":"及王敦構禍，帝遣廙喻敦，既不能諫其悖逆，乃為敦所留，受任助亂。敦得志，以廙為平南將領護南蠻校尉、荊州刺史。尋病卒。帝猶以親故，深痛湣之。喪還京都，皇太子親臨拜柩，如家人之禮。贈侍中、驃騎將軍，諡曰康。明帝與大將軍溫嶠書曰：「痛謝鯤未絕於口，世將復至於此。並盛年雋才，不遂其志，痛切於心。廙明古多通，鯤遠有識致。其言雖未足令人改聽，然味之不倦，近未易有也。坐相視盡，如何！」","raw_quote_sha256":"b2c8c3b975ba6ac7732d8b4a11f0ec1be353f9f1fb577963a649d9140d52c2bb","selected_text_sha256":"b2c8c3b975ba6ac7732d8b4a11f0ec1be353f9f1fb577963a649d9140d52c2bb","begin_anchor":"及王敦構禍，帝遣廙喻敦，既不能","end_anchor":"近未易有也。坐相視盡，如何！」"},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:p004","source_lines":[43,44],"raw_quote":"子頤之嗣，仕至東海內史。頤之弟胡之，字修齡，弱冠有聲譽，歷郡守、侍中、丹陽尹。素有風眩疾，發動甚數，而神明不損。石季龍死，朝廷欲綏輯河洛，以胡之為西中郎將、司州刺史、假節，以疾固辭，未行而卒。子茂之亦有美譽，官至晉陵太守。子敬弘，義熙末為尚書。","raw_quote_sha256":"07b3bbc4071f24625a64510a17080b7ab063923ca9f6d5febeb0893dfefef0c6","selected_text_sha256":"07b3bbc4071f24625a64510a17080b7ab063923ca9f6d5febeb0893dfefef0c6","begin_anchor":"子頤之嗣，仕至東海內史。頤之弟","end_anchor":"陵太守。子敬弘，義熙末為尚書。"}]},"raw_path":"source-evidence/jin079-lang-zhong-xuan-dai/external/jin076-ws2180533.wikitext","raw_file_sha256":"872701db949f6f58ea6f183425617dfa82353177d2cc026037bfad953a60cd71"}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true}}
