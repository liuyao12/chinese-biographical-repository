cts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"id":"name-jin043-wyd-luan-literal","person_id":"yo9_y4b_3vn","surname":"呂","ming":"安","hao":null,"title":null,"additional_names":[],"chapter_id":"c-jinshu-043-wyd1739-shantao","paragraph_id":"c-jinshu-043-wyd1739-shantao:p001","person_mention_id":"c-jinshu-043-wyd1739-shantao:p001:m0040","source_anchor":{"start":40,"end":42,"surface":"呂安"},"quote":"山濤字巨源河內懷人也父曜宛句令濤早孤居貧少有器量介然不羣性好莊老每隱身自晦與嵇康呂安善後遇阮籍便為竹林之遊著忘言之契康後坐事臨誅謂子紹曰巨源在汝不孤矣濤年四十始為郡主簿功曹上計掾舉孝廉州辟部河南從事與石鑒共宿濤夜起蹴鑒曰今為何等時而眠邪知太傅卧何意鑒曰","status":"editorial_provisional","human_reviewed":false,"model":null,"work_id":"w-jinshu","book_id":"b-jinshu-043","source_id":"s-jinshu-043-wyd1739-shantao"},{"id":"nc-jin049-literal-luan","person_id":"yo9_y4b_3vn","title":null,"surname":"呂","ming":"安","additional_names":[],"work_id":"w-jinshu","book_id":"b-jinshu-049","chapter_id":"c-jinshu-049-jikang-rendered-comparison","source_id":"s-jinshu049-jikang-web-rendered-comparison","paragraph_id":"c-jinshu-049-jikang-rendered-comparison:p010","person_mention_id":"c-jinshu-049-jikang-rendered-comparison:p010:m0047","quote":"此書既行，知其不可羈屈也。性絶巧而好鍛。宅中有一柳樹甚茂，乃激水圜之，毎夏月，居其下以鍛。東平呂安服康髙致，毎一相思，輙千里命駕，康友而善之。後安爲兄所枉訴，以事繫獄，辭相證引，遂復收康。康性愼言行，一旦縲紲，乃作《幽憤詩》，曰：","status":"editorial_provisional","human_reviewed":false,"model":null,"note":"本地web-rendered比較擷取，非固定原raw／武英殿；明文姓名手工分欄。"}],"life_events":[{"id":"le-jin049-luan-death","person_id":"yo9_y4b_3vn","event_type":"death","status":"source_attested","date_expression":null,"source_term":"遂并害之","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-049","source_id":"s-jinshu049-jikang-web-rendered-comparison","chapter_id":"c-jinshu-049-jikang-rendered-comparison","paragraph_id":"c-jinshu-049-jikang-rendered-comparison:p015","person_mention_id":"c-jinshu-049-jikang-rendered-comparison:p015:m0179","quote":"初，康居貧，嘗與向秀共鍛於大樹之下，以自贍給。潁川鍾會，貴公子也，精練有才辯，故往造焉。康不爲之禮，而鍛不輟。良久會去，康謂曰：「何所聞而來？何所見而去？」會曰：「聞所聞而來，見所見而去。」會以此憾之。及是，言于文帝曰：「嵇康，臥龍也，不可起。公無憂天下，顧以康爲慮耳。」因譖「康欲助毌丘儉，賴山濤不聽。昔齊戮華士，魯誅少正卯，誠以害時亂教，故聖賢去之。康、安等言論放蕩，非毀典謨，帝王者所不宜容。宜因釁除之，以淳風俗」。帝既昵聽信會，遂并害之。"}],"interpretation_note":"本傳p015會向文帝譖康、安後帝并害之；康p016續敘刑東市及報齡。無本源年號或數字卒年，不以死亡結束官爵，不把失歡作母兄死亡。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-jinshu-043-wyd1739-shantao:p001:m0040","start":40,"end":42,"surface":"呂安","kind":"person","person_id":"yo9_y4b_3vn","status":"contextual_provisional","resolution_note":"固定完整山濤單元逐處語境角色；原字、時層、引語主客與來源限定見本源role ledger。","paragraph_id":"c-jinshu-043-wyd1739-shantao:p001","chapter_id":"c-jinshu-043-wyd1739-shantao"},{"id":"c-jinshu-049-jikang-rendered-comparison:p010:m0047","start":47,"end":49,"surface":"呂安","kind":"person","person_id":"yo9_y4b_3vn","status":"contextual_provisional","role_key":"luan","source_scope":"received_biographical_narration","paragraph_id":"c-jinshu-049-jikang-rendered-comparison:p010","chapter_id":"c-jinshu-049-jikang-rendered-comparison"},{"id":"c-jinshu-049-jikang-rendered-comparison:p010:m0072","start":72,"end":73,"surface":"安","kind":"person","person_id":"yo9_y4b_3vn","status":"contextual_provisional","role_key":"luan","source_scope":"received_biographical_narration","paragraph_id":"c-jinshu-049-jikang-rendered-comparison:p010","chapter_id":"c-jinshu-049-jikang-rendered-comparison"},{"id":"c-jinshu-049-jikang-rendered-comparison:p015:m0179","start":179,"end":180,"surface":"安","kind":"person","person_id":"yo9_y4b_3vn","status":"contextual_provisional","role_key":"luan","source_scope":"received_biographical_narration","paragraph_id":"c-jinshu-049-jikang-rendered-comparison:p015","chapter_id":"c-jinshu-049-jikang-rendered-comparison"}],"relations":[{"id":"a-jin049-luan-brother","subject_person_id":"yo9_y4b_3vn","predicate":"brother","object_person_id":"f4x_gd1_zdw","status":"source_attested","qualifiers":{"source_term":"後安爲兄所枉訴","relative_birth_order":{"older_person_id":"f4x_gd1_zdw","younger_person_id":"yo9_y4b_3vn","operator":"lt","older_ordinal":null,"younger_ordinal":null,"scope":"sibl