on","person_id":"l9e_fbr_36a","status":"contextual_provisional"},{"id":"c-shiji-045-han:m024-0040","start":40,"end":42,"surface":"襄王","kind":"person","person_id":"l9e_fbr_36a","status":"contextual_provisional"}],"chapter_id":"c-shiji-045-han","book_id":"b-shiji-045","work_id":"w-shiji","source_id":"s-shiji-045-han"},{"id":"c-shiji-045-han:p025","text":"襄王四年，與秦武王會臨晉。其秋，秦使甘茂攻我宜陽。五年，秦拔我宜陽，斬首六萬。秦武王卒。六年，秦復與我武遂。九年，秦復取我武遂。十年，太子嬰朝秦而歸。十一年，秦伐我，取穰。與秦伐楚，敗楚將唐眛。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-045-han:m025-0000","start":0,"end":2,"surface":"襄王","kind":"person","person_id":"l9e_fbr_36a","status":"contextual_provisional"},{"id":"c-shiji-045-han:m025-0006","start":6,"end":9,"surface":"秦武王","kind":"person","person_id":"uxa_zs4_qpz","status":"contextual_provisional"},{"id":"c-shiji-045-han:m025-0018","start":18,"end":20,"surface":"甘茂","kind":"person","person_id":"fqw_nka_rjt","status":"contextual_provisional"},{"id":"c-shiji-045-han:m025-0039","start":39,"end":42,"surface":"秦武王","kind":"person","person_id":"uxa_zs4_qpz","status":"contextual_provisional"},{"id":"c-shiji-045-han:m025-0067","start":67,"end":70,"surface":"太子嬰","kind":"person","person_id":"r6c_fbu_uos","status":"contextual_provisional"},{"id":"c-shiji-045-han:m025-0094","start":94,"end":96,"surface":"唐眛","kind":"person","person_id":"tbv_g3c_03d","status":"contextual_provisional"}],"chapter_id":"c-shiji-045-han","book_id":"b-shiji-045","work_id":"w-shiji","source_id":"s-shiji-045-han"},{"id":"c-shiji-045-han:p029","text":"十四年，與齊、魏王共撃秦，至函谷而軍焉。十六年，秦與我河外及武遂。襄王卒，太子咎立，是爲釐王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-045-han:m029-0005","start":5,"end":9,"surface":"齊、魏王","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱、對話指代或未名者保留；當前與引語回敘秦王不預接，爭太子不作已授太子，大業不先定祖名。"},{"id":"c-shiji-045-han:m029-0033","start":33,"end":35,"surface":"襄王","kind":"person","person_id":"l9e_fbr_36a","status":"contextual_provisional"},{"id":"c-shiji-045-han:m029-0037","start":37,"end":40,"surface":"太子咎","kind":"person","person_id":"c0i_eah_y59","status":"contextual_provisional"},{"id":"c-shiji-045-han:m029-0044","start":44,"end":46,"surface":"釐王","kind":"person","person_id":"c0i_eah_y59","status":"contextual_provisional"}],"chapter_id":"c-shiji-045-han","book_id":"b-shiji-045","work_id":"w-shiji","source_id":"s-shiji-045-han"},{"id":"c-shiji-093-hanlu:p001","text":"韓王信者，故韓襄王孽孫也，長八尺五寸。及項梁之立楚後懷王也，燕、齊、趙、魏皆已前王，唯韓無有後，故立韓諸公子橫陽君成為韓王，欲以撫定韓故地。項梁敗死定陶，成奔懷王。沛公引兵擊陽城，使張良以韓司徒降下韓故地，得信，以為韓將，將其兵從沛公入武關。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-093-hanlu:m001-0000","start":0,"end":3,"surface":"韓王信","kind":"person","person_id":"l9e_fbr_36a_*A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m001-0006","start":6,"end":9,"surface":"韓襄王","kind":"person","person_id":"l9e_fbr_36a","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m001-0020","start":20,"end":22,"surface":"項梁","kind":"person","person_id":"5xt_rg8_7zs_A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m001-0026","start":26,"end":28,"surface":"懷王","kind":"person","person_id":"c2w_s7g_en0_*A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m001-0054","start":54,"end":58,"surface":"橫陽君成","kind":"person","person_id":"8i3_5vf_iu9","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m001-0070","start":70,"end":72,"surface":"項梁","kind":"person","person_id":"5xt_rg8_7zs_A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m001-0077","start":77,"end":78,"surface":"成","kind":"person","person_id":"8i3_5vf_iu9","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m001-0079","start":79,"end":81,"surface":"懷王","kind":"person","person_id":"c2w_s7g_en0_*A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m001-0082","start":82,"end":84,"surface":"沛公","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m001-0091","start":91,"end":93,"surface":"張良","kind":"person","person_id":"ea5_zvr_hlp","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m001-0104","start":104,"end":105,"surface":"信","kind":"person","person_id":"l9e_fbr_36a_*A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m001-0115","start":115,"end":117,"surface":"沛公","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-093-hanlu","book_id":"b-shiji-093","work_id":"w-shiji","source_id":"s-shiji-093-hanlu"},{"id":"c-shiji-093-hanlu:p021","text":"【索隱述贊】韓襄遺孽，始從漢中。剖符南面，徙邑北通。穨當歸國，龍雒有功。盧綰親愛，群臣莫同。舊燕是王，東胡計窮。","annotation_status":"named_mentions_first_pass","text_layer":"witness_appended_suoyin_zan","mentions":[{"id":"c-shiji-093-hanlu:m021-0006","start":6,"end":8,"surface":"韓襄","kind":"person","person_id":"l9e_fbr_36a","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m021-0026","start":26,"end":28,"surface":"穨當","kind":"person","person_id":"l9e_fbr_36a_*AB","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m021-0036","start":36,"end":38,"surface":"盧綰","kind":"person","person_id":"jjl_irg_zke_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-093-hanlu","book_id":"b-shiji-093","work_id":"w-shiji","source_id":"s-shiji-093-hanlu"}],"table_passages":[{"id":"shiji-015-r166-c04","column":4,"rowspan":1,"colspan":1,"text":"韓襄王元年","source_row":167,"source_column":5,"printed_page":null,"person_mentions":[{"id":"shiji-015-r166-c04-m000","start":0,"end":3,"surface":"韓襄王","person_id":"l9e_fbr_36a","status":"contextual_provisional","interpretation_note":"依國別、紀年及原格上下文暫定；保留異文，不據同名自動合併。"}],"table_id":"shiji-015","table_fragment_id":"shiji-015-digital-table-1","table_row_id":"shiji-015-r166","table_cell_id":"shiji-015-r166-c04","work_id":"w-shiji","book_id":"b-shiji-015","chapter_id":"table-chapter-shiji-015","source_id":"table-witness-shiji-015","source_revision":"2607002