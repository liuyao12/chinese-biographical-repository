equired":false},"family_paths":[],"mentions":[{"id":"c-jinshu-064-simadaozi:p005:m0165","surface":"戴良夫","start":165,"end":168,"person_id":"wnv_5ga_iim","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-064-simadaozi:p005","chapter_id":"c-jinshu-064-simadaozi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-064-simadaozi:p005","text":"又道子既為皇太妃所愛，親遇同家人之禮，遂恃寵乘酒，時失禮敬。帝益不能平，然乙太妃之故，加崇禮秩。博平令吳興聞人奭上疏曰：「驃騎諮議參軍茹千秋協輔宰相，起自微賤，竊弄威權，衒賣天官。其子壽齡為樂安令，贓私狼藉，畏法奔逃，竟無罪罰，傲然還縣。又尼姏屬類，傾動亂時。穀賤人饑，流殣不絕，由百姓單貧，役調深刻。又振武將軍庾恆鳴角京邑，主簿戴良夫苦諫被囚，殆至沒命。而恆以醉酒見怒，良夫以執忠廢棄。又權寵之臣，各開小府，施置吏佐，無益於官，有損于國。」疏奏，帝益不平，而逼於太妃，無所廢黜，乃出王恭為兗州，殷仲堪為荊州，王珣為僕射，王雅為太子少傳，以張王室，而潛制道子也。道子復委任王緒，由是朋黨競扇，友愛道盡。太妃每和解之，而道子不能改。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":121,"last_line":121,"raw_start":8801,"raw_end":9118,"raw_character_offsets":[8803,8804,8805,8806,8807,8808,8809,8810,8811,8812,8813,8814,8815,8816,8817,8818,8819,8820,8821,8822,8823,8824,8825,8826,8827,8828,8829,8830,8831,8832,8833,8834,8835,8836,8837,8838,8839,8840,8841,8842,8843,8844,8845,8846,8847,8848,8849,8850,8851,8852,8853,8854,8855,8856,8857,8858,8859,8860,8861,8862,8863,8864,8865,8866,8867,8868,8869,8870,8871,8872,8873,8874,8875,8876,8877,8878,8879,8880,8881,8882,8883,8884,8885,8886,8887,8888,8889,8890,8891,8892,8893,8894,8895,8896,8897,8898,8899,8900,8901,8902,8903,8904,8905,8906,8907,8908,8909,8910,8911,8912,8913,8914,8915,8916,8917,8918,8919,8920,8921,8922,8923,8924,8925,8926,8927,8928,8929,8930,8931,8932,8933,8934,8935,8936,8937,8938,8939,8940,8941,8942,8943,8944,8945,8946,8947,8948,8949,8950,8951,8952,8953,8954,8955,8956,8957,8958,8959,8960,8961,8962,8963,8964,8965,8966,8967,8968,8969,8970,8971,8972,8973,8974,8975,8976,8977,8978,8979,8980,8981,8982,8983,8984,8985,8986,8987,8988,8989,8990,89