ention_count":3,"duplicate_mention_count":0,"paragraph_occurrence_count":3,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"3處獨立位置，3個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-034-ws2567662-yanghu"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-034-yanghu:p011:m0043","start":43,"end":45,"surface":"楊肇","kind":"person","person_id":"al6_uk3_5ci","status":"source_explicit","paragraph_id":"c-jinshu-034-yanghu:p011","chapter_id":"c-jinshu-034-yanghu"},{"id":"c-jinshu-034-yanghu:p011:m0092","start":92,"end":94,"surface":"楊肇","kind":"person","person_id":"al6_uk3_5ci","status":"source_explicit","paragraph_id":"c-jinshu-034-yanghu:p011","chapter_id":"c-jinshu-034-yanghu"},{"id":"c-jinshu-034-yanghu:p011:m0140","start":140,"end":142,"surface":"楊肇","kind":"person","person_id":"al6_uk3_5ci","status":"source_explicit","paragraph_id":"c-jinshu-034-yanghu:p011","chapter_id":"c-jinshu-034-yanghu"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-034-yanghu:p011","text":"及還鎮，吳西陵督步闡舉城來降。吳將陸抗攻之甚急，詔祜迎闡。祜率兵五萬出江陵，遣荊州刺史楊肇攻抗，不克，闡竟為抗所擒。有司奏：「祜所統八萬餘人，賊眾不過三萬。祜頓兵江陵，使賊備得設。乃遣楊肇偏軍入險，兵少糧懸，軍人挫衄。背違詔命，無大臣節。可免官，以侯就第。」竟坐貶為平南將軍，而免楊肇為庶人。","text_layer":"received_chapter","source_position":{"raw_start":1784,"raw_end":1932,"raw_character_offsets":[1786,1787,1788,1789,1790,1791,1792,1793,1794,1795,1796,1797,1798,1799,1800,1801,1802,1803,1804,1805,1806,1807,1808,1809,1810,1811,1812,1813,1814,1815,1816,1817,1818,1819,1820,1821,1822,1823,1824,1825,1826,1827,1828,1829,1830,1831,1832,1833,1834,1835,1836,1837,1838,1839,1840,1841,1842,1843,1844,1845,1846,1847,1848,1849,1850,1851,1852,1853,1854,1855,1856,1857,1858,1859,1860,1861,1862,1863,1864,1865,1866,1867,1868,1869,1870,1871,1872,1873,1874,1875,1876,1877,1878,1879,1880,1881,1882,1883,1884,1885,1886,1887,1888,1889,1890,1891,1892,1893,1894,1895,1896,1897,1898,1899,1900,1901,1902,1903,1904,1905,1906,1907,1908,1909,1910,1911,1912,1913,1914,1915,1916,1917,1918,1919,1920,1921,1922,1923,1924,1925,1926,1927,1928,1929,1930,1931],"first_line":30,"last_line":30,"revision_id":2567662,"projection_sha256":"dcea3ac3541b109ded4c550f332033a96b75523a8777128080d4c6822ed6fc14","source_layer":"received_biography","editorial_subsection":" [[作者:羊祜|羊祜]] ","quotation_block_markup":false},"mentions":[{"id":"c-jinshu-034-yanghu:p011:m0008","start":8,"end":10,"surface":"步闡","kind":"person","person_id":"ef9_cad_60f","status":"source_explicit"},{"id":"c-jinshu-034-yanghu:p011:m0017","start":17,"end":19,"surface":"陸抗","kind":"person","person_id":"sg1_98i_aw9","status":"source_explicit"},{"id":"c-jinshu-034-yanghu:p011:m0025","start":25,"end":26,"surface":"祜","kind":"person","person_id":"dqd_5q9_pkz_BD","status":"contextual"},{"id":"c-jinshu-034-yanghu:p011:m0027","start":27,"end":28,"surface":"闡","kind":"person","person_id":"ef9_cad_60f","status":"contextual"},{"id":"c-jinshu-034-yanghu:p011:m0029","start":29,"end":30,"surface":"祜","kind":"person","person_id":"dqd_5q9_pkz_BD","status":"contextual"},{"id":"c-jinshu-034-yanghu:p011:m0043","start":43,"end":45,"surface":"楊肇","kind":"person","person_id":"al6_uk3_5ci","status":"source_explici