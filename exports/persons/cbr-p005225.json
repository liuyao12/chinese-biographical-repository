surface":"沛公","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m007-0212","start":212,"end":214,"surface":"項羽","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m007-0239","start":239,"end":241,"surface":"李由","kind":"person","person_id":"cbr-p000670","status":"contextual_provisional"}],"chapter_id":"c-shiji-007-xiangyu","book_id":"b-shiji-007","work_id":"w-shiji","source_id":"s-shiji-007-xiangyu"},{"id":"c-shiji-094-tiandan:p001","text":"田儋者，狄人也，故齊王田氏族也。儋從弟田榮，榮弟田橫，皆豪，宗彊，能得人。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-094-tiandan:m001-0000","start":0,"end":2,"surface":"田儋","kind":"person","person_id":"cbr-p005225","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m001-0016","start":16,"end":17,"surface":"儋","kind":"person","person_id":"cbr-p005225","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m001-0019","start":19,"end":21,"surface":"田榮","kind":"person","person_id":"cbr-p005226","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m001-0022","start":22,"end":23,"surface":"榮","kind":"person","person_id":"cbr-p005226","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m001-0024","start":24,"end":26,"surface":"田橫","kind":"person","person_id":"cbr-p005227","status":"contextual_provisional"}],"chapter_id":"c-shiji-094-tiandan","book_id":"b-shiji-094","work_id":"w-shiji","source_id":"s-shiji-094-tiandan"},{"id":"c-shiji-094-tiandan:p002","text":"陳涉之初起王楚也，使周市略定魏地，北至狄，狄城守。田儋詳為縛其奴，從少年之廷，欲謁殺奴。見狄令，因擊殺令，而召豪吏子弟曰：「諸侯皆反秦自立，齊，古之建國，儋，田氏，當王。」遂自立為齊王，發兵以擊周市。周市軍還去，田儋因率兵東略定齊地。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-094-tiandan:m002-0000","start":0,"end":2,"surface":"陳涉","kind":"person","person_id":"cbr-p005228","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m002-0010","start":10,"end":12,"surface":"周市","kind":"person","person_id":"cbr-p005229","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m002-0025","start":25,"end":27,"surface":"田儋","kind":"person","person_id":"cbr-p005225","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m002-0031","start":31,"end":32,"surface":"奴","kind":"person","person_id":"cbr-p005248","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m002-0042","start":42,"end":43,"surface":"奴","kind":"person","person_id":"cbr-p005248","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m002-0045","start":45,"end":47,"surface":"狄令","kind":"person","person_id":"cbr-p005249","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m002-0051","start":51,"end":52,"surface":"令","kind":"person","person_id":"cbr-p005249","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m002-0077","start":77,"end":78,"surface":"儋","kind":"person","person_id":"cbr-p005225","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m002-0097","start":97,"end":99,"surface":"周市","kind":"person","person_id":"cbr-p005229","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m002-0100","start":100,"end":102,"surface":"周市","kind":"person","person_id":"cbr-p005229","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m002-0106","start":106,"end":108,"surface":"田儋","kind":"person","person_id":"cbr-p005225","status":"contextual_provisional"}],"chapter_id":"c-shiji-094-tiandan","book_id":"b-shiji-094","work_id":"w-shiji","source_id":"s-shiji-094-tiandan"},{"id":"c-shiji-094-tiandan:p003","text":"秦將章邯圍魏王咎於臨濟，急。魏王請救於齊，齊王田儋將兵救魏。章邯夜銜枚擊，大破齊、魏軍，殺田儋於臨濟下。儋弟田榮收儋餘兵東走東阿。齊人聞王田儋死，乃立故齊王建之弟田假為齊王、田角為相、田間為將，以距諸侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-094-tiandan:m003-0002","start":2,"end":4,"surface":"章邯","kind":"person","person_id":"cbr-p005230","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0005","start":5,"end":8,"surface":"魏王咎","kind":"person","person_id":"cbr-p005216","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0014","start":14,"end":16,"surface":"魏王","kind":"person","person_id":"cbr-p005216","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0023","start":23,"end":25,"surface":"田儋","kind":"person","person_id":"cbr-p005225","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0030","start":30,"end":32,"surface":"章邯","kind":"person","person_id":"cbr-p005230","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0045","start":45,"end":47,"surface":"田儋","kind":"person","person_id":"cbr-p005225","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0052","start":52,"end":53,"surface":"儋","kind":"person","person_id":"cbr-p005225","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0054","start":54,"end":56,"surface":"田榮","kind":"person","person_id":"cbr-p005226","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0057","start":57,"end":58,"surface":"儋","kind":"person","person_id":"cbr-p005225","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0069","start":69,"end":71,"surface":"田儋","kind":"person","person_id":"cbr-p005225","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0076","start":76,"end":79,"surface":"齊王建","kind":"person","person_id":"cbr-p005217","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0081","start":81,"end":83,"surface":"田假","kind":"person","person_id":"cbr-p005218","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0087","start":87,"end":89,"surface":"田角","kind":"person","person_id":"cbr-p005219","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0092","start":92,"end":94,"surface":"田間","kind":"person","person_id":"cbr-p005231","status":"contextual_provisional"}],"chapter_id":"c-shiji-094-tiandan","book_id":"b-shiji-094","work_id":"w-shiji","source_id":"s-shiji-094-tiandan"},{"id":"c-shiji-094-tiandan:p004","text":"田榮之走東阿，章邯追圍之。項梁聞田榮之急，乃引兵擊破章邯軍東阿下。章邯走而西，項梁因追之。而田榮怒齊之立假，乃引兵歸，擊逐齊王假。假亡走楚。齊相角亡走趙；角弟田閒前求救趙，因留不敢歸。田榮乃立田儋子市為齊王。榮相之，田橫為將，平齊地。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-094-tiandan:m004-0000","start":0,"end":2,"surface":"田榮","kind":"person","person_id":"cbr-p005226","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0007","start":7,"end":9,"surface":"章邯","kind":"person","person_id":"cbr-p005230","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0013","start":13,"end":15,"surface":"項梁","kind":"person","person_id":"cbr-p005233","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0016","start":16,"end":18,"surface":"田榮","kind":"person","person_id":"cbr-p005226","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0026","start":26,"end":28,"surface":"章邯","kind":"person","person_id":"cbr-p005230","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0033","start":33,"end":35,"surface":"章邯","kind":"person","person_id":"cbr-p005230","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0039","start":39,"end":41,"surface":"項梁","kind":"person","person_id":"cbr-p005233","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0046","start":46,"end":48,"surface":"田榮","kind":"person","person_id":"cbr-p005226","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0052","start":52,"end":53,"surface":"假","kind":"person","person_id":"cbr-p005218","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0061","start":61,"end":64,"surface":"齊王假","kind":"person","person_id":"cbr-p005218","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0065","start":65,"end":66,"surface":"假","kind":"person","person_id":"cbr-p005218","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0070","start":70,"end":73,"surface":"齊相角","kind":"person","person_id":"cbr-p005219","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0079","start":79,"end":81,"surface":"田閒","kind":"person","person_id":"cbr-p005232","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0092","start":92,"end":94,"surface":"田榮","kind":"person","person_id":"cbr-p005226","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0096","start":96,"end":100,"surface":"田儋子市","kind":"person","person_id":"cbr-p005213","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0104","start":104,"end":105,"surface":"榮","kind":"person","person_id":"cbr-p005226","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0108","start":108,"end":110,"surface":"田橫","kind":"person","person_id":"cbr-p005227","status":"contextual_provisional"}],"chapter_id":"c-shiji-094-tiandan","book_id":"b-shiji-094","work_id":"w-shiji","source_id":"s-shiji-094-tiandan"},{"id":"c-shiji-094-tiandan:p014","text":"【索隱述贊】秦項之際，天下交兵。六國樹黨，自置豪英。田儋殞寇，立市相榮。楚封王假，齊破酈生。兄弟更王，海島傳聲。","annotation_status":"named_mentions_first_pass","text_layer":"witness_appended_suoyin_zan","mentions":[{"id":"c-shiji-094-tiandan:m014-0026","start":26,"end":28,"surface":"田儋","kind":"person","person_id":"cbr-p005225","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m014-0032","start":32,"end":33,"surface":"市","kind":"person","person_id":"cbr-p005213","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m014-0034","start":34,"end":35,"surface":"榮","kind":"person","person_id":"cbr-p005226","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m014-0043","start":43,"end":45,"surface":"酈生","kind":"person","person_id":"cbr-p005237","status":"contextual_provisional"}],"chapter_id":"c-shiji-094-tiandan","book_id":"b-shiji-094","work_id":"w-shiji","source_id":"s-shiji-094-tiandan"}],"sources":[{"chapter_id":"c-shiji-006-shihuang","work_id":"w-shiji","book_id":"b-shiji-006","source_id":"s-shiji-006-shihuang","source":{"title":"史記／卷006","pro