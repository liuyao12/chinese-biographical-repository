{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"7j3_miy_4hi","canonical_person_id":"7j3_miy_4hi","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["7j3_miy_4hi"],"persons":[{"id":"7j3_miy_4hi","label":"晉明帝","status":"active","historicity":"historical_tradition","aliases":[{"surface":"皇太子","mention_ids":["c-jinshu-076-wangyi-family:p003:m0073"]},{"surface":"明帝","mention_ids":["c-jinshu-076-wangyi-family:p003:m0100"]}],"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-076","chapter_id":"c-jinshu-076-wangyi-family","source_id":"s-jinshu-076-wangyi-family","paragraph_id":"c-jinshu-076-wangyi-family:p003","mention_id":"c-jinshu-076-wangyi-family:p003:m0073","quote":"皇太子"},{"work_id":"w-jinshu","book_id":"b-jinshu-076","chapter_id":"c-jinshu-076-wangyi-family","source_id":"s-jinshu-076-wangyi-family","paragraph_id":"c-jinshu-076-wangyi-family:p003","mention_id":"c-jinshu-076-wangyi-family:p003:m0100","quote":"明帝"}],"identity_note":"固定原文具名或語境指稱；未知年歲、任期、生母及未核父祖不補，數位校勘記另層。","review":"ai_provisional"}],"source_mention_summary":[{"source_id":"s-jinshu-076-wangyi-family","work_id":"w-jinshu","book_id":"b-jinshu-076","chapter_id":"c-jinshu-076-wangyi-family","mention_count":2,"mention_ids":["c-jinshu-076-wangyi-family:p003:m0073","c-jinshu-076-wangyi-family:p003:m0100"],"paragraph_ids":["c-jinshu-076-wangyi-family:p003"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-jinshu-076-wangyi-family"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"person_id":"7j3_miy_4hi","title":"明帝","surname":"司馬","ming":"紹","additional_names":[],"work_id":"w-jinshu","book_id":"b-jinshu-076","chapter_id":"c-jinshu-076-wangyi-family","source_id":"s-jinshu-076-wangyi-family","paragraph_id":"c-jinshu-076-wangyi-family:p003","quote":"及王敦構禍，帝遣廙喻敦，既不能諫其悖逆，乃為敦所留，受任助亂。敦得志，以廙為平南將領護南蠻校尉、荊州刺史。尋病卒。帝猶以親故，深痛湣之。喪還京都，皇太子親臨拜柩，如家人之禮。贈侍中、驃騎將軍，諡曰康。明帝與大將軍溫嶠書曰：「痛謝鯤未絕於口，世將復至於此。並盛年雋才，不遂其志，痛切於心。廙明古多通，鯤遠有識致。其言雖未足令人改聽，然味之不倦，近未易有也。坐相視盡，如何！」","note":"姓名、字與稱號分存；未名者不補。辨認用稱不等於每個敘事時點已任，對讀原句與固定修訂另外保留。 司馬姓承晉帝室的編輯分姓，諱紹字道畿據卷6明帝紀；未就本批另造其父子斷言。","status":"editorial_provisional","human_reviewed":false,"model":null,"zi":"道畿","references":[{"title":"《晉書》卷6明帝紀傳首","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7006&oldid=2674431","source_revision":2674431,"source_position":{"first_line":165,"last_line":165},"quote":"明皇帝諱紹，字道畿，元皇帝長子也。幼而聰哲，爲元帝所寵異。年數歲，嘗坐置膝前，屬長安使來，因問帝曰：「汝謂日與長安孰遠？」對曰：「長安近。不聞人從日邊來，居然可知也。」元帝異之。明日，宴羣僚，又問之。對曰：「日近。」元帝失色，曰：「何乃異間者之言乎？」對曰：「舉目則見日，不見長安。」由是益奇之。","scope":"primary_parallel_explicit_name_and_courtesy_name","image_verified":false}]}],"mentions":[{"id":"c-jinshu-076-wangyi-family:p003:m0073","start":73,"end":76,"surface":"皇太子","kind":"person","person_id":"7j3_miy_4hi","status":"contextual_provisional","paragraph_id":"c-jinshu-076-wangyi-family:p003","chapter_id":"c-jinshu-076-wangyi-family"},{"id":"c-jinshu-076-wangyi-family:p003:m0100","start":100,"end":102,"surface":"明帝","kind":"person","person_id":"7j3_miy_4hi","status":"contextual_provisional","paragraph_id":"c-jinshu-076-wangyi-family:p003","chapter_id":"c-jinshu-076-wangyi-family"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-jinshu076-mingdi-crownprince","person_id":"7j3_miy_4hi","surfaces":["明帝","皇太子"],"scope":"same_chapter","chapter_ids":["c-jinshu-076-wangyi-family"],"status":"contextual_provisional","confidence_level":"high","identification_basis":{"kind":"source_context","target_mention_ids":["c-jinshu-076-wangyi-family:p003:m0073","c-jinshu-076-wangyi-family:p003:m0100"]},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-076","chapter_id":"c-jinshu-076-wangyi-family","source_id":"s-jinshu-076-wangyi-family","paragraph_id":"c-jinshu-076-wangyi-family:p003","quote":"及王敦構禍，帝遣廙喻敦，既不能諫其悖逆，乃為敦所留，受任助亂。敦得志，以廙為平南將領護南蠻校尉、荊州刺史。尋病卒。帝猶以親故，深痛湣之。喪還京都，皇太子親臨拜柩，如家人之禮。贈侍中、驃騎將軍，諡曰康。明帝與大將軍溫嶠書曰：「痛謝鯤未絕於口，世將復至於此。並盛年雋才，不遂其志，痛切於心。廙明古多通，鯤遠有識致。其言雖未足令人改聽，然味之不倦，近未易有也。坐相視盡，如何！」"}],"rationale":"廙在元帝王敦亂事中卒，前敘帝指元帝，皇太子指其太子紹；後明帝書為同人稱帝號。卷6明記明帝諱紹及元帝即尊號立為皇太子，逐處辨時與發話者，不全段帝字同指。","human_reviewed":false,"model":null,"references":[{"title":"《晉書》卷6明帝紀","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7006&oldid=2674431","source_revision":2674431,"source_position":{"first_line":165,"last_line":169},"quote":"明皇帝諱紹，字道畿，元皇帝長子也。","parallel_quote":"及帝卽尊號，立爲皇太子。","scope":"primary_parallel_name_and_crownprince_identity","image_verified":false}]}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-076-wangyi-family:p003","text":"及王敦構禍，帝遣廙喻敦，既不能諫其悖逆，乃為敦所留，受任助亂。敦得志，以廙為平南將領護南蠻校尉、荊州刺史。尋病卒。帝猶以親故，深痛湣之。喪還京都，皇太子親臨拜柩，如家人之禮。贈侍中、驃騎將軍，諡曰康。明帝與大將軍溫嶠書曰：「痛謝鯤未絕於口，世將復至於此。並盛年雋才，不遂其志，痛切於心。廙明古多通，鯤遠有識致。其言雖未足令人改聽，然味之不倦，近未易有也。坐相視盡，如何！」","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-076-wangyi-family:p003:m0001","start":1,"end":3,"surface":"王敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p003:m0006","start":6,"end":7,"surface":"帝","kind":"person","person_id":"yoc_50k_tps","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p003:m0008","start":8,"end":9,"surface":"廙","kind":"person","person_id":"7r6_k52_qji_ABDA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p003:m0010","start":10,"end":11,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p003:m0022","start":22,"end":23,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p003:m0031","start":31,"end":32,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p003:m0036","start":36,"end":37,"surface":"廙","kind":"person","person_id":"7r6_k52_qji_ABDA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p003:m0057","start":57,"end":58,"surface":"帝","kind":"person","person_id":"yoc_50k_tps","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p003:m0073","start":73,"end":76,"surface":"皇太子","kind":"person","person_id":"7j3_miy_4hi","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p003:m0100","start":100,"end":102,"surface":"明帝","kind":"person","person_id":"7j3_miy_4hi","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p003:m0106","start":106,"end":108,"surface":"溫嶠","kind":"person","person_id":"6v8_pk9_7k5","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p003:m0113","start":113,"end":115,"surface":"謝鯤","kind":"person","person_id":"4ij_7ik_fgy","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p003:m0120","start":120,"end":122,"surface":"世將","kind":"person","person_id":"7r6_k52_qji_ABDA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p003:m0143","start":143,"end":144,"surface":"廙","kind":"person","person_id":"7r6_k52_qji_ABDA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p003:m0149","start":149,"end":150,"surface":"鯤","kind":"person","person_id":"4ij_7ik_fgy","status":"contextual_provisional"}],"source_position":{"first_line":41,"last_line":42,"revision_id":2180533,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-076-wangyi-family","book_id":"b-jinshu-076","work_id":"w-jinshu","source_id":"s-jinshu-076-wangyi-family"}],"sources":[{"chapter_id":"c-jinshu-076-wangyi-family","work_id":"w-jinshu","book_id":"b-jinshu-076","source_id":"s-jinshu-076-wangyi-family","source":{"title":"《晉書》卷七十六（數位選錄）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7076&oldid=2180533","permalink":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7076&oldid=2180533","revision_id":2180533,"accessed_on":"2026-10-18","extent":"王廙傳首、末段及子嗣共四段，中興賦等中段未錄，非完整列傳。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，未親核底本影像","response_sha256":"c6c7c41bf93c491f6f69b058ecc493e979d65f3e65397d20055284f2e829cd30","wikitext_sha256":"872701db949f6f58ea6f183425617dfa82353177d2cc026037bfad953a60cd71","normalization":{"character_conversion":{},"extraction_note":"去首部空白，宋書ref校勘記另存，正文原字不改；不補平南將領的疑缺字。","excerpts":[{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:p001","source_lines":[27,28],"raw_quote":"王廙，字世將，丞相導從弟，而元帝姨弟也。父正，尚書郎。廙少能屬文，多所通涉，工書畫，善音樂、射御、博弈、雜伎。辟太傅掾，轉參軍。豫迎大駕，封武陵縣侯，拜尚書郎，出為濮陽太守。元帝作鎮江左，廙棄郡過江。帝見之大悅，以為司馬。頻守廬江、鄱陽二郡。豫討周馥、杜韜，以功累增封邑，除冠軍將軍，鎮石頭，領丞相軍諮祭酒。王敦啟為甯遠將軍、荊州刺史。","raw_quote_sha256":"8147d33d3202efaa1adf4a1c6aa137d71d239827b11033011846a53f38708001","selected_text_sha256":"8147d33d3202efaa1adf4a1c6aa137d71d239827b11033011846a53f38708001","begin_anchor":"王廙，字世將，丞相導從弟，而元","end_anchor":"。王敦啟為甯遠將軍、荊州刺史。"},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:p002","source_lines":[39,40],"raw_quote":"初，王敦左遷陶侃，使廙代為荊州。將吏馬俊、鄭攀等上書請留侃，敦不許。廙為俊等所襲，奔于江安。賊杜曾與俊、攀北迎第五猗以距廙。廙督諸軍討曾，又為曾所敗。敦命湘州刺史甘卓、豫章太守周廣等助廙擊曾，曾衆潰，廙得到州。廙性俊率，嘗從南下，旦自尋陽，迅風飛帆，暮至都，倚舫樓長嘯，神氣甚逸。王導謂庾亮曰：「世將為傷時識事。」亮曰：「正足舒其逸氣耳。」廙在州大誅戮侃時將佐，及征士皇甫方回，於是大失荊土之望，人情乖阻。帝乃征廙為輔國將軍，加散騎常侍。以母喪去職。服闋，拜征虜將軍，進左衛將軍。","raw_quote_sha256":"713e46789dcf7fe1c521542418159b142d29f81e58c3e6357597be46caf9c662","selected_text_sha256":"713e46789dcf7fe1c521542418159b142d29f81e58c3e6357597be46caf9c662","begin_anchor":"初，王敦左遷陶侃，使廙代為荊州","end_anchor":"服闋，拜征虜將軍，進左衛將軍。"},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:p003","source_lines":[41,42],"raw_quote":"及王敦構禍，帝遣廙喻敦，既不能諫其悖逆，乃為敦所留，受任助亂。敦得志，以廙為平南將領護南蠻校尉、荊州刺史。尋病卒。帝猶以親故，深痛湣之。喪還京都，皇太子親臨拜柩，如家人之禮。贈侍中、驃騎將軍，諡曰康。明帝與大將軍溫嶠書曰：「痛謝鯤未絕於口，世將復至於此。並盛年雋才，不遂其志，痛切於心。廙明古多通，鯤遠有識致。其言雖未足令人改聽，然味之不倦，近未易有也。坐相視盡，如何！」","raw_quote_sha256":"b2c8c3b975ba6ac7732d8b4a11f0ec1be353f9f1fb577963a649d9140d52c2bb","selected_text_sha256":"b2c8c3b975ba6ac7732d8b4a11f0ec1be353f9f1fb577963a649d9140d52c2bb","begin_anchor":"及王敦構禍，帝遣廙喻敦，既不能","end_anchor":"近未易有也。坐相視盡，如何！」"},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:p004","source_lines":[43,44],"raw_quote":"子頤之嗣，仕至東海內史。頤之弟胡之，字修齡，弱冠有聲譽，歷郡守、侍中、丹陽尹。素有風眩疾，發動甚數，而神明不損。石季龍死，朝廷欲綏輯河洛，以胡之為西中郎將、司州刺史、假節，以疾固辭，未行而卒。子茂之亦有美譽，官至晉陵太守。子敬弘，義熙末為尚書。","raw_quote_sha256":"07b3bbc4071f24625a64510a17080b7ab063923ca9f6d5febeb0893dfefef0c6","selected_text_sha256":"07b3bbc4071f24625a64510a17080b7ab063923ca9f6d5febeb0893dfefef0c6","begin_anchor":"子頤之嗣，仕至東海內史。頤之弟","end_anchor":"陵太守。子敬弘，義熙末為尚書。"}]}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true}}
