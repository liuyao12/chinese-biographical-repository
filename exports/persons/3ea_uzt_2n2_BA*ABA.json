ly-ws2634831","chapter_id":"c-songshu-041-helingwan-family","paragraph_id":"c-songshu-041-helingwan-family:p003","quote":"邁","mention_id":"c-songshu-041-helingwan-family:p003:m0155"}],"review":"ai_provisional","identity_note":"兩傳以子邁承何瑀，宋書另列子曼倩。","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"3ea_uzt_2n2_BA*A","source_assertion_id":"a-nan011-helingwan-m-mai","evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-011","source_id":"s-nanshi-011-helingwan-family-ws2288359","chapter_id":"c-nanshi-011-helingwan-family","paragraph_id":"c-nanshi-011-helingwan-family:p002","quote":"后父瑀字幼玉，晉尚書左僕射澄曾孫也。瑀尚武帝少女豫章康長公主諱次男。公主先適徐喬，美容色，聰敏有智數。文帝世，禮待特隆。瑀豪競于時，與平昌孟靈休、東海何勖等並以輿馬相尚。公主與瑀情愛隆密，何氏疏戚莫不沾被恩禮。瑀位右衛將軍，公主薨，瑀墓開，孝武追贈瑀金紫光祿大夫。","object_person_mention_id":"c-nanshi-011-helingwan-family:p002:m0116"},{"work_id":"w-nanshi","book_id":"b-nanshi-011","source_id":"s-nanshi-011-helingwan-family-ws2288359","chapter_id":"c-nanshi-011-helingwan-family","paragraph_id":"c-nanshi-011-helingwan-family:p003","quote":"子邁尚文帝第十女新蔡公主諱英媚。邁少以貴戚居顯官，好犬馬馳逐，多聚才力士，位南濟陰太守。廢帝納公主于後宮，偽言薨殞，殺一婢送出邁第，殯葬行喪禮，常疑邁有異圖。邁亦招聚同志，欲因行廢立，事覺見誅。明帝即位，追封建甯縣侯。","subject_person_mention_id":"c-nanshi-011-helingwan-family:p003:m0001"}],"status":"contextual_provisional","interpretation_note":"原段子某承前段傳主。","human_reviewed":false}},{"id":"3ea_uzt_2n2_BA*ABA","label":"何曼倩（何邁子）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"曼倩","mention_ids":["c-songshu-041-helingwan-family:p003:m0178"]}],"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-041","source_id":"s-songshu-041-helingwan-family-ws2634831","chapter_id":"c-songshu-041-helingwan-family","paragraph_id":"c-songshu-041-helingwan-family:p003","quote":"曼倩","mention_id":"c-songshu-041-helingwan-family:p003:m0178"}],"review":"ai_provisional","identity_note":"宋書何邁附傳末言子曼倩嗣。","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"3ea_uzt_2n2_BA*AB","source_assertion_id":"a-nanshi011-helingwan-s-manqian","evidence":[{"work_id":"w-songshu","book_id":"b-songshu-041","source_id":"s-songshu-041-helingwan-family-ws2634831","chapter_id":"c-songshu-041-helingwan-family","paragraph_id":"c-songshu-041-helingwan-family:p003","quote":"子邁，尚太祖第十女新蔡公主諱英媚。邁少以貴戚居顯宦，好犬馬馳逐，多聚才力之士。有墅在江乘縣界，去京師三十里。邁每游履，輒結駟連騎，武士成羣。大明末，為豫章王子尚撫軍諮議參軍，加寧朔將軍、南濟陰太守。廢帝納公主於後宮，偽言薨殞，殺一婢送出邁第殯葬行喪禮。常疑邁有異圖，邁亦招聚同志，欲因行幸廢立。事覺，廢帝自出討邁誅之。太宗即位，追封建寧縣侯，食邑五百戶。子曼倩嗣，齊受禪，國除。","subject_person_mention_id":"c-songshu-041-helingwan-family:p003:m0178","object_person_mention_id":"c-songshu-041-helingwan-family:p003:m0155","relationship_anchor":{"paragraph_id":"c-songshu-041-helingwan-family:p003","surface":"子曼倩嗣","start":177,"end":181}}],"status":"contextual_provisional","interpretation_note":"曼倩是何邁子，嗣其追封之爵。","human_reviewed":false}}],"source_mention_summary":[{"source_id":"s-songshu-041-helingwan-family-ws2634831","work_id":"w-songshu","book_id":"b-songshu-041","chapter_id":"c-songshu-041-helingwan-family","raw_mention_count":1,"mention_ids":["c-songshu-041-helingwan-family:p003:m0178"],"paragraph_ids":["c-songshu-041-helingwan-family:p003"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-songshu-041-helingwan-family:p003:m0178","mention_ids":["c-songshu-041-helingwan-family:p003:m0178"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-songshu-041-helingwan-family-ws2634831"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variant