l,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"武王按成湯自稱保存，不與周武王混同；太丁僅太子、原文明言未立。太甲放桐宮與授之政各保留原文，不以攝政或放逐自動截斷帝稱。太宗不自行推定追贈或後世廟號授予日期。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[{"id":"shiji-013-t2-r001-c00-m002","start":8,"end":10,"surface":"太丁","person_id":"tlt_5h1_n6y","status":"contextual_provisional","interpretation_note":"依〈三代世表〉殷王世系與《殷本紀》暫定同指；湯子太丁與武乙子太丁分別辨認。","table_id":"shiji-013","table_fragment_id":"shiji-013-digital-table-2","table_row_id":"shiji-013-t2-r001","table_cell_id":"shiji-013-t2-r001-c00","work_id":"w-shiji","book_id":"b-shiji-013","chapter_id":"table-chapter-shiji-013","source_id":"table-witness-shiji-013","source_revision":"2606991","kind":"table_person_mention","quote":"帝外丙，湯太子。太丁蚤卒，故立次弟外丙。"},{"id":"shiji-013-t2-r003-c00-m001","start":7,"end":9,"surface":"太丁","person_id":"tlt_5h1_n6y","status":"contextual_provisional","interpretation_note":"依〈三代世表〉殷王世系與《殷本紀》暫定同指；湯子太丁與武乙子太丁分別辨認。","table_id":"shiji-013","table_fragment_id":"shiji-013-digital-table-2","table_row_id":"shiji-013-t2-r003","table_cell_id":"shiji-013-t2-r003-c00","work_id":"w-shiji","book_id":"b-shiji-013","chapter_id":"table-chapter-shiji-013","source_id":"table-witness-shiji-013","source_revision":"2606991","kind":"table_person_mention","quote":"帝太甲，故太子太丁子。淫，伊尹放之桐宮。三年，悔過自責，伊尹乃迎之復位。"}],"date_normalizations":[],"birth_order_constraints":[{"older_person_id":"tlt_5h1_n6y","younger_person_id":"odj_0jk_o2z","operator":"lt","older_ordinal":null,"younger_ordinal":null,"scope":"siblings","interpretation_status":"source_attested","comparison_basis":"birth_chronology","assertion_id":"a-shiji003-016","person_id":"odj_0jk_o2z","evidence":[{"paragraph_id":"c-shiji-003-yin:p011","quote":"太丁之弟外丙","chapter_id":"c-shiji-003-yin","source_id":"s-shiji-003-yin"}]}],"preferred_birth_order_constraints":[{"older_person_id":"tlt_5h1_n6y","younger_person_id":"odj_0jk_o2z","operator":"lt","older_ordinal":null,"younger_ordinal":n