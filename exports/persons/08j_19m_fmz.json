ge_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-059-prince-jiong-ws2650517","s-jinshu-059-ws2650517-jiong"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-jin059-jiong-wangbao","person_id":"08j_19m_fmz","event_type":"death","source_term":"遂奏豹殺之","source_anchor":{"paragraph_id":"c-jinshu-059-jiong:p003","start":220,"end":225,"surface":"遂奏豹殺之"},"date_expression":null,"status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-059","source_id":"s-jinshu-059-ws2650517-jiong","chapter_id":"c-jinshu-059-jiong","paragraph_id":"c-jinshu-059-jiong:p003","quote":"冏於是輔政，居攸故宮，置掾屬四十人。大築第館，北取五穀市，南開諸署，毀壞廬舍以百數，使大匠營制，與西宮等。鑿千秋門牆以通西閣，後房施鐘懸，前庭舞八佾，沈於酒色，不入朝見。坐拜百官，符敕三臺，選舉不均，惟寵親昵。以車騎將軍何勖領中領軍。封葛𣄣為牟平公，路秀小黃公，衛毅陰平公，劉真安鄉公，韓泰封丘公，號曰「五公」，委以心膂。殿中御史桓豹奏事，不先經冏府，即考竟之。於是朝廷側目，海內失望矣。南陽處士鄭方露版極諫，主簿王豹屢有箴規，冏並不能用，遂奏豹殺之。有白頭公入大司馬府大呼，言有兵起，不出甲子旬。即收殺之。","person_mention_id":"c-jinshu-059-jiong:p003:m0072"}],"interpretation_note":"僅本篇明載死亡；不以沒于作死亡，不從報齡倒生年。無可綁年者留null。","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-jinshu-059-eight-princes-appraisal:p001:m0321","surface":"王豹","start":321,"end":323,"person_id":"08j_19m_fmz","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-059-eight-princes-appraisal:p001","chapter_id":"c-jinshu-059-eight-princes-appraisal"},{"id":"c-jinshu-059-jiong:p003:m0070","start":207,"end":209,"surface":"王豹","kind":"person","person_id":"08j_19m_fmz","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。","paragraph_id":"c-jinshu-059-jiong:p003","chapter_id":"c-jinshu-059-jiong"},{"id":"c-jinshu-059-jiong:p003:m0072","start":222,"end":223,"surface":"豹","kind":"person","person_id":"08j_19m_fmz","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。","paragraph_id":"c-jinshu-059-jiong:p003","chapter_id":"c-jinshu-059-jiong"},{"id":"c-jinshu-059-prince-jiong:p003:m0207","surface":"王豹","start":207,"end":209,"person_id":"08j_19m_fmz","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-059-prince-jiong:p003","chapter_id":"c-jinshu-059-prince-jiong"},{"id":"c-jinshu-059-prince-jiong:p003:m0222","surface":"豹","start":222,"end":223,"person_id":"08j_19m_fmz","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-059-prince-jiong:p003","chapter_id":"c-jinshu-059-prince-jiong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-059-eight-princes-appraisal:p001","text":"史臣曰：昔高辛撫運，釁起參商；宗周嗣曆，禍纏管、蔡。祥觀曩冊，逖聽前古，亂臣賊子，昭鑒在焉。有晉鬱興，載崇籓翰，分茅錫瑞，道光恆典；儀臺飾袞，禮備彝章。汝南以純和之姿，失於無斷；楚隱習果銳之性，遂成凶很。或位居朝右，或職參近禁，俱為女子所詐，相次受誅，雖曰自貽，良可哀也！倫實庸瑣，見欺孫秀，潛構異圖，煽成奸慝。乃使元良遘怨酷，上宰陷誅夷，乾耀以之暫傾，皇綱於焉中圮。遂裂冠毀冕，幸百六之會；綰璽揚纛，窺九五之尊。夫神器焉可偷安，鴻名豈容妄假！而欲托茲淫祀，享彼天年，凶暗之極，未之有也。冏名父之子，唱義勤王，摧偽業于既成，拯皇輿於已墜，策勳考績，良足可稱。然而臨禍忘憂，逞心縱欲，曾不知樂不可極，盈難久持，笑古人之未工，忘己事之已拙。向若采王豹之奇策，納孫惠之嘉謀，高謝袞章，永表東海，雖古之伊、霍，何以加焉！長沙材力絕人，忠概邁俗，投弓掖門，落落標壯夫之氣；馳車魏闕，懍懍懷烈士之風。雖復陽九數屯，在三之情無奪。撫其遺節，終始可觀。穎既入總大權，出居重鎮，中臺藉以成務，東夏資其宅心，乃協契河間，共圖進取。而顒任李含之狙詐，杖張方之陵虐，遂使武閔喪元，長沙授首，逞其無君之志，矜其不義之強。鑾駕北巡，異乎有征無戰；乘輿西幸，非由望秩觀風。若火燎原，猶可撲滅，矧茲安忍，能無及乎！東海糾合同盟，創為義舉，匡復之功未立，陵暴之釁已彰，罄彼車徒，固求出鎮。既而帝京寡弱，狡寇憑陵，遂令神器劫遷，宗社顛覆，數十萬眾並垂餌於豺狼，三十六王咸隕身於鋒刃。禍難之極，振古未聞。雖及焚如，猶為幸也。自惠皇失政，難起蕭牆，骨肉相殘，黎元塗炭，胡塵驚而天地閉，戎兵接而宮廟隳，支屬肇其禍端，戎羯乘其間隙，悲夫！《詩》所謂「誰生厲階，至今為梗」，其八王之謂矣。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":206,"last_line":206,"raw_start":21398,"raw_end":22128,"raw_character_offsets":[21400,21401,21402,21403,21404,21405,21406,21407,21408,21409,21410,21411,21412,21413,21414,21415,21416,21417,21418,21419,21420,21421,21422,21423,21424,21425,21426,21427,21428,21429,21430,21431,21432,21433,21434,21435,21436,21437,21438,21439,21440,21441,21442,21443,21444,21445,21446,21447,21448,21449,21450,21451,21452,21453,21454,21455,21456,21457,21458,21459,21460,21461,21462,21463,21464,21465,21466,21467,21468,21469,21470,21471,21472,21473,21474,21475,21476,21477,21478,21479,21480,21481,21482,21483,21484,21485,21486,21487,21488,21489,21490,21491,21492,21493,21494,21495,21496,21497,21498,21499,21500,21501,21502,21503,21504,21505,21506,21507,21508,21509,21510,21511,21512,21513,21514,21515,21516,21517,21518,21519,21520,21521,21522,21523,21524,21525,21526,21527,21528,21529,21530,21531,21532,21533,21534,21535,21536,21537,21538,21539,21540,21541,21542,21543,21544,21545,21546,21547,21548,21549,21550,21551,21552,21553,21554,21555,21556,21557,21558,21559,21560,21561,21562,21563,21564,21565,21566,21567,21568,21569,21570,21571,21572,21573,21574,21575,21576,21577,21578,21579,21580,21581,21582,21583,21584,21585,21586,21587,21588,21589,21590,21591,21592,21593,21594,21595,21596,21597,21598,21599,21600,21601,21602,21603,21604,21605,21606,21607,21608,21609,21610,21611,21612,21613,21614,21615,21616,21617,21618,21619,21620,21621,21622,21623,21624,21625,21626,21627,21628,21629,21630,21631,21632,21633,21634,21635,21636,21637,21638,21639,21640,21641,21642,21643,21644,21645,21646,21647,21648,21649,21650,21651,21652,21653,21654,21655,21656,21657,21658,21659,21660,21661,21662,21663,21664,21665,21666,21667,21668,21669,21670,21671,21672,21673,21674,21675,21676,21677,21678,21679,21680,21681,21682,21683,21684,21685,21686,21687