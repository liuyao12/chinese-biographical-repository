_mentions_first_pass","mentions":[{"id":"c-jinshu-059-jiong:p003:m0058","start":0,"end":1,"surface":"冏","kind":"person","person_id":"ee0_b2a_68e","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p003:m0059","start":7,"end":8,"surface":"攸","kind":"person","person_id":"cac_ca2_008","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p003:m0060","start":110,"end":112,"surface":"何勖","kind":"person","person_id":"7e9_372_c4a","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p003:m0061","start":118,"end":120,"surface":"葛𣄣","kind":"person","person_id":"t29_ix9_yor","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p003:m0062","start":125,"end":127,"surface":"路秀","kind":"person","person_id":"3e5_6nq_xm3","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p003:m0063","start":131,"end":133,"surface":"衛毅","kind":"person","person_id":"aeg_ljr_nw1","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p003:m0064","start":137,"end":139,"surface":"劉真","kind":"person","person_id":"5j1_ztc_dpq","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p003:m0065","start":143,"end":145,"surface":"韓泰","kind":"person","person_id":"61s_ato_nlg","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p003:m0066","start":152,"end":154,"surface":"五公","kind":"unresolved","person_id":null,"status":"unresolved","resolution_note":"群體／匿名／典故或指代仍待專項辨識，不補造單人。"},{"id":"c-jinshu-059-jiong:p003:m0067","start":165,"end":167,"surface":"桓豹","kind":"person","person_id":"s1h_881_izr","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id"