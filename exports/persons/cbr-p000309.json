{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000309","identity_policy":"contextual_provisional","person_ids":["cbr-p000309"],"persons":[{"id":"cbr-p000309","label":"將軍摎","status":"active","historicity":"historical_tradition","aliases":[{"surface":"將軍摎","mention_ids":["c-shiji-004-zhou:m084-0051","c-shiji-005-qin:m071-0005","c-shiji-005-qin:m071-0072"]},{"surface":"摎","mention_ids":["c-shiji-005-qin:m072-0015"]}],"evidence":[{"mention_id":"c-shiji-004-zhou:m084-0051","chapter_id":"c-shiji-004-zhou","paragraph_id":"c-shiji-004-zhou:p084","quote":"將軍摎"},{"mention_id":"c-shiji-005-qin:m071-0005","chapter_id":"c-shiji-005-qin","paragraph_id":"c-shiji-005-qin:p071","quote":"將軍摎"},{"mention_id":"c-shiji-005-qin:m071-0072","chapter_id":"c-shiji-005-qin","paragraph_id":"c-shiji-005-qin:p071","quote":"將軍摎"},{"mention_id":"c-shiji-005-qin:m072-0015","chapter_id":"c-shiji-005-qin","paragraph_id":"c-shiji-005-qin:p072","quote":"摎"}],"identity_note":"依本卷特定時代與敘事建立；同名與世襲官號不得全庫合併，本名未見不補造。","review":"ai_provisional"}],"mentions":[{"id":"c-shiji-004-zhou:m084-0051","start":51,"end":54,"surface":"將軍摎","kind":"person","person_id":"cbr-p000309","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p084","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-005-qin:m071-0005","start":5,"end":8,"surface":"將軍摎","kind":"person","person_id":"cbr-p000309","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p071","chapter_id":"c-shiji-005-qin"},{"id":"c-shiji-005-qin:m071-0072","start":72,"end":75,"surface":"將軍摎","kind":"person","person_id":"cbr-p000309","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p071","chapter_id":"c-shiji-005-qin"},{"id":"c-shiji-005-qin:m072-0015","start":15,"end":16,"surface":"摎","kind":"person","person_id":"cbr-p000309","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p072","chapter_id":"c-shiji-005-qin"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-004-zhou:p084","text":"五十九年，秦取韓陽城負黍，西周恐，倍秦，與諸侯約從，將天下銳師出伊闕攻秦，令秦無得通陽城。秦昭王怒，使將軍摎攻西周。西周君犇秦，頓首受罪，盡獻其邑三十六，口三萬。秦受其獻，歸其君於周。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-004-zhou:m084-0045","start":45,"end":48,"surface":"秦昭王","kind":"person","person_id":"cbr-p000308","status":"source_identified"},{"id":"c-shiji-004-zhou:m084-0051","start":51,"end":54,"surface":"將軍摎","kind":"person","person_id":"cbr-p000309","status":"source_identified"},{"id":"c-shiji-004-zhou:m084-0058","start":58,"end":61,"surface":"西周君","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官號或文字疑讀；保留錨點，不補熟知姓名或假定同指。"}],"chapter_id":"c-shiji-004-zhou","book_id":"b-shiji-004","work_id":"w-shiji","source_id":"s-shiji-004-zhou"},{"id":"c-shiji-005-qin:p071","text":"五十一年，將軍摎攻韓，取陽城、負黍，斬首四萬。攻趙，取二十餘縣，首虜九萬。西周君背秦，與諸侯約從，將天下銳兵出伊闕攻秦，令秦毋得通陽城。於是秦使將軍摎攻西周。西周君走來自歸，頓首受罪，盡獻其邑三十六城，口三萬。秦王受獻，歸其君於周。五十二年，周民東亡，其器九鼎入秦。周初亡。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m071-0005","start":5,"end":8,"surface":"將軍摎","kind":"person","person_id":"cbr-p000309","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m071-0037","start":37,"end":40,"surface":"西周君","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、氏族、群體或未核指代；不補造個人或按熟知世系自動合併。"},{"id":"c-shiji-005-qin:m071-0072","start":72,"end":75,"surface":"將軍摎","kind":"person","person_id":"cbr-p000309","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m071-0079","start":79,"end":82,"surface":"西周君","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、氏族、群體或未核指代；不補造個人或按熟知世系自動合併。"},{"id":"c-shiji-005-qin:m071-0105","start":105,"end":107,"surface":"秦王","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、氏族、群體或未核指代；不補造個人或按熟知世系自動合併。"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-005-qin:p072","text":"五十三年，天下來賓。魏後，秦使摎伐魏，取吳城。韓王入朝，魏委國聽令。五十四年，王郊見上帝於雍。五十六年秋，昭襄王卒，子孝文王立。尊唐八子為唐太后，而合其葬於先王。韓王衰絰入弔祠，諸侯皆使其將相來弔祠，視喪事。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m072-0015","start":15,"end":16,"surface":"摎","kind":"person","person_id":"cbr-p000309","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m072-0023","start":23,"end":25,"surface":"韓王","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、氏族、群體或未核指代；不補造個人或按熟知世系自動合併。"},{"id":"c-shiji-005-qin:m072-0053","start":53,"end":56,"surface":"昭襄王","kind":"person","person_id":"cbr-p000308","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m072-0059","start":59,"end":62,"surface":"孝文王","kind":"person","person_id":"cbr-p000528","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m072-0065","start":65,"end":68,"surface":"唐八子","kind":"person","person_id":"cbr-p000529","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m072-0069","start":69,"end":72,"surface":"唐太后","kind":"person","person_id":"cbr-p000529","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m072-0078","start":78,"end":80,"surface":"先王","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、氏族、群體或未核指代；不補造個人或按熟知世系自動合併。"},{"id":"c-shiji-005-qin:m072-0081","start":81,"end":83,"surface":"韓王","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、氏族、群體或未核指代；不補造個人或按熟知世系自動合併。"},{"id":"c-shiji-005-qin:m072-0094","start":94,"end":96,"surface":"將相","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、氏族、群體或未核指代；不補造個人或按熟知世系自動合併。"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"}],"sources":[{"chapter_id":"c-shiji-004-zhou","work_id":"w-shiji","book_id":"b-shiji-004","source_id":"s-shiji-004-zhou","source":{"title":"史記／卷004","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷004","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷004&oldid=7909147",