伯父纯，儒学有重名，汉安帝时为侍中、江夏太守，去官，与江夏黄琼、〔广汉〕杨厚俱公车徵。避安帝父孝德皇（帝）讳，改为贺氏。齐父辅，永宁长。","person_mention_id":"c-sanguozhi-060-heqi:line011-pei01-01:m0018"}],"attestations":[{"id":"t-wu060-t-wu060-heqi8:a","paragraph_id":"c-sanguozhi-060-heqi:line011-pei01-01","person_mention_id":"c-sanguozhi-060-heqi:line011-pei01-01:m0018","start":31,"end":33,"surface":"侍中","usage":"narrative","date_expression":null}],"human_reviewed":false,"reviewer":"Codex（AI 代理）","model":null},{"id":"t-wu060-t-wu060-heqi9","person_id":"6sn_3hn_3kv","kind":"office","title":"江夏太守","mode":"attestation","status":"source_attested","effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本句所載職官，任免時間未詳。","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-060","chapter_id":"c-sanguozhi-060-heqi","source_id":"s-sanguozhi-060-heqi","paragraph_id":"c-sanguozhi-060-heqi:line011-pei01-01","quote":"虞预《晋书》曰：贺氏本姓庆氏。齐伯父纯，儒学有重名，汉安帝时为侍中、江夏太守，去官，与江夏黄琼、〔广汉〕杨厚俱公车徵。避安帝父孝德皇（帝）讳，改为贺氏。齐父辅，永宁长。","person_mention_id":"c-sanguozhi-060-heqi:line011-pei01-01:m0018"}],"attestations":[{"id":"t-wu060-t-wu060-heqi9:a","paragraph_id":"c-sanguozhi-060-heqi:line011-pei01-01","person_mention_id":"c-sanguozhi-060-heqi:line011-pei01-01:m0018","start":34,"end":38,"surface":"江夏太守","usage":"narrative","date_expression":null}],"human_reviewed":false,"reviewer":"Codex（AI 代理）","model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-068-hexun:p001","text":"賀循，字彥先，會稽山陰人也。其先慶普，漢世傳《禮》，世所謂慶氏學。族高祖純，博學有重名，漢安帝時為侍中，避安帝父諱，改為賀氏。曾祖齊，仕吳為名將。祖景，滅賊校尉。父邵，中書令，為孫皓所殺，徙家屬邊郡。循少嬰家難，流放海隅，吳平，乃還本郡。操尚高厲，童齔不群，言行進止，必以禮讓，國相丁乂請為五官掾。刺史嵇喜舉秀才，除陽羨令，以寬惠為本，不求課最。後為武康令，俗多厚葬，及有拘忌回避歲月，停喪不葬者，循皆禁焉。政教大行，鄰城宗之。然無援於朝，久不進序。著作郎陸機上疏薦循曰：「伏見武康令賀循德量邃茂，才鑒清遠，服膺道素，風操凝峻，歷試二城，刑政肅穆。前蒸陽令郭訥風度簡曠，器識朗拔，通濟敏悟，才足幹事。循守下縣，編名凡悴；訥歸家巷，棲遲有年。皆出自新邦，朝無知己，居在遐外，志不自營，年時倏忽，而邈無階緒，實州党愚智所為恨恨。臣等伏思台郎所以使州，州有人，非徒以均分顯路，惠及外州而已。誠以庶士殊風，四方異俗，壅隔之害，遠國益甚。至於荊、揚二州，戶各數十萬，今揚州無郎，而荊州江南乃無一人為京城職者，誠非聖朝待四方之本心。至於才望資品，循可尚書郎，訥可太子洗馬、舍人。此乃眾望所積，非但企及清途，苟充方選也。謹條資品，乞蒙簡察。」久之，召補太子舍人。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":75,"last_line":75,"raw_start":7475,"raw_end":8001,"raw_character_offsets":[7477,7478,7479,7480,7481,7482,7483,7484,7485,7486,7487,7488,7489,7490,7491,7492,7493,7494,7495,7496,7497,7498,7499,7500,7501,7502,7503,7504,7505,7506,7507,7508,7509,7510,7511,7512,7513,7514,7515,7516,7517,7518,7519,7520,7521,7522,7523,7524,7525,7526,7527,7528,7529,7530,7531,7532,7533,7534,7535,7536,7537,7538,7539,7540,7541,7542,7543,7544,7545,7546,7547,7548,7549,7550,7551,7552,7553,7554,7555,7556,7557,7558,7559,7560,7561,7562,7563,7564,7565,7566,7567,7568,7569,7570,7571,7572,7573,7574,7575,7576,7577,7578,7579,7580,7581,7582,7583,7584,7585,7586,7587,7588,7589,7590,7591,7592,7593,7594,7595,7596,7597,7598,7599,7600,7601,7602,7603,7604,7605,7606,7607,7608,7609,7610,7611,7612,7613,7614,7615,7616,7617,7618,7619,7620,7621,7622,7623,7624,7625,7626,7627,7628,7629,7630,7631,7632,7633,7634,7635,7636,7637,7638,7639,7640,7641,7642,7643,7644,7645,7646,7647,7648,7649,7650,7651,7652,7653,7654,7655,7656,7657,7658,7659,7660,7661,7662,7663,7664,7665,7666,7667,7668,7669,7670,7671,7672,7673,7674,7675,7676,7677,7678,7679,7680,7681,7682,7683,7684,7685,7686,7687,7688,7689,7690,7691,7692,7693,7694,7695,7696,7697,7698,7699,7700,7701,7702,7703,7704,7705,7706,7707,7708,7709,7710,7711,7712,7713,7714,7715,7716,7717,7718,7719,7720,7721,7722,7723,7724,7725,7726,7727,7728,7729,7730,7731,7732,7733,7734,7735,7736,7737,7738,7739,7740,7741,7742,7743,7744,7745,7746,7747,7748,7749,7750,7751,7752,7753,7754,7755,7756,7757,7758,7759,7760,7761,7762,7763,7764,7765,7766,7767,7768,7769,7770,7771,7772,7773,7774,7775,7776,7777,7778,7779,7780,7781,7782,7783,7784,7785,7786,7787,7788,7789,7790,7791,7792,7793,7794,7795,7796,7797,7798,7799,78