此五者未爲過人。至其純粹履道，求不苟得，升降當世，保全名行，邈然絶俗，實有所師。故粗論其事，以示後之君子。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-sanguozhi-052-zhouzhao-complete:line118:m0076","start":76,"end":79,"surface":"魯橫江","kind":"person","person_id":"ooa_1fr_hy9","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhouzhao-complete:line118:m0199","start":199,"end":201,"surface":"孔子","kind":"person","person_id":"fp6_ia6_7yw","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"source_position":{"first_line":118,"last_line":118,"revision_id":2085149,"raw_start":14095,"raw_end":14567,"character_positions":[14097,14098,14099,14100,14101,14102,14103,14104,14105,14106,14107,14108,14109,14110,14111,14112,14113,14114,14115,14116,14117,14118,14119,14120,14121,14122,14123,14124,14125,14126,14127,14128,14129,14130,14131,14132,14133,14134,14135,14136,14137,14138,14139,14140,14141,14142,14143,14144,14145,14146,14147,14148,14149,14150,14151,14152,14153,14154,14155,14156,14157,14158,14159,14160,14161,14162,14163,14164,14165,14166,14167,14168,14169,14170,14171,14172,14173,14174,14175,14176,14177,14178,14179,14180,14181,14182,14183,14184,14185,14186,14187,14188,14189,14190,14191,14192,14193,14194,14195,14196,14197,14198,14199,14200,14201,14202,14203,14204,14205,14206,14207,14208,14209,14210,14211,14212,14213,14214,14215,14216,14217,14218,14219,14220,14221,14222,14223,14224,14225,14226,14227,14228,14229,14230,14231,14232,14233,14234,14235,14236,14237,14238,14239,14240,14241,14242,14243,14244,14245,14246,14247,14248,14249,14250,14251,14252,14253,14254,14255,14256,14257,14258,14259,14260,14261,14262,14263,14264,14265,14266,14267,14268,14269,14270,14271,14272,14273,14274,14275,14276,14277,14278,14279,14280,14281,14282,14283,14284,14285,14286,14287,14288,14289,14290,14291,14292,14293,14294,14295,14296,14297,14298,14299,14300,14301,14302,14303,14304,14305,14306,14307,14308,14309,14310,14311,14312,14313,14314,14315,14316,14317,14318,1