-0030"],"paragraph_ids":["c-shiji-063-laohan:p022"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-063-laohan"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji063-008","subject_person_id":"eb9_g6y_4q6","predicate":"mother","object_person_id":"8uz_lzx_abe","status":"source_attested","evidence":[{"chapter_id":"c-shiji-063-laohan","source_id":"s-shiji-063-laohan","paragraph_id":"c-shiji-063-laohan:p022","quote":"昔者彌子瑕見愛於衛君。衛國之法，竊駕君車者罪至刖。既而彌子之母病，人聞，往夜告之，彌子矯駕君車而出。君聞之而賢之曰：「孝哉，為母之故而犯刖罪！」與君游果園，彌子食桃而甘，不盡而奉君。君曰：「愛我哉，忘其口而念我！」及彌子色衰而愛弛，得罪於君。君曰：「是嘗矯駕吾車，又嘗食我以其餘桃。」故彌子之行未變於初也，前見賢而後獲罪者，愛憎之至變也。故有愛於主，則知當而加親；見憎於主，則罪當而加疏。故諫說之士不可不察愛憎之主而後說之矣。"}],"qualifiers":{"source_term":"彌子之母","historicity":"historical_tradition"},"interpretation_note":"按子、玄孫及母明文保存。宮玄孫假只記祖先及原文闕代，不補直接父子；說難引例中的關係保留引文敘事範圍，不作獨立史實確證，未名者不補姓名。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-063-laohan:m022-0030","start":30,"end":31,"surface":"母","kind":"person","person_id":"8uz_lzx_abe","status":"contextual_provisional","paragraph_id":"c-shiji-063-laohan:p022","chapter_id":"c-shiji-063-laohan"}],"relations":[{"id":"a-shiji063-008","subject_person_id":"eb9_g6y_4q6","predicate":"mother","object_person_id":"8uz_lzx_abe","status":"source_attested","evidence":[{"chapter_id":"c-shiji-063-laohan","source_id":"s-shiji-063-laohan","paragraph_id":"c-shiji-063-laohan:p022","quote":"昔者彌子瑕見愛於衛君。衛國之法，竊駕君車者罪至刖。既而彌子之母病，人聞，往夜告之，彌子矯駕君車而出。君聞之而賢之曰：「孝哉，為母之故而犯刖罪！」與君游果園，彌子食桃而甘，不盡而奉君。君曰：「愛我哉，忘其口而念我！」及彌子色衰而愛弛，得罪於君。君曰：「是嘗矯駕吾車，又嘗食我以其餘桃。」故彌子之行未變於初也，前見賢而後獲罪者，愛憎之至變也。故有愛於主，則知當而加親；見憎於主，則罪當而加疏。故諫說之士不可不察愛憎之主而後說之矣。"}],"qualifiers":{"sourc