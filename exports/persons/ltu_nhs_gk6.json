"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-nanqishu-027-wangxuanmiao:p006:m0012","mention_ids":["c-nanqishu-027-wangxuanmiao:p006:m0012"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"},{"source_id":"s-nanshi-016-wangxuanmiao-ws1963381","work_id":"w-nanshi","book_id":"b-nanshi-016","chapter_id":"c-nanshi-016-wangxuanmiao","raw_mention_count":1,"mention_ids":["c-nanshi-016-wangxuanmiao:p003:m0022"],"paragraph_ids":["c-nanshi-016-wangxuanmiao:p003"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-nanshi-016-wangxuanmiao:p003:m0022","mention_ids":["c-nanshi-016-wangxuanmiao:p003:m0022"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-nanqishu-027-wangxuanmiao-ws1508012","s-nanshi-016-wangxuanmiao-ws1963381"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-027-wangxuanmiao:p006:m0012","start":12,"end":14,"surface":"子懋","kind":"person","person_id":"ltu_nhs_gk6","status":"contextual_provisional","paragraph_id":"c-nanqishu-027-wangxuanmiao:p006","chapter_id":"c-nanqishu-027-wangxuanmiao"},{"id":"c-nanshi-016-wangxuanmiao:p003:m0022","start":22,"end":24,"surface":"子懋","kind":"person","person_id":"ltu_nhs_gk6","status":"contextual_provisional","paragraph_id":"c-nanshi-016-wangxuanmiao:p003","chapter_id":"c-nanshi-016-wangxuanmiao"}],"relations":[],"title_holdings":[],"address_assertions":[],"person_references":[{"id":"c-nanqishu-027-wangxuanmiao:p006:r0009","paragraph_id":"c-nanqishu-027-wangxuanmiao:p006","start":9,"end":12,"surface":"晉安王","person_id":"ltu_nhs_gk6","referent_role":"third_person","quote":"高宗使玄邈往江州殺晉安王子懋，玄邈苦辭不行，及遣王廣之往廣陵取安陸王子敬，玄邈不得已奉旨。給鼓吹置佐。建武元年，遷持節、都督南兖兖徐青冀五州軍事、平北將軍、南兖州刺史，轉護軍將軍，加散騎常侍。四年，卒，年七十二。贈安北將軍、雍州刺史。諡曰壯侯。","note":"依本段敘事、稱謂及語者受者定。","chapter_id":"c-nanqishu-027-wangxuanmiao","book_id":"b-nanqishu-027","work_id":"w-nanqishu","source_id":"s-nanqishu-027-wangxuanmiao-ws1508012"},{"id":"c-nanqishu-042-wangdeyuan-names:p001:r0055","surface":"晉安王","start":55,"end":58,"person_id":"ltu_nhs_gk6","referent_role":"third_person","paragraph_id":"c-nanqishu-042-wangdeyuan-names:p001","quote":"晏子德元，有意尚。至車騎長史。德元初名湛，世祖謂晏曰：「劉湛、江湛，竝不善終，此非佳名也。」晏乃改之。至是與弟晉安王友德和俱被誅。","note":"晉安王友是王府職。","chapter_id":"c-nanqishu-042-wangdeyuan-names","book_id":"b-nanqishu-042","work_id":"w-nanqishu","source_id":"s-nanqishu-042-wangdeyuan-names-ws1507997"},{"id":"c-nanqishu-047-wangrong:p002:r0018","surface":"晉安王","start":18,"end":21,"person_id":"ltu_nhs_gk6","referent_role":"third_person","paragraph_id":"c-nanqishu-047-wangrong:p002","quote":"融少而神明警惠，博涉有文才。舉秀才。晉安王南中郎板行參軍，坐公事免。竟陵王司徒板法曹行參軍，遷太子舍人。融以父官不通，弱年便欲紹興家業，啓世祖求自試。曰：「臣聞春庚秋蟀，集候相悲，露木風榮，臨年共悅。夫唯動植，且或有心；況在生靈，而能無感。臣自奉望宮闕，沐浴恩私，拔迹庸虛，參名盛列，纓劔紫復，趨步丹墀，歲時歸來，誇榮邑里。然無懃而官，昔賢曾議；不任而祿，有識必譏。臣所用慷慨憤懣，不遑自晏。誠以深恩鮮報，聖主難逢，蒲柳先秋，光陰不待，貪及明時，展悉愚效，以酬陛下不世之仁。若微誠獲信，短才見序，文武吏法，唯所施用。夫君道含弘，臣術無隱，翁歸乃居中自是，充國曰『莫若老臣』。竊景前脩，敢蹈輕節。以冒不媒之鄙，式罄奉公之誠。抑又唐堯在上，不參二八，管夷吾恥之，臣亦恥之。願陛下裁覽。」遷祕書丞。","note":"卷內說話人、對話對象或上下文。","chapter_id":"c-nanqishu-047-wangrong","book_id":"b-nanqishu-047","work_id":"w-nanqishu","source_id":"s-nanqishu-047-wangrong-ws1492435"},{"id":"c-nanshi-016-wangxuanmiao:p003:r0019","paragraph_id":"c-nanshi-016-wangxuanmiao:p003","start":19,"end":22,"surface":"晉安王","person_id":"ltu_nhs_gk6","referent_role":"third_person","quote":"延興元年，爲中護軍。明帝使玄邈往江州殺晉安王子懋，玄邈苦辭不行，及遣王廣之往廣陵取安陸王子敬，玄邈不得已奉旨。建武中，卒於護軍，贈雍州刺史，諡壯侯。","note":"依本段敘事、稱謂及語者受者定。","chapter_id":"c-nanshi-016-wangxuanmiao","book_id":"b-nanshi-016","work_id":"w-nanshi","source_id":"s-nanshi-016-wangxuanmiao-ws1963381"},{"start":2,"end":5,"surface":"晉安王","id":"c-nanshi-021-wangsengyou:p004:r0002","paragraph_id":"c-nanshi-021-wangsengyou:p004","person_id":"ltu_nhs_gk6","referent_role":"third_person","quote":"稍遷晉安王文學，而陳郡袁利爲友，時人以爲妙選。齊武帝數閱武，僧佑獻講武賦，王儉借觀不與。竟陵王子良聞其工琴，於座取琴進之，不從命。永明末，爲太子中舍人，在直屬疾，不待對人輒去。中丞沈約彈之云：「肆情運氣，不顧朝典，揚眉闊步，直轡高驅。」坐贖論。時何點、王思遠之徒請交，並不降意。自天子至於侯伯，未嘗與一人遊。卒于黃門郎。子籍。","note":"本句按敘述視點回指懋。","chapter_id":"c-nanshi-021-wangsengyou","book_id":"b-nanshi-021","work_id":"w-nanshi","source_id":"s-nanshi-021-wangsengyou-ws1752646"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-027-wangxuanmiao:p006","text":"高宗使玄邈往江州殺晉安王子懋，玄邈苦辭不行，及遣王廣之往廣陵取安陸王子敬，玄邈不得已奉旨。給鼓吹置佐。建武元年，遷持節、都督南兖兖徐青冀五州軍事、平北將軍、南兖州刺史，轉護軍將軍，加散騎常侍。四年，卒，年七十二。贈安北將軍、雍州刺史。諡曰壯侯。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":102,"last_line":102,"raw_start":6856,"raw_end":6985,"raw_character_offsets":[6856,6857,6858,6859,6860,6861,6862,6863,6864,6865,6866,6867,6868,6869,6870,6871,6872,6873,6874,6875,6876,6877,6878,6879,6880,6881,6882,6883,6884,6885,6886,6887,6888,6889,6890,6891,6892,6893,6894,6895,6896,6897,6898,6899,6900,6901,6902,6903,6904,6905,6906,6912,6913,6914,6915,6918,6919,6920,6921,6922,6923,6924,6925,6926,6927,6928,6929,6930,6931,6932,6933,6934,6935,6936,6937,6938,6939,6940,6941,6942,6943