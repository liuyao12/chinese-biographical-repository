,8851,8852,8853,8854,8855,8856,8857,8858,8859,8860,8861,8862,8863,8864,8865,8866,8867,8868,8869,8870,8871,8872,8873,8876,8879,8880,8881,8882,8883,8884,8885,8886,8887,8888,8889,8890,8891],"revision_id":1963381},"mentions":[{"id":"c-nanshi-016-wangxuanmiao:p003:m0013","start":13,"end":15,"surface":"玄邈","kind":"person","person_id":"hgq_k4y_crp","status":"contextual_provisional"},{"id":"c-nanshi-016-wangxuanmiao:p003:m0022","start":22,"end":24,"surface":"子懋","kind":"person","person_id":"ltu_nhs_gk6","status":"contextual_provisional"},{"id":"c-nanshi-016-wangxuanmiao:p003:m0025","start":25,"end":27,"surface":"玄邈","kind":"person","person_id":"hgq_k4y_crp","status":"contextual_provisional"},{"id":"c-nanshi-016-wangxuanmiao:p003:m0034","start":34,"end":37,"surface":"王廣之","kind":"person","person_id":"m4d_lon_pyg","status":"contextual_provisional"},{"id":"c-nanshi-016-wangxuanmiao:p003:m0044","start":44,"end":46,"surface":"子敬","kind":"person","person_id":"kix_r92_2ed_A","status":"contextual_provisional"},{"id":"c-nanshi-016-wangxuanmiao:p003:m0047","start":47,"end":49,"surface":"玄邈","kind":"person","person_id":"hgq_k4y_crp","status":"contextual_provisional"}],"chapter_id":"c-nanshi-016-wangxuanmiao","book_id":"b-nanshi-016","work_id":"w-nanshi","source_id":"s-nanshi-016-wangxuanmiao-ws1963381"},{"id":"c-nanshi-021-wangsengyou:p004","text":"稍遷晉安王文學，而陳郡袁利爲友，時人以爲妙選。齊武帝數閱武，僧佑獻講武賦，王儉借觀不與。竟陵王子良聞其工琴，於座取琴進之，不從命。永明末，爲太子中舍人，在直屬疾，不待對人輒去。中丞沈約彈之云：「肆情運氣，不顧朝典，揚眉闊步，直轡高驅。」坐贖論。時何點、王思遠之徒請交，並不降意。自天子至於侯伯，未嘗與一人遊。卒于黃門郎。子籍。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"start":11,"end":13,"surface":"袁利","id":"c-nanshi-021-wangsengyou:p004:m0011","person_id":"kdf_yd6_q09","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作利。"},{"start":30,"end":32,"surface":"僧佑","id":"c-nanshi-021-wangsengyou:p004:m0030","person_id":"p93_tgr_t8r_A","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作佑。"},{"start":37,"end