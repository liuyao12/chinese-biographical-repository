-0115","start":115,"end":117,"surface":"子魚","kind":"person","person_id":"cbr-p001650","status":"contextual_provisional","paragraph_id":"c-shiji-038-song:p037","chapter_id":"c-shiji-038-song"},{"id":"c-shiji-038-song:m037-0135","start":135,"end":137,"surface":"子魚","kind":"person","person_id":"cbr-p001650","status":"contextual_provisional","paragraph_id":"c-shiji-038-song:p037","chapter_id":"c-shiji-038-song"},{"id":"c-shiji-038-song:m037-0160","start":160,"end":162,"surface":"子魚","kind":"person","person_id":"cbr-p001650","status":"contextual_provisional","paragraph_id":"c-shiji-038-song:p037","chapter_id":"c-shiji-038-song"},{"id":"c-shiji-038-song:m037-0198","start":198,"end":200,"surface":"目夷","kind":"person","person_id":"cbr-p001650","status":"contextual_provisional","paragraph_id":"c-shiji-038-song:p037","chapter_id":"c-shiji-038-song"},{"id":"c-shiji-038-song:m037-0286","start":286,"end":288,"surface":"子魚","kind":"person","person_id":"cbr-p001650","status":"contextual_provisional","paragraph_id":"c-shiji-038-song:p037","chapter_id":"c-shiji-038-song"}],"relations":[{"id":"a-shiji038-029","subject_person_id":"cbr-p001650","predicate":"brother","object_person_id":"cbr-p001138","status":"source_attested","evidence":[{"chapter_id":"c-shiji-038-song","source_id":"s-shiji-038-song","paragraph_id":"c-shiji-038-song:p035","quote":"桓公二年，諸矦伐宋，至郊而去。三年，齊桓公始霸。二十三年，迎衛公子燬於齊，立之，是爲衛文公。文公女弟爲桓公夫人。秦穆公即位。三十年，桓公病，太子茲甫讓其庶兄目夷爲嗣。桓公義太子意，竟不聽。三十一年春，桓公卒，太子茲甫立，是爲襄公。以其庶兄目夷爲相。未葬，而齊桓公會諸矦于葵丘，襄公往會。"}],"qualifiers":{"source_term":"太子茲甫讓其庶兄目夷","historicity":"historical_tradition"},"interpretation_note":"保存本篇明示父、子、兄弟、夫人及曾庶孫說；不由繼位補父子，不補母名、共父母或闕代。來源主張與確證史實分開。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji038-045","person_id":"cbr-p001650","title":"相","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-038-song","source_id":"s-shiji-038-song","paragraph_id":"c-shiji-038-song:p035","quote":"太子茲甫立，是爲襄公。以其庶兄目夷爲相。"}],"attestations":[{"id":"th-shiji038-045:a001","paragraph_id":"c-shiji-038-song:p035","start":122,"end":123,"surface":"相","person_mention_id":"c-shiji-038-song:m035-0119","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-038-song","source_id":"s-shiji-038-song","paragraph_id":"c-shiji-038-song:p035","quote":"太子茲甫立，是爲襄公。以其庶兄目夷爲相。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"襄公繼立後以目夷為相，語境三十一年春，未補絕對曆日；與目夷為嗣的讓議不同。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji038-082","person_id":"cbr-p001650","surfaces":["公子目夷","子魚","目夷"],"scope":"same_chapter","chapter_ids":["c-shiji-038-song"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-038-song:p035","quote":"桓公二年，諸矦伐宋，至郊而去。三年，齊桓公始霸。二十三年，迎衛公子燬於齊，立之，是爲衛文公。文公女弟爲桓公夫人。秦穆公即位。三十年，桓公病，太子茲甫讓其庶兄目夷爲嗣。桓公義太子意，竟不聽。三十一年春，桓公卒，太子茲甫立，是爲襄公。以其庶兄目夷爲相。未葬，而齊桓公會諸矦于葵丘，襄公往會。"},{"paragraph_id":"c-shiji-038-song:p037","quote":"八年，齊桓公卒，宋欲爲盟會。十二年春，宋襄公爲鹿上之盟，以求諸矦於楚，楚人許之。公子目夷諫曰：「小國爭盟，禍也。」不聽。秋，諸矦會宋公盟于盂。目夷曰：「禍其在此乎？君欲已甚，何以堪之！」於是楚執宋襄公以伐宋。冬，會于亳，以釋宋公。子魚曰：「禍猶未也。」十三年夏，宋伐鄭。子魚曰：「禍在此矣。」秋，楚伐宋以救鄭。襄公將戰，子魚諫曰：「天之棄商久矣，不可。」冬，十一月，襄公與楚成王戰于泓。楚人未濟，目夷曰：「彼眾我寡，及其未濟擊之。」公不聽。已濟未陳，又曰：「可擊。」公曰：「待其已陳。」陳成，宋人擊之。宋師大敗，襄公傷股。國人皆怨公。公曰：「君子不困人於阸，不鼓不成列。」子魚曰：「兵以勝爲功，何常言與！必如公言，即奴事之耳，又何戰爲？」"}],"rationale":"本篇宋襄公庶兄目夷為相，後鹿上／盂盟與泓戰同段交替以目夷、子魚諫襄公，暫定異稱；教湣公的子魚另保留候選，未按字面跨時段合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-038-song:p035","text":"桓公二年，諸矦伐宋，至郊而去。三年，齊桓公始霸。二十三年，迎衛公子燬於齊，立之，是爲衛文公。文公女弟爲桓公夫人。秦穆公即位。三十年，桓公病，太子茲甫讓其庶兄目夷爲嗣。桓公義太子意，竟不聽。三十一年春，桓公卒，太子茲甫立，是爲襄公。以其庶兄目夷爲相。未葬，而齊桓公會諸矦于葵丘，襄公往會。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-038-song:m035-0000","start":0,"end":2,"surface":"桓公","kind":"person","person_id":"cbr-p001647","status":"contextual_provisional"},{"id":"c-shiji-038-song:m03