_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-038-song:m037-0003","start":3,"end":6,"surface":"齊桓公","kind":"person","person_id":"cbr-p000235","status":"contextual_provisional"},{"id":"c-shiji-038-song:m037-0019","start":19,"end":22,"surface":"宋襄公","kind":"person","person_id":"cbr-p001138","status":"contextual_provisional"},{"id":"c-shiji-038-song:m037-0035","start":35,"end":37,"surface":"楚人","kind":"unresolved","person_id":null,"status":"unresolved","note":"泛稱、政制、群體、神異、匿名者或未定指代；不補未見人名、闕代、制度爵等或成員。"},{"id":"c-shiji-038-song:m037-0040","start":40,"end":44,"surface":"公子目夷","kind":"person","person_id":"cbr-p001650","status":"contextual_provisional"},{"id":"c-shiji-038-song:m037-0065","start":65,"end":67,"surface":"宋公","kind":"person","person_id":"cbr-p001138","status":"contextual_provisional"},{"id":"c-shiji-038-song:m037-0071","start":71,"end":73,"surface":"目夷","kind":"person","person_id":"cbr-p001650","status":"contextual_provisional"},{"id":"c-shiji-038-song:m037-0097","start":97,"end":100,"surface":"宋襄公","kind":"person","person_id":"cbr-p001138","status":"contextual_provisional"},{"id":"c-shiji-038-song:m037-0112","start":112,"end":114,"surface":"宋公","kind":"person","person_id":"cbr-p001138","status":"contextual_provisional"},{"id":"c-shiji-038-song:m037-0115","start":115,"end":117,"surface":"子魚","kind":"person","person_id":"cbr-p001650","status":"contextual_provisional"},{"id":"c-shiji-038-song:m037-0135","start":135,"end":137,"surface":"子魚","kind":"person","person_id":"cbr-p001650","status":"contextual_provisional"},{"id":"c-shiji-038-song:m037-0155","start":155,"end":157,"surface":"襄公","kind":"person","person_id":"cbr-p001138","status":"contextual_provisional"},{"id":"c-shiji-038-song:m037-0160","start":160,"end":162,"surface":"子魚","kind":"person","person_id":"cbr-p001650","status":"contextual_provisional"},{"id":"c-shiji-038-song:m037-0183","start":183,"end":185,"surface":"襄公","kind":"person","person_id":"cbr-p001138","status":"