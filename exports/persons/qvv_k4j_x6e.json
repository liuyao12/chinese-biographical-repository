jinshu-062-liukun:p014:m0290","surface":"琨","start":290,"end":291,"person_id":"b21_e55_8bd","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-062-liukun:p014:m0304","surface":"段匹磾","start":304,"end":307,"person_id":"1y3_yi0_8d4","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-062-liukun:p014:m0311","surface":"琨","start":311,"end":312,"person_id":"b21_e55_8bd","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-062-liukun:p014:m0320","surface":"琨","start":320,"end":321,"person_id":"b21_e55_8bd","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-062-liukun:p014:m0334","surface":"匹磾","start":334,"end":336,"person_id":"1y3_yi0_8d4","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-062-liukun:p014:m0345","surface":"琨","start":345,"end":346,"person_id":"b21_e55_8bd","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-062-liukun","book_id":"b-jinshu-062","work_id":"w-jinshu","source_id":"s-jinshu-062-liukun-ws2629226"},{"id":"c-jinshu-062-liukun:p021","text":"然琨既忠於晉室，素有重望，被拘經月，遠近憤歎。匹磾所署代郡太守辟閭嵩，與琨所署雁門太守王據、後將軍韓據連謀，密作攻具，欲以襲匹磾。而韓據女爲匹磾兒妾，聞其謀而告之匹磾，於是執王據、辟閭嵩及其徒黨悉誅之。會王敦密使匹磾殺琨，匹磾又懼眾反己，遂稱有詔收琨。初，琨聞敦使到，謂其子曰：「處仲使來而不我告，是殺我也。死生有命，但恨仇恥不雪，無以下見二親耳。」因歔欷不能自勝。匹磾遂縊之，時年四十八。子侄四人俱被害。朝廷以匹磾尚強，當爲國討石勒，不舉琨哀。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":52,"last_line":52,"raw_start":4612,"raw_end":4837,"raw_character_offsets":[4614,4615,4616,4617,4618,4619,4620,4621,4622,4623,4624,4625,4626,4627,4628,4629,4630,4631,4632,4633,4634,4635,4636,4637,4638,4639,4640,4641,4642,4643,4644,4645,4646,4647,4648,4649,4650,4651,4652,4653,4654,4655,4656,4657,4658,4659,4660,4661,4662,4663,4664,4665,4666,4667,4668,4669,4670,4671,4672,4673,4674,4675,4676,4677,4678,4679,4680,4681,4682,4683,4684,4685,4686,4687,4688,4689,4690,4691,4692,4693,4694,4695,4696,4697,4698,4699,4700,4701,4702,4703,4704,4705,4706,4707,4708,4709,4710,4711,4712,4713,4714,4715,4716,4717,4718,4719,4