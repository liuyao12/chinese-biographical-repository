ion":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-040","source_id":"s-nanqishu-040-zhaozhou-ws2272748","chapter_id":"c-nanqishu-040-zhaozhou","paragraph_id":"c-nanqishu-040-zhaozhou:p002","quote":"先是王敬則事起，南康侯子恪在吳郡，高宗慮有同異，召諸王侯入宮。晉安王寶義及江陵公寶覽等住中書省，高、武諸孫住西省，勑人各兩左右自隨，過此依軍法，孩抱者乳母隨入。其夜太醫煮藥，都水辦數十具棺材，須三更當悉殺之。子恪奔歸，二更達建陽門刺啓。時刻已至，而帝眠不起，中書舍人沈徽孚與帝所親左右單景雋共謀少留其事，須臾帝覺，景雋啓子恪已至，驚問曰：「未邪？」景雋具以事荅。明日悉遣王侯還第。建武以來，高、武王侯居常震怖，朝不保夕，至是尤甚。","person_mention_id":"c-nanqishu-040-zhaozhou:p002:m0133"}],"status":"source_attested","interpretation_note":"按本見證原職名及其所屬人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"th-nanshi-011-hejingying-2-izumo","person_id":"4cd_j3u_56v","title":"建康令","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-011","chapter_id":"c-nanshi-011-hejingying-izumo","source_id":"s-nanshi-011-hejingying-izumo","paragraph_id":"c-nanshi-011-hejingying-izumo:p003","quote":"澄者本剡縣寒人嘗於南岸逼略人家女為秣陵縣所錄南郡王語縣散遣之澄又逼求姨女為妾姨不與澄詣建康令沈徽孚訟之徽孚曰姨女可為婦不可為妾澄曰僕父為給事中門戶既盛姨家猶是寒賤政可為妾耳徽孚訶而遣之十一年為皇太孫妃又有女巫子楊珉之亦有美貌妃尤愛之與同寢處如伉儷及太孫即帝位為皇后封后嫡母劉為高昌縣都鄉君所生母宋為餘杭廣昌鄉君后將拜鏡在牀無因墮地其冬與太后同日謁太廟楊珉之為帝所幸常居中侍明帝為輔與王晏徐孝嗣王廣之並面請不聽又令蕭諶坦之固請皇后與帝同席坐流涕覆面謂坦之曰楊郎好年少無罪過何可枉殺坦之耳語於帝曰此事別有一意不可令人聞帝謂皇后為阿奴曰阿奴蹔去坦之乃曰外間並云楊珉之與皇后有異情彰聞遐邇帝不得已乃為敕坦之馳報明帝即令建康行刑而果有赦原之而珉之已死","person_mention_id":"c-nanshi-011-hejingying-izumo:p003:m0046"}],"attestations":[{"paragraph_id":"c-nanshi-011-hejingying-izumo:p003","surface":"建康令","start":43,"end":46,"id":"th-nanshi-011-hejingying-2-izumo:a1","person_mention_id":"c-nanshi-011-hejingying-izumo:p003:m0046","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"徽孚在此段的官序。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"th-nanshi-011-hejingying-2","person_id":"4cd_j3u_56v","title":"建康令","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-011","chapter_id":"c-nanshi-011-hejingying","source_id":"s-nanshi-011-hejingying-ws2288359","paragraph_id":"c-nanshi-011-hejingying:p003","quote":"澄者本剡縣寒人，嘗于南岸逼略人家女，為秣陵縣所錄，南郡王語縣散遣之。澄又逼求姨女為妾，姨不與，澄詣建康令沈徽孚訟之。徽孚曰：「姨女可為婦，不可為妾。」澄曰：「僕父為給事中，門戶既成，姨家猶是寒賤，政可為妾耳。」徽孚訶而遣之。十一年，為皇太孫妃。又有女巫子楊瑉之，亦有美貌，妃尤愛悅之，與同寢處，如伉儷。及太孫即帝位，為皇后，封后嫡母劉為高昌縣都鄉君，所生母宋為余杭廣昌鄉君。後將拜，鏡在床無因墮地。其冬，與太后同日謁太廟。楊瑉之為帝所幸，常居中侍。明帝為輔，與王晏、徐孝嗣、王廣之並面請，不聽。又令蕭諶、坦之固請，皇后與帝同席坐，流涕覆面，謂坦之曰：「楊郎好年少，無罪過，何可枉殺。」坦之耳語於帝曰：「此事別有一意，不可令人聞。」帝謂皇后為阿奴，曰：「阿奴暫去」。坦之乃曰：「外間並云楊瑉之與皇后有異情，彰聞遐邇。」帝不得已，乃為敕。坦之馳報明帝，即令建康行刑，而果有敕原之，而瑉之已死。","person_mention_id":"c-nanshi-011-hejingying:p003:m0052"}],"attestations":[{"paragraph_id":"c-nanshi-011-hejingying:p003","surface":"建康令","start":49,"end":52,"id":"th-nanshi-011-hejingying-2:a1","person_mention_id":"c-nanshi-011-hejingying:p003:m0052","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"徽孚在此段的官序。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"person_references":[{"id":"c-nanshi-011-hejingying-izumo:p003:r0051","start":51,"end":53,"surface":"徽孚","person_id":"4cd_j3u_56v","paragraph_id":"c-nanshi-011-hejingying-izumo:p003","quote":"徽孚曰","referent_role":"third_person","note":"依本段及兩書互見紀傳繫人。","chapter_id":"c-nanshi-011-hejingying-izumo","book_id":"b-nanshi-011","work_id":"w-nanshi","source_id":"s-nanshi-011-hejingying-izumo"},{"id":"c-nanshi-011-hejingying-izumo:p003:r0086","start":86,"end":88,"surface":"徽孚","person_id":"4cd_j3u_56v","paragraph_id":"c-nanshi-011-hejingying-izumo:p003","quote":"徽孚訶而遣之","referent_role":"third_person","note":"依本段及兩書互見紀傳繫人。","chapter_id":"c-nanshi-011-hejingying-izumo","book_id":"b-nanshi-011","work_id":"w-nanshi","source_id":"s-nanshi-011-hejingying-iz