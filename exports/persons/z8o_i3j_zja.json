"annotation_status":"reviewed","source_position":{"first_line":75,"last_line":75,"revision_id":2131313,"raw_start":9228,"raw_end":9359,"character_positions":[9238,9239,9240,9241,9242,9243,9244,9245,9246,9247,9248,9249,9250,9251,9252,9253,9254,9255,9256,9257,9258,9259,9260,9261,9262,9263,9264,9265,9266,9267,9268,9269,9270,9271,9272,9273,9274,9275,9276,9277,9278,9279,9280,9281,9282,9283,9284,9285,9286,9287,9288,9289,9290,9291,9292,9293,9294,9295,9296,9297,9298,9299,9300,9301,9302,9303,9304,9305,9306,9307,9308,9309,9310,9311,9312,9313,9314,9315,9316,9317,9318,9319,9320,9321,9322,9323,9324,9325,9326,9327,9328,9329,9330,9331,9334,9335,9338,9339,9340,9341,9342,9343,9344,9345,9348,9349,9352,9353,9354,9355,9356,9357,9358]},"chapter_id":"c-sanguozhi-058-lukang","book_id":"b-sanguozhi-058","work_id":"w-sanguozhi","source_id":"s-sanguozhi-058-lukang"},{"id":"c-sanguozhi-058-lukang:line077","text":"《書》曰：‘與其殺不辜，寧失不經。’而蕃等罪名未定，大辟以加，心經忠義，身被極刑，豈不痛哉！且已死之刑，固無所識，至乃焚爍流漂，棄之水濱，懼非先王之正典，或甫侯之所戒也。是以百姓哀聳，士民同戚。蕃、勖永已，悔亦靡及，誠望陛下赦召玄出，而頃聞薛瑩卒見逮錄。瑩父綜納言先帝，傅弼文皇，及瑩承基，內厲名行，今之所坐，罪在可宥。臣懼有司未詳其事，如復誅戮，益失民望，乞垂天恩，原赦瑩罪，哀矜庶獄，清澄刑網，則天下幸甚！","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-058-lukang:line077:m0019","start":19,"end":20,"surface":"蕃","kind":"person","person_id":"z8o_i3j_zja","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-lukang:line077:m0078","start":78,"end":80,"surface":"甫侯","kind":"person","person_id":"zoh_v2m_0ol","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-lukang:line077:m0097","start":97,"end":98,"surface":"蕃","kind":"person","person_id":"z8o_i3j_zja","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-lukang:line077:m0099","start":99,"end":100,"surface":"勖","kind":"person","person_id":"01s_47v_vif","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-lukang:line077:m0114","start":114,"end":115,"surface