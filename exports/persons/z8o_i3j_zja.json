n_id":"c-sanguozhi-058-lukang:line075:m0044"}],"attestations":[{"id":"t-wu058-k21:a","paragraph_id":"c-sanguozhi-058-lukang:line075","person_mention_id":"c-sanguozhi-058-lukang:line075:m0044","start":39,"end":44,"surface":"散騎中常侍","usage":"narrative","date_expression":null}],"human_reviewed":false,"reviewer":"Codex（AI 代理）","model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-057-yu-sons:line034-pei01-01","text":"《会稽典录》曰：汜字世洪，生南海，年十六，父卒，还乡里。孙綝废幼主，迎立琅邪王休。休未至，綝欲入宫，图为不轨，召百官会议，皆惶怖失色，徒唯唯而已。汜对曰：“明公为国伊周，处将相之位，擅废立之威，将上安宗庙，下惠百姓，大小踊跃，自以伊霍复见。今迎王未至，而欲入宫，如是，群下摇荡，众听疑惑，非所以永终忠孝，扬名后世也。”綝不怿，竟立休。休初即位，汜与贺邵、王蕃、薛莹俱为散骑中常侍。以讨扶严功拜交州刺史、冠军将军、餘姚侯，寻卒。","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-057-yu-sons:line034-pei01-01:m0008","start":8,"end":9,"surface":"汜","kind":"person","person_id":"83b_fot_7g6","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-yu-sons:line034-pei01-01:m0010","start":10,"end":12,"surface":"世洪","kind":"person","person_id":"83b_fot_7g6","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-yu-sons:line034-pei01-01:m0028","start":28,"end":30,"surface":"孙綝","kind":"person","person_id":"hzw_vox_wvw","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-yu-sons:line034-pei01-01:m0031","start":31,"end":33,"surface":"幼主","kind":"person","person_id":"hqp_o1w_ihy","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-yu-sons:line034-pei01-01:m0036","start":36,"end":40,"surface":"琅邪王休","kind":"person","person_id":"0fo_c5c_4yh","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-yu-sons:line034-pei01-01:m0041","start":41,"end":42,"surface":"休","kind":"person","