apter_id":"c-songshu-064-peisongzhi","paragraph_id":"c-songshu-064-peisongzhi:p001","quote":"裴松之，字世期，河東聞喜人也。祖昧，光祿大夫。父珪，正員外郎。松之年八歳，學通論語、毛詩。博覽墳籍，立身簡素。年二十，拜殿中將軍。此官直衞左右，晉孝武太元中革選名家以參顧問，始用琅邪王茂之、會稽謝輶，皆南北之望。舅庾楷在江陵，欲得松之西上，除新野太守，以事難不行。拜員外散騎侍郎。義熙初，爲吳興故鄣令，在縣有績。入爲尚書祠部郎。","subject_person_mention_id":"c-songshu-064-peisongzhi:p001:m0000","object_person_mention_id":"c-songshu-064-peisongzhi:p001:m0024"}],"qualifiers":{"source_term":"父珪","lineage":"paternal"},"interpretation_note":"傳首祖昧、父珪各依原句分存，不另造珪父昧的來源斷言。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-songshu-064-peisongzhi:p001:m0024","start":24,"end":25,"surface":"珪","kind":"person","person_id":"ho3_f0x_fyh","status":"contextual_provisional","interpretation_note":"父珪正員外郎；與孔珪/蔡敏兄珪/檀珪等不同姓世系，不合。","paragraph_id":"c-songshu-064-peisongzhi:p001","chapter_id":"c-songshu-064-peisongzhi"}],"relations":[{"id":"a-song064-songzhi-father","subject_person_id":"301_026_427","predicate":"father","object_person_id":"ho3_f0x_fyh","status":"source_attested","evidence":[{"work_id":"w-songshu","book_id":"b-songshu-064","source_id":"s-song064-ws1748217","chapter_id":"c-songshu-064-peisongzhi","paragraph_id":"c-songshu-064-peisongzhi:p001","quote":"裴松之，字世期，河東聞喜人也。祖昧，光祿大夫。父珪，正員外郎。松之年八歳，學通論語、毛詩。博覽墳籍，立身簡素。年二十，拜殿中將軍。此官直衞左右，晉孝武太元中革選名家以參顧問，始用琅邪王茂之、會稽謝輶，皆南北之望。舅庾楷在江陵，欲得松之西上，除新野太守，以事難不行。拜員外散騎侍郎。義熙初，爲吳興故鄣令，在縣有績。入爲尚書祠部郎。","subject_person_mention_id":"c-songshu-064-peisongzhi:p001:m0000","object_person_mention_id":"c-songshu-064-peisongzhi:p001:m0024"}],"qualifiers":{"source_term":"父珪","lineage":"paternal"},"interpretation_note":"傳首祖昧、父珪各依原句分存，不另造珪父昧的來源斷言。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_bi