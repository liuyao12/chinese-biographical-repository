_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-043-wangyan:p001:m0065","start":65,"end":66,"surface":"乂","kind":"person","person_id":"kwx_czc_d4c","status":"contextual_provisional","resolution_note":"衍承王戎從弟附敘；父乂是平北將軍，不同司馬乂。羊祜/山濤/楊駿/王戎在少年事件同段。武帝明稱，不把敘事後段泛套同君。","paragraph_id":"c-jinshu-043-wangyan:p001","chapter_id":"c-jinshu-043-wangyan"}],"relations":[{"id":"a-jin043-wangyan-father-001","subject_person_id":"kwx_czc_d4c_A","predicate":"father","object_person_id":"kwx_czc_d4c","status":"source_attested","qualifiers":{"source_term":"父乂","lineage":"paternal"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-043","chapter_id":"c-jinshu-043-wangyan","source_id":"s-jinshu-043-ws2618531-wangyan","paragraph_id":"c-jinshu-043-wangyan:p001","quote":"衍字夷甫，神情明秀，風姿詳雅。總角嘗造山濤，濤嗟歎良久，既去，目而送之曰：「何物老嫗，生甯馨兒！然誤天下蒼生者，未必非此人也。」父乂，為平北將軍，常有公事，使行人列上，不時報。衍年十四，時在京師，造僕射羊祜，申陳事狀，辭甚清辯。祜名德貴重，而衍幼年無屈下之色，眾咸異之。楊駿欲以女妻焉，衍恥之，遂陽狂自免。武帝聞其名，問戎曰：「夷甫當世誰比？」戎曰：「未見其比，當從古人中求之。」","subject_person_mention_id":"c-jinshu-043-wangyan:p001:m0000","object_person_mention_id":"c-jinshu-043-wangyan:p001:m0065"}],"interpretation_note":"依卷四十三王衍本傳「父乂」記父子；本記載單稱「乂」，不與同名他人合併。","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-043-wangyan:p001","text":"衍字夷甫，神情明秀，風姿詳雅。總角嘗造山濤，濤嗟歎良久，既去，目而送之曰：「何物老嫗，生甯馨兒！然誤天下蒼生者，未必非此人也。」父乂，為平北將軍，常有公事，使行人列上，不時報。衍年十四，時在京師，造僕射羊祜，申陳事狀，辭甚清辯。祜名德貴重，而衍幼年無屈下之色，眾咸異之。楊駿欲以女妻焉，衍恥之，遂陽狂自免。武帝聞其名，問戎曰：「夷甫當世誰比？」戎曰：「未見其比，當從古人中求之。」","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-043-wangyan:p001:m0000","start":0,"end":1,"surface":"衍","kind":"person","person_id":"kwx_czc_d4c_A","status":"contextual_provisional","resolution_note":"衍承王戎從弟附敘；父乂是平北將軍，不同司馬乂。羊祜/山濤/楊駿/王戎在少年事件同段。武帝明稱