},{"id":"c-shiji-046-tian:m010-0185","start":185,"end":187,"surface":"悼公","kind":"person","person_id":"cbr-p002725","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m010-0192","start":192,"end":195,"surface":"晏孺子","kind":"person","person_id":"cbr-p002722","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m010-0200","start":200,"end":203,"surface":"孺子荼","kind":"person","person_id":"cbr-p002722","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m010-0204","start":204,"end":206,"surface":"悼公","kind":"person","person_id":"cbr-p002725","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m010-0209","start":209,"end":211,"surface":"田乞","kind":"person","person_id":"cbr-p002720","status":"contextual_provisional"}],"chapter_id":"c-shiji-046-tian","book_id":"b-shiji-046","work_id":"w-shiji","source_id":"s-shiji-046-tian"},{"id":"c-shiji-046-tian:p012","text":"鮑牧與齊悼公有郄，弒悼公。齊人共立其子壬，是爲簡公。田常成子與監止倶爲左右相，相簡公。田常心害監止，監止幸於簡公，權弗能去。於是田常復修釐子之政，以大斗出貸，以小斗收。齊人歌之曰：「嫗乎采芑，歸乎田成子！」齊大夫朝，御鞅諫簡公曰：「田、監不可并也，君其擇焉。」君弗聽。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-046-tian:m012-0000","start":0,"end":2,"surface":"鮑牧","kind":"person","person_id":"cbr-p002742","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m012-0003","start":3,"end":6,"surface":"齊悼公","kind":"person","person_id":"cbr-p002725","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m012-0010","start":10,"end":12,"surface":"悼公","kind":"person","person_id":"cbr-p002725","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m012-0019","start":19,"end":20,"surface":"壬","kind":"person","person_id":"cbr-p002743","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m012-0023","start":23,"end":25,"surface":"簡公","kind":"person","person_id":"cbr-p002743","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m012-0026","start":26,"end":30,"surface":"田常成子","kind":"person","person_id":"cbr-p002726","status":"contextual_provisiona