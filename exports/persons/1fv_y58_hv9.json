unt_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-042-jiangshi-complete:p006:m0221","start":221,"end":224,"surface":"黃曇慶","kind":"person","person_id":"1fv_y58_hv9","status":"contextual_provisional","paragraph_id":"c-nanqishu-042-jiangshi-complete:p006","chapter_id":"c-nanqishu-042-jiangshi-complete"},{"id":"c-nanqishu-042-jiangshi-complete:p006:m0234","start":234,"end":236,"surface":"曇慶","kind":"person","person_id":"1fv_y58_hv9","status":"contextual_provisional","paragraph_id":"c-nanqishu-042-jiangshi-complete:p006","chapter_id":"c-nanqishu-042-jiangshi-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-042-jiangshi-complete:p006","text":"　　帝稍欲行意，孝嗣不能奪，坦之雖時有異同，而祏堅意執制，帝深忿之。帝失德旣彰，祏議欲立江夏王寶玄。劉暄初爲寶玄郢州行事，執事過刻。有人獻馬，寶玄欲看之，暄曰：「馬何用看。」妃索煮肫，帳下諮暄，暄曰：「旦已煮鵝，不煩復此。」寶玄恚曰：「舅殊無渭陽之情。」暄聞之亦不悅。至是不同祏議，欲立建安王寶夤，密謀於遙光。遙光自以年長，屬當鼎命，微旨動祏。祏弟祀以少主難保，勸祏立遙光。暄以遙光若立，己失元舅之望，不肯同。故祏遲疑久不決。遙光大怒，遣左右黃曇慶於清溪橋道中刺殺暄，曇慶見暄部伍人多，不敢發。事覺，暄告祏謀，帝處分收祏兄弟。祀時直在內殿，疑有異，遣信報祏曰：「劉暄似有異謀，今作何計？」祏曰：「政當靜以鎮之耳。」俄而召祏入見，停中書省。初，直齋袁文曠以王敬則勳當封，祏執不與。帝使文曠取祏，以刀環築其心曰：「復能奪我封否？」祏、祀同日見殺。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":78,"last_line":78,"raw_start":5408,"raw_end":5779,"raw_character_offsets