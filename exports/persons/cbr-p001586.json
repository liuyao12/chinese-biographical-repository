:"c-shiji-047-kong:p037","chapter_id":"c-shiji-047-kong"},{"id":"c-shiji-047-kong:m054-0018","start":18,"end":21,"surface":"衞君輒","kind":"person","person_id":"cbr-p002889","status":"contextual_provisional","paragraph_id":"c-shiji-047-kong:p054","chapter_id":"c-shiji-047-kong"},{"id":"c-shiji-047-kong:m054-0046","start":46,"end":48,"surface":"衞君","kind":"person","person_id":"cbr-p002889","status":"contextual_provisional","paragraph_id":"c-shiji-047-kong:p054","chapter_id":"c-shiji-047-kong"},{"id":"c-shiji-047-kong:m054-0060","start":60,"end":62,"surface":"衞君","kind":"person","person_id":"cbr-p002889","status":"contextual_provisional","paragraph_id":"c-shiji-047-kong:p054","chapter_id":"c-shiji-047-kong"}],"relations":[{"id":"a-shiji037-054","subject_person_id":"cbr-p001586","predicate":"father","object_person_id":"cbr-p001585","status":"source_attested","evidence":[{"chapter_id":"c-shiji-037-wei","source_id":"s-shiji-037-wei","paragraph_id":"c-shiji-037-wei:p030","quote":"四十二年春，靈公游于郊，令子郢仆。郢，靈公少子也，字子南。靈公怨太子出奔，謂郢曰：「我將立若爲後。」郢對曰：「郢不足以辱社稷，君更圖之。」夏，靈公卒，夫人命子郢爲太子，曰：「此靈公命也。」郢曰：「亡人太子蒯聵之子輒在也，不敢當。」於是衞乃以輒爲君，是爲出公。"}],"qualifiers":{"source_term":"蒯聵之子輒","historicity":"historical_tradition"},"interpretation_note":"保存本篇明示父、子、生、夫人與兄弟原稱，不由繼位推父子、不補同父同母或闕代；來源主張並非已確證史實。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji037-059","subject_person_id":"cbr-p001586","predicate":"father","object_person_id":"cbr-p001585","status":"source_attested","evidence":[{"chapter_id":"c-shiji-037-wei","source_id":"s-shiji-037-wei","paragraph_id":"c-shiji-037-wei:p036","quote":"莊公蒯聵者，出公父也，居外，怨大夫莫迎立。元年卽位，欲盡誅大臣，曰：「寡人居外久矣，子亦嘗聞之乎？」群臣欲作亂，乃止。"}],"qualifiers":{"source_term":"出公父","historicity":"historical_tradition"},"interpretation_note":"保存本篇明示父、子、生、夫人與兄弟原稱，不由繼位推父子、不補同父同母或闕代；來源主張並非已確證史實。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji037-060","subject_person_id":"cbr-p001586","predicate":"paternal_uncle","object_person_id":"cbr-p001600","status":"source_attested","evidence":[{"chapter_id":"c-shiji-037-wei","source_id":"s-shiji-037-wei","paragraph_id":"c-shiji-037-wei:p039","quote":"衞君起元年，衞石曼尃逐其君起，起奔齊。衞出公輒自齊復歸立。初，出公立十二年亡，亡在外四年復入。出公後元年，賞從亡者。立二十一年卒，出公季父黔攻出公子而自立，是爲悼公。"}],"qualifiers":{"source_term":"出公季父黔","historicity":"historical_tradition"},"interpretation_note":"保存本篇明示父、子、生、夫人與兄弟原稱，不由繼位推父子、不補同父同母或闕代；來源主張並非已確證史實。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji037-061","subject_person_id":"cbr-p001619","predicate":"father","object_person_id":"cbr-p001586","status":"source_attested","evidence":[{"chapter_id":"c-shiji-037-wei","source_id":"s-shiji-037-wei","paragraph_id":"c-shiji-037-wei:p039","quote":"衞君起元年，衞石曼尃逐其君起，起奔齊。衞出公輒自齊復歸立。初，出公立十二年亡，亡在外四年復入。出公後元年，賞從亡者。立二十一年卒，出公季父黔攻出公子而自立，是爲悼公。"}],"qualifiers":{"source_term":"出公子","historicity":"historical_tradition"},"interpretation_note":"保存本篇明示父、子、生、夫人與兄弟原稱，不由繼位推父子、不補同父同母或闕代；來源主張並非已確證史實。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji047-008","subject_person_id":"cbr-p002889","predicate":"grandfather","object_person_id":"cbr-p002873","status":"source_attested","evidence":[{"chapter_id":"c-shiji-047-kong","source_id":"s-shiji-047-kong","paragraph_id":"c-shiji-047-kong:p037","quote":"夏，衞靈公卒，立孫輒，是為衞出公。六月，趙鞅內太子蒯聵于戚。陽虎使太子絻，八人衰絰，偽自衞迎者，哭而入，遂居焉。冬，蔡遷于州來。是歲魯哀公三年，而孔子年六十矣。齊助衞圍戚，以衞太子蒯聵在故也。"}],"qualifiers":{"source_term":"衞靈公卒，立孫輒","historicity":"historical_tradition"},"interpretation_note":"夫人、配與孫按原稱分型；祖孫不改父子，嗣康子不單獨推生父，回敘不證已成立史實。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji047-009","subject_person_id":"cbr-p002889","predicate":"father","object_person_id":"cbr-p002933","status":"source_attested","evidence":[{"chapter_id":"c-shiji-047-kong","source_id":"s-shiji-047-kong","paragraph_id":"c-shiji-047-kong:p054","quote":"孔子曰：「魯衞之政，兄弟也。」是時，衞君輒父不得立，在外，諸侯數以為讓。而孔子弟子多仕於衞，衞君欲得孔子為政。子路曰：「衞君待子而為政，子將奚先？」孔子曰：「必也正名乎！」子路曰：「有是哉，子之迂也！何其正也？」孔子曰：「野哉由也！夫名不正則言不順，言不順則事不成，事不成則禮樂不興，禮樂不興則刑罰不中，刑罰不中則民無所錯手足矣。夫君子為之必可名，言之必可行。君子於其言，無所苟而已矣。」"}],"qualifiers":{"source_term":"衞君輒父不得立，在外","historicity":"historical_tradition"},"interpretation_note":"父稱只記本段未名者，與蒯聵身份仍待其他明示來源，不按模型記憶接人。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji037-030","person_id":"cbr-p001586","title":"出公","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-037-wei","source_id":"s-shiji-037-wei","paragraph_id":"c-shiji-037-wei:p030","quote":"四十二年春，靈公游于郊，令子郢仆。郢，靈公少子也，字子南。靈公怨太子出奔，謂郢曰：「我將立若爲後。」郢對曰：「郢不足以辱社稷，君更圖之。」夏，靈公卒，夫人命子郢爲太子，曰：「此靈公命也。」郢曰：「亡人太子蒯聵之子輒在也，不敢當。」於是衞乃以輒爲君，是爲出公。"}],"attestations":[{"id":"th-shiji037-030:a001","paragraph_id":"c-shiji-037-wei:p030","start":126,"end":128,"surface":"出公","person_mention_id":"c-shiji-037-wei:m030-0106","usage":"retrospective"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"侯、公及諡號等暫作敘事追稱，不把繼位當當時授予諡號；未知曆日與終點不按卒日補造。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji037-069","person_id":"cbr-p001586","title":"君","kind":"noble_rank","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-037-wei","source_id":"s-shiji-037-wei","paragraph_id":"c-shiji-037-wei:p030","quote":"於是衞乃以輒爲君，是爲出公。"}],"attestations":[{"id":"th-shiji037-069:a001","paragraph_id":"c-shiji-037-wei:p030","start":122,"end":123,"surface":"君","person_mention_id":"c-shiji-037-wei:m030-0120","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-037-wei","source_id":"s-shiji-037-wei","paragraph_id":"c-shiji-037-wei:p030","quote":"於是衞乃以輒爲君，是爲出公。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"靈公卒後以輒為君，未補其精確登位日。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji037-103","person_id":"cbr-p001586","surfaces":["出公","出公輒","衞出公輒","輒"],"scope":"same_chapter","chapter_ids":["c-shiji-037-wei"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-037-wei:p030","quote":"四十二年春，靈公游于郊，令子郢仆。郢，靈公少子也，字子南。靈公怨太子出奔，謂郢曰：「我將立若爲後。」郢對曰：「郢不足以辱社稷，君更圖之。」夏，靈公卒，夫人命子郢爲太子，曰：「此靈公命也。」郢曰：「亡人太子蒯聵之子輒在也，不敢當。」於是衞乃以輒爲君，是爲出公。"},{"paragraph_id":"c-shiji-037-wei:p032","quote":"出公輒四年，齊田乞弒其君孺子。八年，齊鮑子弒其君悼公。"},{"paragraph_id":"c-shiji-037-wei:p034","quote":"十二年，初，孔圉文子取太子蒯聵之姊，生悝。孔氏之豎渾良夫美好，孔文子卒，良夫通於悝母。太子在宿，悝母使良夫於太子。太子與良夫言曰：「茍能入我國，報子以乘軒，免子三死，毋所與。」與之盟，許以悝母爲妻。閏月，良夫與太子入，舍孔氏之外圃。昏，二人蒙衣而乘，宦者羅御，如孔氏。孔氏之老欒甯問之，稱姻妾以告。遂入，適伯姬氏。旣食，悝母杖戈而先，太子與五人介，輿猳從之。伯姬劫悝於廁，彊盟之，遂劫以登臺。欒甯將飲酒，炙未熟，聞亂，使告仲由。召護駕乘車，行爵食炙，奉出公輒奔魯。"},{"paragraph_id":"c-shiji-037-wei:p036","quote":"莊公蒯聵者，出公父也，居外，怨大夫莫迎立。元年卽位，欲盡誅大臣，曰：「寡人居外久矣，子亦嘗聞之乎？」群臣欲作亂，乃止。"},{"paragraph_id":"c-shiji-037-wei:p039","quote":"衞君起元年，衞石曼尃逐其君起，起奔齊。衞出公輒自齊復歸立。初，出公立十二年亡，亡在外四年復入。出公後元年，賞從亡者。立二十一年卒，出公季父黔攻出公子而自立，是爲悼公。"},{"paragraph_id":"c-shiji-037-wei:p054","quote":"司寇受封，梓材有作。成錫厥器，夷加其爵。暨武能脩，從文始約。詩美歸燕，傳矜石碏。皮冠射鴻，乘軒使穀。宣縱淫嬖，釁生伋、朔。蒯聵得罪，出公行惡。衞祚日衰，失於君角。"}],"rationale":"按本篇明示名與追稱、衛世系及具體事件暫定所列提及同指；每段原文附存，不按同名字面跨篇合併。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji047-067","person_id":"cbr-p002889","scope":"same_chapter","chapter_ids":["c-shiji-047-kong"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["孫輒","衞出公","衞君","衞君輒"],"evidence":[{"paragraph_id":"c-shiji-047-kong:p037","quote":"夏，衞靈公卒，立孫輒，是為衞出公。六月，趙鞅內太子蒯聵于戚。陽虎使太子絻，八人衰絰，偽自衞迎者，哭而入，遂居焉。冬，蔡遷于州來。是歲魯哀公三年，而孔子年六十矣。齊助衞圍戚，以衞太子蒯聵在故也。"},{"paragraph_id":"c-shiji-047-kong:p054","quote":"孔子曰：「魯衞之政，兄弟也。」是時，衞君輒父不得立，在外，諸侯數以為讓。而孔子弟子多仕於衞，衞君欲得孔子為政。子路曰：「衞君待子而為政，子將奚先？」孔子曰：「必也正名乎！」子路曰：「有是哉，子之迂也！何其正也？」孔子曰：「野哉由也！夫名不正則言不順，言不順則事不成，事不成則禮樂不興，禮樂不興則刑罰不中，刑罰不中則民無所錯手足矣。夫君子為之必可名，言之必可行。君子於其言，無所苟而已矣。」"}],"rationale":"限本篇明示名、字、對話自稱、世系及附贊局部對應；世系求與冉求分開，武不接漢武帝，今皇帝與高皇帝不補姓名。子路仲由明示同指另存，冉有冉求與秦繆秦穆仍待核；附贊不當獨立作者正文或獨立見證。"}],"equivalence_decisions":[{"id":"eq-shiji047-zhe","person_ids":["cbr-p001586","cbr-p002889"],"canonical_person_id":"cbr-p001586","scope":"cross_chapter","chapter_ids":["c-shiji-037-wei","c-shiji-047-kong"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-037-wei","source_id":"s-shiji-037-wei","paragraph_id":"c-shiji-037-wei:p030","quote":"四十二年春，靈公游于郊，令子郢仆。郢，靈公少子也，字子南。靈公怨太子出奔，謂郢曰：「我將立若爲後。」郢對曰：「郢不足以辱社稷，君更圖之。」夏，靈公卒，夫人命子郢爲太子，曰：「此靈公命也。」郢曰：「亡人太子蒯聵之子輒在也，不敢當。」於是衞乃以輒爲君，是爲出公。","mention_ids":["c-shiji-037-wei:m030-0106","c-shiji-037-wei:m030-0120","c-shiji-037-wei:m030-0126"]},{"chapter_id":"c-shiji-047-kong","source_id":"s-shiji-047-kong","paragraph_id":"c-shiji-047-kong:p037","quote":"夏，衞靈公卒，立孫輒，是為衞出公。六月，趙鞅內太子蒯聵于戚。陽虎使太子絻，八人衰絰，偽自衞迎者，哭而入，遂居焉。冬，蔡遷于州來。是歲魯哀公三年，而孔子年六十矣。齊助衞圍戚，以衞太子蒯聵在故也。","mention_ids":["c-shiji-047-kong:m037-0008","c-shiji-047-kong:m037-0013"]}],"rationale":"兩篇同記衞靈公卒、立輒為出公，限相同角色及事件暫同指。原ID、文字與紀年各保留，不將不同篇當獨立見證或選定史實及來源優先。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-037-wei:p030","text":"四十二年春，靈公游于郊，令子郢仆。郢，靈公少子也，字子南。靈公怨太子出奔，謂郢曰：「我將立若爲後。」郢對曰：「郢不足以辱社稷，君更圖之。」夏，靈公卒，夫人命子郢爲太子，曰：「此靈公命也。」郢曰：「亡人太子蒯聵之子輒在也，不敢當。」於是衞乃以輒爲君，是爲出公。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-037-wei:m030-0006","start":6,"end":8,"surface":"靈公","kind":"person","person_id":"cbr-p001583","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m030-0013","start":13,"end":15,"surface":"子郢","kind":"person","person_id":"cbr-p001584","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m030-0017","start":17,"end":18,"surface":"郢","kind":"person","person_id":"cbr-p001584","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m030-0019","start":19,"end":21,"surface":"靈公","kind":"person","person_id":"cbr-p001583","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m030-0026","start":26,"end":28,"surface":"子南","kind":"person","person_id":"cbr-p001584","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m030-0029","start":29,"end":31,"surface":"靈公","kind":"person","person_id":"cbr-p001583","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m030-0032","start":32,"end":34,"surface":"太子","kind":"person","person_id":"cbr-p001585","status":"contextual_provisional"},{"id":"c-shij