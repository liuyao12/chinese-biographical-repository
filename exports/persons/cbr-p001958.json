i-040-chu:p041","chapter_id":"c-shiji-040-chu"},{"id":"c-shiji-040-chu:m044-0007","start":7,"end":8,"surface":"母","kind":"person","person_id":"cbr-p001958","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p044","chapter_id":"c-shiji-040-chu"},{"id":"c-shiji-040-chu:m044-0033","start":33,"end":34,"surface":"母","kind":"person","person_id":"cbr-p001958","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p044","chapter_id":"c-shiji-040-chu"},{"id":"c-shiji-040-chu:m044-0116","start":116,"end":118,"surface":"建母","kind":"person","person_id":"cbr-p001958","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p044","chapter_id":"c-shiji-040-chu"}],"relations":[{"id":"a-shiji040-050","subject_person_id":"cbr-p001929","predicate":"mother","object_person_id":"cbr-p001958","status":"source_attested","evidence":[{"chapter_id":"c-shiji-040-chu","source_id":"s-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p041","quote":"平王二年，使費無忌如秦爲太子建取婦。婦好，來，未至，無忌先歸，説平王曰：「秦女好，可自娶，爲太子更求。」平王聽之，卒自娶秦女，生熊珍。更爲太子娶。是時伍奢爲太子太傅，無忌爲少傅。無忌無寵於太子，常讒惡太子建。建時年十五矣，其母蔡女也，無寵於王，王稍益疎外建也。"}],"qualifiers":{"source_term":"其母蔡女","historicity":"historical_tradition"},"interpretation_note":"依本段明示生育、兄弟、母子及苗裔敘事；祖先不作直接父親，繼位不自動推父子，不補未見母名或闕代。來源主張不等於版本與史實已覆核。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji040-048","person_id":"cbr-p001958","surfaces":["建母","母","蔡女"],"scope":"same_chapter","chapter_ids":["c-shiji-040-chu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-040-chu:p041","quote":"平王二年，使費無忌如秦爲太子建取婦。婦好，來，未至，無忌先歸，説平王曰：「秦女好，可自娶，爲太子更求。」平王聽之，卒自娶秦女，生熊珍。更爲太子娶。是時伍奢爲太子太傅，無忌爲少傅。無忌無寵於太子，常讒惡太子建。建時年十五矣，其母蔡女也，無寵於王，王稍益疎外建也。"},{"paragraph_id":"c-shiji-040-chu:p044","quote":"十年，楚太子建母在居巣，開呉。呉使公子光伐楚，遂敗陳、蔡，取太子建母而去。楚恐，城郢。初，呉之邊邑卑梁與楚邊邑鐘離小童爭桑，兩家交怒相攻，滅卑梁人。卑梁大夫怒，發邑兵攻鐘離。楚王聞之怒，發國兵滅卑梁。呉王聞之大怒，亦發兵，使公子光因建母家攻楚，遂滅鐘離、居巣。楚乃恐而城郢。"}],"rationale":"依本段具體職事、引語或親屬用稱暫接未名個人／短名，未補氏名；不