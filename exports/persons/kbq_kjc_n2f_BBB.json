kisource","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7035&oldid=2506399","permalink":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7035&oldid=2506399","revision_id":2506399,"accessed_on":"2026-10-21","extent":"完整裴楷及輿、瓚、憲、康盾邵、綽遐與八裴八王19段；不是完整卷035，不含陳騫裴秀頠及史評。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄，保留見證歸屬；數位文字依CC BY-SA 4.0。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":null,"wikitext_sha256":"b27aa9fc386b5f40990822d615febffcb8b8cd6df3fe6f74585274ff733c12be","response_sha256":"e7fc20a0864866bfb68f1f92b542b6f542edebed2052fcf550244ed46206fa35","raw_file":"sources/witnesses/jin035-ws2506399.wikitext","normalization":{"character_conversion":{},"extraction_note":"展開連結顯示字、去粗體排版；標題另層。㲄、俊郎、雲及缺閉引號原樣保留。"}}},{"chapter_id":"c-sanguozhi-023-peiqian-ws2376966","work_id":"w-sanguozhi","book_id":"b-sanguozhi-023","source_id":"s-sanguozhi-023-peiqian-ws2376966","source":{"title":"《三國志》卷23裴潛本傳及裴松之注","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=三國志/卷23&oldid=2376966","permalink":"https://zh.wikisource.org/w/index.php?title=三國志/卷23&oldid=2376966","revision_id":2376966,"accessed_on":"2026-10-29","text_scope":"partial_chapter","extent":"固定數位原檔第66–75行，完整裴潛本傳及全部所附裴注（包含注末四人補傳與魚豢論贊）；止第77行評題前，不含全卷或卷末共評。","review_status":"text_checked","image_verified":false,"edition":null,"rights":"古代正文及維基文庫數位轉錄，保留見證歸屬。數位轉錄依CC BY-SA 4.0。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","raw_path":"source-evidence/sgz023-peiqian-ws2376966/sgz023-fixed.wikitext","raw_file_sha256":"6aba2ec0a43e037d6c2bcbc3b546c517d2d92dbf736a95ed7c53c39ad0f97bb2","normalization":{"character_conversion":{},"note":"只展開固定wikilink顯示文字及YL原紀年、去裴注template包裝；br分段，原字不轉換。YL第二欄公元對照屬數位編輯而不入正文；逐字投影及全部包裝另存。"},"quality_note":"印本未知的固定數位見證，不稱武英殿或圖校；Kanripo WYG四庫來源只作既存限定參校，不作本章底本。"}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true},"assembled_identity":{"person_id":"kbq_kjc_n2f_BBB","representative_source_person_id":"kbq_kjc_n2f_BBB","source_person_ids":["kbq_kjc_n2f_BBB"],"identity_equivalence_decision_ids":[],"parent_person_id":"kbq_kjc_n2f_BB","source_assertion_id":null,"connection":"father","parent_connection":{"type":"shared_father_through_sibling","sibling_person_id":"kbq_kjc_n2f_BBA","sibling_assertion_id":"a-jin035-pei-shao-dun","sibling_father_assertion_id":"a-jin035-pei-dun-father","status":"contextual_provisional","rationale":"依具名兄弟姊妹與其具名父親作可撤回同父推導；原文未直稱本人物之父，不補生母。","human_reviewed":false,"references":[{"assertion_id":"a-jin035-pei-shao-dun","chapter_id":"c-jinshu-035-peikai-family","source_id":"s-jinshu-035-peikai-ws2506399","paragraph_id":"c-jinshu-035-peikai-family:p017","quote":"盾弟邵，字道期。元帝為安東將軍，以邵為長史，王導為司馬，二人相與為深交。徵為太子中庶子，復轉散騎常侍，使持節、都督揚州江西淮北諸軍事、東中郎將，隨越出項，而卒於軍中。及王導為司空，既拜，歎曰：「裴道期、劉王喬在，吾不得獨登此位。」導子仲豫與康同字，導思舊好，乃改為敬豫焉。","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7035&oldid=2506399","scope":"原文明兄弟姊妹／父子；本關係為可撤回同父組裝推導，不推同母。"},{"assertion_id":"a-jin035-pei-dun-father","chapter_id":"c-jinshu-035-peikai-family","source_id":"s-jinshu-035-peikai-ws2506399","paragraph_id":"c-jinshu-035-peikai-family:p016","quote":"楷長兄黎，次兄康，並知名。康子盾，少曆顯位。永嘉中，為徐州刺史，委任長史司馬奧。奧勸盾刑殺立威，大發良人為兵，有不奉法者罪便至死。在任三年，百姓嗟怨。東海王越，盾妹夫也。越既薨，騎督滿衡便引所發良人東還。尋而劉元海遣將王桑、趙固向彭城，前鋒數騎至下邳，文武不堪苛政，悉皆散走，盾、奧奔淮陰，妻子為賊人所得。奧又誘盾降趙固。固妻盾女，有寵，盾向女涕泣，固遂殺之。","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7035&oldid=2506399","scope":"原文明兄弟姊妹／父子；本關係為可撤回同父組裝推導，不推同母。"}]},"assembly_id":"family-hedong-pei-mao-near","root_person_id":"kbq_kjc_n2f","status":"contextual_provisional","human_reviewed":false}}
