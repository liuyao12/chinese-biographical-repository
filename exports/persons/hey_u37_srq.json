-0046","chapter_id":"c-shiji-107-weiqi","paragraph_id":"c-shiji-107-weiqi:p027","quote":"魏其"},{"mention_id":"c-shiji-107-weiqi:m028-0006","chapter_id":"c-shiji-107-weiqi","paragraph_id":"c-shiji-107-weiqi:p028","quote":"竇嬰"},{"mention_id":"c-shiji-111-wei-huo:m047-0059","chapter_id":"c-shiji-111-wei-huo","paragraph_id":"c-shiji-111-wei-huo:p047","quote":"魏其"}],"family_path":{"connection":"father","parent_person_id":"nuf_tb9_fjs","status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-107-weiqi","source_id":"s-shiji-107-weiqi","paragraph_id":"c-shiji-107-weiqi:p001","quote":"魏其侯竇嬰者，孝文后從兄子也。父世觀津人。喜賓客。孝文時，嬰為吳相，病免。孝景初即位，為詹事。"}],"interpretation_note":"篇首父世觀津之父指竇嬰父親；不補其姓名。","reviewer":"Codex（AI 代理）","human_reviewed":false}}],"source_mention_summary":[{"source_id":"s-shiji-107-weiqi","work_id":"w-shiji","book_id":"b-shiji-107","chapter_id":"c-shiji-107-weiqi","mention_count":1,"mention_ids":["c-shiji-107-weiqi:m024-0080"],"paragraph_ids":["c-shiji-107-weiqi:p024"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-107-weiqi"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji107-013","subject_person_id":"hey_u37_srq","predicate":"paternal_uncle","object_person_id":"nuf_tb9_fjs_A","status":"source_attested","evidence":[{"chapter_id":"c-shiji-107-weiqi","source_id":"s-shiji-107-weiqi","paragraph_id":"c-shiji-107-weiqi:p024","quote":"於是上使御史簿責魏其所言灌夫，頗不讎，欺謾。劾系都司空。孝景時，魏其常受遺詔，曰「事有不便，以便宜論上」。及系，灌夫罪至族，事日急，諸公莫敢複明言於上。魏其乃使昆弟子上書言之，幸得複召見。書奏上，而案尚書大行無遺詔。詔書獨藏魏其家，家丞封。乃劾魏其矯先帝詔，罪當棄市。五年十月，悉論灌夫及家屬。魏其良久乃聞，聞即恚，病痱，不食欲死。或聞上無意殺魏其，魏其複食，治病，議定不死矣。乃有蜚語為惡言聞上，故以十二月晦論棄市渭城。"}],"qualifiers":{"source_term":"昆弟子","historicity":"historical_tradition","uncle_age_relative_to_father":"unknown","parent_person_id":null},"interpretation_note":"按本文明示親屬與本段人物承接；昆弟子保存叔伯長幼未定，