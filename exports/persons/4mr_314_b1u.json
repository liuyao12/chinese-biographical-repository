{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"4mr_314_b1u","canonical_person_id":"4mr_314_b1u","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["4mr_314_b1u"],"persons":[{"id":"4mr_314_b1u","label":"桓逸","status":"active","historicity":"historical_tradition","aliases":[{"surface":"桓逸","mention_ids":["c-jinshu-073-yuyi:p004:m0261"]}],"evidence":[{"mention_id":"c-jinshu-073-yuyi:p004:m0261","paragraph_id":"c-jinshu-073-yuyi:p004","chapter_id":"c-jinshu-073-yuyi","quote":"桓逸"}],"review":"ai_provisional","identity_note":"桓逸，見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-jinshu-073-yuyi-ws2296501","work_id":"w-jinshu","book_id":"b-jinshu-073","chapter_id":"c-jinshu-073-yuyi","raw_mention_count":1,"mention_ids":["c-jinshu-073-yuyi:p004:m0261"],"paragraph_ids":["c-jinshu-073-yuyi:p004"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-073-yuyi:p004:m0261","mention_ids":["c-jinshu-073-yuyi:p004:m0261"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-073-yuyi-ws2296501"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-073-yuyi:p004:m0261","surface":"桓逸","start":261,"end":263,"person_id":"4mr_314_b1u","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-073-yuyi:p004","chapter_id":"c-jinshu-073-yuyi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-073-yuyi:p004","text":"時殷浩征命無所就，而翼請為司馬及軍司，並不肯赴。翼遺浩書，因致其意。先是，浩父羨為長沙，在郡貪殘，，兄冰與翼書屬之。翼報曰：「殷君始往，雖多驕豪，實有風力之益，亦似由有佳兒、弟，故不令物情難之。自頃以來，奉公更退，私累日滋，亦不稍以此寥蕭之也。既雅敬洪遠，又與浩親善，其父兄得失，豈以小小計之。大較江東政，以傴儛豪強，以為民蠹，時有行法，輒施之寒劣。如往年偷石頭倉米一百萬斛，皆是豪將輩，而直打殺倉督監以塞責。山遐作余姚鬥年，而為官出二千戶，政雖不倫，公強官長也，而群共驅之，，不得安席。紀睦、徐甯奉王使糾罪人，船頭到渚，桓逸還復，而二使免官。雖皆前宰之惛謬，江東事去，實此之由也。兄弟不幸，橫陷此中，自不能拔腳於風塵之外，當共明目而治之。荊州所統一二十郡，唯長沙最惡。惡而不黜，與殺督監者復何異耶！」翼有風力格裁，發言立論皆如此。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":128,"last_line":128,"raw_start":9976,"raw_end":10344,"raw_character_offsets":[9978,9979,9980,9981,9982,9983,9984,9985,9986,9987,9988,9989,9990,9991,9992,9993,9994,9995,9996,9997,9998,9999,10000,10001,10002,10003,10004,10005,10006,10007,10008,10009,10010,10011,10012,10013,10014,10015,10016,10017,10018,10019,10020,10021,10022,10023,10024,10025,10026,10027,10028,10029,10030,10031,10032,10033,10034,10035,10036,10037,10038,10039,10040,10041,10042,10043,10044,10045,10046,10047,10048,10049,10050,10051,10052,10053,10054,10055,10056,10057,10058,10059,10060,10061,10062,10063,10064,10065,10066,10067,10068,10069,10070,10071,10072,10073,10074,10075,10076,10077,10078,10079,10080,10081,10082,10083,10084,10085,10086,10087,10088,10089,10090,10091,10092,10093,10094,10095,10096,10097,10098,10099,10100,10101,10102,10103,10104,10105,10106,10107,10108,10109,10110,10111,10112,10113,10114,10115,10116,10117,10118,10119,10120,10121,10122,10123,10124,10125,10126,10127,10128,10129,10130,10131,10132,10133,10134,10135,10136,10137,10138,10139,10140,10141,10142,10