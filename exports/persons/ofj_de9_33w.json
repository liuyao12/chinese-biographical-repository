弗王，以故不附楚。漢擊項籍，無諸、搖率越人佐漢。漢五年，復立無諸為閩越王，王閩中故地，都東冶。孝惠三年，舉高帝時越功，曰閩君搖功多，其民便附，乃立搖為東海王，都東甌，世俗號為東甌王。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-114-dongyue:m001-0003","start":3,"end":5,"surface":"無諸","kind":"person","person_id":"e00_pe1_zri","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m001-0010","start":10,"end":11,"surface":"搖","kind":"person","person_id":"ub6_g9c_hvb","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m001-0018","start":18,"end":20,"surface":"句踐","kind":"person","person_id":"7ly_s1p_rqd","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m001-0054","start":54,"end":56,"surface":"無諸","kind":"person","person_id":"e00_pe1_zri","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m001-0057","start":57,"end":58,"surface":"搖","kind":"person","person_id":"ub6_g9c_hvb","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m001-0064","start":64,"end":66,"surface":"吳芮","kind":"person","person_id":"r6p_87v_nc8","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m001-0069","start":69,"end":71,"surface":"鄱君","kind":"person","person_id":"r6p_87v_nc8","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m001-0085","start":85,"end":87,"surface":"項籍","kind":"person","person_id":"3jq_7f4_ci2","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m001-0101","start":101,"end":103,"surface":"項籍","kind":"person","person_id":"3jq_7f4_ci2","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m001-0104","start":104,"end":106,"surface":"無諸","kind":"person","person_id":"e00_pe1_zri","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m001-0107","start":107,"end":108,"surface":"搖","kind":"person","person_id":"ub6_g9c_hvb","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m001-0120","start":120,"end":122,"surface":"無諸","kind":"person","person_id":"e00_pe1_zri","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue