erson_id":"n6f_l9u_nno","status":"contextual_provisional","paragraph_id":"c-shiji-126-huaji:p014","chapter_id":"c-shiji-126-huaji"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-126-huaji:p014","text":"武帝時有所幸倡郭舍人者，發言陳辭雖不合大道，然令人主和說。武帝少時，東武侯母常養帝，帝壯時，號之曰「大乳母」。率一月再朝。朝奏入，有詔使幸臣馬游卿以帛五十匹賜乳母，又奉飲糒飱養乳母。乳母上書曰：「某所有公田，願得假倩之。」帝曰：「乳母欲得之乎？」以賜乳母。乳母所言，未嘗不聽。有詔得令乳母乘車行馳道中。當此之時，公卿大臣皆敬重乳母。乳母家子孫奴從者橫暴長安中，當道掣頓人車馬，奪人衣服。聞於中，不忍致之法。有司請徙乳母家室，處之於邊。奏可。乳母當入至前，面見辭。乳母先見郭舍人，為下泣。舍人曰：「即入見辭去，疾步數還顧。」乳母如其言，謝去，疾步數還顧。郭舍人疾言罵之曰：「咄！老女子！何不疾行！陛下已壯矣，寧尚須汝乳而活邪？尚何還顧！」於是人主憐焉悲之，乃下詔止無徙乳母，罰謫譖之者。","annotation_status":"in_progress","text_layer":"witness_appended_chu_note","mentions":[{"id":"c-shiji-126-huaji:m014-0000","start":0,"end":2,"surface":"武帝","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m014-0007","start":7,"end":10,"surface":"郭舍人","kind":"person","person_id":"kdu_i1o_jtw","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m014-0024","start":24,"end":26,"surface":"人主","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m014-0029","start":29,"end":31,"surface":"武帝","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m014-0034-hou","start":34,"end":37,"surface":"東武侯","kind":"person","person_id":"wfj_oof_3mr","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m014-0034","start":37,"end":38,"surface":"母","kind":"person","person_id":"3yj_sj9_zlz","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m014-0040","start":40,"end":41,"surface":"帝","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m014-0042","start":42,"end":43,"surface":"帝","kind":"person","person_id":"yqp