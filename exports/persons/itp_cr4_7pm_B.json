henmiaorong","paragraph_id":"c-nanshi-012-shenmiaorong:p001","quote":"文沈皇后諱妙容，吳興武康人也。父法深，梁安前中錄事參軍。后年十歲余，以梁大同中歸於文帝。武帝之討侯景，文帝時在吳興，及后並被收，景平，乃獲免。武帝踐阼，后為臨川王妃。文帝即位，為皇后。追贈后父法深光祿大夫，加金章紫綬，封建城縣侯，諡曰恭。追贈后母高為綏安縣君，諡曰定。廢帝即位，尊后為皇太后，宮曰安德。","subject_person_mention_id":"c-nanshi-012-shenmiaorong:p001:m0005","object_person_mention_id":"c-nanshi-012-shenmiaorong:p001:m0016","relationship_anchor":{"paragraph_id":"c-nanshi-012-shenmiaorong:p001","surface":"父法深，","start":15,"end":19}}],"status":"contextual_provisional","interpretation_note":"后父法深。","human_reviewed":false}},{"id":"itp_cr4_7pm_B","label":"沈欽（沈妙容兄）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"欽","mention_ids":["c-nanshi-012-shenmiaorong:p004:m0002","c-nanshi-012-shenmiaorong:p004:m0017","c-chenshu-007-shenmiaorong:p003:m0002","c-chenshu-007-shenmiaorong:p003:m0095","c-chenshu-007-wuying-consorts:p015:m0002"]}],"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-012","source_id":"s-nanshi-012-shenmiaorong-ws2060595","chapter_id":"c-nanshi-012-shenmiaorong","paragraph_id":"c-nanshi-012-shenmiaorong:p004","quote":"欽","mention_id":"c-nanshi-012-shenmiaorong:p004:m0002"},{"work_id":"w-nanshi","book_id":"b-nanshi-012","source_id":"s-nanshi-012-shenmiaorong-ws2060595","chapter_id":"c-nanshi-012-shenmiaorong","paragraph_id":"c-nanshi-012-shenmiaorong:p004","quote":"欽","mention_id":"c-nanshi-012-shenmiaorong:p004:m0017"},{"work_id":"w-chenshu","book_id":"b-chenshu-007","source_id":"s-chenshu-007-shenmiaorong-ws2015446","chapter_id":"c-chenshu-007-shenmiaorong","paragraph_id":"c-chenshu-007-shenmiaorong:p003","quote":"欽","mention_id":"c-chenshu-007-shenmiaorong:p003:m0002"},{"work_id":"w-chenshu","book_id":"b-chenshu-007","source_id":"s-chenshu-007-shenmiaorong-ws2015446","chapter_id":"c-chenshu-007-shenmiaorong","paragraph_id":"c-chenshu-007-shenmiaorong:p003","quote":"欽","mention_id":"c-chenshu-007-shenmiaorong:p003:m0095"},{"work_id":"w-chenshu","book_id":"b-chenshu-007","chapter_id":"c-chenshu-00