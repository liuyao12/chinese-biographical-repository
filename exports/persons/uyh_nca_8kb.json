ote":"依完整曹休敘事與同朝稱謂上下文；原字不校，未核影像。"},{"id":"c-sanguozhi-009-caoxiu:p005:m0185","start":185,"end":186,"surface":"肇","kind":"person","person_id":"h7n_w5t_i1c_AAA","status":"contextual_provisional","interpretation_note":"依完整曹休敘事與同朝稱謂上下文；原字不校，未核影像。"}],"annotation_status":"in_progress","text_layer":"received_chapter","source_position":{"raw_projection_ref":"source-evidence/sgz009-caoxiu/projection.json","unit_key":"p005","revision_id":"214fcafa79894355909c9d8c2c1533089e7791c6","projected_start":438,"projected_end":625,"editorial_excerpt_boundary":false,"source_unit_id":"sgz009-caoxiu-complete","biography_subject_person_id":"h7n_w5t_i1c_AA"},"chapter_id":"c-sanguozhi-009-caoxiu","book_id":"b-sanguozhi-009","work_id":"w-sanguozhi","source_id":"s-sanguozhi-009-caoxiu"},{"id":"c-sanguozhi-055-handang:line030","text":"韓當字義公，遼西令支人也。以便弓馬，有膂力，幸於孫堅，從征伐周旋，數犯危難，陷敵擒虜，爲別部司馬。及孫策東渡，從討三郡，遷先登校尉，授兵二千，騎五十匹。從征劉勳，破黃祖，還討鄱陽，領樂安長，山越畏服。後以中郎將與周瑜等拒破曹公，又與呂蒙襲取南郡，遷偏將軍，領永昌太守。宜都之役，與陸遜、朱然等共攻蜀軍於涿鄉，大破之，徙威烈將軍，封都亭侯。曹真攻南郡，當保東南。在外爲帥，厲將士同心固守，又敬望督司，奉遵法令，權善之。黃武二年，封石城侯，遷昭武將軍，領冠軍太守，後又加都督之號。將敢死及解煩兵萬人，討丹楊賊，破之。會病卒，子綜襲侯領兵。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-055-handang:line030:m0000","start":0,"end":2,"surface":"韓當","kind":"person","person_id":"wwt_o8m_vtt","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-055-handang:line030:m0003","start":3,"end":5,"surface":"義公","kind":"person","person_id":"wwt_o8m_vtt","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-055-handang:line030:m0024","start":24,"end":26,"surface":"孫堅","kind":"person","person_id":"ki7_rgz_3l4","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-055-handang:line030:m0050","start":50,"end":52,"surface":"孫策","kind":"person","person_id":"e9c_070_567","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-055-handang:line030:m0078","start":78,"end":80,"surface":"劉勳","kind":"pers