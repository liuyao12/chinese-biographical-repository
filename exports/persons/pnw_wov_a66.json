":1,"parent_person_id":"72e_1a7_3ac_AAA","source_assertion_id":"a-nanshi024-wangqing-meng-father","evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-024","source_id":"s-nanshi-024-wangqing-ws1765279","chapter_id":"c-nanshi-024-wangqing","paragraph_id":"c-nanshi-024-wangqing:p001","quote":"進之子清，位散騎常侍，金紫光祿大夫，鎭東府長史，新野、東陽二郡太守，安南將軍，封中廬公。承聖末，陳武帝殺太尉王僧辯，遣文帝攻僧辯婿杜龕，龕告難於清，引兵援龕，大敗陳文帝于呉興，追奔至晉陵。時廣州刺史歐陽頠亦同清援龕，中更改異，殺清而歸陳武帝。子猛。","subject_person_mention_id":"c-nanshi-024-wangqing:p001:m0122","object_person_mention_id":"c-nanshi-024-wangqing:p001:m0114","relationship_anchor":{"paragraph_id":"c-nanshi-024-wangqing:p001","surface":"子猛","start":121,"end":123}}],"status":"contextual_provisional","interpretation_note":"傳尾子猛承王清，後王猛本題於173行重記父清。","human_reviewed":false}},{"id":"pnw_wov_a66","label":"王猛妻（本傳未名）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"妻","mention_ids":["c-nanshi-024-wangmeng:p005:m0002"]}],"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-024","source_id":"s-nanshi-024-wangmeng-ws1765279","chapter_id":"c-nanshi-024-wangmeng","paragraph_id":"c-nanshi-024-wangmeng:p005","quote":"妻","mention_id":"c-nanshi-024-wangmeng:p005:m0002"}],"review":"ai_provisional","identity_note":"傳末猛母妻子，各別為母、妻及子女；妻無姓氏與生育記載。"}],"source_mention_summary":[{"source_id":"s-nanshi-024-wangmeng-ws1765279","work_id":"w-nanshi","book_id":"b-nanshi-024","chapter_id":"c-nanshi-024-wangmeng","raw_mention_count":1,"mention_ids":["c-nanshi-024-wangmeng:p005:m0002"],"paragraph_ids":["c-nanshi-024-wangmeng:p005"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-nanshi-024-wangmeng:p005:m0002","mention_ids":["c-nanshi-024-wangmeng:p005:m0002"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-nanshi-024-wangmeng-ws1765279"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-nanshi024-wangmeng-wife","subject_person_id":"pnw_wov_a66","object_person_id":"72e_1a7_3ac_AAAA","predicate":"spouse","qualifiers":{"source_term":"猛母妻子","nanshi024_wangmeng_reading":"wife"},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-024","source_id":"s-nanshi-024-wangmeng-ws1765279","chapter_id":"c-nanshi-024-wangmeng","paragraph_id":"c-nanshi-024-wangmeng:p005","quote":"猛母妻子先留建鄴，因隨後主入京，詔賜宅及什物甚厚，別賚物一千段，及遣璽書勞猛。仍討平山越，馳驛奏聞。時文帝幸河東，會猛使至，大悅。楊素賀，因曰：「昔漢武此地聞喜，用改縣名，王猛今者告捷，遠符前事。」於是又降璽書褒賞，以其長子繕爲開府儀同三司。猛尋卒于廣州，文帝聞而痛之，遣使弔祭，贈上開府儀同三司，封歸仁縣公。命其子繕襲，仍授普州刺史。仁壽元年，繕弟續表陳猛志，求葬關中，詔許之。仍贈使持節、大將軍、宋州刺史、三州諸軍事，諡曰成。","subject_person_mention_id":"c-nanshi-024-wangmeng:p005:m0002","object_person_mention_id":"c-nanshi-024-wangmeng:p005:m0000","relationship_anchor":{"paragraph_id":"c-nanshi-024-wangmeng:p005","surface":"猛母妻子","start":0,"end":4}}],"status":"source_attested","interpretation_note":"王猛家屬隨後主入京，妻未名，子女之母未載。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanshi-024-wangmeng:p005:m0002","surface":"妻","start":2,"end":3,"person_id":"pnw_wov_a66","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-nanshi-024-wangmeng:p005","chapter_id":"c-nanshi-024-wangmeng"}],"relations":[{"id":"a-nanshi024-wangmeng-wife","subject_person_id":"pnw_wov_a66","object_person_id":"72e_1a7_3ac_AAAA","predicate":"spouse","qualifiers":{"source_term":"猛母妻子","nanshi024_wangmeng_reading":"wife"},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-024","source_id":"s-nanshi-024-wangmeng-ws1765279","chapter_id":"c-nanshi-024-wangmeng","paragraph_id":"c-nanshi-024-wangmeng:p005","quote":"猛母妻子先留建鄴，因隨後主入京，詔賜宅及什物甚厚，別賚物一千段，及遣璽書勞猛。仍討平山越，馳驛奏聞。時文帝幸河東，會猛使至，大悅。楊素賀，因曰：「昔漢武此地聞喜，用改縣名，王猛今者告捷，遠符前事。」於是又降璽書褒賞，以其長子繕爲開府儀同三司。猛尋卒于廣州，文帝聞而痛之，遣使弔祭，贈上開府儀同三司，封歸仁縣公。命其子繕襲，仍授普州刺史。仁壽元年，繕弟續表陳猛志，求葬關中，詔許之。仍贈使持節、大將軍、宋州刺史、三州諸軍事，諡曰成。","subject_person_mention_id":"c-nanshi-024-wangmeng:p005:m0002","object_person_mention_id":"c-nanshi-024-wangmeng:p005:m0000","relationship_anchor":{"paragraph_id":"c-nanshi-024-wangmeng:p005","surface":"猛母妻子","start":0,"end":4}}],"status":"source_attested","interpretation_note":"王猛家屬隨後主入京，妻未名，子女之母未載。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanshi-024-wangmeng:p005","text":"猛母妻子先留建鄴，因隨後主入京，詔賜宅及什物甚厚，別賚物一千段，及遣璽書勞猛。仍討平山越，馳驛奏聞。時文帝幸河東，會猛使至，大悅。楊素賀，因曰：「昔漢武此地聞喜，用改縣名，王猛今者告捷，遠符前事。」於是又降璽書褒賞，以其長子繕爲開府儀同三司。猛尋卒于廣州，文帝聞而痛之，遣使弔祭，贈上開府儀同三司，封歸仁縣公。命其子繕襲，仍授普州刺史。仁壽元年，繕弟續表陳猛志，求葬關中，詔許之。仍贈使持節、大將軍、宋州刺史、三州諸軍事，諡曰成。","mentions":[{"id":"c-nanshi-024-wangmeng:p005:m0000","surface":"猛","start":0,"end":1,"person_id":"72e_1a7_3ac_AAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangmeng:p005:m0002","surface":"妻","start":2,"end":3,"person_id":"pnw_wov_a66","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangmeng:p005:m0037","surface":"猛","start":37,"end":38,"person_id":"72e_1a7_3ac_AAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangmeng:p005:m0058",