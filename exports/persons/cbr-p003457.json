{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003457","identity_policy":"contextual_provisional","person_ids":["cbr-p003457"],"persons":[{"id":"cbr-p003457","label":"雍齒（陳丞相世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"雍齒","mention_ids":["c-shiji-056-chen:m018-0177","c-shiji-056-chen:m018-0180"]}],"evidence":[{"mention_id":"c-shiji-056-chen:m018-0177","chapter_id":"c-shiji-056-chen","paragraph_id":"c-shiji-056-chen:p018","quote":"雍齒"},{"mention_id":"c-shiji-056-chen:m018-0180","chapter_id":"c-shiji-056-chen","paragraph_id":"c-shiji-056-chen:p018","quote":"雍齒"}]}],"mentions":[{"id":"c-shiji-056-chen:m018-0177","start":177,"end":179,"surface":"雍齒","kind":"person","person_id":"cbr-p003457","status":"contextual_provisional","paragraph_id":"c-shiji-056-chen:p018","chapter_id":"c-shiji-056-chen"},{"id":"c-shiji-056-chen:m018-0180","start":180,"end":182,"surface":"雍齒","kind":"person","person_id":"cbr-p003457","status":"contextual_provisional","paragraph_id":"c-shiji-056-chen:p018","chapter_id":"c-shiji-056-chen"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji056-040","person_id":"cbr-p003457","surfaces":["雍齒"],"scope":"same_chapter","chapter_ids":["c-shiji-056-chen"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-056-chen:p018","quote":"王陵者，故沛人，始爲縣豪，高祖微時，兄事陵。陵少文，任氣，好直言。及高祖起沛，入至咸陽，陵亦自聚黨數千人，居南陽，不肯從沛公。及漢王之還攻項籍，陵乃以兵屬漢。項羽取陵母置軍中，陵使至，則東鄕坐陵母，欲以招陵。陵母既私送使者，泣曰：「爲老妾語陵，謹事漢王。漢王，長者也，無以老妾故，持二心。妾以死送使者。」遂伏劍而死。項王怒，烹陵母。陵卒從漢王定天下。以善雍齒，雍齒，高帝之仇，而陵本無意從高帝，以故晩封，爲安國侯。"}],"rationale":"依本篇明示名字、局部主語、授官爵與家世暫接。平城與負郭不作短名，韓王信與淮陰侯韓信、審食其與酈食其分開。上依高帝與孝文帝敘事換主語，指控與古代比擬不當已驗史實；未名者不補全名，女孫父親不由婚議推定。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-056-chen:p018","text":"王陵者，故沛人，始爲縣豪，高祖微時，兄事陵。陵少文，任氣，好直言。及高祖起沛，入至咸陽，陵亦自聚黨數千人，居南陽，不肯從沛公。及漢王之還攻項籍，陵乃以兵屬漢。項羽取陵母置軍中，陵使至，則東鄕坐陵母，欲以招陵。陵母既私送使者，泣曰：「爲老妾語陵，謹事漢王。漢王，長者也，無以老妾故，持二心。妾以死送使者。」遂伏劍而死。項王怒，烹陵母。陵卒從漢王定天下。以善雍齒，雍齒，高帝之仇，而陵本無意從高帝，以故晩封，爲安國侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-056-chen:m018-0000","start":0,"end":2,"surface":"王陵","kind":"person","person_id":"cbr-p003455","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m018-0013","start":13,"end":15,"surface":"高祖","kind":"person","person_id":"cbr-p003428","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m018-0020","start":20,"end":21,"surface":"陵","kind":"person","person_id":"cbr-p003455","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m018-0022","start":22,"end":23,"surface":"陵","kind":"person","person_id":"cbr-p003455","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m018-0034","start":34,"end":36,"surface":"高祖","kind":"person","person_id":"cbr-p003428","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m018-0044","start":44,"end":45,"surface":"陵","kind":"person","person_id":"cbr-p003455","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m018-0048","start":48,"end":52,"surface":"黨數千人","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、泛稱官職、氏族或代詞待覆核，不補姓名或未見家屬。"},{"id":"c-shiji-056-chen:m018-0064","start":64,"end":66,"surface":"漢王","kind":"person","person_id":"cbr-p003428","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m018-0069","start":69,"end":71,"surface":"項籍","kind":"person","person_id":"cbr-p003427","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m018-0072","start":72,"end":73,"surface":"陵","kind":"person","person_id":"cbr-p003455","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m018-0079","start":79,"end":81,"surface":"項羽","kind":"person","person_id":"cbr-p003427","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m018-0082","start":82,"end":84,"surface":"陵母","kind":"person","person_id":"cbr-p003456","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m0