19","start":119,"end":121,"surface":"淖齒","kind":"person","person_id":"fvc_9z0_643","status":"contextual_provisional","paragraph_id":"c-shiji-046-tian:p047","chapter_id":"c-shiji-046-tian"},{"id":"c-shiji-046-tian:m048-0051","start":51,"end":53,"surface":"淖齒","kind":"person","person_id":"fvc_9z0_643","status":"contextual_provisional","paragraph_id":"c-shiji-046-tian:p048","chapter_id":"c-shiji-046-tian"}],"relations":[],"title_holdings":[{"id":"th-shiji046-047","person_id":"fvc_9z0_643","title":"相齊","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-046-tian","source_id":"s-shiji-046-tian","paragraph_id":"c-shiji-046-tian:p047","quote":"四十年，燕、秦、楚、三晉合謀，各出鋭師以伐，敗我濟西。王解而卻。燕將樂毅遂入臨淄，盡取齊之寶藏器。湣王出亡，之衞。衞君辟宮捨之，稱臣而共具。湣王不遜，衞人侵之。湣王去，走鄒、魯，有驕色，鄒、魯君弗内，遂走莒。楚使淖齒將兵救齊，因相齊湣王。淖齒遂殺湣王而與燕共分齊之侵地鹵器。"}],"attestations":[{"id":"th-shiji046-047:a001","paragraph_id":"c-shiji-046-tian:p047","start":114,"end":116,"surface":"相齊","person_mention_id":"c-shiji-046-tian:m047-0119","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予、任事與文獻用稱分存；欲使為卿且辭未當已任，諡稱不當生前任職，死亡或首次用稱不補任期。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji046-108","person_id":"fvc_9z0_643","scope":"same_chapter","chapter_ids":["c-shiji-046-tian"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["淖齒"],"evidence":[{"paragraph_id":"c-shiji-046-tian:p047","quote":"四十年，燕、秦、楚、三晉合謀，各出鋭師以伐，敗我濟西。王解而卻。燕將樂毅遂入臨淄，盡取齊之寶藏器。湣王出亡，之衞。衞君辟宮捨之，稱臣而共具。湣王不遜，衞人侵之。湣王去，走鄒、魯，有驕色，鄒、魯君弗内，遂走莒。楚使淖齒將兵救齊，因相齊湣王。淖齒遂殺湣王而與燕共分齊之侵地鹵器。"},{"paragraph_id":"c-shiji-046-tian:p048","quote":"湣王之遇殺，其子法章變名姓爲莒太史敫家庸。太史敫女奇法章狀貌，以爲非恒人，憐而常竊衣食之，而與私通焉。淖齒旣以去莒，莒中人及齊亡臣相聚求湣王子，欲立之。法章懼其誅己也，久之，乃敢自言「我湣王子也」。於是莒人共立法章，是爲襄王。以保莒城而布告齊國中：「王已立在莒矣。」"}],"rationale":"限本篇明示姓名、是為、繼位及局部事件暫接；姜齊與田齊桓公、不同時段未名王及同字忌分開。孫子不先補孫臏，子守髙唐不補闕字，索隱短稱與代詞仍待核；未跨篇按同名接人。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-046-tian:p047","text":"四十年，燕、秦、楚、三晉合謀，各出鋭師以伐，敗我濟西。王解而卻。燕將樂毅遂入臨淄，盡取齊之寶藏器。湣王出亡，之衞。衞君辟宮捨之，稱臣而共具。湣王不遜，衞人侵之。湣王去，走鄒、魯，有驕色，鄒、魯君弗内，遂走莒。楚使淖齒將兵救齊，因相齊湣王。淖齒遂殺湣王而與燕共分齊之侵地鹵器。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-046-tian:m047-0027","start":27,"end":28,"surface":"王","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、對話、稱謂或索隱述贊短稱待核，不補姓名及成員。"},{"id":"c-shiji-046-tian:m047-0034","start":34,"end":36,"surface":"樂毅","kind":"person","person_id":"o6u_xnt_ls1","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m047-0049","start":49,"end":51,"surface":"湣王","kind":"person","person_id":"zan_qcc_jy5_AAAAAABAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m047-0057","start":57,"end":59,"surface":"衞君","kind":"person","person_id":"gfr_toc_lua","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m047-0070","start":70,"end":72,"surface":"湣王","kind":"person","person_id":"zan_qcc_jy5_AAAAAABAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m047-0080","start":80,"end":82,"surface":"湣王","kind":"person","person_id":"zan_qcc_jy5_AAAAAABAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m047-0093","start":93,"end":97,"surface":"鄒、魯君","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、對話、稱謂或索隱述贊短稱待核，不補姓名及成員。"},{"id":"c-shiji-046-tian:m047-0106","start":106,"end":108,"surface":"淖齒","kind":"person","person_id":"fvc_9z0_643","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m047-0115","start":115,"end":118,"surface":"齊湣王","kind":"person","person_id":"zan_qcc_jy5_AAAAAABAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m047-0119","start":119,"end":121,"surface":"淖齒","kind":"person","person_id":"fvc_9z0_643","status":"contextual_provisional"},{"id":"c-shiji-046-tian: