源權威度。"}],"most_mentioned_source_ids":["s-jinshu-098-jin033-wangji"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-098-jin033-wangji:line049:m0099","start":99,"end":102,"surface":"諸葛瑤","kind":"person","person_id":"zos_oy9_5zj","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line049","chapter_id":"c-jinshu-098-jin033-wangji"},{"id":"c-jinshu-098-jin033-wangji:line077:m0127","start":127,"end":130,"surface":"諸葛瑤","kind":"person","person_id":"zos_oy9_5zj","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line077","chapter_id":"c-jinshu-098-jin033-wangji"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-098-jin033-wangji:line049","text":"敦既得志，暴慢愈甚，四方貢獻多入己府，將相嶽牧悉出其門。徙含為征東將軍、都督揚州江西諸軍事，從弟舒為荊州，彬為江州，邃為徐州。含字處弘，凶頑剛暴，時所不齒，以敦貴重，故曆顯位。敦以沈充、錢鳳為謀主，諸葛瑤、鄧岳、周撫、李恆、謝雍為爪牙。充等並凶險驕恣，共相驅扇，殺戮自己；又大起營府，侵人田宅，發掘古墓，剽掠市道，士庶解體，咸知其禍敗焉。敦從弟豫章太守棱日夜切諫，敦怒，陰殺之。敦無子，養含子應。及敦病甚，拜應為武衛將軍以自副。錢鳳謂敦曰：「脫其不諱，便當以後事付應。」敦曰：「非常之事，豈常人所能！且應年少，安可當大事。我死之後，莫若解眾放兵，歸身朝廷，保全門戶，此計之上也。退還武昌，收兵自守，貢獻不廢，亦中計也。及吾尚存，悉眾而下，萬一僥倖，計之下也。」鳳謂其黨曰：「公之下計，乃上策也。」遂與沈充定謀，須敦死後作難。","annotation_status":"reviewed","text_layer":"received_chapter","mentions":[{"id":"c-jinshu-098-jin033-wangji:line049:m0000","start":0,"end":1,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line049:m0029","start":29,"end":30,"surface":"含","kind":"person","person_id":"mwc_md4_l0g","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line049:m0048","start":48,"end":49,"surface":"舒","kind":"person","person_id":"nbl_2bu_99w","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line049:m0053","start":53,"end":54,"surface":"彬","kind":"person","person_id":"7r6_k52_qji_ABDB","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line049:m0058","start":58,"end":59,"surface":"邃","kind":"person","person_id":"i4e_4wq_2qc","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line049:m0063","start":63,"end":64,"surface":"含","kind":"person","person_id":"mwc_md4_l0g","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line049:m0065","start":65,"end":67,"surface":"處弘","kind":"person","person_id":"mwc_md4_l0g","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line049:m0079","start":79,"end":80,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line049:m0088","start":88,"end":89,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line049:m0090","start":90,"end":92,"surface":"沈充","kind":"person","person_id":"4c2_19b_bf4","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line049:m0093"