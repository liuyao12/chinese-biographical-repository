rt":157,"end":159,"surface":"髙祖","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m024-0170","start":170,"end":172,"surface":"貫髙","kind":"person","person_id":"2t1_1bj_ewv","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m024-0173","start":173,"end":175,"surface":"趙午","kind":"person","person_id":"r42_dd9_xyv","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m024-0176","start":176,"end":179,"surface":"十餘人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定指代保留原文，不補成員姓名。"},{"id":"c-shiji-089-zhanger:m024-0209","start":209,"end":211,"surface":"髙祖","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-089-zhanger","book_id":"b-shiji-089","work_id":"w-shiji","source_id":"s-shiji-089-zhanger"},{"id":"c-shiji-104-tianshu:p001","text":"田叔者，趙陘城人也。其先，齊田氏苗裔也。叔喜劍，學黃老術於樂巨公所。叔為人刻廉自喜，喜游諸公。趙人舉之趙相趙午，午言之趙王張敖所，趙王以為郎中。數歲，切直廉平，趙王賢之，未及遷。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-104-tianshu:m001-0000","start":0,"end":2,"surface":"田叔","kind":"person","person_id":"6bn_yfc_lzi","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m001-0020","start":20,"end":21,"surface":"叔","kind":"person","person_id":"6bn_yfc_lzi","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m001-0029","start":29,"end":32,"surface":"樂巨公","kind":"person","person_id":"st2_0ng_tvo","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m001-0034","start":34,"end":35,"surface":"叔","kind":"person","person_id":"6bn_yfc_lzi","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m001-0053","start":53,"end":55,"surface":"趙午","kind":"person","person_id":"r42_dd9_xyv","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m001-0056","start":56,"end":57,"surface":"午","kind":"person","person_id":"r42_dd9_xyv","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m001-0059","start":59,"end":63,"surface":"趙王張敖","kind":"person","person_id":"agx_sqm_4ou_A","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m001-0065","start":65,"end":67,"surface":"趙王","kind":"person","person_id":"agx_sqm_4ou_A","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m001-0080","start":80,"end":82,"surface":"趙王","kind":"person","person_id":"agx_sqm_4ou_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-104-tianshu","book_id":"b-shiji-104","work_id":"w-shiji","source_id":"s-shiji-104-tianshu"},{"id":"c-shiji-104-tianshu:p002","text":"會陳豨反代，漢七年，高祖往誅之，過趙，趙王張敖自持案進食，禮恭甚，高祖箕踞罵之。是時趙相趙午等數十人皆怒，謂張王曰：「王事上禮備矣，今遇王如是，臣等請為亂。」趙王齧指出血，曰：「先人失國，微陛下，臣等當蟲出。公等柰何言若是！毋復出口矣！」於是貫高等曰：「王長者，不倍德。」卒私相與謀弒上。會事發覺，漢下詔捕趙王及群臣反者。於是趙午等皆自殺，唯貫高就系。是時漢下詔書：「趙有敢隨王者罪三族。」唯孟舒、田叔等十餘人赭衣自髡鉗，稱王家奴，隨趙王敖至長安。貫高事明白，趙王敖得出，廢為宣平侯，乃進言田叔等十餘人。上盡召見，與語，漢廷臣毋能出其右者，上說，盡拜為郡守、諸侯相。叔為漢中守十餘年，會高后崩，諸呂作亂，大臣誅之，立孝文帝。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-104-tianshu:m002-0001","start":1,"end":3,"surface":"陳豨","kind":"person","person_id":"1xx_s1v_svn","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m002-0010","start":10,"end":12,"surface":"高祖","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m002-0019","start":19,"end":23,"surface":"趙王張敖","kind":"person","person_id":"agx_sqm_4ou_A","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m002-0033","start":33,"end":35,"surface":"高祖","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m002-0044","start":44,"end":46,"surface":"趙午","kind":"person","person_id":"r42_dd9_xyv","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m002-0054","start":54,"end":56,"surface":"張王","kind":"person","person_id":"agx_sqm_4ou_A","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m002-0061","start":61,"end":62,"surface":"上","kind":"person","person_id