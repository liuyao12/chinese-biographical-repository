":"c-shiji-104-tianshu:m001-0056","mention_ids":["c-shiji-104-tianshu:m001-0056"],"kind":"paragraph"},{"canonical_mention_id":"c-shiji-104-tianshu:m002-0044","mention_ids":["c-shiji-104-tianshu:m002-0044"],"kind":"paragraph"},{"canonical_mention_id":"c-shiji-104-tianshu:m002-0163","mention_ids":["c-shiji-104-tianshu:m002-0163"],"kind":"paragraph"}],"mention_count":4,"duplicate_mention_count":0,"paragraph_occurrence_count":4,"table_occurrence_count":0,"passage_count":2,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"4處獨立位置，4個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"},{"source_id":"s-shiji-089-zhanger","work_id":"w-shiji","book_id":"b-shiji-089","chapter_id":"c-shiji-089-zhanger","raw_mention_count":2,"mention_ids":["c-shiji-089-zhanger:m024-0049","c-shiji-089-zhanger:m024-0173"],"paragraph_ids":["c-shiji-089-zhanger:p024"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-shiji-089-zhanger:m024-0049","mention_ids":["c-shiji-089-zhanger:m024-0049"],"kind":"paragraph"},{"canonical_mention_id":"c-shiji-089-zhanger:m024-0173","mention_ids":["c-shiji-089-zhanger:m024-0173"],"kind":"paragraph"}],"mention_count":2,"duplicate_mention_count":0,"paragraph_occurrence_count":2,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"2處獨立位置，2個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-shiji-104-tianshu"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-shiji104-001","person_id":"r42_dd9_xyv","event_type":"death","status":"source_attested","date_expression":null,"source_term":"於是趙午等皆自殺","evidence":[{"work_id":"w-shiji","book_id":"b-shiji-104","chapter_id":"c-shiji-104-tianshu","source_id":"s-shiji-104-tianshu","paragraph_id":"c-shiji-104-tianshu:p002","quote":"會陳豨反代，漢七年，高祖往誅之，過趙，趙王張敖自持案進食，禮恭甚，高祖箕踞罵之。是時趙相趙午等數十人皆怒，謂張王曰：「王事上禮備矣，今遇王如是，臣等請為亂。」趙王齧指出血，曰：「先人失國，微陛下，臣等當蟲出。公等柰何言若是！毋復出口矣！」於是貫高等曰：「王長者，不倍德。」卒私相與謀弒上。會事發覺，漢下詔捕趙王及群臣反者。於是趙午等皆自殺，唯貫高就系。是時漢下詔書：「趙有敢隨王者罪三族。」唯孟舒、田叔等十餘人赭衣自髡鉗，稱王家奴，隨趙王敖至長安。貫高事明白，趙王敖得出，廢為宣平侯，乃進言田叔等十餘人。上盡召見，與語，漢廷臣毋能出其右者，上說，盡拜為郡守、諸侯相。叔為漢中守十餘年，會高后崩，諸呂作亂，大臣誅之，立孝文帝。","person_mention_id":"c-shiji-104-tianshu:m002-0163"}],"interpretation_note":"等為群體，不補其他具名死亡；貫高就系不是同句自殺。 不以死亡自動終止全部官爵，未核書影。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"age_assertions":[{"id":"age-shiji089-002","person_id":"r42_dd9_xyv","value":null,"source_number":"六十","source_term":"年六十餘","bounds":{"lower":60,"lower_inclusive":false,"upper":null,"upper_inclusive":null},"group_reference":{"source_term":"趙相貫髙、趙午等","naming_term":"貫髙、趙午","person_ids":["2t1_1bj_ewv","r42_dd9_xyv"],"additional_members_unknown":true},"unit":"source_age_years","counting":"unspecified_source_age","birth_year":null,"status":"source_attested","date_expression":"漢七年","evidence":[{"chapter_id":"c-shiji-089-zhanger","source_id":"s-shiji-089-zhanger","paragraph_id":"c-shiji-089-zhanger:p024","quote":"漢七年，髙祖從平城過趙，趙王朝夕袒韛蔽，自上食，禮甚卑，有子婿禮。髙祖箕踞詈，甚慢易之。趙相貫髙、趙午等年六十餘，故張耳客也。生平爲氣，乃怒曰：「吾王孱王也！」説王曰：「夫天下豪桀并起，能者先立。今王事髙祖甚恭，而髙祖無禮，請爲王殺之！」張敖齧其指出血，曰：「君何言之誤！且先人亡國，賴髙祖得復國，德流子孫，秋豪皆髙祖力也。願君無復出口。」貫髙、趙午等十餘人皆相謂曰：「乃吾等非也。吾王長者，不倍德。且吾等義不辱，今怨髙祖辱我王，故欲殺之，何乃汙王爲乎？令事成歸王，事敗獨身坐耳。」","person_mention_id":"c-shiji-089-zhanger:m024-0049"}],"interpretation_note":"具名兩人的群體報齡，等字仍有未名成員，名單不是全體。六十餘只支持大於六十，沒有六十九上限；非死亡年齡，不定計歲法、不反推出生年。","reviewer":"Codex（AI 代理）","human_reviewed":false,"normali