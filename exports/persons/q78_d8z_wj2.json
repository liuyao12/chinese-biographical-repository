nal_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-080-leyi:m019-0065","start":65,"end":68,"surface":"樂臣公","kind":"person","person_id":"q78_d8z_wj2","status":"contextual_provisional","paragraph_id":"c-shiji-080-leyi:p019","chapter_id":"c-shiji-080-leyi"},{"id":"c-shiji-080-leyi:m019-0082","start":82,"end":85,"surface":"樂臣公","kind":"person","person_id":"q78_d8z_wj2","status":"contextual_provisional","paragraph_id":"c-shiji-080-leyi:p019","chapter_id":"c-shiji-080-leyi"},{"id":"c-shiji-080-leyi:m020-0032","start":32,"end":35,"surface":"樂臣公","kind":"person","person_id":"q78_d8z_wj2","status":"contextual_provisional","paragraph_id":"c-shiji-080-leyi:p020","chapter_id":"c-shiji-080-leyi"},{"id":"c-shiji-080-leyi:m020-0087","start":87,"end":90,"surface":"樂臣公","kind":"person","person_id":"q78_d8z_wj2","status":"contextual_provisional","paragraph_id":"c-shiji-080-leyi:p020","chapter_id":"c-shiji-080-leyi"},{"id":"c-shiji-080-leyi:m020-0091","start":91,"end":94,"surface":"樂臣公","kind":"person","person_id":"q78_d8z_wj2","status":"contextual_provisional","paragraph_id":"c-shiji-080-leyi:p020","chapter_id":"c-shiji-080-leyi"}],"relations":[],"title_holdings":[{"id":"th-shiji080-015","person_id":"q78_d8z_wj2","title":"賢師","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-080-leyi","source_id":"s-shiji-080-leyi","paragraph_id":"c-shiji-080-leyi:p019","quote":"其後二十餘年，高帝過趙，問：「樂毅有後世乎？」對曰：「有樂叔。」高帝封之樂卿，號曰華成君。華成君，樂毅之孫也。而樂氏之族有樂瑕公、樂臣公，趙且為秦所滅，亡之齊高密。樂臣公善修黃帝、老子之言，顯聞於齊，稱賢師。"}],"attestations":[{"id":"th-shiji080-016:a001","paragraph_id":"c-shiji-080-leyi:p019","start":101,"end":103,"surface":"賢師","person_mention_id":"c-shiji-080-leyi:m019-0082","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授任與文獻用稱分存；卒、出走及降趙不自動終止所有爵位，未見日期保持未定。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji080-035","person_id":"q78_d8z_wj2","scope":"same_chapter","chapter_ids":["c-shiji-080-leyi"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["樂臣公"],"evidence":[{"paragraph_id":"c-shiji-080-leyi:p019","quote":"其後二十餘年，高帝過趙，問：「樂毅有後世乎？」對曰：「有樂叔。」高帝封之樂卿，號曰華成君。華成君，樂毅之孫也。而樂氏之族有樂瑕公、樂臣公，趙且為秦所滅，亡之齊高密。樂臣公善修黃帝、老子之言，顯聞於齊，稱賢師。"},{"paragraph_id":"c-shiji-080-leyi:p020","quote":"太史公曰：始齊之蒯通及主父偃讀樂毅之報燕王書，未嘗不廢書而泣也。樂臣公學黃帝、老子，其本師號曰河上丈人，不知其所出。河上丈人教安期生，安期生教毛翕公，毛翕公教樂瑕公，樂瑕公教樂臣公，樂臣公教蓋公。蓋公教於齊高密、膠西，為曹相國師。"}],"rationale":"樂閒明示為樂毅子，樂叔明示為孫，不補闕代父親；樂乘為樂閒宗不補兄弟。燕王喜來書及趙襄王君序各限本段，曹相國未見名字不回填。河上丈人至蓋公師承不作父子。依本篇明示姓名、君序與來書答書範圍暫接；燕惠王來書寡人指惠王、將軍指樂毅，樂毅答書先王指昭王、足下君王指惠王。伍子胥引古首吳王指闔閭，後吳王在夫差賜鴟夷後指夫差。父兄與群臣不補具體親屬，王齊為反間假說不作授王爵。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-080-leyi:p019","text":"其後二十餘年，高帝過趙，問：「樂毅有後世乎？」對曰：「有樂叔。」高帝封之樂卿，號曰華成君。華成君，樂毅之孫也。而樂氏之族有樂瑕公、樂臣公，趙且為秦所滅，亡之齊高密。樂臣公善修黃帝、老子之言，顯聞於齊，稱賢師。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-080-leyi:m019-0007","start":7,"end":9,"surface":"高帝","kind":"person","person_id":"4vz_gpf_jlc","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m019-0015","start":15,"end":17,"surface":"樂毅","kind":"person","person_id":"idh_bo6_4kq","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m019-0018","start":18,"end":20,"surface":"後世","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未定後裔保留，不補未見姓名或直接父親。"},{"id":"c-shiji-080-leyi:m019-0028","start":28,"end":30,"surface":"樂叔","kind":"person","person_id":"iyk_qvv_07j","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m019-0032","start":32,"end":34,"surface":"高帝","kind":"person","person_id":"4vz_gpf_jlc","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m019-0041","start":41,"end":44,"surface