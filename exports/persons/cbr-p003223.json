ce":"呂祿女","mention_ids":["c-shiji-052-qidaohui:m005-0024","c-shiji-052-qidaohui:m009-0046"]}],"evidence":[{"mention_id":"c-shiji-052-qidaohui:m005-0024","chapter_id":"c-shiji-052-qidaohui","paragraph_id":"c-shiji-052-qidaohui:p005","quote":"呂祿女"},{"mention_id":"c-shiji-052-qidaohui:m009-0046","chapter_id":"c-shiji-052-qidaohui","paragraph_id":"c-shiji-052-qidaohui:p009","quote":"呂祿女"}]}],"mentions":[{"id":"c-shiji-052-qidaohui:m005-0024","start":24,"end":27,"surface":"呂祿女","kind":"person","person_id":"cbr-p003223","status":"contextual_provisional","paragraph_id":"c-shiji-052-qidaohui:p005","chapter_id":"c-shiji-052-qidaohui"},{"id":"c-shiji-052-qidaohui:m009-0046","start":46,"end":49,"surface":"呂祿女","kind":"person","person_id":"cbr-p003223","status":"contextual_provisional","paragraph_id":"c-shiji-052-qidaohui:p009","chapter_id":"c-shiji-052-qidaohui"}],"relations":[{"id":"a-shiji052-007","subject_person_id":"cbr-p003222","predicate":"spouse","object_person_id":"cbr-p003223","status":"source_attested","evidence":[{"chapter_id":"c-shiji-052-qidaohui","source_id":"s-shiji-052-qidaohui","paragraph_id":"c-shiji-052-qidaohui:p005","quote":"哀王三年，其弟章入宿衛於漢，呂太后封為朱虛侯，以呂祿女妻之。後四年，封章弟興居為東牟侯，皆宿衛長安中。"}],"qualifiers":{"source_term":"以呂祿女妻之","historicity":"historical_tradition"},"interpretation_note":"明示子、生、母、兄弟姊及婚姻分型，繼位不補未記血親；校勘名、母家與未名家屬不擅定姓名，案件敘事不冒稱獨立核定。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji052-010","person_id":"cbr-p003223","surfaces":["呂祿女"],"scope":"same_chapter","chapter_ids":["c-shiji-052-qidaohui"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-052-qidaohui:p005","quote":"哀王三年，其弟章入宿衛於漢，呂太后封為朱虛侯，以呂祿女妻之。後四年，封章弟興居為東牟侯，皆宿衛長安中。"},{"paragraph_id":"c-shiji-052-qidaohui:p009","quote":"其明年，高后崩。趙王呂祿為上將軍，呂王產為相國，皆居長安中，聚兵以威大臣，欲為亂。朱虛侯章以呂祿女為婦，知其謀，乃使人陰出告其兄齊王，欲令發兵西，朱虛侯、東牟侯為內應，以誅諸呂，因立齊王為帝。"}],"rationale":"依明示名與王國、世次的局部敘事暫接；齊、城陽與菑川同諡者分開，興居與志分開。校勘建延及內史勳士未擅選讀法，未名帝后不補姓名，案件只保存來源敘事。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-052-qidaohui:p005","text":"哀王三年，其弟章入宿衛於漢，呂太后封為朱虛侯，以呂祿女妻之。後四年，封章弟興居為東牟侯，皆宿衛長安中。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-052-qidaohui:m005-0000","start":0,"end":2,"surface":"哀王","kind":"person","person_id":"cbr-p003220","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m005-0007","start":7,"end":8,"surface":"章","kind":"person","person_id":"cbr-p003222","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m005-0014","start":14,"end":17,"surface":"呂太后","kind":"person","person_id":"cbr-p003217","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m005-0019","start":19,"end":22,"surface":"朱虛侯","kind":"person","person_id":"cbr-p003222","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m005-0024","start":24,"end":27,"surface":"呂祿女","kind":"person","person_id":"cbr-p003223","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m005-0035","start":35,"end":36,"surface":"章","kind":"person","person_id":"cbr-p003222","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m005-0037","start":37,"end":39,"surface":"興居","kind":"person","person_id":"cbr-p003224","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m005-0040","start":40,"end":43,"surface":"東牟侯","kind":"person","person_id":"cbr-p003224","status":"contextual_provisional"}],"chapter_id":"c-shiji-052-qidaohui","book_id":"b-shiji-052","work_id":"w-shiji","source_id":"s-shiji-052-qidaohui"},{"id":"c-shiji-052-qidaohui:p009","text":"其明年，高后崩。趙王呂祿為上將軍，呂王產為相國，皆居長安中，聚兵以威大臣，欲為亂。朱虛侯章以呂祿女為婦，知其謀，乃使人陰出告其兄齊王，欲令發兵西，朱虛侯、東牟侯為內應，以誅諸呂，因立齊王為帝。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-052-qidaohui:m009-0004","start":4,"end":6,"surface":"高后","kind":"person","person_id":"cbr-p003217","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m009-