":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-079-fancai:m013-0106","start":106,"end":108,"surface":"呂尚","kind":"person","person_id":"bt8_llh_ecr","status":"contextual_provisional","paragraph_id":"c-shiji-079-fancai:p013","chapter_id":"c-shiji-079-fancai"},{"id":"c-shiji-079-fancai:m013-0159","start":159,"end":161,"surface":"呂尚","kind":"person","person_id":"bt8_llh_ecr","status":"contextual_provisional","paragraph_id":"c-shiji-079-fancai:p013","chapter_id":"c-shiji-079-fancai"},{"id":"c-shiji-079-fancai:m013-0172","start":172,"end":174,"surface":"呂尚","kind":"person","person_id":"bt8_llh_ecr","status":"contextual_provisional","paragraph_id":"c-shiji-079-fancai:p013","chapter_id":"c-shiji-079-fancai"},{"id":"c-shiji-079-fancai:m024-0110","start":110,"end":112,"surface":"呂尚","kind":"person","person_id":"bt8_llh_ecr","status":"contextual_provisional","paragraph_id":"c-shiji-079-fancai:p024","chapter_id":"c-shiji-079-fancai"},{"id":"c-shiji-079-fancai:m024-0114","start":114,"end":116,"surface":"太公","kind":"person","person_id":"bt8_llh_ecr","status":"contextual_provisional","paragraph_id":"c-shiji-079-fancai:p024","chapter_id":"c-shiji-079-fancai"}],"relations":[],"title_holdings":[{"id":"th-shiji079-010","person_id":"bt8_llh_ecr","title":"太師","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-079-fancai","source_id":"s-shiji-079-fancai","paragraph_id":"c-shiji-079-fancai:p013","quote":"秦王屏左右，宮中虛無人。秦王跽而請曰：「先生何以幸教寡人？」范睢曰：「唯唯。」有閒，秦王復跽而請曰：「先生何以幸教寡人？」范睢曰：「唯唯。」若是者三。秦王跽曰：「先生卒不幸教寡人邪？」范睢曰：「非敢然也。臣聞昔者呂尚之遇文王也，身為漁父而釣於渭濱耳。若是者，交疏也。已說而立為太師，載與俱歸者，其言深也。故文王遂收功於呂尚而卒王天下。鄉使文王疏呂尚而不與深言，是周無天子之德，而文武無與成其王業也。今臣羈旅之臣也，交疏於王，而所願陳者皆匡君之事，處人骨肉之閒，願效愚忠而未知王之心也。此所以王三問而不敢對者也。臣非有畏而不敢言也。臣知今日言之於前而明日伏誅於後，然臣不敢避也。大王信行臣之言，死不足以為臣患，亡不足以為臣憂，漆身為厲被髪為狂不足以為臣恥。且以五帝之聖焉而死，三王之仁焉而死，五伯之賢焉而死，烏獲、任鄙之力焉而死，成荊、孟賁、王慶忌、夏育之勇焉而死。死者，人之所必不免也。處必然之勢，可以少有補於秦，此臣之所大願也，臣又何患哉！伍子胥橐載而出昭關，夜行晝伏，至於陵水，無以糊其口，厀行蒲伏，稽首肉袒，鼓腹吹篪，乞食於吳市，卒興吳國，闔閭為伯。使臣得盡謀如伍子胥，加之以幽囚，終身不復見，是臣之說行也，臣又何憂？箕子、接輿漆身為厲，被髪為狂，無益於主。假使臣得同行於箕子，可以有補於所賢之主，是臣之大榮也，臣有何恥？臣之所恐者，獨恐臣死之後，天下見臣之盡忠而身死，因以是杜口裹足，莫肯鄉秦耳。足下上畏太后之嚴，下惑於姦臣之態，居深宮之中，不離阿保之手，終身迷惑，無與昭姦。大者宗廟滅覆，小者身以孤危，此臣之所恐耳。若夫窮辱之事，死亡之患，臣不敢畏也。臣死而秦治，是臣死賢於生。」秦王跽曰：「先生是何言也！夫秦國辟遠，寡人愚不肖，先生乃幸辱至於此，是天以寡人慁先生而存先王之宗廟也。寡人得受命於先生，是天所以幸先王，而不棄其孤也。先生柰何而言若是！事無小大，上及太后，下至大臣，願先生悉以教寡人，無疑寡人也。」范睢拜，秦王亦拜。"}],"attestations":[{"id":"th-shiji079-010:a001","paragraph_id":"c-shiji-079-fancai:p013","start":138,"end":140,"surface":"太師","person_mention_id":"c-shiji-079-fancai:m013-0159","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-079-fancai","source_id":"s-shiji-079-fancai","paragraph_id":"c-shiji-079-fancai:p013","quote":"秦王屏左右，宮中虛無人。秦王跽而請曰：「先生何以幸教寡人？」范睢曰：「唯唯。」有閒，秦王復跽而請曰：「先生何以幸教寡人？」范睢曰：「唯唯。」若是者三。秦王跽曰：「先生卒不幸教寡人邪？」范睢曰：「非敢然也。臣聞昔者呂尚之遇文王也，身為漁父而釣於渭濱耳。若是者，交疏也。已說而立為太師，載與俱歸者，其言深也。故文王遂收功於呂尚而卒王天下。鄉使文王疏呂尚而不與深言，是周無天子之德，而文武無與成其王業也。今臣羈旅之臣也，交疏於王，而所願陳者皆匡君之事，處人骨肉之閒，願效愚忠而未知王之心也。此所以王三問而不敢對者也。臣非有畏而不敢言也。臣知今日言之於前而明日伏誅於後，然臣不敢避也。大王信行臣之言，死不足以為臣患，亡不足以為臣憂，漆身為厲被髪為狂不足以為臣恥。且以五帝之聖焉而死，三王之仁焉而死，五伯之賢焉而死，烏獲、任鄙之力焉而死，成荊、孟賁、王慶忌、夏育之勇焉而死。死者，人之所必不免也。處必然之勢，可以少有補於秦，此臣之所大願也，臣又何患哉！伍子胥橐載而出昭關，夜行晝伏，至於陵水，無以糊其口，厀行蒲伏，稽首肉袒，鼓腹吹篪，乞食於吳市，卒興吳國，闔閭為伯。使臣得盡謀如伍子胥，加之以幽囚，終身不復見，是臣之說行也，臣又何憂？箕子、接輿漆身為厲，被髪為狂，無益於主。假使臣得同行於箕子，可以有補於所賢之主，是臣之大榮也，臣有何恥？臣之所恐者，獨恐臣死之後，天下見臣之盡忠而身死，因以是杜口裹足，莫肯鄉秦耳。足下上畏太后之嚴，下惑於姦臣之態，居深宮之中，不離阿保之手，終身迷惑，無與昭姦。大者宗廟滅覆，小者身以孤危，此臣之所恐耳。若夫窮辱之事，死亡之患，臣不敢畏也。臣死而秦治，是臣死賢於生。」秦王跽曰：「先生是何言也！夫秦國辟遠，寡人愚不肖，先生乃幸辱至於此，是天以寡人慁先生而存先王之宗廟也。寡人得受命於先生，是天所以幸先王，而不棄其孤也。先生柰何而言若是！事無小大，上及太后，下至大臣，願先生悉以教寡人，無疑寡人也。」范睢拜，秦王亦拜。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授任、實際去職及用稱分存，首次出現、降敵、出走、被誅與死亡不自動終止全部官爵；叔父仲父太公為尊稱不推血緣。擬長為應侯、稱孤與黃金印紫綬願望不當實授。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_con