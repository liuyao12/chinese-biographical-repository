"source_identified"},{"id":"c-shiji-003-yin:m011-0049","start":49,"end":52,"surface":"帝中壬","kind":"person","person_id":"t3y_v2v_ipe","status":"source_identified"},{"id":"c-shiji-003-yin:m011-0053","start":53,"end":56,"surface":"帝中壬","kind":"person","person_id":"t3y_v2v_ipe","status":"source_identified"},{"id":"c-shiji-003-yin:m011-0063","start":63,"end":65,"surface":"伊尹","kind":"person","person_id":"itn_zi2_il4","status":"source_identified"},{"id":"c-shiji-003-yin:m011-0067","start":67,"end":69,"surface":"太丁","kind":"person","person_id":"tlt_5h1_n6y","status":"source_identified"},{"id":"c-shiji-003-yin:m011-0071","start":71,"end":73,"surface":"太甲","kind":"person","person_id":"2qj_hw4_si9","status":"source_identified"},{"id":"c-shiji-003-yin:m011-0074","start":74,"end":76,"surface":"太甲","kind":"person","person_id":"2qj_hw4_si9","status":"source_identified"},{"id":"c-shiji-003-yin:m011-0077","start":77,"end":79,"surface":"成湯","kind":"person","person_id":"tpz_x3m_e0h","status":"source_identified"},{"id":"c-shiji-003-yin:m011-0086","start":86,"end":89,"surface":"帝太甲","kind":"person","person_id":"2qj_hw4_si9","status":"source_identified"},{"id":"c-shiji-003-yin:m011-0090","start":90,"end":93,"surface":"帝太甲","kind":"person","person_id":"2qj_hw4_si9","status":"source_identified"},{"id":"c-shiji-003-yin:m011-0096","start":96,"end":98,"surface":"伊尹","kind":"person","person_id":"itn_zi2_il4","status":"source_identified"}],"chapter_id":"c-shiji-003-yin","book_id":"b-shiji-003","work_id":"w-shiji","source_id":"s-shiji-003-yin"},{"id":"c-shiji-003-yin:p012","text":"帝太甲既立三年，不明，暴虐，不遵湯法，亂德，於是伊尹放之於桐宮。三年，伊尹攝行政當國，以朝諸侯。","mentions":[{"id":"c-shiji-003-yin:m012-0000","start":0,"end":3,"surface":"帝太甲","kind":"person","person_id":"2qj_hw4_si9","status":"source_identified"},{"id":"c-shiji-003-yin:m012-0016","start":16,"end":17,"surface":"湯","kind":"person","person_id":"tpz_x3m_e0h","status":"source_identified"},{"id":"c-shiji-003-yin:m012-0024","start":24,"end":26,"surface":"伊尹","kind":"person","person_id":"itn_zi2_il4","status":"source_identified"},{"id":"c-shiji-003-yin:m012-0035","start":35,"end":37,"surface":"伊尹","kind":"person","person_id":"itn_zi2_il4","status":"source_identified"}],"chapter_id":"c-shiji-003-yin","book_id":"b-shiji-003","work_id":"w-shiji","source_id":"s-shiji-003-yin"},{"id":"c-shiji-003-yin:p013","text":"帝太甲居桐宮三年，悔過自責，反善，於是伊尹迺迎帝太甲而授之政。帝太甲修德，諸侯咸歸殷，百姓以寧。伊尹嘉之，迺作太甲訓三篇，襃帝太甲，稱太宗。","mentions":[{"id":"c-shiji-003-yin:m013-0000","start":0,"end":3,"surface":"帝太甲","kind":"person","person_id":"2qj_hw4_si9","status":"source_identified"},{"id":"c-shiji-003-yin:m013-0019","start":19,"end":21,"surface":"伊尹","kind":"person","person_id":"itn_zi2_il4","status":"source_identified"},{"id":"c-shiji-003-yin:m013-0023","start":23,"end":26,"surface":"帝太甲","kind":"person","person_id":"2qj_hw4_si9","status":"source_identified"},{"id":"c-shiji-003-yin:m013-0031","start":31,"end":34,"surface":"帝太甲","kind":"person","person_id":"2qj_hw4_si9","status":"source_identified"},{"id":"c-shiji-003-yin:m013-0048","start":48,"end":50,"surface":"伊尹","kind":"person","person_id":"itn_zi2_il4","status":"source_identified"},{"id":"c-shiji-003-yin:m013-0062","start":62,"end":65,"surface":"帝太甲","kind":"person","person_id":"2qj_hw4_si9","status":"source_identified"},{"id":"c-shiji-003-yin:m013-0067","start":67,"end":69,"surface":"太宗","kind":"person","person_id":"2qj_hw4_si9","status":"source_identified"}],"chapter_id":"c-shiji-003-yin","book_id":"b-shiji-003","work_id":"w-shiji","source_id":"s-shiji-003-yin"},{"id":"c-shiji-003-yin:p014","text":"太宗崩，子沃丁立。帝沃丁之時，伊尹卒。既葬伊尹於亳，咎單遂訓伊尹事，作沃丁。","mentions":[{"id":"c-shiji-003-yin:m014-0000","start":0,"end":2,"surface":"太宗","kind":"person","person_id":"2qj_hw4_si9","status":"source_identified"},{"id":"c-shiji-003-yin:m014-0005","start":5,"end":7,"surface":"沃丁","kind":"person","person_id":"t5l_nxu_k7z","status":"source_identified"},{"id":"c-shiji-003-yin:m014-0009","start":9,"end":12,"surface":"帝沃丁","kind":"person","person_id":"t5l_nxu_