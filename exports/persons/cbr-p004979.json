iji089-001","subject_person_id":"cbr-p004983","predicate":"spouse","object_person_id":"cbr-p004979","status":"source_attested","evidence":[{"chapter_id":"c-shiji-089-zhanger","source_id":"s-shiji-089-zhanger","paragraph_id":"c-shiji-089-zhanger:p001","quote":"張耳者，大梁人也。其少時，及魏公子毋忌爲客。張耳嘗亡命游外黃。外黃富人女甚美，嫁庸奴，亡其夫，去抵父客。父客素知張耳，乃謂女曰：「必欲求賢夫，從張耳。」女聽，乃卒爲請決，嫁之張耳。張耳是時脱身游，女家厚奉給張耳，張耳以故致千里客。乃宦魏爲外黃令。名由此益賢。"}],"qualifiers":{"source_term":"嫁之張耳","historicity":"historical_tradition"},"interpretation_note":"按明示親屬保存；父事不作父系，他姬不補姓名或推二子同母。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji089-002","person_id":"cbr-p004979","surfaces":["外黃富人女","女"],"scope":"same_chapter","chapter_ids":["c-shiji-089-zhanger"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-089-zhanger:p001","quote":"張耳者，大梁人也。其少時，及魏公子毋忌爲客。張耳嘗亡命游外黃。外黃富人女甚美，嫁庸奴，亡其夫，去抵父客。父客素知張耳，乃謂女曰：「必欲求賢夫，從張耳。」女聽，乃卒爲請決，嫁之張耳。張耳是時脱身游，女家厚奉給張耳，張耳以故致千里客。乃宦魏爲外黃令。名由此益賢。"}],"rationale":"按同段姓名及明示局部承接；未名人物獨立保留，父事不作父系。周文與周章先分候選，待跨段事件證據再接。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-089-zhanger:p001","text":"張耳者，大梁人也。其少時，及魏公子毋忌爲客。張耳嘗亡命游外黃。外黃富人女甚美，嫁庸奴，亡其夫，去抵父客。父客素知張耳，乃謂女曰：「必欲求賢夫，從張耳。」女聽，乃卒爲請決，嫁之張耳。張耳是時脱身游，女家厚奉給張耳，張耳以故致千里客。乃宦魏爲外黃令。名由此益賢。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-089-zhanger:m001-0000","start":0,"end":2,"surface":"張耳","kind":"person","person_id":"cbr-p004983","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m001-0014","start":14,"end":19,"surface":"魏公子毋忌","kind":"person","person_id":"cbr-p004978","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m001-0022","start":22,"end":24,"surface":"張耳","kind":"person","person_id":"cbr-p004983","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m001-0031","start":31,"end":36,"surface":"外黃富人女","kind":"person","person_id":"cbr-p004979","st