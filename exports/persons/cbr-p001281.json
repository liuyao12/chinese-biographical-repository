],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji033-152","person_id":"cbr-p001281","surfaces":["郈昭伯"],"scope":"same_chapter","chapter_ids":["c-shiji-033-lu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-033-lu:p075","quote":"季氏與郈氏鬬雞，季氏芥雞羽，郈氏金距。季平子怒而侵郈氏，郈昭伯亦怒平子。臧昭伯之弟會偽讒臧氏，匿季氏，臧昭伯囚季氏人。季平子怒，囚臧氏老。臧、郈氏以難告昭公。昭公九月戊戌伐季氏，遂入。平子登臺請曰：『君以讒不察臣罪，誅之，請遷沂上。』弗許。請囚於鄪，弗許。請以五乘亡，弗許。子家駒曰：『君其許之。政自季氏久矣，爲徒者眾，眾將合謀。』弗聽。郈氏曰：『必殺之。』叔孫氏之臣戾謂其眾曰：『無季氏與有，孰利？』皆曰：『無季氏是無叔孫氏。』戾曰：『然，救季氏！』遂敗公師。孟懿子聞叔孫氏勝，亦殺郈昭伯。郈昭伯爲公使，故孟氏得之。三家共伐公，公遂奔。己亥，公至于齊。齊景公曰：『請致千社待君。』子家曰：『棄周公之業而臣於齊，可乎？』乃止。子家曰：『齊景公無信，不如早之晉。』弗從。叔孫見公還，見平子，平子頓首。初欲迎昭公，孟孫、季孫後悔，乃止。"}],"rationale":"按文公以後立嗣、昭公出奔、夾谷會盟、徵百牢與魯君世系的具體事件及國別暫定異稱，後期同爵稱不與先君混同。身份、匿名指代與數位疑讀待覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-033-lu:p075","text":"季氏與郈氏鬬雞，季氏芥雞羽，郈氏金距。季平子怒而侵郈氏，郈昭伯亦怒平子。臧昭伯之弟會偽讒臧氏，匿季氏，臧昭伯囚季氏人。季平子怒，囚臧氏老。臧、郈氏以難告昭公。昭公九月戊戌伐季氏，遂入。平子登臺請曰：『君以讒不察臣罪，誅之，請遷沂上。』弗許。請囚於鄪，弗許。請以五乘亡，弗許。子家駒曰：『君其許之。政自季氏久矣，爲徒者眾，眾將合謀。』弗聽。郈氏曰：『必殺之。』叔孫氏之臣戾謂其眾曰：『無季氏與有，孰利？』皆曰：『無季氏是無叔孫氏。』戾曰：『然，救季氏！』遂敗公師。孟懿子聞叔孫氏勝，亦殺郈昭伯。郈昭伯爲公使，故孟氏得之。三家共伐公，公遂奔。己亥，公至于齊。齊景公曰：『請致千社待君。』子家曰：『棄周公之業而臣於齊，可乎？』乃止。子家曰：『齊景公無信，不如早之晉。』弗從。叔孫見公還，見平子，平子頓首。初欲迎昭公，孟孫、季孫後悔，乃止。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-033-lu:m075-0000","start":0,"end":2,"surface":"季氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未指名者、論贊署稱、地點氏稱或未定指代；不補姓名、爵位與成員。"},{"id":"c-shiji-033-lu:m075-0003","start":3,"end":5,"surface":"郈氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未指名者、論贊署稱、地點氏稱或未定指代；不補姓名、爵位與成員。"},{"id":"c-shiji-033-lu:m075-0008","start":8,"end":10,"surface":"季氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未指名者、論贊署稱、地點氏稱或未定指代；不補姓名、爵位與成員。"},{"id":"c-shiji-033-lu:m075-0014","start":14,"end":16,"surface":"郈氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未指名者、論贊署稱、地點氏稱或未定