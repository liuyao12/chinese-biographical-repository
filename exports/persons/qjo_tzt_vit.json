ay_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-056-jiang-tong:p011:m0010","surface":"春","start":10,"end":11,"person_id":"qjo_tzt_vit","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-056-jiang-tong:p011","chapter_id":"c-jinshu-056-jiang-tong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-056-jiang-tong:p011","text":"遷中郎。選司以統叔父春為宜春令，統因上疏曰：「故事，父祖與官職同名，皆得改選，而未有身與官職同名，不在改選之例。臣以為父祖改選者，蓋為臣子開地，不為父祖之身也。而身名所加，亦施于臣子。佐吏系屬，朝夕從事，官位之號，發言所稱，若指實而語，則違經禮諱尊之義；若詭辭避回，則為廢官擅犯憲制。今以四海之廣，職位之眾，名號繁多，士人殷富，至使有受寵皇朝，出身宰牧，而令佐吏不得表其官稱，子孫不得言其位號，所以上嚴君父，下為臣子，體例不通。若易私名以避官職，則違《春秋》不奪人親之義。臣以為身名與官職同者，宜與觸父祖名為比，體例既全，於義為弘。」朝廷從之。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":31,"last_line":31,"raw_start":3174,"raw_end":3452,"raw_character_offsets":[3176,3177,3178,3179,3180,3181,3182,3183,3184,3185,3186,3187,3188,3189,3190,3191,3192,3193,3194,3195,3196,3197,3198,3199,3200,3201,3202,3203,3204,3205,3206,3207,3208,3209,3210,3211,3212,3213,3214,3215,3216,3217,3218,3219,3220,3221,3222,3223,3224,3225,3226,3227,3228,3229,3230,3231,3232,3233,3234,3235,3236,3237,3238,3239,3240,3241,3242,3243,3244,3245,3246,3247,3248,3249,3250,3251,3252,3253,3254,3255,3256,3257,3258,3259,3260,3261,3262,3263,3264,3265,3266,3267,3268,3269,3270,3271,3272,3273,3274,3275,3276,3277,3278,3279,3280,3281,3282,3283,3284,3285,3286,3287,3288,3289,3290,3291,3292,3293,3294,3295,3296,3297,3298,3299,3300,3301,3302,3303,3304,3305,3306,3307,3308,3309,3310,3311,3312,3313,3314,3315,3316,3317,3318,3319,3320,3321,3322,3323,3324,3325,3326,3327,3328,3329,3330,3331,3332,3333,3334,3335,3336,3337,3338,3339,3340,3341,3342,3343,3344,3345,3346,3347,3348,3349,3350,3351,3352,3353,3354,3355,3356,3357,3358,3359,3360,3361,3362,3363,3364,3365,3366,336