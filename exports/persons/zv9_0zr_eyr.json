-minhuai-yu:p011:m0052","start":52,"end":53,"surface":"尚","kind":"person","person_id":"zv9_0zr_eyr","status":"contextual_provisional"}],"chapter_id":"c-jinshu-053-minhuai-yu","book_id":"b-jinshu-053","work_id":"w-jinshu","source_id":"s-jinshu-053-minhuai-yu-ws2595666"},{"id":"c-jinshu-053-sima-shang:p001","text":"尚字敬仁。永康元年四月，封為襄陽王。永寧元年八月，立為皇太孫。太安元年三月癸卯，薨，帝服齊衰期，諡曰沖太孫。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":40,"last_line":40,"raw_start":4262,"raw_end":4337,"raw_character_offsets":[4262,4263,4264,4265,4266,4272,4273,4274,4275,4278,4279,4280,4281,4282,4283,4284,4285,4286,4292,4293,4294,4295,4298,4299,4300,4301,4302,4303,4304,4305,4306,4312,4313,4314,4315,4318,4319,4320,4321,4322,4323,4324,4325,4326,4327,4328,4329,4330,4331,4332,4333,4334,4335,4336],"revision_id":2595666},"mentions":[{"id":"c-jinshu-053-sima-shang:p001:m0000","start":0,"end":1,"surface":"尚","kind":"person","person_id":"zv9_0zr_eyr","status":"contextual_provisional"},{"id":"c-jinshu-053-sima-shang:p001:m0002","start":2,"end":4,"surface":"敬仁","kind":"person","person_id":"zv9_0zr_eyr","status":"contextual_provisional"}],"chapter_id":"c-jinshu-053-sima-shang","book_id":"b-jinshu-053","work_id":"w-jinshu","source_id":"s-jinshu-053-sima-shang-ws2595666"},{"id":"c-jinshu-064-simaqin:p001","text":"及沖太孫薨，齊王冏表曰：「東宮曠然，塚嗣莫繼。天下大業，帝王神器，必建儲副，以固洪基。今者後宮未有孕育，不可庶幸將來而虛天緒，非祖宗之遺志，社稷之長計也。禮，兄弟之子猶子，故漢成無嗣，繼由定陶；孝和之絕，安以紹興。此先王之令典，往代之成式也。清河王覃神姿岐嶷，慧智早成，康王正妃周氏所生，先帝眾孫之中，於今為嫡。昔薄姬賢明，文則承位。覃外祖恢世載名德，覃宜奉宗廟之重，統無窮之祚，以甯四海顒顒之望。覃兄弟雖並出紹，可簡令淑還為國胤，不替其嗣。輒諮大將軍穎及群公卿士，咸同大願。請具禮儀，擇日迎拜。」遂立覃為皇太子。既而河間王顒協遷大駕，表成都王穎為皇太弟，廢覃復為清河王。初，覃為清河世子，所佩金鈴欻生隱起如麻粟，祖母陳太妃以為不祥，毀而賣之。占者以金是晉行大興之祥，覃為皇胤，是其瑞也。毀而賣之，象覃見廢不終之驗也。永嘉初，前北軍中候任城呂雍、度支校尉陳顏等謀立覃為太子，事覺，幽于金墉城。未幾，被害，時年十四，葬以庶人禮。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":46,"last_line":46,"raw_start":2539,"raw_end":2954,"raw_character_offsets":[2541,2542,2543,2544,2545,2546,2547,2548,2549,2550,2551,2552,2553,2554,2555,2556,2557,2