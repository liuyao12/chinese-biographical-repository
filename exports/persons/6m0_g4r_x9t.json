erson_id":"8s8_8m3_upb","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0026","start":26,"end":28,"surface":"弟子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m020-0045","start":45,"end":48,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0069","start":69,"end":71,"surface":"學士","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m020-0076","start":76,"end":78,"surface":"今上","kind":"person","person_id":"o7s_89o_zka","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0154","start":154,"end":157,"surface":"主父偃","kind":"person","person_id":"65g_b5h_fvh","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0165","start":165,"end":167,"surface":"天子","kind":"person","person_id":"o7s_89o_zka","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0168","start":168,"end":170,"surface":"天子","kind":"person","person_id":"o7s_89o_zka","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0171","start":171,"end":173,"surface":"諸生","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m020-0181","start":181,"end":184,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0184","start":184,"end":186,"surface":"弟子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m020-0186","start":186,"end":189,"surface":"呂步舒","kind":"person","person_id":"r6k_uj1_o5h","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0203","start":203,"end":206,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0217","start":217,"end":220,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"}],"chapter_id":"c-shiji-121-rulin","book_id":"b-shiji-121","work_id":"w-shiji","source_id":"s-shiji121-rulin"},{"id":"c-shiji-121-rulin:p021","text":"董仲舒為人廉直。是時方外攘四夷，公孫弘治春秋不如董仲舒，而弘希世用事，位至公卿。董仲舒以弘為從諛。弘疾之，乃言上曰：「獨董仲舒可使相繆西王。」膠西王素聞董仲舒有行，亦善待之。董仲舒恐久獲罪，疾免居家。至卒，終不治產業，以修學著書為事。故漢興至于五世之閒，唯董仲舒名為明於春秋，其傳公羊氏也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m021-0000","start":0,"end":3,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m021-0016","start":16,"end":19,"surface":"公孫弘","kind":"person","person_id":"kx7_5kz_ot4","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m021-0024","start":24,"end":27,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m021-0029","start":29,"end":30,"surface":"弘","kind":"person","person_id":"kx7_5kz_ot4","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m021-0040","start":40,"end":43,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m021-0044","start":44,"end":45,"surface":"弘","kind":"person","person_id":"kx7_5kz_ot4","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m021-0049","start":49,"end":50,"surface":"弘","kind":"person","person_id":"kx7_5kz_ot4","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m021-0055","start":55,"end":56,"surface":"上","kind":"person","person_id":"o7s_89o_zka","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m021-0060","start":60,"end":63,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m021-0066","start":66,"end":69,"surface":"繆西王","kind":"person","person_id":"6hs_665_32d","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m021-0071","start":71,"end":74,"surface":"膠西王","kind":"person","person_id":"6hs_665_32d","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m021-0076","start":76,"end":79,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m021-0087","start":87,"end":90,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m021-0128","start":128,"end":131,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m021-0140","start":140,"end":143,"surface":"公羊氏","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-121-rulin","book_id":"b-shiji-121","work_id":"w-shiji","source_id":"s-shiji121-rulin"},{"id":"c-shiji-121-rulin:p023","text":"瑕丘江生為穀梁春秋。自公孫弘得用，嘗集比其義，卒用董仲舒。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m023-0002","start":2,"end":4,"surface":"江生","kind":"person","person_id":"6ut_w3h_23p","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m023-0011","start":11,"end":14,"surface":"公孫弘","kind":"person","person_id":"kx7_5kz_ot4","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m023-0025","start":25,"end":28,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"}],"chapter_id":"c-shiji-121-rulin","book_id":"b-shiji-121","work_id":"w-shiji","source_id":"s-shiji121-rulin"},{"id":"c-shiji-121-rulin:p024","text":"仲舒弟子遂者：蘭陵褚大，廣川殷忠，溫呂步舒。褚大至梁相。步舒至長史，持節使決淮南獄，於諸侯擅專斷，不報，以春秋之義正之，天子皆以為是。弟子通者，至於命大夫；為郎、謁者、掌故者以百數。而董仲舒子及孫皆以學至大官。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m024-0000","start":0,"end":2,"surface":"仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m024-0002","start":2,"end":4,"surface":"弟子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m024-0009","start":9,"end":11,"surface":"褚大","kind":"person","person_id":"tgy_zyu_6ro","status":"contextual_provisional"},{"id":"c-shiji-12