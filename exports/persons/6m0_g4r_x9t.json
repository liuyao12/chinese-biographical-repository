c-shiji-121-rulin"},{"id":"c-shiji-121-rulin:m024-0000","start":0,"end":2,"surface":"仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional","paragraph_id":"c-shiji-121-rulin:p024","chapter_id":"c-shiji-121-rulin"},{"id":"c-shiji-121-rulin:m024-0092","start":92,"end":95,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional","paragraph_id":"c-shiji-121-rulin:p024","chapter_id":"c-shiji-121-rulin"}],"relations":[],"title_holdings":[{"id":"th-shiji121-042","person_id":"6m0_g4r_x9t","title":"博士","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-121-rulin","source_id":"s-shiji121-rulin","paragraph_id":"c-shiji-121-rulin:p020","quote":"董仲舒，廣川人也。以治春秋，孝景時為博士。下帷講誦，弟子傳以久次相受業，或莫見其面，蓋三年董仲舒不觀於舍園，其精如此。進退容止，非禮不行，學士皆師尊之。今上即位，為江都相。以春秋災異之變推陰陽所以錯行，故求雨閉諸陽，縱諸陰，其止雨反是。行之一國，未嘗不得所欲。中廢為中大夫，居舍，著災異之記。是時遼東高廟災，主父偃疾之，取其書奏之天子。天子召諸生示其書，有刺譏。董仲舒弟子呂步舒不知其師書，以為下愚。於是下董仲舒吏，當死，詔赦之。於是董仲舒竟不敢復言災異。"}],"attestations":[{"id":"th-shiji121-042:a001","paragraph_id":"c-shiji-121-rulin:p020","start":18,"end":20,"surface":"博士","person_mention_id":"c-shiji-121-rulin:m020-0000","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"依原文區分授任、貶任與用稱；未明日期保持未知，死亡不自動終止官爵。敘事時長不反推公元年。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji121-043","person_id":"6m0_g4r_x9t","title":"江都相","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-121-rulin","source_id":"s-shiji121-rulin","paragraph_id":"c-shiji-121-rulin:p020","quote":"董仲舒，廣川人也。以治春秋，孝景時為博士。下帷講誦，弟子傳以久次相受業，或莫見其面，蓋三年董仲舒不觀於舍園，其精如此。進退容止，非禮不行，學士皆師尊之。今上即位，為江都相。以春秋災異之變推陰陽所以錯行，故求雨閉諸陽，縱諸陰，其止雨反是。行之一國，未嘗不得所欲。中廢為中大夫，居舍，著災異之記。是時遼東高廟災，主父偃疾之，取其書奏之天子。天子召諸生示其書，有刺譏。董仲舒弟子呂步舒不知其師書，以為下愚。於是下董仲舒吏，當死，詔赦之。於是董仲舒竟不敢復言災異。"}],"attestations":[{"id":"th-shiji121-043:a001","paragraph_id":"c-shiji-121-rulin:p020","start":82,"end":85,"surface":"江都相","person_mention_id":"c-shiji-121-rulin:m020-0000","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"依原文區分授任、貶任與用稱；未明日期保持未知，死亡不自動終止官爵。敘事時長不反推公元年。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji121-044","person_id":"6m0_g4r_x9t","title":"中大夫","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-121-rulin","source_id":"s-shiji121-rulin","paragraph_id":"c-shiji-121-rulin:p020","quote":"董仲舒，廣川人也。以治春秋，孝景時為博士。下帷講誦，弟子傳以久次相受業，或莫見其面，蓋三年董仲舒不觀於舍園，其精如此。進退容止，非禮不行，學士皆師尊之。今上即位，為江都相。以春秋災異之變推陰陽所以錯行，故求雨閉諸陽，縱諸陰，其止雨反是。行之一國，未嘗不得所欲。中廢為中大夫，居舍，著災異之記。是時遼東高廟災，主父偃疾之，取其書奏之天子。天子召諸生示其書，有刺譏。董仲舒弟子呂步舒不知其師書，以為下愚。於是下董仲舒吏，當死，詔赦之。於是董仲舒竟不敢復言災異。"}],"attestations":[{"id":"th-shiji121-044:a001","paragraph_id":"c-shiji-121-rulin:p020","start":133,"end":136,"surface":"中大夫","person_mention_id":"c-shiji-121-rulin:m020-0000","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"依原文區分授任、貶任與用稱；未明日期保持未知，死亡不自動終止官爵。敘事時長不反推公元年。","reviewer":"Codex（AI 代理）"}],"address_assertions":[{"id":"pa-shiji121-027","person_id":"6m0_g4r_x9t","relation":"biographical_origin","place":{"source_name":"廣川","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-121-rulin","source_id":"s-shiji121-rulin","paragraph_id":"c-shiji-121-rulin:p020","quote":"董仲舒，廣川人也。以治春秋，孝景時為博士。下帷講誦，弟子傳以久次相受業，或莫見其面，蓋三年董仲舒不觀於舍園，其精如此。進退容止，非禮不行，學士皆師尊之。今上即位，為江都相。以春秋災異之變推陰陽所以錯行，故求雨閉諸陽，縱諸陰，其止雨反是。行之一國，未嘗不得所欲。中廢為中大夫，居舍，著災異之記。是時遼東高廟災，主父偃疾之，取其書奏之天子。天子召諸生示其書，有刺譏。董仲舒弟子呂步舒不知其師書，以為下愚。於是下董仲舒吏，當死，詔赦之。於是董仲舒竟不敢復言災異。"}],"source_term":"廣川人也","interpretation_note":"保留人物介紹中的人地原稱，不推定出生地、居住日期或現代轄區。相鄰人物不自動承受同一原籍。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-121-rulin:p005","text":"及今上即位，趙綰、王臧之屬明儒學，而上亦鄉之，於是招方正賢良文學之士。自是之后，言詩於魯則申培公，於齊則轅固生，於燕則韓太傅。言尚書自濟南伏生。言禮自魯高堂生。言易自菑川田生。言春秋於齊魯自胡毋生，於趙自董仲舒。及竇太后崩，武安侯田蚡為丞相，絀黃老、刑名百家之言，延文學儒者數百人，而公孫弘以春秋白衣為天子三公，封以平津侯。天下之學士靡然鄉風矣。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m005-0001","start":1,"end":3,"surface":"今上","kind":"person","person_id":"o7s_89o_zka","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0006","start":6,"end":8,"surface":"趙綰","kind":"person","person_id":"8dt_22t_v15","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0009","start":9,"end":11,"surface":"王臧","kind":"person","person_id":"fhl_wxh_rfr","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0018","start":18,"end":19,"surface":"上","kind":"person","person_id":"o7s_89o_zka","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0026","start":26,"end":34,"surface":"方正賢良文學之士","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m005-0045","start":45,"end":48,"surface":"申培公","kind":"person","person_id":"wxo_k8i_1it","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0052","start":52,"end":55,"surface":"轅固生","kind":"person","person_id":"b1w_3li_mim","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0059","start":59,"end":62,"surface":"韓太傅","kind":"person","person_id":"r6c_fhk_jo9","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0069","start":69,"end":71,"surface":"伏生","kind":"person","person_id":"t6q_oe6_hom","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0076","start":76,"end":79,"surface":"高堂生","kind":"person","person_id":"5sy_nhd_r99","status":"contextual_provisional"},{"id":"c-shiji