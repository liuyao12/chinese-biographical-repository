030-0429","start":429,"end":432,"surface":"尹翁歸","kind":"person","person_id":"ji8_fud_li3","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0433","start":433,"end":436,"surface":"趙廣漢","kind":"person","person_id":"5dy_3tn_y1j","status":"contextual_provisional"}],"chapter_id":"c-shiji-112-pingjin","book_id":"b-shiji-112","work_id":"w-shiji","source_id":"s-shiji112-pingjin"},{"id":"c-shiji-121-rulin:p005","text":"及今上即位，趙綰、王臧之屬明儒學，而上亦鄉之，於是招方正賢良文學之士。自是之后，言詩於魯則申培公，於齊則轅固生，於燕則韓太傅。言尚書自濟南伏生。言禮自魯高堂生。言易自菑川田生。言春秋於齊魯自胡毋生，於趙自董仲舒。及竇太后崩，武安侯田蚡為丞相，絀黃老、刑名百家之言，延文學儒者數百人，而公孫弘以春秋白衣為天子三公，封以平津侯。天下之學士靡然鄉風矣。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m005-0001","start":1,"end":3,"surface":"今上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0006","start":6,"end":8,"surface":"趙綰","kind":"person","person_id":"8dt_22t_v15","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0009","start":9,"end":11,"surface":"王臧","kind":"person","person_id":"jh5_a7h_pvv","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0018","start":18,"end":19,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0026","start":26,"end":34,"surface":"方正賢良文學之士","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m005-0045","start":45,"end":48,"surface":"申培公","kind":"person","person_id":"wxo_k8i_1it","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0052","start":52,"end":55,"surface":"轅固生","kind":"person","person_id":"b1w_3li_mim","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0059","start":59,"end":62,"surface":"韓太傅","kind":"person","person_id":"r6c_fhk_jo9","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0069","start":69,"end":71,"surface":"伏生","kind":"person","person_id":"t6q_oe6_hom","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0076","start":76,"end":79,"surface":"高堂生","kind":"person","person_id":"5sy_nhd_r99","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0085","start":85,"end":87,"surface":"田生","kind":"person","person_id":"m9h_k61_29i","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0095","start":95,"end":98,"surface":"胡毋生","kind":"person","person_id":"08q_8bd_lr8","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0102","start":102,"end":105,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0107","start":107,"end":110,"surface":"竇太后","kind":"person","person_id":"ixk_6fg_v6f_A","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0115","start":115,"end":117,"surface":"田蚡","kind":"person","person_id":"7mz_d13_9ka_A","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0133","start":133,"end":137,"surface":"文學儒者","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m005-0142","start":142,"end":145,"surface":"公孫弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0151","start":151,"end":153,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0162","start":162,"end":167,"surface":"天下之學士","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-121-rulin","book_id":"b-shiji-121","work_id":"w-shiji","source_id":"s-shiji121-rulin"},{"id":"c-shiji-121-rulin:p020","text":"董仲舒，廣川人也。以治春秋，孝景時為博士。下帷講誦，弟子傳以久次相受業，或莫見其面，蓋三年董仲舒不觀於舍園，其精如此。進退容止，非禮不行，學士皆師尊之。今上即位，為江都相。以春秋災異之變推陰陽所以錯行，故求雨閉諸陽，縱諸陰，其止雨反是。行之一國，未嘗不得所欲。中廢為中大夫，居舍，著災異之記。是時遼東高廟災，主父偃疾之，取其書奏之天子。天子召諸生示其書，有刺譏。董仲舒弟子呂步舒不知其師書，以為下愚。於是下董仲舒吏，當死，詔赦之。於是董仲舒竟不敢復言災異。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m020-0000","start":0,"end":3,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0014","start":14,"end":16,"surface":"孝景","kind":"person","person_id":"yqp_nlb_p1p_ACA","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0026","start":26,"end":28,"surface":"弟子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m020-0045","start":45,"end":48,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0069","start":69,"end":71,"surface":"學士","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m020-0076","start":76,"end":78,"surface":"今上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0154","start":154,"end":157,"surface":"主父偃","kind":"person","person_id":"vbr_ff1_yc4","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0165","start":165,"end":167,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0168","start":168,"end":170,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0171","start":171,"end":173,"surface":"諸生","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m020-0181","start":181,"end":184,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0184","start":184,"end":186,"surface":"弟子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m020-0186","start":186,"end":189,"surface":"呂步舒","kind":"person","person_id":"r6k_uj1_o5h","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0203","start":203,"end":206,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0217","start":217,"end":220,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"}],"chapter_id":"c-shiji-121-rulin","book_id":"b-shiji-121","work_id":"w-shiji","source_id":"s-shiji121-rulin"},{"id":"c-shiji-121-rulin:p021","text":"董仲舒為人廉直。是時方外攘四夷，公孫弘治春秋不如董仲舒，而弘希世用事，位至公卿。董仲舒以弘為從諛。弘疾之，乃言上曰：「獨董仲舒可使相繆西王。」膠西王素聞董仲舒有行，亦善待之。董仲舒恐久獲罪，疾免居家。至卒，終不治產業，以修學著書為事。故漢興至于五世之閒，唯董仲舒名為明於春秋，其傳公羊氏也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m021-0000","start":0,"end":3,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m021-0016","start":16,"end":19,"surface":"公孫弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m021-0024","start":24,"end":27,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m021-0029","start":29,"end":30,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m021-0040","start":40,"end":43,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m021-0044","start":44,"end":45,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m021-0049","start":49,"end":50,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m021-0055","start":55,"end":56,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m021-0060","start":60,"end":63,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m021-0066","start":66,"end":69,"surface":"繆西王","kind":"person","person_id":"yqp_nlb_p1p_ACAN","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m021-0071","start":71,"end":74,"surface":"膠西王","kind":"person","person_id":"yqp_nlb_p1p_ACAN","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m021-0076","start":76,"end":79,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m021-0087","start":87,"end":90,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m021-0128","start":128,"end":131,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m021-0140","start":140,"end":143,"surface":"公羊氏","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-121-rulin","book_id":"b-shiji-121","work_id":"w-shiji","source_id":"s-shiji121-rulin"},{"id":"c-shiji-121-rulin:p023","text":"瑕丘江生為穀梁春秋。自公孫弘得用，嘗集比其義，卒用董仲舒。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m023-0002","start":2,"end":4,"surface":"江生","kind":"person","person_id":"6ut_w3h_23p","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m023-0011","start":11,"end":14,"surface":"公孫弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m023-0025","start":25,"end":28,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"}],"chapter_id":"c-shiji-121-rulin","book_id":"b-shiji-121","work_id":"w-shiji","source_id":"s-shiji121-rulin"},{"id":"c-shiji-121-rulin:p024","text":"仲舒弟子遂者：蘭陵褚大，廣川殷忠，溫呂步舒。褚大至梁相。步舒至長史，持節使決淮南獄，於諸侯擅專斷，不報，以春秋之義正之，天子皆以為是。弟子通者，至於命大夫；為郎、謁者、掌故者以百數。而董仲舒子及孫皆以學至大官。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m024-0000","start":0,"end":2,"surface":"仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m024-0002","start":2,"end":4,"surface":"弟子","kind"