inshu-035-peikai-family:p019:m0056","start":56,"end":58,"surface":"王戎","kind":"person","person_id":"48e_04a_3d8","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p019:m0059","start":59,"end":60,"surface":"邈","kind":"person","person_id":"sra_yp5_n8o","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p019:m0061","start":61,"end":64,"surface":"王玄雲","kind":"unresolved","person_id":null,"status":"unresolved"}],"source_position":{"first_line":113,"last_line":113,"revision_id":2506399,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-035-peikai-family","book_id":"b-jinshu-035","work_id":"w-jinshu","source_id":"s-jinshu-035-peikai-ws2506399"},{"id":"c-jinshu-043-wangrong:p002","text":"阮籍與渾為友。戎年十五，隨渾在郎舍。戎少籍二十歲，而籍與之交。籍每適渾，俄頃輒去，過視戎，良久然後出。謂渾曰：「濬沖清賞，非卿倫也。共卿言，不如共阿戎談。」及渾卒於涼州，故吏賻贈數百萬，戎辭而不受，由是顯名。為人短小，任率不修威儀，善發談端，賞其要會。朝賢嘗上巳禊洛，或問王濟曰：「昨游有何言談？」濟曰：「張華善說《史》《漢》；裴頠論前言往行，袞袞可聽；王戎談子房、季劄之間，超然玄著。」其為識鑒者所賞如此。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-043-wangrong:p002:m0000","start":0,"end":2,"surface":"阮籍","kind":"person","person_id":"6d5_075_29b","status":"contextual_provisional","resolution_note":"渾/籍/戎三端對話分辨；王濟轉述張華、裴頠與引古子房季劄。"},{"id":"c-jinshu-043-wangrong:p002:m0003","start":3,"end":4,"surface":"渾","kind":"person","person_id":"rj2_m1s_n3l","status":"contextual_provisional","resolution_note":"渾/籍/戎三端對話分辨；王濟轉述張華、裴頠與引古子房季劄。"},{"id":"c-jinshu-043-wangrong:p002:m0007","start":7,"end":8,"surface":"戎","kind":"person","person_id":"48e_04a_3d8","status":"contextual_provisional","resolution_note":"渾/籍/戎三端對話分辨；王濟轉述張華、裴頠與引古子房季劄。"},{"id":"c-jinshu-043-wangrong:p002:m0013","start":13,"end":14,"surface":"渾","kind":"person","person_id":"rj2_m1s_n3l","status":"contextual_provisional","resolution_note":"渾/籍/戎三端對話分辨；王濟轉述張華、裴頠與引古子房季劄。"},{"id":"c-jinshu-043-wangrong:p002:m0018","start":18,"end":19,"surface":"戎","kind":"person","person_id":"48e_04a_3d8","status":"contextual_provisional","resolution_not