angrong:p002","chapter_id":"c-jinshu-043-wangrong"},{"id":"c-jinshu-043-wangrong:p007:m0061","start":61,"end":63,"surface":"裴頠","kind":"person","person_id":"svm_6fh_34r","status":"contextual_provisional","resolution_note":"孝喪插敘武帝問劉毅，不與劉裕時護軍劉毅同人；母稱不升生母。","paragraph_id":"c-jinshu-043-wangrong:p007","chapter_id":"c-jinshu-043-wangrong"},{"id":"c-jinshu-043-wangrong:p010:m0000","start":0,"end":2,"surface":"裴頠","kind":"person","person_id":"svm_6fh_34r","status":"contextual_provisional","resolution_note":"八王亂時域，冏引語之孤/戎引語之公屬冏，卿是冏對戎；兩王群指顒與穎但不拆單代詞。","paragraph_id":"c-jinshu-043-wangrong:p010","chapter_id":"c-jinshu-043-wangrong"},{"id":"c-jinshu-043-wangrong:p010:m0008","start":8,"end":9,"surface":"頠","kind":"person","person_id":"svm_6fh_34r","status":"contextual_provisional","resolution_note":"八王亂時域，冏引語之孤/戎引語之公屬冏，卿是冏對戎；兩王群指顒與穎但不拆單代詞。","paragraph_id":"c-jinshu-043-wangrong:p010","chapter_id":"c-jinshu-043-wangrong"},{"id":"c-jinshu-043-wangrong:p011:m0174","start":174,"end":176,"surface":"裴頠","kind":"person","person_id":"svm_6fh_34r","status":"contextual_provisional","resolution_note":"女適裴頠與歸寧同一女；從子單衣婚事不補其父/姓名。","paragraph_id":"c-jinshu-043-wangrong:p011","chapter_id":"c-jinshu-043-wangrong"},{"id":"c-jinshu-043-wangrong:p013:m0051","start":51,"end":53,"surface":"裴頠","kind":"person","person_id":"svm_6fh_34r","status":"contextual_provisional","resolution_note":"人倫鑒識與黃公酒壚回憶分域；嵇叔夜/阮嗣宗按同段嵇阮及既有字證。渾金非王渾，名詞亂流不標。","paragraph_id":"c-jinshu-043-wangrong:p013","chapter_id":"c-jinshu-043-wangrong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-035-peikai-family:p019","text":"初，裴、王二族盛于魏晉之世，時人以為八裴方八王：徽比王祥，楷比王衍，康比王綏，綽比王澄，瓚比王敦，遐比王導，頠比王戎，邈比王玄雲。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-035-peikai-family:p019:m0024","start":24,"end":25