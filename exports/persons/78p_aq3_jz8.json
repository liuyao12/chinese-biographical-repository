"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"3處獨立位置，3個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-shiji-056-chen"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-056-chen:m009-0089","start":89,"end":91,"surface":"楚使","kind":"person","person_id":"78p_aq3_jz8","status":"contextual_provisional","paragraph_id":"c-shiji-056-chen:p009","chapter_id":"c-shiji-056-chen"},{"id":"c-shiji-056-chen:m009-0121","start":121,"end":123,"surface":"楚使","kind":"person","person_id":"78p_aq3_jz8","status":"contextual_provisional","paragraph_id":"c-shiji-056-chen:p009","chapter_id":"c-shiji-056-chen"},{"id":"c-shiji-056-chen:m009-0124","start":124,"end":126,"surface":"楚使","kind":"person","person_id":"78p_aq3_jz8","status":"contextual_provisional","paragraph_id":"c-shiji-056-chen:p009","chapter_id":"c-shiji-056-chen"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji056-052","person_id":"78p_aq3_jz8","surfaces":["楚使"],"scope":"same_chapter","chapter_ids":["c-shiji-056-chen"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-056-chen:p009","quote":"項王既疑之，使使至漢。漢王爲太牢具，舉進。見楚使，即詳驚曰：「吾以爲亞父使，乃項王使！」復持去，更以惡草具進楚使。楚使歸，具以報項王。項王果大疑亞父。"}],"rationale":"本段敘事先以「使使至漢」交代項王遣使，繼以「見楚使」記漢王接見，復稱「進楚使」，再記「楚使歸，具以報項王」；同一往返使命連續敘述，暫將三處楚使視為同一位未名使者。原文未載姓名、籍貫或其他生平，不補造。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-056-chen:p009","text":"陳平既多以金縱反間於楚軍，宣言諸將鍾離眛等爲項王將，功多矣，然而終不得裂地而王，欲與漢爲一，以滅項氏而分王其地。項羽果意不信鍾離眛等。項王既疑之，使使至漢。漢王爲太牢具，舉進。見楚使，即詳驚曰：「吾以爲亞父使，乃項王使！」復持去，更以惡草具進楚使。楚使歸，具以報項王。項王果大疑亞父。亞父欲急攻下滎陽城，項王不信，不肯聽。亞父聞項王疑之，乃怒曰：「天下事大定矣，君王自爲之！願請骸骨歸！」歸未至彭城，疽發背而死。陳平乃夜出女子二千人滎陽城東門，楚因擊之，陳平乃與漢王從城西門夜出去。遂入關，收散兵復東。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-056-chen:m009-0000","start":0,"end":2,"surface":"陳平","kind":"person","person_id":"i3f_9l9_g53","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m009-0017","start":17,"end":20,"surface":"鍾離眛","kind":"person","person_id":"tb2_zhz_mol","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m009-0022","start":22,"end":24,"surface":"項王","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m009-0056","start":56,"end":58,"surface":"項羽","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m009-0062","start":62,"end":65,"surface":"鍾離眛","kind":"person","person_id":"tb2_zhz_mol","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m009-0067","start":67,"end":69,"surface":"項王","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m009-0078","start":78,"end":80,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m009-0089","start":89,"end":91,"surface":"楚使","kind":"person","person_id":"78p_aq3_jz8","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m009-0101","start":101,"end":103,"surface":"亞父","kind":"person","person_id":"uw6_a0a_tjp","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m009-0106","start":106,"end":108,"surface":"項王","kind":"