94,"end":295,"surface":"宣","kind":"person","person_id":"dkn_ge4_286_AAAA","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p002:m0055","start":296,"end":297,"surface":"景","kind":"person","person_id":"dkn_ge4_286_AAAAH","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p002:m0056","start":298,"end":299,"surface":"文","kind":"person","person_id":"dkn_ge4_286_AAAAI","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p002:m0057","start":300,"end":301,"surface":"武","kind":"person","person_id":"hgm_jvn_hle","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"}],"source_position":{"first_line":94,"last_line":94,"revision_id":2650517},"chapter_id":"c-jinshu-059-jiong","book_id":"b-jinshu-059","work_id":"w-jinshu","source_id":"s-jinshu-059-ws2650517-jiong"},{"id":"c-jinshu-059-prince-jiong:p002","text":"冏因眾心怨望，潛與離狐王盛、潁川王處穆謀起兵誅倫。倫遣腹心張烏覘之，烏反，曰：「齊無異志。」冏既有成謀未發，恐或泄，乃與軍司管襲殺處穆，送首於倫，以安其意。謀定，乃收襲殺之。遂與豫州刺史何勖、龍驤將軍董艾等起軍，遣使告成都、河間、常山、新野四王，移檄天下征鎮、州郡縣國，咸使聞知。揚州刺史郗隆承檄，猶豫未決，參軍王邃斬之，送首於冏。冏屯軍陽翟，倫遣其將閭和、張泓、孫輔出堮阪，與冏交戰。冏軍失利，堅壘自守。會成都軍破倫眾于黃橋，冏乃出軍攻和等，大破之。及王輿廢倫，惠帝反正，冏誅討賊党既畢，率眾入洛，頓軍通章署，甲士數十萬，旌旗器械之盛，震於京都。天子就拜大司馬，加九錫之命，備物典策，如宣、景、文、武輔魏故事。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":94,"last_line":94,"raw_start":9423,"raw_end":9737,"raw_character_offsets":[9425,9426,9427,9428,9429,9430,9431,9432,9433,9434,9435,9436,9437,9438,9439,9440,9441,9442,9443,9444,9445,9446,9447,9448,9449,9450,9451,9452,9453,9454,9455,9456,9457,9458,9459,9460,9461,9462,9463,9464,9465,9466,9467,9468,9469,9470,9471,9472,9473,9474,9475,9476,9477,9478,9479,9480,9481,9482,9483,9484,9485,9486,9487,9488,9489,9490,9491,9492,9493,9494,9495,9496,9497,9498,9499,9500,9501,9502,9503,9504,9505,9506,9507,9508,9509,9510,9511,9512,9513,9514,9515,9516,9517,9518,9519,9520,9521,9522,9523,9524,9525,9526,9527,