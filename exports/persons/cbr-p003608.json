盡之矣。彭祖取笔江都易王寵姬王建所盜與姦淖姬者為姬，甚愛之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-059-wuzong:m017-0000","start":0,"end":4,"surface":"趙王彭祖","kind":"person","person_id":"1c8_u63_bk4_G","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m017-0006","start":6,"end":8,"surface":"孝景","kind":"person","person_id":"1c8_u63_bk4","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m017-0015","start":15,"end":18,"surface":"廣川王","kind":"person","person_id":"1c8_u63_bk4_G","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m017-0019","start":19,"end":22,"surface":"趙王遂","kind":"person","person_id":"36f_8y3_kzd","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m017-0026","start":26,"end":28,"surface":"彭祖","kind":"person","person_id":"1c8_u63_bk4_G","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m017-0037","start":37,"end":39,"surface":"趙王","kind":"person","person_id":"1c8_u63_bk4_G","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m017-0044","start":44,"end":47,"surface":"孝景帝","kind":"person","person_id":"1c8_u63_bk4","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m017-0049","start":49,"end":51,"surface":"彭祖","kind":"person","person_id":"1c8_u63_bk4_G","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m017-0076","start":76,"end":78,"surface":"彭祖","kind":"person","person_id":"1c8_u63_bk4_G","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m017-0079","start":79,"end":82,"surface":"內寵姬","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、未名皇帝或未定指代；不補未見姓名、親屬成員或確定身份。"},{"id":"c-shiji-059-wuzong:m017-0083","start":83,"end":85,"surface":"子孫","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、未名皇帝或未定指代；不補未見姓名、親屬成員或確定身份。"},{"id":"c-shiji-059-wuzong:m017-0086","start":86,"end":87,"surface":"相","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、未名皇帝或未定指代