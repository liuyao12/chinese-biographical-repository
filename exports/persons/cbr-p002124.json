t":37,"end":39,"surface":"渠彌","kind":"person","person_id":"cbr-p002124","status":"contextual_provisional","paragraph_id":"c-shiji-042-zheng:p011","chapter_id":"c-shiji-042-zheng"},{"id":"c-shiji-042-zheng:m011-0059","start":59,"end":61,"surface":"渠彌","kind":"person","person_id":"cbr-p002124","status":"contextual_provisional","paragraph_id":"c-shiji-042-zheng:p011","chapter_id":"c-shiji-042-zheng"},{"id":"c-shiji-042-zheng:m011-0077","start":77,"end":79,"surface":"渠彌","kind":"person","person_id":"cbr-p002124","status":"contextual_provisional","paragraph_id":"c-shiji-042-zheng:p011","chapter_id":"c-shiji-042-zheng"},{"id":"c-shiji-042-zheng:m012-0023","start":23,"end":26,"surface":"髙渠彌","kind":"person","person_id":"cbr-p002124","status":"contextual_provisional","paragraph_id":"c-shiji-042-zheng:p012","chapter_id":"c-shiji-042-zheng"},{"id":"c-shiji-042-zheng:m012-0159","start":159,"end":162,"surface":"髙渠彌","kind":"person","person_id":"cbr-p002124","status":"contextual_provisional","paragraph_id":"c-shiji-042-zheng:p012","chapter_id":"c-shiji-042-zheng"}],"relations":[],"title_holdings":[{"id":"th-shiji042-006","person_id":"cbr-p002124","title":"卿","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-042-zheng","source_id":"s-shiji-042-zheng","paragraph_id":"c-shiji-042-zheng:p011","quote":"昭公二年，自昭公爲太子時，父莊公欲以髙渠彌爲卿，太子忽惡之，莊公弗聽，卒用渠彌爲卿。及昭公卽位，懼其殺己，冬十月辛卯，渠彌與昭公出獵，射殺昭公於野。祭仲與渠彌不敢入厲公，乃更立昭公弟子亹爲君，是爲子亹也，無謚號。"}],"attestations":[{"id":"th-shiji042-006:a001","paragraph_id":"c-shiji-042-zheng:p011","start":40,"end":41,"surface":"卿","person_mention_id":"c-shiji-042-zheng:m011-0037","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-042-zheng","source_id":"s-shiji-042-zheng","paragraph_id":"c-shiji-042-zheng:p011","quote":"昭公二年，自昭公爲太子時，父莊公欲以髙渠彌爲卿，太子忽惡之，莊公弗聽，卒用渠彌爲卿。及昭公卽位，懼其殺己，冬十月辛卯，渠彌與昭公出獵，射殺昭公於野。祭仲與渠彌不敢入厲公，乃更立昭公弟子亹爲君，是爲子亹也，無謚號。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"原文授予與用稱分開；相對年表述未換算，未知起訖不由卒日、逃亡或首次用稱補造，復入與廢黜仍待逐項保存。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji042-030","person_id":"cbr-p002124","surfaces":["渠彌","髙渠彌"],"scope":"same_chapter","chapter_ids":["c-shiji-042-zheng"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-042-zheng:p005","quote":"二十四年，宋繆公卒，公子馮奔鄭。鄭侵周地，取禾。二十五年，衞州吁弒其君桓公自立，與宋伐鄭，以馮故也。二十七年，始朝周桓王。桓王怒其取禾，弗禮也。二十九年，莊公怒周弗禮，與魯易祊、許田。三十三年，宋殺孔父。三十七年，莊公不朝周，周桓王率陳、蔡、虢、衞伐鄭。莊公與祭仲、髙渠彌發兵自救，王師大敗。祝聸射中王臂。祝聸請從之，鄭伯止之，曰：「犯長且難之，況敢陵天子乎？」乃止。夜令祭仲問王疾。"},{"paragraph_id":"c-shiji-042-zheng:p011","quote":"昭公二年，自昭公爲太子時，父莊公欲以髙渠彌爲卿，太子忽惡之，莊公弗聽，卒用渠彌爲卿。及昭公卽位，懼其殺己，冬十月辛卯，渠彌與昭公出獵，射殺昭公於野。祭仲與渠彌不敢入厲公，乃更立昭公弟子亹爲君，是爲子亹也，無謚號。"},{"paragraph_id":"c-shiji-042-zheng:p012","quote":"子亹元年七月，齊襄公會諸侯於首止，鄭子亹往會，髙渠彌相，從，祭仲稱疾不行。所以然者，子亹自齊襄公爲公子之時，嘗會鬬，相仇，及會諸侯，祭仲請子亹無行。子亹曰：「齊彊，而厲公居櫟，卽不往，是率諸侯伐我，内厲公。我不如往，往何遽必辱，且又何至是！」卒行。於是祭仲恐齊并殺之，故稱疾。子亹至，不謝齊侯，齊侯怒，遂伏甲而殺子亹。髙渠彌亡歸，歸與祭仲謀，召子亹弟公子嬰於陳而立之，是爲鄭子。是歳，齊襄公使彭生醉拉殺魯桓公。"}],"rationale":"依本篇名字、是為、世系及連續事件暫接異稱；同諡不同國分開，建子勝與聲公勝不合併，如兄弟為譬喻不作親屬。述贊與正文不算獨立來源，省稱、古字與校勘仍待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-042-zheng:p005","text":"二十四年，宋繆公卒，公子馮奔鄭。鄭侵周地，取禾。二十五年，衞州吁弒其君桓公自立，與宋伐鄭，以馮故也。二十七年，始朝周桓王。桓王怒其取禾，弗禮也。二十九年，莊公怒周弗禮，與魯易祊、許田。三十三年，宋殺孔父。三十七年，莊公不朝周，周桓王率陳、蔡、虢、衞伐鄭。莊公與祭仲、髙渠彌發兵自救，王師大敗。祝聸射中王臂。祝聸請從之，鄭伯止之，曰：「犯長且難之，況敢陵天子乎？」乃止。夜令祭仲問王疾。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-042-zheng:m005-0005","start":5,"end":8,"surface":"宋繆公","kind":"person","person_id":"cbr-p002118","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m005-0010","start":10,"end":13,"surface":"公子馮","kind":"person","person_id":"cbr-p002119","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m005-0029","start":29,"end":32,"surface":"衞州吁","kind":"person","person_id":"cbr-p002120","status":"cont