02-0555","chapter_id":"c-shiji-110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p002","quote":"周襄王"}]},{"id":"wqs_z6j_lz7","label":"子帶（匈奴列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"子帶","mention_ids":["c-shiji-110-xiongnu:m002-0403","c-shiji-110-xiongnu:m002-0418","c-shiji-110-xiongnu:m002-0443","c-shiji-110-xiongnu:m002-0550"]}],"evidence":[{"mention_id":"c-shiji-110-xiongnu:m002-0403","chapter_id":"c-shiji-110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p002","quote":"子帶"},{"mention_id":"c-shiji-110-xiongnu:m002-0418","chapter_id":"c-shiji-110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p002","quote":"子帶"},{"mention_id":"c-shiji-110-xiongnu:m002-0443","chapter_id":"c-shiji-110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p002","quote":"子帶"},{"mention_id":"c-shiji-110-xiongnu:m002-0550","chapter_id":"c-shiji-110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p002","quote":"子帶"}]}],"source_mention_summary":[{"source_id":"s-shiji110-xiongnu","work_id":"w-shiji","book_id":"b-shiji-110","chapter_id":"c-shiji-110-xiongnu","mention_count":2,"mention_ids":["c-shiji-110-xiongnu:m002-0398","c-shiji-110-xiongnu:m002-0412"],"paragraph_ids":["c-shiji-110-xiongnu:p002"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji110-xiongnu"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji110-002","subject_person_id":"wqs_z6j_lz7","predicate":"mother","object_person_id":"87t_j04_qp3","status":"source_attested","evidence":[{"chapter_id":"c-shiji-110-xiongnu","source_id":"s-shiji110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p002","quote":"夏道衰，而公劉失其稷官，變于西戎，邑于豳。其後三百有餘歳，戎狄攻大王亶父，亶父亡走岐下，而豳人悉從亶父而邑焉，作周。其後百有餘歳，周西伯昌伐畎夷氏。後十有餘年，武王伐紂而營雒邑，復居于酆鄗，放逐戎夷涇、洛之北，以時入貢，命曰「荒服」。其後二百有餘年，周道衰，而穆王伐犬戎，得四白狼四白鹿以歸。自是之後，荒服不至。於是周遂作甫刑之辟。穆王之後二百有餘年，周幽王用寵姬褒姒之故，與申侯有卻。申侯怒而與犬戎共攻殺周幽王于驪山之下，遂取周之焦穫，而居于涇渭之閒，侵暴中國。秦襄公救周，於是周平王去酆鄗而東徙雒邑。當是之時，秦襄公伐戎至岐，始列爲諸侯。是後六十有五年，而山戎越燕而伐齊，齊釐公與戰于齊郊。其後四十四年，而山戎伐燕。燕告急于齊，齊桓公北伐山戎，山戎走。其後二十有餘年，而戎狄至洛邑，伐周襄王，襄王奔于鄭之氾邑。初，周襄王欲伐鄭，故娶戎狄女爲后，與戎狄兵共伐鄭。已而黜狄后，狄后怨，而襄王後母曰惠后，有子子帶，欲立之，於是惠后與狄后、子帶爲內應，開戎狄，戎狄以故得入，破逐周襄王，而立子帶爲天子。於是戎狄或居于陸渾，東至於衛，侵盜暴虐中國。中國疾之，故詩人歌之曰「戎狄是應」，「薄伐獫狁，至於大原」，「出輿彭彭，城彼朔方」。周襄王既居外四年，乃使使告急于晉。晉文公初立，欲修霸業，乃興師伐逐戎翟，誅子帶，迎內周襄王，居于雒邑。"}],"qualifiers":{"source_term":"惠后，有子子帶","historicity":"historical_tradition"},"interpretation_note":"只依明示娶與有子記婚姻、母子，不將襄王後母補作生母，不由立為天子推父子。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji110-010","subject_person_id":"h8h_gjb_mb9","predicate":"stepmother","object_person_id":"87t_j04_qp3","status":"source_attested","evidence":[{"chapter_id":"c-shiji-110-xiongnu","source_id":"s-shiji110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p002","quote":"襄王後母曰惠后"}],"qualifiers":{"source_term":"後母","historicity":"historical_tradition"},"interpretation_note":"補保存第2段明示後母，不作襄王生母，不補其父婚姻。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-110-xiongnu:m002-0398","start":398,"end":400,"surface":"惠后","kind":"person","person_id":"87t_j04_qp3","status":"contextual_provisional","paragraph_id":"c-shiji-110-xiongnu:p002","chapter_id":"c-shiji-110-xiongnu"},{"id":"c-shiji-110-xiongnu:m002-0412","start":412,"end":414,"surface":"惠后","kind":"person","person_id":"87t_j04_qp3","status":"contextual_provisional","paragraph_id":"c-shiji-110-xiongnu:p002","chapter_id":"c-shiji-110-xiongnu"}],"relations":[{"id":"a-shiji110-002","subject_person_id":"wqs_z6j_lz7","predicate":"mother","object_person_id":"87t_j04_qp3","status":"source_attested","evidence":[{"chapter_id":"c-shiji-110-xiongnu","source_id":"s-shiji110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p002","quote":"夏道衰，而公劉失其稷官，變于西戎，邑于豳。其後三百有餘歳，戎狄攻大王亶父，亶父亡走岐下，而豳人悉從亶父而邑焉，作周。其後百有餘歳，周西伯昌伐畎夷氏。後十有