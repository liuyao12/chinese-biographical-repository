存。","paragraph_id":"c-jinshu-064-simadaozi:p009","start_codepoint":49,"end_codepoint":54,"human_reviewed":false,"chapter_id":"c-jinshu-064-simadaozi","source_id":"s-jinshu-064-simadaozi-ws2622004"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-jin064-wangfei","person_id":"g1x_6bo_gnu","event_type":"death","source_term":"道子妃薨","source_anchor":{"paragraph_id":"c-jinshu-064-simadaozi:p009","start":50,"end":54,"surface":"道子妃薨"},"date_expression":null,"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-064","chapter_id":"c-jinshu-064-simadaozi","source_id":"s-jinshu-064-simadaozi-ws2622004","paragraph_id":"c-jinshu-064-simadaozi:p009","quote":"道子世子元顯，時年十六，為侍中，心惡恭，請道子討之。乃拜元顯為征虜將軍，其先衛府及徐州文武悉配之。屬道子妃薨，帝下詔曰：「會稽王妃尊賢莫二，朕義同所親。今葬加殊禮，一依琅邪穆太妃故事。元顯夙令光懋，乃心所寄，誠孝性蒸蒸，至痛難奪。然不以家事辭王事，《陽秋》之明義；不以私限違公制，中代之變禮。故閔子腰絰，山王逼屈。良以至戚由中，軌容著外，有禮無時，賢哲斯順。須妃葬畢，可居職如故。」","person_mention_id":"c-jinshu-064-simadaozi:p009:m0061"}],"status":"source_attested","interpretation_note":"按同段人物與次第核所屬卒事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"mentions":[{"id":"c-jinshu-064-simadaozi:p009:m0061","surface":"會稽王妃","start":61,"end":65,"person_id":"g1x_6bo_gnu","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-064-simadaozi:p009","chapter_id":"c-jinshu-064-simadaozi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-064-simadaozi:p009","text":"道子世子元顯，時年十六，為侍中，心惡恭，請道子討之。乃拜元顯為征虜將軍，其先衛府及徐州文武悉配之。屬道子妃薨，帝下詔曰：「會稽王妃尊賢莫二，朕義同所親。今葬加殊禮，一依琅邪穆太妃故事。元顯夙令光懋，乃心所寄，誠孝性蒸蒸，至痛難奪。然不以家事辭王事，《陽秋》之明義；不以私限違公制，中代之變禮。故閔子腰絰，山王逼屈。良以至戚由中，軌容著外，有禮無時，賢哲斯順。須妃葬畢，可居職如故。」","text_layer"