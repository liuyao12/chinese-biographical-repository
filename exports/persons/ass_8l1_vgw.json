lete:p029","start_codepoint":0,"end_codepoint":115,"human_reviewed":false,"chapter_id":"c-nanqishu-055-filial-complete","source_id":"s-nanqishu-055-filial-complete-ws1545598"},{"id":"c-nanqishu-055-filial-complete:source_review30-0","kind":"source_review","person_id":"ass_8l1_vgw","source_quote":"　　湘州刺史王僧虔引爲主簿，以同僚非人，弃官去。吏部郎庾杲之嘗往候，頤爲設食，枯魚菜菹而已。杲之曰：「我不能食此。」母聞之，自出常膳魚羹數種。杲之曰：「卿過於茅季偉，我非郭林宗。」仕至郢州治中，卒。","reading":"王僧虔引樂頤，庾杲之往候，食物對答所舉茅季偉、郭林宗是比擬。治中為所終官。","note":"王僧虔引樂頤，庾杲之往候，食物對答所舉茅季偉、郭林宗是比擬。治中為所終官。","paragraph_id":"c-nanqishu-055-filial-complete:p030","start_codepoint":0,"end_codepoint":99,"human_reviewed":false,"chapter_id":"c-nanqishu-055-filial-complete","source_id":"s-nanqishu-055-filial-complete-ws1545598"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-qi055-leyi-death","person_id":"ass_8l1_vgw","event_type":"death","source_term":"卒","source_anchor":{"paragraph_id":"c-nanqishu-055-filial-complete:p030","start":97,"end":98,"surface":"卒"},"date_expression":null,"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-055","chapter_id":"c-nanqishu-055-filial-complete","source_id":"s-nanqishu-055-filial-complete-ws1545598","paragraph_id":"c-nanqishu-055-filial-complete:p030","quote":"　　湘州刺史王僧虔引爲主簿，以同僚非人，弃官去。吏部郎庾杲之嘗往候，頤爲設食，枯魚菜菹而已。杲之曰：「我不能食此。」母聞之，自出常膳魚羹數種。杲之曰：「卿過於茅季偉，我非郭林宗。」仕至郢州治中，卒。","person_mention_id":"c-nanqishu-055-filial-complete:p030:m0034"}],"status":"source_attested","interpretation_note":"按同段人物與次第核所屬卒事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"mentions":[{"id":"c-nanqishu-055-filial-complete:p029:m0002","start":2,"end":4,"surface":"樂頤","kind":"person","person_id":"ass_8l1_vgw","status":"contextual_provisional","paragraph_id":"c-nanqishu-055-filial-complete:p029","chapter_id":"c-nanqishu-055-filial-complete"},{"id"