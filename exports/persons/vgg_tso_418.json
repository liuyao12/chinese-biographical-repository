tation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-123-dayuan:m003-0008","start":8,"end":9,"surface":"騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m003-0041","start":41,"end":42,"surface":"騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m003-0055","start":55,"end":56,"surface":"騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m003-0077","start":77,"end":78,"surface":"王","kind":"person","person_id":"86r_v76_3mc","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m003-0095","start":95,"end":96,"surface":"王","kind":"person","person_id":"86r_v76_3mc","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m003-0111","start":111,"end":112,"surface":"騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m003-0130","start":130,"end":134,"surface":"大月氏王","kind":"person","person_id":"vgg_tso_418","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m003-0141","start":141,"end":144,"surface":"其太子","kind":"person","person_id":"vgg_tso_418_A","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m003-0178","start":178,"end":179,"surface":"騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"}],"chapter_id":"c-shiji-123-dayuan","book_id":"b-shiji-123","work_id":"w-shiji","source_id":"s-shiji123-dayuan"},{"id":"c-shiji-123-dayuan:p011","text":"大月氏在大宛西可二三千里，居媯水北。其南則大夏，西則安息，北則康居。行國也，隨畜移徙，與匈奴同俗。控弦者可一二十萬。故時彊，輕匈奴，及冒頓立，攻破月氏，至匈奴老上單于，殺月氏王，以其頭為飲器。始月氏居敦煌、祁連閒，及為匈奴所敗，乃遠去，過宛，西擊大夏而臣之，遂都媯水北，為王庭。其餘小眾不能去者，保南山羌，號小月氏。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-123-dayuan:m011-0067","start":67,"end":69,"surface":"冒頓","kind":"person","person_id":"fpg_x4b_tif","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m011-0079","start":79,"end":83,"surface":"老上單于","kind":"person","person_id":"p8k_j2g_tio","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m011-0085","start":85,"end":88,"surface":"月氏王","kind":"person","person_id":"vgg_tso_418","status":"contextual_provisional"}],"chapter_id":"c-shiji-123-dayuan","book_id":"b-shiji-123","work_id":"w-shiji","source_id":"s-shiji123-dayuan"}],"sources":[{"chapter_id":"c-shiji-123-dayuan","work_id":"w-shiji","book_id":"b-shiji-123","source_id":"s-shiji123-dayuan","source":{"title":"史記／卷123","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷123","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷123&oldid=8736799","revision_id":8736799,"accessed_on":"2026-10-11","extent":"固定修訂全文39段，包括末段索隱述贊。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"去header2、現代節標、blockquote排版及分類；維基連結保留顯示文字，原字未轉換，未核影像。","note":"末段索隱述贊另分層。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical"}}
