uman_reviewed":false}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji091-030","person_id":"myr_tln_x5c","scope":"same_chapter","chapter_ids":["c-shiji-091-qingbu"],"status":"contextual_provisional","rationale":"按本段明示姓名及局部敘事承接；布與兩王號按英布主線暫接。番君與長沙哀王分候選，所幸姬不與番君女合併；皋陶引古疑問不作祖先定論。","reviewer":"Codex（AI 代理）","surfaces":["項聲"],"evidence":[{"paragraph_id":"c-shiji-091-qingbu:p008","quote":"楚使者在，方急責英布發兵，舍傳舍。隨何直入，坐楚使者上坐，曰：「九江王已歸漢，楚何以得發兵？」布愕然。楚使者起。何因說布曰：「事已搆，可遂殺楚使者，無使歸，而疾走漢并力。」布曰：「如使者教，因起兵而擊之耳。」於是殺使者，因起兵而攻楚。楚使項聲、龍且攻淮南，項王留而攻下邑。數月，龍且擊淮南，破布軍。布欲引兵走漢，恐楚王殺之，故閒行與何俱歸漢。"}]},{"id":"d-shiji095-098","person_id":"myr_tln_x5c","scope":"same_chapter","chapter_ids":["c-shiji-095-fankuang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["項聲"],"evidence":[{"paragraph_id":"c-shiji-095-fankuang:p026","quote":"齊地已定，韓信自立為齊王，使嬰別將擊楚將公杲於魯北，破之。轉南，破薛郡長，身虜騎將一人。攻（博）［傅］陽，前至下相以東南僮、取慮、徐。度淮，盡降其城邑，至廣陵。項羽使項聲、薛公、郯公復定淮北。嬰度淮北，擊破項聲、郯公下邳，斬薛公，下下邳，擊破楚騎於平陽，遂降彭城，虜柱國項佗，降留、薛、沛、酂、蕭、相。攻苦、譙，復得亞將周蘭。與漢王會頤鄉。從擊項籍軍於陳下，破之，所將卒斬樓煩將二人，虜騎將八人。賜益食邑二千五百戶。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定異稱。酈寄字況據第14段；夏侯嬰的嬰限定第16至21段，灌嬰限定第22至33段，桓嬰另人。第6與20、28段楚王信和反韓王信分人；未詳名王侯不補名。同名跨篇同指另待逐項證據。"}],"equivalence_decisions":[{"id":"eq-shiji091-review-xiangsheng","person_ids":["myr_tln_x5c"],"canonical_person_id":"myr_tln_x5c","scope":"cross_chapter","chapter_ids":["c-shiji-091-qingbu","c-shiji-008-gaozu"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-091-qingbu","source_id":"s-shiji-091-qingbu","paragraph_id":"c-shiji-091-qingbu:p008","quote":"楚使者在，方急責英布發兵，舍傳舍。隨何直入，坐楚使者上坐，曰：「九江王已歸漢，楚何以得發兵？」布愕然。楚使者起。何因說布曰：「事已搆，可遂殺楚使者，無使歸，而疾走漢并力。」布曰：「如使者教，因起兵而擊之耳。」於是殺使者，因起兵而攻楚。楚使項聲、龍且攻淮南，項王留而攻下邑。數月，龍且擊淮南，破布軍。布欲引兵走漢，恐楚王殺之，故閒行與何俱歸漢。","mention_ids":["c-shiji-091-qingbu:m008-0119"]},{"chapter_id":"c-shiji-008-gaozu","source_id":"s-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p042","quote":"項羽聞漢王在宛，果引兵南。漢王堅壁不與戰。是時彭越渡睢水，與項聲、薛公戰下邳，彭越大破楚軍。項羽乃引兵東擊彭越。漢王亦引兵北軍成皋。項羽已破走彭越，聞漢王復軍成皋，乃復引兵西，拔滎陽，誅周苛、樅公，而虜韓王信，遂圍成皋。","mention_ids":["c-shiji-008-gaozu:m042-0030"]}],"rationale":"項聲奉楚命與龍且攻淮南，與高祖篇楚將項聲戰下邳按完整姓名、同時期項羽軍配置暫接；不是明文異稱或同一戰事，不推父系親屬、任期或戰死。 同書不同篇不當獨立見證，原文字及敘事時點分存，未核書影。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true},{"id":"eq-shiji095-remaining-xiangsheng","person_ids":["myr_tln_x5c"],"canonical_person_id":"myr_tln_x5c","scope":"cross_chapter","chapter_ids":["c-shiji-095-fankuang","c-shiji-008-gaozu"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-095-fankuang","source_id":"s-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p026","quote":"齊地已定，韓信自立為齊王，使嬰別將擊楚將公杲於魯北，破之。轉南，破薛郡長，身虜騎將一人。攻（博）［傅］陽，前至下相以東南僮、取慮、徐。度淮，盡降其城邑，至廣陵。項羽使項聲、薛公、郯公復定淮北。嬰度淮北，擊破項聲、郯公下邳，斬薛公，下下邳，擊破楚騎於平陽，遂降彭城，虜柱國項佗，降留、薛、沛、酂、蕭、相。攻苦、譙，復得亞將周蘭。與漢王會頤鄉。從擊項籍軍於陳下，破之，所將卒斬樓煩將二人，虜騎將八人。賜益食邑二千五百戶。","mention_ids":["c-shiji-095-fankuang:m026-0083","c-shiji-095-fankuang:m026-0103"]},{"chapter_id":"c-shiji-008-gaozu","source_id":"s-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p042","quote":"項羽聞漢王在宛，果引兵南。漢王堅壁不與戰。是時彭越渡睢水，與項聲、薛公戰下邳，彭越大破楚軍。項羽乃引兵東擊彭越。漢王亦引兵北軍成皋。項羽已破走彭越，聞漢王復軍成皋，乃復引兵西，拔滎陽，誅周苛、樅公，而虜韓王信，遂圍成皋。","mention_ids":["c-shiji-008-gaozu:m042-0030"]}],"rationale":"項羽遣項聲、薛公等復定淮北，與彭越在下邳擊項聲薛公的楚軍人物及戰場脈絡相接。只辨項聲，不由同行便接合不同時段所有薛公。 原字與錨點保留，同書不作獨立見證，未核書影。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true}],"passages":[{"id":"c-shiji-008-gaozu:p042","text":"項羽聞漢王在宛，果引兵南。漢王堅壁不與戰。是時彭越渡睢水，與項聲、薛公戰下邳，彭越大破楚軍。項羽乃引兵東擊彭越。漢王亦引兵北軍成皋。項羽已破走彭越，聞漢王復軍成皋，乃復引兵西，拔滎陽，誅周苛、樅公，而虜韓王信，遂圍成皋。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m042-0000","start":0,"end":2,"surface":"項羽","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m042-0003","start":3,"end":5,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m