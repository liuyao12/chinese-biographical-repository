onal","paragraph_id":"c-shiji-006-shihuang:p012","chapter_id":"c-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:m013-0004","start":4,"end":6,"surface":"桓齮","kind":"person","person_id":"42c_0ck_iry","status":"contextual_provisional","paragraph_id":"c-shiji-006-shihuang:p013","chapter_id":"c-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:m013-0039","start":39,"end":41,"surface":"桓齮","kind":"person","person_id":"42c_0ck_iry","status":"contextual_provisional","paragraph_id":"c-shiji-006-shihuang:p013","chapter_id":"c-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:m013-0067","start":67,"end":69,"surface":"桓齮","kind":"person","person_id":"42c_0ck_iry","status":"contextual_provisional","paragraph_id":"c-shiji-006-shihuang:p013","chapter_id":"c-shiji-006-shihuang"},{"id":"c-shiji-081-lianlin:m025-0085","start":85,"end":89,"surface":"秦將桓齮","kind":"person","person_id":"42c_0ck_iry","status":"contextual_provisional","paragraph_id":"c-shiji-081-lianlin:p025","chapter_id":"c-shiji-081-lianlin"}],"relations":[],"title_holdings":[{"id":"th-shiji006-015","person_id":"42c_0ck_iry","title":"將軍","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-006-shihuang","source_id":"s-shiji-006-shihuang","paragraph_id":"c-shiji-006-shihuang:p010","quote":"嫪毐封為長信侯。予之山陽地，令毐居之。宮室車馬衣服苑囿馳獵恣毐。事無小大皆決於毐。又以河西太原郡更為毐國。九年，彗星見，或竟天。攻魏垣、蒲陽。四月，上宿雍。己酉，王冠，帶劍。長信侯毐作亂而覺，矯王御璽及太后璽以發縣卒及衛卒、官騎、戎翟君公、舍人，將欲攻蘄年宮為亂。王知之，令相國昌平君、昌文君發卒攻毐。戰咸陽，斬首數百，皆拜爵，及宦者皆在戰中，亦拜爵一級。毐等敗走。即令國中：有生得毐，賜錢百萬；殺之，五十萬。盡得毐等。衛尉竭、內史肆、佐弋竭、中大夫令齊等二十人皆梟首。車裂以徇，滅其宗。及其舍人，輕者為鬼薪。及奪爵遷蜀四千餘家，家房陵。四月寒凍，有死者。楊端和攻衍氏。彗星見西方，又見北方，從斗以南八十日。十年，相國呂不韋坐嫪毐免。桓齮為將軍。齊、趙來置酒。齊人茅焦說秦王曰：「秦方以天下為事，而大王有遷母太后之名，恐諸侯聞之，由此倍秦也。」秦王乃迎太后於雍而入咸陽，復居甘泉宮。"}],"attestations":[{"id":"th-shiji006-015:a001","paragraph_id":"c-shiji-006-shihuang:p010","start":320,"end":322,"surface":"將軍","person_mention_id":"c-shiji-006-shihuang:m010-0317","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-006-shihuang","source_id":"s-shiji-006-shihuang","paragraph_id":"c-shiji-006-shihuang:p010","quote":"嫪毐封為長信侯。予之山陽地，令毐居之。宮室車馬衣服苑囿馳獵恣毐。事無小大皆決於毐。又以河西太原郡更為毐國。九年，彗星見，或竟天。攻魏垣、蒲陽。四月，上宿雍。己酉，王冠，帶劍。長信侯毐作亂而覺，矯王御璽及太后璽以發縣卒及衛卒、官騎、戎翟君公、舍人，將欲攻蘄年宮為亂。王知之，令相國昌平君、昌文君發卒攻毐。戰咸陽，斬首數百，皆拜爵，及宦者皆在戰中，亦拜爵一級。毐等敗走。即令國中：有生得毐，賜錢百萬；殺之，五十萬。盡得毐等。衛尉竭、內史肆、佐弋竭、中大夫令齊等二十人皆梟首。車裂以徇，滅其宗。及其舍人，輕者為鬼薪。及奪爵遷蜀四千餘家，家房陵。四月寒凍，有死者。楊端和攻衍氏。彗星見西方，又見北方，從斗以南八十日。十年，相國呂不韋坐嫪毐免。桓齮為將軍。齊、趙來置酒。齊人茅焦說秦王曰：「秦方以天下為事，而大王有遷母太后之名，恐諸侯聞之，由此倍秦也。」秦王乃迎太后於雍而入咸陽，復居甘泉宮。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"明言封、為將軍與以為秦國尉存授予；其他保存用稱見證。呂不韋坐嫪毐免記相國終點，不當文信侯同時被奪爵；昌文君不從並列推任相國。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji081-034","person_id":"42c_0ck_iry","title":"秦將","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-081-lianlin","source_id":"s-shiji-081-lianlin","paragraph_id":"c-shiji-081-lianlin:p025","quote":"趙悼襄王元年，廉頗既亡入魏，趙使李牧攻燕，拔武遂、方城。居二年，龐暖破燕軍，殺劇辛。後七年，秦破殺趙將扈輒於武遂，斬首十萬。趙乃以李牧爲大將軍，撃秦軍於宜安，大破秦軍，走秦將桓齮。封李牧爲武安君。居三年，秦攻番吾，李牧撃破秦軍，南距韓、魏。"}],"attestations":[{"id":"th-shiji081-034:a001","paragraph_id":"c-shiji-081-lianlin:p025","start":85,"end":87,"surface":"秦將","person_mention_id":"c-shiji-081-lianlin:m025-0085","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"官名、角色及授任分存，各次將兵另列；首次用稱、病、逃亡、被俘或死亡不自動終止所有官爵，未明日期保持未定。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[{"id":"shiji-015-r243-c01-m003","start":3,"end":5,"surface":"桓齮","person_id":"42c_0ck_iry","status":"contextual_provisional","interpretation_note":"依國別、紀年及原格上下文暫定；保留異文，不據同名自動合併。","table_id":"shiji-015","table_fragment_id":"shiji-015-digital-table-1","table_row_id":"shiji-015-r243","table_cell_id":"shiji-015-r243-c01","work_id":"w-shiji","book_id":"b-shiji-015","chapter_id":"table-chapter-shiji-015","source_id":"table-witness-shiji-015","source_revision":"2607002","kind":"table_person_mention","quote":"十三。桓齮擊平陽，殺趙扈輒，斬首十萬，因東擊。趙王之河南。彗星見。"},{"id":"shiji-015-r244-c01-m003","start":3,"end":5,"surface":"桓齮","person_id":"42c_0ck_iry","status":"contextual_provisional","interpretation_note":"依國別、紀年及原格上下文暫定；保留異文，不據同名自動合併。","table_id":"shiji-015","table_fragment_id":"shiji-015-digital-table-1","table_row_id":"shiji-015-r244","table_cell_id":"shiji-015-r244-c01","work_id":"w-shiji","book_id":"b-shiji-015","chapter_id":"table-chapter-shiji-015","source_id":"table-witness-shiji-015","source_revision":"2607002","kind":"table_person_mention","quote":"十四。桓齮定平陽、武城、宜安。韓使非來，我殺非。韓王請為臣。"}],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji081-034","person_id":"42c_0ck_iry","scope":"same_chapter","chapter_ids":["c-shiji-081-lianlin"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["秦將桓齮"],"evidence":[{"paragraph_id":"c-shiji-081-lianlin:p025","quote":"趙悼襄王元年，廉頗既亡入魏，趙使李牧攻燕，拔武遂、方城。居二年，龐暖破燕軍，殺劇辛。後七年，秦破殺趙將扈輒於武遂，斬首十萬。趙乃以李牧爲大將軍，撃秦軍於宜安，大破秦軍，走秦將桓齮。封李牧爲武安君。居三年，秦攻番吾，李牧撃破秦軍，南距韓、魏。"}],"rationale":"依本篇明示姓名、國別君序與代將敘事暫接；李牧牧在明示北邊主題內同指，趙王遷王稱限定末次代將。北邊早年趙王、他人及單于未名分存，不強接悼襄；太史公讓頗承接廉藺敘事，其他引語指代待逐處覆核。"}],"equivalence_decisions":[{"id":"eq-shiji081-huanyi","person_ids":["42c_0ck_iry"],"canonical_person_id":"42c_0ck_iry","scope":"cross_chapter","chapter_ids":["c-shiji-006-shihuang","c-shiji-081-lianlin"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-006-shihuang","source_id":"s-shiji-006-shihuang","paragraph_id":"c-shiji-006-shihuang:p013","quote":"十三年，桓齮攻趙平陽，殺趙將扈輒，斬首十萬。王之河南。正月，彗星見東方。十月，桓齮攻趙。十四年，攻趙軍於平陽，取宜安，破之，殺其將軍。桓齮定平陽、武城。韓非使秦，秦用李斯謀，留非，非死雲陽。韓王請為臣。","mention_ids":["c-shiji-006-shihuang:m013-0004","c-shiji-006-shihuang:m013-0039","c-shiji-006-shihuang:m013-0067"]},{"chapter_id":"c-shiji-081-lianlin","source_id":"s-shiji-081-lianlin","paragraph_id":"c-shiji-081-lianlin:p025","quote":"趙悼襄王元年，廉頗既亡入魏，趙使李牧攻燕，拔武遂、方城。居二年，龐暖破燕軍，殺劇辛。後七年，秦破殺趙將扈輒於武遂，斬首十萬。趙乃以李牧爲大將軍，撃秦軍於宜安，大破秦軍，走秦將桓齮。封李牧爲武安君。居三年，秦攻番吾，李牧撃破秦軍，南距韓、魏。","mention_ids":["c-shiji-081-lianlin:m025-0085"]}],"rationale":"始皇本紀具名秦將桓齮攻趙殺扈輒斬首十萬，次年取宜安；本篇同記秦殺扈輒斬首十萬，繼以李牧宜安破秦走桓齮。姓名、秦將所屬與相接的扈輒／宜安戰事支持暫同指。武遂／平陽、取宜安／走桓齮及相對紀年各存，不因身份接合判定戰事結果或改正文。不得由此等同樊於期，亦不補未知生卒。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true}],"passages":[{"id":"c-shiji-006-shihuang:p010","text":"嫪毐封為長信侯。予之山陽地，令毐居之。宮室車馬衣服苑囿馳獵恣毐。事無小大皆決於毐。又以河西太原郡更為毐國。九年，彗星見，或竟天。攻魏垣、蒲陽。四月，上宿雍。己酉，王冠，帶劍。長信侯毐作亂而覺，矯王御璽及太后璽以發縣卒及衛卒、官騎、戎翟君公、舍人，將欲攻蘄年宮為亂。王知之，令相國昌平君、昌文君發卒攻毐。戰咸陽，斬首數百，皆拜爵，及宦者皆在戰中，亦拜爵一級。毐等敗走。即令國中：有生得毐，賜錢百萬；殺之，五十萬。盡得毐等。衛尉竭、內史肆、佐弋竭、中大夫令齊等二十人皆梟首。車裂以徇，滅其宗。及其舍人，輕者為鬼薪。及奪爵遷蜀四千餘家，家房陵。四月寒凍，有死者。楊端和攻衍氏。彗星見西方，又見北方，從斗以南八十日。十年，相國呂不韋坐嫪毐免。桓齮為將軍。齊、趙來置酒。齊人茅焦說秦王曰：「秦方以天下為事，而大王有遷母太后之名，恐諸侯聞之，由此倍秦也。」秦王乃迎太后於雍而入咸陽，復居甘泉宮。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:m010-0000","start":0,"end":2,"surface":"嫪毐","kind":"person","person_id":"hzt_j3d_1r3","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m010-0004","start":4,"end":7,"surface":"長信侯","kind":"person","person_id":"hzt_j3d_1r3","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m010-0015","start":15,"end":16,"surface":"毐","kind":"person","person_id":"hzt_j3d_1r3","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m010-0030","start":30,"end":31,"surface":"毐","kind":"person","person_id":"hzt_j3d_1r3","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m010-0039","start":39,"end":40,"surface":"毐","kind":"person","person_id":"hzt_j3d_1r3","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m010-0074","start":74,"end":75,"surface":"上","kind":"person","person_id":"ao3_0fy_d45_AAA","status":"contextual_provisional","note":"限嫪毐亂及尉繚說秦王的連續敘事，官稱與引用中大王指在位秦王政，不跨篇套用。"},{"id":"c-shiji-006-shihuang:m010-0081","start":81,"end":82,"surface":"王","kind":"person","person_id":"ao3_0fy_d45_