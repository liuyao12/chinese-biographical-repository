on_note":"來源內明確人物，未明姓名/跨篇身份不補；不推生母或親屬typed。","paragraph_id":"c-jinshu-044-luchen-cuiyue:p002","chapter_id":"c-jinshu-044-luchen-cuiyue"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-044-luchen-cuiyue:p002","text":"建興末，隨琨投段匹磾。匹磾自領幽州，取諶為別駕。匹磾既害琨，尋亦敗喪。時南路阻絕，段末波在遼西，諶往投之。元帝之初，末波通使于江左，諶因其使抗表理琨，文旨甚切，於是即加弔祭。累徵諶為散騎中書侍郎，而為末波所留，遂不得南渡。末波死，弟遼代立，諶流離世故且二十載。石季龍破遼西，復為季龍所得，以為中書侍郎、國子祭酒、侍中、中書監。屬冉閔誅石氏，諶隨閔軍，于襄國遇害，時年六十七，是歲永和六年也。","text_layer":"received_chapter","source_position":{"raw_start":5635,"raw_end":5839,"raw_character_offsets":[5637,5638,5639,5640,5641,5642,5643,5644,5645,5646,5647,5648,5649,5650,5651,5652,5653,5654,5655,5656,5657,5658,5659,5660,5661,5662,5663,5664,5665,5666,5667,5668,5669,5670,5671,5672,5673,5674,5675,5676,5677,5678,5679,5680,5681,5682,5683,5684,5685,5686,5687,5688,5689,5690,5691,5692,5693,5694,5695,5696,5697,5698,5699,5700,5701,5702,5703,5704,5705,5706,5707,5708,5709,5710,5711,5712,5713,5714,5715,5716,5717,5718,5719,5720,5721,5722,5723,5724,5725,5726,5727,5728,5729,5730,5731,5732,5733,5734,5735,5736,5737,5738,5739,5740,5741,5742,5743,5744,5745,5746,5747,5748,5749,5750,5751,5752,5753,5754,5755,5756,5757,5758,5759,5760,5761,5762,5763,5764,5765,5766,5767,5768,5769,5770,5771,5772,5773,5774,5775,5776,5777,5778,5779,5780,5781,5782,5783,5784,5785,5786,5787,5788,5789,5790,5791,5792,5793,5794,5795,5796,5797,5798,5799,5800,5801,5802,5803,5804,5805,5806,5807,5808,5809,5810,5811,5812,5813,5814,5815,5816,5817,5818,5819,5820,5821,5822,5823,5824,5825,5831,5832,5833,5834,5837,5838],"first_line":69,"last_line":69,"revision_id":1775345,"projection_sha256":"9cbb35455ee1949173cbf47116c1c680f768bd475407e624ce8fee50604fedaa","source_layer":"received_biography"},"mentions":[{"id":"c-jinshu-044-luchen-cuiyue:p002:m0005","start":5,"end":6,"surface":"琨","kind":"person","person_id":