000369","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m017-0053","start":53,"end":55,"surface":"德公","kind":"person","person_id":"cbr-p000353","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m017-0075","start":75,"end":77,"surface":"宣公","kind":"person","person_id":"cbr-p000370","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m017-0080","start":80,"end":82,"surface":"成公","kind":"person","person_id":"cbr-p000371","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m017-0085","start":85,"end":87,"surface":"穆公","kind":"person","person_id":"cbr-p000253","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m017-0090","start":90,"end":92,"surface":"宣公","kind":"person","person_id":"cbr-p000370","status":"contextual_provisional"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-005-qin:p018","text":"宣公元年，衛、燕伐周，出惠王，立王子穨。三年，鄭伯、虢叔殺子穨而入惠王。四年，作密畤。與晉戰河陽，勝之。十二年，宣公卒。生子九人，莫立，立其弟成公。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m018-0000","start":0,"end":2,"surface":"宣公","kind":"person","person_id":"cbr-p000370","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m018-0012","start":12,"end":14,"surface":"惠王","kind":"person","person_id":"cbr-p000236","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m018-0016","start":16,"end":19,"surface":"王子穨","kind":"person","person_id":"cbr-p000238","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m018-0023","start":23,"end":25,"surface":"鄭伯","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、短稱或官稱指代待核；不補造姓名或自動合併。"},{"id":"c-shiji-005-qin:m018-0026","start":26,"end":28,"surface":"虢叔","kind":"person","person_id":"cbr-p000372","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m018-0029","start":29,"end":31,"surface":"子穨","kind":"person","person_id":"cbr-p000238","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m018-0033","start":33,"end":35,"surface":"惠王","kind":"person","person_id":"cbr-p000236","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m018-0056","start":56,"end":58,"surface":"宣公","kind":"person","person_id":"cbr-p000370","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m018-0060","start":60,"end":64,"surface":"生子九人","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、短稱或官稱指代待核；不補造姓名或自動合併。"},{"id":"c-shiji-005-qin:m018-0071","start":71,"end":73,"surface":"成公","kind":"person","person_id":"cbr-p000371","status":"contextual_provisional"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-005-qin:p019","text":"成公元年，梁伯、芮伯來朝。齊桓公伐山戎，次于孤竹。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m019-0000","start":0,"end":2,"surface":"成公","kind":"person","person_id":"cbr-p000371","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m019-0005","start":5,"end":7,"surface":"梁伯","kind":"person","person_id":"cbr-p000368","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m019-0008","start":8,"end":10,"surface":"芮伯","kind":"person","person_id":"cbr-p000369","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m019-0013","start":13,"end":16,"surface":"齊桓公","kind":"person","person_id":"cbr-p000235","status":"contextual_provisional"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-005-qin:p020","text":"成公立四年卒。子七人，莫立，立其弟繆公。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m020-0000","start":0,"end":2,"surface":"成公","kind":"person","person_id":"cbr-p000371","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m020-0007","start":7,"end":10,"surface":"子七人","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、短稱或官稱指代待核；不補造姓名或自動合併。"},{"id":"c-shiji-005-qin:m020-0017","start":17,"end":19,"surface":"繆公","kind":"person","person_id":"cbr-p000253","status":"contextual_provisional"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-006-shihuang:p071","text":"德公享國二年。居雍大鄭宮。生宣公、成公、繆公。葬陽。初伏，以御蠱。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:p071:m0000","start":0,"end":2,"surface":"德公","kind":"person","person_id":"cbr-p000353","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p071:m0014","start":14,"end":16,"surface":"宣公","kind":"person","person_id":"cbr-p000370","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p071:m0017","start":17,"end":19,"surface":"成公","kind":"person","person_id":"cbr-p000371","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p071:m0020","start":20,"end":22,"surface":"繆公","kind":"person","person_id":"cbr-p000253","status":"contextual_provisional"}],"chapter_id":"c-shiji-006-shihuang","book_id":"b-shiji-006","work_id":"w-shiji","source_id":"s-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:p073","text":"成公享國四年，居雍之宮。葬陽。齊伐山戎、孤竹。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:p073:m0000","start":0,"end":2,"surface":"成公","kind":"person","person_id":"cbr-p000371","status":"contextual_provisional"}],"chapter_id":"c-shiji-006-shihuang","book_id":"b-shiji-006","work_id":"w-shiji","source_id":"s-shiji-006-shihuang"}],"sources":[{"chapter_id":"c-shiji-005-qin","work_id":"w-shiji","book_id":"b-shiji-005","source_id":"s-shiji-005-qin","source":{"title":"史記／卷005","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷005","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷005&oldid=8744286","revision_id":8744286,"accessed_on":"2026-10-09","extent":"77段數位正文；排除註釋版導覽與註號，見證行內校勘符號暫原樣保留。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫 CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","no