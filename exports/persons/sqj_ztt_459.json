atus":"source_attested","evidence":[{"chapter_id":"c-shiji-108-han","source_id":"s-shiji-108-han","paragraph_id":"c-shiji-108-han:p011","quote":"安國爲人多大略，智足以當世取合，而出於忠厚焉。貪嗜於財。所推舉皆廉士，賢於己者也。於梁舉壺遂、臧固、郅他，皆天下名士，士亦以此稱慕之，唯天子以爲國器。安國爲御史大夫四歳餘，丞相田蚡死，安國行丞相事，奉引墮車蹇。天子議置相，欲用安國，使使視之，蹇甚，乃更以平棘侯薛澤爲丞相。安國病免數月，蹇愈，上復以安國爲中尉。歳餘，徙爲衞尉。"}],"attestations":[{"id":"th-shiji108-036:a001","paragraph_id":"c-shiji-108-han:p011","start":127,"end":130,"surface":"平棘侯","person_mention_id":"c-shiji-108-han:m011-0130","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"記來源任官或用稱；未明年月及終止事件保持未知，篇末附載評論不作獨立任官證據。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji108-037","person_id":"sqj_ztt_459","title":"丞相","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-108-han","source_id":"s-shiji-108-han","paragraph_id":"c-shiji-108-han:p011","quote":"安國爲人多大略，智足以當世取合，而出於忠厚焉。貪嗜於財。所推舉皆廉士，賢於己者也。於梁舉壺遂、臧固、郅他，皆天下名士，士亦以此稱慕之，唯天子以爲國器。安國爲御史大夫四歳餘，丞相田蚡死，安國行丞相事，奉引墮車蹇。天子議置相，欲用安國，使使視之，蹇甚，乃更以平棘侯薛澤爲丞相。安國病免數月，蹇愈，上復以安國爲中尉。歳餘，徙爲衞尉。"}],"attestations":[{"id":"th-shiji108-037:a001","paragraph_id":"c-shiji-108-han:p011","start":133,"end":135,"surface":"丞相","person_mention_id":"c-shiji-108-han:m011-0130","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-108-han","source_id":"s-shiji-108-han","paragraph_id":"c-shiji-108-han:p011","quote":"安國爲人多大略，智足以當世取合，而出於忠厚焉。貪嗜於財。所推舉皆廉士，賢於己者也。於梁舉壺遂、臧固、郅他，皆天下名士，士亦以此稱慕之，唯天子以爲國器。安國爲御史大夫四歳餘，丞相田蚡死，安國行丞相事，奉引墮車蹇。天子議置相，欲用安國，使使視之，蹇甚，乃更以平棘侯薛澤爲丞相。安國病免數月，蹇愈，上復以安國爲中尉。歳餘，徙爲衞尉。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"記來源任官或用稱；未明年月及終止事件保持未知，篇末附載評論不作獨立任官證據。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji096-051","person_id":"sqj_ztt_459","scope":"same_chapter","chapter_ids":["c-shiji-096-zhang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["薛澤"],"evidence":[{"paragraph_id":"c-shiji-096-zhang:p019","quote":"自申屠嘉死之後，景帝時開封侯陶青、桃侯劉舍為丞相。及今上時，柏至侯許昌、平棘侯薛澤、武彊侯莊青翟、高陵侯趙周等為丞相。皆以列侯繼嗣，娖娖廉謹，為丞相備員而已，無所能發明功名有著於當世者。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定短稱；韋賢與韋玄成分傳區別，第23段掾陳平另候選，第25段長安相工田文不與孟嘗君合併。趙堯、任敖、申屠嘉、鄧通、晁錯的短名依各段人物語境，王陵夫人與王陵分人。張蒼父長不滿五尺的長為身長敘述，不作父名。王侯與太子未詳名不補名，跨篇同指另待證據。"}],"equivalence_decisions":[{"id":"eq-shiji096-continuation-xueze","person_ids":["sqj_ztt_459"],"canonical_person_id":"sqj_ztt_459","scope":"cross_chapter","chapter_ids":["c-shiji-096-zhang","c-shiji-108-han"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-096-zhang","source_id":"s-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p019","quote":"自申屠嘉死之後，景帝時開封侯陶青、桃侯劉舍為丞相。及今上時，柏至侯許昌、平棘侯薛澤、武彊侯莊青翟、高陵侯趙周等為丞相。皆以列侯繼嗣，娖娖廉謹，為丞相備員而已，無所能發明功名有著於當世者。","mention_ids":["c-shiji-096-zhang:m019-0039"]},{"chapter_id":"c-shiji-108-han","source_id":"s-shiji-108-han","paragraph_id":"c-shiji-108-han:p011","quote":"安國爲人多大略，智足以當世取合，而出於忠厚焉。貪嗜於財。所推舉皆廉士，賢於己者也。於梁舉壺遂、臧固、郅他，皆天下名士，士亦以此稱慕之，唯天子以爲國器。安國爲御史大夫四歳餘，丞相田蚡死，安國行丞相事，奉引墮車蹇。天子議置相，欲用安國，使使視之，蹇甚，乃更以平棘侯薛澤爲丞相。安國病免數月，蹇愈，上復以安國爲中尉。歳餘，徙爲衞尉。","mention_ids":["c-shiji-108-han:m011-0130"]}],"rationale":"本篇武帝時平棘侯薛澤為相，與韓安國病蹇未用而改以平棘侯薛澤為丞相的明示爵號、姓名、任職相配；不把韓安國行相事等同已實授丞相。 附載班固稱與正文層次分存；同書各段不算獨立見證，未核書影。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true}],"passages":[{"id":"c-shiji-096-zhang:p019","text":"自申屠嘉死之後，景帝時開封侯陶青、桃侯劉舍為丞相。及今上時，柏至侯許昌、平棘侯薛澤、武彊侯莊青翟、高陵侯趙周等為丞相。皆以列侯繼嗣，娖娖廉謹，為丞相備員而已，無所能發明功名有著於當世者。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhang:m019-0001","start":1,"end":4,"surface":"申屠嘉","kind":"person","person_id":"yph_dkb_w4w","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m019-0008","start":8,"end":10,"surfa