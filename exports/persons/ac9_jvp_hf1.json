onal"},{"id":"c-sanguozhi-049-shixie-complete:p009:m0103","surface":"燮","start":103,"end":104,"kind":"person","person_id":"p2p_gqb_6ar","status":"contextual_provisional"},{"id":"c-sanguozhi-049-shixie-complete:p009:m0111","surface":"雍闓","start":111,"end":113,"kind":"person","person_id":"7vv_kii_wu6","status":"contextual_provisional"},{"id":"c-sanguozhi-049-shixie-complete:p009:m0124","surface":"權","start":124,"end":125,"kind":"person","person_id":"572_278_cba","status":"contextual_provisional"},{"id":"c-sanguozhi-049-shixie-complete:p009:m0140","surface":"壹","start":140,"end":141,"kind":"person","person_id":"09m_7ry_tws","status":"contextual_provisional"},{"id":"c-sanguozhi-049-shixie-complete:p009:m0149","surface":"燮","start":149,"end":150,"kind":"person","person_id":"p2p_gqb_6ar","status":"contextual_provisional"},{"id":"c-sanguozhi-049-shixie-complete:p009:m0154","surface":"權","start":154,"end":155,"kind":"person","person_id":"572_278_cba","status":"contextual_provisional"},{"id":"c-sanguozhi-049-shixie-complete:p009:m0207","surface":"壹","start":207,"end":208,"kind":"person","person_id":"09m_7ry_tws","status":"contextual_provisional"},{"id":"c-sanguozhi-049-shixie-complete:p009:m0216","surface":"權","start":216,"end":217,"kind":"person","person_id":"572_278_cba","status":"contextual_provisional"},{"id":"c-sanguozhi-049-shixie-complete:p009:m0231","surface":"燮","start":231,"end":232,"kind":"person","person_id":"p2p_gqb_6ar","status":"contextual_provisional"}],"chapter_id":"c-sanguozhi-049-shixie-complete","book_id":"b-sanguozhi-049","work_id":"w-sanguozhi","source_id":"s-sanguozhi-049-shixie-complete-ws2075209"},{"id":"c-sanguozhi-053-xuezong:line047","text":"津小檢攝，威武不足，為所陵侮，遂至殺沒。後得零陵賴恭，先輩仁謹，不曉時事。表又遣長沙吳巨為蒼梧太守。巨武夫輕悍，不為恭服。（所取）（輒）相怨恨，逐出恭，求步騭。是時津故將夷廖、錢博之徒尚多，騭以次鋤治，綱紀適定，會仍召出。呂岱既至，有士氏之變。越軍南征，平討之日，改置長吏，章明王綱，威加萬里，大小承風。由此言之，綏邊撫裔，實有其人。牧伯之任，既宜清能，荒流之表，禍福尤甚。今日交州雖名粗定，尚有高涼宿賊；其南海、蒼梧、鬱林、珠官四郡界未綏，依作寇盜，專為亡叛逋逃之藪。若岱不復南，新刺史宜得精密，檢攝八郡，方略智計，能稍稍以漸（能）治高涼者，假其威寵，借之形勢，責其成效，庶幾可補復。如但中人。近守常法，無奇數異術者，則群惡日滋，久遠成害。故國之安危，在於所任，不可不察也。竊懼朝廷忽輕其選，故敢竭愚情，以廣聖思。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-053-xuezong:line047:m0000","start":0,"end":1,"surface":"津","kind":"person","person_id":"xqp_a2u_qb3","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xuezong:line047:m0024","start":24,"end":26,"surface":"賴恭","kind":"person","person_id":"ac9_jvp_hf1","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xuezong:line047:m0037","start":37,"end":38,"surface":"表","kind":"person","person_id":"866_0fd_205","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xuezong:line047:m0042","start":42,"end":44,"surface":"吳巨","kind":"person","person_id":"o4w_m9s_2kp","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xuezong:line047:m0050","start":50,"end":51,"surface":"巨","kind":"person","person_id":"o4w_m9s_2kp","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xuezong:line047:m0058","start":58,"end":59,"surface":"恭","kind":"person","person_id":"ac9_jvp_hf1","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xuezong:line047:m0074","start":74,"end":75,"surface":"恭","kind":"person","person_id":"ac9_jvp_hf1","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xuezong:line047:m0077","start":77,"end":79,"surface":"步騭","kind":"person","person_id":"snv_2iq_jes","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xuezong:line047:m0082","start":82,"end":83,"surface":"津","kind":"person","person_id":"xqp_a2u_qb3","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xuezong:line047:m0085","start":85,"end":87,"surface":"夷廖","kind":"person","person_id":"14t_evz_3hz","status":"contextual_provisional","in