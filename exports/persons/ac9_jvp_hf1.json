h_id":"c-sanguozhi-053-xuezong:line047","chapter_id":"c-sanguozhi-053-xuezong"},{"id":"c-sanguozhi-053-xuezong:line047:m0058","start":58,"end":59,"surface":"恭","kind":"person","person_id":"ac9_jvp_hf1","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-053-xuezong:line047","chapter_id":"c-sanguozhi-053-xuezong"},{"id":"c-sanguozhi-053-xuezong:line047:m0074","start":74,"end":75,"surface":"恭","kind":"person","person_id":"ac9_jvp_hf1","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-053-xuezong:line047","chapter_id":"c-sanguozhi-053-xuezong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-049-shixie-complete:p008","text":"　　朱符死後，漢遣張津為交州刺史，津後又為其將區景所殺，而荊州牧劉表遣零陵賴恭代津。是時蒼梧太守史璜死，表又遣吳巨代之，與恭俱至。漢聞張津死，賜燮璽書曰：「交州絕域，南帶江海，上恩不宣，下義壅隔，知逆賊劉表又遣賴恭闚看南土，今以燮為綏南中郎將，董督七郡，領交阯太守如故。」後燮遣吏張旻奉貢詣京都，是時天下喪亂，道路斷絕，而燮不廢貢職，特復下詔拜安遠將軍，封龍度亭侯。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":45,"last_line":45,"raw_start":5743,"raw_end":5926,"raw_character_offsets":[5743,5744,5745,5746,5747,5748,5749,5750,5751,5752,5753,5754,5755,5756,5757,5758,5759,5760,5761,5762,5763,5764,5765,5766,5767,5768,5769,5770,5771,5772,5773,5774,5775,5776,5777,5778,5779,5780,5781,5782,5783,5784,5785,5786,5787,5788,5789,5790,5791,5792,5793,5794,5795,5796,5797,5798,5799,5800,5801,5802,5803,5804,5805,5806,5807,5808,5809,5810,5811,5812,5813,5814,5815,5816,5817,5818,5819,5820,5821,5822,5823,5824,5825,5826,5827,5828,5829,5830,5831,5832,5833,5834,5835,5836,5837,5838,5839,5840,5841,5842,5843,5844,5845,5846,5847,5848,5849,5850,5851,5852,5853,5854,5855,5856,5857,5858,5859,5860,5861,5862,5863,5864,5865,5866,5867,5868,5869,5870,5871,5872,5873,5874,5875,5876,5877,5878,5879,5880,5881,5882,5883,5884