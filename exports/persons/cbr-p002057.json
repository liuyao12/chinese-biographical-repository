{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p002057","identity_policy":"contextual_provisional","person_ids":["cbr-p002057"],"persons":[{"id":"cbr-p002057","label":"少康（越世家祖系候選）","status":"active","historicity":"legendary_tradition","aliases":[{"surface":"夏后帝少康","mention_ids":["c-shiji-041-yue:m001-0013"]},{"surface":"少康","mention_ids":["c-shiji-041-yue:m029-0002"]}],"evidence":[{"mention_id":"c-shiji-041-yue:m001-0013","chapter_id":"c-shiji-041-yue","paragraph_id":"c-shiji-041-yue:p001","quote":"夏后帝少康"},{"mention_id":"c-shiji-041-yue:m029-0002","chapter_id":"c-shiji-041-yue","paragraph_id":"c-shiji-041-yue:p029","quote":"少康"}]}],"mentions":[{"id":"c-shiji-041-yue:m001-0013","start":13,"end":18,"surface":"夏后帝少康","kind":"person","person_id":"cbr-p002057","status":"contextual_provisional","paragraph_id":"c-shiji-041-yue:p001","chapter_id":"c-shiji-041-yue"},{"id":"c-shiji-041-yue:m029-0002","start":2,"end":4,"surface":"少康","kind":"person","person_id":"cbr-p002057","status":"contextual_provisional","paragraph_id":"c-shiji-041-yue:p029","chapter_id":"c-shiji-041-yue"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji041-003","person_id":"cbr-p002057","surfaces":["夏后帝少康","少康"],"scope":"same_chapter","chapter_ids":["c-shiji-041-yue"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-041-yue:p001","quote":"越王句踐，其先禹之苗裔，而夏后帝少康之庶子也。封於會稽，以奉守禹之祀。文身斷髮，披草萊而邑焉。後二十餘世，至於允常。允常之時，與呉王闔廬戰而相怨伐。允常卒，子句踐立，是爲越王。"},{"paragraph_id":"c-shiji-041-yue:p029","quote":"越祖少康，至於允常。其子始霸，與呉爭彊。槜李之役，闔閭見傷。會稽之恥，勾踐欲當。種誘以利，蠡悉其良。折節下士，致膽思嘗。卒複讎寇，遂殄大邦。後不量力，滅於無彊。"}],"rationale":"限本篇明示姓名、短稱與同一事件角色；范蠡自謂鴟夷子皮、陶朱公按明文相接。跨篇僅使用另存同指決定，不按同名合併；匿名楚王不套用楚威王，未知諸子姓名不補。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-041-yue:p001","text":"越王句踐，其先禹之苗裔，而夏后帝少康之庶子也。封於會稽，以奉守禹之祀。文身斷髮，披草萊而邑焉。後二十餘世，至於允常。允常之時，與呉王闔廬戰而相怨伐。允常卒，子句踐立，是爲越王。","annotation_status":"named_menti