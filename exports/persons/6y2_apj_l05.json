,"human_reviewed":false,"model":null}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-liang015-xiefei-songdi","person_id":"6y2_apj_l05","surfaces":["宋帝","天子"],"scope":"cross_chapter","chapter_ids":["c-liangshu-015-xiefei","c-songshu-066-wangjinghong"],"status":"contextual_provisional","evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-015","chapter_id":"c-liangshu-015-xiefei","source_id":"s-liangshu015-ws1506954","paragraph_id":"c-liangshu-015-xiefei:p003","quote_passage_ref":"data/corpus/liangshu/015-xiefei.json"},{"work_id":"w-songshu","book_id":"b-songshu-066","source_id":"s-songshu-066-wangjinghong","chapter_id":"c-songshu-066-wangjinghong","paragraph_id":"c-songshu-066-wangjinghong:line022","quote_passage_ref":"data/corpus/songshu/066.json"}],"rationale":"四友入侍宋帝發生齊高帝驃騎輔政並進太尉期間；固定宋010順皇帝諱準、昇明元年八月庚午明謝朏江斅褚炫劉候入直殿省參侍文義，同次四人事件定位準。現宋066順帝昇明二年等已具同一帝身份。天子指同帝，不是另一無名天子。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null,"external_reference_readings":[{"id":"r-song010-128","title":"宋書/卷10","revision_id":2312005,"url":"https://zh.wikisource.org/w/index.php?title=%E5%AE%8B%E6%9B%B8%2F%E5%8D%B710&oldid=2312005","raw_path":"source-evidence/liang015-xiefei-reading/external/song010-fixed.wikitext","metadata_path":"source-evidence/liang015-xiefei-reading/external/song010-metadata.json","raw_sha256":"a480369ee03a0a587c7ff2ca0d63cfddf14d3a9aed3a0cfd679e9d64c3b06b54","raw_start":128,"raw_end":320,"quote":"順皇帝諱準，字仲謀，<ref>字仲謀　元龜一八二同。南史、建康實錄、御覽一二八引作「字仲謨」。</ref>小字智觀，明帝第三子也。{{YL|泰始五年}}七月癸丑生。七年，封安成王，食邑三千戶。仍拜撫軍將軍，置佐史。廢帝即位，為揚州刺史。{{YL|元徽二年}}，進號車騎將軍、都督揚南豫二州諸軍事，給鼓吹一部，刺史如故。四年，又進號驃騎大將軍、開府儀同三司，班劍三十人，都督、刺史如故。","text_layer":"received_chapter","read_scope":"完整首段名諱及出身，原注保持外參。","image_verified":false,"human_reviewed":false},{"id":"r-song010-966","title":"宋書/卷10","revision_id":2312005,"url":"https://zh.wikisource.org/w/index.php?title=%E5%AE%8B%E6%9B%B8%2F%E5%8D%B710&oldid=2312005","raw_path":"source-evidence/liang015-xiefei-reading/external/song010-fixed.wikitext","metadata_path":"source-evidence/liang015-xiefei-reading/external/song010-metadata.json","raw_sha256":"a480369ee03a0a587c7ff2ca0d63cfddf14d3a9aed3a0cfd679e9d64c3b06b54","raw_start":966,"raw_end":1231,"quote":"雍州大水，八月壬子，遣使賑卹，蠲除稅調。以驃騎長史劉澄之為南豫州刺史。山陽太守于天寶、新吳縣子秦立有罪，下獄死。戊午，改平準署。辛酉，以宣城太守李靈謙為兗州刺史。癸亥，司徒袁粲鎮石頭。<ref>司徒袁粲鎮石頭　「司徒」各本作「司空」。按時蕭道成為司空，袁粲為司徒，見南齊書高祖紀，及本書袁粲傳。今據南史、建康實錄改正。</ref>丁卯，原除元年以前逋調；復郡縣祿田。戊辰，崇拜帝所生陳昭華為皇太妃。庚午，司空長史謝朏、衞軍長史江斅、中書侍郎褚炫、武陵王文學劉候入直殿省，參侍文義。齊王固讓司空，庚辰，以為驃騎大將軍、開府儀同三司。","text_layer":"received_chapter","read_scope":"完整昇明元年八月原段，明同四人入直殿省；其中劉候與主文劉俁異字不校。","image_verified":false,"human_reviewed":false}]},{"id":"d-nanshi024-an-cheng","person_id":"6y2_apj_l05","surfaces":["安成王"],"scope":"same_chapter","chapter_ids":["c-nanshi-024-wang-family"],"status":"contextual_provisional","confidence_level":"high","identification_basis":{"kind":"source_context","target_mention_ids":["c-nanshi-024-wang-family:line053:m0009"]},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-024","chapter_id":"c-nanshi-024-wang-family","source_id":"s-nanshi-024-wang-family","paragraph_id":"c-nanshi-024-wang-family:line021","quote_passage_ref":"data/corpus/nanshi/024.json"},{"work_id":"w-nanshi","book_id":"b-nanshi-024","chapter_id":"c-nanshi-024-wang-family","source_id":"s-nanshi-024-wang-family","paragraph_id":"c-nanshi-024-wang-family:line053","quote_passage_ref":"data/corpus/nanshi/024.json"}],"rationale":"綸之先仕安成王記室，袁粲任司徒時已有評論，後文才到齊永明。依宋順帝準先封安成王、置佐史的同時材料辨識，不取梁安成王蕭秀。","references":[{"title":"《宋書》卷10正文","url":"https://zh.wikisource.org/w/index.php?oldid=2312005","source_revision":2312005,"source_position":{"first_line":4,"last_line":4},"quote":"順皇帝諱準，字仲謀，","wikitext_sha256":"a480369ee03a0a587c7ff2ca0d63cfddf14d3a9aed3a0cfd679e9d64c3b06b54","image_verified":false},{"title":"《宋書》卷10正文","url":"https://zh.wikisource.org/w/index.php?oldid=2312005","source_revision":2312005,"sourc