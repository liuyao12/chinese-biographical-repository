n":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"person_id":"ohv_l50_sf5","title":null,"surname":"劉","ming":"寔","zi":"子真","additional_names":["劉實"],"work_id":"w-jinshu","book_id":"b-jinshu-075","chapter_id":"c-jinshu-075-xunsong-families","source_id":"s-jinshu-075-xunsong-families","paragraph_id":"c-jinshu-075-xunsong-families:xunsong-body-132:p001","status":"editorial_provisional","human_reviewed":false,"model":null,"references":[{"title":"《晉書》卷41劉寔本傳","url":"https://zh.wikisource.org/w/index.php?oldid=1394380","source_revision":1394380,"source_position":{"first_line":40,"last_line":40},"quote":"劉寔，字子真，平原高唐人也。漢濟北惠王壽之後也，父廣，斥丘令。寔少貧苦，賣牛衣以自給。然好學，手約繩，口誦書，博通古今。清身潔己，行無瑕玷。郡察孝廉，州舉秀才，皆不行。以計吏入洛，調為河南尹丞，遷尚書郎、廷尉正。後曆吏部郎，參文帝相國軍事，封循陽子。","raw_context_quote":"　　劉寔，字子真，平原高唐人也。漢濟北惠王壽之後也，父廣，斥丘令。寔少貧苦，賣牛衣以自給。然好學，手約繩，口誦書，博通古今。清身潔己，行無瑕玷。郡察孝廉，州舉秀才，皆不行。以計吏入洛，調為河南尹丞，遷尚書郎、廷尉正。後曆吏部郎，參文帝相國軍事，封循陽子。","raw_context_quote_sha256":"69d49d2d382d5d5ce16fe453f2722140dde0fd0f0e0238f228058b61fded90d6","wikitext_sha256":"0230dea8669f537b6f8d112f841a943abf6b150734a19572e31bb5462db01742","scope":"primary_parallel_same_person_office_sequence","image_verified":false},{"title":"《晉書》卷41劉寔本傳","url":"https://zh.wikisource.org/w/index.php?oldid=1394380","source_revision":1394380,"source_position":{"first_line":62,"last_line":62},"quote":"泰始初，進爵為伯，累遷少府。咸甯中為太常。轉尚書。杜預之伐吳也，寔以本官行鎮南軍司。","raw_context_quote":"　　泰始初，進爵為伯，累遷少府。咸甯中為太常。轉尚書。杜預之伐吳也，寔以本官行鎮南軍司。","raw_context_quote_sha256":"6ff47083649d476aeb0cb9087f404663c231c2b6de6f990bbc46f1e722773e9d","wikitext_sha256":"0230dea8669f537b6f8d112f841a943abf6b150734a19572e31bb5462db01742","scope":"primary_parallel_same_person_office_sequence","image_verified":false},{"title":"《晉書》卷41劉寔本傳","url":"https://zh.wikisource.org/w/index.php?oldid=1394380","source_revision":1394380,"source_position":{"first_line":68,"last_line":68},"quote":"後起為國子祭酒、散騎常侍。湣懷太子初封廣陵王，高選師友，以寔為師。元康初，進爵為侯，累遷太子太保，加侍中、特進、右光祿大夫、開府儀同三司，領冀州都督。九年，策拜司空，遷太保，轉太傅。太安初，寔以老病遜位，賜安車駟馬、錢百萬，以侯就第。及長沙成都之相攻也，寔為軍人所掠，潛歸鄉里。","raw_context_quote":"　　後起為國子祭酒、散騎常侍。湣懷太子初封廣陵王，高選師友，以寔為師。元康初，進爵為侯，累遷太子太保，加侍中、特進、右光祿大夫、開府儀同三司，領冀州都督。九年，策拜司空，遷太保，轉太傅。太安初，寔以老病遜位，賜安車駟馬、錢百萬，以侯就第。及長沙成都之相攻也，寔為軍人所掠，潛歸鄉里。","raw_context_quote_sha256":"eb5b43c101c732dd76f45832d5dc8667687c857fcaf08203ceeb3898d9fd6710","wikitext_sha256":"0230dea8669f537b6f8d112f841a943abf6b150734a19572e31bb5462db01742","scope":"primary_parallel_same_person_office_sequence","image_verified":false}],"note":"本名及字子真依卷41傳首；卷65作劉實，原文不改。太常與司空分記官歷，不以司空作所有時點的稱號。","quote_passage_ref":"data/corpus/jinshu/075.json"}],"mentions":[{"id":"c-jinshu-065-wangdao-family:p001:m0082","start":82,"end":84,"surface":"劉實","kind":"person","person_id":"ohv_l50_sf5","status":"contextual_provisional","paragraph_id":"c-jinshu-065-wangdao-family:p001","chapter_id":"c-jinshu-065-wangdao-family"},{"id":"c-jinshu-075-xunsong-families:xunsong-body-132:p001:m0260","start":260,"end":262,"surface":"劉寔","kind":"person","person_id":"ohv_l50_sf5","status":"contextual_provisional","paragraph_id":"c-jinshu-075-xunsong-families:xunsong-body-132:p001","chapter_id":"c-jinshu-075-xunsong-families"},{"id":"c-jinshu-075-xunsong-families:xunsong-body-134:p001:m0111","start":111,"end":112,"surface":"實","kind":"person","person_id":"ohv_l50_sf5","status":"contextual_provisional","paragraph_id":"c-jinshu-075-xunsong-families:xunsong-body-134:p001","chapter_id":"c-jinshu-075-xunsong-families"}],"relations":[],"title_holdings":[{"id":"th-jinshu065-wang-003","person_id":"ohv_l50_sf5","title":"司空","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-065","chapter_id":"c-jinshu-065-wangdao-family","source_id":"s-jinshu-065-wangdao-family","paragraph_id":"c-jinshu-065-wangdao-family:p001","person_mention_id":"c-jinshu-065-wangdao-family:p001:m0082","quote_passage_ref":"data/corpus/jinshu/065.json"}],"attestations":[{"id":"th-jinshu065-wang-003:a001","paragraph_id":"c-jinshu-065-wangdao-family:p001","start":80,"end":82,"surfac