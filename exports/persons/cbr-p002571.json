tus":"contextual_provisional"},{"id":"c-shiji-046-tian:m029-0023","start":23,"end":24,"surface":"髡","kind":"person","person_id":"cbr-p002766","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m029-0034","start":34,"end":37,"surface":"騶忌子","kind":"person","person_id":"cbr-p002759","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m029-0045","start":45,"end":48,"surface":"淳于髡","kind":"person","person_id":"cbr-p002766","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m029-0062","start":62,"end":65,"surface":"騶忌子","kind":"person","person_id":"cbr-p002759","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m029-0079","start":79,"end":82,"surface":"淳于髡","kind":"person","person_id":"cbr-p002766","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m029-0105","start":105,"end":108,"surface":"騶忌子","kind":"person","person_id":"cbr-p002759","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m029-0122","start":122,"end":125,"surface":"淳于髡","kind":"person","person_id":"cbr-p002766","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m029-0149","start":149,"end":152,"surface":"騶忌子","kind":"person","person_id":"cbr-p002759","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m029-0168","start":168,"end":171,"surface":"淳于髡","kind":"person","person_id":"cbr-p002766","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m029-0189","start":189,"end":192,"surface":"騶忌子","kind":"person","person_id":"cbr-p002759","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m029-0213","start":213,"end":216,"surface":"淳于髡","kind":"person","person_id":"cbr-p002766","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m029-0244","start":244,"end":247,"surface":"騶忌子","kind":"person","person_id":"cbr-p002759","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m029-0265","start":265,"end":268,"surface":"淳于髡","kind":"person","person_id":"cbr-p002766","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m029-0279","start":279,"end":281,"surface":"其仆","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、對話、稱謂或索隱述贊短稱待核，不補姓名及成員。"},{"id":"c-shiji-046-tian:m029-0323","start":323,"end":325,"surface":"成侯","kind":"person","person_id":"cbr-p002759","status":"contextual_provisional"}],"chapter_id":"c-shiji-046-tian","book_id":"b-shiji-046","work_id":"w-shiji","source_id":"s-shiji-046-tian"},{"id":"c-shiji-046-tian:p039","text":"宣王喜文學游説之士，自如騶衍、淳于髡、田駢、接子、愼到、環淵之徒七十六人，皆賜列第，爲上大夫，不治而議論。是以齊稷下學士復盛，且數百千人。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-046-tian:m039-0000","start":0,"end":2,"surface":"宣王","kind":"person","person_id":"cbr-p002768","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m039-0012","start":12,"end":14,"surface":"騶衍","kind":"person","person_id":"cbr-p002794","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m039-0015","start":15,"end":18,"surface":"淳于髡","kind":"person","person_id":"cbr-p002766","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m039-0019","start":19,"end":21,"surface":"田駢","kind":"person","person_id":"cbr-p002795","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m039-0022","start":22,"end":24,"surface":"接子","kind":"person","person_id":"cbr-p002796","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m039-0025","start":25,"end":27,"surface":"愼到","kind":"person","person_id":"cbr-p002797","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m039-0028","start":28,"end":30,"surface":"環淵","kind":"person","person_id":"cbr-p002798","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m039-0032","start":32,"end":36,"surface":"七十六人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、對話、稱謂或索隱述贊短稱待核，不補姓名及成員。"},{"id":"c-shiji-046-tian:m039-0056","start":56,"end":60,"surface":"稷下學士","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、對話、稱謂或索隱述贊短稱待核，不補姓名及成員。"}],"chapter_id":"c-shiji-046-tian","book_id":"b-shiji-046","work_id":"w-shiji","source_id":"s-shiji-046-tian"},{"id":"c-shiji-074-mengxun:p006","text":"自騶衍與齊之稷下先生，如淳于髡、慎到、環淵、接子、田駢、騶奭之徒，各著書言治亂之事，以干世主，豈可勝道哉！","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-074-mengxun:m006-0001","start":1,"end":3,"surface":"騶衍","kind":"person","person_id":"cbr-p004291","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m006-0008","start":8,"end":10,"surface":"先生","kind":"unresolved","person_id":null,"status":"unresolved","note":"稷下先生為群稱，不專指隨後列舉的淳于髡。原錨點ID與字位保留。"},{"id":"c-shiji-074-mengxun:m006-0012","start":12,"end":15,"surface":"淳于髡","kind":"person","person_id":"cbr-p004306","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m006-0016","start":16,"end":18,"surface":"慎到","kind":"person","person_id":"cbr-p004307","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m006-0019","start":19,"end":21,"surface":"環淵","kind":"person","person_id":"cbr-p004308","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m006-0022","start":22,"end":24,"surface":"接子","kind":"person","person_id":"cbr-p004309","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m006-0025","start":25,"end":27,"surface":"田駢","kind":"person","person_id":"cbr-p004310","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m006-0028","start":28,"end":30,"surface":"騶奭","kind":"person","person_id":"cbr-p004311","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m006-0030","start":30,"end":32,"surface":"之徒","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名群體、族屬、學說合稱或匿名說話者保持未定；不將黃老儒墨自動拆為人名，也不補群體成員。"},{"id":"c-shiji-074-mengxun:m006-0044","start":44,"end":46,"surface":"世主","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名群體、族屬、學說合稱或匿名說話者保持未定；不將黃老儒墨自動拆為人名，也不補群體成員。"}],"chapter_id":"c-shiji-074-mengxun","book_id":"b-shiji-074","work_id":"w-shiji","source_id":"s-shiji-074-mengxun"},{"id":"c-shiji-074-mengxun:p007","text":"淳于髡，齊人也。博聞彊記，學無所主。其諫說，慕晏嬰之為人也，然而承意觀色為務。客有見髡於梁惠王，惠王屏左右，獨坐而再見之，終無言也。惠王怪之，以讓客曰：「子之稱淳于先生，管、晏不及，及見寡人，寡人未有得也。豈寡人不足為言邪？何故哉？」客以謂髡。髡曰：「固也。吾前見王，王志在驅逐；後復見王，王志在音聲：吾是以默然。」客具以報王，王大駭，曰：「嗟乎，淳于先生誠聖人也！前淳于先生之來，人有獻善馬者，寡人未及視，會先生至。後先生之來，人有獻謳者，未及試，亦會先生來。寡人雖屏人，然私心在彼，有之。」後淳于髡見，壹語連三日三夜無倦。惠王欲以卿相位待之，髡因謝去。於是送以安車駕駟，束帛加璧，黃金百鎰。終身不仕。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-074-mengxun:m007-0000","start":0,"end":3,"surface":"淳于髡","kind":"person","person_id":"cbr-p004306","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m007-0023","start":23,"end":25,"surface":"晏嬰","kind":"person","person_id":"cbr-p004312","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m007-0039","start":39,"end":40,"surface":"客","kind":"person","person_id":"cbr-p004313","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m007-0042","start":42,"end":43,"surface":"髡","kind":"person","person_id":"cbr-p004306","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m007-0044","start":44,"end":47,"surface":"梁惠王","kind":"person","person_id":"cbr-p004278","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m007-0048","start":48,"end":50,"surface":"惠王","kind":"person","person_id":"cbr-p004278","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m007-0051","start":51,"end":53,"surface":"左右","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名群體、族屬、學說合稱或匿名說話者保持未定；不將黃老儒墨自動拆為人名，也不補群體成員。"},{"id":"c-shiji-074-mengxun:m007-0066","start":66,"end":68,"surface":"惠王","kind":"person","person_id":"cbr-p004278","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m007-0073","start":73,"end":74,"surface":"客","kind":"person","person_id":"cbr-p004313","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m007-0077","start":77,"end":78,"surface":"子","kind":"person","person_id":"cbr-p004313","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m007-0080","start":80,"end":84,"sur