74-mengxun:p007","chapter_id":"c-shiji-074-mengxun"},{"id":"c-shiji-074-mengxun:m010-0009","start":9,"end":12,"surface":"淳于髡","kind":"person","person_id":"cbr-p004306","status":"contextual_provisional","paragraph_id":"c-shiji-074-mengxun:p010","chapter_id":"c-shiji-074-mengxun"},{"id":"c-shiji-074-mengxun:m011-0033","start":33,"end":36,"surface":"淳于髡","kind":"person","person_id":"cbr-p004306","status":"contextual_provisional","paragraph_id":"c-shiji-074-mengxun:p011","chapter_id":"c-shiji-074-mengxun"},{"id":"c-shiji-074-mengxun:m011-0064","start":64,"end":65,"surface":"髡","kind":"person","person_id":"cbr-p004306","status":"contextual_provisional","paragraph_id":"c-shiji-074-mengxun:p011","chapter_id":"c-shiji-074-mengxun"}],"relations":[],"title_holdings":[{"id":"th-shiji046-035","person_id":"cbr-p002766","title":"上大夫","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-046-tian","source_id":"s-shiji-046-tian","paragraph_id":"c-shiji-046-tian:p039","quote":"宣王喜文學游説之士，自如騶衍、淳于髡、田駢、接子、愼到、環淵之徒七十六人，皆賜列第，爲上大夫，不治而議論。是以齊稷下學士復盛，且數百千人。"}],"attestations":[{"id":"th-shiji046-035:a001","paragraph_id":"c-shiji-046-tian:p039","start":43,"end":46,"surface":"上大夫","person_mention_id":"c-shiji-046-tian:m039-0015","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-046-tian","source_id":"s-shiji-046-tian","paragraph_id":"c-shiji-046-tian:p039","quote":"宣王喜文學游説之士，自如騶衍、淳于髡、田駢、接子、愼到、環淵之徒七十六人，皆賜列第，爲上大夫，不治而議論。是以齊稷下學士復盛，且數百千人。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予、任事與文獻用稱分存；欲使為卿且辭未當已任，諡稱不當生前任職，死亡或首次用稱不補任期。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji074-004","person_id":"cbr-p004306","title":"先生","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-074-mengxun","source_id":"s-shiji-074-mengxun","paragraph_id":"c-shiji-074-mengxun:p007","quote":"淳于髡，齊人也。博聞彊記，學無所主。其諫說，慕晏嬰之為人也，然而承意觀色為務。客有見髡於梁惠王，惠王屏左右，獨坐而再見之，終無言也。惠王怪之，以讓客曰：「子之稱淳于先生，管、晏不及，及見寡人，寡人未有得也。豈寡人不足為言邪？何故哉？」客以謂髡。髡曰：「固也。吾前見王，王志在驅逐；後復見王，王志在音聲：吾是以默然。」客具以報王，王大駭，曰：「嗟乎，淳于先生誠聖人也！前淳于先生之來，人有獻善馬者，寡人未及視，會先生至。後先生之來，人有獻謳者，未及試，亦會先生來。寡人雖屏人，然私心在彼，有之。」後淳于髡見，壹語連三日三夜無倦。惠王欲以卿相位待之，髡因謝去。於是送以安車駕駟，束帛加璧，黃金百鎰。終身不仕。"}],"attestations":[{"id":"th-shiji074-004:a001","paragraph_id":"c-shiji-074-mengxun:p007","start":82,"end":84,"surface":"先生","person_mention_id":"c-shiji-074-mengxun:m007-0080","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予、文獻用稱與任事分存，未知日期與終點不補；淳于髡欲以卿相位待而謝去不作已任，春申君死亡不直接作全部爵位終點。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji074-005","person_id":"cbr-p004306","title":"列大夫","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-074-mengxun","source_id":"s-shiji-074-mengxun","paragraph_id":"c-shiji-074-mengxun:p010","quote":"於是齊王嘉之，自如淳于髡以下，皆命曰列大夫，為開第康莊之衢，高門大屋，尊寵之。覽天下諸侯賓客，言齊能致天下賢士也。"}],"attestations":[{"id":"th-shiji074-005:a001","paragraph_id":"c-shiji-074-mengxun:p010","start":18,"end":21,"surface":"列大夫","person_mention_id":"c-shiji-074-mengxun:m010-0009","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-074-mengxun","source_id":"s-shiji-074-mengxun","paragraph_id":"c-shiji-074-mengxun:p010","quote":"於是齊王嘉之，自如淳于髡以下，皆命曰列大夫，為開第康莊之衢，高門大屋，尊寵之。覽天下諸侯賓客，言齊能致天下賢士也。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予、文獻用稱與任事分存，未知日期與終點不補；淳于髡欲以卿相位待而謝去不作已任，春申君死亡不直接作全部爵位終點。本筆列大夫依自如淳于髡以下皆命曰的明示授稱，不據此消除第7段終身不仕原語或判定實際任事。未按群體名單擴為每人的官職。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji044-072","person_id":"cbr-p002571","surfaces":["淳于髡"],"scope":"same_chapter","chapter_ids":["c-shiji-044-wei"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-044-wei:p039","quote":"惠王數被於軍旅，卑禮厚幣以招賢者。鄒衍、淳于髡、孟軻皆至梁。梁惠王曰：『寡人不佞，兵三折於外，太子虜，上將死，國以空虚，以羞先君宗廟社稷，寡人甚丑之，叟不遠千里，辱幸至獘邑之廷，將何利吾國？』孟軻曰：『君不可以言利若是。夫君欲利則大夫欲利，大夫欲利則庶人欲利，上下爭利，國則危矣。爲人君，仁義而已矣，何以利爲！』"}],"rationale":"限本篇明示姓名、是為及同段連續語境；外黃徐子／客按同一勸還對話暫接，龐涓／涓按同一馬陵戰暫接。孫子與孫臏、公子赫與襄王、齊王與齊宣王仍分候選；武下將識國別待核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji046-060","person_id":"cbr-p002766","scope":"same_chapter","chapter_ids":["c-shiji-046-tian"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["淳于髡","髡"],"evidence":[{"paragraph_id":"c-shiji-046-tian:p029","quote":"騶忌子見三月而受相印。淳于髡見之曰：「善説哉！髡有愚志，願陳諸前。」騶忌子曰：「謹受教。」淳于髡曰：「得全全昌，失全全亡。」騶忌子曰：「謹受令，請謹毋離前。」淳于髡曰：「狶膏棘軸，所以爲滑也，然而不能運方穿。」騶忌子曰：「謹受令，請謹事左右。」淳于髡曰：「弓膠昔干，所以爲合也，然而不能傅合疎罅。」騶忌子曰：「謹受令，請謹自附於萬民。」淳于髡曰：「狐裘雖敝，不可補以黃狗之皮。」騶忌子曰：「謹受令，請謹擇君子，毋雜小人其閒。」淳于髡曰：「大車不較，不能載其常任；琴瑟不較，不能成其五音。」騶忌子曰：「謹受令，請謹修法律而督姦吏。」淳于髡説畢，趨出，至門，而面其仆曰：「是人者，吾語之微言五，其應我若響之應聲，是人必封不久矣。」居朞，封以下邳，號曰成侯。"},{"paragraph_id":"c-shiji-046-tian:p039","quote":"宣王喜文學游説之士，自如騶衍、淳于髡、田駢、接子、愼到、環淵之徒七十六人，皆賜列第，爲上大夫，不治而議論。是以齊稷下學士復盛，且數百千人。"}],"rationale":"限本篇明示姓名、是為、繼位及局部事件暫接；姜齊與田齊桓公、不同時段未名王及同字忌分開。孫子不先補孫臏，子守髙唐不補闕字，索隱短稱與代詞仍待核；未跨篇按同名接人。"},{"id":"d-shiji074-030","person_id":"cbr-p004306","scope":"same_chapter","chapter_ids":["c-shiji-074-mengxun"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"依本段明示人名及局部敘事暫接，淳于髡髡先生、騶奭奭與晏嬰晏各限所述範圍；管引古不補管仲。薦髡客子稱及兩次獻馬獻謳者保留未名候選，不確證不同匿名人物。齊王命列大夫與齊宣、齊襄王分候選，未因敘事相鄰自動同指；群體之徒、之屬及學說合稱不補成員。欲以卿相待而謝去不當任官，李斯弟子不當子嗣，墨翟年代或曰異說保留。第6段稷下先生為群稱已留未解，不當淳于髡個體；第7段先生受話另按明示淳于先生暫接。","surfaces":["先生","淳于先生","淳于髡","髡"],"evidence":[{"paragraph_id":"c-shiji-074-mengxun:p006","quote":"自騶衍與齊之稷下先生，如淳于髡、慎到、環淵、接子、田駢、騶奭之徒，各著書言治亂之事，以干世主，豈可勝道哉！"},{"paragraph_id":"c-shiji-074-mengxun:p007","quote":"淳于髡，齊人也。博聞彊記，學無所主。其諫說，慕晏嬰之為人也，然而承意觀色為務。客有見髡於梁惠王，惠王屏左右，獨坐而再見之，終無言也。惠王怪之，以讓客曰：「子之稱淳于先生，管、晏不及，及見寡人，寡人未有得也。豈寡人不足為言邪？何故哉？」客以謂髡。髡曰：「固也。吾前見王，王志在驅逐；後復見王，王志在音聲：吾是以默然。」客具以報王，王大駭，曰：「嗟乎，淳于先生誠聖人也！前淳于先生之來，人有獻善馬者，寡人未及視，會先生至。後先生之來，人有獻謳者，未及試，亦會先生來。寡人雖屏人，然私心在彼，有之。」後淳于髡見，壹語連三日三夜無倦。惠王欲以卿相位待之，髡因謝去。於是送以安車駕駟，束帛加璧，黃金百鎰。終身不仕。"},{"paragraph_id":"c-shiji-074-mengxun:p010","quote":"於是齊王嘉之，自如淳于髡以下，皆命曰列大夫，為開第康莊之衢，高門大屋，尊寵之。覽天下諸侯賓客，言齊能致天下賢士也。"},{"paragraph_id":"c-shiji-074-mengxun:p011","quote":"荀卿，趙人。年五十始來游學於齊。騶衍之術迂大而閎辯；奭也文具難施；淳于髡久與處，時有得善言。故齊人頌曰：「談天衍，雕龍奭，炙轂過髡。」田駢之屬皆已死齊襄王時，而荀卿最為老師。齊尚修列大夫之缺，而荀卿三為祭酒焉。齊人或讒荀卿，荀卿乃適楚，而春申君以為蘭陵令。春申君死而荀卿廢，因家蘭陵。李斯嘗為弟子，已而相秦。荀卿嫉濁世之政，亡國亂君相屬，不遂大道而營於巫祝，信禨祥，鄙儒小拘，如莊周等又猾稽亂俗，於是推儒、墨、道德之行事興壞，序列著數萬言而卒。因葬蘭陵。"}]}],"equivalence_decisions":[{"id":"eq-shiji074-kun","person_ids":["cbr-p002571","cbr-p002766","cbr-p004306"],"canonical_person_id":"cbr-p002571","scope":"cross_chapter","chapter_ids":["c-shiji-044-wei","c-shiji-046-tian","c-shiji-074-mengxun"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-044-wei","source_id":"s-shiji-044-wei","paragraph_id":"c-shiji-044-wei:p039","quote":"惠王數被於軍旅，卑禮厚幣以招賢者。鄒衍、淳于髡、孟軻皆至梁。梁惠王曰：『寡人不佞，兵三折於外，太子虜，上將死，國以空虚，以羞先君宗廟社稷，寡人甚丑之，叟不遠千里，辱幸至獘邑之廷，將何利吾國？』孟軻曰：『君不可以言利若是。夫君欲利則大夫欲利，大夫欲利則庶人欲利，上下爭利，國則危矣。爲人君，仁義而已矣，何以利爲！』","mention_ids":["c-shiji-044-wei:m039-0020"]},{"chapter_id":"c-shiji-046-tian","source_id":"s-shiji-046-tian","paragraph_id":"c-shiji-046-tian:p039","quote":"宣王喜文學游説之士，自如騶衍、淳于髡、田駢、接子、愼到、環淵之徒七十六人，皆賜列第，爲上大夫，不治而議論。是以齊稷下學士復盛，且數百千人。","mention_ids":["c-shiji-046-tian:m039-0015"]},{"chapter_id":"c-shiji-074-mengxun","source_id":"s-shiji-074-mengxun","paragraph_id":"c-shiji-074-mengxun:p006","quote":"自騶衍與齊之稷下先生，如淳于髡、慎到、環淵、接子、田駢、騶奭之徒，各著書言治亂之事，以干世主，豈可勝道哉！","mention_ids":["c-shiji-074-mengxun:m006-0012"]},{"chapter_id":"c-shiji-074-mengxun","source_id":"s-shiji-074-mengxun","paragraph_id":"c-shiji-074-mengxun:p007","quote":"淳于髡，齊人也。博聞彊記，學無所主。其諫說，慕晏嬰之為人也，然而承意觀色為務。客有見髡於梁惠王，惠王屏左右，獨坐而再見之，終無言也。惠王怪之，以讓客曰：「子之稱淳于先生，管、晏不及，及見寡人，寡人未有得也。豈寡人不足為言邪？何故哉？」客以謂髡。髡曰：「固也。吾前見王，王志在驅逐；後復見王，王志在音聲：吾是以默然。」客具以報王，王大駭，曰：「嗟乎，淳于先生誠聖人也！前淳于先生之來，人有獻善馬者，寡人未及視，會先生至。後先生之來，人有獻謳者，未及試，亦會先生來。寡人雖屏人，然私心在彼，有之。」後淳于髡見，壹語連三日三夜無倦。惠王欲以卿相位待之，髡因謝去。於是送以安車駕駟，束帛加璧，黃金百鎰。終身不仕。","mention_ids":["c-shiji-074-mengxun:m007-0000","c-shiji-074-mengxun:m007-0042","c-shiji-074-mengxun:m007-0080","c-shiji-074-mengxun:m007-0120","c-shiji-074-mengxun:m007-0122","c-shiji-074-mengxun:m007-0174","c-shiji-074-mengxun:m007-0184","c-shiji-074-mengxun:m007-0205","c-shiji-074-mengxun:m007-0210","c-shiji-074-mengxun:m007-0227","c-shiji-074-mengxun:m007-0248","c-shiji-074-mengxun:m007-0273"]}],"rationale":"魏世家淳于髡至梁與本篇見梁惠王相配；田世家與本篇同列稷下騶衍、田駢、接子、慎到、環淵等人物。兩項舊ID按訪梁與同列稷下語境暫接，終身不仕不與授稱自動調和。 原字、原文與已發ID保留，同書篇章不視為獨立見證；同指不確證全部紀年、任職或敘事，也不作全域同名批量合併。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-044-wei:p039","text":"惠王數被於軍旅，卑禮厚幣以招賢者。鄒衍、淳于髡、孟軻皆至梁。梁惠王曰：『寡人不佞，兵三折於外，太子虜，上將死，國以空虚，以羞先君宗廟社稷，寡人甚丑之，叟不遠千里，辱幸至獘邑之廷，將何利吾國？』孟軻曰：『君不可以言利若是。夫君欲利則大夫欲利，大夫欲利則庶人欲利，上下爭利，國則危矣。爲人君，仁義而已矣，何以利爲！』","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-044-wei:m039-0000","start":0,"end":2,"surface":"惠王","kind":"person","person_id":"cbr-p002534","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m039-0014","start":14,"end":16,"surface":"賢者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱與未定指代保留；公中緩爭太子不作已授太子，將識國別及孫子身份待核。"},{"id":"c-shiji-044-wei:m039-0017","start":17,"end":19,"surface":"鄒衍","kind":"person","person_id":"cbr-p002570","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m039-0020","start":20,"end":23,"surface":"淳于髡","kind":"person","person_id":"cbr-p002571","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m039-0024","start":24,"end":26,"surface":"孟軻","kind":"person","person_id":"cbr-p002572","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m039-0030","start":30,"end":33,"surface":"梁惠王","kind":"person","person_id":"cbr-p002534","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m039-0047","start":47,"end":50,"surface":"太子虜","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱與未定指代保留；公中緩爭太子不作已授太子，將識國別及孫子身份待核。"},{"id":"c-shiji-044-wei:m039-0051","start"