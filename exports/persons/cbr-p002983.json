{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p002983","identity_policy":"contextual_provisional","person_ids":["cbr-p002983"],"persons":[{"id":"cbr-p002983","label":"葛嬰（陳涉世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"葛嬰","mention_ids":["c-shiji-048-chenshe:m003-0203","c-shiji-048-chenshe:m005-0000","c-shiji-048-chenshe:m005-0036"]},{"surface":"嬰","mention_ids":["c-shiji-048-chenshe:m005-0013"]}],"evidence":[{"mention_id":"c-shiji-048-chenshe:m003-0203","chapter_id":"c-shiji-048-chenshe","paragraph_id":"c-shiji-048-chenshe:p003","quote":"葛嬰"},{"mention_id":"c-shiji-048-chenshe:m005-0000","chapter_id":"c-shiji-048-chenshe","paragraph_id":"c-shiji-048-chenshe:p005","quote":"葛嬰"},{"mention_id":"c-shiji-048-chenshe:m005-0013","chapter_id":"c-shiji-048-chenshe","paragraph_id":"c-shiji-048-chenshe:p005","quote":"嬰"},{"mention_id":"c-shiji-048-chenshe:m005-0036","chapter_id":"c-shiji-048-chenshe","paragraph_id":"c-shiji-048-chenshe:p005","quote":"葛嬰"}]}],"mentions":[{"id":"c-shiji-048-chenshe:m003-0203","start":203,"end":205,"surface":"葛嬰","kind":"person","person_id":"cbr-p002983","status":"contextual_provisional","paragraph_id":"c-shiji-048-chenshe:p003","chapter_id":"c-shiji-048-chenshe"},{"id":"c-shiji-048-chenshe:m005-0000","start":0,"end":2,"surface":"葛嬰","kind":"person","person_id":"cbr-p002983","status":"contextual_provisional","paragraph_id":"c-shiji-048-chenshe:p005","chapter_id":"c-shiji-048-chenshe"},{"id":"c-shiji-048-chenshe:m005-0013","start":13,"end":14,"surface":"嬰","kind":"person","person_id":"cbr-p002983","status":"contextual_provisional","paragraph_id":"c-shiji-048-chenshe:p005","chapter_id":"c-shiji-048-chenshe"},{"id":"c-shiji-048-chenshe:m005-0036","start":36,"end":38,"surface":"葛嬰","kind":"person","person_id":"cbr-p002983","status":"contextual_provisional","paragraph_id":"c-shiji-048-chenshe:p005","chapter_id":"c-shiji-048-chenshe"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji048-021","person_id":"cbr-p002983","surfaces":["嬰","葛嬰"],"scope":"same_chapter","chapter_ids":["c-shiji-048-chenshe"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-048-chenshe:p003","quote":"吳廣素愛人，士卒多為用者。將尉醉，廣故數言欲亡，忿恚尉，令辱之，以激怒其眾。尉果笞廣。尉劍挺，廣起，奪而殺尉。陳勝佐之，并殺兩尉。召令徒屬曰：「公等遇雨，皆已失期，失期當斬。藉第令毋斬，而戍死者固十六七。且壯士不死即已，死即舉大名耳，王侯將相寧有種乎！」徒屬皆曰：「敬受命。」乃詐稱公子扶蘇、項燕，從民欲也。袒右，稱大楚。為壇而盟，祭以尉首。陳勝自立為將軍，吳廣為都尉。攻大澤鄉，收而攻蘄。蘄下，乃令符離人葛嬰將兵徇蘄以東。攻銍、酇、苦、柘、譙皆下之。行收兵。比至陳，車六七百乘，騎千余，卒數萬人。攻陳，陳守令皆不在，獨守丞與戰譙門中。弗勝，守丞死，乃入據陳。數日，號令召三老、豪傑與皆來會計事。三老、豪傑皆曰：「將軍身被堅執銳，伐無道，誅暴秦，復立楚國之社稷，功宜為王。」陳涉乃立為王，號為張楚。"},{"paragraph_id":"c-shiji-048-chenshe:p005","quote":"葛嬰至東城，立襄彊為楚王。嬰後聞陳王已立，因殺襄彊，還報。至陳，陳王誅殺葛嬰。陳王令魏人周市北徇魏地。吳廣圍滎陽。李由為三川守，守滎陽，吳叔弗能下。陳王徵國之豪傑與計，以上蔡人房君蔡賜為上柱國。"}],"rationale":"限明示名、字及局部軍事角色；陳勝涉、吳廣叔、蔡賜房君與周文周章暫接，吳廣韓廣分開。引文四君短稱及比擬人物另留候選，詐稱扶蘇項燕不合陳吳，褚賈署稱不補姓名。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-048-chenshe:p003","text":"吳廣素愛人，士卒多為用者。將尉醉，廣故數言欲亡，忿恚尉，令辱之，以激怒其眾。尉果笞廣。尉劍挺，廣起，奪而殺尉。陳勝佐之，并殺兩尉。召令徒屬曰：「公等遇雨，皆已失期，失期當斬。藉第令毋斬，而戍死者固十六七。且壯士不死即已，死即舉大名耳，王侯將相寧有種乎！」徒屬皆曰：「敬受命。」乃詐稱公子扶蘇、項燕，從民欲也。袒右，稱大楚。為壇而盟，祭以尉首。陳勝自立為將軍，吳廣為都尉。攻大澤鄉，收而攻蘄。蘄下，乃令符離人葛嬰將兵徇蘄以東。攻銍、酇、苦、柘、譙皆下之。行收兵。比至陳，車六七百乘，騎千余，卒數萬人。攻陳，陳守令皆不在，獨守丞與戰譙門中。弗勝，守丞死，乃入據陳。數日，號令召三老、豪傑與皆來會計事。三老、豪傑皆曰：「將軍身被堅執銳，伐無道，誅暴秦，復立楚國之社稷，功宜為王。」陳涉乃立為王，號為張楚。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-048-chenshe:m003-0000","start":0,"end":2,"surface":"吳廣","kind":"person","person_id":"cbr-p002980","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m003-0013","start":13,"end":15,"surface":"將尉","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱、對話或未名者待核；普通動詞、詐稱與矯命不當真實人物身份。"},{"id":"c-shiji-048-chenshe:m003-0017","start":17,"end":18,"surface":"廣","kind":"person","person_id":"cbr-p002980","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m003-0041","start":41,"