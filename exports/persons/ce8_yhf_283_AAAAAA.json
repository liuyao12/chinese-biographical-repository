功臣。」即日拜昉開府儀同三司，仍詔猛與行軍總管韋洸便留嶺表經略。","mentions":[{"id":"c-nanshi-024-wangmeng:p004:m0040","surface":"猛","start":40,"end":41,"person_id":"72e_1a7_3ac_AAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangmeng:p004:m0056","surface":"方慶","start":56,"end":58,"person_id":"eaj_zin_zxy_AB","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangmeng:p004:m0067","surface":"伯信","start":67,"end":69,"person_id":"5ye_fwj_neh_B","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangmeng:p004:m0071","surface":"猛","start":71,"end":72,"person_id":"72e_1a7_3ac_AAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangmeng:p004:m0081","surface":"猛","start":81,"end":82,"person_id":"72e_1a7_3ac_AAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangmeng:p004:m0087","surface":"戴智烈","start":87,"end":90,"person_id":"094_ia6_xvv","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangmeng:p004:m0095","surface":"曾孝遠","start":95,"end":98,"person_id":"px5_c29_v6z","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangmeng:p004:m0132","surface":"申包胥","start":132,"end":135,"person_id":"0rc_0ya_wg8","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangmeng:p004:m0166","surface":"辛昉","start":166,"end":168,"person_id":"kmq_op1_21u","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangmeng:p004:m0183","surface":"昉","start":183,"end":184,"person_id":"kmq_op1_21u","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangmeng:p004:m0187","surface":"猛","sta