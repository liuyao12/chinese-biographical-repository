3456,3457],"projection_sha256":"7b6d6df53ec6b8ee089b699965ff1c0b693d71f575980cf7b534ea3d61077c5a","editorial_excerpt_boundary":true},"chapter_id":"c-chenshu-007-shenwuhua","book_id":"b-chenshu-007","work_id":"w-chenshu","source_id":"s-chenshu-007-shenwuhua-ws2015446"},{"id":"c-chenshu-014-wangyong:p001","text":"禎明三年，隋師濟江，〔東〕衡州刺史王勇遣高州刺史戴智烈將五百騎迎方慶，欲令承制總督征討諸軍事。是時隋行軍總管韋洸帥兵度嶺，宣隋文帝敕云：「若嶺南平定，留勇與豐州刺史鄭萬頃且依舊職。」方慶聞之，恐勇賣己，乃不從，率兵以拒智烈。智烈與戰，敗之，斬方慶於廣州，虜其妻子。","mentions":[{"id":"c-chenshu-014-wangyong:p001:m0017","surface":"王勇","start":17,"end":19,"person_id":"72e_1a7_3ac_AAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-chenshu-014-wangyong:p001:m0024","surface":"戴智烈","start":24,"end":27,"person_id":"094_ia6_xvv","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-chenshu-014-wangyong:p001:m0032","surface":"方慶","start":32,"end":34,"person_id":"eaj_zin_zxy_AB","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-chenshu-014-wangyong:p001:m0054","surface":"韋洸","start":54,"end":56,"person_id":"fh0_oxc_05e_AB","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-chenshu-014-wangyong:p001:m0076","surface":"勇","start":76,"end":77,"person_id":"72e_1a7_3ac_AAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-chenshu-014-wangyong:p001:m0082","surface":"鄭萬頃","start":82,"end":85,"person_id":"70o_j6h_wpc_A","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-chenshu-014-wangyong:p001:m0091","surface":"方慶","start":91,"end":93,"person_id":"eaj_zin_zxy_AB","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-chenshu-014-wangyong:p001:m0097","surface":"勇","start":97,"end":98,"person_id":"72e_1a7_3ac_AAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-ch