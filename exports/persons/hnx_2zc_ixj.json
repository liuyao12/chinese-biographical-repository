d":"s-shiji-092-hanxin","work_id":"w-shiji","book_id":"b-shiji-092","chapter_id":"c-shiji-092-hanxin","mention_count":2,"mention_ids":["c-shiji-092-hanxin:m019-0129","c-shiji-092-hanxin:m019-0254"],"paragraph_ids":["c-shiji-092-hanxin:p019"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-089-zhanger"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-089-zhanger:m015-0135","start":135,"end":137,"surface":"陳澤","kind":"person","person_id":"hnx_2zc_ixj","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p015","chapter_id":"c-shiji-089-zhanger"},{"id":"c-shiji-089-zhanger:m015-0258","start":258,"end":260,"surface":"陳澤","kind":"person","person_id":"hnx_2zc_ixj","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p015","chapter_id":"c-shiji-089-zhanger"},{"id":"c-shiji-089-zhanger:m015-0308","start":308,"end":310,"surface":"陳澤","kind":"person","person_id":"hnx_2zc_ixj","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p015","chapter_id":"c-shiji-089-zhanger"},{"id":"c-shiji-089-zhanger:m017-0041","start":41,"end":43,"surface":"陳澤","kind":"person","person_id":"hnx_2zc_ixj","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p017","chapter_id":"c-shiji-089-zhanger"},{"id":"c-shiji-089-zhanger:m017-0055","start":55,"end":57,"surface":"陳澤","kind":"person","person_id":"hnx_2zc_ixj","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p017","chapter_id":"c-shiji-089-zhanger"},{"id":"c-shiji-092-hanxin:m019-0129","start":129,"end":131,"surface":"陳澤","kind":"person","person_id":"hnx_2zc_ixj","status":"contextual_provisional","paragraph_id":"c-shiji-092-hanxin:p019","chapter_id":"c-shiji-092-hanxin"},{"id":"c-shiji-092-hanxin:m019-0254","start":254,"end":256,"surface":"陳澤","kind":"person","person_id":"hnx_2zc_ixj","status":"contextual_provisional","paragraph_id":"c-shiji-092-hanxin:p019","chapter_id":"c-shiji-092-hanxin"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji089-041","person_id":"hnx_2zc_ixj","scope":"same_chapter","chapter_ids":["c-shiji-089-zhanger"],"status":"contextual_provisional","rationale":"按明示姓名及局部語境承接；武臣與趙歇、張敖的趙王用稱限各段，張黡張黶按同行事件暫接但原字分存。未名者不補姓名。","reviewer":"Codex（AI 代理）","surfaces":["陳澤"],"evidence":[{"paragraph_id":"c-shiji-089-zhanger:p015","quote":"章邯引兵至邯鄲，皆徙其民河内，夷其城郭。張耳與趙王歇走入鉅鹿城，王離圍之。陳餘北收常山兵，得數萬人，軍鉅鹿北。章邯軍鉅鹿南棘原，筑甬道屬河，餉王離。王離兵食多，急攻鉅鹿。鉅鹿城中食盡兵少，張耳數使人召前陳餘，陳餘自度兵少，不敵秦，不敢前。數月，張耳大怒，怨陳餘，使張黶、陳澤往讓陳餘曰：「始吾與公爲刎頸交，今王與耳旦暮且死，而公擁兵數萬，不肯相救，安在其相爲死！茍必信，胡不赴秦軍倶死？且有十一二相全。」陳餘曰：「吾度前終不能救趙，徒盡亡軍。且餘所以不倶死，欲爲趙王、張君報秦。今必倶死，如以肉委餓虎，何益？」張黶、陳澤曰：「事已急，要以倶死立信，安知後慮！」陳餘曰：「吾死顧以爲無益。必如公言。」乃使五千人令張黶、陳澤先嘗秦軍，至皆沒。"},{"paragraph_id":"c-shiji-089-zhanger:p017","quote":"於是趙王歇、張耳乃得出鉅鹿，謝諸侯。張耳與陳餘相見，責讓陳餘以不肯救趙，及問張黶、陳澤所在。陳餘怒曰：「張黶、陳澤以必死責臣，臣使將五千人先嘗秦軍，皆沒不出。」張耳不信，以爲殺之，數問陳餘。陳餘怒曰：「不意君之望臣深也！豈以臣爲重去將哉？」乃脱解印綬，推予張耳。張耳亦愕不受。陳餘起如廁。客有説張耳曰：「臣聞『天與不取，反受其咎』。今陳將軍與君印，君不受，反天不祥。急取之！」張耳乃佩其印，收其麾下。而陳餘還，亦望張耳不讓，遂趨出。張耳遂收其兵。陳餘獨與麾下所善數百人之河上澤中漁獵。由此陳餘、張耳遂有卻。"}]},{"id":"d-shiji092-036","person_id":"hnx_2zc_ixj","scope":"same_chapter","chapter_ids":["c-shiji-092-hanxin"],"status":"contextual_provisional","rationale":"按明示姓名及局部事件承接；王號限敘事主體，酈食其酈生及蒯通蒯生暫接，未名者與引古人物各存。不補邯欣翳及周召等短稱完整姓名。","reviewer":"Codex（AI 代理）","surfaces":["陳澤"],"evidence":[{"paragraph_id":"c-shiji-092-hanxin:p019","quote":"韓信曰：『漢王遇我甚厚，載我以其車，衣我以其衣，食我以其食。吾聞之，乘人之車者載人之患，衣人之衣者懷人之憂，食人之食者死人之事，吾豈可以鄉利倍義乎！』蒯生曰：『足下自以爲善漢王，欲建萬世之業，臣竊以爲誤矣。始常山王、成安君爲布衣時，相與爲刎頸之交，後爭張黶、陳澤之事，二人相怨。常山王背項王，奉項嬰頭而竄，逃歸於漢王。漢王借兵而東下，殺成安君泜水之南，頭足異處，卒爲天下笑。此二人相與，天下至驩也。然而卒相禽者，何也？患生於多欲而人心難測也。今足下欲行忠信以交於漢王，必不能固於二君之相與也，而事多大於張黶、陳澤。故臣以爲足下必漢王之不危己，亦誤矣。大夫種、范蠡存亡越，霸句踐，立功成名而身死亡。野獸已盡而獵狗亨。夫以交友言之，則不如張耳之與成安君者也；以忠信言之，則不過大夫種、范蠡之於句踐也。此二人者，足以觀矣。願足下深慮之。且臣聞勇略震主者身危，而功蓋天下者不賞。臣請言大王功略：足下涉西河，虜魏王，禽夏說，引兵下井陘，誅成安君，徇趙，脅燕，定齊，南摧楚人之兵二十萬，東殺龍且，西鄉以報，此所謂功無二於天下，而略不世出者也。今足下戴震主之威，挾不賞之功，歸楚，楚人不信；歸漢，漢人震恐：足下欲持是安歸乎？夫勢在人臣之位而有震主之威，名髙天下，竊爲足下危之。』韓信謝曰：『先生且休矣，吾將念之。』"}]}],"equivalence_decisions":[{"id":"eq-shiji092-review-chenze","person_ids":["hnx_2zc_ixj"],"canonical_person_id":"hnx_2zc_ixj","scope":"cross_chapter","chapter_ids":["c-shiji-092-hanxin","c-shiji-089-zhanger"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-092-hanxin","source_id":"s-shiji-092-hanxin","paragraph_id":"c-shiji-092-hanxin:p019","quote":"韓信曰：『漢王遇我甚厚，載我以其車，衣我以其衣，食我以其食。吾聞之，乘人之車者載人之患，衣人之衣者懷人之憂，食人之食者死人之事，吾豈可以鄉利倍義乎！』蒯生曰：『足下自以爲善漢王，欲建萬世之業，臣竊以爲誤矣。始常山王、成安君爲布衣時，相與爲刎頸之交，後爭張黶、陳澤之事，二人相怨。常山王背項王，奉項嬰頭而竄，逃歸於漢王。漢王借兵而東下，殺成安君泜水之南，頭足異處，卒爲天下笑。此二人相與，天下至驩也。然而卒相禽者，何也？患生於多欲而人心難測也。今足下欲行忠信以交於漢王，必不能固於二君之相與也，而事多大於張黶、陳澤。故臣以爲足下必漢王之不危己，亦誤矣。大夫種、范蠡存亡越，霸句踐，立功成名而身死亡。野獸已盡而獵狗亨。夫以交友言之，則不如張耳之與成安君者也；以忠信言之，則不過大夫種、范蠡之於句踐也。此二人者，足以觀矣。願足下深慮之。且臣聞勇略震主者身危，而功蓋天下者不賞。臣請言大王功略：足下涉西河，虜魏王，禽夏說，引兵下井陘，誅成安君，徇趙，脅燕，定齊，南摧楚人之兵二十萬，東殺龍且，西鄉以報，此所謂功無二於天下，而略不世出者也。今足下戴震主之威，挾不賞之功，歸楚，楚人不信；歸漢，漢人震恐：足下欲持是安歸乎？夫勢在人臣之位而有震主之威，名髙天下，竊爲足下危之。』韓信謝曰：『先生且休矣，吾將念之。』","mention_ids":["c-shiji-092-hanxin:m019-0129","c-shiji-092-hanxin:m019-0254"]},{"chapter_id":"c-shiji-089-zhanger","source_id":"s-shiji-089-zhanger","paragraph_id":"c-shiji-089-zhanger:p015","quote":"章邯引兵至邯鄲，皆徙其民河内，夷其城郭。張耳與趙王歇走入鉅鹿城，王離圍之。陳餘北收常山兵，得數萬人，軍鉅鹿北。章邯軍鉅鹿南棘原，筑甬道屬河，餉王離。王離兵食多，急攻鉅鹿。鉅鹿城中食盡兵少，張耳數使人召前陳餘，陳餘自度兵少，不敵秦，不敢前。數月，張耳大怒，怨陳餘，使張黶、陳澤往讓陳餘曰：「始吾與公爲刎頸交，今王與耳旦暮且死，而公擁兵數萬，不肯相救，安在其相爲死！茍必信，胡不赴秦軍倶死？且有十一二相全。」陳餘曰：「吾度前終不能救趙，徒盡亡軍。且餘所以不倶死，欲爲趙王、張君報秦。今必倶死，如以肉委餓虎，何益？」張黶、陳澤曰：「事已急，要以倶死立信，安知後慮！」陳餘曰：「吾死顧以爲無益。必如公言。」乃使五千人令張黶、陳澤先嘗秦軍，至皆沒。","mention_ids":["c-shiji-089-zhanger:m015-0135","c-shiji-089-zhanger:m015-0258","c-shiji-089-zhanger:m015-0308"]},{"chapter_id":"c-shiji-089-zhanger","source_id":"s-shiji-089-zhanger","paragraph_id":"c-shiji-089-zhanger:p017","quote":"於是趙王歇、張耳乃得出鉅鹿，謝諸侯。張耳與陳餘相見，責讓陳餘以不肯救趙，及問張黶、陳澤所在。陳餘怒曰：「張黶、陳澤以必死責臣，臣使將五千人先嘗秦軍，皆沒不出。」張耳不信，以爲殺之，數問陳餘。陳餘怒曰：「不意君之望臣深也！豈以臣爲重去將哉？」乃脱解印綬，推予張耳。張耳亦愕不受。陳餘起如廁。客有説張耳曰：「臣聞『天與不取，反受其咎』。今陳將軍與君印，君不受，反天不祥。急取之！」張耳乃佩其印，收其麾下。而陳餘還，亦望張耳不讓，遂趨出。張耳遂收其兵。陳餘獨與麾下所善數百人之河上澤中漁獵。由此陳餘、張耳遂有卻。","mention_ids":["c-shiji-089-zhanger:m017-0041","c-shiji-089-zhanger:m017-0055"]}],"rationale":"蒯通以張耳陳餘爭張黶陳澤之事為例，對同一救鉅鹿、皆沒及問責事件辨識兩人，不以同姓或先後排列接父系。 張耳疑殺與陳餘稱皆沒分存，不以同姓或排列推父系。 只接合身份，原字與敘述分存，不以引語概括新增同時死亡，不設省稱全域別名；同書不同篇不當獨立見證，未核書影。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true}],"passages":[{"id":"c-shiji-089-zhanger:p015","text":"章邯引兵至邯鄲，皆徙其民河内，夷其城郭。張耳與趙王歇走入鉅鹿城，王離圍之。陳餘北收常山兵，得數萬人，軍鉅鹿北。章邯軍鉅鹿南棘原，筑甬道屬河，餉王離。王離兵食多，急攻鉅鹿。鉅鹿城中食盡兵少，張耳數使人召前陳餘，陳餘自度兵少，不敵秦，不敢前。數月，張耳大怒，怨陳餘，使張黶、陳澤往讓陳餘曰：「始吾與公爲刎頸交，今王與耳旦暮且死，而公擁兵數萬，不肯相救，安在其相爲死！茍必信，胡不赴秦軍倶死？且有十一二相全。」陳餘曰：「吾度前終不能救趙，徒盡亡軍。且餘所以不倶死，欲爲趙王、張君報秦。今必倶死，如以肉委餓虎，何益？」張黶、陳澤曰：「事已急，要以倶死立信，安知後慮！」陳餘曰：「吾死顧以爲無益。必如公言。」乃使五千人令張黶、陳澤先嘗秦軍，至皆沒。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-089-zhanger:m015-0000","start":0,"end":2,"surface":"章邯","kind":"person","person_id":"4jv_qte_5p4","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m015-0020","start":20,"end":22,"surface":"張耳","kind":"person","person_id":"agx_sqm_4ou","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m015-0023","start":23,"end":26,"surface":"趙王歇","kind":"person","person_id":"8k3_wi8_pth","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m015-0032","start":32,"end":34,"surface":"王離","kind":"person","person_id":"gdj_k53_v1x_*A","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m015-0037","start":37,"end":39,"surface":"陳餘","kind":"person","person_id":"rx0_vif_1xq","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m015-0055","start":55,"end":57,"surface":"章邯","kind":"person","person_id":"4jv_qte_5p4","status":"contextual_provisional"},{"id