_id":"w-shiji","source_id":"s-shiji-074-mengxun"},{"id":"c-shiji-076-pingyu:p009","text":"平原君厚待公孫龍。公孫龍善爲堅白之辯，及鄒衍過趙言至道，乃絀公孫龍。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-076-pingyu:m009-0000","start":0,"end":3,"surface":"平原君","kind":"person","person_id":"cbr-p004374","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m009-0005","start":5,"end":8,"surface":"公孫龍","kind":"person","person_id":"cbr-p004393","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m009-0009","start":9,"end":12,"surface":"公孫龍","kind":"person","person_id":"cbr-p004393","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m009-0020","start":20,"end":22,"surface":"鄒衍","kind":"person","person_id":"cbr-p004394","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m009-0030","start":30,"end":33,"surface":"公孫龍","kind":"person","person_id":"cbr-p004393","status":"contextual_provisional"}],"chapter_id":"c-shiji-076-pingyu","book_id":"b-shiji-076","work_id":"w-shiji","source_id":"s-shiji-076-pingyu"}],"sources":[{"chapter_id":"c-shiji-044-wei","work_id":"w-shiji","book_id":"b-shiji-044","source_id":"s-shiji-044-wei","source":{"title":"史記／卷044","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷044","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷044&oldid=7903606","revision_id":7903606,"accessed_on":"2026-10-09","extent":"70段正文；排除現代章節標題、斠勘空段與版權告示，只去除段落外緣空白。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"取得時HTML與固定修訂一致；現代分節標題不當古代正文，不收末尾現代版權告示。保留髙、僇、无等原字與引號。","note":"已讀全70段數位正文；未核古籍影像、可靠底本或現代研究，首輪不等於完成覆核。第62段[1]至[3]為數位註號，原樣保存但不是古代正文或史料陳述，未擷取現代註釋內容。"}}},{"chapter_id":"c-shiji-046-tian","work_id":"w-shiji","book_id":"b-shiji-046","source_id":"s-shiji-046-tian","source":{"title":"史記／卷046","provider":"維基文庫","url":"https