d":"person","person_id":"cbr-p005151","status":"contextual_provisional","paragraph_id":"c-shiji-093-hanlu:p003","chapter_id":"c-shiji-093-hanlu"}],"relations":[],"title_holdings":[{"id":"th-shiji093-001","person_id":"cbr-p005151","title":"韓王","kind":"royal_rank","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-093-hanlu","source_id":"s-shiji-093-hanlu","paragraph_id":"c-shiji-093-hanlu:p001","quote":"韓王信者，故韓襄王孽孫也，長八尺五寸。及項梁之立楚後懷王也，燕、齊、趙、魏皆已前王，唯韓無有後，故立韓諸公子橫陽君成為韓王，欲以撫定韓故地。項梁敗死定陶，成奔懷王。沛公引兵擊陽城，使張良以韓司徒降下韓故地，得信，以為韓將，將其兵從沛公入武關。"}],"attestations":[{"id":"th-shiji093-001:a001","paragraph_id":"c-shiji-093-hanlu:p001","start":59,"end":61,"surface":"韓王","person_mention_id":"c-shiji-093-hanlu:m001-0054","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-093-hanlu","source_id":"s-shiji-093-hanlu","paragraph_id":"c-shiji-093-hanlu:p001","quote":"韓王信者，故韓襄王孽孫也，長八尺五寸。及項梁之立楚後懷王也，燕、齊、趙、魏皆已前王，唯韓無有後，故立韓諸公子橫陽君成為韓王，欲以撫定韓故地。項梁敗死定陶，成奔懷王。沛公引兵擊陽城，使張良以韓司徒降下韓故地，得信，以為韓將，將其兵從沛公入武關。"}]},"end":{"status":"source_event","event_type":"deposition","date_expression":null,"evidence":[{"chapter_id":"c-shiji-093-hanlu","source_id":"s-shiji-093-hanlu","paragraph_id":"c-shiji-093-hanlu:p003","quote":"項籍之封諸王皆就國，韓王成以不從無功，不遣就國，更以為列侯。及聞漢遣韓信略韓地，乃令故項籍游吳時吳令鄭昌為韓王以距漢。漢二年，韓信略定韓十餘城。漢王至河南，韓信急擊韓王昌陽城。昌降，漢王乃立韓信為韓王，常將韓兵從。三年，漢王出滎陽，韓王信、周苛等守滎陽。及楚敗滎陽，信降楚，已而得亡，復歸漢，漢復立以為韓王，竟從擊破項籍，天下定。五年春，遂與剖符為韓王，王潁川。"}]}},"interpretation_note":"按實授、自立與用稱保存；許韓王在先不作已授。明示相對年月保持原文，死亡、降漢、失侯之後裔敘事不替本人任期補終點。虜綰原字保留，以本段盧綰主語承接授爵，未核底本影像。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji093-005","person_id":"cbr-p005151","title":"列侯","kind":"noble_rank","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-093-hanlu","source_id":"s-shiji-093-hanlu","paragraph_id":"c-shiji-093-hanlu:p003","quote":"項籍之封諸王皆就國，韓王成以不從無功，不遣就國，更以為列侯。及聞漢遣韓信略韓地，乃令故項籍游吳時吳令鄭昌為韓王以距漢。漢二年，韓信略定韓十餘城。漢王至河南，韓信急擊韓王昌陽城。昌降，漢王乃立韓信為韓王，常將韓兵從。三年，漢王出滎陽，韓王信、周苛等守滎陽。及楚敗滎陽，信降楚，已而得亡，復歸漢，漢復立以為韓王，竟從擊破項籍，天下定。五年春，遂與剖符為韓王，王潁川。"}],"attestations":[{"id":"th-shiji093-005:a001","paragraph_id":"c-shiji-093-hanlu:p003","start":27,"end":29,"surface":"列侯","person_mention_id":"c-shiji-093-hanlu:m003-0010","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-093-hanlu","source_id":"s-shiji-093-hanlu","paragraph_id":"c-shiji-093-hanlu:p003","quote":"項籍之封諸王皆就國，韓王成以不從無功，不遣就國，更以為列侯。及聞漢遣韓信略韓地，乃令故項籍游吳時吳令鄭昌為韓王以距漢。漢二年，韓信略定韓十餘城。漢王至河南，韓信急擊韓王昌陽城。昌降，漢王乃立韓信為韓王，常將韓兵從。三年，漢王出滎陽，韓王信、周苛等守滎陽。及楚敗滎陽，信降楚，已而得亡，復歸漢，漢復立以為韓王，竟從擊破項籍，天下定。五年春，遂與剖符為韓王，王潁川。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"按實授、自立與用稱保存；許韓王在先不作已授。明示相對年月保持原文，死亡、降漢、失侯之後裔敘事不替本人任期補終點。虜綰原字保留，以本段盧綰主語承接授爵，未核底本影像。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji093-001","person_id":"cbr-p005151","surfaces":["成","橫陽君成","韓王成"],"scope":"same_chapter","chapter_ids":["c-shiji-093-hanlu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-093-hanlu:p001","quote":"韓王信者，故韓襄王孽孫也，長八尺五寸。及項梁之立楚後懷王也，燕、齊、趙、魏皆已前王，唯韓無有後，故立韓諸公子橫陽君成為韓王，欲以撫定韓故地。項梁敗死定陶，成奔懷王。沛公引兵擊陽城，使張良以韓司徒降下韓故地，得信，以為韓將，將其兵從沛公入武關。"},{"paragraph_id":"c-shiji-093-hanlu:p003","quote":"項籍之封諸王皆就國，韓王成以不從無功，不遣就國，更以為列侯。及聞漢遣韓信略韓地，乃令故項籍游吳時吳令鄭昌為韓王以距漢。漢二年，韓信略定韓十餘城。漢王至河南，韓信急擊韓王昌陽城。昌降，漢王乃立韓信為韓王，常將韓兵從。三年，漢王出滎陽，韓王信、周苛等守滎陽。及楚敗滎陽，信降楚，已而得亡，復歸漢，漢復立以為韓王，竟從擊破項籍，天下定。五年春，遂與剖符為韓王，王潁川。"}],"rationale":"按韓王信開篇姓名及局部王序兵事承接；成昌與信分人，不按同名合併淮陰侯韓信。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-093-hanlu:p001","text":"韓王信者，故韓襄王孽孫也，長八尺五寸。及項梁之立楚後懷王也，燕、齊、趙、魏皆已前王，唯韓無有後，故立韓諸公子橫陽君成為韓王，欲以撫定韓故地。項梁敗死定陶，成奔懷王。沛公引兵擊陽城，使張良以韓司徒降下韓故地，得信，以為韓將，將其兵從沛公入武關。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-093-hanlu:m001-0000","start":0,"end":3,"surface":"韓王信","kind":"person","person_id":"cbr-p005152","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m001-0006","start":6,"end":9,"surface":"韓襄王","kind":"person","person_id":"cbr-p005153","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m001-0020","start":20,"end":22,"surface":"項梁","kind":"person","person_id":"cbr-p005155","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m001-0026","start":26,"end":28,"surface":"懷王","kind":"person","person_id":"cbr-p005156","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m001-0054","start":54,"end":58,"surface":"橫陽君成","kind":"person","person_id":"cbr-p005151","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m001-0070","start":70,"end":72,"surface":"項梁","kind":"person","person_id":"cbr-p005155","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m001-0077","start":77,"end":78,"surface":"成","kind":"person","person_id":"cbr-p005151","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m001-0079","start":79,"end":81,"surface":"懷王","kind":"person","person_id":"cbr-p005156","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m001-0082","start":82,"end":84,"surface":"沛公","kind":"person","person_id":"cbr-p005157","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m001-0091","start":91,"end":93,"surface":"張良","kind":"person","person_id":"cbr-p005158","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m001-0104","start":104,"end":105,"surface":"信","kind":"person","person_id":"cbr-p005152","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m001-0115","start":115,"end":117,"surface":"沛公","kind":"person","person_id":"cbr-p005157","status":"contextual_provisional"}],"chapter_id":"c-shiji-093-hanlu","book_id":"b-shiji-093","work_id":"w-shiji","source_id":"s-shiji-093-hanlu"},{"id":"c-shiji-093-hanlu:p003","text":"項籍之封諸王皆就國，韓王成以不從無功，不遣就國，更以為列侯。及聞漢遣韓信略韓地，乃令故項籍游吳時吳令鄭昌為韓王以距漢。漢二年，韓信略定韓十餘城。漢王至河南，韓信急擊韓王昌陽城。昌降，漢王乃立韓信為韓王，常將韓兵從。三年，漢王出滎陽，韓王信、周苛等守滎陽。及楚敗滎陽，信降楚，已而得亡，復歸漢，漢復立以為韓王，竟從擊破項籍，天下定。五年春，遂與剖符為韓王，王潁川。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-093-hanlu:m003-0000","start":0,"end":2,"surface":"項籍","kind":"person","person_id":"cbr-p005159","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m003-0010","start":10,"end":13,"surface":"韓王成","kind":"person","person_id":"cbr-p005151","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m003-0034","start":34,"end":36,"surface":"韓信","kind":"person","person_id":"cbr-p005152","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m003-0043","start":43,"end":45,"surface":"項籍","kind":"person","person_id":"cbr-p005159","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m003-0050","start":50,"end":52,"surface":"鄭昌","kind":"person","person_id":"cbr-p005154","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m003-0063","start":63,"end":65,"surface":"韓信","kind":"person","person_id":"cbr-p005152","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m003-0072","start":72,"end":74,"surface":"漢王","kind":"person","person_id":"cbr-p005157","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m003-0078","start":78,"end":80,"surface":"韓信","kind":"person","person_id":"cbr-p005152","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m003-0082","start":82,"end":85,"surface":"韓王昌","kind":"person","person_id":"cbr-p005154","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m003-0088","start":88,"end":89,"surface":"昌","kind":"person","person_id":"cbr-p005154","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m003-0091","start":91,"end":93,"surface":"漢王","kind":"person","person_id":"cbr-p005157","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m003-0095","start":95,"end":97,"surface":"韓信","kind":"person","person_id":"cbr-p005152","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m003-0110","start":110,"end":112,"surface":"漢王","kind":"person","