mily_paths":[],"mentions":[{"start":14,"end":17,"surface":"元景隆","id":"c-nanshi-022-wanggui:p004:m0014","person_id":"nro_d6b_5ie","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作景隆。","paragraph_id":"c-nanshi-022-wanggui:p004","chapter_id":"c-nanshi-022-wanggui"}],"relations":[],"title_holdings":[{"id":"th-nanshi022-wanggui-72-10","person_id":"nro_d6b_5ie","title":"廣州刺史","kind":"office","mode":"attestation","attestations":[{"id":"th-nanshi022-wanggui-72-10:a","paragraph_id":"c-nanshi-022-wanggui:p004","start":10,"end":14,"surface":"廣州刺史","person_mention_id":"c-nanshi-022-wanggui:p004:m0014","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-022","chapter_id":"c-nanshi-022-wanggui","source_id":"s-nanshi-022-wanggui-ws1477957","paragraph_id":"c-nanshi-022-wanggui:p004","quote":"六年，武帝於文德殿餞廣州刺史元景隆，詔群臣賦詩，同用五十韻。規援筆立奏，其文又美，武帝嘉焉，即日授侍中。後為晉安王長史。王立為太子，仍為散騎常侍、太子中庶子，侍東宮。太子賜以所服貂蟬，並降令書，悅是舉也。尋為吳郡太守，主書芮珍宗家在吳，前守宰皆傾意附之。至是珍宗假還，規遇之甚薄，珍宗還都，密奏規不理郡事。俄徵為左戶尚書。郡境千餘人詣闕請留，表三奏不許。求于郡樹碑，許之。","person_mention_id":"c-nanshi-022-wanggui:p004:m0014"}],"status":"source_attested","interpretation_note":"本句所載官名，任期無確切年月。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanshi-022-wanggui:p004","text":"六年，武帝於文德殿餞廣州刺史元景隆，詔群臣賦詩，同用五十韻。規援筆立奏，其文又美，武帝嘉焉，即日授侍中。後為晉安王長史。王立為太子，仍為散騎常侍、太子中庶子，侍東宮。太子賜以所服貂蟬，並降令書，悅是舉也。尋為吳郡太守，主書芮珍宗家在吳，前守宰皆傾意附之。至是珍宗假還，規遇之甚薄，珍宗還都，密奏規不理郡事。俄徵為左戶尚書。郡境千餘人詣闕請留，表三奏不許。求于郡樹碑，許之。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"start":14,"end":17,"surface":"元景隆","id":"c-nanshi-022-wanggui:p004:m0014","person_id":"nro_d6b_