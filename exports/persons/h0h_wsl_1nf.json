ji116-020","attestation_id":"th-shiji116-020:a005","person_id":"h0h_wsl_1nf","date_role":"title_attestation","title":"滇王","usage":"narrative"}],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji116-dian-later-king","person_id":"h0h_wsl_1nf","surfaces":["嘗羌","滇王"],"scope":"same_chapter","chapter_ids":["c-shiji-116-xinanyi"],"status":"contextual_provisional","confidence_level":"moderate","identification_basis":{"kind":"narrative_continuity","explicit_name_in_target_passage":false,"possible_unrecorded_succession":true,"source_named_person_mention_ids":["c-shiji-116-xinanyi:m005-0145"],"target_mention_ids":["c-shiji-116-xinanyi:m009-0016","c-shiji-116-xinanyi:m009-0021","c-shiji-116-xinanyi:m009-0089","c-shiji-116-xinanyi:m009-0100","c-shiji-116-xinanyi:m009-0127"],"excluded_mention_ids":["c-shiji-116-xinanyi:m011-0041"],"witness_independence":"not_assumed"},"evidence":[{"paragraph_id":"c-shiji-116-xinanyi:p005","quote":"及元狩元年，博望侯張騫使大夏來，言居大夏時見蜀布、邛竹、杖，使問所從來，曰「從東南身毒國，可數千里，得蜀賈人市」。或聞邛西可二千里有身毒國。騫因盛言大夏在漢西南，慕中國，患匈奴隔其道，誠通蜀，身毒國道便近，有利無害。於是天子乃令王然于、柏始昌、呂越人等，使閒出西夷西，指求身毒國。至滇，滇王嘗羌乃留，為求道西十餘輩。歲餘，皆閉昆明，莫能通身毒國。","mention_ids":["c-shiji-116-xinanyi:m005-0145"]},{"paragraph_id":"c-shiji-116-xinanyi:p006","quote":"滇王與漢使者言曰：「漢孰與我大？」及夜郎侯亦然。以道不通故，各自以為一州主，不知漢廣大。使者還，因盛言滇大國，足事親附。天子注意焉。","mention_ids":["c-shiji-116-xinanyi:m006-0000"]},{"paragraph_id":"c-shiji-116-xinanyi:p009","quote":"上使王然于以越破及誅南夷兵威風喻滇王入朝。滇王者，其眾數萬人，其旁東北有勞寖、靡莫，皆同姓相扶，未肯聽。勞寖、靡莫數侵犯使者吏卒。元封二年，天子發巴蜀兵擊滅勞寖、靡莫，以兵臨滇。滇王始首善，以故弗誅。滇王離難西南夷，舉國降，請置吏入朝。於是以為益州郡，賜滇王王印，復長其民。","mention_ids":["c-shiji-116-xinanyi:m009-0016","c-shiji-116-xinanyi:m009-0021","c-shiji-116-xinanyi:m009-0089","c-shiji-116-xinanyi:m009-0100","c-shiji-116-xinanyi:m009-0127"]}],"references":[{"title":"《漢書》卷95·顏師古釋始首善","url":"https://github.com/kanripo/KR2a0007/blob/683113d4baf6febecaf2ccb7913df87c4d68d454/KR2a0007_095.txt#L95","quote":"莫以兵臨滇滇王始首善以故弗誅(師古曰言初始/以來常有善意)滇¶","scope":"ancient_commentary_narrative_context","image_verified":false}],"rationale":"前文嘗羌留王然于等使者、助求身毒道，後文仍由王然于風喻滇廷，並回稱滇王始首善；顏師古釋為初始以來常有善意，與前述待使脈絡相接。按本篇敘事連續性暫接同一人，不據共用王號自動合併。原段未重出姓名，不能排除未記載的更替，故信心中等；篇末楚苗裔尚有滇王是王統概括，保持未定。平行傳承不當獨立史事票數，也不推生卒、即位或世系。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-116-xinanyi:p005","text":"及元狩元年，博望侯張騫使大夏來，言居大夏時見蜀布、邛竹、杖，使問所從來，曰「從東南身毒國，可數千里，得蜀賈人市」。或聞邛西可二千里有身毒國。騫因盛言大夏在漢西南，慕中國，患匈奴隔其道，誠通蜀，身毒國道便近，有利無害。於是天子乃令王然于、柏始昌、呂越人等，使閒出西夷西，指求身毒國。至滇，滇王嘗羌乃留，為求道西十餘輩。歲餘，皆閉昆明，莫能通身毒國。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-116-xinanyi:m005-0009","start":9,"end":11,"surface":"張騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m005-0070","start":70,"end":71,"surface":"騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m005-0110","start":110,"end":112,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m005-0114","start":114,"end":117,"surface":"王然于","kind":"person","person_id":"hpw_2ip_uqk","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m005-0118","start":118,"end":121,"surface":"柏始昌","kind":"person","person_id":"11q_2yl_qzt","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m005-0122","start":122,"end":125,"surface":"呂越人","kind":"person","person_id":"miw_t0v_k64","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m005-0145","start":145,"end":147,"surface":"嘗羌","kind":"person","person_id":"h0h_wsl_1nf","status":"contextual_provisional"}],"chapter_id":"c-shiji-116-xinanyi","book_id":"b-shiji-116","work_id":"w-shiji","source_id":"s-shiji116-xinanyi"},{"id":"c-shiji-116-xinanyi:p006","text":"滇王與漢使者言曰：「漢孰與我大？」及夜郎侯亦然。以道不通故，各自以為一州主，不知漢廣大。使者還，因盛言滇大國，足事親附。天子注意焉。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-116-xinany