{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000906","identity_policy":"contextual_provisional","person_ids":["cbr-p000906"],"persons":[{"id":"cbr-p000906","label":"張相如","status":"active","historicity":"historical_tradition","aliases":[{"surface":"張相如","mention_ids":["c-shiji-010-wendi:m027-0124"]}],"evidence":[{"mention_id":"c-shiji-010-wendi:m027-0124","chapter_id":"c-shiji-010-wendi","paragraph_id":"c-shiji-010-wendi:p027","quote":"張相如"}]}],"mentions":[{"id":"c-shiji-010-wendi:m027-0124","start":124,"end":127,"surface":"張相如","kind":"person","person_id":"cbr-p000906","status":"contextual_provisional","paragraph_id":"c-shiji-010-wendi:p027","chapter_id":"c-shiji-010-wendi"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-010-wendi:p027","text":"十四年冬，匈奴謀入邊為寇，攻朝那塞，殺北地都尉卬。上乃遣三將軍軍隴西、北地、上郡，中尉周舍為衛將軍，郎中令張武為車騎將軍，軍渭北，車千乘，騎卒十萬。帝親自勞軍，勒兵申教令，賜軍吏卒。帝欲自將擊匈奴，群臣諫，皆不聽。皇太后固要帝，帝乃止。於是以東陽侯張相如為大將軍，成侯赤為內史，欒布為將軍，擊匈奴。匈奴遁走。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-010-wendi:m027-0019","start":19,"end":24,"surface":"北地都尉卬","kind":"person","person_id":"cbr-p000904","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m027-0025","start":25,"end":26,"surface":"上","kind":"person","person_id":"cbr-p000806","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m027-0043","start":43,"end":45,"surface":"周舍","kind":"person","person_id":"cbr-p000905","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m027-0053","start":53,"end":55,"surface":"張武","kind":"person","person_id":"cbr-p000880","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m027-0074","start":74,"end":75,"surface":"帝","kind":"person","person_id":"cbr-p000806","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m027-0091","start":91,"end":92,"surface":"