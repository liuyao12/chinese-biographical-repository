,"end":272,"surface":"韓信","kind":"person","person_id":"lp3_npi_io0","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m009-0274","start":274,"end":276,"surface":"龍且","kind":"person","person_id":"y6z_6wd_ezf","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m009-0279","start":279,"end":281,"surface":"曹參","kind":"person","person_id":"349_zmu_2u4","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m009-0285","start":285,"end":287,"surface":"田既","kind":"person","person_id":"o4h_qq4_taj","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m009-0292","start":292,"end":294,"surface":"灌嬰","kind":"person","person_id":"1wk_2dd_421","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m009-0298","start":298,"end":300,"surface":"田吸","kind":"person","person_id":"kfh_9sk_v4e","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m009-0304","start":304,"end":306,"surface":"韓信","kind":"person","person_id":"lp3_npi_io0","status":"contextual_provisional"}],"chapter_id":"c-shiji-094-tiandan","book_id":"b-shiji-094","work_id":"w-shiji","source_id":"s-shiji-094-tiandan"},{"id":"c-shiji-094-tiandan:p010","text":"後歲餘，漢滅項籍，漢王立為皇帝，以彭越為梁王。田橫懼誅，而與其徒屬五百餘人入海，居島中。高帝聞之，以為田橫兄弟本定齊，齊人賢者多附焉，今在海中不收，後恐為亂，乃使使赦田橫罪而召之。田橫因謝曰：「臣亨陛下之使酈生，今聞其弟酈商為漢將而賢，臣恐懼，不敢奉詔，請為庶人，守海島中。」使還報，高皇帝乃詔衛尉酈商曰：「齊王田橫即至，人馬從者敢動搖者致族夷！」乃復使使持節具告以詔商狀，曰：「田橫來，大者王，小者乃侯耳；不來，且舉兵加誅焉。」田橫乃與其客二人乘傳詣雒陽。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-094-tiandan:m010-0006","start":6,"end":8,"surface":"項籍","kind":"person","person_id":"56x_3iq_m0y","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m010-0009","start":9,"end":11,"surface":"漢王","kind":"person","person_id":"m1e_wr1_vgx","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m010-0017","start":17,"end":19,"surface":"彭越","kind":"person","person_id":"27w_87k_66k","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m010-0023","start":23,"end":25,"