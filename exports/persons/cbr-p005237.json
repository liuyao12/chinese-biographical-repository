s-shiji-094-tiandan"},{"id":"c-shiji-094-tiandan:p014","text":"【索隱述贊】秦項之際，天下交兵。六國樹黨，自置豪英。田儋殞寇，立市相榮。楚封王假，齊破酈生。兄弟更王，海島傳聲。","annotation_status":"named_mentions_first_pass","text_layer":"witness_appended_suoyin_zan","mentions":[{"id":"c-shiji-094-tiandan:m014-0026","start":26,"end":28,"surface":"田儋","kind":"person","person_id":"j80_2bm_4af","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m014-0032","start":32,"end":33,"surface":"市","kind":"person","person_id":"j80_2bm_4af_A","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m014-0034","start":34,"end":35,"surface":"榮","kind":"person","person_id":"t9b_1eg_mqs","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m014-0043","start":43,"end":45,"surface":"酈生","kind":"person","person_id":"uj5_nzw_pnc","status":"contextual_provisional"}],"chapter_id":"c-shiji-094-tiandan","book_id":"b-shiji-094","work_id":"w-shiji","source_id":"s-shiji-094-tiandan"}],"sources":[{"chapter_id":"c-shiji-094-tiandan","work_id":"w-shiji","book_id":"b-shiji-094","source_id":"s-shiji-094-tiandan","source":{"title":"史記／卷094","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷094","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷094&oldid=2171897","revision_id":2171897,"accessed_on":"2026-10-09","extent":"13段傳世正文含太史公論，另附1段分層索隱述贊；排除導覽與空白。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{"龁":"齕"},"editorial_readings":[],"extraction_note":"只去外緣空白並明記龁轉齕；田間田閒、大田橫之客皆賢及博（陽）原字保留。","note":"全16個HTML區塊已讀；未核底本影像。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical"}}
