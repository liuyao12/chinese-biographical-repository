4537,4538,4539,4540,4541,4542,4543,4544,4545]},"chapter_id":"c-sanguozhi-051-fu","book_id":"b-sanguozhi-051","work_id":"w-sanguozhi","source_id":"s-sanguozhi-051-fu"},{"id":"c-sanguozhi-051-fu:line038-pei01-01","text":"《江表传》曰：策既平定江东，逐袁胤。袁术深怨策，乃阴遣间使赍印绶与丹杨宗帅陵阳祖郎等，使激动山越，大合众，图共攻策。策自率将士讨郎，生获之。策谓郎曰：“尔昔袭击孤，斫孤马鞍，今创军立事，除弃宿恨，惟取能用，与天下通耳。非但汝，汝莫恐怖。”郎叩头谢罪。即破械，赐衣服，署门下贼曹。及军还，郎与太史慈俱在前导军，人以为荣。","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-051-fu:line038-pei01-01:m0007","start":7,"end":8,"surface":"策","kind":"person","person_id":"e9c_070_567","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-fu:line038-pei01-01:m0015","start":15,"end":17,"surface":"袁胤","kind":"person","person_id":"1gw_2zv_6ot","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-fu:line038-pei01-01:m0018","start":18,"end":20,"surface":"袁术","kind":"person","person_id":"865_b69_cb0","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-fu:line038-pei01-01:m0022","start":22,"end":23,"surface":"策","kind":"person","person_id":"e9c_070_567","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-fu:line038-pei01-01:m0039","start":39,"end":41,"surface":"祖郎","kind":"person","person_id":"r9q_7ps_byt","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-fu:line038-pei01-01:m0056","start":56,"end":57,"surface":"策","kind":"person","person_id":"e9c_070_567","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-fu:line038-pei01-01:m0058","start":58,"end":59,"surface":"策","kind":"person","person_id":"e9c_070_567","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-fu:line038-pei01-01:m0064","start":64,"end":65,"surface":"郎","kind":"person","person_id":"r9q_7ps_byt","status":"contextual_provisional","interpretat