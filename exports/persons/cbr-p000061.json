r-p000061","status":"source_attested","evidence":[{"chapter_id":"c-shiji-002-xia","source_id":"s-shiji-002-xia","paragraph_id":"c-shiji-002-xia:p033","quote":"中康崩，子帝相立"}],"qualifiers":{"source_term":"子","historicity":"legendary_tradition"},"interpretation_note":"僅記來源明示的親屬關係，不把繼位推成父子。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-002-xia:p032","text":"太康崩，弟中康立，是爲帝中康。帝中康時，羲、和湎淫，廢時亂日。胤往征之，作胤征。","mentions":[{"id":"c-shiji-002-xia:m032-0000","start":0,"end":2,"surface":"太康","kind":"person","person_id":"cbr-p000060","status":"source_identified"},{"id":"c-shiji-002-xia:m032-0005","start":5,"end":7,"surface":"中康","kind":"person","person_id":"cbr-p000061","status":"source_identified"},{"id":"c-shiji-002-xia:m032-0011","start":11,"end":14,"surface":"帝中康","kind":"person","person_id":"cbr-p000061","status":"source_identified"},{"id":"c-shiji-002-xia:m032-0015","start":15,"end":18,"surface":"帝中康","kind":"person","person_id":"cbr-p000061","status":"source_identified"},{"id":"c-shiji-002-xia:m032-0020","start":20,"end":23,"surface":"羲、和","kind":"unresolved","person_id":null,"status":"unresolved","note":"中康時的職官／氏族稱謂，不依同字合併為堯時的羲仲、羲叔、和仲或和叔。"},{"id":"c-shiji-002-xia:m032-0031","start":31,"end":32,"surface":"胤","kind":"person","person_id":"cbr-p000062","status":"source_identified"}],"chapter_id":"c-shiji-002-xia","book_id":"b-shiji-002","work_id":"w-shiji","source_id":"s-shiji-002-xia"},{"id":"c-shiji-002-xia:p033","text":"中康崩，子帝相立。帝相崩，子帝少康立。帝少康崩，子帝予立。帝予崩，子帝槐立。帝槐崩，子帝芒立。帝芒崩，子帝泄立。帝泄崩，子帝不降立。帝不降崩，弟帝扃立。帝扃崩，子帝廑立。帝廑崩，立帝不降之子孔甲，是爲帝孔甲。帝孔甲立，好方鬼神，事淫亂。夏后氏德衰，諸侯畔之。天降龍二，有雌雄，孔甲不能食，未得豢龍氏。陶唐既衰，其后有劉累，學擾龍于豢龍氏，以事孔甲。孔甲賜之姓曰御龍氏，受豕韋之後。龍一雌死，以食夏后。夏后使求，懼而遷去。","mentions":[{"id":"c-shiji-002-xia:m033-0000","start":0,"end":2,"surface":"中康","kind":"person","person_id":"cbr-p000061","status":"source_identified"},{"id":"c-shiji-002-xia:m033-0005","start":5,"end":7,"surface":"帝相","kind":"p