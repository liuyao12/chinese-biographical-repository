{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003580","identity_policy":"contextual_provisional","person_ids":["cbr-p003580"],"persons":[{"id":"cbr-p003580","label":"韓長孺（梁孝王世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"韓長孺","mention_ids":["c-shiji-058-liang:m025-0246"]}],"evidence":[{"mention_id":"c-shiji-058-liang:m025-0246","chapter_id":"c-shiji-058-liang","paragraph_id":"c-shiji-058-liang:p025","quote":"韓長孺"}]}],"source_mention_summary":[{"source_id":"s-shiji-058-liang","work_id":"w-shiji","book_id":"b-shiji-058","chapter_id":"c-shiji-058-liang","mention_count":1,"mention_ids":["c-shiji-058-liang:m025-0246"],"paragraph_ids":["c-shiji-058-liang:p025"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-058-liang"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-058-liang:m025-0246","start":246,"end":249,"surface":"韓長孺","kind":"person","person_id":"cbr-p003580","status":"contextual_provisional","paragraph_id":"c-shiji-058-liang:p025","chapter_id":"c-shiji-058-liang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji058-041","person_id":"cbr-p003580","surfaces":["韓長孺"],"scope":"same_chapter","chapter_ids":["c-shiji-058-liang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-058-liang:p025","quote":"又諸侯王朝見天子，漢法凡當四見耳。始到，入小見；到正月朔旦，奉皮薦璧玉賀正月，法見；後三日，為王置酒，賜金錢財物；後二日，復入小見，辭去。凡留長安不過二十日。小見者，燕見於禁門內，飲於省中，非士人所得入也。今梁王西朝，因留，且半歲。入與人主同輦，出與同車。示風以大言而實不與，令出怨言，謀畔逆，乃隨而憂之，不亦遠乎！非大賢人，不知退讓。今漢之儀法，朝見賀正月者，常一王與四侯俱朝見，十餘歲一至。今梁王常比年入朝見，久留。鄙語曰「驕子不孝」，非惡言也。故諸侯王當為置良師傅，相忠言之士，如汲黯、韓長孺等，敢直言極諫，安得有患害！"}],"rationale":"按明示姓名、世系與局部王號暫接。梁武、勝、參、登、義、買、襄等不按同王號合併；梁王勝與羊勝分辨。李太后陳太后分存；主張、指控、泛稱與授職分辨，正文與附述各保留。官爵全史與跨篇身份仍待覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-058-liang:p025","text":"又諸侯王朝見天子，漢法凡當四見耳。始到，入小見；到正月朔旦，奉皮薦璧玉賀正月，法見；後三日，為王置酒，賜金錢財物；後二日，復入小見，辭去。凡留長安不過二十日。小見者，燕見於禁門內，飲於省中，非士人所得入也。今梁王西朝，因留，且半歲。入與人主同輦，出與同車。示風以大言而實不與，令出怨言，謀畔逆，乃隨而憂之，不亦遠乎！非大賢人，不知退讓。今漢之儀法，朝見賀正月者，常一王與四侯俱朝見，十餘歲一至。今梁王常比年入朝見，久留。鄙語曰「驕子不孝」，非惡言也。故諸侯王當為置良師傅，相忠言之士，如汲黯、韓長孺等，敢直言極諫，安得有患害！","annotation_status":"named_mentions_first_pass","text_layer":"witness_appended_chu_note","mentions":[{"id":"c-shiji-058-liang:m025-0001","start":1,"end":4,"surface":"諸侯王","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、所舉古事或未定指代；不補來源未見姓名、成員及關係。"},{"id":"c-shiji-058-liang:m025-0006","start":6,"end":8,"surface":"天子","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、所舉古事或未定指代；不補來源未見姓名、成員及關係。"},{"id":"c-shiji-058-liang:m025-0104","start":104,"end":106,"surface":"梁王","kind":"person","person_id":"cbr-p003540","status":"contextual_provisional"},{"id":"c-shiji-058-liang:m025-0118","start":118,"end":120,"surface":"人主","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、所舉古事或未定指代；不補來源未見姓名、成員及關係。"},{"id":"c-shiji-058-liang:m025-0185","start":185,"end":187,"surface":"四侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、所舉古事或未定指代；不補來源未見姓名、成員及關係。"},{"id":"c-shiji-058-liang:m025-0198","start":198,"end":200,"surface":"梁王","kind":"person","person_id":"cbr-p003540","status":"contextual_provisional"},{"id":"c-shiji-058-liang:m025-0226","start":226,"end":229,"surface":"諸侯王","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、所舉古事或未定指代；不補來源未見姓名、成員及關係。"},{"id":"c-shiji-058-liang:m025-0232","start":232,"end":235,"surface":"良師傅","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、所舉古事或未定指代；不補來源未見姓名、成員及關係。"},{"id":"c-shiji-058-liang:m025-0243","start":243,"end":245,"surface":"汲黯","kind":"person","person_id":"cbr-p003579","status":"contextual_provisional"},{"id":"c-shiji-058-liang:m025-0246","st