ds":["c-songshu-044-wyd1739-xiehui:p006:m0153"],"paragraph_ids":["c-songshu-044-wyd1739-xiehui:p006"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-songshu-044-wyd1739-xiehui:p006:m0153","mention_ids":["c-songshu-044-wyd1739-xiehui:p006:m0153"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-shiji-066-wu"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-066-wu:m021-0038","start":38,"end":40,"surface":"葉公","kind":"person","person_id":"8k1_7os_zkf","status":"contextual_provisional","paragraph_id":"c-shiji-066-wu:p021","chapter_id":"c-shiji-066-wu"},{"id":"c-shiji-066-wu:m023-0067","start":67,"end":69,"surface":"葉公","kind":"person","person_id":"8k1_7os_zkf","status":"contextual_provisional","paragraph_id":"c-shiji-066-wu:p023","chapter_id":"c-shiji-066-wu"},{"id":"c-songshu-044-wyd1739-xiehui:p006:m0153","start":153,"end":155,"surface":"諸梁","status":"contextual_provisional","interpretation_note":"原文明指單一人物，已登記為可查來源暫分個體；跨篇同指仍可覆核，本號不表示已證另人。","kind":"person","person_id":"8k1_7os_zkf","source_role_key":"zhuliang","paragraph_id":"c-songshu-044-wyd1739-xiehui:p006","chapter_id":"c-songshu-044-wyd1739-xiehui"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji066-045","person_id":"8k1_7os_zkf","scope":"same_chapter","chapter_ids":["c-shiji-066-wu"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["葉公"],"evidence":[{"paragraph_id":"c-shiji-066-wu:p021","quote":"伍子胥初所與俱亡故楚太子建之子勝者，在於吳。吳王夫差之時，楚惠王欲召勝歸楚。葉公諫曰：「勝好勇而陰求死士，殆有私乎！」惠王不聽。遂召勝，使居楚之邊邑鄢，號為白公。白公歸楚三年而吳誅子胥。"},{"paragraph_id":"c-shiji-066-wu:p023","quote":"其後四歲，白公勝與石乞襲殺楚令尹子西、司馬子綦於朝。石乞曰：「不殺王，不可。」乃劫（之）王如高府。石乞從者屈固負楚惠王亡走昭夫人之宮。葉公聞白公為亂，率其國人攻白公。白公之徒敗，亡走山中，自殺。而虜石乞，而問白公尸處，不言將亨。石乞曰：「事成為卿，不成而亨，固其職也。」終不肯告其尸處。遂亨石乞，而求惠王復立之。"}],"rationale":"依本篇明示姓名及局部敘事暫接異稱：公子光自立為闔廬、軫立為昭王、勝號白公；王稱隨敘事主體分段。王子綦佯充王不接昭王，與後文司馬子綦暫分候選但不斷言異人。悼公與陽生按本文分存，矛盾待版本覆核；鮑氏不強接鮑牧。未名父子只按本段明示保存，不補姓名。"},{"id":"d-song044-wyd-role-zhuliang","person_id":"8k1_7os_zkf","surfaces":["諸梁"],"scope":"cross_chapter","chapter_ids":["c-songshu-044-wyd1739-xiehui","c-shiji-066-wu"],"status":"contextual_provisional","confidence_level":"medium","identification_basis":{"kind":"source_context","target_mention_ids":["c-songshu-044-wyd1739-xiehui:p006:m0153"]},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-044","source_id":"s-songshu-044-wyd1739-xiehui","chapter_id":"c-songshu-044-wyd1739-xiehui","paragraph_id":"c-songshu-044-wyd1739-xiehui:p006","quote":"輕躁昧進王華猜忌忍害規弄威權先除執政以逞其欲天下之人知與不知孰不為之痛心憤怨者哉臣等見任先帝垂二十載小心謹愼無纖介之愆伏事甫爾而嬰若斯之罪若非先帝謬於知人則為陛下未察愚款臣去歲末使反得朝士及殿省諸將書並言嫌隙已成必有今日之事臣推誠仰期罔有二心不圖姦回潛遘理順難恃忠賢隕朝愚臣見襲到彥之蕭欣等在近路昔白公稱亂諸梁嬰胄惡人在朝趙鞅入伐臣義均休戚任居分陜豈可顛而不扶以負先帝遺旨輒率將士繕治舟甲須其自送投袂撲討若天祚大宋卜世靈長義師克振中流清蕩便當浮舟東下戮此三豎申理寃恥謝罪闕庭雖伏鑕赴鑊無恨於心伏願陛下遠尋永初託付之旨近存元嘉奉戴之誠則微臣丹款猶有可察臨表哽慨言不自盡太祖時已戒嚴諸軍相次進路尚書符荆州曰禍福無門逆順有數天道徴於影響人事鑒於前圖未有蹈義而福不延從惡而禍不至也故智計之士審敗以立功守正之臣臨難以全節徐羡之傅亮謝晦安忍鴆殺獲罪於天名教所極政刑所取已遠暴四海宣於聖詔羡之父子亮及晦息電斷之初並卽大憲復王室之讎攄義夫之憤國典澄明人神感"},{"work_id":"w-shiji","book_id":"b-shiji-066","source_id":"s-shiji-066-wu","chapter_id":"c-shiji-066-wu","paragraph_id":"c-shiji-066-wu:p021","quote":"伍子胥初所與俱亡故楚太子建之子勝者，在於吳。吳王夫差之時，楚惠王欲召勝歸楚。葉公諫曰：「勝好勇而陰求死士，殆有私乎！」惠王不聽。遂召勝，使居楚之邊邑鄢，號為白公。白公歸楚三年而吳誅子胥。"}],"rationale":"同事件＋明稱對讀支持首選。既有《史記》卷036及卷040另同事件來源身份，列競爭既有候選，不在本包全域合併；不新建第五個葉公。原諸梁不改為葉公。；WYD p006昔白公稱亂諸梁嬰胄，為同一楚白公亂引古；H066 p021–023完整白公勝/葉公攻亂並復惠王；外讀左傳正義60哀16完整白公亂單元145–153；杜注明葉公子高沈諸梁，傳後明沈諸梁兼二事","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-066-wu:p021","text":"伍子胥初所與俱亡故楚太子建之子勝者，在於吳。吳王夫差之時，楚惠王欲召勝歸楚。葉公諫曰：「勝好勇而陰求死士，殆有私乎！」惠王不聽。遂召勝，使居楚之邊邑鄢，號為白公。白公歸楚三年而吳誅子胥。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-066-wu:m021-0000","start":0,"end":3,"surface":"伍子胥","kind":"person","person_id":"g9h_5ih_ug1_A","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m021-0009","start":9,"end":13,"surface":"楚太子建","kind":"person","person_id":"q8m_d0c_kq3_AEB","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m021-0015","start":15,"end":16,"surface":"勝","kind":"person","person_id":"q8m_d0c_kq3_AEBA","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m021-0022","start":22,"end":26,"surface":"吳王夫差","kind":"person","person_id":"5dm_e40_rqh_AAAAAAAAAAAAAAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m021-0029","start":29,"end":32,"surface":"楚惠王","kind":"person","person_id":"ut1_rtj_ckz","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m021-0034","start":34,"end":35,"surface":"勝","kind":"person","person_id":"q8m_d0c_kq3_AEBA","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m021-0038","start":38,"end":40,"surface":"葉公","kind":"person","person_id":"8k1_7os_zkf","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m021-0044","start":44,"end":45,"surface":"勝","kind":"person","person_id":"q8m_d0c_kq3_AEBA","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m021-0050","start":50,"end":52,"surface":"死士","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代，未補姓名及成員；鮑氏不直接等同鮑牧。"},{"id":"c-shiji-066-wu:m02