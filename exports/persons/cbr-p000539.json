公","kind":"person","person_id":"na8_45f_m80","status":"contextual_provisional","paragraph_id":"c-shiji-006-shihuang:p003","chapter_id":"c-shiji-006-shihuang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-006-shihuang:p001","text":"秦始皇帝者，秦莊襄王子也。莊襄王為秦質子於趙，見呂不韋姬，悅而取之，生始皇。以秦昭王四十八年正月生於邯鄲。及生，名為政，姓趙氏。年十三歲，莊襄王死，政代立為秦王。當是之時，秦地已并巴、蜀、漢中，越宛有郢，置南郡矣；北收上郡以東，有河東、太原、上黨郡；東至滎陽，滅二周，置三川郡。呂不韋為相，封十萬戶，號曰文信侯。招致賓客游士，欲以并天下。李斯為舍人。蒙驁、王齮、麃公等為將軍。王年少，初即位，委國事大臣。晉陽反。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:m001-0000","start":0,"end":4,"surface":"秦始皇帝","kind":"person","person_id":"ao3_0fy_d45_AAA","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m001-0006","start":6,"end":10,"surface":"秦莊襄王","kind":"person","person_id":"ao3_0fy_d45_AA","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m001-0013","start":13,"end":16,"surface":"莊襄王","kind":"person","person_id":"ao3_0fy_d45_AA","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m001-0017","start":17,"end":20,"surface":"秦質子","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或王稱指代待核；不補造姓名與成員。"},{"id":"c-shiji-006-shihuang:m001-0024","start":24,"end":27,"surface":"呂不韋","kind":"person","person_id":"puu_6hs_m4f","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m001-0027","start":27,"end":28,"surface":"姬","kind":"person","person_id":"lap_qc0_yqm","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m001-0035","start":35,"end":37,"surface":"始皇","kind":"person","person_id":"ao3_0fy_d45_AAA","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m001-0039","start":39,"end":42,"surface":"秦昭王","kind":"person","person_id":"ao3_0fy_d45","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m001-0058","s