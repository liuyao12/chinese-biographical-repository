_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-059-yi:p004:m0066","start":110,"end":112,"surface":"王矩","kind":"person","person_id":"n67_6v0_xme","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。","paragraph_id":"c-jinshu-059-yi:p004","chapter_id":"c-jinshu-059-yi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-059-yi:p004","text":"顒本以乂弱冏強，冀乂為冏所擒，然後以乂為辭，宣告四方共討之，因廢帝立成都王，己為宰相，專制天下。即而乂殺冏，其計不果，乃潛使侍中馮蓀、河南尹李含、中書令卞粹等襲乂。乂並誅之。顒遂與穎同伐京都。穎遣刺客圖乂，時長沙國左常侍王矩侍直，見客色動，遂殺之。詔以乂為大都督以距顒。連戰自八月至十月，朝議以乂、穎兄弟，可以辭說而釋，乃使中書令王衍行太尉，光祿勳石陋行司徒，使說穎，令與乂分陝而居，穎不從。乂因致書於穎曰：","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-059-yi:p004:m0045","start":0,"end":1,"surface":"顒","kind":"person","person_id":"ed0_313_bea","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p004:m0046","start":3,"end":4,"surface":"乂","kind":"person","person_id":"4c6_984_9ed","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p004:m0047","start":5,"end":6,"surface":"冏","kind":"person","person_id":"ee0_b2a_68e","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p004:m0048","start":9,"end":10,"surface":"乂","kind":"person","person_id":"4c6_984_9ed","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p004:m0049","start":11,"end":12,"surface":"冏","kind":"person","person_id":"ee0_b2a_68e","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p004:m0050","start":18,"end":19,"surface":"乂","kind":"person","person_id":"4c6_984_9ed","status":"contextua