欲去者本不相禁因夜開城門達曉不閉衆咸憚服莫有去者雍州刺史魯宗之率衆數千自襄陽來赴或謂宗之未可測道規","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-songshu-051-wyd1739-zongshi:p024:m0001","start":1,"end":4,"surface":"王鎮之","kind":"person","person_id":"7r6_k52_qji_ABDACAA","status":"contextual_provisional"},{"id":"c-songshu-051-wyd1739-zongshi:p024:m0009","start":9,"end":12,"surface":"檀道濟","kind":"person","person_id":"w8z_nph_trk","status":"contextual_provisional"},{"id":"c-songshu-051-wyd1739-zongshi:p024:m0016","start":16,"end":19,"surface":"到彥之","kind":"person","person_id":"6bo_qfq_pl9","status":"contextual_provisional"},{"id":"c-songshu-051-wyd1739-zongshi:p024:m0030","start":30,"end":32,"surface":"荀林","kind":"person","person_id":"p3q_qvd_s2o","status":"contextual_provisional"},{"id":"c-songshu-051-wyd1739-zongshi:p024:m0034","start":34,"end":35,"surface":"循","kind":"person","person_id":"m8n_ntm_79h_ABBA**A","status":"contextual_provisional"},{"id":"c-songshu-051-wyd1739-zongshi:p024:m0037","start":37,"end":38,"surface":"林","kind":"person","person_id":"p3q_qvd_s2o","status":"contextual_provisional"},{"id":"c-songshu-051-wyd1739-zongshi:p024:m0056","start":56,"end":59,"surface":"徐道覆","kind":"person","person_id":"bt2_eqz_i4y","status":"contextual_provisional"},{"id":"c-songshu-051-wyd1739-zongshi:p024:m0064","start":64,"end":66,"surface":"桓謙","kind":"person","person_id":"u9s_w6j_8mc_AEB","status":"contextual_provisional"},{"id":"c-songshu-051-wyd1739-zongshi:p024:m0071","start":71,"end":73,"surface":"譙縱","kind":"person","person_id":"j5i_ahk_7yx","status":"contextual_provisional"},{"id":"c-songshu-051-wyd1739-zongshi:p024:m0074","start":74,"end":75,"surface":"謙","kind":"person","person_id":"u9s_w6j_8mc_AEB","status":"contextual_provisional"},{"id":"c-songshu-051-wyd1739-zongshi:p024:m0088","start":88,"end":91,"surface":"譙道福","kind":"person","person_id":"o3z_vpz_572","status":"contextual_provisional"},{"id":"c-songshu-051-wyd1739-zongshi:p024:m0097","start":97,"end":98,"surface