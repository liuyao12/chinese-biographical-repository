{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000870","identity_policy":"contextual_provisional","person_ids":["cbr-p000870"],"persons":[{"id":"cbr-p000870","label":"召平（齊相候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"召平","mention_ids":["c-shiji-009-lvhou:m022-0135"]}],"evidence":[{"mention_id":"c-shiji-009-lvhou:m022-0135","chapter_id":"c-shiji-009-lvhou","paragraph_id":"c-shiji-009-lvhou:p022","quote":"召平"}]}],"mentions":[{"id":"c-shiji-009-lvhou:m022-0135","start":135,"end":137,"surface":"召平","kind":"person","person_id":"cbr-p000870","status":"contextual_provisional","paragraph_id":"c-shiji-009-lvhou:p022","chapter_id":"c-shiji-009-lvhou"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-009-lvhou:p022","text":"朱虛侯劉章有氣力，東牟侯興居其弟也。皆齊哀王弟，居長安。當是時，諸呂用事擅權，欲為亂，畏高帝故大臣絳、灌等，未敢發。朱虛侯婦，呂祿女，陰知其謀。恐見誅，乃陰令人告其兄齊王，欲令發兵西，誅諸呂而立。朱虛侯欲從中與大臣為應。齊王欲發兵，其相弗聽。八月丙午，齊王欲使人誅相，相召平乃反，舉兵欲圍王，王因殺其相，遂發兵東，詐奪瑯邪王兵，并將之而西。語在齊王語中。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-009-lvhou:m022-0000","start":0,"end":3,"surface":"朱虛侯","kind":"person","person_id":"cbr-p000832","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m022-0003","start":3,"end":5,"surface":"劉章","kind":"person","person_id":"cbr-p000832","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m022-0012","start":12,"end":14,"surface":"興居","kind":"person","person_id":"cbr-p000851","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m022-0019","start":19,"end":22,"surface":"齊哀王","kind":"person","person_id":"cbr-p000868","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m022-0044","start":44,"end":46,"surface":"高帝","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m022-0049","start":4