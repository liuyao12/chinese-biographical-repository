重退保譙城，器械軍儲皆為襄所掠，士卒多亡叛。浩遣劉啟、王彬之擊襄于山桑，並為襄所殺。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-jinshu-077-yinhao:p006:m0001","start":1,"end":4,"surface":"石季龍","kind":"person","person_id":"u61_ylg_6av","status":"contextual_provisional","interpretation_note":"依完整敘事／引語主語逐段辨識；原字不校改。"},{"id":"c-jinshu-077-yinhao:p006:m0023","start":23,"end":24,"surface":"浩","kind":"person","person_id":"djo_u3b_i9w_A","status":"contextual_provisional","interpretation_note":"依完整敘事／引語主語逐段辨識；原字不校改。"},{"id":"c-jinshu-077-yinhao:p006:m0045","start":45,"end":46,"surface":"浩","kind":"person","person_id":"djo_u3b_i9w_A","status":"contextual_provisional","interpretation_note":"依完整敘事／引語主語逐段辨識；原字不校改。"},{"id":"c-jinshu-077-yinhao:p006:m0082","start":82,"end":84,"surface":"陳逵","kind":"person","person_id":"9w8_tqh_ysn_B*AA*A","status":"contextual_provisional","interpretation_note":"依完整敘事／引語主語逐段辨識；原字不校改。"},{"id":"c-jinshu-077-yinhao:p006:m0089","start":89,"end":91,"surface":"蔡裔","kind":"person","person_id":"aza_fiu_zkm","status":"contextual_provisional","interpretation_note":"依完整敘事／引語主語逐段辨識；原字不校改。"},{"id":"c-jinshu-077-yinhao:p006:m0099","start":99,"end":101,"surface":"謝尚","kind":"person","person_id":"4ij_7ik_fgy_A","status":"contextual_provisional","interpretation_note":"依完整敘事／引語主語逐段辨識；原字不校改。"},{"id":"c-jinshu-077-yinhao:p006:m0106","start":106,"end":108,"surface":"荀羨","kind":"person","person_id":"yoo_ox0_545_BABAAAB","status":"contextual_provisional","interpretation_note":"依完整敘事／引語主語逐段辨識；原字不校改。"},{"id":"c-jinshu-077-yinhao:p006:m0132","start":132,"end":134,"surface":"苻健","kind":"person","person_id":"2id_twi_nzj","status":"contextual_provisional","interpretation_note":"依完整敘事／引語主語逐段辨識；原字不校改。"},{"id":"c-jinshu-077-yinhao:p006:m0136","start":136,"end":138,"surface":"梁安","kind":"person","person_id":"fu6_439_mua","status":"contextual_provisional","interpretation_note":"依完整敘事／引語主語逐段辨識；原字不校改。"},{"id":"c-jinshu-077-yinhao:p006:m0139","start":139,"end":142,"surface":"雷弱兒","ki