eviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"le-nan012-shenmiaorong-m-liushizhi","person_id":"tpj_u6z_dq1_A","event_type":"death","source_term":"賜死","source_anchor":{"paragraph_id":"c-nanshi-012-shenmiaorong:p002","surface":"賜死","start":232,"end":234},"date_expression":null,"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-012","source_id":"s-nanshi-012-shenmiaorong-ws2060595","chapter_id":"c-nanshi-012-shenmiaorong","paragraph_id":"c-nanshi-012-shenmiaorong:p002","quote":"時宣帝與僕射到仲舉、舍人劉師知等，並受遺輔政。師知與仲舉恒居禁中，參決眾事，而宣帝為揚州刺史，與左右三百人，入居尚書省。師知忌宣帝權重，矯敕令還東府理州務。宣帝將出，毛喜止帝曰：「今若出外，便受制於人，如曹爽願作富家公不可得也。」宣帝乃稱疾，召師知留與語，使毛喜先入，言之於后。后曰：「今伯宗年幼，政事並委二郎，此非我意。」喜又言於廢帝，廢帝曰：「此自師知等所為，非朕意也。」喜出報宣帝，帝因囚師知。自入見后及帝，極陳師知之短。仍自草敕請畫，以師知付廷尉，其夜於獄賜死。自是政歸宣帝。后憂悶，計無所出，乃密賂宦者蔣裕，令誘建安人張安國使據郡反，冀因此圖帝。安國事發被誅，時后左右近侍頗知其事，后恐連逮黨與，並殺之。","person_mention_id":"c-nanshi-012-shenmiaorong:p002:m0012"}],"status":"source_attested","interpretation_note":"其夜獄中賜死。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-chenshu-007-shenmiaorong:p002:m0012","surface":"劉師知","start":12,"end":15,"person_id":"tpj_u6z_dq1_A","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-chenshu-007-shenmiaorong:p002","chapter_id":"c-chenshu-007-shenmiaorong"},{"id":"c-chenshu-016-shenmiaorong-liushizhi:p001:m0000","surface":"劉師知","start":0,"end":3,"person_id":"tpj_u6z_dq1_A","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-chenshu-016-shenmiaorong-liushizhi:p001","chapter_id":"c-chenshu-016-shenmiaorong-liushizhi"},{"id":"c-nanshi-012-shenmiaorong:p002:m0012","surface":"劉師知","start":12,"end":15,"person_id":"tpj_u6z_dq1_A","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-nanshi-012-shenmiaorong:p002","chapter_id":"c-nanshi-012-shenmiaorong"}],"relations":[{"id":"a-nan012-shenmiaorong-l-grandfather","subject_person_id":"tpj_u6z_dq1_A","object_perso