{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"zhe_4al_044","canonical_person_id":"zhe_4al_044","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["zhe_4al_044"],"persons":[{"id":"zhe_4al_044","label":"何遵〔大鴻臚〕","status":"active","historicity":"historical_tradition","aliases":[{"surface":"何遵","mention_ids":["c-jinshu-044-huayi:line082:m0142"]}],"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-044","chapter_id":"c-jinshu-044-huayi","source_id":"s-jinshu-044-huayi","paragraph_id":"c-jinshu-044-huayi:line082","mention_id":"c-jinshu-044-huayi:line082:m0142","quote":"何遵"}],"identity_note":"奏以華表世孫華混嗣表。","review":"ai_provisional"}],"source_mention_summary":[{"source_id":"s-jinshu-044-huayi","work_id":"w-jinshu","book_id":"b-jinshu-044","chapter_id":"c-jinshu-044-huayi","raw_mention_count":1,"mention_ids":["c-jinshu-044-huayi:line082:m0142"],"paragraph_ids":["c-jinshu-044-huayi:line082"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-044-huayi:line082:m0142","mention_ids":["c-jinshu-044-huayi:line082:m0142"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-044-huayi"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-044-huayi:line082:m0142","start":142,"end":144,"surface":"何遵","kind":"person","person_id":"zhe_4al_044","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-044-huayi:line082","chapter_id":"c-jinshu-044-huayi"}],"relations":[],"title_holdings":[{"id":"th-w044-huayi-8","person_id":"zhe_4al_044","title":"大鴻臚","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-044","chapter_id":"c-jinshu-044-huayi","source_id":"s-jinshu-044-huayi","paragraph_id":"c-jinshu-044-huayi:line082","quote":"初，表有賜客在鬲，使廙因縣令袁毅錄名，三客各代以奴。及毅以貨賕致罪，獄辭迷謬，不復顯以奴代客，直言送三奴與暠，而毅亦盧氏婿也。又中書監荀勖先為中子求廙女，廙不許，為恨，因密啟帝，以袁毅貨賕者多，不可盡罪，宜責最所親者一人，因指廙當之。又綠廙有違忤之咎，遂於喪服中免暠官，削爵土。大鴻臚何遵奏廙免為庶人，不應襲封，請以表世孫混嗣表。有司奏曰：「廙所坐除名削爵，一時之制。廙為世子，著在名簿，不聽襲嗣，此為刑罰再加。諸侯犯法，八議平處者，褒功重爵也。嫡統非犯終身棄罪，廢之為重，依律應聽襲封。」詔曰：「諸侯薨，子逾年即位，此古制也。應即位而廢之，爵命皆去矣，何為罪罰再加？且吾之責廙，以肅貪穢，本不論常法也。諸賢不能將明此意，乃更詭易禮律，不顧憲度，君命廢之，而群下復之，此為上下正相反也。」於是有司奏免議者官，詔皆以贖論。混以世孫當受封，逃避，斷髮陽狂，病喑不能語，故得不拜，世咸稱之。","person_mention_id":"c-jinshu-044-huayi:line082:m0142"}],"attestations":[{"id":"th-w043-huayi-8:a","paragraph_id":"c-jinshu-044-huayi:line082","start":139,"end":142,"surface":"大鴻臚","person_mention_id":"c-jinshu-044-huayi:line082:m0142","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-044-huayi:line082","text":"初，表有賜客在鬲，使廙因縣令袁毅錄名，三客各代以奴。及毅以貨賕致罪，獄辭迷謬，不復顯以奴代客，直言送三奴與暠，而毅亦盧氏婿也。又中書監荀勖先為中子求廙女，廙不許，為恨，因密啟帝，以袁毅貨賕者多，不可盡罪，宜責最所親者一人，因指廙當之。又綠廙有違忤之咎，遂於喪服中免暠官，削爵土。大鴻臚何遵奏廙免為庶人，不應襲封，請以表世孫混嗣表。有司奏曰：「廙所坐除名削爵，一時之制。廙為世子，著在名簿，不聽襲嗣，此為刑罰再加。諸侯犯法，八議平處者，褒功重爵也。嫡統非犯終身棄罪，廢之為重，依律應聽襲封。」詔曰：「諸侯薨，子逾年即位，此古制也。應即位而廢之，爵命皆去矣，何為罪罰再加？且吾之責廙，以肅貪穢，本不論常法也。諸賢不能將明此意，乃更詭易禮律，不顧憲度，君命廢之，而群下復之，此為上下正相反也。」於是有司奏免議者官，詔皆以贖論。混以世孫當受封，逃避，斷髮陽狂，病喑不能語，故得不拜，世咸稱之。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-044-huayi:line082:m0002","start":2,"end":3,"surface":"表","kind":"person","person_id":"7zi_5gs_mq2_A","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-huayi:line082:m0010","start":10,"end":11,"surface":"廙","kind":"person","person_id":"418_c91_b6b","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-huayi:line082:m0014","start":14,"end":16,"surface":"袁毅","kind":"person","person_id":"9zt_gf8_q29","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-huayi:line082:m0027","start":27,"end":28,"surface":"毅","kind":"person","person_id":"9zt_gf8_q29","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-huayi:line082:m0053","start":53,"end":54,"surface":"暠","kind":"person","person_id":"418_c91_b6b","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-huayi:line082:m0056","start":56,"end":57,"surface":"毅","kind":"person","person_id":"9zt_gf8_q29","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-huayi:line082:m0067","start":67,"end":69,"surface":"荀勖","kind":"person","person_id":"yoo_ox0_545_FAAA","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-huayi:line082:m0074","start":74,"end":75,"surface":"廙","kind":"person","person_id":"418_c91_b6b","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-huayi:line082:m0077","start":77,"end":78,"surface":"廙","kind":"person","person_id":"418_c91_b6b","status":"contextual_provisional","interpretation_note":"以來源原字標記。