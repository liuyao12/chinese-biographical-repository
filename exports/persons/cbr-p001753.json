textual_provisional"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"},{"id":"c-shiji-039-jin:p142","text":"太史公曰：晉文公，古所謂明君也，亡居外十九年，至困約，及卽位而行賞，尚忘介子推，況驕主乎？靈公旣弒，其後成、景致嚴，至厲大刻，大夫懼誅，禍作。悼公以後日衰，六卿專權。故君道之御其臣下。固不易哉！","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m142-0000","start":0,"end":3,"surface":"太史公","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m142-0005","start":5,"end":8,"surface":"晉文公","kind":"person","person_id":"cbr-p000252","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m142-0036","start":36,"end":39,"surface":"介子推","kind":"person","person_id":"cbr-p001753","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m142-0052","start":52,"end":55,"surface":"成、景","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m142-0071","start":71,"end":73,"surface":"悼公","kind":"person","person_id":"cbr-p000261","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m142-0078","start":78,"end":80,"surface":"六卿","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"}],"sources":[{"chapter_id":"c-shiji-039-jin","work_id":"w-shiji","book_id":"b-shiji-039","source_id":"s-shiji-039-jin","source":{"title":"史記／卷039","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷039","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷039&oldid=2588534","revision_id":2588534,"accessed_on":"2026-10-09","extent":"142段正文，自晉唐叔虞至太史公論贊，另保留1段索隱述贊並分層；排除2個dd導覽及段首尾版面換行。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{"