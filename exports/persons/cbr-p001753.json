39-jin"},{"id":"c-shiji-039-jin:m062-0072","start":72,"end":75,"surface":"介子推","kind":"person","person_id":"cbr-p001753","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p062","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m062-0076","start":76,"end":77,"surface":"推","kind":"person","person_id":"cbr-p001753","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p062","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m062-0087","start":87,"end":88,"surface":"推","kind":"person","person_id":"cbr-p001753","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p062","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m062-0209","start":209,"end":210,"surface":"推","kind":"person","person_id":"cbr-p001753","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p062","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m063-0000","start":0,"end":3,"surface":"介子推","kind":"person","person_id":"cbr-p001753","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p063","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m063-0062","start":62,"end":65,"surface":"介子推","kind":"person","person_id":"cbr-p001753","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p063","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m063-0115","start":115,"end":117,"surface":"介推","kind":"person","person_id":"cbr-p001753","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p063","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m142-0036","start":36,"end":39,"surface":"介子推","kind":"person","person_id":"cbr-p001753","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p142","chapter_id":"c-shiji-039-jin"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji039-191","person_id":"cbr-p001753","surfaces":["介子推","介推","推"],"scope":"same_chapter","chapter_ids":["c-shiji-039-jin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-039-jin:p060","quote":"文公元年春，秦送重耳至河。咎犯曰：「臣從君周旋天下，過亦多矣。臣猶知之，況於君乎？請從此去矣。」重耳曰：「若反國，所不與子犯共者，河伯視之！」乃投璧河中，以與子犯盟。是時介子推從，在船中，乃笑曰：「天實開公子，而子犯以爲己功而要市於君，固足羞也。吾不忍與同位。」乃自隱渡河。秦兵圍令狐，晉軍于廬柳。二月辛丑，咎犯與秦晉大夫盟于郇。壬寅，重耳入于晉師。丙午，入于曲沃。丁未，朝于武宮，卽位爲晉君，是爲文公。群臣皆往。懷公圉奔髙梁。戊申，使人殺懷公。"},{"paragraph_id":"c-shiji-039-jin:p062","quote":"文公修政，施惠百姓。賞從亡者及功臣，大者封邑，小者尊爵。未盡行賞，周襄王以弟帶難出居鄭地，來告急晉。晉初定，欲發兵，恐他亂起，是以賞從亡未至隱者介子推。推亦不言祿，祿亦不及。推曰：「獻公子九人，唯君在矣。惠、懷無親，外内棄之；天未絶晉，必將有主，主晉祀者，非君而誰？天實開之，二三子以爲己力，不亦誣乎？竊人之財，猶曰是盜，況貪天之功以爲己力乎？下冒其罪，上賞其姦，上下相蒙，難與處矣！」其母曰：「盍亦求之，以死誰懟？」推曰：「尤而效之，罪有甚焉。且出怨言，不食其祿。」母曰：「亦使知之，若何？」對曰：「言，身之文也；身欲隱，安用文之？文之，是求顯也。」其母曰：「能如此乎？與女偕隱。」至死不復見。"},{"paragraph_id":"c-shiji-039-jin:p063","quote":"介子推從者憐之，乃懸書宮門曰：「龍欲上天，五蛇爲輔。龍已升雲，四蛇各入其宇，一蛇獨怨，終不見處所。」文公出，見其書，曰：「此介子推也。吾方憂王室，未圖其功。」使人召之，則亡。遂求所在，聞其入綿上山中，於是文公環綿上山中而封之，以爲介推田，號曰介山，「以記吾過，且旌善人」。"},{"paragraph_id":"c-shiji-039-jin:p142","quote":"太史公曰：晉文公，古所謂明君也，亡居外十九年，至困約，及卽位而行賞，尚忘介子推，況驕主乎？靈公旣弒，其後成、景致嚴，至厲大刻，大夫懼誅，禍作。悼公以後日衰，六卿專權。故君道之御其臣下。固不易哉！"}],"rationale":"按本篇明示名與稱號、晉世系與具體事件暫定所列提及同指；附各段原文，未按同字短名全域合併；紀年與版本差異待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-039-jin:p060","text":"文公元年春，秦送重耳至河。咎犯曰：「臣從君周旋天下，過亦多矣。臣猶知之，況於君乎？請從此去矣。」重耳曰：「若反國，所不與子犯共者，河伯視之！」乃投璧河中，以與子犯盟。是時介子推從，在船中，乃笑曰：「天實開公子，而子犯以爲己功而要市於君，固足羞也。吾不忍與同位。」乃自隱渡河。秦兵圍令狐，晉軍于廬柳。二月辛丑，咎犯與秦晉大夫盟于郇。壬寅，重耳入于晉師。丙午，入于曲沃。丁未，朝于武宮，卽位爲晉君，是爲文公。群臣皆往。懷公圉奔髙梁。戊申，使人殺懷公。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m060-0000","start":0,"end":2,"surface":"文公","kind":"person","person_id":"cbr-p000252","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m060-0008","start":8,"end":10,"surface":"重耳","kind":"person","person_id":"cbr-p000252","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m060-0013","start":13,"end":15,"surface":"咎犯","kind":"person","person_id":"cbr-p001740","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m060-0048","start":48,"end":50,"surface":"重耳","kind":"person","person_