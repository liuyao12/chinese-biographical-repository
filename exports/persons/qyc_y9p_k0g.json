_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-043-wangrong:p013:m0065","start":65,"end":68,"surface":"陳道寧","kind":"person","person_id":"qyc_y9p_k0g","status":"contextual_provisional","resolution_note":"人倫鑒識與黃公酒壚回憶分域；嵇叔夜/阮嗣宗按同段嵇阮及既有字證。渾金非王渾，名詞亂流不標。","paragraph_id":"c-jinshu-043-wangrong:p013","chapter_id":"c-jinshu-043-wangrong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-043-wangrong:p013","text":"戎有人倫鑒識，嘗目山濤如璞玉渾金，人皆欽其寶，莫知名其器；王衍神姿高徹，如瑤林瓊樹，自然是風塵表物。謂裴頠拙於用長，荀勖工於用短，陳道寧𦃩𦃩如束長竿。族弟敦有高名，戎惡之。敦每候戎，輒托疾不見。敦後果為逆亂。其鑒嘗先見如此。嘗經黃公酒壚下過，顧謂後車客曰：「吾昔與嵇叔夜、阮嗣宗酣暢于此，竹林之遊亦預其末。自嵇、阮雲亡，吾便為時之所羈絏。今日視之雖近，邈若山河！」初，孫秀為琅邪郡吏，求品於鄉議。戎從弟衍將不許，戎勸品之。及秀得志，朝士有宿怨者皆被誅，而戎、衍獲濟焉。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-043-wangrong:p013:m0000","start":0,"end":1,"surface":"戎","kind":"person","person_id":"48e_04a_3d8","status":"contextual_provisional","resolution_note":"人倫鑒識與黃公酒壚回憶分域；嵇叔夜/阮嗣宗按同段嵇阮及既有字證。渾金非王渾，名詞亂流不標。"},{"id":"c-jinshu-043-wangrong:p013:m0009","start":9,"end":11,"surface":"山濤","kind":"person","person_id":"0uv_x8k_mfc_A","status":"contextual_provisional","resolution_note":"人倫鑒識與黃公酒壚回憶分域；嵇叔夜/阮嗣宗按同段嵇阮及既有字證。渾金非王渾，名詞亂流不標。"},{"id":"c-jinshu-043-wangrong:p013:m0029","start":29,"end":31,"surface":"王衍","kind":"person","person_id":"b0c_13f_c3a","status":"contextual_provisional","resolution_note":"人倫鑒識與黃公酒壚回憶分域；嵇叔夜/阮嗣宗按同段嵇阮及既有字證。渾金非王渾，名詞亂流不標。"},{"id":"c-jinshu-043-wangrong:p013:m0051","start":51,"end":53,"surface":"裴頠","kind":"person","person_id":"svm_6fh_34r","status":"contextual_provisional","resolution_note":"人倫鑒識與黃公酒壚回憶分域；嵇叔夜/阮嗣宗按同段嵇阮及既有字證。渾金非王渾，名詞亂流不標。"},{"id":"c-jinshu-043-wangrong:p013