al_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-058-lukang:line071","chapter_id":"c-sanguozhi-058-lukang"},{"id":"c-sanguozhi-058-lukang:line071:m0164","start":164,"end":165,"surface":"肇","kind":"person","person_id":"sta_dcm_n53","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-058-lukang:line071","chapter_id":"c-sanguozhi-058-lukang"},{"id":"c-sanguozhi-058-lukang:line071:m0210","start":210,"end":211,"surface":"肇","kind":"person","person_id":"sta_dcm_n53","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-058-lukang:line071","chapter_id":"c-sanguozhi-058-lukang"},{"id":"c-sanguozhi-058-lukang:line071:m0228","start":228,"end":229,"surface":"肇","kind":"person","person_id":"sta_dcm_n53","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-058-lukang:line071","chapter_id":"c-sanguozhi-058-lukang"}],"relations":[],"title_holdings":[{"id":"th-wu052-bz-43","person_id":"sta_dcm_n53","title":"荊州刺吏","kind":"office","mode":"attestation","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-052","chapter_id":"c-sanguozhi-052-buzhi-complete","source_id":"s-sanguozhi-052-buzhi-complete","paragraph_id":"c-sanguozhi-052-buzhi-complete:line110","quote":"十（一）年卒，子協嗣，統騭所領，加撫軍將軍。協卒，子璣嗣侯。協弟闡，繼業爲西陵督，加昭武將軍，封西亭侯，鳳皇元年，召爲繞帳督。闡累世在西陵，卒被征命，自以失職，又懼有讒禍，於是據城降晉，遣璣與弟璿詣洛陽爲任，晉以闡爲都督西陵諸軍事、衞將軍、儀同三司，加侍中，假節領交州牧，封宜都公。璣監江陵諸軍事、左將軍。加散騎常侍，領廬陵太守，改封江陵侯；璿給事中、宣威將軍，封都鄕侯。命車騎將軍羊祜、荊州刺吏楊肇往赴救闡。孫皓使陸抗西行，祜等遁退。抗陷城，斬闡等，歩氏泯滅，惟璿紹祀。","person_mention_id":"c-sanguozhi-052-buzhi-complete:line110:m0198"}],"attestations":[{"id":"th-wu052-bz-43:a","paragraph_id":"c-sanguozhi-052-buzhi-complete:line110","start":194,"end":198,"surface":"荊州刺吏","person_mention_id":"c-sanguozhi-052-buzhi-complete:line110:m0198","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"t-wu058-k14","person_id":"sta_dcm_n53","kind":"office","title":"荊州刺史","mode":"attestation","status":"source_attested","effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本句所載職官，任免時間未詳。","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-058","chapter_id":"c-sanguozhi-058-lukang","source_id":"s-sanguozhi-058-lukang","paragraph_id":"c-sanguozhi-058-lukang:line071","quote":"晉巴東監軍徐胤率水軍詣建平，荊州刺史楊肇至西陵。抗令張咸固守其城；公安督孫遵巡南岸御祜；水軍督留慮、鎮西將軍朱琬拒胤。身率三軍，憑圍對肇。將軍朱喬、營都督俞贊亡詣肇。抗曰：「贊軍中舊吏，知吾虛實者，吾常慮夷兵素不簡練，若敵攻圍，必先此處。」即夜易夷民，皆以舊將充之。明日，肇果攻故夷兵處，抗命旋軍擊之，矢石雨下，肇眾傷死者相屬。肇至經月。計屈夜遁。抗欲追之，而慮闡畜力項領，伺視間隙，兵不足分，於是但鳴鼓戒眾，若將追者。肇眾兇懼，悉解甲挺走，抗使輕兵躡之，肇大破敗，祜等皆引軍還。抗遂陷西陵城，誅夷闡族及其大將吏，自此以下，所請赦者數萬口。修治城圍，東還樂鄉，貌無矜色，謙沖如常，故得將士歡心。","person_mention_id":"c-sanguozhi-058-lukang:line071:m0019"}],"attestations":[{"id":"t-wu058-k14:a","paragraph_id":"c-sanguozhi-058-lukang:line071","person_mention_id":"c-sanguozhi-058-lukang:line071:m0019","start":14,"end":18,"surface":"荊州刺史","usage":"narrative","date_expression":null}],"human_reviewed":false,"reviewer":"Codex（AI 代理）","model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-052-buzhi-complete:line110","text":"十（一）年卒，子協嗣，統騭所領，加撫軍將軍。協卒，子璣嗣侯。協弟闡，繼業爲西陵督，加昭武將軍，封西亭侯，鳳皇元年，召爲繞帳督。闡累世在西陵，卒被征命，自以失職，又懼有讒禍，於是據城降晉，遣璣與弟璿詣洛陽爲任，晉以闡爲都督西陵諸軍事、衞將軍、儀同三司，加侍中，假節領交州牧，封宜都公。璣監江陵諸軍事、左將軍。加散騎常侍，領廬陵太守，改封江陵侯；璿給事中、宣威將軍，封都鄕侯。命車騎將軍羊祜、荊州刺吏楊肇往赴救闡。孫皓使陸抗西行，祜等遁退。抗陷城，斬闡等，歩氏泯滅，惟璿紹祀。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-sanguozhi-052-buzhi-complete:line110:m0008","start":8,"end":9,"surface":"協","kind":