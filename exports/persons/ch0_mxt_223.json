assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-043-guoshu:p005:m0068","kind":"person","start":68,"end":70,"surface":"宗澹","person_id":"ch0_mxt_223","status":"contextual_provisional","resolution_note":"完整敘事內的具名/省稱/字稱，原字保留；同指理由見逐人identity-review。","paragraph_id":"c-jinshu-043-guoshu:p005","chapter_id":"c-jinshu-043-guoshu"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-jin043-guoshu-zongdan","person_id":"ch0_mxt_223","surfaces":["宗澹"],"scope":"same_chapter","chapter_ids":["c-jinshu-043-guoshu"],"status":"contextual_provisional","confidence_level":"high","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-043","source_id":"s-jinshu-043-ws2618531-guoshu","chapter_id":"c-jinshu-043-guoshu","paragraph_id":"c-jinshu-043-guoshu:p005","quote":"王敦召為參軍，轉從事中郎。襄陽都督周訪卒，敦遣舒監襄陽軍。甘卓至，乃還。朝廷征舒為右丞，敦留不遣。敦謀為逆，舒諫不從，使守武昌。荊州別駕宗澹忌舒才能，數譖之于王暠。暠疑舒與甘卓同謀，密以白敦，敦不受。高官督護繆坦嘗請武昌城西地為營，太守樂凱言於敦曰：「百姓久買此地，種菜自贍，不宜奪之。」敦大怒曰：「王處仲不來江湖，當有武昌地不，而人云是我地邪！」凱懼，不敢言。舒曰：「公聽舒一言。」敦曰：「平子以卿病狂，故掐鼻灸眉頭，舊疢復發邪！」舒曰：「古之狂也直，周昌、汲黯、硃雲不狂也。昔堯立誹謗之木，舜置敢諫之鼓，然後事無枉縱。公為勝堯、舜邪？乃逆折舒，使不得言。何與古人相遠！」敦曰：「卿欲何言？」舒曰：「繆坦可謂小人，疑誤視聽，奪人私地，以強陵弱。晏子稱：君曰其可，臣獻其否，以成其可。是以舒等不敢不言。」敦即使還地，眾咸壯之。敦重舒公亮，給賜轉豐，數詣其家。表為梁州刺史。病卒。"}],"rationale":"本源荊州別駕宗澹譖舒，與宗岱不因同姓接親等，與謝澹/司馬澹不同。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null,"external_reference_file":"source-evidence/jin043-guoshu-source/identity-review.json"}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-043-guoshu:p005","text":"王敦召為參軍，轉從事中郎。襄陽都督周訪卒，敦遣舒監襄陽軍。甘卓至，乃還。朝廷征舒為右丞，敦留不遣。敦謀為逆，舒諫不從，使守武昌。荊州別駕宗澹忌舒才能，數譖之于王暠。暠疑舒與甘卓同謀，密以白敦，敦不受。高官督護繆坦嘗請武昌城西地為營，太守樂凱言於敦曰：「百姓久買此地，種菜自贍，不宜奪之。」敦大怒曰：「王處仲不來江湖，當有武昌地不，而人云是我地邪！」凱懼，不敢言。舒曰：「公聽舒一言。」敦曰：「平子以卿病狂，故掐鼻灸眉頭，舊疢復發邪！」舒曰：「古之狂也直，周昌、汲黯、硃雲不狂也。昔堯立誹謗之木，舜置敢諫之鼓，然後事無枉縱。公為勝堯、舜邪？乃逆折舒，使不得言。何與古人相遠！」敦曰：「卿欲何言？」舒曰：「繆坦可謂小人，疑誤視聽，奪人私地，以強陵弱。晏子稱：君曰其