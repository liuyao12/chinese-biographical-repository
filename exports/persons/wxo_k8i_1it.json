d":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m005-0142","start":142,"end":145,"surface":"公孫弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0151","start":151,"end":153,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0162","start":162,"end":167,"surface":"天下之學士","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-121-rulin","book_id":"b-shiji-121","work_id":"w-shiji","source_id":"s-shiji121-rulin"},{"id":"c-shiji-121-rulin:p007","text":"申公者，魯人也。高祖過魯，申公以弟子從師入見高祖于魯南宮。呂太后時，申公游學長安，與劉郢同師。已而郢為楚王，令申公傅其太子戊。戊不好學，疾申公。及王郢卒，戊立為楚王，胥靡申公。申公恥之，歸魯，退居家教，終身不出門，復謝絕賓客，獨王命召之乃往。弟子自遠方至受業者百餘人。申公獨以詩經為訓以教，無傳（疑），疑者則闕不傳。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m007-0000","start":0,"end":2,"surface":"申公","kind":"person","person_id":"wxo_k8i_1it","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m007-0008","start":8,"end":10,"surface":"高祖","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m007-0013","start":13,"end":15,"surface":"申公","kind":"person","person_id":"wxo_k8i_1it","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m007-0016","start":16,"end":18,"surface":"弟子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m007-0019","start":19,"end":20,"surface":"師","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m007-0022","start":22,"end":24,"surface":"高祖","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m007-0029","start":29,"end":32,"surface":"呂太后","kind":"person","person_id":"i30_mjq_6q8_A","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m007-0034","start":34,"end":36,"surface":"申公","kind":"person","person_id":"wxo_k8i_1i