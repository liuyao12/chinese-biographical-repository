_i3p_hrs","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-huayi:p002:m0337","surface":"訪","start":337,"end":338,"person_id":"c6b_s71_vt7","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-huayi:p002:m0339","surface":"逸","start":339,"end":340,"person_id":"kd1_i3p_hrs","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-huayi:p002:m0349","surface":"衛展","start":349,"end":351,"person_id":"97w_bx6_nqi","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-huayi:p002:m0353","surface":"軼","start":353,"end":354,"person_id":"p86_bh6_jm2","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-huayi:p002:m0370","surface":"周廣","start":370,"end":372,"person_id":"1tq_584_98b","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-huayi:p002:m0379","surface":"軼","start":379,"end":380,"person_id":"p86_bh6_jm2","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-huayi:p002:m0381","surface":"軼","start":381,"end":382,"person_id":"p86_bh6_jm2","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-061-huayi","book_id":"b-jinshu-061","work_id":"w-jinshu","source_id":"s-jinshu-061-huayi-ws7903772"},{"id":"c-jinshu-066-liuhong:p005","text":"惠帝幸長安，河間王顒挾天子，詔弘為劉喬繼援。弘以張方殘暴，知顒必敗，遣使受東海王越節度。時天下大亂，弘專督江漢，威行南服。前廣漢太守辛冉說弘以從橫之事，弘大怒，斬之。河間王顒使張光為順陽太守，南陽太守衛展說弘曰：「彭城王前東奔，有不善之言。張光，太宰腹心，宜斬光以明向背。」弘曰：「宰輔得失，豈張光之罪！危人自安，君子弗為也。」展深恨之。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":18,"last_line":18,"raw_start":1998,"raw_end":2169,"raw_character_offsets":[2000,2001,2002,2003,2004,2005,2006,2007,2008,2009,2010,2011,2012,2013,2014,2015,2016,2017,2018,2019,2020,2021,2022,2023,2024,2025,2026,2027,2028,2029,2030,2031,2032,2033,2034,2035,2036,2037,2038,2039,2040,2041,2042,2043,2044,2045,2046,2047,2048,2049,2050,2051,2052,2053,2054,2055,2056,2057,2058,2059,2060,2061,2062,2063,2064,2065,2066,2067,2068,2069,2070,2071,2072,2073,20