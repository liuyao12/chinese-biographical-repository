61-huayi-ws7903772","s-jinshu-066-liuhong-ws1527632","s-jinshu-076-yutan"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-060-miaoyin:p001:m0111","surface":"衛展","start":111,"end":113,"person_id":"97w_bx6_nqi","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-060-miaoyin:p001","chapter_id":"c-jinshu-060-miaoyin"},{"id":"c-jinshu-061-huayi:p002:m0349","surface":"衛展","start":349,"end":351,"person_id":"97w_bx6_nqi","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-061-huayi:p002","chapter_id":"c-jinshu-061-huayi"},{"id":"c-jinshu-066-liuhong:p005:m0100","surface":"衛展","start":100,"end":102,"person_id":"97w_bx6_nqi","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-066-liuhong:p005","chapter_id":"c-jinshu-066-liuhong"},{"id":"c-jinshu-076-yutan:line097:m0244","start":244,"end":246,"surface":"衛展","kind":"person","person_id":"97w_bx6_nqi","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-076-yutan:line097","chapter_id":"c-jinshu-076-yutan"}],"relations":[],"title_holdings":[{"id":"th-w076r-wei0","person_id":"97w_bx6_nqi","title":"江州刺史","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-076","chapter_id":"c-jinshu-076-yutan","source_id":"s-jinshu-076-yutan","paragraph_id":"c-jinshu-076-yutan:line097","quote":"虞潭，字思奧，會稽餘姚人，吳騎都尉翻之孫也。父忠，仕至宜都太守。吳之亡也，堅壁不降，遂死之。潭清貞有檢操，州辟從事、主簿，舉秀才，大司馬、齊王冏請為祭酒，除祁鄉令，徙醴陵令。值張昌作亂，郡縣多從之，潭獨起兵斬昌別率鄧穆等。襄陽太守華恢上潭領建平太守，以疾固辭。遂周旋征討，以軍功賜爵都亭侯。陳敏反，潭東下討敏弟贊于江州。廣州刺史王矩上潭領廬陵太守。綏撫荒餘，咸得其所。又與諸軍共平陳恢，仍轉南康太守，進爵東鄉侯。尋被元帝檄，使討江州刺史華軼。潭至廬陵，會軼已平，而湘川賊杜弢猶盛。江州刺史衛展上潭並領安成太守。時甘卓屯宜陽，為杜弢所逼。潭進軍救卓，卓上潭領長沙太守，固辭不就。王敦版潭為湘東太守，復以疾辭。弢平後，元帝召補丞相軍諮祭酒，轉琅邪國中尉。","person_mention_id":"c-jinshu-076-yutan:line097:m0244"}],"attestations":[{"id":"th-w076r-wei0:a","paragraph_id":"c-jinshu-076-yutan:line097","start":240,"end":244,"surface":"江州刺史","person_mention_id":"c-jinshu-076-yutan:line097:m0244","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-060-miaoyin:p001","text":"胤字休祖，安平獻王外孫也，與播名譽略齊。初為尚書郎，後遷太弟左衛率，轉魏郡太守。及王浚軍逼鄴，石超等大敗，胤奔東海王越於徐州，越使胤與播俱入關，而所說得行，大駕東還。越以胤為冠軍將軍、南陽太守。胤從藍田出武關，之南陽，前守衛展距胤不受，胤乃還洛。懷帝即位，拜胤左衛將軍，轉散騎常侍、太僕卿。既而與播及帝舅王延、尚書何綏、太史令高堂沖並參機密，為東海王越所害。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":43,"last_line":43,"raw_start":2973,"raw_end":3154,"raw_character_offsets":[2975,2976,2977,2978,2979,2980,2981,2982,2983,2984,2985,2986,2987,2988,2989,2990,2991,2992,2993,2994,2995,2996,2997,2998,2999,3000,3001,3002,3003,3004,3005,3006,3007,3008,3009,3010,3011,3012,3013,3014,3015,3016,3017,3018,3019,3020,3021,3022,3023,3024,3025,3026,3027,3028,3029,3030,3031,3032,3033,3034,3035,3036,3037,3038,3039,3040,3041,3042,3043,3044,3045,3046,3047,3048,3049,3050,3051,3052,3053,3054,3055,3056,3057,3058,3059,3060,3061,3062,3063,3064,3065,3066,3067,3068,3069,3070,3071,3072,3073,3074,3075,3076,3077,3078,3079,3080,