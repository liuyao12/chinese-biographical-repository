ragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-shiji-086-cike"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji086-012","subject_person_id":"klu_n74_itc","predicate":"spouse","object_person_id":"gmx_6ao_hg2","status":"source_attested","evidence":[{"chapter_id":"c-shiji-086-cike","source_id":"s-shiji-086-cike","paragraph_id":"c-shiji-086-cike:p018","quote":"政姊榮聞人有刺殺韓相者，賊不得，國不知其名姓，暴其尸而縣之千金，乃於邑曰：「其是吾弟與？嗟乎，嚴仲子知吾弟！」立起，如韓，之市，而死者果政也，伏尸哭極哀，曰：「是軹深井里所謂聶政者也。」市行者諸衆人皆曰：「此人暴虐吾國相，王縣購其名姓千金，夫人不聞與？何敢來識之也？」榮應之曰：「聞之。然政所以蒙汚辱自棄於市販之閒者，爲老母幸無恙，妾未嫁也。親既以天年下世，妾已嫁夫，嚴仲子乃察舉吾弟困汚之中而交之，澤厚矣，可柰何！士固爲知己者死，今乃以妾尚在之故，重自刑以絶從，妾其柰何畏歿身之誅，終滅賢弟之名！」大驚韓市人。乃大呼天者三，卒於邑悲哀而死政之旁。"}],"qualifiers":{"source_term":"妾已嫁夫","historicity":"historical_tradition"},"interpretation_note":"僅記錄明示父子、母、姊弟、兄弟及局部婚配來源主張；夷眛之子僚等異說尚待跨篇校核，母老子弱與季父不補未名世系。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-086-cike:m018-0183","start":182,"end":183,"surface":"夫","kind":"person","person_id":"gmx_6ao_hg2","status":"contextual_provisional","note":"第二輪修正字元錯位：原錨點落在逗號；保留提及ID，實際指向妾已嫁夫之夫。","paragraph_id":"c-shiji-086-cike:p018","chapter_id":"c-shiji-086-cike"}],"relations":[{"id":"a-shiji086-012","subject_person_id":"klu_n74_itc","predicate":"spouse","object_person_id":"gmx_