ns":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji008-058","person_id":"hy4_7ra_i67","surfaces":["樅公"],"scope":"cross_chapter","chapter_ids":["c-shiji-007-xiangyu","c-shiji-008-gaozu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-007-xiangyu:p030","quote":"漢王使御史大夫周苛、樅公、魏豹守滎陽。周苛、樅公謀曰：「反國之王，難與守城。」乃共殺魏豹。楚下滎陽城，生得周苛。項王謂周苛曰：「為我將，我以公為上將軍，封三萬戶。」周苛罵曰：「若不趣降漢，漢今虜若，若非漢敵也。」項王怒，烹周苛，井殺樅公。"},{"paragraph_id":"c-shiji-008-gaozu:p040","quote":"漢軍絕食，乃夜出女子東門二千餘人，被甲，楚因四面擊之。將軍紀信乃乘王駕，詐為漢王，誑楚，楚皆呼萬歲，之城東觀，以故漢王得與數十騎出西門遁。令御史大夫周苛、魏豹、樅公守滎陽。諸將卒不能從者，盡在城中。周苛、樅公相謂曰：「反國之王，難與守城。」因殺魏豹。"},{"paragraph_id":"c-shiji-008-gaozu:p042","quote":"項羽聞漢王在宛，果引兵南。漢王堅壁不與戰。是時彭越渡睢水，與項聲、薛公戰下邳，彭越大破楚軍。項羽乃引兵東擊彭越。漢王亦引兵北軍成皋。項羽已破走彭越，聞漢王復軍成皋，乃復引兵西，拔滎陽，誅周苛、樅公，而虜韓王信，遂圍成皋。"}],"rationale":"只在所列原句的秦末楚漢軍事／分封敘事內暫定同指；有前卷錨點時對讀相接事件，不把同名作全庫匹配規則，仍待異源覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-007-xiangyu:p030","text":"漢王使御史大夫周苛、樅公、魏豹守滎陽。周苛、樅公謀曰：「反國之王，難與守城。」乃共殺魏豹。楚下滎陽城，生得周苛。項王謂周苛曰：「為我將，我以公為上將軍，封三萬戶。」周苛罵曰：「若不趣降漢，漢今虜若，若非漢敵也。」項王怒，烹周苛，井殺樅公。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-007-xiangyu:m030-0000","start":0,"end":2,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m030-0007","start":7,"end":9,"surface":"周苛","kind":"person","person_id":"7tm_3ss_4on","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m030-0010","start":10,"end":12,"surface":"樅公","kind":"person","person_id":"hy4_7ra_i67","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m030-0013","start":13,"end":15,"surface":"魏豹","kind":"person","person_id":"6ve_ik8_jv8","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m030-0019","start":19,"end":21,"surface":"周苛","kind":"person","person_id":"7tm_3ss_4on","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu: