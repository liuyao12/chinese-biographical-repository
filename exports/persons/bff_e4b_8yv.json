ations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji035-074","person_id":"bff_e4b_8yv","surfaces":["楚惠王"],"scope":"same_chapter","chapter_ids":["c-shiji-035-guancai"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-035-guancai:p021","quote":"侯齊四年，楚惠王滅蔡，蔡侯齊亡，蔡遂絕祀。後陳滅三十三年。"}],"rationale":"依文王子同母十人、蔡曹君世系、蔡女船中事件、楚公子圍弒其王及城濮／伐曹的具體敘事暫定異稱。郟敖／夾敖按同一事件、釐／僖負羈按本卷論贊暫同指；不同國與同國不同世代的同名者分開。匿名者、校勘及跨篇同指仍待核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji036-052","person_id":"bff_e4b_8yv","surfaces":["惠王","楚惠","楚惠王"],"scope":"cross_chapter","chapter_ids":["c-shiji-035-guancai","c-shiji-036-chenqi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-035-guancai:p021","quote":"侯齊四年，楚惠王滅蔡，蔡侯齊亡，蔡遂絕祀。後陳滅三十三年。"},{"paragraph_id":"c-shiji-036-chenqi:p025","quote":"湣公六年，孔子適陳。吳王夫差伐陳，取三邑而去。十三年，吳復來伐陳，陳告急楚，楚昭王來救，軍於城父，吳師去。是年，楚昭王卒於城父。時孔子在陳。十五年，宋滅曹。十六年，吳王夫差伐齊，敗之艾陵，使人召陳侯。陳侯恐，如吳。楚伐陳。二十一年，齊田常弒其君簡公。二十三年，楚之白公勝殺令尹子西、子綦，襲惠王。葉公攻敗白公，白公自殺。"},{"paragraph_id":"c-shiji-036-chenqi:p026","quote":"二十四年，楚惠王復國，以兵北伐，殺陳湣公，遂滅陳而有之。是歲，孔子卒。"},{"paragraph_id":"c-shiji-036-chenqi:p028","quote":"東樓公生西樓公，西樓公生題公，題公生謀娶公。謀娶公當周厲王時。謀娶公生武公。武公立四十七年卒，子靖公立。靖公二十三年卒，子共公立。共公八年卒，子德公立。德公十八年卒，弟桓公姑容立。桓公十七年卒，子孝公丐立。孝公十七年卒，弟文公益姑立。文公十四年卒，弟平公郁立。平公十八年卒，子悼公成立。悼公十二年卒，子隱公乞立。七月，隱公弟遂弒隱公自立，是為釐公。釐公十九年卒，子湣公維立。湣公十五年，楚惠王滅陳。十六年，湣公弟閼路弒湣公代立，是為哀公。哀公立十年卒，湣公子敕立，是為出公。出公十二年卒，子簡公春立。立一年，楚惠王之四十四年，滅杞。杞後陳亡三十四年。"},{"paragraph_id":"c-shiji-036-chenqi:p030","quote":"舜之後，周武王封之陳，至楚惠王滅之，有世家言。禹之後，周武王封之杞，楚惠王滅之，有世家言。契之後為殷，殷有本紀言。殷破，周封其後於宋，齊湣王滅之，有世家言。后稷之後為周，秦昭王滅之，有本紀言。皋陶之後，或封英、六，楚穆王滅之，無譜。伯夷之後，至周武王復封於齊，曰太公望，陳氏滅之，有世家言。伯翳之後，至周平王時封為秦，項羽滅之，有本紀言。垂、益、夔、龍，其後不知所封，不見也。右十一人者，皆唐虞之際名有功德臣也；其五人之後皆至帝王，餘乃為顯諸侯。滕、薛、騶，夏、殷、周之閒封也，小，不足齒列，弗論也。"},{"paragraph_id":"c-shiji-036-chenqi:p032","quote":"太史公曰：舜之德可謂至矣！禪位於夏，而後世血食者歷三代。及楚滅陳，而田常得政於齊，卒為建國，百世不絕，苗裔茲茲，有土者不乏焉。至禹，於周則杞，微甚，不足數也。楚惠王滅杞，其後越王句踐興。"},{"paragraph_id":"c-shiji-036-chenqi:p033","quote":"【索隱述贊】盛德之祀，必及百世。舜、禹餘烈，陳、杞是繼。媯滿受封，東樓纂系。閼路篡逆，夏姬淫嬖。二國衰微，或興或替。前並後虜，皆亡楚惠。句踐勃興，田和吞噬。蟬聯血食，豈其苗裔？"}],"rationale":"本篇第25、26、28、30、32、33段按明示名與稱號、陳／杞世系及具體敘事暫定「惠王／楚惠／楚惠王」同指；引句均保留，不按同名字面跨篇合併。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji038-044","person_id":"bff_e4b_8yv","surfaces":["楚惠王"],"scope":"cross_chapter","chapter_ids":["c-shiji-035-guancai","c-shiji-038-song"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-035-guancai:p021","quote":"侯齊四年，楚惠王滅蔡，蔡侯齊亡，蔡遂絕祀。後陳滅三十三年。"},{"paragraph_id":"c-shiji-038-song:p054","quote":"三十七年，楚惠王滅陳。熒惑守心。心，宋之分野也。景公憂之。司星子韋曰：「可移於相。」景公曰：「相，吾之股肱。」曰：「可移於民。」景公曰：「君者待民。」曰：「可移於歲。」景公曰：「歲饑民困，吾誰爲君！」子韋曰：「天髙聽卑。君有君人之言三，熒惑宜有動。」於是候之，果徙三度。"}],"rationale":"按本篇明示名與稱號、宋國世系及具體事件暫同指；未把同字短名全域合併，所有引句與未定處保留。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-035-guancai:p021","text":"侯齊四年，楚惠王滅蔡，蔡侯齊亡，蔡遂絕祀。後陳滅三十三年。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-035-guancai:m021-0000","start":0,"end":2,"surface":"侯齊","kind":"person","person_id":"995_xas_r98_AAAA","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m021-0005","start":5,"end":8,"surface":"楚惠王","kind":"person","person_id":"bff_e4b_8yv","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m021-0009","start":9,"end":10,"surface":"蔡","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未定稱呼、國別指代或數位校勘字樣；不補人名、成員與闕代。"},{"id":"c-shiji-035-guancai:m021-0011","start":11,"end":14,"surface":"蔡侯齊","kind":"person","person_id":"995_xas_r98_AAAA","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m021-0016","start":16,"end":17,"surface":"蔡","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未定稱呼、國別指代或數位校勘字樣；不補人名、成員與闕代。"}],"chapter_id":"c-shiji-035-guancai","book_id":"b-shiji-035","work_id":"w-shiji","source_id":"s-shiji-035-guancai"},{"id":"c-shiji-036-chenqi:p025","text":"湣公六年，孔子適陳。吳王夫差伐陳，取三邑而去。十三年，吳復來伐陳，陳告急楚，楚昭王來救，軍於城父，吳師去。是年，楚昭王卒於城父。時孔子在陳。十五年，宋滅曹。十六年，吳王夫差伐齊，敗之艾陵，使人召陳侯。陳侯恐，如吳。楚伐陳。二十一年，齊田常弒其君簡公。二十三年，楚之白公勝殺令尹子西、子綦，襲惠王。葉公攻敗白公，白公自殺。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-036-chenqi:m025-0000","start":0,"end":2,"surface":"湣公","kind":"person","person_id":"uay_2h8_ps8_AAA","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m025-0005","start":5,"end":7,"surface":"孔子","kind":"person","person_id":"fp6_ia6_7yw","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m025-0010","start":10,"end":14,"surface":"吳王夫差","kind":"person","person_id":"5dm_e40_rqh_AAAAAAAAAAAAAAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m025-0038","start":38,"end":41,"surface":"楚昭王","kind":"person","person_id":"9gq_tfb_414","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m025-0049","start":49,"end":51,"surface":"吳師","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、引語角色、國別、校勘或未定指代；不補未見人名、闕代或成員。"},{"id":"c-shiji-036-chenqi:m025-0056","start":56,"end":59,"surface":"楚昭王","kind":"person","person_id":"9gq_tfb_414","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m025-0065","start":65,"end":67,"surface":"孔子","kind":"person","person_id":"fp6_ia6_7yw","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m025-0082","start":82,"end":86,"surface":"吳王夫差","kind":"person","person_id":"5dm_e40_rqh_AAAAAAAAAAAAAAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m025-0095","start":95,"end":96,"surface":"人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、引語角色、國別、校勘或未定指代；不補未見人名、闕代或成員。"},{"id":"c-shiji-036-chenqi:m025-0097","start":97,"end":99,"surface":"陳侯","kind":"person","person_id":"uay_2h8_ps8_AAA","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m025-0100","start":100,"end":102,"surface":"陳侯","kind":"person","person_id":"uay_2h8_ps8_AAA","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m025-0116","start":116,"end":119,"surface":"齊田常","k