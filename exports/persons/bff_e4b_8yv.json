至周武王復封於齊，曰太公望，陳氏滅之，有世家言。伯翳之後，至周平王時封為秦，項羽滅之，有本紀言。垂、益、夔、龍，其後不知所封，不見也。右十一人者，皆唐虞之際名有功德臣也；其五人之後皆至帝王，餘乃為顯諸侯。滕、薛、騶，夏、殷、周之閒封也，小，不足齒列，弗論也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-036-chenqi:m030-0000","start":0,"end":1,"surface":"舜","kind":"person","person_id":"ddb_l4j_4j2","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m030-0004","start":4,"end":7,"surface":"周武王","kind":"person","person_id":"y4i_pjk_4gn_AA","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m030-0012","start":12,"end":15,"surface":"楚惠王","kind":"person","person_id":"bff_e4b_8yv","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m030-0023","start":23,"end":24,"surface":"禹","kind":"person","person_id":"6ip_dr3_fbl","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m030-0027","start":27,"end":30,"surface":"周武王","kind":"person","person_id":"y4i_pjk_4gn_AA","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m030-0034","start":34,"end":37,"surface":"楚惠王","kind":"person","person_id":"bff_e4b_8yv","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m030-0045","start":45,"end":46,"surface":"契","kind":"person","person_id":"ea8_yum_lvj","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m030-0067","start":67,"end":70,"surface":"齊湣王","kind":"person","person_id":"zpv_ei1_hhy","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m030-0078","start":78,"end":80,"surface":"后稷","kind":"person","person_id":"jqy_1fv_u7v","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m030-0085","start":85,"end":88,"surface":"秦昭王","kind":"person","person_id":"ao3_0fy_d45","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m030-0096","start":96,"end":98,"surface":"皋陶","kind":"person","person_id":"p3l_pp3_n6i","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m030-0107","start":107,"end":110,"surface":"楚穆王","kind":"person","person_id":"2d3_fsd_1dh_A","status":"cont