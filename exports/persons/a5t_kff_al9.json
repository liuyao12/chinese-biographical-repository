tion_id":"c-shiji-127-rizhe:m003-0000","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"文獻用稱不作授任日期；傅保留原稱，不改太傅，黃直大夫未定官階；未知起訖保持未知。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-127-rizhe:p003","text":"宋忠爲中大夫，賈誼爲博士，同日俱出洗沐，相從論議，誦易先王聖人之道術，究遍人情，相視而嘆。賈誼曰：「吾聞古之聖人，不居朝廷，必在卜醫之中。今吾已見三公九卿朝士大夫，皆可知矣。試之卜數中以觀采。」二人即同輿而之市，游於卜肆中。天新雨，道少人，司馬季主閒坐，弟子三四人侍，方辯天地之道，日月之運，陰陽吉凶之本。二大夫再拜謁。司馬季主視其狀貌，如類有知者，即禮之，使弟子延之坐。坐定，司馬季主復理前語，分別天地之終始，日月星辰之紀，差次仁義之際，列吉凶之符，語數千言，莫不順理。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-127-rizhe:m003-0000","start":0,"end":2,"surface":"宋忠","kind":"person","person_id":"a5t_kff_al9","status":"contextual_provisional"},{"id":"c-shiji-127-rizhe:m003-0007","start":7,"end":9,"surface":"賈誼","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-127-rizhe:m003-0045","start":45,"end":47,"surface":"賈誼","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-127-rizhe:m003-0120","start":120,"end":124,"surface":"司馬季主","kind":"person","person_id":"r8r_74l_t6d","status":"contextual_provisional"},{"id":"c-shiji-127-rizhe:m003-0127","start":127,"end":132,"surface":"弟子三四人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-127-rizhe:m003-0153","start":153,"end":156,"surface":"二大夫","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-127-rizhe:m003-0160","start":160,"end":164,"surface":"司馬季主","kind":"person","person_id":"r8r_74l_t6d","status":"contextual_provisional"},{"id":"c-shiji-127-rizhe:m003-0180","start":180,"end":182,"surface":"弟子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-127-rizhe:m003-0189","start":189,"end":193,"surface":"司馬季主","kind":"person","person_id":"r8r_74l_t6d","status":"contextual_provisional"}],"chapter_id":"c-shiji-127-rizhe","book_id":"b-shiji-127","work_id":"w-shiji","source_id":"s-shiji127-rizhe"},{"id":"c-shiji-127-rizhe:p004","text":"宋忠、賈誼瞿然而悟，獵纓正襟危坐，曰：「吾望先生之狀，聽先生之辭，小子竊觀於世，未嘗見也。今何居之卑，何行之汙？」","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-127-rizhe:m004-0000","start":0,"end":2,"surface":"宋忠","kind":"person","person_id":"a5t_kff_al9","status":"contextual_provisional"},{"id":"c-shiji-127-rizhe:m004-0003","start":3,"end":5,"surface":"賈誼","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-127-rizhe:m004-0022","start":22,"end":24,"surface":"先生","kind":"person","person_id":"r8r_74l_t6d","status":"contextual_provisional"},{"id":"c-shiji-127-rizhe:m004-0028","start":28,"end":30,"surface":"先生","kind":"person","person_id":"r8r_74l_t6d","status":"contextual_provisional"}],"chapter_id":"c-shiji-127-rizhe","book_id":"b-shiji-127","work_id":"w-shiji","source_id":"s-shiji127-rizhe"},{"id":"c-shiji-127-rizhe:p016","text":"宋忠、賈誼忽而自失，芒乎無色，悵然噤口不能言。於是攝衣而起，再拜而辭。行洋洋也，出門僅能自上車，伏軾低頭，卒不能出氣。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-127-rizhe:m016-0000","start":0,"end":2,"surface":"宋忠","kind":"person","person_id":"a5t_kff_al9","status":"contextual_provisional"},{"id":"c-shiji-127-rizhe:m016-0003","start":3,"end":5,"surface":"賈誼","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"}],"chapter_id":"c-shiji-127-rizhe","book_id":"b-shiji-127","work_id":"w-shiji","source_id":"s-shiji127-rizhe"},{"id":"c-shiji-127-rizhe:p017","text":"居三日，宋忠見賈誼於殿門外，乃相引屏語相謂自嘆曰：「道高益安，勢高益危。居赫赫之勢，失身且有日矣。夫卜而有不審，不見奪糈；爲人主計而不審，身無所處。此相去遠矣，猶天冠地屨也。此老子之所謂『無名者萬物之始』也。天地曠曠，物之熙熙，或安或危，莫知居之。我與若，何足預彼哉！彼久而愈安，雖曾氏之義未有以異也。」","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-127-rizhe:m017-0004","start":4,"end":6,"surface":"宋忠","kind":"person","person_id":"a5t_kff_al9","status":"contextual_provisional"},{"id":"c-shiji-127-rizhe:m017-0007","start":7,"end":9,"surface":"賈誼","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-127-rizhe:m017-0088","start":88,"end":90,"surface":"老子","kind":"person","person_id":"881_5eh_yg3","status":"contextual_provisional"},{"id":"c-shiji-127-rizhe:m017-0141","start":141,"end":143,"surface":"曾氏","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-127-rizhe","book_id":"b-shiji-127","work_id":"w-shiji","source_id":"s-shiji127-rizhe"},{"id":"c-shiji-127-rizhe:p018","text":"久之，宋忠使匈奴，不至而還，抵罪。而賈誼爲梁懷王傅，王墮馬薨，誼不食，毒恨而死。此務華絶根者也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-127-rizhe:m018-0003","start":3,"end":5,"surface":"宋忠","kind":"person","person_id":"a5t_kff_al9","status":"contextual_provisional"},{"id":"c-shiji-127-rizhe:m018-0018","start":18,"end":20,"surface":"賈誼","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-127-rizhe:m018-0021","start":21,"end":24,"surface":"梁懷王","kind":"person","person_id":"yqp_nlb_p1p_ACB","status":"contextual_provisional"},{"id":"c-shiji-127-rizhe:m018-0026","start":26,"end":27,"surface":"王","kind":"person","person_id":"yqp_nlb_p1p_ACB","status":"contextual_provisional"},{"id":"c-shiji-127-rizhe:m018-0031","start":31,"end":32,"surface":"誼","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"}],"chapter_id":"c-shiji-127-rizhe","book_id":"b-shiji-127","work_id":"w-shiji","source_id":"s-shiji127-rizhe"}],"sources":[{"chapter_id":"c-shiji-127-rizhe","work_id":"w-shiji","book_id":"b-shiji-127","source_id":"s-shiji127-rizhe","source":{"title":"史記／卷127","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷127","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷