paragraph_id":"c-sanguozhi-053-chengbing:line027","chapter_id":"c-sanguozhi-053-chengbing"},{"id":"c-sanguozhi-053-xuezong:line039:m0025","start":25,"end":27,"surface":"劉熙","kind":"person","person_id":"4j2_9t6_18d","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-053-xuezong:line039","chapter_id":"c-sanguozhi-053-xuezong"}],"relations":[{"id":"a-wu053-xue-liu","subject_person_id":"yt7_qwp_k7p","object_person_id":"4j2_9t6_18d","predicate":"teacher","qualifiers":{"source_term":"從劉熙學","relationship_basis":"teaching"},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-053","chapter_id":"c-sanguozhi-053-xuezong","source_id":"s-sanguozhi-053-xuezong","paragraph_id":"c-sanguozhi-053-xuezong:line039","quote":"　　薛綜字敬文，沛郡竹邑人也。少依族人避地交州，從劉熙學。士燮既附孫權，召綜為五官中郎（將），除合浦、交阯太守。","subject_person_mention_id":"c-sanguozhi-053-xuezong:line039:m0002","object_person_mention_id":"c-sanguozhi-053-xuezong:line039:m0025"}],"interpretation_note":"傳文或所引吳書所記的受學。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-053-chengbing:line027","text":"　　程秉字德樞，汝南南頓人也。逮事鄭玄，後避亂交州，與劉熙考論大義，遂博通五經。士燮命為長史。權聞其名儒，以禮徵，秉既到，拜太子太傅。黃武四年，權為太子登娉周瑜女，秉守太常，迎妃於吳，權親幸秉船，深見優禮。既還，秉從容進說登曰：「婚姻人倫之始，王教之基，是以聖王重之，所以率先眾庶，風化天下，故《詩》美《關睢》，以為稱首。願太子尊禮教於閨房，存《周南》之所詠，則道化隆於上，頌聲作於下矣。」登笑曰：「將順其美，匡救其惡，誠所賴於傅君也。」病卒官。著《周易摘》《尚書駁》《論語弼》，凡三萬餘言。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-053-chengbing:line027:m0002","start":2,"end":4,"surface":"程秉","kind":"person","person_id":"eus_x4z_ogu","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-chengbing:line027:m0005","start":5,"end":7,"surface":"德樞","kind":"person","person_id":"eus_x4z_ogu","status":"contextual_pr