rical_tradition"},"interpretation_note":"僅記錄明示父子、母、姊弟、兄弟及局部婚配來源主張；夷眛之子僚等異說尚待跨篇校核，母老子弱與季父不補未名世系。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-086-cike:m006-0033","start":33,"end":37,"surface":"公子蓋餘","kind":"person","person_id":"1vr_rmi_ay7","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p006","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m006-0068","start":68,"end":70,"surface":"蓋餘","kind":"person","person_id":"1vr_rmi_ay7","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p006","chapter_id":"c-shiji-086-cike"}],"relations":[{"id":"a-shiji086-006","subject_person_id":"5dm_e40_rqh_AAAAAAAAAAAAAAAAAACA","predicate":"brother","object_person_id":"1vr_rmi_ay7","status":"source_attested","evidence":[{"chapter_id":"c-shiji-086-cike","source_id":"s-shiji-086-cike","paragraph_id":"c-shiji-086-cike:p006","quote":"光既得專諸，善客待之。九年而楚平王死。春，呉王僚欲因楚喪，使其二弟公子蓋餘、屬庸將兵圍楚之灊；使延陵季子於晉，以觀諸侯之變。楚發兵絶呉將蓋餘、屬庸路，呉兵不得還。於是公子光謂專諸曰：「此時不可失，不求何獲！且光眞王嗣，當立，季子雖來，不吾廢也。」專諸曰：「王僚可殺也。母老子弱，而兩弟將兵伐楚，楚絶其後。方今呉外困於楚，而内空無骨鯁之臣，是無如我何。」公子光頓首曰：「光之身，子之身也。」"}],"qualifiers":{"source_term":"使其二弟公子蓋餘、屬庸","historicity":"historical_tradition"},"interpretation_note":"僅記錄明示父子、母、姊弟、兄弟及局部婚配來源主張；夷眛之子僚等異說尚待跨篇校核，母老子弱與季父不補未名世系。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji086-015","person_id":"1vr_rmi_ay7","scope":"same_chapter","chapter_ids":["c-shiji-086-cike"],"status":"contextual_provisional","rationale":"依專諸刺僚、公子光自立闔閭與豫讓報智伯敘事暫接。專諸之子、豫讓妻友保持未名；范中行氏與母老子弱未補名，嵌套對話指代待核。","reviewer":"Codex（AI 代理）","surfaces":["公子蓋餘","蓋餘"],"evidence":[{"paragraph_id":"c-shiji-086-cike:p006","quote":"光既得專諸，善客待之。九年而楚平王死。春，呉王僚欲因楚喪，使其二弟公子蓋餘、屬庸將兵圍楚之灊；使延陵季子於晉，