t_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin061-liuting-father","subject_person_id":"6ld_plw_7m4","object_person_id":"7xd_7vq_fwl","predicate":"father","qualifiers":{"source_term":"子挺"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-061","chapter_id":"c-jinshu-061-liuqiao","source_id":"s-jinshu-061-liuqiao-ws7903772","paragraph_id":"c-jinshu-061-liuqiao:p006","quote":"時河間王顒方距關東，倚喬為助，不納其言。東海王越移檄天下，帥甲士三萬，將入關迎大駕，軍次於蕭，喬懼，遣子祐距越于蕭縣之靈壁。劉琨分兵向許昌，許昌人納之。琨自滎陽率兵迎越，遇祐，眾潰見殺。喬眾遂散，與五百騎奔平氏。帝還洛陽，大赦，越復表喬為太傅軍諮祭酒。越薨，復以喬為都督豫州諸軍事、鎮東將軍、豫州刺史。卒于官，時年六十三。湣帝末，追贈司空。子挺，潁川太守。挺子耽。","subject_person_mention_id":"c-jinshu-061-liuqiao:p006:m0171","object_person_mention_id":"c-jinshu-061-liuqiao:p006:m0011"}],"status":"source_attested","interpretation_note":"子挺繼記於喬卒後。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"a-jin061-liudan-father","subject_person_id":"mc1_08w_r6l","object_person_id":"6ld_plw_7m4","predicate":"father","qualifiers":{"source_term":"挺子耽"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-061","chapter_id":"c-jinshu-061-liuqiao","source_id":"s-jinshu-061-liuqiao-ws7903772","paragraph_id":"c-jinshu-061-liuqiao:p006","quote":"時河間王顒方距關東，倚喬為助，不納其言。東海王越移檄天下，帥甲士三萬，將入關迎大駕，軍次於蕭，喬懼，遣子祐距越于蕭縣之靈壁。劉琨分兵向許昌，許昌人納之。琨自滎陽率兵迎越，遇祐，眾潰見殺。喬眾遂散，與五百騎奔平氏。帝還洛陽，大赦，越復表喬為太傅軍諮祭酒。越薨，復以喬為都督豫州諸軍事、鎮東將軍、豫州刺史。卒于官，時年六十三。湣帝末，追贈司空。子挺，潁川太守。挺子耽。","subject_person_mention_id":"c-jinshu-061-liuqiao:p006:m0180","object_person_mention_id":"c-jinshu-061-liuqiao:p006:m0171"}],"status":"source_attested","interpretation_note":"耽為挺子。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial