inds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"start":0,"end":2,"surface":"張衡","kind":"person","person_id":"b93_5f8_c76","status":"resolved_contextual","id":"c-sanguozhi-010-osaka1670-ni-heng-interface:u004:m0000","paragraph_id":"c-sanguozhi-010-osaka1670-ni-heng-interface:u004","chapter_id":"c-sanguozhi-010-osaka1670-ni-heng-interface"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-010-osaka1670-ni-heng-interface:u004","text":"張衡文士傳曰孔融數薦衡于太祖欲與相見而衡疾惡之意常憤滿因狂疾不肯往而數有言論太祖聞其名圖欲辱之乃錄為鼓吏後至八月朝大宴賓客並會時鼓吏擊鼓過皆當脫其故服易著新衣次衡衡擊為漁陽參撾容態不常音節殊妙坐上賓客聽之莫不慷慨過不易衣吏呵之衡乃當太祖前以次脫衣裸身而立徐徐乃著褌帽畢復擊鼓參撾而顏色不怍太祖大笑告四坐曰本欲辱衡衡反辱孤至今有漁陽參撾自衡造也融深責數衡并宣太祖意欲令與太祖相見衡許之曰當為卿往至十月朝融先見太祖說衡欲求見至日晏衡著布單衣疏巾履坐太祖營門外以杖捶地數罵太祖太祖勑外廐急具精馬三匹并騎二人謂融曰禰衡豎子乃敢爾孤殺之無異于雀鼠顧此人素有虛名遠近所聞今日殺之人將謂孤不能容今送與劉表視卒當何如乃令騎以衡置馬上兩騎扶送至南陽","text_layer":"witness_appended_pei_songzhi_note","annotation_status":"in_progress","mentions":[{"start":0,"end":2,"surface":"張衡","kind":"person","person_id":"b93_5f8_c76","status":"resolved_contextual","id":"c-sanguozhi-010-osaka1670-ni-heng-interface:u004:m0000"},{"start":6,"end":8,"surface":"孔融","kind":"person","person_id":"1e4_e5b_007","status":"resolved_contextual","id":"c-sanguozhi-010-osaka1670-ni-heng-interface:u004:m0006"},{"start":10,"end":11,"surface":"衡","kind":"person","person_id":"727_51c_19b","status":"resolved_contextual","id":"c-sanguozhi-010-osaka1670-ni-heng-interface:u004:m0010"},{"start":12,"end":14,"surface":"太祖","kind":"perso