{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004709","identity_policy":"contextual_provisional","person_ids":["cbr-p004709"],"persons":[{"id":"cbr-p004709","label":"白圭引古（魯仲連鄒陽列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"白圭","mention_ids":["c-shiji-083-luzou:m018-0121","c-shiji-083-luzou:m018-0167"]}],"evidence":[{"mention_id":"c-shiji-083-luzou:m018-0121","chapter_id":"c-shiji-083-luzou","paragraph_id":"c-shiji-083-luzou:p018","quote":"白圭"},{"mention_id":"c-shiji-083-luzou:m018-0167","chapter_id":"c-shiji-083-luzou","paragraph_id":"c-shiji-083-luzou:p018","quote":"白圭"}]}],"source_mention_summary":[{"source_id":"s-shiji-083-luzou","work_id":"w-shiji","book_id":"b-shiji-083","chapter_id":"c-shiji-083-luzou","mention_count":2,"mention_ids":["c-shiji-083-luzou:m018-0121","c-shiji-083-luzou:m018-0167"],"paragraph_ids":["c-shiji-083-luzou:p018"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-083-luzou"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-083-luzou:m018-0121","start":121,"end":123,"surface":"白圭","kind":"person","person_id":"cbr-p004709","status":"contextual_provisional","paragraph_id":"c-shiji-083-luzou:p018","chapter_id":"c-shiji-083-luzou"},{"id":"c-shiji-083-luzou:m018-0167","start":167,"end":169,"surface":"白圭","kind":"person","person_id":"cbr-p004709","status":"contextual_provisional","paragraph_id":"c-shiji-083-luzou:p018","chapter_id":"c-shiji-083-luzou"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji083-054","person_id":"cbr-p004709","scope":"same_chapter","chapter_ids":["c-shiji-083-luzou"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"按獄中上書引古與梁廷敘事分層，保留原稱。枚生及衛先生未以記憶補姓名；王奢不改作趙奢。燕丹與丹限荊軻句群，臣與大王限鄒陽對梁孝王的上書。","surfaces":["白圭"],"evidence":[{"paragraph_id":"c-shiji-083-luzou:p018","quote":"諺曰：「有白頭如新，傾蓋如故。」何則？知與不知也。故昔樊於期逃秦之燕，藉荊軻首以奉丹之事；王奢去齊之魏，臨城自剄以卻齊而存魏。夫王奢、樊於期非新於齊、秦而故於燕、魏也，所以去二國死兩君者，行合於志而慕義無窮也。是以蘇秦不信於天下，而為燕尾生；白圭戰亡六城，為魏取中山。何則？誠有以相知也。蘇秦相燕，燕人惡之於王，王按劍而怒，食以駃騠；白圭顯於中山，中山人惡之魏文侯，文侯投之以夜光之璧。何則？兩主二臣，剖心坼肝相信，豈移於浮辭哉！"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-083-luzou:p018","text":"諺曰：「有白頭如新，傾蓋如故。」何則？知與不知也。故昔樊於期逃秦之燕，藉荊軻首以奉丹之事；王奢去齊之魏，臨城自剄以卻齊而存魏。夫王奢、樊於期非新於齊、秦而故於燕、魏也，所以去二國死兩君者，行合於志而慕義無窮也。是以蘇秦不信於天下，而為燕尾生；白圭戰亡六城，為魏取中山。何則？誠有以相知也。蘇秦相燕，燕人惡之於王，王按劍而怒，食以駃騠；白圭顯於中山，中山人惡之魏文侯，文侯投之以夜光之璧。何則？兩主二臣，剖心坼肝相信，豈移於浮辭哉！","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-083-luzou:m018-0027","start":27,"end":30,"surface":"樊於期","kind":"person","person_id":"cbr-p004706","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m018-0036","start":36,"end":38,"surface":"荊軻","kind":"person","person_id":"cbr-p004695","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m018-0041","start":41,"end":42,"surface":"丹","kind":"person","person_id":"cbr-p004696","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m018-0045","start":45,"end":47,"surface":"王奢","kind":"person","person_id":"cbr-p004707","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m018-0064","start":64,"end":66,"surface":"王奢","kind":"person","person_id":"cbr-p004707","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m018-0067","start":67,"end":70,"surface":"樊於期","kind":"person","person_id":"cbr-p004706","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m018-0090","start":90,"end":92,"surface":"兩君","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或譬喻保留；燕尾生不直接當作另一具名人物。"},{"id":"c-shiji-083-luzou:m018-0107","start":107,"end":109,"surface":"蘇秦","kind":"person","person_id":"cbr-p004708","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m018-0117","start":117,"end":120,"surface":"燕尾生","ki