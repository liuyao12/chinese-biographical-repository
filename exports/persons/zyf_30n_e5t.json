1","text":"臻字彥遐，有勇略智謀，賜爵當陽亭侯。咸和中，為南郡太守、領南蠻校尉、假節。卒官，追贈平南將軍，諡曰肅。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":92,"last_line":92,"raw_start":10127,"raw_end":10180,"raw_character_offsets":[10129,10130,10131,10132,10133,10134,10135,10136,10137,10138,10139,10140,10141,10142,10143,10144,10145,10146,10147,10148,10149,10150,10151,10152,10153,10154,10155,10156,10157,10158,10159,10160,10161,10162,10163,10164,10165,10166,10167,10168,10169,10170,10171,10172,10173,10174,10175,10176,10177,10178,10179],"revision_id":1527632},"mentions":[{"id":"c-jinshu-066-taozhen:p001:m0000","surface":"臻","start":0,"end":1,"person_id":"zyf_30n_e5t","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-066-taozhen","book_id":"b-jinshu-066","work_id":"w-jinshu","source_id":"s-jinshu-066-taozhen-ws1527632"}],"sources":[{"chapter_id":"c-jinshu-066-taokan","work_id":"w-jinshu","book_id":"b-jinshu-066","source_id":"s-jinshu-066-taokan-ws1527632","source":{"title":"晉書卷六十六·陶侃","provider":"Wikisource","permalink":"https://zh.wikisource.org/w/index.php?oldid=1527632","url":"https://zh.wikisource.org/w/index.php?oldid=1527632","revision_id":1527632,"edition":"維基文庫固定修訂","accessed_on":"2026-11-22","review_status":"text_checked","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫授權。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","extent":"晉書卷六十六·陶侃","text_scope":"complete_biography_unit","raw_path":"source-evidence/jin066-roll/ws1527632.wikitext","raw_file_sha256":"6cddc694d426567aad52b2183afd501d71adab778675ef7b91850801a4ced3aa","collation_witnesses":["source-evidence/jin066-roll/volume-reading.json"]}},{"chapter_id":"c-jinshu-066-taoyu","work_id":"w-jinshu","book_id":"b-jinshu-066","source_id":"s-jinshu-066-taoyu-ws1527632","source":{"title":"晉書卷六十六·陶輿","provider":"Wikisource","permalink":"https://zh.wikisource.org/w/index.php?oldid=1527632","url":"https://zh.wikisource.org/w/index.php?oldid=1527632","revision_id":1527632,"e