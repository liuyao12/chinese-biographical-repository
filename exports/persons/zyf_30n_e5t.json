,"original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-jin066-zhen","person_id":"zyf_30n_e5t","event_type":"death","source_term":"卒官","source_anchor":{"paragraph_id":"c-jinshu-066-taozhen:p001","start":37,"end":39,"surface":"卒官"},"date_expression":null,"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-066","chapter_id":"c-jinshu-066-taozhen","source_id":"s-jinshu-066-taozhen-ws1527632","paragraph_id":"c-jinshu-066-taozhen:p001","quote":"臻字彥遐，有勇略智謀，賜爵當陽亭侯。咸和中，為南郡太守、領南蠻校尉、假節。卒官，追贈平南將軍，諡曰肅。","person_mention_id":"c-jinshu-066-taozhen:p001:m0000"}],"status":"source_attested","interpretation_note":"按同段人物與次第核所屬卒事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"mentions":[{"id":"c-jinshu-066-taokan:p004:m0128","surface":"臻","start":128,"end":129,"person_id":"zyf_30n_e5t","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-066-taokan:p004","chapter_id":"c-jinshu-066-taokan"},{"id":"c-jinshu-066-taokan:p005:m0032","surface":"臻","start":32,"end":33,"person_id":"zyf_30n_e5t","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-066-taokan:p005","chapter_id":"c-jinshu-066-taokan"},{"id":"c-jinshu-066-taokan:p017:m0025","surface":"臻","start":25,"end":26,"person_id":"zyf_30n_e5t","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-066-taokan:p017","chapter_id":"c-jinshu-066-taokan"},{"id":"c-jinshu-066-taoyu:p001:m0000","surface":"臻","start":0,"end":1,"person_id":"zyf_30n_e5t","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-066-taoyu:p001","chapter_id":"c-jinshu-066-taoyu"},{"id":"c-jinshu-066-taozhen:p001:m0000","surface":"臻","start":0,"end":1,"person_id":"zyf_30n_e5t","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-066-taozhen:p001","chapter_id":"c-jinshu-066-taozhen"}],"relations":[{"id":"a-jin066-taoyu-brother","subject_person_id":"9zl_6as_brd","object_person_id":"zyf_30n_e5t","predicate":"brother","qualifiers":{"source_term":"臻弟輿"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-066","chapter_id":"c-jinshu-066-taoyu","source_id":"s-jinshu-066-taoyu-ws1527632","paragraph_id":"c-jinshu-066-taoyu:p001","quote":"臻弟輿，果烈善戰，以功累遷武威將軍。初，賊張奕本中州人，元康中被差西征，遇天下亂，遂留蜀。至是，率三百餘家欲就杜弢，為侃所獲。諸將請殺其丁壯，取其妻息，輿曰：「此本官兵，數經戰陣，可赦之以為用。」侃赦之，以配輿。及侃與杜弢戰敗，賊以桔槔打沒官軍船艦，軍中失色。輿率輕舸出其上流以擊之，所向輒克。賊又率眾將焚侃輜重，輿又擊破之。自是每戰輒克，賊望見輿軍，相謂曰：「避陶武威。」無敢當者。後與杜弢戰，輿被重創，卒。侃哭之慟，曰：「喪吾家寶！」三軍皆為之垂泣。詔贈長沙太守。","subject_person_mention_id":"c-jinshu-066-taoyu:p001:m0002","object_person_mention_id":"c-jinshu-066-taoyu:p001:m0000"}],"status":"source_attested","interpretation_note":"陶臻與陶輿為兄弟。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-066-taokan:p004","text":"陳敏之亂，弘以侃為江夏太守，加鷹揚將軍。侃備威儀，迎母官舍，鄉里榮之。敏遣其弟恢來寇武昌，侃出兵禦之。隨郡內史扈瑰間侃於弘曰：「侃與敏有鄉里之舊，居大郡，統強兵，脫有異志，則荊州無東門矣。」弘曰：「侃之忠能，吾得之已久，豈有是乎！」侃潛聞之，遽遣子洪及兄子臻詣弘以自固。弘引為參軍，資而遣之。又加侃為督護，使與諸軍並力距恢。侃乃以運船為戰艦，或言不可，侃曰：「用官物討官賊，但須列上有本末耳。」於是擊恢，所向必破。侃戎政齊肅，凡有虜獲，皆分士卒，身無私焉。後以母憂去職。嘗有二客來吊，不哭而退，化為雙鶴，沖天而去，時人異之。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":35,"last_line":35,"raw_start":3480,"raw_end":3744,"raw_character_offsets":[3482,3483,3484,3485,3486,3487,3488,3489,3490,3491,3492,3493,3494,3495,3496,3497,3498,3499,3500,3501,3502,3503,3504,3505,3506,3507,3508,3509,3510,3511,3512,3513,3514,3515,3516,3517,3518,3519,3520,3521,3522,3523,3524,3525,3526,3527,3528,3529,3530,3531,3532,3533,3534,3535,3536,3537,3538,3539,3540,3541,3542,3543,3544,3545,3546,3547,3548,3549,3550,3551,3552,3553,3554,3555,3556,3557,3558,3559,3560,3561,3562,3563,3564,3565,3566,3567,3568,3569,3570,3571,3572,3573,3574,3575,3576,3577,3578,3579,3580,3581,3582,3583,3584,3585,3586,3587,3588,3589,3590