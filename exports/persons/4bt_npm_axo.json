{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"4bt_npm_axo","canonical_person_id":"4bt_npm_axo","id_aliases":["cbr-p004704"],"identity_policy":"contextual_provisional","person_ids":["4bt_npm_axo"],"persons":[{"id":"4bt_npm_axo","label":"比干引古（魯仲連鄒陽列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"比干","mention_ids":["c-shiji-083-luzou:m017-0076","c-shiji-083-luzou:m020-0024","c-shiji-083-luzou:m022-0147"]}],"evidence":[{"mention_id":"c-shiji-083-luzou:m017-0076","chapter_id":"c-shiji-083-luzou","paragraph_id":"c-shiji-083-luzou:p017","quote":"比干"},{"mention_id":"c-shiji-083-luzou:m020-0024","chapter_id":"c-shiji-083-luzou","paragraph_id":"c-shiji-083-luzou:p020","quote":"比干"},{"mention_id":"c-shiji-083-luzou:m022-0147","chapter_id":"c-shiji-083-luzou","paragraph_id":"c-shiji-083-luzou:p022","quote":"比干"}],"id_aliases":["cbr-p004704"]}],"source_mention_summary":[{"source_id":"s-shiji-083-luzou","work_id":"w-shiji","book_id":"b-shiji-083","chapter_id":"c-shiji-083-luzou","mention_count":3,"mention_ids":["c-shiji-083-luzou:m017-0076","c-shiji-083-luzou:m020-0024","c-shiji-083-luzou:m022-0147"],"paragraph_ids":["c-shiji-083-luzou:p017","c-shiji-083-luzou:p020","c-shiji-083-luzou:p022"],"passage_count":3}],"most_mentioned_source_ids":["s-shiji-083-luzou"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-083-luzou:m017-0076","start":76,"end":78,"surface":"比干","kind":"person","person_id":"4bt_npm_axo","status":"contextual_provisional","paragraph_id":"c-shiji-083-luzou:p017","chapter_id":"c-shiji-083-luzou"},{"id":"c-shiji-083-luzou:m020-0024","start":24,"end":26,"surface":"比干","kind":"person","person_id":"4bt_npm_axo","status":"contextual_provisional","paragraph_id":"c-shiji-083-luzou:p020","chapter_id":"c-shiji-083-luzou"},{"id":"c-shiji-083-luzou:m022-0147","start":147,"end":149,"surface":"比干","kind":"person","person_id":"4bt_npm_axo","status":"contextual_provisional","paragraph_id":"c-shiji-083-luzou:p022","chapter_id":"c-shiji-083-luzou"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji083-049","person_id":"4bt_npm_axo","scope":"same_chapter","chapter_ids":["c-shiji-083-luzou"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"按獄中上書引古與梁廷敘事分層，保留原稱。枚生及衛先生未以記憶補姓名；王奢不改作趙奢。燕丹與丹限荊軻句群，臣與大王限鄒陽對梁孝王的上書。","surfaces":["比干"],"evidence":[{"paragraph_id":"c-shiji-083-luzou:p017","quote":"昔卞和獻寶，楚王刖之；李斯竭忠，胡亥極刑。是以箕子詳狂，接輿辟世，恐遭此患也。願大王孰察卞和、李斯之意，而後楚王、胡亥之聽，無使臣為箕子、接輿所笑。臣聞比干剖心，子胥鴟夷，臣始不信，乃今知之。願大王孰察，少加憐焉。"},{"paragraph_id":"c-shiji-083-luzou:p020","quote":"是以聖王覺寤，捐子之之心，而能不說於田常之賢；封比干之後，修孕婦之墓，故功業復就於天下。何則？欲善無厭也。夫晉文公親其讎，彊霸諸侯；齊桓公用其仇，而一匡天下。何則，慈仁慇勤，誠加於心，不可以虛辭借也。"},{"paragraph_id":"c-shiji-083-luzou:p022","quote":"臣聞明月之珠，夜光之璧，以闇投人於道路，人無不按劍相眄者。何則？無因而至前也。蟠木根柢，輪囷離詭，而為萬乘器者。何則？以左右先為之容也。故無因至前，雖出隨侯之珠，夜光之璧，猶結怨而不見德。故有人先談，則以枯木朽株樹功而不忘。今夫天下布衣窮居之士，身在貧賤，雖蒙堯、舜之術，挾伊、管之辯，懷龍逢、比干之意，欲盡忠當世之君，而素無根柢之容，雖竭精思，欲開忠信，輔人主之治，則人主必有按劍相眄之跡，是使布衣不得為枯木朽株之資也。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-083-luzou:p017","text":"昔卞和獻寶，楚王刖之；李斯竭忠，胡亥極刑。是以箕子詳狂，接輿辟世，恐遭此患也。願大王孰察卞和、李斯之意，而後楚王、胡亥之聽，無使臣為箕子、接輿所笑。臣聞比干剖心，子胥鴟夷，臣始不信，乃今知之。願大王孰察，少加憐焉。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-083-luzou:m017-0001","start":1,"end":3,"surface":"卞和","kind":"person","person_id":"9j0_saz_b8g","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m017-0006","start":6,"end":8,"surface":"楚王","kind"