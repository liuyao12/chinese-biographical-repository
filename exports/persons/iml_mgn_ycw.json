ragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"},{"source_id":"s-shiji128-guice","work_id":"w-shiji","book_id":"b-shiji-128","chapter_id":"c-shiji-128-guice","raw_mention_count":1,"mention_ids":["c-shiji-128-guice:m017-0196"],"paragraph_ids":["c-shiji-128-guice:p017"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-shiji-128-guice:m017-0196","mention_ids":["c-shiji-128-guice:m017-0196"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-shiji-087-lisi","s-shiji-088-mengtian","s-shiji128-guice"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-shiji087-014","person_id":"iml_mgn_ycw","event_type":"death","status":"source_attested","date_expression":null,"source_term":"桀殺關龍逢","evidence":[{"chapter_id":"c-shiji-087-lisi","source_id":"s-shiji-087-lisi","paragraph_id":"c-shiji-087-lisi:p030","quote":"趙高案治李斯。李斯拘執束縛，居囹圄中，仰天而歎曰：「嗟乎，悲夫！不道之君，何可為計哉！昔者桀殺關龍逢，紂殺王子比干，吳王夫差殺伍子胥。此三臣者，豈不忠哉，然而不免於死，身死而所忠者非也。今吾智不及三子，而二世之無道過於桀、紂、夫差，吾以忠死，宜矣。且二世之治豈不亂哉！日者夷其兄弟而自立也，殺忠臣而貴賤人，作為阿房之宮，賦斂天下。吾非不諫也，而不吾聽也。凡古聖王，飲食有節，車器有數，宮室有度，出令造事，加費而無益於民利者禁，故能長久治安。今行逆於昆弟，不顧其咎；侵殺忠臣，不思其殃；大為宮室，厚賦天下，不愛其費：三者已行，天下不聽。今反者已有天下之半矣，而心尚未寤也，而以趙高為佐，吾必見寇至咸陽，麋鹿游於朝也。」","person_mention_id":"c-shiji-087-lisi:m030-0047"}],"interpretation_note":"保存本篇死亡原語及敘述範圍；來源所傳不等於史實已獨立確證，未核書影，未知日期不補，不由死亡終止全部官爵。李斯獄中引古忠臣敘事，保留作本文所傳死亡說，不補確年。","reviewer":"Codex（AI 代理）","human_reviewed":false},{"id":"le-shiji088-012","person_id":"iml_mgn_ycw","event_type":"death","status":"source_attested","date_expression":null,"source_term":"桀殺關龍逢","evidence":[{"chapter_id":"c-shiji-088-mengtian","source_id":"s-shiji-088-mengtian","paragraph_id":"c-shiji-088-mengtian:p010","quote":"二世又遣使者之陽周，令蒙恬曰：「君之過多矣，而卿弟毅有大罪，法及內史。」恬曰：「自吾先人，及至子孫，積功信於秦三世矣。今臣將兵三十餘萬，身雖囚系，其勢足以倍畔，然自知必死而守義者，不敢辱先人之教，以不忘先主也。昔周成王初立，未離襁緥周公旦負王以朝，卒定天下。及成王有病甚殆，公旦自揃其爪以沈於河，曰：『王未有識，是旦執事。有罪殃，旦受其不祥。』乃書而藏之記府，可謂信矣。及王能治國，有賊臣言：『周公旦欲為亂久矣，王若不備，必有大事。』王乃大怒，周公旦走而奔於楚。成王觀於記府，得周公旦沈書，乃流涕曰：『孰謂周公旦欲為亂乎！』殺言之者而反周公旦。故《周書》曰『必參而伍之』。今恬之宗，世無二心，而事卒如此，是必孽臣逆亂，內陵之道也。夫成王失而復振則卒昌；桀殺關龍逢，紂殺王子比干而不悔，身死則國亡。臣故曰過可振而諫可覺也。察於參伍，上聖之法也。凡臣之言，非以求免於咎也，將以諫而死，願陛下為萬民思從道也。」使者曰：「臣受詔行法於將軍，不敢以將軍言聞於上也。」蒙恬喟然太息曰：「我何罪於天，無過而死乎？」良久，徐曰：「恬罪固當死矣。起臨洮屬之遼東，城塹萬餘里，此其中不能無絕地脈哉？此乃恬之罪也。」乃吞藥自殺。","person_mention_id":"c-shiji-088-mengtian:m010-0328"}],"interpretation_note":"蒙恬引古及傳說敘述，不套秦代背景年月。 保存本篇原語及敘述範圍，不視作獨立證成，不由死亡一律終止所有官爵；未核書影。","reviewer":"Codex（AI 代理）","human_reviewed":false},{"id":"le-shiji128-003","person_id":"iml_mgn_ycw","event_type":"death","status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-128-guice","source_id":"s-shiji128-guice","paragraph_id":"c-shiji-128-guice:p017","quote":"元王曰：「不然。寡人聞之，諫者福也，諛者賊也。人主聽諛，是愚惑也。雖然，禍不妄至，福不徒來。天地合氣，以生百財。陰陽有分，不離四時，十有二月，日至為期。聖人徹焉，身乃無災。明王用之，人莫敢欺。故云福之至也，人自生之；禍之至也，人自成之。禍與福同，刑與德雙。聖人察之，以知吉凶。桀紂之時，與天爭功，擁遏鬼神，使不得通。是固已無道矣，諛臣有眾。桀有諛臣，名曰趙梁。教為無道，勸以貪狼。繋湯夏臺，殺關龍逢。左右恐死，偷諛於傍。國危於累卵，皆曰無傷。稱樂萬歲，或曰未央。蔽其耳目，與之詐狂。湯卒伐桀，身死國亡。聽其諛臣，身獨受殃。春秋著之，至今不忘。紂有諛臣，名為左彊。誇而目巧，教為象郎。將至於天，又有玉床。犀玉之器，象箸而羹。聖人剖其心，壯士斬其胻。箕子恐死，被髪佯狂。殺周太子歷，囚文王昌。投之石室，將以昔至明。陰兢活之，與之俱亡。入於周地，得太公望。興卒聚兵，與紂相攻。文王病死，載尸以行。太子發代將，號為武王。戰於牧野，破之華山之陽。紂不勝敗而還走，圍之象郎。自殺宣室，身死不葬。頭懸車軫，四馬曳行。寡人念其如此，腸如涫湯。是人皆富有天下而貴至天子，然而大傲。欲無猒時，舉事而喜高，貪很而驕。不用忠信，聽其諛臣，而為天下笑。今寡人之邦，居諸侯之閒，曾不如秋毫。舉事不當，又安亡逃！」","person_mention_id":"c-shiji-128-guice:m017-0196"}],"source_term":"殺關龍逢","interpretation_note":"記錄補文故事的明示死亡，不當獨立歷史確證；未知年保持未知，不把卜辭病者死、恐死或龜死作人物死亡。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"mentions":[{"id":"c-shiji-087-lisi:m030-0047","start":47,"end":50,"surface":"關龍逢","kind":"person","person_id":"iml_mgn_ycw","status":"contextual_provisional","paragraph_id":"c-shiji-087-lisi:p030","chapter_id":"c-shiji-087-lisi"},{"id":"c-shiji-088-mengtian:m010-0328","start":328,"end":331,"surface":"關龍逢","kind":"person","person_id":"iml_mgn_ycw","status":"contextual_provisional","paragraph_id":"c-shiji-088-mengtian:p010","chapter_id":"c-shiji-088-mengtian"},{"id":"c-shiji-128-guice:m017-0196","start":196,"end":199,"surface":"關龍逢","kind":"person","person_id":"iml_mgn_ycw","status":"contextual_provisional","paragraph_id":"c-shiji-128-guice:p017","chapter_id":"c-shiji-128-guice"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji087-056","person_id":"iml_mgn_ycw","scope":"same_chapter","chapter_ids":["c-shiji-087-lisi"],"status":"contextual_provisional","rationale":"依李斯下獄及秦末局部承接暫接；始皇弟暫依下一段子嬰既位承接，本篇世系主張保留待跨篇覆核。其子與妻子仍待核指，不補父子或配偶；中子、太卜、行人保留未名。韓玘原字保留，宰予與簡公引古不以同名確證全部事實。趙高短稱高限後段敘事，官稱及嵌套指代待核。","reviewer":"Codex（AI 代理）","surfaces":["關龍逢"],"evidence":[{"paragraph_id":"c-shiji-087-lisi:p030","quote":"趙高案治李斯。李斯拘執束縛，居囹圄中，仰天而歎曰：「嗟乎，悲夫！不道之君，何可為計哉！昔者桀殺關龍逢，紂殺王子比干，吳王夫差殺伍子胥。此三臣者，豈不忠哉，然而不免於死，身死而所忠者非也。今吾智不及三子，而二世之無道過於桀、紂、夫差，吾以忠死，宜矣。且二世之治豈不亂哉！日者夷其兄弟而自立也，殺忠臣而貴賤人，作為阿房之宮，賦斂天下。吾非不諫也，而不吾聽也。凡古聖王，飲食有節，車器有數，宮室有度，出令造事，加費而無益於民利者禁，故能長久治安。今行逆於昆弟，不顧其咎；侵殺忠臣，不思其殃；大為宮室，厚賦天下，不愛其費：三者已行，天下不聽。今反者已有天下之半矣，而心尚未寤也，而以趙高為佐，吾必見寇至咸陽，麋鹿游於朝也。」"}]},{"id":"d-shiji088-036","person_id":"iml_mgn_ycw","scope":"same_chapter","chapter_ids":["c-shiji-088-mengtian"],"status":"contextual_provisional","rationale":"按本段明示姓名及局部承接暫定；引古人物只記正文所述，不補他書事件或年代。未名使者依不同奉命事件分置，曲宮段落使者與大夫按同段承接。","reviewer":"Codex（AI 代理）","surfaces":["關龍逢"],"evidence":[{"paragraph_id":"c-shiji-088-mengtian:p010","quote":"二世又遣使者之陽周，令蒙恬曰：「君之過多矣，而卿弟毅有大罪，法及內史。」恬曰：「自吾先人，及至子孫，積功信於秦三世矣。今臣將兵三十餘萬，身雖囚系，其勢足以倍畔，然自知必死而守義者，不敢辱先人之教，以不忘先主也。昔周成王初立，未離襁緥周公旦負王以朝，卒定天下。及成王有病甚殆，公旦自揃其爪以沈於河，曰：『王未有識，是旦執事。有罪殃，旦受其不祥。』乃書而藏之記府，可謂信矣。及王能治國，有賊臣言：『周公旦欲為亂久矣，王若不備，必有大事。』王乃大怒，周公旦走而奔於楚。成王觀於記府，得周公旦沈書，乃流涕曰：『孰謂周公旦欲為亂乎！』殺言之者而反周公旦。故《周書》曰『必參而伍之』。今恬之宗，世無二心，而事卒如此，是必孽臣逆亂，內陵之道也。夫成王失而復振則卒昌；桀殺關龍逢，紂殺王子比干而不悔，身死則國亡。臣故曰過可振而諫可覺也。察於參伍，上聖之法也。凡臣之言，非以求免於咎也，將以諫而死，願陛下為萬民思從道也。」使者曰：「臣受詔行法於將軍，不敢以將軍言聞於上也。」蒙恬喟然太息曰：「我何罪於天，無過而死乎？」良久，徐曰：「恬罪固當死矣。起臨洮屬之遼東，城塹萬餘里，此其中不能無絕地脈哉？此乃恬之罪也。」乃吞藥自殺。"}]}],"equivalence_decisions":[{"id":"eq-shiji128-cross-024","person_ids":["iml_mgn_ycw"],"canonical_person_id":"iml_mgn_ycw","scope":"cross_chapter","chapter_ids":["c-shiji-128-guice","c-shiji-088-mengtian","c-shiji-087-lisi"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-128-guice","source_id":"s-shiji128-guice","paragraph_id":"c-shiji-128-guice:p017","quote":"元王曰：「不然。寡人聞之，諫者福也，諛者賊也。人主聽諛，是愚惑也。雖然，禍不妄至，福不徒來。天地合氣，以生百財。陰陽有分，不離四時，十有二月，日至為期。聖人徹焉，身乃無災。明王用之，人莫敢欺。故云福之至也，人自生之；禍之至也，人自成之。禍與福同，刑與德雙。聖人察之，以知吉凶。桀紂之時，與天爭功，擁遏鬼神，使不得通。是固已無道矣，諛臣有眾。桀有諛臣，名曰趙梁。教為無道，勸以貪狼。繋湯夏臺，殺關龍逢。左右恐死，偷諛於傍。國危於累卵，皆曰無傷。稱樂萬歲，或曰未央。蔽其耳目，與之詐狂。湯卒伐桀，身死國亡。聽其諛臣，身獨受殃。春秋著之，至今不忘。紂有諛臣，名為左彊。誇而目巧，教為象郎。將至於天，又有玉床。犀玉之器，象箸而羹。聖人剖其心，壯士斬其胻。箕子恐死，被髪佯狂。殺周太子歷，囚文王昌。投之石室，將以昔至明。陰兢活之，與之俱亡。入於周地，得太公望。興卒聚兵，與紂相攻。文王病死，載尸以行。太子發代將，號為武王。戰於牧野，破之華山之陽。紂不勝敗而還走，圍之象郎。自殺宣室，身死不葬。頭懸車軫，四馬曳行。寡人念其如此，腸如涫湯。是人皆富有天下而貴至天子，然而大傲。欲無猒時，舉事而喜高，貪很而驕。不用忠信，聽其諛臣，而為天下笑。今寡人之邦，居諸侯之閒，曾不如秋毫。舉事不當，又安亡逃！」","mention_ids":["c-shiji-128-guice:m017-0196"]},{"chapter_id":"c-shiji-088-mengtian","source_id":"s-shiji-088-mengtian","paragraph_id":"c-shiji-088-mengtian:p010","quote":"二世又遣使者之陽周，令蒙恬曰：「君之過多矣，而卿弟毅有大罪，法及內史。」恬曰：「自吾先人，及至子孫，積功信於秦三世矣。今臣將兵三十餘萬，身雖囚系，其勢足以倍畔，然自知必死而守義者，不敢辱先人之教，以不忘先主也。昔周成王初立，未離襁緥周公旦負王以朝，卒定天下。及成王有病甚殆，公旦自揃其爪以沈於河，曰：『王未有識，是旦執事。有罪殃，旦受其不祥。』乃書而藏之記府，可謂信矣。及王能治國，有賊臣言：『周公旦欲為亂久矣，王若不備，必有大事。』王乃大怒，周公旦走而奔於楚。成王觀於記府，得周公旦沈書，乃流涕曰：『孰謂周公旦欲為亂乎！』殺言之者而反周公旦。故《周書》曰『必參而伍之』。今恬之宗，世無二心，而事卒如此，是必孽臣逆亂，內陵之道也。夫成王失而復振則卒昌；桀殺關龍逢，紂殺王子比干而不悔，身死則國亡。臣故曰過可振而諫可覺也。察於參伍，上聖之法也。凡臣之言，非以求免於咎也，將以諫而死，願陛下為萬民思從道也。」使者曰：「臣受詔行法於將軍，不敢以將軍言聞於上也。」蒙恬喟然太息曰：「我何罪於天，無過而死乎？」良久，徐曰：「恬罪固當死矣。起臨洮屬之遼東，城塹萬餘里，此其中不能無絕地脈哉？此乃恬之罪也。」乃吞藥自殺。","mention_ids":["c-shiji-088-mengtian:m010-0328"]},{"chapter_id":"c-shiji-087-lisi","source_id":"s-shiji-087-lisi","paragraph_id":"c-shiji-087-lisi:p030","quote":"趙高案治李斯。李斯拘執束縛，居囹圄中，仰天而歎曰：「嗟乎，悲夫！不道之君，何可為計哉！昔者桀殺關龍逢，紂殺王子比干，吳王夫差殺伍子胥。此三臣者，豈不忠哉，然而不免於死，身死而所忠者非也。今吾智不及三子，而二世之無道過於桀、紂、夫差，吾以忠死，宜矣。且二世之治豈不亂哉！日者夷其兄弟而自立也，殺忠臣而貴賤人，作為阿房之宮，賦斂天下。吾非不諫也，而不吾聽也。凡古聖王，飲食有節，車器有數，宮室有度，出令造事，加費而無益於民利者禁，故能長久治安。今行逆於昆弟，不顧其咎；侵殺忠臣，不思其殃；大為宮室，厚賦天下，不愛其費：三者已行，天下不聽。今反者已有天下之半矣，而心尚未寤也，而以趙高為佐，吾必見寇至咸陽，麋鹿游於朝也。」","mention_ids":["c-shiji-087-lisi:m030-0047"]}],"rationale":"三篇均記桀殺關龍逢的故事，關鍵姓名與事件相同，接至較早既有ID。 本次以各篇既有提及為證，保留原文異稱；屬AI暫定身份整理，非各篇彼此獨立的歷史見證。","reviewer":"Codex（AI代理）","human_reviewed":false,"identity_materialized":true}],"passages":[{"id":"c-shiji-087-lisi:p030","text":"趙高案治李斯。李斯拘執束縛，居囹圄中，仰天而歎曰：「嗟乎，悲夫！不道之君，何可為計哉！昔者桀殺關龍逢，紂殺王子比干，吳王夫差殺伍子胥。此三臣者，豈不忠哉，然而不免於死，身死而所忠者非也。今吾智不及三子，而二世之無道過於桀、紂、夫差，吾以忠死，宜矣。且二世之治豈不亂哉！日者夷其兄弟而自立也，殺忠臣而貴賤人，作為阿房之宮，賦斂天下。吾非不諫也，而不吾聽也。凡古聖王，飲食有節，車器有數，宮室有度，出令造事，加費而無益於民利者禁，故能長久治安。今行逆於昆弟，不顧其咎；侵殺忠臣，不思其殃；大為宮室，厚賦天下，不愛其費：三者已行，天下不聽。今反者已有天下之半矣，而心尚未寤也，而以趙高為佐，吾必見寇至咸陽，麋鹿游於朝也。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-087-lisi:m030-0000","start":0,"end":2,"surface":"趙高","kind":"person","person_id":"0xx_ozc_454","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m030-0004","start":4,"end":6,"surface":"李斯","kind":"person","person_id":"49g_7az_e4i","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m030-0007","start":7,"end":9,"surface":"李斯","kind":"person","person_id":"49g_7az_e4i","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m030-0045","start":45,"end":46,"surface":"