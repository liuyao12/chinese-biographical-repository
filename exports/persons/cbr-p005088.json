{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p005088","identity_policy":"contextual_provisional","person_ids":["cbr-p005088"],"persons":[{"id":"cbr-p005088","label":"太宰未名（黥布列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"太宰","mention_ids":["c-shiji-091-qingbu:m007-0124","c-shiji-091-qingbu:m007-0139","c-shiji-091-qingbu:m007-0218"]}],"evidence":[{"mention_id":"c-shiji-091-qingbu:m007-0124","chapter_id":"c-shiji-091-qingbu","paragraph_id":"c-shiji-091-qingbu:p007","quote":"太宰"},{"mention_id":"c-shiji-091-qingbu:m007-0139","chapter_id":"c-shiji-091-qingbu","paragraph_id":"c-shiji-091-qingbu:p007","quote":"太宰"},{"mention_id":"c-shiji-091-qingbu:m007-0218","chapter_id":"c-shiji-091-qingbu","paragraph_id":"c-shiji-091-qingbu:p007","quote":"太宰"}]}],"source_mention_summary":[{"source_id":"s-shiji-091-qingbu","work_id":"w-shiji","book_id":"b-shiji-091","chapter_id":"c-shiji-091-qingbu","mention_count":3,"mention_ids":["c-shiji-091-qingbu:m007-0124","c-shiji-091-qingbu:m007-0139","c-shiji-091-qingbu:m007-0218"],"paragraph_ids":["c-shiji-091-qingbu:p007"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-091-qingbu"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-091-qingbu:m007-0124","start":124,"end":126,"surface":"太宰","kind":"person","person_id":"cbr-p005088","status":"contextual_provisional","paragraph_id":"c-shiji-091-qingbu:p007","chapter_id":"c-shiji-091-qingbu"},{"id":"c-shiji-091-qingbu:m007-0139","start":139,"end":141,"surface":"太宰","kind":"person","person_id":"cbr-p005088","status":"contextual_provisional","paragraph_id":"c-shiji-091-qingbu:p007","chapter_id":"c-shiji-091-qingbu"},{"id":"c-shiji-091-qingbu:m007-0218","start":218,"end":220,"surface":"太宰","kind":"person","person_id":"cbr-p005088","status":"contextual_provisional","paragraph_id":"c-shiji-091-qingbu:p007","chapter_id":"c-shiji-091-qingbu"}],"relations":[],"title_holdings":[{"id":"th-shiji091-011","person_id":"cbr-p005088","title":"太宰","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-091-qingbu","source_id":"s-shiji-091-qingbu","paragraph_id":"c-shiji-091-qingbu:p007","quote":"漢三年，漢王擊楚，大戰彭城，不利，出梁地，至虞，謂左右曰：「如彼等者，無足與計天下事。」謁者隨何進曰：「不審陛下所謂。」漢王曰：「孰能為我使淮南，令之發兵倍楚，留項王於齊數月，我之取天下可以百全。」隨何曰：「臣請使之。」乃與二十人俱，使淮南。至，因太宰主之，三日不得見。隨何因說太宰曰：「王之不見何，必以楚為彊，以漢為弱，此臣之所以為使。使何得見，言之而是邪，是大王所欲聞也；言之而非邪，使何等二十人伏斧質淮南市，以明王倍漢而與楚也。」太宰乃言之王，王見之。隨何曰：「漢王使臣敬進書大王御者，竊怪大王與楚何親也。」淮南王曰：「寡人北鄉而臣事之。」隨何曰：「大王與項王俱列為諸侯，北鄉而臣事之，必以楚為彊，可以讬國也。項王伐齊，身負板筑，以為士卒先，大王宜悉淮南之眾，身自將之，為楚軍前鋒，今乃發四千人以助楚。夫北面而臣事人者，固若是乎？夫漢王戰於彭城，項王未出齊也，大王宜騷淮南之兵渡淮，日夜會戰彭城下，大王撫萬人之眾，無一人渡淮者，垂拱而觀其孰勝。夫讬國於人者，固若是乎？大王提空名以鄉楚，而欲厚自讬，臣竊為大王不取也。然而大王不背楚者，以漢為弱也。夫楚兵雖彊，天下負之以不義之名，以其背盟約而殺義帝也。然而楚王恃戰勝自彊，漢王收諸侯，還守成皋、滎陽，下蜀、漢之粟，深溝壁壘，分卒守徼乘塞，楚人還兵，閒以梁地，深入敵國八九百里，欲戰則不得，攻城則力不能，老弱轉糧千里之外；楚兵至滎陽、成皋，漢堅守而不動，進則不得攻，退則不得解。故曰楚兵不足恃也。使楚勝漢，則諸侯自危懼而相救。夫楚之彊，適足以致天下之兵耳。故楚不如漢，其勢易見也。今大王不與萬全之漢而自讬於危亡之楚，臣竊為大王惑之。臣非以淮南之兵足以亡楚也。夫大王發兵而倍楚，項王必留；留數月，漢之取天下可以萬全。臣請與大王提劍而歸漢，漢王必裂地而封大王，又況淮南，淮南必大王有也。故漢王敬使使臣進愚計，願大王之留意也。」淮南王曰：「請奉命。」陰許畔楚與漢，未敢泄也。"}],"attestations":[{"id":"th-shiji091-011:a001","paragraph_id":"c-shiji-091-qingbu:p007","start":124,"end":126,"surface":"太宰","person_mention_id":"c-shiji-091-qingbu:m007-0124","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予與用稱分存；常冠軍不作官名，欲為帝不作即帝位，稱病反楚死亡不補官爵終期。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji091-029","person_id":"cbr-p005088","scope":"same_chapter","chapter_ids":["c-shiji-091-qingbu"],"status":"contextual_provisional","rationale":"按本段明示姓名及局部敘事承接；布與兩王號按英布主線暫接。番君與長沙哀王分候選，所幸姬不與番君女合併；皋陶引古疑問不作祖先定論。","reviewer":"Codex（AI 代理）","surfaces":["太宰"],"evidence"