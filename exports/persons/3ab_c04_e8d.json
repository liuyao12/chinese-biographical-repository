ntion_ids":["c-jinshu-037-phase5-pengcheng:line100:m0146"],"kind":"paragraph"}],"mention_count":2,"duplicate_mention_count":0,"paragraph_occurrence_count":2,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"2處獨立位置，2個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"},{"source_id":"s-jinshu-034-ws2567662-yanghu","work_id":"w-jinshu","book_id":"b-jinshu-034","chapter_id":"c-jinshu-034-yanghu","raw_mention_count":1,"mention_ids":["c-jinshu-034-yanghu:p039:m0167"],"paragraph_ids":["c-jinshu-034-yanghu:p039"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-034-yanghu:p039:m0167","mention_ids":["c-jinshu-034-yanghu:p039:m0167"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-037-phase5"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-034-yanghu:p039:m0167","start":167,"end":169,"surface":"淮南","kind":"person","person_id":"3ab_c04_e8d","status":"source_explicit","paragraph_id":"c-jinshu-034-yanghu:p039","chapter_id":"c-jinshu-034-yanghu"},{"id":"c-jinshu-037-phase5-pengcheng:line100:m0131","start":131,"end":135,"surface":"淮南王允","kind":"person","person_id":"3ab_c04_e8d","paragraph_id":"c-jinshu-037-phase5-pengcheng:line100","chapter_id":"c-jinshu-037-phase5-pengcheng"},{"id":"c-jinshu-037-phase5-pengcheng:line100:m0146","start":146,"end":147,"surface":"允","kind":"person","person_id":"3ab_c04_e8d","paragraph_id":"c-jinshu-037-phase5-pengcheng:line100","chapter_id":"c-jinshu-037-phase5-pengcheng"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-phase5-037-允","person_id":"3ab_c04_e8d","surfaces":["允","淮南王允"],"scope":"same_chapter","chapter_ids":["c-jinshu-037-phase5-pengcheng"],"status":"contextual_provisional","confidence_level":"moderate","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-037","source_id":"s-jinshu-037-phase5","chapter_id":"c-jinshu-037-phase5-pengcheng","paragraph_id":"c-jinshu-037-phase5-pengcheng:line100","quote":"彭城穆王權，字子輿，宣帝弟魏魯相東武城侯馗之子也。初襲封，拜冗從僕射。武帝受禪，封彭城王，邑二千九百戶。出為北中郎將、都督鄴城守諸軍事。泰始中入朝，賜袞冕之服。咸甯元年薨，子元王植立。歷位後將軍，尋拜國子祭酒、太僕卿、侍中、尚書。出為安東將軍、都督揚州諸軍事，代淮南王允鎮壽春，未發。或云植助允攻趙王倫，遂以憂薨。贈車騎將軍，增封萬五千戶。子康王釋立，官至南中郎將、持節、平南將軍，分魯國蕃、薛二縣以益其國，心二萬三千戶。薨，子雄立，坐奔蘇峻伏誅，更以釋子紘嗣。","person_mention_id":"c-jinshu-037-phase5-pengcheng:line100:m0131"},{"work_id":"w-jinshu","book_id":"b-jinshu-037","source_id":"s-jinshu-037-phase5","chapter_id":"c-jinshu-037-phase5-pengcheng","paragraph_id":"c-jinshu-037-phase5-pengcheng:line100","quote":"彭城穆王權，字子輿，宣帝弟魏魯相東武城侯馗之子也。初襲封，拜冗從僕射。武帝受禪，封彭城王，邑二千九百戶。出為北中郎將、都督鄴城守諸軍事。泰始中入朝，賜袞冕之服。咸甯元年薨，子元王植立。歷位後將軍，尋拜國子祭酒、太僕卿、侍中、尚書。出為安東將軍、都督揚州諸軍事，代淮南王允鎮壽春，未發。或云植助允攻趙王倫，遂以憂薨。贈車騎將軍，增封萬五千戶。子康王釋立，官至南中郎將、持節、平南將軍，分魯國蕃、薛二縣以益其國，心二萬三千戶。薨，子雄立，坐奔蘇峻伏誅，更以釋子紘嗣。","person_mention_id":"c-jinshu-037-phase5-pengcheng:line100:m0146"}],"rationale":"依完整同段主語、親屬及事件辨識短稱；已有人物須同一蘇峻亂、彭城王系或相同君主脈絡，不以同名合併。馗、權、植、釋的局部父系獨立於馗接防的跨篇推論。","references":[],"reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-034-yanghu:p039","text":"孝武太元中，封祜兄玄孫之子法興為钜平侯，邑五千戶。以桓玄党誅，國除。尚書祠部郎荀伯子上表訟之曰：「臣聞咎繇亡嗣，臧文以為深歎；伯氏奪邑，管仲所以稱仁。功高可百世不泯，濫賞無得崇朝。故太傅、钜平侯羊祜明德通賢，國之宗主，勳參佐命，功成平吳，而後嗣闕然，烝嘗莫寄。漢以蕭何元功，故絕世輒繼，愚謂钜平封宜同酂國。故太尉廣陵公准黨翼賊倫，禍加淮南，因逆為利，竊饗大邦。值西朝政刑失裁，中興因而不奪。今王道維新，豈可不大判臧否，謂廣陵國宜在削除。故太保衛瓘本爵菑陽縣公，既被橫害，乃進茅土，始贈蘭陵，又轉江夏。中朝名臣，多非理終，瓘功德無殊，而獨受偏賞，謂宜罷其郡封，復邑菑陽，則與奪有倫，善惡分矣。」竟寢不報。","text_layer":"received_chapter","source_position":{"raw_start":6337,"raw_end":6640,"raw_character_offsets":[6339,6340,6341,6342,6343,6344,6345,6346,6347,6348,6349,6350,6351,6352,6353,6354,6355,6356,6357,6358,6359,6360,6361,6362,6363,6364,6365,6366,6367,6368,6369,6370,6371,6372,6373,6374,6375,6376,6377,6378,6379,6380,6381,6382,6383,6384,6385,6386,6387,6388,6389,6390,6391,6392,6393,6394,6395,6396,6397,6398,6399,6400,6401,6402,6403,6404,6405,6406,6407,6408,6409,6410,6411,6412,6413,6414,6415,6416,6417,6418,6419,6420,6421,6422,6423,6424,6425,6426,6427,6428,6429,6430,6431,6432,6433,6434,6435,6436,6437,6438,6439,6440,6441,6442,6443,6444,6445,6446,6447,6448,6449,6450,6451,6452,6453,6454,6455,6456,6457,6458,6459,6460,6461,6462,6463,6464,6465,6466,6467,6468,6469,6470,6471,6472,6473,6474,6475,6476,6477,6478,6479,6480,6481,6482,6483,6484,6485,6486,6487,6488,6489,6490,6491,6492,6493,6494,6495,6496,6497,6498,6499,6500,6501,6502,6503,6504,6505,6506,6507,6508,6509,6510,6511,6512,6513,6514,6515,6516,6517,6518,6519,6520,6521,6522,6523,6524,6525,6526,6527,6528,6529,6530,6531,6532,6533,6534,6535,6536,6537,6538,6539,6540,6541,6542,6543,6544,6545,6546,6547,6548,6549,6550,6551,6552,6553,6554,6555,6556,6557,6558,6559,6560,6561,6562,6563,6564,6565,6566,6567,6568,6569,6570,6571,6572,6573,6574,6575,6576,6577,6578,6579,6580,6581,6582,6583,6584,6585,6586,6587,6588,6589,6590,6591,6592,6593,6594,6595,6596,6597,6598,6599,6600,6601,6602,6603,6604,6605,6606,6607,6608,6609,6610,6611,6612,6613,6614,6615,6616,6617,6618,6619,6620,6621,6622,6623,6624,6625,6626,6627,6628,6629,6630,6631,6632,6633,6634,6635,6636,6637,6638,6639],"first_line":81,"last_line":81,"revision_id":