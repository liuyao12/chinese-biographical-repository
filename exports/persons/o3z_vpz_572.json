usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-047","chapter_id":"c-songshu-047-liujingxuan","source_id":"s-songshu-047-liujingxuan-ws2190557","paragraph_id":"c-songshu-047-liujingxuan:p012","quote":"假敬宣節，監征蜀諸軍事，郡如故。既入峽，分遣振武將軍、巴東太守溫祚以二千人揚聲外水，自率益州刺史鮑陋、輔國將軍文處茂、龍驤將軍時延祖由墊江而進。敬宣率先士卒，轉戰而前，達遂寧郡之黃虎，去成都五百里。偽輔國將軍譙道福等悉眾距險，相持六十餘日，大小十餘戰，賊固守不敢出。敬宣不得進，食糧盡，軍中多疾疫，死者太半，引軍還。譙縱送毛璩一門諸喪，其妻女、文處茂母何，并諸士人喪柩，浮之中流，敬宣皆拯接致歸。為有司所奏，免官，削封三分之一。","person_mention_id":"c-songshu-047-liujingxuan:p012:m0104"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-074-huan-family:p039","text":"及桓振作亂，謙保護乘輿，頗有功焉。然而暗懦，尤不可以造事。初，勸振率軍下戰，己守江陵。振既輕謙用事，故不從。及振敗，謙奔于姚興。先是，譙縱稱籓于姚興，縱與盧循通使，潛相影響，乃表興請謙共順流東下。興問謙，謙曰：「臣門著恩荊楚，從弟玄末雖篡位，皆是逼迫，人神所明。今臣與縱東下，百姓自應駭動。」興曰：「小水不容大舟，若縱才力足以濟事，亦不假君為鱗翼。宜自求多福。」遂遣之。謙至蜀，欲虛懷引士，縱疑之，乃置謙于龍格，使人守之。謙向諸弟泣曰：「姚主言神矣！」後與縱引譙道福俱下，謙於道占募，百姓感沖遺惠，投者二萬人。劉道規破謙，斬之。","source_position":{"kind":"wikitext_codepoint_positions","raw_path":"sources/jinshu/wikisource-1536331-raw.wikitext","raw_start":8821,"raw_end":9087,"character_positions":[8823,8824,8825,8826,8827,8828,8829,8830,8831,8832,8833,8834,8835,8836,8837,8838,8839,8840,8841,8842,8843,8844,8845,8846,8847,8848,8849,8850,8851,8852,8853,8854,8855,8856,8857,8858,8859,8860,8861,8862,8863,8864,8865,8866,8867,8868,8869,8870,8871,8872,8873,8874,8875,8876,8877,8878,8879,8880,8881,8882,8883,8884,8885,8886,8887,8888,8889,8890,8891,8892,8893,8894,8895,8896,8897,8898,8899,8900,8901,8902,8903,8904,8905,8906,8907,8908,8909,8910,8911,8912,8913,8914,8915,8916,8917,8918,8919,8920,8921,8922,8923,