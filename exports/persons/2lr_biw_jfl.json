{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"2lr_biw_jfl","canonical_person_id":"2lr_biw_jfl","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["2lr_biw_jfl"],"persons":[{"id":"2lr_biw_jfl","label":"柳昕（江州中兵）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"柳昕","mention_ids":["c-liangshu-043-weican:p002:m0343"]}],"evidence":[{"mention_id":"c-liangshu-043-weican:p002:m0343","paragraph_id":"c-liangshu-043-weican:p002","chapter_id":"c-liangshu-043-weican","quote":"柳昕"}],"review":"ai_provisional","identity_note":"柳昕（江州中兵），按所屬部伍、青塘及赴援敘事定。"}],"source_mention_summary":[{"source_id":"s-liangshu-043-weican-ws2087360","work_id":"w-liangshu","book_id":"b-liangshu-043","chapter_id":"c-liangshu-043-weican","raw_mention_count":1,"mention_ids":["c-liangshu-043-weican:p002:m0343"],"paragraph_ids":["c-liangshu-043-weican:p002"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-liangshu-043-weican:p002:m0343","mention_ids":["c-liangshu-043-weican:p002:m0343"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-liangshu-043-weican-ws2087360"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-liangshu-043-weican:p002:m0343","start":343,"end":345,"surface":"柳昕","kind":"person","person_id":"2lr_biw_jfl","status":"contextual_provisional","paragraph_id":"c-liangshu-043-weican:p002","chapter_id":"c-liangshu-043-weican"}],"relations":[],"title_holdings":[{"id":"th-liangshu-043-weican-2-341","title":"中兵","kind":"office","mode":"attestation","person_id":"2lr_biw_jfl","attestations":[{"id":"th-liangshu-043-weican-2-341:a","paragraph_id":"c-liangshu-043-weican:p002","start":341,"end":343,"surface":"中兵","person_mention_id":"c-liangshu-043-weican:p002:m0343","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-043","chapter_id":"c-liangshu-043-weican","source_id":"s-liangshu-043-weican-ws2087360","paragraph_id":"c-liangshu-043-weican:p002","quote":"中大同十一年，遷通直散騎常侍，未拜，出爲持節、督衡州諸軍事、安遠將軍、衡州刺史。皇太子出餞新亭，執粲手曰：「與卿不爲久別。」太清元年，粲至州無幾，便表解職。二年，徵爲散騎常侍。粲還至廬陵，聞侯景作逆，便簡閱部下，得精卒五千，馬百匹，倍道赴援。至豫章，奉命報云「賊已出橫江」，粲卽就內史劉孝儀共謀之。孝儀曰：「必期如此，當有別敕。豈可輕信單使，妄相驚動，或恐不然。」時孝儀置酒，粲怒，以杯抵地曰：「賊已渡江，便逼宮闕，水陸俱斷，何暇有報；假令無敕，豈得自安？韋粲今日何情飲酒！」卽馳馬出，部分將發，會江州刺史當陽公大心遣使要粲，粲乃馳往見大心曰：「上游蕃鎮，江州去京最近，殿下情計，實宜在前；但中流任重，當須應接，不可闕鎮。今直且張聲勢，移鎮湓城，遣偏將賜隨，於事便足。」大心然之，遣中兵柳昕帥兵二千人隨粲。粲悉留家累於江州，以輕舸就路。至南州，粲外弟司州刺史柳仲禮亦帥步騎萬餘人至橫江，粲卽送糧仗贍給之，並散私金帛以賞其戰士。","person_mention_id":"c-liangshu-043-weican:p002:m0343"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-043-weican:p002","text":"中大同十一年，遷通直散騎常侍，未拜，出爲持節、督衡州諸軍事、安遠將軍、衡州刺史。皇太子出餞新亭，執粲手曰：「與卿不爲久別。」太清元年，粲至州無幾，便表解職。二年，徵爲散騎常侍。粲還至廬陵，聞侯景作逆，便簡閱部下，得精卒五千，馬百匹，倍道赴援。至豫章，奉命報云「賊已出橫江