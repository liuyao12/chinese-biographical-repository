icy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-110-xiongnu:m047-0002","start":2,"end":4,"surface":"楊信","kind":"person","person_id":"rk6_uic_hnm","status":"contextual_provisional","paragraph_id":"c-shiji-110-xiongnu:p047","chapter_id":"c-shiji-110-xiongnu"},{"id":"c-shiji-110-xiongnu:m047-0112","start":112,"end":114,"surface":"楊信","kind":"person","person_id":"rk6_uic_hnm","status":"contextual_provisional","paragraph_id":"c-shiji-110-xiongnu:p047","chapter_id":"c-shiji-110-xiongnu"},{"id":"c-shiji-110-xiongnu:m047-0150","start":150,"end":152,"surface":"楊信","kind":"person","person_id":"rk6_uic_hnm","status":"contextual_provisional","paragraph_id":"c-shiji-110-xiongnu:p047","chapter_id":"c-shiji-110-xiongnu"},{"id":"c-shiji-110-xiongnu:m047-0153","start":153,"end":155,"surface":"楊信","kind":"person","person_id":"rk6_uic_hnm","status":"contextual_provisional","paragraph_id":"c-shiji-110-xiongnu:p047","chapter_id":"c-shiji-110-xiongnu"},{"id":"c-shiji-110-xiongnu:m048-0000","start":0,"end":2,"surface":"楊信","kind":"person","person_id":"rk6_uic_hnm","status":"contextual_provisional","paragraph_id":"c-shiji-110-xiongnu:p048","chapter_id":"c-shiji-110-xiongnu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-110-xiongnu:p047","text":"漢使楊信於匈奴。是時漢東拔穢貉、朝鮮以爲郡，而西置酒泉郡以鬲絕胡與羌通之路。漢又西通月氏、大夏，又以公主妻烏孫王，以分匈奴西方之援國。又北益廣田至胘雷爲塞，而匈奴終不敢以爲言。是歳，翕侯信死，漢用事者以匈奴爲已弱，可臣從也。楊信爲人剛直屈彊，素非貴臣，單于不親。單于欲召入，不肯去節，單于乃坐穹廬外見楊信。楊信既見單于，說曰：「即欲和親，以單于太子爲質於漢。」單于曰：「非故約。故約，漢常遣翁主，給繒絮食物有品，以和親，而匈奴亦不擾邊。今乃欲反古，令吾太子爲質，無幾矣。」匈奴俗，見漢使非中貴人，其儒先，以爲欲說，折其辯；其少年，以爲欲刺，折其氣。每漢使入匈奴，匈奴輒報償。漢留匈奴使，匈奴亦留漢使，必得當乃肯止。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-110-xiongnu:m047-0002","start":2,"end":4,"surface":"楊信","kind":"person","person_id":"rk6_uic_hnm","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m047-0050","start":50,"end":52,"surface":"公主","kind":"person","person_id":"s79_jb8_yix","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m047-0053","start":53,"end":56,"surface":"烏孫王","kind":"person","person_id":"k8g_wo9_ejj","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m047-0091","start":91,"end":94,"surface":"翕侯信","kind":"person","person_id":"mfr_nye_lnv","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m047-0096","start":96,"end":100,"surface":"漢用事者","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-110-xiongnu:m047-0112","start":112,"end":114,"surface":"楊信","kind":"person","person_id":"rk6_uic_hnm","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m047-0126","start":126,"end":128,"surface":"單于","kind":"person","person_id":"wjt_htu_081_AABA","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m047-0131","start":131,"end":133,"surface":"單于","kind":"person","person_id":"wjt_htu_081_AABA","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m047-0142","start":142,"end":144,"surface":"單于","kind":"person","person_id":"wjt_htu_081_AABA","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m047-0150","start":150,"end":152,"surface":"楊信","kind":"person","person_id":"rk6_uic_hnm","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m047-0153","start":153,"end":155,"surface":"楊信","kind":"person","person_id":"rk6_uic_hnm","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m047-0157","start":157,"end":159,"surface":"單于","kind":"person","person_id":"wjt_htu_081_AABA","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m047-0170","start":170,"end":172,"surface":"單于","kind":"person","person_id":"wjt_htu_081_AABA","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m047-0172","start":172,"end":174,"surface":"太子","kind":"person","person_id":"l05_5gh_nen","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m047-0180","start":180,"end":182,"surface":"單于","kind":"person","person_id":"wjt_htu_081_AABA","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m047-0195","start":195,"end":197,"surface":"翁主","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-110-xiongnu:m047-0225","start":225,"end":226,"surface":"吾","kind":"person","person_id":"wjt_htu_081_AABA","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m047-0226","start":226,"end":228,"surface":"太子","kind":"person","person_id":"l05_5gh_nen","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m047-0241","start":241,"end":243,"surface":"漢使","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-110-xiongnu:m047-0248","start":248,"end":251,"surface":"其儒先","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-110-xiongnu:m047-0261","start":261,"end":264,"surface":"其少年","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-110-xiongnu:m047-0275","start":275,"end":277,"surface":"漢使","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-110-xiongnu:m047-0289","start":289,"end":292,"surface":"匈奴使","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-110-xiongnu:m047-0297","start":297,"end":299,"surface":"漢使","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-110-xiongnu","book_id":"b-shiji-110","work_id":"w-shiji","source_id":"s-shiji110-xiongnu"},{"id":"c-shiji-110-xiongnu:p048","text":"楊信既歸，漢使王烏，而單于復肴甘言，欲多得漢財物，紿謂王烏曰：「吾欲入漢見天子，面相約爲兄弟。」王烏歸報漢，漢爲單于築邸于長安。匈奴曰：「非得漢貴人使，吾不與誠語。」匈奴使其貴人至漢，病，漢予藥，欲愈之，不幸而死。而漢使路充國佩二千石印綬往使，因送其喪，厚葬直數千金，曰「此漢貴人也」。單于以爲漢殺吾貴使者，乃留路充國不歸。諸所言者，單于特空紿王烏，殊無意入漢及遣太子來質。於是匈奴數使奇兵侵犯邊。漢乃拜郭昌爲拔胡將軍，及浞野侯屯朔方以東，備胡。路充國留匈奴三歳，單于死。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-110-xiongnu:m048-0