d":"person","status":"contextual_provisional"},{"id":"c-jinshu-070-ganzhuo:p006:m0561","surface":"竇融","start":561,"end":563,"person_id":"uoo_3lo_4z0","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-070-ganzhuo:p006:m0610","surface":"劉隗","start":610,"end":612,"person_id":"hnd_3at_h4i","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-070-ganzhuo:p006:m0777","surface":"王含","start":777,"end":779,"person_id":"mwc_md4_l0g","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-070-ganzhuo:p006:m0840","surface":"呂蒙","start":840,"end":842,"person_id":"ibt_i7u_ykp","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-070-ganzhuo","book_id":"b-jinshu-070","work_id":"w-jinshu","source_id":"s-jinshu-070-ganzhuo-ws2595540"},{"id":"c-jinshu-070-ganzhuo:p007","text":"時敦以卓不至，慮在後爲變，遣參軍樂道融苦要卓俱下。道融本欲背敦，因說卓襲之，語在融傳。卓既素不欲從敦，得道融說，遂決曰：「吾本意也。」乃與巴東監軍柳純、南平太守夏侯承、宜都太守譚該等十餘人，俱露檄遠近，陳敦肆逆，率所統致討。遣參軍司馬讚、孫雙奉表詣臺，參軍羅英至廣州，與陶侃剋期，參軍鄧騫、虞沖至長沙，令譙王承堅守。征西將軍戴若思在江西，先得卓書，表上之，臺內皆稱萬歲。武昌大驚，傳卓軍至，人皆奔散。詔書遷卓爲鎮南大將軍、侍中、都督荊梁二州諸軍事、荊州牧，梁州刺史如故，陶侃得卓信，即遣參軍高寶率兵下。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":48,"last_line":48,"raw_start":4516,"raw_end":4774,"raw_character_offsets":[4523,4524,4525,4526,4527,4528,4529,4530,4531,4532,4533,4534,4535,4536,4537,4538,4539,4540,4541,4542,4543,4544,4545,4546,4547,4548,4549,4550,4551,4552,4553,4554,4555,4556,4557,4558,4559,4560,4561,4562,4563,4564,4565,4566,4567,4568,4569,4570,4571,4572,4573,4574,4575,4576,4577,4578,4579,4580,4581,4582,4583,4584,4585,4586,4587,4588,4589,4590,4591,4592,4593,4594,4595,4596,4597,4598,4599,4600,4601,4602,4603,4604,4605,4606,4607,4608,4609,4610,4611,4612,4613,4614,4615,4616,4617,4618,4619,4620,4621,4622,4623,4624,4625,4626,4627,4628,4629,4630,4631,4632,4633,4634,4635,4636,4637,4638,4639,4640,4641,4642,4643,4644,4645,4646,4647,4648,4649,4650,4651,4652,4653,4654,4655,4656,4657,4658,4659,4660,4661,4662,4663,4664,4665,4666,4667,4668,4669,4670,467