":147,"person_id":"3bh_t2o_44m","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-070-ganzhuo:p007:m0154","surface":"承","start":154,"end":155,"person_id":"upd_apd_zqr","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-070-ganzhuo:p007:m0162","surface":"戴若思","start":162,"end":165,"person_id":"d9d_ab2_a72","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-070-ganzhuo:p007:m0235","surface":"陶侃","start":235,"end":237,"person_id":"twd_erg_kmz","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-070-ganzhuo:p007:m0245","surface":"高寶","start":245,"end":247,"person_id":"6va_8n3_ouw","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-070-ganzhuo","book_id":"b-jinshu-070","work_id":"w-jinshu","source_id":"s-jinshu-070-ganzhuo-ws2595540"},{"id":"c-jinshu-098-jin033-wangji:line031","text":"初，敦務自矯厲，雅尚清談，口不言財色。既素有重名，又立大功于江左，專任閫外，手控強兵，群從貴顯，威權莫貳，遂欲專制朝廷，有問鼎之心。帝畏而惡之，遂引劉隗、刁協等以為心膂。敦益不能平，於是嫌隙始構矣。每酒後輒詠魏武帝樂府歌曰：「老驥伏櫪，志在千里。烈士暮年，壯心不已。」以如意打唾壺為節，壺邊盡缺。及湘州刺史甘卓遷梁州，敦欲以從事中郎陳頒代卓，帝不從，更以譙王承鎮湘州。敦復上表陳古今忠臣見疑于君，而蒼蠅之人交構其間，欲以感動天子。帝愈忌憚之。俄加敦羽葆鼓吹，增從事中郎、掾屬、舍人各二人。帝以劉隗為鎮北將軍，戴若思為征西將軍，悉發揚州奴為兵，外以討胡，實禦敦也。永昌元年，敦率眾內向，以誅隗為名，上疏曰：","annotation_status":"reviewed","text_layer":"received_chapter","mentions":[{"id":"c-jinshu-098-jin033-wangji:line031:m0002","start":2,"end":3,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line031:m0074","start":74,"end":76,"surface":"劉隗","kind":"person","person_id":"hnd_3at_h4i","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line031:m0077","start":77,"end":79,"surface":"刁協","kind":"person","person_id":"c20_ec4_36f","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line031:m0085","start":85,"end":86,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","int