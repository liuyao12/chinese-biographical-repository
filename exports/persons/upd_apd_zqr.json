person","status":"contextual_provisional","paragraph_id":"c-jinshu-070-ganzhuo:p007","chapter_id":"c-jinshu-070-ganzhuo"},{"id":"c-jinshu-098-jin033-wangji:line031:m0177","start":177,"end":180,"surface":"譙王承","kind":"person","person_id":"upd_apd_zqr","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line031","chapter_id":"c-jinshu-098-jin033-wangji"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-061-zhou-family:p015","text":"謨以顗故，頻居顯職。王敦死後，詔贈戴若思、譙王承等，而未及顗。時謨為後軍將軍，上疏曰：","source_position":{"raw_start":2760,"raw_end":2805,"raw_text":"　　謨以顗故，頻居顯職。王敦死後，詔贈戴若思、譙王承等，而未及顗。時謨為後軍將軍，上疏曰：","display_wrapper_start":0,"display_wrapper_end":0,"raw_path":"sources/jinshu/wikisource-7903772-raw.wikitext"},"mentions":[{"id":"c-jinshu-061-zhou-family:p015:m0000","start":0,"end":1,"surface":"謨","kind":"person","person_id":"3xx_gdy_or6_AAC","status":"contextual_provisional","interpretation_note":"061來源內明確人物：浚三子之一，奏稱亡兄顗，歷中護軍；獨立登記周謨。與069周穆的未決同指另存身份case，不因音近或阿奴合併。"},{"id":"c-jinshu-061-zhou-family:p015:m0002","start":2,"end":3,"surface":"顗","kind":"person","person_id":"3xx_gdy_or6_AAA","status":"contextual_provisional","interpretation_note":"069完整本傳明父浚、弟嵩、子閔，與061三代脈絡相合。"},{"id":"c-jinshu-061-zhou-family:p015:m0010","start":10,"end":12,"surface":"王敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p015:m0017","start":17,"end":20,"surface":"戴若思","kind":"person","person_id":"d9d_ab2_a72","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p015:m0021","start":21,"end":24,"surface":"譙王承","kind":"person","person_id":"upd_apd_zqr","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p015:m0029","start":29,"end":30,"surface":"顗","kind":"person","person_id":"3xx_gdy_or6_AAA","status":"contextual_provisional","interpretation_note":"069完整本傳明父浚、弟嵩、子閔，與061三代脈絡相合。"},{"id":"c-jinshu-061-zhou-family:p015:m0032","start":32,"end":33,"surface":"謨","kind":"person","person_id":"3xx_gdy_or6_AAC","status":"contextual_provisional","interpretation_note":"061來源內明確人物：浚三子之一，奏稱亡兄顗，歷中護軍；獨立登記周謨。與069周穆的未決同指另存身份case，不因音近或阿奴合併。"}],"annotation_status":"reviewed","chapter_id":"c-jinshu-061-zhou-family","book_id":"b-jinshu-061","work_id":"w-jinshu","source_id":"s-jinshu-061-ws7903772"},{"id":"c-jinshu-061-zhou-family:p017","text":"王敦無君，由來實久，元惡之甚，古今無二。幸賴陛下聖聰神武，故能摧破凶強，撥亂反正，以甯區宇。前軍事之際，聖恩不遺，取顗息閔，得充近侍。臣時面啟，欲令閔還襲臣亡父侯爵。時卞壼、庾亮並侍御坐，壼云：「事了當論顯贈。」時未淹久，言猶在耳。至於譙王承、甘卓，已蒙清復，王澄久遠，猶在論議。況顗忠以衛主，身死王事，雖嵇紹之不違難，何以過之！至今不聞復封加贈褒顯之言。不知顗有餘責，獨負殊恩，為朝廷急於時務，不暇論及？此臣所以痛心疾首，重用哀歎者也。不勝辛酸，冒陳愚款。","source_position":{"raw_start":2965,"raw_end":3198,"raw_text":"　　王敦無君，由來實久，元惡之甚，古今無二。幸賴陛下聖聰神武，故能摧破凶強，撥亂反正，以甯區宇。前軍事之際，聖恩不遺，取顗息閔，得充近侍。臣時面啟，欲令閔還襲臣亡父侯爵。時卞壼、庾亮並侍御坐，壼云：「事了當論顯贈。」時未淹久，言猶在耳。至於譙王承、甘卓，已蒙清復，王澄久遠，猶在論議。況顗忠以衛主，身死王事，雖嵇紹之不違難，何以過之！至今不聞復封加贈褒顯之言。不知顗有餘責，獨負殊恩，為朝廷急於時務，不暇論及？此臣所以痛心疾首，重用哀歎者也。不勝辛酸，冒陳愚款。}}","display_wrapper_start":0,"display_wrapper_end":2,"raw_path":"sources/jinshu/wikisource-7903772-raw.wikitext"},"mentions":[{"id":"c-jinshu-061-zhou-family:p017:m0000","start":0,"end":2,"surface":"王敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p017:m0022","start":22,"end":24,"surface":"陛下","kind":"person","person_id":"dkn_ge4_286_AAAAAAAA","status":"contextual_provisional","interpretation_note":"謨疏位於王敦死後；其陛下為明帝，先帝則元帝；不以最近帝字全篇套同人。"},{"id":"c-jinshu-061-zhou-family:p017:m0058","start":58,"end":59,"surface":"顗","kind":"person","person_id":"3xx_gdy_or6_AAA","status":"contextual_provisional","interpretation_note":"069完整本傳明父浚、弟嵩、子閔，與061三代脈絡相合。"},{"id":"c-jinshu-061-zhou-family: