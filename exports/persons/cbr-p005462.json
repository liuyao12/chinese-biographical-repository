end":64,"surface":"陳留令","kind":"person","person_id":"wfk_n4m_6x9","status":"contextual_provisional","paragraph_id":"c-shiji-097-luli:p023","chapter_id":"c-shiji-097-luli"},{"id":"c-shiji-097-luli:m023-0121","start":121,"end":124,"surface":"陳留令","kind":"person","person_id":"wfk_n4m_6x9","status":"contextual_provisional","paragraph_id":"c-shiji-097-luli:p023","chapter_id":"c-shiji-097-luli"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji097-025","person_id":"wfk_n4m_6x9","scope":"same_chapter","chapter_ids":["c-shiji-097-luli"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["陳留令"],"evidence":[{"paragraph_id":"c-shiji-097-luli:p023","quote":"於是酈生乃夜見陳留令，說之曰：「夫秦為無道而天下畔之，今足下與天下從則可以成大功。今獨為亡秦嬰城而堅守，臣竊為足下危之。」陳留令曰：「秦法至重也，不可以妄言，妄言者無類，吾不可以應。先生所以教臣者，非臣之意也，願勿復道。」酈生留宿臥，夜半時斬陳留令首，踰城而下報沛公。沛公引兵攻城，縣令首於長竿以示城上人，曰：「趣下，而令頭已斷矣！今後下者必先斬之！」於是陳留人見令已死，遂相率而下沛公。沛公舍陳留南城門上，因其庫兵，食積粟，留出入三月，從兵以萬數，遂入破秦。"}],"rationale":"按酈生、陸賈與朱建分傳及敘事承接限定異稱；尉他尉佗原字分存。平原君據明示朱建另候選；朱建兩處未名子尚不合併，淮陰侯與單稱韓信跨篇同指待證。引語古王及神話人物與當事人分開。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-097-luli:p023","text":"於是酈生乃夜見陳留令，說之曰：「夫秦為無道而天下畔之，今足下與天下從則可以成大功。今獨為亡秦嬰城而堅守，臣竊為足下危之。」陳留令曰：「秦法至重也，不可以妄言，妄言者無類，吾不可以應。先生所以教臣者，非臣之意也，願勿復道。」酈生留宿臥，夜半時斬陳留令首，踰城而下報沛公。沛公引兵攻城，縣令首於長竿以示城上人，曰：「趣下，而令頭已斷矣！今後下者必先斬之！」於是陳留人見令已死，遂相率而下沛公。沛公舍陳留南城門上，因其庫兵，食積粟，留出入三月，從兵以萬數，遂入破秦。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-097-luli:m023-0002","start":2,"end":4,"surface":"酈生","kind":"person","person_id":"exh_47e_0gw","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m023-0007","start":7,"end":10,"surface":"陳留令","kind":"person","person_id":"wfk_n4m_6x9","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m023-0061","start":61,"end":64,"surface":"陳留令","kind":"person","person_id":"wfk_n4m_6x9","status":"contextual_provisional"},{"id":"c