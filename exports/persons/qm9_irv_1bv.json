ds":["c-jinshu-066-taokan:p014"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-066-taokan:p014:m0113","mention_ids":["c-jinshu-066-taokan:p014:m0113"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-066-taokan-ws1527632"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-jinshu-066-taokan:kinship14-111","kind":"kinship","person_id":"qm9_irv_1bv","source_quote":"侃妻龔氏亦固勸自行","reading":"妻龔氏與前句所遣督護龔登各繫自身行事。","note":"妻龔氏與前句所遣督護龔登各繫自身行事。","paragraph_id":"c-jinshu-066-taokan:p014","start_codepoint":111,"end_codepoint":120,"human_reviewed":false,"chapter_id":"c-jinshu-066-taokan","source_id":"s-jinshu-066-taokan-ws1527632"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin066-gong-spouse","subject_person_id":"qm9_irv_1bv","object_person_id":"twd_erg_kmz","predicate":"spouse","qualifiers":{"source_term":"侃妻龔氏"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-066","chapter_id":"c-jinshu-066-taokan","source_id":"s-jinshu-066-taokan-ws1527632","paragraph_id":"c-jinshu-066-taokan:p014","quote":"暨蘇峻作逆，京都不守，侃子瞻為賊所害，平南將軍溫嶠要侃同赴朝廷。初，明帝崩，侃不在顧命之列，深以為恨，答嶠曰：「吾疆場外將，不敢越局。」嶠固請之，因推為盟主。侃乃遣督護龔登率眾赴嶠，而又追回。嶠以峻殺其子，重遣書以激怒之。侃妻龔氏亦固勸自行。於是便戎服登舟，星言兼邁，瞻喪至不臨。五月，與溫嶠、庾亮等俱會石頭。諸軍即欲決戰，侃以賊盛，不可爭鋒，當以歲月智計擒之。累戰無功，諸將請于查浦築壘。監軍部將李根建議，請立白石壘。侃不從，曰：「若壘不成，卿當坐之。」根曰：「查浦地下，又在水南，唯白石峻極險固，可容數千人，賊來攻不便，滅賊之術也。」侃笑曰：「卿良將也。」乃從根謀，夜修曉訖。賊見壘大驚。賊攻大業壘，侃將救之，長史殷羨曰：「若遣救大業，步戰不如峻，則大事去矣。但當急攻石頭，峻必救之，而大業自解。」侃又從羨言。峻果棄大業而救石頭。諸軍與峻戰陳陵東，侃督護竟陵太守李陽部將彭世斬峻於陣，賊眾大潰。峻弟逸復聚眾。侃與諸軍斬逸於石頭。","subject_person_mention_id":"c-jinshu-066-taokan:p014:m0113","object_person_mention_id":"c-jinshu-066-taokan:p014:m0011"}],"status":"source_attested","interpretation_note":"妻龔氏勸陶侃自往；龔登為另一人，無關係端點。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-066-taokan:p014:m0113","surface":"龔氏","start":113,"end":115,"person_id":"qm9_irv_1bv","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-066-taokan:p014","chapter_id":"c-jinshu-066-taokan"}],"relations":[{"id":"a-jin066-gong-spouse","subject_person_id":"qm9_irv_1bv","object_person_id":"twd_erg_kmz","predicate":"spouse","qualifiers":{"source_term":"侃妻龔氏"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-066","chapter_id":"c-jinshu-066-taokan","source_id":"s-jinshu-066-taokan-ws1527632","paragraph_id":"c-jinshu-066-taokan:p014","quote":"暨蘇峻作逆，京都不守，侃子瞻為賊所害，平南將軍溫嶠要侃同赴朝廷。初，明帝崩，侃不在顧命之列，深以為恨，答嶠曰：「吾疆場外將，不敢越局。」嶠固請之，因推為盟主。侃乃遣督護龔登率眾赴嶠，而又追回。嶠以峻殺其子，重遣書以激怒之。侃妻龔氏亦固勸自行。於是便戎服登舟，星言兼邁，瞻喪至不臨。五月，與溫嶠、庾亮等俱會石頭。諸軍即欲決戰，侃以賊盛，不可爭鋒，當以歲月智計擒之。累戰無功，諸將請于查浦築壘。監軍部將李根建議，請立白石壘。侃不從，曰：「若壘不成，卿當坐之。」根曰：「查浦地下，又在水南，唯白石峻極險固，可容數千人，賊來攻不便，滅賊之術也。」侃笑曰：「卿良將也。」乃從根謀，夜修曉訖。賊見壘大驚。賊攻大業壘，侃將救之，長史殷羨曰：「若遣救大業，步戰不如峻，則大事去矣。但當急攻石頭，峻必救之，而大業自解。」侃又從羨言。峻果棄大業而救石頭。諸軍與峻戰陳陵東，侃督護竟陵太守李陽部將彭世斬峻於陣，賊眾大潰。峻弟逸復聚眾。侃與諸軍斬逸於石頭。","subject_person_mention_id":"c-jinshu-066-taokan:p014:m0113","object_person_mention_id":"c-jinshu-066-taokan:p014:m0011"}],"status":"source_attested","interpretation_note":"妻龔氏勸陶侃自往；龔登為另一人，無關係端點。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity