{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004339","identity_policy":"contextual_provisional","person_ids":["cbr-p004339"],"persons":[{"id":"cbr-p004339","label":"韓昭侯（孟嘗君列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"韓昭侯","mention_ids":["c-shiji-075-mengchang:m001-0174"]}],"evidence":[{"mention_id":"c-shiji-075-mengchang:m001-0174","chapter_id":"c-shiji-075-mengchang","paragraph_id":"c-shiji-075-mengchang:p001","quote":"韓昭侯"}]}],"mentions":[{"id":"c-shiji-075-mengchang:m001-0174","start":174,"end":177,"surface":"韓昭侯","kind":"person","person_id":"cbr-p004339","status":"contextual_provisional","paragraph_id":"c-shiji-075-mengchang:p001","chapter_id":"c-shiji-075-mengchang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji075-010","person_id":"cbr-p004339","surfaces":["韓昭侯"],"scope":"same_chapter","chapter_ids":["c-shiji-075-mengchang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-075-mengchang:p001","quote":"孟嘗君名文，姓田氏。文之父曰靖郭君田嬰。田嬰者，齊威王少子而齊宣王庶弟也。田嬰自威王時任職用事，與成侯鄒忌及田忌將而救韓伐魏。成侯與田忌爭寵，成侯賣田忌。田忌懼，襲齊之邊邑，不勝，亡走。會威王卒，宣王立，知成侯賣田忌，乃復召田忌以爲將。宣王二年，田忌與孫臏、田嬰倶伐魏，敗之馬陵，虜魏太子申而殺魏將龐涓。宣王七年，田嬰使於韓、魏，韓、魏服於齊。嬰與韓昭侯、魏惠王會齊宣王東阿南，盟而去。明年，復與梁惠王會甄。是歳，梁惠王卒。宣王九年，田嬰相齊。齊宣王與魏襄王會徐州而相王也。楚威王聞之，怒田嬰。明年，楚伐敗齊師於徐州，而使人逐田嬰。田嬰使張丑説楚威王，威王乃止。田嬰相齊十一年，宣王卒，湣王即位。即位三年，而封田嬰於薛。"}],"rationale":"依前3段明示姓名與局部敘事暫接，孟嘗君名文、文父靖郭君田嬰及鄒忌成侯按本篇相配。齊威王用事與卒、楚威王受張丑說而止按局部敘事分辨，魏惠王與梁惠王暫留兩個候選待另存對應證據，不當確證不同人。孟嘗君母其賤妾其母回指按生文明示暫接，妾不作配偶主張；祖孫定義不補後裔，兄弟群體不補所屬。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-075-mengchang:p001","text":"孟嘗君名文，姓田氏。文之父曰靖郭君田嬰。田嬰者，齊威王少子而齊宣王庶弟也。田嬰自威王時任職用事，與成侯鄒忌及田忌將而救韓伐魏。成侯與田忌爭寵，成侯賣田忌。田忌懼，襲齊之邊邑，不勝，亡走。會威王卒，宣王立，知成侯賣田忌，乃復召田忌以爲將。宣王二年，田忌與孫臏、田嬰倶伐魏，敗之馬陵，虜魏太子申而殺魏將龐涓。宣王七年，田嬰使於韓、魏，韓、魏服於齊。嬰與韓昭侯、魏惠王會齊宣王東阿南，盟而去。明年，復與梁惠王會甄。是歳，梁惠王卒。宣王九年，田嬰相齊。齊宣王與魏襄王會徐州而相王也。楚威王聞之，怒田嬰。明年，楚伐敗齊師於徐州，而使人逐田嬰。田嬰使張丑説楚威王，威王乃止。田嬰相齊十一年，宣王卒，湣王即位。即位三年，而封田嬰於薛。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-075-mengchang:m001-0000","start":0,"end":3,"surface":"孟嘗君","kind":"person","person_id":"cbr-p004330","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m001-0004","start":4,"end":5,"surface":"文","kind":"person","person_id":"cbr-p004330","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m001-0007","start":7,"end":9,"surface":"田氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"姓氏形式、群體、未定親屬回指或祖孫定義對話，未作已知個別人物；母因兄弟未補兄弟所屬及成員，定義孫玄孫不補真實後裔。"},{"id":"c-shiji-075-mengchang:m001-0010","start":10,"end":11,"surface":"文","kind":"person","person_id":"cbr-p004330","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m001-0014","start":14,"end":19,"surface":"靖郭君田嬰","kind":"person","person_id":"cbr-p004331","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m001-0020","start":20,"end":22,"surface":"田嬰","kind":"person","person_id":"cbr-p004331","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m001-0024","start":24,"end":27,"surface":"齊威王","kind":"person","person_id":"cbr-p004332","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m001-0030","start":30,"end":33,"surface":"齊宣王","kind":"person","person_id":"cbr-p004333","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m001-0037","start":37,"end":39,"surface":"田嬰","kind":"person","person_id":"cbr-p004331","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m001-0040","start":40,"end":42,"surface":"威王","kind":"person","person_id":"cbr-p004332","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m001-0049","start":49,"end":53,"surface":"成侯鄒忌","kind":"person","person_id":"cbr-p004334","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m001-0054","start":54,"end":56,"surface":"田忌","kind":"person","person_id":"cbr-p004335","status":"contextual_provisional"},{"id":"c-shi