夢幻俄頃憂傷在念竟知無益思自袪遣尋理滌意即以任命為膏酥擥鏡照形翻以支離代萱樹故得仰慕徽猷永言前哲鬼谷深栖接輿高舉遁名屠肆發迹關市其人緬邈餘流可想若令亡者有知寧不縈悲玄壤悵隔芳塵如其逝者可作必當昭被光景懽同遊豫使夫一介老圃得簉虛心末席去日已疏來侍未孱連劍飛鳧擬非其類懷私茂德竊用涕零","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-liangshu-050-xiejiqing-family-intro-wyd:p004:m0023","start":23,"end":26,"surface":"庾仲容","person_id":"fem_1hn_uxl","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"},{"id":"c-liangshu-050-xiejiqing-family-intro-wyd:p004:u0029","start":29,"end":31,"surface":"二人","person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"幾卿與仲容並稱。"},{"id":"c-liangshu-050-xiejiqing-family-intro-wyd:p004:m0070","start":70,"end":72,"surface":"幾卿","person_id":"aa6_83c_juy_CDAABAB","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"},{"id":"c-liangshu-050-xiejiqing-family-intro-wyd:p004:m0295","start":295,"end":297,"surface":"鬼谷","person_id":"noa_3ci_b9s","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"},{"id":"c-liangshu-050-xiejiqing-family-intro-wyd:p004:m0299","start":299,"end":301,"surface":"接輿","person_id":"cyo_vyj_6o2","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"},{"id":"c-liangshu-050-xiejiqing-family-intro-wyd:p004:u0303","start":303,"end":307,"surface":"遁名屠肆","person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"隱於屠肆是人物典故，語中無名，另列可能原典。"},{"id":"c-liangshu-050-xiejiqing-family-intro-wyd:p004:u0307","start":307,"end":311,"surface":"發迹關市","person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"關市古例未具名。"}],"source_position":{"revision_id":"cbr-ai-transcription-sha256:fe27f7f79551ac89948ed19bb99252ef8e05cc5b72cd62907e1d87c4b78e3227","source_layer":"received_biography","column_projection":[{"pdf_page":58,"half":"左","leaf":"九上","column_from_right":8,"start":6,"end":21,"text":"居宅在白楊石井朝中交好者載酒從"},{"pdf_page":58,"half":"左","leaf":"九上","column_from_right":9,"start":0,"end":21,"text":"之賓客滿坐時左丞庾仲容亦免歸二人意志相得並"},{"pdf_page":58,"half":"左","leaf":"九上","column_from_right":10,"start":0,"end":21,"text":"肆情誕縱或乘露車歷遊郊野既醉則執鐸挽歌不屑"},{"pdf_page":59,"half":"右","leaf":"九下","column_from_right":1,"start":0,"end":21,"text":"物議湘東王在荊鎮與書慰勉之幾卿答曰下官自奉"},{"pdf_page":59,"half":"右","leaf":"九下","column_from_right":2,"start":0,"end":21,"text":"違南浦卷迹東郊望日臨風瞻言佇立仰尋惠渥陪奉"},{"pdf_page":59,"half":"右","leaf":"九下","column_from_right":3,"start":0,"end":21,"text":"遊宴漾桂棹於清池席落英於曾岨蘭香兼御羽觴競"},{"pdf_page":59,"half":"右","leaf":"九下","column_from_right":4,"start":0,"end":21,"text":"集側聽餘論沐浴玄流濤波之辯懸河不足譬春藻之"},{"pdf_page":59,"half":"右","leaf":"九下","column_from_right":5,"start":0,"end":21,"text":"辭麗文無以匹莫不相顧動容服心勝口不覺春日為"},{"pdf_page":59,"half":"右","leaf":"九下","column_from_right":6,"start":0,"end":21,"text":"遙更謂脩夜為促嘉會難常摶雲易遠言念如昨忽焉"},{"pdf_page":59,"half":"右","leaf":"九下","column_from_right":7,"start":0,"end":21,"text":"素秋恩光不遺善謔遠降因事罷歸豈云栖缺匪商官"},{"pdf_page":59,"half":"右","leaf":"九下","column_from_right":8,"start":0,"end":21,"text":"缺理就一廛田家作苦實符清誨本乏金羈之飾無假"},{"pdf_page":59,"half":"右","leaf":"九下","column_from_right":9,"start":0,"end":21,"text":"玉璧為資徒以老使形疏疾令心阻沉滯牀簟彌歷七"},{"pdf_page":59,"half":"右","leaf":"九下","column_from_right":10,"start":0,"end":21,"text":"旬夢幻俄頃憂傷在念竟知無益思自袪遣尋理滌意"},{"pdf_page":59,"half":"左","leaf":"十上","column_from_right":1,"start":0,"end":21,"text":"即以任命為膏酥擥鏡照形翻以支離代萱樹故得仰"},{"pdf_page":59,"half":"左","leaf":"十上","column_from_right":2,"start":0,"end":21,"text":"慕徽猷永言前哲鬼谷深栖接輿高舉遁名屠肆發迹"},{"pdf_page":59,"half":"左","leaf":"十上","column_from_right":3,"start":0,"end":21,"text":"關市其人緬邈餘流可想若令亡者有知寧不縈悲玄"},{"pdf_page":59,"half":"左","leaf":"十上","column_from_right":4,"start":0,"end":21,"text":"壤悵隔芳塵如其逝者可作必當昭被光景懽同遊豫"},{"pdf_page":59,"half":"左","leaf":"十上","column_from_right":5,"start":0,"end":21,"text":"使夫一介老圃得簉虛心末席去日已疏來侍未孱連"},{"pdf_page":59,"half":"左","leaf":"十上","column_from_right":6,"start":0,"end":15,"text":"劍飛鳧擬非其類懷私茂德竊用涕零"}]},"chapter_id":"c-liangshu-050-xiejiqing-family-intro-wyd","book_id":"b-liangshu-050","work_id":"w-liangshu","source_id":"s-liangshu-050-jiqing-wyd1739"},{"id":"c-liangshu-050-xiejiqing-family-intro:p004","text":"居宅在白楊石井，朝中交好者載酒從之，賓客滿坐。時左丞庾仲容亦免歸，二人意志相得，並肆情誕縱，或乘露車歷遊郊野，旣醉則執鐸輓歌，不屑物議。湘東王在荊鎮，與書慰勉之。幾卿答曰：「下官自奉違南浦，卷迹東郊，望日臨風，瞻言佇立。仰尋惠渥，陪奉遊宴，漾桂棹於清池，席落英於曾岨。蘭香兼御，羽觴競集，側聽餘論，沐浴玄流。濤波之辯，懸河不足譬；春藻之辭，麗文無以匹。莫不相顧動容，服心勝口，不覺春日爲遙，更謂脩夜爲促。嘉會難常，摶雲易遠，言念如昨，忽焉素秋。恩光不遺，善謔遠降。因事罷歸，豈雲棲息。旣匪高官，理就一廛。田家作苦，實符清誨。本乏金羈之飾，無假玉璧爲資；徒以老使形疏，疾令心阻，沉滯床簟，彌歷七旬。夢幻俄頃，憂傷在念，竟知無益，思自袪遣。尋理滌意，即以任命爲膏酥；攬鏡照形，翻以支離代萱樹。故得仰慕徽猷，永言前哲；鬼穀深棲，接輿高舉；遁名屠肆，發迹關市；其人緬邈，餘流可想。若令亡者有知，寧不縈悲玄壤，悵隔芳塵；如其逝者可作，必當昭被光景，歡同遊豫；使夫一介老圃，得簉虛心末席。去日已疏，來侍未孱；連劍飛鳧，擬非其類；懷私茂德，竊用涕零。」","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-liangshu-050-xiejiqing-family-intro:p004:m0026","start":26,"end":29,"surface":"庾仲容","person_id":"fem_1hn_uxl","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"},{"id":"c-liangshu-050-xiejiqing-family-intro:p004:u0033","start":33,"end":35,"surface":"二人","person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"幾卿與仲容並稱。"},{"id":"c-liangshu-050-xiejiqing-family-intro:p004:m0081","start":81,"end":83,"surface":"幾卿","person_id":"aa6_83c_juy_CDAABAB","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"},{"id":"c-liangshu-050-xiejiqing-family-intro:p004:m0356","start":356,"end":358,"surface":"鬼穀","person_id":"noa_3ci_b9s","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"},{"id":"c-liangshu-050-xiejiqing-family-intro:p004:m0361","start":361,"end":363,"surface":"接輿","person_id":"cyo_vyj_6o2","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"},{"id":"c-liangshu-050-xiejiqing-family-intro:p004:u0366","start":366,"end":370,"surface":"遁名屠肆","person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"隱於屠肆是人物典故，語中無名，另列可能原典。"},{"id":"c-liangshu-050-xiejiqing-family-intro:p00