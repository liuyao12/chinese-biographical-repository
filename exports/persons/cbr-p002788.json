contextual_provisional"},{"id":"c-shiji-046-tian:m037-0041","start":41,"end":43,"surface":"宣王","kind":"person","person_id":"cbr-p002768","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m037-0059","start":59,"end":62,"surface":"騶忌子","kind":"person","person_id":"cbr-p002759","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m037-0071","start":71,"end":73,"surface":"田忌","kind":"person","person_id":"cbr-p002788","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m037-0095","start":95,"end":97,"surface":"孫子","kind":"person","person_id":"cbr-p002791","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m037-0175","start":175,"end":177,"surface":"宣王","kind":"person","person_id":"cbr-p002768","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m037-0186","start":186,"end":190,"surface":"韓之使者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、對話、稱謂或索隱述贊短稱待核，不補姓名及成員。"},{"id":"c-shiji-046-tian:m037-0217","start":217,"end":219,"surface":"田忌","kind":"person","person_id":"cbr-p002788","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m037-0220","start":220,"end":222,"surface":"田嬰","kind":"person","person_id":"cbr-p002792","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m037-0224","start":224,"end":226,"surface":"孫子","kind":"person","person_id":"cbr-p002791","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m037-0251","start":251,"end":253,"surface":"龐涓","kind":"person","person_id":"cbr-p002793","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m037-0255","start":255,"end":259,"surface":"魏太子申","kind":"person","person_id":"cbr-p002770","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m037-0262","start":262,"end":266,"surface":"三晉之王","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、對話、稱謂或索隱述贊短稱待核，不補姓名及成員。"},{"id":"c-shiji-046-tian:m037-0268","start":268,"end":270,"surface":"田嬰","kind":"person","person_id":"cbr-p002792","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m037-0271","start":271,"end":273,"surface":"齊王","kind":"person","person_id":"cbr-p002768","status":"contextual_provisional"}],"chapter_id":"c-shiji-046-tian","book_id":"b-shiji-046","work_id":"w-shiji","source_id":"s-shiji-046-tian"},{"id":"c-shiji-075-mengchang:p001","text":"孟嘗君名文，姓田氏。文之父曰靖郭君田嬰。田嬰者，齊威王少子而齊宣王庶弟也。田嬰自威王時任職用事，與成侯鄒忌及田忌將而救韓伐魏。成侯與田忌爭寵，成侯賣田忌。田忌懼，襲齊之邊邑，不勝，亡走。會威王卒，宣王立，知成侯賣田忌，乃復召田忌以爲將。宣王二年，田忌與孫臏、田嬰倶伐魏，敗之馬陵，虜魏太子申而殺魏將龐涓。宣王七年，田嬰使於韓、魏，韓、魏服於齊。嬰與韓昭侯、魏惠王會齊宣王東阿南，盟而去。明年，復與梁惠王會甄。是歳，梁惠王卒。宣王九年，田嬰相齊。齊宣王與魏襄王會徐州而相王也。楚威王聞之，怒田嬰。明年，楚伐敗齊師於徐州，而使人逐田嬰。田嬰使張丑説楚威王，威王乃止。田嬰相齊十一年，宣王卒，湣王即位。即位三年，而封田嬰於薛。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-075-mengchang:m001-0000","start":0,"end":3,"surface":"孟嘗君","kind":"person","person_id":"cbr-p004330","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m001-0004","start":4,"end":5,"surface":"文","kind":"person","person_id":"cbr-p004330","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m001-0007","start":7,"end":9,"surface":"田氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"姓氏形式、群體、未定親屬回指或祖孫定義對話，未作已知個別人物；母因兄弟未補兄弟所屬及成員，定義孫玄孫不補真實後裔。"},{"id":"c-shiji-075-mengchang:m001-0010","start":10,"end":11,"surface":"文","kind":"person","person_id":"cbr-p004330","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m001-0014","start":14,"end":19,"surface":"靖郭君田嬰","kind":"person","person_id":"cbr-p004331","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m001-0020","start":20,"end":22,"surface":"田嬰","kind":"person","person_id":"cbr-p004331","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m001-0024","start":24,"end":27,"surface":"齊威王","kind":"person","person_id":"cbr-p004332","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m001-0030","start":30,"end":33,"surface":"齊宣王","kind":"person","person_id":"cbr-p004333","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m00