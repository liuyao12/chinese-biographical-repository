6,4397,4398,4399,4400,4401,4402,4403,4404,4405,4406,4407,4408,4409,4410,4411,4412,4413,4414,4415,4416,4417,4418,4419,4420,4421,4422,4423,4424,4425,4426,4427,4428,4429,4430,4431,4432,4433,4434,4435,4436,4437,4438,4439,4440,4441,4442,4443,4444,4445,4446,4447,4448,4449,4450,4451,4452,4453,4454,4455,4456,4457,4458],"projection_sha256":"b5aa0061cbb6cba63f32a665b9af5bf66efaeaa8f19fb704ea3c8f0c370d3af5"},"chapter_id":"c-nanshi-021-wangrong","book_id":"b-nanshi-021","work_id":"w-nanshi","source_id":"s-nanshi-021-wangrong-ws1752646"},{"text":"梁天監初，尚書僕射范雲嘉其至行，將表奏之，會雲卒不果。樂安任昉有盛名，為後進所慕，遊其門者，昉必推薦。子野於昉為從中表，獨不至，昉亦恨焉，故不之善。","source_position":{"start":10302,"end":10376,"raw":"梁天監初，尚書僕射范雲嘉其至行，將表奏之，會雲卒不果。樂安任昉有盛名，為後進所慕，遊其門者，昉必推薦。子野於昉為從中表，獨不至，昉亦恨焉，故不之善。","raw_path":"sources/nanshi/wikisource-1554233-raw.wikitext"},"id":"c-nanshi-033-pei-family:p015","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-nanshi-033-pei-family:p015:m0009","start":9,"end":11,"surface":"范雲","kind":"person","person_id":"nln_ldz_i3j","status":"contextual_provisional","interpretation_note":"天監初尚書僕射欲表子野行、適卒；梁030同官、同傳主推薦未果事件。"},{"id":"c-nanshi-033-pei-family:p015:m0012","start":12,"end":13,"surface":"其","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"字幾原、父昭明、著宋略、掌國史及中大通卒，梁030同字、同家系、同著述與朝事。"},{"id":"c-nanshi-033-pei-family:p015:m0019","start":19,"end":20,"surface":"之","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"字幾原、父昭明、著宋略、掌國史及中大通卒，梁030同字、同家系、同著述與朝事。"},{"id":"c-nanshi-033-pei-family:p015:m0022","start":22,"end":23,"surface":"雲","kind":"person","person_id":"nln_ldz_i3j","status":"contextual_provisional","interpretation_note":"天監初尚書僕射欲表子野行、適卒；梁030同官、同傳主推薦未果事件。"},{"id":"c-nanshi-033-pei-family:p015:m0029","start":29,"end":31,"surface":"任昉","kind":"person","person_id":"tvc_q3c_t7w","status":"contextual_provisional","interpretation_note":"子野不至任昉門、昉恨之，梁030同人不悅子野的交遊事件；從中表原詞不化成具體母系鏈。"},{"id"