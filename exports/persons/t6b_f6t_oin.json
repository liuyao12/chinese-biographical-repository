kind":"person","person_id":"t6b_f6t_oin","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-056-lvfan:line047","chapter_id":"c-sanguozhi-056-lvfan"},{"id":"c-sanguozhi-056-zhuzhi:line011:m0265","start":265,"end":268,"surface":"嚴自虎","kind":"person","person_id":"t6b_f6t_oin","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-056-zhuzhi:line011","chapter_id":"c-sanguozhi-056-zhuzhi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-056-lvfan:line047","text":"　　是時下邳陳瑀自號吳都太守，住海西，與強族嚴白虎交通。策自將討虎，別遣範與徐逸攻瑀於海西，梟其大將陳牧。又從攻祖郎於陵陽，太史慈於勇裡。七縣平定，拜征虜中郎將，征江夏，還平鄱陽。策薨，奔喪於吳。後權復征江夏，範與張昭留守。曹公至赤壁，與周瑜等俱拒破之，拜裨將軍，領彭澤太守，以彭澤、柴桑、歷陽為奉邑。劉備詣京見權，範密請留備。後遷平南將軍，屯柴桑。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-056-lvfan:line047:m0006","start":6,"end":8,"surface":"陳瑀","kind":"person","person_id":"b88_fje_bm1","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-056-lvfan:line047:m0022","start":22,"end":25,"surface":"嚴白虎","kind":"person","person_id":"t6b_f6t_oin","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-056-lvfan:line047:m0028","start":28,"end":29,"surface":"策","kind":"person","person_id":"e9c_070_567","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-056-lvfan:line047:m0032","start":32,"end":33,"surface":"虎","kind":"person","person_id":"t6b_f6t_oin","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-056-lvfan:line047:m0036","start":36,"end":37,"surface":"範","kind":"person","person_id":"908_816_219","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-056-lvfan:line047:m0038","start":3