dayuan:m030-0089","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":"太初元年","evidence":[{"chapter_id":"c-shiji-123-dayuan","source_id":"s-shiji123-dayuan","paragraph_id":"c-shiji-123-dayuan:p030","quote":"天子已嘗使浞野侯攻樓蘭，以七百騎先至，虜其王，以定漢等言為然，而欲侯寵姬李氏，拜李廣利為貳師將軍，發屬國六千騎，及郡國惡少年數萬人，以往伐宛。期至貳師城取善馬，故號「貳師將軍」。趙始成為軍正，故浩侯王恢使導軍，而李哆為校尉，制軍事。是歲太初元年也。而關東蝗大起，蜚西至敦煌。"}],"normalized_date":{"era":"BCE","era_year":104,"year":-103,"year_numbering":"astronomical","precision":"year","status":"editorial_provisional","original_quote":"天子已嘗使浞野侯攻樓蘭，以七百騎先至，虜其王，以定漢等言為然，而欲侯寵姬李氏，拜李廣利為貳師將軍，發屬國六千騎，及郡國惡少年數萬人，以往伐宛。期至貳師城取善馬，故號「貳師將軍」。趙始成為軍正，故浩侯王恢使導軍，而李哆為校尉，制軍事。是歲太初元年也。而關東蝗大起，蜚西至敦煌。","evidence":[{"chapter_id":"c-shiji-123-dayuan","source_id":"s-shiji123-dayuan","paragraph_id":"c-shiji-123-dayuan:p030","quote":"天子已嘗使浞野侯攻樓蘭，以七百騎先至，虜其王，以定漢等言為然，而欲侯寵姬李氏，拜李廣利為貳師將軍，發屬國六千騎，及郡國惡少年數萬人，以往伐宛。期至貳師城取善馬，故號「貳師將軍」。趙始成為軍正，故浩侯王恢使導軍，而李哆為校尉，制軍事。是歲太初元年也。而關東蝗大起，蜚西至敦煌。"}],"references":[{"title":"《資治通鑑》數位編輯年標","url":"https://zh.wikisource.org/wiki/資治通鑑/卷021","quote":"太初元年（丁丑，公元前一零四年）","scope":"digital_editorial_regnal_year_equivalence_only","image_verified":false}],"rationale":"本篇明示太初元年，按數位年標換算前104年；只換算所指授任或封爵年份，不推精確月日、其他任職或終止年。","reviewer":"Codex（AI 代理）","human_reviewed":false}},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"原文授任、繼位與用稱分存；未知起訖保持未知，不因死亡自動終止。從驃侯等原稱不默改。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji123-035","person_id":"zpc_ufe_fc2","title":"光祿大夫","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-123-dayuan","source_id":"s-shiji123-dayuan","paragraph_id":"c-shiji-123-dayuan:p035","quote":"初，貳師后行，天子使使告烏孫，大發兵并力擊宛。烏孫發二千騎往，持兩端，不肯前。貳師將軍之東，諸所過小國聞宛破，皆使其子弟從軍入獻，見天子，因以為質焉。貳師之伐宛也，而軍正趙始成力戰，功最多；及上官桀敢深入，李哆為謀計，軍入玉門者萬餘人，軍馬千餘匹。貳師后行，軍非乏食，戰死不能多，而將吏貪，多不愛士卒，侵牟之，以此物故眾。天子為萬里而伐宛，不錄過，封廣利為海西侯。又封身斬郁成王者騎士趙弟為新畤侯。軍正趙始成為光祿大夫，上官桀為少府，李哆為上黨太守。軍官吏為九卿者三人，諸侯相、郡守、二千石者百餘人，千石以下千餘人。奮行者官過其望，以適過行者皆絀其勞。士卒賜直四萬金。伐宛再反，凡四歲而得罷焉。"}],"attestations":[{"id":"th-shiji123-035:a001","paragraph_id":"c-shiji-123-dayuan:p035","start":205,"end":209,"surface":"光祿大夫","person_mention_id":"c-shiji-123-dayuan:m035-0085","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-123-dayuan","source_id":"s-shiji123-dayuan","paragraph_id":"c-shiji-123-dayuan:p035","quote":"初，貳師后行，天子使使告烏孫，大發兵并力擊宛。烏孫發二千騎往，持兩端，不肯前。貳師將軍之東，諸所過小國聞宛破，皆使其子弟從軍入獻，見天子，因以為質焉。貳師之伐宛也，而軍正趙始成力戰，功最多；及上官桀敢深入，李哆為謀計，軍入玉門者萬餘人，軍馬千餘匹。貳師后行，軍非乏食，戰死不能多，而將吏貪，多不愛士卒，侵牟之，以此物故眾。天子為萬里而伐宛，不錄過，封廣利為海西侯。又封身斬郁成王者騎士趙弟為新畤侯。軍正趙始成為光祿大夫，上官桀為少府，李哆為上黨太守。軍官吏為九卿者三人，諸侯相、郡守、二千石者百餘人，千石以下千餘人。奮行者官過其望，以適過行者皆絀其勞。士卒賜直四萬金。伐宛再反，凡四歲而得罷焉。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"原文授任、繼位與用稱分存；未知起訖保持未知，不因死亡自動終止。從驃侯等原稱不默改。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[{"era":"BCE","era_year":104,"year":-103,"year_numbering":"astronomical","precision":"year","status":"editorial_provisional","original_quote":"天子已嘗使浞野侯攻樓蘭，以七百騎先至，虜其王，以定漢等言為然，而欲侯寵姬李氏，拜李廣利為貳師將軍，發屬國六千騎，及郡國惡少年數萬人，以往伐宛。期至貳師城取善馬，故號「貳師將軍」。趙始成為軍正，故浩侯王恢使導軍，而李哆為校尉，制軍事。是歲太初元年也。而關東蝗大起，蜚西至敦煌。","evidence":[{"chapter_id":"c-shiji-123-dayuan","source_id":"s-shiji123-dayuan","paragraph_id":"c-shiji-123-dayuan:p030","quote":"天子已嘗使浞野侯攻樓蘭，以七百騎先至，虜其王，以定漢等言為然，而欲侯寵姬李氏，拜李廣利為貳師將軍，發屬國六千騎，及郡國惡少年數萬人，以往伐宛。期至貳師城取善馬，故號「貳師將軍」。趙始成為軍正，故浩侯王恢使導軍，而李哆為校尉，制軍事。是歲太初元年也。而關東蝗大起，蜚西至敦煌。"}],"references":[{"title":"《資治通鑑》數位編輯年標","url":"https://zh.wikisource.org/wiki/資治通鑑/卷021","quote":"太初元年（丁丑，公元前一零四年）","scope":"digital_editorial_regnal_year_equivalence_only","image_verified":false}],"rationale":"本篇明示太初元年，按數位年標換算前104年；只換算所指授任或封爵年份，不推精確月日、其他任職或終止年。","reviewer":"Codex（AI 代理）","human_reviewed":false,"record_id":"th-shiji123-026","person_id":"zpc_ufe_fc2","endpoint":"start","title":"軍正"}],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-123-dayuan:p030","text":"天子已嘗使浞野侯攻樓蘭，以七百騎先至，虜其王，以定漢等言為然，而欲侯寵姬李氏，拜李廣利為貳師將軍，發屬國六千騎，及郡國惡少年數萬人，以往伐宛。期至貳師城取善馬，故號「貳師將軍」。趙始成為軍正，故浩侯王恢使導軍，而李哆為校尉，制軍事。是歲太初元年也。而關東蝗大起，蜚西至敦煌。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-123-dayuan:m030-0000","start":0,"end":2,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0005","start":5,"end":8,"surface":"浞野侯","kind":"person","person_id":"z0l_1wp_de1","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0020","start":20,"end":22,"surface":"其王","kind":"person","person_id":"lx3_ne1_5h4","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0024","start":24,"end":26,"surface":"定漢","kind":"person","person_id":"pbn_4mh_7ix","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0034","start":34,"end":38,"surface":"寵姬李氏","kind":"person","person_id":"z3p_px0_z7c","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0040","start":40,"end":43,"surface":"李廣利","kind":"person","person_id":"pez_8dn_r76","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0044","start":44,"end":48,"surface":"貳師將軍","kind":"person","person_id":"pez_8dn_r76","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0083","start":83,"end":87,"surface":"貳師將軍","kind":"person","person_id":"pez_8dn_r76","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0089","start":89,"end":92,"surface":"趙始成","kind":"person","person_id":"zpc_ufe_fc2","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0099","start":99,"end":101,"surface":"王恢","kind":"person","person_id":"4qp_wu1_qhe","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0106","start":106,"end":108,"surface":"李哆","kind":"person","person_id":"ey5_6f2_7to","status":"contextual_provisional"}],"chapter_id":"c-shiji-123-dayuan","book_id":"b-shiji-123","work_id":"w-shiji","source_id":"s-shiji123-dayuan"},{"id":"c-shiji-123-dayuan:p031","text":"貳師將軍軍既西過鹽水，當道小國恐，各堅城守，不肯給食。攻之不能下。下者得食，不下者數日則去。比至郁成，士至者不過數千，皆饑罷。攻郁成，郁成大破之，所殺傷甚眾。貳師將軍與哆、始成等計：「至郁成尚不能舉，況至其王都乎？」引兵而還。往來二歲。還至敦煌，士不過什一二。使使上書言：「道遠多乏食；且士卒不患戰，患饑。人少，不足以拔宛。願且罷兵，益發而復往。」天子聞之，大怒，而使使遮玉門，曰軍有敢入者輒斬之！貳師恐，因留敦煌。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-123-dayuan:m031-0000","start":0,"end":4,"surface":"貳師將軍","kind":"person","person_id":"pez_8dn_r76","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m031-0079","start":79,"end":83,"surface":"貳師將軍","kind":"person","person_id":"pez_8dn_r76","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m031-0084","start":84,"end":85,"surface":"哆","kind":"person","person_id":"ey5_6f2_7to","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m031-0086","start":86,"end":88,"surface":"始成","kind":"person","person_id":"zpc_ufe_fc2","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m031-0174","start":174,"end":176,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m031-0199","start":199,"end":201,"surface":"貳師","kind":"person","person_id":"pez_8dn_r76","status":"contextual_provisional"}],"chapter_id":"c-shiji-123-dayuan","book_id":"b-shiji-123","work_id":"w-shiji","source_id":"s-shiji123-dayuan"},{"id":"c-shiji-123-dayuan:p033","text":"於是貳師后復行，兵多，而所至小國莫不迎，出食給軍。至侖頭，侖頭不下，攻數日，屠之。自此而西，平行至宛城，漢兵到者三萬人。宛兵迎擊漢兵，漢兵射敗之，宛走入葆乘其城。貳師兵欲行攻郁成，恐留行而令宛益生詐，乃先至宛，決其水源，移之，則宛固已憂困。圍其城，攻之四十餘日，其外城壞，虜宛貴人勇將煎靡。宛大恐，走入中城。宛貴人相與謀曰：「漢所為攻宛，以王毋寡匿善馬而殺漢使。今殺王毋寡而出善馬，漢兵宜解；即不解，乃力戰而死，未晚也。」宛貴人皆以為然，共殺其王毋寡，持其頭遣貴人使貳師，約曰：「漢毋攻我。我盡出善馬，恣所取，而給漢軍食。即不聽，我盡殺善馬，而康居之救且至。至，我居內，康居居外，與漢軍戰。漢軍熟計之，何從？」是時康居候視漢兵，漢兵尚盛，不敢進。貳師與趙始成、李哆等計：「聞宛城中新得秦人，知穿井，而其內食尚多。所為來，誅首惡者毋寡。毋寡頭已至，如此而不許解兵，則堅守，而康居候漢罷而來救宛，破漢軍必矣。」軍吏皆以為然，許宛之約。宛乃出其善馬，令漢自擇之，而多出食食給漢軍。漢軍取其善馬數十匹。中馬以下牡牝三千餘匹，而立宛貴人之故待遇漢使善者名昧蔡以為宛王，與盟而罷兵。終不得入中城。乃罷而引歸。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-123-dayuan:m033-0002","start":2,"end":4,"surface":"貳師","kind":"person","person_id":"pez_8dn_r76","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m033-0081","start":81,"end":83,"surface":"貳師","kind":"person","person_id":"pez_8dn_r76","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m033-0137","start":137,"end":140,"surface":"宛貴人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-123-dayuan:m033-0142","start":142,"end":144,"surface":"煎靡","kind":"person","person_id":"ral_28k_rwc","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m033-0154","start":154,"end":157,"surface":"宛貴人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-123-dayuan:m033-0171","start":171,"end":173,"surface":"毋寡","kind":"person","person_id":"2l2_58b_q4i","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m033-0184","start":184,"end":186,"surface":"毋寡","kind":"person","person_id":"2l2_58b_q4i","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m033-0211","start":211,"end":214,"surface":"宛貴人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-123-dayuan:m033-0223","start":223,"end":225,"surface":"毋寡","kind":"person","person_id":"2l2_58b_q4i","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m033-0233","start":233,"end":235,"surface":"貳師","kind":"person","person_id":"pez_8dn_r76","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m033-0323","start":323,"end":325,"surface":"貳師","kind":"person","person_id":"pez_8dn_r76","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m033-0326","start":326,"end":329,"surface":"趙始成","kind":"person","person_id":"zpc_ufe_fc2","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m033-0330","start":330,"end":332,"surface":"李哆","kind":"person","person_id":"ey5_6f2_7to","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m033-0342","start":342,"end":344,"surface":"秦人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-123-dayuan:m033-0364","start":364,"end":366,"surface":"毋寡","kind":"person","person_id":"2l2_58b_q4i","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m033-0367","start":367,"end":369,"surface":"毋寡","kind":"person","person_id":"2l2_58b_q4i","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m033-0460","start":460,"end":463,"surface":"宛貴人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-123-dayuan:m033-0472","start":472,"end":474,"surface":"昧蔡","kind":"person","person_id":"ivv_l99_uev","status":"contextual_provisional"}],"chapter_id":"c-shiji-123-dayuan","book_id":"b-shiji-123","work_id":"w-shiji","source_id":"s-shiji123-dayuan"},{"id":"c-shiji-123-dayuan:p035","text":"初，貳師后行，天子使使告烏孫，大發兵并力擊宛。烏孫發二千騎往，持兩端，不肯前。貳師將軍之東，諸所過小國聞宛破，皆使其子弟從軍入獻，見天子，因以為質焉。貳師之伐宛也，而軍正趙始成力戰，功最多；及上官桀敢深入，李哆為謀計，軍入玉門者萬餘人，軍馬千餘匹。貳師后行，軍非乏食，戰死不能多，而將吏貪，多不愛士卒，侵牟之，以此物故眾。天子為萬里而伐宛，不錄過，封廣利為海西侯。又封身斬郁成王者騎士趙弟為新畤侯。軍正趙始成為光祿大夫，上官桀為少府，李哆為上黨太守。軍官吏為九卿者三人，諸侯相、郡守、二千石者百餘人，千石以下千餘人。奮行者官過其望，以適過行者皆絀其勞。士卒賜直四萬金。伐宛再反，凡四歲而得罷焉。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-123-dayuan:m035-0002","start":2,"end":4,"surface":"貳師","kind":"person","person_id":"pez_8dn_r76","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m035-0007","start":7,"end":9,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m035-0039","start":39,"end":43,"surface":"貳師將軍","kind":"person","person_id":"pez_8dn_r76","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m035-0057","start":57,"end":60,"surface":"其子弟","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-123-dayuan:m035-0066","start":66,"end":68,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m035-0075","start":75,"end"