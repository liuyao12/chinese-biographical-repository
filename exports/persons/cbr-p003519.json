{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003519","identity_policy":"contextual_provisional","person_ids":["cbr-p003519"],"persons":[{"id":"cbr-p003519","label":"吳王濞（絳侯周勃世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"吳王濞","mention_ids":["c-shiji-057-zhou:m016-0195"]},{"surface":"吳王","mention_ids":["c-shiji-057-zhou:m016-0235","c-shiji-057-zhou:m016-0246"]}],"evidence":[{"mention_id":"c-shiji-057-zhou:m016-0195","chapter_id":"c-shiji-057-zhou","paragraph_id":"c-shiji-057-zhou:p016","quote":"吳王濞"},{"mention_id":"c-shiji-057-zhou:m016-0235","chapter_id":"c-shiji-057-zhou","paragraph_id":"c-shiji-057-zhou:p016","quote":"吳王"},{"mention_id":"c-shiji-057-zhou:m016-0246","chapter_id":"c-shiji-057-zhou","paragraph_id":"c-shiji-057-zhou:p016","quote":"吳王"}]}],"mentions":[{"id":"c-shiji-057-zhou:m016-0195","start":195,"end":198,"surface":"吳王濞","kind":"person","person_id":"cbr-p003519","status":"contextual_provisional","paragraph_id":"c-shiji-057-zhou:p016","chapter_id":"c-shiji-057-zhou"},{"id":"c-shiji-057-zhou:m016-0235","start":235,"end":237,"surface":"吳王","kind":"person","person_id":"cbr-p003519","status":"contextual_provisional","paragraph_id":"c-shiji-057-zhou:p016","chapter_id":"c-shiji-057-zhou"},{"id":"c-shiji-057-zhou:m016-0246","start":246,"end":248,"surface":"吳王","kind":"person","person_id":"cbr-p003519","status":"contextual_provisional","paragraph_id":"c-shiji-057-zhou:p016","chapter_id":"c-shiji-057-zhou"}],"relations":[],"title_holdings":[{"id":"th-shiji057-065","person_id":"cbr-p003519","title":"吳王","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-057-zhou","source_id":"s-shiji-057-zhou","paragraph_id":"c-shiji-057-zhou:p016","quote":"太尉既會兵滎陽，吳方攻梁，梁急，請救。太尉引兵東北走昌邑，深壁而守。梁日使使請太尉，太尉守便宜，不肯往。梁上書言景帝，景帝使使詔救梁。太尉不奉詔，堅壁不出，而使輕騎兵弓高侯等絕吳楚兵後食道。吳兵乏糧，饑，數欲挑戰，終不出。夜，軍中驚，內相攻擊擾亂，至於太尉帳下。太尉終臥不起。頃之，復定。後吳奔壁東南陬，太尉使備西北。已而其精兵果奔西北，不得入。吳兵既餓，乃引而去。太尉出精兵追擊，大破之。吳王濞棄其軍，而與壯士數千人亡走，保於江南丹徒。漢兵因乘勝，遂盡虜之，降其兵，購吳王千金。月餘，越人斬吳王頭以告。凡相攻守三月，而吳楚破平。於是諸將乃以太尉計謀為是。由此梁孝王與太尉有卻。"}],"attestations":[{"id":"th-shiji057-065:a001","paragraph_id":"c-shiji-057-zhou:p016","start":195,"end":197,"surface":"吳王","person_mention_id":"c-shiji-057-zhou:m016-0195","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授官、爵秩、追稱、承爵與一般用稱分存；相對年數按原段，不換算公曆或推定所有官爵同時終止。未知官員姓名與制度性質不補。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji057-052","person_id":"cbr-p003519","surfaces":["吳王","吳王濞"],"scope":"same_chapter","chapter_ids":["c-shiji-057-zhou"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-057-zhou:p016","quote":"太尉既會兵滎陽，吳方攻梁，梁急，請救。太尉引兵東北走昌邑，深壁而守。梁日使使請太尉，太尉守便宜，不肯往。梁上書言景帝，景帝使使詔救梁。太尉不奉詔，堅壁不出，而使輕騎兵弓高侯等絕吳楚兵後食道。吳兵乏糧，饑，數欲挑戰，終不出。夜，軍中驚，內相攻擊擾亂，至於太尉帳下。太尉終臥不起。頃之，復定。後吳奔壁東南陬，太尉使備西北。已而其精兵果奔西北，不得入。吳兵既餓，乃引而去。太尉出精兵追擊，大破之。吳王濞棄其軍，而與壯士數千人亡走，保於江南丹徒。漢兵因乘勝，遂盡虜之，降其兵，購吳王千金。月餘，越人斬吳王頭以告。凡相攻守三月，而吳楚破平。於是諸將乃以太尉計謀為是。由此梁孝王與太尉有卻。"}],"rationale":"按明示姓名、軍事近接、父子承爵與局部皇帝敘事暫接。周勃和勝之的絳侯分開，亞夫條侯與平曲支不混；代地韓信依韓王信近接而不接淮陰侯。未名人物、單名官員不補姓，校勘字不作定本，相術預言不作史實已驗。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-057-zhou:p016","text":"太尉既會兵滎陽，吳方攻梁，梁急，請救。太尉引兵東北走昌邑，深壁而守。梁日使使請太尉，太尉守便宜，不肯往。梁上書言景帝，景帝使使詔救梁。太尉不奉詔，堅壁不出，而使輕騎兵弓高侯等絕吳楚兵後食道。吳兵乏糧，饑，數欲挑戰，終不出。夜，軍中驚，內相攻擊擾亂，至於太尉帳下。太尉終臥不起。頃之，復定。後吳奔壁東南陬，太尉使備西北。已而其精兵果奔西北，不得入。吳兵既餓，乃引而去。太尉出精兵追擊，大破之。吳王濞棄其軍，而與壯士數千人亡走，保於江南丹徒。漢兵因乘勝，遂盡虜之，降其兵，購吳王千金。月餘，越人斬吳王頭以告。凡相攻守三月，而吳楚破平。於是諸將乃以太尉計謀為是。由此梁孝王與太尉有卻。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-057-zhou:m016-0000","start":0,"end":2,"surface":"太尉","kind":"person","person_id":"cbr-p003470","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m016-0019","start":19,"end":21,"surface":"太尉","kind":"person","person_id":"cbr-p0034