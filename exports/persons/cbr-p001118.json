曰：「君以道則可；若不，則楚方城以為城，江、漢以為溝，君安能進乎？」乃與屈完盟而去。過陳，陳袁濤涂詐齊，令出東方，覺。秋，齊伐陳。是歲，晉殺太子申生。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-032-qi:m039-0005","start":5,"end":8,"surface":"齊桓公","kind":"person","person_id":"9w2_c77_53m","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m039-0021","start":21,"end":24,"surface":"楚成王","kind":"person","person_id":"2d3_fsd_1dh","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m039-0037","start":37,"end":39,"surface":"管仲","kind":"person","person_id":"h1v_8ap_b9y","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m039-0044","start":44,"end":47,"surface":"召康公","kind":"person","person_id":"7m7_qvm_4oj","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m039-0049","start":49,"end":53,"surface":"先君太公","kind":"person","person_id":"1g3_02y_oor","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m039-0114","start":114,"end":116,"surface":"昭王","kind":"person","person_id":"voy_rog_jbw","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m039-0127","start":127,"end":129,"surface":"楚王","kind":"person","person_id":"2d3_fsd_1dh","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m039-0150","start":150,"end":152,"surface":"昭王","kind":"person","person_id":"voy_rog_jbw","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m039-0174","start":174,"end":176,"surface":"楚王","kind":"person","person_id":"2d3_fsd_1dh","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m039-0177","start":177,"end":179,"surface":"屈完","kind":"person","person_id":"e2m_g41_b73","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m039-0191","start":191,"end":193,"surface":"桓公","kind":"person","person_id":"9w2_c77_53m","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m039-0194","start":194,"end":196,"surface":"屈完","kind":"person","person_id":"e2m_g41_b73","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m039-0200","start":200,"end":202,"surface":"屈完","kin