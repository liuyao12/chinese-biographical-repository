ths":[],"mentions":[{"id":"c-jinshu-060-miaoyin:p001:m0157","surface":"何綏","start":157,"end":159,"person_id":"8tg_j2w_xqm","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-060-miaoyin:p001","chapter_id":"c-jinshu-060-miaoyin"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-060-miaoyin:p001","text":"胤字休祖，安平獻王外孫也，與播名譽略齊。初為尚書郎，後遷太弟左衛率，轉魏郡太守。及王浚軍逼鄴，石超等大敗，胤奔東海王越於徐州，越使胤與播俱入關，而所說得行，大駕東還。越以胤為冠軍將軍、南陽太守。胤從藍田出武關，之南陽，前守衛展距胤不受，胤乃還洛。懷帝即位，拜胤左衛將軍，轉散騎常侍、太僕卿。既而與播及帝舅王延、尚書何綏、太史令高堂沖並參機密，為東海王越所害。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":43,"last_line":43,"raw_start":2973,"raw_end":3154,"raw_character_offsets":[2975,2976,2977,2978,2979,2980,2981,2982,2983,2984,2985,2986,2987,2988,2989,2990,2991,2992,2993,2994,2995,2996,2997,2998,2999,3000,3001,3002,3003,3004,3005,3006,3007,3008,3009,3010,3011,3012,3013,3014,3015,3016,3017,3018,3019,3020,3021,3022,3023,3024,3025,3026,3027,3028,3029,3030,3031,3032,3033,3034,3035,3036,3037,3038,3039,3040,3041,3042,3043,3044,3045,3046,3047,3048,3049,3050,3051,3052,3053,3054,3055,3056,3057,3058,3059,3060,3061,3062,3063,3064,3065,3066,3067,3068,3069,3070,3071,3072,3073,3074,3075,3076,3077,3078,3079,3080,3081,3082,3083,3084,3085,3086,3087,3088,3089,3090,3091,3092,3093,3094,3095,3096,3097,3098,3099,3100,3101,3102,3103,3104,3105,3106,3107,3108,3109,3110,3111,3112,3113,3114,3115,3116,3117,3118,3119,3120,3121,3122,3123,3124,3125,3126,3127,3128,3129,3130,3131,3132,3133,3134,3135,3136,3137,3138,3139,3140,3141,3142,3143,3144,3145,3146,3147,3148,3149,3150,3151,3152,3153],"revision_id":2413335},"mentions":[{"id":"c-jinshu-060-miaoyin:p001:m0000","surface":"胤","start":0,"end":1,"person_id":"lhb_x3s_wen","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-miaoyin:p001:m0