ce":[{"paragraph_id":"c-shiji-095-fankuang:p015","quote":"孝景前三年，吳、楚、齊、趙反，上以寄為將軍，圍趙城，十月不能下。得俞侯欒布自平齊來，乃下趙城，滅趙，王自殺，除國。孝景中二年，寄欲取平原君為夫人，景帝怒，下寄吏，有罪，奪侯。景帝乃以商他子堅封為繆侯，續酈氏後。繆靖侯卒，子康侯遂成立。遂成卒，子懷侯世宗立。世宗卒，子侯終根立，為太常，坐法，國除。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定異稱。酈寄字況據第14段；夏侯嬰的嬰限定第16至21段，灌嬰限定第22至33段，桓嬰另人。第6與20、28段楚王信和反韓王信分人；未詳名王侯不補名。同名跨篇同指另待逐項證據。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-095-fankuang:p015","text":"孝景前三年，吳、楚、齊、趙反，上以寄為將軍，圍趙城，十月不能下。得俞侯欒布自平齊來，乃下趙城，滅趙，王自殺，除國。孝景中二年，寄欲取平原君為夫人，景帝怒，下寄吏，有罪，奪侯。景帝乃以商他子堅封為繆侯，續酈氏後。繆靖侯卒，子康侯遂成立。遂成卒，子懷侯世宗立。世宗卒，子侯終根立，為太常，坐法，國除。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m015-0000","start":0,"end":2,"surface":"孝景","kind":"person","person_id":"uvx_q8x_ou4","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m015-0017","start":17,"end":18,"surface":"寄","kind":"person","person_id":"bni_7nd_jnt_B","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m015-0035","start":35,"end":37,"surface":"欒布","kind":"person","person_id":"qdl_8tt_r4v","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m015-0050","start":50,"end":53,"surface":"王自殺","kind":"person","person_id":"8vt_geo_sqb","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m015-0057","start":57,"end":59,"surface":"孝景","kind":"person","person_id":"uvx_q8x_ou4","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m015-0063","start":63,"end":64,"surface":"寄","kind":"person","person_id":"bni_7nd_jnt_B","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m015-0066","start":66,"end":69,"surface":"平原君","kind":"person","person_id":"uyb_9er_yx7","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m015-0073","start":73,"end":75,"surface":"景帝","kind":"person","person_id":"uvx_q8x_ou4","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m015-0078","start":78,"end":79,"surface":"寄","kind":"person","person_id":"bni_7nd_jnt_B","status":"contextua