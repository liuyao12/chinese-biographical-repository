zhou:p010","chapter_id":"c-shiji-057-zhou"},{"id":"c-shiji-057-zhou:m010-0085","start":85,"end":87,"surface":"獄吏","kind":"person","person_id":"u0a_lyv_mx6","status":"contextual_provisional","note":"依本段可分辨受得官員、軍事主體或說話者記未名候選，不補姓名；獄吏教策前後同一敘事，末句安知獄吏之貴泛論未強併。","paragraph_id":"c-shiji-057-zhou:p010","chapter_id":"c-shiji-057-zhou"},{"id":"c-shiji-057-zhou:m010-0122","start":122,"end":124,"surface":"獄吏","kind":"person","person_id":"u0a_lyv_mx6","status":"contextual_provisional","note":"依本段可分辨受得官員、軍事主體或說話者記未名候選，不補姓名；獄吏教策前後同一敘事，末句安知獄吏之貴泛論未強併。","paragraph_id":"c-shiji-057-zhou:p010","chapter_id":"c-shiji-057-zhou"}],"relations":[],"title_holdings":[{"id":"th-shiji057-085","person_id":"u0a_lyv_mx6","title":"獄吏","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-057-zhou","source_id":"s-shiji-057-zhou","paragraph_id":"c-shiji-057-zhou:p010","quote":"歲餘，每河東守尉行縣至絳，絳侯勃自畏恐誅，常被甲，令家人持兵以見之。其後人有上書告勃欲反，下廷尉。廷尉下其事長安，逮捕勃治之。勃恐，不知置辭。吏稍侵辱之。勃以千金與獄吏，獄吏乃書牘背示之，曰「以公主為證」。公主者，孝文帝女也，勃太子勝之尚之，故獄吏教引為證。勃之益封受賜，盡以予薄昭。及系急，薄昭為言薄太后，太后亦以為無反事。文帝朝，太后以冒絮提文帝，曰：「絳侯綰皇帝璽，將兵於北軍，不以此時反，今居一小縣，顧欲反邪！」文帝既見絳侯獄辭，乃謝曰：「吏［事］方驗而出之。」於是使使持節赦絳侯，復爵邑。絳侯既出，曰：「吾嘗將百萬軍，然安知獄吏之貴乎！」","person_mention_id":"c-shiji-057-zhou:m010-0082"}],"attestations":[{"id":"th-shiji057-085:a001","paragraph_id":"c-shiji-057-zhou:p010","start":82,"end":84,"surface":"獄吏","person_mention_id":"c-shiji-057-zhou:m010-0082","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本篇可分辨未名官員的來源用稱，授任起訖未知；被得、被擊不當死亡，泛論職稱不強指同人。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-057-zhou:p010","text":"歲餘，每河東守尉行縣至絳，絳侯勃自畏恐誅，常被甲，令家人持兵以見之。其後人有上書告勃欲反，下廷尉。廷尉下其事長安，逮捕勃治之。勃恐，不知置辭。吏稍侵辱之。勃以千金與獄吏，獄吏乃書牘背示之，曰「以公主為證」。公主者，孝文帝女也，勃太子勝之尚之，故獄吏教引為證。勃之益封受賜，盡以予薄昭。及系急，薄昭為言薄太后，太后亦以為無反事。文帝朝，太后以冒絮提文帝，曰：「絳侯綰皇帝璽，將兵於北軍，不以此時反，今居一小縣，顧欲反邪！」文帝既見絳侯獄辭，乃謝曰：「吏［事］方驗而出之。」於是使使持節赦絳侯，復爵邑。絳侯既出，曰：「吾嘗將百萬軍，然安知獄吏之貴乎！」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-057-zhou:m010-0004","start":4,"end":8,"surface":"河東守尉","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者、假設侯嗣、職署或未定回指；不補姓名、親屬成員或爵位所指。"},{"id":"c-shiji-057-zhou:m010-0013","start":13,"end":16,"surface":"絳侯勃","kind":"person","person_id":"koy_6jg_gcc","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m010-0026","start":26,"end":28,"surface":"家人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者、假設侯嗣、職署或未定回指；不補姓名、親屬成員或爵位所指。"},{"id":"c-shiji-057-zhou:m010-0041","start":41,"end":42,"surface":"勃","kind":"person","person_id":"koy_6jg_gcc","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m010-0046","start":46,"end":48,"surface":"廷尉","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者、假設侯嗣、職署或未定回指；不補姓名、親屬成員或爵位所指。"},{"id":"c-shiji-057-zhou:m010-0049","start":49,"end":51,"surface":"廷尉","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者、假設侯嗣、職署或未定回指；不補姓名、親屬成員或爵位所指。"},{"id":"c-shiji-057-zhou:m010-0059","start":59,"end":60,"surface":"勃","kind":"person","person_id":"koy_6jg_gcc","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m010-0063","start":63,"end":64,"surface":"勃","kind":"person","person_id":"koy_6jg_gcc","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m010-0077","start":77,"end":78,"surface":"勃","kind":"person","person_id":"koy_6jg_gcc","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m010-0082","start":82,"end":84,"surface":"獄吏","kind":"person","person_id":"u0a_lyv_mx6","status":"contextual_provisional","note":"依本段可分辨受得官員、軍事主體或說話者記未名候選，不補姓名；獄吏教策前後同一敘事，末句安知獄吏之貴泛論未強併。"},{"id":"c-shiji-057-zhou:m010-0085","start":85,"end":87,"surface":"獄吏","kind":"person","