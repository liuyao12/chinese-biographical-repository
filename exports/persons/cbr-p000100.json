-003-yin:p014","chapter_id":"c-shiji-003-yin"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-003-yin:p009","text":"湯歸至于泰卷陶，中𤳹作誥。既絀夏命，還亳，作湯誥：「維三月，王自至於東郊。告諸侯群后：『毋不有功於民，勤力迺事。予乃大罰殛女，毋予怨。』曰：『古禹、皋陶久勞于外，其有功乎民，民乃有安。東為江，北為濟，西為河，南為淮，四瀆已修，萬民乃有居。后稷降播，農殖百穀。三公咸有功于民，故后有立。昔蚩尤與其大夫作亂百姓，帝乃弗予，有狀。先王言不可不勉。』曰：『不道，毋之在國，女毋我怨。』」以令諸侯。伊尹作咸有一德，咎單作明居。","mentions":[{"id":"c-shiji-003-yin:m009-0000","start":0,"end":1,"surface":"湯","kind":"person","person_id":"tpz_x3m_e0h","status":"source_identified"},{"id":"c-shiji-003-yin:m009-0008","start":8,"end":10,"surface":"中𤳹","kind":"person","person_id":"dxw_mqx_r82","status":"source_identified"},{"id":"c-shiji-003-yin:m009-0030","start":30,"end":31,"surface":"王","kind":"person","person_id":"tpz_x3m_e0h","status":"contextual_provisional","interpretation_note":"只依本段對話的君主與事件暫定，不作全篇通用的帝／王匹配。"},{"id":"c-shiji-003-yin:m009-0072","start":72,"end":73,"surface":"禹","kind":"person","person_id":"6ip_dr3_fbl","status":"source_identified"},{"id":"c-shiji-003-yin:m009-0074","start":74,"end":76,"surface":"皋陶","kind":"person","person_id":"p3l_pp3_n6i","status":"source_identified"},{"id":"c-shiji-003-yin:m009-0119","start":119,"end":121,"surface":"后稷","kind":"person","person_id":"jqy_1fv_u7v","status":"source_identified"},{"id":"c-shiji-003-yin:m009-0129","start":129,"end":131,"surface":"三公","kind":"unresolved","person_id":null,"status":"unresolved","note":"氏族、群體、官稱或未定個人指代；不由熟知故事補出姓名。"},{"id":"c-shiji-003-yin:m009-0143","start":143,"end":145,"surface":"蚩尤","kind":"person","person_id":"7x2_x55_1b6","status":"source_identified"},{"id":"c-shiji-003-yin:m009-0147","start":147,"end":149,"surface":"大夫","kind":"unresolved","person_id":null,"status":"unresolved","note":"氏族、群體、官稱或未定個人指代；不由熟知故事補出姓名。"},{"id":"c-shiji-003-yin:m009-0154","start":154,"end":158,"surface":"帝乃弗予","kind":"unresolved","perso