52-qidaohui:m010-0296","start":296,"end":299,"surface":"瑯邪王","kind":"person","person_id":"8st_c0j_4fk","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m010-0302","start":302,"end":304,"surface":"祝午","kind":"person","person_id":"fgr_573_f18","status":"contextual_provisional"}],"chapter_id":"c-shiji-052-qidaohui","book_id":"b-shiji-052","work_id":"w-shiji","source_id":"s-shiji-052-qidaohui"},{"id":"c-shiji-052-qidaohui:p011","text":"瑯邪王劉澤既見欺，不得反國，乃說齊王曰：「齊悼惠王高皇帝長子，推本言之，而大王高皇帝適長孫也，當立。今諸大臣狐疑未有所定，而澤於劉氏最為長年，大臣固待澤決計。今大王留臣無為也，不如使我入關計事。」齊王以為然，乃益具車送瑯邪王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-052-qidaohui:m011-0000","start":0,"end":5,"surface":"瑯邪王劉澤","kind":"person","person_id":"8st_c0j_4fk","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m011-0016","start":16,"end":18,"surface":"齊王","kind":"person","person_id":"byp_ks5_71a_AA","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m011-0021","start":21,"end":25,"surface":"齊悼惠王","kind":"person","person_id":"byp_ks5_71a_A","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m011-0025","start":25,"end":28,"surface":"高皇帝","kind":"person","person_id":"byp_ks5_71a","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m011-0039","start":39,"end":42,"surface":"高皇帝","kind":"person","person_id":"byp_ks5_71a","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m011-0062","start":62,"end":63,"surface":"澤","kind":"person","person_id":"8st_c0j_4fk","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m011-0075","start":75,"end":76,"surface":"澤","kind":"person","person_id":"8st_c0j_4fk","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m011-0098","start":98,"end":100,"surface":"齊王","kind":"person","person_id":"byp_ks5_71a_AA","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m011-0109","start":109,"end":112,"surface":"瑯邪王","kind":"person","person_id":"8st_c0j_4fk","status":"contextual_provisional"}],"chapter_id":"c-shiji-052-qidaohui","book_id":"b-shiji-052","work_id":"w-shiji","source_id":"s-shiji-052-qidaohui"},{"id":"c-shiji-052-qidaohui:p012","text":"瑯邪王既行，齊遂舉兵西攻呂國之濟南。於是齊哀王遺諸侯王書曰：「高帝平定天下，王諸子弟，悼惠王於齊。悼惠王薨，惠帝使留侯張良立臣為齊王。惠帝崩，高后用事，春秋高，聽諸呂擅廢高帝所立，又殺三趙王，滅梁、燕、趙以王諸呂，分齊國為四。忠臣進諫，上惑亂不聽。今高后崩，皇帝春秋富，未能治天下，固恃大臣諸（將）［侯］。今諸呂又擅自尊官，聚兵嚴威，劫列侯忠臣，矯制以令天下，宗廟所以危。今寡人率兵入誅不當為王者。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-052-qidaohui:m012-0000","start":0,"end":3,"surface":"瑯邪王","kind":"person","person_id":"8st_c0j_4fk","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m012-0020","start":20,"end":23,"surface":"齊哀王","kind":"person","person_id":"byp_ks5_71a_AA","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m012-0031","start":31,"end":33,"surface":"高帝","kind":"person","person_id":"byp_ks5_71a","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m012-0043","start":43,"end":46,"surface":"悼惠王","kind":"person","person_id":"byp_ks5_71a_A","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m012-0049","start":49,"end":52,"surface":"悼惠王","kind":"person","person_id":"byp_ks5_71a_A","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m012-0054","start":54,"end":56,"surface":"惠帝","kind":"person","person_id":"mtx_qs1_a5q","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m012-0057","start":57,"end":61,"surface":"留侯張良","kind":"person","person_id":"wwb_4f9_co0","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m012-0064","start":64,"end":66,"surface":"齊王","kind":"person","person_id":"byp_ks5_71a_AA","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m012-0067","start":67,"end":69,"surface":"惠帝","kind":"person","person_id":"mtx_qs1_a5q","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m012-0071","start":71,"end":73,"surface":"高后","kind":"person","person_id":"fwf_1wp_wzg","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m012-0081","start":81,"end":83,"surface":"諸呂","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、未名者、未核官稱或代詞，不補姓名及家屬成員。"},{"id":"c-shiji-052-qidaohui:m012-0085","start":85,"end":87,"surface":"高帝","kind":"person","person_id":"byp_ks5_71a","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m012-0104","start":104,"end":106,"surface":"諸呂","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、未名者、未核官稱或代詞，不補姓名及家屬成員。"},{"id":"c-shiji-052-qidaohui:m012-0113","start":113,"end":115,"surface":"忠臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、未名者、未核官稱或代詞，不補姓名及家屬成員。"},{"id":"c-shiji-052-qidaohui:m012-0125","start":125,"end":127,"surface":"高后","kind":"person","person_id":"fwf_1wp_wzg","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m012-0129","start":129,"end":131,"surface":"皇帝","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、未名者、未核官稱或代詞，不補姓名及家屬成員。"},{"id":"c-shiji-052-qidaohui:m012-0154","start":154,"end":156,"surface":"諸呂","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、未名者、未核官稱或代詞，不補姓名及家屬成員。"},{"id":"c-shiji-052-qidaohui:m012-0170","start":170,"end":172,"surface":"忠臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、未名者、未核官稱或代詞，不補姓名及家屬成員。"}],"chapter_id":"c-shiji-052-qidaohui","book_id":"b-shiji-052","work_id":"w-shiji","source_id":"s-shiji-052-qidaohui"},{"id":"c-shiji-052-qidaohui:p014","text":"呂祿、呂產欲作亂關中，朱虛侯與太尉勃、丞相平等誅之。朱虛侯首先斬呂產，於是太尉勃等乃得盡誅諸呂。而瑯邪王亦從齊至長安。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-052-qidaohui:m014-0000","start":0,"end":2,"surface":"呂祿","kind":"person","person_id":"h29_d0o_1td","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m014-0003","start":3,"end":5,"surface":"呂產","kind":"person","person_id":"gx0_1xv_0gm","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m014-0011","start":11,"end":14,"surface":"朱虛侯","kind":"person","person_id":"byp_ks5_71a_AB","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m014-0015","start":15,"end":18,"surface":"太尉勃","kind":"person","person_id":"2c9_tl4_1sc","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m014-0019","start":19,"end":22,"surface":"丞相平","kind":"person","person_id":"vfk_f6j_nf3","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m014-0026","start":26,"end":29,"surface":"朱虛侯","kind":"person","person_id":"byp_ks5_71a_AB","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m014-0032","start":32,"end":34,"surface":"呂產","kind":"person","person_id":"gx0_1xv_0gm","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m014-0037","start":37,"end":40,"surface":"太尉勃","kind":"person","person_id":"2c9_tl4_1sc","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m014-0045","start":45,"end":47,"surface":"諸呂","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、未名者、未核官稱或代詞，不補姓名及家屬成員。"},{"id":"c-shiji-052-qidaohui:m014-0049","start":49,"end":52,"surface":"瑯邪王","kind":"person","person_id":"8st_c0j_4fk","status":"contextual_provisional"}],"chapter_id":"c-shiji-052-qidaohui","book_id":"b-shiji-052","work_id":"w-shiji","source_id":"s-shiji-052-qidaohui"},{"id":"c-shiji-052-qidaohui:p015","text":"大臣議欲立齊王，而瑯邪王及大臣曰：「齊王母家駟鈞，惡戾，虎而冠者也。方以呂氏故幾亂天下，今又立齊王，是欲復為呂氏也。代王母家薄氏，君子長者；且代王又親高帝子，於今見在，且最為長。以子則順，以善人則大臣安。」於是大臣乃謀迎立代王，而遣朱虛侯以誅呂氏事告齊王，令罷兵。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-052-qidaohui:m015-0000","start":0,"end":2,"surface":"大臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、未名者、未核官稱或代詞，不補姓名及家屬成員。"},{"id":"c-shiji-052-qidaohui:m015-0005","start":5,"end":7,"surface":"齊王","kind":"person","person_id":"byp_ks5_71a_AA","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m015-0009","start":9,"end":12,"surface":"瑯邪王","kind":"person","person_id":"8st_c0j_4