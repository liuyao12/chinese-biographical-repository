27,"surface":"齊王","kind":"person","person_id":"byp_ks5_71a_AA","status":"contextual_provisional"}],"chapter_id":"c-shiji-052-qidaohui","book_id":"b-shiji-052","work_id":"w-shiji","source_id":"s-shiji-052-qidaohui"},{"id":"c-shiji-052-qidaohui:p018","text":"孝文帝元年，盡以高后時所割齊之城陽、瑯邪、濟南郡復與齊，而徙瑯邪王王燕，益封朱虛侯、東牟侯各二千戶。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-052-qidaohui:m018-0000","start":0,"end":3,"surface":"孝文帝","kind":"person","person_id":"28d_4fi_xdp","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m018-0008","start":8,"end":10,"surface":"高后","kind":"person","person_id":"fwf_1wp_wzg","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m018-0030","start":30,"end":33,"surface":"瑯邪王","kind":"person","person_id":"8st_c0j_4fk","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m018-0038","start":38,"end":41,"surface":"朱虛侯","kind":"person","person_id":"byp_ks5_71a_AB","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m018-0042","start":42,"end":45,"surface":"東牟侯","kind":"person","person_id":"byp_ks5_71a_AC","status":"contextual_provisional"}],"chapter_id":"c-shiji-052-qidaohui","book_id":"b-shiji-052","work_id":"w-shiji","source_id":"s-shiji-052-qidaohui"}],"sources":[{"chapter_id":"c-shiji-052-qidaohui","work_id":"w-shiji","book_id":"b-shiji-052","source_id":"s-shiji-052-qidaohui","source":{"title":"史記／卷052","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷052","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷052&oldid=5977113","revision_id":5977113,"accessed_on":"2026-10-09","extent":"44段篇文及1段索隱述贊，數位分節欄題不作古文段落。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"取得時HTML與固定修訂一致，只去外緣空白；保留衛衛王、高后立諸呂諸呂、（西）［迺］、［建］延、硃虛等原字與校勘字樣，不擅刪重字或選讀法。","note":"全45段已讀並作明示人物首輪；未核底本、影像或現代研究。"}}