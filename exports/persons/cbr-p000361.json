{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000361","identity_policy":"contextual_provisional","person_ids":["cbr-p000361"],"persons":[{"id":"cbr-p000361","label":"管至父","status":"active","historicity":"historical_tradition","aliases":[{"surface":"管至父","mention_ids":["c-shiji-005-qin:m014-0006","c-shiji-005-qin:m014-0040","c-shiji-032-qi:m027-0012","c-shiji-032-qi:m027-0170","c-shiji-039-jin:m019-0026"]}],"evidence":[{"mention_id":"c-shiji-005-qin:m014-0006","chapter_id":"c-shiji-005-qin","paragraph_id":"c-shiji-005-qin:p014","quote":"管至父"},{"mention_id":"c-shiji-005-qin:m014-0040","chapter_id":"c-shiji-005-qin","paragraph_id":"c-shiji-005-qin:p014","quote":"管至父"},{"mention_id":"c-shiji-032-qi:m027-0012","chapter_id":"c-shiji-032-qi","paragraph_id":"c-shiji-032-qi:p027","quote":"管至父"},{"mention_id":"c-shiji-032-qi:m027-0170","chapter_id":"c-shiji-032-qi","paragraph_id":"c-shiji-032-qi:p027","quote":"管至父"},{"mention_id":"c-shiji-039-jin:m019-0026","chapter_id":"c-shiji-039-jin","paragraph_id":"c-shiji-039-jin:p019","quote":"管至父"}],"identity_note":"依本卷特定時代與敘事暫定身份；稱號同字不跨時代合併，未見本名不補造。","review":"ai_provisional"}],"mentions":[{"id":"c-shiji-005-qin:m014-0006","start":6,"end":9,"surface":"管至父","kind":"person","person_id":"cbr-p000361","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p014","chapter_id":"c-shiji-005-qin"},{"id":"c-shiji-005-qin:m014-0040","start":40,"end":43,"surface":"管至父","kind":"person","person_id":"cbr-p000361","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p014","chapter_id":"c-shiji-005-qin"},{"id":"c-shiji-032-qi:m027-0012","start":12,"end":15,"surface":"管至父","kind":"person","person_id":"cbr-p000361","status":"contextual_provisional","paragraph_id":"c-shiji-032-qi:p027","chapter_id":"c-shiji-032-qi"},{"id":"c-shiji-032-qi:m027-0170","start":170,"end":173,"surface":"管至父","kind":"person","person_id":"cbr-p000361","status":"contextual_provisional","paragraph_id":"c-shiji-032-qi:p027","chapter_id":"c-shiji-032-qi"},{"id":"c-shiji-039-jin:m019-0026","start":26,"end":29,"surface":"管至父","kind":"person","person_id":"cbr-p000361","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p019","chapter_id":"c-shiji-039-jin"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji032-045","person_id":"cbr-p000361","surfaces":["管至父"],"scope":"cross_chapter","chapter_ids":["c-shiji-005-qin","c-shiji-032-qi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-005-qin:p014","quote":"十三年，齊人管至父、連稱等殺其君襄公而立公孫無知。晉滅霍、魏、耿。齊雍廩殺無知、管至父等而立齊桓公。齊、晉為彊國。"},{"paragraph_id":"c-shiji-032-qi:p027","quote":"十二年，初，襄公使連稱、管至父戍葵丘，瓜時而往，及瓜而代。往戍一歲，卒瓜時而公弗為發代。或為請代，公弗許。故此二人怒，因公孫無知謀作亂。連稱有從妹在公宮，無寵，使之閒襄公，曰「事成以女為無知夫人」。冬十二月，襄公游姑棼，遂獵沛丘。見彘，從者曰「彭生」。公怒，射之，彘人立而啼。公懼，墜車傷足，失屨。反而鞭主屨者茀三百。茀出宮。而無知、連稱、管至父等聞公傷，乃遂率其眾襲宮。逢主屨茀，茀曰：「且無入驚宮，驚宮未易入也。」無知弗信，茀示之創，乃信之。待宮外，令茀先入。茀先入，即匿襄公戶閒。良久，無知等恐，遂入宮。茀反與宮中及公之幸臣攻無知等，不勝，皆死。無知入宮，求公不得。或見人足於戶閒，發視，乃襄公，遂弒之，而無知自立為齊君。"}],"rationale":"按本篇小白立桓公、管仲任政、葵丘盟會及齊君／母親的明示敘事相接暫定；魯與齊的同號君主、同氏女性分開，不作全庫字串合併。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji039-043","person_id":"cbr-p000361","surfaces":["管至父"],"scope":"cross_chapter","chapter_ids":["c-shiji-005-qin","c-shiji-039-jin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-005-qin:p014","quote":"十三年，齊人管至父、連稱等殺其君襄公而立公孫無知。晉滅霍、魏、耿。齊雍廩殺無知、管至父等而立齊桓公。齊、晉為彊國。"},{"paragraph_id":"c-shiji-039-jin:p019","quote":"晉侯緡四年，宋執鄭祭仲而立突爲鄭君。晉侯十九年，齊人管至父弒其君襄公。"}],"rationale":"按本篇明示名與稱號、晉世系與具體事件暫定所列提及同指；附各段原文，未按同字短名全域合併；紀年與版本差異待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-005-qin:p014","text":"十三年，齊人管至父、連稱等殺其君襄公而立公孫無知。晉滅霍、魏、耿。齊雍廩殺無知、管至父等而立齊桓公。齊、晉為彊國。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m014-0006","start":6,"end":9,"surface":"管至父","kind":"person","person_id":"cbr-p000361","status":"contextual_provisional"},{"id":"c-shiji-005-qin