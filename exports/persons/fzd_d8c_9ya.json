al_mention_id":"c-sanguozhi-054-zhouyu:line011:m0166","mention_ids":["c-sanguozhi-054-zhouyu:line011:m0166"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-sanguozhi-050-wu","s-sanguozhi-054-zhouyu"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-050-wu:line014:m0103","start":103,"end":105,"surface":"薛禮","kind":"person","person_id":"fzd_d8c_9ya","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-050-wu:line014","chapter_id":"c-sanguozhi-050-wu"},{"id":"c-sanguozhi-054-zhouyu:line011:m0166","start":166,"end":168,"surface":"薛禮","kind":"person","person_id":"fzd_d8c_9ya","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-054-zhouyu:line011","chapter_id":"c-sanguozhi-054-zhouyu"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-050-wu:line014","text":"景常隨堅征伐有功，拜騎都尉。袁術上景領丹楊太守，討故太守周昕，遂據其郡。孫策與孫河、呂範依景，合眾共討涇縣山賊祖郎。郎敗走。會為劉繇所迫，景復北依術，術以為督軍中郎將，與孫賁共討樊能、於麋於橫江，又擊笮融、薛禮於秣陵。時策被創牛渚，降賊復反，景攻討，盡禽之。從討劉繇，繇奔豫章，策遣景、賁到壽春報術。術方與劉備爭徐州，以景為為廣陵太守。術後僭號。策以書喻術，術不納，便絕江津，不與通，使人告景。景即委郡東歸，策復以景為丹揚太守。漢遣議郎王誧銜命南行，表景為揚武將軍，領郡如故。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-050-wu:line014:m0000","start":0,"end":1,"surface":"景","kind":"person","person_id":"ere_ume_47r","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-wu:line014:m0003","start":3,"end":4,"surface":"堅","kind":"person","person_id":"ki7_rgz_3l4","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-wu:line014:m0015","start":15,"end":16,"surface":"術","kind":"person","person_id":"865_b69_cb0","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-wu:line014:m0017","start":17,"end":18,"surface":"景","kind":"person","person_id":"ere_ume_47r","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-wu:line014:m0028","start":28,"end":30,"surface":"周昕","kind":"person","person_id":"lsy_sjz_pse","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-wu:line014:m0037","start":37,"end":38,"surface":"策","kind":"person","person_id":"e9c_070_567","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-wu:line014:m0039","start":39,"end":41,"surface":"孫河","kind":"person","person_id":"07n_fwj_5jn","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-wu:line014:m0042","start":42,"end":44,"surface":"呂範","kind":"person","person_id":"908_816_219","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-wu:line014:m0045","start":45,"end":46,"surface":"景","kind":"person","person_id":"ere_ume_47r","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-wu:line014:m0056","start":56,"end":57,"surface":"郎",