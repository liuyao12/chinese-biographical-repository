d":"c-sanguozhi-054-zhouyu:line011:m0166","start":166,"end":168,"surface":"薛禮","kind":"person","person_id":"fzd_d8c_9ya","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-054-zhouyu:line011","chapter_id":"c-sanguozhi-054-zhouyu"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-049-zerong-complete:p001","text":"　　笮融者，丹楊人。初聚眾數百，往依徐州牧陶謙。謙使督廣陵、彭城運漕，遂放縱擅殺，坐斷三郡委輸以自入。乃大起浮圖祠，以銅為人，黃金塗身，衣以錦采，垂銅槃九重，下為重樓閣道，可容三千餘人。悉課讀佛經，令界內及旁郡人有好佛者聽受道，復其他役以招致之，由此遠近前後至者五千餘人戶。每浴佛，多設酒飯，布席於路，經數十里，民人來觀及就食且萬人，費以巨億計。曹公攻陶謙，徐土騷動，融將男女數萬口，馬三千匹，走廣陵，廣陵太守趙昱待以賓禮。先是，彭城相薛禮為陶謙所逼，屯秣陵。融利廣陵之眾，因酒酣殺昱，放兵大略，因載而去。過殺禮，然後殺皓。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":16,"last_line":16,"raw_start":1404,"raw_end":1666,"raw_character_offsets":[1404,1405,1406,1407,1408,1409,1410,1411,1412,1413,1414,1415,1416,1417,1418,1419,1420,1421,1422,1423,1424,1425,1426,1427,1428,1429,1430,1431,1432,1433,1434,1435,1436,1437,1438,1439,1440,1441,1442,1443,1444,1445,1446,1447,1448,1449,1450,1451,1452,1453,1454,1455,1456,1457,1458,1459,1460,1461,1462,1463,1464,1465,1466,1467,1468,1469,1470,1471,1472,1473,1474,1475,1476,1477,1478,1479,1480,1481,1482,1483,1484,1485,1486,1487,1488,1489,1490,1491,1492,1493,1494,1495,1496,1497,1498,1499,1500,1501,1502,1503,1504,1505,1506,1507,1508,1509,1510,1511,1512,1513,1514,1515,1516,1517,1518,1519,1520,1521,1522,1523,1524,1525,1526,1527,1528,1529,1530,1531,1532,1533,1534,1535,1536,1537,1538,1539,1540,1541,1542,1543,1544,1545,1546,1547,1548,1549,1550,1551,1552,1553,1554,1555,1556,1557,1558,1559,1560,1561,1562,1563,1564,1565,1566,1567,1568,1569,1570,1571,1572,1573,1574,1575,1576,1577,1578,1579,1580,1581,1582,1583,1584,1585,1586,1587,1588,1589,1590,1591,1592,1593,1594,1595,1596,1597,1598,1599,1600,1601,1602,