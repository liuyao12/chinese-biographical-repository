etation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-zhouyu:line011:m0017","start":17,"end":18,"surface":"景","kind":"person","person_id":"sk1_f2q_pzy","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-zhouyu:line011:m0019","start":19,"end":20,"surface":"景","kind":"person","person_id":"sk1_f2q_pzy","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-zhouyu:line011:m0021","start":21,"end":22,"surface":"忠","kind":"person","person_id":"sk1_f2q_pzy_A","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-zhouyu:line011:m0030","start":30,"end":31,"surface":"異","kind":"person","person_id":"xt5_pzf_pyb","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-zhouyu:line011:m0036","start":36,"end":37,"surface":"瑜","kind":"person","person_id":"f56_938_997","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-zhouyu:line011:m0045","start":45,"end":47,"surface":"孫堅","kind":"person","person_id":"ki7_rgz_3l4","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-zhouyu:line011:m0051","start":51,"end":53,"surface":"董卓","kind":"person","person_id":"a50_1e6_4bf","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-zhouyu:line011:m0059","start":59,"end":60,"surface":"堅","kind":"person","person_id":"ki7_rgz_3l4","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-zhouyu:line011:m0061","start":61,"end":62,"surface":"策","kind":"person","person_id":"e9c_070_567","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-zhouyu:line011:m0063","start":63,"end":64,"surface":"瑜","kind":"person","person_id":"f56_938_997","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-zhouyu:line01