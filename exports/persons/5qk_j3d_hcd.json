{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"5qk_j3d_hcd","canonical_person_id":"5qk_j3d_hcd","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["5qk_j3d_hcd"],"persons":[{"id":"5qk_j3d_hcd","label":"董生（太史公自序候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"董生","mention_ids":["c-shiji-130-taishigong:m009-0028"]}],"evidence":[{"mention_id":"c-shiji-130-taishigong:m009-0028","chapter_id":"c-shiji-130-taishigong","paragraph_id":"c-shiji-130-taishigong:p009","quote":"董生"}]}],"source_mention_summary":[{"source_id":"s-shiji130-taishigong","work_id":"w-shiji","book_id":"b-shiji-130","chapter_id":"c-shiji-130-taishigong","mention_count":1,"mention_ids":["c-shiji-130-taishigong:m009-0028"],"paragraph_ids":["c-shiji-130-taishigong:p009"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji130-taishigong"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-130-taishigong:m009-0028","start":28,"end":30,"surface":"董生","kind":"person","person_id":"5qk_j3d_hcd","status":"contextual_provisional","paragraph_id":"c-shiji-130-taishigong:p009","chapter_id":"c-shiji-130-taishigong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-130-taishigong:p009","text":"上大夫壺遂曰：「昔孔子何為而作春秋哉？」太史公曰：「余聞董生曰：『周道衰廢，孔子為魯司寇，諸侯害之，大夫壅之。孔子知言之不用，道之不行也，是非二百四十二年之中，以為天下儀表，貶天子，退諸侯，討大夫，以達王事而已矣。』子曰：『我欲載之空言，不如見之於行事之深切著明也。』夫春秋，上明三王之道，下辨人事之紀，別嫌疑，明是非，定猶豫，善善惡惡，賢賢賤不肖，存亡國，繼絕世，補敝起廢，王道之大者也。易著天地陰陽四時五行，故長於變；禮經紀人倫，故長於行；書記先王之事，故長於政；詩記山川谿谷禽獸草木牝牡雌雄，故長於風；樂樂所以立，故長於和；春秋辯是非，故長於治人。是故禮以節人，樂以發和，書以道事，詩以達意，易以道化，春秋以道義。撥亂世反之正，莫近於春秋。春秋文成數萬，其指數千。萬物之散聚皆在春秋。春秋之中，弒君三十六，亡國五十二，諸侯奔走不得保其社稷者不可勝數。察其所以，皆失其本已。故易曰『失之豪釐，差以千里』。故曰『臣弒君，子弒父，非一旦一夕之故也，其漸久矣』。故有國者不可以不知春秋，前有讒而弗見，後有賊而不知。為人臣者不可以不知春秋，守經事而不知其宜，遭變事而不知其權。為人君父而不通於春秋之義者，必蒙首惡之名。為人臣子而不通於春秋之義者，必陷篡弒之誅，死罪之名。其實皆以為善，為之不知其義，被之空言而不敢辭。夫不通禮義之旨，至於君不君，臣不臣，父不父，子不子。夫君不君則犯，臣不臣則誅，父不父則無道，子不子則不孝。此四行者，天下之大過也。以天下之大過予之，則受而弗敢辭。故春秋者，禮義之大宗也。夫禮禁未然之前，法施已然之後；法之所為用者易見，而禮之所為禁者難知。」","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m009-0003","start":3,"end":5,"surface":"壺遂","kind":"person","person_id":"sxq_1wd_ih9","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m009-0009","start":9,"end":11,"surface":"孔子","kind":"person","person_id":"8zh_d7n_e93","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m009-0020","start":20,"end":23,"surface":"太史公","kind":"person","person_id":"pme_eis_xqi_*A*AAAAA","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m009-0028","start":28,"end":30,"surface":"董生","kind":"person","person_id":"5qk_j3d_hcd","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m009-0038","start":38,"end":40,"surface":"孔子","kind":"person","person_id":"8zh_d7n_e93","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m009-0055","start":55,"end":57,"surface":"孔子","kind":"person","person_id":"8zh_d7n_e93","status":"contextual_provisional"}],"chapter_id":"c-shiji-130-taishigong","book_id":"b-shiji-130","work_id":"w-shiji","source_id":"s-shiji130-taishigong"}],"sources":[{"chapter_id":"c-shiji-130-taishigong","work_id":"w-shiji","book_id":"b-shiji-130","source_id":"s-shiji130-taishigong","source":{"title":"史記／卷130","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷130","permalink":"https: