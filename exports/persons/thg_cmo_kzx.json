tion_note":"原文玄孫，中間一代未具名。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-048-kongzhigui-complete:p001:m0085","start":85,"end":88,"surface":"杜子恭","kind":"person","person_id":"thg_cmo_kzx","status":"contextual_provisional","paragraph_id":"c-nanqishu-048-kongzhigui-complete:p001","chapter_id":"c-nanqishu-048-kongzhigui-complete"},{"id":"c-nanqishu-054-recluses-complete:p062:m0015","start":15,"end":18,"surface":"杜子恭","kind":"person","person_id":"thg_cmo_kzx","status":"contextual_provisional","paragraph_id":"c-nanqishu-054-recluses-complete:p062","chapter_id":"c-nanqishu-054-recluses-complete"}],"relations":[{"id":"a-qi054-dujingchan-xuan","subject_person_id":"cx3_7fo_lvx","object_person_id":"thg_cmo_kzx","predicate":"ancestor","qualifiers":{"source_term":"杜子恭玄孫也","lineage":"paternal","generation_distance":4},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-054","chapter_id":"c-nanqishu-054-recluses-complete","source_id":"s-nanqishu-054-recluses-complete-ws1762878","paragraph_id":"c-nanqishu-054-recluses-complete:p062","quote":"　　杜京產字景齊，吳郡錢唐人。杜子恭玄孫也。祖運，爲劉毅衞軍參軍，父道鞠，州從事，善彈棋，世傳五斗米道，至京產及子栖。","subject_person_mention_id":"c-nanqishu-054-recluses-complete:p062:m0002","object_person_mention_id":"c-nanqishu-054-recluses-complete:p062:m0015"}],"status":"source_attested","interpretation_note":"原文玄孫，中間一代未具名。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-048-kongzhigui-complete:p001","text":"　　孔稚珪字德璋，會稽山陰人也。祖道隆，位侍中。父靈產，泰始中，罷晉安太守。有隱遁之懷，於禹井山立館，事道精篤，吉日於靜屋四向朝拜，涕泗滂遝。東出過錢塘北郭，輙於舟中遙拜杜子恭墓，自此至都，東向坐，不敢背側。元徽中，爲中散、太中大夫。頗解星文，好術數。太祖輔政，沈攸之起兵，靈產密白太祖曰：「攸之兵衆雖彊，以天時冥數而觀，無能爲也。」太祖驗其言，擢遷光祿大夫。以簏盛靈產上靈臺，令其占候。餉靈產白羽扇、素隱几。曰：「君性好古，故遺君古物。」","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":28,"last_line":28,"raw_start":977,"raw_end":1197,"raw_character_offsets":[977,978,979,980,981,982,983,984,985,986,987,988,989,990,991,992,993,994,995,996,997,998,999,1000,1001,1002,1003,1004,1005,1006,1007,1008,1009,1010,1011,1012,1013,1014,1015,1016,1017,1018,1019,1020,1021,1022,1023,1024,1025,1026,1027,1028,1029,1030,1031,1032,1033,1034,1035,1036,1037,1038,1039,1040,1041,1042,1043,1044,1045,1046,1047,1048,1049,1050,1051,1052,1053,1054,1055,1056,1057,1058,1059,1060,1061,1062,1063,1064,1065,1066,1067,1068,1069,1070,1071,1072,1073,1074,1075,1076,1077,1078,1079,1080,1081,1082,1083,1084,1085,1086,1087,1088,1089,1090,1091,1092,1093,1094,1095,1096,1097,1098,1099,1100,1101,1102,1103,1104,1105,1106,1107,1108,1109,1110,1111,1112,1113,1114,1115,1116,1117,1118,1119,1120,1121,1122,1123,1124,1125,1126,1127,1128,1129,1130,1131,1132,1133,1134,1135,1136,1137,1138,1139,1140,1141,1142,1143,1144,1145,1146,1147,1148,1149,1150,1151,1152,1153,1154,1155,1156,1157,1158,1159,1160,1161,1162,1163,1164,1165,1166,1167,1168,1169,1170,1171,1172,1173,1174,1175,1176,1177,1178,1179,1180,1181,1182,1183,1184,1185,1186,1187,1188,1189,1190,1191,1192,1193,1194,1195,1196],"revision_id":1511898},"mentions":[{"id":"c-nanqishu-048-kongzhigui-complete:p001:m0002","start":2,"end":5,"surface":"孔稚珪","kind":"person","person_id":"z6r_wtu_wuj","status":"contextual_provisional"},{"id":"c-nanqishu-048-kongzhigui-complete:p001:m0006","start":6,"end":8,"surface":"德璋","kind":"person","person_id":"z6r_wtu_wuj","status":"contextual_provisional"},{"id":"c-nanqishu-048-kongzhigui-complete:p001:m0017","start":17,"end":19,"surface":"道隆","kind":"person","person_id":"fhf_kuv_fh5","status":"contextual_provisional"},{"id":"c-nanqishu-048-kongzhigui-complete:p001:m0025","start":25,"end":27,"surface":"靈產","kind":"person","person