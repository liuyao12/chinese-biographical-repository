referred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-035-peikai-family:p016:m0091","start":91,"end":93,"surface":"滿衡","kind":"person","person_id":"qhw_riw_kkj","status":"contextual_provisional","paragraph_id":"c-jinshu-035-peikai-family:p016","chapter_id":"c-jinshu-035-peikai-family"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-035-peikai-family:p016","text":"楷長兄黎，次兄康，並知名。康子盾，少曆顯位。永嘉中，為徐州刺史，委任長史司馬奧。奧勸盾刑殺立威，大發良人為兵，有不奉法者罪便至死。在任三年，百姓嗟怨。東海王越，盾妹夫也。越既薨，騎督滿衡便引所發良人東還。尋而劉元海遣將王桑、趙固向彭城，前鋒數騎至下邳，文武不堪苛政，悉皆散走，盾、奧奔淮陰，妻子為賊人所得。奧又誘盾降趙固。固妻盾女，有寵，盾向女涕泣，固遂殺之。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-035-peikai-family:p016:m0000","start":0,"end":1,"surface":"楷","kind":"person","person_id":"4ni_4t1_4o9_BC","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p016:m0003","start":3,"end":4,"surface":"黎","kind":"person","person_id":"4ni_4t1_4o9_BA","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p016:m0007","start":7,"end":8,"surface":"康","kind":"person","person_id":"4ni_4t1_4o9_BB","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p016:m0013","start":13,"end":14,"surface":"康","kind":"person","person_id":"4ni_4t1_4o9_BB","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p016:m0015","start":15,"end":16,"surface":"盾","kind":"person","person_id":"4ni_4t1_4o9_BBB","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p016:m0036","start":36,"end":39,"surface":"司馬奧","kind":"person","person_id":"xbg_ioy_mi3","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p016