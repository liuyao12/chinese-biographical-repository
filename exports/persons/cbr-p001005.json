ns":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-012-wudi:p037","text":"是時既滅南越，越人勇之乃言「越人俗信鬼，而其祠皆見鬼，數有效。昔東甌王敬鬼，壽至百六十歲。後世謾怠，故衰秏」。乃令越巫立越祝祠，安臺無壇，亦祠天神上帝百鬼，而以雞卜。上信之，越祠雞卜始用焉。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-012-wudi:m037-0009","start":9,"end":11,"surface":"勇之","kind":"person","person_id":"w5h_6ah_6b1","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m037-0032","start":32,"end":35,"surface":"東甌王","kind":"person","person_id":"xzr_i9s_mnp","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m037-0073","start":73,"end":75,"surface":"上帝","kind":"unresolved","person_id":null,"status":"unresolved","note":"神祇、群體、匿名者或未定指代，保留來源，不補未見姓名與成員。"}],"chapter_id":"c-shiji-012-wudi","book_id":"b-shiji-012","work_id":"w-shiji","source_id":"s-shiji-012-wudi"},{"id":"c-shiji-012-wudi:p045","text":"上還，以柏梁災故，朝受計甘泉。公孫卿曰：「黃帝就青靈臺，十二日燒，黃帝乃治明庭。明庭，甘泉也。」方士多言古帝王有都甘泉者。其後天子又朝諸侯甘泉，甘泉作諸侯邸。勇之乃曰：「越俗有火災，復起屋必以大，用勝服之。」於是作建章宮，度為千門萬戶。前殿度高未央，其東則鳳闕，高二十餘丈。其西則唐中，數十里虎圈。其北治大池，漸臺高二十餘丈，名曰泰液池，中有蓬萊、方丈、瀛洲、壺梁，象海中神山龜魚之屬。其南有玉堂、璧門、大鳥之屬。乃立神明臺、井幹樓，度五十餘丈，輦道相屬焉。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-012-wudi:m045-0015","start":15,"end":18,"surface":"公孫卿","kind":"person","person_id":"lgo_cwi_085","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m045-0021","start":21,"end":23,"surface":"黃帝","kind":"person","person_id":"8jz_o3s_obt","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m045-0033","start":33,"end":35,"surface":"黃帝","kind":"person","person_id":"8jz_o3s_obt","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m045-0063","start":63,"end":65,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m045-0079","st