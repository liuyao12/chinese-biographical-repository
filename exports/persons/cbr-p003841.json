I 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji066-034","person_id":"cbr-p003841","scope":"same_chapter","chapter_ids":["c-shiji-066-wu"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["孔子"],"evidence":[{"paragraph_id":"c-shiji-066-wu:p015","quote":"其後四年，孔子相魯。"}],"rationale":"依本篇明示姓名及局部敘事暫接異稱：公子光自立為闔廬、軫立為昭王、勝號白公；王稱隨敘事主體分段。王子綦佯充王不接昭王，與後文司馬子綦暫分候選但不斷言異人。悼公與陽生按本文分存，矛盾待版本覆核；鮑氏不強接鮑牧。未名父子只按本段明示保存，不補姓名。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-066-wu:p015","text":"其後四年，孔子相魯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-066-wu:m015-0005","start":5,"end":7,"surface":"孔子","kind":"person","person_id":"cbr-p003841","status":"contextual_provisional"}],"chapter_id":"c-shiji-066-wu","book_id":"b-shiji-066","work_id":"w-shiji","source_id":"s-shiji-066-wu"}],"sources":[{"chapter_id":"c-shiji-066-wu","work_id":"w-shiji","book_id":"b-shiji-066","source_id":"s-shiji-066-wu","source":{"title":"史記／卷066","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷066","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷066&oldid=2621138","revision_id":2621138,"accessed_on":"2026-10-09","extent":"24段正文，排除註釋版及2段導覽，無索隱述贊。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"取得時HTML與固定修訂一致，只去外緣空白。保留堂谿、（之）、忍訽、屬鏤、鴟夷等原字與括號文字，未核定校勘。","note":"全24段已核讀並作人物首輪；未核可靠底本、影像或現代研究。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical"}}
