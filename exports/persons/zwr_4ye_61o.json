{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"zwr_4ye_61o","canonical_person_id":"zwr_4ye_61o","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["zwr_4ye_61o"],"persons":[{"id":"zwr_4ye_61o","label":"蕭奉之（西平太守，宣帝兄）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"奉之","mention_ids":["c-nanqishu-045-daosheng-complete:p012:m0015"]}],"evidence":[{"mention_id":"c-nanqishu-045-daosheng-complete:p012:m0015","paragraph_id":"c-nanqishu-045-daosheng-complete:p012","chapter_id":"c-nanqishu-045-daosheng-complete","quote":"奉之"}],"review":"ai_provisional","identity_note":"蕭奉之（西平太守，宣帝兄），見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-nanqishu-045-daosheng-complete-ws2273185","work_id":"w-nanqishu","book_id":"b-nanqishu-045","chapter_id":"c-nanqishu-045-daosheng-complete","raw_mention_count":1,"mention_ids":["c-nanqishu-045-daosheng-complete:p012:m0015"],"paragraph_ids":["c-nanqishu-045-daosheng-complete:p012"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-nanqishu-045-daosheng-complete:p012:m0015","mention_ids":["c-nanqishu-045-daosheng-complete:p012:m0015"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-nanqishu-045-daosheng-complete-ws2273185"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-045-daosheng-complete:p012:m0015","start":15,"end":17,"surface":"奉之","kind":"person","person_id":"zwr_4ye_61o","status":"contextual_provisional","paragraph_id":"c-nanqishu-045-daosheng-complete:p012","chapter_id":"c-nanqishu-045-daosheng-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-045-daosheng-complete:p012","text":"　　遙欣字重暉。宣帝兄西平太守奉之無後，以遙欣繼爲曾孫。除祕書郎，太子舍人，巴陵王文學，中書郎。延興元年，高宗樹置，以遙欣爲持節、督兖州緣淮軍事、寧朔將軍、兖州刺史。仍爲督豫州郢州之西陽司州之汝南二郡、輔國將軍、豫州刺史，持節如故。未之任。建武元年，進號西中郎將，封聞喜縣公。遷使持節、都督荊雍益寧梁南北秦七州軍事、右將軍、荊州刺史。改封曲江公。高宗子弟弱小，晉安王寶義有廢疾，故以遙光爲揚州居中，遙欣居陝西在外，權勢竝在其門。遙欣好勇，聚畜武士，以爲形援。四年，進號平西將軍。永泰元年，以雍州虜寇，詔遙欣以本官領刺史，寧蠻校尉，移鎮襄陽，虜退不行。永元元年卒，年三十一。贈侍中、司空，謚康公。葬用王禮。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":45,"last_line":45,"raw_start":2401,"raw_end":2733,"raw_character_offsets":[2401,2402,2406,2407,2411,2412,2413,2414,2415,2416,2417,2418,2419,2420,2421,2422,2423,2424,2425,2426,2427,2428,2429,2430,2431,2432,2433,2434,2435,2436,2437,2438,2439,2440,2441,2442,2443,2444,2445,2446,2447,2448,2449,2450,2451,2452,2453,2454,2460,2461,2462,2463,2471,2472,2473,2474,2475,2476,2477,2478,2479,2480,2481,2482,2483,2484,2485,2486,2487,2488,2489,2490,2491,2492,2493,2494,2495,2496,2497,2498,2499,2500,2501,2502,2503,2504,2505,2506,2507,2508,2509,2510,2511,2512,2513,2514,2515,2516,2517,2518,2519,2520,2521,2522,2523,2524,2525,2526,2527,2528,2529,2530,2531,2532,2533,2534,2535,2536,2537,2538,2539,2540,2541,2542,2543,2544,2545,2546,2547,2548,2549,2550,2551,2552,2553,2554,2555,2556,2557,2558,2559,2560,2561,2562,2563,2564,2565,2566,2567,2568,2569,2570,2571,2572,2573,2574,2575,257