ue","work_id":"w-shiji","book_id":"b-shiji-114","chapter_id":"c-shiji-114-dongyue","mention_count":3,"mention_ids":["c-shiji-114-dongyue:m002-0010","c-shiji-114-dongyue:m002-0043","c-shiji-114-dongyue:m003-0000"],"paragraph_ids":["c-shiji-114-dongyue:p002","c-shiji-114-dongyue:p003"],"passage_count":2}],"most_mentioned_source_ids":["s-shiji114-dongyue"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji114-003","subject_person_id":"qfq_48j_lpj_A","predicate":"father","object_person_id":"qfq_48j_lpj","status":"source_attested","evidence":[{"chapter_id":"c-shiji-114-dongyue","source_id":"s-shiji114-dongyue","paragraph_id":"c-shiji-114-dongyue:p002","quote":"後數世，至孝景三年，吳王濞反，欲從閩越，閩越未肯行，獨東甌從吳。及吳破，東甌受漢購，殺吳王丹徒，以故皆得不誅，歸國。"},{"chapter_id":"c-shiji-114-dongyue","source_id":"s-shiji114-dongyue","paragraph_id":"c-shiji-114-dongyue:p003","quote":"吳王子子駒亡走閩越，怨東甌殺其父，常勸閩越擊東甌。至建元三年，閩越發兵圍東甌。東甌食盡，困，且降，乃使人告急天子。天子問太尉田蚡，蚡對曰：「越人相攻擊，固其常，又數反覆，不足以煩中國往救也。自秦時棄弗屬。」於是中大夫莊助詰蚡曰：「特患力弗能救，德弗能覆；誠能，何故棄之？且秦舉咸陽而棄之，何乃越也！今小國以窮困來告急天子，天子弗振，彼當安所告愬？又何以子萬國乎？」上曰：「太尉未足與計。吾初即位，不欲出虎符發兵郡國。」乃遣莊助以節發兵會稽。會稽太守欲距不為發兵，助乃斬一司馬，諭意指，遂發兵浮海救東甌。未至，閩越引兵而去。東甌請舉國徙中國，乃悉舉眾來，處江淮之閒。"}],"qualifiers":{"source_term":"吳王子子駒"},"interpretation_note":"吳王子承接上段濞及東甌殺其父，子駒為姓名，不作排行。","reviewer":"Codex（AI 代理）","context":{"kind":"adjacent_paragraphs","paragraph_ids":["c-shiji-114-dongyue:p002","c-shiji-114-dongyue:p003"]}}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-shiji114-p002-qfq_48j_lpj","person_id":"qfq_48j_lpj","event_type":"death","status":"source_attested","date_expression":"孝景三年","evidence":[{"chapter_id":"c-shiji-114-dongyue","source_id":"s-shiji114-dongyue"