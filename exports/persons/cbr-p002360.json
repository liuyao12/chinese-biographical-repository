b_AAAAA","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p052","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m054-0004","start":4,"end":6,"surface":"成侯","kind":"person","person_id":"1za_blw_7lb_AAAAA","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p054","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m054-0106","start":106,"end":108,"surface":"成侯","kind":"person","person_id":"1za_blw_7lb_AAAAA","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p054","chapter_id":"c-shiji-043-zhao"}],"relations":[{"id":"a-shiji043-050","subject_person_id":"1za_blw_7lb_AAAAA","predicate":"father","object_person_id":"1za_blw_7lb_AAAA","status":"source_attested","evidence":[{"chapter_id":"c-shiji-043-zhao","source_id":"s-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p051","quote":"十一年，魏、韓、趙共滅晉，分其地。伐中山，又戰於中人。十二年，敬侯卒，子成侯種立。"}],"qualifiers":{"source_term":"子成侯種","historicity":"historical_tradition"},"interpretation_note":"保存明示子、女與君主太子上下文來源主張；爭立不推兄弟，未名先王不補父子。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji043-131","person_id":"1za_blw_7lb_AAAAA","surfaces":["子成侯種","成侯"],"scope":"same_chapter","chapter_ids":["c-shiji-043-zhao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-043-zhao:p051","quote":"十一年，魏、韓、趙共滅晉，分其地。伐中山，又戰於中人。十二年，敬侯卒，子成侯種立。"},{"paragraph_id":"c-shiji-043-zhao:p052","quote":"成侯元年，公子勝與成侯爭立，爲亂。二年六月，雨雪。三年，太戊午爲相。伐衞，取鄕邑七十三。魏敗我藺。四年，與秦戰髙安，敗之。五年，伐齊于鄄。魏敗我懷。攻鄭，敗之，以與韓，韓與我長子。六年，中山筑長城。伐魏，敗湪澤，圍魏惠王。七年，侵齊，至長城。與韓攻周。八年，與韓分周以爲兩。九年，與齊戰阿下。十年，攻衞，取甄。十一年，秦攻魏，趙救之石阿。十二年，秦攻魏少梁，趙救之。十三年，秦獻公使庶長國伐魏少梁，虜其太子、痤。魏敗我澮，取皮牢。成侯與韓昭侯遇上黨。十四年，與韓攻秦。十五年，助魏攻齊。"},{"paragraph_id":"c-shiji-043-zhao:p054","quote":"十七年，成侯與魏惠王遇葛孽。十九年，與齊、宋會平陸，與燕會阿。二十年，魏獻榮椽，因以爲檀臺。二十一年，魏圍我邯鄲。二十二年，魏惠王拔我邯鄲，齊亦敗魏於桂陵。二十四年，魏歸我邯鄲，與魏盟漳水上。秦攻我藺。二十五年，成侯卒。公子紲太子肅侯爭立，紲敗亡奔韓。"}],"rationale":"限本篇明示姓名、是為與連續事件；太戊午／大戊午暫接但字形待底本核查。娃嬴／孟姚／惠后按本段明示暫接，不與先前夢辭孟姚按同名合併；王紲與較早公子紲分候選。君王職稱按各國上下文辨別，不全域匹配。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-043-zhao:p051","text":"十一年，魏、韓、趙共滅晉，分其地。伐中山，又戰於中人。十二年，敬侯卒，子成侯種立。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-043-zhao:m051-0031","start":31,"end":33,"surface":"敬侯","kind":"person","person_id":"1za_blw_7lb_AAAA","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m051-0035","start":35,"end":39,"surface":"子成侯種","kind":"person","person_id":"1za_blw_7lb_AAAAA","status":"contextual_provisional"}],"chapter_id":"c-shiji-043-zhao","book_id":"b-shiji-043","work_id":"w-shiji","source_id":"s-shiji-043-zhao"},{"id":"c-shiji-043-zhao:p052","text":"成侯元年，公子勝與成侯爭立，爲亂。二年六月，雨雪。三年，太戊午爲相。伐衞，取鄕邑七十三。魏敗我藺。四年，與秦戰髙安，敗之。五年，伐齊于鄄。魏敗我懷。攻鄭，敗之，以與韓，韓與我長子。六年，中山筑長城。伐魏，敗湪澤，圍魏惠王。七年，侵齊，至長城。與韓攻周。八年，與韓分周以爲兩。九年，與齊戰阿下。十年，攻衞，取甄。十一年，秦攻魏，趙救之石阿。十二年，秦攻魏少梁，趙救之。十三年，秦獻公使庶長國伐魏少梁，虜其太子、痤。魏敗我澮，取皮牢。成侯與韓昭侯遇上黨。十四年，與韓攻秦。十五年，助魏攻齊。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-043-zhao:m052-0000","start":0,"end":2,"surface":"成侯","kind":"person","person_id":"1za_blw_7lb_AAAAA","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m052-0005","start":5,"end":8,"surface":"公子勝","kind":"person","person_id":"k8f_g8u_4xk","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m052-0009","start":9,"end":11,"surface":"成侯","kind":"person","person_id":"1za_blw_7lb_AAAAA","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m052-0028","start":28,"end":31,"surface":"太戊午","kind":"person","person_id":"qwm_l6t_ke6","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m052-0107","start":107,"end":110,"surface":"魏惠王","kind":"person","person_id":"hob_fsb_jia","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m052-0187","start":187,"end":190,"surface":"秦獻公","kind":"person","person_id":"8fl_fbf_5p5","status":"contextual_provision