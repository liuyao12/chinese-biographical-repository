於是駿止，論者稱之。山陵訖，封昌安縣侯。元康初，為太尉。年八十餘，克壯慷慨，自遇若少年，時人美之。尋薨，諡曰元。子陋，字處賤，襲封，曆屯騎校尉。","raw_start":9349,"raw_end":9540,"raw_line":119},"chapter_id":"c-jinshu-044-shijian","book_id":"b-jinshu-044","work_id":"w-jinshu","source_id":"s-jinshu-044-shijian"}],"sources":[{"chapter_id":"c-jinshu-031-jin044-shijian","work_id":"w-jinshu","book_id":"b-jinshu-031","source_id":"s-jinshu-031-jin044-shijian","source":{"title":"晉書武悼楊皇后傳","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?oldid=2479706","permalink":"https://zh.wikisource.org/w/index.php?oldid=2479706","revision_id":2479706,"accessed_on":"2026-11-21","extent":"下列來源節錄。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代本文及維基文庫數位轉錄。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"固定修訂相關原文，逐字核收。","raw_path":"sources/jinshu/031-jia-ws2479706.wikitext","wikitext_sha256":"fce325e2f752536c45c0b03e3fb7ead1f6808bc797adc186cfa32af8173b21b5","raw_file_sha256":"fce325e2f752536c45c0b03e3fb7ead1f6808bc797adc186cfa32af8173b21b5"}},{"chapter_id":"c-jinshu-044-shijian","work_id":"w-jinshu","book_id":"b-jinshu-044","source_id":"s-jinshu-044-shijian","source":{"title":"晉書卷四十四","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?oldid=1775345","permalink":"https://zh.wikisource.org/w/index.php?oldid=1775345","revision_id":1775345,"accessed_on":"2026-11-21","extent":"固定數位題「石鑒」題下全文。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代本文及維基文庫數位轉錄。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫固定修訂1775345","raw_path":"sources/jinshu/wikisource-1775345-raw.wikitext","wikitext_sha256":"09742e651b479fea881fd24c7734451de2b78b9f0410adda36ba210c31a0b5c8","raw_file_sha256":"09742e651b479fea881fd24c7734451de2b78b9f0410adda36ba210c31a0b5c8","collation_witnesses":["source-evidence/jin044-shijian/reading.json"]}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_n