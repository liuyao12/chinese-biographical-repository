},{"id":"c-jinshu-044-shijian:line119:m0076","start":76,"end":77,"surface":"亮","kind":"person","person_id":"dkn_ge4_286_AAAAC","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-shijian:line119:m0078","start":78,"end":79,"surface":"劭","kind":"person","person_id":"fue_239_9ld","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-shijian:line119:m0080","start":80,"end":81,"surface":"駿","kind":"person","person_id":"603_131_11e","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-shijian:line119:m0089","start":89,"end":90,"surface":"鑒","kind":"person","person_id":"77n_qzq_xi3","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-shijian:line119:m0093","start":93,"end":94,"surface":"鑒","kind":"person","person_id":"77n_qzq_xi3","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-shijian:line119:m0108","start":108,"end":109,"surface":"亮","kind":"person","person_id":"dkn_ge4_286_AAAAC","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-shijian:line119:m0119","start":119,"end":120,"surface":"駿","kind":"person","person_id":"603_131_11e","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-shijian:line119:m0174","start":174,"end":175,"surface":"陋","kind":"person","person_id":"uju_lw0_5ys","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-shijian:line119:m0177","start":177,"end":179,"surface":"處賤","kind":"person","person_id":"uju_lw0_5ys","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"source_position":{"first_line":119,"last_line":119,"revision_id":1775345},"source_quote":{"witness":"j44","quote":"　　武帝崩，鑒與中護軍張劭監統山陵。時大司馬、汝南王亮為太傅楊駿所疑，不敢臨喪，出營城外。時有告亮欲舉兵討駿，駿大懼，白太后令帝為手詔，詔鑒及張劭使率陵兵討亮。劭，駿甥也，便率所領催鑒速發，鑒以為不然，保持之，遣人密覘視亮，已別道還許昌，於是駿止，論者稱之。山陵訖，封昌安縣侯。元康初，為太尉。年八十餘，克壯慷慨，自遇若少年，時人美之。尋薨，諡曰元。子陋，字處賤，襲封，曆屯騎校尉。","raw_start":9349,"raw_end":9540,"raw_line":119},"chapter_id":"c-jinshu-044-shijian","book_id":"b-jinshu-044","work_id":"w-jinshu","source_id":"s-jinshu-044-shijian"},{"id":"c-jinshu-064-wudi-sons-intro:p001","text":"武帝二十六男：楊元后生毗陵悼王軌、惠帝、秦獻王柬。審美人生城陽懷王景、楚隱王瑋、長沙厲王乂。徐才人生城陽殤王憲。匱才人生東海沖王祗。趙才人生始平哀王裕。趙美人生代哀王演。李夫人生淮南忠壯王允、吳孝王晏。嚴保林生新都懷王該。陳美人生清河康王遐。諸姬生汝陰哀王謨。程才人生成都王穎。王才人生孝懷帝。楊悼后生渤海殤王恢。餘八子不顯母氏，並早夭，又無封國及追諡，今並略之。其瑋、乂、穎自有傳。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":11,"last_line":11,"raw_start":170,"raw_end":470,"raw_character_offsets":[172,173,174,175,176,177,178,195,196,199,204,205,206,207,208,209,210,221,222,225,226,227,228,229,230,231,232,233,234,235,236,237,238,239,240,241,242,243,244,245,246,247,248,249,250,251,252,253,254,255,256,257,258,259,260,261,262,263,264,265,266,267,268,269,270,271,272,273,274,275,276,277,278,279,280,281,282,283,284,285,286,287,288,289,290,291,292,293,294,295,296,297,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,318,319,320,321,322,323,324,325,326,327,328,329,330,331,332,333,334,335,336,337,338,339,340,341,342,343,344,361,362,363,366,380,381,382,385,402,403,406,411,412,413,414,415,416,417,418,419,420,421,422,423,424,425,426,427,428,429,430,431,432,433,434,435,436,437,438,439,440,441,442,443,444,445,446,447,448,464,465,466,469],"revision_id":2622004},"mentions":[{"id":"c-jinshu-064-wudi-sons-intro:p001:m0000","surface":"武帝","start":0,"end":2,"person_id":"hgm_jvn_hle","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-064-wudi-sons-intro:p001:m0007","surface":"楊元后","start":7,"end":10,"person_id":"5mf_0mr_7v3","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-064-wudi-sons-intro:p001:m0011","surface":"毗陵悼王軌","start":11,"end":16,"person_id":"8lv_2pn_v62","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-064-wudi-sons-intro:p001:m0017","surface":"惠帝","start":17,"end":19,"person_id":"7e0_f69_1ac","kind":"pers