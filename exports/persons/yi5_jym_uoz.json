isional","paragraph_id":"c-shiji-130-taishigong:p012","chapter_id":"c-shiji-130-taishigong"},{"id":"c-shiji-130-taishigong:m016-0007","start":7,"end":9,"surface":"西伯","kind":"person","person_id":"yi5_jym_uoz","status":"contextual_provisional","paragraph_id":"c-shiji-130-taishigong:p016","chapter_id":"c-shiji-130-taishigong"},{"id":"c-shiji-130-taishigong:m044-0013","start":13,"end":15,"surface":"西伯","kind":"person","person_id":"yi5_jym_uoz","status":"contextual_provisional","paragraph_id":"c-shiji-130-taishigong:p044","chapter_id":"c-shiji-130-taishigong"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-130-taishigong:p012","text":"於是論次其文。七年而太史公遭李陵之禍，幽於縲紲。乃喟然而嘆曰：「是余之罪也夫！是余之罪也夫！身毀不用矣。」退而深惟曰：「夫詩書隱約者，欲遂其志之思也。昔西伯拘羑里，演周易；孔子戹陳蔡，作春秋；屈原放逐，著離騷；左丘失明，厥有國語；孫子臏腳，而論兵法；不韋遷蜀，世傳呂覽；韓非囚秦，說難、孤憤；詩三百篇，大抵賢聖發憤之所為作也。此人皆意有所郁結，不得通其道也，故述往事，思來者。」於是卒述陶唐以來，至于麟止，自黃帝始。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m012-0010","start":10,"end":13,"surface":"太史公","kind":"person","person_id":"pme_eis_xqi_*A*AAAAA","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m012-0014","start":14,"end":16,"surface":"李陵","kind":"person","person_id":"3tq_5qz_qb9","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m012-0076","start":76,"end":78,"surface":"西伯","kind":"person","person_id":"yi5_jym_uoz","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m012-0086","start":86,"end":88,"surface":"孔子","kind":"person","person_id":"8zh_d7n_e93","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m012-0096","start":96,"end":98,"surface":"屈原","kind":"person","person_id":"e7f_ip0_jk1","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m012-0105","start":105,"end":107,"surface":"左丘","kind":"person","person_id":"asu_nj9_wb8","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m012-0115","start":115,"end":117,"surface":"孫子","kind":"person","person_id":"0jo_9fp_dpo","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m012-0125","start":125,"end":127,"surface":"不韋","kind":"person","person_id":"8wz_919_d1z","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m012-0135","start":135,"end":137,"surface":"韓非","kind":"person","person_id":"0ze_qgj_quv","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m012-0204","start":204,"end":206,"surface":"黃帝","kind":"person","person_id":"ocd_ibe_at1","status":"contextual_provisional"}],"chapter_id":"c-shiji-130-taishigong","book_id":"b-shiji-130","work_id":"w-shiji","source_id":"s-shiji130-taishigong"},{"id":"c-shiji-130-taishigong:p016","text":"維棄作稷，德盛西伯；武王牧野，實撫天下；幽厲昏亂，既喪酆鎬；陵遲至赧；洛邑不祀。作周本紀第四。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m016-0001","start":1,"end":2,"surface":"棄","kind":"person","person_id":"ys8_rdi_f0i","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m016-0003","start":3,"end":4,"surface":"稷","kind":"person","person_id":"ys8_rdi_f0i","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m016-0007","start":7,"end":9,"surface":"西伯","kind":"person","person_id":"yi5_jym_uoz","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m016-0010","start":10,"end":12,"surface":"武王","kind":"person","person_id":"a8q_r4j_swi","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m016-0020","start":20,"end":22,"surface":"幽厲","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-130-taishigong:m016-0033","start":33,"end":34,"surface":"赧","kind":"person","person_id":"esj_qgu_9r9","status":"contextual_provisional"}],"chapter_id":"c-shiji-130-taishigong","book_id":"b-shiji-130","work_id":"w-shiji","source_id":"s-shiji130-taishigong"},{"id":"c-shiji-130-taishigong:p044","text":"申、呂肖矣，尚父側微，卒歸西伯，文武是師；功冠群公，繆權于幽；番番黃髪，爰饗營丘。不背柯盟，桓公以昌，九合諸侯，霸功顯彰。田闞爭寵，姜姓解亡。嘉父之謀，作齊太公世家第二。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m044-0000","start":0,"end":3,"surface":"申、呂","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-130-taishigong:m044-0006","start":6,"end":8,"surface":"尚父","kind":"person","person_id":"hnu_8zd_5n9","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m044-0013","start":13,"end":15,"surface":"西伯","kind":"person","person_id":"yi5_jym_uoz","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m044-0016","start":16,"end":18,"surface":"文武","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-130-taishigong:m044-0046","start":46,"end":48,"surface":"桓公","kind":"person","person_id":"si5_hx0_uze","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m044-0061","start":61,"end":63,"surface":"田闞","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-130-taishigong:m044-0072","start":72,"end":73,"surface":"父","kind":"person","person_id":"hnu_8zd_5n9","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m044-0078","start":78,"end":80,"surface":"太公","kind":"person","person_id":"hnu_8zd_5n9","status":"contextual_provisional"}],"chapter_id":"c-shiji-130-taishigong","book_id":"b-shiji-130","work_id":"w-shiji","source_id":"s-shiji130-taishigong"}],"sources":[{"chapter_id":"c-shiji-130-taishigong","work_id":"w-shiji","book_id":"b-shiji-130","source_id":"s-shiji130-taishigong","source":{"title":"史記／卷130","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷130","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷130&oldid=2609362","revision_id":2609362,"accessed_on":"2026-10-11","extent":"固定修訂全文143段，全部篇文。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"cha