nd":23,"surface":"太上皇","kind":"person","person_id":"cbr-p005167","status":"contextual_provisional","paragraph_id":"c-shiji-093-hanlu:p008","chapter_id":"c-shiji-093-hanlu"},{"id":"c-shiji-093-hanlu:m015-0125","start":125,"end":128,"surface":"太上皇","kind":"person","person_id":"cbr-p005167","status":"contextual_provisional","paragraph_id":"c-shiji-093-hanlu:p015","chapter_id":"c-shiji-093-hanlu"}],"relations":[{"id":"a-shiji093-010","subject_person_id":"cbr-p005157","predicate":"father","object_person_id":"cbr-p005167","status":"source_attested","evidence":[{"chapter_id":"c-shiji-093-hanlu","source_id":"s-shiji-093-hanlu","paragraph_id":"c-shiji-093-hanlu:p008","quote":"盧綰者，豐人也，與高祖同里。盧綰親與高祖太上皇相愛，及生男，高祖、盧綰同日生，里中持羊酒賀兩家。及高祖、盧綰壯，俱學書，又相愛也。里中嘉兩家親相愛，生子同日，壯又相愛，復賀兩家羊酒。高祖為布衣時，有吏事辟匿，盧綰常隨出入上下。及高祖初起沛，盧綰以客從，入漢中為將軍，常侍中。從東擊項籍，以太尉常從，出入臥內，衣被飲食賞賜，群臣莫敢望，雖蕭曹等，特以事見禮，至其親幸，莫及盧綰。綰封為長安侯。長安，故咸陽也。"}],"qualifiers":{"source_term":"高祖太上皇","historicity":"historical_tradition"},"interpretation_note":"保存明示親屬及局部回指。孽孫只記祖孫原稱，不補父系中間人物或母親；妻子不自動拆成未名子女，說孫曾不補代為曾父。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji093-017","person_id":"cbr-p005167","scope":"same_chapter","chapter_ids":["c-shiji-093-hanlu"],"status":"contextual_provisional","rationale":"明示姓名及局部敘事承接；引古、未名者及短稱另存候選。臧茶與臧荼、高后與呂后待跨稱判讀，不因近形或熟知姓名自動合併。","reviewer":"Codex（AI 代理）","surfaces":["太上皇"],"evidence":[{"paragraph_id":"c-shiji-093-hanlu:p008","quote":"盧綰者，豐人也，與高祖同里。盧綰親與高祖太上皇相愛，及生男，高祖、盧綰同日生，里中持羊酒賀兩家。及高祖、盧綰壯，俱學書，又相愛也。里中嘉兩家親相愛，生子同日，壯又相愛，復賀兩家羊酒。高祖為布衣時，有吏事辟匿，盧綰常隨出入上下。及高祖初起沛，盧綰以客從，入漢中為將軍，常侍中。從東擊項籍，以太尉常從，出入臥內，衣被飲食賞賜，群臣莫敢望，雖蕭曹等，特以事見禮，至其親幸，莫及盧綰。綰封為長安侯。長安，故咸陽也。"},{"paragraph_id":"c-shiji-093-hanlu:p015","quote":"豨常告歸過趙，趙相周昌見豨賓客隨之者千餘乘，邯鄲官舍皆滿。豨所以待賓客布衣交，皆出客下。豨還之代，周昌乃求入見。見上，具言豨賓客盛甚，擅兵於外數歲，恐有變。上乃令人覆案豨客居代者財物諸不法事，多連引豨。豨恐，陰令客通使王黃、曼丘臣所。及高祖十年七月，太上皇崩，使人召豨，豨稱病甚。九月，遂與王黃等反，自立為代王，劫略趙、代。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-093-hanlu:p008","text":"盧綰者，豐人也，與高祖同里。盧綰親與高祖太上皇相愛，及生男，高祖、盧綰同日生，里中持羊酒賀兩家。及高祖、盧綰壯，俱學書，又相愛也。里中嘉兩家親相愛，生子同日，壯又相愛，復賀兩家羊酒。高祖為布衣時，有吏事辟匿，盧綰常隨出入上下。及高祖初起沛，盧綰以客從，入漢中為將軍，常侍中。從東擊項籍，以太尉常從，出入臥內，衣被飲食賞賜，群臣莫敢望，雖蕭曹等，特以事見禮，至其親幸，莫及盧綰。綰封為長安侯。長安，故咸陽也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-093-hanlu:m008-0000","start":0,"end":2,"surface":"盧綰","kind":"person","person_id":"cbr-p005166","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m008-0009","start":9,"end":11,"surface":"高祖","kind":"person","person_id":"cbr-p005157","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m008-0014","start":14,"end":16,"surface":"盧綰","kind":"person","person_id":"cbr-p005166","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m008-0016","start":16,"end":17,"surface":"親","kind":"person","person_id":"cbr-p005211","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m008-0018","start":18,"end":20,"surface":"高祖","kind":"person","person_id":"cbr-p005157","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m008-0020","start":20,"end":23,"surface":"太上皇","kind":"person","person_id":"cbr-p005167","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m008-0030","start":30,"end":32,"surface":"高祖","kind":"person","person_id":"cbr-p005157","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m008-0033","start":33,"end":35,"surface":"盧綰","kind":"person","person_id":"cbr-p005166","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m008-0049","start":49,"end":51,"surface":"高祖","kind":"person","person_id":"cbr-p005157","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m008-0052","start":52,"end":54,"surface":"盧綰","kind":"person","person_id":"cbr-p005166","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m008-0091","start":91,"end":93,"surface":"高祖","kind":"person","person_id":"cbr-p005157","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m008-0104","start":104,"end":106,"surface":"盧綰","kind":"person","perso