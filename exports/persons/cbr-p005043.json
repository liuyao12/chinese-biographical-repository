ial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-090-wei:m001-0035","start":35,"end":37,"surface":"陳勝","kind":"person","person_id":"27r_a47_f8b","status":"contextual_provisional","paragraph_id":"c-shiji-090-wei:p001","chapter_id":"c-shiji-090-wei"},{"id":"c-shiji-090-wei:m001-0047","start":47,"end":49,"surface":"陳王","kind":"person","person_id":"27r_a47_f8b","status":"contextual_provisional","paragraph_id":"c-shiji-090-wei:p001","chapter_id":"c-shiji-090-wei"},{"id":"c-shiji-090-wei:m001-0137","start":137,"end":139,"surface":"陳王","kind":"person","person_id":"27r_a47_f8b","status":"contextual_provisional","paragraph_id":"c-shiji-090-wei:p001","chapter_id":"c-shiji-090-wei"},{"id":"c-shiji-090-wei:m002-0004","start":4,"end":6,"surface":"陳王","kind":"person","person_id":"27r_a47_f8b","status":"contextual_provisional","paragraph_id":"c-shiji-090-wei:p002","chapter_id":"c-shiji-090-wei"},{"id":"c-shiji-090-wei:m005-0023","start":23,"end":25,"surface":"陳勝","kind":"person","person_id":"27r_a47_f8b","status":"contextual_provisional","paragraph_id":"c-shiji-090-wei:p005","chapter_id":"c-shiji-090-wei"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji090-011","person_id":"27r_a47_f8b","surfaces":["陳勝","陳王"],"scope":"same_chapter","chapter_ids":["c-shiji-090-wei"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-090-wei:p001","quote":"魏豹者，故魏諸公子也。其兄魏咎，故魏時封為寧陵君。秦滅魏，遷咎為家人。陳勝之起王也，咎往從之。陳王使魏人周市徇魏地，魏地已下，欲相與立周市為魏王。周市曰：「天下昏亂，忠臣乃見。今天下共畔秦，其義必立魏王後乃可。」齊、趙使車各五十乘，立周市為魏王。市辭不受，迎魏咎於陳。五反，陳王乃遣立咎為魏王。"},{"paragraph_id":"c-shiji-090-wei:p002","quote":"章邯已破陳王，乃進兵擊魏王於臨濟。魏王乃使周市出請救於齊、楚。齊、楚遣項它、田巴將兵隨市救魏。章邯遂擊破殺周市等軍，圍臨濟。咎為其民約降。約定，咎自燒殺。"},{"paragraph_id":"c-shiji-090-wei:p005","quote":"彭越者，昌邑人也，字仲。常漁鉅野澤中，為群盜。陳勝、項梁之起，少年或謂越曰：「諸豪桀相立畔秦，仲可以來，亦效之。」彭越曰：「兩龍方鬬，且待之。」"}],"rationale":"依同段及連續事件明示姓名與用稱暫接，仲按字仲與述贊承接；秦漢用稱不全域替換，未名者不補姓名。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-090-wei:p001","text":"魏豹者，故魏諸公子也。其兄魏咎，故魏時封為寧陵君。秦滅魏，遷咎為家人。陳勝之起王也，咎往從之。陳王使魏人周市徇魏地，魏地已下，欲相與立周市為魏王。周市曰：「天下昏亂，忠臣乃見。今天下共畔秦，其義必立魏王後乃可。」齊、趙使車各五十乘，立周市為魏王。市辭不受，迎魏咎於陳。五反，陳王乃遣立咎為魏王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-090-wei:m001-0000","start":0,"end":2,"surface":"魏豹","kind":"person","person_id":"ctl_rtd_6df","status":"contextual_provisional"},{"id":"c-shiji-090-wei:m001-0005","start":5,"end":9,"surface":"魏諸公子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者與未定指代不補成員姓名。"},{"id":"c-shiji-090-wei:m001-0013","start":13,"end":15,"surface":"魏咎","kind":"person","person_id":"bo6_x83_hfu","status":"contextual_provisional"},{"id":"c-shiji-090-wei:m001-0030","start":30,"end":31,"surface":"咎","kind":"person","person_id":"bo6_x83_hfu","status":"contextual_provisional"},{"id":"c-shiji-090-wei:m001-0035","start":35,"end":37,"surface":"陳勝","kind":"person","person_id":"27r_a47_f8b","status":"contextual_provisional"},{"id":"c-shiji-090-wei:m001-0042","start":42,"end":43,"surface":"咎","kind":"person","person_id":"bo6_x83_hfu","status":"contextual_provisional"},{"id":"c-shiji-090-wei:m001-0047","start":47,"end":49,"surface":"陳王","kind":"person","person_id":"27r_a47_f8b","status":"contextual_provisional"},{"id":"c-shiji-090-wei:m001-0052","start":52,"end":54,"surface":"周市","kind":"person","person_id":"4xv_96s_2qj","status":"contextual_provisional"},{"id":"c-shiji-090-wei:m001-0067","start":67,"end":69,"surface":"周市","kind":"person","person_id":"4xv_96s_2qj","status":"contextual_provisional"},{"id":"c-shiji-090-wei:m001-0073","start":73,"end":75,"surface":"周市","kind":"person","person_id":"4xv_96s_2qj","status":"contextual_provisional"},{"id":"c-shiji-090-wei:m001-0099","start":99,"end":102,"surface":"魏王後","kind":"unresolved","person_id"