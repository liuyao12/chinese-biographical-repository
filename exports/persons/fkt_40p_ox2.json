true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-058-southern-and-eastern-complete:p016:m0258","start":258,"end":260,"surface":"孫副","kind":"person","person_id":"fkt_40p_ox2","status":"contextual_provisional","paragraph_id":"c-nanqishu-058-southern-and-eastern-complete:p016","chapter_id":"c-nanqishu-058-southern-and-eastern-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-058-southern-and-eastern-complete:p016","text":"牟大又表曰：「臣所遣行建威將軍、廣陽太守、兼長史臣高達，行建威將軍、朝鮮太守、兼司馬臣楊茂，行宣威將軍、兼參軍臣會邁等三人，志行清亮，忠款夙著。往泰始中，比使宋朝，今任臣使，冒涉波險，尋其至効，宜在進爵，謹依先例，各假行職。且玄澤靈休，萬里所企，況親趾天庭，乃不蒙賴。伏願天監特愍除正。達邊効夙著，勤勞公務，今假行龍驤將軍、帶方太守。茂志行清壹，公務不廢，今假行建威將軍、廣陵太守。（萬）〔邁〕執志周密，屢致勤効，今假行廣武將軍、清河太守。」詔可，竝賜軍號，除太守。為使持節、都督百濟諸軍事、鎮東大將軍。使兼謁者僕射孫副策命大襲亡祖父牟都為百濟王。曰：「於戲！惟爾世襲忠懃，誠著遐表，滄路肅澄，要貢無替。式循彝典，用纂顯命。往欽哉！其敬膺休業，可不慎歟！制詔行都督百濟諸軍事、鎮東大將軍百濟王牟大今以大襲祖父牟都為百濟王，即位章綬等玉銅虎竹符四。〔王〕其拜受，不亦休乎！」","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":45,"last_line":45,"raw_start":2526,"raw_end":3177,"raw_character_offsets":[2526,2527,2528,2529,2530,2531,2619,2620,2621,2622,2623,2624,2625,2626,2627,2628,2629,2630,2631,2632,2633,2634,2635,2636,2637,2638,2639,2640,2641,2642,2643,2644,2645,2646,2647,2648,2649,2650,2651,2652,2653,2654,2655,2656,2657,2658,2659,2660,2661,2662,2663,2664,2665,2666,2667,2668,2669,2670,2671,2672,2673,2674,2675,2676,2677,2678,2679,2680,2681,2682,2683,2684,2685,2686,2687,2688,2689,2726,2727,2728,2729,2730,2731,2732,2733,2734,2735,2736,2737,2738,2739,2740,2741,2742,2743,2744,2745,2746,2747,2748,2749,2750,2751,2752,2753,275