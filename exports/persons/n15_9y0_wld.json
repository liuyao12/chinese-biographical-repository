red":false},"family_paths":[],"mentions":[{"id":"c-jinshu-064-simadaozi:p004:m0002","surface":"趙牙","start":2,"end":4,"person_id":"n15_9y0_wld","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-064-simadaozi:p004","chapter_id":"c-jinshu-064-simadaozi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-064-simadaozi:p004","text":"嬖人趙牙出自優倡，茹千秋本錢塘捕賊吏，因賂諂進，道子以牙為魏郡太守，千秋驃騎諮議參軍。牙為道子開東第，築山穿池，列樹竹木，功用钜萬。道子使宮人為酒肆，沽賣于水側，與親昵乘船就之飲宴，以為笑樂。帝嘗幸其宅，謂道子曰：「府內有山，因得遊矚，甚善也。然修飾太過，非示天下以儉。」道子無以對，唯唯而已，左右侍臣莫敢有言。帝還宮，道子謂牙曰：「上若知山是板築所作，爾必死矣。」牙曰：「公在，牙何敢死！」營造彌甚。千秋賣官販爵，聚資貨累億。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":119,"last_line":119,"raw_start":8583,"raw_end":8799,"raw_character_offsets":[8585,8586,8587,8588,8589,8590,8591,8592,8593,8594,8595,8596,8597,8598,8599,8600,8601,8602,8603,8604,8605,8606,8607,8608,8609,8610,8611,8612,8613,8614,8615,8616,8617,8618,8619,8620,8621,8622,8623,8624,8625,8626,8627,8628,8629,8630,8631,8632,8633,8634,8635,8636,8637,8638,8639,8640,8641,8642,8643,8644,8645,8646,8647,8648,8649,8650,8651,8652,8653,8654,8655,8656,8657,8658,8659,8660,8661,8662,8663,8664,8665,8666,8667,8668,8669,8670,8671,8672,8673,8674,8675,8676,8677,8678,8679,8680,8681,8682,8683,8684,8685,8686,8687,8688,8689,8690,8691,8692,8693,8694,8695,8696,8697,8698,8699,8700,8701,8702,8703,8704,8705,8706,8707,8708,8709,8710,8711,8712,8713,8714,8715,8716,8717,8718,8719,8720,8721,8722,8723,8724,8725,8726,8727,8728,8729,8730,8731,8732,8733,8734,8735,8736,8737,8738,8739,8740,8741,8742,8743,8744,8745,8746,8747,8748,8749,8750,8751,8752,8753,8754,8755,8756,8757,8758,8759,8760,8761,8762,8763,8764,8765,8766,8767,8768,8769,8770,8771,8772,8773,8774,8775,8776,8777,8778,8779,8780,8781,8782,8783,8784,8785,8786,8787,8788,8789,8790,8791,8792,8793,8794,87