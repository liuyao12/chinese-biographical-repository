y":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-hanshu-059-zhangtang:zhanganshi:p-intro-001:m0236","start":236,"end":238,"surface":"宣帝","kind":"person","person_id":"qqt_lpt_8is","status":"contextual_provisional","paragraph_id":"c-hanshu-059-zhangtang:zhanganshi:p-intro-001","chapter_id":"c-hanshu-059-zhangtang"},{"id":"c-hanshu-059-zhangtang:zhanganshi:p-intro-001:m0238","start":238,"end":239,"surface":"帝","kind":"person","person_id":"qqt_lpt_8is","status":"contextual_provisional","paragraph_id":"c-hanshu-059-zhangtang:zhanganshi:p-intro-001","chapter_id":"c-hanshu-059-zhangtang"},{"id":"c-shiji-112-pingjin:m030-0321","start":321,"end":323,"surface":"孝宣","kind":"person","person_id":"qqt_lpt_8is","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p030","chapter_id":"c-shiji-112-pingjin"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-hanshu059-context-18","person_id":"qqt_lpt_8is","surfaces":["宣帝","帝"],"scope":"cross_chapter","chapter_ids":["c-hanshu-059-zhangtang","c-shiji-112-pingjin"],"status":"contextual_provisional","confidence_level":"high","identification_basis":{"kind":"source_context","target_mention_ids":["c-hanshu-059-zhangtang:zhanganshi:p-intro-001:m0236","c-hanshu-059-zhangtang:zhanganshi:p-intro-001:m0238"]},"evidence":[{"work_id":"w-hanshu","book_id":"b-hanshu-059","chapter_id":"c-hanshu-059-zhangtang","source_id":"s-hanshu-059-zhangtang","paragraph_id":"c-hanshu-059-zhangtang:zhanganshi:p-intro-001","quote":"安世字子孺少以父任為郎用善書給事尚書精力於職休沐未嘗出上行幸河東嘗亡書三篋詔問莫能知惟安世識之具作其事後購求得書以相校無所遺失上竒其材擢為尚書令遷光禄大夫昭帝即位大將軍霍光秉政以安世篤行光親重之㑹左將軍上官桀父子及御史大夫桑𢎞羊皆與燕王蓋主謀反誅光以朝無舊臣白用安世為右將軍光禄勲以自副焉久之天子下詔曰右將軍光禄勲安世輔政宿衛肅敬不怠十有三年咸以康寜夫親親任賢唐虞之道也其封安世為富平侯明年昭帝崩未葬大將軍光白太后徙安世為車騎將軍與共徴立昌邑王王行滛亂光復與安世謀廢王尊立宣帝帝初即位襃賞大臣下詔曰夫襃有徳賞有功古今之通義也車騎將軍光禄勲富平侯安世宿衛忠正宣徳明恩勤勞國家守職秉義以安宗廟其益封萬六百戸功次大將軍光"},{"work_id":"w-shiji","book_id":"b-shiji-112","chapter_id":"c-shiji-112-pingjin","source_id":"s-shiji112-pingjin","paragraph_id":"c-shiji-112-pingjin:p030","quote":"班固稱曰：公孫弘、卜式、兒寬皆以鴻漸之翼困於燕雀，遠跡羊豕之閒，非遇其時，焉能致此位乎？是時漢興六十餘載，海內乂安，府庫充實，而四夷未賓，制度多闕，上方欲用文武，求之如弗及。始以蒲輪迎枚生，見主父而嘆息。群臣慕向，異人并出。卜式試於芻牧，弘羊擢於賈豎，衛青奮於奴仆，日磾出於降虜，斯亦曩時版筑飯牛之朋矣。漢之得人，於茲為盛。儒雅則公孫弘、董仲舒、兒寬，篤行則石建、石慶，質直則汲黯、卜式，推賢則韓安國、鄭當時，定令則趙禹、張湯，文章則司馬遷、相如，滑稽則東方朔、枚皋，應對則嚴助、朱買臣，歷數則唐都、落下閎，協律則李延年，運籌則桑弘羊，奉使則張騫、蘇武，將帥則衛青、霍去病，受遺則霍光、金日磾。其餘不可勝紀。是以興造功業，制度遺文，後世莫及。孝宣承統，纂修洪業，亦講論六藝，招選茂異，而蕭望之、梁丘賀、夏侯勝、韋玄成、嚴彭祖、尹更始以儒術進，劉向、王褒以文章顯。將相則張安世、趙充國、魏相、邴吉、于定國、杜延年，治民則黃霸、王成、龔遂、鄭弘、邵信臣、韓延壽、尹翁歸、趙廣漢之屬，皆有功跡見述於後。累其名臣，亦其次也。"}],"rationale":"安世與光廢昌邑王後尊立宣帝、帝初即位的詔，與平津篇所附班固孝宣將相張安世對應，非昭帝或武帝。","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-hanshu-059-zhangtang:zhanganshi:p-intro-001","text":"安世字子孺少以父任為郎用善書給事尚書精力於職休沐未嘗出上行幸河東嘗亡書三篋詔問莫能知惟安世識之具作其事後購求得書以相校無所遺失上竒其材擢為尚書令遷光禄大夫昭帝即位大將軍霍光秉政以安世篤行光親重之㑹左將軍上官桀父子及御史大夫桑𢎞羊皆與燕王蓋主謀反誅光以朝無舊臣白用安世為右將軍光禄勲以自副焉久之天子下詔曰右將軍光禄勲安世輔政宿衛肅敬不怠十有三年咸以康寜夫親親任賢唐虞之道也其封安世為富平侯明年昭帝崩未葬大將軍光白太后徙安世為車騎將軍與共徴立昌邑王王行滛亂光復與安世謀廢王尊立宣帝帝初即位襃賞大臣下詔曰夫襃有徳賞有功古今之通義也車騎將軍光禄勲富平侯安世宿衛忠正宣徳明恩勤勞國家守職秉義以安宗廟其益封萬六百戸功次大將軍光","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-hanshu-059-zhangtang:zhanganshi:p-intro-001:m0000","start":0,"end":2,"surface":"安世","kind":"person","person_id":"1ex_se1_yef_AA","status":"contextual_provisional"},{"id":"c-hanshu-059-zhangtang:zhanganshi:p-intro-001:m0003","start":3,"end":5,"surface":"子孺","kind":"person","person_id":"1ex_se1_yef_AA","status":"contextual_provisional"},{"id":"c-hanshu-059-zhangtang:zhanganshi:p-intro-001:m0007",