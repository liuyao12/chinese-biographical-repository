則桑弘羊，奉使則張騫、蘇武，將帥則衛青、霍去病，受遺則霍光、金日磾。其餘不可勝紀。是以興造功業，制度遺文，後世莫及。孝宣承統，纂修洪業，亦講論六藝，招選茂異，而蕭望之、梁丘賀、夏侯勝、韋玄成、嚴彭祖、尹更始以儒術進，劉向、王褒以文章顯。將相則張安世、趙充國、魏相、邴吉、于定國、杜延年，治民則黃霸、王成、龔遂、鄭弘、邵信臣、韓延壽、尹翁歸、趙廣漢之屬，皆有功跡見述於後。累其名臣，亦其次也。","annotation_status":"in_progress","text_layer":"witness_appended_bangu_note","mentions":[{"id":"c-shiji-112-pingjin:m030-0000","start":0,"end":2,"surface":"班固","kind":"person","person_id":"gxd_15x_9d0","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0005","start":5,"end":8,"surface":"公孫弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0009","start":9,"end":11,"surface":"卜式","kind":"person","person_id":"h6s_hqj_u6k","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0012","start":12,"end":14,"surface":"兒寬","kind":"person","person_id":"x8r_9sk_d7a","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0074","start":74,"end":75,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0092","start":92,"end":94,"surface":"枚生","kind":"person","person_id":"e1m_xt0_8w7","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0096","start":96,"end":98,"surface":"主父","kind":"person","person_id":"vbr_ff1_yc4","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0112","start":112,"end":114,"surface":"卜式","kind":"person","person_id":"h6s_hqj_u6k","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0119","start":119,"end":121,"surface":"弘羊","kind":"person","person_id":"fi2_2cl_w22","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0126","start":126,"end":128,"surface":"衛青","kind":"person","person_id":"5dd_l1c_6g8","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0133","start":133,"end":135,"surface":"日磾","kind":"person","person_id":"6tp_ke1_h68","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0165","start":165,"end":