d_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-052-early-literature-complete:p003:m0095","start":95,"end":97,"surface":"沈勃","kind":"person","person_id":"k7j_9yf_vhd","status":"contextual_provisional","paragraph_id":"c-nanqishu-052-early-literature-complete:p003","chapter_id":"c-nanqishu-052-early-literature-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-052-early-literature-complete:p003","text":"　　宋孝武殷貴妃亡，靈鞠獻輓歌詩三首，云「雲橫廣階闇，霜深高殿寒」。帝擿句嗟賞。除新安王北中郎參軍，出爲剡烏程令，不得志。泰始初，坐東賊黨錮數年。褚淵爲吳興，謂人曰：「此郡才士，唯有丘靈鞠及沈勃耳。」乃啓申之。明帝使著《大駕南討紀論》。久之，除太尉參軍，轉安北記室，帶扶風太守，不就。爲尚書三公郎，建康令，轉通直郎，兼中書郎。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":16,"last_line":16,"raw_start":272,"raw_end":435,"raw_character_offsets":[272,273,274,275,276,277,278,279,280,281,282,283,284,285,286,287,288,289,290,291,292,293,294,295,296,297,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,318,319,320,321,322,323,324,325,326,327,328,329,330,331,332,333,334,335,336,337,338,339,340,341,342,343,344,345,346,347,348,349,350,351,352,353,354,355,356,357,358,359,360,361,362,363,364,365,366,367,368,369,370,371,372,373,374,375,376,377,378,379,380,381,382,383,384,385,386,387,388,389,390,391,392,393,394,395,396,397,398,399,400,401,402,403,404,405,406,407,408,409,410,411,412,413,414,415,416,417,418,419,420,421,422,423,424,425,426,427,428,429,430,431,432,433,434],"revision_id":2371079},"mentions":[{"id":"c-nanqishu-052-early-literature-complete:p003:m0002","start":2,"end":5,"surface":"宋孝武","kind":"person","person_id":"hx8_st4_