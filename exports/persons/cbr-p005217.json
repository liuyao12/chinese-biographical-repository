urface":"梅鋗","kind":"person","person_id":"cbr-p000706","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m021-0713","start":713,"end":717,"surface":"十萬戶侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、匿名者、群體、動物或未定指代保留待核；不補姓名、闕代或個別成員。"},{"id":"c-shiji-007-xiangyu:m021-0718","start":718,"end":720,"surface":"項王","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m021-0723","start":723,"end":727,"surface":"西楚霸王","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"}],"chapter_id":"c-shiji-007-xiangyu","book_id":"b-shiji-007","work_id":"w-shiji","source_id":"s-shiji-007-xiangyu"},{"id":"c-shiji-094-tiandan:p003","text":"秦將章邯圍魏王咎於臨濟，急。魏王請救於齊，齊王田儋將兵救魏。章邯夜銜枚擊，大破齊、魏軍，殺田儋於臨濟下。儋弟田榮收儋餘兵東走東阿。齊人聞王田儋死，乃立故齊王建之弟田假為齊王、田角為相、田間為將，以距諸侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-094-tiandan:m003-0002","start":2,"end":4,"surface":"章邯","kind":"person","person_id":"cbr-p005230","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0005","start":5,"end":8,"surface":"魏王咎","kind":"person","person_id":"cbr-p005216","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0014","start":14,"end":16,"surface":"魏王","kind":"person","person_id":"cbr-p005216","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0023","start":23,"end":25,"surface":"田儋","kind":"person","person_id":"cbr-p005225","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0030","start":30,"end":32,"surface":"章邯","kind":"person","person_id":"cbr-p005230","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0045","start":45,"end":47,"surface":"田儋","kind":"person","person_id":"cbr-p005225","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0052","start":52,"end":53,"surface":"儋","kind":"person","person_id":"cbr-p005225","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0054","start":54,"end":56,"surface":"田榮","kind":"person","person_id":"cbr-p005226","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0057","start":57,"end":58,"surface":"儋","kind":"person","person_id":"cbr-p005225","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0069","start":69,"end":71,"surface":"田儋","kind":"person","person_id":"cbr-p005225","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0076","start":76,"end":79,"surface":"齊王建","kind":"person","person_id":"cbr-p005217","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0081","start":81,"end":83,"surface":"田假","kind":"person","person_id":"cbr-p005218","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0087","start":87,"end":89,"surface":"田角","kind":"person","person_id":"cbr-p005219","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0092","start":92,"end":94,"surface":"田間","kind":"person","person_id":"cbr-p005231","status":"contextual_provisional"}],"chapter_id":"c-shiji-094-tiandan","book_id":"b-shiji-094","work_id":"w-shiji","source_id":"s-shiji-094-tiandan"},{"id":"c-shiji-094-tiandan:p006","text":"項羽既存趙，降章邯等，西屠咸陽，滅秦而立侯王也，乃徙齊王田市更王膠東，治即墨。齊將田都從共救趙，因入關，故立都為齊王，治臨淄。故齊王建孫田安，項羽方渡河救趙，田安下濟北數城，引兵降項羽，項羽立田安為濟北王，治博陽。田榮以負項梁不肯出兵助楚、趙攻秦，故不得王；趙將陳餘亦失職，不得王：二人俱怨項王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-094-tiandan:m006-0000","start":0,"end":2,"surface":"項羽","kind":"person","person_id":"cbr-p005234","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m006-0007","start":7,"end":9,"surface":"章邯","kind":"person","person_id":"cbr-p005230","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m006-0026","start":26,"end":30,"surface":"齊王田市","kind":"person","person_id":"cbr-p005213","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m006-0041","start":41,"end":43,"surface":"田都","kind":"person","person_id":"cbr-p005235","status":"con