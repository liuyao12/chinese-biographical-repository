person","person_id":"cbr-p000570","status":"contextual_provisional","paragraph_id":"c-shiji-006-shihuang:p020","chapter_id":"c-shiji-006-shihuang"},{"id":"c-shiji-007-xiangyu:m021-0598","start":598,"end":601,"surface":"齊王建","kind":"person","person_id":"cbr-p000570","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p021","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-094-tiandan:m003-0076","start":76,"end":79,"surface":"齊王建","kind":"person","person_id":"cbr-p005217","status":"contextual_provisional","paragraph_id":"c-shiji-094-tiandan:p003","chapter_id":"c-shiji-094-tiandan"},{"id":"c-shiji-094-tiandan:m006-0064","start":64,"end":67,"surface":"齊王建","kind":"person","person_id":"cbr-p005217","status":"contextual_provisional","paragraph_id":"c-shiji-094-tiandan:p006","chapter_id":"c-shiji-094-tiandan"}],"relations":[{"id":"a-shiji007-010","subject_person_id":"cbr-p000705","predicate":"grandfather","object_person_id":"cbr-p000570","status":"source_attested","evidence":[{"paragraph_id":"c-shiji-007-xiangyu:p021","quote":"故秦所滅齊王建孫田安","chapter_id":"c-shiji-007-xiangyu","source_id":"s-shiji-007-xiangyu"}],"qualifiers":{"source_term":"孫","historicity":"historical_tradition"},"interpretation_note":"保存來源所述親屬；不補姓名、闕代或以義稱推定血親。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji094-004","subject_person_id":"cbr-p005218","predicate":"brother","object_person_id":"cbr-p005217","status":"source_attested","evidence":[{"chapter_id":"c-shiji-094-tiandan","source_id":"s-shiji-094-tiandan","paragraph_id":"c-shiji-094-tiandan:p003","quote":"秦將章邯圍魏王咎於臨濟，急。魏王請救於齊，齊王田儋將兵救魏。章邯夜銜枚擊，大破齊、魏軍，殺田儋於臨濟下。儋弟田榮收儋餘兵東走東阿。齊人聞王田儋死，乃立故齊王建之弟田假為齊王、田角為相、田間為將，以距諸侯。"}],"qualifiers":{"source_term":"齊王建之弟田假","historicity":"historical_tradition","relative_birth_order":{"older_person_id":"cbr-p005217","younger_person_id":"cbr-p005218","operator":"lt","older_ordinal":null,"younger_ordinal":null,"scope":"siblings","interpretation_status":"source_attested","comparison_basis":"birth_chronology"}},"interpretation_note":"明示子孫與弟稱保存；排行只記相對先後，不補確切序號、同母或中間父系。從弟與弟分存，不強行統一親等。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji094-007","subject_person_id":"cbr-p005214","predicate":"grandfather","object_person_id":"cbr-p005217","status":"source_attested","evidence":[{"chapter_id":"c-shiji-094-tiandan","source_id":"s-shiji-094-tiandan","paragraph_id":"c-shiji-094-tiandan:p006","quote":"項羽既存趙，降章邯等，西屠咸陽，滅秦而立侯王也，乃徙齊王田市更王膠東，治即墨。齊將田都從共救趙，因入關，故立都為齊王，治臨淄。故齊王建孫田安，項羽方渡河救趙，田安下濟北數城，引兵降項羽，項羽立田安為濟北王，治博陽。田榮以負項梁不肯出兵助楚、趙攻秦，故不得王；趙將陳餘亦失職，不得王：二人俱怨項王。"}],"qualifiers":{"source_term":"齊王建孫田安","historicity":"historical_tradition"},"interpretation_note":"明示子孫與弟稱保存；排行只記相對先後，不補確切序號、同母或中間父系。從弟與弟分存，不強行統一親等。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[{"older_person_id":"cbr-p005217","younger_person_id":"cbr-p005218","operator":"lt","older_ordinal":null,"younger_ordinal":null,"scope":"siblings","interpretation_status":"source_attested","comparison_basis":"birth_chronology","assertion_id":"a-shiji094-004","person_id":"cbr-p005218","evidence":[{"chapter_id":"c-shiji-094-tiandan","source_id":"s-shiji-094-tiandan","paragraph_id":"c-shiji-094-tiandan:p003","quote":"秦將章邯圍魏王咎於臨濟，急。魏王請救於齊，齊王田儋將兵救魏。章邯夜銜枚擊，大破齊、魏軍，殺田儋於臨濟下。儋弟田榮收儋餘兵東走東阿。齊人聞王田儋死，乃立故齊王建之弟田假為齊王、田角為相、田間為將，以距諸侯。"}]}],"identity_decisions":[{"id":"d-shiji007-023","person_id":"cbr-p000570","surfaces":["齊王建"],"scope":"cross_chapter","chapter_ids":["c-shiji-006-shihuang","c-shiji-007-xiangyu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-006-shihuang:p020","quote":"二十六年，齊王建與其相后勝發兵守其西界，不通秦。秦使將軍王賁從燕南攻齊，得齊王建。"},{"paragraph_id":"c-shiji-007-xiangyu:p021","quote":"項王使人致命懷王。懷王曰：「如約。」乃尊懷王為義帝。項王欲自王，先王諸將相。謂曰：「天下初發難時，假立諸侯後以伐秦。然身被堅執銳首事，暴露於野三年，滅秦定天下者，皆將相諸君與籍之力也。義帝雖無功，故當分其地而王之。」諸將皆曰：「善。」乃分天下，立諸將為侯王。項王、范增疑沛公之有天下，業已講解，又惡負約，恐諸侯叛之，乃陰謀曰：「巴、蜀道險，秦之遷人皆居蜀。」乃曰：「巴、蜀亦關中地也。」故立沛公為漢王，王巴、蜀、漢中，都南鄭。而三分關中，王秦降將以距塞漢王。項王乃立章邯為雍王，王咸陽以西，都廢邱。長史欣者，故為櫟陽獄掾，嘗有德於項梁；都尉董翳者，本勸章邯降楚。故立司馬欣為塞王，王咸陽以東至河，都櫟陽；立董翳為翟王，王上郡，都高奴。徙魏王豹為西魏王，王河東，都平陽。瑕丘申陽者，張耳嬖臣也，先下河南（郡），迎楚河上，故立申陽為河南王，都雒陽。韓王成因故都，都陽翟。趙將司馬卬定河內，數有功，故立卬為殷王，王河內，都朝歌。徙趙王歇為代王。趙相張耳素賢，又從入關，故立耳為常山王，王趙地，都襄國。當陽君黥布為楚將，常冠軍，故立布為九江王，都六。鄱君吳芮率百越佐諸侯，又從入關，故立芮為衡山王，都邾。義帝柱國共敖將兵擊南郡，功多，因立敖為臨江王，都江陵。徙燕王韓廣為遼東王。燕將臧荼從楚救趙，因從入關，故立荼為燕王，都薊。徙齊王田市為膠東王。齊將田都從共救趙，因從入關，故立都為齊王，都臨菑。故秦所滅齊王建孫田安，項羽方渡河救趙，田安下濟北數城，引其兵降項羽，故立安為濟北王，都博陽。田榮者，數負項梁，又不肯將兵從楚擊秦，以故不封。成安君陳餘棄將印去，不從入關，然素聞其賢，有功於趙，聞其在南皮，故因環封三縣。番君將梅鋗功多，故封十萬戶侯。項王自立為西楚霸王，王九郡，都彭城。"}],"rationale":"本卷故秦所滅的齊王建，與前卷秦滅齊王建的敘事相接。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji094-005","person_id":"cbr-p005217","surfaces":["齊王建"],"scope":"same_chapter","chapter_ids":["c-shiji-094-tiandan"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-094-tiandan:p003","quote":"秦將章邯圍魏王咎於臨濟，急。魏王請救於齊，齊王田儋將兵救魏。章邯夜銜枚擊，大破齊、魏軍，殺田儋於臨濟下。儋弟田榮收儋餘兵東走東阿。齊人聞王田儋死，乃立故齊王建之弟田假為齊王、田角為相、田間為將，以距諸侯。"},{"paragraph_id":"c-shiji-094-tiandan:p006","quote":"項羽既存趙，降章邯等，西屠咸陽，滅秦而立侯王也，乃徙齊王田市更王膠東，治即墨。齊將田都從共救趙，因入關，故立都為齊王，治臨淄。故齊王建孫田安，項羽方渡河救趙，田安下濟北數城，引兵降項羽，項羽立田安為濟北王，治博陽。田榮以負項梁不肯出兵助楚、趙攻秦，故不得王；趙將陳餘亦失職，不得王：二人俱怨項王。"}],"rationale":"明示姓名與局部敘事承接，短稱及田間田閒等異字仍待覆核，不按全域同名合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji094-jian","person_ids":["cbr-p000570","cbr-p005217"],"canonical_person_id":"cbr-p000570","scope":"cross_chapter","chapter_ids":["c-shiji-007-xiangyu","c-shiji-094-tiandan"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-007-xiangyu","source_id":"s-shiji-007-xiangyu","paragraph_id":"c-shiji-007-xiangyu:p021","quote":"項王使人致命懷王。懷王曰：「如約。」乃尊懷王為義帝。項王欲自王，先王諸將相。謂曰：「天下初發難時，假立諸侯後以伐秦。然身被堅執銳首事，暴露於野三年，滅秦定天下者，皆將相諸君與籍之力也。義帝雖無功，故當分其地而王之。」諸將皆曰：「善。」乃分天下，立諸將為侯王。項王、范增疑沛公之有天下，業已講解，又惡負約，恐諸侯叛之，乃陰謀曰：「巴、蜀道險，秦之遷人皆居蜀。」乃曰：「巴、蜀亦關中地也。」故立沛公為漢王，王巴、蜀、漢中，都南鄭。而三分關中，王秦降將以距塞漢王。項王乃立章邯為雍王，王咸陽以西，都廢邱。長史欣者，故為櫟陽獄掾，嘗有德於項梁；都尉董翳者，本勸章邯降楚。故立司馬欣為塞王，王咸陽以東至河，都櫟陽；立董翳為翟王，王上郡，都高奴。徙魏王豹為西魏王，王河東，都平陽。瑕丘申陽者，張耳嬖臣也，先下河南（郡），迎楚河上，故立申陽為河南王，都雒陽。韓王成因故都，都陽翟。趙將司馬卬定河內，數有功，故立卬為殷王，王河內，都朝歌。徙趙王歇為代王。趙相張耳素賢，又從入關，故立耳為常山王，王趙地，都襄國。當陽君黥布為楚將，常冠軍，故立布為九江王，都六。鄱君吳芮率百越佐諸侯，又從入關，故立芮為衡山王，都邾。義帝柱國共敖將兵擊南郡，功多，因立敖為臨江王，都江陵。徙燕王韓廣為遼東王。燕將臧荼從楚救趙，因從入關，故立荼為燕王，都薊。徙齊王田市為膠東王。齊將田都從共救趙，因從入關，故立都為齊王，都臨菑。故秦所滅齊王建孫田安，項羽方渡河救趙，田安下濟北數城，引其兵降項羽，故立安為濟北王，都博陽。田榮者，數負項梁，又不肯將兵從楚擊秦，以故不封。成安君陳餘棄將印去，不從入關，然素聞其賢，有功於趙，聞其在南皮，故因環封三縣。番君將梅鋗功多，故封十萬戶侯。項王自立為西楚霸王，王九郡，都彭城。","mention_ids":["c-shiji-007-xiangyu:m021-0598"]},{"chapter_id":"c-shiji-094-tiandan","source_id":"s-shiji-094-tiandan","paragraph_id":"c-shiji-094-tiandan:p006","quote":"項羽既存趙，降章邯等，西屠咸陽，滅秦而立侯王也，乃徙齊王田市更王膠東，治即墨。齊將田都從共救趙，因入關，故立都為齊王，治臨淄。故齊王建孫田安，項羽方渡河救趙，田安下濟北數城，引兵降項羽，項羽立田安為濟北王，治博陽。田榮以負項梁不肯出兵助楚、趙攻秦，故不得王；趙將陳餘亦失職，不得王：二人俱怨項王。","mention_ids":["c-shiji-094-tiandan:m006-0064"]}],"rationale":"田安明示為秦所滅齊王建孫與本篇故齊王建孫相配，只同指不補中間父子。 各篇原字、原文與已發ID保留，同書不視為獨立見證；同指不確證所有紀年、任職、親屬或敘事，不按全域同名批量改號。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-006-shihuang:p020","text":"二十六年，齊王建與其相后勝發兵守其西界，不通秦。秦使將軍王賁從燕南攻齊，得齊王建。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:m020-0005","start":5,"end":8,"surface":"齊王建","kind":"person","person_id":"cbr-p000570","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m020-0011","start":11,"end":13,"surface":"后勝","kind":"person","person_id":"cbr-p000571","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m020-0026","start":26,"end":30,"surface":"將軍王賁","kind":"person","person_id":"cbr-p000567","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m020-0037","start":37,"end":40,"surface":"齊王建","kind":"person","person_id":"cbr-p000570","status":"contextual_provisional"}],"chapter_id":"c-shiji-006-shihuang","book_id":"b-shiji-006","work_id":"w-shiji","source_id":"s-shiji-006-shihuang"},{"id":"c-shiji-007-xiangyu:p021","text":"項王使人致命懷王。懷王曰：「如約。」乃尊懷王為義帝。項王欲自王，先王諸將相。謂曰：「天下初發難時，假立諸侯後以伐秦。然身被堅執銳首事，暴露於野三年，滅秦定天下者，皆將相諸君與籍之力也。義帝雖無功，故當分其地而王之。」諸將皆曰：「善。」乃分天下，立諸將為侯王。項王、范增疑沛公之有天下，業已講解，又惡負約，恐諸侯叛之，乃陰謀曰：「巴、蜀道險，秦之遷人皆居蜀。」乃曰：「巴、蜀亦關中地也。」故立沛公為漢王，王巴、蜀、漢中，都南鄭。而三分關中，王秦降將以距塞漢王。項王乃立章邯為雍王，王咸陽以西，都廢邱。長史欣者，故為櫟陽獄掾，嘗有德於項梁；都尉董翳者，本勸章邯降楚。故立司馬欣為塞王，王咸陽以東至河，都櫟陽；立董翳為翟王，王上郡，都高奴。徙魏王豹為西魏王，王河東，都平陽。瑕丘申陽者，張耳嬖臣也，先下河南（郡），迎楚河上，故立申陽為河南王，都雒陽。韓王成因故都，都陽翟。趙將司馬卬定河內，數有功，故立卬為殷王，王河內，都朝歌。徙趙王歇為代王。趙相張耳素賢，又從入關，故立耳為常山王，王趙地，都襄國。當陽君黥布為楚將，常冠軍，故立布為九江王，都六。鄱君吳芮率百越佐諸侯，又從入關，故立芮為衡山王，都邾。義帝柱國共敖將兵擊南郡，功多，因立敖為臨江王，都江陵。徙燕王韓廣為遼東王。燕將臧荼從楚救趙，因從入關，故立荼為燕王，都薊。徙齊王田市為膠東王。齊將田都從共救趙，因從入關，故立都為齊王，都臨菑。故秦所滅齊王建孫田安，項羽方渡河救趙，田安下濟北數城，引其兵降項羽，故立安為濟北王，都博陽。田榮者，數負項梁，又不肯將兵從楚擊秦，以故不封。成安君陳餘棄將印去，不從入關，然素聞其賢，有功於趙，聞其在南皮，故因環封三縣。番君將梅鋗功多，故封十萬戶侯。項王自立為西楚霸王，王九郡，都彭城。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-007-xiangyu:m021-0000","start":0,"end":2,"surface":"項王","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m021-0006","start":6,"end":8,"surface":"懷王","kind":"person","person_id":"cbr-p000682","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m021-0009","start":9,"end":11,"surface":"懷王","kind":"person","person_id":"cbr-p000682","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m021-0020","start":20,"end":22,"surface":"懷王","kind":"person","person_id":"cbr-p000682","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m021-0023","start":23,"end":25,"surface":"義帝","kind":"person","person_id":"cbr-p000682","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m021-0026","start":26,"end":28,"surface":"項王","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m021-0034","start":34,"end":37,"surface":"諸將相","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、匿名者、群體、動物或未定指代保留待核；不補姓名、闕代或個別成員。"},{"id":"c-shiji-007-xiangyu:m021-0051","start":51,"end":54,"surface":"諸侯後","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、匿名者、群體、動物或未定指代保留待核；不補姓名、闕代或個別成員。"},{"id":"c-shiji-007-xiangyu:m021-0087","start":87,"end":88,"surface":"籍","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m021-0092","start":92,"e