i-007-xiangyu:m021-0412","start":412,"end":415,"surface":"趙王歇","kind":"person","person_id":"cbr-p000674","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m021-0421","start":421,"end":423,"surface":"張耳","kind":"person","person_id":"cbr-p000676","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m021-0433","start":433,"end":434,"surface":"耳","kind":"person","person_id":"cbr-p000676","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m021-0447","start":447,"end":450,"surface":"當陽君","kind":"person","person_id":"cbr-p000680","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m021-0450","start":450,"end":452,"surface":"黥布","kind":"person","person_id":"cbr-p000656","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m021-0462","start":462,"end":463,"surface":"布","kind":"person","person_id":"cbr-p000656","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m021-0473","start":473,"end":475,"surface":"吳芮","kind":"person","person_id":"cbr-p000700","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m021-0489","start":489,"end":490,"surface":"芮","kind":"person","person_id":"cbr-p000700","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m021-0498","start":498,"end":500,"surface":"義帝","kind":"person","person_id":"cbr-p000682","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m021-0502","start":502,"end":504,"surface":"共敖","kind":"person","person_id":"cbr-p000701","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m021-0515","start":515,"end":516,"surface":"敖","kind":"person","person_id":"cbr-p000701","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m021-0528","start":528,"end":530,"surface":"韓廣","kind":"person","person_id":"cbr-p000702","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m021-0537","start":537,"end":539,"surface":"臧荼","kind":"person","person_id":"cbr-p000703","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m021-0551","