extual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-040-chu:m029-0075","start":75,"end":76,"surface":"莫","kind":"person","person_id":"cbr-p001904","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p029","chapter_id":"c-shiji-040-chu"}],"relations":[{"id":"a-shiji040-037","subject_person_id":"cbr-p001904","predicate":"father","object_person_id":"cbr-p001888","status":"source_attested","evidence":[{"chapter_id":"c-shiji-040-chu","source_id":"s-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p029","quote":"康王寵弟公子圍、子比、子皙、棄疾。郟敖三年，以其季父康王弟公子圍爲令尹，主兵事。四年，圍使鄭，道聞王疾而還。十二月己酉，圍入問王疾，絞而弒之，遂殺其子莫及平夏。使使赴於鄭。伍舉問曰：「誰爲後？」對曰：「寡大夫圍。」伍舉更曰：「共王之子圍爲長。」子比奔晉，而圍立，是爲靈王。"}],"qualifiers":{"source_term":"子／其子","historicity":"historical_tradition"},"interpretation_note":"依本段明示生育、兄弟、母子及苗裔敘事；祖先不作直接父親，繼位不自動推父子，不補未見母名或闕代。來源主張不等於版本與史實已覆核。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-040-chu:p029","text":"康王寵弟公子圍、子比、子皙、棄疾。郟敖三年，以其季父康王弟公子圍爲令尹，主兵事。四年，圍使鄭，道聞王疾而還。十二月己酉，圍入問王疾，絞而弒之，遂殺其子莫及平夏。使使赴於鄭。伍舉問曰：「誰爲後？」對曰：「寡大夫圍。」伍舉更曰：「共王之子圍爲長。」子比奔晉，而圍立，是爲靈王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m029-0000","start":0,"end":2,"surface":"康王","kind":"person","person_id":"cbr-p001887","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m029-0004","start":4,"end":7,"surface":"公子圍","kind":"person","person_id":"cbr-p001889","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m029-0008","start":8,"end":10,"surface":"子比","kind":"person","person_id":"cbr-p001890","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m029-0011","start":11,"end":13,"surface":"子皙","kind":"person","person_id":"cbr-p001891","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m029-0014","start":14,"end":16,"surface":"棄疾","k