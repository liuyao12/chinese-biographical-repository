:"c-jinshu-059-prince-lun:p003:m0501","surface":"倫","start":501,"end":502,"person_id":"dkn_ge4_286_AAAAG","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-059-prince-lun","book_id":"b-jinshu-059","work_id":"w-jinshu","source_id":"s-jinshu-059-prince-lun-ws2650517"},{"id":"c-jinshu-060-lihan:p001","text":"李含，字世容，隴西狄道人也。僑居始平。少有才幹，兩郡並舉孝廉。安定皇甫商州裏年少，少恃豪族，以含門寒微，欲與結交，含距而不納，商恨焉，遂諷州以短檄召含為門亭長。會州刺史郭奕素聞其賢，下車擢含為別駕，遂處群僚之右。尋舉秀才，薦之公府，自太保掾轉秦國郎中令。司徒遷含領始平中正。秦王柬薨，含依臺儀，葬訖除喪。尚書趙浚有內寵，疾含不事己，遂奏含不應除喪。本州大中正傅祗以名義貶含。中丞傅咸上表理含曰：","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":62,"last_line":62,"raw_start":4710,"raw_end":4909,"raw_character_offsets":[4712,4713,4714,4715,4716,4717,4718,4719,4720,4721,4722,4723,4724,4725,4726,4727,4728,4729,4730,4731,4732,4733,4734,4735,4736,4737,4738,4739,4740,4741,4742,4743,4744,4745,4746,4747,4748,4749,4750,4751,4752,4753,4754,4755,4756,4757,4758,4759,4760,4761,4762,4763,4764,4765,4766,4767,4768,4769,4770,4771,4772,4773,4774,4775,4776,4777,4778,4779,4780,4781,4782,4783,4784,4785,4786,4787,4788,4789,4790,4791,4792,4793,4794,4795,4796,4797,4798,4799,4800,4801,4802,4803,4804,4805,4806,4807,4808,4809,4810,4811,4812,4813,4814,4815,4816,4817,4818,4819,4820,4821,4822,4823,4824,4825,4826,4827,4828,4829,4830,4831,4832,4833,4834,4835,4836,4837,4838,4839,4840,4841,4842,4843,4844,4845,4846,4847,4848,4849,4850,4851,4852,4853,4854,4855,4856,4857,4858,4859,4860,4861,4862,4863,4864,4865,4866,4867,4868,4869,4870,4871,4872,4873,4874,4875,4876,4877,4878,4879,4880,4881,4882,4883,4884,4885,4886,4887,4888,4889,4890,4891,4892,4893,4894,4895,4896,4897,4898,4899,4900,4901,4902,4903,4904,4905,4906,4907,4908],"revision_id":2413335},"mentions":[{"id":"c-jinshu-060-lihan:p001:m0000","surface":"李含","start":0,"end":2,"person_id":"skr_sgj_x21","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-lihan:p001:m0033","surface":"皇甫商","start":33,"end":36,"person_id":"8er_b8z_4sn","kind":"person","status":"cont