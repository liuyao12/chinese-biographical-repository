":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-042-xiaotanzhi-complete:p004:m0057","start":57,"end":60,"surface":"蕭穎基","kind":"person","person_id":"118_dwd_2oi","status":"contextual_provisional","paragraph_id":"c-nanqishu-042-xiaotanzhi-complete:p004","chapter_id":"c-nanqishu-042-xiaotanzhi-complete"}],"relations":[],"title_holdings":[{"id":"th-nanqishu-042-xiaotanzhi-complete-4-53","title":"南陽太守","kind":"office","mode":"attestation","person_id":"118_dwd_2oi","attestations":[{"id":"th-nanqishu-042-xiaotanzhi-complete-4-53:a","paragraph_id":"c-nanqishu-042-xiaotanzhi-complete:p004","start":53,"end":57,"surface":"南陽太守","person_mention_id":"c-nanqishu-042-xiaotanzhi-complete:p004:m0057","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-042","chapter_id":"c-nanqishu-042-xiaotanzhi-complete","source_id":"s-nanqishu-042-xiaotanzhi-complete-ws1507997","paragraph_id":"c-nanqishu-042-xiaotanzhi-complete:p004","quote":"　　高宗謀廢少帝，旣與蕭諶及坦之定謀。帝腹心直閤將軍曹道剛疑外間有異，密有處分，諶未能發。始興內史蕭季敞、南陽太守蕭穎基竝應還都，諶欲待二蕭至，藉其勢力以舉事。高宗慮事變，以告坦之，坦之馳謂諶曰：「廢天子古來大事。比聞曹道剛、朱隆之等轉已猜疑。衞尉明日若不就事，無所復及。弟有百歲母，豈能坐聽禍敗，政應作餘計耳！」諶遑遽，明日遂廢帝，坦之力也。","person_mention_id":"c-nanqishu-042-xiaotanzhi-complete:p004:m0057"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-042-xiaotanzhi-complete:p004","text":"　　高宗謀廢少帝，旣與蕭諶及坦之定謀。帝腹心直閤將軍曹道剛疑外間有異，密有處分，諶未能發。始興內史蕭季敞、南陽太守蕭穎基竝應還都，諶欲待二蕭至，藉其勢力以舉事。高宗慮事變，以告坦之，坦之馳謂諶曰：「廢天子古來大事。比聞曹道剛、朱隆之等轉已猜疑。衞尉明日若不就事，無所復及。弟有百歲母，豈能坐聽禍敗，政應作餘計耳！」諶遑遽，明日遂廢帝，坦之力也。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":55,"last_line":55,"raw_start":3970,"raw_end":4142,"raw_character_offsets":[3970,3971,3972,3973,3974,3975,3976,3977,3978,3979,3980,3981,3982,3983,3984,3985,3986,3987,3988,3989,3990,3991,3992,3993,3994,3995,3996,3997,3998,3999,4000,4001,4002,4003,4004,4005,4006,4007,4008,4009,4010,4011,4012,4013,4014,4015,4016,4017,4018,4019,4020,4021,4022,4023,4024,4025,4026,4027,4028,4029,4030,4031,4032,4033,4034,4035,4036,4037,4038,4039,4040,4041,4042,4043,4044,4045,4046,4047,4048,4049,4050,4051,4052,4053,4054,4055,4056,4057,4058,4059,4060,4061,4062,4063,4064,4065,4066,4067,4068,4069,4070,4071,4072,4073,4074,4075,4076,4077,4078,4079,4080,4081,4082,4083,4084,4085,4086,4087,4088,4089,4090,4091,4092,4093,4094,4095,4096,4097,4098,4099,4100,4101,4102,4103,4104,4105,4106,4107,4108,4109,4110,4111,4112,4113,4114,4115,4116,4117,4118,4119,4120,4121,4122,4123,4124,4125,4126,4127,4128,4129,4130,4131,4132,4133,4134,4135,4136,4137,4138,4139,4140,4141],"revision_id":1507997},"mentions":[{"id":"c-nanqishu-042-xiaotanzhi-complete:p004:m0002","start":2,"end":4,"surface":"高宗","kind":"person","person_id":"w4m_9tw_147","status":"contextual_provisional"},{"id":"c-nanqishu-042-xiaotanzhi-complete:p004:m0006","start":6,"end":8,"surface":"少帝","kind":"person","person_id":"iop_ybd_afm","status":"contextual_provisional"},{"id":"c-nanqishu-042-xiaotanzhi-complete:p004:m0011","start":11,"end":13,"surface":"蕭諶","kind":"person","person_id":"wp8_2dc_ric","status":"contextual_provisional"},{"id":"c-nanqishu-042-xiaotanzhi-complete:p004:m0014","start":14,"end":16,"surface":"坦之","kind":"person","person_id":"usc_jkv_uhn","status":"contextual_provisional"},{"id":"c-nanqishu-042-xiaotanzhi-complete:p004:m0026","start":26,"end":29,"surface":"曹道剛","kind":"person","person_id":"ox9_gi5_4mm","status":"contextual_provisional"},{"id":"c-na