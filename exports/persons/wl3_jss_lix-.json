{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"wl3_jss_lix-","canonical_person_id":"wl3_jss_lix","id_aliases":["wl3_jss_lix-"],"identity_policy":"contextual_provisional","person_ids":["wl3_jss_lix"],"persons":[{"id":"wl3_jss_lix","label":"奚齊（劉敬叔孫通列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"奚齊","mention_ids":["c-shiji-099-liushu:m016-0056"]}],"evidence":[{"mention_id":"c-shiji-099-liushu:m016-0056","chapter_id":"c-shiji-099-liushu","paragraph_id":"c-shiji-099-liushu:p016","quote":"奚齊"}],"id_aliases":["wl3_jss_lix-"]}],"source_mention_summary":[{"source_id":"s-shiji-099-liushu","work_id":"w-shiji","book_id":"b-shiji-099","chapter_id":"c-shiji-099-liushu","mention_count":1,"mention_ids":["c-shiji-099-liushu:m016-0056"],"paragraph_ids":["c-shiji-099-liushu:p016"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-099-liushu"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-099-liushu:m016-0056","start":56,"end":58,"surface":"奚齊","kind":"person","person_id":"wl3_jss_lix","status":"contextual_provisional","paragraph_id":"c-shiji-099-liushu:p016","chapter_id":"c-shiji-099-liushu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji099-028","person_id":"wl3_jss_lix","surfaces":["奚齊"],"scope":"same_chapter","chapter_ids":["c-shiji-099-liushu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-099-liushu:p016","quote":"漢九年，高帝徙叔孫通為太子太傅。漢十二年，高祖欲以趙王如意易太子，叔孫通諫上曰：「昔者晉獻公以驪姬之故廢太子，立奚齊，晉國亂者數十年，為天下笑。秦以不蚤定扶蘇，令趙高得以詐立胡亥，自使滅祀，此陛下所親見。今太子仁孝，天下皆聞之；呂后與陛下攻苦食啖，其可背哉！陛下必欲廢適而立少，臣願先伏誅，以頸血汙地。」高帝曰：「公罷矣，吾直戲耳。」叔孫通曰：「太子天下本，本一搖天下振動，柰何以天下為戲！」高帝曰：「吾聽公言。」及上置酒，見留侯所招客從太子入見，上乃遂無易太子志矣。"}],"rationale":"依婁敬賜姓劉氏及叔孫通叔孫生敘事承接；各引語依人物事件範圍定位。從遠祖不補父系，和親假設不當實際生育，太子未定錨點留待逐項整理。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-099-liushu:p016","text":"漢九年，高帝徙叔孫通為太子太傅。漢十二年，高祖欲以趙王如意易太子，叔孫通諫上曰：「昔者晉獻公以驪姬之故廢太子，立奚齊，晉國亂者數十年，為天下笑。秦以不蚤定扶蘇，令趙高得以詐立胡亥，自使滅祀，此陛下所親見。今太子仁孝，天下皆聞之；呂后與陛下攻苦食啖，其可背哉！陛下必欲廢適而立少，臣願先伏誅，以頸血汙地。」高帝曰：「公罷矣，吾直戲耳。」叔孫通曰：「太子天下本，本一搖天下振動，柰何以天下為戲！」高帝曰：「吾聽公言。」及上置酒，見留侯所招客從太子入見，上乃遂無易太子志矣。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-099-liushu:m016-0004","start":4,"end":6,"surface":"高帝","kind":"person","person_id":"khs_72e_51r","status":"contextual_provisional"},{"id":"c-shiji-099-liushu:m016-0007","start":7,"end":10,"surface":"叔孫通","kind":"person","person_id":"x8f_fyc_zvc","status":"contextual_provisional"},{"id":"c-shiji-099-liushu:m016-0011","start":11,"end":13,"surface":"太子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、合稱或待辨稱名；和親條件及建議中的未來子孫不當實際人物。"},{"id":"c-shiji-099-liushu:m016-0021","start":21,"end":23,"surface":"高祖","kind":"person","person_id":"khs_72e_51r","status":"contextual_provisional"},{"id":"c-shiji-099-liushu:m016-0027","start":27,"end":29,"surface":"如意","kind":"person","person_id":"zo8_5pl_vnr","status":"contextual_provisional"},{"id":"c-shiji-099-liushu:m016-0030","start":30,"end":32,"surface":"太子","kind":"person","person_id":"sxh_xrd_qlt","status":"contextual_provisional"},{"id":"c-shiji-099-liushu:m016-0033","start":33,"end":36,"surface":"叔孫通","kind":"person","person_id":"x8f_fyc_zvc","status":"contextual_provisional"},{"id":"c-shiji-099-liushu:m016-0043","start":43,"end":46,"surface":"晉獻公","kind":"person","person_id":"jvl_f6r_3bd","status":"contextual_provisional"},{"id":"c-shiji-099-liushu:m016-