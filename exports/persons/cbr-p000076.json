xia:m034-0107","start":107,"end":108,"surface":"桀","kind":"person","person_id":"cbr-p000076","status":"source_identified"},{"id":"c-shiji-002-xia:m034-0118","start":118,"end":119,"surface":"湯","kind":"person","person_id":"cbr-p000077","status":"source_identified"},{"id":"c-shiji-002-xia:m034-0128","start":128,"end":129,"surface":"湯","kind":"person","person_id":"cbr-p000077","status":"source_identified"},{"id":"c-shiji-002-xia:m034-0141","start":141,"end":142,"surface":"湯","kind":"person","person_id":"cbr-p000077","status":"source_identified"},{"id":"c-shiji-002-xia:m034-0143","start":143,"end":146,"surface":"夏之後","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、氏族、官職或未定指代；不推造個別姓名。"}],"chapter_id":"c-shiji-002-xia","book_id":"b-shiji-002","work_id":"w-shiji","source_id":"s-shiji-002-xia"},{"id":"c-shiji-003-yin:p007","text":"當是時，夏桀為虐政淫荒，而諸侯昆吾氏為亂。湯乃興師率諸侯，伊尹從湯，湯自把鉞以伐昆吾，遂伐桀。湯曰：「格女眾庶，來，女悉聽朕言。匪台小子，敢行舉亂，有夏多罪，予維聞女眾言，夏氏有罪。予畏上帝，不敢不正。今夏多罪，天命殛之。今女有眾，女曰：『我君不恤我眾，舍我嗇事而割政』。女其曰：『有罪，其柰何』？夏王率止眾力，率奪夏國。有眾率怠不和，曰：『是日何時喪？予與女皆亡』！夏德若茲，今朕必往。爾尚及予一人致天之罰，予其大理女。女毋不信，朕不食言。女不從誓言，予則帑僇女，無有攸赦。」以告令師，作湯誓。於是湯曰：「吾甚武」，號曰武王。","mentions":[{"id":"c-shiji-003-yin:m007-0004","start":4,"end":6,"surface":"夏桀","kind":"person","person_id":"cbr-p000076","status":"source_identified"},{"id":"c-shiji-003-yin:m007-0015","start":15,"end":18,"surface":"昆吾氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"氏族、群體、官稱或未定個人指代；不由熟知故事補出姓名。"},{"id":"c-shiji-003-yin:m007-0021","start":21,"end":22,"surface":"湯","kind":"person","person_id":"cbr-p000077","status":"source_identified"},{"id":"c-shiji-003-yin:m007-0029","start":29,"end":31,"surface":"伊尹","kind":"person","person_id":"cbr-p000094","status":"source_identified"},{"id":"c-shiji-003-yin:m007-0032","start":32,"end":33,"surface":"湯","kind":"person","person_id":"cbr-p000077","status":"source_identified"},{"id":"c-shiji-003-yin:m007-0034","start":34,"end":35,"surface":"湯","kind":"person","person_id":"cbr-p000077","status":"source_identified"},{"id":"c-shiji-003-yin:m007-0040","start":40,"end":42,"surface":"昆吾","kind":"unresolved","person_id":null,"status":"unresolved","note":"氏族、群體、官稱或未定個人指代；不由熟知故事補出姓名。"},{"id":"c-shiji-003-yin:m007-0045","start":45,"end":46,"surface":"桀","kind":"person","person_id":"cbr-p000076","status":"source_identified"},{"id":"c-shiji-003-yin:m007-0047","start":47,"end":48,"surface":"湯","kind":"person","person_id":"cbr-p000077","status":"source_identified"},{"id":"c-shiji-003-yin:m007-0149","start":149,"end":151,"surface":"夏王","kind":"unresolved","person_id":null,"status":"unresolved","note":"氏族、群體、官稱或未定個人指代；不由熟知故事補出姓名。"},{"id":"c-shiji-003-yin:m007-0250","start":250,"end":251,"surface":"湯","kind":"person","person_id":"cbr-p000077","status":"source_identified"},{"id":"c-shiji-003-yin:m007-0261","start":261,"end":263,"surface":"武王","kind":"person","person_id":"cbr-p000077","status":"contextual_provisional","interpretation_note":"本段明示湯號武王，不連到周武王。"}],"chapter_id":"c-shiji-003-yin","book_id":"b-shiji-003","work_id":"w-shiji","source_id":"s-shiji-003-yin"},{"id":"c-shiji-003-yin:p008","text":"桀敗於有娀之虛，桀犇於鳴條，夏師敗績。湯遂伐三㚇，俘厥寶玉，義伯、仲伯作典寶。湯既勝夏，欲遷其社，不可，作夏社。伊尹報。於是諸侯畢服，湯乃踐天子位，平定海內。","mentions":[{"id":"c-shiji-003-yin:m008-0000","start":0,"end":1,"surface":"桀","kind":"person","person_id":"cbr-p000076","status":"source_identified"},{"id":"c-shiji-003-yin:m008-0008","start":8,"end":9,"surface":"桀","kind":"person","person_id":"cbr-p000076","status":"source_identified"},{"id":"c-shiji-003-yin:m008-0019","start":19,"end":20,"surface":"湯","kind":"person","person_id":"cbr-p000077","status":"source_identified"},{"id":"c-shiji-003-yin:m008-0030","start":30,"end":32,"surface":"義伯","kind":"person","person_id":"cbr-p000097","status":"source_identified"},{"id":"c-shiji-003-yin:m008-0033","start":33,"end":35,"surface":"仲伯","kind":"person","person_id":"cbr-p000098","status":"source_identified"},{"id":"c-shiji-003-yin:m008-0039","start":39,"end":40,"surface":"湯","kind":"person","person_id":"cbr-p000077","status":"source_identified"},{"id":"c-shiji-003-yin:m008-0056","start":56,"end":58,"surface":"伊尹","kind":"person","person_id":"cbr-p000094","status":"source_identified"},{"id":"c-shiji-003-yin:m008-0067","start":67,"end":68,"surface":"湯","kind":"person","person_id":"cbr-p000077","status":"source_identified"}],"chapter_id":"c-shiji-003-yin","book_id":"b-shiji-003","work_id":"w-shiji","source_id":"s-shiji-003-yin"},{"id":"c-shiji-005-qin:p002","text":"大費生子二人：一曰大廉，實鳥俗氏；二曰若木，實費氏。其玄孫曰費昌，子孫或在中國，或在夷狄。費昌當夏桀之時，去夏歸商，為湯御，以敗桀於鳴條。大廉玄孫曰孟戲、中衍，鳥身人言。帝太戊聞而卜之使御，吉，遂致使御而妻之。自太戊以下，中衍之後，遂世有功，以佐殷國，故嬴姓多顯，遂為諸侯。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m002-0000","start":0,"end":2,"surface":"大費","kind":"person","person_id":"cbr-p000316","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m002-0009","start":9,"end":11,"surface":"大廉","kind":"person","person_id":"cbr-p000317","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m002-0019","start":19,"end":21,"surface":"若木","kind":"person","person_id":"cbr-p000318","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m002-0026","start":26,"end":29,"surface":"其玄孫","kind":"unresolved","person_id":null,"status":"unresolved","note":"氏族、群體或未核定跨卷身份與指代；不補造個人與世代。"},{"id":"c-shiji-005-qin:m002-0030","start":30,"end":32,"surface":"費昌","kind":"person","person_id":"cbr-p000319","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m002-0033","start":33,"end":35,"surface":"子孫","kind":"unresolved","person_id":null,"status":"unresolved","note":"氏族、群體或未核定跨卷身份與指代；不補造個人與世代。"},{"id":"c-shiji-005-qin:m002-0045","start":45,"end":47,"surface":"費昌","kind":"person","person_id":"cbr-p000319","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m002-0048","start":48,"end":50,"surface":"夏桀","kind":"person","person_id":"cbr-p000076","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m002-0059","start":59,"end":60,"surface":"湯","kind":"person","person_id":"cbr-p000077","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m002-0064","start":64,"end":65,"surface":"桀","kind":"person","person_id":"cbr-p000076","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m002-0069","start":69,"end":71,"surface":"大廉","kind":"person","person_id":"cbr-p000317","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m002-0074","start":74,"end":76,"surface":"孟戲","kind":"person","person_id":"cbr-p000320","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m002-0077","start":77,"end":79,"surface":"中衍","kind":"person","person_id":"cbr-p000321","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m002-0085","start":85,"end":88,"surface":"帝太戊","kind":"person","person_id":"cbr-p000109","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m002-0106","start":106,"end":108,"surface":"太戊","kind":"person","person_id":"cbr-p000109","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m002-0111","start":111,"end":113,"surface":"中衍","kind":"person","person_id":"cbr-p000321","status":"contextual_provisional"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-040-chu:p002","text":"呉回生陸終。陸終生子六人，坼剖而産焉。其長一曰昆吾；二曰參胡；三曰彭祖；四曰會人；五曰曹姓；六曰季連，羋姓，楚其後也。昆吾氏，夏之時嘗爲侯伯，桀之時湯滅之。彭祖氏，殷之時嘗爲侯伯，殷之末世滅彭祖氏。季連生附沮，附沮生穴熊。其後中微，或在中國，或在蠻夷，弗能紀其世。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m002-0000","start":0,"end":2,"surface":"呉回","kind":"person","person_id":"cbr-p001842","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m002-0003","start":3,"end":5,"surface":"陸終","kind":"person","person_id":"cbr-p001845","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m002-0006","start":6,"end":8,"surface":"陸終","kind":"person","person_id":"cbr-p001845","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m002-0023","start":23,"end":25,"surface":"昆吾","kind":"person","person_id":"cbr-p001846","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m002-0028","start":28,"end":30,"surface":"參胡","kind":"person","person_id":"cbr-p001847","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m002-0033","start":33,"end":35,"surface":"彭祖","kind":"person","person_id":"cbr-p001848","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m002-0038","start":38,"end":40,"surface":"會人","kind":"person","person_id":"cbr-p001849","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m002-0043","start":43,"end":45,"surface":"曹姓","kind":"person","person_id":"cbr-p001850","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m002-0048","start":48,"end":50,"surface":"季連","kind":"person","person_id":"cbr-p001851","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m002-0059","start":59,"end":62,"surface":"昆吾氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"本處為氏族／群體稱呼，與祖系中的具名個人分開，未補全體成員。"},{"id":"c-shiji-040-chu:m002-0071","start":71,"end":72,"surface":"桀","kind":"person","person_id":"cbr-p000076","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m002-0074","start":74,"end":75,"surface":"湯","kind":"person","person_id":"cbr-p000077","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m002-0078","start":78,"end":81,"surface":"彭祖氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"本處為氏族／群體稱呼，與祖系中的具名個人分開，未補全體成員。"},{"id":"c-shiji-040-chu:m002-0095","start":95,"end":98,"surface":"彭祖氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"本處為氏族／群體稱呼，與祖系中的具名個人分開，未補全體成員。"},{"id":"c-shiji-040-chu:m002-0099","start":99,"end":101,"surface":"季連","kind":"person","person_id":"cbr-p001851","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m002-0102","start":102,"end":104,"surface":"附沮","kind":"person","person_id":"cbr-p001852","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m002-0105","start":105,"end":107,"surface":"附沮","kind":"person","person_id":"cbr-p001852","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m002-0108","start":108,"end":110,"surface":"穴熊","kind":"person","person_id":"cbr-p001853","status":"contextual_provisional"}],"chapter_id":"c-shiji-040-chu","book_id":"b-shiji-040","work_id":"w-shiji","source_id":"s-shiji-040-chu"},{"id":"c-shiji-040-chu:p021","text":"八年，伐陸渾戎，遂至洛，觀兵於周郊。周定王使王孫滿勞楚王。楚王問鼎小大輕重，對曰：「在德不在鼎。」莊王曰：「子無阻九鼎！楚國折鉤之喙，足以爲九鼎。」王孫滿曰：「嗚呼！君王其忘之乎？昔虞夏之盛，遠方皆至，貢金九牧，鑄鼎象物，百物而爲之備，使民知神姦。桀有亂德，鼎遷於殷，載祀六百。殷紂暴虐，鼎遷於周。德之休明，雖小必重；其姦回昏亂，雖大必輕。昔成王定鼎于郟鄏，卜世三十，卜年七百，天所命也。周德雖衰，天命未改。鼎之輕重，未可問也。」楚王乃歸。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m021-0018","start":18,"end":21,"surface":"周定王","kind":"person","person_id":"cbr-p002008","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m021-0022","start":22,"end":25,"surface":"王孫滿","kind":"person","person_id":"cbr-p000258","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m021-0026","start":26,"end":28,"surface":"楚王","kind":"person","person_id":"cbr-p001885","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m021-0029","start":29,"end":31,"surface":"楚王","kind":"person","person_id":"cbr-p001885","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m021-0049","start":49,"end":51,"surface":"莊王","kind":"person","person_id":"cbr-p001885","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m021-0074","start":74,"end":77,"surface":"王孫滿","kind":"person","person_id":"cbr-p000258","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m021-0124","start":124,"end":125,"surface":"桀","kind":"person","person_id":"cbr-p000076","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m021-0139","start":139,"end":141,"surface":"殷紂","kind":"person","person_id":"cbr-p000136","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m021-0171","start":171,"end":173,"surface":"成王","kind":"person","person_id":"cbr-p000155","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m021-0215","start":215,"end":217,"surface":"楚王","kind":"person","person_id":"cbr-p001885","status":"contextual_provisional"}],"chapter_id":"c-shiji-040-chu","book_id":"b-shiji-040","work_id":"w-shiji","source_id":"s-shiji-040-chu"},{"id":"c-shiji-040-chu:p030","text":"靈王三年六月，楚使使告晉，欲會諸侯。諸侯皆會楚于申。伍舉曰：「昔夏啓有鈞臺之饗，商湯有景亳之命，周武王有盟津之誓，成王有岐陽之閒，康王有豐宮之朝，穆王有涂山之會，齊桓有召陵之師，晉文有踐土之盟，君其何用？」靈王曰：「用桓公。」時鄭子産在焉。於是晉、宋、魯、衞不往。靈王已盟，有驕色。伍舉曰：「桀爲有仍之會，有緡叛之。紂爲黎山之會，東夷叛之。幽王爲太室之盟，戎、翟叛之。君其愼終！」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m030-0000","start":0,"end":2,"surface":"靈王","kind":"person","person_id":"cbr-p001889","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m030-0026","start":26,"end":28,"surface":"伍舉","kind":"person","person_id":"cbr-p001893","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m030-0032","start":32,"end":34,"surface":"夏啓","kind":"person","person_id":"cbr-p000059","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m030-0040","start":40,"end":42,"surface":"商湯","kind":"person","person_id":"cbr-p000077","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m030-0048","start":48,"end":51,"surface":"周武王","kind":"person","person_id":"cbr-p000150","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m030-0057","start":57,"end":59,"surface":"成王","kind":"person","person_id":"cbr-p000155","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m030-0065","start":65,"end":67,"surface":"康王","kind":"person","person_id":"cbr-p000195","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m030-0073","start":73,"end":75,"surface":"穆王","kind":"person","person_id":"cbr-p000197","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m030-0081","start":81,"end":83,"surface":"齊桓","kind":"person","person_id":"cbr-p000235","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m030-0089","start":89,"end":91,"surface":"晉文","kind":"person","person_id":"cbr-p000252","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m030-0103","start":103,"end":105,"surface":"靈王","kind":"person","person_