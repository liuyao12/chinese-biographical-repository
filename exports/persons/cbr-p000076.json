1-0124","start":124,"end":125,"surface":"桀","kind":"person","person_id":"cbr-p000076","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p021","chapter_id":"c-shiji-040-chu"},{"id":"c-shiji-040-chu:m030-0146","start":146,"end":147,"surface":"桀","kind":"person","person_id":"cbr-p000076","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p030","chapter_id":"c-shiji-040-chu"}],"relations":[{"id":"a-shiji002-026","subject_person_id":"cbr-p000076","predicate":"father","object_person_id":"cbr-p000075","status":"source_attested","evidence":[{"chapter_id":"c-shiji-002-xia","source_id":"s-shiji-002-xia","paragraph_id":"c-shiji-002-xia:p034","quote":"帝發崩，子帝履癸立"}],"qualifiers":{"source_term":"子","historicity":"legendary_tradition"},"interpretation_note":"僅記來源明示的親屬關係，不把繼位推成父子。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji002-alias-019","person_id":"cbr-p000076","surfaces":["帝履癸","桀"],"scope":"same_chapter","chapter_ids":["c-shiji-002-xia"],"status":"source_explicit","evidence":[{"paragraph_id":"c-shiji-002-xia:p034","quote":"帝發崩，子帝履癸立，是爲桀。"}],"rationale":"原文明示對應。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji003-006","person_id":"cbr-p000076","surfaces":["夏桀","桀"],"scope":"cross_chapter","chapter_ids":["c-shiji-002-xia","c-shiji-003-yin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-002-xia:p034","quote":"桀走鳴條"},{"paragraph_id":"c-shiji-003-yin:p008","quote":"桀犇於鳴條"}],"rationale":"依連續敘事、相同職事及事件暫定跨卷同指；不按同名自動合併到其他來源。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji005-004","person_id":"cbr-p000076","surfaces":["夏桀","桀"],"scope":"cross_chapter","chapter_ids":["c-shiji-002-xia","c-shiji-005-qin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-002-xia:p034","quote":"孔甲崩，子帝皋立。帝皋崩，子帝發立。帝發崩，子帝履癸立，是爲桀。帝桀之時，自孔甲以來而諸侯多畔夏，桀不務德而武傷百姓，百姓弗堪。迺召湯而囚之夏臺，已而釋之。湯修德，諸侯皆歸湯，湯遂率兵以伐夏桀。桀走鳴條，遂放而死。桀謂人曰：「吾悔不遂殺湯於夏臺，使至此。」湯乃踐天子位，代夏朝天下。湯封夏之後，至周封於杞也。"},{"paragraph_id":"c-shiji-005-qin:p002","quote":"大費生子二人：一曰大廉，實鳥俗氏；二曰若木，實費氏。其玄孫曰費昌，子孫或在中國，或在夷狄。費昌當夏桀之時，去夏歸商，為湯御，以敗桀於鳴條。大廉玄孫曰孟戲、中衍，鳥身人言。帝太戊聞而卜之使御，吉，遂致使御而妻之。自太戊以下，中衍之後，遂世有功，以佐殷國，故嬴姓多顯，遂為諸侯。"}],"rationale":"依相同時代的帝王稱號及敘事職事暫定跨卷同指；傳說身份與世系仍待專門研究，不作全域字串合併。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji040-113","person_id":"cbr-p000076","surfaces":["桀"],"scope":"cross_chapter","chapter_ids":["c-shiji-002-xia","c-shiji-040-chu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-002-xia:p034","quote":"孔甲崩，子帝皋立。帝皋崩，子帝發立。帝發崩，子帝履癸立，是爲桀。帝桀之時，自孔甲以來而諸侯多畔夏，桀不務德而武傷百姓，百姓弗堪。迺召湯而囚之夏臺，已而釋之。湯修德，諸侯皆歸湯，湯遂率兵以伐夏桀。桀走鳴條，遂放而死。桀謂人曰：「吾悔不遂殺湯於夏臺，使至此。」湯乃踐天子位，代夏朝天下。湯封夏之後，至周封於杞也。"},{"paragraph_id":"c-shiji-040-chu:p002","quote":"呉回生陸終。陸終生子六人，坼剖而産焉。其長一曰昆吾；二曰參胡；三曰彭祖；四曰會人；五曰曹姓；六曰季連，羋姓，楚其後也。昆吾氏，夏之時嘗爲侯伯，桀之時湯滅之。彭祖氏，殷之時嘗爲侯伯，殷之末世滅彭祖氏。季連生附沮，附沮生穴熊。其後中微，或在中國，或在蠻夷，弗能紀其世。"},{"paragraph_id":"c-shiji-040-chu:p021","quote":"八年，伐陸渾戎，遂至洛，觀兵於周郊。周定王使王孫滿勞楚王。楚王問鼎小大輕重，對曰：「在德不在鼎。」莊王曰：「子無阻九鼎！楚國折鉤之喙，足以爲九鼎。」王孫滿曰：「嗚呼！君王其忘之乎？昔虞夏之盛，遠方皆至，貢金九牧，鑄鼎象物，百物而爲之備，使民知神姦。桀有亂德，鼎遷於殷，載祀六百。殷紂暴虐，鼎遷於周。德之休明，雖小必重；其姦回昏亂，雖大必輕。昔成王定鼎于郟鄏，卜世三十，卜年七百，天所命也。周德雖衰，天命未改。鼎之輕重，未可問也。」楚王乃歸。"},{"paragraph_id":"c-shiji-040-chu:p030","quote":"靈王三年六月，楚使使告晉，欲會諸侯。諸侯皆會楚于申。伍舉曰：「昔夏啓有鈞臺之饗，商湯有景亳之命，周武王有盟津之誓，成王有岐陽之閒，康王有豐宮之朝，穆王有涂山之會，齊桓有召陵之師，晉文有踐土之盟，君其何用？」靈王曰：「用桓公。」時鄭子産在焉。於是晉、宋、魯、衞不往。靈王已盟，有驕色。伍舉曰：「桀爲有仍之會，有緡叛之。紂爲黎山之會，東夷叛之。幽王爲太室之盟，戎、翟叛之。君其愼終！」"}],"rationale":"楚篇夏／虞夏及商周更替引語中的桀，與夏篇履癸是為桀及湯伐桀的主體暫接。 引語敘事不當同日發生或已校定史實，範圍限列示段落。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-002-xia:p034","text":"孔甲崩，子帝皋立。帝皋崩，子帝發立。帝發崩，子帝履癸立，是爲桀。帝桀之時，自孔甲以來而諸侯多畔夏，桀不務德而武傷百姓，百姓弗堪。迺召湯而囚之夏臺，已而釋之。湯修德，諸侯皆歸湯，湯遂率兵以伐夏桀。桀走鳴條，遂放而死。桀謂人曰：「吾悔不遂殺湯於夏臺，使至此。」湯乃踐天子位，代夏朝天下。湯封夏之後，至周封於杞也。","mentions":[{"id":"c-shiji-002-xia:m034-0000","start":0,"end":2,"surface":"孔甲","kind":"person","person_id":"cbr-p000072","status":"source_identified"},{"id":"c-shiji-002-xia:m034-0005","start":5,"end":7,"surface":"帝皋","kind":"person","person_id":"cbr-p000074","status":"source