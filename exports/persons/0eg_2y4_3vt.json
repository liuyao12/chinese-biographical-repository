":"reviewed","source_position":{"first_line":36,"last_line":36,"raw_start":3051,"raw_end":3312,"raw_character_offsets":[3053,3054,3055,3056,3057,3058,3059,3060,3061,3062,3063,3064,3065,3066,3067,3068,3069,3070,3071,3072,3073,3074,3075,3076,3077,3078,3079,3080,3081,3082,3083,3084,3085,3086,3087,3088,3089,3090,3091,3092,3093,3094,3095,3096,3097,3098,3099,3100,3101,3102,3103,3104,3105,3106,3107,3108,3109,3110,3111,3112,3113,3114,3115,3116,3117,3118,3119,3120,3121,3122,3123,3124,3125,3126,3127,3128,3129,3130,3131,3132,3133,3134,3135,3136,3137,3138,3139,3140,3141,3142,3143,3144,3145,3146,3147,3148,3149,3150,3151,3152,3153,3154,3155,3156,3157,3158,3159,3160,3161,3162,3163,3164,3165,3166,3167,3168,3169,3170,3171,3172,3173,3174,3175,3176,3177,3178,3179,3180,3181,3182,3183,3184,3185,3186,3187,3188,3189,3190,3191,3192,3193,3194,3195,3196,3197,3200,3203,3204,3205,3206,3207,3208,3209,3210,3211,3212,3213,3214,3215,3216,3217,3218,3219,3220,3221,3222,3223,3224,3225,3226,3227,3228,3229,3230,3231,3232,3233,3234,3235,3236,3237,3238,3239,3240,3241,3242,3243,3244,3245,3246,3247,3248,3249,3250,3251,3252,3253,3254,3255,3256,3257,3258,3259,3260,3261,3262,3263,3264,3265,3266,3267,3268,3269,3270,3271,3272,3273,3274,3275,3276,3277,3278,3279,3280,3281,3282,3283,3284,3285,3286,3287,3288,3289,3290,3291,3292,3293,3294,3295,3296,3297,3298,3299,3300,3301,3302,3303,3304,3305,3306,3307,3308,3309,3310,3311],"revision_id":1775463},"mentions":[{"id":"c-jinshu-058-zhou-xie:p001:m0000","surface":"勰","start":0,"end":1,"person_id":"o1j_w2l_0gv","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-xie:p001:m0002","surface":"彥和","start":2,"end":4,"person_id":"o1j_w2l_0gv","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-xie:p001:m0039","surface":"勰","start":39,"end":40,"person_id":"o1j_w2l_0gv","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-xie:p001:m0053","surface":"徐馥","start":53,"end":55,"person_id":"oc0_z6e_st4","kind":"person