ntion_id":"c-jinshu-060-sunqi:p001:m0013","paragraph_id":"c-jinshu-060-sunqi:p001","chapter_id":"c-jinshu-060-sunqi","quote":"曆"}],"review":"ai_provisional","identity_note":"孫曆，見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-jinshu-060-sunqi-ws2413335","work_id":"w-jinshu","book_id":"b-jinshu-060","chapter_id":"c-jinshu-060-sunqi","raw_mention_count":1,"mention_ids":["c-jinshu-060-sunqi:p001:m0013"],"paragraph_ids":["c-jinshu-060-sunqi:p001"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-060-sunqi:p001:m0013","mention_ids":["c-jinshu-060-sunqi:p001:m0013"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-060-sunqi-ws2413335"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin060-sunqi-father","subject_person_id":"b9n_ldy_9p3","object_person_id":"muy_lgq_eek","predicate":"father","qualifiers":{"source_term":"父曆"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-060","chapter_id":"c-jinshu-060-sunqi","source_id":"s-jinshu-060-sunqi-ws2413335","paragraph_id":"c-jinshu-060-sunqi:p001","quote":"孫旂，字伯旗，樂安人也。父曆，魏晉際為幽州刺史、右將軍。旂潔靜，少自修立。察孝廉，累遷黃門侍郎，出為荊州刺史，名位與二解相亞。永熙中，徵拜太子詹事，轉衛尉，坐武庫火，免官。歲餘，出為兗州刺史，遷平南將軍、假節。旂子弼及弟子髦、輔、琰四人，並有吏材，稱於當世，遂與孫秀合族。及趙王倫起事，夜從秀開神武門下觀閱器械。兄弟旬月相次為公府掾、尚書郎。弼又為中堅將軍，領尚書左丞，轉為上將軍，領射聲校尉。髦為武衛將軍，領太子詹事。琰為武威將軍，領太子左率。皆賜爵開國郡侯。推崇旂為車騎將軍、開府。初，旂以弼等受署偽朝，遣小息回責讓弼等，以過差之事，必為家禍。弼等終不從，旂制之不可，但慟哭而已。及齊王冏起義，四子皆伏誅。襄陽太守宗岱承冏檄斬旂，夷三族。","subject_person_mention_id":"c-jinshu-060-sunqi:p001:m0000","object_person_mention_id":"c-jinshu-060-sunqi:p001:m0013"}],"status":"source_attested","interpretation_note":"曆在魏晉交界任官。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-060-sunqi:p001:m0013","surface":"曆","start":13,"end":14,"person_id":"muy_lgq_eek","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-060-sunqi:p001","chapter_id":"c-jinshu-060-sunqi"}],"relations":[{"id":"a-jin060-sunqi-father","subject_person_id":"b9n_ldy_9p3","object_person_id":"muy_lgq_eek","predicate":"father","qualifiers":{"source_term":"父曆"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-060","chapter_id":"c-jinshu-060-sunqi","source_id":"s-jinshu-060-sunqi-ws2413335","paragraph_id":"c-jinshu-060-sunqi:p001","quote":"孫旂，字伯旗，樂安人也。父曆，魏晉際為幽州刺史、右將軍。旂潔靜，少自修立。察孝廉，累遷黃門侍郎，出為荊州刺史，名位與二解相亞。永熙中，徵拜太子詹事，轉衛尉，坐武庫火，免官。歲餘，出為兗州刺史，遷平南將軍、假節。旂子弼及弟子髦、輔、琰四人，並有吏材，稱於當世，遂與孫秀合族。及趙王倫起事，夜從秀開神武門下觀閱器械。兄弟旬月相次為公府掾、尚書郎。弼又為中堅將軍，領尚書左丞，轉為上將軍，領射聲校尉。髦為武衛將軍，領太子詹事。琰為武威將軍，領太子左率。皆賜爵開國郡侯。推崇旂為車騎將軍、開府。初，旂以弼等受署偽朝，遣小息回責讓弼等，以過差之事，必為家禍。弼等終不從，旂制之不可，但慟哭而已。及齊王冏起義，四子皆伏誅。襄陽太守宗岱承冏檄斬旂，夷三族。","subject_person_mention_id":"c-jinshu-060-sunqi:p001:m0000","object_person_mention_id":"c-jinshu-060-sunqi:p001:m0013"}],"status":"source_attested","interpretation_note":"曆在魏晉交界任官。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-060-sunqi:p001","text":"孫旂，字伯旗，樂安人也。父曆，魏晉際為幽州刺史、右將軍。旂潔靜，少自修立。察孝廉，累遷黃門侍郎，出為荊州刺史，名位與二解相亞。永熙中，徵拜太子詹事，轉衛尉，坐武庫火，免官。歲餘，出為兗州刺史，遷平南將軍、假節。