nal_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-035-peiwei:p015:m0169","start":169,"end":171,"surface":"陳午","kind":"person","person_id":"jfo_960_rb2","status":"contextual_provisional","resolution_note":"末段殺嵩該，registry未見全名；不借頠卒年當二子死年。","paragraph_id":"c-jinshu-035-peiwei:p015","chapter_id":"c-jinshu-035-peiwei"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-035-peiwei:p015","text":"初，趙王倫諂事賈后，頠甚惡之，倫數求官，頠與張華復固執不許，由是深為倫所怨。倫又潛懷篡逆，欲先除朝望，因廢賈后之際遂誅之，時年三十四。二子嵩、該，倫亦欲害之。梁王肜、東海王越稱頠父秀有勳王室，配食太廟，不宜滅其後嗣，故得不死，徙帶方；惠帝反正，追復頠本官，改葬以卿禮，諡曰成。以嵩嗣爵，為中書黃門侍郎。該出後從伯凱，為散騎常侍，並為乞活賊陳午所害。","text_layer":"received_chapter","mentions":[{"id":"c-jinshu-035-peiwei:p015:m0002","start":2,"end":5,"surface":"趙王倫","kind":"person","person_id":"dkn_ge4_286_AAAAG","status":"contextual_provisional","resolution_note":"諂賈后、廢后除朝望/誅頠，已存同一八王事件身份，不復用退休bav。"},{"id":"c-jinshu-035-peiwei:p015:m0007","start":7,"end":9,"surface":"賈后","kind":"person","person_id":"c27_590_7e3_A","status":"contextual_provisional","resolution_note":"040p017–018郭槐女/太子妃/賈后，與本段太子廢黜/趙王倫事相同。"},{"id":"c-jinshu-035-peiwei:p015:m0010","start":10,"end":11,"surface":"頠","kind":"person","person_id":"4ni_4t1_4o9_AAB","status":"contextual_provisional","resolution_note":"root已採納裴頠同指，以4ni_4t1_4o9_AAB為keeper；本研究初次capture早於該接合，dc7僅歷史輸入，不是當前候選或alias。"},{"id":"c-jinshu-035-peiwei:p015:m0015","start":15,"end":16,"surface":"倫","kind":"person","person_id":"dkn_ge4_286_AAAAG","status":"contextual_provisional","resolution_note":"諂賈后、廢后除朝望/誅頠，已存同一八王事件身份，不復用退休bav。"},{"id":"c-jinshu-035-peiwei:p015:m0020","start":20,"end":21,"surface":"頠","kind":"person","person_id":"4ni_4t1_4o9_AAB","status":"contextual_provisional","resolution_note":"root已採納裴頠同指，以4ni_4t1_4o9_AAB為keeper；本研