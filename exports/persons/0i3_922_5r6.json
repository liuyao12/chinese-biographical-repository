nt":0,"end_codepoint":105,"source_quote":"《吴录》曰：松善与人交，轻财好施。镇巴丘，数咨陆逊以得失。尝有小过，逊面责松，松意色不平，逊观其少释，谓曰：“君过听不以某鄙，数见访及，是以承来意进尽言，便变色，何也？”松笑曰：“属亦自忿行事有此，岂有望邪！”","person_id":"0i3_922_5r6","related_person_ids":["lii_454_vuv"],"reading":"吳錄載松與陸遜相責答。","chapter_id":"c-sanguozhi-051-yi","source_id":"s-sanguozhi-051-yi"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-wu051-yi-2","subject_person_id":"0i3_922_5r6","object_person_id":"iyi_e4b_ig6","predicate":"father","qualifiers":{"source_term":"子松"},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-051","chapter_id":"c-sanguozhi-051-yi","source_id":"s-sanguozhi-051-yi","paragraph_id":"c-sanguozhi-051-yi:line041","quote":"　　孫翊字叔弼，權弟也，驍悍果烈，有兄策風。太守朱治舉孝廉，司空辟。建安八年，以偏將軍領丹楊太守，時年二十。後卒為左右邊鴻所殺，鴻亦即誅。子松為射聲校尉、都鄉侯。黃龍三年卒。蜀丞相諸葛亮與兄瑾書曰：“既受東朝厚遇，依依於子弟。又子喬良器，為之惻愴。見其所與亮器物，感用流涕。”其悼松如此，由亮養子喬咨述故雲。","subject_person_mention_id":"c-sanguozhi-051-yi:line041:m0070","object_person_mention_id":"c-sanguozhi-051-yi:line041:m0002"}],"interpretation_note":"以此來源所述兩端為據。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-wu051-yi2","person_id":"0i3_922_5r6","event_type":"death","source_term":"黃龍三年卒","date_expression":"黃龍三年","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-051","chapter_id":"c-sanguozhi-051-yi","source_id":"s-sanguozhi-051-yi","paragraph_id":"c-sanguozhi-051-yi:line041","quote":"　　孫翊字叔弼，權弟也，驍悍果烈，有兄策風。太守朱治舉孝廉，司空辟。建安八年，以偏將軍領丹楊太守，時年二十。後卒為左右邊鴻所殺，鴻亦即誅。子松為射聲校尉、都鄉侯。黃龍三年卒。蜀丞相諸葛亮與兄瑾書曰：“既受東朝厚遇，依依於子弟。又子喬良器，為之惻愴。見其所與亮器物，感用流涕。”其悼松如此，由亮養子喬咨述故雲。","person_mention_id":"c-sanguozhi-051-yi:line041:m0070"}],"interpretation_note":"本來源所記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-sanguozhi-051-yi:line041:m0070","sta