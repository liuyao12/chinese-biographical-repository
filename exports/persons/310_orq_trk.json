{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"310_orq_trk","canonical_person_id":"310_orq_trk","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["310_orq_trk"],"persons":[{"id":"310_orq_trk","label":"漢順烈皇后","status":"active","historicity":"historical_tradition","aliases":[{"surface":"順烈","mention_ids":["c-jinshu-032-chu-suanzi:line042:m0157"]}],"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-032","chapter_id":"c-jinshu-032-chu-suanzi","source_id":"s-jinshu-032-chu-suanzi","paragraph_id":"c-jinshu-032-chu-suanzi:line042","mention_id":"c-jinshu-032-chu-suanzi:line042:m0157","quote":"順烈"}],"review":"ai_provisional","identity_note":"《晉書》康獻褚皇后完整傳文人物；名、字與生母不由稱號推補，群體典故及待定人物另存。"}],"source_mention_summary":[{"source_id":"s-jinshu-032-chu-suanzi","work_id":"w-jinshu","book_id":"b-jinshu-032","chapter_id":"c-jinshu-032-chu-suanzi","mention_count":1,"mention_ids":["c-jinshu-032-chu-suanzi:line042:m0157"],"paragraph_ids":["c-jinshu-032-chu-suanzi:line042"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-jinshu-032-chu-suanzi"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-032-chu-suanzi:line042:m0157","start":157,"end":159,"surface":"順烈","kind":"person","person_id":"310_orq_trk","status":"contextual_provisional","paragraph_id":"c-jinshu-032-chu-suanzi:line042","chapter_id":"c-jinshu-032-chu-suanzi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-032-chu-suanzi:line042","text":"及穆帝即位，尊后曰皇太后。時帝幼沖，未親國政。領司徒蔡謨等上奏曰：「嗣皇誕哲岐嶷，繼承天統，率土宅心，兆庶蒙賴。陛下體茲坤道，訓隆文母。昔塗山光夏，簡狄熙殷，實由宣哲，以隆休祚。伏惟陛下德侔二媯，淑美關雎，臨朝攝政，以寧天下。今社稷危急，兆庶懸命，臣等章惶，一日萬機，事運之期，天祿所鍾，非復沖虛高讓之日。漢和熹、順烈，並亦臨朝，近明穆故事，以為先制。臣等不勝悲怖，謹伏地上請。乞陛下上順祖宗，下念臣吏，推公弘道，以協天人，則萬邦承慶，群黎更生。」太后詔曰：「帝幼沖，當賴群公卿士將順匡救，以酬先帝禮賢之意，且是舊德世濟之美，則莫重之命不墜，祖宗之基有奉，是其所以欲正位于內而已。所奏懇到，形于翰墨，執省未究，以悲以懼。先后允恭謙抑，思順坤道，所以不距群情，固為國計。豈敢執守沖闇，以違先旨。輒敬從所奏。」於是臨朝稱制。有司奏，謝夫人既封，荀、卞二夫人亦應追贈，皆后之前母也。太后不許。太常殷融議依鄭玄義，衛將軍裒在宮庭則盡臣敬，太后歸寧之日自如家人之禮。太后詔曰：「典禮誠所未詳，如所奏，是情所不能安也，更詳之。」征西將軍翼、南中郎尚議謂「父尊盡於一家，君敬重於天下，鄭玄義合情禮之中」。太后從之。自後朝臣皆敬裒焉。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-032-chu-suanzi:line042:m0001","start":1,"end":3,"surface":"穆帝","kind":"person","person_id":"84i_4jp_gmc","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0009","start":9,"end":12,"surface":"皇太后","kind":"person","person_id":"xke_dj3_6ba_AAB","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0014","start":14,"end":15,"surface":"帝","kind":"person","person_id":"84i_4jp_gmc","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0026","start":26,"end":28,"surface":"蔡謨","kind":"person","person_id":"b98_957_r7h","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0034","start":34,"end":36,"surface":"嗣皇","kind":"person","person_id":"84i_4jp_gmc","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0056","start":56,"end":58,"surface":"陛下","kind":"person","person_id":"xke_dj3_6ba_AAB","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0069","start":69,"end":71,"surface":"塗山","kind":"person","person_id":"t7k_3g1_qp3","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0074","start":74,"end":76,"surface":"簡狄","kind":"person","person_id":"qgn_r2c_qtv","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0091","start":91,"end":93,"surface":"陛下","kind":"person","person_id":"xke_dj3_6ba_AAB","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0095","start":95,"end":97,"surface":"二媯","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"二媯為二人合稱，不當單一人物；具體典故與個人錨點尚待支持。"},{"id":"c-jinshu-032-chu-suanzi:line042:m0154","start":154,"end":156,"surface":"和熹","kind":"person","person_id":"yke_ykv_ktg","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0157","start":157,"end":159,"surface":"順烈","kind":"person","person_id":"310_orq_trk","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0166","start":166,"end":168,"surface":"明穆","kind":"person","person_id":"4qr_wrk_3vd_A","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0190","start":190,"end":192,"surface":"陛下","kind":"person","person_id":"xke_dj3_6ba_AAB","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0224","start":224,"end":226,"surface":"太后","kind":"person","person_id":"xke_dj3_6ba_AAB","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0230","start":230,"end":231,"surface":"帝","kind":"person","person_id":"84i_4jp_gmc","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0247","start":247,"end":249,"surface":"先帝","kind":"person","person_id":"qpk_4pt_y6r","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0310","start":310,"end":312,"surface":"先后","kind":"person","person_id":"4qr_wrk_3vd_A","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0364","start":364,"end":367,"surface":"謝夫人","kind":"person","person_id":"d11_4kx_51l","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0370","start":370,"end":371,"surface":"荀","kind":"person","person_id":"o86_niw_j9s","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0372","start":372,"end":373,"surface":"卞","kind":"person","person_id":"mpc_jpz_86r","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0388","start":388,"end":390,"surface":"太后","kind":"person","person_id":"xke_dj3_6ba_AAB","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0395","start":395,"end":397,"surface":"殷融","kind":"person","person_id":"ali_hbb_4bn","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0399","start":399,"end":401,"surface":"鄭玄","kind":"person","person_id":"95f_p0e_7s8","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0406","start":406,"end":407,"surface":"裒","kind":"person","person_id":"xke_dj3_6ba_AA","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0415","start":415,"end":417,"surface":"太后","kind":"person","person_id":"xke_dj3_6ba_AAB","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0428","start":428,"end":430,"surface":"太后","kind":"person","person_id":"xke_dj3_6ba_AAB","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0462","start":462,"end":463,"surface":"翼","kind":"person","person_id":"4qr_wrk_3vd_F","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0467","start":467,"end":468,"surface":"尚","kind":"person","person_id":"4ij_7ik_fgy_A","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0485","start":485,"end":487,"surface":"鄭玄","kind":"person","person_id":"95f_p0e_7s8","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0495","start":495,"end":497,"surface":"太后","kind":"person","person_id":"xke_dj3_6ba_AAB","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0506","start":506,"end":507,"surface":"裒","kind":"person","person_id":"xke_dj3_6ba_AA","status":"contextual_provisional"}],"source_position":{"first_line":42,"last_line":42,"revision_id":1543614,"editorial_excerpt_boundary":false},"chapter_id":"c-jinshu-032-chu-suanzi","book_id":"b-jinshu-032","work_id":"w-jinshu","source_id":"s-jinshu-032-chu-suanzi"}],"sources":[{"chapter_id":"c-jinshu-032-chu-suanzi","work_id":"w-jinshu","book_id":"b-jinshu-032","source_id":"s-jinshu-032-chu-suanzi","source":{"title":"《晉書》卷32（康獻褚皇后傳）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?oldid=1543614","permalink":"https://zh.wikisource.org/w/index.php?oldid=1543614","revision_id":1543614,"accessed_on":"2026-10-19","extent":"康獻褚皇后完整六原段及數位注語；非全卷。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，底本影像未核","response_sha256":"662028853af3848a3f71cc750fcc290b8e5af62354baecdb3158bcb95f511f0a","wikitext_sha256":"82cd88cad08dac2b1bbb57371dc460a43806730b4da42c143f041374bd6866c5","normalization":{"character_conversion":{},"extraction_note":"展開年號模板，移除段首縮排，數位校勘注另存；未改原字。","excerpts":[{"proposed_paragraph_id":"c-jinshu-032-chu-suanzi:line040","source_lines":[40,40],"raw_quote":"　　康獻褚皇后諱蒜子，河南陽翟人也。父裒，見《外戚傳》。后聰明有器識，少以名家入為琅邪王妃。及康帝即位，立為皇后，封母謝氏為尋陽鄉君。","raw_quote_sha256":"1643944692230e47c515871e414fc4c5b4df92c171958f59c6263a0c0b3edc68","selected_text_sha256":"f9361bbecb2e2632233b10c7cf70f71674ef6882d699cf8ad7b649ad7cc4b82a","begin_anchor":"康獻褚皇后諱蒜子，河南陽翟人也。父裒","end_anchor":"即位，立為皇后，封母謝氏為尋陽鄉君。"},{"proposed_paragraph_id":"c-jinshu-032-chu-suanzi:line042","source_lines":[42,42],"raw_quote":"　　及穆帝即位，尊后曰皇太后。時帝幼沖，未親國政。領司徒蔡謨等上奏曰：「嗣皇誕哲岐嶷，繼承天統，率土宅心，兆庶蒙賴。陛下體茲坤道，訓隆文母。昔塗山光夏，簡狄熙殷，實由宣哲，以隆休祚。伏惟陛下德侔二媯，淑美關雎，臨朝攝政，以寧天下。今社稷危急，兆庶懸命，臣等章惶，一日萬機，事運之期，天祿所鍾，非復沖虛高讓之日。漢和熹、順烈，並亦臨朝，近明穆故事，以為先制。臣等不勝悲怖，謹伏地上請。乞陛下上順祖宗，下念臣吏，推公弘道，以協天人，則萬邦承慶，群黎更生。」太后詔曰：「帝幼沖，當賴群公卿士將順匡救，以酬先帝禮賢之意，且是舊德世濟之美，則莫重之命不墜，祖宗之基有奉，是其所以欲正位于內而已。所奏懇到，形于翰墨，執省未究，以悲以懼。先后允恭謙抑，思順坤道，所以不距群情，固為國計。豈敢執守沖闇，以違先旨。輒敬從所奏。」於是臨朝稱制。有司奏，謝夫人既封，荀、卞二夫人亦應追贈，皆后之前母也。太后不許。太常殷融議依鄭玄義，衛將軍裒在宮庭則盡臣敬，太后歸寧之日自如家人之禮。太后詔曰：「典禮誠所未詳，如所奏，是情所不能安也，更詳之。」征西將軍翼、南中郎尚議謂「父尊盡於一家，君敬重於天下，鄭玄義合情禮之中」。太后從之。自後朝臣皆敬裒焉。","raw_quote_sha256":"9e4d1aac1a45f30e3910ced3b14742002cfe59b142cf8c6933ca5fe968ea813a","selected_text_sha256":"485657cefa9fb705992094a25a7bb6329583541b27fe461b57466349bd622c9b","begin_anchor":"及穆帝即位，尊后曰皇太后。時帝幼沖，","end_anchor":"之中」。太后從之。自後朝臣皆敬裒焉。"},{"proposed_paragraph_id":"c-jinshu-032-chu-suanzi:line044","source_lines":[44,44],"raw_quote":"　　帝既冠，太后詔曰：「昔遭不造，帝在幼沖，皇緒之微，眇若贅旒。百辟卿士率遵前朝，勸喻攝政。以社稷之重，先代成義，僶俛敬從，弗遑固守。仰憑七廟之靈，俯仗群后之力，帝加元服，禮成德備，當陽親覽，臨御萬國。今歸事反政，一依舊典。」于是居崇德宮，手詔群公曰：「昔以皇帝幼沖，從群后之議，既以闇弱，又頻丁極艱，銜恤歷祀，沈憂在疚。司徒親尊德重，訓救其弊，王室之不壞，實公是憑。帝既備茲冠禮，而四海未一，五胡叛逆，豺狼當路，費役日興，百姓困苦。願諸君子思量遠算，戮力一心，輔翼幼主，匡救不逮。未亡人永歸別宮，以終餘齒。仰惟家國，故以一言託懷。」","raw_quote_sha256":"912e1f0ab6ae7c9c049a5890a2552edb86d4e7ff732f36386678ae9619789eeb","selected_text_sha256":"56647afd488c02ef801c9ee3033f2d55443488b8824f256eee789d283b7c9e0b","begin_anchor":"帝既冠，太后詔曰：「昔遭不造，帝在幼","end_anchor":"以終餘齒。仰惟家國，故以一言託懷。」"},{"proposed_paragraph_id":"c-jinshu-032-chu-suanzi:line046","source_lines":[46,46],"raw_quote":"　　及哀帝、海西公之世，太后復臨朝稱制<ref>「及哀帝、海西公之世，太后復臨朝稱制」李校：《哀帝紀》惟興寧二年帝以服藥致疾，崇德太后復臨朝攝政，至《海西公紀》不言有臨朝事，「世」字當是「際」字之誤。</ref>。桓溫之廢海西公也，太后方在佛屋燒香，內侍啟云「外有急奏」，太后乃出。尚倚戶前視奏數行，乃曰「我本自疑此」，至半便止，索筆答奏云：「未亡人罹此百憂，感念存沒，心焉如割。」溫始呈詔草，慮太后意異，悚動流汗，見于顏色。及詔出，溫大喜。","raw_quote_sha256":"74b73571300986be993a6f8e81b6447966e687b38a0c27e64cb2b544d77abbb5","selected_text_sha256":"f18963deb7b2fd3dadd18576a0665105a8cbee577b3c3691d6ca0616eff37e02","begin_anchor":"及哀帝、海西公之世，太后復臨朝稱制。","end_anchor":"悚動流汗，見于顏色。及詔出，溫大喜。","removed_digital_editorial_notes":[{"text":"「及哀帝、海西公之世，太后復臨朝稱制」李校：《哀帝紀》惟興寧二年帝以服藥致疾，崇德太后復臨朝攝政，至《海西公紀》不言有臨朝事，「世」字當是「際」字之誤。","text_layer":"modern_digital_apparatus","independently_verified":false}]},{"proposed_paragraph_id":"c-jinshu-032-chu-suanzi:line048","source_lines":[48,48],"raw_quote":"　　簡文帝即位，尊后為崇德太后。及帝崩，孝武帝幼沖，桓溫又薨。群臣啟曰：「王室多故，禍艱仍臻，國憂始周，復喪元輔，天下惘然，若無攸濟。主上雖聖資奇茂，固天誕縱。而春秋尚富，如在諒闇，蒸蒸之思，未遑庶事。伏惟陛下德應坤厚，宣慈聖善，遭家多艱，臨朝親覽。光大之美，化洽在昔，謳歌流詠，播溢無外。雖有莘熙殷，妊姒隆周，未足以喻。是以五謀克從，人鬼同心，仰望來蘇，懸心日月。夫隨時之義，周易所尚，寧固社稷，大人之任。伏願陛下撫綜萬機，釐和政道，以慰祖宗，以安兆庶。不勝憂國喁喁至誠。」太后詔曰：「王室不幸，仍有艱屯。覽省啟事，感增悲歎。內外諸君，並以主上春秋沖富，加蒸蒸之慕，未能親覽，號令宜有所由。苟可安社稷，利天下，亦豈有所執，輒敬從所啟。但闇昧之闕，望盡弼諧之道。」於是太后復臨朝。帝既冠，乃詔曰：「皇帝婚冠禮備，遐邇宅心，宜當陽親覽，緝熙惟始。今歸政事，率由舊典。」於是復稱崇德太后。","raw_quote_sha256":"5402b89f67bc88082f293691f05f62eb74261f1e59903d5ce1d86200cecf0159","selected_text_sha256":"b4d1d85d4376c564609b7062e2c943ae3c297df0d7c61a628382c89e2d2a59bf","begin_anchor":"簡文帝即位，尊后為崇德太后。及帝崩，","end_anchor":"政事，率由舊典。」於是復稱崇德太后。"},{"proposed_paragraph_id":"c-jinshu-032-chu-suanzi:line050","source_lines":[50,50],"raw_quote":"　　{{YL|太元九年}}，崩于顯陽殿，年六十一，在位凡四十年。太后於帝為從嫂，朝議疑其服。太學博士徐藻議曰：「資父事君而敬同。又禮云『其夫屬父道者，妻皆母道也』，則夫屬君道，妻亦后道矣。服后以齊，母之義也。魯譏逆祀，以明尊卑<ref>「以明尊卑」：《禮志·中》、《宋志·二》、《[[通典]]·八〇》、《[[文獻通考|通考]]·一二一》「尊卑」皆作「尊尊」，乃用穀梁傳文公二年「君子不以親親害尊尊」之義。徐藻、徐邈父子治穀梁，此作「尊尊」為是。</ref>。今上躬奉康、穆、哀皇及靖后之祀，致敬同于所天，豈可敬之以君道，而服廢於本親。謂應齊衰期。」從之。","raw_quote_sha256":"3e0b257e63ac1ac257bc338324fe266b5ad784b54150b2d0c348a2bac4b20c48","selected_text_sha256":"026ff8771f56b4edfe187d2fe1e96b105fcc69e92ef2fd1f92120a6ed7210ed9","begin_anchor":"太元九年，崩于顯陽殿，年六十一，在位","end_anchor":"，而服廢於本親。謂應齊衰期。」從之。","removed_digital_editorial_notes":[{"text":"「以明尊卑」：《禮志·中》、《宋志·二》、《[[通典]]·八〇》、《[[文獻通考|通考]]·一二一》「尊卑」皆作「尊尊」，乃用穀梁傳文公二年「君子不以親親害尊尊」之義。徐藻、徐邈父子治穀梁，此作「尊尊」為是。","text_layer":"modern_digital_apparatus","independently_verified":false}]}]}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true}}
