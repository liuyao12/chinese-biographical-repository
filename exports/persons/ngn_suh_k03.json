sional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-083-luzou:m013-0238","start":238,"end":240,"surface":"魯君","kind":"person","person_id":"ngn_suh_k03","status":"contextual_provisional","paragraph_id":"c-shiji-083-luzou:p013","chapter_id":"c-shiji-083-luzou"},{"id":"c-shiji-086-cike:m001-0012","start":12,"end":15,"surface":"魯莊公","kind":"person","person_id":"ngn_suh_k03","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p001","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m001-0016","start":16,"end":18,"surface":"莊公","kind":"person","person_id":"ngn_suh_k03","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p001","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m001-0035","start":35,"end":38,"surface":"魯莊公","kind":"person","person_id":"ngn_suh_k03","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p001","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m002-0015","start":15,"end":17,"surface":"莊公","kind":"person","person_id":"ngn_suh_k03","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p002","chapter_id":"c-shiji-086-cike"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji083-032","person_id":"ngn_suh_k03","scope":"same_chapter","chapter_ids":["c-shiji-083-luzou"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"依本段明示稱名與嵌套引古範圍暫定；未名者不以他篇或記憶直接補名。","surfaces":["魯君"],"evidence":[{"paragraph_id":"c-shiji-083-luzou:p013","quote":"且吾聞之，規小睗者不能成榮名，惡小恥者不能立大功。昔者管夷吾射桓公中其鉤，篡也；遺公子糾不能死，怯也；束縛桎梏，辱也。若此三行者，世主不臣而鄉里不通。鄉使管子幽囚而不出，身死而不反於齊，則亦名不免為辱人賤行矣。臧獲且羞與之同名矣，況世俗乎！故管子不恥身在縲紲之中而恥天下之不治，不恥不死公子糾而恥威之不信於諸侯，故兼三行之過而為五霸首，名高天下而光燭鄰國。曹子為魯將，三戰三北，而亡地五百里。鄉使曹子計不反顧，議不還踵，刎頸而死，則亦名不免為敗軍禽將矣。曹子棄三北之恥，而退與魯君計。桓公朝天下，會諸侯，曹子以一劍之任，枝桓公之心於壇坫之上，顏色不變，辭氣不悖，三戰之所亡一朝而復之，天下震動，諸侯驚駭，威加吳、越。若此二士者，非不能成小廉而行小睗也，以為殺身亡軀，絕世滅後，功名不立，非智也。故去感忿之怨，立終身之名；棄忿悁之節，定累世之功。是以業與三王爭流，而名與天壤相獘也。願公擇一而行之。"}]},{"id":"d-shiji086-002","person_id":"ngn_suh_k03","surfaces":["莊公","魯莊公"],"scope":"same_chapter","chapter_ids":["c-shiji-086-cike"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-086-cike:p001","quote":"曹沫者，魯人也，以勇力事魯莊公。莊公好力。曹沫爲魯將，與齊戰，三敗北。魯莊公懼，乃獻遂邑之地以和。猶復以爲將。"},{"paragraph_id":"c-shiji-086-cike:p002","quote":"齊桓公許與魯會于柯而盟。桓公與莊公既盟於壇上，曹沫執匕首劫齊桓公，桓公左右莫敢動，而問曰：「子將何欲？」曹沫曰：「齊彊魯弱，而大國侵魯亦甚矣。今魯城壞即壓齊境，君其圖之。」桓公乃許盡歸魯之侵地。既已言，曹沫投其匕首，下壇，北面就群臣之位，顏色不變，辭令如故。桓公怒，欲倍其約。管仲曰：「不可。夫貪小利以自快，棄信於諸侯，失天下之援，不如與之。」於是桓公乃遂割魯侵地，曹沫三戰所亡地盡復予魯。"}],"rationale":"依曹沫盟柯與專諸引介、公子光及吳王兄弟王序語境暫接；伍子胥伍員明示同段承接，原字呉眛爲保留，王稱與嵌套指代待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji083-luzhuang","person_ids":["ngn_suh_k03"],"canonical_person_id":"ngn_suh_k03","scope":"cross_chapter","chapter_ids":["c-shiji-083-luzou","c-shiji-086-cike"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-083-luzou","source_id":"s-shiji-083-luzou","paragraph_id":"c-shiji-083-luzou:p013","quote":"且吾聞之，規小睗者不能成榮名，惡小恥者不能立大功。昔者管夷吾射桓公中其鉤，篡也；遺公子糾不能死，怯也；束縛桎梏，辱也。若此三行者，世主不臣而鄉里不通。鄉使管子幽囚而不出，身死而不反於齊，則亦名不免為辱人賤行矣。臧獲且羞與之同名矣，況世俗乎！故管子不恥身在縲紲之中而恥天下之不治，不恥不死公子糾而恥威之不信於諸侯，故兼三行之過而為五霸首，名高天下而光燭鄰國。曹子為魯將，三戰三北，而亡地五百里。鄉使曹子計不反顧，議不還踵，刎頸而死，則亦名不免為敗軍禽將矣。曹子棄三北之恥，而退與魯君計。桓公朝天下，會諸侯，曹子以一劍之任，枝桓公之心於壇坫之上，顏色不變，辭氣不悖，三戰之所亡一朝而復之，天下震動，諸侯驚駭，威加吳、越。若此二士者，非不能成小廉而行小睗也，以為殺身亡軀，絕世滅後，功名不立，非智也。故去感忿之怨，立終身之名；棄忿悁之節，定累世之功。是以業與三王爭流，而名與天壤相獘也。願公擇一而行之。","mention_ids":["c-shiji-083-luzou:m013-0238"]},{"chapter_id":"c-shiji-086-cike","source_id":"s-shiji-086-cike","paragraph_id":"c-shiji-086-cike:p001","quote":"曹沫者，魯人也，以勇力事魯莊公。莊公好力。曹沫爲魯將，與齊戰，三敗北。魯莊公懼，乃獻遂邑之地以和。猶復以爲將。","mention_ids":["c-shiji-086-cike:m001-0012","c-shiji-086-cike:m001-0016","c-shiji-086-cike:m001-0035"]},{"chapter_id":"c-shiji-086-cike","source_id":"s-shiji-086-cike","paragraph_id":"c-shiji-086-cike:p002","quote":"齊桓公許與魯會于柯而盟。桓公與莊公既盟於壇上，曹沫執匕首劫齊桓公，桓公左右莫敢動，而問曰：「子將何欲？」曹沫曰：「齊彊魯弱，而大國侵魯亦甚矣。今魯城壞即壓齊境，君其圖之。」桓公乃許盡歸魯之侵地。既已言，曹沫投其匕首，下壇，北面就群臣之位，顏色不變，辭令如故。桓公怒，欲倍其約。管仲曰：「不可。夫貪小利以自快，棄信於諸侯，失天下之援，不如與之。」於是桓公乃遂割魯侵地，曹沫三戰所亡地盡復予魯。","mention_ids":["c-shiji-086-cike:m002-0015"]}],"rationale":"083曹子三敗、與魯君計、壇上劫桓公復地，與086曹沫事魯莊公三敗後柯盟劫齊桓復侵地事件相配，具名臣下與特定盟會支持魯君暫指魯莊公。曹子與曹沫已用同一ID，不另造重複接合；不因此等同曹劌，亦不調和失地五百里與遂邑原語。同書不作獨立見證。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true}],"passages":[{"id":"c-shiji-083-luzou:p013","text":"且吾聞之，規小睗者不能成榮名，惡小恥者不能立大功。昔者管夷吾射桓公中其鉤，篡也；遺公子糾不能死，怯也；束縛桎梏，辱也。若此三行者，世主不臣而鄉里不通。鄉使管子幽囚而不出，身死而不反於齊，則亦名不免為辱人賤行矣。臧獲且羞與之同名矣，況世俗乎！故管子不恥身在縲紲之中而恥天下之不治，不恥不死公子糾而恥威之不信於諸侯，故兼三行之過而為五霸首，名高天下而光燭鄰國。曹子為魯將，三戰三北，而亡地五百里。鄉使曹子計不反顧，議不還踵，刎頸而死，則亦名不免為敗軍禽將矣。曹子棄三北之恥，而退與魯君計。桓公朝天下，會諸侯，曹子以一劍之任，枝桓公之心於壇坫之上，顏色不變，辭氣不悖，三戰之所亡一朝而復之，天下震動，諸侯驚駭，威加吳、越。若此二士者，非不能成小廉而行小睗也，以為殺身亡軀，絕世滅後，功名不立，非智也。故去感忿之怨，立終身之名；棄忿悁之節，定累世之功。是以業與三王爭流，而名與天壤相獘也。願公擇一而行之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-083-luzou:m013-0027","start":27,"end":30,"surface":"管夷吾","kind":"person","person_id":"gg7_gm5_159","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m013-0031","start":31,"end":33,"surface":"桓公","kind":"person","person_id":"ica_cts_5j1","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m013-0041","start":41,"end":44,"surface":"公子糾","kind":"person","person_id":"qv2_833_5sf","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m013-0077","start":77,"end":79,"surface":"管子","kind":"person","person_id":"gg7_gm5_159","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m013-0105","start":105,"end":107,"surface":"臧獲","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、譬喻或未定指代；不依記憶補姓名與親屬。"},{"id":"c-shiji-083-luzou:m013-0121","start":121,"end":123,"surface":"管子","kind":"person","person_id":"gg7_gm5_159","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m013-0143","start":143,"end":146,"surface":"公子糾","kind":"person","person_id":"qv2_833_5sf","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m013-0178","start":178,"end":180,"surface":"曹子","kind":"person","person_id":"e69_9n6_wvq","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m013-0198","start":198,"end":200,"surface":"曹子","kind":"person","person_id":"e69_9n6_wvq","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m013-0227","start":227,"end":229,"surface":"曹子","kind":"person","person_id":"e69_9n6_wvq","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m013-0238","start":238,"end":240,"surface":"魯君","kind":"person","person_id":"ngn_suh_k03","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m013-0242","start":242,"end":244,"surface":"桓公","kind":"person","person_id":"ica_cts_5j1","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m013-0252","start":252,"end":254,"surface":"曹子","kind":"person","person_id":"e69_9n6_wvq","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m013-0261","start":261,"end":263,"surface":"桓公","kind":"person","person_id":"ica_cts_5j1","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m013-0376","start":376,"end":378,"surface":"三王","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、譬喻或未定指代；不依記憶補姓名與親屬。"},{"id":"c-shiji-083-luzou:m013-0391","start":391,"end":392,"surface":"公","kind":"person","person_id":"6i8_efe_yzr","status":"contextual_provisional"}],"chapter_id":"c-shiji-083-luzou","book_id":"b-shiji-083","work_id":"w-shiji","source_id":"s-shiji-083-luzou"},{"id":"c-shiji-086-cike:p001","text":"曹沫者，魯人也，以勇力事魯莊公。莊公好力。曹沫爲魯將，與齊戰，三敗北。魯莊公懼，乃獻遂邑之地以和。猶復以爲將。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-086-cike:m001-0000","start":0,"end":2,"surface":"曹沫","kind":"person","person_id":"e69_9n6_wvq","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m001-0012","start":12,"end":15,"surface":"魯莊公","kind":"person","person_id":"ngn_suh_k03","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m001-0016","start":16,"end":18,"surface":"莊公","kind":"person","person_id":"ngn_suh_k03","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m001-0021","start":21,"end":23,"surface":"曹沫","kind":"person","person_id":"e69_9n6_wvq","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m001-0035","start":35,"end":38,"surface":"魯莊公","kind":"person","person_id":"ngn_suh_k03","status":"contextual_provisional"}],"chapter_id":"c-shiji-086-cike","book_id":"b-shiji-086","work_id":"w-shiji","source_id":"s-shiji-086-cike"},{"id":"c-shiji-086-cike:p002","text":"齊桓公許與魯會于柯而盟。桓公與莊公既盟於壇上，曹沫執匕首劫齊桓公，桓公左右莫敢動，而問曰：「子將何欲？」曹沫曰：「齊彊魯弱，而大國侵魯亦甚矣。今魯城壞即壓齊境，君其圖之。」桓公乃許盡歸魯之侵地。既已言，曹沫投其匕首，下壇，北面就群臣之位，顏色不變，辭令如故。桓公怒，欲倍其約。管仲曰：「不可。夫貪小利以自快，棄信於諸侯，失天下之援，不如與之。」於是桓公乃遂割魯侵地，曹沫三戰所亡地盡復予魯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-086-cike:m002-0000","start":0,"end":3,"surface":"齊桓公","kind":"person","person_id":"kfg_ijy_wik","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m002-0012","start":12,"end":14,"surface":"桓公","kind":"person","person_id":"kfg_ijy_wik","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m002-0015","start":15,"end":17,"surface":"莊公","kind":"person","person_id":"ngn_suh_k03","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m002-0023","start":23,"end":25,"surface":"曹沫","kind":"person","person_id":"e69_9n6_wvq","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m002-0029","start":29,"end":32,"surface":"齊桓公","kind":"person","person_id":"kfg_ijy_wik","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m002-0033","start":33,"end":35,"surface":"桓公","kind":"person","person_id":"kfg_ijy_wik","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m002-0035","start":35,"end":3