56-attendants-complete-ws1504717"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-nanqishu-056-attendants-complete:variant_review4-273","kind":"variant_review","person_id":"th1_ei7_k3y","source_quote":"有楊袓之謀","reading":"袓從衣，尋而祖之事覺從示。殿本與南史作祖。","note":"袓從衣，尋而祖之事覺從示。殿本與南史作祖。","paragraph_id":"c-nanqishu-056-attendants-complete:p004","start_codepoint":273,"end_codepoint":278,"human_reviewed":false,"chapter_id":"c-nanqishu-056-attendants-complete","source_id":"s-nanqishu-056-attendants-complete-ws1504717"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-056-attendants-complete:p004:m0274","start":274,"end":277,"surface":"楊袓之","kind":"person","person_id":"th1_ei7_k3y","status":"contextual_provisional","paragraph_id":"c-nanqishu-056-attendants-complete:p004","chapter_id":"c-nanqishu-056-attendants-complete"},{"id":"c-nanqishu-056-attendants-complete:p004:m0295","start":295,"end":297,"surface":"祖之","kind":"person","person_id":"th1_ei7_k3y","status":"contextual_provisional","paragraph_id":"c-nanqishu-056-attendants-complete:p004","chapter_id":"c-nanqishu-056-attendants-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-056-attendants-complete:p004","text":"　　太祖坐東府高樓，望石頭城，僧真在側。上曰：「諸將勸我誅袁、劉，我意不欲便爾。」及沈攸之事起，從太祖入朝堂。石頭反夜，太祖遣衆軍掩討。宮城中望石頭火光及呌聲甚盛，人懷不測。僧真謂衆曰：「呌聲不絕，是必官軍所攻。火光起者，賊不容自燒其城，此必官軍勝也。」尋而啓石頭平。上出頓新亭，使僧真領千人在帳內。初，上在領軍府，令僧真學上手迹下名，至是報荅書疏，皆付僧真，上觀之，笑曰：「我亦不復能別也。」初，上在淮陰治城，得一錫趺，大數尺，下有篆文，莫能識者。僧真曰：「何須辨此文字，此自久遠之物，九錫之徵也。」太祖曰：「卿勿妄言。」及上將拜齊公，已剋日，有楊袓之謀於臨軒作難。僧真更請上選吉辰，尋而祖之事覺。上曰：「無卿言，亦當致小狼狽，此亦何異呼遝之冰。」轉齊國中書舍人。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":24,"last_line":24,"raw_start":1244,"raw_end":1577,"raw_character_offsets":[1244,1245,1246,1247,1248,1249,1250,1251,1252,1253,1254,1255,1256,1257,1258,1259,1260,1261,1262,1263,1264,1265,1266,1267,1268,1269,1270,1271,1272,1273,1274,1275,1276,1277,1278,1279,1280,1281,1282,1283,1284,1285,1286,1287,1288,1289,1290,1291,1292,1293,1294,1295,1296,1297,1298,1299,1300,1301,1302,1303,1304,1305,1306,1307,1308,1309,1310,1311,1312,1313,1314,1315,1316,1317,1318,1319,1320,1321,1322,1323,1324,1325,1326,1327,1328,1329,1330,1331,1332,1333,1334,1335,1336,1337,1338,1339,1340,1341,1342,1343,1344,1345,1346,1347,1348,1349,1350,1351,1352,1353,1354,1355,1356,1357,1358,1359,1360,1361,1362,1363,1364,1365,1366,1367,1368,1369,1370,1371,1372,1373,1374,1375,1376,1377,1378,1379,1380,1381,1382,1383,1384,1385,1386,1387,1388,1389,1390,1391,1392,1393,1394,1395,1396,1397,1398,1399,1400,1401,1402,1403,1404,1405,1406,1407,1408,1409,1410,1411,1412,1413,1414,1415,1416,1417,1418,1419,1420,1421,1422,1423,1424,1425,1426,1427,1428,1429,1430,1431,1432,1433,1434,1435,1436,1437,1438,1439,1440,1441,1442,1443,1444,1445,1446,1447,1448,1449,1450,1451,1452,1453,1454,1455,1456,1457,1458,1459,1460,1461,1462,1463,1464,1465,1466,1467,1468,1469,1470,1471,1472,1473,1474,1475,1476,1477,1478,1479,1480,1481,1482,1483,1484,1485,1486,1487,1488,1489,1490,1491,1492,1493,1494,1495,1496,1497,1498,1499,1500,1501,1502,1503,1504,1505,1506,1507,1508,1509,1510,1511,1512,1513,1514,1515,1516,1517,1518,1519,1520,1521,1522,1523,1524,1525,1526,1527,1528,1529,1530,1531,1532,1533,1534,1535,1536,1537,1538,1539,1540,1541,1542,1543,1544,1545,1546,15