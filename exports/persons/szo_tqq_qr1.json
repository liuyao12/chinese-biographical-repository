c-shiji-111-wei-huo:m011-0135","start":135,"end":137,"surface":"休屠","kind":"person","person_id":"szo_tqq_qr1","status":"contextual_provisional"},{"id":"c-shiji-111-wei-huo:m011-0144","start":144,"end":146,"surface":"去病","kind":"person","person_id":"3tw_nq2_gyn","status":"contextual_provisional"}],"chapter_id":"c-shiji-111-wei-huo","book_id":"b-shiji-111","work_id":"w-shiji","source_id":"s-shiji111-wei-huo"},{"id":"c-shiji-111-wei-huo:p013","text":"其秋，單于怒渾邪王居西方數為漢所破，亡數萬人，以驃騎之兵也。單于怒，欲召誅渾邪王。渾邪王與休屠王等謀欲降漢，使人先要邊。是時大行李息將城河上，得渾邪王使，即馳傳以聞。天子聞之，於是恐其以詐降而襲邊，乃令驃騎將軍將兵往迎之。驃騎既渡河，與渾邪王眾相望。渾邪王裨將見漢軍而多欲不降者，頗遁去。驃騎乃馳入與渾邪王相見，斬其欲亡者八千人，遂獨遣渾邪王乘傳先詣行在所，盡將其眾渡河，降者數萬，號稱十萬。既至長安，天子所以賞賜者數十巨萬。封渾邪王萬戶，為漯陰侯。封其裨王呼毒尼為下摩侯，鷹庇為煇渠侯，禽為河綦侯，大當戶銅離為常樂侯。於是天子嘉驃騎之功曰：「驃騎將軍去病率師攻匈奴西域王渾邪，王及厥眾萌咸相奔，率以軍糧接食，并將控弦萬有餘人，誅獟駻，獲首虜八千餘級，降異國之王三十二人，戰士不離傷，十萬之眾咸懷集服，仍與之勞，爰及河塞，庶幾無患，幸既永綏矣。以千七百戶益封驃騎將軍。」減隴西、北地、上郡戍卒之半，以寬天下之繇。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-111-wei-huo:m013-0003","start":3,"end":5,"surface":"單于","kind":"person","person_id":"wjt_htu_081_AAB","status":"contextual_provisional"},{"id":"c-shiji-111-wei-huo:m013-0006","start":6,"end":9,"surface":"渾邪王","kind":"person","person_id":"164_wmw_9ck","status":"contextual_provisional"},{"id":"c-shiji-111-wei-huo:m013-0024","start":24,"end":26,"surface":"驃騎","kind":"person","person_id":"3tw_nq2_gyn","status":"contextual_provisional"},{"id":"c-shiji-111-wei-huo:m013-0030","start":30,"end":32,"surface":"單于","kind":"person","person_id":"wjt_htu_081_AAB","status":"contextual_provisional"},{"id":"c-shiji-111-wei-huo:m013-0037","start":37,"end":40,"surface":"渾邪王","kind":"person","person_id":"164_wmw_9ck","status":"contextual_provisional"},{"id":"c-shiji-111-wei-huo:m013-0041","start":41,"end":44,"surface":"渾邪王","kind":"person","person_id":"164_wmw_9ck","status":"contextual_provisional"},{"id":"c-shiji-111-wei-huo:m013-0045","start":45,"end":48,"surface":"休屠王","kind":"person","person_id":"szo_tqq_qr1","status":"contextual_provisional"},{"id