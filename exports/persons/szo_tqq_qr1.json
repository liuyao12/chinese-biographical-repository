rial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-shiji110-xiutu","person_id":"szo_tqq_qr1","event_type":"death","status":"source_attested","date_expression":"其秋","normalized_date":{"era":"BCE","era_year":121,"year":-120,"year_numbering":"astronomical","precision":"year","status":"editorial_provisional","original_quote":"其秋，單于怒渾邪王、休屠王居西方爲漢所殺虜數萬人，欲召誅之。渾邪王與休屠王恐，謀降漢，漢使驃騎將軍往迎之。渾邪王殺休屠王，并將其眾降漢。凡四萬餘人，號十萬。於是漢已得渾邪王，則隴西、北地、河西益少胡寇，徙關東貧民處所奪匈奴河南、新秦中以實之，而減北地以西戍卒半。其明年，匈奴入右北平、定襄各數萬騎，殺略千餘人而去。","evidence":[{"chapter_id":"c-shiji-110-xiongnu","source_id":"s-shiji110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p037","quote":"其秋，單于怒渾邪王、休屠王居西方爲漢所殺虜數萬人，欲召誅之。渾邪王與休屠王恐，謀降漢，漢使驃騎將軍往迎之。渾邪王殺休屠王，并將其眾降漢。凡四萬餘人，號十萬。於是漢已得渾邪王，則隴西、北地、河西益少胡寇，徙關東貧民處所奪匈奴河南、新秦中以實之，而減北地以西戍卒半。其明年，匈奴入右北平、定襄各數萬騎，殺略千餘人而去。","person_mention_id":"c-shiji-110-xiongnu:m037-0057"}],"references":[{"title":"《資治通鑑》卷十九渾邪王降漢記事","url":"https://zh.wikisource.org/w/index.php?title=資治通鑑/卷019&oldid=1511466","quote":"休屠王後悔，渾邪王殺之，并其眾","scope":"received_parallel_event","image_verified":false},{"title":"《資治通鑑》數位編輯紀年標題","url":"https://zh.wikisource.org/w/index.php?title=資治通鑑/卷019&oldid=1511466","quote":"元狩二年（庚申，公元前一二一年）","scope":"digital_editorial_regnal_year_equivalence_only","image_verified":false}],"rationale":"其秋承前段河西軍役前121年，與通鑑元狩二年秋渾邪王降、殺休屠王同事件對讀，暫記前121年、天文年-120；不將段末其明年右北平定襄入寇的前120年倒套兩王事件，不補月日。","reviewer":"Codex（AI 代理）","human_reviewed":false},"evidence":[{"chapter_id":"c-shiji-110-xiongnu","source_id":"s-shiji110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p037","quote":"其秋，單于怒渾邪王、休屠王居西方爲漢所殺虜數萬人，欲召誅之。渾邪王與休屠王恐，謀降漢，漢使驃騎將軍往迎之。渾邪王殺休屠王，并將其眾降漢。凡四萬餘人，號十萬。於是漢已得渾邪王，則隴西、北地、河西益少胡寇，徙關東貧民處所奪匈奴河南、新秦中以實之，而減北地以西戍卒半。其明年，匈奴入右北平、定襄各數萬騎，殺略千餘人而去。","person_mention_id":"c-shiji-110-xiongnu:m037-0057"}],"interpretation_note":"渾邪王殺休屠王明示死亡，記前121年；單于先欲召誅之僅意圖，不作單于已殺兩王。居西方為活動地域，不補籍貫、卒地、葬地或親屬；死亡不自動終止全部官爵。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"mentions":[{"id":"c-shiji-110-xiongnu:m036-0047","start":47,"end":50,"surface":"休屠王","kind":"person","person_id":"szo_tqq_qr1","status":"contextual_provisional","paragraph_id":"c-shiji-110-xiongnu:p036","chapter_id":"c-shiji-110-xiongnu"},{"id":"c-shiji-110-xiongnu:m037-0010","start":10,"end":13,"surface":"休屠王","kind":"person","person_id":"szo_tqq_qr1","status":"contextual_provisional","paragraph_id":"c-shiji-110-xiongnu:p037","chapter_id":"c-shiji-110-xiongnu"},{"id":"c-shiji-110-xiongnu:m037-0034","start":34,"end":37,"surface":"休屠王","kind":"person","person_id":"szo_tqq_qr1","status":"contextual_provisional","paragraph_id":"c-shiji-110-xiongnu:p037","chapter_id":"c-shiji-110-xiongnu"},{"id":"c-shiji-110-xiongnu:m037-0057","start":57,"end":60,"surface":"休屠王","kind":"person","person_id":"szo_tqq_qr1","status":"contextual_provisional","paragraph_id":"c-shiji-110-xiongnu:p037","chapter_id":"c-shiji-110-xiongnu"},{"id":"c-shiji-111-wei-huo:m011-0135","start":135,"end":137,"surface":"休屠","kind":"person","person_id":"szo_tqq_qr1","status":"contextual_provisional","paragraph_id":"c-shiji-111-wei-huo:p011","chapter_id":"c-shiji-111-wei-huo"},{"id":"c-shiji-111-wei-huo:m013-0045","start":45,"end":48,"surface":"休屠王","kind":"person","person_id":"szo_tqq_qr1","status":"contextual_provisional","paragraph_id":"c-shiji-111-wei-huo:p013","chapter_id":"c-shiji-111-wei-huo"}],"relations":[],"title_holdings":[{"id":"th-shiji110-103","person_id":"szo_tqq_qr1","title":"休屠王","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-110-xiongnu","source_id":"s-shiji110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p036","quote":"其明年春，漢使驃騎將軍去病將萬騎出隴西，過焉支山千餘里，擊匈奴，得胡首虜（騎）萬八千餘級，破得休屠王祭天金人。其夏，驃騎將軍復與合騎侯數萬騎出隴西、北地二千里，擊匈奴。過居延，攻祁連山，得胡首虜三萬餘人，裨小王以下七十餘人。是時匈奴亦來入代郡、鴈門，殺略數百人。漢使博望侯及李將軍廣出右北平，擊匈奴左賢王。左賢王圍李將軍，卒可四千人，且盡，殺虜亦過當。會博望侯軍救至，李將軍得脫。漢失亡數千人，合騎侯後驃騎將軍期，及與博望侯皆當死，贖爲庶人。"},{"chapter_id":"c-shiji-110-xiongnu","source_id":"s-shiji110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p037","quote":"其秋，單于怒渾邪王、休屠王居西方爲漢所殺虜數萬人，欲召誅之。渾邪王與休屠王恐，謀降漢，漢使驃騎將軍往迎之。渾邪王殺休屠王，并將其眾降漢。凡四萬餘人，號十萬。於是漢已得渾邪王，則隴西、北地、河西益少胡寇，徙關東貧民處所奪匈奴河南、新秦中以實之，而減北地以西戍卒半。其明年，匈奴入右北平、定襄各數萬騎，殺略千餘人而去。"}],"attestations":[{"id":"th-shiji110-103:a001","paragraph_id":"c-shiji-110-xiongnu:p036","start":47,"end":50,"surface":"休屠王","person_mention_id":"c-shiji-110-xiongnu:m036-0047","usage":"narrative","date_expression":"其明年春","normalized_date":{"era":"BCE","era_year":121,"year":-120,"year_numbering":"astronomical","precision":"year","status":"editorial_provisional","original_quote":"其明年春，漢使驃騎將軍去病將萬騎出隴西，過焉支山千餘里，擊匈奴，得胡首虜（騎）萬八千餘級，破得休屠王祭天金人。其夏，驃騎將軍復與合騎侯數萬騎出隴西、北地二千里，擊匈奴。過居延，攻祁連山，得胡首虜三萬餘人，裨小王以下七十餘人。是時匈奴亦來入代郡、鴈門，殺略數百人。漢使博望侯及李將軍廣出右北平，擊匈奴左賢王。左賢王圍李將軍，卒可四千人，且盡，殺虜亦過當。會博望侯軍救至，李將軍得脫。漢失亡數千人，合騎侯後驃騎將軍期，及與博望侯皆當死，贖爲庶人。","evidence":[{"chapter_id":"c-shiji-110-xiongnu","source_id":"s-shiji110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p036","quote":"其明年春，漢使驃騎將軍去病將萬騎出隴西，過焉支山千餘里，擊匈奴，得胡首虜（騎）萬八千餘級，破得休屠王祭天金人。其夏，驃騎將軍復與合騎侯數萬騎出隴西、北地二千里，擊匈奴。過居延，攻祁連山，得胡首虜三萬餘人，裨小王以下七十餘人。是時匈奴亦來入代郡、鴈門，殺略數百人。漢使博望侯及李將軍廣出右北平，擊匈奴左賢王。左賢王圍李將軍，卒可四千人，且盡，殺虜亦過當。會博望侯軍救至，李將軍得脫。漢失亡數千人，合騎侯後驃騎將軍期，及與博望侯皆當死，贖爲庶人。"}],"references":[{"title":"《資治通鑑》卷十九元狩二年平行記事","url":"https://zh.wikisource.org/w/index.php?title=資治通鑑/卷019&oldid=1511466","quote":"霍去病為驃騎將軍，將萬騎出隴西","scope":"received_parallel_event","image_verified":false},{"title":"《資治通鑑》卷十九元狩二年平行記事","url":"https://zh.wikisource.org/w/index.php?title=資治通鑑/卷019&oldid=1511466","quote":"元狩二年（庚申，公元前一二一年）","scope":"digital_editorial_regnal_year_equivalence_only","image_verified":false}],"rationale":"前段軍敗前123年之後其明年上谷為前122年，本段再其明年春為前121年；對讀通鑑元狩二年春河西、夏祁連及博望侯李廣右北平軍役。僅年尺度，不將前段開首前123年直接接成前122年，也不改本篇首虜萬八千與通鑑八千九百的數字差異。","reviewer":"Codex（AI 代理）","human_reviewed":false}},{"id":"th-shiji110-103:a002","paragraph_id":"c-shiji-110-xiongnu:p037","start":10,"end":13,"surface":"休屠王","person_mention_id":"c-shiji-110-xiongnu:m037-0010","usage":"narrative","date_expression":"其秋","normalized_date":{"era":"BCE","era_year":121,"year":-120,