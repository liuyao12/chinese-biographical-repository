年標","url":"https://zh.wikisource.org/wiki/資治通鑑/卷019","quote":"元狩二年（庚申，公元前一二一年）","scope":"digital_editorial_regnal_year_equivalence_only","image_verified":false}],"rationale":"其秋承本篇元狩二年春、其夏；暫前121年，只取年精度。鷹庇受封年另有索隱引表異說，未據之改寫本篇敘事年代。","reviewer":"Codex（AI 代理）","human_reviewed":false,"record_id":"th-shiji111-129","person_id":"szo_tqq_qr1","attestation_id":"th-shiji111-129:a001","date_role":"attestation","title":"休屠王"}],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[{"id":"eq-shiji111-szo_tqq_qr1","person_ids":["szo_tqq_qr1"],"canonical_person_id":"szo_tqq_qr1","status":"contextual_provisional","scope":"cross_chapter","chapter_ids":["c-shiji-111-wei-huo","c-shiji-110-xiongnu"],"rationale":"同次元狩二年春去病出隴西、過焉支山並收取祭天金人，休屠為同事件所屬王的省稱；不以休屠文字單獨跨時代合併，也不將王字補入本篇原文。","evidence":[{"chapter_id":"c-shiji-111-wei-huo","source_id":"s-shiji111-wei-huo","paragraph_id":"c-shiji-111-wei-huo:p011","mention_ids":["c-shiji-111-wei-huo:m011-0135"],"quote_passage_ref":"data/corpus/shiji/111.json"},{"chapter_id":"c-shiji-110-xiongnu","source_id":"s-shiji110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p036","mention_ids":["c-shiji-110-xiongnu:m036-0047"],"quote_passage_ref":"data/corpus/shiji/110.json"}],"reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true}],"sources":[{"chapter_id":"c-shiji-110-xiongnu","work_id":"w-shiji","book_id":"b-shiji-110","source_id":"s-shiji110-xiongnu","source_ref":"corpus/shiji/110.json"},{"chapter_id":"c-shiji-111-wei-huo","work_id":"w-shiji","book_id":"b-shiji-111","source_id":"s-shiji111-wei-huo","source_ref":"corpus/shiji/111.json"}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_p