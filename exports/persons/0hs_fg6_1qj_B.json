r_id":"c-shiji-094-tiandan","paragraph_id":"c-shiji-094-tiandan:p009","quote":"齊王"}],"family_path":{"connection":"father","generation_distance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-094-tiandan","source_id":"s-shiji-094-tiandan","paragraph_id":"c-shiji-094-tiandan:p008","quote":"項王聞之，大怒，乃北伐齊。齊王田榮兵敗，走平原，平原人殺榮。項王遂燒夷齊城郭，所過者盡屠之。齊人相聚畔之。榮弟橫，收齊散兵，得數萬人，反擊項羽於城陽。而漢王率諸侯敗楚，入彭城。項羽聞之，乃醳齊而歸，擊漢於彭城，因連與漢戰，相距滎陽。以故田橫復得收齊城邑，立田榮子廣為齊王，而橫相之，專國政，政無巨細皆斷於相。","source_term":"田榮子廣"}],"source_assertion_id":"a-shiji094-008","interpretation_note":"以此受傳正文的明示近親主張配置局部家族；不合併跨篇候選身份、不補闕名世代，不表示遠祖世系已核實。分支字元不是長幼排行。","reviewer":"Codex（AI 代理）","parent_person_id":"0hs_fg6_1qj"}}],"source_mention_summary":[{"source_id":"s-shiji-094-tiandan","work_id":"w-shiji","book_id":"b-shiji-094","chapter_id":"c-shiji-094-tiandan","raw_mention_count":7,"mention_ids":["c-shiji-094-tiandan:m008-0128","c-shiji-094-tiandan:m009-0014","c-shiji-094-tiandan:m009-0113","c-shiji-094-tiandan:m009-0132","c-shiji-094-tiandan:m009-0172","c-shiji-094-tiandan:m009-0193","c-shiji-094-tiandan:m009-0218"],"paragraph_ids":["c-shiji-094-tiandan:p008","c-shiji-094-tiandan:p009"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-shiji-094-tiandan:m008-0128","mention_ids":["c-shiji-094-tiandan:m008-0128"],"kind":"paragraph"},{"canonical_mention_id":"c-shiji-094-tiandan:m009-0014","mention_ids":["c-shiji-094-tiandan:m009-0014"],"kind":"paragraph"},{"canonical_mention_id":"c-shiji-094-tiandan:m009-0113","mention_ids":["c-shiji-094-tiandan:m009-0113"],"kind":"paragraph"},{"canonical_mention_id":"c-shiji-094-tiandan:m009-0132","mention_ids":["c-shiji-094-tiandan:m009-0132"],"kind":"paragraph"},{"canonical_mention_id":"c-shiji-094-tiandan:m009-0172","mention_ids":["c-shiji-094-tiandan:m009-0172"],"kind":"paragraph"},{"canonical_mention_id":"c-shiji-094-tiandan:m009-0193","mention_ids":["c-shiji-094-tiandan:m009-0193"],"kind":"paragraph"},{"canonical_mention_id":"c-shiji-094-tian