-nanshi-022-wangjian:p005:m0245"}],"status":"source_attested","interpretation_note":"本句所稱職號；其餘追贈與生前資序分別讀取。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"th-nanshi-022-wangjian-5-248-d50_8f5_wul_AAAACA","person_id":"d50_8f5_wul_AAAACA","title":"世子詹事","kind":"office","mode":"attestation","attestations":[{"id":"th-nanshi-022-wangjian-5-248-d50_8f5_wul_AAAACA:a","paragraph_id":"c-nanshi-022-wangjian:p005","start":248,"end":252,"surface":"世子詹事","person_mention_id":"c-nanshi-022-wangjian:p005:m0245","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-022","source_id":"s-nanshi-022-wangjian-ws1477957","chapter_id":"c-nanshi-022-wangjian","paragraph_id":"c-nanshi-022-wangjian:p005","quote":"時朝儀草創，衣服制則，未有定準，儉議曰：「漢景六年，梁王入朝，中郎謁者金貂出入殿門。左思魏都賦雲'藹藹列侍，金貂齊光'，此藩國侍臣有貂之明文。晉百官表雲'太尉參軍四人，朝服武冠'，此又宰府之明文。」又疑百僚敬齊公之禮，儉又曰：「晉王受命，勸進雲，'沖等眷眷'，稱名則應盡禮。」而世子禮秩未定，儉又曰：「春秋曹世子來朝，待以上公之禮，下其君一等。今齊公九命，禮冠列蕃，世子亦宜異數。」並從之。世子鎮石頭城，仍以為世子宮，儉又曰：「魯有靈光殿，漢之前例也。聽事為崇光殿，外齋為宣德殿，以散騎常侍張緒為世子詹事，車服悉依東宮制度。」","person_mention_id":"c-nanshi-022-wangjian:p005:m0245"}],"status":"source_attested","interpretation_note":"本句所稱職號；其餘追贈與生前資序分別讀取。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-021-zhangchong-family:p001","text":"張充字延符，吳郡人。父緒，齊特進、金紫光祿大夫，有名前代。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":86,"last_line":86,"raw_start":5565,"raw_end":5594,"raw_character_offsets":[5565,5566,5567,5568,5569,5570,5571,5572,5573,5574,5575,5576,5577,5578,5579,5580,5581,5582,5583,5584,5585,5586,5587,5588,5589,5590,5591,5592,5593],"revision_id":1544250}