":["灌"],"evidence":[{"paragraph_id":"c-shiji-084-qujia:p022","quote":"賈生以為漢興至孝文二十餘年，天下和洽，而固當改正朔，易服色，法制度，定官名，興禮樂，乃悉草具其事儀法，色尚黃，數用五，為官名，悉更秦之法。孝文帝初即位，謙讓未遑也。諸律令所更定，及列侯悉就國，其說皆自賈生發之。於是天子議以為賈生任公卿之位。絳、灌、東陽侯、馮敬之屬盡害之，乃短賈生曰：「雒陽之人，年少初學，專欲擅權，紛亂諸事。」於是天子後亦疏之，不用其議，乃以賈生為長沙王太傅。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-084-qujia:p022","text":"賈生以為漢興至孝文二十餘年，天下和洽，而固當改正朔，易服色，法制度，定官名，興禮樂，乃悉草具其事儀法，色尚黃，數用五，為官名，悉更秦之法。孝文帝初即位，謙讓未遑也。諸律令所更定，及列侯悉就國，其說皆自賈生發之。於是天子議以為賈生任公卿之位。絳、灌、東陽侯、馮敬之屬盡害之，乃短賈生曰：「雒陽之人，年少初學，專欲擅權，紛亂諸事。」於是天子後亦疏之，不用其議，乃以賈生為長沙王太傅。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m022-0000","start":0,"end":2,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m022-0069","start":69,"end":72,"surface":"孝文帝","kind":"person","person_id":"4ne_woz_rfe","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m022-0090","start":90,"end":92,"surface":"列侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代保持未解。"},{"id":"c-shiji-084-qujia:m022-0100","start":100,"end":102,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m022-0107","start":107,"end":109,"surface":"天子","kind":"person","person_id":"4ne_woz_rfe","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m022-0112","start":112,"end":114,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m022-0120","start":120,"end":121,"surface":"絳","kind":"person","person_id":"rjw_tpy_t2f","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m022-0122","start":122,"end":123,"surface":"灌","kind":"person","person_id":"t2y_z4k_z0m","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m022-0124","start":124,"end":127,"surface":"東陽侯","kind":"person","person_id":"08j_zgn_g6d","status":"contextual_provisional"},{"id":"c-shiji-084-qujia