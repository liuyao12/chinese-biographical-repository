ce_id":"s-chenshu-014-wangyong-ws2262003","chapter_id":"c-chenshu-014-wangyong","paragraph_id":"c-chenshu-014-wangyong:p001","quote":"禎明三年，隋師濟江，〔東〕衡州刺史王勇遣高州刺史戴智烈將五百騎迎方慶，欲令承制總督征討諸軍事。是時隋行軍總管韋洸帥兵度嶺，宣隋文帝敕云：「若嶺南平定，留勇與豐州刺史鄭萬頃且依舊職。」方慶聞之，恐勇賣己，乃不從，率兵以拒智烈。智烈與戰，敗之，斬方慶於廣州，虜其妻子。","person_mention_id":"c-chenshu-014-wangyong:p001:m0121"}],"status":"source_attested","interpretation_note":"方慶拒迎，與戴智烈戰，智烈斬之。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-chenshu-014-fangqing-family-context:p002:m0014","surface":"方慶","start":14,"end":16,"person_id":"eaj_zin_zxy_AB","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-chenshu-014-fangqing-family-context:p002","chapter_id":"c-chenshu-014-fangqing-family-context"},{"id":"c-chenshu-014-wangyong:p001:m0032","surface":"方慶","start":32,"end":34,"person_id":"eaj_zin_zxy_AB","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-chenshu-014-wangyong:p001","chapter_id":"c-chenshu-014-wangyong"},{"id":"c-chenshu-014-wangyong:p001:m0091","surface":"方慶","start":91,"end":93,"person_id":"eaj_zin_zxy_AB","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-chenshu-014-wangyong:p001","chapter_id":"c-chenshu-014-wangyong"},{"id":"c-chenshu-014-wangyong:p001:m0121","surface":"方慶","start":121,"end":123,"person_id":"eaj_zin_zxy_AB","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-chenshu-014-wangyong:p001","chapter_id":"c-chenshu-014-wangyong"},{"id":"c-chenshu-014-wangyong:p002:m0018","surface":"方慶","start":18,"end":20,"person_id":"eaj_zin_zxy_AB","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-chenshu-014-wangyong:p002","chapter_id":"c-chenshu-014-wangyong"},{"id":"c-chenshu-014-wangyong:p002:m0050","surface":"方慶","start":50,"end":52,"person_id":"eaj_zin_zxy_AB","kind":