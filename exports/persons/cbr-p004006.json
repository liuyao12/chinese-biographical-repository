[]}},"interpretation_note":"明示授予與來源用稱分存；左庶長、大良造官爵性質待制度研究，先保留未分類。封十五邑號商君記來源授封，缺字邑名未補，不由此補其他爵級。相秦十年與五羖大夫相秦六七年保存於引句，尚未核定精確起訖；逃亡、孝公卒、車裂與滅家不自動結束所有稱號。太子立與秦惠王按局部敘事暫接，不補王名或精確紀年。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji068-012","person_id":"cbr-p004006","surfaces":["天子"],"scope":"same_chapter","chapter_ids":["c-shiji-068-shang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-068-shang:p007","quote":"於是以鞅為大良造。將兵圍魏安邑，降之。居三年，作為筑冀闕宮庭於咸陽，秦自雍徙都之。而令民父子兄弟同室內息者為禁。而集小（都）鄉邑聚為縣，置令、丞，凡三十一縣。為田開阡陌封疆，而賦稅平。平斗桶權衡丈尺。行之四年，公子虔復犯約，劓之。居五年，秦人富彊，天子致胙於孝公，諸侯畢賀。"}],"rationale":"篇首明示商君名鞅公孫氏，入秦段續稱公孫鞅衛鞅，封號段號商君，局部暫接。魏惠王與梁惠王按魏徙都敘事暫接，秦太子立後秦惠王暫接而不補名。趙良對話夫子歸趙良；五羖大夫引古不補未載姓名。公叔座不按公叔與孫吳篇合併；公子驩不當新名，商君開塞耕戰書不作本人錨點。版本、年代及其他代詞仍待覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-068-shang:p007","text":"於是以鞅為大良造。將兵圍魏安邑，降之。居三年，作為筑冀闕宮庭於咸陽，秦自雍徙都之。而令民父子兄弟同室內息者為禁。而集小（都）鄉邑聚為縣，置令、丞，凡三十一縣。為田開阡陌封疆，而賦稅平。平斗桶權衡丈尺。行之四年，公子虔復犯約，劓之。居五年，秦人富彊，天子致胙於孝公，諸侯畢賀。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-068-shang:m007-0003","start":3,"end":4,"surface":"鞅","kind":"person","person_id":"cbr-p003995","status":"contextual_provisional"},{"id":"c-shiji-068-shang:m007-0044","start":44,"end":48,"surface":"父子兄弟","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者、泛論或未定指代；不補族群成員、闕代或姓名。"},{"id":"c-shiji-068-shang:m007-0069","start":69,"end":70,"surface":"令","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者、泛論或未定指代；不補族群成員、闕代或姓名。"},{"id":"c-shiji-068-shang:m007-0071","start":71,"end":72,"surface":"丞","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者、泛論或未定指代；不補族群成員、闕代或姓名。"},{"id":"c-shiji-068-shang:m007-0105","start":105,"end":108,"surface":"公子虔","kind":"person","person_id":"cbr-p004004","status":"contextual_provisional"},{"id":"c-shiji-068-shang:m007-0124","start"