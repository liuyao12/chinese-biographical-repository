relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji105-015","person_id":"21a_kok_ndw","surfaces":["虢君"],"scope":"same_chapter","chapter_ids":["c-shiji-105-bianque"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-105-bianque:p005","quote":"中庶子聞扁鵲言，目眩然而不瞚，舌撟然而不下，乃以扁鵲言入報虢君。虢君聞之大驚，出見扁鵲於中闕，曰：「竊聞高義之日久矣，然未嘗得拜謁於前也。先生過小國，幸而舉之，偏國寡臣幸甚。有先生則活，無先生則棄捐填溝壑，長終而不得反。」言末卒，因噓唏服臆，魂精泄橫，流涕長潸，忽忽承睫，悲不能自止，容貌變更。扁鵲曰：「若太子病，所謂『尸蹷』者也。夫以陽入陰中，動胃繵緣，中經維絡，別下於三焦、膀胱，是以陽脈下遂，陰脈上爭，會氣閉而不通，陰上而陽內行，下內鼓而不起，上外絕而不為使，上有絕陽之絡，下有破陰之紐，破陰絕陽，（之）色［已］廢脈亂，故形靜如死狀。太子未死也。夫以陽入陰支蘭藏者生，以陰入陽支蘭藏者死。凡此數事，皆五藏蹙中之時暴作也。良工取之，拙者疑殆。」"}],"rationale":"依本篇姓名、原稱及敘事回指暫定；醫案引語與附載注釋分層，未按同名自動跨篇合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-105-bianque:p005","text":"中庶子聞扁鵲言，目眩然而不瞚，舌撟然而不下，乃以扁鵲言入報虢君。虢君聞之大驚，出見扁鵲於中闕，曰：「竊聞高義之日久矣，然未嘗得拜謁於前也。先生過小國，幸而舉之，偏國寡臣幸甚。有先生則活，無先生則棄捐填溝壑，長終而不得反。」言末卒，因噓唏服臆，魂精泄橫，流涕長潸，忽忽承睫，悲不能自止，容貌變更。扁鵲曰：「若太子病，所謂『尸蹷』者也。夫以陽入陰中，動胃繵緣，中經維絡，別下於三焦、膀胱，是以陽脈下遂，陰脈上爭，會氣閉而不通，陰上而陽內行，下內鼓而不起，上外絕而不為使，上有絕陽之絡，下有破陰之紐，破陰絕陽，（之）色［已］廢脈亂，故形靜如死狀。太子未死也。夫以陽入陰支蘭藏者生，以陰入陽支蘭藏者死。凡此數事，皆五藏蹙中之時暴作也。良工取之，拙者疑殆。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-105-bianque:m005-0000","start":0,"end":3,"surface":"中庶子","kind":"person","person_id":"5z2_ick_ts9","status":"contextual_provisional"},{"id":"c-shiji-105-bianque:m005-0004","start":4,"end":6,"surface":"扁鵲","kind":"person","person_id":"6hq_bb2_3rb","status":"contextual_provisional"},{"id":"c-shiji-105-bianque:m005-0024","start":24,"end":26,"surface":"扁鵲","kind":"person","person_id":"6hq_bb2_3rb","status":"contextual_provisional"},{"id":"c-shiji-105-bianque:m005-0029","start":29,"end":31,"surface":"虢君","kind":"person","person_id":"21a_kok_ndw","status":"contextual_provisional"},{"id":"c-shiji-105-bianque:m005-0032","start":32,"end":34,"surface":"虢君","kind":"person","person