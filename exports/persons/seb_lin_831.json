{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"seb_lin_831","canonical_person_id":"seb_lin_831","id_aliases":["cbr-p004908"],"identity_policy":"contextual_provisional","person_ids":["seb_lin_831"],"persons":[{"id":"seb_lin_831","label":"陳勝（李斯列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"楚戍卒陳勝","mention_ids":["c-shiji-087-lisi:m021-0046"]},{"surface":"楚盜陳勝","mention_ids":["c-shiji-087-lisi:m028-0285"]}],"evidence":[{"mention_id":"c-shiji-087-lisi:m021-0046","chapter_id":"c-shiji-087-lisi","paragraph_id":"c-shiji-087-lisi:p021","quote":"楚戍卒陳勝"},{"mention_id":"c-shiji-087-lisi:m028-0285","chapter_id":"c-shiji-087-lisi","paragraph_id":"c-shiji-087-lisi:p028","quote":"楚盜陳勝"}],"id_aliases":["cbr-p004908"]}],"source_mention_summary":[{"source_id":"s-shiji-087-lisi","work_id":"w-shiji","book_id":"b-shiji-087","chapter_id":"c-shiji-087-lisi","mention_count":2,"mention_ids":["c-shiji-087-lisi:m021-0046","c-shiji-087-lisi:m028-0285"],"paragraph_ids":["c-shiji-087-lisi:p021","c-shiji-087-lisi:p028"],"passage_count":2}],"most_mentioned_source_ids":["s-shiji-087-lisi"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-087-lisi:m021-0046","start":46,"end":51,"surface":"楚戍卒陳勝","kind":"person","person_id":"seb_lin_831","status":"contextual_provisional","paragraph_id":"c-shiji-087-lisi:p021","chapter_id":"c-shiji-087-lisi"},{"id":"c-shiji-087-lisi:m028-0285","start":285,"end":289,"surface":"楚盜陳勝","kind":"person","person_id":"seb_lin_831","status":"contextual_provisional","paragraph_id":"c-shiji-087-lisi:p028","chapter_id":"c-shiji-087-lisi"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji087-041","person_id":"seb_lin_831","scope":"same_chapter","chapter_ids":["c-shiji-087-lisi"],"status":"contextual_provisional","rationale":"依二世用高及督責書局部承接暫接；第19段趙高之高排除高枕普通詞，第20段公子高與趙高分開；廣等只按吳廣兵承接，不標廣欲。堯禹標示傳說性，韓子商君與申韓未以模型記憶補名或全域合併；嵌套引語仍待核。","reviewer":"Codex（AI 代理）","surfaces":["楚戍卒陳勝","楚盜陳勝"],"evidence":[{"paragraph_id":"c-shiji-087-lisi:p021","quote":"法令誅罰日益刻深，羣臣人人自危，欲畔者眾。又作阿房之宮，治直、馳道，賦斂愈重，戍徭無已。於是楚戍卒陳勝、吳廣等乃作亂，起於山東，傑俊相立，自置為侯王，叛秦，兵至鴻門而卻。李斯數欲請間諫，二世不許。而二世責問李斯曰：「吾有私議而有所聞於韓子也，曰『堯之有天下也，堂高三尺，采椽不斲，茅茨不翦，雖逆旅之宿不勤於此矣。冬日鹿裘，夏日葛衣，粢糲之食，藜藿之羹，飯土匭，啜土鉶，雖監門之養不觳於此矣。禹鑿龍門，通大夏，疏九河，曲九防，決渟水致之海，而股無胈，脛無毛，手足胼胝，面目黎黑，遂以死于外，葬於會稽，臣虜之勞不烈於此矣』。然則夫所貴於有天下者，豈欲苦形勞神，身處逆旅之宿，口食監門之養，手持臣虜之作哉？此不肖人之所勉也，非賢者之所務也。彼賢人之有天下也，專用天下適己而已矣，此所貴於有天下也。夫所謂賢人者，必能安天下而治萬民，今身且不能利，將惡能治天下哉！故吾願賜志廣欲，長享天下而無害，為之奈何？」李斯子由為三川守，群盜吳廣等西略地，過去弗能禁。章邯以破逐廣等兵，使者覆案三川相屬，誚讓斯居三公位，如何令盜如此。李斯恐懼，重爵祿，不知所出，乃阿二世意，欲求容，以書對曰："},{"paragraph_id":"c-shiji-087-lisi:p028","quote":"高聞李斯以為言，乃見丞相曰：「關東羣盜多，今上急益發繇治阿房宮，聚狗馬無用之物。臣欲諫，為位賤。此真君侯之事，君何不諫？」李斯曰：「固也，吾欲言之久矣。今時上不坐朝廷，上居深宮，吾有所言者，不可傳也，欲見無間。」趙高謂曰：「君誠能諫，請為君候上間語君。」於是趙高待二世方燕樂，婦女居前，使人告丞相：「上方間，可奏事。」丞相至宮門上謁，如此者三。二世怒曰：「吾常多間日，丞相不來。吾方燕私，丞相輒來請事。丞相豈少我哉？且固我哉？」趙高因曰：「如此殆矣！夫沙丘之謀，丞相與焉。今陛下已立為帝，而丞相貴不益，此其意亦望裂地而王矣。且陛下不問臣，臣不敢言。丞相長男李由為三川守，楚盜陳勝等皆丞相傍縣之子，以故楚盜公行，過三川，城守不肯擊。高聞其文書相往來，未得其審，故未敢以聞。且丞相居外，權重於陛下。」二世以為然。欲案丞相，恐其不審，乃使人案驗三川守與盜通狀。李斯聞之。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-087-lisi:p021","text":"法令誅罰日益刻深，羣臣人人自危，欲畔者眾。又作阿房之宮，治直、馳道，賦斂愈重，戍徭無已。於是楚戍卒陳勝、吳廣等乃作亂，起於山東，傑俊相立，自置為侯王，叛秦，兵至鴻門而卻。李斯數欲請間諫，二世不許。而二世責問李斯曰：「吾有私議而有所聞於韓子也，曰『堯之有天下也，堂高三尺，采椽不斲，茅茨不翦，雖逆旅之宿不勤於此矣。冬日鹿裘，夏日葛衣，粢糲之食，藜藿之羹，飯土匭，啜土鉶，雖監門之養不觳於此矣。禹鑿龍門，通大夏，疏九河，曲九防，決渟水致之海，而股無胈，脛無毛，手足胼胝，面目黎黑，遂以死于外，葬於會稽，臣虜之勞不烈於此矣』。然則夫所貴於有天下者，豈欲苦形勞神，身處逆旅之宿，口食監門之養，手持臣虜之作哉？此不肖人之所勉也，非賢者之所務也。彼賢人之有天下也，專用天下適己而已矣，此所貴於有天下也。夫所謂賢人者，必能安天下而治萬民，今身且不能利，將惡能治天下哉！故吾願賜志廣欲，長享天下而無害，為之奈何？」李斯子由為三川守，群盜吳廣等西略地，過去弗能禁。章邯以破逐廣等兵，使者覆案三川相屬，誚讓斯居三公位，如何令盜如此。李斯恐懼，重爵祿，不知所出，乃阿二世意，欲求容，以書對曰：","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-087-lisi:m021-0009","start":9,"end":11,"surface":"羣臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或引古未定短稱保留未解，未補特定個人或世系。"},{"id":"c-shiji-087-lisi:m021-0046","start":46,"end":51,"surface":"楚戍卒陳勝","kind":"person","person_id":"seb_lin_831","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m021-0052","start":52,"end":54,"surface":"吳廣","kind":"person","person_id":"axt_oe2_4fw","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m021-0064","start":64,"end":66,"surface":"傑俊","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或引古未定短稱保留未解，未補特定個人或世系。"},{"id":"c-shiji-087-lisi:m021-0085","start":85,"end":87,"surface":"李斯","kind":"person","person_id":"5ok_joj_etv","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m021-0093","start":93,"end":95,"surface":"二世","kind":"person","person_id":"z0a_bdl_gn5_B","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m021-0099","start":99,"end":101,"surface":"二世","kind":"person","person_id":"z0a_bdl_gn5_B","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m021-0103","start":103,"end":105,"surface":"李斯","kind":"person","person_id":"5ok_joj_etv","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m021-0117","start":117,"end":119,"surface":"韓子","kind":"person","person_id":"oul_55f_fz3","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m021-0123","start":123,"end":124,"surface":"堯","kind":"person","person_id":"0yh_g69_8b8","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m021-0195","start":195,"end":196,"surface":"禹","kind":"person","person_id":"z9y_ry1_zee","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m021-0249","start":249,"end":251,"surface":"臣虜","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或引古未定短稱保留未解，