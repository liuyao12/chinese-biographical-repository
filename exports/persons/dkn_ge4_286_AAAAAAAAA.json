46:p001:m0010","start":10,"end":12,"surface":"陸曄","kind":"person","person_id":"h07_7e5_0jk","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-body-146:p001:m0018","start":18,"end":19,"surface":"帝","kind":"person","person_id":"dkn_ge4_286_AAAAAAAAA","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-body-146:p001:m0021","start":21,"end":22,"surface":"帝","kind":"person","person_id":"dkn_ge4_286_AAAAAAAAA","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-body-146:p001:m0028","start":28,"end":29,"surface":"崧","kind":"person","person_id":"yoo_ox0_545_BABAAA","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-body-146:p001:m0034","start":34,"end":35,"surface":"帝","kind":"person","person_id":"dkn_ge4_286_AAAAAAAAA","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-body-146:p001:m0040","start":40,"end":41,"surface":"帝","kind":"person","person_id":"dkn_ge4_286_AAAAAAAAA","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-body-146:p001:m0042","start":42,"end":44,"surface":"溫嶠","kind":"person","person_id":"6v8_pk9_7k5","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-body-146:p001:m0046","start":46,"end":47,"surface":"崧","kind":"person","person_id":"yoo_ox0_545_BABAAA","status":"contextual_provisional"}],"source_position":{"first_line":146,"last_line":146,"revision_id":2645530,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-075-xunsong-families","book_id":"b-jinshu-075","work_id":"w-jinshu","source_id":"s-jinshu-075-xunsong-families"}],"sources":[{"chapter_id":"c-jinshu-007-chengdi-family","work_id":"w-jinshu","book_id":"b-jinshu-007","source_id":"s-jinshu-007-chengdi-family","source":{"title":"《晉書》卷007（成帝家世選段）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?oldid=2582704","permalink":"https://zh.wikisource.org/w/index.php?oldid=2582704","revision_id":2582704,"accessed_on":"2026-10-18","extent":"成帝本紀傳首一段，非全卷。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，底本影像未核","wikitext_sha256":"7247d6de420e29835a0a9d505cf6c5dbd2fef1b12dc65955b677f54ff86dc1d1","normalization":{"character_conversion":{},"extraction_note":"僅去段首排版空白，保留原字。","excerpts":[{"proposed_paragraph_id":"c-jinshu-007-chengdi-family:p001","source_lines":[12,12],"raw_quote":"　　成皇帝諱衍，字世根，明帝長子也。","raw_quote_sha256":"1837fd90a175f31b7c725ca6ebb82ed99d39035a5529c5fdd672f6fc60d9159e","selected_text_sha256":"3437b701179832d0527965f99e0cc72b88fdf64e5ea3ff504b6521b79355418a","begin_anchor":"成皇帝諱衍，字世根，明帝長子也","end_anchor":"皇帝諱衍，字世根，明帝長子也。"}]}}},{"chapter_id":"c-jinshu-032-zheng-achun-family","work_id":"w-jinshu","book_id":"b-jinshu-032","source_id":"s-jinshu-032-zheng-achun-family","source":{"title":"《晉書》卷032（家世數位選錄）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7032&oldid=1543614","permalink":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7032&oldid=1543614","revision_id":1543614,"accessed_on":"2026-10-18","extent":"元帝后妃家世、荀豫章君及庾后冊立、鄭阿春敘事選段，非全卷或全部后妃傳。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，底本影像未核","response_sha256":"662028853af3848a3f71cc750fcc290b8e5af62354baecdb3158bcb95f511f0a","wikitext_sha256":"82cd88cad08dac2b1bbb57371dc460a43806730b4da42c143f041374bd6866c5","normalization":{"character_conversion":{},"extraction_note":"移除段首排版空白，維基連結僅取顯示原字；不換字、不補原文沒有的父母。","excerpts":[{"proposed_paragraph_id":"c-jinshu-032-zheng-achun-family:p001","source_lines":[64,64],"raw_quote":"　　簡文宣鄭太后諱阿春，河南滎陽人也。世為冠族。祖合，臨濟令。父愷，字祖元，安豐太守。","raw_quote_sha256":"97781c4ce6af4c998fc4992fd496973072f99f98f87c402902dfa224abf033fe","selected_text_sha256":"7bdb5e352617386f95b5850bfc52a8c420869eeaa65919506d5d08b2e1be22bd","begin_anchor":"簡文宣鄭太后諱阿春，河南滎陽人","end_anchor":"濟令。父愷，字祖元，安豐太守。"},{"proposed_paragraph_id":"c-jinshu-032-zheng-achun-family:zheng-marriages:p001","source_lines":[66,66],"raw_quote":"　　后少孤，無兄弟，唯姊妹四人，后最長。先適渤海田氏，生一男而寡，依于舅濮陽吳氏。元帝為丞相，敬后先崩，將納吳氏女為夫人。后及吳氏女並游後園，或見之，言於帝曰：「鄭氏女雖嫠，賢於吳氏遠矣。」{{YL|建武元年}}，納為琅邪王夫人，甚有寵。后雖貴幸，而恒有憂色。帝問其故，對曰：「妾有妹，中者已適長沙王褒，餘二妹未有所適，恐姊為人妾，無復求者。」帝因從容謂劉隗曰：「鄭氏二妹，卿可為求佳對，使不失舊。」隗舉其從子傭娶第三者，以小者適漢中李氏，皆得舊門。帝召王褒為尚書郎，以悅后意。后生琅邪悼王、簡文帝、尋陽公主。帝稱尊號，后雖為夫人，詔太子及東海、武陵王皆母事之。帝崩，后稱建平國夫人。","raw_quote_sha256":"f21b6aa3b9166d15152b348260dbc4ddee9d76add660cfda795a5d00919ff399","selected_text_sha256":"de0aca98ef8bc4a2a0d9cca79b710b920db29fe50ba7d55af947432a9129f048","begin_anchor":"后少孤，無兄弟，唯姊妹四人，后","end_anchor":"母事之。帝崩，后稱建平國夫人。"},{"proposed_paragraph_id":"c-jinshu-032-zheng-achun-family:zheng-death-and-son:p001","source_lines":[68,68],"raw_quote":"　　{{YL|咸和元年}}薨，簡文帝時為琅邪王，制服重。有司以王出繼，宜降所生，國臣不能匡正，奏免國相諸葛頤。王上疏曰：「亡母生臨臣國，沒留國第，臣雖出後，亦無所厭，則私情得敘。昔敬后崩，孝王已出繼，亦還服重。此則明比，臣所憲章也。」明穆皇后不奪其志，乃徙琅邪王為會稽王，追號后曰會稽太妃。及簡文帝即位，未及追尊。臨崩，封皇子道子為琅邪王，領會稽國，奉太妃祀。","raw_quote_sha256":"708d12035e0622c62e40e4371b51af0a5d7ce03d5727cd59190edea23ba2f189","selected_text_sha256":"de7b1ed4a6cef57fef25b2b9e7988638f7ee399b5251ea0e22a337ef23736169","begin_anchor":"咸和元年薨，簡文帝時為琅邪王，","end_anchor":"為琅邪王，領會稽國，奉太妃祀。"},{"proposed_paragraph_id":"c-jinshu-032-zheng-achun-family:yumengmu-intro:p001","source_lines":[11,11],"raw_quote":"　　元敬虞皇后諱孟母，濟陽外黃人也。父豫，見《外戚傳》。帝為琅邪王，納后為妃，無子。{{YL|永嘉六年}}薨，時年三十五。","raw_quote_sha256":"eef8e8718f12a35618941d0c7cee77b2f22fc5df5f89e3b3e773c2fce309eff7","selected_text_sha256":"8f3c5d0c24a617589d9c19035dde5c1bc0bc3b424c016724d863a8a52d1dce90","begin_anchor":"元敬虞皇后諱孟母，濟陽外黃人也","end_anchor":"無子。永嘉六年薨，時年三十五。"},{"proposed_paragraph_id":"c-jinshu-032-zheng-achun-family:yuwenjun-intro:p001","source_lines":[21,21],"raw_quote":"　　明穆庾皇后諱文君，潁川鄢陵人也。父琛，見《[[晉書/卷093#庾琛|外戚傳]]》。后性仁慈，美姿儀。元帝聞之，聘為太子妃，以德行見重。","raw_quote_sha256":"fde7b2e84078b42976ee984dd854acd1a8a51a224a20c6ab43a8c12875ee9ab6","selected_text_sha256":"27943de73f3c88e804b9bbcfa6c6df884fabcc11358070e7064547cfd11dd04a","begin_anchor":"明穆庾皇后諱文君，潁川鄢陵人也","end_anchor":"聞之，聘為太子妃，以德行見重。"},{"proposed_paragraph_id":"c-jinshu-032-zheng-achun-family:xun-lady-care:p001","source_lines":[18,18],"raw_quote":"　　豫章君荀氏，元帝宮人也。初有寵，生明帝及琅邪王裒，由是為虞后所忌。自以位卑，每懷怨望，為帝所譴，漸見疏薄。及明帝即位，封建安君，別立第宅。{{YL|太寧元年}}，帝迎還臺內，供奉隆厚。及成帝立，尊重同于太后。咸康元年薨。詔曰：「朕少遭憫凶，慈訓無稟，撫育之勤，建安君之仁也。一旦薨殂，實思報復，永惟平昔，感痛哀摧。其贈豫章郡君，別立廟于京都。」","raw_quote_sha256":"4a66e0a7e54d6a814ec87e4cc2068dfae51184978e65c393a0ef8d54728ebd2b","selected_text_sha256":"32b31b6d7d95ee638ffa037c0be1b08765018e6de121d41c648abfb81ca1b745","begin_anchor":"豫章君荀氏，元帝宮人也。初有寵","end_anchor":"其贈豫章郡君，別立廟于京都。」"},{"proposed_paragraph_id":"c-jinshu-032-zheng-achun-family:yuwenjun-marriage:p001","source_lines":[23,23],"raw_quote":"　　明帝即位，立為皇后。冊曰：「妃庾氏昔承明命，作嬪東宮，虔恭中饋，思媚軌則。履信思順，以成肅雝之道；正位閨房，以著協德之美。朕夙罹不造，煢煢在疚。群公卿士，稽之往代，僉以崇嫡明統，載在典謨，宜建長秋，以奉宗廟。是以追述先志，不替舊命，使使持節兼太尉授皇后璽綬。夫坤德尚柔，婦道承姑，崇粢盛之禮，敦螽斯之義。是以利在永貞，克隆堂基，母儀天下，潛暢陰教。鑒于六列，考之篇籍，禍福無門，盛衰由人，雖休勿休。其敬之哉，可不慎歟！」","raw_quote_sha256":"be1bc9c9a07a64485617ab2c0df9557bf8e95149d10ac6ca118e1a14861f18e7","selected_text_sha256":"298bc64073c2d8e02c65c22fcce63e87f0e795db731c313311721191042bcf96","begin_anchor":"明帝即位，立為皇后。冊曰：「妃","end_anchor":"休勿休。其敬之哉，可不慎歟！」"}]}}},{"chapter_id":"c-jinshu-075-xunsong-families","work_id":"w-jinshu","book_id":"b-jinshu-075","source_id":"s-jinshu-075-xunsong-families","source":{"title":"卷七十五·列傳第四十五（數位選錄）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=晉書/卷075&oldid=2645530","permalink":"https://zh.wikisource.org/w/index.php?title=晉書/卷075&oldid=2645530","revision_id":2645530,"accessed_on":"2026-10-18","extent":"荀崧本傳及荀蕤、荀羨附傳完整敘事段落；非全卷，注解、身份與官爵紀年仍在覆核。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，底本影像未核","response_sha256":"66cb6c8fe0c4f0a49ce57a29b251c2b59962e86a559d30cb4f3fa203df72539a","wikitext_sha256":"11d2db1eed03a9a461ce48abad661b90ba39911b13da75b3fe593dac197bc957","normalization":{"character_conversion":{},"extraction_note":"移除段首排版空白，展開維基連結顯示文字；YL年號模板僅展開所載字串，未因此換算公元年。原字不改。末段原完整書信及二子句一併保存，未冒作跨省略段落的相鄰承接。","excerpts":[{"proposed_paragraph_id":"c-jinshu-075-xunsong-families:xunsong-intro:p001","source_lines":[126,126],"raw_quote":"　　荀崧，字景猷，潁川臨潁人，魏太尉彧之玄孫也。父頵，羽林右監、安陵鄉侯，與王濟、何劭為拜親之友。崧志操清純，雅好文學。齠齔時，族曾祖顗見而奇之，以為必興頵門。弱冠，太原王濟甚相器重，以方其外祖陳郡袁侃，謂侃弟奧曰：「近見荀監子，清虛名理，當不及父，德性純粹，是賢兄輩人也。」其為名流所賞如此。泰始中，詔以崧代兄襲父爵，補濮陽王允文學。與王敦、顧榮、陸機等友善，趙王倫引為相國參軍。倫篡，轉護軍司馬、給事中，稍遷尚書吏部郎、太弟中庶子，累遷侍中、中護軍。","raw_quote_sha256":"fe438333d90d870f18507beeaa243dba468013b9cde8ced3f8299e5e7b3c3e7d","selected_text_sha256":"8af4d66de19334a53f00475c7c3c412950beff0bb74f32d6101469a02a22cfe0","begin_anchor":"荀崧，字景猷，潁川臨潁人，魏太","end_anchor":"太弟中庶子，累遷侍中、中護軍。"},{"proposed_paragraph_id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001","source_lines":[128,128],"raw_quote":"　　王彌入洛，崧與百官奔於密，未至而母亡。賊追將及，同旅散走，崧被髮從車，守喪號泣。賊至，棄其母屍於地，奪車而去。崧被四創，氣絕，至夜方蘇。葬母於密山。服闋，族父籓承制，以崧監江北軍事、南中郎將、後將軍、假節、襄城太守。時山陵發掘，崧遣主簿石覽將兵入洛，修復山陵。以勳進爵舞陽縣公，遷都督荊州江北諸軍事、平南將軍，鎮宛，改封曲陵公。為賊杜曾所圍。石覽時為襄城太守，崧力弱食盡，使其小女灌求救于覽及南中郎將周訪。訪即遣子撫率兵三千人會石覽，俱救崧。賊聞兵至，散走。崧既得免，乃遣南陽中部尉王國、劉願等潛軍襲穰縣，獲曾從兄偽新野太守保，斬之。","raw_quote_sha256":"2b305f0b95461c974328c3a55471cec3d89f086e29ba51e6e8fe7aa71cf0956b","selected_text_sha256":"71ed767e8d4c3172f287c501708b473ae8766a09a9eb2f733c04e8a236f9e73c","begin_anchor":"王彌入洛，崧與百官奔於密，未至","end_anchor":"，獲曾從兄偽新野太守保，斬之。"},{"proposed_paragraph_id":"c-jinshu-075-xunsong-families:xunsong-cousins:p001","source_lines":[130,130],"raw_quote":"　　元帝踐阼，徵拜尚書僕射，使崧與協共定中興禮儀。從弟馗早亡，二息序、廞，年各數歲，崧迎與共居，恩同其子。太尉、臨淮公荀顗國胤廢絕，朝庭以崧屬近，欲以崧子襲封。崧哀序孤微，乃讓封與序，論者稱焉。轉太常。時方修學校，簡省博士，置《[[周易]]》王氏、《[[尚書]]》鄭氏、《[[古文尚書]]》孔氏、《[[毛詩]]》鄭氏、《[[周官]][[禮記]]》鄭氏、《[[春秋左傳]]》杜氏服氏、《[[論語]]》《[[孝經]]》鄭氏博士各一人，凡九人，其《[[儀禮]]》、《[[公羊傳|公羊]]》、《[[穀梁傳|穀梁]]》及鄭《易》皆省不置。崧以為不可，乃上疏曰：","raw_quote_sha256":"564d35b0f95e1ca5cd0b7cd3b9ed4d2891fba8091b1351165f32ff8bb39b2ff8","selected_text_sha256":"7f2af7d927da993a6326177c585a39b178fe805bc1a31c32d2b7e12a22d1e030","begin_anchor":"元帝踐阼，徵拜尚書僕射，使崧與","end_anchor":"省不置。崧以為不可，乃上疏曰："},{"proposed_paragraph_id":"c-jinshu-075-xunsong-families:xunsong-sons:p001","source_lines":[148,148],"raw_quote":"　　其後著作郎虞預與丞相王導箋曰：「伏見前秘書、光祿大夫荀公，生於積德之族，少有儒雅之稱，歷位內外，在貴能降。蘇峻肆虐，乘輿失幸，公處嫌忌之地，有累卵之危，朝士為之寒心，論者謂之不免。而公將之以智，險而不懾，扶侍至尊，繾綣不離。雖無扶迎之勳，宜蒙守節之報。且其宣慈之美，早彰遠近，朝野之望，許以台司，雖未正位，已加儀同。至守終純固，名定闔棺，而薨卒之日，直加侍中。生有三槐之望，沒無鼎足之名，寵不增於前秩，榮不副於本望，此一時愚智所慷慨也。今承大弊之後，淳風頹散，苟有一介之善，宜在旌表之例，而況國之元老，志節若斯者乎！」不從。{{YL|升平四年}}，崧改葬，詔賜錢百萬，布五千匹。有二子：蕤、羨。蕤嗣。","raw_quote_sha256":"f1a65e82e51109992e7f9c866bd9d9e2dad65e1b99ed71937a68218b5ca8d74d","selected_text_sha256":"6115dc64ecf0cfafe174c4adc36cf60364b086d21c0ac358cd30a4a00deb7daf","begin_anchor":"其後著作郎虞預與丞相王導箋曰：","end_anchor":"五千匹。有二子：蕤、羨。蕤嗣。"},{"proposed_paragraph_id":"c-jinshu-075-xunsong-families:xunrui-full:p001","source_lines":[151,151],"raw_quote":"　　蕤字令遠。起家秘書郎，稍遷尚書左丞。蕤有儀操風望，雅為簡文帝所重。時桓溫平蜀，朝廷欲以豫章郡封溫。蕤言於帝曰：「若溫復假王威，北平河洛，修復園陵，將何以加此！」於是乃止。轉散騎常侍、少府，不拜，出補東陽太守。除建威將軍、吳國內史。卒官。籍嗣位，至散騎常侍、大長秋。","raw_quote_sha256":"74f7d439d44dfed11af019fff377fe97dfd61e47bb5f3dd870961e3cda8b4b34","selected_text_sha256":"fa134837917fcb817dbb0fb641bf7c1a9d4b920c0761ae4253f7cda1c781622d","begin_anchor":"蕤字令遠。起家秘書郎，稍遷尚書","end_anchor":"。籍嗣位，至散騎常侍、大長秋。"},{"proposed_paragraph_id":"c-jinshu-075-xunsong-families:xunxian-intro:p001","source_lines":[154,154],"raw_quote":"　　羨字令則。清和有准。才年七歲，遇蘇峻難，隨父在石頭，峻甚愛之，恆置膝上。羨陰白其母，曰：「得一利刀子，足以殺賊。」母掩其口，曰：「無妄言！」年十五，將尚尋陽公主，羨不欲連婚帝室，仍遠遁去。監司追，不獲已，乃出尚公主，拜駙馬都尉。弱冠，與琅邪王洽齊名，沛國劉惔、太原王濛、陳郡殷浩並與交好。","raw_quote_sha256":"cba16a96a9fff0376fdc288c9247af0d0c65dc1d90e10fc9270d424d7f7c893a","selected_text_sha256":"9232601227785d194d444ce87547acde1f9507b5a38bf4af15433768c7eac736","begin_anchor":"羨字令則。清和有准。才年七歲，","end_anchor":"、太原王濛、陳郡殷浩並與交好。"},{"proposed_paragraph_id":"c-jinshu-075-xunsong-families:xunxian-offices:p001","source_lines":[156,156],"raw_quote":"　　驃騎將軍何充出鎮京口，請為參軍。穆帝又以為撫軍參軍，征補太常博士，皆不就。後拜秘書丞、義興太守。征北將軍褚裒以為長史。既到，裒謂佐吏曰：「荀生資逸群之氣，將有沖天之舉，諸君宜善事之。」尋遷建威將軍、吳國內史。除北中郎將、徐州刺史、監徐兗二州揚州之晉陵諸軍事、假節。殷浩以羨在事有能名，故居以重任。時年二十八，中興方伯，未有如羨之少者。羨至鎮，發二州兵，使參軍鄭襲戍准陰。羨尋北鎮准陰，屯田于東陽之石鱉。尋加監青州諸軍事，又領兗州刺史，鎮下邳。羨自鎮來朝，時蔡謨固讓司徒，不起，中軍將軍殷浩欲加大辟，以問於羨。羨曰：「蔡公今日事危，明日必有桓文之舉。」浩乃止。","raw_quote_sha256":"e324ca3ded3ee4e8449fb9476e243de5fba8d8e9844f56ff5b0eac31d0b6533d","selected_text_sha256":"0035748d0ef16c7e52b70df5dedfb5fb7f7080596d2d8cab597b0e24bf59e49b","begin_anchor":"驃騎將軍何充出鎮京口，請為參軍","end_anchor":"，明日必有桓文之舉。」浩乃止。"},{"proposed_paragraph_id":"c-jinshu-075-xunsong-families:xunxian-north:p001","source_lines":[158,158],"raw_quote":"　　及慕容俊攻段蘭於青州，詔使羨救之。俊將王騰、趙盤寇琅邪、鄄城，北境騷動。羨討之，擒騰，盤迸走。軍次琅邪，而蘭已沒，羨退還下邳，留將軍諸葛攸、高平太守劉莊等三千人守琅邪，參軍戴逯、蕭鎋二千人守泰山。是時，慕容蘭以數萬眾屯汴城，甚為邊害。羨自光水引汶通渠，至於東阿以征之。臨陣，斬蘭。帝將封之，羨固辭不受。","raw_quote_sha256":"047c35de8dee3c818ebdd63c514a18e73690fbe7ecc25755ac4ed9750beb934c","selected_text_sha256":"c6d84b698eb25c9a6140b8c43cec1530d260ed98799b7dbf15f5d6d143f0af80","begin_anchor":"及慕容俊攻段蘭於青州，詔使羨救","end_anchor":"，斬蘭。帝將封之，羨固辭不受。"},{"proposed_paragraph_id":"c-jinshu-075-xunsong-families:xunxian-final:p001","source_lines":[160,160],"raw_quote":"　　先是，石季龍死，胡中大亂，羨撫納降附，甚得眾心。以疾篤解職。後除右軍將軍，加散騎常侍，讓不拜。{{YL|升平二年}}卒，時年三十八。帝聞之，歎曰：「荀令則、王敬和相繼凋落，股肱腹心將復誰寄乎！」追贈驃騎將軍。","raw_quote_sha256":"5f0dbb7357ea834bda7ff239bc4dc5e89a4458cf3e5cc507868aca769143ea38","selected_text_sha256":"e84422e0a5e95035b0797492d0d4e3458ee1b2d75f1ddcee6a0601a155c78bbe","begin_anchor":"先是，石季龍死，胡中大亂，羨撫","end_anchor":"心將復誰寄乎！」追贈驃騎將軍。"},{"proposed_paragraph_id":"c-jinshu-075-xunsong-families:xunsong-body-132:p001","source_lines":[132,132],"raw_quote":"{{quote|　　自喪亂以來，儒學尤寡，今處學則闕明廷之秀，仕朝則廢儒學之俊。昔咸寧、太康、永嘉之中，侍中、常侍、黃門通洽古今、行為世表者，領國子博士。一則應對殿堂，奉酬顧問；二則參訓國子，以弘儒訓；三則祠、儀二曹及太常之職，以得質疑。今皇朝中興，美隆往初，宜憲章令軌，祖述前典。世祖武皇帝應運登禪，崇儒興學。經始明堂，營建辟雍，告朔班政，鄉飲大射。西閣東序，河圖秘書禁籍。台省有宗廟太府金墉故事，太學有石經古文先儒典訓。賈、馬、鄭、杜、服、孔、王、何、顏、尹之徒，章句傳注眾家之學，置博士十九人。九州之中，師徒相傳，學士如林，猶選張華、劉寔居太常之官，以重儒教。","raw_quote_sha256":"e957fad4fbf5e0091e635777a992e08bdfd8c354aec8c4c39fa59d897a60f707","selected_text_sha256":"75a6b06a2044606c73d20d01b021d93057a9c3958b84e882308eace084096d74","begin_anchor":"自喪亂以來，儒學尤寡，今處學則","end_anchor":"華、劉寔居太常之官，以重儒教。"},{"proposed_paragraph_id":"c-jinshu-075-xunsong-families:xunsong-body-134:p001","source_lines":[134,134],"raw_quote":"　　傳稱「孔子沒而微言絕，七十二子終而大義乖」。自頃中夏殄瘁，講誦遏密，斯文之道，將墮於地。陛下聖哲龍飛，恢崇道教，樂正雅頌，於是乎在。江、揚二州，先漸聲教，學士遺文，於今為盛。然方疇昔，猶千之一。臣學不章句，才不弘通，方之華實，儒風殊邈。思竭駑駘，庶增萬分。願斯道隆於百世之上，搢紳詠於千載之下。","raw_quote_sha256":"babab1be88a54d84d289f29d810ae4dfc020018edc81ce507f8a17c85ddd459e","selected_text_sha256":"a890a95cd603155335179282f4ac0586def5f5ece6d39829c7177da3ebc02ab7","begin_anchor":"傳稱「孔子沒而微言絕，七十二子","end_anchor":"於百世之上，搢紳詠於千載之下。"},{"proposed_paragraph_id":"c-jinshu-075-xunsong-families:xunsong-body-136:p001","source_lines":[136,136],"raw_quote":"　　伏聞節省之制，皆三分置二。博士舊置十九人，今五經合九人，准古計今，猶未能半，宜及節省之制，以時施行。今九人以外，猶宜增四。願陛下萬機餘暇，時垂省覽。宜為鄭《易》置博士一人，鄭《儀禮》博士一人，《春秋公羊》博士一人，《穀梁》博士一人。","raw_quote_sha256":"e331fcf1975e304144baf168476d2e77f35e0c2672b5001a8b74e90baf81e45d","selected_text_sha256":"20aedb64e18bc5e913a3307b95f134120bba88bf18aad19664b03e381d2ef4d2","begin_anchor":"伏聞節省之制，皆三分置二。博士","end_anchor":"》博士一人，《穀梁》博士一人。"},{"proposed_paragraph_id":"c-jinshu-075-xunsong-families:xunsong-body-138:p001","source_lines":[138,138],"raw_quote":"　　昔周之衰，下陵上替，上無天子，下無方伯，善者誰賞，惡者誰罰，孔子懼而作《春秋》。諸侯諱妒，懼犯時禁，是以微辭妙旨，義不顯明，故曰「知我者其惟《[[春秋]]》，罪我者其惟《春秋》」。時左丘明、子夏造膝親受，無不精究。孔子既沒，微言將絕，於是丘明退撰所聞，而為之傳。其書善禮，多膏腴美辭，張本繼末，以發明經意，信多奇偉，學者好之。稱公羊高親受子夏，立于漢朝，辭義清雋，斷決明審，董仲舒之所善也。穀梁赤師徒相傳，暫立於漢世。向、歆，漢之碩儒，猶父子各執一家，莫肯相從。其書文清義約，諸所發明，或是《[[左傳|左氏]]》、《公羊》所不載，亦足有所訂正。是以三傳並行於先代，通才未能孤廢。今去聖久遠，其文將墮，與其過廢，寧與過立。臣以為三傳雖同曰《春秋》，而發端異趣，案如三家異同之說，此乃義則戰爭之場，辭亦劍戟之鋒，於理不可得共。博士宜各置一人，以博其學。}}","raw_quote_sha256":"571e2a7b4c6ef9777efa5ef504b4fd308cec64cf64fdf9ae33c241ace45f7d19","selected_text_sha256":"7f6c49f5ffae86051edcd98d97223817d6be817f5ca0d8098c1ef015a5514a70","begin_anchor":"昔周之衰，下陵上替，上無天子，","end_anchor":"共。博士宜各置一人，以博其學。"},{"proposed_paragraph_id":"c-jinshu-075-xunsong-families:xunsong-body-140:p001","source_lines":[140,140],"raw_quote":"　　元帝詔曰：「崧表如此，皆經國之務。為政所由。息馬投戈，猶可講藝，今雖日不暇給，豈忘本而遺存邪！可共博議者詳之。」議者多請從崧所奏。詔曰：「《穀梁》膚淺，不足置博士，余如奏。」會王敦之難，不行。","raw_quote_sha256":"be359d651493ec887cbdbdc3b47fcdfeed14ce3aa4cbbf0d90b8214f28cede9d","selected_text_sha256":"606bbf2dd5b744971ab9203a74aec4b09e9bc335aa7302ac4d723711b4bab8e4","begin_anchor":"元帝詔曰：「崧表如此，皆經國之","end_anchor":"，余如奏。」會王敦之難，不行。"},{"proposed_paragraph_id":"c-jinshu-075-xunsong-families:xunsong-body-142:p001","source_lines":[142,142],"raw_quote":"　　敦表以崧為尚書左僕射。及帝崩，群臣議廟號，王敦遣使謂曰：「豺狼當路，梓宮未反，祖宗之號，宜別思詳。」崧議以為：「禮，祖有功，宗有德。元皇帝天縱聖哲，光啟中興，德澤侔於太戊，功惠邁于漢宣，臣敢依前典，上號曰中宗。」既而與敦書曰：「承以長蛇未翦，別詳祖宗。先帝應天受命，以隆中興；中興之主，寧可隨世數而遷毀！敢率丹直。詢之朝野，上號中宗。卜日有期，不及重請，專輒之愆，所不敢辭。」初，敦待崧甚厚，欲以為司空，於此銜之而止。","raw_quote_sha256":"ff1f7b19ab513ec35beb6ae67da15f9eb79bbe76d3ac9d9050147353f8eb7512","selected_text_sha256":"877e362f6da4e1eb378d77e4100b5567dc480f534227891b70d1684401964ad1","begin_anchor":"敦表以崧為尚書左僕射。及帝崩，","end_anchor":"厚，欲以為司空，於此銜之而止。"},{"proposed_paragraph_id":"c-jinshu-075-xunsong-families:xunsong-body-144:p001","source_lines":[144,144],"raw_quote":"　　太寧初，加散騎常侍，後領太子太傅。以平王敦功，更封平樂伯。坐使威儀為猛獸所食，免職。後拜金紫光祿大夫、錄尚書事，散騎常侍如故。遷右光祿大夫、開府儀同三司，錄尚書如故。又領秘書監，給親兵百二十人。年雖衰老，而孜孜典籍，世以此嘉之。","raw_quote_sha256":"f22a4f15be62f692b43a659f4636c59c403bb72dfdedcd9d2df632172d824a2b","selected_text_sha256":"35e925eaf7fdb51bc623c9a4d189a02241c96145a025d214a4579f6d0536de09","begin_anchor":"太寧初，加散騎常侍，後領太子太","end_anchor":"衰老，而孜孜典籍，世以此嘉之。"},{"proposed_paragraph_id":"c-jinshu-075-xunsong-families:xunsong-body-146:p001","source_lines":[146,146],"raw_quote":"　　蘇峻之役，崧與王導、陸曄共登御床擁衛帝，及帝被逼幸石頭，崧亦侍從不離帝側。賊平，帝幸溫嶠舟，崧時年老病篤，猶力步而從。{{YL|咸和三年}}薨，時年六十七。贈侍中，諡曰敬。","raw_quote_sha256":"0c9749a27cbc8d6ca7655fc857b5b6a552cc041822edf34d33c1828c7d1c1663","selected_text_sha256":"c266c15c88452cb74a14499c129748284ee044d112e1e3a08640206e039762c3","begin_anchor":"蘇峻之役，崧與王導、陸曄共登御","end_anchor":"，時年六十七。贈侍中，諡曰敬。"}],"verified_blank_line_gaps":[{"source_lines":[127,127],"raw_quote":"","raw_quote_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","revision_id":2645530},{"source_lines":[129,129],"raw_quote":"","raw_quote_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","revision_id":2645530},{"source_lines":[131,131],"raw_quote":"","raw_quote_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","revision_id":2645530},{"source_lines":[133,133],"raw_quote":"","raw_quote_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","revision_id":2645530},{"source_lines":[135,135],"raw_quote":"","raw_quote_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","revision_id":2645530},{"source_lines":[137,137],"raw_quote":"","raw_quote_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","revision_id":2645530},{"source_lines":[139,139],"raw_quote":"","raw_quote_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","revision_id":2645530},{"source_lines":[141,141],"raw_quote":"","raw_quote_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","revision_id":2645530},{"source_lines":[143,143],"raw_quote":"","raw_quote_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","revision_id":2645530},{"source_lines":[145,145],"raw_quote":"","raw_quote_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","revision_id":2645530},{"source_lines":[147,147],"raw_quote":"","raw_quote_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","revision_id":2645530},{"source_lines":[155,155],"raw_quote":"","raw_quote_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","revision_id":2645530},{"source_lines":[157,157],"raw_quote":"","raw_quote_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","revision_id":2645530},{"source_lines":[159,159],"raw_quote":"","raw_quote_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","revision_id":2645530}]}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_n