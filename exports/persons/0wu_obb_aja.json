ewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-songshu-047-liujingxuan:p012:m0031","start":31,"end":33,"surface":"溫祚","kind":"person","person_id":"0wu_obb_aja","status":"contextual_provisional","paragraph_id":"c-songshu-047-liujingxuan:p012","chapter_id":"c-songshu-047-liujingxuan"}],"relations":[],"title_holdings":[{"id":"th-songshu-047-liujingxuan-12-22","title":"振武將軍","kind":"office","mode":"attestation","person_id":"0wu_obb_aja","attestations":[{"id":"th-songshu-047-liujingxuan-12-22:a","paragraph_id":"c-songshu-047-liujingxuan:p012","start":22,"end":26,"surface":"振武將軍","person_mention_id":"c-songshu-047-liujingxuan:p012:m0031","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-047","chapter_id":"c-songshu-047-liujingxuan","source_id":"s-songshu-047-liujingxuan-ws2190557","paragraph_id":"c-songshu-047-liujingxuan:p012","quote":"假敬宣節，監征蜀諸軍事，郡如故。既入峽，分遣振武將軍、巴東太守溫祚以二千人揚聲外水，自率益州刺史鮑陋、輔國將軍文處茂、龍驤將軍時延祖由墊江而進。敬宣率先士卒，轉戰而前，達遂寧郡之黃虎，去成都五百里。偽輔國將軍譙道福等悉眾距險，相持六十餘日，大小十餘戰，賊固守不敢出。敬宣不得進，食糧盡，軍中多疾疫，死者太半，引軍還。譙縱送毛璩一門諸喪，其妻女、文處茂母何，并諸士人喪柩，浮之中流，敬宣皆拯接致歸。為有司所奏，免官，削封三分之一。","person_mention_id":"c-songshu-047-liujingxuan:p012:m0031"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"th-songshu-047-liujingxuan-12-27","title":"巴東太守","kind":"office","mode":"attestation","person_id":"0wu_obb_aja","attestations":[{"id":"th-songshu-047-liujingxuan-12-27:a","paragraph_id":"c-songshu-047-liujingxuan:p012","start":27,"end":31,"surface":"巴東太守","person_mention_id":"c-songshu-047-liujingxuan:p012:m0031","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":nu