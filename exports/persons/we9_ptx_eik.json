s":[{"id":"th-w043-kong-bawang:a","paragraph_id":"c-shishuoxinyu-008-jin043-wangyan:bawang","start":7,"end":9,"surface":"長史","person_mention_id":"c-shishuoxinyu-008-jin043-wangyan:bawang:m0009","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-043-wangyan:p008","text":"越之討苟晞也，衍以太尉為太傅軍司。及越薨，眾共推為元帥。衍以賊寇鋒起，懼不敢當。辭曰：「吾少無宦情，隨牒推移，遂至於此。今日之事，安可以非才處之。」俄而舉軍為石勒所破，勒呼王公，與之相見，問衍以晉故。衍為陳禍敗之由，雲計不在己。勒甚悅之，與語移日。衍自說少不豫事，欲求自免，因勸勒稱尊號。勒怒曰：「君名蓋四海，身居重任，少壯登朝，至於白首，何得言不豫世事邪！破壞天下，正是君罪。」使左右扶出。謂其党孔萇曰：「吾行天下多矣，未嘗見如此人，當可活不？」萇曰：「彼晉之三公，必不為我盡力，又何足貴乎！」勒曰：「要不可加以鋒刃也。」使人夜排牆填殺之。衍將死，顧而言曰：「嗚呼！吾曹雖不如古人，向若不祖尚浮虛，戮力以匡天下，猶可不至今日。」時年五十六。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-043-wangyan:p008:m0000","start":0,"end":1,"surface":"越","kind":"person","person_id":"9o2_vhv_r7y","status":"contextual_provisional","resolution_note":"越薨後衍辭元帥，敗被石勒問罪；兩人第一二人稱依引語界分，王公為被俘群體。"},{"id":"c-jinshu-043-wangyan:p008:m0003","start":3,"end":5,"surface":"苟晞","kind":"person","person_id":"v5s_1ew_vh0","status":"contextual_provisional","resolution_note":"越薨後衍辭元帥，敗被石勒問罪；兩人第一二人稱依引語界分，王公為被俘群體。"},{"id":"c-jinshu-043-wangyan:p008:m0007","start":7,"end":8,"surface":"衍","kind":"person","person_id":"b0c_13f_c3a","status":"contextual_provisional","resolution_note":"越薨後衍辭元帥，敗被石勒問罪；兩人第一二人稱依引語界分，王公為被俘群體。"},{"id":"c-jinshu-043-wangyan:p008:m0018","start":18,"end":19,"surface":"越","kind":"person","person_id":"9o2_vhv_r7y","status":"contextual_provisional","resolution_note":"越薨後衍辭元帥，敗被石勒問罪；兩人第一二人稱依引語界分，王公為被俘群體。"},{"id":"c-j