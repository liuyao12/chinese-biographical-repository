ed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-043-wangyan:p008:m0199","start":199,"end":201,"surface":"孔萇","kind":"person","person_id":"we9_ptx_eik","status":"contextual_provisional","resolution_note":"越薨後衍辭元帥，敗被石勒問罪；兩人第一二人稱依引語界分，王公為被俘群體。","paragraph_id":"c-jinshu-043-wangyan:p008","chapter_id":"c-jinshu-043-wangyan"},{"id":"c-jinshu-043-wangyan:p008:m0224","start":224,"end":225,"surface":"萇","kind":"person","person_id":"we9_ptx_eik","status":"contextual_provisional","resolution_note":"越薨後衍辭元帥，敗被石勒問罪；兩人第一二人稱依引語界分，王公為被俘群體。","paragraph_id":"c-jinshu-043-wangyan:p008","chapter_id":"c-jinshu-043-wangyan"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-043-wangyan:p008","text":"越之討苟晞也，衍以太尉為太傅軍司。及越薨，眾共推為元帥。衍以賊寇鋒起，懼不敢當。辭曰：「吾少無宦情，隨牒推移，遂至於此。今日之事，安可以非才處之。」俄而舉軍為石勒所破，勒呼王公，與之相見，問衍以晉故。衍為陳禍敗之由，雲計不在己。勒甚悅之，與語移日。衍自說少不豫事，欲求自免，因勸勒稱尊號。勒怒曰：「君名蓋四海，身居重任，少壯登朝，至於白首，何得言不豫世事邪！破壞天下，正是君罪。」使左右扶出。謂其党孔萇曰：「吾行天下多矣，未嘗見如此人，當可活不？」萇曰：「彼晉之三公，必不為我盡力，又何足貴乎！」勒曰：「要不可加以鋒刃也。」使人夜排牆填殺之。衍將死，顧而言曰：「嗚呼！吾曹雖不如古人，向若不祖尚浮虛，戮力以匡天下，猶可不至今日。」時年五十六。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-043-wangyan:p008:m0000","start":0,"end":1,"surface":"越","kind":"person","person_id":"9o2_vhv_r7y","status":"contextual_provisional","resolution_note":"越薨後衍辭元帥，敗被石勒問罪；兩人第一二人稱依引語界分，王公為被俘群體。"},{"id":"c-jinshu-043-wangyan:p008:m0003","start":3,"end":5,"surface":"苟晞","kind":"person","person_id":"v5s_1ew_vh0","status":"contextual_provisional","resolution_note":"越薨後衍辭元帥，敗被石勒問罪；兩人第一二人稱依引語界分，王公為被俘群體。"},{"id":"c-jinshu-043-wangyan:p008:m0007","start":7,"end":8,"surface":"衍","kind":"person","person_id":"kwx_czc_d4c_A","status":"contextual_provisional","resolution_note":"越薨後衍辭元帥，敗被石勒問罪；兩人第一二人稱依引語界分，王公為被俘群體。"},{"id":"c-jinshu-043-wangyan:p008:m0018","start":18,"end":19,"surface":"越","kind":"person","person_id":"9o2_vhv_r7y","status":"contextual_provisional","resolution_note":"越薨後衍辭元帥，敗被石勒問罪；兩人第一二人稱依引語界分，王公為被俘群體。"},{"id":"c-jinshu-043-wangyan:p008:m0028","start":28,"end":29,"surface":"衍","kind":"person","person_id":"kwx_czc_d4c_A","status":"contextual_provisional","resolution_note":"越薨後衍辭元帥，敗被石勒問罪；兩人第一二人稱依引語界分，王公為被俘群體。"},{"id":"c-jinshu-043-wangyan:p008:m0044","start":44,"end":45,"surface":"吾","kind":"person","person_id":"kwx_czc_d4c_A","status":"contextual_provisional","resolution_note":"辭元帥時衍自稱。"},{"id":"c-jinshu-043-wangyan:p008:m0068","start":68,"end":70,"surface":"非才","kind":"person","person_id":"kwx_czc_d4c_A","status":"contextual_provisional","resolution_note":"衍自謙，非新人物。"},{"id":"c-jinshu-043-wangyan:p008:m0079","start":79,"end":81,"surface":"石勒","kind":"person","person_id":"0c9_95a_18b","status":"contextual_provisional","resolution_note":"越薨後衍辭元帥，敗被石勒問罪；兩人第一二人稱依引語界分，王公為被俘群體。"},{"id":"c-jinshu-043-wangyan:p008:m0084","start":84,"end":85,"surface":"勒","kind":"person","person_id":"0c9_95a_18b","status":"contextual_provisional","resolution_note":"越薨後衍辭元帥，敗被石勒問罪；兩人第一二人稱依引語界分，王公為被俘群體。"},{"id":"c-jinshu-043-wangyan:p008:m0086","start":86,"end":88,"surface":"王公","kind":"unresolved","person_id":null,"status":"unresolved","resolution_note":"被俘王公群指，不把王公全作衍。"},{"id":"c-jinshu-043-wangyan:p008:m0090","start":90,"end":91,"surface":"之","kind":"unresolved","person_id":null,"status":"unresolved","resolut