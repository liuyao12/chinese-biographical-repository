,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"2處獨立位置，2個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-weishu-weishou-058-yangbo-ws2087998"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-weishu-weishou-058-yangbo-yangkan:p007:m0063","start":63,"end":66,"surface":"李瓜花","kind":"person","person_id":"0hd_igq_zb2","status":"contextual_provisional","interpretation_note":"與袁建同受裴邃密購，後期契不會告發；不按現代名字臆改。","paragraph_id":"c-weishu-weishou-058-yangbo-yangkan:p007","chapter_id":"c-weishu-weishou-058-yangbo-yangkan"},{"id":"c-weishu-weishou-058-yangbo-yangkan:p007:m0279","start":279,"end":281,"surface":"瓜花","kind":"person","person_id":"0hd_igq_zb2","status":"contextual_provisional","interpretation_note":"與袁建同受裴邃密購，後期契不會告發；不按現代名字臆改。","paragraph_id":"c-weishu-weishou-058-yangbo-yangkan:p007","chapter_id":"c-weishu-weishou-058-yangbo-yangkan"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-weishu-weishou-058-yangbo-yangkan:p007","text":"年三十一，襲爵華陰伯。釋褐太尉、汝南王悅騎兵參軍。揚州刺史長孫稚請為錄事參軍。蕭衍豫州刺史裴邃治合肥城，規相掩襲，密購壽春郭人李瓜花、袁建等令為內應。邃已纂勒兵士，有期日矣，而慮壽春疑覺，遂謬移云：「魏始於馬頭置戍，如聞復欲修白捺舊城。若爾，便稍相侵逼，此亦須營歐陽，設交境之備。今板卒已集，唯聽信還。」佐僚咸欲以實答之，云無修白捺意。而侃曰：「白捺小城，本非形勝。邃好小黠，今集兵遣移，虛搆是言，得無有別圖也？」稚深悟之，乃云：「錄事可造移報。」侃移曰：「彼之纂兵，想別有意，何為妄構白捺也！他人有心，予忖度之，勿謂秦無人也。」邃得移，謂已知覺，便爾散兵。瓜花等以期契不會，便相告發，伏辜者十數家。邃後竟襲壽春，入羅城而退。遂列營於黎漿、梁城，日夕鈔掠。稚乃奏侃為統軍。","text_layer":"received_chapter","annotation_status":"in_progress","source_position":{"revision_id":2087998,"raw_start":1050,"raw_end":1386,"source_layer":"received_biography","raw_character_offsets":[1050,1051,1052,1053,1054,1055,1056,1057,1058,1059,1060,1061,1062,1063,1064,1065,1066,1067,1068,1069,1070,1071,1072,1073,1074,1075,1076,1077,1078,1079,1080,1081,1082,1083,1084,1085,1086,1087,1088,1089,1090,1091,1092,1093,1094,1095,1096,1097,1098,1099,1100,1101,1102,1103,1104,1105,1106,1107,1108,1109,1110,1111,1112,1113,1114,1115,1116,1117,1118,1119,1120,1121,1122,1123,1124,1125,1126,1127,1128,1129,1130,1131,1132,1133,1134,1135,1136,1137,1138,1139,1140,1141,1142,1143,1144,1145,1146,1147,1148,1149,1150,1151,1152,1153,1154,1155,1156,1157,1158,1159,1160,1161,1162,1163,1164,1165,1166,1167,1168,1169,1170,1171,1172,1173,1174,1175,1176,1177,1178,1179,1180,1181,1182,1183,1184,1185,1186,1187,1188,1189,1190,1191,1192,1193,1194,1195,1196,1197,1198,1199,1200,1201,1202,1203,1204,1205,1206,1207,1208,1209,1210,1211,1212,1213,1214,1215,1216,1217,1218,1219,1220,1221,1222,1223,1224,1225,1226,1227,1228,1229,1230,1231,1232,1233,1234,1235,1236,1237,1238,1239,1240,1241,1242,1243,1244,1245,1246,1247,1248,1249,1250,1251,1252,1253,1254,1255,1256,1257,1258,1259,1260,1261,1262,1263,1264,1265,1266,1267,1268,1269,1270,1271,1272,1273,1274,1275,1276,1277,1278,1279,1280,1281,1282,1283,1284,1285,1286,1287,1288,1289,1290,1291,1292,1293,1294,1295,1296,1297,1298,1299,1300,1301,1302,1303,1304,1305,1306,1307,1308,1309,1310,1311,1312,1313,1314,1315,1316,1317,1318,1319,1320,1321,1322,1323,1324,1325,1326,1327,1328,1329,1330,1331,1332,1333,1334,1335,1336,1337,1338,1339,1340,1341,1342,1343,1344,1345,1346,1347,1348,1349,1350,1351,1352,1353,1354,1355,1356,1357,1358,1359,1360,1361,1362,1363,1364,1365,1366,1367,1368,1369,1370,1371,13