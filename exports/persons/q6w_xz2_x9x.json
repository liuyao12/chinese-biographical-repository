{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"q6w_xz2_x9x","canonical_person_id":"q6w_xz2_x9x","id_aliases":["cbr-p004593"],"identity_policy":"contextual_provisional","person_ids":["q6w_xz2_x9x"],"persons":[{"id":"q6w_xz2_x9x","label":"蒯通（樂毅列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"蒯通","mention_ids":["c-shiji-080-leyi:m020-0008"]}],"evidence":[{"mention_id":"c-shiji-080-leyi:m020-0008","chapter_id":"c-shiji-080-leyi","paragraph_id":"c-shiji-080-leyi:p020","quote":"蒯通"}],"id_aliases":["cbr-p004593"]}],"source_mention_summary":[{"source_id":"s-shiji-080-leyi","work_id":"w-shiji","book_id":"b-shiji-080","chapter_id":"c-shiji-080-leyi","mention_count":1,"mention_ids":["c-shiji-080-leyi:m020-0008"],"paragraph_ids":["c-shiji-080-leyi:p020"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-080-leyi"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-080-leyi:m020-0008","start":8,"end":10,"surface":"蒯通","kind":"person","person_id":"q6w_xz2_x9x","status":"contextual_provisional","paragraph_id":"c-shiji-080-leyi:p020","chapter_id":"c-shiji-080-leyi"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji080-039","person_id":"q6w_xz2_x9x","scope":"same_chapter","chapter_ids":["c-shiji-080-leyi"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["蒯通"],"evidence":[{"paragraph_id":"c-shiji-080-leyi:p020","quote":"太史公曰：始齊之蒯通及主父偃讀樂毅之報燕王書，未嘗不廢書而泣也。樂臣公學黃帝、老子，其本師號曰河上丈人，不知其所出。河上丈人教安期生，安期生教毛翕公，毛翕公教樂瑕公，樂瑕公教樂臣公，樂臣公教蓋公。蓋公教於齊高密、膠西，為曹相國師。"}],"rationale":"樂閒明示為樂毅子，樂叔明示為孫，不補闕代父親；樂乘為樂閒宗不補兄弟。燕王喜來書及趙襄王君序各限本段，曹相國未見名字不回填。河上丈人至蓋公師承不作父子。依本篇明示姓名、君序與來書答書範圍暫接；燕惠王來書寡人指惠王、將軍指樂毅，樂毅答書先王指昭王、足下君王指惠王。伍子胥引古首吳王指闔閭，後吳王在夫差賜鴟夷後指夫差。父兄與群臣不補具體親屬，王齊為反間假說不作授王爵。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-080-leyi:p020","text":"太史公曰：始齊之蒯通及主父偃讀樂毅之報燕王書，未嘗不廢書而泣也。樂臣公學黃帝、老子，其本師號曰河上丈人，不知其所出。河上丈人教安期生，安期生教毛翕公，毛翕公教樂瑕公，樂瑕公教樂臣公，樂臣公教蓋公。蓋公教於齊高密、膠西，為曹相國師。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-080-leyi:m020-0000","start":0,"end":3,"surface":"太史公","kind":"person","person_id":"qfh_0ve_74z","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m020-0008","start":8,"end":10,"surface":"蒯通","kind":"person","person_id":"q6w_xz2_x9x","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m020-0011","start":11,"end":14,"surface":"主父偃","kind":"person","person_id":"jj8_r26_ani","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m020-0015","start":15,"end":17,"surface":"樂毅","kind":"person","person_id":"idh_bo6_4kq","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m020-0019","start":19,"end":21,"surface":"燕王","kind":"person","person_id":"ly0_vry_w1c_A","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m020-0032","start":32,"end":35,"surface":"樂臣公","kind":"person","person_id":"q78_d8z_wj2","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m020-0036","start":36,"end":38,"surface":"黃帝","kind":"person","person_id":"3sg_3tv_dpq","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m020-0039","start":39,"end":41,"surface":"老子","kind":"person","person_id":"gob_5tz_8nl","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m020-0047","start":47,"end":51,"surface":"河上丈人","kind":"person","person_id":"lqh_jlr_dl6","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m020-0058","start":58,"end":62,"surface":"河上丈人","kind"