","start":31,"end":32,"surface":"參","kind":"person","person_id":"diy_04a_wsu","status":"contextual_provisional","paragraph_id":"c-shiji-130-taishigong:p066","chapter_id":"c-shiji-130-taishigong"},{"id":"c-shiji-130-taishigong:m066-0039","start":39,"end":42,"surface":"曹相國","kind":"person","person_id":"diy_04a_wsu","status":"contextual_provisional","paragraph_id":"c-shiji-130-taishigong:p066","chapter_id":"c-shiji-130-taishigong"},{"id":"c-shiji-130-taishigong:m142-0091","start":91,"end":93,"surface":"曹參","kind":"person","person_id":"diy_04a_wsu","status":"contextual_provisional","paragraph_id":"c-shiji-130-taishigong:p142","chapter_id":"c-shiji-130-taishigong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-130-taishigong:p066","text":"與信定魏，破趙拔齊，遂弱楚人。續何相國，不變不革，黎庶攸寧。嘉參不伐功矜能，作曹相國世家第二十四。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m066-0001","start":1,"end":2,"surface":"信","kind":"person","person_id":"vug_pb4_94e","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m066-0016","start":16,"end":17,"surface":"何","kind":"person","person_id":"1xf_5a0_n0p","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m066-0031","start":31,"end":32,"surface":"參","kind":"person","person_id":"diy_04a_wsu","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m066-0039","start":39,"end":42,"surface":"曹相國","kind":"person","person_id":"diy_04a_wsu","status":"contextual_provisional"}],"chapter_id":"c-shiji-130-taishigong","book_id":"b-shiji-130","work_id":"w-shiji","source_id":"s-shiji130-taishigong"},{"id":"c-shiji-130-taishigong:p142","text":"維我漢繼五帝末流，接三代絕業。周道廢，秦撥去古文，焚滅詩書，故明堂石室金匱玉版圖籍散亂。於是漢興，蕭何次律令，韓信申軍法，張蒼為章程，叔孫通定禮儀，則文學彬彬稍進，詩書往往閒出矣。自曹參薦蓋公言黃老，而賈生、晁錯明申、商，公孫弘以儒顯，百年之閒，天下遺文古事靡不畢集太史公。太史公仍父子相續纂其職。曰：「於戲！余維先人嘗掌斯事，顯於唐虞，至于周，復典之，故司馬氏世主天官。至於余乎，欽念哉！欽念哉！」罔羅天下放失舊聞，王跡所興，原始察終，見盛觀衰，論考之行事，略推三代，錄秦漢，上記軒轅，下至于茲，著十二本紀，既科條之矣。并時異世，年差不明，作十表。禮樂損益，律歷改易，兵權山川鬼神，天人之際，承敝通變，作八書。二十八宿環北辰，三十輻共一轂，運行無窮，輔拂股肱之臣配焉，忠信行道，以奉主上，作三十世家。扶義俶儻，不令己失時，立功名於天下，作七十列傳。凡百三十篇，五十二萬六千五百字，為太史公書。序略，以拾遺補闕，成一家之言，厥協六經異傳，整齊百家雜語，藏之名山，副在京師，俟後世聖人君子。第七十。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m142-0004","start":4,"end":6,"surface":"五帝","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-130-taishigong:m142-0049","start":49,"end":51,"surface":"蕭何","kind":"person","person_id":"1xf_5a0_n0p","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m142-0055","start":55,"end":57,"surface":"韓信","kind":"person","person_id":"2nx_tda_i4j","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m142-0061","start":61,"end":63,"surface":"張蒼","kind":"person","person_id":"796_nkw_0jz_A","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m142-0067","start":67,"end":70,"surface":"叔孫通","kind":"person","person_id":"axb_hsg_0lj","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m142-0091","start":91,"end":93,"surface":"曹參","kind":"person","person_id":"diy_04a_wsu","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m142-0094","start":94,"end":96,"surface":"蓋公","kind":"person","person_id":"kaz_pcf_2vd","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m142-0097","start":97,"end":99,"surface":"黃老","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-130-taishigong:m142-0101","start":101,"end":103,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m142-0104","start":104,"end":106,"surface":"晁錯","kind":"person","person_id":"04u_gq0_nke_A","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m142-0107","start":107,"end":110,"surface":"申、商","kind":"unresolved","person_id":null,