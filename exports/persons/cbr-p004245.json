in:m070-1135","start":1135,"end":1136,"surface":"唐","kind":"person","person_id":"cbr-p000526","status":"contextual_provisional"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-005-qin:p074","text":"莊襄王元年，大赦罪人，修先王功臣，施德厚骨肉而布惠於民。東周君與諸侯謀秦，秦使相國呂不韋誅之，盡入其國。秦不絕其祀，以陽人地賜周君，奉其祭祀。使蒙驁伐韓，韓獻成皋、鞏。秦界至大梁，初置三川郡。二年，使蒙驁攻趙，定太原。三年，蒙驁攻魏高都、汲，拔之。攻趙榆次、新城、狼孟，取三十七城。四月日食。（四年）王齕攻上黨。初置太原郡。魏將無忌率五國兵擊秦，秦卻於河外。蒙驁敗，解而去。五月丙午，莊襄王卒，子政立，是為秦始皇帝。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m074-0000","start":0,"end":3,"surface":"莊襄王","kind":"person","person_id":"cbr-p000310","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m074-0028","start":28,"end":31,"surface":"東周君","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、氏族、群體或未核指代；不補造個人或按熟知世系自動合併。"},{"id":"c-shiji-005-qin:m074-0039","start":39,"end":44,"surface":"相國呂不韋","kind":"person","person_id":"cbr-p000530","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m074-0063","start":63,"end":65,"surface":"周君","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、氏族、群體或未核指代；不補造個人或按熟知世系自動合併。"},{"id":"c-shiji-005-qin:m074-0072","start":72,"end":74,"surface":"蒙驁","kind":"person","person_id":"cbr-p000531","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m074-0100","start":100,"end":102,"surface":"蒙驁","kind":"person","person_id":"cbr-p000531","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m074-0112","start":112,"end":114,"surface":"蒙驁","kind":"person","person_id":"cbr-p000531","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m074-0150","start":150,"end":152,"surface":"王齕","kind":"person","person_id":"cbr-p000523","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m074-0162","start":162,"end":166,"surface":"魏將無忌","kind":"person","person_id":"cbr-p000532","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m074-0179","start":179,"end":181,"surface":"蒙驁","kind":"person","person_id":"cbr-p000531","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m074-0192","start":192,"end":195,"surface":"莊襄王","kind":"person","person_id":"cbr-p000310","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m074-0198","start":198,"end":199,"surface":"政","kind":"person","person_id":"cbr-p000533","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m074-0203","start":203,"end":207,"surface":"秦始皇帝","kind":"person","person_id":"cbr-p000533","status":"contextual_provisional"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-073-baiwang:p004","text":"四十七年，秦使左庶長王龁攻韓，取上黨。上黨民走趙。趙軍長平，以按據上黨民。四月，龁因攻趙。趙使廉頗將。趙軍士卒犯秦斥兵，秦斥兵斬趙裨將茄。六月，陷趙軍，取二鄣四尉。七月，趙軍筑壘壁而守之。秦又攻其壘，取二尉，敗其陣，奪西壘壁。廉頗堅壁以待秦，秦數挑戰，趙兵不出。趙王數以為讓。而秦相應侯又使人行千金於趙為反閒，曰：「秦之所惡，獨畏馬服子趙括將耳，廉頗易與，且降矣。」趙王既怒廉頗軍多失亡，軍數敗，又反堅壁不敢戰，而又聞秦反閒之言，因使趙括代廉頗將以擊秦。秦聞馬服子將，乃陰使武安君白起為上將軍。而王龁為尉裨將，令軍中有敢泄武安君將者斬。趙括至，則出兵擊秦軍。秦軍詳敗而走，張二奇兵以劫之。趙軍逐勝，追造秦壁。壁堅拒不得入，而秦奇兵二萬五千人絕趙軍後，又一軍五千騎絕趙壁閒，趙軍分而為二，糧道絕。而秦出輕兵擊之。趙戰不利，因筑壁堅守，以待救至。秦王聞趙食道絕，王自之河內，賜民爵各一級，發年十五以上悉詣長平，遮絕趙救及糧食。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-073-baiwang:m004-0007","start":7,"end":12,"surface":"左庶長王龁","kind":"person","person_id":"cbr-p004245","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m004-0040","start":40,"end":41,"surface":"龁","kind":"person","person_id":"cbr-p004245","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m004-0047","start":47,"end":49,"surface":"廉頗","kind":"person","person_id":"cbr-p004246","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m004-0064","start":64,"end":68,"surface":"趙裨將茄","kind":"person","person_id":"cbr-p004247","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m004-0079","start":79,"end":81,"surface":"四尉","kind":"unresolved","person_id":null,"status":"unresolved","note":"數量化尉官群體未名，不建立假定個別人物。"},{"id":"c-shiji-073-baiwang:m004-0101","start":101,"end":103,"surface":"二尉","kind":"unresolved","person_id":null,"status":"unresolved","note":"數量化尉官群體未名，不建立假定個別人物。"},{"id":"c-shiji-073-baiwang:m004-0113","start":113,"end":115,"surface":"廉頗","kind":"person","person_id":"cbr-p004246","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m004-0131","start":131,"end":133,"surface":"趙王","kind":"person","person_id":"cbr-p004242","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m004-0139","start":139,"end":143,"surface":"秦相應侯","kind":"person","person_id":"cbr-p004248","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m004-0165","start":165,"end":170,"surface":"馬服子趙括","kind":"person","person_id":"cbr-p004249","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m004-0173","start":173,"end":175,"surface":"廉頗","kind":"person","person_id":"cbr-p004246","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m004-0183","start":183,"end":185,"surface":"趙王","kind":"person","person_id":"cbr-p004242","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m004-0187","start":187,"end":189,"surface":"廉頗","kind":"person","person_id":"cbr-p004246","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m004-0217","start":217,"end":219,"surface":"趙括","kind":"person","person_id":"cbr-p004249","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m004-0220","start":220,"end":222,"surface":"廉頗","kind":"person","person_id":"cbr-p004246","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m004-0229","start":229,"end":232,"surface":"馬服子","kind":"person","person_id":"cbr-p004249","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m004-0237","start":237,"end":242,"surface":"武安君白起","kind":"person","person_id":"cbr-p004232","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m004-0248","start":248,"end":250,"surface":"王龁","kind":"person","person_id":"cbr-p004245","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m004-0261","start":261,"end":264,"surface":"武安君","kind":"person","person_id":"cbr-p004232","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m004-0268","start":268,"end":270,"surface":"趙括","kind":"person","person_id":"cbr-p004249","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m004-0371","start":371,"end":373,"surface":"秦王","kind":"person","person_id":"cbr-p004233","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m004-0379","start":379,"end":380,"surface":"王","kind":"person","person_id":"cbr-p004233","status":"contextual_provisional"}],"chapter_id":"c-shiji-073-baiwang","book_id":"b-shiji-073","work_id":"w-shiji","source_id":"s-shiji-073-baiwang"},{"id":"c-shiji-073-baiwang:p006","text":"四十八年十月，秦復定上黨郡。秦分軍為二：王龁攻皮牢，拔之；司馬梗定太原。韓、趙恐，使蘇代厚幣說秦相應侯曰：「武安君禽馬服子乎？」曰：「然。」又曰：「即圍邯鄲乎？」曰：「然。」「趙亡則秦王王矣，武安君為三公。武安君所為秦戰勝攻取者七十餘城，南定鄢、郢、漢中，北禽趙括之軍，雖周、召、呂望之功不益於此矣。今趙亡，秦王王，則武安君必為三公，君能為之下乎？雖無欲為之下，固不得已矣。秦嘗攻韓，圍邢丘，困上黨，上黨之民皆反為趙，天下不樂為秦民之日久矣。今亡趙，北地入燕，東地入齊，南地入韓、魏，則君之所得民亡幾何人。故不如因而割之，無以為武安君功也。」於是應侯言於秦王曰：「秦兵勞，請許韓、趙之割地以和，且休士卒。」王聽之，割韓垣雍、趙六城以和。正月，皆罷兵。武安君聞之，由是與應侯有隙。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-073-baiwang:m006-0020","start":20,"end":22,"surface":"王龁","kind":"person","person_id":"cbr-p004245","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m006-0029","start":29,"end":32,"surface":"司馬梗","kind":"person","person_id":"cbr-p004250","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m006-0042","start":42,"end":44,"surface":"蘇代","kind":"person","person_id":"cbr-p004251","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m006-0047","start":47,"end":51,"surface":"秦相應侯","kind":"person","person_id":"cbr-p004248","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m006-0054","start":54,"end":57,"surface":"武安君","kind":"person","person_id":"cbr-p004232","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m006-0058","start":58,"end":61,"surface":"馬服子","kind":"person","person_id":"cbr-p004249","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m006-0091","start":91,"end":93,"surface":"秦王","kind":"person","person_id":"cbr-p004233","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m006-0096","start":96,"end":99,"surface":"武安君","kind":"person","person_id":"cbr-p004232","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m006-0103","start":103,"end":106,"surface":"武安君","kind":"person","person_id":"cbr-p004232","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m006-0130","start":130,"end":132,"surface":"趙括","kind":"person","person_id":"cbr-p004249","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m006-0136","start":136,"end":137,"surface":"周","kind":"person","person_id":"cbr-p004252","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m006-0138","start":138,"end":139,"surface":"召","kind":"person","person_id":"cbr-p004253","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m006-0140","start":140,"end":142,"surface":"呂望","kind":"person","person_id":"cbr-p004254","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m006-0154","start":154,"end":156,"surface":"秦王","kind":"person","person_id":"cbr-p004233","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m006-0159","start":159,"end":162,"surface":"武安君","kind":"person","person_id":"cbr-p004232","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m006-0167","start":167,"end":168,"surface":"君","kind":"person","person_id":"cbr-p004248","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m006-0243","start":243,"end":244,"surface":"君","kind":"person","person_id":"cbr-p004248","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m006-0264","start":264,"end":267,"surface":"武安君","kind":"person","person_id":"cbr-p004232","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m006-0273","start":273,"end":275,"surface":"應侯","kind":"person","person_id":"cbr-p004248","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m006-0277","start":277,"end":279,"surface":"秦王","kind":"person","person_id":"cbr-p004233","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m006-0303","start":303,"end":304,"surface":"王","kind":"person","person_id":"cbr-p004233","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m006-0325","start":325,"end":328,"surface":"武安君","kind":"person","person_id":"cbr-p004232","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m006-0334","start":334,"end":336,"surface":"應侯","kind":"person","person_id":"cbr-p004248","status":"contextual_provisional"}],"chapter_id":"c-shiji-073-baiwang","book_id":"b-shiji-073","work_id":"w-shiji","source_id":"s-shiji-073-baiwang"},{"id":"c-shiji-073-baiwang:p008","text":"秦王使王龁代陵將，八九月圍邯鄲，不能拔。楚使春申君及魏公子將兵數十萬攻秦軍，秦軍多失亡。武安君言曰：「秦不聽臣計，今如何矣！」秦王聞之，怒，彊起武安君，武安君遂稱病甐。應侯請之，不起。於是免武安君為士伍，遷之陰密。武安君病，未能行。居三月，諸侯攻秦軍急，秦軍數卻，使者日至。秦王乃使人遣白起，不得留咸陽中。武安君既行，出咸陽西門十里，至杜郵。秦昭王與應侯群臣議曰：「白起之遷，其意尚怏怏不服，有餘言。」秦王乃使使者賜之劍，自裁。武安君引劍將自剄，曰：「我何罪于天而至此哉？」良久，曰：「我固當死。長平之戰，趙卒降者數十萬人，我詐而盡阬之，是足以死。」遂自殺。武安君之死也，以秦昭王五十年十一月。死而非其罪，秦人憐之，鄉邑皆祭祀焉。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-073-baiwang:m008-0000","start":0,"end":2,"surface":"秦王","kind":"person","person_id":"cbr-p004233","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m008-0003","start":3,"end":5,"surface":"王龁","kind":"person","person_id":"cbr-p004245","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m008-0006","start":6,"end":7,"surface":"陵","kind":"person","person_id":"cbr-p004255","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m008-0022","start":22,"end":25,"surface":"春申君","kind":"person","person_id":"cbr-p004256","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m008-0026","start":26,"end":29,"surface":"魏公子","kind":"person","person_id":"cbr-p004257","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m008-0044","start":44,"end":47,"surface":"武安君","kind":