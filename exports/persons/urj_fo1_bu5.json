,"kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p024:m0159","start":159,"end":160,"surface":"朕","person_id":"dkn_ge4_286_AAAAAAAA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p024:m0167","start":167,"end":168,"surface":"鳳","person_id":"762_5c8_663","kind":"person"}],"chapter_id":"c-jinshu-098-wangdun-comparison","book_id":"b-jinshu-098","work_id":"w-jinshu","source_id":"s-jinshu098-wangdun-ws2614273-comparison"},{"id":"c-jinshu-098-wangdun-comparison:p029","text":"近承大將軍困篤綿綿，或云已有不諱，悲怛之情，不能自勝。尋知錢鳳大嚴，欲肆奸逆，朝士忿憤，莫不扼腕。去月二十三日，得征北告，劉遐、陶瞻、蘇峻等深懷憂慮，不謀同辭。都邑大小及二宮宿衛咸懼有往年之掠，不復保其妻孥，是以聖主發赫斯之命，具如檄旨。近有嘉詔，崇兄八命，望兄獎群賢忠義之心，抑奸細不逞之計，當還武昌，盡力籓任。卒奉來告，乃承與犬羊俱下，雖當逼近，猶以罔然。兄立身率素，見信明于門宗，年逾耳順，位極人臣，仲玉、安期亦不足作佳少年，本來門戶，良可惜也！","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","source_position":{"first_line":67,"last_line":67,"revision_id":2614273,"raw_projection_ref":"source-evidence/jin098-wangdun-comparison/projection.json","raw_file_sha256":"019eb1b16d5b12d4fac53fe1c94cb23ef4794434faa88ce8222576f948f4ca36","unit_key":"p029","source_layer":"received_chapter"},"mentions":[{"id":"c-jinshu-098-wangdun-comparison:p029:m0002","start":2,"end":5,"surface":"大將軍","person_id":"7r6_k52_qji_ABBA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p029:m0029","start":29,"end":31,"surface":"錢鳳","person_id":"762_5c8_663","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p029:m0057","start":57,"end":59,"surface":"征北","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"書信中指某征北將軍，未獲具名/官序橋；不按最近人或同字直接接合。"},{"id":"c-jinshu-098-wangdun-comparison:p029:m0061","start":61,"end":63,"surface":"劉遐","person_id":"urj_fo1_bu5","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p029:m0064","start":64,"end":66,"surface":"陶瞻","person_id":"5r7_x6g_gtf","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p029:m0067","start":67,"end":69,"surface":"蘇峻","person_id":"lrg_cze_g1l","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p029:m0106","start":106,"end":108,"surface":"聖主","person_id":"dkn_ge4_286_AAAAAAAA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p029:m0125","start":125,"end":126,"surface":"兄","person_id":"mwc_md4_l0g","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p029:m0130","start":130,"end":131,"surface":"兄","person_id":"mwc_md4_l0g","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p029:m0180","start":180,"end":181,"surface":"兄","person_id":"mwc_md4_l0g","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p029:m0203","start":203,"end":205,"surface":"仲玉","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"含家少年稱字；候選含子瑜，未取得明字橋"},{"id":"c-jinshu-098-wangdun-comparison:p029:m0206","start":206,"end":208,"surface":"安期","person_id":"mwc_md4_l0g_A","kind":"person"}],"chapter_id":"c-jinshu-098-wangdun-comparison","book_id":"b-jinshu-098","work_id":"w-jinshu","source_id":"s-jinshu098-wangdun-ws2614273-comparison"},{"id":"c-jinshu-098-wangdun-comparison:p032","text":"夫福如反手，用之即是。導所統六軍，石頭萬五千人，宮內後苑二萬人，護軍屯金城六千人，劉遐已至，征北昨已濟江萬五千人。以天子之威，文武畢力，豈可當乎！事猶可追，兄早思之。大兵一奪，導以為灼炟也。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","source_position":{"first_line":73,"last_line":73,"revision_id":2614273,"raw_projection_ref":"source-evidence/jin098-wangdun-comparison/projection.json","raw_file_sha256":"019eb1b16d5b12d4fac53fe1c94cb23ef4794434faa88ce8222576f948f4ca36","unit_key":"p032","source_layer":"received_chapter"},"mentions":[{"id":"c-jinshu-098-wangdun-comparison:p032:m0011","start":11,"end":12,"surface":"導","person_id":"7r6_k52_qji_ABAA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p032:m0041","start":41,"end":43,"surface":"劉遐","person_id":"urj_fo1_bu5","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p032:m0046","start":46,"end":48,"surface":"征北","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"書信中指某征北將軍，未獲具名/官序橋；不按最近人或同字直接接合。"},{"id":"c-jinshu-098-wangdun-comparison:p032: