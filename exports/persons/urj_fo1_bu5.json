,"work_id":"w-jinshu","book_id":"b-jinshu-098","source_id":"s-jinshu098-wangdun-ws2614273-comparison"}],"mentions":[{"id":"c-jinshu-098-wangdun-comparison:p024:m0042","start":42,"end":43,"surface":"遐","person_id":"urj_fo1_bu5","kind":"person","paragraph_id":"c-jinshu-098-wangdun-comparison:p024","chapter_id":"c-jinshu-098-wangdun-comparison"},{"id":"c-jinshu-098-wangdun-comparison:p029:m0061","start":61,"end":63,"surface":"劉遐","person_id":"urj_fo1_bu5","kind":"person","paragraph_id":"c-jinshu-098-wangdun-comparison:p029","chapter_id":"c-jinshu-098-wangdun-comparison"},{"id":"c-jinshu-098-wangdun-comparison:p032:m0041","start":41,"end":43,"surface":"劉遐","person_id":"urj_fo1_bu5","kind":"person","paragraph_id":"c-jinshu-098-wangdun-comparison:p032","chapter_id":"c-jinshu-098-wangdun-comparison"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-098-wangdun-comparison:p024","text":"今遣司徒導，鎮南將軍、丹陽尹嶠，建威將軍趙胤武旅三萬，十道並進；平西將軍邃率兗州刺史遐、奮武將軍峻、奮威將軍贍精銳三萬，水陸齊勢；朕親禦六軍，左衛將軍亮，右衛將軍胤，護軍將軍詹，領軍將軍瞻，中軍將軍壺，驍騎將軍艾，驃騎將軍、南頓王宗，鎮軍將軍、汝南王祐，太宰、西陽王羕被練三千，組甲三萬，總統諸軍，討鳳之罪。罪止一人，朕不濫刑。有能殺鳳送首，封五千戶侯，賞布五千匹。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","source_position":{"first_line":57,"last_line":57,"revision_id":2614273,"raw_projection_ref":"source-evidence/jin098-wangdun-comparison/projection.json","raw_file_sha256":"019eb1b16d5b12d4fac53fe1c94cb23ef4794434faa88ce8222576f948f4ca36","unit_key":"p024","source_layer":"received_chapter"},"mentions":[{"id":"c-jinshu-098-wangdun-comparison:p024:m0004","start":4,"end":5,"surface":"導","person_id":"7r6_k52_qji_ABAA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p024:m0014","start":14,"end":15,"surface":"嶠","person_id":"6v8_pk9_7k5","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p024:m0020","start":20,"end":22,"surf