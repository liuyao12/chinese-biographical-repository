hapter_id":"c-shiji-052-qidaohui","source_id":"s-shiji-052-qidaohui","paragraph_id":"c-shiji-052-qidaohui:p024","quote":"後一歲，孝文帝以所封悼惠王子分齊為王，齊孝王將閭以悼惠王子楊虛侯為齊王。故齊別郡盡以王悼惠王子：子志為濟北王，子辟光為濟南王，子賢為菑川王，子卬為膠西王，子雄渠為膠東王，與城陽、齊凡七王。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予、任事、提議、回敘及用稱分開；年號僅留原語，不反算公曆起訖。朱虛、東牟許封趙梁而未實現不記實授，死亡不自動終止全部稱號。章與興居授王兩處年表述各留原段，不擅調和。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji052-072","person_id":"cbr-p003248","title":"白石侯","kind":"noble_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-052-qidaohui","source_id":"s-shiji-052-qidaohui","paragraph_id":"c-shiji-052-qidaohui:p043","quote":"膠東王雄渠，齊悼惠王子，以白石侯文帝十六年為膠東王。十一年，與吳楚反，漢擊破，殺雄渠，地入于漢，為膠東郡。"}],"attestations":[{"id":"th-shiji052-072:a001","paragraph_id":"c-shiji-052-qidaohui:p043","start":13,"end":16,"surface":"白石侯","person_mention_id":"c-shiji-052-qidaohui:m043-0000","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予、任事、提議、回敘及用稱分開；年號僅留原語，不反算公曆起訖。朱虛、東牟許封趙梁而未實現不記實授，死亡不自動終止全部稱號。章與興居授王兩處年表述各留原段，不擅調和。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji052-073","person_id":"cbr-p003248","title":"膠東王","kind":"royal_rank","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-052-qidaohui","source_id":"s-shiji-052-qidaohui","paragraph_id":"c-shiji-052-qidaohui:p043","quote":"膠東王雄渠，齊悼惠王子，以白石侯文帝十六年為膠東王。十一年，與吳楚反，漢擊破，殺雄渠，地入于漢，為膠東郡。"}],"attestations":[{"id":"th-shiji052-073:a001","paragraph_id":"c-shiji-052-qidaohui:p043","start":22,"end":25,"surface":"膠東王","person_mention_id":"c-shiji-052-qidaohui:m043-0040","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":"文帝十六年","evidence":[{"chapter_id":"c-shiji-052-qidaohui","source_id":"s-shiji-052-qidaohui","paragraph_id":"c-shiji-052-qidaohui:p043","quote":"膠東王雄渠，齊悼惠王子，以白石侯文帝十六年為膠東王。十一年，與吳楚反，漢擊破，殺雄渠，地入于漢，為膠東郡。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予、任事、提議、回敘及用稱分開；年號僅留原語，不反算公曆起訖。朱虛、東牟許封趙梁而未實現不記實授，死亡不自動終止全部稱號。章與興居授王兩處年表述各留原段，不擅調和。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji052-035","person_id":"cbr-p003248","surfaces":["膠東王雄渠","雄渠"],"scope":"same_chapter","chapter_ids":["c-shiji-052-qidaohui"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-052-qidaohui:p024","quote":"後一歲，孝文帝以所封悼惠王子分齊為王，齊孝王將閭以悼惠王子楊虛侯為齊王。故齊別郡盡以王悼惠王子：子志為濟北王，子辟光為濟南王，子賢為菑川王，子卬為膠西王，子雄渠為膠東王，與城陽、齊凡七王。"},{"paragraph_id":"c-shiji-052-qidaohui:p043","quote":"膠東王雄渠，齊悼惠王子，以白石侯文帝十六年為膠東王。十一年，與吳楚反，漢擊破，殺雄渠，地入于漢，為膠東郡。"},{"paragraph_id":"c-shiji-052-qidaohui:p045","quote":"漢矯秦制，樹屏自彊。表海大國，悉封齊王。呂後肆怒，乃獻城陽。哀王嗣立，其力不量。硃虛仕漢，功大策長。東牟受賞，稱亂貽殃。膠東、濟北，雄渠，辟光。齊雖七國，忠孝者昌。"}],"rationale":"依明示名與王國、世次的局部敘事暫接；齊、城陽與菑川同諡者分開，興居與志分開。校勘建延及內史勳士未擅選讀法，未名帝后不補姓名，案件只保存來源敘事。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji052-xiongqu","person_ids":["cbr-p000928","cbr-p003248"],"canonical_person_id":"cbr-p000928","scope":"cross_chapter","chapter_ids":["c-shiji-011-jingdi","c-shiji-052-qidaohui"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-011-jingdi","source_id":"s-shiji-011-jingdi","paragraph_id":"c-shiji-011-jingdi:p004","quote":"三年正月乙巳，赦天下。長星出西方。天火燔雒陽東宮大殿城室。吳王濞、楚王戊、趙王遂、膠西王卬、濟南王辟光、菑川王賢、膠東王雄渠反，發兵西鄉。天子為誅晁錯，遣袁盎諭告，不止，遂西圍梁。上乃遣大將軍竇嬰、太尉周亞夫將兵誅之。六月乙亥。赦亡軍及楚元王子藝等與謀反者。封大將軍竇嬰為魏其侯。立楚元王子平陸侯禮為楚王。立皇子端為膠西王，子勝為中山王。徙濟北王志為菑川王，淮陽王餘為魯王，汝南王非為江都王。齊王將廬、燕王嘉皆薨。","mention_ids":["c-shiji-011-jingdi:m004-0057"]},{"chapter_id":"c-shiji-052-qidaohui","source_id":"s-shiji-052-qidaohui","paragraph_id":"c-shiji-052-qidaohui:p043","quote":"膠東王雄渠，齊悼惠王子，以白石侯文帝十六年為膠東王。十一年，與吳楚反，漢擊破，殺雄渠，地入于漢，為膠東郡。","mention_ids":["c-shiji-052-qidaohui:m043-0000","c-shiji-052-qidaohui:m043-0040"]}],"rationale":"同記膠東王雄渠與吳楚叛軍角色。 已發ID、文字與來源年表述保留，不選定史實或年代優先；同書篇文不視為已證實獨立見證。","reviewer":"C