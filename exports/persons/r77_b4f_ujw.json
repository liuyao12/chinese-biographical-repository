atus":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-025","chapter_id":"c-nanshi-025-wangyi","source_id":"s-nanshi-025-wangyi-ws12757141","paragraph_id":"c-nanshi-025-wangyi:p004","quote":"武帝伐廣固，仲德為前驅，戰輒破之，大小二十餘戰。盧循寇逼，眾議並欲遷都，仲德正色曰：「今天子當陽南面，明公命世作輔，新建大功，威震六合。祅寇豕突，恃我遠征，既聞凱入，將自奔散。今日投草莽則同匹夫，匹夫號令，何以威物？此謀若立，請從此辭。」帝悅。及武帝與循戰于左裏，仲德功冠諸將，封新淦縣侯。義熙十二年北伐，進仲德征虜將軍，加冀州刺史，督前鋒諸軍事。冠軍將軍檀道濟、龍驤將軍王鎮惡向洛陽，甯朔將軍劉遵考、建武將軍沈林子出石門，甯朔將軍朱超石、胡藩向半城，咸受統于仲德。仲德率龍驤將軍朱牧、甯遠將軍竺靈秀、嚴綱等開钜野入河，乃總眾軍進據潼關。長安平，以仲德為太尉諮議參軍。","person_mention_id":"c-nanshi-025-wangyi:p004:m0240"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"th-song046-wangyi-ws-31-91","person_id":"r77_b4f_ujw","title":"龍驤將軍","kind":"office","mode":"attestation","attestations":[{"id":"th-song046-wangyi-ws-31-91:a","paragraph_id":"c-songshu-046-wangyi-ws:p006","start":91,"end":95,"surface":"龍驤將軍","person_mention_id":"c-songshu-046-wangyi-ws:p006:m0095","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-046","chapter_id":"c-songshu-046-wangyi-ws","source_id":"s-songshu-046-wangyi-ws-ws2118581","paragraph_id":"c-songshu-046-wangyi-ws:p006","quote":"義熙十二年北伐，進仲德征虜將軍，加冀州刺史，為前鋒諸軍事。冠軍將軍檀道濟、龍驤將軍王鎮惡向洛陽，寧朔將軍劉遵考、建武將軍沈林子出石門，寧朔將軍朱超石、胡藩向半城，咸受統於仲德。仲德率龍驤將軍朱牧、寧遠將軍竺靈秀、嚴綱等開鉅野入河，乃總眾軍，進據潼關。長安平，以仲德為太尉諮議參軍。","person_mention_id":"c-songshu-046-wangyi-ws:p006:m0095"}],"status":"source_attested","interpretation_note":"本句所載官名，任期無確切年月。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"th-songshu-048-zhulingshi-7-50","title":"龍驤將軍","kind":"office","mode":"attestation","person_id":"r77_b4f_ujw","attestations":[{"id":"th-songshu-048-zhulingshi-7-50:a","paragraph_id":"c-songshu-048-zhulingshi:p007","start":50,"end":54,"surface":"龍驤將軍","person_mention_id":"c-songshu-048-zhulingshi:p007:m0054","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-048","chapter_id":"c-songshu-048-zhulingshi","source_id":"s-songshu-048-zhulingshi-ws1791560","paragraph_id":"c-songshu-048-zhulingshi:p007","quote":"九年，遣諸軍伐蜀，令齡石為元帥，以為建威將軍、益州刺史，率寧朔將軍臧熹、河間太守蒯恩、下邳太守劉鍾、龍驤將軍朱林等，凡二萬人，發自江陵。尋加節益州諸軍事。初，高祖與齡石密謀進取，曰：「劉敬宣往年出黃虎，無功而退。賊謂我今應從外水往，而料我當出其不意，猶從內水來也。如此，必以重兵守涪城，以備內道。若向黃虎，正陊其計。今以大眾自外水取成都，疑兵出內水，此制敵之奇也。」而慮此聲先馳，賊審虛實，別有函書，全封付齡石，署函邊曰：「至白帝乃開。」諸軍雖進，未知處分所由。至白帝，發書，曰：「眾軍悉從外水取成都，臧熹、朱林於中水取廣漢，使羸弱乘高艦十餘，由內水向黃虎。」眾軍乃倍道兼行，譙縱果備內水，使其大將譙道福以重兵戍涪城，遣其前將軍秦州刺史侯輝、尚書僕射蜀郡太守譙詵等率眾萬餘屯彭模，夾水為城。","person_mention_id":"c-songshu-048-zhulingshi:p007:m0054"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanshi-025-wangyi:p004","text":"武帝伐廣固，仲德為前驅，戰輒破之，大小二十餘戰。盧循寇逼，眾議並欲遷都，仲德正色曰：「今天子當陽南面，明公命世作輔，新建大功，威震六合。祅寇豕突，恃我遠征，既聞凱入，將自奔散。今日投草莽則同匹夫，匹夫號令，何以威物？此謀若立，請從此辭。」帝悅。及武帝與循戰于左裏，仲德功冠諸將，封新淦縣侯。義熙十二年北伐，進仲德征虜將軍，加冀州刺史，督前鋒諸軍事。冠軍將軍檀道濟、龍驤將軍王鎮惡向洛陽，甯朔將軍劉遵考、建武將軍沈林子出石門，甯朔將軍朱超石、胡藩向半城，咸受統于仲德。仲德率龍驤將軍朱牧、甯遠將軍竺靈秀、嚴綱等開钜野入河，乃總眾軍進據潼關。長安平，以仲德為太尉諮議參軍。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":19,"last_line":19,"raw_start":694,"raw_end":978,"raw_character_offsets":[694,695,696,697,698,699,700,701,702,703,704,705,706,707,708,709,710,711,712,713,714,715,716,717,718,719,720,721,722,723,724,725,726,727,728,729,730,731,732,733,734,735,736,737,738,739,740,741,742,743,744,745,746,747,748,749,750,751,752,753