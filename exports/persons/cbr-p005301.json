{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p005301","identity_policy":"contextual_provisional","person_ids":["cbr-p005301"],"persons":[{"id":"cbr-p005301","label":"太上皇未詳名（樊酈滕灌列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"太上皇","mention_ids":["c-shiji-095-fankuang:m013-0147"]}],"evidence":[{"mention_id":"c-shiji-095-fankuang:m013-0147","chapter_id":"c-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p013","quote":"太上皇"}]}],"source_mention_summary":[{"source_id":"s-shiji-095-fankuang","work_id":"w-shiji","book_id":"b-shiji-095","chapter_id":"c-shiji-095-fankuang","mention_count":1,"mention_ids":["c-shiji-095-fankuang:m013-0147"],"paragraph_ids":["c-shiji-095-fankuang:p013"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-095-fankuang"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-095-fankuang:m013-0147","start":147,"end":150,"surface":"太上皇","kind":"person","person_id":"cbr-p005301","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p013","chapter_id":"c-shiji-095-fankuang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji095-051","person_id":"cbr-p005301","scope":"same_chapter","chapter_ids":["c-shiji-095-fankuang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["太上皇"],"evidence":[{"paragraph_id":"c-shiji-095-fankuang:p013","quote":"項羽既已死，漢王為帝。其秋，燕王臧荼反，商以將軍從擊荼，戰龍脫，先登陷陣，破荼軍易下，卻敵，遷為右丞相，賜爵列侯，與諸侯剖符，世世勿絕，食邑涿五千戶，號曰涿侯。以右丞相別定上谷，因攻代，受趙相國印。以右丞相趙相國別與絳侯等定代、鴈門，得代丞相程縱、守相郭同、將軍已下至六百石十九人。還，以將軍為太上皇衛一歲七月。以右丞相擊陳豨，殘東垣。又以右丞相從高帝擊黥布，攻其前拒，陷兩陳，得以破布軍，更食曲周五千一百戶，除前所食，凡別破軍三，降定郡六，縣七十三，得丞相、守相、大將各一人，小將二人，二千石已下至六百石十九人。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定異稱。酈寄字況據第14段；夏侯嬰的嬰限定第16至21段，灌嬰限定第22至33段，桓嬰另人。第6與20、28段楚王信和反韓王信分人；未詳名王侯不補名。同名跨篇同指另待逐項證據。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-095-fankuang:p013","text":"項羽既已死，漢王為帝。其秋，燕王臧荼反，商以將軍從擊荼，戰龍脫，先登陷陣，破荼軍易下，卻敵，遷為右丞相，賜爵列侯，與諸侯剖符，世世勿絕，食邑涿五千戶，號曰涿侯。以右丞相別定上谷，因攻代，受趙相國印。以右丞相趙相國別與絳侯等定代、鴈門，得代丞相程縱、守相郭同、將軍已下至六百石十九人。還，以將軍為太上皇衛一歲七月。以右丞相擊陳豨，殘東垣。又以右丞相從高帝擊黥布，攻其前拒，陷兩陳，得以破布軍，更食曲周五千一百戶，除前所食，凡別破軍三，降定郡六，縣七十三，得丞相、守相、大將各一人，小將二人，二千石已下至六百石十九人。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m013-0000","start":0,"end":2,"surface":"項羽","kind":"person","person_id":"cbr-p005258","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m013-0006","start":6,"end":8,"surface":"漢王","kind":"person","person_id":"cbr-p005253","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m013-0016","start":16,"end":18,"surface":"臧荼","kind":"person","person_id":"cbr-p005275","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m013-0020","start":20,"end":21,"surface":"商","kind":"person","person_id":"cbr-p005307","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m013-0026","start":26,"end":27,"surface":"荼","kind":"person","person_id":"cbr-p005275","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m013-0038","start":38,"end":39,"surface":"荼","kind":"person","person_id":"cbr-p005275","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m013-0108","start":108,"end":110,"surface":"絳侯","kind":"person","person_id":"cbr-p005276","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m013-0121","start":121,"end":123,"surface":"程縱","kind":"person","person_id":"cbr-p005312","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m013-0126","start":126,"end":128,"surface":"郭同","kind":"person","person_id":"cbr-p005313","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m013-0147","start":147,"end":150,"surface":"太上皇","kind":"person","person_id":"cbr-p005301","status":"contextual_provisional"},{"id":"c-shiji