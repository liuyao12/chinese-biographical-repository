tatus":"source_attested","evidence":[{"chapter_id":"c-shiji-008-gaozu","source_id":"s-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p069","quote":"廢趙王敖為宣平侯"}],"attestations":[{"id":"th-shiji008-026:a001","paragraph_id":"c-shiji-008-gaozu:p069","start":21,"end":24,"surface":"宣平侯","person_mention_id":"c-shiji-008-gaozu:m069-0017","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"demotion","date_expression":null,"evidence":[{"chapter_id":"c-shiji-008-gaozu","source_id":"s-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p069","quote":"廢趙王敖為宣平侯"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"有據事件與用稱分開；日期未換算，未知端點不等於無限延伸，不以死亡或首次用稱推造起訖。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji009-012","person_id":"cbr-p000787","surfaces":["張敖","敖"],"scope":"cross_chapter","chapter_ids":["c-shiji-008-gaozu","c-shiji-009-lvhou"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-008-gaozu:p054","quote":"皇帝曰義帝無後。齊王韓信習楚風俗，徙為楚王，都下邳。立建成侯彭越為梁王，都定陶。故韓王信為韓王，都陽翟。徙衡山王吳芮為長沙王，都臨湘。番君之將梅鋗有功，從入武關，故德番君。淮南王布、燕王臧荼、趙王敖皆如故。"},{"paragraph_id":"c-shiji-009-lvhou:p008","quote":"四月，太后欲侯諸呂，乃先封高祖之功臣郎中令無擇為博城侯。魯元公主薨，賜謚為魯元太后。子偃為魯王。魯王父，宣平侯張敖也。封齊悼惠王子章為朱虛侯，以呂祿女妻之。齊丞相壽為平定侯。少府延為梧侯。乃封呂種為沛侯，呂平為扶柳侯，張買為南宮侯。"},{"paragraph_id":"c-shiji-009-lvhou:p015","quote":"宣平侯張敖卒，以子偃為魯王，敖賜謚為魯元王。"},{"paragraph_id":"c-shiji-009-lvhou:p019","quote":"高后為外孫魯元王偃年少，蚤失父母，孤弱，乃封張敖前姬兩子，侈為新都侯，壽為樂昌侯，以輔魯元王偃。及封中大謁者張釋為建陵侯，呂榮為祝茲侯。諸中宦者令丞皆為關內侯，食邑五百戶。"}],"rationale":"僅在所列漢初帝后、分封、家族與接任敘事中暫定同指，前卷對讀依相接人物及事件；同名不作全庫替換規則，仍待可靠版本及異源覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-008-gaozu:p054","text":"皇帝曰義帝無後。齊王韓信習楚風俗，徙為楚王，都下邳。立建成侯彭越為梁王，都定陶。故韓王信為韓王，都陽翟。徙衡山王吳芮為長沙王，都臨湘。番君之將梅鋗有功，從入武關，故德番君。淮南王布、燕王臧荼、趙王敖皆如故。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m0