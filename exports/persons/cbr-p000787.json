_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m069-0005","start":5,"end":7,"surface":"貫高","kind":"person","person_id":"cbr-p000800","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m069-0017","start":17,"end":20,"surface":"趙王敖","kind":"person","person_id":"cbr-p000787","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m069-0031","start":31,"end":43,"surface":"楚昭、屈、景、懷、齊田氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、群體、校勘符號或未定指代；不補未見姓名或世系。"}],"chapter_id":"c-shiji-008-gaozu","book_id":"b-shiji-008","work_id":"w-shiji","source_id":"s-shiji-008-gaozu"},{"id":"c-shiji-009-lvhou:p008","text":"四月，太后欲侯諸呂，乃先封高祖之功臣郎中令無擇為博城侯。魯元公主薨，賜謚為魯元太后。子偃為魯王。魯王父，宣平侯張敖也。封齊悼惠王子章為朱虛侯，以呂祿女妻之。齊丞相壽為平定侯。少府延為梧侯。乃封呂種為沛侯，呂平為扶柳侯，張買為南宮侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-009-lvhou:m008-0003","start":3,"end":5,"surface":"太后","kind":"person","person_id":"cbr-p000717","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m008-0013","start":13,"end":15,"surface":"高祖","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m008-0018","start":18,"end":23,"surface":"郎中令無擇","kind":"person","person_id":"cbr-p000830","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m008-0028","start":28,"end":32,"surface":"魯元公主","kind":"person","person_id":"cbr-p000714","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m008-0037","start":37,"end":41,"surface":"魯元太后","kind":"person","person_id":"cbr-p000714","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m008-0043","start":43,"end":44,"surface":"偃","kind":"person","person_id":"cbr-p000831","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m008-0055","start":55,"end":57,"surface":"張敖","kind":"person","person_id":"cbr-p000787","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m008-0060","start":60,"end":64,"surface":"齊悼惠王","kind":"person",