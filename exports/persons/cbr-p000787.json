d":"b-shiji-009","work_id":"w-shiji","source_id":"s-shiji-009-lvhou"},{"id":"c-shiji-009-lvhou:p019","text":"高后為外孫魯元王偃年少，蚤失父母，孤弱，乃封張敖前姬兩子，侈為新都侯，壽為樂昌侯，以輔魯元王偃。及封中大謁者張釋為建陵侯，呂榮為祝茲侯。諸中宦者令丞皆為關內侯，食邑五百戶。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-009-lvhou:m019-0000","start":0,"end":2,"surface":"高后","kind":"person","person_id":"cbr-p000717","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m019-0005","start":5,"end":9,"surface":"魯元王偃","kind":"person","person_id":"cbr-p000831","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m019-0022","start":22,"end":24,"surface":"張敖","kind":"person","person_id":"cbr-p000787","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m019-0024","start":24,"end":26,"surface":"前姬","kind":"person","person_id":"cbr-p000865","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m019-0029","start":29,"end":30,"surface":"侈","kind":"person","person_id":"cbr-p000863","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m019-0035","start":35,"end":36,"surface":"壽","kind":"person","person_id":"cbr-p000864","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m019-0043","start":43,"end":47,"surface":"魯元王偃","kind":"person","person_id":"cbr-p000831","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m019-0054","start":54,"end":56,"surface":"張釋","kind":"person","person_id":"cbr-p000866","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m019-0061","start":61,"end":63,"surface":"呂榮","kind":"person","person_id":"cbr-p000867","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m019-0069","start":69,"end":74,"surface":"中宦者令丞","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定官稱；不補造姓名或把身世指控當定論。"}],"chapter_id":"c-shiji-009-lvhou","book_id":"b-shiji-009","work_id":"w-shiji","source_id":"s-shiji-009-lvhou"}],"sources":[{"chapter_id":"c-shiji-008-gaozu","work_id":"w-shiji","book_id":"b-shiji-008","source_i