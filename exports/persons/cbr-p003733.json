ph_id":"c-shiji-063-laohan:p009","chapter_id":"c-shiji-063-laohan"},{"id":"c-shiji-063-laohan:m010-0004","start":4,"end":6,"surface":"莊周","kind":"person","person_id":"cbr-p003733","status":"contextual_provisional","paragraph_id":"c-shiji-063-laohan:p010","chapter_id":"c-shiji-063-laohan"},{"id":"c-shiji-063-laohan:m010-0020","start":20,"end":22,"surface":"莊周","kind":"person","person_id":"cbr-p003733","status":"contextual_provisional","paragraph_id":"c-shiji-063-laohan:p010","chapter_id":"c-shiji-063-laohan"},{"id":"c-shiji-063-laohan:m026-0032","start":32,"end":34,"surface":"莊子","kind":"person","person_id":"cbr-p003733","status":"contextual_provisional","paragraph_id":"c-shiji-063-laohan:p026","chapter_id":"c-shiji-063-laohan"}],"relations":[],"title_holdings":[{"id":"th-shiji063-007","person_id":"cbr-p003733","title":"蒙漆園吏","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-063-laohan","source_id":"s-shiji-063-laohan","paragraph_id":"c-shiji-063-laohan:p009","quote":"莊子者，蒙人也，名周。周嘗為蒙漆園吏，與梁惠王、齊宣王同時。其學無所不闚，然其要本歸於老子之言。故其著書十餘萬言，大抵率寓言也。作漁父、盜跖、胠篋，以詆訿孔子之徒，以明老子之術。畏累虛、亢桑子之屬，皆空語無事實。然善屬書離辭，指事類情，用剽剝儒、墨，雖當世宿學不能自解免也。其言洸洋自恣以適己，故自王公大人不能器之。"}],"attestations":[{"id":"th-shiji063-007:a001","paragraph_id":"c-shiji-063-laohan:p009","start":14,"end":18,"surface":"蒙漆園吏","person_mention_id":"c-shiji-063-laohan:m009-0011","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"依來源用稱保存，公號與帝稱不當生前已授同字諡稱；引例保留敘事範圍，不據首次用稱或死亡補任期。制度未定用稱保留未分類。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji063-014","person_id":"cbr-p003733","surfaces":["周","莊周","莊子"],"scope":"same_chapter","chapter_ids":["c-shiji-063-laohan"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-063-laohan:p009","quote":"莊子者，蒙人也，名周。周嘗為蒙漆園吏，與梁惠王、齊宣王同時。其學無所不闚，然其要本歸於老子之言。故其著書十餘萬言，大抵率寓言也。作漁父、盜跖、胠篋，以詆訿孔子之徒，以明老子之術。畏累虛、亢桑子之屬，皆空語無事實。然善屬書離辭，指事類情，用剽剝儒、墨，雖當世宿學不能自解免也。其言洸洋自恣以適己，故自王公大人不能器之。"},{"paragraph_id":"c-shiji-063-laohan:p010","quote":"楚威王聞莊周賢，使使厚幣迎之，許以為相。莊周笑謂楚使者曰：「千金，重利；卿相，尊位也。子獨不見郊祭之犧牛乎？養食之數歲，衣以文繡，以入大廟。當是之時，雖欲為孤豚，豈可得乎？子亟去，無污我。我寧游戲污瀆之中自快，無為有國者所羈，終身不仕，以快吾志焉。」"},{"paragraph_id":"c-shiji-063-laohan:p026","quote":"太史公曰：老子所貴道，虛無，因應變化於無為，故著書辭稱微妙難識。莊子散道德，放論，要亦歸之自然。申子卑卑，施之於名實。韓子引繩墨，切事情，明是非，其極慘礉少恩。皆原於道德之意，而老子深遠矣。"}],"rationale":"依開篇姓名與敘事局部短稱暫接，未名引例人物不補名。老萊子及太史儋與老子分候選不表示確定不同，書名與否定非字不當人物提及，故事與身份確證分開。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-063-laohan:p009","text":"莊子者，蒙人也，名周。周嘗為蒙漆園吏，與梁惠王、齊宣王同時。其學無所不闚，然其要本歸於老子之言。故其著書十餘萬言，大抵率寓言也。作漁父、盜跖、胠篋，以詆訿孔子之徒，以明老子之術。畏累虛、亢桑子之屬，皆空語無事實。然善屬書離辭，指事類情，用剽剝儒、墨，雖當世宿學不能自解免也。其言洸洋自恣以適己，故自王公大人不能器之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-063-laohan:m009-0000","start":0,"end":2,"surface":"莊子","kind":"person","person_id":"cbr-p003733","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m009-0009","start":9,"end":10,"surface":"周","kind":"person","person_id":"cbr-p003733","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m009-0011","start":11,"end":12,"surface":"周","kind":"person","person_id":"cbr-p003733","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m009-0020","start":20,"end":23,"surface":"梁惠王","kind":"person","person_id":"cbr-p003734","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m009-0024","start":24,"end":27,"surface":"齊宣王","kind":"person","person_id":"cbr-p003735","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m009-0043","start":43,"end":45,"surface":"老子","kind":"person","person_id":"cbr-p003720","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m009-0077","start":77,"end":79,"surface":"孔子","kind":"person","person_id":"cbr-p003721","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m009-0084","start":84,"end":86,"surface":