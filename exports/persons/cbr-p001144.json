{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p001144","identity_policy":"contextual_provisional","person_ids":["cbr-p001144"],"persons":[{"id":"cbr-p001144","label":"王子城父","status":"active","historicity":"historical_tradition","aliases":[{"surface":"王子城父","mention_ids":["c-shiji-032-qi:m054-0009"]},{"surface":"齊王子城父","mention_ids":["c-shiji-033-lu:m055-0058"]}],"evidence":[{"mention_id":"c-shiji-032-qi:m054-0009","chapter_id":"c-shiji-032-qi","paragraph_id":"c-shiji-032-qi:p054","quote":"王子城父"},{"mention_id":"c-shiji-033-lu:m055-0058","chapter_id":"c-shiji-033-lu","paragraph_id":"c-shiji-033-lu:p055","quote":"齊王子城父"}]}],"mentions":[{"id":"c-shiji-032-qi:m054-0009","start":9,"end":13,"surface":"王子城父","kind":"person","person_id":"cbr-p001144","status":"contextual_provisional","paragraph_id":"c-shiji-032-qi:p054","chapter_id":"c-shiji-032-qi"},{"id":"c-shiji-033-lu:m055-0058","start":58,"end":63,"surface":"齊王子城父","kind":"person","person_id":"cbr-p001144","status":"contextual_provisional","paragraph_id":"c-shiji-033-lu:p055","chapter_id":"c-shiji-033-lu"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji033-059","person_id":"cbr-p001144","surfaces":["齊王子城父"],"scope":"cross_chapter","chapter_ids":["c-shiji-032-qi","c-shiji-033-lu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-032-qi:p054","quote":"惠公二年，長翟來，王子城父攻殺之，埋之於北門。晉趙穿弒其君靈公。"},{"paragraph_id":"c-shiji-033-lu:p055","quote":"初，宋武公之世，鄋瞞伐宋，司徒皇父帥師御之，以敗翟于長丘，獲長翟緣斯。晉之滅路，獲喬如弟棼如。齊惠公二年，鄋瞞伐齊，齊王子城父獲其弟榮如，埋其首於北門。衛人獲其季弟簡如。鄋瞞由是遂亡。"}],"rationale":"按懿公被弒至魯文公的敘事角色、同段明示子／弟與柯盟、齊襄公殺魯桓公、晉立惠公等具體事件暫定異稱；同字爵稱依國別分開。公子揮不與前篇公子翚、晉襄父不與晉襄公、宣伯不與叔孫宣伯自動合併。數位疑讀與親屬異說仍待核對。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-032-qi:p054","text":"惠公二年，長翟來，王子城父攻殺之，埋之於北門。晉趙穿弒其君靈公。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-032-qi:m054-0000","start":0,"end":2,"surface":"惠公","kind":"person","person_id":"cbr-p001133","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m054-0005","start":5,"end":7,"surface":"長翟","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、族稱或未定指代，不補未見姓名與成員；官禮等級不直接當授官。"},{"id":"c-shiji-032-qi:m054-0009","start":9,"end":13,"surface":"王子城父","kind":"person","person_id":"cbr-p001144","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m054-0024","start":24,"end":26,"surface":"趙穿","kind":"person","person_id":"cbr-p000411","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m054-0029","start":29,"end":31,"surface":"靈公","kind":"person","person_id":"cbr-p000412","status":"contextual_provisional"}],"chapter_id":"c-shiji-032-qi","book_id":"b-shiji-032","work_id":"w-shiji","source_id":"s-shiji-032-qi"},{"id":"c-shiji-033-lu:p055","text":"初，宋武公之世，鄋瞞伐宋，司徒皇父帥師御之，以敗翟于長丘，獲長翟緣斯。晉之滅路，獲喬如弟棼如。齊惠公二年，鄋瞞伐齊，齊王子城父獲其弟榮如，埋其首於北門。衛人獲其季弟簡如。鄋瞞由是遂亡。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-033-lu:m055-0002","start":2,"end":5,"surface":"宋武公","kind":"person","person_id":"cbr-p001255","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m055-0008","start":8,"end":10,"surface":"鄋瞞","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未指名者、地點氏稱、未定官稱或未解指代；不補姓名、成員與父系。"},{"id":"c-shiji-033-lu:m055-0013","start":13,"end":17,"surface":"司徒皇父","kind":"person","person_id":"cbr-p001256","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m055-0030","start":30,"end":34,"surface":"長翟緣斯","kind":"person","person_id":"cbr-p001257","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m055-0041","start":41,"end":43,"surface":"喬如","kind":"person","person_id":"cbr-p001252","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m055-0044","start":44,"end":46,"surface":"棼如","kind":"person","person_id":"cbr-p001258","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m055-0047","sta