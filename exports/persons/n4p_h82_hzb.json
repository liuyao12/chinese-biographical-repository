_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-wu056-zhuhuan0","person_id":"n4p_h82_hzb","event_type":"death","source_term":"遂梟雕","date_expression":null,"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-056","chapter_id":"c-sanguozhi-056-zhuhuan","source_id":"s-sanguozhi-056-zhuhuan","paragraph_id":"c-sanguozhi-056-zhuhuan:line061","quote":"　　黃武元年，魏使大司馬曹仁步騎數萬向濡須，仁欲以兵襲取州上，偽先揚聲欲東攻羨溪；桓分兵將赴羨溪，既發，卒得仁進軍拒濡須七十里問。桓遣使追還羨溪兵，兵未到而仁奄至。時桓手下及所部兵，在者五千人，諸將業業，各有懼心，桓喻之曰：「凡兩軍交對，勝負在將，不在眾寡。諸君聞曹仁用兵行師，孰與桓邪？兵法所以稱客倍而主人半者，謂俱在平原。無城池之守，又謂士眾勇怯齊等故耳。今人既非智勇，加其士卒甚怯，又千里步涉，人馬罷困，桓與諸軍。共據高城，南臨大江，北背山陵，以逸待勞，為主制客，此百戰百勝之勢也。雖曹丕自來，尚不足憂，況仁等邪！」桓因偃旗鼓，外示虛弱，以誘致仁。仁果遣其子泰攻濡須城，分遣將軍常雕督諸葛虔、王雙等，乘油船別襲中洲。中洲者，部曲妻子所在也。仁自將萬人留橐皋，復為泰等後拒。桓部兵將攻取油船，或別擊雕等，桓等身自拒泰，燒營而退，遂梟雕，生虜雙，送武昌，臨陳斬溺死者千餘。權嘉桓功，封嘉興侯，遷奮武將軍，領彭城相。","person_mention_id":"c-sanguozhi-056-zhuhuan:line061:m0292"}],"interpretation_note":"本來源所記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-sanguozhi-056-zhuhuan:line061:m0292","start":292,"end":294,"surface":"常雕","kind":"person","person_id":"n4p_h82_hzb","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-056-zhuhuan:line061","chapter_id":"c-sanguozhi-056-zhuhuan"},{"id":"c-sanguozhi-056-zhuhuan:line061:m0351","start":351,"end":352,"surface":"雕","kind":"person","person_id":"n4p_h82_hzb","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-056-zhuhuan:line061","chapter_id":"c-sanguozhi-056-zhuhuan"},{"id":"c-sanguozhi-056-zhuhuan:line061:m0368","start":368,"end":369,"surface":"雕","kind":"person","person_id":"n4p_h82_hzb","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-056-zhuhuan:line061","chapter_id":"c-sanguozhi-056-zhuhuan"},{"id":"c-sanguozhi-057-luotong:line071:m0029","start":29,"end":31,"surface":"常雕","kind":"person","person_id