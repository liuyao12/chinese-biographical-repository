:{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-007-xiangyu:m024-0048","start":48,"end":51,"surface":"蕭公角","kind":"person","person_id":"cbr-p000711","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p024","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-007-xiangyu:m024-0059","start":59,"end":62,"surface":"蕭公角","kind":"person","person_id":"cbr-p000711","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p024","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-008-gaozu:m028-0118","start":118,"end":121,"surface":"蕭公角","kind":"person","person_id":"cbr-p000711","status":"contextual_provisional","paragraph_id":"c-shiji-008-gaozu:p028","chapter_id":"c-shiji-008-gaozu"},{"id":"c-shiji-090-wei:m007-0097","start":97,"end":100,"surface":"蕭公角","kind":"person","person_id":"cbr-p005039","status":"contextual_provisional","paragraph_id":"c-shiji-090-wei:p007","chapter_id":"c-shiji-090-wei"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji008-051","person_id":"cbr-p000711","surfaces":["蕭公角"],"scope":"cross_chapter","chapter_ids":["c-shiji-007-xiangyu","c-shiji-008-gaozu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-007-xiangyu:p024","quote":"是時，漢還定三秦。項羽聞漢王皆已并關中，且東，齊、趙叛之：大怒。乃以故吳令鄭昌為韓王，以距漢。令蕭公角等擊彭越。彭越敗蕭公角等。漢使張良徇韓，乃遺項王書曰：「漢王失職，欲得關中，如約即止，不敢東。」又以齊、梁反書遺項王曰：「齊欲與趙并滅楚。」楚以此故無西意，而北擊齊。徵兵九江王布。布稱疾不往，使將將數千人行。項王由此怨布也。漢之二年冬，項羽遂北至城陽，田榮亦將兵會戰。田榮不勝，走至平原，平原民殺之。遂北燒夷齊城郭室屋，皆阬田榮降卒，系虜其老弱婦女。徇齊至北海，多所殘滅。齊人相聚而叛之。於是田榮弟田橫收齊亡卒得數萬人，反城陽。項王因留，連戰未能下。"},{"paragraph_id":"c-shiji-008-gaozu:p028","quote":"項羽出關，使人徙義帝。曰：「古之帝者地方千里，必居上游。」乃使使徙義帝長沙郴縣，趣義帝行，群臣稍倍叛之，乃陰令衡山王、臨江王擊之，殺義帝江南。項羽怨田榮，立齊將田都為齊王。田榮怒，因自立為齊王，殺田都而反楚；予彭越將軍印，令反梁地。楚令蕭公角擊彭越，彭越大破之。陳餘怨項羽之弗王己也，令夏說說田榮，請兵擊張耳。齊予陳餘兵，擊破常山王張耳，張耳亡歸漢。迎趙王歇於代，復立為趙王。趙王因立陳餘為代王。項羽大怒，北擊齊。"}],"rationale":"只在所列原句的秦末楚漢軍事／分封敘事內暫定同指；有前卷錨點時對讀相接事件，不把同名作全庫匹配規則，仍待異源覆核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji090-007","person_id":"cbr-p005039","surfaces":["蕭公角"],"scope":"same_chapter","chapter_ids":["c-shiji-090-wei"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-090-wei:p007","quote":"沛公之從碭北擊昌邑，彭越助之。昌邑未下，沛公引兵西。彭越亦將其眾居鉅野中，收魏散卒。項籍入關，王諸侯，還歸，彭越眾萬餘人毋所屬。漢元年秋，齊王田榮畔項王，乃使人賜彭越將軍印，使下濟陰以擊楚。楚命蕭公角將兵擊越，越大破楚軍。漢王二年春，與魏王豹及諸侯東擊楚，彭越將其兵三萬餘人歸漢於外黃。漢王曰：「彭將軍收魏地得十餘城，欲急立魏後。今西魏王豹亦魏王咎從弟也，真魏後。」乃拜彭越為魏相國，擅將其兵，略定梁地。"}],"rationale":"依同段及連續事件明示姓名與用稱暫接，仲按字仲與述贊承接；秦漢用稱不全域替換，未名者不補姓名。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji090-xiao","person_ids":["cbr-p000711","cbr-p005039"],"canonical_person_id":"cbr-p000711","scope":"cross_chapter","chapter_ids":["c-shiji-008-gaozu","c-shiji-090-wei"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-008-gaozu","source_id":"s-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p028","quote":"項羽出關，使人徙義帝。曰：「古之帝者地方千里，必居上游。」乃使使徙義帝長沙郴縣，趣義帝行，群臣稍倍叛之，乃陰令衡山王、臨江王擊之，殺義帝江南。項羽怨田榮，立齊將田都為齊王。田榮怒，因自立為齊王，殺田都而反楚；予彭越將軍印，令反梁地。楚令蕭公角擊彭越，彭越大破之。陳餘怨項羽之弗王己也，令夏說說田榮，請兵擊張耳。齊予陳餘兵，擊破常山王張耳，張耳亡歸漢。迎趙王歇於代，復立為趙王。趙王因立陳餘為代王。項羽大怒，北擊齊。","mention_ids":["c-shiji-008-gaozu:m028-0118"]},{"chapter_id":"c-shiji-090-wei","source_id":"s-shiji-090-wei","paragraph_id":"c-shiji-090-wei:p007","quote":"沛公之從碭北擊昌邑，彭越助之。昌邑未下，沛公引兵西。彭越亦將其眾居鉅野中，收魏散卒。項籍入關，王諸侯，還歸，彭越眾萬餘人毋所屬。漢元年秋，齊王田榮畔項王，乃使人賜彭越將軍印，使下濟陰以擊楚。楚命蕭公角將兵擊越，越大破楚軍。漢王二年春，與魏王豹及諸侯東擊楚，彭越將其兵三萬餘人歸漢於外黃。漢王曰：「彭將軍收魏地得十餘城，欲急立魏後。今西魏王豹亦魏王咎從弟也，真魏後。」乃拜彭越為魏相國，擅將其兵，略定梁地。","mention_ids":["c-shiji-090-wei:m007-0097"]}],"rationale":"楚令蕭公角擊彭越而敗的特定事件相配。 各篇原字、原文與已發ID保留，同書不視為獨立見證；同指不確證所有紀年、任職、親屬或敘事，不按全域同名批量改號。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-007-xiangyu:p024","text":"是時，漢還定三秦。項羽聞漢王皆已并關中，且東，齊、趙叛之：大怒。乃以故吳令鄭昌為韓王，以距漢。令蕭公角等擊彭越。彭越敗蕭公角等。漢使張良徇韓，乃遺項王書曰：「漢王失職，欲得關中，如約即止，不敢東。」又以齊、梁反書遺項王曰：「齊欲與趙并滅楚。」楚以此故無西意，而北擊齊。徵兵九江王布。布稱疾不往，使將將數千人行。項王由此怨布也。漢之二年冬，項羽遂北至城陽，田榮亦將兵會戰。田榮不勝，走至平原，平原民殺之。遂北燒夷齊城郭室