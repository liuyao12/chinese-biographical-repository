":169,"end":171,"surface":"張耳","kind":"person","person_id":"cbr-p000676","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m028-0176","start":176,"end":179,"surface":"趙王歇","kind":"person","person_id":"cbr-p000674","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m028-0192","start":192,"end":194,"surface":"陳餘","kind":"person","person_id":"cbr-p000675","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m028-0198","start":198,"end":200,"surface":"項羽","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"}],"chapter_id":"c-shiji-008-gaozu","book_id":"b-shiji-008","work_id":"w-shiji","source_id":"s-shiji-008-gaozu"},{"id":"c-shiji-090-wei:p007","text":"沛公之從碭北擊昌邑，彭越助之。昌邑未下，沛公引兵西。彭越亦將其眾居鉅野中，收魏散卒。項籍入關，王諸侯，還歸，彭越眾萬餘人毋所屬。漢元年秋，齊王田榮畔項王，乃使人賜彭越將軍印，使下濟陰以擊楚。楚命蕭公角將兵擊越，越大破楚軍。漢王二年春，與魏王豹及諸侯東擊楚，彭越將其兵三萬餘人歸漢於外黃。漢王曰：「彭將軍收魏地得十餘城，欲急立魏後。今西魏王豹亦魏王咎從弟也，真魏後。」乃拜彭越為魏相國，擅將其兵，略定梁地。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-090-wei:m007-0000","start":0,"end":2,"surface":"沛公","kind":"person","person_id":"cbr-p005049","status":"contextual_provisional"},{"id":"c-shiji-090-wei:m007-0010","start":10,"end":12,"surface":"彭越","kind":"person","person_id":"cbr-p005038","status":"contextual_provisional"},{"id":"c-shiji-090-wei:m007-0020","start":20,"end":22,"surface":"沛公","kind":"person","person_id":"cbr-p005049","status":"contextual_provisional"},{"id":"c-shiji-090-wei:m007-0026","start":26,"end":28,"surface":"彭越","kind":"person","person_id":"cbr-p005038","status":"contextual_provisional"},{"id":"c-shiji-090-wei:m007-0042","start":42,"end":44,"surface":"項籍","kind":"person","person_id":"cbr-p005048","status":"contextual_provisional"},{"id":"c-shiji-090-wei:m007-0054","start":54,"end":56,"surface":"彭越","kind":"person","person_id":"cbr-p005038","status":"contextual_provisional"},{"id":"c-shiji-090-wei:m007-0069","start":69,"end":73,"surface":"齊王田榮","kind":"person","person_id":"cbr-p005034","status":"