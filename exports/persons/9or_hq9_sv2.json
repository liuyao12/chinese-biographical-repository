nreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-089-jishao:p007:m0009","start":9,"end":11,"surface":"秦准","kind":"person","person_id":"9or_hq9_sv2","status":"contextual_provisional","interpretation_note":"依完整本傳敘事／引語主語辨識，不以最近姓名機械延續。","paragraph_id":"c-jinshu-089-jishao:p007","chapter_id":"c-jinshu-089-jishao"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-089-jishao:p007","text":"初，紹之行也，侍中秦准謂曰：「今日向難，卿有佳馬否？」紹正色曰：「大駕親征，以正伐逆，理必有征無戰。若使皇輿失守，臣節有在，駿馬何為！」聞者莫不歎息。及張方逼帝遷長安，河間王顒表贈紹司空，進爵為公。會帝還洛陽，事遂未行。東海王越屯許，路經滎陽，過紹墓，哭之悲慟，刊石立碑，又表贈官爵。帝乃遣使冊贈侍中、光祿大夫，加金章紫綬，進爵為侯，賜墓田一頃，客十戶，祠以少牢。元帝為左丞相，承制，以紹死節事重，而贈禮未副勳德，更表贈太尉，祠乙太牢。及帝即位，賜諡曰忠穆，復加太牢之祠。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-jinshu-089-jishao:p007:m0002","start":2,"end":3,"surface":"紹","kind":"person","person_id":"6fg_r6l_5a5_A","status":"contextual_provisional","interpretation_note":"依完整本傳敘事／引語主語辨識，不以最近姓名機械延續。"},{"id":"c-jinshu-089-jishao:p007:m0009","start":9,"end":11,"surface":"秦准","kind":"person","person_id":"9or_hq9_sv2","status":"contextual_provisional","interpretation_note":"依完整本傳敘事／引語主語辨識，不以最近姓名機械延續。"},{"id":"c-jinshu-089-jishao:p007:m0020","start":20,"end":21,"surface":"卿","kind":"person","person_id":"6fg_r6l_5a5_A","status":"contextual_provisional","interpretation_note":"依完整本傳敘事／引語主語辨識，不以最近姓名機械延續。"},{"id":"c-jinshu-089-jishao:p007:m0027","start":27,"end":28,"surface":"紹","kind":"person","person_id":"6fg_r6l_5a5_A","status":"contextual_provisional","interpretation_note":"依完整本傳敘事／引語主語辨識，不以最近姓名機械延續。"},{"id":"c-jinshu-089-jishao:p007:m0033","start":33,"end":35,"surface":"大駕","kind":"person","person_id":"7e0_f69_1ac","status":"contextual_provisional","interpretation_note":"依完整本傳敘事／引語主語辨識，不以最近姓名機械延續。"},{"id":"c-jinshu-089-