nd":38,"surface":"中書丞","person_mention_id":"c-sanguozhi-065-wangfan-complete:p002:m0038","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-065","chapter_id":"c-sanguozhi-065-wangfan-complete","source_id":"s-sanguozhi-065-wangfan-complete-ws2589669","paragraph_id":"c-sanguozhi-065-wangfan-complete:p002","quote":"　　孫皓初。復入為常侍，與萬彧同官。彧與皓有舊，俗士挾侵，謂蕃自輕。又中書丞陳聲，皓之嬖臣，數譖毀蕃。蕃體氣高亮，不能承顏順指；時或迕意，積以見責。","person_mention_id":"c-sanguozhi-065-wangfan-complete:p002:m0038"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-061-lukai:line052","text":"　　臣竊見陛下執政以來，陰陽不調，五星失晷，職司不忠，奸黨相扶，是陛下不遵先帝之所致。夫王者之興，受之於天，修之由德，豈在宮乎？而陛下不咨之公輔，便盛意驅馳，六軍流離悲懼，逆犯天地，天地以災，童歌其謠。縱令陛下一身得安，百姓愁勞，何以用治？此不遵先帝一也；　　臣聞有國以賢為本，夏殺龍逢，殷獲伊摯。斯前世之明效，今日之師表也。中常侍王蕃黃中通理，處朝忠謇，斯社稷之重鎮，大吳之龍逢也，而陛下忿其苦辭，惡其直對，梟之殿堂，屍骸暴棄。邦內傷心，有識悲悼，咸以吳國夫差復存，先帝親賢，陛下反之，是陛下不遵先帝二也；　　臣聞宰相國之柱也，不可不強，是故漢有蕭、曹之佐，先帝有顧、步之相。而萬彧瑣才凡庸之質，昔從家隸，超步紫闥，於彧已豐，於器已溢，而陛下愛其細介，不訪大趣，榮以尊輔，越尚舊臣。賢良憤惋，智士赫吒，是不遵先帝三也；　　先帝愛民過於嬰孩，民無妻者以妾妻之，見單衣者以帛給之，枯骨不收而取埋之。而陛下反之，是不遵先帝四也；　　昔桀、紂滅由妖婦，幽、厲亂在嬖妾，先帝鑒之，以為身戒。故左右不置淫邪之色，後房無曠積之女。今中宮萬數，不備嬪嬙，外多鰥夫，女吟於中。風雨逆度，正由此起，是不遵先帝五也；　　先帝憂勞萬機，猶懼有失。陛下臨阼以來，遊戲後宮，眩惑婦女，乃令庶事多曠，下吏容奸，是不遵先帝六也；　　先帝篤尚樸素，服不純麗，宮無高台，物不雕飾，故國富民充，奸盜不作。而陛下徵調州郡，竭民財力，士被玄黃，宮有朱紫，是不遵先帝七也；　　先帝外仗顧、陸、朱、張，內近胡綜、薛綜是以庶績雍熙。邦內情肅。今者外非其任，內非其人，陳聲、曹輔，斗筲小吏，先帝之所棄，而陛下幸之，是不遵先帝八也。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-061-lukai:line052:m0141","surface":"龍逢","start":141,"end":143,"kind":"person","person_id":"iml_mgn_ycw","status":"contextual_provisional","interpretation_note":"按本段具名及前後親稱、官職定位。"},{"id":"c-sanguozhi-061-lukai:line052:m0146","start":146,"end":148,"surface":"伊摯","kind":"person","person_id":"itn_zi2_il4","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line052:m0166","start":166,"end":168,"surface":"王蕃","kind":"person","person_id":"z8o_i3j_zja","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line052:m0229","start":229,"end":231,"surface":"夫差","kind":"person","person_id":"5dm_e40_rqh_AAAAAAAAAAAAAAAAAAAAA","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line052:m0274","surface":"蕭","start":274,"end":275,"kind":"person","person_id":"xd8_uww_5ok","status":"contextual_provisional","interpretation_note":"按本段具名及前後親稱、官職定位。"},{"id":"c-sanguozhi-061-lukai:line052:m0276","surface":"曹","start":276,"end":277,"kind":"person","person_id":"37j_16p_7n8","status":"contextual_provisional","interpretation_note":"按本段具名及前後親稱、官職定位。"},{"id":"c-sanguozhi-061-lukai:line052:m0283","surface":"顧","start":283,"end":284,"kind":"person","person_id":"syc_ik6_bq5_**A","status":"contextual_provisional","interpretation_note":"按本段具名及前後親稱、官職定位。"},{"id":"c-sanguozhi-061-lukai:line052:m0285","surface":"步","start":285,"end":286,"kind":"person","person_id":"snv_2iq_jes","status":"contextual_provisional","interpretation_note":"按本段具名及前後親稱、官職定位。"},{"id":"c-sanguozhi-061-lukai:line052:m0290","start":290,"end":292,"surface":"萬彧","kind":"person","person_id":"bmy_4x8_vlh","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line052:m0310","start":310,"end":311,"surface":"彧","kind":"person","person_id":"bmy_4x8_vlh","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line052:m0415","start":415,"end":416,"surface":"桀","kind":"person","person_id":"8zj_5p3_i5y","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line052:m0