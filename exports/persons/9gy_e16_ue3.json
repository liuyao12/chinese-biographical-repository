ji-091-qingbu:m003-0127","start":127,"end":129,"surface":"宋義","kind":"person","person_id":"9gy_e16_ue3","status":"contextual_provisional","paragraph_id":"c-shiji-091-qingbu:p003","chapter_id":"c-shiji-091-qingbu"},{"id":"c-shiji-091-qingbu:m003-0138","start":138,"end":140,"surface":"宋義","kind":"person","person_id":"9gy_e16_ue3","status":"contextual_provisional","paragraph_id":"c-shiji-091-qingbu:p003","chapter_id":"c-shiji-091-qingbu"}],"relations":[],"title_holdings":[{"id":"th-shiji091-003","person_id":"9gy_e16_ue3","title":"上將","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-091-qingbu","source_id":"s-shiji-091-qingbu","paragraph_id":"c-shiji-091-qingbu:p003","quote":"項梁涉淮而西，擊景駒、秦嘉等，布常冠軍。項梁至薛，聞陳王定死，迺立楚懷王。項梁號為武信君，英布為當陽君。項梁敗死定陶，懷王徙都彭城，諸將英布亦皆保聚彭城。當是時，秦急圍趙，趙數使人請救。懷王使宋義為上將，范曾為末將，項籍為次將，英布、蒲將軍皆為將軍，悉屬宋義，北救趙。及項籍殺宋義於河上，懷王因立籍為上將軍，諸將皆屬項籍。項籍使布先渡河擊秦，布數有利，籍迺悉引兵涉河從之，遂破秦軍，降章邯等。楚兵常勝，功冠諸侯。諸侯兵皆以服屬楚者，以布數以少敗眾也。"}],"attestations":[{"id":"th-shiji091-003:a001","paragraph_id":"c-shiji-091-qingbu:p003","start":99,"end":101,"surface":"上將","person_mention_id":"c-shiji-091-qingbu:m003-0096","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-091-qingbu","source_id":"s-shiji-091-qingbu","paragraph_id":"c-shiji-091-qingbu:p003","quote":"項梁涉淮而西，擊景駒、秦嘉等，布常冠軍。項梁至薛，聞陳王定死，迺立楚懷王。項梁號為武信君，英布為當陽君。項梁敗死定陶，懷王徙都彭城，諸將英布亦皆保聚彭城。當是時，秦急圍趙，趙數使人請救。懷王使宋義為上將，范曾為末將，項籍為次將，英布、蒲將軍皆為將軍，悉屬宋義，北救趙。及項籍殺宋義於河上，懷王因立籍為上將軍，諸將皆屬項籍。項籍使布先渡河擊秦，布數有利，籍迺悉引兵涉河從之，遂破秦軍，降章邯等。楚兵常勝，功冠諸侯。諸侯兵皆以服屬楚者，以布數以少敗眾也。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予與用稱分存；常冠軍不作官名，欲為帝不作即帝位，稱病反楚死亡不補官爵終期。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji091-013","person_id":"9gy_e16_ue3","surfaces":["宋義"],"scope":"same_chapter","chapter_