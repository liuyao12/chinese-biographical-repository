{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000812","identity_policy":"contextual_provisional","person_ids":["cbr-p000812"],"persons":[{"id":"cbr-p000812","label":"齊緡王","status":"active","historicity":"historical_tradition","aliases":[{"surface":"齊緡王","mention_ids":["c-shiji-008-gaozu:m083-0038"]}],"evidence":[{"mention_id":"c-shiji-008-gaozu:m083-0038","chapter_id":"c-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p083","quote":"齊緡王"}]}],"mentions":[{"id":"c-shiji-008-gaozu:m083-0038","start":38,"end":41,"surface":"齊緡王","kind":"person","person_id":"cbr-p000812","status":"contextual_provisional","paragraph_id":"c-shiji-008-gaozu:p083","chapter_id":"c-shiji-008-gaozu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-008-gaozu:p083","text":"十一月，高祖自布軍至長安。十二月，高祖曰：「秦始皇帝、楚隱王陳涉、魏安釐王、齊緡王、趙悼襄王皆絕無後，予守冢各十家，秦皇帝二十家，魏公子無忌五家。」赦代地吏民為陳豨、趙利所劫掠者，皆赦之。陳豨降將言豨反時，燕王盧綰使人之豨所，與陰謀。上使辟陽侯迎綰，綰稱病。辟陽侯歸，具言綰反有端矣。二月，使樊噲、周勃將兵擊燕王綰，赦燕吏民與反者。立皇子建為燕王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m083-0004","start":4,"end":6,"surface":"高祖","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m083-0007","start":7,"end":9,"surface":"布軍","kind":"person","person_id":"cbr-p000656","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m083-0017","start":17,"end":19,"surface":"高祖","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m083-0022","start":22,"end":26,"surface":"秦始皇帝","kind":"person","person_id":"cbr-p000533","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m083-0030","start":30,"end":32,"surface":"陳涉","kind":"person","person_id":"cbr-p000598","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m083-0033","start":33,"end"