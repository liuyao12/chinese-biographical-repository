{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"8hc_q2m_980","canonical_person_id":"8hc_q2m_980","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["8hc_q2m_980"],"persons":[{"id":"8hc_q2m_980","label":"趙領","status":"active","historicity":"historical_tradition","aliases":[{"surface":"趙領","mention_ids":["c-jinshu-063-shaoxu:p003:m0024"]}],"evidence":[{"mention_id":"c-jinshu-063-shaoxu:p003:m0024","paragraph_id":"c-jinshu-063-shaoxu:p003","chapter_id":"c-jinshu-063-shaoxu","quote":"趙領"}],"review":"ai_provisional","identity_note":"趙領，見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-jinshu-063-shaoxu-ws2025242","work_id":"w-jinshu","book_id":"b-jinshu-063","chapter_id":"c-jinshu-063-shaoxu","raw_mention_count":1,"mention_ids":["c-jinshu-063-shaoxu:p003:m0024"],"paragraph_ids":["c-jinshu-063-shaoxu:p003"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-063-shaoxu:p003:m0024","mention_ids":["c-jinshu-063-shaoxu:p003:m0024"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-063-shaoxu-ws2025242"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-063-shaoxu:p003:m0024","surface":"趙領","start":24,"end":26,"person_id":"8hc_q2m_980","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-063-shaoxu:p003","chapter_id":"c-jinshu-063-shaoxu"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-063-shaoxu:p003","text":"匹磾既殺劉琨，夷晉多怨叛，遂率其徒依續。勒南和令趙領等率廣川、渤海千餘家背勒歸續。而帝以續為平原樂安太守、右將軍、冀州刺史，進平北將軍、假節，封祝阿子。續遣兄子武邑內史存與文鴦率匹磾眾就食平原，為石季龍所破。續先與曹嶷互相侵掠，嶷因存等敗，乃破續屯田，又抄其戶口，續首尾相救，疲於奔命。太興初，續遣存及文鴦屯濟南黃巾固，因以逼嶷，嶷懼，求和。俄而匹磾率眾攻段末杯，石勒知續孤危，遣季龍乘虛圍續。季龍騎至城下，掠其居人，續率眾出救，季龍伏騎斷其後，遂為季龍所得，使續降其城。續呼其兄子竺等曰：「吾志雪國難，以報所受，不幸至此。汝等努力自勉，便奉匹磾為主，勿有二心。」","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":16,"last_line":16,"raw_start":633,"raw_end":917,"raw_character_offsets":[635,636,637,638,639,640,641,642,643,644,645,646,647,648,649,650,651,652,653,654,655,656,657,658,659,660,661,662,663,664,665,666,667,668,669,670,671,672,673,674,675,676,677,678,679,680,681,682,683,684,685,686,687,688,689,690,691,692,693,694,695,696,697,698,699,700,701,702,703,704,705,706,707,708,709,710,711,712,713,714,715,716,717,718,719,720,721,722,723,724,725,726,727,728,729,730,731,732,733,734,735,736,737,738,739,740,741,742,743,744,745,746,747,748,749,750,751,752,753,754,755,756,757,758,759,760,761,762,763,764,765,766,767,768,769,770,771,772,773,774,775,776,777,778,779,780,781,782,783,784,785,786,787,788,789,790,791,792,793,794,795,796,797,798,799,800,801,802,803,804,805,806,807,808,809,810,811,812,813,814,815,816,817,818,819,820,821,822,823,824,825,826,827,828,829,830,831,832,833,834,835,836,837,838,839,840,841,842,843,844,845,846,847,848,849,850,851,852,853,854,855,856,857,858,859,860,861,862,863,864,865,866,867,868,869,870,871,872,873,874,875,876,877,878,879,880,881,882,883,884,885,886,887,888,889,890,891,892