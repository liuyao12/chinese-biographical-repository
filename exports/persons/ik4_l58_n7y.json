,"original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-liangshu-030-peiziye:p005:m0056","start":56,"end":58,"surface":"蕭勱","kind":"person","person_id":"ik4_l58_n7y","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。","paragraph_id":"c-liangshu-030-peiziye:p005","chapter_id":"c-liangshu-030-peiziye"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-liang030-xiaomai","person_id":"ik4_l58_n7y","surfaces":["蕭勱"],"scope":"same_chapter","status":"contextual_provisional","confidence_level":"medium","identification_basis":{"kind":"source_context","target_mention_ids":["c-liangshu-030-peiziye:p005:m0056"]},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-030","source_id":"s-liang030-ws1508510","chapter_id":"c-liangshu-030-peiziye","paragraph_id":"c-liangshu-030-peiziye:p005","quote":"子野與沛國劉顯、南陽劉之遴、陳郡殷芸、陳留阮孝緒、吳郡顧協、京兆韋棱，皆博極羣書，深相賞好，顯尤推重之。時吳平侯蕭勱、范陽張纘，每討論墳籍，咸折中於子野焉。普通七年，王師北伐，敕子野爲喻魏文，受詔立成，高祖以其事體大，召尚書僕射徐勉、太子詹事周捨、鴻臚卿劉之遴、中書侍郎朱异，集壽光殿以觀之，時並嘆服。高祖目子野而言曰：「其形雖弱，其文甚壯。」俄又敕爲書喻魏相元乂，其夜受旨，子野謂可待旦方奏，未之爲也。及五鼓，敕催令開齋速上，子野徐起操筆，昧爽便就。旣奏，高祖深嘉焉。自是凡諸符檄，皆令草創。子野爲文典而速，不尚麗靡之詞。其制作多法古，與今文體異，當時或有詆訶者，及其末皆翕然重之。或問其爲文速者，子野答云：「人皆成於手，我獨成於心，雖有見否之異，其於刊改一也。」"}],"rationale":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null}],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-030-peiziye:p005","text":"子野與沛國劉顯、南陽劉之遴、陳郡殷芸、陳留阮孝緒、吳郡顧協、京兆韋棱，皆博極羣書，深相賞好，顯尤推重之。時吳平侯蕭勱、范陽張纘，每討論墳籍，咸折中於子野焉。普通七年，王師北伐，敕子野爲喻魏文，受詔立成，高祖以其事體大，召尚書僕射徐勉、太子詹事周捨、鴻臚卿劉之遴、中書侍郎朱异，集壽光殿以觀之，時並嘆服。高祖目子野而言曰：「其形雖弱，其文甚壯。」俄又敕爲書喻魏相元乂，其夜受旨，子野謂可待旦方奏，未之爲也。及五鼓，敕催令開齋速上，子野徐起操筆，昧爽便就。旣奏，高祖深嘉焉。自是凡諸符檄，皆令草創。子野爲文典而速，不尚麗靡之詞。其制作多法古，與今文體異，當時或有詆訶者，及其末皆翕然重之。或問其爲文速者，子野答云：「人皆成於手，我獨成於心，雖有見否之異，其於刊改一也。」","source_position":{"start":1324,"end":1666,"raw":"　　子野與沛國劉顯、南陽劉之遴、陳郡殷芸、陳留阮孝緒、吳郡顧協、京兆韋棱，皆博極羣書，深相賞好，顯尤推重之。時吳平侯蕭勱、范陽張纘，每討論墳籍，咸折中於子野焉。{{YL|普通七年}}，王師北伐，敕子野爲喻魏文，受詔立成，高祖以其事體大，召尚書僕射徐勉、太子詹事周捨、鴻臚卿劉之遴、中書侍郎朱异，集壽光殿以觀之，時並嘆服。高祖目子野而言曰：「其形雖弱，其文甚壯。」俄又敕爲書喻魏相元乂，其夜受旨，子野謂可待旦方奏，未之爲也。及五鼓，敕催令開齋速上，子野徐起操筆，昧爽便就。旣奏，高祖深嘉焉。自是凡諸符檄，皆令草創。子野爲文典而速，不尚麗靡之詞。其制作多法古，與今文體異，當時或有詆訶者，及其末皆翕然重之。或問其爲文速者，子野答云：「人皆成於手，我獨成於心，雖有見否之異，其於刊改一也。」","raw_path":"sources/liangshu/wikisource-1508510-raw.wikitext"},"mentions":[{"id":"c-liangshu-030-peiziye:p005:m0000","start":0,"end":2,"surface":"子野","kind":"person","person_id":"hvz_7p7_g9m","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p005:m0005","start":5,"end":7,"surface":"劉顯","kind":"person","person_id":"mcd_vna_05k","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p005:m0010","start":10,"end":13,"surface":"劉之遴","kind":"person","person_id":"q7n_s7f_1cs","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p005:m0016","start":16,"end":18,"surface":"殷芸","kind":"person","person_id":"8d4_fth_d4l","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p005:m0021","start":21,"end":24,"surface":"阮孝緒","kind":"person","person_id":"372_tla_k26","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p005:m0027","start":27,"end":29,"surface":"顧協","kind":"person","person_id":"jc6_fqx_h6v","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p005:m0032","start":32,"end":34,"surface":"韋棱","kind":"person","person_id":"g1o_tw1_xj8","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p005:m0046","start":46,"e