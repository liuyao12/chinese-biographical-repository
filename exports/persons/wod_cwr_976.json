-zhoufang:line088-pei01-01:m0000","mention_ids":["c-sanguozhi-060-zhoufang:line088-pei01-01:m0000"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-sanguozhi-062-shiyi"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-sanguozhi-052-guyong-complete:line042-pei02-02:reading-000-227","kind":"received_sentence","paragraph_id":"c-sanguozhi-052-guyong-complete:line042-pei02-02","person_id":"wod_cwr_976","related_person_ids":["syc_ik6_bq5_**A","ym8_q7g_031","ikr_4da_wb3","572_278_cba_C","lii_454_vuv","pac_tt7_hs3","nvt_gxa_pdo","sjh_rvy_vry","1bj_qw1_wgz","qjs_3hl_6ck_A"],"start_codepoint":0,"end_codepoint":227,"source_quote":"徐众评曰：雍不以吕壹见毁之故，而和颜悦色，诚长者矣。然开引其意，问所欲道，此非也。壹奸险乱法，毁伤忠贤，吴国寒心，自太子登、陆逊已下，切谏不能得，是以潘濬欲因会手剑之，以除国患，疾恶忠主，义形於色，而今乃发起令言。若壹称枉邪，不申理，则非录狱本旨；若承辞而奏之，吴主傥以敬丞相所言，而复原宥，伯言、承明不当悲慨哉！怀叙本无私恨，无所为嫌，故詈辱之，疾恶意耳，恶不仁者，其为仁也。季武子死，曾点倚其门而歌；子晳创发，子产催令自裁。以此言之，雍不当责怀叙也。","reading":"徐眾評顧雍對呂壹與懷敘之舉，與史傳敘事另記。陸遜字伯言、潘濬字承明；季武子與曾點、公孫黑與子產皆為評論所引古例。","chapter_id":"c-sanguozhi-052-guyong-complete","source_id":"s-sanguozhi-052-guyong-complete"},{"id":"c-sanguozhi-060-quancong:line032-pei01-01:reading-000-043","kind":"annotation_sentence","paragraph_id":"c-sanguozhi-060-quancong:line032-pei01-01","start_codepoint":0,"end_codepoint":43,"source_quote":"徐众评曰：礼，子事父无私财，又不敢私施，所以避尊上也。弃命专财而以邀名，未尽父子之礼。","person_id":"wod_cwr_976","related_person_ids":[],"reading":"徐眾論子事父無私財，指全琮散米。","chapter_id":"c-sanguozhi-060-quancong","source_id":"s-sanguozhi-060-quancong"},{"id":"c-sanguozhi-060-zhonglimu:line093-pei03-01:reading-000-364","kind":"annotation_sentence","paragraph_id":"c-sanguozhi-060-zhonglimu:line093-pei03-01","start_codepoint":0,"end_codepoint":364,"source_quote":"徐众评曰：牧蹈长者之规。问者曰：“如牧所行，犯而不校，又从而救之，直而不有，又还而不受，可不谓之仁让乎哉？”答曰：“异乎吾所闻。原宪之问於孔子曰：‘克伐怨欲不行焉，可以为仁乎？’孔子曰：‘可以为难矣，仁则吾不知也。’‘恶不仁者，其为仁矣。’今小民不展四体，而认人之稻，不仁甚矣，而牧推而与之，又救其罪，斯为让非其义，所救非人，非所谓恶不仁者。苟不恶不仁，安得为仁哉！苍梧浇娶妻而美，让於其兄；尾生笃信，水至不去而死；直躬好直，证父攘羊；申鸣奉法，尽忠於君而执其父。忠信直让，此四行者，圣贤之所贵也。然不贵苍梧之让，非让道也；不取尾生之信，非信所也；不许直躬之直，非直体也；不嘉申鸣之忠，非忠意也。今牧犯而不校，还而不取，可以为难矣，未得为仁让也。夫圣人以德报德，以直报怨，而牧欲以德报怨，非也。必不得已，二者何从？吾从孔子也。”","person_id":"wod_cwr_976","related_person_ids":["2ue_nmk_m3s_A","b26_2bj_z9b","fp6_ia6_7yw","tcx_5ia_phu","l3n_6lt_37x","1oj_tv2_gdc","8yy_xdt_gul"],"reading":"徐眾評藉儒家問答和蒼梧澆、尾生、直躬、申鳴諸例論讓，末「吾從孔子」屬文內答者。","chapter_id":"c-sanguozhi-060-zhonglimu","source_id":"s-sanguozhi-060-zhonglimu"},{"id":"c-sanguozhi-060-zhoufang:line088-pei01-01:reading-000-099","kind":"annotation_sentence","paragraph_id":"c-sanguozhi-060-zhoufang:line088-pei01-01","start_codepoint":0,"end_codepoint":99,"source_quote":"徐众评曰：夫人臣立功效节，虽非一涂，然各有分也。为将执桴鼓，则有必死之义，志守则有不假器之义，死必得所，义在不苟。鲂为郡守，职在治民，非君所命，自占诱敌，髡剔发肤，以徇功名，虽事济受爵，非君子所美。","person_id":"wod_cwr_976","related_person_ids":["iuc_mqu_3jm"],"reading":"徐眾批評魴自占誘敵、髡剔髮膚。與正文權褒獎的聲音分層。","chapter_id":"c-sanguozhi-060-zhoufang","source_id":"s-sanguozhi-060-zhoufang"},{"id":"c-sanguozhi-062-shiyi:line011-pei01-01:reading-000-118","kind":"annotation_sentence","paragraph_id":"c-sanguozhi-062-shiyi:line011-pei01-01","start_codepoint":0,"end_codepoint":118,"source_quote":"徐众评曰：古之建姓，或以所生，或以官号，或以祖名，皆有义体，以明氏族。故曰胙之以土而命之氏，此先王之典也，所以明本重始，彰示功德，子孙不忘也。今离文析字，横生忌讳，使仪易姓，忘本诬祖，不亦谬哉！教人易姓，从人改族，融既失之，仪又不得也。","person_id":"wod_cwr_976","related_person_ids":["q6j_1qg_qm2","1e4_e5b_007"],"reading":"徐眾評論改姓事，區分現場對話與後人評議。","chapter_id":"c-sanguozhi-062-shiyi","source_id":"s-sanguozhi-062-shiyi"},{"id":"c-sanguozhi-062-shiyi:line013-pei01-01:reading-000-141","kind":"annotation_sentence","paragraph_id":"c-sanguozhi-062-shiyi:line013-pei01-01","start_codepoint":0,"end_codepoint":141,"source_quote":"徐众评曰：是仪以羁旅异方，客仕吴朝，值谗邪殄行，当严毅之威，命县漏刻，祸急危机，不雷同以害人，不苟免以伤义，可谓忠勇公正之士，虽祁奚之免叔向，庆忌之济硃云，何以尚之？忠不谄君，勇不慑耸，公不存私，正不党邪，资此四德，加之以文敏，崇之以谦约，履之以和顺，保傅二宫，存身爱名，不亦宜乎！","person_id":"wod_cwr_976","related_person_ids":["q6j_1qg_qm2","535_ed8_4fa","edm_4zm_yh1","3to_agz_4t5","0f4_zc6_3l3"],"reading":"徐眾以祁奚免叔向、辛慶忌救朱雲稱儀，見漢書朱雲本傳。","chapter_id":"c-sanguozhi-062-shiyi","source_id":"s-sanguozhi-062-shiyi"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-052-guyong-complete:line042-pei02-02:m0000","start":0,"end":2,"surface":"徐众","kind":"person","person_id":"wod_cwr_976","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-sanguozhi-052-guyong-complete:line042-pei02-02","chapter_id":"c-sanguozhi-052-guyong-complete"},{"id":"c-sanguozhi-060-quancong:line032-pei01-01:m0000","start":0,"end":2,"surface":"徐众","kind":"person","person_id":"wod_cwr_976","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-060-quancong:line032-pei01-01","chapter_id":"c-sanguozhi-060-quancong"},{"id":"c-sanguozhi-060-zhonglimu:line093-pei03-01:m0000","start":0,"end":2,"surface":"徐众","kind":"person","person_id":"wod_cwr_976","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-060-zhonglimu:line093-pei03-01","chapter_id":"c-sanguozhi-060-zhonglimu"},{"id":"c-sanguozhi-060-zhoufang:line088-pei01-01:m0000","start":0,"end":2,"surface":"徐众","kind":"person","person_id":"wod_cwr_976","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-060-zhoufang:line088-pei01-01","chapter_id":"c-sanguozhi-060-zhoufang"},{"id":