92]},"attribution":{"annotator":"裴松之","attribution_kind":"quoted_author","source_label":"徐眾評","attribution_marker":"徐众评曰："},"attachment":{"received_paragraph_id":"c-sanguozhi-060-zhonglimu:line093","received_codepoint":227,"note_ordinal":3,"source_ordinal":1},"chapter_id":"c-sanguozhi-060-zhonglimu","book_id":"b-sanguozhi-060","work_id":"w-sanguozhi","source_id":"s-sanguozhi-060-zhonglimu"},{"id":"c-sanguozhi-060-zhoufang:line088-pei01-01","text":"徐众评曰：夫人臣立功效节，虽非一涂，然各有分也。为将执桴鼓，则有必死之义，志守则有不假器之义，死必得所，义在不苟。鲂为郡守，职在治民，非君所命，自占诱敌，髡剔发肤，以徇功名，虽事济受爵，非君子所美。","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-060-zhoufang:line088-pei01-01:m0000","start":0,"end":2,"surface":"徐众","kind":"person","person_id":"wod_cwr_976","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-zhoufang:line088-pei01-01:m0057","start":57,"end":58,"surface":"鲂","kind":"person","person_id":"iuc_mqu_3jm","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"}],"annotation_status":"reviewed","source_position":{"first_line":88,"last_line":88,"revision_id":2120830,"raw_start":8307,"raw_end":8406,"character_positions":[8307,8308,8309,8310,8311,8312,8313,8314,8315,8316,8317,8318,8319,8320,8321,8322,8323,8324,8325,8326,8327,8328,8329,8330,8331,8332,8333,8334,8335,8336,8337,8338,8339,8340,8341,8342,8343,8344,8345,8346,8347,8348,8349,8350,8351,8352,8353,8354,8355,8356,8357,8358,8359,8360,8361,8362,8363,8364,8365,8366,8367,8368,8369,8370,8371,8372,8373,8374,8375,8376,8377,8378,8379,8380,8381,8382,8383,8384,8385,8386,8387,8388,8389,8390,8391,8392,8393,8394,8395,8396,8397,8398,8399,8400,8401,8402,8403,8404,8405]},"attribution":{"annotator":"裴松之","attribution_kind":"quoted_author","source_label":"徐眾評","attribution_marker":"徐众评曰："},"attachment":{"received_paragraph_id":"c-sanguozhi-060-zhoufang:line088","received_codepoint":98,"note_ordinal":1,"source_ordinal":1},"chapter_id":"c-sanguozhi-060-zhoufang","book_id":"b-sanguozhi-060","work_id":"w-sanguozhi","source_id":"s-sanguozhi-060-zhoufang"},{"id":"c-sanguozhi-062-shiyi:line011-pei01-01","text":"徐众评曰：古之建姓，或以所生，或以官号，或以祖名，皆有义体，以明氏族。故曰胙之以土而命之氏，此先王之典也，所以明本重始，彰示功德，子孙不忘也。今离文析字，横生忌讳，使仪易姓，忘本诬祖，不亦谬哉！教人易姓，从人改族，融既失之，仪又不得也。","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-062-shiyi:line011-pei01-01:m0000","start":0,"end":2,"surface":"徐众","kind":"person","person_id":"wod_cwr_976","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-062-shiyi:line011-pei01-01:m0083","start":83,"end":84,"surface":"仪","kind":"person","person_id":"q6j_1qg_qm2","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-062-shiyi:line011-pei01-01:m0107","start":107,"end":108,"surface":"融","kind":"person","person_id":"1e4_e5b_007","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-062-shiyi:line011-pei01-01:m0112","start":112,"end":113,"surface":"仪","kind":"person","person_id":"q6j_1qg_qm2","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"}],"annotation_status":"reviewed","source_position":{"first_line":11,"last_line":11,"revision_id":2623289,"raw_start":252,"raw_end":370,"character_positions":[252,253,254,255,256,257,258,259,260,261,262,263,264,265,266,267,268,269,270,271,272,273,274,275,276,277,278,279,280,281,282,283,284,285,286,287,288,289,290,291,292,293,294,295,296,297,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,318,319,320,321,322,323,324,325,326,327,328,329,330,331,332,333,334,335,336,337,338,339,340,341,342,343,344,345,346,347,348,349,350,351,352,353,354,355,356,357,358,359,360,361,362,363,364,365,366,367,368,369]},"attribution":{"annotator":"裴松之","attribution_kind":"quoted_author","source_label":"徐眾評","attribution_marker":"徐众评曰："},"attachment":{"received_paragraph_id":"c-sanguozhi-062-shiyi:line011","received_codepoint":58,"note_ordinal":1,"source_ordinal":1},"chapter_id":"