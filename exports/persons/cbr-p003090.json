:"contextual_provisional"}],"chapter_id":"c-shiji-049-waiqi","book_id":"b-shiji-049","work_id":"w-shiji","source_id":"s-shiji-049-waiqi"},{"id":"c-shiji-049-waiqi:p027","text":"初，上為太子時，娶長公主女為妃。立為帝，妃立為皇后，姓陳氏，無子。上之得為嗣，大長公主有力焉，以故陳皇后驕貴。聞衛子夫大幸，恚，幾死者數矣。上愈怒。陳皇后挾婦人媚道，其事頗覺，於是廢陳皇后，而立衛子夫為皇后。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-049-waiqi:m027-0009","start":9,"end":12,"surface":"長公主","kind":"person","person_id":"cbr-p003090","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m027-0027","start":27,"end":29,"surface":"陳氏","kind":"person","person_id":"cbr-p003110","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m027-0039","start":39,"end":43,"surface":"大長公主","kind":"person","person_id":"cbr-p003090","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m027-0049","start":49,"end":52,"surface":"陳皇后","kind":"person","person_id":"cbr-p003110","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m027-0056","start":56,"end":59,"surface":"衛子夫","kind":"person","person_id":"cbr-p003106","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m027-0074","start":74,"end":77,"surface":"陳皇后","kind":"person","person_id":"cbr-p003110","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m027-0091","start":91,"end":94,"surface":"陳皇后","kind":"person","person_id":"cbr-p003110","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m027-0097","start":97,"end":100,"surface":"衛子夫","kind":"person","person_id":"cbr-p003106","status":"contextual_provisional"}],"chapter_id":"c-shiji-049-waiqi","book_id":"b-shiji-049","work_id":"w-shiji","source_id":"s-shiji-049-waiqi"},{"id":"c-shiji-049-waiqi:p028","text":"陳皇后母大長公主，景帝姊也，數讓武帝姊平陽公主曰：「帝非我不得立，已而棄捐吾女，壹何不自喜而倍本乎！」平陽公主曰：「用無子故廢耳。」陳皇后求子，與醫錢凡九千萬，然竟無子。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-049-waiqi:m028-0000","start":0,"end":3,"surface":"陳皇后","kind":"person","person_id":"cbr-p