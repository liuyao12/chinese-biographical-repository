huang:p069:m0000","start":0,"end":2,"surface":"出子","kind":"person","person_id":"cbr-p000355","status":"contextual_provisional","paragraph_id":"c-shiji-006-shihuang:p069","chapter_id":"c-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:p069:m0027","start":27,"end":29,"surface":"出子","kind":"person","person_id":"cbr-p000355","status":"contextual_provisional","paragraph_id":"c-shiji-006-shihuang:p069","chapter_id":"c-shiji-006-shihuang"}],"relations":[{"id":"a-shiji006-013","subject_person_id":"cbr-p000355","predicate":"father","object_person_id":"cbr-p000641","status":"source_attested","evidence":[{"paragraph_id":"c-shiji-006-shihuang:p068","quote":"憲公享國十二年，居西新邑。死，葬衙。生武公、德公、出子。","chapter_id":"c-shiji-006-shihuang","source_id":"s-shiji-006-shihuang"}],"qualifiers":{"source_term":"生","historicity":"historical_tradition"},"interpretation_note":"保存卷末文本明示主張；若與本卷或前卷相反，仍分存，不推定此說較優或修改來源。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-005-qin:p011","text":"寧公二年，公徙居平陽。遣兵伐蕩社。三年，與亳戰，亳王奔戎，遂滅蕩社。四年，魯公子翚弒其君隱公。十二年，伐蕩氏，取之。寧公生十歲立，立十二年卒，葬西山。生子三人，長男武公為太子。武公弟德公，同母魯姬子。生出子。寧公卒，大庶長弗忌、威壘、三父廢太子而立出子為君。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m011-0000","start":0,"end":2,"surface":"寧公","kind":"person","person_id":"cbr-p000349","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m011-0024","start":24,"end":26,"surface":"亳王","kind":"person","person_id":"cbr-p000350","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m011-0037","start":37,"end":41,"surface":"魯公子翚","kind":"person","person_id":"cbr-p000351","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m011-0044","start":44,"end":46,"surface":"隱公","kind":"person","person_id":"cbr-p000225","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m011-0058","start":58,"end":60,"surface":"寧公","kind":"person","person_id":"cbr-p000349","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m011-0075","start":75,"end":79,"surface":"生子三人","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或未核定指代；未由熟知世系補造人物。"},{"id":"c-shiji-005-qin:m011-0082","start":82,"end":84,"surface":"武公","kind":"person","person_id":"cbr-p000352","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m011-0088","start":88,"end":90,"surface":"武公","kind":"person","person_id":"cbr-p000352","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m011-0091","start":91,"end":93,"surface":"德公","kind":"person","person_id":"cbr-p000353","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m011-0096","start":96,"end":99,"surface":"魯姬子","kind":"person","person_id":"cbr-p000354","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m011-0101","start":101,"end":103,"surface":"出子","kind":"person","person_id":"cbr-p000355","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m011-0104","start":104,"end":106,"surface":"寧公","kind":"person","person_id":"cbr-p000349","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m011-0108","start":108,"end":113,"surface":"大庶長弗忌","kind":"person","person_id":"cbr-p000356","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m011-0114","start":114,"end":116,"surface":"威壘","kind":"person","person_id":"cbr-p000357","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m011-0117","start":117,"end":119,"surface":"三父","kind":"person","person_id":"cbr-p000358","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m011-0124","start":124,"end":126,"surface":"出子","kind":"person","person_id":"cbr-p000355","status":"contextual_provisional"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-005-qin:p012","text":"出子六年，三父等復共令人賊殺出子。出子生五歲立，立六年卒。三父等乃復立故太子武公。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m012-0000","start":0,"end":2,"surface":"出子","kind":"person","person_id":"cbr-p000355","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m012-0005","start":5,"end":7,"surface":"三父","kind":"person","person_id":"cbr-p000358","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m012-0010","start":10,"end":12,"surface":"令人","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或未核定指代；未由熟知世系補造人物。"},{"id":"c-shiji-005-qin:m012-0014","start":14,"end":16,"surface":"出子","kind":"person","person_id":"cbr-p000355","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m012-0017","start":17,"end":19,"surface":"出子","kind":"person","person_id":"cbr-p000355","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m012-0029","start":29,"end":31,"surface":"三父","kind":"person","person_id":"cbr-p000358","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m012-0038","start":38,"end":40,"surface":"武公","kind":"person","person_id":"cbr-p000352","status":"contextual_provisional"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-005-qin:p013","text":"武公元年，伐彭戲氏，至于華山下，居平陽封宮。三年，誅三父等而夷三族，以其殺出子也。鄭高渠瞇殺其君昭公。十年，伐邽、冀戎，初縣之。十一年，初縣杜、鄭。滅小虢。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m013-0000","start":0,"end":2,"surface":"武公","kind":"person","person_id":"cbr-p000352","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m013-0026","start":26,"end":28,"surface":"三父","kind":"person","person_id":"cbr-p000358","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m013-0037","start":37,"end":39,"surface":"出子","kind":"person","person_id":"cbr-p000355","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m013-0041","start":41,"end":45,"surface":"鄭高渠瞇","kind":"person","person_id":"cbr-p000359","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m013-0048","start":48,"end":50,"surface":"昭公","kind":"person","person_id":"cbr-p000360","status":"contextual_provisional"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-006-shihuang:p068","text":"憲公享國十二年，居西新邑。死，葬衙。生武公、德公、出子。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:p068:m0000","start":0,"end":2,"surface":"憲公","kind":"person","person_id":"cbr-p000641","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p068:m0019","start":19,"end":21,"surface":"武公","kind":"person","person_id":"cbr-p000352","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p068:m0022","start":22,"end":24,"surface":"德公","kind":"person","person_id":"cbr-p000353","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p068:m0025","start":25,"end":27,"surface":"出子","kind":"person","person_id":"cbr-p000355","status":"contextual_provisional"}],"chapter_id":"c-shiji-006-shihuang","book_id":"b-shiji-006","work_id":"w-shiji","source_id":"s-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:p069","text":"出子享國六年，居西陵。庶長弗忌、威累、參父三人，率賊賊出子鄙衍，葬衙。武公立。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:p069:m0000","start":0,"end":2,"surface":"出子","kind":"person","person_id":"cbr-p000355","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p069:m0011","start":11,"end":15,"surface":"庶長弗忌","kind":"person","person_id":"cbr-p000356","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p069:m0016","start":16,"end":18,"surface":"威累","kind":"person","person_id":"cbr-p000642","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p069:m0019","start":19,"end":21,"surface":"參父","kind":"person","person_id":"cbr-p000643","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p069:m0021","start":21,"end":23,"surface":"三人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、注記、作者標題、泛稱或未核指代；不補造姓名與世代。"},{"id":"c-shiji-006-shihuang:p069:m0025","start":25,"end":26,"surface":"賊","kind":"unresolved","perso