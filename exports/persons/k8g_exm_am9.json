討之。破曜呼日逐王呼延莫，以功封上洛郡公，食邑萬戶，拜夫人荀氏為新豐君，子石元為世子，賜子弟二人鄉亭侯。劉曜入關芟麥苗，綝又擊破之。自長安伐劉聰，聰將趙染杖其累捷，有自矜之色，帥精騎數百與綝戰，大敗之，染單馬而走。轉驃騎大將軍、尚書左僕射、錄尚書，承制行事。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":122,"last_line":122,"raw_start":9984,"raw_end":10136,"raw_character_offsets":[9986,9987,9988,9989,9990,9991,9992,9993,9994,9995,9996,9997,9998,9999,10000,10001,10002,10003,10004,10005,10006,10007,10008,10009,10010,10011,10012,10013,10014,10015,10016,10017,10018,10019,10020,10021,10022,10023,10024,10025,10026,10027,10028,10029,10030,10031,10032,10033,10034,10035,10036,10037,10038,10039,10040,10041,10042,10043,10044,10045,10046,10047,10048,10049,10050,10051,10052,10053,10054,10055,10056,10057,10058,10059,10060,10061,10062,10063,10064,10065,10066,10067,10068,10069,10070,10071,10072,10073,10074,10075,10076,10077,10078,10079,10080,10081,10082,10083,10084,10085,10086,10087,10088,10089,10090,10091,10092,10093,10094,10095,10096,10097,10098,10099,10100,10101,10102,10103,10104,10105,10106,10107,10108,10109,10110,10111,10112,10113,10114,10115,10116,10117,10118,10119,10120,10121,10122,10123,10124,10125,10126,10127,10128,10129,10130,10131,10132,10133,10134,10135],"revision_id":2413335},"mentions":[{"id":"c-jinshu-060-suochen:p004:m0001","surface":"劉曜","start":1,"end":3,"person_id":"fee_97f_681","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-suochen:p004:m0009","surface":"綝","start":9,"end":10,"person_id":"u3p_4ou_4st","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-suochen:p004:m0025","surface":"曜","start":25,"end":26,"person_id":"fee_97f_681","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-suochen:p004:m0030","surface":"呼延莫","start":30,"end":33,"person_id":"1ka_lgq_sdl","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-suochen:p004:m0050","surface":"荀氏","start":50,"end":52,"person_id":"j61_360_bt6","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-06