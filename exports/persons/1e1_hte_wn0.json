道憐率寧孟龍驤將軍孔隆及穆之等追真蘭走奔相城又追躡至炎林溝斬劉該虜衆見殺及赴水死略盡高祖鎮京口進道憐號龍驤將軍又領堂邑太守戍石頭明年加使持節監征蜀諸軍事率冠軍將軍劉敬宣等伐譙縱而文處茂温祚據險不得進故不果行以義勳封新興縣五等侯四年代諸葛長民為并州刺史義昌太守將軍內史如故猶戍石頭時鮮卑侵逼自彭城以南民皆保聚山陽淮陰諸戍並","status":"editorial_provisional","component_source_binding":{"kind":"fixed_wyd_song051_yixin_name_component","role":"dl_zhugechangmin","name_form":"source_full_name","raw_sha256":"8d2ae0cd97228ef9a252a07a5886f2f0c3d445e305f311e484b38a97f462fcad"},"human_reviewed":false,"model":null,"work_id":"w-songshu","book_id":"b-songshu-051","source_id":"s-songshu-051-wyd1739-zongshi"}],"mentions":[{"id":"c-jinshu-099-huanxuan:p028:m0077","start":77,"end":81,"surface":"諸葛長民","kind":"person","person_id":"1e1_hte_wn0","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。","paragraph_id":"c-jinshu-099-huanxuan:p028","chapter_id":"c-jinshu-099-huanxuan"},{"id":"c-jinshu-099-huanxuan:p031:m0010","start":10,"end":14,"surface":"諸葛長民","kind":"person","person_id":"1e1_hte_wn0","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。","paragraph_id":"c-jinshu-099-huanxuan:p031","chapter_id":"c-jinshu-099-huanxuan"},{"id":"c-songshu-051-wyd1739-zongshi:p002:m0166","start":166,"end":170,"surface":"諸葛長民","kind":"person","person_id":"1e1_hte_wn0","status":"contextual_provisional","paragraph_id":"c-songshu-051-wyd1739-zongshi:p002","chapter_id":"c-songshu-051-wyd1739-zongshi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-song051-daolian-zhugechangmin","person_id":"1e1_hte_wn0","surfaces":["諸葛長民"],"scope":"cross_chapter","chapter_ids":["c-songshu-051-wyd1739-zongshi","c-jinshu-099-huanxuan"],"status":"contextual_provisional","confidence_level":"high","identification_basis":{"kind":"source_context","target_mention_ids":["c-songshu-051-wyd1739-zongshi:p002:m0166"]},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-051","source_id":"s-songshu-051-wyd1739-zongshi","chapter_id":"c-songshu-051-wyd1739-zongshi","paragraph_id":"c-songshu-051-wyd1739-zongshi:p002","quote":"蘭寇徐州攻相縣執鉅鹿太守賀申進圍寧朔將軍羊穆之於彭城穆之告急道憐率衆救之軍次陵柵斬全進至彭城真蘭退走道憐率寧孟龍驤將軍孔隆及穆之等追真蘭走奔相城又追躡至炎林溝斬劉該虜衆見殺及赴水死略盡高祖鎮京口進道憐號龍驤將軍又領堂邑太守戍石頭明年加使持節監征蜀諸軍事率冠軍將軍劉敬宣等伐譙縱而文處茂温祚據險不得進故不果行以義勳封新興縣五等侯四年代諸葛長民為并州刺史義昌太守將軍內史如故猶戍石頭時鮮卑侵逼自彭城以南民皆保聚山陽淮陰諸戍並"},{"work_id":"w-jinshu","book_id":"b-jinshu-099","source_id":"s-jinshu-099-huanxuan-ws2644703","chapter_id":"c-jinshu-099-huanxuan","paragraph_id":"c-jinshu-099-huanxuan:p028","quote":"玄至尋陽，江州刺史郭昶之給其器用兵力。殷仲文自後至，望見玄舟，旌旗輿服備帝者之儀，歎息曰：「敗中復振，故可也。」玄於是逼乘輿西上。桓歆聚党向曆陽，宣城內史諸葛長民擊破之。玄於道作起居注，敘其距義軍之事，自謂經略指授，算無遺策，諸將違節度，以致虧喪，非戰之罪。於是不遑與群下謀議，唯耽思誦述，宣示遠近。玄至江陵，石康納之，張幔屋于城南，署置百官，以卞範之為尚書僕射，其餘職多用輕資。於是大修舟師，曾未三旬，眾且二萬，樓船器械甚盛。謂其群黨曰：「卿等並清塗翼從朕躬，都下竊位者方應謝罪軍門，其觀卿等入石頭，無異雲霄中人也。」"}],"rationale":"晉099既存諸葛長民與桓玄/義軍官序，同姓複姓全名及時代一致，未見反證。","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-099-huanxuan:p028","text":"玄至尋陽，江州刺史郭昶之給其器用兵力。殷仲文自後至，望見玄舟，旌旗輿服備帝者之儀，歎息曰：「敗中復振，故可也。」玄於是逼乘輿西上。桓歆聚党向曆陽，宣城內史諸葛長民擊破之。玄於道作起居注，敘其距義軍之事，自謂經略指授，算無遺策，諸將違節度，以致虧喪，非戰之罪。於是不遑與群下謀議，唯耽思誦述，宣示遠近。玄至江陵，石康納之，張幔屋于城南，署置百官，以卞範之為尚書僕射，其餘職多用輕資。於是大修舟師，曾未三旬，眾且二萬，樓船器械甚盛。謂其群黨曰：「卿等並清塗翼從朕躬，都下竊位者方應謝罪軍門，其觀卿等入石頭，無異雲霄中人也。」","source_position":{"kind":"wikitext_codepoint_positions","raw_path":"sources/jinshu/wikisource-2644703-raw.wikitext","raw_start":8067,"raw_end":8329,"character_positions":[8069,8070,8071,8072,8073,8074,8075,8076,8077,8078,8079,8080,8081,8082,8083,8084,8085,8086,8087,8088,8089,8090,8091,8092,8093,8094,8095,8096,8097,8098,8099,8100,8101,8102,8103,8104,8105,8106,8107,8108,8109,8110,8111,8112,8113,8114,8115,8116,8117,8118,8119,8120,8121,8122,8123,8124,8125,8126,8127,8128,8129,8130,8131,8132,8133,8134,8135,8136,8137,8138,8139,8140,8141,8142,8143,8144,8145,8146,8147,8148,8149,8150,8151,8152,8153,8154,8155,8156,8157,8158,8159,8160,8161,8162,8163,8164,8165,8166,8167,8168,8169,8170,8171,8172,8173,8174,8175,8176,8177,8178,8179,8180,8181,8182,8183,8184,