常先、大鴻以治民。順天地之紀、幽明之占、死生之說、存亡之難。時播百穀草木，淳化鳥獸蟲蛾，旁羅日月星辰水波土石金玉，勞勤心力耳目，節用水火材物。有土德之瑞，故號黃帝。","mentions":[{"id":"c-shiji-001-wudi:m003-0114","start":114,"end":116,"surface":"風后","kind":"person","person_id":"7yv_ale_8x8","status":"source_identified"},{"id":"c-shiji-001-wudi:m003-0117","start":117,"end":119,"surface":"力牧","kind":"person","person_id":"kq9_ezn_kth","status":"source_identified"},{"id":"c-shiji-001-wudi:m003-0120","start":120,"end":122,"surface":"常先","kind":"person","person_id":"sha_lef_21n","status":"source_identified"},{"id":"c-shiji-001-wudi:m003-0123","start":123,"end":125,"surface":"大鴻","kind":"person","person_id":"rkl_vgh_l0q","status":"source_identified"},{"id":"c-shiji-001-wudi:m003-0199","start":199,"end":201,"surface":"黃帝","kind":"person","person_id":"8jz_o3s_obt","status":"source_identified"}],"chapter_id":"c-shiji-001-wudi","book_id":"b-shiji-001","work_id":"w-shiji","source_id":"s-shiji-001-wudi"}],"sources":[{"chapter_id":"c-shiji-001-wudi","work_id":"w-shiji","book_id":"b-shiji-001","source_id":"s-shiji-001-wudi","source":{"title":"史記／卷001","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷001","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷001&oldid=7903634","revision_id":7903634,"accessed_on":"2026-10-09","extent":"正文全文；不含現代章節標題、跨維基說明與校勘記","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫 CC BY-SA 4.0，保留署名及版本連結。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{"弃":"棄","异":"異"},"note":"保留古代異體；移除現代註號，兩個簡體字形明記轉換。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical"}}
