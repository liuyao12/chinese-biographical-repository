ily:p024"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-061-zhou-family:p022:m0110","mention_ids":["c-jinshu-061-zhou-family:p022:m0110"],"kind":"paragraph"},{"canonical_mention_id":"c-jinshu-061-zhou-family:p024:m0002","mention_ids":["c-jinshu-061-zhou-family:p024:m0002"],"kind":"paragraph"},{"canonical_mention_id":"c-jinshu-061-zhou-family:p024:m0040","mention_ids":["c-jinshu-061-zhou-family:p024:m0040"],"kind":"paragraph"},{"canonical_mention_id":"c-jinshu-061-zhou-family:p024:m0159","mention_ids":["c-jinshu-061-zhou-family:p024:m0159"],"kind":"paragraph"}],"mention_count":4,"duplicate_mention_count":0,"paragraph_occurrence_count":4,"table_occurrence_count":0,"passage_count":2,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"4處獨立位置，4個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-061-ws7903772"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-061-zhou-family:p022:m0110","start":110,"end":112,"surface":"華譚","kind":"person","person_id":"qg9_lis_fdj","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。","paragraph_id":"c-jinshu-061-zhou-family:p022","chapter_id":"c-jinshu-061-zhou-family"},{"id":"c-jinshu-061-zhou-family:p024:m0002","start":2,"end":4,"surface":"華譚","kind":"person","person_id":"qg9_lis_fdj","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。","paragraph_id":"c-jinshu-061-zhou-family:p024","chapter_id":"c-jinshu-061-zhou-family"},{"id":"c-jinshu-061-zhou-family:p024:m0040","start":40,"end":41,"surface":"譚","kind":"person","person_id":"qg9_lis_fdj","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。","paragraph_id":"c-jinshu-061-zhou-family:p024","chapter_id":"c-jinshu-061-zhou-family"},{"id":"c-jinshu-061-zhou-family:p024:m0159","start":159,"end":160,"surface":"譚","kind":"person","person_id":"qg9_lis_fdj","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。","paragraph_id":"c-jinshu-061-zhou-family:p024","chapter_id":"c-jinshu-061-zhou-family"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-061-zhou-family:p022","text":"馥自經世故，每欲維正朝遷，忠情懇至。以東海王越不盡臣節，每言論厲然，越深憚之。馥睹群賊孔熾，洛陽孤危，乃建策迎天子遷都壽春。永嘉四年，與長史吳思、司馬殷識上書曰：「不圖厄運遂至於此！戎狄交侵，畿甸危逼。臣輒與祖納、裴憲、華譚、孫惠等三十人伏思大計，僉以殷人有屢遷之事，周王有岐山之徙，方今王都罄乏，不可久居，河朔蕭條，崤函險澀，宛都屢敗，江漢多虞，於今平夷，東南為愈。淮揚之地，北阻塗山，南抗靈嶽，名川四帶，有重險之固。是以楚人東遷，遂宅壽春，徐邳、東海，亦足戍禦。且運漕四通，無患空乏。雖聖上神聰，元輔賢明，居儉守約，用保宗廟，未若相土遷宅，以享永祚。臣謹選精卒三萬，奉迎皇駕。輒檄前北中郎將裴憲行使持節、監豫州諸軍事、東中郎將，風馳即路。荊、湘、江、揚各先運四年米租十五萬斛，布絹各十四萬匹，以供大駕。令王浚、苟晞共平河朔，臣等戮力以啟南路。遷都弭寇，其計並得。皇輿來巡，臣宜轉據江州，以恢王略。知無不為，古人所務，敢竭忠誠，庶報萬分。朝遂夕隕，猶生之願。」","source_position":{"raw_start":3644,"raw_end":4084,"raw_text":"　　馥自經世故，每欲維正朝遷，忠情懇至。以東海王越不盡臣節，每言論厲然，越深憚之。馥睹群賊孔熾，洛陽孤危，乃建策迎天子遷都壽春。{{YL|永嘉四年}}，與長史吳思、司馬殷識上書曰：「不圖厄運遂至於此！戎狄交侵，畿甸危逼。臣輒與祖納、裴憲、華譚、孫惠等三十人伏思大計，僉以殷人有屢遷之事，周王有岐山之徙，方今王都罄乏，不可久居，河朔蕭條，崤函險澀，宛都屢敗，江漢多虞，於今平夷，東南為愈。淮揚之地，北阻塗山，南抗靈嶽，名川四帶，有重險之固。是以楚人東遷，遂宅壽春，徐邳、東海，亦足戍禦。且運漕四通，無患空乏。雖聖上神聰，元輔賢明，居儉守約，用保宗廟，未若相土遷宅，以享永祚。臣謹選精卒三萬，奉迎皇駕。輒檄前北中郎將裴憲行使持節、監豫州諸軍事、東中郎將，風馳即路。荊、湘、江、揚各先運四年米租十五萬斛，布絹各十四萬匹，以供大駕。令王浚、苟晞共平河朔，臣等戮力以啟南路。遷都弭寇，其計並得。皇輿來巡，臣宜轉據江州，以恢王略。知無不為，古人所務，敢竭忠誠，庶報萬分。朝遂夕隕，猶生之願。」","display_wrapper_start":0,"display_wrapper_end":0,"raw_path":"sources/jinshu/wikisource-7903772-raw.wikitext"},"mentions":[{"id":"c-jinshu-061-zhou-family:p022:m0000","start":0,"end":1,"surface":"馥","kind":"person","person_id":"3xx_gdy_or6_BA","status":"contextual_provisional","interpretation_note":"076王廙元帝鎮江左、討周馥脈絡與本段相合；不是只從單字馥匹配韓馥。"},{"id":"c-jinshu-061-zhou-family:p022:m0019","start":19,"end":23,"surface":"東海王越","kind":"person","person_id":"9o2_vhv_r7y","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p022:m0034","start":34,"end":35,"surface":"越","kind":"person","person_id":"9o2_vhv_r7y","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p022:m0037","start":37,"end":38,"surface":"之","kind":"pronoun","person_id":"3xx_gdy_or6_BA","status":"contextual_provisional","interpretation_note":"076王廙元帝鎮江左、討周馥脈絡與本段相合；不是只從單字馥匹配韓馥。"},{"id":"c-jinshu-061-zhou-family:p022:m0039","start":39,"end":40,"surface":"馥","kind":"person","person_id":"3xx_gdy_or6_BA","status":"contextual_provisional","interpretation_note":"076王廙元帝鎮江左、討周馥脈絡與本段相合；不是只從單字馥匹配韓馥。"},{"id":"c-jinshu-061-zhou-family:p022:m0055","start":55,"end":57,"surface":"天子","kind":"person","person_id":"83d_b6e_058","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p022:m0070","start":70,"end":72,"surface":"吳思","kind":"person","person_id":"tkp_cdo_e94","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p022:m0075","start":75,"end":77,"surface":"殷識","kind":"person","person_id":"6t3_j7f_7zc","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p022:m0104","start":104,"end":106,"surface":"祖納","kind":"person","person_id":"os1_o1j_rih","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p022:m0107","start":107,"end":109,"surface":"裴憲","kind":"person","person_id":"c6e_8f3_014","status":"context