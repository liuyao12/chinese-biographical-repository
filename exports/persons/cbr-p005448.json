":"c-shiji-097-luli:m018-0211","start":211,"end":214,"surface":"辟陽侯","kind":"person","person_id":"697_9f9_d41","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m018-0215","start":215,"end":218,"surface":"辟陽侯","kind":"person","person_id":"697_9f9_d41","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m018-0223","start":223,"end":226,"surface":"平原君","kind":"person","person_id":"tkc_9z3_91l","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m018-0227","start":227,"end":230,"surface":"平原君","kind":"person","person_id":"tkc_9z3_91l","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m018-0232","start":232,"end":235,"surface":"辟陽侯","kind":"person","person_id":"697_9f9_d41","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m018-0236","start":236,"end":239,"surface":"辟陽侯","kind":"person","person_id":"697_9f9_d41","status":"contextual_provisional"}],"chapter_id":"c-shiji-097-luli","book_id":"b-shiji-097","work_id":"w-shiji","source_id":"s-shiji-097-luli"},{"id":"c-shiji-097-luli:p019","text":"呂太后崩，大臣誅諸呂，辟陽侯於諸呂至深，而卒不誅。計畫所以全者，皆陸生、平原君之力也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-097-luli:m019-0000","start":0,"end":3,"surface":"呂太后","kind":"person","person_id":"otq_r9b_d3z","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m019-0011","start":11,"end":14,"surface":"辟陽侯","kind":"person","person_id":"697_9f9_d41","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m019-0033","start":33,"end":35,"surface":"陸生","kind":"person","person_id":"fjo_zh4_b7q","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m019-0036","start":36,"end":39,"surface":"平原君","kind":"person","person_id":"tkc_9z3_91l","status":"contextual_provisional"}],"chapter_id":"c-shiji-097-luli","book_id":"b-shiji-097","work_id":"w-shiji","source_id":"s-shiji-097-luli"},{"id":"c-shiji-097-luli:p020","text":"孝文帝時，淮南厲王殺辟陽侯，以諸呂故。文帝聞其客平原君為計策，使吏捕欲治。聞吏至門，平原君欲自殺。諸子及吏皆曰：「事未可知，何早自殺為？」平原君曰：「我死禍絕，不及而身矣。」遂自剄。孝文帝聞而惜之，曰：「吾無意殺之。」乃召其子，拜為中大夫。使匈奴，單于無禮，乃罵單于，遂死匈奴中。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-097-luli:m020-0000","start":0,"end":3,"surface":"孝文帝","kind":"person","person_id":"q5g_lr6_7vc","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m020-0005","start":5,"end":9,"surface":"淮南厲王","kind":"person","person_id":"k4e_4tr_lg0","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m020-0010","start":10,"end":13,"surface":"辟陽侯","kind":"person","person_id":"697_9f9_d41","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m020-0019","start":19,"end":21,"surface":"文帝","kind":"person","person_id":"q5g_lr6_7vc","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m020-0024","start":24,"end":27,"surface":"平原君","kind":"person","person_id":"tkc_9z3_91l","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m020-0042","start":42,"end":45,"surface":"平原君","kind":"person","person_id":"tkc_9z3_91l","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m020-0049","start":49,"end":51,"surface":"諸子","kind":"unresolved","person_id":null,"status":"unresolved","note":"來源未名群體，不補具名成員或確切子序數。"},{"id":"c-shiji-097-luli:m020-0069","start":69,"end":72,"surface":"平原君","kind":"person","person_id":"tkc_9z3_91l","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m020-0091","start":91,"end":94,"surface":"孝文帝","kind":"person","person_id":"q5g_lr6_7vc","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m020-0111","start":111,"end":113,"surface":"其子","kind":"person","person_id":"tkc_9z3_91l_B","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m020-0124","start":124,"end":126,"surface":"單于","kind":"person","person_id":"7wk_awi_f4x","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m020-0131","start":131,"end":133,"surface":"單于","kind":"person","person_id":"7wk_awi_f4x","status":"contextual_provisional"}],"chapter_id":"c-shiji-097-luli","book_id":"b-shiji-097","work_id":"w-shiji","source_id":"s-shiji-097-luli"},{"id":"c-shiji-097-luli:p024","text":"太史公曰：世之傳酈生書，多曰漢王已拔三秦，東擊項籍而引軍於鞏洛之閒，酈生被儒衣往說漢王。乃非也。自沛公未入關，與項羽別而至高陽，得酈生兄弟。余讀陸生新語書十二篇，固當世之辯士。至平原君子與余善，是以得具論之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-097-luli:m024-0000","start":0,"end":3,"surface":"太史公","kind":"person","person_id":"cez_le6_frl","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m024-0008","start":8,"end":10,"surface":"酈生","kind":"person","person_id":"exh_47e_0gw","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m024-0014","start":14,"end":16,"surface":"漢王","kind":"person","person_id":"jz7_3ie_0jf","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m024-0023","start":23,"end":25,"surface":"項籍","kind":"person","person_id":"50g_j9s_2le","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m024-0034","start":34,"end":36,"surface":"酈生","kind":"person","person_id":"exh_47e_0gw","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m024-0041","start":41,"end":43,"surface":"漢王","kind":"person","person_id":"jz7_3ie_0jf","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m024-0049","start":49,"end":51,"surface":"沛公","kind":"person","person_id":"jz7_3ie_0jf","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m024-0056","start":56,"end":58,"surface":"項羽","kind":"person","person_id":"50g_j9s_2le","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m024-0065","start":65,"end":67,"surface":"酈生","kind":"person","person_id":"exh_47e_0gw","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m024-0072","start":72,"end":74,"surface":"陸生","kind":"person","person_id":"fjo_zh4_b7q","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m024-0089","start":89,"end":92,"surface":"平原君","kind":"person","person_id":"tkc_9z3_91l","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m024-0092","start":92,"end":93,"surface":"子","kind":"person","person_id":"tk