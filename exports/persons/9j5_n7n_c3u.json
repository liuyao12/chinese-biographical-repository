d_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-songshu-066-wangjinghong:line012:m0137","start":137,"end":139,"surface":"桓偉","kind":"person","person_id":"9j5_n7n_c3u","status":"contextual_provisional","paragraph_id":"c-songshu-066-wangjinghong:line012","chapter_id":"c-songshu-066-wangjinghong"},{"id":"c-songshu-093-recluses:line062:m0164","start":164,"end":166,"surface":"桓偉","kind":"person","person_id":"9j5_n7n_c3u","status":"contextual_provisional","paragraph_id":"c-songshu-093-recluses:line062","chapter_id":"c-songshu-093-recluses"}],"relations":[],"title_holdings":[{"id":"th-songshu-093-62-160","person_id":"9j5_n7n_c3u","title":"荊州刺史","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"work_id":"w-songshu","book_id":"b-songshu-093","source_id":"s-songshu-093-recluses","chapter_id":"c-songshu-093-recluses","paragraph_id":"c-songshu-093-recluses:line062","quote":"少孤貧，爲外祖徴士何准所撫育。從叔獻之及太原王恭，並貴重之。晉安帝隆安中，爲琅邪王中軍參軍，遷司徒主簿。家貧，而性好山水，求爲烏程令，尋以病歸。桓玄輔晉，桓謙以爲衞軍參軍。時琅邪殷仲文還姑孰，祖送傾朝，謙要弘之同行，答曰：「凡祖離送別，必在有情，下官與殷風馬不接，無縁扈從。」謙貴其言。母隨兄鎭之之安成郡，弘之解職同行，荊州刺史桓偉請爲南蠻長史。義熙初，何無忌又請爲右軍司馬。髙祖命爲徐州治中從事史，除員外散騎常侍，並不就。家在會稽上虞。從兄敬弘爲吏部尚書，奏曰：「聖明司契，載德惟新，垂鑑仄微，表揚隱介，默語仰風，荒遐傾首。前員外散騎常侍琅邪王弘之，恬漠丘園，放心居逸。前衞將軍參軍武昌郭希林，素履純潔，嗣徽前武。並撃壤聖朝，未蒙表飾，宜加旌聘，賁于丘園，以彰止遜之美，以祛動求之累。臣愚謂弘之可太子庶子，希林可著作郎。」即徴弘之爲庶子，不就。太祖即位，敬弘爲左僕射，又陳：「弘之髙行表於初筮，苦節彰於暮年，今内外晏然，當修太平之化，宜招空谷，以敦沖退之美。」元嘉四年，徴爲通直散騎常侍，又不就。敬弘嘗解貂裘與之，即着以采藥。","person_mention_id":"c-songshu-093-recluses:line062:m0164"}],"attestations":[{"id":"th-songshu-093-62-160:a001","paragraph_id":"c-songshu-093-recluses:line062","start":160,"end":164,"surface":"荊州刺史","person_mention_id":"c-songshu-093-recluses:line062:m0164","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"逐字記錄本次任官或文獻用稱；未知起訖留空，不以卒年終止所有官職，不將府主官爵當本人的爵位。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-songshu-066-wangjinghong:line012","text":"敬弘少有清尚，起家本國左常侍，衛軍參軍。性恬靜，樂山水。為天門太守。敬弘妻，桓玄姊也。敬弘之郡，玄時為荊州，遣信要令過。敬弘至巴陵，謂人曰：「靈寶見要，正當欲與其姊集聚耳，我不能為桓氏贅壻。」乃遣別船送妻往江陵。妻在桓氏，彌年不迎。山郡無事，恣其遊適，累日不回，意甚好之。轉桓偉安西長史、南平太守。去官，居作唐縣界。玄輔政及篡位，屢召不下。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-songshu-066-wangjinghong:line012:m0000","start":0,"end":2,"surface":"敬弘","kind":"person","person_id":"7r6_k52_qji_ABDABAA","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line012:m0034","start":34,"end":36,"surface":"敬弘","kind":"person","person_id":"7r6_k52_qji_ABDABAA","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line012:m0036","start":36,"end":37,"surface":"妻","kind":"person","person_id":"fml_n0s_qtz","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line012:m0038","start":38,"end":40,"surface":"桓玄","kind":"person","person_id":"lf6_f95_379","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line012:m0043","start":43,"end":45,"surface":"敬弘","kind":"person","person_id":"7r6_k52_qji_ABDABAA","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line012:m0048","start":48,"end":49,"surface":"玄","kind":"person","person_id":"lf6_f95_379","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line012:m0060","start":60,"end":62,"surface":"敬弘","kind":"person","person_id":"7r6_k52_qji_ABDABAA","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line012:m0071","start":71,"end":73,"surface":"靈寶","kind":"person","person_id":"lf6_f95_379","status":"contextual_provisional"},{"id":