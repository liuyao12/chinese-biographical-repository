ntions":[{"id":"c-jinshu-066-taokan:p008:m0040","surface":"陶延","start":40,"end":42,"person_id":"lyc_yq1_blx","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-066-taokan:p008","chapter_id":"c-jinshu-066-taokan"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-066-taokan:p008","text":"韜將王貢精卒三千，出武陵江，誘五溪夷，以舟師斷官運，徑向武昌。侃使鄭攀及伏波將軍陶延夜趣巴陵，潛師掩其不備，大破之，斬千餘級，降萬餘口。貢遁還湘城。賊中離阻，杜弢遂疑張奕而殺之，眾情益懼，降者滋多。王貢復挑戰，侃遙謂之曰：「杜弢為益州吏，盜用庫錢，父死不奔喪。卿本佳人，何為隨之也？天下寧有白頭賊乎！」貢初橫腳馬上，侃言訖，貢斂容下腳，辭色甚順。侃知其可動，復令諭之，截髮為信，貢遂來降。而韜敗走。進克長沙，獲其將毛寶、高寶、梁堪而還。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":43,"last_line":43,"raw_start":5074,"raw_end":5294,"raw_character_offsets":[5076,5077,5078,5079,5080,5081,5082,5083,5084,5085,5086,5087,5088,5089,5090,5091,5092,5093,5094,5095,5096,5097,5098,5099,5100,5101,5102,5103,5104,5105,5106,5107,5108,5109,5110,5111,5112,5113,5114,5115,5116,5117,5118,5119,5120,5121,5122,5123,5124,5125,5126,5127,5128,5129,5130,5131,5132,5133,5134,5135,5136,5137,5138,5139,5140,5141,5142,5143,5144,5145,5146,5147,5148,5149,5150,5151,5152,5153,5154,5155,5156,5157,5158,5159,5160,5161,5162,5163,5164,5165,5166,5167,5168,5169,5170,5171,5172,5173,5174,5175,5176,5177,5178,5179,5180,5181,5182,5183,5184,5185,5186,5187,5188,5189,5190,5191,5192,5193,5194,5195,5196,5197,5198,5199,5200,5201,5202,5203,5204,5205,5206,5207,5208,5209,5210,5211,5212,5213,5214,5215,5216,5217,5218,5219,5220,5221,5222,5223,5224,5225,5226,5227,5228,5229,5230,5231,5232,5233,5234,5235,5236,5237,5238,5239,5240,5241,5242,5243,5244,5245,5246,5247,5248,5249,5250,5251,5252,5253,5254,5255,5256,5257,5258,5259,5260,5261,5262,5263,5264,5265,5266,5267,5268,5269,5270,5271,5272,5273,5274,5275,5276,5277,5278,5279,5280,5281,5282,5283,5284,5285,5286,5287,5288,5289,5290,5291,5292,5293],"r