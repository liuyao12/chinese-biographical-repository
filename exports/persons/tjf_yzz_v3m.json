wangyun-family-ws1477957","paragraph_id":"c-nanshi-022-wangyun-family:p006","quote":"筠家累千金，性儉嗇，外服粗弊，所乘牛嘗飼以青草。及遇亂，舊宅先爲賊焚，乃寓居國子祭酒蕭子雲宅。夜忽有盜攻，懼墜井，卒，時年六十九。家人十三口同遇害，人棄屍積于空井中。","person_mention_id":"c-nanshi-022-wangyun-family:p006:m0042"}],"status":"source_attested","interpretation_note":"本句所載官名，任期無確切年月。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"th-nanshi022-wangyun-family-wyd-166-38","person_id":"tjf_yzz_v3m","title":"國子祭酒","kind":"office","mode":"attestation","attestations":[{"id":"th-nanshi022-wangyun-family-wyd-166-38:a","paragraph_id":"c-nanshi-022-wangyun-family-wyd:p006","start":32,"end":36,"surface":"國子祭酒","person_mention_id":"c-nanshi-022-wangyun-family-wyd:p006:m0036","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-022","chapter_id":"c-nanshi-022-wangyun-family-wyd","source_id":"s-nanshi-022-wangyun-family-wyd1739","paragraph_id":"c-nanshi-022-wangyun-family-wyd:p006","quote":"筠家累千金性儉嗇外服麤弊所乘牛嘗飼以青草及遇亂舊宅先為賊焚乃寓居國子祭酒蕭子雲宅夜忽有盜攻懼墜井卒時年六十九家人十二口同遇害人棄屍積於空井中","person_mention_id":"c-nanshi-022-wangyun-family-wyd:p006:m0036"}],"status":"source_attested","interpretation_note":"本句所載官名，任期無確切年月。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-080-wangxizhi-family:line126","text":"贊曰：書契之興，肇乎中古，繩文鳥跡，不足可觀。末代去朴歸華，舒箋點翰，爭相跨尚，競其工拙。伯英臨池之妙，無復餘蹤；師宜懸帳之奇，罕有遺跡。逮乎鐘王以降，略可言焉。鐘雖擅美一時，亦為回絕，論其盡善，或有所疑。至於布纖濃，分疏密，霞舒雲卷，無所間然。但其體則古而不今，字則長而逾制，語其大量，以此為瑕。獻之雖有父風，殊非新巧。觀其字勢疏瘦，如隆冬之枯樹；覽其筆蹤拘束，若嚴家之餓隸。其枯樹也，雖槎枿而無屈伸；其餓隸也，則羈羸而不放縱。兼斯二者，故翰墨之病歙！子雲近出，擅名江表，然僅得成書，無丈夫之氣，行行若縈春蚓，字字如綰秋蛇；臥王濛於紙中，坐徐偃於筆下；雖禿千兔之翰，聚無一毫之筋，窮萬谷之皮，斂無半分之骨；以茲播美，非其濫名邪！此數子者，皆譽過其實。所以詳察古今，研精篆素，盡善盡美，其惟王逸少乎！觀其點曳之工，裁成之妙，煙霏露結，狀若斷而還連；鳳翥龍蟠，勢如斜而反直。玩之不覺為倦，覽之莫識其端，心慕手追，此人而已。其餘區區之類，何足論哉！","text_layer":"received_compiler_appraisal","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-080-wangxizhi-family:line126:m0045","start":45,"end":47,"surface":"伯英","person_id":"9xv_kho_tfy","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。"},{"id":"c-jinshu-080-wangxizhi-family:line126:m0057","start":57,"end":59,"surface":"師宜","person_id":"8ka_y3u_oin","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。"},{"id":"c-jinshu-080-wangxizhi-family:line126:m0071","start":71,"end":72,"surface":"鐘","person_id":"9hu_q3h_aug","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。"},{"id":"c-jinshu-080-wangxizhi-family:line126:m0072","start":72,"end":73,"surface":"王","kind":"person","person_id":"326_faf_cd3","status":"contextual_provisional","interpretation_note":"書法史鐘王並稱，結語明書王逸少。"},{"id":"c-jinshu-080-wangxizhi-family:line126:m0081","start":81,"end":82,"surface":"鐘","person_id":"9hu_q3h_aug","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。"},{"id":"c-jinshu-080-wangxizhi-family:line126:m0149","start":149,"end":151,"surface":"獻之","person_id":"sm1_jfi_7k2","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。"},{"id":"c-jinshu-080-wangxizhi-family:line126:m0227","start":227,"end":229,"surface":"子雲","person_id":"tjf_yzz_v3m","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。"},{"id":"c-jinshu-080-wangxizhi-family:line126:u0264","start":264,"end":266,"surface":"王濛","person_id":null,"kind":"unresolved","status":"unresolved","unresolved_kind":"source_variant_identity","interpretation_note":"武英殿本卷末此句作王蒙；單憑書評譬喻不足確認為東晉司徒左長史王濛。"},{"id":"c-jinshu-080-wangxizhi-family:line126:u0271","start":271,"end":273,"surface":"徐偃","person_id":null,"kind":"unresolved","status":"unresolved",