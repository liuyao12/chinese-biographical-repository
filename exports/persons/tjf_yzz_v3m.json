erson_id":"tjf_yzz_v3m","title":"國子祭酒","kind":"office","mode":"attestation","attestations":[{"id":"th-liang033-wangyun-103-235:a","person_mention_id":"c-liangshu-033-wangyun:p005:m0239","usage":"narrative","date_expression":null,"paragraph_id":"c-liangshu-033-wangyun:p005","start":235,"end":239,"surface":"國子祭酒"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-033","source_id":"s-liangshu-033-wangyun-ws1514481","chapter_id":"c-liangshu-033-wangyun","paragraph_id":"c-liangshu-033-wangyun:p005","quote":"普通元年，以母憂去職。筠有孝性，毀瘠過禮，服闋後，疾廢久之。六年，除尚書吏部郎，遷太子中庶子，領羽林監，又改領步兵。中大通二年，遷司徒左長史。三年，昭明太子薨，敕爲哀策文，復見嗟賞。尋出爲貞威將軍、臨海太守，在郡被訟，不調累年。大同初，起爲雲麾豫章王長史，遷秘書監。五年，除太府卿。明年，遷度支尚書。中大同元年，出爲明威將軍、永嘉太守，以疾固辭，徙爲光祿大夫，俄遷雲騎將軍、司徒左長史。太清二年，侯景寇逼，筠時不入城。明年，太宗卽位，爲太子詹事。筠舊宅先爲賊所焚，乃寓居國子祭酒蕭子雲宅，夜忽有盜攻之，驚懼墜井卒，時年六十九。家人十餘人同遇害。","person_mention_id":"c-liangshu-033-wangyun:p005:m0239"}],"status":"source_attested","interpretation_note":"據該段授、遷、領、兼或單稱原字。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"th-liang033-wangyun-wyd-103-235","person_id":"tjf_yzz_v3m","title":"國子祭酒","kind":"office","mode":"attestation","attestations":[{"id":"th-liang033-wangyun-wyd-103-235:a","person_mention_id":"c-liangshu-033-wangyun-wyd:p005:m0197","usage":"narrative","date_expression":null,"paragraph_id":"c-liangshu-033-wangyun-wyd:p005","start":193,"end":197,"surface":"國子祭酒"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-033","source_id":"s-liangshu-033-wangyun-wyd1739","chapter_id":"c-liangshu-033-wangyun-wyd","paragraph_id":"c-liangshu-033-wangyun-wyd:p005","quote":"普通元年以母憂去職筠有孝性毀瘠過禮服闋後疾廢久之六年除尚書吏部郎遷太子中庶子領羽林監又改領步兵中大通二年遷司徒左長史三年昭明太子薨勅為哀策文復見嗟賞尋出為貞威將軍臨海太守在郡被訟不調累年大同初起為雲麾豫章王長史遷秘書監五年除太府卿明年遷度支尚書中大同元年出為明威將軍永嘉太守以疾固辭徙為光祿大夫俄遷雲騎將軍司徒左長史太清二年侯景寇逼筠時不入城明年太宗卽位為太子詹事筠舊宅先為賊所焚乃寓居國子祭酒蕭子雲宅夜忽有盜攻之驚懼墜井卒時年六十九家人十餘人同遇害","person_mention_id":"c-liangshu-033-wangyun-wyd:p005:m0197"}],"status":"source_attested","interpretation_note":"由殿本原職名、授遷領兼或單稱所在欄定位。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"th-nanshi022-wangyun-family-166-38","person_id":"tjf_yzz_v3m","title":"國子祭酒","kind":"office","mode":"attestation","attestations":[{"id":"th-nanshi022-wangyun-family-166-38:a","paragraph_id":"c-nanshi-022-wangyun-family:p006","start":38,"end":42,"surface":"國子祭酒","person_mention_id":"c-nanshi-022-wangyun-family:p006:m0042","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-022","chapter_id":"c-nanshi-022-wangyun-family","source_id":"s-nanshi-022-wangyun-family-ws1477957","paragraph_id":"c-nanshi-022-wangyun-family:p006","quote":"筠家累千金，性儉嗇，外服粗弊，所乘牛嘗飼以青草。及遇亂，舊宅先爲賊焚，乃寓居國子祭酒蕭子雲宅。夜忽有盜攻，懼墜井，卒，時年六十九。家人十三口同遇害，人棄屍積于空井中。","person_mention_id":"c-nanshi-022-wangyun-family:p006:m0042"}],"status":"source_attested","interpretation_note":"本句所載官名，任期無確切年月。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"th-nanshi022-wangyun-family-wyd-166-38","person_id":"tjf_yzz_v3m","title":"國子祭酒","kind":"office","mode":"attestation","attestations":[{"id":"th-nanshi022-wangyun-family-wyd-166-38:a","paragraph_id":"c-nanshi-022-wangyun-family-wyd:p006","start":32,"end":36,"surface":"國子祭酒","person_mention_id":"c-nanshi-022-wangyun-family-wyd:p006:m0036","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-022","chapter_id":"c-nanshi-022-wangyun-family-wyd","source_id":"s-nanshi-022-wangyun-family-wyd1739","paragraph_id":"c-nanshi-022-wangyun-family-wyd:p006","quote":"筠家累千金性儉嗇外服麤弊所乘牛嘗飼以青草及遇亂舊宅先為賊焚乃寓居國子祭酒蕭子雲宅夜忽有盜攻懼墜井卒時年六十九家人十二口同遇害人棄屍積於空井中","person_mention_id":"c-nanshi-022-wangyun-family-wyd:p006:m0036"}],"status":"source_attested","interpretation_note":"本句所載官名，任期無確切年月。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-080-wangxizhi-family:line126","text":"贊曰：書契之興，肇乎中古，繩文鳥跡，不足可觀。末代去朴歸華，舒箋點翰，爭相跨尚，競其工拙。伯英臨池之妙，無復餘蹤；師宜懸帳之奇，罕有遺跡。逮乎鐘王以降，略可言焉。鐘雖擅美一時，亦為回絕，論其盡善，或有所疑。至於布纖濃，分疏密，霞舒雲卷，無所間然。但其體則古而不今，字則長而逾制，語其大量，以此為瑕。獻之雖有父風，殊非新巧。觀其字勢疏瘦，如隆冬之枯樹；覽其筆蹤拘束，若嚴家之餓隸。其枯樹也，雖槎枿而無屈伸；其餓隸也，則羈羸而不放縱。兼斯二者，故翰墨之病歙！子雲近出，擅名江表，然僅得成書，無丈夫之氣，行行若縈春蚓，字字如綰秋蛇；臥王濛於紙中，坐徐偃於筆下；雖禿千兔之翰，聚無一毫之筋，窮萬谷之皮，斂無半分之骨；以茲播美，非其濫名邪！此數子者，皆譽過其實。所以詳察古今，研精篆素，盡善盡美，其惟王逸少乎！觀其點曳之工，裁成之妙，煙霏露結，狀若斷而還連；鳳翥龍蟠，勢如斜而反直。玩之不覺為倦，覽之莫識其端，心慕手追，此人而已。其餘區區之類，何足論哉！","text_layer":"received_compiler_appraisal","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-080-wangxizhi-family:line126:m0045","start":45,"end":47,"surface":"伯英","person_id":"9xv_kho_tfy","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。"},{"id":"c-jinshu-080-wangxizhi-family:line126:m0057","start":57,"end":59,"surface":"師宜","person_id":"8ka_y3u_oin","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。"},{"id":"c-jinshu-080-wangxizhi-family:line126:m0071","start":71,"end":72,"surface":"鐘","person_id":"9hu_q3h_aug","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。"},{"id":"c-jinshu-080-wangxizhi-family:line126:m0072","start":72,"end":73,"surface":"王","kind":"person","person_id":"326_faf_cd3","status":"contextual_provisional","interpretation_note":"書法史鐘王並稱，結語明書王逸少。"},{"id":"c-jinshu-080-wangxizhi-family:line126:m0081","start":81,"end":82,"surface":"鐘","person_id":"9hu_q3h_aug","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。"},{"id":"c-jinshu-080-wangxizhi-family:line126:m0149","start":149,"end":151,"surface":"獻之","person_id":"sm1_jfi_7k2","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。"},{"id":"c-jinshu-080-wangxizhi-family:line126:m0227","start":227,"end":229,"surface":"子雲","person_id":"tjf_yzz_v3m","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。"},{"id":"c-jinshu-080-wangxizhi-family:line126:u0264","start":264,"end":266,"surface":"王濛","person_id":null,"kind":"unresolved","status":"unresolved","unresolved_kind":"source_variant_identity","interpretation_note":"武英殿本卷末此句作王蒙；單憑書評譬喻不足確認為東晉司徒左長史王濛。"},{"id":"c-jinshu-080-wangxizhi-family:line126:u0271","start":271,"end":273,"surface":"徐偃","person_id":null,"kind":"unresolved","status":"unresolved","unresolved_kind":"source_variant_identity","interpretation_note":"指書勢失骨的比喻；可能取徐偃王故事，與漢儒徐偃區別。此句不具王號。"},{"id":"c-jinshu-080-wangxizhi-family:line126:m0345","start":345,"end":348,"surface":"王逸少","person_id":"326_faf_cd3","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。"}],"source_position":{"first_line":126,"last_line":126,"raw_start":7796,"raw_end":8220,"revision_id":2603570},"chapter_id":"c-jinshu-080-wangxizhi-family","book_id":"b-jinshu-080","work_id":"w-jinshu","source_id":"s-jinshu-080-wangxizhi-family"},{"id":"c-liangshu-033-wangyun-wyd:p005","text":"普通元年以母憂去職筠有孝性毀瘠過禮服闋後疾廢久之六年除尚書吏部郎遷太子中庶子領羽林監又改領步兵中大通二年遷司徒左長史三年昭明太子薨勅為哀策文復見嗟賞尋出為貞威將軍臨海太守在郡被訟不調累年大同初起為雲麾豫章王長史遷秘書監五年除太府卿明年遷度支尚書中大同元年出為明威將軍永嘉太守以疾固辭徙為光祿大夫俄遷雲騎將軍司徒左長史太清二年侯景寇逼筠時不入城明年太宗卽位為太子詹事筠舊宅先為賊所焚乃寓居國子祭酒蕭子雲宅夜忽有盜攻之驚懼墜井卒時年六十九家人十餘人同遇害","mentions":[{"id":"c-liangshu-033-wangyun-wyd:p005:m0009","person_id":"mxz_qw8_acd_A","surface":"筠","start":9,"end":10,"kind":"person","status":"contextual_provisional","interpretation_note":"殿本依本段所書姓名與上下文。"},{"id":"c-liangshu-033-w