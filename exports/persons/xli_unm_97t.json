":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-044-liyin:line036:m0033","start":33,"end":36,"surface":"公孫度","kind":"person","person_id":"xli_unm_97t","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-044-liyin:line036","chapter_id":"c-jinshu-044-liyin"}],"relations":[],"title_holdings":[{"id":"th-w044-liyin-1","person_id":"xli_unm_97t","title":"遼東太守","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-044","chapter_id":"c-jinshu-044-liyin","source_id":"s-jinshu-044-liyin","paragraph_id":"c-jinshu-044-liyin:line036","quote":"李胤，字宣伯，遼東襄平人也。祖敏，漢河內太守，去官還鄉里，遼東太守公孫度欲強用之，敏乘輕舟浮滄海，莫知所終。胤父信追求積年，浮海出塞，竟無所見，欲行喪制服，則疑父尚存，情若居喪而不聘娶。後有鄰居故人與其父同年者亡，因行喪制服。燕國徐邈與之同州裏，以不孝莫大於無後，勸使娶妻。既生胤，遂絕房室，恆如居喪禮，不堪其憂，數年而卒。胤既幼孤，母又改行，有識之後，降食哀戚，亦以喪禮自居。又以祖不知存亡，設木主以事之。由是以孝聞。容貌質素，頹然若不足者，而知度沈邃，言必有則。","person_mention_id":"c-jinshu-044-liyin:line036:m0033"}],"attestations":[{"id":"th-w043-liyin-1:a","paragraph_id":"c-jinshu-044-liyin:line036","start":29,"end":33,"surface":"遼東太守","person_mention_id":"c-jinshu-044-liyin:line036:m0033","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-044-liyin:line036","text":"李胤，字宣伯，遼東襄平人也。祖敏，漢河內太守，去官還鄉里，遼東太守公孫度欲強用之，敏乘輕舟浮滄海，莫知所終。胤父信追求積年，浮海出塞，竟無所見，欲行喪制服，則疑父尚存，情若居喪而不聘娶。後有鄰居故人與其父同年者亡，因行喪制服。燕國徐邈與之同州裏，以不孝莫大於無後，勸使娶妻。既生胤，遂絕房室，恆如居喪禮，不堪其憂，數年而卒。胤既幼孤，母又改行，有識之後，降食哀戚，亦以喪禮自居。又以祖不知存亡，設木主以事之。由是以孝聞。容貌質素，頹然若不足者，而知度沈邃，言必有則。","text_layer":"received_chapter","annot