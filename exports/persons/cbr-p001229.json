d","evidence":[{"chapter_id":"c-shiji-033-lu","source_id":"s-shiji-033-lu","paragraph_id":"c-shiji-033-lu:p025","quote":"伯御即位十一年，周宣王伐魯，殺其君伯御，而問魯公子能道順諸矦者，以爲魯後。樊穆仲曰：『魯懿公弟稱，肅恭明神，敬事耆老；賦事行刑，必問於遺訓而咨於固實；不干所問，不犯所（知）［咨］。』宣王曰：『然，能訓治其民矣。』乃立稱於夷宮，是爲孝公。自是後，諸矦多畔王命。"}],"qualifiers":{"source_term":"弟","historicity":"historical_tradition"},"interpretation_note":"逐項保存本文子、父、母、弟、兄、娣及妻妾的記載。賤妾不改稱夫人；不以繼位、後裔氏族或私通補親屬。原文生子允承接惠公自妻宋女，並非由攝政或繼位推父子。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji033-016","subject_person_id":"cbr-p001230","predicate":"father","object_person_id":"cbr-p001229","status":"source_attested","evidence":[{"chapter_id":"c-shiji-033-lu","source_id":"s-shiji-033-lu","paragraph_id":"c-shiji-033-lu:p027","quote":"二十七年，孝公卒，子弗湟立，是爲惠公。"}],"qualifiers":{"source_term":"子","historicity":"historical_tradition"},"interpretation_note":"逐項保存本文子、父、母、弟、兄、娣及妻妾的記載。賤妾不改稱夫人；不以繼位、後裔氏族或私通補親屬。原文生子允承接惠公自妻宋女，並非由攝政或繼位推父子。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji033-008","person_id":"cbr-p001229","title":"孝公","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-033-lu","source_id":"s-shiji-033-lu","paragraph_id":"c-shiji-033-lu:p025","quote":"乃立稱於夷宮，是爲孝公。"}],"attestations":[{"id":"th-shiji033-008:a001","paragraph_id":"c-shiji-033-lu:p025","start":115,"end":117,"surface":"孝公","person_mention_id":"c-shiji-033-lu:m025-0108","usage":"retrospective"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"來源用稱與授予分開；公號作敘事追稱暫解，不把即位當成當時授予諡號。未知日期及終點不按卒日補造。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji033-063","person_id":"cbr-p001229","surfaces":["孝公","稱"],"scope":"same_chapter","chapter_ids":["c-shiji-033-lu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-033-lu:p025","quote":"伯御即位十一年，周宣王伐魯，殺其君伯御，而問魯公子能道順諸矦者，以爲魯後。樊穆仲曰：『魯懿公弟稱，肅恭明神，敬事耆老；賦事行刑，必問於遺訓而咨於固實；不干所問，不犯所（知）［咨］。』宣王曰：『然，能訓治其民矣。』乃立稱於夷宮，是爲孝公。自是後，諸矦多畔王命。"},{"paragraph_id":"c-shiji-033-lu:p026","quote":"孝公二十五年，諸矦畔周，犬戎殺幽王。秦始列爲諸矦。"},{"paragraph_id":"c-shiji-033-lu:p027","quote":"二十七年，孝公卒，子弗湟立，是爲惠公。"}],"rationale":"按懿公被弒至魯文公的敘事角色、同段明示子／弟與柯盟、齊襄公殺魯桓公、晉立惠公等具體事件暫定異稱；同字爵稱依國別分開。公子揮不與前篇公子翚、晉襄父不與晉襄公、宣伯不與叔孫宣伯自動合併。數位疑讀與親屬異說仍待核對。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-033-lu:p025","text":"伯御即位十一年，周宣王伐魯，殺其君伯御，而問魯公子能道順諸矦者，以爲魯後。樊穆仲曰：『魯懿公弟稱，肅恭明神，敬事耆老；賦事行刑，必問於遺訓而咨於固實；不干所問，不犯所（知）［咨］。』宣王曰：『然，能訓治其民矣。』乃立稱於夷宮，是爲孝公。自是後，諸矦多畔王命。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-033-lu:m025-0000","start":0,"end":2,"surface":"伯御","kind":"person","person_id":"cbr-p001227","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m025-0008","start":8,"end":11,"surface":"周宣王","kind":"person","person_id":"cbr-p000213","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m025-0017","start":17,"end":19,"surface":"伯御","kind":"person","person_id":"cbr-p001227","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m025-0022","start":22,"end":25,"surface":"魯公子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未指名者、地點氏稱、未定官稱或未解指代；不補姓名、成員與父系。"},{"id":"c-shiji-033-lu:m025-0028","start":28,"end":30,"surface":"諸矦","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未指名者、地點氏稱、未定官稱或未解指代；不補姓名、成員與父系。"},{"id":"c-shiji-033-lu:m025-0037","start":37,"end":40,"surface":"樊穆仲","kind":"person","person_id":"cbr-p001228","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m025-0043","start":43,"end":46,"surface":"魯懿公","kind":"person","person_id":"cbr-p001225","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m025-0047","start":47,"end":48,"surface":"稱","kind":"person","person_id":"cbr-p001229","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m025-0091","start":91,"end":93,"surface":"宣王","kind":"person","person_id":"cbr-p000213","sta