{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004996","identity_policy":"contextual_provisional","person_ids":["cbr-p004996"],"persons":[{"id":"cbr-p004996","label":"李良從官進言者未名（張耳陳餘列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"從官有一人","mention_ids":["c-shiji-089-zhanger:m014-0151"]}],"evidence":[{"mention_id":"c-shiji-089-zhanger:m014-0151","chapter_id":"c-shiji-089-zhanger","paragraph_id":"c-shiji-089-zhanger:p014","quote":"從官有一人"}]}],"source_mention_summary":[{"source_id":"s-shiji-089-zhanger","work_id":"w-shiji","book_id":"b-shiji-089","chapter_id":"c-shiji-089-zhanger","mention_count":1,"mention_ids":["c-shiji-089-zhanger:m014-0151"],"paragraph_ids":["c-shiji-089-zhanger:p014"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-089-zhanger"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-089-zhanger:m014-0151","start":151,"end":156,"surface":"從官有一人","kind":"person","person_id":"cbr-p004996","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p014","chapter_id":"c-shiji-089-zhanger"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji089-019","person_id":"cbr-p004996","scope":"same_chapter","chapter_ids":["c-shiji-089-zhanger"],"status":"contextual_provisional","rationale":"按明示姓名及局部語境承接；武臣與趙歇、張敖的趙王用稱限各段，張黡張黶按同行事件暫接但原字分存。未名者不補姓名。","reviewer":"Codex（AI 代理）","surfaces":["從官有一人"],"evidence":[{"paragraph_id":"c-shiji-089-zhanger:p014","quote":"李良已定常山，還報，趙王復使良略太原。至石邑，秦兵塞井陘，未能前。秦將詐稱二世使人遺李良書，不封，曰：「良嘗事我得顯幸。良誠能反趙爲秦，赦良罪，貴良。」良得書，疑不信。乃還之邯鄲，益請兵。未至，道逢趙王姊出飲，從百餘騎。李良望見，以爲王，伏謁道旁。王姊醉，不知其將，使騎謝李良。李良素貴，起，慚其從官。從官有一人曰：「天下畔秦，能者先立。且趙王素出將軍下，今女兒乃不爲將軍下車，請追殺之。」李良已得秦書，固欲反趙，未決，因此怒，遣人追殺王姊道中，乃遂將其兵襲邯鄲。邯鄲不知，竟殺武臣、邵騷。趙人多爲張耳、陳餘耳目者，以故得脱出。收其兵，得數萬人。客有説張耳曰：「兩君羈旅，而欲附趙，難；獨立趙後，扶以義，可就功。」乃求得趙歇，立爲趙王，居信都。李良進兵撃陳餘，陳餘敗李良，李良走歸章邯。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-089-zhanger:p014","text":"李良已定常山，還報，趙王復使良略太原。至石邑，秦兵塞井陘，未能前。秦將詐稱二世使人遺李良書，不封，曰：「良嘗事我得顯幸。良誠能反趙爲秦，赦良罪，貴良。」良得書，疑不信。乃還之邯鄲，益請兵。未至，道逢趙王姊出飲，從百餘騎。李良望見，以爲王，伏謁道旁。王姊醉，不知其將，使騎謝李良。李良素貴，起，慚其從官。從官有一人曰：「天下畔秦，能者先立。且趙王素出將軍下，今女兒乃不爲將軍下車，請追殺之。」李良已得秦書，固欲反趙，未決，因此怒，遣人追殺王姊道中，乃遂將其兵襲邯鄲。邯鄲不知，竟殺武臣、邵騷。趙人多爲張耳、陳餘耳目者，以故得脱出。收其兵，得數萬人。客有説張耳曰：「兩君羈旅，而欲附趙，難；獨立趙後，扶以義，可就功。」乃求得趙歇，立爲趙王，居信都。李良進兵撃陳餘，陳餘敗李良，李良走歸章邯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-089-zhanger:m014-0000","start":0,"end":2,"surface":"李良","kind":"person","person_id":"cbr-p005011","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m014-0010","start":10,"end":12,"surface":"趙王","kind":"person","person_id":"cbr-p004981","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m014-0014","start":14,"end":15,"surface":"良","kind":"person","person_id":"cbr-p005011","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m014-0033","start":33,"end":35,"surface":"秦將","kind":"person","person_id":"cbr-p005014","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m014-0037","start":37,"end":39,"surface":"二世","kind":"person","person_id":"cbr-p005015","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m014-0042","start":42,"end":44,"surface":"李良","kind":"person","person_id":"cbr-p005011","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m014-0052","start":52,"end":53,"surface":"良","kind":"person","person_id":"cbr-p005011","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m014-0060","start":60,"end":61,"surface":"良","kind":"person","person_id":"cbr-p005011","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m014-0069","start":69,"end":70,"surface":"良","kind":"person","person_id":"cbr-p005011","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m014-0073","start":73,"end":74,"surf