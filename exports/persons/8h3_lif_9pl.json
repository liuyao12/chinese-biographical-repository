hs":[],"mentions":[{"id":"c-jinshu-057-wu-yan:p001:m0074","surface":"劉劄","start":74,"end":76,"person_id":"8h3_lif_9pl","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-057-wu-yan:p001","chapter_id":"c-jinshu-057-wu-yan"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-057-wu-yan:p001","text":"吾彥，字士則，吳郡吳人也。出自寒微，有文武才幹。身長八尺，手格猛獸，旅力絕群。仕吳為通江吏。時將軍薛珝杖節南征，軍容甚盛，彥觀之，慨然而歎。有善相者劉劄謂之曰：「以君之相，後當至此，不足慕也。」初為小將，給吳大司馬陸抗。抗奇其勇略，將拔用之，患眾情不允，乃會諸將，密使人陽狂拔刀跳躍而來，坐上諸將皆懼而走，唯彥不動，舉幾禦之，眾服其勇，乃擢用焉。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":67,"last_line":67,"raw_start":5543,"raw_end":5716,"raw_character_offsets":[5543,5544,5545,5546,5547,5548,5549,5550,5551,5552,5553,5554,5555,5556,5557,5558,5559,5560,5561,5562,5563,5564,5565,5566,5567,5568,5569,5570,5571,5572,5573,5574,5575,5576,5577,5578,5579,5580,5581,5582,5583,5584,5585,5586,5587,5588,5589,5590,5591,5592,5593,5594,5595,5596,5597,5598,5599,5600,5601,5602,5603,5604,5605,5606,5607,5608,5609,5610,5611,5612,5613,5614,5615,5616,5617,5618,5619,5620,5621,5622,5623,5624,5625,5626,5627,5628,5629,5630,5631,5632,5633,5634,5635,5636,5637,5638,5639,5640,5641,5642,5643,5644,5645,5646,5647,5648,5649,5650,5651,5652,5653,5654,5655,5656,5657,5658,5659,5660,5661,5662,5663,5664,5665,5666,5667,5668,5669,5670,5671,5672,5673,5674,5675,5676,5677,5678,5679,5680,5681,5682,5683,5684,5685,5686,5687,5688,5689,5690,5691,5692,5693,5694,5695,5696,5697,5698,5699,5700,5701,5702,5703,5704,5705,5706,5707,5708,5709,5710,5711,5712,5713,5714,5715],"revision_id":2413329},"mentions":[{"id":"c-jinshu-057-wu-yan:p001:m0000","surface":"吾彥","start":0,"end":2,"person_id":"zv2_5nr_ili","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-wu-yan:p001:m0004","surface":"士則","start":4,"end":6,"perso