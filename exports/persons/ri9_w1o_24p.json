gshu-050-yuan-xunzhi:p001:m0095","start":95,"end":96,"surface":"超","kind":"person","person_id":"ri9_w1o_24p","status":"contextual_provisional","paragraph_id":"c-songshu-050-yuan-xunzhi:p001","chapter_id":"c-songshu-050-yuan-xunzhi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-songshu-050-yuan-xunzhi:p001","text":"弟詢之，驍敢有氣力，元凶夙聞其名，以副輔國將軍張柬。時張超首行大逆，亦領軍隸柬。詢之規殺之，慮柬不同，柬宿有此志，又未測詢之同否，互相觀察。會超來論事，柬色動，詢之覺之，即共定謀，遣信召超。超疑之不至，改宿他所。詢之不知其移，逕斫之，殺其僕於牀，因與柬南奔。柬溺淮死，詢之得至。時世祖已即位，以為積弩將軍。梁山之役力戰，為流矢所中，死，追贈冀州刺史。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":54,"last_line":54,"raw_start":5027,"raw_end":5328,"raw_character_offsets":[5027,5028,5029,5030,5031,5032,5033,5034,5035,5036,5037,5038,5039,5040,5041,5042,5043,5044,5045,5046,5047,5048,5049,5050,5051,5052,5053,5054,5055,5056,5057,5058,5059,5060,5112,5113,5114,5115,5116,5117,5118,5119,5120,5121,5122,5123,5124,5125,5126,5127,5128,5168,5169,5170,5171,5172,5173,5174,5175,5176,5177,5178,5179,5180,5181,5218,5219,5220,5221,5222,5223,5224,5225,5226,5227,5228,5229,5230,5231,5232,5233,5234,5235,5236,5237,5238,5239,5240,5241,5242,5243,5244,5245,5246,5247,5248,5249,5250,5251,5252,5253,5254,5255,5256,5257,5258,5259,5260,5261,5262,5263,5264,5265,5266,5267,5268,5269,5270,5271,5272,5273,5274,5275,5276,5277,5278,5279,5280,5281,5282,5283,5284,5285,5286,5287,5288,5289,5290,5291,5292,5293,5294,5295,5296,5297,5298,5299,5300,5301,5302,5303,5304,5305,5306,5307,5308,5309,5310,5311,5312,5313,5314,5315,5316,5317,5318,5319,5320,5321,5322,5323,5324,5325,5326,5327],"revision_id":2371899},"mentions":[{"id":"c-songshu-050-yuan-xunzhi:p001:m0001","start":1,"end":3,"surface":"詢之","kind":"person","person_id":"bdx_txf_e62_AB","status":"contextual_provisional"},{"id":"c-songshu-050-yuan-xunzhi:p001:m0023","start":23,"end":25,