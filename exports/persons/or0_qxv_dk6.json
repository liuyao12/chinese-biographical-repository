078","c-shiji-043-zhao:p079","c-shiji-043-zhao:p081"],"passage_count":4}],"most_mentioned_source_ids":["s-shiji-043-zhao"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-043-zhao:m077-0069","start":69,"end":72,"surface":"田不禮","kind":"person","person_id":"or0_qxv_dk6","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p077","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m078-0028","start":28,"end":31,"surface":"田不禮","kind":"person","person_id":"or0_qxv_dk6","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p078","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m078-0226","start":226,"end":228,"surface":"不禮","kind":"person","person_id":"or0_qxv_dk6","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p078","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m078-0380","start":380,"end":383,"surface":"田不禮","kind":"person","person_id":"or0_qxv_dk6","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p078","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m079-0013","start":13,"end":16,"surface":"田不禮","kind":"person","person_id":"or0_qxv_dk6","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p079","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m081-0019","start":19,"end":22,"surface":"田不禮","kind":"person","person_id":"or0_qxv_dk6","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p081","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m081-0073","start":73,"end":76,"surface":"田不禮","kind":"person","person_id":"or0_qxv_dk6","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p081","chapter_id":"c-shiji-043-zhao"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji043-198","person_id":"or0_qxv_dk6","surfaces":["不禮","田不禮"],"scope":"same_chapter","chapter_ids":["c-shiji-043-zhao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-043-zhao:p077","quote":"三年，滅中山，遷其王於膚施。起靈壽，北地方從，代道大通。還歸，行賞，大赦，置酒酺五日，封長子章爲代安陽君。章素侈，心不服其弟所立。主父又使田不禮相章也。"},{"paragraph_id":"c-shiji-043-zhao:p078","quote":"李兌謂肥義曰：「公子章彊壯而志驕，黨衆而欲大，殆有私乎？田不禮之爲人也，忍殺而驕。二人相得，必有謀陰賊起，一出身徼幸。夫小人有欲，輕慮淺謀，徒見其利而不顧其害，同類相推，倶入禍門。以吾觀之，必不久矣。子任重而勢大，亂之所始，禍之所集也，子必先患。仁者愛萬物而智者備禍於未形，不仁不智，何以爲國？子奚不稱疾毋出，傳政於公子成？毋爲怨府，毋爲禍梯。」肥義曰：「不可，昔者主父以王屬義也，曰：『毋變而度，毋異而慮，堅守一心，以歿而世。』義再拜受命而籍之。今畏不禮之難而忘吾籍，變孰大焉。進受嚴命，退而不全，負孰甚焉。變負之臣，不容於刑。諺曰『死者復生，生者不愧』。吾言已在前矣，吾欲全吾言，安得全吾身！且夫貞臣也難至而節見，忠臣也累至而行明。子則有賜而忠我矣，雖然，吾有語在前者也，終不敢失。」李兌曰：「諾，子勉之矣！吾見子已今年耳。」涕泣而出。李兌數見公子成，以備田不禮之事。"},{"paragraph_id":"c-shiji-043-zhao:p079","quote":"異日肥義謂信期曰：「公子與田不禮甚可憂也。其於義也聲善而實惡，此爲人也不子不臣。吾聞之也，姦臣在朝，國之殘也；讒臣在中，主之蠹也。此人貪而欲大，内得主而外爲暴。矯令爲慢，以擅一旦之命，不難爲也，禍且逮國。今吾憂之，夜而忘寐，饑而忘食。盜賊出入不可不備。自今以來，若有召王者必見吾面，我將先以身當之，無故而王乃入。」信期曰：「善哉，吾得聞此也！」"},{"paragraph_id":"c-shiji-043-zhao:p081","quote":"主父及王游沙丘，異宮，公子章卽以其徒與田不禮作亂，詐以主父令召王。肥義先入，殺之。髙信卽與王戰。公子成與李兌自國至，乃起四邑之兵入距難，殺公子章及田不禮，滅其黨賊而定王室。公子成爲相，號安平君，李兌爲司寇。公子章之敗，往走主父，主主開之，成、兌因圍主父宮。公子章死，公子成、李兌謀曰：「以章故圍主父，卽解兵，吾屬夷矣。」乃遂圍主父。令宮中人「後出者夷」，宮中人悉出。主父欲出不得，又不得食，探爵鷇而食之，三月餘而餓死沙丘宮。主父定死，乃發喪赴諸侯。"}],"rationale":"限本篇人物、連續政治事件及明示生子是為敘事；武靈王／主父、王子何／惠文王及惠后吳娃按本文連接。公子章不與早期敬侯章合併，何不與較早趙何合併；髙信與信期、趙袑與周袑分候選。王賁不按熟知秦將同名接人。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-043-zhao:p077","text":"三年，滅中山，遷其王於膚施。起靈壽，北地方從，代道大通。還歸，行賞，大赦，置酒酺五日，封長子章爲代安陽君。章素侈，心不服其弟所立。主父又使田不禮相章也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-043-zhao:m077-0008","start":8,"end":10,"surface":"其王","kind":"person","person_id":"sia_mjg_t9v","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m077-0044","start":44,"end":47,"surface":"長子章","kind":"person","person_id":"txj_z8z_5me_AA","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m077-0048","start":48,"end":52,"surface":"代安陽君","kind":"person","person_id":"txj_z8z_5me_AA","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m077-0053","start":53,"end":54,"surface":"章","kind":"person","person_id":"txj_z8z_5me_AA","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m077-0060","start":60,"end":62,"surface":"其弟","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、代詞、未名君主或版本疑字保留；不把帝王泛稱、父子群體與未決分封當已確證身份或任期。"},{"id":"c-shiji-043-zhao:m077-0065","start":65,"end":67,"surface":"主父","kind":"person","person_id":"txj_z8z_5me_A","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m077-0069","start":69,"end":72,"surface":"田不禮","kind":"person","person_id":"or0_qxv_dk6","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m077-0073","start":73,"end":74,"surface":"章","kind":"person","person_id":"txj_z8z_5me_AA","status":"contextual_provisional"}],"chapter_id":"c-shiji-043-zhao","book_id":"b-shiji-043","work_id":"w-shiji","source_id":"s-shiji-043-zhao"},{"id":"c-shiji-043-zhao:p078","text":"李兌謂肥義曰：「公子章彊壯而志驕，黨衆而欲大，殆有私乎？田不禮之爲人也，忍殺而驕。二人相得，必有謀陰賊起，一出身徼幸。夫小人有欲，輕慮淺謀，徒見其利而不顧其害，同類相推，倶入禍門。以吾觀之，必不久矣。子任重而勢大，亂之所始，禍之所集也，子必先患。仁者愛萬物而智者備禍於未形，不仁不智，何以爲國？子奚不稱疾毋出，傳政於公子成？毋爲怨府，毋爲禍梯。」肥義曰：「不可，昔者主父以王屬義也，曰：『毋變而度，毋異而慮，堅守一心，以歿而世。』義再拜受命而籍之。今畏不禮之難而忘吾籍，變孰大焉。進受嚴命，退而不全，負孰甚焉。變負之臣，不容於刑。諺曰『死者復生，生者不愧』。吾言已在前矣，吾欲全吾言，安得全吾身！且夫貞臣也難至而節見，忠臣也累至而行明。子則有賜而忠我矣，雖然，吾有語在前者也，終不敢失。」李兌曰：「諾，子勉之矣！吾見子已今年耳。」涕泣而出。李兌數見公子成，以備田不禮之事。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-043-zhao:m078-0000","start":0,"end":2,"surface":"李兌","kind":"person","person_id":"g2v_d8d_els","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m078-0003","start":3,"end":5,"surface":"肥義","kind":