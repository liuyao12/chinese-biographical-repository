relations":[],"title_holdings":[{"reviewer":"Codex（AI代理）","human_reviewed":false,"model":null,"id":"th-ws058-jin-003","person_id":"sw9_lyh_sz9","title":"司徒","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"work_id":"w-weishu-weishou","book_id":"b-weishu-weishou-058","source_id":"s-weishu-weishou-058-yangjin-ws2087998","chapter_id":"c-weishu-weishou-058-yangjin","paragraph_id":"c-weishu-weishou-058-yangjin:p001","quote":"順弟津，字羅漢，本名延祚，高祖賜名焉。少端謹，以器度見稱。年十一，除侍御中散。于時高祖沖幼，文明太后臨朝，津曾久侍左右，忽咳逆失聲，遂吐數升，藏衣袖。太后聞聲，閱而不見，問其故，具以實言。遂以敬慎見知，賜縑百匹。遷符璽郎中。津以身在禁密，不外交遊，至於宗族姻表，罕相祗候。司徒馮誕與津少結交遊，而津見其貴寵，每恒退避，及相招命，多辭疾不往。誕以為恨，而津逾遠焉。人或謂之曰：「司徒，君之少舊，宜蒙進達，何遽自外也？」津曰：「為勢家所厚，復何容易。但全吾今日，亦以足矣。」","person_mention_id":"c-weishu-weishou-058-yangjin:p001:m0136"}],"attestations":[{"paragraph_id":"c-weishu-weishou-058-yangjin:p001","start":136,"end":138,"surface":"司徒","id":"th-ws058-jin-003:a","person_mention_id":"c-weishu-weishou-058-yangjin:p001:m0136","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本源明授/遷/歷官或用稱；假/兼/領/正原字保留，未知年月及任終不補，不以卒年收各官。","appointment_role":"source_report"}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-weishu-weishou-058-yangjin:p001","text":"順弟津，字羅漢，本名延祚，高祖賜名焉。少端謹，以器度見稱。年十一，除侍御中散。于時高祖沖幼，文明太后臨朝，津曾久侍左右，忽咳逆失聲，遂吐數升，藏衣袖。太后聞聲，閱而不見，問其故，具以實言。遂以敬慎見知，賜縑百匹。遷符璽郎中。津以身在禁密，不外交遊，至於宗族姻表，罕相祗候。司徒馮誕與津少結交遊，而津見其貴寵，每恒退避，及相招命，多辭疾不往。誕以為恨，而津逾遠焉。人或謂之曰：「司徒，君之少舊，宜蒙進達，何遽自外也？」津曰：「為勢家所厚，復何容易。但全吾今日，亦以足矣。」","text_layer":"received_chapter","annotation_status":"in_progress","source_position":{"revision_id":2087998,"raw_start":9843,"raw_end":10078,"source_layer":"received_biography","raw_character_offsets":[9843,9844,9845,9846,9847,9848,9849,9850,9851,9852,9853,9854,9