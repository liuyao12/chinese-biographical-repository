ual_provisional"}],"chapter_id":"c-shiji-113-nanyue","book_id":"b-shiji-113","work_id":"w-shiji","source_id":"s-shiji113-nanyue"},{"id":"c-shiji-113-nanyue:p010","text":"元鼎五年秋，衛尉路博德為伏波將軍，出桂陽，下匯水；主爵都尉楊仆為樓船將軍，出豫章，下橫浦；故歸義越侯二人為戈船、下厲將軍，出零陵，或下離水，或柢蒼梧；使馳義侯因巴蜀罪人，發夜郎兵，下牂柯江：咸會番禺。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-113-nanyue:m010-0008","start":8,"end":11,"surface":"路博德","kind":"person","person_id":"vib_10x_51n","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m010-0029","start":29,"end":31,"surface":"楊仆","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m010-0046","start":46,"end":52,"surface":"歸義越侯二人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-113-nanyue:m010-0053","start":53,"end":55,"surface":"戈船","kind":"person","person_id":"4zn_n9v_k0v","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m010-0056","start":56,"end":58,"surface":"下厲","kind":"person","person_id":"iw9_udd_jr2","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m010-0076","start":76,"end":79,"surface":"馳義侯","kind":"person","person_id":"dzl_mvt_l93","status":"contextual_provisional"}],"chapter_id":"c-shiji-113-nanyue","book_id":"b-shiji-113","work_id":"w-shiji","source_id":"s-shiji113-nanyue"},{"id":"c-shiji-113-nanyue:p011","text":"元鼎六年冬，樓船將軍將精卒先陷尋陜，破石門，得越船粟，因推而前，挫越鋒，以數萬人待伏波。伏波將軍將罪人，道遠，會期後，與樓船會乃有千餘人，遂俱進。樓船居前，至番禺。建德、嘉皆城守。樓船自擇便處，居東南面；伏波居西北面。會暮，樓船攻敗越人，縱火燒城。越素聞伏波名，日暮，不知其兵多少。伏波乃為營，遣使者招降者，賜印，復縱令相招。樓船力攻燒敵，反驅而入伏波營中。犁旦，城中皆降伏波。呂嘉、建德已夜與其屬數百人亡入海，以船西去。伏波又因問所得降者貴人，以知呂嘉所之，遣人追之。以其故校尉司馬蘇弘得建德，封為海常侯；越郎都稽得嘉，封為臨蔡侯。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-113-nanyue:m011-0006","start":6,"end":10,"surface":"樓船將軍","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0041","start":41,"end":43,"surface":"伏波","kind":"person","person_id":"vib_10x_51n","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0044","start":44,"end":48,"surface":"伏波將軍","kind":"person","person_id":"vib_10x_51n","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0060","start":60,"end":62,"surface":"樓船","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0073","start":73,"end":75,"surface":"樓船","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0082","start":82,"end":84,"surface":"建德","kind":"person","person_id":"f4l_jyl_oqv_C","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0085","start":85,"end":86,"surface":"嘉","kind":"person","person_id":"jfm_184_2yb","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0090","start":90,"end":92,"surface":"樓船","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0102","start":102,"end":104,"surface":"伏波","kind":"person","person_id":"vib_10x_51n","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0112","start":112,"end":114,"surface":"樓船","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0127","start":127,"end":129,"surface":"伏波","kind":"person","person_id":"vib_10x_51n","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0141","start":141,"end":143,"surface":"伏波","kind":"person","person_id":"vib_10x_51n","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0163","start":163,"end":165,"surface":"樓船","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0174","start":174,"end":176,"surface":"伏波","kind":"person","person_id":"vib_10x_51n","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0186","start":186,"end":188,"surface":"伏波","kind":"person","person_id":"vib_10x_51n","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0189","start":189,"end":191,"surface":"呂嘉","kind":"person","person_id":"jfm_184_2yb","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0192","start":192,"end":194,"surface":"建德","kind":"person","person_id":"f4l_jyl_oqv_C","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0211","start":211,"end":213,"surface":"伏波","kind":"person","person_id":"vib_10x_51n","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0225","start":225,"end":227,"surface":"呂嘉","kind":"person","person_id":"jfm_184_2yb","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0242","start":242,"end":244,"surface":"蘇弘","kind":"person","person_id":"m08_4xt_opo","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0245","start":245,"end":247,"surface":"建德","kind":"person","person_id":"f4l_jyl_oqv_C","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0256","start":256,"end":258,"surface":"都稽","kind":"person","person_id":"6m0_ze7_hl0","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0259","start":259,"end":260,"surface":"嘉","kind":"person","person_id":"jfm_184_2yb","status":"contextual_provisional"}],"chapter_id":"c-shiji-113-nanyue","book_id":"b-shiji-113","work_id":"w-shiji","source_id":"s-shiji113-nanyue"},{"id":"c-shiji-113-nanyue:p012","text":"蒼梧王趙光者，越王同姓，聞漢兵至，及越揭陽令定自定屬漢；越桂林監居翁諭甌駱屬漢：皆得為侯。戈船、下厲將軍兵及馳義侯所發夜郎兵未下，南越已平矣。遂為九郡。伏波將軍益封。樓船將軍兵以陷堅為將梁侯。自尉佗初王後，五世九十三歲而國亡焉。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-113-nanyue:m012-0003","start":3,"end":5,"surface":"趙光","kind":"person","person_id":"b77_ulm_otk","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m012-0022","start":22,"end":23,"surface":"定","kind":"person","person_id":"xhk_b1m_hjb","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m012-0032","start":32,"end":34,"surface":"居翁","kind":"person","person_id":"h1o_o6t_3ru","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m012-0045","start":45,"end":47,"surface":"戈船","kind":"person","person_id":"4zn_n9v_k0v","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m012-0048","start":48,"end":50,"surface":"下厲","kind":"person","person_id":"iw9_udd_jr2","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m012-0054","start":54,"end":57,"surface":"馳義侯","kind":"person","person_id":"dzl_mvt_l93","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m012-0076","start":76,"end":80,"surface":"伏波將軍","kind":"person","person_id":"vib_10x_51n","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m012-0083","start":83,"end":87,"surface":"樓船將軍","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m012-0097","start":97,"end":99,"surface":"尉佗","kind":"person","person_id":"mo6_b19_odk","status":"contextual_provisional"}],"chapter_id":"c-shiji-113-nanyue","book_id":"b-shiji-113","work_id":"w-shiji","source_id":"s-shiji113-nanyue"},{"id":"c-shiji-113-nanyue:p013","text":"尉佗之王，本由任囂。遭漢初定，列為諸侯。隆慮離溼疫，佗得以益驕。甌駱相攻，南越動搖。漢兵臨境，嬰齊入朝。其後亡國，徵自樛女；呂嘉小忠，令佗無後。樓船從欲，怠傲失惑；伏波困窮，智慮愈殖，因禍為福。成敗之轉，譬若糾墨。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-113-nanyue:m013-0000","start":0,"end":2,"surface":"尉佗","kind":"person","person_id":"mo6_b19_odk","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m013-0007","start":7,"end":9,"surface":"任囂","kind":"person","person_id":"e8q_4ar_5bh","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m013-0020","start":20,"end":22,"surface":"隆慮","kind":"person","person_id":"cnz_t0f_oaz","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m013-0026","start":26,"end":27,"surface":"佗","kind":"person","person_id":"mo6_b19_odk","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m013-0047","start":47,"end":49,"surface":"嬰齊","kind":"person","person_id":"f4l_jyl_oqv","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m013-0059",