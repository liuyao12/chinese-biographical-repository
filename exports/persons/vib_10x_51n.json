:"person","person_id":"vib_10x_51n","status":"contextual_provisional","paragraph_id":"c-shiji-113-nanyue:p012","chapter_id":"c-shiji-113-nanyue"},{"id":"c-shiji-113-nanyue:m013-0082","start":82,"end":84,"surface":"伏波","kind":"person","person_id":"vib_10x_51n","status":"contextual_provisional","paragraph_id":"c-shiji-113-nanyue:p013","chapter_id":"c-shiji-113-nanyue"}],"relations":[],"title_holdings":[{"id":"th-shiji113-016","person_id":"vib_10x_51n","title":"衛尉","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-113-nanyue","source_id":"s-shiji113-nanyue","paragraph_id":"c-shiji-113-nanyue:p007","quote":"太子興代立，其母為太后。太后自未為嬰齊姬時，嘗與霸陵人安國少季通。及嬰齊薨後，元鼎四年，漢使安國少季往諭王、王太后以入朝，比內諸侯；令辯士諫大夫終軍等宣其辭，勇士魏臣等輔其缺，衛尉路博德將兵屯桂陽，待使者。王年少，太後中國人也，嘗與安國少季通，其使復私焉。國人頗知之，多不附太后。太后恐亂起，亦欲倚漢威，數勸王及群臣求內屬。即因使者上書，請比內諸侯，三歲一朝，除邊關。於是天子許之，賜其丞相呂嘉銀印，及內史、中尉、太傅印，餘得自置。除其故黥劓刑，用漢法，比內諸侯。使者皆留填撫之。王、王太后飭治行裝重齎，為入朝具。"}],"attestations":[{"id":"th-shiji113-016:a001","paragraph_id":"c-shiji-113-nanyue:p007","start":88,"end":90,"surface":"衛尉","person_mention_id":"c-shiji-113-nanyue:m007-0090","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授受事件與文獻用稱分存；原文沒有確切任期終點則保留未知，死亡不自動終止官爵。故濟北相為追述舊官；去帝制與國內仍用帝號的差異另待處理。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji113-022","person_id":"vib_10x_51n","title":"伏波將軍","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-113-nanyue","source_id":"s-shiji113-nanyue","paragraph_id":"c-shiji-113-nanyue:p010","quote":"元鼎五年秋，衛尉路博德為伏波將軍，出桂陽，下匯水；主爵都尉楊仆為樓船將軍，出豫章，下橫浦；故歸義越侯二人為戈船、下厲將軍，出零陵，或下離水，或柢蒼梧；使馳義侯因巴蜀罪人，發夜郎兵，下牂柯江：咸會番禺。"}],"attestations":[{"id":"th-shiji113-022:a001","paragraph_id":"c-shiji-113-nanyue:p010","start":12,"end":16,"surface":"伏波將軍","person_mention_id":"c-shiji-113-nanyue:m010-0008","usage":"narrative","date_expression":"元鼎五年"}],"effective_perio