{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"u3q_o72_vq4","canonical_person_id":"u3q_o72_vq4","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["u3q_o72_vq4"],"persons":[{"id":"u3q_o72_vq4","label":"南徐州主者（蕭績核解書，姓名未載）","status":"active","historicity":"historical_tradition","aliases":[],"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-029","chapter_id":"c-liangshu-029-xiaoji-complete","source_id":"s-liangshu-029-xiaoji-complete-ws1538079","paragraph_id":"c-liangshu-029-xiaoji-complete:p001","quote":"主者","kind":"person_reference","mention_id":"c-liangshu-029-xiaoji-complete:p001:r0081"}],"review":"ai_provisional","identity_note":"南徐州主者（蕭績核解書，姓名未載），見本組原文及身份互校。"}],"source_mention_summary":[],"most_mentioned_source_ids":[],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[],"relations":[],"title_holdings":[],"address_assertions":[],"person_references":[{"id":"c-liangshu-029-xiaoji-complete:p001:r0081","paragraph_id":"c-liangshu-029-xiaoji-complete:p001","start":81,"end":83,"surface":"主者","person_id":"u3q_o72_vq4","referent_role":"third_person","quote":"南康簡王績字世謹，高祖第四子。天監八年，封南康郡王，邑二千戶。出爲輕車將軍，領石頭戍軍事。十年，遷使持節、都督南徐州諸軍事、南徐州刺史，進號仁威將軍。績時年七歲，主者有受貨，洗改解書，長史王僧孺弗之覺，績見而輒詰之，便卽時首服，衆咸歎其聰警。十六年，徵爲宣毅將軍、領石頭戍軍事。十七年，出爲使持節、都督南北兗徐青冀五州諸軍事、南兗州刺史，在州著稱。尋有詔徵還，民曹嘉樂等三百七十人詣闕上表，稱績尤異一十五條，乞留州任，優詔許之，進號北中郎將。普通四年，徵爲侍中、雲麾將軍，領石頭戍軍事。五年，出爲使持節、都督江州諸軍事、江州刺史。丁董淑儀憂，居喪過禮，高祖手詔勉之，使攝州任，固求解職，乃徵授安右將軍、領石頭戍軍事，尋加護軍。羸瘠弗堪視事。大通三年，因感病薨于任，時年二十五。贈侍中、中軍將軍、開府儀同三司，給鼓吹一部。諡曰簡。","note":"依本段敘事、稱謂及語者受者定。","chapter_id":"c-liangshu-029-xiaoji-complete","book_id":"b-liangshu-029","work_id":"w-liangshu","source_id":"s-liangshu-029-xiaoji-complete-ws1538079"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-029-xiaoji-complete:p001","text":"南康簡王績字世謹，高祖第四子。天監八年，封南康郡王，邑二千戶。出爲輕車將軍，領石頭戍軍事。十年，遷使持節、都督南徐州諸軍事、南徐州刺史，進號仁威將軍。績時年七歲，主者有受貨，洗改解書，長史王僧孺弗之覺，績見而輒詰之，便卽時首服，衆咸歎其聰警。十六年，徵爲宣毅將軍、領石頭戍軍事。十七年，出爲使持節、都督南北兗徐青冀五州諸軍事、南兗州刺史，在州著稱。尋有詔徵還，民曹嘉樂等三百七十人詣闕上表，稱績尤異一十五條，乞留州任，優詔許之，進號北中郎將。普通四年，徵爲侍中、雲麾將軍，領石頭戍軍事。五年，出爲使持節、都督江州諸軍事、江州刺史。丁董淑儀憂，居喪過禮，高祖手詔勉之，使攝州任，固求解職，乃徵授安右將軍、領石頭戍軍事，尋加護軍。羸瘠弗堪視事。大通三年，因感病薨于任，時年二十五。贈侍中、中軍將軍、開府儀同三司，給鼓吹一部。諡曰簡。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":13,"last_line":13,"raw_start":317,"raw_end":702,"raw_character_offsets":[317,318,319,320,321,322,323,324,325,326,327,328,329,330,331,337,338,339,340,343,344,345,346,347,348,349,350,351,352,353,354,355,356,357,358,359,360,361,362,363,364,365,366,367,368,369,370,371,372,373,374,375,376,377,378,379,380,381,382,383,384,385,386,387,388,389,390,391,392,393,394,395,396,397,398,399,400,401,402,403,404,405,406,407,408,409,410,411,412,413,414,415,416,417,418,419,420,421,422,423,424,425,426,427,428,429,430,431,432,433,434,435,436,437,438,439,440,441,442,443,444,445,446,447,448,449,450,451,452,453,454,455,456,457,458,459,460,461,462,463,464,465,466,467,468,469,470,471,472,473,474,475,476,477,478,479,480,481,482,483,484,485,486,487,488,489,490,491,492,493,494,495,496,497,498,499,500,501,502,503,504,505,506,507,508,509,510,511,512,513,514,515,516,517,518,519,520,521,522,523,524,525,526,527,528,529,530,531,532,533,534,535,536,537,538,539,540,541,542,543,544,550,551,552,553,556,557,558,559,560,561,562,563,564,565,566,567,568,569,570,571,572,