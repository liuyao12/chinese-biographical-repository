7,5088,5089,5090,5091,5092,5093,5094,5095,5096,5097,5098,5099,5100,5101,5102,5103,5104,5105,5106,5107,5108,5109,5110,5111,5112,5113,5114,5115,5116,5117,5118,5119,5120,5121,5122,5123,5124,5125,5126,5127,5128,5129,5130,5131,5132,5133,5134,5135,5136,5137,5138,5139,5140,5141]},"chapter_id":"c-sanguozhi-052-guyong-complete","book_id":"b-sanguozhi-052","work_id":"w-sanguozhi","source_id":"s-sanguozhi-052-guyong-complete"},{"id":"c-sanguozhi-052-guyong-complete:line042-pei02-02","text":"徐众评曰：雍不以吕壹见毁之故，而和颜悦色，诚长者矣。然开引其意，问所欲道，此非也。壹奸险乱法，毁伤忠贤，吴国寒心，自太子登、陆逊已下，切谏不能得，是以潘濬欲因会手剑之，以除国患，疾恶忠主，义形於色，而今乃发起令言。若壹称枉邪，不申理，则非录狱本旨；若承辞而奏之，吴主傥以敬丞相所言，而复原宥，伯言、承明不当悲慨哉！怀叙本无私恨，无所为嫌，故詈辱之，疾恶意耳，恶不仁者，其为仁也。季武子死，曾点倚其门而歌；子晳创发，子产催令自裁。以此言之，雍不当责怀叙也。","text_layer":"witness_appended_pei_songzhi_note","annotation_status":"reviewed","mentions":[{"id":"c-sanguozhi-052-guyong-complete:line042-pei02-02:m0000","start":0,"end":2,"surface":"徐众","kind":"person","person_id":"wod_cwr_976","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-guyong-complete:line042-pei02-02:m0005","start":5,"end":6,"surface":"雍","kind":"person","person_id":"syc_ik6_bq5_**A","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-guyong-complete:line042-pei02-02:m0008","start":8,"end":10,"surface":"吕壹","kind":"person","person_id":"ym8_q7g_031","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-guyong-complete:line042-pei02-02:m0041","start":41,"end":42,"surface":"壹","kind":"person","person_id":"ym8_q7g_031","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-guyong-complete:line042-pei02-02:m0058","start":58,"end":61,"surface":"太子登","kind":"person","person_id":"572_278_cba_C","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-guyong-complete:line042-pei02-02:m0062","start":62,"end":64,"surface":"陆逊","kind":"person","person_id":"lii_454_vuv","status":"cont