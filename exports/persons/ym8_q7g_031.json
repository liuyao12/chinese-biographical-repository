08","start":8,"end":10,"surface":"吕壹","kind":"person","person_id":"ym8_q7g_031","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-sanguozhi-052-guyong-complete:line042-pei02-02","chapter_id":"c-sanguozhi-052-guyong-complete"},{"id":"c-sanguozhi-052-guyong-complete:line042-pei02-02:m0041","start":41,"end":42,"surface":"壹","kind":"person","person_id":"ym8_q7g_031","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-sanguozhi-052-guyong-complete:line042-pei02-02","chapter_id":"c-sanguozhi-052-guyong-complete"},{"id":"c-sanguozhi-052-guyong-complete:line042-pei02-02:m0108","start":108,"end":109,"surface":"壹","kind":"person","person_id":"ym8_q7g_031","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-sanguozhi-052-guyong-complete:line042-pei02-02","chapter_id":"c-sanguozhi-052-guyong-complete"}],"relations":[],"title_holdings":[{"id":"th-wu052-gy-main-14","person_id":"ym8_q7g_031","title":"中書","kind":"office","mode":"attestation","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-052","chapter_id":"c-sanguozhi-052-guyong-complete","source_id":"s-sanguozhi-052-guyong-complete","paragraph_id":"c-sanguozhi-052-guyong-complete:line042","quote":"黃武四年，迎母於呉。既至，權臨賀之，親拜其母於庭，公卿大臣畢會，後太子又往慶焉。雍爲人不飲酒，寡言語，舉動時當。權嘗歎曰：「顧君不言，言必有中。」至飲宴歡樂之際，左右恐有酒失而雍必見之，是以不敢肆情。權亦曰：「顧公在坐，使人不樂。」其見憚如此。是歳，改爲太常。進封醴陵侯，代孫邵爲丞相，平尚書事。其所選用文武將吏各隨能所任，心無適莫。時訪逮民間，及政職所宜，輒密以聞。若見納用，則歸之於上，不用，終不宣洩。權以此重之，然於公朝有所陳及，辭色雖順而所執者正。權嘗咨問得失，張昭因陳聽采聞，頗以法令太稠，刑罰微重，宜有所蠲損。權默然，顧問雍曰：「君以爲何如？」雍對曰：「臣之所聞，亦如昭所陳。」於是權乃議獄輕刑。久之，呂壹、秦博爲中書，典校諸官府及州郡文書。壹等因此漸作威福，遂造作榷酤障管之利，舉罪糾奸，纖介必聞，重以深案丑誣，毀短大臣，排陷無辜，雍等皆見舉白，用被譴讓。後壹奸罪發露，收系延尉。雍往斷獄。壹以囚見，雍和顏色，問其辭狀，臨出，又謂壹曰：「君意得無慾有所道？」壹叩頭無言。時尚書郎懷敘面詈辱壹，雍責敘曰：「官有正法，何至於此？」","person_mention_id":"c-sanguozhi-052-guyong-complete:line042:m0307"}],"attestations":[{"id":"th-wu052-gy-main-14:a","paragraph_id":"c-sanguozhi-052-guyong-complete:line042","start":313,"end":315,"surface":"中書","person_mention_id":"c-sanguozhi-052-guyong-complete:line042:m0307","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"person_references":[{"id":"c-sanguozhi-052-guyong-complete:line042:r0426","paragraph_id":"c-sanguozhi-052-guyong-complete:line042","start":426,"end":427,"surface":"君","person_id":"ym8_q7g_031","quote":"君意得無慾","referent_role":"addressee","note":"依此段書牘、對話或敘述所指。","chapter_id":"c-sanguozhi-052-guyong-complete","book_id":"b-sanguozhi-052","work_id":"w-sanguozhi","source_id":"s-sanguozhi-052-guyong-complete"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-052-guyong-complete:line042","text":"黃武四年，迎母於呉。既至，權臨賀之，親拜其母於庭，公卿大臣畢會，後太子又往慶焉。雍爲人不飲酒，寡言語，舉動時當。權嘗歎曰：「顧君不言，言必有中。」至飲宴歡樂之際，左右恐有酒失而雍必見之，是以不敢肆情。權亦曰：「顧公在坐，使人不樂。」其見憚如此。是歳，改爲太常。進封醴陵侯，代孫邵爲丞相，平尚書事。其所選用文武將吏各隨能所任，心無適莫。時訪逮民間，及政職所宜，輒密以聞。若見納用，則歸之於上，不用，終不宣洩。權以此重之，然於公朝有所陳及，辭色雖順而所執者正。權嘗咨問得失，張昭因陳聽采聞，頗以法令太稠，刑罰微重，宜有所蠲損。權默然，顧問雍曰：「君以爲何如？」雍對曰：「臣之所聞，亦如昭所陳。」於是權乃議獄輕刑。久之，呂壹、秦博爲中書，典校諸官府及州郡文書。壹等因此漸作威福，遂造作榷酤障管之利，舉罪糾奸，纖介必聞，重以深案丑誣，毀短大臣，排陷無辜，雍等皆見舉白，用被譴讓。後壹奸罪發露，收系延尉。雍往斷獄。壹以囚見，雍和顏色，問其辭狀，臨出，又謂壹曰：「君意得無慾有所道？」壹叩頭無言。時尚書郎懷敘面詈辱壹，雍責敘曰：「官有正法，何至於此？」","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-sanguozhi-052-guyong-complete:line042:m0013","start":13,"end":14,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-guyong-complete:line042:m0033","start":33,"end":35,"surface":"太子","kind":"person","person_id":"572_278_cba_C","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-guyong-complete:line04