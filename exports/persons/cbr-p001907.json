th-shiji040-047","person_id":"qqe_yxh_v49","title":"大夫","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-040-chu","source_id":"s-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p034","quote":"十二年春，楚靈王樂乾豀，不能去也。國人苦役。初，靈王會兵於申，僇越大夫常壽過，殺蔡大夫觀起。起子從亡在呉，乃勸呉王伐楚，爲閒越大夫常壽過而作亂，爲呉閒。使矯公子棄疾命召公子比於晉，至蔡，與呉、越兵欲襲蔡。令公子比見棄疾，與盟於鄧。遂入殺靈王太子祿，立子比爲王，公子子皙爲令尹，棄疾爲司馬。先除王宮，觀從從師于乾豀，令楚衆曰：「國有王矣。先歸，復爵邑田室。後者遷之。」楚衆皆潰，去靈王而歸。"}],"attestations":[{"id":"th-shiji040-047:a001","paragraph_id":"c-shiji-040-chu:p034","start":33,"end":35,"surface":"大夫","person_mention_id":"c-shiji-040-chu:m034-0035","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"越大夫常壽過為既有用稱，未以僇日推任職終點。 保存來源用稱，不將首次出現當授予日期；制度、版本與全部有效時段仍待覆核。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-040-chu:p034","text":"十二年春，楚靈王樂乾豀，不能去也。國人苦役。初，靈王會兵於申，僇越大夫常壽過，殺蔡大夫觀起。起子從亡在呉，乃勸呉王伐楚，爲閒越大夫常壽過而作亂，爲呉閒。使矯公子棄疾命召公子比於晉，至蔡，與呉、越兵欲襲蔡。令公子比見棄疾，與盟於鄧。遂入殺靈王太子祿，立子比爲王，公子子皙爲令尹，棄疾爲司馬。先除王宮，觀從從師于乾豀，令楚衆曰：「國有王矣。先歸，復爵邑田室。後者遷之。」楚衆皆潰，去靈王而歸。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m034-0005","start":5,"end":8,"surface":"楚靈王","kind":"person","person_id":"0va_zus_2zt_AAB","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m034-0024","start":24,"end":26,"surface":"靈王","kind":"person","person_id":"0va_zus_2zt_AAB","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m034-0035","start":35,"end":38,"surface":"常壽過","kind":"person","person_id":"qqe_yxh_v49","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m034-0043","start":43,"end":45,"surface":"觀起","kind":"person","person_id":"bm8_bzq_1ee","status":"contextual_provisional"},{"id":"c-shij