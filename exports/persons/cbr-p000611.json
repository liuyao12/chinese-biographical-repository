art":452,"end":454,"surface":"閻樂","kind":"person","person_id":"cbr-p000611","status":"contextual_provisional","paragraph_id":"c-shiji-006-shihuang:p062","chapter_id":"c-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:p062:m0500","start":500,"end":501,"surface":"樂","kind":"person","person_id":"cbr-p000611","status":"contextual_provisional","paragraph_id":"c-shiji-006-shihuang:p062","chapter_id":"c-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:p062:m0556","start":556,"end":558,"surface":"閻樂","kind":"person","person_id":"cbr-p000611","status":"contextual_provisional","paragraph_id":"c-shiji-006-shihuang:p062","chapter_id":"c-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:p063:m0000","start":0,"end":2,"surface":"閻樂","kind":"person","person_id":"cbr-p000611","status":"contextual_provisional","paragraph_id":"c-shiji-006-shihuang:p063","chapter_id":"c-shiji-006-shihuang"},{"id":"c-shiji-087-lisi:m034-0151","start":151,"end":156,"surface":"咸陽令閻樂","kind":"person","person_id":"cbr-p004931","status":"contextual_provisional","paragraph_id":"c-shiji-087-lisi:p034","chapter_id":"c-shiji-087-lisi"}],"relations":[],"title_holdings":[{"id":"th-shiji087-027","person_id":"cbr-p004931","title":"咸陽令","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-087-lisi","source_id":"s-shiji-087-lisi","paragraph_id":"c-shiji-087-lisi:p034","quote":"李斯已死，二世拜趙高為中丞相，事無大小輒決於高。高自知權重，乃獻鹿，謂之馬。二世問左右：「此乃鹿也？」左右皆曰「馬也」。二世驚，自以為惑，乃召太卜，令卦之，太卜曰：「陛下春秋郊祀，奉宗廟鬼神，齋戒不明，故至于此。可依盛德而明齋戒。」於是乃入上林齋戒。日游弋獵，有行人入上林中，二世自射殺之。趙高教其女婿咸陽令閻樂劾不知何人賊殺人移上林。高乃諫二世曰：「天子無故賊殺不辜人，此上帝之禁也，鬼神不享，天且降殃，當遠避宮以禳之。」二世乃出居望夷之宮。"}],"attestations":[{"id":"th-shiji087-027:a001","paragraph_id":"c-shiji-087-lisi:p034","start":151,"end":154,"surface":"咸陽令","person_mention_id":"c-shiji-087-lisi:m034-0151","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"實際授任、引古、追述與文獻用稱分存；未定日期、死亡、下獄與首次用稱不推定任期端點。假御史謁者侍中、擬任蒙恬相與擬裂地王不作實授。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji006-026","person_id":"cbr-p000611","surfaces":["咸陽令閻樂","閻樂","樂"],"scope":"same_chapter","chapter_ids":["c-shiji-006-shihuang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-006-shihuang:p062","quote":"高前數言「關東盜毋能為也」，及項羽虜秦將王離等鉅鹿下而前，章邯等軍數卻，上書請益助，燕、趙、齊、楚、韓、魏皆立為王，自關以東，大氐盡畔秦吏應諸侯，諸侯咸率其眾西鄉。沛公將數萬人已屠武關，使人私於高，高恐二世怒，誅及其身，乃謝病不朝見。二世夢白虎齧其左驂馬，殺之，心不樂，怪問占夢。卜曰：「涇水為祟。」二世乃齋於望夷宮，欲祠涇，沈四白馬。使使責讓高以盜賊事。高懼，乃陰與其婿咸陽令閻樂、其弟趙成謀曰：「上不聽諫，今事急，欲歸禍於吾宗。吾欲易置上，更立公子嬰。子嬰仁儉，百姓皆載其言。」使郎中令為內應，詐為有大賊，令樂召吏發卒，追劫樂母置高舍。遣樂將吏卒千餘人至望夷宮殿門，縛衛令仆射，曰：「賊入此，何不止？」衛令曰：「周廬設卒甚謹，安得賊敢入宮？」樂遂斬衛令，直將吏入，行射，郎宦者大驚，或走或格，格者輒死，死者數十人。郎中令與樂俱入，射上幄坐幃。二世怒，召左右，左右皆惶擾不鬬。旁有宦者一人，侍不敢去。二世入內，謂曰：「公何不蚤告我？乃至於此！」宦者曰：「臣不敢言，故得全。使臣蚤言，皆已誅，安得至今？」閻樂前即二世數曰：「足下驕恣，誅殺無道，天下共畔足下，足下其自為計。」二世曰：「丞相可得見否？」樂曰：「不可。」二世曰：「吾願得一郡為王。」弗許。又曰：「願為萬戶侯。」弗許。曰：「願與妻子為黔首，比諸公子。」閻樂曰：「臣受命於丞相，為天下誅足下，足下雖多言，臣不敢報。」麾其兵進。二世自殺。"}],"rationale":"依同一事件的即位稱號、全稱與短名暫定；欣參看前段長史司馬欣，不以章字合併周章與章邯。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji087-064","person_id":"cbr-p004931","scope":"same_chapter","chapter_ids":["c-shiji-087-lisi"],"status":"contextual_provisional","rationale":"依李斯下獄及秦末局部承接暫接；始皇弟暫依下一段子嬰既位承接，本篇世系主張保留待跨篇覆核。其子與妻子仍待核指，不補父子或配偶；中子、太卜、行人保留未名。韓玘原字保留，宰予與簡公引古不以同名確證全部事實。趙高短稱高限後段敘事，官稱及嵌套指代待核。","reviewer":"Codex（AI 代理）","surfaces":["咸陽令閻樂"],"evidence":[{"paragraph_id":"c-shiji-087-lisi:p034","quote":"李斯已死，二世拜趙高為中丞相，事無大小輒決於高。高自知權重，乃獻鹿，謂之馬。二世問左右：「此乃鹿也？」左右皆曰「馬也」。二世驚，自以為惑，乃召太卜，令卦之，太卜曰：「陛下春秋郊祀，奉宗廟鬼神，齋戒不明，故至于此。可依盛德而明齋戒。」於是乃入上林齋戒。日游弋獵，有行人入上林中，二世自射殺之。趙高教其女婿咸陽令閻樂劾不知何人賊殺人移上林。高乃諫二世曰：「天子無故賊殺不辜人，此上帝之禁也，鬼神不享，天且降殃，當遠避宮以禳之。」二世乃出居望夷之宮。"}]}],"equivalence_decisions":[{"id":"eq-shiji087-yan","person_ids":["cbr-p000611","cbr-p004931"],"canonical_person_id":"cbr-p000611","scope":"cross_chapter","chapter_ids":["c-shiji-006-shihuang","c-shiji-087-lisi"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-006-shihuang","source_id":"s