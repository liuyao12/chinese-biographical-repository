{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p002300","identity_policy":"contextual_provisional","person_ids":["cbr-p002300"],"persons":[{"id":"cbr-p002300","label":"公孫支（趙世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"公孫支","mention_ids":["c-shiji-043-zhao:m026-0062","c-shiji-043-zhao:m026-0130"]}],"evidence":[{"mention_id":"c-shiji-043-zhao:m026-0062","chapter_id":"c-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p026","quote":"公孫支"},{"mention_id":"c-shiji-043-zhao:m026-0130","chapter_id":"c-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p026","quote":"公孫支"}]}],"mentions":[{"id":"c-shiji-043-zhao:m026-0062","start":62,"end":65,"surface":"公孫支","kind":"person","person_id":"cbr-p002300","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p026","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m026-0130","start":130,"end":133,"surface":"公孫支","kind":"person","person_id":"cbr-p002300","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p026","chapter_id":"c-shiji-043-zhao"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji043-071","person_id":"cbr-p002300","surfaces":["公孫支"],"scope":"same_chapter","chapter_ids":["c-shiji-043-zhao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-043-zhao:p026","quote":"趙簡子疾，五日不知人，大夫皆懼。醫扁鵲視之，出，董安于問。扁鵲曰：「血脈治也，而何怪！在昔秦繆公嘗如此，七日而寤。寤之日，告公孫支與子輿曰：『我之帝所甚樂。吾所以久者，適有學也。帝告我：「晉國將大亂，五世不安；其後將霸，未老而死；霸者之子且令而國男女無別。」』公孫支書而藏之，秦讖於是出矣。獻公之亂，文公之霸，而襄公敗秦師於殽而歸縱淫，此子之所聞。今主君之疾與之同，不出三日疾必閒，閒必有言也。」"}],"rationale":"限本篇明示姓名、是為及連續事件判讀；夢辭人物與實際敘事分層，知伯文子未與荀櫟僅按熟知身份合併，氏族合稱保持未定。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-043-zhao:p026","text":"趙簡子疾，五日不知人，大夫皆懼。醫扁鵲視之，出，董安于問。扁鵲曰：「血脈治也，而何怪！在昔秦繆公嘗如此，七日而寤。寤之日，告公孫支與子輿曰：『我之帝所甚樂。吾所以久者，適有學也。帝告我：「晉國將大亂，五世不安；其後將霸，未老而死；霸者之子且令而國男女無別。」』公孫支書而藏之，秦讖於是出矣。獻公之亂，文公之霸，而襄公敗秦師於殽而歸縱淫，此子之所聞。今主君之疾與之同，不出三日疾必閒，閒必有言也。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-043-zhao:m026-0000","start":0,"end":3,"surface":"趙簡子","kind":"person","person_id":"cbr-p002292","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m026-0011","start":11,"end":13,"surface":"大夫","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、神異預言、職稱或未定指代；不從夢辭補人物世系，不把范中行氏族字面全域當個人。"},{"id":"c-shiji-043-zhao:m026-0017","start":17,"end":19,"surface":"扁鵲","kind":"person","person_id":"cbr-p002297","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m026-0024","start":24,"end":27,"surface":"董安于","kind":"person","person_id":"cbr-p002298","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m026-0029","start":29,"end":31,"surface":"扁鵲","kind":"person","person_id":"cbr-p002297","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m026-0045","start":45,"end":48,"surface":"秦繆公","kind":"person","person_id":"cbr-p002299","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m026-0062","start":62,"end":65,"surface":"公孫支","kind":"person","person_id":"cbr-p002300","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m026-0066","start":66,"end":68,"surface":"子輿","kind":"person","person_id":"cbr-p002301","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m026-0073","start":73,"end":74,"surface":"帝","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、神異預言、職稱或未定指代；不從夢辭補人物世系，不把范中行氏族字面全域當個人。"},{"id":"c-shiji-043-zhao:m026-0089","start":89,"end":90,"surface":"帝","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、神異預言、職稱或未定指代；不從夢辭補人物世系，不把范中行氏族字面全域當個人。"},{"id":"c-shiji-043-zhao:m026-0115","start":115,"end":119,"surface":"霸者之子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、神異預言、職稱或未定指代；不從夢辭補人物世系，不把范中行氏族字面全域當個人。"},{"id":"c-shiji-043-zhao:m026-0130","start":130,"end":133,"surface":"公孫支","kind":"person","person_id":"cbr-p0023