inship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"id":"name-nanqi047-liuanxi-source-local","person_id":"qfc_5ff_2q8","surname":"劉","ming":null,"additional_names":[],"chapter_id":"c-nanqishu-047-xietiao-rendered","paragraph_id":"c-nanqishu-047-xietiao-rendered:p005","person_mention_id":"c-nanqishu-047-xietiao-rendered:p005:m0011","source_anchor":{"chapter_id":"c-nanqishu-047-xietiao-rendered","paragraph_id":"c-nanqishu-047-xietiao-rendered:p005","mention_id":"c-nanqishu-047-xietiao-rendered:p005:m0011","person_id":"qfc_5ff_2q8","start":132,"end":135,"surface":"劉安西"},"quote":"建武四年，出爲晉安王鎮北諮議、南東海太守，行南徐州事。啓王敬則反謀，上甚嘉賞之。遷尚書吏部郎。朓上表三讓，中書疑朓官未及讓，以問祭酒沈約。約曰：「宋元嘉中，范曅讓吏部，朱脩之讓黃門，蔡興宗讓中書，竝三表詔答，具事宛然。近世小官不讓，遂成恒俗，恐此有乖讓意。王藍田、劉安西竝貴重，初自不讓，今豈可慕此不讓邪？孫興公、孔顗竝讓記室，今豈可三署皆讓邪？謝吏部今授超階，讓別有意，豈關官之大小？撝讓之美，本出人情。若大官必讓，便與詣闕章表不異。例旣如此，謂都自非疑。」朓又啓讓，上優答不許。","status":"source_attested","human_reviewed":false,"model":null,"note":"原稱劉安西只證姓劉與人物存在；安西保來源稱謂，不當本名、字號或已定完整官職；跨篇同指未決。","work_id":"w-nanqishu","book_id":"b-nanqishu-047","source_id":"s-nanqishu-047-current-rendered-xietiao"}],"mentions":[{"id":"c-nanqishu-047-xietiao-rendered:p005:m0011","start":132,"end":135,"surface":"劉安西","kind":"person","person_id":"qfc_5ff_2q8","status":"contextual_provisional","note":"來源明指姓劉、稱安西的一名人物；本名與跨篇同指未決。此來源內登記不宣稱必與現役任何候選異人，不擅補完整官職或紀年。","paragraph_id":"c-nanqishu-047-xietiao-rendered:p005","chapter_id":"c-nanqishu-047-xietiao-rendered"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-047-xietiao-rendered:p005","text":"建武四年，出爲晉安王鎮北諮議、南東海太守，行南徐州事。啓王敬則反謀，上甚嘉賞之。遷尚書吏部郎。朓上表三讓，中書疑朓官未