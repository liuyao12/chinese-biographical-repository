-waiqi:m029-0011"],"paragraph_ids":["c-shiji-049-waiqi:p026","c-shiji-049-waiqi:p029"],"passage_count":2}],"most_mentioned_source_ids":["s-shiji-049-waiqi"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji049-031","subject_person_id":"5nt_1fk_g2o","predicate":"brother","object_person_id":"l5c_h8i_d5q","status":"source_attested","evidence":[{"chapter_id":"c-shiji-049-waiqi","source_id":"s-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p026","quote":"衛皇后字子夫，生微矣。蓋其家號曰衛氏，出平陽侯邑。子夫為平陽主謳者。武帝初即位，數歲無子。平陽主求諸良家子女十餘人，飾置家。武帝祓霸上還，因過平陽主。主見所侍美人。上弗說。既飲，謳者進，上望見，獨說衛子夫。是日，武帝起更衣，子夫侍尚衣軒中，得幸。上還坐，驩甚。賜平陽主金千斤。主因奏子夫奉送入宮。子夫上車，平陽主拊其背曰：「行矣，彊飯，勉之！即貴，無相忘。」入宮歲餘，竟不復幸。武帝擇宮人不中用者，斥出歸之。衛子夫得見，涕泣請出。上憐之，復幸，遂有身，尊寵日隆。召其兄衛長君弟青為侍中。而子夫後大幸，有寵，凡生三女一男。男名據。"}],"qualifiers":{"source_term":"其兄衛長君","historicity":"historical_tradition"},"interpretation_note":"按明示子女、生、母、兄弟姊及婚姻的局部敘事保存；祖孫不作父子，不補未名者姓名。衛青子數各層原語並存，親屬判讀不代表數量已核定。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-049-waiqi:m026-0234","start":234,"end":237,"surface":"衛長君","kind":"person","person_id":"5nt_1fk_g2o","status":"contextual_provisional","paragraph_id":"c-shiji-049-waiqi:p026","chapter_id":"c-shiji-049-waiqi"},{"id":"c-shiji-049-waiqi:m029-0011","start":11,"end":14,"surface":"衛長君","kind":"person","person_id":"5nt_1fk_g2o","status":"contextual_provisional","paragraph_id":"c-shiji-049-waiqi:p029","chapter_id":"c-shiji-049-waiqi"}],"relations":[{"id":"a-shiji049-031","subject_person_id":"5nt_1fk_g2o","predicate":"brother","object_person_id":"l5c_h8i_d5q","status":"source_attested","evidence":[{"chapter_id":"c-shiji-049-waiqi","source_id":"s-sh