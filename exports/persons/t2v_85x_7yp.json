rn-and-eastern-complete:p017:m0085","start":85,"end":87,"surface":"姐瑾","kind":"person","person_id":"t2v_85x_7yp","status":"contextual_provisional","paragraph_id":"c-nanqishu-058-southern-and-eastern-complete:p017","chapter_id":"c-nanqishu-058-southern-and-eastern-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-058-southern-and-eastern-complete:p015","text":"高璉年百餘歲卒。隆昌元年，以高麗王樂浪公高雲為使持節、散騎常侍、都督營平二州諸軍事、征東大將軍、高麗王、樂浪公。建武三年，報功勞勤，實存名烈。假行寧朔將軍臣姐瑾等四人，振竭忠効，攘除國難，志勇果毅，等威名將，可謂扞城，固蕃社稷，論功料勤，宜在甄顯。今依例輒假行職。伏願恩愍，聽除所假。寧朔將軍、面中王姐瑾，歷贊時務，武功竝列，今假行冠軍將軍、都將軍、都漢王。建威將軍、八中侯餘古，弱冠輔佐，忠効夙著，今假行寧朔將軍、阿錯王。建威將軍餘歷，忠款有素，文武列顯，今假行龍驤將軍、邁盧王。廣武將軍餘固，忠効時務，光宣國政，今假行建威將軍、弗斯侯。」","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":43,"last_line":43,"raw_start":1911,"raw_end":2524,"raw_character_offsets":[1911,1912,1913,1914,1915,1916,1917,1918,1919,1920,1921,1922,1923,1924,1925,1926,1927,1928,1929,1930,1931,1932,1933,1934,1935,1936,1937,1938,1939,1940,1941,1942,1943,1944,1945,1946,1947,1948,1949,1950,1951,1952,1953,1954,1955,1956,1957,1958,1959,1960,1961,1962,1963,1964,1965,1966,1967,1968,1969,1970,1971,2280,2281,2282,2283,2284,2285,2286,2287,2288,2289,2290,2291,2292,2293,2294,2295,2296,2297,2298,2299,2300,2301,2302,2303,2304,2305,2306,2307,2308,2309,2310,2311,2312,2313,2314,2315,2316,2317,2318,2319,2320,2321,2322,2357,2358,2359,2360,2361,2362,2363,2364,2365,2366,2367,2368,2369,2370,2371,2372,2373,2374,2375,2376,2377,2378,2379,2380,2381,2382,2383,2384,2385,2386,2387,2388,2389,2390,2391,2392,2393,2394,2395,2396,2397,2398,2399,2400,2401,2402,2403,2404,2405,2406,2407,2408,2409,2410,2411,2412,2413,2414,2415,2416,2417,2418,2419,2420,2421,2422,2423,2424,2425,2426,2427,2428,2429,2430,2431,2432,2433,2434,2435,2436,2437,2438,2439,2440,2441,2442,2443,2444,2445,2446,2447,2448,2449,2450,2451,2452,2453,2454,2455,2456,2457,2458,2459,2460,2461,2462,2463,2464,2465,2466,2467,2468,2469,2470,2471,2472,2473,2474,2475,2476,2477,2478,2479,2480,2481,2482,2483,2484,2485,2486,2487,2488,2489,2490,2491,2492,2493,2494,2495,2496,2497,2498,2499,2500,2501,2502,2503,2504,2505,2506,2507,2508,2509,2510,2511,2512,2513,2514,2515,2516,2517,2518,2519,2520,2521,2522,2523],"revision_id":2638629},"mentions":[{"id":"c-nanqishu-058-southern-and-eastern-complete:p015:m0000","start":0,"end":2,"surface":"高璉","kind":"person","person_id":"cr0_fch_0al","status":"contextual_provisional"},{"id":"c-nanqishu-058-southern-and-eastern-complete:p015:m0020","start":20,"end":22,"surface":"高雲","kind":"person","person_id":"6m7_e1c_du1","status":"contextual_provisional"},{"id":"c-nanqishu-058-southern-and-eastern-complete:p015:m0078","start":78,"end":80,"surface":"姐瑾","kind":"person","person_id":"t2v_85x_7yp","status":"contextual_provisional"},{"id":"c-nanqishu-058-southern-and-eastern-complete:p015:m0150","start":150,"end":152,"surface":"姐瑾","kind":"person","person_id":"t2v_85x_7yp","status":"contextual_provisional"},{"id":"c-nanqishu-058-southern-and-eastern-complete:p015:m0187","start":187,"end":189,"surface":"餘古","kind":"person","person_id":"9w8_adx_ccd","status":"contextual_provisional"},{"id":"c-nanqishu-058-southern-and-eastern-complete:p015:m0216","start":216,"end":218,"surface":"餘歷","kind":"person","person_id":"44n_ph3_4go","status":"contextual_provisional"},{"id":"c-nanqishu-058-southern-and-eastern-complete:p015:m0245","start":245,"end":247,"surface":"餘固","kind":"person","person_id":"6qw_yd8_h71","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-058-southern-and-eastern-complete","book_id":"b-nanqishu-058","work_id":"w-nanqishu","source_id":"s-nanqishu-058-southern-and-eastern-complete-ws2638629"},{"id":"c-nanqishu-058-southern-and-eastern-complete:p017","text":"是歲，魏虜又發騎數十萬攻百濟，入其界，牟大遣將沙法名、贊首流、解禮昆、木干那率眾襲擊虜軍，大破之。建武二年，牟大遣使上表曰：「臣自昔受封，世被朝榮，忝荷節鉞，剋攘列辟。往姐瑾等竝蒙光除，臣庶咸泰。去庚午年，獫狁弗悛，舉兵深逼。臣遣沙法名等領軍逆討，宵襲霆擊，匈梨張惶，崩若海蕩。乘奔追斬，僵尸丹野。由是摧其銳氣，鯨暴韜凶。今邦宇謐靜，實名等之略，尋其功勳，宜在褒顯。今假沙法名行征虜將軍、邁羅王，贊首流為行安國將軍、辟中王，解禮昆為行武威將軍、弗中侯，木干那前有軍功，又拔臺舫，為行廣威將軍、面中侯。伏願天恩特愍聽除。」又表曰：「臣所遣行龍驤將軍、樂浪太守兼長史臣慕遺，行建武將軍、城陽太守兼司馬臣王茂，兼參軍、行振武將軍、朝鮮太守臣張塞，行揚武將軍陳明，在官忘私，唯公是務，見危授命，蹈難弗顧。今任臣使，冒涉波險，盡其至誠。實宜進爵，各假行署。伏願聖朝特賜除正。」詔可，竝賜軍號。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":47,"last_line":47,"raw_start":3179,"raw_end":3653,"raw_character_offsets":[3179,3180,3181,3182,3183,3184,3185,3186,3187,3188,3189,3190,3191,3192,3193,3194,3195,3196,3197,3198,3199,3200,3201,3202,3203,3204,3205,3206,3207,3208,3209,3210,3211,3212,3213,3214,3215,3216,3217,3218,3219,3220,3221,3222,3223,3224,3225,3226,3227,3228,3229,3230,3231,3232,3233,3234,3235,3236,3237,3238,3239,3240,3241,3242,3243,3244,3245,3246,3247,3248,3249,3250,3251,3252,3253,3254,3255,3256,3257,3258,3259,3260,3261,3262,3263,3264,3265,3266,3267,3268,3269,3270,3271,3272,3273,3274,3275,3276,3277,3278,3279,3280,3281,3282,3283,3284,3285,3286,3287,3288,3289,3290,3291,3292,3293,3294,3295,3296,3297,3298,3299,3300,3301,3302,3303,3304,3305,3306,3307,3308,3309,3310,3311,3312,3396,3397,3398,3399,3400,3401,3402,3403,3404,3405,3406,3407,3408,3409,3410,3411,3412,3413,3414,3415,3416,3417,3418,3419,3420,3421,3422,3423,3424,3425,3426,3427,3428,3429,3430,3431,3432,3433,3434,3435,3436,3437,3438,3439,3440,3441,3442,3443,3444,3445,3446,3447,3448,3449,3450,3451,3452,3453,3454,3455,3456,3457,3458,3459,3460,3461,3462,3463,3464,3465,3466,3467,3468,3469,3470,3471,3472,3473,3474,3475,3476,3477,3478,3479,3480,3481,3482,3483,3484,3485,3486,3487,3488,3489,3490,3491,3492,3493,3494,3495,3496,3497,3498,3499,3500,3501,3502,3503,3504,3505,3506,3507,3508,3509,3510,3511,3512,3513,3514,3515,3516,3517,3518,3519,3520,3521,3522,3523,3524,3525,3526,3527,3528,3529,3530,3531,3532,3533,3534,3535,3536,3537,3538,3539,3540,3541,3542,3543,3544,3545,3546,3547,3548,3549,3550,3551,3552,3553,3554,3555,3556,3557,3558,3559,3560,3561,3562,3563,3564,3565,3566,3567,3568,356