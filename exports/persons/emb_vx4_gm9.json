mn":12},{"line":22,"column":13},{"line":22,"column":14},{"line":22,"column":15},{"line":22,"column":16},{"line":22,"column":17},{"line":22,"column":18},{"line":22,"column":19},{"line":22,"column":20},{"line":23,"column":0},{"line":23,"column":1},{"line":23,"column":2},{"line":23,"column":3},{"line":23,"column":4},{"line":23,"column":5},{"line":23,"column":6},{"line":23,"column":7},{"line":23,"column":8},{"line":23,"column":9},{"line":23,"column":10},{"line":23,"column":11},{"line":23,"column":12},{"line":23,"column":13},{"line":23,"column":14},{"line":23,"column":15},{"line":23,"column":16},{"line":23,"column":17}]},"chapter_id":"c-songshu-001-parents-reference","book_id":"b-songshu-001","work_id":"w-songshu","source_id":"s-songshu-001-parents-reference"},{"id":"c-songshu-041-parents:p001","text":"孝穆趙皇后諱安下邳僮人也祖彪字世範治書侍御史父裔字彦胄平原太守后以晉穆帝升平四年嬪孝皇晉哀帝興寧元年四月二日生高祖其日后以産疾殂於丹徒官舍時年二十一葬晉陵丹徒縣東鄉練璧里雩山宋初追崇號謚陵曰興寧永初二年有司奏曰大孝之德盛於榮親一人有慶光被萬國是以靈文寵於西京夀張顯於隆漢故平原太守趙裔故洮陽令蕭卓並外屬尊戚不逮休寵臣等仰述聖思逺稽舊章並可追贈光祿大夫加金章紫綬裔命婦孫可豫章郡建昌縣君卓命婦趙可吳郡夀昌縣君孫氏東莞人也其年又詔曰推恩之禮在情所同故内樹宗子外崇后屬爰自漢魏咸遵斯典外祖趙光祿蕭光祿名噐雖隆茅土未建並宜追封開國縣侯食邑五百戸於是追封裔臨賀縣侯裔長子宣之仕至江乘令蚤卒無子以弟孫襲之繼宣之紹封襲之卒子祖憐嗣齊受禪國除宣之弟倫之自有傳","mentions":[{"id":"c-songshu-041-parents:p001:m0000","start":0,"end":5,"surface":"孝穆趙皇后","kind":"person","person_id":"ntw_hsm_9iv","identification_status":"contextual_provisional","interpretation_note":"依完整同一傳記單元、所述身份及敘事主語辨識；非依同名自動合併。"},{"id":"c-songshu-041-parents:p001:m0006","start":6,"end":7,"surface":"安","kind":"person","person_id":"ntw_hsm_9iv","identification_status":"contextual_provisional","interpretation_note":"依完整同一傳記單元、所述身份及敘事主語辨識；非依同名自動合併。"},{"id":"c-songshu-041-parents:p001:m0013","start":13,"end":14,"surface":"彪","kind":"person","person_id":"r5n_x7v_cwf","identification_status":"contextual_provisional","interpretation_note":"依完整同一傳記單元、所述身份及敘事主語辨識；非依同名自動合併。"},{"id":"c-songshu-041-parents:p001:m0015","start":15,"end":17,"surface":"世範","kind":"person","person_id":"r5n_x7v_cwf","identification_status":"contextual_provisional","interpretation_note