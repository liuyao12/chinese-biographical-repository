{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003654","identity_policy":"contextual_provisional","person_ids":["cbr-p003654"],"persons":[{"id":"cbr-p003654","label":"平津侯（三王世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"平津侯","mention_ids":["c-shiji-060-sanwang:m004-0207"]}],"evidence":[{"mention_id":"c-shiji-060-sanwang:m004-0207","chapter_id":"c-shiji-060-sanwang","paragraph_id":"c-shiji-060-sanwang:p004","quote":"平津侯"}]}],"mentions":[{"id":"c-shiji-060-sanwang:m004-0207","start":207,"end":210,"surface":"平津侯","kind":"person","person_id":"cbr-p003654","status":"contextual_provisional","paragraph_id":"c-shiji-060-sanwang:p004","chapter_id":"c-shiji-060-sanwang"}],"relations":[],"title_holdings":[{"id":"th-shiji060-015","person_id":"cbr-p003654","title":"平津侯","kind":"noble_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-060-sanwang","source_id":"s-shiji-060-sanwang","paragraph_id":"c-shiji-060-sanwang:p004","quote":"三月丙子，奏未央宮。「丞相臣青翟、御史大夫臣湯昧死言：臣謹與列侯臣嬰齊、中二千石二千石臣賀、諫大夫博士臣安等議曰：伏聞周封八百，姬姓并列，奉承天子。康叔以祖考顯，而伯禽以周公立，咸為建國諸侯，以相傅為輔。百官奉憲，各遵其職，而國統備矣。竊以為并建諸侯所以重社稷者，四海諸侯各以其職奉貢祭。支子不得奉祭宗祖，禮也。封建使守藩國，帝王所以扶德施化。陛下奉承天統，明開聖緒，尊賢顯功，興滅繼絕。續蕭文終之後於酂，褒厲群臣平津侯等。昭六親之序，明天施之屬，使諸侯王封君得推私恩分子弟戶邑，錫號尊建百有餘國。而家皇子為列侯，則尊卑相踰，列位失序，不可以垂統於萬世。臣請立臣閎、臣旦、臣胥為諸侯王。」三月丙子，奏未央宮。"}],"attestations":[{"id":"th-shiji060-015:a001","paragraph_id":"c-shiji-060-sanwang:p004","start":207,"end":210,"surface":"平津侯","person_mention_id":"c-shiji-060-sanwang:m004-0207","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"依來源用稱保存，首次提及不補授職日；守、行事及兼攝不冒稱正式新授，單名及制度未定者不補姓或官制細節。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji060-022","person_id":"cbr-p003654","surfaces":["平津侯"],"scope":"same_chapter"