{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"hzq_i8y_lac","canonical_person_id":"hzq_i8y_lac","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["hzq_i8y_lac"],"persons":[{"id":"hzq_i8y_lac","label":"吳馮（王僧孺書所引）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"吳馮","mention_ids":["c-liangshu-033-wangsengru:p011:m0232"]}],"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-033","source_id":"s-liangshu-033-wangsengru-ws1514481","chapter_id":"c-liangshu-033-wangsengru","paragraph_id":"c-liangshu-033-wangsengru:p011","quote":"吳馮","mention_id":"c-liangshu-033-wangsengru:p011:m0232"}],"review":"ai_provisional","identity_note":"寫作吳馮，與夏馥同典。後漢夏馥傳另記自弟靜尋之；未視二人為一。"}],"source_mention_summary":[{"source_id":"s-liangshu-033-wangsengru-ws1514481","work_id":"w-liangshu","book_id":"b-liangshu-033","chapter_id":"c-liangshu-033-wangsengru","raw_mention_count":1,"mention_ids":["c-liangshu-033-wangsengru:p011:m0232"],"paragraph_ids":["c-liangshu-033-wangsengru:p011"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-liangshu-033-wangsengru:p011:m0232","mention_ids":["c-liangshu-033-wangsengru:p011:m0232"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-liangshu-033-wangsengru-ws1514481"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-liangshu-033-wangsengru:p011:m0232","surface":"吳馮","start":232,"end":234,"person_id":"hzq_i8y_lac","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-liangshu-033-wangsengru:p011","chapter_id":"c-liangshu-033-wangsengru"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-033-wangsengru:p011","text":"蓋先貴後賤，古富今貧，季倫所以發此哀音，雍門所以和其悲曲。又迫以嚴秋殺氣，具物多悲，長夜輾轉，百憂俱至。況復霜銷草色，風搖樹影。寒蟲夕叫，合輕重而同悲；秋葉晚傷，雜黃紫而俱墜。蜘蛛絡幕，熠耀爭飛，故無車轍馬聲，何聞鳴雞吠犬。俯眉事妻子，舉手謝賓遊。方與飛走爲鄰，永用蓬蒿自沒。愾其長息，忽不覺生之爲重。素無一廛之田，而有數口之累。豈曰匏而不食，方當長爲傭保，糊口寄身，溘死溝渠，以實螻蟻。悲夫！豈復得與二三士友，抱接膝之歡，履足差肩，摛綺縠之清文，談希微之道德。唯吳馮之遇夏馥，范式之值孔嵩，愍其留賃，憐此行乞耳。儻不以垢累，時存寸札，則雖先犬馬，猶松喬焉。去矣何生，高樹芳烈。裁書代面，筆淚俱下。","mentions":[{"id":"c-liangshu-033-wangsengru:p011:m0011","surface":"季倫","start":11,"end":13,"person_id":"385_7fd_092","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-liangshu-033-wangsengru:p011:m0020","surface":"雍門","start":20,"end":22,"person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"雍門周鼓琴故事，以地稱人，依對照保留原稱。"},{"id":"c-liangshu-033-wangsengru:p011:m0232","surface":"吳馮","start":232,"end":234,"person_id":"hzq_i8y_lac","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-liangshu-033-wangsengru:p011:m0236","surface":"夏馥","start":236,"end":238,"person_id":"z6y_bbe_hx7","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-liangshu-033-wangsengru:p011:m0239","surface":"范式","start":239,"end":241,"person_id":"cm9_2s9_s5t","kind":"person","status":"contextual_provisi