{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000320","identity_policy":"contextual_provisional","person_ids":["cbr-p000320"],"persons":[{"id":"cbr-p000320","label":"孟戲","status":"active","historicity":"legendary_tradition","aliases":[{"surface":"孟戲","mention_ids":["c-shiji-005-qin:m002-0074"]}],"evidence":[{"mention_id":"c-shiji-005-qin:m002-0074","chapter_id":"c-shiji-005-qin","paragraph_id":"c-shiji-005-qin:p002","quote":"孟戲"}],"identity_note":"依本卷開篇世系與傳說敘事建立；跨卷同名與神話世系待核，不補未見本名。","review":"ai_provisional"}],"mentions":[{"id":"c-shiji-005-qin:m002-0074","start":74,"end":76,"surface":"孟戲","kind":"person","person_id":"cbr-p000320","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p002","chapter_id":"c-shiji-005-qin"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-005-qin:p002","text":"大費生子二人：一曰大廉，實鳥俗氏；二曰若木，實費氏。其玄孫曰費昌，子孫或在中國，或在夷狄。費昌當夏桀之時，去夏歸商，為湯御，以敗桀於鳴條。大廉玄孫曰孟戲、中衍，鳥身人言。帝太戊聞而卜之使御，吉，遂致使御而妻之。自太戊以下，中衍之後，遂世有功，以佐殷國，故嬴姓多顯，遂為諸侯。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m002-0000","start":0,"end":2,"surface":"大費","kind":"person","person_id":"cbr-p000316","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m002-0009","start":9,"end":11,"surface":"大廉","kind":"person","person_id":"cbr-p000317","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m002-0019","start":19,"end":21,"surface":"若木","kind":"person","person_id":"cbr-p000318","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m002-0026","start":26,"end":29,"surface":"其玄孫","kind":"unresolved","person_id":null,"status":"unresolved","note":"氏族、群體或未核定跨卷身份與指代；不補造個人與世代。"},{"id":"c-shiji-005-qin:m002-0030","start":30,"end":32,"surface":"費昌","kind":"person","person_id":"cbr-p000319","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m002-0033","start":33,"end":35,"surface":"子孫","kind":"un