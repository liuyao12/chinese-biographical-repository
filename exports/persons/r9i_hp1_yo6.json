uired":false},"family_paths":[],"mentions":[{"id":"c-liangshu-030-peiziye:p004:m0118","start":118,"end":120,"surface":"徐勉","kind":"person","person_id":"r9i_hp1_yo6","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。","paragraph_id":"c-liangshu-030-peiziye:p004","chapter_id":"c-liangshu-030-peiziye"},{"id":"c-liangshu-030-peiziye:p005:m0114","start":114,"end":116,"surface":"徐勉","kind":"person","person_id":"r9i_hp1_yo6","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。","paragraph_id":"c-liangshu-030-peiziye:p005","chapter_id":"c-liangshu-030-peiziye"},{"id":"c-nanshi-033-pei-family:p018:m0157","start":157,"end":159,"surface":"徐勉","kind":"person","person_id":"r9i_hp1_yo6","status":"contextual_provisional","interpretation_note":"吏部尚書薦子野掌國史，後與周舍劉之遴觀移魏文；梁030同薦舉和文事。","paragraph_id":"c-nanshi-033-pei-family:p018","chapter_id":"c-nanshi-033-pei-family"},{"id":"c-nanshi-033-pei-family:p020:m0056","start":56,"end":58,"surface":"徐勉","kind":"person","person_id":"r9i_hp1_yo6","status":"contextual_provisional","interpretation_note":"吏部尚書薦子野掌國史，後與周舍劉之遴觀移魏文；梁030同薦舉和文事。","paragraph_id":"c-nanshi-033-pei-family:p020","chapter_id":"c-nanshi-033-pei-family"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-liang030-xumian","person_id":"r9i_hp1_yo6","surfaces":["徐勉"],"scope":"same_chapter","status":"contextual_provisional","confidence_level":"medium","identification_basis":{"kind":"source_context","target_mention_ids":["c-liangshu-030-peiziye:p004:m0118","c-liangshu-030-peiziye:p005:m0114"]},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-030","source_id":"s-liang030-ws1508510","chapter_id":"c-liangshu-030-peiziye","paragraph_id":"c-liangshu-030-peiziye:p004","quote":"初，子野曾祖松之，宋元嘉中受詔續修何承天《宋史》，未及成而卒，子野常欲繼成先業。及齊永明末，沈約所撰《宋書》旣行，子野更刪撰爲《宋略》二十卷。其敘事評論多善，約見而歎曰：「吾弗逮也。」蘭陵蕭琛、北地傅昭、汝南周捨咸稱重之。至是，吏部尚書徐勉言之於高祖，以爲著作郎，掌國史及起居注。頃之，兼中書通事舍人，尋除通直正員郎，著作、舍人如故。又敕掌中書詔誥。是時西北徼外有白題及滑國，遣使由岷山道入貢。此二國歷代弗賓，莫知所出。子野曰：「漢潁陰侯斬胡白題將一人。服虔《注》云：『白題，胡名也。』又漢定遠侯擊虜，八滑從之，此其後乎。」時人服其博識。敕仍使撰《方國使圖》，廣述懷來之盛，自要服至于海表，凡二十國。"},{"work_id":"w-liangshu","book_id":"b-liangshu-030","source_id":"s-liang030-ws1508510","chapter_id":"c-liangshu-030-peiziye","paragraph_id":"c-liangshu-030-peiziye:p005","quote":"子野與沛國劉顯、南陽劉之遴、陳郡殷芸、陳留阮孝緒、吳郡顧協、京兆韋棱，皆博極羣書，深相賞好，顯尤推重之。時吳平侯蕭勱、范陽張纘，每討論墳籍，咸折中於子野焉。普通七年，王師北伐，敕子野爲喻魏文，受詔立成，高祖以其事體大，召尚書僕射徐勉、太子詹事周捨、鴻臚卿劉之遴、中書侍郎朱异，集壽光殿以觀之，時並嘆服。高祖目子野而言曰：「其形雖弱，其文甚壯。」俄又敕爲書喻魏相元乂，其夜受旨，子野謂可待旦方奏，未之爲也。及五鼓，敕催令開齋速上，子野徐起操筆，昧爽便就。旣奏，高祖深嘉焉。自是凡諸符檄，皆令草創。子野爲文典而速，不尚麗靡之詞。其制作多法古，與今文體異，當時或有詆訶者，及其末皆翕然重之。或問其爲文速者，子野答云：「人皆成於手，我獨成於心，雖有見否之異，其於刊改一也。」"}],"rationale":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null},{"id":"d-nanshi033-徐勉","person_id":"r9i_hp1_yo6","surfaces":["徐勉"],"scope":"same_chapter","status":"contextual_provisional","confidence_level":"medium","identification_basis":{"kind":"source_context","target_mention_ids":["c-nanshi-033-pei-family:p018:m0157","c-nanshi-033-pei-family:p020:m0056"]},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-033","chapter_id":"c-nanshi-033-pei-family","source_id":"s-nanshi033-ws1554233","paragraph_id":"c-nanshi-033-pei-family:p018","quote":"初，子野曾祖松之，宋元嘉中受詔續修何承天宋史，未成而卒，子野常欲繼成先業。及齊永明末，沈約所撰《宋書》稱「松之已後無聞焉」。子野更撰為《宋略》二十卷，其敘事評論多善，而云：「戮淮南太守沈璞，以其不從義師故也」。約懼，徒跣謝之，請兩釋焉。歎其述作曰：「吾弗逮也。」蘭陵蕭琛言其評論可與過秦、王命分路揚鑣。於是吏部尚書徐勉言之于武帝，以為著作郎，掌修國史及起居注。頃之，兼中書通事舍人，尋除通直員外，著作、舍人如故。敕又掌中書詔誥。"},{"work_id":"w-nanshi","book_id":"b-nanshi-033","chapter_id":"c-nanshi-033-pei-family","source_id":"s-nanshi033-ws1554233","paragraph_id":"c-nanshi-033-pei-family:p020","quote":"繼母曹氏亡，居喪過禮，服闋，再遷員外郎。普通七年，大舉北侵，敕子野為移魏文，受詔立成。武帝以其事體大，召尚書僕射徐勉、太子詹事周舍、鴻臚卿劉之遴、中書侍郎朱異集壽光殿以觀之，時並嘆服。武帝目子野曰：「其形雖弱，其文甚壯。」俄又敕為書喻魏相元叉。其夜受旨，子野謂可待旦方奏，未之為也，及五鼓，敕催令速上。子野徐起操筆，昧爽便就。及奏，武帝深嘉焉。自是諸符檄皆令具草。"}],"rationale":"吏部尚書薦子野掌國史，後與周舍劉之遴觀移魏文；梁030同薦舉和文事。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null}],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-030-peiziye:p004","text":"初，子野曾祖松之，宋元嘉中受詔續修何承天《宋史》，未及成而卒，子野常欲繼成先業。及齊永明末，沈約所撰《宋書》旣行，子野更刪撰爲《宋略》二十卷。其敘事評論多善，約見而歎曰：「吾弗逮也。」蘭陵蕭琛、北地傅昭、汝南周捨咸稱重之。至是，吏部尚書徐勉言之於高祖，以爲著作郎，掌國史及起居注。頃之，兼中書通事舍人，尋除通直正員郎，著作、舍人如故。又敕掌中書詔誥。是時西北徼外有白題及滑國，遣使由岷山道入貢。此二國歷代弗賓，莫知所出。子野曰：「漢潁陰侯斬胡白題將一人。服虔《注》云：『白題，胡名也。』又漢定遠侯擊虜，八滑從之，此其後乎。」時人服其博識。敕仍使撰《方國使圖》，廣述懷來之盛，自要服至于海表，凡二十國。","source_position":{"start":1016,"end":1322,"raw":"　　初，子野曾祖松之，宋元嘉中受詔續修何承天《宋史》，未及成而卒，子野常欲繼成先業。及齊永明末，沈約所撰《[[宋書]]》旣行，子野更刪撰爲《宋略》二十卷。其敘事評論多善，約見而歎曰：「吾弗逮也。」蘭陵蕭琛、北地傅昭、汝南周捨咸稱重之。至是，吏部尚書徐勉言之於高祖，以爲著作郎，掌國史及起居注。頃之，兼中書通事舍人，尋除通直正員郎，著作、舍人如故。又敕掌中書詔誥。是時西北徼外有白題及滑國，遣使由岷山道入貢。此二國歷代弗賓，莫知所出。子野曰：「漢潁陰侯斬胡白題將一人。服虔《注》云：『白題，胡名也。』又漢定遠侯擊虜，八滑從之，此其後乎。」時人服其博識。敕仍使撰《方國使圖》，廣述懷來之盛，自要服至于海表，凡二十國。","raw_path":"sources/liangshu/wikisource-1508510-raw.wikitext"},"mentions":[{"id":"c-liangshu-030-peiziye:p004:m0002","start":2,"end":4,"surface":"子野","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p004:m0006","start":6,"end":8,"surface":"松之","kind":"person","person_id":"vpy_180_2oi_AA","status":"contextual_provisional","interpretation_note":"宋064原傳松之中書侍郎與注陳壽三國志、梁曾祖松之明字官爵及宋053議禮同人脈絡。"},{"id":"c-liangshu-030-peiziye:p004:m0017","start":17,"end":20,"surface":"何承天","kind":"person","person_id":"92h_l93_ixy","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p004:m0031","start":31,"end":33,"surface":"子野","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p004:m0046","start":46,"end":48,"surface":"沈約","kind":"person","person_id":"p8b_7w1_y3q","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p004: