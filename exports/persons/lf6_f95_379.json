,"end":107,"surface":"妻","kind":"person","person_id":"fml_n0s_qtz","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line012:m0108","start":108,"end":110,"surface":"桓氏","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"宗族／家門所指，不將集體氏稱另造為單一人物。"},{"id":"c-songshu-066-wangjinghong:line012:m0137","start":137,"end":139,"surface":"桓偉","kind":"person","person_id":"9j5_n7n_c3u","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line012:m0158","start":158,"end":159,"surface":"玄","kind":"person","person_id":"lf6_f95_379","status":"contextual_provisional"}],"source_position":{"first_line":12,"last_line":12,"revision_id":2069104,"editorial_excerpt_boundary":false},"chapter_id":"c-songshu-066-wangjinghong","book_id":"b-songshu-066","work_id":"w-songshu","source_id":"s-songshu-066-wangjinghong"},{"id":"c-songshu-066-wangjinghong:line024","text":"敬弘形狀短小，而坐起端方，桓玄謂之「彈棊八勢」。所居舍亭山，林澗環周，備登臨之美，時人謂之王東山。太祖嘗問為政得失，敬弘對曰：「天下有道，庶人不議。」上高其言。左右常使二老婢，戴五絛五辮，著青紋袴襦，飾以朱粉。女適尚書僕射何尚之弟述之，敬弘嘗往何氏看女，值尚之不在，寄齋中臥。俄頃尚之還，敬弘使二婢守閤不聽尚之入，云「正熱，不堪相見，君可且去。」尚之於是移於它室。子恢之被召為祕書郎，敬弘為求奉朝請，與恢之書曰：「祕書有限，故有競。朝請無限，故無競。吾欲使汝處於不競之地。」太祖嘉而許之。敬弘見兒孫歲中不過一再相見，見輒克日。恢之嘗請假還東定省，敬弘克日見之，至日輒不果，假日將盡，恢之乞求奉辭，敬弘呼前，既至閤，復不見。恢之於閤外拜辭，流涕而去。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-songshu-066-wangjinghong:line024:m0000","start":0,"end":2,"surface":"敬弘","kind":"person","person_id":"7r6_k52_qji_ABDABAA","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line024:m0013","start":13,"end":15,"surface":"桓玄","kind":"person","person_id":"lf6_f95_379","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line024:m0049","start":49,"end":51,"surface":"太祖","kind":"person","person_id":"3bh_k4m_fg4","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line024:m0058","start":58,"end":60,"surface":"敬弘","kind":"person","person_id":"7r6_k52_qji_ABDABAA","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line024:m0075","start":75,"end":76,"surface":"上","kind":"person","person_id":"3bh_k4m_fg4","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line024:m0084","start":84,"end":87,"surface":"二老婢","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"兩名老婢僅以群體出現，不能建立兩個可區分個人。"},{"id":"c-songshu-066-wangjinghong:line024:m0105","start":105,"end":106,"surface":"女","kind":"person","person_id":"7r6_k52_qji_ABDABAAD","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line024:m0111","start":111,"end":114,"surface":"何尚之","kind":"person","person_id":"d84_kqu_2g5","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line024:m0115","start":115,"end":117,"surface":"述之","kind":"person","person_id":"6dq_9ln_mo9","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line024:m0118","start":118,"end":120,"surface":"敬弘","kind":"person","person_id":"7r6_k52_qji_ABDABAA","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line024:m0125","start":125,"end":126,"surface":"女","kind":"person","person_id":"7r6_k52_qji_ABDABAAD","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line024:m0128","start":128,"end":130,"surface":"尚之","kind":"person","person_id":"d84_kqu_2g5","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line024:m0140","start":140,"end":142,"surface":"尚之","kind":"person","person_id":"d84_kqu_2g5","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line024:m0144","start":144,"end":146,"surface":"敬弘","kind":"person","person_id":"7r6_k52_qji_ABDABAA","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line024:m0147","start":147,"end":149,"surface":"二婢","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"承二老婢群體，成員未可分辨。"},{"id":"c-songshu-066-wangjinghong:line024:m0153","start":153,"end":155,"surface":"尚之","kind":"person","person_id":"d84_kqu_2g5","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line024:m0173","start":173,"end":175,"surface":"尚之","kind":"person","person_id":"d84_kqu_2g5","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line024:m0183","start":183,"end":185,"surface":"恢之","kind":"person","person_id":"7r6_k52_qji_ABDABAAA","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line024:m0192","start":192,"end":194,"surface":"敬弘","kind":"person","person_id":"7r6_k52_qji_ABDABAA","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line024:m0201","start":201,"end":203,"surface":"恢之","kind":"person","person_id":"7r6_k52_qji_ABDABAAA","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line024:m0225","start":225,"end":226,"surface":"吾","kind":"person","person_id":"7r6_k52_qji_ABDABAA","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line024:m0228","start":228,"end":229,"surface":"汝","kind":"person","person_id":"7r6_k52_qji_ABDABAAA","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line024:m0237","start":237,"end":239,"surface":"太祖","kind":"person","person_id":"3bh_k4m_fg4","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line024:m0244","start":244,"end":246,"surface":"敬弘","kind":"person","person_id":"7r6_k52_qji_ABDABAA","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line024:m0247","start":247,"end":249,"surface":"兒孫","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"兒孫泛稱未分個人，不視為絕對子女或孫輩總數。"},{"id":"c-songshu-066-wangjinghong:line024:m0263","start":263,"end":265,"surface":"恢之","kind":"person","person_id":"7r6_k52_qji_ABDABAAA","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line024:m0273","start":273,"end":275,"surface":"敬弘","kind":"person","person_id":"7r6_k52_qji_ABDABAA","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line024:m0291","start":291,"end":293,"surface":"恢之","kind":"person","person_id":"7r6_k52_qji_ABDABAAA","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line024:m0298","start":298,"end":300,"surface":"敬弘","kind":"person","person_id":"7r6_k52_qji_ABDABAA","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line024:m0311","start":311,"end":313,"surface":"恢之","kind":"person","person_id":"7r6_k52_qji_ABDABAAA","status":"contextual_provisional"}],"source_position":{"first_line":24,"last_line":24,"revision_id":2069104,"editorial_excerpt_boundary":false},"chapter_id":"c-songshu-066-wangjinghong","book_id":"b-songshu-066","work_id":"w-songshu","source_id":"s-songshu-066-wangjinghong"}],"sources":[{"chapter_id":"c-songshu-060-xunbozi","work_id":"w-songshu","book_id":"b-songshu-060","source_id":"s-songshu-060-xunbozi","source":{"title":"《宋書》卷60（數位選錄）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E5%AE%8B%E6%9B%B8/%E5%8D%B760&oldid=1996694","permalink":"https://zh.wikisource.org/w/index.php?title=%E5%AE%8B%E6%9B%B8/%E5%8D%B760&oldid=1996694","revision_id":1996694,"accessed_on":"2026-10-18","extent":"荀伯子及族弟附傳完整八段","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，未親核底本影像","response_sha256":"4d214309ba547bf979a60fdb76576b4767fe0c79210f1d37a4f95ec09ca60853","wikitext_sha256":"a9b03405240b25c24c2fa2b999e921483d7c1d78a3ed6f1eb1807a289bf02a97","normalization":{"character_conversion":{},"extraction_note":"只去段首排版空白及連結語法；ref校勘文字與正文分存。異體不轉換，未親核所報印本。","excerpts":[{"proposed_paragraph_id":"c-songshu-060-xunbozi:p001","source_lines":[91,92],"raw_quote":"荀伯子，潁川潁陰人也。祖羨，驃騎將軍。父猗，祕書郎。","raw_quote_sha256":"3316b34f10c1c4661b5c227dc9b806e8aac8fb66425ac77720e5f89cf2a231cf","selected_text_sha256":"3316b34f10c1c4661b5c227dc9b806e8aac8fb66425ac77720e5f89cf2a231cf","begin_anchor":"荀伯子，潁川潁陰人也。祖羨，驃","end_anchor":"祖羨，驃騎將軍。父猗，祕書郎。","digital_editorial_notes":[]},{"proposed_paragraph_id":"c-songshu-060-xunbozi:p002","source_lines":[93,94],"raw_quote":"伯子少好學，博覽經傳，而通率好為雜戲，遨遊閭里，故以此失清塗。解褐為駙馬都尉，奉朝請，員外散騎侍郎。著作郎徐廣重其才學，舉伯子及王韶之並為佐郎，助撰晉史及著桓玄等傳。遷尚書祠部郎。","raw_quote_sha256":"2082d511b885366b7bc07d354df34e9ea4a663e8542fe1ecbb911312d7762c0e","selected_text_sha256":"2082d511b885366b7bc07d354df34e9ea4a663e8542fe1ecbb911312d7762c0e","begin_anchor":"伯子少好學，博覽經傳，而通率好","end_anchor":"史及著桓玄等傳。遷尚書祠部郎。","digital_editorial_notes":[]},{"proposed_paragraph_id":"c-songshu-060-xunbozi:p003","source_lines":[95,96],"raw_quote":"義熙九年，上表曰：「臣聞咎繇亡後，臧文以為深歎；伯氏奪邑，管仲所以稱仁。功高可百世不泯，濫賞無崇朝宜許。故太傅鉅平侯祜，明德通賢，宗臣莫二，勳參佐命，功成平吳，而後嗣闕然，烝嘗莫寄。漢以蕭何元功，故絕世輒紹。愚謂鉅平之封，宜同酇國。故太尉廣陵公陳准，黨翼孫秀，禍加淮南，竊饗大國，因罪為利。值西朝政刑失裁，中興復因而不奪。今王道惟新，豈可不大判臧否，謂廣陵之國，宜在削除。故太保衞瓘本爵蕭陽縣公，<ref>故太保衞瓘本爵蕭陽縣公　「蕭陽」南史、晉書衞瓘傳、羊祜傳並作「菑陽」。錢大昕廿二史考異云：「蕭陽，晉書作菑陽。考晉書地理志不見此二縣名。」</ref>既被橫禍，及進第秩，始贈蘭陵，又轉江夏。中朝公輔，多非理終，瓘功德不殊，亦無緣獨受偏賞，宜復本封，以正國章。」詔付門下。","raw_quote_sha256":"97c479ab7b0f7d5fce1e5e6597a6f268c93757ef64f264eb2c53bb9c9cb88e67","selected_text_sha256":"2bf43a2b5f645409b2856e31871d673a353d83f6b2b6c71a46d1b3a7c567e5cb","begin_anchor":"義熙九年，上表曰：「臣聞咎繇亡","end_anchor":"復本封，以正國章。」詔付門下。","digital_editorial_notes":[{"raw_quote":"<ref>故太保衞瓘本爵蕭陽縣公　「蕭陽」南史、晉書衞瓘傳、羊祜傳並作「菑陽」。錢大昕廿二史考異云：「蕭陽，晉書作菑陽。考晉書地理志不見此二縣名。」</ref>","raw_start":198,"raw_end":278,"body_offset":198,"text_layer":"digital_editorial_note","printed_editions_directly_checked":false}]},{"proposed_paragraph_id":"c-songshu-060-xunbozi:p004","source_lines":[97,98],"raw_quote":"前散騎常侍江夏公衞璵上表自陳曰：「臣乃祖故太保瓘，於魏咸熙之中，太祖文皇帝為元輔之日，封蕭陽侯，大晉受禪，進爵為公，歷位太保，總錄朝政。于時賈庶人及諸王用事，忌瓘忠節，故楚王瑋矯詔致禍。前朝以瓘秉心忠正，加以伐蜀之勳，故追封蘭陵郡公。永嘉之中，東海王越食蘭陵，換封江夏，戶邑如舊。臣高祖散騎侍郎璪，瓘之嫡孫，<ref>瓘之嫡孫　各本並脫「瓘」字。孫虨宋書考論云：「璪下當脫瓘字。」按晉書衞瓘傳，璪為瓘之孫。孫說是，今訂補。</ref>纂承封爵。中宗元皇帝以曾祖故右衞將軍崇承襲，逮于臣身。伏聞祠部郎荀伯子表，欲貶降復封蕭陽。夫趙氏之忠，寵延累葉，漢祖開封，誓以山河。伏願陛下錄既往之勳，垂罔極之施，乞出臣表，付外參詳。」潁川陳茂先亦上表曰：「祠部郎荀伯子表臣七世祖太尉准禍加淮南，不應濫賞。尋先臣以剪除賈謐，封海陵公，事在淮南遇禍之前。後廣陵雖在擾攘之際，臣祖乃始蒙殊遇，歷位元、凱。後被遠外，乃作平州，而猶不至除國，良以先勳深重，百世不泯故也。聖明御世，英輔係興，曾無疑議，以為濫賞。臣以微弱，未齒人倫，加始勉視息，封爵兼嗣。伏願陛下遠錄舊勳，特垂矜察。」詔皆付門下，並不施行。","raw_quote_sha256":"548dde3f6233ec021cc4a7206a6b7f1cc9bc504013f772116bbc3b1ba4642ad5","selected_text_sha256":"cf3458af2f860fab8747c35495e3fb6fb9bfb18dcfbb8e78991d104f467ac096","begin_anchor":"前散騎常侍江夏公衞璵上表自陳曰","end_anchor":"矜察。」詔皆付門下，並不施行。","digital_editorial_notes":[{"raw_quote":"<ref>瓘之嫡孫　各本並脫「瓘」字。孫虨宋書考論云：「璪下當脫瓘字。」按晉書衞瓘傳，璪為瓘之孫。孫說是，今訂補。</ref>","raw_start":154,"raw_end":217,"body_offset":154,"text_layer":"digital_editorial_note","printed_editions_directly_checked":false}]},{"proposed_paragraph_id":"c-songshu-060-xunbozi:p005","source_lines":[99,100],"raw_quote":"伯子為世子征虜功曹，國子博士。妻弟謝晦薦達之，入為尚書左丞，出補臨川內史。車騎將軍王弘稱之曰：「沈重不華，有平陽侯之風。」伯子常自矜廕籍之美，謂弘曰：「天下膏粱，唯使君與下官耳。宣明之徒，不足數也。」遷散騎常侍，本邑大中正。又上表曰：「伏見百官位次，陳留王在零陵王上，臣愚竊以為疑。昔武王剋殷，封神農之後於焦，黃帝之後於祝，帝堯之後於薊，帝舜之後於陳，夏後於𣏌，殷後於宋。𣏌、陳並為列國，而薊、祝、焦無聞焉。斯則褒崇所承，優於遠代之顯驗也。是以春秋次序諸侯，宋居𣏌、陳之上。考之近世，事亦有徵。晉泰始元年，詔賜山陽公劉康子弟一人爵關內侯，衞公姬署、宋侯孔紹子一人駙馬都尉。又泰始三年，太常上博士劉憙等議，稱衞公署於大晉在三恪之數，應降稱侯。臣以零陵王位宜在陳留之上。」從之。","raw_quote_sha256":"86d75ec94991f4008282ce5b8d440902181a72965e7dafc5704f9212fa9aae93","selected_text_sha256":"86d75ec94991f4008282ce5b8d440902181a72965e7dafc5704f9212fa9aae93","begin_anchor":"伯子為世子征虜功曹，國子博士。","end_anchor":"零陵王位宜在陳留之上。」從之。","digital_editorial_notes":[]},{"proposed_paragraph_id":"c-songshu-060-xunbozi:p006","source_lines":[101,102],"raw_quote":"遷太子僕，御史中丞，莅職懃恪，有匪躬之稱，立朝正色，外內憚之。凡所奏劾，莫不深相謗毀，或延及祖禰，示其切直，又頗雜謿戲，故世人以此非之。出補司徒左長史，東陽太守。元嘉十五年，卒官，時年六十一。文集傳於世。","raw_quote_sha256":"cc9a06f73f61573e8f0a0831fb615f4864677abcbf7ebad53b0bb9a4fe899816","selected_text_sha256":"cc9a06f73f61573e8f0a0831fb615f4864677abcbf7ebad53b0bb9a4fe899816","begin_anchor":"遷太子僕，御史中丞，莅職懃恪，","end_anchor":"卒官，時年六十一。文集傳於世。","digital_editorial_notes":[]},{"proposed_paragraph_id":"c-songshu-060-xunbozi:p007","source_lines":[103,104],"raw_quote":"子赤松，為尚書左丞，<ref>子赤松為尚書左丞　宋本作「左丞」，弘治本、北監本、毛本、殿本、局本作「右丞」，本書顏延之傳亦作「尚書左丞荀赤松」，未知孰是。今姑從宋本及顏延之傳作「左丞」。</ref>以徐湛之黨，為元凶所殺。","raw_quote_sha256":"c1ab6af9e6f05fb53417f60c683bdc11c1b84184069019689c4b3dc7c385f799","selected_text_sha256":"01d867be11ae0febe4f6210d601c21a505475848d86531f3ed180758516f6c09","begin_anchor":"子赤松，為尚書左丞，以徐湛之黨","end_anchor":"左丞，以徐湛之黨，為元凶所殺。","digital_editorial_notes":[{"raw_quote":"<ref>子赤松為尚書左丞　宋本作「左丞」，弘治本、北監本、毛本、殿本、局本作「右丞」，本書顏延之傳亦作「尚書左丞荀赤松」，未知孰是。今姑從宋本及顏延之傳作「左丞」。</ref>","raw_start":10,"raw_end":99,"body_offset":10,"text_layer":"digital_editorial_note","printed_editions_directly_checked":false}]},{"proposed_paragraph_id":"c-songshu-060-xunbozi:p008","source_lines":[105,106],"raw_quote":"伯子族弟昶字茂祖，與伯子絕服五世。元嘉初，以文義至中書郎。昶子萬秋字元寶，亦用才學自顯。世祖初，為晉陵太守。坐於郡立華林閣，置主書、主衣，下獄免。前廢帝末，為御史中丞，卒官。","raw_quote_sha256":"5fe409fdedc3816f58cff333ffca13de5fee0be9b3c89313b4f87d3732acca38","selected_text_sha256":"5fe409fdedc3816f58cff333ffca13de5fee0be9b3c89313b4f87d3732acca38","begin_anchor":"伯子族弟昶字茂祖，與伯子絕服五","end_anchor":"。前廢帝末，為御史中丞，卒官。","digital_editorial_notes":[]}]}}},{"chapter_id":"c-songshu-066-wangjinghong","work_id":"w-songshu","book_id":"b-songshu-066","source_id":"s-songshu-066-wangjinghong","source":{"title":"《宋書》卷六十六（數位選錄）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E5%AE%8B%E6%9B%B8%2F%E5%8D%B766&oldid=2069104","permalink":"https://zh.wikisource.org/w/index.php?title=%E5%AE%8B%E6%9B%B8%2F%E5%8D%B766&oldid=2069104","revision_id":2069104,"accessed_on":"2026-10-18","extent":"王敬弘傳完整九原段；不包含同卷何尚之本傳。數位校注另層保留，未核影像。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，未親核底本影像","response_sha256":"4f129fde64f50ef8d0ee69e459b45b34e5f3f7ee8b1474dbfc7ea0796d53ae47","wikitext_sha256":"671045acf8eb033bd02cd9b1e4bd1f0b43ebe2005d0bf7b0b8706d64dce57cec","normalization":{"character_conversion":{},"extraction_note":"去首部空白，宋書ref校勘記另存，正文原字不改；不補平南將領的疑缺字。","excerpts":[{"proposed_paragraph_id":"c-songshu-066-wangjinghong:p001","source_lines":[10,11],"raw_quote":"王敬弘，琅邪臨沂人也。與高祖諱同，<ref>與高祖諱同　百衲本作「與高祖□□」，兩字空白。毛本、殿本作「同高祖諱」，今據南史、元龜八二四補。</ref>故稱字。曾祖廙，晉驃騎將軍。祖胡之，司州刺史。父茂之，晉陵太守。","raw_quote_sha256":"f30448f90558f6dffb53b3545d37e94a1a45ab8d4e7a740168cb293932b811a9","selected_text_sha256":"7dc019b51e303d9cb49fb1c0a30349afbe0288733ff2c36161f8213fe843229a","begin_anchor":"王敬弘，琅邪臨沂人也。與高祖諱","end_anchor":"，司州刺史。父茂之，晉陵太守。","removed_digital_editorial_notes":[{"text":"與高祖諱同　百衲本作「與高祖□□」，兩字空白。毛本、殿本作「同高祖諱」，今據南史、元龜八二四補。","text_layer":"modern_digital_apparatus","image_verified":false}]},{"proposed_paragraph_id":"c-songshu-066-wangjinghong:line012","source_lines":[12,12],"raw_quote":"敬弘少有清尚，起家本國左常侍，衛軍參軍。性恬靜，樂山水。為天門太守。敬弘妻，桓玄姊也。敬弘之郡，玄時為荊州，遣信要令過。敬弘至巴陵，謂人曰：「靈寶見要，正當欲與其姊集聚耳，我不能為桓氏贅壻。」乃遣別船送妻往江陵。妻在桓氏，彌年不迎。山郡無事，恣其遊適，累日不回，意甚好之。轉桓偉安西長史、南平太守。去官，居作唐縣界。玄輔政及篡位，屢召不下。","raw_quote_sha256":"faf1d73937e1522abdc42d538fea6b8c178a41fea7f3d8026a32c6efb1c496ef","selected_text_sha256":"faf1d73937e1522abdc42d538fea6b8c178a41fea7f3d8026a32c6efb1c496ef","begin_anchor":"敬弘少有清尚，起家本國左常侍，衛軍參","end_anchor":"居作唐縣界。玄輔政及篡位，屢召不下。","removed_digital_editorial_notes":[]},{"proposed_paragraph_id":"c-songshu-066-wangjinghong:line014","source_lines":[14,14],"raw_quote":"高祖以為車騎從事中郎，徐州治中從事史，征西將軍道規諮議參軍。時府主簿宗協亦有高趣，道規並以事外相期。嘗共酣飲致醉，敬弘因醉失禮，為外司所白，道規即更引還，重申初讌。召為中書侍郎，始攜家累自作唐還京邑。久之，轉黃門侍郎，不拜。仍除太尉從事中郎，出為吳興太守。舊居餘杭縣，悅是舉也。尋徵為侍中。高祖西討司馬休之，敬弘奉使慰勞，通事令史潘尚於道疾病，敬弘單船送還都，存亡不測，有司奏免官，詔可。未及釋朝服，值赦復官。宋國初建，為度支尚書，遷太常。","raw_quote_sha256":"3759624d1a381af510eb23d8b1ab282c7a0c8663db614eb327c497560dd78321","selected_text_sha256":"3759624d1a381af510eb23d8b1ab282c7a0c8663db614eb327c497560dd78321","begin_anchor":"高祖以為車騎從事中郎，徐州治中從事史","end_anchor":"復官。宋國初建，為度支尚書，遷太常。","removed_digital_editorial_notes":[]},{"proposed_paragraph_id":"c-songshu-066-wangjinghong:line016","source_lines":[16,16],"raw_quote":"高祖受命，補宣訓衛尉，加散騎常侍。永初三年，轉吏部尚書，常侍如故。敬弘每被除召，即便祗奉，既到宜退，旋復解官，高祖嘉其志，不苟違也。復除廬陵王師，加散騎常侍，自陳無德，不可師範令王，固讓不拜。又除祕書監，金紫光祿大夫，加散騎常侍，本州中正，又不就。太祖即位，又以為散騎常侍、金紫光祿大夫，領江夏王師。","raw_quote_sha256":"289858fa0bb07531eae796b5ed8f56c390b8814a9a536daa1210689e74dab327","selected_text_sha256":"289858fa0bb07531eae796b5ed8f56c390b8814a9a536daa1210689e74dab327","begin_anchor":"高祖受命，補宣訓衛尉，加散騎常侍。永","end_anchor":"散騎常侍、金紫光祿大夫，領江夏王師。","removed_digital_editorial_notes":[]},{"proposed_paragraph_id":"c-songshu-066-wangjinghong:line018","source_lines":[18,18],"raw_quote":"元嘉三年，為尚書僕射。關署文案，初不省讀。嘗豫聽訟，上問以疑獄，敬弘不對。上變色，問左右：「何故不以訊牒副僕射？」敬弘曰：「臣乃得訊牒讀之，政自不解。」上甚不悅。六年，遷尚書令，敬弘固讓，表求還東，上不能奪。改授侍中、特進、左光祿大夫，給親信二十人。讓侍中、特進，求減親信之半，不許。及東歸，車駕幸冶亭餞送。","raw_quote_sha256":"6a52ce7a197e1aeb6f4bf5b70b36af29d40c761ca5441ea757196b76d7eb5cc9","selected_text_sha256":"6a52ce7a197e1aeb6f4bf5b70b36af29d40c761ca5441ea757196b76d7eb5cc9","begin_anchor":"元嘉三年，為尚書僕射。關署文案，初不","end_anchor":"之半，不許。及東歸，車駕幸冶亭餞送。","removed_digital_editorial_notes":[]},{"proposed_paragraph_id":"c-songshu-066-wangjinghong:line020","source_lines":[20,20],"raw_quote":"十二年，徵為太子少傅。敬弘詣京師上表曰：「伏見詔書，以臣為太子少傅，承命震惶，喜懼交悸。臣抱疾東荒，志絕榮觀，不悟聖恩，猥復加寵。東宮之重，四海瞻望，非臣薄德，所可居之。今內外英秀，應選者多，且版築之下，豈無高逸，而近私愚朽，污辱清朝。嗚呼微臣，永非復大之一物矣。所以牽曳闕下者，實瞻望聖顏，貪繫表之旨。臣如此而歸，夕死無恨。」詔不許，表疏屢上，終以不拜。東歸，上時不豫，自力見焉。十六年，以為左光祿大夫、開府儀同三司，侍中如故，又詣京師上表曰：「臣比自啟聞，謂誠心已達，天鑒玄邈，未蒙在宥，不敢宴處，牽曳載馳。臣聞君子行道，忘其為身，三復斯言，若可庶勉，顧惜惽耄，志與願違。禮年七十，老而傳家，家道猶然，況於在國。伏願陛下矜臣西夕，愍臣一至，特迴聖恩，賜反其所，則天道下濟，愚心盡矣。」竟不拜東歸。二十三年，重申前命，又表曰：「臣躬耕南澧，不求聞達。先帝拔臣於蠻荊之域，賜以國士之遇。陛下嗣徽，特蒙眷齒，由是感激，委質聖朝。雖懷犬馬之誠，遂無塵露之益。年向九十，生理殆盡，永絕天光，淪沒丘壑。謹冒奉表，傷心久之。」","raw_quote_sha256":"3a84cd5d2905abb08a1cbc624211cf016ebaefe270b61c76df2ba8e93b952850","selected_text_sha256":"3a84cd5d2905abb08a1cbc624211cf016ebaefe270b61c76df2ba8e93b952850","begin_anchor":"十二年，徵為太子少傅。敬弘詣京師上表","end_anchor":"光，淪沒丘壑。謹冒奉表，傷心久之。」","removed_digital_editorial_notes":[]},{"proposed_paragraph_id":"c-songshu-066-wangjinghong:line022","source_lines":[22,22],"raw_quote":"明年，薨於餘杭之舍亭山，時年八十八。<ref>時年八十八　「八十八」各本並作「八十」，據南史訂正。張森楷校勘記云：「按敬弘表自云年向九十，當以南史為正。」</ref>追贈本官。順帝昇明二年詔曰：「夫塗祕蘭幽，貞芳載越，徽猷沈遠，懋禮彌昭。故侍中、左光祿大夫、開府儀同三司敬弘，神韻沖簡，識宇標峻，德敷象魏，道藹丘園。高挹榮冕，凝心塵外，清光粹範，振俗淳風。兼以累朝延賞，聲華在詠，而嘉篆闕文，猷策韜采，<ref>猷策韜采　「采」三朝本、北監本、毛本作「裏」，殿本作「裹」，今據元龜五九五改。</ref>尚想遙芬，興懷寢寤。便可詳定輝諡，式旌追典。」於是諡為文貞公。","raw_quote_sha256":"b5f29406e73ecaded1df9d2020b1f6646235480dcc943a22b74f86a6a3cb2893","selected_text_sha256":"57fb47939dc00a09013279f625052e6ccd6ec4f2179fb3a90d5f2937aa485210","begin_anchor":"明年，薨於餘杭之舍亭山，時年八十八。","end_anchor":"定輝諡，式旌追典。」於是諡為文貞公。","removed_digital_editorial_notes":[{"text":"時年八十八　「八十八」各本並作「八十」，據南史訂正。張森楷校勘記云：「按敬弘表自云年向九十，當以南史為正。」","text_layer":"modern_digital_apparatus","image_verified":false},{"text":"猷策韜采　「采」三朝本、北監本、毛本作「裏」，殿本作「裹」，今據元龜五九五改。","text_layer":"modern_digital_apparatus","image_verified":false}]},{"proposed_paragraph_id":"c-songshu-066-wangjinghong:line024","source_lines":[24,24],"raw_quote":"敬弘形狀短小，而坐起端方，桓玄謂之「彈棊八勢」。所居舍亭山，林澗環周，備登臨之美，時人謂之王東山。太祖嘗問為政得失，敬弘對曰：「天下有道，庶人不議。」上高其言。左右常使二老婢，戴五絛五辮，著青紋袴襦，飾以朱粉。女適尚書僕射何尚之弟述之，敬弘嘗往何氏看女，值尚之不在，寄齋中臥。俄頃尚之還，敬弘使二婢守閤不聽尚之入，云「正熱，不堪相見，君可且去。」尚之於是移於它室。子恢之被召為祕書郎，敬弘為求奉朝請，與恢之書曰：「祕書有限，故有競。朝請無限，故無競。吾欲使汝處於不競之地。」太祖嘉而許之。敬弘見兒孫歲中不過一再相見，見輒克日。恢之嘗請假還東定省，敬弘克日見之，至日輒不果，假日將盡，恢之乞求奉辭，敬弘呼前，既至閤，復不見。恢之於閤外拜辭，流涕而去。","raw_quote_sha256":"7dddcdd8b34f50f149c9aa810a63931282999f93b60de1919cb6af57eb9b4f69","selected_text_sha256":"7dddcdd8b34f50f149c9aa810a63931282999f93b60de1919cb6af57eb9b4f69","begin_anchor":"敬弘形狀短小，而坐起端方，桓玄謂之「","end_anchor":"，復不見。恢之於閤外拜辭，流涕而去。","removed_digital_editorial_notes":[]},{"proposed_paragraph_id":"c-songshu-066-wangjinghong:line026","source_lines":[26,26],"raw_quote":"恢之至新安太守，中大夫。恢之弟瓚之，世祖大明中，吏部尚書，金紫光祿大夫，諡曰貞子。瓚之弟昇之，都官尚書。昇之子延之，昇明末，為尚書左僕射，江州刺史。","raw_quote_sha256":"e5990dae09561aa0af577402994a1ed6432a1652d4674996837ee5c898b8d2fb","selected_text_sha256":"e5990dae09561aa0af577402994a1ed6432a1652d4674996837ee5c898b8d2fb","begin_anchor":"恢之至新安太守，中大夫。恢之弟瓚之，","end_anchor":"之，昇明末，為尚書左僕射，江州刺史。","removed_digital_editorial_notes":[]}]}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true}}
