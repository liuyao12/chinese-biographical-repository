{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"72w_zyp_07b","canonical_person_id":"72w_zyp_07b","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["72w_zyp_07b"],"persons":[{"id":"72w_zyp_07b","label":"箕子（龜策列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"箕子","mention_ids":["c-shiji-128-guice:m017-0323"]}],"evidence":[{"mention_id":"c-shiji-128-guice:m017-0323","chapter_id":"c-shiji-128-guice","paragraph_id":"c-shiji-128-guice:p017","quote":"箕子"}]}],"source_mention_summary":[{"source_id":"s-shiji128-guice","work_id":"w-shiji","book_id":"b-shiji-128","chapter_id":"c-shiji-128-guice","mention_count":1,"mention_ids":["c-shiji-128-guice:m017-0323"],"paragraph_ids":["c-shiji-128-guice:p017"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji128-guice"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-128-guice:m017-0323","start":323,"end":325,"surface":"箕子","kind":"person","person_id":"72w_zyp_07b","status":"contextual_provisional","paragraph_id":"c-shiji-128-guice:p017","chapter_id":"c-shiji-128-guice"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-128-guice:p017","text":"元王曰：「不然。寡人聞之，諫者福也，諛者賊也。人主聽諛，是愚惑也。雖然，禍不妄至，福不徒來。天地合氣，以生百財。陰陽有分，不離四時，十有二月，日至為期。聖人徹焉，身乃無災。明王用之，人莫敢欺。故云福之至也，人自生之；禍之至也，人自成之。禍與福同，刑與德雙。聖人察之，以知吉凶。桀紂之時，與天爭功，擁遏鬼神，使不得通。是固已無道矣，諛臣有眾。桀有諛臣，名曰趙梁。教為無道，勸以貪狼。繋湯夏臺，殺關龍逢。左右恐死，偷諛於傍。國危於累卵，皆曰無傷。稱樂萬歲，或曰未央。蔽其耳目，與之詐狂。湯卒伐桀，身死國亡。聽其諛臣，身獨受殃。春秋著之，至今不忘。紂有諛臣，名為左彊。誇而目巧，教為象郎。將至於天，又有玉床。犀玉之器，象箸而羹。聖人剖其心，壯士斬其胻。箕子恐死，被髪佯狂。殺周太子歷，囚文王昌。投之石室，將以昔至明。陰兢活之，與之俱亡。入於周地，得太公望。興卒聚兵，與紂相攻。文王病死，載尸以行。太子發代將，號為武王。戰於牧野，破之華山之陽。紂不勝敗而還走，圍之象郎。自殺宣室，身死不葬。頭懸車軫，四馬曳行。寡人念其如此，腸如涫湯。是人皆富有天下而貴至天子，然而大傲。欲無猒時，舉事而喜高，貪很而驕。不用忠信，聽其諛臣，而為天下笑。今寡人之邦，居諸侯之閒，曾不如秋毫。舉事不當，又安亡逃！」","annotation_status":"in_progress","text_layer":"witness_appended_chu_note","mentions":[{"id":"c-shiji-128-guice:m017-0000","start":0,"end":2,"surface":"元王","kind":"person","person_id":"a4t_7hv_0s6","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m017-0138","start":138,"end":139,"surface":"桀","kind":"person","person_id":"jyn_w3z_sqq","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m017-0139","start":139,"end":140,"surface":"紂","kind":"person","person_id":"ouo_jje_54i","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m017-0170","start":170,"end":171,"surface":"桀","kind":"person","person_id":"jyn_w3z_sqq","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m017-0177","start":177,"end":179,"surface":"趙梁","kind":"person","person_id":"lih_9tv_8hf","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m017-0191","start":191,"end":192,"surface":"湯","kind":"person","person_id":"7z7_4p3_g9m","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m017-0196","start":196,"end":199,"surface":"關龍逢","kind":"person","person_id":"mcj_otj_yir","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m017-0241","start":241,"end":242,"surface":"湯","kind":"person","person_id":"7z7_4p3_g9m","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m017-0244","start":244,"end":245,"surface":"桀","kind":"person","person_id":"jyn_w3z_sqq","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m017-0271","start":271,"end":272,"surface":"紂","kind":"person","person_id":"ouo_jje_54i","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m017-0278","start":278,"end":280,"surface":"左彊","kind":"p