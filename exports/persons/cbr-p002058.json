:"c-shiji-041-yue:m001-0058","start":58,"end":60,"surface":"允常","kind":"person","person_id":"cbr-p002058","status":"contextual_provisional","paragraph_id":"c-shiji-041-yue:p001","chapter_id":"c-shiji-041-yue"},{"id":"c-shiji-041-yue:m001-0074","start":74,"end":76,"surface":"允常","kind":"person","person_id":"cbr-p002058","status":"contextual_provisional","paragraph_id":"c-shiji-041-yue:p001","chapter_id":"c-shiji-041-yue"},{"id":"c-shiji-041-yue:m002-0008","start":8,"end":10,"surface":"允常","kind":"person","person_id":"cbr-p002058","status":"contextual_provisional","paragraph_id":"c-shiji-041-yue:p002","chapter_id":"c-shiji-041-yue"},{"id":"c-shiji-041-yue:m029-0007","start":7,"end":9,"surface":"允常","kind":"person","person_id":"cbr-p002058","status":"contextual_provisional","paragraph_id":"c-shiji-041-yue:p029","chapter_id":"c-shiji-041-yue"}],"relations":[{"id":"a-shiji041-001","subject_person_id":"cbr-p002055","predicate":"father","object_person_id":"cbr-p002058","status":"source_attested","evidence":[{"chapter_id":"c-shiji-041-yue","source_id":"s-shiji-041-yue","paragraph_id":"c-shiji-041-yue:p001","quote":"越王句踐，其先禹之苗裔，而夏后帝少康之庶子也。封於會稽，以奉守禹之祀。文身斷髮，披草萊而邑焉。後二十餘世，至於允常。允常之時，與呉王闔廬戰而相怨伐。允常卒，子句踐立，是爲越王。"}],"qualifiers":{"source_term":"允常卒，子句踐立","historicity":"historical_tradition"},"interpretation_note":"依明示子、生育或母稱保存來源主張；繼位本身不作父子，祖先不作父親，不補闕代、母名或確切時段。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji041-004","person_id":"cbr-p002058","surfaces":["允常"],"scope":"same_chapter","chapter_ids":["c-shiji-041-yue"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-041-yue:p001","quote":"越王句踐，其先禹之苗裔，而夏后帝少康之庶子也。封於會稽，以奉守禹之祀。文身斷髮，披草萊而邑焉。後二十餘世，至於允常。允常之時，與呉王闔廬戰而相怨伐。允常卒，子句踐立，是爲越王。"},{"paragraph_id":"c-shiji-041-yue:p002","quote":"元年，呉王闔廬聞允常死，乃興師伐越。越王句踐使死士挑戰，三行，至呉陳，呼而自剄。呉師觀之，越因襲撃呉師，呉師敗於檇李，射傷呉王闔廬。闔廬且死，告其子夫差曰：「必毋忘越。」"},{"paragraph_id":"c-shiji-041-yue:p029","quote":"越祖少康，至於允常。其子始霸，與呉爭彊。槜李之役，闔閭見傷。會稽之恥，勾踐欲當。種誘以利，蠡悉其良。折節下士，致膽思嘗。卒複讎寇，遂殄大邦。後不量力，滅於無彊。"}],"rationale":"限本篇明示姓名、短稱與同一事件角色；范蠡自謂鴟夷子皮、陶朱公按明文相接。跨篇僅使用另存同指決定，不按同名合併；匿名楚王不套用楚威王，未知諸子姓名不補。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-041-yue:p001","text":"越王句踐，其先禹之苗裔，而夏后帝少康之庶子也。封於會稽，以奉守禹之祀。文身斷髮，披草萊而邑焉。後二十餘世，至於允常。允常之時，與呉王闔廬戰而相怨伐。允常卒，子句踐立，是爲越王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-041-yue:m001-0000","start":0,"end":2,"surface":"越王","kind":"person","person_id":"cbr-p002055","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m001-0002","start":2,"end":4,"surface":"句踐","kind":"person","person_id":"cbr-p002055","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m001-0007","start":7,"end":8,"surface":"禹","kind":"person","person_id":"cbr-p002056","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m001-0013","start":13,"end":18,"surface":"夏后帝少康","kind":"person","person_id":"cbr-p002057","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m001-0019","start":19,"end":21,"surface":"庶子","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名、群體、神祇或引語用稱待覆核；不補姓名與成員。"},{"id":"c-shiji-041-yue:m001-0031","start":31,"end":32,"surface":"禹","kind":"person","person_id":"cbr-p002056","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m001-0055","start":55,"end":57,"surface":"允常","kind":"person","person_id":"cbr-p002058","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m001-0058","start":58,"end":60,"surface":"允常","kind":"person","person_id":"cbr-p002058","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m001-0064","start":64,"end":68,"surface":"呉王闔廬","kind":"person","person_id":"cbr-p002059","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m001-0074","start":74,"end":76,"surface":"允常","kind":"person","person_id":"cbr-p002058","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m001-0079","start":79,"end":81,"surface":"句踐","kind":"person","person_id":"cbr-p002055","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m001-0085","start":85,"end":87,"surface":"越王","kind":"person","person_id":"cbr-p002055","status":"contextual_provisional"}],"chapter_id":"c-shiji-041-yue","book_id":"b-shiji-041","work_id":"w-shiji","source_id":"s-shiji-041-yue"},{"id":"c-shiji-041-yue:p002","text":"元年，呉王闔廬聞允常死，乃興師伐越。越王句踐使死士挑戰，三行，至呉陳，呼而自剄。呉師觀之，越因襲撃呉師，呉師敗於檇李，射傷呉王闔廬。闔廬且死，告其子夫差曰：「必毋忘越。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-041-yue:m002-0003","start":3,"end":7,"surface":"呉王闔廬","kind":"person","person_id":"cbr-p002059","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m002-0008","start":8,"end":10,"surface":"允常","kind":"person","person_id":"cbr-p002058","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m002-0018","start":18,"end":20,"surface":"越王","kind":"person","person_id":"cbr-p002055","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m002-0020","start":20,"end":22,"surface":"句踐","kind":"person","person_id":"cbr-p002055","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m002-0061","start":61,"end":65,"surface":"呉王闔廬","kind":"person","person_id":"cbr-p002059","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m002-0066","start":66,"end":68,"surface":"闔廬","kind":"person","person_id":"cbr-p002059","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m002-0074","start":74,"end":76,"surface":"夫差","kind":"person","person_id":"cbr-p002060","status":"contextual_provisional"}],"chapter_id":"c-shiji-041-yue","book_id":"b-shiji-041","work_id":"w-shiji","source_id":"s-shiji-041-yue"},{"id":"c-shiji-041-yue:p029","text":"越祖少康，至於允常。其子始霸，與呉爭彊。槜李之役，闔閭見傷。會稽之恥，勾踐欲當。種誘以利，蠡悉其良。折節下士，致膽思嘗。卒複讎寇，遂殄大邦。後不量力，滅於無彊。","annotation_status":"named_mentions_first_pass","text_layer":"witness_appended_suoyin_zan","mentions":[{"id":"c-shiji-041-yue:m029-0002","start":2,"end":4,"surface":"少康","kind":"person","person_i