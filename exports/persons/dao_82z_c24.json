{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"dao_82z_c24","canonical_person_id":"dao_82z_c24","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["dao_82z_c24"],"persons":[{"id":"dao_82z_c24","label":"屯頭王（未名）（衛將軍驃騎列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"屯頭王","mention_ids":["c-shiji-111-wei-huo:m019-0129"]}],"evidence":[{"mention_id":"c-shiji-111-wei-huo:m019-0129","chapter_id":"c-shiji-111-wei-huo","paragraph_id":"c-shiji-111-wei-huo:p019","quote":"屯頭王"}]}],"source_mention_summary":[{"source_id":"s-shiji111-wei-huo","work_id":"w-shiji","book_id":"b-shiji-111","chapter_id":"c-shiji-111-wei-huo","raw_mention_count":1,"mention_ids":["c-shiji-111-wei-huo:m019-0129"],"paragraph_ids":["c-shiji-111-wei-huo:p019"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-shiji-111-wei-huo:m019-0129","mention_ids":["c-shiji-111-wei-huo:m019-0129"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-shiji111-wei-huo"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-111-wei-huo:m019-0129","start":129,"end":132,"surface":"屯頭王","kind":"person","person_id":"dao_82z_c24","status":"contextual_provisional","paragraph_id":"c-shiji-111-wei-huo:p019","chapter_id":"c-shiji-111-wei-huo"}],"relations":[],"title_holdings":[{"id":"th-shiji111-167","person_id":"dao_82z_c24","title":"屯頭王","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-111-wei-huo","source_id":"s-shiji111-wei-huo","paragraph_id":"c-shiji-111-wei-huo:p019","quote":"驃騎將軍亦將五萬騎，車重與大將軍軍等，而無裨將。悉以李敢等為大校，當裨將，出代、右北平千餘里，直左方兵，所斬捕功已多大將軍。軍既還，天子曰：「驃騎將軍去病率師，躬將所獲葷粥之士，約輕齎，絕大幕，涉獲章渠，以誅比車耆，轉擊左大將，斬獲旗鼓，歷涉離侯。濟弓閭，獲屯頭王、韓王等三人，將軍、相國、當戶、都尉八十三人，封狼居胥山，禪於姑衍，登臨翰海。執鹵獲丑七萬有四百四十三級，師率減什三，取食於敵，閒行殊遠而糧不絕，以五千八百戶益封驃騎將軍。」右北平太守路博德屬驃騎將軍，會與城，不失期，從至梼余山，斬首捕虜二千七百級，以千六百戶封博德為符離侯。北地都尉邢山從驃騎將軍獲王，以千二百戶封山為義陽侯。故歸義因淳王復陸支、樓專王伊即靬皆從驃騎將軍有功，以千三百戶封復陸支為壯侯，以千八百戶封伊即靬為眾利侯。從驃侯破奴、昌武侯安稽從驃騎有功，益封各三百戶。校尉敢得旗鼓，為關內侯，食邑二百戶。校尉自為爵大庶長。軍吏卒為官，賞賜甚多。而大將軍不得益封，軍吏卒皆無封侯者。"}],"attestations":[{"id":"th-shiji111-167:a001","paragraph_id":"c-shiji-111-wei-huo:p019","start":129,"end":132,"surface":"屯頭王","person_mention_id":"c-shiji-111-wei-huo:m019-0129","usage":"narrative","date_expression":null,"normalized_date":{"era":"BCE","era_year":119,"year":-118,"year_numbering":"astronomical","precision":"year","status":"editorial_provisional","original_quote":"驃騎將軍亦將五萬騎，車重與大將軍軍等，而無裨將。悉以李敢等為大校，當裨將，出代、右北平千餘里，直左方兵，所斬捕功已多大將軍。軍既還，天子曰：「驃騎將軍去病率師，躬將所獲葷粥之士，約輕齎，絕大幕，涉獲章渠，以誅比車耆，轉擊左大將，斬獲旗鼓，歷涉離侯。濟弓閭，獲屯頭王、韓王等三人，將軍、相國、當戶、都尉八十三人，封狼居胥山，禪於姑衍，登臨翰海。執鹵獲丑七萬有四百四十三級，師率減什三，取食於敵，閒行殊遠而糧不絕，以五千八百戶益封驃騎將軍。」右北平太守路博德屬驃騎將軍，會與城，不失期，從至梼余山，斬首捕虜二千七百級，以千六百戶封博德為符離侯。北地都尉邢山從驃騎將軍獲王，以千二百戶封山為義陽侯。故歸義因淳王復陸支、樓專王伊即靬皆從驃騎將軍有功，以千三百戶封復陸支為壯侯，以千八百戶封伊即靬為眾利侯。從驃侯破奴、昌武侯安稽從驃騎有功，益封各三百戶。校尉敢得旗鼓，為關內侯，食邑二百戶。校尉自為爵大庶長。軍吏卒為官，賞賜甚多。而大將軍不得益封，軍吏卒皆無封侯者。","evidence":[{"chapter_id":"c-shiji-111-wei-huo","source_id":"s-shiji111-wei-huo","paragraph_id":"c-shiji-111-wei-huo:p019","quote":"驃騎將軍亦將五萬騎，車重與大將軍軍等，而無裨將。悉以李敢等為大校，當裨將，出代、右北平千餘里，直左方兵，所斬捕功已多大將軍。軍既還，天子曰：「驃騎將軍去病率師，躬將所獲葷粥之士，約輕齎，絕大幕，涉獲章渠，以誅比車耆，轉擊左大將，斬獲旗鼓，歷涉離侯。濟弓閭，獲屯頭王、韓王等三人，將軍、相國、當戶、都尉八十三人，封狼居胥