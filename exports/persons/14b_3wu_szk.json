ed":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanshi-012-zhanglihua:p003:m0175","surface":"季","start":175,"end":176,"person_id":"14b_3wu_szk","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-nanshi-012-zhanglihua:p003","chapter_id":"c-nanshi-012-zhanglihua"}],"relations":[],"title_holdings":[{"id":"th-nan012-zhanglihua-m3-177-14b_3wu_szk","person_id":"14b_3wu_szk","title":"美人","kind":"imperial_rank","mode":"attestation","attestations":[{"id":"th-nan012-zhanglihua-m3-177-14b_3wu_szk:a","person_mention_id":"c-nanshi-012-zhanglihua:p003:m0175","usage":"narrative","date_expression":null,"paragraph_id":"c-nanshi-012-zhanglihua:p003","surface":"美人","start":177,"end":179}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-012","source_id":"s-nanshi-012-zhanglihua-ws2060595","chapter_id":"c-nanshi-012-zhanglihua","paragraph_id":"c-nanshi-012-zhanglihua:p003","quote":"至德二年，乃於光昭殿前起臨春、結綺、望仙三閣，高數十丈，並數十間。其窗牖、壁帶、縣楣、欄檻之類，皆以沈檀香為之，又飾以金玉，間以珠翠，外施珠簾。內有寶床寶帳，其服玩之屬，瑰麗皆近古未有。每微風暫至，香聞數里，朝日初照，光映後庭。其下積石為山，引水為池，植以奇樹，雜以花藥。後主自居臨春閣，張貴妃居結綺閣，龔、孔二貴嬪居望仙閣，並復道交相往來。又有王、季二美人，張、薛二淑媛，袁昭儀、何婕妤、江修容等七人，並有寵，遞代以遊其上。以宮人有文學者袁大舍等為女學士。後主每引賓客，對貴妃等游宴，則使諸貴人及女學士與狎客共賦新詩，互相贈答。采其尤豔麗者，以為曲調，被以新聲。選宮女有容色者以千百數，令習而歌之，分部疊進，持以相樂。其曲有玉樹後庭花、臨春樂等。其略云：「璧月夜夜滿，瓊樹朝朝新。」大抵所歸，皆美張貴妃、孔貴嬪之容色。","person_mention_id":"c-nanshi-012-zhanglihua:p003:m0175"}],"status":"source_attested","interpretation_note":"按本見證原職名及其所屬人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanshi-012-zhanglihua:p003","text":"至德二年，乃於光昭殿前起臨春、結綺、望仙三閣，高數十丈，並數十間。其窗牖、壁帶、縣楣、欄檻之類，皆以沈檀