s-sanguozhi-047-sun-quan-ws2602668"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-wu056-zhuran2","person_id":"9lx_69s_ukz","event_type":"death","source_term":"歸義馬茂懷奸，覺誅","date_expression":null,"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-056","chapter_id":"c-sanguozhi-056-zhuran","source_id":"s-sanguozhi-056-zhuran","paragraph_id":"c-sanguozhi-056-zhuran:line032","quote":"　　赤烏五年，征柤中，魏將蒲忠、胡質各將數千人，忠要遮險隘。圖斷然後，質為忠繼援。時然所督兵將先四出，聞問不暇收合，便將帳下見兵八百人逆掩。忠戰不利，質等皆退。九年，復征柤中，魏將李興等聞然深入，率步騎六千斷然後道，然夜出逆之，軍以勝反。先是，歸義馬茂懷奸，覺誅，權深忿之。然臨行上疏曰：「馬茂小子，敢負恩養。臣今奉天威，事蒙克捷，欲令所獲，震耀遠近，方舟塞江，使足可觀，以解上下之忿。惟陛下識臣先言，責臣後效。」權時抑表不出。然既獻捷，群臣上賀，權乃舉酒作樂，而出然表曰：「此家前初有表，孤以為難必，今果如其言，可謂明於見事也。」遣使拜然為左大司馬、右軍師。","person_mention_id":"c-sanguozhi-056-zhuran:line032:m0124"}],"interpretation_note":"本來源所記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-sanguozhi-047-sun-quan:p105:m0054","surface":"馬茂","start":54,"end":56,"kind":"person","person_id":"9lx_69s_ukz","status":"contextual_provisional","paragraph_id":"c-sanguozhi-047-sun-quan:p105","chapter_id":"c-sanguozhi-047-sun-quan"},{"id":"c-sanguozhi-047-sun-quan:p106:m0006","surface":"茂","start":6,"end":7,"kind":"person","person_id":"9lx_69s_ukz","status":"contextual_provisional","paragraph_id":"c-sanguozhi-047-sun-quan:p106","chapter_id":"c-sanguozhi-047-sun-quan"},{"id":"c-sanguozhi-047-sun-quan:p106:m0062","surface":"茂","start":62,"end":63,"kind":"person","person_id":"9lx_69s_ukz","status":"contextual_provisional","paragraph_id":"c-sanguozhi-047-sun-quan:p106","chapter_id":"c-sanguozhi-047-sun-quan"},{"id":"c-sanguozhi-047-sun-quan:p106:m0113","surface":"茂","start":113,"end":114,"kind":"person","person_id":"9lx_69s_ukz","status":"contextual_provisional","paragraph_id":"c-sanguozhi-047-sun-quan:p106","chapter_id":"c-sanguozhi-047-sun-quan"},{"id":"c-sanguozhi-056-zhuran:line032:m0124","start":124,"end":126,"surface":"馬茂","kind":"person","person_id":"9lx_69s_ukz","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-056-zhuran:line032","chapter_id":"c-sanguozhi-056-zhuran"},{"id":"c-sanguozhi-056-zhuran:line032:m0145","start":145,"end":147,"surface":"馬茂","kind":"person","person_id":"9lx_69s_ukz","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-056-zhuran:line032","chapter_id":"c-sanguozhi-056-zhuran"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-047-sun-quan:p105","text":"　　八年春二月，丞相陸遜卒。夏，雷霆犯宮門柱，又擊南津大橋楹。茶陵縣鴻水溢出，流漂居民二百餘家。秋七月，將軍馬茂等圖逆，夷三族。八月，大赦。遣校尉陳勳將屯田及作士三萬人鑿句容中道，自小其至雲陽西城，通會市，作邸閣。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":123,"last_line":123,"raw_start":22409,"raw_end":22694,"raw_character_offsets":[22409,22410,22411,22412,22413,22414,22415,22416,22417,22418,22419,22420,22421,22422,22423,22424,22425,22426,22427,22428,22429,22430,22431,22432,22433,22434,22435,22436,22437,22438,22439,22440,22441,22442,22443,22444,22445,22446,22447,22448,22449,22450,22451,22452,22453,22454,22455,22456,22457,22458,22459,22460,22461,22462,22463,22464,22465,22466,22467,22468,22469,22470,22471,22472,22473,22474,22475,22476,22477,22478,22479,22480,22481,22489,22490,22493,22494,22495,22496,22497,22498,22499,22500,22501,22502,22503,22504,22505,22506,22507,22508,22509,22510,22511,22512,22513,22514,22515,22516,22517,22525,22526,22529,22530,22531,22532,22533],"revision_id":2602668},"mentions":[{"id":"c-sanguozhi-047-sun-quan:p105:m0010","surface":"陸遜","start":10,"end":12,"kind":"person","person_id":"lii_454_vuv","status":"contextual_provisional"},{"id":"c-sanguozhi-047-sun-quan:p105:m0054","surface":"馬茂","start":54,"end":56,"kind":"person","person_id":"9lx_69s_ukz","status":"contextual_provisional"}],"chapter_id":"c-sanguozhi-047-sun-quan","book_id":"b-sanguozhi-047","work_id":"w-sanguozhi","source_id":"s-sanguozhi-047-sun-quan-ws2602668"},{"id":"c-sanguozhi-047-sun-quan:p106","text":"《吳歷》曰：茂本淮南鍾離長，而爲王凌所失，叛歸吳，吳以爲征西將軍、九江太守、外部督，封侯，領千兵。權數出苑中，與公卿諸將射。茂與兼符節令朱貞、無難督虞欽、牙門將朱志等合計，伺權在苑中，公卿諸將在門未入，令貞持節稱詔，悉收縛之；茂引兵入苑擊權，分據宮中及石頭塢，遣人報魏。事覺，皆族之。","text_layer":"witness_appended_pei_songzhi_note","annotation_status":"reviewed","source_position":{"first_line":123,"last_line":123,"raw_start":22538,"raw_end":22692,"raw_character_offsets":[22538,22539,22540,22541,22542,22543,22544,22545,22546,22547,22548,22549,22550,22551,22552,22553,22554,22555,22556,22557,22558,22559,22560,22561,22562,22563,22564,22565,22568,22571,22572,22573,22574,22575,22576,22577,22578,22579,22580,22581,22582,22583,22584,22585,22586,22587,22588,22589,22590,22591,22592,22593,22594,22595,22596,22597,22598,22599,22600,22601,22602,22603,22604,22605,22606,22607,22608,22609,22612,22615,22616,22617,22618,22619,22620,22621,22622,22623,22624,22625,22628,22631,22632,22633,22634,22635,22636,22637,22638,22639,22640,22641,22642,22643,22644,22645,22646,22647,22648,22649,22650,22651,22652,22653,22654,22655,22656,22657,22658,22659,22660,22661,22662,22663,22664,22665,22666,22667,22668,22669,22670,22671,22672,22673,22674,22675,22676,22677,22678,22679,22680,22681,22682,22683,22684,22685,22686,22687,22688,22689,22690,22691],"revision_id":2602668},"mentions":[{"id":"c-sanguozhi-047-