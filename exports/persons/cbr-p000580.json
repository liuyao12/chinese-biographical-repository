{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000580","canonical_person_id":"j82_fk4_3t1","id_aliases":["cbr-p000580"],"identity_policy":"contextual_provisional","person_ids":["j82_fk4_3t1"],"persons":[{"id":"j82_fk4_3t1","label":"王戊","status":"active","historicity":"historical_tradition","aliases":[{"surface":"卿王戊","mention_ids":["c-shiji-006-shihuang:p030:m0078"]}],"evidence":[{"mention_id":"c-shiji-006-shihuang:p030:m0078","chapter_id":"c-shiji-006-shihuang","paragraph_id":"c-shiji-006-shihuang:p030","quote":"卿王戊"}],"identity_note":"依本卷特定語境暫定人物；保留本文字形，不補未見姓名與讀法。","review":"ai_provisional","id_aliases":["cbr-p000580"]}],"source_mention_summary":[{"source_id":"s-shiji-006-shihuang","work_id":"w-shiji","book_id":"b-shiji-006","chapter_id":"c-shiji-006-shihuang","mention_count":1,"mention_ids":["c-shiji-006-shihuang:p030:m0078"],"paragraph_ids":["c-shiji-006-shihuang:p030"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-006-shihuang"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-006-shihuang:p030:m0078","start":78,"end":81,"surface":"卿王戊","kind":"person","person_id":"j82_fk4_3t1","status":"contextual_provisional","paragraph_id":"c-shiji-006-shihuang:p030","chapter_id":"c-shiji-006-shihuang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-006-shihuang:p030","text":"維秦王兼有天下，立名為皇帝，乃撫東土，至于瑯邪。列侯武城侯王離、列侯通武侯王賁、倫侯建成侯趙亥、倫侯昌武侯成、倫侯武信侯馮毋擇、丞相隗林、丞相王綰、卿李斯、卿王戊、五大夫趙嬰、五大夫楊樛從，與議於海上。曰：「古之帝者，地不過千里，諸侯各守其封域，或朝或否，相侵暴亂，殘伐不止，猶刻金石，以自為紀。古之五帝三王，知教不同，法度不明，假威鬼神，以欺遠方，實不稱名，故不久長。其身未歿，諸侯倍叛，法令不行。今皇帝并一海內，以為郡縣，天下和平。昭明宗廟，體道行德，尊號大成。群臣相與誦皇帝功德，刻于金石，以為表經。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:p030:m0011","start":11,"end":13,"surface":"皇帝","kind":"person","person_id":"ao3_0fy_d45_AAA","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p030:m0024","start":24,"end":31,"surface":"列侯武城侯王離","kind":"person","person_id":"3fo_o8y_1nx","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p030:m0032","start":32,"end":39,"surface":"列侯通武侯王賁","kind":"person","person_id":"k7i_c3h_ssl","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p030:m0040","start":40,"end":47,"surface":"倫侯建成侯趙亥","kind":"person","person_id":"9iv_9yu_skl","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p030:m0048","start":48,"end":54,"surface":"倫侯昌武侯成","kind":"person","person_id":"1le_lgg_yjv","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p030:m0055","start":55,"end":63,"surface":"倫侯武信侯馮毋擇","kind":"person","person_id":"xyx_811_vue","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p030:m0064","start":64,"end":68,"surface":"丞相隗林","kind":"person","person_id":"83h_9bz_3je","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p030:m0069","start":69,"end":73,"surface":"丞相王綰","kind":"person","person_id":"6n5_bpu_v5a","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p030:m0074","start":74,"end":77,"surface":"卿李斯","kind":"person","person_id":"49g_7az_e4i","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p030:m0078","start":78,"end":81,"surface":"卿王戊","kind":"person","person_id":"j82_fk4_3t1","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p030:m0082","start":82,"end":87,"surface":"五大夫趙嬰","kind":"person","person_id":"xie_13c_5ho","status":"contextual_provi