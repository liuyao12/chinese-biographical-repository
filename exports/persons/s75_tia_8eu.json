ths":[],"mentions":[{"id":"c-jinshu-066-liuhong:p006:m0055","surface":"何松","start":55,"end":57,"person_id":"s75_tia_8eu","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-066-liuhong:p006","chapter_id":"c-jinshu-066-liuhong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-066-liuhong:p006","text":"陳敏寇揚州，引兵欲西上，弘乃解南蠻，以授前北軍中候蔣超，統江夏太守陶侃、武陵太守苗光，以大眾屯于夏口。又遣治中何松領建平、宜都、襄陽三郡兵，屯巴東，為羅尚後繼。又加南平太守應詹甯遠將軍，督三郡水軍，繼蔣超。侃與敏同郡，又同歲舉吏，或有間侃者，弘不疑之。乃以侃為前鋒督護，委以討敏之任。侃遣子及兄子為質，弘遣之曰：「賢叔征行，君祖母年高，便可歸也。匹夫之交尚不負心，何況大丈夫乎！」陳敏竟不敢窺境。永興三年，詔進號車騎將軍，開府及餘官如故。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":20,"last_line":20,"raw_start":2171,"raw_end":2399,"raw_character_offsets":[2173,2174,2175,2176,2177,2178,2179,2180,2181,2182,2183,2184,2185,2186,2187,2188,2189,2190,2191,2192,2193,2194,2195,2196,2197,2198,2199,2200,2201,2202,2203,2204,2205,2206,2207,2208,2209,2210,2211,2212,2213,2214,2215,2216,2217,2218,2219,2220,2221,2222,2223,2224,2225,2226,2227,2228,2229,2230,2231,2232,2233,2234,2235,2236,2237,2238,2239,2240,2241,2242,2243,2244,2245,2246,2247,2248,2249,2250,2251,2252,2253,2254,2255,2256,2257,2258,2259,2260,2261,2262,2263,2264,2265,2266,2267,2268,2269,2270,2271,2272,2273,2274,2275,2276,2277,2278,2279,2280,2281,2282,2283,2284,2285,2286,2287,2288,2289,2290,2291,2292,2293,2294,2295,2296,2297,2298,2299,2300,2301,2302,2303,2304,2305,2306,2307,2308,2309,2310,2311,2312,2313,2314,2315,2316,2317,2318,2319,2320,2321,2322,2323,2324,2325,2326,2327,2328,2329,2330,2331,2332,2333,2334,2335,2336,2337,2338,2339,2340,2341,2342,2343,2344,2345,2346,2347,2348,2349,2350,2351,2352,2353,2354,2355,2356,2357,2358,2359,2360,2361,2362,2363,2364,2365,2366,2367,2368,2369,2370,2376,2377,2378,2379,2382,2383,2384,2385,2386,2387,2388,2389,2390,2391,2392,2393,2394,23