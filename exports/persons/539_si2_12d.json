viewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-songshu-047-liujingxuan:p016:m0088","start":88,"end":90,"surface":"龐萌","kind":"person","person_id":"539_si2_12d","status":"contextual_provisional","paragraph_id":"c-songshu-047-liujingxuan:p016","chapter_id":"c-songshu-047-liujingxuan"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-songshu-047-liujingxuan:p016","text":"初，敬宣回師於蜀，劉毅欲以重法繩之，高祖既相任待，又何無忌明言於毅，謂不宜以私憾傷至公，若必文致為戮，己當入朝以廷議決之。毅雖止，猶謂高祖曰：「夫生平之舊，豈可孤信。光武悔之於龐萌，曹公失之於孟卓，公宜深慮之。」毅出為荊州，謂敬宣曰：「吾忝西任，欲屈卿為長史、南蠻，豈有見輔意乎？」敬宣懼禍及，以告高祖。高祖笑曰：「但令老兄平安，必無過慮。」出為使持節、督北青州軍郡事、征虜將軍、北青州刺史，領清河太守，尋領冀州刺史。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":75,"last_line":75,"raw_start":7434,"raw_end":7643,"raw_character_offsets":[7434,7435,7436,7437,7438,7439,7440,7441,7442,7443,7444,7445,7446,7447,7448,7449,7450,7451,7452,7453,7454,7455,7456,7457,7458,7459,7460,7461,7462,7463,7464,7465,7466,7467,7468,7469,7470,7471,7472,7473,7474,7475,7476,7477,7478,7479,7480,7481,7482,7483,7484,7485,7486,7487,7488,7489,7490,7491,7492,7493,7494,7495,7496,7497,7498,7499,7500,7501,7502,7503,7504,7505,7506,7507,7508,7509,7510,7511,7512,7513,7514,7515,7516,7517,7518,7519,7520,7521,7522,7523,7524,7525,7526,7527,7528,7529,7530,7531,7532,7533,7534,7535,7536,7537,7538,7539,7540,7541,7542,7543,7544,7545,7546,7547,7548,7549,7550,7551,7552,7553,7554,7555,7556,7557,7558,7559,7560,7561,7562,7563,7564,7565,7566,7567,7568,7569,7570,7571,7572,7573,7574,7575,7576,7577,7578,7579,7580,7581,7582,7583,7584,7585,7586,7587,7588,7589,7590,7591,7592,7593,7594,7595,7596,7597,7598,7599,7600,7601,7602,7603,7604,7605,7606,7607,7608,7609,7610,7611,7612,7613,7614,7615,7616,7617,7618,7619,7620,7621,7622,7623,7624,7625,7626,7627,7628,7629,7630,7631,7632