l_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-jin069-liuchou","person_id":"n4t_dv5_dyl","event_type":"death","source_term":"尋為閻鼎所殺","source_anchor":{"paragraph_id":"c-jinshu-069-liuchou:p001","start":86,"end":92,"surface":"尋為閻鼎所殺"},"date_expression":null,"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-069","chapter_id":"c-jinshu-069-liuchou","source_id":"s-jinshu-069-liuchou-ws2012453","paragraph_id":"c-jinshu-069-liuchou:p001","quote":"子疇，字王喬，少有美譽，善談名理。曾避亂塢壁，賈胡百數欲害之，疇無懼色，援笳而吹之，為《出塞》、《入塞》之聲，以動其遊客之思。於是群胡皆垂泣而去之。永嘉中，位至司徒左長史，尋為閻鼎所殺。司空蔡謨每歎曰：「若使劉王喬得南渡，司徒公之美選也。」又王導初拜司徒，謂人曰：「劉王喬若過江，我不獨拜公也。」其為名流之所推服如此。","person_mention_id":"c-jinshu-069-liuchou:p001:m0001"}],"status":"source_attested","interpretation_note":"按同段人物與次第核所屬卒事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"mentions":[{"id":"c-jinshu-060-yanding:p001:m0123","surface":"劉疇","start":123,"end":125,"person_id":"n4t_dv5_dyl","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-060-yanding:p001","chapter_id":"c-jinshu-060-yanding"},{"id":"c-jinshu-060-yanding:p001:m0160","surface":"疇","start":160,"end":161,"person_id":"n4t_dv5_dyl","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-060-yanding:p001","chapter_id":"c-jinshu-060-yanding"},{"id":"c-jinshu-060-yanding:p002:m0041","surface":"疇","start":41,"end":42,"person_id":"n4t_dv5_dyl","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-060-yanding:p002","chapter_id":"c-jinshu-060-yanding"},{"id":"c-jinshu-060-yanding:p002:m0140","surface":"疇","start":140,"end":141,"person_id":"n4t_dv5_dyl","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-060-yanding:p002","chapter_id":"c-jinshu-060-yanding"},{"id":"c-jinshu-060-yanding:p002:m0156","surface":"疇","start":156,"end":157,"person_id":"n4t_dv5_dyl","kind":"person","status":"contextual_provisional","