秦王出奔密中，司空荀籓、籓弟司隸校尉組，及中領軍華恆、河南尹華薈，在密縣建立行臺，以密近賊，南趣許潁。司徒左長史劉疇在密為塢主，中書令李暅、太傅參軍騶捷劉蔚、鎮軍長史周顗、司馬李述皆來赴疇。僉以鼎有才用，且手握強兵，勸籓假鼎冠軍將軍、豫州刺史，蔚等為參佐。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":92,"last_line":92,"raw_start":7750,"raw_end":7947,"raw_character_offsets":[7752,7753,7754,7755,7756,7757,7758,7759,7760,7761,7762,7763,7764,7765,7766,7767,7768,7769,7770,7771,7772,7773,7774,7775,7776,7777,7778,7779,7780,7781,7782,7783,7784,7785,7786,7787,7788,7789,7790,7791,7792,7793,7794,7795,7796,7797,7798,7799,7800,7801,7802,7803,7804,7805,7806,7807,7808,7809,7810,7811,7812,7813,7814,7815,7816,7817,7818,7819,7820,7821,7822,7823,7824,7825,7826,7827,7828,7829,7830,7831,7832,7833,7834,7835,7836,7837,7838,7839,7840,7841,7842,7843,7844,7845,7846,7847,7848,7849,7850,7851,7852,7853,7854,7855,7856,7857,7858,7859,7860,7861,7862,7863,7864,7865,7866,7867,7868,7869,7870,7871,7872,7873,7874,7875,7876,7877,7878,7879,7880,7881,7882,7883,7884,7885,7886,7887,7888,7889,7890,7891,7892,7893,7894,7895,7896,7897,7898,7899,7900,7901,7902,7903,7904,7905,7906,7907,7908,7909,7910,7911,7912,7913,7914,7915,7916,7917,7918,7919,7920,7921,7922,7923,7924,7925,7926,7927,7928,7929,7930,7931,7932,7933,7934,7935,7936,7937,7938,7939,7940,7941,7942,7943,7944,7945,7946],"revision_id":2413335},"mentions":[{"id":"c-jinshu-060-yanding:p001:m0000","surface":"閻鼎","start":0,"end":2,"person_id":"emm_pbx_36w","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-yanding:p001:m0016","surface":"東海王越","start":16,"end":20,"person_id":"9o2_vhv_r7y","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-yanding:p001:m0067","surface":"秦王","start":67,"end":69,"person_id":"pss_n95_7x4","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-yanding:p001:m0076","surface":"荀籓","start":76,"end":78,"person_id":"yoo_ox0_545_FAAAA","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-yanding:p001:m0079","surface":"籓","start":79,"end":80,"