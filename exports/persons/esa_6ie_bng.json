person","person_id":"esa_6ie_bng","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-sanguozhi-052-gushao-complete:line048","chapter_id":"c-sanguozhi-052-gushao-complete"},{"id":"c-sanguozhi-052-gushao-complete:line048:m0285","start":285,"end":286,"surface":"諝","kind":"person","person_id":"esa_6ie_bng","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-sanguozhi-052-gushao-complete:line048","chapter_id":"c-sanguozhi-052-gushao-complete"},{"id":"c-sanguozhi-052-zhouzhao-complete:line116:m0288","start":288,"end":290,"surface":"丁諝","kind":"person","person_id":"esa_6ie_bng","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-sanguozhi-052-zhouzhao-complete:line116","chapter_id":"c-sanguozhi-052-zhouzhao-complete"}],"relations":[],"title_holdings":[{"id":"th-wu052-gs-1","person_id":"esa_6ie_bng","title":"典軍中郎","kind":"office","mode":"attestation","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-052","chapter_id":"c-sanguozhi-052-gushao-complete","source_id":"s-sanguozhi-052-gushao-complete","paragraph_id":"c-sanguozhi-052-gushao-complete:line048","quote":"邵字孝則，博覽書傳，好樂人倫。少與舅陸績齊名，而陸遜、張敦、卜靜等皆亞焉。自州郡庶幾及四方人士，往來相見，或言議而去，或結厚而別，風聲流聞，遠近稱之。權妻以策女。年二十七，起家爲豫章太守。下車祀先賢徐孺子之墓。優待其後。禁其淫祀非禮之祭者。小吏資質佳者，輒令就學，擇其先進，擢置右職，舉善以教，風化大行。初，錢唐丁諝出於役伍，陽羨張秉生於庶民。烏程呉粲、雲陽殷禮起乎微賤，邵皆拔而友之，爲立聲譽。秉遭大喪，親爲制服結絰。邵當之豫章，發在近路，值秉疾病，時送者百數。邵辭賓客曰：\"張仲節有疾，苦不能來別，恨不見之，暫還與訣，諸君少時相待。\"其留心下士，惟善所在，皆此類也。諝至典軍中郎，秉雲陽太守，禮零陵太守，粲太子少傅。世以邵爲知人。在郡五年，卒官，子譚、承雲。","person_mention_id":"c-sanguozhi-052-gushao-complete:line048:m0156"}],"attestations":[{"id":"th-wu052-gs-1:a","paragraph_id":"c-sanguozhi-052-gushao-complete:line048","start":287,"end":291,"surface":"典軍中郎","person_mention_id":"c-sanguozhi-052-gushao-complete:line048:m0156","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_