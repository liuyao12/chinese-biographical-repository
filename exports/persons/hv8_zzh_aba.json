u-062-liuyu","raw_mention_count":1,"mention_ids":["c-jinshu-062-liuyu:p001:m0307"],"paragraph_ids":["c-jinshu-062-liuyu:p001"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-062-liuyu:p001:m0307","mention_ids":["c-jinshu-062-liuyu:p001:m0307"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-059-prince-yong-ws2650517"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-059-prince-yong:p005:m0093","surface":"刁默","start":93,"end":95,"person_id":"hv8_zzh_aba","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-059-prince-yong:p005","chapter_id":"c-jinshu-059-prince-yong"},{"id":"c-jinshu-059-prince-yong:p005:m0146","surface":"刁默","start":146,"end":148,"person_id":"hv8_zzh_aba","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-059-prince-yong:p005","chapter_id":"c-jinshu-059-prince-yong"},{"id":"c-jinshu-062-liuyu:p001:m0307","surface":"刁默","start":307,"end":309,"person_id":"hv8_zzh_aba","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-062-liuyu:p001","chapter_id":"c-jinshu-062-liuyu"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-059-prince-yong:p005","text":"初，越以張方劫遷車駕，天下怨憤，唱義與山東諸侯克期奉迎，先遣說顒，令送帝還都，與顒分陝而居。顒欲從之，而方不同。及東軍大捷，成都等敗，顒乃令方親信將郅輔夜斬方，送首以示東軍。尋變計，更遣刁默守潼關，乃咎輔殺方，又斬輔。顒先遣將呂朗等據滎陽，范陽王虓司馬劉琨以方首示朗，於是朗降。時東軍既盛，破刁默以入關，顒懼，又遣馬瞻、郭傳于霸水禦之，瞻等戰敗散走。顒乘單馬，逃於太白山。東軍入長安，大駕旋，乙太弟太保梁柳為鎮西將軍，守關中。馬瞻等出詣柳，因共殺柳於城內。瞻等與始平太守梁邁合從，迎顒于南山。顒初不肯入府，長安令蘇眾、記室督硃永勸顒表稱柳病卒，輒知方事。弘農太守裴暠、秦國內史賈龕、安定太守賈疋等起義討顒，斬馬瞻、梁邁等。東海王越遣督護麋晃率國兵伐顒。至鄭，顒將牽秀距晃，晃斬秀，並其二子。義軍據有關中，顒保城而已。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":178,"last_line":178,"raw_start":18266,"raw_end":18626,"raw_character_offsets":[18268,18269,18270,18271,18272,18273,18274,18275,18276,18277,18278,18279,18280,18281,18282,18283,18284,18285,18286,18287,18288,18289,18290,18291,18292,18293,18294,18295,18296,18297,18298,18299,18300,18301,18302,18303,18304,18305,18306,18307,18308,18309,18310,18311,18312,18313,18314,18315,18316,18317,18318,18319,18320,18321,18322,18323,18324,18325,18326,18327,18328,18329,18330,18331,18332,18333,18334,18335,18336,18337,18338,18339,18340,18341,18342,18343,18344,18345,18346,18347,18348,18349,18350,18351,18352,18353,18354,18355,18356,18357,18358,18359,18360,18361,18362,18363,18364,18365,18366,18367,18368,18369,18370,18371,18372,18373,18374,18375,18376,18377,18378,18379,18380,18381,18382,18383,18384,18385,18386,18387,18388,18389,18390,18391,18392,18393,18394,18395,18396,18397,18398,18399,18400,18401,18402,18403,18404,18405,18406,18407,18408,18409,18410,18411,18412,18413,18414,18415,18416,18417,18418,18419,18420,18421,18422,18423,18424,18425,18426,18427,18428,18429,18430,18431,18432,18433,18434,18435,18436,18437,18438,18439,18440,18441,18442,18443,18444,18445,18446,18447,18448,18449,18450,18451,18452,18453,18454,18455,18456,18457,18458,18459,18460,18461,18462,18463,18464,18465,18466,18467,18468