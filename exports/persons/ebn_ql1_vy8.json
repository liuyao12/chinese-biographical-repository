kind":"source_review","person_id":"ebn_ql1_vy8","source_quote":"寶宏改封宵城","reading":"改封承段首汝南公，通鑑誅殺條用汝南舊稱。","note":"改封承段首汝南公，通鑑誅殺條用汝南舊稱。","paragraph_id":"c-nanqishu-045-mian-complete:p004","start_codepoint":63,"end_codepoint":69,"human_reviewed":false,"chapter_id":"c-nanqishu-045-mian-complete","source_id":"s-nanqishu-045-mian-complete-ws2273185"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-qi045-xiaobaozhi-baohong","subject_person_id":"98q_mll_d6v_BA","object_person_id":"ebn_ql1_vy8","predicate":"brother","qualifiers":{"source_term":"弟寶覽爲江陵公，寶宏汝南公"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-045","chapter_id":"c-nanqishu-045-mian-complete","source_id":"s-nanqishu-045-mian-complete-ws2273185","paragraph_id":"c-nanqishu-045-mian-complete:p004","quote":"　　子寶晊嗣，爲持節、督湘州軍事、輔國將軍、湘州刺史。弟寶覽爲江陵公，寶宏汝南公，邑各千五百戶。二年，寶晊進號冠軍將軍。三年，寶宏改封宵城。永元元年，以安陸郡邊虜，寶晊改封湘東王。進號征虜將軍。二年，爲左衞將軍。高宗兄弟一門皆尚吏事，寶晊粗好文章。義師下，寶晊在城內，東昏廢，寶晊望物情歸己，坐待法駕，旣而城內送首詣梁王。宣德太后臨朝，以寶晊爲太常。寶晊不自安，謀反，兄弟皆伏誅。","subject_person_mention_id":"c-nanqishu-045-mian-complete:p004:m0003","object_person_mention_id":"c-nanqishu-045-mian-complete:p004:m0035"}],"status":"source_attested","interpretation_note":"弟字統領兩名兄弟，通鑑明記。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-qi045-xiaobaohong-death","person_id":"ebn_ql1_vy8","event_type":"death","source_term":"伏誅","source_anchor":{"paragraph_id":"c-nanqishu-045-mian-complete:p004","start":187,"end":189,"surface":"伏誅"},"date_expression":null,"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-045","chapter_id":"c-nanqishu-045-mian-complete","source_id":"s-nanqishu-045-mian-complete-ws2273185","paragraph_id":"c-nanqishu-045-mian-complete:p004","quote":"　　子寶晊嗣，爲持節、督湘州軍事、輔國將軍、湘州刺史。弟寶覽爲江陵公，寶宏汝南公，邑各千五百戶。二年，寶晊進號冠軍將軍。三年，寶宏改封宵城。永元元年，以安陸郡邊虜，寶