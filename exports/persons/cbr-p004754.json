{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004754","identity_policy":"contextual_provisional","person_ids":["cbr-p004754"],"persons":[{"id":"cbr-p004754","label":"屈丐（屈原賈生列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"楚將屈丐","mention_ids":["c-shiji-084-qujia:m004-0153"]}],"evidence":[{"mention_id":"c-shiji-084-qujia:m004-0153","chapter_id":"c-shiji-084-qujia","paragraph_id":"c-shiji-084-qujia:p004","quote":"楚將屈丐"}]}],"mentions":[{"id":"c-shiji-084-qujia:m004-0153","start":153,"end":157,"surface":"楚將屈丐","kind":"person","person_id":"cbr-p004754","status":"contextual_provisional","paragraph_id":"c-shiji-084-qujia:p004","chapter_id":"c-shiji-084-qujia"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji084-010","person_id":"cbr-p004754","surfaces":["楚將屈丐"],"scope":"same_chapter","chapter_ids":["c-shiji-084-qujia"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-084-qujia:p004","quote":"屈平既絀，其後秦欲伐齊。齊與楚從親，惠王患之。乃令張儀詳去秦，厚幣委質事楚，曰：「秦甚憎齊，齊與楚從親。楚誠能絕齊，秦願獻商、於之地六百里。」楚懷王貪而信張儀，遂絕齊，使使如秦受地。張儀詐之曰：「儀與王約六里，不聞六百里。」楚使怒去，歸告懷王。懷王怒，大興師伐秦。秦發兵擊之，大破楚師於丹、淅，斬首八萬，虜楚將屈丐，遂取楚之漢中地。懷王乃悉發國中兵以深入擊秦，戰於藍田。魏聞之，襲楚至鄧。楚兵懼，自秦歸。而齊竟怒不救楚，楚大困。"}],"rationale":"依前5段明示屈原名平、屈平與懷王張儀敘事暫接；湯武短稱各存，未補姓名。王、臣、吾等嵌套指代仍待逐處核定。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-084-qujia:p004","text":"屈平既絀，其後秦欲伐齊。齊與楚從親，惠王患之。乃令張儀詳去秦，厚幣委質事楚，曰：「秦甚憎齊，齊與楚從親。楚誠能絕齊，秦願獻商、於之地六百里。」楚懷王貪而信張儀，遂絕齊，使使如秦受地。張儀詐之曰：「儀與王約六里，不聞六百里。」楚使怒去，歸告懷王。懷王怒，大興師伐秦。秦發兵擊之，大破楚師於丹、淅，斬首八萬，虜楚將屈丐，遂取楚之漢中地。懷王乃悉發國中兵以深入擊秦，戰於藍田。魏聞之，襲楚至鄧。楚兵懼，自秦歸。而齊竟怒不救楚，楚大困。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m004-0000","start":0,"end":2,"surface":"屈平","kind":"person","person_id":"cbr-p004745","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m004-0018","start":18,"end":20