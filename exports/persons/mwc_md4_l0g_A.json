0098","start":98,"end":100,"surface":"周筵","kind":"person","person_id":"jo4_7hm_ivw","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p014:m0109","start":109,"end":110,"surface":"嵩","kind":"person","person_id":"3xx_gdy_or6_AAB","status":"contextual_provisional","interpretation_note":"069顗傳弟嵩與本061明三子相合；非賁嵩。"}],"chapter_id":"c-jinshu-061-zhou-family","book_id":"b-jinshu-061","work_id":"w-jinshu","source_id":"s-jinshu-061-ws7903772"},{"id":"c-jinshu-076-wangbin:line050","text":"及敦死，王含欲投王舒，王應勸含投彬。含曰：「大將軍平素與江州云何，汝欲歸之？」應曰：「此乃所以宜往也。江州當人強盛時，能立同異，此非常人所及。睹衰厄，必興湣惻。荊州守文，豈能意外行事！」含不從，遂共投舒，舒果沈含父子于江。彬聞應來，密具船以待之。既不至，深以為恨。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-076-wangbin:line050:m0001","start":1,"end":2,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional"},{"id":"c-jinshu-076-wangbin:line050:m0004","start":4,"end":6,"surface":"王含","kind":"person","person_id":"mwc_md4_l0g","status":"contextual_provisional"},{"id":"c-jinshu-076-wangbin:line050:m0008","start":8,"end":10,"surface":"王舒","kind":"person","person_id":"nbl_2bu_99w","status":"contextual_provisional"},{"id":"c-jinshu-076-wangbin:line050:m0011","start":11,"end":13,"surface":"王應","kind":"person","person_id":"mwc_md4_l0g_A","status":"contextual_provisional"},{"id":"c-jinshu-076-wangbin:line050:m0014","start":14,"end":15,"surface":"含","kind":"person","person_id":"mwc_md4_l0g","status":"contextual_provisional"},{"id":"c-jinshu-076-wangbin:line050:m0016","start":16,"end":17,"surface":"彬","kind":"person","person_id":"7r6_k52_qji_ABDB","status":"contextual_provisional"},{"id":"c-jinshu-076-wangbin:line050:m0018","start":18,"end":19,"surface":"含","kind":"person","person_id":"mwc_md4_l0g","status":"contextual_provisional"},{"id":"c-jinshu-076-wangbin:line050:m0022","start":22,"end":25,"surface":"大將軍","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional"},{"id":"c-jin