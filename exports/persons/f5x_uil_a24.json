sanguozhi-048-sun-hao-ws2085142"},{"id":"c-sanguozhi-065-wangfan-complete:p005","text":"　　丞相陸凱上疏曰：「常侍王蕃黃中通理，知天知物，處朝忠蹇，斯社稷之重鎮，大吳之龍逢也。昔事景皇，納言左右，景皇欽嘉，歎為異倫。而陛下忿其苦辭，惡其直對，梟之殿堂，屍骸暴棄，邦內傷心，有識悲悼。」其痛蕃如此。蕃死時年三十九，皓徙蕃家屬廣州。二弟著、延皆作佳器，郭馬起事，不為馬用，見害。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":16,"last_line":16,"raw_start":771,"raw_end":914,"raw_character_offsets":[771,772,773,774,775,776,777,778,779,780,781,782,783,784,785,786,787,788,789,790,791,792,793,794,795,796,797,798,799,800,801,802,803,804,805,806,807,808,809,810,811,812,813,814,815,816,817,818,819,820,821,822,823,824,825,826,827,828,829,830,831,832,833,834,835,836,837,838,839,840,841,842,843,844,845,846,847,848,849,850,851,852,853,854,855,856,857,858,859,860,861,862,863,864,865,866,867,868,869,870,871,872,873,874,875,876,877,878,879,880,881,882,883,884,885,886,887,888,889,890,891,892,893,894,895,896,897,898,899,900,901,902,903,904,905,906,907,908,909,910,911,912,913],"revision_id":2589669},"mentions":[{"id":"c-sanguozhi-065-wangfan-complete:p005:m0004","surface":"陸凱","start":4,"end":6,"kind":"person","person_id":"61q_ogq_ueq","status":"contextual_provisional"},{"id":"c-sanguozhi-065-wangfan-complete:p005:m0013","surface":"王蕃","start":13,"end":15,"kind":"person","person_id":"z8o_i3j_zja","status":"contextual_provisional"},{"id":"c-sanguozhi-065-wangfan-complete:p005:m0046","surface":"景皇","start":46,"end":48,"kind":"person","person_id":"0fo_c5c_4yh","status":"contextual_provisional"},{"id":"c-sanguozhi-065-wangfan-complete:p005:m0054","surface":"景皇","start":54,"end":56,"kind":"person","person_id":"0fo_c5c_4yh","status":"contextual_provisional"},{"id":"c-sanguozhi-065-wangfan-complete:p005:m0100","surface":"蕃","start":100,"end":101,"kind":"person","person_id":"z8o_i3j_zja","status":"contextual_provisional"},{"id":"c-sanguozhi-065-wangfan-complete:p005:m0104","surface":"蕃","start":104,"end":105,"kind":"person","person_id":"z8o_i3j_zja","status":"contextual_provisional"},{"id":"