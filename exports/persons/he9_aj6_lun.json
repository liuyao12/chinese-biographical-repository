-058-zhou-jin:p001:m0000","paragraph_id":"c-jinshu-058-zhou-jin:p001","chapter_id":"c-jinshu-058-zhou-jin","quote":"筵"}],"review":"ai_provisional","identity_note":"061完整選定單元來源內身份暫定；同名不自動合併，來源局部鍵及候選獨立留證。"}],"source_mention_summary":[{"source_id":"s-jinshu-058-zhou-zha-ws1775463","work_id":"w-jinshu","book_id":"b-jinshu-058","chapter_id":"c-jinshu-058-zhou-zha","raw_mention_count":1,"mention_ids":["c-jinshu-058-zhou-zha:p002:m0077"],"paragraph_ids":["c-jinshu-058-zhou-zha:p002"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-058-zhou-zha:p002:m0077","mention_ids":["c-jinshu-058-zhou-zha:p002:m0077"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-058-zhou-zha-ws1775463"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin058-volume-zhou-zan-brother","subject_person_id":"he9_aj6_lun","object_person_id":"jo4_7hm_ivw","predicate":"brother","qualifiers":{"source_term":"筵弟贊"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-058","chapter_id":"c-jinshu-058-zhou-zha","source_id":"s-jinshu-058-zhou-zha-ws1775463","paragraph_id":"c-jinshu-058-zhou-zha:p002","quote":"王敦舉兵攻石頭，劄開門應敦，故王師敗績。敦轉劄爲光祿勳，尋補尚書。頃之，遷右將軍、會稽內史。時劄兄靖子懋晉陵太守、清流亭侯，懋弟筵征虜將軍，呉興內史，筵弟贊大將軍從事中郎、武康縣侯，贊弟縉太子文學、都鄕侯，次兄子勰臨淮太守、烏程公。劄一門五侯，並居列位，呉士貴盛，莫與爲比，王敦深忌之。後筵喪母，送者千數，敦益憚焉。及敦疾，錢風以周氏宗強，與沈充權勢相侔，欲自托於充，謀滅周氏，使充得專威揚土，乃説敦曰：「夫有國者患於強逼，自古釁難恆必由之。今江東之豪莫強周、沈，公萬世之後，二族必不靜矣。周強而多俊才，宜先爲之所，後嗣可安，國家可保耳。」敦納之。時有道士李脫者，妖術惑眾，自言八百歳，故號李八百。自中州至建鄴，以鬼道療病，又署人官位，時人多信事之。弟子李弘養徒灊山，云應讖當王。故敦使廬江太守李恆告劄及其諸兄子與脫謀圖不軌。時筵爲敦諮議參軍，即營中殺筵及脫、弘，又遣參軍賀鸞就沈充盡掩殺劄兄弟子，既而進軍會稽，襲劄。劄先不知，卒聞兵至，率麾下數百人出距之，兵散見殺。劄性貪財好色，惟以業產爲務。兵至之日，庫中有精杖，外白以配兵，劄猶惜不與，以弊者給之，其鄙吝如此，故士卒莫爲之用。","subject_person_mention_id":"c-jinshu-058-zhou-zha:p002:m0077","object_person_mention_id":"c-jinshu-058-zhou-zha:p002:m0064"}],"status":"source_attested","interpretation_note":"同段明稱筵弟贊。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"a-jin058-volume-zhou-jin-brother","subject_person_id":"fvk_8pa_cfq","object_person_id":"he9_aj6_lun","predicate":"brother","qualifiers":{"source_term":"贊弟縉"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-058","chapter_id":"c-jinshu-058-zhou-zha","source_id":"s-jinshu-058-zhou-zha-ws1775463","paragraph_id":"c-jinshu-058-zhou-zha:p002","quote":"王敦舉兵攻石頭，劄開門應敦，故王師敗績。敦轉劄爲光祿勳，尋補尚書。頃之，遷右將軍、會稽內史。時劄兄靖子懋晉陵太守、清流亭侯，懋弟筵征虜將軍，呉興內史，筵弟贊大將軍從事中郎、武康縣侯，贊弟縉太子文學、都鄕侯，次兄子勰臨淮太守、烏程公。劄一門五侯，並居列位，呉士貴盛，莫與爲比，王敦深忌之。後筵喪母，送者千數，敦益憚焉。及敦疾，錢風以周氏宗強，與沈充權勢相侔，欲自托於充，謀滅周氏，使充得專威揚土，乃説敦曰：「夫有國者患於強逼，自古釁難恆必由之。今江東之豪莫強周、沈，公萬世之後，二族必不靜矣。周強而多俊才，宜先爲之所，後嗣可安，國家可保耳。」敦納之。時有道士李脫者，妖術惑眾，自言八百歳，故號李八百。自中州至建鄴，以鬼道療病，又署人官位，時人多信事之。弟子李弘養徒灊山，云應讖當王。故敦使廬江太守李恆告劄及其諸兄子與脫謀圖不軌。時筵爲敦諮議參軍，即營中殺筵及脫、弘，又遣參軍賀鸞就沈充盡掩殺劄兄弟子，既而進軍會稽，襲劄。劄先不知，卒聞兵至，率麾下數百人出距之，兵散見殺。劄性貪財好色，惟以業產爲務。兵至之日，庫中有精杖，外白以配兵，劄猶惜不與，以弊者給之，其鄙吝如此，故士卒莫爲之用。","subject_person_mention_id":"c-jinshu-058-zhou-zha:p002:m0093","object_person_mention_id":"c-jinshu-058-zhou-zha:p002:m0077"}],"status":"source_attested","interpretation_note":"同段明稱贊弟縉。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-058-zhou-zha:p002:m0077","surface":"贊","start":77,"end":78,"person_id":"he9_aj6_lun","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-05