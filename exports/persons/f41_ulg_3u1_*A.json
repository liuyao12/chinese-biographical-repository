9_z00","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m007-0275","start":275,"end":276,"surface":"遂","kind":"person","person_id":"b80_lq9_z00","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m007-0278","start":278,"end":281,"surface":"左將軍","kind":"person","person_id":"ae4_u22_s8c","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m007-0299","start":299,"end":301,"surface":"樓船","kind":"person","person_id":"a4l_csw_6ha","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m007-0312","start":312,"end":313,"surface":"遂","kind":"person","person_id":"b80_lq9_z00","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m007-0330","start":330,"end":332,"surface":"樓船","kind":"person","person_id":"a4l_csw_6ha","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m007-0344","start":344,"end":345,"surface":"遂","kind":"person","person_id":"b80_lq9_z00","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m007-0354","start":354,"end":358,"surface":"樓船將軍","kind":"person","person_id":"a4l_csw_6ha","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m007-0359","start":359,"end":362,"surface":"左將軍","kind":"person","person_id":"ae4_u22_s8c","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m007-0368","start":368,"end":371,"surface":"左將軍","kind":"person","person_id":"ae4_u22_s8c","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m007-0375","start":375,"end":379,"surface":"樓船將軍","kind":"person","person_id":"a4l_csw_6ha","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m007-0386","start":386,"end":388,"surface":"天子","kind":"person","person_id":"5w8_533_9xk","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m007-0389","start":389,"end":391,"surface":"天子","kind":"person","person_id":"5w8_533_9xk","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m007-0392","start":392,"end":393,"surface":"遂","kind":"person","person_id":"b80_lq9_z00","status":"contextual_provisional"}],"chapter_id":"c-shiji-115-chaoxian","book_id":"b-shiji-115","work_id":"w-shiji","source_id":"s-shiji115-chaoxian"},{"id":"c-shiji-115-chaoxian:p008","text":"左將軍已并兩軍，即急擊朝鮮。朝鮮相路人、相韓陰、尼谿相參、將軍王唊相與謀曰：「始欲降樓船，樓船今執，獨左將軍并將，戰益急，恐不能與，（戰）王又不肯降。」陰、唊、路人皆亡降漢。路人道死。元封三年夏，尼谿相參乃使人殺朝鮮王右渠來降。王險城未下，故右渠之大臣成巳又反，復攻吏。左將軍使右渠子長降、相路人之子最告諭其民，誅成巳，以故遂定朝鮮，為四郡。封參為澅清侯，陰為荻苴侯，唊為平州侯，長［降］為幾侯。最以父死頗有功，為溫陽侯。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-115-chaoxian:m008-0000","start":0,"end":3,"surface":"左將軍","kind":"person","person_id":"ae4_u22_s8c","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m008-0017","start":17,"end":19,"surface":"路人","kind":"person","person_id":"z9d_qn5_wg8","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m008-0021","start":21,"end":23,"surface":"韓陰","kind":"person","person_id":"466_pwj_snr","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m008-0024","start":24,"end":28,"surface":"尼谿相參","kind":"person","person_id":"tvb_urc_goi","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m008-0031","start":31,"end":33,"surface":"王唊","kind":"person","person_id":"m61_2wu_0ru","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m008-0042","start":42,"end":44,"surface":"樓船","kind":"person","person_id":"a4l_csw_6ha","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m008-0045","start":45,"end":47,"surface":"樓船","kind":"person","person_id":"a4l_csw_6ha","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m008-0051","start":51,"end":54,"surface":"左將軍","kind":"person","person_id":"ae4_u22_s8c","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m008-0076","start":76,"end":77,"surface":"陰","kind":"person","person_id":"466_pwj_snr","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m008-0078","start":78,"end":79,"surface":"唊","kind":"person","person_id":"m61_2wu_0ru","status":"contextual_provisional"},{"id":"