person_id":"0ap_x9j_vf8","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-064-simaxia:p001:m0154","surface":"銓","start":154,"end":155,"person_id":"e9x_60x_9m9","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-064-simaxia:p001:m0156","surface":"端","start":156,"end":157,"person_id":"7xu_sss_agn","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-064-simaxia","book_id":"b-jinshu-064","work_id":"w-jinshu","source_id":"s-jinshu-064-simaxia-ws2622004"},{"id":"c-jinshu-064-wudi-sons-intro:p001","text":"武帝二十六男：楊元后生毗陵悼王軌、惠帝、秦獻王柬。審美人生城陽懷王景、楚隱王瑋、長沙厲王乂。徐才人生城陽殤王憲。匱才人生東海沖王祗。趙才人生始平哀王裕。趙美人生代哀王演。李夫人生淮南忠壯王允、吳孝王晏。嚴保林生新都懷王該。陳美人生清河康王遐。諸姬生汝陰哀王謨。程才人生成都王穎。王才人生孝懷帝。楊悼后生渤海殤王恢。餘八子不顯母氏，並早夭，又無封國及追諡，今並略之。其瑋、乂、穎自有傳。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":11,"last_line":11,"raw_start":170,"raw_end":470,"raw_character_offsets":[172,173,174,175,176,177,178,195,196,199,204,205,206,207,208,209,210,221,222,225,226,227,228,229,230,231,232,233,234,235,236,237,238,239,240,241,242,243,244,245,246,247,248,249,250,251,252,253,254,255,256,257,258,259,260,261,262,263,264,265,266,267,268,269,270,271,272,273,274,275,276,277,278,279,280,281,282,283,284,285,286,287,288,289,290,291,292,293,294,295,296,297,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,318,319,320,321,322,323,324,325,326,327,328,329,330,331,332,333,334,335,336,337,338,339,340,341,342,343,344,361,362,363,366,380,381,382,385,402,403,406,411,412,413,414,415,416,417,418,419,420,421,422,423,424,425,426,427,428,429,430,431,432,433,434,435,436,437,438,439,440,441,442,443,444,445,446,447,448,464,465,466,469],"revision_id":2622004},"mentions":[{"id":"c-jinshu-064-wudi-sons-intro:p001:m0000","surface":"武帝","start":0,"end":2,"person_id":"hgm_jvn_hle","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-064-wudi-sons-intro:p001:m0007","surface":"楊元后","start":7,"end":10,"person_id":"5mf_0mr_7v3","kind"