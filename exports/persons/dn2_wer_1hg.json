ssertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-jin064-xia","person_id":"dn2_wer_1hg","event_type":"death","source_term":"永康元年薨","source_anchor":{"paragraph_id":"c-jinshu-064-simaxia:p001","start":135,"end":140,"surface":"永康元年薨"},"date_expression":null,"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-064","chapter_id":"c-jinshu-064-simaxia","source_id":"s-jinshu-064-simaxia-ws2622004","paragraph_id":"c-jinshu-064-simaxia:p001","quote":"清河康王遐，字深度，美容儀，有精彩，武帝愛之。既受封，出繼叔父城陽哀王兆。太康十年，封渤海郡，曆右將軍、散騎常侍、前將軍。元康初，進撫軍將軍，加侍中，遐長而懦弱，無所是非。性好內，不能接士大夫。及楚王瑋之舉兵也，使遐收衛瓘，而瓘故吏榮晦遂盡殺瓘子孫，遐不能禁，為世所尤。永康元年薨，時年二十八。四子：覃、籥、銓、端。覃嗣立。","person_mention_id":"c-jinshu-064-simaxia:p001:m0000"}],"status":"source_attested","interpretation_note":"按同段人物與次第核所屬卒事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"mentions":[{"id":"c-jinshu-064-simaxia:p001:m0000","surface":"清河康王遐","start":0,"end":5,"person_id":"dn2_wer_1hg","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-064-simaxia:p001","chapter_id":"c-jinshu-064-simaxia"},{"id":"c-jinshu-064-wudi-sons-intro:p001:m0115","surface":"清河康王遐","start":115,"end":120,"person_id":"dn2_wer_1hg","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-064-wudi-sons-intro:p001","chapter_id":"c-jinshu-064-wudi-sons-intro"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-064-simaxia:p001","text":"清河康王遐，字深度，美容儀，有精彩，武帝愛之。既受封，出繼叔父城陽哀王兆。太康十年，封渤海郡，曆右將軍、散騎常侍、前將軍。元康初，進撫軍將軍，加侍中，遐長而懦弱，無所是非。性好內，不能接士大夫。及楚王瑋之舉兵也，使遐收衛瓘，而瓘故吏榮晦遂盡殺瓘子孫，遐不能禁，為世所尤。永康元年薨，時年二十八。四子：覃、籥、銓、端。覃嗣立。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":44,"last_line":44,"raw_start":2303,"raw_end":2537,"raw_character_offsets"