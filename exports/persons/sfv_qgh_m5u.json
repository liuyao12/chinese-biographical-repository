uqiao:p004:m0270","surface":"弘","start":270,"end":271,"person_id":"5is_zik_jbp","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-liuqiao:p004:m0389","surface":"范陽","start":389,"end":391,"person_id":"zg0_j4x_h0k","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-061-liuqiao","book_id":"b-jinshu-061","work_id":"w-jinshu","source_id":"s-jinshu-061-liuqiao-ws7903772"},{"id":"c-jinshu-061-liuqiao:p006","text":"時河間王顒方距關東，倚喬為助，不納其言。東海王越移檄天下，帥甲士三萬，將入關迎大駕，軍次於蕭，喬懼，遣子祐距越于蕭縣之靈壁。劉琨分兵向許昌，許昌人納之。琨自滎陽率兵迎越，遇祐，眾潰見殺。喬眾遂散，與五百騎奔平氏。帝還洛陽，大赦，越復表喬為太傅軍諮祭酒。越薨，復以喬為都督豫州諸軍事、鎮東將軍、豫州刺史。卒于官，時年六十三。湣帝末，追贈司空。子挺，潁川太守。挺子耽。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":114,"last_line":114,"raw_start":10127,"raw_end":10311,"raw_character_offsets":[10129,10130,10131,10132,10133,10134,10135,10136,10137,10138,10139,10140,10141,10142,10143,10144,10145,10146,10147,10148,10149,10150,10151,10152,10153,10154,10155,10156,10157,10158,10159,10160,10161,10162,10163,10164,10165,10166,10167,10168,10169,10170,10171,10172,10173,10174,10175,10176,10177,10178,10179,10180,10181,10182,10183,10184,10185,10186,10187,10188,10189,10190,10191,10192,10193,10194,10195,10196,10197,10198,10199,10200,10201,10202,10203,10204,10205,10206,10207,10208,10209,10210,10211,10212,10213,10214,10215,10216,10217,10218,10219,10220,10221,10222,10223,10224,10225,10226,10227,10228,10229,10230,10231,10232,10233,10234,10235,10236,10237,10238,10239,10240,10241,10242,10243,10244,10245,10246,10247,10248,10249,10250,10251,10252,10253,10254,10255,10256,10257,10258,10259,10260,10261,10262,10263,10264,10265,10266,10267,10268,10269,10270,10271,10272,10273,10274,10275,10276,10277,10278,10279,10280,10281,10282,10283,10284,10285,10286,10287,10288,10289,10290,10291,10292,10293,10294,10295,10296,10297,10298,10299,10300,10301,10302,10303,10304,10305,10306,10307,10308,10309,10310],"revision_id":7903772},"mentions":[{"id":"c-jinshu-061-liuqiao:p006:m0001","surface":"河間王顒","