40,"end":341,"person_id":"9o2_vhv_r7y","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-yue:p002:m0356","surface":"顒","start":356,"end":357,"person_id":"ed0_313_bea","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-yue:p002:m0359","surface":"張方","start":359,"end":361,"person_id":"eti_fp9_fq5","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-yue:p002:m0369","surface":"越","start":369,"end":370,"person_id":"9o2_vhv_r7y","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-yue:p002:m0371","surface":"越","start":371,"end":372,"person_id":"9o2_vhv_r7y","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-yue:p002:m0378","surface":"許扶曆","start":378,"end":381,"person_id":"rto_7gc_pcg","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-yue:p002:m0382","surface":"駒次宿歸","start":382,"end":386,"person_id":"5ej_r47_m35","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-yue:p002:m0390","surface":"惠帝","start":390,"end":392,"person_id":"7e0_f69_1ac","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-yue:p002:m0397","surface":"越","start":397,"end":398,"person_id":"9o2_vhv_r7y","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-059-prince-yue","book_id":"b-jinshu-059","work_id":"w-jinshu","source_id":"s-jinshu-059-prince-yue-ws2650517"},{"id":"c-jinshu-061-liuqiao:p004","text":"喬復收散卒，屯于平氏，河間王顒進喬鎮東將軍、假節，以其長子祐為東郡太守，又遣劉弘、劉准、彭城王釋等率兵援喬。弘與喬箋曰：「適承范陽欲代明使君。明使君受命本朝，列居方伯，當官而行，同獎王室，橫見遷代，誠為不允。然古人有言，牽牛以蹊人之田，信有罪矣，而奪之牛，罰亦重矣。明使君不忍亮直狷介之忿，甘為戎首，竊以為過。何者？至人之道，用行舍藏。跨下之辱，猶宜俯就，況於換代之嫌，纖介之釁哉！范陽國屬，使君庶姓，周之宗盟，疏不間親，曲直既均，責有所在。廉藺區區戰國之將，猶能升降以利社稷，況命世之士哉！今天下紛紜，主上播越，正是忠臣義士同心戮力之時。弘實暗劣，過蒙國恩，願與使君共戴盟主，雁行下風，掃除凶寇，救蒼生之倒懸，反北辰於太極。此功未立，不宜乖離。備蒙顧遇，情隆于常，披露丹誠，不敢不盡。春秋之時，諸侯相伐，復為和親者多矣。願明使君回既往之恨，追不二之蹤，解連環之結，修如初之好。范陽亦將悔前之失，思崇後信矣。","text_layer":"received_chapter","annotation_status":"reviewed","source_p