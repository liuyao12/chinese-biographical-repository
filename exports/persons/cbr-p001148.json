start":161,"end":163,"surface":"智罃","kind":"person","person_id":"cbr-p001785","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m095-0166","start":166,"end":168,"surface":"林父","kind":"person","person_id":"cbr-p001760","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m095-0185","start":185,"end":187,"surface":"景公","kind":"person","person_id":"cbr-p001155","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m095-0191","start":191,"end":193,"surface":"隨會","kind":"person","person_id":"cbr-p000408","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m095-0197","start":197,"end":199,"surface":"文公","kind":"person","person_id":"cbr-p000252","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m095-0206","start":206,"end":208,"surface":"成王","kind":"person","person_id":"cbr-p000398","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m095-0210","start":210,"end":212,"surface":"子玉","kind":"person","person_id":"cbr-p001751","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m095-0214","start":214,"end":216,"surface":"文公","kind":"person","person_id":"cbr-p000252","status":"contextual_provisional"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"},{"id":"c-shiji-042-zheng:p025","text":"靈公元年春，楚獻黿於靈公。子家、子公將朝靈公，子公之食指動，謂子家曰：「佗日指動，必食異物。」及入，見靈公進黿羹，子公笑曰：「果然！」靈公問其笑故，具告靈公。靈公召之，獨弗予羹。子公怒，染其指，嘗之而出。公怒，欲殺子公。子公與子家謀先。夏，弒靈公。鄭人欲立靈公弟去疾，去疾讓曰：「必以賢，則去疾不肖；必以順，則公子堅長。」堅者，靈公庶弟，去疾之兄也。於是乃立子堅，是爲襄公。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-042-zheng:m025-0000","start":0,"end":2,"surface":"靈公","kind":"person","person_id":"cbr-p002168","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m025-0010","start":10,"end":12,"surface":"靈公","kind":"person","person_id":"cbr-p002168","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m025-0013","start":13,"end":15,"surface":"子家","kind":"person","person_id":"cbr-p002166","status":"context