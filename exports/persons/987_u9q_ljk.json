tw_147_F","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-051-pei-cui-zhang-complete","book_id":"b-nanqishu-051","work_id":"w-nanqishu","source_id":"s-nanqishu-051-pei-cui-zhang-complete-ws1504716"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p028","text":"　　近冒陳江夏之冤，定承聖詔，已有褒贈，此臣狂疏之罪也。然臣所以諮問者，不得其實，罪在萬沒，無所復云。但愚心所恨，非敢以父子之親，骨肉之閒，而僥幸曲陛下之法，傷至公之義。誠不曉聖朝所以然之意。若以狂主雖狂，而實是天子，江夏雖賢，實是人臣，先臣奉人臣逆人君，以爲不可申明詔，得矣；然未審陛下亦是人臣不？而鎮軍亦復奉人臣逆人君，今之嚴兵勁卒，方指於象魏者，其故何哉？臣所不死，苟存視息，非有他故，所以待皇運之開泰，申冤魂之枉屈。今皇運旣已開泰矣，而死於社稷盡忠，反以爲賊，臣何用此生陛下世矣。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":68,"last_line":68,"raw_start":5173,"raw_end":5418,"raw_character_offsets":[5174,5175,5176,5177,5178,5179,5180,5181,5182,5183,5184,5185,5186,5187,5188,5189,5190,5191,5192,5193,5194,5195,5196,5197,5198,5199,5200,5201,5202,5203,5204,5205,5206,5207,5208,5209,5210,5211,5212,5213,5214,5215,5216,5217,5218,5219,5220,5221,5222,5223,5224,5225,5226,5227,5228,5229,5230,5231,5232,5233,5234,5235,5236,5237,5238,5239,5240,5241,5242,5243,5244,5245,5246,5247,5248,5249,5250,5251,5252,5253,5254,5255,5256,5257,5258,5259,5260,5261,5262,5263,5264,5265,5266,5267,5268,5269,5270,5271,5272,5273,5274,5275,5276,5277,5278,5279,5280,5281,5282,5283,5284,5285,5286,5287,5288,5289,5290,5291,5292,5293,5294,5295,5296,5297,5298,5299,5300,5301,5302,5303,5304,5305,5306,5307,5308,5309,5310,5311,5312,5313,5314,5315,5316,5317,5318,5319,5320,5321,5322,5323,5324,5325,5326,5327,5328,5329,5330,5331,5332,5333,5334,5335,5336,5337,5338,5339,5340,5341,5342,5343,5344,5345,5346,5347,5348,5349,5350,5351,5352,5353,5354,5355,5356,5357,5358,5359,5360,5361,5362,5363,5364,5365,5366,5367,5368,5369,5370,5371,5372,5373,5374,5375,5376,5377,5378,5379,5380,5381,5382,5383,5384,5385,5386,5387,5388,5389,5390,5391,5392,5393,5394,5395,5396,5397,5398,5399,5400,5401,5402,5403,5404,5405,5406,5407,5408,5409,5410,5411,5412,5413,5414,5415,5416,5417],"revision_id":1504716},"mentions":[{"id":"c-nanqishu-051-pei-cui-zhang-complete:p028:m0005","start":5,"end":7,"surface":"江夏","kind":"person","person_id":"w4m_9tw_147_B","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p028:m0074","start":74,"end":76,"surface":"陛下","kind":"person","person_id":"w4m_9tw_147_F","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p028:m0109","start":109,"end":111,"surface":"江夏","kind":"person","person_id":"w4m_9tw_147_B","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p028:m0119","start":119,"end":121,"surface":"先臣","kind":"person","person_id":"tvq_7my_nqh","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p028:m0142","start":142,"end":144,"surface":"陛下","kind":"person","person_id":"w4m_9tw_147_F","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p028:m0151","start":151,"end":153,"surface":"鎮軍","kind":"person","person_id":"987_u9q_ljk","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p028:m0239","start":239,"end":241,"surface":"陛下","kind":"person","person_id":"w4m_9tw_147_F","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-051-pei-cui-zhang-complete","book_id":"b-nanqishu-051","work_id":"w-nanqishu","source_id":"s-nanqishu-051-pei-cui-zhang-complete-ws1504716"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p029","text":"　　臣聞王臣之節，竭智盡公，以奉其上。居股肱之任者，申理冤滯，薦達羣賢。凡此衆臣，夙興夜寐，心未嘗須臾之閒而不在公。故萬物無不得其理，而頌聲作焉。臣謹案鎮軍將軍臣穎冑，宗室之親，股肱之重，身有伊、霍之功，荷陛下稷、旦之任。中領軍臣詳，受帷幄之寄，副宰相之尊。皆所以棟樑朝廷，社稷之臣，天下所當，遑遑匪懈，盡忠竭誠，欲使萬物得理，而頌聲大興者，豈復宜踰此哉？而同知先臣股肱江夏，匡濟王室，天命未遂，王亡與亡，而不爲陛下瞥然一言。知而不言，是不忠之臣，不知而言，乃不智之臣，此而不知，將何所知？","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":70,"last_line":70,"raw_start":5420,"raw_end":5666,"raw_character_offsets":[5421,5422,5423,5424,5425,5426,5427,5428,5429,5430,5431,5432,5433,5434,5435,5436,5437,5438,5439,5440,5441,5442,5443,5444,5445,5446,5447,5448,5449,5450,5451,5452,5453,5454,5455,5456,5457,5458,5459,5460,5461,5462,546