ily_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-liangshu-028-xiahoukui-complete:p004:m0007","start":7,"end":9,"surface":"劉明","kind":"person","person_id":"plg_p2r_tkc","status":"contextual_provisional","paragraph_id":"c-liangshu-028-xiahoukui-complete:p004","chapter_id":"c-liangshu-028-xiahoukui-complete"}],"relations":[],"title_holdings":[{"id":"th-liangshu-028-xiahoukui-complete-4-2","title":"南兗州刺史","kind":"office","mode":"attestation","person_id":"plg_p2r_tkc","attestations":[{"id":"th-liangshu-028-xiahoukui-complete-4-2:a","paragraph_id":"c-liangshu-028-xiahoukui-complete:p004","start":2,"end":7,"surface":"南兗州刺史","person_mention_id":"c-liangshu-028-xiahoukui-complete:p004:m0007","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-028","chapter_id":"c-liangshu-028-xiahoukui-complete","source_id":"s-liangshu-028-xiahoukui-complete-ws1511902","paragraph_id":"c-liangshu-028-xiahoukui-complete:p004","quote":"時魏南兗州刺史劉明以譙城入附，詔遣鎮北將軍元樹帥軍應接，起夔爲雲麾將軍，隨機北討。尋授使持節、督南豫州諸軍事、南豫州刺史。六年，轉使持節、督豫淮陳潁建霍義七州諸軍事、豫州刺史。豫州積歲寇戎，人頗失業，夔乃帥軍人于蒼陵立堰，溉田千餘頃。歲收穀百餘萬石，以充儲備，兼贍貧人，境內賴之。夔兄亶先經此任，至是夔又居焉。兄弟並有恩惠於鄉里，百姓歌之曰：「我之有州，頻仍夏侯；前兄後弟，布政優優。」在州七年，甚有聲績，遠近多附之。有部曲萬人，馬二千匹，並服習精強，爲當時之盛。性奢豪，後房伎妾曳羅縠飾金翠者亦有百數。愛好人士，不以貴勢自高，文武賓客常滿坐，時亦以此稱之。大同四年，卒于州，時年五十六。有詔舉哀，賻錢二十萬，布二百匹。追贈侍中、安北將軍。諡曰桓。","person_mention_id":"c-liangshu-028-xiahoukui-complete:p004:m0007"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"