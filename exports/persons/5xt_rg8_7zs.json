s://zh.wikisource.org/wiki/史記/卷015","quote":"二十三。王翦、蒙武擊破楚軍，殺其將項燕。","scope":"received_parallel_event","image_verified":false,"table_cell_id":"shiji-015-r253-c01"},{"title":"《史記·六國年表》數位年欄","url":"https://zh.wikisource.org/wiki/史記/卷015","quote":"224","scope":"digital_editorial_regnal_year_equivalence_only","image_verified":false,"table_cell_id":"shiji-015-r253-c00"}],"rationale":"蒙武與王翦攻楚之敘述，保留被殺與二十三年；與本紀二十四年自殺異說分存。 西元數字是固定數位年表編者對照，非古代正文；未核書影，只到年，不換算月日。","reviewer":"Codex（AI 代理）","human_reviewed":false,"basis":{"kind":"parallel_event","source_event_quote":"殺項燕","reference_url":"https://zh.wikisource.org/wiki/史記/卷015","reference_event_quote":"二十三。王翦、蒙武擊破楚軍，殺其將項燕。","reference_year_quote":"224"},"record_id":"le-shiji088-002","person_id":"5xt_rg8_7zs","date_role":"life_event","event_type":"death"}],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji007-003","person_id":"5xt_rg8_7zs","surfaces":["項燕"],"scope":"cross_chapter","chapter_ids":["c-shiji-006-shihuang","c-shiji-007-xiangyu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-006-shihuang:p018","quote_passage_ref":"data/corpus/shiji/006.json"},{"paragraph_id":"c-shiji-007-xiangyu:p001","quote_passage_ref":"data/corpus/shiji/007.json"}],"rationale":"前卷末年楚將項燕與本卷楚將被秦將王翦所戮的敘事相符，仍待異源覆核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji040-094","person_id":"5xt_rg8_7zs","surfaces":["項燕"],"scope":"cross_chapter","chapter_ids":["c-shiji-006-shihuang","c-shiji-040-chu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-006-shihuang:p018","quote_passage_ref":"data/corpus/shiji/006.json"},{"paragraph_id":"c-shiji-040-chu:p094","quote_passage_ref":"data/corpus/shiji/040.json"}],"rationale":"秦始皇篇與楚篇同記王翦、蒙武攻荊／楚末期及項燕敗亡，依具體戰事暫同指；原稱荊／楚與紀年各自保留。 秦篇項燕自殺、楚篇王翦殺項燕兩說並存，尚未指定優先。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji073-037","person_id":"5xt_rg8_7zs","scope":"same_chapter","chapter_ids":["c-shiji-073-baiwang"],"status":"contextual_provisional","reviewe