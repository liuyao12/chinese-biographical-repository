p018","person_mention_id":"c-shiji-006-shihuang:m018-0080","quote_passage_ref":"data/corpus/shiji/006.json"}],"source_term":"項燕遂自殺","interpretation_note":"明言殺、死、卒、得首或自殺保存；太子丹得首只證明已死，不補殺人者。被俘、請降、亡國不當死亡；紀年待核。","reviewer":"Codex（AI 代理）","human_reviewed":false,"normalized_date":{"era":"BCE","era_year":223,"year":-222,"year_numbering":"astronomical","precision":"year","status":"editorial_provisional","original_quote":"二十三年，秦王復召王翦，彊起之，使將擊荊。取陳以南至平輿，虜荊王。秦王游至郢陳。荊將項燕立昌平君為荊王，反秦於淮南。二十四年，王翦、蒙武攻荊，破荊軍，昌平君死，項燕遂自殺。","evidence":[{"chapter_id":"c-shiji-006-shihuang","source_id":"s-shiji-006-shihuang","paragraph_id":"c-shiji-006-shihuang:p018","person_mention_id":"c-shiji-006-shihuang:m018-0080","quote_passage_ref":"data/corpus/shiji/006.json"}],"references":[{"title":"《史記·六國年表》原紀年欄","url":"https://zh.wikisource.org/wiki/史記/卷015","quote":"二十四。王翦、蒙武破楚，虜其王負芻。","scope":"received_regnal_year_attestation","image_verified":false,"table_cell_id":"shiji-015-r254-c01"},{"title":"《史記·六國年表》數位年欄","url":"https://zh.wikisource.org/wiki/史記/卷015","quote":"223","scope":"digital_editorial_regnal_year_equivalence_only","image_verified":false,"table_cell_id":"shiji-015-r254-c00"}],"rationale":"按本紀原明示二十四年換算；年表同格只支持二十四年的西元年對照，不冒充項燕自殺事件的平行證據。 西元數字是固定數位年表編者對照，非古代正文；未核書影，只到年，不換算月日。","reviewer":"Codex（AI 代理）","human_reviewed":false}},{"id":"le-shiji007-001","person_id":"5xt_rg8_7zs","event_type":"death","status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-007-xiangyu","source_id":"s-shiji-007-xiangyu","paragraph_id":"c-shiji-007-xiangyu:p001","person_mention_id":"c-shiji-007-xiangyu:m001-0032","quote_passage_ref":"data/corpus/shiji/007.json"}],"source_term":"為秦將王翦所戮者也","interpretation_note":"保存本篇追述項燕被王翦所戮；與秦始皇本紀自殺表述分存，不默改死亡方式。","reviewer":"Codex（AI 代理）","human_reviewed":false},{"id":"le-shiji040-073","person_id":"5xt_rg8_7zs","event_type":"death","status":"source_attested","date_expression":"四年","evidence":[{"chapter_id":"c-shiji-040-chu","source_id":"s-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p094","person_mention_id":"c-shiji-040-chu:m094-0061","quote_passage_ref":"data/corpus/shiji/040.json"}],"source_term":"殺將軍項燕","interpretation_note":"原文明示死亡，保留原君年及相對時長；被虜與滅國不推死亡，與其他篇異說分存。","reviewer":"Codex（AI 代理）","human_reviewed":false},{"id":"le-shiji073-004","person_id":"5xt_rg8_7zs","event_type":"death","status":"source_attested","date_expression":null,"source_term":"殺其將軍項燕","evidence":[{"chapter_id":"c-shiji-073-baiwang","source_id":"s-shiji-073-baiwang","paragraph_id":"c-shiji-073-baiwang:p012","person_mention_id":"c-shiji-073-baiwang:m012-0150","quote_passage_ref":"data/corpus/shiji/073.json"}],"interpretation_note":"僅保存具名者明示死亡；被虜、王降、病及群體死亡不轉為個人死亡。秦二世時皆已死是已死陳述，不當兩人同年或秦二世年內死亡；原月日不轉公曆。","reviewer":"Codex（AI 代理）","human_reviewed":false},{"id":"le-shiji088-002","person_id":"5xt_rg8_7zs","event_type":"death","status":"source_attested","date_expression":"始皇二十三年","source_term":"殺項燕","evidence":[{"chapter_id":"c-shiji-088-mengtian","source_id":"s-shiji-088-mengtian","paragraph_id":"c-shiji-088-mengtian:p001","person_mention_id":"c-shiji-088-mengtian:m001-0157","quote_passage_ref":"data/corpus/shiji/088.json"}],"interpretation_note":"蒙武與王翦攻楚之敘述，保留被殺與二十三年；與本紀二十四年自殺異說分存。 保存本篇原語及敘述範圍，不視作獨立證成，不由死亡一律終止所有官爵；未核書影。","reviewer":"Codex（AI 代理）","human_reviewed":false,"normalized_date":{"era":"BCE","era_year":224,"year":-223,"year_numbering":"astronomical","precision":"year","status":"editorial_provisional","original_quote":"蒙恬者，其先齊人也。恬大父蒙驁，自齊事秦昭王，官至上卿。秦莊襄王元年，蒙驁為秦將，伐韓，取成皋、滎陽，作置三川郡。二年，蒙驁攻趙，取三十七城。始皇三年，蒙驁攻韓，取十三城。五年，蒙驁攻魏，取二十城，作置東郡。始皇七年，蒙驁卒。驁子曰武，武子曰恬。恬嘗書獄典文學。始皇二十三年，蒙武為秦裨將軍，與王翦攻楚，大破之，殺項燕。二十四年，蒙武攻楚，虜楚王。蒙恬弟毅。","evidence":[{"chapter_id":"c-shiji-088-mengtian","source_id":"s-shiji-088-mengtian","paragraph_id":"c-shiji-088-mengtian:p001","person_mention_id":"c-shiji-088-mengtian:m001-0157","quote_passage_ref":"data/corpus/shiji/088.json"}],"references":[{"title":"《史記·六國年表》原紀年欄","url":"https://zh.wikisource.org/wiki/史記/卷015","quote":"二十三。王翦、蒙武擊破楚軍，殺其將項燕。","scope":"recei