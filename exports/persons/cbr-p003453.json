{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003453","canonical_person_id":"4wc_97x_2gd","id_aliases":["cbr-p003453"],"identity_policy":"contextual_provisional","person_ids":["4wc_97x_2gd"],"persons":[{"id":"4wc_97x_2gd","label":"孝惠（陳丞相世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"孝惠","mention_ids":["c-shiji-056-chen:m016-0102"]},{"surface":"孝惠帝","mention_ids":["c-shiji-056-chen:m017-0000","c-shiji-056-chen:m019-0012"]}],"evidence":[{"mention_id":"c-shiji-056-chen:m016-0102","chapter_id":"c-shiji-056-chen","paragraph_id":"c-shiji-056-chen:p016","quote":"孝惠"},{"mention_id":"c-shiji-056-chen:m017-0000","chapter_id":"c-shiji-056-chen","paragraph_id":"c-shiji-056-chen:p017","quote":"孝惠帝"},{"mention_id":"c-shiji-056-chen:m019-0012","chapter_id":"c-shiji-056-chen","paragraph_id":"c-shiji-056-chen:p019","quote":"孝惠帝"}],"id_aliases":["cbr-p003453"]}],"source_mention_summary":[{"source_id":"s-shiji-056-chen","work_id":"w-shiji","book_id":"b-shiji-056","chapter_id":"c-shiji-056-chen","mention_count":3,"mention_ids":["c-shiji-056-chen:m016-0102","c-shiji-056-chen:m017-0000","c-shiji-056-chen:m019-0012"],"paragraph_ids":["c-shiji-056-chen:p016","c-shiji-056-chen:p017","c-shiji-056-chen:p019"],"passage_count":3}],"most_mentioned_source_ids":["s-shiji-056-chen"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-056-chen:m016-0102","start":102,"end":104,"surface":"孝惠","kind":"person","person_id":"4wc_97x_2gd","status":"contextual_provisional","paragraph_id":"c-shiji-056-chen:p016","chapter_id":"c-shiji-056-chen"},{"id":"c-shiji-056-chen:m017-0000","start":0,"end":3,"surface":"孝惠帝","kind":"person","person_id":"4wc_97x_2gd","status":"contextual_provisional","paragraph_id":"c-shiji-056-chen:p017","chapter_id":"c-shiji-056-chen"},{"id":"c-shiji-056-chen:m019-0012","start":12,"end":15,"surface":"孝惠帝","kind":"person","person_id":"4wc_97x_2gd","status":"contextual_provisional","paragraph_id":"c-shiji-056-chen:p019","chapter_id":"c-shiji-056-chen"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji056-036","person_id":"4wc_97x_2gd","surfaces":["孝惠","孝惠帝"],"scope":"same_chapter","chapter_ids":["c-shiji-056-chen"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-056-chen:p016","quote":"平行聞高帝崩，平恐呂太后及呂嬃讒怒，乃馳傳先去。逢使者詔平與灌嬰屯於滎陽。平受詔，立復馳至宮，哭甚哀，因奏事喪前。呂太后哀之，曰：「君勞，出休矣。」平畏讒之就，因固請得宿衞中。太后乃以爲郎中令，曰：「傅敎孝惠。」是後呂嬃讒乃不得行。樊噲至，則赦復爵邑。"},{"paragraph_id":"c-shiji-056-chen:p017","quote":"孝惠帝六年，相國曹參卒，以安國侯王陵爲右丞相，陳平爲左丞相。"},{"paragraph_id":"c-shiji-056-chen:p019","quote":"安國侯既爲右丞相，二歳，孝惠帝崩。高后欲立諸呂爲王，問王陵，王陵曰：「不可。」問陳平，陳平曰：「可。」呂太后怒，乃詳遷陵爲帝太傅，實不用陵。陵怒，謝疾免，杜門竟不朝請，七年而卒。"}],"rationale":"依本篇明示名字、局部主語、授官爵與家世暫接。平城與負郭不作短名，韓王信與淮陰侯韓信、審食其與酈食其分開。上依高帝與孝文帝敘事換主語，指控與古代比擬不當已驗史實；未名者不補全名，女孫父親不由婚議推定。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-056-chen:p016","text":"平行聞高帝崩，平恐呂太后及呂嬃讒怒，乃馳傳先去。逢使者詔平與灌嬰屯於滎陽。平受詔，立復馳至宮，哭甚哀，因奏事喪前。呂太后哀之，曰：「君勞，出休矣。」平畏讒之就，因固請得宿衞中。太后乃以爲郎中令，曰：「傅敎孝惠。」是後呂嬃讒乃不得行。樊噲至，則赦復爵邑。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-056-chen:m016-0000","start":0,"end":1,"surface":"平","kind":"person","person_id":"04f_hzf_n06","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m016-0003","start":3,"end":5,"surface":"高帝","kind":"person","person_id":"gcp_v0l_0vh","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m016-0007","start":7,"end":