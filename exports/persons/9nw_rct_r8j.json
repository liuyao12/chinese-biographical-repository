{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"9nw_rct_r8j","canonical_person_id":"9nw_rct_r8j","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["9nw_rct_r8j"],"persons":[{"id":"9nw_rct_r8j","label":"武（平津侯主父列傳上書候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"武","mention_ids":["c-shiji-112-pingjin:m016-0186","c-shiji-112-pingjin:m016-0223"]}],"evidence":[{"mention_id":"c-shiji-112-pingjin:m016-0186","chapter_id":"c-shiji-112-pingjin","paragraph_id":"c-shiji-112-pingjin:p016","quote":"武"},{"mention_id":"c-shiji-112-pingjin:m016-0223","chapter_id":"c-shiji-112-pingjin","paragraph_id":"c-shiji-112-pingjin:p016","quote":"武"}]}],"source_mention_summary":[{"source_id":"s-shiji112-pingjin","work_id":"w-shiji","book_id":"b-shiji-112","chapter_id":"c-shiji-112-pingjin","mention_count":2,"mention_ids":["c-shiji-112-pingjin:m016-0186","c-shiji-112-pingjin:m016-0223"],"paragraph_ids":["c-shiji-112-pingjin:p016"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji112-pingjin"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-112-pingjin:m016-0186","start":186,"end":187,"surface":"武","kind":"person","person_id":"9nw_rct_r8j","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p016","chapter_id":"c-shiji-112-pingjin"},{"id":"c-shiji-112-pingjin:m016-0223","start":223,"end":224,"surface":"武","kind":"person","person_id":"9nw_rct_r8j","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p016","chapter_id":"c-shiji-112-pingjin"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-112-pingjin:p016","text":"閒者關東五穀不登，年歲未復，民多窮困，重之以邊境之事，推數循理而觀之，則民且有不安其處者矣。不安故易動。易動者，土崩之勢也。故賢主獨觀萬化之原，明於安危之機，修之廟堂之上，而銷未形之患。其要，期使天下無土崩之勢而已矣。故雖有彊國勁兵，陛下逐走獸，射蜚鳥，弘游燕之囿，淫縱恣之觀，極馳騁之樂，自若也。金石絲竹之聲不絕於耳，帷帳之私俳優侏儒之笑不乏於前，而天下無宿憂。名何必湯武，俗何必成康！雖然，臣竊以為陛下天然之聖，寬仁之資，而誠以天下為務，則湯武之名不難侔，而成康之俗可復興也。此二體者立，然後處尊安之實，揚名廣譽於當世，親天下而服四夷，餘恩遺德為數世隆，南面負扆攝袂而揖王公，此陛下之所服也。臣聞圖王不成，其敝足以安。安則陛下何求而不得，何為而不成，何征而不服乎哉！","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-112-pingjin:m016-0117","start":117,"end":119,"surface":"陛下","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m016-0185","start":185,"end":186,"surface":"湯","kind":"person","person_id":"oil_hwe_l58","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m016-0186","start":186,"end":187,"surface":"武","kind":"person","person_id":"9nw_rct_r8j","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m016-0191","start":191,"end":192,"surface":"成","kind":"person","person_id":"rb8_xqe_j0t","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m016-0192","start":192,"end":193,"surface":"康","kind":"person","person_id":"rwy_lxz_2cv","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m016-0201","start":201,"end":203,"surface":"陛下","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m016-0222","start":222,"end":223,"surface":"湯","kind":"person","person_id":"oil_hwe_l58","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m016-0223","start":223,"end":224,"surface":"武","kind":"person","person_id":"9nw_rct_r8j","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin