"}],"attestations":[{"id":"th-shiji101-027:a001","paragraph_id":"c-shiji-101-yuanchao:p012","start":199,"end":202,"surface":"大將軍","person_mention_id":"c-shiji-101-yuanchao:m012-0196","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":"吳楚反","evidence":[{"chapter_id":"c-shiji-101-yuanchao","source_id":"s-shiji-101-yuanchao","paragraph_id":"c-shiji-101-yuanchao:p012","quote":"吳楚反，聞，鼂錯謂丞史曰：「夫袁盎多受吳王金錢，專為蔽匿，言不反。今果反，欲請治盎宜知計謀。」丞史曰：「事未發，治之有絕。今兵西鄉，治之何益！且袁盎不宜有謀。」鼂錯猶與未決。人有告袁盎者，袁盎恐，夜見竇嬰，為言吳所以反者，願至上前口對狀。竇嬰入言上，上乃召袁盎入見。鼂錯在前，及盎請辟人賜閒，錯去，固恨甚。袁盎具言吳所以反狀，以錯故，獨急斬錯以謝吳，吳兵乃可罷。其語具在吳事中。使袁盎為太常，竇嬰為大將軍。兩人素相與善。逮吳反。諸陵長者長安中賢大夫爭附兩人，車隨者日數百乘。"}],"normalized_date":{"status":"editorial_provisional","era":"BCE","era_year":154,"year":-153,"year_numbering":"astronomical","precision":"year","original_quote":"吳楚反","evidence":[{"chapter_id":"c-shiji-101-yuanchao","source_id":"s-shiji-101-yuanchao","paragraph_id":"c-shiji-101-yuanchao:p012","quote":"吳楚反，聞，鼂錯謂丞史曰：「夫袁盎多受吳王金錢，專為蔽匿，言不反。今果反，欲請治盎宜知計謀。」丞史曰：「事未發，治之有絕。今兵西鄉，治之何益！且袁盎不宜有謀。」鼂錯猶與未決。人有告袁盎者，袁盎恐，夜見竇嬰，為言吳所以反者，願至上前口對狀。竇嬰入言上，上乃召袁盎入見。鼂錯在前，及盎請辟人賜閒，錯去，固恨甚。袁盎具言吳所以反狀，以錯故，獨急斬錯以謝吳，吳兵乃可罷。其語具在吳事中。使袁盎為太常，竇嬰為大將軍。兩人素相與善。逮吳反。諸陵長者長安中賢大夫爭附兩人，車隨者日數百乘。"},{"chapter_id":"c-shiji-011-jingdi","source_id":"s-shiji-011-jingdi","paragraph_id":"c-shiji-011-jingdi:p004","quote":"三年正月乙巳，赦天下。長星出西方。天火燔雒陽東宮大殿城室。吳王濞、楚王戊、趙王遂、膠西王卬、濟南王辟光、菑川王賢、膠東王雄渠反，發兵西鄉。天子為誅晁錯，遣袁盎諭告，不止，遂西圍梁。上乃遣大將軍竇嬰、太尉周亞夫將兵誅之。六月乙亥。赦亡軍及楚元王子藝等與謀反者。封大將軍竇嬰為魏其侯。立楚元王子平陸侯禮為楚王。立皇子端為膠西王，子勝為中山王。徙濟北王志為菑川王，淮陽王餘為魯王，汝南王非為江都王。齊王將廬、燕王嘉皆薨。"}],"references":[{"title":"漢初月朔考索──以出土簡牘為線索","author":"許名瑲","publication":"北市大語文學報","issue":12,"published_on":"2014-12","page":"120","url":"https://literacy.utaipei.edu.tw/var/file/65/1065/img/1007/256705145.pdf#page=124","quote":"景帝三年（前154年）","scope":"regnal_year_to_common_era_year_only","image_verified":false,"note":"已核讀期刊PDF文字之題名、作者、刊期與頁120年對照；未採本文月日改讀，也未稱本庫古籍影像已覆核。"}],"rationale":"本篇吳楚反及平定後授官與〈孝景本紀〉三年七國之亂及平陸侯禮立楚王互證；年對照採許名瑲頁120。公元前154年按天文年記作-153；不推月日或完整任期。","reviewer":"Codex（AI 代理）","human_reviewed":false}},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"實授、任事、敘事用稱與先前官職分存。欲使將而不肯不作已任，九卿只記類別，智囊為稱號，死亡不自動終止官爵。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[{"status":"editorial_provisional","era":"BCE","era_year":154,"year":-153,"year_numbering":"astronomical","precision":"year","original_quote":"吳楚反","evidence":[{"chapter_id":"c-shiji-101-yuanchao","source_id":"s-shiji-101-yuanchao","paragraph_id":"c-shiji-101-yuanchao:p012","quote":"吳楚反，聞，鼂錯謂丞史曰：「夫袁盎多受吳王金錢，專為蔽匿，言不反。今果反，欲請治盎宜知計謀。」丞史曰：「事未發，治之有絕。今兵西鄉，治之何益！且袁盎不宜有謀。」鼂錯猶與未決。人有告袁盎者，袁盎恐，夜見竇嬰，為言吳所以反者，願至上前口對狀。竇嬰入言上，上乃召袁盎入見。鼂錯在前，及盎請辟人賜閒，錯去，固恨甚。袁盎具言吳所以反狀，以錯故，獨急斬錯以謝吳，吳兵乃可罷。其語具在吳事中。使袁盎為太常，竇嬰為大將軍。兩人素相與善。逮吳反。諸陵長者長安中賢大夫爭附兩人，車隨者日數百乘。"},{"chapter_id":"c-shiji-011-jingdi","source_id":"s-shiji-011-jingdi","paragraph_id":"c-shiji-011-jingdi:p004","quote":"三年正月乙巳，赦天下。長星出西方。天火燔雒陽東宮大殿城室。吳王濞、楚王戊、趙王遂、膠西王卬、濟南王辟光、菑川王賢、膠東王雄渠反，發兵西鄉。天子為誅晁錯，遣袁盎諭告，不止，遂西圍梁。上乃遣大將軍竇嬰、太尉周亞夫將兵誅之。六月乙亥。赦亡軍及楚元王子藝等與謀反者。封大將軍竇嬰為魏其侯。立楚元王子平陸侯禮為楚王。立皇子端為膠西王，子勝為中山王。徙濟北王志為菑川王，淮陽王餘為魯王，汝南王非為江都王。齊王將廬、燕王嘉皆薨。"}],"references":[{"title":"漢初月朔考索──以出土簡牘為線索","author":"許名瑲","publication":"北市大語文學報","issue":12,"published_on":"2014-12","page":"120","url":"https://literacy.utaipei.edu.tw/var/file/65/1065/img/1007/256705145.pdf#page=124","quote":"景帝三年（前154年）","scope":"regnal_year_to_common_era_year_only","image_verified":false,"note":"已核讀期刊PDF文字之題名、作者、刊期與頁120年對照；未採本文月日改讀，也未稱本庫古籍影像已覆核。"}],"rationale":"本篇吳楚反及平定後授官與〈孝景本紀〉三年七國之亂及平陸侯禮立楚王互證；年對照採許名瑲頁120。公元前154年按天文年記作-153；不推月日或完整任期。","reviewer":"Codex（AI 代理）","human_reviewed":false,"record_id":"th-shiji101-027","person_id":"2uk_ay7_hjf","endpoint":"start","title":"大將軍"}],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji101-023","person_id":"2uk_ay7_hjf","surfaces":["竇嬰"],"scope":"same_chapter","chapter_ids":["c-shiji-101-yuanchao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-101-yuanchao:p012","quote":"吳楚反，聞，鼂錯謂丞史曰：「夫袁盎多受吳王金錢，專為蔽匿，言不反。今果反，欲請治盎宜知計謀。」丞史曰：「事未發，治之有絕。今兵西鄉，治之何益！且袁盎不宜有謀。」鼂錯猶與未決。人有告袁盎者，袁盎恐，夜見竇嬰，為言吳所以反者，願至上前口對狀。竇嬰入言上，上乃召袁盎入見。鼂錯在前，及盎請辟人賜閒，錯去，固恨甚。袁盎具言吳所以反狀，以錯故，獨急斬錯以謝吳，吳兵乃可罷。其語具在吳事中。使袁盎為太常，竇嬰為大將軍。兩人素相與善。逮吳反。諸陵長者長安中賢大夫爭附兩人，車隨者日數百乘。"},{"paragraph_id":"c-shiji-101-yuanchao:p019","quote":"遷為御史大夫，請諸侯之罪過，削其地，收其枝郡。奏上，上令公卿列侯宗室集議，莫敢難，獨竇嬰爭之，由此與錯有卻。錯所更令三十章，諸侯皆諠譁疾鼂錯。錯父聞之，從潁川來，謂錯曰：「上初即位，公為政用事，侵削諸侯，別疏人骨肉，人口議多怨公者，何也？」鼂錯曰：「固也。不如此，天子不尊，宗廟不安。」錯父曰：「劉氏安矣，而鼂氏危矣，吾去公歸矣！」遂飲藥死，曰：「吾不忍見禍及吾身。」死十餘日，吳楚七國果反，以誅錯為名。及竇嬰、袁盎進說，上令鼂錯衣朝衣斬東市。"}],"rationale":"按本傳明示姓名、字及敘事承接；皇帝上字逐處依文景敘事核定，建元上另留未名。兄噲不合樊噲，兄子種不補具名父親。身份及官稱回指為代理首輪判讀，非人工覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji101-dou","person_ids":["2uk_ay7_hjf","nvf_r2k_j9y"],"canonical_person_id":"nvf_r2k_j9y","scope":"cross_chapter","chapter_ids":["c-shiji-011-jingdi","c-shiji-101-yuanchao"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-101-yuanchao","source_id":"s-shiji-101-yuanchao","paragraph_id":"c-shiji-101-yuanchao:p012","quote":"吳楚反，聞，鼂錯謂丞史曰：「夫袁盎多受吳王金錢，專為蔽匿，言不反。今果反，欲請治盎宜知計謀。」丞史曰：「事未發，治之有絕。今兵西鄉，治之何益！且袁盎不宜有謀。」鼂錯猶與未決。人有告袁盎者，袁盎恐，夜見竇嬰，為言吳所以反者，願至上前口對狀。竇嬰入言上，上乃召袁盎入見。鼂錯在前，及盎請辟人賜閒，錯去，固恨甚。袁盎具言吳所以反狀，以錯故，獨急斬錯以謝吳，吳兵乃可罷。其語具在吳事中。使袁盎為太常，竇嬰為大將軍。兩人素相與善。逮吳反。諸陵長者長安中賢大夫爭附兩人，車隨者日數百乘。","mention_ids":["c-shiji-101-yuanchao:m012-0100","c-shiji-101-yuanchao:m012-0119","c-shiji-101-yuanchao:m012-0196"]},{"chapter_id":"c-shiji-011-jingdi","source_id":"s-shiji-011-jingdi","paragraph_id":"c-shiji-011-jingdi:p004","quote":"三年正月乙巳，赦天下。長星出西方。天火燔雒陽東宮大殿城室。吳王濞、楚王戊、趙王遂、膠西王卬、濟南王辟光、菑川王賢、膠東王雄渠反，發兵西鄉。天子為誅晁錯，遣袁盎諭告，不止，遂西圍梁。上乃遣大將軍竇嬰、太尉周亞夫將兵誅之。六月乙亥。赦亡軍及楚元王子藝等與謀反者。封大將軍竇嬰為魏其侯。立楚元王子平陸侯禮為楚王。立皇子端為膠西王，子勝為中山王。徙濟北王志為菑川王，淮陽王餘為魯王，汝南王非為江都王。齊王將廬、燕王嘉皆薨。","mention_ids":["c-shiji-011-jingdi:m004-0096","c-shiji-011-jingdi:m004-0133"]}],"rationale":"兩篇七國之亂敘事同記竇嬰為大將軍；結合相同事件與官稱，不只依姓名。 來源ID、原始候選與所有引句保留；為可修訂代理判讀，非人工覆核。","reviewer":"Codex（AI 代理）"}],"passages":[{"id":"c-shiji-011-jingdi:p004","text":"三年正月乙巳，赦天下。長星出西方。天火燔雒陽東宮大殿城室。吳王濞、楚王戊、趙王遂、膠西王卬、濟南王辟光、菑川王賢、膠東王雄渠反，發兵西鄉。天子為誅晁錯，遣袁盎諭告，不止，遂西圍梁。上乃遣大將軍竇嬰、太尉周亞夫將兵誅之。六月乙亥。赦亡軍及楚元王子藝等與謀反者。封大將軍竇嬰為魏其侯。立楚元王子平陸侯禮為楚王。立皇子端為膠西王，子勝為中山王。徙濟北王志為菑川王，淮陽王餘為魯王，汝南王非為江都王。齊王將廬、燕王嘉皆薨。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-011-jingdi:m004-0029","start":29,"end":32,"surface":"吳王濞","kind":"person","person_id":"tpx_x74_xhk","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0033","start":33,"end":36,"surface":"楚王戊","kind":"person","person_id":"5jd_t02_cdy","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0037","start":37,"end":40,"surface":"趙王遂","kind":"person","person_id":"yqp_nlb_p1p_AEA","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0041","start":41,"end":45,"surface":"膠西王卬","kind":"person","person_id":"naf_4g1_vmz","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0046","start":46,"end":51,"surface":"濟南王辟光","kind":"person","person_id":"sym_fqo_4zf","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0052","start":52,"end":56,"surface":"菑川王賢","kind":"person","person_id":"vrf_8lm_g7h","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0057","start":57,"end":62,"surface":"膠東王雄渠","kind":"person","person_id":"tc7_le7_5xb","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0069","start":69,"end":71,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACA","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0073","start":73,"end":75,"surface":"晁錯","kind":"person","person_id":"f0u_lxn_ztw","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0077","start":77,"end":79,"surface":"袁盎","kind":"person","person_id":"ibu_a0b_ggu","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0090","start":90,"end":91,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_ACA","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0096","star