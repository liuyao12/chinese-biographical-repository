face":"燕王嘉","kind":"person","person_id":"u2w_08q_du4","status":"contextual_provisional"}],"chapter_id":"c-shiji-011-jingdi","book_id":"b-shiji-011","work_id":"w-shiji","source_id":"s-shiji-011-jingdi"},{"id":"c-shiji-101-yuanchao:p012","text":"吳楚反，聞，鼂錯謂丞史曰：「夫袁盎多受吳王金錢，專為蔽匿，言不反。今果反，欲請治盎宜知計謀。」丞史曰：「事未發，治之有絕。今兵西鄉，治之何益！且袁盎不宜有謀。」鼂錯猶與未決。人有告袁盎者，袁盎恐，夜見竇嬰，為言吳所以反者，願至上前口對狀。竇嬰入言上，上乃召袁盎入見。鼂錯在前，及盎請辟人賜閒，錯去，固恨甚。袁盎具言吳所以反狀，以錯故，獨急斬錯以謝吳，吳兵乃可罷。其語具在吳事中。使袁盎為太常，竇嬰為大將軍。兩人素相與善。逮吳反。諸陵長者長安中賢大夫爭附兩人，車隨者日數百乘。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-101-yuanchao:m012-0006","start":6,"end":8,"surface":"鼂錯","kind":"person","person_id":"04u_gq0_nke_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m012-0009","start":9,"end":11,"surface":"丞史","kind":"person","person_id":"n1j_kbh_u02","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m012-0015","start":15,"end":17,"surface":"袁盎","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m012-0019","start":19,"end":21,"surface":"吳王","kind":"person","person_id":"7l9_yz7_nwv","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m012-0040","start":40,"end":41,"surface":"盎","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m012-0047","start":47,"end":49,"surface":"丞史","kind":"person","person_id":"n1j_kbh_u02","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m012-0072","start":72,"end":74,"surface":"袁盎","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m012-0080","start":80,"end":82,"surface":"鼂錯","kind":"person","person_id":"04u_gq0_nke_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m012-0090","start":90,"end":92,"surface":"袁盎","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m012-0094","start":94,"end":96,"surface":"袁盎","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m012-0100","start":100,"end":102,"surface":"竇嬰","kind":"person","person_id":"2uk_ay7_hjf","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m012-0119","start":119,"end":121,"surface":"竇嬰","kind":"person","person_id":"2uk_ay7_hjf","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m012-0125","start":125,"end":126,"surface":"上","kind":"person","person_id":"etc_iw9_5so","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m012-0128","start":128,"end":130,"surface":"袁盎","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m012-0133","start":133,"end":135,"surface":"鼂錯","kind":"person","person_id":"04u_gq0_nke_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m012-0139","start":139,"end":140,"surface":"盎","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m012-0146","start":146,"end":147,"surface":"錯","kind":"person","person_id":"04u_gq0_nke_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m012-0153","start":153,"end":155,"surface":"袁盎","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m012-0164","start":164,"end":165,"surface":"錯","kind":"person","person_id":"04u_gq0_nke_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m012-0170","start":170,"end":171,"surface":"錯","kind":"person","person_id":"04u_gq0_nke_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m012-0190","start":190,"end":192,"surface":"袁盎","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m012-0196","start":196,"end":198,"surface":"竇嬰","kind":"person","person_id":"2uk_ay7_hjf","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m012-0214","start":214,"end":224,"surface":"諸陵長者長安中賢大夫","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、學說合稱、典故或待辨匿名指代，未補成員及姓名。"}],"chapter_id":"c-shiji-101-yuanchao","book_id":"b-shiji-101","work_id":"w-shiji","source_id":"s-shiji-101-yuanchao"},{"id":"c-shiji-101-yuanchao:p019","text":"遷為御史大夫，請諸侯之罪過，削其地，收其枝郡。奏上，上令公卿列侯宗室集議，莫敢難，獨竇嬰爭之，由此與錯有卻。錯所更令三十章，諸侯皆諠譁疾鼂錯。錯父聞之，從潁川來，謂錯曰：「上初即位，公為政用事，侵削諸侯，別疏人骨肉，人口議多怨公者，何也？」鼂錯曰：「固也。不如此，天子不尊，宗廟不安。」錯父曰：「劉氏安矣，而鼂氏危矣，吾去公歸矣！」遂飲藥死，曰：「吾不忍見禍及吾身。」死十餘日，吳楚七國果反，以誅錯為名。及竇嬰、袁盎進說，上令鼂錯衣朝衣斬東市。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-101-yuanchao:m019-0026","start":26,"end":27,"surface":"上","kind":"person","person_id":"etc_iw9_5so","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m019-0028","start":28,"end":34,"surface":"公卿列侯宗室","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、學說合稱、典故或待辨匿名指代，未補成員及姓名。"},{"id":"c-shiji-101-yuanchao:m019-0042","start":42,"end":44,"surface":"竇嬰","kind":"person","person_id":"2uk_ay7_hjf","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m019-0050","start":50,"end":51,"surface":"錯","kind":"person","person_id":"04u_gq0_nke_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m019-0054","start":54,"end":55,"surface":"錯","kind":"person","person_id":"04u_gq0_nke_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m019-0068","start":68,"end":70,"surface":"鼂錯","kind":"person","person_id":"04u_gq0_nke_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m019-0071","start":71,"end":72,"surface":"錯","kind":"person","person_id":"04u_gq0_nke_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m019-0072","start":72,"end":73,"surface":"父","kind":"person","person_id":"04u_gq0_nke","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m019-0082","start":82,"end":83,"surface":"錯","kind":"person","person_id":"04u_gq0_nke_A","status":"contextual_provisional"},{"id":"c-shiji-10