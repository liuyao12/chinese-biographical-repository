-058-liang:p013","c-shiji-058-liang:p015","c-shiji-058-liang:p016"],"passage_count":3}],"most_mentioned_source_ids":["s-shiji-058-liang"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji058-010","subject_person_id":"82d_8vl_8i1_AA","predicate":"father","object_person_id":"82d_8vl_8i1_A","status":"source_attested","evidence":[{"chapter_id":"c-shiji-058-liang","source_id":"s-shiji-058-liang","paragraph_id":"c-shiji-058-liang:p013","quote":"梁孝王長子買為梁王，是為共王；子明為濟川王；子彭離為濟東王；子定為山陽王；子不識為濟陰王。"}],"qualifiers":{"source_term":"梁孝王長子買","historicity":"historical_tradition"},"interpretation_note":"依明示子、母、同母兄弟及王后保存，繼位本身不補父子，未名子女不補姓名。梁武與景帝同母有明文，其餘關係不推同父同母。褚先生所舉成王故事依附述分層，不當獨立見證。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji058-015","subject_person_id":"82d_8vl_8i1_AAA","predicate":"father","object_person_id":"82d_8vl_8i1_AA","status":"source_attested","evidence":[{"chapter_id":"c-shiji-058-liang","source_id":"s-shiji-058-liang","paragraph_id":"c-shiji-058-liang:p015","quote":"梁共王三年，景帝崩。共王立七年卒，子襄立，是為平王。"}],"qualifiers":{"source_term":"子襄立","historicity":"historical_tradition"},"interpretation_note":"依明示子、母、同母兄弟及王后保存，繼位本身不補父子，未名子女不補姓名。梁武與景帝同母有明文，其餘關係不推同父同母。褚先生所舉成王故事依附述分層，不當獨立見證。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji058-017","subject_person_id":"82d_8vl_8i1_AA","predicate":"mother","object_person_id":"ja1_60d_r62","status":"source_attested","evidence":[{"chapter_id":"c-shiji-058-liang","source_id":"s-shiji-058-liang","paragraph_id":"c-shiji-058-liang:p016","quote":"梁平王襄十四年，母曰陳太后。共王母曰李太后。李太后，親平王之大母也。而平王之后姓任，曰任王后。任王后甚有寵於平王襄。初，孝王在時，有罍樽，直千金。孝王誡後世，善保罍樽，無得以與人。任王后聞而欲得罍樽。平王大母李太后曰：「先王有命，無得以罍樽與人。他物雖百巨萬，猶自恣也。」任王后絕欲得之。平王襄直使人開府取罍樽，賜任王后。李太后大怒，漢使者來，欲自言，平王襄及任王后遮止，閉門，李太后與爭門，措指，遂不得見漢使者。李太后亦私與食官長及郎中尹霸等士通亂，而王與任王后以此使人風止李太后，李太后內有淫行，亦已。後病薨。病時，任后未嘗請病；薨，又不持喪。"}],"qualifiers":{"source_term":"共王母曰李太后","historicity":"historical_tradition"},"interpretation_note":"依明示子、母、同母兄弟及王后保存，繼位本身不補父子，未名子女不補姓名。梁武與景帝同母有明文，其餘關係不推同父同母。褚先生所舉成王故事依附述分層，不當獨立見證。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[{"connection":"father","generation_distance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-058-liang","source_id":"s-shiji-058-liang","paragraph_id":"c-shiji-058-liang:p013","quote":"梁孝王長子買為梁王，是為共王；子明為濟川王；子彭離為濟東王；子定為山陽王；子不識為濟陰王。","source_term":"梁孝王長子買"}],"source_assertion_id":"a-shiji058-010","interpretation_note":"以此受傳正文的明示近親主張配置局部家族；不合併跨篇候選身份、不補闕名世代，不表示遠祖世系已核實。分支字元不是長幼排行。","reviewer":"Codex（AI 代理）","parent_person_id":"82d_8vl_8i1_A","person_id":"82d_8vl_8i1_AA"}],"mentions":[{"id":"c-shiji-058-liang:m013-0005","start":5,"end":6,"surface":"買","kind":"person","person_id":"82d_8vl_8i1_AA","status":"contextual_provisional","paragraph_id":"c-shiji-058-liang:p013","chapter_id":"c-shiji-058-liang"},{"id":"c-shiji-058-liang:m013-0007","start":7,"end":9,"surface":"梁王","kind":"person","person_id":"82d_8vl_8i1_AA","status":"contextual_provisional","paragraph_id":"c-shiji-058-liang:p013","chapter_id":"c-shiji-058-liang"},{"id":"c-shiji-058-liang:m013-0012","start":12,"end":14,"surface":"共王","kind":"person","person_id":"82d_8vl_8i1_AA","status":"contextual_provisional","paragraph_id":"c-shiji-058-liang:p013","chapter_id":"c-shiji-058-liang"},{"id":"c-shiji-058-liang:m015-0000","start":0,"end":3,"surface":"梁共王","kind":"person","person_id":"82d_8vl_8i1_AA","status":"contextual_provisional","paragraph_id":"c-shiji-058-liang:p015","chapter_id":"c-shiji-058-liang"},{"id":"c-shiji-058-liang:m015-0010","start":10,"end":12,"surface":"共王","kind":"person","person_id":"82d_8vl_8i1_AA","status":"contextual_provisional","paragraph_id":"c-shiji-058-liang:p015","chapter_id":"c-shiji-058