ved_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-nanqishu-042-jiangshi-near-family-rendered:p002:m0001","start":0,"end":2,"surface":"高宗","kind":"person","person_id":"z5d_9zy_u5h_B","status":"contextual_provisional"},{"id":"c-nanqishu-042-jiangshi-near-family-rendered:p002:m0002","start":28,"end":30,"surface":"高宗","kind":"person","person_id":"z5d_9zy_u5h_B","status":"contextual_provisional"},{"id":"c-nanqishu-042-jiangshi-near-family-rendered:p002:m0003","start":39,"end":40,"surface":"祏","kind":"person","person_id":"qfs_t8x_ez4_AA","status":"contextual_provisional"},{"id":"c-nanqishu-042-jiangshi-near-family-rendered:p002:m0004","start":54,"end":56,"surface":"蕭誄","kind":"person","person_id":"5c7_6at_22b_AB","status":"contextual_provisional"},{"id":"c-nanqishu-042-jiangshi-near-family-rendered:p002:m0005","start":66,"end":68,"surface":"海陵","kind":"person","person_id":"79g_3gx_htk","status":"contextual_provisional"},{"id":"c-nanqishu-042-jiangshi-near-family-rendered:p002:m0006","start":74,"end":76,"surface":"高宗","kind":"person","person_id":"z5d_9zy_u5h_B","status":"contextual_provisional"},{"id":"c-nanqishu-042-jiangshi-near-family-rendered:p002:m0007","start":77,"end":78,"surface":"上","kind":"person","person_id":"z5d_9zy_u5h_B","status":"contextual_provisional"},{"id":"c-nanqishu-042-jiangshi-near-family-rendered:p002:m0008","start":87,"end":88,"surface":"祏","kind":"person","person_id":"qfs_t8x_ez4_AA","status":"contextual_provisional"},{"id":"c-nanqishu-042-jiangshi-near-family-rendered:p002:m0009","start":89,"end":90,"surface":"帝","kind":"person","person_id":"z5d_9zy_u5h_B","status":"contextual_provisional"},{"id":"c-nanqishu-042-jiangshi-near-family-rendered:p002:m0010","start":99,"end":102,"surface":"王洪範","kind":"person","person_id":"u2n_m70_qgh","status":"contextual_provisional"},{"id":"c-nanqishu-042-jiangshi-near-family-rendered:p002:m0011","start":106,"end":107,"surface":"上","kind":"person","person_id":"z5d_9zy_u5h_B","status"