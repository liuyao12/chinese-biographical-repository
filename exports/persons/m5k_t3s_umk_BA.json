"human_reviewed":false}],"title_holdings":[{"id":"th-liangshu-043-liujingli-2-209","title":"建安侯","kind":"noble_rank","mode":"attestation","person_id":"m5k_t3s_umk_BA","attestations":[{"id":"th-liangshu-043-liujingli-2-209:a","paragraph_id":"c-liangshu-043-liujingli:p002","start":209,"end":212,"surface":"建安侯","person_mention_id":"c-liangshu-043-liujingli:p002:m0212","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-043","chapter_id":"c-liangshu-043-liujingli","source_id":"s-liangshu-043-liujingli-ws2087360","paragraph_id":"c-liangshu-043-liujingli:p002","quote":"敬禮與兄仲禮，皆少以勇烈知名。起家著作佐郎，稍遷扶風太守。侯景渡江，敬禮率馬步三千赴援。至都，據青溪埭，與景頻戰，恒先登陷陳，甚著威名。台城沒，敬禮與仲禮俱見於景，景遣仲禮經略上流，留敬禮爲質，以爲護軍。景餞仲禮於後渚，敬禮密謂仲禮曰：「景今來會，敬禮抱之，兄拔佩刀，便可斫殺，敬禮死亦無所恨。」仲禮壯其言，許之。及酒數行，敬禮目仲禮，仲禮見備衛嚴，不敢動，計遂不果。會景征晉熙，敬禮與南康王會理共謀襲其城，剋期將發，建安侯蕭賁知而告之，遂遇害。","person_mention_id":"c-liangshu-043-liujingli:p002:m0212"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-022-xiaohong-sons-jingli:p003","text":"高祖嘉而許之，改封正立爲建安侯，邑千戶。卒，子賁嗣。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":22,"last_line":22,"raw_start":1496,"raw_end":1522,"raw_character_offsets":[1496,1497,1498,1499,1500,1501,1502,1503,1504,1505,1506,1507,1508,1509,1510,1511,1512,1513,1514,1515,1516,1517,1518,1519,1520,1521],"revision_id":1513347},"mentions":[{"id":"c-liangshu-022-xiaohong-sons-jingli:p003:m0009","start":9,"end":11,"surface":"正立","kind":"person","person_id":"m5k_t3s_umk_B","status":"contextual_provisional"},{"id":"c-liangshu-022-xi