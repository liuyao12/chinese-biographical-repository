isional","evidence":[{"paragraph_id":"c-shiji-046-tian:p014","quote":"簡公出奔，田氏之徒追執簡公于徐州。簡公曰：「蚤從御鞅之言，不及此難。」田氏之徒恐簡公復立而誅己，遂殺簡公。簡公立四年而殺。於是田常立簡公弟驁，是爲平公。平公卽位，田常爲相。"},{"paragraph_id":"c-shiji-046-tian:p016","quote":"田常言於齊平公曰：「德施人之所欲，君其行之；刑罰人之所惡，臣請行之。」行之五年，齊國之政皆歸田常。田常於是盡誅鮑、晏、監止及公族之彊者，而割齊自安平以東至瑯邪，自爲封邑。封邑大於平公之所食。"}],"rationale":"限本篇明示姓名、是為、繼位及局部事件暫接；姜齊與田齊桓公、不同時段未名王及同字忌分開。孫子不先補孫臏，子守髙唐不補闕字，索隱短稱與代詞仍待核；未跨篇按同名接人。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-046-tian:p014","text":"簡公出奔，田氏之徒追執簡公于徐州。簡公曰：「蚤從御鞅之言，不及此難。」田氏之徒恐簡公復立而誅己，遂殺簡公。簡公立四年而殺。於是田常立簡公弟驁，是爲平公。平公卽位，田常爲相。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-046-tian:m014-0000","start":0,"end":2,"surface":"簡公","kind":"person","person_id":"yht_8tu_hv4_BA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m014-0011","start":11,"end":13,"surface":"簡公","kind":"person","person_id":"yht_8tu_hv4_BA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m014-0017","start":17,"end":19,"surface":"簡公","kind":"person","person_id":"yht_8tu_hv4_BA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m014-0024","start":24,"end":26,"surface":"御鞅","kind":"person","person_id":"rwc_uls_sr7","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m014-0040","start":40,"end":42,"surface":"簡公","kind":"person","person_id":"yht_8tu_hv4_BA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m014-0050","start":50,"end":52,"surface":"簡公","kind":"person","person_id":"yht_8tu_hv4_BA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m014-0053","start":53,"end":55,"surface":"簡公","kind":"person","person_id":"yht_8tu_hv4_BA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m014-0063","start":63,"end":65,"surface":"田常","kind":"person","person_id":"zan_qcc_jy5_AAAAAABA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m014-0066","start":66,"end":68,"surface":"簡公","kind":"person","person_id":"yht_8tu_hv4_B