rved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-059-jiong:p014:m0154","start":48,"end":50,"surface":"王湖","kind":"person","person_id":"9h5_5ob_ufs","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。","paragraph_id":"c-jinshu-059-jiong:p014","chapter_id":"c-jinshu-059-jiong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-059-jiong:p014","text":"長沙王乂徑入宮，發兵攻冏府。冏遣董艾陳兵宮西。乂又遣宋洪等放火燒諸觀閣及千秋、神武門。冏令黃門令王湖悉盜騶虞幡，唱云：「長沙王矯詔。」乂又稱：「大司馬謀反，助者誅五族。」是夕，城內大戰，飛矢雨集，火光屬天。帝幸上東門，矢集御前。群臣救火，死者相枕。明日，冏敗，乂擒冏至殿前，帝惻然，欲活之。乂叱左右促牽出，冏猶再顧，遂斬於閶闔門外，徇首六軍。諸黨屬皆夷三族。幽其子淮陵王超、樂安王冰、濟陽王英于金墉。暴冏屍於西明亭，三日而莫敢收斂。冏故掾屬荀闓等表乞殯葬，許之。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-059-jiong:p014:m0147","start":0,"end":4,"surface":"長沙王乂","kind":"person","person_id":"4c6_984_9ed","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p014:m0148","start":11,"end":12,"surface":"冏","kind":"person","person_id":"ee0_b2a_68e","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p014:m0149","start":14,"end":15,"surface":"冏","kind":"person","person_id":"ee0_b2a_68e","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p014:m0150","start":16,"end":18,"surface":"董艾","kind":"person","person_id":"nb1_pou_zx4","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p014:m0151","start":23,"end":24,"surface":"乂","kind":"person","person_id":"4c6_984_9ed","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p014:m0