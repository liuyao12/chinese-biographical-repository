{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p005337","identity_policy":"contextual_provisional","person_ids":["cbr-p005337"],"persons":[{"id":"cbr-p005337","label":"龍且（樊酈滕灌列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"龍且","mention_ids":["c-shiji-095-fankuang:m023-0072","c-shiji-095-fankuang:m025-0127","c-shiji-095-fankuang:m025-0139"]}],"evidence":[{"mention_id":"c-shiji-095-fankuang:m023-0072","chapter_id":"c-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p023","quote":"龍且"},{"mention_id":"c-shiji-095-fankuang:m025-0127","chapter_id":"c-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p025","quote":"龍且"},{"mention_id":"c-shiji-095-fankuang:m025-0139","chapter_id":"c-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p025","quote":"龍且"}]}],"mentions":[{"id":"c-shiji-095-fankuang:m023-0072","start":72,"end":74,"surface":"龍且","kind":"person","person_id":"cbr-p005337","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p023","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:m025-0127","start":127,"end":129,"surface":"龍且","kind":"person","person_id":"cbr-p005337","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p025","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:m025-0139","start":139,"end":141,"surface":"龍且","kind":"person","person_id":"cbr-p005337","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p025","chapter_id":"c-shiji-095-fankuang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji095-087","person_id":"cbr-p005337","scope":"same_chapter","chapter_ids":["c-shiji-095-fankuang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["龍且"],"evidence":[{"paragraph_id":"c-shiji-095-fankuang:p023","quote":"沛公立為漢王，拜嬰為郎中，從入漢中，十月，拜為中謁者。從還定三秦，下櫟陽，降塞王。還圍章邯於廢丘，未拔。從東出臨晉關，擊降殷王，定其地。擊項羽將龍且、魏相項他軍定陶南，疾戰，破之。賜嬰爵列侯，號昌文侯，食杜平鄉。"},{"paragraph_id":"c-shiji-095-fankuang:p025","quote":"三年，以列侯食邑杜平鄉。以御史大夫受詔將郎中騎兵東屬相國韓信，擊破齊軍於歷下，所將卒虜車騎將軍華毋傷及將吏四十六人。降下臨菑，得齊守相田光。追齊相田橫至嬴、博，破其騎，所將卒斬騎將一人，生得騎將四人。攻下嬴、博，破齊將軍田吸於千乘，所將卒斬吸。東從韓信攻龍且、留公旋於高密，卒斬龍且，生得右司馬、連尹各一人，樓煩將十人，身生得亞將周蘭。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定異稱。酈寄字況據第14段；夏侯嬰的嬰限定第16至21段，灌嬰限定第22至33段，桓嬰另人。第6與20、28段楚王信和反韓王信分人；未詳名王侯不補名。同名跨篇同指另待逐項證據。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-095-fankuang:p023","text":"沛公立為漢王，拜嬰為郎中，從入漢中，十月，拜為中謁者。從還定三秦，下櫟陽，降塞王。還圍章邯於廢丘，未拔。從東出臨晉關，擊降殷王，定其地。擊項羽將龍且、魏相項他軍定陶南，疾戰，破之。賜嬰爵列侯，號昌文侯，食杜平鄉。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m023-0000","start":0,"end":2,"surface":"沛公","kind":"person","person_id":"cbr-p005253","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m023-0004","start":4,"end":6,"surface":"漢王","kind":"person","person_id":"cbr-p005253","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m023-0008","start":8,"end":9,"surface":"嬰","kind":"person","person_id":"cbr-p005296","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m023-0038","start":38,"end":40,"surface":"塞王","kind":"person","person_id":"cbr-p005335","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m023-0043","start":43,"end":45,"surface":"章邯","kind":"person","person_id":"cbr-p005254","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m023-0061","start":61,"end":63,"surface":"殷王","kind":"person","person_id":"cbr-p005336","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m023-0069","start":69,"end":71,"surface":"項羽","kind":"person","person_id":"cbr-p005258","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m023-0072","start":72,"end":74,"surface":"龍且","kind":"person","person_id":"cbr-p005337","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m023-0077","start":77,"end":79,"surface":"項他","kind":"person","person_id":"cbr-p005338","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m023-0091","start":91,"end":92,"surface":"嬰","kind":"person","person_id":"cbr-p005296","status":"contextual_provisional"}],"chapter_id":"c-shiji-095-fankuang","book_id":"b-shiji-095","work_id":"w-shiji","source_id":"s-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:p025","text":"三年，以列侯食邑杜平鄉。以御史大夫受詔將郎中騎兵東屬相國韓信，擊破齊軍於歷下，所將卒虜車騎將軍華毋傷及將吏四十六人。降下臨菑，得齊守相田光。追齊相田橫至嬴、博，破其騎，所將卒斬騎將一人，生得騎將四人。攻下嬴、博，破齊將軍田吸於千乘，所將卒斬吸。東從韓信攻龍且、留公旋於高密，卒斬龍且，生得右司馬、連尹各一人，樓煩將十人，身生得亞將周蘭。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m025-0028","start":28,"end":30,"surface":"韓信","kind":"person","person_id":"cbr-p005264","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m025-0047","start":47,"end":50,"surface":"華毋傷","kind":"person","person_id":"cbr-p005329","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m025-0067","start":67,"end":69,"surface":"田光","kind":"person","person_id":"cbr-p005343","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m025-0073","start":73,"end":75,"surface":"田橫","kind":"person","person_id":"cbr-p005344","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m025-0110","start":110,"end":112,"surface":"田吸","kind":"person","person_id":"cbr-p005345","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m025-0120","start":120,"end":121,"surface":"吸","kind":"person","person_id":"cbr-p005345","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m025-0124","start":124,"end":126,"surface":"韓信","kind":"person","person_id":"cbr-p005264","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m025-0127","start":127,"end":129,"surface":"龍且","kind":"person","person_id":"cbr-p005337","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m025-0130","start":130,"end":133,"surface":"留公旋","kind":"person","person_id":"cbr-p005330","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m025-0139","start":139,"end":141,"surface":"龍且","kind":"person","person_id":"cbr-p005337","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m025-0165","start":165,"end":167,"surface":"周蘭","kind":"person","person_id":"cbr-p005346","status":"contextual_provisional"}],"chapter_id":"c-shiji-095-fankuang","book_id":"b-shiji-095","work_id":"w-shiji","source_id":"s-shiji-095-fankuang"}],"sources":[{"chapter_id":"c-shiji-095-fankuang","work_id":"w-shiji","book_id":"b-shiji-095","source_id":"s-shiji-095-fankuang","source":{"title":"史記／卷095","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷095","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷095&oldid=2298709","revision_id":2298709,"accessed_on":"2026-10-09","extent":"34段傳世正文含太史公論，另附1段分層索隱述贊；排除導覽與空白。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"固定HTML一致，只去外緣空白；樊噌、（肩）［屏］、（博）［傅］、（太卜）太仆、穎陰等原字保留。","note":"全37個HTML區塊已讀，未核底本影像。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical"}}
