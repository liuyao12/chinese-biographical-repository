ly_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-109-liguang:m015-0130","start":130,"end":133,"surface":"左賢王","kind":"person","person_id":"am3_2pu_fzr","status":"contextual_provisional","paragraph_id":"c-shiji-109-liguang:p015","chapter_id":"c-shiji-109-liguang"},{"id":"c-shiji-109-liguang:m015-0138","start":138,"end":141,"surface":"左賢王","kind":"person","person_id":"am3_2pu_fzr","status":"contextual_provisional","paragraph_id":"c-shiji-109-liguang:p015","chapter_id":"c-shiji-109-liguang"},{"id":"c-shiji-110-xiongnu:m040-0014","start":14,"end":17,"surface":"左賢王","kind":"person","person_id":"am3_2pu_fzr","status":"contextual_provisional","paragraph_id":"c-shiji-110-xiongnu:p040","chapter_id":"c-shiji-110-xiongnu"},{"id":"c-shiji-110-xiongnu:m040-0032","start":32,"end":35,"surface":"左賢王","kind":"person","person_id":"am3_2pu_fzr","status":"contextual_provisional","paragraph_id":"c-shiji-110-xiongnu:p040","chapter_id":"c-shiji-110-xiongnu"}],"relations":[],"title_holdings":[{"id":"th-shiji109-092","person_id":"am3_2pu_fzr","title":"左賢王","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-109-liguang","source_id":"s-shiji-109-liguang","paragraph_id":"c-shiji-109-liguang:p015","quote":"廣子三人，曰當戸、椒、敢，爲郎。天子與韓嫣戲，嫣少不遜，當戸擊嫣，嫣走。於是天子以爲勇。當戸早死，拜椒爲代郡太守，皆先廣死。當戸有遺腹子名陵。廣死軍時，敢從驃騎將軍。廣死明年，李蔡以丞相坐侵孝景園壖地，當下吏治，蔡亦自殺，不對獄，國除。李敢以校尉從驃騎將軍擊胡左賢王，力戰，奪左賢王鼓旗，斬首多，賜爵關內侯，食邑二百戸，代廣爲郎中令。頃之，怨大將軍青之恨其父，乃擊傷大將軍，大將軍匿諱之。居無何，敢從上雍，至甘泉宮獵。驃騎將軍去病與青有親，射殺敢。去病時方貴幸，上諱云鹿觸殺之。居歳餘，去病死。而敢有女爲太子中人，愛幸，敢男禹有寵於太子，然好利，李氏陵遲衰微矣。"}],"attestations":[{"id":"th-shiji109-092:a001","paragraph_id":"c-shiji-109-liguang:p015","start":130,"end":133,"surface":"左賢王","person_mention_id":"c-shiji-109-liguang:m015-0130","usage":"narrative"},{"id":"th-shiji109-092:a002","paragraph_id":"c-shiji-109-liguang:p015","start":138,"end":141,"surface":"左賢王","person_mention_id":"c-shiji-109-liguang:m015-0138","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"兩處左賢王依李敢同次作戰敘事暫連一名未名候選；不按官號合併第10段左賢王，也不由鼓旗被奪推定死亡、廢爵或官爵終點。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji110-113","person_id":"am3_2pu_fzr","title":"左賢王","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-110-xiongnu","source_id":"s-shiji110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p040","quote":"漢驃騎將軍之出代二千餘里，與左賢王接戰，漢兵得胡首虜凡七萬餘級，左賢王將皆遁走。驃騎封於狼居胥山，禪姑衍，臨翰海而還。"}],"attestations":[{"id":"th-shiji110-113:a001","paragraph_id":"c-shiji-110-xiongnu:p040","start":14,"end":17,"surface":"左賢王","person_mention_id":"c-shiji-110-xiongnu:m040-0014","usage":"narrative","normalized_date":{"era":"BCE","era_year":119,"year":-118,"year_numbering":"astronomical","precision":"year","status":"editorial_provisional","original_quote":"漢驃騎將軍之出代二千餘里，與左賢王接戰，漢兵得胡首虜凡七萬餘級，左賢王將皆遁走。驃騎封於狼居胥山，禪姑衍，臨翰海而還。","evidence":[{"chapter_id":"c-shiji-110-xiongnu","source_id":"s-shiji110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p040","quote":"漢驃騎將軍之出代二千餘里，與左賢王接戰，漢兵得胡首虜凡七萬餘級，左賢王將皆遁走。驃騎封於狼居胥山，禪姑衍，臨翰海而還。"}],"references":[{"title":"《資治通鑑》卷十九去病幕北軍役","url":"https://zh.wikisource.org/w/index.php?title=資治通鑑/卷019&oldid=1511466","quote":"出代、右北平二千餘里，絕大幕，直左方兵","scope":"received_parallel_event","image_verified":false},{"title":"《資治通鑑》數位編輯紀年標題","url":"https://zh.wikisource.org/w/index.php?title=資治通鑑/卷019&oldid=1511466","quote":"元狩四年（壬戌，公元前一一九年）","scope":"digital_editorial_regnal_year_equivalence_only","image_verified":false}],"rationale":"承第38段前119年兩軍分出與第39段單于遁走，為同年驃騎軍幕北接戰；對讀通鑑元狩四年去病出代二千餘里、七萬餘首虜及狼居胥封禪，記前119年、天文年-118。只記年尺度，本段未有獨立紀年，不補月份或封禪授爵。","reviewer":"Codex（AI 代理）","human_reviewed":false}},{"id":"th-shiji110-113:a002","paragraph_id":"c-shiji-110-xiongnu:p040","start":32,"end":35,"surface":"左賢王","person_mention_id":"c-shiji-110-xiongnu:m04