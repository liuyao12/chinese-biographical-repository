ions":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-songshu-045-wyd1739-liucui:p006","text":"城人帛氏奴梁顯為參軍督護費謙固執不與遠方商人多至蜀土資貨或有直數百萬者謙等限布絲緜各不得過五十斤馬無善惡限蜀錢二萬府又立治一斷私民鼓鑄而貴賣鐵器商旅吁嗟百姓咸欲為亂氏奴旣懷恚忿因聚黨為賊盜其年七月道濟遣羅習為五城令氏奴等謀曰羅令是使君腹心而卿猶有作賊盜不止者一旦發露則為禍不測宜結要誓共相禁檢乃殺牛盟誓俄而氏奴及趙廣等唱曰官禁殺牛而村中公違法禁脫使羅令白使君錄吾徒更欲作賊則無餘類矣因詐言司馬殿下猶在陽泉山中若能共建大事","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-songshu-045-wyd1739-liucui:p006:m0002","start":2,"end":5,"surface":"帛氏奴","kind":"person","person_id":"a75_u9k_m93"},{"id":"c-songshu-045-wyd1739-liucui:p006:m0005","start":5,"end":7,"surface":"梁顯","kind":"person","person_id":"jov_xgs_7of"},{"id":"c-songshu-045-wyd1739-liucui:p006:m0012","start":12,"end":14,"surface":"費謙","kind":"person","person_id":"jm0_moa_yl8"},{"id":"c-songshu-045-wyd1739-liucui:p006:m0035","start":35,"end":36,"surface":"謙","kind":"person","person_id":"jm0_moa_yl8"},{"id":"c-songshu-045-wyd1739-liucui:p006:m0082","start":82,"end":84,"surface":"氏奴","kind":"person","person_id":"a75_u9k_m93"},{"id":"c-songshu-045-wyd1739-liucui:p006:m0098","start":98,"end":100,"surface":"道濟","kind":"person","person_id":"8lh_jgi_l6a_*B"},{"id":"c-songshu-045-wyd1739-liucui:p006:m0101","start":101,"end":103,"surface":"羅習","kind":"person","person_id":"55o_dmu_rtk"},{"id":"c-songshu-045-wyd1739-liucui:p006:m0107","start":107,"end":109,"surface":"氏奴","kind":"person","person_id":"a75_u9k_m93"},{"id":"c-songshu-045-wyd1739-liucui:p006:m0112","start":112,"end":114,"surface":"羅令","kind":"person","person_id":"55o_dmu_rtk"},{"id":"c-songshu-045-wyd1739-liucui:p006:m0115","start":115,"end":117,"surface":"使君","kind":"person","person_id":"8lh_jgi_l6a_*B"},{"id":"c-songshu-045-wyd1739-liucui:p006:m0120","start":120,"end":121,"surface":"卿","kind":"unresolved","person_id":null,"resolution_note":"群體受話者，未定個人。","status":"unresolved"},{"id":"c-songshu-045-wyd1739-liucui:p006:m0153","start":153