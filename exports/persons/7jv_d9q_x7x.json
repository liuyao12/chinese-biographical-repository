status":"contextual_provisional","paragraph_id":"c-shiji-117-xiangru:p050","chapter_id":"c-shiji-117-xiangru"},{"id":"c-shiji-117-xiangru:m055-0009","start":9,"end":11,"surface":"天子","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional","paragraph_id":"c-shiji-117-xiangru:p055","chapter_id":"c-shiji-117-xiangru"},{"id":"c-shiji-117-xiangru:m056-0011","start":11,"end":13,"surface":"天子","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional","paragraph_id":"c-shiji-117-xiangru:p056","chapter_id":"c-shiji-117-xiangru"},{"id":"c-shiji-117-xiangru:m056-0132","start":132,"end":134,"surface":"天子","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional","paragraph_id":"c-shiji-117-xiangru:p056","chapter_id":"c-shiji-117-xiangru"},{"id":"c-shiji-117-xiangru:m068-0009","start":9,"end":11,"surface":"天子","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional","paragraph_id":"c-shiji-117-xiangru:p068","chapter_id":"c-shiji-117-xiangru"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-117-xiangru:p003","text":"居久之，蜀人楊得意為狗監，侍上。上讀子虛賦而善之，曰：「朕獨不得與此人同時哉！」得意曰：「臣邑人司馬相如自言為此賦。」上驚，乃召問相如。相如曰：「有是。然此乃諸侯之事，未足觀也。請為天子游獵賦，賦成奏之。」上許，令尚書給筆劄。相如以「子虛」，虛言也，為楚稱；「烏有先生」者，烏有此事也，為齊難；「無是公」者，無是人也，明天子之義。故空藉此三人為辭，以推天子諸侯之苑囿。其卒章歸之於節儉，因以風諫。奏之天子，天子大說。其辭曰：","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m003-0006","start":6,"end":9,"surface":"楊得意","kind":"person","person_id":"fu9_7ic_bp3","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m003-0014","start":14,"end":15,"surface":"上","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m003-0016","start":16,"end":17,"surface":"上","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m003-0040","start":40,"end":42,"surface":"得意","kind":"person","person_id":"fu9_7ic_bp3","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m003-0048","start":48,"end":52,"surface":"司馬相如","kind":"person","person_id":"shv_i6z_at7","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m003-0059","start":59,"end":60,"surface":"上","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m003-0065","start":65,"end":67,"surface":"相如","kind":"person","person_id":"shv_i6z_at7","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m003-0068","start":68,"end":70,"surface":"相如","kind":"person","person_id":"shv_i6z_at7","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m003-0091","start":91,"end":93,"surface":"天子","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m003-0103","start":103,"end":104,"surface":"上","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m003-0107","start":107,"end":109,"surface":"尚書","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m003-0113","start":113,"end":115,"surface":"相如","kind":"person","person_id":"shv_i6z_at7","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m003-0117","start":117,"end":119,"surface":"子虛","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m003-0130","start":130,"end":134,"surface":"烏有先生","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m003-0148","start":148,"end":151,"surface":"無是公","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m003-0160","start":160,"end":162,"surface":"天子","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m003-0176","start":176,"end":178,"surface":"天子","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m003-0200","start":200,"end":202,"surface":"天子","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m003-0203","start":203,"end":205,"surface":"天子","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"}],"chapter_id":"c-shiji-117-xiangru","book_id":"b-shiji-117","work_id":"w-shiji","source_id":"s-shiji117-xiangru"},{"id":"c-shiji-117-xiangru:p030","text":"賦奏，天子以為郎。無是公言天子上林廣大，山谷水泉萬物，乃子虛言楚雲夢所有甚眾，侈靡過其實，且非義理所尚，故刪取其要，歸正道而論之。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m030-0003","start":3,"end":5,"surface":"天子","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m030-0009","start":9,"end":12,"surface":"無是公","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m030-0013","start":13,"end":15,"surface":"天子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m030-0028","start":28,"end":30,"surface":"子虛","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-117-xiangru","book_id":"b-shiji-117","work_id":"w-shiji","source_id":"s-shiji117-xiangru"},{"id":"c-shiji-117-xiangru:p031","text":"相如為郎數歲，會唐蒙使略通夜郎西僰中，發巴蜀吏卒千人，郡又多為發轉漕萬餘人，用興法誅其渠帥，巴蜀民大驚恐。上聞之，乃使相如責唐蒙，因喻告巴蜀民以非上意。檄曰：","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m031-0000","start":0,"end":2,"surface":"相如","kind":"person","person_id":"shv_i6z_at7","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m031-0008","start":8,"end":10,"surface":"唐蒙","kind":"person","person_id":"fv2_l4w_ufi","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m031-0043","start":43,"end":45,"surface":"渠帥","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m031-0053","start":53,"end":54,"surface":"上","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m031-0059","start":59,"end":61,"surface":"相如","kind":"person","person_id":"shv_i6z_at7","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m031-0062","start":62,"end":64,"surface":"唐蒙","kind":"person","person_id":"fv2_l4w_ufi","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m031-0073","start":73,"end":74,"surface":"上","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"}],"chapter_id":"c-shiji-117-xiangru","book_id":"b-shiji-117","work_id":"w-shiji","source_id":"s-shiji117-xiangru"},{"id":"c-shiji-117-xiangru:p032","text":"告巴蜀太守：蠻夷自擅不討之日久矣，時侵犯邊境，勞士大夫。陛下即位，存撫天下，輯安中國。然後興師出兵，北征匈奴，單于怖駭，交臂受事，詘膝請和。康居西域，重譯請朝，稽首來享。移師東指，閩越相誅。右吊番禺，太子入朝。南夷之君，西僰之長，常效貢職，不敢怠墮，延頸舉踵，喁喁然皆爭歸義，欲為臣妾，道裏遼遠，山川阻深，不能自致。夫不順者已誅，而為善者未賞，故遣中郎將往賓之，發巴蜀士民各五百人，以奉幣帛，衛使者不然，靡有兵革之事，戰鬥之患。今聞其乃發軍興制，驚懼子弟，憂患長老，郡又擅為轉粟運輸，皆非陛下之意也。當行者或亡逃自賊殺，亦非人臣之節也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m032-0001","start":1,"end":5,"surface":"巴蜀太守","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m032-0028","start":28,"end":30,"surface":"陛下","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m032-0055","start":55,"end":57,"surface":"單于","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m032-0100","start":100,"end":102,"surface":"太子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m032-0174","start":174,"end":177,"surface":"中郎將","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m032-0244","start":244,"end":246,"surface":"陛下","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"}],"chapter_id":"c-shiji-117-xiangru","book_id":"b-shiji-117","work_id":"w-shiji","source_id":"s-shiji117-xiangru"},{"id":"c-shiji-117-xiangru:p034","text":"陛下患使者有司之若彼，悼不肖愚民之如此，故遣信使曉喻百姓以發卒之事，因數之以不忠死亡之罪，讓三老孝弟以不教誨之過。方今田時，重煩百姓，已親見近縣，恐遠所谿穀山澤之民不遍聞，檄到，亟下縣道，使咸知陛下之意，唯毋忽也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m034-0000","start":0,"end":2,"surface":"陛下","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m034-0003","start":3,"end":7,"surface":"使者有司","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m034-0046","start":46,"end":50,"surface":"三老孝弟","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m034-0097","start":97,"end":99,"surface":"陛下","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"}],"chapter_id":"c-shiji-117-xiangru","book_id":"b-shiji-117","work_id":"w-shiji","source_id":"s-shiji117-xiangru"},{"id":"c-shiji-117-xiangru:p035","text":"相如還報。唐蒙已略通夜郎，因通西南夷道，發巴、蜀、廣漢卒，作者數萬人。治道二歲，道不成，士卒多物故，費以巨萬計。蜀民及漢用事者多言其不便。是時邛筰之君長聞南夷與漢通，得賞賜多，多欲原為內臣妾，請吏，比南夷。天子問相如，相如曰：「邛、筰、厓、駹者近蜀，道亦易通，秦時嘗通為郡縣，至漢興而罷。今誠複通，為置郡縣，愈於南夷。」天子以為然，乃拜相如為中郎將，建節往使。副使王然於、壺充國、呂越人馳四乘之傳，因巴蜀吏幣物以賂西夷。至蜀，蜀太守以下郊迎，縣令負弩矢先驅，蜀人以為寵。於是卓王孫、臨邛諸公皆因門下獻牛酒以交驩。卓王孫喟然而歎，自以得使女尚司馬長卿晚，而厚分與其女財，與男等同。司馬長卿便略定西夷，邛、筰、厓、駹、斯榆之君皆請為內臣。除邊關，關益斥，西至沬、若水，南至牂柯為徼，通零關道，橋孫水以通邛都。還報天子，天子大說。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m035-0000","start":0,"end":2,"surface":"相如","kind":"person","person_id":"shv_i6z_at7","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0005","start":5,"end":7,"surface":"唐蒙","kind":"person","person_id":"fv2_l4w_ufi","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0073","start":73,"end":75,"surface":"之君","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m035-0103","start":103,"end":105,"surface":"天子","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0106","start":106,"end":108,"surface":"相如","kind":"person","person_id":"shv_i6z_at7","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0109","start":109,"end":111,"surface":"相如","kind":"person","person_id":"shv_i6z_at7","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0160","start":160,"end":162,"surface":"天子","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0168","start":168,"end":170,"surface":"相如","kind":"person","person_id":"shv_i6z_at7","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0182","start":182,"end":185,"surface":"王然於","kind":"person","person_id":"okx_tik_f6o","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0186","start":186,"end":189,"surface":"壺充國","kind":"person","person_id":"8wd_fcv_stu","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0190","start":190,"end":193,"surface":"呂越人","kind":"person","person_id":"8es_sfk_ete","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0213","start":213,"end":216,"surface":"蜀太守","kind":"person","person_id":"2zx_wew_zui","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0237","start":237,"end":240,"surface":"卓王孫","kind":"person","person_id":"lh2_c9g_7vs","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0256","start":256,"end":259,"surface":"卓王孫","kind":"person","person_id":"lh2_c9g_7vs","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0270","start":270,"end":274,"surface":"司馬長卿","kind":"person","person_id":"shv_i6z_at7","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0289","start":289,"end":293,"surface":"司馬長卿","kind":"person","person_id":"shv_i6z_at7","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0309","start":309,"end":311,"surface":"之君","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m035-0354","start":354,"end":356,"surface":"天子","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0357","start":357,"end":359,"surface":"天子","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"}],"chapter_id":"c-shiji-117-xiangru","book_id":"b-shiji-117","work_id":"w-shiji","source_id":"s-shiji117-xiangru"},{"id":"c-shiji-117-xiangru:p036","text":"相如使時，蜀長老多言通西南夷不為用，唯大臣亦以為然。相如欲諫，業已建之，不敢，乃著書，籍以蜀父老為辭，而己詰難之，以風天子，且因宣其使指，令百姓知天子之意。其辭曰：","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m036-0000","start":0,"end":2,"surface":"相如","kind":"person","person_id":"shv_i6z_at7","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m036-0005","start":5,"end":8,"surface":"蜀長老","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m036-0026","start":26,"end":28,"surface":"相如","kind":"person","person_id":"shv_i6z_at7","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m036-0045","start":45,"end":48,"surface":"蜀父老","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m036-0059","start":59,"end":61,"surface":"天子","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m036-0073","start":73,"end":75,"surface":"天子","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"}],"chapter_id":"c-shiji-117-xiangru","book_id":"b-shiji-117","work_id":"w-shiji","source_id":"s-shiji117-xiangru"},{"id":"c-shiji-117-xiangru:p038","text":"耆老大夫薦紳先生之徒二十有七人，儼然造焉。辭畢，因進曰：「蓋聞天子之於夷狄也，其義羈縻勿絕而已。今罷三郡之士，通夜郎之塗，三年於茲，而功不竟，士卒勞倦，萬民不贍，今又接以西夷，百姓力屈，恐不能卒業，此亦使者之累也，竊為左右患之。且夫邛、筰、西僰之與中國並也，歷年茲多，不可記已。仁者不以德來，彊者不以力並，意者其殆不可乎！今割齊民以附夷狄，弊所恃以事無用，鄙人固陋，不識所謂。」","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m038-0000","start":0,"end":8,"surface":"耆老大夫薦紳先生","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m038-0031","start":31,"end":33,"surface":"天子","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m038-0101","start":101,"end":103,"surface":"使者","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-117-xiangru","book_id":"b-shiji-117","work_id":"w-shiji","source_id":"s-shiji117-xiangru"},{"id":"c-shiji-117-xiangru:p045","text":"相如口吃而善著書。常有消渴疾。與卓氏婚，饒於財。其進仕宦，未嘗肯與公卿國家之事，稱病間居，不慕官爵。常從上至長楊獵，是時天子方好自擊熊彘，馳逐野獸，相如上疏諫之。其辭曰：\n臣聞物有同類而殊能者，故力稱烏獲，捷言慶忌，勇期賁、育。臣之愚，竊以為人誠有之，獸亦宜然。今陛下好陵阻險，射猛獸，卒然遇軼材之獸，駭不存之地，犯屬車之清塵，輿不及還轅，人不暇施巧，雖有烏獲、逢蒙之伎，力不得用，枯木朽株盡為害矣。是胡越起於轂下，而羌夷接軫也，豈不殆哉！雖萬全無患，然本非天子之所宜近也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m045-0000","start":0,"end":2,"surface":"相如","kind":"person","person_id":"shv_i6z_at7","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0016","start":16,"end":18,"surface":"卓氏","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m045-0052","start":52,"end":53,"surface":"上","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0060","start":60,"end":62,"surface":"天子","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0074","start":74,"end":76,"surface":"相如","kind":"person","person_id":"shv_i6z_at7","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0100","start":100,"end":102,"surface":"烏獲","kind":"person","person_id":"5sw_h4w_dcv","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0105","start":105,"end":107,"surface":"慶忌","kind":"person","person_id":"903_fwd_xdq","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0110","start":110,"end":111,"surface":"賁","kind":"person","person_id":"xne_qdl_46g","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0112","start":112,"end":113,"surface":"育","kind":"person","person_id":"wnn_236_u9x","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0132","start":132,"end":134,"surface":"陛下","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0178","start":178,"end":180,"surface":"烏獲","kind":"person","person_id":"5sw_h4w_dcv","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0181","start":181,"end":183,"surface":"逢蒙","kind":"person","person_id":"11c_i8z_674","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0229","start":229,"end":231,"surface":"天子","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"}],"chapter_id":"c-shiji-117-xiangru","book_id":"b-shiji-117","work_id":"w-shiji","source_id":"s-shiji117-xiangru"},{"id":"c-shiji-117-xiangru:p046","text":"且夫清道而後行，中路而後馳，猶時有銜橛之變，而況涉乎蓬蒿，馳乎丘墳，前有利獸之樂而內無存變之意，其為禍也不亦難矣！夫輕萬乘之重不以為安，而樂出於萬有一危之塗以為娛，臣竊為陛下不取也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m046-0085","start":85,"end":87,"surface":"陛下","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"}],"chapter_id":"c-shiji-117-xiangru","book_id":"b-shiji-117","work_id":"w-shiji","source_id":"s-shiji117-xiangru"},{"id":"c-shiji-117-xiangru:p047","text":"蓋明者遠見於未萌而智者避危於無形，禍固多藏於隱微而發於人之所忽者也。故鄙諺曰「家累千金，坐不垂堂」。此言雖小，可以喻大。臣原陛下之留意幸察。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m047-0062","start":62,"end":64,"surface":"陛下","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"}],"chapter_id":"c-shiji-117-xiangru","book_id":"b-shiji-117","work_id":"w-shiji","source_id":"s-shiji117-xiangru"},{"id":"c-shiji-117-xiangru:p048","text":"上善之。還過宜春宮，相如奏賦以哀二世行失也。其辭曰：","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m048-0000","start":0,"end":1,"surface":"上","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m048-0010","start":10,"end":12,"surface":"相如","kind":"person","person_id":"shv_i6z_at7","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m048-0016","start":16,"end":18,"surface":"二世","kind":"person","person_id":"flz_o6t_45l","status":"contextual_provisional"}],"chapter_id":"c-shiji-117-xiangru","book_id":"b-shiji-117","work_id":"w-shiji","source_id":"s-shiji117-xiangru"},{"id":"c-shiji-117-xiangru:p050","text":"相如拜為孝文園令。天子既美子虛之事，相如見上好仙道，因曰：「上林之事未足美也，尚有靡者。臣嘗為大人賦，未就，請具而奏之。」相如以為列仙之傳居山澤間，形容甚臒，此非帝王之仙意也，乃遂就大人賦。其辭曰：","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m050-0000","start":0,"end":2,"surface":"相如","kind":"person","person_id":"shv_i6z_at7","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m050-0009","start":9,"end":11,"surface":"天子","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m050-0018","start":18,"end":20,"surface":"相如","kind":"person","person_id":"shv_i6z_at7","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m050-0021","start":21,"end":22,"surface":"上","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m050-0061","start":61,"end":63,"surface":"相如","kind":"person","person_id":"shv_i6z_at7","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m050-0065","start":65,"end":67,"surface":"列仙","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-117-xiangru","book_id":"b-shiji-117","work_id":"w-shiji","source_id":"s-shiji117-xiangru"},{"id":"c-shiji-117-xiangru:p055","text":"相如既奏大人之頌，天子大說，飄飄有淩雲之氣，似遊天地之間意。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m055-0000","start":0,"end":2,"surface":"相如","kind":"person","person_id":"shv_i6z_at7","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m055-0009","start":9,"end":11,"surface":"天子","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"}],"chapter_id":"c-shiji-117-xiangru","book_id":"b-shiji-117","work_id":"w-shiji","source_id":"s-shiji117-xiangru"},{"id":"c-shiji-117-xiangru:p056","text":"相如既病免，家居茂陵。天子曰：「司馬相如病甚，可往從悉取其書；若不然，後失之矣。」使所忠往，而相如已死，家無書。問其妻，對曰：「長卿固未嘗有書也。時時著書，人又取去，即空居。長卿未死時，為一卷書，曰有使者來求書，奏之。無他書。」其遺劄書言封禪事，奏所忠。忠奏其書，天子異之。其書曰：","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m056-0000","start":0,"end":2,"surface":"相如","kind":"person","person_id":"shv_i6z_at7","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m056-0011","start":11,"end":13,"surface":"天子","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m056-0016","start":16,"end":20,"surface":"司馬相如","kind":"person","person_id":"shv_i6z_at7","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m056-0042","start":42,"end":44,"surface":"所忠","kind":"person","person_id":"k0u_vj7_93t","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m056-0047","start":47,"end":49,"surface":"相如","kind":"person","person_id":"shv_i6z_at7","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m056-0057","start":57,"end":59,"surface":"其妻","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m056-0064","start":64,"end":66,"surface":"長卿","kind":"person","person_id":"shv_i6z_at7","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m056-0087","start":87,"end":89,"surface":"長卿","kind":"person","person_id":"shv_i6z_at7","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m056-0124","start":124,"end":126,"surface":"所忠","kind":"person","person_id":"k0u_vj7_93t","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m056-0127","start":127,"end":128,"surface":"忠","kind":"person","person_id":"k0u_vj7_93t","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m056-0132","start":132,"end":134,"surface":"天子","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"}],"chapter_id":"c-shiji-117-xiangru","book_id":"b-shiji-117","work_id":"w-shiji","source_id":"s-shiji117-xiangru"},{"id":"c-shiji-117-xiangru:p068","text":"司馬相如既卒五歲，天子始祭后土。八年而遂先禮中嶽，封於太山，至梁父禪肅然。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m068-0000","start":0,"end":4,"surface":"司馬相如","kind":"person","person_id":"shv_i6z_at7","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m068-0009","start":9,"end":11,"surface":"天子","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"}],"chapter_id":"c-shiji-117-xiangru","book_id":"b-shiji-117","work_id":"w-shiji","source_id":"s-shiji117-xiangru"}],"sources":[{"chapter_id":"c-shiji-117-xiangru","work_id":"w-shiji","book_id":"b-shiji-117","source_id":"s-shiji117-xiangru","source":{"title":"史記／卷117","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷117","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷117&oldid=10371549","revision_id":10371549,"accessed_on":"2026-10-11","extent":"固定修訂全文71段，包括賦、書與末段索隱述贊。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"去header2、目錄標記及現代節標；quote模板保留全文，br轉段落；罕字模板保留第一參數字形，描述未作正文；連結保留顯示字。未核影像。 移除防轉換控制外殼，保留內字云。","note":"第58段U+E0FA私用字缺字與頌中重句原樣保存，不猜補；末段索隱述贊分層。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical"}}
