icy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-043-shantao:p004:m0004","start":4,"end":6,"surface":"和逌","kind":"person","person_id":"2n8_rz3_c9g","status":"contextual_provisional","resolution_note":"按本段主體、引語發受話人及完整附傳範圍辨識；非全域同字匹配。","paragraph_id":"c-jinshu-043-shantao:p004","chapter_id":"c-jinshu-043-shantao"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-043-shantao:p004","text":"晚與尚書和逌交，又與鐘會、裴秀並申款昵。以二人居勢爭權，濤平心處中，各得其所，而俱無恨焉。遷大將軍從事中郎。鐘會作亂於蜀，而文帝將西征。時魏氏諸王公並在鄴，帝謂濤曰：「西偏吾自了之，後事深以委卿。」以本官行軍司馬，給親兵五百人，鎮鄴。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-043-shantao:p004:m0004","start":4,"end":6,"surface":"和逌","kind":"person","person_id":"2n8_rz3_c9g","status":"contextual_provisional","resolution_note":"按本段主體、引語發受話人及完整附傳範圍辨識；非全域同字匹配。"},{"id":"c-jinshu-043-shantao:p004:m0010","start":10,"end":12,"surface":"鐘會","kind":"person","person_id":"a6a_4c2_670","status":"contextual_provisional","resolution_note":"按本段主體、引語發受話人及完整附傳範圍辨識；非全域同字匹配。"},{"id":"c-jinshu-043-shantao:p004:m0013","start":13,"end":15,"surface":"裴秀","kind":"person","person_id":"057_a27_29b","status":"contextual_provisional","resolution_note":"按本段主體、引語發受話人及完整附傳範圍辨識；非全域同字匹配。"},{"id":"c-jinshu-043-shantao:p004:m0021","start":21,"end":23,"surface":"二人","kind":"unresolved","person_id":null,"status":"unresolved","resolution_note":"按本段主體、引語發受話人及完整附傳範圍辨識；非全域同字匹配。"},{"id":"c-jinshu-043-shantao:p004:m0028","start":28,"end":29,"surface":"濤","kind":"person","person_id":"0uv_x8k_mfc_A","status":"contextual_provisional","resolution_note":"按本段主體、引語發受話人及完整附傳範圍辨識；非全域同字匹配。"},{"id":"c-jinshu-043-shantao:p004:m0054","start":54,"end":5