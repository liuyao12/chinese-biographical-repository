關中侯，邑百戶。以少帝不願為侍臣，求出補吏，徙秘書監。及五等建，封钜平子，邑六百戶。鐘會有寵而忌，祜亦憚之。及會誅，拜相國從事中郎，與荀勖共掌機密。遷中領軍，悉統宿衛，入直殿中，執兵之耍，事兼內外。","text_layer":"received_chapter","source_position":{"raw_start":526,"raw_end":709,"raw_character_offsets":[528,529,530,531,532,533,534,535,536,537,538,539,540,541,542,543,544,545,546,547,548,549,550,551,552,553,554,555,556,557,558,559,560,561,562,563,564,565,566,567,568,569,570,571,572,573,574,575,576,577,578,579,580,581,582,583,584,585,586,587,588,589,590,591,592,593,594,595,596,597,598,599,600,601,602,603,604,605,606,607,608,609,610,611,612,613,614,615,616,617,618,619,620,621,622,623,624,625,626,627,628,629,630,631,632,633,634,635,636,637,638,639,640,641,642,643,644,645,646,647,648,649,650,651,652,653,654,655,656,657,658,659,660,661,662,663,664,665,666,667,668,669,670,671,672,673,674,675,676,677,678,679,680,681,682,683,684,685,686,687,688,689,690,691,692,693,694,695,696,697,698,699,700,701,702,703,704,705,706,707,708],"first_line":16,"last_line":16,"revision_id":2567662,"projection_sha256":"3f5c06cb839e452b5496e74bc48cefee4bb5e112b0720192edb41fc244bd3754","source_layer":"received_biography","editorial_subsection":" [[作者:羊祜|羊祜]] ","quotation_block_markup":false},"mentions":[{"id":"c-jinshu-034-yanghu:p003:m0000","start":0,"end":2,"surface":"文帝","kind":"person","person_id":"dkn_ge4_286_AAAAI","status":"source_explicit"},{"id":"c-jinshu-034-yanghu:p003:m0008","start":8,"end":9,"surface":"祜","kind":"person","person_id":"dqd_5q9_pkz_BD","status":"contextual"},{"id":"c-jinshu-034-yanghu:p003:m0033","start":33,"end":37,"surface":"高貴鄉公","kind":"person","person_id":"d6b_ea7_928","status":"source_explicit"},{"id":"c-jinshu-034-yanghu:p003:m0051","start":51,"end":53,"surface":"和逌","kind":"person","person_id":"2n8_rz3_c9g","status":"source_explicit"},{"id":"c-jinshu-034-yanghu:p003:m0059","start":59,"end":60,"surface":"祜","kind":"person","person_id":"dqd_5q9_pkz_BD","status":"contextual"},{"id":"c-jinshu-034-yanghu:p003:m0075","start":75,"end":78,"surface":"陳留王","kind":"person"