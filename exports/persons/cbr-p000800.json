:4,"surface":"貫髙","kind":"person","person_id":"cbr-p005024","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p027","chapter_id":"c-shiji-089-zhanger"},{"id":"c-shiji-089-zhanger:m027-0029","start":29,"end":31,"surface":"貫髙","kind":"person","person_id":"cbr-p005024","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p027","chapter_id":"c-shiji-089-zhanger"},{"id":"c-shiji-089-zhanger:m027-0032","start":32,"end":34,"surface":"貫髙","kind":"person","person_id":"cbr-p005024","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p027","chapter_id":"c-shiji-089-zhanger"},{"id":"c-shiji-089-zhanger:m027-0069","start":69,"end":71,"surface":"貫髙","kind":"person","person_id":"cbr-p005024","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p027","chapter_id":"c-shiji-089-zhanger"}],"relations":[],"title_holdings":[{"id":"th-shiji089-029","person_id":"cbr-p005024","title":"趙相","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-089-zhanger","source_id":"s-shiji-089-zhanger","paragraph_id":"c-shiji-089-zhanger:p024","quote":"漢七年，髙祖從平城過趙，趙王朝夕袒韛蔽，自上食，禮甚卑，有子婿禮。髙祖箕踞詈，甚慢易之。趙相貫髙、趙午等年六十餘，故張耳客也。生平爲氣，乃怒曰：「吾王孱王也！」説王曰：「夫天下豪桀并起，能者先立。今王事髙祖甚恭，而髙祖無禮，請爲王殺之！」張敖齧其指出血，曰：「君何言之誤！且先人亡國，賴髙祖得復國，德流子孫，秋豪皆髙祖力也。願君無復出口。」貫髙、趙午等十餘人皆相謂曰：「乃吾等非也。吾王長者，不倍德。且吾等義不辱，今怨髙祖辱我王，故欲殺之，何乃汙王爲乎？令事成歸王，事敗獨身坐耳。」"}],"attestations":[{"id":"th-shiji089-029:a001","paragraph_id":"c-shiji-089-zhanger:p024","start":44,"end":46,"surface":"趙相","person_mention_id":"c-shiji-089-zhanger:m024-0046","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"保存明示授予、改封及用稱；十年追述不補起年，死亡不自動作任期終點；索隱述贊與正文分層。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji089-047","person_id":"cbr-p005024","scope":"same_chapter","chapter_ids":["c-shiji-089-zhanger"],"status":"contextual_provisional","rationale":"按明示姓名及局部語境承接；武臣與趙歇、張敖的趙王用稱限各段，張黡張黶按同行事件暫接但原字分存。未名者不補姓名。","reviewer":"Codex（AI 代理）","surfaces":["貫髙","髙"],"evidence":[{"paragraph_id":"c-shiji-089-zhanger:p024","quote":"漢七年，髙祖從平城過趙，趙王朝夕袒韛蔽，自上食，禮甚卑，有子婿禮。髙祖箕踞詈，甚慢易之。趙相貫髙、趙午等年六十餘，故張耳客也。生平爲氣，乃怒曰：「吾王孱王也！」説王曰：「夫天下豪桀并起，能者先立。今王事髙祖甚恭，而髙祖無禮，請爲王殺之！」張敖齧其指出血，曰：「君何言之誤！且先人亡國，賴髙祖得復國，德流子孫，秋豪皆髙祖力也。願君無復出口。」貫髙、趙午等十餘人皆相謂曰：「乃吾等非也。吾王長者，不倍德。且吾等義不辱，今怨髙祖辱我王，故欲殺之，何乃汙王爲乎？令事成歸王，事敗獨身坐耳。」"},{"paragraph_id":"c-shiji-089-zhanger:p025","quote":"漢八年，上從東垣還，過趙，貫髙等乃壁人柏人，要之置廁。上過欲宿，心動，問曰：「縣名爲何？」曰：「柏人。」「柏人者，迫於人也！」不宿而去。"},{"paragraph_id":"c-shiji-089-zhanger:p026","quote":"漢九年，貫髙怨家知其謀，乃上變告之。於是上皆并逮捕趙王、貫髙等。十餘人皆爭自剄，貫髙獨怒罵曰：「誰令公爲之？今王實無謀，而并捕王；公等皆死，誰白王不反者！」乃轞車膠致，與王詣長安。治張敖之罪。上乃詔趙群臣賓客有敢從王皆族。貫髙與客孟舒等十餘人，皆自髡鉗，爲王家奴，從來。貫髙至，對獄，曰：「獨吾屬爲之，王實不知。」吏治榜笞數千，刺剟，身無可撃者，終不復言。呂后數言張王以魯元公主故，不宜有此。上怒曰：「使張敖據天下，豈少而女乎！」不聽。廷尉以貫髙事辭聞，上曰：「壯士！誰知者，以私問之。」中大夫泄公曰：「臣之邑子，素知之。此固趙國立名義不侵爲然諾者也。」上使泄公持節問之箯輿前。仰視曰：「泄公邪？」泄公勞苦如生平驩，與語，問張王果有計謀不。髙曰：「人情寧不各愛其父母妻子乎？今吾三族皆以論死，豈以王易吾親哉！顧爲王實不反，獨吾等爲之。」具道本指所以爲者王不知狀。於是泄公入，具以報，上乃赦趙王。"},{"paragraph_id":"c-shiji-089-zhanger:p027","quote":"上賢貫髙爲人能立然諾，使泄公具告之，曰：「張王已出。」因赦貫髙。貫髙喜曰：「吾王審出乎？」泄公曰：「然。」泄公曰：「上多足下，故赦足下。」貫髙曰：「所以不死一身無餘者，白張王不反也。今王已出，吾責已塞，死不恨矣。且人臣有篡殺之名，何面目復事上哉！縱上不殺我，我不愧於心乎？」乃仰絶骯，遂死。當此之時，名聞天下。"}]}],"equivalence_decisions":[{"id":"eq-shiji089-guan","person_ids":["cbr-p000800","cbr-p005024"],"canonical_person_id":"cbr-p000800","scope":"cross_chapter","chapter_ids":["c-shiji-008-gaozu","c-shiji-089-zhanger"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-008-gaozu","source_id":"s-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p068","quote":"高祖之東垣，過柏人，趙相貫高等謀弒高祖，高祖心動，因不留。代王劉仲棄國亡，自歸雒陽，廢以為合陽侯。","mention_ids":["c-shiji-008-gaozu:m068-0012"]},{"chapter_id":"c-shiji-089-zhanger","source_id":"s-shiji-089-zhanger","paragraph_id":"c-shiji-089-zhanger:p025","quote":"漢八年，上從東垣還，過趙，貫髙等乃壁人柏人，要之置廁。上過欲宿，心動，問曰：「縣名爲何？」曰：「柏人。」「柏人者，迫於人也！」不宿而去。","mention_ids":["c-shiji-089-zhanger:m025-0013"]}],"rationale":"趙相貫髙貫高柏人謀弒高祖的事件、地名與官職相配；本篇獄中自白及死亡過程各存。 各篇原字、原文與已發ID保留，同書不視為獨立見證；同指不確證所有紀年、任職、親屬或敘事，不按全域同名批量改號。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-008-gaozu:p068","text":"高祖之東垣，過柏人，趙相貫高等謀弒高祖，高祖心動，因不留。代王劉仲棄國亡，自歸雒陽，廢以為合陽侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m068-0000","start":0,"end":2,"surface":"高祖","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m068-0012","start":12,"end":14,"surface":"貫高","kind":"person","person_id":"cbr-p000800","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m068-0017","start":17,"end":19,"surface":"高祖","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m068-0020","start":20,"end":22,"surface":"高祖","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m068-0031","start":31,"end":33,"surface":"劉仲","kind":"person","person_id":"cbr-p000799","status":"contextual_provisional"}],"chapter_id":"c-shiji-008-gaozu","book_id":"b-shiji-008","work_id":"w-shiji","source_id":"s-shiji-008-gaozu"},{"id":"c-shiji-008-gaozu:p069","text":"九年，趙相貫高等事發覺，夷三族。廢趙王敖為宣平侯。是歲，徙貴族楚昭、屈、景、懷、齊田氏關中。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m069-0005","start":5,"end":7,"surface":"貫高","kind":"person","person_id":"cbr-p000800","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m069-0017","start":17,"end":20,"surface":"趙王敖","kind":"person","person_id":"cbr-p000787","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m069-0031","start":31,"end":43,"surface":"楚昭、屈、景、懷、齊田氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、群體、校勘符號或未定指代；不補未見姓名或世系。"}],"chapter_id":"c-shiji-008-gaozu","book_id":"b-shiji-008","work_id":"w-shiji","source_id":"s-shiji-008-gaozu"},{"id":"c-shiji-089-zhanger:p024","text":"漢七年，髙祖從平城過趙，趙王朝夕袒韛蔽，自上食，禮甚卑，有子婿禮。髙祖箕踞詈，甚慢易之。趙相貫髙、趙午等年六十餘，故張耳客也。生平爲氣，乃怒曰：「吾王孱王也！」説王曰：「夫天下豪桀并起，能者先立。今王事髙祖甚恭，而髙祖無禮，請爲王殺之！」張敖齧其指出血，曰：「君何言之誤！且先人亡國，賴髙祖得復國，德流子孫，秋豪皆髙祖力也。願君無復出口。」貫髙、趙午等十餘人皆相謂曰：「乃吾等非也。吾王長者，不倍德。且吾等義不辱，今怨髙祖辱我王，故欲殺之，何乃汙王爲乎？令事成歸王，事敗獨身坐耳。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-089-zhanger:m024-0004","start":4,"end":6,"surface":"髙祖","kind":"person","person_id":"cbr-p004988","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m024-0012","start":12,"end":14,"surface":"趙王","kind":"person","person_id":"cbr-p004997","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m024-0033","start":33,"end":35,"surface":"髙祖","kind":"person","person_id":"cbr-p004988","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m024-0046","start":46,"end":48,"surface":"貫髙","kind":"person","person_id":"cbr-p005024","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m024-0049","start":49,"end":51,"surface":"趙午","kind":"person","person_id":"cbr-p005025","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m024-0058","start":58,"end":60,"surface":"張耳","kind":"person","person_id":"cbr-p004983","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m024-0101","start":101,"end":103,"surface":"髙祖","kind":"person","person_id":"cbr-p004988","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m024-0107","start":107,"end":109,"surface":"髙祖","kind":"person","person_id":"cbr-p004988","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m024-0119","start":119,"end":121,"surface":"張敖","kind":"person","person_id":"cbr-p004997","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m024-0143","start":143,"end":145,"surface":"髙祖","kind":"person","person_id":"cbr-p004988","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m024-0157","start":157,"end":159,"surface":"髙祖","kind":"person","person_id":"cbr-p004988","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m024-0170","start":170,"end":172,"surface":"貫髙","kind":"person","person_id":"cbr-p005024","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m024-0173","start":173,"end":175,"surface":"趙午","kind":"person","person_id":"cbr-p005025","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m024-0176","start":176,"end":179,"surface":"十餘人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定指代保留原文，不補成員姓名。"},{"id":"c-shiji-089-zhanger:m024-0209","start":209,"end":211,"surface":"髙祖","kind":"person","person_id":"cbr-p004988","status":"contextual_provisional"}],"chapter_id":"c-shiji-089-zhanger","book_id":"b-shiji-089","work_id":"w-shiji","source_id":"s-shiji-089-zhanger"},{"id":"c-shiji-089-zhanger:p025","text":"漢八年，上從東垣還，過趙，貫髙等乃壁人柏人，要之置廁。上過欲宿，心動，問曰：「縣名爲何？」曰：「柏人。」「柏人者，迫於人也！」不宿而去。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-089-zhanger:m025-0004","start":4,"end":5,"surface":"上","kind":"person","person_id":"cbr-p004988","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m025-0013","start":13,"end":15,"surface":"貫髙","kind":"person","person_id":"cbr-p005024","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m025-0027","start":27,"end":28,"surface":"上","kind":"person","person_id":"cbr-p004988","status":"contextual_provisional"}],"chapter_id":"c-shiji-089-zhanger","book_id":"b-shiji-089","work_id":"w-shiji","source_id":"s-shiji-089-zhanger"},{"id":"c-shiji-089-zhanger:p026","text":"漢九年，貫髙怨家知其謀，乃上變告之。於是上皆并逮捕趙王、貫髙等。十餘人皆爭自剄，貫髙獨怒罵曰：「誰令公爲之？今王實無謀，而并捕王；公等皆死，誰白王不反者！」乃轞車膠致，與王詣長安。治張敖之罪。上乃詔趙群臣賓客有敢從王皆族。貫髙與客孟舒等十餘人，皆自髡鉗，爲王家奴，從來。貫髙至，對獄，曰：「獨吾屬爲之，王實不知。」吏治榜笞數千，刺剟，身無可撃者，終不復言。呂后數言張王以魯元公主故，不宜有此。上怒曰：「使張敖據天下，豈少而女乎！」不聽。廷尉以貫髙事辭聞，上曰：「壯士！誰知者，以私問之。」中大夫泄公曰：「臣之邑子，素知之。此固趙國立名義不侵爲然諾者也。」上使泄公持節問之箯輿前。仰視曰：「泄公邪？」泄公勞苦如生平驩，與語，問張王果有計謀不。髙曰：「人情寧不各愛其父母妻子乎？今吾三族皆以論死，豈以王易吾親哉！顧爲王實不反，獨吾等爲之。」具道本指所以爲者王不知狀。於是泄公入，具以報，上乃赦趙王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-089-zhanger:m026-0004","start":4,"end":6,"surface":"貫髙","kind":"person","person_id":"cbr-p005024","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m026-0006","start":6,"end":8,"surface":"怨家","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定指代保留原文，不補成員姓名。"},{"id":"c-shiji-089-zhanger:m026-0020","start":20,"end":21,"surface":"上","kind":"person","person_id":"cbr-p004988","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m026-0025","start":25,"end":27,"surface":"趙王","kind":"person","person_id":"cbr-p004997","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m026-0028","start":28,"end":30,"surface":"貫髙","kind":"person","person_id":"cbr-p005024","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m026-0032","start":32,"end":35,"surface":"十餘人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定指代保留原文，不補成員姓名。"},{"id":"c-shiji-089-zhanger:m026-0040","start":40,"end":42,"surface":"貫髙","kind":"person","person_id":"cbr-p005024","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m026-0091","start":91,"end":93,"surface":"張敖","kind":"person","person_id":"cbr-p004997","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m026-0096","start":96,"end":97,"surface":"上","kind":"person","person_id":"cbr-p004988","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m026-0111","start":111,"end":113,"surface":"貫髙","kind":"person","person_id":"cbr-p005024","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m026-0115","start":115,"end":117,"surface":"孟舒","kind":"person","person_id":"cbr-p005026","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m026-0118","start":118,"end":121,"surface":"十餘人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定指代保留原文，不補成員姓名。"},{"id":"c-shiji-089-zhanger:m026-0135","start":135,"end":137,"surface":"貫髙","kind":"person","person_id":"cbr-p005024","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m026-0178","start":178,"end":180,"surface":"呂后","kind":"person","person_id":"cbr-p005027","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m026-0182","start":182,"end":184,"surface":"張王","kind":"person","person_id":"cbr-p004997","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m026-0185","start":185,"end":189,"surface":"魯元公主","kind":"person","person_id":"cbr-p004999","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m026-0196","start":196,"end":197,"surface":"上","kind":"person","person_id":"cbr-p004988","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m026-0202","start":202,"end":204,"surface":"張敖","kind":"person","person_id":"cbr-p004997","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m026-0218","start":218,"end":220,"surface":"廷尉","kind":"person","person_id":"cbr-p005029","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m026-0221","start":221,"end":223,"surface":"貫髙","kind":"person","person_id":"cbr-p005024","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m026-0227","start":227,"end":228,"surface":"上","kind":"person","person_id":"cbr-p004988","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m026-0247","start":247,"end":249,"surface":"泄公","kind":"person","person_id":"cbr-p005028","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m026-0277","start":277,"end":278,"surface":"上","kind":"person","person_id":"cbr-p004988","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m026-0279","start":279,"end":281,"surface":"泄公","kind":"person","person_id":"cbr-p005028","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m026-0294","start":294,"end":296,"surface":"泄公","kind":"person","person_id":"cbr-p005028","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m026-0299","start":299,"end":301,"surface":"泄公","kind":"person","person_id":"cbr-p005028","statu