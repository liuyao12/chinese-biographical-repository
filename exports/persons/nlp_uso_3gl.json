":[{"id":"th-jin037-qiao-office-cheguan-yushi","person_id":"nlp_uso_3gl","title":"御史中丞","kind":"office","mode":"attestation","status":"source_attested","attestations":[{"id":"th-jin037-qiao-office-cheguan-yushi:occ1","paragraph_id":"c-jinshu-037-qiao-cheng-wuji-ws2630018:p004","start":104,"end":108,"surface":"御史中丞","person_mention_id":"c-jinshu-037-qiao-cheng-wuji-ws2630018:p004:m0108","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-037","source_id":"s-jinshu037-qiao-cheng-wuji-ws2630018","chapter_id":"c-jinshu-037-qiao-cheng-wuji-ws2630018","paragraph_id":"c-jinshu-037-qiao-cheng-wuji-ws2630018:p004","quote":"烈王無忌字公壽，承之難，以年小獲免。咸和中，拜散騎侍郎，累遷屯騎校尉、中書、黃門侍郎。江州刺史褚裒當之鎮，無忌及丹陽尹桓景等餞於版橋。時王暠子丹陽丞耆之在坐，無忌志欲復仇，拔刀將手刃之，裒、景命左右救捍獲免。御史中丞車灌奏無忌欲專殺人，付廷尉科罪。成帝詔曰：「王敦作亂，閔王遇禍，尋事原情，今王何責。然公私憲制，亦巳有斷，王當以體國為大，豈可尋繹由來，以亂朝憲。主者其申明法令，自今已往，有犯必誅。」於是聽以贖論。","person_mention_id":"c-jinshu-037-qiao-cheng-wuji-ws2630018:p004:m0108"}],"interpretation_note":"御史中丞屬車灌，不因無忌被奏而轉給無忌。","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null,"source_career_role":{"kind":"fixed_jin037_qiao_received_offices","role":"cheguan","record_key":"cheguan-yushi","person_mention_id":"c-jinshu-037-qiao-cheng-wuji-ws2630018:p004:m0108"}}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-jin037-qiao-cheguan","person_id":"nlp_uso_3gl","scope":"same_chapter","surfaces":["車灌"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-jinshu-037-qiao-cheng-wuji-ws2630018:p004","quote":"烈王無忌字公壽，承之難，以年小獲免。咸和中，拜散騎侍郎，累遷屯騎校尉、中書、黃門侍郎。江州刺史褚裒當之鎮，無忌及丹陽尹桓景等餞於版橋。時王暠子丹陽丞耆之在坐，無忌志欲復仇，拔刀將手刃之，裒、景命左右救捍獲免。御史中丞車灌奏無忌欲專殺人，付廷尉科罪。成帝詔曰：「王敦作亂，閔王遇禍，尋事原情，今王何責。然公私憲制，亦巳有斷，王當以體國為大，豈可尋繹由來，以亂朝憲。主者其申明法令，自今已往，有犯必誅。」於是聽以贖論。"}],"rationale":"本傳完整