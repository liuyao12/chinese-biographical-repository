022-wangjian-ws1477957"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji035-085","person_id":"vs4_n7e_1qh_A","surfaces":["桓公","桓公終生"],"scope":"same_chapter","chapter_ids":["c-shiji-035-guancai"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-035-guancai:p030","quote":"繆公三年卒，子桓公終生立。"},{"paragraph_id":"c-shiji-035-guancai:p031","quote":"桓公三十五年，魯隱公立。四十五年，魯弒其君隱公。四十六年，宋華父督弒其君殤公，及孔父。五十五年，桓公卒，子莊公夕姑立。"}],"rationale":"依文王子同母十人、蔡曹君世系、蔡女船中事件、楚公子圍弒其王及城濮／伐曹的具體敘事暫定異稱。郟敖／夾敖按同一事件、釐／僖負羈按本卷論贊暫同指；不同國與同國不同世代的同名者分開。匿名者、校勘及跨篇同指仍待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-nanshi-022-wangjian:p005","text":"時朝儀草創，衣服制則，未有定準，儉議曰：「漢景六年，梁王入朝，中郎謁者金貂出入殿門。左思魏都賦雲'藹藹列侍，金貂齊光'，此藩國侍臣有貂之明文。晉百官表雲'太尉參軍四人，朝服武冠'，此又宰府之明文。」又疑百僚敬齊公之禮，儉又曰：「晉王受命，勸進雲，'沖等眷眷'，稱名則應盡禮。」而世子禮秩未定，儉又曰：「春秋曹世子來朝，待以上公之禮，下其君一等。今齊公九命，禮冠列蕃，世子亦宜異數。」並從之。世子鎮石頭城，仍以為世子宮，儉又曰：「魯有靈光殿，漢之前例也。聽事為崇光殿，外齋為宣德殿，以散騎常侍張緒為世子詹事，車服悉依東宮制度。」","mentions":[{"id":"c-nanshi-022-wangjian:p005:m0016","person_id":"7r6_k52_qji_ABAAAAEAA","start":16,"end":17,"surface":"儉","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanshi-022-wangjian:p005:m0042","person_id":"e96_7e2_34a","start":42,"end":44,"surface":"左思","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanshi-022-wangjian:p005:m0109","person_id":"7r6_k52_qji_ABAAAAEAA","start":109,"end":110,"surface":"儉","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanshi-022-wangjian:p005:m0124","person_id":"wxk_zk0_zoi","start":124,"end":125,"surface":"沖","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanshi-022-wangjian:p005:m0146","person_id":"7r6_k52_qji_ABAAAAEAA","start":146,"end":147,"surface":"儉","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上