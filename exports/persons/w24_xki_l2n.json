rson_mention_id":"c-nanqishu-055-filial-complete:p001:m0015"}],"status":"source_attested","interpretation_note":"魏書所記邪利二子中有懷順。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-qi055-cuixieli-death","person_id":"w24_xki_l2n","event_type":"death","source_term":"卒","source_anchor":{"paragraph_id":"c-nanqishu-055-filial-complete:p002","start":37,"end":38,"surface":"卒"},"date_expression":null,"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-055","chapter_id":"c-nanqishu-055-filial-complete","source_id":"s-nanqishu-055-filial-complete-ws1545598","paragraph_id":"c-nanqishu-055-filial-complete:p002","quote":"　　泰始初，淮北陷沒，界上流奔者，多有去就。懷慎因此入北。至桑乾，邪利時已卒，懷慎絕而後蘇。載喪還青州，徒跣冰雪，土氣寒酷，而手足不傷，時人以爲孝感。喪畢，以弟在南，建元初，又逃歸，而弟亦已亡。懷慎孤貧獨立，宗黨哀之，日斂給其升米。永明中卒。","person_mention_id":"c-nanqishu-055-filial-complete:p002:m0033"}],"status":"source_attested","interpretation_note":"按同段人物與次第核所屬卒事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"mentions":[{"id":"c-nanqishu-055-filial-complete:p001:m0015","start":15,"end":17,"surface":"邪利","kind":"person","person_id":"w24_xki_l2n","status":"contextual_provisional","paragraph_id":"c-nanqishu-055-filial-complete:p001","chapter_id":"c-nanqishu-055-filial-complete"},{"id":"c-nanqishu-055-filial-complete:p001:m0060","start":60,"end":62,"surface":"邪利","kind":"person","person_id":"w24_xki_l2n","status":"contextual_provisional","paragraph_id":"c-nanqishu-055-filial-complete:p001","chapter_id":"c-nanqishu-055-filial-complete"},{"id":"c-nanqishu-055-filial-complete:p001:m0137","start":137,"end":140,"surface":"崔邪利","kind":"person","person_id":"w24_xki_l2n","status":"contextual_provisional","paragraph_id":"c-nanqishu-055-filial-complete:p001","chapter_id":"c-nanqishu-055-filial-complete"},{"id":"c-nanqishu-055-filial-complete:p002:m0033",