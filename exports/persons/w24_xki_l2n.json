s_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-055-filial-complete:p001","text":"　　崔懷慎，清河東武城人也。父邪利，魯郡太守，宋元嘉中，沒虜。懷慎與妻房氏篤愛，聞父陷沒，即日遣妻，布衣蔬食，如居喪禮。邪利後仕虜中書，戒懷慎不許如此，懷慎得書更號泣。懷慎從叔模爲滎陽太守，亦同沈虜，模子雖居處改節，而不廢婚宦。大明中，懷慎宗人冀州刺史元孫北使，虜問之曰：「崔邪利、模竝力屈歸命，二家子姪，出處不同，義將安在？」元孫曰：「王尊驅驥，王陽回車，欲令忠孝竝弘，臣子兩節。」","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":17,"last_line":17,"raw_start":549,"raw_end":741,"raw_character_offsets":[549,550,551,552,553,554,555,556,557,558,559,560,561,562,563,564,565,566,567,568,569,570,571,572,573,574,575,576,577,578,579,580,581,582,583,584,585,586,587,588,589,590,591,592,593,594,595,596,597,598,599,600,601,602,603,604,605,606,607,608,609,610,611,612,613,614,615,616,617,618,619,620,621,622,623,624,625,626,627,628,629,630,631,632,633,634,635,636,637,638,639,640,641,642,643,644,645,646,647,648,649,650,651,652,653,654,655,656,657,658,659,660,661,662,663,664,665,666,667,668,669,670,671,672,673,674,675,676,677,678,679,680,681,682,683,684,685,686,687,688,689,690,691,692,693,694,695,696,697,698,699,700,701,702,703,704,705,706,707,708,709,710,711,712,713,714,715,716,717,718,719,720,721,722,723,724,725,726,727,728,729,730,731,732,733,734,735,736,737,738,739,740],"revision_id":1545598},"mentions":[{"id":"c-nanqishu-055-filial-complete:p001:m0002","start":2,"end":5,"surface":"崔懷慎","kind":"person","person_id":"3iy_odt_bv3","status":"contextual_provisional"},{"id":"c-nanqishu-055-filial-complete:p001:m0015","start":15,"end":17,"surface":"邪利","kind":"person","person_id":"w24_xki_l2n","status":"contextual_provisional"},{"id":"c-nanqishu-055-filial-complete:p001:m0031","start":31,"end":33,"surface":"懷慎","kind":"person","person_id":"3iy_odt_bv3","status":"contextual_provisional"},{"id":"c-nanqishu-055-filial-complete:p001:m0035","start":35,"end":37,"surface":"房氏","kind":"person",