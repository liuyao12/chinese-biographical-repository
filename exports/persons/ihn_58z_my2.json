{"id":"c-jinshu-072-guopu:p021:m0093","surface":"嚴平","start":93,"end":95,"person_id":"ihn_58z_my2","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-072-guopu:p021","chapter_id":"c-jinshu-072-guopu"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-072-guopu:p021","text":"「夫欣黎黃之音者，不顰蟪蛄之吟；豁雲台之觀者，必閟帶索之歡。縱蹈而詠采薺，擁璧而歎抱關。戰機心以外物，不能得意於一弦。悟往復于嗟歎，安可與言樂天者乎！若乃莊周偃蹇於漆園，老萊婆娑于林窟，嚴平澄漠於塵肆，梅真隱淪乎市卒，梁生吟嘯而矯跡，焦先混沌而槁杌，阮公昏酣而賣傲，翟叟遁形以倏忽。吾不能歲韻於數賢，故寂然玩此員策與智骨。」","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":50,"last_line":50,"raw_start":4105,"raw_end":4269,"raw_character_offsets":[4105,4106,4107,4108,4109,4110,4111,4112,4113,4114,4115,4116,4117,4118,4119,4120,4121,4122,4123,4124,4125,4126,4127,4128,4129,4130,4131,4132,4133,4134,4135,4136,4137,4138,4139,4140,4141,4142,4143,4144,4145,4146,4147,4148,4149,4150,4151,4152,4153,4154,4155,4156,4157,4158,4159,4160,4161,4162,4163,4164,4165,4166,4167,4168,4169,4170,4171,4172,4173,4174,4175,4176,4177,4178,4179,4180,4181,4182,4183,4184,4185,4186,4187,4188,4189,4190,4191,4192,4193,4194,4195,4196,4197,4198,4199,4200,4201,4202,4203,4204,4205,4206,4207,4208,4209,4210,4211,4212,4213,4214,4215,4216,4217,4218,4219,4220,4221,4222,4223,4224,4225,4226,4227,4228,4229,4230,4231,4232,4233,4234,4235,4236,4237,4238,4239,4240,4241,4242,4243,4244,4245,4246,4247,4248,4249,4250,4251,4252,4253,4254,4255,4256,4257,4258,4259,4260,4261,4262,4263,4264,4265,4266],"revision_id":2595548},"mentions":[{"id":"c-jinshu-072-guopu:p021:m0077","surface":"莊周","start":77,"end":79,"person_id":"g1r_0em_2tf","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-072-guopu:p021:m0085","surface":"老萊","start":85,"end":87,"person_id":"xdw_cre_8r1","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-