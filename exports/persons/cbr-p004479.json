erson_id":"cbr-p004472","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m022-0168","start":168,"end":170,"surface":"大王","kind":"person","person_id":"cbr-p004480","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m022-0177","start":177,"end":178,"surface":"臣","kind":"person","person_id":"cbr-p004472","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m022-0180","start":180,"end":181,"surface":"臣","kind":"person","person_id":"cbr-p004472","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m022-0191","start":191,"end":193,"surface":"王稽","kind":"person","person_id":"cbr-p004481","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m022-0204","start":204,"end":205,"surface":"臣","kind":"person","person_id":"cbr-p004472","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m022-0210","start":210,"end":212,"surface":"昭王","kind":"person","person_id":"cbr-p004480","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m022-0213","start":213,"end":215,"surface":"王稽","kind":"person","person_id":"cbr-p004481","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m022-0230","start":230,"end":233,"surface":"鄭安平","kind":"person","person_id":"cbr-p004479","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m022-0234","start":234,"end":236,"surface":"昭王","kind":"person","person_id":"cbr-p004480","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m022-0241","start":241,"end":243,"surface":"范睢","kind":"person","person_id":"cbr-p004472","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m022-0253","start":253,"end":258,"surface":"所嘗困戹者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名角色或擬托身分保留，不補姓名；主人翁是范睢微行語境未核角色，先人不補父親。"}],"chapter_id":"c-shiji-079-fancai","book_id":"b-shiji-079","work_id":"w-shiji","source_id":"s-shiji-079-fancai"},{"id":"c-shiji-079-fancai:p026","text":"後五年，昭王用應侯謀，縱反閒賣趙，趙以其故，令馬服子代廉頗將。秦大破趙於長平，遂圍邯鄲。已而與武安君白起有隙，言而殺之。任鄭安平，使擊趙。鄭安平為趙所圍，急，以兵二萬人降趙。應侯席槁請罪。秦之法，任人而所任不善者，各以其罪罪之。於是應侯罪當收三族。秦昭王恐傷應侯之意，乃下令國中：「有敢言鄭安平事者，以其罪罪之。」而加賜相國應侯食物日益厚，以順適其意。後二歲，王稽為河東守，與諸侯通，坐法誅。而應侯日益以不懌。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-079-fancai:m026-0004","start":4,"end":6,"surface":"昭王","kind":"person","person_id":"cbr-p004480","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m026-0007","start":7,"end":9,"surface":"應侯","kind":"person","person_id":"cbr-p004472","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m026-0023","start":23,"end":26,"surface":"馬服子","kind":"person","person_id":"cbr-p004520","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m026-0027","start":27,"end":29,"surface":"廉頗","kind":"person","person_id":"cbr-p004521","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m026-0047","start":47,"end":52,"surface":"武安君白起","kind":"person","person_id":"cbr-p004522","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m026-0061","start":61,"end":64,"surface":"鄭安平","kind":"person","person_id":"cbr-p004479","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m026-0069","start":69,"end":72,"surface":"鄭安平","kind":"person","person_id":"cbr-p004479","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m026-0087","start":87,"end":89,"surface":"應侯","kind":"person","person_id":"cbr-p004472","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m026-0116","start":116,"end":118,"surface":"應侯","kind":"person","person_id":"cbr-p004472","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m026-0121","start":121,"end":123,"surface":"三族","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛論、未名角色或未行方案保留，不補姓名、成員及親屬；相士預言與富貴壽長願望不當生平已證實。"},{"id":"c-shiji-079-fancai:m026-0124","start":124,"end":127,"surface":"秦昭王","kind":"person","person_id":"cbr-p004480","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m026-0129","start":129,"end":131,"surface":"應侯","kind":"person","person_id":"