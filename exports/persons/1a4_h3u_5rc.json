contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line051:m0020","start":20,"end":23,"surface":"公乘雄","kind":"person","person_id":"3mu_e5d_yfz","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line051:m0025","start":25,"end":27,"surface":"元帝","kind":"person","person_id":"dkn_ge4_286_AAAAAAA","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line051:m0030","start":30,"end":31,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line051:m0049","start":49,"end":50,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line051:m0057","start":57,"end":59,"surface":"陳晷","kind":"person","person_id":"hke_a0y_you","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line051:m0064","start":64,"end":66,"surface":"虞𩦎","kind":"person","person_id":"u40_zod_c8p","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line051:m0073","start":73,"end":74,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line051:m0098","start":98,"end":99,"surface":"含","kind":"person","person_id":"mwc_md4_l0g","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line051:m0112","start":112,"end":113,"surface":"含","kind":"person","person_id":"mwc_md4_l0g","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line051:m0114","start":114,"end":115,"surface":"瑜","kind":"person","person_id":"mwc_md4_l0g_B","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"source_position":{"first_line":51,"last_line":51,"revision_id":2614273},"source_quote":{"witness":"j98","quote":"敦又忌周劄，殺之而盡滅其族。常從督冉曾、公乘雄等為元帝腹心，敦又害之。以宿衛尚多，奏令三番休二。及敦病篤，詔遣侍中陳晷、散騎常侍虞{{!|𩦎|⿰馬斐}}問疾。時帝將討敦，微服至蕪湖，察其營壘，又屢遣大臣訊問其起居。遷含驃騎大將軍、開府儀同三司，含子瑜散騎常侍。","raw_start":4365,"raw_end":4495,"raw_line":51},"chapter_id":"c-jinshu-098-jin033-wangji","book_id":"b-jinshu-098","work_id":"w-jinshu","source_id":"s-jinshu-098-jin033-wangji"},{"id":"c-jinshu-098-jin033-wangji:line055","text":"先帝以聖德應運，創業江東，司徒導首居心膂，以道翼讚。故大將軍敦參處股肱，或內或外，夾輔之勳，與有力焉。階緣際會，遂據上宰，杖節專征，委以五州。刁協、劉隗立朝不允，敦抗義致討，情希鬻拳，兵雖犯順，猶嘉乃誠，禮秩優崇，人臣無貳。事解之後，劫掠城邑，放恣兵人，侵及宮省；背違赦信，誅戮大臣；縱凶極逆，不朝而退。六合阻心，人情同憤。先帝含垢忍恥，容而不責，委任如舊，禮秩有加。朕以不天，尋丁酷罰，煢煢在疚，哀悼靡寄。而敦曾無臣子追遠之誠，又無輔孤同獎之操，繕甲聚兵，盛夏來至，輒以天官假授私屬，將以威脅朝廷，傾危宗社。朕湣其狂戾，冀其覺悟，故且含隱以觀其終。而敦矜其不義之強，有侮弱朝廷之志，棄親用羈，背賢任惡。錢鳳豎子，專為謀主，逞其凶慝，誣罔忠良。周嵩亮直，讜言致禍；周劄、周莚累世忠義，聽受讒構，殘夷其宗。秦人之酷，刑不過五。敦之誅戮，傍濫無辜，滅人之族，莫知其罪。天下駭心，道路以目。神怒人怨，篤疾所嬰，昏荒悖逆，日以滋其，輒立兄息以自承代，多樹私黨，莫非同惡，未有宰相繼體而不由王命者也。頑凶相獎，無所顧忌，擅錄冶工，輒割運漕，志騁凶醜，以窺神器。社稷之危，匪夕則旦。天下長奸，敦以隕斃。鳳承凶宄，彌復煽逆。是可忍也，孰不可忍也！","annotation_status":"reviewed","text_layer":"received_chapter","mentions":[{"id":"c-jinshu-098-jin033-wangji:line055:m0015","start":15,"end":16,"surface":"導","kind":"person","person_id":"7r6_k52_qji_ABAA","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line055:m0030","start":30,"end":31,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line055:m0071","start":71,"end":73,"surface":"刁協","kind":"person","person_id":"c20_ec4_36f","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line055:m0074","start":74,"end":76,"surface":"劉隗","kind":"person","person_id":"hnd_3at_h4i","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line055:m0081","start":81,"end":82,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line055:m0089","start":89,"end":91,"surface":"鬻拳","kind":"person","person_id":"woz_jwd_840","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line055:m0205","start":205,"end":206,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line055:m0276","start":276,"end":277,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line055:m0302","start":302,"end":304,"surface":"錢鳳","kind":"person","person_id":"762_5c8_663","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line055:m0322","start":322,"end":324,"surface":"周嵩","kind":"person","person_id":"3xx_gdy_or6_AAB","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line055:m0332","start":332,"end":334,"surface":"周劄","kind":"person","person_id":"1a4_h3u_5rc","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line055:m0335","start":335,"end":337,"surface":"周莚","kind":"person","person_id":"jo4_7hm_ivw","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line055:m0362","start":362,"end":363,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line055:m0490","start":490,"end":491,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line055:m0495","start":495,"end":496,"surface":"鳳","kind":"person","person_id":"762_5c8_663","status":"contextual_provisional","interpretation_note":"以來源原字標記