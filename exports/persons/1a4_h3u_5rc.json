decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-w098-dun-zhouzha","person_id":"1a4_h3u_5rc","event_type":"death","source_term":"敦又忌周劄，殺之","date_expression":null,"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-098","chapter_id":"c-jinshu-098-jin033-wangji","source_id":"s-jinshu-098-jin033-wangji","paragraph_id":"c-jinshu-098-jin033-wangji:line051","quote":"敦又忌周劄，殺之而盡滅其族。常從督冉曾、公乘雄等為元帝腹心，敦又害之。以宿衛尚多，奏令三番休二。及敦病篤，詔遣侍中陳晷、散騎常侍虞𩦎問疾。時帝將討敦，微服至蕪湖，察其營壘，又屢遣大臣訊問其起居。遷含驃騎大將軍、開府儀同三司，含子瑜散騎常侍。","person_mention_id":"c-jinshu-098-jin033-wangji:line051:m0003"}],"interpretation_note":"依本來源登記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-jinshu-098-jin033-wangji:line045:m0035","start":35,"end":37,"surface":"周劄","kind":"person","person_id":"1a4_h3u_5rc","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line045","chapter_id":"c-jinshu-098-jin033-wangji"},{"id":"c-jinshu-098-jin033-wangji:line045:m0050","start":50,"end":51,"surface":"劄","kind":"person","person_id":"1a4_h3u_5rc","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line045","chapter_id":"c-jinshu-098-jin033-wangji"},{"id":"c-jinshu-098-jin033-wangji:line045:m0063","start":63,"end":64,"surface":"劄","kind":"person","person_id":"1a4_h3u_5rc","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line045","chapter_id":"c-jinshu-098-jin033-wangji"},{"id":"c-jinshu-098-jin033-wangji:line051:m0003","start":3,"end":5,"surface":"周劄","kind":"person","person_id":"1a4_h3u_5rc","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line051","chapter_id":"c-jinshu-098-jin033-wangji"},{"id":"c-jinshu-098-jin033-wangji:line055:m0332","start":332,"end":334,"surface":"周劄","kind":"person","person_id":"1a4_h3u_5rc","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line055","chapter_id":"c-jinshu-098-jin033-wangji"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-098-jin033-wangji:line045","text":"敦至石頭，欲攻劉隗，其將杜弘曰：「劉隗死士眾多，未易可克，不如攻石頭。周劄少恩，兵不為用，攻之必敗。劄敗，則隗自走。」敦從之。劄果開城門納弘。諸將與敦戰，王師敗績。既入石頭，擁兵不朝，放肆兵士劫掠內外。官省奔散，惟有侍中二人侍帝。帝脫戎衣，著朝服，顧而言曰：「欲得我處，但當早道，我自還琅邪，何至困百姓如此！」敦收周顗、戴若思害之。以敦為丞相、江州牧，進爵武昌郡公，邑萬戶，使太常荀崧就拜，又加羽葆鼓吹，並偽讓不受。還屯武昌，多害忠良，寵樹親戚，以兄含為衛將軍、都督沔南軍事、領南蠻校尉、荊州刺史，以義陽太守任愔督河北諸軍事、南中郎將，敦又自督寧、益二州。","annotation_status":"reviewed","text_layer":"received_chapter","mentions":[{"id":"c-jinshu-098-jin033-wangji:line045:m0000","start":0,"end":1,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line045:m0007","start":7,"end":9,"surface":"劉隗","kind":"person","person_id":"hnd_3at_h4i","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line045:m0012","start":12,"end":14,"surface":"杜弘","kind":"person","person_id":"f85_nkp_oek","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line045:m0017","start":17,"end":19,"surface":"劉隗","kind":"person","person_id":"hnd_3at_h4i","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line045:m0035","start":35,"end":37,"surface":"周劄","kind":"person","person_id":"1a4_h3u_5rc","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line045:m0050","start":50,"end":51,"sur