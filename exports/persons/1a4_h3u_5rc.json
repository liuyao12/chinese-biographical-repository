ovisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-wu060-zhoufang-2","subject_person_id":"1a4_h3u_5rc","object_person_id":"iuc_mqu_3jm_A","predicate":"father","qualifiers":{"source_term":"处子玘、札"},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-060","chapter_id":"c-sanguozhi-060-zhoufang","source_id":"s-sanguozhi-060-zhoufang","paragraph_id":"c-sanguozhi-060-zhoufang:line090-pei01-01","quote":"虞预《晋书》曰：处入晋，为御史中丞，多所弹纠，不避强御。齐万年反，以处为建威将军，西征，众寡不敌，处临陈慷慨，奋不顾身，遂死於战场，追赠平西将军。处子玘、札，皆有才力，中兴之初，并见宠任。其诸子侄悉处列位，为扬土豪右，而札凶淫放恣，为百姓所苦。泰宁中，王敦诛之，灭其族。","subject_person_mention_id":"c-sanguozhi-060-zhoufang:line090-pei01-01:m0077","object_person_mention_id":"c-sanguozhi-060-zhoufang:line090-pei01-01:m0008"}],"interpretation_note":"以此來源所述兩端為據。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-w098-dun-zhouzha","person_id":"1a4_h3u_5rc","event_type":"death","source_term":"敦又忌周劄，殺之","date_expression":null,"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-098","chapter_id":"c-jinshu-098-jin033-wangji","source_id":"s-jinshu-098-jin033-wangji","paragraph_id":"c-jinshu-098-jin033-wangji:line051","quote":"敦又忌周劄，殺之而盡滅其族。常從督冉曾、公乘雄等為元帝腹心，敦又害之。以宿衛尚多，奏令三番休二。及敦病篤，詔遣侍中陳晷、散騎常侍虞𩦎問疾。時帝將討敦，微服至蕪湖，察其營壘，又屢遣大臣訊問其起居。遷含驃騎大將軍、開府儀同三司，含子瑜散騎常侍。","person_mention_id":"c-jinshu-098-jin033-wangji:line051:m0003"}],"interpretation_note":"依本來源登記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"le-wu060-zhoufang4","person_id":"1a4_h3u_5rc","event_type":"death","source_term":"王敦诛之，灭其族","date_expression":null,"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-060","chapter_id":"c-sanguozhi-060-zhoufang","source_id":"s-sanguozhi-060-zhoufang","paragraph_id":"c-sanguozhi-060-zhoufang:line090-pei01-01","quote":"虞预《晋书》曰：处入晋，为御史中丞，多所弹纠，不避强御。齐万年反，以处为建威将军，西征，众寡不敌，处临陈慷慨，奋不顾身，遂死於战场，追赠平西将军。处子玘、札，皆有才力，中兴之初，并见宠任。其诸子侄悉处列位，为扬土豪右，而札凶淫放恣，为百姓所苦。泰宁中，王敦诛之，灭其族。","person_mention_id":"c-sanguozhi-060-zhoufang:line090-pei01-01:m0077"}],"interpretation_note":"本來源所記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-jinshu-067-xijian:line078:m0143","start":143,"end":145,"surface":"周札","kind":"person","person_id":"1a4_h3u_5rc","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-067-xijian:line078","chapter_id":"c-jinshu-067-xijian"},{"id":"c-jinshu-067-xijian:line078:m0155","start":155,"end":156,"surface":"札","kind":"person","person_id":"1a4_h3u_5rc","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-067-xijian:line078","chapter_id":"c-jinshu-067-xijian"},{"id":"c-jinshu-067-xijian:line078:m0181","start":181,"end":182,"surface":"札","kind":"person","person_id":"1a4_h3u_5rc","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-067-xijian:line078","chapter_id":"c-jinshu-067-xijian"},{"id":"c-jinshu-098-jin033-wangji:line045:m0035","start":35,"end":37,"surface":"周劄","kind":"person","person_id":"1a4_h3u_5rc","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line045","chapter_id":"c-jinshu-098-jin033-wangji"},{"id":"c-jinshu-098-jin033-wangji:line045:m0050","start":50,"end":51,"surface":"劄","kind":"person","person_id":"1a4_h3u_5rc","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line045","chapter_id":"c-jinshu-098-jin033-wangji"},{"id":"c-jinshu-098-jin033-wangji:line045:m0063","start":63,"end":64,"surface":"劄","kind":"person","person_id":"1a4_h3u_5rc","status":"contextual_provisiona