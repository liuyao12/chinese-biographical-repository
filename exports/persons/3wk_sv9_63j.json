wed":false},{"id":"a-chen017-xinan-father","subject_person_id":"3wk_sv9_63j","object_person_id":"qvt_eq1_lcf_A","predicate":"father","qualifiers":{"source_term":"梁(之)[文]帝女","lineage":"paternal"},"evidence":[{"work_id":"w-chenshu","book_id":"b-chenshu-017","chapter_id":"c-chenshu-017-yuanshu-complete","source_id":"s-chenshu-017-yuanshu-complete-ws1544244","paragraph_id":"c-chenshu-017-yuanshu-complete:p003","quote":"樞博聞彊識，明悉舊章。初，高祖長女永世公主先適陳留太守錢蕆，生子岊，主及岊嵭卒于梁世。高祖受命，唯公主追封。至是將葬，尚書主客請詳議，欲加蕆駙馬都尉，并贈岊官。樞議曰：「昔王姬下嫁，必適諸侯，同姓為主，聞於公羊之說，車服不繫，顯於詩人之篇。漢氏初興，列侯尚主，自斯以後，降嬪素族。駙馬都尉置由漢武，或以假諸功臣，或以加於戚屬，是以魏曹植表駙馬、奉車趣為一號。齊職儀曰，凡尚公主必拜駙馬都尉，魏、晉以來，因為瞻準。蓋以王姬之重，庶姓之輕，若不加其等級，寧可合劜而酳，所以假駙馬之位，乃崇於皇女也。今公主早薨，伉儷已絕，既無禮數致疑，何須駙馬之授？案杜預尚晉宣帝第二女高陵宣公主，晉武踐祚，而主已亡，泰始中追贈公主，元凱無復駙馬之號。梁(之)[文]帝女新安穆公主早薨，天監初王氏無追拜之事。遠近二例，足以據明。公主所生，既未及成人之禮，無勞此授，今宜追贈亭侯。」時以樞議為長。","subject_person_mention_id":"c-chenshu-017-yuanshu-complete:p003:m0324","object_person_mention_id":"c-chenshu-017-yuanshu-complete:p003:m0315"}],"status":"source_attested","interpretation_note":"限固定數位校訂的「文」字讀法，殿本該處刻「之」。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"a-chen017-xinan-spouse","subject_person_id":"3wk_sv9_63j","object_person_id":"7r6_k52_qji_ABAAAAAABA","predicate":"spouse","qualifiers":{"source_term":"王氏無追拜之事"},"evidence":[{"work_id":"w-chenshu","book_id":"b-chenshu-017","chapter_id":"c-chenshu-017-yuanshu-complete","source_id":"s-chenshu-017-yuanshu-complete-ws1544244","paragraph_id":"c-chenshu-017-yuanshu-complete:p003","quote":"樞博聞彊識，明悉舊章。初，高祖長女永世公主先適陳留太守錢蕆，生子岊，主及岊嵭卒于梁世。高祖受命，唯公主追封。至是將葬，尚書主客請詳議，欲加蕆駙馬都尉，并贈岊官。樞議曰：「昔王姬下嫁，必適諸侯，同姓為主，聞於公羊之說，車服不繫，顯於詩人之篇。漢氏初興，列侯尚主，自斯以後，降嬪素族。駙馬都尉置由漢武，或以假諸功臣，或以加於戚屬，是以魏曹植表駙馬、奉車趣為一號。齊職儀曰，凡尚公主必拜駙馬都尉，魏、晉以來，因為瞻準。蓋以王姬之重，庶姓之輕，若不加其等級，寧可合劜而酳，所以假駙馬之位，乃崇於皇女也。今公主早薨，伉儷已絕，既無禮數致疑，何須駙馬之授？案杜預尚晉宣帝第二女高陵宣公主，晉武踐祚，而主已亡，泰始中追贈公主，元凱無復駙馬之號。梁(之)[文]帝女新安穆公主早薨，天監初王氏無追拜之事。遠近二例，足以據明。公主所生，既未及成人之禮，無勞此授，今宜追贈亭侯。」時以樞議為長。","subject_person_mention_id":"c-chenshu-017-yuanshu-complete:p003:m0324","object_person_mention_id":"c-chenshu-017-yuanshu-complete:p003:m0335"}],"status":"source_attested","interpretation_note":"以王沖傳所敘父茂璋、母新安穆公主比對，此例夫稱王氏。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-chenshu-017-wangchong-complete:p001:m0040","start":40,"end":45,"surface":"新安穆公主","kind":"person","person_id":"3wk_sv9_63j","status":"contextual_provisional","paragraph_id":"c-chenshu-017-wangchong-complete:p001","chapter_id":"c-chenshu-017-wangchong-complete"},{"id":"c-chenshu-017-yuanshu-complete:p003:m0324","start":324,"end":329,"surface":"新安穆公主","kind":"person","person_id":"3wk_sv9_63j","status":"contextual_provisional","paragraph_id":"c-chenshu-017-yuanshu-complete:p003","chapter_id":"c-chenshu-017-yuanshu-complete"}],"relations":[{"id":"a-chen017-chong-mother","subject_person_id":"7r6_k52_qji_ABAAAAAABAA","object_person_id":"3wk_sv9_63j","predicate":"mother","qualifiers":{"source_term":"沖母"},"evidence":[{"work_id":"w-chenshu","book_id":"b-chenshu-017","chapter_id":"c-chenshu-017-wangchong-complete","source_id":"s-chenshu-017-wangchong-complete-ws1544244","paragraph_id":"c-chenshu-017-wangchong-complete:p001","quote":"王沖字長深，琅邪臨沂人也。祖僧衍，齊侍中。父茂璋，梁給事黃門侍郎。沖母，梁武帝妹新安穆公主，卒於齊世，武帝以沖偏孤，深所鍾愛。年十八，起家梁祕書郎。尋為永嘉太守。入為太子舍人，以父憂去職。服闋，除太尉臨川王府外兵參軍、東宮領直。累遷太子洗馬、中舍人。出為招遠將軍、衡陽內史。遷武威將軍、安成嗣王長史、長沙內史，將軍如故。王薨於湘州，仍以沖監湘州事。入為太子庶子。遷給事黃門侍郎。大同三年，以帝甥賜爵安東亭侯，邑一百五十戶。歷明威將軍、南郡太守、太子中庶子、侍中。出監吳郡，滿歲即真。徵為通直散騎常侍，兼左民尚書。出為明威將軍、輕車當陽公府長史、江夏太守，行郢州事。遷平西邵陵王長史。轉驃騎廬陵王長史、南郡太守。王薨，行州府事。梁元帝鎮荊州，為鎮西長史，將軍、太守如故。沖性和順，事上謹肅，習於法令，政在平理，佐藩两人，鮮有失德，雖無赫赫之譽，久而見思，由是推重，累居二千石。又曉音樂，習歌舞，善與人交，貴游之中，聲名藉甚。","subject_person_mention_id":"c-chenshu-017-wangchong-complete:p001:m0000","object_person_mention_id":"c-chenshu-017-wangchong-complete:p001:m0040"}],"status":"source_attested","interpretation_note":"按本卷本句兩端親稱及所在字位。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"a-chen017-x