{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p001372","identity_policy":"contextual_provisional","person_ids":["cbr-p001372"],"persons":[{"id":"cbr-p001372","label":"趙王遷（燕王喜記事）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"趙王遷","mention_ids":["c-shiji-034-yan:m032-0267"]}],"evidence":[{"mention_id":"c-shiji-034-yan:m032-0267","chapter_id":"c-shiji-034-yan","paragraph_id":"c-shiji-034-yan:p032","quote":"趙王遷"}]}],"source_mention_summary":[{"source_id":"s-shiji-034-yan","work_id":"w-shiji","book_id":"b-shiji-034","chapter_id":"c-shiji-034-yan","mention_count":1,"mention_ids":["c-shiji-034-yan:m032-0267"],"paragraph_ids":["c-shiji-034-yan:p032"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-034-yan"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-034-yan:m032-0267","start":267,"end":270,"surface":"趙王遷","kind":"person","person_id":"cbr-p001372","status":"contextual_provisional","paragraph_id":"c-shiji-034-yan:p032","chapter_id":"c-shiji-034-yan"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji034-116","person_id":"cbr-p001372","surfaces":["趙王遷"],"scope":"same_chapter","chapter_ids":["c-shiji-034-yan"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-034-yan:p032","quote":"六年，秦滅東（西）周，置三川郡。七年，秦拔趙楡次三十七城，秦置大原郡。九年，秦王政初卽位。十年，趙使廉頗將攻繁陽，拔之。趙孝成王卒，悼襄王立。使樂乘代廉頗，廉頗不聽，攻樂乘，樂乘走，廉頗奔大梁。十二年，趙使李牧攻燕，拔武遂、方城。劇辛故居趙，與龐煖善，已而亡走燕。燕見趙數困于秦，而廉頗去，令龐煖將也，欲因趙獘攻之。問劇辛，辛曰：「龐煖易與耳。」燕使劇辛將撃趙，趙使龐煖撃之，取燕軍二萬，殺劇辛。秦拔魏二十城，置東郡。十九年，秦拔趙之鄴九城。趙悼襄王卒。二十三年，太子丹質於秦，亡歸燕。二十五年，秦虜滅韓王安，置潁川郡。二十七年，秦虜趙王遷，滅趙。趙公子嘉自立爲代王。"}],"rationale":"依周初封建、燕君世系、割地救燕、讓國及秦滅諸國的具體語境暫定異稱。繼位不自動證父子；同爵者分國別與前後世代。太子平／燕昭王依本篇明示，不表示年代及世系已校定。作君奭為書名，君奭不説之君奭才暫解召公稱呼。","reviewer":"Codex（AI 代理）"}],"equivalen