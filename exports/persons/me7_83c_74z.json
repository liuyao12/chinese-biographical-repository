-xiangyu:m034-0099","start":99,"end":101,"surface":"樓煩","kind":"person","person_id":"me7_83c_74z","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p034","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-007-xiangyu:m034-0108","start":108,"end":110,"surface":"樓煩","kind":"person","person_id":"me7_83c_74z","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p034","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-007-xiangyu:m034-0129","start":129,"end":131,"surface":"樓煩","kind":"person","person_id":"me7_83c_74z","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p034","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-007-xiangyu:m034-0142","start":142,"end":144,"surface":"樓煩","kind":"person","person_id":"me7_83c_74z","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p034","chapter_id":"c-shiji-007-xiangyu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-007-xiangyu:p034","text":"楚漢久相持未決，丁壯苦軍旅，老弱罷轉漕。項王謂漢王曰：「天下匈匈數歲者，徒以吾兩人耳，願與漢王挑戰決雌雄，毋徒苦天下之民父子為也。」漢王笑謝曰：「吾寧鬬智，不能鬬力。」項王令壯士出挑戰。漢有善騎射者樓煩，楚挑戰三合，樓煩輒射殺之。項王大怒，乃自被甲持戟挑戰。樓煩欲射之，項王瞋目叱之，樓煩目不敢視，手不敢發，遂走還入壁，不敢復出。漢王使人閒問之，乃項王也。漢王大驚。於是項王乃即漢王相與臨廣武閒而語。漢王數之，項王怒，欲一戰。漢王不聽，項王伏弩射中漢王。漢王傷，走入成皋。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-007-xiangyu:m034-0020","start":20,"end":22,"surface":"項王","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m034-0023","start":23,"end":25,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m034-0045","start":45,"end":47,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m034-0060","start":60,"end":62,"sur