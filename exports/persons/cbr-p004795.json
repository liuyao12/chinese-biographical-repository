d":"c-shiji-085-lubuwei"},{"id":"c-shiji-085-lubuwei:m011-0009","start":9,"end":12,"surface":"夏太后","kind":"person","person_id":"cbr-p004795","status":"contextual_provisional","paragraph_id":"c-shiji-085-lubuwei:p011","chapter_id":"c-shiji-085-lubuwei"},{"id":"c-shiji-085-lubuwei:m011-0033","start":33,"end":36,"surface":"夏太后","kind":"person","person_id":"cbr-p004795","status":"contextual_provisional","paragraph_id":"c-shiji-085-lubuwei:p011","chapter_id":"c-shiji-085-lubuwei"},{"id":"c-shiji-085-lubuwei:m011-0045","start":45,"end":48,"surface":"夏太后","kind":"person","person_id":"cbr-p004795","status":"contextual_provisional","paragraph_id":"c-shiji-085-lubuwei:p011","chapter_id":"c-shiji-085-lubuwei"}],"relations":[{"id":"a-shiji085-002","subject_person_id":"cbr-p004794","predicate":"mother","object_person_id":"cbr-p004795","status":"source_attested","evidence":[{"chapter_id":"c-shiji-085-lubuwei","source_id":"s-shiji-085-lubuwei","paragraph_id":"c-shiji-085-lubuwei:p002","quote":"秦昭王四十年，太子死。其四十二年，以其次子安國君為太子。安國君有子二十餘人。安國君有所甚愛姬，立以為正夫人，號曰華陽夫人。華陽夫人無子。安國君中男名子楚，子楚母曰夏姬，毋愛。子楚為秦質子於趙。秦數攻趙，趙不甚禮子楚。"}],"qualifiers":{"source_term":"子楚母曰夏姬","historicity":"historical_tradition"},"interpretation_note":"僅保存明示子母姊與婚配來源主張。子政父系先有身敘事待覆核，不新增確證父親；所母華陽與真母夏姬分存，仲父敬號不作父親。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji085-010","person_id":"cbr-p004795","title":"夏太后","kind":"royal_rank","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-085-lubuwei","source_id":"s-shiji-085-lubuwei","paragraph_id":"c-shiji-085-lubuwei:p007","quote":"秦王立一年，薨，謚為孝文王。太子子楚代立，是為莊襄王。莊襄王所母華陽后為華陽太后，真母夏姬尊以為夏太后。莊襄王元年，以呂不韋為丞相，封為文信侯，食河南洛陽十萬戶。"}],"attestations":[{"id":"th-shiji085-010:a001","paragraph_id":"c-shiji-085-lubuwei:p007","start":48,"end":51,"surface":"夏太后","person_mention_id":"c-shiji-085-lubuwei:m007-0048","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-085-lubuwei","source_id":"s-shiji-085-lubuwei","paragraph_id":"c-shiji-085-lubuwei:p007","quote":"秦王立一年，薨，謚為孝文王。太子子楚代立，是為莊襄王。莊襄王所母華陽后為華陽太后，真母夏姬尊以為夏太后。莊襄王元年，以呂不韋為丞相，封為文信侯，食河南洛陽十萬戶。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授任與文獻用稱分存，未知起訖不補造。相國明示免職不終止文信侯，飲酖死亡不推定全部官爵終點；仲父為敬號非父親。篇末嫪毐文信侯歧義不作實授。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji085-006","person_id":"cbr-p004795","surfaces":["夏太后","夏姬"],"scope":"same_chapter","chapter_ids":["c-shiji-085-lubuwei"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-085-lubuwei:p002","quote":"秦昭王四十年，太子死。其四十二年，以其次子安國君為太子。安國君有子二十餘人。安國君有所甚愛姬，立以為正夫人，號曰華陽夫人。華陽夫人無子。安國君中男名子楚，子楚母曰夏姬，毋愛。子楚為秦質子於趙。秦數攻趙，趙不甚禮子楚。"},{"paragraph_id":"c-shiji-085-lubuwei:p007","quote":"秦王立一年，薨，謚為孝文王。太子子楚代立，是為莊襄王。莊襄王所母華陽后為華陽太后，真母夏姬尊以為夏太后。莊襄王元年，以呂不韋為丞相，封為文信侯，食河南洛陽十萬戶。"},{"paragraph_id":"c-shiji-085-lubuwei:p011","quote":"始皇七年，莊襄王母夏太后薨。孝文王后曰華陽太后，與孝文王會葬壽陵。夏太后子莊襄王葬芷陽，故夏太后獨別葬杜東，曰「東望吾子，西望吾夫。後百年，旁當有萬家邑」。"}],"rationale":"依前5段子楚質趙與呂不韋游說敘事暫接；死亡太子與後立安國君分開，華陽姊與子政母各保留未名。王稱、太子及嵌套代詞待逐處核定。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-085-lubuwei:p002","text":"秦昭王四十年，太子死。其四十二年，以其次子安國君為太子。安國君有子二十餘人。安國君有所甚愛姬，立以為正夫人，號曰華陽夫人。華陽夫人無子。安國君中男名子楚，子楚母曰夏姬，毋愛。子楚為秦質子於趙。秦數攻趙，趙不甚禮子楚。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-085-lubuwei:m002-0000","start":0,"end":3,"surface":"秦昭王","kind":"person","person_id":"cbr-p004791","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m002-0007","start":7,"end":9,"surface":"太子","kind":"person","person_id":"cbr-p004797","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m002-0021","start":21,"end":24,"surface":"安國君","kind":"person","person_id":"cbr-p004792","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m002-0028","start":28,"end":31,"surface":"安國君","kind":"person","person_id":"cbr-p004792","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m002-0031","start":31,"end":37,"surface":"有子二十餘人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未能區分成員，未補姓名。"},{"id":"c-shiji-085-lubuwei:m002-0038","start":38,"end":41,"surface":"安國君","kind":"person","person_id":"cbr-p004792","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m002-0056","start":56,"end":60,"surface":"華陽夫人","kind":"person","person_id":"cbr-p004793","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m002-0061","start":61,"end":65,"surface":"華陽夫人","kind":"person","person_id":"cbr-p004793","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m002-0068","start":68,"end":71,"surface":"安國君","kind":"person","person_id":"cbr-p004792","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m002-0074","start":74,"end":76,"surface":"子楚","kind":"person","person_id":"cbr-p004794","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m002-0077","start":77,"end":79,"surface":"子楚","kind":"person","person_id":"cbr-p004794","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m002-0081","start":81,"end":83,"surface":"夏姬","kind":"person","person_id":"cbr-p004795","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m002-0087","start":87,"end":89,"surface":"子楚","kind":"person","person_id":"cbr-p004794","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m002-0105","start":105,"end":107,"surface":"子楚","kind":"person","person_id":"cbr-p004794","status":"contextual_provisional"}],"chapter_id":"c-shiji-085-lubuwei","book_id":"b-shiji-085","work_id":"w-shiji","source_id":"s-shiji-085-lubuwei"},{"id":"c-shiji-085-lubuwei:p007","text":"秦王立一年，薨，謚為孝文王。太子子楚代立，是為莊襄王。莊襄王所母華陽后為華陽太后，真母夏姬尊以為夏太后。莊襄王元年，以呂不韋為丞相，封為文信侯，食河南洛陽十萬戶。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-085-lubuwei:m007-0000","start":0,"end":2,"surface":"秦王","kind":"person","person_id":"cbr-p004792","status":"