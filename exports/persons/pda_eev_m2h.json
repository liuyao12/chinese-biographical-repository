奇物，充仞宮室。益廣沙丘苑臺，多取野獸蜚鳥置其中。慢於鬼神。大㝡樂戲於沙丘，以酒為池，縣肉為林，使男女倮相逐其閒，為長夜之飲。","mentions":[{"id":"c-shiji-003-yin:m028-0000","start":0,"end":2,"surface":"帝紂","kind":"person","person_id":"lwx_9yq_ad7","status":"source_identified"},{"id":"c-shiji-003-yin:m028-0065","start":65,"end":67,"surface":"妲己","kind":"person","person_id":"42a_nv5_urq","status":"source_identified"},{"id":"c-shiji-003-yin:m028-0068","start":68,"end":70,"surface":"妲己","kind":"person","person_id":"42a_nv5_urq","status":"source_identified"},{"id":"c-shiji-003-yin:m028-0078","start":78,"end":80,"surface":"師涓","kind":"person","person_id":"pda_eev_m2h","status":"source_identified"}],"chapter_id":"c-shiji-003-yin","book_id":"b-shiji-003","work_id":"w-shiji","source_id":"s-shiji-003-yin"}],"sources":[{"chapter_id":"c-shiji-003-yin","work_id":"w-shiji","book_id":"b-shiji-003","source_id":"s-shiji-003-yin","source":{"title":"史記／卷003","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷003","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷003&oldid=7909145","revision_id":7909145,"accessed_on":"2026-10-09","extent":"正文全文；不含現代章節標題與註號。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫 CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{"弃":"棄"},"note":"只轉換棄字字形；保留中𤳹、筑、犇等來源字形，移除現代註號。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical"}}
