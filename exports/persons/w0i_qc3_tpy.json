_id":"c-shiji-124-youxia:m014-0211","chapter_id":"c-shiji-124-youxia","paragraph_id":"c-shiji-124-youxia:p014","quote":"解"},{"mention_id":"c-shiji-124-youxia:m014-0213","chapter_id":"c-shiji-124-youxia","paragraph_id":"c-shiji-124-youxia:p014","quote":"解"},{"mention_id":"c-shiji-124-youxia:m014-0233","chapter_id":"c-shiji-124-youxia","paragraph_id":"c-shiji-124-youxia:p014","quote":"解"},{"mention_id":"c-shiji-124-youxia:m014-0248","chapter_id":"c-shiji-124-youxia","paragraph_id":"c-shiji-124-youxia:p014","quote":"解"},{"mention_id":"c-shiji-124-youxia:m014-0263","chapter_id":"c-shiji-124-youxia","paragraph_id":"c-shiji-124-youxia:p014","quote":"解"},{"mention_id":"c-shiji-124-youxia:m014-0272","chapter_id":"c-shiji-124-youxia","paragraph_id":"c-shiji-124-youxia:p014","quote":"解"},{"mention_id":"c-shiji-124-youxia:m014-0285","chapter_id":"c-shiji-124-youxia","paragraph_id":"c-shiji-124-youxia:p014","quote":"郭解翁伯"},{"mention_id":"c-shiji-124-youxia:m016-0007","chapter_id":"c-shiji-124-youxia","paragraph_id":"c-shiji-124-youxia:p016","quote":"郭解"},{"mention_id":"c-shiji-124-youxia:m017-0048","chapter_id":"c-shiji-124-youxia","paragraph_id":"c-shiji-124-youxia:p017","quote":"翁伯"}],"family_path":{"connection":"father","generation_distance":1,"parent_person_id":"5if_pf6_zos","status":"contextual_provisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-124-youxia","source_id":"s-shiji124-youxia","paragraph_id":"c-shiji-124-youxia:p009","quote":"郭解，軹人也，字翁伯，善相人者許負外孫也。解父以任俠，孝文時誅死。解為人短小精悍，不飲酒。少時陰賊，慨不快意，身所殺甚眾。以軀借交報仇，藏命作姦剽攻，不休及鑄錢掘冢，固不可勝數。適有天幸，窘急常得脫，若遇赦。及解年長，更折節為儉，以德報怨，厚施而薄望。然其自喜為俠益甚。既已振人之命，不矜其功，其陰賊著於心，卒發於睚眦如故云。而少年慕其行，亦輒為報仇，不使知也。解姊子負解之勢，與人飲，使之嚼。非其任，彊必灌之。人怒，拔刀刺殺解姊子，亡去。解姊怒曰：「以翁伯之義，人殺吾子，賊不得。」棄其尸於道，弗葬，欲以辱解。解使人微知賊處。賊窘自歸，具以實告解。解曰：「公殺之固當，吾兒不直。」遂去其賊，罪其姊子，乃收而葬之。諸公聞之，皆多解之義，益附焉。"}],"source_assertion_id":"a-shiji124-002","interpretation_note":"本篇明示父子共根，未名父親或子保持未名；分支不表示排行，母系與旁親另存。","reviewer":"Codex（AI 代理）"}},{"id":"w0i_qc3_tpy","label":"許負","status":"active","historicity":"historical_tradition","aliases":[{"surface":"許負","mention_ids":["c-shiji-049-waiqi:m007-0025","c-shiji-049-waiqi:m007-0069","c-shiji-057-zhou:m012-0013","c-shiji-057-zhou:m012-0108","c-shiji-124-youxia:m009-0015"]},{"surface":"負","mention_ids":["c-shiji-057-zhou:m012-0094"]}],"evidence":[{"mention_id":"c-shiji-049-waiqi:m007-0025","chapter_id":"c-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p007","quote":"許負"},{"mention_id":"c-shiji-049-waiqi:m007-0069","chapter_id":"c-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p007","quote":"許負"},{"mention_id":"c-shiji-057-zhou:m012-0013","chapter_id":"c-shiji-057-zhou","paragraph_id":"c-shiji-057-zhou:p012","quote":"許負"},{"mention_id":"c-shiji-057-zhou:m012-0108","chapter_id":"c-shiji-057-zhou","paragraph_id":"c-shiji-057-zhou:p012","quote":"許負"},{"mention_id":"c-shiji-057-zhou:m012-0094","chapter_id":"c-shiji-057-zhou","paragraph_id":"c-shiji-057-zhou:p012","quote":"負"},{"mention_id":"c-shiji-124-youxia:m009-0015","chapter_id":"c-shiji-124-youxia","paragraph_id":"c-shiji-124-youxia:p009","quote":"許負"}]}],"person_references":[{"id":"c-shiji-125-ningxing:m002-0182","paragraph_id":"c-shiji-125-ningxing:p002","start":182,"end":185,"surface":"善相者","person_id":"w0i_qc3_tpy","reference_type":"title_or_appellation_reference","status":"contextual_provisional","quote":"上使善相者相通，曰「當貧餓死」。","rationale":"「善相者」是本事中的職能稱指，不是姓名或許負的姓名別名。東漢王符《潛夫論》卷六〈相列第二十七〉記「許負之相鄧通條侯」，以許負為主語、鄧通與條侯為並列賓語，明載許負曾為鄧通相面；據此將本段文帝所使的相者暫定為本庫許負。此為較晚傳世記載，且《史記》與《漢書》卷九十三在本事均未具名，故保留中等信心及代理暫判。參考原文（固定修訂1380327）：https://zh.wikisource.org/w/index.php?title=潛夫論/卷六&oldid=1380327；CTP數位篇：https://ctext.org/wiki.pl?chapter=443769&if=gb","human_reviewed":false,"chapter_id":"c-shiji-125-ningxing","work_id":"w-shiji","book_id":"b-shiji-125","source_id":"s-shiji125-ningxing"}],"source_mention_summary":[{"source_id":"s-shiji-057-zhou","work_id":"w-shiji","book_id":"b-shiji-057","chapter_id":"c-shiji-057-zhou","raw_mention_count":3,"mention_ids":["c-shiji-057-zhou:m012-0013","c-shiji-057-zh