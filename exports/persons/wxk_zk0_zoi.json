nt":2,"duplicate_mention_count":0,"paragraph_occurrence_count":2,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"2處獨立位置，2個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"},{"source_id":"s-jinshu-033-wanglan-family","work_id":"w-jinshu","book_id":"b-jinshu-033","chapter_id":"c-jinshu-033-wanglan-family","raw_mention_count":1,"mention_ids":["c-jinshu-033-wanglan-family:p012:m0038"],"paragraph_ids":["c-jinshu-033-wanglan-family:p012"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-033-wanglan-family:p012:m0038","mention_ids":["c-jinshu-033-wanglan-family:p012:m0038"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-040-ws2606035-jiachong-family"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"id":"nc-jin040-jiachong-012","person_id":"wxk_zk0_zoi","surname":"鄭","ming":"沖","additional_names":[],"chapter_id":"c-jinshu-040-jiachong-family","paragraph_id":"c-jinshu-040-jiachong-family:p006","person_mention_id":"c-jinshu-040-jiachong-family:p006:m0109","quote":"充所定新律既班於天下，百姓便之。詔曰：「漢氏以來，法令嚴峻。故自元成之世，及建安、嘉平之間，咸欲辯章舊典，刪革刑書。述作體大，歷年無成。先帝湣元元之命陷於密網，親發德音，厘正名實。車騎將軍賈充，獎明聖意，諮詢善道。太傅鄭沖，又與司空荀顗、中書監荀勖、中軍將軍羊祜、中護軍王業，及廷尉杜友、守河南尹杜預、散騎侍郎裴楷、潁川太守周雄、齊相郭頎、騎都尉成公綏荀煇、尚書郎柳軌等，典正其事。朕每鑒其用心，常慨然嘉之。今法律既成，始班天下，刑寬禁簡，足以克當先旨。昔蕭何以定律受封，叔孫通以制儀爲奉常，賜金五百斤，弟子皆爲郎。夫立功立事，古之所重。自太傅、車騎以下，皆加祿賞。其詳依故典。」於是賜充子弟一人關內侯，絹五百匹。固讓，不許。","status":"editorial_provisional","human_reviewed":false,"model":null,"note":"本源所見稱名；按中古姓氏用法分讀，保原字及逐名錨，不作全庫權威選字。","fixed_biography_name_binding":{"kind":"fixed_punctuated_biography_name","source_revision":2606035,"paragraph_sha256":"6faee687c2927679db69d22007fb944b99e4288f690e5a1ded0ef17e701c4498","mode":"full_name","name_mention_id":"c-jinshu-040-jiachong-family:p006:m0109","zi_mention_id":null,"alias_bindings":[],"title_prefix":null,"title_suffix":null},"work_id":"w-jinshu","book_id":"b-jinshu-040","source_id":"s-jinshu-040-ws2606035-jiachong-family"}],"mentions":[{"id":"c-jinshu-033-wanglan-family:p012:m0038","start":38,"end":40,"surface":"鄭沖","kind":"person","person_id":"wxk_zk0_zoi","status":"contextual_provisional","interpretation_note":"按本段敘事、稱謂與引語身份辨識；不由同名自動合併。","paragraph_id":"c-jinshu-033-wanglan-family:p012","chapter_id":"c-jinshu-033-wanglan-family"},{"id":"c-jinshu-040-jiachong-family:p006:m0107","kind":"person","person_id":"wxk_zk0_zoi","surface":"太傅","start":107,"end":109,"status":"contextual_provisional","resolution_note":"依本傳完整敘事與本段角色辨識；逐人理由另存身份閱讀記錄。","paragraph_id":"c-jinshu-040-jiachong-family:p006","chapter_id":"c-jinshu-040-jiachong-family"},{"id":"c-jinshu-040-jiachong-family:p006:m0109","kind":"person","person_id":"wxk_zk0_zoi","surface":"鄭沖","start":109,"end":111,"status":"contextual_provisional","resolution_note":"依本傳完整敘事與本段角色辨識；逐人理由另存身份閱讀記錄。","paragraph_id":"c-jinshu-040-jiachong-family:p006","chapter_id":"c-jinshu-040-jiachong-family"},{"id":"c-jinshu-040-jiachong-family:p006:m0270","kind":"person","person_id":"wxk_zk0_zoi","surface":"太傅","start":270,"end":272,"status":"contextual_provisional","resolution_note":"依本傳完整敘事與本段角色辨識；逐人理由另存身份閱讀記錄。","paragraph_id":"c-jinshu-040-jiachong-famil