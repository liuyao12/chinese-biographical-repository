38","chapter_id":"c-jinshu-038-langye-near-family","source_id":"s-jinshu-038-langye-near-family","paragraph_id":"c-jinshu-038-langye-near-family:line012","quote":"宣帝九男，穆張皇后生景帝、文帝、平原王幹，伏夫人生汝南文成王亮、琅邪武王伷、清惠亭侯京、扶風武王駿，張夫人生梁王肜，柏夫人生趙王倫。亮及倫別有傳。","person_mention_id":"c-jinshu-038-langye-near-family:line012:m0064"}],"attestations":[{"id":"th-jinshu038-family-007:a001","paragraph_id":"c-jinshu-038-langye-near-family:line012","start":62,"end":64,"surface":"趙王","person_mention_id":"c-jinshu-038-langye-near-family:line012:m0064","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本處原稱用例；不以生子清單或篇末敘事補授號、追諡日期。婦人氏稱不單獨證明正式婚姻。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-phase5-037-倫","person_id":"dkn_ge4_286_AAAAG","surfaces":["趙王倫"],"scope":"same_chapter","chapter_ids":["c-jinshu-037-phase5-pengcheng"],"status":"contextual_provisional","confidence_level":"moderate","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-037","source_id":"s-jinshu-037-phase5","chapter_id":"c-jinshu-037-phase5-pengcheng","paragraph_id":"c-jinshu-037-phase5-pengcheng:line100","quote":"彭城穆王權，字子輿，宣帝弟魏魯相東武城侯馗之子也。初襲封，拜冗從僕射。武帝受禪，封彭城王，邑二千九百戶。出為北中郎將、都督鄴城守諸軍事。泰始中入朝，賜袞冕之服。咸甯元年薨，子元王植立。歷位後將軍，尋拜國子祭酒、太僕卿、侍中、尚書。出為安東將軍、都督揚州諸軍事，代淮南王允鎮壽春，未發。或云植助允攻趙王倫，遂以憂薨。贈車騎將軍，增封萬五千戶。子康王釋立，官至南中郎將、持節、平南將軍，分魯國蕃、薛二縣以益其國，心二萬三千戶。薨，子雄立，坐奔蘇峻伏誅，更以釋子紘嗣。","person_mention_id":"c-jinshu-037-phase5-pengcheng:line100:m0148"}],"rationale":"依完整同段主語、親屬及事件辨識短稱；已有人物須同一蘇峻亂、彭城王系或相同君主脈絡，不以同名合併。馗、權、植、釋的局部父系獨立於馗接防的跨篇推論。","references":[],"reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-037-phase5-pengcheng:line100","text":"彭城穆王權，字子輿，宣帝弟魏魯相東武城侯馗之子也。初襲封，拜冗從僕射。武帝受禪，封彭城王，邑二千九百戶。出為北中郎將、都督鄴城守諸軍事。泰始中入朝，賜袞冕之服。咸甯元年薨，子元王植立。歷位後將軍，尋拜國子祭酒、太僕卿、侍中、尚書。出為安東將軍、都督揚州諸軍事，代淮南王允鎮壽春，未發。或云植助允攻趙王倫，遂以憂薨。贈車騎將軍，增封萬五千戶。子康王釋立，官至南中郎將、持節、平南將軍，分魯國蕃、薛二縣以益其國，心二萬三千戶。薨，子雄立，坐奔蘇峻伏誅，更以釋子紘嗣。","mentions":[{"id":"c-jinshu-037-phase5-pengcheng:line100:m0000","start":0,"end":5,"surface":"彭城穆王權","kind":"person","person_id":"dkn_ge4_286_AAADA"},{"id":"c-jinshu-037-phase5-pengcheng:line100:m0007","start":7,"end":9,"surface":"子輿","kind":"person","person_id":"dkn_ge4_286_AAADA"},{"id":"c-jinshu-037-phase5-pengcheng:line100:m0010","start":10,"end":12,"surface":"宣帝","kind":"person","person_id":"dkn_ge4_286_AAAA"},{"id":"c-jinshu-037-phase5-pengcheng:line100:m0020","start":20,"end":21,"surface":"馗","kind":"person","person_id":"dkn_ge4_286_AAAD"},{"id":"c-jinshu-037-phase5-pengcheng:line100:m0035","start":35,"end":37,"surface":"武帝","kind":"person","person_id":"hgm_jvn_hle"},{"id":"c-jinshu-037-phase5-pengcheng:line100:m0087","start":87,"end":90,"surface":"元王植","kind":"person","person_id":"dkn_ge4_286_AAADAA"},{"id":"c-jinshu-037-phase5-pengcheng:line100:m0131","start":131,"end":135,"surface":"淮南王允","kind":"person","person_id":"3ab_c04_e8d"},{"id":"c-jinshu-037-phase5-pengcheng:line100:m0142","start":142,"end":143,"surface":"或","kind":"unresolved","person_id":null,"status":"unresolved","resolution_note":"未名記述者；或云為來源限定詞，不定成具名作者。"},{"id":"c-jinshu-037-phase5-pengcheng:line100:m0144","start":144,"end":145,"surface":"植","kind":"person","person_id":"dkn_ge4_286_AAADAA"},{"id":"c-jinshu-037-phase5-pengcheng:line100:m0146","start":146,"end":147,"surface":"允","kind":"person","person_id":"3ab_c04_e8d"},{"id":"c-jinshu-037-phase5-pengcheng:line100:m0148","start":148,"end":151,"surface":"趙王倫","kind":"person","person_id":"dkn_ge4_286_AAAAG"},{"id":"c-jinshu-037-phase5-pengcheng:line100:m0171","start":171,"end":174,"surface":"康王釋","kind":"person","person_id":"dkn_ge4_286_AAADAAA"},{"id":"c-jinshu-037-phase5-pengcheng:line100:m0201","start":201,"end":202,"surface":"其","ki