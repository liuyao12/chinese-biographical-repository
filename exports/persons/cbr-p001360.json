,"end":45,"surface":"騎劫","kind":"person","person_id":"ez6_e2l_0ml","status":"contextual_provisional","paragraph_id":"c-shiji-034-yan:p027","chapter_id":"c-shiji-034-yan"},{"id":"c-shiji-080-leyi:m004-0151","start":151,"end":153,"surface":"騎劫","kind":"person","person_id":"8w9_7hx_mgb","status":"contextual_provisional","paragraph_id":"c-shiji-080-leyi:p004","chapter_id":"c-shiji-080-leyi"},{"id":"c-shiji-080-leyi:m005-0005","start":5,"end":7,"surface":"騎劫","kind":"person","person_id":"8w9_7hx_mgb","status":"contextual_provisional","paragraph_id":"c-shiji-080-leyi:p005","chapter_id":"c-shiji-080-leyi"},{"id":"c-shiji-080-leyi:m005-0018","start":18,"end":20,"surface":"騎劫","kind":"person","person_id":"8w9_7hx_mgb","status":"contextual_provisional","paragraph_id":"c-shiji-080-leyi:p005","chapter_id":"c-shiji-080-leyi"},{"id":"c-shiji-080-leyi:m006-0006","start":6,"end":8,"surface":"騎劫","kind":"person","person_id":"8w9_7hx_mgb","status":"contextual_provisional","paragraph_id":"c-shiji-080-leyi:p006","chapter_id":"c-shiji-080-leyi"},{"id":"c-shiji-080-leyi:m006-0125","start":125,"end":127,"surface":"騎劫","kind":"person","person_id":"8w9_7hx_mgb","status":"contextual_provisional","paragraph_id":"c-shiji-080-leyi:p006","chapter_id":"c-shiji-080-leyi"},{"id":"c-shiji-082-tiandan:m002-0114","start":114,"end":116,"surface":"騎劫","kind":"person","person_id":"sdm_4q5_qkw","status":"contextual_provisional","paragraph_id":"c-shiji-082-tiandan:p002","chapter_id":"c-shiji-082-tiandan"},{"id":"c-shiji-082-tiandan:m005-0146","start":146,"end":148,"surface":"騎劫","kind":"person","person_id":"sdm_4q5_qkw","status":"contextual_provisional","paragraph_id":"c-shiji-082-tiandan:p005","chapter_id":"c-shiji-082-tiandan"}],"relations":[],"title_holdings":[{"id":"th-shiji034-050","person_id":"ez6_e2l_0ml","title":"將","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-034-yan","source_id":"s-shiji-034-yan","paragraph_id":"c-shiji-034-yan:p027","quote":"惠王為太子時，與樂毅有隙；及即位，疑毅，使騎劫代將。"}],"attestations":[{"id":"th-shiji034-050:a001","paragraph_id":"c-shiji-034-yan:p027","start":24,"end":25,"surface":"將","person_mention_id":"c-shiji-034-yan:m027-0021","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-034-yan","source_id":"s-shiji-034-yan","paragraph_id":"c-shiji-034-yan:p027","quote":"惠王為太子時，與樂毅有隙；及即位，疑毅，使騎劫代將。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"使騎劫代將的明示任事，原字將不擅擴為上將軍；任命曆日及終點不由即位／卒記事補造。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji080-008","person_id":"8w9_7hx_mgb","title":"將","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-080-leyi","source_id":"s-shiji-080-leyi","paragraph_id":"c-shiji-080-leyi:p004","quote":"樂毅留徇齊五歲，下齊七十餘城，皆為郡縣以屬燕，唯獨莒、即墨未服。會燕昭王死，子立為燕惠王。惠王自為太子時嘗不快於樂毅，及即位，齊之田單聞之，乃縱反閒於燕，曰：「齊城不下者兩城耳。然所以不早拔者，聞樂毅與燕新王有隙，欲連兵且留齊，南面而王齊。齊之所患，唯恐他將之來。」於是燕惠王固已疑樂毅，得齊反閒，乃使騎劫代將，而召樂毅。樂毅知燕惠王之不善代之，畏誅，遂西降趙。趙封樂毅於觀津，號曰望諸君。尊寵樂毅以警動於燕、齊。"}],"attestations":[{"id":"th-shiji080-008:a001","paragraph_id":"c-shiji-080-leyi:p004","start":154,"end":155,"surface":"將","person_mention_id":"c-shiji-080-leyi:m004-0151","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-080-leyi","source_id":"s-shiji-080-leyi","paragraph_id":"c-shiji-080-leyi:p004","quote":"樂毅留徇齊五歲，下齊七十餘城，皆為郡縣以屬燕，唯獨莒、即墨未服。會燕昭王死，子立為燕惠王。惠王自為太子時嘗不快於樂毅，及即位，齊之田單聞之，乃縱反閒於燕，曰：「齊城不下者兩城耳。然所以不早拔者，聞樂毅與燕新王有隙，欲連兵且留齊，南面而王齊。齊之所患，唯恐他將之來。」於是燕惠王固已疑樂毅，得齊反閒，乃使騎劫代將，而召樂毅。樂毅知燕惠王之不善代之，畏誅，遂西降趙。趙封樂毅於觀津，號曰望諸君。尊寵樂毅以警動於燕、齊。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授任與文獻用稱分存；卒、出走及降趙不自動終止所有爵位，未見日期保持未定。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji034-104","person_id":"ez6_e2l_0ml","surfaces":["騎劫"],"scope":"same_chapter","chapter_ids":["c-shiji-034-yan"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-034-yan:p027","quote":"惠王為太子時，與樂毅有隙；及即位，疑毅，使騎劫代將。樂毅亡走趙。齊田單以即墨擊敗燕軍，騎劫死，燕兵引歸，齊悉復得其故城。閔王死于莒，乃立其子為襄王。"}],"rationale":"依周初封建、燕君世系、割地救燕、讓國及秦滅諸國的具體語境暫定異稱。繼位不自動證父子；同爵者分國別與前後世代。太子平／燕昭王依本篇明示，不表示年代及世系已校定。作君奭為書名，君奭不説之君奭才暫解召公稱呼。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji080-016","person_id":"8w9_7hx_mgb","scope":"same_chapter","chapter_ids":["c-shiji-080-leyi"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["騎劫"],"evidence":[{"paragraph_id":"c-shiji-080-leyi:p004","quote":"樂毅留徇齊五歲，下齊七十餘城，皆為郡縣以屬燕，唯獨莒、即墨未服。會燕昭王死，子立為燕惠王。惠王自為太子時嘗不快於樂毅，及即位，齊之田單聞之，乃縱反閒於燕，曰：「齊城不下者兩城耳。然所以不早拔者，聞樂毅與燕新王有隙，欲連兵且留齊，南面而王齊。齊之所患，唯恐他將之來。」於是燕惠王固已疑樂毅，得齊反閒，乃使騎劫代將，而召樂毅。樂毅知燕惠王之不善代之，畏誅，遂西降趙。趙封樂毅於觀津，號曰望諸君。尊寵樂毅以警動於燕、齊。"},{"paragraph_id":"c-shiji-080-leyi:p005","quote":"齊田單後與騎劫戰，果設詐誑燕軍，遂破騎劫於即墨下，而轉戰逐燕，北至河上，盡復得齊城，而迎襄王於莒，入于臨菑。"},{"paragraph_id":"c-shiji-080-leyi:p006","quote":"燕惠王後悔使騎劫代樂毅，以故破軍亡將失齊；又怨樂毅之降趙，恐趙用樂毅而乘燕之獘以伐燕。燕惠王乃使人讓樂毅，且謝之曰：「先王舉國而委將軍，將軍為燕破齊，報先王之讎，天下莫不震動，寡人豈敢一日而忘將軍之功哉！會先王棄群臣，寡人新即位，左右誤寡人。寡人之使騎劫代將軍，為將軍久暴露於外，故召將軍且休，計事。將軍過聽，以與寡人有隙，遂捐燕歸趙。將軍自為計則可矣，而亦何以報先王之所以遇將軍之意乎？」樂毅報遺燕惠王書曰："}],"rationale":"樂閒明示為樂毅子，樂叔明示為孫，不補闕代父親；樂乘為樂閒宗不補兄弟。燕王喜來書及趙襄王君序各限本段，曹相國未見名字不回填。河上丈人至蓋公師承不作父子。依本篇明示姓名、君序與來書答書範圍暫接；燕惠王來書寡人指惠王、將軍指樂毅，樂毅答書先王指昭王、足下君王指惠王。伍子胥引古首吳王指闔閭，後吳王在夫差賜鴟夷後指夫差。父兄與群臣不補具體親屬，王齊為反間假說不作授王爵。"},{"id":"d-shiji082-009","person_id":"sdm_4q5_qkw","surfaces":["騎劫"],"scope":"same_chapter","chapter_ids":["c-shiji-082-tiandan"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-082-tiandan:p002","quote":"頃之，燕昭王卒，惠王立，與樂毅有隙。田單聞之，乃縱反閒於燕，宣言曰：「齊王已死，城之不拔者二耳。樂毅畏誅而不敢歸，以伐齊為名，實欲連兵南面而王齊。齊人未附，故且緩攻即墨以待其事。齊人所懼，唯恐他將之來，即墨殘矣。」燕王以為然，使騎劫代樂毅。"},{"paragraph_id":"c-shiji-082-tiandan:p005","quote":"田單乃收城中得千餘牛，為絳繒衣，畫以五彩龍文，束兵刃於其角，而灌脂束葦於尾，燒其端。鑿城數十穴，夜縱牛，壯士五千人隨其後。牛尾熱，怒而奔燕軍，燕軍夜大驚。牛尾炬火光明炫燿，燕軍視之皆龍文，所觸盡死傷。五千人因銜枚擊之，而城中鼓譟從之，老弱皆擊銅器為聲，聲動天地。燕軍大駭，敗走。齊人遂夷殺其將騎劫。燕軍擾亂奔走，齊人追亡逐北，所過城邑皆畔燕而歸田單，兵日益多，乘勝，燕日敗亡，卒至河上，而齊七十餘城皆復為齊。乃迎襄王於莒，入臨菑而聽政。"}],"rationale":"依9段明示姓名、君序與復齊事件暫接；法章立齊王與襄王迎莒、末段立襄王依同一復國敘事接。嬓女太史氏女君王后按明示，嬓與女先處完整稱謂。假神師是未名卒、臣其自稱，君指田單；燕將未名不盲接騎劫，宗族不補父母。誘王蠋授將被固謝，不當實授。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji080-qi","person_ids":["ez6_e2l_0ml","8w9_7hx_mgb"],"canonical_person_id":"ez6_e2l_0ml","scope":"cross_chapter","chapter_ids":["c-shiji-034-yan","c-shiji-080-leyi"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-034-yan","source_id":"s-shiji-034-yan","paragraph_id":"c-shiji-034-yan:p027","quote":"惠王為太子時，與樂毅有隙；及即位，疑毅，使騎劫代將。樂毅亡走趙。齊田單以即墨擊敗燕軍，騎劫死，燕兵引歸，齊悉復得其故城。閔王死于莒，乃立其子為襄王。","mention_ids":["c-shiji-034-yan:m027-0021","c-shiji-034-yan:m027-0043"]},{"chapter_id":"c-shiji-080-leyi","source_id":"s-shiji-080-leyi","paragraph_id":"c-shiji-080-leyi:p005","quote":"齊田單後與騎劫戰，果設詐誑燕軍，遂破騎劫於即墨下，而轉戰逐燕，北至河上，盡復得齊城，而迎襄王於莒，入于臨菑。","mention_ids":["c-shiji-080-leyi:m005-0005","c-shiji-080-leyi:m005-0018"]}],"rationale":"兩篇騎劫代樂毅而被田單於即墨擊敗，姓名、代將前任及戰事相配；死與破軍細節按原篇保存。 各篇原字、原文與已發ID保留，同書不視為獨立見證；同指不確證所有紀年、任職、親屬或敘事，不按全域同名批量改號。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"eq-shiji082-qi","person_ids":["ez6_e2l_0ml","8w9_7hx_mgb","sdm_4q5_qkw"],"canonical_person_id":"ez6_e2l_0ml","scope":"cross_chapter","chapter_ids":["c-shiji-034-yan","c-shiji-080-leyi","c-shiji-082-tiandan"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-034-yan","source_id":"s-shiji-034-yan","paragraph_id":"c-shiji-034-yan:p027","quote":"惠王為太子時，與樂毅有隙；及即位，疑毅，使騎劫代將。樂毅亡走趙。齊田單以即墨擊敗燕軍，騎劫死，燕兵引歸，齊悉復得其故城。閔王死于莒，乃立其子為襄王。","mention_ids":["c-shiji-034-yan:m027-0021","c-shiji-034-yan:m027-0043"]},{"chapter_id":"c-shiji-080-leyi","source_id":"s-shiji-080-leyi","paragraph_id":"c-shiji-080-leyi:p005","quote":"齊田單後與騎劫戰，果設詐誑燕軍，遂破騎劫於即墨下，而轉戰逐燕，北至河上，盡復得齊城，而迎襄王於莒，入于臨菑。","mention_ids":["c-shiji-080-leyi:m005-0005","c-shiji-080-leyi:m005-0018"]},{"chapter_id":"c-shiji-082-tiandan","source_id":"s-shiji-082-tiandan","paragraph_id"