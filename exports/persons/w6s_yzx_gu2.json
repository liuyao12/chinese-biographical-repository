assage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-sanguozhi-054-lvmeng"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-sanguozhi-054-lvmeng:line073:reading-000-154","kind":"received_sentence","paragraph_id":"c-sanguozhi-054-lvmeng:line073","start_codepoint":0,"end_codepoint":154,"source_quote":"玄之見普，具宣蒙意，普懼而聽之。玄之先出報蒙：「普尋後當至。」蒙豫敕四將，各選百人，普出，便入守城門。須臾普出，蒙迎執其手，與俱下船。語畢，出書示之。因拊手大笑。普見書，知備在公安，而羽在益陽，慚恨入地。蒙留（孫河），委以後事，即日引軍赴益陽。劉備請盟，權乃歸普等。割湘水，以零陵還之。以尋陽、陽新為蒙奉邑。","person_id":"w6s_yzx_gu2","related_person_ids":["t5o_ymn_5ke","ibt_i7u_ykp","5f2_396_25c","1c2_03c_9ea","uqm_12h_3at","572_278_cba"],"reading":"郝普受勸後見書，得知劉備、關羽實際所在。蒙留孫河委後事，較早死於宛陵的孫河字伯海不能逕合，數位括注與殿本異。","chapter_id":"c-sanguozhi-054-lvmeng","source_id":"s-sanguozhi-054-lvmeng"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-054-appraisal:line089:m0074","start":74,"end":76,"surface":"郝普","kind":"person","person_id":"w6s_yzx_gu2","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-054-appraisal:line089","chapter_id":"c-sanguozhi-054-appraisal"},{"id":"c-sanguozhi-054-lvmeng:line070:m0047","start":47,"end":49,"surface":"郝普","kind":"person","person_id":"w6s_yzx_gu2","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-054-lvmeng:line