59,11060,11061,11062,11063,11064,11065,11066,11067,11068,11069,11070,11071,11072,11073,11074,11075,11076,11077,11078,11079,11080,11081,11082,11083,11084,11085,11086,11087,11088,11089,11090,11091,11092,11093,11094,11095,11096,11097,11098,11099,11100,11101,11102,11103,11104,11105,11106,11107,11108,11109,11110,11111,11112,11113,11114,11115,11116,11117,11118,11119,11120,11121,11122,11123,11124,11125,11126,11127,11128,11129,11130,11131,11132,11133,11134,11135,11136,11137,11138,11139,11140,11141,11142,11143,11144,11145,11146,11147,11148,11149,11150,11151,11152,11153,11154,11155,11156,11157,11158,11159,11160,11161,11162,11163,11164,11165,11166,11167,11168,11169,11170,11171,11172,11173,11174,11175,11176,11177,11178,11179,11180,11181,11182,11183,11184,11185,11186,11187,11188,11189,11190,11191,11192,11193,11194,11195,11196,11197,11198,11199,11200,11201,11202,11203,11204,11205,11206]},"chapter_id":"c-sanguozhi-054-lvmeng","book_id":"b-sanguozhi-054","work_id":"w-sanguozhi","source_id":"s-sanguozhi-054-lvmeng"},{"id":"c-sanguozhi-054-lvmeng:line071","text":"郝子太聞世間有忠義事，亦欲為之，而不知時也。左將軍在漢中，為夏侯淵所圍。關羽在南郡，今至尊身自臨之。近者破樊本屯，救酃，逆為孫規所破。此皆目前之事，君所親見也。彼方首尾倒懸，救死不給，豈有餘力復營此哉？今吾士卒精銳，人思致命。至尊遣兵，相繼於道。今子太以旦夕之命，待不可望之救。猶牛蹄中魚，冀賴江漢，其不可恃亦明矣。若子太必能一士卒之心，保孤城之守，尚能稽延旦夕，以待所歸者，可也。今吾計力度慮，而以攻此，曾不移日，而城必破，城破之後，身死何益於事，而令百歲老母，戴白受誅，豈不痛哉？度此家不得外問，謂援可恃，故至於此耳。君可見之，為陳禍福。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-054-lvmeng:line071:m0000","start":0,"end":3,"surface":"郝子太","kind":"person","person_id":"w6s_yzx_gu2","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-lvmeng:line071:m0022","start":22,"end":25,"surface":"左將軍","kind":"person","person_id":"5f2_396_25c","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-lvmeng:line071:m0030","start":30,"end":33,"surface":"夏侯淵","kind":"person","person_id":"2lq_s75_r7d","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-lvmeng:line071: