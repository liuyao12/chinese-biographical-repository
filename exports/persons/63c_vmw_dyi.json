ns":[],"sources":[{"chapter_id":"c-nanqishu-043-xieyue","work_id":"w-nanqishu","book_id":"b-nanqishu-043","source_id":"s-nanqishu043-ws2400356","source_ref":"corpus/nanqishu/043-xieyue.json"}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true},"passage_refs":[{"chapter":"corpus/nanqishu/043-xieyue.json","id":"c-nanqishu-043-xieyue:p003"}]}
