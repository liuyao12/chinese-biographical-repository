[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-nanqi043-xieyue-guiyang","person_id":"63c_vmw_dyi","surfaces":["桂陽王"],"scope":"same_chapter","chapter_ids":["c-nanqishu-043-xieyue"],"status":"contextual_provisional","evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-043","chapter_id":"c-nanqishu-043-xieyue","source_id":"s-nanqishu043-ws2400356","paragraph_id":"c-nanqishu-043-xieyue:p003","quote":"解褐車騎行參軍，遷祕書郎，司徒祭酒，丹陽丞，撫軍功曹。世祖爲中軍，引爲記室。齊臺建，遷太子中舍人。建元初，轉桂陽王友。以母老須養，出爲安成內史。還爲中書郎。衞軍王儉引爲長史，雅相禮遇。除黃門郎，兼掌吏部。尋轉太子中庶子，領驍騎將軍，轉長兼侍中。𤅢以晨昏有廢，固辭不受。世祖勑令速拜，別停朝直。"}],"rationale":"本書建元初桂陽王友所事齊朝桂陽王；固定齊035明桂陽王鑠字宣朗太祖第八子，與另傳鄱陽王鏘分明，亦非宋桂陽王休範。正文只標桂陽王，不增鑠字。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null,"external_reference_readings":[{"raw_path":"source-evidence/nanqi043-xieyue-reading/external/nanqi035-fixed.wikitext","metadata_path":"source-evidence/nanqi043-xieyue-reading/external/nanqi035-metadata.json","revision_id":2401782,"raw_sha256":"2c4a8a948c856f9465afe3cfbf503cd4ebc9037abf8a5ef73a1957b91ee6dcbf","read_segments":[{"first_line":49,"last_line":49,"raw_start":3705,"raw_end":3974,"raw_quote":"桂陽王鑠，字宣朗，太祖第八子也。永明二年，出為南徐州刺史，鎮京口。歷代鎮府，鑠出蕃，始省軍府。四年，加散騎常侍。六年，遷中書令，度支尚書。七年，轉中書令，加散騎常侍。時鄱陽王鏘好文章，鑠好名理，時人稱為「鄱桂。」十年，遷太常，常侍如故。鑠清羸有冷疾，常枕臥。世祖臨視，賜床帳衾褥。{{YL|隆昌元年}}，加前將軍。給油絡車，並給扶侍二人。海陵立，轉侍中、撫軍將軍，領兵置佐。鄱陽王見害，鑠遷中軍將軍，開府儀同三司。鑠不自安，至東府詣高宗還， 謂左右曰：「向錄公見接殷勤，流連不能已，而貌有慚色，此必欲殺我。」三更中，兵至見害。時年二十五。"}],"scope":"桂陽王鑠完整本傳，區別鄱陽王鏘。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-022-hong-opening-rendered:p001","text":"臨川靖惠王宏字宣達，太祖第六子也。長八尺，美鬚眉，容止可觀。齊永明十年，爲衛軍廬陵王法曹行參軍，遷太子舍人。時長沙王懿鎮梁州，爲魏所圍，明年，給宏精兵千人赴援，未至，魏軍退。遷驃騎晉安王主簿，尋爲北中郎桂陽王功曹史。衡陽王暢，有美名，爲始安王蕭遙光所禮。及遙光作亂，逼暢入東府，暢懼禍，先赴臺。高祖在雍州，常懼諸弟及禍，謂南平王偉曰：「六弟明於事理，必先還臺。」及信至，果如高祖策。","text_sha256":"ff53a5c711a1ae33c0f731a51f828facdd93c709e95fda1310cbc469772c64ca","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","source_position":{"editorial_excerpt_boundary":true,"first_line":133,"last_line":133,"revision_id":null},"mentions":[{"id":"c-liangshu-022-hong-opening-rendered:p001:m0001","kind":"person","start":0,"end":6,"surface":"臨川靖惠王宏","person_id":"cav_2xc_9bq_AC","status":"contextual_provisional","source_role":"hong"},{"id":"c-liangshu-022-hong-opening-rendered:p001:m0002","kind":"person","start":7,"end":9,"surface":"宣達","person_id":"cav_2xc_9bq_AC","status":"contextual_provisional","source_role":"hong_zi"},{"id":"c-liangshu-022-hong-opening-rendered:p001:m0003","kind":"person","start":10,"end":12,"surface":"太祖","person_id":"cav_2xc_9bq_A","status":"contextual_provisional","source_role":"shunzhi"},{"id":"c-liangshu-022-hong-opening-rendered:p001:m0004","kind":"person","start":39,"end":42,"surface":"廬陵王","person_id":"kix_r92_2ed_A","status":"contextual_provisional","source_role":"luling"},{"id":"c-liangshu-022-hong-opening-rendered:p001:m0005","kind":"person","start":55,"end":59,"surface":"長沙王懿","person_id":"cav_2xc_9bq_AD","status":"contextual_provisional","source_role":"yi"},{"id":"c-liangshu-022-hong-opening-rendered:p001:m0006","kind":"person","start":72,"end":73,"surface":"宏","person_id":"cav_2xc_9bq_AC","status":"contextual_provisional","source_role":"hong"},{"id":"c-liangshu-022-hong-opening-rendered:p001:m0007","kind":"unresolved","start":90,"end":93,"surface":"晉安王","person_id":null,"status":"unresolved","source_role":"jinan","resolution_note":"人物官府稱謂可確認，跨篇本名未定：子懋本傳無驃騎、寶義受號在遙光誅後，與此段表面時序有張力；不憑王號選人或捏倒敘。"},{"id":"c-liangshu-022-hong-opening-rendered:p001:m0008","kind":"person","start":101,"end":104,"surface":"桂陽王","person_id":"63c_vmw_dyi","status":"contextual_provisional","source_role":"guiyang"},{"id":"c-liangshu-022-hong-opening-rendered:p001:m0009","kind":"person","start":108,"end":112,"surface":"衡陽王暢","person_id":"cav_2xc_9bq_AE","status":"contextual_provisional","source_role":"chang"},{"id":"c-liangshu-022-hong-opening-rendered:p001:m0010","kind":"person","s