17,"end":119,"surface":"厲公","kind":"person","person_id":"muq_yy8_8er_B","status":"contextual_provisional"}],"chapter_id":"c-shiji-042-zheng","book_id":"b-shiji-042","work_id":"w-shiji","source_id":"s-shiji-042-zheng"},{"id":"c-shiji-042-zheng:p009","text":"厲公四年，祭仲專國政。厲公患之，陰使其婿雍糾欲殺祭仲。糾妻，祭仲女也，知之，謂其母曰：「父與夫孰親？」母曰：「父一而已，人盡夫也。」女乃告祭仲，祭仲反殺雍糾，戮之於市。厲公無柰祭仲何，怒糾曰：「謀及婦人，死固宜哉！」夏，厲公出居邊邑櫟。祭仲迎昭公忽，六月乙亥，復入鄭，卽位。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-042-zheng:m009-0000","start":0,"end":2,"surface":"厲公","kind":"person","person_id":"muq_yy8_8er_B","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m009-0005","start":5,"end":7,"surface":"祭仲","kind":"person","person_id":"63x_7fc_69z","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m009-0011","start":11,"end":13,"surface":"厲公","kind":"person","person_id":"muq_yy8_8er_B","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m009-0018","start":18,"end":20,"surface":"其婿","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名、群體、泛稱或指代待核；不補姓名、成員或親屬關係。"},{"id":"c-shiji-042-zheng:m009-0020","start":20,"end":22,"surface":"雍糾","kind":"person","person_id":"mdf_bwd_v6b","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m009-0024","start":24,"end":26,"surface":"祭仲","kind":"person","person_id":"63x_7fc_69z","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m009-0027","start":27,"end":28,"surface":"糾","kind":"person","person_id":"mdf_bwd_v6b","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m009-0030","start":30,"end":32,"surface":"祭仲","kind":"person","person_id":"63x_7fc_69z","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m009-0039","start":39,"end":41,"surface":"其母","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名、群體、泛稱或指代待核；不補姓名、成員或親屬關係。"},{"id":"c-shiji-042-zheng:m009-0051","start":51,"end":53,"surface":"母曰","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名、群體、泛稱或指代待核；不補姓名、成員或親屬關係。"},{"id":"c-shiji-042-zheng:m009-0066","start":66,"end":68,"surface":"女乃","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名、群體、泛稱或指代待核；不補姓名、成員或親屬關係。"},{"id":"c-shiji-042-zheng:m009-0069","start":69,"end":71,"surface":"祭仲","kind":"person","person_id":"63x_7fc_69z","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m009-0072","start":72,"end":74,"surface":"祭仲","kind":"person","person_id":"63x_7fc_69z","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m009-0076","start":76,"end":78,"surface":"雍糾","kind":"person","person_id":"mdf_bwd_v6b","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m009-0084","start":84,"end":86,"surface":"厲公","kind":"person","person_id":"muq_yy8_8er_B","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m009-0088","start":88,"end":90,"surface":"祭仲","kind":"person","person_id":"63x_7fc_69z","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m009-0093","start":93,"end":94,"surface":"糾","kind":"person","person_id":"mdf_bwd_v6b","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m009-0099","start":99,"end":101,"surface":"婦人","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名、群體、泛稱或指代待核；不補姓名、成員或親屬關係。"},{"id":"c-shiji-042-zheng:m009-0110","start":110,"end":112,"surface":"厲公","kind":"person","person_id":"muq_yy8_8er_B","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m009-0118","start":118,"end":120,"surface":"祭仲","kind":"person","person_id":"63x_7fc_69z","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m009-0121","start":121,"end":124,"surface":"昭公忽","kind":"person","person_id":"muq_yy8_8er_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-042-zheng","book_id":"b-shiji-042","work_id":"w-shiji","source_id":"s-shiji-042-zheng"},{"id":"c-shiji-042-zheng:p011","text":"昭公二年，自昭公爲太子時，父莊公欲以髙渠彌爲卿，太子忽惡之，莊公弗聽，卒用渠彌爲卿。及昭公卽位，懼其殺己，冬十月辛卯，渠彌與昭公出獵，射殺昭公於野。祭仲與渠彌不敢入厲公，乃更立昭公弟子亹爲君，是爲子亹也，無謚號。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-042-zheng:m011-0000","start":0,"end":2,"surface":"昭公","kind":"person","person_id":"muq_yy8_8er_A","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m011-0006","start":6,"end":8,"surface":"昭公","kind":"person","person_id":"muq_yy8_8er_A","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m011-0014","start":14,"end":16,"surface":"莊公","kind":"person","person_id":"muq_yy8_8er","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m011-0018","start":18,"end":21,"surface":"髙渠彌","kind":"person","person_id":"f23_b0p_hqg","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m011-0024","start":24,"end":27,"surface":"太子忽","kind":"person","person_id":"muq_yy8_8er_A","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m011-0030","start":30,"end":32,"surface":"莊公","kind":"person","person_id":"muq_yy8_8er","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m011-0037","start":37,"end":39,"surface":"渠彌","kind":"person","person_id":"f23_b0p_hqg","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m011-0043","start":43,"end":45,"surface":"昭公","kind":"person","person_id":"muq_yy8_8er_A","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m011-0059","start":59,"end":61,"surface":"渠彌","kind":"person","person_id":"f23_b0p_hqg","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m011-0062","start":62,"end":64,"surface":"昭公","kind":"person","person_id":"muq_yy8_8er_A","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m011-0069","start":69,"end":71,"surface":"昭公","kind":"person","person_id":"muq_yy8_8er_A","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m011-0074","start":74,"end":76,"surface":"祭仲","kind":"person","person_id":"63x_7fc_69z","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m011-0077","start":77,"end":79,"surface":"渠彌","kind":"person","person_id":"f23_b0p_hqg","status":"contextual_provisional"},{"id":"c