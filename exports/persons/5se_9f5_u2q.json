":"person","person_id":"9o9_3nf_hyq","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m005-0017","start":17,"end":19,"surface":"孟嘗","kind":"person","person_id":"6l6_dtm_6tt","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m005-0020","start":20,"end":22,"surface":"春申","kind":"person","person_id":"iik_i5z_m5e","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m005-0023","start":23,"end":25,"surface":"平原","kind":"person","person_id":"0td_td4_i0v","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m005-0026","start":26,"end":28,"surface":"信陵","kind":"person","person_id":"3k9_4y0_6z1","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m005-0113","start":113,"end":116,"surface":"儒、墨","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-124-youxia:m005-0150","start":150,"end":152,"surface":"朱家","kind":"person","person_id":"hn3_zjy_ggs","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m005-0153","start":153,"end":155,"surface":"田仲","kind":"person","person_id":"qg3_81p_5ti","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m005-0156","start":156,"end":158,"surface":"王公","kind":"person","person_id":"t00_u9v_yvd","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m005-0159","start":159,"end":161,"surface":"劇孟","kind":"person","person_id":"5se_9f5_u2q","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m005-0162","start":162,"end":164,"surface":"郭解","kind":"person","person_id":"5if_pf6_zos_A","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m005-0244","start":244,"end":246,"surface":"朱家","kind":"person","person_id":"hn3_zjy_ggs","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m005-0247","start":247,"end":249,"surface":"郭解","kind":"person","person_id":"5if_pf6_zos_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-124-youxia","book_id":"b-shiji-124","work_id":"w-shiji","source_id":"s-shiji124-youxia"},{"id":"c-shiji-124-youxia:p007","text":"楚田仲以俠聞，喜劍，父事朱家，自以為行弗及。田仲已死，而雒陽有劇孟。周人以商賈為資，而劇孟以任俠顯諸侯。吳楚反時，條侯為太尉，乘傳車將至河南，得劇孟，喜曰：「吳楚舉大事而不求孟，吾知其無能為已矣。」天下騷動，宰相得之若得一敵國云。劇孟行大類朱家，而好博，多少年之戲。然劇孟母死，自遠方送喪蓋千乘。及劇孟死，家無餘十金之財。而符離人王孟亦以俠稱江淮之間。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-124-youxia:m007-0001","start":1,"end":3,"surface":"田仲","kind":"person","person_id":"qg3_81p_5ti","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m007-0012","start":12,"end":14,"surface":"朱家","kind":"person","person_id":"hn3_zjy_ggs","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m007-0022","start":22,"end":24,"surface":"田仲","kind":"person","person_id":"qg3_81p_5ti","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m007-0031","start":31,"end":33,"surface":"劇孟","kind":"person","person_id":"5se_9f5_u2q","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m007-0043","start":43,"end":45,"surface":"劇孟","kind":"person","person_id":"5se_9f5_u2q","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m007-0057","start":57,"end":59,"surface":"條侯","kind":"person","person_id":"u6m_zsb_0ps","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m007-0072","start":72,"end":74,"surface":"劇孟","kind":"person","person_id":"5se_9f5_u2q","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m007-0087","start":87,"end":88,"surface":"孟","kind":"person","person_id":"5se_9f5_u2q","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m007-0115","start":115,"end":117,"surface":"劇孟","kind":"person","person_id":"5se_9f5_u2q","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m007-0120","start":120,"end":122,"surface":"朱家","kind":"person","person_id":"hn3_zjy_ggs","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m007-0134","start":134,"end":137,"surface":"劇孟母","kind":"person","person_id":"qel_t1a_itz","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m007-0149","start":149,"end":151,"surface":"劇孟","kind":"per