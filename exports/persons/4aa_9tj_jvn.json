raph_id":"c-shiji-032-qi:p047","quote":"太子昭"},{"mention_id":"c-shiji-032-qi:m047-0118","chapter_id":"c-shiji-032-qi","paragraph_id":"c-shiji-032-qi:p047","quote":"太子昭"},{"mention_id":"c-shiji-032-qi:m047-0124","chapter_id":"c-shiji-032-qi","paragraph_id":"c-shiji-032-qi:p047","quote":"齊孝公"},{"mention_id":"c-shiji-032-qi:m049-0003","chapter_id":"c-shiji-032-qi","paragraph_id":"c-shiji-032-qi:p049","quote":"孝公"},{"mention_id":"c-shiji-032-qi:m049-0007","chapter_id":"c-shiji-032-qi","paragraph_id":"c-shiji-032-qi:p049","quote":"孝公"},{"mention_id":"c-shiji-039-jin:m054-0046","chapter_id":"c-shiji-039-jin","paragraph_id":"c-shiji-039-jin:p054","quote":"齊孝公"}],"family_path":{"connection":"father","generation_distance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-032-qi","source_id":"s-shiji-032-qi","paragraph_id":"c-shiji-032-qi:p047","quote":"桓公十有餘子，要其後立者五人：無詭立三月死，無謚；次孝公；次昭公；次懿公；次惠公。孝公元年三月，宋襄公率諸侯兵送齊太子昭而伐齊。齊人恐，殺其君無詭。齊人將立太子昭，四公子之徒攻太子，太子走宋，宋遂與齊人四公子戰。五月，宋敗齊四公子師而立太子昭，是為齊孝公。宋以桓公與管仲屬之太子，故來征之。以亂故，八月乃葬齊桓公。","source_term":"子"}],"source_assertion_id":"a-shiji032-038","interpretation_note":"以此受傳正文的明示近親主張配置局部家族；不合併跨篇候選身份、不補闕名世代，不表示遠祖世系已核實。分支字元不是長幼排行。","reviewer":"Codex（AI 代理）","parent_person_id":"9w2_c77_53m"},"id_aliases":["cbr-p001134"]}],"source_mention_summary":[{"source_id":"s-shiji-032-qi","work_id":"w-shiji","book_id":"b-shiji-032","chapter_id":"c-shiji-032-qi","mention_count":1,"mention_ids":["c-shiji-032-qi:m045-0062"],"paragraph_ids":["c-shiji-032-qi:p045"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-032-qi"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji032-032","subject_person_id":"9w2_c77_53m_C","predicate":"mother","object_person_id":"4aa_9tj_jvn","status":"source_attested","evidence":[{"chapter_id":"c-shiji-032-qi","source_id":"s-shiji-032-qi","paragraph_id":"c-shiji-032-qi:p045","quote":"四十三年。初，齊桓公之夫人三：曰王姬、徐姬、蔡姬，皆無子。桓公好內，多內寵，如夫人者六人，長衛姬，生無詭；少衛姬，生惠公元；鄭姬，生孝公昭；葛嬴，生昭公潘；密姬，生懿公商人；宋華子，生公子雍。桓公與管仲屬孝公於宋襄公，以為太子。雍巫有寵於衛共姬，因宦者豎刀以厚獻於桓公，亦有寵，桓公許之立無詭。管仲卒，五公子皆求立。冬十月乙亥，齊桓公卒。易牙入，與豎刀因內寵殺群吏，而立公子無詭為君。太子昭奔宋。"}],"qualifiers":{"source_term":"生","historicity":"historical_tradition"},"interpretation_note":"逐項保存本文母子、兄弟、姊妹、配偶及祖先說；祖不補代數，異母女性不合併，不以史記記載當已確證身世。蔡姬原文弗絕不推婚姻終止。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-032-qi:m045-0062","start":62,"end":64,"surface":"鄭姬","kind":"person","person_id":"4aa_9tj_jvn","status":"contextual_provisional","paragraph_id":"c-shiji-032-qi:p045","chapter_id":"c-shiji-032-qi"}],"relations":[{"id":"a-shiji032-032","subject_person_id":"9w2_c77_53m_C","predicate":"mother","object_person_id":"4aa_9tj_jvn","status":"source_attested","evidence":[{"chapter_id":"c-shiji-032-qi","source_id":"s-shiji-032-qi","paragraph_id":"c-shiji-032-qi:p045","quote":"四十三年。初，齊桓公之夫人三：曰王姬、徐姬、蔡姬，皆無子。桓公好內，多內寵，如夫人者六人，長衛姬，生無詭；少衛姬，生惠公元；鄭姬，生孝公昭；葛嬴，生昭公潘；密姬，生懿公商人；宋華子，生公子雍。桓公與管仲屬孝公於宋襄公，以為太子。雍巫有寵於衛共姬，因宦者豎刀以厚獻於桓公，亦有寵，桓公許之立無詭。管仲卒，五公子皆求立。冬十月乙亥，齊桓公卒。易牙入，與豎刀因內寵殺群吏，而立公子無詭為君。太子昭奔宋。"}],"qualifiers":{"source_term":"生","historicity":"historical_tradition"},"interpretation_note":"逐項保存本文母子、兄弟、姊妹、配偶及祖先說；祖不補代數，異母女性不合併，不以史記記載當已確證身世。蔡姬原文弗絕不推婚姻終止。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-032-qi:p045","text":"四十三年。初，齊桓公之夫人三：曰王姬、徐姬、蔡姬，皆無子。桓公好內，多內寵，如夫人者六人，長衛姬，生無詭；少衛姬，生惠公元；鄭姬，生孝公昭；葛嬴，生昭公潘；密姬，生懿公商人；宋華子，生公子雍。桓公與管仲屬孝公於宋襄公，以為太子。雍巫有寵於衛共姬，因宦者豎刀以厚獻於桓公，亦有寵，桓公許之立無詭。管仲卒，五公子皆求立。冬十月乙亥，齊桓公卒。易牙入，與豎刀因內寵殺群吏，而立公子無詭為君。太子昭奔宋。","