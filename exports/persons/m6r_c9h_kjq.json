,"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-shiji122-016","person_id":"m6r_c9h_kjq","event_type":"death","status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-122-kuli","source_id":"s-shiji122-kuli","paragraph_id":"c-shiji-122-kuli:p036","quote":"温舒死，家直累千金。後數歳，尹齊亦以淮陽都尉病死，家直不滿五十金。所誅滅淮陽甚多，及死，仇家欲燒其尸，尸亡去歸葬。","person_mention_id":"c-shiji-122-kuli:m036-0014"}],"source_term":"以淮陽都尉病死","interpretation_note":"原文明示死亡、執行或自殺；各次回顧未另造死亡事件。未知公元年保持未知，後一歳、十餘年等相對時間保留原文待核。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"mentions":[{"id":"c-shiji-122-kuli:m030-0275","start":275,"end":277,"surface":"尹齊","kind":"person","person_id":"m6r_c9h_kjq","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p030","chapter_id":"c-shiji-122-kuli"},{"id":"c-shiji-122-kuli:m031-0000","start":0,"end":2,"surface":"尹齊","kind":"person","person_id":"m6r_c9h_kjq","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p031","chapter_id":"c-shiji-122-kuli"},{"id":"c-shiji-122-kuli:m031-0074","start":74,"end":76,"surface":"尹齊","kind":"person","person_id":"m6r_c9h_kjq","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p031","chapter_id":"c-shiji-122-kuli"},{"id":"c-shiji-122-kuli:m032-0038","start":38,"end":40,"surface":"尹齊","kind":"person","person_id":"m6r_c9h_kjq","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p032","chapter_id":"c-shiji-122-kuli"},{"id":"c-shiji-122-kuli:m036-0014","start":14,"end":16,"surface":"尹齊","kind":"person","person_id":"m6r_c9h_kjq","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p036","chapter_id":"c-shiji-122-kuli"}],"relations":[],"title_holdings":[{"id":"th-shiji122-063","person_id":"m6r_c9h_kjq","title":"中尉","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-122-kuli","source_id":"s-shiji122-kuli","paragraph_id":"c-shiji-122-kuli:p030","quote":"素居廣平時，皆知河内豪姦之家，及往，九月而至。令郡具私馬五十匹，爲驛自河内至長安，部吏如居廣平時方略，捕郡中豪猾，郡中豪猾相連坐千餘家。上書請，大者至族，小者乃死，家盡沒入償臧。奏行不過二三日，得可事。論報，至流血十餘里。河内皆怪其奏，以爲神速。盡十二月，郡中毋聲，毋敢夜行，野無犬吠之盜。其頗不得，失之旁郡國，黎來，會春，温舒頓足嘆曰：「嗟乎，令冬月益展一月，足吾事矣！」其好殺伐行威不愛人如此。天子聞之，以爲能，遷爲中尉。其治復放河内，徙諸名禍猾吏與從事，河内則楊皆、麻戊，關中楊贛、成信等。義縱爲内史，憚未敢恣治。及縱死，張湯敗後，徙爲廷尉，而尹齊爲中尉。"}],"attestations":[{"id":"th-shiji122-063:a001","paragraph_id":"c-shiji-122-kuli:p030","start":278,"end":280,"surface":"中尉","person_mention_id":"c-shiji-122-kuli:m030-0275","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"依原文區分授任、貶任與用稱；未明日期保持未知，死亡不自動終止官爵。敘事時長不反推公元年。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji122-064","person_id":"m6r_c9h_kjq","title":"御史","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-122-kuli","source_id":"s-shiji122-kuli","paragraph_id":"c-shiji-122-kuli:p031","quote":"尹齊者，東郡茌平人。以刀筆稍遷至御史。事張湯，張湯數稱以爲廉武，使督盜賊，所斬伐不避貴戚。遷爲關内都尉，聲甚於寧成。上以爲能，遷爲中尉，吏民益凋敝。尹齊木彊少文，豪惡吏伏匿而善吏不能爲治，以故事多廢，抵罪。上復徙温舒爲中尉，而楊仆以嚴酷爲主爵都尉。"}],"attestations":[{"id":"th-shiji122-064:a001","paragraph_id":"c-shiji-122-kuli:p031","start":16,"end":18,"surface":"御史","person_mention_id":"c-shiji-122-kuli:m031-0000","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-122-kuli","source_id":"s-shiji122-kuli","paragraph_id":"c-shiji-122-kuli:p031","quote":"尹齊者，東郡茌平人。以刀筆稍遷至御史。事張湯，張湯數稱以爲廉武，使督盜賊，所斬伐不避貴戚。遷爲關内都尉，聲甚於寧成。上以爲能，遷爲中尉，吏民益凋敝。尹齊木彊少文，豪惡吏伏匿而善吏不能爲治，以故事多廢，抵罪。上復徙温舒爲中尉，而楊仆以嚴酷爲主爵都尉。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"依原文區分授任、貶任與用稱；未明日期保持未知，死亡不自動終止官爵。敘事時長不反推公元年。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji122-065","person_id":"m6r_c9h_kjq","title":"關内都尉","kind"