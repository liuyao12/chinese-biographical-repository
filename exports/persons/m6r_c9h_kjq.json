:"ln1_tyi_kei","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m031-0106","start":106,"end":108,"surface":"温舒","kind":"person","person_id":"6ym_eva_k4a","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m031-0113","start":113,"end":115,"surface":"楊仆","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"}],"chapter_id":"c-shiji-122-kuli","book_id":"b-shiji-122","work_id":"w-shiji","source_id":"s-shiji122-kuli"},{"id":"c-shiji-122-kuli:p032","text":"楊仆者，宜陽人也。以千夫爲吏。河南守案舉以爲能，遷爲御史，使督盜賊關東。治放尹齊，以爲敢摯行。稍遷至主爵都尉，列九卿。天子以爲能。南越反，拜爲樓船將軍，有功，封將梁侯。爲荀彘所縛。居久之，病死。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-122-kuli:m032-0000","start":0,"end":2,"surface":"楊仆","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m032-0015","start":15,"end":18,"surface":"河南守","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m032-0038","start":38,"end":40,"surface":"尹齊","kind":"person","person_id":"m6r_c9h_kjq","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m032-0059","start":59,"end":61,"surface":"天子","kind":"person","person_id":"ln1_tyi_kei","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m032-0085","start":85,"end":87,"surface":"荀彘","kind":"person","person_id":"nsq_9q2_27r","status":"contextual_provisional"}],"chapter_id":"c-shiji-122-kuli","book_id":"b-shiji-122","work_id":"w-shiji","source_id":"s-shiji122-kuli"},{"id":"c-shiji-122-kuli:p036","text":"温舒死，家直累千金。後數歳，尹齊亦以淮陽都尉病死，家直不滿五十金。所誅滅淮陽甚多，及死，仇家欲燒其尸，尸亡去歸葬。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-122-kuli:m036-0000","start":0,"end":2,"surface":"温舒","kind":"person","person_id":"6ym_eva_k4a","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m036-0014","start":14,"end":16,"surface":"尹齊","kind":"person","person_id":"m6r_c9h_kjq","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m036-0044","start":44,"end":46,"surface":"仇家","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-122-kuli","book_id":"b-shiji-122","work_id":"w-shiji","source_id":"s-shiji122-kuli"}],"sources":[{"chapter_id":"c-shiji-122-kuli","work_id":"w-shiji","book_id":"b-shiji-122","source_id":"s-shiji122-kuli","source":{"title":"史記／卷122","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷122","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷122&oldid=7904124","revision_id":7904124,"accessed_on":"2026-10-11","extent":"固定修訂全文44段，包括末段索隱述贊。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"去header2及現代節標、字形控制外殼而保留其中原字與異文；未核影像。","note":"末段索隱述贊分層，太史公論贊屬篇文。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true}}
