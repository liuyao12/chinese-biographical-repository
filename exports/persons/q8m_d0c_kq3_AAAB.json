d0c_kq3_AAAB","label":"平夏（郟敖子）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"平夏","mention_ids":["c-shiji-040-chu:m029-0077"]}],"evidence":[{"mention_id":"c-shiji-040-chu:m029-0077","chapter_id":"c-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p029","quote":"平夏"}],"family_path":{"connection":"father","generation_distance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-040-chu","source_id":"s-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p029","quote":"康王寵弟公子圍、子比、子皙、棄疾。郟敖三年，以其季父康王弟公子圍爲令尹，主兵事。四年，圍使鄭，道聞王疾而還。十二月己酉，圍入問王疾，絞而弒之，遂殺其子莫及平夏。使使赴於鄭。伍舉問曰：「誰爲後？」對曰：「寡大夫圍。」伍舉更曰：「共王之子圍爲長。」子比奔晉，而圍立，是爲靈王。","source_term":"郟敖","term_role":"literal_person_anchor_in_relation_context","interpretation_note":"原關係主張的source_term是合述描述；此欄保留本段實際人物錨點。關係及完整證據見source_assertion_id。"}],"source_assertion_id":"a-shiji040-038","interpretation_note":"以此受傳正文的明示近親主張配置局部家族；不合併跨篇候選身份、不補闕名世代，不表示遠祖世系已核實。分支字元不是長幼排行。","reviewer":"Codex（AI 代理）","parent_person_id":"q8m_d0c_kq3_AAA"}}],"source_mention_summary":[{"source_id":"s-shiji-040-chu","work_id":"w-shiji","book_id":"b-shiji-040","chapter_id":"c-shiji-040-chu","mention_count":1,"mention_ids":["c-shiji-040-chu:m029-0077"],"paragraph_ids":["c-shiji-040-chu:p029"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-040-chu"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji040-038","subject_person_id":"q8m_d0c_kq3_AAAB","predicate":"father","object_person_id":"q8m_d0c_kq3_AAA","status":"source_attested","evidence":[{"chapter_id":"c-shiji-040-chu","source_id":"s-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p029","quote":"康王寵弟公子圍、子比、子皙、棄疾。郟敖三年，以其季父康王弟公子圍爲令尹，主兵事。四年，圍使鄭，道聞王疾而還。十二月己酉，圍入問王疾，絞