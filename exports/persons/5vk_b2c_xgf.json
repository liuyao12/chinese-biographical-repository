emain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-songshu-048-fuhongzhi:p005:m0030","start":30,"end":33,"surface":"徐師高","kind":"person","person_id":"5vk_b2c_xgf","status":"contextual_provisional","paragraph_id":"c-songshu-048-fuhongzhi:p005","chapter_id":"c-songshu-048-fuhongzhi"}],"relations":[],"title_holdings":[{"id":"th-songshu-048-fuhongzhi-5-26","title":"略陽太守","kind":"office","mode":"attestation","person_id":"5vk_b2c_xgf","attestations":[{"id":"th-songshu-048-fuhongzhi-5-26:a","paragraph_id":"c-songshu-048-fuhongzhi:p005","start":26,"end":30,"surface":"略陽太守","person_mention_id":"c-songshu-048-fuhongzhi:p005:m0030","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-048","chapter_id":"c-songshu-048-fuhongzhi","source_id":"s-songshu-048-fuhongzhi-ws1791560","paragraph_id":"c-songshu-048-fuhongzhi:p005","quote":"進為桂陽公義真雍州治中從事史，除西戎司馬、寧朔將軍。略陽太守徐師高反叛，弘之討平之。高祖歸後，佛佛偽太子赫連瓌率眾三萬襲長安，弘之又領步騎五千，於池陽大破之，殺傷甚眾。瓌又抄掠渭南，弘之又於寡婦人渡破瓌，獲賊三百，掠七千餘口。及義真東歸，佛佛傾國追躡，於青泥大戰，弘之身貫甲冑，氣冠三軍。軍敗陷沒，佛佛逼令降，弘之不為屈，時天寒，裸弘之，弘之叫罵見殺。時年四十二。","person_mention_id":"c-songshu-048-fuhongzhi:p005:m0030"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-songshu-048-fuhongzhi:p005","text":"進為桂陽公義真雍州治中從事史，除西戎司馬、寧朔將軍。略陽太守徐師高反叛，弘之討平之。高祖歸後，佛佛偽太子赫連瓌率眾三萬襲長安，弘之又領步騎五千，於池陽大破之，殺傷甚眾。瓌又抄掠渭南，弘之又於寡婦人渡破瓌，獲賊三百，掠七千餘口。及義真東歸，佛佛傾國追躡，於青泥大戰，弘之身貫甲冑，氣冠三軍。軍敗陷沒，佛佛逼令降，弘之不為屈，時天寒，裸弘之，弘之叫罵見殺。時年四十二。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":75,"last_line":75,"raw_start":6652,"raw_end":6