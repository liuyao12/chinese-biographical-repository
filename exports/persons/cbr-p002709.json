on","person_id":"cbr-p002709","status":"contextual_provisional","paragraph_id":"c-shiji-046-tian:p002","chapter_id":"c-shiji-046-tian"}],"relations":[{"id":"a-shiji046-002","subject_person_id":"cbr-p002707","predicate":"father","object_person_id":"cbr-p002709","status":"source_attested","evidence":[{"chapter_id":"c-shiji-046-tian","source_id":"s-shiji-046-tian","paragraph_id":"c-shiji-046-tian:p002","quote":"厲公者，陳文公少子也，其母蔡女。文公卒，厲公兄鮑立，是爲桓公。桓公與他異母。及桓公病，蔡人爲他殺桓公鮑及太子免而立他，爲厲公。厲公旣立，娶蔡女。蔡女淫於蔡人，數歸，厲公亦數如蔡。桓公之少子林怨厲公殺其父與兄，乃令蔡人誘厲公而殺之。林自立，是爲莊公。故陳完不得立，爲陳大夫。厲公之殺，以淫出國，故《春秋》曰「蔡人殺陳他」，罪之也。"}],"qualifiers":{"source_term":"陳文公少子","historicity":"historical_tradition"},"interpretation_note":"按明示子、生、母、兄弟及局部回指保存；祖先、妻完與宗族稱呼不補直接父子或未名配偶。校勘與他篇世系仍待覆核。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji046-003","person_id":"cbr-p002709","surfaces":["文公","陳文公"],"scope":"same_chapter","chapter_ids":["c-shiji-046-tian"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-046-tian:p002","quote":"厲公者，陳文公少子也，其母蔡女。文公卒，厲公兄鮑立，是爲桓公。桓公與他異母。及桓公病，蔡人爲他殺桓公鮑及太子免而立他，爲厲公。厲公旣立，娶蔡女。蔡女淫於蔡人，數歸，厲公亦數如蔡。桓公之少子林怨厲公殺其父與兄，乃令蔡人誘厲公而殺之。林自立，是爲莊公。故陳完不得立，爲陳大夫。厲公之殺，以淫出國，故《春秋》曰「蔡人殺陳他」，罪之也。"}],"rationale":"限本篇明示姓名、是為、繼位及局部事件暫接；姜齊與田齊桓公、不同時段未名王及同字忌分開。孫子不先補孫臏，子守髙唐不補闕字，索隱短稱與代詞仍待核；未跨篇按同名接人。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-046-tian:p002","text":"厲公者，陳文公少子也，其母蔡女。文公卒，厲公兄鮑立，是爲桓公。桓公與他異母。及桓公病，蔡人爲他殺桓公鮑及太子免而立他，爲厲公。厲公旣立，娶蔡女。蔡女淫於蔡人，數歸，厲公亦數如蔡。桓公之少子林怨厲公殺其父與兄，乃令蔡人誘厲公而殺之。林自立，是爲莊公。故陳完不得立，爲陳大夫。厲公之殺，以淫出國，故《春秋》曰「蔡人殺陳他」，罪之也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-046-tian:m002-0000","start":0,"end":2,"surface":"厲公","kind":"person","person_id":"cbr-p002707","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m002-0004","start":4,"end":7,"surface":"陳文公","kind":"person","person_id":"cbr-p002709","status":"co