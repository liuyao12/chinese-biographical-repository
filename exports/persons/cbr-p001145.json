":"contextual_provisional"},{"id":"c-shiji-032-qi:m057-0373","start":373,"end":375,"surface":"齊侯","kind":"person","person_id":"cbr-p001145","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m057-0387","start":387,"end":388,"surface":"克","kind":"person","person_id":"cbr-p001149","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m057-0389","start":389,"end":393,"surface":"蕭桐叔子","kind":"person","person_id":"cbr-p001154","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m057-0403","start":403,"end":405,"surface":"叔子","kind":"person","person_id":"cbr-p001154","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m057-0406","start":406,"end":408,"surface":"齊君","kind":"person","person_id":"cbr-p001145","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m057-0410","start":410,"end":412,"surface":"齊君","kind":"person","person_id":"cbr-p001145","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m057-0415","start":415,"end":418,"surface":"晉君母","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、族稱或未定指代；齊秉意茲等疑讀待版本校勘，不補熟知姓名。"}],"chapter_id":"c-shiji-032-qi","book_id":"b-shiji-032","work_id":"w-shiji","source_id":"s-shiji-032-qi"},{"id":"c-shiji-032-qi:p058","text":"十一年，晉初置六卿，賞鞌之功。齊頃公朝晉，欲尊王晉景公，晉景公不敢受，乃歸。歸而頃公弛苑囿，薄賦斂，振孤問疾，虛積聚以救民，民亦大說。厚禮諸侯。竟頃公卒，百姓附，諸侯不犯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-032-qi:m058-0015","start":15,"end":18,"surface":"齊頃公","kind":"person","person_id":"cbr-p001145","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m058-0024","start":24,"end":27,"surface":"晉景公","kind":"person","person_id":"cbr-p001155","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m058-0028","start":28,"end":31,"surface":"晉景公","kind":"person","person_id":"cbr-p001155","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m058-0040","start":40,"end":42,"surface":"頃公","kind":"person","person_id":"cbr-p001145","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m058-0073","start":73,"end":75,"surface":"頃公","kind":"person","person_id":"cbr-p001145","status":"contextual_provisional"}],"chapter_id":"c-shiji-032-qi","book_id":"b-shiji-032","work_id":"w-shiji","source_id":"s-shiji-032-qi"},{"id":"c-shiji-032-qi:p059","text":"十七年，頃公卒，子靈公環立。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-032-qi:m059-0004","start":4,"end":6,"surface":"頃公","kind":"person","person_id":"cbr-p001145","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m059-0009","start":9,"end":12,"surface":"靈公環","kind":"person","person_id":"cbr-p001156","status":"contextual_provisional"}],"chapter_id":"c-shiji-032-qi","book_id":"b-shiji-032","work_id":"w-shiji","source_id":"s-shiji-032-qi"},{"id":"c-shiji-033-lu:p060","text":"成公二年春，齊伐取我隆。夏，公與晉郤克敗齊頃公於砹齊復歸我侵地。四年，成公如晉，晉景公不敬魯。魯欲背晉合於楚，或諫，乃不。十年，成公如晉。晉景公卒，因留成公送葬，魯諱之。十五年，始與吳王壽夢會鐘離。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-033-lu:m060-0000","start":0,"end":2,"surface":"成公","kind":"person","person_id":"cbr-p001270","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m060-0014","start":14,"end":15,"surface":"公","kind":"person","person_id":"cbr-p001270","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m060-0016","start":16,"end":19,"surface":"晉郤克","kind":"person","person_id":"cbr-p001149","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m060-0020","start":20,"end":23,"surface":"齊頃公","kind":"person","person_id":"cbr-p001145","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m060-0035","start":35,"end":37,"surface":"成公","kind":"person","person_id":"cbr-p001270","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m060-0040","start":40,"end":43,"surface":"晉景公","kind":"person","person_id":"cbr-p001155","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m060-0055","start":55,"end":57,"surface":"或諫","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未指名者、論贊署稱、地點氏稱或未定指代；不補姓名、爵位與成員。"},{"id":"c-shiji-033-lu:m060-0064","start":64,"end":66,"surface":"成公","kind":"person","person_id":"cbr-p001270","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m060-0069","start":69,"end":72,"surface":"晉景公","kind":"person","person_id":"cbr-p001155","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m060-0076","start":76,"end":78,"surface":"成公","kind":"person","person_id":"cbr-p001270","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m060-0091","start":91,"end":95,"surface":"吳王壽夢","kind":"person","person_id":"cbr-p001029","status":"contextual_provisional"}],"chapter_id":"c-shiji-033-lu","book_id":"b-shiji-033","work_id":"w-shiji","source_id":"s-shiji-033-lu"},{"id":"c-shiji-039-jin:p099","text":"八年，使郤克於齊。齊頃公母從樓上觀而笑之。所以然者，郤克僂，而魯使蹇，衞使眇，故齊亦令人如之以導客。郤克怒，歸至河上，曰：「不報齊者，河伯視之！」至國，請君，欲伐齊。景公問知其故，曰：「子之怨，安足以煩國！」弗聽。魏文子請老休，辟郤克，克執政。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m099-0004","start":4,"end":6,"surface":"郤克","kind":"person","person_id":"cbr-p001149","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m099-0009","start":9,"end":12,"surface":"齊頃公","kind":"person","person_id":"cbr-p001145","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m099-0026","start":26,"end":28,"surface":"郤克","kind":"person","person_id":"cbr-p001149","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m099-0031","start":31,"end":33,"surface":"魯使","kind":"person","person_id":"cbr-p001789","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m099-0035","start":35,"end":37,"surface":"衞使","kind":"person","person_id":"cbr-p001790","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m099-0047","start":47,"end":49,"surface":"導客","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m099-0050","start":50,"end":52,"surface":"郤克","kind":"person","person_id":"cbr-p001149","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m099-0083","start":83,"end":85,"surface":"景公","kind":"person","person_id":"cbr-p001155","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m099-0107","start":107,"end":110,"surface":"魏文子","kind":"person","person_id":"cbr-p001791","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m099-0115","start":115,"end":117,"surface":"郤克","kind":"person","person_id":"cbr-p001149","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m099-0118","start":118,"end":119,"surface":"克","kind":"person","person_id":"cbr-p001149","status":"contextual_provisional"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"},{"id":"c-shiji-039-jin:p101","text":"十一年春，齊伐魯，取隆。魯告急衞，衞與魯皆因郤克告急於晉。晉乃使郤克、欒書、韓厥以兵車八百乘與魯、衞共伐齊。夏，與頃公戰於砹傷困頃公。頃公乃與其右易位，下取飲，以得脱去。齊師敗走，晉追北至齊。頃公獻寶器以求平，不聽。郤克曰：「必得蕭桐姪子爲質。」齊使曰：「蕭桐姪子，頃公母；頃公母猶晉君母，柰何必得之？不義，請復戰。」晉乃許與平而去。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m101-0022","start":22,"end":24,"surface":"郤克","kind":"person","person_id":"cbr-p001149","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m101-0032","start":32,"end":34,"surface":"郤克","kind":"person","person_id":"cbr-p001149","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m101-0038","start":38,"end":40,"surface":"韓厥","kind":"person","person_id":"cbr-p001153","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m101-0057","start":57,"end":59,"surface":"頃公","kind":"person","person_id":"cbr-p001145","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m101-0064","start":64,"end":66,"surface":"頃公","kind":"person","person_id":"cbr-p001145","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m101-0067","start":67,"end":69,"surface":"頃公","kind":"person","person_id":"cbr-p001145","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m101-0071","start":71,"end":73,"surface":"其右","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m101-0096","start":96,"end":98,"surface":"頃公","kind":"person","person_id":"cbr-p001145","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m101-0108","start":108,"end":110,"surface":"郤克","kind":"person","person_id":"cbr-p001149","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m101-0115","start":115,"end":119,"surface":"蕭桐姪子","kind":"person","person_id":"cbr-p001788","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m101-0128","start":128,"end":132,"surface":"蕭桐姪子","kind":"person","person_id":"cbr-p001788","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m101-0133","start":133,"end":135,"surface":"頃公","kind":"person","person_id":"cbr-p001145","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m101-0137","start":137,"end":139,"surface":"頃公","kind":"person","person_id":"cbr-p001145","status":"contextual_provisional"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"},{"id":"c-shiji-039-jin:p103","text":"十二年冬，齊頃公如晉，欲上尊晉景公爲王，景公讓不敢。晉始作六（卿）［軍］，韓厥、鞏朔、趙穿、荀騅、趙括、趙旃皆爲卿。智罃自楚歸。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m103-0005","start":5,"end":8,"surface":"齊頃公","kind":"person","person_id":"cbr-p001145","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m103-0014","start":14,"end":17,"surface":"晉景公","kind":"person","person_id":"cbr-p001155","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m103-0020","start":20,"end":22,"surface":"景公","kind":"person","person_id":"cbr-p001155","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m103-0029","start":29,"end":36,"surface":"六（卿）［軍］","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m103-0037","start":37,"end":39,"surface":"韓厥","kind":"person","person_id":"cbr-p001153",