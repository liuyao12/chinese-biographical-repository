":"c-nanqishu-052-later-literature-complete:p043","chapter_id":"c-nanqishu-052-later-literature-complete","quote":"淵"},{"mention_id":"c-nanqishu-052-later-literature-complete:p043:m0107","paragraph_id":"c-nanqishu-052-later-literature-complete:p043","chapter_id":"c-nanqishu-052-later-literature-complete","quote":"淵"},{"mention_id":"c-nanqishu-052-later-literature-complete:p044:m0006","paragraph_id":"c-nanqishu-052-later-literature-complete:p044","chapter_id":"c-nanqishu-052-later-literature-complete","quote":"淵"},{"mention_id":"c-nanqishu-052-later-literature-complete:p044:m0035","paragraph_id":"c-nanqishu-052-later-literature-complete:p044","chapter_id":"c-nanqishu-052-later-literature-complete","quote":"淵"},{"mention_id":"c-nanqishu-052-later-literature-complete:p044:m0061","paragraph_id":"c-nanqishu-052-later-literature-complete:p044","chapter_id":"c-nanqishu-052-later-literature-complete","quote":"淵"}],"review":"ai_provisional","identity_note":"齊書、南史平陽賈氏三世譜家同繫長水校尉。","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"uij_ufp_1a6_A","source_assertion_id":"a-nanshi059-wangsengru-yuan","evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-059","source_id":"s-nanshi-059-wangsengru-ws1553912","chapter_id":"c-nanshi-059-wangsengru","paragraph_id":"c-nanshi-059-wangsengru:p007","quote":"轉北中郎諮議參軍，入直西省，知撰譜事。先是，尚書令沈約以為「晉咸和初，蘇峻作亂，文籍無遺。後起咸和二年以至於宋，所書並皆詳實，並在下省左戶曹前廂，謂之晉籍，有東西二庫。此籍既並精詳，實可寶惜，位宦高卑，皆可依案。宋元嘉二十七年，始以七條徵發，既立此科，人奸互起，偽狀巧籍，歲月滋廣。以至於齊，患其不實，於是東堂校籍，置郎令史以掌之。競行奸貨，以新換故，昨日卑細，今日便成士流。凡此奸巧，並出愚下，不辨年號，不識官階。或注隆安在元興之後，或以義熙在甯康之前。此時無此府，此時無此國。元興唯有三年，而猥稱四、五，詔書甲子，不與長曆相應。校籍諸郎亦所不覺，不才令史固自忘言。臣謂宋、齊二代，士庶不分，雜役減闕，職由於此。竊以晉籍所餘，宜加寶愛」。武帝以是留意譜籍，州郡多離其罪，因詔僧孺改定百家譜。始晉太元中，員外散騎侍郎平陽賈弼篤好簿狀，乃廣集眾家，大搜群族，所撰十八州一百一十六郡，合七百一十二卷。凡諸大品，略無遺闕，藏在秘閣，副在左戶。及弼子太宰參軍匪之、匪之子長水校尉深世傳其業。太保王弘、領軍將軍劉湛並好其書。弘日對千客，不犯一人之諱。湛為選曹，始撰百家以助銓序，而傷於寡略。齊衛將軍王儉復加去取，得繁省之衷。僧孺之撰，通范陽張等九族以代雁門解等九姓。其東南諸族別為一部，不在百家之數焉。普通二年卒。","subject_person_mention_id":"c-nanshi-059-wangsengru:p007:m0435","object_person_mention_id":"c-nanshi-059-wangsengru:p007:m0428"}],"status":"contextual_provisional","interpretation_note":"深為匪之子，齊書作淵。","human_reviewed":false}}],"source_mention_summary":[{"source_id":"s-nanqishu-052-later-literature-complete-ws2371079","work_id":"w-nanqishu","book_id":"b-nanqishu-052","chapter_id":"c-nanqishu-052-later-literature-complete","raw_mention_count":1,"mention_ids":["c-nanqishu-052-later-literature-complete:p044:m0045"],"paragraph_ids":["c-nanqishu-052-later-literature-complete:p044"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-nanqishu-052-later-literature-complete:p044:m0045","mention_ids":["c-nanqishu-052-later-literature-complete:p044:m0045"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-nanqishu-052-later-literature-complete-ws2371079"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-qi052-jiayuan-qichang-father","subject_person_id":"ozc_39n_pba","object_person_id":"uij_ufp_1a6_AA","predicate":"father","qualifiers":{"source_term":"子棲長謝罪","lineage":"paternal"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-052","chapter_id":"c-nanqishu-052-later-literature-complete","source_id":"s-nanqishu-052-later-literature-complete-ws2371079","paragraph_id":"c-nanqishu-052-later-literature-complete:p044","quote":"　　建武初，淵遷長水校尉。荒傖人王泰寶買襲琅邪譜，尚書令王晏以啓高宗，淵坐被收，當極法，子棲長謝罪，稽顙流血，朝廷哀之，免淵罪。數年，始安王遙光板撫軍諮議，不就，仍爲北中郎參軍。中興元年，卒。年六十二。撰《氏族要狀》及《人名書》，竝行於世。","subject_person_mention_id":"c-nanqishu-052-later-literature-complete:p044:m0045","object_person_mention_id":"c-nanqishu-052-later-literature-complete:p044:m0006"}],"status":"source_attested","interpretation_note":"棲長為賈淵謝罪，前後主語可辨。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-052-later-literature-complete:p044:m0045","start":45,"end":47,"surface":"棲長","kind":"person","person_id":"ozc_39n_pba","status":"contextual_provisional","paragraph_id":"c-nanqishu-052-later-literature-complete:p044","chapter_id":"c-nanqishu-052-later-literature-complete"}],"relations":[{"id":"a-qi052-jiayuan-qichang-father","subject_person_id":"ozc_39n_pba","object_person_id":"uij_ufp_1a6_AA","predicate":"father","qualifiers":{"source_term":"子棲長謝罪","lineage":"paternal"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-052","chapter_id":"c-nanqishu-052-later-literature-complete","source_id":"s-nanqishu-052-later-literature-complete-ws2371079","paragraph_id":"c-nanqishu-052-later-literature-complete:p044","quote":"　　建武初，淵遷長水校尉。荒傖人王泰寶買襲琅邪譜，尚書令王晏以啓高宗，淵坐被收，當極法，子棲長謝罪，稽顙流血，朝廷哀之，免淵罪。數年，始安王遙光板撫軍諮議，不就，仍爲北中郎參軍。中興元年，卒。年六十二。撰《氏族要狀》及《人名書》，竝行於世。","subject_person_mention_id":"c-nanqishu-052-later-literature-complete:p044:m0045","object_person_mention_id":"c-nanqishu-052-later-literature-complete:p044:m0006"}],"status":"source_attested","interpretation_note":"棲長為賈淵謝罪，前後主語可辨。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-052-later-literature-complete:p044","text":"　　建武初，淵遷長水校尉。荒傖人王泰寶買襲琅邪譜，