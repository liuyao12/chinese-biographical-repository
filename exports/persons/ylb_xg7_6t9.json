之免冠頓首謝曰：「法如是足也。且罪等，然以逆順爲差。今盜宗廟器而族之，有如萬分之一，假令愚民取長陵一抔土，陛下何以加其法乎？」久之，文帝與太后言之，乃許廷尉當。是時，中尉條侯周亞夫與梁相山都侯王恬開見釋之持議平，乃結爲親友。張廷尉由此天下稱之。"}],"attestations":[{"id":"th-shiji102-017:a001","paragraph_id":"c-shiji-102-zhangfeng:p007","start":183,"end":185,"surface":"梁相","person_mention_id":"c-shiji-102-zhangfeng:m007-0185","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授官與用稱分存，未以後任或死亡推終點。官（卒）［率］將保留校勘符號，不擇定官名。嗇夫上林令任命諫止，不記已任。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji102-018","person_id":"ylb_xg7_6t9","title":"山都侯","kind":"noble_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-102-zhangfeng","source_id":"s-shiji-102-zhangfeng","paragraph_id":"c-shiji-102-zhangfeng:p007","quote":"其後有人盜高廟坐前玉環，捕得，文帝怒，下廷尉治。釋之案律盜宗廟服御物者爲奏，奏當棄市。上大怒曰：「人之無道，乃盜先帝廟器，吾屬廷尉者，欲致之族，而君以法奏之，非吾所以共承宗廟意也。」釋之免冠頓首謝曰：「法如是足也。且罪等，然以逆順爲差。今盜宗廟器而族之，有如萬分之一，假令愚民取長陵一抔土，陛下何以加其法乎？」久之，文帝與太后言之，乃許廷尉當。是時，中尉條侯周亞夫與梁相山都侯王恬開見釋之持議平，乃結爲親友。張廷尉由此天下稱之。"}],"attestations":[{"id":"th-shiji102-018:a001","paragraph_id":"c-shiji-102-zhangfeng:p007","start":185,"end":188,"surface":"山都侯","person_mention_id":"c-shiji-102-zhangfeng:m007-0185","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授官與用稱分存，未以後任或死亡推終點。官（卒）［率］將保留校勘符號，不擇定官名。嗇夫上林令任命諫止，不記已任。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji102-002","person_id":"ylb_xg7_6t9","surfaces":["山都侯王恬開"],"scope":"same_chapter","chapter_ids":["c-shiji-102-zhangfeng"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-102-zhangfeng:p007","quote":"其後有人盜高廟坐前玉環，捕得，文帝怒，下廷尉治。釋之案律盜宗廟服御物者爲奏，奏當棄市。上大怒曰：「人之無道，乃盜先帝廟器，吾屬廷尉者，欲致之族，而君以法奏之，非吾所以共承宗廟意也。