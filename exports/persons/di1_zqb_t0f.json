-wyd:p007:m0000","person_id":"mxz_qw8_acd_A","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作筠。"},{"start":25,"end":28,"surface":"劉孝綽","id":"c-nanshi-022-wangyun-family-wyd:p007:m0025","person_id":"di1_zqb_t0f","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作劉孝綽。"},{"start":178,"end":180,"surface":"諸兒","id":"c-nanshi-022-wangyun-family-wyd:p007:u0178","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"王筠寫家書給眾子，收信人未逐一具名"},{"start":189,"end":193,"surface":"安平崔氏","id":"c-nanshi-022-wangyun-family-wyd:p007:u0189","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"郡望安平的崔氏"},{"start":194,"end":198,"surface":"汝南應氏","id":"c-nanshi-022-wangyun-family-wyd:p007:u0194","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"郡望汝南的應氏"},{"start":206,"end":209,"surface":"范蔚宗","id":"c-nanshi-022-wangyun-family-wyd:p007:m0206","person_id":"bxh_oop_5ic","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作范曄。"},{"start":246,"end":250,"surface":"沈少傅約","id":"c-nanshi-022-wangyun-family-wyd:p007:m0246","person_id":"p8b_7w1_y3q","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作沈約。"},{"start":283,"end":285,"surface":"王氏","id":"c-nanshi-022-wangyun-family-wyd:p007:u0283","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"沈約引語中的王氏家門"},{"start":288,"end":290,"surface":"汝等","id":"c-nanshi-022-wangyun-family-wyd:p007:u0288","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"家書中諸兒合稱"},{"start":298,"end":299,"surface":"筠","id":"c-nanshi-022-wangyun-family-wyd:p007:m0298","person_id":"mxz_qw8_acd_A","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作筠。"}],"source_position":{"revision_id":"cbr-ai-transcription-sha256:926ceb18b937c6612202ae0e975b51816ffe9fa93ccf09573b64985563a56669","source_layer":"received_biography","column_projection":[{"pdf_page":86,"half":"右","leaf":"二十四下","column_from_right":1,"start":6,"end":21,"text":"筠狀貌寢小長不滿六尺性弘厚不以"},{"pdf_page":86,"half":"右","leaf":"二十四下","column_from_right":2,"start":0,"end":21,"text":"藝能高人而少擅才名與劉孝綽見重當時其自序云"},{"pdf_page":86,"half":"右","leaf":"二十四下","column_from_right":3,"start":0,"end":21,"text":"余少好抄書老而彌篤雖遇見瞥觀皆卽疏記後重省"},{"pdf_page":86,"half":"右","leaf":"二十四下","column_from_right":4,"start":0,"end":21,"text":"覽懽興彌深習與性成不覺筆倦自年十三四建武二"},{"pdf_page":86,"half":"右","leaf":"二十四下","column_from_right":5,"start":0,"end":21,"text":"年乙亥至梁大同六年四十載矣幼年讀五經皆七八"},{"pdf_page":86,"half":"右","leaf":"二十四下","column_from_right":6,"start":0,"end":21,"text":"十遍愛左氏春秋吟諷常為口實廣畧去取凡三過五"},{"pdf_page":86,"half":"右","leaf":"二十四下","column_from_right":7,"start":0,"end":21,"text":"抄餘經及周官儀禮國語爾雅山海經本草並再抄子"},{"pdf_page":86,"half":"右","leaf":"二十四下","column_from_right":8,"start":0,"end":21,"text":"史諸集皆一遍未嘗倩人假手並躬自抄錄大小百餘"},{"pdf_page":86,"half":"右","leaf":"二十四下","column_from_right":9,"start":0,"end":21,"text":"卷不足傳之好事蓋以備遺忘而已又與諸兒書論家"},{"pdf_page":86,"half":"右","leaf":"二十四下","column_from_right":10,"start":0,"end":21,"text":"門集云史傳稱安平崔氏及汝南應氏並累葉有文才"},{"pdf_page":86,"half":"左","leaf":"二十五上","column_from_right":1,"start":0,"end":21,"text":"所以范蔚宗云崔氏雕龍然不過父子兩三世耳非有"},{"pdf_page":86,"half":"左","leaf":"二十五上","column_from_right":2,"start":0,"end":21,"text":"七葉之中名德重光爵位相繼人人有集如吾門者也"},{"pdf_page":86,"half":"左","leaf":"二十五上","column_from_right":3,"start":0,"end":21,"text":"沈少傅約常語人云吾少好百家之言身為四代之史"},{"pdf_page":86,"half":"左","leaf":"二十五上","column_from_right":4,"start":0,"end":21,"text":"自開闢以來未有爵位蟬聯文才相繼如王氏之盛也"},{"pdf_page":86,"half":"左","leaf":"二十五上","column_from_right":5,"start":0,"end":21,"text":"汝等仰觀堂構思各努力筠自撰其文章以一官為一"},{"pdf_page":86,"half":"左","leaf":"二十五上","column_from_right":6,"start":0,"end":21,"text":"集自洗馬中書中庶吏部左佐臨海太府各十卷尚書"},{"pdf_page":86,"half":"左","leaf":"二十五上","column_from_right":7,"start":0,"end":10,"text":"三十卷凡一百卷行於世"}]},"chapter_id":"c-nanshi-022-wangyun-family-wyd","book_id":"b-nanshi-022","work_id":"w-nanshi","source_id":"s-nanshi-022-wangyun-family-wyd1739"},{"id":"c-nanshi-022-wangyun-family:p004","text":"累遷太子洗馬，中舍人，並掌東宮管記。昭明太子愛文學士，常與筠及劉孝綽、陸倕、到洽、殷鈞等游宴玄圃，太子獨執筠袖，撫孝綽肩曰：「所謂左把浮丘袖，右拍洪崖肩。」其見重如此。筠又與殷鈞以方雅見禮。後爲中書郎，奉敕制開善寺寶志法師碑文，辭甚麗逸。又敕撰中書表奏三十卷，及所上賦頌都爲一集。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"start":18,"end":22,"surface":"昭明太子","id":"c-nanshi-022-wangyun-family:p004:m0018","person_id":"0va_s3x_wb4","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作蕭統。"},{"start":23,"end":26,"surface":"文學士","id":"c-nanshi-022-wangyun-family:p004:u0023","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"東宮文學之士合稱"},{"start":29,"end":30,"surface":"筠","id":"c-nanshi-022-wangyun-family:p004:m0029","person_id":"mxz_qw8_acd_A","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作筠。"},{"start":31,"end":34,"surface":"劉孝綽","id":"c-nanshi-022-wangyun-family:p004:m0031","person_id":"di1_zqb_t0f","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作劉孝綽。"},{"start":35,"end":37,"surface":"陸倕","id":"c-nanshi-022-wangyun-family:p004:m0035","person_id":"war_qdw_fs5","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作陸倕。"},{"start":38,"end":40,"surface":"到洽","id":"c-nanshi-022-wangyun-family:p004:m0038","person_id":"4mr_j4p_k5h","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作到洽。"},{"start":41,"end":43,"surface":"殷鈞","id":"c-nanshi-022-wangyun-family:p004:m0041","person_id":"ceq_pnr_q0e_A","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作殷鈞。"},{"start":53,"end":54,"surface":"筠","id":"c-nanshi-022-wangyun-family:p004:m0053","person_id":"mxz_qw8_acd_A","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作筠。"},{"start":57,"end":59,"surface":"孝綽","id":"c-nanshi-022-wangyun-family:p004:m0057","person_id":"di1_zqb_t0f","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作劉孝綽。"},{"start":67,"end":69,"surface":"浮丘","id":"c-nanshi-022-wangyun-family:p004:u0067","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"引詩仙人，借指王筠"},{"start":73,"end":75,"surface":"洪崖","id":"c-nanshi-022-wangyun-family:p004:u0073","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"引詩仙人，借指劉孝綽"},{"start":84,"end":85,"surface":"筠","id":"c-nanshi-022-wangyun-family:p004:m0084","person_id":"mxz_qw8_acd_A","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作筠。"},{"start":87,"end":89,"surface":"殷鈞","id":"c-nanshi-022-wangyun-family:p004:m0087","person_id":"ceq_pnr_q0e_A","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作殷鈞。"},{"start":107,"end":109,"surface":"寶志","id":"c-nanshi-022-wangyun-family:p004:m0107","person_id":"bpy_73i_0yy","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作寶誌。"}],"source_position":{"revision_id":1477957,"source_layer":"received_biography","raw_start":11814,"raw_end":11954,"raw_character_offsets":[11814,11815,11816,11817,11818,11819,11820,11821,11822,11823,11824,11825,11826,11827,11828,11829,11830,11831,11832,11833,11834,11835,11836,11837,11838,11839,11840,11841,11842,11843,11844,11845,11846,11847,11848,11849,11850,11851,11852,11853,11854,11855,11856,11857,11858,11859,11860,11861,11862,11863,11864,11865,11866,11867,11868,11869,11870,11871,11872,11873,11874,11875,11876,11877,11878,11879,11880,11881,11882,11883,11884,11885,11886,11887,11888,11889,11890,11891,11892,11893,11894,11895,11896,11897,11898,11899,11900,11901,11902,11903,11904,11905,11906,11907,11908,11909,11910,11911,11912,11913,11914,11915,11916,11917,11918,11919,11920,11921,11922,11923,11924,11925,11926,11927,11928,11929,11930,11931,11932,11933,11934,11935,11936,11937,11938,11939,11940,11941,11942,11943,11944,11945,11946,11947,11948,11949,11950,11951,11952,11953],"projection_sha256":"3af84b8cac30016cfbdb074cff40e11c8bac0af3f51e954a3546d60662441104"},"chapter_id":"c-nanshi-022-wangyun-family","book_id":"b-nanshi-022","work_id":"w-nanshi","source_id":"s-nanshi-022-wangyun-family-ws1477957"},{"id":"c-nanshi-022-wangyun-family:p007","text":"筠狀貌寢小，長不滿六尺。性弘厚，不以藝能高人。而少擅才名，與劉孝綽見重當時。其自序云：「餘少好抄書，老而彌篤，雖偶見瞥觀，皆即疏記。後重省覽，歡興彌深。習與性成，不覺筆倦。自年十三四，建武二年乙亥，至梁大同六年，四十六載矣。幼年讀五經，皆七八十遍。愛左氏春秋，吟諷常爲口實。廣略去取，凡三過五抄，余經及周官、儀禮、國語、爾雅、山海經、本草並再抄，子史諸集皆一遍。未嘗倩人假手，並躬自抄錄，大小百餘卷。不足傳之好事，蓋以備遺忘而已。」又與諸兒書論家門集云：「史傳稱安平崔氏及汝南應氏並累葉有文才，所以范蔚宗雲崔氏雕龍。然不過父子兩三世耳，非有七葉之中，名德重光，爵位相繼，人人有集，如吾門者也。沈少傅約常語人云∶'吾少好百家之言，身爲四代之史。自開闢以來，未有爵位蟬聯、文才相繼如王氏之盛也。'汝等仰觀堂構，思各努力。」筠自撰其文章，以一官爲一集，自洗馬、中書、中庶、吏部、左佐、臨海、太府各十卷，尚書三十卷，凡一百卷，行於世。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"start":0,"end":1,"surface":"筠","id":"c-nanshi-022-wangyun-family:p007:m0000","person_id":"mxz_qw8_acd_A","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作筠。"},{"start":30,"end":33,"surface":"劉孝綽","id":"c-nanshi-022-wangyun-family:p007:m0030","person_id":"di1_zqb_t0f","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作劉孝綽。"},{"start":218,"end":220,"surface":"諸兒","id":"c-nanshi-022-wangyun-family:p007:u0218","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"王筠寫家書給眾子，收信人未逐一具名"},{"start":231,"end":235,"surface":"安平崔氏","id":"c-nanshi-022-wangyun-family:p007:u0231","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"郡望安平的崔氏"},{"start":236,"end":240,"surface":"汝南應氏","id":"c-nanshi-022-wangyun-family:p007:u0236","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"郡望汝南的應氏"},{"start":249,"end":252,"surface":"范蔚宗","id":"c-nanshi-022-wangyun-family:p007:m0249","person_id":"bxh_oop_5ic","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作范曄。"},{"st