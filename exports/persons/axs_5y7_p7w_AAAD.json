n-kin:p001","quote":"韋粲字長蒨，車騎將軍叡之孫，北徐州刺史放之子也。","subject_person_mention_id":"c-liangshu-043-weichan-kin:p001:m0000","object_person_mention_id":"c-liangshu-043-weichan-kin:p001:m0019","source_term":"北徐州刺史放之子也","source_assertion_id":"a-liang043-can-fang"}],"status":"contextual_provisional","human_reviewed":false,"interpretation_note":"一處明稱兄弟，另一處明父，按兩條具名證詞暫接同父。","person_id":"axs_5y7_p7w_AAAD"}],"life_events":[{"id":"le-liang043-weican-構","person_id":"axs_5y7_p7w_AAAD","event_type":"death","source_term":"皆戰死","source_anchor":{"paragraph_id":"c-liangshu-043-weican:p004","start":333,"end":336,"surface":"皆戰死"},"date_expression":null,"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-043","chapter_id":"c-liangshu-043-weican","source_id":"s-liangshu-043-weican-ws2087360","paragraph_id":"c-liangshu-043-weican:p004","quote":"次新亭，賊列陣於中興寺，相持至晚，各解歸。是夜，仲禮入粲營，部分衆軍，旦日將戰，諸將各有據守，令粲頓青塘。青塘當石頭中路，粲慮柵壘未立，賊必爭之，頗以爲憚，謂仲禮曰：「下官才非禦侮，直欲以身殉國。節下善量其宜，不可致有虧喪。」仲禮曰：「青塘立柵，迫近淮渚，欲以糧儲船乘盡就泊之，此是大事，非兄不可。若疑兵少，當更差軍相助。」乃使直閤將軍劉叔胤師助粲，帥所部水陸俱進。時值昏霧，軍人迷失道，比及青塘，夜已過半，壘柵至曉未合。景登禪靈寺門閣，望粲營未立，便率銳卒來攻。軍副王長茂勸據柵待之，粲不從，令軍主鄭逸逆擊之，命劉叔胤以水軍截其後。叔胤畏懦不敢進，逸遂敗。賊乘勝入營，左右牽粲避賊，粲不動，猶叱子弟力戰，兵死略盡，遂見害，時年五十四。粲子尼及三弟助、警、構、從弟昂皆戰死，親戚死者數百人。賊傳粲首闕下，以示城內，太宗聞之流涕曰：「社稷所寄，惟在韋公，如何不幸，先死行陣。」詔贈護軍將軍。世祖平侯景，追諡曰忠貞，並追贈助、警、構及尼皆中書郎，昂員外散騎常侍。","person_mention_id":"c-liangshu-043-weican:p004:m0328"}],"status":"source_attested","interpretation_note":"按同段人物與次第核所屬卒事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"mentions":[{"id":"c-liangshu-043-weican:p004:m0328","start":328,"end":329,"surface":"構","kind":"person","person_id":"axs_5y7_p7w_AAAD","status":"contextual_provisional","paragraph_id":"c-liangshu-043-weican:p004","chapter_id":"c-liangshu-043-weican"},{"id":"c-liangshu-043-weican:p004:m0413","start":413,"end":414,"surface":"構","kind":"person","person_id":"axs_5y7_p7w_AAAD","status":"contextual_provisional","paragraph_id":"c-liangshu-043-weican:p004","chapter_id":"c-liangshu-043-weican"},{"id":"c-liangshu-043-weichan-kin:p002:m0010","start":10,"e