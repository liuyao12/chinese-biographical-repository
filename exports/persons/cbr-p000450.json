{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000450","identity_policy":"contextual_provisional","person_ids":["cbr-p000450"],"persons":[{"id":"cbr-p000450","label":"魏惠王","status":"active","historicity":"historical_tradition","aliases":[{"surface":"魏惠","mention_ids":["c-shiji-005-qin:m055-0020"]},{"surface":"魏惠王","mention_ids":["c-shiji-005-qin:m059-0004","c-shiji-005-qin:m068-0006"]}],"evidence":[{"mention_id":"c-shiji-005-qin:m055-0020","chapter_id":"c-shiji-005-qin","paragraph_id":"c-shiji-005-qin:p055","quote":"魏惠"},{"mention_id":"c-shiji-005-qin:m059-0004","chapter_id":"c-shiji-005-qin","paragraph_id":"c-shiji-005-qin:p059","quote":"魏惠王"},{"mention_id":"c-shiji-005-qin:m068-0006","chapter_id":"c-shiji-005-qin","paragraph_id":"c-shiji-005-qin:p068","quote":"魏惠王"}],"identity_note":"依本卷特定時代與事件暫定人物；不以同稱、官號或短名全域合併，未見本名不補造。","review":"ai_provisional"}],"mentions":[{"id":"c-shiji-005-qin:m055-0020","start":20,"end":22,"surface":"魏惠","kind":"person","person_id":"cbr-p000450","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p055","chapter_id":"c-shiji-005-qin"},{"id":"c-shiji-005-qin:m059-0004","start":4,"end":7,"surface":"魏惠王","kind":"person","person_id":"cbr-p000450","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p059","chapter_id":"c-shiji-005-qin"},{"id":"c-shiji-005-qin:m068-0006","start":6,"end":9,"surface":"魏惠王","kind":"person","person_id":"cbr-p000450","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p068","chapter_id":"c-shiji-005-qin"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-005-qin:p055","text":"孝公元年，河山以東彊國六，與齊威、楚宣、魏惠、燕悼、韓哀、趙成侯并。淮泗之閒小國十餘。楚、魏與秦接界。魏筑長城，自鄭濱洛以北，有上郡。楚自漢中，南有巴、黔中。周室微，諸侯力政，爭相併。秦僻在雍州，不與中國諸侯之會盟，夷翟遇之。孝公於是布惠，振孤寡，招戰士，明功賞。下令國中曰：「昔我繆公自岐雍之閒，修德行武，東平晉亂，以河為界，西霸戎翟，廣地千里，天子致伯，諸侯畢賀，為後世開業，甚光美。會往者厲、躁、簡公、出子之不寧，國家內憂，未遑外事，三晉攻奪我先君河西地，諸侯卑秦、醜莫大焉。獻公即位，鎮撫邊境，徙治櫟陽，且欲東伐，復繆公之故地，修繆公之政令。寡人思念先君之意，常痛於心。賓客群臣有能出奇計彊秦者，吾且尊官，與之分土。」於是乃出兵東圍陜城，西斬戎之獂王。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m055-0000","start":0,"end":2,"surface":"孝公","kind":"person","person_id":"cbr-p000289","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m055-0014","start":14,"end":16,"surface":"齊威","kind":"person","person_id":"cbr-p000448","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m055-0017","start":17,"end":19,"surface":"楚宣","kind":"person","person_id":"cbr-p000449","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m055-0020","start":20,"end":22,"surface":"魏惠","kind":"person","person_id":"cbr-p000450","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m055-0023","start":23,"end":25,"surface":"燕悼","kind":"person","person_id":"cbr-p000451","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m055-0026","start":26,"end":28,"surface":"韓哀","kind":"person","person_id":"cbr-p000452","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m055-0029","start":29,"end":32,"surface":"趙成侯","kind":"person","person_id":"cbr-p000453","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m055-0113","start":113,"end":115,"surface":"孝公","kind":"person","person_id":"cbr-p000289","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m055-0141","start":141,"end":143,"surface":"繆公","kind":"person","person_id":"cbr-p000253","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m055-0197","start":197,"end":200,"surface":"厲、躁","kind":"unresolved","person_id":null,"status":"unresolved","note":"未定指代、群體或官稱；商君語為篇章指引，不當作獨立個人。"},{"id":"c-shiji-005-qin:m055-0201","start":201,"end":203,"surface":"簡公","kind":"person","person_id":"cbr-p000443","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m055-0204","start":204,"end":206,"surface":"出子","kind":"person","person_id":"cbr-p000445","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m055-0225","start":225,"end":227,"surface":"先君","kind":"unresolved","person_id":null,"status":"unresolved","note":"未定指代、群體或官稱；商君語為篇章指引，不當作獨立個人。"},{"id":"c-shiji-005-qin:m055-0241","start":241,"end":243,"surface":"獻公","kind":"person","person_id":"cbr-p000287","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m055-0262","start":262,"end":264,"surface":"繆公","kind":"person","person_id":"cbr-p000253","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m055-0269","start":269,"end":271,"surface":"繆公","kind":"person","person_id":"cbr-p000253","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m055-0279","start":279,"end":281,"surface":"先君","kind":"unresolved","person_id":null,"status":"unresolved","note":"未定指代、群體或官稱；商君語為篇章指引，不當作獨立個人。"},{"id":"c-shiji-005-qin:m055-0327","start":327,"end":329,"surface":"獂王","kind":"unresolved","person_id":null,"status":"unresolved","note":"未定指代、群體或官稱；商君語為篇章指引，不當作獨立個人。"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-005-qin:p059","text":"七年，與魏惠王會杜平。八年，與魏戰元裏，有功。十年，衛鞅為大良造，將兵圍魏安邑，降之。十二年，作為咸陽，筑冀闕，秦徙都之。并諸小鄉聚，集為大縣，縣一令，四十一縣。為田開阡陌。東地渡洛。十四年，初為賦。十九年，天子致伯。二十年，諸侯畢賀。秦使公子少官率師會諸侯逢澤，朝天子。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m059-0004","start":4,"end":7,"surface":"魏惠王","kind":"person","person_id":"cbr-p000450","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m059-0026","start":26,"end":28,"surface":"衛鞅","kind":"person","person_id":"cbr-p000454","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m059-0104","start":104,"end":106,"surface":"天子","kind":"unresolved","person_id":null,"status":"unresolved","note":"未定指代、群體或官稱；商君語為篇章指引，不當作獨立個人。"},{"id":"c-shiji-005-qin:m059-0120","start":120,"end":124,"surface":"公子少官","kind":"person","person_id":"cbr-p000458","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m059-0133","start":133,"end":135,"surface":"天子","kind":"unresolved","person_id":null,"status":"unresolved","note":"未定指代、群體或官稱；商君語為篇章指引，不當作獨立個人。"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-005-qin:p068","text":"武王元年，與魏惠王會臨晉。誅蜀相壯。張儀、魏章皆東出之魏。伐義渠、丹、犁。二年，初置丞相，摢裏疾、甘茂為左右丞相。張儀死於魏。三年，與韓襄王會臨晉外。南公揭卒，摢裏疾相韓。武王謂甘茂曰：「寡人欲容車通三川，窺周室，死不恨矣。」其秋，使甘茂、庶長封伐宜陽。四年，拔宜陽，斬首六萬。涉河，城武遂。魏太子來朝。武王有力好戲，力士任鄙、烏獲、孟說皆至大官。王與孟說舉鼎，絕臏。八月，武王死。族孟說。武王取魏女為后，無子。立異母弟，是為昭襄王。昭襄母楚人，姓羋氏，號宣太后。武王死時，昭襄王為質於燕，燕人送歸，得立。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m068-0000","start":0,"end":2,"surface":"武王","kind":"person","person_id":"cbr-p000480","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0006","start":6,"end":9,"surface":"魏惠王","kind":"person","person_id":"cbr-p000450","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0014","start":14,"end":17,"surface":"蜀相壯","kind":"person","person_id":"cbr-p000479","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0018","start":18,"end":20,"surface":"張儀","kind":"person","person_id":"cbr-p000464","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0021","start":21,"end":23,"surface":"魏章","kind":"person","person_id":"cbr-p000481","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0045","start":45,"end":48,"surface":"摢裏疾","kind":"person","person_id":"cbr-p000466","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0049","start":49,"end":51,"surface":"甘茂","kind":"person","person_id":"cbr-p000482","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0057","start":57,"end":59,"surface":"張儀","kind":"person","person_id":"cbr-p000464","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0067","start":67,"end":70,"surface":"韓襄王","kind":"person","person_id":"cbr-p000483","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0075","start":75,"end":78,"surface":"南公揭","kind":"person","person_id":"cbr-p000484","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0080","start":80,"end":83,"surface":"摢裏疾","kind":"pers