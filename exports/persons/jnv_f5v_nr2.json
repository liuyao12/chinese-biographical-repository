，不宜聽從；取亂侮亡，更俟後會。雖緩歲月，必有可禽之理，差息發動費役之勞。劉楷見甲以助湘中，威力旣舉，蟻寇自服。","mentions":[{"id":"c-nanqishu-040-ziliang:p015:m0160","surface":"叔獻","start":160,"end":162,"person_id":"gy7_lbd_q1p","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-040-ziliang:p015:m0201","surface":"劉楷","start":201,"end":203,"person_id":"jnv_f5v_nr2","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":2272748,"source_layer":"received_biography","first_line":40,"last_line":40,"line_start":3,"line_end":223,"raw_start":2388,"raw_end":2608,"raw_character_offsets":[2388,2389,2390,2391,2392,2393,2394,2395,2396,2397,2398,2399,2400,2401,2402,2403,2404,2405,2406,2407,2408,2409,2410,2411,2412,2413,2414,2415,2416,2417,2418,2419,2420,2421,2422,2423,2424,2425,2426,2427,2428,2429,2430,2431,2432,2433,2434,2435,2436,2437,2438,2439,2440,2441,2442,2443,2444,2445,2446,2447,2448,2449,2450,2451,2452,2453,2454,2455,2456,2457,2458,2459,2460,2461,2462,2463,2464,2465,2466,2467,2468,2469,2470,2471,2472,2473,2474,2475,2476,2477,2478,2479,2480,2481,2482,2483,2484,2485,2486,2487,2488,2489,2490,2491,2492,2493,2494,2495,2496,2497,2498,2499,2500,2501,2502,2503,2504,2505,2506,2507,2508,2509,2510,2511,2512,2513,2514,2515,2516,2517,2518,2519,2520,2521,2522,2523,2524,2525,2526,2527,2528,2529,2530,2531,2532,2533,2534,2535,2536,2537,2538,2539,2540,2541,2542,2543,2544,2545,2546,2547,2548,2549,2550,2551,2552,2553,2554,2555,2556,2557,2558,2559,2560,2561,2562,2563,2564,2565,2566,2567,2568,2569,2570,2571,2572,2573,2574,2575,2576,2577,2578,2579,2580,2581,2582,2583,2584,2585,2586,2587,2588,2589,2590,2591,2592,2593,2594,2595,2596,2597,2598,2599,2600,2601,2602,2603,2604,2605,2606,2607],"projection_sha256":"57d4da797bc5544d3140d3915cd4c1323d0901a9f41b60e5f48f806568aa7204","editorial_excerpt_boundary":true},"chapter_id":"c-nanqishu-040-ziliang","book_id":"b-nanqishu-040","work_id":"w-nanqishu","source_id":"s-nanqishu-040-ziliang-ws2272748"},{"id":"c-nanqishu-058-southern-and-eastern-complete:p032","text":"交州斗絕海島，控帶外國，故恃險數不賓。宋泰始初，刺史張牧卒，交趾人李長仁殺牧北來部曲，據交州叛，數年病死，從弟叔獻嗣事，號令未行，遣使求刺史。宋朝以南海太守沈煥為交州刺史，以叔獻為煥寧遠司馬、武平新昌二郡太守。叔獻得朝命，人情服從，遂發兵守險不納煥，煥停鬱林病卒。太祖建元元年，仍以叔獻為交州刺史，就安慰之。叔獻受命，既而斷割外國，貢獻寡少。世祖欲討之，永明三年，以司農劉楷為交州刺史，發南康、廬陵、始興郡兵征交州。叔獻聞之，遣使願更申數年，獻十二隊純銀兜鍪及孔雀毦，世祖不許。叔獻懼為楷所襲，間道自湘川還朝。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":82,"last_line":82,"raw_start":7092,"raw_end":7439,"raw_character_offsets":[7092,7093,7094,7095,7096,7097,7098,7099,7100,7101,7102,7103,7104,7105,7106,7107,7108,7109,7110,7111,7112,7113,7114,7115,7116,7117,7118,7119,7120,7121,7122,7123,7124,7125,7126,7127,7128,7129,7130,7131,7132,7133,7134,7135,7136,7137,7138,7139,7140,7141,7142,7143,7144,7145,7146,7147,7148,7149,7150,7151,7152,7153,7154,7155,7156,7157,7158,7159,7160,7161,7162,7163,7164,7165,7166,7167,7168,7169,7170,7171,7172,7173,7174,7175,7176,7177,7178,7179,7180,7181,7182,7183,7184,7185,7186,7187,7188,7189,7190,7191,7192,7193,7194,7195,7196,7197,7198,7199,7200,7201,7202,7203,7204,7205,7206,7207,7208,7209,7210,7211,7212,7213,7214,7215,7216,7217,7218,7219,7220,7221,7222,7223,7224,7225,7226,7227,7228,7229,7230,7231,7232,7233,7234,7235,7236,7237,7238,7239,7240,7241,7242,7243,7244,7245,7246,7247,7248,7249,7250,7251,7252,7253,7254,7255,7256,7257,7258,7259,7260,7261,7262,7263,7264,7265,7266,7267,7268,7269,7270,7271,7272,7273,7274,7275,7276,7277,7278,7279,7280,7281,7282,7283,7284,7377,7378,7379,7380,7381,7382,7383,7384,7385,7386,7387,7388,7389,7390,7391,7392,7393,7394,7395,7396,7397,7398,7399,7400,7401,7402,7403,7404,7405,7406,7407,7408,7409,7410,7411,7412,7413,7414,7415,7416,7417,7418,7419,7420,7421,7422,7423,7424,7425,7426,7427,7428,7429,7430,7431,7432,7433,7434,7435,7436,7437,7438],"revision_id":2638629},"mentions":[{"id":"c-nanqishu-058-southern-and-eastern-complete:p032:m0026","start":26,"end":28,"surface":"張牧","kind":"person","person_id":"