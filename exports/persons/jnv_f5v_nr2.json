":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-040-ziliang:p015:m0201","surface":"劉楷","start":201,"end":203,"person_id":"jnv_f5v_nr2","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-nanqishu-040-ziliang:p015","chapter_id":"c-nanqishu-040-ziliang"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-040-ziliang:p015","text":"湘區奧密，蠻寇熾彊，如聞南師未能挫戮。百姓齊民，積年塗炭，疽食侵淫，邊虞方重。交州敻絕一垂，寔惟荒服，恃遠後賔，固亦恒事。自青德啓運，款關受職，置之度外，不足絓言。今縣軍遠伐，經途萬里，衆寡事殊，客主勢異，以逸待勞，全勝難必。又緣道調兵，以足軍力，民丁烏合，事乖習銳。廣州積歲無年，越州兵糧素乏，加以發借，必致恇擾。愚謂叔獻所請，不宜聽從；取亂侮亡，更俟後會。雖緩歲月，必有可禽之理，差息發動費役之勞。劉楷見甲以助湘中，威力旣舉，蟻寇自服。","mentions":[{"id":"c-nanqishu-040-ziliang:p015:m0160","surface":"叔獻","start":160,"end":162,"person_id":"gy7_lbd_q1p","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-040-ziliang:p015:m0201","surface":"劉楷","start":201,"end":203,"person_id":"jnv_f5v_nr2","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":2272748,"source_layer":"received_biography","first_line":40,"last_line":40,"line_start":3,"line_end":223,"raw_start":2388,"raw_end":2608,"raw_character_offsets":[2388,2389,2390,2391,2392,2393,2394,2395,2396,2397,2398,2399,2400,2401,2402,2403,2404,2405,2406,2407,2408,2409,2410,2411,2412,2413,2414,2415,2416,2417,2418,2419,2420,2421,2422,2423,2424,2425,2426,2427,2428,2429,2430,2431,2432,2433,2434,2435,2436,2437,2438,2439,2440,2441,2442,2443,2444,2445,2446,2447,2448,2449,2450,2451,2452,2453,2454,2455,2456,2457,2458,2459,2460,2461,2462,2463,2464,2465,2466,2467,2468,2469,24