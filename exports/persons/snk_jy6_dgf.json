{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"snk_jy6_dgf","canonical_person_id":"snk_jy6_dgf","id_aliases":["cbr-p005358"],"identity_policy":"contextual_provisional","person_ids":["snk_jy6_dgf"],"persons":[{"id":"snk_jy6_dgf","label":"桓嬰（樊酈滕灌列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"桓嬰","mention_ids":["c-shiji-095-fankuang:m024-0279"]}],"evidence":[{"mention_id":"c-shiji-095-fankuang:m024-0279","chapter_id":"c-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p024","quote":"桓嬰"}],"id_aliases":["cbr-p005358"]}],"source_mention_summary":[{"source_id":"s-shiji-095-fankuang","work_id":"w-shiji","book_id":"b-shiji-095","chapter_id":"c-shiji-095-fankuang","mention_count":1,"mention_ids":["c-shiji-095-fankuang:m024-0279"],"paragraph_ids":["c-shiji-095-fankuang:p024"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-095-fankuang"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-095-fankuang:m024-0279","start":279,"end":281,"surface":"桓嬰","kind":"person","person_id":"snk_jy6_dgf","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p024","chapter_id":"c-shiji-095-fankuang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji095-108","person_id":"snk_jy6_dgf","scope":"same_chapter","chapter_ids":["c-shiji-095-fankuang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"第24段王武別將桓嬰整體稱名；不與主傳灌嬰同指。","surfaces":["桓嬰"],"evidence":[{"paragraph_id":"c-shiji-095-fankuang:p024","quote":"復以中謁者從降下碭，以至彭城。項羽擊，大破漢王。漢王遁而西，嬰從還，軍於雍丘。王武、魏公申徒反，從擊破之。攻下黃，西收兵，軍於滎陽。楚騎來眾，漢王乃擇軍中可為（車）騎將者，皆推故秦騎士重泉人李必、駱甲習騎兵，今為校尉，可為騎將。漢王欲拜之，必、甲曰：「臣故秦民，恐軍不信臣，臣願得大王左右善騎者傅之。」灌嬰雖少，然數力戰，乃拜灌嬰為中大夫，令李必、駱甲為左右校尉，將郎中騎兵擊楚騎於滎陽東，大破之。受詔別擊楚軍後，絕其餉道，起陽武至襄邑。擊項羽之將項冠於魯下，破之，所將卒斬右司馬、騎將各一人。擊破柘公王武，軍於燕西，所將卒斬樓煩將五人，連尹一人。擊王武別將桓嬰白馬下，破之，所將卒斬都尉一人。以騎渡河南，送漢王到雒陽，使北迎相國韓信軍於邯鄲。還至敖倉，嬰遷為御史大夫。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-095-fankuang:p024","text":"復以中謁者從降下碭，以至彭城。項羽擊，大破漢王。漢王遁而西，嬰從還，軍於雍丘。王武、魏公申徒反，從擊破之。攻下黃，西收兵，軍於滎陽。楚騎來眾，漢王乃擇軍中可為（車）騎將者，皆推故秦騎士重泉人李必、駱甲習騎兵，今為校尉，可為騎將。漢王欲拜之，必、甲曰：「臣故秦民，恐軍不信臣，臣願得大王左右善騎者傅之。」灌嬰雖少，然數力戰，乃拜灌嬰為中大夫，令李必、駱甲為左右校尉，將郎中騎兵擊楚騎於滎陽東，大破之。受詔別擊楚軍後，絕其餉道，起陽武至襄邑。擊項羽之將項冠於魯下，破之，所將卒斬右司馬、騎將各一人。擊破柘公王武，軍於燕西，所將卒斬樓煩將五人，連尹一人。擊王武別將桓嬰白馬下，破之，所將卒斬都尉一人。以騎渡河南，送漢王到雒陽，使北迎相國韓信軍於邯鄲。還至敖倉，嬰遷為御史大夫。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m024-0015","start":15,"end":17,"surface":"項羽","kind":"person","person_id":"qcp_ou0_2g1","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0021","start":21,"end":23,"surface":"漢王","kind":"person","person_id":"vok_rjp_tag","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0024","start":24,"end":26,"surface":"漢王","kind":"person","person_id":"vok_rjp_tag","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0030","start":30,"end":31,"surface":"嬰","kind":"person","person_id":"mdl_l60_pwy","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0039","start":39,"end":41,"surface":"王武","kind":"person","person_id":"6sl_m8t_cxz","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0044","start":44,"end":46,"surface":"申徒","kind":"person","person_id":"hds_rdm_z1p","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0071","start":71,"end":73,"surface":"漢王","kind":"person","person_id":"vok_rjp_tag","status":"contextual_provisional"},{