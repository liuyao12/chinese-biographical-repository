sions":[],"passages":[{"id":"c-beiqishu-010-gaohuan-peizhiheng:p001","text":"上黨剛肅王渙，字敬壽，神武第七子也。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":24,"last_line":24,"raw_start":2406,"raw_end":2424,"raw_character_offsets":[2406,2407,2408,2409,2410,2411,2412,2413,2414,2415,2416,2417,2418,2419,2420,2421,2422,2423],"revision_id":2432497},"mentions":[{"id":"c-beiqishu-010-gaohuan-peizhiheng:p001:m0000","start":0,"end":6,"surface":"上黨剛肅王渙","kind":"person","person_id":"2c0_xgj_5n3","status":"contextual_provisional"},{"id":"c-beiqishu-010-gaohuan-peizhiheng:p001:m0008","start":8,"end":10,"surface":"敬壽","kind":"person","person_id":"2c0_xgj_5n3","status":"contextual_provisional"}],"chapter_id":"c-beiqishu-010-gaohuan-peizhiheng","book_id":"b-beiqishu-010","work_id":"w-beiqishu","source_id":"s-beiqishu-010-gaohuan-peizhiheng-ws2432497"},{"id":"c-liangshu-006-peizhiheng-dongguan:p001","text":"三月，齊遣其上黨王高渙送貞陽侯蕭淵明來主梁嗣，至東關，遣吳興太守裴之橫與戰，敗績，之橫死。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":12,"last_line":12,"raw_start":392,"raw_end":437,"raw_character_offsets":[392,393,394,395,396,397,398,399,400,401,402,403,404,405,406,407,408,409,410,411,412,413,414,415,416,417,418,419,420,421,422,423,424,425,426,427,428,429,430,431,432,433,434,435,436],"revision_id":2311629},"mentions":[{"id":"c-liangshu-006-peizhiheng-dongguan:p001:m0006","start":6,"end":11,"surface":"上黨王高渙","kind":"person","person_id":"2c0_xgj_5n3","status":"contextual_provisional"},{"id":"c-liangshu-006-peizhiheng-dongguan:p001:m0012","start":12,"end":18,"surface":"貞陽侯蕭淵明","kind":"person","person_id":"qvt_eq1_lcf_ACA","status":"contextual_provisional"},{"id":"c-liangshu-006-peizhiheng-dongguan:p001:m0032","start":32,"end":35,"surface":"裴之橫","kind":"person","person_id":"4kt_0ar_aqo_AAD","status":"contextual_provisional"},{"id":"c-liangshu-006-peizhiheng-dongguan:p001:m0041","start":41,"end":43,"surface":"之橫","kind":"person","person_id":