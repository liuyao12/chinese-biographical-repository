{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"7w8_dnz_gt1","canonical_person_id":"7w8_dnz_gt1","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["7w8_dnz_gt1"],"persons":[{"id":"7w8_dnz_gt1","label":"葛玄〔葛仙公、葛洪從祖〕","status":"active","historicity":"historical_tradition","review":"ai_provisional","aliases":[{"surface":"葛仙公","mention_ids":["c-sanguozhi-063-appraisal:line046-pei01-03:m0009"]},{"surface":"仙公","mention_ids":["c-sanguozhi-063-appraisal:line046-pei01-03:m0056"]}],"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-063","chapter_id":"c-sanguozhi-063-appraisal","source_id":"s-sanguozhi-063-appraisal","paragraph_id":"c-sanguozhi-063-appraisal:line046-pei01-03","mention_id":"c-sanguozhi-063-appraisal:line046-pei01-03:m0009","quote":"葛仙公"},{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-063","chapter_id":"c-sanguozhi-063-appraisal","source_id":"s-sanguozhi-063-appraisal","paragraph_id":"c-sanguozhi-063-appraisal:line046-pei01-03","mention_id":"c-sanguozhi-063-appraisal:line046-pei01-03:m0056","quote":"仙公"}],"identity_note":"依本篇具名、稱謂及其所在原句辨認；引書原字存於各自來源。"}],"source_mention_summary":[{"source_id":"s-sanguozhi-063-appraisal","work_id":"w-sanguozhi","book_id":"b-sanguozhi-063","chapter_id":"c-sanguozhi-063-appraisal","raw_mention_count":2,"mention_ids":["c-sanguozhi-063-appraisal:line046-pei01-03:m0009","c-sanguozhi-063-appraisal:line046-pei01-03:m0056"],"paragraph_ids":["c-sanguozhi-063-appraisal:line046-pei01-03"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-sanguozhi-063-appraisal:line046-pei01-03:m0009","mention_ids":["c-sanguozhi-063-appraisal:line046-pei01-03:m0009"],"kind":"paragraph"},{"canonical_mention_id":"c-sanguozhi-063-appraisal:line046-pei01-03:m0056","mention_ids":["c-sanguozhi-063-appraisal:line046-pei01-03:m0056"],"kind":"paragraph"}],"mention_count":2,"duplicate_mention_count":0,"paragraph_occurrence_count":2,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"2處獨立位置，2個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-sanguozhi-063-appraisal"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-sanguozhi-063-appraisal:line046-pei01-03:reading-000-403","kind":"annotation_sentence","paragraph_id":"c-sanguozhi-063-appraisal:line046-pei01-03","start_codepoint":0,"end_codepoint":403,"source_quote":"《抱樸子》曰：時有葛仙公者，每飲酒醉，常入人家門前陂水中臥，竟日乃出。曾從吳主別，到洌州，還遇大風，百官船多沒，仙公船亦沉淪，吳主甚悵恨。明日使人鈎求公船，而登高以望焉。久之，見公步從水上來，衣履不沾，而有酒色。既見而言曰：「臣昨侍從而伍子胥見請，暫過設酒，忽忽不得，即委之。」又有姚光者，有火術。吳主身臨試之，積荻數千束，使光坐其上，又以數千束荻裹之，因猛風而燔之。荻了盡，謂光當以化爲燼，而光端坐灰中，振衣而起，把一卷書。吳主取其書視之，不能解也。又曰：吳景帝有疾，求覡視者，得一人。景帝欲試之，乃殺鵝而埋於苑中，架小屋，施牀几，以婦人屐履服物著其上，乃使覡視之。告曰：「若能說此冢中鬼婦人形狀者，當加賞而即信矣。」竟日盡夕無言，帝推問之急，乃曰：「實不見有鬼，但見一頭白鵝立墓上，所以不即白之，疑是鬼神變化作此相，當候其真形而定。無復移易，不知何故，不敢不以實上聞。」景帝乃厚賜之。然則鵝死亦有鬼也。","person_id":"7w8_dnz_gt1","related_person_ids":["572_278_cba","g9h_5ih_ug1_A","9ej_0jk_rg3","0fo_c5c_4yh"],"reading":"裴注引抱樸子，依次述葛仙公、姚光、景帝試覡；術事是引書故事。晉書葛洪傳明從祖玄號葛仙公。","chapter_id":"c-sanguozhi-063-appraisal","source_id":"s-sanguozhi-063-appraisal"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-063-appraisal:line046-pei01-03:m0009","start":9,"end":12,"surface":"葛仙公","kind":"person","person_id":"7w8_dnz_gt1","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-063-appraisal:line046-pei01-03","chapter_id":"c