ntion_id":"c-jinshu-072-gehong:p001:m0182","mention_ids":["c-jinshu-072-gehong:p001:m0182"],"kind":"paragraph"}],"mention_count":2,"duplicate_mention_count":0,"paragraph_occurrence_count":2,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"2處獨立位置，2個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"},{"source_id":"s-sanguozhi-063-appraisal","work_id":"w-sanguozhi","book_id":"b-sanguozhi-063","chapter_id":"c-sanguozhi-063-appraisal","raw_mention_count":2,"mention_ids":["c-sanguozhi-063-appraisal:line046-pei01-03:m0009","c-sanguozhi-063-appraisal:line046-pei01-03:m0056"],"paragraph_ids":["c-sanguozhi-063-appraisal:line046-pei01-03"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-sanguozhi-063-appraisal:line046-pei01-03:m0009","mention_ids":["c-sanguozhi-063-appraisal:line046-pei01-03:m0009"],"kind":"paragraph"},{"canonical_mention_id":"c-sanguozhi-063-appraisal:line046-pei01-03:m0056","mention_ids":["c-sanguozhi-063-appraisal:line046-pei01-03:m0056"],"kind":"paragraph"}],"mention_count":2,"duplicate_mention_count":0,"paragraph_occurrence_count":2,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"2處獨立位置，2個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-072-gehong-ws2595548","s-sanguozhi-063-appraisal"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-jinshu-072-gehong:kinship1-169","kind":"kinship","person_id":"7w8_dnz_gt1","source_quote":"從祖玄，吳時學道得仙，號曰葛仙公","reading":"所見稱從祖。與葛洪祖系、父悌分錄，未具從祖的中間世系。","note":"所見稱從祖。與葛洪祖系、父悌分錄，未具從祖的中間世系。","paragraph_id":"c-jinshu-072-gehong:p001","start_codepoint":169,"end_codepoint":185,"human_reviewed":false,"chapter_id":"c-jinshu-072-gehong","source_id":"s-jinshu-072-gehong-ws2595548"},{"id":"c-sanguozhi-063-appraisal:line046-pei01-03:reading-000-403","kind":"annotation_sentence","paragraph_id":"c-sanguozhi-063-appraisal:line046-pei01-03","start_codepoint":0,"end_codepoint":403,"source_quote":"《抱樸子》曰：時有葛仙公者，每飲酒醉，常入人家門前陂水中臥，竟日乃出。曾從吳主別，到洌州，還遇大風，百官船多沒，仙公船亦沉淪，吳主甚悵恨。明日使人鈎求公船，而登高以望焉。久之，見公步從水上來，衣履不沾，而有酒色。既見而言曰：「臣昨侍從而伍子胥見請，暫過設酒，忽忽不得，即委之。」又有姚光者，有火術。吳主身臨試之，積荻數千束，使光坐其上，又以數千束荻裹之，因猛風而燔之。荻了盡，謂光當以化爲燼，而光端坐灰中，振衣而起，把一卷書。吳主取其書視之，不能解也。又曰：吳景帝有疾，求覡視者，得一人。景帝欲試之，乃殺鵝而埋於苑中，架小屋，施牀几，以婦人屐履服物著其上，乃使覡視之。告曰：「若能說此冢中鬼婦人形狀者，當加賞而即信矣。」竟日盡夕無言，帝推問之急，乃曰：「實不見有鬼，但見一頭白鵝立墓上，所以不即白之，疑是鬼神變化作此相，當候其真形而定。無復移易，不知何故，不敢不以實上聞。」景帝乃厚賜之。然則鵝死亦有鬼也。","person_id":"7w8_dnz_gt1","related_person_ids":["572_278_cba","g9h_5ih_ug1_A","9ej_0jk_rg3","0fo_c5c_4yh"],"reading":"裴注引抱樸子，依次述葛仙公、姚光、景帝試覡；術事是引書故事。晉書葛洪傳明從祖玄號葛仙公。","chapter_id":"c-sanguozhi-063-appraisal","source_id":"s-sanguozhi-063-appraisal"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-072-gehong:p001:m0171","surface":"玄","start":171,"end":172,"person_id":"7w8_dnz_gt1","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-072-gehong:p001","chapter_id":"c-jinshu-072-gehong"},{"id":"c-jinshu-072-gehong:p001:m0182","surface":"葛仙公","start":182,"end":185,"person_id":"7w8_dnz_gt1","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-072-gehong:p001","chapter_id":"c-jinshu-072-gehong"},{"id":"c-sanguozhi-063-appraisal:line046-pei01-03:m0009","start":9,"end":12,"surface":"葛仙公","kind":"person","person_id":"7w8_dnz_gt1","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-063-appraisal:line046-pei01-03","chapter_id":"c-sanguozhi-063-appraisal"},{"id":"c-sanguozhi-063-appraisal:line046-pei01-03:m0056","start":56,"end":58,"surface":"仙公","kind":"person","person_id":"7w8_dnz_gt1","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-063-appraisal:line046-pei01-03","chapter_id":"c-sanguozhi-063-appraisal"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-072-gehong:p001","text":"葛洪，字稚川，丹陽句容人也。祖系，吳大鴻臚。父悌，吳平後入晉，為邵陵太守。洪少好學，家貧，躬自伐薪以貿紙筆，夜輒寫書誦習，遂以儒學知名。性寡欲，無所愛玩，不知棋局幾道，摴蒱齒名。為人木訥，不好榮利，閉門卻掃，未嘗交遊。于余杭山見何幼道、郭文舉，目擊而已，各無所言。時或尋書問義，不遠數千里崎嶇冒涉，期於必得，遂究覽典籍，尤好神仙導養之法。從祖玄，吳時學道得仙，號曰葛仙公，以其練丹秘術授弟子鄭隱。洪就隱學，悉得其法焉。後師事南海太守上党鮑玄。玄亦內學，逆占將來，見洪深重之，以女妻洪。洪傳玄業，兼綜練醫術，凡所著撰，皆精核是非，而才章富贍。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":75,"last_line":75,"raw_start":6593,"raw_end":6863,"raw_character_offsets":[6593,6594,6595,6596,6597,6598,6599,6600,6601,6602,6603,6604,6605,6606,6607,6608,6609,6610,6611,6612,6613,6614,6615,6616,6617,6618,6619,6620,6621,6622,6623,6624,6625,6626,6627,6628,6629,6630,6631,6632,6633,6634,6635,6636,6637,6638,6639,6640,6641,6642,6643,6644,6645,6646,6647,6648,6649,6650,6651,6652,6653,6654,6655,6656,6657,6658,6659,6660,6661,6662,6663,6664,6665,6666,6667,6668,6669,6670,6671,6672,6673,6674,6675,6676,6677,6678,6679,6680,6681,6682,6683,6684,6685,6686,6687,6688,6689,6690,6691,6692,6693,6694,6695,6696,6697,6698,6699,6700,6701,6702,6703,6704,6705,6706,6707,6708,6709,6710,6711,6712,6713,6714,6715,6716,6717,6718,6719,6720,6721,6722,6723,6724,6725,6726,6727,6728,6729,6730,6731,6732,6733,6734,6735,6736,6737,6738,6739,6740,6741,6742,6743,6744,6745,6746,6747,6748,6749,6750,6751,6752,6753,6754,6755,6756,6757,6758,6759,6760,6761,6762,6763,6764,6765,6