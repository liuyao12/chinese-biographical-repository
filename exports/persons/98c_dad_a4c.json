ds":["c-nanqishu-049-wanghuan-complete:p010:m0082"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-liangshu-016-zhangji-ws1508503","s-nanqishu-049-wanghuan-complete-ws2261984"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-liangshu-016-zhangji:p002:m0268","start":268,"end":271,"surface":"陳顯達","kind":"person","person_id":"98c_dad_a4c","status":"contextual_provisional","paragraph_id":"c-liangshu-016-zhangji:p002","chapter_id":"c-liangshu-016-zhangji"},{"id":"c-nanqishu-049-wanghuan-complete:p010:m0082","start":82,"end":85,"surface":"陳顯達","kind":"person","person_id":"98c_dad_a4c","status":"contextual_provisional","paragraph_id":"c-nanqishu-049-wanghuan-complete:p010","chapter_id":"c-nanqishu-049-wanghuan-complete"}],"relations":[],"title_holdings":[{"id":"th-liangshu-016-zhangji-2-264","title":"江州刺史","kind":"office","mode":"attestation","person_id":"98c_dad_a4c","attestations":[{"id":"th-liangshu-016-zhangji-2-264:a","paragraph_id":"c-liangshu-016-zhangji:p002","start":264,"end":268,"surface":"江州刺史","person_mention_id":"c-liangshu-016-zhangji:p002:m0268","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-016","chapter_id":"c-liangshu-016-zhangji","source_id":"s-liangshu-016-zhangji-ws1508503","paragraph_id":"c-liangshu-016-zhangji:p002","quote":"齊永明中，爲剡縣令，略不視事，多爲山水遊。會賊唐㝢之作亂，稷率厲縣人，保全縣境。入爲太子洗馬，大司馬東曹掾，建安王友，大司馬從事中郎。武陵王曅爲護軍，轉護軍司馬，尋爲本州治中。明帝領牧，仍爲別駕。時魏寇壽春，以稷爲寧朔將軍、軍主，副尚書僕射沈文季鎮豫州。魏衆稱百萬，圍城累日，時經略處分，文季悉委稷焉。軍退，遷平西司馬、寧朔將軍、南平內史。魏又寇雍州，詔以本號都督荊、雍諸軍事。時雍州刺史曹虎度樊城岸，以稷知州事。魏師退，稷還荊州，就拜黃門侍郎，復爲司馬、新興、永寧二郡太守。郡犯私諱，改永寧爲長寧。尋遷司徒司馬，加輔國將軍。及江州刺史陳顯達舉兵反，以本號鎮歷陽、南譙二郡太守，遷鎮南長史、尋陽太守、輔國將軍、行江州事。尋徵還，爲持節、輔國將軍、都督北徐州諸軍事、北徐州刺史。出次白下，仍遷都督南兗州諸軍事、南兗州刺史。俄進督北徐、徐、兗、青、冀五州諸軍事，將軍並如故。永元末，徵爲侍中，宿衛宮城。義師至，兼衛尉江淹出奔。稷兼衛尉，副王瑩都督城內諸軍事。","person_mention_id":"c-liangshu-016-zhangji:p002:m0268"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-016-zhangji:p002","text":"齊永明中，爲剡縣令，略不視事，多爲山水遊。會賊唐㝢之作亂，稷率厲縣人，保全縣境。入爲太子洗馬，大司馬東曹掾，建安王友，大司馬從事中郎。武陵王曅爲護軍，轉護軍司馬，尋爲本州治中。明帝領牧，仍爲別駕。時魏寇壽春，以稷爲寧朔將軍、軍主，副尚書僕射沈文季鎮豫州。魏衆稱百萬，圍城累日，時經略處分，文季悉委稷焉。軍退，遷平西司馬、寧朔將軍、南平內史。魏又寇雍州，詔以本號都督荊、雍諸軍事。時雍州刺史曹虎度樊城岸，以稷知州事。魏師退，稷還荊州，就拜黃門侍郎，復爲司馬、新興、永寧二郡太守。郡犯私諱，改永寧爲長寧。尋遷司徒司馬，加輔國將軍。及江州刺史陳顯達舉兵反，以本號鎮歷陽、南譙二郡太守，遷鎮南長史、尋陽太守、輔國將軍、行江州事。尋徵還，爲持節、輔國將軍、都督北徐州諸軍事、北徐州刺史。出次白下，仍遷都督南兗州諸軍事、南兗州刺史。俄進督北徐、徐、兗、青、冀五州諸軍事，將軍並如故。永元末，徵爲侍中，宿衛宮城。義師至，兼衛尉江淹出奔。稷兼衛尉，副王瑩都督城內諸軍事。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":32,"last_line":32,"raw_start":1983,"raw_end":2410,"raw_character_offsets":[1983,1984,1985,1986,1987,1988,1989,1990,1991,1992,1993,1994,1995,1996,1997,1998,1999,2000,2001,2002,2003,2004,2005,2006,2007,2008,2009,2010,2011,2012,2013,2014,2015,2016,2017,2018,2019,2020,2021,2022,2023