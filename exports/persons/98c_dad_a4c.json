":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-liangshu-016-zhangji:p002:m0268","start":268,"end":271,"surface":"陳顯達","kind":"person","person_id":"98c_dad_a4c","status":"contextual_provisional","paragraph_id":"c-liangshu-016-zhangji:p002","chapter_id":"c-liangshu-016-zhangji"},{"id":"c-nanqishu-040-zhaozhou:p003:m0001","surface":"陳顯達","start":1,"end":4,"person_id":"98c_dad_a4c","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-nanqishu-040-zhaozhou:p003","chapter_id":"c-nanqishu-040-zhaozhou"},{"id":"c-nanqishu-049-wanghuan-complete:p010:m0082","start":82,"end":85,"surface":"陳顯達","kind":"person","person_id":"98c_dad_a4c","status":"contextual_provisional","paragraph_id":"c-nanqishu-049-wanghuan-complete:p010","chapter_id":"c-nanqishu-049-wanghuan-complete"}],"relations":[],"title_holdings":[{"id":"th-liangshu-016-zhangji-2-264","title":"江州刺史","kind":"office","mode":"attestation","person_id":"98c_dad_a4c","attestations":[{"id":"th-liangshu-016-zhangji-2-264:a","paragraph_id":"c-liangshu-016-zhangji:p002","start":264,"end":268,"surface":"江州刺史","person_mention_id":"c-liangshu-016-zhangji:p002:m0268","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-016","chapter_id":"c-liangshu-016-zhangji","source_id":"s-liangshu-016-zhangji-ws1508503","paragraph_id":"c-liangshu-016-zhangji:p002","quote":"齊永明中，爲剡縣令，略不視事，多爲山水遊。會賊唐㝢之作亂，稷率厲縣人，保全縣境。入爲太子洗馬，大司馬東曹掾，建安王友，大司馬從事中郎。武陵王曅爲護軍，轉護軍司馬，尋爲本州治中。明帝領牧，仍爲別駕。時魏寇壽春，以稷爲寧朔將軍、軍主，副尚書僕射沈文季鎮豫州。魏衆稱百萬，圍城累日，時經略處分，文季悉委稷焉。軍退，遷平西司馬、寧朔將軍、南平內史。魏又寇雍州，詔以本號都督荊、雍諸軍事。時雍州刺史曹虎度樊城岸，以稷知州事。魏師退，稷還荊州，就拜黃門侍郎，復爲司馬、新興、永寧二郡太守。郡犯私諱，改永寧爲長寧。尋遷司徒司馬，加輔國將軍。及江州刺史陳顯達舉兵反，以本號鎮歷陽、南譙二郡太守，遷鎮南長史、尋陽太守、輔國將軍、行江州事。尋徵還，爲持節、輔國將軍、都督北徐州諸軍事、北徐州刺史。出次白下，仍遷都督南兗州諸軍事、南兗州刺史。俄進督北徐、徐、兗、青、冀五州諸軍事，將軍並如故。永元末，徵爲侍中，宿衛宮城。義師至，兼衛尉江淹出奔。稷兼衛尉，副王瑩都督城內諸軍事。","person_mention_id":"c-liangshu-016-zhangji:p002:m0268"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-016-zhangji:p002","text":"齊永明中，爲剡縣令，略不視事，多爲山水遊。會賊唐㝢之作亂，稷率厲縣人，保全縣境。入爲太子洗馬，大司馬東曹掾，建安王友，大司馬從事中郎。武陵王曅爲護軍，轉護軍司馬，尋爲本州治中。明帝領牧，仍爲別駕。時魏寇壽春，以稷爲寧朔將軍、軍主，副尚書僕射沈文季鎮豫州。魏衆稱百萬，圍城累日，時經略處分，文季悉委稷焉。軍退，遷平西司馬、寧朔將軍、南平內史。魏又寇雍州，詔以本號都督荊、雍諸軍事。時雍州刺史曹虎度樊城岸，以稷知州事。魏師退，稷還荊州，就拜黃門侍郎，復爲司馬、新興、永寧二郡太守。郡犯私諱，改永寧爲長寧。尋遷司徒司馬，加輔國將軍。及江州刺史陳顯達舉兵反，以本號鎮歷陽、南譙二郡太守，遷鎮南長史、尋陽太守、輔國將軍、行江州事。尋徵還，爲持節、輔國將軍、都督北徐州諸軍事、北徐州刺史。出次白下，仍遷都督南兗州諸軍事、南兗州刺史。俄進督北徐、徐、兗、青、冀五州諸軍事，將軍並如故。永元末，徵爲侍中，宿衛宮城。義師至，兼衛尉江淹出奔。稷兼衛尉，副王瑩都督城內諸軍事。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":32,"last_line":32,"raw_start":1983,"raw_end":2410,"raw_character_offsets":[1983,1984,1985,1986,1987,1988,1989,1990,1991,1992,1993,1994,1995,1996,1997,1998,1999,2000,2001,2002,2003,2004,2005,2006,2007,2008,2009,2010,2011,2012,2013,2014,2015,2016,2017,2018,2019,2020,2021,2022,2023,2024,2025,2026,2027,2028,2029,2030,2031,2032,2033,2034,2035,2036,2037,2038,2039,2040,2041,2042,2043,2044,2045,2046,2047,2048,2049,2050,2051,2052,2053,2054,2055,2056,2057,2058,2059,2060,2061,2062,2063,2064,2065,2066,2067,2068,2069,2070,2071,2072,2073,2074,2075,2076,2077,2078,2079,2080,2081,2082,2083,2084,2085,2086,2087,2088,2089,2090,2091,2092,2093,2094,2095,2096,2097,2098,2099,2100,2101,2102,2103,2104,2105,2106,2107,2108,2109,2110,2111,2112,2113,2114,2115,2116,2117,2118,2119,2120,2121,2122,2123,2124,2125,2126,2127,2128,2129,2130,2131,2132,2133,2134,2135,2136,2137,2138,2139,2140,2141,2142,2143,2144,2145,2146,2147,2148,2149,2150,2151,2152,2153,2154,2155,2156,2157,2158,2159,2160,2161,2162,2163,2164,