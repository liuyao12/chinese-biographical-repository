angshu-016-zhangji:p002:m0417","start":417,"end":419,"surface":"王瑩","kind":"person","person_id":"7r6_k52_qji_ABAACAABCA","status":"contextual_provisional"}],"chapter_id":"c-liangshu-016-zhangji","book_id":"b-liangshu-016","work_id":"w-liangshu","source_id":"s-liangshu-016-zhangji-ws1508503"},{"id":"c-nanqishu-049-wanghuan-complete:p010","text":"興祖在獄，嗛苦望下，旣蒙降旨，欣願始遂，豈容於此，方復自經？敕以十九日至，興祖以二十一日死，推理檢迹，灼然矯假。尋敕使送下，奐輙拒詔，所謗諸條，悉出奐意。毀故丞相若陳顯達，誹訕朝事，莫此之深。彪私隨父之鎮，敢亂王法，罪竝合窮戮。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":29,"last_line":29,"raw_start":1696,"raw_end":1810,"raw_character_offsets":[1696,1697,1698,1699,1700,1701,1702,1703,1704,1705,1706,1707,1708,1709,1710,1711,1712,1713,1714,1715,1716,1717,1718,1719,1720,1721,1722,1723,1724,1725,1726,1727,1728,1729,1730,1731,1732,1733,1734,1735,1736,1737,1738,1739,1740,1741,1742,1743,1744,1745,1746,1747,1748,1749,1750,1751,1752,1753,1754,1755,1756,1757,1758,1759,1760,1761,1762,1763,1764,1765,1766,1767,1768,1769,1770,1771,1772,1773,1774,1775,1776,1777,1778,1779,1780,1781,1782,1783,1784,1785,1786,1787,1788,1789,1790,1791,1792,1793,1794,1795,1796,1797,1798,1799,1800,1801,1802,1803,1804,1805,1806,1807,1808,1809],"revision_id":2261984},"mentions":[{"id":"c-nanqishu-049-wanghuan-complete:p010:m0000","start":0,"end":2,"surface":"興祖","kind":"person","person_id":"rsy_qes_ab1","status":"contextual_provisional"},{"id":"c-nanqishu-049-wanghuan-complete:p010:m0037","start":37,"end":39,"surface":"興祖","kind":"person","person_id":"rsy_qes_ab1","status":"contextual_provisional"},{"id":"c-nanqishu-049-wanghuan-complete:p010:m0062","start":62,"end":63,"surface":"奐","kind":"person","person_id":"q7m_r8k_2vn_AA","status":"contextual_provisional"},{"id":"c-nanqishu-049-wanghuan-complete:p010:m0074","start":74,"end":75,"surface":"奐","kind":"person","person_id":"q7m_r8k_2vn_AA","status":"contextual_provisional"},{"id":"c-nanqishu-049-wanghuan-complete:p010:m0078","start":78,"end":81,"surface":"故丞相","kind":"unresol