{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"nw1_csn_wum","canonical_person_id":"nw1_csn_wum","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["nw1_csn_wum"],"persons":[{"id":"nw1_csn_wum","label":"紀僧真（丹陽建康人）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"紀僧真","mention_ids":["c-nanqishu-047-wangrong:p022:m0352"]}],"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-047","source_id":"s-nanqishu-047-wangrong-ws1492435","chapter_id":"c-nanqishu-047-wangrong","paragraph_id":"c-nanqishu-047-wangrong:p022","quote":"紀僧真","mention_id":"c-nanqishu-047-wangrong:p022:m0352"}],"review":"ai_provisional","identity_note":"齊五十六具傳；王融答辭稱其奉宣先敕。"}],"source_mention_summary":[{"source_id":"s-nanqishu-047-wangrong-ws1492435","work_id":"w-nanqishu","book_id":"b-nanqishu-047","chapter_id":"c-nanqishu-047-wangrong","raw_mention_count":1,"mention_ids":["c-nanqishu-047-wangrong:p022:m0352"],"paragraph_ids":["c-nanqishu-047-wangrong:p022"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-nanqishu-047-wangrong:p022:m0352","mention_ids":["c-nanqishu-047-wangrong:p022:m0352"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-nanqishu-047-wangrong-ws1492435"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-047-wangrong:p022:m0352","surface":"紀僧真","start":352,"end":355,"person_id":"nw1_csn_wum","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-nanqishu-047-wangrong:p022","chapter_id":"c-nanqishu-047-wangrong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-047-wangrong:p022","text":"世祖疾篤暫絕，子良在殿內，太孫未入，融戎服絳衫，於中書省閤口斷東宮仗不得進，欲立子良。上旣蘇，太孫入殿，朝事委高宗。融知子良不得立，乃釋服還省。歎曰：「公誤我。」鬱林深忿疾融，卽位十餘日，收下廷尉獄，然後使中丞孔稚珪倚爲奏曰：「融姿性剛險，立身浮競，動迹驚羣，抗言異類。近塞外微塵，苦求將領，遂招納不逞，扇誘荒傖。狡筭聲勢，專行權利，反覆脣齒之閒，傾動頰舌之內。威福自己，無所忌憚，誹謗朝政，歷毀王公，謂己才流，無所推下，事曝遠近，使融依源據答。」融辭曰：「囚寔頑蔽，觸行多諐，但夙忝門素，得奉教君子。爰自總髮，迄將立年，州閭郷黨，見許愚慎，朝廷衣冠，謂無舋咎。過蒙大行皇帝獎育之恩，又荷文皇帝識擢之重，司徒公賜預士林，安陸王曲垂眄接。旣身被國慈，必欲以死自效，前後陳伐虜之計，亦仰簡先朝。今假犬羊乍擾，紀僧真奉宣先敕，賜語北邊動靜，令囚草撰符詔，于時卽因啓聞，希侍鑾輿。及司徒宣敕招募，同例非一，實以戎事不小，不敢承教。續蒙軍號，賜使招集，銜敕而行，非敢虛扇。且格取亡叛，不限傖楚，『狡笇聲勢』，應有形迹。『專行權利』，又無贓賄。『反覆脣齒之間』，未審悉與誰言？『傾動頰舌之內』，不容都無主此。但聖主膺教，實所沐浴，自上《甘露頌》及《銀甕啓》、《三日詩序》、《接虜使語辭》，竭思稱揚，得非『誹謗』？且王公百司，唯賢是與，高下之敬，等秩有差，不敢踰濫，豈應『訾毀』？囚才分本劣，謬被策用，悚怍之情，夙宵兢惕，未嘗誇示里閭，彰曝遠邇，自循自省，竝愧流言。良由緣淺寡虞，致貽囂謗。伏惟明皇臨宇，普天蒙澤，戊寅赦恩，輕重必宥。百日曠期，始蒙旬日，一介罪身，獨嬰憲劾。若事實有徵，爰對有在，九死之日，無恨泉壤。」詔於獄賜死。時年二十七。臨死歎曰：「我若不爲百歲老母，當吐一言。」融意欲指斥帝在東宮時過失也。","mentions":[{"id":"c-nanqishu-047-wangrong:p022:m0007","surface":"子良","start":7,"end":9,"person_id":"x3q_cqm_dup","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-047-wangrong:p022:m0018","surface":"融","start":18,"end":19,"person_id":"euq_wt7_i8i","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-047-wangrong:p022:m0040","surface":"子良","start":40,"end":42,"person_id":"x3q_cqm_dup","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-047-wangrong:p022:m0058","surface":"融","start":58,"end":59,"person_id":"euq_wt7_i8i","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-047-wangrong:p022:m0060","surface":"子良","start":60,"end":62,"person_id":"x3q_cqm_dup","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-047-wangrong:p022:m0086","surface":"融","start":86,"end":87,"person_id":"euq_wt7_i8i","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-047-wangrong:p022:m0105","surface":"孔稚珪","start":105,"end":108,"person_id":"z6r_wtu_wuj","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-047-wangrong:p022:m0114","surface":"融","start":114,"end":115,"person_id":"euq_wt7_i8i","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-047-wangrong:p022:m0217","surface":"融","start":217,"end":218,"person_id":"euq_wt7_i8i","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-047-wangrong:p022:m0224","surface":"融","start":224,"end":225,"person_id":"euq_wt7_i8i","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-047-wangrong:p022:m0352","surface":"紀僧真","start":352,"end":355,"person_id":"nw1_csn_wum","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-047-wangrong:p022:m0499","surface":"聖主","start":499,"end":501,"person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"答辭上於鬱林，後舉諸頌、詩序、接使語多作於世祖朝，句內所指未遽定。","candidate_person_ids":["iop_ybd_afm","kix_r92_2ed"]},{"id":"c-nanqishu-047-wangrong:p022:m0735","surface":"融","start":735,"end":736,"person_id":"euq_wt7_i8i","kind":"person","status":"contextual_provisional","interpretation_no