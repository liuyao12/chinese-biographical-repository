d":"c-shiji-043-zhao:m008-0003","start":3,"end":6,"surface":"晉獻公","kind":"person","person_id":"1dh_qy1_ptc","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p008","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m008-0071","start":71,"end":74,"surface":"晉獻公","kind":"person","person_id":"1dh_qy1_ptc","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p008","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m010-0004","start":4,"end":7,"surface":"晉獻公","kind":"person","person_id":"1dh_qy1_ptc","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p010","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m026-0145","start":145,"end":147,"surface":"獻公","kind":"person","person_id":"1dh_qy1_ptc","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p026","chapter_id":"c-shiji-043-zhao"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji043-020","person_id":"1dh_qy1_ptc","surfaces":["晉獻公","獻公"],"scope":"same_chapter","chapter_ids":["c-shiji-043-zhao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-043-zhao:p008","quote":"趙夙，晉獻公之十六年伐霍、魏、耿，而趙夙爲將伐霍。霍公求奔齊。晉大旱，卜之，曰「霍太山爲祟」。使趙夙召霍君於齊，復之，以奉霍太山之祀，晉復穰。晉獻公賜趙夙耿。"},{"paragraph_id":"c-shiji-043-zhao:p010","quote":"趙衰卜事晉獻公及諸公子，莫吉；卜事公子重耳，吉，卽事重耳。重耳以驪姬之亂亡奔翟，趙衰從。翟伐廧咎如，得二女，翟以其少女妻重耳，長女妻趙衰而生盾。初，重耳在晉時，趙衰妻亦生趙同、趙括、趙嬰齊。趙衰從重耳出亡，凡十九年，得反國。重耳爲晉文公，趙衰爲原大夫，居原，任國政。文公所以反國及霸，多趙衰計策，語在晉事中。"},{"paragraph_id":"c-shiji-043-zhao:p026","quote":"趙簡子疾，五日不知人，大夫皆懼。醫扁鵲視之，出，董安于問。扁鵲曰：「血脈治也，而何怪！在昔秦繆公嘗如此，七日而寤。寤之日，告公孫支與子輿曰：『我之帝所甚樂。吾所以久者，適有學也。帝告我：「晉國將大亂，五世不安；其後將霸，未老而死；霸者之子且令而國男女無別。」』公孫支書而藏之，秦讖於是出矣。獻公之亂，文公之霸，而襄公敗秦師於殽而歸縱淫，此子之所聞。今主君之疾與之同，不出三日疾必閒，閒必有言也。」"}],"rationale":"限本篇明示名字、是為與連續事件暫接異稱；真孤與替代兒分開，馬匹、群體與闕代不當個人，不以模型記憶補熟知姓名。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-043-zhao:p008","text":"趙夙，晉獻公之十六年伐霍、魏、耿，而趙夙爲將伐霍。霍公求奔齊。晉大旱，卜之，曰「霍太山爲祟」。使趙夙召霍君於齊，復之，以奉霍太山之祀，晉復穰。晉獻公賜趙夙耿。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-043-zhao:m008-0000","start":0,"end":2,"surface":"趙夙","kind":"person","person_id":"0xt_iyn_d3t","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m008-0003","start":3,"end":6,"surface":"晉獻公","kind":"person","person_id":"1dh_qy1_ptc","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m008-0018","start":18,"end":20,"surface":"趙夙","kind":"person","person_id":"0xt_iyn_d3t","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m008-0025","start":25,"end":27,"surface":"霍公","kind":"person","person_id":"l9w_xva_6q0","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m008-0040","start":40,"end":43,"surface":"霍太山","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、神祇、馬匹、校勘或未定稱呼保留；不補名字、成員或闕代，故事說詞不作真孤被殺證據。"},{"id":"c-shiji-043-zhao:m008-0048","start":48,"end":50,"surface":"趙夙","kind":"person","person_id":"0xt_iyn_d3t","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m008-0051","start":51,"end":53,"surface":"霍君","kind":"person","person_id":"l9w_xva_6q0","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m008-0061","start":61,"end":64,"surface":"霍太山","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、神祇、馬匹、校勘或未定稱呼保留；不補名字、成員或闕代，故事說詞不作真孤被殺證據。"},{"id":"c-shiji-043-zhao:m008-0071","start":71,"end":74,"surface":"晉獻公","kind":"person","person_id":"1dh_qy1_ptc","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m008-0075","start":75,"end":77,"surface":"趙夙","kind":"person","person_id":"0xt_iyn_d3t","status":"contextual_provisional"}],"chapter_id":"c-shiji-043-zhao","book_id":"b-shiji-043","work_id":"w-shiji","source_id":"s-shiji-043-zhao"},{"id":"c-shiji-043-zhao:p010","text":"趙衰卜事晉獻公及諸公子，莫吉；卜事公子重耳，吉，卽事重耳。重耳以驪姬之亂亡奔翟，趙衰從。翟伐廧咎如，得二女，翟以其少女妻重耳，長女妻趙衰而生盾。初，重耳在晉時，趙衰妻亦生趙同、趙括、趙嬰齊。趙衰從重耳出亡，凡十九年，得反國。重耳爲晉文公，趙衰爲原大夫，居原，任國政。文公所以反國及霸，多趙衰計策，語在晉事中。