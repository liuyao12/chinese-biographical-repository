"chapter_id":"c-shiji-037-wei","book_id":"b-shiji-037","work_id":"w-shiji","source_id":"s-shiji-037-wei"},{"id":"c-shiji-037-wei:p053","text":"太史公曰：余讀世家言，至於宣公之太子以婦見誅，弟壽爭死以相讓，此與晉太子申生不敢明驪姬之過同，倶惡傷父之志。然卒死亡，何其悲也！或父子相殺，兄弟相滅，亦獨何哉？","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-037-wei:m053-0000","start":0,"end":3,"surface":"太史公","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、並稱、匿名者、校勘或尚未定指代；不補姓名、親屬、闕代或成員。"},{"id":"c-shiji-037-wei:m053-0013","start":13,"end":15,"surface":"宣公","kind":"person","person_id":"cbr-p001549","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m053-0016","start":16,"end":18,"surface":"太子","kind":"person","person_id":"cbr-p001553","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m053-0024","start":24,"end":25,"surface":"壽","kind":"person","person_id":"cbr-p001556","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m053-0033","start":33,"end":38,"surface":"晉太子申生","kind":"person","person_id":"cbr-p000373","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m053-0041","start":41,"end":43,"surface":"驪姬","kind":"person","person_id":"cbr-p000378","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m053-0064","start":64,"end":67,"surface":"或父子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、並稱、匿名者、校勘或尚未定指代；不補姓名、親屬、闕代或成員。"},{"id":"c-shiji-037-wei:m053-0070","start":70,"end":72,"surface":"兄弟","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、並稱、匿名者、校勘或尚未定指代；不補姓名、親屬、闕代或成員。"}],"chapter_id":"c-shiji-037-wei","book_id":"b-shiji-037","work_id":"w-shiji","source_id":"s-shiji-037-wei"}],"sources":[{"chapter_id":"c-shiji-037-wei","work_id":"w-shiji","book_id":"b-shiji-037","source_id":"s-shiji-037-wei","source":{"title":"史記／卷037","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷037","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷037&oldid=5977124","revision_id":5977124,"accessed_on":"