d":"c-liangshu-028-peizhiheng-complete:p001:m0176","start":176,"end":178,"surface":"任約","kind":"person","person_id":"yka_ywr_r2n","status":"contextual_provisional"},{"id":"c-liangshu-028-peizhiheng-complete:p001:m0183","start":183,"end":184,"surface":"範","kind":"person","person_id":"qvt_eq1_lcf_AAB","status":"contextual_provisional"},{"id":"c-liangshu-028-peizhiheng-complete:p001:m0185","start":185,"end":187,"surface":"之橫","kind":"person","person_id":"4kt_0ar_aqo_AAD","status":"contextual_provisional"},{"id":"c-liangshu-028-peizhiheng-complete:p001:m0194","start":194,"end":195,"surface":"範","kind":"person","person_id":"qvt_eq1_lcf_AAB","status":"contextual_provisional"},{"id":"c-liangshu-028-peizhiheng-complete:p001:m0197","start":197,"end":199,"surface":"之橫","kind":"person","person_id":"4kt_0ar_aqo_AAD","status":"contextual_provisional"}],"chapter_id":"c-liangshu-028-peizhiheng-complete","book_id":"b-liangshu-028","work_id":"w-liangshu","source_id":"s-liangshu-028-peizhiheng-complete-ws1511902"},{"id":"c-liangshu-029-xiaolun-complete:p009","text":"時綸長史韋質、司馬薑律先在于外，聞綸敗，馳往迎之。於是復收散卒，屯于齊昌郡，將引魏軍共攻南陽。侯景將任約聞之，使鐵騎二百襲綸，綸無備，又敗走定州。定州刺史田龍祖迎綸，綸以龍祖荊鎮所任，懼爲所執，復歸齊昌。行至汝南，西魏所署汝南城主李素者，綸之故吏，聞綸敗，開城納之。綸乃脩浚城池，收集士卒，將攻竟陵。西魏安州刺史馬岫聞之，報于西魏，西魏遣大將軍楊忠、儀同侯幾通率衆赴焉。二年二月，忠等至于汝南，綸嬰城自守。會天寒大雪，忠等攻不能克，死者甚衆。後李素中流矢卒，城乃陷。忠等執綸，綸不爲屈，遂害之。投于江岸，經日顏色不變，鳥獸莫敢近焉。時年三十三。百姓憐之，爲立祠廟，後世祖追諡曰攜。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":55,"last_line":55,"raw_start":4656,"raw_end":4946,"raw_character_offsets":[4656,4657,4658,4659,4660,4661,4662,4663,4664,4665,4666,4667,4668,4669,4670,4671,4672,4673,4674,4675,4676,4677,4678,4679,4680,4681,4682,4683,4684,4685,4686,4687,4688,4689,4690,4691,4692,4693,4694,4695,4696,4697,4698,4699,4700,4701,4702,4703,4704,4705,4706,4707,4708,4709,4710,4711,4712,4713,4714,4715,4716,4717,4718,4719,4720,4721,4722,4723,4724,4725,4726,4727,4728,4729,4730,4731,4732,4733,4734,4735,4736,4737,4738,4739,4740,4741,4742,4743,4744,4745,4746,4747,4748,4749,475