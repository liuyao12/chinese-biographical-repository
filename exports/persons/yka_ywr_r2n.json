ns":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-liangshu-028-peizhiheng-complete:p001:m0176","start":176,"end":178,"surface":"任約","kind":"person","person_id":"yka_ywr_r2n","status":"contextual_provisional","paragraph_id":"c-liangshu-028-peizhiheng-complete:p001","chapter_id":"c-liangshu-028-peizhiheng-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-028-peizhiheng-complete:p001","text":"之橫字如岳，之高第十三弟也。少好賓遊，重氣俠，不事產業。之高以其縱誕，乃爲狹被蔬食以激厲之。之橫歎曰：「大丈夫富貴，必作百幅被。」遂與僮屬數百人，於芍陂大營田墅，遂致殷積。太宗在東宮，聞而要之，以爲河東王常侍、直殿主帥，遷直閤將軍。侯景亂，出爲貞威將軍，隸鄱陽王範討景。景濟江，仍與範長子嗣入援。連營度淮，據東城。京都陷，退還合肥，與範溯流赴湓城。景遣任約上逼晉熙，範令之橫下援，未及至，範薨，之橫乃還。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":44,"last_line":44,"raw_start":2456,"raw_end":2658,"raw_character_offsets":[2456,2457,2458,2459,2460,2461,2462,2463,2464,2465,2466,2467,2468,2469,2470,2471,2472,2473,2474,2475,2476,2477,2478,2479,2480,2481,2482,2483,2484,2485,2486,2487,2488,2489,2490,2491,2492,2493,2494,2495,2496,2497,2498,2499,2500,2501,2502,2503,2504,2505,2506,2507,2508,2509,2510,2511,2512,2513,2514,2515,2516,2517,2518,2519,2520,2521,2522,2523,2524,2525,2526,2527,2528,2529,2530,2531,2532,2533,2534,2535,2536,2537,2538,2539,2540,2541,2542,2543,2544,2545,2546,2547,2548,2549,2550,2551,2552,2553,2554,2555,2556,2557,2558,2559,2560,2561,2562,2563,2564,2565,2566,2567,2568,2569,2570,2571,2572,2573,2574,2575,2576,2577,2578,2579,2580,2581,2582,2583,2584,2585,2586,2587,2588,2589,2590,2591,2592,2593,2594,2595,2596,2597,2598,2599,2600,2601,2602,2603,2604,2605,2606,2607,2608,2609,2610,2611,2612,2613,2614,2615,2616,2617,2618,2619,2620,2621,2622,2623,2624,2625,2626,2627,