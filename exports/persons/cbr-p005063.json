face":"義帝","kind":"person","person_id":"cbr-p000682","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m054-0010","start":10,"end":12,"surface":"韓信","kind":"person","person_id":"cbr-p000724","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m054-0030","start":30,"end":32,"surface":"彭越","kind":"person","person_id":"cbr-p000707","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m054-0041","start":41,"end":44,"surface":"韓王信","kind":"person","person_id":"cbr-p000774","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m054-0056","start":56,"end":58,"surface":"吳芮","kind":"person","person_id":"cbr-p000700","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m054-0067","start":67,"end":69,"surface":"番君","kind":"person","person_id":"cbr-p000700","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m054-0071","start":71,"end":73,"surface":"梅鋗","kind":"person","person_id":"cbr-p000706","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m054-0083","start":83,"end":85,"surface":"番君","kind":"person","person_id":"cbr-p000700","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m054-0086","start":86,"end":90,"surface":"淮南王布","kind":"person","person_id":"cbr-p000656","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m054-0093","start":93,"end":95,"surface":"臧荼","kind":"person","person_id":"cbr-p000703","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m054-0096","start":96,"end":99,"surface":"趙王敖","kind":"person","person_id":"cbr-p000787","status":"contextual_provisional"}],"chapter_id":"c-shiji-008-gaozu","book_id":"b-shiji-008","work_id":"w-shiji","source_id":"s-shiji-008-gaozu"},{"id":"c-shiji-008-gaozu:p071","text":"十年十月，淮南王黥布、梁王彭越、燕王盧綰、荊王劉賈、楚王劉交、齊王劉肥、長沙王吳芮皆來朝長樂宮。春夏無事。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m071-0008","start":8,"end":10,"surface":"黥布","kind":"person","person_id":"cbr-p000656","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m071-0013","start":13,"end":15,"surface":"彭越","kind":"person","person_id":"cbr-p000707","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m071-0018","start":18,"end":20,"surface":"盧綰","kind":"person","person_id":"cbr-p000780","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m071-0023","start":23,"end":25,"surface":"劉賈","kind":"person","person_id":"cbr-p000727","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m071-0028","start":28,"end":30,"surface":"劉交","kind":"person","person_id":"cbr-p000794","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m071-0033","start":33,"end":35,"surface":"劉肥","kind":"person","person_id":"cbr-p000795","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m071-0039","start":39,"end":41,"surface":"吳芮","kind":"person","person_id":"cbr-p000700","status":"contextual_provisional"}],"chapter_id":"c-shiji-008-gaozu","book_id":"b-shiji-008","work_id":"w-shiji","source_id":"s-shiji-008-gaozu"},{"id":"c-shiji-009-lvhou:p003","text":"高祖十二年四月甲辰，崩長樂宮，太子襲號為帝。是時高祖八子：長男肥，孝惠兄也，異母，肥為齊王；餘皆孝惠弟，戚姬子如意為趙王，薄夫人子恒為代王，諸姬子子恢為梁王，子友為淮陽王，子長為淮南王，子建為燕王。高祖弟交為楚王，兄子濞為吳王。非劉氏功臣番君吳芮子臣為長沙王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-009-lvhou:m003-0000","start":0,"end":2,"surface":"高祖","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m003-0015","start":15,"end":17,"surface":"太子","kind":"person","person_id":"cbr-p000713","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m003-0020","start":20,"end":21,"surface":"帝","kind":"person","person_id":"cbr-p000713","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m003-0024","start":24,"end":26,"surface":"高祖","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m003-0031","start":31,"end":32,"surface":"肥","kind":"person","person_id":"cbr-p000795","status":"contextual_