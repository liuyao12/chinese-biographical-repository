ct_person_id":"cbr-p005063","status":"source_attested","evidence":[{"chapter_id":"c-shiji-091-qingbu","source_id":"s-shiji-091-qingbu","paragraph_id":"c-shiji-091-qingbu:p002","quote":"陳勝之起也，布乃見番君，與其眾叛秦，聚兵數千人。番君以其女妻之。章邯之滅陳勝，破呂臣軍，布乃引兵北擊秦左右校，破之清波，引兵而東。聞項梁定江東會稽，涉江而西。陳嬰以項氏世為楚將，乃以兵屬項梁，渡淮南，英布、蒲將軍亦以兵屬項梁。"}],"qualifiers":{"source_term":"番君以其女妻之","historicity":"historical_tradition"},"interpretation_note":"明示妻女與皇子關係按局部主語保存；所幸姬不作已定配偶，皋陶之後疑問不作祖先。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji007-028","person_id":"cbr-p000700","title":"衡山王","kind":"royal_rank","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-007-xiangyu","source_id":"s-shiji-007-xiangyu","paragraph_id":"c-shiji-007-xiangyu:p021","quote":"故立芮為衡山王"}],"attestations":[{"id":"th-shiji007-028:a001","paragraph_id":"c-shiji-007-xiangyu:p021","start":491,"end":494,"surface":"衡山王","person_mention_id":"c-shiji-007-xiangyu:m021-0489","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-007-xiangyu","source_id":"s-shiji-007-xiangyu","paragraph_id":"c-shiji-007-xiangyu:p021","quote":"故立芮為衡山王"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"保存授號／用稱與有效時段證據；敘事位置不是確定曆日，未知端點不當無限延伸，亦不以卒日補終止。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji008-016","person_id":"cbr-p000700","title":"長沙王","kind":"royal_rank","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-008-gaozu","source_id":"s-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p054","quote":"徙衡山王吳芮為長沙王"}],"attestations":[{"id":"th-shiji008-016:a001","paragraph_id":"c-shiji-008-gaozu:p054","start":59,"end":62,"surface":"長沙王","person_mention_id":"c-shiji-008-gaozu:m054-0056","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-008-gaozu","source_id":"s-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p054","quote":"徙衡山王吳芮為長沙王"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"有據事件與用稱分開；日期未換算，未知端點不等於無限延伸，不以死亡或首次用稱推造起訖。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji008-042","person_id":"cbr-p000700","surfaces":["吳芮","番君"],"scope":"cross_chapter","chapter_ids":["c-shiji-007-xiangyu","c-shiji-008-gaozu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-007-xiangyu:p021","quote":"項王使人致命懷王。懷王曰：「如約。」乃尊懷王為義帝。項王欲自王，先王諸將相。謂曰：「天下初發難時，假立諸侯後以伐秦。然身被堅執銳首事，暴露於野三年，滅秦定天下者，皆將相諸君與籍之力也。義帝雖無功，故當分其地而王之。」諸將皆曰：「善。」乃分天下，立諸將為侯王。項王、范增疑沛公之有天下，業已講解，又惡負約，恐諸侯叛之，乃陰謀曰：「巴、蜀道險，秦之遷人皆居蜀。」乃曰：「巴、蜀亦關中地也。」故立沛公為漢王，王巴、蜀、漢中，都南鄭。而三分關中，王秦降將以距塞漢王。項王乃立章邯為雍王，王咸陽以西，都廢邱。長史欣者，故為櫟陽獄掾，嘗有德於項梁；都尉董翳者，本勸章邯降楚。故立司馬欣為塞王，王咸陽以東至河，都櫟陽；立董翳為翟王，王上郡，都高奴。徙魏王豹為西魏王，王河東，都平陽。瑕丘申陽者，張耳嬖臣也，先下河南（郡），迎楚河上，故立申陽為河南王，都雒陽。韓王成因故都，都陽翟。趙將司馬卬定河內，數有功，故立卬為殷王，王河內，都朝歌。徙趙王歇為代王。趙相張耳素賢，又從入關，故立耳為常山王，王趙地，都襄國。當陽君黥布為楚將，常冠軍，故立布為九江王，都六。鄱君吳芮率百越佐諸侯，又從入關，故立芮為衡山王，都邾。義帝柱國共敖將兵擊南郡，功多，因立敖為臨江王，都江陵。徙燕王韓廣為遼東王。燕將臧荼從楚救趙，因從入關，故立荼為燕王，都薊。徙齊王田市為膠東王。齊將田都從共救趙，因從入關，故立都為齊王，都臨菑。故秦所滅齊王建孫田安，項羽方渡河救趙，田安下濟北數城，引其兵降項羽，故立安為濟北王，都博陽。田榮者，數負項梁，又不肯將兵從楚擊秦，以故不封。成安君陳餘棄將印去，不從入關，然素聞其賢，有功於趙，聞其在南皮，故因環封三縣。番君將梅鋗功多，故封十萬戶侯。項王自立為西楚霸王，王九郡，都彭城。"},{"paragraph_id":"c-shiji-008-gaozu:p026","quote":"正月，項羽自立為西楚霸王，王梁、楚地九郡，都彭城。負約，更立沛公為漢王，王巴、蜀、漢中，都南鄭。三分關中，立秦三將：章邯為雍王，都廢丘；司馬欣為塞王，都櫟陽；董翳為翟王，都高奴。楚將瑕丘申陽為河南王，都洛陽。趙將司馬卬為殷王，都朝歌。趙王歇徙王代。趙相張耳為常山王，都襄國。當陽君黥布為九江王，都六。懷王柱國共敖為臨江王，都江陵。番君吳芮為衡山王，都邾。燕將臧荼為燕王，都薊。故燕王韓廣徙王遼東。廣不聽，臧荼攻殺之無終。封成安君陳餘河閒三縣，居南皮。封梅鋗十萬戶。"},{"paragraph_id":"c-shiji-008-gaozu:p054","quote":"皇帝曰義帝無後。齊王韓信習楚風俗，徙為楚王，都下邳。立建成侯彭越為梁王，都定陶。故韓王信為韓王，都陽翟。徙衡山王吳芮為長沙王，都臨湘。番君之將梅鋗有功，從入武關，故德番君。淮南王布、燕王臧荼、趙王敖皆如故。"},{"paragraph_id":"c-shiji-008-gaozu:p071","quote":"十年十月，淮南王黥布、梁王彭越、燕王盧綰、荊王劉賈、楚王劉交、齊王劉肥、長沙王吳芮皆來朝長樂宮。春夏無事。"}],"rationale":"只在所列原句的秦末楚漢軍事／分封敘事內暫定同指；有前卷錨點時對讀相接事件，不把同名作全庫匹配規則，仍待異源覆核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji009-004","person_id":"cbr-p000700","surfaces":["吳芮"],"scope":"cross_chapter","chapter_ids":["c-shiji-007-xiangyu","c-shiji-009-lvhou"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-007-xiangyu:p021","quote":"項王使人致命懷王。懷王曰：「如約。」乃尊懷王為義帝。項王欲自王，先王諸將相。謂曰：「天下初發難時，假立諸侯後以伐秦。然身被堅執銳首事，暴露於野三年，滅秦定天下者，皆將相諸君與籍之力也。義帝雖無功，故當分其地而王之。」諸將皆曰：「善。」乃分天下，立諸將為侯王。項王、范增疑沛公之有天下，業已講解，又惡負約，恐諸侯叛之，乃陰謀曰：「巴、蜀道險，秦之遷人皆居蜀。」乃曰：「巴、蜀亦關中地也。」故立沛公為漢王，王巴、蜀、漢中，都南鄭。而三分關中，王秦降將以距塞漢王。項王乃立章邯為雍王，王咸陽以西，都廢邱。長史欣者，故為櫟陽獄掾，嘗有德於項梁；都尉董翳者，本勸章邯降楚。故立司馬欣為塞王，王咸陽以東至河，都櫟陽；立董翳為翟王，王上郡，都高奴。徙魏王豹為西魏王，王河東，都平陽。瑕丘申陽者，張耳嬖臣也，先下河南（郡），迎楚河上，故立申陽為河南王，都雒陽。韓王成因故都，都陽翟。趙將司馬卬定河內，數有功，故立卬為殷王，王河內，都朝歌。徙趙王歇為代王。趙相張耳素賢，又從入關，故立耳為常山王，王趙地，都襄國。當陽君黥布為楚將，常冠軍，故立布為九江王，都六。鄱君吳芮率百越佐諸侯，又從入關，故立芮為衡山王，都邾。義帝柱國共敖將兵擊南郡，功多，因立敖為臨江王，都江陵。徙燕王韓廣為遼東王。燕將臧荼從楚救趙，因從入關，故立荼為燕王，都薊。徙齊王田市為膠東王。齊將田都從共救趙，因從入關，故立都為齊王，都臨菑。故秦所滅齊王建孫田安，項羽方渡河救趙，田安下濟北數城，引其兵降項羽，故立安為濟北王，都博陽。田榮者，數負項梁，又不肯將兵從楚擊秦，以故不封。成安君陳餘棄將印去，不從入關，然素聞其賢，有功於趙，聞其在南皮，故因環封三縣。番君將梅鋗功多，故封十萬戶侯。項王自立為西楚霸王，王九郡，都彭城。"},{"paragraph_id":"c-shiji-009-lvhou:p003","quote":"高祖十二年四月甲辰，崩長樂宮，太子襲號為帝。是時高祖八子：長男肥，孝惠兄也，異母，肥為齊王；餘皆孝惠弟，戚姬子如意為趙王，薄夫人子恒為代王，諸姬子子恢為梁王，子友為淮陽王，子長為淮南王，子建為燕王。高祖弟交為楚王，兄子濞為吳王。非劉氏功臣番君吳芮子臣為長沙王。"}],"rationale":"僅在所列漢初帝后、分封、家族與接任敘事中暫定同指，前卷對讀依相接人物及事件；同名不作全庫替換規則，仍待可靠版本及異源覆核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji091-004","person_id":"cbr-p005063","surfaces":["番君"],"scope":"same_chapter","chapter_ids":["c-shiji-091-qingbu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-091-qingbu:p002","quote":"陳勝之起也，布乃見番君，與其眾叛秦，聚兵數千人。番君以其女妻之。章邯之滅陳勝，破呂臣軍，布乃引兵北擊秦左右校，破之清波，引兵而東。聞項梁定江東會稽，涉江而西。陳嬰以項氏世為楚將，乃以兵屬項梁，渡淮南，英布、蒲將軍亦以兵屬項梁。"},{"paragraph_id":"c-shiji-091-qingbu:p017","quote":"遂西，與上兵遇蘄西會甀。布兵精甚，上乃壁庸城，望布軍置陳如項籍軍，上惡之。與布相望見，遙謂布曰：「何苦而反？」布曰：「欲為帝耳。」上怒罵之，遂大戰。布軍敗走，渡淮，數止戰，不利，與百餘人走江南。布故與番君婚，以故長沙哀王使人紿布，偽與亡，誘走越，故信而隨之番陽。番陽人殺布茲鄉民田舍，遂滅黥布。"}],"rationale":"按明示姓名、姓氏與局部敘事暫接，短名不全域替換；番君及蒲將軍不補未見姓名，范曾原字保留。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji091-fan","person_ids":["cbr-p000700","cbr-p005063"],"canonical_person_id":"cbr-p000700","scope":"cross_chapter","chapter_ids":["c-shiji-008-gaozu","c-shiji-091-qingbu"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-008-gaozu","source_id":"s-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p054","quote":"皇帝曰義帝無後。齊王韓信習楚風俗，徙為楚王，都下邳。立建成侯彭越為梁王，都定陶。故韓王信為韓王，都陽翟。徙衡山王吳芮為長沙王，都臨湘。番君之將梅鋗有功，從入武關，故德番君。淮南王布、燕王臧荼、趙王敖皆如故。","mention_ids":["c-shiji-008-gaozu:m054-0056","c-shiji-008-gaozu:m054-0067","c-shiji-008-gaozu:m054-0083"]},{"chapter_id":"c-shiji-091-qingbu","source_id":"s-shiji-091-qingbu","paragraph_id":"c-shiji-091-qingbu:p002","quote":"陳勝之起也，布乃見番君，與其眾叛秦，聚兵數千人。番君以其女妻之。章邯之滅陳勝，破呂臣軍，布乃引兵北擊秦左右校，破之清波，引兵而東。聞項梁定江東會稽，涉江而西。陳嬰以項氏世為楚將，乃以兵屬項梁，渡淮南，英布、蒲將軍亦以兵屬項梁。","mention_ids":["c-shiji-091-qingbu:m002-0009","c-shiji-091-qingbu:m002-0024"]}],"rationale":"反秦番君及其女妻英布的敘事背景、同稱相配，吳芮長沙王與長沙哀王不因此混同，世系及婚姻仍限本篇直接證據。 各篇原字、原文與已發ID保留，同書不視為獨立見證；同指不確證所有紀年、任職、親屬或敘事，不按全域同名批量改號。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-007-xiangyu:p021","text":"項王使人致命懷王。懷王曰：「如約。」乃尊懷王為義帝。項王欲自王，先王諸將相。謂曰：「天下初發難時，假立諸侯後以伐秦。然身被堅執銳首事，暴露於野三年，滅秦定天下者，皆將相諸君與籍之力也。義帝雖無功，故當分其地而王之。」諸將皆曰：「善。」乃分天下，立諸將為侯王。項王、范增疑沛公之有天下，業已講解，又惡負約，恐諸侯叛之，乃陰謀曰：「巴、蜀道險，秦之遷人皆居蜀。」乃曰：「巴、蜀亦關中地也。」故立沛公為漢王，王巴、蜀、漢中，都南鄭。而三分關中，王秦降將以距塞漢王。項王乃立章邯為雍王，王咸陽以西，都廢邱。長史欣者，故為櫟陽獄掾，嘗有德於項梁；都尉董翳者，本勸章邯降楚。故立司馬欣為塞王，王咸陽以東至河，都櫟陽；立董翳為翟王，王上郡，都高奴。徙魏王豹為西魏王，王河東，都平陽。瑕丘申陽者，張耳嬖臣也，先下河南（郡），迎楚河上，故立申陽為河南王，都雒陽。韓王成因故都，都陽翟。趙將司馬卬定河內，數有功，故立卬為殷王，王河內，都朝歌。徙趙王歇為代王。趙相張耳素賢，又從入關，故立耳為常山王，王趙地，都襄國。當陽君黥布為楚將，常冠軍，故立布為九江王，都六。鄱君吳芮率百越佐諸侯，又從入關，故立芮為衡山王，都邾。義帝柱國共敖將兵擊南郡，功多，因立敖為臨江王，都江陵。徙燕王韓廣為遼東王。燕將臧荼從楚救趙，因從入關，故立荼為燕王，都薊。徙齊王田市為膠東王。齊將田都從共救趙，因從入關，故立都為齊王，都臨菑。故秦所滅齊王建孫田安，項羽方渡河救趙，田安下濟北數城，引其兵降項羽，故立安為濟北王，都博陽。田榮者，數負項梁，又不肯將兵從楚擊秦，以故不封。成安君陳餘棄將印去，不從入關，然素聞其賢，有功於趙，聞其在南皮，故因環封三縣。番君將梅鋗功多，故封十萬戶侯。項王自立為西楚霸王，王九郡，都彭城。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-007-xiangyu:m021-0000","start":0,"end":2,"surface":"項王","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m021-0006","start":6,"end":