nd":101,"surface":"高祖","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m003-0102","start":102,"end":103,"surface":"交","kind":"person","person_id":"cbr-p000794","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m003-0109","start":109,"end":110,"surface":"濞","kind":"person","person_id":"cbr-p000810","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m003-0121","start":121,"end":123,"surface":"吳芮","kind":"person","person_id":"cbr-p000700","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m003-0123","start":123,"end":125,"surface":"子臣","kind":"person","person_id":"cbr-p000825","status":"contextual_provisional"}],"chapter_id":"c-shiji-009-lvhou","book_id":"b-shiji-009","work_id":"w-shiji","source_id":"s-shiji-009-lvhou"},{"id":"c-shiji-091-qingbu:p002","text":"陳勝之起也，布乃見番君，與其眾叛秦，聚兵數千人。番君以其女妻之。章邯之滅陳勝，破呂臣軍，布乃引兵北擊秦左右校，破之清波，引兵而東。聞項梁定江東會稽，涉江而西。陳嬰以項氏世為楚將，乃以兵屬項梁，渡淮南，英布、蒲將軍亦以兵屬項梁。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-091-qingbu:m002-0000","start":0,"end":2,"surface":"陳勝","kind":"person","person_id":"cbr-p005065","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m002-0006","start":6,"end":7,"surface":"布","kind":"person","person_id":"cbr-p005060","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m002-0009","start":9,"end":11,"surface":"番君","kind":"person","person_id":"cbr-p005063","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m002-0024","start":24,"end":26,"surface":"番君","kind":"person","person_id":"cbr-p005063","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m002-0027","start":27,"end":29,"surface":"其女","kind":"person","person_id":"cbr-p005064","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m002-0032","start":32,"end":34,"surface":"章邯","kind":"person","person_id":"cbr-p005066","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m002-0036","start":36,"end":38,"surface":"陳勝","kind":"person","person_id":"cbr-p005065","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m002-0040","start":40,"end":42,"surface":"呂臣","kind":"person","person_id":"cbr-p005067","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m002-0044","start":44,"end":45,"surface":"布","kind":"person","person_id":"cbr-p005060","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m002-0066","start":66,"end":68,"surface":"項梁","kind":"person","person_id":"cbr-p005068","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m002-0079","start":79,"end":81,"surface":"陳嬰","kind":"person","person_id":"cbr-p005069","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m002-0082","start":82,"end":84,"surface":"項氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、族稱或群體不補姓名成員。"},{"id":"c-shiji-091-qingbu:m002-0093","start":93,"end":95,"surface":"項梁","kind":"person","person_id":"cbr-p005068","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m002-0100","start":100,"end":102,"surface":"英布","kind":"person","person_id":"cbr-p005060","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m002-0103","start":103,"end":106,"surface":"蒲將軍","kind":"person","person_id":"cbr-p005061","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m002-0110","start":110,"end":112,"surface":"項梁","kind":"person","person_id":"cbr-p005068","status":"contextual_provisional"}],"chapter_id":"c-shiji-091-qingbu","book_id":"b-shiji-091","work_id":"w-shiji","source_id":"s-shiji-091-qingbu"},{"id":"c-shiji-091-qingbu:p017","text":"遂西，與上兵遇蘄西會甀。布兵精甚，上乃壁庸城，望布軍置陳如項籍軍，上惡之。與布相望見，遙謂布曰：「何苦而反？」布曰：「欲為帝耳。」上怒罵之，遂大戰。布軍敗走，渡淮，數止戰，不利，與百餘人走江南。布故與番君婚，以故長沙哀王使人紿布，偽與亡，誘走越，故信而隨之番陽。番陽人殺布茲鄉民田舍，遂滅黥布。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-091-qingbu:m017-0004","start":4,"end":5,"surface":"上","kind":"person","person_id":"cbr-p005086","status":"contextual_provisional"},{"id":"c-sh