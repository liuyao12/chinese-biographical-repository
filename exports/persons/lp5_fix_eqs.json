-shiji-100-jibu","work_id":"w-shiji","book_id":"b-shiji-100","chapter_id":"c-shiji-100-jibu","mention_count":1,"mention_ids":["c-shiji-100-jibu:m005-0055"],"paragraph_ids":["c-shiji-100-jibu:p005"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-107-weiqi"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-100-jibu:m005-0055","start":55,"end":57,"surface":"籍福","kind":"person","person_id":"lp5_fix_eqs","status":"contextual_provisional","paragraph_id":"c-shiji-100-jibu:p005","chapter_id":"c-shiji-100-jibu"},{"id":"c-shiji-107-weiqi:m007-0053","start":53,"end":55,"surface":"籍福","kind":"person","person_id":"lp5_fix_eqs","status":"contextual_provisional","paragraph_id":"c-shiji-107-weiqi:p007","chapter_id":"c-shiji-107-weiqi"},{"id":"c-shiji-107-weiqi:m007-0158","start":158,"end":160,"surface":"籍福","kind":"person","person_id":"lp5_fix_eqs","status":"contextual_provisional","paragraph_id":"c-shiji-107-weiqi:p007","chapter_id":"c-shiji-107-weiqi"},{"id":"c-shiji-107-weiqi:m018-0004","start":4,"end":6,"surface":"籍福","kind":"person","person_id":"lp5_fix_eqs","status":"contextual_provisional","paragraph_id":"c-shiji-107-weiqi:p018","chapter_id":"c-shiji-107-weiqi"},{"id":"c-shiji-107-weiqi:m018-0048","start":48,"end":50,"surface":"籍福","kind":"person","person_id":"lp5_fix_eqs","status":"contextual_provisional","paragraph_id":"c-shiji-107-weiqi:p018","chapter_id":"c-shiji-107-weiqi"},{"id":"c-shiji-107-weiqi:m018-0051","start":51,"end":53,"surface":"籍福","kind":"person","person_id":"lp5_fix_eqs","status":"contextual_provisional","paragraph_id":"c-shiji-107-weiqi:p018","chapter_id":"c-shiji-107-weiqi"},{"id":"c-shiji-107-weiqi:m020-0333","start":333,"end":335,"surface":"籍福","kind":"person","person_id":"lp5_fix_eqs","status":"contextual_provisional","paragraph_id":"c-shiji-107-weiqi:p020","chapter_id":"c-shiji-107-weiqi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji100-022","person_id":"lp5_fix_eqs","surfaces":["籍福"],"scope":"cross_chapter","chapter_ids":["c-shiji-100-jibu","c-shiji-107-weiqi"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-100-jibu","source_id":"s-shiji-100-jibu","paragraph_id":"c-shiji-100-jibu:p005","quote":"季布弟季心，氣蓋關中，遇人恭謹，爲任俠，方數千里，士皆爭爲之死。嘗殺人，亡之呉，從袁絲匿。長事袁絲，弟畜灌夫、籍福之屬。嘗爲中司馬，中尉郅都不敢不加禮。少年多時時竊籍其名以行。當是時，季心以勇，布以諾，著聞關中。","mention_ids":["c-shiji-100-jibu:m005-0055"]},{"chapter_id":"c-shiji-107-weiqi","source_id":"s-shiji-107-weiqi","paragraph_id":"c-shiji-107-weiqi:p007","quote":"武安侯新欲用事為相，卑下賓客，進名士家居者貴之，欲以傾魏其諸將相。建元元年，丞相綰病免，上議置丞相、太尉。籍福說武安侯曰：「魏其貴久矣，天下士素歸之。今將軍初興，未如魏其，即上以將軍為丞相，必讓魏其。魏其為丞相，將軍必為太尉。太尉、丞相尊等耳，又有讓賢名。」武安侯乃微言太后風上，於是乃以魏其侯為丞相，武安侯為太尉。籍福賀魏其侯，因弔曰：「君侯資性喜善疾惡，方今善人譽君侯，故至丞相；然君侯且疾惡，惡人眾，亦且毀君侯。君侯能兼容，則幸久；不能，今以毀去矣。」魏其不聽。","mention_ids":["c-shiji-107-weiqi:m007-0053","c-shiji-107-weiqi:m007-0158"]},{"chapter_id":"c-shiji-107-weiqi","source_id":"s-shiji-107-weiqi","paragraph_id":"c-shiji-107-weiqi:p018","quote":"丞相嘗使籍福請魏其城南田。魏其大望曰：「老僕雖棄，將軍雖貴，寧可以勢奪乎！」不許。灌夫聞，怒，罵籍福。籍福惡兩人有郤，乃謾自好謝丞相曰：「魏其老且死，易忍，且待之。」已而武安聞魏其、灌夫實怒不予田，亦怒曰：「魏其子嘗殺人，蚡活之。蚡事魏其無所不可，何愛數頃田？且灌夫何與也？吾不敢複求田。」武安由此大怨灌夫、魏其。","mention_ids":["c-shiji-107-weiqi:m018-0004","c-shiji-107-weiqi:m018-0048","c-shiji-107-weiqi:m018-0051"]},{"chapter_id":"c-shiji-107-weiqi","source_id":"s-shiji-107-weiqi","paragraph_id":"c-shiji-107-weiqi:p020","quote":"夏，丞相取燕王女為夫人，有太后詔，召列侯宗室皆往賀。魏其侯過灌夫，欲與俱。夫謝曰：「夫數以酒失得過丞相，丞相今者又與夫有郤。」魏其曰：「事已解。」彊與俱。飲酒酣，武安起為壽，坐皆避席伏。已魏其侯為壽，獨故人避席耳，餘半膝席。灌夫不悅。起行酒，至武安，武安膝席曰：「不能滿觴。」夫怒，因嘻笑曰：「將軍貴人也，屬之！」時武安不肯。行酒次至臨汝侯，臨汝侯方與程不識耳語，又不避席。夫無所發怒，乃罵臨汝侯曰：「生平毀程不識不直一錢，今日長者為壽，乃效女兒呫囁耳語！」武安謂灌夫曰：「程李俱東西宮衛尉，今眾辱程將軍，仲孺獨不為李將軍地乎？」灌夫曰：「今日斬頭陷匈，何知程李乎！」坐乃起更衣，稍稍去。魏其侯去，麾灌夫出。武安遂怒曰：「此吾驕灌夫罪。」乃令騎留灌夫。灌夫欲出不得。籍福起為謝，案灌夫項令謝。夫愈怒，不肯謝。武安乃麾騎縛夫置傳舍，召長史曰：「今日召宗室，有詔。」劾灌夫罵坐不敬，系居室。遂按其前事，遣吏分曹逐捕諸灌氏支屬，皆得棄市罪。魏其侯大媿，為資使賓客請，莫能解。武安吏皆為耳目，諸灌氏皆亡匿，夫系，遂不得告言武安陰事。","mention_ids":["c-shiji-107-weiqi:m020-0333"]}],"rationale":"季心以弟禮待灌夫、籍福的並列人物，在魏其武安篇亦同場交往，時代與漢廷賓客網絡相容。暫按同人接合，並非原文明言跨篇同指，不因同字串而合其他籍氏；不把弟畜當血親，也不補未載生卒。 原詞、引文與錨點分存，同書互見不作獨立史實票數；未核書影。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"references":[{"title":"《史記·魏其武安侯列傳》籍福與灌夫交往","url":"https://zh.wikisource.org/w/index.php?title=史記/卷107&oldid=2540571","quote":"丞相嘗使籍福請魏其城南田。魏其大望曰：「老僕雖棄，將軍雖貴，寧可以勢奪乎！」不許。灌夫聞，怒，罵籍福。籍福惡兩人有郤，乃謾自好謝丞相曰：「魏其老且死，易忍，且待之。」已而武安聞魏其、灌夫實怒不予田，亦怒曰：「魏其子嘗殺人，蚡活之。蚡事魏其無所不可，何愛數頃田？且灌夫何與也？吾不敢複求田。」武安由此大怨灌夫、魏其。","source_kind":"received_primary_text","paragraph_id":"c-shiji-107-weiqi:p018","scope":"social_network_context_not_direct_identity_statement","image_verified":false}]}],"equivalence_decisions":[{"id":"eq-shiji100-social-jifu","person_ids":["lp5_fix_eqs"],"canonical_person_id":"lp5_fix_eqs","scope":"cross_chapter","chapter_ids":["c-shiji-100-jibu","c-shiji-107-weiqi"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-100-jibu","source_id":"s-shiji-100-jibu","paragraph_id":"c-shiji-100-jibu:p005","quote":"季布弟季心，氣蓋關中，遇人恭謹，爲任俠，方數千里，士皆爭爲之死。嘗殺人，亡之呉，從袁絲匿。長事袁絲，弟畜灌夫、籍福之屬。嘗爲中司馬，中尉郅都不敢不加禮。少年多時時竊籍其名以行。當是時，季心以勇，布以諾，著聞關中。","mention_ids":["c-shiji-100-jibu:m005-0055"]},{"chapter_id":"c-shiji-107-weiqi","source_id":"s-shiji-107-weiqi","paragraph_id":"c-shiji-107-weiqi:p007","quote":"武安侯新欲用事為相，卑下賓客，進名士家居者貴之，欲以傾魏其諸將相。建元元年，丞相綰病免，上議置丞相、太尉。籍福說武安侯曰：「魏其貴久矣，天下士素歸之。今將軍初興，未如魏其，即上以將軍為丞相，必讓魏其。魏其為丞相，將軍必為太尉。太尉、丞相尊等耳，又有讓賢名。」武安侯乃微言太后風上，於是乃以魏其侯為丞相，武安侯為太尉。籍福賀魏其侯，因弔曰：「君侯資性喜善疾惡，方今善人譽君侯，故至丞相；然君侯且疾惡，惡人眾，亦且毀君侯。君侯能兼容，則幸久；不能，今以毀去矣。」魏其不聽。","mention_ids":["c-shiji-107-weiqi:m007-0053","c-shiji-107-weiqi:m007-0158"]},{"chapter_id":"c-shiji-107-weiqi","source_id":"s-shiji-107-weiqi","paragraph_id":"c-shiji-107-weiqi:p018","quote":"丞相嘗使籍福請魏其城南田。魏其大望曰：「老僕雖棄，將軍雖貴，寧可以勢奪乎！」不許。灌夫聞，怒，罵籍福。籍福惡兩人有郤，乃謾自好謝丞相曰：「魏其老且死，易忍，且待之。」已而武安聞魏其、灌夫實怒不予田，亦怒曰：「魏其子嘗殺人，蚡活之。蚡事魏其無所不可，何愛數頃田？且灌夫何與也？吾不敢複求田。」武安由此大怨灌夫、魏其。","mention_ids":["c-shiji-107-weiqi:m018-0004","c-shiji-107-weiqi:m018-0048","c-shiji-107-weiqi:m018-0051"]},{"chapter_id":"c-shiji-107-weiqi","source_id":"s-shiji-107-weiqi","paragraph_id":"c-shiji-107-weiqi:p020","quote":"夏，丞相取燕王女為夫人，有太后詔，召列侯宗室皆往賀。魏其侯過灌夫，欲與俱。夫謝曰：「夫數以酒失得過丞相，丞相今者又與夫有郤。」魏其曰：「事已解。」彊與俱。飲酒酣，武安起為壽，坐皆避席伏。已魏其侯為壽，獨故人避席耳，餘半膝席。灌夫不悅。起行酒，至武安，武安膝席曰：「不能滿觴。」夫怒，因嘻笑曰：「將軍貴人也，屬之！」時武安不肯。行酒次至臨汝侯，臨汝侯方與程不識耳語，又不避席。夫無所發怒，乃罵臨汝侯曰：「生平毀程不識不直一錢，今日長者為壽，乃效女兒呫囁耳語！」武安謂灌夫曰：「程李俱東西宮衛尉，今眾辱程將軍，仲孺獨不為李將軍地乎？」灌夫曰：「今日斬頭陷匈，何知程李乎！」坐乃起更衣，稍稍去。魏其侯去，麾灌夫出。武安遂怒曰：「此吾驕灌夫罪。」乃令騎留灌夫。灌夫欲出不得。籍福起為謝，案灌夫項令謝。夫愈怒，不肯謝。武安乃麾騎縛夫置傳舍，召長史曰：「今日召宗室，有詔。」劾灌夫罵坐不敬，系居室。遂按其前事，遣吏分曹逐捕諸灌氏支屬，皆得棄市罪。魏其侯大媿，為資使賓客請，莫能解。武安吏皆為耳目，諸灌氏皆亡匿，夫系，遂不得告言武安陰事。","mention_ids":["c-shiji-107-weiqi:m020-0333"]}],"rationale":"季心以弟禮待灌夫、籍福的並列人物，在魏其武安篇亦同場交往，時代與漢廷賓客網絡相容。暫按同人接合，並非原文明言跨篇同指，不因同字串而合其他籍氏；不把弟畜當血親，也不補未載生卒。 原詞、引文與錨點分存，同書互見不作獨立史實票數；未核書影。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true}],"passages":[{"id":"c-shiji-100-jibu:p005","text":"季布弟季心，氣蓋關中，遇人恭謹，爲任俠，方數千里，士皆爭爲之死。嘗殺人，亡之呉，從袁絲匿。長事袁絲，弟畜灌夫、籍福之屬。嘗爲中司馬，中尉郅都不敢不加禮。少年多時時竊籍其名以行。當是時，季心以勇，布以諾，著聞關中。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-100-jibu:m005-0000","start":0,"end":2,"surface":"季布","kind":"person","person_id":"udu_dyy_4wd","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m005-0003","start":3,"end":5,"surface":"季心","kind":"person","person_id":"cte_yao_v47","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m005-0041","start":41,"end":43,"surface":"袁絲","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m005-0047","start":47,"end":49,"sur