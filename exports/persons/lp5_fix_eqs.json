不得告言武安陰事。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-107-weiqi:m020-0002","start":2,"end":4,"surface":"丞相","person_id":"7mz_d13_9ka_A","kind":"person","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m020-0005","start":5,"end":7,"surface":"燕王","kind":"person","person_id":"jo4_4bf_0ra_A","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m020-0007","start":7,"end":8,"surface":"女","kind":"person","person_id":"jo4_4bf_0ra_AB","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m020-0013","start":13,"end":15,"surface":"太后","kind":"person","person_id":"6d6_eg1_o3a_A","status":"contextual_provisional","interpretation_note":"按本段帝朝與敘事或引述時間辨指；原文用稱不改為姓名。"},{"id":"c-shiji-107-weiqi:m020-0026","start":26,"end":29,"surface":"魏其侯","kind":"person","person_id":"nuf_tb9_fjs_A","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m020-0030","start":30,"end":32,"surface":"灌夫","kind":"person","person_id":"h1w_44g_vef_A","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m020-0037","start":37,"end":38,"surface":"夫","kind":"person","person_id":"h1w_44g_vef_A","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m020-0042","start":42,"end":43,"surface":"夫","kind":"person","person_id":"h1w_44g_vef_A","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m020-0049","start":49,"end":51,"surface":"丞相","person_id":"7mz_d13_9ka_A","kind":"person","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m020-0052","start":52,"end":54,"surface":"丞相","person_id":"7mz_d13_9ka_A","kind":"person","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m020-0058","start":58,"end":59,"surface":"夫","kind":"person","person_id":"h1w_44g_vef_A","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m020-0063","start":63,"end":65,"surface":"魏其","kind":"person","person_id":"nuf_tb9_fjs_A","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m020-0081","start":81,"end":83,"surface":"武