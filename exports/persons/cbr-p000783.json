{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000783","identity_policy":"contextual_provisional","person_ids":["cbr-p000783"],"persons":[{"id":"cbr-p000783","label":"孔將軍（垓下敘事）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"孔將軍","mention_ids":["c-shiji-008-gaozu:m052-0033","c-shiji-008-gaozu:m052-0079"]}],"evidence":[{"mention_id":"c-shiji-008-gaozu:m052-0033","chapter_id":"c-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p052","quote":"孔將軍"},{"mention_id":"c-shiji-008-gaozu:m052-0079","chapter_id":"c-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p052","quote":"孔將軍"}]}],"source_mention_summary":[{"source_id":"s-shiji-008-gaozu","work_id":"w-shiji","book_id":"b-shiji-008","chapter_id":"c-shiji-008-gaozu","mention_count":2,"mention_ids":["c-shiji-008-gaozu:m052-0033","c-shiji-008-gaozu:m052-0079"],"paragraph_ids":["c-shiji-008-gaozu:p052"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-008-gaozu"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-008-gaozu:m052-0033","start":33,"end":36,"surface":"孔將軍","kind":"person","person_id":"cbr-p000783","status":"contextual_provisional","paragraph_id":"c-shiji-008-gaozu:p052","chapter_id":"c-shiji-008-gaozu"},{"id":"c-shiji-008-gaozu:m052-0079","start":79,"end":82,"surface":"孔將軍","kind":"person","person_id":"cbr-p000783","status":"contextual_provisional","paragraph_id":"c-shiji-008-gaozu:p052","chapter_id":"c-shiji-008-gaozu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-008-gaozu:p052","text":"五年，高祖與諸侯兵共擊楚軍，與項羽決勝垓下。淮陰侯將三十萬自當之，孔將軍居左，費將軍居右，皇帝在後，絳侯、柴將軍在皇帝後。項羽之卒可十萬。淮陰先合，不利，卻。孔將軍、費將軍縱，楚兵不利，淮陰侯復乘之，大敗垓下。項羽卒聞漢軍之楚歌，以為漢盡得楚地，項羽乃敗而走，是以兵大敗。使騎將灌嬰追殺項羽東城，斬首八萬，遂略定楚地。魯為楚堅守不下。漢王引諸侯兵北，示魯父老項羽頭，魯乃降。遂以魯公號葬項羽穀城。還至定陶，馳入齊王壁，奪其軍。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m052-0003","start":3,"end":5,"surface":"高祖","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m052-0015","start":15,"end":17,"surface":"項羽","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m052-0022","start":22,"end":25,"surface":"淮陰侯","kind":"person","person_id":"cbr-p000724","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m052-0033","start":33,"end":36,"surface":"孔將軍","kind":"person","person_id":"cbr-p000783","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m052-0039","start":39,"end":42,"surface":"費將軍","kind":"person","person_id":"cbr-p000784","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m052-0045","start":45,"end":47,"surface":"皇帝","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m052-0050","start":50,"end":52,"surface":"絳侯","kind":"person","person_id":"cbr-p000786","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m052-0053","start":53,"end":56,"surface":"柴將軍","kind":"person","person_id":"cbr-p000785","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m052-0057","start":57,"end":59,"surface":"皇帝","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m052-0061","start":61,"end":63,"surface":"項羽","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m052-0069","start":69,"end":71,"surface":"淮陰","kind":"person","person_id":"cbr-p000724","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m052-0079","start":79,"end":82,"surface":"孔將軍","kind":"person","person_id":"cbr-p000783","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m052-0083","start":83,"end":86,"sur