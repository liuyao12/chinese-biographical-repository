e},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-jinshu-058-zhou-qiong:source_review1-0","kind":"source_review","person_id":"ch7_egc_g3g","source_quote":"瓊勁烈有將略，歷數郡，代楊亮爲梁州刺史、建武將軍，領西戎校尉。初，氏人竇沖求降，朝廷以爲東羌校尉。後沖反，欲入漢中，安定人皇甫釗、京兆人周勳等謀納沖，瓊密知之，收釗、勳等斬之。尋卒。子虓嗣。","reading":"周瓊任梁州刺史，處竇沖事及皇甫釗、周勳，卒後子虓嗣。","note":"周瓊任梁州刺史，處竇沖事及皇甫釗、周勳，卒後子虓嗣。","paragraph_id":"c-jinshu-058-zhou-qiong:p001","start_codepoint":0,"end_codepoint":95,"human_reviewed":false,"chapter_id":"c-jinshu-058-zhou-qiong","source_id":"s-jinshu-058-zhou-qiong-ws1775463"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin058-volume-zhou-qiong-father","subject_person_id":"ch7_egc_g3g","object_person_id":"aiu_ulx_ejj","predicate":"father","qualifiers":{"source_term":"子瓊嗣"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-058","chapter_id":"c-jinshu-058-zhou-chu-fu-son","source_id":"s-jinshu-058-zhou-chu-fu-son-ws1775463","paragraph_id":"c-jinshu-058-zhou-chu-fu-son:p001","quote":"楚字元孫。起家參征西軍事，從父入蜀，拜鷹揚將軍、犍爲太守。父卒，以楚監梁、益二州、假節，襲爵建城公。世在梁、益，甚得物情。時梁州刺史司馬勳作逆，楚與硃序討平之，進冠軍將軍。太和中，蜀盜李金銀、廣漢妖賊李弘並聚眾爲寇，偽稱李勢子，當以聖道王，年號鳳皇。又隴西人李高詐稱李雄子，破涪城。梁州刺史楊亮失守，楚遣其子詩平之。是歳，楚卒，諡曰定。子瓊嗣。","subject_person_mention_id":"c-jinshu-058-zhou-chu-fu-son:p001:m0169","object_person_mention_id":"c-jinshu-058-zhou-chu-fu-son:p001:m0000"}],"status":"source_attested","interpretation_note":"楚卒瓊嗣。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-jin058-volume-zhou-qiong-death","person_id":"ch7_egc_g3g","event_type":"death","source_term":"卒","source_anchor":{"paragraph_id":"c-jinshu-058-zhou-qiong:p001","start":89,"end":90,"surface":"卒"},"date_expression":null,"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-058","chapter_id":"c-jinshu-058-zhou-qiong","source_id":"s-jinshu-058-zhou-qiong-ws1775463","