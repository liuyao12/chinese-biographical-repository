b-nanqishu-043","source_id":"s-nanqishu-043-wangsiwei-ws2400356","chapter_id":"c-nanqishu-043-wangsiwei","paragraph_id":"c-nanqishu-043-wangsiwei:p001","quote":"思微","mention_id":"c-nanqishu-043-wangsiwei:p001:m0000"}],"review":"ai_provisional","identity_note":"南史數位思征、殿本思徵與齊書思微均出現於王晏拜驃騎對思遠之兄說阿戎勸自裁的同一對話；齊書另錄思微為陳伯之所殺。","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"7r6_k52_qji_ABDACABC","source_assertion_id":null,"parent_connection":{"type":"shared_father_through_siblings","sibling_assertion_ids":["a-nanshi024-wangsiyuan-older-zheng"],"sibling_father_assertion_id":"a-nanshi024-wangsiyuan-siyuan-father"},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-024","source_id":"s-nanshi-024-wangsiyuan-ws1765279","chapter_id":"c-nanshi-024-wangsiyuan","paragraph_id":"c-nanshi-024-wangsiyuan:p001","quote":"思遠，晏從父弟也。父羅雲，平西長史。思遠八歳父卒，祖弘之及外祖新安太守羊敬元並棲退高尚，故思遠少無仕心。宋建平王景素辟南徐州主簿，深見禮遇。景素被誅，左右離散，思遠親視殯葬，手種松柏，與廬江何昌宇、沛郡劉璡上表理之，事感朝廷。景素女廢爲庶人，思遠分衣食以相資贍。年長，爲備笄總，訪求素對，傾家送遣。","subject_person_mention_id":"c-nanshi-024-wangsiyuan:p001:m0000","object_person_mention_id":"c-nanshi-024-wangsiyuan:p001:m0010","source_assertion_id":"a-nanshi024-wangsiyuan-siyuan-father","source_term":"父羅雲"},{"work_id":"w-nanshi","book_id":"b-nanshi-024","source_id":"s-nanshi-024-wangsiyuan-ws1765279","chapter_id":"c-nanshi-024-wangsiyuan","paragraph_id":"c-nanshi-024-wangsiyuan:p003","quote":"建武中，遷吏部郎。思遠以晏爲尚書令，不欲並居內台權要之職，上表固讓，乃改授司徒左長史。初明帝廢立之際，思遠謂晏曰：「兄荷武帝厚恩，今一旦贊人如此事，彼或可以權計相須，未知兄將何以自立。及此引決，猶可保全門戸，不失後名。」晏曰：「方噉粥，未暇此事。」及拜驃騎，會子弟，謂思遠兄思征曰：「隆昌之末，阿戎勸吾自裁，若用其語，豈有今日。」思遠遽應曰：「如阿戎所見，猶未晩也。」晏既不能謙退，位處朝端，事多專斷，內外要職，並用門生，帝外跡甚美，內相疑異。思遠謂曰：「時事稍異，兄覺不？凡人多拙於自謀，而巧於謀人。」晏默然不答。思遠退後，晏方歎曰：「天下人遂勸人自殺。」旬日，晏及禍。明帝后知思遠有此言，謂江祏曰：「王晏早用思遠語，當不至此。」","subject_person_mention_id":"c-nanshi-024-wangsiyuan:p003:m0137","object_person_mention_id":"c-nanshi-024-wangsiyuan:p003:m0134","source_assertion_id":"a-nanshi024-wangsiyuan-older-zheng","source_term":"思遠兄思征"}],"status":"contextual_provisional","interpretation_note":"具名父子與兄弟原句相接，各條另存。","human_reviewed":false}}],"source_mention_summary":[{"source_id":"s-nanqishu-043-wangsiwei-ws2400356","work_id":"w-nanqishu","book_id":"b-nanqishu-043","chapter_id":"c-nanqishu-043-wangsiwei","raw_mention_count":1,"mention_ids":["c-nanqishu-043-wangsiwei:p001:m0000"],"paragraph_ids":["c-nanqishu-043-wangsiwei:p001"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-nanqishu-043-wangsiwei:p001:m0000","mention_ids":["c-nanqishu-043-wangsiwei:p001:m0000"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"},{"source_id":"s-nanqishu-043-wangsiyuan-ws2400356","work_id":"w-nanqishu","book_id":"b-nanqishu-043","chapter_id":"c-nanqishu-043-wangsiyuan","raw_mention_count":1,"mention_ids":["c-nanqishu-043-wangsiyuan:p006:m0088"],"paragraph_ids":["c-nanqishu-043-wangsiyuan:p006"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-nanqishu-043-wangsiyuan:p006:m0088","mention_ids":["c-nanqishu-043-wangsiyuan:p006:m0088"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"},{"source_id":"s-nanshi-024-wangsiyuan-ws1765279","work_id":"w-nanshi","book_id":"b-nanshi-024","chapter_id":"c-nanshi-024-wangsiyuan","raw_mention_count":1,"mention_ids":["c-nanshi-024-wangsiyuan:p003:m0137"],"paragraph_ids":["c-nanshi-024-wangsiyuan:p003"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-nanshi-024-wangsiyuan:p003:m0137","mention_ids":["c-nanshi-024-wangsiyuan:p003:m0137"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_cou