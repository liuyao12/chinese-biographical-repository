n_ids":["c-shiji-121-rulin:m015-0261"]}],"evidence":[{"mention_id":"c-shiji-121-rulin:m015-0261","chapter_id":"c-shiji-121-rulin","paragraph_id":"c-shiji-121-rulin:p015","quote":"伏生孫"}],"family_path":{"connection":"grandfather","generation_distance":2,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-121-rulin","source_id":"s-shiji121-rulin","paragraph_id":"c-shiji-121-rulin:p015","quote":"伏生教濟南張生及歐陽生，歐陽生教千乘兒寬。兒寬既通尚書，以文學應郡舉，詣博士受業，受業孔安國。兒寬貧無資用，常為弟子都養，及時時閒行傭賃，以給衣食。行常帶經，止息則誦習之。以試第次，補廷尉史。是時張湯方鄉學，以為奏讞掾，以古法議決疑大獄，而愛幸寬。寬為人溫良，有廉智，自持，而善著書、書奏，敏於文，口不能發明也。湯以為長者，數稱譽之。及湯為御史大夫，以兒寬為掾，薦之天子。天子見問，說之。張湯死后六年，兒寬位至御史大夫。九年而以官卒。寬在三公位，以和良承意從容得久，然無有所匡諫；於官，官屬易之，不為盡力。張生亦為博士。而伏生孫以治尚書徵，不能明也。"}],"source_assertion_id":"a-shiji121-003","interpretation_note":"按本篇明示父子或祖孫共根；星號保存缺失一代，不補姓名。不同星號分支不表示兩孫同父或出生排行，來源祖孫斷言為解讀依據。","reviewer":"Codex（AI 代理）","ancestor_person_id":"t6q_oe6_hom","parent_person_id":null,"intermediate_person_ids":[null]}}],"source_mention_summary":[{"source_id":"s-shiji121-rulin","work_id":"w-shiji","book_id":"b-shiji-121","chapter_id":"c-shiji-121-rulin","mention_count":1,"mention_ids":["c-shiji-121-rulin:m015-0261"],"paragraph_ids":["c-shiji-121-rulin:p015"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji121-rulin"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji121-003","subject_person_id":"t6q_oe6_hom_*A","predicate":"grandfather","object_person_id":"t6q_oe6_hom","status":"source_attested","evidence":[{"chapter_id":"c-shiji-121-rulin","source_id":"s-shiji121-rulin","paragraph_id":"c-shiji-121-rulin:p015","quote":"伏生教濟南張生及歐陽生，歐陽生教千乘兒寬。兒寬既通尚書，以文學應郡舉，詣博士受業，受業孔安國。兒寬貧無資用，常為弟子都養，及時時閒行傭賃，以給衣食。行常帶經，止息則誦習之。以試第次，補廷尉史。是時張湯方鄉學，以為奏讞掾，以古法議決疑大獄，而愛幸寬。寬為人溫