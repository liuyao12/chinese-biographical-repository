order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-049-yinrui:p001","text":"殷叡字文子，陳郡人。晉太常融七世孫也。宋元嘉末，祖元素坐染太初事誅。叡遺腹亦當從戮，外曾祖王僧朗啓孝武救之，得免。叡解文義，有口才，司徒褚淵甚重之，謂之曰：「諸殷自荊州以來，無出卿右者。」叡歛容答曰：「殷族衰悴，誠不如昔，若此旨爲虛，故不足降；此旨爲實，彌不可聞。」奐爲雍州，啓叡爲府長史。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":40,"last_line":40,"raw_start":2372,"raw_end":2517,"raw_character_offsets":[2372,2373,2374,2375,2376,2377,2378,2379,2380,2381,2382,2383,2384,2385,2386,2387,2388,2389,2390,2391,2392,2393,2394,2395,2396,2397,2398,2399,2400,2401,2402,2403,2404,2405,2406,2407,2408,2409,2410,2411,2412,2413,2414,2415,2416,2417,2418,2419,2420,2421,2422,2423,2424,2425,2426,2427,2428,2429,2430,2431,2432,2433,2434,2435,2436,2437,2438,2439,2440,2441,2442,2443,2444,2445,2446,2447,2448,2449,2450,2451,2452,2453,2454,2455,2456,2457,2458,2459,2460,2461,2462,2463,2464,2465,2466,2467,2468,2469,2470,2471,2472,2473,2474,2475,2476,2477,2478,2479,2480,2481,2482,2483,2484,2485,2486,2487,2488,2489,2490,2491,2492,2493,2494,2495,2496,2497,2498,2499,2500,2501,2502,2503,2504,2505,2506,2507,2508,2509,2510,2511,2512,2513,2514,2515,2516],"revision_id":2261984},"mentions":[{"id":"c-nanqishu-049-yinrui:p001:m0000","start":0,"end":2,"surface":"殷叡","kind":"person","person_id":"ceq_pnr_q0e","status":"contextual_provisional"},{"id":"c-nanqishu-049-yinrui:p001:m0003","start":3,"end":5,"surface":"文子","kind":"person","person_id":"ceq_pnr_q0e","status":"contextual_provisional"},{"id":"c-nanqishu-049-yinrui:p001:m0013","start":13,"end":14,"surface":"融","kind":"person","person_id":"ali_hbb_4bn","status":"contextual_provisional"},{"id":"c-nanqishu-049-yinrui:p001:m0025","start":25,"end":27,"surface":"元素","kind":"person","person_id":"9ac_ddl_9iz","status":"contextual_provisional"},{"id":"c-nanqishu-049-yinrui:p001:m0034","start":34,"end":35,"surface":"叡","kind":"person","person_id":"ceq_pnr_q0e","status":"contextual_provisiona