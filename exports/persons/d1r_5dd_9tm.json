rson_id":"6j7_udm_uq6","status":"contextual_provisional"},{"id":"c-shiji-069-su:m045-0673","start":673,"end":675,"surface":"蘇秦","kind":"person","person_id":"98y_02x_z6o","status":"contextual_provisional"},{"id":"c-shiji-069-su:m045-0678","start":678,"end":680,"surface":"蘇厲","kind":"person","person_id":"pwp_hh1_8da","status":"contextual_provisional"},{"id":"c-shiji-069-su:m045-0681","start":681,"end":684,"surface":"燕質子","kind":"person","person_id":"d1r_5dd_9tm","status":"contextual_provisional"}],"chapter_id":"c-shiji-069-su","book_id":"b-shiji-069","work_id":"w-shiji","source_id":"s-shiji-069-su"},{"id":"c-shiji-069-su:p046","text":"燕相子之與蘇代婚，而欲得燕權，乃使蘇代侍質子於齊。齊使代報燕，燕王噲問曰：「齊王其霸乎？」曰：「不能。」曰：「何也？」曰：「不信其臣。」於是燕王專任子之，已而讓位，燕大亂。齊伐燕，殺王噲、子之。燕立昭王，而蘇代、蘇厲遂不敢入燕，皆終歸齊，齊善待之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m046-0002","start":2,"end":4,"surface":"子之","kind":"person","person_id":"nfi_mir_dew","status":"contextual_provisional"},{"id":"c-shiji-069-su:m046-0005","start":5,"end":7,"surface":"蘇代","kind":"person","person_id":"phx_4fq_fnx","status":"contextual_provisional"},{"id":"c-shiji-069-su:m046-0017","start":17,"end":19,"surface":"蘇代","kind":"person","person_id":"phx_4fq_fnx","status":"contextual_provisional"},{"id":"c-shiji-069-su:m046-0020","start":20,"end":22,"surface":"質子","kind":"person","person_id":"d1r_5dd_9tm","status":"contextual_provisional"},{"id":"c-shiji-069-su:m046-0027","start":27,"end":28,"surface":"代","kind":"person","person_id":"phx_4fq_fnx","status":"contextual_provisional"},{"id":"c-shiji-069-su:m046-0031","start":31,"end":34,"surface":"燕王噲","kind":"person","person_id":"8tn_cxl_8ru","status":"contextual_provisional"},{"id":"c-shiji-069-su:m046-0038","start":38,"end":40,"surface":"齊王","kind":"person","person_id":"6j7_udm_uq6","status":"contextual_provisional"},{"id":"c-shiji-069-su:m046-0064","start":64,"end":66,"surface":"其臣","kind":"unresolved","person_id":null,"status":"unresolved","no