{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"aqe_rrh_jn4","canonical_person_id":"aqe_rrh_jn4","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["aqe_rrh_jn4"],"persons":[{"id":"aqe_rrh_jn4","label":"杜錫〔太子舍人〕","status":"active","historicity":"historical_tradition","aliases":[{"surface":"杜錫","mention_ids":["c-jinshu-053-minhuai-yu:p003:m0313"]}],"evidence":[{"mention_id":"c-jinshu-053-minhuai-yu:p003:m0313","paragraph_id":"c-jinshu-053-minhuai-yu:p003","chapter_id":"c-jinshu-053-minhuai-yu","quote":"杜錫"}],"review":"ai_provisional","identity_note":"杜錫〔太子舍人〕，見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-jinshu-053-minhuai-yu-ws2595666","work_id":"w-jinshu","book_id":"b-jinshu-053","chapter_id":"c-jinshu-053-minhuai-yu","raw_mention_count":1,"mention_ids":["c-jinshu-053-minhuai-yu:p003:m0313"],"paragraph_ids":["c-jinshu-053-minhuai-yu:p003"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-053-minhuai-yu:p003:m0313","mention_ids":["c-jinshu-053-minhuai-yu:p003:m0313"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-053-minhuai-yu-ws2595666"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-053-minhuai-yu:p003:m0313","start":313,"end":315,"surface":"杜錫","kind":"person","person_id":"aqe_rrh_jn4","status":"contextual_provisional","paragraph_id":"c-jinshu-053-minhuai-yu:p003","chapter_id":"c-jinshu-053-minhuai-yu"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-053-minhuai-yu:p003","text":"及長，不好學，惟與左右嬉戲，不能尊敬保傅。賈后素忌太子有令譽，因此密敕黃門閹宦媚諛于太子曰：「殿下誠可及壯時極意所欲，何為恆自拘束？」每見喜怒之際，輒歎曰：「殿下不知用威刑，天下豈得畏服！」太子所幸蔣美人生男，又言宜隆其賞賜，多為皇孫造玩弄之器，太子從之。於是慢弛益彰，或廢朝侍，恆在後園遊戲。愛埤車小馬，令左右馳騎，斷其鞅勒，使墮地為樂。或有犯忤者，手自捶擊之。性拘小忌，不許繕壁修牆，正瓦動屋。而于宮中為市，使人屠酤，手揣斤兩，輕重不差。其母本屠家女也，故太子好之。又令西園賣葵菜、藍子、雞、面之屬，而收其利。東宮舊制，月請錢五十萬，備於眾用，太子恆探取二月，以供嬖寵。洗馬江統陳五事以諫之，太子不納，語在《統傳》中。舍人杜錫以太子非賈后所生，而后性凶暴，深以為憂，每盡忠規勸太子修德進善，遠於讒謗。太子怒，使人以針著錫常所坐氈中而剌之。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":16,"last_line":16,"raw_start":646,"raw_end":1032,"raw_character_offsets":[646,647,648,649,650,651,652,653,654,655,656,657,658,659,660,661,662,663,664,665,666,667,668,669,670,671,672,673,674,675,676,677,678,679,680,681,682,683,684,685,686,687,688,689,690,691,692,693,694,695,696,697,698,699,700,701,702,703,704,705,706,707,708,709,710,711,712,713,714,715,716,717,718,719,720,721,722,723,724,725,726,727,728,729,730,731,732,733,734,735,736,737,738,739,740,741,742,743,744,745,746,747,748,749,750,751,752,753,754,755,756,757,758,759,760,761,762,763,764,765,766,767,768,769,770,771,772,773,774,775,776,777,778,779,780,781,782,783,784,785,786,787,788,789,790,791,792,793,794,795,796,797,798,799,800,801,802,803,804,805,806,807,808,809,810,811,812,813,814,815,816,817,818,819,820,821,822,823,824,825,826,827,828,829,830,831,832,833,834,835,836,837,838,839,840,841,842,843,844,845,846,847,848,849,850,851,852,853,854,855,856,857,858,859,860,861,862