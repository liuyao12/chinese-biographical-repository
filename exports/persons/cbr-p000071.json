surface":"帝廑","kind":"person","person_id":"cbr-p000071","status":"source_identified","paragraph_id":"c-shiji-002-xia:p033","chapter_id":"c-shiji-002-xia"}],"relations":[{"id":"a-shiji002-021","subject_person_id":"cbr-p000071","predicate":"father","object_person_id":"cbr-p000070","status":"source_attested","evidence":[{"chapter_id":"c-shiji-002-xia","source_id":"s-shiji-002-xia","paragraph_id":"c-shiji-002-xia:p033","quote":"帝扃崩，子帝廑立"}],"qualifiers":{"source_term":"子","historicity":"legendary_tradition"},"interpretation_note":"僅記來源明示的親屬關係，不把繼位推成父子。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-002-xia:p033","text":"中康崩，子帝相立。帝相崩，子帝少康立。帝少康崩，子帝予立。帝予崩，子帝槐立。帝槐崩，子帝芒立。帝芒崩，子帝泄立。帝泄崩，子帝不降立。帝不降崩，弟帝扃立。帝扃崩，子帝廑立。帝廑崩，立帝不降之子孔甲，是爲帝孔甲。帝孔甲立，好方鬼神，事淫亂。夏后氏德衰，諸侯畔之。天降龍二，有雌雄，孔甲不能食，未得豢龍氏。陶唐既衰，其后有劉累，學擾龍于豢龍氏，以事孔甲。孔甲賜之姓曰御龍氏，受豕韋之後。龍一雌死，以食夏后。夏后使求，懼而遷去。","mentions":[{"id":"c-shiji-002-xia:m033-0000","start":0,"end":2,"surface":"中康","kind":"person","person_id":"cbr-p000061","status":"source_identified"},{"id":"c-shiji-002-xia:m033-0005","start":5,"end":7,"surface":"帝相","kind":"person","person_id":"cbr-p000063","status":"source_identified"},{"id":"c-shiji-002-xia:m033-0009","start":9,"end":11,"surface":"帝相","kind":"person","person_id":"cbr-p000063","status":"source_identified"},{"id":"c-shiji-002-xia:m033-0014","start":14,"end":17,"surface":"帝少康","kind":"person","person_id":"cbr-p000064","status":"source_identified"},{"id":"c-shiji-002-xia:m033-0019","start":19,"end":22,"surface":"帝少康","kind":"person","person_id":"cbr-p000064","status":"source_identified"},{"id":"c-shiji-002-xia:m033-0025","start":25,"end":27,"surface":"帝予","kind":"person","person_id":"cbr-p000065","status":"source_identified"},{"id":"c-shiji-002-xia:m033-0029","start":29,"end":31,"surface":"帝予","kind":"person","person_id":"cbr-p000065","status":"source_identified"},{"id":"c-sh