guozhi-051-shao:line051-pei01-01","chapter_id":"c-sanguozhi-051-shao"},{"id":"c-sanguozhi-051-shao:line051-pei01-01:m0131","start":131,"end":132,"surface":"洪","kind":"person","person_id":"rit_tr5_qrv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-051-shao:line051-pei01-01","chapter_id":"c-sanguozhi-051-shao"},{"id":"c-sanguozhi-051-shao:line051-pei01-01:m0149","start":149,"end":150,"surface":"洪","kind":"person","person_id":"rit_tr5_qrv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-051-shao:line051-pei01-01","chapter_id":"c-sanguozhi-051-shao"},{"id":"c-sanguozhi-051-shao:line051-pei01-01:m0176","start":176,"end":177,"surface":"洪","kind":"person","person_id":"rit_tr5_qrv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-051-shao:line051-pei01-01","chapter_id":"c-sanguozhi-051-shao"},{"id":"c-sanguozhi-051-yi:line041:m0059","start":59,"end":61,"surface":"邊鴻","kind":"person","person_id":"rit_tr5_qrv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-051-yi:line041","chapter_id":"c-sanguozhi-051-yi"},{"id":"c-sanguozhi-051-yi:line041:m0064","start":64,"end":65,"surface":"鴻","kind":"person","person_id":"rit_tr5_qrv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-051-yi:line041","chapter_id":"c-sanguozhi-051-yi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-051-shao:line051-pei01-01","text":"《吴历》曰：妫览、戴员亲近边洪等，数为翊所困，常欲叛逆，因吴主出征，遂其奸计。时诸县令长并会见翊，翊以妻徐氏颇晓卜，翊入语徐：“吾明日欲为长吏作主人，卿试卜之。”徐言：“卦不能佳，可须异日。”翊以长吏来久，宜速遣，乃大请宾客。翊出入常持刀，尔时有酒色，空手送客，洪从后斫翊，郡中扰乱，无救翊者，遂为洪所杀，迸走入山。徐氏购募追捕，中宿乃得，览、员归罪杀洪。诸将皆知览、员所为，而力不能讨。览入居军府中，悉取翊嫔妾及左右侍御，欲复取徐。恐逆之见害，乃绐之曰：“乞须晦日设祭除服。”时月垂竟，览听须祭毕。徐潜使所亲信语翊亲近旧将孙高、傅婴等，说：“览已虏略婢妾，今又欲见偪，所以外许之者，欲安其意以免祸耳。欲立微计，原二君哀救。”高、婴涕泣答言：“受府君恩遇，所以不即死难者，以死无益，欲思惟事计，事计未立，未敢启夫人耳。今日之事，实夙夜所怀也。”乃密呼翊时侍养者二十餘人，以徐意语之，共盟誓，合谋。到晦日，设祭，徐氏哭泣尽哀毕，乃除服，薰香沐浴，更於他室，安施帏帐，言笑欢悦，示无戚容。大小凄怆，怪其如此。览密觇视，无复疑意。徐呼高、婴与诸婢罗住户内，使人报览，说已除凶即吉，惟府君敕命。览盛意入，徐出户拜。览適得一拜，徐便大呼：“二君可起！”高、婴俱出，共得杀览，餘人即就外杀员。夫人乃还缞绖，奉览、员首以祭翊墓。举军震骇，以为神异。吴主续至，悉族诛览、员餘党，擢高、婴为牙门，其餘皆加赐金帛，殊其门户。","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-051-shao:line051-pei01-01:m0006","start":6,"end":8,"surface":"妫览","kind":"person","person_id":"syg_4kw_bmq","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-shao:line051-pei01-01:m0009","start":9,"end":11,"surface":"戴员","kind":"person","person_id":"ohq_g9f_aas","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-shao:line051-pei01-01:m0013","start":13,"end":15,"surface":"边洪","kind":"person","person_id":"rit_tr5_qrv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-shao:line051-pei01-01:m0019","start":19,"end":20,"surface":"翊","kind":"person","person_id":"iyi_e4b_ig6","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-shao:line051-pei01-01:m0029","start":29,"end":31,"surface":"吴主","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-shao:line051-pei01-01:m0047","start":47,"end":48,"surface":"翊","kind":"person","person_id":"iyi_e4b_ig6","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-shao:line051-pei01-01:m0049","start":49,"end":50,"surface":"翊","kind":"person","person_id":"iyi_e4b_ig6","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-shao:line051-pei01-01:m0052","start":52,"end":54,"surface":"徐氏","kind":"person","person_id":"i4h_2if_lwt","status":"contextual_provis