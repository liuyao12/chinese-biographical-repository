"s-shiji-012-wudi"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-049-jikang-rendered-comparison:p001:m0204","start":204,"end":206,"surface":"安期","kind":"person","person_id":"91s_bsz_pe8","status":"contextual_provisional","role_key":"anqi","source_scope":"received_biographical_narration","paragraph_id":"c-jinshu-049-jikang-rendered-comparison:p001","chapter_id":"c-jinshu-049-jikang-rendered-comparison"},{"id":"c-shiji-012-wudi:m007-0070","start":70,"end":73,"surface":"安期生","kind":"person","person_id":"91s_bsz_pe8","status":"contextual_provisional","paragraph_id":"c-shiji-012-wudi:p007","chapter_id":"c-shiji-012-wudi"},{"id":"c-shiji-012-wudi:m007-0082","start":82,"end":85,"surface":"安期生","kind":"person","person_id":"91s_bsz_pe8","status":"contextual_provisional","paragraph_id":"c-shiji-012-wudi:p007","chapter_id":"c-shiji-012-wudi"},{"id":"c-shiji-012-wudi:m007-0122","start":122,"end":125,"surface":"安期生","kind":"person","person_id":"91s_bsz_pe8","status":"contextual_provisional","paragraph_id":"c-shiji-012-wudi:p007","chapter_id":"c-shiji-012-wudi"},{"id":"c-shiji-012-wudi:m008-0034","start":34,"end":37,"surface":"安期生","kind":"person","person_id":"91s_bsz_pe8","status":"contextual_provisional","paragraph_id":"c-shiji-012-wudi:p008","chapter_id":"c-shiji-012-wudi"},{"id":"c-shiji-012-wudi:m017-0175","start":175,"end":177,"surface":"安期","kind":"person","person_id":"91s_bsz_pe8","status":"contextual_provisional","paragraph_id":"c-shiji-012-wudi:p017","chapter_id":"c-shiji-012-wudi"},{"id":"c-shiji-012-wudi:m021-0260","start":260,"end":263,"surface":"安期生","kind":"person","person_id":"91s_bsz_pe8","status":"contextual_provisional","paragraph_id":"c-shiji-012-wudi:p021","chapter_id":"c-shiji-012-wudi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-jin049-role-anqi","person_id":"91s_bsz_pe8","surfaces":["安期"],"scope":"cross_chapter","chapter_ids":["c-jinshu-049-jikang-rendered-comparison","c-shiji-012-wudi"],"status":"contextual_provisional","confidence_level":"moderate","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-049","source_id":"s-jinshu049-jikang-web-rendered-comparison","chapter_id":"c-jinshu-049-jikang-rendered-comparison","paragraph_id":"c-jinshu-049-jikang-rendered-comparison:p001","quote":"嵇康，字叔夜，譙國銍人也。其先姓奚，會稽上虞人，以避怨，徙焉。銍有嵇山，家於其側，因而命氏。兄喜，有當世才，暦太僕、宗正。康早孤，有奇才，遠邁不群。身長七尺八寸，美詞氣，有風儀，而土木形骸，不自藻飾，人以爲龍章鳳姿，天質自然。恬靜寡欲，含垢匿瑕，寬簡有大量。學不師受，博覽無不該通，長好《老》《莊》。與魏宗室婚，拜中散大夫。常脩養性服食之事，彈琴詠詩，自足於懷。以爲神仙稟之自然，非積學所得，至於導養得理，則安期、彭祖之倫可及，乃著《養生論》。又以爲君子無私，其論曰：「夫稱君子者，心不措乎是非，而行不違乎道者也。何以言之？夫氣靜神虚者，心不存于矜尚；體亮心達者，情不繫於所欲。矜尚不存乎心，故能越名教而任自然；情不繫於所欲，故能審貴賤而通物情。物情順通，故大道無違；越名任心，故是非無措也。是故言君子則以無措爲主，以通物爲美；言小人則以匿情爲非，以違道爲闕。何者？匿情矜吝，小人之至惡；虚心無措，君子之篤行也。是以大道言『及吾無身，吾又何患』。無以生爲貴者，是賢於貴生也。由斯而言，夫至人之用心，固不存有措矣。故曰『君子行道，忘其爲身』，斯言是矣。君子之行賢也，不察於有度而後行也；任心無邪，不議於善而後正也；顯情無措，不論於是而後爲也。是故傲然忘賢，而賢與度會；忽然任心，而心與善遇；儻然無措，而事與是倶也。」其略如此。蓋其胸懷所寄，以髙契難期，毎思郢質。所與神交者惟陳留阮籍、河内山濤，豫其流者河内向秀、沛國劉伶、籍兄子咸、琅邪王戎，遂爲竹林之遊，世所謂「竹林七賢」也。戎自言與康居山陽二十年，未嘗見其喜慍之色。","person_mention_id":"c-jinshu-049-jikang-rendered-comparison:p001:m0204"},{"work_id":"w-shiji","book_id":"b-shiji-012","source_id":"s-shiji-012-wudi","chapter_id":"c-shiji-012-wudi","paragraph_id":"c-shiji-012-wudi:p008","quote":"居久之，李少君病死。天子以為化去不死也，而使黃錘史寬舒受其方。求蓬萊安期生莫能得，而海上燕齊怪迂之方士多相效，更言神事矣。","person_mention_id":"c-shiji-012-wudi:m008-0034"}],"rationale":"來源本單元角色與語境；保原詞，不按名稱近似補全身份或生平。","source_identity_key":"anqi","human_reviewed":false,"model":null},{"id":"d-shiji012-018","person_id":"91s_bsz_pe8","surfaces":["安期","安期生"],"scope":"same_chapter","chapter_ids":["c-shiji-012-wudi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-012-wudi:p007","quote":"少君言於上曰：「祠灶則致物，致物而丹沙可化為黃金，黃金成以為飲食器則益壽，益壽而海中蓬萊僊者可見，見之以封禪則不死，黃帝是也。臣嘗游海上，見安期生，食臣棗，大如瓜。安期生僊者，通蓬萊中，合則見人，不合則隱。」於是天子始親祠灶，而遣方士入海求蓬萊安期生之屬，而事化丹沙諸藥齊為黃金矣。"},{"paragraph_id":"c-shiji-012-wudi:p008","quote":"居久之，李少君病死。天子以為化去不死也，而使黃錘史寬舒受其方。求蓬萊安期生莫能得，而海上燕齊怪迂之方士多相效，更言神事矣。"},{"paragraph_id":"c-shiji-012-wudi:p017","quote":"其春，樂成侯上書言欒大。欒大，膠東宮人，故嘗與文成將軍同師，已而為膠東王尚方。而樂成侯姊為康王后，毋子。康王死，他姬子立為王。而康后有淫行，與王不相中（得），相危以法。康后聞文成已死，而欲自媚於上，乃遣欒大因樂成侯求見言方。天子既誅文成，後悔恨其早死，惜其方不盡，及見欒大，大悅。大為人長美，言多方略，而敢為大言，處之不疑。大言曰：「臣嘗往來海中，見安期、羨門之屬。顧以為臣賤，不信臣。又以為康王諸侯耳，不足予方。臣數言康王，康王又不用臣。臣之師曰：『黃金可成，而河決可塞，不死之藥可得，僊人可致也。』臣恐效文成，則方士皆掩口，惡敢言方哉！」上曰：「文成食馬肝死耳。子誠能修其方，我何愛乎！」大曰：「臣師非有求人，人者求之。陛下必欲致之，則貴其使者，令有親屬，以客禮待之，勿卑，使各佩其信印，乃可使通言於神人。神人尚肯邪不邪。致尊其使，然後可致也。」於是上使先驗小方，鬬旗，旗自相觸擊。"},{"paragraph_id":"c-shiji-012-wudi:p021","quote":"其秋，上幸雍，且郊。或曰「五帝，泰一之佐也。宜立泰一而上親郊之」。上疑未定。齊人公孫卿曰：「今年得寶鼎，其冬辛巳朔旦冬至，與黃帝時等。」卿有札書曰：「黃帝得寶鼎宛（侯）［朐］，問於鬼臾區。區對曰：『（黃）帝得寶鼎神筴，是歲己酉朔旦冬至，得天之紀，終而復始。』於是黃帝迎日推筴，後率二十歲得朔旦冬至，凡二十推，三百八十年。黃帝僊登于天。」卿因所忠欲奏之。所忠視其書不經，疑其妄書，謝曰：「寶鼎事已決矣，尚何以為！」卿因嬖人奏之。上大說，召問卿。對曰：「受此書申功，申功已死。」上曰：「申功何人也？」卿曰：「申功，齊人也。與安期生通，受黃帝言，無書，獨有此鼎書。曰『漢興復當黃帝之時。漢之聖者在高祖之孫且曾孫也。寶鼎出而與神通，封禪。封禪七十二王，唯黃帝得上泰山封』。申功曰：『漢主亦當上封，上封則能僊登天矣。黃帝時萬諸侯，而神靈之封居七千。天下名山八，而三在蠻夷，五在中國。中國華山、首山、太室、泰山、東萊，此五山黃帝之所常遊，與神會。黃帝且戰且學僊。患百姓非其道，乃斷斬非鬼神者。百餘歲然後得與神通。黃帝郊雍上帝，宿三月。鬼臾區號大鴻，死葬雍，故鴻冢是也。其後於黃帝接萬靈明廷。明廷者，甘泉也。所謂寒門者，谷口也。黃帝采首山銅，鑄鼎荊山下。鼎既成，有龍垂胡髯下迎黃帝。黃帝上騎，群臣後宮從上龍七十餘人，乃上去。餘小臣不得上，乃悉持龍髯，龍髯拔，墮黃帝之弓。百姓仰望黃帝既上天，乃抱其弓與龍胡髯號。故後世因名其處曰鼎湖，其弓曰烏號。』」於是天子曰：「嗟乎！吾誠得如黃帝，吾視去妻子如脫屣耳。」乃拜卿為郎，東使候神於太室。"}],"rationale":"依本篇封禪、方士、授官與神異引語的明示語境判讀異稱；神祇或傳說不轉為已確證生平，跨篇同指仍待版本與專門研究核對。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-049-jikang-rendered-comparison:p001","text":"嵇康，字叔夜，譙國銍人也。其先姓奚，會稽上虞人，以避怨，徙焉。銍有嵇山，家於其側，因而命氏。兄喜，有當世才，暦太僕、宗正。康早孤，有奇才，遠邁不群。身長七尺八寸，美詞氣，有風儀，而土木形骸，不自藻飾，人以爲龍章鳳姿，天質自然。恬靜寡欲，含垢匿瑕，寬簡有大量。學不師受，博覽無不該通，長好《老》《莊》。與魏宗室婚，拜中散大夫。常脩養性服食之事，彈琴詠詩，自足於懷。以爲神仙稟之自然，非積學所得，至於導養得理，則安期、彭祖之倫可及，乃著《養生論》。又以爲君子無私，其論曰：「夫稱君子者，心不措乎是非，而行不違乎道者也。何以言之？夫氣靜神虚者，心不存于矜尚；體亮心達者，情不繫於所欲。矜尚不存乎心，故能越名教而任自然；情不繫於所欲，故能審貴賤而通物情。物情順通，故大道無違；越名任心，故是非無措也。是故言君子則以無措爲主，以通物爲美；言小人則以匿情爲非，以違道爲闕。何者？匿情矜吝，小人之至惡；虚心無措，君子之篤行也。是以大道言『及吾無身，吾又何患』。無以生爲貴者，是賢於貴生也。由斯而言，夫至人之用心，固不存有措矣。故曰『君子行道，忘其爲身』，斯言是矣。君子之行賢也，不察於有度而後行也；任心無邪，不議於善而後正也；顯情無措，不論於是而後爲也。是故傲然忘賢，而賢與度會；忽然任心，而心與善遇；儻然無措，而事與是倶也。」其略如此。蓋其胸懷所寄，以髙契難期，毎思郢質。所與神交者惟陳留阮籍、河内山濤，豫其流者河内向秀、沛國劉伶、籍兄子咸、琅邪王戎，遂爲竹林之遊，世所謂「竹林七賢」也。戎自言與康居山陽二十年，未嘗見其喜慍之色。","text_layer":"received_chapter","annotation_status":"in_progress","captured_source_position":{"capture_ref":"source-evidence/jin049-jikang-rendered-comparison/web-rendered-extract.txt","capture_sha256":"29c47ce1cafc7ab2c1318b007e5fd9a4f92bc4c6610cc85d604422533bdfa8eb","projection_ref":"source-evidence/jin049-jikang-rendered-comparison/capture-projection.json","unit_key":"p001","coordinate_scope":"captured_web_tool_output_not_original_or_printed_lines","rendered_reference_line":226},"mentions":[{"id":"c-jinshu-049-jikang-rendered-comparison:p001:m0000","start":0,"end":2,"surface":"嵇康","kind":"person","person_id":"6fg_r6l_5a5","status":"contextual_provisional","role_key":"jikang","source_scope":"received_biographical_narration"},{"id":"c-jinshu-049-jikang-rendered-comparison:p001:m0004","start":4,"end":6,"surface":"叔夜","kind":"person","person_id":"6fg_r6l_5a5","status":"contextual_provisional","role_key":"jikang","source_scope":"received_biographical_narration"},{"id":"c-jinshu-049-jikang-rendered-comparison:p001:m0047","start":47,"end":48,"surface":"喜","kind":"person","person_id":"igx_5m2_qfa","status":"contextual_provisional","role_key":"jixi","source_scope":"received_biographical_narration"},{"id":"c-jinshu-049-jikang-rendered-comparison:p001:m0061","start":61,"end":62,"surface":"康","kind":"person","person_id":"6fg_r6l_5a5","status":"contextual_provis