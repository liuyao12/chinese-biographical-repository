rce_assertion_id":"a-shiji033-002","interpretation_note":"以此受傳正文的明示近親主張配置局部家族；不合併跨篇候選身份、不補闕名世代，不表示遠祖世系已核實。分支字元不是長幼排行。","reviewer":"Codex（AI 代理）","parent_person_id":"y4i_pjk_4gn_A"}}],"source_mention_summary":[{"source_id":"s-shiji-004-zhou","work_id":"w-shiji","book_id":"b-shiji-004","chapter_id":"c-shiji-004-zhou","raw_mention_count":1,"mention_ids":["c-shiji-004-zhou:m036-0003"],"paragraph_ids":["c-shiji-004-zhou:p036"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-shiji-004-zhou:m036-0003","mention_ids":["c-shiji-004-zhou:m036-0003"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-shiji-004-zhou"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-004-zhou:m036-0003","start":3,"end":5,"surface":"周公","kind":"person","person_id":"b23_5g5_byb","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p036","chapter_id":"c-shiji-004-zhou"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"identity_distinctions":[{"id":"d-shiji004-distinct-003","person_ids":["y4i_pjk_4gn_AD","b23_5g5_byb","qj3_l69_xhu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-004-zhou:p023","quote":"成王在豐，使召公復營洛邑，如武王之意。周公復卜申視，卒營筑，居九鼎焉。曰：「此天下之中，四方入貢道里均。」作《召誥》、《洛誥》。成王既遷殷遺民，周公以王命告，作《多士》、《無佚》。召公為保，周公為師，東伐淮夷，殘奄，遷其君薄泵。成王自奄歸，在宗周，作《多方》。既絀殷命，襲淮夷，歸在豐，作《周官》。興正禮樂，度制於是改，而民和睦，頌聲興。成王既伐東夷，息慎來賀，王賜榮伯作《賄息慎之命》。","chapter_id":"c-shiji-004-zhou","work_id":"w-shiji","book_id":"b-shiji-004","source_id":"s-shiji-004-zhou"},{"paragraph_id":"c-shiji-004-zhou:p036","quote":"召公、周公二相行政，號曰「共和」。共和十四年，厲王死于彘。太子靜長於召公家，二相乃共立之為王，是為宣王。宣王即位，二相輔之，修政，法文、武、成、康之遺風，諸侯復宗周。十二年，魯武公來朝。","chapter_id":"c-shiji-004-zhou","work_id":"w-shiji","book_id":"b-shiji-004","source_id":"s-shiji-004-zhou"},{"paragraph_id":"c-shiji-004-zhou:p047","quote":"二十三年，桓王崩，子莊王佗立。莊王四年，周公黑肩欲殺莊王而立王子克。辛伯告王，王殺周公。王子克奔燕。","chapter_id":"c-shiji-004-zhou","work_id":"w-shiji","book_id":"b-shiji-004","source_id":"s-shiji-004-zhou"}],"rationale":"成王、共和與莊王時的周公分別登記；官稱相同不足以合併。","reviewer":"Codex（AI 代理）"}],"passages":[{"id":"c-shiji-004-zhou:p023","text":"成王在豐，使召公復營洛邑，如武王之意。周公復卜申視，卒營筑，居九鼎焉。曰：「此天下之中，四方入貢道里均。」作《召誥》、《洛誥》。成王既遷殷遺民，周公以王命告，作《多士》、《無佚》。召公為保，周公為師，東伐淮夷，殘奄，遷其君薄泵。成王自奄歸，在宗周，作《多方》。既絀殷命，襲淮夷，歸在豐，作《周官》。興正禮樂，度制於是改，而民和睦，頌聲興。成王既伐東夷，息慎來賀，王賜榮伯作《賄息慎之命》。","annotation_status":"in_progress","mentions":[{"id":"c-shiji-004-zhou:m023-0000","start":0,"end":2,"surface":"成王","kind":"person","person_id":"qna_m75_pj8","status":"source_identified"},{"id":"c-shiji-004-zhou:m023-0006","start":6,"end":8,"surface":"召公","kind":"person","person_id":"7m7_qvm_4oj","status":"source_identified"},{"id":"c-shiji-004-zhou:m023-0014","start":14,"end":16,"surface":"武王","kind":"person","person_id":"y4i_pjk_4gn_AA","status":"source_identified"},{"id":"c-shiji-004-zhou:m023-0019","start":19,"end":21,"surface":"周公","kind":"person","person_id":"y4i_pjk_4gn_AD","status":"source_identified"},{"id":"c-shiji-004-zhou:m023-0064","start":64,"end":66,"surface":"成王","kind":"person","person_id":"qna_m75_pj8","sta