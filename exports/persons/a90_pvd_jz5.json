"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-chenshu-017-wangchong-complete:p003","text":"武陵王舉兵至峽口，王琳偏將陸納等據湘州應之，沖為納所拘。納降，重授侍中、中權將軍，量置佐史，尹如故。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":16,"last_line":16,"raw_start":762,"raw_end":812,"raw_character_offsets":[762,763,764,765,766,767,768,769,770,771,772,773,774,775,776,777,778,779,780,781,782,783,784,785,786,787,788,789,790,791,792,793,794,795,796,797,798,799,800,801,802,803,804,805,806,807,808,809,810,811],"revision_id":1544244},"mentions":[{"id":"c-chenshu-017-wangchong-complete:p003:m0000","start":0,"end":3,"surface":"武陵王","kind":"person","person_id":"fo7_f8v_rmf_D","status":"contextual_provisional"},{"id":"c-chenshu-017-wangchong-complete:p003:m0009","start":9,"end":11,"surface":"王琳","kind":"person","person_id":"hu7_m9r_hro","status":"contextual_provisional"},{"id":"c-chenshu-017-wangchong-complete:p003:m0013","start":13,"end":15,"surface":"陸納","kind":"person","person_id":"a90_pvd_jz5","status":"contextual_provisional"},{"id":"c-chenshu-017-wangchong-complete:p003:m0022","start":22,"end":23,"surface":"沖","kind":"person","person_id":"7r6_k52_qji_ABAAAAAABAA","status":"contextual_provisional"},{"id":"c-chenshu-017-wangchong-complete:p003:m0024","start":24,"end":25,"surface":"納","kind":"person","person_id":"a90_pvd_jz5","status":"contextual_provisional"},{"id":"c-chenshu-017-wangchong-complete:p003:m0028","start":28,"end":29,"surface":"納","kind":"person","person_id":"a90_pvd_jz5","status":"contextual_provisional"}],"chapter_id":"c-chenshu-017-wangchong-complete","book_id":"b-chenshu-017","work_id":"w-chenshu","source_id":"s-chenshu-017-wangchong-complete-ws1544244"},{"id":"c-liangshu-028-peizhiheng-complete:p002","text":"時尋陽王大心在江州，範副梅思立密要大心襲湓城，之橫斬思立而拒大心。大心以州降景。之橫率衆與兄之高同歸元帝，承制除散騎常侍、廷尉卿，出爲河東內史。又隨王僧辯拒侯景於巴陵，景退，遷持節、平北將軍、東徐州刺史，中護軍，封豫寧侯，邑三千戶。又隨僧辯追景，平郢、魯、江、晉等州，恒爲前鋒陷陣。仍至石頭，破景，景東奔，僧辯令之橫與杜崱入守臺城。及陸納據湘州叛，又隸王僧辯南討焉。于陣斬納將李賢明，遂平之。又破武陵王於硤口。還除吳興太守，乃作百幅被，以成其初志。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":46,"last_line":46,"raw_start":2662,"raw_end":2886,"raw_character_offsets":[2662,2663,2664,2665,2666,2667,2668,2669,2670,2671,2672,2673,2674,2675,2676,2677,2678,2679,2680,2681,2682,2683,2684,2685,2686,2687,2688,2689,2690,2691,2692,2693,2694,2695,2696,2697,2698,2699,2700,2701,2702,2703,2704,2705,2706,2707,2708,2709,2710,2711,2712,2713,2714,2715,2716,2717,2718,2719,2720,2721,2722,2723,2724,2725,2726,2727,2728,2729,2730,2731,2732,2733,2734,2735,2736,2737,2738,2739,2740,2741,2742,2743,2744,2745,2746,2747,2748,2749,2750,2751,2752,2753,2754,2755,2756,2757,2758,2759,2760,2761,2762,2763,2764,2765,2766,2767,2768,2769,2770,2771,2772,2773,2774,2775,2776,2777,2778,2779,2780,2781,2782,2783,2784,2785,2786,2787,2788,2789,2790,2791,2792,2793,2794,2795,2796,2797,2798,2799,2800,2801,2802,2803,2804,2805,2806,2807,2808,2809,2810,2811,2812,2813,2814,2815,2816,2817,2818,2819,2820,2821,2822,2823,2824,2825,2826,2827,2828,2829,2830,2831,2832,2833,2834,2835,2836,2837,2838,2839,2840,2841,2842,2843,2844,2845,2846,2847,2848,2849,2850,2851,2852,2853,2854,2855,2856,2857,2858,2859,2860,2861,2862,2863,2864,2865,2866,2867,2868,2869,2870,2871,2872,2873,2874,2875,2876,2877,2878,2879,2880,2881,2882,2883,2884,2885],"revision_id":1511902},"mentions":[{"id":"c-liangshu-028-peizhiheng-complete:p002:m0001","start":1,"end":6,"surface":"尋陽王大心","kind":"person","person_id":"rtd_v0b_nyn_E","status":"contextual_provisional"},{"id":"c-liangshu-028-peizhiheng-complete:p002:m0010","start":10,"end":11,"surface":"範","kind":"person","person_id":"qvt_eq1_lcf_AAB","status":"contextual_provisional"},{"id":"c-liangshu-028-peizhiheng-complete:p002:m0012","start":12,"end":15,"surface":"梅思立","kind":"person","person_id":"vzl_bgu_d5t","status":"contextual_provisional"},{"id":"c-liangshu-028-peizhiheng-complete:p002:m0017","start":17,"end":19,"surface":"大心","kind":"person","person_id":"rtd_v0b_nyn_E","status":"contextual_provisional"