{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p002607","identity_policy":"contextual_provisional","person_ids":["cbr-p002607"],"persons":[{"id":"cbr-p002607","label":"唐雎（魏世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"唐雎","mention_ids":["c-shiji-044-wei:m059-0032","c-shiji-044-wei:m059-0075","c-shiji-044-wei:m059-0120"]}],"evidence":[{"mention_id":"c-shiji-044-wei:m059-0032","chapter_id":"c-shiji-044-wei","paragraph_id":"c-shiji-044-wei:p059","quote":"唐雎"},{"mention_id":"c-shiji-044-wei:m059-0075","chapter_id":"c-shiji-044-wei","paragraph_id":"c-shiji-044-wei:p059","quote":"唐雎"},{"mention_id":"c-shiji-044-wei:m059-0120","chapter_id":"c-shiji-044-wei","paragraph_id":"c-shiji-044-wei:p059","quote":"唐雎"}]}],"mentions":[{"id":"c-shiji-044-wei:m059-0032","start":32,"end":34,"surface":"唐雎","kind":"person","person_id":"cbr-p002607","status":"contextual_provisional","paragraph_id":"c-shiji-044-wei:p059","chapter_id":"c-shiji-044-wei"},{"id":"c-shiji-044-wei:m059-0075","start":75,"end":77,"surface":"唐雎","kind":"person","person_id":"cbr-p002607","status":"contextual_provisional","paragraph_id":"c-shiji-044-wei:p059","chapter_id":"c-shiji-044-wei"},{"id":"c-shiji-044-wei:m059-0120","start":120,"end":122,"surface":"唐雎","kind":"person","person_id":"cbr-p002607","status":"contextual_provisional","paragraph_id":"c-shiji-044-wei:p059","chapter_id":"c-shiji-044-wei"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji044-108","person_id":"cbr-p002607","surfaces":["唐雎"],"scope":"same_chapter","chapter_ids":["c-shiji-044-wei"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-044-wei:p059","quote":"齊、楚相約而攻魏，魏使人求救於秦，冠蓋相望也，而秦救不至。魏人有唐雎者，年九十餘矣，謂魏王曰：『老臣請西説秦王，令兵先臣出。』魏王再拜，遂約車而遣之。唐雎到，入見秦王。秦王曰：『丈人芒然乃遠至此，甚苦矣！夫魏之來求救數矣，寡人知魏之急已。』唐雎對曰：『大王已知魏之急而救不發者，臣竊以爲用策之臣无任矣。夫魏，一萬乘之國也，然所以西面而事秦，稱東藩，受冠帶，祠春秋者，以秦之彊足以爲與也。今齊、楚之兵已合於魏郊矣，而秦救不發，亦將賴其未急也。使之大急，彼且割地而約從，王尚何救焉？必待其急而救之，是失一東藩之魏而彊二敵之齊、楚，則王何利焉？』於是秦昭王遽爲發兵救魏。魏氏復定。"}],"rationale":"限本篇明示姓名、封號、繼位與連續對話。无忌／信陵君及增／景湣王按明示語句暫接；公子政不與秦王政按同名合併。太子自相、蘇代扮演梁王與秦王未名時段各保留，不補姓名；中旗馮琴讀法待底本核查。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-044-wei:p059","text":"齊、楚相約而攻魏，魏使人求救於秦，冠蓋相望也，而秦救不至。魏人有唐雎者，年九十餘矣，謂魏王曰：『老臣請西説秦王，令兵先臣出。』魏王再拜，遂約車而遣之。唐雎到，入見秦王。秦王曰：『丈人芒然乃遠至此，甚苦矣！夫魏之來求救數矣，寡人知魏之急已。』唐雎對曰：『大王已知魏之急而救不發者，臣竊以爲用策之臣无任矣。夫魏，一萬乘之國也，然所以西面而事秦，稱東藩，受冠帶，祠春秋者，以秦之彊足以爲與也。今齊、楚之兵已合於魏郊矣，而秦救不發，亦將賴其未急也。使之大急，彼且割地而約從，王尚何救焉？必待其急而救之，是失一東藩之魏而彊二敵之齊、楚，則王何利焉？』於是秦昭王遽爲發兵救魏。魏氏復定。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-044-wei:m059-0032","start":32,"end":34,"surface":"唐雎","kind":"person","person_id":"cbr-p002607","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m059-0043","start":43,"end":45,"surface":"魏王","kind":"person","person_id":"cbr-p002601","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m059-0053","start":53,"end":55,"surface":"秦王","kind":"person","person_id":"cbr-p002579","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m059-0063","start":63,"end":65,"surface":"魏王","kind":"person","person_id":"cbr-p002601","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m059-0075","start":75,"end":77,"surface":"唐雎","kind":"person","person_id":"cbr-p002607","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m059-0081","start":81,"end":83,"surface":"秦王","kind":"person","person_id":"cbr-p002579","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m059-0084","start":84,"end":86,"surface":"秦王","kind":"person","person_id":"cbr-p002579","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m059-0120","start":120,"end":122,"surface":"唐雎","kind":"person","person_id":"cbr-p002607","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m059-0127","start":127,"end":128,"surface":"王","kind":"person","person_id":"cbr-p002579","status":"contextual_provisi