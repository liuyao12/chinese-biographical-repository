{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"x1q_sjd_3jl","canonical_person_id":"x1q_sjd_3jl","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["x1q_sjd_3jl"],"persons":[{"id":"x1q_sjd_3jl","label":"楊舉","status":"active","historicity":"historical_tradition","aliases":[{"surface":"楊舉","mention_ids":["c-jinshu-066-taokan:p007:m0014"]}],"evidence":[{"mention_id":"c-jinshu-066-taokan:p007:m0014","paragraph_id":"c-jinshu-066-taokan:p007","chapter_id":"c-jinshu-066-taokan","quote":"楊舉"}],"review":"ai_provisional","identity_note":"楊舉，見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-jinshu-066-taokan-ws1527632","work_id":"w-jinshu","book_id":"b-jinshu-066","chapter_id":"c-jinshu-066-taokan","raw_mention_count":1,"mention_ids":["c-jinshu-066-taokan:p007:m0014"],"paragraph_ids":["c-jinshu-066-taokan:p007"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-066-taokan:p007:m0014","mention_ids":["c-jinshu-066-taokan:p007:m0014"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-066-taokan-ws1527632"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-066-taokan:p007:m0014","surface":"楊舉","start":14,"end":16,"person_id":"x1q_sjd_3jl","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-066-taokan:p007","chapter_id":"c-jinshu-066-taokan"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-066-taokan:p007","text":"侃復率周訪等進軍人湘，使都尉楊舉為先驅，擊杜弢，大破之，屯兵於城西。侃之佐史辭詣王敦曰：「州將陶使君孤根特立，從微至著，忠允之功，所在有效。出佐南夏，輔翼劉征南，前遇張昌，後屬陳敏，侃以偏旅，獨當大寇，無征不剋，群醜破滅。近者王如亂北，杜弢跨南，二征奔走，一州星馳，其餘郡縣，所在土崩。侃招攜以禮，懷遠以德，子來之眾，前後累至。奉承指授，獨守危厄，人往不動，人離不散。往年董督，徑造湘城，志陵雲霄，神機獨斷。徒以軍少糧懸，不果獻捷。然杜弢懾懼，來還夏口，未經信宿，建平流人迎賊俱叛。侃即回軍溯流，芟夷丑類，至使西門不鍵，華圻無虞者，侃之功也。明將軍湣此荊楚，救命塗炭，使侃統領窮殘之餘，寒者衣之，饑者食之，比屋相慶，有若挾纊。江濱孤危，地非重險，非可單軍獨能保固，故移就高莋，以避其沖。賊輕易先至，大眾在後，侃距戰經日，殺其名帥。賊尋犬羊相結，並力來攻，侃以忠臣之節，義無退顧，被堅執銳，身當戎行，將士奮擊，莫不用命。當時死者不可勝數。賊眾參伍，更息更戰。侃以孤軍一隊，力不獨禦，量宜取全，以俟後舉。而主者責侃，重加黜削。侃性謙沖，功成身退，今奉還所受，唯恐稽遲。然某等區區，實恐理失於內，事敗於外，豪厘之差，將致千里，使荊蠻乖離，西嵎不守，脣亡齒寒，侵逼無限也。」敦於是奏復侃官。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":41,"last_line":41,"raw_start":4529,"raw_end":5072,"raw_character_offsets":[4531,4532,4533,4534,4535,4536,4537,4538,4539,4540,4541,4542,4543,4544,4545,4546,4547,4548,4549,4550,4551,4552,4553,4554,4555,4556,4557,4558,4559,4560,4561,4562,4563,4564,4565,4566,4567,4568,4569,4570,4571,4572,4573,4574,4575,4576,4577,4578,4579,4580,4581,4582,4583,4584,4585,4586,4587,4588,4589,4590,4591,4592,4593,4594,4595,4596,4597,4598,4599,4600,4601,4602,4603,4604,4605,4606,4607,4608,4609,4610,4611,4612,4613,4614,4615,4616,4617,4618,4619,4620,4621,4622,4623,4624,4625,4626,4627,4628,4629,4630,4631,4632,4633,4634,4635,4636,4637,4638,4639,4640,4641,4642,4643,4644,4645,4646,4647,4648,4649,4650,4651,4652,4653,4654,4655,4656,4657,4658,4659,4660,4661,4662,4663,4664,4665,4666,4667,4668,4669,4670,4671,4672,4673,4674,4675,4676,4677,4678,4679,4680,4681,4682,4683,4684,