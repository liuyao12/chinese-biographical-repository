{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003324","identity_policy":"contextual_provisional","person_ids":["cbr-p003324"],"persons":[{"id":"cbr-p003324","label":"項他（曹相國世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"項他","mention_ids":["c-shiji-054-cao:m004-0192"]}],"evidence":[{"mention_id":"c-shiji-054-cao:m004-0192","chapter_id":"c-shiji-054-cao","paragraph_id":"c-shiji-054-cao:p004","quote":"項他"}]}],"source_mention_summary":[{"source_id":"s-shiji-054-cao","work_id":"w-shiji","book_id":"b-shiji-054","chapter_id":"c-shiji-054-cao","mention_count":1,"mention_ids":["c-shiji-054-cao:m004-0192"],"paragraph_ids":["c-shiji-054-cao:p004"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-054-cao"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-054-cao:m004-0192","start":192,"end":194,"surface":"項他","kind":"person","person_id":"cbr-p003324","status":"contextual_provisional","paragraph_id":"c-shiji-054-cao:p004","chapter_id":"c-shiji-054-cao"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji054-018","person_id":"cbr-p003324","surfaces":["項他"],"scope":"same_chapter","chapter_ids":["c-shiji-054-cao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-054-cao:p004","quote":"項羽至，以沛公為漢王。漢王封參為建成侯。從至漢中，遷為將軍。從還定三秦，初攻下辯、故道、雍、斄。擊章平軍於好畤南，破之，圍好畤，取壤鄉。擊三秦軍壤東及高櫟，破之。復圍章平，章平出好畤走。因擊趙賁、內史保軍，破之。東取咸陽，更名曰新城。參將兵守景陵二十日，三秦使章平等攻參，參出擊，大破之。賜食邑於寧秦。參以將軍引兵圍章邯於廢丘。以中尉從漢王出臨晉關。至河內，下修武，渡圍津，東擊龍且、項他定陶，破之。東取碭、蕭、彭城。擊項籍軍，漢軍大敗走。參以中尉圍取雍丘。王武反於外黃，程處反於燕，往擊，盡破之。柱天侯反於衍氏，又進破取衍氏。擊羽嬰於昆陽，追至葉。還攻武彊，因至滎陽。參自漢中為將軍中尉，從擊諸侯，及項羽敗，還至滎陽，凡二歲。"}],"rationale":"依本篇明示姓名與局部軍事、任官及子嗣敘事暫接；曹氏時、襄不按單字全域配對。未名者不補姓名，秦司馬夷字待底本核定，田既與田溉不擅同指。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-054-cao:p004","text":"項羽至，以沛公為漢王。漢王封參為建成侯。從至漢中，遷為將軍。從還定三秦，初攻下辯、故道、雍、斄。擊章平軍於好畤南，破之，圍好畤，取壤鄉。擊三秦軍壤東及高櫟，破之。復圍章平，章平出好畤走。因擊趙賁、內史保軍，破之。東取咸陽，更名曰新城。參將兵守景陵二十日，三秦使章平等攻參，參出擊，大破之。賜食邑於寧秦。參以將軍引兵圍章邯於廢丘。以中尉從漢王出臨晉關。至河內，下修武，渡圍津，東擊龍且、項他定陶，破之。東取碭、蕭、彭城。擊項籍軍，漢軍大敗走。參以中尉圍取雍丘。王武反於外黃，程處反於燕，往擊，盡破之。柱天侯反於衍氏，又進破取衍氏。擊羽嬰於昆陽，追至葉。還攻武彊，因至滎陽。參自漢中為將軍中尉，從擊諸侯，及項羽敗，還至滎陽，凡二歲。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-054-cao:m004-0000","start":0,"end":2,"surface":"項羽","kind":"person","person_id":"cbr-p003315","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m004-0005","start":5,"end":7,"surface":"沛公","kind":"person","person_id":"cbr-p003309","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m004-0008","start":8,"end":10,"surface":"漢王","kind":"person","person_id":"cbr-p003309","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m004-0011","start":11,"end":13,"surface":"漢王","kind":"person","person_id":"cbr-p003309","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m004-0014","start":14,"end":15,"surface":"參","kind":"person","person_id":"cbr-p003307","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m004-0049","start":49,"end":51,"surface":"章平","kind":"person","person_id":"cbr-p003321","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m004-0083","start":83,"end":85,"surface":"章平","kind":"person","person_id":"cbr-p003321","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m004-0086","start":86,"end":88,"surface":"章平","kind":"person","person_id":"cbr-p003321","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m004-0095","start":95,"end":97,"surface":"趙賁","kind":"person","person_id":"cbr-p003318","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m004-0098","start":98,"end":101,"surface":"內史保","kind":"person","person_id":"cbr-p003322","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m004-0117","start":117,"end":118,"surface":"參","kind":"