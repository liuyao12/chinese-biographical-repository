entioned_source_ids":["s-jinshu-056-jiang-bin-ws1557685","s-nanshi-024-ruanwanling-ws1765279","s-songshu-053-yu-dengzhi","s-songshu-093-ruanwanling-ws1962755","s-songshu-093-ruanwanling-wyd1739"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin056-volume-jiang-yi-brother","subject_person_id":"f8f_8b2_11c","object_person_id":"l0j_aek_5es","predicate":"brother","qualifiers":{"source_term":"恆弟夷"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-056","chapter_id":"c-jinshu-056-jiang-bin","source_id":"s-jinshu-056-jiang-bin-ws1557685","paragraph_id":"c-jinshu-056-jiang-bin:p001","quote":"虨字思玄，本州辟舉秀才，平南將軍溫嶠以為參軍。復為州別駕，辟司空郗鑒掾，除長山令。鑒又請為司馬，轉黃門郎。車騎將軍庾冰鎮江州，請為長史。冰薨，庾翼以為諮議參軍，俄而復補長史。翼薨，大將幹瓚作難，虨討平之。除尚書吏部郎，仍遷御史中丞、侍中、吏部尚書。永和中，代桓景為護軍將軍。出補會稽內史，加右軍將軍。代王彪之為尚書僕射。哀帝即位，疑周貴人名號所宜，虨議見《禮志》。帝欲於殿庭立鴻祀，又欲躬自藉田，虨並以為禮廢日久，儀注不存，中興以來所不行，謂宜停之。為僕射積年，簡文帝為相，每訪政事，虨多所補益，轉護軍將軍，領國子祭酒，卒官。子敳，曆琅邪內史、驃騎諮議。敳子恆，元熙中為西中郎長史。恆弟夷，尚書。","subject_person_mention_id":"c-jinshu-056-jiang-bin:p001:m0293","object_person_mention_id":"c-jinshu-056-jiang-bin:p001:m0279"}],"status":"source_attested","interpretation_note":"同段明具恆弟夷。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"person_id":"f8f_8b2_11c","title":null,"surname":"江","ming":"夷","additional_names":[],"work_id":"w-songshu","book_id":"b-songshu-053","chapter_id":"c-songshu-053-yu-dengzhi","source_id":"s-songshu-053-yu-dengzhi","paragraph_id":"c-songshu-053-yu-dengzhi:line045","quote":"登之少以強濟自立。初為晉會稽王道子太傅參軍。義旗初，又為高祖鎮軍參軍。以預討桓玄功，封曲江縣五等男。參大司馬琅邪王軍事，豫州別駕從事史，大司馬主簿，司徒左西曹屬。登之雖不涉學，善於世事，王弘、謝晦、江夷之徒，皆相知友。轉太尉主簿。義熙十二年，高祖北伐，登之擊節驅馳，退告劉穆之，以母老求郡。于時士庶咸憚遠役，而登之二三其心，高祖大怒，除吏名。大軍發後，乃以補鎮蠻護軍、西陽太守。入為太子庶子，尚書左丞。出為新安太守。","note":"原文具名用稱分錄姓、名；不把官名、王號或字當本名，不改寫原字。","status":"editorial_provisional","human_reviewed":false,"model":null}],"mentions":[{"id":"c-jinshu-056-jiang-bin:p001:m0293","surface":"夷","start":293,"end":294,"person_id":"f8f_8b2_11c","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-056-jiang-bin:p001","chapter_id":"c-jinshu-056-jiang-bin"},{"id":"c-nanshi-024-ruanwanling:p001:m0046","surface":"江夷","start":46,"end":48,"person_id":"f8f_8b2_11c","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-nanshi-024-ruanwanling:p001","chapter_id":"c-nanshi-024-ruanwanling"},{"id":"c-songshu-053-yu-dengzhi:line045:m0099","start":99,"end":101,"surface":"江夷","kind":"person","person_id":"f8f_8b2_11c","status":"contextual_provisional","paragraph_id":"c-songshu-053-yu-dengzhi:line045","chapter_id":"c-songshu-053-yu-dengzhi"},{"id":"c-songshu-093-ruanwanling-wyd:p001:m0042","person_id":"f8f_8b2_11c","surface":"江夷","start":42,"end":44,"kind":"person","status":"contextual_provisional","interpretation_note":"根據該處敘事、說話或受書角色。","paragraph_id":"c-songshu-093-ruanwanling-wyd:p001","chapter_id":"c-songshu-093-ruanwanling-wyd"},{"id":"c-songshu-093-ruanwanling:p002:m0022","surface":"江夷","start":22,"end":24,"person_id":"f8f_8b2_11c","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-songshu-093-ruanwanling:p002","chapter_id":"c-songshu-093-ruanwanling"}],"relations":[{"id":"a-jin056-volume-jiang-yi-brother","subject_person_id":"f8f_8b2_11c","object_person_id":"l0j_aek_5es","predicate":"brother","qualifiers":{"source_term":"恆弟夷"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-056","chapter_id":"c-jinshu-056-jiang-bin","source_id":"s-jinshu-056-jiang-bin-ws1557685","paragraph_id":"c-jinshu-056-jiang-bin:p001","quote":"虨字思玄，本州辟舉秀才，平南將軍溫嶠以為參軍。復為州別駕，辟司空郗鑒掾，除長山令。鑒又請為司馬，轉黃門郎。車騎將軍庾冰鎮江州，請為長史。冰薨，庾翼以為諮議參軍，俄而復補長史。翼薨，大將幹瓚作難，虨討平之。除尚書吏部郎，仍遷御史中丞、侍中、吏部尚書。永和中，代桓景為護軍將軍。出補會稽內史，加右軍將軍。代王彪之為尚書僕射。哀帝即位，疑周貴人名號所宜，虨議見《禮志》。帝欲於殿庭立鴻祀，又欲躬自藉田，虨並以為禮廢日久，儀注不存，中興以來所不行，謂宜停之。為僕射積年，簡文帝為相，每訪政事，虨多所補益，轉護軍將軍，領國子祭酒，卒官。子敳，曆琅邪內史、驃騎諮議。敳子恆，元熙中為西中郎長史。恆弟夷，尚書。","subject_person_mention_id":"c-jinshu-056-jiang-bin:p001:m0293","object_person_mention_id":"c-jinshu-056-jiang-bin:p001:m0279"}],"status":"source_attested","interpretation_note":"同段明具恆弟夷。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"title_holdings":[{"id":"th-nanshi024-ruanwanling-s1-52-jiang","person_id":"f8f_8b2_11c","title":"司馬","kind":"office","mode":"attestation","attestations":[{"id":"th-nanshi024-ruanwanling-s1-52-jiang:a","person_mention_id":"c-nanshi-024-ruanwanling:p001:m0046","usage":"narrative","date_expression":null,"paragraph_id":"c-nanshi-024-ruanwanling:p001","surface":"司馬","start":52,"end":54}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-024","source_id":"s-nanshi-024-ruanwanling-ws1765279","chapter_id":"c-nanshi-024-ruanwanling","paragraph_id":"c-nanshi-024-ruanwanling:p001","quote":"阮萬齡，陳留尉氏人。祖思曠，左光祿大夫。父甯，黃門侍郎。萬齡少知名，爲孟昶建威長史。時袁豹、江夷相系爲昶司馬，時人謂昶府有三素望。萬齡家在會稽剡縣，頗有素情，位左戸尚書，太常。出爲湘州刺史，無政績。後爲散騎常侍、金紫光祿大夫，卒。","person_mention_id":"c-nanshi-024-ruanwanling:p001:m0046"}],"status":"source_attested","interpretation_note":"按本見證原職名及其所屬人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"th-nanshi024-ruanwanling-m2-28-jiang","person_id":"f8f_8b2_11c","title":"司馬","kind":"office","mode":"attestation","attestations":[{"id":"th-nanshi024-ruanwanling-m2-28-jiang:a","person_mention_id":"c-songshu-093-ruanwanling:p002:m0022","usage":"narrative","date_expression":null,"paragraph_id":"c-songshu-093-ruanwanling:p002","surface":"司馬","start":28,"end":30}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-093","source_id":"s-songshu-093-ruanwanling-ws1962755","chapter_id":"c-songshu-093-ruanwanling","paragraph_id":"c-songshu-093-ruanwanling:p002","quote":"萬齡少知名，自通直郎爲孟昶建威長史。時袁豹、江夷相係爲昶司馬，時人謂昶府有三素望。萬齡家在會稽剡縣，頗有素情，永初末，自侍中解職東歸，徴爲祕書監，加給事中，不就。尋除左民尚書，復起應命，遷太常，出爲湘州刺史，在州無政績。還爲東陽太守，又被免。復爲散騎常侍、金紫光祿大夫。元嘉二十五年卒，時年七十二。","person_mention_id":"c-songshu-093-ruanwanling:p002:m0022"}],"status":"source_attested","interpretation_note":"按本見證原職名及其所屬人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"th-song093-wyd-r1-48-jiang","person_id":"f8f_8b2_11c","title":"司馬","kind":"office","mode":"attestation","attestations":[{"id":"th-song093-wyd-r1-48-jiang:a","person_mention_id":"c-songshu-093-ruanwanling-wyd:p001:m0042","usage":"narrative","date_expression":null,"paragraph_id":"c-songshu-093-ruanwanling-wyd:p001","surface":"司馬","start":48,"end":50}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-093","source_id":"s-songshu-093-ruanwanling-wyd1739","chapter_id":"c-songshu-093-ruanwanling-wyd","paragraph_id":"c-songshu-093-ruanwanling-wyd:p001","quote":"阮萬齡陳留尉氏人也祖思曠左光祿大夫父寧黃門侍郎萬齡少知名自通直郎為孟昶建威長史時袁豹江夷相係為昶司馬時人謂昶府有三素望萬齡家在會稽剡縣頗有素情永初末自侍中解職東歸徵為秘書監加給事中不就尋除左民尚書復起應命遷太常出為湘州刺史在州無政績還為東陽太守又被免復為散騎常侍金紫光祿大夫元嘉二十五年卒時年七十二","person_mention_id":"c-songshu-093-ruanwanling-wyd:p001:m0042"}],"status":"source_attested","interpretation_note":"按本見證原職名及其所屬人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_d