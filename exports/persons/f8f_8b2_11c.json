2,3893,3894,3895,3896,3897,3898,3899,3900,3901,3902,3903,3904,3905,3906,3907,3908,3909,3910,3911,3912,3913,3914,3915,3916,3917,3918,3919,3920,3921,3922,3923,3924,3925,3926,3927,3928,3929,3930,3931,3932,3933,3934,3935,3936,3937,3938,3939,3940,3941,3942,3943,3944,3945,3946,3947,3948,3949,3950,3951,3952,3953,3954,3955,3956,3957,3958,3959,3960,3961,3962,3963],"projection_sha256":"28acdae9732dad8814a13a49b00a235a834b2e9ade5d4ea3c06982d3bdc7db3a","editorial_excerpt_boundary":true},"chapter_id":"c-nanshi-024-ruanwanling","book_id":"b-nanshi-024","work_id":"w-nanshi","source_id":"s-nanshi-024-ruanwanling-ws1765279"},{"id":"c-songshu-053-yu-dengzhi:line045","text":"登之少以強濟自立。初為晉會稽王道子太傅參軍。義旗初，又為高祖鎮軍參軍。以預討桓玄功，封曲江縣五等男。參大司馬琅邪王軍事，豫州別駕從事史，大司馬主簿，司徒左西曹屬。登之雖不涉學，善於世事，王弘、謝晦、江夷之徒，皆相知友。轉太尉主簿。義熙十二年，高祖北伐，登之擊節驅馳，退告劉穆之，以母老求郡。于時士庶咸憚遠役，而登之二三其心，高祖大怒，除吏名。大軍發後，乃以補鎮蠻護軍、西陽太守。入為太子庶子，尚書左丞。出為新安太守。","annotation_status":"in_progress","mentions":[{"id":"c-songshu-053-yu-dengzhi:line045:m0000","start":0,"end":2,"surface":"登之","kind":"person","person_id":"4qr_wrk_3vd_DDBA","status":"contextual_provisional"},{"id":"c-songshu-053-yu-dengzhi:line045:m0012","start":12,"end":17,"surface":"會稽王道子","kind":"person","person_id":"dkn_ge4_286_AAAAAAAFA","status":"contextual_provisional"},{"id":"c-songshu-053-yu-dengzhi:line045:m0028","start":28,"end":30,"surface":"高祖","kind":"person","person_id":"3qs_nqa_ioa_AAA","status":"contextual_provisional"},{"id":"c-songshu-053-yu-dengzhi:line045:m0038","start":38,"end":40,"surface":"桓玄","kind":"person","person_id":"u9s_w6j_8mc_AAF","status":"contextual_provisional"},{"id":"c-songshu-053-yu-dengzhi:line045:m0054","start":54,"end":57,"surface":"琅邪王","kind":"unresolved","person_id":null,"status":"unresolved","note":"本段晉末桓玄、義熙北伐脈絡中的大司馬琅邪王主要候選為德文；與元帝、康帝及道子等同號者有年代反證，未核同任職句前暫不具體掛號。","candidate_person_ids":["ije_ngm_cmj"],"candidate_labels":["晉恭帝德文"]},{"id":"c-songshu-053-yu-dengzhi:line045:m0081","start":81,"end":83,"surface":"登之","kind":"person","person_id":"4qr_wrk_3vd_DDBA","status":"contextual_provisional"},{"id":"c-songshu-053-yu-dengzhi:line045:m0093","start":93,"end":95,"surface":"王弘","kind":"person","person_id":"7r6_k52_qji_ABAAAAA","status":"contextual_provisional"},{"id":"c-songshu-053-yu-dengzhi:line045:m0096","start":96,"end":98,"surface":"謝晦","kind":"person","person_id":"aa6_83c_juy_AAAA","status":"contextual_provisional"},{"id":"c-songshu-053-yu-dengzhi:line045:m0099","start":99,"end":101,"surface":"江夷","kind":"person","person_id":"f8f_8b2_11c","status":"contextual_provisional"},{"id":"c-songshu-053-yu-dengzhi:line045:m0121","start":121,"end":123,"surface":"高祖","kind":"person","person_id":"3qs_nqa_ioa_AAA","status":"contextual_provisional"},{"id":"c-songshu-053-yu-dengzhi:line045:m0126","start":126,"end":128,"surface":"登之","kind":"person","person_id":"4qr_wrk_3vd_DDBA","status":"contextual_provisional"},{"id":"c-songshu-053-yu-dengzhi:line045:m0135","start":135,"end":138,"surface":"劉穆之","kind":"person","person_id":"255_233_b52","status":"contextual_provisional"},{"id":"c-songshu-053-yu-dengzhi:line045:m0140","start":140,"end":141,"surface":"母","kind":"unresolved","person_id":null,"status":"unresolved","note":"明載母老，未明名；不由父廓補生母或配偶。","candidate_person_ids":[],"candidate_labels":["庾登之未名母親"]},{"id":"c-songshu-053-yu-dengzhi:line045:m0155","start":155,"end":157,"surface":"登之","kind":"person","person_id":"4qr_wrk_3vd_DDBA","status":"contextual_provisional"},{"id":"c-songshu-053-yu-dengzhi:line045:m0162","start":162,"end":164,"surface":"高祖","kind":"person","person_id":"3qs_nqa_ioa_AAA","status":"contextual_provisional"},{"id":"c-songshu-053-yu-dengzhi:line045:m0191","start":191,"end":193,"surface":"太子","kind":"unresolved","person_id":null,"status":"unresolved","note":"職稱內太子為實際府主候選但缺明確入任年；不單按敘事順序認作劉義符。","candidate_person_ids":[],"candidate_labels":["晉末或宋初太子，待核入任時段"]}],"source_position":{"first_line":45,"last_line":45,"revision_id":1996685,"editorial_excerpt_boundary":false},"text_layer":"received_chapter","chapter_id":"c-songshu-053-yu-dengzhi","book_id":"b-songshu-053","work_id":"w-songshu","source_id":"s-songshu-053-yu-dengzhi"},{"id":"c-songshu-093-ruanwanling-wyd:p001","text":"阮萬齡陳留尉氏人也祖思曠左光祿大夫父寧黃門侍郎萬齡少知名自通直郎為孟昶建威長史時袁豹江夷相係為昶司馬時人謂昶府有三素望萬齡家在會稽剡縣頗有素情永初末自侍中解職東歸徵為秘書監加給事中不就尋除左民尚書復起應命遷太常出為湘州刺史在州無政績還為東陽太守又被免復為散騎常侍金紫光祿大夫元嘉二十五年卒時年七十二","mentions":[{"id":"c-songshu-093-ruanwanling-wyd:p001:m0000","person_id":"wv8_l6v_kp9","surface":"阮萬齡","start":0,"end":3,"kind":"person","status":"contextual_provisional","interpretation_note":"根據該處敘事、說話或受書角色。"},{"id":"c-songshu-093-ruanwanling-wyd:p001:m0010","person_id":"03n_n2r_8rt","surface":"思曠","start":10,"end":12,"kind":"person","status":"contextual_provisional","interpretation_note":"根據該處敘事、說話或受書角色。"},{"id":"c-songshu-093-ruanwanling-wyd:p001:m0018","person_id":"03n_n2r_8rt_B","surface":"寧","start":18,"end":19,"kind":"person","status":"contextual_provisional","interpretation_note":"根據該處敘事、說話或受書角色。"},{"id":"c-songshu-093-ruanwanling-wyd:p001:m0023","person_id":"wv8_l6v_kp9","surface":"萬齡","start":23,"end":25,"kind":"person","status":"contextual_provisional","interpretation_note":"根據該處敘事、說話或受書角色。"},{"id":"c-songshu-093-ruanwanling-wyd:p001:m0033","person_id":"70y_je5_bm0","surface":"孟昶","start":33,"end":35,"kind":"person","status":"contextual_provisional","interpretation_note":"根據該處敘事、說話或受書角色。"},{"id":"c-songshu-093-ruanwanling-wyd:p001:m0040","person_id":"xxh_xtr_3f9","surface":"袁豹","start":40,"end":42,"kind":"person","status":"contextual_provisional","interpretation_note":"根據該處敘事、說話或受書角色。"},{"id":"c-songshu-093-ruanwanling-wyd:p001:m0042","person_id":"f8f_8b2_11c","surface":"江夷","start":42,"end":44,"kind":"person","status":"contextual_provisional","interpretation_note":"根據該處敘事、說話或受書角色。"},{"id":"c-songshu-093-ruanwanling-wyd:p001:m0047","person_id":"70y_je5_bm0","surface":"昶","start":47,"end":48,"kind":"person","status":"contextual_provisional","interpretation_note":"根據該處敘事、說話或受書角色。"},{"id":"c-songshu-093-ruanwanling-wyd:p001:m0053","person_id":"70y_je5_bm0","surface":"昶","start":53,"end":54,"kind":"person","status":"contextual_provisional","interpretation_note":"根據該處敘事、說話或受書角色。"},{"id":"c-songshu-093-ruanwanling-wyd:p001:m0059","person_id":"wv8_l6v_kp9","surface":"萬齡","start":59,"end":61,"kind":"person","status":"contextual_provisional","interpretation_note":"根據該處敘事、說話或受書角色。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":"cbr-ai-transcription-sha256:b7170dce6be9a5980d5373556ef7d70d8234d1f7af16af3aa30bf21f6e707b20","source_layer":"received_biography","column_projection":[{"pdf_page":11,"half":"右","column_from_right":7,"start":0,"end":21,"text":"阮萬齡陳留尉氏人也祖思曠左光祿大夫父寧黃門"},{"pdf_page":11,"half":"右","column_from_right":8,"start":0,"end":21,"text":"侍郎萬齡少知名自通直郎為孟昶建威長史時袁豹"},{"pdf_page":11,"half":"右","column_from_right":9,"start":0,"end":21,"text":"江夷相係為昶司馬時人謂昶府有三素望萬齡家在"},{"pdf_page":11,"half":"右","column_from_right":10,"start":0,"end":21,"text":"會稽剡縣頗有素情永初末自侍中解職東歸徵為秘"},{"pdf_page":11,"half":"左","column_from_right":1,"start":0,"end":21,"text":"書監加給事中不就尋除左民尚書復起應命遷太常"},{"pdf_page":11,"half":"左","column_from_right":2,"start":0,"end":21,"text":"出為湘州刺史在州無政績還為東陽太守又被免復"},{"pdf_page":11,"half":"左","column_from_right":3,"start":0,"end":21,"text":"為散騎常侍金紫光祿大夫元嘉二十五年卒時年七"},{"pdf_page":11,"half":"左","column_from_right":4,"start":0,"end":2,"text":"十二"}]},"chapter_id":"c-songshu-093-ruanwanling-wyd","book_id":"b-songshu-093","work_id":"w-songshu","source_id":"s-songshu-093-ruanwanling-wyd1739"},{"id":"c-songshu-093-ruanwanling:p002","text":"萬齡少知名，自通直郎爲孟昶建威長史。時袁豹、江夷相係爲昶司馬，時人謂昶府有三素望。萬齡家在會稽剡縣，頗有素情，永初末，自侍中解職東歸，徴爲祕書監，加給事中，不就。尋除左民尚書，復起應命，遷太常，出爲湘州刺史，在州無政績。還爲東陽太守，又被免。復爲散騎常侍、金紫光祿大夫。元嘉二十五年卒，時年七十二。","mentions":[{"id":"c-songshu-093-ruanwanling:p002:m0000","surface":"萬齡","start":0,"end":2,"person_id":"wv8_l6v_kp9","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-songshu-093-ruanwanling:p002:m0011","surface":"孟昶","start":11,"end":13,"person_id":"70y_je5_bm0","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-songshu-093-ruanwanling:p002:m0019","surface":"袁豹","start":19,"end":21,"person_id":"xxh_xtr_3f9","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-songshu-093-ruanwanling:p002:m0022","surface":"江夷","start":22,"end":24,"person_id":"f8f_8b2_11c","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-songshu-093-ruanwanling:p002:m0027","surface":"昶","start":27,"end":28,"person_id":"70y_je5_bm0","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-songshu-093-ruanwanling:p002:m0034","surface":"昶","start":34,"end":35,"person_id":"70y_je5_bm0","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-songshu-093-ruanwanling:p002:m0041","surface":"萬齡","start":41,"end":43,"person_id":"wv8_l6v_kp9","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":1962755,"source_layer":"received_biography","first_line":74,"last_line":74,"line_start":0,"line_end":165,"raw_start":5368,"raw_end":5533,"raw_character_offsets":[5368,5369,5370,5371,5372,5373,5374,5375,5376,5377,5378,5379,5380,5381,5382,5383,5384,5385,5386,5387,5388,5389,5390,5391,5392,5395,5398,5399,5400,5401,5402,5403,5404,5405,5406,5407,5408,5409,5410,5411,5412,5413,5414,5415,5416,5417,5418,5419,5420,5421,5422,5423,5424,5425,5426,5427,5428,5429,5430,5431,5432,5433,5434,5435,5436,5437,5438,5441,5444,5445,5446,5447,5448,5449,5450,5451,5452,5453,5454,5455,5456,5457,5458,5459,5460,5461,5462,5463,5466,5469,5470,5471,5472,5473,5474,5475,5476,5477,5478,5479,5480,5481,5482,5483,5484,5485,5486,5487,5488,5489,5490,5491,5492,5493,5494,5495,5496,5497,5498,5499,5500,5503,5506,5507,5508,5509,5510,5511,5512,5513,5514,5515,5516,5517,5518,5519,5520,5521,5522,5523,5524,5525,5526,55