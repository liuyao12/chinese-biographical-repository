-shiji-055-liu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji055-053","person_id":"bk0_cz6_i48","surfaces":["赤松","赤松子"],"scope":"same_chapter","chapter_ids":["c-shiji-055-liu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-055-liu:p026","quote":"留侯從上擊代，出奇計馬邑下，及立蕭何相國，所與上從容言天下事甚衆，非天下所以存亡，故不著。留侯乃稱曰：「家世相韓，及韓滅，不愛萬金之資，為韓報讐彊秦，天下振動。今以三寸舌為帝者師，封萬戶，位列侯，此布衣之極，於良足矣。願棄人間事，欲從赤松子游耳。」乃學辟穀，道引輕身。會高帝崩，呂后德留侯，乃彊食之，曰：「人生一世間，如白駒過隙，何至自苦如此乎！」留侯不得已，彊聽而食。"},{"paragraph_id":"c-shiji-055-liu:p031","quote":"【索隱述贊】留侯倜儻，志懷憤惋。五代相韓，一朝歸漢。進履宜假，運籌神算。橫陽既立，申徒作扞。灞上扶危，固陵靜亂。人稱三傑，辯推八難。赤松願游，白駒難絆。嗟彼雄略，曾非魁岸。"}],"rationale":"依明示名字、局部任事、授封及引語暫接；良久、每上冢與愛子之上排除人物短稱。老父場景的父不接張良父平；韓悼惠王不接齊王，秦王子嬰不接博浪沙秦皇帝，未名者不補姓名。神異與古代比擬不表示人物當時在場或神蹟已證。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-055-liu:p026","text":"留侯從上擊代，出奇計馬邑下，及立蕭何相國，所與上從容言天下事甚衆，非天下所以存亡，故不著。留侯乃稱曰：「家世相韓，及韓滅，不愛萬金之資，為韓報讐彊秦，天下振動。今以三寸舌為帝者師，封萬戶，位列侯，此布衣之極，於良足矣。願棄人間事，欲從赤松子游耳。」乃學辟穀，道引輕身。會高帝崩，呂后德留侯，乃彊食之，曰：「人生一世間，如白駒過隙，何至自苦如此乎！」留侯不得已，彊聽而食。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-055-liu:m026-0000","start":0,"end":2,"surface":"留侯","kind":"person","person_id":"31t_28w_hda_A","status":"contextual_provisional"},{"id":"c-shiji-055-liu:m026-0003","start":3,"end":4,"surface":"上","kind":"person","person_id":"aae_mkd_tas","status":"contextual_provisional"},{"id":"c-shiji-055-liu:m026-0016","start":16,"end":18,"surface":"蕭何","kind":"person","person_id":"ikp_b3b_9i7","status":"contextual_provisional"},{"id":"c-shiji-055-liu:m026-0023","start":23,"end":24,"surface":"上","kind":"person","person_id":"aae_mkd_tas","status":"contextual_provisional"},{"id":"c-shiji-055-liu:m026-0045","start":45,"end":47,"surface":"留侯","kind":"person","person_id":"31t_28w_hda_A","status":"contextual_provisional"},{"id":"c-shiji-055-liu:m026-01