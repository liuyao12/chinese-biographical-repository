4441d4e0138d8378ecf36fa4","editorial_excerpt_boundary":true},"chapter_id":"c-liangshu-029-huili-xiangzhou-context","book_id":"b-liangshu-029","work_id":"w-liangshu","source_id":"s-liangshu-029-huili-xiangzhou-context-ws1538079"},{"id":"c-liangshu-029-huili-xiangzhou-context:p002","text":"子會理嗣，字長才。少聰慧，好文史。年十一而孤，特爲高祖所愛，衣服禮秩與正王不殊。年十五，拜輕車將軍、湘州刺史，又領石頭戍軍事。","mentions":[{"id":"c-liangshu-029-huili-xiangzhou-context:p002:m0001","surface":"會理","start":1,"end":3,"person_id":"fo7_f8v_rmf_CA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-liangshu-029-huili-xiangzhou-context:p002:m0006","surface":"長才","start":6,"end":8,"person_id":"fo7_f8v_rmf_CA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":1538079,"source_layer":"received_biography","first_line":17,"last_line":17,"line_start":2,"line_end":65,"raw_start":755,"raw_end":818,"raw_character_offsets":[755,756,757,758,759,760,761,762,763,764,765,766,767,768,769,770,771,772,773,774,775,776,777,778,779,780,781,782,783,784,785,786,787,788,789,790,791,792,793,794,795,796,797,798,799,800,801,802,803,804,805,806,807,808,809,810,811,812,813,814,815,816,817],"projection_sha256":"32dd2eb0a9a2859a9cb272794a0d13399454347416fee311a7ac42128c6b07f8","editorial_excerpt_boundary":true},"chapter_id":"c-liangshu-029-huili-xiangzhou-context","book_id":"b-liangshu-029","work_id":"w-liangshu","source_id":"s-liangshu-029-huili-xiangzhou-context-ws1538079"},{"id":"c-liangshu-043-liujingli:p002","text":"敬禮與兄仲禮，皆少以勇烈知名。起家著作佐郎，稍遷扶風太守。侯景渡江，敬禮率馬步三千赴援。至都，據青溪埭，與景頻戰，恒先登陷陳，甚著威名。台城沒，敬禮與仲禮俱見於景，景遣仲禮經略上流，留敬禮爲質，以爲護軍。景餞仲禮於後渚，敬禮密謂仲禮曰：「景今來會，敬禮抱之，兄拔佩刀，便可斫殺，敬禮死亦無所恨。」仲禮壯其言，許之。及酒數行，敬禮目仲禮，仲禮見備衛嚴，不敢動，計遂不果。會景征晉熙，敬禮與南康王會理共謀襲其城，剋期將發，建安侯蕭賁知而告之，遂遇害。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":45,"last_line":45,"raw_start":3468,"raw_end":3691,"raw_char