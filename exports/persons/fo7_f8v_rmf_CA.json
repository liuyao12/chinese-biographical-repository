retation_note":"梁書卷二十九明記高祖第四子。","evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-029","source_id":"s-liangshu-029-xiaoji-wangtai-ws1538079","chapter_id":"c-liangshu-029-xiaoji-wangtai","paragraph_id":"c-liangshu-029-xiaoji-wangtai:p001","quote":"南康簡王績字世謹，高祖第四子。天監八年，封南康郡王，邑二千戶。出爲輕車將軍，領石頭戍軍事。十年，遷使持節、都督南徐州諸軍事、南徐州刺史，進號仁威將軍。","subject_person_mention_id":"c-liangshu-029-xiaoji-wangtai:p001:m0004","object_person_reference_id":"c-liangshu-029-xiaoji-wangtai:p001:r0009"}]}},{"id":"fo7_f8v_rmf_CA","label":"蕭會理（字長才，南康王績子）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"會理","mention_ids":["c-liangshu-029-huili-xiangzhou-context:p002:m0001"]},{"surface":"長才","mention_ids":["c-liangshu-029-huili-xiangzhou-context:p002:m0006"]}],"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-029","source_id":"s-liangshu-029-huili-xiangzhou-context-ws1538079","chapter_id":"c-liangshu-029-huili-xiangzhou-context","paragraph_id":"c-liangshu-029-huili-xiangzhou-context:p002","quote":"會理","mention_id":"c-liangshu-029-huili-xiangzhou-context:p002:m0001"},{"work_id":"w-liangshu","book_id":"b-liangshu-029","source_id":"s-liangshu-029-huili-xiangzhou-context-ws1538079","chapter_id":"c-liangshu-029-huili-xiangzhou-context","paragraph_id":"c-liangshu-029-huili-xiangzhou-context:p002","quote":"長才","mention_id":"c-liangshu-029-huili-xiangzhou-context:p002:m0006"}],"review":"ai_provisional","identity_note":"梁書二十九在南康王績傳末明載子會理嗣，十五拜湘州刺史。與王實所任南康嗣王湘州長史相合。","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"fo7_f8v_rmf_C","source_assertion_id":"a-nan023-wangying-huili-father","evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-029","source_id":"s-liangshu-029-huili-xiangzhou-context-ws1538079","chapter_id":"c-liangshu-029-huili-xiangzhou-context","paragraph_id":"c-liangshu-029-huili-xiangzhou-context:p001","quote":"績寡玩好，少嗜欲，居無僕妾，躬事約儉，所有租秩，悉寄天府。及薨後，府有南康國無名錢數千萬。","object_person_mention_id":"c-liangshu-029-huili-xiangzhou-context:p001:m0000"},{"work_id":"w-liangshu","book_id":"b-liangshu-029","source_id":"s-liangshu-029-huili-xiangzhou-context-ws1538079","chapter_id":"c-liangshu-029-huili-xiangzhou-context","paragraph_id":"c-liangshu-029-huili-xiangzhou-context:p002","quote":"子會理嗣，字長才。少聰慧，好文史。年十一而孤，特爲高祖所愛，衣服禮秩與正王不殊。年十五，拜輕車將軍、湘州刺史，又領石頭戍軍事。","subject_person_mention_id":"c-liangshu-029-huili-xiangzhou-context:p002:m0001"}],"status":"contextual_provisional","interpretation_note":"原段子某承前段傳主。","human_reviewed":false}}],"source_mention_summary":[{"source_id":"s-liangshu-029-huili-xiangzhou-context-ws1538079","work_id":"w-liangshu","book_id":"b-liangshu-029","chapter_id":"c-liangshu-029-huili-xiangzhou-context","raw_mention_count":2,"mention_ids":["c-liangshu-029-huili-xiangzhou-context:p002:m0001","c-liangshu-029-huili-xiangzhou-context:p002:m0006"],"paragraph_ids":["c-liangshu-029-huili-xiangzhou-context:p002"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-liangshu-029-huili-xiangzhou-context:p002:m0001","mention_ids":["c-liangshu-029-huili-xiangzhou-context:p002:m0001"],"kind":"paragraph"},{"canonical_mention_id":"c-liangshu-029-huili-xiangzhou-context:p002:m0006","mention_ids":["c-liangshu-029-huili-xiangzhou-context:p002:m0006"],"kind":"paragraph"}],"mention_count":2,"duplicate_mention_count":0,"paragraph_occurrence_count":2,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"2處獨立位置，2個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-liangshu-029-huili-xiangzhou-context-ws1538079"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],