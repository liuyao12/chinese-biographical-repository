xpression":null,"evidence":[]}},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-029","source_id":"s-liangshu-029-huili-xiangzhou-context-ws1538079","chapter_id":"c-liangshu-029-huili-xiangzhou-context","paragraph_id":"c-liangshu-029-huili-xiangzhou-context:p002","quote":"子會理嗣，字長才。少聰慧，好文史。年十一而孤，特爲高祖所愛，衣服禮秩與正王不殊。年十五，拜輕車將軍、湘州刺史，又領石頭戍軍事。","person_mention_id":"c-liangshu-029-huili-xiangzhou-context:p002:m0001"}],"status":"source_attested","interpretation_note":"按本見證原職名及其所屬人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"th-liangshu-043-liujingli-2-193","title":"南康王","kind":"noble_rank","mode":"attestation","person_id":"fo7_f8v_rmf_CA","attestations":[{"id":"th-liangshu-043-liujingli-2-193:a","paragraph_id":"c-liangshu-043-liujingli:p002","start":193,"end":196,"surface":"南康王","person_mention_id":"c-liangshu-043-liujingli:p002:m0196","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-043","chapter_id":"c-liangshu-043-liujingli","source_id":"s-liangshu-043-liujingli-ws2087360","paragraph_id":"c-liangshu-043-liujingli:p002","quote":"敬禮與兄仲禮，皆少以勇烈知名。起家著作佐郎，稍遷扶風太守。侯景渡江，敬禮率馬步三千赴援。至都，據青溪埭，與景頻戰，恒先登陷陳，甚著威名。台城沒，敬禮與仲禮俱見於景，景遣仲禮經略上流，留敬禮爲質，以爲護軍。景餞仲禮於後渚，敬禮密謂仲禮曰：「景今來會，敬禮抱之，兄拔佩刀，便可斫殺，敬禮死亦無所恨。」仲禮壯其言，許之。及酒數行，敬禮目仲禮，仲禮見備衛嚴，不敢動，計遂不果。會景征晉熙，敬禮與南康王會理共謀襲其城，剋期將發，建安侯蕭賁知而告之，遂遇害。","person_mention_id":"c-liangshu-043-liujingli:p002:m0196"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"person_references":[{"id":"c-nanshi-023-wangying-shi:p006:r0113","surface":"南康嗣王","start":113,"end":117,"person_id":"fo7_f8v_rmf_CA","referent_role":"third_person","paragraph_id":"c-nanshi-023-wangying-shi:p006","quote":"少子實嗣。起家秘書郎，尚梁武帝女安吉公主，襲爵建城縣公，為新安太守。實從兄來郡，就求告。實與銅錢五十萬，不聽於郡及道散用。從兄密于郡市貨，還都求利。及去郡數十里，實乃知，命追之。呼從兄上岸盤頭，令卒與杖，搏頰乞原，劣得免。後為南康嗣王湘州長史、長沙郡。王三日出禊，實衣冠傾崎，王性方嚴，見之意殊惡。實稱主名謂王曰：「蕭玉志念實，殿下何見憎？」王驚赧即起。後密啟之，因此廢錮。","note":"依本段及早書名號。","chapter_id":"c-nanshi-023-wangying-shi","book_id":"b-nanshi-023","work_id":"w-nanshi","source_id":"s-nanshi-023-wangying-shi-ws2478204"},{"id":"c-nanshi-023-wangying-shi:p006:r0126","surface":"王","start":126,"end":127,"person_id":"fo7_f8v_rmf_CA","referent_role":"third_person","paragraph_id":"c-nanshi-023-wangying-shi:p006","quote":"少子實嗣。起家秘書郎，尚梁武帝女安吉公主，襲爵建城縣公，為新安太守。實從兄來郡，就求告。實與銅錢五十萬，不聽於郡及道散用。從兄密于郡市貨，還都求利。及去郡數十里，實乃知，命追之。呼從兄上岸盤頭，令卒與杖，搏頰乞原，劣得免。後為南康嗣王湘州長史、長沙郡。王三日出禊，實衣冠傾崎，王性方嚴，見之意殊惡。實稱主名謂王曰：「蕭玉志念實，殿下何見憎？」王驚赧即起。後密啟之，因此廢錮。","note":"依本段及早書名號。","chapter_id":"c-nanshi-023-wangying-shi","book_id":"b-nanshi-023","work_id":"w-nanshi","source_id":"s-nanshi-023-wangying-shi-ws2478204"},{"id":"c-nanshi-023-wangying-shi:p006:r0138","surface":"王","start":138,"end":139,"person_id":"fo7_f8v_rmf_CA","referent_role":"third_person","paragraph_id":"c-nanshi-023-wangying-shi:p006","quote":"少子實嗣。起家秘書郎，尚梁武帝女安吉公主，襲爵建城縣公，為新安太守。實從兄來郡，就求告。實與銅錢五十萬，不聽於郡及道散用。從兄密于郡市貨，還都求利。及去郡數十里，實乃知，命追之。呼從兄上岸盤頭，令卒與杖，搏頰乞原，劣得免。後為南康嗣王湘州長史、長沙郡。王三日出禊，實衣冠傾崎，王性方嚴，見之意殊惡。實稱主名謂王曰：「蕭玉志念實，殿下何見憎？」王驚赧即起。後密啟之，因此廢錮。","note":"依本段及早書名號。","chapter_id":"c-nanshi-023-wangying-shi","book_id":"b-nanshi-023","work_id":"w-nanshi","source_id":"s-nanshi-023-wangying-shi-ws2478204"},{"id":"c-nanshi-023-wangying-shi:p006:r0154","surface":"王","start":154,"end":155,"person_id":"fo7_f8v_rmf_CA","referent_role":"third_person","paragraph_id":"c-nanshi-023-wangying-shi:p006","quote":"少子實嗣。起家秘書郎，尚梁武帝女安吉公主，襲爵建城縣公，為新安太守。實從兄來郡，就求告。實與銅錢五十萬，不聽於郡及道散用。從兄密于郡市貨，還都求利。及去郡數十里，實乃知，命追之。呼從兄上岸盤頭，令卒與杖，搏頰乞原，劣得免。後為南康嗣王湘州長史、長沙郡。王三日出禊，實衣冠傾崎，王性方嚴，見之意殊惡。實稱主名謂王曰：「蕭玉志念實，殿下何見憎？」王驚赧即起。後密啟之，因此廢錮。","note":"依本段及早書名號。","chapter_id":"c-nanshi-023-wangying-shi","book_id":"b-nanshi-023","work_id":"w-nanshi","source_id":"s-nanshi-023-wangying-shi-ws2478204"},{"id":"c-nanshi-023-wangying-shi:p006:r0164","surface":"殿下","start":164,"end":166,"per