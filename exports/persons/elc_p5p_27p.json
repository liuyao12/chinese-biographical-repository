0,"surface":"喜","kind":"person","person_id":"elc_p5p_27p","status":"contextual_provisional","paragraph_id":"c-songshu-083-xuanmo-wuxi:p001","chapter_id":"c-songshu-083-xuanmo-wuxi"}],"relations":[],"title_holdings":[{"id":"th-songshu-076-wangxuanmo-ws-6-193","title":"主書","kind":"office","mode":"attestation","person_id":"elc_p5p_27p","attestations":[{"id":"th-songshu-076-wangxuanmo-ws-6-193:a","paragraph_id":"c-songshu-076-wangxuanmo-ws:p006","start":193,"end":195,"surface":"主書","person_mention_id":"c-songshu-076-wangxuanmo-ws:p006:m0195","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-076","chapter_id":"c-songshu-076-wangxuanmo-ws","source_id":"s-songshu-076-wangxuanmo-ws-ws1997726","paragraph_id":"c-songshu-076-wangxuanmo-ws:p006","quote":"尋復為豫州刺史。淮上亡命司馬黑石推立夏侯方進為主，改姓李名弘，以惑眾，玄謨討斬之。遷寧蠻校尉、雍州刺史，加都督。雍土多僑寓，玄謨請土斷流民，當時百姓不願屬籍，罷之。其年，玄謨又令九品以上租，使貧富相通，境內莫不嗟怨。民間訛言玄謨欲反，時柳元景當權，元景弟僧景為新城太守，以元景之勢，制令南陽、順陽、上庸、新城諸郡並發兵討玄謨。玄謨令內外晏然，以解眾惑，馳啟孝武，具陳本末。帝知其虛，馳遣主書吳喜公撫慰之，又答曰：「梁山風塵，初不介意，君臣之際，過足相保，聊復為笑，伸卿眉頭。」玄謨性嚴，未嘗妄笑，時人言玄謨眉頭未曾伸，故帝以此戲之。後為金紫光祿大夫，領太常。及建明堂，以本官領起部尚書，又領北選。","person_mention_id":"c-songshu-076-wangxuanmo-ws:p006:m0195"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanshi-023-wangyu-jingwen:p007","text":"時太子及諸皇子並小，上稍為身後計，諸將帥吳喜、壽寂之之徒，慮其不能奉幼主，並殺之。而景文外戚貴盛，張永累經軍旅，又疑其將來難信，乃自為謠言曰：「一士不可親，弓長射殺人。」一士王字，指景文，弓長張字，指張永。景文彌懼，乃自陳求解揚州。詔答曰：","mentions":[{"id":"c-nanshi-023-wangyu-jingwen:p007:m0020","surface":"吳喜","start":20,"end":22,"person_id":"elc_p5p_27p","kind":"person","status":"contextual_provisional","interpreta