inship_scope","person_id":"ecp_1f6_47o","source_quote":"兄子映公","reading":"襄兄之子。本卷及南史同事均不具其父名。陸雲公另由南史明屬兄完。","note":"襄兄之子。本卷及南史同事均不具其父名。陸雲公另由南史明屬兄完。","paragraph_id":"c-liangshu-027-luxiang-complete:p004","start_codepoint":111,"end_codepoint":115,"human_reviewed":false,"chapter_id":"c-liangshu-027-luxiang-complete","source_id":"s-liangshu-027-luxiang-complete-ws1511478"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-liang027-yinggong-uncle","subject_person_id":"ecp_1f6_47o","object_person_id":"d5x_77n_qxq_A","predicate":"paternal_uncle","qualifiers":{"source_term":"襄遣迎寧爲盟主，遣黯及兄子映公","lineage":"paternal"},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-027","chapter_id":"c-liangshu-027-luxiang-complete","source_id":"s-liangshu-027-luxiang-complete-ws1511478","paragraph_id":"c-liangshu-027-luxiang-complete:p004","quote":"二年，侯景舉兵圍宮城，以襄直侍中省。三年三月，城陷，襄逃還吳。賊尋寇東境，沒吳郡。景將宋子仙進攻錢塘，會海鹽人陸黯舉義，有衆數千人，夜出襲郡，殺偽太守蘇單于，推襄行郡事。時淮南太守文成侯蕭寧逃賊入吳，襄遣迎寧爲盟主，遣黯及兄子映公帥衆拒子仙。子仙聞兵起，乃退還，與黯等戰於松江，黯敗走，吳下軍聞之，亦各奔散。襄匿于墓下，一夜憂憤卒，時年七十。","subject_person_mention_id":"c-liangshu-027-luxiang-complete:p004:m0113","object_person_mention_id":"c-liangshu-027-luxiang-complete:p004:m0100"}],"status":"source_attested","interpretation_note":"襄遣兄子映公拒敵，映公之父為襄兄，名未見此條。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-liangshu-027-luxiang-complete:p004:m0113","start":113,"end":115,"surface":"映公","kind":"person","person_id":"ecp_1f6_47o","status":"contextual_provisional","paragraph_id":"c-liangshu-027-luxiang-complete:p004","chapter_id":"c-liangshu-027-luxiang-complete"}],"relations":[{"id":"a-liang027-yinggong-uncle","subject_person_id":"ecp_1f6_47o","object_person_id":"d5x_77n_qxq_A","predicate":"paternal_uncle","qualifiers":{"source_term":"襄遣迎寧爲盟主，遣黯及兄子映公","lineage":"paternal"},