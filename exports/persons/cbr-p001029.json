m003-0148","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"self_proclamation","date_expression":null,"evidence":[{"chapter_id":"c-shiji-031-wu","source_id":"s-shiji-031-wu","paragraph_id":"c-shiji-031-wu:p003","quote":"壽夢立而吳始益大，稱王。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"稱王、自號與用稱分開；延陵封邑不擅補正式爵等，未知時段不補造，不以卒日結束爵位。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji031-013","person_id":"cbr-p001029","surfaces":["壽夢","王壽夢"],"scope":"same_chapter","chapter_ids":["c-shiji-031-wu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-031-wu:p003","quote":"周章卒，子熊遂立，熊遂卒，子柯相立。柯相卒，子彊鳩夷立。彊鳩夷卒，子餘橋疑吾立。餘橋疑吾卒，子柯盧立。柯盧卒，子周繇立。周繇卒，子屈羽立。屈羽卒，子夷吾立。夷吾卒，子禽處立。禽處卒，子轉立。轉卒，子頗髙立。頗髙卒，子句卑立。是時晉獻公滅周北虞公，以開晉伐虢也。句卑卒，子去齊立。去齊卒，子壽夢立。壽夢立而吳始益大，稱王。"},{"paragraph_id":"c-shiji-031-wu:p004","quote":"自太伯作吳，五世而武王克殷，封其後爲二：其一虞，在中國；其一吳，在夷蠻。十二世而晉滅中國之虞。中國之虞滅二世，而夷蠻之吳興。大凡從太伯至壽夢十九世。"},{"paragraph_id":"c-shiji-031-wu:p005","quote":"王壽夢二年，楚之亡大夫申公巫臣怨楚將子反而犇晉，自晉使吳，教吳用兵乘車，令其子爲吳行人，吳於是始通於中國。吳伐楚。十六年，楚共王伐吳，至衡山。"},{"paragraph_id":"c-shiji-031-wu:p006","quote":"二十五年，王壽夢卒。壽夢有子四人，長曰諸樊，次曰餘祭，次曰餘眛，次曰季札。季札賢，而壽夢欲立之，季札讓不可，於是乃立長子諸樊，攝行事當國。"},{"paragraph_id":"c-shiji-031-wu:p008","quote":"十三年，王諸樊卒。有命授弟餘祭，欲傳以次，必致國於季札而止，以稱先王壽夢之意，且嘉季札之義，兄弟皆欲致國，令以漸至焉。季札封於延陵，故號曰延陵季子。"}],"rationale":"按本篇周初、吳世系、楚亡臣與列國稱號的敘事語境暫定異稱；同名不全庫替換，仲雍與周章弟虞仲分開。論樂的祖君稱號另保留候選，未按熟知故事合併。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji033-115","person_id":"cbr-p001029","surfaces":["吳王壽夢"],"scope":"cross_chapter","chapter_ids":["c-shiji-031-wu","c-shiji-033-lu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-031-wu:p003","quote":"周章卒，子熊遂立，熊遂卒，子柯相立。柯相卒，子彊鳩夷立。彊鳩夷卒，子餘橋疑吾立。餘橋疑吾卒，子柯盧立。柯盧卒，子周繇立。周繇卒，子屈羽立。屈羽卒，子夷吾立。夷吾卒，子禽處立。禽處卒，子轉立。轉卒，子頗髙立。頗髙卒，子句卑立。是時晉獻公滅周北虞公，以開晉伐虢也。句卑卒，子去齊立。去齊卒，子壽夢立。壽夢立而吳始益大，稱王。"},{"paragraph_id":"c-shiji-033-lu:p060","quote":"成公二年春，齊伐取我隆。夏，公與晉郤克敗齊頃公於砹齊復歸我侵地。四年，成公如晉，晉景公不敬魯。魯欲背晉合於楚，或諫，乃不。十年，成公如晉。晉景公卒，因留成公送葬，魯諱之。十五年，始與吳王壽夢會鐘離。"}],"rationale":"按文公以後立嗣、昭公出奔、夾谷會盟、徵百牢與魯君世系的具體事件及國別暫定異稱，後期同爵稱不與先君混同。身份、匿名指代與數位疑讀待覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-031-wu:p003","text":"周章卒，子熊遂立，熊遂卒，子柯相立。柯相卒，子彊鳩夷立。彊鳩夷卒，子餘橋疑吾立。餘橋疑吾卒，子柯盧立。柯盧卒，子周繇立。周繇卒，子屈羽立。屈羽卒，子夷吾立。夷吾卒，子禽處立。禽處卒，子轉立。轉卒，子頗髙立。頗髙卒，子句卑立。是時晉獻公滅周北虞公，以開晉伐虢也。句卑卒，子去齊立。去齊卒，子壽夢立。壽夢立而吳始益大，稱王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-031-wu:m003-0000","start":0,"end":2,"surface":"周章","kind":"person","person_id":"cbr-p001043","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m003-0005","start":5,"end":7,"surface":"熊遂","kind":"person","person_id":"cbr-p001016","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m003-0009","start":9,"end":11,"surface":"熊遂","kind":"person","person_id":"cbr-p001016","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m003-0014","start":14,"end":16,"surface":"柯相","kind":"person","person_id":"cbr-p001017","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m003-0018","start":18,"end":20,"surface":"柯相","kind":"person","person_id":"cbr-p001017","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m003-0023","start":23,"end":26,"surface":"彊鳩夷","kind":"person","person_id":"cbr-p001018","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m003-0028","start":28,"end":31,"surface":"彊鳩夷","kind":"person","person_id":"cbr-p001018","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m003-0034","start":34,"end":38,"surface":"餘橋疑吾","kind":"person","person_id":"cbr-p001019","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m003-0040","start":40,"end":44,"surface":"餘橋疑吾","kind":"person","person_id":"cbr-p001019","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m003-0047","start":47,"end":49,"surface":"柯盧","kind":"person","person_id":"cbr-p001020","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m003-0051","start":