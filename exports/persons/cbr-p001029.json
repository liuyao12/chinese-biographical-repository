-shiji-031-wu:m003-0114","start":114,"end":117,"surface":"晉獻公","kind":"person","person_id":"cbr-p000374","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m003-0118","start":118,"end":122,"surface":"周北虞公","kind":"person","person_id":"cbr-p000375","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m003-0130","start":130,"end":132,"surface":"句卑","kind":"person","person_id":"cbr-p001027","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m003-0135","start":135,"end":137,"surface":"去齊","kind":"person","person_id":"cbr-p001028","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m003-0139","start":139,"end":141,"surface":"去齊","kind":"person","person_id":"cbr-p001028","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m003-0144","start":144,"end":146,"surface":"壽夢","kind":"person","person_id":"cbr-p001029","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m003-0148","start":148,"end":150,"surface":"壽夢","kind":"person","person_id":"cbr-p001029","status":"contextual_provisional"}],"chapter_id":"c-shiji-031-wu","book_id":"b-shiji-031","work_id":"w-shiji","source_id":"s-shiji-031-wu"},{"id":"c-shiji-031-wu:p004","text":"自太伯作吳，五世而武王克殷，封其後爲二：其一虞，在中國；其一吳，在夷蠻。十二世而晉滅中國之虞。中國之虞滅二世，而夷蠻之吳興。大凡從太伯至壽夢十九世。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-031-wu:m004-0001","start":1,"end":3,"surface":"太伯","kind":"person","person_id":"cbr-p000172","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m004-0009","start":9,"end":11,"surface":"武王","kind":"person","person_id":"cbr-p000150","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m004-0065","start":65,"end":67,"surface":"太伯","kind":"person","person_id":"cbr-p000172","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m004-0068","start":68,"end":70,"surface":"壽夢","kind":"person","person_id":"cbr-p001029","status":"contextual_provisional"}],"chapter_id":"c-shiji-031-wu","book_id":"b-shiji-031","work_id":"w-shiji","source_id":"s-shiji-031-wu"},{"id":"c-shiji-031-wu:p005","text":"王壽夢二年，楚之亡大夫申公巫臣怨楚將子反而犇晉，自晉使吳，教吳用兵乘車，令其子爲吳行人，吳於是始通於中國。吳伐楚。十六年，楚共王伐吳，至衡山。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-031-wu:m005-0000","start":0,"end":3,"surface":"王壽夢","kind":"person","person_id":"cbr-p001029","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m005-0011","start":11,"end":15,"surface":"申公巫臣","kind":"person","person_id":"cbr-p001030","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m005-0018","start":18,"end":20,"surface":"子反","kind":"person","person_id":"cbr-p001031","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m005-0037","start":37,"end":39,"surface":"其子","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、族稱或未定指代，未補姓名與成員。"},{"id":"c-shiji-031-wu:m005-0061","start":61,"end":64,"surface":"楚共王","kind":"person","person_id":"cbr-p001032","status":"contextual_provisional"}],"chapter_id":"c-shiji-031-wu","book_id":"b-shiji-031","work_id":"w-shiji","source_id":"s-shiji-031-wu"},{"id":"c-shiji-031-wu:p006","text":"二十五年，王壽夢卒。壽夢有子四人，長曰諸樊，次曰餘祭，次曰餘眛，次曰季札。季札賢，而壽夢欲立之，季札讓不可，於是乃立長子諸樊，攝行事當國。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-031-wu:m006-0005","start":5,"end":8,"surface":"王壽夢","kind":"person","person_id":"cbr-p001029","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m006-0010","start":10,"end":12,"surface":"壽夢","kind":"person","person_id":"cbr-p001029","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m006-0019","start":19,"end":21,"surface":"諸樊","kind":"person","person_id":"cbr-p001033","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m006-0024","start":24,"end":26,"surface":"餘祭","kind":"person","person_id":"cbr-p001034","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m006-0029","start":29,"end":31,"surface":"餘眛","kind":"person","person_id":"cbr-p001035","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m006-0034","start":34,"end":36,"surface":"季札","kind":"person","person_id":"cbr-p001036","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m006-0037","start":37,"end":39,"surface":"季札","kind":"person","person_id":"cbr-p001036","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m006-0042","start":42,"end":44,"surface":"壽夢","kind":"person","person_id":"cbr-p001029","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m006-0048","start":48,"end":50,"surface":"季札","kind":"person","person_id":"cbr-p001036","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m006-0060","start":60,"end":62,"surface":"諸樊","kind":"person","person_id":"cbr-p001033","status":"contextual_provisional"}],"chapter_id":"c-shiji-031-wu","book_id":"b-shiji-031","work_id":"w-shiji","source_id":"s-shiji-031-wu"},{"id":"c-shiji-031-wu:p008","text":"十三年，王諸樊卒。有命授弟餘祭，欲傳以次，必致國於季札而止，以稱先王壽夢之意，且嘉季札之義，兄弟皆欲致國，令以漸至焉。季札封於延陵，故號曰延陵季子。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-031-wu:m008-0004","start":4,"end":7,"surface":"王諸樊","kind":"person","person_id":"cbr-p001033","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m008-0013","start":13,"end":15,"surface":"餘祭","kind":"person","person_id":"cbr-p001034","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m008-0025","start":25,"end":27,"surface":"季札","kind":"person","person_id":"cbr-p001036","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m008-0033","start":33,"end":36,"surface":"王壽夢","kind":"person","person_id":"cbr-p001029","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m008-0041","start":41,"end":43,"surface":"季札","kind":"person","person_id":"cbr-p001036","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m008-0059","start":59,"end":61,"surface":"季札","kind":"person","person_id":"cbr-p001036","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m008-0069","start":69,"end":73,"surface":"延陵季子","kind":"person","person_id":"cbr-p001036","status":"contextual_provisional"}],"chapter_id":"c-shiji-031-wu","book_id":"b-shiji-031","work_id":"w-shiji","source_id":"s-shiji-031-wu"},{"id":"c-shiji-033-lu:p060","text":"成公二年春，齊伐取我隆。夏，公與晉郤克敗齊頃公於砹齊復歸我侵地。四年，成公如晉，晉景公不敬魯。魯欲背晉合於楚，或諫，乃不。十年，成公如晉。晉景公卒，因留成公送葬，魯諱之。十五年，始與吳王壽夢會鐘離。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-033-lu:m060-0000","start":0,"end":2,"surface":"成公","kind":"person","person_id":"cbr-p001270","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m060-0014","start":14,"end":15,"surface":"公","kind":"person","person_id":"cbr-p001270","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m060-0016","start":16,"end":19,"surface":"晉郤克","kind":"person","person_id":"cbr-p001149","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m060-0020","start":20,"end":23,"surface":"齊頃公","kind":"person","person_id":"cbr-p001145","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m060-0035","start":35,"end":37,"surface":"成公","kind":"person","person_id":"cbr-p001270","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m060-0040","start":40,"end":43,"surface":"晉景公","kind":"person","person_id":"cbr-p001155","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m060-0055","start":55,"end":57,"surface":"或諫","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未指名者、論贊署稱、地點氏稱或未定指代；不補姓名、爵位與成員。"},{"id":"c-shiji-033-lu:m060-0064","start":64,"end":66,"surface":"成公","kind":"person","person_id":"cbr-p001270","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m060-0069","start":69,"end":72,"surface":"晉景公","kind":"person","person_id":"cbr-p001155","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m060-0076","start":76,"end":78,"surface":"成公","kind":"person","person_id":"cbr-p001270","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m060-0091","start":91,"end":95,"surface":"吳王壽夢","kind":"person","person_id":"cbr-p001029","status":"contextual_provisional"}],"chap