iji-121-rulin"}],"relations":[],"title_holdings":[{"id":"th-shiji121-034","person_id":"aqd_hcr_hzk","title":"博士","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-121-rulin","source_id":"s-shiji121-rulin","paragraph_id":"c-shiji-121-rulin:p015","quote":"伏生教濟南張生及歐陽生，歐陽生教千乘兒寬。兒寬既通尚書，以文學應郡舉，詣博士受業，受業孔安國。兒寬貧無資用，常為弟子都養，及時時閒行傭賃，以給衣食。行常帶經，止息則誦習之。以試第次，補廷尉史。是時張湯方鄉學，以為奏讞掾，以古法議決疑大獄，而愛幸寬。寬為人溫良，有廉智，自持，而善著書、書奏，敏於文，口不能發明也。湯以為長者，數稱譽之。及湯為御史大夫，以兒寬為掾，薦之天子。天子見問，說之。張湯死后六年，兒寬位至御史大夫。九年而以官卒。寬在三公位，以和良承意從容得久，然無有所匡諫；於官，官屬易之，不為盡力。張生亦為博士。而伏生孫以治尚書徵，不能明也。"}],"attestations":[{"id":"th-shiji121-034:a001","paragraph_id":"c-shiji-121-rulin:p015","start":257,"end":259,"surface":"博士","person_mention_id":"c-shiji-121-rulin:m015-0005","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"依原文區分授任、貶任與用稱；未明日期保持未知，死亡不自動終止官爵。敘事時長不反推公元年。","reviewer":"Codex（AI 代理）"}],"address_assertions":[{"id":"pa-shiji121-012","person_id":"aqd_hcr_hzk","relation":"biographical_origin","place":{"source_name":"濟南","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-121-rulin","source_id":"s-shiji121-rulin","paragraph_id":"c-shiji-121-rulin:p015","quote":"伏生教濟南張生及歐陽生，歐陽生教千乘兒寬。兒寬既通尚書，以文學應郡舉，詣博士受業，受業孔安國。兒寬貧無資用，常為弟子都養，及時時閒行傭賃，以給衣食。行常帶經，止息則誦習之。以試第次，補廷尉史。是時張湯方鄉學，以為奏讞掾，以古法議決疑大獄，而愛幸寬。寬為人溫良，有廉智，自持，而善著書、書奏，敏於文，口不能發明也。湯以為長者，數稱譽之。及湯為御史大夫，以兒寬為掾，薦之天子。天子見問，說之。張湯死后六年，兒寬位至御史大夫。九年而以官卒。寬在三公位，以和良承意從容得久，然無有所匡諫；於官，官屬易之，不為盡力。張生亦為博士。而伏生孫以治尚書徵，不能明也。"}],"source_term":"濟南張生","interpretation_note":"保留人物介紹中的人地原稱，不推定出生地、居住日期或現代轄區。相鄰人物不自動承受同一原籍。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":