{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000779","identity_policy":"contextual_provisional","person_ids":["cbr-p000779"],"persons":[{"id":"cbr-p000779","label":"項聲","status":"active","historicity":"historical_tradition","aliases":[{"surface":"項聲","mention_ids":["c-shiji-008-gaozu:m042-0030"]}],"evidence":[{"mention_id":"c-shiji-008-gaozu:m042-0030","chapter_id":"c-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p042","quote":"項聲"}]}],"mentions":[{"id":"c-shiji-008-gaozu:m042-0030","start":30,"end":32,"surface":"項聲","kind":"person","person_id":"cbr-p000779","status":"contextual_provisional","paragraph_id":"c-shiji-008-gaozu:p042","chapter_id":"c-shiji-008-gaozu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-008-gaozu:p042","text":"項羽聞漢王在宛，果引兵南。漢王堅壁不與戰。是時彭越渡睢水，與項聲、薛公戰下邳，彭越大破楚軍。項羽乃引兵東擊彭越。漢王亦引兵北軍成皋。項羽已破走彭越，聞漢王復軍成皋，乃復引兵西，拔滎陽，誅周苛、樅公，而虜韓王信，遂圍成皋。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m042-0000","start":0,"end":2,"surface":"項羽","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m042-0003","start":3,"end":5,"surface":"漢王","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m042-0013","start":13,"end":15,"surface":"漢王","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m042-0023","start":23,"end":25,"surface":"彭越","kind":"person","person_id":"cbr-p000707","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m042-0030","start":30,"end":32,"surface":"項聲","kind":"person","person_id":"cbr-p000779","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m042-0033","start":33,"end":35,"surface":"薛公","kind":"person","person_id":"cbr-p000725","status":