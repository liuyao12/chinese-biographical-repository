n:m034-0084","chapter_id":"c-shiji-039-jin","paragraph_id":"c-shiji-039-jin:p034","quote":"虢仲"}]}],"source_mention_summary":[{"source_id":"s-shiji-039-jin","work_id":"w-shiji","book_id":"b-shiji-039","chapter_id":"c-shiji-039-jin","mention_count":1,"mention_ids":["c-shiji-039-jin:m034-0084"],"paragraph_ids":["c-shiji-039-jin:p034"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-039-jin"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-039-jin:m034-0084","start":84,"end":86,"surface":"虢仲","kind":"person","person_id":"cbr-p001721","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p034","chapter_id":"c-shiji-039-jin"}],"relations":[{"id":"a-shiji039-030","subject_person_id":"cbr-p001721","predicate":"father","object_person_id":"cbr-p000175","status":"source_attested","evidence":[{"chapter_id":"c-shiji-039-jin","source_id":"s-shiji-039-jin","paragraph_id":"c-shiji-039-jin:p034","quote":"是歳也，晉復假道於虞以伐虢。虞之大夫宮之奇諫虞君曰：「晉不可假道也，是且滅虞。」虞君曰：「晉我同姓，不宜伐我。」宮之奇曰：「太伯、虞仲，太王之子也，太伯亡去，是以不嗣。虢仲、虢叔，王季之子也，爲文王卿士，其記勳在王室，藏於盟府。將虢是滅，何愛于虞？且虞之親能親於桓、莊之族乎？桓、莊之族何罪，盡滅之。虞之與虢，脣之與齒，脣亡則齒寒。」虞公不聽，遂許晉。宮之奇以其族去虞。其冬，晉滅虢，虢公丑奔周。還，襲滅虞，虜虞公及其大夫井伯百里奚以媵秦穆姬，而修虞祀。荀息牽曩所遺虞屈産之乘馬奉之獻公，獻公笑曰：「馬則吾馬，齒亦老矣！」"}],"qualifiers":{"source_term":"王季之子","historicity":"historical_tradition"},"interpretation_note":"保存本段明示親屬或生育敘事；不由繼位補父子，不補闕代。母、女弟、庶孫等依原文；人物暫同指及不同篇主張仍待覆核。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji039-159","person_id":"cbr-p001721","surfaces":["虢仲"],"scope":"same_chapter","chapter_ids":["c-shiji-039-jin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-039-jin:p034","quote":"是歳也，晉復假道於虞以伐虢。虞之大夫宮之奇諫虞君曰：「晉不可假道也，是且滅虞。」虞君曰：「晉我同姓，不宜伐我。」宮之奇曰：「太伯、虞仲，太王之子也，太伯亡去，是以不嗣。虢仲、虢叔，王季之子也，爲文王卿士，其記勳在王室，藏於盟府。將虢是滅，何愛于虞？且虞之親能親於桓、莊之族乎？桓、莊之族何罪，盡滅之。虞之與虢，脣之與齒，脣亡則齒寒。」虞公不聽，遂許晉。宮之奇以其族去虞。其冬，晉滅虢，虢公丑奔周。還，襲滅虞，虜虞公及其大夫井伯百里奚以媵秦穆姬，而修虞祀。荀息牽曩所遺虞屈産之乘馬奉之獻公，獻公笑曰：「馬則吾馬，齒亦老矣！」"}],"rationale":"按本篇明示名與稱號、晉世系與具體事件暫定所列提及同指；附各段原文，未按同字短名全域合併；紀年與版本差異待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-039-jin:p034","text":"是歳也，晉復假道於虞以伐虢。虞之大夫宮之奇諫虞君曰：「晉不可假道也，是且滅虞。」虞君曰：「晉我同姓，不宜伐我。」宮之奇曰：「太伯、虞仲，太王之子也，太伯亡去，是以不嗣。虢仲、虢叔，王季之子也，爲文王卿士，其記勳在王室，藏於盟府。將虢是滅，何愛于虞？且虞之親能親於桓、莊之族乎？桓、莊之族何罪，盡滅之。虞之與虢，脣之與齒，脣亡則齒寒。」虞公不聽，遂許晉。宮之奇以其族去虞。其冬，晉滅虢，虢公丑奔周。還，襲滅虞，虜虞公及其大夫井伯百里奚以媵秦穆姬，而修虞祀。荀息牽曩所遺虞屈産之乘馬奉之獻公，獻公笑曰：「馬則吾馬，齒亦老矣！」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m034-0018","start":18,"end":21,"surface":"宮之奇","kind":"person","person_id":"cbr-p001719","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m034-0022","start":22,"end":24,"surface":"虞君","kind":"person","person_id":"cbr-p000375","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m034-0040","start":40,"end":42,"surface":"虞君","kind":"person","person_id":"cbr-p000375","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m034-0056","start":56,"end":59,"surface":"宮之奇","kind":"person","person_id":"cbr-p001719","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m034-0062","start":62,"end":64,"surface":"太伯","kind":"person","person_id":"cbr-p000172","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m034-0065","start":65,"end":67,"surface":"虞仲","kind":"person","person_id":"cbr-p000173","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m034-0068","start":68,"end":70,"surface":"太王","kind":"person","person_id":"cbr-p001720","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m034-0074","start":74,"end":76,"surface":"太伯","kind":"person","person_id":"cbr-p000172","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m034-0084","start":84,"end":86,"surface":"虢仲","kind":"person","person_id":"cbr-p001721","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m03