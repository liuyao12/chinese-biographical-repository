rt":153,"end":157,"surface":"尋以憂卒"},"date_expression":null,"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-070","chapter_id":"c-jinshu-070-biandun","source_id":"s-jinshu-070-biandun-ws2595540","paragraph_id":"c-jinshu-070-biandun:p004","quote":"蘇峻反，溫嶠、庾亮移檄征鎮同赴京師。敦擁兵不下，又不給軍糧，唯遣督護荀璲領數百人隨大軍而已。時朝野莫不怪歎，獨陶侃亦切齒忿之。峻平，侃奏敦阻軍顧望，不赴國難，無大臣之節，請檻車收付廷尉。丞相王導以喪亂之後宜加寬宥，轉安南將軍、廣州刺史。病不之職。徵爲光祿大夫，領少府。敦既不討蘇峻，常懷愧恥，名論自此虧矣。尋以憂卒，追贈本官，加散騎常侍，諡曰敬。子滔嗣。","person_mention_id":"c-jinshu-070-biandun:p004:m0018"}],"status":"source_attested","interpretation_note":"按同段人物與次第核所屬卒事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"mentions":[{"id":"c-jinshu-070-biandun:p001:m0000","surface":"敦","start":0,"end":1,"person_id":"ag0_yix_pet","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-070-biandun:p001","chapter_id":"c-jinshu-070-biandun"},{"id":"c-jinshu-070-biandun:p004:m0018","surface":"敦","start":18,"end":19,"person_id":"ag0_yix_pet","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-070-biandun:p004","chapter_id":"c-jinshu-070-biandun"}],"relations":[{"id":"a-jin070-bianjun-father","subject_person_id":"ag0_yix_pet","object_person_id":"dh7_epf_8e7","predicate":"father","qualifiers":{"source_term":"父俊，清真有檢識"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-070","chapter_id":"c-jinshu-070-biandun","source_id":"s-jinshu-070-biandun-ws2595540","paragraph_id":"c-jinshu-070-biandun:p001","quote":"敦字仲仁。父俊，清真有檢識，以名理著稱。其鄉人郤詵恃才陵傲俊兄弟，俊等亦以門盛輕詵，相視如讎。詵以楊駿故吏被繫，俊時爲尚書郎，案其獄，詵懼不免，俊平心斷決正之，詵卒以免，而猶不悛。後爲左丞，復奏陷卞氏。俊歷位汝南相、廷尉卿。","subject_person_mention_id":"c-jinshu-070-biandun:p001:m0000","object_person_mention_id":"c-jinshu-070-biandun:p001:m0006"}],"status":"source_attested","interpretation_note":"四庫字作浚。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equi