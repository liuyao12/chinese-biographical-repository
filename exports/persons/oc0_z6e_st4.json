d":26,"person_id":"oc0_z6e_st4","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-058-zhou-yan:p001","chapter_id":"c-jinshu-058-zhou-yan"},{"id":"c-jinshu-058-zhou-zha:p001:m0115","surface":"徐馥","start":115,"end":117,"person_id":"oc0_z6e_st4","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-058-zhou-zha:p001","chapter_id":"c-jinshu-058-zhou-zha"},{"id":"c-jinshu-098-jin033-wangji:line081:m0139","start":139,"end":141,"surface":"徐馥","kind":"person","person_id":"oc0_z6e_st4","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line081","chapter_id":"c-jinshu-098-jin033-wangji"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-058-zhou-xie:p001","text":"勰字彥和。常緘父言。時中國亡官失守之士避亂來者，多居顯位，駕御呉人，呉人頗怨。勰因之欲起兵，潛結呉興郡功曹徐馥。馥家有部曲，勰使馥矯稱叔父劄命以合眾，豪俠樂亂者翕然附之，以討王導、刁協爲名。孫皓族人弼亦起兵於廣德以應之。馥殺呉興太守袁琇，有眾數千，將奉劄爲主。時劄以疾歸家，聞而大驚，乃告亂於義興太守孔侃。勰知劄不同，不敢發兵。馥黨懼，攻馥，殺之。孫弼眾亦潰，宣城太守陶猷滅之。元帝以周氏奕世豪望，呉人所宗，故不窮治，撫之如舊。勰爲劄所責，失志歸家，淫侈縱恣，毎謂人曰：「人生幾時，但當快意耳。」終於臨淮太守。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":36,"last_line":36,"raw_start":3051,"raw_end":3312,"raw_character_offsets":[3053,3054,3055,3056,3057,3058,3059,3060,3061,3062,3063,3064,3065,3066,3067,3068,3069,3070,3071,3072,3073,3074,3075,3076,3077,3078,3079,3080,3081,3082,3083,3084,3085,3086,3087,3088,3089,3090,3091,3092,3093,3094,3095,3096,3097,3098,3099,3100,3101,3102,3103,3104,3105,3106,3107,3108,3109,3110,3111,3112,3113,3114,3115,3116,3117,3118,3119,3120,3121,3122,3123,3124,3125,3126,3127,3128,3129,3130,3131,3132,3133,3134,3135,3136,3137,3138,3139,3140,3141,3142,3143,3144,3145,3146,3147,3148,3149,3150,3151,3152,3153,3154,3155,3156,3157,3158,3159,3160,3161,3162,3163,3164,3165,3166,3167,3168,3169,3170,3171,3172,3