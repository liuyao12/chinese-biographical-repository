amily_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-098-jin033-wangji:line081:m0139","start":139,"end":141,"surface":"徐馥","kind":"person","person_id":"oc0_z6e_st4","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line081","chapter_id":"c-jinshu-098-jin033-wangji"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-098-jin033-wangji:line081","text":"既而周光斬錢鳳，吳儒斬沈充，並傳首京師。有司議曰：「王敦滔天作逆，有無君之心，宜依崔杼、王浚故事，剖棺戮屍，以彰元惡。」於是發瘞出屍，焚其衣冠，跽而刑之。敦、充首同日懸于南桁，觀者莫不稱慶。敦首既懸，莫敢收葬者。尚書令郗鑒言於帝曰：「昔王莽漆頭以輗車，董卓然腹以照市，王淩儭土，徐馥焚首。前朝誅楊駿等，皆先極官刑，後聽私殯。然《春秋》許齊襄之葬紀侯，魏武義王修之哭袁譚。由斯言之，王誅加於上，私義行於下。臣以為可聽私葬，於義為弘。」昭許之，於是敦家收葬焉。含父子乘單船奔荊州刺史王舒，舒使人沈之于江，餘黨悉平。","annotation_status":"reviewed","text_layer":"received_chapter","mentions":[{"id":"c-jinshu-098-jin033-wangji:line081:m0002","start":2,"end":4,"surface":"周光","kind":"person","person_id":"fqd_otm_jc2","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line081:m0005","start":5,"end":7,"surface":"錢鳳","kind":"person","person_id":"762_5c8_663","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line081:m0008","start":8,"end":10,"surface":"吳儒","kind":"person","person_id":"fxt_25c_3fh","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line081:m0011","start":11,"end":13,"surface":"沈充","kind":"person","person_id":"4c2_19b_bf4","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line081:m0026","start":26,"end":28,"surface":"王敦","kind":"person","person_id":"39o_b6y_n74","sta