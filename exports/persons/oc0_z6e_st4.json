id":"c-jinshu-058-zhou-yan:p001:m0208","surface":"呉曾","start":208,"end":210,"person_id":"npt_ys0_o6o","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-yan:p001:m0228","surface":"續","start":228,"end":229,"person_id":"kgj_v2s_env","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-yan:p001:m0233","surface":"筵","start":233,"end":234,"person_id":"jo4_7hm_ivw","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-yan:p001:m0237","surface":"勰","start":237,"end":238,"person_id":"o1j_w2l_0gv","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-yan:p001:m0239","surface":"劄","start":239,"end":240,"person_id":"1a4_h3u_5rc","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-yan:p001:m0249","surface":"邵","start":249,"end":250,"person_id":"azg_3eu_pp4","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-yan:p001:m0254","surface":"筵","start":254,"end":255,"person_id":"jo4_7hm_ivw","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-yan:p001:m0259","surface":"母","start":259,"end":260,"person_id":"2ij_vjr_j68","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-058-zhou-yan","book_id":"b-jinshu-058","work_id":"w-jinshu","source_id":"s-jinshu-058-zhou-yan-ws1775463"},{"id":"c-jinshu-058-zhou-zha:p001","text":"劄字宣季。性矜險好利，外方內荏，少以豪右自處，州郡辟命皆不就。察孝廉，除郎中、大司馬齊王冏參軍。出補句容令，遷呉國上軍將軍。辟東海王越參軍，不就。以討錢璯功，賜爵漳浦亭侯。元帝爲丞相，表劄爲甯遠將軍、曆陽內史，不之職，轉從事中郎。徐馥平，以劄爲奮武將軍、呉興內史，録前後功，改封東遷縣侯，進號征虜將軍、臨揚州江北軍事、東中郎將，鎮塗中，未之職，轉右將軍、都督石頭水陸軍事。劄腳疾，不堪拜，固讓經年，有司彈奏，不得已乃視職。加散騎常侍。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":44,"last_line":44,"raw_start":3378,"raw_end":3605,"raw_character_offsets":[3380,3381,3382,3383,3384,3385,3386,3387,3388,3389,3390,3391,3392,3393,3394,3395,3396,3397,3398,3399,3400,3401,3402,3403,3404,3405,3406,3407,3408,3409,3410,3411,3412,3413,3414,3415,3416,3417,3418,3419,3420,3