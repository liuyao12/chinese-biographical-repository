d":176,"person_id":"w6c_hkg_1ry","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-xie:p001:m0184","surface":"陶猷","start":184,"end":186,"person_id":"hni_1nz_att","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-xie:p001:m0189","surface":"元帝","start":189,"end":191,"person_id":"dkn_ge4_286_AAAAAAA","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-xie:p001:m0214","surface":"勰","start":214,"end":215,"person_id":"o1j_w2l_0gv","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-xie:p001:m0216","surface":"劄","start":216,"end":217,"person_id":"1a4_h3u_5rc","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-058-zhou-xie","book_id":"b-jinshu-058","work_id":"w-jinshu","source_id":"s-jinshu-058-zhou-xie-ws1775463"},{"id":"c-jinshu-058-zhou-yan:p001","text":"筵卓犖有才幹，拜征虜將軍、呉興太守，遷黃門侍郎。徐馥之役，筵族兄續亦聚眾應之。元帝議欲討之，王導以爲「兵少則不足制寇，多遣則根本空虛。黃門侍郎周筵忠烈至到，爲一郡所敬。意謂直遣筵，足能殺續」。於是詔以力士百人給筵，使輕騎還陽羨。筵即日取道，晝夜兼行。既至郡，將入，遇續於門，筵謂續曰：「宜與君共詣孔府君，有所論。」續不肯入，筵逼牽與俱。坐定，筵謂太守孔侃曰：「府君何以置賊在坐？」續衣裏帶小刀，便操刃逼筵，筵叱郡傳教呉曾：「何不舉手！」曾有膽力，便以刀環築續，殺之。筵因欲誅勰，劄拒不許，委罪於從兄邵，誅之。筵不歸家省母，遂長驅而去，母狼狽追之。其忠公如此。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":56,"last_line":56,"raw_start":5100,"raw_end":5393,"raw_character_offsets":[5102,5103,5104,5105,5106,5109,5112,5113,5116,5119,5120,5121,5122,5123,5124,5125,5126,5127,5128,5129,5130,5131,5132,5133,5134,5135,5136,5137,5138,5139,5140,5141,5142,5143,5144,5145,5146,5147,5148,5149,5150,5151,5152,5153,5154,5155,5156,5157,5158,5159,5160,5161,5162,5163,5164,5165,5166,5167,5168,5169,5170,5171,5172,5173,5174,5175,5176,5177,5178,5179,5180,5181,5182,5183,5184,5185,5186,5187,5188,5189,5190,5191,5192,5193,5194,5195,5196,5197,5198,5199,5200,5201,5202,5203,5204,5205,5206,5207,5208,5209,5210,5211,5212,5213,5214,5215,5216,5217,5218,5219,5220,5221,5222,5223,5224,5225,5226,5227,5228,5229,5230,5231,5232,5233,5234,5235,5236,5237,5238,5239,5240,5241,5242,