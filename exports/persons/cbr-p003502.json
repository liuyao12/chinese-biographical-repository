rpretation_note":"授官、爵秩、追稱、承爵與一般用稱分存；相對年數按原段，不換算公曆或推定所有官爵同時終止。未知官員姓名與制度性質不補。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji057-035","person_id":"cbr-p003502","surfaces":["太尉弱"],"scope":"same_chapter","chapter_ids":["c-shiji-057-zhou"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-057-zhou:p006","quote":"燕王盧綰反，勃以相國代樊噲將，擊下薊，得綰大將抵、丞相偃、守陘、太尉弱、御史大夫施，屠渾都。破綰軍上蘭，復擊破綰軍沮陽。追至長城，定上谷十二縣，右北平十六縣，遼西、遼東二十九縣，漁陽二十二縣。最從高帝得相國一人，丞相二人，將軍、二千石各三人；別破軍二，下城三，定郡五，縣七十九，得丞相、大將各一人。"}],"rationale":"按明示姓名、軍事近接、父子承爵與局部皇帝敘事暫接。周勃和勝之的絳侯分開，亞夫條侯與平曲支不混；代地韓信依韓王信近接而不接淮陰侯。未名人物、單名官員不補姓，校勘字不作定本，相術預言不作史實已驗。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-057-zhou:p006","text":"燕王盧綰反，勃以相國代樊噲將，擊下薊，得綰大將抵、丞相偃、守陘、太尉弱、御史大夫施，屠渾都。破綰軍上蘭，復擊破綰軍沮陽。追至長城，定上谷十二縣，右北平十六縣，遼西、遼東二十九縣，漁陽二十二縣。最從高帝得相國一人，丞相二人，將軍、二千石各三人；別破軍二，下城三，定郡五，縣七十九，得丞相、大將各一人。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-057-zhou:m006-0000","start":0,"end":4,"surface":"燕王盧綰","kind":"person","person_id":"cbr-p003497","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m006-0006","start":6,"end":7,"surface":"勃","kind":"person","person_id":"cbr-p003468","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m006-0011","start":11,"end":13,"surface":"樊噲","kind":"person","person_id":"cbr-p003498","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m006-0020","start":20,"end":21,"surface":"綰","kind":"person","person_id":"cbr-p003497","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m006-0021","start":21,"end":24,"surface":"大將抵","kind":"person","person_id":"cbr-p003499","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m006-0025","start":25,"end":28,"surface":"丞相偃","kind":"person","person_id":"cbr-p003500","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m006-0029","start":29,"end":31,"surface":"守陘","kind":"per