ivalence_decisions":[],"passages":[{"id":"c-shiji-092-hanxin:p026","text":"髙祖已從豨軍來，至，見信死，且喜且憐之，問：『信死亦何言？』呂后曰：『信言恨不用蒯通計。』髙祖曰：『是齊辯士也。』乃詔齊捕蒯通。蒯通至，上曰：『若教淮陰侯反乎？』對曰：『然，臣固教之。豎子不用臣之策，故令自夷於此。如彼豎子用臣之計，陛下安得而夷之乎！』上怒曰：『亨之。』通曰：『嗟乎，冤哉亨也！』上曰：『若教韓信反，何冤？』對曰：『秦之綱絕而維弛，山東大擾，異姓并起，英俊烏集。秦失其鹿，天下共逐之，於是髙材疾足者先得焉。蹠之狗吠堯，堯非不仁，狗因吠非其主。當是時，臣唯獨知韓信，非知陛下也。且天下銳精持鋒欲爲陛下所爲者甚眾，顧力不能耳。又可盡亨之邪？』髙帝曰：『置之。』乃釋通之罪。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-092-hanxin:m026-0000","start":0,"end":2,"surface":"髙祖","kind":"person","person_id":"cbr-p005105","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m026-0011","start":11,"end":12,"surface":"信","kind":"person","person_id":"cbr-p005099","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m026-0023","start":23,"end":24,"surface":"信","kind":"person","person_id":"cbr-p005099","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m026-0030","start":30,"end":32,"surface":"呂后","kind":"person","person_id":"cbr-p005138","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m026-0035","start":35,"end":36,"surface":"信","kind":"person","person_id":"cbr-p005099","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m026-0040","start":40,"end":42,"surface":"蒯通","kind":"person","person_id":"cbr-p005126","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m026-0045","start":45,"end":47,"surface":"髙祖","kind":"person","person_id":"cbr-p005105","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m026-0061","start":61,"end":63,"surface":"蒯通","kind":"person","person_id":"cbr-p005126","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m026-0064","start":64,"end":66,"surface":"蒯通","kind":"person","person_id":"cbr-p005126","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m026-0068","start":68,"end":69,"surface":"上","kind":"person","person_id":"cbr-p005105","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m026-0074","start":74,"end":7