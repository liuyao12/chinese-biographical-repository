為妃。王謀為反具，畏太子妃知而內泄事，乃與太子謀，令詐弗愛，三月不同席。王乃詳為怒太子，閉太子使與妃同內三月，太子終不近妃。妃求去，王乃上書謝歸去之。王后荼、太子遷及女陵得愛幸王，擅國權，侵奪民田宅，妄致繋人。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-118-huainan:m016-0000","start":0,"end":3,"surface":"淮南王","kind":"person","person_id":"yqp_nlb_p1p_AFA","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m016-0004","start":4,"end":6,"surface":"女陵","kind":"person","person_id":"yqp_nlb_p1p_AFAA","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m016-0013","start":13,"end":14,"surface":"王","kind":"person","person_id":"yqp_nlb_p1p_AFA","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m016-0015","start":15,"end":16,"surface":"陵","kind":"person","person_id":"yqp_nlb_p1p_AFAA","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m016-0031","start":31,"end":32,"surface":"上","kind":"person","person_id":"nds_eog_ibo","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m016-0040","start":40,"end":41,"surface":"上","kind":"person","person_id":"nds_eog_ibo","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m016-0042","start":42,"end":45,"surface":"淮南王","kind":"person","person_id":"yqp_nlb_p1p_AFA","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m016-0051","start":51,"end":54,"surface":"淮南王","kind":"person","person_id":"yqp_nlb_p1p_AFA","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m016-0054","start":54,"end":57,"surface":"王后荼","kind":"person","person_id":"8ie_pfa_02i","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m016-0058","start":58,"end":59,"surface":"王","kind":"person","person_id":"yqp_nlb_p1p_AFA","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m016-0063","start":63,"end":65,"surface":"王后","kind":"person","person_id":"8ie_pfa_02i","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m016-0066","start":66,"end":69,"surface":"太子遷","kind":"person","person_id":"5th_oxr_3i6","status":"contextual_pro