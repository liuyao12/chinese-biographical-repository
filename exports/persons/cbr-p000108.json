i-003-yin:m015-0005","start":5,"end":7,"surface":"太庚","kind":"person","person_id":"sa0_w3e_z3k","status":"source_identified"},{"id":"c-shiji-003-yin:m015-0011","start":11,"end":14,"surface":"帝太庚","kind":"person","person_id":"sa0_w3e_z3k","status":"source_identified"},{"id":"c-shiji-003-yin:m015-0015","start":15,"end":18,"surface":"帝太庚","kind":"person","person_id":"sa0_w3e_z3k","status":"source_identified"},{"id":"c-shiji-003-yin:m015-0021","start":21,"end":24,"surface":"帝小甲","kind":"person","person_id":"djp_k1v_gxx","status":"source_identified"},{"id":"c-shiji-003-yin:m015-0026","start":26,"end":29,"surface":"帝小甲","kind":"person","person_id":"djp_k1v_gxx","status":"source_identified"},{"id":"c-shiji-003-yin:m015-0032","start":32,"end":34,"surface":"雍己","kind":"person","person_id":"rls_d4j_3x2","status":"source_identified"},{"id":"c-shiji-003-yin:m015-0038","start":38,"end":41,"surface":"帝雍己","kind":"person","person_id":"rls_d4j_3x2","status":"source_identified"}],"chapter_id":"c-shiji-003-yin","book_id":"b-shiji-003","work_id":"w-shiji","source_id":"s-shiji-003-yin"},{"id":"c-shiji-003-yin:p016","text":"帝雍己崩，弟太戊立，是為帝太戊。帝太戊立伊陟為相。亳有祥，桑穀共生於朝，一暮大拱。帝太戊懼，問伊陟。伊陟曰：「臣聞妖不勝德，帝之政其有闕與？帝其修德。」太戊從之，而祥桑枯死而去。伊陟贊言于巫咸。巫咸治王家有成，作咸艾，作太戊。帝太戊贊伊陟于廟，言弗臣，伊陟讓，作原命。殷復興，諸侯歸之，故稱中宗。","mentions":[{"id":"c-shiji-003-yin:m016-0000","start":0,"end":3,"surface":"帝雍己","kind":"person","person_id":"rls_d4j_3x2","status":"source_identified"},{"id":"c-shiji-003-yin:m016-0006","start":6,"end":8,"surface":"太戊","kind":"person","person_id":"ta6_n0m_glj","status":"source_identified"},{"id":"c-shiji-003-yin:m016-0012","start":12,"end":15,"surface":"帝太戊","kind":"person","person_id":"ta6_n0m_glj","status":"source_identified"},{"id":"c-shiji-003-yin:m016-0016","start":16,"end":19,"surface":"帝太戊","kind":"person","person_id":"ta6_n0m_glj","status":"source_identified"},{"id":"c-shiji-003-yin:m016-0020","start":20,"end":22,"surface":"伊陟","kind":"person","person_id":"k2o_rtt_h2o","status":"source_identified"},{"id":"c-shij