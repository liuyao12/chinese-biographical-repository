b-shiji-033","work_id":"w-shiji","source_id":"s-shiji-033-lu"},{"id":"c-shiji-033-lu:p046","text":"先時慶父與哀姜私通，欲立哀姜娣子開。及莊公卒而季友立斑，十月己未，慶父使圉人犖殺魯公子斑於黨氏。季友奔陳。慶父竟立莊公子開，是爲湣公。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-033-lu:m046-0002","start":2,"end":4,"surface":"慶父","kind":"person","person_id":"cbr-p001113","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m046-0005","start":5,"end":7,"surface":"哀姜","kind":"person","person_id":"cbr-p001112","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m046-0012","start":12,"end":14,"surface":"哀姜","kind":"person","person_id":"cbr-p001112","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m046-0015","start":15,"end":17,"surface":"子開","kind":"person","person_id":"cbr-p001111","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m046-0019","start":19,"end":21,"surface":"莊公","kind":"person","person_id":"cbr-p001106","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m046-0023","start":23,"end":25,"surface":"季友","kind":"person","person_id":"cbr-p001244","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m046-0026","start":26,"end":27,"surface":"斑","kind":"person","person_id":"cbr-p001240","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m046-0033","start":33,"end":35,"surface":"慶父","kind":"person","person_id":"cbr-p001113","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m046-0036","start":36,"end":39,"surface":"圉人犖","kind":"person","person_id":"cbr-p001242","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m046-0040","start":40,"end":44,"surface":"魯公子斑","kind":"person","person_id":"cbr-p001240","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m046-0048","start":48,"end":50,"surface":"季友","kind":"person","person_id":"cbr-p001244","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m046-0053","start":53,"end":55,"surface":"慶父","kind":"person","person_id":"cbr-p001113","status":"contextual_provisional"},{"