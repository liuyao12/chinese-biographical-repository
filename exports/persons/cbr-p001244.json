i-033-lu:p049","chapter_id":"c-shiji-033-lu"},{"id":"c-shiji-033-lu:m050-0010","start":10,"end":12,"surface":"季友","kind":"person","person_id":"cbr-p001244","status":"contextual_provisional","paragraph_id":"c-shiji-033-lu:p050","chapter_id":"c-shiji-033-lu"},{"id":"c-shiji-033-lu:m050-0013","start":13,"end":15,"surface":"季友","kind":"person","person_id":"cbr-p001244","status":"contextual_provisional","paragraph_id":"c-shiji-033-lu:p050","chapter_id":"c-shiji-033-lu"},{"id":"c-shiji-033-lu:m078-0028","start":28,"end":30,"surface":"季友","kind":"person","person_id":"cbr-p001244","status":"contextual_provisional","paragraph_id":"c-shiji-033-lu:p078","chapter_id":"c-shiji-033-lu"}],"relations":[{"id":"a-shiji033-030","subject_person_id":"cbr-p001244","predicate":"brother","object_person_id":"cbr-p001106","status":"source_attested","evidence":[{"chapter_id":"c-shiji-033-lu","source_id":"s-shiji-033-lu","paragraph_id":"c-shiji-033-lu:p045","quote":"莊公有三弟，長曰慶父，次曰叔牙，次曰季友。莊公取齊女爲夫人曰哀姜。哀姜無子。哀姜娣曰叔姜，生子開。莊公無適嗣，愛孟女，欲立其子斑。莊公病，而問嗣於弟叔牙。叔牙曰：『一繼一及，魯之常也。慶父在，可爲嗣，君何憂？』莊公患叔牙欲立慶父，退而問季友。季友曰：『請以死立斑也。』莊公曰：『曩者叔牙欲立慶父，柰何？』季友以莊公命命牙待於鍼巫氏，使鍼季劫飲叔牙以鴆，曰：『飲此則有後奉祀；不然，死且無後。』牙遂飲鴆而死，魯立其子爲叔孫氏。八月癸亥，莊公卒，季友竟立子斑爲君，如莊公命。侍喪，舍于黨氏。"}],"qualifiers":{"source_term":"三弟，次曰","historicity":"historical_tradition"},"interpretation_note":"逐項保存本文子、父、母、弟、兄、娣及妻妾的記載。賤妾不改稱夫人；不以繼位、後裔氏族或私通補親屬。原文生子允承接惠公自妻宋女，並非由攝政或繼位推父子。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji033-038","subject_person_id":"cbr-p001244","predicate":"mother","object_person_id":"cbr-p001249","status":"source_attested","evidence":[{"chapter_id":"c-shiji-033-lu","source_id":"s-shiji-033-lu","paragraph_id":"c-shiji-033-lu:p049","quote":"季友母陳女，故亡在陳，陳故佐送季友及子申。季友之將生也，父魯桓公使人卜之，曰：『男也，其名曰「友」，閒于兩社，爲公室輔。季友亡，則魯不昌。』及生，有文在掌曰『友』，遂以名之，號爲成季。其後爲季氏，慶父後爲孟氏也。"}],"qualifiers":{"source_term":"母陳女","historicity":"historical_tradition"},"interpretation_note":"逐項保存本文子、父、母、弟、兄、娣及妻妾的記載。賤妾不改稱夫人；不以繼位、後裔氏族或私通補親屬。原文生子允承接惠公自妻宋女，並非由攝政或繼位推父子。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji033-039","subject_person_id":"cbr-p001244","predicate":"father","object_person_id":"cbr-p000229","status":"source_attested","evidence":[{"chapter_id":"c-shiji-033-lu","source_id":"s-shiji-033-lu","paragraph_id":"c-shiji-033-lu:p049","quote":"季友母陳女，故亡在陳，陳故佐送季友及子申。季友之將生也，父魯桓公使人卜之，曰：『男也，其名曰「友」，閒于兩社，爲公室輔。季友亡，則魯不昌。』及生，有文在掌曰『友』，遂以名之，號爲成季。其後爲季氏，慶父後爲孟氏也。"}],"qualifiers":{"source_term":"父魯桓公","historicity":"historical_tradition"},"interpretation_note":"逐項保存本文子、父、母、弟、兄、娣及妻妾的記載。賤妾不改稱夫人；不以繼位、後裔氏族或私通補親屬。原文生子允承接惠公自妻宋女，並非由攝政或繼位推父子。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji033-022","person_id":"cbr-p001244","title":"相","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-033-lu","source_id":"s-shiji-033-lu","paragraph_id":"c-shiji-033-lu:p050","quote":"釐公元年，以汶陽鄪封季友。季友爲相。"}],"attestations":[{"id":"th-shiji033-022:a001","paragraph_id":"c-shiji-033-lu:p050","start":16,"end":17,"surface":"相","person_mention_id":"c-shiji-033-lu:m050-0010","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"釐公元年封汶陽鄪與為相分開；為相只錄職事用稱，不虛構爵名、任命令或任職終點。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji033-046","person_id":"cbr-p001244","title":"上卿","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-033-lu","source_id":"s-shiji-033-lu","paragraph_id":"c-shiji-033-lu:p078","quote":"季友有大功於魯，受鄪爲上卿，至于文子、武子，世增其業。"}],"attestations":[{"id":"th-shiji033-046:a001","paragraph_id":"c-shiji-033-lu:p078","start":39,"end":41,"surface":"上卿","person_mention_id":"c-shiji-033-lu:m078-0028","usage":"retrospective"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-033-lu","source_id":"s-shiji-033-lu","paragraph_id":"c-shiji-033-lu:p078","quote":"季友有大功於魯，受鄪爲上卿，至于文子、武子，世增其業。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"史墨引述季友受鄪為上卿，授予事件為回述，不能以定公立的說話日期當季友初任日。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji033-078","person_id":"cbr-p001244","surfaces":["友","季友","成季"],"scope":"same_chapter","chapter_ids":["c-shiji-033-lu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-033-lu:p045","quote":"莊公有三弟，長曰慶父，次曰叔牙，次曰季友。莊公取齊女爲夫人曰哀姜。哀姜無子。哀姜娣曰叔姜，生子開。莊公無適嗣，愛孟女，欲立其子斑。莊公病，而問嗣於弟叔牙。叔牙曰：『一繼一及，魯之常也。慶父在，可爲嗣，君何憂？』莊公患叔牙欲立慶父，退而問季友。季友曰：『請以死立斑也。』莊公曰：『曩者叔牙欲立慶父，柰何？』季友以莊公命命牙待於鍼巫氏，使鍼季劫飲叔牙以鴆，曰：『飲此則有後奉祀；不然，死且無後。』牙遂飲鴆而死，魯立其子爲叔孫氏。八月癸亥，莊公卒，季友竟立子斑爲君，如莊公命。侍喪，舍于黨氏。"},{"paragraph_id":"c-shiji-033-lu:p046","quote":"先時慶父與哀姜私通，欲立哀姜娣子開。及莊公卒而季友立斑，十月己未，慶父使圉人犖殺魯公子斑於黨氏。季友奔陳。慶父竟立莊公子開，是爲湣公。"},{"paragraph_id":"c-shiji-033-lu:p047","quote":"湣公二年，慶父與哀姜通益甚。哀姜與慶父謀殺湣公而立慶父。慶父使卜齮襲殺湣公於武闈。季友聞之，自陳與湣公弟申如邾，請魯求內之。魯人欲誅慶父。慶父恐，奔莒。於是季友奉子申入，立之，是爲釐公。"},{"paragraph_id":"c-shiji-033-lu:p048","quote":"釐公亦莊公少子。哀姜恐，奔邾。季友以賂如莒求慶父，慶父歸，使人殺慶父，慶父請奔，弗聽，乃使大夫奚斯行哭而往。慶父聞奚斯音，乃自殺。齊桓公聞哀姜與慶父亂以危魯，及召之邾而殺之，以其尸歸，戮之魯。魯釐公請而葬之。"},{"paragraph_id":"c-shiji-033-lu:p049","quote":"季友母陳女，故亡在陳，陳故佐送季友及子申。季友之將生也，父魯桓公使人卜之，曰：『男也，其名曰「友」，閒于兩社，爲公室輔。季友亡，則魯不昌。』及生，有文在掌曰『友』，遂以名之，號爲成季。其後爲季氏，慶父後爲孟氏也。"},{"paragraph_id":"c-shiji-033-lu:p050","quote":"釐公元年，以汶陽鄪封季友。季友爲相。"},{"paragraph_id":"c-shiji-033-lu:p078","quote":"定公立，趙簡子問史墨曰：『季氏亡乎？』史墨對曰：『不亡。季友有大功於魯，受鄪爲上卿，至于文子、武子，世增其業。魯文公卒，東門遂殺適立庶，魯君於是失國政。政在季氏，於今四君矣。民不知君，何以得國！是以爲君慎器與名，不可以假人。』"}],"rationale":"按懿公被弒至魯文公的敘事角色、同段明示子／弟與柯盟、齊襄公殺魯桓公、晉立惠公等具體事件暫定異稱；同字爵稱依國別分開。公子揮不與前篇公子翚、晉襄父不與晉襄公、宣伯不與叔孫宣伯自動合併。數位疑讀與親屬異說仍待核對。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-033-lu:p045","text":"莊公有三弟，長曰慶父，次曰叔牙，次曰季友。莊公取齊女爲夫人曰哀姜。哀姜無子。哀姜娣曰叔姜，生子開。莊公無適嗣，愛孟女，欲立其子斑。莊公病，而問嗣於弟叔牙。叔牙曰：『一繼一及，魯之常也。慶父在，可爲嗣，君何憂？』莊公患叔牙欲立慶父，退而問季友。季友曰：『請以死立斑也。』莊公曰：『曩者叔牙欲立慶父，柰何？』季友以莊公命命牙待於鍼巫氏，使鍼季劫飲叔牙以鴆，曰：『飲此則有後奉祀；不然，死且無後。』牙遂飲鴆而死，魯立其子爲叔孫氏。八月癸亥，莊公卒，季友竟立子斑爲君，如莊公命。侍喪，舍于黨氏。","annotation_status":"named_mentions_first_pass","text_la