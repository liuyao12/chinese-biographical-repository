son","person_id":"3ea_uzt_2n2_A","status":"contextual_provisional","paragraph_id":"c-jinshu-032-he-empress:line055","chapter_id":"c-jinshu-032-he-empress"},{"id":"c-jinshu-032-he-empress:line055:m0036","start":36,"end":37,"surface":"后","kind":"person","person_id":"3ea_uzt_2n2_A","status":"contextual_provisional","paragraph_id":"c-jinshu-032-he-empress:line055","chapter_id":"c-jinshu-032-he-empress"},{"id":"c-jinshu-032-he-empress:line055:m0063","start":63,"end":67,"surface":"何氏女子","kind":"person","person_id":"3ea_uzt_2n2_A","status":"contextual_provisional","paragraph_id":"c-jinshu-032-he-empress:line055","chapter_id":"c-jinshu-032-he-empress"},{"id":"c-jinshu-032-he-empress:line055:m0073","start":73,"end":74,"surface":"后","kind":"person","person_id":"3ea_uzt_2n2_A","status":"contextual_provisional","paragraph_id":"c-jinshu-032-he-empress:line055","chapter_id":"c-jinshu-032-he-empress"},{"id":"c-jinshu-032-he-empress:line055:m0100","start":100,"end":101,"surface":"后","kind":"person","person_id":"3ea_uzt_2n2_A","status":"contextual_provisional","paragraph_id":"c-jinshu-032-he-empress:line055","chapter_id":"c-jinshu-032-he-empress"},{"id":"c-jinshu-032-he-empress:line055:m0146","start":146,"end":147,"surface":"后","kind":"person","person_id":"3ea_uzt_2n2_A","status":"contextual_provisional","paragraph_id":"c-jinshu-032-he-empress:line055","chapter_id":"c-jinshu-032-he-empress"},{"id":"c-songshu-092-wangzhenzhi:line014:m0306","start":306,"end":312,"surface":"晉穆帝何皇后","kind":"person","person_id":"3ea_uzt_2n2_A","status":"contextual_provisional","paragraph_id":"c-songshu-092-wangzhenzhi:line014","chapter_id":"c-songshu-092-wangzhenzhi"}],"relations":[{"id":"a-jinshu032-he-empress-father","subject_person_id":"3ea_uzt_2n2_A","predicate":"father","object_person_id":"3ea_uzt_2n2","status":"source_attested","qualifiers":{"source_term":"父準","lineage":"paternal"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-032","source_id":"s-jinshu-032-he-empress","chapter_id":"c-jinshu-032-he-empress","paragraph_id":"c-jinshu-032-he-empress:line053","quote":"穆章何皇后諱法倪，廬江灊人也。父準，見《外戚傳》。以名家膺選。升平元年八月，下璽書曰：「皇帝咨前太尉參軍何琦：混元資始，肇經人倫，爰及夫婦，以奉天地宗廟社稷。謀于公卿，咸以宜率由舊典。今使使持節太常彪之、宗正綜，以禮納采。」琦答曰：「前太尉參軍、都鄉侯糞土臣何琦稽首頓首再拜。皇帝嘉命，訪婚陋族，備數採擇。臣從祖弟故散騎侍郎準之遺女，未閑教訓，衣履若如人。欽承舊章，肅奉典制。」又使兼太保、武陵王晞，兼太尉、中領軍洽，持節奉冊立為皇后。","subject_person_mention_id":"c-jinshu-032-he-empress:line053:m0000","object_person_mention_id":"c-jinshu-032-he-empress:line053:m0016"}],"reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-song092-he-empress","person_id":"3ea_uzt_2n2_A","surfaces":["晉穆帝何皇后"],"scope":"same_chapter","chapter_ids":["c-songshu-092-wangzhenzhi"],"status":"contextual_provisional","confidence_level":"high","identification_basis":{"kind":"source_context","target_mention_ids":["c-songshu-092-wangzhenzhi:line014:m0306"]},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-092","source_id":"s-songshu-092-wangzhenzhi","chapter_id":"c-songshu-092-wangzhenzhi","paragraph_id":"c-songshu-092-wangzhenzhi:line014","quote":"鎮之初為琅邪王衞軍行參軍，出補剡、上虞令，並有能名。內史謝輶請為山陰令，復有殊績。遷衞軍參軍，本國郎中令，加寧朔將軍。桓玄輔晉，以為大將軍錄事參軍。時三吳飢荒，遣鎮之銜命賑卹，而會稽內史王愉不奉符旨，鎮之依事糾奏。愉子綏，玄之外甥，當時貴盛，鎮之為所排抑，以母老求補安成太守。及玄敗，玄將苻宏寇亂郡境，鎮之拒戰彌年，子弟五人，並臨陣見殺。母憂去職，在官清潔，妻子無以自給，乃棄家致喪還上虞舊墓。葬畢，為子標之求安復令，隨子之官。服闋，為征西道規司馬、南平太守。徐道覆逼江陵，加鎮之建威將軍，統檀道濟、到彥之等討道覆，以不經將帥，固辭，不見聽。既而前軍失利，白衣領職，尋復本官。以討道覆功，封華容縣五等男，徵廷尉。晉穆帝何皇后山陵，領將作大匠。遷御史中丞，秉正不撓，百僚憚之。"}],"rationale":"晉書后妃傳明載穆章何皇后諱法倪，按君主與皇后氏稱辨同人。宋傳山陵任職的敘次與后傳卒年須分開處理，不藉同人辨識補領將作大匠年份。","references":[{"title":"《晉書》卷32何皇后正文","url":"https://zh.wikisource.org/w/index.php?oldid=1543614","source_revision":1543614,"quote":"穆章何皇后諱法倪，廬江灊人也。父準","source_position":{"first_line":53,"last_line":53},"wikitext_sha256":"82cd88cad08dac2b1bbb57371dc460a43806730b4da42c143f041374bd6866c5","image_verified":false}],"human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-032-he-empress:line053","text":"穆章何皇后諱法倪，廬江灊人也。父準，見《外戚傳》。以名家膺選。升平元年八月，下璽書曰：「皇帝咨前太尉參軍何琦：混元資始，肇經人倫，爰及夫婦，以奉天地宗廟社稷。謀于公卿，咸以宜率由舊典。今使使持節太常彪之、宗正綜，以禮納采。」琦答曰：「前太尉參軍、都鄉侯糞土臣何琦稽首頓首再拜。皇帝嘉命，訪婚陋族，備數採擇。臣從祖弟故散騎侍郎準之遺女，未閑教訓，衣履若如人。欽承舊章，肅奉典制。」又使兼太保、武陵王晞，兼太尉、中領軍洽，持節奉冊立為皇后。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-032-he-empress:line053:m0000","start":0,"end":5,"surface":"穆章何皇后","kind":"person","person_id":"3ea_uzt_2n2_A","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line053:m0006","start":6,"end":8,"surface":"法倪","kind":"person","person_id":"3ea_uzt_2n2_A","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line053:m0016","start":16,"end":17,"surface":"準","kind":"person","person_id":"3ea_uzt_2n2","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line053:m0044","start":44,"end":46,"surface":"皇帝","kind":"person","person_id":"84i_4jp_gmc","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line053:m0052","start":52,"end":54,"surface":"何琦","kind":"person","person_id":"id8_z9e_jaw","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line053:m0099","start":99,"end":101,"surface":"彪之","kind":"person","person_id":"7r6_k52_qji_ABDBB","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line053:m0104","start":104,"end":105,"surface":"綜","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"待平行原文確認具體身份；保留原稱。"},{"id":"c-jinshu-032-he-empress:line053:m0112","start":112,"end":113,"surface":"琦","kind":"person","person_id":"id8_z9e_jaw","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line053:m0129","start":129,"end":131,"surface":"何琦","kind":"person","person_id":"id8_z9e_jaw","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line053:m0138","start":138,"end":140,"surface":"皇帝","kind":"person","person_id":"84i_4jp_gmc","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line053:m0162","start":162,"end":163,"surface":"準","kind":"person","person_id":"3ea_uzt_2n2","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line053:m0195","start":195,"end":199,"surface":"武陵王晞","kind":"person","person_id":"dkn_ge4_286_AAAAAAAD","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line053:m0207","start":207,"end":208,"surface":"洽","kind":"person","person_id":"7r6_k52_qji_ABAAA","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line053:m0215","start":215,"end":217,"surface":"皇后","kind":"person","person_id":"3ea_uzt_2n2_A","status":"contextual_provisional"}],"source_position":{"first_line":53,"last_line":53,"revision_id":1543614,"editorial_excerpt_boundary":false},"chapter_id":"c-jinshu-032-he-empress","book_id":"b-jinshu-032","work_id":"w-jinshu","source_id":"s-jinshu-032-he-empress"},{"id":"c-jinshu-032-he-empress:line055","text":"后無子。哀帝即位，稱穆皇后，居永安宮。桓玄篡位，移后入司徒府。路經太廟，后停輿慟哭，哀感路人。玄聞而怒曰：「天下禪代常理，何預何氏女子事耶！」乃降后為零陵縣君。與安帝俱西，至巴陵。及劉裕建義，殷仲文奉后還京都，下令曰：「戎車屢警，黎元阻饑。而膳御豐靡，豈與百姓同其儉約。減損供給，勿令游過。」后時以遠還，欲奉拜陵廟。有司以寇難未平，奏停。元興三年崩，年六十六，在位凡四十八年。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-032-he-empress:line055:m0000","start":0,"end":1,"surface":"后","kind":"person","person_id":"3ea_uzt_2n2_A","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line055:m0004","start":4,"end":6,"surface":"哀帝","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"待平行原文確認具體身份；保留原稱。"},{"id":"c-jinshu-032-he-empress:line055:m0010","start":10,"end":13,"surface":"穆皇后","kind":"person","person_id":"3ea_uzt_2n2_A","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line055:m0019","start":19,"end":21,"surface":"桓玄","kind":"person","person_id":"lf6_f95_379","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line055:m0025","start":25,"end":26,"surface":"后","kind":"person","person_id":"3ea_uzt_2n2_A","status":"contextual_provisional"},{"