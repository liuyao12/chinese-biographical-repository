icate":"father","object_person_id":"cbr-p002210","status":"source_attested","evidence":[{"chapter_id":"c-shiji-042-zheng","source_id":"s-shiji-042-zheng","paragraph_id":"c-shiji-042-zheng:p048","quote":"獻公十三年卒，子聲公勝立。當是時，晉六卿彊，侵奪鄭，鄭遂弱。"}],"qualifiers":{"source_term":"獻公十三年卒，子聲公勝立","historicity":"historical_tradition"},"interpretation_note":"依明示子、少子及弟保存來源主張，繼位不獨作父子，如兄弟不作血親；不補母名、年代或同父同母。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji042-042","subject_person_id":"cbr-p002218","predicate":"father","object_person_id":"cbr-p002211","status":"source_attested","evidence":[{"chapter_id":"c-shiji-042-zheng","source_id":"s-shiji-042-zheng","paragraph_id":"c-shiji-042-zheng:p053","quote":"三十七年，聲公卒，子哀公易立。"}],"qualifiers":{"source_term":"聲公卒，子哀公易立","historicity":"historical_tradition"},"interpretation_note":"依明示子、少子及弟保存來源主張，繼位不獨作父子，如兄弟不作血親；不補母名、年代或同父同母。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji042-043","subject_person_id":"cbr-p002219","predicate":"brother","object_person_id":"cbr-p002211","status":"source_attested","evidence":[{"chapter_id":"c-shiji-042-zheng","source_id":"s-shiji-042-zheng","paragraph_id":"c-shiji-042-zheng:p054","quote":"哀公八年，鄭人弒哀公而立聲公弟丑，是爲共公。共公三年，三晉滅知伯。三十一年，共公卒，子幽公已立。幽公元年，韓武子伐鄭，殺幽公。鄭人立幽公弟駘，是爲繻公。"}],"qualifiers":{"source_term":"聲公弟丑","historicity":"historical_tradition"},"interpretation_note":"依明示子、少子及弟保存來源主張，繼位不獨作父子，如兄弟不作血親；不補母名、年代或同父同母。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji042-117","person_id":"cbr-p002211","scope":"same_chapter","chapter_ids":["c-shiji-042-zheng"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["聲公","聲公勝"],"evidence":[{"paragraph_id":"c-shiji-042-zheng:p048","quote":"獻公十三年卒，子聲公勝立。當是時，晉六卿彊，侵奪鄭，鄭遂弱。"},{"paragraph_id":"c-shiji-042-zheng:p049","quote":"聲公五年，鄭相子産卒，鄭人皆哭泣，悲之如亡親戚。子産者，鄭成公少子也。爲人仁愛人，事君忠厚。孔子嘗過鄭，與子産如兄弟云。及聞子産死，孔子爲泣曰：「古之遺愛也！」"},{"paragraph_id":"c-shiji-042-zheng:p053","quote":"三十七年，聲公卒，子哀公易立。"},{"paragraph_id":"c-shiji-042-zheng:p054","quote":"哀公八年，鄭人弒哀公而立聲公弟丑，是爲共公。共公三年，三晉滅知伯。三十一年，共公卒，子幽公已立。幽公元年，韓武子伐鄭，殺幽公。鄭人立幽公弟駘，是爲繻公。"}],"rationale":"依本篇名字、是為、世系及連續事件暫接異稱；同諡不同國分開，建子勝與聲公勝不合併，如兄弟為譬喻不作親屬。述贊與正文不算獨立來源，省稱、古字與校勘仍待核。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-042-zheng:p048","text":"獻公十三年卒，子聲公勝立。當是時，晉六卿彊，侵奪鄭，鄭遂弱。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-042-zheng:m048-0000","start":0,"end":2,"surface":"獻公","kind":"person","person_id":"cbr-p002210","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m048-0008","start":8,"end":11,"surface":"聲公勝","kind":"person","person_id":"cbr-p002211","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m048-0017","start":17,"end":20,"surface":"晉六卿","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、述贊省稱、譬喻或未定指代保留，不補姓名或關係。"}],"chapter_id":"c-shiji-042-zheng","book_id":"b-shiji-042","work_id":"w-shiji","source_id":"s-shiji-042-zheng"},{"id":"c-shiji-042-zheng:p049","text":"聲公五年，鄭相子産卒，鄭人皆哭泣，悲之如亡親戚。子産者，鄭成公少子也。爲人仁愛人，事君忠厚。孔子嘗過鄭，與子産如兄弟云。及聞子産死，孔子爲泣曰：「古之遺愛也！」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-042-zheng:m049-0000","start":0,"end":2,"surface":"聲公","kind":"person","person_id":"cbr-p002211","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m049-0007","start":7,"end":9,"surface":"子産","kind":"person","person_id":"cbr-p002190","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m049-0024","start":24,"end":26,"surface":"子産","kind":"person","person_id":"cbr-p002190","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m049-0028","start":28,"end":31,"surface":"鄭成公","kind":"person","person_id":"cbr-p002177","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m049-0046","start":46,"end":48,"surface":"孔子","kind":"person","person_id":"cbr-p002212","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m049-0053","start":53,"end":55,"surface":"子産","kind