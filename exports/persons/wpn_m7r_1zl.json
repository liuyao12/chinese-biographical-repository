assage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-chenshu-017-yuanjing-complete-ws1544244"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-chen017-jing-brother-mi","subject_person_id":"hb9_2gq_205_B","object_person_id":"wpn_m7r_1zl","predicate":"brother","qualifiers":{"source_term":"弟泌"},"evidence":[{"work_id":"w-chenshu","book_id":"b-chenshu-017","chapter_id":"c-chenshu-017-yuanjing-complete","source_id":"s-chenshu-017-yuanjing-complete-ws1544244","paragraph_id":"c-chenshu-017-yuanjing-complete:p002","quote":"敬純孝有風格，幼便篤學，老而無倦。釋褐祕書郎，累遷太子舍人、洗馬、中舍人。江陵淪覆，流寓嶺表。高祖受禪，敬在廣州，依歐陽頠。及頠卒，其子紇據州，將有異志，敬累諫紇，為陳逆順之理，言甚切至，紇終不從。高宗即位，遣章昭達率红討紇，紇將敗之時，恨不納敬言。朝廷義之，其年徵為太子中庶子、通直散騎常侍。俄轉司徒左長史。尋遷左民尚書，轉都官尚書，領豫州大中正。累遷太常卿、散騎常侍、金紫光祿大夫，加特進。至德三年卒，時年七十九，贈左光祿大夫，諡曰靖德。子元友嗣。弟泌自有傳。兄子樞。","subject_person_mention_id":"c-chenshu-017-yuanjing-complete:p002:m0000","object_person_mention_id":"c-chenshu-017-yuanjing-complete:p002:m0227"}],"status":"source_attested","interpretation_note":"敬之弟泌，另見《陳書》卷十八。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-chenshu-017-yuanjing-complete:p002:m0227","start":227,"end":228,"surface":"泌","kind":"person","person_id":"wpn_m7r_1zl","status":"contextual_provisional","paragraph_id":"c-chenshu-017-yuanjing-complete:p002","chapter_id":"c-chenshu-017-yuanj