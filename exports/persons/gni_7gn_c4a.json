,2189,2190,2191,2192,2193,2194,2195,2196,2197,2198,2199,2200,2201,2202,2203,2204,2205,2206,2207,2208,2209,2210,2211,2212,2213,2214,2215,2216,2217,2218,2219,2220,2221,2222,2223,2224,2225,2226,2227,2228,2229,2230,2231,2232,2233,2234,2235,2236,2237,2238,2239,2240,2241,2242,2243,2244,2245,2246,2247,2248,2249,2250,2251,2252,2253,2254,2255,2256,2257,2258,2259,2260,2261,2262,2263,2264,2265,2266,2267,2268,2269,2270,2271,2272,2273,2274,2275,2276,2277,2278,2279,2280,2281,2282,2283,2284,2285,2286,2287,2288,2289,2290,2291,2292,2293,2294,2295,2296,2297,2298,2299,2300,2301,2302,2303,2304,2305,2306],"projection_sha256":"a6645f373b5339f0649f322c84f865d643d7fba44fdaa4265adcc53edac7c4b5","editorial_excerpt_boundary":true},"chapter_id":"c-liangshu-033-wangsengru","book_id":"b-liangshu-033","work_id":"w-liangshu","source_id":"s-liangshu-033-wangsengru-ws1514481"},{"id":"c-shiji-112-pingjin:p005","text":"元朔三年，張歐免，以弘為御史大夫。是時通西南夷，東置滄海，北筑朔方之郡。弘數諫，以為罷敝中國以奉無用之地，願罷之。於是天子乃使朱買臣等難弘置朔方之便。發十策，弘不得一。弘乃謝曰：「山東鄙人，不知其便若是，願罷西南夷、滄海而專奉朔方。」上乃許之。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-112-pingjin:m005-0005","start":5,"end":7,"surface":"張歐","kind":"person","person_id":"afj_vl8_7fu_A","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m005-0010","start":10,"end":11,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m005-0036","start":36,"end":37,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m005-0059","start":59,"end":61,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m005-0063","start":63,"end":66,"surface":"朱買臣","kind":"person","person_id":"gni_7gn_c4a","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m005-0068","start":68,"end":69,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m005-0079","start":79,"end":80,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m005-0084","start":84,"end":85,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m005-0117","start":117,"end":118,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"}],"chapter_id":"c-shiji-112-pingjin","book_id":"b-shiji-112","work_id":"w-shiji","source_id":"s-shiji112-pingjin"},{"id":"c-shiji-112-pingjin:p030","text":"班固稱曰：公孫弘、卜式、兒寬皆以鴻漸之翼困於燕雀，遠跡羊豕之閒，非遇其時，焉能致此位乎？是時漢興六十餘載，海內乂安，府庫充實，而四夷未賓，制度多闕，上方欲用文武，求之如弗及。始以蒲輪迎枚生，見主父而嘆息。群臣慕向，異人并出。卜式試於芻牧，弘羊擢於賈豎，衛青奮於奴仆，日磾出於降虜，斯亦曩時版筑飯牛之朋矣。漢之得人，於茲為盛。儒雅則公孫弘、董仲舒、兒寬，篤行則石建、石慶，質直則汲黯、卜式，推賢則韓安國、鄭當時，定令則趙禹、張湯，文章則司馬遷、相如，滑稽則東方朔、枚皋，應對則嚴助、朱買臣，歷數則唐都、落下閎，協律則李延年，運籌則桑弘羊，奉使則張騫、蘇武，將帥則衛青、霍去病，受遺則霍光、金日磾。其餘不可勝紀。是以興造功業，制度遺文，後世莫及。孝宣承統，纂修洪業，亦講論六藝，招選茂異，而蕭望之、梁丘賀、夏侯勝、韋玄成、嚴彭祖、尹更始以儒術進，劉向、王褒以文章顯。將相則張安世、趙充國、魏相、邴吉、于定國、杜延年，治民則黃霸、王成、龔遂、鄭弘、邵信臣、韓延壽、尹翁歸、趙廣漢之屬，皆有功跡見述於後。累其名臣，亦其次也。","annotation_status":"in_progress","text_layer":"witness_appended_bangu_note","mentions":[{"id":"c-shiji-112-pingjin:m030-0000","start":0,"end":2,"surface":"班固","kind":"person","person_id":"gxd_15x_9d0","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0005","start":5,"end":8,"surface":"公孫弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0009","start":9,"end":11,"surface":"卜式","kind":"person","person_id":"h6s_hqj_u6k","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0012","start":12,"end":14,"surface":"兒寬","kind":"person","person_id":"x8r_9sk_d7a","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0074","start":74,"end":75,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0092","start":92,"end":94,"surface":"枚生","kind":"person","