外每所陳説多見從之建安末從太祖征呉斐隨行自以家牛羸困乃私易官牛為人所白被収送獄奪官其後太祖問斐曰文侯印綬所在斐亦知見戯對曰以易餅耳太祖笑顧謂左右曰東曹毛椽數白此家欲令我重治我非不知此人不清良有以也我之有斐譬如人家有盗狗而善捕鼠盗雖有小損而完我嚢貯遂復斐官聼用如初後數嵗病亡謐少不肯交㳺但博觀書傳為人沈毅頗有才略太和中常住鄴借人空屋居其中而諸王亦欲借之不知謐已得直開門入謐望見王交脚卧而不起而呼其奴客曰此何等人促呵使去王怒其無禮還具上言明帝収謐繫鄴獄以其功臣子原出後帝聞其有父風召拜度支郎中曹爽宿與相親時爽為武衛将軍數為帝稱其可大用會帝崩爽輔政乃拔謐為散騎常侍遂轉尚書謐為人外似踈畧而内多忌其在臺閣有所弹駮臺中患之事不得行又其意輕貴多所忽畧雖與何晏鄧颺等同位而皆少之唯以勢屈於爽爽亦敬之言無不從故于時謗書謂臺中有三狗二狗崖柴不可當一狗憑黙作疽嚢三狗謂何鄧丁也黙者爽小字也其意言三狗皆欲嚙人而謐尤甚也奏使郭太后出居别宫及遣樂安王使北詣鄴又遣文欽令還淮南皆謐之計司馬宣王由是特深恨之","mentions":[{"id":"c-sanguozhi-009-caozhen:p030:m0003","start":3,"end":5,"surface":"丁謐","kind":"person","person_id":"0yu_ze0_8wq","status":"contextual_provisional","interpretation_note":"完整曹真曹爽敘事與本段引文語境辨識；AI判讀，未圖校。"},{"id":"c-sanguozhi-009-caozhen:p030:m0006","start":6,"end":8,"surface":"彦靖","kind":"person","person_id":"0yu_ze0_8wq","status":"contextual_provisional","interpretation_note":"完整曹真曹爽敘事與本段引文語境辨識；AI判讀，未圖校。"},{"id":"c-sanguozhi-009-caozhen:p030:m0009","start":9,"end":10,"surface":"斐","kind":"person","person_id":"2xp_fkz_t3s","status":"contextual_provisional","interpretation_note":"完整曹真曹爽敘事與本段引文語境辨識；AI判讀，未圖校。"},{"id":"c-sanguozhi-009-caozhen:p030:m0011","start":11,"end":13,"surface":"文侯","kind":"person","person_id":"2xp_fkz_t3s","status":"contextual_provisional","interpretation_note":"完整曹真曹爽敘事與本段引文語境辨識；AI判讀，未圖校。"},{"id":"c-sanguozhi-009-caozhen:p030:m0014","start":14,"end":15,"surface":"斐","kind":"person","person_id":"2xp_fkz_t3s","status":"contextual_provisional","interpretation_note":"完整曹真曹爽敘事與本段引文語境辨識；AI判讀，未圖校。"},{"id":"c-sanguozhi-009-caozhen:p030:m0016","start":16,"end":18,"surface":"太祖","kind":"person","person_id":"dad_b77_b38","status":"contextual_provisional","interpretation_note":"完整曹真曹爽敘事與本段引文語境辨識；AI判讀，未圖校。"},{"id":"c-sanguozhi-009-caozhen:p030:m0018","start":18,"end":20,"surface":"太祖","kind":"person","person_id":"dad_b77_b38","status":"contextual_provisional","interpretation_note":"完整曹真曹爽敘事與本段引文語境辨識；AI判讀，未圖校。"},{"id":"c-sanguozhi-009-caozhen:p030:m0021","start":21,"end":22,"surface":"斐","kind":"person","person_id":"