{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004680","identity_policy":"contextual_provisional","person_ids":["cbr-p004680"],"persons":[{"id":"cbr-p004680","label":"栗腹（魯仲連鄒陽列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"栗腹","mention_ids":["c-shiji-083-luzou:m012-0167"]}],"evidence":[{"mention_id":"c-shiji-083-luzou:m012-0167","chapter_id":"c-shiji-083-luzou","paragraph_id":"c-shiji-083-luzou:p012","quote":"栗腹"}]}],"mentions":[{"id":"c-shiji-083-luzou:m012-0167","start":167,"end":169,"surface":"栗腹","kind":"person","person_id":"cbr-p004680","status":"contextual_provisional","paragraph_id":"c-shiji-083-luzou:p012","chapter_id":"c-shiji-083-luzou"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji083-025","person_id":"cbr-p004680","scope":"same_chapter","chapter_ids":["c-shiji-083-luzou"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"依本段明示稱名與嵌套引古範圍暫定；未名者不以他篇或記憶直接補名。","surfaces":["栗腹"],"evidence":[{"paragraph_id":"c-shiji-083-luzou:p012","quote":"且楚攻齊之南陽，魏攻平陸，而齊無南面之心，以為亡南陽之害小，不如得濟北之利大，故定計審處之。今秦人下兵，魏不敢東面；衡秦之勢成，楚國之形危；齊棄南陽，斷右壤，定濟北，計猶且為之也。且夫齊之必決於聊城，公勿再計。今楚魏交退於齊，而燕救不至。以全齊之兵，無天下之規，與聊城共據期年之敝，則臣見公之不能得也。且燕國大亂，君臣失計，上下迷惑，栗腹以十萬之眾五折於外，以萬乘之國被圍於趙，壤削主困，為天下僇笑。國敝而禍多，民無所歸心。今公又以敝聊之民距全齊之兵，是墨翟之守也。食人炊骨，士無反外之心，是孫臏之兵也。能見於天下。雖然，為公計者，不如全車甲以報於燕。車甲全而歸燕，燕王必喜；身全而歸於國，士民如見父母，交游攘臂而議於世，功業可明。上輔孤主以制群臣，下養百姓以資說士，矯國更俗，功名可立也。亡意亦捐燕棄世，東游於齊乎？裂地定封，富比乎陶、衛，世世稱孤，與齊久存，又一計也。此兩計者，顯名厚實也，願公詳計而審處一焉。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-083-luzou:p012","text":"且楚攻齊之南陽，魏攻平陸，而齊無南面之心，以為亡南陽之害小，不如得濟北之利大，故定計審處之。今秦人下兵，魏不敢東面；衡秦之勢成，楚國之形危；齊棄南陽，斷右壤，定濟北，計猶且為之也。且夫齊之必決於聊城，公勿再計。今楚魏交退於齊，而燕救不至。以全齊之兵，無天下之規，與聊城共據期年之敝，則臣見公之不能得也。且燕國大亂，君臣失計，上下迷惑，栗腹以十萬之眾五折於外，以萬乘之國被圍於趙，壤削主困，為天下僇笑。國敝而禍多，民無所歸心。今公又以敝聊之民距全齊之兵，是墨翟之守也。食人炊骨，士無反外之心，是孫臏之兵也。能見於天下。雖然，為公計者，不如全車甲以報於燕。車甲全而歸燕，燕王必喜；身全而歸於國，士民如見父母，交游攘臂而議於世，功業可明。上輔孤主以制群臣，下養百姓以資說士，矯國更俗，功名可立也。亡意亦捐燕棄世，東游於齊乎？裂地定封，富比乎陶、衛，世世稱孤，與齊久存，又一計也。此兩計者，顯名厚實也，願公詳計而審處一焉。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-083-luzou:m012-0100","start":100,"end":101,"surface":"公","kind":"person","person_id":"cbr-p004677","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m012-0144","start":144,"end":145,"surface":"公","kind":"person","person_id":"cbr-p004677","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m012-0167","start":167,"end":169,"surface":"栗腹","kind":"person","person_id":"cbr-p004680","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m012-0213","start":213,"end":214,"surface":"公","kind":"person","person_id":"cbr-p004677","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m012-0227","start":227,"end":229,"surface":"墨翟","kind":"person","person_id":"cbr-p004681","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m012-0246","start":246,"end":248,"surface":"孫臏","kind":"person","person_id":"cbr-p004682","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m012-0262","start":262,"end":263,"surface":"公","kind":"person","person_id":"cbr-p004677","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m012-0283","start":283,"end":285,"surface":"燕王","kind":"person","person_id":"cbr-p004679","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m012-0299","start":299,"end":301,"surface":"父母","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、譬喻或未定指代；不依記憶補姓名與親屬。"},{"id":"c-shiji-083-luzou:m012-0318","start":318,"end":320,"surface":"孤主","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、譬喻或未定指代；不依記憶補姓名與親屬。"},{"id":"c-shiji-083-luzou:m012-0322","start":322,"end":324,"surface":"群臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、譬喻或未定指代；不依記憶補姓名與親屬。"},{"id":"c-shiji-083-luzou:m012-0327","start":327,"end":329,"surface":"百姓","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體