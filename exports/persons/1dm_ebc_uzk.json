"mentions":[{"id":"c-shiji-004-zhou:m007-0094","start":94,"end":97,"surface":"散宜生","kind":"person","person_id":"1dm_ebc_uzk","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p007","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-004-zhou:m017-0055","start":55,"end":58,"surface":"散宜生","kind":"person","person_id":"1dm_ebc_uzk","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p017","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-032-qi:m003-0055","start":55,"end":58,"surface":"散宜生","kind":"person","person_id":"1dm_ebc_uzk","status":"contextual_provisional","paragraph_id":"c-shiji-032-qi:p003","chapter_id":"c-shiji-032-qi"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji032-009","person_id":"1dm_ebc_uzk","surfaces":["散宜生"],"scope":"cross_chapter","chapter_ids":["c-shiji-004-zhou","c-shiji-032-qi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-004-zhou:p007","quote":"公季卒，子昌立，是為西伯。西伯曰文王，遵后稷、公劉之業，則古公、公季之法，篤仁，敬老，慈少。禮下賢者，日中不暇食以待士，士以此多歸之。伯夷、叔齊在孤竹，聞西伯善養老，盍往歸之。太顛、閎夭、散宜生、鬻子、辛甲大夫之徒皆往歸之。"},{"paragraph_id":"c-shiji-032-qi:p003","quote":"或曰，太公博聞，嘗事紂。紂無道，去之。游說諸侯，無所遇，而卒西歸周西伯。或曰，呂尚處士，隱海濱。周西伯拘羑里，散宜生、閎夭素知而招呂尚。呂尚亦曰「吾聞西伯賢，又善養老，盍往焉」。三人者為西伯求美女奇物，獻之於紂，以贖西伯。西伯得以出，反國。言呂尚所以事周雖異，然要之為文武師。"}],"rationale":"按本篇周初、呂尚／師尚父、齊君世系及魯桓公遇害等明示語境暫定異稱，原字與所列或曰異說保留，不按全庫同名合併。先君太公引語未連到呂尚。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-004-zhou:p007","text":"公季卒，子昌立，是為西伯。西伯曰文王，遵后稷、公劉之業，則古公、公季之法，篤仁，敬老，慈少。禮下賢者，日中不暇食以待士，士以此多歸之。伯夷、叔齊在孤竹，聞西伯善養老，盍往歸之。太顛、閎夭、散宜生、鬻子、辛甲大夫之徒皆往歸之。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-004-zhou:m007-0000","start":0,"end":2,"surface":"公季","kind":"person","person_id":"y4i_pjk_4gn","status":"source_identified"},{"id":"c-shiji-004-zhou:m007-0005","start":5,"end":6,"surface":"昌","kind":"person","person_id":"y4i_pjk_4gn_A","status":"source_i