subject_person_id":"cbr-p000445","predicate":"father","object_person_id":"cbr-p000444","status":"source_attested","evidence":[{"paragraph_id":"c-shiji-006-shihuang:p088","quote":"惠公享國十三年。葬陵圉。生出公。","chapter_id":"c-shiji-006-shihuang","source_id":"s-shiji-006-shihuang"}],"qualifiers":{"source_term":"生","historicity":"historical_tradition"},"interpretation_note":"保存卷末文本明示主張；若與本卷或前卷相反，仍分存，不推定此說較優或修改來源。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-005-qin:p052","text":"惠公十二年，子出子生。十三年，伐蜀，取南鄭。惠公卒，出子立。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m052-0000","start":0,"end":2,"surface":"惠公","kind":"person","person_id":"cbr-p000444","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m052-0007","start":7,"end":9,"surface":"出子","kind":"person","person_id":"cbr-p000445","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m052-0022","start":22,"end":24,"surface":"惠公","kind":"person","person_id":"cbr-p000444","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m052-0026","start":26,"end":28,"surface":"出子","kind":"person","person_id":"cbr-p000445","status":"contextual_provisional"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-005-qin:p053","text":"出子二年，庶長改迎靈公之子獻公于河西而立之。殺出子及其母，沈之淵旁。秦以往者數易君，君臣乖亂，故晉復彊，奪秦河西地。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m053-0000","start":0,"end":2,"surface":"出子","kind":"person","person_id":"cbr-p000445","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m053-0005","start":5,"end":8,"surface":"庶長改","kind":"person","person_id":"cbr-p000446","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m053-0009","start":9,"end":11,"surface":"靈公","kind":"person","person_id":"cbr-p000442","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m053-0013","start":13,"end":15,"surface":"獻公","kind":"person","person_id":"cbr-p000287","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m053-0023","start":23,"end":25,"surface":"出子","kind":"person","person_id":"cbr-p000445","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m053-0026","start":26,"end":28,"surface":"其母","kind":"unresolved","person_id":null,"status":"unresolved","note":"未定指代、群體或官稱；商君語為篇章指引，不當作獨立個人。"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-005-qin:p055","text":"孝公元年，河山以東彊國六，與齊威、楚宣、魏惠、燕悼、韓哀、趙成侯并。淮泗之閒小國十餘。楚、魏與秦接界。魏筑長城，自鄭濱洛以北，有上郡。楚自漢中，南有巴、黔中。周室微，諸侯力政，爭相併。秦僻在雍州，不與中國諸侯之會盟，夷翟遇之。孝公於是布惠，振孤寡，招戰士，明功賞。下令國中曰：「昔我繆公自岐雍之閒，修德行武，東平晉亂，以河為界，西霸戎翟，廣地千里，天子致伯，諸侯畢賀，為後世開業，甚光美。會往者厲、躁、簡公、出子之不寧，國家內憂，未遑外事，三晉攻奪我先君河西地，諸侯卑秦、醜莫大焉。獻公即位，鎮撫邊境，徙治櫟陽，且欲東伐，復繆公之故地，修繆公之政令。寡人思念先君之意，常痛於心。賓客群臣有能出奇計彊秦者，吾且尊官，與之分土。」於是乃出兵東圍陜城，西斬戎之獂王。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m055-0000","start":0,"end":2,"surface":"孝公","kind":"person","person_id":"cbr-p000289","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m055-0014","start":14,"end":16,"surface":"齊威","kind":"person","person_id":"cbr-p000448","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m055-0017","start":17,"end":19,"surface":"楚宣","kind":"person","person_id":"cbr-p000449","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m055-0020","start":20,"end":22,"surface":"魏惠","kind":"person","person_id":"cbr-p000450","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m055-0023","start":23,"end":25,"surface":"燕悼","kind":"person","person_id":"cbr-p000451","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m055-0026","start":26,"end":28,"surface":"韓哀","kind":"person","person_id":"cbr-p000452","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m055-0029","start":29,"end":32,"surface":"趙成侯","kind":"person","person_id":"cbr-p000453","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m055-0113","start":113,"end":115,"surface":"孝公","kind":"person","person_id":"cbr-p000289","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m055-0141","start":141,"end":143,"surface":"繆公","kind":"person","person_id":"cbr-p000253","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m055-0197","start":197,"end":200,"surface":"厲、躁","kind":"unresolved","person_id":null,"status":"unresolved","note":"未定指代、群體或官稱；商君語為篇章指引，不當作獨立個人。"},{"id":"c-shiji-005-qin:m055-0201","start":201,"end":203,"surface":"簡公","kind":"person","person_id":"cbr-p000443","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m055-0204","start":204,"end":206,"surface":"出子","kind":"person","person_id":"cbr-p000445","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m055-0225","start":225,"end":227,"surface":"先君","kind":"unresolved","person_id":null,"status":"unresolved","note":"未定指代、群體或官稱；商君語為篇章指引，不當作獨立個人。"},{"id":"c-shiji-005-qin:m055-0241","start":241,"end":243,"surface":"獻公","kind":"person","person_id":"cbr-p000287","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m055-0262","start":262,"end":264,"surface":"繆公","kind":"person","person_id":"cbr-p000253","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m055-0269","start":269,"end":271,"surface":"繆公","kind":"person","person_id":"cbr-p000253","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m055-0279","start":279,"end":281,"surface":"先君","kind":"unresolved","person_id":null,"status":"unresolved","note":"未定指代、群體或官稱；商君語為篇章指引，不當作獨立個人。"},{"id":"c-shiji-005-qin:m055-0327","start":327,"end":329,"surface":"獂王","kind":"unresolved","person_id":null,"status":"unresolved","note":"未定指代、群體或官稱；商君語為篇章指引，不當作獨立個人。"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-006-shihuang:p088","text":"惠公享國十三年。葬陵圉。生出公。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shij