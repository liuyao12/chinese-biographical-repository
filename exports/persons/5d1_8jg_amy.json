lumn":"59L09","pdf_page":59,"half":"左","leaf":"十八上","column_from_right":9,"start":0,"end":21,"text":"為哀策文復見嗟賞尋出為貞威將軍臨海太守在郡"},{"column":"59L10","pdf_page":59,"half":"左","leaf":"十八上","column_from_right":10,"start":0,"end":21,"text":"被訟不調累年大同初起為雲麾豫章王長史遷秘書"},{"column":"60R01","pdf_page":60,"half":"右","leaf":"十八下","column_from_right":1,"start":0,"end":21,"text":"監五年除太府卿明年遷度支尚書中大同元年出為"},{"column":"60R02","pdf_page":60,"half":"右","leaf":"十八下","column_from_right":2,"start":0,"end":21,"text":"明威將軍永嘉太守以疾固辭徙為光祿大夫俄遷雲"},{"column":"60R03","pdf_page":60,"half":"右","leaf":"十八下","column_from_right":3,"start":0,"end":21,"text":"騎將軍司徒左長史太清二年侯景寇逼筠時不入城"},{"column":"60R04","pdf_page":60,"half":"右","leaf":"十八下","column_from_right":4,"start":0,"end":21,"text":"明年太宗卽位為太子詹事筠舊宅先為賊所焚乃寓"},{"column":"60R05","pdf_page":60,"half":"右","leaf":"十八下","column_from_right":5,"start":0,"end":21,"text":"居國子祭酒蕭子雲宅夜忽有盜攻之驚懼墜井卒時"},{"column":"60R06","pdf_page":60,"half":"右","leaf":"十八下","column_from_right":6,"start":0,"end":12,"text":"年六十九家人十餘人同遇害"}]},"chapter_id":"c-liangshu-033-wangyun-wyd","book_id":"b-liangshu-033","work_id":"w-liangshu","source_id":"s-liangshu-033-wangyun-wyd1739"},{"id":"c-liangshu-033-wangyun:p005","text":"普通元年，以母憂去職。筠有孝性，毀瘠過禮，服闋後，疾廢久之。六年，除尚書吏部郎，遷太子中庶子，領羽林監，又改領步兵。中大通二年，遷司徒左長史。三年，昭明太子薨，敕爲哀策文，復見嗟賞。尋出爲貞威將軍、臨海太守，在郡被訟，不調累年。大同初，起爲雲麾豫章王長史，遷秘書監。五年，除太府卿。明年，遷度支尚書。中大同元年，出爲明威將軍、永嘉太守，以疾固辭，徙爲光祿大夫，俄遷雲騎將軍、司徒左長史。太清二年，侯景寇逼，筠時不入城。明年，太宗卽位，爲太子詹事。筠舊宅先爲賊所焚，乃寓居國子祭酒蕭子雲宅，夜忽有盜攻之，驚懼墜井卒，時年六十九。家人十餘人同遇害。","mentions":[{"id":"c-liangshu-033-wangyun:p005:m0011","person_id":"mxz_qw8_acd_A","surface":"筠","start":11,"end":12,"kind":"person","status":"contextual_provisional","interpretation_note":"按同一見證的原字和敘事。"},{"id":"c-liangshu-033-wangyun:p005:m0198","person_id":"5d1_8jg_amy","surface":"侯景","start":198,"end":200,"kind":"person","status":"contextual_provisional","interpretation_note":"按同一見證的原字和敘事。"},{"id":"c-liangshu-033-wangyun:p005:m0203","person_id":"mxz_qw8_acd_A","surface":"筠","start":203,"end":204,"kind":"person","status":"contextual_provisional","interpretation_note":"按同一見證的原字和敘事。"},{"id":"c-liangshu-033-wangyun:p005:m0223","person_id":"mxz_qw8_acd_A","surface":"筠","start":223,"end":224,"kind":"person","status":"contextual_provisional","interpretation_note":"按同一見證的原字和敘事。"},{"id":"c-liangshu-033-wangyun:p005:u0228","person_id":null,"surface":"賊","start":228,"end":229,"kind":"unresolved","status":"unresolved","interpretation_note":"焚宅者未具名。"},{"id":"c-liangshu-033-wangyun:p005:m0239","person_id":"tjf_yzz_v3m","surface":"蕭子雲","start":239,"end":242,"kind":"person","status":"contextual_provisional","interpretation_note":"按同一見證的原字和敘事。"},{"id":"c-liangshu-033-wangyun:p005:u0247","person_id":null,"surface":"盜","start":247,"end":248,"kind":"unresolved","status":"unresolved","interpretation_note":"襲擊蕭宅者未具名。"},{"id":"c-liangshu-033-wangyun:p005:u0263","person_id":null,"surface":"家人十餘人","start":263,"end":268,"kind":"unresolved","status":"unresolved","interpretation_note":"家人逾十，確數未載，未記姓名。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":1514481,"source_layer":"received_biography","first_line":103,"last_line":103,"line_start":2,"line_end":274,"raw_start":9076,"raw_end":9348,"raw_character_offsets":[9076,9077,9078,9079,9080,9081,9082,9083,9084,9085,9086,9087,9088,9089,9090,9091,9092,9093,9094,9095,9096,9097,9098,9099,9100,9101,9102,9103,9104,9105,9106,9107,9108,9109,9110,9111,9112,9113,9114,9115,9116,9117,9118,9119,9120,9121,9122,9123,9124,9125,9126,9127,9128,9129,9130,9131,9132,9133,9134,9135,9136,9137,9138,9139,9140,9141,9142,9143,9144,9145,9146,9147,9148,9149,9150,9151,9152,9153,9154,9155,9156,9157,9158,9159,9160,9161,9162,9163,9164,9165,9166,9167,9168,9169,9170,9171,9172,9173,9174,9175,9176,9177,9178,9179,9180,9181,9182,9183,9184,9185,9186,9187,9188,9189,9190,9191,9192,9193,9194,9195,9196,9197,9198,9199,9200,9201,9202,9203,9204,9205,9206,9207,9208,9209,9210,9211,9212,9213,9214,9215,9216,9217,9218,9219,9220,9221,9222,9223,9224,9225,9226,922