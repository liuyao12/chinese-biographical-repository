","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m001-0222","start":222,"end":223,"surface":"上","kind":"person","person_id":"36n_3tt_pt4","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m001-0251","start":251,"end":252,"surface":"黯","kind":"person","person_id":"g2z_cl6_w4r","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m001-0287","start":287,"end":288,"surface":"黯","kind":"person","person_id":"g2z_cl6_w4r","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m001-0309","start":309,"end":310,"surface":"上","kind":"person","person_id":"36n_3tt_pt4","status":"contextual_provisional"}],"chapter_id":"c-shiji-120-jizheng","book_id":"b-shiji-120","work_id":"w-shiji","source_id":"s-shiji120-jizheng"},{"id":"c-shiji-120-jizheng:p016","text":"鄭莊以任俠自喜，脫張羽於緦聲聞梁楚之閒。孝景時，為太子舍人。每五日洗沐，常置驛馬安諸郊，存諸故人，請謝賓客，夜以繼日，至其明旦，常恐不遍。莊好黃老之言，其慕長者如恐不見。年少官薄，然其游知交皆其大父行，天下有名之士也。武帝立，莊稍遷為魯中尉、濟南太守、江都相，至九卿為右內史。以武安侯魏其時議，貶秩為詹事，遷為大農令。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-120-jizheng:m016-0000","start":0,"end":2,"surface":"鄭莊","kind":"person","person_id":"jws_b08_hob","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m016-0009","start":9,"end":11,"surface":"張羽","kind":"person","person_id":"68o_y46_3mf","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m016-0020","start":20,"end":22,"surface":"孝景","kind":"person","person_id":"kkh_kew_u6x","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m016-0046","start":46,"end":48,"surface":"故人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-120-jizheng:m016-0051","start":51,"end":53,"surface":"賓客","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-120-jizheng:m016-0069","start":69,"end":70,"surface":"莊","kind":"person","person_id":"jws_b08_hob","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m016-0101","start":101,"end":107,"surface":"天下有名之士","kind":"unresolved","per