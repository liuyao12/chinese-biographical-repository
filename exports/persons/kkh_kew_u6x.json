{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"kkh_kew_u6x","canonical_person_id":"kkh_kew_u6x","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["kkh_kew_u6x"],"persons":[{"id":"kkh_kew_u6x","label":"孝景帝（汲鄭列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"孝景","mention_ids":["c-shiji-120-jizheng:m001-0037","c-shiji-120-jizheng:m016-0020"]},{"surface":"孝景帝","mention_ids":["c-shiji-120-jizheng:m001-0051"]}],"evidence":[{"mention_id":"c-shiji-120-jizheng:m001-0037","chapter_id":"c-shiji-120-jizheng","paragraph_id":"c-shiji-120-jizheng:p001","quote":"孝景"},{"mention_id":"c-shiji-120-jizheng:m001-0051","chapter_id":"c-shiji-120-jizheng","paragraph_id":"c-shiji-120-jizheng:p001","quote":"孝景帝"},{"mention_id":"c-shiji-120-jizheng:m016-0020","chapter_id":"c-shiji-120-jizheng","paragraph_id":"c-shiji-120-jizheng:p016","quote":"孝景"}]}],"source_mention_summary":[{"source_id":"s-shiji120-jizheng","work_id":"w-shiji","book_id":"b-shiji-120","chapter_id":"c-shiji-120-jizheng","mention_count":3,"mention_ids":["c-shiji-120-jizheng:m001-0037","c-shiji-120-jizheng:m001-0051","c-shiji-120-jizheng:m016-0020"],"paragraph_ids":["c-shiji-120-jizheng:p001","c-shiji-120-jizheng:p016"],"passage_count":2}],"most_mentioned_source_ids":["s-shiji120-jizheng"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-shiji120-001","person_id":"kkh_kew_u6x","event_type":"death","status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-120-jizheng","source_id":"s-shiji120-jizheng","paragraph_id":"c-shiji-120-jizheng:p001","quote":"汲黯字長孺，濮陽人也。其先有寵於古之衛君。至黯七世，世為卿大夫。黯以父任，孝景時為太子洗馬，以莊見憚。孝景帝崩，太子即位，黯為謁者。東越相攻，上使黯往視之。不至，至吳而還，報曰：「越人相攻，固其俗然，不足以辱天子之使。」河內失火，延燒千餘家，上使黯往視之。還報曰：「家人失火，屋比延燒，不足憂也。臣過河南，河南貧人傷水旱萬餘家，或父子相食，臣謹以便宜，持節發河南倉粟以振貧民。臣請歸節，伏矯制之罪。」上賢而釋之，遷為滎陽令。黯恥為令，病歸田里。上聞，乃召拜為中大夫。以數切諫，不得久留內，遷為東海太守。黯學黃老之言，治官理民，好清靜，擇丞史而任之。其治，責大指而已，不苛小。黯多病，臥閨閤內不出。歲餘，東海大治。稱之。上聞，召以為主爵都尉，列於九卿。治務在無為而已，弘大體，不拘文法。","person_mention_id":"c-shiji-120-jizheng:m001-0037"}],"interpretation_note":"來源明示死亡；七歲、數歲與孝文時等敘事時間保留於原文，未反推確切公元年。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"mentions":[{"id":"c-shiji-120-jizheng:m001-0037","start":37,"end":39,"surface":"孝景","kind":"person","person_id":"kkh_kew_u6x","status":"contextual_provisional","paragraph_id":"c-shiji-120-jizheng:p001","chapter_id":"c-shiji-120-jizheng"},{"id":"c-shiji-120-jizheng:m001-0051","start":51,"end":54,"surface":"孝景帝","kind":"person","person_id":"kkh_kew_u6x","status":"contextual_provisional","paragraph_id":"c-shiji-120-jizheng:p001","chapter_id":"c-shiji-120-jizheng"},{"id":"c-shiji-120-jizheng:m016-0020","start":20,"end":22,"surface":"孝景","kind":"person","person_id":"kkh_kew_u6x","status":"contextual_provisional","paragraph_id":"c-shiji-120-jizheng:p016","chapter_id":"c-shiji-120-jizheng"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-120-jizheng:p001","text":"汲黯字長孺，濮陽人也。其先有寵於古之衛君。至黯七世，世為卿大夫。黯以父任，孝景時為太子洗馬，以莊見憚。孝景帝崩，太子即位，黯為謁者。東越相攻，上使黯往視之。不至，至吳而還，報曰：「越人相攻，固其俗然，不足以辱天子之使。」河內失火，延燒千餘家，上使黯往視之。還報曰：「家人失火，屋比延燒，不足憂也。臣過河南，河南貧人傷水旱萬餘家，或父子相食，臣謹以便宜，持節發河南倉粟以振貧民。臣請歸節，伏矯制之罪。」上賢而釋之，遷為滎陽令。黯恥為令，病歸田里。上聞，乃召拜為中大夫。以數切諫，不得久留內，遷為東海太守。黯學黃老之言，治官理民，好清靜，擇丞史而任之。其治，責大指而已，不苛小。黯多病，臥閨閤內不出。歲餘，東海大治。稱之。上聞，召以為主爵都尉，列於九卿。治務在無為而已，弘大體，不拘文法。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-120-jizheng:m001-0000","start":0,"end":2,"su