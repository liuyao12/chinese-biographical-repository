:"same_chapter","chapter_ids":["c-shiji-101-yuanchao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-101-yuanchao:p001","quote":"袁盎者，楚人也，字絲。父故為群盜，徙處安陵。高后時，盎嘗為呂祿舍人。及孝文帝即位，盎兄噲任盎為中郎。"},{"paragraph_id":"c-shiji-101-yuanchao:p002","quote":"絳侯為丞相，朝罷趨出，意得甚。上禮之恭，常自送之。袁盎進曰：「陛下以丞相何如人？」上曰：「社稷臣。」盎曰：「絳侯所謂功臣，非社稷臣，社稷臣主在與在，主亡與亡。方呂后時，諸呂用事，擅相王，劉氏不絕如帶。是時絳侯為太尉，主兵柄，弗能正。呂后崩，大臣相與共畔諸呂，太尉主兵，適會其成功，所謂功臣，非社稷臣。丞相如有驕主色。陛下謙讓，臣主失禮，竊為陛下不取也。」後朝，上益莊，丞相益畏。已而絳侯望袁盎曰：「吾與而兄善，今兒廷毀我！」盎遂不謝。"}],"rationale":"按本傳明示姓名、字及敘事承接；皇帝上字逐處依文景敘事核定，建元上另留未名。兄噲不合樊噲，兄子種不補具名父親。身份及官稱回指為代理首輪判讀，非人工覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-101-yuanchao:p001","text":"袁盎者，楚人也，字絲。父故為群盜，徙處安陵。高后時，盎嘗為呂祿舍人。及孝文帝即位，盎兄噲任盎為中郎。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-101-yuanchao:m001-0000","start":0,"end":2,"surface":"袁盎","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m001-0009","start":9,"end":10,"surface":"絲","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m001-0011","start":11,"end":12,"surface":"父","kind":"person","person_id":"j32_wtj_khz","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m001-0022","start":22,"end":24,"surface":"高后","kind":"person","person_id":"ttc_nht_1ih","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m001-0026","start":26,"end":27,"surface":"盎","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m001-0029","start":29,"end":31,"surface":"呂祿","kind":"person","person_id":"jgl_hok_5v6","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m001-0035","start":35,"end":38,"surface":"孝文帝","kind":"person","person_id":"lm7_mia_aee","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m001-0041","start":41,"end":42,"surface":"盎","kind":"person","person_id":"j32_wtj_khz_A","