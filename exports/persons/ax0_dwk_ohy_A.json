_mention_id":"c-liangshu-049-daoqia-qiuchi:p001:m0014"}],"status":"source_attested","interpretation_note":"丘遲字希範，父靈鞠。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-027-daoqia-complete:p003","text":"天監初，沼、溉俱蒙擢用，洽尤見知賞，從弟沆亦相與齊名。高祖問待詔丘遲曰：「到洽何如沆、溉？」遲對曰：「正清過於沆，文章不減溉；加以清言，殆將難及。」卽召爲太子舍人。御華光殿，詔洽及沆、蕭琛、任昉侍讌，賦二十韻詩，以洽辭爲工，賜絹二十匹。高祖謂昉曰：「諸到可謂才子。」昉對曰：「臣常竊議，宋得其武，梁得其文。」","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":30,"last_line":30,"raw_start":1492,"raw_end":1646,"raw_character_offsets":[1492,1493,1494,1495,1496,1497,1498,1499,1500,1501,1502,1503,1504,1505,1506,1507,1508,1509,1510,1511,1512,1513,1514,1515,1516,1517,1518,1519,1520,1521,1522,1523,1524,1525,1526,1527,1528,1529,1530,1531,1532,1533,1534,1535,1536,1537,1538,1539,1540,1541,1542,1543,1544,1545,1546,1547,1548,1549,1550,1551,1552,1553,1554,1555,1556,1557,1558,1559,1560,1561,1562,1563,1564,1565,1566,1567,1568,1569,1570,1571,1572,1573,1574,1575,1576,1577,1578,1579,1580,1581,1582,1583,1584,1585,1586,1587,1588,1589,1590,1591,1592,1593,1594,1595,1596,1597,1598,1599,1600,1601,1602,1603,1604,1605,1606,1607,1608,1609,1610,1611,1612,1613,1614,1615,1616,1617,1618,1619,1620,1621,1622,1623,1624,1625,1626,1627,1628,1629,1630,1631,1632,1633,1634,1635,1636,1637,1638,1639,1640,1641,1642,1643,1644,1645],"revision_id":1511478},"mentions":[{"id":"c-liangshu-027-daoqia-complete:p003:m0004","start":4,"end":5,"surface":"沼","kind":"person","person_id":"6bo_qfq_pl9_ABA","status":"contextual_provisional"},{"id":"c-liangshu-027-daoqia-complete:p003:m0006","start":6,"end":7,"surface":"溉","kind":"person","person_id":"6bo_qfq_pl9_ABB","status":"contextual_provisional"},{"id":"c-liangshu-027-daoqia-complete:p003:m0012","start":12,"end":13,"surface":"洽","