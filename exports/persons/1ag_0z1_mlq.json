ids":["c-shiji-005-qin:m009-0080"],"paragraph_ids":["c-shiji-005-qin:p009"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-004-zhou","s-shiji110-xiongnu"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-004-zhou:m042-0042","start":42,"end":44,"surface":"申侯","kind":"person","person_id":"1ag_0z1_mlq","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p042","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-004-zhou:m042-0094","start":94,"end":96,"surface":"申侯","kind":"person","person_id":"1ag_0z1_mlq","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p042","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-005-qin:m009-0080","start":80,"end":82,"surface":"申侯","kind":"person","person_id":"1ag_0z1_mlq","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p009","chapter_id":"c-shiji-005-qin"},{"id":"c-shiji-110-xiongnu:m002-0188","start":188,"end":190,"surface":"申侯","kind":"person","person_id":"1ag_0z1_mlq","status":"contextual_provisional","paragraph_id":"c-shiji-110-xiongnu:p002","chapter_id":"c-shiji-110-xiongnu"},{"id":"c-shiji-110-xiongnu:m002-0193","start":193,"end":195,"surface":"申侯","kind":"person","person_id":"1ag_0z1_mlq","status":"contextual_provisional","paragraph_id":"c-shiji-110-xiongnu:p002","chapter_id":"c-shiji-110-xiongnu"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[{"id":"eq-shiji110-ancient-shenhou","person_ids":["1ag_0z1_mlq"],"canonical_person_id":"1ag_0z1_mlq","status":"contextual_provisional","scope":"cross_chapter","chapter_ids":["c-shiji-110-xiongnu","c-shiji-004-zhou"],"rationale":"攻幽王驪山的申侯與犬戎、褒姒同事件相合；不合併秦非子時申侯或楚成王臣申侯。","evidence":[{"chapter_id":"c-shiji-110-xiongnu","source_id":"s-shiji110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p002","quote":"夏道衰，而公劉失其稷官，變于西戎，邑于豳。其後三百有餘歳，戎狄攻大王亶父，亶父亡走岐下，而豳人悉從亶父而邑焉，作周。其後百有餘歳，周西伯昌伐畎夷氏。後十有餘年，武王伐紂而營雒邑，復居于酆鄗，放逐戎夷涇、洛之北，以時入貢，命曰「荒服」。其後二百有餘年，周道衰，而穆王伐犬戎，得四白狼四白鹿以歸。自是之後，荒服不至。於是周遂作甫刑之辟。穆王之後二百有餘年，周幽王用寵姬褒姒之故，與申侯有卻。申侯怒而與犬戎共攻殺周幽王于驪山之下，遂取周之焦穫，而居于涇渭之閒，侵暴中國。秦襄公救周，於是周平王去酆鄗而東徙雒邑。當是之時，秦襄公伐戎至岐，始列爲諸侯。是後六十有五年，而山戎越燕而伐齊，齊釐公與戰于齊郊。其後四十四年，而山戎伐燕。燕告急于齊，齊桓公北伐山戎，山戎走。其後二十有餘年，而戎狄至洛邑，伐周襄王，襄王奔于鄭之氾邑。初，周襄王欲伐鄭，故娶戎狄女爲后，與戎狄兵共伐鄭。已而黜狄后，狄后怨，而襄王後母曰惠后，有子子帶，欲立之，於是惠后與狄后、子帶爲內應，開戎狄，戎狄以故得入，破逐周襄王，而立子帶爲天子。於是戎狄或居于陸渾，東至於衛，侵盜暴虐中國。中國疾之，故詩人歌之曰「戎狄是應」，「薄伐獫狁，至於大原」，「出輿彭彭，城彼朔方」。周襄王既居外四年，乃使使告急于晉。晉文公初立，欲修霸業，乃興師伐逐戎翟，誅子帶，迎內周襄王，居于雒邑。","mention_ids":["c-shiji-110-xiongnu:m002-0188","c-shiji-110-xiongnu:m002-0193"]},{"chapter_id":"c-shiji-004-zhou","source_id":"s-shiji-004-zhou","paragraph_id":"c-shiji-004-zhou:p042","quote":"幽王以虢石父為卿，用事，國人皆怨。石父為人佞巧善諛好利，王用之。又廢申后，去太子也。申侯怒，與繒、西夷犬戎攻幽王。幽王舉烽火徵兵，兵莫至。遂殺幽王驪山下，虜褒姒，盡取周賂而去。於是諸侯乃即申侯而共立故幽王太子宜臼，是為平王，以奉周祀。","mention_ids":["c-shiji-004-zhou:m042-0042","c-shiji-004-zhou:m042-0094"]}],"reviewer":"Codex（AI 代理）","model":null,"human_reviewed":false,"identity_materialized":true}],"passages":[{"id":"c-shiji-004-zhou:p042","text":"幽王以虢石父為卿，用事，國人皆怨。石父為人佞巧善諛好利，王用之。又廢申后，去太子也。申侯怒，與繒、西夷犬戎攻幽王。幽王舉烽火徵兵，兵莫至。遂殺幽王驪山下，虜褒姒，盡取周賂而去。於是諸侯乃即申侯而共立故幽王太子宜臼，是為平王，以奉周祀。","annotation_status":"in_progress","mentions":[{"id":"c-shiji-004-zhou:m042-0000","start":0,"end":2,"surface":"幽王","kind":"person","person_id":"fd5_uxa_0c9","status":"source_identified"},{"id":"c-shiji-004-zhou:m042-0003","start":3,"end":6,"surface":"虢石父","kind":"person","person_id":"6o1_fcy_vcy","status":"source_identified"},{"id":"c-shiji-004-zhou:m042-0017","start":17,"end":19,"surface":"石父","kind":"person","person_id":"6o1_fcy_vcy","status":"source_identified"},{"id":"c-shiji-004-zhou:m042-0034","start":34,"end":36,"surface":"申后","kind":"person","person_id":"wft_r8s_naw","status":"source_identified"},{"id":"c-shiji-004-zhou:m042-0042","start":42,"end":44,"surface":"申侯","kind":"person","person_id":"1ag_0z1_mlq","status":"source_identified"},{"id":"c-shiji-004-zhou:m042-0054","start":54,"end":56,"surface":"幽王","kind":"person","person_id":"fd5_uxa_0c9","status":"source_identified"},{"id":"c-shiji-004-zhou:m042-0057","start":57,"end":59,"surface":"幽王","kind":"person","person_id":"fd5_uxa_0c9","status":"source_identified"},{"id":"c-shiji-004-zhou:m042-0071","start":71,"end":73,"surface":"幽王","kind":"person","person_id":"fd5_uxa_0c9","status":"source_identified"},{"id":"c-shiji-004-zhou:m042-0078","start":78,"end":80,"surface":"褒姒","kind":"person","person_id":"rkn_3l3_3j3","status":"source_identified"},{"id":"c-shiji-004-zhou:m042-0094","start":94,"end":96,"surface":"申侯","kind":"person","person_id":"1ag_0z1_mlq","status":"source_identified"},{"id":"c-shiji-004-zhou:m042-0100","start":100,"end":102,"surface":"幽王","kind":"person","person_id":"fd5_uxa_0c9","status":"source_identified"},{"id":"c-shiji-004-zhou:m042-0102","start":102,"end":106,"surface":"太子宜臼","kind":"person","person_id":"f3g_x6y_1iy","status":"source_identified"},{"id":"c-shiji-004-zhou:m042-0109","start":109,"end":111,"surface":"平王","kind":"person","person_id":"f3g_x6y_1iy","status":"source_identified"}],"chapter_id":"c-shiji-004-zhou","book_id":"b-shiji-004","work_id":"w-shiji","source_id":"s-shiji-004-zhou"},{"id":"c-shiji-005-qin:p009","text":"襄公元年，以女弟繆嬴為豐王妻。襄公二年，戎圍犬丘，世父擊之，為戎人所虜。歲餘，復歸世父。七年春，周幽王用褒姒廢太子，立褒姒子為適，數欺諸侯，諸侯叛之。西戎犬戎與申侯伐周，殺幽王酈山下。而秦襄公將兵救周，戰甚力，有功。周避犬戎難，東徙雒邑，襄公以兵送周平王。平王封襄公為諸侯，賜之岐以西之地。曰：「戎無道，侵奪我岐、豐之地，秦能攻逐戎，即有其地。」與誓，封爵之。襄公於是始國，與諸侯通使聘享之禮，乃用騮駒、黃牛、羝羊各三，祠上帝西畤。十二年，伐戎而至岐，卒。生文公。","annotation_status":"in_progress","mentions":[{"id":"c-shiji-005-qin:m009-0000","start":0,"end":2,"surface":"襄公","kind":"person","person_id":"y97_huh_vuz","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0008","start":8,"end":10,"surface":"繆嬴","kind":"person","person_id":"p7v_f2l_8l5","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0011","start":11,"end":13,"surface":"豐王","kind":"person","person_id":"73a_qx5_k2c","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0015","start":15,"end":17,"surface":"襄公","kind":"person","person_id":"y97_huh_vuz","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0025","start":25,"end":27,"surface":"世父","kind":"person","person_id":"r9u_j0z_xtb_AAAA","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0041","start":41,"end":43,"surface":"世父","kind":"person","person_id":"r9u_j0z_xtb_AAAA","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0048","start":48,"end":51,"surface":"周幽王","kind":"person","person_id":"fd5_uxa_0c9","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0052","start":52,"end":54,"surface":"褒姒","kind":"person","person_id":"rkn_3l3_3j3","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0055","start":55,"end":57,"surface":"太子","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或未核定指代；未由熟知世系補造人物。"},{"id":"c-shiji-005-qin:m009-0059","start":59,"end":61,"surface":"褒姒","kind":"person","person_id":"rkn_3l3_3j3","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0080","start":80,"end":82,"surface":"申侯","kind":"person","person_id":"1ag_0z1_mlq","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0086","start":86,"end":88,"surface":"幽王","kind":"person","person_id":"fd5_uxa_0c9","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0093","start":93,"end":96,"surface":"秦襄公","kind":"person","person_id":"y97_huh_vuz","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0119","start":119,"end":121,"surface":"襄公","kind":"person","person_id":"y97_huh_vuz","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0124","start":124,"end":127,"surface":"周平王","kind":"person","person_id":"f3g_x6y_1iy","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0128","start":128,"end":130,"surface":"平王","kind":"person","person_id":"f3g_x6y_1iy","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0131","start":131,"end":133,"surface":"襄公","kind":"person","person_id":"y97_huh_vuz","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0180","start":180,"end":182,"surface":"襄公","kind":"person","person_id":"y97_huh_vuz","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0229","start":229,"end":231,"surface":"文公","kind":"person","person_id":"y97_huh_vuz_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-110-xiongnu:p002","text":"夏道衰，而公劉失其稷官，變于西戎，邑于豳。其後三百有餘歳，戎狄攻大王亶父，亶父亡走岐下，而豳人悉從亶父而邑焉，作周。其後百有餘歳，周西伯昌伐畎夷氏。後十有餘年，武王伐紂而營雒邑，復居于酆鄗，放逐戎夷涇、洛之北，以時入貢，命曰「荒服」。其後二百有餘年，周道衰，而穆王伐犬戎，得四白狼四白鹿以歸。自是之後，荒服不至。於是周遂作甫刑之辟。穆王之後二百有餘年，周幽王用寵姬褒姒之故，與申侯有卻。申侯怒而與犬戎共攻殺周幽王于驪山之下，遂取周之焦穫，而居于涇渭之閒，侵暴中國。秦襄公救周，於是周平王去酆鄗而東徙雒邑。當是之時，秦襄公伐戎至岐，始列爲諸侯。是後六十有五年，而山戎越燕而伐齊，齊釐公與戰于齊郊。其後四十四年，而山戎伐燕。燕告急于齊，齊桓公北伐山戎，山戎走。其後二十有餘年，而戎狄至洛邑，伐周襄王，襄王奔于鄭之氾邑。初，周襄王欲伐鄭，故娶戎狄女爲后，與戎狄兵共伐鄭。已而黜狄后，狄后怨，而襄王後母曰惠后，有子子帶，欲立之，於是惠后與狄后、子帶爲內應，開戎狄，戎狄以故得入，破逐周襄王，而立子帶爲天子。於是戎狄或居于陸渾，東至於衛，侵盜暴虐中國。中國疾之，故詩人歌之曰「戎狄是應」，「薄伐獫狁，至於大原」，「出輿彭彭，城彼朔方」。周襄王既居外四年，乃使使告急于晉。晉文公初立，欲修霸業，乃興師伐逐戎翟，誅子帶，迎內周襄王，居于雒邑。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-110-xiongnu:m002-0005","start":5,"end":7,"surface":"公劉","kind":"person","person_id":"ubt_idy_jr8","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m002-0032","start":32,"end":36,"surface":"大王亶父","kind":"person","person_id":"5dm_e40_rqh","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m002-0037","start":37,"end":39,"surface":"亶父","kind":"person","person_id":"5dm_e40_rqh","status":"contextual_provi