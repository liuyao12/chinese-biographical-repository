名士大夫，己心内雖不合，然陽浮慕之。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-122-kuli:m016-0000","start":0,"end":3,"surface":"武安侯","kind":"person","person_id":"2k7_iac_4ze","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m016-0008","start":8,"end":9,"surface":"湯","kind":"person","person_id":"1ex_se1_yef_A","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m016-0016","start":16,"end":18,"surface":"天子","kind":"person","person_id":"ln1_tyi_kei","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m016-0028","start":28,"end":31,"surface":"陳皇后","kind":"person","person_id":"xzz_lpt_eot","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m016-0041","start":41,"end":42,"surface":"上","kind":"person","person_id":"ln1_tyi_kei","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m016-0055","start":55,"end":57,"surface":"趙禹","kind":"person","person_id":"vkr_lkp_dme","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m016-0076","start":76,"end":78,"surface":"趙禹","kind":"person","person_id":"vkr_lkp_dme","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m016-0089","start":89,"end":91,"surface":"張湯","kind":"person","person_id":"1ex_se1_yef_A","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m016-0103","start":103,"end":104,"surface":"禹","kind":"person","person_id":"vkr_lkp_dme","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m016-0105","start":105,"end":106,"surface":"禹","kind":"person","person_id":"vkr_lkp_dme","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m016-0121","start":121,"end":123,"surface":"公卿","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m016-0126","start":126,"end":127,"surface":"禹","kind":"person","person_id":"vkr_lkp_dme","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m016-0128","start":128,"end":129,"surface":"禹","kind":"person","person_id":"vkr_lkp_dme","status":"contextual_provisional"},{"