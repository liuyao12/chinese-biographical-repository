al","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-043-wangcheng:line122","chapter_id":"c-jinshu-043-wangcheng"},{"id":"c-jinshu-043-wangcheng:line122:m0101","start":101,"end":102,"surface":"嶷","kind":"person","person_id":"me6_2ff_svi","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-043-wangcheng:line122","chapter_id":"c-jinshu-043-wangcheng"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-043-shanjian:line056","text":"尋加督寧、益軍事。時劉聰入寇，京師危逼。簡遣督護王萬率師赴難，次於涅陽，為宛城賊王如所破，遂嬰城自守。及洛陽陷沒，簡又為賊嚴嶷所逼，乃遷于夏口。招納流亡，江、漢歸附。時華軼以江州作難，或勸簡討之。簡曰：「與彥夏舊友，為之惆悵。簡豈利人之機，以為功伐乎！」其篤厚如此。時樂府伶人避難，多奔沔漢，宴會之日，僚佐或勸奏之。簡曰：「社稷傾覆，不能匡救，有晉之罪人也，何作樂之有！」因流涕慷慨，坐者咸愧焉。年六十卒，追贈征南大將軍、儀同三司。子遐。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-043-shanjian:line056:m0010","start":10,"end":12,"surface":"劉聰","kind":"person","person_id":"d96_1fa_e9a","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-shanjian:line056:m0020","start":20,"end":21,"surface":"簡","kind":"person","person_id":"82k_3oi_qf8","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-shanjian:line056:m0024","start":24,"end":26,"surface":"王萬","kind":"person","person_id":"95b_oz8_cuw","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-shanjian:line056:m0040","start":40,"end":42,"surface":"王如","kind":"person","person_id":"als_c6t_b83","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-shanjian:line056:m0057","start":57,"end":58,"surface":"簡","kind":"person","person_id":"82k_3oi_qf8","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-shanjian:line056:m0061","start":61,"end":63,"surface":"嚴嶷","kind":"person","person_id":"me6_2ff_svi","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-shanjian:line056:m0084","start":84,"end":86,"surface":"華軼","kind":"person","person_id":"p86_bh6_jm2","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-shanjian:line056:m0094","start":94,"end":95,"surface":"簡","kind":"person","person_id":"82k_3oi_qf8","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-shanjian:line056:m0098","start":98,"end":99,"surface":"簡","kind":"person","person_id":"82k_3oi_qf8","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-shanjian:line056:m0103","start":103,"end":105,"surface":"彥夏","kind":"person","person_id":"p86_bh6_jm2","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-shanjian:line056:m0113","start":113,"end":114,"surface":"簡","kind":"person","person_id":"82k_3oi_qf8","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-shanjian:line056:m0158","start":158,"end":159,"surface":"簡","kind":"person","person_id":"82k_3oi_qf8","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-shanjian:line056:m0217","start":217,"end":218,"surface":"遐","kind":"person","person_id":"82k_3oi_qf8_A","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"source_position":{"first_line":56,"last_line":56,"raw_start":3862,"raw_end":4083,"revision_id":2618531},"chapter_id":"c-jinshu-043-shanjian","book_id":"b-jinshu-043","work_id":"w-jinshu","source_id":"s-jinshu-043-shanjian"},{"id":"c-jinshu-043-wangcheng:line122","text":"澄既至鎮，日夜縱酒，不親庶事，雖寇戎急務，亦不以在懷。擢順陽人郭舒於寒悴之中，以為別駕，委以州府。時京師危逼，澄率眾軍，將赴國難，而飄風折其節柱。會王如寇襄陽，澄前鋒至宜城，遣使詣山簡，為如党嚴嶷所獲。嶷偽使人從襄陽來而問之曰：「襄陽拔未？」答云：「昨旦破城，已獲山簡。」乃陰緩澄使，令得亡去。澄聞襄陽陷，以為信然，散眾而還。既而恥之，托糧運不贍，委罪長史蔣俊而斬之，竟不能進。巴蜀流人散在荊、湘者，與土人忿爭，遂殺縣令，屯聚樂鄉。澄使成都內史王機討之。賊請降，澄偽許之，既而襲之於寵洲，以其妻子為賞，沈八千餘人于江中。於是益、梁流人四五萬家一時俱反，推杜弢為主，，南破零桂，東掠武昌，敗王機于巴陵。澄亦無憂懼之意，但與機日夜縱酒，投壺博戲，數十局俱起。殺富人李才，取其家資以賜郭舒。南平太守應詹驟諫，不納。於是上下離心，內外怨叛。澄望實雖損，猶傲然自得。後出軍擊杜弢，次於作塘。山簡參軍王沖叛於豫州，自稱荊州刺史。澄懼，使杜蕤守江陵。澄遷於孱陵，尋奔遝中。郭舒諫曰：「使君臨州，雖無異政，未失眾心。今西收華容向義之兵，足以擒此小丑，奈何自棄。」澄不能從。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-043-wangcheng:line122:m0000","start":0,"end":1,"surface":"澄","kind":"person","person_id":"rlk_lzd_86c","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line122:m0031","start":31,"end":33,"surface":"郭舒","kind":"person","person_id":"nyu_drp_roe","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line122:m0055","start":55,"end":56,"surface":"澄","kind":"person","person_id":"rlk_lzd_86c","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line122:m0074","start":74,"end":76,"surface":"王如","kind":"person","person_id":"als_c6t_b83","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line122:m0080","start":80,"end":81,"surface":"澄","kind":"person","person_id":"rlk_lzd_86c","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line122:m0090","start":90,"end":92,"surface":"山簡","kind":"person","person_id":"82k_3oi_qf8","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line122:m0094","start":94,"end":95,"surface":"如","kind":"person","person_id":"als_c6t_b83","status":"contextual_provisional","interpretation_note":"讀本段前後及對話，所指按此處記。"},{"id":"c-jinshu-043-wangcheng:line122:m0096","start":96,"end":98,"surface":"嚴嶷","kind":"person","person_id":"me6_2ff_svi","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line122:m0101","start":101,"end":102,"surface":"嶷","kind":"person","person_id":"me6_2ff_svi","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-0