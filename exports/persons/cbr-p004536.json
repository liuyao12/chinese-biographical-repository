{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004536","canonical_person_id":"u3r_atd_rs4","id_aliases":["cbr-p004536"],"identity_policy":"contextual_provisional","person_ids":["u3r_atd_rs4"],"persons":[{"id":"u3r_atd_rs4","label":"孔子引古（范睢蔡澤列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"孔子","mention_ids":["c-shiji-079-fancai:m031-0175"]}],"evidence":[{"mention_id":"c-shiji-079-fancai:m031-0175","chapter_id":"c-shiji-079-fancai","paragraph_id":"c-shiji-079-fancai:p031","quote":"孔子"}],"id_aliases":["cbr-p004536"]}],"source_mention_summary":[{"source_id":"s-shiji-079-fancai","work_id":"w-shiji","book_id":"b-shiji-079","chapter_id":"c-shiji-079-fancai","mention_count":1,"mention_ids":["c-shiji-079-fancai:m031-0175"],"paragraph_ids":["c-shiji-079-fancai:p031"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-079-fancai"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-079-fancai:m031-0175","start":175,"end":177,"surface":"孔子","kind":"person","person_id":"u3r_atd_rs4","status":"contextual_provisional","paragraph_id":"c-shiji-079-fancai:p031","chapter_id":"c-shiji-079-fancai"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji079-065","person_id":"u3r_atd_rs4","surfaces":["孔子"],"scope":"same_chapter","chapter_ids":["c-shiji-079-fancai"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-079-fancai:p031","quote":"蔡澤曰：「主聖臣賢，天下之盛福也；君明臣直，國之福也；父慈子孝，夫信妻貞，家之福也。故比干忠而不能存殷，子胥智而不能完吳，申生孝而晉國亂。是皆有忠臣孝子，而國家滅亂者，何也？無明君賢父以聽之，故天下以其君父為僇辱而憐其臣子。今商君、吳起、大夫種之為人臣，是也；其君，非也。故世稱三子致功而不見德，豈慕不遇世死乎？夫待死而後可以立忠成名，是微子不足仁，孔子不足聖，管仲不足大也。夫人之立功，豈不期於成全邪？身與名俱全者，上也。名可法而身死者，其次也。名在僇辱而身全者，下也。」於是應侯稱善。"}],"rationale":"按全35段明示姓名與局部引語暫接，范睢張祿范叔范君應侯分說話範圍；蔡澤先生綱成君依具體敘事。越王事大夫種與句踐敘事相配，更新候選標籤保留ID。馬服／馬服子依同段長平角色暫接未補姓名，白公仍未定，韓子未強接韓非，喬松不補神仙，范中行族稱不接范睢。王之弟、改讀前止足及引古異說各留，預言與擬議方案不當史實核定。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-079-fancai:p031","text":"蔡澤曰：「主聖臣賢，天下之盛福也；君明臣直，國之福也；父慈子孝，夫信妻貞，家之福也。故比干忠而不能存殷，子胥智而不能完吳，申生孝而晉國亂。是皆有忠臣孝子，而國家滅亂者，何也？無明君賢父以聽之，故天下以其君父為僇辱而憐其臣子。今商君、吳起、大夫種之為人臣，是也；其君，非也。故世稱三子致功而不見德，豈慕不遇世死乎？夫待死而後可以立忠成名，是微子不足仁，孔子不足聖，管仲不足大也。夫人之立功，豈不期於成全邪？身與名俱全者，上也。名可法而身死者，其次也。名在僇辱而身全者，下也。」於是應侯稱善。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-079-fancai:m031-0000","start":0,"end":2,"surface":"蔡澤","kind":"person","person_id":"shd_1wc_uva","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m031-0005","start":5,"end":9,"surface":"主聖臣賢","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛論、未名角色或未行方案保留，不補姓名、成員及親屬；相士預言與富貴壽長願望不當生平已證實。"},{"id":"c-shiji-079-fancai:m031-0017","start":17,"end":21,"surface":"君明臣直","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛論、未名角色或未行方案保留，不補姓名、成員及親屬；相士預言與富貴壽長願望不當生平已證實。"},{"id":"c-shiji-079-fancai:m031-0027","start":27,"end":31,"surface":"父慈子孝","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛論、未名角色或未行方案保留，不補姓名、成員及親屬；相士預言與富貴壽長願望不當生平已證實。"},{"id":"c-shiji-079-fancai:m031-0032","start":32,"end":36,"surface":"夫信妻貞","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛論、未名角色或未行方案保留，不補姓名、成員及親屬；相士預言與富貴壽長願望不當生平已證實。"},{"id":"c-shiji-079-fancai:m031-0043","start":43,"end":45,"surface":"比干","kind":"person","person_id":"o9l_aen_3cx","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m031-0052","start":52,"end":54,"surface":"子胥","kin