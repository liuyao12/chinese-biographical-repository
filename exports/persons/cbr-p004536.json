{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004536","identity_policy":"contextual_provisional","person_ids":["cbr-p004536"],"persons":[{"id":"cbr-p004536","label":"孔子引古（范睢蔡澤列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"孔子","mention_ids":["c-shiji-079-fancai:m031-0175"]}],"evidence":[{"mention_id":"c-shiji-079-fancai:m031-0175","chapter_id":"c-shiji-079-fancai","paragraph_id":"c-shiji-079-fancai:p031","quote":"孔子"}]}],"mentions":[{"id":"c-shiji-079-fancai:m031-0175","start":175,"end":177,"surface":"孔子","kind":"person","person_id":"cbr-p004536","status":"contextual_provisional","paragraph_id":"c-shiji-079-fancai:p031","chapter_id":"c-shiji-079-fancai"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji079-065","person_id":"cbr-p004536","surfaces":["孔子"],"scope":"same_chapter","chapter_ids":["c-shiji-079-fancai"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-079-fancai:p031","quote":"蔡澤曰：「主聖臣賢，天下之盛福也；君明臣直，國之福也；父慈子孝，夫信妻貞，家之福也。故比干忠而不能存殷，子胥智而不能完吳，申生孝而晉國亂。是皆有忠臣孝子，而國家滅亂者，何也？無明君賢父以聽之，故天下以其君父為僇辱而憐其臣子。今商君、吳起、大夫種之為人臣，是也；其君，非也。故世稱三子致功而不見德，豈慕不遇世死乎？夫待死而後可以立忠成名，是微子不足仁，孔子不足聖，管仲不足大也。夫人之立功，豈不期於成全邪？身與名俱全者，上也。名可法而身死者，其次也。名在僇辱而身全者，下也。」於是應侯稱善。"}],"rationale":"按全35段明示姓名與局部引語暫接，范睢張祿范叔范君應侯分說話範圍；蔡澤先生綱成君依具體敘事。越王事大夫種與句踐敘事相配，更新候選標籤保留ID。馬服／馬服子依同段長平角色暫接未補姓名，白公仍未定，韓子未強接韓非，喬松不補神仙，范中行族稱不接范睢。王之弟、改讀前止足及引古異說各留，預言與擬議方案不當史實核定。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-079-fancai:p031","text":"蔡澤曰：「主聖臣賢，天下之盛福也；君明臣直，國之福也；父慈子孝，夫信妻貞，家之福也。故比干忠而不能存殷，子胥智而不能完吳，申生孝而晉國亂。是皆有忠臣孝子，而國家滅亂者，何也？無明君賢父以聽之，故天下以其君父為僇辱而憐其臣子。今商君、吳起、大夫種之為人臣，是也；其君，非也。故世稱三子致功而不見德，豈慕不遇世死乎？夫待死而後可以立忠成名，是微子不足仁，孔子不足聖，管仲不足大也。夫人之立功，豈不期於成全邪？身與名俱全者，上也。名可法而身死者，其次也。名在僇辱而身全者，下也。」於是應侯稱善。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-079-fancai:m031-0000"