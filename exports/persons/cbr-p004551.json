{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004551","identity_policy":"contextual_provisional","person_ids":["cbr-p004551"],"persons":[{"id":"cbr-p004551","label":"秦始皇帝（范睢蔡澤列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"始皇帝","mention_ids":["c-shiji-079-fancai:m034-0048"]}],"evidence":[{"mention_id":"c-shiji-079-fancai:m034-0048","chapter_id":"c-shiji-079-fancai","paragraph_id":"c-shiji-079-fancai:p034","quote":"始皇帝"}]}],"mentions":[{"id":"c-shiji-079-fancai:m034-0048","start":48,"end":51,"surface":"始皇帝","kind":"person","person_id":"cbr-p004551","status":"contextual_provisional","paragraph_id":"c-shiji-079-fancai:p034","chapter_id":"c-shiji-079-fancai"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji079-080","person_id":"cbr-p004551","surfaces":["始皇帝"],"scope":"same_chapter","chapter_ids":["c-shiji-079-fancai"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-079-fancai:p034","quote":"蔡澤相秦數月，人或惡之，懼誅，乃謝病歸相印，號為綱成君。居秦十餘年，事昭王、孝文王、莊襄王。卒事始皇帝，為秦使於燕，三年而燕使太子丹入質於秦。"}],"rationale":"按全35段明示姓名與局部引語暫接，范睢張祿范叔范君應侯分說話範圍；蔡澤先生綱成君依具體敘事。越王事大夫種與句踐敘事相配，更新候選標籤保留ID。馬服／馬服子依同段長平角色暫接未補姓名，白公仍未定，韓子未強接韓非，喬松不補神仙，范中行族稱不接范睢。王之弟、改讀前止足及引古異說各留，預言與擬議方案不當史實核定。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-079-fancai:p034","text":"蔡澤相秦數月，人或惡之，懼誅，乃謝病歸相印，號為綱成君。居秦十餘年，事昭王、孝文王、莊襄王。卒事始皇帝，為秦使於燕，三年而燕使太子丹入質於秦。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-079-fancai:m034-0000","start":0,"end":2,"surface":"蔡澤","kind":"person","person_id":"cbr-p004523","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m034-0007","start":7,"end":9,"surface":"人或","kind":"unresolved","person_id":null,"status":"unresolved","note":"引古群體、泛論、族稱或未定角色保留；白公不強接白起，喬松不補神仙身分，范中行族稱不接范睢，欲稱孤或長壽不當實授生平。"},{"id":"c-shiji-079-fancai:m034-0024