{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"aoz_jaz_82c","canonical_person_id":"aoz_jaz_82c","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["aoz_jaz_82c"],"persons":[{"id":"aoz_jaz_82c","label":"馮朝","status":"active","historicity":"historical_tradition","review":"ai_provisional","aliases":[{"surface":"馮朝","mention_ids":["c-sanguozhi-050-he:line058-pei02-01:m0093","c-sanguozhi-048-sun-liang:p009:m0215","c-sanguozhi-048-sun-liang:p009:m0254"]}],"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-050","chapter_id":"c-sanguozhi-050-he","source_id":"s-sanguozhi-050-he","paragraph_id":"c-sanguozhi-050-he:line058-pei02-01","mention_id":"c-sanguozhi-050-he:line058-pei02-01:m0093","quote":"馮朝"},{"mention_id":"c-sanguozhi-048-sun-liang:p009:m0215","paragraph_id":"c-sanguozhi-048-sun-liang:p009","chapter_id":"c-sanguozhi-048-sun-liang","quote":"馮朝"},{"mention_id":"c-sanguozhi-048-sun-liang:p009:m0254","paragraph_id":"c-sanguozhi-048-sun-liang:p009","chapter_id":"c-sanguozhi-048-sun-liang","quote":"馮朝"}],"identity_note":"依本篇具名、稱謂及其所在原句辨認；引書原字存於各自來源。"},{"id":"aoz_jaz_82c_A","label":"馮純","status":"active","historicity":"historical_tradition","review":"ai_provisional","aliases":[{"surface":"純","mention_ids":["c-sanguozhi-050-he:line058-pei02-01:m0096","c-sanguozhi-050-he:line058-pei02-01:m0101"]}],"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-050","chapter_id":"c-sanguozhi-050-he","source_id":"s-sanguozhi-050-he","paragraph_id":"c-sanguozhi-050-he:line058-pei02-01","mention_id":"c-sanguozhi-050-he:line058-pei02-01:m0096","quote":"純"},{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-050","chapter_id":"c-sanguozhi-050-he","source_id":"s-sanguozhi-050-he","paragraph_id":"c-sanguozhi-050-he:line058-pei02-01","mention_id":"c-sanguozhi-050-he:line058-pei02-01:m0101","quote":"純"}],"identity_note":"依本篇具名、稱謂及其所在原句辨認；引書原字存於各自來源。","family_path":{"connection":"father","parent_person_id":"aoz_jaz_82c","generation_distance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-050","chapter_id":"c-sanguozhi-050-he","source_id":"s-sanguozhi-050-he","paragraph_id":"c-sanguozhi-050-he:line058-pei02-01","quote":"《江表傳》曰：皓以張布女為美人，有寵，皓問曰：「汝父所在？」答曰：「賊以殺之。」皓大怒，棒殺之。後思其顏色，使巧工刻木作美人形象，恆置座側。問左右：「布復有女否？」答曰：「布大女適故衛尉馮朝子純。」即奪純妻入宮，大有寵，拜為左夫人，晝夜與夫人房宴，不聽朝政，使尚方以金作華燧、步搖、假髻以千數。令宮人著以相撲，朝成夕敗，輒出更作，工匠因緣偷盜，府藏為空。會夫人死，皓哀愍思念，葬於苑中，大作塚，使工匠刻柏作木人，內塚中以為兵衛，以金銀珍玩之物送葬，不可稱計。已葬之後，皓治喪於內，半年不出。國人見葬太奢麗，皆謂皓已死，所葬者是也。皓舅子何都顏狀似皓，云都代立。臨海太守奚熙信訛言，舉兵欲還誅都，都叔父植時為備海督，擊殺熙，夷三族，訛言乃息，而人心猶疑。","source_term":"馮朝子純"}],"source_assertion_id":"a-wu050-he-12","interpretation_note":"本句所記父子；識別後綴不表示長幼。","reviewer":"Codex（AI 代理）"}}],"source_mention_summary":[{"source_id":"s-sanguozhi-048-sun-liang-ws2085142","work_id":"w-sanguozhi","book_id":"b-sanguozhi-048","chapter_id":"c-sanguozhi-048-sun-liang","raw_mention_count":2,"mention_ids":["c-sanguozhi-048-sun-liang:p009:m0215","c-sanguozhi-048-sun-liang:p009:m0254"],"paragraph_ids":["c-sanguozhi-048-sun-liang:p009"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-sanguozhi-048-sun-liang:p009:m0215","mention_ids":["c-sanguozhi-048-sun-liang:p009:m0215"],"kind":"paragraph"},{"canonical_mention_id":"c-sanguozhi-048-sun-liang:p009:m0254","mention_ids":["c-sanguozhi-048-sun-liang:p009:m0254"],"kind":"paragraph"}],"mention_count":2,"duplicate_mention_count":0,"paragraph_occurrence_count":2,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"2處獨立位置，2個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"},{"source_id":"s-sanguozhi-050-he","work_id":"w-sanguozhi","book_id":"b-sanguozhi-050","chapter_id":"c-sanguozhi-050-he","raw_mention_count":1,"mention_ids":["c-sanguozhi-050-he:line058-pei02-01:m0093"],"paragraph_ids":["c-sanguozhi-050-he:line058-pei02-01"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-sanguozhi-050-he:line058-pei0