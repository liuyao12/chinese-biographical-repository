015-0019","start":19,"end":21,"surface":"韓嫣","kind":"person","person_id":"pdg_cvo_5o3","status":"contextual_provisional","paragraph_id":"c-shiji-109-liguang:p015","chapter_id":"c-shiji-109-liguang"},{"id":"c-shiji-109-liguang:m015-0023","start":23,"end":24,"surface":"嫣","kind":"person","person_id":"pdg_cvo_5o3","status":"contextual_provisional","paragraph_id":"c-shiji-109-liguang:p015","chapter_id":"c-shiji-109-liguang"},{"id":"c-shiji-109-liguang:m015-0031","start":31,"end":32,"surface":"嫣","kind":"person","person_id":"pdg_cvo_5o3","status":"contextual_provisional","paragraph_id":"c-shiji-109-liguang:p015","chapter_id":"c-shiji-109-liguang"},{"id":"c-shiji-109-liguang:m015-0033","start":33,"end":34,"surface":"嫣","kind":"person","person_id":"pdg_cvo_5o3","status":"contextual_provisional","paragraph_id":"c-shiji-109-liguang:p015","chapter_id":"c-shiji-109-liguang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-109-liguang:p015","text":"廣子三人，曰當戸、椒、敢，爲郎。天子與韓嫣戲，嫣少不遜，當戸擊嫣，嫣走。於是天子以爲勇。當戸早死，拜椒爲代郡太守，皆先廣死。當戸有遺腹子名陵。廣死軍時，敢從驃騎將軍。廣死明年，李蔡以丞相坐侵孝景園壖地，當下吏治，蔡亦自殺，不對獄，國除。李敢以校尉從驃騎將軍擊胡左賢王，力戰，奪左賢王鼓旗，斬首多，賜爵關內侯，食邑二百戸，代廣爲郎中令。頃之，怨大將軍青之恨其父，乃擊傷大將軍，大將軍匿諱之。居無何，敢從上雍，至甘泉宮獵。驃騎將軍去病與青有親，射殺敢。去病時方貴幸，上諱云鹿觸殺之。居歳餘，去病死。而敢有女爲太子中人，愛幸，敢男禹有寵於太子，然好利，李氏陵遲衰微矣。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-109-liguang:m015-0000","start":0,"end":1,"surface":"廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m015-0006","start":6,"end":8,"surface":"當戸","kind":"person","person_id":"rg8_xc3_jri","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m015-0009","start":9,"end":10,"surface":"椒","kind":"person","person_id":"27z_feb_0rx","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m015-0011","start":11,"end":12,"sur