ntions":[{"id":"c-jinshu-062-liukun:p009:m0203","surface":"史蘭","start":203,"end":205,"person_id":"cia_2v1_303","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-062-liukun:p009","chapter_id":"c-jinshu-062-liukun"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-062-liukun:p009","text":"臣聞晉文以郤縠爲元帥而定霸功，高祖以韓信爲大將而成王業，咸有敦詩閱禮之德，戎昭果毅之威，故能振豐功于荊南，拓洪基於河北。況臣凡陋，擬蹤前哲，俯懼折鼎，慮在覆餗。昔曹沫三北，而收功于柯盟；馮異垂翅，而奮翼于澠池，皆能因敗爲成，以功補過。陛下宥過之恩已隆，而臣自新之善不立。臣雖不逮，預聞前訓，恭讓之節，臣猶庶幾。所以冒承寵命者，實欲沒身報國，輒死自效，要以致命寇場，盡其臣節。至於寵榮之施，非言辭所謝。又謁者史蘭、殿中中郎王春等繼至，奉詔，臣俯尋聖旨，伏紙飲淚。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":28,"last_line":28,"raw_start":2001,"raw_end":2243,"raw_character_offsets":[2011,2012,2013,2014,2015,2016,2017,2018,2019,2020,2021,2022,2023,2024,2025,2026,2027,2028,2029,2030,2031,2032,2033,2034,2035,2036,2037,2038,2039,2040,2041,2042,2043,2044,2045,2046,2047,2048,2049,2050,2051,2052,2053,2054,2055,2056,2057,2058,2059,2060,2061,2062,2063,2064,2065,2066,2067,2068,2069,2070,2071,2072,2073,2074,2075,2076,2077,2078,2079,2080,2081,2082,2083,2084,2085,2086,2087,2088,2089,2090,2091,2092,2093,2094,2095,2096,2097,2098,2099,2100,2101,2102,2103,2104,2105,2106,2107,2108,2109,2110,2111,2112,2113,2114,2115,2116,2117,2118,2119,2120,2121,2122,2123,2124,2125,2126,2127,2128,2129,2130,2131,2132,2133,2134,2135,2136,2137,2138,2139,2140,2141,2142,2143,2144,2145,2146,2147,2148,2149,2150,2151,2152,2153,2154,2155,2156,2157,2158,2159,2160,2161,2162,2163,2164,2165,2166,2167,2168,2169,2170,2171,2172,2173,2174,2175,2176,2177,2178,2179,2180,2181,2182,2183,2184,2185,2186,2187,2188,2189,2190,2191,2192,2193,2194,2195,2196,2197,2198,2199,2200,2201,2202,2203,2204,2205,2206,2207,2208,2209,2210,2211,2212,2213,2214,2215,2216,2217,2218,2219,2220,2221,2222,2223,2224,2225,2226