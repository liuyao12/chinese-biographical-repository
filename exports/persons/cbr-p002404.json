20,"surface":"成","kind":"person","person_id":"cbr-p002404","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m081-0121","start":121,"end":122,"surface":"兌","kind":"person","person_id":"cbr-p002428","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m081-0124","start":124,"end":126,"surface":"主父","kind":"person","person_id":"cbr-p002380","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m081-0128","start":128,"end":131,"surface":"公子章","kind":"person","person_id":"cbr-p002421","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m081-0133","start":133,"end":136,"surface":"公子成","kind":"person","person_id":"cbr-p002404","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m081-0137","start":137,"end":139,"surface":"李兌","kind":"person","person_id":"cbr-p002428","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m081-0144","start":144,"end":145,"surface":"章","kind":"person","person_id":"cbr-p002421","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m081-0147","start":147,"end":149,"surface":"主父","kind":"person","person_id":"cbr-p002380","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m081-0163","start":163,"end":165,"surface":"主父","kind":"person","person_id":"cbr-p002380","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m081-0167","start":167,"end":170,"surface":"宮中人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、代詞、未名君主或版本疑字保留；不把帝王泛稱、父子群體與未決分封當已確證身份或任期。"},{"id":"c-shiji-043-zhao:m081-0177","start":177,"end":180,"surface":"宮中人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、代詞、未名君主或版本疑字保留；不把帝王泛稱、父子群體與未決分封當已確證身份或任期。"},{"id":"c-shiji-043-zhao:m081-0183","start":183,"end":185,"surface":"主父","kind":"person","person_id":"cbr-p002380","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m081-0212","start":212,"end":214,"surface":"主父","kind":"person","person_id":"cbr-p002380","status":"contextual_provisional"}],"chapter_id":"c-shiji-043-zhao","book_id":"b-shiji-043","work_id":"w-shiji","source_id":"s-shiji-043-zhao"},{"id":"c-shiji-043-zhao:p082","text":"是時王少，成、兌專政，畏誅，故圍主父。主父初以長子章爲太子，後得吳娃，愛之，爲不出者數歳，生子何，乃廢太子章而立何爲王。吳娃死，愛弛，憐故太子，欲兩王之，猶豫未決，故亂起，以至父子倶死，爲天下笑，豈不痛乎！","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-043-zhao:m082-0002","start":2,"end":3,"surface":"王","kind":"person","person_id":"cbr-p002424","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m082-0005","start":5,"end":6,"surface":"成","kind":"person","person_id":"cbr-p002404","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m082-0007","start":7,"end":8,"surface":"兌","kind":"person","person_id":"cbr-p002428","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m082-0016","start":16,"end":18,"surface":"主父","kind":"person","person_id":"cbr-p002380","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m082-0019","start":19,"end":21,"surface":"主父","kind":"person","person_id":"cbr-p002380","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m082-0023","start":23,"end":26,"surface":"長子章","kind":"person","person_id":"cbr-p002421","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m082-0032","start":32,"end":34,"surface":"吳娃","kind":"person","person_id":"cbr-p002396","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m082-0046","start":46,"end":48,"surface":"子何","kind":"person","person_id":"cbr-p002424","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m082-0053","start":53,"end":54,"surface":"章","kind":"person","person_id":"cbr-p002421","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m082-0056","start":56,"end":57,"surface":"何","kind":"person","person_id":"cbr-p002424","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m082-0058","start":58,"end":59,"surface":"王","kind":"person","person_id":"cbr-p002424","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m082-0060","start":60,"end":62,"surface":"吳娃","kind":"person","perso