sanguozhi-059-he"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-059-he:line036-pei02-01","text":"《吳歷》曰：和四子：皓、德、謙、俊。孫休即位，封德錢唐侯，謙永安侯，俊拜騎都尉。皓在武昌，吳興施但因民之不堪命，聚萬餘人，劫謙，將至秣陵，欲立之。未至三十里住，擇吉日，但遣使以謙命詔丁固、諸葛靚。靚即斬其使。但遂前到九里，固、靚出擊，大破之。但兵裸身無鎧甲，臨陣皆披散。謙獨坐車中，遂生獲之。固不敢殺，以狀告皓，皓酖之，母子皆死。俊，張承外孫，聦明辨惠，爲遠近所稱，皓又殺之。","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-059-he:line036-pei02-01:m0006","start":6,"end":7,"surface":"和","kind":"person","person_id":"572_278_cba_A","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line036-pei02-01:m0010","start":10,"end":11,"surface":"皓","kind":"person","person_id":"05e_9bb_55a","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line036-pei02-01:m0012","start":12,"end":13,"surface":"德","kind":"person","person_id":"572_278_cba_AA","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line036-pei02-01:m0014","start":14,"end":15,"surface":"謙","kind":"person","person_id":"572_278_cba_AB","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line036-pei02-01:m0016","start":16,"end":17,"surface":"俊","kind":"person","person_id":"572_278_cba_AC","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line036-pei02-01:m0018","start":18,"end":20,"surface":"孫休","kind":"person","person_id":"0fo_c5c_4yh","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line036-pei02-01:m0024","start":24,"end":25,"surface":"德","kind":"person","person_id":"572_278_cba_AA","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line036-pei02-