近所稱，皓又殺之。","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-059-he:line036-pei02-01:m0006","start":6,"end":7,"surface":"和","kind":"person","person_id":"572_278_cba_A","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line036-pei02-01:m0010","start":10,"end":11,"surface":"皓","kind":"person","person_id":"05e_9bb_55a","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line036-pei02-01:m0012","start":12,"end":13,"surface":"德","kind":"person","person_id":"572_278_cba_AA","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line036-pei02-01:m0014","start":14,"end":15,"surface":"謙","kind":"person","person_id":"572_278_cba_AB","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line036-pei02-01:m0016","start":16,"end":17,"surface":"俊","kind":"person","person_id":"572_278_cba_AC","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line036-pei02-01:m0018","start":18,"end":20,"surface":"孫休","kind":"person","person_id":"0fo_c5c_4yh","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line036-pei02-01:m0024","start":24,"end":25,"surface":"德","kind":"person","person_id":"572_278_cba_AA","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line036-pei02-01:m0029","start":29,"end":30,"surface":"謙","kind":"person","person_id":"572_278_cba_AB","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line036-pei02-01:m0034","start":34,"end":35,"surface":"俊","kind":"person","person_id":"572_278_cba_AC","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line036-pei02-01:m0040","start":40,"end":41,"surface":"皓","kind":"person","person_id":"05e_9bb_55a","