r_id":"c-shiji-067-disciples"},{"id":"c-shiji-067-disciples:m008-0000","start":0,"end":2,"surface":"閔損","kind":"person","person_id":"cbr-p003863","status":"contextual_provisional","paragraph_id":"c-shiji-067-disciples:p008","chapter_id":"c-shiji-067-disciples"},{"id":"c-shiji-067-disciples:m008-0003","start":3,"end":5,"surface":"子騫","kind":"person","person_id":"cbr-p003863","status":"contextual_provisional","paragraph_id":"c-shiji-067-disciples:p008","chapter_id":"c-shiji-067-disciples"},{"id":"c-shiji-067-disciples:m009-0007","start":7,"end":10,"surface":"閔子騫","kind":"person","person_id":"cbr-p003863","status":"contextual_provisional","paragraph_id":"c-shiji-067-disciples:p009","chapter_id":"c-shiji-067-disciples"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji067-003","person_id":"cbr-p003863","surfaces":["子騫","閔子騫","閔損"],"scope":"same_chapter","chapter_ids":["c-shiji-067-disciples"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-067-disciples:p001","quote":"孔子曰「受業身通者七十有七人」，皆異能之士也。德行：顏淵，閔子騫，冉伯牛，仲弓。政事：冉有，季路。言語：宰我，子貢。文學：子游，子夏。師也辟，參也魯，柴也愚，由也喭，回也屢空。賜不受命而貨殖焉，億則屢中。"},{"paragraph_id":"c-shiji-067-disciples:p008","quote":"閔損字子騫。少孔子十五歳。"},{"paragraph_id":"c-shiji-067-disciples:p009","quote":"孔子曰：「孝哉閔子騫！人不閒於其父母昆弟之言。」不仕大夫，不食汙君之祿。「如有復我者，必在汶上矣。」"}],"rationale":"依篇內明示姓名字稱及局部問答暫接。吳越王稱按夫差句踐連續敘事；第71段夫子指原憲，第90段指代未定。傳易短何分田子莊何與楊何，傳授不當父子；引古人物保留傳說性。冉季字子產不接鄭子產，原憲子思不接孔子後世子思；名錄各條同字子徒、子聲、子上、皙等均保留不同候選，鄭國是此條人名。魯昭公夫人孟子不接戰國孟子。全152段明示姓名首輪已存，未名者、代詞、版本及跨篇身份待覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-067-disciples:p001","text":"孔子曰「受業身通者七十有七人」，皆異能之士也。德行：顏淵，閔子騫，冉伯牛，仲弓。政事：冉有，季路。言語：宰我，子貢。文學：子游，子夏。師也辟，參也魯，柴也愚，由也喭，回也屢空。賜不受命而貨殖焉，億則屢中。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-067-disciples:m001-0000","start":0,"end":2,"surface":"孔子","kind":"person","person_id":"cbr-p003