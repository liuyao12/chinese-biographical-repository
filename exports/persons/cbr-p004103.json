070-zhang:p030","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-070-zhang:m032-0017","start":17,"end":19,"surface":"大王","kind":"person","person_id":"cbr-p004103","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p032","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-070-zhang:m032-0048","start":48,"end":50,"surface":"大王","kind":"person","person_id":"cbr-p004103","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p032","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-070-zhang:m033-0002","start":2,"end":4,"surface":"楚王","kind":"person","person_id":"cbr-p004103","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p033","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-070-zhang:m033-0027","start":27,"end":29,"surface":"大王","kind":"person","person_id":"cbr-p004103","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p033","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-070-zhang:m033-0042","start":42,"end":44,"surface":"大王","kind":"person","person_id":"cbr-p004103","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p033","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-070-zhang:m033-0064","start":64,"end":66,"surface":"懷王","kind":"person","person_id":"cbr-p004103","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p033","chapter_id":"c-shiji-070-zhang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji070-022","person_id":"cbr-p004103","scope":"same_chapter","chapter_ids":["c-shiji-070-zhang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["大王","懷王","楚懷王","楚王","王"],"evidence":[{"paragraph_id":"c-shiji-070-zhang:p021","quote":"秦欲伐齊，齊楚從親，於是張儀往相楚。楚懷王聞張儀來，虛上舍而自館之。曰：「此僻陋之國，子何以教之？」儀說楚王曰：「大王誠能聽臣，閉關絕約於齊，臣請獻商於之地六百里，使秦女得為大王箕帚之妾，秦楚娶婦嫁女，長為兄弟之國。此北弱齊而西益秦也，計無便此者。」楚王大說而許之。群臣皆賀，陳軫獨弔之。楚王怒曰：「寡人不興師發兵得六百里地，群臣皆賀，子獨弔，何也？」陳軫對曰：「不然，以臣觀之，商於之地不可得而齊秦合，齊秦合則患必至矣。」楚王曰：「有說乎？」陳軫對曰：「夫秦之所以重楚者，以其有齊也。今閉關絕約於齊，則楚孤。秦奚貪夫孤國，而與之商於之地六百里？張儀至秦，必負王，是北絕齊交，西生患於秦也，而兩國之兵必俱至。善為王計者，不若陰合而陽絕於齊，使人隨張儀。茍與吾地，絕齊未晚也；不與吾地，陰合謀計也。」楚王曰：「願陳子閉口毋復言，以待寡人得地。」乃以相印授張儀，厚賂之。於是遂閉關絕約於齊，使一將軍隨張儀。"},{"paragraph_id":"c-shiji-070-zhang:p022","quote":"張儀至秦，詳失綏墮車，不朝三月。楚王聞之，曰：「儀以寡人絕齊未甚邪？」乃使勇士至宋，借宋之符，北罵齊王。齊王大怒，折節而下秦。秦齊之交合，張儀乃朝，謂楚使者曰：「臣有奉邑六里，願以獻大王左右。」楚使者曰：「臣受令於王，以商於之地六百里，不聞六里。」還報楚王，楚王大怒，發兵而攻秦。陳軫曰：「軫可發口言乎？攻之不如割地反以賂秦，與之并兵而攻齊，是我出地於秦，取償於齊也，王國尚可存。」楚王不聽，卒發兵而使將軍屈丐擊秦。秦齊共攻楚，斬首八萬，殺屈丐，遂取丹陽、漢中之地。楚又復益發兵而襲秦，至藍田，大戰，楚大敗，於是楚割兩城以與秦平。"},{"paragraph_id":"c-shiji-070-zhang:p023","quote":"秦要楚欲得黔中地，欲以武關外易之。楚王曰：「不願易地，願得張儀而獻黔中地。」秦王欲遣之，口弗忍言。張儀乃請行。惠王曰：「彼楚王怒子之負以商於之地，是且甘心於子。」張儀曰：「秦彊楚弱，臣善靳尚，尚得事楚夫人鄭袖，袖所言皆從。且臣奉王之節使楚，楚何敢加誅。假令誅臣而為秦得黔中之地，臣之上願。」遂使楚。楚懷王至則囚張儀，將殺之。靳尚謂鄭袖曰：「子亦知子之賤於王乎？」鄭袖曰：「何也？」靳尚曰：「秦王甚愛張儀而不欲出之，今將以上庸之地六縣賂楚，美人聘楚，以宮中善歌謳者為媵。楚王重地尊秦，秦女必貴而夫人斥矣。不若為言而出之。」於是鄭袖日夜言懷王曰：「人臣各為其主用。今地未入秦，秦使張儀來，至重王。王未有禮而殺張儀，秦必大怒攻楚。妾請子母俱遷江南，毋為秦所魚肉也。」懷王後悔，赦張儀，厚禮之如故。"},{"paragraph_id":"c-shiji-070-zhang:p024","quote":"張儀既出，未去，聞蘇秦死，乃說楚王曰：「秦地半天下，兵敵四國，被險帶河，四塞以為固。虎賁之士百餘萬，車千乘，騎萬匹，積粟如丘山。法令既明，士卒安難樂死，主明以嚴，將智以武，雖無出甲，席卷常山之險，必折天下之脊，天下有後服者先亡。且夫為從者，無以異於驅群羊而攻猛虎，虎之與羊不格明矣。今王不與猛虎而與群羊，臣竊以為大王之計過也。"},{"paragraph_id":"c-shiji-070-zhang:p025","quote":"「凡天下彊國，非秦而楚，非楚而秦，兩國交爭，其勢不兩立。大王不與秦，秦下甲據宜陽，韓之上地不通。下河東，取成皋，韓必入臣，梁則從風而動。秦攻楚之西，韓、梁攻其北，社稷安得毋危？"},{"paragraph_id":"c-shiji-070-zhang:p026","quote":"「且夫從者聚群弱而攻至彊，不料敵而輕戰，國貧而數舉兵，危亡之術也。臣聞之，兵不如者勿與挑戰，粟不如者勿與持久。夫從人飾辯虛辭，高主之節，言其利不言其害，卒有秦禍，無及為已。是故願大王之孰計之。"},{"paragraph_id":"c-shiji-070-zhang:p027","quote":"「秦西有巴蜀，大船積粟，起於汶山，浮江已下，至楚三千餘里。舫船載卒，一舫載五十人與三月之食，下水而浮，一日行三百餘里，里數雖多，然而不費牛馬之力，不至十日而距扜關。扜關驚，則從境以東盡城守矣，黔中、巫郡非王之有。秦舉甲出武關，南面而伐，則北地絕。秦兵之攻楚也，危難在三月之內，而楚待諸侯之救，在半歲之外，此其勢不相及也。夫待弱國之救，忘彊秦之禍，此臣所以為大王患也。"},{"paragraph_id":"c-shiji-070-zhang:p028","quote":"「大王嘗與吳人戰，五戰而三勝，陣卒盡矣；偏守新城，存民苦矣。臣聞功大者易危，而民敝者怨上。夫守易危之功而逆彊秦之心，臣竊為大王危之。"},{"paragraph_id":"c-shiji-070-zhang:p029","quote":"「且夫秦之所以不出兵函谷十五年以攻齊、趙者，陰謀有合天下之心。楚嘗與秦構難，戰於漢中，楚人不勝，列侯執珪死者七十餘人，遂亡漢中。楚王大怒，興兵襲秦，戰於藍田。此所謂兩虎相搏者也。夫秦楚相敝而韓魏以全制其後，計無危於此者矣。願大王孰計之。"},{"paragraph_id":"c-shiji-070-zhang:p030","quote":"「秦下甲攻衛陽晉，必大關天下之匈。大王悉起兵以攻宋，不至數月而宋可舉，舉宋而東指，則泗上十二諸侯盡王之有也。"},{"paragraph_id":"c-shiji-070-zhang:p032","quote":"「今秦與楚接境壤界，固形親之國也。大王誠能聽臣，臣請使秦太子入質於楚，楚太子入質於秦，請以秦女為大王箕帚之妾，效萬室之都以為湯沐之邑，長為昆弟之國，終身無相攻伐。臣以為計無便於此者。」"},{"paragraph_id":"c-shiji-070-zhang:p033","quote":"於是楚王已得張儀而重出黔中地與秦，欲許之。屈原曰：「前大王見欺於張儀，張儀至，臣以為大王烹之；今縱弗忍殺之，又聽其邪說，不可。」懷王曰：「許儀而得黔中，美利也。後而倍之，不可。」故卒許張儀，與秦親。"}],"rationale":"按第1至23段局部明示姓名與引語判讀；魏襄王卒後哀王受話語境分開。楚懷王與秦惠王在出使鄭袖段分辨，不按最近名字或全域王字判讀。擬議秦女、美人與子母不補姓名或婚姻；未名齊王不按年代記憶定名，異稱、史實及時序仍待覆核。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-070-zhang:p021","text":"秦欲伐齊，齊楚從親，於是張儀往相楚。楚懷王聞張儀來，虛上舍而自館之。曰：「此僻陋之國，子何以教之？」儀說楚王曰：「大王誠能聽臣，閉關絕約於齊，臣請獻商於之地六百里，使秦女得為大王箕帚之妾，秦楚娶婦嫁女，長為兄弟之國。此北弱齊而西益秦也，計無便此者。」楚王大說而許之。群臣皆賀，陳軫獨弔之。楚王怒曰：「寡人不興師發兵得六百里地，群臣皆賀，子獨弔，何也？」陳軫對曰：「不然，以臣觀之，商於之地不可得而齊秦合，齊秦合則患必至矣。」楚王曰：「有說乎？」陳軫對曰：「夫秦之所以重楚者，以其有齊也。今閉關絕約於齊，則楚孤。秦奚貪夫孤國，而與之商於之地六百里？張儀至秦，必負王，是北絕齊交，西生患於秦也，而兩國之兵必俱至。善為王計者，不若陰合而陽絕於齊，使人隨張儀。茍與吾地，絕齊未晚也；不與吾地，陰合謀計也。」楚王曰：「願陳子閉口毋復言，以待寡人得地。」乃以相印授張儀，厚賂之。於是遂閉關絕約於齊，使一將軍隨張儀。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-070-zhang:m021-0012","start":12,"end":14,"surface":"張儀","kind":"person","person_id":"cbr-p004084","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m021-0018","start":18,"end":21,"surface":"楚懷王","kind":"person","person_id":"cbr-p004103","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m021-0022","start":22,"end":24,"surface":"張儀","kind":"person","person_id":"cbr-p004084","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m021-0050","start":50,"end":51,"surface":"儀","kind":"person","person_id":"cbr-p004084","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m021-0052","start":52,"end":54,"surface":"楚王","kind":"person","person_id":"cbr-p004103","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m021-0057","start":57,"end":59,"surface":"大王","kind":"person","person_id":"cbr-p004103","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m021-0083","start":83,"end":85,"surface":"秦女","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、未定身分或擬議婚姻，不補姓名、實受關係或成員。"},{"id":"c-shiji-070-zhang:m021-0087","start":87,"end":89,"surface":"大王","kind":"person","person_id":"cbr-p004103","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m021-0125","start":125,"end":127,"surface":"楚王","kind":"person","person_id":"cbr-p004103","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m021-0133","start":133,"end":135,"surface":"群臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、未定身分或擬議婚姻，不補姓名、實受關係或成員。"},{"id":"c-shiji-070-zhang:m021-0138","start":138,"end":140,"surface":"陳軫","kind":"person","person_id":"cbr-p004104","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m021-0144","start":144,"end":146,"surface":"楚王","kind":"person","person_id":"cbr-p004103","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m021-0163","start":163,"end":165,"surface":"群臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、未定身分或擬議婚姻，不補姓名、實受關係或成員。"},{"id":"c-shiji-070-zhang:m021-0176","start":176,"end":178,"surface":"陳軫","kind":"person","person_id":"cbr-p004104","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m021-0212","start":212,"end":214,"surface":"楚王","kind":"person","person_id":"cbr-p004103","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m021-0222","start":222,"end":224,"surface":"陳軫","kind":"person","person_id":"cbr-p004104","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m021-0273","start":273,"end":275,"surface":"張儀","kind":"person","person_id":"cbr-p004084","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m021-0280","start":280,"end":281,"surface":"王","kind":"person","person_id":"cbr-p004103","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m021-0306","start":306,"end":307,"surface":"王","kind":"person","person_id":"cbr-p004103","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m021-0323","start":323,"end":325,"surface":"張儀","kind":"person","person_id":"cbr-p004084","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m021-0349","start":349,"end":351,"surface":"楚王","kind":"person","person_id":"cbr-p004103","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m021-0355","start":355,"end":357,"surface":"陳子","kind":"person","person_id":"cbr-p004104","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m021-0376","start":376,"end":378,"surface":"張儀","kind":"person","person_id":"cbr-p004084","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m021-0394","start":394,"end":397,"surface":"一將軍","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、未定身分或擬議婚姻，不補姓名、實受關係或成員。"},{"id":"c-shiji-070-zhang:m021-0398","start":398,"end":400,"surface":"張儀","kind":"person","person_id":"cbr-p004084","status":"contextual_provisional"}],"chapter_id":"c-shiji-070-zhang","book_id":"b-shiji-070","work_id":"w-shiji","source_id":"s-shiji-070-zhang"},{"id":"c-shiji-070-zhang:p022","text":"張儀至秦，詳失綏墮車，不朝三月。楚王聞之，曰：「儀以寡人絕齊未甚邪？」乃使勇士至宋，借宋之符，北罵齊王。齊王大怒，折節而下秦。秦齊之交合，張儀乃朝，謂楚使者曰：「臣有奉邑六里，願以獻大王左右。」楚使者曰：「臣受令於王，以商於之地六百里，不聞六里。」還報楚王，楚王大怒，發兵而攻秦。陳軫曰：「軫可發口言乎？攻之不如割地反以賂秦，與之并兵而攻齊，是我出地於秦，取償於齊也，王國尚可存。」楚王不聽，卒發兵而使將軍屈丐擊秦。秦齊共攻楚，斬首八萬，殺屈丐，遂取丹陽、漢中之地。楚又復益發兵而襲秦，至藍田，大戰，楚大敗，於是楚割兩城以與秦平。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-070-zhang:m022-0000","start":0,"end":2,"surface":"張儀","kind":"person","person_id":"cbr-p004084","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m022-0016","start":16,"end":18,"surface":"楚王","kind":"person","person_id":"cbr-p004103","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m022-0024","start":24,"end":25,"surface":"儀","kind":"person","person_id":"cbr-p004084","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m022-0037","start":37,"end":39,"surface":"勇士","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、未定身分或擬議婚姻，不補姓名、實受關係或成員。"},{"id":"c-shiji-070-zhang:m022-0049","start":49,"end":51,"surface":"齊王","kind":"person","person_id":"cbr-p004108","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m022-0052","start":52,"end":54,"surface":"齊王","kind":"person","person_id":"cbr-p004108","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m022-0069","start":69,"end":71,"surface":"張儀","kind":"person","person_id":"cbr-p004084","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m022-0075","start":75,"end":78,"surface":"楚使者","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、未定身分或擬議婚姻，不補姓名、實受關係或成員。"},{"id":"c-shiji-070-zhang:m022-0091","start":91,"end":93,"surface":"大王","kind":"person","person_id":"cbr-p004103","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m022-0097","start":97,"end":100,"surface":"楚使者","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、未定身分或擬議婚姻，不補姓名、實受關係或成員。"},{"id":"c-shiji-070-zhang:m022-0107","start":107,"end":108,"surface":"王","kind":"person","person_id":"cbr-p004103","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m022-0126","start":126,"end":128,"surface":"楚王","kind":"person","person_id":"cbr-p004103","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m022-0129","start":129,"end":131,"surface":"楚王","kind":"person","person_id":"cbr-p004103","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m022-0140","start":140,"end":142,"surface":"陳軫","kind":"person","person_id":"cbr-p004104","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m022-0145","start":145,"end":146,"surface":"軫","kind":"person","person_id":"cbr-p004104","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m022-0191","start":191,"end":193,"surface":"楚王","kind":"person","person_id":"cbr-p004103","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m022-0203","start":203,"end":205,"surface":"屈丐","kind":"person","person_id":"cbr-p004105","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m022-0220","start":220,"end":222,"surface":"屈丐","kind":"person","person_id":"cbr-p004105","status":"contextual_provisional"}],"chapter_id":"c-shiji-070-zhang","book_id":"b-shiji-070","work_id":"w-shiji","source_id":"s-shiji-070-zhang"},{"id":"c-shiji-070-zhang:p023","text":"秦要楚欲得黔中地，欲以武關外易之。楚王曰：「不願易地，願得張儀而獻黔中地。」秦王欲遣之，口弗忍言。張儀乃請行。惠王曰：「彼楚王怒子之負以商於之地，是且甘心於子。」張儀曰：「秦彊楚弱，臣善靳尚，尚得事楚夫人鄭袖，袖所言皆從。且臣奉王之節使楚，楚何敢加誅。假令誅臣而為秦得黔中之地，臣之上願。」遂使楚。楚懷王至則囚張儀，將殺之。靳尚謂鄭袖曰：「子亦知子之賤於王乎？」鄭袖曰：「何也？」靳尚曰：「秦王甚愛張儀而不欲出之，今將以上庸之地六縣賂楚，美人聘楚，以宮中善歌謳者為媵。楚王重地尊秦，秦女必貴而夫人斥矣。不若為言而出之。」於是鄭袖日夜言懷王曰：「人臣各為其主用。今地未入秦，秦使張儀來，至重王。王未有禮而殺張儀，秦必大怒攻楚。妾請子母俱遷江南，毋為秦所魚肉也。」懷王後悔，赦張儀，厚禮之如故。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-070-zhang:m023-0017","start":17,"end":19,"surface":"楚王","kind":"person","person_id":"cbr-p004103","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m023-0029","start":29,"end":31,"surface":"張儀","kind":"person","person_id":"cbr-p004084","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m023-0038","start":38,"end":40,"surface":"秦王","kind":"person","person_id":"cbr-p004090","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m023-0049","start":49,"end":51,"surface":"張儀","kind":"person","person_id":"cbr-p004084","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m023-0055","start":55,"end":57,"surface":"惠王","kind":"person","person_id":"cbr-p004090","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m023-0061","start":61,"end":63,"surface":"楚王","kind":"person","person_id":"cbr-p004103","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m023-0081","start":81,"end":83,"surface":"張儀","kind":"person","person_id":"cbr-p004084","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m023-0093","start":93,"end":95,"surface":"靳尚","kind":"person","person_id":"cbr-p004106","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m023-0096","start":96,"end":97,"surface":"尚","kind":"person","person_id":"cbr-p004106","s