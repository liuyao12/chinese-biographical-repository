":91,"surface":"莊王","kind":"person","person_id":"cbr-p000257","status":"contextual_provisional"}],"chapter_id":"c-shiji-038-song","book_id":"b-shiji-038","work_id":"w-shiji","source_id":"s-shiji-038-song"},{"id":"c-shiji-038-song:p049","text":"二十二年，文公卒，子共公瑕立。始厚葬。君子譏華元不臣矣。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-038-song:m049-0005","start":5,"end":7,"surface":"文公","kind":"person","person_id":"cbr-p001656","status":"contextual_provisional"},{"id":"c-shiji-038-song:m049-0010","start":10,"end":13,"surface":"共公瑕","kind":"person","person_id":"cbr-p001663","status":"contextual_provisional"},{"id":"c-shiji-038-song:m049-0022","start":22,"end":24,"surface":"華元","kind":"person","person_id":"cbr-p001658","status":"contextual_provisional"}],"chapter_id":"c-shiji-038-song","book_id":"b-shiji-038","work_id":"w-shiji","source_id":"s-shiji-038-song"},{"id":"c-shiji-038-song:p050","text":"共公十年，華元善楚將子重，又善晉將欒書，兩盟晉楚。十三年，共公卒。華元爲右師，魚石爲左師。司馬唐山攻殺太子肥，欲殺華元，華元犇晉，魚石止之，至河乃還，誅唐山。乃立共公少子戌，是爲平公。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-038-song:m050-0000","start":0,"end":2,"surface":"共公","kind":"person","person_id":"cbr-p001663","status":"contextual_provisional"},{"id":"c-shiji-038-song:m050-0005","start":5,"end":7,"surface":"華元","kind":"person","person_id":"cbr-p001658","status":"contextual_provisional"},{"id":"c-shiji-038-song:m050-0008","start":8,"end":12,"surface":"楚將子重","kind":"person","person_id":"cbr-p001664","status":"contextual_provisional"},{"id":"c-shiji-038-song:m050-0015","start":15,"end":19,"surface":"晉將欒書","kind":"person","person_id":"cbr-p000415","status":"contextual_provisional"},{"id":"c-shiji-038-song:m050-0029","start":29,"end":31,"surface":"共公","kind":"person","person_id":"cbr-p001663","status":"contextual_provisional"},{"id":"c-shiji-038-song:m050-0033","start":33,"end":35,"surface":"華元","kind":"person","person_id":"cbr-p001658","status":"contextual_provisional"},{"id":"c-shiji-038-song:m050-0039","start":39,"end":41,"surface":"魚石","kind":"person","person_id":"cbr-p001665","status":"contextual_provisional"},{"id":"c-shiji-038-song:m050-0045","start":45,"end":49,"surface":"司馬唐山","kind":"person","person_id":"cbr-p001666","status":"contextual_provisional"},{"id":"c-shiji-038-song:m050-0051","start":51,"end":54,"surface":"太子肥","kind":"person","person_id":"cbr-p001667","status":"contextual_provisional"},{"id":"c-shiji-038-song:m050-0057","start":57,"end":59,"surface":"華元","kind":"person","person_id":"cbr-p001658","status":"contextual_provisional"},{"id":"c-shiji-038-song:m050-0060","start":60,"end":62,"surface":"華元","kind":"person","person_id":"cbr-p001658","status":"contextual_provisional"},{"id":"c-shiji-038-song:m050-0065","start":65,"end":67,"surface":"魚石","kind":"person","person_id":"cbr-p001665","status":"contextual_provisional"},{"id":"c-shiji-038-song:m050-0076","start":76,"end":78,"surface":"唐山","kind":"person","person_id":"cbr-p001666","status":"contextual_provisional"},{"id":"c-shiji-038-song:m050-0081","start":81,"end":83,"surface":"共公","kind":"person","person_id":"cbr-p001663","status":"contextual_provisional"},{"id":"c-shiji-038-song:m050-0085","start":85,"end":86,"surface":"戌","kind":"person","person_id":"cbr-p001668","status":"contextual_provisional"},{"id":"c-shiji-038-song:m050-0089","start":89,"end":91,"surface":"平公","kind":"person","person_id":"cbr-p001668","status":"contextual_provisional"}],"chapter_id":"c-shiji-038-song","book_id":"b-shiji-038","work_id":"w-shiji","source_id":"s-shiji-038-song"},{"id":"c-shiji-040-chu:p025","text":"二十年，圍宋，以殺楚使也。圍宋五月，城中食盡，易子而食，析骨而炊。宋華元出告以情。莊王曰：「君子哉！」遂罷兵去。二十三年，莊王卒，子共王審立。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m025-0009","start":9,"end":11,"surface":"楚使","kind":"unresolved","person_id":null,"status":"unresolved","note":"因殺楚使而圍宋的未名使者，待與宋篇核對，不補姓名。"},{"id":"c-shiji-040-chu:m025-0033","start":33,"end":36,"surface":"宋華元","kind":"person","person_id":"cbr-p001658","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m025-0041","start":41,"end":43,"surface":"莊王","kind":"person","person_id":"cbr-p001885","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m025-0061","start":61,"end":63,"surface":"莊王","kind":"person","person_id":"cbr-p001885","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m025-0066","start":66,"end":69,"surface":"共王審","kind":"person","person_id":"cbr-p001886","status":"contextual_provisional"}],"chapter_id":"c-shiji-040-chu","book_id":"b-shiji-040","work_id":"w-shiji","source_id":"s-shiji-040-chu"},{"id":"c-shiji-042-zheng:p024","text":"往年楚太子商臣弒其父成王代立。二十一年，與宋華元伐鄭。華元殺羊食士，不與其御羊斟，怒以馳鄭，鄭囚華元。宋贖華元，元亦亡去。晉使趙穿以兵伐鄭。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-042-zheng:m024-0002","start":2,"end":7,"surface":"楚太子商臣","kind":"person","person_id":"cbr-p002161","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m024-0010","start":10,"end":12,"surface":"成王","kind":"person","person_id":"cbr-p002162","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m024-0021","start":21,"end":24,"surface":"宋華元","kind":"person","person_id":"cbr-p002163","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m024-0027","start":27,"end":29,"surface":"華元","kind":"person","person_id":"cbr-p002163","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m024-0038","start":38,"end":40,"surface":"羊斟","kind":"person","person_id":"cbr-p002164","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m024-0048","start":48,"end":50,"surface":"華元","kind":"person","person_id":"cbr-p002163","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m024-0053","start":53,"end":55,"surface":"華元","kind":"person","person_id":"cbr-p002163","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m024-0056","start":56,"end":57,"surface":"元","kind":"person","person_id":"cbr-p002163","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m024-0063","start":63,"end":65,"surface":"趙穿","kind":"person","person_id":"cbr-p002165","status":"contextual_provisional"}],"chapter_id":"c-shiji-042-zheng","book_id":"b-shiji-042","work_id":"w-shiji","source_id":"s-shiji-042-zheng"},{"id":"c-shiji-042-zheng:p027","text":"襄公元年，楚怒鄭受宋賂縱華元，伐鄭。鄭背楚，與晉親。五年，楚復伐鄭，晉來救之。六年，子家卒，國人復逐其族，以其弒靈公也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-042-zheng:m027-0000","start":0,"end":2,"surface":"襄公","kind":"person","person_id":"cbr-p002170","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m027-0002","start":2,"end":3,"surface":"元","kind":"person","person_id":"cbr-p002163","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m027-0012","start":12,"end":14,"surface":"華元","kind":"person","person_id":"cbr-p002163","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m027-0042","start":42,"end":44,"surface":"子家","kind":"person","person_id":"cbr-p002166","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m027-0056","start":56,"end":58,"surface":"靈公","kind":"person","person_id":"cbr-p002168","status":"contextual_provisional"}],"chapter_id":"c-shiji-042-zheng","book_id":"b-shiji-042","work_id":"w-shiji","source_id":"s-shiji-042-zheng"}],"sources":[{"chapter_id":"c-shiji-038-song","work_id":"w-shiji","book_id":"b-shiji-038","source_id":"s-shiji-038-song","source":{"title":"史記／卷038","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷038","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷038&oldid=8737306","revision_id":8737306,"accessed_on":"2026-10-09","extent":"59段正文，自微子開至太史公論贊；排除2個dd導覽、正文邊界空白、末端空p與現代版權模板。本見證未見索隱述贊。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[{"paragraph_id":"c-shiji-038-song:p001","witn