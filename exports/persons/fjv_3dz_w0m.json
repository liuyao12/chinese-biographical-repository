tions":[{"id":"th-nan023-wangyu-m10-30:a","person_mention_id":"c-nanshi-023-wangyu-jingwen:p010:m0017","usage":"narrative","date_expression":null,"paragraph_id":"c-nanshi-023-wangyu-jingwen:p010","surface":"江州刺史","start":30,"end":34}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-023","source_id":"s-nanshi-023-wangyu-jingwen-ws2478204","chapter_id":"c-nanshi-023-wangyu-jingwen","paragraph_id":"c-nanshi-023-wangyu-jingwen:p010","quote":"上既有疾，而諸弟並已見殺；唯桂陽王休范人才本劣，不見疑，出為江州刺史。慮一旦晏駕，皇后臨朝，則景文自然成宰相，門族強盛，藉元舅之重，歲暮不為純臣。泰豫元年春，上疾篤，遣使送藥賜景文死，使謂曰：「朕不謂卿有罪，然吾不能獨死，請子先之。」因手詔曰：「與卿周旋，欲全卿門戶，故有此處分。」敕至之夜，景文政與客棋，扣函看，復還封置局下，神色怡然不變。方與客棋思行爭劫竟，斂子內奩畢，徐謂客曰：「奉敕見賜以死。」方以敕示客。酒至未飲，門客焦度在側，憤怒發酒覆地曰：「大丈夫安能坐受死。州中文武可數百人，足以一奮。」景文曰：「知卿至心；若見念者，為我百口計。」乃墨啟答敕，並謝贈詔。酌謂客曰：「此酒不可相勸。」自仰而飲之。時年六十。追贈開府儀同三司，諡曰懿。長子絢。","person_mention_id":"c-nanshi-023-wangyu-jingwen:p010:m0017"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-023","source_id":"s-nanshi-023-wangyu-jingwen-ws2478204","chapter_id":"c-nanshi-023-wangyu-jingwen","paragraph_id":"c-nanshi-023-wangyu-jingwen:p010","quote":"上既有疾，而諸弟並已見殺；唯桂陽王休范人才本劣，不見疑，出為江州刺史。慮一旦晏駕，皇后臨朝，則景文自然成宰相，門族強盛，藉元舅之重，歲暮不為純臣。泰豫元年春，上疾篤，遣使送藥賜景文死，使謂曰：「朕不謂卿有罪，然吾不能獨死，請子先之。」因手詔曰：「與卿周旋，欲全卿門戶，故有此處分。」敕至之夜，景文政與客棋，扣函看，復還封置局下，神色怡然不變。方與客棋思行爭劫竟，斂子內奩畢，徐謂客曰：「奉敕見賜以死。」方以敕示客。酒至未飲，門客焦度在側，憤怒發酒覆地曰：「大丈夫安能坐受死。州中文武可數百人，足以一奮。」景文曰：「知卿至心；若見念者，為我百口計。」乃墨啟答敕，並謝贈詔。酌謂客曰：「此酒不可相勸。」自仰而飲之。時年六十。追贈開府儀同三司，諡曰懿。長子絢。","person_mention_id":"c-nanshi-023-wangyu-jingwen:p010:m0017"}],"status":"source_attested","interpretation_note":"按本見證原職名及其所屬人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"person_references":[{"id":"c-nanshi-023-wangyu-jingwen:p010:r0014","surface":"桂陽王","start":14,"end":17,"person_id":"fjv_3dz_w0m","referent_role":"third_person","paragraph_id":"c-nanshi-023-wangyu-jingwen:p010","quote":"上既有疾，而諸弟並已見殺；唯桂陽王休范人才本劣，不見疑，出為江州刺史。慮一旦晏駕，皇后臨朝，則景文自然成宰相，門族強盛，藉元舅之重，歲暮不為純臣。泰豫元年春，上疾篤，遣使送藥賜景文死，使謂曰：「朕不謂卿有罪，然吾不能獨死，請子先之。」因手詔曰：「與卿周旋，欲全卿門戶，故有此處分。」敕至之夜，景文政與客棋，扣函看，復還封置局下，神色怡然不變。方與客棋思行爭劫竟，斂子內奩畢，徐謂客曰：「奉敕見賜以死。」方以敕示客。酒至未飲，門客焦度在側，憤怒發酒覆地曰：「大丈夫安能坐受死。州中文武可數百人，足以一奮。」景文曰：「知卿至心；若見念者，為我百口計。」乃墨啟答敕，並謝贈詔。酌謂客曰：「此酒不可相勸。」自仰而飲之。時年六十。追贈開府儀同三司，諡曰懿。長子絢。","note":"按說話人、受話人及詔內上下文。","chapter_id":"c-nanshi-023-wangyu-jingwen","book_id":"b-nanshi-023","work_id":"w-nanshi","source_id":"s-nanshi-023-wangyu-jingwen-ws2478204"},{"id":"c-nanshi-023-wangyun-yanshen:p002:r0000","surface":"桂陽","start":0,"end":2,"person_id":"fjv_3dz_w0m","referent_role":"third_person","paragraph_id":"c-nanshi-023-wangyun-yanshen:p002","quote":"桂陽之逼，王道隆為亂兵所殺，蘊力戰，重創禦溝側，或扶以免。事平，撫軍長史褚澄為吳郡太守，司徒左長史蕭惠明言於朝曰：「褚澄開城以納賊，更為股肱大郡，王蘊被甲死戰，棄而不收，賞罰如此，何憂不亂！」褚彥回慚，乃議用蘊為湘州刺史。及齊高帝輔政，蘊與沈攸之連謀，事敗，斬於秣陵市。","note":"按上下文說話及施、受事者。","chapter_id":"c-nanshi-023-wangyun-yanshen","book_id":"b-nanshi-023","work_id":"w-nanshi","source_id":"s-nanshi-023-wangyun-yanshen-ws2478204"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-032-ruantao:line094","text":"宋孝武選侍中四人，竝以風貌。王彧、謝莊爲一雙，韜與何偃爲一雙。常充兼假。泰始末，爲征南江州長史。桂陽王休範在鎮，數出行遊，韜性方峙，未嘗隨從。至散騎常侍，金紫光祿大夫，領始興王師。永明二年，卒。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-nanqishu-032-ruantao:line094:m0000","start":0,"end":3,"surface":"宋孝武","kind":"person","person_id":"hx8_st4_jdd","status":"contextual_provisional"},{"id":"c-nanqishu-032-ruantao:line094:m0014","start":14,"end":16,"surface":"王彧","kind":"person","person_id":"1tc_q18_x7v","status":"contextual_provisional"},{"id":"c-nanqishu-032-ruantao:line094:m0017","start":17,"end":19,"surface":"謝莊","kind":"person","person_id":"aa6_83c_juy_DBABA","status":"contextual_provisional"},{"id":"c-nanqishu-032-ruantao:line094:m0023","start":23,"end":24,"surface":"韜","kind":"person","person_id":"03n_n2r_8rt_***A","status":"contextual_provisional"},{"id":"c-nanqishu-032-ruantao:line094:m0025","start":25,"end":27,"surface":"何偃","kind":"person","person_id":"pbz_pni_tco","status":"contextual_provisional"},{"id":"c-nanqishu-032-ruantao:line094:m0048","start":48,"end":53,"surface":"桂陽王休範","kind":"person","person_id":"fjv_3dz_w0m","status":"contextual_provisional"},{"id":"c-nanqishu-032-ruantao:line094:m0061","start":61,"end":62,"surface":"韜","kind":"person","person_id":"03n_n2r_8rt_***A","status":"contextual_provisional"},{"id":"c-nanqishu-032-ruantao:line094:m0085","start":85,"end":88,"surface":"始興王","kind":"person","person_id":"el1_amk_djh","status":"contextual_provisional"}],"source_position":{"first_line":94,"last_line":94,"revision_id":1513918,"editorial_excerpt_boundary":false},"chapter_id":"c-nanqishu-032-ruantao","book_id":"b-nanqishu-032","work_id":"w-nanqishu","source_id":"s-nanqishu-032-ruantao"},{"id":"c-nanqishu-046-wangxiuzhi:line013","text":"秀之幼時，裕愛其風采。起家著作佐郎，太子舍人。父卒，爲菴舍於墓下持喪，服闋復職。吏部尚書褚淵見秀之正潔，欲與結婚，秀之不肯，以此頻轉爲兩府外兵參軍。遷太子洗馬，司徒左西屬，桂陽王司空從事中郎。秀之知休範將反，辭疾不就。出爲晉平太守。至郡期年，謂人曰：「此邦豐壤，祿俸常充。吾山資已足，豈可久留以妨賢路。」上表請代，時人謂「王晉平恐富求歸」。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-nanqishu-046-wangxiuzhi:line013:m0000","start":0,"end":2,"surface":"秀之","kind":"person","person_id":"7r6_k52_qji_ABDABAABA","status":"contextual_provisional"},{"id":"c-nanqishu-046-wangxiuzhi:line013:m0005","start":5,"end":6,"surface":"裕","kind":"person","person_id":"7r6_k52_qji_ABDABAA","status":"contextual_provisional"},{"id":"c-nanqishu-046-wangxiuzhi:line013:m0023","start":23,"end":24,"surface":"父","kind":"person","person_id":"7r6_k52_qji_ABDABAAB","status":"contextual_provisional"},{"id":"c-nanqishu-046-wangxiuzhi:line013:m0044","start":44,"end":46,"surface":"褚淵","kind":"person","person_id":"jyx_72x_8t2","status":"contextual_provisional"},{"id":"c-nanqishu-046-wangxiuzhi:line013:m0047","start":47,"end":49,"surface":"秀之","kind":"person","person_id":"7r6_k52_qji_ABDABAABA","status":"contextual_provisional"},{"id":"c-nanqishu-046-wangxiuzhi:line013:m0057","start":57,"end":59,"surface":"秀之","kind":"person","person_id":"7r6_k52_qji_ABDABAABA","status":"contextual_provisional"},{"id":"c-nanqishu-046-wangxiuzhi:line013:m0086","start":86,"end":89,"surface":"桂陽王","kind":"person","person_id":"fjv_3dz_w0m","status":"contextual_provisional"},{"id":"c-nanqishu-046-wangxiuzhi:line013:m0096","start":96,"end":98,"surface":"秀之","kind":"person","person_id":"7r6_k52_qji_ABDABAABA","status":"contextual_provisional"},{"id":"c-nanqishu-046-wangxiuzhi:line013:m0099","start":99,"end":101,"surface":"休範","kind":"person","person_id":"fjv_3dz_w0m","status":"contextual_provisional"},{"id":"c-nanqishu-046-wangxiuzhi:line013:m0136","start":136,"end":137,"surface":"吾","kind":"person","person_id":"7r6_k52_qji_ABDABAABA","status":"contextual_provisional"},{"id":"c-nanqishu-046-wangxiuzhi:line013:m0161","start":161,"end":164,"surface":"王晉平","kind":"person","person_id":"7r6_k52_qji_ABDABAABA","status":"contextual_provisional"}],"source_position":{"first_line":13,"last_line":13,"revision_id":1511897,"editorial_excerpt_boundary":false},"chapter_id":"c-nanqishu-046-wangxiuzhi","book_id":"b-nanqishu-046","work_id":"w-nanqishu","source_id":"s-nanqishu-046-wangxiuzhi"},{"id":"c-nanshi-023-wangyu-jingwen:p010","text":"上既有疾，而諸弟並已見殺；唯桂陽王休范人才本劣，不見疑，出為江州刺史。慮一旦晏駕，皇后臨朝，則景文自然成宰相，門族強盛，藉元舅之重，歲暮不為純臣。泰豫元年春，上疾篤，遣使送藥賜景文死，使謂曰：「朕不謂卿有罪，然吾不能獨死，請子先之。」因手詔曰：「與卿周旋，欲全卿門戶，故有此處分。」敕至之夜，景文政與客棋，扣函看，復還封置局下，神色怡然不變。方與客棋思行爭劫竟，斂子內奩畢，徐謂客曰：「奉敕見賜以死。」方以敕示客。酒至未飲，門客焦度在側，憤怒發酒覆地曰：「大丈夫安能坐受死。州中文武可數百人，足以一奮。」景文曰：「知卿至心；若見念者，為我百口計。」乃墨啟答敕，並謝贈詔。酌謂客曰：「此酒不可相勸。」自仰而飲之。時年六十。追贈開府儀同三司，諡曰懿。長子絢。","mentions":[{"id":"c-nanshi-023-wangyu-jingwen:p010:m0017","surface":"休范","start":17,"end":19,"person_id":"fjv_3dz_w0m","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangyu-jingwen:p010:m0047","surface":"景文","start":47,"end":49,"person_id":"1tc_q18_x7v","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangyu-jingwen:p010:m0088","surface":"景文","start":88,"end":90,"person_id":"1tc_q18_x7v","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangyu-jingwen:p010:m0146","surface":"景文","start":146,"end":148,"person_id":"1tc_q18_x7v","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangyu-jingwen:p010:m0214","surface":"焦度","start":214,"end":216,"person_id":"g83_41s_o52_*A","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangyu-jingwen:p010:m0252","surface":"景文","start":252,"end":254,"person_id":"1tc_q18_x7v","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangyu-jingwen:p010:m0325","surface":"絢","start":325,"end":326,"person_id":"1tc_q18_x7v_A","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":2478204,"source_layer":"received_biography","first_line":119,"last_line":119,"line_start":0,"line_end":327,"raw_start":9209,"raw_end":9536,"raw_character_offsets":[9209,9210,9211,9212,9213,9214,9215,9216,9217,9218,9219,9220,9221,9222,9223,9224,9225,9226,9227,9228,9229,9230,9231,9232,9233,9234,9235,9236,9237,9238,9239,9240,9241,9242,9243,9244,9245,9246,9247,9248,9249,9250,9251,9252,9253,9254,9255,9256,9257,9258,9259,9260,9261,9262,9263,9264,9265,9266,9267,9268,9269,9270,9271,9272,9273,9274,9275,9276,9277,9278,9279,9280,9281,9282,9283,9284,9285,9286,9287,9288,9289,9290,9291,9292,9293,9294,9295,9296,9297,9298,9299,9300,9301,9302,9303,9304,9305,9306,9307,9308,9309,9310,9311,9312,9313,9314,9315,9316,9317,9318,9319,9320,9321,9322,9323,9324,9325,9326,9327,9328,9329,9330,9331,9332,9333,9334,9335,9336,9337,9338,9339,9340,9341,9342,9343,9344,9345,9346,9347,9348,9349,9350,9351,9352,9353,9354,9355,9356,9357,9358,9359,9360,9361,9362,9363,9364,9365,9366,9367,9368,9369,9370,9371,9372,9373,9374,9375,9376,9377,9378,9379,9380,9381,9382,9383,9384,9385,9386,9387,9388,9389,9390,9391,9392,9393,9394,9395,9396,9397,9398,9399,9400,9401,9402,9403,9404,9405,9406,9407,9408,9409,9410,9411,9412,9413,9414,9415,9416,9417,9418,9419,9420,9421,9422,9423,9424,9425,9426,9427,9428,9429,9430,9431,9432,9433,9434,9435,9436,9437,9438,9439,9440,9441,9442,9443,9444,9445,9446,9447,9448,9449,9450,9451,9452,9453,9454,9455,9456,9457,9458,9459,9460,9461,9462,9463,9464,9465,9466,9467,9468,9469,9470,9471,9472,9473,9474,9475,9476,9477,9478,9479,9480,9481,9482,9483,9484,9485,9486,9487,9488,9489,9490,9491,9492,9493,9494,9495,9496,9497,9498,9499,9500,9501,9502,9503,9504,9505,9506,9507,9508,9509,9510,9511,9512,9513,9514,9515,9516,9517,9518,9519,9520,9521,9522,9523,9524,9525,9526,9527,9528,9529,9530,9531,9532,9533,9534,9535],"projection_sha256":"d222fafdefab57ab0af5469ceb4211a79a2e19df9e4196f9c6457906172ade93","editorial_excerpt_boundary":true},"chapter_id":"c-nanshi-023-wangyu-jingwen","book_id":"b-nanshi-023","work_id":"w-nanshi","source_id":"s-nanshi-023-wangyu-jingwen-ws2478204"},{"id":"c-nanshi-023-wangyun-yanshen:p002","text":"桂陽之逼，王道隆為亂兵所殺，蘊力戰，重創禦溝側，或扶以免。事平，撫軍長史褚澄為吳郡太守，司徒左長史蕭惠明言於朝曰：「褚澄開城以納賊，更為股肱大郡，王蘊被甲死戰，棄而不收，賞罰如此，何憂不亂！」褚彥回慚，乃議用蘊為湘州刺史。及齊高帝輔政，蘊與沈攸之連謀，事敗，斬於秣陵市。","mentions":[{"id":"c-nanshi-023-wangyun-yanshen:p002:m0005","surface":"王道隆","start":5,"end":8,"person_id":"t3u_ekc_eeo","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangyun-yanshen:p002:m0014","surface":"蘊","start":14,"end":15,"person_id":"hh2_pun_92k","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangyun-yanshen:p002:m0036","surface":"褚澄","start":36,"end":38,"person_id":"6fs_tis_zoa_A","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangyun-yanshen: