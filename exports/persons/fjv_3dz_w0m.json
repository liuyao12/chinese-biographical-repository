82,10383,10384,10385,10386,10387,10388,10389,10390,10391,10392,10393,10394,10395,10396,10397,10398,10399,10400,10401,10402,10403,10404,10405,10406,10407,10408,10409,10410,10411,10412,10413,10414,10415,10416,10417,10418,10419,10420,10421,10422,10423,10424,10425,10426,10427,10428,10429,10430,10431,10432,10433,10434,10435,10436,10437,10438,10439,10440,10441,10442,10443,10444,10445,10446,10447,10448,10449,10450],"projection_sha256":"0b966aec35bdaad3b60ebbf4b08d20368bd4a5cf50e64223eb91f82444ee7e8e","editorial_excerpt_boundary":true},"chapter_id":"c-nanshi-023-wangyun-yanshen","book_id":"b-nanshi-023","work_id":"w-nanshi","source_id":"s-nanshi-023-wangyun-yanshen-ws2478204"}],"sources":[{"chapter_id":"c-nanqishu-032-ruantao","work_id":"w-nanqishu","book_id":"b-nanqishu-032","source_id":"s-nanqishu-032-ruantao","source":{"title":"《南齊書》卷32（阮韜傳）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E5%8D%97%E9%BD%8A%E6%9B%B8%2F%E5%8D%B732&oldid=1513918","permalink":"https://zh.wikisource.org/w/index.php?title=%E5%8D%97%E9%BD%8A%E6%9B%B8%2F%E5%8D%B732&oldid=1513918","revision_id":1513918,"accessed_on":"2026-10-19","extent":"阮韜傳完整兩原段；與同卷王延之傳分開，並非全卷完成。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，未親核底本影像","wikitext_sha256":"cc9c36ced8f64c3c359c76836ae56968c8a13c4a3b3c19a416575737314b0061","normalization":{"character_conversion":{},"extraction_note":"只去排版空白、展開原字形外殼及單參數年號模板及保留顯示字的維基連結外殼；數位ref另列，不改原字或標點，不以節題補姓名。","excerpts":[{"proposed_paragraph_id":"c-nanqishu-032-ruantao:line092","source_lines":[92,92],"raw_quote":"　　阮韜字長明，陳留人，晉金紫光祿大夫裕玄孫也。韜少歷清官，爲南兖州別駕，刺史江夏王劉義恭逆求資費錢，韜曰：「此朝廷物。」執不與。","raw_quote_sha256":"adb1fc0bc00f251d601003d4d3f553e95163bc24cf63e925449ea39243f1f3ec","selected_text_sha256":"61c91b43ee82932ccc015222861da398e638707a0d7dc563ccc5cdcd0fc4c2db","begin_anchor":"阮韜字長明，陳留人，晉金紫光祿大夫裕","end_anchor":"資費錢，韜曰：「此朝廷物。」執不與。"},{"proposed_paragraph_id":"c-nanqishu-032-ruantao:line094","source_lines":[94,94],"raw_quote":"　　宋孝武選侍中四人，竝以風貌。王彧、謝莊爲一雙，韜與何偃爲一雙。常充兼假。泰始末，爲征南江州長史。桂陽王休範在鎮，數出行遊，韜性方峙，未嘗隨從。至散騎常侍，金紫光祿大夫，領始興王師。{{YL|永明二年}}，卒。","raw_quote_sha256":"ab64ae4d39f2f4061eb5ca12a919c03d5bab29c8cacb2a7d192fe1ad51cadd92","selected_text_sha256":"f40955d4b0013c2bf83323217dd29596873bd05d55ab80e95c3f5f4dfe368e96","begin_anchor":"宋孝武選侍中四人，竝以風貌。王彧、謝","end_anchor":"光祿大夫，領始興王師。永明二年，卒。"}]},"response_sha256":"f428c7546fdd70a9eece664401433407aad6e45bcbe711a6d58ef8806c1b4ca0"}},{"chapter_id":"c-nanqishu-046-wangxiuzhi","work_id":"w-nanqishu","book_id":"b-nanqishu-046","source_id":"s-nanqishu-046-wangxiuzhi","source":{"title":"《南齊書》卷46（王秀之傳）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E5%8D%97%E9%BD%8A%E6%9B%B8%2F%E5%8D%B746&oldid=1511897","permalink":"https://zh.wikisource.org/w/index.php?title=%E5%8D%97%E9%BD%8A%E6%9B%B8%2F%E5%8D%B746&oldid=1511897","revision_id":1511897,"accessed_on":"2026-10-19","extent":"王秀之本傳完整七原段，末段含宗人僧祐及孔逭；同卷其餘本傳未錄。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，未親核底本影像","wikitext_sha256":"d109243a343e069b8ce98cb0607567b69305574aa59ecc8776b9ea70ca0fd537","normalization":{"character_conversion":{},"extraction_note":"只去排版空白、展開原字形外殼及單參數年號模板及保留顯示字的維基連結外殼；數位ref另列，不改原字或標點，不以節題補姓名。","excerpts":[{"proposed_paragraph_id":"c-nanqishu-046-wangxiuzhi:line011","source_lines":[11,11],"raw_quote":"　　王秀之字伯奮，琅邪臨沂人也。祖裕，宋左光祿大夫、儀同三司。父瓚之，金紫光祿大夫。","raw_quote_sha256":"76b26241dd0ab4b0b0c07a5ef0ea7164c4fc9f7155416114800008a06a606d6a","selected_text_sha256":"e60e881f48186283ead894f36caa85231e97d8b44b50e8a19b6bd856cfaae113","begin_anchor":"王秀之字伯奮，琅邪臨沂人也。祖裕，宋","end_anchor":"夫、儀同三司。父瓚之，金紫光祿大夫。"},{"proposed_paragraph_id":"c-nanqishu-046-wangxiuzhi:line013","source_lines":[13,13],"raw_quote":"　　秀之幼時，裕愛其風采。起家著作佐郎，太子舍人。父卒，爲菴舍於墓下持喪，服闋復職。吏部尚書褚淵見秀之正潔，欲與結婚，秀之不肯，以此頻轉爲兩府外兵參軍。遷太子洗馬，司徒左西屬，桂陽王司空從事中郎。秀之知休範將反，辭疾不就。出爲晉平太守。至郡期年，謂人曰：「此邦豐壤，祿俸常充。吾山資已足，豈可久留以妨賢路。」上表請代，時人謂「王晉平恐富求歸」。","raw_quote_sha256":"14deb1ceb0f7b46d5e431b44722f5b0c48c4e612313587cb4b3c6868dfbf37f1","selected_text_sha256":"f832ba4bdc2755431aa17d9a1dc16a341ab048579f9a894ca501746cea0f2cb6","begin_anchor":"秀之幼時，裕愛其風采。起家著作佐郎，","end_anchor":"上表請代，時人謂「王晉平恐富求歸」。"},{"proposed_paragraph_id":"c-nanqishu-046-wangxiuzhi:line015","source_lines":[15,15],"raw_quote":"　　還爲安成王驃騎諮議，轉中郎。又爲太祖驃騎諮議。{{YL|昇明二年}}，轉左軍長史、尋陽太守，隨府轉鎮西長史、南郡太守。府主豫章王嶷旣封王，秀之遷爲司馬、河東太守，辭郡不受。加寧朔將軍，改除黃門郎，未拜，仍遷豫章王驃騎長史。於荊州立學，以秀之領儒林祭酒。遷寧朔將軍、南郡王司馬。復爲黃門郎，領羽林監。遷長沙王中軍長史。世祖卽位，爲太子中庶子，吏部郎，出爲義興太守，遷侍中祭酒，轉都官尚書。","raw_quote_sha256":"0a638d6a3b77b8a167013d9a499385134cf454553fbb66b22be64543c5955b43","selected_text_sha256":"e81a512bd5f746938e3be8e29434ff0d0fb6a0d1a4eab5e2d7c8ad581427becb","begin_anchor":"還爲安成王驃騎諮議，轉中郎。又爲太祖","end_anchor":"爲義興太守，遷侍中祭酒，轉都官尚書。"},{"proposed_paragraph_id":"c-nanqishu-046-wangxiuzhi:line017","source_lines":[17,17],"raw_quote":"　　初，秀之祖裕，性貞正。徐羨之、傅亮當朝，裕不與來往。及致仕隱吳興，與子瓚之書曰：「吾欲使汝處不競之地。」瓚之歷官至五兵尚書，未嘗詣一朝貴。江湛謂何偃曰：「王瓚之今便是朝隱。」及柳元景、顏師伯令僕貴要，瓚之竟不候之。至秀之爲尚書，又不與令王儉款接。三世不事權貴，時人稱之。轉侍中，領射聲校尉。","raw_quote_sha256":"a7a2624163aa4b9dab2de7c27a5f34d7691ac8a091cbddc68afd4ec123be05b6","selected_text_sha256":"31315643807c6b06bc86bf531695eb84c3de8d04007cec280340e7c2aa10c35c","begin_anchor":"初，秀之祖裕，性貞正。徐羨之、傅亮當","end_anchor":"權貴，時人稱之。轉侍中，領射聲校尉。"},{"proposed_paragraph_id":"c-nanqishu-046-wangxiuzhi:line019","source_lines":[19,19],"raw_quote":"　　出爲輔國將軍、隨王鎮西長史、南郡內史。州西曹苟平遺秀之交知書，秀之拒不答。平乃遺書曰：「僕聞居《謙》之位，旣刊于《[[易]]》；傲不可長，《禮》明其文。是以信陵致夷門之義，燕丹收荊卿之節，皆以禮而然矣。丈夫處世，豈可寂漠恩榮，空爲後代一丘土？足下業潤重光，聲居朝右，不脩高世之績，將何隔於愚夫？僕耿介當年，不通羣品，饑寒白首，望物嗟來。成人之美，《[[春秋]]》所善，薦我寸長，開君尺短，故推風期德，規於相益，實非碌碌有求於平原者也。僕與足下，同爲四海國士。夫盛衰迭代，理之恒數，名位參差，運之通塞，豈品德權行爲之者哉？第五之號，旣無易於驃騎；西曹之名，復何推於長史？足下見答書題久之，以君若此非典，何宜施之於國士？如其循禮，禮無不答，謹以相還，亦何犯於逆鱗哉？君子處人，以德不以位，相如不見屈於澠池，毛遂安受辱於郢門，造敵臨事，僕必先於二子。未知足下之貴，足下之威，孰若秦、楚兩王？僕以德爲寶，足下以位爲寶，各寶其寶，於此敬宜。常聞古人交絕，不泄惡言，僕謂之鄙。無以相貽，故薦貧者之贈。」平，潁川人。豫章王嶷爲荊州時，平獻書令減損奢麗，豫章王優教酬答。尚書令王儉當事，平又與儉書曰「足下建高世之名，而不顯高世之迹，將何以書於齊史哉？」至是南郡綱紀啓隨王子隆請罪，平上書自申。","raw_quote_sha256":"585bb4028c3044d4b3526f3762e64c069bc4a0c7afc7aec985dd96b1f4b3ab89","selected_text_sha256":"728a987f949d21c120c0e667eb1143cc2db469daf856d267471ee9c4f7278f96","begin_anchor":"出爲輔國將軍、隨王鎮西長史、南郡內史","end_anchor":"南郡綱紀啓隨王子隆請罪，平上書自申。"},{"proposed_paragraph_id":"c-nanqishu-046-wangxiuzhi:line021","source_lines":[21,21],"raw_quote":"　　秀之尋徵侍中，領游擊將軍。未拜，仍爲輔國將軍、吳興太守。秀之常云位至司徒左長史，可以止足矣。吳興郡隱業所在，心願爲之。到郡脩治舊山，移置輜重。{{YL|隆昌元年}}，卒官。年五十三。謚曰簡子。","raw_quote_sha256":"e270111da5241a1de5c6d1c81d09747717ccd149e3ecbc8a33b8b984094f90da","selected_text_sha256":"9c2580f26943b07d15f13b801ccb37b00f8b69c908d993ac195723fc1a441873","begin_anchor":"秀之尋徵侍中，領游擊將軍。未拜，仍爲","end_anchor":"隆昌元年，卒官。年五十三。謚曰簡子。"},{"proposed_paragraph_id":"c-nanqishu-046-wangxiuzhi:line023","source_lines":[23,23],"raw_quote":"　　秀之宗人僧祐，太尉儉從祖兄也。父遠，光祿勳。宋世爲之語曰：「王遠如屏風，屈曲從俗，能蔽風露。」而僧祐負氣不羣，儉常候之，辭不相見。世祖數閱武，僧祐獻《講武賦》，儉借觀，僧祐不與。竟陵王子良聞僧祐善彈琴，於座取琴進之，不肯從命。永明末，爲太子中舍人，在直屬疾，代人未至，僧祐委出，爲有司所奏，贖論。官至黃門郎。時衞軍掾孔逭亦抗直，著《三吳決錄》，不傳。","raw_quote_sha256":"8048a6e5c424608e984995190047c849fab56159b875f03d60386ae36d8c8865","selected_text_sha256":"db0c2343733a3192793b3fa75e9378dc342c91939e8cd888011c58517ae4d6c5","begin_anchor":"秀之宗人僧祐，太尉儉從祖兄也。父遠，","end_anchor":"掾孔逭亦抗直，著《三吳決錄》，不傳。"}]},"response_sha256":"5c7b6b848d348ff02938bfa253f4357668fba6b1df46559afb1033418cbd529f"}},{"chapter_id":"c-nanshi-023-wangyu-jingwen","work_id":"w-nanshi","book_id":"b-nanshi-023","source_id":"s-nanshi-023-wangyu-jingwen-ws2478204","source":{"title":"南史卷23·王彧（字景文）及伯父智","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?oldid=2478204","permalink":"https://zh.wikisource.org/w/index.php?oldid=2478204","revision_id":2478204,"accessed_on":"2026-11-21","edition":"維基文庫固定數位轉錄","extent":"固定修訂第101至119行，含段內子孫記載。","text_scope":"complete_biography_unit","image_verified":false,"review_status":"text_checked","raw_path":"sources/nanshi/nanshi023-ws2478204.wikitext","raw_file_sha256":"c54bdda206986e5d4e5331144e783f163b5823855581b9833572e1982d1d4e40","rights":"古代原典及維基文庫數位轉錄。","license_url":"https://zh.wikisource.org/wiki/Wikisource:著作權資訊","normalization":{"character_conversion":{},"extraction_note":"逐碼取原行，數位校者夾注分層另據原始字位查核。","verified_blank_line_gaps":[{"source_lines":[102,102],"raw_quote":"","raw_quote_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","revision_id":2478204},{"source_lines":[104,104],"raw_quote":"","raw_quote_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","revision_id":2478204},{"source_lines":[106,106],"raw_quote":"","raw_quote_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","revision_id":2478204},{"source_lines":[108,108],"raw_quote":"","raw_quote_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","revision_id":2478204},{"source_lines":[110,110],"raw_quote":"","raw_quote_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","revision_id":2478204},{"source_lines":[112,112],"raw_quote":"","raw_quote_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","revision_id":2478204},{"source_lines":[114,114],"raw_quote":"","raw_quote_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","revision_id":2478204},{"source_lines":[116,116],"raw_quote":"","raw_quote_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","revision_id":2478204},{"source_lines":[118,118],"raw_quote":"","raw_quote_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","revision_id":2478204}]},"section_locator":"數位王彧原題，傳首至長子絢；絢本傳自121行起。"}},{"chapter_id":"c-nanshi-023-wangyun-yanshen","work_id":"w-nanshi","book_id":"b-nanshi-023","source_id":"s-nanshi-023-wangyun-yanshen-ws2478204","source":{"title":"南史卷23·王蘊（字彥深）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?oldid=2478204","permalink":"https://zh.wikisource.org/w/index.php?oldid=2478204","revision_id":247