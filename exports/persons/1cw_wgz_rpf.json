ntity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-053-local-officials-complete:p022","text":"　　永明三年，使虜，世祖謂之曰：「以卿有將命之才，使還，當以一郡相賞。」還爲始安內史。郡民龔玄宣，云神人與其玉印玉板書，不須筆，吹紙便成字。自稱「龔聖人」，以此惑衆。前後郡守敬事之，昭明付獄治罪。及還，甚貧罄。世祖曰：「裴昭明罷郡還，遂無宅。我不諳書，不知古人中誰比？」遷射聲校尉。九年，復遣北使。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":63,"last_line":63,"raw_start":3044,"raw_end":3200,"raw_character_offsets":[3044,3045,3051,3052,3053,3054,3057,3058,3059,3060,3061,3062,3063,3064,3065,3066,3067,3068,3069,3070,3071,3072,3073,3074,3075,3076,3077,3078,3079,3080,3081,3082,3083,3084,3085,3086,3087,3088,3089,3090,3091,3092,3093,3094,3095,3096,3097,3098,3099,3100,3101,3102,3103,3104,3105,3106,3107,3108,3109,3110,3111,3112,3113,3114,3115,3116,3117,3118,3119,3120,3121,3122,3123,3124,3125,3126,3127,3128,3129,3130,3131,3132,3133,3134,3135,3136,3137,3138,3139,3140,3141,3142,3143,3144,3145,3146,3147,3148,3149,3150,3151,3152,3153,3154,3155,3156,3157,3158,3159,3160,3161,3162,3163,3164,3165,3166,3167,3168,3169,3170,3171,3172,3173,3174,3175,3176,3177,3178,3179,3180,3181,3182,3183,3184,3185,3186,3187,3188,3189,3190,3191,3192,3193,3194,3195,3196,3197,3198,3199],"revision_id":1501803},"mentions":[{"id":"c-nanqishu-053-local-officials-complete:p022:m0010","start":10,"end":12,"surface":"世祖","kind":"person","person_id":"kix_r92_2ed","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p022:m0045","start":45,"end":48,"surface":"龔玄宣","kind":"person","person_id":"1cw_wgz_rpf","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p022:m0073","start":73,"end":76,"surface":"龔聖人","kind":"person","person_id":"1cw_wgz_rpf","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p022:m0091","start":91,"end":93,"surface":"昭明","kind":"person","person_id":"vpy_180_2oi_AAAA","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p022:m0105","start":105,"end":107,"surfa