"c-shiji-042-zheng:m001-0012","c-shiji-042-zheng:m001-0018","c-shiji-042-zheng:m028-0111"],"paragraph_ids":["c-shiji-042-zheng:p001","c-shiji-042-zheng:p028"],"passage_count":2}],"most_mentioned_source_ids":["s-shiji-042-zheng"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-042-zheng:m001-0012","start":12,"end":14,"surface":"宣王","kind":"person","person_id":"cbr-p002097","status":"contextual_provisional","paragraph_id":"c-shiji-042-zheng:p001","chapter_id":"c-shiji-042-zheng"},{"id":"c-shiji-042-zheng:m001-0018","start":18,"end":20,"surface":"宣王","kind":"person","person_id":"cbr-p002097","status":"contextual_provisional","paragraph_id":"c-shiji-042-zheng:p001","chapter_id":"c-shiji-042-zheng"},{"id":"c-shiji-042-zheng:m028-0111","start":111,"end":113,"surface":"宣王","kind":"person","person_id":"cbr-p002097","status":"contextual_provisional","paragraph_id":"c-shiji-042-zheng:p028","chapter_id":"c-shiji-042-zheng"}],"relations":[{"id":"a-shiji042-002","subject_person_id":"cbr-p002095","predicate":"brother","object_person_id":"cbr-p002097","status":"source_attested","evidence":[{"chapter_id":"c-shiji-042-zheng","source_id":"s-shiji-042-zheng","paragraph_id":"c-shiji-042-zheng:p001","quote":"鄭桓公友者，周厲王少子而宣王庶弟也。宣王立二十二年，友初封于鄭。封三十三歳，百姓皆便愛之。幽王以爲司徒。和集周民，周民皆説，河雒之閒，人便思之。爲司徒一歳，幽王以褒后故，王室治多邪，諸侯或畔之。於是桓公問太史伯曰：「王室多故，予安逃死乎？」太史伯對曰：「獨雒之東土，河濟之南可居。」公曰：「何以？」對曰：「地近虢、鄶，虢、鄶之君貪而好利，百姓不附。今公爲司徒，民皆愛公，公誠請居之，虢、鄶之君見公方用事，輕分公地。公誠居之，虢、鄶之民皆公之民也。」公曰：「吾欲南之江上，何如？」對曰：「昔祝融爲髙辛氏火正，其功大矣，而其於周未有興者，楚其後也。周衰，楚必興。興，非鄭之利也。」公曰：「吾欲居西方，何如？」對曰：「其民貪而好利，難久居。」公曰：「周衰，何國興者？」對曰：「齊、秦、晉、楚乎？夫齊，姜姓，伯夷之後也，伯夷佐堯典禮。秦，嬴姓，伯翳之後也，伯翳佐舜懷柔百物。及楚之先，皆嘗有功於天下。而周武王克紂後，成王封叔虞于唐，其地阻險，以此有德與周衰并，亦必興矣。」桓公曰：「善。」於是卒言王，東徙其民雒東，而虢、鄶果獻十邑，竟國之。"}],"qualifiers":{"source_term":"宣王庶弟","historicity":"historical_tradition"},"interpretation_note":"保存本段明示子、生育、母稱與兄弟來源主張；不把繼位獨自作父子，不補未知母名或同父同母。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji042-003","person_id":"cbr-p002097","surfaces":["宣王"],"scope":"same_chapter","chapter_ids":["c-shiji-042-zheng"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-042-zheng:p001","quote":"鄭桓公友者，周厲王少子而宣王庶弟也。宣王立二十二年，友初封于鄭。封三十三歳，百姓皆便愛之。幽王以爲司徒。和集周民，周民皆説，河雒之閒，人便思之。爲司徒一歳，幽王以褒后故，王室治多邪，諸侯或畔之。於是桓公問太史伯曰：「王室多故，予安逃死乎？」太史伯對曰：「獨雒之東土，河濟之南可居。」公曰：「何以？」對曰：「地近虢、鄶，虢、鄶之君貪而好利，百姓不附。今公爲司徒，民皆愛公，公誠請居之，虢、鄶之君見公方用事，輕分公地。公誠居之，虢、鄶之民皆公之民也。」公曰：「吾欲南之江上，何如？」對曰：「昔祝融爲髙辛氏火正，其功大矣，而其於周未有興者，楚其後也。周衰，楚必興。興，非鄭之利也。」公曰：「吾欲居西方，何如？」對曰：「其民貪而好利，難久居。」公曰：「周衰，何國興者？」對曰：「齊、秦、晉、楚乎？夫齊，姜姓，伯夷之後也，伯夷佐堯典禮。秦，嬴姓，伯翳之後也，伯翳佐舜懷柔百物。及楚之先，皆嘗有功於天下。而周武王克紂後，成王封叔虞于唐，其地阻險，以此有德與周衰并，亦必興矣。」桓公曰：「善。」於是卒言王，東徙其民雒東，而虢、鄶果獻十邑，竟國之。"},{"paragraph_id":"c-shiji-042-zheng:p028","quote":"七年，鄭與晉盟鄢陵。八年，楚莊王以鄭與晉盟，來伐，圍鄭三月，鄭以城降楚。楚王入自皇門，鄭襄公肉袒掔羊以迎，曰：「孤不能事邊邑，使君王懷怒以及獘邑，孤之罪也。敢不惟命是聽。君王遷之江南，及以賜諸侯，亦惟命是聽。若君王不忘厲、宣王，桓、武公，哀不忍絶其社稷，錫不毛之地，使復得改事君王，孤之願也，然非所敢望也。敢布腹心，惟命是聽。」莊王爲卻三十里而後舍。楚群臣曰：「自郢至此，士大夫亦久勞矣。今得國捨之，何如？」莊王曰：「所爲伐，伐不服也。今已服，尚何求乎？」卒去。晉聞楚之伐鄭，發兵救鄭。其來持兩端，故遲，比至河，楚兵已去。晉將率或欲渡，或欲還，卒渡河。莊王聞，還撃晉。鄭反助楚，大破晉軍於河上。十年，晉來伐鄭，以其反晉而親楚也。"}],"rationale":"依本篇名字、是為、世系及連續事件暫接異稱；同諡不同國分開，建子勝與聲公勝不合併，如兄弟為譬喻不作親屬。述贊與正文不算獨立來源，省稱、古字與校勘仍待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-042-zheng:p001","text":"鄭桓公友者，周厲王少子而宣王庶弟也。宣王立二十二年，友初封于鄭。封三十三歳，百姓皆便愛之。幽王以爲司徒。和集周民，周民皆説，河雒之閒，人便思之。爲司徒一歳，幽王以褒后故，王室治多邪，諸侯或畔之。於是桓公問太史伯曰：「王室多故，予安逃死乎？」太史伯對曰：「獨雒之東土，河濟之南可居。」公曰：「何以？」對曰：「地近虢、鄶，虢、鄶之君貪而好利，百姓不附。今公爲司徒，民皆愛公，公誠請居之，虢、鄶之君見公方用事，輕分公地。公誠居之，虢、鄶之民皆公之民也。」公曰：「吾欲南之江上，何如？」對曰：「昔祝融爲髙辛氏火正，其功大矣，而其於周未有興者，楚其後也。周衰，楚必興。興，非鄭之利也。」公曰：「吾欲居西方，何如？」對曰：「其民貪而好利，難久居。」公曰：「周衰，何國興者？」對曰：「齊、秦、晉、楚乎？夫齊，姜姓，伯夷之後也，伯夷佐堯典禮。秦，嬴姓，伯翳之後也，伯翳佐舜懷柔百物。及楚之先，皆嘗有功於天下。而周武王克紂後，成王封叔虞于唐，其地阻險，以此有德與周衰并，亦必興矣。」桓公曰：「善。」於是卒言王，東徙其民雒東，而虢、鄶果獻十邑，竟國之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-042-zheng:m001-0000","start":0,"end":4,"surfac