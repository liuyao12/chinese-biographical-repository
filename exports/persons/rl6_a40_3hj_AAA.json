c-shiji-102-zhangfeng:m013-0042","chapter_id":"c-shiji-102-zhangfeng","paragraph_id":"c-shiji-102-zhangfeng:p013","quote":"唐"},{"mention_id":"c-shiji-102-zhangfeng:m011-0045","chapter_id":"c-shiji-102-zhangfeng","paragraph_id":"c-shiji-102-zhangfeng:p011","quote":"父老"},{"mention_id":"c-shiji-102-zhangfeng:m011-0110","chapter_id":"c-shiji-102-zhangfeng","paragraph_id":"c-shiji-102-zhangfeng:p011","quote":"父"}],"family_path":{"parent_person_id":"rl6_a40_3hj_A","connection":"father","status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-102-zhangfeng","source_id":"s-shiji-102-zhangfeng","paragraph_id":"c-shiji-102-zhangfeng:p011","quote":"馮唐者，其大父趙人。父徙代。漢興徙安陵。唐以孝著，爲中郎署長，事文帝。文帝輦過，問唐曰：「父老何自爲郎？家安在？」唐具以實對。文帝曰：「吾居代時，吾尚食監高袪數爲我言趙將李齊之賢，戰於鉅鹿下。今吾每飯，意未嘗不在鉅鹿也。父知之乎？」唐對曰：「尚不如廉頗、李牧之爲將也。」上曰：「何以？」唐曰：「臣大父在趙時，爲官（卒）［率］將，善李牧。臣父故爲代相，善趙將李齊，知其爲人也。」上既聞廉頗、李牧爲人，良説，而搏髀曰：「嗟乎！吾獨不得廉頗、李牧時爲吾將，吾豈憂匈奴哉！」唐曰：「主臣！陛下雖得廉頗、李牧，弗能用也。」上怒，起入禁中。良久，召唐讓曰：「公柰何眾辱我，獨無閒處乎？」唐謝曰：「鄙人不知忌諱。」"}],"interpretation_note":"本篇明示父子，匿名父祖不補姓名；分支字母不表示出生排行。","reviewer":"Codex（AI 代理）","human_reviewed":false}},{"id":"rl6_a40_3hj_AAA","label":"馮遂（張釋之馮唐列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"馮遂","mention_ids":["c-shiji-102-zhangfeng:m013-0044"]},{"surface":"遂","mention_ids":["c-shiji-102-zhangfeng:m013-0049"]},{"surface":"王孫","mention_ids":["c-shiji-102-zhangfeng:m013-0051"]}],"evidence":[{"mention_id":"c-shiji-102-zhangfeng:m013-0044","chapter_id":"c-shiji-102-zhangfeng","paragraph_id":"c-shiji-102-zhangfeng:p013","quote":"馮遂"},{"mention_id":"c-shiji-102-zhangfeng:m013-0049","chapter_id":"c-shiji-102-zhangfeng","paragraph_id":"c-shiji-102-zhangfeng:p013","quote":"遂"},{"mention_id":"c-shiji-102-zhangfeng:m013-0051","chapter_id":"c-shiji-102-zhangfeng","paragraph_id":"c-shiji-102-zhangfeng:p013","quote":"王孫"}],"family_path":{"parent_person_id":"rl6_a40_3hj_AA","connection":"father","status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-102-zhangfeng","source_id":"s-shiji-