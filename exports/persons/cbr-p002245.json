8,"surface":"晉景公","kind":"person","person_id":"cbr-p002269","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m017-0013","start":13,"end":15,"surface":"大業","kind":"person","person_id":"cbr-p002279","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m017-0023","start":23,"end":25,"surface":"景公","kind":"person","person_id":"cbr-p002269","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m017-0026","start":26,"end":28,"surface":"韓厥","kind":"person","person_id":"cbr-p002275","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m017-0029","start":29,"end":30,"surface":"厥","kind":"person","person_id":"cbr-p002275","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m017-0031","start":31,"end":33,"surface":"趙孤","kind":"person","person_id":"cbr-p002278","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m017-0039","start":39,"end":41,"surface":"大業","kind":"person","person_id":"cbr-p002279","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m017-0056","start":56,"end":58,"surface":"中衍","kind":"person","person_id":"cbr-p002230","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m017-0064","start":64,"end":66,"surface":"中衍","kind":"person","person_id":"cbr-p002230","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m017-0073","start":73,"end":77,"surface":"殷帝大戊","kind":"person","person_id":"cbr-p002231","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m017-0079","start":79,"end":82,"surface":"周天子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、神祇、馬匹、校勘或未定稱呼保留；不補名字、成員或闕代，故事說詞不作真孤被殺證據。"},{"id":"c-shiji-043-zhao:m017-0090","start":90,"end":92,"surface":"幽厲","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、神祇、馬匹、校勘或未定稱呼保留；不補名字、成員或闕代，故事說詞不作真孤被殺證據。"},{"id":"c-shiji-043-zhao:m017-0096","start":96,"end":98,"surface":"叔帶","kind":"person","person_id":"cbr-p002245","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m017-0104","start":104,"end":108,"surface":