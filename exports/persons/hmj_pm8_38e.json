[{"id":"th-shiji108-046","person_id":"hmj_pm8_38e","title":"詹事","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-108-han","source_id":"s-shiji-108-han","paragraph_id":"c-shiji-108-han:p014","quote":"太史公曰：余與壺遂定律暦，觀韓長孺之義，壺遂之深中隱厚。世之言梁多長者，不虛哉！壺遂官至詹事，天子方倚以爲漢相，會遂卒。不然，壺遂之內廉行修，斯鞠躬君子也。"}],"attestations":[{"id":"th-shiji108-046:a001","paragraph_id":"c-shiji-108-han:p014","start":44,"end":46,"surface":"詹事","person_mention_id":"c-shiji-108-han:m014-0007","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"記來源任官或用稱；未明年月及終止事件保持未知，篇末附載評論不作獨立任官證據。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-108-han:p011","text":"安國爲人多大略，智足以當世取合，而出於忠厚焉。貪嗜於財。所推舉皆廉士，賢於己者也。於梁舉壺遂、臧固、郅他，皆天下名士，士亦以此稱慕之，唯天子以爲國器。安國爲御史大夫四歳餘，丞相田蚡死，安國行丞相事，奉引墮車蹇。天子議置相，欲用安國，使使視之，蹇甚，乃更以平棘侯薛澤爲丞相。安國病免數月，蹇愈，上復以安國爲中尉。歳餘，徙爲衞尉。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-108-han:m011-0000","start":0,"end":2,"surface":"安國","kind":"person","person_id":"6hy_i1z_hu2","status":"contextual_provisional"},{"id":"c-shiji-108-han:m011-0044","start":44,"end":46,"surface":"壺遂","kind":"person","person_id":"hmj_pm8_38e","status":"contextual_provisional"},{"id":"c-shiji-108-han:m011-0047","start":47,"end":49,"surface":"臧固","kind":"person","person_id":"z6u_kf1_554","status":"contextual_provisional"},{"id":"c-shiji-108-han:m011-0050","start":50,"end":52,"surface":"郅他","kind":"person","person_id":"xqk_r2h_w1e","status":"contextual_provisional"},{"id":"c-shiji-108-han:m011-0068","start":68,"end":70,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-108-han:m011-0075","start":75,"