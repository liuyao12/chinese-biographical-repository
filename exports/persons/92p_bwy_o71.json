tus":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-043-guoshu:line129","text":"郭舒，字稚行。幼請其母從師，歲餘便歸，粗識大義。鄉人少府范晷、宗人武陵太守郭景，咸稱舒當為後來之秀，終成國器。始為領軍校尉，坐擅放司馬彪，系廷尉，世多義之。刺史夏侯含辟為西曹，轉主簿。含坐事，舒自系理含，事得釋。刺史宗岱命為治中，喪母去職。劉弘牧荊州，引為治中。弘卒，舒率將士推弘子璠為主，討逆賊郭勱。滅之，保全一州。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-043-guoshu:line129:m0000","start":0,"end":2,"surface":"郭舒","kind":"person","person_id":"nyu_drp_roe","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-guoshu:line129:m0004","start":4,"end":6,"surface":"稚行","kind":"person","person_id":"nyu_drp_roe","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-guoshu:line129:m0010","start":10,"end":11,"surface":"母","kind":"person","person_id":"aza_g02_kq1","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-guoshu:line129:m0028","start":28,"end":30,"surface":"范晷","kind":"person","person_id":"0uo_tvu_vhp","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-guoshu:line129:m0037","start":37,"end":39,"surface":"郭景","kind":"person","person_id":"1uq_e45_wp8","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-guoshu:line129:m0042","start":42,"end":43,"surface":"舒","kind":"person","person_id":"nyu_drp_roe","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-guoshu:line129:u0065","start":65,"end":68,"surface":"司馬彪","kind":"unresolved","person_id":null,"status":"unresolved","unresolved_kind":"unresolved_source_person","interpretation_note":"此人為郭舒所放。本傳不具字、家支或官歷，不能由同名立即連接《續漢書》作者。"},{"id":"c-jinshu-043-guoshu:line129:m0080","start":80,"end":83,"surfac