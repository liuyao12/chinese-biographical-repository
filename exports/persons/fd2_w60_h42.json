art":169,"end":171,"surface":"李斯","kind":"person","person_id":"49g_7az_e4i","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m001-0175","start":175,"end":177,"surface":"蒙驁","kind":"person","person_id":"k2p_5ol_dwh","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m001-0178","start":178,"end":180,"surface":"王齮","kind":"person","person_id":"2wl_dla_w69","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m001-0181","start":181,"end":183,"surface":"麃公","kind":"person","person_id":"na8_45f_m80","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m001-0188","start":188,"end":189,"surface":"王","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或王稱指代待核；不補造姓名與成員。"},{"id":"c-shiji-006-shihuang:m001-0199","start":199,"end":201,"surface":"大臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或王稱指代待核；不補造姓名與成員。"}],"chapter_id":"c-shiji-006-shihuang","book_id":"b-shiji-006","work_id":"w-shiji","source_id":"s-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:p002","text":"秦始皇元年，將軍蒙驁擊定之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:m002-0000","start":0,"end":3,"surface":"秦始皇","kind":"person","person_id":"ao3_0fy_d45_AAA","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m002-0006","start":6,"end":10,"surface":"將軍蒙驁","kind":"person","person_id":"k2p_5ol_dwh","status":"contextual_provisional"}],"chapter_id":"c-shiji-006-shihuang","book_id":"b-shiji-006","work_id":"w-shiji","source_id":"s-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:p004","text":"三年，蒙驁攻韓，取十三城。王齮死。十月，將軍蒙驁攻魏氏暢、有詭。歲大饑。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:m004-0003","start":3,"end":5,"surface":"蒙驁","kind":"person","person_id":"k2p_5ol_dwh","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m004-0013","start":13,"end":15,"surface":"王齮","kind":"person","person_id":"2wl_dla_w69","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m004-0020","start":20,"end":24,"surface":"將軍蒙驁","kind":"person","person_id":"k2p_5ol_dwh","status":"contextual_provisional"}],"chapter_id":"c-shiji-006-shihuang","book_id":"b-shiji-006","work_id":"w-shiji","source_id":"s-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:p006","text":"五年，將軍驁攻魏，定酸棗、燕、虛、長平、雍丘、山陽城，皆拔之，取二十城。初置東郡。冬雷。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:m006-0005","start":5,"end":6,"surface":"驁","kind":"person","person_id":"k2p_5ol_dwh","status":"contextual_provisional"}],"chapter_id":"c-shiji-006-shihuang","book_id":"b-shiji-006","work_id":"w-shiji","source_id":"s-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:p008","text":"七年，彗星先出東方，見北方，五月見西方。將軍驁死。以攻龍、孤、慶都，還兵攻汲。彗星復見西方十六日。夏太后死。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:m008-0022","start":22,"end":23,"surface":"驁","kind":"person","person_id":"k2p_5ol_dwh","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m008-0049","start":49,"end":52,"surface":"夏太后","kind":"person","person_id":"pz6_lqa_ina","status":"contextual_provisional"}],"chapter_id":"c-shiji-006-shihuang","book_id":"b-shiji-006","work_id":"w-shiji","source_id":"s-shiji-006-shihuang"},{"id":"c-shiji-088-mengtian:p001","text":"蒙恬者，其先齊人也。恬大父蒙驁，自齊事秦昭王，官至上卿。秦莊襄王元年，蒙驁為秦將，伐韓，取成皋、滎陽，作置三川郡。二年，蒙驁攻趙，取三十七城。始皇三年，蒙驁攻韓，取十三城。五年，蒙驁攻魏，取二十城，作置東郡。始皇七年，蒙驁卒。驁子曰武，武子曰恬。恬嘗書獄典文學。始皇二十三年，蒙武為秦裨將軍，與王翦攻楚，大破之，殺項燕。二十四年，蒙武攻楚，虜楚王。蒙恬弟毅。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-088-mengtian:m001-0000","start":0,"end":2,"surface":"蒙恬","kind":"person","person_id":"fd2_w60_h42_AA","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m001-0004","start":4,"end":6,"surface":"其先","kind":"unresolved","person_id":null,"status":"unresolved","note":"先人、族稱或群體保留未解，不補直接父系或個人姓名。"},{"id":"c-shiji-088-mengtian:m001-0010","start":10,"end":11,"surface":"恬","kind":"person","person_id":"fd2_w60_h42_AA","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m001-0013","start":13,"end":15,"surface":"蒙驁","kind":"person","person_id":"fd2_w60_h42","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m001-0019","start":19,"end":22,"surface":"秦昭王","kind":"person","person_id":"lxx_qu4_p2d","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m001-0028","start":28,"end":32,"surface":"秦莊襄王","kind":"person","person_id":"eyp_jnx_te1","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m001-0035","start":35,"end":37,"surface":"蒙驁","kind":"person","person_id":"fd2_w60_h42","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m001-0060","start":60,"end":62,"surface":"蒙驁","kind":"person","person_id":"fd2_w60_h42","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m001-0071","start":71,"end":73,"surface":"始皇","kind":"person","person_id":"rd8_urn_g2l","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m001-0076","start":76,"end":78,"surface":"蒙驁","kind":"person","person_id":"fd2_w60_h42","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m001-0089","start":89,"end":91,"surface":"蒙驁","kind":"person","person_id":"fd2_w60_h42","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m001-0104","start":104,"end":106,"surface":"始皇","kind":"person","person_id":"rd8_urn_g2l","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m001-0109","start":109,"end":111,"surface":"蒙驁","kind":"person","person_id":"fd2_w60_h42","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m001-0113","start":113,"end":114,"surface":"驁","kind":"person","person_id":"fd2_w60_h42","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m001-0116","start":116,"end":117,"surface":"武","kind":"person","person_id":"fd2_w60_h42_A","status":"contextual_provisional