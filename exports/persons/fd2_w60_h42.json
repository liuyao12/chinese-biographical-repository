ations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji006-005","person_id":"k2p_5ol_dwh","surfaces":["蒙驁"],"scope":"cross_chapter","chapter_ids":["c-shiji-005-qin","c-shiji-006-shihuang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-005-qin:p074","quote":"莊襄王元年，大赦罪人，修先王功臣，施德厚骨肉而布惠於民。東周君與諸侯謀秦，秦使相國呂不韋誅之，盡入其國。秦不絕其祀，以陽人地賜周君，奉其祭祀。使蒙驁伐韓，韓獻成皋、鞏。秦界至大梁，初置三川郡。二年，使蒙驁攻趙，定太原。三年，蒙驁攻魏高都、汲，拔之。攻趙榆次、新城、狼孟，取三十七城。四月日食。（四年）王齕攻上黨。初置太原郡。魏將無忌率五國兵擊秦，秦卻於河外。蒙驁敗，解而去。五月丙午，莊襄王卒，子政立，是為秦始皇帝。"},{"paragraph_id":"c-shiji-006-shihuang:p001","quote":"秦始皇帝者，秦莊襄王子也。莊襄王為秦質子於趙，見呂不韋姬，悅而取之，生始皇。以秦昭王四十八年正月生於邯鄲。及生，名為政，姓趙氏。年十三歲，莊襄王死，政代立為秦王。當是之時，秦地已并巴、蜀、漢中，越宛有郢，置南郡矣；北收上郡以東，有河東、太原、上黨郡；東至滎陽，滅二周，置三川郡。呂不韋為相，封十萬戶，號曰文信侯。招致賓客游士，欲以并天下。李斯為舍人。蒙驁、王齮、麃公等為將軍。王年少，初即位，委國事大臣。晉陽反。"}],"rationale":"依連續秦王即位敘事及人物在同一時期的職事暫定跨卷同指；不全庫同字匹配。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji088-002","person_id":"fd2_w60_h42","surfaces":["蒙驁","驁"],"scope":"same_chapter","chapter_ids":["c-shiji-088-mengtian"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-088-mengtian:p001","quote":"蒙恬者，其先齊人也。恬大父蒙驁，自齊事秦昭王，官至上卿。秦莊襄王元年，蒙驁為秦將，伐韓，取成皋、滎陽，作置三川郡。二年，蒙驁攻趙，取三十七城。始皇三年，蒙驁攻韓，取十三城。五年，蒙驁攻魏，取二十城，作置東郡。始皇七年，蒙驁卒。驁子曰武，武子曰恬。恬嘗書獄典文學。始皇二十三年，蒙武為秦裨將軍，與王翦攻楚，大破之，殺項燕。二十四年，蒙武攻楚，虜楚王。蒙恬弟毅。"}],"rationale":"依蒙氏世系與任職敘事局部承接暫接；驁、武、恬、毅限本段或局部語境，不作全域字串匹配。秦王與帝按始皇前後敘事暫接；被虜楚王與趙高母保留未名，隱宮宦籍不另補身分。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji088-ao","person_ids":["k2p_5ol_dwh","fd2_w60_h42"],"canonical_person_id":"k2p_5ol_dwh","scope":"cross_chapter","chapter_ids":["c-shiji-006-shihuang","c-shiji-088-mengtian"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-006-shihuang","source_id":"s-shiji-006-shihuang","paragraph_id":"c-shiji-006-shihuang:p001","quote":"秦始皇帝者，秦莊襄王子也。莊襄王為秦質子於趙，見呂不韋姬，悅而取之，生始皇。以秦昭王四十八年正月生於邯鄲。及生，名為政，姓趙氏。年十三歲，莊襄王死，政代立為秦王。當是之時，秦地已并巴、蜀、漢中，越宛有郢，置南郡矣；北收上郡以東，有河東、太原、上黨郡；東至滎陽，滅二周，置三川郡。呂不韋為相，封十萬戶，號曰文信侯。招致賓客游士，欲以并天下。李斯為舍人。蒙驁、王齮、麃公等為將軍。王年少，初即位，委國事大臣。晉陽反。","mention_ids":["c-shiji-006-shihuang:m001-0175"]},{"chapter_id":"c-shiji-006-shihuang","source_id":"s-shiji-006-shihuang","paragraph_id":"c-shiji-006-shihuang:p008","quote":"七年，彗星先出東方，見北方，五月見西方。將軍驁死。以攻龍、孤、慶都，還兵攻汲。彗星復見西方十六日。夏太后死。","mention_ids":["c-shiji-006-shihuang:m008-0022"]},{"chapter_id":"c-shiji-088-mengtian","source_id":"s-shiji-088-mengtian","paragraph_id":"c-shiji-088-mengtian:p001","quote":"蒙恬者，其先齊人也。恬大父蒙驁，自齊事秦昭王，官至上卿。秦莊襄王元年，蒙驁為秦將，伐韓，取成皋、滎陽，作置三川郡。二年，蒙驁攻趙，取三十七城。始皇三年，蒙驁攻韓，取十三城。五年，蒙驁攻魏，取二十城，作置東郡。始皇七年，蒙驁卒。驁子曰武，武子曰恬。恬嘗書獄典文學。始皇二十三年，蒙武為秦裨將軍，與王翦攻楚，大破之，殺項燕。二十四年，蒙武攻楚，虜楚王。蒙恬弟毅。","mention_ids":["c-shiji-088-mengtian:m001-0013","c-shiji-088-mengtian:m001-0035","c-shiji-088-mengtian:m001-0060","c-shiji-088-mengtian:m001-0076","c-shiji-088-mengtian:m001-0089","c-shiji-088-mengtian:m001-0109","c-shiji-088-mengtian:m001-0113"]}],"rationale":"秦將蒙驁及始皇七年卒的姓名、職事與紀年相配；本篇蒙氏祖孫關係仍以本篇明示為據。 各篇原字、原文與已發ID保留，同書不視為獨立見證；同指不確證所有紀年、任職、親屬或敘事，不按全域同名批量改號。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-005-qin:p074","text":"莊襄王元年，大赦罪人，修先王功臣，施德厚骨肉而布惠於民。東周君與諸侯謀秦，秦使相國呂不韋誅之，盡入其國。秦不絕其祀，以陽人地賜周君，奉其祭祀。使蒙驁伐韓，韓獻成皋、鞏。秦界至大梁，初置三川郡。二年，使蒙驁攻趙，定太原。三年，蒙驁攻魏高都、汲，拔之。攻趙榆次、新城、狼孟，取三十七城。四月日食。（四年）王齕攻上黨。初置太原郡。魏將無忌率五國兵擊秦，秦卻於河外。蒙驁敗，解而去。五月丙午，莊襄王卒，子政立，是為秦始皇帝。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m074-0000","start":0,"end":3,"surface":"莊襄王","kind":"person","person_id":"ao3_0fy_d45_AA","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m074-0028","start":28,"end":31,"surface":"東周君","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、氏族、群體或未核指代；不補造個人或按熟知世系自動合併。"},{"id":"c-shiji-005-qin:m074-0039","start":39,"end":44,"surface":"相國呂不韋","kind":"person","person_id":"puu_6hs_m4f","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m074-0063","start":63,"end":65,"surface":"周君","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、氏族、群體或未核指代；不補造個人或按熟知世系自動合併。"},{"id":"c-shiji-