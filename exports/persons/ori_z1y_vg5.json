nd":"person","person_id":"ori_z1y_vg5","status":"contextual_provisional","paragraph_id":"c-shiji-100-jibu:p003","chapter_id":"c-shiji-100-jibu"},{"id":"c-shiji-100-jibu:m009-0000","start":0,"end":2,"surface":"孝文","kind":"person","person_id":"ori_z1y_vg5","status":"contextual_provisional","paragraph_id":"c-shiji-100-jibu:p009","chapter_id":"c-shiji-100-jibu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji100-017","person_id":"ori_z1y_vg5","surfaces":["孝文"],"scope":"same_chapter","chapter_ids":["c-shiji-100-jibu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-100-jibu:p003","quote":"季布爲河東守，孝文時，人有言其賢者，孝文召，欲以爲御史大夫。復有言其勇，使酒難近。至，留邸一月，見罷。季布因進曰：「臣無功竊寵，待罪河東。陛下無故召臣，此人必有以臣欺陛下者；今臣至，無所受事，罷去，此人必有以毀臣者。夫陛下以一人之譽而召臣，一人之毀而去臣，臣恐天下有識聞之有以闚陛下也。」上默然慚，良久曰：「河東吾股肱郡，故特召君耳。」布辭之官。"},{"paragraph_id":"c-shiji-100-jibu:p009","quote":"孝文時，爲燕相，至將軍。布乃稱曰：「窮困不能辱身下志，非人也；富貴不能快意，非賢也。」於是嘗有德者厚報之，有怨者必以法滅之。呉（軍）［楚］反時，以軍功封兪侯，復爲燕相。燕齊之閒皆爲欒布立社，號曰欒公社。"}],"rationale":"依季布及欒布兩傳敘事承接，同名單字布分段處理；母弟詮釋有分歧，暫不定世系，長事弟畜不當血親，欲授未授不作實任。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-100-jibu:p003","text":"季布爲河東守，孝文時，人有言其賢者，孝文召，欲以爲御史大夫。復有言其勇，使酒難近。至，留邸一月，見罷。季布因進曰：「臣無功竊寵，待罪河東。陛下無故召臣，此人必有以臣欺陛下者；今臣至，無所受事，罷去，此人必有以毀臣者。夫陛下以一人之譽而召臣，一人之毀而去臣，臣恐天下有識聞之有以闚陛下也。」上默然慚，良久曰：「河東吾股肱郡，故特召君耳。」布辭之官。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-100-jibu:m003-0000","start":0,"end":2,"surface":"季布","kind":"person","person_id":"udu_dyy_4wd","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m003-0007","start":7,"end":9,"surface":"孝文","kind":"person","person_id":"ori_z1y_vg5","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m003-0011","start":11,"end":17,"surface":"人有言其賢者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、合稱或待辨匿名指代，不補成員。"},{"id":"c-shiji-100-j