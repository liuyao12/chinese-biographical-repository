i-101-yuanchao","paragraph_id":"c-shiji-101-yuanchao:p004","quote":"淮南厲王朝，殺辟陽侯，居處驕甚。袁盎諫曰：「諸侯大驕必生患，可適削地。」上弗用。淮南王益橫。及棘蒲侯柴武太子謀反事覺，治，連淮南王，淮南王徵，上因遷之蜀，轞車傳送。袁盎時為中郎將，乃諫曰：「陛下素驕淮南王，弗稍禁，以至此，今又暴摧折之。淮南王為人剛，如有遇霧露行道死，陛下竟為以天下之大弗能容，有殺弟之名，柰何？」上弗聽，遂行之。","source_term":"柴武太子"}],"interpretation_note":"本篇明示父子；未具名者只留來源身分。太子不推為長子，分支字母不表示出生排行。","reviewer":"Codex（AI 代理）","human_reviewed":false}}],"source_mention_summary":[{"source_id":"s-shiji118-huainan","work_id":"w-shiji","book_id":"b-shiji-118","chapter_id":"c-shiji-118-huainan","mention_count":2,"mention_ids":["c-shiji-118-huainan:m003-0017","c-shiji-118-huainan:m004-0164"],"paragraph_ids":["c-shiji-118-huainan:p003","c-shiji-118-huainan:p004"],"passage_count":2},{"source_id":"s-shiji-010-wendi","work_id":"w-shiji","book_id":"b-shiji-010","chapter_id":"c-shiji-010-wendi","mention_count":1,"mention_ids":["c-shiji-010-wendi:m023-0042"],"paragraph_ids":["c-shiji-010-wendi:p023"],"passage_count":1},{"source_id":"s-shiji-101-yuanchao","work_id":"w-shiji","book_id":"b-shiji-101","chapter_id":"c-shiji-101-yuanchao","mention_count":1,"mention_ids":["c-shiji-101-yuanchao:m004-0052"],"paragraph_ids":["c-shiji-101-yuanchao:p004"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji118-huainan"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji101-003","subject_person_id":"tqe_7o9_t4k_A","predicate":"father","object_person_id":"tqe_7o9_t4k","status":"source_attested","evidence":[{"chapter_id":"c-shiji-101-yuanchao","source_id":"s-shiji-101-yuanchao","paragraph_id":"c-shiji-101-yuanchao:p004","quote":"淮南厲王朝，殺辟陽侯，居處驕甚。袁盎諫曰：「諸侯大驕必生患，可適削地。」上弗用。淮南王益橫。及棘蒲侯柴武太子謀反事覺，治，連淮南王，淮南王徵，上因遷之蜀，轞車傳送。袁盎時為中郎將，乃諫曰：「陛下素驕淮南王，弗稍禁，以至此，今又暴摧折之。淮南王為人剛，如有遇霧露行道死，陛下竟為以天下之大弗能容，有殺弟之名，柰何？」上弗聽，遂行之。"}],"qualifiers":{"source_term":"柴武太子","historicity":"