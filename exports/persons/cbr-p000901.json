{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000901","identity_policy":"contextual_provisional","person_ids":["cbr-p000901"],"persons":[{"id":"cbr-p000901","label":"奇（棘蒲侯太子）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"太子奇","mention_ids":["c-shiji-010-wendi:m023-0042"]}],"evidence":[{"mention_id":"c-shiji-010-wendi:m023-0042","chapter_id":"c-shiji-010-wendi","paragraph_id":"c-shiji-010-wendi:p023","quote":"太子奇"}]}],"mentions":[{"id":"c-shiji-010-wendi:m023-0042","start":42,"end":45,"surface":"太子奇","kind":"person","person_id":"cbr-p000901","status":"contextual_provisional","paragraph_id":"c-shiji-010-wendi:p023","chapter_id":"c-shiji-010-wendi"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-010-wendi:p023","text":"六年，有司言淮南王長廢先帝法，不聽天子詔，居處毋度，出入擬於天子，擅為法令，與棘蒲侯太子奇謀反，遣人使閩越及匈奴，發其兵，欲以危宗廟社稷。群臣議，皆曰「長當棄市」帝不忍致法於王，赦其罪，廢勿王。群臣請處王蜀嚴道、邛都，帝許之。長未到處所，行病死，上憐之。後十六年，追尊淮南王長謚為厲王，立其子三人為淮南王、衡山王、廬江王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-010-wendi:m023-0006","start":6,"end":10,"surface":"淮南王長","kind":"person","person_id":"cbr-p000809","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m023-0017","start":17,"end":19,"surface":"天子","kind":"person","person_id":"cbr-p000806","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m023-0030","start":30,"end":32,"surface":"天子","kind":"person","person_id":"cbr-p000806","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m023-0039","start":39,"end":42,"surface":"棘蒲侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、群體或神祇指稱未定；不補未見姓名或血親。"},{"id":"c-shiji-010-wendi:m023-0042","start":42,"end":45,"surface":"太子奇","kind":"person","person_id":"cbr-p000901","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m023-0081","start":81,"end":82,"surface