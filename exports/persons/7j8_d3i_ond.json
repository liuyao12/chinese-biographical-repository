iji-044-wei","source_id":"s-shiji-044-wei","paragraph_id":"c-shiji-044-wei:p037","quote":"卅一年，秦、趙、齊共伐我，秦將商君詐我將軍公子卬而襲奪其軍，破之。秦用商君，東地至河，而齊、趙數破我，安邑近秦，於是徙治大梁。以公子赫爲太子。"}],"attestations":[{"id":"th-shiji044-027:a001","paragraph_id":"c-shiji-044-wei:p037","start":19,"end":21,"surface":"將軍","person_mention_id":"c-shiji-044-wei:m037-0021","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"用稱、授予、追尊與任事分存；爭太子、俘虜與死亡不推持有或全部有效終點。原紀年未換算，惠王敘事與追尊王號並存，版本及制度種類待核。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[{"id":"shiji-015-r137-c03-m012","start":12,"end":15,"surface":"公子卬","person_id":"7j8_d3i_ond","status":"contextual_provisional","interpretation_note":"依國別、紀年及原格上下文暫定；保留異文，不據同名自動合併。","table_id":"shiji-015","table_fragment_id":"shiji-015-digital-table-1","table_row_id":"shiji-015-r137","table_cell_id":"shiji-015-r137-c03","work_id":"w-shiji","book_id":"b-shiji-015","chapter_id":"table-chapter-shiji-015","source_id":"table-witness-shiji-015","source_revision":"2607002","kind":"table_person_mention","quote":"三十一。秦商君伐我，虜我公子卬。"}],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji043-147","person_id":"7j8_d3i_ond","surfaces":["公子卬"],"scope":"same_chapter","chapter_ids":["c-shiji-043-zhao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-043-zhao:p055","quote":"肅侯元年，奪晉君端氏，徙處屯留。二年，與魏惠王遇於陰晉。三年，公子范襲邯鄲，不勝而死。四年，朝天子。六年，攻齊，拔髙唐。七年，公子刻攻魏首垣。十一年，秦孝公使商君伐魏，虜其將公子卬。趙伐魏。十二年，秦孝公卒，商君死。十五年，起壽陵。魏惠王卒。"}],"rationale":"限本篇明示姓名、是為與連續事件；太戊午／大戊午暫接但字形待底本核查。娃嬴／孟姚／惠后按本段明示暫接，不與先前夢辭孟姚按同名合併；王紲與較早公子紲分候選。君王職稱按各國上下文辨別，不全域匹配。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji044-069","person_id":"7j8_d3i_ond","surfaces":["公子卬"],"scope":"same_chapter","chapter_ids":["c-shiji-044-wei"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-044-wei:p037","quote":"卅一年，秦、趙、齊共伐我，秦將商君詐我將軍公子卬而襲奪其軍，破之。秦用商君，東地至河，而齊、趙數破我，安邑近秦，於是徙治大梁。以公子赫爲太子。"}],"rationale":"限本篇明示姓名、是為及同段連續語境；外黃徐子／客按同一勸還對話暫接，龐涓／涓按同一馬陵戰暫接。孫子與孫臏、公子赫與襄王、齊王與齊宣王仍分候選；武下將識國別待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji044-ang","person_ids":["7j8_d3i_ond"],"canonical_person_id":"7j8_d3i_ond","scope":"cross_chapter","chapter_ids":["c-shiji-043-zhao","c-shiji-044-wei"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-043-zhao","source_id":"s-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p055","quote":"肅侯元年，奪晉君端氏，徙處屯留。二年，與魏惠王遇於陰晉。三年，公子范襲邯鄲，不勝而死。四年，朝天子。六年，攻齊，拔髙唐。七年，公子刻攻魏首垣。十一年，秦孝公使商君伐魏，虜其將公子卬。趙伐魏。十二年，秦孝公卒，商君死。十五年，起壽陵。魏惠王卒。","mention_ids":["c-shiji-043-zhao:m055-0087"]},{"chapter_id":"c-shiji-044-wei","source_id":"s-shiji-044-wei","paragraph_id":"c-shiji-044-wei:p037","quote":"卅一年，秦、趙、齊共伐我，秦將商君詐我將軍公子卬而襲奪其軍，破之。秦用商君，東地至河，而齊、趙數破我，安邑近秦，於是徙治大梁。以公子赫爲太子。","mention_ids":["c-shiji-044-wei:m037-0021"]}],"rationale":"兩篇同記商君伐魏對公子卬的戰事，國別、將軍與姓名相合而暫同指，不從同名全域合併。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true}],"passages":[{"id":"c-shiji-043-zhao:p055","text":"肅侯元年，奪晉君端氏，徙處屯留。二年，與魏惠王遇於陰晉。三年，公子范襲邯鄲，不勝而死。四年，朝天子。六年，攻齊，拔髙唐。七年，公子刻攻魏首垣。十一年，秦孝公使商君伐魏，虜其將公子卬。趙伐魏。十二年，秦孝公卒，商君死。十五年，起壽陵。魏惠王卒。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-043-zhao:m055-0000","start":0,"end":2,"surface":"肅侯","kind":"person","person_id":"txj_z8z_5me","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m055-0006","start":6,"end":8,"surface":"晉君","kind":"person","person_id":"lhy_fkp_0h5","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m055-0020","start":20,"end":23,"surface":"魏惠王","kind":"person","person_id":"hob_fsb_jia","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m055-0031","start":31,"end":34,"surface":"公子范","kind":"person","person_id":"3u1_ov8_6ry","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m055-0047","start":4