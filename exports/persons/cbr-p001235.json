2-0150","start":150,"end":151,"surface":"揮","kind":"person","person_id":"cbr-p001235","status":"contextual_provisional","paragraph_id":"c-shiji-033-lu:p032","chapter_id":"c-shiji-033-lu"},{"id":"c-shiji-033-lu:m035-0004","start":4,"end":5,"surface":"揮","kind":"person","person_id":"cbr-p001235","status":"contextual_provisional","paragraph_id":"c-shiji-033-lu:p035","chapter_id":"c-shiji-033-lu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji033-069","person_id":"cbr-p001235","surfaces":["公子揮","揮"],"scope":"same_chapter","chapter_ids":["c-shiji-033-lu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-033-lu:p032","quote":"十一年冬，公子揮諂謂隱公曰：「百姓便君，君其遂立。吾請爲君殺子允，君以我爲相。」隱公曰：「有先君命。吾爲允少，故攝代。今允長矣，吾方營菟裘之地而老焉，以授子允政。」揮懼子允聞而反誅之，乃反譖隱公於子允曰：「隱公欲遂立，去子，子其圖之。請爲子殺隱公。」子允許諾。十一月，隱公祭鐘巫，齊于社圃，館于蒍氏。揮使人殺隱公于蒍氏，而立子允爲君，是爲桓公。"},{"paragraph_id":"c-shiji-033-lu:p035","quote":"三年，使揮迎婦于齊爲夫人。"}],"rationale":"按懿公被弒至魯文公的敘事角色、同段明示子／弟與柯盟、齊襄公殺魯桓公、晉立惠公等具體事件暫定異稱；同字爵稱依國別分開。公子揮不與前篇公子翚、晉襄父不與晉襄公、宣伯不與叔孫宣伯自動合併。數位疑讀與親屬異說仍待核對。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-033-lu:p032","text":"十一年冬，公子揮諂謂隱公曰：「百姓便君，君其遂立。吾請爲君殺子允，君以我爲相。」隱公曰：「有先君命。吾爲允少，故攝代。今允長矣，吾方營菟裘之地而老焉，以授子允政。」揮懼子允聞而反誅之，乃反譖隱公於子允曰：「隱公欲遂立，去子，子其圖之。請爲子殺隱公。」子允許諾。十一月，隱公祭鐘巫，齊于社圃，館于蒍氏。揮使人殺隱公于蒍氏，而立子允爲君，是爲桓公。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-033-lu:m032-0005","start":5,"end":8,"surface":"公子揮","kind":"person","person_id":"cbr-p001235","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m032-0010","start":10,"end":12,"surface":"隱公","kind":"person","person_id":"cbr-p000225","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m032-0015","start":15,"end":17,"surface":"百姓","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未指名者、地點氏稱、未定官稱或未解指代；不補姓名、成員與父系。"},{"id":"c-shiji-033-lu:m032-0030","start":30,"end":32,"sur