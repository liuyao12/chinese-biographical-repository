period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-016","chapter_id":"c-nanshi-016-wangxuanmiao","source_id":"s-nanshi-016-wangxuanmiao-ws1963381","paragraph_id":"c-nanshi-016-wangxuanmiao:p001","quote":"玄載弟玄邈字彦遠，仕宋位靑州刺史。齊髙帝之鎭淮陰，爲宋明帝所疑，乃北勸魏，遣書結玄邈。玄邈長史房叔安進曰：「夫布衣韋帶之士，銜一餐而不忘，義使之然也。今將軍居方州之重，托君臣之義，無故舉忠孝而棄之，三齊之士寧蹈東海死耳，不敢隨將軍也。」玄邈意乃定。仍使叔安使建鄴，發髙帝謀。髙帝于路執之，並求玄邈表。叔安答曰：「寡君使表上天子，不上將軍。且僕之所言，利國家而不利將軍，無所應問。」荀伯玉勸殺之，髙帝曰：「物各爲主，無所責也。」玄邈罷州還，髙帝塗中要之，玄邈嚴軍直過。還都，啓宋明帝，稱髙帝有異謀，髙帝不恨也。升明中，髙帝引爲驃騎司馬、泰山太守。玄邈甚懼，髙帝待之如初。再遷西戎校尉、梁南秦二州刺史，封河陽縣侯，兄弟同時爲方伯。","person_mention_id":"c-nanshi-016-wangxuanmiao:p001:m0047"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"person_references":[{"id":"c-nanshi-016-fangshuan:p001:r0016","paragraph_id":"c-nanshi-016-fangshuan:p001","start":16,"end":17,"surface":"其","person_id":"5ql_hfz_086","referent_role":"third_person","quote":"叔安字子仁，淸河人。髙帝即位，懷其忠正，時爲益州司馬、甯蜀太守，就拜前將軍。方用爲梁州，會病卒。帝歎曰：「叔安節義，古人中求之耳，恨不至方伯而終。」","note":"依本段敘事、稱謂及語者受者定。","chapter_id":"c-nanshi-016-fangshuan","book_id":"b-nanshi-016","work_id":"w-nanshi","source_id":"s-nanshi-016-fangshuan-ws1963381"},{"id":"c-nanshi-016-fangshuan:p001:r0062","paragraph_id":"c-nanshi-016-fangshuan:p001","start":62,"end":63,"surface":"之","person_id":"5ql_hfz_086","referent_role":"third_person","quote":"叔安字子仁，淸河人。髙帝即位，懷其忠正，時爲益州司馬、甯蜀太守，就拜前將軍。方用爲梁州，會病卒。帝歎曰：「叔安節義，古人中求之耳，恨不至方伯而終。」","note":"依本段敘事、稱謂及語者受者定。","chapter_id":"c-nanshi-016-fangshuan","book_id":"b-nanshi-016","work_id":"w-nanshi","source_id":"s-nanshi-016-fangshuan-ws1963381"},{"id":"c-nanshi-016-wangxuanmiao:p001:r0170","paragraph_id":"c-nanshi-016-wangxuanmiao:p001","start":170,"end":171,"surface":"僕","person_id":"5ql_hfz_086","referent_role":"speaker_self","quote":"玄載弟玄邈字彦遠，仕宋位靑州刺史。齊髙帝之鎭淮陰，爲宋明帝所疑，乃北勸魏，遣書結玄邈。玄邈長史房叔安進曰：「夫布衣韋帶之士，銜一餐而不忘，義