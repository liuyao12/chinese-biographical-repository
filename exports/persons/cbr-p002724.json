ji-046-tian:m009-0186","start":186,"end":189,"surface":"髙昭子","kind":"person","person_id":"cbr-p002724","status":"contextual_provisional","paragraph_id":"c-shiji-046-tian:p009","chapter_id":"c-shiji-046-tian"},{"id":"c-shiji-046-tian:m009-0190","start":190,"end":192,"surface":"昭子","kind":"person","person_id":"cbr-p002724","status":"contextual_provisional","paragraph_id":"c-shiji-046-tian:p009","chapter_id":"c-shiji-046-tian"},{"id":"c-shiji-046-tian:m009-0223","start":223,"end":226,"surface":"髙昭子","kind":"person","person_id":"cbr-p002724","status":"contextual_provisional","paragraph_id":"c-shiji-046-tian:p009","chapter_id":"c-shiji-046-tian"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji046-018","person_id":"cbr-p002724","surfaces":["昭子","髙昭子"],"scope":"same_chapter","chapter_ids":["c-shiji-046-tian"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-046-tian:p009","quote":"景公太子死，後有寵姬曰芮子，生子荼。景公病，命其相國惠子與髙昭子以子荼爲太子。景公卒，兩相髙、國立荼，是爲晏孺子。而田乞不説，欲立景公他子陽生。陽生素與乞歡。晏孺子之立也，陽生奔魯。田乞偽事髙昭子、國惠子者，毎朝代參乘，言曰：「始諸大夫不欲立孺子。孺子旣立，君相之，大夫皆自危，謀作亂。」又紿大夫曰：「髙昭子可畏也，及未發先之。」諸大夫從之。田乞、鮑牧與大夫以兵入公室，攻髙昭子。昭子聞之，與國惠子救公。公師敗。田乞之衆追國惠子，惠子奔莒，遂返殺髙昭子。晏（孺子）［圉］奔魯。"}],"rationale":"限本篇明示姓名、是為、繼位及局部事件暫接；姜齊與田齊桓公、不同時段未名王及同字忌分開。孫子不先補孫臏，子守髙唐不補闕字，索隱短稱與代詞仍待核；未跨篇按同名接人。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-046-tian:p009","text":"景公太子死，後有寵姬曰芮子，生子荼。景公病，命其相國惠子與髙昭子以子荼爲太子。景公卒，兩相髙、國立荼，是爲晏孺子。而田乞不説，欲立景公他子陽生。陽生素與乞歡。晏孺子之立也，陽生奔魯。田乞偽事髙昭子、國惠子者，毎朝代參乘，言曰：「始諸大夫不欲立孺子。孺子旣立，君相之，大夫皆自危，謀作亂。」又紿大夫曰：「髙昭子可畏也，及未發先之。」諸大夫從之。田乞、鮑牧與大夫以兵入公室，攻髙昭子。昭子聞之，與國惠子救公。公師敗。田乞之衆追國惠子，惠子奔莒，遂返殺髙昭子。晏（孺子）［圉］奔魯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-046-tian:m009-0000","start":0,"end":2,"surface":"景公","kind":"person","person_id":"cbr-p002721","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m009-0002","start":2,"end":4,"surface":"太子","kind":"person","person_id