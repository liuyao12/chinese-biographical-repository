tus":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"source_position":{"first_line":122,"last_line":122,"raw_start":9272,"raw_end":9752,"revision_id":2618531},"chapter_id":"c-jinshu-043-wangcheng","book_id":"b-jinshu-043","work_id":"w-jinshu","source_id":"s-jinshu-043-wangcheng"},{"id":"c-jinshu-098-jin033-wangji:head","text":"王敦，字處仲，司徒導之從父兄也。父基，治書侍御史。敦少有奇人之目，尚武帝女襄城公主，拜駙馬都尉，除太子舍人。時王愷、石崇以豪侈相尚，愷嘗置酒，敦與導俱在坐，有女伎吹笛小失聲韻，愷便驅殺之，一坐改容，敦神色自若。他日，又造愷，愷使美人行酒，以客飲不盡，輒殺之。酒至敦、導所，敦故不肯持，美人悲懼失色，而敦傲然不視。導素不能飲，恐行酒者得罪，遂勉強盡觴。導還，歎曰：「處仲若當世，心懷剛忍，非令終也。」洗馬潘滔見敦而目之曰：「處仲蜂目已露，但豺聲未振，若不噬人，亦當為人所噬。」及太子遷許昌，詔東宮官屬不得送。敦及洗馬江統、潘滔，舍人杜蕤、魯瑤等，冒禁于路側望拜流涕，時論稱之。遷給事黃門侍郎。","annotation_status":"reviewed","text_layer":"received_chapter","mentions":[{"id":"c-jinshu-098-jin033-wangji:head:m0000","start":0,"end":2,"surface":"王敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:head:m0004","start":4,"end":6,"surface":"處仲","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:head:m0009","start":9,"end":10,"surface":"導","kind":"person","person_id":"7r6_k52_qji_ABAA","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:head:m0017","start":17,"end":18,"surface":"基","kind":"person","person_id":"7r6_k52_qji_ABB","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:head:m0025","start":25,"end":26,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:head:m0034","start":34,"end":36,"surface":"武帝","kind":"person","person_id":"hgm_jvn_hle","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:head:m0037","start":37,"end":41,"surface":"襄城公主","kind":"person","person_id":"hgm_jvn_hle_A","status":"co