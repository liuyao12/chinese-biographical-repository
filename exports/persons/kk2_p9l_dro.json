_id":"c-jinshu-093-chupou:line053","chapter_id":"c-jinshu-093-chupou"},{"id":"c-jinshu-093-chupou:line053:m0023","start":23,"end":24,"surface":"亮","kind":"person","person_id":"kk2_p9l_dro","status":"contextual_provisional","paragraph_id":"c-jinshu-093-chupou:line053","chapter_id":"c-jinshu-093-chupou"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-076-wangyi-family:p002","text":"初，王敦左遷陶侃，使廙代為荊州。將吏馬俊、鄭攀等上書請留侃，敦不許。廙為俊等所襲，奔于江安。賊杜曾與俊、攀北迎第五猗以距廙。廙督諸軍討曾，又為曾所敗。敦命湘州刺史甘卓、豫章太守周廣等助廙擊曾，曾衆潰，廙得到州。廙性俊率，嘗從南下，旦自尋陽，迅風飛帆，暮至都，倚舫樓長嘯，神氣甚逸。王導謂庾亮曰：「世將為傷時識事。」亮曰：「正足舒其逸氣耳。」廙在州大誅戮侃時將佐，及征士皇甫方回，於是大失荊土之望，人情乖阻。帝乃征廙為輔國將軍，加散騎常侍。以母喪去職。服闋，拜征虜將軍，進左衛將軍。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-076-wangyi-family:p002:m0002","start":2,"end":4,"surface":"王敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0006","start":6,"end":8,"surface":"陶侃","kind":"person","person_id":"twd_erg_kmz","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0010","start":10,"end":11,"surface":"廙","kind":"person","person_id":"7r6_k52_qji_ABDA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0018","start":18,"end":20,"surface":"馬俊","kind":"person","person_id":"0w5_r48_tfo","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0021","start":21,"end":23,"surface":"鄭攀","kind":"person","person_id":"200_oqy_d7c","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0028","start":28,"end":29,"surface":"侃","kind":"person","person_id":"twd_erg_kmz","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0030","start":30,"end":31,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual