provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0203","start":203,"end":204,"surface":"帝","kind":"person","person_id":"dkn_ge4_286_AAAAAAA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0206","start":206,"end":207,"surface":"廙","kind":"person","person_id":"7r6_k52_qji_ABDA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0220","start":220,"end":221,"surface":"母","kind":"person","person_id":"7ie_92j_3xk","status":"contextual_provisional"}],"source_position":{"first_line":39,"last_line":40,"revision_id":2180533,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-076-wangyi-family","book_id":"b-jinshu-076","work_id":"w-jinshu","source_id":"s-jinshu-076-wangyi-family"},{"id":"c-jinshu-093-chupou:line053","text":"初，裒總角詣庾亮，亮使郭璞筮之。卦成，璞駭然，亮曰：「有不祥乎？」璞曰：「此非人臣卦，不知此年少何以乃表斯祥？二十年外，吾言方驗。」及此二十九年而康獻皇太后臨朝，有司以裒皇太后父，議加不臣之禮，拜侍中、衛將軍、錄尚書事，持節、都督、刺史如故。裒以近戚，懼獲譏嫌，上疏固請居籓，曰：「臣以虛鄙，才不周用，過蒙國恩，累忝非據。無勞受寵，負愧實深，豈可復加殊特之命，顯號重疊！臣有何勳可以克堪？何顏可以冒進？委身聖世，豈復遺力，實懼顛墜，所誤者大。今王略未振，萬機至殷，陛下宜委誠宰輔，一遵先帝任賢之道，虛己受成，坦平心於天下，無宜內示私親之舉，朝野失望，所損豈少！」於是改授都督徐兗青揚州之晉陵吳國諸軍事、衛將軍、徐兗二州刺史、假節、鎮京口。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-093-chupou:line053:m0002","start":2,"end":3,"surface":"裒","kind":"person","person_id":"xke_dj3_6ba_AA","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line053:m0006","start":6,"end":8,"surface":"庾亮","kind":"person","person_id":"kk2_p9l_dro","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line053:m0009","start":9,"end":10,"surface":"亮","kind":"person","person_id":"kk2_p9l_dro","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line053:m0011","start":11,"end":13,"surface":"郭璞","kind":"person","person_id":"2i5_4eo_tve","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line053:m0019","start":19,"end":20,"surface":"璞","kind":"person","person_id":"2i5_4eo_tve","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line053:m0023","start":