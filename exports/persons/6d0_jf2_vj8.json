k_id":"w-jinshu","book_id":"b-jinshu-044","chapter_id":"c-jinshu-044-luchen-cuiyue","source_id":"s-jinshu-044-ws1775345-luchen-cuiyue","paragraph_id":"c-jinshu-044-luchen-cuiyue:p002","quote":"建興末，隨琨投段匹磾。匹磾自領幽州，取諶為別駕。匹磾既害琨，尋亦敗喪。時南路阻絕，段末波在遼西，諶往投之。元帝之初，末波通使于江左，諶因其使抗表理琨，文旨甚切，於是即加弔祭。累徵諶為散騎中書侍郎，而為末波所留，遂不得南渡。末波死，弟遼代立，諶流離世故且二十載。石季龍破遼西，復為季龍所得，以為中書侍郎、國子祭酒、侍中、中書監。屬冉閔誅石氏，諶隨閔軍，于襄國遇害，時年六十七，是歲永和六年也。","subject_person_mention_id":"c-jinshu-044-luchen-cuiyue:p002:m0116","object_person_mention_id":"c-jinshu-044-luchen-cuiyue:p002:m0111"}],"interpretation_note":"只採原明角色與原詞。未成禮不建夫妻；母稱非生母，從母不補中介母身分；曾祖兩代未知不組族；弟只相對長幼。","status":"source_attested","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-035-peikai-family:p014:m0072","start":72,"end":74,"surface":"段遼","kind":"person","person_id":"6d0_jf2_vj8","status":"contextual_provisional","paragraph_id":"c-jinshu-035-peikai-family:p014","chapter_id":"c-jinshu-035-peikai-family"},{"id":"c-jinshu-035-peikai-family:p014:m0104","start":104,"end":105,"surface":"遼","kind":"person","person_id":"6d0_jf2_vj8","status":"contextual_provisional","paragraph_id":"c-jinshu-035-peikai-family:p014","chapter_id":"c-jinshu-035-peikai-family"},{"id":"c-jinshu-044-luchen-cuiyue:p002:m0116","start":116,"end":117,"surface":"遼","kind":"person","person_id":"6d0_jf2_vj8","status":"contextual_provisional","resolution_note":"既存035段遼與石季龍欲伐遼的遼西戰局；本源末波弟遼繼立及季龍破遼西相合。","paragraph_id":"c-jinshu-044-luchen-cuiyue:p002","chapter_id":"c-jinshu-044-luchen-cuiyue"}],"relations":[{"id":"a-jin044-brother","subject_person_id":"6d0_jf2_vj8","predicate":"brother","object_person_id":"92h_q40_d2s","qualifiers":{"source_term":"弟","source_clause_binding":{"kind":"biography_family_clause","frame":"jin044_luchen_cuiyue_p002","paragraph_id":"c-jinshu-044-luchen-cuiyue:p002","source_