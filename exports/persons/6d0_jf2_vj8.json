99","start":99,"end":101,"surface":"季龍","kind":"person","person_id":"u61_ylg_6av","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p014:m0104","start":104,"end":105,"surface":"遼","kind":"person","person_id":"6d0_jf2_vj8","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p014:m0108","start":108,"end":109,"surface":"魚","kind":"person","person_id":"279_4mx_ey9","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p014:m0113","start":113,"end":115,"surface":"季龍","kind":"person","person_id":"u61_ylg_6av","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p014:m0117","start":117,"end":118,"surface":"挹","kind":"person","person_id":"kbq_kjc_n2f_BCCA","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p014:m0119","start":119,"end":120,"surface":"㲄","kind":"person","person_id":"kbq_kjc_n2f_BCCB","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p014:m0121","start":121,"end":122,"surface":"憲","kind":"person","person_id":"kbq_kjc_n2f_BCC","status":"contextual_provisional"}],"source_position":{"first_line":103,"last_line":103,"revision_id":2506399,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-035-peikai-family","book_id":"b-jinshu-035","work_id":"w-jinshu","source_id":"s-jinshu-035-peikai-ws2506399"},{"id":"c-jinshu-044-luqin-family-rendered:p011","text":"建興末，隨琨投段匹磾。匹磾自領幽州，取諶為別駕。匹磾既害琨，尋亦敗喪。時南路阻絕，段末波在遼西，諶往投之。元帝之初，末波通使于江左，諶因其使抗表理琨，文旨甚切，於是即加弔祭。累徵諶為散騎中書侍郎，而為末波所留，遂不得南渡。末波死，弟遼代立，諶流離世故且二十載。石季龍破遼西，復為季龍所得，以為中書侍郎、國子祭酒、侍中、中書監。屬冉閔誅石氏，諶隨閔軍，于襄國遇害，時年六十七，是歲永和六年也。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","source_position":{"rendered_tool_line":209,"capture_ref":"source-evidence/jin044-lu-rendered/received-rendered-capture.json","capture_kind":"existing_rendered_text_not_raw","projection":"remove leading ideographic spaces and tool-link wrappers only"},"mentions":[{"id":"c-jinshu-044-luqin-family-rendered:p011:m0005","start":5,"end":6,"s