ship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji109-004","subject_person_id":"wxj_72p_ry3","predicate":"father","object_person_id":"27j_f4p_jwp","status":"source_attested","evidence":[{"chapter_id":"c-shiji-109-liguang","source_id":"s-shiji-109-liguang","paragraph_id":"c-shiji-109-liguang:p010","quote":"居頃之，石建卒，於是上召廣代建爲郎中令。元朔六年，廣復爲後將軍，從大將軍軍出定襄，擊匈奴。諸將多中首虜率以功爲侯者，而廣軍無功。後二歳，廣以郎中令將四千騎出右北平，博望侯張騫將萬騎與廣俱，異道。行可數百里，匈奴左賢王將四萬騎圍廣，廣軍士皆恐，廣乃使其子敢往馳之。敢獨與數十騎馳，直貫胡騎，出其左右而還，告廣曰：「胡虜易與耳。」軍士乃安。廣爲圜陳外向，胡急擊之，矢下如雨。漢兵死者過半，漢矢且盡。廣乃令士持滿毋發，而廣身自以大黃射其裨將，殺數人，胡虜益解。會日暮，吏士皆無人色，而廣意氣自如，益治軍。軍中自是服其勇也。明日，復力戰，而博望侯軍亦至，匈奴軍乃解去。漢軍罷，弗能追。是時廣軍幾沒，罷歸。漢法，博望侯留遲後期，當死，贖爲庶人。廣軍功自如，無賞。"}],"qualifiers":{"source_term":"廣乃使其子敢","historicity":"historical_tradition"},"interpretation_note":"其子敢直接連到李廣，不補出生排行、母親或生年。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-109-liguang:m010-0126","start":126,"end":127,"surface":"敢","kind":"person","person_id":"wxj_72p_ry3","status":"contextual_provisional","paragraph_id":"c-shiji-109-liguang:p010","chapter_id":"c-shiji-109-liguang"},{"id":"c-shiji-109-liguang:m010-0131","start":131,"end":132,"surface":"敢","kind":"person","person_id":"wxj_72p_ry3","status":"contextual_provisional","paragraph_id":"c-shiji-109-liguang:p010","chapter_id":"c-shiji-109-liguang"}],"relations":[{"id":"a-shiji109-004","subject_person_id":"wxj_72p_ry3","predicate":"father","object_person_id":"27j_f4p_jwp","status":"source_attested","evidence":[{"chapter_id":"c-shiji-109-liguang","source_id":"s-shiji-109-liguang","paragraph_id":"c-shiji-109-liguang:p010","quote":"居頃之，石建卒，於是上召廣代建爲郎中令。元朔六年，廣復爲後將軍，從大將軍軍出定襄，擊匈奴。諸將多中首虜率以功爲侯者，而廣軍無功。後二歳，廣以郎中令將四千騎出右北平，博望侯張騫將萬騎與廣俱，異道。行可數百里，匈奴左賢王將四萬騎圍廣，廣軍士皆恐，廣乃使其子敢往馳之。敢獨與數十騎馳，直貫胡騎，出其左右而還，告廣曰：「胡虜易與耳。」軍士乃安。廣爲圜陳外向，胡急擊之，矢下如雨。漢兵死者過半，漢矢且盡。廣乃令士持滿毋發，而廣身自以大黃射其裨將，殺數人，胡虜益解。會日暮，吏士皆無人色，而廣意氣自如，益治軍。軍中自是服其勇也。明日，復力戰，而博望侯軍亦至，匈奴軍乃解去。漢軍罷，弗能追。是時廣軍幾沒，罷歸。漢法，博望侯留遲後期，當死，贖爲庶人。廣軍功自如，無賞。"}],"qualifiers":{"source_term":"廣乃使其子敢","historicity":"historical_tradition"},"interpretation_note":"其子敢直接連到李廣，不補出生排行、母親或生年。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-109-liguang:p010","text":"居頃之，石建卒，於是上召廣代建爲郎中令。元朔六年，廣復爲後將軍，從大將軍軍出定襄，擊匈奴。諸將多中首虜率以功爲侯者，而廣軍無功。後二歳，廣以郎中令將四千騎出右北平，博望侯張騫將萬騎與廣俱，異道。行可數百里，匈奴左賢王將四萬騎圍廣，廣軍士皆恐，廣乃使其子敢往馳之。敢獨與數十騎馳，直貫胡騎，出其左右而還，告廣曰：「胡虜易與耳。」軍士乃安。廣爲圜陳外向，胡急擊之，矢下如雨。漢兵死者過半，漢矢且盡。廣乃令士持滿毋發，而廣身自以大黃射其裨將，殺數人，胡虜益解。會日暮，吏士皆無人色，而廣意氣自如，益治軍。軍中自是服其勇也。明日，復力戰，而博望侯軍亦至，匈奴軍乃解去。漢軍罷，弗能追。是時廣軍幾沒，罷歸。漢法，博望侯留遲後期，當死，贖爲庶人。廣軍功自如，無賞。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-109-liguang:m010-0004","start":4,"end":6,"surface":"石建","kind":"person","person_id":"gtg_ugc_14i","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m010-0010","start":10,"end":11,"surface":"上","kind":"person","person_id":"5k5_3ag_agc","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m010-0012","start":12,"end":13,"surface":"廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m010-0014","start":14,"end":15,"surface":"建","kind":"person","person_id":"gtg_ugc_14i","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m010-0025","start":25,"end":26,"surface":"廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m010-0033","start":33,"end":36,"surface":"大將軍","kind":"person","person_id":"10h_plg_i97","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m010-0059","start":59,"end":60,"surface":"廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m010-0068","star