ws2118585","work_id":"w-songshu","book_id":"b-songshu-049","chapter_id":"c-songshu-049-liuzhong","raw_mention_count":1,"mention_ids":["c-songshu-049-liuzhong:p004:m0332"],"paragraph_ids":["c-songshu-049-liuzhong:p004"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-songshu-049-liuzhong:p004:m0332","mention_ids":["c-songshu-049-liuzhong:p004:m0332"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-songshu-048-zhulingshi-ws1791560"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-song048-zhulingshi-侯輝","person_id":"1ey_qr4_25f","event_type":"death","source_term":"斬","source_anchor":{"paragraph_id":"c-songshu-048-zhulingshi:p008","start":106,"end":107,"surface":"斬"},"date_expression":null,"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-048","chapter_id":"c-songshu-048-zhulingshi","source_id":"s-songshu-048-zhulingshi-ws1791560","paragraph_id":"c-songshu-048-zhulingshi:p008","quote":"十年六月，齡石至彭模，諸將以賊水北城險阻眾多，咸欲先攻其南城，齡石曰：「不然。雖寇在北，今屠南城，不足以破北；若盡銳以拔北壘，南城不麾而自散也。」七月，齡石率劉鍾、蒯恩等攻城，詰朝戰，至日昃，焚其樓櫓，四面並登，斬侯輝、譙詵，仍回軍以麾，南城即時散潰。凡斬大將十五級，諸營守以次土崩，眾軍乃舍船步進。","person_mention_id":"c-songshu-048-zhulingshi:p008:m0107"}],"status":"source_attested","interpretation_note":"按同段人物與次第核所屬卒事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"le-song049-liuzhong-侯輝","person_id":"1ey_qr4_25f","event_type":"death","source_term":"斬","source_anchor":{"paragraph_id":"c-songshu-049-liuzhong:p004","start":328,"end":329,"surface":"斬"},"date_expression":null,"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-049","chapter_id":"c-songshu-049-liuzhong","source_id":"s-songshu-049-liuzhong-ws2118585","paragraph_id":"c-songshu-049-liuzhong:p004","quote":"高祖討劉毅，鍾率軍繼王鎮惡。江陵平定，仍隨朱齡石伐蜀，為前鋒，由外水，至于彭模，去成都二百里。偽冠軍征討督護譙亢等兩岸連營，層樓重柵，眾號三萬。鍾于時脚疾不能行，齡石乃詣鍾謀曰：「今天時盛熱，而賊嚴兵固險，攻之未必可拔，祇增疲困。計其人情恇撓，必不久安，且欲養銳息兵，以伺其隙。隙而乘之，乃可捷事。然決機兩陳，公本有所委，卿意謂何﹖」鍾曰：「不然。前揚聲言大眾向內水，譙道福不敢舍涪城。今重軍卒至，出其不意，蜀人已破膽矣。賊今阻兵守險，是其懼不敢戰，非能持久堅守也。因其兇懼，盡銳攻之，其勢必克。鼓行而進，成都必不能守矣。今若緩兵相守，彼將知人虛實，涪軍忽并來力距我，人情既安，良將又集，此求戰不獲，軍食無資，當為蜀子虜耳。」齡石從之。明日進攻，陷其二城，斬其大將侯輝、譙詵，逕平成都。","person_mention_id":"c-songshu-049-liuzhong:p004:m0332"}],"status":"source_attested","interpretation_note":"按同段人物與次第核所屬卒事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"mentions":[{"id":"c-songshu-048-zhulingshi:p007:m0318","start":318,"end":320,"surface":"侯輝","kind":"person","person_id":"1ey_qr4_25f","status":"contextual_provisional","paragraph_id":"c-songshu-048-zhulingshi:p007","chapter_id":"c-songshu-048-zhulingshi"},{"id":"c-songshu-048-zhulingshi:p008:m0107","start":107,"end":109,"surface":"侯輝","kind":"person","person_id":"1ey_qr4_25f","status":"contextual_provisional","paragraph_id":"c-songshu-048-zhulingshi:p008","chapter_id":"c-songshu-048-zhulingshi"},{"id":"c-songshu-049-liuzhong:p004:m0332","start":332,"end":334,"surface":"侯輝","kind":"person","person_id":"1ey_qr4_25f","status":"contextual_provisional","paragraph_id":"c-songshu-049-liuzhong:p004","chapter_id":"c-songshu-049-liuzhong"}],"relations":[],"title_holdings":[{"id":"th-songshu-048-zhulingshi-7-311","title":"前將軍","kind":"office","mode":"attestation","person_id":"1ey_qr4_25f","attestations":[{"id":"th-songshu-048-zhulingshi-7-311:a","paragraph_id":"c-songshu-048-zhulingshi:p007","start":311,"end":314,"surface":"前將軍","person_mention_id":"c-songshu-048-zhulingshi:p007:m0318","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-048","chapter_id":"c-songshu-048-zhulingshi","source_id":"s-songshu-048-zhulingshi-ws1791560","paragraph_id":"c-songshu-048-zhulingshi:p007","quote":"九年，遣諸軍伐蜀，令齡石為元帥，以為建威將軍、益州刺史，率寧朔將軍臧熹、河間太守蒯恩、下邳太守劉鍾、龍驤將軍朱林等，凡二萬人，發自江陵。尋加節益州諸軍事。初，高祖與齡石密謀進取，曰：「劉敬宣往年出黃虎，無功而退。賊謂我今應從外水往，而料我當出其不意，猶從內水來也。如此，必以重兵守涪城，以備內道。若向黃虎，正陊其計。今以大眾自外水取成都，疑兵出內水，此制敵之奇也。」而慮此聲先馳，賊審虛實，別有函書，全封付齡石，署函邊曰：「至白帝乃開。」諸軍雖進，未知處分所由。至白帝，發書，曰：「眾軍悉從外水取成都，臧熹、朱林於中水取廣漢，使羸弱乘高艦十餘，由內水向黃虎。」眾軍乃倍道兼行，譙縱果備內水，使其大將譙道福以重兵戍涪城，遣其前將軍秦州刺史侯輝、尚書僕射蜀郡太守譙詵等率眾萬餘屯彭模，夾水為城。","person_mention_id":"c-songshu-048-zhulingshi:p007:m0318"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"th-songshu-048-zhulingshi-7-314","title":"秦州刺史","kind":"office","mode":"attestation","person_id":"1ey_qr4_25f","attestations":[{"id":"th-songshu-048-zhulingshi-7-314:a","paragraph_id":"c-songshu-048-zhulingshi:p007","start":314,"end":318,"surface":"秦州刺史","person_mention_id":"c-songshu-048-zhulingshi:p007:m0318","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-048","chapter_id":"c-songshu-048-zhulingshi","source_id":"s-songshu-048-zhulingshi-ws1791560","paragraph_id":"c-songshu-048-zhulingshi:p007","quote":"九年，遣諸軍伐蜀，令齡石為元帥，以為建威將軍、益州刺史，率寧朔將軍臧熹、河間太守蒯恩、下邳太守劉鍾、龍驤將軍朱林等，凡二萬人，發自江陵。尋加節益州諸軍事。初，高祖與齡石密謀進取，曰：「劉敬宣往年出黃虎，無功而退。賊謂我今應從外水往，而料我當出其不意，猶從內水來也。如此，必以重兵守涪城，以備內道。若向黃虎，正陊其計。今以大眾自外水取成都，疑兵出內水，此制敵之奇也。」而慮此聲先馳，賊審虛實，別有函書，全封付齡石，署函邊曰：「至白帝乃開。」諸軍雖進，未知處分所由。至白帝，發書，曰：「眾軍悉從外水取成都，臧熹、朱林於中水取廣漢，使羸弱乘高艦十餘，由內水向黃虎。」眾軍乃倍道兼行，譙縱果備內水，使其大將譙道福以重兵戍涪城，遣其前將軍秦州刺史侯輝、尚書僕射蜀郡太守譙詵等率眾萬餘屯彭模，夾水為城。","person_mention_id":"c-songshu-048-zhulingshi:p007:m0318"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-songshu-048-zhulingshi:p007","text":"九年，遣諸軍伐蜀，令齡石為元帥，以為建威將軍、益州刺史，率寧朔將軍臧熹、河間太守蒯恩、下邳太守劉鍾、龍驤將軍朱林等，凡二萬人，發自江陵。尋加節益州諸軍事。初，高祖與齡石密謀進取，曰：「劉敬宣往年出黃虎，無功而退。賊謂我今應從外水往，而料我當出其不意，猶從內水來也。如此，必以重兵守涪城，以備內道。若向黃虎，正陊其計。今以大眾自外水取成都，疑兵出內水，此制敵之奇也。」而慮此聲先馳，賊審虛實，別有函書，全封付齡石，署函邊曰：「至白帝乃開。」諸軍雖進，未知處分所由。至白帝，發書，曰：「眾軍悉從外水取成都，臧熹、朱林於中水取廣漢，使羸弱乘高艦十餘，由內水向黃虎。」眾軍乃倍道兼行，譙縱果備內水，使其大將譙道福以重兵戍涪城，遣其前將軍秦州刺史侯輝、尚書僕射蜀郡太守譙詵等率眾萬餘屯彭模，夾水為城。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":20,"last_line":20,"raw_start":988,"raw_end":1490,"raw_character_offsets":[988,989,990,991,992,993,994,995,996,997,998,999,1000,1001,1002,1003,1004,1005,1006,1007,1008,1009,1010,1011,1012,1013,1014,1015,1016,1017,1018,1019,1020,1021,1022,1023,1024,1025,1026,1027,1028,1029,1030,1031,1032,1033,1034,1035,1036,1037,1038,1039,1040,1041,1042,1043,1044,1045,1150,1151,1152,1153,1154,1155,1156,1157,1158,1159,1160,1161,1162,1163,1164,1165,1166,1167,1168,1169,1170,1171,1172,1173,1174,1175,1176,1177,1178,1179,1180,1181,1182,1183,1184,1185,1186,1187,1188,1189,1190,1191,1192,1193,1194,1195,1196,1197,1198,1199,1200,1201,1202,1203,1204,1205,1206,1207,1208,1209,1210,1211,1212,1213,1214,1215,1216,1217,1218,1219,1220,1221,1222,1223,1224,1225,1226,1227,1228,1229,1230,1231,1232,1233,1234,1235,1236,1237,1238,1239,1240,1241,1242,1243,1244,1245,1246,1247,1248,1249,1250,1251,1252,1253,1254,1255,1256,1257,1258,1259,1260,1261,1262,1263,1264,1265,1266,1267,1