-zhulingshi:p007:m0203","start":203,"end":205,"surface":"齡石","kind":"person","person_id":"wip_vh5_2zm_A","status":"contextual_provisional"},{"id":"c-songshu-048-zhulingshi:p007:m0251","start":251,"end":253,"surface":"臧熹","kind":"person","person_id":"0zd_9uz_t7m_AB","status":"contextual_provisional"},{"id":"c-songshu-048-zhulingshi:p007:m0254","start":254,"end":256,"surface":"朱林","kind":"person","person_id":"r77_b4f_ujw","status":"contextual_provisional"},{"id":"c-songshu-048-zhulingshi:p007:m0288","start":288,"end":290,"surface":"譙縱","kind":"person","person_id":"j5i_ahk_7yx","status":"contextual_provisional"},{"id":"c-songshu-048-zhulingshi:p007:m0299","start":299,"end":302,"surface":"譙道福","kind":"person","person_id":"o3z_vpz_572","status":"contextual_provisional"},{"id":"c-songshu-048-zhulingshi:p007:m0318","start":318,"end":320,"surface":"侯輝","kind":"person","person_id":"1ey_qr4_25f","status":"contextual_provisional"},{"id":"c-songshu-048-zhulingshi:p007:m0329","start":329,"end":331,"surface":"譙詵","kind":"person","person_id":"qz4_heb_4vx","status":"contextual_provisional"}],"chapter_id":"c-songshu-048-zhulingshi","book_id":"b-songshu-048","work_id":"w-songshu","source_id":"s-songshu-048-zhulingshi-ws1791560"},{"id":"c-songshu-048-zhulingshi:p008","text":"十年六月，齡石至彭模，諸將以賊水北城險阻眾多，咸欲先攻其南城，齡石曰：「不然。雖寇在北，今屠南城，不足以破北；若盡銳以拔北壘，南城不麾而自散也。」七月，齡石率劉鍾、蒯恩等攻城，詰朝戰，至日昃，焚其樓櫓，四面並登，斬侯輝、譙詵，仍回軍以麾，南城即時散潰。凡斬大將十五級，諸營守以次土崩，眾軍乃舍船步進。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":22,"last_line":22,"raw_start":1492,"raw_end":1642,"raw_character_offsets":[1492,1493,1494,1495,1496,1497,1498,1499,1500,1501,1502,1503,1504,1505,1506,1507,1508,1509,1510,1511,1512,1513,1514,1515,1516,1517,1518,1519,1520,1521,1522,1523,1524,1525,1526,1527,1528,1529,1530,1531,1532,1533,1534,1535,1536,1537,1538,1539,1540,1541,1542,1543,1544,1545,1546,1547,1548,1549,1550,1551,1552,1553,1554,1555,1556,1557,1558,1559,1560,1561,1562,1563,1564,1565,1566,1567,1568,1569,1570,1571,1572,1573,1574,1575,1576,1577,1578,1579,1580,1581,1582,1583,1584,1585,1586,1587,1588,1589,1590,1591,1592,1593,1594,1595,1596,1597,1598,1599,1600,1601,1602,1603,1604,1605,1606,1607,1608,1609,1610,1611,1612,1613,1614,1615,1616,1617,1618,1619,1620,1621,1622,1623,1624,1625,1626,1627,1628,1629,1630,1631,1632,1633,1634,1635,1636,1637,1638,1639,1640,1641],"revision_id":1791560},"mentions":[{"id":"c-songshu-048-zhulingshi:p008:m0005","start":5,"end":7,"surface":"齡石","kind":"person","person_id":"wip_vh5_2zm_A","status":"contextual_provisional"},{"id":"c-songshu-048-zhulingshi:p008:m0031","start":31,"end":33,"surface":"齡石","kind":"person","person_id":"wip_vh5_2zm_A","status":"contextual_provisional"},{"id":"c-songshu-048-zhulingshi:p008:m0076","start":76,"end":78,"surface":"齡石","kind":"person","person_id":"wip_vh5_2zm_A","status":"contextual_provisional"},{"id":"c-songshu-048-zhulingshi:p008:m0079","start":79,"end":81,"surface":"劉鍾","kind":"person","person_id":"vcd_ee3_q63","status":"contextual_provisional"},{"id":"c-songshu-048-zhulingshi:p008:m0082","start":82,"end":84,"surface":"蒯恩","kind":"person","person_id":"sn4_yf4_esv","status":"contextual_provisional"},{"id":"c-songshu-048-zhulingshi:p008:m0107","start":107,"end":109,"surface":"侯輝","kind":"person","person_id":"1ey_qr4_25f","status":"contextual_provisional"},{"id":"c-songshu-048-zhulingshi:p008:m0110","start":110,"end":112,"surface":"譙詵","kind":"person","person_id":"qz4_heb_4vx","status":"contextual_provisional"}],"chapter_id":"c-songshu-048-zhulingshi","book_id":"b-songshu-048","work_id":"w-songshu","source_id":"s-songshu-048-zhulingshi-ws1791560"},{"id":"c-songshu-049-liuzhong:p004","text":"高祖討劉毅，鍾率軍繼王鎮惡。江陵平定，仍隨朱齡石伐蜀，為前鋒，由外水，至于彭模，去成都二百里。偽冠軍征討督護譙亢等兩岸連營，層樓重柵，眾號三萬。鍾于時脚疾不能行，齡石乃詣鍾謀曰：「今天時盛熱，而賊嚴兵固險，攻之未必可拔，祇增疲困。計其人情恇撓，必不久安，且欲養銳息兵，以伺其隙。隙而乘之，乃可捷事。然決機兩陳，公本有所委，卿意謂何﹖」鍾曰：「不然。前揚聲言大眾向內水，譙道福不敢舍涪城。今重軍卒至，出其不意，蜀人已破膽矣。賊今阻兵守險，是其懼不敢戰，非能持久堅守也。因其兇懼，盡銳攻之，其勢必克。鼓行而進，成都必不能守矣。今若緩兵相守，彼將知人虛實，涪軍忽并來力距我，人情既安，良將又集，此求戰不獲，軍食無資，當為蜀子虜耳。」齡石從之。明日進攻，陷其二城，斬其大將侯輝、譙詵，逕平成都。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":34,"last_line":34,"raw_start":2493,"raw_end":2880,"raw_character_offsets":[2493,2494,2495,2496,2497,2498,2499,2500,2501,2502,2503,2504,2505,2506,2507,2508,2509,2510,2511,2512,2513,2514,2515,2516,2517,2518,2519,2520,2521,2522,2523,2524,2525,2526,2527,2528,2529,2530,2531,2532,2533,2534,2535,2536,2537,2538,2539,2540,2541,2542,2543,2544,2545,2546,2547,2548,2549,2550,2551,2552,2553,2554,2555,2556,2557,2558,2559,2560,2561,2562,2563,2564,2565,2566,2567,2568,2569,2570,2571,2572,2573,2574,2575,2576,2577,2578,2579,2580,2581,2582,2583,2584,2585,2586,2587,2588,2589,2590,2591,2592,2593,2594,2595,2596,2597,2598,2599,2600,2601,2602,2603,2604,2605,2606,2607,2608,2609,2610,2611,2612,2613,2614,2615,2616,2617,2618,2619,2620,2621,2622,2623,2624,2625,2626,2627,2628,2629,2630,2631,2632,2633,2634,2635,2636,2637,2638,2639,2640,2641,2642,2643,2644,2645,2646,2647,2648,2649,2650,2651,2652,2653,2654,2655,2656,2657,2658,2659,2660,2661,2662,2663,2664,2665,2666,2667,2668,2669,2670,2671,2672,2673,2674,2675,2676,2677,2678,2679,2680,2681,2682,2683,2684,2685,2686,2687,2688,2689,2690,2691,2692,2693,2694,2695,2696,2697,2698,2699,2700,2701,2702,2703,2704,2705,2706,2707,2708,2709,2710,2711,2712,2713,2714,2715,2716,2717,2718,2719,2720,2721,2722,2723,2724,2725,2726,2727,2728,2729,2730,2731,2732,2733,2734,2735,2736,2737,2738,2739,2740,2741,2742,2743,2744,2745,2746,2747,2748,2749,2750,2751,2752,2753,2754,2755,2756,2757,2758,2759,2760,2761,2762,2763,2764,2765,2766,2767,2768,2769,2770,2771,2772,2773,2774,2775,2776,2821,2822,2823,2824,2825,2826,2827,2828,2829,2830,2831,2832,2833,2834,2835,2836,2837,2838,2839,2840,2841,2842,2843,2844,2845,2846,2847,2848,2849,2850,2851,2852,2853,2854,2855,2856,2857,2858,2859,2860,2861,2862,2863,2864,2865,2866,2867,2868,2869,2870,2871,2872,2873,2874,2875,2876,2877,2878,2879],"revision_id":2118585},"mentions":[{"id":"c-songshu-049-liuzhong:p004:m0003","start":3,"end":5,"surfa