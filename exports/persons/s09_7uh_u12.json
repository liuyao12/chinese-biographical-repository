":["s-jinshu-060-jiapi-ws2413335"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-060-jiapi:p001:m0095","surface":"謝班","start":95,"end":97,"person_id":"s09_7uh_u12","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-060-jiapi:p001","chapter_id":"c-jinshu-060-jiapi"},{"id":"c-jinshu-060-jiapi:p001:m0122","surface":"班","start":122,"end":123,"person_id":"s09_7uh_u12","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-060-jiapi:p001","chapter_id":"c-jinshu-060-jiapi"},{"id":"c-jinshu-060-jiapi:p001:m0136","surface":"班","start":136,"end":137,"person_id":"s09_7uh_u12","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-060-jiapi:p001","chapter_id":"c-jinshu-060-jiapi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-060-jiapi:p001","text":"賈疋，字彥度，武威人，魏太尉詡之曾孫也。少有志略，器望甚偉，見之者莫不悅附，特為武夫之所瞻仰，願為致命。初辟公府，遂曆顯職，遷安定太守。雍州刺史丁綽，貪橫失百姓心，乃譖疋于南陽王模，模以軍司謝班伐之。疋奔瀘水，與胡彭蕩仲及氐竇首結為兄弟，聚眾攻班。綽奔武都，疋復入安定，殺班。湣帝以疋為驃騎將軍、雍州刺史，封酒泉公。時諸郡百姓饑饉，白骨蔽野，百無一存。疋帥戎晉二萬餘人，將伐長安，西平太守竺恢亦固守，劉粲聞之，使劉曜、劉雅及趙染距疋，先攻恢，不克，疋邀擊，大敗之，曜中流矢，退走。疋追之，至於甘泉。旋自渭橋襲蕩仲，殺之。遂迎秦王，奉為皇太子。後蕩仲子夫護帥群胡攻之，疋敗走，夜墮於澗，為夫護所害。疋勇略有志節，以匡復晉室為己任，不幸顛墮，時人咸痛惜之。","text_layer":"received_chapter","annotatio