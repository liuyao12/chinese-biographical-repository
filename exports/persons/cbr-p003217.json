ovisional"},{"id":"c-shiji-052-qidaohui:m004-0028","start":28,"end":30,"surface":"高后","kind":"person","person_id":"cbr-p003217","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m004-0034","start":34,"end":38,"surface":"酈侯呂臺","kind":"person","person_id":"cbr-p003221","status":"contextual_provisional"}],"chapter_id":"c-shiji-052-qidaohui","book_id":"b-shiji-052","work_id":"w-shiji","source_id":"s-shiji-052-qidaohui"},{"id":"c-shiji-052-qidaohui:p005","text":"哀王三年，其弟章入宿衛於漢，呂太后封為朱虛侯，以呂祿女妻之。後四年，封章弟興居為東牟侯，皆宿衛長安中。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-052-qidaohui:m005-0000","start":0,"end":2,"surface":"哀王","kind":"person","person_id":"cbr-p003220","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m005-0007","start":7,"end":8,"surface":"章","kind":"person","person_id":"cbr-p003222","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m005-0014","start":14,"end":17,"surface":"呂太后","kind":"person","person_id":"cbr-p003217","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m005-0019","start":19,"end":22,"surface":"朱虛侯","kind":"person","person_id":"cbr-p003222","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m005-0024","start":24,"end":27,"surface":"呂祿女","kind":"person","person_id":"cbr-p003223","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m005-0035","start":35,"end":36,"surface":"章","kind":"person","person_id":"cbr-p003222","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m005-0037","start":37,"end":39,"surface":"興居","kind":"person","person_id":"cbr-p003224","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m005-0040","start":40,"end":43,"surface":"東牟侯","kind":"person","person_id":"cbr-p003224","status":"contextual_provisional"}],"chapter_id":"c-shiji-052-qidaohui","book_id":"b-shiji-052","work_id":"w-shiji","source_id":"s-shiji-052-qidaohui"},{"id":"c-shiji-052-qidaohui:p006","text":"哀王八年，高后割齊瑯邪郡立營陵侯劉澤為瑯邪王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-052-qidaohui:m006-0000","start":0,"end":2,"surface":"哀王","kind":"person","person_id":"cbr-p003220","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m006-0005","start":5,"end":7,"surface":"高后","kind":"person","person_id":"cbr-p003217","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m006-0013","start":13,"end":18,"surface":"營陵侯劉澤","kind":"person","person_id":"cbr-p003225","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m006-0019","start":19,"end":22,"surface":"瑯邪王","kind":"person","person_id":"cbr-p003225","status":"contextual_provisional"}],"chapter_id":"c-shiji-052-qidaohui","book_id":"b-shiji-052","work_id":"w-shiji","source_id":"s-shiji-052-qidaohui"},{"id":"c-shiji-052-qidaohui:p007","text":"其明年，趙王友入朝，幽死于邸。三趙王皆廢。高后立諸呂諸呂為三王，擅權用事。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-052-qidaohui:m007-0004","start":4,"end":7,"surface":"趙王友","kind":"person","person_id":"cbr-p003226","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m007-0015","start":15,"end":18,"surface":"三趙王","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、未名者、未核官稱或代詞，不補姓名及家屬成員。"},{"id":"c-shiji-052-qidaohui:m007-0021","start":21,"end":23,"surface":"高后","kind":"person","person_id":"cbr-p003217","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m007-0024","start":24,"end":26,"surface":"諸呂","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、未名者、未核官稱或代詞，不補姓名及家屬成員。"},{"id":"c-shiji-052-qidaohui:m007-0026","start":26,"end":28,"surface":"諸呂","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、未名者、未核官稱或代詞，不補姓名及家屬成員。"}],"chapter_id":"c-shiji-052-qidaohui","book_id":"b-shiji-052","work_id":"w-shiji","source_id":"s-shiji-052-qidaohui"},{"id":"c-shiji-052-qidaohui:p008","text":"朱虛侯年二十，有氣力，忿劉氏不得職。嘗入待高后燕飲，高后令朱虛侯劉章為酒吏。章自請曰：「臣，將種也，請得以軍法行酒。」高后曰：「可。」酒酣，章進飲歌舞。已而曰：「請為太后言耕田歌。」高后兒子畜之，笑曰：「顧而父知田耳。若生而為王子，安知田乎？」章曰：「臣知之。」太后曰：「試為我言田。」章曰：「深耕穊種，立苗欲疏，非其種者，鉏而去之。」呂后默然。頃之，諸呂有一人醉，亡酒，章追，拔劍斬之，而還報曰：「有亡酒一人，臣謹行法斬之。」太后左右皆大驚。業已許其軍法，無以罪也。因罷。自是之後，諸呂憚朱虛侯，雖大臣皆依朱虛侯，劉氏為益彊。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-052-qidaohui:m008-0000","start":0,"end":3,"surface":"朱虛侯","kind":"person","person_id":"cbr-p003222","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m008-0021","start":21,"end":23,"surface":"高后","kind":"person","person_id":"cbr-p003217","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m008-0026","start":26,"end":28,"surface":"高后","kind":"person","person_id":"cbr-p003217","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m008-0029","start":29,"end":34,"surface":"朱虛侯劉章","kind":"person","person_id":"cbr-p003222","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m008-0038","start":38,"end":39,"surface":"章","kind":"person","person_id":"cbr-p003222","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m008-0059","start":59,"end":61,"surface":"高后","kind":"person","person_id":"cbr-p003217","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m008-0070","start":70,"end":71,"surface":"章","kind":"person","person_id":"cbr-p003222","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m008-0083","start":83,"end":85,"surface":"太后","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、未名者、未核官稱或代詞，不補姓名及家屬成員。"},{"id":"c-shiji-052-qidaohui:m008-0091","start":91,"end":93,"surface":"高后","kind":"person","person_id":"cbr-p003217","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m008-0122","start":122,"end":123,"surface":"章","kind":"person","person_id":"cbr-p003222","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m008-0131","start":131,"end":133,"surface":"太后","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、未名者