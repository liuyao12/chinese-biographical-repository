shiji-052-qidaohui:m009-0004","start":4,"end":6,"surface":"高后","kind":"person","person_id":"cbr-p003217","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m009-0008","start":8,"end":12,"surface":"趙王呂祿","kind":"person","person_id":"cbr-p003227","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m009-0017","start":17,"end":20,"surface":"呂王產","kind":"person","person_id":"cbr-p003228","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m009-0034","start":34,"end":36,"surface":"大臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、未名者、未核官稱或代詞，不補姓名及家屬成員。"},{"id":"c-shiji-052-qidaohui:m009-0041","start":41,"end":45,"surface":"朱虛侯章","kind":"person","person_id":"cbr-p003222","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m009-0046","start":46,"end":49,"surface":"呂祿女","kind":"person","person_id":"cbr-p003223","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m009-0064","start":64,"end":66,"surface":"齊王","kind":"person","person_id":"cbr-p003220","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m009-0073","start":73,"end":76,"surface":"朱虛侯","kind":"person","person_id":"cbr-p003222","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m009-0077","start":77,"end":80,"surface":"東牟侯","kind":"person","person_id":"cbr-p003224","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m009-0091","start":91,"end":93,"surface":"齊王","kind":"person","person_id":"cbr-p003220","status":"contextual_provisional"}],"chapter_id":"c-shiji-052-qidaohui","book_id":"b-shiji-052","work_id":"w-shiji","source_id":"s-shiji-052-qidaohui"},{"id":"c-shiji-052-qidaohui:p012","text":"瑯邪王既行，齊遂舉兵西攻呂國之濟南。於是齊哀王遺諸侯王書曰：「高帝平定天下，王諸子弟，悼惠王於齊。悼惠王薨，惠帝使留侯張良立臣為齊王。惠帝崩，高后用事，春秋高，聽諸呂擅廢高帝所立，又殺三趙王，滅梁、燕、趙以王諸呂，分齊國為四。忠臣進諫，上惑亂不聽。今高后崩，皇帝春秋富，未能治天下，固恃大臣諸（將）［侯］。今諸呂又擅自尊官，聚兵嚴威，劫列侯忠臣，矯制以令天下，宗廟所以危。今寡人率兵入誅不當為王者。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-052-qidaohui:m012-0000","start":0,"end":3,"surface":"瑯邪王","kind":"person","person_id":"cbr-p003225","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m012-0020","start":20,"end":23,"surface":"齊哀王","kind":"person","person_id":"cbr-p003220","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m012-0031","start":31,"end":33,"surface":"高帝","kind":"person","person_id":"cbr-p003215","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m012-0043","start":43,"end":46,"surface":"悼惠王","kind":"person","person_id":"cbr-p003214","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m012-0049","start":49,"end":52,"surface":"悼惠王","kind":"person","person_id":"cbr-p003214","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m012-0054","start":54,"end":56,"surface":"惠帝","kind":"person","person_id":"cbr-p003216","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m012-0057","start":57,"end":61,"surface":"留侯張良","kind":"person","person_id":"cbr-p003229","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m012-0064","start":64,"end":66,"surface":"齊王","kind":"person","person_id":"cbr-p003220","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m012-0067","start":67,"end":69,"surface":"惠帝","kind":"person","person_id":"cbr-p003216","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m012-0071","start":71,"end":73,"surface":"高后","kind":"person","person_id":"cbr-p003217","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m012-0081","start":81,"end":83,"surface":"諸呂","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、未名者、未核官稱或代詞，不補姓名及家屬成員。"},{"id":"c-shiji-052-qidaohui:m012-0085","start":85,"end":87,"surface":"高帝","kind":"person","person_id":"cbr-p003215","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m012-0104","start":104,"end":106,"surface":"諸呂","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、未名者、未核官稱或代詞，不補姓名及家屬成員。"},{"id":"c-shiji-052-qidaohui:m012-0113","start":113,"end":115,"surface":"忠臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、未名者、未核官稱或代詞，不補姓名及家屬成員。"},{"id":"c-shiji-052-qidaohui:m012-0125","start":125,"end":127,"surface":"高后","kind":"person","person_id":"cbr-p003217","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m012-0129","start":129,"end":131,"surface":"皇帝","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、未名者、未核官稱或代詞，不補姓名及家屬成員。"},{"id":"c-shiji-052-qidaohui:m012-0154","start":154,"end":156,"surface":"諸呂","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、未名者、未核官稱或代詞，不補姓名及家屬成員。"},{"id":"c-shiji-052-qidaohui:m012-0170","start":170,"end":172,"surface":"忠臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、未名者、未核官稱或代詞，不補姓名及家屬成員。"}],"chapter_id":"c-shiji-052-qidaohui","book_id":"b-shiji-052","work_id":"w-shiji","source_id":"s-shiji-052-qidaohui"},{"id":"c-shiji-052-qidaohui:p018","text":"孝文帝元年，盡以高后時所割齊之城陽、瑯邪、濟南郡復與齊，而徙瑯邪王王燕，益封朱虛侯、東牟侯各二千戶。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-052-qidaohui:m018-0000","start":0,"end":3,"surface":"孝文帝","kind":"person","person_id":"cbr-p003233","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m018-0008","start":8,"end":10,"surface":"高后","kind":"person","person_id":"cbr-p003217","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m018-0030","start":30,"end":33,"surface":"瑯邪王","kind":"person","person_id":"cbr-p003225","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m018-0038","start":38,"end":41,"surface":"朱虛侯","kind":"person","person_id":"cbr-p003222","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m018-0042","start":42,"end":45,"surface":"東牟侯","kind":"person","person_id":"cbr-p003224","status":"contextual_provisional"}],"chapter_id":"c-shiji-052-qidaohui","book_id":"b-shiji-052","work_id":"w-shiji","source_id":"s-shiji-052-qidaohui"},{"id":"c-shiji-052-qidaohui:p029","text":"主父偃方幸於天子，用事，因言：「齊臨菑十萬戶，市租千金，人眾殷富，巨於長安，此非天子親弟愛子不得王此。今齊王於親屬益疏。」乃從容言：「呂太后時齊欲反，吳楚時孝王幾為亂。今聞齊王與其姊亂。」於是天子乃拜主父偃為齊相，且正其事。主父偃既至齊，乃急治王後宮宦者為王通於姊翁主所者，令其辭證皆引王。王年少，懼大罪為吏所執誅，乃飲藥自殺。絕無後。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-052-qidaohui:m029-0000","start":0,"end":3,"surface":"主父偃","kind":"person","person_id":"cbr-p003260","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m029-0006","start":6,"end":8,"surface":"天子","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、官稱、未名者或待核回指；不補姓名，王作動詞不當人名。"},{"id":"c-shiji-052-qidaohui:m029-0040","start":40,"end":42,"surface":"天子","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、官稱、未名者或待核回指；不補姓名，王作動詞不當人名。"},{"id":"c-shiji-052-qidaohui:m029-0052","start":52,"end":54,"surface":"齊王","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、官稱、未名者或待核回指；不補姓名，王作動詞不當人名。"},{"id":"c-shiji-052-qidaohui:m029-0067","start":67,"end":70,"surface":"呂太后","kind":"person","person_id":"cbr-p003217","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m029-0079","start":79,"end":80,"surface":"王","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、官稱、未名者或待核回指；不補姓名，王作動詞不當人名。"},{"id":"c-shiji-052-qidaohui:m029-0086","start":86,"end":88,"surface":"齊王","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、官稱、未名者或待核回指；不補姓名，王作動詞不當人名。"},{"id":"c-shiji-052-qidaohui:m029-0090","start":90,"end":91,"surface":"姊","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、官稱、未名者或待核回指；不補姓名，王作動詞不當人名。"},{"id":"c-shiji-052-qidaohui:m029-0096","start":96,"end":98,"surface":"天子","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、官稱、未名者或待核回指；不補姓名，王作動詞不當人名。"},{"id":"c-shiji-052-qidaohui:m029-0100","start":100,"end":103,"surface":"主父偃","kind":"person","person_id":"cbr-p003260","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m029-0112"