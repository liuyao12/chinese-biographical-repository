9544,9545,9546,9547,9548,9549,9550,9551,9552,9553,9554,9555,9556,9557,9558,9559,9560,9561,9562,9563,9564,9565,9566,9567,9568,9569,9570,9571,9572,9573,9574,9575,9576,9577,9578,9579,9580,9581,9582,9583,9584,9585,9586,9587,9588,9589,9590,9591,9592,9593,9594,9595,9596,9597,9598,9599,9600,9601,9602,9603,9604,9605,9606,9607,9608,9609,9610,9611,9612,9613,9614,9615,9616,9617,9618,9619,9620,9621,9622,9623,9624,9625],"revision_id":2085142},"mentions":[{"id":"c-sanguozhi-048-sun-hao:p009:m0006","surface":"儼","start":6,"end":7,"kind":"person","person_id":"1p0_b3p_e5e","status":"contextual_provisional"},{"id":"c-sanguozhi-048-sun-hao:p009:m0008","surface":"子節","start":8,"end":10,"kind":"person","person_id":"1p0_b3p_e5e","status":"contextual_provisional"},{"id":"c-sanguozhi-048-sun-hao:p009:m0041","surface":"儼","start":41,"end":42,"kind":"person","person_id":"1p0_b3p_e5e","status":"contextual_provisional"}],"chapter_id":"c-sanguozhi-048-sun-hao","book_id":"b-sanguozhi-048","work_id":"w-sanguozhi","source_id":"s-sanguozhi-048-sun-hao-ws2085142"},{"id":"c-sanguozhi-056-zhuyi:line072-pei01-01","text":"《文士傳》曰：張惇子純與張儼及異俱童少，往見驃騎將軍朱據。據聞三人才名，欲試之，告曰：「老鄙相聞，饑渴甚矣。夫騕褭以迅驟為功，鷹隼以輕疾為妙，其為吾各賦一物，然後乃坐。」儼乃賦犬曰：「守則有威，出則有獲，韓盧、宋鵲，書名竹帛。」純賦席曰：「席以冬設，簟為夏施，揖讓而坐，君子攸宜。」異賦弩曰：「南嶽之幹，鍾山之銅，應機命中，獲隼高墉。」三人各隨其目所見而賦之，皆成而後坐，據大歡悅。","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-056-zhuyi:line072-pei01-01:m0007","start":7,"end":9,"surface":"張惇","kind":"person","person_id":"16y_k92_fmm","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-056-zhuyi:line072-pei01-01:m0010","start":10,"end":11,"surface":"純","kind":"person","person_id":"16y_k92_fmm_A","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-056-zhuyi:line072-pei01-01:m0012","start":12,"end":14,"surface":"張儼","kind":"person","person_id":"1p0_b3p_e5e","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-056-zhuyi:line072-pe