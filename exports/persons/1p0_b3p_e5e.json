agraph"},{"canonical_mention_id":"c-sanguozhi-056-zhuyi:line072-pei01-01:m0085","mention_ids":["c-sanguozhi-056-zhuyi:line072-pei01-01:m0085"],"kind":"paragraph"}],"mention_count":2,"duplicate_mention_count":0,"paragraph_occurrence_count":2,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"2處獨立位置，2個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-sanguozhi-048-sun-hao-ws2085142"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-wu048-yan-death","person_id":"1p0_b3p_e5e","event_type":"death","source_term":"道病死","source_anchor":{"paragraph_id":"c-sanguozhi-048-sun-hao:p008","start":31,"end":34,"surface":"道病死"},"date_expression":null,"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-048","chapter_id":"c-sanguozhi-048-sun-hao","source_id":"s-sanguozhi-048-sun-hao-ws2085142","paragraph_id":"c-sanguozhi-048-sun-hao:p008","quote":"寶鼎元年正月，遣大鴻臚張儼、五官中郎將丁忠弔祭晉文帝。及還，儼道病死。忠說皓曰：「北方守戰之具不設，弋陽可襲而取。」皓訪羣臣，鎮西大將軍陸凱曰：「夫兵不得已而用之耳，且三國鼎立已來，更相侵伐，無歲寧居。今彊敵新并巴蜀，有兼土之實，而遣使求親，欲息兵役，不可謂其求援於我。今敵形勢方彊，而欲徼幸求勝，未見其利也。」車騎將軍劉纂曰：「天生五才，誰能去兵？譎詐相雄，有自來矣。若其有闕，庸可棄乎？宜遣閒諜，以觀其勢。」皓陰納纂言，且以蜀新平，故不行，然遂自絕。八月，所在言得大鼎，於是改年，大赦。以陸凱爲左丞相，常侍萬彧爲右丞相。冬十月，永安山賊施但等聚衆數千人，劫皓庶弟永安侯謙出烏程，取孫和陵上鼓吹曲蓋。比至建業，衆萬餘人。丁固、諸葛靚逆之於牛屯，大戰，但等敗走。獲謙，謙自殺。分會稽爲東陽郡，分吳、丹楊爲吳興郡。以零陵北部爲邵陵郡。十二月，皓還都建業，衞將軍滕牧留鎮武昌。","person_mention_id":"c-sanguozhi-048-sun-hao:p008:m0011"}],"status":"source_attested","interpretation_note":"按同段人物與次第核所屬卒事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"mentions":[{"id":"c-sanguozhi-048-sun-hao:p008:m0011","surface":"張儼","start":11,"end":13,"kind":"person","person_id":"1p0_b3p_e5e","status":"contextual_provisional","paragraph_id":"c-sanguozhi-048-sun-hao:p008","chapter_id":"c-sanguozhi-048-sun-hao"},{"id":"c-sanguozhi-048-sun-hao:p008:m0030","surface":"儼","start":30,"end":31,"kind":"person","person_id":"1p0_b3p_e5e","status":"contextual_provisional","paragraph_id":"c-sanguozhi-048-sun-hao:p008","chapter_id":"c-sanguozhi-048-sun-hao"},{"id":"c-sanguozhi-048-sun-hao:p009:m0006","surface":"儼","start":6,"end":7,"kind":"person","person_id":"1p0_b3p_e5e","status":"contextual_provisional","paragraph_id":"c-sanguozhi-048-sun-hao:p009","chapter_id":"c-sanguozhi-048-sun-hao"},{"id":"c-sanguozhi-048-sun-hao:p009:m0008","surface":"子節","start":8,"end":10,"kind":"person","person_id":"1p0_b3p_e5e","status":"contextual_provisional","paragraph_id":"c-sanguozhi-048-sun-hao:p009","chapter_id":"c-sanguozhi-048-sun-hao"},{"id":"c-sanguozhi-048-sun-hao:p009:m0041","surface":"儼","start":41,"end":42,"kind":"person","person_id":"1p0_b3p_e5e","status":"contextual_provisional","paragraph_id":"c-sanguozhi-048-sun-hao:p009","chapter_id":"c-sanguozhi-048-sun-hao"},{"id":"c-sanguozhi-056-zhuyi:line072-pei01-01:m0012","start":12,"end":14,"surface":"張儼","kind":"person","person_id":"1p0_b3p_e5e","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-056-zhuyi:line072-pei01-01","chapter_id":"c-sanguozhi-056-zhuyi"},{"id":"c-sanguozhi-056-zhuyi:line072-pei01-01:m0085","start":85,"end":86,"surface":"儼","kind":"person","person_id":"1p0_b3p_e5e","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-056-zhuyi:line072-pei01-01","chapter_id":"c-sanguozhi-056-zhuyi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occu