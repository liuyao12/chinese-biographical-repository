wed":false}],"title_holdings":[],"address_assertions":[],"person_references":[{"id":"c-nanqishu-049-wanghui-complete:p001:r0091","paragraph_id":"c-nanqishu-049-wanghui-complete:p001","start":91,"end":94,"surface":"建平王","person_id":"ccd_af3_98e_A","referent_role":"third_person","quote":"建平王征北長史","note":"依句內語法、說話對象及本段承接辨識。","chapter_id":"c-nanqishu-049-wanghui-complete","book_id":"b-nanqishu-049","work_id":"w-nanqishu","source_id":"s-nanqishu-049-wanghui-complete-ws2261984"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-049-wanghui-complete:p001","text":"繢字叔素，宋車騎將軍景文子也。弱冠，爲祕書郎，太子舍人，轉中書舍人。景文以此授超階，令繢經年乃受。景文封江安侯，繢襲其本爵，爲始平縣五等男。遷祕書丞，司徒右長史。元徽末，除寧朔將軍、建平王征北長史、南東海太守，黃門郎，寧朔將軍、東陽太守。世祖爲撫軍，吏部尚書張岱選繢爲長史，呈選牒。太祖笑謂岱曰：「此可謂素望。」遷散騎常侍，驍騎將軍。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":45,"last_line":45,"raw_start":2740,"raw_end":2907,"raw_character_offsets":[2740,2741,2742,2743,2744,2745,2746,2747,2748,2749,2750,2751,2752,2753,2754,2755,2756,2757,2758,2759,2760,2761,2762,2763,2764,2765,2766,2767,2768,2769,2770,2771,2772,2773,2774,2775,2776,2777,2778,2779,2780,2781,2782,2783,2784,2785,2786,2787,2788,2789,2790,2791,2792,2793,2794,2795,2796,2797,2798,2799,2800,2801,2802,2803,2804,2805,2806,2807,2808,2809,2810,2811,2812,2813,2814,2815,2816,2817,2818,2819,2820,2821,2822,2823,2824,2825,2826,2827,2828,2829,2830,2831,2832,2833,2834,2835,2836,2837,2838,2839,2840,2841,2842,2843,2844,2845,2846,2847,2848,2849,2850,2851,2852,2853,2854,2855,2856,2857,2858,2859,2860,2861,2862,2863,2864,2865,2866,2867,2868,2869,2870,2871,2872,2873,2874,2875,2876,2877,2878,2879,2880,2881,2882,2883,2884,2885,2886,2887,2888,2889,2890,2891,2892,2893,2894,2895,2896,2897,2898,2899,2900,2901,2902,2903,2904,2905,2906],"revision_id":2261984},"mentions":[{"id":"c-nanqishu-049-wanghui-complete:p001:m0000","start":0,"end":1,"surface":