{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000490","canonical_person_id":"m6b_39t_lpp","id_aliases":["cbr-p000490"],"identity_policy":"contextual_provisional","person_ids":["m6b_39t_lpp"],"persons":[{"id":"m6b_39t_lpp","label":"嚴君疾","status":"active","historicity":"historical_tradition","aliases":[{"surface":"嚴君疾","mention_ids":["c-shiji-005-qin:m069-0006"]}],"evidence":[{"mention_id":"c-shiji-005-qin:m069-0006","chapter_id":"c-shiji-005-qin","paragraph_id":"c-shiji-005-qin:p069","quote":"嚴君疾"}],"identity_note":"依本卷特定時代與事件暫定人物；不以同稱、官號或短名全域合併，未見本名不補造。","review":"ai_provisional","id_aliases":["cbr-p000490"]}],"source_mention_summary":[{"source_id":"s-shiji-005-qin","work_id":"w-shiji","book_id":"b-shiji-005","chapter_id":"c-shiji-005-qin","mention_count":1,"mention_ids":["c-shiji-005-qin:m069-0006"],"paragraph_ids":["c-shiji-005-qin:p069"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-005-qin"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-005-qin:m069-0006","start":6,"end":9,"surface":"嚴君疾","kind":"person","person_id":"m6b_39t_lpp","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p069","chapter_id":"c-shiji-005-qin"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-005-qin:p069","text":"昭襄王元年，嚴君疾為相。甘茂出之魏。二年，彗星見。庶長壯與大臣、諸侯、公子為逆，皆誅，及惠文后皆不得良死。悼武王后出歸魏。三年，王冠。與楚王會黃棘，與楚上庸。四年，取蒲阪。彗星見。五年，魏王來朝應亭，復與魏蒲阪。六年，蜀侯煇反，司馬錯定蜀。庶長奐伐楚，斬首二萬。涇陽君質於齊。日食，晝晦。七年，拔新城。摢裏子卒。八年，使將軍羋戎攻楚，取新市。齊使章子，魏使公孫喜，韓使暴鳶共攻楚方城，取唐眛。趙破中山，其君亡，竟死齊。魏公子勁、韓公子長為諸侯。九年，孟嘗君薛文來相秦。奐攻楚，取八城，殺其將景快。十年，楚懷王入朝秦，秦留之。薛文以金受免。樓緩為丞相。十一年，齊、韓、魏、趙、宋、中山五國共攻秦，至鹽氏而還。秦與韓、魏河北及封陵以和。彗星見。楚懷王走之趙，趙不受，還之秦，即死，歸葬。十二年，樓緩免，穰侯魏冉為相。予楚粟五萬石。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m069-0000","start":0,"end":3,"surface":"昭襄王","kind":"person","person_id":"ao3_0fy_d45","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0006","start":6,"end":9,"surface":"嚴君疾","kind":"person","person_id":"m6b_39t_lpp","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0012","start":12,"end":14,"surface":"甘茂","kind":"person","person_id":"8im_m5e_cpy","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0025","start":25,"end":28,"surface":"庶長壯","kind":"person","person_id":"zul_9qs_fhz","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0044","start":44,"end":47,"surface":"惠文后","kind":"person","person_id":"mq6_9sx_400","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0053","start":53,"end":57,"surface":"悼武王后","kind":"person","person_id":"cij_zvk_7rn","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0068","start":68,"end":70,"surface":"楚王","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、氏族、群體或未核指代；不補造個人或按熟知世系自動合併。"},{"id":"c-shiji-005-qin:m069-0093","start":93,"end":95,"surface":"魏王","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、氏族、群體或未核指代；不補造個人或按熟知世系自動合併。"},{"id":"c-shiji-005-qin:m069-0109","start":109,"end":112,"surface":"蜀侯煇","kind":"person","person_id":"cmh_x83_hjk","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0114","start":114,"end":117,"surface":"司馬錯","kind":"person","person_id":"rec_qtq_9ve","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0120","start":120,"end":123,"surface":"庶長奐","kind":"person","person_id":"u4n_65h_uqv","status":"contextual_provisional"},{"id":"c-shiji-005-qin