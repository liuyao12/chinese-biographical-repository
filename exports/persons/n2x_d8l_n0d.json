s":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin089-jishao-003","subject_person_id":"n2x_d8l_n0d_*A","predicate":"grandfather","object_person_id":"n2x_d8l_n0d","status":"source_attested","qualifiers":{"source_term":"翰孫曠","lineage":"paternal"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-089","chapter_id":"c-jinshu-089-jishao","source_id":"s-jinshu-089-jishao","paragraph_id":"c-jinshu-089-jishao:p008","quote":"紹誕於行己，不飾小節，然曠而有檢，通而不雜。與從子含等五人共居，撫恤如所同生。門人故吏思慕遺愛，行服墓次，畢三年者三十餘人。長子軫，有父風，早夭。以從孫翰襲封。成帝時追述紹忠，以翰為奉朝請。翰以無兄弟，自表還本宗。太元中，孝武帝詔曰：「褒德顯仁，哲王令典。故太尉、忠穆公執德高邈，在否彌宣，貞潔之風，義著千載。每念其事，愴然傷懷。忠貞之胤，蒸嘗宜遠，所以大明至節，崇獎名教。可訪其宗族，襲爵主祀。」於是復以翰孫曠為弋陽侯。","relationship_anchor":{"paragraph_id":"c-jinshu-089-jishao:p008","start":203,"end":206,"surface":"翰孫曠"},"subject_person_mention_id":"c-jinshu-089-jishao:p008:m0205","object_person_mention_id":"c-jinshu-089-jishao:p008:m0076"}],"interpretation_note":"明祖孫，父未知，闕代不補人。","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-089-jishao:p008:m0076","start":76,"end":77,"surface":"翰","kind":"person","person_id":"n2x_d8l_n0d","status":"contextual_provisional","interpretation_note":"依完整本傳敘事／引語主語辨識，不以最近姓名機械延續。","paragraph_id":"c-jinshu-089-jishao:p008","chapter_id":"c-jinshu-089-jishao"},{"id":"c-jinshu-089-jishao:p008:m0089","start":89,"end":90,"surface":"翰","kind":"person","person_id":"n2x_d8l_n0d","status":"contextual_provisional","interpretation_note":"依完整本傳敘事／引語主語辨識，不以最近姓名機械延續。","paragraph_id":"c-jinshu-089-jishao:p008","chapter_id":"c-jinshu-089-jishao"},{"id":"c-jinshu-089-jishao:p008:m0095","start":95,"end":96,"surface":"翰","kind":"person","person_id":"n2x_d8l_n0d","status":"contextual_provisional","interpretation_note":"依完整本傳敘事／引語主語辨識，不以最近姓名機械延續。","paragraph_id":"c-jinshu-089-jishao:p008","chapter_id":"c-jinshu-089-ji