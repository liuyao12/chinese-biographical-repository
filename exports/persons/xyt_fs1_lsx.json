郡太守。載性閒雅，博學有文章。太康初，至蜀省父，道經劍閣。載以蜀人恃險好亂，因著銘以作誡曰：","subject_person_mention_id":"c-jinshu-055-zhang-zai:p001:m0000","object_person_mention_id":"c-jinshu-055-zhang-zai:p001:m0013"}],"status":"source_attested","interpretation_note":"省父於蜀以傳首收名相繫。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"title_holdings":[{"id":"th-w044-huaqiao-26","person_id":"xyt_fs1_lsx","title":"著作郎","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-044","chapter_id":"c-jinshu-044-huaqiao","source_id":"s-jinshu-044-huaqiao","paragraph_id":"c-jinshu-044-huaqiao:line112","quote":"嶠性嗜酒，率常沈醉。所撰書十典未成而終，秘書監何劭奏嶠中子徹為佐著作郎，使踵成之，未竟而卒。後監繆徵又奏嶠少子暢為佐著作郎，克成十典，並草魏、晉紀傳，與著作郎張載等俱在史官。永嘉喪亂，經籍遺沒，嶠書存者五十餘卷。","person_mention_id":"c-jinshu-044-huaqiao:line112:m0079"}],"attestations":[{"id":"th-w043-huaqiao-26:a","paragraph_id":"c-jinshu-044-huaqiao:line112","start":76,"end":79,"surface":"著作郎","person_mention_id":"c-jinshu-044-huaqiao:line112:m0079","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-044-huaqiao:line112","text":"嶠性嗜酒，率常沈醉。所撰書十典未成而終，秘書監何劭奏嶠中子徹為佐著作郎，使踵成之，未竟而卒。後監繆徵又奏嶠少子暢為佐著作郎，克成十典，並草魏、晉紀傳，與著作郎張載等俱在史官。永嘉喪亂，經籍遺沒，嶠書存者五十餘卷。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-044-huaqiao:line112:m0000","start":0,"end":1,"surface":"嶠","kind":"person","person_id":"7zi_5gs_mq2_AB","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-huaqiao:line112:m0023","start":23,"end":25,"surface":"何劭","kind":"person"