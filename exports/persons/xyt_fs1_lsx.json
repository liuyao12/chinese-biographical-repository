594,14595,14596,14597,14598,14599,14600,14601,14602,14603,14604,14605,14606,14607,14608,14609,14610,14611,14612,14613],"revision_id":2316433},"mentions":[{"id":"c-jinshu-055-zhang-xie:p001:m0000","surface":"協","start":0,"end":1,"person_id":"d35_kbb_uub","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-055-zhang-xie:p001:m0002","surface":"景陽","start":2,"end":4,"person_id":"d35_kbb_uub","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-055-zhang-xie:p001:m0011","surface":"載","start":11,"end":12,"person_id":"xyt_fs1_lsx","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-055-zhang-xie","book_id":"b-jinshu-055","work_id":"w-jinshu","source_id":"s-jinshu-055-zhang-xie-ws2316433"},{"id":"c-jinshu-055-zhang-zai:p001","text":"張載，字孟陽，安平人也。父收，蜀郡太守。載性閒雅，博學有文章。太康初，至蜀省父，道經劍閣。載以蜀人恃險好亂，因著銘以作誡曰：","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":150,"last_line":150,"raw_start":13300,"raw_end":13362,"raw_character_offsets":[13300,13301,13302,13303,13304,13305,13306,13307,13308,13309,13310,13311,13312,13313,13314,13315,13316,13317,13318,13319,13320,13321,13322,13323,13324,13325,13326,13327,13328,13329,13330,13331,13332,13333,13334,13335,13336,13337,13338,13339,13340,13341,13342,13343,13344,13345,13346,13347,13348,13349,13350,13351,13352,13353,13354,13355,13356,13357,13358,13359,13360,13361],"revision_id":2316433},"mentions":[{"id":"c-jinshu-055-zhang-zai:p001:m0000","surface":"張載","start":0,"end":2,"person_id":"xyt_fs1_lsx","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-055-zhang-zai:p001:m0004","surface":"孟陽","start":4,"end":6,"person_id":"xyt_fs1_lsx","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-055-zhang-zai:p001:m0013","surface":"收","start":13,"end":14,"person_id":"7tt_y7m_x6v","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-055-zhang-zai:p001:m0020","surface":"載","start":20,"end":21,"person_id":"xyt_fs1_lsx","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-055-zhang-zai:p001:m0045","surface":"載","start":45,"end":46,"person_id":"xyt_fs1_lsx","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-055-zhang-zai","book_id":"b-jinshu-055","work_id":"w-jinshu","source_id":"s-jinshu-055-zhang-zai-ws2316433"},{"id":"c-jinshu-055-zhang-zai:p004","text":"載又為《榷論》曰：","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":156,"last_line":156,"raw_start":13632,"raw_end":13641,"raw_character_offsets":[13632,13633,13634,13635,13636,13637,13638,13639,13640],"revision_id":2316433},"mentions":[{"id":"c-jinshu-055-zhang-zai:p004:m0000","surface":"載","start":0,"end":1,"person_id":"xyt_fs1_lsx","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-055-zhang-zai","book_id":"b-jinshu-055","work_id":"w-jinshu","source_id":"s-jinshu-055-zhang-zai-ws2316433"},{"id":"c-jinshu-055-zhang-zai:p007","text":"載又為《蒙汜賦》，司隸校尉傅玄見而嗟歎，以車迎之，言談盡日，為之延譽，遂知名。起家佐著作郎，出補肥鄉令。復為著作郎，轉太子中舍人，遷樂安相、弘農太守。長沙王乂請為記室督。拜中書侍郎，復領著作。載見世方亂，無復進仕意，遂稱疾篤告歸，卒於家。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":162,"last_line":162,"raw_start":14425,"raw_end":14544,"raw_character_offsets":[14425,14426,14427,14428,14429,14430,14431,14432,14433,14434,14435,14436,14437,14438,14439,14440,14441,14442,14443,14444,14445,14446,14447,14448,14449,14450,14451,14452,14453,14454,14455,14456,14457,14458,14459,14460,14461,14462,14463,14464,14465,14466,14467,14468,14469,14470,14471,14472,14473,14474,14475,14476,14477,14478,14479,14480,14481,14482,14483,14484,14485,14486,14487,14488,14489,14490,14491,14492,14493,14494,14495,14496,14497,14498,14499,14500,14501,14502,14503,14504,14505,14506,14507,14508,14509,14510,14511,14512,14513,14514,14515,14516,14517,14518,14519,14520,14521,14522,14523,14524,14525,14526,14527,14528,14529,14530,14531,14532,14533,14534,14535,14536,14537,14538,14539,14540,14541,14542,14543],"revision_id":