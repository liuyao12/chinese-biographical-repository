atus":"contextual_provisional"},{"id":"c-shiji-032-qi:m057-0328","start":328,"end":330,"surface":"丑父","kind":"person","person_id":"wsc_j2v_f87","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m057-0351","start":351,"end":352,"surface":"克","kind":"person","person_id":"xx7_loh_2ge","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m057-0355","start":355,"end":357,"surface":"丑父","kind":"person","person_id":"wsc_j2v_f87","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m057-0373","start":373,"end":375,"surface":"齊侯","kind":"person","person_id":"9w2_c77_53m_AA","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m057-0387","start":387,"end":388,"surface":"克","kind":"person","person_id":"xx7_loh_2ge","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m057-0389","start":389,"end":393,"surface":"蕭桐叔子","kind":"person","person_id":"gm9_yt2_fcc","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m057-0403","start":403,"end":405,"surface":"叔子","kind":"person","person_id":"gm9_yt2_fcc","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m057-0406","start":406,"end":408,"surface":"齊君","kind":"person","person_id":"9w2_c77_53m_AA","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m057-0410","start":410,"end":412,"surface":"齊君","kind":"person","person_id":"9w2_c77_53m_AA","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m057-0415","start":415,"end":418,"surface":"晉君母","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、族稱或未定指代；齊秉意茲等疑讀待版本校勘，不補熟知姓名。"}],"chapter_id":"c-shiji-032-qi","book_id":"b-shiji-032","work_id":"w-shiji","source_id":"s-shiji-032-qi"},{"id":"c-shiji-039-jin:p111","text":"六年春，鄭倍晉與楚盟，晉怒。欒書曰：「不可以當吾世而失諸侯。」乃發兵。厲公自將，五月度河。聞楚兵來救，范文子請公欲還。郤至曰：「發兵誅逆，見彊辟之，無以令諸侯。」遂與戰。癸巳，射中楚共王目，楚兵敗於鄢陵。子反收餘兵，拊循欲復戰，晉患之。共王召子反，其侍者豎陽穀進酒，子反醉，不能見。王怒，讓子反，子反死。王遂引兵歸。晉由此威諸侯，欲以令天下求霸。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m111-0035","start":35,"end":