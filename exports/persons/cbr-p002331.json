{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p002331","identity_policy":"contextual_provisional","person_ids":["cbr-p002331"],"persons":[{"id":"cbr-p002331","label":"晉出公（趙世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"晉出公","mention_ids":["c-shiji-043-zhao:m035-0000","c-shiji-043-zhao:m036-0000","c-shiji-043-zhao:m039-0024"]},{"surface":"出公","mention_ids":["c-shiji-043-zhao:m039-0047","c-shiji-043-zhao:m039-0050"]}],"evidence":[{"mention_id":"c-shiji-043-zhao:m035-0000","chapter_id":"c-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p035","quote":"晉出公"},{"mention_id":"c-shiji-043-zhao:m036-0000","chapter_id":"c-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p036","quote":"晉出公"},{"mention_id":"c-shiji-043-zhao:m039-0024","chapter_id":"c-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p039","quote":"晉出公"},{"mention_id":"c-shiji-043-zhao:m039-0047","chapter_id":"c-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p039","quote":"出公"},{"mention_id":"c-shiji-043-zhao:m039-0050","chapter_id":"c-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p039","quote":"出公"}]}],"mentions":[{"id":"c-shiji-043-zhao:m035-0000","start":0,"end":3,"surface":"晉出公","kind":"person","person_id":"cbr-p002331","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p035","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m036-0000","start":0,"end":3,"surface":"晉出公","kind":"person","person_id":"cbr-p002331","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p036","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m039-0024","start":24,"end":27,"surface":"晉出公","kind":"person","person_id":"cbr-p002331","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p039","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m039-0047","start":47,"end":49,"surface":"出公","kind":"person","person_id":"cbr-p002331","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p039","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m039-0050","start":50,"end":52,"surface":"出公","kind":"person","person_id":"cbr-p002331","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p039","chapter_id":"c-shiji-043-zhao"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji043-102","person_id":"cbr-p002331","surfaces":["出公","晉出公"],"scope":"same_chapter","chapter_ids":["c-shiji-043-zhao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-043-zhao:p035","quote":"晉出公十一年，知伯伐鄭。趙簡子疾，使太子毋卹將而圍鄭。知伯醉，以酒灌撃毋卹。毋卹群臣請死之。毋卹曰：「君所以置毋卹，爲能忍訽。」然亦慍知伯。知伯歸，因謂簡子，使廢毋卹，簡子不聽。毋卹由此怨知伯。"},{"paragraph_id":"c-shiji-043-zhao:p036","quote":"晉出公十七年，簡子卒，太子毋卹代立，是爲襄子。"},{"paragraph_id":"c-shiji-043-zhao:p039","quote":"襄子立四年，知伯與趙、韓、魏盡分其范、中行故地。晉出公怒，告齊、魯，欲以伐四卿。四卿恐，遂共攻出公。出公奔齊，道死。知伯乃立昭公曾孫驕，是爲晉懿公。知伯益驕。請地韓、魏，韓、魏與之。請地趙，趙不與，以其圍鄭之辱。知伯怒，遂率韓、魏攻趙。趙襄子懼，乃奔保晉陽。"}],"rationale":"限本篇連續敘事、是為、諡稱及明示親屬語境。周舍／周捨按諫臣同段暫接；兩位周、中山武公與趙武公、子朝與趙朝分開。圍鄭晉陽知伯與較早知伯文子仍分候選，不因同爵或熟知姓名合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-043-zhao:p035","text":"晉出公十一年，知伯伐鄭。趙簡子疾，使太子毋卹將而圍鄭。知伯醉，以酒灌撃毋卹。毋卹群臣請死之。毋卹曰：「君所以置毋卹，爲能忍訽。」然亦慍知伯。知伯歸，因謂簡子，使廢毋卹，簡子不聽。毋卹由此怨知伯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-043-zhao:m035-0000","start":0,"end":3,"surface":"晉出公","kind":"person","person_id":"cbr-p002331","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m035-0007","start":7,"end":9,"surface":"知伯","kind":"person","person_id":"cbr-p002332","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m035-0012","start":12,"end":15,"surface":"趙簡子","kind":"person","person_id":"cbr-p002292","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m035-0020","start":20,"end":22,"surface":"毋卹","kind":"person","person_id":"cbr-p002306","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m035-0027","start":27,"end":29,"surface":