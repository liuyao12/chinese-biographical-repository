aw_end":541,"raw_character_offsets":[521,522,523,524,525,526,527,528,529,530,531,532,533,534,535,536,537,538,539,540],"projection_sha256":"96913b63dc9ad745bc3b4f521063ce936e4ae14a5adbe3d429acc1208bde18f7"},"chapter_id":"c-liangshu-005-xuzhaopei-fangdeng","book_id":"b-liangshu-005","work_id":"w-liangshu","source_id":"s-liangshu-005-xuzhaopei-fangdeng-ws2312810"},{"id":"c-liangshu-044-xuzhaopei-children:p003","text":"及至麻溪，河東王率軍逆戰，方等擊之，軍敗，遂溺死，時年二十二。","mentions":[{"id":"c-liangshu-044-xuzhaopei-children:p003:m0013","surface":"方等","start":13,"end":15,"person_id":"rvc_bqx_v5w_A","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":2376749,"source_layer":"received_biography","first_line":43,"last_line":43,"line_start":302,"line_end":333,"raw_start":3544,"raw_end":3575,"raw_character_offsets":[3544,3545,3546,3547,3548,3549,3550,3551,3552,3553,3554,3555,3556,3557,3558,3559,3560,3561,3562,3563,3564,3565,3566,3567,3568,3569,3570,3571,3572,3573,3574],"projection_sha256":"cc49fa21e2998eefec16d1d01ac17eef86afce8e0c07f9b141f40c18a8b56b9e"},"chapter_id":"c-liangshu-044-xuzhaopei-children","book_id":"b-liangshu-044","work_id":"w-liangshu","source_id":"s-liangshu-044-xuzhaopei-children-ws2376749"},{"id":"c-liangshu-055-hedong-wangyu-parent:p001","text":"河東王譽字重孫，昭明太子第二子也。","mentions":[{"id":"c-liangshu-055-hedong-wangyu-parent:p001:m0003","surface":"譽","start":3,"end":4,"person_id":"0va_s3x_wb4_A","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-liangshu-055-hedong-wangyu-parent:p001:m0005","surface":"重孫","start":5,"end":7,"person_id":"0va_s3x_wb4_A","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":1530936,"source_layer":"received_biography","first_line":58,"last_line":58,"line_start":2,"line_end":19,"raw_start":3447,"raw_end":3464,"raw_character_offsets":[3447,3448,3449,3450,3451,3452,3453,3454,3455,3456,3457,3458,3459,3460,3461,3462,3463],"projection_sha256":"81b8e4f0937a9e219301b62ba9b7fced0b8acf93cc7498035a546f82246eafbf"},"chapter_id":"c-liangshu-055-hedong-wangyu-parent","book_id":"b-liangshu-055","work_id":"w-liangshu","source_id":"s-liangshu-055-hedong-wangyu-parent-ws1530936"},{"id":"c-nanshi-023-wangmai:p001","text":"勱字公齊，美風儀，博涉書史，恬然清簡，未嘗以利欲幹懷。仕梁為輕車河東王功曹史。王出鎮京口，勱將隨之蕃。范陽張纘時典選舉，勱造纘言別，纘嘉其風采，乃曰：「王生才地，豈可遊外府乎？」奏為太子洗馬。後為南徐州別駕從事史。","mentions":[{"id":"c-nanshi-023-wangmai:p001:m0000","surface":"勱","start":0,"end":1,"person_id":"q7m_r8k_2vn_ABAG","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangmai:p001:m0002","surface":"公齊","start":2,"end":4,"person_id":"q7m_r8k_2vn_ABAG","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangmai:p001:m0045","surface":"勱","start":45,"end":46,"person_id":"q7m_r8k_2vn_ABAG","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangmai:p001:m0053","surface":"張纘","start":53,"end":55,"person_id":"wec_66y_sxi","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangmai:p001:m0060","surface":"勱","start":60,"end":61,"person_id":"q7m_r8k_2vn_ABAG","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangmai:p001:m0062","surface":"纘","start":62,"end":63,"person_id":"wec_66y_sxi","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangmai:p001:m0066","surface":"纘","start":66,"end":67,"person_id":"wec_66y_sxi","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":2478204,"source_