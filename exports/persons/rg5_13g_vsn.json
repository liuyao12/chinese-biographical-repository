,6874,6875,6876,6877,6878,6879,6880,6881,6882,6883,6884,6885,6886,6887,6888,6889,6890,6891,6892,6893,6894,6895,6896,6897,6898,6899,6900,6901,6902,6903,6904,6905,6906,6907,6908,6909,6910,6911,6912,6913,6914,6915,6916,6917,6918,6919,6920],"revision_id":2025242},"mentions":[{"id":"c-jinshu-063-guomo:p004:m0000","surface":"默","start":0,"end":1,"person_id":"799_f6c_778","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-063-guomo:p004:m0020","surface":"劉胤","start":20,"end":22,"person_id":"rg5_13g_vsn","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-063-guomo:p004:m0097","surface":"胤","start":97,"end":98,"person_id":"rg5_13g_vsn","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-063-guomo:p004:m0121","surface":"胤","start":121,"end":122,"person_id":"rg5_13g_vsn","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-063-guomo:p004:m0124","surface":"胤","start":124,"end":125,"person_id":"rg5_13g_vsn","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-063-guomo","book_id":"b-jinshu-063","work_id":"w-jinshu","source_id":"s-jinshu-063-guomo-ws2025242"},{"id":"c-jinshu-063-guomo:p005","text":"初，默之被征距蘇峻也，下次尋陽，見胤，胤參佐張滿等輕默，倮露視之，默常切齒。至是，胤臘日餉默酒一器，肫一頭，默對信投之水中，忿憤益甚。又僑人蓋肫先略取祖煥所殺孔煒女為妻，煒家求之，張滿等使還其家，肫不與，因與胤、滿有隙。至是，肫謂默曰：「劉江州不受免，密有異圖，與長史司馬張滿、荀楷等日夜計謀，反逆已形，惟忌郭侯一人，云當先除郭侯而後起事。禍將至矣，宜深備之。」默既懷恨，便率其徒候旦門開襲胤。胤將吏欲距默，默呴之曰：「我被詔有所討，動者誅及三族。」遂入至內寢。胤尚與妾臥，默牽下斬之。出取胤僚佐張滿、荀楷等，誣以大逆。傳胤首于京師，詐作詔書，宜視內外。掠胤女及諸妾，並金寶還船。初云下都，俄而還，停胤故府，招桓宣、王愆期。愆期懼逼，勸默為平南、江州，默從之。愆期因逃廬山，桓宣固守不應。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":79,"last_line":79,"raw_start":6923,"raw_end":7277,"raw_character_offsets":[6925,6926,6927,6928,6929,6930,6931,6932,6933,6934,6935,6936,6937,6938,6939,6940,6941,6942,6943,6944,6945,6946,6947,6948,6949,6950,6951,6952,6953,6954,6955,6956,6957,6958,6959,6960,6961,6962,6963,6964,6965,6966,6967,6968,6969,6970,6971,6972,6973,6974,6975,6976,6977,6978,6979,6980,6981,6982,6983,6984