{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000684","identity_policy":"contextual_provisional","person_ids":["cbr-p000684"],"persons":[{"id":"cbr-p000684","label":"始成（本卷稱呼）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"始成","mention_ids":["c-shiji-007-xiangyu:m013-0405"]}],"evidence":[{"mention_id":"c-shiji-007-xiangyu:m013-0405","chapter_id":"c-shiji-007-xiangyu","paragraph_id":"c-shiji-007-xiangyu:p013","quote":"始成"}]}],"source_mention_summary":[{"source_id":"s-shiji-007-xiangyu","work_id":"w-shiji","book_id":"b-shiji-007","chapter_id":"c-shiji-007-xiangyu","mention_count":1,"mention_ids":["c-shiji-007-xiangyu:m013-0405"],"paragraph_ids":["c-shiji-007-xiangyu:p013"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-007-xiangyu"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-007-xiangyu:m013-0405","start":405,"end":407,"surface":"始成","kind":"person","person_id":"cbr-p000684","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p013","chapter_id":"c-shiji-007-xiangyu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-007-xiangyu:p013","text":"章邯軍棘原，項羽軍漳南，相持未戰。秦軍數卻，二世使人讓章邯。章邯恐，使長史欣請事。至咸陽，留司馬門三日，趙高不見，有不信之心。長史欣恐，還走其軍，不敢出故道，趙高果使人追之，不及。欣至軍，報曰：「趙高用事於中，下無可為者。今戰能勝，高必疾妒吾功；戰不能勝，不免於死。願將軍孰計之。」陳餘亦遺章邯書曰：「白起為秦將，南征鄢郢，北阬馬服，攻城略地，不可勝計，而竟賜死。蒙恬為秦將，北逐戎人，開榆中地數千里，竟斬陽周。何者？功多，秦不能盡封，因以法誅之。今將軍為秦將三歲矣，所亡失以十萬數，而諸侯并起滋益多。彼趙高素諛日久，今事急，亦恐二世誅之，故欲以法誅將軍以塞責，使人更代將軍以脫其禍。夫將軍居外久，多內卻，有功亦誅，無功亦誅。且天之亡秦，無愚智皆知之。今將軍內不能直諫，外為亡國將，孤特獨立而欲常存，豈不哀哉！將軍何不還兵與諸侯為從，約共攻秦，分王其地，南面稱孤；此孰與身伏鈇質，妻子為僇乎？」章邯狐疑，陰使候始成使項羽，欲約。約未成，項羽使蒲將軍日夜引兵度三戶，軍漳南，與秦戰，再破之。項羽悉引兵擊秦軍汙水上，大破之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-007-xiangyu:m013-0000","start":0,"end":2,"surface":"章邯","kind":"person","person_id":"cbr-p000605","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m013-0006","start":6,"end":8,"surface":"項羽","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m013-0022","start":22,"end":24,"surface":"二世","kind":"person","person_id":"cbr-p000534","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m013-0027","start":27,"end":29,"surface":"章邯","kind":"person","person_id":"cbr-p000605","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m013-0030","start":30,"end":32,"surface":"章邯","kind":"person","person_id":"cbr-p000605","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m013-0035","start":35,"end":38,"surface":"長史欣","kind":"person","person_id":"cbr-p000606","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m013-0052","start":52,"end":54,"surface":"趙高","kind":"person","person_id":"cbr-p000535","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m013-0063","start":63,"end":66,"surface":"長史欣","kind":"person","person_id":"cbr-p000606","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m013-0079","start":79,"end":81,"surface":"趙高","kind":"person","person_id":"cbr-p000535","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m013-0090","start":90,"end":91,"surface":"欣","kind":"person","person_id":"cbr-p000606","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m013-0098","start":98,"end":100,"surface":"趙高","kind":"person","person_id":"cbr-p000535","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m013-0116","start":116,"end":117,"surface":"高","kind":"person","person_id":"cbr-p000535","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m013-0141","start":141,"end":143,"surface":"陳餘","kind":"person","person_id":"cbr-p000675","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m013