{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"o0t_u0g_33q","canonical_person_id":"o0t_u0g_33q","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["o0t_u0g_33q"],"persons":[{"id":"o0t_u0g_33q","label":"衛青（佞幸列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"衛青","mention_ids":["c-shiji-125-ningxing:m004-0198"]}],"evidence":[{"mention_id":"c-shiji-125-ningxing:m004-0198","chapter_id":"c-shiji-125-ningxing","paragraph_id":"c-shiji-125-ningxing:p004","quote":"衛青"}]}],"source_mention_summary":[{"source_id":"s-shiji125-ningxing","work_id":"w-shiji","book_id":"b-shiji-125","chapter_id":"c-shiji-125-ningxing","mention_count":1,"mention_ids":["c-shiji-125-ningxing:m004-0198"],"paragraph_ids":["c-shiji-125-ningxing:p004"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji125-ningxing"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-125-ningxing:m004-0198","start":198,"end":200,"surface":"衛青","kind":"person","person_id":"o0t_u0g_33q","status":"contextual_provisional","paragraph_id":"c-shiji-125-ningxing:p004","chapter_id":"c-shiji-125-ningxing"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-125-ningxing:p004","text":"李延年，中山人也。父母及身兄弟及女，皆故倡也。延年坐法腐，給事狗中。而平陽公主言延年女弟善舞，上見，心說之，及入永巷，而召貴延年。延年善歌，為變新聲，而上方興天地祠，欲造樂詩歌弦之。延年善承意，弦次初詩。其女弟亦幸，有子男。延年佩二千石印，號協聲律。與上臥起，甚貴幸，埒如韓嫣也。久之，寖與中人亂，出入驕恣。及其女弟李夫人卒后，愛弛，則禽誅延年昆弟也。自是之后，內寵嬖臣大底外戚之家，然不足數也。衛青、霍去病亦以外戚貴幸，然頗用材能自進。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-125-ningxing:m004-0000","start":0,"end":3,"surface":"李延年","kind":"person","person_id":"qhp_lk5_t1e_A","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m004-0009","start":9,"end":10,"surface":"父","kind":"person","person_id":"qhp_lk5_t1e","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m004-0010","start":10,"end":11,"surface":"母","kind":"person","person_id":"f94_gpi_lqs","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m004-0013","start":13,"end":17,"surface":"兄弟及女","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-125-ningxing:m004-0023","start":23,"end":25,"surface":"延年","kind":"person","person_id":"qhp_lk5_t1e_A","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m004-0035","start":35,"end":39,"surface":"平陽公主","kind":"person","person_id":"ase_y0g_7gy","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m004-0040","start":40,"end":44,"surface":"延年女弟","kind":"person","person_id":"hol_vyz_o4g","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m004-0047","start":47,"end":48,"surface":"上","kind":"person","person_id":"2qs_2ct_nom","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m004-0062","start":62,"end":64,"surface":"延年","kind":"person","person_id":"qhp_lk5_t1e_A","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m004-0065","start":65,"end":67,"surface":"延年","kind":"person","person_id":"qhp_lk5_t1e_A","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m004-0076","start":76,"end":77,"surface":"上","kind":"person","person_id":"2qs_2ct_nom","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m004-0091","start":91,"end":93,"surface":"延年","kind":"person","person_id":"qhp_lk5_t1e_A","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m004-0102","start":102,"end":105