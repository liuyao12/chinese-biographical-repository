contextual_provisional"},{"id":"c-shiji-097-luli:m017-0117","start":117,"end":120,"surface":"平原君","kind":"person","person_id":"tkc_9z3_91l","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m017-0120","start":120,"end":121,"surface":"母","kind":"person","person_id":"clw_2zf_477","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m017-0124","start":124,"end":127,"surface":"辟陽侯","kind":"person","person_id":"697_9f9_d41","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m017-0130","start":130,"end":133,"surface":"平原君","kind":"person","person_id":"tkc_9z3_91l","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m017-0133","start":133,"end":134,"surface":"母","kind":"person","person_id":"clw_2zf_477","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m017-0143","start":143,"end":145,"surface":"陸賈","kind":"person","person_id":"fjo_zh4_b7q","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m017-0154","start":154,"end":157,"surface":"平原君","kind":"person","person_id":"tkc_9z3_91l","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m017-0158","start":158,"end":161,"surface":"平原君","kind":"person","person_id":"tkc_9z3_91l","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m017-0168","start":168,"end":169,"surface":"母","kind":"person","person_id":"clw_2zf_477","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m017-0173","start":173,"end":174,"surface":"母","kind":"person","person_id":"clw_2zf_477","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m017-0190","start":190,"end":193,"surface":"辟陽侯","kind":"person","person_id":"697_9f9_d41","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m017-0205","start":205,"end":208,"surface":"辟陽侯","kind":"person","person_id":"697_9f9_d41","status":"contextual_provisional"}],"chapter_id":"c-shiji-097-luli","book_id":"b-shiji-097","work_id":"w-shiji","source_id":"s-shiji-097-luli"},{"id":"c-shiji-097-luli:p018","text":"辟陽侯幸呂太后，人或毀辟陽侯於孝惠帝，孝惠帝大怒，下吏，欲誅之。呂太后慚，不可以言。大臣多害辟陽侯行，欲遂誅之。辟陽侯急，因使人欲見平原君。平原君辭曰：「獄急，不敢見君。」乃求見孝惠幸臣閎籍孺，說之曰：「君所以得幸帝，天下莫不聞。今辟陽侯幸太后而下吏，道路皆言君讒，欲殺之。今日辟陽侯誅，旦日太后含怒，亦誅君。何不肉袒為辟陽侯言於帝？帝聽君出辟陽侯，太后大驩。兩主共幸君，君貴富益倍矣。」於是閎籍孺大恐，從其計，言帝，果出辟陽侯。辟陽侯之囚，欲見平原君，平原君不見辟陽侯，辟陽侯以為倍己，大怒。及其成功出之，乃大驚。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-097-luli:m018-0000","start":0,"end":3,"surface":"辟陽侯","kind":"person","person_id":"697_9f9_d41","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m018-0004","start":4,"end":7,"surface":"呂太后","kind":"person","person_id":"otq_r9b_d3z","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m018-0011","start":11,"end":14,"surface":"辟陽侯","kind":"person","person_id":"697_9f9_d41","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m018-0015","start":15,"end":18,"surface":"孝惠帝","kind":"person","person_id":"noy_49h_qor","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m018-0019","start":19,"end":22,"surface":"孝惠帝","kind":"person","person_id":"noy_49h_qor","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m018-0032","start":32,"end":35,"surface":"呂太后","kind":"person","person_id":"otq_r9b_d3z","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m018-0046","start":46,"end":49,"surface":"辟陽侯","kind":"person","person_id":"697_9f9_d41","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m018-0056","start":56,"end":59,"surface":"辟陽侯","kind":"person","person_id":"697_9f9_d41","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m018-0066","start":66,"end":69,"surface":"平原君","kind":"person","person_id":"tkc_9z3_91l","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m018-0070","start":70,"end":73,"surface":"平原君","kind":"person","person_id":"tkc_9z3_91l","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m018-0089","start":89,"end":91,"surface":"孝惠","kind":"person","person_id":"noy_49h_qor","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m018-0093","start":93,"end":96,"surfac