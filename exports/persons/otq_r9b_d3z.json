tatus":"contextual_provisional"},{"id":"c-shiji-097-luli:m018-0236","start":236,"end":239,"surface":"辟陽侯","kind":"person","person_id":"697_9f9_d41","status":"contextual_provisional"}],"chapter_id":"c-shiji-097-luli","book_id":"b-shiji-097","work_id":"w-shiji","source_id":"s-shiji-097-luli"},{"id":"c-shiji-097-luli:p019","text":"呂太后崩，大臣誅諸呂，辟陽侯於諸呂至深，而卒不誅。計畫所以全者，皆陸生、平原君之力也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-097-luli:m019-0000","start":0,"end":3,"surface":"呂太后","kind":"person","person_id":"otq_r9b_d3z","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m019-0011","start":11,"end":14,"surface":"辟陽侯","kind":"person","person_id":"697_9f9_d41","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m019-0033","start":33,"end":35,"surface":"陸生","kind":"person","person_id":"fjo_zh4_b7q","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m019-0036","start":36,"end":39,"surface":"平原君","kind":"person","person_id":"tkc_9z3_91l","status":"contextual_provisional"}],"chapter_id":"c-shiji-097-luli","book_id":"b-shiji-097","work_id":"w-shiji","source_id":"s-shiji-097-luli"}],"sources":[{"chapter_id":"c-shiji-097-luli","work_id":"w-shiji","book_id":"b-shiji-097","source_id":"s-shiji-097-luli","source":{"title":"史記／卷097","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷097","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷097&oldid=1383195","revision_id":1383195,"accessed_on":"2026-10-09","extent":"24段傳世正文含太史公論，另附1段分層索隱述贊；排除導覽與空白。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"固定HTML一致，只去外緣空白；亨、尉他及尉佗等原字保留，前後陳留敘事分存。","note":"全27個HTML區塊已讀；無tooltip/reference/del/s，未核底本影像。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"dat