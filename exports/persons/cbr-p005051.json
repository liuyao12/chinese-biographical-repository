{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p005051","identity_policy":"contextual_provisional","person_ids":["cbr-p005051"],"persons":[{"id":"cbr-p005051","label":"周苛（魏豹彭越列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"周苛","mention_ids":["c-shiji-090-wei:m004-0189"]}],"evidence":[{"mention_id":"c-shiji-090-wei:m004-0189","chapter_id":"c-shiji-090-wei","paragraph_id":"c-shiji-090-wei:p004","quote":"周苛"}]}],"mentions":[{"id":"c-shiji-090-wei:m004-0189","start":189,"end":191,"surface":"周苛","kind":"person","person_id":"cbr-p005051","status":"contextual_provisional","paragraph_id":"c-shiji-090-wei:p004","chapter_id":"c-shiji-090-wei"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji090-019","person_id":"cbr-p005051","surfaces":["周苛"],"scope":"same_chapter","chapter_ids":["c-shiji-090-wei"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-090-wei:p004","quote":"漢王還定三秦，渡臨晉，魏王豹以國屬焉，遂從擊楚於彭城。漢敗，還至滎陽，豹請歸視親病，至國，即絕河津畔漢。漢王聞魏豹反，方東憂楚，未及擊，謂酈生曰：「緩頰往說魏豹，能下之，吾以萬戶封若。」酈生說豹。豹謝曰：「人生一世閒，如白駒過隙耳。今漢王慢而侮人，罵詈諸侯群臣如罵奴耳，非有上下禮節也，吾不忍復見也。」於是漢王遣韓信擊虜豹於河東，傳詣滎陽，以豹國為郡。漢王令豹守滎陽。楚圍之急，周苛遂殺魏豹。"}],"rationale":"依同段及連續事件明示姓名與用稱暫接，仲按字仲與述贊承接；秦漢用稱不全域替換，未名者不補姓名。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-090-wei:p004","text":"漢王還定三秦，渡臨晉，魏王豹以國屬焉，遂從擊楚於彭城。漢敗，還至滎陽，豹請歸視親病，至國，即絕河津畔漢。漢王聞魏豹反，方東憂楚，未及擊，謂酈生曰：「緩頰往說魏豹，能下之，吾以萬戶封若。」酈生說豹。豹謝曰：「人生一世閒，如白駒過隙耳。今漢王慢而侮人，罵詈諸侯群臣如罵奴耳，非有上下禮節也，吾不忍復見也。」於是漢王遣韓信擊虜豹於河東，傳詣滎陽，以豹國為郡。漢王令豹守滎陽。楚圍之急，周苛遂殺魏豹。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-090-wei:m004-0000","start":0,"end":2,"surface":"漢王","kind":"person","person_id":"cbr-p005049","status":"contextual_provisional"},{"id":"c-shiji-090-wei:m004-0011","start":11,"end":14,"surface":"魏王豹","kind":"person","person_id":"cbr-p005033","status":"conte