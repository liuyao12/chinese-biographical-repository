{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p005054","identity_policy":"contextual_provisional","person_ids":["cbr-p005054"],"persons":[{"id":"cbr-p005054","label":"曹咎（魏豹彭越列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"曹咎","mention_ids":["c-shiji-090-wei:m008-0091"]}],"evidence":[{"mention_id":"c-shiji-090-wei:m008-0091","chapter_id":"c-shiji-090-wei","paragraph_id":"c-shiji-090-wei:p008","quote":"曹咎"}]}],"mentions":[{"id":"c-shiji-090-wei:m008-0091","start":91,"end":93,"surface":"曹咎","kind":"person","person_id":"cbr-p005054","status":"contextual_provisional","paragraph_id":"c-shiji-090-wei:p008","chapter_id":"c-shiji-090-wei"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji090-022","person_id":"cbr-p005054","surfaces":["曹咎"],"scope":"same_chapter","chapter_ids":["c-shiji-090-wei"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-090-wei:p008","quote":"漢王之敗彭城解而西也，彭越皆復亡其所下城，獨將其兵北居河上。漢王三年，彭越常往來為漢游兵，擊楚，絕其後糧於梁地。漢四年冬，項王與漢王相距滎陽，彭越攻下睢陽、外黃十七城。項王聞之，乃使曹咎守成皋，自東收彭越所下城邑，皆復為楚。越將其兵北走穀城。漢五年秋，項王之南走陽夏，彭越復下昌邑旁二十餘城，得穀十餘萬斛，以給漢王食。"}],"rationale":"依同段及連續事件明示姓名與用稱暫接，仲按字仲與述贊承接；秦漢用稱不全域替換，未名者不補姓名。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-090-wei:p008","text":"漢王之敗彭城解而西也，彭越皆復亡其所下城，獨將其兵北居河上。漢王三年，彭越常往來為漢游兵，擊楚，絕其後糧於梁地。漢四年冬，項王與漢王相距滎陽，彭越攻下睢陽、外黃十七城。項王聞之，乃使曹咎守成皋，自東收彭越所下城邑，皆復為楚。越將其兵北走穀城。漢五年秋，項王之南走陽夏，彭越復下昌邑旁二十餘城，得穀十餘萬斛，以給漢王食。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-090-wei:m008-0000","start":0,"end":2,"surface":"漢王","kind":"person","person_id":"cbr-p005049","status":"contextual_provisional"},{"id":"c-shiji-090-wei:m008-0011","start":11,"end":13,"surface":"彭越","kind":"person","person_id":"cbr-p005038","status":"contextual_provisional"},{"id":"c-shiji-090-wei:m008-0030","start":30,"end":32,"su