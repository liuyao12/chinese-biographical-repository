rson","person_id":"aek_yfr_e0h","status":"contextual_provisional","paragraph_id":"c-shiji-091-qingbu:p003","chapter_id":"c-shiji-091-qingbu"}],"relations":[],"title_holdings":[{"id":"th-shiji091-001","person_id":"aek_yfr_e0h","title":"武信君","kind":"noble_rank","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-091-qingbu","source_id":"s-shiji-091-qingbu","paragraph_id":"c-shiji-091-qingbu:p003","quote":"項梁涉淮而西，擊景駒、秦嘉等，布常冠軍。項梁至薛，聞陳王定死，迺立楚懷王。項梁號為武信君，英布為當陽君。項梁敗死定陶，懷王徙都彭城，諸將英布亦皆保聚彭城。當是時，秦急圍趙，趙數使人請救。懷王使宋義為上將，范曾為末將，項籍為次將，英布、蒲將軍皆為將軍，悉屬宋義，北救趙。及項籍殺宋義於河上，懷王因立籍為上將軍，諸將皆屬項籍。項籍使布先渡河擊秦，布數有利，籍迺悉引兵涉河從之，遂破秦軍，降章邯等。楚兵常勝，功冠諸侯。諸侯兵皆以服屬楚者，以布數以少敗眾也。"}],"attestations":[{"id":"th-shiji091-001:a001","paragraph_id":"c-shiji-091-qingbu:p003","start":41,"end":44,"surface":"武信君","person_mention_id":"c-shiji-091-qingbu:m003-0037","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-091-qingbu","source_id":"s-shiji-091-qingbu","paragraph_id":"c-shiji-091-qingbu:p003","quote":"項梁涉淮而西，擊景駒、秦嘉等，布常冠軍。項梁至薛，聞陳王定死，迺立楚懷王。項梁號為武信君，英布為當陽君。項梁敗死定陶，懷王徙都彭城，諸將英布亦皆保聚彭城。當是時，秦急圍趙，趙數使人請救。懷王使宋義為上將，范曾為末將，項籍為次將，英布、蒲將軍皆為將軍，悉屬宋義，北救趙。及項籍殺宋義於河上，懷王因立籍為上將軍，諸將皆屬項籍。項籍使布先渡河擊秦，布數有利，籍迺悉引兵涉河從之，遂破秦軍，降章邯等。楚兵常勝，功冠諸侯。諸侯兵皆以服屬楚者，以布數以少敗眾也。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予與用稱分存；常冠軍不作官名，欲為帝不作即帝位，稱病反楚死亡不補官爵終期。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji091-009","person_id":"aek_yfr_e0h","surfaces":["項梁"],"scope":"same_chapter","chapter_ids":["c-shiji-091-qingbu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-091-qingbu:p002","quote":"陳勝之起也，布乃見番君，與其眾叛秦，聚兵數千人。番君以其女妻之。章邯之滅陳勝，破呂臣軍，布乃引兵北擊秦左右校，破之清波，引兵而東。聞項梁定江東會稽，涉江而西。陳嬰以項氏世為楚將，乃以兵屬項梁，渡淮南，英布、蒲將軍亦以兵屬項梁。"},{"paragraph_id":"c-shiji-091-qingbu:p003","quote":"項梁涉淮而西，擊景駒、秦嘉等，布常冠軍。項梁至薛，聞陳王定死，迺立楚懷王。項梁號為武信君，英布為當陽君。項梁敗死定陶，懷王徙都彭城，諸將英布亦皆保聚彭城。當是時，秦急圍趙，趙數使人請救。懷王使宋義為上將，范曾為末將，項籍為次將，英布、蒲將軍皆為將軍，悉屬宋義，北救趙。及項籍殺宋義於河上，懷王因立籍為上將軍，諸將皆屬項籍。項籍使布先渡河擊秦，布數有利，籍迺悉引兵涉河從之，遂破秦軍，降章邯等。楚兵常勝，功冠諸侯。諸侯兵皆以服屬楚者，以布數以少敗眾也。"}],"rationale":"按明示姓名、姓氏與局部敘事暫接，短名不全域替換；番君及蒲將軍不補未見姓名，范曾原字保留。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-091-qingbu:p002","text":"陳勝之起也，布乃見番君，與其眾叛秦，聚兵數千人。番君以其女妻之。章邯之滅陳勝，破呂臣軍，布乃引兵北擊秦左右校，破之清波，引兵而東。聞項梁定江東會稽，涉江而西。陳嬰以項氏世為楚將，乃以兵屬項梁，渡淮南，英布、蒲將軍亦以兵屬項梁。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-091-qingbu:m002-0000","start":0,"end":2,"surface":"陳勝","kind":"person","person_id":"2xk_syj_egr","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m002-0006","start":6,"end":7,"surface":"布","kind":"person","person_id":"dsv_qg0_ete","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m002-0009","start":9,"end":11,"surface":"番君","kind":"person","person_id":"3oc_7gw_pl5","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m002-0024","start":24,"end":26,"surface":"番君","kind":"person","person_id":"3oc_7gw_pl5","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m002-0027","start":27,"end":29,"surface":"其女","kind":"person","person_id":"3oc_7gw_pl5_A","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m002-0032","start":32,"end":34,"surface":"章邯","kind":"person","person_id":"s07_jue_39p","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m002-0036","start":36,"end":38,"surface":"陳勝","kind":"person","person_id":"2xk_syj_egr","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m002-0040","start":40,"end":42,"surface":"呂臣","kind":"person","person_id":"onj_4n3_xwi","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m002-0044","start":44,"end":45,"surface":"布","kind":"person","person_id":"dsv_qg0_ete","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m002-0066","start":66,"end":68,"surfa