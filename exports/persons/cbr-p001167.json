{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p001167","identity_policy":"contextual_provisional","person_ids":["cbr-p001167"],"persons":[{"id":"cbr-p001167","label":"莒子（莊公六年朝齊）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"莒子","mention_ids":["c-shiji-032-qi:m063-0093"]}],"evidence":[{"mention_id":"c-shiji-032-qi:m063-0093","chapter_id":"c-shiji-032-qi","paragraph_id":"c-shiji-032-qi:p063","quote":"莒子"}]}],"source_mention_summary":[{"source_id":"s-shiji-032-qi","work_id":"w-shiji","book_id":"b-shiji-032","chapter_id":"c-shiji-032-qi","mention_count":1,"mention_ids":["c-shiji-032-qi:m063-0093"],"paragraph_ids":["c-shiji-032-qi:p063"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-032-qi"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-032-qi:m063-0093","start":93,"end":95,"surface":"莒子","kind":"person","person_id":"cbr-p001167","status":"contextual_provisional","paragraph_id":"c-shiji-032-qi:p063","chapter_id":"c-shiji-032-qi"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-032-qi:p063","text":"六年，初，棠公妻好，棠公死，崔杼取之。莊公通之，數如崔氏，以崔杼之冠賜人。待者曰：「不可。」崔杼怒，因其伐晉，欲與晉合謀襲齊而不得閒。莊公嘗笞宦者賈舉，賈舉復侍，為崔杼閒公以報怨。五月，莒子朝齊，齊以甲戌饗之。崔杼稱病不視事。乙亥，公問崔杼病，遂從崔杼妻。崔杼妻入室，與崔杼自閉戶不出，公擁柱而歌。宦者賈舉遮公從官而入，閉門，崔杼之徒持兵從中起。公登臺而請解，不許；請盟，不許；請自殺於廟，不許。皆曰：「君之臣杼疾病，不能聽命。近於公宮。陪臣爭趣有淫者，不知二命。」公踰墻，射中公股，公反墜，遂弒之。晏嬰立崔杼門外，曰：「君為社稷死則死之，為社稷亡則亡之。若為己死己亡，非其私暱，誰敢任之！」門開而入，枕公尸而哭，三踴而出。人謂崔杼：「必殺之。」崔杼曰：「民之望也，捨之得民。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-032-qi:m063-0005","start":5,"end":7,"surface":"棠公","kind":"person","person_id":"cbr-p001165","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m06