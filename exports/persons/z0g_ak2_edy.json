referred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-035-peikai-family:p013:m0366","start":366,"end":368,"surface":"王波","kind":"person","person_id":"z0g_ak2_edy","status":"contextual_provisional","paragraph_id":"c-jinshu-035-peikai-family:p013","chapter_id":"c-jinshu-035-peikai-family"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-035-peikai-family:p013","text":"初，侍講東宮，曆黃門吏部郎、侍中。東海王越以為豫州刺史、北中郎將、假節。王浚承制，以憲為尚書。永嘉末，王浚為石勒所破，棗嵩等莫不謝罪軍門，貢賂交錯，惟憲及荀綽恬然私室。勒素聞其名，召而謂之曰：「王浚虐暴幽州，人鬼同疾。孤恭行乾憲，拯茲黎元，羈舊咸歡，慶謝交路。二君齊惡傲威，誠信岨絕，防風之戮，將誰歸乎？」憲神色侃然，泣而對曰：「臣等世荷晉榮，恩遇隆重。王浚凶粗醜正，尚晉之遺籓。雖欣聖化，義岨誠心。且武王伐紂，表商容之閭，未聞商容在倒戈之例也。明公既不欲以道化厲物，必于刑忍為治者，防風之戮，臣之分也。請就辟有司。」不拜而出。勒深嘉之，待以賓禮。勒乃簿王浚官寮親屬，皆貲至巨萬，惟憲與荀綽家有書百餘帙，鹽米各十數斛而已。勒聞之，謂其長史張賓曰：「名不虛也。吾不喜得幽州，喜獲二子。」署從事中郎，出為長樂太守。及勒僭號，未遑制度，與王波為之撰朝儀，於是憲章文物，擬于王者。勒大悅，署太中大夫，遷司徒。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-035-peikai-family:p013:m0017","start":17,"end":21,"surface":"東海王越","kind":"person","person_id":"9o2_vhv_r7y","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p013:m0036","start":36,"end":38,"surface":"王浚","kind":"person","person_id":"9c1_ff0_1b5","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p013:m0042","start":42,"end":43,"surface":"憲","kind":"person","person_id":"4ni_4t1_4o9_BCC","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p013:m0051","start":51,"end":53,"surface":"王浚","kind":"person","person_id":"9c1_ff0_1b5","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p013:m0054","start":54,"end":56,"surface":"石勒","kind":"person","person_id":"0c9_95a_18b","status":"