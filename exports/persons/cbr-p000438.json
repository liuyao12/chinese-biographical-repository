ion_note":"只記本文明示關係；不以繼位跳過闕代或推造父親。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji005-060","subject_person_id":"cbr-p000439","predicate":"brother","object_person_id":"cbr-p000438","status":"source_attested","evidence":[{"paragraph_id":"c-shiji-005-qin:p048","quote":"躁公卒，立其弟懷公","chapter_id":"c-shiji-005-qin","source_id":"s-shiji-005-qin"}],"qualifiers":{"source_term":"其弟","historicity":"historical_tradition"},"interpretation_note":"只記本文明示關係；不以繼位跳過闕代或推造父親。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji006-026","subject_person_id":"cbr-p000438","predicate":"father","object_person_id":"cbr-p000645","status":"source_attested","evidence":[{"paragraph_id":"c-shiji-006-shihuang:p083","quote":"剌龔公享國三十四年。葬入里。生躁公、懷公。其十年，彗星見。","chapter_id":"c-shiji-006-shihuang","source_id":"s-shiji-006-shihuang"}],"qualifiers":{"source_term":"生","historicity":"historical_tradition"},"interpretation_note":"保存卷末文本明示主張；若與本卷或前卷相反，仍分存，不推定此說較優或修改來源。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-005-qin:p047","text":"厲共公二年，蜀人來賂。十六年，塹河旁。以兵二萬伐大荔，取其王城。二十一年，初縣頻陽。晉取武成。二十四年，晉亂，殺智伯，分其國與趙、韓、魏。二十五年，智開與邑人來奔。三十三年，伐義渠，虜其王。三十四年，日食。厲共公卒，子躁公立。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m047-0000","start":0,"end":3,"surface":"厲共公","kind":"person","person_id":"cbr-p000436","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m047-0028","start":28,"end":30,"surface":"其王","kind":"unresolved","person_id":null,"status":"unresolved","note":"未定指代、群體或官稱；商君語為篇章指引，不當作獨立個人。"},{"id":"c-shiji-005-qin:m047-0056","start":56,"end":58,"surface":"智伯","kind":"person","person_id":"cbr-p000274","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m047-0074","start":74,"end":76,"surface":"智開","kind":"person","person_id":"cbr-p000437","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m047-0092","start":92,"end":94,"surface":"其王","kind":"unresolved","person_id":null,"status":"unresolved","note":"未定指代、群體或官稱；商君語為篇章指引，不當作獨立個人。"},{"id":"c-shiji-005-qin:m047-0103","start":103,"end":106,"surface":"厲共公","kind":"person","person_id":"cbr-p000436","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m047-0109","start":109,"end":111,"surface":"躁公","kind":"person","person_id":"cbr-p000438","status":"contextual_provisional"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-005-qin:p048","text":"躁公二年，南鄭反。十三年，義渠來伐，至渭南。十四年，躁公卒，立其弟懷公。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m048-0000","start":0,"end":2,"surface":"躁公","kind":"person","person_id":"cbr-p000438","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m048-0026","start":26,"end":28,"surface":"躁公","kind":"person","person_id":"cbr-p000438","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m048-0033","start":33,"end":35,"surface":"懷公","kind":"person","person_id":"cbr-p000439","status":"contextual_provisional"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-006-shihuang:p083","text":"剌龔公享國三十四年。葬入里。生躁公、懷公。其十年，彗星見。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:p083:m0000","start":0,"end":3,"surface":"剌龔公","kind":"person","person_id":"cbr-p000645","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p083:m0015","start":15,"end":17,"surface":"躁公","kind":"person","person_id":"cbr-p000438","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p083:m0018","start":18,"end":20,"surface":"懷公","kind":"person","person_id":"cbr-p000439","status":"contextual_provisional"}],"chapter_id":"c-shiji-006-shihuang","book_id":"b-shiji-006","work_id":"w-shiji","source_id":"s-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:p084","text":"躁公享國十四年。居受寢。葬悼公南。其元年，彗星見。","annotation_status":"named_mentions_first_p