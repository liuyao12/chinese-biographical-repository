i-023-peiqian-ws2376966:p012:m0001","start":1,"end":3,"surface":"韓宣","kind":"person","person_id":"sdf_7gn_zow","status":"contextual_provisional","interpretation_note":"依完整裴潛單元及具體上下文辨識；原字及見證層次保留。"},{"id":"c-sanguozhi-023-peiqian-ws2376966:p012:m0004","start":4,"end":6,"surface":"景然","kind":"person","person_id":"sdf_7gn_zow","status":"contextual_provisional","interpretation_note":"依完整裴潛單元及具體上下文辨識；原字及見證層次保留。"},{"id":"c-sanguozhi-023-peiqian-ws2376966:p012:m0021","start":21,"end":23,"surface":"丞相","kind":"person","person_id":"dad_b77_b38","status":"contextual_provisional","interpretation_note":"丞相召署的主語為曹操，非引語中丞相軍謀掾職名的拆字人物。"},{"id":"c-sanguozhi-023-peiqian-ws2376966:p012:m0047","start":47,"end":51,"surface":"臨菑侯植","kind":"person","person_id":"p6s_2qn_p8n","status":"contextual_provisional","interpretation_note":"臨菑侯植／子建為曹植，與已錄卷019臨菑侯植相符；不以後稱平原侯改本文封號或始年。"},{"id":"c-sanguozhi-023-peiqian-ws2376966:p012:m0064","start":64,"end":65,"surface":"宣","kind":"person","person_id":"sdf_7gn_zow","status":"contextual_provisional","interpretation_note":"依完整裴潛單元及具體上下文辨識；原字及見證層次保留。"},{"id":"c-sanguozhi-023-peiqian-ws2376966:p012:m0086","start":86,"end":87,"surface":"植","kind":"person","person_id":"p6s_2qn_p8n","status":"contextual_provisional","interpretation_note":"臨菑侯植／子建為曹植，與已錄卷019臨菑侯植相符；不以後稱平原侯改本文封號或始年。"},{"id":"c-sanguozhi-023-peiqian-ws2376966:p012:m0088","start":88,"end":89,"surface":"宣","kind":"person","person_id":"sdf_7gn_zow","status":"contextual_provisional","interpretation_note":"依完整裴潛單元及具體上下文辨識；原字及見證層次保留。"},{"id":"c-sanguozhi-023-peiqian-ws2376966:p012:m0107","start":107,"end":108,"surface":"宣","kind":"person","person_id":"sdf_7gn_zow","status":"contextual_provisional","interpretation_note":"依完整裴潛單元及具體上下文辨識；原字及見證層次保留。"},{"id":"c-sanguozhi-023-peiqian-ws2376966:p012:m0111","start":111,"end":112,"surface":"宣","kind":"person","person_id":"sdf_7gn_zow","status":"contextual_provisional","interpretation_note":"依完整裴潛單元及具體上下文辨識；原字及見證層次保留。"},{"id":"c-sanguozhi-023-peiqian-ws2376966:p01