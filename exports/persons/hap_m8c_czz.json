ved"},{"id":"c-shiji-126-huaji:m024-0369","start":369,"end":371,"surface":"河伯","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-126-huaji:m024-0401","start":401,"end":403,"surface":"河伯","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-126-huaji","book_id":"b-shiji-126","work_id":"w-shiji","source_id":"s-shiji126-huaji"},{"id":"c-shiji-126-huaji:p025","text":"西門豹即發民鑿十二渠，引河水灌民田，田皆溉。當其時，民治渠少煩苦，不欲也。豹曰：「民可以樂成，不可與慮始。今父老子弟雖患苦我，然百歲後期令父老子孫思我言。」至今皆得水利，民人以給足富。十二渠經絕馳道，到漢之立，而長吏以為十二渠橋絕馳道，相比近，不可。欲合渠水，且至馳道合三渠為一橋。鄴民人父老不肯聽長吏，以為西門君所為也，賢君之法式不可更也。長吏終聽置之。故西門豹為鄴令，名聞天下，澤流後世，無絕已時，幾可謂非賢大夫哉！","annotation_status":"in_progress","text_layer":"witness_appended_chu_note","mentions":[{"id":"c-shiji-126-huaji:m025-0000","start":0,"end":3,"surface":"西門豹","kind":"person","person_id":"hap_m8c_czz","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m025-0037","start":37,"end":38,"surface":"豹","kind":"person","person_id":"hap_m8c_czz","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m025-0054","start":54,"end":58,"surface":"父老子弟","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-126-huaji:m025-0069","start":69,"end":73,"surface":"父老子孫","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-126-huaji:m025-0106","start":106,"end":108,"surface":"長吏","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-126-huaji:m025-0149","start":149,"end":151,"surface":"長吏","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-126-huaji:m025-0171","start":171,"end":173,"surface":"長吏","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-126-huaji:m025-0179","start":179,"end":182,"surface":"西門豹","kind":"person","person_id":"hap_m8c_czz","status":"contextual_provisional"}],"chapter_id":"c-shiji-126-huaji","book_id":"b-shiji-126","work_id":"w-shiji","source_id":"s-shiji126-huaji"},{"id":"c-shiji-126-huaji:p026","text":"傳曰：「子產治鄭，民不能欺；子賤治單父，民不忍欺；西門豹治鄴，民不敢欺。」三子之才能誰最賢哉？辨治者當能別之。","annotation_status":"in_progress","text_layer":"witness_appended_chu_note","mentions":[{"id":"c-shiji-126-huaji:m026-0004","start":4,"end":6,"surface":"子產","kind":"person","person_id":"qjs_3hl_6ck_A","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m026-0014","start":14,"end":16,"surface":"子賤","kind":"person","person_id":"x3c_d03_60b","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m026-0025","start":25,"end":28,"surface":"西門豹","kind":"person","person_id":"hap_m8c_czz","status":"contextual_provisional"}],"chapter_id":"c-shiji-126-huaji","book_id":"b-shiji-126","work_id":"w-shiji","source_id":"s-shiji126-huaji"}],"sources":[{"chapter_id":"c-shiji-044-wei","work_id":"w-shiji","book_id":"b-shiji-044","source_id":"s-shiji-044-wei","source":{"title":"史記／卷044","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷044","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷044&oldid=7903606","revision_id":7903606,"accessed_on":"2026-10-09","extent":"70段正文；排除現代章節標題、斠勘空段與版權告示，只去除段落外緣空白。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"取得時HTML與固定修訂一致；現代分節標題不當古代正文，不收末尾現代版權告示。保留髙、僇、无等原字與引號。","note":"已讀全70段數位正文；未核古籍影像、可靠底本或現代研究，首輪不等於完成覆核。第62段[1]至[3]為數位註號，原樣保存但不是古代正文或史料陳述，未擷取現代註釋內容。"}}},{"chapter_id":"c-shiji-126-huaji","work_id":"w-shiji","book_id":"b-shiji-126","source_id":"s-shiji126-huaji","source":{"title":"史記／卷126","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷126","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷126&oldid=2609358","revision_id":2609358,"accessed_on":"2026-10-11","extent":"固定修訂全文27段；篇文12段、褚少孫補文14段、索隱述贊1段。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editoria