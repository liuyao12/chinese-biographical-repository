:[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"id":"name-jin098-xieyong-literal","person_id":"an8_qdt_kdh","surname":"謝","ming":"雍","hao":null,"title":null,"additional_names":[],"chapter_id":"c-jinshu-098-wangdun-comparison","paragraph_id":"c-jinshu-098-wangdun-comparison:p020","person_mention_id":"c-jinshu-098-wangdun-comparison:p020:m0112","source_anchor":{"start":112,"end":114,"surface":"謝雍"},"quote":"敦既得志，暴慢愈甚，四方貢獻多入己府，將相嶽牧悉出其門。徙含為征東將軍、都督揚州江西諸軍事，從弟舒為荊州，彬為江州，邃為徐州。含字處弘，凶頑剛暴，時所不齒，以敦貴重，故曆顯位。敦以沈充、錢鳳為謀主，諸葛瑤、鄧岳、周撫、李恆、謝雍為爪牙。充等並凶險驕恣，共相驅扇，殺戮自己；又大起營府，侵人田宅，發掘古墓，剽掠市道，士庶解體，咸知其禍敗焉。敦從弟豫章太守棱日夜切諫，敦怒，陰殺之。敦無子，養含子應。及敦病甚，拜應為武衛將軍以自副。錢鳳謂敦曰：「脫其不諱，便當以後事付應。」敦曰：「非常之事，豈常人所能！且應年少，安可當大事。我死之後，莫若解眾放兵，歸身朝廷，保全門戶，此計之上也。退還武昌，收兵自守，貢獻不廢，亦中計也。及吾尚存，悉眾而下，萬一僥倖，計之下也。」鳳謂其黨曰：「公之下計，乃上策也。」遂與沈充定謀，須敦死後作難。","status":"source_attested","human_reviewed":false,"model":null,"work_id":"w-jinshu","book_id":"b-jinshu-098","source_id":"s-jinshu098-wangdun-ws2614273-comparison"}],"mentions":[{"id":"c-jinshu-098-wangdun-comparison:p020:m0112","start":112,"end":114,"surface":"謝雍","person_id":"an8_qdt_kdh","kind":"person","paragraph_id":"c-jinshu-098-wangdun-comparison:p020","chapter_id":"c-jinshu-098-wangdun-comparison"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-098-wangdun-comparison:p020","text":"敦既得志，暴慢愈甚，四方貢獻多入己府，將相嶽牧悉出其門。徙含為征東將軍、都督揚州江西諸軍事，從弟舒為荊州，彬為江州，邃為徐州。含字處弘，凶頑剛暴，時所不齒，以敦貴重，故曆顯位。敦以沈充、錢鳳為謀主，諸葛瑤、鄧岳、周撫、李恆、謝雍為爪牙。充等並凶險驕恣，共相驅扇，殺戮自己；又大起營府，侵人田宅，發掘古墓，剽掠市道，士庶解體，咸知其禍敗焉。敦從弟豫章太守棱日夜切諫，敦怒，陰殺之。敦無子，養含子應。及敦病甚，拜應為武衛將軍以自副。錢鳳謂敦曰：「脫其不諱，便當以後事付應。」敦曰：「非常之事，豈常人所能！且應年少，安可當大事。我死之後，莫若解眾放兵，歸身朝廷，保全門戶，此計之上也。退還武昌，收兵自守，貢獻不廢，亦中計也。及吾尚存，悉眾而下，萬一僥倖，計之下也。」鳳謂其黨曰：「公之下計，乃上策也。」遂與沈充定謀，須敦死後作難。","text_l