ths":[],"mentions":[{"id":"c-jinshu-070-weihong:p001:m0310","surface":"程嬰","start":310,"end":312,"person_id":"r0e_q5p_4uh","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-070-weihong:p001","chapter_id":"c-jinshu-070-weihong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-070-weihong:p001","text":"初，京兆韋泓喪亂之際，親屬遇饑疫並盡，客遊洛陽，素聞詹名，遂依託之。詹與分甘共苦，情若弟兄。遂隨從積年，爲營伉儷，置居宅，并薦之於元帝曰：「自遭喪亂，人士易操，至乃任運固窮，耿介守節者尟矣。伏見議郎韋泓，年三十八，字元量，執心清沖，才識備濟，躬耕隴畝，不煩人役，靜默居常，不豫政事。昔年流移，來在詹境，經寇喪資，一身特立，短褐不掩形，菜蔬不充朝，而抗志彌厲，不遊非類。顏回稱不改其樂，泓有其分。明公輔亮皇室，恢維宇宙，四門開闢，英彥鳧藻，收春華於京輦，採秋實於巖藪。而泓抱璞荊山，未剖和璧。若蒙銓召，付以列曹，必能協隆鼎味，緝熙庶績者也。」帝即辟之。自後位至少府卿。既受詹生成之惠，詹卒，遂製朋友之服，哭止宿草，追趙氏祀程嬰、杵臼之義，祭詹終身。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":33,"last_line":33,"raw_start":2553,"raw_end":2883,"raw_character_offsets":[2560,2561,2562,2563,2564,2565,2566,2567,2568,2569,2570,2571,2572,2573,2574,2575,2576,2577,2578,2579,2580,2581,2582,2583,2584,2585,2586,2587,2588,2589,2590,2591,2592,2593,2594,2595,2596,2597,2598,2599,2600,2601,2602,2603,2604,2605,2606,2607,2608,2609,2610,2611,2612,2613,2614,2615,2616,2617,2618,2619,2620,2621,2622,2623,2624,2625,2626,2627,2628,2629,2630,2631,2632,2633,2634,2635,2636,2637,2638,2639,2640,2641,2642,2643,2644,2645,2646,2647,2648,2649,2650,2651,2652,2653,2654,2655,2656,2657,2658,2659,2660,2661,2662,2663,2664,2665,2666,2667,2668,2669,2670,2671,2672,2673,2674,2675,2676,2677,2678,2679,2680,2681,2682,2683,2684,2685,2686,2687,2688,2689,2690,2691,2692,2693,2694,2695,2696,2697,2698,2699,2700,2701,2702,2703,2704,2705,2706,2707,2708,2709,2710,2711,2712,2713,2714,2715,2716,2717,2718,2719,2720,2721,2722,2723,2724,2725,2726,2727,2728,2729,2730,2731,2732,2733,2734,2735,2736,2737,2738,2739,2740,2741,2742,2743,2744,2745,2746,2747,2748,2749,2750,2751,2752,2753,2