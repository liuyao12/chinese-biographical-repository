pe":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-097-luli:m008-0016","start":16,"end":18,"surface":"黥布","kind":"person","person_id":"cbr-p005466","status":"contextual_provisional","paragraph_id":"c-shiji-097-luli:p008","chapter_id":"c-shiji-097-luli"},{"id":"c-shiji-097-luli:m016-0017","start":17,"end":19,"surface":"黥布","kind":"person","person_id":"cbr-p005466","status":"contextual_provisional","paragraph_id":"c-shiji-097-luli:p016","chapter_id":"c-shiji-097-luli"},{"id":"c-shiji-097-luli:m016-0028","start":28,"end":30,"surface":"黥布","kind":"person","person_id":"cbr-p005466","status":"contextual_provisional","paragraph_id":"c-shiji-097-luli:p016","chapter_id":"c-shiji-097-luli"},{"id":"c-shiji-097-luli:m016-0031","start":31,"end":32,"surface":"布","kind":"person","person_id":"cbr-p005466","status":"contextual_provisional","paragraph_id":"c-shiji-097-luli:p016","chapter_id":"c-shiji-097-luli"},{"id":"c-shiji-097-luli:m016-0047","start":47,"end":48,"surface":"布","kind":"person","person_id":"cbr-p005466","status":"contextual_provisional","paragraph_id":"c-shiji-097-luli:p016","chapter_id":"c-shiji-097-luli"},{"id":"c-shiji-097-luli:m016-0062","start":62,"end":63,"surface":"布","kind":"person","person_id":"cbr-p005466","status":"contextual_provisional","paragraph_id":"c-shiji-097-luli:p016","chapter_id":"c-shiji-097-luli"},{"id":"c-shiji-097-luli:m016-0079","start":79,"end":81,"surface":"黥布","kind":"person","person_id":"cbr-p005466","status":"contextual_provisional","paragraph_id":"c-shiji-097-luli:p016","chapter_id":"c-shiji-097-luli"}],"relations":[],"title_holdings":[{"id":"th-shiji097-017","person_id":"cbr-p005466","title":"淮南王","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-097-luli","source_id":"s-shiji-097-luli","paragraph_id":"c-shiji-097-luli:p016","quote":"平原君朱建者，楚人也。故嘗為淮南王黥布相，有罪去，後復事黥布。布欲反時，問平原君，平原君非之，布不聽而聽梁父侯，遂反。漢已誅布，聞平原君諫不與謀，得不誅。語在黥布語中。"}],"attestations":[{"id":"th-shiji097-017:a001","paragraph_id":"c-shiji-097-luli:p016","start":14,"end":17,"surface":"淮南王","person_mention_id":"c-shiji-097-luli:m016-0017","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"實授、敘事用稱與自立分存；死亡不自動終止官爵。陸賈病免依官職承接，文帝時陳丞相言陸生為太中大夫保留用稱，不冒作明示拜授。朱建後復事黥布不等於明示復相。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji097-029","person_id":"cbr-p005466","scope":"same_chapter","chapter_ids":["c-shiji-097-luli"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["布","黥布"],"evidence":[{"paragraph_id":"c-shiji-097-luli:p008","quote":"漢十二年，曲周侯酈商以丞相將兵擊黥布有功。高祖舉列侯功臣，思酈食其。酈食其子疥數將兵，功未當侯，上以其父故，封疥為高梁侯。後更食武遂，嗣三世。元狩元年中，武遂侯平坐詐詔衡山王取百斤金，當棄市，病死，國除也。"},{"paragraph_id":"c-shiji-097-luli:p016","quote":"平原君朱建者，楚人也。故嘗為淮南王黥布相，有罪去，後復事黥布。布欲反時，問平原君，平原君非之，布不聽而聽梁父侯，遂反。漢已誅布，聞平原君諫不與謀，得不誅。語在黥布語中。"}],"rationale":"按酈生、陸賈與朱建分傳及敘事承接限定異稱；尉他尉佗原字分存。平原君據明示朱建另候選；朱建兩處未名子尚不合併，淮陰侯與單稱韓信跨篇同指待證。引語古王及神話人物與當事人分開。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-097-luli:p008","text":"漢十二年，曲周侯酈商以丞相將兵擊黥布有功。高祖舉列侯功臣，思酈食其。酈食其子疥數將兵，功未當侯，上以其父故，封疥為高梁侯。後更食武遂，嗣三世。元狩元年中，武遂侯平坐詐詔衡山王取百斤金，當棄市，病死，國除也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-097-luli:m008-0008","start":8,"end":10,"surface":"酈商","kind":"person","person_id":"cbr-p005443","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m008-0016","start":16,"end":18,"surface":"黥布","kind":"person","person_id":"cbr-p005466","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m008-0021","start":21,"end":23,"surface":"高祖","kind":"person","person_id":"cbr-p005442","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m008-0030","start":30,"end":33,"surface":"酈食其","kind":"person","person_id":"cbr-p005438","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m008-0034","start":34,"end":37,"surface":"酈食其","kind":"person","person_id":"cbr-p005438","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m008-0038","start":38,"end":39,"surface":"疥","kind":"person","person_id":"cbr-p005476","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m008-0055","start":55,"end":56,"surface":"疥","kind":"person","person_id":"cbr-p005476","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m008-0077","start":77,"end":81,"surface":"武遂侯平","kind":"person","person_id":"cbr-p005449","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m008-0084","start":84,"end":87,"surface":"衡山王","kind":"person","person_id":"cbr-p005454","status":"contextual_provisional"}],"chapter_id":"c-shiji-097-luli","book_id":"b-shiji-097","work_id":"w-shiji","source_id":"s-shiji-097-luli"},{"id":"c-shiji-097-luli:p016","text":"平原君朱建者，楚人也。故嘗為淮南王黥布相，有罪去，後復事黥布。布欲反時，問平原君，平原君非之，布不聽而聽梁父侯，遂反。漢已誅布，聞平原君諫不與謀，得不誅。語在黥布語中。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-097-luli:m016-0000","start":0,"end":5,"surface":"平原君朱建","kind":"person","person_id":"cbr-p005448","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m016-0017","start":17,"end":19,"surface":"黥布","kind":"person","person_id":"cbr-p005466","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m016-0028","start":28,"end":30,"surface":"黥布","kind":"person","person_id":"cbr-p005466","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m016-0031","start":31,"end":32,"surface":"布","kind":"person","person_id":"cbr-p005466","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m016-0037","start":37,"end":40,"surface":"平原君","kind":"person","person_id":"cbr-p005448","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m016-0041","start":41,"end":44,"surface":"平原君","kind":"person","person_id":"cbr-p005448