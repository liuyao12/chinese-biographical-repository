:p004","chapter_id":"c-songshu-041-wangzhenfeng"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanshi-011-wangzhenfeng-izumo:p002","text":"廢帝即位尊為皇太后宮曰弘訓廢帝失德太后每加勗譬始猶見順後狂慝稍甚太后嘗賜帝玉柄毛扇帝嫌毛扇不華因此欲加酖害令太醫煑藥左右止之曰若行此事官便作孝子豈得出入狡獪帝曰汝語大有理乃止順帝即位齊高帝執權宗室劉晃劉綽卜伯興等有異志太后頗與相關順帝禪位太后與帝遜于東邸因遷居丹楊宮拜汝陰王太妃順帝殂于丹楊更立第都下建元元年薨于第追加諡葬以宋禮后父僧朗別有傳","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-nanshi-011-wangzhenfeng-izumo:p002:u0054","start":54,"end":56,"surface":"太醫","person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"太醫與左右皆未具名；汝指勸阻之人。"},{"id":"c-nanshi-011-wangzhenfeng-izumo:p002:u0058","start":58,"end":60,"surface":"左右","person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"太醫與左右皆未具名；汝指勸阻之人。"},{"id":"c-nanshi-011-wangzhenfeng-izumo:p002:u0080","start":80,"end":81,"surface":"汝","person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"太醫與左右皆未具名；汝指勸阻之人。"},{"id":"c-nanshi-011-wangzhenfeng-izumo:p002:m0098","start":98,"end":100,"surface":"劉晃","person_id":"3qs_nqa_ioa_AABABA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳人名、親屬及稱號。"},{"id":"c-nanshi-011-wangzhenfeng-izumo:p002:m0100","start":100,"end":102,"surface":"劉綽","person_id":"ptn_sz3_vro_BA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳人名、親屬及稱號。"},{"id":"c-nanshi-011-wangzhenfeng-izumo:p002:m0102","start":102,"end":105,"surface":"卜伯興","person_id":"i00_t56_vx4","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳人名、親屬及稱號。"},{"id":"c-nanshi-011-wangzhenfeng-izumo:p002:m0134","start":134,"end":139,"surface":"汝陰王太妃","person_id":"q7m_r8k_2vn_B","kind":"person","status":"contextual_provisional","interpretation_note":"宋禪齊後王貞風之封號。"},{"id":"c-nanshi-011-wangzhenfeng-izumo:p002:m0139","start":139,"end":141,"surface":"順帝","person_id":"6y2_apj_l05","kind":"person","status":"contextual_provisional","interpretation_note":"禪位後去世者劉準。"},{"id":"c-nanshi-011-wangzhenfeng-izumo:p002:m0166","start":166,"end":168,"surface":"僧朗","person_id":"q7m_r8k_2vn","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳人名、親屬及稱號。"}],"source_position":{"revision_id":"cbr-ai-transcription-sha256:80c2b36684dc90339438687348b987e2c3388212c5127da7c3e4b85e39544fb3","source_layer":"received_biography","column_projection":[{"pdf_page":15,"half":"左","leaf":"十三上","column_from_right":1,"start":12,"end":18,"text":"廢帝即位尊為"},{"pdf_page":15,"half":"左","leaf":"十三上","column_from_right":2,"start":0,"end":18,"text":"皇太后宮曰弘訓廢帝失德太后每加勗譬始"},{"pdf_page":15,"half":"左","leaf":"十三上","column_from_right":3,"start":0,"end":18,"text":"猶見順後狂慝稍甚太后嘗賜帝玉柄毛扇帝"},{"pdf_page":15,"half":"左","leaf":"十三上","column_from_right":4,"start":0,"end":18,"text":"嫌毛扇不華因此欲加酖害令太醫煑藥左右"},{"pdf_page":15,"half":"左","leaf":"十三上","column_from_right":5,"start":0,"end":18,"text":"止之曰若行此事官便作孝子豈得出入狡獪"},{"pdf_page":15,"half":"左","leaf":"十三上","column_from_right":6,"start":0,"end":18,"text":"帝曰汝語大有理乃止順帝即位齊高帝執權"},{"pdf_page":15,"half":"左","leaf":"十三上","column_from_right":7,"start":0,"end":18,"text":"宗室劉晃劉綽卜伯興等有異志太后頗與相"},{"pdf_page":15,"half":"左","leaf":"十三上","column_from_right":8,"start":0,"end":18,"text":"關順帝禪位太后與帝遜于東邸因遷居丹楊"},{"pdf_page":15,"half":"左","leaf":"十三上","column_from_right":9,"start":0,"end":18,"text":"宮拜汝陰王太妃順帝殂于丹楊更立第都下"},{"pdf_page":16,"half":"右","leaf":"十三下","column_from_right":1,"start":0,"end":18,"text":"建元元年薨于第追加諡葬以宋禮后父僧朗"},{"pdf_page":16,"half":"右","leaf":"十三下","column_from_right":2,"start":0,"end":3,"text":"別有傳"}]},"chapter_id":"c-nanshi-011-wangzhenfeng-izumo","book_id":"b-nanshi-011","work_id":"w-nanshi","source_id":"s-nanshi-011-wangzhenfeng-izumo"},{"id":"c-nanshi-011-wangzhenfeng:p002","text":"廢帝即位，尊為皇太后，宮曰弘訓。廢帝失德，太后每加勖譬，始猶見順，後狂慝稍甚。太后嘗賜帝玉柄毛扇，帝嫌毛扇不華，因此欲加酖害，令太醫煮藥。左右止之曰：「若行此事，官便作孝子，豈得出入狡獪。」帝曰：「汝語大有理。」乃止。順帝即位，齊高帝執權，宗室劉晃、劉綽、卜伯興等有異志，太后頗與相關。順帝禪位，太后與帝遜于東邸，因遷居丹陽宮，拜汝陰王太妃。順帝殂於丹陽，更立第都下。建元元年，薨於第，追加諡，葬以宋禮。后父僧朗，別有傳。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-nanshi-011-wangzhenfeng:p002:u0064","start":64,"end":66,"surface":"太醫","person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"太醫與左右皆未具名；汝指勸阻之人。"},{"id":"c-nanshi-011-wangzhenfeng:p002:u0069","start":69,"end":71,"surface":"左右","person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"太醫與左右皆未具名；汝指勸阻之人。"},{"id":"c-nanshi-011-wangzhenfeng:p002:u0099","start":99,"end":100,"surface":"汝","person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"太醫與左右皆未具名；汝指勸阻之人。"},{"id":"c-nanshi-011-wangzhenfeng:p002:m0122","start":122,"end":124,"surface":"劉晃","person_id":"3qs_nqa_ioa_AABABA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳人名、親屬及稱號。"},{"id":"c-nanshi-011-wangzhenfeng:p002:m0125","start":125,"end":127,"surface":"劉綽","person_id":"ptn_sz3_vro_BA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳人名、親屬及稱號。"},{"id":"c-nanshi-011-wangzhenfeng:p002:m0128","start":128,"end":131,"surface":"卜伯興","person_id":"i00_t56_vx4","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳人名、親屬及稱號。"},{"id":"c-nanshi-011-wangzhenfeng:p002:m0165","start":165,"end":170,"surface":"汝陰王太妃","person_id":"q7m_r8k_2vn_B","kind":"person","status":"contextual_provisional","interpretation_note":"宋禪齊後王貞風之封號。"},{"id":"c-nanshi-011-wangzhenfeng:p002:m0171","start":171,"end":173,"surface":"順帝","person_id":"6y2_apj_l05","kind":"person","status":"contextual_provisional","interpretation_note":"禪位後去世者劉準。"},{"id":"c-nanshi-011-wangzhenfeng:p002:m0204","start":204,"end":206,"surface":"僧朗","person_id":"q7m_r8k_2vn","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳人名、親屬及稱號。"}],"source_position":{"first_line":76,"last_line":76,"rev