hip_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"id":"name-jin031-ner-liuhong-literal","person_id":"9st_jp9_lf7","surname":"劉","ming":"弘","hao":null,"title":null,"additional_names":[],"chapter_id":"c-jinshu-031-jia-comparison","paragraph_id":"c-jinshu-031-jia-comparison:p007","person_mention_id":"c-jinshu-031-jia-comparison:p007:m0216","source_anchor":{"start":216,"end":218,"surface":"劉弘"},"quote":"及太子廢黜，趙王倫、孫秀等因眾怨謀欲廢后。后數遣宮婢微服於人間視聽，其謀頗泄。后甚懼，遂害太子，以絕眾望。趙王倫乃率兵入宮，使翊軍校尉齊王冏入殿廢后。后與冏母有隙，故倫使之。后驚曰：「卿何為來！」冏曰：「有詔收后。」后曰：「詔當從我出，何詔也？」后至上閤，遙呼帝曰：「陛下有婦，使人廢之，亦行自廢。」又問冏曰：「起事者誰？」冏曰：「梁、趙。」后曰：「繫狗當繫頸，今反繫其尾，何得不然！」至宮西，見謐尸，再舉聲而哭遽止。倫乃矯詔遣尚書劉弘等持節齎金屑酒賜后死。后在位十一年。趙粲、賈午、韓壽、董猛等皆伏誅。","status":"editorial_provisional","human_reviewed":false,"model":null,"work_id":"w-jinshu","book_id":"b-jinshu-031","source_id":"s-jinshu031-jia-ws2479706-comparison"}],"mentions":[{"start":216,"end":218,"surface":"劉弘","id":"c-jinshu-031-jia-comparison:p007:m0216","kind":"person","person_id":"9st_jp9_lf7","status":"source_attested","paragraph_id":"c-jinshu-031-jia-comparison:p007","chapter_id":"c-jinshu-031-jia-comparison"}],"relations":[],"title_holdings":[{"id":"th-jin031-liuhong","person_id":"9st_jp9_lf7","title":"尚書","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-031","source_id":"s-jinshu031-jia-ws2479706-comparison","chapter_id":"c-jinshu-031-jia-comparison","paragraph_id":"c-jinshu-031-jia-comparison:p007","quote":"及太子廢黜，趙王倫、孫秀等因眾怨謀欲廢后。后數遣宮婢微服於人間視聽，其謀頗泄。后甚懼，遂害太子，以絕眾望。趙王倫乃率兵入宮，使翊軍校尉齊王冏入殿廢后。后與冏母有隙，故倫使之。后驚曰：「卿何為來！」冏曰：「有詔收后。」后曰：「詔當從我出，何詔也？」后至上閤，遙呼帝曰：「陛下有婦，使人廢之，亦行自廢。」又問冏曰：「起事者誰？」冏曰：「梁、趙。」后曰：「繫狗當繫頸，今反繫其尾，何得不然！」至宮西，見謐尸，再舉聲而哭遽止。倫乃矯詔遣尚書劉弘等持節齎金屑酒賜后死。后在位十一年。趙粲、賈午、韓壽、董猛等皆伏誅。","person_mention_id":"c-jinshu-031-j