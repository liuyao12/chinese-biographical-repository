馮嵩執穎及普、廓送鄴，范陽王虓幽之，而無他意。屬虓暴薨，虓長史劉輿見穎為鄴都所服，慮為後患，秘不發喪，偽令人為臺使，稱詔夜賜穎死。穎謂守者田徽曰：「范陽王亡乎？」徽曰：「不知。」穎曰：「卿年幾？」徽曰：「五十。」穎曰：「知天命不？」徽曰：「不知。」穎曰：「我死之後，天下安乎不安乎？我自放逐，於今三年，身體手足不見洗沐，取數斗湯來！」其二子號泣，穎敕人將去。乃散發東首臥，命徽縊之，時年二十八。二子亦死。鄴中哀之。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","source_position":{"raw_start":16697,"raw_end":17084,"raw_line":163,"wikitext_sha256":"a83fe708c8dffc5965863d337a19fd4e7222ae41e29aa99e1c2a11ed8030d1d3"},"mentions":[{"id":"c-jinshu-059-wei-ying-children:p002:m0000","start":0,"end":1,"surface":"穎","kind":"person","person_id":"dkn_ge4_286_AAAAIAC","status":"contextual_provisional","source_role":"ying"},{"id":"c-jinshu-059-wei-ying-children:p002:m0013","start":13,"end":16,"surface":"公師籓","kind":"person","person_id":"xmp_cnb_pvt","status":"contextual_provisional","source_role":"gongshifan"},{"id":"c-jinshu-059-wei-ying-children:p002:m0017","start":17,"end":19,"surface":"汲桑","kind":"person","person_id":"axz_rnu_ukl","status":"contextual_provisional","source_role":"jisang"},{"id":"c-jinshu-059-wei-ying-children:p002:m0024","start":24,"end":25,"surface":"穎","kind":"person","person_id":"dkn_ge4_286_AAAAIAC","status":"contextual_provisional","source_role":"ying"},{"id":"c-jinshu-059-wei-ying-children:p002:m0031","start":31,"end":32,"surface":"顒","kind":"person","person_id":"ed0_313_bea","status":"contextual_provisional","source_role":"yong"},{"id":"c-jinshu-059-wei-ying-children:p002:m0034","start":34,"end":35,"surface":"穎","kind":"person","person_id":"dkn_ge4_286_AAAAIAC","status":"contextual_provisional","source_role":"ying"},{"id":"c-jinshu-059-wei-ying-children:p002:m0057","start":57,"end":58,"surface":"穎","kind":"person","person_id":"dkn_ge4_286_AAAAIAC","status":"contextual_provisional","source_role":"ying"},{"id":"c-jinshu-059-wei-ying-children:p002:m0062","start":62,"end":66,"surface":"東海王越","kind":"person","person_id":"dkn_ge4_286_AAADBA","status":"contextual_provisional","source_role":"yue"},{"id":"c-jinshu-059-wei-ying-children:p