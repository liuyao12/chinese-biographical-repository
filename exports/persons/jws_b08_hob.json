tus":"source_attested","evidence":[{"chapter_id":"c-shiji-120-jizheng","source_id":"s-shiji120-jizheng","paragraph_id":"c-shiji-120-jizheng:p016","quote":"鄭莊以任俠自喜，脫張羽於緦聲聞梁楚之閒。孝景時，為太子舍人。每五日洗沐，常置驛馬安諸郊，存諸故人，請謝賓客，夜以繼日，至其明旦，常恐不遍。莊好黃老之言，其慕長者如恐不見。年少官薄，然其游知交皆其大父行，天下有名之士也。武帝立，莊稍遷為魯中尉、濟南太守、江都相，至九卿為右內史。以武安侯魏其時議，貶秩為詹事，遷為大農令。"}],"attestations":[{"id":"th-shiji120-025:a001","paragraph_id":"c-shiji-120-jizheng:p016","start":155,"end":158,"surface":"大農令","person_mention_id":"c-shiji-120-jizheng:m016-0000","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-120-jizheng","source_id":"s-shiji120-jizheng","paragraph_id":"c-shiji-120-jizheng:p016","quote":"鄭莊以任俠自喜，脫張羽於緦聲聞梁楚之閒。孝景時，為太子舍人。每五日洗沐，常置驛馬安諸郊，存諸故人，請謝賓客，夜以繼日，至其明旦，常恐不遍。莊好黃老之言，其慕長者如恐不見。年少官薄，然其游知交皆其大父行，天下有名之士也。武帝立，莊稍遷為魯中尉、濟南太守、江都相，至九卿為右內史。以武安侯魏其時議，貶秩為詹事，遷為大農令。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"依原文區分授任、貶任與用稱；未明日期保持未知，死亡不自動終止官爵。莊為太史保留底本，不校改為大農。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji120-026","person_id":"jws_b08_hob","title":"太史","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-120-jizheng","source_id":"s-shiji120-jizheng","paragraph_id":"c-shiji-120-jizheng:p017","quote":"莊為太史，誡門下：「客至，無貴賤無留門者。」執賓主之禮，以其貴下人。莊廉，又不治其產業，仰奉賜以給諸公。然其餽遺人，不過算器食。每朝，候上之閒，說未嘗不言天下之長者。其推轂士及官屬丞史，誠有味其言之也，常引以為賢於己。未嘗名吏，與官屬言，若恐傷之。聞人之善言，進之上，唯恐後。山東士諸公以此翕然稱鄭莊。"}],"attestations":[{"id":"th-shiji120-026:a001","paragraph_id":"c-shiji-120-jizheng:p017","start":2,"end":4,"surface":"太史","person_mention_id":"c-shiji-120-jizheng:m017-0000","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"依原文區分授任、貶任與用稱；未明日期保持未知，死亡不自動終止官爵。莊為太史保留底本，不校改為大農。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji120-028","person_id":"jws_b08_hob","title":"長史","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-120-jizheng","source_id":"s-shiji120-jizheng","paragraph_id":"c-shiji-120-jizheng:p018","quote":"鄭莊使視決河，自請治行五日。上曰：「吾聞『鄭莊行，千里不齎糧』，請治行者何也？」然鄭莊在朝，常趨和承意，不敢甚引當否。及晚節，漢征匈奴，招四夷，天下費多，財用益匱。莊任人賓客為大農僦人，多逋負。司馬安為淮陽太守，發其事，莊以此陷罪，贖為庶人。頃之，守長史。上以為老，以莊為汝南太守。數歲，以官卒。"}],"attestations":[{"id":"th-shiji120-028:a001","paragraph_id":"c-shiji-120-jizheng:p018","start":125,"end":127,"surface":"長史","person_mention_id":"c-shiji-120-jizheng:m018-0000","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"依原文區分授任、貶任與用稱；未明日期保持未知，死亡不自動終止官爵。莊為太史保留底本，不校改為大農。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji120-029","person_id":"jws_b08_hob","title":"汝南太守","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-120-jizheng","source_id":"s-shiji120-jizheng","paragraph_id":"c-shiji-120-jizheng:p018","quote":"鄭莊使視決河，自請治行五日。上曰：「吾聞『鄭莊行，千里不齎糧』，請治行者何也？」然鄭莊在朝，常趨和承意，不敢甚引當否。及晚節，漢征匈奴，招四夷，天下費多，財用益匱。莊任人賓客為大農僦人，多逋負。司馬安為淮陽太守，發其事，莊以此陷罪，贖為庶人。頃之，守長史。上以為老，以莊為汝南太守。數歲，以官卒。"}],"attestations":[{"id":"th-shiji120-029:a001","paragraph_id":"c-shiji-120-jizheng:p018","start":136,"end":140,"surface":"汝南太守","person_mention_id":"c-shiji-120-jizheng:m018-0000","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-120-jizheng","source_id":"s-shiji120-jizheng","paragraph_id":"c-shiji-120-jizheng:p018","quote":"鄭莊使視決河，自請治行五日。上曰：「吾聞『鄭莊行，千里不齎糧』，請治行者何也？」然鄭莊在朝，常趨和承意，不敢甚引當否。及晚節，漢征匈奴，招四夷，天下費多，財用益匱。莊任人賓客為大農僦人，多逋負。司馬安為淮陽太守，發其事，莊以此陷罪，贖為庶人。頃之，守長史。上以為老，以莊為汝南太守。數歲，以官卒。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"依原文區分授任、貶任與用稱；未明日期保持未知，死亡不自動終止官爵。莊為太史保留底本，不校改為大農。","reviewer":"Codex（AI 代理）"}],"address_assertions":[{"id":"pa-shiji120-002","person_id":"jws_b08_hob","relation":"biographical_origin","place":{"source_name":"陳","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-120-jizheng","source_id":"s-shiji120-jizheng","paragraph_id":"c-shiji-120-jizheng:p015","quote":"鄭當時者，字莊，陳人也。其先鄭君嘗為項籍將；籍死，已而屬漢。高祖令諸故項籍臣名籍，鄭君獨不奉詔。詔盡拜名籍者為大夫，而逐鄭君。鄭君死孝文時。"}],"source_term":"陳人也","interpretation_note":"保留原文人地稱謂；不推出生地或現代轄區。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-120-jizheng:p002","text":"黯為人性倨，少禮，面折，不能容人之過。合己者善待之，不合己者不能忍見，士亦以此不附焉。然好學，游俠，任氣節，內行修絜，好直諫，數犯主之顏色，常慕傅柏、袁盎之為人也。善灌夫、鄭當時及宗正劉棄。亦以數直諫，不得久居位。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-120-jizheng:m002-0000","start":0,"end":1,"surface":"黯","kind":"person","person_id":"g2z_cl6_w4r","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m002-0035","start":35,"end":36,"surface":"士","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-120-jizheng:m002-0065","start":65,"end":66,"surface":"主","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-120-jizheng:m002-0072","start":72,"end":74,"surface":"傅柏","kind":"person","person_id":"n5a_24z_cvp","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m002-0075","start":75,"end":77,"surface":"袁盎","kind":"person","person_id":"oe3_qqv_y6t","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m002-0083","start":83,"end":85,"surface":"灌夫","kind":"person","person_id":"52e_gh9_em4","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m002-0086","start":86,"end":89,"surface":"鄭當時","kind":"person","person_id":"jws_b08_hob","status":"contextual_provisional"},{"id":"c-