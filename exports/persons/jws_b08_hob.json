ind":"person","person_id":"jws_b08_hob","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m016-0139","start":139,"end":142,"surface":"武安侯","kind":"person","person_id":"6rp_jqd_p41","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m016-0142","start":142,"end":144,"surface":"魏其","kind":"person","person_id":"vk5_8ah_2xe","status":"contextual_provisional"}],"chapter_id":"c-shiji-120-jizheng","book_id":"b-shiji-120","work_id":"w-shiji","source_id":"s-shiji120-jizheng"},{"id":"c-shiji-120-jizheng:p017","text":"莊為太史，誡門下：「客至，無貴賤無留門者。」執賓主之禮，以其貴下人。莊廉，又不治其產業，仰奉賜以給諸公。然其餽遺人，不過算器食。每朝，候上之閒，說未嘗不言天下之長者。其推轂士及官屬丞史，誠有味其言之也，常引以為賢於己。未嘗名吏，與官屬言，若恐傷之。聞人之善言，進之上，唯恐後。山東士諸公以此翕然稱鄭莊。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-120-jizheng:m017-0000","start":0,"end":1,"surface":"莊","kind":"person","person_id":"jws_b08_hob","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m017-0034","start":34,"end":35,"surface":"莊","kind":"person","person_id":"jws_b08_hob","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m017-0049","start":49,"end":51,"surface":"諸公","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-120-jizheng:m017-0068","start":68,"end":69,"surface":"上","kind":"person","person_id":"36n_3tt_pt4","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m017-0077","start":77,"end":82,"surface":"天下之長者","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-120-jizheng:m017-0088","start":88,"end":92,"surface":"官屬丞史","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-120-jizheng:m017-0132","start":132,"end":133,"surface":"上","kind":"person","person_id":"36n_3tt_pt4","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m017-0138","start":138,"end":143,"surface":"山東士諸公","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-120-jizheng:m017-0148","start":148,"end":150,"surface":"鄭莊","kind":"person","person_id":"jws_b08_hob","status":"contextual_provisional"}],"chapter_id":"c-shiji-120-jizheng","book_id":"b-shiji-120","work_id":"w-shiji","source_id":"s-shiji120-jizheng"},{"id":"c-shiji-120-jizheng:p018","text":"鄭莊使視決河，自請治行五日。上曰：「吾聞『鄭莊行，千里不齎糧』，請治行者何也？」然鄭莊在朝，常趨和承意，不敢甚引當否。及晚節，漢征匈奴，招四夷，天下費多，財用益匱。莊任人賓客為大農僦人，多逋負。司馬安為淮陽太守，發其事，莊以此陷罪，贖為庶人。頃之，守長史。上以為老，以莊為汝南太守。數歲，以官卒。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-120-jizheng:m018-0000","start":0,"end":2,"surface":"鄭莊","kind":"person","person_id":"jws_b08_hob","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m018-0014","start":14,"end":15,"surface":"上","kind":"person","person_id":"36n_3tt_pt4","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m018-0021","start":21,"end":23,"surface":"鄭莊","kind":"person","person_id":"jws_b08_hob","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m018-0041","start":41,"end":43,"surface":"鄭莊","kind":"person","person_id":"jws_b08_hob","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m018-0082","start":82,"end":83,"surface":"莊","kind":"person","person_id":"jws_b08_hob","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m018-0085","start":85,"end":87,"surface":"賓客","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-120-jizheng:m018-0097","start":97,"end":100,"surface":"司馬安","kind":"person","person_id":"84g_35d_vcn","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m018-0110","start":110,"end":111,"surface":"莊","kind":"person","person_id":"jws_b08_hob","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m018-0128","start":128,"end":129,"surface":"上","kind":"person","person_id":"36n_3tt_pt4","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m018-0134","start":134,"end":135,"surface":"莊","kind":"person","person_id":"jws_b08_hob","status":"contextual_provisional"}],"chapter_id":"c-shiji-120-jizheng","book_id":"b-shiji-120","work_id":"w-shiji","source_id":"s-shiji120-jizheng"},{"id":"c-shiji-120-jizheng:p019","text":"鄭莊、汲黯始列為九卿，廉，內行修絜。此兩人中廢，家貧，賓客益落。及居郡，卒後家無餘貲財。莊兄弟子孫以莊故，至二千石六七人焉。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-120-jizheng:m019-0000","start":0,"end":2,"surface":"鄭莊","kind":"person","person_id":"jws_b08_hob","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m019-0003","start":3,"end":5,"surface":"汲黯","kind":"person","person_id":"g2z_cl6_w4r","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m019-0027","start":27,"end":29,"surface":"賓客","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-120-jizheng:m019-0044","start":44,"end":45,"surface":"莊","kind":"person","person_id":"jws_b08_hob","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m019-0045","start":45,"end":49,"surface":"兄弟子孫","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-120-jizheng:m019-0050","start":50,"end":51,"surface":"莊","kind":"person","person_id":"jws_b08_hob","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m019-0057","start":57,"end":60,"surface":"六七人","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-120-jizheng","book_id":"b-shiji-120","work_id":"w-shiji","source_id":"s-shiji120-jizheng"},{"id":"c-shiji-120-jizheng:p020","text":"太史公曰：夫以汲、鄭之賢，有勢則賓客十倍，無勢則否，況眾人乎！下邽翟公有言，始翟公為廷尉，賓客闐門；及廢，門外可設雀羅。翟公復為廷尉，賓客欲往，翟公乃人署其門曰：「一死一生，乃知交情。一貧一富，乃知交態。一貴一賤，交情乃見。」汲、鄭亦云，悲夫！","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-120-jizheng:m020-0000","start":0,"end":3,"surface":"太史公","kind":"person","person_id":"w77_e81_zts","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m020-0007","start":7,"end":8,"surface":"汲","kind":"person","person_id":"g2z_cl6_w4r","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m020-0009","start":9,"end":10,"surface":"鄭","kind":"person","person_id":"jws_b08_hob","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m020-0016","start":16,"end":18,"surface":"賓客","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-120-jizheng:m020-0033","start":33,"end":35,"surface":"翟公","kind":"person","person_id":"fzo_jum_4s1","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m020-0039","start":39,"end":41,"surface":"翟公","kind":"person","person_id":"fzo_jum_4s1","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m020-0045","start":45,"end":47,"surface":"賓客","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-120-jizheng:m020-0060","start":60,"end":62,"surface":"翟公","kind":"person","person_id":"fzo_jum_4s1","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m020-0067","start":67,"end":69,"surface":"賓客","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-120-jizheng:m020-0072","start":72,"end":74,"surface":"翟公","kind":"person","person_id":"fzo_jum_4s1","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m020-0113","start":113,"end":114,"surface":"汲","kind":"person","person_id":"g2z_cl6_w4r","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m020-0115","start":115,"end":116,"surface":"鄭","kind":"person","person_id":"jws_b08_hob","status":"contextual_provisional"}],"chapter_id":"c-shiji-120-jizheng","book_id":"b-shiji-120","work_id":"w-shiji","source_id":"s-shiji120-jizheng"},{"id":"c-shiji-120-jizheng:p021","text":"河南矯制，自古稱賢。淮南臥理，天子伏焉。積薪興歎，伉直愈堅。鄭莊推士，天下翕然。交道勢利，翟公愴旃。","annotation_status":"in_progress","text_layer":"witness_appended_suoyin_zan","mentions":[{"id":"c-shiji-120-jizheng:m021-0015","start":15,"end":17,"surface":"天子","kind":"person","person_id":"36n_3tt_pt4","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m021-0030","start":30,"end":32,"surface":"鄭莊","kind":"person","person_id":"jws_b08_hob","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m021-0045","start":45,"end":47,"surface":"翟公","kind":"perso