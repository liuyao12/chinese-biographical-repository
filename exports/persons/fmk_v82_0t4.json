者，令譎挑魏大司馬揚州牧曹休。魴答，恐民帥小丑不足仗任，事或漏洩，不能致休，乞遣親人賫箋七條以誘休。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-060-zhoufang:line068:m0002","start":2,"end":4,"surface":"周魴","kind":"person","person_id":"iuc_mqu_3jm","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-zhoufang:line068:m0005","start":5,"end":7,"surface":"子魚","kind":"person","person_id":"iuc_mqu_3jm","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-zhoufang:line068:m0037","start":37,"end":39,"surface":"彭式","kind":"person","person_id":"di6_rx1_2ru","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-zhoufang:line068:m0046","start":46,"end":47,"surface":"魴","kind":"person","person_id":"iuc_mqu_3jm","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-zhoufang:line068:m0059","start":59,"end":60,"surface":"式","kind":"person","person_id":"di6_rx1_2ru","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-zhoufang:line068:m0082","start":82,"end":84,"surface":"彭綺","kind":"person","person_id":"fmk_v82_0t4","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-zhoufang:line068:m0094","start":94,"end":95,"surface":"魴","kind":"person","person_id":"iuc_mqu_3jm","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-zhoufang:line068:m0102","start":102,"end":104,"surface":"胡綜","kind":"person","person_id":"qfk_09j_fhe","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-zhoufang:line068:m0112","start":112,"end":113,"surface":"綺","kind":"person","person_id":"fmk_v82_0t4","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-zhoufang:line068:m0153","start":153,"end":155,"surface":"曹休","kind":"person","person_id":"h7n_w5t_i1c_AA","status":"conte