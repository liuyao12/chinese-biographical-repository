-119-xunli:m011-0004","start":4,"end":7,"surface":"晉文公","kind":"person","person_id":"6r6_00u_xxf","status":"contextual_provisional","paragraph_id":"c-shiji-119-xunli:p011","chapter_id":"c-shiji-119-xunli"},{"id":"c-shiji-119-xunli:m011-0021","start":21,"end":23,"surface":"文公","kind":"person","person_id":"6r6_00u_xxf","status":"contextual_provisional","paragraph_id":"c-shiji-119-xunli:p011","chapter_id":"c-shiji-119-xunli"},{"id":"c-shiji-119-xunli:m011-0099","start":99,"end":101,"surface":"文公","kind":"person","person_id":"6r6_00u_xxf","status":"contextual_provisional","paragraph_id":"c-shiji-119-xunli:p011","chapter_id":"c-shiji-119-xunli"},{"id":"c-shiji-119-xunli:m012-0057","start":57,"end":59,"surface":"晉文","kind":"person","person_id":"6r6_00u_xxf","status":"contextual_provisional","paragraph_id":"c-shiji-119-xunli:p012","chapter_id":"c-shiji-119-xunli"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-119-xunli:p011","text":"李離者，晉文公之理也。過聽殺人，自拘當死。文公曰：「官有貴賤，罰有輕重。下吏有過，非子之罪也。」李離曰：「臣居官爲長，不與吏讓位；受祿爲多，不與下分利。今過聽殺人，傅其罪下吏，非所聞也。」辭不受令。文公曰：「子則自以爲有罪，寡人亦有罪邪？」李離曰：「理有法，失刑則刑，失死則死。公以臣能聽微決疑，故使爲理。今過聽殺人，罪當死。」遂不受令，伏劍而死。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-119-xunli:m011-0000","start":0,"end":2,"surface":"李離","kind":"person","person_id":"r21_u44_q3d","status":"contextual_provisional"},{"id":"c-shiji-119-xunli:m011-0004","start":4,"end":7,"surface":"晉文公","kind":"person","person_id":"6r6_00u_xxf","status":"contextual_provisional"},{"id":"c-shiji-119-xunli:m011-0021","start":21,"end":23,"surface":"文公","kind":"person","person_id":"6r6_00u_xxf","status":"contextual_provisional"},{"id":"c-shiji-119-xunli:m011-0036","start":36,"end":38,"surface":"下吏","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-119-xunli:m011-0048","start":48,"e