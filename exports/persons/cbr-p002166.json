{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p002166","identity_policy":"contextual_provisional","person_ids":["cbr-p002166"],"persons":[{"id":"cbr-p002166","label":"子家（鄭世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"子家","mention_ids":["c-shiji-042-zheng:m025-0013","c-shiji-042-zheng:m025-0031","c-shiji-042-zheng:m025-0113","c-shiji-042-zheng:m027-0042"]}],"evidence":[{"mention_id":"c-shiji-042-zheng:m025-0013","chapter_id":"c-shiji-042-zheng","paragraph_id":"c-shiji-042-zheng:p025","quote":"子家"},{"mention_id":"c-shiji-042-zheng:m025-0031","chapter_id":"c-shiji-042-zheng","paragraph_id":"c-shiji-042-zheng:p025","quote":"子家"},{"mention_id":"c-shiji-042-zheng:m025-0113","chapter_id":"c-shiji-042-zheng","paragraph_id":"c-shiji-042-zheng:p025","quote":"子家"},{"mention_id":"c-shiji-042-zheng:m027-0042","chapter_id":"c-shiji-042-zheng","paragraph_id":"c-shiji-042-zheng:p027","quote":"子家"}]}],"mentions":[{"id":"c-shiji-042-zheng:m025-0013","start":13,"end":15,"surface":"子家","kind":"person","person_id":"cbr-p002166","status":"contextual_provisional","paragraph_id":"c-shiji-042-zheng:p025","chapter_id":"c-shiji-042-zheng"},{"id":"c-shiji-042-zheng:m025-0031","start":31,"end":33,"surface":"子家","kind":"person","person_id":"cbr-p002166","status":"contextual_provisional","paragraph_id":"c-shiji-042-zheng:p025","chapter_id":"c-shiji-042-zheng"},{"id":"c-shiji-042-zheng:m025-0113","start":113,"end":115,"surface":"子家","kind":"person","person_id":"cbr-p002166","status":"contextual_provisional","paragraph_id":"c-shiji-042-zheng:p025","chapter_id":"c-shiji-042-zheng"},{"id":"c-shiji-042-zheng:m027-0042","start":42,"end":44,"surface":"子家","kind":"person","person_id":"cbr-p002166","status":"contextual_provisional","paragraph_id":"c-shiji-042-zheng:p027","chapter_id":"c-shiji-042-zheng"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji042-072","person_id":"cbr-p002166","scope":"same_chapter","chapter_ids":["c-shiji-042-zheng"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["子家"],"evidence":[{"paragraph_id":"c-shiji-042-zheng:p025","quote":"靈公元年春，楚獻黿於靈公。子家、子公將朝靈公，子公之食指動，謂子家曰：「佗日指動，必食異物。」及入，見靈公進黿羹，子公笑曰：「果然！」靈公問其笑故，具告靈公。靈公召之，獨弗予羹。子公怒，染其指，嘗之而出。公怒，欲殺子公。子公與子家謀先。夏，弒靈公。鄭人欲立靈公弟去疾，去疾讓曰：「必以賢，則去疾不肖；必以順，則公子堅長。」堅者，靈公庶弟，去疾之兄也。於是乃立子堅，是爲襄公。"},{"paragraph_id":"c-shiji-042-zheng:p027","quote":"襄公元年，楚怒鄭受宋賂縱華元，伐鄭。鄭背楚，與晉親。五年，楚復伐鄭，晉來救之。六年，子家卒，國人復逐其族，以其弒靈公也。"}],"rationale":"依本篇名字、是為、世系及連續事件暫接異稱；同諡不同國分開，建子勝與聲公勝不合併，如兄弟為譬喻不作親屬。述贊與正文不算獨立來源，省稱、古字與校勘仍待核。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-042-zheng:p025","text":"靈公元年春，楚獻黿於靈公。子家、子公將朝靈公，子公之食指動，謂子家曰：「佗日指動，必食異物。」及入，見靈公進黿羹，子公笑曰：「果然！」靈公問其笑故，具告靈公。靈公召之，獨弗予羹。子公怒，染其指，嘗之而出。公怒，欲殺子公。子公與子家謀先。夏，弒靈公。鄭人欲立靈公弟去疾，去疾讓曰：「必以賢，則去疾不肖；必以順，則公子堅長。」堅者，靈公庶弟，去疾之兄也。於是乃立子堅，是爲襄公。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-042-zheng:m025-0000","start":0,"end":2,"surface":"靈公","kind":"person","person_id":"cbr-p002168","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m025-0010","start":10,"end":12,"surface":"靈公","kind":"person","person_id":"cbr-p002168","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m025-0013","start":13,"end":15,"surface":"子家","kind":"person","person_id":"cbr-p002166","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m025-0016","start":16,"end":18,"surface":"子公","kind":"person","person_id":"cbr-p002167","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m025-0020","start":20,"end":22,"surface":"靈公","kind":"person","person_id":"cbr-p002168","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m025-0023","start":23,"end":25,"surface":"子公","kind":"person","person_id":"cbr-p002167","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m025-0031","start":31,"end":33,"surface":"子家","kind":"person","person_id"