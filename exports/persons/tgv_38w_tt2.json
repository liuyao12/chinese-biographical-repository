e,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-057-luotong:line061:m0102","surface":"適母","start":102,"end":104,"kind":"person","person_id":"tgv_38w_tt2","status":"contextual_provisional","interpretation_note":"按本段具名及前後親稱、官職定位。","paragraph_id":"c-sanguozhi-057-luotong:line061","chapter_id":"c-sanguozhi-057-luotong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-057-luotong:line061","text":"駱統字公緒，會稽烏傷人也。父俊，官至陳相。為袁術所害。統母改適，為華歆小妻，統時八歲，遂與親客歸會稽。其母送之，拜辭上車，面而不顧，其母泣涕於後。御者曰：「夫人猶在也。」統曰：「不欲增母思，故不顧耳。」事適母甚謹。時饑荒，鄉里及遠方客多有困乏，統為之飲食衰少。其姊仁愛有行，寡歸無子，見統甚哀之，數問其故。統曰：「士大夫糟糠不足，我何心獨飽!」姊曰：「誠如是，何不告我，而自苦若此？」乃自以私粟與統，又以告母，母亦賢之，遂使分施，由是顯名。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-057-luotong:line061:m0001","start":1,"end":2,"surface":"統","kind":"person","person_id":"7tc_utz_m7l","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-luotong:line061:m0003","start":3,"end":5,"surface":"公緒","kind":"person","person_id":"7tc_utz_m7l","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-luotong:line061:m0014","start":14,"end":15,"surface":"俊","kind":"person","person_id":"bvu_zfh_14y","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-luotong:line061:m0022","start":22,"end":24,"surface":"袁術","kind":"person","person_id":"865_b69_cb0","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-luotong:line061:m0027","start":27,"end":28,"surface":"統","kind":"person","person_id":"7tc_utz_m7l","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-luotong:line061:m0028","surface":"母","start":28,"end":29,"kind":"pe