uote":"之橫"},{"mention_id":"c-liangshu-028-peizhiheng-complete:p002:m0023","paragraph_id":"c-liangshu-028-peizhiheng-complete:p002","chapter_id":"c-liangshu-028-peizhiheng-complete","quote":"之橫"},{"mention_id":"c-liangshu-028-peizhiheng-complete:p002:m0040","paragraph_id":"c-liangshu-028-peizhiheng-complete:p002","chapter_id":"c-liangshu-028-peizhiheng-complete","quote":"之橫"},{"mention_id":"c-liangshu-028-peizhiheng-complete:p002:m0156","paragraph_id":"c-liangshu-028-peizhiheng-complete:p002","chapter_id":"c-liangshu-028-peizhiheng-complete","quote":"之橫"},{"mention_id":"c-liangshu-028-peizhiheng-complete:p003:m0029","paragraph_id":"c-liangshu-028-peizhiheng-complete:p003","chapter_id":"c-liangshu-028-peizhiheng-complete","quote":"之橫"},{"mention_id":"c-liangshu-028-peizhiheng-complete:p003:m0062","paragraph_id":"c-liangshu-028-peizhiheng-complete:p003","chapter_id":"c-liangshu-028-peizhiheng-complete","quote":"之橫"},{"mention_id":"c-liangshu-006-peizhiheng-dongguan:p001:m0032","paragraph_id":"c-liangshu-006-peizhiheng-dongguan:p001","chapter_id":"c-liangshu-006-peizhiheng-dongguan","quote":"裴之橫"},{"mention_id":"c-liangshu-006-peizhiheng-dongguan:p001:m0041","paragraph_id":"c-liangshu-006-peizhiheng-dongguan:p001","chapter_id":"c-liangshu-006-peizhiheng-dongguan","quote":"之橫"},{"mention_id":"c-beiqishu-010-gaohuan-peizhiheng:p002:m0023","paragraph_id":"c-beiqishu-010-gaohuan-peizhiheng:p002","chapter_id":"c-beiqishu-010-gaohuan-peizhiheng","quote":"裴之橫"}],"review":"ai_provisional","identity_note":"裴之橫（字如岳，裴之高弟），見本組原文及身份互校。","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"4kt_0ar_aqo_AA","source_assertion_id":null,"parent_connection":{"type":"shared_father_through_siblings","sibling_assertion_ids":["a-liang028-zhiheng-brother"],"sibling_father_assertion_id":"a-liang028-zhigao-father"},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-028","chapter_id":"c-liangshu-028-peizhiheng-complete","source_id":"s-liangshu-028-peizhiheng-complete-ws1511902","paragraph_id":"c-liangshu-028-peizhiheng-complete:p001","quote":"之橫字如岳，之高第十三弟也。少好賓遊，重氣俠，不事產業。之高以其縱誕，乃爲狹被蔬食以激厲之。之橫歎曰：「大丈夫富貴，必作百幅被。」遂與僮屬數百人，於芍陂大營田墅，遂致殷積。太宗在東宮，聞而要之，以爲河東王常侍、直殿主帥，遷直閤將軍。侯景亂，出爲貞威將軍，隸鄱陽王範討景。景濟江，仍與範長子嗣入援。連營度淮，據東城。京都陷，退還合肥，與範溯流赴湓城。景遣任約上逼晉熙，範令之橫下援，未及至，範薨，之橫乃還。","subject_person_mention_id":"c-liangshu-028-peizhiheng-complete:p001:m0000","object_person_mention_id":"c-liangshu-028-peizhiheng-complete:p001:m0006","source_term":"之高第十三弟","source_assertion_id":"a-liang028-zhiheng-brother"},{"work_id":"w-liangshu","book_id":"b-liangshu-028","chapter_id":"c-liangshu-028-peizhigao-complete","source_id":"s-liangshu-028-peizhigao-complete-ws1511902","paragraph_id":"c-liangshu-028-peizhigao-complete:p001","quote":"之高字如山，邃兄中散大夫髦之子也。起家州從事、新都令、奉朝請，遷參軍。頗讀書，少負意氣，常隨叔父邃征討，所在立功，甚爲邃所器重，戎政咸以委焉。","subject_person_mention_id":"c-liangshu-028-peizhigao-complete:p001:m0000","object_person_mention_id":"c-liangshu-028-peizhigao-complete:p001:m0012","source_term":"中散大夫髦之子","source_assertion_id":"a-liang028-zhigao-father"}],"status":"contextual_provisional","human_reviewed":false,"interpretation_note":"循兄弟明稱及之高父髦二證擬接。"}},{"id":"4kt_0ar_aqo_AADA","label":"裴鳳寶（裴之橫子）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"鳳寶","mention_ids":["c-liangshu-028-peizhiheng-complete:p003:m0105"]}],"evidence":[{"mention_id":"c-liangshu-028-peizhiheng-complete:p003:m0105","paragraph_id":"c-liangshu-028-peizhiheng-complete:p003","chapter_id":"c-liangshu-028-peizhiheng-complete","quote":"鳳寶"}],"review":"ai_provisional","identity_note":"裴鳳寶（裴之橫子），見本組原文及身份互校。","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"4kt_0ar_aqo_AAD","source_assertion_id":"a-liang028-fengbao-father","evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-028","chapter_id":"c-liangshu-028-peizhiheng-complete","source_id":"s-liangshu-028-peizhiheng-complete-ws1511902","paragraph_id":"c-liangshu-028-peizhiheng-complete:p003","quote":"後江陵陷，齊遣上黨王高渙挾貞陽侯攻東關，晉安王方智承制，以之橫爲使持節、鎮北將軍、徐州刺史，都督衆軍，給鼓吹一部，出守蘄城。之橫營壘未周，而齊軍大至，兵盡矢窮，遂於陣沒，時年四十一。贈侍中、司空公，諡曰忠壯。子鳳寶嗣。","subject_person_mention_id":"c-liangshu-028-peizhiheng-complete:p003:m0105","object_person_mention_id":"c-liangshu-028-peizhiheng-complete:p003:m0029","source_term":"子鳳寶嗣"}],"status":"contextual_provisional","human_reviewed":false,"interpretation_note":"之橫陣沒，身後子鳳寶嗣。"}}],"source_mention_summary":[{"source_id":"s-liangshu-028-peizhiheng-complete-ws1511902","work_id":"w-liangshu","book_id":"b-liangshu-028","chapter_id":"c-liangshu-028-peizhiheng-complete","raw_mention_count":1,"mention_ids":["c-liangshu-028-peizhiheng-complete:p003:m0105"],"paragraph_ids":["c-liangshu-028-peizhiheng-complete:p003"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-liangshu-028-peizhiheng-complete:p003:m0105","mention_ids":["c-liangshu-028-peizhiheng-complete:p003:m0105"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-liangshu-028-peizhiheng-complete-ws1511902"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-liangshu-028-peizhiheng-complete:received_sentence3-104","kind":"received_sentence","person_id":"4kt_0ar_aqo_AADA","source_quote":"子鳳寶嗣。","reading":"子鳳寶承嗣；南史亦作子鳳寶嗣。","note":"子鳳寶承嗣；南史亦作子鳳寶嗣。","paragraph_id":"c-liangshu-028-peizhiheng-complete:p003","start_codepoint":104,"end_codepoint":109,"human_reviewed":false,"chapter_id":"c-liangshu-028-peizhiheng-complete","sourc