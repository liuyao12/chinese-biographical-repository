-063-wufan:line025-pei01-01","text":"《會稽典錄》曰：滕字周林，祖父河內太守朗，字少英，列在八俊。滕性剛直，行不苟合，雖遭困偪，終不迴撓。初亦迕策，幾殆，賴太妃救得免，語見《妃嬪傳》。歷歷山、潘陽、山陰三縣令，鄱陽太守。","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-063-wufan:line025-pei01-01:m0008","start":8,"end":9,"surface":"滕","kind":"person","person_id":"v27_nrq_ppt","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-063-wufan:line025-pei01-01:m0010","start":10,"end":12,"surface":"周林","kind":"person","person_id":"v27_nrq_ppt","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-063-wufan:line025-pei01-01:m0019","start":19,"end":20,"surface":"朗","kind":"person","person_id":"199_2as_snw","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-063-wufan:line025-pei01-01:m0022","start":22,"end":24,"surface":"少英","kind":"person","person_id":"199_2as_snw","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-063-wufan:line025-pei01-01:m0030","start":30,"end":31,"surface":"滕","kind":"person","person_id":"v27_nrq_ppt","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-063-wufan:line025-pei01-01:m0053","start":53,"end":54,"surface":"策","kind":"person","person_id":"e9c_070_567","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"}],"annotation_status":"reviewed","source_position":{"first_line":25,"last_line":25,"revision_id":2188657,"raw_start":1252,"raw_end":1373,"character_positions":[1252,1253,1254,1255,1256,1257,1258,1259,1260,1261,1262,1263,1264,1265,1266,1267,1268,1269,1270,1271,1272,1273,1274,1275,1276,1277,1278,1279,1280,1281,1282,1283,1284,1285,1286,1287,1288,1289,1290,1291,1292,1293,1294,1295,1296,1297,1298,1299,1300,1301,1302,1303,1304,1305,1306,1307,1308,1309,1310,1311,1312,1313,1314,1315,1316,1317,1318,1319,1330,1331,1332,1335,1336,1337,1342,1343,1349,1354,1355,1361,1362,1363,1364,1365,1366,1367,1368,1369,1370