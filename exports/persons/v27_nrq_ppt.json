ons":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-050-wu:line016-pei01-01","text":"《會稽典錄》曰：策功曹魏騰，以迕意見譴，將殺之，士大夫憂恐，計無所出。夫人乃倚大井而謂策曰：「汝新造江南，其事未集，方當優賢禮士，舍過錄功。魏功曹在公盡規，汝今日殺之，則明日人皆叛汝。吾不忍見禍之及，當先投此井中耳。」策大驚，遽釋騰。夫人智略權譎，類皆如此。","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-050-wu:line016-pei01-01:m0008","start":8,"end":9,"surface":"策","kind":"person","person_id":"e9c_070_567","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-wu:line016-pei01-01:m0012","start":12,"end":13,"surface":"騰","kind":"person","person_id":"v27_nrq_ppt","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-wu:line016-pei01-01:m0035","start":35,"end":37,"surface":"夫人","kind":"person","person_id":"lm8_q5h_5uy","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-wu:line016-pei01-01:m0043","start":43,"end":44,"surface":"策","kind":"person","person_id":"e9c_070_567","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-wu:line016-pei01-01:m0070","start":70,"end":73,"surface":"魏功曹","kind":"person","person_id":"v27_nrq_ppt","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-wu:line016-pei01-01:m0109","start":109,"end":110,"surface":"策","kind":"person","person_id":"e9c_070_567","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-wu:line016-pei01-01:m0115","start":115,"end":116,"surface":"騰","kind":"person","person_id":"v27_nrq_ppt","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-wu:line016-pei01-01:m0117","start":117,"end":119,"surface":"夫人","kind":"person","person_id":"lm8_q5h_5uy","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"}],"annotation_status":"reviewed","source_position":{"first_line":16,"last_line":16,"revision_id":2085144,"raw_start":691,"raw_end":820,"character_positions":[691,692,693,694,695,696,697,698,699,700,701,702,703,704,705,706,707,708,709,710,711,712,713,714,715,716,717,718,719,720,721,722,723,724,725,726,727,728,729,730,731,732,733,734,735,736,737,738,739,740,741,742,743,744,745,746,747,748,749,750,751,752,753,754,755,756,757,758,759,760,761,762,763,764,765,766,767,768,769,770,771,772,773,774,775,776,777,778,779,780,781,782,783,784,785,786,787,788,789,790,791,792,793,794,795,796,797,798,799,800,801,802,803,804,805,806,807,808,809,810,811,812,813,814,815,816,817,818,819]},"attribution":{"annotator":"裴松之","attribution_kind":"quoted_work","source_label":"會稽典錄","attribution_marker":"《會稽典錄》曰：","quoted_work":"會稽典錄"},"attachment":{"received_paragraph_id":"c-sanguozhi-050-wu:line016","received_codepoint":19,"note_ordinal":1,"source_ordinal":1},"chapter_id":"c-sanguozhi-050-wu","book_id":"b-sanguozhi-050","work_id":"w-sanguozhi","source_id":"s-sanguozhi-050-wu"},{"id":"c-sanguozhi-063-wufan:line025","text":"範爲人剛直，頗好自稱，然與親故交接有終始。素與魏滕同邑相善。滕嘗有罪，權責怒甚嚴，敢有諫者死，範謂滕曰：「與汝偕死。」滕曰：「死而無益，何用死爲？」範曰：「安能慮此坐觀汝邪？」乃髡頭自縛詣門下，使鈴下以聞。鈴下不敢，曰：「必死，不敢白。」範曰：「汝有子邪？」曰：「有。」曰：「使汝爲吳範死，子以屬我。」鈴下曰：「諾。」乃排閤入。言未卒，權大怒，欲便投以戟。逡巡走出，範因突入，叩頭流血，言與涕並。良久，權意釋，乃免滕。滕見範謝曰：「父母能生長我，不能免我於死。丈夫相知，如汝足矣，何用多爲！」","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-063-wufan:line025:m0000","start":0,"end":1,"surface":"範","kind":"person","person_id":"ntv_ei7_aqh","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-063-wufan:line025:m0023","start":23,"end":25,"surface":"魏滕","kind":"person","person_id":"v27_nrq_ppt","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-063-wufan:line025:m0030","start":30,"end":31,"surface":"滕","kind":"person","person_id":"v27_nrq_ppt","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-063-wufan:line025:m0035","st