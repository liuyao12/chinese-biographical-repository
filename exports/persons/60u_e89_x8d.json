","chapter_id":"c-shiji-081-lianlin"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji081-036","person_id":"60u_e89_x8d","scope":"same_chapter","chapter_ids":["c-shiji-081-lianlin"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["王翦"],"evidence":[{"paragraph_id":"c-shiji-081-lianlin:p026","quote":"趙王遷七年，秦使王翦攻趙，趙使李牧、司馬尚禦之。秦多與趙王寵臣郭開金，爲反間，言李牧、司馬尚欲反。趙王乃使趙蔥及齊將顏聚代李牧。李牧不受命，趙使人微捕得李牧，斬之。廢司馬尚。後三月，王翦因急撃趙，大破殺趙蔥，虜趙王遷及其將顏聚，遂滅趙。"}],"rationale":"依本篇明示姓名、國別君序與代將敘事暫接；李牧牧在明示北邊主題內同指，趙王遷王稱限定末次代將。北邊早年趙王、他人及單于未名分存，不強接悼襄；太史公讓頗承接廉藺敘事，其他引語指代待逐處覆核。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-081-lianlin:p026","text":"趙王遷七年，秦使王翦攻趙，趙使李牧、司馬尚禦之。秦多與趙王寵臣郭開金，爲反間，言李牧、司馬尚欲反。趙王乃使趙蔥及齊將顏聚代李牧。李牧不受命，趙使人微捕得李牧，斬之。廢司馬尚。後三月，王翦因急撃趙，大破殺趙蔥，虜趙王遷及其將顏聚，遂滅趙。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-081-lianlin:m026-0000","start":0,"end":3,"surface":"趙王遷","kind":"person","person_id":"33k_p1u_8v9","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m026-0008","start":8,"end":10,"surface":"王翦","kind":"person","person_id":"60u_e89_x8d","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m026-0015","start":15,"end":17,"surface":"李牧","kind":"person","person_id":"qbg_2pe_t58","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m026-0018","start":18,"end":21,"surface":"司馬尚","kind":"person","person_id":"x3j_j8y_j74","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m026-0027","start":27,"end":29,"surface":"趙王","kind":"person","person_id":"33k_p1u_8v9","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m026-0031","start":31,"end":33,"surface":"郭開","kind":"person","person_id":"a2x_dkn_fj9","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m026-0040","start":40,"end":42,"surface":"李牧","kind":"person","person_id":"qbg_2pe_t5