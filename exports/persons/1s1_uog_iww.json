ved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-034-duyu:p026:m0228","start":228,"end":230,"surface":"檀弓","kind":"person","person_id":"1s1_uog_iww","status":"source_explicit","paragraph_id":"c-jinshu-034-duyu:p026","chapter_id":"c-jinshu-034-duyu"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-034-duyu:p026","text":"史臣曰：泰始之際，人祇呈貺，羊公起平吳之策，其見天地之心焉。昔齊有黔夫，燕人祭北門之鬼；趙有李牧，秦王罷東並之勢。桑枝不競，瓜潤空慚。垂大信于南服，傾吳人於漢渚，江衢如砥，繈袂同歸。而在乎成功弗居，幅巾窮巷，落落焉其有風飆者也。杜預不有生知，用之則習，振長策而攻取，兼儒風而轉戰。孔門稱四，則仰止其三；《春秋》有五，而獨擅其一，不其優歟！夫三年之喪，云無貴賤。輕纖奪於在位，可以興嗟；既葬釋于儲君，何其斯酷。徇以苟合，不求其正，以當代之元良，為諸侯之庶子，檀弓習於變禮者也，杜預其有焉。","text_layer":"received_chapter","source_position":{"raw_start":11484,"raw_end":11733,"raw_character_offsets":[11486,11487,11488,11489,11490,11491,11492,11493,11494,11495,11496,11497,11498,11499,11500,11501,11502,11503,11504,11505,11506,11507,11508,11509,11510,11511,11512,11513,11514,11515,11516,11517,11518,11519,11520,11521,11522,11523,11524,11525,11526,11527,11528,11529,11530,11531,11532,11533,11534,11535,11536,11537,11538,11539,11540,11541,11542,11543,11544,11545,11546,11547,11548,11549,11550,11551,11552,11553,11554,11555,11556,11557,11558,11559,11560,11561,11562,11563,11564,11565,11566,11567,11568,11569,11570,11571,11572,11573,11574,11575,11576,11577,11578,11579,11580,11581,11582,11583,11584,11585,11586,11587,11588,11589,11590,11591,11592,11593,11594,11595,11596,11597,11598,11599,11600,11601,11602,11603,11604,11605,11606,11607,11608,11609,11610,11611,11612,11613,11614,11615,11616,11617,11618,11619,11620,11621,11622,11623,11624,11625,11626,11627,11628,11629,11630,11631,11632,11633,11634,11635,11636,11637,11640,11641,11644,11645,11646,11647,11648,11649,11650,11651,11652,11653,11654,11655,11656,11657,11658,11659,11660,11661,11662,1166