ji-067-disciples"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji067-043","person_id":"cbr-p003903","scope":"same_chapter","chapter_ids":["c-shiji-067-disciples"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["公孫龍","子石"],"evidence":[{"paragraph_id":"c-shiji-067-disciples:p040","quote":"田常欲作亂於齊，憚髙國鮑晏，故移其兵欲以伐魯。孔子聞之，謂門弟子曰：「夫魯，墳墓所處，父母之國，國危如此，二三子何爲莫出？」子路請出，孔子止之。子張、子石請行，孔子弗許。子貢請行，孔子許之。"},{"paragraph_id":"c-shiji-067-disciples:p108","quote":"公孫龍字子石。少孔子五十三歳。"},{"paragraph_id":"c-shiji-067-disciples:p109","quote":"自子石已右三十五人，顯有年名及受業見於書傳。其四十有二人，無年及不見書傳者紀於左："}],"rationale":"依篇內明示姓名字稱及局部問答暫接。吳越王稱按夫差句踐連續敘事；第71段夫子指原憲，第90段指代未定。傳易短何分田子莊何與楊何，傳授不當父子；引古人物保留傳說性。冉季字子產不接鄭子產，原憲子思不接孔子後世子思；名錄各條同字子徒、子聲、子上、皙等均保留不同候選，鄭國是此條人名。魯昭公夫人孟子不接戰國孟子。全152段明示姓名首輪已存，未名者、代詞、版本及跨篇身份待覆核。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-067-disciples:p040","text":"田常欲作亂於齊，憚髙國鮑晏，故移其兵欲以伐魯。孔子聞之，謂門弟子曰：「夫魯，墳墓所處，父母之國，國危如此，二三子何爲莫出？」子路請出，孔子止之。子張、子石請行，孔子弗許。子貢請行，孔子許之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-067-disciples:m040-0000","start":0,"end":2,"surface":"田常","kind":"person","person_id":"cbr-p003902","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m040-0009","start":9,"end":13,"surface":"髙國鮑晏","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、氏族、未名者或未定指代；不補姓名、成員或官職持有人。"},{"id":"c-shiji-067-disciples:m040-0023","start":23,"end":25,"surface":"孔子","kind":"person","person_id":"cbr-p003861","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m040-0029","start":29,"end":32,"surface":"門弟子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、氏族、未名者或未定指代；不補姓名、成員或官職持有人。"},{"id":"c-shiji-067-disciples:m040-0043","start":43,"end":45,"surface":"父母","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、氏族、未名者或未定指代；不補姓名、成員或官職持有人。"},{"id":"c-shiji-06