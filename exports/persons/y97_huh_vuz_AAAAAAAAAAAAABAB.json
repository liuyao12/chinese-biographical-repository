AAAAAAABAA","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p086:m0019","start":19,"end":21,"surface":"悼公","kind":"person","person_id":"y97_huh_vuz_AAAAAAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p086:m0024","start":24,"end":26,"surface":"簡公","kind":"person","person_id":"y97_huh_vuz_AAAAAAAAAAAAABAB","status":"contextual_provisional"}],"chapter_id":"c-shiji-006-shihuang","book_id":"b-shiji-006","work_id":"w-shiji","source_id":"s-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:p087","text":"簡公從晉來。享國十五年。葬僖公西。生惠公。其七年。百姓初帶劍。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:p087:m0000","start":0,"end":2,"surface":"簡公","kind":"person","person_id":"y97_huh_vuz_AAAAAAAAAAAAABAB","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p087:m0018","start":18,"end":20,"surface":"惠公","kind":"person","person_id":"y97_huh_vuz_AAAAAAAAAAAAABABA","status":"contextual_provisional"}],"chapter_id":"c-shiji-006-shihuang","book_id":"b-shiji-006","work_id":"w-shiji","source_id":"s-shiji-006-shihuang"}],"sources":[{"chapter_id":"c-shiji-005-qin","work_id":"w-shiji","book_id":"b-shiji-005","source_id":"s-shiji-005-qin","source":{"title":"史記／卷005","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷005","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷005&oldid=8744286","revision_id":8744286,"accessed_on":"2026-10-09","extent":"77段數位正文；排除註釋版導覽與註號，見證行內校勘符號暫原樣保留。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫 CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{"铚":"銍","绖":"絰","龁":"齕"},"note":"第9段編者重複標記另存，其餘行內校勘符號仍待逐處分離；不稱已核讀底本。","editorial_readings":[{"paragraph_id":"c-shiji-005-qin:p009","witness_form":"（世父）世父","body_reading":"世父","note":"數位見證重複的括號標記另存；不作第二個正文人物提及。"},{"paragraph_id":"c-shiji-005-qin:p022","witness_form":"铚","body_reading":"銍","note":"數位見證混入簡體字，轉繁體並保留字形轉換記錄；未核讀影像。"},{"