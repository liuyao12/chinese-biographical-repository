{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000838","identity_policy":"contextual_provisional","person_ids":["cbr-p000838"],"persons":[{"id":"cbr-p000838","label":"彊（孝惠後宮子稱）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"子彊","mention_ids":["c-shiji-009-lvhou:m009-0013"]}],"evidence":[{"mention_id":"c-shiji-009-lvhou:m009-0013","chapter_id":"c-shiji-009-lvhou","paragraph_id":"c-shiji-009-lvhou:p009","quote":"子彊"}]}],"mentions":[{"id":"c-shiji-009-lvhou:m009-0013","start":13,"end":15,"surface":"子彊","kind":"person","person_id":"cbr-p000838","status":"contextual_provisional","paragraph_id":"c-shiji-009-lvhou:p009","chapter_id":"c-shiji-009-lvhou"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-009-lvhou:p009","text":"太后欲王呂氏，先立孝惠後宮子彊為淮陽王，子不疑為常山王，子山為襄城侯，子朝為軹侯，子武為壺關侯。太后風大臣，大臣請立酈侯呂台為呂王，太后許之。建成康侯釋之卒，嗣子有罪，廢，立其弟呂祿為胡陵侯，續康侯後。二年，常山王薨，以其弟襄城侯山為常山王，更名義。十一月，呂王台薨，謚為肅王，太子嘉代立為王。三年，無事。四年，封呂媭為臨光侯，呂他為俞侯，呂更始為贅其侯，呂忿為呂城侯，及諸侯丞相五人。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-009-lvhou:m009-0000","start":0,"end":2,"surface":"太后","kind":"person","person_id":"cbr-p000717","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m009-0009","start":9,"end":11,"surface":"孝惠","kind":"person","person_id":"cbr-p000713","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m009-0013","start":13,"end":15,"surface":"子彊","kind":"person","person_id":"cbr-p000838","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m009-0021","start":21,"end":23,"surface":"不疑","kind":"person","person_id":"cbr-p000839","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m009-0024","start":24,"end":27,"surface":"常山王","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或稱號仍待逐處覆核，不補熟知名字。"},{"id":"c-shiji