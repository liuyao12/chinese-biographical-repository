4-simachong:p001:m0094","surface":"庾懌","start":94,"end":96,"person_id":"4qr_wrk_3vd_C","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-064-simachong:p001:m0102","surface":"顧和","start":102,"end":104,"person_id":"udw_6ta_ofn","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-064-simachong","book_id":"b-jinshu-064","work_id":"w-jinshu","source_id":"s-jinshu-064-simachong-ws2622004"},{"id":"c-jinshu-093-chupou:line055","text":"永和初，復徵裒，將以為揚州、錄尚書事。吏部尚書劉遐說裒曰：「會稽王令德，國之周公也，足下宜以大政付之。」裒長史王胡之亦勸焉，於是固辭歸籓，朝野咸嘆服之。進號征北大將軍、開府儀同三司，固辭開府。裒又以政道在於得才，宜委賢任能，升敬舊齒，乃薦前光祿大夫顧和、侍中殷浩。疏奏，即以和為尚書令，浩為揚州刺史。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-093-chupou:line055:m0006","start":6,"end":7,"surface":"裒","kind":"person","person_id":"xke_dj3_6ba_AA","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line055:m0023","start":23,"end":25,"surface":"劉遐","kind":"person","person_id":"q1u_ata_ox5","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line055:m0026","start":26,"end":27,"surface":"裒","kind":"person","person_id":"xke_dj3_6ba_AA","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line055:m0030","start":30,"end":33,"surface":"會稽王","kind":"person","person_id":"dkn_ge4_286_AAAAAAAF","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line055:m0038","start":38,"end":40,"surface":"周公","kind":"person","person_id":"y4i_pjk_4gn_AD","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line055:m0052","start":52,"end":53,"surface":"裒","kind":"person","person_id":"xke_dj3_6ba_AA","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line055:m0055","start":55,"end":58,"surface":"王胡之","kind":"person","person_id":"7r6_k52_qji_ABDAB","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line055:m0096","start":96,"end":97,"surface":"裒","kind":"person","person_id":"xke_dj3_6ba_AA","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line055:m0124","start":124,"end":126,"surface":"顧和","kind":"person","person_id":"udw_6ta_ofn","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line055:m0129","start":129,"end":131,"surface":"殷浩","kind":"person","person_id":"djo_u3b_i9w_A","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line055:m0137","start":137,"end":138,"surface":"和","kind":"person","person_id":"udw_6ta_ofn","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line055:m0143","start":143,"end":144,"surface":"浩","kind":"person","person_id":"djo_u3b_i9w_A","status":"contextual_provisional"}],"source_position":{"first_line":55,"last_line":55,"revision_id":1548000,"editorial_excerpt_boundary":false},"chapter_id":"c-jinshu-093-chupou","book_id":"b-jinshu-093","work_id":"w-jinshu","source_id":"s-jinshu-093-chupou"}],"sources":[{"chapter_id":"c-jinshu-064-simachong","work_id":"w-jinshu","book_id":"b-jinshu-064","source_id":"s-jinshu-064-simachong-ws2622004","source":{"title":"晉書卷六十四·司馬沖","provider":"Wikisource","permalink":"https://zh.wikisource.org/w/index.php?oldid=2622004","url":"https://zh.wikisource.org/w/index.php?oldid=2622004","revision_id":2622004,"edition":"維基文庫固定修訂","accessed_on":"2026-11-22","review_status":"text_checked","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫授權。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","extent":"晉書卷六十四·司馬沖","text_scope":"complete_biography_unit","raw_path":"source-evidence/jin064-roll/ws2622004.wikitext","raw_file_sha256":"b4c389968a1af2d99c2a6ad4a8afa3e6a4706f845194c0ce283f41927afae31f","collation_witnesses":["source-evidence/jin064-roll/volume-reading.json"]}},{"chapter_id":"c-jinshu-093-chupou","work_id":"w-jinshu","book_id":"b-jinshu-093","source_id":"s-jinshu-093-chupou","source":{"title":"《晉書》卷93（褚裒傳）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?oldid=1548000","permalink":"https://zh.wikisource.org/w/index.php?oldid=1548000","revision_id":1548000,"accessed_on":"2026-10-19","extent":"褚裒完整六原段；非全卷。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，底本影像未核","response_sha256":"6d02e6526fbe0ac37a60ed32fcf594cabcc23c07073038695f8605724923a893","wikitext_sha256":"8fc7f8b8a8a5a33a18c016006082a49f92e418f8fba965e1068b3e4e2016ff7e","normalization":{"character_conversion":{},"extraction_note":"展開年號模板、移除段首縮排；數位校勘注另存，未改原字。","excerpts":[{"proposed_paragraph_id":"c-jinshu-093-chupou:line049","source_lines":[49,49],"raw_quote":"　　褚裒，字季野，康獻皇后父也。祖䂮，有局量，以幹用稱。嘗為縣吏，事有不合，令欲鞭之，䂮曰：「物各有所施，榱椽之材不合以為籓落也，願明府垂察。」乃舍之。家貧，辭吏。年垂五十，鎮南將軍羊祜與䂮有舊，言于武帝，始被升用，官至安東將軍。父洽，武昌太守。","raw_quote_sha256":"50fd468e17ed43a89f2f8aaf107337998cef176ed52308dcc3c923a451f0dd02","selected_text_sha256":"40354c55703e1dd9eb707d3d24a832cadafe1a343522ab3310e3a1f860e8effc","begin_anchor":"褚裒，字季野，康獻皇后父也。祖䂮，有","end_anchor":"升用，官至安東將軍。父洽，武昌太守。"},{"proposed_paragraph_id":"c-jinshu-093-chupou:line051","source_lines":[51,51],"raw_quote":"　　裒少有簡貴之風，與京兆杜乂俱有盛名，冠于中興。譙國桓彝見而目之曰：「季野有皮裏春秋。」言其外無臧否，而內有所褒貶也。謝安亦雅重之，恆云：「裒雖不言，而四時之氣亦備矣。」初辟西陽王掾、吳王文學。蘇峻之構逆也，車騎將軍郗鑒以裒為參軍。峻平，以功封都鄉亭侯，稍遷司徒從事中郎，除給事黃門侍郎。康帝為琅邪王時，將納妃，妙選素望，詔娉裒女為妃，於是出為豫章太守。及康帝即位，徵拜侍中，遷尚書。以-{后}-父，苦求外出，除建威將軍、江州刺史，鎮半洲<ref>半洲　各本誤作「平州」，今從殿本。與庾懌傳合。</ref>。在官清約，雖居方伯，恆使私童樵採。頃之，徵為衛將軍，領中書令。裒以中書銓管詔命，不宜以姻戚居之，固讓，詔以為左將卦、兗州刺史、都督兗州徐州之琅邪諸軍事、假節，鎮金城，又領琅邪內史。","raw_quote_sha256":"a4152fdb88efe8c96087948b9e0d56fdda1987038474e5dcd5d9c59a37829fdc","selected_text_sha256":"a8a234ec5c0ff606cd420d920f112e89ac403a238582290e9eb30bcf5ada50c9","begin_anchor":"裒少有簡貴之風，與京兆杜乂俱有盛名，","end_anchor":"諸軍事、假節，鎮金城，又領琅邪內史。","removed_digital_editorial_notes":[{"text":"半洲　各本誤作「平州」，今從殿本。與庾懌傳合。","text_layer":"modern_digital_apparatus","independently_verified":false}]},{"proposed_paragraph_id":"c-jinshu-093-chupou:line053","source_lines":[53,53],"raw_quote":"　　初，裒總角詣庾亮，亮使郭璞筮之。卦成，璞駭然，亮曰：「有不祥乎？」璞曰：「此非人臣卦，不知此年少何以乃表斯祥？二十年外，吾言方驗。」及此二十九年而康獻皇太后臨朝，有司以裒皇太后父，議加不臣之禮，拜侍中、衛將軍、錄尚書事，持節、都督、刺史如故。裒以近戚，懼獲譏嫌，上疏固請居籓，曰：「臣以虛鄙，才不周用，過蒙國恩，累忝非據。無勞受寵，負愧實深，豈可復加殊特之命，顯號重疊！臣有何勳可以克堪？何顏可以冒進？委身聖世，豈復遺力，實懼顛墜，所誤者大。今王略未振，萬機至殷，陛下宜委誠宰輔，一遵先帝任賢之道，虛己受成，坦平心於天下，無宜內示私親之舉<ref>無宜內示私親之舉　「宜」，各本作「疑」，殿本作「宜」。周校：「無宜」猶「不宜」也。今從之。</ref>，朝野失望，所損豈少！」於是改授都督徐兗青揚州之晉陵吳國諸軍事、衛將軍、徐兗二州刺史、假節、鎮京口。","raw_quote_sha256":"dc5a2ea5a5bf87208266f12a0949c4bf5f77d3d528cfc9723d8a39ae9c198d5b","selected_text_sha256":"293a1caadca4101240b55ee653be82330dc7469a91a288ea9290a91bb23144ca","begin_anchor":"初，裒總角詣庾亮，亮使郭璞筮之。卦成","end_anchor":"衛將軍、徐兗二州刺史、假節、鎮京口。","removed_digital_editorial_notes":[{"text":"無宜內示私親之舉　「宜」，各本作「疑」，殿本作「宜」。周校：「無宜」猶「不宜」也。今從之。","text_layer":"modern_digital_apparatus","independently_verified":false}]},{"proposed_paragraph_id":"c-jinshu-093-chupou:line055","source_lines":[55,55],"raw_quote":"　　永和初，復徵裒，將以為揚州、錄尚書事。吏部尚書劉遐說裒曰：「會稽王令德，國之周公也，足下宜以大政付之。」裒長史王胡之亦勸焉，於是固辭歸籓，朝野咸嘆服之。進號征北大將軍、開府儀同三司，固辭開府。裒又以政道在於得才，宜委賢任能，升敬舊齒，乃薦前光祿大夫顧和、侍中殷浩。疏奏，即以和為尚書令，浩為揚州刺史。","raw_quote_sha256":"31305e205146290a8cdb79f0381ea5c28b8e37f1a0bd39ff7b26a5fae14470b2","selected_text_sha256":"5b6173c6a6c4ba635083b61468b05d1f1b1ad217da1b970d789722b9bfcc788e","begin_anchor":"永和初，復徵裒，將以為揚州、錄尚書事","end_anchor":"疏奏，即以和為尚書令，浩為揚州刺史。"},{"proposed_paragraph_id":"c-jinshu-093-chupou:line057","source_lines":[57,57],"raw_quote":"　　及石季龍死，裒上表請伐之，即日戒嚴，直指泗口。朝議以裒事任貴重，不宜深入，可先遣偏師。裒重陳前所遣前鋒督護王頤之等徑造彭城，示以威信，後遣督護麋嶷進軍下邳，賊即奔潰，嶷率所領據其城池，今宜速發，以成聲勢，於是除征討大都督青、揚、徐、兗、豫五州諸軍事。裒率眾三萬徑進彭城，河朔士庶歸降者日以千計，裒撫納之，甚得其歡心。先遣督護徐龕伐沛<ref>徐龕　考異：太山太守徐龕先已爲石勒所殺，當從穆紀作「王龕」。按：[[資治通鑑|通鑑]]九八亦作「王龕」。校文：此「徐」字疑本「王」之訛。</ref>，獲偽相支重，郡中二千餘人歸降。魯郡山有五百餘家，亦建義請援，裒遣龕領銳卒三千迎之。龕違裒節度，軍次代陂，為石遵將李菟所敗<ref>李菟　周校：穆紀及載記作「李農」。按：通鑑九八亦作「李農」。</ref>，死傷太半，龕執節不撓，為賊所害。裒以《[[春秋]]》責帥，授任失所，威略虧損，上疏自貶，以征北將軍行事，求留鎮廣陵。詔以偏帥之責，不應引咎，逋寇未殄，方鎮任重，不宜貶降，使還鎮京口，解征討都督。","raw_quote_sha256":"ae6f874cfae5c2724035121c4ec7b46f45ecccc99195fe88d4a676ecedea52c0","selected_text_sha256":"c94e62ef37fb2ef69081daae2489f16e6a67618266df41d3e16556115dcde7af","begin_anchor":"及石季龍死，裒上表請伐之，即日戒嚴，","end_anchor":"，不宜貶降，使還鎮京口，解征討都督。","removed_digital_editorial_notes":[{"text":"徐龕　考異：太山太守徐龕先已爲石勒所殺，當從穆紀作「王龕」。按：[[資治通鑑|通鑑]]九八亦作「王龕」。校文：此「徐」字疑本「王」之訛。","text_layer":"modern_digital_apparatus","independently_verified":false},{"text":"李菟　周校：穆紀及載記作「李農」。按：通鑑九八亦作「李農」。","text_layer":"modern_digital_apparatus","independently_verified":false}]},{"proposed_paragraph_id":"c-jinshu-093-chupou:line059","source_lines":[59,59],"raw_quote":"　　時石季龍新死，其國大亂，遺戶二十萬口渡河，將歸順，乞師救援。會裒已旋，威勢不接，莫能自拔，皆為慕容皝及苻健之眾所掠，死亡咸盡。裒以遠圖不就，憂慨發病。及至京口，聞哭聲甚眾，裒問：「何哭之多？」左右曰：「代陂之役也。」裒益慚恨。{{YL|永和五年}}卒，年四十七，遠近嗟悼，吏士哀慕之。贈侍中、太傅，本官如故，諡曰元穆。子歆，字幼安，以學行知名，歷散騎常侍、秘書監。","raw_quote_sha256":"e6f86ed56709ca292a0f8a9156e8f9558f22c472d3f531fb27d2cc8cead8e1f8","selected_text_sha256":"a3753d9019abc7019411fcae0331ca81ef68d6aa54ec79be8025a3ef8168208f","begin_anchor":"時石季龍新死，其國大亂，遺戶二十萬口","end_anchor":"安，以學行知名，歷散騎常侍、秘書監。"}]}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true}}
