e_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-054-recluses-complete:p016:m0147","start":147,"end":149,"surface":"江山","kind":"person","person_id":"2cw_h1b_0g1","status":"contextual_provisional","paragraph_id":"c-nanqishu-054-recluses-complete:p016","chapter_id":"c-nanqishu-054-recluses-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-054-recluses-complete:p016","text":"　　歡晚節服食，不與人通。每旦出戶，山鳥集其掌取食。事黃老道，解陰陽書，爲數術多效驗。初元嘉末，出都寄住東府，忽題柱云：「三十年二月二十一日。」因東歸。後太初弒逆，果是此年月。自知將終，賦詩言志云：「精氣因天行，遊魂隨物化。」剋死日，卒於剡山，身體柔軟，時年六十四。還葬舊墓，木連理出墓側，縣令江山圖表狀。世祖詔歡諸子，撰歡《文議》三十卷。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":56,"last_line":56,"raw_start":2786,"raw_end":2956,"raw_character_offsets":[2786,2787,2788,2789,2790,2791,2792,2793,2794,2795,2796,2797,2798,2799,2800,2801,2802,2803,2804,2805,2806,2807,2808,2809,2810,2811,2812,2813,2814,2815,2816,2817,2818,2819,2820,2821,2822,2823,2824,2825,2826,2827,2828,2829,2830,2831,2832,2833,2834,2835,2836,2837,2838,2839,2840,2841,2842,2843,2844,2845,2846,2847,2848,2849,2850,2851,2852,2853,2854,2855,2856,2857,2858,2859,2860,2861,2862,2863,2864,2865,2866,2867,2868,2869,2870,2871,2872,2873,2874,2875,2876,2877,2878,2879,2880,2881,2882,2883,2884,2885,2886,2887,2888,2889,2890,2891,2892,2893,2894,2895,2896,2897,2898,2899,2900,2901,2902,2903,2904,2905,2906,2907,2908,2909,2910,2911,2912,2913,2914,2915,2916,2917,2918,2919,2920,2921,2922,2923,2924,2925,2926,2927,2928,2929,2930,2931,2932,2933,2934,2935,2936,2937,2938,2939,2940,2941,2942,2943,2944,2945,2946,2947,2948,2949,2950,2951,2952,2953,2954,2955],"revision_id":1762878},"mentions":[{"id":"c-nanqishu-054-recluses-c