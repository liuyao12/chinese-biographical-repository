{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003424","identity_policy":"contextual_provisional","person_ids":["cbr-p003424"],"persons":[{"id":"cbr-p003424","label":"陳渉（陳丞相世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"陳渉","mention_ids":["c-shiji-056-chen:m004-0000"]}],"evidence":[{"mention_id":"c-shiji-056-chen:m004-0000","chapter_id":"c-shiji-056-chen","paragraph_id":"c-shiji-056-chen:p004","quote":"陳渉"}]}],"source_mention_summary":[{"source_id":"s-shiji-056-chen","work_id":"w-shiji","book_id":"b-shiji-056","chapter_id":"c-shiji-056-chen","mention_count":1,"mention_ids":["c-shiji-056-chen:m004-0000"],"paragraph_ids":["c-shiji-056-chen:p004"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-056-chen"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-056-chen:m004-0000","start":0,"end":2,"surface":"陳渉","kind":"person","person_id":"cbr-p003424","status":"contextual_provisional","paragraph_id":"c-shiji-056-chen:p004","chapter_id":"c-shiji-056-chen"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji056-007","person_id":"cbr-p003424","surfaces":["陳渉"],"scope":"same_chapter","chapter_ids":["c-shiji-056-chen"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-056-chen:p004","quote":"陳渉起而王陳，使周市略定魏地，立魏咎爲魏王，與秦軍相攻於臨濟。陳平固已前謝其兄伯，從少年往事魏王咎於臨濟。魏王以爲太僕。説魏王不聽，人或讒之，陳平亡去。"}],"rationale":"依本篇明示名字、局部主語、授官爵與家世暫接。平城與負郭不作短名，韓王信與淮陰侯韓信、審食其與酈食其分開。上依高帝與孝文帝敘事換主語，指控與古代比擬不當已驗史實；未名者不補全名，女孫父親不由婚議推定。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-056-chen:p004","text":"陳渉起而王陳，使周市略定魏地，立魏咎爲魏王，與秦軍相攻於臨濟。陳平固已前謝其兄伯，從少年往事魏王咎於臨濟。魏王以爲太僕。説魏王不聽，人或讒之，陳平亡去。","annotation_status":"named_mentions_first_pass","text_laye