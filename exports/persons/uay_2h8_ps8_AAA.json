h_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji036-103","person_id":"uay_2h8_ps8_AAA","surfaces":["湣公","越","陳侯","陳湣公"],"scope":"same_chapter","chapter_ids":["c-shiji-036-chenqi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-036-chenqi:p024","quote":"懷公元年，吳破楚，在郢，召陳侯。陳侯欲往，大夫曰：「吳新得意；楚王雖亡，與陳有故，不可倍。」懷公乃以疾謝吳。四年，吳復召懷公。懷公恐，如吳。吳怒其前不往，留之，因卒吳。陳乃立懷公之子越，是為湣公。"},{"paragraph_id":"c-shiji-036-chenqi:p025","quote":"湣公六年，孔子適陳。吳王夫差伐陳，取三邑而去。十三年，吳復來伐陳，陳告急楚，楚昭王來救，軍於城父，吳師去。是年，楚昭王卒於城父。時孔子在陳。十五年，宋滅曹。十六年，吳王夫差伐齊，敗之艾陵，使人召陳侯。陳侯恐，如吳。楚伐陳。二十一年，齊田常弒其君簡公。二十三年，楚之白公勝殺令尹子西、子綦，襲惠王。葉公攻敗白公，白公自殺。"},{"paragraph_id":"c-shiji-036-chenqi:p026","quote":"二十四年，楚惠王復國，以兵北伐，殺陳湣公，遂滅陳而有之。是歲，孔子卒。"}],"rationale":"本篇第24、25、26段按明示名與稱號、陳／杞世系及具體敘事暫定「湣公／越／陳侯／陳湣公」同指；引句均保留，不按同名字面跨篇合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-036-chenqi:p024","text":"懷公元年，吳破楚，在郢，召陳侯。陳侯欲往，大夫曰：「吳新得意；楚王雖亡，與陳有故，不可倍。」懷公乃以疾謝吳。四年，吳復召懷公。懷公恐，如吳。吳怒其前不往，留之，因卒吳。陳乃立懷公之子越，是為湣公。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-036-chenqi:m024-0000","start":0,"end":2,"surface":"懷公","kind":"person","person_id":"uay_2h8_ps8_AA","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m024-0013","start":13,"end":15,"surface":"陳侯","kind":"person","person_id":"uay_2h8_ps8_AA","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m024-0016","start":16,"end":18,"surface":"陳侯","kind":"person","person_id":"uay_2h8_ps8_AA","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m024-0021","start":21,"end":23,"surface":"大夫","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、引語角色、國別、校勘或未定指代；不補未見人名、闕代或成員。"},{"id":"c-shiji-036-chenqi:m024-0031","start":31,"end":33,"surface":"楚王","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、引語角色、國別、校勘或未定指代；不補未見人名、闕代或成員。"},{"id":"c-shiji-036-chenqi:m024-0046","start":46,"end":48,"surface":"懷公","kind":"person