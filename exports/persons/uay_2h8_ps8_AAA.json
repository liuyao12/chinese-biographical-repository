0116","start":116,"end":119,"surface":"齊田常","kind":"person","person_id":"m0b_b5e_153","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m025-0122","start":122,"end":124,"surface":"簡公","kind":"person","person_id":"wuz_yxe_b9k_AA","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m025-0132","start":132,"end":135,"surface":"白公勝","kind":"person","person_id":"ppk_dnc_f2g","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m025-0138","start":138,"end":140,"surface":"子西","kind":"person","person_id":"o2m_3n4_oi4","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m025-0141","start":141,"end":143,"surface":"子綦","kind":"person","person_id":"11c_2n2_xqq","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m025-0145","start":145,"end":147,"surface":"惠王","kind":"person","person_id":"bff_e4b_8yv","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m025-0148","start":148,"end":150,"surface":"葉公","kind":"person","person_id":"lgb_gdh_ej5","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m025-0152","start":152,"end":154,"surface":"白公","kind":"person","person_id":"ppk_dnc_f2g","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m025-0155","start":155,"end":157,"surface":"白公","kind":"person","person_id":"ppk_dnc_f2g","status":"contextual_provisional"}],"chapter_id":"c-shiji-036-chenqi","book_id":"b-shiji-036","work_id":"w-shiji","source_id":"s-shiji-036-chenqi"},{"id":"c-shiji-036-chenqi:p026","text":"二十四年，楚惠王復國，以兵北伐，殺陳湣公，遂滅陳而有之。是歲，孔子卒。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-036-chenqi:m026-0005","start":5,"end":8,"surface":"楚惠王","kind":"person","person_id":"bff_e4b_8yv","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m026-0017","start":17,"end":20,"surface":"陳湣公","kind":"person","person_id":"uay_2h8_ps8_AAA","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m026-0031","start":31,"end":33,"surface":"孔子","kind":"person","person_id":"fp6_ia6_7yw","status":"contextual_provisional"}],"chapter_id":"c-shiji-036-chenqi","book_id":"b-shiji-036","work_id":"w-shiji","source_id":"s-shiji-036-chenqi"},{"id":"c-shiji-036-chenqi:p028","text":"東樓公生西樓公，西樓公生題公，題公生謀娶公。謀娶公當周厲王時。謀娶公生武公。武公立四十七年卒，子靖公立。靖公二十三年卒，子共公立。共公八年卒，子德公立。德公十八年卒，弟桓公姑容立。桓公十七年卒，子孝公丐立。孝公十七年卒，弟文公益姑立。文公十四年卒，弟平公郁立。平公十八年卒，子悼公成立。悼公十二年卒，子隱公乞立。七月，隱公弟遂弒隱公自立，是為釐公。釐公十九年卒，子湣公維立。湣公十五年，楚惠王滅陳。十六年，湣公弟閼路弒湣公代立，是為哀公。哀公立十年卒，湣公子敕立，是為出公。出公十二年卒，子簡公春立。立一年，楚惠王之四十四年，滅杞。杞後陳亡三十四年。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-036-chenqi:m028-0000","start":0,"end":3,"surface":"東樓公","kind":"person","person_id":"rdo_wsn_30x","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m028-0004","start":4,"end":7,"surface":"西樓公","kind":"person","person_id":"rdo_wsn_30x_A","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m028-0008","start":8,"end":11,"surface":"西樓公","kind":"person","person_id":"rdo_wsn_30x_A","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m028-0012","start":12,"end":14,"surface":"題公","kind":"person","person_id":"rdo_wsn_30x_AA","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m028-0015","start":15,"end":17,"surface":"題公","kind":"person","person_id":"rdo_wsn_30x_AA","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m028-0018","start":18,"end":21,"surface":"謀娶公","kind":"person","person_id":"rdo_wsn_30x_AAA","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m028-0022","start":22,"end":25,"surface":"謀娶公","kind":"person","person_id":"rdo_wsn_30x_AAA","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m028-0026","start":26,"end":29,"surface":"周厲王","kind":"person","person_id":"jps_m3k_hu4","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m028-0031","start":31,"end":34,"surface":"謀娶公","kind":"person","person_id":"rdo_wsn_30x_AAA","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m028-0035","start":35,"end":37,"surface":"武公","ki