neration_distance":1,"status":"contextual_provisional","source_assertion_id":"a-jinshu059-羕-father-亮","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-059","chapter_id":"c-jinshu-059-liang-yang","source_id":"s-jinshu-059-liang-yang","paragraph_id":"c-jinshu-059-liang-yang:line024","quote":"及武帝寢疾，為楊駿所排，乃以亮為侍中、大司馬、假黃鉞、大都督、督豫州諸軍事，出鎮許昌，加軒懸之樂，六佾之舞。封子羕為西陽公。未發，帝大漸，詔留亮委以後事。楊駿聞之，從中書監華暠索詔視，遂不還。帝崩，亮懼駿疑己，辭疾不入，于大司馬門外敘哀而已，表求過葬。駿欲討亮，亮知之，問計于廷尉何勖。勖曰：「今朝廷皆歸心於公，公何不討人而懼為人所討！」或說亮率所領入廢駿，亮不能用，夜馳赴許昌，故得免。及駿誅，詔曰：「大司馬、汝南王亮體道沖粹，通識政理，宣翼之績，顯於本朝，《二南》之風，流于方夏，將憑遠猷，以康王化。其以亮為太宰、錄尚書事，入朝不趨，劍履上殿，增掾屬十人，給千兵百騎，與太保衛瓘對掌朝政。」亮論賞誅楊駿之功過差，欲以苟悅眾心，由是失望。","subject_person_mention_id":"c-jinshu-059-liang-yang:line024:m0056","object_person_mention_id":"c-jinshu-059-liang-yang:line024:m0014"}],"interpretation_note":"先存具名父子／孫系來源，再提出家族路徑；未知中間父親不造人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}},{"id":"dkn_ge4_286_AAAACC*A","label":"瑉（羕孫）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"瑉","mention_ids":["c-jinshu-059-liang-yang:line041:m0273"]}],"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-059","chapter_id":"c-jinshu-059-liang-yang","source_id":"s-jinshu-059-liang-yang","paragraph_id":"c-jinshu-059-liang-yang:line041","quote":"瑉","mention_id":"c-jinshu-059-liang-yang:line041:m0273"}],"identity_note":"卷059固定見證本地人物；未按同名跨史合併。","family_path":{"connection":"grandfather","parent_person_id":null,"generation_distance":2,"status":"contextual_provisional","source_assertion_id":"a-jinshu059-瑉-grandfather-羕","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-059","chapter_id":"c-jinshu-059-liang-yang","source_id":"s-jinshu-059-liang-yang","paragraph_id":"c-jinshu-059-liang-yang:line041","quote":"元帝承制，更拜撫軍大將軍、開府，給千兵百騎，詔與南頓王宗統流人以實中州，江西荒梗，復還。及元帝踐阼，進位侍中、太保。以羕屬尊，元會特為設床。太興初，錄尚書事，尋領大宗師，加羽葆、斧鉞，班劍六十人，進位太宰。及王敦平，領太尉。明帝即位，以羕宗室元老，特為之拜。羕放縱兵士劫鈔，所司奏免羕官，詔不問。及帝寢疾，羕與王導同受顧命輔成帝。時帝幼沖，詔羕依安平獻王孚故事，設床帳於殿上，帝親迎拜。咸和初，坐弟南頓王宗免官，降為弋陽縣王。及蘇峻作亂，羕詣峻稱述其勳，峻大悅，矯詔復羕爵位。峻平，賜死。世子播、播弟充及息崧並伏誅，國除。咸康初，復其屬籍，以羕孫瑉為奉車都尉、奉朝請。","subject_person_mention_id":"c-jinshu-059-liang-yang:line041:m0273","object_person_mention_id":"c-jinshu-059-liang-yang:line041:m0059"}],"interpretation_note":"先存具名父子／孫系來源，再提出家族路徑；未知中間父親不造人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"ancestor_person_id":"dkn_ge4_286_AAAACC","intermediate_person_ids":[null]}}],"source_mention_summary":[{"source_id":"s-jinshu-059-liang-yang","work_id":"w-jinshu","book_id":"b-jinshu-059","chapter_id":"c-jinshu-059-liang-yang","mention_count":1,"mention_ids":["c-jinshu-059-liang-yang:line041:m0273"],"paragraph_ids":["c-jinshu-059-liang-yang:line041"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-jinshu-059-liang-yang"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jinshu059-瑉-grandfather-羕","subject_person_id":"dkn_ge4_286_AAAACC*A","predicate":"grandfather","object_person_id":"dkn_ge4_286_AAAACC","status":"source_attested","qualifiers":{"source_term":"羕孫瑉","lineage":"paternal","generation_difference":-2,"father_person_id":null},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-059","chapter_id":"c-jinshu-059-liang-yang","source_id":"s-jinshu-059-liang-yang","paragraph_id":"c-jinshu-059-liang-yang:line041","quote":"元帝承制，更拜撫軍大將軍、開府，給千兵百騎，詔與南頓王宗統流人以實中州，江西荒梗，復還。及元帝踐阼，進位侍中、太保。以羕屬尊，元會特為設床。太興初，錄尚書事，尋領大宗師，加羽葆、斧鉞，班劍六十人，進位太宰。及王敦平，領太尉。明帝即位，以羕宗室元老，特為之拜。羕放縱兵士劫鈔，所司奏免羕官，詔不問。及帝寢疾，羕與王導同受顧命輔成帝。時帝幼沖，詔羕依安平獻王孚故事，設床帳於殿上，帝親迎拜。咸和初，坐弟南頓王宗免官，降為弋陽縣王。及蘇峻作亂，羕詣峻稱述其勳，峻大悅，矯詔復羕爵位。峻平，賜死。世子播、播弟充及息崧並伏誅，國除。咸康初，復其屬籍，以羕孫瑉為奉車都尉、奉朝請。","subject_person_mention_id":"c-jinshu-059-liang-yang:line041:m0273","object_person_mention_id":"c-jinshu-059-liang-yang:line041:m0059"}],"interpretation_note":"本句具名端點與親屬詞照錄，不補未知父母、婚姻或出生年。","reviewer":"Codex（AI 代理）","hu