,1672,1673,1674,1675,1676,1677,1678,1679,1680,1681,1682,1683,1684,1685,1686,1687,1688,1689,1690,1691,1692,1693,1694,1695,1696,1697,1698,1699,1700,1701,1702,1703,1704,1705,1706,1707,1708,1709,1710,1711,1712,1713,1714,1715,1716,1717,1718,1719]},"chapter_id":"c-sanguozhi-063-liudun","book_id":"b-sanguozhi-063","work_id":"w-sanguozhi","source_id":"s-sanguozhi-063-liudun"},{"id":"c-sanguozhi-063-liudun:line034","text":"惇於諸術皆善，尤明太乙，皆能推演其事，窮盡要妙，著書百餘篇，名儒刁玄稱以爲奇。惇亦寶愛其術，不以告人，故世莫得而明也。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-063-liudun:line034:m0000","start":0,"end":1,"surface":"惇","kind":"person","person_id":"7ko_vou_bwp","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-063-liudun:line034:m0032","start":32,"end":34,"surface":"刁玄","kind":"person","person_id":"s7m_pgz_fux","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-063-liudun:line034:m0039","start":39,"end":40,"surface":"惇","kind":"person","person_id":"7ko_vou_bwp","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"}],"annotation_status":"reviewed","source_position":{"first_line":34,"last_line":34,"revision_id":2188657,"raw_start":1722,"raw_end":1788,"character_positions":[1729,1730,1731,1732,1733,1734,1735,1736,1737,1738,1739,1740,1741,1742,1743,1744,1745,1746,1747,1748,1749,1750,1751,1752,1753,1754,1755,1756,1757,1758,1759,1760,1761,1762,1763,1764,1765,1766,1767,1768,1769,1770,1771,1772,1773,1774,1775,1776,1777,1778,1779,1780,1781,1782,1783,1784,1785,1786,1787]},"chapter_id":"c-sanguozhi-063-liudun","book_id":"b-sanguozhi-063","work_id":"w-sanguozhi","source_id":"s-sanguozhi-063-liudun"},{"id":"c-sanguozhi-063-zhaoda:line043-pei01-01","text":"《吳錄》曰：皇象字休明，廣陵江都人。幼工書。時有張子並、陳梁甫能書。甫恨逋，並恨峻，象斟酌其間，甚得其妙，中國善書者不能及也。嚴武字子卿，衞尉畯再從子也，圍棊莫與爲輩。宋壽占夢，十不失一。曹不興善畫，權使畫屏风，誤落筆點素，因就以作蠅。既進御，權以爲生蠅，舉手彈之。孤城鄭嫗能相人，及範、惇、達八人，世皆稱妙，謂之八絕云。","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-063-zhaoda:line0