,"status":"contextual_provisional"},{"id":"c-songshu-047-mengweisheng:p001:m0008","start":8,"end":10,"surface":"微生","kind":"person","person_id":"3ut_u0d_j6w_*AABA","status":"contextual_provisional"}],"chapter_id":"c-songshu-047-mengweisheng","book_id":"b-songshu-047","work_id":"w-songshu","source_id":"s-songshu-047-mengweisheng-ws2190557"},{"id":"c-songshu-047-mengxizu:p001","text":"孝武大明初，諸流徙者悉聽還本，微生已死，子係祖歸京都，有筋榦異力，能儋負數人。入隸羽林，為殿中將軍。二年，索虜寇青、冀，世祖遣軍援之，係祖自占求行。戰於杜梁，挺身入陳，所殺狼籍，遂見殺。詔書追贈潁川郡太守。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":42,"last_line":42,"raw_start":3867,"raw_end":3970,"raw_character_offsets":[3867,3868,3869,3870,3871,3872,3873,3874,3875,3876,3877,3878,3879,3880,3881,3882,3883,3884,3885,3886,3887,3888,3889,3890,3891,3892,3893,3894,3895,3896,3897,3898,3899,3900,3901,3902,3903,3904,3905,3906,3907,3908,3909,3910,3911,3912,3913,3914,3915,3916,3917,3918,3919,3920,3921,3922,3923,3924,3925,3926,3927,3928,3929,3930,3931,3932,3933,3934,3935,3936,3937,3938,3939,3940,3941,3942,3943,3944,3945,3946,3947,3948,3949,3950,3951,3952,3953,3954,3955,3956,3957,3958,3959,3960,3961,3962,3963,3964,3965,3966,3967,3968,3969],"revision_id":2190557},"mentions":[{"id":"c-songshu-047-mengxizu:p001:m0015","start":15,"end":17,"surface":"微生","kind":"person","person_id":"3ut_u0d_j6w_*AABA","status":"contextual_provisional"},{"id":"c-songshu-047-mengxizu:p001:m0021","start":21,"end":23,"surface":"係祖","kind":"person","person_id":"3ut_u0d_j6w_*AABAA","status":"contextual_provisional"},{"id":"c-songshu-047-mengxizu:p001:m0067","start":67,"end":69,"surface":"係祖","kind":"person","person_id":"3ut_u0d_j6w_*AABAA","status":"contextual_provisional"}],"chapter_id":"c-songshu-047-mengxizu","book_id":"b-songshu-047","work_id":"w-songshu","source_id":"s-songshu-047-mengxizu-ws2190557"}],"sources":[{"chapter_id":"c-songshu-047-meng-family-passages","work_id":"w-songshu","book_id":"b-songshu-047","source_id":"s-songshu-047-meng-family-passages-ws2190557","