{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"65u_rbx_hst","canonical_person_id":"65u_rbx_hst","id_aliases":["cbr-p004153"],"identity_policy":"contextual_provisional","person_ids":["65u_rbx_hst"],"persons":[{"id":"65u_rbx_hst","label":"游騰（樗里子甘茂列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"游騰","mention_ids":["c-shiji-071-chugan:m003-0077"]}],"evidence":[{"mention_id":"c-shiji-071-chugan:m003-0077","chapter_id":"c-shiji-071-chugan","paragraph_id":"c-shiji-071-chugan:p003","quote":"游騰"}],"id_aliases":["cbr-p004153"]}],"source_mention_summary":[{"source_id":"s-shiji-071-chugan","work_id":"w-shiji","book_id":"b-shiji-071","chapter_id":"c-shiji-071-chugan","mention_count":1,"mention_ids":["c-shiji-071-chugan:m003-0077"],"paragraph_ids":["c-shiji-071-chugan:p003"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-071-chugan"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-071-chugan:m003-0077","start":77,"end":79,"surface":"游騰","kind":"person","person_id":"65u_rbx_hst","status":"contextual_provisional","paragraph_id":"c-shiji-071-chugan:p003","chapter_id":"c-shiji-071-chugan"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji071-012","person_id":"65u_rbx_hst","surfaces":["游騰"],"scope":"same_chapter","chapter_ids":["c-shiji-071-chugan"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-071-chugan:p003","quote":"秦惠王卒，太子武王立，逐張儀、魏章，而以樗里子、甘茂為左右丞相。秦使甘茂攻韓，拔宜陽。使樗里子以車百乘入周。周以卒迎之，意甚敬。楚王怒，讓周，以其重秦客。游騰為周說楚王曰：「知伯之伐仇猶，遺之廣車，因隨之以兵，仇猶遂亡。何則？無備故也。齊桓公伐蔡，號曰誅楚，其實襲蔡。今秦，虎狼之國，使樗里子以車百乘入周，周以仇猶、蔡觀焉，故使長戟居前，彊弩在後，名曰衛疾，而實囚之。且夫周豈能無憂其社稷哉？恐一旦亡國以憂大王。」楚王乃悅。"}],"rationale":"依前6段明示名字與局部敘事暫接，樗里子名疾與智囊嚴君明示相配。樗裏只取末句人物比擬，不取陰鄉地名；預言天子不補漢代皇帝。惠王、武王、昭王依卒立分辨；未名韓女、蒲守與衛君不補姓名，異母不補惠王母。游騰引古知伯齊桓公不當同期在場者。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-071-chugan:p003","text":"秦惠王卒，太子武王立，逐張儀、魏章，而以樗里子、甘茂為左右丞相。秦使甘茂攻韓，拔宜陽。使樗里子以車百乘入周。周以卒迎之，意甚敬。楚王怒，讓周，以其重秦客。游騰為周說楚王曰：「知伯之伐仇猶，遺之廣車，因隨之以兵，仇猶遂亡。何則？無備故也。齊桓公伐蔡，號曰誅楚，其實襲蔡。今秦，虎狼之國，使樗里子以車百乘入周，周以仇猶、蔡觀焉，故使長戟居前，彊弩在後，名曰衛疾，而實囚之。且夫周豈能無憂其社稷哉？恐一旦亡國以憂大王。」楚王乃悅。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-071-chugan:m003-0000","start":0,"end":3,"surface":"秦惠王","kind":"person","person_id":"q6q_ax8_y9p","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m003-0005","start":5,"end":9,"surface":"太子武王","kind":"person","person_id":"oaj_udd_7d9","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m003-0012","start":12,"end":14,"surface":"張儀","kind":"person","person_id":"0tj_vst_yao","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m003-0015","start":15,"end":17,"surface":"魏章","kind":"person","person_id":"m1q_tly_ucl","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m003-0020","start":20,"end":23,"surface":"樗里子","kind":"person","person_id":"fae_ax5_a6k","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m003-0024","start":24,"end":26,"surface":"甘茂","kind":"person","person_id":"xcr_p13_j7x","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m003-0034","start":34,"end":36,"surface":"甘茂","kind":"person","person_id":"xcr_p13_j7x","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m003-0044","start":44,"end":47,"surface":"樗里子","kind":"person","person_id":"fae_ax5_a6k","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m003-0052","start":52,"en