a","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfu:p003:m0121","surface":"輔","start":121,"end":122,"person_id":"i3u_1ry_2bg","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfu:p003:m0128","surface":"輔","start":128,"end":129,"person_id":"i3u_1ry_2bg","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfu:p003:m0140","surface":"封尚","start":140,"end":142,"person_id":"e9y_ap5_t2z","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfu:p003:m0154","surface":"韓稚","start":154,"end":156,"person_id":"3yq_f0p_3xx","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfu:p003:m0162","surface":"稚","start":162,"end":163,"person_id":"3yq_f0p_3xx","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfu:p003:m0164","surface":"朴","start":164,"end":165,"person_id":"m9z_h9b_udw","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfu:p003:m0178","surface":"輔","start":178,"end":179,"person_id":"i3u_1ry_2bg","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfu:p003:m0180","surface":"輔","start":180,"end":181,"person_id":"i3u_1ry_2bg","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfu:p003:m0182","surface":"稚","start":182,"end":183,"person_id":"3yq_f0p_3xx","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfu:p003:m0190","surface":"輔","start":190,"end":191,"person_id":"i3u_1ry_2bg","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfu:p003:m0202","surface":"富整","start":202,"end":204,"person_id":"u7r_1cg_ysv","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-060-zhangfu","book_id":"b-jinshu-060","work_id":"w-jinshu","source_id":"s-jinshu-060-zhangfu-ws2413335"},{"id":"c-jinshu-060-zhangfu:p004","text":"初，輔嘗著論云：「管仲不若鮑叔，鮑叔知所奉，知所投。管仲奉主而不能濟，所奔又非濟事之國，三歸反坫，皆鮑不為。」又論班固、司馬遷云：「遷之著述，辭約而事舉，敘三千年事唯五十萬言；班固敘二百年事乃八十萬言，煩省不同，不如遷一也。良史述事，善足以獎勸，惡足以監誡，人道之常。中流小事，亦無取焉，而班皆書之，不如二也。毀貶晁錯，傷忠臣之道，不如三也。遷既造創，固又因循，難易益不同矣。又遷為蘇秦、張儀、范睢、蔡澤作傳，逞辭流離，亦足以明其大才。故述辯士則辭藻華靡，敘實錄則隱核名檢，此所以遷稱良史也。」又論魏武帝不及劉備，樂毅減於諸葛亮，詞多不載。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":59,"last_line":59,"raw_start":4415,"raw_end":4701,"raw_character_offsets":[4417,4418,4419,4420,4421,4422,4423,4424,4425,4426,4427,4428,4429,4430,4431,4432,4433,4434,4435,4436,4437,4438,4439,4440,4441,4442,4443,4444,4445,4446,4447,4448,4449,4450,4451,4452,4453,4454,4455,4456,4457,4458,4459,4460,4461,4462,4463,4464,4465,4466,4467,4468,4469,4470,4471,4472,4473,4474,4475,4476,4477,4478,4479,4480,4481,4482,4483,4484,4485,4486,4487,4488,4489,4490,4491,4492,4493,4494,4500,4501,4502,4505,4506,4507,4508,4509,4510,4511,4512,4513,4514,4520,4521,4522,4525,4526,4527,4528,4529,4530,4531,4532,4533,4534,4535,4536,4537,4538,4539,4540,4541,4542,4543,4544,4545,4546,4547,4548,4549,4550,4551,4552,4553,4554,4555,4556,4557,4558,4559,4560,4561,4562,4563,4564,4565,4566,4567,4568,4569,4570,4571,4572,4573,4574,4575,4576,4577,4578,4579,4580,4581,4582,4583,4584,4585,4586,4587,4588,4589,4590,4591,4592,4593,4594,4595,4596,4597,4598,4599,4600,4601,4602,4603,4604,4605,4606,4607,4608,4609,4610,4611,4612,4613,4614,4615,4616,4617,4618,4619,4620,4621,4622,4623,4624,4625,4626,4627,4628,4629,4630,4631,4632,4633,4634,4635,4636,4637,4638,4639,4640,4641,4642,4643,4644,4645,4646,4647,4648,4649,4650,4651,4652,4653,4654,4655,4656,4657,4658,4659,4660,4661,4662,4663,4664,4665,4666,4667,4668,4669,4670,4671,4672,4673,4674,4675,4676,4677,4678,4679,4680,4681,4682,4683,4684,4685,4686,4687,4688,4689,4690,4691,4692,4693,4694,4695,4696,4697,4698,4699,4700],"revision_id":2413335},"mentions":[{"id":"c-jinshu-060-zhangfu:p004:m0002","surface":"輔","start":2,"end":3,"person_id":"i3u_1ry_2bg","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfu:p004:m0250","surface":"武帝","start":250,"end":252,"person_id":"hgm_jvn_hle","kind":"p