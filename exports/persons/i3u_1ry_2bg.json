hangfu:p003:m0121","mention_ids":["c-jinshu-060-zhangfu:p003:m0121"],"kind":"paragraph"},{"canonical_mention_id":"c-jinshu-060-zhangfu:p003:m0128","mention_ids":["c-jinshu-060-zhangfu:p003:m0128"],"kind":"paragraph"},{"canonical_mention_id":"c-jinshu-060-zhangfu:p003:m0178","mention_ids":["c-jinshu-060-zhangfu:p003:m0178"],"kind":"paragraph"},{"canonical_mention_id":"c-jinshu-060-zhangfu:p003:m0180","mention_ids":["c-jinshu-060-zhangfu:p003:m0180"],"kind":"paragraph"},{"canonical_mention_id":"c-jinshu-060-zhangfu:p003:m0190","mention_ids":["c-jinshu-060-zhangfu:p003:m0190"],"kind":"paragraph"},{"canonical_mention_id":"c-jinshu-060-zhangfu:p004:m0002","mention_ids":["c-jinshu-060-zhangfu:p004:m0002"],"kind":"paragraph"}],"mention_count":21,"duplicate_mention_count":0,"paragraph_occurrence_count":21,"table_occurrence_count":0,"passage_count":4,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"21處獨立位置，21個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-060-zhangfu-ws2413335"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-jinshu-060-zhangfu:source_review1-0","kind":"source_review","person_id":"i3u_1ry_2bg","source_quote":"張輔，字世偉，南陽西鄂人，漢河間相衡之後也。少有幹局，與從母兄劉喬齊名。初補藍田令，不為豪強所屈。時強弩將軍龐宗，西州大姓，護軍趙浚，宗婦族也，故僮僕放縱，為百姓所患。輔繩之，殺其二奴，又奪宗田二百餘頃以給貧戶，一縣稱之。轉山陽令，太尉陳准家僮亦暴橫，輔復擊殺之。累遷尚書郎，封宜昌亭侯。","reading":"張輔字世偉、張衡後，從母兄劉喬；治藍田、山陽的地方事。","note":"張輔字世偉、張衡後，從母兄劉喬；治藍田、山陽的地方事。","paragraph_id":"c-jinshu-060-zhangfu:p001","start_codepoint":0,"end_codepoint":144,"human_reviewed":false,"chapter_id":"c-jinshu-060-zhangfu","source_id":"s-jinshu-060-zhangfu-ws2413335"},{"id":"c-jinshu-060-zhangfu:source_review2-0","kind":"source_review","person_id":"i3u_1ry_2bg","source_quote":"轉御史中丞。時積弩將軍孟觀與明威將軍郝彥不協，而觀因軍事害彥，又賈謐、潘岳、石崇等共相引重，乃義陽王威有詐冒事，輔並糾劾之。梁州刺史楊欣有姊喪，未經旬，車騎長史韓預強聘其女為妻。輔為中正，貶預以清風俗，論者稱之。用孫秀執權，威構輔於秀，秀惑之，將繩輔以法。輔與秀箋曰：「輔徒知希慕古人，當官而行，不復自知小為身計。今義陽王誠弘恕，不以介意。然輔母年七十六，常見憂慮，恐輔將以怨疾獲罪。願明公留神省察輔前後行事，是國之愚臣而已。「秀雖凶狡，知輔雅正，為威所誣，乃止。","reading":"張輔糾劾郝彥等案，貶強聘者韓預，箋孫秀自陳其母年七十六。","note":"張輔糾劾郝彥等案，貶強聘者韓預，箋孫秀自陳其母年七十六。","paragraph_id":"c-jinshu-060-zhangfu:p002","start_codepoint":0,"end_codepoint":232,"human_reviewed":false,"chapter_id":"c-jinshu-060-zhangfu","source_id":"s-jinshu-060-zhangfu-ws2413335"},{"id":"c-jinshu-060-zhangfu:source_review3-0","kind":"source_review","person_id":"i3u_1ry_2bg","source_quote":"後遷馮翊太守。是時長沙王乂以河間王顒專制關中，有不臣之跡，言于惠帝，密詔雍州刺史劉沈、秦州刺史皇甫重使討顒。於是沈等與顒戰于長安，輔遂將兵救顒，沈等敗績。顒德之，乃以輔代重為秦州刺史。當赴顒之難，金城太守游楷亦皆有功，轉梁州刺史，不之官。楷聞輔之還，不時迎輔，陰圖之。又殺天水太守封尚，欲揚威西土。召隴西太守韓稚會議，未決。稚子朴有武幹，斬異議者，即收兵伐輔。輔與稚戰于遮多穀口，輔軍敗績，為天水故帳下督富整所殺。","reading":"張輔先救顒，後於遮多穀口敗給韓稚軍，為富整所殺。","note":"張輔先救顒，後於遮多穀口敗給韓稚軍，為富整所殺。","paragraph_id":"c-jinshu-060-zhangfu:p003","start_codepoint":0,"end_codepoint":207,"human_reviewed":false,"chapter_id":"c-jinshu-060-zhangfu","source_id":"s-jinshu-060-zhangfu-ws2413335"},{"id":"c-jinshu-060-zhangfu:source_review4-0","kind":"source_review","person_id":"i3u_1ry_2bg","source_quote":"初，輔嘗著論云：「管仲不若鮑叔，鮑叔知所奉，知所投。管仲奉主而不能濟，所奔又非濟事之國，三歸反坫，皆鮑不為。」又論班固、司馬遷云：「遷之著述，辭約而事舉，敘三千年事唯五十萬言；班固敘二百年事乃八十萬言，煩省不同，不如遷一也。良史述事，善足以獎勸，惡足以監誡，人道之常。中流小事，亦無取焉，而班皆書之，不如二也。毀貶晁錯，傷忠臣之道，不如三也。遷既造創，固又因循，難易益不同矣。又遷為蘇秦、張儀、范睢、蔡澤作傳，逞辭流離，亦足以明其大才。故述辯士則辭藻華靡，敘實錄則隱核名檢，此所以遷稱良史也。」又論魏武帝不及劉備，樂毅減於諸葛亮，詞多不載。","reading":"張輔著論管仲、鮑叔與班固、司馬遷，比論魏武、劉備、樂毅、諸葛亮。","note":"張輔著論管仲、鮑叔與班固、司馬遷，比論魏武、劉備、樂毅、諸葛亮。","paragraph_id":"c-jinshu-060-zhangfu:p004","start_codepoint":0,"end_codepoint":270,"human_reviewed":false,"chapter_id":"c-jinshu-060-zhangfu","source_id":"s-jinshu-060-zhangfu-ws2413335"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin060-zhangfu-ancestor","subject_person_id":"i3u_1ry_2bg","object_person_id":"vzb_fi3_b