t":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-058-zhou-qi-ws1775463"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin070-chenchang-brother","subject_person_id":"iwm_5re_k0c","object_person_id":"kok_m7n_tux","predicate":"brother","qualifiers":{"source_term":"敏弟昶"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-070","chapter_id":"c-jinshu-070-ganzhuo","source_id":"s-jinshu-070-ganzhuo-ws2595540","paragraph_id":"c-jinshu-070-ganzhuo:p001","quote":"甘卓字季思，丹楊人，秦丞相茂之後也。曾祖寧，爲吳將。祖述，仕吳爲尚書。父昌，太子太傅。吳平，卓退居自守。郡命主簿、功曹，察孝廉，州舉秀才，爲吳王常侍。討石冰，以功賜爵都亭侯。東海王越引爲參軍，出補離狐令。卓見天下大亂，棄官東歸，前至歷陽，與陳敏相遇。敏甚悅，共圖縱橫之計，遂爲其子景娶卓女，共相結託。會周玘唱義，密使錢廣攻敏弟昶，敏遣卓討廣，頓朱雀橋南。會廣殺昶，玘告丹楊太守顧榮共邀說卓。卓素敬服榮，且以昶死懷懼，良久乃從之。遂詐疾迎女，斷橋，收船南岸，共滅敏，傳首于京都。","subject_person_mention_id":"c-jinshu-070-ganzhuo:p001:m0163","object_person_mention_id":"c-jinshu-070-ganzhuo:p001:m0120"}],"status":"source_attested","interpretation_note":"原文敏弟昶。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-058-zhou-qi:p003:m0072","surface":"昶","start":72,"end":73,"person_id":"iwm_5re_k0c","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-058-zhou-qi:p003","chapter_id":"c-jinshu-058-zhou-qi"},{"id":"c-jinshu-058-zhou-qi:p003:m0098","surface":"昶","start":98,"end":99,"person_id":"iwm_5re_k0c","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-058-zhou-qi:p003","chapter_id":"c-jinshu-058-zhou-qi"},{"id":"c-jinshu-070-ganzhuo:p001:m0163","surface":"昶","start":163,"end":164,"person_id":"iwm_5re_k0c","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-070-ganzhuo:p001","chapter_id":"c-jinshu-070-ganzhuo"}],"relations":[{"id":"a-jin070-chenchang-brother","subject_person_id":"iwm_5re_k0c","object_person_id":"kok_m7n_tux","predicate":"brother","qualifiers":{"source_term":"敏弟昶"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-070","chapter_id":"c-jinshu-070-ganzhuo","source_id":"s-jinshu-070-ganzhuo-ws2595540","paragraph_id":"c-jinshu-070-ganzhuo:p001","quote":"甘卓字季思，丹楊人，秦丞相茂之後也。曾祖寧，爲吳將。祖述，仕吳爲尚書。父昌，太子太傅。吳平，卓退居自守。郡命主簿、功曹，察孝廉，州舉秀才，爲吳王常侍。討石冰，以功賜爵都亭侯。東海王越引爲參軍，出補離狐令。卓見天下大亂，棄官東歸，前至歷陽，與陳敏相遇。敏甚悅，共圖縱橫之計，遂爲其子景娶卓女，共相結託。會周玘唱義，密使錢廣攻敏弟昶，敏遣卓討廣，頓朱雀橋南。會廣殺昶，玘告丹楊太守顧榮共邀說卓。卓素敬服榮，且以昶死懷懼，良久乃從之。遂詐疾迎女，斷橋，收船南岸，共滅敏，傳首于京都。","subject_person_mention_id":"c-jinshu-070-ganzhuo:p001:m0163","object_person_mention_id":"c-jinshu-070-ganzhuo:p001:m0120"}],"status":"source_attested","interpretation_note":"原文敏弟昶。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-058-zhou-qi:p003","text":"陳敏反於揚州，以圮爲安豐太守，加四品將軍。玘稱疾不行，密遣使告鎮東將軍劉准，令發兵臨江，己爲內應，翦發爲信。准在壽春，遣督護衡彥率眾而東。時敏弟昶爲廣武將軍、曆陽內史，以呉興錢廣爲司馬。玘密諷廣殺昶。玘與顧榮、甘卓等以兵攻敏，敏眾奔潰，單馬北走，獲之於江乘界，斬之於建康，夷三族。東海王越聞其名，召爲參軍。詔補尚書郎、散騎郎，並不行。元帝初鎮江左，以玘爲倉曹屬。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":26,"last_line":26,"raw_start":2144,"raw_end":2335,"raw_character_offsets":[2146,2147,2148,2149,2150,2151,2152,2153,2154,2155,2156,2157,2158,2159,2160,2161,2