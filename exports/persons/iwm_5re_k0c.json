ovisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-058-zhou-qi:p003:m0072","surface":"昶","start":72,"end":73,"person_id":"iwm_5re_k0c","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-058-zhou-qi:p003","chapter_id":"c-jinshu-058-zhou-qi"},{"id":"c-jinshu-058-zhou-qi:p003:m0098","surface":"昶","start":98,"end":99,"person_id":"iwm_5re_k0c","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-058-zhou-qi:p003","chapter_id":"c-jinshu-058-zhou-qi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-058-zhou-qi:p003","text":"陳敏反於揚州，以圮爲安豐太守，加四品將軍。玘稱疾不行，密遣使告鎮東將軍劉准，令發兵臨江，己爲內應，翦發爲信。准在壽春，遣督護衡彥率眾而東。時敏弟昶爲廣武將軍、曆陽內史，以呉興錢廣爲司馬。玘密諷廣殺昶。玘與顧榮、甘卓等以兵攻敏，敏眾奔潰，單馬北走，獲之於江乘界，斬之於建康，夷三族。東海王越聞其名，召爲參軍。詔補尚書郎、散騎郎，並不行。元帝初鎮江左，以玘爲倉曹屬。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":26,"last_line":26,"raw_start":2144,"raw_end":2335,"raw_character_offsets":[2146,2147,2148,2149,2150,2151,2152,2153,2154,2155,2156,2157,2158,2159,2160,2161,2162,2163,2164,2165,2166,2167,2168,2169,2170,2171,2172,2173,2174,2175,2176,2177,2178,2179,2180,2181,2182,2183,2184,2185,2186,2187,2188,2189,2190,2191,2192,2193,2194,2195,2196,2197,2198,2199,2200,2201,2202,2203,2204,2205,2206,2207,2208,2209,2210,2211,2212,2213,2214,2215,2216,2217,2218,2219,2220,2221,2222,2223,2224,2225,2226,2227,2228,2229,2230,2231,2232,2233,2234,2235,2236,2237,2238,2239,2240,2241,2242,2243,2244,2245,2246,2247,2248,2249,2250,2251,2252,2253,22