":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-liangshu-029-xiaolun-complete:p002:m0119","start":119,"end":121,"surface":"大春","kind":"person","person_id":"oz6_fhf_30w","status":"contextual_provisional","paragraph_id":"c-liangshu-029-xiaolun-complete:p002","chapter_id":"c-liangshu-029-xiaolun-complete"}],"relations":[],"title_holdings":[{"id":"th-liangshu-029-xiaolun-complete-2-116","title":"西豊公","kind":"noble_rank","mode":"attestation","person_id":"oz6_fhf_30w","attestations":[{"id":"th-liangshu-029-xiaolun-complete-2-116:a","paragraph_id":"c-liangshu-029-xiaolun-complete:p002","start":116,"end":119,"surface":"西豊公","person_mention_id":"c-liangshu-029-xiaolun-complete:p002:m0119","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-029","chapter_id":"c-liangshu-029-xiaolun-complete","source_id":"s-liangshu-029-xiaolun-complete-ws1538079","paragraph_id":"c-liangshu-029-xiaolun-complete:p002","quote":"太清二年，進位中衛將軍、開府儀同三司。侯景構逆，加征討大都督，率衆討景。將發，高祖誡曰：「侯景小豎，頗習行陣，未可以一戰卽殄，當以歲月圖之。」綸次鐘離，景已度釆石。綸乃晝夜兼道，遊軍入赴。濟江中流，風起，人馬溺者十一二。遂率寧遠將軍西豊公大春、新淦公大成等，步騎三萬，發自京口。將軍趙伯超曰：「若從黃城大道，必與賊遇，不如徑路直指鐘山，出其不意。」綸從之。衆軍奄至，賊徒大駭，分爲三道攻綸，綸與戰，大破之，斬首千餘級。翌日，賊又來攻，相持日晚，賊稍引卻，南安侯駿以數十騎馳之。賊回拒駿，駿部亂。賊因逼大軍，軍遂潰。綸至鐘山，衆裁千人，賊圍之，戰又敗，乃奔還京口。","person_mention_id":"c-liangshu-029-xiaolun-complete:p002:m0119"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-029-xiaolun-complete:p002","text":"太清二年，進位中衛將軍、開府儀同三司。侯景構逆，加征討大都督，率衆