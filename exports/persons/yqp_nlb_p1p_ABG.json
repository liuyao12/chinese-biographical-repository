11","work_id":"w-shiji","source_id":"s-shiji-011-jingdi"},{"id":"c-shiji-052-qidaohui:p024","text":"後一歲，孝文帝以所封悼惠王子分齊為王，齊孝王將閭以悼惠王子楊虛侯為齊王。故齊別郡盡以王悼惠王子：子志為濟北王，子辟光為濟南王，子賢為菑川王，子卬為膠西王，子雄渠為膠東王，與城陽、齊凡七王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-052-qidaohui:m024-0004","start":4,"end":7,"surface":"孝文帝","kind":"person","person_id":"28d_4fi_xdp","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m024-0010","start":10,"end":13,"surface":"悼惠王","kind":"person","person_id":"yqp_nlb_p1p_AB","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m024-0019","start":19,"end":24,"surface":"齊孝王將閭","kind":"person","person_id":"jc7_nxq_532","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m024-0025","start":25,"end":28,"surface":"悼惠王","kind":"person","person_id":"yqp_nlb_p1p_AB","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m024-0043","start":43,"end":46,"surface":"悼惠王","kind":"person","person_id":"yqp_nlb_p1p_AB","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m024-0049","start":49,"end":50,"surface":"志","kind":"person","person_id":"yqp_nlb_p1p_ABH","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m024-0056","start":56,"end":58,"surface":"辟光","kind":"person","person_id":"yqp_nlb_p1p_ABD","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m024-0064","start":64,"end":65,"surface":"賢","kind":"person","person_id":"yqp_nlb_p1p_ABG","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m024-0071","start":71,"end":72,"surface":"卬","kind":"person","person_id":"yqp_nlb_p1p_ABB","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m024-0078","start":78,"end":80,"surface":"雄渠","kind":"person","person_id":"yqp_nlb_p1p_ABE","status":"contextual_provisional"}],"chapter_id":"c-shiji-052-qidaohui","book_id":"b-shiji-052","work_id":"w-shiji","source_id":"s-shiji-052-qidaohui"},{"id":"c-shiji-052-qidaohui:p040","text":"菑川王賢，齊悼惠王子，以武城侯文帝十六年為菑川王。十一年，與吳楚反，漢擊破，殺賢。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-052-qidaohui:m040-0000","start":0,"end":4,"surface":"菑川王賢","kind":"person","person_id":"yqp_nlb_p1p_ABG","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m040-0005","start":5,"end":9,"surface":"齊悼惠王","kind":"person","person_id":"yqp_nlb_p1p_AB","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m040-0015","start":15,"end":17,"surface":"文帝","kind":"person","person_id":"28d_4fi_xdp","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m040-0039","start":39,"end":40,"surface":"賢","kind":"person","person_id":"yqp_nlb_p1p_ABG","status":"contextual_provisional"}],"chapter_id":"c-shiji-052-qidaohui","book_id":"b-shiji-052","work_id":"w-shiji","source_id":"s-shiji-052-qidaohui"},{"id":"c-shiji-052-qidaohui:p041","text":"天子因徙濟北王志王菑川。志亦齊悼惠王子，以安都侯王濟北。菑川王反，毋後，乃徙濟北王王菑川。凡立三十五年卒，謚為懿王。子建代立，是為靖王。二十年卒，子遺代立，是為頃王。三十六年卒，子終古立，是為思王。二十八年卒，子尚立，是為孝王。五年卒，子橫立，至建始三年，十一歲，卒。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-052-qidaohui:m041-0000","start":0,"end":2,"surface":"天子","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、官稱、未名者或待核回指；不補姓名，王作動詞不當人名。"},{"id":"c-shiji-052-qidaohui:m041-0004","start":4,"end":8,"surface":"濟北王志","kind":"person","person_id":"yqp_nlb_p1p_ABH","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m041-0012","start":12,"end":13,"surface":"志","kind":"person","person_id":"yqp_nlb_p1p_ABH","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m041-0014","start":14,"end":18,"surface":"齊悼惠王","kind":"person","person_id":"yqp_nlb_p1p_AB","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m041-0028","start":28,"end":31,"surface":"菑川王","kind":"person","person_id":"yqp_nlb_p1p_ABG","status":"contextual_provisional","note":"集體、官稱、未名者或待核回指；不補姓名，王作動詞不當人名。"},{"id":"c-shiji-052-qidaohui:m041-0038","start":38,"end":41,"surface":"濟北王","kind":"person","person_id":"yqp_nlb_p1p_ABH","status":"contextual_provisional","note":"集體、官稱、未名者或待核回指；不補姓名，王作動詞不當人名。"},{"id":"c-shiji-052-qidaohui:m041-0059","start":59,"end":60,"surface":"建","kind":"person","person_id":"yqp_nlb_p1p_ABHA","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m041-0065","start":65,"end":67,"surface":"靖王","kind":"person","person_id":"yqp_nlb_p1p_ABHA","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m041-0074","start":74,"end":75,"surface":"遺","kind":"person","person_id":"yqp_nlb_p1p_ABHAA","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m041-0080","start":80,"end":82,"surface":"頃王","kind":"person","person_id":"yqp_nlb_p1p_ABHAA","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m041-0090","start":90,"end":92,"surface":"終古","kind":"person","person_id":"yqp_nlb_p1p_ABHAAA","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m041-0096","start":96,"end":98,"surface":"思王","kind":"person","person_id":"yqp_nlb_p1p_ABHAAA","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m041-0106","start":106,"end":107,"surface":"尚","kind":"person","person_id":"yqp_nlb_p1p_ABHAAAA","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m041-0111","start":111,"end":113,"surface":"孝王","kind":"person","person_id":"yqp_nlb_p1p_ABHAAAA","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m041-0119","start":119,"end":120,"surface":"橫","kind":"person","person_id":"yqp_nlb_p1p_ABHAAAAA","status":"contextual_provisional"}],"chapter_id":"c-shiji-052-qidaohui","book_id":"b-shiji-052","work_id":"w-shiji","source_id":"s-shiji-052-qidaohui"},{"id":"c-shiji-106-wuwang:p016","text":"二月中，吳王兵既破，敗走，於是天子制詔將軍曰：「蓋聞為善者天報之以福；為非者天報之以殃。高皇帝親表功德，建立諸侯，幽王、悼惠王絕無後，孝文皇帝哀憐加惠，王幽王子遂、悼惠王子卬等，令奉其先王宗廟，為漢藩國，德配天地，明并日月。吳王濞倍德反義，誘受天下亡命罪人，亂天下幣，稱病不朝二十餘年，有司數請濞罪，孝文皇帝寬之，欲其改行為善。今乃與楚王戊、趙王遂、膠西王卬、濟南王辟光、菑川王賢、膠東王雄渠約從反，為逆無道，起兵以危宗廟，賊殺大臣及漢使者，迫劫萬民，夭殺無罪，燒殘民家，掘其丘冢，甚為暴虐。今卬等又重逆無道，燒宗廟，鹵御物，朕甚痛之。朕素服避正殿，將軍其勸士大夫擊反虜。擊反虜者，深入多殺為功，斬首捕虜比三百石以上者皆殺之，無有所置。敢有議詔及不如詔者，皆要斬。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-106-wuwang:m016-0004","start":4,"end":6,"surface":"吳王","kind":"person","person_id":"yqp_nlb_p1p_CA","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m016-0044","start":44,"end":47,"surface":"高皇帝","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m016-0057","start":57,"end":59,"surface":"幽王","kind":"person","person_id":"yqp_nlb_p1p_AE","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m016-0060","start":60,"end":63,"surface":"悼惠王","kind":"person","person_id":"yqp_nlb_p1p_AB","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m016-0067","start":67,"end":71,"surface":"孝文皇帝","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m016-0077","start":77,"end":79,"surface":"幽王","kind":"person","person_id":"yqp_nlb_p1p_AE","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m016-0082","start":82,"end":85,"surface":"悼惠王","kind":"person","person_id":"yqp_nlb_p1p_AB","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m016-0112","start":112,"end":115,"surface":"吳王濞","kind":"person","person_id":"yqp_nlb_p1p_CA","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m016-0150","start":150,"end":154,"surface":"孝文皇帝","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m016-0167","start":167,"end":170,"surface":"楚王戊","kind":"person","person_id":"yqp_nlb_p1p_DCA","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m016-0171","start":171,"end":174,"surface":"趙王遂","kind":"person","person_id":"yqp_nlb_p1p_AEA","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m016-0175","start":175,"end":179,"surface":"膠西王卬","kind":"person","person_id":"yqp_nlb_p1p_ABB","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m016-0180","start":180,"end":185,"surface":"濟南王辟光","kind":"person","person_id":"yqp_nlb_p1p_ABD","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m016-0186","start":186,"end":190,"surface":"菑川王賢","kind":"person","person_id":"yqp_nlb_p1p_ABG","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m016-0191","start":191,"end":196,"surface":"膠東王雄渠","kind":"person","person_id":"yqp_nlb_p1p_ABE","status":"contextual_provisional"}],"chapter_id":"c-shiji-106-wuwang","book_id":"b-shiji-106","work_id":"w-shiji","source_id":"s-shiji-106-wuwang"}],"table_passages":[{"id":"shiji-017-t1-r043-c09","column":9,"rowspan":1,"colspan":1,"text":"四月丙寅，初王賢元年。齊悼惠王子，故武城侯。","source_row":44,"source_column":10,"printed_page":null,"person_mentions":[{"id":"shiji-017-t1-r043-c09-review-007","start":7,"end":8,"surface":"賢","person_id":"yqp_nlb_p1p_ABG","status":"contextual_provisional","interpretation_note":"本格受封者本名與舊侯號同指，與052本名及前爵對讀；平昌與昌平、扐與勒等字序或字形各依見證保留，不將姓名當全域別名。","identity_evidence":[{"work_id":"w-shiji","book_id":"b-shiji-052","chapter_id":"c-shiji-052-qidaohui","source_id":"s-shiji-052-qidaohui","paragraph_id":"c-shiji-052-qidaohui:p024","person_id":"yqp_nlb_p1p_ABG","quote":"後一歲，孝文帝以所封悼惠王子分齊為王，齊孝王將閭以悼惠王子楊虛侯為齊王。故齊別郡盡以王悼惠王子：子志為濟北王，子辟光為濟南王，子賢為菑川王，子卬為膠西王，子雄渠為膠東王，與城陽、齊凡七王。","source_revision":5977113}]},{"id":"shiji-017-t1-r043-c09-review-012","start":12,"end":15,"surface":"悼惠王","person_id":"yqp_nlb_p1p_AB","status":"contextual_provisional","interpretation_note":"依本格封國、紀年、所載親屬及核讀篇文暫定同指；省稱限本格，不設為全域別名。","identity_evidence":[{"work_id":"w-shiji","book_id":"b-shiji-008","chapter_id":"c-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p090","source_id":"s-shiji-008-gaozu","source_revision":2440965,"person_id":"yqp_nlb_p1p_AB","quote":"長庶齊悼惠王肥"}]},{"id":"shiji-017-t1-r043-c09-review-018","start":18,"end":21,"surface":"武城侯","person_id":"yqp_nlb_p1p_ABG","status":"contextual_provisional","interpretation_note":"本格受封者本名與舊侯號同指，與052本名及前爵對讀；平昌與昌平、扐與勒等字序或字形各依見證