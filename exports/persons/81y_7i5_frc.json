:m0357","start":357,"end":358,"surface":"嵊","kind":"person","person_id":"ant_dk4_dds_B","status":"contextual_provisional"},{"id":"c-liangshu-043-zhangsheng:p002:m0360","start":360,"end":361,"surface":"景","kind":"person","person_id":"5d1_8jg_amy","status":"contextual_provisional"},{"id":"c-liangshu-043-zhangsheng:p002:m0362","start":362,"end":363,"surface":"景","kind":"person","person_id":"5d1_8jg_amy","status":"contextual_provisional"}],"chapter_id":"c-liangshu-043-zhangsheng","book_id":"b-liangshu-043","work_id":"w-liangshu","source_id":"s-liangshu-043-zhangsheng-ws2087360"},{"text":"子野少時集注喪服、續裴氏家傳各二卷，抄合後漢事四十餘卷。又敕撰眾僧傳二十卷，百官九品二卷，附益諡法一卷，方國使圖一卷，文集二十卷：並行於世。又欲撰齊梁春秋，始草創，未就而卒。及葬，湘東王為之墓誌銘，陳于藏內。邵陵王又立墓誌，堙於羨道。羨道列志，自此始焉。子騫，官至通直郎。","source_position":{"start":11443,"end":11579,"raw":"子野少時集注喪服、續裴氏家傳各二卷，抄合後漢事四十餘卷。又敕撰眾僧傳二十卷，百官九品二卷，附益諡法一卷，方國使圖一卷，文集二十卷：並行於世。又欲撰齊梁春秋，始草創，未就而卒。及葬，湘東王為之墓誌銘，陳于藏內。邵陵王又立墓誌，堙於羨道。羨道列志，自此始焉。子騫，官至通直郎。","raw_path":"sources/nanshi/wikisource-1554233-raw.wikitext"},"id":"c-nanshi-033-pei-family:p023","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-nanshi-033-pei-family:p023:m0000","start":0,"end":2,"surface":"子野","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"字幾原、父昭明、著宋略、掌國史及中大通卒，梁030同字、同家系、同著述與朝事。"},{"id":"c-nanshi-033-pei-family:p023:m0090","start":90,"end":93,"surface":"湘東王","kind":"person","person_id":"rvc_bqx_v5w","status":"contextual_provisional","interpretation_note":"梁書卷05固定2312810正文首段明諱繹、天監十三年封湘東郡王；南史此為梁子野中大通二年卒葬時湘東王作誌，時段和唯一王號相合，辨繹，不把外證諱字補進本篇原文。"},{"id":"c-nanshi-033-pei-family:p023:m0094","start":94,"end":95,"surface":"之","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"字幾原、父昭明、著宋略、掌國史及中大通卒，梁030同字、同家系、同著述與朝事。"},{"id":"c-nanshi-033-pei-family:p023:m0104","start":104,"end":107,"surface":"邵陵王","kind":"person","person_id":"81y_7i5_frc","status":"contextual_provisional","interpretation_note":"梁書卷29固定1538079正文邵陵攜王綸字世調、天監十三年封、普通五年奪爵後大通元年復封、中大通四年再免；子野中大通二年卒葬時位於復封有效敘事，故本源邵陵王辨綸，不據數位notes或維基百科。"},{"id":"c-nanshi-033-pei-family:p023:m0128","start":128,"end":129,"surface":"騫","kind":"person","person_id":"vpy_180_2oi_AAAAAA","status":"contextual_provisional","interpretation_note":"子野子騫官至通直郎，梁030同父同官同傳末位置作謇，保騫／謇兩來源原字。"}],"chapter_id":"c-nanshi-033-pei-family","book_id":"b-nanshi-033","work_id":"w-nanshi","source_id":"s-nanshi033-ws1554233"}],"sources":[{"chapter_id":"c-chenshu-017-wangchong-complete","work_id":"w-chenshu","book_id":"b-chenshu-017","source_id":"s-chenshu-017-wangchong-complete-ws1544244","source":{"title":"陳書卷十七·王沖","provider":"Wikisource","permalink":"https://zh.wikisource.org/w/index.php?oldid=1544244","url":"https://zh.wikisource.org/w/index.php?oldid=1544244","revision_id":1544244,"edition":"維基文庫固定修訂","accessed_on":"2026-11-21","review_status":"text_checked","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫授權。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","extent":"陳書卷十七·王沖","text_scope":"complete_biography_unit","raw_path":"sources/chenshu/chenshu017-ws1544244.wikitext","raw_file_sha256":"8d95f1fe792049025076c024e18aec87f8fd42ac2d05afea063555680e852328"}},{"chapter_id":"c-chenshu-017-yuanshu-complete","work_id":"w-chenshu","book_id":"b-chenshu-017","source_id":"s-chenshu-017-yuanshu-complete-ws1544244","source":{"title":"陳書卷十七·袁樞","provider":"Wikisource","permalink":"https://zh.wikisource.org/w/index.php?oldid=1544244","url":"https://zh.wikisource.org/w/index.php?oldid=1544244","revision_id":1544244,"edition":"維基文庫固定修訂","accessed_on":"2026-11-21","review_status":"text_checked","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫授權。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","extent":"陳書卷十七·袁樞","text_scope":"complete_biography_unit","raw_path":"sources/chenshu/chenshu017-ws1544244.wikitext","raw_file_sha256":"8d95f1fe792049025076c024e18aec87f8fd42ac2d05afea063555680e852328"}},{"chapter_id":"c-liangshu-028-peizhili-complete","work_id":"w-liangshu"