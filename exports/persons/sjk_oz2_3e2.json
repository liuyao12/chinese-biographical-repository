interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-liang027-caishi-spouse","subject_person_id":"sjk_oz2_3e2","object_person_id":"0va_s3x_wb4","predicate":"spouse","qualifiers":{"source_term":"昭明太子薨，官屬罷，妃蔡氏"},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-027","chapter_id":"c-liangshu-027-luxiang-complete","source_id":"s-liangshu-027-luxiang-complete-ws1511478","paragraph_id":"c-liangshu-027-luxiang-complete:p002","quote":"天監三年，都官尚書范岫表薦襄，起家擢拜著作佐郎，除永寧令。秩滿，累遷司空臨川王法曹，外兵，輕車廬陵王記室參軍。昭明太子聞襄業行，啓高祖引與游處，除太子洗馬，遷中舍人，並掌管記。出爲揚州治中，襄父終此官，固辭職，高祖不許，聽與府司馬換廨居之。昭明太子敬耆老，襄母年將八十，與蕭琛、傅昭、陸杲每月常遣存問，加賜珍羞衣服。襄母嘗卒患心痛，醫方須三升粟漿，是時冬月，日又逼暮，求索無所。忽有老人詣門貨漿，量如方劑，始欲酬直，無何失之，時以襄孝感所致也。累遷國子博士，太子家令，復掌管記，母憂去職。襄年已五十，毀頓過禮，太子憂之，日遣使誡喻。服闋，除太子中庶子，復掌管記。中大通三年，昭明太子薨，官屬罷，妃蔡氏別居金華宮，以襄爲中散大夫、領步兵校尉、金華宮家令、知金華宮事。","subject_person_mention_id":"c-liangshu-027-luxiang-complete:p002:m0298","object_person_mention_id":"c-liangshu-027-luxiang-complete:p002:m0055"}],"status":"source_attested","interpretation_note":"昭明薨後妃居金華宮，周書另稱統妃蔡氏。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-liangshu-027-luxiang-complete:p002:m0298","start":298,"end":300,"surface":"蔡氏","kind":"person","person_id":"sjk_oz2_3e2","status":"contextual_provisional","paragraph_id":"c-liangshu-027-luxiang-complete:p002","chapter_id":"c-liangshu-027-luxiang-complete"}],"relations":[{"id":"a-liang027-caishi-spouse","subject_person_id":"sjk_oz2_3e2","object_person_id":"0va_s3x_wb4","predicate":"spouse","qualifiers":{"source_term":"昭明太子薨，官屬罷，妃蔡氏"},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-027","chapter_id":"c-liangshu-027-luxiang-complete","source_id":"s-liangshu-027-luxiang-complete-ws1511478","paragraph_id":"c-liangshu-027-luxiang-complete:p002","quote":"天監三年，都官尚書范岫表薦襄，起家擢拜著作佐郎，除永寧令。秩滿，累遷司空臨川王法曹，外兵，輕車廬陵王記室參軍。昭明太子聞襄業行，啓高祖引與游處，除太子洗馬，遷中舍人，並掌管記。出爲揚州治中，襄父終此官，固辭職，高祖不許，聽與府司馬換廨居之。昭明太子敬耆老，襄母年將八十，與蕭琛、傅昭、陸杲每月常遣存問，加賜珍羞衣服。襄母嘗卒患心痛，醫方須三升粟漿，是時冬月，日又逼暮，求索無所。忽有老人詣門貨漿，量如方劑，始欲酬直，無何失之，時以襄孝感所致也。累遷國子博士，太子家令，復掌管記，母憂去職。襄年已五十，毀頓過禮，太子憂之，日遣使誡喻。服闋，除太子中庶子，復掌管記。中大通三年，昭明太子薨，官屬罷，妃蔡氏別居金華宮，以襄爲中散大夫、領步兵校尉、金華宮家令、知金華宮事。","subject_person_mention_id":"c-liangshu-027-luxiang-complete:p002:m0298","object_person_mention_id":"c-liangshu-027-luxiang-complete:p002:m0055"}],"status":"source_attested","interpretation_note":"昭明薨後妃居金華宮，周書另稱統妃蔡氏。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"title_holdings":[],"address_assertions":[],"person_references":[{"id":"c-liangshu-027-luxiang-complete:p002:r0297","paragraph_id":"c-liangshu-027-luxiang-complete:p002","start":297,"end":298,"surface":"妃","person_id":"sjk_oz2_3e2","referent_role":"third_person","quote":"天監三年，都官尚書范岫表薦襄，起家擢拜著作佐郎，除永寧令。秩滿，累遷司空臨川王法曹，外兵，輕車廬陵王記室參軍。昭明太子聞襄業行，啓高祖引與游處，除太子洗馬，遷中舍人，並掌管記。出爲揚州治中，襄父終此官，固辭職，高祖不許，聽與府司馬換廨居之。昭明太子敬耆老，襄母年將八十，與蕭琛、傅昭、陸杲每月常遣存問，加賜珍羞衣服。襄母嘗卒患心痛，醫方須三升粟漿，是時冬月，日又逼暮，求索無所。忽有老人詣門貨漿，量如方劑，始欲酬直，無何失之，時以襄孝感所致也。累遷國子博士，太子家令，復掌管記，母憂去職。襄年已五十，毀頓過禮，太子憂之，日遣使誡喻。服闋，除太子中庶子，復掌管記。中大通三年，昭明太子薨，官屬罷，妃蔡氏別居金華宮，以襄爲中散大夫、領步兵校尉、金華宮家令、知金華宮事。","note":"依本段敘事、稱謂及語者受者定。","chapter_id":"c-liangshu-027-luxiang-complete","book_id":"b-liangshu-027","work_id":"w-liangshu","source_id":"s-liangshu-027-luxiang-complete-ws1511478"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-027-luxiang-complete:p002","text":"天監三年，都官尚書范岫表薦襄，起家擢拜著作佐郎，除永寧令。秩滿，累遷司空臨川王法曹，外兵，輕車廬陵王記室參軍。昭明太子聞襄業行，啓高祖引與游處，除太子洗馬，遷中舍人，並掌管記。出爲揚州治中，襄父終此官，固辭職，高祖不許，聽與府司馬換廨居之。昭明太子敬耆老，襄母年將八十，與蕭琛、傅昭、陸杲每月常遣存問，加賜珍羞衣服。襄母嘗卒患心痛，醫方須三升粟漿，是時冬月，日又逼暮，求索無所。忽有老人詣門貨漿，量如方劑，始欲酬直，無何失之，時以襄孝感所致也。累遷國子博士，太子家令，復掌管記，母憂去職。襄年已五十，毀頓過禮，太子憂之，日遣使誡喻。服闋，除太子中庶子，復掌管記。中大通三年，昭明太子薨，官屬罷，妃蔡氏別居金華宮，以襄爲中散大夫、領步兵校尉、金華宮家令、知金華宮事。","text_layer":"received_chapter","annotation_status":"reviewed