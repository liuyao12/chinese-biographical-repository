xtual_provisional","paragraph_id":"c-shiji-113-nanyue:p001","chapter_id":"c-shiji-113-nanyue"},{"id":"c-shiji-113-nanyue:m002-0019","start":19,"end":21,"surface":"高帝","kind":"person","person_id":"bmn_s2c_y7n","status":"contextual_provisional","paragraph_id":"c-shiji-113-nanyue:p002","chapter_id":"c-shiji-113-nanyue"},{"id":"c-shiji-113-nanyue:m003-0082","start":82,"end":84,"surface":"先帝","kind":"person","person_id":"bmn_s2c_y7n","status":"contextual_provisional","paragraph_id":"c-shiji-113-nanyue:p003","chapter_id":"c-shiji-113-nanyue"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-113-nanyue:p001","text":"南越王尉佗者，真定人也，姓趙氏。秦時已并天下，略定楊越，置桂林、南海、象郡，以謫徙民，與越雜處十三歲。佗，秦時用為南海龍川令。至二世時，南海尉任囂病且死，召龍川令趙佗語曰：「聞陳勝等作亂，秦為無道，天下苦之，項羽、劉季、陳勝、吳廣等州郡各共興軍聚眾，虎爭天下，中國擾亂，未知所安，豪傑畔秦相立。南海僻遠，吾恐盜兵侵地至此，吾欲興兵絕新道，自備，待諸侯變，會病甚。且番禺負山險，阻南海，東西數千里，頗有中國人相輔，此亦一州之主也，可以立國。郡中長吏無足與言者，故召公告之。」即被佗書，行南海尉事。囂死，佗即移檄告橫浦、陽山、湟谿關曰：「盜兵且至，急絕道聚兵自守！」因稍以法誅秦所置長吏，以其黨為假守。秦已破滅，佗即擊并桂林、象郡，自立為南越武王。高帝已定天下，為中國勞苦，故釋佗弗誅。漢十一年，遣陸賈因立佗為南越王，與剖符通使，和集百越，毋為南邊患害，與長沙接境。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-113-nanyue:m001-0003","start":3,"end":5,"surface":"尉佗","kind":"person","person_id":"r3c_eue_cqn","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m001-0051","start":51,"end":52,"surface":"佗","kind":"person","person_id":"r3c_eue_cqn","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m001-0064","start":64,"end":66,"surface":"二世","kind":"person","person_id":"ntz_hml_tl6","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m001-0071","start":71,"end":73,"surface":"任囂","kind":"person","person_id":"e8q_4ar_5bh","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m001-0081","start":81,"end":83,"surface":"趙佗","kind":"person","person_id":"r3c_eue_cqn","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m001-0088","start":88,"end":90,"surface":"陳勝","kind":"person","person_id":"hav_xw6_5np","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m001-0104","start":104,"end":106,"surface":"項羽","kind":"person","person_id":"67a_vl4_hwv","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m001-0107","start":107,"end":109,"surface":"劉季","kind":"person","person_id":"jhm_171_fem","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m001-0110","start":110,"end":112,"surface":"陳勝","kind":"person","person_id":"hav_xw6_5np","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m001-0113","start":113,"end":115,"surface":"吳廣","kind":"person","person_id":"hu0_8um_byp","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m001-0219","start":219,"end":223,"surface":"郡中長吏","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-113-nanyue:m001-0238","start":238,"end":239,"surface":"佗","kind":"person","person_id":"r3c_eue_cqn","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m001-0247","start":247,"end":248,"surface":"囂","kind":"person","person_id":"e8q_4ar_5bh","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m001-0250","start":250,"end":251,"surface":"佗","kind":"person","person_id":"r3c_eue_cqn","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m001-0304","start":304,"end":305,"surface":"佗","kind":"person","person_id":"r3c_eue_cqn","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m001-0322","start":322,"end":324,"surface":"高帝","kind":"person","person_id":"bmn_s2c_y7n","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m001-0337","start":337,"end":338,"surface":"佗","kind":"person","person_id":"r3c_eue_cqn","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m001-0347","start":347,"end":349,"surface":"陸賈","kind":"person","person_id":"fpv_2sb_uay","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m001-0351","start":351,"end":352,"surface":"佗","kind":"person","person_id":"r3c_eue_cqn","status":"contextual_provisional"}],"chapter_id":"c-shiji-113-nanyue","book_id":"b-shiji-113","work_id":"w-shiji","source_id":"s-shiji113-nanyue"},{"id":"c-shiji-113-nanyue:p002","text":"高后時，有司請禁南越關市鐵器。佗曰：「高帝立我，通使物，今高後聽讒臣，別異蠻夷，隔絕器物，此必長沙王計也，欲倚中國，擊滅南越而并王之，自為功也。」於是佗乃自尊號為南越武帝，發兵攻長沙邊邑，敗數縣而去焉。高後遣將軍隆慮侯灶往擊之。會暑溼，士卒大疫，兵不能踰嶺。歲餘，高后崩，即罷兵。佗因此以兵威邊，財物賂遺閩越、西甌、駱，役屬焉，東西萬餘里。乃乘黃屋左纛，稱制，與中國侔。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-113-nanyue:m002-0000","start":0,"end":2,"surface":"高后","kind":"person","person_id":"ow5_ebp_tr8","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m002-0015","start":15,"end":16,"surface":"佗","kind":"person","person_id":"r3c_eue_cqn","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m002-0019","start":19,"end":21,"surface":"高帝","kind":"person","person_id":"bmn_s2c_y7n","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m002-0029","start":29,"end":31,"surface":"高後","kind":"person","person_id":"ow5_ebp_tr8","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m002-0047","start":47,"end":50,"surface":"長沙王","kind":"person","person_id":"8ip_ubw_ssk","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m002-0075","start":75,"end":76,"surface":"佗","kind":"person","person_id":"r3c_eue_cqn","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m002-0101","start":101,"end":103,"surface":"高後","kind":"person","person_id":"ow5_ebp_tr8","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m002-0109","start":109,"end":110,"surface":"灶","kind":"person","person_id":"cnz_t0f_oaz","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m002-0132","start":132,"end":134,"surface":"高后","kind":"person","person_id":"ow5_ebp_tr8","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m002-0140","start":140,"end":141,"surface":"佗","kind":"person","person_id":"r3c_eue_cqn","status":"contextual_provisional"}],"chapter_id":"c-shiji-113-nanyue","book_id":"b-shiji-113","work_id":"w-shiji","source_id":"s-shiji113-nanyue"},{"id":"c-shiji-113-nanyue:p003","text":"及孝文帝元年，初鎮撫天下，使告諸侯四夷從代來即位意，喻盛德焉。乃為佗親冢在真定，置守邑，歲時奉祀。召其從昆弟，尊官厚賜寵之。詔丞相陳平等舉可使南越者，平言好畤陸賈，先帝時習使南越。乃召賈以為太中大夫，往使。因讓佗自立為帝，曾無一介之使報者。陸賈至南越，王甚恐，為書謝，稱曰：「蠻夷大長老夫臣佗，前日高后隔異南越，竊疑長沙王讒臣，又遙聞高后盡誅佗宗族，掘燒先人冢，以故自棄，犯長沙邊境。且南方卑溼，蠻夷中閒，其東閩越千人眾號稱王，其西甌駱裸國亦稱王。老臣妄竊帝號，聊以自娛，豈敢以聞天王哉！」乃頓首謝，願長為藩臣，奉貢職。於是乃下令國中曰：「吾聞兩雄不俱立，兩賢不并世。皇帝，賢天子也。自今以後，去帝制黃屋左纛。」陸賈還報，孝文帝大說。遂至孝景時，稱臣，使人朝請。然南越其居國竊如故號名，其使天子，稱王朝命如諸侯。至建元四年卒。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-113-nanyue:m003-0001","start":1,"end":4,"surface":"孝文帝","kind":"person","person_id":"bi1_trt_8y1","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m003-0033","start":33,"end":34,"surface":"佗","kind":"person","person_id":"r3c_eue_cqn","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m003-0034","start":34,"end":35,"surface":"親","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-113-nanyue:m003-0051","start":51,"end":54,"surface":"從昆弟","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-113-nanyue:m003-0065","start":65,"end":67,"surface":"陳平","kind":"person","person_id":"vj4_k9i_17d","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m003-0075","start":75,"end":76,"surface":"平","kind":"person","person_id":"vj4_k9i_17d","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m003-0079","start":79,"end":81,"surface":"陸賈","kind":"person","person_id":"fpv_2sb_uay","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m003-0082","start":82,"end":84,"surface":"先帝","kind":"person","person_id":"bmn_s2c_y7n","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m003-0092","start":92,"end":93,"surface":"賈","kind":"person","person_id":"fpv_2sb_uay","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m003-0105","start":105,"end":106,"surface":"佗","ki