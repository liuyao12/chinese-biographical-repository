face":"上","kind":"person","person_id":"zgv_3zp_3tg","status":"contextual_provisional","paragraph_id":"c-shiji-108-han:p010","chapter_id":"c-shiji-108-han"},{"id":"c-shiji-108-han:m011-0068","start":68,"end":70,"surface":"天子","kind":"person","person_id":"zgv_3zp_3tg","status":"contextual_provisional","paragraph_id":"c-shiji-108-han:p011","chapter_id":"c-shiji-108-han"},{"id":"c-shiji-108-han:m011-0105","start":105,"end":107,"surface":"天子","kind":"person","person_id":"zgv_3zp_3tg","status":"contextual_provisional","paragraph_id":"c-shiji-108-han:p011","chapter_id":"c-shiji-108-han"},{"id":"c-shiji-108-han:m011-0146","start":146,"end":147,"surface":"上","kind":"person","person_id":"zgv_3zp_3tg","status":"contextual_provisional","paragraph_id":"c-shiji-108-han:p011","chapter_id":"c-shiji-108-han"},{"id":"c-shiji-108-han:m012-0181","start":181,"end":183,"surface":"天子","kind":"person","person_id":"zgv_3zp_3tg","status":"contextual_provisional","paragraph_id":"c-shiji-108-han:p012","chapter_id":"c-shiji-108-han"},{"id":"c-shiji-108-han:m014-0047","start":47,"end":49,"surface":"天子","kind":"person","person_id":"zgv_3zp_3tg","status":"contextual_provisional","paragraph_id":"c-shiji-108-han:p014","chapter_id":"c-shiji-108-han"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-108-han:p006","text":"建元中，武安侯田蚡爲漢太尉，親貴用事，安國以五百金物遺蚡。蚡言安國太后，天子亦素聞其賢，即召以爲北地都尉，遷爲大司農。閩越、東越相攻，安國及大行王恢將。未至越，越殺其王降，漢兵亦罷。建元六年，武安侯爲丞相，安國爲御史大夫。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-108-han:m006-0004","start":4,"end":7,"surface":"武安侯","kind":"person","person_id":"l3m_tk9_u47","status":"contextual_provisional"},{"id":"c-shiji-108-han:m006-0007","start":7,"end":9,"surface":"田蚡","kind":"person","person_id":"l3m_tk9_u47","status":"contextual_provisional"},{"id":"c-shiji-108-han:m006-0019","start":19,"end":21,"surface":"安國","kind":"person","person_id":"adb_4so_0qm","status":"contextual_provisional"},{"id":"c-shiji-108-han:m006-0027","start":27,"end":28,"surface":"蚡","kind":"person","person_id":"l3m_tk9_u47","status":"contextual_provisional"},{"id":"c-shiji-108-han:m006-0029","start":29,"end":30,"surface":"蚡","kind":"person","person_id":"l3m_tk9_u47","status":"contextual_provisional"},{"id":"c-shiji-108-han:m006-0031","start":31,"end":33,"surface":"安國","kind":"person","person_id":"adb_4so_0qm","status":"contextual_provisional"},{"id":"c-shiji-108-han:m006-0033","start":33,"end":35,"surface":"太后","kind":"unresolved","person_id":null,"status":"unresolved","note":"未明示姓氏；田蚡之外家支持王太后，建元中仍可能涉及竇太后，暫留候選。"},{"id":"c-shiji-108-han:m006-0036","start":36,"end":38,"surface":"天子","kind":"person","person_id":"zgv_3zp_3tg","status":"contextual_provisional"},{"id":"c-shiji-108-han:m006-0067","start":67,"end":69,"surface":"安國","kind":"person","person_id":"adb_4so_0qm","status":"contextual_provisional"},{"id":"c-shiji-108-han:m006-0072","start":72,"end":74,"surface":"王恢","kind":"person","person_id":"z2v_oh4_mhm","status":"contextual_provisional"},{"id":"c-shiji-108-han:m006-0083","start":83,"end":84,"surface":"王","kind":"person","person_id":"px6_0om_awh","status":"contextual_provisional"},{"id":"c-shiji-108-han:m006-0096","start":96,"end":99,"surface":"武安侯","kind":"person","person_id":"l3m_tk9_u47","status":"contextual_provisional"},{"id":"c-shiji-108-han:m006-0103","start":103,"end":105,"surface":"安國","kind":"person","person_id":"adb_4so_0qm","status":"contextual_provisional"}],"chapter_id":"c-shiji-108-han","book_id":"b-shiji-108","work_id":"w-shiji","source_id":"s-shiji-108-han"},{"id":"c-shiji-108-han:p007","text":"匈奴來請和親，天子下議。大行王恢，燕人也，數爲邊吏，習知胡事。議曰：「漢與匈奴和親，率不過數歳即復倍約。不如勿許，興兵擊之。」安國曰：「千里而戰，兵不獲利。今匈奴負戎馬之足，懷禽獸之心，遷徙鳥舉，難得而制也。得其地不足以爲廣，有其眾不足以爲彊，自上古不屬爲人。漢數千里爭利，則人馬罷，虜以全制其敝。且彊弩之極，矢不能穿魯縞；沖風之末，力不能漂鴻毛。非初不勁，末力衰也。擊之不便，不如和親。」群臣議者多附安國，於是上許和親。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-108-han:m007-0007","start":7,"end":9,"surface":"天子","kind":"person","person_id":"zgv_3zp_3tg","status":"contextual_provisional"},{"id":"c-shiji-108-han:m007-0014","start":14,"end":16,"surface":"王恢","kind":"person","person_id":"z2v_oh4_mhm","status":"contextual_provisional"},{"id":"c-shiji-108-han:m007-0063","start":63,"end":65,"surface":"安國","kind":"person","person_id":"adb_4so_0qm","status":"contextual_provisional"},{"id":"c-shiji-108-han:m007-0123","start":123,"end":124,"surface":"上","kind":"person","person_id":"zgv_3zp_3tg","status":"contextual_provisional"},{"id":"c-shiji-108-han:m007-0201","start":201,"end":203,"surface":"安國","kind":"person","person_id":"adb_4so_0qm","status":"contextual_provisional"},{"id":"c-shiji-108-han:m007-0206","start":206,"end":207,"surface":"上","kind":"person","person_id":"zgv_3zp_3tg","status":"contextual_provisional"}],"chapter_id":"c-shiji-108-han","book_id":"b-shiji-108","work_id":"w-shiji","source_id":"s-shiji-108-han"},{"id":"c-shiji-108-han:p008","text":"其明年，則元光元年，鴈門馬邑豪聶翁壹因大行王恢言上曰：「匈奴初和親，親信邊，可誘以利。」陰使聶翁壹爲閒，亡入匈奴，謂單于曰：「吾能斬馬邑令丞吏，以城降，財物可盡得。」單于愛信之，以爲然，許聶翁壹。聶翁壹乃還，詐斬死罪囚，縣其頭馬邑城，示單于使者爲信。曰：「馬邑長吏已死，可急來。」於是單于穿塞將十餘萬騎，入武州塞。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-108-han:m008-0015","start":15,"end":18,"surface":"聶翁壹","kind":"person","person_id":"87t_93a_gy8","status":"contextual_provisional"},{"id":"c-shiji-108-han:m008-0021","start":21,"end":23,"surface":"王恢","kind":"person","person_id":"z2v_oh4_mhm","status":"contextual_provisional"},{"id":"c-shiji-108-han:m008-0024","start":24,"end":25,"surface":"上","kind":"person","person_id":"zgv_3zp_3tg","status":"contextual_provisional"},{"id":"c-shiji-108-han:m008-0046","start":46,"end":49,"surface":"聶翁壹","kind":"person","person_id":"87t_93a_gy8","status":"contextual_provisional"},{"id":"c-shiji-108-han:m008-0058","start":58,"end":60,"surface":"單于","kind":"person","person_id":"hn9_gz8_uyk","status":"contextual_provisional"},{"id":"c-shiji-108-han:m008-0083","start":83,"end":85,"surface":"單于","kind":"person","person_id":"hn9_gz8_uyk","status":"contextual_provisional"},{"id":"c-shiji-108-han:m008-0094","start":94,"end":97,"surface":"聶翁壹","kind":"person","person_id":"87t_93a_gy8","status":"contextual_provisional"},{"id":"c-shiji-108-han:m008-0098","start":98,"end":101,"surface":"聶翁壹","kind":"person","person_id":"87t_93a_gy8","status":"contextual_provisional"},{"id":"c-shiji-108-han:m008-0106","start":106,"end":109,"surface":"死罪囚","kind":"unresolved","person_id":null,"status":"unresolved","note":"未明示姓名及人數，不由詐稱馬邑長吏補造令丞人物或身份。"},{"id":"c-shiji-108-han:m008-0118","start":118,"end":120,"surface":"單于","kind":"person","person_id":"hn9_gz8_uyk","status":"contextual_provisional"},{"id":"c-shiji-108-han:m008-0120","start":120,"end":122,"surface":"使者","kind":"person","person_id":"v8p_xn6_zmf","status":"contextual_provisional"},{"id":"c-shiji-108-han:m008-0142","start":142,"end":144,"surface":"單于","kind":"person","person_id":"hn9_gz8_uyk","status":"contextual_provisional"}],"chapter_id":"c-shiji-108-han","book_id":"b-shiji-108","work_id":"w-shiji","source_id":"s-shiji-108-han"},{"id":"c-shiji-108-han:p010","text":"天子怒王恢不出擊單于輜重，擅引兵罷也。恢曰：「始約虜入馬邑城，兵與單于接，而臣擊其輜重，可得利。今單于聞，不至而還，臣以三萬人眾不敵，禔取辱耳。臣固知還而斬，然得完陛下士三萬人。」於是下恢廷尉。廷尉當恢逗橈，當斬。恢私行千金丞相蚡。蚡不敢言上，而言於太后曰：「王恢首造馬邑事，今不成而誅恢，是爲匈奴報仇也。」上朝太后，太后以丞相言告上。上曰：「首爲馬邑事者，恢也，故發天下兵數十萬，從其言，爲此。且縱單于不可得，恢所部擊其輜重，猶頗可得，以慰士大夫心。今不誅恢，無以謝天下。」於是恢聞之，乃自殺。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-108-han:m010-0000","start":0,"end":2,"surface":"天子","kind":"person","person_id":"zgv_3zp_3tg","status":"contextual_provisional"},{"id":"c-shiji-108-han:m010-0003","start":3,"end":5,"surface":"王恢","kind":"person","person_id":"z2v_oh4_mhm","status":"contextual_provisional"},{"id":"c-shiji-108-han:m010-0008","start":8,"end":10,"surface":"單于","kind":"person","person_id":"hn9_gz8_uyk","status":"contextual_provisional"},{"id":"c-shiji-108-han:m010-0019","start":19,"end":20,"surface":"恢","kind":"person","person_id":"z2v_oh4_mhm","status":"contextual_provisional"},{"id":"c-shiji-108-han:m010-0033","start":33,"end":35,"surface":"單于","kind":"person","person_id":"hn9_gz8_uyk","status":"contextual_provisional"},{"id":"c-shiji-108-han:m010-0049","start":49,"end":51,"surface":"單于","kind":"person","person_id":"hn9_gz8_uyk","status":"contextual_provisional"},{"id":"c-shiji-108-han:m010-0093","start":93,"end":94,"surface":"恢","kind":"person","person_id":"z2v_oh4_mhm","status":"contextual_provisional"},{"id":"c-shiji-108-han:m010-0094","start":94,"end":96,"surface":"廷尉","kind":"unresolved","person_id":null,"status":"unresolved","note":"下恢廷尉為司法機構；廷尉當恢可為機構或未名官員，不據官稱補個人。"},{"id":"c-shiji-108-han:m010-0097","start":97,"end":99,"surface":"廷尉","kind":"unresolved","person_id":null,"status":"unresolved","note":"下恢廷尉為司法機構；廷尉當恢可為機構或未名官員，不據官稱補個人。"},{"id":"c-shiji-108-han:m010-0100","start":100,"end":101,"surface":"恢","kind":"person","person_id":"z2v_oh4_mhm","status":"contextual_provisional"},{"id":"c-shiji-108-han:m010-0107","start":107,"end":108,"surface":"恢","kind":"person","person_id":"z2v_oh4_mhm","status":"contextual_provisional"},{"id":"c-shiji-108-han:m010-0114","start":114,"end":115,"surface":"蚡","kind":"person","person_id":"l3m_tk9_u47","status":"contextual_provisional"},{"id":"c-shiji-108-han:m010-0116","start":116,"end":117,"surface":"蚡","kind":"person","person_id":"l3m_tk9_u47","status":"contextual_provisional"},{"id":"c-shiji-108-han:m010-0120","start":120,"end":121,"surface":"上","kind":"person","person_id":"zgv_3zp_3tg","status":"contextual_provisional"},{"id":"c-shiji-108-han:m010-0125","start":125,"end":127,"surface":"太后","kind":"person","person_id":"a9j_o55_q8g","status":"contextual_provisional"},{"id":"c-shiji-108-han:m010-0130","start":130,"end":132,"surface":"王恢","kind":"person","person_id":"z2v_oh4_mhm","status":"contextual_provisional"},{"id":"c-shiji-108-han:m010-0143","start":143,"end":144,"surface":"恢","kind":"person","person_id":"z2v_oh4_mhm","status":"contextual_provisional"},{"id":"c-shiji-108-han:m010-0154","start":154,"end":155,"surface":"上","kind":"person","person_id":"zgv_3zp_3tg","status":"contextual_provisional"},{"id":"c-shiji-108-han:m010-0156","start":156,"end":158,"surface":"太后","kind":"person","person_id":"a9j_o55_q8g","status":"contextual_provisional"},{"id":"c-shiji-108-han:m010-0159","start":159,"end":161,"surface":"太后","kind":"person","person_id":"a9j_o55_q8g","status":"contextual_provisional"},{"id":"c-shiji-108-han:m010-0166","start":166,"end":167,"surface":"上","kind":"person","person_id":"zgv_3zp_3tg","status":"contextual_provisional"},{"id":"c-shiji-108-han:m010-0168","start":168,"end":169,"surface":"上","kind":"person","person_id":"zgv_3zp_3tg","status":"contextual_provisional"},{"id":"c-shiji-108-han:m010-0179","start":179,"end":180,"surface":"恢","kind":"person","person_id":"z2v_oh4_mhm","status":"contextual_provisional"},{"id":"c-shiji-108-han:m010-0200","start":200,"end":202,"surface":"單于","kind":"person","person_id":"hn9_gz8_uyk","status":"contextual_provisional"},{"id":"c-shiji-108-han:m010-0206","start":206,"end":207,"surface":"恢","kind":"person","person_id":"z2v_oh4_mhm","status":"contextual_provisional"},{"id":"c-shiji-108-han:m010-0229","start":229,"end":230,"surface":"恢","kind":"person","person_id":"z2v_oh4_mhm","status":"contextual_provisional"},{"id":"c-shiji-108-han:m010-0240","start":240,"end":241,"surface":"恢","kind":"person","person_id":"z2v_oh4_mhm","status":"contextual_provisional"}],"chapter_id":"c-shiji-108-han","book_id":"b-shiji-108","work_id":"w-shiji","source_id":"s-shiji-108-han"},{"id":"c-shiji-108-han:p011","text":"安國爲人多大略，智足以當世取合，而出於忠厚焉。貪嗜於財。所推舉皆廉士，賢於己者也。於梁舉壺遂、臧固、郅他，皆天下名士，士亦以此稱慕之，唯天子以爲國器。安國爲御史大夫四歳餘，丞相田蚡死，安國行丞相事，奉引墮車蹇。天子議置相，欲用安國，使使視之，蹇甚，乃更以平棘侯薛澤爲丞相。安國病免數月，蹇愈，上復以安國爲中尉。歳餘，徙爲衞尉。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-108-han:m011-0000","start":0,"end":2,"surface":"安國","kind":"person","person_id":"adb_4so_0qm","status":"contextual_provisional"},{"id":"c-shiji-108-han:m011-0044","start":44,"end":46,"surface":"壺遂","kind":"person","person_id":"hmj_pm8_38e","status":"contextual_provisional"},{"id":"c-shiji-108-han:m011-0047","start":47,"end":49,"surface":"臧固","kind":"person","person_id":"z6u_kf1_554","status":"contextual_provisional"},{"id":"c-shiji-108-han:m011-0050","start":50,"end":52,"surface":"郅他","kind":"person","person_id":"xqk_r2h_w1e","status":"contextual_provisional"},{"id":"c-shiji-108-han:m011-0068","start":68,"end":70,"surface":"天子","kind":"person","person_id":"zgv_3zp_3tg","status":"contextual_provisional"},{"id":"c-shiji-108-han:m011-0075","start":75,"end":77,"surface":"安國","kind":"person","person_id":"adb_4so_0qm","status":"contextual_provisional"},{"id":"c-shiji-108-han:m011-0088","start":88,"end":90,"surface":"田蚡","kind":"person","person_id":"l3m_tk9_u47","status":"contextual_provisional"},{"id":"c-shiji-108-han:m011-0092","start":92,"end":94,"surface":"安國","kind":"person","person_id":"adb_4so_0qm","status":"contextual_provisional"},{"id":"c-shiji-108-han:m011-0105","start":105,"end":107,"surface":"天子","kind":"person","person_id":"zgv_3zp_3tg","status":"contextual_provisional"},{"id":"c-shiji-108-han:m011-0113","start":113,"end":115,"surface":"安國","kind":"person","person_id":"adb_4so_0qm","status":"contextual_provisional"},{"id":"c-shiji-108-han:m011-0130","start":130,"end":132,"surface":"薛澤","kind":"person","person_id":"ut8_ibh_dll","status":"contextual_provisional"},{"id":"c-shiji-108-han:m011-0136","start":136,"end":138,"surface":"安國","kind":"person","person_id":"adb_4so_0qm","status":"contextual_provisional"},{"id":"c-shiji-108-han:m011-0146","start":146,"end":147,"surface":"上","kind":"person","person_id":"zgv_3zp_3tg","status":"contextual_provisional"},{"id":"c-shiji-108-han:m011-0149","start":149,"end":151,"surface":"安國","kind":"person","person_id":"adb_4so_0qm","status":"contextual_provisional"}],"chapter_id":"c-shiji-108-han","book_id":"b-shiji-108","work_id":"w-shiji","source_id":"s-shiji-108-han"},{"id":"c-shiji-108-han:p012","text":"車騎將軍衞青擊匈奴，出上谷，破胡蘢城。將軍李廣爲匈奴所得，復失之；公孫敖大亡卒：皆當斬，贖爲庶人。明年，匈奴大入邊，殺遼西太守，及入鴈門，所殺略數千人。車騎將軍衞青擊之，出鴈門。衞尉安國爲材官將軍，屯於漁陽。安國捕生虜，言匈奴遠去。即上書言方田作時，請且罷軍屯。罷軍屯月餘，匈奴大入上谷、漁陽。安國壁乃有七百餘人，出與戰，不勝，復入壁。匈奴虜略千餘人及畜產而去。天子聞之，怒，使使責讓安國。徒安國益東，屯右北平。是時匈奴虜言當入東方。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-108-han:m012-0004","start":4,"end":6,"surface":"衞青","kind":"person","person_id":"da9_1jw_qp0","status":"contextual_provisional"},{"id":"c-shiji-108-han:m012-0021","start":21,"end":23,"surface":"李廣","kind":"person","person_id":"njk_tl0_6h9","status":"contextual_provisional"},{"id":"c-shiji-108-han:m012-0033","start":33,"end":36,"surface":"公孫敖","kind":"person","person_id":"zuf_oll_649","status":"contextual_provisional"},{"id":"c-shiji-108-han:m012-0059","start":59,"end":63,"surface":"遼西太守","kind":"person","person_id":"tpa_vui_ddb","status":"contextual_provisional"},{"id":"c-shiji-108-han:m012-0080","start":80,"end":82,"surface":"衞青","kind":"person","person_id":"da9_1jw_qp0","status":"contextual_provisional"},{"id":"c-shiji-108-han:m012-0091","start":91,"end":93,"surface":"安國","kind":"person","person_id":"adb_4so_0qm","status":"contextual_provisional"},{"id":"c-shiji-108-han:m012-0104","start":104,"end":106,"surface":"安國","kind":"person","person_id":"adb_4so_0qm","status":"contextual_provisional"},{"id":"c-shiji-108-han:m012-0147","start":147,"end":149,"surface":"安國","kind":"person","person_id":"adb_4so_0qm","status":"contextual_provisional"},{"id":"c-shiji-108-han:m012-0181","start":181,"end":183,"surface":"天子","kind":"person","person_id":"zgv_3zp_3tg","status":"contextual_provisional"},{"id":"c-shiji-108-han:m012-0192","start":192,"end":194,"surface":"安國","kind":"person","person_id":"adb_4so_0qm","status":"contextual_provisional"},{"id":"c-shiji-108-han:m012-0196","start":196,"end":198,"surface":"安國","kind":"person","person_id":"adb_4so_0qm","status":"contextual_provisional"}],"chapter_id":"c-shiji-108-han","book_id":"b-shiji-108","work_id":"w-shiji","source_id":"s-shiji-108-han"},{"id":"c-shiji-108-han:p014","text":"太史公曰：余與壺遂定律暦，觀韓長孺之義，壺遂之深中隱厚。世之言梁多長者，不虛哉！壺遂官至詹事，天子方倚以爲漢相，會遂卒。不然，壺遂之內廉行修，斯鞠躬君子也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-108-han:m014-0000","start":0,"end":3,"surface":"太史公","kind":"person","person_id":"51v_myd_2cd","status":"contextual_provisional"},{"id":"c-shiji-108-han:m014-0005","start":5,"end":6,"surface":"余","kind":"person","person_id":"51v_myd_2cd","status":"contextual_provisional"},{"id":"c-shiji-108-han:m014-0007","start":7,"end":9,"surface":"壺遂","kind":"person","person_id":"hmj_pm8_38e","status":"contextual_provisional"},{"id":"c-shiji-108-han:m014-0014","start":14,"end":17,"surface":"韓長孺","kind":"person","person_id":"adb_4so_0qm","status":"contextual_provisional"},{"id":"c-shiji-108-han:m014-0020","start":20,"end":22,"surface":"壺遂","kind":"person","person_id":"hmj_pm8_38e","status":"contextual_provisional"},{"id":"c-shiji-108-han:m014-0040","start":40,"end":42,"surface":"壺遂","kind":"person","person_id":"hmj_pm8_38e","status":"contextual_provisional"},{"id":"c-shiji-108-han:m014-0047","start":47,"end":49,"surface":"天子","kind":"person","person_id":"zgv_3zp_3tg","status":"contextual_provisional"},{"id":"c-shiji-108-han:m014-0057","start":57,"end":58,"surface":"遂","kind":"person","person_id":"hmj_pm8_38e","status":"contextual_provisional"},{"id":"c-shiji-108-han:m014-0063","start":63,"end":65,"surface":"壺遂","kind":"person","person_id":"hmj_pm8_38e","status":"contextual_provisional"}],"chapter_id":"c-shiji-108-han","book_id":"b-shiji-108","work_id":"w-shiji","source_id":"s-shiji-108-han"}],"sources":[{"chapter_id":"c-shiji-108-han","work_id":"w-shiji","book_id":"b-shiji-108","source_id":"s-shiji-108-han","source":{"title":"史記／卷108","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷108","permalink":"