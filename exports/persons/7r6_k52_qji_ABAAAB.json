able_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jinshu065-wang-014","subject_person_id":"7r6_k52_qji_ABAAAB","predicate":"father","object_person_id":"7r6_k52_qji_ABAAA","status":"source_attested","qualifiers":{"source_term":"二子","lineage":"paternal"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-065","source_id":"s-jinshu-065-wangdao-family","chapter_id":"c-jinshu-065-wangdao-family","paragraph_id":"c-jinshu-065-wangdao-family:p003","quote":"洽字敬和，導諸子中最知名，與荀羨俱有美稱。弱冠，歷散騎、中書郎、中軍長史、司徒左長史、建武將軍、呉郡內史。徵拜領軍，尋加中書令，固讓，表疏十上。穆帝詔曰：「敬和清裁貴令，昔爲中書郎，吾時尚小，數呼見，意甚親之。今所以用爲令，既機任須才，且欲時時相見，共講文章，待以友臣之義。而累表固讓，甚違本懷。其催洽令拜。」苦讓，遂不受。昇平二年卒於官，年三十六。二子：珣、瑉。"}],"interpretation_note":"依所錄正文具名人物保存；未據兒子名單推絕對排行，不補生母或未知祖先。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"person_id":"7r6_k52_qji_ABAAAB","title":null,"surname":"王","ming":"瑉","additional_names":[],"work_id":"w-jinshu","book_id":"b-jinshu-065","chapter_id":"c-jinshu-065-wangdao-family","source_id":"s-jinshu-065-wangdao-family","paragraph_id":"c-jinshu-065-wangdao-family:p003","quote":"洽字敬和，導諸子中最知名，與荀羨俱有美稱。弱冠，歷散騎、中書郎、中軍長史、司徒左長史、建武將軍、呉郡內史。徵拜領軍，尋加中書令，固讓，表疏十上。穆帝詔曰：「敬和清裁貴令，昔爲中書郎，吾時尚小，數呼見，意甚親之。今所以用爲令，既機任須才，且欲時時相見，共講文章，待以友臣之義。而累表固讓，甚違本懷。其催洽令拜。」苦讓，遂不受。昇平二年卒於官，年三十六。二子：珣、瑉。","note":"王氏具名父系上下文分姓名；未錄字號及任官不補，字母不是排行，子名名單不證絕對排行。","status":"editorial_provisional","human_reviewed":false,"model":null}],"mentions":[{"id":"c-jinshu-065-wangdao-family:p003:m0180","start":180,"end":181,"surface":"瑉","kind":"person","person_id":"7r6_k52_qji_ABAAAB","status":"contextual_provisional","paragraph_id":"c-jinshu-065-wangdao-family:p003","chapter_id":"c-jinshu-065-wangdao-family"}],