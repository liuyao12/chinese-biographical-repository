aragraph_id":"c-shiji-037-wei:p034","chapter_id":"c-shiji-037-wei"},{"id":"c-shiji-037-wei:m034-0094","start":94,"end":96,"surface":"悝母","kind":"person","person_id":"cbr-p001588","status":"contextual_provisional","paragraph_id":"c-shiji-037-wei:p034","chapter_id":"c-shiji-037-wei"},{"id":"c-shiji-037-wei:m034-0153","start":153,"end":156,"surface":"伯姬氏","kind":"person","person_id":"cbr-p001588","status":"contextual_provisional","paragraph_id":"c-shiji-037-wei:p034","chapter_id":"c-shiji-037-wei"},{"id":"c-shiji-037-wei:m034-0160","start":160,"end":162,"surface":"悝母","kind":"person","person_id":"cbr-p001588","status":"contextual_provisional","paragraph_id":"c-shiji-037-wei:p034","chapter_id":"c-shiji-037-wei"},{"id":"c-shiji-037-wei:m034-0179","start":179,"end":181,"surface":"伯姬","kind":"person","person_id":"cbr-p001588","status":"contextual_provisional","paragraph_id":"c-shiji-037-wei:p034","chapter_id":"c-shiji-037-wei"}],"relations":[{"id":"a-shiji037-055","subject_person_id":"cbr-p001588","predicate":"spouse","object_person_id":"cbr-p001587","status":"source_attested","evidence":[{"chapter_id":"c-shiji-037-wei","source_id":"s-shiji-037-wei","paragraph_id":"c-shiji-037-wei:p034","quote":"十二年，初，孔圉文子取太子蒯聵之姊，生悝。孔氏之豎渾良夫美好，孔文子卒，良夫通於悝母。太子在宿，悝母使良夫於太子。太子與良夫言曰：「茍能入我國，報子以乘軒，免子三死，毋所與。」與之盟，許以悝母爲妻。閏月，良夫與太子入，舍孔氏之外圃。昏，二人蒙衣而乘，宦者羅御，如孔氏。孔氏之老欒甯問之，稱姻妾以告。遂入，適伯姬氏。旣食，悝母杖戈而先，太子與五人介，輿猳從之。伯姬劫悝於廁，彊盟之，遂劫以登臺。欒甯將飲酒，炙未熟，聞亂，使告仲由。召護駕乘車，行爵食炙，奉出公輒奔魯。"}],"qualifiers":{"source_term":"孔圉文子取太子蒯聵之姊","historicity":"historical_tradition"},"interpretation_note":"保存本篇明示父、子、生、夫人與兄弟原稱，不由繼位推父子、不補同父同母或闕代；來源主張並非已確證史實。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji037-056","subject_person_id":"cbr-p001588","predicate":"sister","object_person_id":"cbr-p001585","status":"source_attested","evidence":[{"chapter_id":"c-shiji-037-wei","source_id":"s-shiji-037-wei","paragraph_id":"c-shiji-037-wei:p034","quote":"十二年，初，孔圉文子取太子蒯聵之姊，生悝。孔氏之豎渾良夫美好，孔文子卒，良夫通於悝母。太子在宿，悝母使良夫於太子。太子與良夫言曰：「茍能入我國，報子以乘軒，免子三死，毋所與。」與之盟，許以悝母爲妻。閏月，良夫與太子入，舍孔氏之外圃。昏，二人蒙衣而乘，宦者羅御，如孔氏。孔氏之老欒甯問之，稱姻妾以告。遂入，適伯姬氏。旣食，悝母杖戈而先，太子與五人介，輿猳從之。伯姬劫悝於廁，彊盟之，遂劫以登臺。欒甯將飲酒，炙未熟，聞亂，使告仲由。召護駕乘車，行爵食炙，奉出公輒奔魯。"}],"qualifiers":{"source_term":"蒯聵之姊","historicity":"historical_tradition"},"interpretation_note":"保存本篇明示父、子、生、夫人與兄弟原稱，不由繼位推父子、不補同父同母或闕代；來源主張並非已確證史實。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji037-058","subject_person_id":"cbr-p001589","predicate":"mother","object_person_id":"cbr-p001588","status":"source_attested","evidence":[{"chapter_id":"c-shiji-037-wei","source_id":"s-shiji-037-wei","paragraph_id":"c-shiji-037-wei:p034","quote":"十二年，初，孔圉文子取太子蒯聵之姊，生悝。孔氏之豎渾良夫美好，孔文子卒，良夫通於悝母。太子在宿，悝母使良夫於太子。太子與良夫言曰：「茍能入我國，報子以乘軒，免子三死，毋所與。」與之盟，許以悝母爲妻。閏月，良夫與太子入，舍孔氏之外圃。昏，二人蒙衣而乘，宦者羅御，如孔氏。孔氏之老欒甯問之，稱姻妾以告。遂入，適伯姬氏。旣食，悝母杖戈而先，太子與五人介，輿猳從之。伯姬劫悝於廁，彊盟之，遂劫以登臺。欒甯將飲酒，炙未熟，聞亂，使告仲由。召護駕乘車，行爵食炙，奉出公輒奔魯。"}],"qualifiers":{"source_term":"生悝／悝母","historicity":"historical_tradition"},"interpretation_note":"保存本篇明示父、子、生、夫人與兄弟原稱，不由繼位推父子、不補同父同母或闕代；來源主張並非已確證史實。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji037-105","person_id":"cbr-p001588","surfaces":["伯姬","伯姬氏","姊","悝母"],"scope":"same_chapter","chapter_ids":["c-shiji-037-wei"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-037-wei:p034","quote":"十二年，初，孔圉文子取太子蒯聵之姊，生悝。孔氏之豎渾良夫美好，孔文子卒，良夫通於悝母。太子在宿，悝母使良夫於太子。太子與良夫言曰：「茍能入我國，報子以乘軒，免子三死，毋所與。」與之盟，許以悝母爲妻。閏月，良夫與太子入，舍孔氏之外圃。昏，二人蒙衣而乘，宦者羅御，如孔氏。孔氏之老欒甯問之，稱姻妾以告。遂入，適伯姬氏。旣食，悝母杖戈而先，太子與五人介，輿猳從之。伯姬劫悝於廁，彊盟之，遂劫以登臺。欒甯將飲酒，炙未熟，聞亂，使告仲由。召護駕乘車，行爵食炙，奉出公輒奔魯。"}],"rationale":"孔圉取蒯聵姊生悝，後悝母引太子登臺及伯姬劫悝為同一孔氏入國事件，暫定同指；許渾良夫妻未作婚成。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-037-wei:p034","text":"十二年，初，孔圉文子取太子蒯聵之姊，生悝。孔氏之豎渾良夫美好，孔文子卒，良夫通於悝母。太子在宿，悝母使良夫於太子。太子與良夫言曰：「茍能入我國，報子以乘軒，免子三死，毋所與。」與之盟，許以悝母爲妻。閏月，良夫與太子入，舍孔氏之外圃。昏，二人蒙衣而乘，宦者羅御，如孔氏。孔氏之老欒甯問之，稱姻妾以告。遂入，適伯姬氏。旣食，悝母杖戈而先，太子與五人介，輿猳從之。伯姬劫悝於廁，彊盟之，遂劫以登臺。欒甯將飲酒，炙未熟，聞亂，使告仲由。召護駕乘車，行爵食炙，奉出公輒奔魯。","annotation_status":"named_mentions_first_p