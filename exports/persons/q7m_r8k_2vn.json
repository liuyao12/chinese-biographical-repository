k_id":"w-nanqishu","source_id":"s-nanqishu-049-ws2261984-wanghuan"},{"id":"c-songshu-041-wangzhenfeng:p004","text":"順帝即位，齊王秉權，宗室劉晃、劉綽、卜伯興等有異志，太后頗與相關。順帝禪位，太后與帝遜于東邸，因遷居丹陽宮，拜汝陰王太妃。順帝殂於丹陽，更立第京邑。建元元年，薨于第，時年四十四。追加號諡，葬以宋后禮。父僧朗，事別見景文傳。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"start":12,"end":14,"surface":"劉晃","id":"c-songshu-041-wangzhenfeng:p004:m0012","person_id":"3qs_nqa_ioa_AABABA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作晃。"},{"start":15,"end":17,"surface":"劉綽","id":"c-songshu-041-wangzhenfeng:p004:m0015","person_id":"ptn_sz3_vro_BA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作綽。"},{"start":18,"end":21,"surface":"卜伯興","id":"c-songshu-041-wangzhenfeng:p004:m0018","person_id":"i00_t56_vx4","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作卜。"},{"start":101,"end":103,"surface":"僧朗","id":"c-songshu-041-wangzhenfeng:p004:m0101","person_id":"q7m_r8k_2vn","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作僧朗。"},{"start":107,"end":109,"surface":"景文","id":"c-songshu-041-wangzhenfeng:p004:m0107","person_id":"1tc_q18_x7v","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作景。"}],"source_position":{"first_line":278,"last_line":278,"revision_id":2634831,"source_layer":"received_biography","raw_start":11950,"raw_end":12083,"raw_character_offsets":[11950,11951,11952,11953,11954,11955,11956,11957,11958,11959,11960,11961,11962,11963,11964,11965,11966,11967,11968,11969,11970,11971,11972,11973,11974,11975,11976,11977,11978,11979,11980,11981,11982,11983,11984,11985,11986,11987,11988,11989,11990,11991,11992,11993,11994,11995,11996,11997,11998,11999,12000,12001,12002,12003,12004,12005,12006,12007,12008,12009,12010,12011,12012,12013,12014,12015,12016,12017,12018,12019,12020,12021,12022,12023,12029,12030,12031,12032,12035,12036,12037,12038,12039,12040,12041,12042,12043,120