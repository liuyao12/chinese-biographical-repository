"c-shiji-004-zhou:p042","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-005-qin:m009-0080","start":80,"end":82,"surface":"申侯","kind":"person","person_id":"cbr-p000224","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p009","chapter_id":"c-shiji-005-qin"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-004-zhou:p042","text":"幽王以虢石父為卿，用事，國人皆怨。石父為人佞巧善諛好利，王用之。又廢申后，去太子也。申侯怒，與繒、西夷犬戎攻幽王。幽王舉烽火徵兵，兵莫至。遂殺幽王驪山下，虜褒姒，盡取周賂而去。於是諸侯乃即申侯而共立故幽王太子宜臼，是為平王，以奉周祀。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-004-zhou:m042-0000","start":0,"end":2,"surface":"幽王","kind":"person","person_id":"cbr-p000217","status":"source_identified"},{"id":"c-shiji-004-zhou:m042-0003","start":3,"end":6,"surface":"虢石父","kind":"person","person_id":"cbr-p000223","status":"source_identified"},{"id":"c-shiji-004-zhou:m042-0017","start":17,"end":19,"surface":"石父","kind":"person","person_id":"cbr-p000223","status":"source_identified"},{"id":"c-shiji-004-zhou:m042-0034","start":34,"end":36,"surface":"申后","kind":"person","person_id":"cbr-p000221","status":"source_identified"},{"id":"c-shiji-004-zhou:m042-0042","start":42,"end":44,"surface":"申侯","kind":"person","person_id":"cbr-p000224","status":"source_identified"},{"id":"c-shiji-004-zhou:m042-0054","start":54,"end":56,"surface":"幽王","kind":"person","person_id":"cbr-p000217","status":"source_identified"},{"id":"c-shiji-004-zhou:m042-0057","start":57,"end":59,"surface":"幽王","kind":"person","person_id":"cbr-p000217","status":"source_identified"},{"id":"c-shiji-004-zhou:m042-0071","start":71,"end":73,"surface":"幽王","kind":"person","person_id":"cbr-p000217","status":"source_identified"},{"id":"c-shiji-004-zhou:m042-0078","start":78,"end":80,"surface":"褒姒","kind":"person","person_id":"cbr-p000219","status":"source_identified"},{"id":"c-shiji-004-zhou:m042-0094","start":94,"end":96,"surface":"申侯","kind":"person","person_id":"cbr-p000224","status":"source_identified"},{"id":"c-shiji-004-zhou:m042-0100","start":100,"end":102,"surface":"幽王","kind":"person","person_id":"cbr-p000217","status":"source_identified"},{"id":"c-shiji-004-zhou:m042-0102","start":102,"end":106,"surface":"太子宜臼","kind":"person","person_id":"cbr-p000222","status":"source_identified"},{"id":"c-shiji-004-zhou:m042-0109","start":109,"end":111,"surface":"平王","kind":"person","person_id":"cbr-p000222","status":"source_identified"}],"chapter_id":"c-shiji-004-zhou","book_id":"b-shiji-004","work_id":"w-shiji","source_id":"s-shiji-004-zhou"},{"id":"c-shiji-005-qin:p009","text":"襄公元年，以女弟繆嬴為豐王妻。襄公二年，戎圍犬丘，世父擊之，為戎人所虜。歲餘，復歸世父。七年春，周幽王用褒姒廢太子，立褒姒子為適，數欺諸侯，諸侯叛之。西戎犬戎與申侯伐周，殺幽王酈山下。而秦襄公將兵救周，戰甚力，有功。周避犬戎難，東徙雒邑，襄公以兵送周平王。平王封襄公為諸侯，賜之岐以西之地。曰：「戎無道，侵奪我岐、豐之地，秦能攻逐戎，即有其地。」與誓，封爵之。襄公於是始國，與諸侯通使聘享之禮，乃用騮駒、黃牛、羝羊各三，祠上帝西畤。十二年，伐戎而至岐，卒。生文公。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m009-0000","start":0,"end":2,"surface":"襄公","kind":"person","person_id":"cbr-p000344","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0008","start":8,"end":10,"surface":"繆嬴","kind":"person","person_id":"cbr-p000345","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0011","start":11,"end":13,"surface":"豐王","kind":"person","person_id":"cbr-p000346","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0015","start":15,"end":17,"surface":"襄公","kind":"person","person_id":"cbr-p000344","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0025","start":25,"end":27,"surface":"世父","kind":"person","person_id":"cbr-p000343","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0041","start":41,"end":43,"surface":"世父","kind":"person","person_id":"cbr-p000343","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0048","start":48,"end":51,"surface":"周幽王","kind":"person","person_id":"cbr-p000217","status":"contextual_provisional"},{"id":"c-shiji-005-qin: