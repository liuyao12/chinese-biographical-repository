-042-zheng"},{"id":"c-shiji-042-zheng:m020-0119","start":119,"end":121,"surface":"襄王","kind":"person","person_id":"cbr-p002153","status":"contextual_provisional","paragraph_id":"c-shiji-042-zheng:p020","chapter_id":"c-shiji-042-zheng"},{"id":"c-shiji-042-zheng:m020-0122","start":122,"end":124,"surface":"襄王","kind":"person","person_id":"cbr-p002153","status":"contextual_provisional","paragraph_id":"c-shiji-042-zheng:p020","chapter_id":"c-shiji-042-zheng"},{"id":"c-shiji-042-zheng:m020-0145","start":145,"end":147,"surface":"襄王","kind":"person","person_id":"cbr-p002153","status":"contextual_provisional","paragraph_id":"c-shiji-042-zheng:p020","chapter_id":"c-shiji-042-zheng"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji042-059","person_id":"cbr-p002153","scope":"same_chapter","chapter_ids":["c-shiji-042-zheng"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["周襄王","襄王"],"evidence":[{"paragraph_id":"c-shiji-042-zheng:p020","quote":"三十七年春，晉公子重耳反國，立，是爲文公。秋，鄭入滑，滑聽命，已而反與衞，於是鄭伐滑。周襄王使伯服請滑。鄭文公怨惠王之亡在櫟，而文公父厲公入之，而惠王不賜厲公爵祿，又怨襄王之與衞滑，故不聽襄王請而囚伯服。王怒，與翟人伐鄭，弗克。冬，翟攻伐襄王，襄王出奔鄭，鄭文公居王于氾。三十八年，晉文公入襄王成周。"}],"rationale":"依本篇名字、是為、世系及連續事件暫接異稱；同諡不同國分開，建子勝與聲公勝不合併，如兄弟為譬喻不作親屬。述贊與正文不算獨立來源，省稱、古字與校勘仍待核。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-042-zheng:p020","text":"三十七年春，晉公子重耳反國，立，是爲文公。秋，鄭入滑，滑聽命，已而反與衞，於是鄭伐滑。周襄王使伯服請滑。鄭文公怨惠王之亡在櫟，而文公父厲公入之，而惠王不賜厲公爵祿，又怨襄王之與衞滑，故不聽襄王請而囚伯服。王怒，與翟人伐鄭，弗克。冬，翟攻伐襄王，襄王出奔鄭，鄭文公居王于氾。三十八年，晉文公入襄王成周。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-042-zheng:m020-0006","start":6,"end":11,"surface":"晉公子重耳","kind":"person","person_id":"cbr-p002151","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m020-0018","start":18,"end":20,"surface":"文公","kind":"person","person_id":"cbr-p002151","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m020-0043","start":43,"end":46,"surfa