p008","chapter_id":"c-jinshu-059-prince-yi"},{"id":"c-jinshu-059-prince-yue:p004:m0031","surface":"潘滔","start":31,"end":33,"person_id":"yir_cmm_s73","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-059-prince-yue:p004","chapter_id":"c-jinshu-059-prince-yue"},{"id":"c-jinshu-059-yi:p008:m0139","start":35,"end":37,"surface":"潘滔","kind":"person","person_id":"yir_cmm_s73","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。","paragraph_id":"c-jinshu-059-yi:p008","chapter_id":"c-jinshu-059-yi"},{"id":"c-jinshu-098-jin033-wangji:head:m0201","start":201,"end":203,"surface":"潘滔","kind":"person","person_id":"yir_cmm_s73","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:head","chapter_id":"c-jinshu-098-jin033-wangji"},{"id":"c-jinshu-098-jin033-wangji:head:m0260","start":260,"end":262,"surface":"潘滔","kind":"person","person_id":"yir_cmm_s73","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:head","chapter_id":"c-jinshu-098-jin033-wangji"},{"id":"c-jinshu-098-jin033-wangji:line013:m0222","start":222,"end":224,"surface":"潘滔","kind":"person","person_id":"yir_cmm_s73","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line013","chapter_id":"c-jinshu-098-jin033-wangji"}],"relations":[],"title_holdings":[{"id":"th-w098-dun-early-3","person_id":"yir_cmm_s73","title":"洗馬","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-098","chapter_id":"c-jinshu-098-jin033-wangji","source_id":"s-jinshu-098-jin033-wangji","paragraph_id":"c-jinshu-098-jin033-wangji:head","quote":"王敦，字處仲，司徒導之從父兄也。父基，治書侍御史。敦少有奇人之目，尚武帝女襄城公主，拜駙馬都尉，除太子舍人。時王愷、石崇以豪侈相尚，愷嘗置酒，敦與導俱在坐，有女伎吹笛小失聲韻，愷便驅殺之，一坐改容，敦神色自若。他日，又造愷，愷使美人行酒，以客飲不盡，輒殺之。酒至敦、導所，敦故不肯持，美人悲懼失色，而敦傲然不視。導素不能飲，恐行酒者得罪，遂勉強盡觴。導還，歎曰：「處仲若當世，心懷剛忍，非令終也。」洗馬潘滔見敦而目之曰：「處仲蜂目已露，但豺聲未振，若不噬人，亦當為人所噬。」及太子遷許昌，詔東宮官屬不得送。敦及洗馬江統、潘滔，舍人杜蕤、魯瑤等，冒禁于路側望拜流涕，時論稱之。遷給事黃門侍郎。","person_mention_id":"c-jinshu-098-jin033-wangji:head:m0201"}],"attestations":[{"id":"th-w043-dun-early-3:a","paragraph_id":"c-jinshu-098-jin033-wangji:head","start":199,"end":201,"surface":"洗馬","person_mention_id":"c-jinshu-098-jin033-wangji:head:m0201","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-059-prince-yi:p008","text":"殿中左右恨乂功垂成而敗，謀劫出之，更以距穎。越懼難作，欲遂誅乂。黃門郎潘滔勸越密告張方，方遣部將郅輔勒兵三千，就金墉收乂，至營，炙而殺之。乂冤痛之聲達於左右，三軍莫不為之垂涕。時年二十八。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":144,"last_line":144,"raw_start":14342,"raw_end":14438,"raw_character_offsets":[14344,14345,14346,14347,14348,14349,14350,14351,14352,14353,14354,14355,14356,14357,14358,14359,14360,14361,14362,14363,14364,14365,14366,14367,14368,14369,14370,14371,14372,14373,14374,14375,14376,14377,14378,14379,14380,14381,14382,14383,14384,14385,14386,14387,14388,14389,14390,14391,14392,14393,14394,14395,14396,14397,14398,14399,14400,14401,14402,14403,14404,14405,14406,14407,14408,14409,14410,14411,14412,14413,14414,14415,14416,14417,14418,14419,14420,14421,14422,14423,14424,14425,14426,14427,14428,14429,14430,14431,14432,14433,14434,14435,14436,14437],"revision_id":2650517},"mentions":[{"id":"c-jinshu-059-prince-yi:p008:m0005","surface":"乂","start":5,"end":6,"person_id":"4c6_984_9ed","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-yi:p008:m0022","surface":"越","start":22,"end":23,"person_id":"9o2_vhv_r7y","kind":"p