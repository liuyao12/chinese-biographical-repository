:m0156","start":156,"end":157,"surface":"導","person_id":"7r6_k52_qji_ABAA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p001:m0175","start":175,"end":176,"surface":"導","person_id":"7r6_k52_qji_ABAA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p001:m0182","start":182,"end":184,"surface":"處仲","person_id":"7r6_k52_qji_ABBA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p001:m0201","start":201,"end":203,"surface":"潘滔","person_id":"yir_cmm_s73","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p001:m0204","start":204,"end":205,"surface":"敦","person_id":"7r6_k52_qji_ABBA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p001:m0211","start":211,"end":213,"surface":"處仲","person_id":"7r6_k52_qji_ABBA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p001:m0238","start":238,"end":240,"surface":"太子","person_id":"74e_68c_9ae","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p001:m0253","start":253,"end":254,"surface":"敦","person_id":"7r6_k52_qji_ABBA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p001:m0257","start":257,"end":259,"surface":"江統","person_id":"w1m_t92_afh","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p001:m0260","start":260,"end":262,"surface":"潘滔","person_id":"yir_cmm_s73","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p001:m0265","start":265,"end":267,"surface":"杜蕤","person_id":"t4f_ks6_8r3","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p001:m0268","start":268,"end":270,"surface":"魯瑤","person_id":"38p_mnl_5qo","kind":"person"}],"chapter_id":"c-jinshu-098-wangdun-comparison","book_id":"b-jinshu-098","work_id":"w-jinshu","source_id":"s-jinshu098-wangdun-ws2614273-comparison"},{"id":"c-jinshu-098-wangdun-comparison:p002","text":"趙王倫篡位，敦叔父彥為兗州刺史，倫遣敦慰勞之。會諸王起義兵；彥被齊王冏檄，懼倫兵強，不敢應命，敦勸彥起兵應諸王，故彥遂立勳績。惠帝反正，敦遷散騎常侍、左衛將軍、大鴻臚、侍中，出除廣武將軍、青州刺史。永嘉初，徵為中書監。于時天下大亂，敦悉以公主時侍婢百餘人配給將士，金銀寶物散之於眾，單車還洛。東海王越自滎陽來朝，敦謂所親曰：「今威權悉在太傅，而選用表情，尚書猶以舊制裁之，太傅今至，必有誅罰。」俄而越收中書令繆播等十餘人殺之。越以敦為揚州刺史，潘滔說越曰：「今樹處仲于江外，使其肆豪強之心，是見賊也。」越不從。其後徵拜尚書，不就。元帝召為安東軍諮祭酒。會揚州刺史劉陶卒，帝復以敦為揚州刺史，加廣武將軍。尋進左將軍、都督征討諸軍事、假節。帝初鎮江東，威名未著，敦與從弟導等同心翼戴，以隆中興，時人為之語曰：「王與馬，共天下。」尋與甘卓等討江州刺史華軼，斬之。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","source_position":{"first_line":13,"last_line":13,"revision_id":2614273,"raw_projection_ref":"source-evidence/jin098-wangdun-comparison/projection.json","raw_file_sha256":"019eb1b16d5b12d4fac53fe1c94cb23ef4794434faa88ce8222576f948f4ca36","unit_key":"p002","source_layer":"received_chapter"},"mentions":[{"id":"c-jinshu-098-wangdun-comparison:p002:m0000","start":0,"end":3,"surface":"趙王倫","person_id":"dkn_ge4_286_AAAAG","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p002:m0006","start":6,"end":7,"surface":"敦","person_id":"7r6_k52_qji_ABBA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p002:m0009","start":9,"end":10,"surface":"彥","person_id":"7r6_k52_qji_ABE","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p002:m0016","start":16,"end":17,"surface":"倫","person_id":"dkn_ge4_286_AAAAG","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p002:m0018","start":18,"end":19,"surface":"敦","person_id":"7r6_k52_qji_ABBA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p002:m0030","start":30,"end":31,"surface":"彥","person_id":"7r6_k52_qji_ABE","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p002:m0032","start":32,"end":35,"surface":"齊王冏","person_id":"ee0_b2a_68e","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p002:m0038","start":38,"end":39,"surface":"倫","person_id":"dkn_ge4_286_AAAAG","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p002:m0047","start":47,"end":48,"surface":"敦","person_id":"7r6_k52_qji_ABBA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p002:m0049","start":49,"end":50,"surface":"彥","person_id":"7r6_k52_qji_ABE","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p002:m0057","start":57,"end":58,"surface":"彥","person_id":"7r6_k52_qji_ABE","kind":"person"},{"id":"c-jinshu-098-wan