ce":[{"chapter_id":"c-shiji-040-chu","source_id":"s-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p002","quote":"呉回生陸終。陸終生子六人，坼剖而産焉。其長一曰昆吾；二曰參胡；三曰彭祖；四曰會人；五曰曹姓；六曰季連，羋姓，楚其後也。昆吾氏，夏之時嘗爲侯伯，桀之時湯滅之。彭祖氏，殷之時嘗爲侯伯，殷之末世滅彭祖氏。季連生附沮，附沮生穴熊。其後中微，或在中國，或在蠻夷，弗能紀其世。"}],"qualifiers":{"source_term":"陸終生子六人","historicity":"legendary_tradition"},"interpretation_note":"依本段明示生育、兄弟、母子及苗裔敘事；祖先不作直接父親，繼位不自動推父子，不補未見母名或闕代。來源主張不等於版本與史實已覆核。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji040-011","subject_person_id":"cbr-p001852","predicate":"father","object_person_id":"cbr-p001851","status":"source_attested","evidence":[{"chapter_id":"c-shiji-040-chu","source_id":"s-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p002","quote":"呉回生陸終。陸終生子六人，坼剖而産焉。其長一曰昆吾；二曰參胡；三曰彭祖；四曰會人；五曰曹姓；六曰季連，羋姓，楚其後也。昆吾氏，夏之時嘗爲侯伯，桀之時湯滅之。彭祖氏，殷之時嘗爲侯伯，殷之末世滅彭祖氏。季連生附沮，附沮生穴熊。其後中微，或在中國，或在蠻夷，弗能紀其世。"}],"qualifiers":{"source_term":"季連生附沮","historicity":"legendary_tradition"},"interpretation_note":"依本段明示生育、兄弟、母子及苗裔敘事；祖先不作直接父親，繼位不自動推父子，不補未見母名或闕代。來源主張不等於版本與史實已覆核。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji040-020","subject_person_id":"cbr-p001854","predicate":"ancestor","object_person_id":"cbr-p001851","status":"source_attested","evidence":[{"chapter_id":"c-shiji-040-chu","source_id":"s-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p003","quote":"周文王之時，季連之苗裔曰鬻熊。鬻熊子事文王，蚤卒。其子曰熊麗。熊麗生熊狂，熊狂生熊繹。熊繹當周成王之時，舉文、武勤勞之後嗣，而封熊繹於楚蠻，封以子男之田，姓羋氏，居丹陽。楚子熊繹與魯公伯禽、衞康叔子牟、晉侯燮、齊太公子呂伋倶事成王。"}],"qualifiers":{"source_term":"季連之苗裔","historicity":"legendary_tradition"},"interpretation_note":"依本段明示生育、兄弟、母子及苗裔敘事；祖先不作直接父親，繼位不自動推父子，不補未見母名或闕代。來源主張不等於版本與史實已覆核。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-040-chu:p002","text":"呉回生陸終。陸終生子六人，坼剖而産焉。其長一曰昆吾；二曰參胡；三曰彭祖；四曰會人；五曰曹姓；六曰季連，羋姓，楚其後也。昆吾氏，夏之時嘗爲侯伯，桀之時湯滅之。彭祖氏，殷之時嘗爲侯伯，殷之末世滅彭祖氏。季連生附沮，附沮生穴熊。其後中微，或在中國，或在蠻夷，弗能紀其世。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapt