expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-060","chapter_id":"c-songshu-060-wangshaozhi","source_id":"s-songshu-060-wangshaozhi-ws1996694","paragraph_id":"c-songshu-060-wangshaozhi:p002","quote":"韶之家貧，父為烏程令，因居縣境。好史籍，博涉多聞。初為衞將軍謝琰行參軍。偉之少有志尚，當世詔命表奏，輒自書寫，太元、隆安時事，小大悉撰錄之，韶之因此私撰晉安帝陽秋。既成，時人謂宜居史職，即除著作佐郎，使續後事，訖義熙九年。善敍事，辭論可觀，為後代佳史。遷尚書祠部郎。晉帝自孝武以來，常居內殿，武官主書於中通呈，以省官一人管司詔誥，任在西省，因謂之西省郎。傅亮、羊徽相代〔在職，義熙十一年，高祖以韶之博學有文詞，補通直郎，〕領西省事。轉中書侍郎。安帝之崩也，高祖使韶之與帝左右密加酖毒。恭帝即位，遷黃門侍郎，領著作郎，西省如故。凡諸詔黃，皆其辭也。","person_mention_id":"c-songshu-060-wangshaozhi:p002:m0180"}],"status":"source_attested","interpretation_note":"本句所載官名，任期無確切年月。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanshi-036-song060-yanghui:p002","text":"弟徽字敬猷，時譽多欣，位河東太守，卒。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":29,"last_line":29,"raw_start":797,"raw_end":816,"raw_character_offsets":[797,798,799,800,801,802,803,804,805,806,807,808,809,810,811,812,813,814,815],"revision_id":1489333},"mentions":[{"id":"c-nanshi-036-song060-yanghui:p002:m0001","surface":"徽","start":1,"end":2,"kind":"person","person_id":"wc5_hn7_a5w_AAAA","status":"contextual_provisional"},{"id":"c-nanshi-036-song060-yanghui:p002:m0003","surface":"敬猷","start":3,"end":5,"kind":"person","person_id":"wc5_hn7_a5w_AAAA","status":"contextual_provisional"},{"id":"c-nanshi-036-song060-yanghui:p002:m0009","surface":"欣","start":9,"end":10,"kind":"person","person_id":"qav_j5i_grm","status":"contextual_provisional"}],"chapter_id":"c-nanshi-036-song060-yanghui","book_id":"b-nanshi-036","work_id":"w-nanshi","source_id":"s-nanshi-036-s