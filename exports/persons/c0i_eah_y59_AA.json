{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"c0i_eah_y59_AA","canonical_person_id":"c0i_eah_y59_AA","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["c0i_eah_y59_AA"],"persons":[{"id":"c0i_eah_y59_A","label":"桓惠王（韓世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"桓惠王","mention_ids":["c-shiji-045-han:m031-0182","c-shiji-045-han:m032-0000","c-shiji-045-han:m033-0005"]}],"evidence":[{"mention_id":"c-shiji-045-han:m031-0182","chapter_id":"c-shiji-045-han","paragraph_id":"c-shiji-045-han:p031","quote":"桓惠王"},{"mention_id":"c-shiji-045-han:m032-0000","chapter_id":"c-shiji-045-han","paragraph_id":"c-shiji-045-han:p032","quote":"桓惠王"},{"mention_id":"c-shiji-045-han:m033-0005","chapter_id":"c-shiji-045-han","paragraph_id":"c-shiji-045-han:p033","quote":"桓惠王"}],"family_path":{"connection":"father","generation_distance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-045-han","source_id":"s-shiji-045-han","paragraph_id":"c-shiji-045-han:p031","quote":"二十三年，趙、魏攻我華陽。韓告急於秦，秦不救。韓相國謂陳筮曰：「事急，願公雖病，爲一宿之行。」陳筮見穰侯。穰侯曰：「事急乎？故使公來。」陳筮曰：「未急也。」穰侯怒曰：「是可以爲公之主使乎？夫冠蓋相望，告敝邑甚急，公來言未急，何也？」陳筮曰：「彼韓急則將變而佗從，以未急，故復來耳。」穰侯曰：「公無見王，請今發兵救韓。」八日而至，敗趙、魏於華陽之下。是歳，釐王卒，子桓惠王立。","source_term":"釐王卒，子桓惠王立"}],"source_assertion_id":"a-shiji045-017","interpretation_note":"以此受傳正文的明示近親主張配置局部家族；不合併跨篇候選身份、不補闕名世代，不表示遠祖世系已核實。分支字元不是長幼排行。","reviewer":"Codex（AI 代理）","parent_person_id":"c0i_eah_y59"}},{"id":"c0i_eah_y59_AA","label":"韓王安","status":"active","historicity":"historical_tradition","aliases":[{"surface":"韓王安","mention_ids":["c-shiji-006-shihuang:m014-0072","c-shiji-034-yan:m032-0251"]},{"surface":"王安","mention_ids":["c-shiji-045-han:m033-0011","c-shiji-045-han:m034-0000","c-shiji-045-han:m035-0005"]},{"surface":"韓王","mention_ids":["c-shiji-086-cike:m029-0161"]}],"evidence":[{"mention_id":"c-shiji-006-shihuang:m014-0072","chapter_id":"c-shiji-006-shihuang","paragraph_id":"c-shiji-006