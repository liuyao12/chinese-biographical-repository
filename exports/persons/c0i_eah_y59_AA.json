ences":[{"id":"shiji-015-r239-c04-m000","start":0,"end":3,"surface":"韓王安","person_id":"c0i_eah_y59_AA","status":"contextual_provisional","interpretation_note":"依國別、紀年及原格上下文暫定；保留異文，不據同名自動合併。","table_id":"shiji-015","table_fragment_id":"shiji-015-digital-table-1","table_row_id":"shiji-015-r239","table_cell_id":"shiji-015-r239-c04","work_id":"w-shiji","book_id":"b-shiji-015","chapter_id":"table-chapter-shiji-015","source_id":"table-witness-shiji-015","source_revision":"2607002","kind":"table_person_mention","quote":"韓王安元年"},{"id":"shiji-015-r247-c01-m008","start":8,"end":11,"surface":"韓王安","person_id":"c0i_eah_y59_AA","status":"contextual_provisional","interpretation_note":"依國別、紀年及原格上下文暫定；保留異文，不據同名自動合併。","table_id":"shiji-015","table_fragment_id":"shiji-015-digital-table-1","table_row_id":"shiji-015-r247","table_cell_id":"shiji-015-r247-c01","work_id":"w-shiji","book_id":"b-shiji-015","chapter_id":"table-chapter-shiji-015","source_id":"table-witness-shiji-015","source_revision":"2607002","kind":"table_person_mention","quote":"十七。內史騰擊得韓王安，盡取其地，置潁川郡。華陽太后薨。"},{"id":"shiji-015-r247-c04-m004","start":4,"end":6,"surface":"王安","person_id":"c0i_eah_y59_AA","status":"contextual_provisional","interpretation_note":"依國別、紀年及原格上下文暫定；保留異文，不據同名自動合併。","table_id":"shiji-015","table_fragment_id":"shiji-015-digital-table-1","table_row_id":"shiji-015-r247","table_cell_id":"shiji-015-r247-c04","work_id":"w-shiji","book_id":"b-shiji-015","chapter_id":"table-chapter-shiji-015","source_id":"table-witness-shiji-015","source_revision":"2607002","kind":"table_person_mention","quote":"九。秦虜王安，秦滅韓。"}],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji034-043","person_id":"c0i_eah_y59_AA","surfaces":["韓王安"],"scope":"cross_chapter","chapter_ids":["c-shiji-006-shihuang","c-shiji-034-yan"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-006-shihuang:p014","quote":"十五年，大興兵，一軍至鄴，一軍至太原，取狼孟。地動。十六年九月，發卒受地韓南陽假守騰。初令男子書年。魏獻地於秦。秦置麗邑。十七年，內史騰攻韓，得韓王安，盡納其地，以其地為郡，命曰潁川。地動。華陽太后卒。民大饑。"},{"paragraph_id":"c-shiji-034-yan:p032","quote":"六年，秦滅東（西）周，置三川郡。七年，秦拔趙楡次三十七城，秦置大原郡。九年，秦王政初卽位。十年，趙使廉頗將攻繁陽，拔之。趙孝成王卒，悼襄王立。使樂乘代廉頗，廉頗不聽，攻樂乘，樂乘走，廉頗奔大梁。十二年，趙使李牧攻燕，拔武遂、方城。劇辛故居趙，與龐煖善，已而亡走燕。燕見趙數困于秦，而廉頗去，令龐煖將也，欲因趙獘攻之。問劇辛，辛曰：「龐煖易與耳。」燕使劇辛將撃趙，趙使龐煖撃之，取燕軍二萬，殺劇辛。秦拔魏二十城，置東郡。十九年，秦拔趙之鄴九城。趙悼襄王卒。二十三年，太子丹質於秦，亡歸燕。二十五年，秦虜滅韓王安，置潁川郡。二十七年，秦虜趙王遷，滅趙。趙公子嘉自立爲代王。"}],"rationale":"依周初封建、燕君世系、割地救燕、讓國及秦滅諸國的具體語境暫定異稱。繼位不自動證父子；同爵者分國別與前後世代。太子平／燕昭王依本篇明示，不表示年代及世系已校定。作君奭為書名，君奭不説之君奭才暫解召公稱呼。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji045-083","person_id":"c0i_eah_y59_AA","surfaces":["王安"],"scope":"same_chapter","chapter_ids":["c-shiji-045-han"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-045-han:p033","quote":"三十四年，桓惠王卒，子王安立。"},{"paragraph_id":"c-shiji-045-han:p034","quote":"王安五年，秦攻韓，韓急，使韓非使秦，秦留非，因殺之。"},{"paragraph_id":"c-shiji-045-han:p035","quote":"九年，秦虜王安，盡入其地，爲潁州郡。韓遂亡。"}],"rationale":"限本篇明示姓名、號稱、是為與連續敘事；兩位韓武子、韓趙簡子、韓魏文侯及不同時段未名楚王分開。原字及韓姬弒悼公、蟣蝨等疑點不訂正；裸王與回敘指代留待核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji086-042","person_id":"c0i_eah_y59_AA","scope":"same_chapter","chapter_ids":["c-shiji-086-cike"],"status":"contextual_provisional","rationale":"依荊軻入燕敘事及明示異稱暫接；慶卿、荊卿指荊軻，田光之光限第28至29段，丹限太子丹敘事。魯句踐不與其他句踐合併；狗屠、主人及被虜韓趙王保留未名。嵌套代詞仍待逐處核定。","reviewer":"Codex（AI 代理）","surfaces":["韓王"],"evidence":[{"paragraph_id":"c-shiji-086-cike:p029","quote":"荊軻遂見太子，言田光已死，致光之言。太子再拜而跪，膝行流涕，有頃而後言曰：「丹所以誡田先生毋言者，欲以成大事之謀也。今田先生以死明不言，豈丹之心哉！」荊軻坐定，太子避席頓首曰：「田先生不知丹之不肖，使得至前，敢有所道，此天之所以哀燕而不棄其孤也。今秦有貪利之心，而欲不可足也。非盡天下之地，臣海内之王者，其意不厭。今秦已虜韓王，盡納其地。又舉兵南伐楚，北臨趙；王翦將數十萬之衆距漳、鄴，而李信出太原、雲中。趙不能支秦，必入臣，入臣則禍至燕。燕小弱，數困於兵，今計舉國不足以當秦。諸侯服秦，莫敢合從。丹之私計愚，以爲誠得天下之勇士使於秦，闚以重利；秦王貪，其勢必得所願矣。誠得劫秦王，使悉反諸侯侵地，若曹沫之與齊桓公，則大善矣；則不可，因而刺殺之。彼秦大將擅兵於外而内有亂，則君臣相疑，以其閒諸侯得合從，其破秦必矣。此丹之上願，而不知所委命，唯荊卿留意焉。」久之，荊軻曰：「此國之大事也，臣駑下，恐不足任使。」太子前頓首，固請毋讓，然後許諾。於是尊荊卿爲上卿，舍上舍。太子日造門下，供太牢具，異物閒進，車騎美女恣荊軻所欲，以順適其意。"}]}],"equivalence_decisions":[{"id":"eq-shiji086-han-an","person_ids":["c0i_eah_y59_AA"],"canonical_person_id":"c0i_eah_y59_AA","scope":"cross_chapter","chapter_ids":["c-shiji-045-han","c-shiji-006-shihuang"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-045-han","source_id":"s-shiji-045-han","paragraph_id":"c-shiji-045-han:p035","quote":"九年，秦虜王安，盡入其地，爲潁州郡。韓遂亡。","mention_ids":["c-shiji-045-han:m035-0005"]},{"chapter_id":"c-shiji-006-shihuang","source_id":"s-shiji-006-shihuang","paragraph_id":"c-shiji-006-shihuang:p014","quote":"十五年，大興兵，一軍至鄴，一軍至太原，取狼孟。地動。十六年九月，發卒受地韓南陽假守騰。初令男子書年。魏獻地於秦。秦置麗邑。十七年，內史騰攻韓，得韓王安，盡納其地，以其地為郡，命曰潁川。地動。華陽太后卒。民大饑。","mention_ids":["c-shiji-006-shihuang:m014-0072"]}],"rationale":"秦得韓王安而盡納其地的同一亡國敘事相配；潁州／潁川原字分存。同書互見不是獨立見證，不確認全部敘事或年代，不跨其他候選批量改號。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true},{"id":"eq-shiji086-han","person_ids":["c0i_eah_y59_AA"],"canonical_person_id":"c0i_eah_y59_AA","scope":"cross_chapter","chapter_ids":["c-shiji-045-han","c-shiji-086-cike"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-045-han","source_id":"s-shiji-045-han","paragraph_id":"c-shiji-045-han:p035","quote":"九年，秦虜王安，盡入其地，爲潁州郡。韓遂亡。","mention_ids":["c-shiji-045-han:m035-0005"]},{"chapter_id":"c-shiji-086-cike","source_id":"s-shiji-086-cike","paragraph_id":"c-shiji-086-cike:p029","quote":"荊軻遂見太子，言田光已死，致光之言。太子再拜而跪，膝行流涕，有頃而後言曰：「丹所以誡田先生毋言者，欲以成大事之謀也。今田先生以死明不言，豈丹之心哉！」荊軻坐定，太子避席頓首曰：「田先生不知丹之不肖，使得至前，敢有所道，此天之所以哀燕而不棄其孤也。今秦有貪利之心，而欲不可足也。非盡天下之地，臣海内之王者，其意不厭。今秦已虜韓王，盡納其地。又舉兵南伐楚，北臨趙；王翦將數十萬之衆距漳、鄴，而李信出太原、雲中。趙不能支秦，必入臣，入臣則禍至燕。燕小弱，數困於兵，今計舉國不足以當秦。諸侯服秦，莫敢合從。丹之私計愚，以爲誠得天下之勇士使於秦，闚以重利；秦王貪，其勢必得所願矣。誠得劫秦王，使悉反諸侯侵地，若曹沫之與齊桓公，則大善矣；則不可，因而刺殺之。彼秦大將擅兵於外而内有亂，則君臣相疑，以其閒諸侯得合從，其破秦必矣。此丹之上願，而不知所委命，唯荊卿留意焉。」久之，荊軻曰：「此國之大事也，臣駑下，恐不足任使。」太子前頓首，固請毋讓，然後許諾。於是尊荊卿爲上卿，舍上舍。太子日造門下，供太牢具，異物閒進，車騎美女恣荊軻所欲，以順適其意。","mention_ids":["c-shiji-086-cike:m029-0161"]}],"rationale":"秦虜韓王並盡納韓地、其後將兵臨趙燕的特定亡國背景相配；郡名原字潁州不改。同書互見不是獨立見證，不確認全部敘事或年代，不跨其他候選批量改號。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true}],"passages":[{"id":"c-shiji-006-shihuang:p014"