"person","person_id":"c0i_eah_y59_A","status":"contextual_provisional"},{"id":"c-shiji-045-han:m033-0011","start":11,"end":13,"surface":"王安","kind":"person","person_id":"c0i_eah_y59_AA","status":"contextual_provisional"}],"chapter_id":"c-shiji-045-han","book_id":"b-shiji-045","work_id":"w-shiji","source_id":"s-shiji-045-han"},{"id":"c-shiji-045-han:p034","text":"王安五年，秦攻韓，韓急，使韓非使秦，秦留非，因殺之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-045-han:m034-0000","start":0,"end":2,"surface":"王安","kind":"person","person_id":"c0i_eah_y59_AA","status":"contextual_provisional"},{"id":"c-shiji-045-han:m034-0013","start":13,"end":15,"surface":"韓非","kind":"person","person_id":"rhm_9nf_9q6","status":"contextual_provisional"},{"id":"c-shiji-045-han:m034-0020","start":20,"end":21,"surface":"非","kind":"person","person_id":"rhm_9nf_9q6","status":"contextual_provisional"}],"chapter_id":"c-shiji-045-han","book_id":"b-shiji-045","work_id":"w-shiji","source_id":"s-shiji-045-han"},{"id":"c-shiji-045-han:p035","text":"九年，秦虜王安，盡入其地，爲潁州郡。韓遂亡。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-045-han:m035-0005","start":5,"end":7,"surface":"王安","kind":"person","person_id":"c0i_eah_y59_AA","status":"contextual_provisional"}],"chapter_id":"c-shiji-045-han","book_id":"b-shiji-045","work_id":"w-shiji","source_id":"s-shiji-045-han"},{"id":"c-shiji-086-cike:p029","text":"荊軻遂見太子，言田光已死，致光之言。太子再拜而跪，膝行流涕，有頃而後言曰：「丹所以誡田先生毋言者，欲以成大事之謀也。今田先生以死明不言，豈丹之心哉！」荊軻坐定，太子避席頓首曰：「田先生不知丹之不肖，使得至前，敢有所道，此天之所以哀燕而不棄其孤也。今秦有貪利之心，而欲不可足也。非盡天下之地，臣海内之王者，其意不厭。今秦已虜韓王，盡納其地。又舉兵南伐楚，北臨趙；王翦將數十萬之衆距漳、鄴，而李信出太原、雲中。趙不能支秦，必入臣，入臣則禍至燕。燕小弱，數困於兵，今計舉國不足以當秦。諸侯服秦，莫敢合從。丹之私計愚，以爲誠得天下之勇士使於秦，闚以重利；秦王貪，其勢必得所願矣。誠得劫秦王，使悉反諸侯侵地，若曹沫之與齊桓公，則大善矣；則不可，因而刺殺之。彼秦大將擅兵於外而内有亂，則君臣相疑，以其閒諸侯得合從，其破秦必矣。此丹之上願，而不知所委命，唯荊卿留意焉。」久之，荊軻曰：「此國之大事也，臣駑下，恐不足任使。」太子前頓首，固請毋讓，然後許諾。於是尊荊卿爲上卿，舍上舍。太子日造門下，供太牢具，異物閒進，車騎美女恣荊軻所欲，以順適其意。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-086-cike:m029-0000","start":0,"end":2,"surface":"荊軻","kind":"person","person_id":"b83_37f_n0v","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m029-0004","start":4,"end":6,"surface":"太子","kind":"person","person_id":"e3o_2bk_lhm","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m029-0008","start":8,"end":10,"surface":"田光","kind":"person","person_id":"z0v_ish_b9u","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m029-0014","start":14,"end":15,"surface":"光","kind":"person","person_id":"z0v_ish_b9u","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m029-0018","start":18,"end":20,"surface":"太子","kind":"person","person_id":"e3o_2bk_lhm","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m029-0038","start":38,"end":39,"surface":"丹","kind":"person","person_id":"e3o_2bk_lhm","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m029-0042","start":42,"end":45,"surface":"田先生","kind":"person","person_id":"z0v_ish_b9u","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m029-0059","start":59,"end":62,"surface":"田先生","kind":"person","person_id":"z0v_ish_b9u","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m029-0069","start":69,"end":70,"surface":"丹","kind":"person","person_id":"e3o_2bk_lhm","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m029-0075","start":75,"end":77,"surface":"荊軻","kind":"person","person_id":"b83_37f_n0v","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m029-0080","start":80,"end":82,"surface":"太子","kind":"person","person_id":"e3o_2bk_lhm","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m029-0089","start":89,"end":92,"surface":"田先生","kind":"person","person_id":"z0v_ish_b9u","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m029-0094","start":94,"end":95,"surface":"丹","kind":"person","person_id":"e3o_2bk_lhm","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m029-0146","start":146,"end":151,"su