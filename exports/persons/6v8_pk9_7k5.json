nship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"person_id":"6v8_pk9_7k5","title":"大將軍","surname":"溫","ming":"嶠","additional_names":[],"work_id":"w-jinshu","book_id":"b-jinshu-076","chapter_id":"c-jinshu-076-wangyi-family","source_id":"s-jinshu-076-wangyi-family","paragraph_id":"c-jinshu-076-wangyi-family:p003","quote":"及王敦構禍，帝遣廙喻敦，既不能諫其悖逆，乃為敦所留，受任助亂。敦得志，以廙為平南將領護南蠻校尉、荊州刺史。尋病卒。帝猶以親故，深痛湣之。喪還京都，皇太子親臨拜柩，如家人之禮。贈侍中、驃騎將軍，諡曰康。明帝與大將軍溫嶠書曰：「痛謝鯤未絕於口，世將復至於此。並盛年雋才，不遂其志，痛切於心。廙明古多通，鯤遠有識致。其言雖未足令人改聽，然味之不倦，近未易有也。坐相視盡，如何！」","note":"姓名、字與稱號分存；未名者不補。辨認用稱不等於每個敘事時點已任，對讀原句與固定修訂另外保留。","status":"editorial_provisional","human_reviewed":false,"model":null,"zi":"太真","references":[{"title":"《晉書》卷67溫嶠傳首","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7067&oldid=2592755","source_revision":2592755,"source_position":{"first_line":12,"last_line":12},"quote":"溫嶠，字太真","scope":"primary_parallel_explicit_courtesy_name","image_verified":false}]}],"mentions":[{"id":"c-jinshu-065-wangdao-family:p002:m0019","start":19,"end":22,"surface":"溫太真","kind":"person","person_id":"6v8_pk9_7k5","status":"contextual_provisional","paragraph_id":"c-jinshu-065-wangdao-family:p002","chapter_id":"c-jinshu-065-wangdao-family"},{"id":"c-jinshu-076-wangyi-family:p003:m0106","start":106,"end":108,"surface":"溫嶠","kind":"person","person_id":"6v8_pk9_7k5","status":"contextual_provisional","paragraph_id":"c-jinshu-076-wangyi-family:p003","chapter_id":"c-jinshu-076-wangyi-family"}],"relations":[],"title_holdings":[{"id":"th-jinshu076-wang-025","person_id":"6v8_pk9_7k5","title":"大將軍","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-076","chapter_id":"c-jinshu-076-wangyi-family","source