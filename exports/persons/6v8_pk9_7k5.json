_id":"c-jinshu-065-wangdao-family:p002","quote":"二弟：穎、敞，少與導俱知名，時人以穎方溫太真，以敞比鄧伯道，並早卒。導六子：悅、恬、洽、協、邵、薈。"}],"rationale":"卷76受明帝書的大將軍溫嶠與卷65比擬溫太真，據固定卷67明文溫嶠字太真接同人，原溫太真提及與錨點保留。","human_reviewed":false,"model":null,"references":[{"title":"《晉書》卷67傳首","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7067&oldid=2592755","source_revision":2592755,"source_position":{"first_line":12,"last_line":12},"quote":"溫嶠，字太真","scope":"primary_parallel_explicit_courtesy_name","image_verified":false}]}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-065-wangdao-family:p002","text":"二弟：穎、敞，少與導俱知名，時人以穎方溫太真，以敞比鄧伯道，並早卒。導六子：悅、恬、洽、協、邵、薈。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-065-wangdao-family:p002:m0003","start":3,"end":4,"surface":"穎","kind":"person","person_id":"7r6_k52_qji_ABAB","status":"contextual_provisional"},{"id":"c-jinshu-065-wangdao-family:p002:m0005","start":5,"end":6,"surface":"敞","kind":"person","person_id":"7r6_k52_qji_ABAC","status":"contextual_provisional"},{"id":"c-jinshu-065-wangdao-family:p002:m0009","start":9,"end":10,"surface":"導","kind":"person","person_id":"7r6_k52_qji_ABAA","status":"contextual_provisional"},{"id":"c-jinshu-065-wangdao-family:p002:m0017","start":17,"end":18,"surface":"穎","kind":"person","person_id":"7r6_k52_qji_ABAB","status":"contextual_provisional"},{"id":"c-jinshu-065-wangdao-family:p002:m0019","start":19,"end":22,"surface":"溫太真","kind":"person","person_id":"6v8_pk9_7k5","status":"contextual_provisional"},{"id":"c-jinshu-065-wangdao-family:p002:m0024","start":24,"end":25,"surface":"敞","kind":"person","person_id":"7r6_k52_qji_ABAC","status":"contextual_provisional"},{"id":"c-jinshu-065-wangdao-family:p002:m0026","start":26,"end":29,"surface":"鄧伯道","kind":"person","person_id":"o5p_xll_ql8","status":"contextual_provisional"},{"id":"c-jinshu-065-wangdao-family:p002:m0034","start":34,"end":35,"surface":"導","kind":"person","person_id":"7r6_k52_qji_ABAA","status":"co