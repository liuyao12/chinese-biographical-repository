{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"3ig_qln_usl","canonical_person_id":"3ig_qln_usl","id_aliases":["cbr-p004926"],"identity_policy":"contextual_provisional","person_ids":["3ig_qln_usl"],"persons":[{"id":"3ig_qln_usl","label":"伍子胥引古（李斯列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"伍子胥","mention_ids":["c-shiji-087-lisi:m030-0063"]}],"evidence":[{"mention_id":"c-shiji-087-lisi:m030-0063","chapter_id":"c-shiji-087-lisi","paragraph_id":"c-shiji-087-lisi:p030","quote":"伍子胥"}],"id_aliases":["cbr-p004926"]}],"source_mention_summary":[{"source_id":"s-shiji-087-lisi","work_id":"w-shiji","book_id":"b-shiji-087","chapter_id":"c-shiji-087-lisi","mention_count":1,"mention_ids":["c-shiji-087-lisi:m030-0063"],"paragraph_ids":["c-shiji-087-lisi:p030"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-087-lisi"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-087-lisi:m030-0063","start":63,"end":66,"surface":"伍子胥","kind":"person","person_id":"3ig_qln_usl","status":"contextual_provisional","paragraph_id":"c-shiji-087-lisi:p030","chapter_id":"c-shiji-087-lisi"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji087-059","person_id":"3ig_qln_usl","scope":"same_chapter","chapter_ids":["c-shiji-087-lisi"],"status":"contextual_provisional","rationale":"依李斯下獄及秦末局部承接暫接；始皇弟暫依下一段子嬰既位承接，本篇世系主張保留待跨篇覆核。其子與妻子仍待核指，不補父子或配偶；中子、太卜、行人保留未名。韓玘原字保留，宰予與簡公引古不以同名確證全部事實。趙高短稱高限後段敘事，官稱及嵌套指代待核。","reviewer":"Codex（AI 代理）","surfaces":["伍子胥"],"evidence":[{"paragraph_id":"c-shiji-087-lisi:p030","quote":"趙高案治李斯。李斯拘執束縛，居囹圄中，仰天而歎曰：「嗟乎，悲夫！不道之君，何可為計哉！昔者桀殺關龍逢，紂殺王子比干，吳王夫差殺伍子胥。此三臣者，豈不忠哉，然而不免於死，身死而所忠者非也。今吾智不及三子，而二世之無道過於桀、紂、夫差，吾以忠死，宜矣。且二世之治豈不亂哉！日者夷其兄弟而自立也，殺忠臣而貴賤人，作為阿房之宮，賦斂天下。吾非不諫也，而不吾聽也。凡古聖王，飲食有節，車器有數，宮室有度，出令造事，加費而無益於民利者禁，故能長久治安。今行逆於昆弟，不顧其咎；侵殺忠臣，不思其殃；大為宮室，厚賦天下，不愛其費：三者已行，天下不聽。今反者已有天下之半矣，而心尚未寤也，而以趙高為佐，吾必見寇至咸陽，麋鹿游於朝也。」"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-087-lisi:p030","text":"趙高案治李斯。李斯拘執束縛，居囹圄中，仰天而歎曰：「嗟乎，悲夫！不道之君，何可為計哉！昔者桀殺關龍逢，紂殺王子比干，吳王夫差殺伍子胥。此三臣者，豈不忠哉，然而不免於死，身死而所忠者非也。今吾智不及三子，而二世之無道過於桀、紂、夫差，吾以忠死，宜矣。且二世之治豈不亂哉！日者夷其兄弟而自立也，殺忠臣而貴賤人，作為阿房之宮，賦斂天下。吾非不諫也，而不吾聽也。凡古聖王，飲食有節，車器有數，宮室有度，出令造事，加費而無益於民利者禁，故能長久治安。今行逆於昆弟，不顧其咎；侵殺忠臣，不思其殃；大為宮室，厚賦天下，不愛其費：三者已行，天下不聽。今反者已有天下之半矣，而心尚未寤也，而以趙高為佐，吾必見寇至咸陽，麋鹿游於朝也。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-087-lisi:m030-0000","start":0,"end":2,"surface":"趙高","kind":"person","person_id":"4ai_d4s_gde","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m030-0004","start":4,"end":6,"surface":"李斯","kind":"person","person_id":"5ok_joj_etv","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m030-0007","start":7,"end":9,"surface":"李斯","kind":"person","person_id":"5ok_joj_etv","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m030-0045","start":45,"end":46,"surface":"桀","kind":"person","person_id":"mwj_zlb_yqk","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m030-0047","start":47,"end":50,"surface":"關龍逢","kind":"person","person_id":"iml_mgn_ycw","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m030-0051","start":51,"end":52,"surface":"紂","kind":"person","person_id":"zxi_coo_7up","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m030-0053","start":53,"end":57,"surface":"王子比干","kind":"person","person_id":"7q0_00l_ra0","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m030-0058","start":58,"