":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jinshu067-xijian-016","subject_person_id":"6lr_zci_i0j","predicate":"paternal_uncle","object_person_id":"jlw_330_62b","status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-067","source_id":"s-jinshu-067-ws2592755-xijian-excerpts","chapter_id":"c-jinshu-067-xijian-family","paragraph_id":"c-jinshu-067-xijian-family:p008","quote":"隆以兄子鑒為趙王掾，諸子悉在京洛。","subject_person_mention_id":"c-jinshu-067-xijian-family:p008:m0001","object_person_mention_id":"c-jinshu-067-xijian-family:p008:m0000"}],"qualifiers":{"source_term":"兄子"},"interpretation_note":"卷首附傳標題明列「叔父隆」，以郗鑒為關係指向；不據此補郗隆之父或兄弟的具名身份。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-jin059-jiong-xilong","person_id":"jlw_330_62b","event_type":"death","source_term":"王邃斬之","source_anchor":{"paragraph_id":"c-jinshu-059-jiong:p002","start":156,"end":160,"surface":"王邃斬之"},"date_expression":null,"status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-059","source_id":"s-jinshu-059-ws2650517-jiong","chapter_id":"c-jinshu-059-jiong","paragraph_id":"c-jinshu-059-jiong:p002","quote":"冏因眾心怨望，潛與離狐王盛、潁川王處穆謀起兵誅倫。倫遣腹心張烏覘之，烏反，曰：「齊無異志。」冏既有成謀未發，恐或泄，乃與軍司管襲殺處穆，送首於倫，以安其意。謀定，乃收襲殺之。遂與豫州刺史何勖、龍驤將軍董艾等起軍，遣使告成都、河間、常山、新野四王，移檄天下征鎮、州郡縣國，咸使聞知。揚州刺史郗隆承檄，猶豫未決，參軍王邃斬之，送首於冏。冏屯軍陽翟，倫遣其將閭和、張泓、孫輔出堮阪，與冏交戰。冏軍失利，堅壘自守。會成都軍破倫眾于黃橋，冏乃出軍攻和等，大破之。及王輿廢倫，惠帝反正，冏誅討賊党既畢，率眾入洛，頓軍通章署，甲士數十萬，旌旗器械之盛，震於京都。天子就拜大司馬，加九錫之命，備物典策，如宣、景、文、武輔魏故事。","person_mention_id":"c-jinshu-059-jiong:p002:m0035"}],"interpretation_note":"僅本篇明載死亡；不以沒于作死亡，不從報齡倒生年。無可綁年者留null。","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-jinshu-059-jiong:p002:m0035","start":144,"end":146,"surface":"郗隆","kind":"person","person_id":"jlw_330_62b","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。","paragraph_id":"c-jinshu-059-jiong:p002","chapter_id":"c-jinshu-059-jiong"},{"id":"c-jinshu-067-xijian-family:p008:m0000","start":0,"end":1,"surface":"隆","kind":"person","person_id":"jlw_330_62b","status":"source_explicit","resolution_note":"依本段《晉書》卷六十七郗鑒及附傳上下文辨識；只標具名人物。","paragraph_id":"c-jinshu-067-xijian-family:p008","chapter_id":"c-jinshu-067-xijian-family"},{"id":"c-jinshu-067-xijian-family:p009:m0005","start":19,"end":20,"surface":"隆","kind":"person","person_id":"jlw_330_62b","status":"source_explicit","resolution_note":"固定數位見證原卷首題，人物用稱只依題內親屬括注標記。","paragraph_id":"c-jinshu-067-xijian-family:p009","chapter_id":"c-jinshu-067-xijian-family"}],"relations":[{"id":"a-jinshu067-xijian-016","subject_person_id":"6lr_zci_i0j","predicate":"paternal_uncle","object_person_id":"jlw_330_62b","status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-067","source_id":"s-jinshu-067-ws2592755-xijian-excerpts","chapter_id":"c-jinshu-067-xijian-family","paragraph_id":"c-jinshu-067-xijian-family:p008","quote":"隆以兄子鑒為趙王掾，諸子悉在京洛。","subject_person_mention_id":"c-jinshu-067-xijian-family:p008:m0001","object_person_mention_id":"c-jinshu-067-xijian-family:p008:m0000"}],"qualifiers":{"source_term":"兄子"},"interpretation_note":"卷首附傳標題明列「叔父隆」，以郗鑒為關係指向；不據此補郗隆之父或兄弟的具名身份。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-059-jiong:p002","text":"冏因眾心怨望，潛與離狐王盛、潁川王處穆謀起兵誅倫。倫遣腹心張烏覘之，烏反，曰：「齊無異志。」冏既有成謀未發，恐或泄，乃與軍司管襲殺處穆，送首於倫，以安其意。謀定，乃收襲殺之。遂與豫州刺史何勖、龍驤將軍董艾等起軍，遣使告成都、河間、常山、新野四王，移檄天下征鎮、州郡縣國，咸使聞知。揚州刺史郗隆承檄，猶豫未決，參軍王邃斬之，送首於冏。冏屯軍陽翟，倫遣其將閭和、張泓、孫輔出堮阪，與冏交戰。冏軍失利，堅壘自守。會成都軍破倫眾于黃橋，冏乃出軍攻和等，大破之。及王輿廢倫，惠帝反正，冏誅討賊党既畢，率眾入洛，頓軍通章署，甲士數十萬，旌旗器械之盛，震於京都。天子就拜大司馬，加九錫之命，備物典策，如宣、景、文、武輔魏故事。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-059-jiong:p002:m0015","start":0,"end":1,"surface":"冏","kind":"person","person_id":"ee0_b2a_68e","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p002:m0016","start":11,"end":13,"surface":"王盛","kind":"person","person_id":"lwd_93l_vo3","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p002:m0017","start":16,"end":19,"surface":"王處穆","kind":"person","person_id":"414_jrh_fj0","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p002:m0018","start":23,"end":24,"surface":"倫","kind":"person","person_id":"dkn_ge4_286_AAAAG","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p002:m0019","start":25,"end":26,"surface":"倫","kind":"person","person_id":"dkn_ge4_286_AAAAG","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p002:m0020","start":29,"end":31,"surface":"張烏","kind":"person","person_id":"1gn_92g_8z7","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p002:m0021","start":34,"end":35,"surface":"烏","kind":"person","person_id":"1gn_92g_8z7","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p002:m0022","start":40,"end":41,"surface":"齊","kind":"person","person_id":"ee0_b2a_68e","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p002:m0023","start":46,"end":47,"surface":"冏","kind":"person","person_id":"ee0_b2a_68e","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jins