_order_constraints":[],"identity_decisions":[{"id":"d-shiji103-018","person_id":"x8r_9sk_d7a","surfaces":["兒寬"],"scope":"same_chapter","chapter_ids":["c-shiji-103-wanshi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-103-wanshi:p011","quote":"元鼎五年秋，丞相有罪，罷。制詔御史：「萬石君先帝尊之，子孫孝，其以御史大夫慶爲丞相，封爲牧丘侯。」是時漢方南誅兩越，東撃朝鮮，北逐匈奴，西伐大宛，中國多事。天子巡狩海内，修上古神祠，封禪，興禮樂。公家用少，桑弘羊等致利，王温舒之屬峻法，兒寬等推文學至九卿，更進用事，事不關決於丞相，丞相醇謹而已。在位九歳，無能有所匡言。嘗欲請治上近臣所忠、九卿咸宣罪，不能服，反受其過，贖罪。"}],"rationale":"依本篇姓名、稱號、名歐及名仁等明示與敘事承接判讀；來源原字保留，未自動跨篇同名合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji103-further-003","person_ids":["x8r_9sk_d7a"],"canonical_person_id":"x8r_9sk_d7a","scope":"cross_chapter","chapter_ids":["c-shiji-103-wanshi","c-shiji-121-rulin"],"status":"contextual_provisional","evidence":[{"work_id":"w-shiji","book_id":"b-shiji-103","chapter_id":"c-shiji-103-wanshi","source_id":"s-shiji-103-wanshi","paragraph_id":"c-shiji-103-wanshi:p011","quote":"元鼎五年秋，丞相有罪，罷。制詔御史：「萬石君先帝尊之，子孫孝，其以御史大夫慶爲丞相，封爲牧丘侯。」是時漢方南誅兩越，東撃朝鮮，北逐匈奴，西伐大宛，中國多事。天子巡狩海内，修上古神祠，封禪，興禮樂。公家用少，桑弘羊等致利，王温舒之屬峻法，兒寬等推文學至九卿，更進用事，事不關決於丞相，丞相醇謹而已。在位九歳，無能有所匡言。嘗欲請治上近臣所忠、九卿咸宣罪，不能服，反受其過，贖罪。","mention_ids":["c-shiji-103-wanshi:m011-0118"]},{"work_id":"w-shiji","book_id":"b-shiji-121","chapter_id":"c-shiji-121-rulin","source_id":"s-shiji121-rulin","paragraph_id":"c-shiji-121-rulin:p015","quote":"伏生教濟南張生及歐陽生，歐陽生教千乘兒寬。兒寬既通尚書，以文學應郡舉，詣博士受業，受業孔安國。兒寬貧無資用，常為弟子都養，及時時閒行傭賃，以給衣食。行常帶經，止息則誦習之。以試第次，補廷尉史。是時張湯方鄉學，以為奏讞掾，以古法議決疑大獄，而愛幸寬。寬為人溫良，有廉智，自持，而善著書、書奏，敏於文，口不能發明也。湯以為長者，數稱譽之。及湯為御史大夫，以兒寬為掾，薦之天子。天子見問，說之。張湯死后六年，兒寬位至御史大夫。九年而以官卒。寬在三公位，以和良承意從容得久，然無有所匡諫；於官，官屬易之，不為盡力。張生亦為博士。而伏生孫以治尚書徵，不能明也。","mention_ids":["c-shiji-121-rulin:m015-0018","c-shiji-121-rulin:m015-0021","c-shiji-121-rulin:m015-0047","c-shiji-121-rulin:m015-0122","c-shiji-121-rulin:m015-0124","c-shiji-121-rulin:m015-0176","c-shiji-121-rulin:m015-0201","c-shiji-121-rulin:m015-0217"]}],"rationale":"兒寬文學入仕至御史大夫與同朝九卿敘事，需再核年份先後。 限所列敘事與官職，不以相同名字全域配對；本篇是時綜述不設定所有人物同年任官，不補年月或新親屬。未核書影。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true}],"passages":[{"id":"c-shiji-103-wanshi:p011","text":"元鼎五年秋，丞相有罪，罷。制詔御史：「萬石君先帝尊之，子孫孝，其以御史大夫慶爲丞相，封爲牧丘侯。」是時漢方南誅兩越，東撃朝鮮，北逐匈奴，西伐大宛，中國多事。天子巡狩海内，修上古神祠，封禪，興禮樂。公家用少，桑弘羊等致利，王温舒之屬峻法，兒寬等推文學至九卿，更進用事，事不關決於丞相，丞相醇謹而已。在位九歳，無能有所匡言。嘗欲請治上近臣所忠、九卿咸宣罪，不能服，反受其過，贖罪。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-103-wanshi:m011-0006","start":6,"end":8,"surface":"丞相","kind":"person","person_id":"z6g_h69_eva","status":"contextual_provisional"},{"id":"c-shiji-103-wanshi:m011-0019","start":19,"end":22,"surface":"萬石君","kind":"person","person_id":"esh_e0a_jrw_A","status":"contextual_provisional"},{"id":"c-shiji-103-wanshi:m011-0022","start":22,"end":24,"surface":"先帝","kind":"person","person_id":"yqp_nlb_p1p_ACA","status":"contextual_provisional"},{"id":"c-shiji-103-wanshi:m011-0037","start":37,"end":38,"surface":"慶","kind":"person","person_id":"esh_e0a_jrw_AD","status":"contextual_provisional"},{"id":"c-shiji-103-wanshi:m011-0078","start":78,"end":80,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-103-wanshi:m011-0103","start":103,"end":106,"surface":"桑弘羊","kind":"person","person_id":"fi2_2cl_w22","status":"contextual_provisional"},{"id":"c-shiji-103-wanshi:m011-0110","start":110,"end":113,"surface":"王温舒","kind":"person","person_id":"6ym_eva_k4a","status":"contextual_provisional"},{"id":"c-shiji-103-wanshi:m011-0118","start":118,"end":120,"surface":"兒寬","kind":"person","person_id":"x8r_9sk_d7a","status":"contextual_provisional"},{"id":"c-shiji-103-wanshi:m011-0164","start":164,"end":165,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-103-wanshi:m011-0167","start":167,"end":169,"surface":"所忠","kind":"person","person_id":"gns_w0b_kfj","status":"contextual_provisional"},{"id":"c-shiji-103-wanshi:m011-0172","start":172,"end":174,"surface":"咸宣","kind":"person","person_id":"oh2_xep_h3c","status":"contextual_provisional"}],"chapter_id":"c-shiji-103-wanshi","book_id":"b-shiji-103","work_id":"w-shiji","source_id":"s-shiji-103-wanshi"},{"id":"c-shiji-121-rulin:p015","text":"伏生教濟南張生及歐陽生，歐陽生教千乘兒寬。兒寬既通尚書，以文學應郡舉，詣博士受業，受業孔安國。兒寬貧無資用，常為弟子都養，及時時閒行傭賃，以給衣食。行常帶經，止息則誦習之。以試第次，補廷尉史。是時張湯方鄉學，以為奏讞掾，以古法議決疑大獄，而愛幸寬。寬為人溫良，有廉智，自持，而善著書、書奏，敏於文，口不能發明也。湯以為長者，數稱譽之。及湯為御史大夫，以兒寬為掾，薦之天子。天子見問，說之。張湯死后六年，兒寬位至御史大夫。九年而以官卒。寬在三公位，以和良承意從容得久，然無有所匡諫；於官，官屬易之，不為盡力。張生亦為博士。而伏生孫以治尚書徵，不能明也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m015-0000","start":0,"end":2,"surface":"伏生","kind":"person","person_id":"t6q_oe6_hom","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m015-0005","start":5,"end":7,"surface":"張生","kind":"person","person_id":"aqd_hcr_hzk","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m015-0008","start":8,"end":11,"surface":"歐陽生","kind":"person","person_id":"47o_xhl_8u1","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m015-0012","start":12,"end":15,"surface":"歐陽生","kind":"person","person_id":"47o_xhl_8u1","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m015-0018","start":18,"end":20,"surface":"兒寬","kind":"person","person_id":"x8r_9sk_d7a","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m015-0021","start":21,"end":23,"surface":"兒寬","kind":"person","person_id":"x8r_9sk_d7a","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m015-0043","start":43,"end":46,"surface":"孔安國","kind":"person","person_id":"9dt_8rh_m9a","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m015-0047","start":47,"end":49,"surface":"兒寬","kind":"person","person_id":"x8r_9sk_d7a","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m015-0056","start":56,"end":58,"surface":"弟子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m015-0098","start":98,"end":100,"surface":"張湯","kind":"person","person_id":"