方使少在吾門下知指歸便大用之矣天下之士欲使皆先歴散騎然後出據州郡是吾本意也雄後為幽州刺史子渾涼州刺史次乂平北將軍司徒安豐侯戎渾之子太尉武陵侯衍荆州刺史澄皆乂之子","text_layer":"witness_appended_pei_songzhi_note","annotation_status":"named_mentions_first_pass","source_position":{"first_line":66,"last_line":75,"source_layer":"pei_annotation","unit_key":"cuilin-complete","raw_projection_ref":"source-evidence/sgz024-cuilin/projection.json"},"mentions":[{"id":"c-sanguozhi-024-cuilin:p002:w0001","start":1,"end":4,"surface":"王氏譜","kind":"work","person_id":null,"status":"contextual_provisional","interpretation_note":"依本段完整敘事、引語角色與明示近親官職辨識；非按同名批量合併。","work_id":"w-wangpu-sgz024-cuilin-reference"},{"id":"c-sanguozhi-024-cuilin:p002:m0004","start":4,"end":5,"surface":"雄","kind":"person","person_id":"ehx_cqg_nfx","status":"contextual_provisional","interpretation_note":"依本段完整敘事、引語角色與明示近親官職辨識；非按同名批量合併。"},{"id":"c-sanguozhi-024-cuilin:p002:m0006","start":6,"end":8,"surface":"元伯","kind":"person","person_id":"ehx_cqg_nfx","status":"contextual_provisional","interpretation_note":"依本段完整敘事、引語角色與明示近親官職辨識；非按同名批量合併。"},{"id":"c-sanguozhi-024-cuilin:p002:m0010","start":10,"end":11,"surface":"祥","kind":"person","person_id":"7r6_k52_qji_AA","status":"contextual_provisional","interpretation_note":"依本段完整敘事、引語角色與明示近親官職辨識；非按同名批量合併。"},{"id":"c-sanguozhi-024-cuilin:p002:w0014","start":14,"end":18,"surface":"魏名臣表","kind":"work","person_id":null,"status":"contextual_provisional","interpretation_note":"依本段完整敘事、引語角色與明示近親官職辨識；非按同名批量合併。","work_id":"w-mingchenbiao-sgz024-cuilin-reference"},{"id":"c-sanguozhi-024-cuilin:p002:m0023","start":23,"end":25,"surface":"孟達","kind":"person","person_id":"7lf_4hp_bn0","status":"contextual_provisional","interpretation_note":"依本段完整敘事、引語角色與明示近親官職辨識；非按同名批量合併。"},{"id":"c-sanguozhi-024-cuilin:p002:m0026","start":26,"end":27,"surface":"䧺","kind":"person","person_id":"ehx_cqg_nfx","status":"contextual_provisional","interpretation_note":"依本段完整敘事、引語角色與明示近親官職辨識；非按同名批量合併。"},{"id":"c-sanguozhi-024-cuilin:p002:m0028","start":28,"end":29,"surface":"臣","kind":"per