lations":[],"title_holdings":[],"address_assertions":[{"id":"pa-shiji105-005","person_id":"smh_yhl_b8t","relation":"native_place","place":{"source_name":"臨菑氾里","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-105-bianque","source_id":"s-shiji-105-bianque","paragraph_id":"c-shiji-105-bianque:p033","quote":"臨菑氾里女子薄吾病甚，眾醫皆以為寒熱篤，當死，不治。臣意診其脈，曰：「蟯瘕。」蟯瘕為病，腹大，上膚黃麤，循之戚戚然。臣意飲以芫華一撮，即出蟯可數升，病已，三十日如故。病蟯得之於寒溼，寒溼氣宛篤不發，化為蟲。臣意所以知薄吾病者，切其脈，循其尺，其尺索刺麤，而毛美奉發，是蟲氣也。其色澤者，中藏無邪氣重病。"}],"source_term":"臨菑氾里女子薄吾病甚","interpretation_note":"依原文人物前所記郡縣里或籍貫保存；不推定出生地，不補今日行政區。同郡保留相對稱謂；鄭、裏、氾等字不據注家改寫。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji105-055","person_id":"smh_yhl_b8t","surfaces":["薄吾"],"scope":"same_chapter","chapter_ids":["c-shiji-105-bianque"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-105-bianque:p033","quote":"臨菑氾里女子薄吾病甚，眾醫皆以為寒熱篤，當死，不治。臣意診其脈，曰：「蟯瘕。」蟯瘕為病，腹大，上膚黃麤，循之戚戚然。臣意飲以芫華一撮，即出蟯可數升，病已，三十日如故。病蟯得之於寒溼，寒溼氣宛篤不發，化為蟲。臣意所以知薄吾病者，切其脈，循其尺，其尺索刺麤，而毛美奉發，是蟲氣也。其色澤者，中藏無邪氣重病。"}],"rationale":"依本篇姓名、原稱及敘事回指暫定；醫案引語與附載注釋分層，未按同名自動跨篇合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-105-bianque:p033","text":"臨菑氾里女子薄吾病甚，眾醫皆以為寒熱篤，當死，不治。臣意診其脈，曰：「蟯瘕。」蟯瘕為病，腹大，上膚黃麤，循之戚戚然。臣意飲以芫華一撮，即出蟯可數升，病已，三十日如故。病蟯得之於寒溼，寒溼氣宛篤不發，化為蟲。臣意所以知薄吾病者，切其脈，循其尺，其尺索刺麤，而毛美奉發，是蟲氣也。其色澤者，中藏無邪氣重病。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-105-bianque:m033-0006","start":6,"end":8,"surface":"薄吾","kind":"person","person_id":"smh_yhl_b8t","status":"contextual_provisional"},{"id":"c-shiji-105-bianque:m033-0026","start":26,"end":28,"surface":"臣意","kind":"person","person_id":"yg7_rda_vb8","status":"contextual_provisional"},{"id":"c-shiji-105-bianque:m033-0058","start":58,"end":60,"surface":"臣意","kind":"person","person_