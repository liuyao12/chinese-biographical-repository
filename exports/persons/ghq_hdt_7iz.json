onnection":"father","generation_distance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-040-chu","source_id":"s-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p041","quote":"平王二年，使費無忌如秦爲太子建取婦。婦好，來，未至，無忌先歸，説平王曰：「秦女好，可自娶，爲太子更求。」平王聽之，卒自娶秦女，生熊珍。更爲太子娶。是時伍奢爲太子太傅，無忌爲少傅。無忌無寵於太子，常讒惡太子建。建時年十五矣，其母蔡女也，無寵於王，王稍益疎外建也。","source_term":"平王","term_role":"literal_person_anchor_in_relation_context","interpretation_note":"原關係主張的source_term是合述描述；此欄保留本段實際人物錨點。關係及完整證據見source_assertion_id。"}],"source_assertion_id":"a-shiji040-048","interpretation_note":"以此受傳正文的明示近親主張配置局部家族；不合併跨篇候選身份、不補闕名世代，不表示遠祖世系已核實。分支字元不是長幼排行。","reviewer":"Codex（AI 代理）","parent_person_id":"0va_zus_2zt_AAE"},"id_aliases":["cbr-p001915"]},{"id":"ghq_hdt_7iz","label":"子結（楚昭王弟）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"公子結","mention_ids":["c-shiji-040-chu:m054-0056"]}],"evidence":[{"mention_id":"c-shiji-040-chu:m054-0056","chapter_id":"c-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p054","quote":"公子結"}],"id_aliases":["cbr-p001938"]}],"source_mention_summary":[{"source_id":"s-shiji-040-chu","work_id":"w-shiji","book_id":"b-shiji-040","chapter_id":"c-shiji-040-chu","mention_count":1,"mention_ids":["c-shiji-040-chu:m054-0056"],"paragraph_ids":["c-shiji-040-chu:p054"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-040-chu"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji040-054","subject_person_id":"ghq_hdt_7iz","predicate":"brother","object_person_id":"0va_zus_2zt_AAEA","status":"source_attested","evidence":[{"chapter_id":"c-shiji-040-chu","source_id":"s-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p054","quote":"昭王病甚，乃召諸公子大夫曰：「孤不佞，再辱楚國之師，今乃得以天壽終，孤之幸也。」讓其弟公子申爲王，不可。又讓次弟公子結，亦不可。乃又讓次弟公子閭，五讓，乃後許爲王。將戰，庚寅，昭王卒於軍中。子閭曰：「王病甚，捨其子讓群臣，臣所以許王，以廣王意也。今君王卒，臣豈敢忘君王之意乎！」乃與子西、子綦謀，伏師閉涂，迎越女之子章立之，是爲惠王。然後罷兵歸，葬昭王。"}],"qualifiers":{"source_term":"弟／次弟","historicity":"historical_tradition"},"interpretation_note":"依本段明示生育、兄弟、母子及苗裔敘事；祖先不作直接父親，繼位不自動推父子，不補未見母名或闕代。來源主張不等於版本與史實已覆核。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-040-chu:m054-0056","start":56,"end":59,"surface":"公子結","kind":"person","person_id":"ghq_hdt_7iz","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p054","chapter_id":"c-shiji-040-chu"}],"relations":[{"id":"a-shiji040-054","subject_person_id":"ghq_hdt_7iz","predicate":"brother","object_person_id":"0va_zus_2zt_AAEA","status":"source_attested","evidence":[{"chapter_id":"c-shiji-040-chu","source_id":"s-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p054","quote":"昭王病甚，乃召諸公子大夫曰：「孤不佞，再辱楚國之師，今乃得以天壽終，孤之幸也。」讓其弟公子申爲王，不可。又讓次弟公子結，亦不可。乃又讓次弟公子閭，五讓，乃後許爲王。將戰，庚寅，昭王卒於軍中。子閭曰：「王病甚，捨其子讓群臣，臣所以許王，以廣王意也。今君王卒，臣豈敢忘君王之意乎！」乃與子西、子綦謀，伏師閉涂，迎越女之子章立之，是爲惠王。然後罷兵歸，葬昭王。"}],"qualifiers":{"source_term":"弟／次弟","historicity":"historical_tradition"},"interpretation_note":"依本段明示生育、兄弟、母子及苗裔敘事；祖先不作直接父親，繼位不自動推父子，不補未見母名或闕代。來源主張不等於版本與史實已覆核。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-040-chu:p054","text":"昭王病甚，乃召諸公子大夫曰：「孤不佞，再辱楚國之師，今乃得以天壽終，孤之幸也。」讓其弟公子申爲王，不可。又讓次弟公子結，亦不可。乃又讓次弟公子閭，五讓，乃後許爲王。將戰，庚寅，昭王卒於軍中。子閭曰：「王病甚，捨其子讓群臣，臣所以許王，以廣王意也。今君王卒，臣豈敢忘君王之意乎！」乃與子西、子綦謀，伏師閉涂，迎越女之子章立之，是爲惠王。然後罷兵歸，葬昭王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m054-0000","start":0,"end":2,"surface":"昭王","kind":"person","person_id":"0va_zus_2zt_AAEA","status":"contextual_provisional"},{"id":"c