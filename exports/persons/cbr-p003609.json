{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003609","identity_policy":"contextual_provisional","person_ids":["cbr-p003609"],"persons":[{"id":"cbr-p003609","label":"淖姬（五宗世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"淖姬","mention_ids":["c-shiji-059-wuzong:m012-0089","c-shiji-059-wuzong:m017-0285"]}],"evidence":[{"mention_id":"c-shiji-059-wuzong:m012-0089","chapter_id":"c-shiji-059-wuzong","paragraph_id":"c-shiji-059-wuzong:p012","quote":"淖姬"},{"mention_id":"c-shiji-059-wuzong:m017-0285","chapter_id":"c-shiji-059-wuzong","paragraph_id":"c-shiji-059-wuzong:p017","quote":"淖姬"}]}],"mentions":[{"id":"c-shiji-059-wuzong:m012-0089","start":89,"end":91,"surface":"淖姬","kind":"person","person_id":"cbr-p003609","status":"contextual_provisional","paragraph_id":"c-shiji-059-wuzong:p012","chapter_id":"c-shiji-059-wuzong"},{"id":"c-shiji-059-wuzong:m017-0285","start":285,"end":287,"surface":"淖姬","kind":"person","person_id":"cbr-p003609","status":"contextual_provisional","paragraph_id":"c-shiji-059-wuzong:p017","chapter_id":"c-shiji-059-wuzong"}],"relations":[],"title_holdings":[{"id":"th-shiji059-025","person_id":"cbr-p003609","title":"美人","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-059-wuzong","source_id":"s-shiji-059-wuzong","paragraph_id":"c-shiji-059-wuzong:p012","quote":"立二十六年卒，子建立為王。七年自殺。淮南、衡山謀反時，建頗聞其謀。自以為國近淮南，恐一日發，為所并，即陰作兵器，而時佩其父所賜將軍印，載天子旗以出。易王死未葬，建有所說易王寵美人淖姬，夜使人迎與姦服舍中。及淮南事發，治黨與頗及江都王建。建恐，因使人多持金錢，事絕其獄。而又信巫祝，使人禱祠妄言。建又盡與其姊弟姦。事既聞，漢公卿請捕治建。天子不忍，使大臣即訊王。王服所犯，遂自殺。國除，地入于漢，為廣陵郡。"}],"attestations":[{"id":"th-shiji059-025:a001","paragraph_id":"c-shiji-059-wuzong:p012","start":87,"end":89,"surface":"美人","person_mention_id":"c-shiji-059-wuzong:m012-0089","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"來源授封、徙封、承爵、職位與用稱分存；相對年數保持原語，不換算公曆或由死亡、首次提及補起訖。王號中的諡字不當生前正式授爵名。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji059-026","person_id":"cbr-p003609","surfaces":["淖姬"],"scope":"same_chapter","chapter_ids":["c-shiji-059-wuzong"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-059-wuzong:p012","quote":"立二十六年卒，子建立為王。七年自殺。淮南、衡山謀反時，建頗聞其謀。自以為國近淮南，恐一日發，為所并，即陰作兵器，而時佩其父所賜將軍印，載天子旗以出。易王死未葬，建有所說易王寵美人淖姬，夜使人迎與姦服舍中。及淮南事發，治黨與頗及江都王建。建恐，因使人多持金錢，事絕其獄。而又信巫祝，使人禱祠妄言。建又盡與其姊弟姦。事既聞，漢公卿請捕治建。天子不忍，使大臣即訊王。王服所犯，遂自殺。國除，地入于漢，為廣陵郡。"},{"paragraph_id":"c-shiji-059-wuzong:p017","quote":"趙王彭祖，以孝景前二年用皇子為廣川王。趙王遂反破後，彭祖王廣川。四年，徙為趙王。十五年，孝景帝崩。彭祖為人巧佞卑諂，足恭而心刻深。好法律，持詭辯以中人。彭祖多內寵姬及子孫。相、二千石欲奉漢法以治，則害於王家。是以每相、二千石至，彭祖衣皁布衣，自行迎，除二千石舍，多設疑事以作動之，得二千石失言，中忌諱，輒書之。二千石欲治者，則以此迫劫；不聽，乃上書告，及汙以姦利事。彭祖立五十餘年，相、二千石無能滿二歲，輒以罪去，大者死，小者刑，以故二千石莫敢治。而趙王擅權，使使即縣為賈人榷會，入多於國經租稅。以是趙王家多金錢，然所賜姬諸子，亦盡之矣。彭祖取笔江都易王寵姬王建所盜與姦淖姬者為姬，甚愛之。"}],"rationale":"依明示姓名、母子世系、局部王系及承爵敘事暫接；同名慶分支保存，王號不跨世代或支系套用，名非不當普通否定詞。未名皇帝、群體、指控與制度職稱不補事實；版本、跨篇與有效時段待覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-059-wuzong:p012","text":"立二十六年卒，子建立為王。七年自殺。淮南、衡山謀反時，建頗聞其謀。自以為國近淮南，恐一日發，為所并，即陰作兵器，而時佩其父所賜將軍印，載天子旗以出。易王死未葬，建有所說易王寵美人淖姬，夜使人迎與姦服舍中。及淮南事發，治黨與頗及江都王建。建恐，因使人多持金錢，事絕其獄。而又信巫祝，使人禱祠妄言。建又盡與其姊弟姦。事既聞，漢公卿請捕治建。天子不忍，使大臣即訊王。王服所犯，遂自殺。國除，地入于漢，為廣陵郡。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-059-wuzong:m012-0008","start":8,"end":9,"surface":"建","kind":"person","person_id":"cbr-p003608","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m012-0011","start":11,"end":12,"surface":"王","kind":"person","person_id":"cbr-p003608","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m012-0018","start":18,"end":20,"surface":"淮南","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、未名皇帝或未定指代；不補未見姓名、親屬成員或確定身份。"},{"id":"c-shiji-059-wuzong:m012-0021","start":21,"end":23,"surface":"衡山","ki