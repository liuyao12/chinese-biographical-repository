4,"end":27,"surface":"王無彊","kind":"person","person_id":"cbr-p002080","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m017-0050","start":50,"end":53,"surface":"諸族子","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名、群體、泛稱或未定指代保留；不補名字、世代與個人成員。"}],"chapter_id":"c-shiji-041-yue","book_id":"b-shiji-041","work_id":"w-shiji","source_id":"s-shiji-041-yue"},{"id":"c-shiji-041-yue:p029","text":"越祖少康，至於允常。其子始霸，與呉爭彊。槜李之役，闔閭見傷。會稽之恥，勾踐欲當。種誘以利，蠡悉其良。折節下士，致膽思嘗。卒複讎寇，遂殄大邦。後不量力，滅於無彊。","annotation_status":"named_mentions_first_pass","text_layer":"witness_appended_suoyin_zan","mentions":[{"id":"c-shiji-041-yue:m029-0002","start":2,"end":4,"surface":"少康","kind":"person","person_id":"cbr-p002057","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m029-0007","start":7,"end":9,"surface":"允常","kind":"person","person_id":"cbr-p002058","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m029-0010","start":10,"end":12,"surface":"其子","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名、群體、泛稱或未定指代保留；不補名字、世代與個人成員。"},{"id":"c-shiji-041-yue:m029-0025","start":25,"end":27,"surface":"闔閭","kind":"person","person_id":"cbr-p002059","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m029-0035","start":35,"end":37,"surface":"勾踐","kind":"person","person_id":"cbr-p002055","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m029-0040","start":40,"end":41,"surface":"種","kind":"person","person_id":"cbr-p002062","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m029-0045","start":45,"end":46,"surface":"蠡","kind":"person","person_id":"cbr-p002061","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m029-0077","start":77,"end":79,"surface":"無彊","kind":"person","person_id":"cbr-p002080","status":"contextual_provisional"}],"chapter_id":"c-shiji-041-yue","book_id":"b-shiji-041","work_id":"w-shiji","source_id":"s-shiji-041-yue"}],"sources":[{"chapter_id":"c-shiji-041-yue","work_id":"w-shiji","book_id":"b-shiji-041","source_id":"s-shij