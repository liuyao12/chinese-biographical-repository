:m0125","surface":"路秀","start":125,"end":127,"person_id":"3e5_6nq_xm3","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-jiong:p003:m0131","surface":"衛毅","start":131,"end":133,"person_id":"aeg_ljr_nw1","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-jiong:p003:m0137","surface":"劉真","start":137,"end":139,"person_id":"5j1_ztc_dpq","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-jiong:p003:m0143","surface":"韓泰","start":143,"end":145,"person_id":"61s_ato_nlg","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-jiong:p003:m0165","surface":"桓豹","start":165,"end":167,"person_id":"s1h_881_izr","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-jiong:p003:m0173","surface":"冏","start":173,"end":174,"person_id":"ee0_b2a_68e","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-jiong:p003:m0198","surface":"鄭方","start":198,"end":200,"person_id":"ef7_oyp_oo9","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-jiong:p003:m0207","surface":"王豹","start":207,"end":209,"person_id":"08j_19m_fmz","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-jiong:p003:m0214","surface":"冏","start":214,"end":215,"person_id":"ee0_b2a_68e","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-jiong:p003:m0222","surface":"豹","start":222,"end":223,"person_id":"08j_19m_fmz","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-059-prince-jiong","book_id":"b-jinshu-059","work_id":"w-jinshu","source_id":"s-jinshu-059-prince-jiong-ws2650517"},{"id":"c-jinshu-059-zheng-fang-review:p001","text":"鄭方者，字子回，慷慨有志節，博涉史傳，卓犖不常，鄉閭有識者歎其奇，而未能薦達。及冏輔政專恣，方發憤步詣洛陽，自稱荊楚逸民，獻書於冏曰：「方聞聖明輔世，夙夜祗懼，泰而不驕，所以長守貴也。今大王安不慮危，耽于酒色，燕樂過度，其失一也。大王檄命，當使天下穆如清風，宗室骨肉永無纖介，今則不然，其失二也。四夷交侵，邊境不靜，大王自以功業興隆，不以為念，其失三也。大王興義，群庶競赴，天下雖甯，人勞窮苦，不聞大王振救之令，其失四也。又與義兵歃血而盟，事定之後，賞不逾時，自清泰已來，論功未分，此則食言，其失五也。大王建非常之功，居宰相之任，謗聲盈塗，人懷忿怨，方以狂愚，冒死陳誠。」冏含忍答之云：「孤不能致五闕，若無子，則不聞其過矣。」未幾而敗焉。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":128,"last_line":128,"raw_start":12603,"raw_end":12924,"raw_character_offsets":[12605,12606,12607,12608,12609,12610,12611,12612,12613,12614,12615,12616,12617,12618,12619,12620,12621,12622,12623,12624,12625,12626,12627,12628,12629,12630,12631,12632,12633,12634,12635,12636,12637,12638,12639,12640,12641,12642,12643,12644,12645,12646,12647,12648,12649,12650,12651,12652,12653,12654,12655,12656,12657,12658,12659,12660,12661,12662,12663,12664,12665,12666,12667,12668,12669,12670,12671,12672,12673,12674,12675,12676,12677,12678,12679,12680,12681,12682,12683,12684,12685,12686,12687,12688,12689,12690,12691,12692,12693,12694,12695,12696,12697,12698,12699,12700,12701,12702,12703,12704,12705,12706,12707,12708,12709,12710,12711,12712,12713,12714,12715,12716,12717,12718,12719,12720,12721,12722,12723,12724,12725,12726,12727,12728,12729,12730,12731,12732,12733,12734,12735,12736,12737,12738,12739,12740,12741,12742,12743,12744,12745,12746,12747,12748,12749,12750,12751,12752,12753,12754,12755,12756,12757,12758,12759,12760,12761,12762,12763,12764,12765,12766,12767,12768,12769,12770,12771,12772,12773,12774,12775,12776,12777,12778,12779,12780,12781,12782,12783,12784,12785,12786,12787,12788,12789,12790,12791,12792,12793,12794,12795,12796,12797,12798,12799,12800,12801,12802,12803,12804,12805,12806,12807,12808,12809,12810,12811,12812,12813,12814,12815,12816,12817,12818,12819,12820,12821,12822,12823,12824,12825,12826,12827,12828,12829,12830,12831,12832,12833,12834,12835,12836,12837,12838,12839,12840,12841,12842,12843,12844,12845,12846,12847,12848,12849,12850,12851,12852,12853,12854,12855,12856,12857,12858,12859,12860,12861,12862,12863,12864,12865,12866,12867,12868,12869,12870,12871,12872,12873,12874,12875,12876,12877,12878,12879,12880,12881,12882,12883,12884,12885,12886,12887,12888,12889,12890,12891,12892,12893,12894,12895,12896,12897,12898,