inshu-059-jiong:p018","chapter_id":"c-jinshu-059-jiong"},{"id":"c-jinshu-059-jiong:p018:m0225","start":275,"end":276,"surface":"方","kind":"person","person_id":"ef7_oyp_oo9","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。","paragraph_id":"c-jinshu-059-jiong:p018","chapter_id":"c-jinshu-059-jiong"},{"id":"c-jinshu-059-jiong:p018:m0228","start":303,"end":304,"surface":"子","kind":"person","person_id":"ef7_oyp_oo9","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。","paragraph_id":"c-jinshu-059-jiong:p018","chapter_id":"c-jinshu-059-jiong"}],"relations":[],"title_holdings":[],"address_assertions":[{"id":"pa-jin059-jiong-003","person_id":"ef7_oyp_oo9","relation":"source_locality_designation","place":{"source_name":"南陽","place_id":null,"modern_identification":null},"source_term":"南陽處士鄭方","status":"source_attested","date_expression":null,"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-059","source_id":"s-jinshu-059-ws2650517-jiong","chapter_id":"c-jinshu-059-jiong","paragraph_id":"c-jinshu-059-jiong:p003","quote":"冏於是輔政，居攸故宮，置掾屬四十人。大築第館，北取五穀市，南開諸署，毀壞廬舍以百數，使大匠營制，與西宮等。鑿千秋門牆以通西閣，後房施鐘懸，前庭舞八佾，沈於酒色，不入朝見。坐拜百官，符敕三臺，選舉不均，惟寵親昵。以車騎將軍何勖領中領軍。封葛𣄣為牟平公，路秀小黃公，衛毅陰平公，劉真安鄉公，韓泰封丘公，號曰「五公」，委以心膂。殿中御史桓豹奏事，不先經冏府，即考竟之。於是朝廷側目，海內失望矣。南陽處士鄭方露版極諫，主簿王豹屢有箴規，冏並不能用，遂奏豹殺之。有白頭公入大司馬府大呼，言有兵起，不出甲子旬。即收殺之。","person_mention_id":"c-jinshu-059-jiong:p003:m0069"}],"interpretation_note":"保持原地名與所述類型，不轉現代行政區，不把官封地或屍所冒充籍貫／死地。","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null,"qualifiers":{"designation_kind":"geographical_person_reference","origin_or_residence":null}},{"id":"pa-jin059-jiong-004","person_id":"ef7_oyp_oo9","relation":"source_locality_designation","place":{"source_name":"荊楚","place_id":null,"modern_identification":null},"source_term":"自稱荊楚逸民","status":"source_attested","date_expression":null,"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-059","source_id":"s-jinshu-059-ws2650517-jiong","chapter_id":"c-jinshu-059-jiong","paragraph_id":"c-jinshu-059-jiong:p018","quote":"鄭方者，字子回，慷慨有志節，博涉史傳，卓犖不常，鄉閭有識者歎其奇，而未能薦達。及冏輔政專恣，方發憤步詣洛陽，自稱荊楚逸民，獻書於冏曰：「方聞聖明輔世，夙夜祗懼，泰而不驕，所以長守貴也。今大王安不慮危，耽于酒色，燕樂過度，其失一也。大王檄命，當使天下穆如清風，宗室骨肉永無纖介，今則不然，其失二也。四夷交侵，邊境不靜，大王自以功業興隆，不以為念，其失三也。大王興義，群庶競赴，天下雖甯，人勞窮苦，不聞大王振救之令，其失四也。又與義兵歃血而盟，事定之後，賞不逾時，自清泰已來，論功未分，此則食言，其失五也。大王建非常之功，居宰相之任，謗聲盈塗，人懷忿怨，方以狂愚，冒死陳誠。」冏含忍答之云：「孤不能致五闕，若無子，則不聞其過矣。」未幾而敗焉。","person_mention_id":"c-jinshu-059-jiong:p018:m0213"}],"interpretation_note":"保持原地名與所述類型，不轉現代行政區，不把官封地或屍所冒充籍貫／死地。","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null,"qualifiers":{"designation_kind":"geographical_person_reference","origin_or_residence":null}}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-059-jiong:p003","text":"冏於是輔政，居攸故宮，置掾屬四十人。大築第館，北取五穀市，南開諸署，毀壞廬舍以百數，使大匠營制，與西宮等。鑿千秋門牆以通西閣，後房施鐘懸，前庭舞八佾，沈於酒色，不入朝見。坐拜百官，符敕三臺，選舉不均，惟寵親昵。以車騎將軍何勖領中領軍。封葛𣄣為牟平公，路秀小黃公，衛毅陰平公，劉真安鄉公，韓泰封丘公，號曰「五公」，委以心膂。殿中御史桓豹奏事，不先經冏府，即考竟之。於是朝廷側目，海內失望矣。南陽處士鄭方露版極諫，主簿王豹屢有箴規，冏並不能用，遂奏豹殺之。有白頭公入大司馬府大呼，言有兵起，不出甲子旬。即收殺之。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-059-jiong:p003:m0058","start":0,"end":1,"surface":"冏","kind":"person","person_id":"ee0_b2a_68e","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p003:m0059","start":7,"end":8,"surface":"攸","kind":"person","person_id":"cac_ca2_008","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p003:m0060","start":110,"end":112,"surface":"何勖","kind":"person","person_id":"7e9_372_c4a","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p003:m0061","start":118,"end":120,"surface":"葛𣄣","kind":"person","person_id":"t29_ix9_yor","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinsh