efault":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-043-wangrong:p001:m0015","start":15,"end":16,"surface":"雄","kind":"person","person_id":"ehx_cqg_nfx","status":"contextual_provisional","resolution_note":"傳首王戎祖雄父渾的本傳身份；與太原王渾嚴分。魏明帝屬幼年觀戲插敘。","paragraph_id":"c-jinshu-043-wangrong:p001","chapter_id":"c-jinshu-043-wangrong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-043-wangrong:p001","text":"王戎，字濬沖，琅邪臨沂人也。祖雄，幽州刺史。父渾，涼州刺史、貞陵亭侯。戎幼而穎悟，神彩秀徹。視日不眩，裴楷見而目之曰：「戎眼燦燦，如岩下電。」年六七歲，于宣武場觀戲，猛獸在檻中虓吼震地，眾皆奔走，戎獨立不動，神色自若。魏明帝於閣上見而奇之。又嘗與群兒嬉於道側，見李樹多實，等輩兢趣之，戎獨不往。或問其故，其曰：「樹在道邊而多子，必苦李也。」取之信然。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-043-wangrong:p001:m0000","start":0,"end":2,"surface":"王戎","kind":"person","person_id":"48e_04a_3d8","status":"contextual_provisional","resolution_note":"傳首王戎祖雄父渾的本傳身份；與太原王渾嚴分。魏明帝屬幼年觀戲插敘。"},{"id":"c-jinshu-043-wangrong:p001:m0004","start":4,"end":6,"surface":"濬沖","kind":"person","person_id":"48e_04a_3d8","status":"contextual_provisional","resolution_note":"傳首王戎祖雄父渾的本傳身份；與太原王渾嚴分。魏明帝屬幼年觀戲插敘。"},{"id":"c-jinshu-043-wangrong:p001:m0015","start":15,"end":16,"surface":"雄","kind":"person","person_id":"ehx_cqg_nfx","status":"contextual_provisional","resolution_note":"傳首王戎祖雄父渾的本傳身份；與太原王渾嚴分。魏明帝屬幼年觀戲插敘。"},{"id":"c-jinshu-043-wangrong:p001:m0023","start":23,"end":24,"surface":"渾","kind":"person","person_id":"rj2_m1s_n3l","status":"contextual_provisional","resolution_note":"傳首王戎祖雄父渾的本傳身份；與太原王渾嚴分。魏明帝屬幼年觀戲插敘。"},{"id":"c-jinshu-043-wangrong:p001:m0035","start":35,"end":36,"surface":"戎","kind":"person","person_id":"48e_04a_3d8","status":"contextual_provisional","resolution_note":"傳首王戎祖