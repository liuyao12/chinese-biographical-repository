12,8613,8614,8615,8616,8617,8618,8619,8620,8621,8622,8623,8624,8625,8626,8627,8628,8629]},"attribution":{"annotator":"裴松之","attribution_kind":"editorial_narrative","source_label":"裴注敘文","attribution_marker":"绩於鬱林所生女"},"attachment":{"received_paragraph_id":"c-sanguozhi-057-luji:line039","received_codepoint":245,"note_ordinal":1,"source_ordinal":1},"chapter_id":"c-sanguozhi-057-luji","book_id":"b-sanguozhi-057","work_id":"w-sanguozhi","source_id":"s-sanguozhi-057-luji"},{"id":"c-sanguozhi-057-luji:line039-pei01-02","text":"姚信《集》有表称之曰：“臣闻唐、虞之政，举善而教，旌德擢异，三王所先，是以忠臣烈士，显名国朝，淑妇贞女，表迹家闾。盖所以阐崇化业，广殖清风，使苟有令性，幽明俱著，苟怀懿姿，士女同荣。故王蠋建寒松之节而齐王表其里，义姑立殊绝之操而鲁侯高其门。臣切见故鬱林太守陆绩女子鬱生，少履贞特之行，幼立匪石之节，年始十三，適同郡张白。侍庙三月，妇礼未卒，白遭罹家祸，迁死异郡。鬱生抗声昭节，义形於色，冠盖交横，誓而不许，奉白姊妹嶮巇之中，蹈履水火，志怀霜雪，义心固於金石，体信贯於神明，送终以礼，邦士慕则。臣闻昭德以行，显行以爵，苟非名爵，则劝善不严，故士之有诔，鲁人志其勇，杞妇见书，齐人哀其哭。乞蒙圣朝，斟酌前训，上开天聪，下垂坤厚，褒鬱生以义姑之号，以厉两髦之节，则皇风穆暢，士女改视矣。”","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-057-luji:line039-pei01-02:m0000","start":0,"end":2,"surface":"姚信","kind":"person","person_id":"evj_3wb_3l3","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-luji:line039-pei01-02:m0092","start":92,"end":94,"surface":"王蠋","kind":"person","person_id":"rqv_zm4_apj","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-luji:line039-pei01-02:m0128","start":128,"end":130,"surface":"陆绩","kind":"person","person_id":"7ec_qvv_x1c","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-luji:line039-pei01-02:m0132","start":132,"end":134,"surface":"鬱生","kind":"person","person_id":"7ec_qvv_x1c_C","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-luji:line039-pei01-02:m0157","start":157,"end":159,"surface":"张白","kind":"person","person_id":"xpd_ary_5a9","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-luji:line039-pei01-02:m0170","start