:"contextual_provisional","paragraph_id":"c-jinshu-070-ganzhuo:p001","chapter_id":"c-jinshu-070-ganzhuo"},{"id":"c-jinshu-072-gehong:p002:m0004","surface":"石冰","start":4,"end":6,"person_id":"doi_z86_qc2","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-072-gehong:p002","chapter_id":"c-jinshu-072-gehong"},{"id":"c-sanguozhi-065-heshao-complete:p009:m0244","surface":"石冰","start":244,"end":246,"kind":"person","person_id":"doi_z86_qc2","status":"contextual_provisional","paragraph_id":"c-sanguozhi-065-heshao-complete:p009","chapter_id":"c-sanguozhi-065-heshao-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-052-hua-tan:p010","text":"永甯初，出為郟令。于時兵亂之後，境內饑饉，譚傾心撫䘏。司徒王戎聞而善之，出穀三百斛以助之。譚甚有政績，再遷廬江內史，加綏遠將軍。時石冰之党陸圭等屯據諸縣，譚遣司馬褚敦討平之。又遣別軍擊冰都督孟徐，獲其驍率。以功封都亭侯，食邑千戶，賜絹千匹。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":76,"last_line":76,"raw_start":7529,"raw_end":7649,"raw_character_offsets":[7529,7530,7531,7532,7533,7534,7535,7536,7537,7538,7539,7540,7541,7542,7543,7544,7545,7546,7547,7548,7549,7550,7551,7552,7553,7554,7555,7556,7557,7558,7559,7560,7561,7562,7563,7564,7565,7566,7567,7568,7569,7570,7571,7572,7573,7574,7575,7576,7577,7578,7579,7580,7581,7582,7583,7584,7585,7586,7587,7588,7589,7590,7591,7592,7593,7594,7595,7596,7597,7598,7599,7600,7601,7602,7603,7604,7605,7606,7607,7608,7609,7610,7611,7612,7613,7614,7615,7616,7617,7618,7619,7620,7621,7622,7623,7624,7625,7626,7627,7628,7629,7630,7631,7632,7633,7634,7635,7636,7637,7638,7639,7640,7641,7642,7643,7644,7645,7646,7647,7648],"revision_id":2604575},"mentions":[{"id":"c-jinshu-052-hua-tan:p010:m0021","start":21,"end":22,"surface":"譚","kind":"person","person_id":"qg9_lis_fdj","status":"contextual_provisional"},{"id":"c-jinshu-052-hua-tan:p010:m0029","start":29,"end":31,"surface":"王戎","kind":"person","person_id":"48e_04a_3d8","status":"contextual_provisional"},{"id":"c-jinshu-052-hua-tan:p010:m0045","start":45,"end":46,"surface":"譚","kind":"person","person_id":"qg9_lis_fdj","status":"contextual_provisional"},{"id":"c-jinshu-052-hua-tan:p010:m0065","start":65,"end":67,"surface":"石冰","kind":"person","person_id":"doi_z86_qc2","status":"contextual_provisional"},{"id":"c-jinshu-052-hua-tan:p010:m0069","start":69,"end":71,"surface":"陸圭","kind":"person","person_id":"iii_imm_0of","status":"contextual_provisional"},{"id":"c-jinshu-052-hua-tan:p010:m0077","start":77,"end":78,"surface":"譚","kind":"person","person_id":"qg9_lis_fdj","status":"contextual_provisional"},{"id":"c-jinshu-052-hua-tan:p010:m0081","start":81,"end":83,"surface":"褚敦","kind":"person","person_id":"px4_h5s_fbt","status":"contextual_provisional"},{"id":"c-jinshu-052-hua-tan:p010:m0092","start":92,"end":93,"surface":"冰","kind":"person","person_id":"doi_z86_qc2","status":"contextual_provisional"},{"id":"c-jinshu-052-hua-tan:p010:m0095","start":95,"end":97,"surface":"孟徐","kind":"person","person_id":"lxu_zml_iaw","status":"contextual_provisional"}],"chapter_id":"c-jinshu-052-hua-tan","book_id":"b-jinshu-052","work_id":"w-jinshu","source_id":"s-jinshu-052-hua-tan-ws2604575"},{"id":"c-jinshu-058-zhou-qi:p002","text":"太安初，妖賊張昌、丘沈等聚眾於江夏，百姓從之如歸。惠帝使監軍華宏討之，敗於障山。昌等浸盛，殺平南將軍羊伊，鎮南大將軍、新野王歆等，所在覆沒。昌別率封雲攻徐州，石冰攻揚州，刺史陳徽出奔，冰遂略有揚土。玘密欲討冰，潛結前南平內史王矩，共推呉興太守顧秘都督揚州九郡軍事，及江東人士同起義兵，斬冰所置呉興太守區山及諸長史。冰遣其將羌毒領數萬人距玘，玘臨陣斬毒。時右將軍陳敏自廣陵率眾助圮，斬冰別率趙驡於蕪湖，因與玘俱前攻冰於建康。冰北走投封雲，雲司馬張統斬雲、冰以降，徐、揚並平。玘不言功賞，散眾還家。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":24,"last_line":24,"raw_start":1869,"raw_end":2142,"raw_character_offsets":[1871,1872,1873,1874,1875,1876,1877,1878,1879,1880,1881,1882,1883,1884,1887,1890,1891,1892,1893,1894,1895,1896,1897,1898,1899,1900,1901,1902,1903,1904,1905,1906,1907,1908,1909,1910,1911,1912,1913,1914,1915,1916,1917,1918,1919,1920,1921,1922