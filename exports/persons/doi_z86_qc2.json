m0087","surface":"陳徽","start":87,"end":89,"person_id":"win_14d_gq9","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-qi:p002:m0092","surface":"冰","start":92,"end":93,"person_id":"doi_z86_qc2","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-qi:p002:m0099","surface":"玘","start":99,"end":100,"person_id":"i1w_a4z_a3g","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-qi:p002:m0112","surface":"王矩","start":112,"end":114,"person_id":"v4a_puq_3e6","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-qi:p002:m0121","surface":"顧秘","start":121,"end":123,"person_id":"jfc_0dt_42a","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-qi:p002:m0150","surface":"區山","start":150,"end":152,"person_id":"xgj_7tj_dja","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-qi:p002:m0161","surface":"羌毒","start":161,"end":163,"person_id":"b1d_g3x_4vc","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-qi:p002:m0168","surface":"玘","start":168,"end":169,"person_id":"i1w_a4z_a3g","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-qi:p002:m0170","surface":"玘","start":170,"end":171,"person_id":"i1w_a4z_a3g","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-qi:p002:m0180","surface":"陳敏","start":180,"end":182,"person_id":"kok_m7n_tux","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-qi:p002:m0188","surface":"圮","start":188,"end":189,"person_id":"i1w_a4z_a3g","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-qi:p002:m0194","surface":"趙驡","start":194,"end":196,"person_id":"t1w_jaz_tch","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-qi:p002:m0202","surface":"玘","start":202,"end":203,"person_id":"i1w_a4z_a3g","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-qi:p002:m0215","surface":"封雲","start":215,"end":217,"person_id":"mnr_35c_4aa","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-qi:p002:m0221","surface":"張統","start":221,"end":223,"person_id":"hue_jgf_fqb","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-qi:p002:m0226","surface":"冰","start":226,"end":227,"person_id":"doi_z86_qc2","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-qi:p002:m0236","surface":"玘","start":236,"end":237,"person_id":"i1w_a4z_a3g","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-058-zhou-qi","book_id":"b-jinshu-058","work_id":"w-jinshu","source_id":"s-jinshu-058-zhou-qi-ws1775463"},{"id":"c-sanguozhi-065-heshao-complete:p009","text":"邵子循，字彦先。虞预《晋书》曰：循丁家祸，流放海滨，吴平，还乡里。节操高厉，童齔不群，言行举动，必以礼让。好学博闻，尤善三礼。举秀子，除阳羡、武康令。顾荣、陆机、陆云表荐循曰：“伏见吴兴武康令贺循德量邃茂，才鉴清远，服膺道素，风操凝峻，历践三城，刑政肃穆，守职下县，编名凡萃，出自新邦，朝无知己，恪居遐外，志不自营，年时倏忽，而邈无阶绪，实州党愚智所为怅然。臣等并以凡才，累授饰进，被服恩泽，忝豫朝末，知良士后时，而守局无言，惧有蔽贤之咎，是以不胜愚管，谨冒死表闻。”久之，召为太子舍人。石冰破扬州，循亦合众，事平，杜门不出。陈敏作乱，以循为丹杨内史，循称疾固辞，敏不敢逼。于时江东豪右无不受敏爵位，惟循与同郡硃诞不挂贼网。后除吴国内史，不就。元皇帝为镇东将军，请循为军司马，帝为晋王，以循为中书令，固让不受，转太常，领太子太傅。时朝廷初建，动有疑议，宗庙制度皆循所定，朝野谘询，为一时儒宗。年六十，太興二年卒。追赠司空，谥曰穆。循诸所著论，并传於世。子隰，临海太守。","text_layer":"witness_appended_pei_songzhi_note","annotation_status":"reviewed","source_position":{"first_line":39,"last_line":39,"raw_start":3469,"raw_end":3923,"raw_character_offsets":[3469,3470,3471,3472,3473,3474,3475,3476,3477,3478,3479,3491,3492,3495,3496,3497,3498,3499,3500,3501,3502,3503,3504,3505,3506,3507,3508,3509,3510,3511,3512,3513,3514,3515,3516,3517,3518,3519,3520,3521,3522,3523,3524,3525,3526,3527,3528,3529,3530,3531,3532,3533,3534,3535,3536,3537,3538,3539,3540,3541,3542,3543,3544,3545,3546,3547,3548,3549,3550,3551,3552,3553,3554,3555,3556,3557,3558,3559,3560,3561,3562,3563,3564,3565,3566,3567,3568,3569,3570,3571,3572,3573,3574,3575,3576,3577,3578,3579,3580,3581,3582,3583,3584,3585,3586,3587,3588,3589,3590,3591,3592,3593,3594,3595,3596,3597,3598,3599,3600,3601,3602,3603,3604,3605,360