p005:m0004","surface":"陳敏","start":4,"end":6,"person_id":"kok_m7n_tux","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-068-gurong:p005:m0017","surface":"劉機","start":17,"end":19,"person_id":"4jn_rcu_wkb","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-068-gurong:p005:m0024","surface":"王曠","start":24,"end":26,"person_id":"2hq_5un_2av","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-068-gurong:p005:m0126","surface":"石冰","start":126,"end":128,"person_id":"doi_z86_qc2","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-068-gurong:p005:m0258","surface":"甘卓","start":258,"end":260,"person_id":"csn_tgm_oe7","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-068-gurong:p005:m0368","surface":"顧榮","start":368,"end":370,"person_id":"wtz_smr_dwz","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-068-gurong:p005:m0371","surface":"甘卓","start":371,"end":373,"person_id":"csn_tgm_oe7","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-068-gurong:p005:m0401","surface":"周圮","start":401,"end":403,"person_id":"i1w_a4z_a3g","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-068-gurong:p005:m0406","surface":"甘卓","start":406,"end":408,"person_id":"csn_tgm_oe7","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-068-gurong:p005:m0409","surface":"紀瞻","start":409,"end":411,"person_id":"23e_6ed_438","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-068-gurong:p005:m0484","surface":"紀瞻","start":484,"end":486,"person_id":"23e_6ed_438","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-068-gurong","book_id":"b-jinshu-068","work_id":"w-jinshu","source_id":"s-jinshu-068-gurong-ws2581578"},{"id":"c-jinshu-068-hexun:p002","text":"趙王倫篡位，轉侍御史，辭疾去職。後除南中郎長史，不就，會逆賊李辰起兵江夏，征鎮不能討，皆望塵奔走。辰別帥石冰略有揚州，逐會稽相張景，以前寧遠護軍程超代之，以其長史宰與領山陰令。前南平內史王矩、吳興內史顧秘、前秀才周圮等唱義，傳檄州郡以討之，循亦合眾應之。冰大將抗寵有眾數千，屯郡講堂。循移檄於寵，為陳逆順，寵遂遁走，超、與皆降，一郡悉平。循迎景還郡，即謝遣兵士，杜門不出，論功報賞，一無豫焉。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":77,"last_line":77,"raw_start":8003,"raw_end":8201,"raw_character_offsets":[8005,8006,8007,8008,8009,8010,8011,8012,8013,8014,8015,8016,8017,8018,8019,8020,8021,8022,8023,8024,8025,8026,8027,8028,8029,8030,8031,8032,8033,8034,8035,8036,8037,8038,8039,8040,8041,8042,8043,8044,8045,8046,8047,8048,8049,8050,8051,8052,8053,8054,8055,8056,8057,8058,8059,8060,8061,8062,8063,8064,8065,8066,8067,8068,8069,8070,8071,8072,8073,8074,8075,8076,8077,8078,8079,8080,8081,8082,8083,8084,8085,8086,8087,8088,8089,8090,8091,8092,8093,8094,8095,8096,8097,8098,8099,8100,8101,8102,8103,8104,8105,8106,8107,8108,8109,8110,8111,8112,8113,8114,8115,8116,8117,8118,8119,8120,8121,8122,8123,8124,8125,8126,8127,8128,8129,8130,8131,8132,8133,8134,8135,8136,8137,8138,8139,8140,8141,8142,8143,8144,8145,8146,8147,8148,8149,8150,8151,8152,8153,8154,8155,8156,8157,8158,8159,8160,8161,8162,8163,8164,8165,8166,8167,8168,8169,8170,8171,8172,8173,8174,8175,8176,8177,8178,8179,8180,8181,8182,8183,8184,8185,8186,8187,8188,8189,8190,8191,8192,8193,8194,8195,8196,8197,8198,8199,8200],"revision_id":2581578},"mentions":[{"id":"c-jinshu-068-hexun:p002:m0000","surface":"趙王倫","start":0,"end":3,"person_id":"dkn_ge4_286_AAAAG","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-068-hexun:p002:m0030","surface":"李辰","start":30,"end":32,"person_id":"3sv_fgo_jtc","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-068-hexun:p002:m0052","surface":"石冰","start":52,"end":54,"person_id":"doi_z86_qc2","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-068-hexun:p002:m0063","surface":"張景","start":63,"end":65,"person_id":"eop_09t_ph6","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-068-hexun:p002:m0072","surface":"程超","start":72,"end":74,"person_id":"9a6_7fq_1hm","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-068-hexun:p002:m0081","surface