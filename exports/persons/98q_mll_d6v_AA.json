yer":"received_chapter","annotation_status":"reviewed","mentions":[{"start":5,"end":7,"surface":"江祏","id":"c-nanshi-019-xietiao:p005:m0005","person_id":"q63_4br_3of_A","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作江祏。"},{"start":12,"end":14,"surface":"寶玄","id":"c-nanshi-019-xietiao:p005:m0012","person_id":"w4m_9tw_147_B","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作蕭寶玄。"},{"start":22,"end":23,"surface":"祀","id":"c-nanshi-019-xietiao:p005:m0022","person_id":"q63_4br_3of_B","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作江祀。"},{"start":25,"end":26,"surface":"朓","id":"c-nanshi-019-xietiao:p005:m0025","person_id":"aa6_83c_juy_ABCBA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作謝朓。"},{"start":72,"end":74,"surface":"遙光","id":"c-nanshi-019-xietiao:p005:m0072","person_id":"98q_mll_d6v_AA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作蕭遙光。"},{"start":78,"end":80,"surface":"劉渢","id":"c-nanshi-019-xietiao:p005:m0078","person_id":"so7_9tl_ajl","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作劉渢。"},{"start":83,"end":84,"surface":"朓","id":"c-nanshi-019-xietiao:p005:m0083","person_id":"aa6_83c_juy_ABCBA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作謝朓。"},{"start":85,"end":86,"surface":"朓","id":"c-nanshi-019-xietiao:p005:m0085","person_id":"aa6_83c_juy_ABCBA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作謝朓。"},{"start":100,"end":102,"surface":"遙光","id":"c-nanshi-019-xietiao:p005:m0100","person_id":"98q_mll_d6v_AA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作蕭遙光。"},{"start":103,"end":104,"surface":"朓","id":"c-nanshi-019-xietiao:p005:m0103","person_id":"aa6_83c_juy_ABCBA","kind":"person","status":"contextual_provisional","interpretation_no