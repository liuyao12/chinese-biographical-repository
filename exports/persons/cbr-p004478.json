{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004478","identity_policy":"contextual_provisional","person_ids":["cbr-p004478"],"persons":[{"id":"cbr-p004478","label":"簀中救范守者未名（范睢蔡澤列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"守者","mention_ids":["c-shiji-079-fancai:m002-0167","c-shiji-079-fancai:m002-0184"]},{"surface":"公","mention_ids":["c-shiji-079-fancai:m002-0172","c-shiji-079-fancai:m002-0181"]}],"evidence":[{"mention_id":"c-shiji-079-fancai:m002-0167","chapter_id":"c-shiji-079-fancai","paragraph_id":"c-shiji-079-fancai:p002","quote":"守者"},{"mention_id":"c-shiji-079-fancai:m002-0184","chapter_id":"c-shiji-079-fancai","paragraph_id":"c-shiji-079-fancai:p002","quote":"守者"},{"mention_id":"c-shiji-079-fancai:m002-0172","chapter_id":"c-shiji-079-fancai","paragraph_id":"c-shiji-079-fancai:p002","quote":"公"},{"mention_id":"c-shiji-079-fancai:m002-0181","chapter_id":"c-shiji-079-fancai","paragraph_id":"c-shiji-079-fancai:p002","quote":"公"}]}],"mentions":[{"id":"c-shiji-079-fancai:m002-0167","start":167,"end":169,"surface":"守者","kind":"person","person_id":"cbr-p004478","status":"contextual_provisional","paragraph_id":"c-shiji-079-fancai:p002","chapter_id":"c-shiji-079-fancai"},{"id":"c-shiji-079-fancai:m002-0172","start":172,"end":173,"surface":"公","kind":"person","person_id":"cbr-p004478","status":"contextual_provisional","paragraph_id":"c-shiji-079-fancai:p002","chapter_id":"c-shiji-079-fancai"},{"id":"c-shiji-079-fancai:m002-0181","start":181,"end":182,"surface":"公","kind":"person","person_id":"cbr-p004478","status":"contextual_provisional","paragraph_id":"c-shiji-079-fancai:p002","chapter_id":"c-shiji-079-fancai"},{"id":"c-shiji-079-fancai:m002-0184","start":184,"end":186,"surface":"守者","kind":"person","person_id":"cbr-p004478","status":"contextual_provisional","paragraph_id":"c-shiji-079-fancai:p002","chapter_id":"c-shiji-079-fancai"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji079-007","person_id":"cbr-p004478","surfaces":["公","守者"],"scope":"same_chapter","chapter_ids":["c-shiji-079-fancai"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-079-fancai:p002","quote":"須賈為魏昭王使於齊，范睢從。留數月，未得報。齊襄王聞睢辯口，乃使人賜睢金十斤及牛酒，睢辭謝不敢受。須賈知之，大怒，以為睢持魏國陰事告齊，故得此饋，令睢受其牛酒，還其金。既歸，心怒睢，以告魏相。魏相，魏之諸公子，曰魏齊。魏齊大怒，使舍人笞擊睢，折脅摺齒。睢詳死，即卷以簀，置廁中。賓客飲者醉，更溺睢，故僇辱以懲後，令無妄言者。睢從簀中謂守者曰：「公能出我，我必厚謝公。」守者乃請出棄簀中死人。魏齊醉，曰：「可矣。」范睢得出。後魏齊悔，復召求之。魏人鄭安平聞之，乃遂操范睢亡，伏匿，更名姓曰張祿。"}],"rationale":"按全35段明示姓名與局部引語暫接，范睢張祿范叔范君應侯分說話範圍；蔡澤先生綱成君依具體敘事。越王事大夫種與句踐敘事相配，更新候選標籤保留ID。馬服／馬服子依同段長平角色暫接未補姓名，白公仍未定，韓子未強接韓非，喬松不補神仙，范中行族稱不接范睢。王之弟、改讀前止足及引古異說各留，預言與擬議方案不當史實核定。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-079-fancai:p002","text":"須賈為魏昭王使於齊，范睢從。留數月，未得報。齊襄王聞睢辯口，乃使人賜睢金十斤及牛酒，睢辭謝不敢受。須賈知之，大怒，以為睢持魏國陰事告齊，故得此饋，令睢受其牛酒，還其金。既歸，心怒睢，以告魏相。魏相，魏之諸公子，曰魏齊。魏齊大怒，使舍人笞擊睢，折脅摺齒。睢詳死，即卷以簀，置廁中。賓客飲者醉，更溺睢，故僇辱以懲後，令無妄言者。睢從簀中謂守者曰：「公能出我，我必厚謝公。」守者乃請出棄簀中死人。魏齊醉，曰：「可矣。」范睢得出。後魏齊悔，復召求之。魏人鄭安平聞之，乃遂操范睢亡，伏匿，更名姓曰張祿。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-079-fancai:m002-0000","start":0,"end":2,"surface":"須賈","kind":"person","person_id":"cbr-p004473","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m002-0003","start":3,"end":6,"surface":"魏昭王","kind":"person","person_id":"cbr-p004475","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m002-0010","start":10,"end":12,"surface":"范睢","kind":"person","person_id":"cbr-p004472","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m002-0022","start":22,"end":25,"surface":"齊襄王","kind":"person","person_id":"cbr-p004476","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m002-0026","start":26,"end":27,"surface":"睢","kind":"person","person_id":"cbr-p004472","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m002-0034","start":34,"end":35,"surface":"睢","kind":"pe