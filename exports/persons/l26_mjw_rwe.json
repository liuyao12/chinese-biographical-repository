qi:m005-0005","c-shiji-107-weiqi:m008-0099","c-shiji-107-weiqi:m008-0103","c-shiji-107-weiqi:m008-0137","c-shiji-107-weiqi:m008-0166","c-shiji-107-weiqi:m009-0051","c-shiji-107-weiqi:m011-0003","c-shiji-107-weiqi:m013-0113","c-shiji-107-weiqi:m013-0122"],"paragraph_ids":["c-shiji-107-weiqi:p001","c-shiji-107-weiqi:p002","c-shiji-107-weiqi:p005","c-shiji-107-weiqi:p008","c-shiji-107-weiqi:p009","c-shiji-107-weiqi:p011","c-shiji-107-weiqi:p013"],"passage_count":7}],"most_mentioned_source_ids":["s-shiji-107-weiqi"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji107-002","subject_person_id":"0d9_tws_4v6","predicate":"mother","object_person_id":"l26_mjw_rwe","status":"source_attested","evidence":[{"chapter_id":"c-shiji-107-weiqi","source_id":"s-shiji-107-weiqi","paragraph_id":"c-shiji-107-weiqi:p002","quote":"梁孝王者，孝景弟也，其母竇太后愛之。梁孝王朝，因昆弟燕飲。是時上未立太子，酒酣，從容言曰：「千秋之後傳梁王。」太后驩。竇嬰引卮酒進上，曰：「天下者，高祖天下，父子相傳，此漢之約也，上何以得擅傳梁王！」太后由此憎竇嬰。竇嬰亦薄其官，因病免。太后除竇嬰門籍，不得入朝請。"}],"qualifiers":{"source_term":"其母竇太后","historicity":"historical_tradition"},"interpretation_note":"保留本文親屬原稱；同母不表示同父，弟只記相對長幼而不補排行數字。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji107-008","subject_person_id":"nau_948_2gt","predicate":"brother","object_person_id":"l26_mjw_rwe","status":"source_attested","evidence":[{"chapter_id":"c-shiji-107-weiqi","source_id":"s-shiji-107-weiqi","paragraph_id":"c-shiji-107-weiqi:p013","quote":"潁陰侯言之上，上以夫為中郎將。數月，坐法去。後家居長安，長安中諸公莫弗稱之。孝景時，至代相。孝景崩，今上初即位，以為淮陽天下交，勁兵處，故徙夫為淮陽太守。建元元年，入為太仆。二年，夫與長樂衛尉竇甫飲，輕重不得，夫醉，搏甫。甫，竇太后昆弟也。上恐太后誅夫，徙為燕相。數歲，坐法去官，家居長安。"}],"qualifiers":{"source_term":"竇太后昆弟","historicity":"historical_tradition"},"interpretation_note":"按本段明示親屬記錄；同姓、賜姓、舍人及先後持爵不作父子。昆弟未分長幼，不補數字。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-107-weiqi:m001-0007","start":7,"end":10,"surface":"孝文后","kind":"person","person_id":"l26_mjw_rwe","status":"contextual_provisional","paragraph_id":"c-shiji-107-weiqi:p001","chapter_id":"c-shiji-107-weiqi"},{"id":"c-shiji-107-weiqi:m002-0012","start":12,"end":15,"surface":"竇太后","kind":"person","person_id":"l26_mjw_rwe","status":"contextual_provisional","paragraph_id":"c-shiji-107-weiqi:p002","chapter_id":"c-shiji-107-weiqi"},{"id":"c-shiji-107-weiqi:m005-0005","start":5,"end":8,"surface":"竇太后","kind":"person","person_id":"l26_mjw_rwe","status":"contextual_provisional","paragraph_id":"c-shiji-107-weiqi:p005","chapter_id":"c-shiji-107-weiqi"},{"id":"c-shiji-107-weiqi:m008-0099","start":99,"end":102,"surface":"竇太后","kind":"person","person_id":"l26_mjw_rwe","status":"contextual_provisional","paragraph_id":"c-shiji-107-weiqi:p008","chapter_id":"c-shiji-107-weiqi"},{"id":"c-shiji-107-weiqi:m008-0103","start":103,"end":105,"surface":"太后","kind":"person","person_id":"l26_mjw_rwe","status":"contextual_provisional","paragraph_id":"c-shiji-107-weiqi:p008","chapter_id":"c-shiji-107-weiqi"},{"id":"c-shiji-107-weiqi:m008-0137","start":137,"end":140,"surface":"竇太后","kind":"person","person_id":"l26_mjw_rwe","status":"contextual_provisional","paragraph_id":"c-shiji-107-weiqi:p008","chapter_id":"c-shiji-107-weiqi"},{"id":"c-shiji-107-weiqi:m008-0166","start":166,"end":169,"surface":"竇太后","kind":"person","person_id":"l26_mjw_rwe","status":"contextual_provisional","paragraph_id":"c-shiji-107-weiqi:p008","chapter_id":"c-shiji-107-weiqi"},{"id":"c-shiji-107-weiqi:m009-0051","start":51,"end":54,"surface":"竇太后","kind":"person","person_id":"l26_mjw_rwe","status":"contextual_provisional","paragraph_id":"c-shiji-107-weiqi:p009","chapter_id":"c-shiji-107-weiqi"},{"id":"c-shiji-107-weiqi:m011-0003","start":3,"end":6,"surface":"竇太后","kind":"person","person_id":"l26_mjw_rwe","status":"contextual_provisional","paragraph_id":"c-shiji-107-weiqi:p011","chapter_id":"c-shiji-107-weiqi"},{"id":"c-shiji-107-weiqi:m013-0113","start":113,"end":116,"surface":"竇太后","kind":"person","person_id":"l26_mjw_rwe","status":"contextual_provisional","paragraph_id":"c-shiji-107-weiqi:p013","chapter_id":"c-shiji-107-weiqi"},{"id":"c-shiji-107-weiqi:m013-0122","start":122,"end":124,"surface":"太后","kind":"person","person_id":"l26_mjw_rwe","status":"contextual_provisional","paragraph_id":"c-shiji-107-weiqi:p013","chapter_id":"c-shiji-107-weiqi"}],"relations":[{"id":"a-shiji107-002","subject_person_id":"0d9_tws_4v6","predicate":"mother","object_person_id":"l26_mjw_rwe","status":"source_attested","evidence":[{"chapter_id":"c-shiji-107-weiqi","source_id":"s-shiji-107-weiqi","paragraph_id":"c-shiji-107-weiqi:p002","quote":"梁孝王者，孝景弟也，其母竇太后愛之。梁孝王朝，因昆弟燕飲。是時上未立太子，酒酣，從容言曰：「千秋之後傳梁王。」太后驩。竇嬰引卮酒進上，曰：「天下者，高祖天下，父子相傳，此漢之約也，上何以得擅傳梁王！」太后由此憎竇嬰。竇嬰亦薄其官，因病免。太后除竇嬰門籍，不得入朝請。"}],"qualifiers":{"source_term":"其母竇太后","historicity":"historical_tradition"},"interpretation_note":"保留本文親屬原稱；同母不表示同父，弟只記相對長幼而不補排行數字。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji107-008","subject_person_id":"nau_948_2gt","predicate":"brother","object_person_id":"l26_mjw_rwe","status":"source_attested","evidence":[{"chapter_id":"c-shiji-107-weiqi","source_id":"s-shiji-107-weiqi","paragraph_id":"c-shiji-107-weiqi:p013","quote":"潁陰侯言之上，上以夫為中郎將。數月，坐法去。後家居長安，長安中諸公莫弗稱之。孝景時，至代相。孝景崩，今上初即位，以為淮陽天下交，勁兵處，故徙夫為淮陽太守。建元元年，入為太仆。二年，夫與長樂衛尉竇甫飲，輕重不得，夫醉，搏甫。甫，竇太后昆弟也。上恐太后誅夫，徙為燕相。數歲，坐法去官，家居長安。"}],"qualifiers":{"source_term":"竇太后昆弟","historicity":"historical_tradition"},"interpretation_note":"按本段明示親屬記錄；同姓、賜姓、舍人及先後持爵不作父子。昆弟未分長幼，不補數字。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji107-002","person_id":"l26_mjw_rwe","surfaces":["孝文后","竇太后","太后"],"scope":"same_chapter","chapter_ids":["c-shiji-107-weiqi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-107-weiqi:p001","quote":"魏其侯竇嬰者，孝文后從兄子也。父世觀津人。喜賓客。孝文時，嬰為吳相，病免。孝景初即位，為詹事。"},{"paragraph_id":"c-shiji-107-weiqi:p002","quote":"梁孝王者，孝景弟也，其母竇太后愛之。梁孝王朝，因昆弟燕飲。是時上未立太子，酒酣，從容言曰：「千秋之後傳梁王。」太后驩。竇嬰引卮酒進上，曰：「天下者，高祖天下，父子相傳，此漢之約也，上何以得擅傳梁王！」太后由此憎竇嬰。竇嬰亦薄其官，因病免。太后除竇嬰門籍，不得入朝請。"},{"paragraph_id":"c-shiji-107-weiqi:p005","quote":"桃侯免相，竇太后數言魏其侯。孝景帝曰：「太后豈以為臣有愛，不相魏其？魏其者，沾沾自喜耳，多易。難以為相，持重。」遂不用，用建陵侯衛綰為丞相。"},{"paragraph_id":"c-shiji-107-weiqi:p008","quote":"魏其、武安俱好儒術，推轂趙綰為御史大夫，王臧為郎中令。迎魯申公，欲設明堂，令列侯就國，除關，以禮為服制，以興太平。舉適諸竇宗室毋節行者，除其屬籍。時諸外家為列侯，列侯多尚公主，皆不欲就國，以故毀日至竇太后。太后好黃老之言，而魏其、武安、趙綰、王臧等務隆推儒術，貶道家言，是以竇太后滋不說魏其等。及建元二年，御史大夫趙綰請無奏事東宮。竇太后大怒，乃罷逐趙綰、王臧等，而免丞相、太尉，以柏至侯許昌為丞相，武彊侯莊青翟為御史大夫。魏其、武安由此以侯家居。"},{"paragraph_id":"c-shiji-107-weiqi:p009","quote":"武安侯雖不任職，以王太后故，親幸，數言事多效，天下吏士趨勢利者，皆去魏其歸武安，武安日益橫。建元六年，竇太后崩，丞相昌、御史大夫青翟坐喪事不辦，免。以武安侯蚡為丞相，以大司農韓安國為御史大夫。天下士郡諸侯愈益附武安。"},{"paragraph_id":"c-shiji-107-weiqi:p011","quote":"魏其失竇太后，益疏不用，無勢，諸客稍稍自引而怠傲，唯灌將軍獨不失故。魏其日默默不得志，而獨厚遇灌將軍。"},{"paragraph_id":"c-shiji-107-weiqi:p013","quote":"潁陰侯言之上，上以夫為中郎將。數月，坐法去。後家居長安，長安中諸公莫弗稱之。孝景時，至代相。孝景崩，今上初即位，以為淮陽天下交，勁兵處，故徙夫為淮陽太守。建元元年，入為太仆。二年，夫與長樂衛尉竇甫飲，輕重不得，夫醉，搏甫。甫，竇太后昆弟也。上恐太后誅夫，徙為燕相。數歲，坐法去官，家居長安。"}],"rationale":"限本篇逐段介紹、事件與說話者的稱呼承接。灌仲孺是灌夫，長孺是韓安國；田蚡與子恬的武安侯按嗣爵前後分開，夫不匹配夫妻、大夫或夫人。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-107-weiqi:p001","text":"魏其侯竇嬰者，孝文后從兄子也。父世觀津人。喜賓客。孝文時，嬰為吳相，病免。孝景初即位，為詹事。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-107-weiqi:m001-0000","start":0,"end":5,"surface":"魏其侯竇嬰","kind":"person","person_id":"nuf_tb9_fjs_A","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m001-0007","start":7,"end":10,"surface":"孝文后","kind":"person","person_id":"l26_mjw_rwe","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m001-0015","start":15,"end":16,"surface":"父","kind":"person","person_id":"nuf_tb9_fjs","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m001-0025","start":25,"end":27,"surface":"孝文","kind":"person","person_id":"dbk_7yu_n8i","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m001-0029","start":29,"end":30,"surface":"嬰","kind":"person","person_id":"nuf_tb9_fjs_A","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m001-0037","start":37,"end":39,"surface":"孝景","kind":"person","person_id":"4gj_xfa_r7s","status":"contextual_provisional"}],"chapter_id":"c-shiji-107-weiqi","book_id":"b-shiji-107","work_id":"w-shiji","source_id":"s-shiji-107-weiqi"},{"id":"c-shiji-107-weiqi:p002","text":"梁孝王者，孝景弟也，其母竇太后愛之。梁孝王朝，因昆弟燕飲。是時上未立太子，酒酣，從容言曰：「千秋之後傳梁王。」太后驩。竇嬰引卮酒進上，曰：「天下者，高祖天下，父子相傳，此漢之約也，上何以得擅傳梁王！」太后由此憎竇嬰。竇嬰亦薄其官，因病免。太后除竇嬰門籍，不得入朝請。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-107-weiqi:m002-0000","start":0,"end":3,"surface":"梁孝王","kind":"person","person_id":"0d9_tws_4v6","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m002-0005","start":5,"end":7,"surface":"孝景","kind":"person","person_id":"4gj_xfa_r7s","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m002-0012","start":12,"end":15,"surface":"竇太后","kind":"person","person_id":"l26_mjw_rwe","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m002-0018","start":18,"end":21,"surface":"梁孝王","kind":"person","person_id":"0d9_tws_4v6","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m002-0051","start":51,"end":53,"surface":"梁王","kind":"person","person_id":"0d9_tws_4v6","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m002-0059","start":59,"end":61,"surface":"竇嬰","kind":"person","person_id":"nuf_tb9_fjs_A","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m002-0074","start":74,"end":76,"surface":"高祖","kind":"person","person_id":"2ws_c97_c69","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m002-0096","start":96,"end":98,"surface":"梁王","kind":"person","person_id":"0d9_tws_4v6","status":"contextual_provisional"},{"id":"c-shiji