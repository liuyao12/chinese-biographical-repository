"person","person_id":"vgn_ry9_ujs","status":"contextual_provisional","paragraph_id":"c-shiji-090-wei:p009","chapter_id":"c-shiji-090-wei"},{"id":"c-shiji-090-wei:m009-0225","start":225,"end":227,"surface":"留侯","kind":"person","person_id":"vgn_ry9_ujs","status":"contextual_provisional","paragraph_id":"c-shiji-090-wei:p009","chapter_id":"c-shiji-090-wei"}],"relations":[],"title_holdings":[{"id":"th-shiji090-010","person_id":"vgn_ry9_ujs","title":"留侯","kind":"noble_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-090-wei","source_id":"s-shiji-090-wei","paragraph_id":"c-shiji-090-wei:p009","quote":"漢王敗，使使召彭越并力擊楚。越曰：「魏地初定，尚畏楚，未可去。」漢王追楚，為項籍所敗碧陵。乃謂留侯曰：「諸侯兵不從，為之柰何？」留侯曰：「齊王信之立，非君王之意，信亦不自堅。彭越本定梁地，功多，始君王以魏豹故，拜彭越為魏相國。今豹死毋後，且越亦欲王，而君王不蚤定。與此兩國約：即勝楚，睢陽以北至穀城，皆以王彭相國；從陳以東傅海，與齊王信。齊王信家在楚，此其意欲復得故邑。君王能出捐此地許二人，二人今可致；即不能，事未可知也。」於是漢王乃發使使彭越，如留侯策。使者至，彭越乃悉引兵會垓下，遂破楚。（五年）項籍已死。春，立彭越為梁王，都定陶。"}],"attestations":[{"id":"th-shiji090-010:a001","paragraph_id":"c-shiji-090-wei:p009","start":47,"end":49,"surface":"留侯","person_mention_id":"c-shiji-090-wei:m009-0047","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予與用稱分存；擬立周市而辭不記授爵，未明起訖留未知。魏豹被虜與被殺不自動作所有稱號終點。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji090-023","person_id":"vgn_ry9_ujs","surfaces":["留侯"],"scope":"same_chapter","chapter_ids":["c-shiji-090-wei"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-090-wei:p009","quote":"漢王敗，使使召彭越并力擊楚。越曰：「魏地初定，尚畏楚，未可去。」漢王追楚，為項籍所敗碧陵。乃謂留侯曰：「諸侯兵不從，為之柰何？」留侯曰：「齊王信之立，非君王之意，信亦不自堅。彭越本定梁地，功多，始君王以魏豹故，拜彭越為魏相國。今豹死毋後，且越亦欲王，而君王不蚤定。與此兩國約：即勝楚，睢陽以北至穀城，皆以王彭相國；從陳以東傅海，與齊王信。齊王信家在楚，此其意欲復得故邑。君王能出捐此地許二人，二人今可致；即不能，事未可知也。」於是漢王乃發使使彭越，如留侯策。使者至，彭越乃悉引兵會垓下，遂破楚。（五年）項籍已死。春，立彭越為梁王，都定陶。"}],"rationale":"依同段及連