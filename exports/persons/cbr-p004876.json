{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004876","canonical_person_id":"ehx_l0f_ti8","id_aliases":["cbr-p004876"],"identity_policy":"contextual_provisional","person_ids":["ehx_l0f_ti8"],"persons":[{"id":"ehx_l0f_ti8","label":"秦孝公引古（李斯列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"秦孝公","mention_ids":["c-shiji-087-lisi:m003-0112"]},{"surface":"孝公","mention_ids":["c-shiji-087-lisi:m005-0076"]}],"evidence":[{"mention_id":"c-shiji-087-lisi:m003-0112","chapter_id":"c-shiji-087-lisi","paragraph_id":"c-shiji-087-lisi:p003","quote":"秦孝公"},{"mention_id":"c-shiji-087-lisi:m005-0076","chapter_id":"c-shiji-087-lisi","paragraph_id":"c-shiji-087-lisi:p005","quote":"孝公"}],"id_aliases":["cbr-p004876"]}],"source_mention_summary":[{"source_id":"s-shiji-087-lisi","work_id":"w-shiji","book_id":"b-shiji-087","chapter_id":"c-shiji-087-lisi","mention_count":2,"mention_ids":["c-shiji-087-lisi:m003-0112","c-shiji-087-lisi:m005-0076"],"paragraph_ids":["c-shiji-087-lisi:p003","c-shiji-087-lisi:p005"],"passage_count":2}],"most_mentioned_source_ids":["s-shiji-087-lisi"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-087-lisi:m003-0112","start":112,"end":115,"surface":"秦孝公","kind":"person","person_id":"ehx_l0f_ti8","status":"contextual_provisional","paragraph_id":"c-shiji-087-lisi:p003","chapter_id":"c-shiji-087-lisi"},{"id":"c-shiji-087-lisi:m005-0076","start":76,"end":78,"surface":"孝公","kind":"person","person_id":"ehx_l0f_ti8","status":"contextual_provisional","paragraph_id":"c-shiji-087-lisi:p005","chapter_id":"c-shiji-087-lisi"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji087-009","person_id":"ehx_l0f_ti8","surfaces":["孝公","秦孝公"],"scope":"same_chapter","chapter_ids":["c-shiji-087-lisi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-087-lisi:p003","quote":"至秦，會莊襄王卒，李斯乃求為秦相文信侯呂不韋舍人；不韋賢之，任以為郎。李斯因以得說，說秦王曰：「胥人者，去其幾也。成大功者，在因瑕釁而遂忍之。昔者秦穆公之霸，終不東并六國者，何也？諸侯尚眾，周德未衰，故五伯迭興，更尊周室。自秦孝公以來，周室卑微，諸侯相兼，關東為六國，秦之乘勝役諸侯，蓋六世矣。今諸侯服秦，譬若郡縣。夫以秦之彊，大王之賢，由灶上騷除，足以滅諸侯，成帝業，為天下一統，此萬世之一時也。今怠而不急就，諸侯復彊，相聚約從，雖有黃帝之賢，不能并也。」秦王乃拜斯為長史，聽其計，陰遣謀士齎持金玉以游說諸侯。諸侯名士可下以財者，厚遺結之；不肯者，利劍刺之。離其君臣之計，秦王乃使其良將隨其後。秦王拜斯為客卿。"},{"paragraph_id":"c-shiji-087-lisi:p005","quote":"臣聞吏議逐客，竊以為過矣。昔繆公求士，西取由余於戎，東得百里奚於宛，迎蹇叔於宋，來丕豹、公孫支於晉。此五子者，不產於秦，而繆公用之，并國二十，遂霸西戎。孝公用商鞅之法，移風易俗，民以殷盛，國以富彊，百姓樂用，諸侯親服，獲楚、魏之師，舉地千里，至今治彊。惠王用張儀之計，拔三川之地，西并巴、蜀，北收上郡，南取漢中，包九夷，制鄢、郢，東據成皋之險，割膏腴之壤，遂散六國之從，使之西面事秦，功施到今。昭王得范睢，廢穰侯，逐華陽，彊公室，杜私門，蠶食諸侯，使秦成帝業。此四君者，皆以客之功。由此觀之，客何負於秦哉！向使四君卻客而不內，疏士而不用，是使國無富利之實而秦無彊大之名也。"}],"rationale":"依李斯入秦及諫逐客書局部承接暫接；辭師時秦王未定，與莊襄王卒後所說秦王分開候選，未按同稱全域合併。引古人物與黃帝傳說性分存，短稱斯限李斯敘事。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-087-lisi:p003","text":"至秦，會莊襄王卒，李斯乃求為秦相文信侯呂不韋舍人；不韋賢之，任以為郎。李斯因以得說，說秦王曰：「胥人者，去其幾也。成大功者，在因瑕釁而遂忍之。昔者秦穆公之霸，終不東并六國者，何也？諸侯尚眾，周德未衰，故五伯迭興，更尊周室。自秦孝公以來，周室卑微，諸侯相兼，關東為六國，秦之乘勝役諸侯，蓋六世矣。今諸侯服秦，譬若郡縣。夫以秦之彊，大王之賢，由灶上騷除，足以滅諸侯，成帝業，為天下一統，此萬世之一時也。今怠而不急就，諸侯復彊，相聚約從，雖有黃帝之賢，不能并也。」秦王乃拜斯為長史，聽其計，陰遣謀士齎持金玉以游說諸侯。諸侯名士可下以財者，厚遺結之；不肯者，利劍刺之。離其君臣之計，秦王乃使其良將隨其後。秦王拜斯為客卿。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-087-lisi:m003-0004","start":4,"end":7,"surface":"莊襄王","kind":"person","person_id":"0cu_hq2_9t8","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m003-0009","start":9,"end":11,"surface":"李斯","kind":"person","person_id":"5ok_joj_etv","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m00