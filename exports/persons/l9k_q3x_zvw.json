:"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-050-princes-complete:p008:m0088","start":88,"end":91,"surface":"黃林夫","kind":"person","person_id":"l9k_q3x_zvw","status":"contextual_provisional","paragraph_id":"c-nanqishu-050-princes-complete:p008","chapter_id":"c-nanqishu-050-princes-complete"},{"id":"c-nanqishu-050-princes-complete:p008:m0123","start":123,"end":125,"surface":"林夫","kind":"person","person_id":"l9k_q3x_zvw","status":"contextual_provisional","paragraph_id":"c-nanqishu-050-princes-complete:p008","chapter_id":"c-nanqishu-050-princes-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-050-princes-complete:p008","text":"　　寶玄娶尚書令徐孝嗣女爲妃，孝嗣被誅離絕，少帝送少姬二人與之，寶玄恨望，密有異計。明年，崔慧景舉兵，還至廣陵，遣使奉寶玄爲主。寶玄斬其使，因是發將吏防城。帝遣馬軍主戚平、外監黃林夫助鎮京口。慧景將渡江，寶玄密與相應，殺司馬孔矜、典籤呂承緒及平、林夫，開門納慧景。使長史沈佚之、諮議柳憕分部軍衆，乘八掆輿，手執絳麾幡，隨慧景至京師，住東城，百姓多往投集。慧景敗，收得朝野投寶玄及慧景軍名，帝令燒之，曰：「江夏尚爾，豈復可罪餘人。」寶玄逃奔數日乃出。帝召入後堂，以步鄣裹之，令羣小數十人鳴鼓角馳繞其外，遣人謂寶玄曰：「汝近圍我亦如此。」少日乃殺之。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":30,"last_line":30,"raw_start":1401,"raw_end":1674,"raw_character_offsets":[1401,1402,1403,1404,1405,1406,1407,1408,1409,1410,1411,1412,1413,1414,1415,1416,1417,1418,1419,1420,1421,1422,1423,1424,1425