orial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-054-lvmeng:line071:m0053","start":53,"end":55,"surface":"樊本","kind":"person","person_id":"y2s_qto_s79","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-054-lvmeng:line071","chapter_id":"c-sanguozhi-054-lvmeng"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-054-lvmeng:line071","text":"郝子太聞世間有忠義事，亦欲為之，而不知時也。左將軍在漢中，為夏侯淵所圍。關羽在南郡，今至尊身自臨之。近者破樊本屯，救酃，逆為孫規所破。此皆目前之事，君所親見也。彼方首尾倒懸，救死不給，豈有餘力復營此哉？今吾士卒精銳，人思致命。至尊遣兵，相繼於道。今子太以旦夕之命，待不可望之救。猶牛蹄中魚，冀賴江漢，其不可恃亦明矣。若子太必能一士卒之心，保孤城之守，尚能稽延旦夕，以待所歸者，可也。今吾計力度慮，而以攻此，曾不移日，而城必破，城破之後，身死何益於事，而令百歲老母，戴白受誅，豈不痛哉？度此家不得外問，謂援可恃，故至於此耳。君可見之，為陳禍福。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-054-lvmeng:line071:m0000","start":0,"end":3,"surface":"郝子太","kind":"person","person_id":"w6s_yzx_gu2","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-lvmeng:line071:m0022","start":22,"end":25,"surface":"左將軍","kind":"person","person_id":"5f2_396_25c","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-lvmeng:line071:m0030","start":30,"end":33,"surface":"夏侯淵","kind":"person","person_id":"2lq_s75_r7d","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-lvmeng:line071:m0036","start":36,"end":38,"surface":"關羽","kind":"person","person_id":"1c2_03c_9ea","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-lvmeng:line071:m0053","start":53,"end":55,"surface":"樊本","kind":"person","person_id":"y2s_qto_s79","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文