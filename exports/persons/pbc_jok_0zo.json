ce_ids":["s-jinshu-054-lu-ji-ws2605147"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin054-volume-chao-brother","subject_person_id":"pbc_jok_0zo","object_person_id":"bmo_6e2_cfl","predicate":"brother","qualifiers":{"source_term":"孟玖弟超"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-054","chapter_id":"c-jinshu-054-lu-ji","source_id":"s-jinshu-054-lu-ji-ws2605147","paragraph_id":"c-jinshu-054-lu-ji:p030","quote":"初，宦人孟玖弟超並為穎所嬖寵。超領萬人為小都督，未戰，縱兵大掠。機錄其主者。超將鐵騎百餘人，直入機麾下奪之，顧謂機曰：「貉奴能作督不！」機司馬孫拯勸機殺之，機不能用。超宣言於眾曰：「陸機將反。」又還書與玖言機持兩端，軍不速決。及戰，超不受機節度，輕兵獨進而沒。玖疑機殺之，遂譖機於穎，言其有異志。將軍王闡、郝昌、公師籓等皆玖所用，與牽秀等共證之。穎大怒，使秀密收機。其夕，機夢黑幰繞車，手決不開，天明而秀兵至。機釋戎服，著白帢，與秀相見，神色自若，謂秀曰：「自吳朝傾覆，吾兄弟宗族蒙國重恩，入侍帷幄，出剖符竹。成都命吾以重任，辭不獲已。今日受誅，豈非命也！」因與穎箋，詞甚淒惻。既而歎曰：「華亭鶴唳，豈可復聞乎！」遂遇害於軍中，時年四十三。二子蔚、夏亦同被害。機既死非其罪，士卒痛之，莫不流涕。是日昏霧晝合，大風折木，平地尺雪，議者以為陸氏之冤。","subject_person_mention_id":"c-jinshu-054-lu-ji:p030:m0007","object_person_mention_id":"c-jinshu-054-lu-ji:p030:m0004"}],"status":"source_attested","interpretation_note":"超為孟玖弟。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"a-wu058-meng-brother","subject_person_id":"bmo_6e2_cfl","object_person_id":"pbc_jok_0zo","predicate":"brother","qualifiers":{"source_term":"玖弟超"},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-058","chapter_id":"c-sanguozhi-058-lukang","source_id":"s-sanguozhi-058-lukang","paragraph_id":"c-sanguozhi-058-lukang:line087-pei02-02","quote":"《机云别传》曰：晋太康末，俱入洛，造司空张华，华一见而奇之，曰：「伐吴之役，利在获二俊。」遂为之延誉，荐之诸公。太傅杨骏辟机为祭酒，转太子洗马、尚书著作郎。云为吴王郎中令，出宰浚仪，甚有惠政，吏民怀之，生为立祠。后并历显位。机天才绮练，文藻之美，独冠於时。云亦善属文，清新不及机，而口辩持论过之。于时朝廷多故，机、云并自结於成都王颖。颖用机为平原相，云清河内史。寻转云右司马，甚见委仗。无几而与长沙王构隙，遂举兵攻洛，以机行后将军，督王粹、牵秀等诸军二十万，士龙著南征赋以美其事。机吴人，羁旅单宦，顿居群士之右，多不厌服。机屡战失利，死散过半。初，宦人孟玖，颖所嬖幸，乘宠豫权，云数言其短，颖不能纳，玖又从而毁之。是役也，玖弟超亦领众配机，不奉军令。机绳之以法，超宣言曰陆机将反。及牵秀等谮机於颖，以为持两端，玖又构之於内，颖信之，遣收机，并收云及弟耽，并伏法。机兄弟既江南之秀，亦著名诸夏，并以无罪夷灭，天下痛惜之。机文章为世所重，云所著亦传於世。","subject_person_mention_id":"c-sanguozhi-058-lukang:line087-pei02-02:m0277","object_person_mention_id":"c-sanguozhi-058-lukang:line087-pei02-02:m0313"}],"interpretation_note":"以此來源所述兩端為據。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-054-lu-ji:p030:m0007","start":7,"end":8,"surface":"超","kind":"person","person_id":"pbc_jok_0zo","status":"contextual_provisional","paragraph_id":"c-jinshu-054-lu-ji:p030","chapter_id":"c-jinshu-054-lu-ji"},{"id":"c-jinshu-054-lu-ji:p030:m0015","start":15,"end":16,"surface":"超","kind":"person","person_id":"pbc_jok_0zo","status":"contextual_provisional","paragraph_id":"c-jinshu-054-lu-ji:p030","chapter_id":"c-jinshu-054-lu-ji"},{"id":"c-jinshu-054-lu-ji:p030:m0038","start":38,"end":39,"surface":"超","kind":"person","person_id":"pbc_jok_0zo","status":"contextual_provisional","paragraph_id":"c-jinshu-054-lu-ji:p030","chapter_id":"c-jinshu-054-lu-ji"},{"id":"c-jinshu-054-lu-ji:p030:m0083","start":83,"end":84,"surface":"超","kind":"person","person_id":"pbc_jok_0zo","status":"contextual_provisional","paragraph_id":"c-jinshu-054-lu-ji:p030","chapter_id":"c-jinshu-054-lu-ji"},{"id":"c-jinshu-054-lu-ji:p030:m0116","start":116,"end":117,"surface":"超","kind":"person","person_id":"pbc_jok_0zo","status":"contextual_provisional","paragraph_id":"c-jinshu-054-lu-ji:p030","chapter_id":"c-jinshu-054-lu-ji"},{"id":"c-sanguozhi-058-lukang:line087-pei02-02:m0313","start":313,"end":314,"surface":"超","kind":"person","person_id":"pbc_jok_0zo","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-058-lukang:line087-pei02-02","chapter_id":"c-sanguozhi-058-lukang"},{"id":"c-sanguozhi-058-lukang:line087-pei02-02:m0331","start":331,"end":332,"surface":"超","kind":"person","person_id":"pbc_jok_0zo","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-058-lukang:line087-pei02-02","chapter_id":"c-sanguozhi-058-lukang"}],"relations":[{"id":"a-jin054-volume-chao-brother","subject_person_id":"pbc_jok_0zo","object_person_id":"bmo_6e2_cfl","predicate":"brother","qualifiers":{"source_term":"孟玖弟超"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-054","chapter_id":"c-jinshu-054-lu-ji","source_id":"s-jinshu-054-lu-ji-ws2605147","paragraph_id":"c-jinshu-054-lu-ji:p030","quote":"初，宦人孟玖弟超並為穎所嬖寵。超領萬人為小都督，未戰，縱兵大掠。機錄其主者。超將鐵騎百餘人，直入機麾下奪之，顧謂機曰：「貉奴能作督不！」機司馬孫拯勸機殺之，機不能用。超宣言於眾曰：「陸機將反。」又還書與玖言機持兩端，軍不速決。及戰，超不受機節度，輕兵獨進而沒。玖疑機殺之，遂譖機於穎，言其有異志。將軍王闡、郝昌、公師籓等皆玖所用，與牽秀等共證之。穎大怒，使秀密收機。其夕，機夢黑幰繞車，手決不開，天明而秀兵至。機釋戎服，著白帢，與秀相見，神色自若，謂秀曰：「自吳朝傾覆，吾兄弟宗族蒙國重恩，入侍帷幄，出剖符竹。成都命吾以重任，辭不獲已。今日受誅，豈非命也！」因與穎箋，詞甚淒惻。既而歎曰：「華亭鶴唳，豈可復聞乎！」遂遇害於軍中，時年四十三。二子蔚、夏亦同被害。機既死非其罪，士卒痛之，莫不流涕。是日昏霧晝合，大風折木，平地尺雪，議者以為陸氏之冤。","subject_person_mention_id":"c-jinshu-054-lu-ji:p030:m0007","object_person_mention_id":"c-jinshu-054-lu-ji:p030:m0004"}],"status":"source_attested","interpretation_note":"超為孟玖弟。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"a-wu058-meng-brother","subject_person_id":"bmo_6e2_cfl","object_person_id":"pbc_jok_0zo","predicate":"brother","qualifiers":{"source_term":"玖弟超"},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-058","chapter_id":"c-sanguozhi-058-lukang","source_id":"s-sanguozhi-058-lukang","paragraph_id":"c-sanguozhi-058-lukang:line087-pei02-02","quote":"《机云别传》曰：晋太康末，俱入洛，造司空张华，华一见而奇之，曰：「伐吴之役，利在获二俊。」遂为之延誉，荐之诸公。太傅杨骏辟机为祭酒，转太子洗马、尚书著作郎。云为吴王郎中令，出宰浚仪，甚有惠政，吏民怀之，生为立祠。后并历显位。机天才绮练，文藻之美，独冠於时。云亦善属文，清新不及机，而口辩持论过之。于时朝廷多故，机、云并自结於成都王颖。颖用机为平原相，云清河内史。寻转云右司马，甚见委仗。无几而与长沙王构隙，遂举兵攻洛，以机行后将军，督王粹、牵秀等诸军二十万，士龙著南征赋以美其事。机吴人，羁旅单宦，顿居群士之右，多不厌服。机屡战失利，死散过半。初，宦人孟玖，颖所嬖幸，乘宠豫权，云数言其短，颖不能纳，玖又从而毁之。是役也，玖弟超亦领众配机，不奉军令。机绳之以法，超宣言曰陆机将反。及牵秀等谮机於颖，以为持两端，玖又构之於内，颖信之，遣收机，并收云及弟耽，并伏法。机兄弟既江南之秀，亦著名诸夏，并以无罪夷灭，天下痛惜之。机文章为世所重，云所著亦传於世。","subject_person_mention_id":"c-sanguozhi-058-lukang:line087-pei02-02:m0277","object_person_mention_id":"c-sanguozhi-058-lukang:line087-pei02-02:m0313"}],"interpretation_note":"以此來源所述兩端為據。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-054-lu-ji:p030","text":"初，宦人孟玖弟超並為穎所嬖寵。超領萬人為小都督，未戰，縱兵大掠。機錄其主者。超將鐵騎百餘人，直入機麾下奪之，顧謂機曰：「貉奴能作督不！」機司馬孫拯勸機殺之，機不能用。超宣言於眾曰：「陸機將反。」又還書與玖言機持兩端，軍不速決。及戰，超不受機節度，輕兵獨進而沒。玖疑機殺之，遂譖機於穎，言其有異志。將軍王闡、郝昌、公師籓等皆玖所用，與牽秀等共證之。穎大怒，使秀密收機。其夕，機夢黑幰繞車，手決不開，天明而秀兵至。機釋戎服，著白帢，與秀相見，神色自若，謂秀曰：「自吳朝傾覆，吾兄弟宗族蒙國重恩，入侍帷幄，出剖符竹。成都命吾以重任，辭不獲已。今日受誅，豈非命也！」因與穎箋，詞甚淒惻。既而歎曰：「華亭鶴唳，豈可復聞乎！」遂遇害於軍中，時年四十三。二子蔚、夏亦同被害。機既死非其罪，士卒痛之，莫不流涕。是日昏霧晝合，大風折木，平地尺雪，議者以為陸氏之冤。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":70,"last_line":70,"raw_start":7131,"raw_end":7504,"raw_character_offsets":[7131,7132,7133,7134,7135,7136,7137,7138,7139,7140,7141,7142,7143,7144,7145,7146,7147,7148,7149,7150,7151,7152,7153,7154,7155,7156,7157,7158,7159,7160,7161,7162,7163,7164,7165,7166,7167,7168,7169,7170,7171,7172,7173,7174,7175,7176,7177,7178,7179,7180,7181,7182,7183,7184,7185,7186,7187,7188,7189,7190,7191,7192,7193,7194,7195,7196,7197,7198,7199,7200,7201,7202,7203,7204,7205,7206,7207,7208,7209,7210,7211,7212,7213,7214,7215,7216,7217,7218,7219,7220,7221,7222,7223,7224,7225,7226,7227,7228,7229,7230,7231,7232,7233,7234,7235,7236,7237,7238,7239,7240,7241,7242,7243,7244,7245,7246,7247,7248,7249,7250,7251,7252,7253,7254,7255,7256,7257,7258,7259,7260,7261,7262,7263,7264,7265,7266,7267,7268,7269,7270,7271,7272,7273,7274,72