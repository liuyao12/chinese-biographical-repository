u041-ws1512987","chapter_id":"c-liangshu-041-wanggui-ws1512987","paragraph_id":"c-liangshu-041-wanggui-ws1512987:p004","mention_id":"c-liangshu-041-wanggui-ws1512987:p004:m0097","quote":"皇太子"},{"work_id":"w-liangshu","book_id":"b-liangshu-041","source_id":"s-liangshu041-ws1512987","chapter_id":"c-liangshu-041-wanggui-ws1512987","paragraph_id":"c-liangshu-041-wanggui-ws1512987:p004","mention_id":"c-liangshu-041-wanggui-ws1512987:p004:m0270","quote":"皇太子"},{"work_id":"w-zhoushu","book_id":"b-zhoushu-041","source_id":"s-zhoushu041-ws2432538","chapter_id":"c-zhoushu-041-wangbao-ws2432538","paragraph_id":"c-zhoushu-041-wangbao-ws2432538:p002","mention_id":"c-zhoushu-041-wangbao-ws2432538:p002:m0129","quote":"簡文帝"},{"work_id":"w-liangshu","book_id":"b-liangshu-004","source_id":"s-liangshu004-liang-close-family","chapter_id":"c-liangshu-004-liang-close-family","paragraph_id":"c-liangshu-004-liang-close-family:p001","mention_id":"c-liangshu-004-liang-close-family:p001:m0002","quote":"太宗簡文皇帝"},{"work_id":"w-liangshu","book_id":"b-liangshu-004","source_id":"s-liangshu004-liang-close-family","chapter_id":"c-liangshu-004-liang-close-family","paragraph_id":"c-liangshu-004-liang-close-family:p001","mention_id":"c-liangshu-004-liang-close-family:p001:m0009","quote":"綱"},{"work_id":"w-chenshu","book_id":"b-chenshu-013","chapter_id":"c-chenshu-013-xunlang-rendered","source_id":"s-chenshu-013-ws1511906-rendered-xunlang","paragraph_id":"c-chenshu-013-xunlang-rendered:p002","quote":"簡文帝","mention_id":"c-chenshu-013-xunlang-rendered:p002:m0008"},{"work_id":"w-liangshu","book_id":"b-liangshu-033","source_id":"s-liangshu-033-current-rendered-wangyun","chapter_id":"c-liangshu-033-wangyun-rendered","paragraph_id":"c-liangshu-033-wangyun-rendered:p005","mention_id":"c-liangshu-033-wangyun-rendered:p005:m0006","quote":"太宗"}],"review":"ai_provisional","identity_note":"固定梁書1512987完整王規及附傳單元的來源內人物；暫存來源局部身份，與外篇同名未逕合。未用後出新唐書遠祖鏈補身份或中間世代。","family_path":{"connection":"father","parent_person_id":"cav_2xc_9bq_AA","source_assertion_id":"a-liang-close-family-liangjian-father-liangwu","status":"contextual_provisional","human_reviewed":false,"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-004","source_id":"s-liangshu004-liang-close-family","chapter_id":"c-liangshu-004-liang-close-family","paragraph_id":"c-liangshu-004-liang-close-family:p001","quote":"　　太宗簡文皇帝諱綱，字世纘，小字六通，高祖第三子，昭明太子母弟也。天監二年十月丁未，生於顯陽殿。五年，封晉安王，食邑八千戶。八年，為雲麾將軍，領石頭戍軍事，量置佐吏。九年，遷使持節、都督南北兗青徐冀五州諸軍事、宣毅將軍、南兗州刺史。十二年，入為宣惠將軍、丹陽尹。十三年，出為使持節、都督荊雍梁南北秦益寧七州諸軍事、南蠻校尉、荊州刺史，將軍如故。十四年，徙為都督江州諸軍事、雲麾將軍、江州刺史，持節如故。十七年，徵為西中郎將、領石頭戍軍事，尋復為宣惠將軍、丹陽尹，加侍中。普通元年，出為使持節、都督益寧雍梁南北秦沙七州諸軍事、益州刺史；未拜，改授雲麾將軍、南徐州刺史。四年，徙為使持節、都督雍梁、南北秦四州郢州之竟陵司州之隨郡諸軍事，平西將軍、寧蠻校尉、雍州刺史。五年，進號安北將軍。七年，權進都督荊、益、南梁三州諸軍事。是歲，丁所生穆貴嬪喪，上表陳解，詔還攝本任。中大通元年，詔依先給鼓吹一部。二年，徵為都督南揚、徐二州諸軍事、驃騎將軍、揚州刺史。三年四月乙巳，昭明太子薨。五月丙申，詔曰：「非至公無以主天下，非博愛無以臨四海。所以堯舜克讓，惟德是與；文王舍伯邑考而立武王，格于上下，光于四表。今岱宗牢落，天步艱難，淳風猶鬱，黎民未乂，自非克明克哲，允武允文，豈能荷神器之重，嗣龍圖之尊。晉安王綱，文義生知，孝敬自然，威惠外宣，德行內敏，羣后歸美，率土宅心。可立為皇太子。」七月乙亥，臨軒策拜，以脩繕東宮，權居東府。四年九月，移還東宮。","subject_person_mention_id":"c-liangshu-004-liang-close-family:p001:m0002","object_person_mention_id":"c-liangshu-004-liang-close-family:p001:m0020","source_term":"高祖第三子"}],"interpretation_note":"明父子來源支援的一代家族路徑；字母為身份配置，不是全體/嫡子出生排行，不由同姓或帝號推祖先。"}},{"id":"cav_2xc_9bq_AAAA","label":"宣成王大器","status":"active","historicity":"historical_tradition","aliases":[{"surface":"宣成王大器","mention_ids":["c-zhoushu-041-wangbao-ws2432538:p002:m0123"]}],"evidence":[{"work_id":"w-zhoushu","book_id":"b-zhoushu-041","source_id":"s-zhoushu041-ws2432538","chapter_id":"c-zhoushu-041-wangbao-ws2432538","paragraph_id":"c-zhoushu-041-wangbao-ws2432538:p002","mention_id":"c-zhoushu-041-wangbao-ws2432538:p002:m0123","quote":"宣成王大器"}],"review":"ai_provisional","identity_note":"固定WS2432538周書041王襃完整單元的來源局部人物；跨源同指未定不等於必與他篇同名異人。未補遠祖、中間代、未名父母、任期或生卒。","family_path":{"connection":"father","parent_person_id":"cav_2xc_9bq_AAA","source_assertion_id":"a-zhou041-close-kin-daqifather","status":"contextual_provisional","human_reviewed":false,"evidence":[{"work_id":"w-zhoushu","book_id":"b-zhoushu-041","source_id":"s-zhoushu041-ws2432538","chapter_id":"c-zhoushu-041-wangbao-ws2432538","paragraph_id":"c-zhoushu-041-wangbao-ws2432538:p002","quote":"襃識量淵通，志懷沉靜。美風儀，善談笑，博覽史傳，尤工屬文。梁國子祭酒蕭子雲，襃之姑夫也，特善草隸。襃少以姻戚，去來其家，遂相模範。俄而名亞子雲，竝見重於世。梁武帝喜其才藝，遂以弟鄱陽王恢之女妻之。起家祕書郎，轉太子舍人，襲爵南昌縣侯。稍遷祕書丞。宣成王大器，簡文帝之冢嫡，即襃之姑子也。于時盛選僚佐，乃以襃為文學。尋遷安成郡守。及侯景渡江，建業擾亂，襃輯寧所部，見稱於時。","subject_person_mention_id":"c-zhoushu-041-wangbao-ws2432538:p002:m0123","object_person_mention_id":"c-zhoushu-041-wangbao-ws2432538:p002:m0129","source_term":"冢嫡"}],"interpretation_note":"明父子來源支援的一代家族路徑；字母為身份配置，不是全體/嫡子出生排行，不由同姓或帝號推祖先。"}}],"source_mention_summary":[{"source_id":"s-zhoushu041-ws2432538","work_id":"w-zhoushu","book_id":"b-zhoushu-041","chapter_id":"c-zhoushu-041-wangbao-ws2432538","raw_mention_count":1,"mention_ids":["c-zhoushu-041-wangbao-ws2432538:p002:m0123"],"paragraph_ids":["c-zhoushu-041-wangbao-ws2432538:p002"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-zhoushu-041-wangbao-ws2432538:p002:m0123","mention_ids":["c-zhoushu-041-wangbao-ws2432538:p002:m0123"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-zhoushu041-ws2432538"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-zhou041-close-kin-daqifather","subject_person_id":"cav_2xc_9bq_AAAA","predicate":"father","object_person_i