ji-006-shihuang"},{"id":"c-shiji-006-shihuang:m019-0010","start":10,"end":12,"surface":"王賁","kind":"person","person_id":"cbr-p000567","status":"contextual_provisional","paragraph_id":"c-shiji-006-shihuang:p019","chapter_id":"c-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:m020-0026","start":26,"end":30,"surface":"將軍王賁","kind":"person","person_id":"cbr-p000567","status":"contextual_provisional","paragraph_id":"c-shiji-006-shihuang:p020","chapter_id":"c-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:p030:m0032","start":32,"end":39,"surface":"列侯通武侯王賁","kind":"person","person_id":"cbr-p000567","status":"contextual_provisional","paragraph_id":"c-shiji-006-shihuang:p030","chapter_id":"c-shiji-006-shihuang"},{"id":"c-shiji-034-yan:m034-0022","start":22,"end":26,"surface":"秦將王賁","kind":"person","person_id":"cbr-p000567","status":"contextual_provisional","paragraph_id":"c-shiji-034-yan:p034","chapter_id":"c-shiji-034-yan"}],"relations":[],"title_holdings":[{"id":"th-shiji034-057","person_id":"cbr-p000567","title":"將","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-034-yan","source_id":"s-shiji-034-yan","paragraph_id":"c-shiji-034-yan:p034","quote":"是歳，秦將王賁亦虜代王嘉。"}],"attestations":[{"id":"th-shiji034-057:a001","paragraph_id":"c-shiji-034-yan:p034","start":23,"end":24,"surface":"將","person_mention_id":"c-shiji-034-yan:m034-0022","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"秦將用稱，只述本次戰事；不由其他秦篇通武侯等爵稱推同日起訖。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji034-047","person_id":"cbr-p000567","surfaces":["秦將王賁"],"scope":"cross_chapter","chapter_ids":["c-shiji-006-shihuang","c-shiji-034-yan"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-006-shihuang:p016","quote":"二十年，燕太子丹患秦兵至國，恐，使荊軻刺秦王。秦王覺之，體解軻以徇，而使王翦、辛勝攻燕。燕、代發兵擊秦軍，秦軍破燕易水之西。二十一年，王賁攻薊。乃益發卒詣王翦軍，遂破燕太子軍，取燕薊城，得太子丹之首。燕王東收遼東而王之。王翦謝病老歸。新鄭反。昌平君徙於郢。大雨雪，深二尺五寸。"},{"paragraph_id":"c-shiji-034-yan:p034","quote":"三十三年，秦拔遼東，虜燕王喜，卒滅燕。是歳，秦將王賁亦虜代王嘉。"}],"rationale":"依周初封建、燕君世系、割地救燕、讓國及秦滅諸國的具體語境暫定異稱。繼位不自動證父子；同爵者分國別與前後世代。太子平／燕昭王依本篇明示，不表示年代及世系已校定。作君奭為書名，君奭不説之君奭才暫解召公稱呼。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-006-shihuang:p016","text":"二十年，燕太子丹患秦兵至國，恐，使荊軻刺秦王。秦王覺之，體解軻以徇，而使王翦、辛勝攻燕。燕、代發兵擊秦軍，秦軍破燕易水之西。二十一年，王賁攻薊。乃益發卒詣王翦軍，遂破燕太子軍，取燕薊城，得太子丹之首。燕王東收遼東而王之。王翦謝病老歸。新鄭反。昌平君徙於郢。大雨雪，深二尺五寸。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:m016-0004","start":4,"end":8,"surface":"燕太子丹","kind":"person","person_id":"cbr-p000564","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m016-0017","start":17,"end":19,"surface":"荊軻","kind":"person","person_id":"cbr-p000565","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m016-0020","start":20,"end":22,"surface":"秦王","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官稱或句讀疑問待核；不補造姓名或直接同稱合併。"},{"id":"c-shiji-006-shihuang:m016-0023","start":23,"end":25,"surface":"秦王","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官稱或句讀疑問待核；不補造姓名或直接同稱合併。"},{"id":"c-shiji-006-shihuang:m016-0030","start":30,"end":31,"surface":"軻","kind":"person","person_id":"cbr-p000565","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m016-0036","start":36,"end":38,"surface":"王翦","kind":"person","person_id":"cbr-p000557","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m016-0039","start":39,"end":41,"surface":"辛勝","kind":"person","person_id":"cbr-p000566","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m016-0067","start":67,"end":69,"surface":"王賁","kind":"person","person_id":"cbr-p000567","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m016-0077","start":77,"end":79,"surface":"王翦","kind":"person","person_id":"cbr-p000557","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m016-0094","start":94,"end":97,"surface":"太子丹","kind":"person","person_id":"cbr-p000564","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m016-0100","start":100,"end":102,"surface":"燕王","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官稱或句讀疑問待核；不補造姓名或直接同稱合併。"},{"id":"c-shiji-006-shihuang:m016-0110","start":110,"end":112,"surface":"王翦","kind":"person","person_id":"cbr-p000557","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m016-0121","start":121,"end":124,"surface":"昌平君","kind":"person","person_id":"cbr-p000545","status":"contextual_provisional"}],"chapter_id":"c-shiji-006-shihuang","book_id":"b-shiji-006","work_id":"w-shiji","source_id":"s-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:p017","text":"二十二年，王賁攻魏，引河溝灌大梁，大梁城壞，其王請降，盡取其地。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:m017-0005","start":5,"end":7,"surface":"王賁","kind":"person","person_id":"cbr-p000567","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m017-0022","start":22,"end":24,"surface":"其王","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官稱或句讀疑問待核；不補造姓名或直接同稱合併。"}],"chapter_id":"c-shiji-006-shihuang","book_id":"b-shiji-006","work_id":"w-shiji","source_id":"s-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:p019","text":"二十五年，大興兵，使王賁將，攻燕遼東，得燕王喜。還攻代，虜代王嘉。王翦遂定荊江南地；降越君，置會稽郡。五月，天下大酺。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:m019-0010","start":10,"end":12,"surface":"王賁","kind":"person","person_id":"cbr-p000567","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m019-0020","start":20,"end":23,"surface":"燕王喜","kind":"person","person_id":"cbr-p000569","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m019-0029","start":29,"end":32,"surface":"代王嘉","kind":"person","person_id":"cbr-p000563","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m019-0033","start":33,"end":35,"surface":"王翦","kind":"person","person_id":"cbr-p000557","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m019-0043","start":43,"end":45,"surface":"越君","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官稱或句讀疑問待核；不補造姓名或直接同稱合併。"}],"chapter_id":"c-shiji-006-shihuang","book_id":"b-shiji-006","work_id":"w-shiji","source_id":"s-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:p020","text":"二十六年，齊王建與其相后勝發兵守其西界，不通秦。秦使將軍王賁從燕南攻齊，得齊王建。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:m020-0005","start":5,"end":8,"surface":"齊王建","kind":"person","person_id":"cbr-p000570","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m020-0011","start":11,"end":13,"surface":"后勝","kind":"person","person_id":"cbr-p000571","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m020-0026","start":26,"end":30,"surface":"將軍王賁","kind":"person","person_id":"cbr-p000567","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m020-0037","start":37,"end":40,"surface":"齊王建","kind":"person","person_id":"cbr-p000570","status":"contextual_provisional"}],"chapter_id":"c-shiji-006-shihuang","book_id":"b-shiji-006","work_id":"w-shiji","source_id":"s-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:p030","text":"維秦王兼有天下，立名為皇帝，乃撫東土，至于瑯邪。列侯武城侯王離、列侯通武侯王賁、倫侯建成侯趙亥、倫侯昌武侯成、倫侯武信侯馮毋擇、丞相隗林、丞相王綰、卿李斯、卿王戊、五大夫趙嬰、五大夫楊樛從，與議於海上。曰：「古之帝者，地不過千里，諸侯各守其封域，或朝或否，相侵暴亂，殘伐不止，猶刻金石，以自為紀。古之五帝三王，知教不同，法度不明，假威鬼神，以欺遠方，實不稱名，故不久長。其身未歿，諸侯倍叛，法令不行。今皇帝并一海內，以為郡縣，天下和平。昭明宗廟，體道行德，尊號大成。群臣相與誦皇帝功德，刻于金石，以為表經。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:p030:m0011","start":11,"end":13,"surface":"皇帝","kind":"person","person_id":"cbr-p000533","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p030:m0024","start":24,"end":31,"surface":"列侯武城侯王離","kind":"person","person_id":"cbr-p000575","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p030:m0032","start":32,"end":39,"surface":"列侯通武侯王賁","kind":"person","person_id":"cbr-p000567","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p030:m0040","start":40,"end":47,"surface":"倫侯建成侯趙亥","kind":"person","person_id":"cbr-p000576","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p030:m0048","start":48,"end":54,"surface":"倫侯昌武侯成","kind":"person","person_id":"cbr-p000577","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p030:m0055","start":55,"end":63,"surface":"倫侯武信侯馮毋擇","kind":"person","person_id":"cbr-p000578","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p030:m0064","start":64,"end":68,"surface":"丞相隗林","kind":"person","person_id":"cbr-p000579","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p030:m0069","start":69,"end":73,"surface":"丞相王綰","kind":"person","person_id":"cbr-p000573","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p030:m0074","start":74,"end":77,"surface":"卿李斯","kind":"person","person_id":"cbr-p000537","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p030:m0078","start":78,"end":81,"surface":"卿王戊","kind":"person","person_id":"cbr-p000580","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p030:m0082","start":82,"end":87,"surface":"五大夫趙嬰","kind":"person","person_id":"cbr-p000581","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p030:m0088","start":88,"end":93,"surface":"五大夫楊樛","kind":"person","person_id":"cbr-p000582","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p030:m0150","start":150,"end":154,"surface":"五帝三王","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官號、神祇或未定指代；不補造人物或已知姓名。"},{"id":"c-shiji-006-shihuang:p030:m0201","start":201,"end":203,"surface":"皇帝","kind":"person","person_id":"cbr-p000533","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p030:m0238","start":238,"end":240,"surface":"皇帝","kind":"person","person_id":"cbr-p000533","status":"contextual_provisional"}],"chapter_id":"c-shiji-006-shihuang","book_id":"b-shiji-006","work_id":"w-shiji","source_id":"s-shiji-006-shihuang"},{"id":"c-shiji-034-yan:p034","text":"三十三年，秦拔遼東，虜燕王喜，卒滅燕。是歳，秦將王賁亦虜代王嘉。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-034-yan:m034-0011","start":11,"end":14,"surface":"燕王喜","kind":"person","person_id":"cbr-p000569","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m034-0022","start":22,"end":26,"surface":"秦將王賁","kind":"person","person_id":"cbr-p000567","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m034-0028","start":28,"end":31,"surface":"代王嘉","kind":"person","person_id":"cbr-p000563","status":"contextual_provisional"}],"chapter_id":"c-shiji-034-yan","book_id":"b-shiji-034","work_id":"w-shiji","source_id":"s-shiji-034-yan"}],"sources":[{"chapter_id":"c-shiji-006-shihuang","work_id":"w-shiji","book_id":"b-shiji-006","source_id":"s-shiji-006-shihuang","source":{"title":"史記／卷006","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷006","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷006&oldid=7907969","revision_id":7907969,"accessed_on":"2026-10-09","extent":"數位見證127個文字區塊，含16個dd刻辭或嵌入引文及卷末附載班固記；排除導覽、跨站連結與註號。","image_verified":false,"rights":"古代原文與附載文字；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"note":"正文未改寫；行內校勘標記及附載文字仍待逐處核對。固定版本正文HTML重讀一致。","editorial_readings":[{"paragraph_id":"c-shiji-006-shihuang:p010","witness_form":"（四）［是］","body_reading":"四","note":"數位見證行內校勘標記另存；正文保留改讀前的字，不稱已校定底本。"},{"paragraph_id":"c-shiji-006-shihuang:p016","witness_form":"（薊）［荊］","body_reading":"薊","note":"數位見證行內校勘標記另存；正文保留改讀前的字，不稱已校定底本。"},{"paragraph_id":"c-shiji-006-shihuang:p051","witness_form":"（其）","body_readi