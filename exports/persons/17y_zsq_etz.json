ji-complete-ws1511897"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-qi046-xiaohuiji-huilang","subject_person_id":"ph1_ms8_hyq_ABAA","object_person_id":"17y_zsq_etz","predicate":"brother","qualifiers":{"source_term":"惠基弟惠朗"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-046","chapter_id":"c-nanqishu-046-xiaohuiji-complete","source_id":"s-nanqishu-046-xiaohuiji-complete-ws1511897","paragraph_id":"c-nanqishu-046-xiaohuiji-complete:p004","quote":"　　出爲武陵內史，中書黃門郎。惠基善隷書及弈棊，太祖與之情好相得，早相器遇。桂陽之役，惠基姊爲休範妃，太祖謂之曰：「卿家桂陽遂復作賊。」太祖頓新亭壘，以惠基爲軍副，惠基弟惠朗親爲休範攻戰，惠基在城內了不自疑。出爲豫章太守。還爲吏部郎，遷長兼侍中。袁粲、劉秉起兵之夕，太祖以秉是惠基妹夫，時直在侍中省，遣王敬則觀其指趣，見惠基安靜不與秉相知，由是益加恩信。討沈攸之，加惠基輔國將軍，徙頓新亭。事寧，解軍號，領長水校尉。母憂去官。","subject_person_mention_id":"c-nanqishu-046-xiaohuiji-complete:p004:m0015","object_person_mention_id":"c-nanqishu-046-xiaohuiji-complete:p004:m0085"}],"status":"source_attested","interpretation_note":"桂陽之事共段兩兄弟應對不同。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"a-qi046-xiaohuilang-huixiu","subject_person_id":"17y_zsq_etz","object_person_id":"mkf_lgo_sp9","predicate":"brother","qualifiers":{"source_term":"惠休弟惠朗"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-046","chapter_id":"c-nanqishu-046-xiaohuiji-complete","source_id":"s-nanqishu-046-xiaohuiji-complete-ws1511897","paragraph_id":"c-nanqishu-046-xiaohuiji-complete:p009","quote":"　　惠休弟惠朗。善騎馬，同桂陽賊叛，太祖赦之，復加序用。永明九年，爲西陽王征虜長史，行南兖州事。典籤何益孫贓罪百萬，棄市，惠朗坐免官。","subject_person_mention_id":"c-nanqishu-046-xiaohuiji-complete:p009:m0005","object_person_mention_id":"c-nanqishu-046-xiaohuiji-complete:p009:m0002"}],"status":"source_a