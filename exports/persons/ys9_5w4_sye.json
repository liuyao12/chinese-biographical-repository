suochen:p003:m0042"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-060-jiapi-ws2413335"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-jinshu-060-jiapi:source_review1-0","kind":"source_review","person_id":"ys9_5w4_sye","source_quote":"賈疋，字彥度，武威人，魏太尉詡之曾孫也。少有志略，器望甚偉，見之者莫不悅附，特為武夫之所瞻仰，願為致命。初辟公府，遂曆顯職，遷安定太守。雍州刺史丁綽，貪橫失百姓心，乃譖疋于南陽王模，模以軍司謝班伐之。疋奔瀘水，與胡彭蕩仲及氐竇首結為兄弟，聚眾攻班。綽奔武都，疋復入安定，殺班。湣帝以疋為驃騎將軍、雍州刺史，封酒泉公。時諸郡百姓饑饉，白骨蔽野，百無一存。疋帥戎晉二萬餘人，將伐長安，西平太守竺恢亦固守，劉粲聞之，使劉曜、劉雅及趙染距疋，先攻恢，不克，疋邀擊，大敗之，曜中流矢，退走。疋追之，至於甘泉。旋自渭橋襲蕩仲，殺之。遂迎秦王，奉為皇太子。後蕩仲子夫護帥群胡攻之，疋敗走，夜墮於澗，為夫護所害。疋勇略有志節，以匡復晉室為己任，不幸顛墮，時人咸痛惜之。","reading":"賈疋字彥度、賈詡曾孫；丁綽、謝班事與迎秦王、夫護報仇分錄。","note":"賈疋字彥度、賈詡曾孫；丁綽、謝班事與迎秦王、夫護報仇分錄。","paragraph_id":"c-jinshu-060-jiapi:p001","start_codepoint":0,"end_codepoint":326,"human_reviewed":false,"chapter_id":"c-jinshu-060-jiapi","source_id":"s-jinshu-060-jiapi-ws2413335"},{"id":"c-jinshu-060-jiapi:kinship1-105","kind":"kinship","person_id":"ys9_5w4_sye","source_quote":"與胡彭蕩仲及氐竇首結為兄弟","reading":"盟約以兄弟相稱。","note":"盟約以兄弟相稱。","paragraph_id":"c-jinshu-060-jiapi:p001","start_codepoint":105,"end_codepoint":118,"human_reviewed":false,"chapter_id":"c-jinshu-060-jiapi","source_id":"s-jinshu-060-jiapi-ws2413335"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin060-jiapi-great-grandfather","subject_person_id":"ys9_5w4_sye","object_person_id":"73a_df1_31c","predicate":"grea