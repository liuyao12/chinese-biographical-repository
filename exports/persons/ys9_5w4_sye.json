person","status":"contextual_provisional"},{"id":"c-jinshu-060-suochen:p003:m0049","surface":"梁綜","start":49,"end":51,"person_id":"e8t_3gt_0gz","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-suochen:p003:m0056","surface":"麹允","start":56,"end":58,"person_id":"d81_sg4_39r","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-suochen:p003:m0089","surface":"綝","start":89,"end":90,"person_id":"u3p_4ou_4st","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-suochen:p003:m0094","surface":"李羌","start":94,"end":96,"person_id":"a22_j1p_do5","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-suochen:p003:m0098","surface":"閻鼎","start":98,"end":100,"person_id":"emm_pbx_36w","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-suochen:p003:m0101","surface":"秦王","start":101,"end":103,"person_id":"pss_n95_7x4","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-suochen:p003:m0115","surface":"湣帝","start":115,"end":117,"person_id":"pss_n95_7x4","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-suochen:p003:m0118","surface":"綝","start":118,"end":119,"person_id":"u3p_4ou_4st","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-060-suochen","book_id":"b-jinshu-060","work_id":"w-jinshu","source_id":"s-jinshu-060-suochen-ws2413335"},{"id":"c-jinshu-060-yanding:p002","text":"鼎少有大志，因西土人思歸，欲立功鄉里，乃與撫軍長史王毗、司馬傳遜懷翼戴秦王之計，謂疇、捷等曰：「山東非霸王處，不如關中。」河陽令傅暢遺鼎書，勸奉秦王過洛陽，謁拜山陵，徑據長安，綏合夷晉，興起義眾，克復宗廟，雪社稷之恥。鼎得書，便欲詣洛，流人謂北道近河，懼有抄截，欲南自武關向長安。疇等皆山東人，咸不願西入，荀籓及疇、捷等並逃散。鼎追籓不及，暅等見殺，唯顗、述走得免。遂奉秦王行，止上洛，為山賊所襲，殺百餘人，率餘眾西至藍田。時劉聰向長安，為雍州刺史賈疋所逐，走還平陽。疋遣人奉迎秦王，遂至長安，而與大司馬南陽王保、衛將軍梁芬、京兆尹梁綜等並同心推戴，立王為皇太子，登壇告天，立社稷宗廟，以鼎為太子詹事，總攝百揆。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":94,"last_line":94,"raw_start":7949,"raw_end":8257,"raw_character_offsets":[7951,7952,7953,7954,7955,7956,7957,7958,7959,7960,7961,7962,7963,7964,7965,7966,7967,79