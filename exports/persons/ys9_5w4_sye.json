,"person_id":"ys9_5w4_sye","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-jiapi:p001:m0232","surface":"曜","start":232,"end":233,"person_id":"fee_97f_681","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-jiapi:p001:m0240","surface":"疋","start":240,"end":241,"person_id":"ys9_5w4_sye","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-jiapi:p001:m0254","surface":"蕩仲","start":254,"end":256,"person_id":"61u_i12_xpn","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-jiapi:p001:m0262","surface":"秦王","start":262,"end":264,"person_id":"pss_n95_7x4","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-jiapi:p001:m0272","surface":"蕩仲","start":272,"end":274,"person_id":"61u_i12_xpn","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-jiapi:p001:m0275","surface":"夫護","start":275,"end":277,"person_id":"2gy_9l8_jmz","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-jiapi:p001:m0283","surface":"疋","start":283,"end":284,"person_id":"ys9_5w4_sye","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-jiapi:p001:m0293","surface":"夫護","start":293,"end":295,"person_id":"2gy_9l8_jmz","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-jiapi:p001:m0298","surface":"疋","start":298,"end":299,"person_id":"ys9_5w4_sye","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-060-jiapi","book_id":"b-jinshu-060","work_id":"w-jinshu","source_id":"s-jinshu-060-jiapi-ws2413335"},{"id":"c-jinshu-060-suochen:p003","text":"及懷帝蒙塵，長安又陷，模被害，綝泣曰：「與其俱死，寧為伍子胥。」乃赴安定，與雍州刺史賈疋、扶風太守梁綜、安夷護軍麹允等糾合義眾，頻破賊黨，修復舊館，遷定宗廟。進救新平，小大百戰，綝手擒賊帥李羌，與閻鼎立秦王為皇太子，及即尊位，是為湣帝。綝遷侍中、太僕，以首迎大駕、升壇授璽之功，封弋居伯。又遷前將軍、尚書右僕射、領吏部、京兆尹，加平東將軍，進號征東。尋又詔曰：「朕昔遇厄運，遭家不造，播越宛楚，爰失舊京。幸宗廟寵靈，百辟宣力，得從籓衛，托乎群公之上。社稷之不隕，實公是賴，宜贊百揆，傅弼朕躬。其授衛將軍，領太尉，位特進，軍國之事悉以委之。」","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":120,"last_line":120,"raw