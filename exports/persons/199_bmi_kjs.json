ups":[{"canonical_mention_id":"c-nanqishu-054-recluses-complete:p001:m0002","mention_ids":["c-nanqishu-054-recluses-complete:p001:m0002"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-054-recluses-complete:p001:m0006","mention_ids":["c-nanqishu-054-recluses-complete:p001:m0006"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-054-recluses-complete:p002:m0002","mention_ids":["c-nanqishu-054-recluses-complete:p002:m0002"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-054-recluses-complete:p002:m0027","mention_ids":["c-nanqishu-054-recluses-complete:p002:m0027"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-054-recluses-complete:p002:m0080","mention_ids":["c-nanqishu-054-recluses-complete:p002:m0080"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-054-recluses-complete:p002:m0113","mention_ids":["c-nanqishu-054-recluses-complete:p002:m0113"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-054-recluses-complete:p002:m0234","mention_ids":["c-nanqishu-054-recluses-complete:p002:m0234"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-054-recluses-complete:p003:m0020","mention_ids":["c-nanqishu-054-recluses-complete:p003:m0020"],"kind":"paragraph"}],"mention_count":8,"duplicate_mention_count":0,"paragraph_occurrence_count":8,"table_occurrence_count":0,"passage_count":3,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"8處獨立位置，8個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-nanqishu-054-recluses-complete-ws1762878"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-nanqishu-054-recluses-complete:source_review1-0","kind":"source_review","person_id":"199_bmi_kjs","source_quote":"　　褚伯玉字元璩，吳郡錢唐人也。高祖含，始平太守。父逷，征虜參軍。","reading":"父逷、高祖含分別具職。錢唐是傳中郡縣次第。","note":"父逷、高祖含分別具職。錢唐是傳中郡縣次第。","paragraph_id":"c-nanqishu-054-recluses-complete:p001","start_codepoint":0,"end_codepoint":33,"human_reviewed":false,"chapter_id":"c-nanqishu-054-recluses-complete","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:source_review2-0","kind":"source_review","person_id":"199_bmi_kjs","source_quote":"　　伯玉少有隱操，寡嗜欲。年十八，父爲之婚，婦入前門，伯玉從後門出。遂往剡，居瀑布山。性耐寒暑，時人比之王仲都。在山三十餘年，隔絕人物。王僧達爲吳郡，苦禮致之，伯玉不得已，停郡信宿，裁交數言而退。寧朔將軍丘珍孫與僧達書曰：「聞褚先生出居貴館，此子滅景雲棲，不事王侯，抗高木食，有年載矣。自非折節好賢，何以致之。昔文舉棲冶城，安道入昌門，於茲而三焉。夫却粒之士，飡霞之人，乃可蹔致，不宜久羈。君當思遂其高步，成其羽化。望其還策之日，蹔紆清塵，亦願助爲譬說。」僧達答曰：「褚先生從白雲遊舊矣。古之逸民，或留慮兒女，或使華陰成市，而此子索然，唯朋松石。介於孤峰絕嶺者，積數十載。近故要其來此，冀慰日夜。比談討芝桂，借訪荔蘿，若已窺煙液，臨滄洲矣。知君欲見之，輙當申譬。」","reading":"十八是父婚之年，三十餘是住山期間。王僧達延請與丘珍孫書所敘分開。","note":"十八是父婚之年，三十餘是住山期間。王僧達延請與丘珍孫書所敘分開。","paragraph_id":"c-nanqishu-054-recluses-complete:p002","start_codepoint":0,"end_codepoint":332,"human_reviewed":false,"chapter_id":"c-nanqishu-054-recluses-complete","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:source_review3-0","kind":"source_review","person_id":"199_bmi_kjs","source_quote":"　　宋孝建二年，散騎常侍樂詢行風俗，表薦伯玉，加徵聘本州議曹從事，不就。太祖卽位，手詔吳、會二郡，以禮迎遣，又辭疾。上不欲違其志，敕於剡白石山立太平館居之。建元元年，卒。年八十六。常居一樓上，仍葬樓所。孔稚珪從其受道法，爲於館側立碑。","reading":"孝建二年樂詢薦在宋，齊太祖立太平館。建元元年卒，傳報年八十六。","note":"孝建二年樂詢薦在宋，齊太祖立太平館。建元元年卒，傳報年八十六。","paragraph_id":"c-nanqishu-054-recluses-complete:p003","start_codepoint":0,"end_codepoint":117,"human_reviewed":false,"chapter_id":"c-nanqishu-054-recluses-complete","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:variant_review2-13","kind":"variant_review","person_id":"199_bmi_kjs","source_quote":"年十八，父爲之婚","reading":"十八繫逃婚，與建元元年卒八十六分證。","note":"十八繫逃婚，與建元元年卒八十六分證。","paragraph_id":"c-nanqishu-054-recluses-complete:p002","start_codepoint":13,"end_codepoint":21,"human_reviewed":false,"chapter_id":"c-nanqishu-054-recluses-complete","source_id":"s-nanqishu-054-recluses-complete-ws1762878"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-qi054-chuboyu-gaozu","subject_person_id":"199_bmi_kjs","object_person_id":"u6d_qvp_sii","predicate":"ancestor","qualifiers":{"source_term":"高祖含","lineage":"paternal","generation_distance":4},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-054","chapter_id":"c-nanqishu-054-recluses-complete","source_id":"s-nanqishu-054-recluses-complete-ws1762878","paragraph_id":"c-nanqishu-054-recluses-complete:p001","quote":"　　褚伯玉字元璩，吳郡錢唐人也。高祖含，始平太守。父逷，征虜參軍。","subject_person_mention_id":"c-nanqishu-054-recluses-complete:p001:m0002","object_person_mention_id":"c-nanqishu-054-recluses-complete:p001:m0018"}],"status":"source_attested","interpretation_note":"高祖為原稱。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"a-qi054-chuboyu-father","subject_person_id":"199_bmi_kjs","object_person_id":"cnw_hud_6no","predicate":"father","qualifiers":{"source_term":"父逷","lineage":"paternal"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-054","chapter_id":"c-nanqishu-054-recluses-complete","source_id":"s-nanqishu-054-recluses-complete-ws1762878","paragraph_id":"c-nanqishu-054-recluses-complete:p001","quote":"　　褚伯玉字元璩，吳郡錢唐人也。高祖含，始平太守。父逷，征虜參軍。","subject_person_mention_id":"c-nanqishu-054-recluses-complete:p001:m0002","object_person_mention_id":"c-nanqishu-054-recluses-complete:p001:m0026"}],"status":"source_attested","interpretation_note":"征虜參軍。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-qi054-chuboyu-death","person_id":"199_bmi_kjs","event_type":"death","source_term":"卒","source_anchor":{"paragraph_id":"c-nanqishu-054-r