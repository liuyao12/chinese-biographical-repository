person_id":"f1g_lsv_jzc","predicate":"father","qualifiers":{"source_term":"父瑗，尚書都令史"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-072","chapter_id":"c-jinshu-072-guopu","source_id":"s-jinshu-072-guopu-ws2595548","paragraph_id":"c-jinshu-072-guopu:p001","quote":"郭璞，字景純，河東聞喜人也。父瑗，尚書都令史。時尚書杜預有所增損，瑗多駁正之，以公方著稱。終於建平太守。璞好經術，博學有高才，而訥於言論，詞賦為中興之冠。好古文奇字，妙於陰陽算曆。有郭公者，客居河東，精于卜筮，璞從之受業。公以《青囊中書》九卷與之，由是遂洞五行、天文、卜筮之術，攘災轉禍，通致無方，雖京房、管輅不能過也。璞門人趙載嘗竊《青襄書》，未及讀，而為火所焚。","subject_person_mention_id":"c-jinshu-072-guopu:p001:m0000","object_person_mention_id":"c-jinshu-072-guopu:p001:m0015"}],"status":"source_attested","interpretation_note":"正文記父瑗終於建平太守。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-072-guopu:p001:m0015","surface":"瑗","start":15,"end":16,"person_id":"f1g_lsv_jzc","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-072-guopu:p001","chapter_id":"c-jinshu-072-guopu"}],"relations":[{"id":"a-jin072-guoyuan-father","subject_person_id":"2i5_4eo_tve","object_person_id":"f1g_lsv_jzc","predicate":"father","qualifiers":{"source_term":"父瑗，尚書都令史"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-072","chapter_id":"c-jinshu-072-guopu","source_id":"s-jinshu-072-guopu-ws2595548","paragraph_id":"c-jinshu-072-guopu:p001","quote":"郭璞，字景純，河東聞喜人也。父瑗，尚書都令史。時尚書杜預有所增損，瑗多駁正之，以公方著稱。終於建平太守。璞好經術，博學有高才，而訥於言論，詞賦為中興之冠。好古文奇字，妙於陰陽算曆。有郭公者，客居河東，精于卜筮，璞從之受業。公以《青囊中書》九卷與之，由是遂洞五行、天文、卜筮之術，攘災轉禍，通致無方，雖京房、管輅不能過也。璞門人趙載嘗竊《青襄書》，未及讀，而為火所焚。","subject_person_mention_id":"c-jinshu-072-guopu:p001:m0000","object_person_mention_id":"c-jinshu-072-guopu:p001:m0015"}],"status":"source_attested","interpretation_note":"正文記父瑗終於建平太守。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":