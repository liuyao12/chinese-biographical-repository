reserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-059-lv:line025:m0074","start":74,"end":75,"surface":"存","kind":"person","person_id":"a0r_fwq_mym","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-059-lv:line025","chapter_id":"c-sanguozhi-059-lv"}],"relations":[],"title_holdings":[{"id":"t-wu059-lv-1","person_id":"a0r_fwq_mym","kind":"office","title":"尚書僕射","mode":"attestation","status":"source_attested","effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本句所載職官，任免時間未詳。","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-059","chapter_id":"c-sanguozhi-059-lv","source_id":"s-sanguozhi-059-lv","paragraph_id":"c-sanguozhi-059-lv:line025","quote":"孫慮字子智，登弟也。少敏惠有才藝，權器愛之。黃武七年，封建昌侯。後二年，丞相雍等奏慮性聦體達，所尚日新，比方近漢，宜進爵稱王，權未許。乆之，尚書僕射存上疏曰：「帝王之興，莫不襃崇至親，以光羣后，故魯衞於周，寵冠諸侯，高帝五王，封列于漢，所以藩屏本朝，爲國鎮衞。建昌侯慮稟性聦敏，才兼文武，於古典制，宜正名號。陛下謙光，未肯如舊，羣寮大小，咸用於邑。方今姦寇恣睢，金鼓未弭，腹心爪牙，惟親與賢。輒與丞相雍等議，咸以慮宜爲鎮軍大將軍，授任偏方，以光大業。」權乃許之，於是假節開府，治半州。慮以皇子之尊，富於春秋，遠近嫌其不能留意。及至臨事，遵奉法度，敬納師友，過於衆望。年二十，嘉禾元年卒。無子，國除。","person_mention_id":"c-sanguozhi-059-lv:line025:m0074"}],"attestations":[{"id":"t-wu059-lv-1:a","paragraph_id":"c-sanguozhi-059-lv:line025","person_mention_id":"c-sanguozhi-059-lv:line025:m0074","start":70,"end":74,"surface":"尚書僕射","usage":"narrative","date_expression":null}],"human_reviewed":false,"reviewer":"Codex（AI 代理）","model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-059-lv:line025","text":"孫慮字子智，登弟也。少敏惠有才藝，權器愛之。黃武七年，封建昌侯。後二年，丞相雍等奏慮性聦體達，所尚日新，比方近漢，宜進爵稱王，權未許。乆之，尚書僕射存上疏曰：「帝王之興，莫不襃崇至親，以光羣后，故魯衞於周，寵冠諸侯，高帝五王，封列于漢，所以藩屏本朝，爲國鎮衞。建昌侯慮稟性聦敏，才兼文武，於古典制，宜正名號。陛下謙光，未肯如舊，羣寮大小，咸用於邑。方今姦寇恣睢，金鼓未弭，腹心爪牙，惟親與賢。輒與丞相雍等議，咸以慮宜爲鎮軍大將軍，授任偏方，以光大業。」權乃許之，於是假節開府，治半州。慮以皇子之尊，富於春秋，遠近嫌其不能留意。及至臨事，遵奉法度，敬納師友，過於衆望。年二十，嘉禾元年卒。無子，國除。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-059-lv:line025:m0000","start":0,"end":2,"surface":"孫慮","kind":"person","person_id":"572_278_cba_D","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-lv:line025:m0003","start":3,"end":5,"surface":"子智","kind":"person","person_id":"572_278_cba_D","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-lv:line025:m0006","start":6,"end":7,"surface":"登","kind":"person","person_id":"572_278_cba_C","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-lv:line025:m0017","start":17,"end":18,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-lv:line025:m0038","start":38,"end":39,"surface":"雍","kind":"person","person_id":"syc_ik6_bq5_**A","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-lv:line025:m0041","start":41,"end":42,"surface":"慮","kind":"person","person_id":"572_278_cba_D","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-lv:line025:m0063","start":63,"end":64,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-lv:line025:m0074","start":74,"end":75,"surface":"存","kind":"person","person_id":"a0r_fwq_mym","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-lv:line025:m0108","start":108,"end":110,"surface":"高帝","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-lv:line025:m0133","start":133,"end":134,"surface":"慮","kind":"person","person_id":"572_278_cba_D","status":"context