yu:m004-0313","start":313,"end":316,"surface":"蒲將軍","kind":"person","person_id":"cbr-p000657","status":"contextual_provisional"}],"chapter_id":"c-shiji-007-xiangyu","book_id":"b-shiji-007","work_id":"w-shiji","source_id":"s-shiji-007-xiangyu"},{"id":"c-shiji-007-xiangyu:p006","text":"居鄛人范增，年七十，素居家，好奇計，往說項梁曰：「陳勝敗固當。夫秦滅六國，楚最無罪。自懷王入秦不反，楚人憐之至今，故楚南公曰『楚雖三戶，亡秦必楚』也。今陳勝首事，不立楚後而自立，其勢不長。今君起江東，楚蠭起之將皆爭附君者，以君世世楚將，為能復立楚之後也。」於是項梁然其言，乃求楚懷王孫心民間，為人牧羊，立以為楚懷王，從民所望也。陳嬰為楚上柱國，封五縣，與懷王都盱台。項梁自號為武信君。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-007-xiangyu:m006-0003","start":3,"end":5,"surface":"范增","kind":"person","person_id":"cbr-p000663","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m006-0020","start":20,"end":22,"surface":"項梁","kind":"person","person_id":"cbr-p000603","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m006-0025","start":25,"end":27,"surface":"陳勝","kind":"person","person_id":"cbr-p000598","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m006-0043","start":43,"end":45,"surface":"懷王","kind":"person","person_id":"cbr-p000505","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m006-0058","start":58,"end":61,"surface":"楚南公","kind":"person","person_id":"cbr-p000664","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m006-0076","start":76,"end":78,"surface":"陳勝","kind":"person","person_id":"cbr-p000598","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m006-0100","start":100,"end":105,"surface":"楚蠭起之將","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱或短稱尚待逐處覆核；不補姓名或推造個別成員。"},{"id":"c-shiji-007-xiangyu:m006-0122","start":122,"end":125,"surface":"楚之後","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱或短稱尚待逐處覆核；不補姓名或推造個別成員。"},{"id":"c-shiji-007-xiangyu:m006-0130","start":130,"end":132,"surface":"項梁","kind":"person","person_id":"cbr-p000603","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m00