_id":"cbr-p000655","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p004","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-007-xiangyu:m004-0167","start":167,"end":168,"surface":"嬰","kind":"person","person_id":"cbr-p000655","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p004","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-007-xiangyu:m004-0183","start":183,"end":184,"surface":"嬰","kind":"person","person_id":"cbr-p000655","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p004","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-007-xiangyu:m004-0241","start":241,"end":242,"surface":"嬰","kind":"person","person_id":"cbr-p000655","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p004","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-007-xiangyu:m006-0164","start":164,"end":166,"surface":"陳嬰","kind":"person","person_id":"cbr-p000655","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p006","chapter_id":"c-shiji-007-xiangyu"}],"relations":[{"id":"a-shiji007-003","subject_person_id":"cbr-p000655","predicate":"mother","object_person_id":"cbr-p000654","status":"source_attested","evidence":[{"paragraph_id":"c-shiji-007-xiangyu:p004","quote":"陳嬰母謂嬰曰","chapter_id":"c-shiji-007-xiangyu","source_id":"s-shiji-007-xiangyu"}],"qualifiers":{"source_term":"母","historicity":"historical_tradition"},"interpretation_note":"只保存本文明示親屬陳述；不推導闕代、同父同母或未見姓名。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji007-012","person_id":"cbr-p000655","surfaces":["嬰","陳嬰"],"scope":"same_chapter","chapter_ids":["c-shiji-007-xiangyu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-007-xiangyu:p004","quote":"廣陵人召平於是為陳王徇廣陵，未能下。聞陳王敗走，秦兵又且至，乃渡江矯陳王命，拜梁為楚王上柱國。曰：「江東已定，急引兵西擊秦。」項梁乃以八千人渡江而西。聞陳嬰已下東陽，使使欲與連和俱西。陳嬰者，故東陽令史，居縣中，素信謹，稱為長者。東陽少年殺其令，相聚數千人，欲置長，無適用，乃請陳嬰。嬰謝不能，遂彊立嬰為長，縣中從者得二萬人。少年欲立嬰便為王，異軍蒼頭特起。陳嬰母謂嬰曰：「自我為汝家婦，未嘗聞汝先古之有貴者。今暴得大名，不祥。不如有所屬，事成猶得封侯，事敗易以亡，非世所指名也。」嬰乃不敢為王。謂其軍吏曰：「項氏世世將家，有名於楚。今欲舉大事，將非其人，不可。我倚名族，亡秦必矣。」於是眾從其言，以兵屬項梁。項梁渡淮，黥布、蒲將軍亦以兵屬焉。凡六七萬人，軍下邳。"}],"rationale":"陳嬰在同段引入後省稱嬰；陳嬰母不等同陳嬰。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-007-xiangyu:p004","text":"廣陵人召平於是為陳王徇廣陵，未能下。聞陳王敗走，秦兵又且至，乃渡江矯陳王命，拜梁為楚王上柱國。曰：「江東已定，急引兵西擊秦。」項梁乃以八千人渡江而西。聞陳嬰已下東陽，使使欲與連和俱西。陳嬰者，故東陽令史，居縣中，素信謹，稱為長者。東陽少年殺其令，相聚數千人，欲置長，無適用，乃請陳嬰。嬰謝不能，遂彊立嬰為長，縣中從者得二萬人。少年欲立嬰便為王，異軍蒼頭特起。陳嬰母謂嬰曰：「自我為汝家婦，未嘗聞汝先古之有貴者。今暴得大名，不祥。不如有所屬，事成猶得封侯，事敗易以亡，非世所指名也。」嬰乃不敢為王。謂其軍吏曰：「項氏世世將家，有名於楚。今欲舉大事，將非其人，不可。我倚名族，亡秦必矣。」於是眾從其言，以兵屬項梁。項梁渡淮，黥布、蒲將軍亦以兵屬焉。凡六七萬人，軍下邳。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-007-xiangyu:m004-0003","start":3,"end":5,"surface":"召平","kind":"person","person_id":"cbr-p000653","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m004-0008","start":8,"end":10,"surface":"陳王","kind":"person","person_id":"cbr-p000598","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m004-0019","start":19,"end":21,"surface":"陳王","kind":"person","person_id":"cbr-p000598","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m004-0034","start":34,"end":36,"surface":"陳王","kind":"person","person_id":"cbr-p000598","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m004-0039","start":39,"end":40,"surface":"梁","kind":"person","person_id":"cbr-p000603","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m004-0063","start":63,"end":65,"surface":"項梁","kind":"person","person_id":"cbr-p000603","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m004-0076","start":76,"end":78,"surface":"陳嬰","kind":"person","person_id":"cbr-p000655","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m004-0092","start":92,"end":94,"surface":"陳嬰","kind":"person","person_id":"cbr-p000655","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m004-0115","start":115,"end":11