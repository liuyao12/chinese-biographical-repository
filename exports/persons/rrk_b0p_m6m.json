_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-043-shanjian:line054","text":"永嘉三年，出為征南將軍、都督荊、湘、交、廣四州諸軍事、假節，鎮襄陽。于時四方寇亂，天下分崩，王威不振，朝野危懼。簡優遊卒歲，唯酒是耽。諸習氏，荊土豪族，有佳園池，簡每出嬉遊，多之池上，置酒輒醉，名之曰高陽池。時有童兒歌曰：「山公出何許，往至高陽池。日夕倒載歸，酩酊無所知。時時能騎馬，倒著白接䍦。舉鞭問葛疆：何如并州兒？」疆家在并州，簡愛將也。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-043-shanjian:line054:m0056","start":56,"end":57,"surface":"簡","kind":"person","person_id":"82k_3oi_qf8","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-shanjian:line054:m0081","start":81,"end":82,"surface":"簡","kind":"person","person_id":"82k_3oi_qf8","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-shanjian:line054:m0112","start":112,"end":114,"surface":"山公","kind":"person","person_id":"82k_3oi_qf8","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-shanjian:line054:m0151","start":151,"end":153,"surface":"葛疆","kind":"person","person_id":"rrk_b0p_m6m","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-shanjian:line054:m0161","start":161,"end":162,"surface":"疆","kind":"person","person_id":"rrk_b0p_m6m","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-shanjian:line054:m0167","start":167,"end":168,"surface":"簡","kind":"person","person_id":"82k_3oi_qf8","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"source_position":{"first_line":54,"last_line":54,"raw_start":3679,"raw_end":3860,"revision_id":2618531},"chapter_id":"c-jinshu-043-shanjian","book_id":"b-jinshu-043","work_id":"w-jinshu","source_id":"s-jinshu-043-shanjian"},{"id":"c-shishuoxinyu-023-jin043-shanjian:gloss","text":"高陽池在襄陽。彊是其愛將，并州人也。","annotation_status":"reviewed","mentions":[{"id":"c-shishuoxinyu-023-jin043-shanjian:gloss:m0007","start":7,"end":8,"surface":"彊","kind":"person","person_id":"rrk_b0p_m6m","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"text_layer":"received_chapter","source_quote":{"witness":"ren","quote":"高陽池在襄陽。彊是其愛將，并州人也。","raw_start":2772,"raw_end":2790,"raw_line":27},"chapter_id":"c-shishuoxinyu-023-jin043-shanjian","book_id":"b-shishuoxinyu-023","work_id":"w-shishuoxinyu","source_id":"s-shishuoxinyu-023-jin043-shanjian"},{"id":"c-shishuoxinyu-023-jin043-shanjian:song","text":"山公時一醉，徑造高陽池。日莫倒載歸，茗艼無所知。復能乘駿馬，倒箸白接籬。舉手問葛彊，何如并州兒？","annotation_status":"reviewed","mentions":[{"id":"c-shishuoxinyu-023-jin043-shanjian:song:m0000","start":0,"end":2,"surface":"山公","kind":"person","person_id":"82k_3oi_qf8","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-shishuoxinyu-023-jin043-shanjian:song:m0039","start":39,"end":41,"surface":"葛彊","kind":"person","person_id":"rrk_b0p_m6m","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"text_layer":"received_chapter","source_quote":{"witness":"ren","quote":"山公時一醉，徑造高陽池。日莫倒載歸，茗艼無所知。復能乘駿馬，倒箸白接籬。舉手問葛彊，何如并州兒？","raw_start":2723,"raw_end":2771,"raw_line":27},"chapter_id":"c-shishuoxinyu-023-jin043-shanjian","book_id":"b-shishuoxinyu-023","work_id":"w-shishuoxinyu","source_id":"s-shishuoxinyu-023-jin043-shanjian"}],"sources":[{"chapter_id":"c-jinshu-043-shanjian","work_id":"w-jinshu","book_id":"b-jinshu-043","source_id":"s-jinshu-043-shanjian","source":{"title":"晉書卷四十三","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?oldid=2618531","permalink":"https://zh.wikisource.org/w/index.php?oldid=2618531","revision_id":2618531,"accessed_on":"2026-11-21","edition":"使用維基文庫固定修訂，武英殿本另行對校。","extent":"自原文第50行至第56行，題下全文。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古籍原文，維基文庫數位轉錄。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","raw_path":"sources/witnesses/jin043-ws2618531.wikitext","raw_file_sha256":"d9ab07