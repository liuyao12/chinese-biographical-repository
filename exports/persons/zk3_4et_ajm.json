07-0057","chapter_id":"c-shiji-124-youxia","paragraph_id":"c-shiji-124-youxia:p007","quote":"條侯"},{"mention_id":"c-shiji-052-qidaohui:m025-0199","chapter_id":"c-shiji-052-qidaohui","paragraph_id":"c-shiji-052-qidaohui:p025","quote":"太尉周亞夫"}],"family_path":{"connection":"father","generation_distance":1,"status":"contextual_provisional","human_reviewed":false,"parent_person_id":"koy_6jg_gcc","source_assertion_id":"a-shiji057-002","evidence":[{"chapter_id":"c-shiji-057-zhou","source_id":"s-shiji-057-zhou","paragraph_id":"c-shiji-057-zhou:p011","quote":"絳侯復就國。孝文帝十一年卒，謚為武侯。子勝之代侯。六歲，尚公主，不相中，坐殺人，國除。絕一歲，文帝乃擇絳侯勃子賢者河內守亞夫，封為條侯，續絳侯後。","source_term":"絳侯勃子賢者河內守亞夫"}],"interpretation_note":"依絳侯周勃子亞夫明示父子接同根；亞夫已知之子沿原有明示路徑遷移，不補兄弟排行、出生次序或生母。","reviewer":"Codex（AI 代理）"}},{"id":"zk3_4et_ajm","label":"亞夫夫人（絳侯周勃世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"夫人","mention_ids":["c-shiji-057-zhou:m021-0166"]}],"evidence":[{"mention_id":"c-shiji-057-zhou:m021-0166","chapter_id":"c-shiji-057-zhou","paragraph_id":"c-shiji-057-zhou:p021","quote":"夫人"}]}],"source_mention_summary":[{"source_id":"s-shiji-057-zhou","work_id":"w-shiji","book_id":"b-shiji-057","chapter_id":"c-shiji-057-zhou","mention_count":1,"mention_ids":["c-shiji-057-zhou:m021-0166"],"paragraph_ids":["c-shiji-057-zhou:p021"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-057-zhou"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji057-009","subject_person_id":"koy_6jg_gcc_C","predicate":"spouse","object_person_id":"zk3_4et_ajm","status":"source_attested","evidence":[{"chapter_id":"c-shiji-057-zhou","source_id":"s-shiji-057-zhou","paragraph_id":"c-shiji-057-zhou:p021","quote":"居無何，條侯子為父買工官尚方甲楯五百被可以葬者。取庸苦之，不予錢。庸知其盜買縣官器，怒而上變告子，事連汙條侯。書既聞上，上下吏。吏簿責條侯，條侯不對。景帝罵之曰：「吾不用也。」召詣廷尉。廷尉責曰：「君侯欲反邪？」亞夫曰：「臣所買器，乃葬器也，何謂反邪？」吏曰：「君侯縱不反地上，即欲反地下耳。」吏侵之益急。初，吏捕條侯，條侯欲自殺，夫人止之，以故不得死，遂入廷尉。因不食五日，嘔血而死。國除。"}],"qualifiers":{"source_term":"夫人止之","historicity":"historical_tradition"},"interpretation_note":"依明示子、兄、女、尚、夫人與局部主語保存，不由承爵本身補父子，不補未見姓名、同母或排行；文帝女公主與亞夫家屬保留本篇未名稱呼。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-057-zhou:m021-0166","start":166,"end":168,"surface":"夫人","kind":"person","person_id":"zk3_4et_ajm","status":"contextual_provisional","paragraph_id":"c-shiji-057-zhou:p021","chapter_id":"c-shiji-057-zhou"}],"relations":[{"id":"a-shiji057-009","subject_person_id":"koy_6jg_gcc_C","predicate":"spouse","object_person_id":"zk3_4et_ajm","status":"source_attested","evidence":[{"chapter_id":"c-shiji-057-zhou","source_id":"s-shiji-057-zhou","paragraph_id":"c-shiji-057-zhou:p021","quote":"居無何，條侯子為父買工官尚方甲楯五百被可以葬者。取庸苦之，不予錢。庸知其盜買縣官器，怒而上變告子，事連汙條侯。書既聞上，上下吏。吏簿責條侯，條侯不對。景帝罵之曰：「吾不用也。」召詣廷尉。廷尉責曰：「君侯欲反邪？」亞夫曰：「臣所買器，乃葬器也，何謂反邪？」吏曰：「君侯縱不反地上，即欲反地下耳。」吏侵之益急。初，吏捕條侯，條侯欲自殺，夫人止之，以故不得死，遂入廷尉。因不食五日，嘔血而死。國除。"}],"qualifiers":{"source_term":"夫人止之","historicity":"historical_tradition"},"interpretation_note":"依明示子、兄、女、尚、夫人與局部主語保存，不由承爵本身補父子，不補未見姓名、同母或排行；文帝女公主與亞夫家屬保留本篇未名稱呼。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji057-076","person_id":"zk3_4et_ajm","title":"夫人","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-057-zhou","source_id":"s-shiji-057-zhou","paragraph_id":"c-shiji-057-zhou:p021","quote":"居無何，條侯子為父買工官尚方甲楯五百被可以葬者。取庸苦之，不予錢。庸知其盜買縣官器，怒而上變告子，事連汙條侯。書既聞上，上下吏。吏簿責條侯，條侯不對。景帝罵之曰：「吾不用也。」召詣廷尉。廷尉責曰：「君侯欲反邪？」亞夫曰：「臣所買器，乃葬器也，何謂反邪？」吏曰：「君侯縱不反地上，即欲反地下耳。」吏侵之益急。初，吏捕條侯，條侯欲自殺，夫人止之，以故不得死，遂入廷尉。因不食五日，嘔血而死。國除。"}],"attestations":[{"id":"th-shiji057-076:a001","paragraph_id":"c-shiji-057-zhou: