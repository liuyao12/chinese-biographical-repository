person","person_id":"f41_ulg_3u1","status":"contextual_provisional"}],"chapter_id":"c-shiji-115-chaoxian","book_id":"b-shiji-115","work_id":"w-shiji","source_id":"s-shiji115-chaoxian"},{"id":"c-shiji-115-chaoxian:p003","text":"傳子至孫右渠，所誘漢亡人滋多，又未嘗入見；真番旁眾國欲上書見天子，又擁閼不通。元封二年，漢使涉何譙諭右渠，終不肯奉詔。何去至界上，臨浿水，使御刺殺送何者朝鮮裨王長，即渡，馳入塞，遂歸報天子曰「殺朝鮮將」。上為其名美，即不詰，拜何為遼東東部都尉。朝鮮怨何，發兵襲攻殺何。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-115-chaoxian:m003-0004","start":4,"end":6,"surface":"右渠","kind":"person","person_id":"f41_ulg_3u1_*A","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m003-0030","start":30,"end":32,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m003-0046","start":46,"end":48,"surface":"涉何","kind":"person","person_id":"3rh_ei8_elm","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m003-0050","start":50,"end":52,"surface":"右渠","kind":"person","person_id":"f41_ulg_3u1_*A","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m003-0059","start":59,"end":60,"surface":"何","kind":"person","person_id":"3rh_ei8_elm","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m003-0070","start":70,"end":71,"surface":"御","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-115-chaoxian:m003-0074","start":74,"end":75,"surface":"何","kind":"person","person_id":"3rh_ei8_elm","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m003-0076","start":76,"end":81,"surface":"朝鮮裨王長","kind":"person","person_id":"fa5_rxi_3t4","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m003-0092","start":92,"end":94,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m003-0102","start":102,"end":103,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m003-0113","start"