n":"biographical_origin","place":{"source_name":"燕","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-115-chaoxian","source_id":"s-shiji115-chaoxian","paragraph_id":"c-shiji-115-chaoxian:p001","quote":"朝鮮王滿者，故燕人也。自始全燕時嘗略屬真番、朝鮮，為置吏，筑鄣塞。秦滅燕，屬遼東外徼。漢興，為其遠難守，復修遼東故塞，至浿水為界，屬燕。燕王盧綰反，入匈奴，滿亡命，聚黨千餘人，魋結蠻夷服而東走出塞，渡浿水，居秦故空地上下鄣，稍役屬真番、朝鮮蠻夷及故燕、齊亡命者王之，都王險。"}],"source_term":"故燕人也","interpretation_note":"傳首原籍稱謂，保留燕原字，不推出生地或現代轄區。","reviewer":"Codex（AI 代理）","human_reviewed":false},{"id":"pa-shiji115-002","person_id":"f41_ulg_3u1","relation":"residence","place":{"source_name":"上下鄣","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-115-chaoxian","source_id":"s-shiji115-chaoxian","paragraph_id":"c-shiji-115-chaoxian:p001","quote":"朝鮮王滿者，故燕人也。自始全燕時嘗略屬真番、朝鮮，為置吏，筑鄣塞。秦滅燕，屬遼東外徼。漢興，為其遠難守，復修遼東故塞，至浿水為界，屬燕。燕王盧綰反，入匈奴，滿亡命，聚黨千餘人，魋結蠻夷服而東走出塞，渡浿水，居秦故空地上下鄣，稍役屬真番、朝鮮蠻夷及故燕、齊亡命者王之，都王險。"}],"source_term":"居秦故空地上下鄣","interpretation_note":"滿出塞後明記居地，與傳首燕人原籍分存；不定居留起訖、出生地或現代轄區。","reviewer":"Codex（AI 代理）","human_reviewed":false},{"id":"pa-shiji115-003","person_id":"f41_ulg_3u1","relation":"capital_location","place":{"source_name":"王險","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-115-chaoxian","source_id":"s-shiji115-chaoxian","paragraph_id":"c-shiji-115-chaoxian:p001","quote":"朝鮮王滿者，故燕人也。自始全燕時嘗略屬真番、朝鮮，為置吏，筑鄣塞。秦滅燕，屬遼東外徼。漢興，為其遠難守，復修遼東故塞，至浿水為界，屬燕。燕王盧綰反，入匈奴，滿亡命，聚黨千餘人，魋結蠻夷服而東走出塞，渡浿水，居秦故空地上下鄣，稍役屬真番、朝鮮蠻夷及故燕、齊亡命者王之，都王險。"}],"source_term":"都王險","interpretation_note":"記滿所都之地，王都與個人居所、原籍分存；不以都城推定出生或死亡地，不換現代轄區。","reviewer":"Codex（AI 代理）","human_reviewed":false,"qualifiers":{"seat_kind":"royal_capital","source_action":"都"}}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"