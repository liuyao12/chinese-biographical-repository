ath":{"connection":"grandfather","generation_distance":2,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-115-chaoxian","source_id":"s-shiji115-chaoxian","paragraph_id":"c-shiji-115-chaoxian:p003","quote":"傳子至孫右渠，所誘漢亡人滋多，又未嘗入見；真番旁眾國欲上書見天子，又擁閼不通。元封二年，漢使涉何譙諭右渠，終不肯奉詔。何去至界上，臨浿水，使御刺殺送何者朝鮮裨王長，即渡，馳入塞，遂歸報天子曰「殺朝鮮將」。上為其名美，即不詰，拜何為遼東東部都尉。朝鮮怨何，發兵襲攻殺何。"}],"source_assertion_id":"a-shiji115-001","interpretation_note":"分支字元不表排行；來源明示父系接線，未名世代以星號保留。","reviewer":"Codex（AI 代理）","ancestor_person_id":"f41_ulg_3u1","parent_person_id":null,"intermediate_person_ids":[null]}}],"source_mention_summary":[{"source_id":"s-shiji115-chaoxian","work_id":"w-shiji","book_id":"b-shiji-115","chapter_id":"c-shiji-115-chaoxian","mention_count":4,"mention_ids":["c-shiji-115-chaoxian:m001-0003","c-shiji-115-chaoxian:m001-0078","c-shiji-115-chaoxian:m002-0018","c-shiji-115-chaoxian:m002-0059"],"paragraph_ids":["c-shiji-115-chaoxian:p001","c-shiji-115-chaoxian:p002"],"table_cell_ids":[],"passage_count":2}],"most_mentioned_source_ids":["s-shiji115-chaoxian"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji115-001","subject_person_id":"f41_ulg_3u1_*A","predicate":"grandfather","object_person_id":"f41_ulg_3u1","status":"source_attested","evidence":[{"chapter_id":"c-shiji-115-chaoxian","source_id":"s-shiji115-chaoxian","paragraph_id":"c-shiji-115-chaoxian:p002","quote":"會孝惠、高后時天下初定，遼東太守即約滿為外臣，保塞外蠻夷，無使盜邊；諸蠻夷君長欲入見天子，勿得禁止。以聞，上許之，以故滿得兵威財物侵降其旁小邑，真番、臨屯皆來服屬，方數千里。"},{"chapter_id":"c-shiji-115-chaoxian","source_id":"s-shiji115-chaoxian","paragraph_id":"c-shiji-115-chaoxian:p003","quote":"傳子至孫右渠，所誘漢亡人滋多，又未嘗入見；真番旁眾國欲上書見天子，又擁閼不通。元封二年，漢使涉何譙諭右渠，終不肯奉詔。何去至界上，臨浿水，使御刺殺送何者朝鮮裨王長，即渡，馳入塞，遂歸報天子曰「殺朝鮮將」。上為其名美，即不詰，拜何為遼東東部都尉。朝鮮怨何，發兵襲攻殺何。"}],"qualifiers":{"source_term":"傳子至孫右渠"},"interpretation_note":"承接滿傳至孫右渠，兩代距離；未名父親不補造。","reviewer":"Codex（AI 代理）","context":{"kind":"adjacent_paragraphs","paragraph_ids":["c-shiji-115-chaoxian:p002","c-shiji-115-chaoxian:p003"]}}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"person_id":"f41_ulg_3u1","title":"朝鮮王","surname":"衛","ming":"滿","additional_names":[],"chapter_id":"c-shiji-115-chaoxian","paragraph_id":"c-shiji-115-chaoxian:p001","quote":"朝鮮王滿者，故燕人也。自始全燕時嘗略屬真番、朝鮮，為置吏，筑鄣塞。秦滅燕，屬遼東外徼。漢興，為其遠難守，復修遼東故塞，至浿水為界，屬燕。燕王盧綰反，入匈奴，滿亡命，聚黨千餘人，魋結蠻夷服而東走出塞，渡浿水，居秦故空地上下鄣，稍役屬真番、朝鮮蠻夷及故燕、齊亡命者王之，都王險。","references":[{"title":"《史記索隱》卷二十五·王滿姓氏","url":"https://github.com/kanripo/KR2a0003/blob/85cc2d3b1952d7a66280628c8d2141d4f1593fc7/KR2a0003_025.txt#L172","quote":"王滿者(按漢書滿燕人姓衛/擊破朝鮮而自王之)","scope":"ancient_commentary_name_components","image_verified":false,"reviewed_exact_line":172}],"note":"姓衛據索隱明示姓氏，正文滿保留；不是按字數拆名，未把索隱引漢書的字句說成本次親見漢書正文。","status":"editorial_provisional","human_reviewed":false,"work_id":"w-shiji","book_id":"b-shiji-115","source_id":"s-shiji115-chaoxian"}],"mentions":[{"id":"c-shiji-115-chaoxian:m001-0003","start":3,"end":4,"surface":"滿","kind":"person","person_id":"f41_ulg_3u1","status":"contextual_provisional","paragraph_id":"c-shiji-115-chaoxian:p001","chapter_id":"c-shiji-115-chaoxian"},{"id":"c-shiji-115-chaoxian:m001-0078","start":78,"end":79,"surface":"滿","kind":"person","person_id":"f41_ulg_3u1","status":"contextual_provisional","paragraph_id":"c-shiji-115-chaoxian:p001","chapter_id":"c-shiji-115-chaoxian"},{"id":"c-shiji-115-chaoxian:m002-0018","start":18,"end":19,"surface":"滿","kind":"person","person_id":"f41_ulg_3u1","status":"contextual_provisional","paragraph_id":"c-shiji-115-chaoxian:p002","chapter_id":"c-shiji-115-chaoxian"},{"id":"c-shiji-115-chaoxian:m002-0059","start":59,"end":60,"surface":"滿","