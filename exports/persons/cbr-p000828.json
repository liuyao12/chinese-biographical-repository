cbr-p000687","status":"source_attested","evidence":[{"paragraph_id":"c-shiji-009-lvhou:p006","quote":"留侯子張辟彊","chapter_id":"c-shiji-009-lvhou","source_id":"s-shiji-009-lvhou"}],"qualifiers":{"source_term":"子","historicity":"historical_tradition"},"interpretation_note":"僅保存原文明示主張，不補闕代、同父同母或未見姓名；不推導少帝生物父親。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji009-029","person_id":"cbr-p000828","surfaces":["張辟彊","辟彊"],"scope":"same_chapter","chapter_ids":["c-shiji-009-lvhou"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-009-lvhou:p006","quote":"七年秋八月戊寅，孝惠帝崩。發喪，太后哭，泣不下。留侯子張辟彊為侍中，年十五，謂丞相曰：「太后獨有孝惠，今崩，哭不悲，君知其解乎？」丞相曰：「何解？」辟彊曰：「帝毋壯子，太后畏君等。君今請拜呂台、呂產、呂祿為將，將兵居南北軍，及諸呂皆入宮，居中用事，如此則太后心安，君等幸得脫禍矣。」丞相乃如辟彊計。太后說，其哭乃哀。呂氏權由此起。乃大赦天下。九月辛丑，葬。太子即位為帝，謁高廟。元年，號令一出太后。"}],"rationale":"僅在所列漢初帝后、分封、家族與接任敘事中暫定同指，前卷對讀依相接人物及事件；同名不作全庫替換規則，仍待可靠版本及異源覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-009-lvhou:p006","text":"七年秋八月戊寅，孝惠帝崩。發喪，太后哭，泣不下。留侯子張辟彊為侍中，年十五，謂丞相曰：「太后獨有孝惠，今崩，哭不悲，君知其解乎？」丞相曰：「何解？」辟彊曰：「帝毋壯子，太后畏君等。君今請拜呂台、呂產、呂祿為將，將兵居南北軍，及諸呂皆入宮，居中用事，如此則太后心安，君等幸得脫禍矣。」丞相乃如辟彊計。太后說，其哭乃哀。呂氏權由此起。乃大赦天下。九月辛丑，葬。太子即位為帝，謁高廟。元年，號令一出太后。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-009-lvhou:m006-0008","start":8,"end":11,"surface":"孝惠帝","kind":"person","person_id":"cbr-p000713","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m006-0016","start":16,"end":18,"surface":"太后","kind":"person","person_id":"cbr-p000717","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m006-0024","start":24,"end":26,"surface":"留侯","kind":"person","person_id":"cbr-p000687","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m006-0027","start":27,"end":30,"surface":"張辟彊","kind":"person","person_id":"cbr-p000828","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m006-0039","start":39