1-pei-cui-zhang-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-051-pei-cui-zhang-complete:p022","text":"　　恭祖者，慧景宗人，驍果便馬槊，氣力絕人，頻經軍陣。討王敬則，與左興盛軍容袁文曠爭敬則首，訴明帝曰：「恭祖禿馬絳衫，手刺倒賊。故文曠得斬其首。以死易勳，而見枉奪。若失此勳，要當刺殺左興盛。」帝以其勇，使謂興盛曰：「何容令恭祖與文曠爭功。」遂封二百戶。慧景平後，恭祖繫尚方，少時殺之。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":55,"last_line":55,"raw_start":4427,"raw_end":4569,"raw_character_offsets":[4427,4428,4429,4430,4431,4432,4433,4434,4435,4436,4437,4438,4439,4440,4441,4442,4443,4444,4445,4446,4447,4448,4449,4450,4451,4452,4453,4454,4455,4456,4457,4458,4459,4460,4461,4462,4463,4464,4465,4466,4467,4468,4469,4470,4471,4472,4473,4474,4475,4476,4477,4478,4479,4480,4481,4482,4483,4484,4485,4486,4487,4488,4489,4490,4491,4492,4493,4494,4495,4496,4497,4498,4499,4500,4501,4502,4503,4504,4505,4506,4507,4508,4509,4510,4511,4512,4513,4514,4515,4516,4517,4518,4519,4520,4521,4522,4523,4524,4525,4526,4527,4528,4529,4530,4531,4532,4533,4534,4535,4536,4537,4538,4539,4540,4541,4542,4543,4544,4545,4546,4547,4548,4549,4550,4551,4552,4553,4554,4555,4556,4557,4558,4559,4560,4561,4562,4563,4564,4565,4566,4567,4568],"revision_id":1504716},"mentions":[{"id":"c-nanqishu-051-pei-cui-zhang-complete:p022:m0002","start":2,"end":4,"surface":"恭祖","kind":"person","person_id":"jdk_9jk_otv","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p022:m0006","start":6,"end":8,"surface":"慧景","kind":"person","person_id":"tvq_7my_nqh","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p022:m0028","start":28,"end":31,"surface":"王敬則","kind":"person","person_id":"7a0_95e_c4a","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p022:m0033","start":33,"end":36,"surface":"左興盛","kind":"person","p