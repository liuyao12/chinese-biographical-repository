ter_id":"c-shiji-117-xiangru"}],"relations":[],"title_holdings":[{"id":"th-shiji083-012","person_id":"06n_ttw_xgt","title":"上客","kind":"unclassified","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-083-luzou","source_id":"s-shiji-083-luzou","paragraph_id":"c-shiji-083-luzou:p026","quote":"書奏梁孝王，孝王使人出之，卒為上客。"}],"attestations":[{"id":"th-shiji083-012:a001","paragraph_id":"c-shiji-083-luzou:p026","start":15,"end":17,"surface":"上客","person_mention_id":"c-shiji-083-luzou:m026-0011","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-083-luzou","source_id":"s-shiji-083-luzou","paragraph_id":"c-shiji-083-luzou:p026","quote":"書奏梁孝王，孝王使人出之，卒為上客。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"引古用稱、任職事件與未知起訖分存；三去相概述不補造三段任期，拒封及欲爵未實現不作授爵，未知日期與終點保持未定。","reviewer":"Codex（AI 代理）"}],"address_assertions":[{"id":"pa-shiji058-013","person_id":"06n_ttw_xgt","relation":"biographical_origin","place":{"source_name":"齊","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"source_term":"齊人羊勝、公孫詭、鄒陽之屬","evidence":[{"chapter_id":"c-shiji-058-liang","source_id":"s-shiji-058-liang","paragraph_id":"c-shiji-058-liang:p006","quote":"孝王，竇太后少子也，愛之，賞賜不可勝道。於是孝王筑東苑，方三百餘里。廣睢陽城七十里。大治宮室，為複道，自宮連屬於平臺三十餘里。得賜天子旌旗，出從千乘萬騎。東西馳獵，擬於天子。出言蹕，入言警。招延四方豪桀，自山以東游說之士。莫不畢至，齊人羊勝、公孫詭、鄒陽之屬。公孫詭多奇邪計，初見王，賜千金，官至中尉，梁號之曰公孫將軍，梁多作兵器弩弓矛數十萬，而府庫金錢且百巨萬，珠玉寶器多於京師。","person_mention_id":"c-shiji-058-liang:m006-0125"}],"interpretation_note":"保存本段明示地名及人物；爵邑與領地不當居所，不推定現代位置。","reviewer":"Codex（AI 代理）","human_reviewed":false},{"id":"pa-shiji117-002","person_id":"06n_ttw_xgt","relation":"biographical_origin","place":{"source_name":"齊","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-117-xiangru","source_id":"s-shiji117-xiangru","paragraph_id":"c-shiji-117-xiangru:p001","quote":"司馬相如者，蜀郡成都人也，字長卿。少時好讀書，學擊劍，故其親名之曰犬子。相如既學，慕藺相如之為人，更名相如。以貲為郎，事孝景帝，為武騎常侍，非其好也。會景帝不好辭賦，是時梁孝王來朝，從遊說之士齊人鄒陽、淮陰枚乘、吳莊忌夫子之徒，相如見而說之，因病免，客游梁。梁孝王令與諸生同舍，相如得與諸生游士居數歲，乃著子虛之賦。"}],"source_term":"齊人鄒陽","interpretation_note":"來源人地稱謂，保留原字與地名範圍；不推出生地或現代轄區。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji058-014","person_id":"06n_ttw_xgt","surfaces":["鄒陽"],"scope":"same_chapter","chapter_ids":["c-shiji-058-liang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-058-liang:p006","quote":"孝王，竇太后少子也，愛之，賞賜不可勝道。於是孝王筑東苑，方三百餘里。廣睢陽城七十里。大治宮室，為複道，自宮連屬於平臺三十餘里。得賜天子旌旗，出從千乘萬騎。東西馳獵，擬於天子。出言蹕，入言警。招延四方豪桀，自山以東游說之士。莫不畢至，齊人羊勝、公孫詭、鄒陽之屬。公孫詭多奇邪計，初見王，賜千金，官至中尉，梁號之曰公孫將軍，梁多作兵器弩弓矛數十萬，而府庫金錢且百巨萬，珠玉寶器多於京師。"}],"rationale":"按明示姓名、世系與局部王號暫接。梁武、勝、參、登、義、買、襄等不按同王號合併；梁王勝與羊勝分辨。李太后陳太后分存；主張、指控、泛稱與授職分辨，正文與附述各保留。官爵全史與跨篇身份仍待覆核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji083-034","person_id":"06n_ttw_xgt","scope":"same_chapter","chapter_ids":["c-shiji-083-luzou"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"按獄中上書引古與梁廷敘事分層，保留原稱。枚生及衛先生未以記憶補姓名；王奢不改作趙奢。燕丹與丹限荊軻句群，臣與大王限鄒陽對梁孝王的上書。 第26段奏書出獄之承接第15段鄒陽獄中上書，末句上客以同一省略主語暫接。","surfaces":["之","臣","鄒陽"],"evidence":[{"paragraph_id":"c-shiji-083-luzou:p015","quote":"鄒陽者，齊人也。游於梁，與故吳人莊忌夫子、淮陰枚生之徒交。上書而介於羊勝、公孫詭之閒。勝等嫉鄒陽，惡之梁孝王。孝王怒，下之吏，將欲殺之。鄒陽客游，以讒見禽，恐死而負累，乃從獄中上書曰："},{"paragraph_id":"c-shiji-083-luzou:p016","quote":"臣聞忠無不報，信不見疑，臣常以為然，徒虛語耳。昔者荊軻慕燕丹之義，白虹貫日，太子畏之；衛先生為秦畫長平之事，太白蝕昴，而昭王疑之。夫精變天地而信不喻兩主，豈不哀哉！今臣盡忠竭誠，畢議願知，左右不明，卒從吏訊，為世所疑，是使荊軻、衛先生復起，而燕、秦不悟也。願大王孰察之。"},{"paragraph_id":"c-shiji-083-luzou:p017","quote":"昔卞和獻寶，楚王刖之；李斯竭忠，胡亥極刑。是以箕子詳狂，接輿辟世，恐遭此患也。願大王孰察卞和、李斯之意，而後楚王、胡亥之聽，無使臣為箕子、接輿所笑。臣聞比干剖心，子胥鴟夷，臣始不信，乃今知之。願大王孰察，少加憐焉。"},{"paragraph_id":"c-shiji-083-luzou:p022","quote":"臣聞明月之珠，夜光之璧，以闇投人於道路，人無不按劍相眄者。何則？無因而至前也。蟠木根柢，輪囷離詭，而為萬乘器者。何則？以左右先為之容也。故無因至前，雖出隨侯之珠，夜光之璧，猶結怨而不見德。故有人先談，則以枯木朽株樹功而不忘。今夫天下布衣窮居之士，身在貧賤，雖蒙堯、舜之術，挾伊、管之辯，懷龍逢、比干之意，欲盡忠當世之君，而素無根柢之容，雖竭精思，欲開忠信，輔人主之治，則人主必有按劍相眄之跡，是使布衣不得為枯木朽株之資也。"},{"paragraph_id":"c-shiji-083-luzou:p025","quote":"臣聞盛飾入朝者不以利汙義，砥厲名號者不以欲傷行，故縣名勝母而曾子不入，邑號朝歌而墨子回車。今欲使天下寥廓之士，攝於威重之權，主於位勢之貴，故回面汙行以事諂諛之人而求親近於左右，則士伏死堀穴巖巖之中耳，安肯有盡忠信而趨闕下者哉！"},{"paragraph_id":"c-shiji-083-luzou:p027","quote":"太史公曰：魯連其指意雖不合大義，然余多其在布衣之位，蕩然肆志，不詘於諸侯，談說於當世，折卿相之權。鄒陽辭雖不遜，然其比物連類，有足悲者，亦可謂抗直不橈矣，吾是以附之列傳焉。"},{"paragraph_id":"c-shiji-083-luzou:p026","quote":"書奏梁孝王，孝王使人出之，卒為上客。"}]}],"equivalence_decisions":[{"id":"eq-shiji083-zouyang","person_ids":["06n_ttw_xgt"],"canonical_person_id":"06n_ttw_xgt","scope":"cross_chapter","chapter_ids":["c-shiji-058-liang","c-shiji-083-luzou"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-058-liang","source_id":"s-shiji-058-liang","paragraph_id":"c-shiji-058-liang:p006","quote":"孝王，竇太后少子也，愛之，賞賜不可勝道。於是孝王筑東苑，方三百餘里。廣睢陽城七十里。大治宮室，為複道，自宮連屬於平臺三十餘里。得賜天子旌旗，出從千乘萬騎。東西馳獵，擬於天子。出言蹕，入言警。招延四方豪桀，自山以東游說之士。莫不畢至，齊人羊勝、公孫詭、鄒陽之屬。公孫詭多奇邪計，初見王，賜千金，官至中尉，梁號之曰公孫將軍，梁多作兵器弩弓矛數十萬，而府庫金錢且百巨萬，珠玉寶器多於京師。","mention_ids":["c-shiji-058-liang:m006-0125"]},{"chapter_id":"c-shiji-083-luzou","source_id":"s-shiji-083-luzou","paragraph_id":"c-shiji-083-luzou:p015","quote":"鄒陽者，齊人也。游於梁，與故吳人莊忌夫子、淮陰枚生之徒交。上書而介於羊勝、公孫詭之閒。勝等嫉鄒陽，惡之梁孝王。孝王怒，下之吏，將欲殺之。鄒陽客游，以讒見禽，恐死而負累，乃從獄中上書曰：","mention_ids":["c-shiji-083-luzou:m015-0000","c-shiji-083-luzou:m015-0046","c-shiji-083-luzou:m015-0068"]}],"rationale":"兩篇梁孝王與羊勝、公孫詭、鄒陽在同一賓客群及梁廷關係中相配，國別、王稱與三名人物組合支持同指；058首段明名武，083入獄上書獲釋事件仍以本篇為證。不是該上書或受讒的獨立見證；說話者與別篇勝各分，不按全域同名合併。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true},{"id":"eq-shiji117-opening-zouyang","person_ids":["06n_ttw_xgt"],"canonical_person_id":"06n_ttw_xgt","scope":"cross_chapter","chapter_ids":["c-shiji-117-xiangru","c-shiji-083-luzou"],"status":"contextual_provisional","confidence_level":"high","evidence":[{"chapter_id":"c-shiji-117-xiangru","source_id":"s-shiji117-xiangru","paragraph_id":"c-shiji-117-xiangru:p001","quote":"司馬相如者，蜀郡成都人也，字長卿。少時好讀書，學擊劍，故其親名之曰犬子。相如既學，慕藺相如之為人，更名相如。以貲為郎，事孝景帝，為武騎常侍，非其好也。會景帝不好辭賦，是時梁孝王來朝，從遊說之士齊人鄒陽、淮陰枚乘、吳莊忌夫子之徒，相如見而說之，因病免，客游梁。梁孝王令與諸生同舍，相如得與諸生游士居數歲，乃著子虛之賦。","mention_ids":["c-shiji-117-xiangru:m001-0098"]},{"chapter_id":"c-shiji-083-luzou","source_id":"s-shiji-083-luzou","paragraph_id":"c-shiji-083-luzou:p015","quote":"鄒陽者，齊人也。游於梁，與故吳人莊忌夫子、淮陰枚生之徒交。上書而介於羊勝、公孫詭之閒。勝等嫉鄒陽，惡之梁孝王。孝王怒，下之吏，將欲殺之。鄒陽客游，以讒見禽，恐死而負累，乃從獄中上書曰：","mention_ids":["c-shiji-083-luzou:m015-0000","c-shiji-083-luzou:m015-0046","c-shiji-083-luzou:m015-0068"]}],"rationale":"兩篇同記齊人鄒陽、客梁，並與莊忌及淮陰枚乘／枚生同一游士群，依地域與共同人物脈絡接合。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true}],"passages":[{"id":"c-shiji-058-liang:p006","text":"孝王，竇太后少子也，愛之，賞賜不可勝道。於是孝王筑東苑，方三百餘里。廣睢陽城七十里。大治宮室，為複道，自宮連屬於平臺三十餘里。得賜天子旌旗，出從千乘萬騎。東西馳獵，擬於天子。出言蹕，入言警。招延四方豪桀，自山以東游說之士。莫不畢至，齊人羊勝、公孫詭、鄒陽之屬。公孫詭多奇邪計，初見王，賜千金，官至中尉，梁號之曰公孫將軍，梁多作兵器弩弓矛數十萬，而府庫金錢且百巨萬，珠玉寶器多於京師。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-058-liang:m006-0000","start":0,"end":2,"surface":"孝王","kind":"person","person_id":"yqp_nlb_p1p_ACG","status":"contextual_provisional"},{"id":"c-shiji-058-liang:m006-0003","start":3,"end":6,"surface":"竇太后","kind":"person","person_id":"ixk_6fg_v6f_A","status":"contextual_provisional"},{"id":"c-shiji-058-liang:m006-0022","start":22,"end":24,"surface":"孝王","kind":"person","person_id":"yqp_nlb_p1p_ACG","status":"contextual_provisional"},{"id":"c-shiji-058-liang:m006-0065","start":65,"end":67,"surface":"天子","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、所舉古事或未定指代；不補來源未見姓名、成員及關係。"},{"id":"c-shiji-058-liang:m006-0084","start":84,"end":86,"surface":"天子","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、所舉古事或未定指代；不補來源未見姓名、成員及關係。"},{"id":"c-shiji-058-liang:m006-0099","start":99,"end":101,"surface":"豪桀","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、所舉古事或未定指代；不補來源未見姓名、成員及關係。"},{"id":"c-shiji-058-liang:m006-0