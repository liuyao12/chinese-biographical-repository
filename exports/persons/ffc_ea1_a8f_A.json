pter_id":"c-songshu-060-fantai","source_id":"s-songshu-060-fantai-ws1996694","paragraph_id":"c-songshu-060-fantai:p001","quote":"范泰字伯倫，順陽山陰人也。祖汪，晉安北將軍、徐兗二州刺史。父甯，豫章太守。","subject_person_mention_id":"c-songshu-060-fantai:p001:m0000","object_person_mention_id":"c-songshu-060-fantai:p001:m0014"}],"interpretation_note":"本傳明載祖汪。","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null}],"title_holdings":[],"address_assertions":[],"person_references":[{"id":"c-nanshi-024-wangzhunzhi:p002:r0117","surface":"卿","start":117,"end":118,"person_id":"ffc_ea1_a8f_A","referent_role":"addressee","paragraph_id":"c-nanshi-024-wangzhunzhi:p002","quote":"准之兼明禮傳，贍于文辭。桓玄篡位，以爲尚書祠部郎。宋武帝起兵，爲太尉主簿。出爲山陰令，有能名，預討盧循功，封都亭侯。宋台建，除御史中丞，爲百僚所憚。自彪之至准之四世居此職。准之嘗作五言詩，範泰嘲之：「卿唯解彈事耳。」准之正色答：「猶差卿世載雄狐。」坐世子左衞率謝靈運殺人不舉，免官。","note":"准之回應範泰。","chapter_id":"c-nanshi-024-wangzhunzhi","book_id":"b-nanshi-024","work_id":"w-nanshi","source_id":"s-nanshi-024-wangzhunzhi-ws1765279"},{"start":194,"end":195,"surface":"卿","id":"c-songshu-060-wangzhunzhi:p002:r0194","paragraph_id":"c-songshu-060-wangzhunzhi:p002","person_id":"ffc_ea1_a8f_A","referent_role":"addressee","quote":"准之兼明禮傳，贍於文辭。起家為本國右常侍，桓玄大將軍行參軍。玄篡位，以為尚書祠部郎。義熙初，又為尚書中兵郎，遷參高祖車騎中軍軍事，丹陽丞，中軍太尉主簿，出為山陰令，有能名。預討盧循功，封都亭侯。又為高祖鎮西、平北、太尉參軍，尚書左丞，本郡大中正。宋臺建，除御史中丞，為僚友所憚。准之父訥之、祖臨之、曾祖彪之至准之，四世居此職。准之嘗作五言，范泰謿之曰：「卿唯解彈事耳。」准之正色答：「猶差卿世載雄狐。」坐世子右衞率謝靈運殺人不舉免官。","note":"本句按敘述視點回指范。","chapter_id":"c-songshu-060-wangzhunzhi","book_id":"b-songshu-060","work_id":"w-songshu","source_id":"s-songshu-060-wangzhunzhi-ws1996694"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanshi-019-dan19:p001","text":"澹字景恆，晦從叔也。祖安，晉太傅。父瑤，琅邪王友。澹任達仗氣，不營當世，與順陽范泰爲雲霞之交。歷位尙書。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-nanshi-019-dan19:p001:m0000","start":0,"end":1,"surface":"澹","person_id":"ph1_0cf_nxw","kind":"person","status":"contextual_provisional","interpretation_note":"傳首名。"},{"id":"c-nanshi-019-dan19:p001:m0002","start":2,"end":4,"surface":"景恆","person_id":"ph1_0cf_nxw","kind":"person","status":"contextual_provisional","interpretation_note":"澹之字。"},{"id":"c-nanshi-019-dan19:p001:m0005","start":5,"end":6,"surface":"晦","person_id":"aa6_83c_juy_AAAA","kind":"person","status":"contextual_provisional","interpretation_note":"謝晦的從叔為澹。"},{"id":"c-nanshi-019-dan19:p001:m0011","start":11,"end":12,"surface":"安","person_id":"aa6_83c_juy_B","kind":"person","status":"contextual_provisional","interpretation_note":"澹之祖。"},{"id":"c-nanshi-019-dan19:p001:m0018","start":18,"end":19,"surface":"瑤","person_id":"6na_bet_3ch","kind":"person","status":"contextual_provisional","interpretation_note":"澹之父。"},{"id":"c-nanshi-019-dan19:p001:m0025","start":25,"end":26,"surface":"澹","person_id":"ph1_0cf_nxw","kind":"person","status":"contextual_provisional","interpretation_note":"承傳首。"},{"id":"c-nanshi-019-dan19:p001:m0039","start":39,"end":41,"surface":"范泰","person_id":"ffc_ea1_a8f_A","kind":"person","status":"contextual_provisional","interpretation_note":"順陽范泰，與澹為友。"}],"source_position":{"raw_start":3355,"raw_end":3411,"raw_character_offsets":[3355,3356,3357,3358,3359,3360,3361,3362,3363,3364,3365,3366,3367,3368,3369,3370,3371,3372,3373,3374,3375,3376,3377,3378,3379,3380,3381,3382,3383,3384,3385,3386,3387,3388,3389,3390,3391,3392,3393,3396,3399,3400,3401,3402,3403,3404,3405,3406,3407,3408,3409,3410],"revision_id":1531762,"source_layer":"received_biography","projection_sha256":"cad695851a58de466ceb36a0def26678c7518cde119b7148e53b8c2d1e6a7ba8"},"chapter_id":"c-nanshi-019-dan19","book_id":"b-nanshi-019","work_id":"w-nanshi","source_id":"s-nanshi-019-dan19-ws1531762"},{"id":"c-nanshi-024-wangzhunzhi:p002","text":"准之兼明禮傳，贍于文辭。桓玄篡位，以爲尚書祠部郎。宋武帝起兵，爲太尉主簿。出爲山陰令，有能名，預討盧循功，封都亭侯。宋台建，除御史中丞，爲百僚所憚。自彪之至准之四世居此職。准之嘗作五言詩，範泰嘲之：「卿唯解彈事耳。」准之正色答：「猶差卿世載雄狐。」坐世子左衞率謝靈運殺人不舉，免官。","mentions":[{"id":"c-nanshi-024-wangzhunzhi:p002:m0000","surface":"准之","start"