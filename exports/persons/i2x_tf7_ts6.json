{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"i2x_tf7_ts6","canonical_person_id":"i2x_tf7_ts6","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["i2x_tf7_ts6"],"persons":[{"id":"i2x_tf7_ts6","label":"董凱之（宋龍驤將軍）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"董凱之","mention_ids":["c-songshu-050-zhangxingshi-complete:p003:m0090"]}],"evidence":[{"mention_id":"c-songshu-050-zhangxingshi-complete:p003:m0090","paragraph_id":"c-songshu-050-zhangxingshi-complete:p003","chapter_id":"c-songshu-050-zhangxingshi-complete","quote":"董凱之"}],"review":"ai_provisional","identity_note":"《宋書》卷五十張興世傳所見，宋龍驤將軍。"}],"source_mention_summary":[{"source_id":"s-songshu-050-zhangxingshi-complete-ws2371899","work_id":"w-songshu","book_id":"b-songshu-050","chapter_id":"c-songshu-050-zhangxingshi-complete","raw_mention_count":1,"mention_ids":["c-songshu-050-zhangxingshi-complete:p003:m0090"],"paragraph_ids":["c-songshu-050-zhangxingshi-complete:p003"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-songshu-050-zhangxingshi-complete:p003:m0090","mention_ids":["c-songshu-050-zhangxingshi-complete:p003:m0090"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-songshu-050-zhangxingshi-complete-ws2371899"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-songshu-050-zhangxingshi-complete:p003:m0090","start":90,"end":93,"surface":"董凱之","kind":"person","person_id":"i2x_tf7_ts6","status":"contextual_provisional","paragraph_id":"c-songshu-050-zhangxingshi-complete:p003","chapter_id":"c-songshu-050-zhangxingshi-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-songshu-050-zhangxingshi-complete:p003","text":"大明末，除員外散騎侍郎，仍除宣威將軍、隨郡太守。未行，太宗即位，四方反叛。進興世號龍驤將軍，領水軍，距南賊於赭圻。築二城於湖口，偽龍驤將軍陳慶領舸於前為游軍。興世率龍驤將軍佼長生、董凱之攻克二城，因擊慶，慶戰大敗，投水死者數千人。時臺軍據赭圻，南賊屯鵲尾，相持久不決。興世建議曰：「賊據上流，兵強地勝。我今雖相持有餘，而制敵不足。今若以兵數千，潛出其上，因險自固，隨宜斷截，使其首尾周遑，進退疑沮，中流一梗，糧運自艱。制賊之奇，莫過於此。」沈攸之、吳喜並贊其計。時豫州刺史殷琰據壽陽同逆，為劉勔所攻，南賊遣龐孟虯率軍助琰，劉勔遣信求援甚急。建安王休仁欲遣興世救之，問沈攸之。攸之曰：「孟虯蟻寇，必無能為。遣別將馬步數千，足以相制。若有意外，且以江西餌之。上流若捷，不憂不殄。興世之行，是安危大機，必不可輟。」乃遣段佛榮等援勔。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":71,"last_line":71,"raw_start":6400,"raw_end":6913,"raw_character_offsets":[6400,6401,6402,6403,6404,6405,6406,6407,6408,6409,6410,6411,6412,6413,6414,6415,6416,6417,6418,6419,6420,6421,6422,6423,6424,6425,6426,6427,6428,6429,6430,6431,6432,6433,6434,6435,6436,6437,6438,6439,6440,6441,6442,6443,6444,6445,6446,6447,6448,6449,6450,6451,6452,6453,6454,6455,6456,6457,6458,6459,6460,6461,6462,6463,6537,6538,6539,6540,6541,6542,6543,6544,6545,6546,6547,6548,6549,6550,6551,6552,6553,6554,6555,6556,6557,6558,6559,6560,6561,6562,6563,6564,6565,6566,6567,6568,6569,6570,6571,6572,6573,6574,6575,6576,6577,6578,6579,6580,6581,6582,6583,6584,6585,6586,6587,6588,6589,6590,6591,6592,6593,6594,6595,6596,6597,6598,6599,6600,6601,6602,6603,6604,6605,6606,6607,6608,6609,6610