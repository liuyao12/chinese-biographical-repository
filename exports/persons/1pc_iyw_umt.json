her","generation_distance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-039-jin","source_id":"s-shiji-039-jin","paragraph_id":"c-shiji-039-jin:p052","quote":"狄伐咎如，得二女：以長女妻重耳，生伯鯈、叔劉；以少女妻趙衰，生盾。居狄五歳而晉獻公卒，裏克已殺奚齊、悼子，乃使人迎，欲立重耳。重耳畏殺，因固謝，不敢入。已而晉更迎其弟夷吾立之，是爲惠公。惠公七年，畏重耳，乃使宦者履鞮與壯士欲殺重耳。重耳聞之，乃謀趙衰等曰：「始吾奔狄，非以爲可用與，以近易通，故且休足。休足久矣，固願徙之大國。夫齊桓公好善，志在霸王，收恤諸侯。今聞管仲、隰朋死，此亦欲得賢佐，盍往乎？」於是遂行。重耳謂其妻曰：「待我二十五年不來，乃嫁。」其妻笑曰：「犁二十五年，吾冢上柏大矣。雖然，妾待子。」重耳居狄凡十二年而去。","source_term":"生盾"}],"source_assertion_id":"a-shiji039-045","interpretation_note":"以此受傳正文的明示近親主張配置局部家族；不合併跨篇候選身份、不補闕名世代，不表示遠祖世系已核實。分支字元不是長幼排行。","reviewer":"Codex（AI 代理）","parent_person_id":"dm0_58v_50i"}},{"id":"imr_0y4_sn9","label":"趙衰晉妻（趙世家未名者）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"晉之妻","mention_ids":["c-shiji-043-zhao:m011-0006"]},{"surface":"晉妻","mention_ids":["c-shiji-043-zhao:m011-0024"]},{"surface":"妻","mention_ids":["c-shiji-043-zhao:m010-0082"]}],"evidence":[{"mention_id":"c-shiji-043-zhao:m011-0006","chapter_id":"c-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p011","quote":"晉之妻"},{"mention_id":"c-shiji-043-zhao:m011-0024","chapter_id":"c-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p011","quote":"晉妻"},{"mention_id":"c-shiji-043-zhao:m010-0082","chapter_id":"c-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p010","quote":"妻"}]}],"source_mention_summary":[{"source_id":"s-shiji-043-zhao","work_id":"w-shiji","book_id":"b-shiji-043","chapter_id":"c-shiji-043-zhao","mention_count":2,"mention_ids":["c-shiji-043-zhao:m010-0063","c-shiji-043-zhao:m011-0012"],"paragraph_ids":["c-shiji-043-zhao:p010","c-shiji-043-zhao:p011"],"table_cell_ids":[],"passage_count":2}],"most_mentioned_source_ids":["s-shiji-043-zhao"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"repor