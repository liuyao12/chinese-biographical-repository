:"c-jinshu-089-jishao:p001:m0109","start":109,"end":110,"surface":"之","kind":"person","person_id":"6fg_r6l_5a5_A","status":"contextual_provisional","interpretation_note":"依完整本傳敘事／引語主語辨識，不以最近姓名機械延續。"}],"source_position":{"first_line":17,"last_line":17,"raw_projection_ref":"source-evidence/jin089-jishao-projection.json","unit_key":"jishao-p001"},"chapter_id":"c-jinshu-089-jishao","book_id":"b-jinshu-089","work_id":"w-jinshu","source_id":"s-jinshu-089-jishao"},{"id":"c-jinshu-089-jishao:p002","text":"紹始入洛，或謂王戎曰：「昨于稠人中始見嵇紹，昂昂然如野鶴之在雞群。」戎曰：「君復未見其父耳。」累遷汝陰太守。尚書左僕射裴頠亦深器之，每曰：「使延祖為吏部尚書，可使天下無復遺才矣。」沛國戴晞少有才智，與紹從子含相友善，時人許以遠致，紹以為必不成器。晞後為司州主簿，以無行被斥，州黨稱紹有知人之明。轉豫章內史，以母憂，不之官。服闋，拜徐州刺史。時石崇為都督，性雖驕暴，而紹將之以道，崇甚親敬之。後以長子喪去職。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-jinshu-089-jishao:p002:m0000","start":0,"end":1,"surface":"紹","kind":"person","person_id":"6fg_r6l_5a5_A","status":"contextual_provisional","interpretation_note":"依完整本傳敘事／引語主語辨識，不以最近姓名機械延續。"},{"id":"c-jinshu-089-jishao:p002:m0005","start":5,"end":6,"surface":"或","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"未名與王戎談話者，不補名。"},{"id":"c-jinshu-089-jishao:p002:m0007","start":7,"end":9,"surface":"王戎","kind":"person","person_id":"ehx_cqg_nfx_AA","status":"contextual_provisional","interpretation_note":"依完整本傳敘事／引語主語辨識，不以最近姓名機械延續。"},{"id":"c-jinshu-089-jishao:p002:m0019","start":19,"end":21,"surface":"嵇紹","kind":"person","person_id":"6fg_r6l_5a5_A","status":"contextual_provisional","interpretation_note":"依完整本傳敘事／引語主語辨識，不以最近姓名機械延續。"},{"id":"c-jinshu-089-jishao:p002:m0034","start":34,"end":35,"surface":"戎","kind":"person","person_id":"ehx_cqg_nfx_AA","status":"contextual_provisional","interpretation_note":"依完整本傳敘事／引語主語辨識，不以最近姓名機械延續。"},{"id":"c-jinshu-089-jishao:p002:m0038","start":38,"end":39,"surface":"君","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"王戎答未名談話者；非嵇紹。"},{"id":"c-jinshu-089-jishao:p002:m0042","start":42,"end":44,"surface":"其父","kind":"person","person_id":"6fg_r6l_5a5","status":"contextual_provisional","interpretation_note":"依完整本傳敘事／引語主語辨識，不以最近姓名機械延續。"},{"id":"c-jinshu-089-jishao:p002:m0059","start":59,"end":61,"surface":"裴頠","kind":"person","person_id":"4ni_4t1_4o9_AAB","status":"contextual_provisional","interpretation_note":"089完整嵇紹篇在王戎相知、元康賈謐與趙倫之亂的敘事中，明名尚書左僕射裴頠；固定035裴頠完整附傳明遷尚書左僕射侍中如故，與樂廣往來、賈模張華共議賈后、被趙倫誅的官職及時域相容。據具名、同一官職及相容往來首選同人；非只按姓氏或候選沿用，亦不把前後官序推成精確起訖。","identity_decision_id":"d-jin089-peiwei-office-context"},{"id":"c-jinshu-089-jishao:p002:m0064","start":64,"end":65,"surface":"之","kind":"person","person_id":"6fg_r6l_5a5_A","status":"contextual_provisional","interpretation_note":"依完整本傳敘事／引語主語辨識，不以最近姓名機械延續。"},{"id":"c-jinshu-089-jishao:p002:m0071","start":71,"end":73,"surface":"延祖","kind":"person","person_id":"6fg_r6l_5a5_A","status":"contextual_provisional","interpretation_note":"依完整本傳敘事／引語主語辨識，不以最近姓名機械延續。"},{"id":"c-jinshu-089-jishao:p002:m0092","start":92,"end":94,"surface":"戴晞","kind":"person","person_id":"5zf_z7a_qk5","status":"contextual_provisional","interpretation_note":"依完整本傳敘事／引語主語辨識，不以最近姓名機械延續。"},{"id":"c-jinshu-089-jishao:p002:m0100","start":100,"end":101,"surface":"紹","kind":"person","person_id":"6fg_r6l_5a5_A","status":"contextual_provisional","interpretation_note":"依完整本傳敘事／引語主語辨識，不以最近姓名機械延續。"},{"id":"c-jinshu-089-jishao:p002:m0103","start":103,"end":104,"surface":"含","kind":"person","person_id":"abd_10d_825","status":"contextual_provisional","interpretation_note":"依完整本傳敘事／引語主語辨識，不以最近姓名機械延續。"},{"id":"c-jinshu-089-jishao:p002:m0115","start":115,"end":116,"surface":"紹","kind":"person","person_id":"6fg_r6l_5a5_A","status":"contextual_provisional","interpretation_note":"依完整本傳敘事／引語主語辨識，不以最近姓名機械延續。"},{"id":"c-jinshu-089-jishao:p002:m0123","start":123,"end":124,"surface":"晞","kind":"person","person_id":"5zf_z7a_qk5","status":"contextual_provisional","interpretation_note":"依完整本傳敘事／引語主語辨識，不以最近姓名機械延續。"},{"id":"c-jinshu-089-jishao:p002:m0140","start":140,"end":141,"surfa