{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"3ea_uzt_2n2_BB","canonical_person_id":"3ea_uzt_2n2_BB","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["3ea_uzt_2n2_BB"],"persons":[{"id":"3ea_uzt_2n2_B","label":"何澄（字季玄，何准子）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"澄","mention_ids":["c-jinshu-093-heyu-grandfather-context:p001:m0164","c-jinshu-093-heyu-grandfather-context:p002:m0000","c-jinshu-093-heyu-grandfather-context:p002:m0101","c-songshu-041-heyu-ancestors-context:p001:m0012"]},{"surface":"季玄","mention_ids":["c-jinshu-093-heyu-grandfather-context:p002:m0002"]}],"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-093","source_id":"s-jinshu-093-heyu-grandfather-context-ws1548000","chapter_id":"c-jinshu-093-heyu-grandfather-context","paragraph_id":"c-jinshu-093-heyu-grandfather-context:p001","quote":"澄","mention_id":"c-jinshu-093-heyu-grandfather-context:p001:m0164"},{"work_id":"w-jinshu","book_id":"b-jinshu-093","source_id":"s-jinshu-093-heyu-grandfather-context-ws1548000","chapter_id":"c-jinshu-093-heyu-grandfather-context","paragraph_id":"c-jinshu-093-heyu-grandfather-context:p002","quote":"澄","mention_id":"c-jinshu-093-heyu-grandfather-context:p002:m0000"},{"work_id":"w-jinshu","book_id":"b-jinshu-093","source_id":"s-jinshu-093-heyu-grandfather-context-ws1548000","chapter_id":"c-jinshu-093-heyu-grandfather-context","paragraph_id":"c-jinshu-093-heyu-grandfather-context:p002","quote":"澄","mention_id":"c-jinshu-093-heyu-grandfather-context:p002:m0101"},{"work_id":"w-jinshu","book_id":"b-jinshu-093","source_id":"s-jinshu-093-heyu-grandfather-context-ws1548000","chapter_id":"c-jinshu-093-heyu-grandfather-context","paragraph_id":"c-jinshu-093-heyu-grandfather-context:p002","quote":"季玄","mention_id":"c-jinshu-093-heyu-grandfather-context:p002:m0002"},{"work_id":"w-songshu","book_id":"b-songshu-041","source_id":"s-songshu-041-heyu-ancestors-context-ws2634831","chapter_id":"c-songshu-041-heyu-ancestors-context","paragraph_id":"c-songshu-041-heyu-ancestors-context:p001","quote":"澄","mention_id":"c-songshu-041-heyu-ancestors-context:p001:m0012"}],"review":"ai_provisional","identity_note":"晉書外戚傳列何准三子，另敘澄字季玄，安帝即位後遷尚書左僕射；宋書卷四十一記何瑀為其曾孫。","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"3ea_uzt_2n2","source_assertion_id":"a-nan023-heyucontext-zhun-child-澄","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-093","source_id":"s-jinshu-093-heyu-grandfather-context-ws1548000","chapter_id":"c-jinshu-093-heyu-grandfather-context","paragraph_id":"c-jinshu-093-heyu-grandfather-context:p001","quote":"何准，字幼道，穆章皇后父也。高尚寡欲，弱冠知名，州府交辟，並不就。兄充為驃騎將軍，勸其令仕，准曰：「第五之名何滅驃騎？」准兄弟中第五，故有此言。充居宰輔之重，權傾一時，而准散帶衡門，不及人事，唯誦佛經，修營塔廟而已。徵拜散騎郎，不起。年四十七卒。昇平元年，追贈金紫光祿大夫，封晉興縣侯。子惔以父素行高潔，表讓不受。三子：放、惔、澄。放繼充。","subject_person_mention_id":"c-jinshu-093-heyu-grandfather-context:p001:m0164","object_person_mention_id":"c-jinshu-093-heyu-grandfather-context:p001:m0000"}],"status":"contextual_provisional","interpretation_note":"何准傳以三子連舉三人。","human_reviewed":false}},{"id":"3ea_uzt_2n2_BB","label":"何籍（何澄長子）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"籍","mention_ids":["c-jinshu-093-heyu-grandfather-context:p002:m0157"]}],"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-093","source_id":"s-jinshu-093-heyu-grandfather-context-ws1548000","chapter_id":"c-jinshu-093-heyu-grandfather-context","paragraph_id":"c-jinshu-093-heyu-grandfather-context:p002","quote":"籍","mention_id":"c-jinshu-093-heyu-grandfather-context:p002:m0157"}],"review":"ai_provisional","identity_note":"晉書何澄傳末稱長子籍早卒。","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"3ea_uzt_2n2_B","source_assertion_id":"a-nan023-heyucontext-cheng-child-籍","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-093","source_id":"s-jinshu-093-heyu-grandfather-context-ws1548000","chapter_id":"c-jinshu-093-heyu-grandfather-context","paragraph_id":"c-jinshu-093-heyu-grandfather-context:p002","quote":"澄字季玄，起家秘書郎，轉丞，清正有器望，累遷秘書監、太常、中護軍。孝武帝深愛之，以為冠軍將軍、吳國內史。太元末，琅邪王出居外第，妙選師傅，徵拜尚書，領琅邪王師。安帝即位，遷尚書左僕射，典選、王師如故。時澄腳疾，固讓，特聽不朝，坐家視事。又領本州大中正。及桓玄執政，以疾奏免，卒於家。安帝反正，追贈金紫光祿大夫。長子籍，早卒。次子融，元熙中，為大司農。","subject_person_mention_id":"c-jinshu-093-heyu-grandfather-context:p002:m0157","object_person_mention_id":"c-jinshu-093-heyu-grandfather-context:p002:m0000"}],"status":"contextual_provisional","interpretation_note":"何澄傳末分記兩子。","human_reviewed":false}}],"source_mention_summary":[{"source_id":"s-jinshu-093-heyu-grandfather-context-ws1548000","work_id":"w-jinshu","book_id":"b-jinshu-093","chapter_id":"c-jinshu-093-heyu-grandfather-context","raw_mention_count":1,"mention_ids":["c-jinshu-093-heyu-grandfather-context:p002:m0157"],"paragraph_ids":["c-jinshu-093-heyu-grandfather-context:p002"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-093-heyu-grandfather-context:p002:m0157","mention_ids":["c-jinshu-093-heyu-grandfather-context:p002:m0157"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-093-heyu-grandfather-context-ws1548000"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-nan023-heyucontext-cheng-child-籍","subject_person_id":"3ea_uzt_2n2_BB","object_person_id":"3ea_uzt_2n2_B","predicate":"father","qualifiers":{"source_term":"長子籍","nan023_heyu_readi