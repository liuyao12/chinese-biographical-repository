-waiqi"},{"id":"c-shiji-049-waiqi:m012-0163","start":163,"end":165,"surface":"王后","kind":"person","person_id":"yvu_kzd_gnn","status":"contextual_provisional","paragraph_id":"c-shiji-049-waiqi:p012","chapter_id":"c-shiji-049-waiqi"},{"id":"c-shiji-049-waiqi:m012-0175","start":175,"end":177,"surface":"王后","kind":"person","person_id":"yvu_kzd_gnn","status":"contextual_provisional","paragraph_id":"c-shiji-049-waiqi:p012","chapter_id":"c-shiji-049-waiqi"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji049-016","person_id":"yvu_kzd_gnn","surfaces":["代王王后","王后"],"scope":"same_chapter","chapter_ids":["c-shiji-049-waiqi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-049-waiqi:p012","quote":"竇太后，趙之清河觀津人也。呂太后時，竇姬以良家子入宮侍太后。太后出宮人以賜諸王，各五人，竇姬與在行中。竇姬家在清河，欲如趙近家，請其主遣宦者吏：「必置我籍趙之伍中。」宦者忘之，誤置其籍代伍中。籍奏，詔可，當行。竇姬涕泣，怨其宦者，不欲往，相彊，乃肯行。至代，代王獨幸竇姬，生女嫖，後生兩男。而代王王后生四男。先代王未入立為帝而王后卒。及代王立為帝，而王后所生四男更病死。孝文帝立數月，公卿請立太子，而竇姬長男最長，立為太子。立竇姬為皇后，女嫖為長公主。其明年，立少子武為代王，已而又徙梁，是為梁孝王。"}],"rationale":"按明示名、字及各帝后局部親屬敘事暫接；王夫人分景帝皇后與武帝趙妃，代王分文帝與後來少子武。未名者不補姓名，褚氏附載另留原語。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-049-waiqi:p012","text":"竇太后，趙之清河觀津人也。呂太后時，竇姬以良家子入宮侍太后。太后出宮人以賜諸王，各五人，竇姬與在行中。竇姬家在清河，欲如趙近家，請其主遣宦者吏：「必置我籍趙之伍中。」宦者忘之，誤置其籍代伍中。籍奏，詔可，當行。竇姬涕泣，怨其宦者，不欲往，相彊，乃肯行。至代，代王獨幸竇姬，生女嫖，後生兩男。而代王王后生四男。先代王未入立為帝而王后卒。及代王立為帝，而王后所生四男更病死。孝文帝立數月，公卿請立太子，而竇姬長男最長，立為太子。立竇姬為皇后，女嫖為長公主。其明年，立少子武為代王，已而又徙梁，是為梁孝王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-049-waiqi:m012-0000","start":0,"end":3,"surface":"竇太后","kind":"person","person_id":"ixk_6fg_v6f_A","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m012-0013","start":13,"end":16,"surface":"呂太后","kind":"person","person_id":"trv_ybp_bes","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m012-0018","start":18,"end":20,"surfa