{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p002364","canonical_person_id":"8fl_fbf_5p5","id_aliases":["cbr-p002364"],"identity_policy":"contextual_provisional","person_ids":["8fl_fbf_5p5"],"persons":[{"id":"8fl_fbf_5p5","label":"秦獻公（趙世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"秦獻公","mention_ids":["c-shiji-043-zhao:m052-0187"]}],"evidence":[{"mention_id":"c-shiji-043-zhao:m052-0187","chapter_id":"c-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p052","quote":"秦獻公"}],"id_aliases":["cbr-p002364"]}],"source_mention_summary":[{"source_id":"s-shiji-043-zhao","work_id":"w-shiji","book_id":"b-shiji-043","chapter_id":"c-shiji-043-zhao","mention_count":1,"mention_ids":["c-shiji-043-zhao:m052-0187"],"paragraph_ids":["c-shiji-043-zhao:p052"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-043-zhao"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-043-zhao:m052-0187","start":187,"end":190,"surface":"秦獻公","kind":"person","person_id":"8fl_fbf_5p5","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p052","chapter_id":"c-shiji-043-zhao"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji043-135","person_id":"8fl_fbf_5p5","surfaces":["秦獻公"],"scope":"same_chapter","chapter_ids":["c-shiji-043-zhao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-043-zhao:p052","quote":"成侯元年，公子勝與成侯爭立，爲亂。二年六月，雨雪。三年，太戊午爲相。伐衞，取鄕邑七十三。魏敗我藺。四年，與秦戰髙安，敗之。五年，伐齊于鄄。魏敗我懷。攻鄭，敗之，以與韓，韓與我長子。六年，中山筑長城。伐魏，敗湪澤，圍魏惠王。七年，侵齊，至長城。與韓攻周。八年，與韓分周以爲兩。九年，與齊戰阿下。十年，攻衞，取甄。十一年，秦攻魏，趙救之石阿。十二年，秦攻魏少梁，趙救之。十三年，秦獻公使庶長國伐魏少梁，虜其太子、痤。魏敗我澮，取皮牢。成侯與韓昭侯遇上黨。十四年，與韓攻秦。十五年，助魏攻齊。"}],"rationale":"限本篇明示姓名、是為與連續事件；太戊午／大戊午暫接但字形待底本核查。娃嬴／孟姚／惠后按本段明示暫接，不與先前夢辭孟姚按同名合併；王紲與較早公子紲分候選。君王職稱按各國上下文辨別，不全域匹配。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-043-zhao:p052","text":"成侯元年，公子勝與成侯爭立，爲亂。二年六月，雨雪。三年，太戊午爲相。伐衞，取鄕邑七十三。魏敗我藺。四年，與秦戰髙安，敗之。五年，伐齊于鄄。魏敗我懷。攻鄭，敗之，以與韓，韓與我長子。六年，中山筑長城。伐魏，敗湪澤，圍魏惠王。七年，侵齊，至長城。與韓攻周。八年，與韓分周以爲兩。九年，與齊戰阿下。十年，攻衞，取甄。十一年，秦攻魏，趙救之石阿。十二年，秦攻魏少梁，趙救之。十三年，秦獻公使庶長國伐魏少梁，虜其太子、痤。魏敗我澮，取皮牢。成侯與韓昭侯遇上黨。十四年，與韓攻秦。十五年，助魏攻齊。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-043-zhao:m052-0000","start":0,"end":2,"surface":"成侯","kind":"person","person_id":"1za_blw_7lb_AAAAA","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m052-0005","start":5,"end":8,"surface":"公子勝","kind":"person","person_id":"k8f_g8u_4xk","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m052-0009","start":9,"end":11,"surface":"成侯","kind":"person","person_id":"1za_blw_7lb_AAAAA","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m052-0028","start":28,"end":31,"surface":"太戊午","kind":"person","person_id":"qwm_l6t_ke6","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m052-0107","start":107,"end":110,"surface":"魏惠王","kind":"person","person_id":"hob_fsb_jia","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m052-0187","start":187,"end":190,"surface":"秦獻公","kind":"person","person_id":"8fl_fbf_5p5","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m052-0191","start":191,"end":194,"surface":"庶長國","kind":"person","person_id":"yj2_zd2_kbu","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m052-0200","start":200,"end":203,"surface":"其太子","kind":"person","person_id":"dgz_z4a_to4","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m052-02