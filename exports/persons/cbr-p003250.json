{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003250","canonical_person_id":"qa2_bme_epc","id_aliases":["cbr-p003250"],"identity_policy":"contextual_provisional","person_ids":["qa2_bme_epc"],"persons":[{"id":"qa2_bme_epc","label":"楚王戊（齊悼惠王世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"楚王戊","mention_ids":["c-shiji-052-qidaohui:m025-0011"]}],"evidence":[{"mention_id":"c-shiji-052-qidaohui:m025-0011","chapter_id":"c-shiji-052-qidaohui","paragraph_id":"c-shiji-052-qidaohui:p025","quote":"楚王戊"}],"id_aliases":["cbr-p003250"]}],"source_mention_summary":[{"source_id":"s-shiji-052-qidaohui","work_id":"w-shiji","book_id":"b-shiji-052","chapter_id":"c-shiji-052-qidaohui","mention_count":1,"mention_ids":["c-shiji-052-qidaohui:m025-0011"],"paragraph_ids":["c-shiji-052-qidaohui:p025"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-052-qidaohui"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-052-qidaohui:m025-0011","start":11,"end":14,"surface":"楚王戊","kind":"person","person_id":"qa2_bme_epc","status":"contextual_provisional","paragraph_id":"c-shiji-052-qidaohui:p025","chapter_id":"c-shiji-052-qidaohui"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji052-037","person_id":"qa2_bme_epc","surfaces":["楚王戊"],"scope":"same_chapter","chapter_ids":["c-shiji-052-qidaohui"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-052-qidaohui:p025","quote":"齊孝王十一年，吳王濞、楚王戊反，興兵西，告諸侯曰「將誅漢賊臣晁錯以安宗廟」。膠西、膠東、菑川、濟南皆擅發兵應吳楚。欲與齊，齊孝王狐疑，城守不聽，三國兵共圍齊。齊王使路中大夫告於天子。天子復令路中大夫還告齊王：「善堅守，吾兵今破吳楚矣。」路中大夫至，三國兵圍臨菑數重，無從入。三國將劫與路中大夫盟，曰：「若反言漢已破矣，齊趣下三國，不且見屠。」路中大夫既許之，至城下，望見齊王，曰：「漢已發兵百萬，使太尉周亞夫擊破吳楚，方引兵救齊，齊必堅守無下！」三國將誅路中大夫。"}],"rationale":"依明示名與王國、世次的局部敘事暫接；齊、城陽與菑川同諡者分開，興居與志分開。校勘建延及內史勳士未擅選讀法，未名帝后不補姓名，案件只保存來源敘事。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-052-qidaohui:p025","text":"齊孝王十一年，吳王濞、楚王戊反，興兵西，告諸侯曰「將誅漢賊臣晁錯以安宗廟」。膠西、膠東、菑川、濟南皆擅發兵應吳楚。欲與齊，齊孝王狐疑，城守不聽，三國兵共圍齊。齊王使路中大夫告於天子。天子復令路中大夫還告齊王：「善堅守，吾兵今破吳楚矣。」路中大夫至，三國兵圍臨菑數重，無從入。三國將劫與路中大夫盟，曰：「若反言漢已破矣，齊趣下三國，不且見屠。」路中大夫既許之，至城下，望見齊王，曰：「漢已發兵百萬，使太尉周亞夫擊破吳楚，方引兵救齊，齊必堅守無下！」三國將誅路中大夫。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-052-qidaohui:m025-0000","start":0,"end":3,"surface":"齊孝王","kind":"person","person_id":"jc7_nxq_532","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m025-0007","start":7,"end":10,"surface":"吳王濞","kind":"person","person_id":"l9w_b0y_aow","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m025-0011","start":11,"end":14,"surface":"楚王戊","kind":"person","person_id":"qa2_bme_epc","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m025-0030","start":30,"end":32,"surface":"晁錯","kind":"person","person_id":"ccv_1jr_0jn","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m025-0061","start":61,"end":64,"surface":"齊孝王","kind":"person","person_id":"jc7_nxq_532","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m025-0079","start":79,"end":81,"surface":"齊王","kind":"person","person_id":"jc7_nxq_532","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m025-0082","start":82,"end":86,"surface":"路中大夫","kind":"person","person_id":"agr_7ae_9ur","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m025-0088","start":88,"end":90,"surface":"天子","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、官稱、未名者或待