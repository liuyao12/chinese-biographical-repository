ation_note":"保存本段明示子、生育、母稱與兄弟來源主張；不把繼位獨自作父子，不補未知母名或同父同母。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji042-050","person_id":"cbr-p002144","surfaces":["周惠王","惠王"],"scope":"same_chapter","chapter_ids":["c-shiji-042-zheng"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-042-zheng:p016","quote":"五年，燕、衞與周惠王弟穨伐王，王出奔温，立弟穨爲王。六年，惠王告急鄭，厲公發兵撃周王子穨，弗勝，於是與周惠王歸，王居于櫟。七年春，鄭厲公與虢叔襲殺王子穨而入惠王于周。"},{"paragraph_id":"c-shiji-042-zheng:p020","quote":"三十七年春，晉公子重耳反國，立，是爲文公。秋，鄭入滑，滑聽命，已而反與衞，於是鄭伐滑。周襄王使伯服請滑。鄭文公怨惠王之亡在櫟，而文公父厲公入之，而惠王不賜厲公爵祿，又怨襄王之與衞滑，故不聽襄王請而囚伯服。王怒，與翟人伐鄭，弗克。冬，翟攻伐襄王，襄王出奔鄭，鄭文公居王于氾。三十八年，晉文公入襄王成周。"}],"rationale":"依本篇名字、是為、世系及連續事件暫接異稱；同諡不同國分開，建子勝與聲公勝不合併，如兄弟為譬喻不作親屬。述贊與正文不算獨立來源，省稱、古字與校勘仍待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-042-zheng:p016","text":"五年，燕、衞與周惠王弟穨伐王，王出奔温，立弟穨爲王。六年，惠王告急鄭，厲公發兵撃周王子穨，弗勝，於是與周惠王歸，王居于櫟。七年春，鄭厲公與虢叔襲殺王子穨而入惠王于周。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-042-zheng:m016-0007","start":7,"end":10,"surface":"周惠王","kind":"person","person_id":"cbr-p002144","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m016-0010","start":10,"end":12,"surface":"弟穨","kind":"person","person_id":"cbr-p002145","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m016-0015","start":15,"end":18,"surface":"王出奔","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名、群體、泛稱或指代待核；不補姓名、成員或親屬關係。"},{"id":"c-shiji-042-zheng:m016-0021","start":21,"end":23,"surface":"弟穨","kind":"person","person_id":"cbr-p002145","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m016-0029","start":29,"end":31,"surface":"惠王","kind":"person","person_id":"cbr-p002144","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m016-0035","start":35,"end":37,"surface":"厲公","kind":"person","person_id":"cbr-p002128","status":"contextual_provisio