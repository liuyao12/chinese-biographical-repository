"c-nanqishu-050-ming-sons-rendered:p001:m0006","start":28,"end":30,"surface":"和帝","kind":"person","person_id":"z5d_9zy_u5h_BE","status":"contextual_provisional"},{"id":"c-nanqishu-050-ming-sons-rendered:p001:m0007","start":31,"end":34,"surface":"殷貴嬪","kind":"person","person_id":"ndu_9bo_uvl","status":"contextual_provisional"},{"id":"c-nanqishu-050-ming-sons-rendered:p001:m0008","start":39,"end":41,"surface":"寶義","kind":"person","person_id":"z5d_9zy_u5h_BB","status":"contextual_provisional"},{"id":"c-nanqishu-050-ming-sons-rendered:p001:m0009","start":45,"end":47,"surface":"寶嵩","kind":"person","person_id":"z5d_9zy_u5h_BF","status":"contextual_provisional"},{"id":"c-nanqishu-050-ming-sons-rendered:p001:m0010","start":48,"end":51,"surface":"袁貴妃","kind":"person","person_id":"uui_q97_zr3","status":"contextual_provisional"},{"id":"c-nanqishu-050-ming-sons-rendered:p001:m0011","start":55,"end":57,"surface":"寶源","kind":"person","person_id":"z5d_9zy_u5h_BG","status":"contextual_provisional"},{"id":"c-nanqishu-050-ming-sons-rendered:p001:m0012","start":58,"end":61,"surface":"管淑妃","kind":"person","person_id":"udy_ov7_1jg","status":"contextual_provisional"},{"id":"c-nanqishu-050-ming-sons-rendered:p001:m0013","start":65,"end":67,"surface":"寶攸","kind":"person","person_id":"z5d_9zy_u5h_BH","status":"contextual_provisional"},{"id":"c-nanqishu-050-ming-sons-rendered:p001:m0014","start":68,"end":71,"surface":"許淑媛","kind":"person","person_id":"ahf_2qr_g1x","status":"contextual_provisional"},{"id":"c-nanqishu-050-ming-sons-rendered:p001:m0015","start":75,"end":77,"surface":"寶貞","kind":"person","person_id":"z5d_9zy_u5h_BI","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-050-ming-sons-rendered","book_id":"b-nanqishu-050","work_id":"w-nanqishu","source_id":"s-nanqishu-050-current-rendered-ming-sons"},{"id":"c-nanqishu-050-ming-sons-rendered:p002","text":"巴陵隱王寶義字智勇，明帝長子也。本名明基。建武元年，爲持節、都督揚南徐州軍事、前將軍、揚州刺史。封晉安郡王，三千戶。寶義少有廢疾，不堪出人閒，故止加除授，仍以始安王遙光代之。轉寶義爲右將軍，領兵置佐，鎮石頭。二年，出爲使持節、都督南徐州軍事、鎮北將軍、南徐州刺史。東昏卽位，進征北大將軍，開府儀同三司，給扶。永元元年，給班劔二十人。始安王遙光誅，爲都督揚南徐二州軍事、驃騎大將軍、揚州刺史，持節如故。東府被兵火，屋宇燒殘，帝方營宮殿，不暇脩葺，寶義鎮西州。三年，進位司徒。和帝西臺建，以爲侍中、司空，使持節、都督、刺史如故。梁王定京邑，宣德太后令以寶義爲太尉，領司徒。詔云：「不言之化，形于自遠。」時人皆云此實錄也。梁受禪，封謝沐縣公，尋封巴陵郡王，奉齊後。天監中薨。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-nanqishu-050-ming-sons-rendered:p002:m0001","start":4,"end":6,"surface":"寶義","kind":"person","person_id":"z5d_9zy_u5h_BB","status":"contextual_provisional"},{"id":"c-nanqishu-050-ming-sons-rendered:p002:m0002","start":7,"end":9,"surface":"智勇","kind":"person","person_id":"z5d_9zy_u5h_BB","status":"contextual_provisional"},{"id":"c-nanqishu-050-ming-sons-rendered:p002:m0003","start":10,"end":12,"surface":"明帝","kind":"person","person_id":"z5d_9zy_u5h_B","status":"contextual_provisional"},{"id":"c-nanqishu-050-ming-sons-rendered:p002:m0004","start":18,"end":20,"surface":"明基","kind":"person","person_id":"z5d_9zy_u5h_BB","status":"contextual_provisional"},{"id":"c-nanqishu-050-ming-sons-rendered:p002:m0005","start":58,"end":60,"surface":"寶義","kind":"person","person_id":"z5d_9zy_u5h_BB","status":"contextual_provisional"},{"id":"c-nanqishu-050-ming-sons-rendered:p002:m0006","start":82,"end":84,"surface":"遙光","kind":"person","person_id":"z5d_9zy_u5h_AA","status":"contextual_provisional"},{"id":"c-nanqishu-050-ming-sons-rendered:p002:m0007","start":88,"end":90,"surface":"寶義","kind":"person","person_id":"z5d_9zy_u5h_BB","status":"contextual_provisional"},{"id":"c-nanqishu-050-ming-sons-rendered:p002:m0008","start":132,"end":134,"surface":"東昏","kind":"person","person_id":"z5d_9zy_u5h_BA","status":"contextual_provisional"},{"id":"c-nanqishu-050-ming-sons-rendered:p002:m0009","start":169,"end":171,"surface":"遙光","kind":"person","person_id":"z5d_9zy_u5h_AA","status":"contextual_provisional"},{"id":"c-nanqishu-050-ming-sons-rendered:p002:m0010","start":211,"end":212,"surface":"帝","kind":"person","person_id":"z5d_9zy_u5h_BA","status":"contextual_provisional"},{"id":"c-nanqi