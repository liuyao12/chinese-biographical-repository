:"person","person_id":"xqy_bvp_g1a","status":"contextual_provisional","paragraph_id":"c-shiji-130-taishigong:p006","chapter_id":"c-shiji-130-taishigong"},{"id":"c-shiji-130-taishigong:m006-0106","start":106,"end":108,"surface":"天子","kind":"person","person_id":"xqy_bvp_g1a","status":"contextual_provisional","paragraph_id":"c-shiji-130-taishigong:p006","chapter_id":"c-shiji-130-taishigong"},{"id":"c-shiji-130-taishigong:m010-0045","start":45,"end":48,"surface":"明天子","kind":"person","person_id":"xqy_bvp_g1a","status":"contextual_provisional","paragraph_id":"c-shiji-130-taishigong:p010","chapter_id":"c-shiji-130-taishigong"},{"id":"c-shiji-130-taishigong:m011-0091","start":91,"end":94,"surface":"明天子","kind":"person","person_id":"xqy_bvp_g1a","status":"contextual_provisional","paragraph_id":"c-shiji-130-taishigong:p011","chapter_id":"c-shiji-130-taishigong"},{"id":"c-shiji-130-taishigong:m024-0032","start":32,"end":34,"surface":"今上","kind":"person","person_id":"xqy_bvp_g1a","status":"contextual_provisional","paragraph_id":"c-shiji-130-taishigong:p024","chapter_id":"c-shiji-130-taishigong"},{"id":"c-shiji-130-taishigong:m142-0342","start":342,"end":344,"surface":"主上","kind":"person","person_id":"xqy_bvp_g1a","status":"contextual_provisional","paragraph_id":"c-shiji-130-taishigong:p142","chapter_id":"c-shiji-130-taishigong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-130-taishigong:p006","text":"是歲天子始建漢家之封，而太史公留滯周南，不得與從事，故發憤且卒。而子遷適使反，見父於河洛之閒。太史公執遷手而泣曰：「余先周室之太史也。自上世嘗顯功名於虞夏，典天官事。後世中衰，絕於予乎？汝復為太史，則續吾祖矣。今天子接千歲之統，封泰山，而余不得從行，是命也夫，命也夫！余死，汝必為太史；為太史，無忘吾所欲論著矣。且夫孝始於事親，中於事君，終於立身。揚名於後世，以顯父母，此孝之大者。夫天下稱誦周公，言其能論歌文武之德，宣周邵之風，達太王王季之思慮，爰及公劉，以尊后稷也。幽厲之後，王道缺，禮樂衰，孔子修舊起廢，論詩書，作春秋，則學者至今則之。自獲麟以來四百有餘歲，而諸侯相兼，史記放絕。今漢興，海內一統，明主賢君忠臣死義之士，余為太史而弗論載，廢天下之史文，余甚懼焉，汝其念哉！」遷俯首流涕曰：「小子不敏，請悉論先人所次舊聞，弗敢闕。」","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m006-0002","start":2,"end":4,"surface":"天子","kind":"person","person_id":"xqy_bvp_g1a","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m006-0012","start":12,"end":15,"surface":"太史公","kind":"person","person_id":"pme_eis_xqi_*A*AAAA","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m006-0034","start":34,"end":35,"surface":"遷","kind":"person","person_id":"pme_eis_xqi_*A*AAAAA","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m006-0047","start":47,"end":50,"surface":"太史公","kind":"person","person_id":"pme_eis_xqi_*A*AAAA","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m006-0051","start":51,"end":52,"surface":"遷","kind":"person","person_id":"pme_eis_xqi_*A*AAAAA","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m006-0106","start":106,"end":108,"surface":"天子","kind":"person","person_id":"xqy_bvp_g1a","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m006-0196","start":196,"end":198,"surface":"周公","kind":"person","person_id":"lxl_vec_rli","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m006-0204","start":204,"end":206,"surface":"文武","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-130-taishigong:m006-0210","start":210,"end":212,"surface":"周邵","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-130-taishigong:m006-0216","start":216,"end":218,"surface":"太王","kind":"person","person_id":"ir9_9eu_qx2","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m006-0218","start":218,"end":220,"surface":"王季","kind":"person","person_id":"65h_6hs_e4y","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m006-0226","start":226,"end":228,"surface":"公劉","kind":"person","person_id":"wh3_77h_m9d","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m006-0231","start":231,"end":233,"surface":"后稷","kind":"person","person_id":"ys8_rdi_f0i","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m006-0235","start":235,"end":237,"surface":"幽厲","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-130-taishigong:m006-0248","start":248,"end":250,"surface":"孔子","kind":"person","person_id":"8zh_d7n_e93","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m006-0340","start":340,"end":341,"surface":"遷","kind":"person","person_id":"pme_eis_xqi_*A*AAAAA","status":"contextual_provisional"}],"chapter_id":"c-shiji-130-taishigong","book_id":"b-shiji-130","work_id":"w-shiji","source_id":"s-shiji130-taishigong"},{"id":"c-shiji-130-taishigong:p010","text":"壺遂曰：「孔子之時，上無明君，下不得任用，故作春秋，垂空文以斷禮義，當一王之法。今夫子上遇明天子，下得守職，萬事既具，咸各序其宜，夫子所論，欲以何明？」","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m010-0000","start":0,"end":2,"surface":"壺遂","kind":"person","person_id":"hmj_pm8_38e","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m010-0005","start":5,"end":7,"surface":"孔子","kind":"person","person_id":"8zh_d7n_e93","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m010-0041","start":41,"end":43,"surface":"夫子","kind":"person","person_id":"pme_eis_xqi_*A*AAAAA","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m010-0045","start":45,"end":48,"surface":"明天子","kind":"person","person_id":"xqy_bvp_g1a","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m010-0065","start":65,"end":67,"surface":"夫子","kind":"person","person_id":"pme_eis_xqi_*A*AAAAA","status":"contextual_provisional"}],"chapter_id":"c-shiji-130-taishigong","book_id":"b-shiji-130","work_id":"w-shiji","source_id":"s-shiji130-taishigong"},{"id":"c-shiji-130-taishigong:p011","text":"太史公曰：「唯唯，否否，不然。余聞之先人曰：『伏羲至純厚，作易八卦。堯舜之盛，尚書載之，禮樂作焉。湯武之隆，詩人歌之。春秋采善貶惡，推三代之德，褒周室，非獨刺譏而已也。』漢興以來，至明天子，獲符瑞，封禪，改正朔，易服色，受命於穆清，澤流罔極，海外殊俗，重譯款塞，請來獻見者，不可勝道。臣下百官力誦聖德，猶不能宣盡其意。且士賢能而不用，有國者之恥；主上明聖而德不布聞，有司之過也。且余嘗掌其官，廢明聖盛德不載，滅功臣世家賢大夫之業不述，墮先人所言，罪莫大焉。余所謂述故事，整齊其世傳，非所謂作也，而君比之於春秋，謬矣。」","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m011-0000","start":0,"end":3,"surface":"太史公","kind":"person","person_id":"pme_eis_xqi_*A*AAAAA","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m011-0018","start":18,"end":20,"surface":"先人","kind":"person","person_id":"pme_eis_xqi_*A*AAAA","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m011-0023","start":23,"end":25,"surface":"伏羲","kind":"person","person_id":"0xr_z2z_lne","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m011-0034","start":34,"end":35,"surface":"堯","kind":"person","person_id":"0ea_a78_okm","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m011-0035","start":35,"end":36,"surface":"舜","kind":"person","person_id":"ab2_pxs_34r","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m011-0049","start":49,"end":51,"surface":"湯武","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-130-taishigong:m011-0091","start":91,"end":94,"surface":"明天子","kind":"person","person_id":"xqy_bvp_g1a","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m011-0218","start":218,"end":220,"surface":"先人","kind":"person","person_id":"pme_eis_xqi_*A*AAAA","status":"contextual_provisional"}],"chapter_id":"c-shiji-130-taishigong","book_id":"b-shiji-130","work_id":"w-shiji","source_id":"s-shiji130-taishigong"},{"id":"c-shiji-130-taishigong:p024","text":"漢興五世，隆在建元，外攘夷狄，內修法度，封禪，改正朔，易服色。作今上本紀第十二。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m024-0032","start":32,"end":34,"surface":"今上","kind":"person","person_id":"xqy_bvp_g1a","status":"contextual_provisional"}],"chapter_id":"c-shiji-130-taishigong","book_id":"b-shiji-130","work_id":"w-shiji","source_id":"s-shiji130-taishigong"},{"id":"c-shiji-130-taishigong:p142","text":"維我漢繼五帝末流，接三代絕業。周道廢，秦撥去古文，焚滅詩書，故明堂石室金匱玉版圖籍散亂。於是漢興，蕭何次律令，韓信申軍法，張蒼為章程，叔孫通定禮儀，則文學彬彬稍進，詩書往往閒出矣。自曹參薦蓋公言黃老，而賈生、晁錯明申、商，公孫弘以儒顯，百年之閒，天下遺文古事靡不畢集太史公。太史公仍父子相續纂其職。曰：「於戲！余維先人嘗掌斯事，顯於唐虞，至于周，復典之，故司馬氏世主天官。至於余乎，欽念哉！欽念哉！」罔羅天下放失舊聞，王跡所興，原始察終，見盛觀衰，論考之行事，略推三代，錄秦漢，上記軒轅，下至于茲，著十二本紀，既科條之矣。并時異世，年差不明，作十表。禮樂損益，律歷改易，兵權山川鬼神，天人之際，承敝通變，作八書。二十八宿環北辰，三十輻共一轂，運行無窮，輔拂股肱之臣配焉，忠信行道，以奉主上，作三十世家。扶義俶儻，不令己失時，立功名於天下，作七十列傳。凡百三十篇，五十二萬六千五百字，為太史公書。序略，以拾遺補闕，成一家之言，厥協六經異傳，整齊百家雜語，藏之名山，副在京師，俟後世聖人君子。第七十。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m142-0004","start":4,"end":6,"surface":"五帝","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-130-taishigong:m142-0049","start":49,"end":51,"surface":"蕭何","kind":"person","person_id":"1xf_5a0_n0p","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m142-0055","start":55,"end":57,"surface":"韓信","kind":"person","person_id":"2nx_tda_i4j","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m142-0061","start":61,"end":63,"surface":"張蒼","kind":"person","person_id":"796_nkw_0jz_A","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m142-0067","start":67,"end":70,"surface":"叔孫通","kind":"person","person_id":"dpt_ry7_e1z","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m142-0091","start":91,"end":93,"surface":"曹參","kind":"person","person_id":"diy_04a_wsu","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m142-0094","start":94,"end":96,"surface":"蓋公","kind":"person","person_id":"kaz_pcf_2vd","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m142-0097","start":97,"end":99,"surface":"黃老","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-130-taishigong:m142-0101","start":101,"end":103,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m142-0104","start":104,"end":106,"surface":"晁錯","kind":"person","person_id":"04u_gq0_nke_A","status":"contextual_provisional"},{"i