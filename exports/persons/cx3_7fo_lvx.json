u-054-recluses-complete:p062:m0057","start":57,"end":58,"surface":"栖","kind":"person","person_id":"qil_xxj_ujk","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-054-recluses-complete","book_id":"b-nanqishu-054","work_id":"w-nanqishu","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:p063","text":"　　京產少恬靜，閉意榮宦。頗涉文義，專修黃老。會稽孔覬，清剛有峻節，一見而爲款交。郡召主簿，州辟從事，稱疾去。除奉朝請，不就。與同郡顧歡同契，始寧東山開舍授學。建元中，武陵王曄爲會稽，太祖遣儒士劉瓛入東爲曄講說，京產請瓛至山舍講書，傾資供待，子栖躬自屣履，爲瓛生徒下食，其禮賢如此。孔稚珪、周顒、謝蘥竝致書以通殷懃。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":162,"last_line":162,"raw_start":8495,"raw_end":8653,"raw_character_offsets":[8495,8496,8497,8498,8499,8500,8501,8502,8503,8504,8505,8506,8507,8508,8509,8510,8511,8512,8513,8514,8515,8516,8517,8518,8519,8520,8521,8522,8523,8524,8525,8526,8527,8528,8529,8530,8531,8532,8533,8534,8535,8536,8537,8538,8539,8540,8541,8542,8543,8544,8545,8546,8547,8548,8549,8550,8551,8552,8553,8554,8555,8556,8557,8558,8559,8560,8561,8562,8563,8564,8565,8566,8567,8568,8569,8570,8571,8572,8573,8574,8575,8576,8577,8578,8579,8580,8581,8582,8583,8584,8585,8586,8587,8588,8589,8590,8591,8592,8593,8594,8595,8596,8597,8598,8599,8600,8601,8602,8603,8604,8605,8606,8607,8608,8609,8610,8611,8612,8613,8614,8615,8616,8617,8618,8619,8620,8621,8622,8623,8624,8625,8626,8627,8628,8629,8630,8631,8632,8633,8634,8635,8636,8637,8638,8639,8640,8641,8642,8643,8644,8645,8646,8647,8648,8649,8650,8651,8652],"revision_id":1762878},"mentions":[{"id":"c-nanqishu-054-recluses-complete:p063:m0002","start":2,"end":4,"surface":"京產","kind":"person","person_id":"cx3_7fo_lvx","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p063:m0025","start":25,"end":27,"surface":"孔覬","kind":"person","person_id":"vjg_m4c_ev5","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p063:m0066","start":66,"end":68,"surface":"顧歡","kind":"person","person_id":"bn8_cdi_hv9","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p063:m0092","start":92,"end":94,"surface":"太祖","kind":"person","person_id":"47p_kjh_ez7","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p063:m0097","start":97,"end":99,"surface":"劉瓛","kind":"person","person_id":"u3v_bez_ebk","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p063:m0106","start":106,"end":108,"surface":"京產","kind":"person","person_id":"cx3_7fo_lvx","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p063:m0109","start":109,"end":110,"surface":"瓛","kind":"person","person_id":"u3v_bez_ebk","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p063:m0122","start":122,"end":123,"surface":"栖","kind":"person","person_id":"qil_xxj_ujk","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p063:m0129","start":129,"end":130,"surface":"瓛","kind":"person","person_id":"u3v_bez_ebk","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p063:m0141","start":141,"end":144,"surface":"孔稚珪","kind":"person","person_id":"z6r_wtu_wuj","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p063:m0145","start":145,"end":147,"surface":"周顒","kind":"person","person_id":"vkd_5ff_i23","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-054-recluses-complete","book_id":"b-nanqishu-054","work_id":"w-nanqishu","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:p064","text":"　　永明十年，稚珪及光祿大夫陸澄、祠部尚書虞悰、太子右率沈約、司徒右長史張融表薦京產曰：「竊見吳郡杜京產，潔靜爲心，謙虛成性，通和發於天挺，敏達表於自然。學徧玄、儒，博通史、子，流連文藝，沈吟道奧。泰始之朝，掛冠辭世，遁捨家業，隱于太平。葺宇窮巖，採芝幽澗，耦耕自足，薪歌有餘。確爾不羣，淡然寡欲，麻衣藿食，二十餘載。雖古之志士，何以加之。謂宜釋巾幽谷，結組登朝，則喦谷含懽，薜蘿起抃矣。」不報。建武初，徵員外散騎侍郎，京產曰：「莊生持釣，豈爲白璧所回。」辭疾不就。年六十四，永元元年，卒。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":164,"last_line":164,"raw_start":8655,"raw_end":8900,"raw_character_offsets":[8655,8656,8657,8658,8659,8660,8661,8662,86