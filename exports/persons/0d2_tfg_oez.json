ty":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-nanqishu-058-southern-and-eastern-complete:source_review1-0","kind":"source_review","person_id":"0d2_tfg_oez","source_quote":"蠻，種類繁多，言語不一，咸依山谷，布荊、湘、雍、郢、司等五州界。宋世封西陽蠻梅蟲生為高山侯，田治生為威山侯，梅加羊為扞山侯。太祖即位，有司奏蠻封應在解例，參議以：「戎夷疏爵，理章列代；酋豪世襲，事炳前葉。今宸曆改物，舊冊枃降，而梅生等保落奉政，事須繩總，恩命升贊，有異常品。謂宜存名以訓殊俗。」詔：「特留。」以治生為輔國將軍、虎賁中郎，轉建寧郡太守，將軍、侯如故。","reading":"地域及來源族稱照原書。梅蟲生、田治生、梅加羊三組封爵與太祖即位後的詔議分錄。","note":"地域及來源族稱照原書。梅蟲生、田治生、梅加羊三組封爵與太祖即位後的詔議分錄。","paragraph_id":"c-nanqishu-058-southern-and-eastern-complete:p001","start_codepoint":0,"end_codepoint":182,"human_reviewed":false,"chapter_id":"c-nanqishu-058-southern-and-eastern-complete","source_id":"s-nanqishu-058-southern-and-eastern-complete-ws2638629"},{"id":"c-nanqishu-058-southern-and-eastern-complete:variant_review1-32","kind":"variant_review","person_id":"0d2_tfg_oez","source_quote":"宋世封西陽蠻梅蟲生為高山侯","reading":"三位酋豪及三封各按原句。齊受禪後討論蠲改與舊冊延襲，勿混成原封年月。","note":"三位酋豪及三封各按原句。齊受禪後討論蠲改與舊冊延襲，勿混成原封年月。","paragraph_id":"c-nanqishu-058-southern-and-eastern-complete:p001","start_codepoint":32,"end_codepoint":45,"human_reviewed":false,"chapter_id":"c-nanqishu-058-southern-and-eastern-complete","source_id":"s-nanqishu-058-southern-and-eastern-complete-ws2638629"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-058-southern-and-eastern-complete:p001:m0038","start":38,"end":41,"surface":"梅蟲生","kind":"person","person_id":"0d2_tfg_oez","status":"contextual_provisional","paragraph_id":"c-nanqishu-058-southern-and-eastern-complete:p001","chapter_id":"c-nanqishu-058-southern-and-eastern-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"iden