54-lusu:line043","chapter_id":"c-sanguozhi-054-lusu"},{"id":"c-sanguozhi-054-lusu:line043:m0254","start":254,"end":256,"surface":"子揚","kind":"person","person_id":"6iz_lm5_o4w","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-054-lusu:line043","chapter_id":"c-sanguozhi-054-lusu"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-047-sun-quan:p040","text":"吳書曰：珩字仲山，吳郡人，少綜經藝，尤善春秋內、外傳。權以珩有智謀，能專對，乃使至魏。魏文帝問曰：「吳嫌魏東向乎？」珩曰：「不嫌。」曰：「何以？」曰：「信恃舊盟，言歸於好，是以不嫌。若魏渝盟，自有豫備。」又問：「聞太子當來，寧然乎？」珩曰：「臣在東朝，朝不坐，宴不與，若此之議，無所聞也。」文帝善之，乃引珩自近，談語終日。珩隨事響應，無所屈服。珩還言曰：「臣密參侍中劉曄，數爲賊設奸計，終不久愨。臣聞兵家舊論，不恃敵之不我犯，恃我之不可犯，今爲朝廷慮之。且當省息他役，惟務農桑以廣軍資；脩繕舟車，增作戰具，令皆兼盈；撫養兵民，使各得其所；攬延英俊，奬勵將士，則天下可圖矣。」以奉使有稱，封永安鄉侯，官至少府。","text_layer":"witness_appended_pei_songzhi_note","annotation_status":"reviewed","source_position":{"first_line":51,"last_line":51,"raw_start":6432,"raw_end":6736,"raw_character_offsets":[6432,6433,6434,6435,6436,6437,6438,6439,6440,6441,6442,6443,6444,6445,6446,6447,6448,6449,6450,6451,6452,6453,6454,6455,6456,6457,6458,6459,6460,6461,6462,6463,6464,6465,6466,6467,6468,6469,6470,6471,6472,6473,6474,6475,6476,6477,6478,6479,6480,6481,6482,6483,6484,6485,6486,6487,6488,6489,6490,6491,6492,6493,6494,6495,6496,6497,6498,6499,6500,6501,6502,6503,6504,6505,6506,6507,6508,6509,6510,6511,6512,6513,6514,6515,6516,6517,6518,6519,6520,6521,6522,6523,6524,6525,6526,6527,6528,6529,6530,6531,6532,6533,6534,6535,6536,6537,6538,6539,6540,6541,6542,6543,6544,6545,6546,6547,6548,6549,6550,6551,6552,6553,6554,6555,6556,6557,6558,6559,6560,6561,6562,6563,6564,6565,6566,6567,6568,6569,6570,6571,6572,6573,6574,6575,6576,6577,6578,6579,6580,6581,6582,6583,6584,6585,6586,6587,6588,6589,6590,6591,6592,6593,6594,6595,6596,6597,6598,6599,6600,6601,6602,6603,6604,6605,6606,6607,6608,6609,66