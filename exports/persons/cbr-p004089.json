{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004089","identity_policy":"contextual_provisional","person_ids":["cbr-p004089"],"persons":[{"id":"cbr-p004089","label":"蘇秦舍人（張儀列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"其舍人","mention_ids":["c-shiji-070-zhang:m004-0005"]},{"surface":"舍人","mention_ids":["c-shiji-070-zhang:m005-0030"]}],"evidence":[{"mention_id":"c-shiji-070-zhang:m004-0005","chapter_id":"c-shiji-070-zhang","paragraph_id":"c-shiji-070-zhang:p004","quote":"其舍人"},{"mention_id":"c-shiji-070-zhang:m005-0030","chapter_id":"c-shiji-070-zhang","paragraph_id":"c-shiji-070-zhang:p005","quote":"舍人"}]}],"mentions":[{"id":"c-shiji-070-zhang:m004-0005","start":5,"end":8,"surface":"其舍人","kind":"person","person_id":"cbr-p004089","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p004","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-070-zhang:m005-0030","start":30,"end":32,"surface":"舍人","kind":"person","person_id":"cbr-p004089","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p005","chapter_id":"c-shiji-070-zhang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji070-006","person_id":"cbr-p004089","surfaces":["其舍人","舍人"],"scope":"same_chapter","chapter_ids":["c-shiji-070-zhang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-070-zhang:p004","quote":"蘇秦已而告其舍人曰：「張儀，天下賢士，吾殆弗如也。今吾幸先用，而能用秦柄者，獨張儀可耳。然貧，無因以進。吾恐其樂小利而不遂，故召辱之，以激其意。子為我陰奉之。」乃言趙王，發金幣車馬，使人微隨張儀，與同宿舍，稍稍近就之，奉以車馬金錢，所欲用，為取給，而弗告。張儀遂得以見秦惠王。惠王以為客卿，與謀伐諸侯。"},{"paragraph_id":"c-shiji-070-zhang:p005","quote":"蘇秦之舍人乃辭去。張儀曰：「賴子得顯，方且報德，何故去也？」舍人曰：「臣非知君，知君乃蘇君。蘇君憂秦伐趙敗從約，以為非君莫能得秦柄，故感怒君，使臣陰奉給君資，盡蘇君之計謀。今君已用，請歸報。」張儀曰：「嗟乎，此在吾術中而不悟，吾不及蘇君明矣！吾又新用，安能謀趙乎？為吾謝蘇君，蘇君之時，儀何敢言。且蘇君在，儀寧渠能乎！」張儀既相秦，為文檄告楚相曰：「始吾從若飲，我不盜而璧，若笞我。若善守汝國，我顧且盜而城！」"}],"rationale":"依前10段明示姓名與局部敘事暫接；張儀短名不取普通詞，楚相失璧與後文檄告暫接，未名妻與蘇秦舍人不補姓名。秦惠王王稱不取王業、欲王或王隨之。周天子、魏王與趙王不按年代記憶補名；桀紂為引古，鬼谷傳承未確證。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-070-zhang:p004","text":"蘇秦已而告其舍人曰：「張儀，天下賢士，吾殆弗如也。今吾幸先用，而能用秦柄者，獨張儀可耳。然貧，無因以進。吾恐其樂小利而不遂，故召辱之，以激其意。子為我陰奉之。」乃言趙王，發金幣車馬，使人微隨張儀，與同宿舍，稍稍近就之，奉以車馬金錢，所欲用，為取給，而弗告。張儀遂得以見秦惠王。惠王以為客卿，與謀伐諸侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-070-zhang:m004-0000","start":0,"end":2,"surface":"蘇秦","kind":"person","person_id":"cbr-p004085","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m004-0005","start":5,"end":8,"surface":"其舍人","kind":"person","person_id":"cbr-p004089","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m004-0011","start":11,"end":13,"surface":"張儀","kind":"person","person_id":"cbr-p004084","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m004-0039","start":39,"end":41,"surface":"張儀","kind":"person","person_id":"cbr-p004084","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m004-0082","start":82,"end":84,"surface":"趙王","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體或未定指代，身份待覆核；使人不未經證據全接舍人。"},{"id":"c-shiji-070-zhang:m004-0091","start":91,"end":93,"surface":"使人","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體或未定指代，身份待覆核；使人不未經證據全接舍人。"},{"id":"c-shiji-070-zhang:m004-0095","start":95,"end":97,"surface":"張儀","kind":"person","person_id":"cbr-p004084","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m004-0128","start":128,"end":130,"surface":"張儀","kind":"person","person_id":"cbr-p004084","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m004-0134","start":134,"end":137,"surface":"秦惠王","kind":"person","person_id":"cbr-p004090","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m004-0138","start":138,"end":140,"surface":"惠王","kind":"person","person_id":"cbr-p004090","status":"contextual_provisional"}],"chapter_id":"c-shiji-070-zhang","book_id":"b-shiji-070","work_id":"w-shiji",