,"paragraph_id":"c-shiji-059-wuzong:p013","quote":"膠西于王端，以孝景前三年吳楚七國反破後，端用皇子為膠西王。端為人賊戾，又陰痿，一近婦人，病之數月。而有愛幸少年為郎。為郎者頃之與後宮亂，端禽滅之，及殺其子母。數犯上法，漢公卿數請誅端，天子為兄弟之故不忍，而端所為滋甚。有司再請削其國，去太半。端心慍，遂為無訾省。府庫壞漏盡，腐財物以巨萬計，終不得收徙。令吏毋得收租賦。端皆去衛，封其宮門，從一門出游。數變名姓，為布衣，之他郡國。","person_mention_id":"c-shiji-059-wuzong:m013-0051"}],"interpretation_note":"端禽滅之承本段未名郎，死亡來源保存；其子母另為未辨角色群體，不補名字或親屬距離。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"mentions":[{"id":"c-shiji-059-wuzong:m013-0051","start":51,"end":55,"surface":"愛幸少年","kind":"person","person_id":"xnc_psn_713","status":"contextual_provisional","note":"端愛幸而為郎的具體未名少年；兩處郎字承同一敘事人物。","paragraph_id":"c-shiji-059-wuzong:p013","chapter_id":"c-shiji-059-wuzong"},{"id":"c-shiji-059-wuzong:m013-0056","start":56,"end":57,"surface":"郎","kind":"person","person_id":"xnc_psn_713","status":"contextual_provisional","note":"承本段端愛幸少年為郎；不補姓名。","paragraph_id":"c-shiji-059-wuzong:p013","chapter_id":"c-shiji-059-wuzong"},{"id":"c-shiji-059-wuzong:m013-0059","start":59,"end":60,"surface":"郎","kind":"person","person_id":"xnc_psn_713","status":"contextual_provisional","note":"承本段端愛幸少年為郎；不補姓名。","paragraph_id":"c-shiji-059-wuzong:p013","chapter_id":"c-shiji-059-wuzong"}],"relations":[],"title_holdings":[{"id":"th-shiji059-067","person_id":"xnc_psn_713","title":"郎","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-059-wuzong","source_id":"s-shiji-059-wuzong","paragraph_id":"c-shiji-059-wuzong:p013","quote":"膠西于王端，以孝景前三年吳楚七國反破後，端用皇子為膠西王。端為人賊戾，又陰痿，一近婦人，病之數月。而有愛幸少年為郎。為郎者頃之與後宮亂，端禽滅之，及殺其子母。數犯上法，漢公卿數請誅端，天子為兄弟之故不忍，而端所為滋甚。有司再請削其國，去太半。端心慍，遂為無訾省。府庫壞漏盡，腐財物以巨萬計，終不得收徙。令吏毋得收租賦。端皆去衛，封其宮門，從一門出游。數變名姓，為布衣，之他郡國。","person_mention_id":"c-shiji-059-wuzong:m013-0051"}],"attestations":[{"id":"th-shiji059-067:a001","paragraph_id":"c-shiji-059-wuzong:p013","start":56,"end":57,"surface":"郎","person_mention_id":"c-shiji-059-wuzong:m013-0056","usage":"narrative"},{"id":"th-shiji059-067:a002","paragraph_id":"c-shiji-059-wuzong:p013","start":59,"end":60,"surfac