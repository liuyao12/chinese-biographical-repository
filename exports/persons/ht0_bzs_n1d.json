zhangwen","book_id":"b-sanguozhi-057","work_id":"w-sanguozhi","source_id":"s-sanguozhi-057-zhangwen"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-053-xuezong:line057-pei01-01","text":"《漢晉春秋》曰：孫休時，珝為五宮中郎將，遣至蜀求馬。及還，休問蜀政得失，對曰：「主闇而不知其過，臣下容身以求免罪，入其朝不聞正言，經其野民皆菜色。臣聞燕雀處堂，子母相樂，自以為安也，突決棟焚，而燕雀怡然不知禍之將及，其是之謂乎！」","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-053-xuezong:line057-pei01-01:m0008","start":8,"end":10,"surface":"孫休","kind":"person","person_id":"0fo_c5c_4yh","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xuezong:line057-pei01-01:m0012","start":12,"end":13,"surface":"珝","kind":"person","person_id":"kpq_tg0_zwl","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xuezong:line057-pei01-01:m0029","start":29,"end":30,"surface":"休","kind":"person","person_id":"0fo_c5c_4yh","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"}],"annotation_status":"reviewed","source_position":{"first_line":57,"last_line":57,"revision_id":2086397,"raw_start":7241,"raw_end":7360,"character_positions":[7241,7244,7245,7246,7247,7250,7251,7252,7253,7254,7255,7256,7257,7258,7259,7260,7261,7262,7263,7264,7265,7266,7267,7268,7269,7270,7271,7272,7273,7274,7275,7276,7277,7278,7279,7280,7281,7282,7283,7284,7285,7286,7287,7288,7289,7290,7291,7292,7293,7294,7295,7296,7297,7298,7299,7300,7301,7302,7303,7304,7305,7306,7307,7308,7309,7310,7311,7312,7313,7314,7315,7316,7317,7318,7319,7320,7321,7322,7323,7324,7325,7326,7327,7328,7329,7330,7331,7332,7333,7334,7335,7336,7337,7338,7339,7340,7341,7342,7343,7344,7345,7346,7347,7348,7349,7350,7351,7352,7353,7354,7355,7356,7357,7358,7359]},"attribution":{"annotator":"裴松之","attribution_kind":"quoted_work","source_label":"漢晉春秋","attribution_marker":"《漢晉春秋》曰：","quoted_work":"漢晉春秋"},"attachment":{"received_paragraph_id":"c-sanguozhi-053-xuezong:line057","received_codepoint":21,"note_ordinal":1,"source_ordinal":1},"chapter_id":"c-sanguozhi-053-xuezong","book_id":"b-sanguozhi-053","work_id":"w-sanguozhi","source_id":"s-sanguozhi-053-xuezong"},{"id":"c-sanguozhi-057-zhangwen:line046","text":"昔高宗以諒闇昌殷祚於再興，成王以幼沖隆周德於太平，功冒溥天，聲貫罔極。今陛下以聰明之姿，等契往古，總百揆於良佐，參列精這炳耀，遐邇望風，莫不欣賴。吳國勤任旅力，清澄江滸，願與有道平一宇內，委心協規，有如河水，軍事興煩，使役乏少，是以忍鄙倍之羞，使下臣溫通致情好。陛下敦祟禮義，未便恥忽。臣自（入）遠境，及即近郊，頻蒙勞來，恩詔輒加，以榮自懼，悚怛若驚。謹奉所賚函書一封。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-057-zhangwen:line046:m0001","start":1,"end":3,"surface":"高宗","kind":"person","person_id":"cld_aan_e20","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-zhangwen:line046:m0013","start":13,"end":15,"surface":"成王","kind":"person","person_id":"qna_m75_pj8","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-zhangwen:line046:m0125","start":125,"end":126,"surface":"溫","kind":"person","person_id":"xuu_do0_zbf","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"}],"annotation_status":"reviewed","source_position":{"first_line":46,"last_line":46,"revision_id":2638131,"raw_start":9338,"raw_end":9535,"character_positions":[9348,9349,9350,9351,9352,9353,9354,9355,9356,9357,9358,9359,9360,9361,9362,9363,9364,9365,9366,9367,9368,9369,9370,9371,9372,9373,9374,9375,9376,9377,9378,9379,9380,9381,9382,9383,9384,9385,9386,9387,9388,9389,9390,9391,9392,9393,9394,9395,9396,9397,9398,9399,9400,9401,9402,9403,9404,9405,9406,9407,9408,9409,9410,9411,9412,9413,9414,9415,9416,9417,9418,9419,9420,9421,9422,9423,9424,9425,9426,9427,9428,9429,9430,9431,9432,9433,9434,9435,9436,9437,9438,9439,9440,9441,9442,9443,9444,9445,9446,9447,9448,9449,9450,9451,9452,9453,9454,9455,9456,9457,9458,9459,9460,9461,9462,9463,9464,9465,9466,9467,9468,9469,9470,9471,9472,9473,9474,9475,9476,9477,9478,9479,9480,9481,9482,9483,9484,9485,9486,9487,9488,94