:[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"id":"name-jin098-jinming-literal","person_id":"oit_dz6_jxs","surname":"靳","ming":"明","hao":null,"title":null,"additional_names":[],"chapter_id":"c-jinshu-098-wangdun-comparison","paragraph_id":"c-jinshu-098-wangdun-comparison:p005","person_mention_id":"c-jinshu-098-wangdun-comparison:p005:m0094","source_anchor":{"start":94,"end":96,"surface":"靳明"},"quote":"昔漢祖以神武革命，開建帝業，繼以文帝之賢，纂承洪緒，清虛玄默，擬跡成康。賈誼歎息，以為天下倒懸，雖言有抑揚，不失事體。今聖朝肇建，漸振宏綱，往段匹磾遣使求效忠節，尚未有勞，便以方州與之。今靳明等為國雪恥，欲除大逆，此之志望，皆欲附翼天飛。雖功大宜報，亦宜有以裁之，當杜漸防萌，慎之在始。中間不逞，互生事變，皆非忠義，率以一朝之榮。天下漸弊，實由於此。春秋之時，天子微弱，諸侯奢侈，晉文思崇周室，至有求隧之請，襄王讓之以禮，聞義而服，自爾諸侯莫敢越度。臣謂前者賊寇未殄，苟以濟事，朝廷諸所加授，頗多爵位兼重。今自臣以下，宜皆除之，且以塞群小矜功之望，夷狄無懨之求。若復遷延，顧望流俗，使奸狡生心，遂相怨謗，指摘朝廷，讒諛蜂起，臣有以知陛下無以正之。此安危之機，天下之望。","status":"source_attested","human_reviewed":false,"model":null,"work_id":"w-jinshu","book_id":"b-jinshu-098","source_id":"s-jinshu098-wangdun-ws2614273-comparison"}],"mentions":[{"id":"c-jinshu-098-wangdun-comparison:p005:m0094","start":94,"end":96,"surface":"靳明","person_id":"oit_dz6_jxs","kind":"person","paragraph_id":"c-jinshu-098-wangdun-comparison:p005","chapter_id":"c-jinshu-098-wangdun-comparison"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-098-wangdun-comparison:p005","text":"昔漢祖以神武革命，開建帝業，繼以文帝之賢，纂承洪緒，清虛玄默，擬跡成康。賈誼歎息，以為天下倒懸，雖言有抑揚，不失事體。今聖朝肇建，漸振宏綱，往段匹磾遣使求效忠節，尚未有勞，便以方州與之。今靳明等為國雪恥，欲除大逆，此之志望，皆欲附翼天飛。雖功大宜報，亦宜有以裁之，當杜漸防萌，慎之在始。中間不逞，互生事變，皆非忠義，率以一朝之榮。天下漸弊，實由於此。春秋之時，天子微弱，諸侯奢侈，晉文思崇周室，至有求隧之請，襄王讓之以禮，聞義而服，自爾諸侯莫敢越度。臣謂前者賊寇未殄，苟以濟事，朝廷諸所加授，頗多爵位兼重。今自臣以下，宜皆除之，且以塞群小矜功之望，夷狄無懨之求。若復遷延，顧望流俗，使奸狡生心，遂相怨謗，指摘朝廷，讒諛蜂起，臣有以知陛下無以正之。此安危之機，天下之望。","text_layer":"received_chapter","annotation_status":"named_mentions