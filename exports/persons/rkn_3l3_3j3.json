"rkn_3l3_3j3","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p040","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-004-zhou:m041-0000","start":0,"end":2,"surface":"褒姒","kind":"person","person_id":"rkn_3l3_3j3","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p041","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-004-zhou:m041-0044","start":44,"end":46,"surface":"褒姒","kind":"person","person_id":"rkn_3l3_3j3","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p041","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-004-zhou:m042-0078","start":78,"end":80,"surface":"褒姒","kind":"person","person_id":"rkn_3l3_3j3","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p042","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-005-qin:m009-0052","start":52,"end":54,"surface":"褒姒","kind":"person","person_id":"rkn_3l3_3j3","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p009","chapter_id":"c-shiji-005-qin"},{"id":"c-shiji-005-qin:m009-0059","start":59,"end":61,"surface":"褒姒","kind":"person","person_id":"rkn_3l3_3j3","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p009","chapter_id":"c-shiji-005-qin"}],"relations":[{"id":"a-shiji004-037","subject_person_id":"44y_h3t_0pc","predicate":"mother","object_person_id":"rkn_3l3_3j3","status":"source_attested","evidence":[{"paragraph_id":"c-shiji-004-zhou:p040","quote":"褒姒生子伯服","chapter_id":"c-shiji-004-zhou","source_id":"s-shiji-004-zhou"}],"qualifiers":{"source_term":"生子","historicity":"historical_tradition"},"interpretation_note":"保存本文明示的親屬主張；不是獨立確證，不由繼位推導血緣。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-004-zhou:p040","text":"三年，幽王嬖愛褒姒。褒姒生子伯服，幽王欲廢太子。太子母申侯女，而為后。後幽王得褒姒，愛之，欲廢申后，并去太子宜臼，以褒姒為后，以伯服為太子。周太史伯陽讀史記曰：「周亡矣。」昔自夏后氏之衰也，有二神龍止於夏帝庭而言曰：「余，褒之二君。」夏帝卜殺之與去之與止之，莫吉。卜請其漦而藏之，乃吉。於是布幣而策告之，龍亡而漦在，櫝而去之。夏亡，傳此器殷。殷亡，又傳此器周。比三代，莫敢發之，至厲王之末，發而觀之。漦流于庭，不可除。厲王使婦人裸而譟之。漦化為玄黿，以入王後宮。後宮之童妾既齔而遭之，既笄而孕，無夫而生子，懼而棄之。宣王之時童女謠曰：「厭弧箕服，實亡周國。」於是宣王聞之，有夫婦賣是器者，宣王使執而戮之。逃於道，而見鄉者後宮童妾所棄妖子出於路者，聞其夜啼，哀而收之，夫婦遂亡，奔於褒。褒人有罪，請入童妾所棄女子者於王以贖罪。棄女子出於褒，是為褒姒。當幽王三年，王之後宮見而愛之，生子伯服，竟廢申后及太子，以褒姒為后，伯服為太子。太史伯陽曰：「禍成矣，無可奈何！」","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-004-zhou:m040-0003","start":3,"end":5,"surface":"幽王","kind":"person","person_id":"fd5_uxa_0c9","status":"source_identified"},{"id":"c-shiji-004-zhou:m040-0007","start":7,"end":9,"surface":"褒姒","kind":"person","person_id":"rkn_3l3_3j3","status":"source_identified"},{"id":"c-shiji-004-zhou:m040-0010","start":10,"end":12,"surface":"褒姒","kind":"person","person_id":"rkn_3l3_3j3","status":"source_identified"},{"id":"c-shiji-004-zhou:m040-0014","start":14,"end":16,"surface":"伯服","kind":"person","person_id":"44y_h3t_0pc","status":"source_identified"},{"id":"c-shiji-004-zhou:m040-0017","start":17,"end":19,"surface":"幽王","kind":"person","person_id":"fd5_uxa_0c9","status":"source_identified"},{"id":"c-shiji-004-zhou:m040-0024","start":24,"end":27,"surface":"太子母","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官號或文字疑讀；保留錨點，不補熟知姓名或假定同指。"},{"id":"c-shiji-004-zhou:m040-0027","start":27,"end":30,"surface":"申侯女","kind":"person","person_id":"wft_r8s_naw","status":"source_identified"},{"id":"c-shiji-004-zhou:m040-0036","start":36,"end":38,"surface":"幽王","kind":"person","person_id":"fd5_uxa_0c9","status":"source_identified"},{"id":"c-shiji-004-zhou:m040-0039","start":39,"end":41,"surface":"褒姒","kind":"person","person_id":"rkn_3l3_3j3","status":"source_identified"},{"id":"c-shiji-004-zhou:m040-0047","start":47,"end":49,"surface":"申后","kind":"person","person_id":"wft_r8s_naw","status":"source_identified"},{"id":"c-shiji-004-zhou:m040-0052","start":52,"end":56,"surface":"太子宜臼","kind":"person","person_id":"f3g_x6y_1iy","status":"source_identified"},{"id":"c-shiji-004-zhou:m040-0058","start":58,"end":60,"s