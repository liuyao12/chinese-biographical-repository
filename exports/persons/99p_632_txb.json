cerpt_boundary":true},"chapter_id":"c-jinshu-035-peikai-family","book_id":"b-jinshu-035","work_id":"w-jinshu","source_id":"s-jinshu-035-peikai-ws2506399"},{"id":"c-jinshu-035-peikai-family:p011","text":"瓚字國寶，中書郎，風神高邁，見者皆敬之。特為王綏所重，每從其遊。綏父戎謂之曰：「國寶初不來，汝數往，何也？」對曰：「國寶雖不知綏，綏自知國寶。」楊駿之誅，為亂兵所害。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-035-peikai-family:p011:m0000","start":0,"end":1,"surface":"瓚","kind":"person","person_id":"99p_632_txb","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p011:m0002","start":2,"end":4,"surface":"國寶","kind":"person","person_id":"99p_632_txb","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p011:m0022","start":22,"end":24,"surface":"王綏","kind":"person","person_id":"brc_n26_ekm","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p011:m0032","start":32,"end":33,"surface":"綏","kind":"person","person_id":"brc_n26_ekm","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p011:m0033","start":33,"end":34,"surface":"父","kind":"person","person_id":"48e_04a_3d8","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p011:m0034","start":34,"end":35,"surface":"戎","kind":"person","person_id":"48e_04a_3d8","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p011:m0036","start":36,"end":37,"surface":"之","kind":"person","person_id":"brc_n26_ekm","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p011:m0040","start":40,"end":42,"surface":"國寶","kind":"person","person_id":"99p_632_txb","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p011:m0046","start":46,"end":47,"surface":"汝","kind":"person","person_id":"brc_n26_ekm","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p011:m0058","start":58,"end":60,"surface":"國寶","kind":"person","person_id":"99p_632_txb","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p011:m0063","start":63,"end":6