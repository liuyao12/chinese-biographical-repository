中傅祗救護得免，猶坐去官。太保衛瓘、太宰亮稱楷貞正不阿附，宜蒙爵土，乃封臨海侯，食邑二千戶。代楚王瑋為北軍中候，加散騎常侍。瑋怨瓘、亮斥己任楷，楷聞之，不敢拜，轉為尚書。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-035-peikai-family:p005:m0000","start":0,"end":1,"surface":"楷","kind":"person","person_id":"530_f9d_4bd","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p005:m0002","start":2,"end":3,"surface":"瓚","kind":"person","person_id":"99p_632_txb","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p005:m0004","start":4,"end":6,"surface":"楊駿","kind":"person","person_id":"603_131_11e","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p005:m0006","start":6,"end":7,"surface":"女","kind":"person","person_id":"wpv_w1b_yvx","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p005:m0009","start":9,"end":10,"surface":"楷","kind":"person","person_id":"530_f9d_4bd","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p005:m0012","start":12,"end":13,"surface":"駿","kind":"person","person_id":"603_131_11e","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p005:m0019","start":19,"end":20,"surface":"駿","kind":"person","person_id":"603_131_11e","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p005:m0046","start":46,"end":47,"surface":"駿","kind":"person","person_id":"603_131_11e","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p005:m0049","start":49,"end":50,"surface":"楷","kind":"person","person_id":"530_f9d_4bd","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p005:m0080","start":80,"end":81,"surface":"楷","kind":"person","person_id":"530_f9d_4bd","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p005:m0102","start":102,"end":104,"surface":"傅祗","kind":"person","person_id":"6x2_7cd_tw2","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p005:m0116","start":116,"end":118,"surface":"衛瓘","kind":"person","person_id":"6