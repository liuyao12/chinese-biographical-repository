h","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji107-009","subject_person_id":"nuf_tb9_fjs_A","predicate":"spouse","object_person_id":"xlz_fdt_se1","status":"source_attested","evidence":[{"chapter_id":"c-shiji-107-weiqi","source_id":"s-shiji-107-weiqi","paragraph_id":"c-shiji-107-weiqi:p017","quote":"灌夫有服，過丞相。丞相從容曰：「吾欲與仲孺過魏其侯，會仲孺有服。」灌夫曰：「將軍乃肯幸臨況魏其侯，夫安敢以服為解！請語魏其侯帳具，將軍旦日蚤臨。」武安許諾。灌夫具語魏其侯如所謂武安侯。魏其與其夫人益市牛酒，夜灑埽，早帳具至旦。平明，令門下候伺。至日中，丞相不來。魏其謂灌夫曰：「丞相豈忘之哉？」灌夫不懌，曰：「夫以服請，宜往。」乃駕，自往迎丞相。丞相特前戲許灌夫，殊無意往。及夫至門，丞相尚臥。於是夫入見，曰：「將軍昨日幸許過魏其，魏其夫妻治具，自旦至今，未敢嘗食。」武安鄂謝曰：「吾昨日醉，忽忘與仲孺言。」乃駕往，又徐行，灌夫愈益怒。及飲酒酣，夫起舞屬丞相，丞相不起，夫從坐上語侵之。魏其乃扶灌夫去，謝丞相。丞相卒飲至夜，極驩而去。"}],"qualifiers":{"source_term":"魏其與其夫人","historicity":"historical_tradition"},"interpretation_note":"按本文明示親屬與本段人物承接；昆弟子保存叔伯長幼未定，父親未名。高祖孫只作祖父，不補其父姓名。如父子然及鬼故事不產生親屬或復活事件。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-107-weiqi:m017-0096","start":96,"end":98,"surface":"夫人","kind":"person","person_id":"xlz_fdt_se1","status":"contextual_provisional","paragraph_id":"c-shiji-107-weiqi:p017","chapter_id":"c-shiji-107-weiqi"},{"id":"c-shiji-107-weiqi:m021-0009","start":9,"end":11,"surface":"夫人","kind":"person","person_id":"xlz_fdt_se1","status":"contextual_provisional","paragraph_id":"c-shiji-107-weiqi:p021","chapter_id":"c-shiji-107-weiqi"}],"relations":[{"id":"a-shiji107-009","subject_person_id":"nuf_tb9_fjs_A","predicate":"spouse","object_person_id":"xlz_fdt_se1","status":"source_attested","evidence":[{"chapter_id":"c-shiji-107-weiqi","source_id":"s-shiji-107-weiqi","paragraph_id":"c-shiji-107-weiqi:p017","quote":"灌夫有服，過丞相。丞相從容曰：「吾欲與仲孺過魏其侯，會仲孺有服。」灌夫曰：「將軍乃肯幸臨況魏其侯，夫安敢以服為解！請語魏其侯帳具，將軍旦日蚤臨。」武安許諾。灌夫具語魏其侯