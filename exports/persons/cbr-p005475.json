,"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji097-038","person_id":"7wk_awi_f4x","scope":"same_chapter","chapter_ids":["c-shiji-097-luli"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["單于"],"evidence":[{"paragraph_id":"c-shiji-097-luli:p020","quote":"孝文帝時，淮南厲王殺辟陽侯，以諸呂故。文帝聞其客平原君為計策，使吏捕欲治。聞吏至門，平原君欲自殺。諸子及吏皆曰：「事未可知，何早自殺為？」平原君曰：「我死禍絕，不及而身矣。」遂自剄。孝文帝聞而惜之，曰：「吾無意殺之。」乃召其子，拜為中大夫。使匈奴，單于無禮，乃罵單于，遂死匈奴中。"}],"rationale":"按酈生、陸賈與朱建分傳及敘事承接限定異稱；尉他尉佗原字分存。平原君據明示朱建另候選；朱建兩處未名子尚不合併，淮陰侯與單稱韓信跨篇同指待證。引語古王及神話人物與當事人分開。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-097-luli:p020","text":"孝文帝時，淮南厲王殺辟陽侯，以諸呂故。文帝聞其客平原君為計策，使吏捕欲治。聞吏至門，平原君欲自殺。諸子及吏皆曰：「事未可知，何早自殺為？」平原君曰：「我死禍絕，不及而身矣。」遂自剄。孝文帝聞而惜之，曰：「吾無意殺之。」乃召其子，拜為中大夫。使匈奴，單于無禮，乃罵單于，遂死匈奴中。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-097-luli:m020-0000","start":0,"end":3,"surface":"孝文帝","kind":"person","person_id":"q5g_lr6_7vc","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m020-0005","start":5,"end":9,"surface":"淮南厲王","kind":"person","person_id":"k4e_4tr_lg0","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m020-0010","start":10,"end":13,"surface":"辟陽侯","kind":"person","person_id":"697_9f9_d41","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m020-0019","start":19,"end":21,"surface":"文帝","kind":"person","person_id":"q5g_lr6_7vc","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m020-0024","start":24,"end":27,"surface":"平原君","kind":"person","person_id":"tkc_9z3_91l","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m020-0042","start":42,"end":45,"surface":"平原君","kind":"person","person_id":"tkc_9z3_91l","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m020-0049","start":49,"end":51,"surface":"諸子","kind":"unresolved","person_id":null,"status":"unresolved","note":"來源未名群體，不補具名成員或確切