{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004856","identity_policy":"contextual_provisional","person_ids":["cbr-p004856"],"persons":[{"id":"cbr-p004856","label":"趙王被虜未名（刺客列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"趙王","mention_ids":["c-shiji-086-cike:m030-0018"]}],"evidence":[{"mention_id":"c-shiji-086-cike:m030-0018","chapter_id":"c-shiji-086-cike","paragraph_id":"c-shiji-086-cike:p030","quote":"趙王"}]}],"source_mention_summary":[{"source_id":"s-shiji-086-cike","work_id":"w-shiji","book_id":"b-shiji-086","chapter_id":"c-shiji-086-cike","mention_count":1,"mention_ids":["c-shiji-086-cike:m030-0018"],"paragraph_ids":["c-shiji-086-cike:p030"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-086-cike"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-086-cike:m030-0018","start":18,"end":20,"surface":"趙王","kind":"person","person_id":"cbr-p004856","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p030","chapter_id":"c-shiji-086-cike"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji086-045","person_id":"cbr-p004856","scope":"same_chapter","chapter_ids":["c-shiji-086-cike"],"status":"contextual_provisional","rationale":"依荊軻入燕敘事及明示異稱暫接；慶卿、荊卿指荊軻，田光之光限第28至29段，丹限太子丹敘事。魯句踐不與其他句踐合併；狗屠、主人及被虜韓趙王保留未名。嵌套代詞仍待逐處核定。","reviewer":"Codex（AI 代理）","surfaces":["趙王"],"evidence":[{"paragraph_id":"c-shiji-086-cike:p030","quote":"久之，荊軻未有行意。秦將王翦破趙，虜趙王，盡收入其地，進兵北略地至燕南界。太子丹恐懼，乃請荊軻曰：「秦兵旦暮渡易水，則雖欲長侍足下，豈可得哉！」荊軻曰：「微太子言，臣願謁之。今行而毋信，則秦未可親也。夫樊將軍，秦王購之金千斤，邑萬家。誠得樊將軍首與燕督亢之地圖，奉獻秦王，秦王必説見臣，臣乃得有以報。」太子曰：「樊將軍窮困來歸丹，丹不忍以己之私而傷長者之意，願足下更慮之！」"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-086-cike:p030","text":"久之，荊軻未有行意。秦將王翦破趙，虜趙王，盡收入其地，進兵北略地至燕南界。太子丹恐懼，乃請荊軻曰：「秦兵旦暮渡易水，則雖欲長侍足下，豈可得哉！」荊軻曰：「微太子言，臣願謁之。今行而毋信，則秦未可親也。夫樊將軍，秦王購之金千斤，邑萬家。誠得樊將軍首與燕督亢之地圖，奉獻秦王，秦王必説見臣，臣乃得有以報。」太子曰：「樊將軍窮困來歸丹，丹不忍以己之私而傷長者之意，願足下更慮之！」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-086-cike:m030-0003","start":3,"end":5,"surface":"荊軻","kind":"person","person_id":"cbr-p004841","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m030-0010","start":10,"end":14,"surface":"秦將王翦","kind":"person","person_id":"cbr-p004854","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m030-0018","start":18,"end":20,"surface":"趙王","kind":"person","person_id":"cbr-p004856","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m030-0037","start":37,"end":40,"surface":"太子丹","kind":"person","person_id":"cbr-p004849","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m030-0045","start":45,"end":47,"surface":"荊軻","kind":"person","person_id":"cbr-p004841","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m030-0072","start":72,"end":74,"surface":"荊軻","kind":"person","person_id":"cbr-p004841","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m030-0078","start":78,"end":80,"surface":"太子","kind":"person","person_id":"cbr-p004849","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m030-0101","start":101,"end":104,"surface":"樊將軍","kind":"person","person_id":"cbr-p004852","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m030-0105","start":105,"end":107,"surface":"秦王","kind":"person","person_id":"cbr-p004850","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m030-0119","start":119,"end":122,"surface":"樊將軍","kind":"person","person_id":"cbr-p004852","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m030-0133","start":133,"end":135,"surface":"秦王","kind":"person","person_id":"cbr-p004850","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m030-0136","start":136,"end":138,"surface":"秦王","kind":"person","person_id":"cbr-p004850","status":"co