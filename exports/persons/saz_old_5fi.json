d_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"person_id":"saz_old_5fi","title":null,"surname":"孟","ming":"軻","additional_names":[],"work_id":"w-shiji","book_id":"b-shiji-074","chapter_id":"c-shiji-074-mengxun","source_id":"s-shiji-074-mengxun","paragraph_id":"c-shiji-074-mengxun:p002","quote":"孟軻，騶人也。受業子思之門人。道既通，游事齊宣王，宣王不能用。適梁，梁惠王不果所言，則見以為迂遠而闊於事情。當是之時，秦用商君，富國彊兵；楚、魏用吳起，戰勝弱敵；齊威王、宣王用孫子、田忌之徒，而諸侯東面朝齊。天下方務於合從連衡，以攻伐為賢，而孟軻乃述唐、虞、三代之德，是以所如者不合。退而與萬章之徒序詩書，述仲尼之意，作孟子七篇。其後有騶子之屬。","note":"依本段所書姓名與明示字號分欄；姓氏劃分為編者判讀，保留複姓及完整名，不從字號倒造本名、不補未見官爵或血緣。","status":"editorial_provisional","human_reviewed":false}],"mentions":[{"id":"c-shiji-044-wei:m039-0024","start":24,"end":26,"surface":"孟軻","kind":"person","person_id":"saz_old_5fi","status":"contextual_provisional","paragraph_id":"c-shiji-044-wei:p039","chapter_id":"c-shiji-044-wei"},{"id":"c-shiji-044-wei:m039-0096","start":96,"end":98,"surface":"孟軻","kind":"person","person_id":"saz_old_5fi","status":"contextual_provisional","paragraph_id":"c-shiji-044-wei:p039","chapter_id":"c-shiji-044-wei"},{"id":"c-shiji-074-mengxun:m002-0000","start":0,"end":2,"surface":"孟軻","kind":"person","person_id":"saz_old_5fi","status":"contextual_provisional","paragraph_id":"c-shiji-074-mengxun:p002","chapter_id":"c-shiji-074-mengxun"},{"id":"c-shiji-074-mengxun:m002-0121","start":121,"end":123,"surface":"孟軻","kind":"person","person_id":"saz_old_5fi","status":"contextual_provisional","paragraph_id":"c-shiji-074-mengxun:p002","chapter_id":"c-shiji-074-mengxun"},{"id":"c-shiji-074-mengxun:m003-0033","start":33,"end":35,"surface":"孟子","kind":"person","person_id":"saz_old_5fi","st