sional"},{"id":"c-shiji-118-huainan:m019-1017","start":1017,"end":1021,"surface":"王子比干","kind":"person","person_id":"xtq_oi8_w82","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m019-1024","start":1024,"end":1026,"surface":"孟子","kind":"person","person_id":"saz_old_5fi","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m019-1028","start":1028,"end":1029,"surface":"紂","kind":"person","person_id":"lwx_9yq_ad7","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m019-1031","start":1031,"end":1033,"surface":"天子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-118-huainan:m019-1043","start":1043,"end":1044,"surface":"紂","kind":"person","person_id":"lwx_9yq_ad7","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m019-1068","start":1068,"end":1070,"surface":"大王","kind":"person","person_id":"yqp_nlb_p1p_AFA","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m019-1085","start":1085,"end":1087,"surface":"群臣","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-118-huainan","book_id":"b-shiji-118","work_id":"w-shiji","source_id":"s-shiji118-huainan"},{"id":"c-shiji-121-rulin:p002","text":"自孔子卒後，七十子之徒散游諸侯，大者為師傅卿相，小者友教士大夫，或隱而不見。故子路居衛，子張居陳，澹臺子羽居楚，子夏居西河，子貢終於齊。如田子方、段干木、吳起、禽滑釐之屬，皆受業於子夏之倫，為王者師。是時獨魏文侯好學。后陵遲以至于始皇，天下并爭於戰國，懦術既絀焉，然齊魯之閒，學者獨不廢也。於威、宣之際，孟子、荀卿之列，咸遵夫子之業而潤色之，以學顯於當世。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m002-0001","start":1,"end":3,"surface":"孔子","kind":"person","person_id":"fp6_ia6_7yw","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m002-0006","start":6,"end":11,"surface":"七十子之徒","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m002-0013","start":13,"end":15,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m002-0028","start":28,"end":31,"surface":"士大夫","kind":"unresolved","person_id":null,"status":"unr