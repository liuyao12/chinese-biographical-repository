{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"qig_axh_3z6","canonical_person_id":"qig_axh_3z6","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["qig_axh_3z6"],"persons":[{"id":"qig_axh_3z6","label":"尉佗（平津侯主父列傳上書候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"尉佗","mention_ids":["c-shiji-112-pingjin:m013-0330","c-shiji-112-pingjin:m019-0260"]}],"evidence":[{"mention_id":"c-shiji-112-pingjin:m013-0330","chapter_id":"c-shiji-112-pingjin","paragraph_id":"c-shiji-112-pingjin:p013","quote":"尉佗"},{"mention_id":"c-shiji-112-pingjin:m019-0260","chapter_id":"c-shiji-112-pingjin","paragraph_id":"c-shiji-112-pingjin:p019","quote":"尉佗"}]}],"source_mention_summary":[{"source_id":"s-shiji112-pingjin","work_id":"w-shiji","book_id":"b-shiji-112","chapter_id":"c-shiji-112-pingjin","mention_count":2,"mention_ids":["c-shiji-112-pingjin:m013-0330","c-shiji-112-pingjin:m019-0260"],"paragraph_ids":["c-shiji-112-pingjin:p013","c-shiji-112-pingjin:p019"],"table_cell_ids":[],"passage_count":2}],"most_mentioned_source_ids":["s-shiji112-pingjin"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-112-pingjin:m013-0330","start":330,"end":332,"surface":"尉佗","kind":"person","person_id":"qig_axh_3z6","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p013","chapter_id":"c-shiji-112-pingjin"},{"id":"c-shiji-112-pingjin:m019-0260","start":260,"end":262,"surface":"尉佗","kind":"person","person_id":"qig_axh_3z6","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p019","chapter_id":"c-shiji-112-pingjin"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-112-pingjin:p013","text":"及至高皇帝定天下，略地於邊，聞匈奴聚於代谷之外而欲擊之。御史成進諫曰：「不可。夫匈奴之性，獸聚而鳥散，從之如搏影。今以陛下盛德攻匈奴，臣竊危之。」高帝不聽，遂北至於代谷，果有平城之圍。高皇帝蓋悔之甚，乃使劉敬往結和親之約，然後天下忘干戈之事。故兵法曰「興師十萬，日費千金」。夫秦常積眾暴兵數十萬人，雖有覆軍殺將系虜單于之功，亦適足以結怨深讎，不足以償天下之費。夫上虛府庫，下敝百姓，甘心於外國，非完事也。夫匈奴難得而制，非一世也。行盜侵驅，所以為業也，天性固然。上及虞夏殷周，固弗程督，禽獸畜之，不屬為人。夫上不觀虞夏殷周之統，而下（修）［循］近世之失，此臣之所大憂，百姓之所疾苦也。且夫兵久則變生，事苦則慮易。乃使邊境之民獘靡愁苦而有離心，將吏相疑而外市，故尉佗、章邯得以成其私也。夫秦政之所以不行者，權分乎二子，此得失之效也。故《周書》曰「安危在出令，存亡在所用」。願陛下詳察之，少加意而熟慮焉。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-112-pingjin:m013-0002","start":2,"end":5,"surface":"高皇帝","kind":"person","person_id":"1c0_c3k_jno","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m013-0030","start":30,"end":32,"surface":"成進","kind":"person","person_id":"lve_fqh_8v6","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m013-0059","start":59,"end":61,"surface":"陛下","kind":"person","person_id":"1c0_c3k_jno","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m013-0073","start":73,"end":75,"surface":"高帝","kind":"person","person_id":"1c0_c3k_jno","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m013-0092","start":92,"end":95,"surface":"高皇帝","kind":"person","person_id":"1c0_c3k_jno","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m013-0102","start":102,"end":104,"surface":"劉敬","kind":"person","person_id":"5vm_33p_472","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m013-0157","start":157,"end":159,"surface":"單于","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-112-pingjin:m013-0330","start":330,"end":332,"surface":"尉佗","kind":"person","person_id":"qig_axh_3z6","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m013-0333","start":333,"end":335,"surface":"章邯","kind":"person","person_id":"rxf_qqr_to2","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m013-0355","start":355,"end":357,"surface":"二子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-112-pingjin:m013-0386","start":386,"end":388,"surface":"陛下","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"}],"chapter_id":"c-shiji-112-pingjin","book_id":"b-shiji-112","work_id":"w-shiji","source_id":"s-shiji112-pingjin"},{"id":"c-shiji-112-pingjin:p019","text":"及至秦王，蠶食天下，并吞戰國，稱號曰皇帝，主海內之政，壞諸侯之城，銷其兵，鑄以為鐘虡，示不復用。元元黎民得免於戰國，逢明天子，人人自以為更生。向使秦緩其刑罰，薄賦斂，省繇役，貴仁義，賤權利，上篤厚，下智巧，變風易俗，化於海內，則世世必安矣。秦不行是風而修其故俗，為智巧權利者進，篤厚忠信者退；法嚴政峻，諂諛者眾，日聞其美，意廣心軼。欲肆威海外，乃使蒙恬將兵以北攻胡，辟地進境，戍於北河，蜚芻芻粟以隨其后。又使尉[佗]屠睢將樓船之士南攻百越，使監祿鑿渠運糧，深入越，越人遁逃。曠日持久，糧食絕乏，越人擊之，秦兵大敗。秦乃使尉佗將卒以戍越。當是時，秦禍北構於胡，南掛於越，宿兵無用之地，進而不得退。行十餘年，丁男被甲，丁女轉輸，苦不聊生，自經於道樹，死者相望。及秦皇帝崩，天下大叛。陳勝、吳廣舉陳，武臣、張耳舉趙，項梁舉吳，田儋舉齊，景駒舉郢，周市舉魏，韓廣舉燕，窮山通谷豪士并起，不可勝載也。然皆非公侯之后，非長官之吏也。無尺寸之勢，起閭巷，杖棘矜，應時而皆動，不謀而俱起，不約而同會，壤長地進，至于霸王，時教使然也。秦貴為天子，富有天下，滅世絕祀者，窮兵之禍也。故周失之弱，秦失之彊，不變之患也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-112-pingjin:m019-0002","start":2,"end":4,"surface":"秦王","kind":"person","person_id":"ny0_svo_ifn","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m019-0059","start":59,"end":62,"surface":"明天子","kind":"person","person_id":"ny0_svo_ifn","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m019-0174","start":174,"end":176,"surface":"蒙恬","kind":"person","person_id":"8kz_4ad_0fq","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m019-0204","start":204,"end":208,"surface":"尉[佗]","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-112-pingjin:m019-0208","start":208,"end":210,"surface":"屠睢","kind":"person","person_id":"5ep_xih_trk","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m019-0221","sta