d_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-shiji070-001","person_id":"tik_tcq_8l1","event_type":"death","status":"source_attested","date_expression":null,"source_term":"魏襄王卒","evidence":[{"chapter_id":"c-shiji-070-zhang","source_id":"s-shiji-070-zhang","paragraph_id":"c-shiji-070-zhang:p012","quote":"其後二年，使與齊、楚之相會齧桑。東還而免相，相魏以為秦，欲令魏先事秦而諸侯效之。魏王不肯聽儀。秦王怒，伐取魏之曲沃、平周，復陰厚張儀益甚。張儀慚，無以歸報。留魏四歲而魏襄王卒，哀王立。張儀復說哀王，哀王不聽。於是張儀陰令秦伐魏。魏與秦戰，敗。","person_mention_id":"c-shiji-070-zhang:m012-0083"}],"interpretation_note":"來源死亡陳述，人物身份與年代仍待跨篇覆核；屈丐與其他篇可能被虜差異不抹去，代王故事屬張儀引語，先王棄群臣不補親子。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"mentions":[{"id":"c-shiji-070-zhang:m012-0040","start":40,"end":42,"surface":"魏王","kind":"person","person_id":"tik_tcq_8l1","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p012","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-070-zhang:m012-0083","start":83,"end":86,"surface":"魏襄王","kind":"person","person_id":"tik_tcq_8l1","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p012","chapter_id":"c-shiji-070-zhang"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji070-025","person_id":"tik_tcq_8l1","scope":"same_chapter","chapter_ids":["c-shiji-070-zhang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["魏王","魏襄王"],"evidence":[{"paragraph_id":"c-shiji-070-zhang:p012","quote":"其後二年，使與齊、楚之相會齧桑。東還而免相，相魏以為秦，欲令魏先事秦而諸侯效之。魏王不肯聽儀。秦王怒，伐取魏之曲沃、平周，復陰厚張儀益甚。張儀慚，無以歸報。留魏四歲而魏襄王卒，哀王立。張儀復說哀王，哀王不聽。於是張儀陰令秦伐魏。魏與秦戰，敗。"}],"rationale":"按第1至23段局部明示姓名與引語判讀；魏襄王卒後哀王受話語境分開。楚懷王與秦惠王在出使鄭袖段分辨，不按最近名字或全域王字判讀。擬議秦女、美人與子母不補姓名或婚姻；未名齊王不按年代記憶定名，異稱、史實及時序仍待覆核。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-070-zhang:p012","text":"其後二年，使與齊、楚之相會齧桑。東還而免相，相魏以為秦，欲令魏先事秦而諸侯效之。魏王不肯聽儀。秦王怒，伐取魏之曲沃、平周，復陰厚張儀益甚。張儀慚，無以歸報。留魏四歲而魏襄王卒，哀王立。張儀復說哀王，哀王不聽。於是張儀陰令秦伐魏。魏與秦戰，敗。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-070-zhang:m012-0007","start":7,"end":12,"surface":"齊、楚之相","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、未定身分或擬議婚姻，不補姓名、實受關係或成員。"},{"id":"c-shiji-070-zhang:m012-0035","start":35,"end":37,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、未定身分或擬議婚姻，不補姓名、實受關係或成員。"},{"id":"c-shiji-070-zhang:m012-0040","start":40,"end":42,"surface":"魏王","kind":"person","person_id":"tik_tcq_8l1","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m012-0045","start":45,"end":46,"surface":"儀","kind":"person","person_id":"uq6_74z_vtv","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m012-0047","start":47,"end":49,"surface":"秦王","kind":"person","person_id":"y97_huh_vuz_AAAAAAAAAAAAABAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m012-0064","start":64,"end":66,"surface":"張儀","kind":"person","person_id":"uq6_74z_vtv","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m012-0069","start":69,"end":71,"surface":"張儀","kind":"person","person_id":"uq6_74z_vtv","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m012-0083","start":83,"end":86,"surface":"魏襄王","kind":"person","person_id":"tik_tcq_8l1","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m012-0088","start":88,"end":90,"surface":"哀王","kind":"person","person_id":"n79_99b_tpt","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m012-0092","start":92,"end":94,"surface":"張儀","kind":"person","person_id":"uq6_74z_vtv","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m012-0096","start":96,"end":98,"surface":"哀王","kind":"person","person_id":"n79_99b_tpt","status":"contextual_provisional"},{"id":"c-shiji-070