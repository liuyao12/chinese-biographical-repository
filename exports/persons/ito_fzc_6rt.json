rn-and-eastern-complete:p003:m0091"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-058-southern-and-eastern-complete:p005:m0004","mention_ids":["c-nanqishu-058-southern-and-eastern-complete:p005:m0004"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-058-southern-and-eastern-complete:p005:m0045","mention_ids":["c-nanqishu-058-southern-and-eastern-complete:p005:m0045"],"kind":"paragraph"}],"mention_count":3,"duplicate_mention_count":0,"paragraph_occurrence_count":3,"table_occurrence_count":0,"passage_count":2,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"3處獨立位置，3個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-nanqishu-058-southern-and-eastern-complete-ws2638629"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-nanqishu-058-southern-and-eastern-complete:source_review3-0","kind":"source_review","person_id":"ito_fzc_6rt","source_quote":"汶陽本臨沮西界，二百里中，水陸迂狹，魚貫而行，有數處不通騎，而水白田甚肥腴。桓溫時，割以為郡。西北接梁州新城，東北接南襄城，南接巴、巫二邊，竝山蠻凶盛，據險為寇賊。宋泰始以來，巴建蠻向宗頭反，刺史沈攸之斷其鹽米，連討不剋。晉（天）〔太〕興三年，建平夷王向弘、向瓂等詣臺求拜除，尚書郎張亮議：「夷貊不可假以軍號。」元帝詔特以弘為折衝將軍、當平鄉侯，竝親晉王，賜以朝服。宗頭其後也。太祖置巴州以威靜之。","reading":"汶陽沿革及鄰界為地誌。向宗頭宋泰始活動與下一附敘永明初分時。","note":"汶陽沿革及鄰界為地誌。向宗頭宋泰始活動與下一附敘永明初分時。","paragraph_id":"c-nanqishu-058-southern-and-eastern-complete:p003","start_codepoint":0,"end_codepoint":199,"human_reviewed":false,"chapter_id":"c-nanqishu-058-southern-and-eastern-complete","source_id":"s-nanqishu-058-southern-and-eastern-complete-ws2638629"},{"id":"c-nanqishu-058-southern-and-eastern-complete:source_review5-0","kind":"source_review","person_id":"ito_fzc_6rt","source_quote":"永明初，向宗頭與黔陽蠻田豆渠等五千人為寇，巴東太守王圖南遣府司馬劉僧壽等斬山開道，攻其砦，宗頭夜燒砦退走。","reading":"向宗頭與田豆渠聯起，巴東太守王圖南遣劉僧壽攻，宗頭燒砦退走。","note":"向宗頭與田豆渠聯起，巴東太守王圖南遣劉僧壽攻，宗頭燒砦退走。","paragraph_id":"c-nanqishu-058-southern-and-eastern-complete:p005","start_codepoint":0,"end_codepoint":53,"human_reviewed":false,"chapter_id":"c-nanqishu-058-southern-and-eastern-complete","source_id":"s-nanqishu-058-southern-and-eastern-complete-ws2638629"},{"id":"c-nanqishu-058-southern-and-eastern-complete:variant_review5-4","kind":"variant_review","person_id":"ito_fzc_6rt","source_quote":"向宗頭與黔陽蠻田豆渠","reading":"黔陽著於田豆渠；向宗頭另見前段宋泰始以來的巴建活動。","note":"黔陽著於田豆渠；向宗頭另見前段宋泰始以來的巴建活動。","paragraph_id":"c-nanqishu-058-southern-and-eastern-complete:p005","start_codepoint":4,"end_codepoint":14,"human_reviewed":false,"chapter_id":"c-nanqishu-058-southern-and-eastern-complete","source_id":"s-nanqishu-058-southern-and-eastern-complete-ws2638629"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-058-southern-and-eastern-complete:p003:m0091","start":91,"end":94,"surface":"向宗頭","kind":"person","person_id":"ito_fzc_6rt","status":"contextual_provisional","paragraph_id":"c-nanqishu-058-southern-and-eastern-complete:p003","chapter_id":"c-nanqishu-058-southern-and-eastern-complete"},{"id":"c-nanqishu-058-southern-and-eastern-complete:p005:m0004","start":4,"end":7,"surface":"向宗頭","kind":"person","person_id":"ito_fzc_6rt","status":"contextual_provisional","paragraph_id":"c-nanqishu-058-southern-and-eastern-complete:p005","chapter_id":"c-nanqishu-058-southern-and-eastern-complete"},{"id":"c-nanqishu-058-southern-and-eastern-complete:p005:m0045","start":45,"end":47,"surface":"宗頭","kind":"person","person_id":"ito_fzc_6rt","status":"contextual_provisional","paragraph_id":"c-nanqishu-058-southern-and-eastern-complete:p005","chapter_id":"c-nanqishu-058-southe