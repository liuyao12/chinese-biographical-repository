inshu-067-wenqiao"},{"id":"c-jinshu-098-jin033-wangji:line019:m0071","start":71,"end":74,"surface":"段匹磾","kind":"person","person_id":"1y3_yi0_8d4","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line019","chapter_id":"c-jinshu-098-jin033-wangji"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-044-luchen:line069","text":"建興末，隨琨投段匹磾。匹磾自領幽州，取諶為別駕。匹磾既害琨，尋亦敗喪。時南路阻絕，段末波在遼西，諶往投之。元帝之初，末波通使于江左，諶因其使抗表理琨，文旨甚切，於是即加弔祭。累徵諶為散騎中書侍郎，而為末波所留，遂不得南渡。末波死，弟遼代立，諶流離世故且二十載。石季龍破遼西，復為季龍所得，以為中書侍郎、國子祭酒、侍中、中書監。屬冉閔誅石氏，諶隨閔軍，于襄國遇害，時年六十七，是歲永和六年也。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-044-luchen:line069:m0005","start":5,"end":6,"surface":"琨","kind":"person","person_id":"b21_e55_8bd","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luchen:line069:m0007","start":7,"end":10,"surface":"段匹磾","kind":"person","person_id":"1y3_yi0_8d4","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luchen:line069:m0011","start":11,"end":13,"surface":"匹磾","kind":"person","person_id":"1y3_yi0_8d4","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luchen:line069:m0019","start":19,"end":20,"surface":"諶","kind":"person","person_id":"m8n_ntm_79h_ABBA","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luchen:line069:m0024","start":24,"end":26,"surface":"匹磾","kind":"person","person_id":"1y3_yi0_8d4","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luchen:line069:m0028","start":28,"end":29,"surface":"琨","kind":"person","person_id":"b21_e55_8bd","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinsh