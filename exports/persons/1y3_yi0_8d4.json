ily_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-098-jin033-wangji:line019:m0071","start":71,"end":74,"surface":"段匹磾","kind":"person","person_id":"1y3_yi0_8d4","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line019","chapter_id":"c-jinshu-098-jin033-wangji"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-098-jin033-wangji:line019","text":"昔漢祖以神武革命，開建帝業，繼以文帝之賢，纂承洪緒，清虛玄默，擬跡成康。賈誼歎息，以為天下倒懸，雖言有抑揚，不失事體。今聖朝肇建，漸振宏綱，往段匹磾遣使求效忠節，尚未有勞，便以方州與之。今靳明等為國雪恥，欲除大逆，此之志望，皆欲附翼天飛。雖功大宜報，亦宜有以裁之，當杜漸防萌，慎之在始。中間不逞，互生事變，皆非忠義，率以一朝之榮。天下漸弊，實由於此。春秋之時，天子微弱，諸侯奢侈，晉文思崇周室，至有求隧之請，襄王讓之以禮，聞義而服，自爾諸侯莫敢越度。臣謂前者賊寇未殄，苟以濟事，朝廷諸所加授，頗多爵位兼重。今自臣以下，宜皆除之，且以塞群小矜功之望，夷狄無懨之求。若復遷延，顧望流俗，使奸狡生心，遂相怨謗，指摘朝廷，讒諛蜂起，臣有以知陛下無以正之。此安危之機，天下之望。","annotation_status":"reviewed","text_layer":"received_chapter","mentions":[{"id":"c-jinshu-098-jin033-wangji:line019:m0001","start":1,"end":3,"surface":"漢祖","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line019:m0016","start":16,"end":18,"surface":"文帝","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line019:m0033","start":33,"end":34,"surface":"成","kind":"person","person_id":"qna_m75_pj8","status":"contextual_provisional","interpretation_note":"讀本段前後及對話，所指按此處記。"},{"id":"c-jinshu-098-jin033-wangji:line019:m0034","start":34,"end":35,"surface":"康","kind":"person","person_id":"nek_dsn_nih","status":"contextual_provisional","interpretation_note":"讀本段前後及對話，所指按此處記。"},{"id":"c-jinshu-098-jin033-wangj