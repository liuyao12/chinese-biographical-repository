{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p005368","identity_policy":"contextual_provisional","person_ids":["cbr-p005368"],"persons":[{"id":"cbr-p005368","label":"蕭何（張丞相列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"蕭何","mention_ids":["c-shiji-096-zhang:m002-0020"]}],"evidence":[{"mention_id":"c-shiji-096-zhang:m002-0020","chapter_id":"c-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p002","quote":"蕭何"}]}],"mentions":[{"id":"c-shiji-096-zhang:m002-0020","start":20,"end":22,"surface":"蕭何","kind":"person","person_id":"cbr-p005368","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p002","chapter_id":"c-shiji-096-zhang"}],"relations":[],"title_holdings":[{"id":"th-shiji096-010","person_id":"cbr-p005368","title":"相國","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-096-zhang","source_id":"s-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p002","quote":"遷為計相，一月，更以列侯為主計四歲。是時蕭何為相國，而張蒼乃自秦時為柱下史，明習天下圖書計籍。蒼又善用算律歷，故令蒼以列侯居相府，領主郡國上計者。黥布反亡，漢立皇子長為淮南王，而張蒼相之。十四年，遷為御史大夫。"}],"attestations":[{"id":"th-shiji096-010:a001","paragraph_id":"c-shiji-096-zhang:p002","start":23,"end":25,"surface":"相國","person_mention_id":"c-shiji-096-zhang:m002-0020","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"原文實授、轉任、用稱與諡稱分存；未明示時任期起訖未知。欲任竇廣國及欲令周苛將皆不作實授；死亡或首次用稱不自動作任期端點。十四年、四年、二年等先保留原語，不擅定年號或西曆。曹窋免職段含（不）異文，未先強定其終點。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji096-010","person_id":"cbr-p005368","surfaces":["蕭何"],"scope":"same_chapter","chapter_ids":["c-shiji-096-zhang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-096-zhang:p002","quote":"遷為計相，一月，更以列侯為主計四歲。是時蕭何為相國，而張蒼乃自秦時為柱下史，明習天下圖書計籍。蒼又善用算律歷，故令蒼以列侯居相府，領主郡國上計者。黥布反亡，漢立皇子長為淮南王，而張蒼相之。十四年，遷為御史大夫。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定短稱；韋賢與韋玄成分傳區別，第23段掾陳平另候選，第25段長安相工田文不與孟嘗君合併。趙堯、任敖、申屠嘉、鄧通、晁錯的短名依各段人物語境，王陵夫人與王陵分人。張蒼父長不滿五尺的長為身長敘述，不作父名。王侯與太子未詳名不補名，跨篇同指另待證據。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-096-zhang:p002","text":"遷為計相，一月，更以列侯為主計四歲。是時蕭何為相國，而張蒼乃自秦時為柱下史，明習天下圖書計籍。蒼又善用算律歷，故令蒼以列侯居相府，領主郡國上計者。黥布反亡，漢立皇子長為淮南王，而張蒼相之。十四年，遷為御史大夫。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhang:m002-0020","start":20,"end":22,"surface":"蕭何","kind":"person","person_id":"cbr-p005368","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m002-0027","start":27,"end":29,"surface":"張蒼","kind":"person","person_id":"cbr-p005362","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m002-0047","start":47,"end":48,"surface":"蒼","kind":"person","person_id":"cbr-p005362","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m002-0057","start":57,"end":58,"surface":"蒼","kind":"person","person_id":"cbr-p005362","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m002-0073","start":73,"end":75,"surface":"黥布","kind":"person","person_id":"cbr-p005369","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m002-0080","start":80,"end":83,"surface":"皇子長","kind":"person","person_id":"cbr-p005361","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m002-0089","start":89,"end":91,"surface":"張蒼","kind":"person","person_id":"cbr-p005362","status":"contextual_provisional"}],"chapter_id":"c-shiji-096-zhang","book_id":"b-shiji-096","work_id":"w-shiji","source_id":"s-shiji-096-zhang"}],"sources":[{"chapter_id":"c-shiji-096-zhang","work_id":"w-shiji","book_id":"b-shiji-096","source_id":"s-shiji-096-zhang","source":{"title":"史記／卷096","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷096","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷096&oldid=8770206","revision_id":8770206,"accessed_on":"2026