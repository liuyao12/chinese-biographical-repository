extual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p017:m0218","start":218,"end":221,"surface":"柳世隆","kind":"person","person_id":"5jc_z9b_i2n_AAAA","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p017:m0222","start":222,"end":224,"surface":"懷慰","kind":"person","person_id":"m1k_249_ywq","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-053-local-officials-complete","book_id":"b-nanqishu-053","work_id":"w-nanqishu","source_id":"s-nanqishu-053-local-officials-complete-ws1501803"},{"id":"c-nanqishu-053-local-officials-complete:p018","text":"　　懷慰本名聞慰，世祖卽位，以與舅氏名同，勑改之。出監東陽郡，爲吏民所安。還兼安陸王北中郎司馬。永明九年，卒。年四十五。明帝卽位，謂僕射徐孝嗣曰：「劉懷慰若在，朝廷不憂無清吏也。」懷慰與濟陽江淹、陳郡袁彖善，亦著文翰。永明初，獻《皇德論》云。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":54,"last_line":54,"raw_start":2598,"raw_end":2719,"raw_character_offsets":[2598,2599,2600,2601,2602,2603,2604,2605,2606,2607,2608,2609,2610,2611,2612,2613,2614,2615,2616,2617,2618,2619,2620,2621,2622,2623,2624,2625,2626,2627,2628,2629,2630,2631,2632,2633,2634,2635,2636,2637,2638,2639,2640,2641,2642,2643,2644,2645,2646,2647,2648,2649,2650,2651,2652,2653,2654,2655,2656,2657,2658,2659,2660,2661,2662,2663,2664,2665,2666,2667,2668,2669,2670,2671,2672,2673,2674,2675,2676,2677,2678,2679,2680,2681,2682,2683,2684,2685,2686,2687,2688,2689,2690,2691,2692,2693,2694,2695,2696,2697,2698,2699,2700,2701,2702,2703,2704,2705,2706,2707,2708,2709,2710,2711,2712,2713,2714,2715,2716,2717,2718],"revision_id":1501803},"mentions":[{"id":"c-nanqishu-053-local-officials-complete:p018:m0002","start":2,"end":4,"surface":"懷慰","kind":"person","person_id":"m1k_249_ywq","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p018:m0006","start":6,"end":8,"surface":"聞慰","kind":"person","person_id":"m1k_249_ywq","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p018:m0009","start":9,"end":11,"surface":"世祖","kind":"person","person_id":"k