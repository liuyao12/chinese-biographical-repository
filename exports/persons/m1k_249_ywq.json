"status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p015:m0017","start":17,"end":19,"surface":"奉伯","kind":"person","person_id":"m27_39f_89l","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p015:m0031","start":31,"end":33,"surface":"乘民","kind":"person","person_id":"22z_on9_kym","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p015:m0039","start":39,"end":41,"surface":"懷慰","kind":"person","person_id":"m1k_249_ywq","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p015:m0043","start":43,"end":46,"surface":"桂陽王","kind":"person","person_id":"fjv_3dz_w0m","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p015:m0053","start":53,"end":55,"surface":"乘民","kind":"person","person_id":"22z_on9_kym","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p015:m0062","start":62,"end":64,"surface":"懷慰","kind":"person","person_id":"m1k_249_ywq","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-053-local-officials-complete","book_id":"b-nanqishu-053","work_id":"w-nanqishu","source_id":"s-nanqishu-053-local-officials-complete-ws1501803"},{"id":"c-nanqishu-053-local-officials-complete:p016","text":"　　復除邵陵王南中郎參軍，廣德令，尚書駕部郎。懷慰宗從善明等，太祖心腹，懷慰亦豫焉。沈攸之有舊，令爲書戒喻攸之，太祖省之稱善。除步兵校尉。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":50,"last_line":50,"raw_start":2258,"raw_end":2327,"raw_character_offsets":[2258,2259,2260,2261,2262,2263,2264,2265,2266,2267,2268,2269,2270,2271,2272,2273,2274,2275,2276,2277,2278,2279,2280,2281,2282,2283,2284,2285,2286,2287,2288,2289,2290,2291,2292,2293,2294,2295,2296,2297,2298,2299,2300,2301,2302,2303,2304,2305,2306,2307,2308,2309,2310,2311,2312,2313,2314,2315,2316,2317,2318,2319,2320,2321,2322,2323,2324,2325,2326],"revision_id":1501803},"mentions":[{"id":"c-nanqishu-053-local-officials-complete:p016:m0023","start":23,"end":25,"surface":"懷慰","kind":"person","person_id":"m1k_249_ywq","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p016:m0027","start":27,"end":29,"surface":"善明","kind":"person","person_id":"xit_xwj_dyh","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p016:m0031","start":31,"end":33,"surface":"太祖","kind":"person","person_id":"47p_kjh_ez7","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p016:m0036","start":36,"end":38,"surface":"懷慰","kind":"person","person_id":"m1k_249_ywq","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p016:m0042","start":42,"end":45,"surface":"沈攸之","kind":"person","person_id":"16c_0og_lvl_A","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p016:m0053","start":53,"end":55,"surface":"攸之","kind":"person","person_id":"16c_0og_lvl_A","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p016:m0056","start":56,"end":58,"surface":"太祖","kind":"person","person_id":"47p_kjh_ez7","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-053-local-officials-complete","book_id":"b-nanqishu-053","work_id":"w-nanqishu","source_id":"s-nanqishu-053-local-officials-complete-ws1501803"},{"id":"c-nanqishu-053-local-officials-complete:p017","text":"　　齊國建，上欲置齊郡於京邑，議者以江右土沃，流民所歸，乃治瓜步，以懷慰爲輔國將軍、齊郡太守。上謂懷慰曰：「齊邦是王業所基，吾方以爲顯任。經理之事，一以委卿。」又手勑曰：「有文事者，必有武備。今賜卿玉環刀一口。」懷慰至郡，修治城郭，安集居民，墾廢田二百頃，決沈湖灌溉。不受禮謁，民有餉其新米一斛者，懷慰出所食麥飯示之，曰：「旦食有餘，幸不煩此。」因著《廉吏論》以達其意。太祖聞之，手勑褒賞。進督秦、沛二郡。妻子在都，賜米三百斛。兖州刺史柳世隆與懷慰書曰：「膠東淵化，潁川致美，以今方古，曾何足云。」在郡二年，遷正員郎，領青冀二州中正。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":52,"last_line":52,"raw_start":2329,"raw_end":2596,"raw_character_offsets":[2329,2330,2331,2332,2333,2334,2335,2336,2337,2338,2339,2340,2341,2342,2343,2344,2345,2346,2347,2348,2349,2350,2351,2352,2353,2354,2355,2356,2357,2358,2359,2360,2361,2362,2363,2364,2365,2366,2367,2368,2369,2370,2