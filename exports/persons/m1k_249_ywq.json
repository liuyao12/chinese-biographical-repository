nterpretation_cases":[],"source_reading_cases":[{"id":"c-nanqishu-053-local-officials-complete:source_review15-0","kind":"source_review","person_id":"m1k_249_ywq","source_quote":"　　劉懷慰字彥泰，平原平原人也。祖奉伯，元嘉中，爲冠軍長史。父乘民，冀州刺史。懷慰初爲桂陽王征北板行參軍。乘民死於義嘉事難，懷慰持喪，不食醯醬，冬月不絮衣。養孤弟妹，事寡叔母，皆有恩義。","reading":"標題寫劉懷尉，正文劉懷慰字彥泰。祖奉伯，父乘民。南史父名避諱作乘人。","note":"標題寫劉懷尉，正文劉懷慰字彥泰。祖奉伯，父乘民。南史父名避諱作乘人。","paragraph_id":"c-nanqishu-053-local-officials-complete:p015","start_codepoint":0,"end_codepoint":93,"human_reviewed":false,"chapter_id":"c-nanqishu-053-local-officials-complete","source_id":"s-nanqishu-053-local-officials-complete-ws1501803"},{"id":"c-nanqishu-053-local-officials-complete:source_review16-0","kind":"source_review","person_id":"m1k_249_ywq","source_quote":"　　復除邵陵王南中郎參軍，廣德令，尚書駕部郎。懷慰宗從善明等，太祖心腹，懷慰亦豫焉。沈攸之有舊，令爲書戒喻攸之，太祖省之稱善。除步兵校尉。","reading":"宗從善明為同族，與北魏聘梁劉善明分案。寫書勸戒沈攸之的時序仍照原段。","note":"宗從善明為同族，與北魏聘梁劉善明分案。寫書勸戒沈攸之的時序仍照原段。","paragraph_id":"c-nanqishu-053-local-officials-complete:p016","start_codepoint":0,"end_codepoint":69,"human_reviewed":false,"chapter_id":"c-nanqishu-053-local-officials-complete","source_id":"s-nanqishu-053-local-officials-complete-ws1501803"},{"id":"c-nanqishu-053-local-officials-complete:source_review17-0","kind":"source_review","person_id":"m1k_249_ywq","source_quote":"　　齊國建，上欲置齊郡於京邑，議者以江右土沃，流民所歸，乃治瓜步，以懷慰爲輔國將軍、齊郡太守。上謂懷慰曰：「齊邦是王業所基，吾方以爲顯任。經理之事，一以委卿。」又手勑曰：「有文事者，必有武備。今賜卿玉環刀一口。」懷慰至郡，修治城郭，安集居民，墾廢田二百頃，決沈湖灌溉。不受禮謁，民有餉其新米一斛者，懷慰出所食麥飯示之，曰：「旦食有餘，幸不煩此。」因著《廉吏論》以達其意。太祖聞之，手勑褒賞。進督秦、沛二郡。妻子在都，賜米三百斛。兖州刺史柳世隆與懷慰書曰：「膠東淵化，潁川致美，以今方古，曾何足云。」在郡二年，遷正員郎，領青冀二州中正。","reading":"劉懷慰修城、開田、辭米，著廉吏論。原文賜妻子米三百斛，南史三百石。","note":"劉懷慰修城、開田、辭米，著廉吏論。原文賜妻子米三百斛，南史三百石。","paragraph_id":"c-nanqishu-053-local-officials-complete:p017","start_codepoint":0,"end_codepoint":267,"human_reviewed":false,"chapter_id":"c-nanqishu-053-local-officials-complete","source_id":"s-nanqishu-053-local-officials-complete-ws1501803"},{"id":"c-nanqishu-053-local-officials-complete:source_review18-0","kind":"source_review","person_id":"m1k_249_ywq","source_quote":"　　懷慰本名聞慰，世祖卽位，以與舅氏名同，勑改之。出監東陽郡，爲吏民所安。還兼安陸王北中郎司馬。永明九年，卒。年四十五。明帝卽位，謂僕射徐孝嗣曰：「劉懷慰若在，朝廷不憂無清吏也。」懷慰與濟陽江淹、陳郡袁彖善，亦著文翰。永明初，獻《皇德論》云。","reading":"聞慰是本名，齊世祖因與舅氏同名改之。永明九年卒，年四十五，無舅名。","note":"聞慰是本名，齊世祖因與舅氏同名改之。永明九年卒，年四十五，無舅名。","paragraph_id":"c-nanqishu-053-local-officials-complete:p018","start_codepoint":0,"end_codepoint":121,"human_reviewed":false,"chapter_id":"c-nanqishu-053-local-officials-complete","source_id":"s-nanqishu-053-local-officials-complete-ws1501803"},{"id":"c-nanqishu-053-local-officials-complete:variant_review15-2","kind":"variant_review","person_id":"m1k_249_ywq","source_quote":"劉懷慰字彥泰","reading":"標題劉懷尉，正文懷慰，南史字彦泰、舊名聞慰，從正文立目。","note":"標題劉懷尉，正文懷慰，南史字彦泰、舊名聞慰，從正文立目。","paragraph_id":"c-nanqishu-053-local-officials-complete:p015","start_codepoint":2,"end_codepoint":8,"human_reviewed":false,"chapter_id":"c-nanqishu-053-local-officials-complete","source_id":"s-nanqishu-053-local-officials-complete-ws1501803"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-qi053-liuhuaiwei-grandfather","subject_person_id":"m1k_249_ywq","object_person_id":"m27_39f_89l","predicate":"grandfather","qualifiers":{"source_term":"祖奉伯","lineage":"paternal"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-053","chapter_id":"c-nanqishu-053-local-officials-complete","source_id":"s-nanqishu-053-local-officials-complete-ws1501803","paragraph_id":"c-nanqishu-053-local-officials-complete:p015","quote":"　　劉懷慰字彥泰，平原平原人也。祖奉伯，元嘉中，爲冠軍長史。父乘民，冀州刺史。懷慰初爲桂陽王征北板行參軍。乘民死於義嘉事難，懷慰持喪，不食醯醬，冬月不絮衣。養孤弟妹，事寡叔母，皆有恩義。","subject_person_mention_id":"c-nanqishu-053-local-officials-complete:p015:m0002","object_person_mention_id":"c-nanqishu-053-local-officials-complete:p015:m0017"}],"status":"source_attested","interpretation_note":"祖元嘉冠軍長史。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"a-qi053-liuhuaiwei-father","subject_person_id":"m1k_249_ywq","object_person_id":"22z_on9_kym","predicate":"father","qualifiers":{"source_term":"父乘民","lineage":"paterna