{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000425","identity_policy":"contextual_provisional","person_ids":["cbr-p000425"],"persons":[{"id":"cbr-p000425","label":"申包胥","status":"active","historicity":"historical_tradition","aliases":[{"surface":"申包胥","mention_ids":["c-shiji-005-qin:m044-0122"]}],"evidence":[{"mention_id":"c-shiji-005-qin:m044-0122","chapter_id":"c-shiji-005-qin","paragraph_id":"c-shiji-005-qin:p044","quote":"申包胥"}],"identity_note":"依本卷特定時代與事件暫定人物；不以同稱、官號或短名全域合併，未見本名不補造。","review":"ai_provisional"}],"source_mention_summary":[{"source_id":"s-shiji-005-qin","work_id":"w-shiji","book_id":"b-shiji-005","chapter_id":"c-shiji-005-qin","mention_count":1,"mention_ids":["c-shiji-005-qin:m044-0122"],"paragraph_ids":["c-shiji-005-qin:p044"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-005-qin"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-005-qin:m044-0122","start":122,"end":125,"surface":"申包胥","kind":"person","person_id":"cbr-p000425","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p044","chapter_id":"c-shiji-005-qin"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-005-qin:p044","text":"哀公八年，楚公子棄疾弒靈王而自立，是為平王。十一年，楚平王來求秦女為太子建妻。至國，女好而自娶之。十五年，楚平王欲誅建，建亡；伍子胥奔吳。晉公室卑而六卿彊，欲內相攻，是以久秦晉不相攻。三十一年，吳王闔閭與伍子胥伐楚，楚王亡奔隨，吳遂入郢。楚大夫申包胥來告急，七日不食，日夜哭泣。於是秦乃發五百乘救楚，敗吳師。吳師歸，楚昭王乃得復入郢。哀公立三十六年卒。太子夷公，夷公蚤死，不得立，立夷公子，是為惠公。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m044-0000","start":0,"end":2,"surface":"哀公","kind":"person","person_id":"cbr-p000420","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m044-0005","start":5,"end":10,"surface":"楚公子棄疾","kind":"person","person_id":"c