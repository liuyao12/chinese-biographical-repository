ional","evidence":[{"paragraph_id":"c-shiji-032-qi:p009","quote":"蓋太公之卒百有餘年，子丁公呂伋立。丁公卒，子乙公得立。乙公卒，子癸公慈母立。癸公卒，子哀公不辰立。"}],"rationale":"按本篇周初、呂尚／師尚父、齊君世系及魯桓公遇害等明示語境暫定異稱，原字與所列或曰異說保留，不按全庫同名合併。先君太公引語未連到呂尚。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji040-075","person_id":"cbr-p001082","surfaces":["齊太公子呂伋"],"scope":"cross_chapter","chapter_ids":["c-shiji-032-qi","c-shiji-040-chu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-032-qi:p009","quote":"蓋太公之卒百有餘年，子丁公呂伋立。丁公卒，子乙公得立。乙公卒，子癸公慈母立。癸公卒，子哀公不辰立。"},{"paragraph_id":"c-shiji-040-chu:p003","quote":"周文王之時，季連之苗裔曰鬻熊。鬻熊子事文王，蚤卒。其子曰熊麗。熊麗生熊狂，熊狂生熊繹。熊繹當周成王之時，舉文、武勤勞之後嗣，而封熊繹於楚蠻，封以子男之田，姓羋氏，居丹陽。楚子熊繹與魯公伯禽、衞康叔子牟、晉侯燮、齊太公子呂伋倶事成王。"}],"rationale":"楚篇明稱齊太公子呂伋，與齊篇太公子丁公呂伋的父子與名稱敘事暫同指。 未由同名泛推全庫、也未用此段校定共同任職年代。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-032-qi:p009","text":"蓋太公之卒百有餘年，子丁公呂伋立。丁公卒，子乙公得立。乙公卒，子癸公慈母立。癸公卒，子哀公不辰立。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-032-qi:m009-0001","start":1,"end":3,"surface":"太公","kind":"person","person_id":"cbr-p000183","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m009-0011","start":11,"end":15,"surface":"丁公呂伋","kind":"person","person_id":"cbr-p001082","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m009-0017","start":17,"end":19,"surface":"丁公","kind":"person","person_id":"cbr-p001082","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m009-0022","start":22,"end":25,"surface":"乙公得","kind":"person","person_id":"cbr-p001083","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m009-0027","start":27,"end":29,"surface":"乙公","kind":"person","person_id":"cbr-p001083","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m009-0032","start":32,"end":36,"surface":"癸公慈母","kind":"person","person_id":"cbr-p001084","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m009-0038","start":38,"end":40,"surface":"癸公","kind":"person","person_id":"cbr-p001084","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m009-0043","start":43,"end":47,"surface":"哀公不辰","kind":"person","person_id":"cbr-p001085","status":"contextual_provisional"}],"chapter_id":"c-shiji-032-qi","book_id":"b-shiji-032","work_id":"w-shiji","source_id":"s-shiji-032-qi"},{"id":"c-shiji-040-chu:p003","text":"周文王之時，季連之苗裔曰鬻熊。鬻熊子事文王，蚤卒。其子曰熊麗。熊麗生熊狂，熊狂生熊繹。熊繹當周成王之時，舉文、武勤勞之後嗣，而封熊繹於楚蠻，封以子男之田，姓羋氏，居丹陽。楚子熊繹與魯公伯禽、衞康叔子牟、晉侯燮、齊太公子呂伋倶事成王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m003-0000","start":0,"end":3,"surface":"周文王","kind":"person","person_id":"cbr-p000139","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m003-0006","start":6,"end":8,"surface":"季連","kind":"person","person_id":"cbr-p001851","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m003-0012","start":12,"end":14,"surface":"鬻熊","kind":"person","person_id":"cbr-p001854","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m003-0015","start":15,"end":17,"surface":"鬻熊","kind":"person","person_id":"cbr-p001854","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m003-0019","start":19,"end":21,"surface":"文王","kind":"person","person_id":"cbr-p000139","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m003-0028","start":28,"end":30,"surface":"熊麗","kind":"person","person_id":"cbr-p001855","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m003-0031","start":31,"end":33,"surface":"熊麗","kind":"person","person_id":"cbr-p001855","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m003-0034","start":34,"end":36,"surface":"熊狂","kind":"person","person_id":"cbr-p001856","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m003-0037","start":37,"end":39,"surface":"熊狂","kind":"person","person_id":"cbr-p001856","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m003-0040","start":40,"end":42,"surface":"熊繹","kind":"person","person_id":"cbr-p001857","status":"contextual_provisional"},{"id":"c-shiji-040-chu