ntion_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-064-simaxi-ws2622004","s-jinshu-098-ws2614273"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-w098-succ-cao","person_id":"lm0_d0g_jn1","event_type":"death","source_term":"誅庾倩、殷涓、曹秀等","date_expression":null,"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-098","chapter_id":"c-jinshu-098-huanwen","source_id":"s-jinshu-098-ws2614273","paragraph_id":"c-jinshu-098-huanwen:p024","quote":"溫既負其才力，久懷異志，欲先立功河朔，還受九錫。既逢覆敗，名實頓減，於是參軍郗超進廢立之計，溫乃廢帝而立簡文帝。詔溫依諸葛亮故事，甲仗百人入殿，賜錢五千萬，絹二萬匹，布十萬匹。溫多所廢徒，誅庾倩、殷涓、曹秀等。是時溫威勢翕赫，侍中謝安見而遙拜，溫驚曰：「安石，卿何事乃爾！」安曰：「未有君拜於前，臣揖於後。」時溫有腳疾，詔乘輿入朝，既見，欲陳廢立本意，帝便泣下數十行，溫兢懼，不得一言而出。","person_mention_id":"c-jinshu-098-huanwen:p024:m0101"}],"interpretation_note":"依本來源登記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-jinshu-064-simaxi:p002:m0177","surface":"曹秀","start":177,"end":179,"person_id":"lm0_d0g_jn1","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-064-simaxi:p002","chapter_id":"c-jinshu-064-simaxi"},{"id":"c-jinshu-098-huanwen:p024:m0101","start":101,"end":103,"surface":"曹秀","kind":"person","person_id":"lm0_d0g_jn1","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。","paragraph_id":"c-jinshu-098-huanwen:p024","chapter_id":"c-jinshu-098-huanwen"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-064-simaxi:p002","text":"晞無學術而有武幹，為桓溫所忌。及簡文帝即位，溫乃表晞曰：「晞體自皇極，故寵靈光世，不能率由王度，修己慎行，而聚納輕剽，苞藏亡命。又息綜矜忍，虐加於人。袁真叛逆，事相連染。頃自猜懼，將成亂階。請免晞官，以王歸籓，免其世子綜官，解子㻱散騎常侍。」㻱以梁王隨晞，晞既見黜，送馬八十五匹、三百人杖以歸溫。溫又逼新蔡王晃使自誣與晞、綜及著作郎殷涓、太宰長史庾倩、掾曹秀、舍人劉彊等謀逆，遂收付廷尉，請誅之。簡文帝不許，溫於是奏徙新安郡，家屬悉從之，而族誅殷涓等，廢晃徙沖陽郡。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":79,"last_line":79,"raw_start":4555,"raw_end":4927,"raw_character_offsets":[4557,4558,4559,4560,4561,4562,4563,4564,4565,4566,4567,4568,4569,4570,4571,4572,4573,4574,4575,4576,4577,4578,4579,4580,4581,4582,4583,4584,4585,4586,4587,4588,4589,4590,4591,4592,4593,4594,4595,4596,4597,4598,4599,4600,4601,4602,4603,4604,4605,4606,4607,4608,4609,4610,4611,4612,4613,4614,4615,4616,4617,4618,4619,4620,4621,4622,4623,4624,4625,4666,4667,4668,4669,4670,4671,4672,4673,4674,4675,4676,4677,4678,4679,4680,4681,4682,4683,4684,4685,4686,4687,4688,4689,4690,4691,4692,4693,4694,4695,4696,4697,4698,4699,4700,4701,4702,4703,4704,4705,4706,4707,4708,4709,4710,4711,4712,4713,4714,4715,4716,4717,4718,4719,4720,4721,4722,4723,4724,4725,4726,4727,4728,4729,4730,4731,4732,4733,4734,4735,4736,4737,4738,4739,4740,4741,4742,4743,4744,4745,4746,4747,4748,4749,4750,4751,4752,4753,4754,4755,4756,4757,4758,4759,4760,4761,4762,4763,4764,4765,4766,4767,4768,4769,4770,4771,4869,4870,4871,4872,4873,4874,4875,4876,4877,4878,4879,4880,4881,4882,4883,4884,4885,4886,4887,4888,4889,4890,4891,4892,4893,4894,4895,4896,4897,4898,4899,4900,4901,4902,4903,4904,4905,4906,4907,4908,4909,4910,4911,4912,4913,4914,4915,4916,491