tart":305,"end":307,"surface":"憲王","kind":"person","person_id":"cbr-p003602","status":"contextual_provisional","paragraph_id":"c-shiji-059-wuzong:p033","chapter_id":"c-shiji-059-wuzong"},{"id":"c-shiji-059-wuzong:m034-0029","start":29,"end":33,"surface":"常山憲王","kind":"person","person_id":"cbr-p003602","status":"contextual_provisional","paragraph_id":"c-shiji-059-wuzong:p034","chapter_id":"c-shiji-059-wuzong"},{"id":"c-shiji-059-wuzong:m034-0061","start":61,"end":63,"surface":"憲王","kind":"person","person_id":"cbr-p003602","status":"contextual_provisional","paragraph_id":"c-shiji-059-wuzong:p034","chapter_id":"c-shiji-059-wuzong"},{"id":"c-shiji-059-wuzong:m035-0010","start":10,"end":14,"surface":"常山憲王","kind":"person","person_id":"cbr-p003602","status":"contextual_provisional","paragraph_id":"c-shiji-059-wuzong:p035","chapter_id":"c-shiji-059-wuzong"},{"id":"c-shiji-059-wuzong:m036-0012","start":12,"end":16,"surface":"常山憲王","kind":"person","person_id":"cbr-p003602","status":"contextual_provisional","paragraph_id":"c-shiji-059-wuzong:p036","chapter_id":"c-shiji-059-wuzong"}],"relations":[{"id":"a-shiji059-025","subject_person_id":"cbr-p003602","predicate":"father","object_person_id":"cbr-p003584","status":"source_attested","evidence":[{"chapter_id":"c-shiji-059-wuzong","source_id":"s-shiji-059-wuzong","paragraph_id":"c-shiji-059-wuzong:p001","quote":"孝景皇帝子凡十三人為王，而母五人，同母者為宗親。栗姬子曰榮、德、閼于。程姬子曰餘、非、端。賈夫人子曰彭祖、勝。唐姬子曰發。王夫人兒姁子曰越、寄、乘、舜。"}],"qualifiers":{"source_term":"孝景皇帝子凡十三人為王","historicity":"historical_tradition"},"interpretation_note":"依明示子、生、母與局部世系主語保存，不因繼位或太子稱本身補父子，不補未名成員及同父同母。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji059-026","subject_person_id":"cbr-p003602","predicate":"mother","object_person_id":"cbr-p003589","status":"source_attested","evidence":[{"chapter_id":"c-shiji-059-wuzong","source_id":"s-shiji-059-wuzong","paragraph_id":"c-shiji-059-wuzong:p001","quote":"孝景皇帝子凡十三人為王，而母五人，同母者為宗親。栗姬子曰榮、德、閼于。程姬子曰餘、非、端。賈夫人子曰彭祖、勝。唐姬子曰發。王夫人兒姁子曰越、寄、乘、舜。"}],"qualifiers":{"source_term":"王夫人兒姁子曰","historicity":"historical_tradition"},"interpretation_note":"依明示子、生、母與局部世系主語保存，不因繼位或太子稱本身補父子，不補未名成員及同父同母。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji059-040","subject_person_id":"cbr-p003624","predicate":"father","object_person_id":"cbr-p003602","status":"source_attested","evidence":[{"chapter_id":"c-shiji-059-wuzong","source_id":"s-shiji-059-wuzong","paragraph_id":"c-shiji-059-wuzong:p033","quote":"初，憲王舜有所不愛姬生長男棁。棁以母無寵故，亦不得幸於王。王後修生太子勃。王內多，所幸姬生子平、子商，王后希得幸。及憲王病甚，諸幸姬常侍病，故王后亦以妒媢不常侍病，輒歸舍。醫進藥，太子勃不自嘗藥，又不宿留侍病。及王薨，王后、太子乃至。憲王雅不以長子棁為人數，及薨，又不分與財物。郎或說太子、王后，令諸子與長子棁共分財物，太子、王后不聽。太子代立，又不收恤棁。棁怨王后、太子。漢使者視憲王喪，棁自言憲王病時，王后、太子不侍，及薨，六日出舍，太子勃私姦，飲酒，博戲，擊筑，與女子載馳，環城過市，入牢視囚。天子遣大行騫驗王后及問王勃，請逮勃所與姦諸證左，王又匿之。吏求捕勃大急，使人致擊笞掠，擅出漢所疑囚者。有司請誅憲王後修及王勃。上以修素無行，使棁陷之罪，勃無良師傅，不忍誅。有司請廢王後修，徙王勃以家屬處房陵，上許之。"}],"qualifiers":{"source_term":"憲王舜有所不愛姬生長男棁","historicity":"historical_tradition"},"interpretation_note":"依明示子、生、母與局部世系主語保存，不因繼位或太子稱本身補父子，不補未名成員及同父同母。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji059-041","subject_person_id":"cbr-p003626","predicate":"father","object_person_id":"cbr-p003602","status":"source_attested","evidence":[{"chapter_id":"c-shiji-059-wuzong","source_id":"s-shiji-059-wuzong","paragraph_id":"c-shiji-059-wuzong:p034","quote":"勃王數月，遷于房陵，國絕。月餘，天子為最親，乃詔有司曰：「常山憲王蚤夭，后妾不和，適孽誣爭，陷于不義以滅國，朕甚閔焉。其封憲王子平三萬戶，為真定王；封子商三萬戶，為泗水王。」"}],"qualifiers":{"source_term":"封憲王子平","historicity":"historical_tradition"},"interpretation_note":"依明示子、生、母與局部世系主語保存，不因繼位或太子稱本身補父子，不補未名成員及同父同母。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji059-042","subject_person_id":"cbr-p003627","predicate":"father","object_person_id":"cbr-p003602","status":"source_attested","evidence":[{"chapter_id":"c-shiji-059-wuzong","source_id":"s-shiji-059-wuzong","paragraph_id":"c-shiji-059-wuzong:p034","quote":"勃王數月，遷于房陵，國絕。月餘，天子為最親，乃詔有司曰：「常山憲王蚤夭，后妾不和，適孽誣爭，陷于不義以滅國，朕甚閔焉。其封憲王子平三萬戶，為真定王；封子商三萬戶，為泗水王。」"}],"qualifiers":{"source_term":"封子商","historicity":"historical_tradition"},"interpretation_note":"依明示子、生、母與局部世系主語保存，不因繼位或太子稱本身補父子，不補未名成員及同父同母。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji059-045","subject_person_id":"cbr-p003602","predicate":"spouse","object_person_id":"cbr-p003625","status":"source_attested","evidence":[{"chapter_id":"c-shiji-059-wuzong","source_id":"s-shiji-059-wuzong","paragraph_id":"c-shiji-059-wuzong:p033","quote":"初，憲王舜有所不愛姬生長男棁。棁以母無寵故，亦不得幸於王。王後修生太子勃。王內多，所幸姬生子平、子商，王后希得幸。及憲王病甚，諸幸姬常侍病，故王后亦以妒媢不常侍病，輒歸舍。醫進藥，太子勃不自嘗藥，又不宿留侍病。及王薨，王后、太子乃至。憲王雅不以長子棁為人數，及薨，又不分與財物。郎或說太子、王后，令諸子與長子棁共分財物，太子、王后不聽。太子代立，又不收恤棁。棁怨王后、太子。漢使者視憲王喪，棁自言憲王病時，王后、太子不侍，及薨，六日出舍，太子勃私姦，飲酒，博戲，擊筑，與女子載馳，環城過市，入牢視囚。天子遣大行騫驗王后及問王勃，請逮勃所與姦諸證左，王又匿之。吏求捕勃大急，使人致擊笞掠，擅出漢所疑囚者。有司請誅憲王後修及王勃。上以修素無行，使棁陷之罪，勃無良師傅，不忍誅。有司請廢王後修，徙王勃以家屬處房陵，上許之。"}],"qualifiers":{"source_term":"王後修","historicity":"historical_tradition"},"interpretation_note":"依明示子、生、母與局部世系主語保存，不因繼位或太子稱本身補父子，不補未名成員及同父同母。王后稱位與舜之宮內生子敘事相連；不由此補其他妃姬婚制。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji059-054","person_id":"cbr-p003602","title":"常山憲王","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-059-wuzong","source_id":"s-shiji-059-wuzong","paragraph_id":"c-shiji-059-wuzong:p032","quote":"常山憲王舜，以孝景中五年用皇子為常山王。舜最親，景帝少子，驕怠多淫，數犯禁，上常寬釋之。立三十二年卒，太子勃代立為王。"}],"attestations":[{"id":"th-shiji059-054:a001","paragraph_id":"c-shiji-059-wuzong:p032","start":0,"end":4,"surface":"常山憲王","person_mention_id":"c-shiji-059-wuzong:m032-0000","usage":"retrospective"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"來源授封、徙封、承爵、職位與用稱分存；相對年數保持原語，不換算公曆或由死亡、首次提及補起訖。王號中的諡字不當生前正式授爵名。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji059-055","person_id":"cbr-p003602","title":"常山王","kind":"royal_rank","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-059-wuzong","source_id":"s-shiji-059-wuzong","paragraph_id":"c-shiji-059-wuzong:p032","quote":"常山憲王舜，以孝景中五年用皇子為常山王。舜最親，景帝少子，驕怠多淫，數犯禁，上常寬釋之。立三十二年卒，太子勃代立為王。"}],"attestations":[{"id":"th-shiji059-055:a001","paragraph_id":"c-shiji-059-wuzong:p032","start":16,"end":19,"surface":"常山王","person_mention_id":"c-shiji-059-wuzong:m032-0016","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":"孝景中五年","evidence":[{"chapter_id":"c-shiji-059-wuzong","source_id":"s-shiji-059-wuzong","paragraph_id":"c-shiji-059-wuzong:p032","quote":"常山憲王舜，以孝景中五年用皇子為常山王。舜最親，景帝少子，驕怠多淫，數犯禁，上常寬釋之。立三十二年卒，太子勃代立為王。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"來源授封、徙封、承爵、職位與用稱分存；相對年數保持原語，不換算公曆或由死亡、首次提及補起訖。王號中的諡字不當生前正式授爵名。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji059-019","person_id":"cbr-p003602","surfaces":["常山憲王","常山憲王舜","常山王","憲王","憲王舜","舜"],"scope":"same_chapter","chapter_ids":["c-shiji-059-wuzong"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-059-wuzong:p001","quote":"孝景皇帝子凡十三人為王，而母五人，同母者為宗親。栗姬子曰榮、德、閼于。程姬子曰餘、非、端。賈夫人子曰彭祖、勝。唐姬子曰發。王夫人兒姁子曰越、寄、乘、舜。"},{"paragraph_id":"c-shiji-059-wuzong:p032","quote":"常山憲王舜，以孝景中五年用皇子為常山王。舜最親，景帝少子，驕怠多淫，數犯禁，上常寬釋之。立三十二年卒，太子勃代立為王。"},{"paragraph_id":"c-shiji-059-wuzong:p033","quote":"初，憲王舜有所不愛姬生長男棁。棁以母無寵故，亦不得幸於王。王後修生太子勃。王內多，所幸姬生子平、子商，王后希得幸。及憲王病甚，諸幸姬常侍病，故王后亦以妒媢不常侍病，輒歸舍。醫進藥，太子勃不自嘗藥，又不宿留侍病。及王薨，王后、太子乃至。憲王雅不以長子棁為人數，及薨，又不分與財物。郎或說太子、王后，令諸子與長子棁共分財物，太子、王后不聽。太子代立，又不收恤棁。棁怨王后、太子。漢使者視憲王喪，棁自言憲王病時，王后、太子不侍，及薨，六日出舍，太子勃私姦，飲酒，博戲，擊筑，與女子載馳，環城過市，入牢視囚。天子遣大行騫驗王后及問王勃，請逮勃所與姦諸證左，王又匿之。吏求捕勃大急，使人致擊笞掠，擅出漢所疑囚者。有司請誅憲王後修及王勃。上以修素無行，使棁陷之罪，勃無良師傅，不忍誅。有司請廢王後修，徙王勃以家屬處房陵，上許之。"},{"paragraph_id":"c-shiji-059-wuzong:p034","quote":"勃王數月，遷于房陵，國絕。月餘，天子為最親，乃詔有司曰：「常山憲王蚤夭，后妾不和，適孽誣爭，陷于不義以滅國，朕甚閔焉。其封憲王子平三萬戶，為真定王；封子商三萬戶，為泗水王。」"},{"paragraph_id":"c-shiji-059-wuzong:p035","quote":"真定王平，元鼎四年用常山憲王子為真定王。"},{"paragraph_id":"c-shiji-059-wuzong:p036","quote":"泗水思王商，以元鼎四年用常山憲王子為泗水王。十一年卒，子哀王安世立。十一年卒，無子。於是上憐泗水王絕，乃立安世弟賀為泗水王。"}],"rationale":"依明示姓名、母子世系、局部王系及承爵敘事暫接；同名慶分支保存，王號不跨世代或支系套用，名非不當普通否定詞。未名皇帝、群體、指控與制度職稱不補事實；版本、跨篇與有效時段待覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji059-shun","person_ids":["cbr-p000955","cbr-p003602"],"canonical_person_id":"cbr-p000955","scope":"cross_chapter","chapter_ids":["c-shiji-011-jingdi","c-shiji-059-wuzong"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-011-jingdi","source_id":"s-shiji-011-jingdi","paragraph_id":"c-shiji-011-jingdi:p013","quote":"中五年夏，立皇子舜為常山王。封十侯。六月丁巳，赦天下，賜爵一級。天下大潦。更命諸侯丞相曰相。秋，地動。","mention_ids":["c-shiji-011-jingdi:m013-0006"]},{"chapter_id":"c-shiji-059-wuzong","source_id":"s-shiji-059-wuzong","paragraph_id":"c-shiji-059-wuzong:p032","quote":"常山憲王舜，以孝景中五年用皇子為常山王。舜最親，景帝少子，驕怠多淫，數犯禁，上常寬釋之。立三十二年卒，太子勃代立為王。","mention_ids":["c-shiji-059-wuzong:m032-0000","c-shiji-059-wuzong:m032-0016","c-shiji-059-wuzong:m032-0020"]}],"rationale":"同記孝景中五年皇子舜為常山王，本篇常山憲王舜及景帝少子與授封事件相配，不接上古舜。 原ID與各篇文字保留，身份暫接不統一年數、王國細節或史實優先；同書各篇不作獨立見證。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-011-jingdi:p013","text":"中五年夏，立皇子舜為常山王。封十侯。六月丁巳，赦天下，賜爵一級。天下大潦。更命諸侯丞相曰相。秋，地動。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-011-jingdi:m013-0006","start":6,"end":9,"surface":"皇子舜","kind":"person","person_id":"cbr-p000955","status":"contextual_provisional"}],"chapter_id":"c-shiji-011-jingdi","book_id":"b-shiji-011","work_id":"w-shiji","source_id":"s-shiji-011-jingdi"},{"id":"c-shiji-059-wuzong:p001","text":"孝景皇帝子凡十三人為王，而母五人，同母者為宗親。栗姬子曰榮、德、閼于。程姬子曰餘、非、端。賈夫人子曰彭祖、勝。唐姬子曰發。王夫人兒姁子曰越、寄、乘、舜。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-059-wuzong:m001-0000","start":0,"end":4,"surface":"孝景皇帝","kind":"person","person_id":"cbr-p003584","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m001-0006","start":6,"end":9,"surface":"十三人","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、未名皇帝或未定指代；不補未見姓名、親屬成員或確定身份。"},{"id":"c-shiji-059-wuzong:m001-0013","start":13