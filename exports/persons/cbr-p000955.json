ovisional"},{"id":"c-shiji-059-wuzong:m034-0070","start":70,"end":73,"surface":"真定王","kind":"person","person_id":"cbr-p003626","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m034-0076","start":76,"end":77,"surface":"商","kind":"person","person_id":"cbr-p003627","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m034-0082","start":82,"end":85,"surface":"泗水王","kind":"person","person_id":"cbr-p003627","status":"contextual_provisional"}],"chapter_id":"c-shiji-059-wuzong","book_id":"b-shiji-059","work_id":"w-shiji","source_id":"s-shiji-059-wuzong"},{"id":"c-shiji-059-wuzong:p035","text":"真定王平，元鼎四年用常山憲王子為真定王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-059-wuzong:m035-0000","start":0,"end":4,"surface":"真定王平","kind":"person","person_id":"cbr-p003626","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m035-0010","start":10,"end":14,"surface":"常山憲王","kind":"person","person_id":"cbr-p003602","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m035-0016","start":16,"end":19,"surface":"真定王","kind":"person","person_id":"cbr-p003626","status":"contextual_provisional"}],"chapter_id":"c-shiji-059-wuzong","book_id":"b-shiji-059","work_id":"w-shiji","source_id":"s-shiji-059-wuzong"},{"id":"c-shiji-059-wuzong:p036","text":"泗水思王商，以元鼎四年用常山憲王子為泗水王。十一年卒，子哀王安世立。十一年卒，無子。於是上憐泗水王絕，乃立安世弟賀為泗水王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-059-wuzong:m036-0000","start":0,"end":5,"surface":"泗水思王商","kind":"person","person_id":"cbr-p003627","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m036-0012","start":12,"end":16,"surface":"常山憲王","kind":"person","person_id":"cbr-p003602","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m036-0018","start":18,"end":21,"surface":"泗水王","kind":"person","person_id":"cbr-p003627","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m036-0028","start":28,"end":32,"surfa