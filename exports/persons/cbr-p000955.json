son","person_id":"cbr-p003598","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m001-0061","start":61,"end":66,"surface":"王夫人兒姁","kind":"person","person_id":"cbr-p003589","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m001-0068","start":68,"end":69,"surface":"越","kind":"person","person_id":"cbr-p003599","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m001-0070","start":70,"end":71,"surface":"寄","kind":"person","person_id":"cbr-p003600","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m001-0072","start":72,"end":73,"surface":"乘","kind":"person","person_id":"cbr-p003601","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m001-0074","start":74,"end":75,"surface":"舜","kind":"person","person_id":"cbr-p003602","status":"contextual_provisional"}],"chapter_id":"c-shiji-059-wuzong","book_id":"b-shiji-059","work_id":"w-shiji","source_id":"s-shiji-059-wuzong"},{"id":"c-shiji-059-wuzong:p032","text":"常山憲王舜，以孝景中五年用皇子為常山王。舜最親，景帝少子，驕怠多淫，數犯禁，上常寬釋之。立三十二年卒，太子勃代立為王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-059-wuzong:m032-0000","start":0,"end":5,"surface":"常山憲王舜","kind":"person","person_id":"cbr-p003602","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m032-0007","start":7,"end":9,"surface":"孝景","kind":"person","person_id":"cbr-p003584","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m032-0016","start":16,"end":19,"surface":"常山王","kind":"person","person_id":"cbr-p003602","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m032-0020","start":20,"end":21,"surface":"舜","kind":"person","person_id":"cbr-p003602","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m032-0024","start":24,"end":26,"surface":"景帝","kind":"person","person_id":"cbr-p003584","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m032-0038","start":38,"end":39,"surface":"上","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、未名皇帝或未定指代；不補未見姓名、親屬成員或確定身份。"},{"id":"c-shiji-059-wuzong:m032-0051","start":51,"end":54,"surface":"太子勃","kind":"person","person_id":"cbr-p003623","status":"contextual_provisional"}],"chapter_id":"c-shiji-059-wuzong","book_id":"b-shiji-059","work_id":"w-shiji","source_id":"s-shiji-059-wuzong"},{"id":"c-shiji-059-wuzong:p033","text":"初，憲王舜有所不愛姬生長男棁。棁以母無寵故，亦不得幸於王。王後修生太子勃。王內多，所幸姬生子平、子商，王后希得幸。及憲王病甚，諸幸姬常侍病，故王后亦以妒媢不常侍病，輒歸舍。醫進藥，太子勃不自嘗藥，又不宿留侍病。及王薨，王后、太子乃至。憲王雅不以長子棁為人數，及薨，又不分與財物。郎或說太子、王后，令諸子與長子棁共分財物，太子、王后不聽。太子代立，又不收恤棁。棁怨王后、太子。漢使者視憲王喪，棁自言憲王病時，王后、太子不侍，及薨，六日出舍，太子勃私姦，飲酒，博戲，擊筑，與女子載馳，環城過市，入牢視囚。天子遣大行騫驗王后及問王勃，請逮勃所與姦諸證左，王又匿之。吏求捕勃大急，使人致擊笞掠，擅出漢所疑囚者。有司請誅憲王後修及王勃。上以修素無行，使棁陷之罪，勃無良師傅，不忍誅。有司請廢王後修，徙王勃以家屬處房陵，上許之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-059-wuzong:m033-0002","start":2,"end":5,"surface":"憲王舜","kind":"person","person_id":"cbr-p003602","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m033-0007","start":7,"end":10,"surface":"不愛姬","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、未名皇帝或未定指代；不補未見姓名、親屬成員或確定身份。"},{"id":"c-shiji-059-wuzong:m033-0013","start":13,"end":14,"surface":"棁","kind":"person","person_id":"cbr-p003624","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m033-0015","start":15,"end":16,"surface":"棁","kind":"person","person_id":"cbr-p003624","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m033-0029","start":29,"end":32,"surface":"王後修","kind":"person","person_id":"cbr-p003625","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m033-0033","start":33,"end":36,"surface":"太子勃","kind":"person","person_id":"cbr-p003623","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m033-0041","start":41,"end":44,"surface":"所幸姬","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、未名皇帝或未定指代；不補未見姓名、親屬成員或確定身份。"},{"id":"c-shiji-059-wuzong:m033-0046","start":46,"end":47,"surface":"平","kind":"person","person_id"