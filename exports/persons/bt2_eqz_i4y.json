635,2636,2637,2638,2639,2640,2641,2642,2643,2644,2645,2646,2647,2648,2649,2650,2651,2652,2653,2654,2655,2656,2657,2658,2659,2660,2661,2662,2663,2664],"revision_id":1791560},"mentions":[{"id":"c-songshu-048-zhuchaoshi:p001:m0000","start":0,"end":2,"surface":"齡石","kind":"person","person_id":"wip_vh5_2zm_A","status":"contextual_provisional"},{"id":"c-songshu-048-zhuchaoshi:p001:m0003","start":3,"end":5,"surface":"超石","kind":"person","person_id":"92a_026_432","status":"contextual_provisional"},{"id":"c-songshu-048-zhuchaoshi:p001:m0026","start":26,"end":28,"surface":"桓謙","kind":"person","person_id":"u9s_w6j_8mc_AEB","status":"contextual_provisional"},{"id":"c-songshu-048-zhuchaoshi:p001:m0041","start":41,"end":44,"surface":"何無忌","kind":"person","person_id":"c9y_5dx_n1p","status":"contextual_provisional"},{"id":"c-songshu-048-zhuchaoshi:p001:m0051","start":51,"end":54,"surface":"徐道覆","kind":"person","person_id":"bt2_eqz_i4y","status":"contextual_provisional"},{"id":"c-songshu-048-zhuchaoshi:p001:m0055","start":55,"end":57,"surface":"無忌","kind":"person","person_id":"c9y_5dx_n1p","status":"contextual_provisional"},{"id":"c-songshu-048-zhuchaoshi:p001:m0059","start":59,"end":61,"surface":"超石","kind":"person","person_id":"92a_026_432","status":"contextual_provisional"},{"id":"c-songshu-048-zhuchaoshi:p001:m0071","start":71,"end":73,"surface":"超石","kind":"person","person_id":"92a_026_432","status":"contextual_provisional"},{"id":"c-songshu-048-zhuchaoshi:p001:m0099","start":99,"end":101,"surface":"超石","kind":"person","person_id":"92a_026_432","status":"contextual_provisional"},{"id":"c-songshu-048-zhuchaoshi:p001:m0103","start":103,"end":105,"surface":"桓謙","kind":"person","person_id":"u9s_w6j_8mc_AEB","status":"contextual_provisional"}],"chapter_id":"c-songshu-048-zhuchaoshi","book_id":"b-songshu-048","work_id":"w-songshu","source_id":"s-songshu-048-zhuchaoshi-ws1791560"},{"id":"c-songshu-092-wangzhenzhi-wyd:p002","text":"鎮之初為琅邪王衞軍行參軍出補剡上虞令並有能名內史謝輶請為山陰令復有殊績遷衞軍參軍本國郎中令加寧朔將軍桓𤣥輔晉以為大將軍録事參軍時三吳饑荒遣鎮之銜命賑卹而會稽內史王愉不奉符旨鎮之依事糺奏愉子綏𤣥之外甥當時貴盛鎮之為所排抑以母老求補安成太守及𤣥敗𤣥將苻宏寇亂郡境鎮之拒戰彌年子弟五人並臨陣見殺母憂去職在官清潔妻子無以自給乃棄家致喪還上虞舊基畢為子標之求安復令隨子之官服闋為征西道規司馬南平太守徐道覆逼江陵加鎮之建威將軍統檀道濟到彦之等討道覆以不經將帥固辭不見聽旣而前軍失利白衣領職尋復本官以討道覆功封華容縣五等男徵廷尉晉穆帝何皇后山陵領將作大匠遷御史中丞秉正不撓百寮憚之","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-songshu-092-wangzhenzhi-wyd:p002:m0000","start":0,"end":2,"surface":"鎮之","kind":"person","person_id":"7r6_k52_qji_ABDACAA","status":"contextual_provisional"},{"id":"c-songshu-092-wangzhenzhi-wyd:p002:u0004","start":4,"end":7,"surface":"琅邪王","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"待核首次府主身份"},{"id":"c-songshu-092-wangzhenzhi-wyd:p002:m0024","start":24,"end":26,"surface":"謝輶","kind":"person","person_id":"ao0_c0z_ryc","status":"contextual_provisional"},{"id":"c-songshu-092-wangzhenzhi-wyd:p002:m0050","start":50,"end":52,"surface":"桓𤣥","kind":"person","person_id":"u9s_w6j_8mc_AAF","status":"contextual_provisional"},{"id":"c-songshu-092-wangzhenzhi-wyd:p002:m0069","start":69,"end":71,"surface":"鎮之","kind":"person","person_id":"7r6_k52_qji_ABDACAA","status":"contextual_provisional"},{"id":"c-songshu-092-wangzhenzhi-wyd:p002:m0080","start":80,"end":82,"surface":"王愉","kind":"person","person_id":"a8f_ec8_e74_AAAAAB","status":"contextual_provisional"},{"id":"c-songshu-092-wangzhenzhi-wyd:p002:m0086","start":86,"end":88,"surface":"鎮之","kind":"person","person_id":"7r6_k52_qji_ABDACAA","status":"contextual_provisional"},{"id":"c-songshu-092-wangzhenzhi-wyd:p002:m0092","start":92,"end":93,"surface":"愉","kind":"person","person_id":"a8f_ec8_e74_AAAAAB","status":"contextual_provisional"},{"id":"c-songshu-092-wangzhenzhi-wyd:p002:m0094","start":94,"end":95,"surface":"綏","kind":"person","person_id":"a8f_ec8_e74_AAAAABA","status":"contextual_provisional"},{"id":"c-songshu-092-wangzhenzhi-wyd:p002:m0095","start":95,"end":96,"surface":"𤣥","kind":"person","person_id":"u9s_w6j_8mc_AAF","status":"contextual_provisional"},{"id":"c-songshu-092