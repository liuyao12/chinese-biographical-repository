cy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-049-wanghuan-complete:p009:m0404","start":404,"end":407,"surface":"田文喜","kind":"person","person_id":"346_2b8_c91","status":"contextual_provisional","paragraph_id":"c-nanqishu-049-wanghuan-complete:p009","chapter_id":"c-nanqishu-049-wanghuan-complete"}],"relations":[],"title_holdings":[{"id":"th-nanqishu-049-wanghuan-complete-9-400","title":"雍州都留","kind":"office","mode":"attestation","person_id":"346_2b8_c91","attestations":[{"id":"th-nanqishu-049-wanghuan-complete-9-400:a","paragraph_id":"c-nanqishu-049-wanghuan-complete:p009","start":400,"end":404,"surface":"雍州都留","person_mention_id":"c-nanqishu-049-wanghuan-complete:p009:m0404","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-049","chapter_id":"c-nanqishu-049-wanghuan-complete","source_id":"s-nanqishu-049-wanghuan-complete-ws2261984","paragraph_id":"c-nanqishu-049-wanghuan-complete:p009","quote":"攝興祖門生劉倪到臺辨問，列「興祖與奐共事，不能相和。自去年朱公恩領軍征蠻失利，興祖啓聞，以啓呈奐，奐因此便相嫌恨。若云興祖有罪，便應事在民間；民間恬然，都無事迹。去十年九月十八日，奐使仗身三十人來，稱敕錄興祖付獄。安定郡蠻先在郡贓私，興祖旣知其取與，卽牒啓，奐不問。興祖後執錄，奐仍令蠻領仗身於獄守視。興祖未死之前，於獄以物畫漆柈子中出密報家，道無罪，令啓乞出都一辨，萬死無恨」。又云：「奐駐興祖嚴禁信使，欲作方便，殺以除口舌。」又云：「奐意乃可。奐第三息彪隨奐在州，凡事是非皆干豫，扇構密除興祖。」又云：「興祖家餉糜，中下藥，食兩口便覺，回乞獄子，食者皆大利。興祖大呌道『糜中有藥』。近獄之家，無人不聞。」又云：「奐治著興祖日急，判無濟理。十一月二十一日，奐使獄吏來報興祖家，道興祖於獄自經死。尸出，家人共洗浴之，見興祖頸下有傷，肩胛烏，陰下破碎，實非興祖自經死。家人及門義共見，非是一人。」重攝檢雍州都留田文喜，列與倪符同狀。","person_mention_id":"c-nanqishu-049-wanghuan-complete:p009:m0404"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constrai