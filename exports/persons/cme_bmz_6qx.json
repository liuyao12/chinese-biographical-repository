ths":[],"mentions":[{"id":"c-shiji-091-qingbu:m014-0021","start":21,"end":22,"surface":"姬","kind":"person","person_id":"cme_bmz_6qx","status":"contextual_provisional","paragraph_id":"c-shiji-091-qingbu:p014","chapter_id":"c-shiji-091-qingbu"},{"id":"c-shiji-091-qingbu:m014-0041","start":41,"end":42,"surface":"姬","kind":"person","person_id":"cme_bmz_6qx","status":"contextual_provisional","paragraph_id":"c-shiji-091-qingbu:p014","chapter_id":"c-shiji-091-qingbu"},{"id":"c-shiji-091-qingbu:m014-0046","start":46,"end":47,"surface":"姬","kind":"person","person_id":"cme_bmz_6qx","status":"contextual_provisional","paragraph_id":"c-shiji-091-qingbu:p014","chapter_id":"c-shiji-091-qingbu"},{"id":"c-shiji-091-qingbu:m019-0084","start":84,"end":86,"surface":"愛姬","kind":"person","person_id":"cme_bmz_6qx","status":"contextual_provisional","paragraph_id":"c-shiji-091-qingbu:p019","chapter_id":"c-shiji-091-qingbu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji091-020","person_id":"cme_bmz_6qx","scope":"same_chapter","chapter_ids":["c-shiji-091-qingbu"],"status":"contextual_provisional","rationale":"按本段明示姓名及局部敘事承接；布與兩王號按英布主線暫接。番君與長沙哀王分候選，所幸姬不與番君女合併；皋陶引古疑問不作祖先定論。","reviewer":"Codex（AI 代理）","surfaces":["姬","愛姬"],"evidence":[{"paragraph_id":"c-shiji-091-qingbu:p014","quote":"布所幸姬疾，請就醫，醫家與中大夫賁赫對門，姬數如醫家，賁赫自以為侍中，乃厚餽遺，從姬飲醫家。姬侍王，從容語次，譽赫長者也。王怒曰：「汝安從知之？」具說狀。王疑其與亂。赫恐，稱病。王愈怒，欲捕赫。赫言變事，乘傳詣長安。布使人追，不及。赫至，上變，言布謀反有端，可先未發誅也。上讀其書，語蕭相國。相國曰：「布不宜有此，恐仇怨妄誣之。請擊赫，使人微驗淮南王。」淮南王布見赫以罪亡，上變，固已疑其言國陰事；漢使又來，頗有所驗，遂族赫家，發兵反。反書聞，上乃赦賁赫，以為將軍。"},{"paragraph_id":"c-shiji-091-qingbu:p019","quote":"太史公曰：英布者，其先豈春秋所見楚滅英、六，皋陶之後哉？身被刑法，何其拔興之暴也！項氏之所阬殺人以千萬數，而布常為首虐。功冠諸侯，用此得王，亦不免於身為世大僇。禍之興自愛姬殖，妒媢生患，竟以滅國！"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-091-qingbu:p014","text":"布所幸姬疾，請就醫，醫家與中大夫賁赫對門，姬數如醫家，賁赫自以為侍中，乃厚餽遺，從姬飲醫家。姬侍王，從容語次，譽赫長者也。王怒曰：「汝安從知之？」具說狀。王疑其與亂。赫恐，稱病。王愈怒，欲捕赫。赫言變事，乘傳詣長安。布使人追，不及。赫至，上變，言布謀反有端，可先未發誅也。上讀其書，語蕭相國。相國曰：「布不宜有此，恐仇怨妄誣之。請擊赫，使人微驗淮南王。」淮南王布見赫以罪亡，上變，固已疑其言國陰事；漢使又來，頗有所驗，遂族赫家，發兵反。反書聞，上乃赦賁赫，以為將軍。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-091-qingbu:m014-0000","start":0,"end":1,"surface":"布","kind":"person","person_id":"dsv_qg0_ete","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m014-0010","start":10,"end":12,"surface":"醫家","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未定指代或匿名者保留原文，不補姓名成員。"},{"id":"c-shiji-091-qingbu:m014-0016","start":16,"end":18,"surface":"賁赫","kind":"person","person_id":"cqb_a3u_l7y","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m014-0021","start":21,"end":22,"surface":"姬","kind":"person","person_id":"cme_bmz_6qx","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m014-0024","start":24,"end":26,"surface":"醫家","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未定指代或匿名者保留原文，不補姓名成員。"},{"id":"c-shiji-091-qingbu:m014-0027","start":27,"end":29,"surface":"賁赫","kind":"person","person_id":"cqb_a3u_l7y","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m014-0041","start":41,"end":42,"surface":"姬","kind":"person","person_id":"cme_bmz_6qx","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m014-0043","start":43,"end":45,"surface":"醫家","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未定指代或匿名者保留原文，不補姓名成員。"},{"id":"c-shiji-091-qingbu:m014-0046","start":46,"end":47,"surface":"姬","kind":"person","person_id":"cme_bmz_6qx","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m014-0056","start":56,"end":57,"surface":"赫","kind":"person","person_id":"cqb_a3u_l7y","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m014-0083","start":83,"end":84,"surface":"赫","kind":"person","person_id":"cqb_a3u_l7y","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m014-0095","start":95,"end":96,"surface":"赫","kind":"person","person_id":"cqb_