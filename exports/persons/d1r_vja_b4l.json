eserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"start":143,"end":145,"surface":"劉晏","id":"c-nanshi-019-xietiao:p005:m0143","person_id":"d1r_vja_b4l","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作劉晏。","paragraph_id":"c-nanshi-019-xietiao:p005","chapter_id":"c-nanshi-019-xietiao"},{"start":250,"end":252,"surface":"劉晏","id":"c-nanshi-019-xietiao:p005:m0250","person_id":"d1r_vja_b4l","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作劉晏。","paragraph_id":"c-nanshi-019-xietiao:p005","chapter_id":"c-nanshi-019-xietiao"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanshi-019-xietiao:p005","text":"東昏失德，江祏欲立江夏王寶玄，末更回惑，與弟祀密謂朓曰：「江夏年少，脫不堪，不可復行廢立。始安年長入纂，不乖物望。非以此要富貴，只求安國家爾。」遙光又遣親人劉渢致意於朓。朓自以受恩明帝，不肯答。少日，遙光以朓兼知衛尉事，朓懼見引，即以祏等謀告左興盛，又說劉暄曰：「始安一旦南面，則劉渢、劉晏居卿今地，但以卿爲反復人爾。」暄陽驚，馳告始安王及江祏。始安欲出朓爲東陽郡，祏固執不與。先是，朓常輕祏爲人，祏常詣朓，朓因言有一詩，呼左右取，旣而便停。祏問其故，云：「定復不急」。祏以爲輕己。後祏及弟祀、劉渢、劉晏俱候朓，朓謂祏曰：「可謂帶二江之雙流」，以嘲弄之。祏轉不堪，至是構而害之。詔暴其過惡，收付廷尉。又使御史中丞範岫奏收朓，下獄死，時年三十六。臨終謂門賓曰：「寄語沈公，君方爲三代史，亦不得見沒。」","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"start":5,"end":7,"surface":"江祏","id":"c-nanshi-019-xietiao:p005:m0005","person_id":"q63_4br_3of_A","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作江祏。"},{"st