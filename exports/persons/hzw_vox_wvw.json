立休。永安五年，立夫人為皇后。休卒，群臣尊夫人為皇太后，孫皓即位月餘，貶為景皇后。稱安定宮。甘露元年七月，見逼薨，合葬定陵。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-050-zhu:line054:m0001","start":1,"end":2,"surface":"休","kind":"person","person_id":"0fo_c5c_4yh","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-zhu:line054:m0002","start":2,"end":5,"surface":"朱夫人","kind":"person","person_id":"v1i_1el_nnw","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-zhu:line054:m0007","start":7,"end":8,"surface":"據","kind":"person","person_id":"ejj_vdz_hxw","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-zhu:line054:m0010","start":10,"end":11,"surface":"休","kind":"person","person_id":"0fo_c5c_4yh","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-zhu:line054:m0012","surface":"公主","start":12,"end":14,"kind":"person","person_id":"2x6_slg_lc8","status":"contextual_provisional","interpretation_note":"按本段具名及前後親稱、官職定位。"},{"id":"c-sanguozhi-050-zhu:line054:m0022","start":22,"end":23,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-zhu:line054:m0024","start":24,"end":25,"surface":"休","kind":"person","person_id":"0fo_c5c_4yh","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-zhu:line054:m0030","start":30,"end":31,"surface":"休","kind":"person","person_id":"0fo_c5c_4yh","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-zhu:line054:m0046","start":46,"end":47,"surface":"峻","kind":"person","person_id":"ec3_vc7_z1i","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-zhu:line054:m0056","start":56,"end":58,"surface":"全尚","kind":"person","person_id":"vl3_bta_0h1","status":"contextual_provisional","interpretation_note":"依本段姓名