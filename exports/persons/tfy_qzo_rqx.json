:"c-sanguozhi-057-luji","source_id":"s-sanguozhi-057-luji"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-wu057-luji-0","subject_person_id":"7ec_qvv_x1c","object_person_id":"tfy_qzo_rqx","predicate":"father","qualifiers":{"source_term":"父康"},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-057","chapter_id":"c-sanguozhi-057-luji","source_id":"s-sanguozhi-057-luji","paragraph_id":"c-sanguozhi-057-luji:line037","quote":"陸績字公紀，吳郡吳人也。父康，漢末為廬江太守。績年六歲，於九江見袁術。術出橘，績懷三枚，去，拜辭墮地，術謂曰：“陸郎作賓客而懷橘乎？”績跪答曰：\"欲歸遺母。\"術大奇之。孫策在吳，張昭、張紘、秦松為上賓，共論四海未泰，須當用武治而平之，績年少末坐，遙大聲言曰：\"昔管夷吾相齊桓公，九合諸候，一匡天下，不用兵車。孔子曰：'遠人不服，則修文德以來之。'今論者不務道德懷取之術，而惟尚武，績雖童蒙，竊所未安也。\"昭等異焉。","subject_person_mention_id":"c-sanguozhi-057-luji:line037:m0001","object_person_mention_id":"c-sanguozhi-057-luji:line037:m0013"}],"interpretation_note":"以此來源所述兩端為據。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"a-wu058-ji-kang","subject_person_id":"7ec_qvv_x1c","object_person_id":"tfy_qzo_rqx","predicate":"father","qualifiers":{"source_term":"康子績"},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-058","chapter_id":"c-sanguozhi-058-luxun","source_id":"s-sanguozhi-058-luxun","paragraph_id":"c-sanguozhi-058-luxun:line011","quote":"陸遜字伯言，吳郡吳人也。本名議，世江東大族。遜少孤，隨從祖廬江太守康在官。袁術與康有隙，將攻康，康遣遜及親戚還吳。遜年長於康子績數歲，為之綱紀門戶。","subject_person_mention_id":"c-sanguozhi-058-luxun:line011:m0063","object_person_mention_id":"c-sanguozhi-058-luxun:line011:m0033"}],"interpretation_note":"以此來源所述兩端為據。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-057-luji:line037:m0013","start":13,"end":14,"surface":"康","kind":"person","person_id":"tfy_qzo_rqx","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","par