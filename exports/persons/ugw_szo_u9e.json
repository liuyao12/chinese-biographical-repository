isional"},{"id":"c-nanqishu-046-xiaohuiji-complete:p006:m0259","start":259,"end":261,"surface":"惠基","kind":"person","person_id":"ph1_ms8_hyq_ABAA","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-046-xiaohuiji-complete","book_id":"b-nanqishu-046","work_id":"w-nanqishu","source_id":"s-nanqishu-046-xiaohuiji-complete-ws1511897"},{"id":"c-nanqishu-053-local-officials-complete:p011","text":"　　帝好圍碁，甚拙，去格七八道，物議共欺爲第三品。與第一品王抗圍碁，依品賭戲，抗每饒借之，曰：「皇帝飛碁，臣抗不能斷。」帝終不覺，以爲信然，好之愈篤。愿又曰：「堯以此教丹朱，非人主所宜好也。」雖數忤旨，而蒙賞賜，猶異餘人。遷兼中書郎。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":39,"last_line":39,"raw_start":1506,"raw_end":1623,"raw_character_offsets":[1506,1507,1508,1509,1510,1511,1512,1513,1514,1515,1516,1517,1518,1519,1520,1521,1522,1523,1524,1525,1526,1527,1528,1529,1530,1531,1532,1533,1534,1535,1536,1537,1538,1539,1540,1541,1542,1543,1544,1545,1546,1547,1548,1549,1550,1551,1552,1553,1554,1555,1556,1557,1558,1559,1560,1561,1562,1563,1564,1565,1566,1567,1568,1569,1570,1571,1572,1573,1574,1575,1576,1577,1578,1579,1580,1581,1582,1583,1584,1585,1586,1587,1588,1589,1590,1591,1592,1593,1594,1595,1596,1597,1598,1599,1600,1601,1602,1603,1604,1605,1606,1607,1608,1609,1610,1611,1612,1613,1614,1615,1616,1617,1618,1619,1620,1621,1622],"revision_id":1501803},"mentions":[{"id":"c-nanqishu-053-local-officials-complete:p011:m0002","start":2,"end":3,"surface":"帝","kind":"person","person_id":"cti_o52_4nz","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p011:m0029","start":29,"end":31,"surface":"王抗","kind":"person","person_id":"ugw_szo_u9e","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p011:m0039","start":39,"end":40,"surface":"抗","kind":"person","person_id":"ugw_szo_u9e","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p011:m0048","start":48,"end":50,"surface":"皇帝","kind":"person","person_id":"cti_o52_4nz","status":"contextual_provisional"},{"id":"c