"},{"id":"c-nanqishu-053-local-officials-complete:p011:m0039","start":39,"end":40,"surface":"抗","kind":"person","person_id":"ugw_szo_u9e","status":"contextual_provisional","paragraph_id":"c-nanqishu-053-local-officials-complete:p011","chapter_id":"c-nanqishu-053-local-officials-complete"},{"id":"c-nanqishu-053-local-officials-complete:p011:m0054","start":54,"end":55,"surface":"抗","kind":"person","person_id":"ugw_szo_u9e","status":"contextual_provisional","paragraph_id":"c-nanqishu-053-local-officials-complete:p011","chapter_id":"c-nanqishu-053-local-officials-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-046-xiaohuiji-complete:p006","text":"　　五年，遷太常，加給事中。自宋大明以來，聲伎所尚，多鄭衞淫俗，雅樂正聲，鮮有好者。惠基解音律，尤好魏三祖曲及《相和歌》，每奏，輙賞悅不能已。當時能棊人琅邪王抗第一品，吳郡褚思莊、會稽夏赤松竝第二品。赤松思速，善於大行；思莊思遲，巧於鬬棊。宋文帝世，羊玄保爲會稽太守，帝遣思莊入東與玄保戲，因製局圖，還於帝前覆之。太祖使思莊與王抗交賭，自食時至日暮，一局始竟。上倦，遣還省，至五更方決。抗睡於局後，思莊達曉不寐。世或云：「思莊所以品第致高，緣其用思深久，人不能對也。」抗、思莊竝至給事中。永明中，敕抗品棊，竟陵王子良使惠基掌其事。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":78,"last_line":78,"raw_start":6181,"raw_end":6446,"raw_character_offsets":[6181,6182,6183,6184,6185,6186,6187,6188,6189,6190,6191,6192,6193,6194,6195,6196,6197,6198,6199,6200,6201,6202,6203,6204,6205,6206,6207,6208,6209,6210,6211,6212,6213,6214,6215,6216,6217,6218,6219,6220,6221,6222,6223,6224,6225,6226,6227,6228,6229,6230,6231,6232,6233,6234,6235,6236,6237,6238,6239,6240,6241,6242,6243,6244,6245,6246,6247,6248,6249,6250,6251,6252,6253,6254,6255,6256,6257,6258,6259,6260,6261,6262,6263,6264,6265,6266,6267,6268,6269,6270,6271,6272,6273,6274,6275,6276,6277,6278,6279,6280,6281,6282,6283,6284,6285,6286,6287,6288,6289,6290,6291,6292,6293,6294,6295,6296,6297,6298,6299,6300,6301,6302,6303,6304,6305,6306,6307,6308,6309,6310,6311,6312,6313,6314,6315,6316,6317,6318,63