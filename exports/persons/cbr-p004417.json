,"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji077-007","person_id":"cbr-p004417","surfaces":["趙王"],"scope":"same_chapter","chapter_ids":["c-shiji-077-weigong"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-077-weigong:p003","quote":"公子與魏王博，而北境傳舉烽，言「趙寇至，且入界」。魏王釋博，欲召大臣謀。公子止王曰：「趙王田獵耳，非為寇也。」復博如故。王恐，心不在博。居頃，復從北方來傳言曰：「趙王獵耳，非為寇也。」魏王大驚，曰：「公子何以知之？」公子曰：「臣之客有能深得趙王陰事者，趙王所為，客輒以報臣，臣以此知之。」是後魏王畏公子之賢能，不敢任公子以國政。"}],"rationale":"按全17段明示姓名與局部敘事暫接；侯嬴侯生嬴、無忌公子信陵君各限定本傳。如姬父與仇人未名，毛薛二公不補姓名。救邯鄲趙王按下一段孝成王明稱暫接，田獵趙王與後期秦王、大梁被虜魏王另存未名候選。偽賀魏王指擬立無忌不作授王，魏公子兵法作書名；泛稱夫人有德、軍令父子兄弟不補親屬。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-077-weigong:p003","text":"公子與魏王博，而北境傳舉烽，言「趙寇至，且入界」。魏王釋博，欲召大臣謀。公子止王曰：「趙王田獵耳，非為寇也。」復博如故。王恐，心不在博。居頃，復從北方來傳言曰：「趙王獵耳，非為寇也。」魏王大驚，曰：「公子何以知之？」公子曰：「臣之客有能深得趙王陰事者，趙王所為，客輒以報臣，臣以此知之。」是後魏王畏公子之賢能，不敢任公子以國政。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-077-weigong:m003-0000","start":0,"end":2,"surface":"公子","kind":"person","person_id":"cbr-p004411","status":"contextual_provisional"},{"id":"c-shiji-077-weigong:m003-0003","start":3,"end":5,"surface":"魏王","kind":"person","person_id":"cbr-p004413","status":"contextual_provisional"},{"id":"c-shiji-077-weigong:m003-0025","start":25,"end":27,"surface":"魏王","kind":"person","person_id":"cbr-p004413","status":"contextual_provisional"},{"id":"c-shiji-077-weigong:m003-0032","start":32,"end":34,"surface":"大臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未定指代保留，食客數不補成員；父子主張另存，不由同稱全域合併。"},{"id":"c-shiji-077-weigong:m003-0036","start":36,"end":38,"surface":"公子","kind":"person","person_id":"cbr-p004411","status":"contextual_provisional"},{"id":"c-shiji-077-weigong:m003-0039","start":39,"end":40,"surface":"王","kind":"person","person_id":"cbr-p004413","status":"contextual_provisional"},{"id":"c-shiji-077-weigong:m003-0043","start":43,"end":45,"surface":"趙王","kind":"person","p