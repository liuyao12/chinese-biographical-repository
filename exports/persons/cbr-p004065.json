":"齊王","kind":"person","person_id":"cbr-p004052","status":"contextual_provisional"},{"id":"c-shiji-069-su:m045-0673","start":673,"end":675,"surface":"蘇秦","kind":"person","person_id":"cbr-p004022","status":"contextual_provisional"},{"id":"c-shiji-069-su:m045-0678","start":678,"end":680,"surface":"蘇厲","kind":"person","person_id":"cbr-p004066","status":"contextual_provisional"},{"id":"c-shiji-069-su:m045-0681","start":681,"end":684,"surface":"燕質子","kind":"person","person_id":"cbr-p004068","status":"contextual_provisional"}],"chapter_id":"c-shiji-069-su","book_id":"b-shiji-069","work_id":"w-shiji","source_id":"s-shiji-069-su"},{"id":"c-shiji-069-su:p046","text":"燕相子之與蘇代婚，而欲得燕權，乃使蘇代侍質子於齊。齊使代報燕，燕王噲問曰：「齊王其霸乎？」曰：「不能。」曰：「何也？」曰：「不信其臣。」於是燕王專任子之，已而讓位，燕大亂。齊伐燕，殺王噲、子之。燕立昭王，而蘇代、蘇厲遂不敢入燕，皆終歸齊，齊善待之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m046-0002","start":2,"end":4,"surface":"子之","kind":"person","person_id":"cbr-p004069","status":"contextual_provisional"},{"id":"c-shiji-069-su:m046-0005","start":5,"end":7,"surface":"蘇代","kind":"person","person_id":"cbr-p004065","status":"contextual_provisional"},{"id":"c-shiji-069-su:m046-0017","start":17,"end":19,"surface":"蘇代","kind":"person","person_id":"cbr-p004065","status":"contextual_provisional"},{"id":"c-shiji-069-su:m046-0020","start":20,"end":22,"surface":"質子","kind":"person","person_id":"cbr-p004068","status":"contextual_provisional"},{"id":"c-shiji-069-su:m046-0027","start":27,"end":28,"surface":"代","kind":"person","person_id":"cbr-p004065","status":"contextual_provisional"},{"id":"c-shiji-069-su:m046-0031","start":31,"end":34,"surface":"燕王噲","kind":"person","person_id":"cbr-p004053","status":"contextual_provisional"},{"id":"c-shiji-069-su:m046-0038","start":38,"end":40,"surface":"齊王","kind":"person","person_id":"cbr-p004052","status":"contextual_provisional"},{"id":"c-shiji-069-su:m046-0064","start":64,"end":66,"surface":"其臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、氏族、未名者或未定指代，不補姓名與成員；趙莊戰名性質未定。"},{"id":"c-shiji-069-su:m046-0070","start":70,"end":72,"surface":"燕王","kind":"person","person_id":"cbr-p004053","status":"contextual_provisional"},{"id":"c-shiji-069-su:m046-0074","start":74,"end":76,"surface":"子之","kind":"person","person_id":"cbr-p004069","status":"contextual_provisional"},{"id":"c-shiji-069-su:m046-0091","start":91,"end":93,"surface":"王噲","kind":"person","person_id":"cbr-p004053","status":"contextual_provisional"},{"id":"c-shiji-069-su:m046-0094","start":94,"end":96,"surface":"子之","kind":"person","person_id":"cbr-p004069","status":"contextual_provisional"},{"id":"c-shiji-069-su:m046-0099","start":99,"end":101,"surface":"昭王","kind":"person","person_id":"cbr-p004070","status":"contextual_provisional"},{"id":"c-shiji-069-su:m046-0103","start":103,"end":105,"surface":"蘇代","kind":"person","person_id":"cbr-p004065","status":"contextual_provisional"},{"id":"c-shiji-069-su:m046-0106","start":106,"end":108,"surface":"蘇厲","kind":"person","person_id":"cbr-p004066","status":"contextual_provisional"}],"chapter_id":"c-shiji-069-su","book_id":"b-shiji-069","work_id":"w-shiji","source_id":"s-shiji-069-su"},{"id":"c-shiji-069-su:p047","text":"蘇代過魏，魏為燕執代。齊使人謂魏王曰：「齊請以宋地封涇陽君，秦必不受。秦非不利有齊而得宋地也，不信齊王與蘇子也。今齊魏不和如此其甚，則齊不欺秦。秦信齊，齊秦合，涇陽君有宋地，非魏之利也。故王不如東蘇子，秦必疑齊而不信蘇子矣。齊秦不合，天下無變，伐齊之形成矣。」於是出蘇代。代之宋，宋善待之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m047-0000","start":0,"end":2,"surface":"蘇代","kind":"person","person_id":"cbr-p004065","status":"contextual_provisional"},{"id":"c-shiji-069-su:m047-0009","start":9,"end":10,"surface":"代","kind":"person","person_id":"cbr-p004065","status":"contextual_provisional"},{"id":"c-shiji-069-su:m047-0012","start":12,"end":14,"surface":"使人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、氏族、未名者或未定指代，不補姓名與成員；趙莊戰名性質未定。"},{"id":"c-shiji-069-su:m047-0015","start":15,"end":17,"surface":"魏王","kind":"person","person_id":"cbr-p004071","status":"contextual_provisional"},{"id":"c-shiji-069-su:m047-0026","start":26,"end":29,"surface":"涇陽君","kind":"person","person_id":"cbr-p004072","status":"contextual_provisional"},{"id":"c-shiji-069-su:m047-0049","start":49,"end":51,"surface":"齊王","kind":"person","person_id":"cbr-p004073","status":"contextual_provisional"},{"id":"c-shiji-069-su:m047-0052","start":52,"end":54,"surface":"蘇子","kind":"person","person_id":"cbr-p004065","status":"contextual_provisional"},{"id":"c-shiji-069-su:m047-0080","start":80,"end":83,"surface":"涇陽君","kind":"person","person_id":"cbr-p004072","status":"contextual_provisional"},{"id":"c-shiji-069-su:m047-0098","start":98,"end":100,"surface":"蘇子","kind":"person","person_id":"cbr-p004065","status":"contextual_provisional"},{"id":"c-shiji-069-su:m047-0108","start":108,"end":110,"surface":"蘇子","kind":"person","person_id":"cbr-p004065","status":"contextual_provisional"},{"id":"c-shiji-069-su:m047-0133","start":133,"end":135,"surface":"蘇代","kind":"person","person_id":"cbr-p004065","status":"contextual_provisional"},{"id":"c-shiji-069-su:m047-0136","start":136,"end":137,"surface":"代","kind":"person","person_id":"cbr-p004065","status":"contextual_provisional"}],"chapter_id":"c-shiji-069-su","book_id":"b-shiji-069","work_id":"w-shiji","source_id":"s-shiji-069-su"},{"id":"c-shiji-069-su:p048","text":"齊伐宋，宋急，蘇代乃遺燕昭王書曰：","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m048-0007","start":7,"end":9,"surface":"蘇代","kind":"person","person_id":"cbr-p004065","status":"contextual_provisional"},{"id":"c-shiji-069-su:m048-0011","start":11,"end":14,"surface":"燕昭王","kind":"person","person_id":"cbr-p004070","status":"contextual_provisional"}],"chapter_id":"c-shiji-069-su","book_id":"b-shiji-069","work_id":"w-shiji","source_id":"s-shiji-069-su"},{"id":"c-shiji-069-su:p053","text":"燕昭王善其書，曰：「先人嘗有德蘇氏，子之之亂而蘇氏去燕。燕欲報仇於齊，非蘇氏莫可。」乃召蘇代，復善待之，與謀伐齊。竟破齊，湣王出走。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m053-0000","start":0,"end":3,"surface":"燕昭王","kind":"person","person_id":"cbr-p004070","status":"contextual_provisional"},{"id":"c-shiji-069-su:m053-0010","start":10,"end":12,"surface":"先人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、氏族、未名者或未定指代，不補姓名與成員；趙莊戰名性質未定。"},{"id":"c-shiji-069-su:m053-0015","start":15,"end":17,"surface":"蘇氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、氏族、未名者或未定指代，不補姓名與成員；趙莊戰名性質未定。"},{"id":"c-shiji-069-su:m053-0018","start":18,"end":20,"surface":"子之","kind":"person","person_id":"cbr-p004069","status":"contextual_provisional"},{"id":"c-shiji-069-su:m053-0023","start":23,"end":25,"surface":"蘇氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、氏族、未名者或未定指代，不補姓名與成員；趙莊戰名性質未定。"},{"id":"c-shiji-069-su:m053-0036","start":36,"end":38,"surface":"蘇氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、氏族、未名者或未定指代，不補姓名與成員；趙莊戰名性質未定。"},{"id":"c-shiji-069-su:m053-0044","start":44,"end":46,"surface":"蘇代","kind":"person","person_id":"cbr-p004065","status":"contextual_provisional"},{"id":"c-shiji-069-su:m053-0061","start":61,"end":63,"surface":"湣王","kind":"person","person_id":"cbr-p004052","status":"contextual_provisional"}],"chapter_id":"c-shiji-069-su","book_id":"b-shiji-069","work_id":"w-shiji","source_id":"s-shiji-069-su"},{"id":"c-shiji-069-su:p054","text":"久之，秦召燕王，燕王欲往，蘇代約燕王曰：「楚得枳而國亡，齊得宋而國亡，齊、楚不得以有枳、宋而事秦者，何也？則有功者，秦之深讐也。秦取天下，非行義也，暴也。秦之行暴，正告天下。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m054-0005","start":5,"end":7,"surface":"燕王","kind":"person","person_id":"cbr-p004070","status":"contextual_provisional"},{"id":"c-shiji-069-su:m054-0008","start":8,"end":10,"surface":"燕王","kind":"person","person_id":"cbr-p004070","status":"contextual_provisional"},{"id":"c-shiji-069-su:m054-0013","start":13,"end":15,"surface":"蘇代","kind":"person","person_id":"cbr-p004065","status":"contextual_provisional"},{"id":"c-shiji-069-su:m054-0016","start":16,"end":18,"surface":"燕王","kind":"person","person_id":"cbr-p004070","status":"contextual_provisional"}],"chapter_id":"c-shiji-069-su","book_id":"b-shiji-069","work_id":"w-shiji","source_id":"s-shiji-069-su"},{"id":"c-shiji-069-su:p065","text":"燕昭王不行。蘇代復重於燕。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m065-0000","start":0,"end":3,"surface":"燕昭王","kind":"person","person_id":"cbr-p004070","status":"contextual_provisional"},{"id":"c-shiji-069-su:m065-0006","start":6,"end":8,"surface":"蘇代","kind":"person","person_id":"cbr-p004065","status":"contextual_provisional"}],"chapter_id":"c-shiji-069-su","book_id":"b-shiji-069","work_id":"w-shiji","source_id":"s-shiji-069-su"},{"id":"c-shiji-069-su:p066","text":"燕使約諸侯從親如蘇秦時，或從或不，而天下由此宗蘇氏之從約。代、厲皆以壽死，名顯諸侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m066-0003","start":3,"end":5,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、氏族、未名者或未定指代，不補姓名與成員；趙莊戰名性質未定。"},{"id":"c-shiji-069-su:m066-0008","start":8,"end":10,"surface":"蘇秦","kind":"person","person_id":"cbr-p004022","status":"contextual_provisional"},{"id":"c-shiji-069-su:m066-0023","start":23,"end":25,"surface":"蘇氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、氏族、未名者或未定指代，不補姓名與成員；趙莊戰名性質未定。"},{"id":"c-shiji-069-su:m066-0029","start":29,"end":30,"surface":"代","kind":"person","person_id":"cbr-p004065","status":"contextual_provisional"},{"id":"c-shiji-069-su:m066-0031","start":31,"end":32,"surface":"厲","kind":"person","person_id":"cbr-p004066","status":"contextual_provisional"},{"id":"c-shiji-069-su:m066-0039","start":39,"end":41,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、氏族、未名者或未定指代，不補姓名與成員；趙莊戰名性質未定。"}],"chapter_id":"c-shiji-069-su","book_id":"b-shiji-069","work_id":"w-shiji","source_id":"s-shiji-069-su"}],"sources":[{"chapter_id":"c-shiji-069-su","work_id":"w-shiji","book_id":"b-shiji-069","source_id":"s-shiji-069-su","source":{"title":"史記／卷069","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷069","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷069&oldid=2621145","revision_id":2621145,"accessed_on":"2026-10-09","extent":"67段正文，自蘇秦者至太史公論贊；排除ws-header弟名導覽與空段、後附索隱述贊及現代版權告示。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"取得時HTML與固定修訂一致，只去外緣空白。保留雒、衞、嘑、敎、㕹等原字及數位標點疑點，未按現代研究改寫時序。","note":"全67段已核讀，人物標註待逐段處理；未核底本、影像、出土縱橫家材料或現代研究。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical"}}
