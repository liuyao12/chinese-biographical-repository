ional","identity_note":"脩則〔吳前部督〕，見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-sanguozhi-048-sun-hao-ws2085142","work_id":"w-sanguozhi","book_id":"b-sanguozhi-048","chapter_id":"c-sanguozhi-048-sun-hao","raw_mention_count":3,"mention_ids":["c-sanguozhi-048-sun-hao:p015:m0054","c-sanguozhi-048-sun-hao:p021:m0245","c-sanguozhi-048-sun-hao:p021:m0261"],"paragraph_ids":["c-sanguozhi-048-sun-hao:p015","c-sanguozhi-048-sun-hao:p021"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-sanguozhi-048-sun-hao:p015:m0054","mention_ids":["c-sanguozhi-048-sun-hao:p015:m0054"],"kind":"paragraph"},{"canonical_mention_id":"c-sanguozhi-048-sun-hao:p021:m0245","mention_ids":["c-sanguozhi-048-sun-hao:p021:m0245"],"kind":"paragraph"},{"canonical_mention_id":"c-sanguozhi-048-sun-hao:p021:m0261","mention_ids":["c-sanguozhi-048-sun-hao:p021:m0261"],"kind":"paragraph"}],"mention_count":3,"duplicate_mention_count":0,"paragraph_occurrence_count":3,"table_occurrence_count":0,"passage_count":2,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"3處獨立位置，3個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-sanguozhi-048-sun-hao-ws2085142"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-wu048-yun-father","subject_person_id":"wce_220_oey","object_person_id":"x82_2nn_rsk","predicate":"father","qualifiers":{"source_term":"則子允"},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-048","chapter_id":"c-sanguozhi-048-sun-hao","source_id":"s-sanguozhi-048-sun-hao-ws2085142","paragraph_id":"c-sanguozhi-048-sun-hao:p021","quote":"《漢晉春秋》曰：初霍弋遣楊稷、毛炅等戍，與之誓曰：「若賊圍城，未百日而降者，家屬誅；若過百日而城沒者，刺史受其罪。」稷等日未滿而糧盡，乞降於璜。璜不許，而給糧使守。吳人並諫，璜曰：「霍弋已死，無能來者，可須其糧盡，然後乃受，使彼來無罪，而我取有義，內訓吾民，外懷鄰國，不亦可乎！」稷、炅糧盡，救不至，乃納之。　華陽國志曰：稷，犍爲人。炅，建寧人。稷等城中食盡，死亡者半，將軍王約反降，吳人得入城，獲稷、炅，皆囚之。孫皓使送稷下都，稷至合浦，歐血死。晉追贈交州刺史。初，毛炅與吳軍戰，殺前部督脩則。陶璜等以炅壯勇，欲赦之。而則子允固求殺炅，炅亦不爲璜等屈，璜等怒，靣縛炅詰之，曰：「晉兵賊！」炅厲聲曰：「吳狗，何等爲賊？」吳人生剖其腹，允割其心肝，罵曰：「庸復作賊？」炅猶罵不止，曰：「尚欲斬汝孫皓，汝父何死狗也！」乃斬之。晉武帝聞而哀矜，即詔使炅長子襲爵，餘三子皆關內侯。此與漢晉春秋所說不同。","subject_person_mention_id":"c-sanguozhi-048-sun-hao:p021:m0263","object_person_mention_id":"c-sanguozhi-048-sun-hao:p021:m0245"}],"status":"source_attested","interpretation_note":"依固定見證同段親屬原詞及所屬敘事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-048-sun-hao:p015:m0054","surface":"脩則","start":54,"end":56,"kind":"person","person_id":"x82_2nn_rsk","status":"contextual_provisional","paragraph_id":"c-sanguozhi-048-sun-hao:p015","chapter_id":"c-sanguozhi-048-sun-hao"},{"id":"c-sanguozhi-048-sun-hao:p021:m0245","surface":"脩則","start":245,"end":247,"kind":"person","person_id":"x82_2nn_rsk","status":"contextual_provisional","paragraph_id":"c-sanguozhi-048-sun-hao:p021","chapter_id":"c-sanguozhi-048-sun-hao"},{"id":"c-sanguozhi-048-sun-hao:p021:m0261","surface":"則","start":261,"end":262,"kind":"person","person_id":"x82_2nn_rsk","status":"contextual_provisional","paragraph_id":"c-sanguozhi-048-sun-hao:p021","chapter_id":"c-sanguozhi-048-sun-hao"}],"relations":[{"id":"a-wu048-yun-father","subject_person_id":"wce_220_oey","object_person_id":"x82_2nn_rsk","predicate":"father","qualifiers":{"source_term":"則子允"},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-048","chapter_id":"c-sanguozhi-048-sun-hao","source_id":"s-sanguozhi-048-sun-hao-ws2085142","paragraph_id":"c-sanguozhi-048-sun-hao:p021","quote":"《漢晉春秋》曰：初霍弋遣楊稷、毛炅等戍，與之誓曰：「若賊圍城，未百日而