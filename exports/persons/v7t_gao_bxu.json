{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"v7t_gao_bxu","canonical_person_id":"v7t_gao_bxu","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["v7t_gao_bxu"],"persons":[{"id":"v7t_gao_bxu","label":"桓嘉（魏樂安太守）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"桓嘉","mention_ids":["c-sanguozhi-064-zhugeke-complete:p017:m0279"]}],"evidence":[{"mention_id":"c-sanguozhi-064-zhugeke-complete:p017:m0279","paragraph_id":"c-sanguozhi-064-zhugeke-complete:p017","chapter_id":"c-sanguozhi-064-zhugeke-complete","quote":"桓嘉"}],"review":"ai_provisional","identity_note":"桓嘉（魏樂安太守），見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-sanguozhi-064-zhugeke-complete-ws2263487","work_id":"w-sanguozhi","book_id":"b-sanguozhi-064","chapter_id":"c-sanguozhi-064-zhugeke-complete","raw_mention_count":1,"mention_ids":["c-sanguozhi-064-zhugeke-complete:p017:m0279"],"paragraph_ids":["c-sanguozhi-064-zhugeke-complete:p017"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-sanguozhi-064-zhugeke-complete:p017:m0279","mention_ids":["c-sanguozhi-064-zhugeke-complete:p017:m0279"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-sanguozhi-064-zhugeke-complete-ws2263487"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-064-zhugeke-complete:p017:m0279","surface":"桓嘉","start":279,"end":281,"kind":"person","person_id":"v7t_gao_bxu","status":"contextual_provisional","paragraph_id":"c-sanguozhi-064-zhugeke-complete:p017","chapter_id":"c-sanguozhi-064-zhugeke-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-064-zhugeke-complete:p017","text":"　　初，權黃龍元年遷都建業。二年築東興堤遏湖水。後徵淮南，敗，以內船，由是廢不復修。恪以建興元年十月會眾於東興，更作大堤，左右結山俠築兩城，各留千人，使全端、留略守之，引軍而還。魏以吳軍入其疆土，恥於受侮，命大將胡遵、諸葛誕等率眾七萬，欲攻圍兩塢，圖壞堤遏。恪興軍四萬，晨夜赴救。遵等敕其諸軍作浮橋度，陳於堤上，分兵攻兩城。城在高峻，不可卒拔。恪遣將軍留贊、呂據、唐諮、丁奉為前部。時天寒雪，魏諸將會飲，見贊等兵少，而解置鎧甲，不持矛戟。但兜鍪刀楯，夥身緣遏，大笑之，不即嚴兵。兵得上，便鼓譟亂斫。魏軍驚擾散走，爭渡浮橋，橋壞絕，自投於水，更相蹈藉。樂安太守桓嘉等同時並沒，死者數萬。故叛將韓綜為魏前軍督，亦斬之。獲車乘牛馬驢騾各數千，資器山積，振旅而歸。進封恪陽都侯，加荊揚州牧，督中外諸軍事，賜金一百斤，馬二百匹，繒佈各萬匹。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":35,"last_line":35,"raw_start":3601,"raw_end":3990,"raw_character_offsets":[3601,3602,3603,3604,3605,3611,3612,3613,3614,3622,3623,3624,3625,3626,3627,3628,3629,3630,3631,3632,3633,3634,3635,3636,3637,3638,3639,3640,3641,3642,3643,3644,3645,3646,3647,3648,3649,3650,3651,3652,3653,3654,3655,3656,3662,3663,3664,3665,3673,3674,3675,3676,3677,3678,3679,3680,3681,3682,3683,3684,3685,3686,3687,3688,3689,3690,3691,3692,3693,3694,3695,3696,3697,3698,3699,3700,3701,3702,3703,3704,3705,3706,3707,3708,3709,3710,3711,3712,3713,3714,3715,3716,3717,3718,3719,3720,3721,3722,3723,3724,3725,3726,3727,3728,3729,3730,3731,3732,3733,3734,3735,3736,3737,3738,3739,3740,3741,3742,3743,3744,3745,3746,3747,3748,3749,3750,3751,3752,3753,3754,3755,3756,3757,3758,3759,3760,3761,3762,3763,3764,3765,3766,3767,3768,3769,3770