ertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-032-qi:p043","text":"四十一年，秦穆公虜晉惠公，復歸之。是歲，管仲、隰朋皆卒。管仲病，桓公問曰：「群臣誰可相者？」管仲曰：「知臣莫如君。」公曰：「易牙如何？」對曰：「殺子以適君，非人情，不可。」公曰：「開方如何？」對曰：「倍親以適君，非人情，難近。」公曰：「豎刀如何？」對曰：「自宮以適君，非人情，難親。」管仲死，而桓公不用管仲言，卒近用三子，三子專權。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-032-qi:m043-0005","start":5,"end":8,"surface":"秦穆公","kind":"person","person_id":"y97_huh_vuz_AAAAA","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m043-0009","start":9,"end":12,"surface":"晉惠公","kind":"person","person_id":"a9v_t0d_3va","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m043-0020","start":20,"end":22,"surface":"管仲","kind":"person","person_id":"h1v_8ap_b9y","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m043-0023","start":23,"end":25,"surface":"隰朋","kind":"person","person_id":"p1q_4ay_bht","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m043-0028","start":28,"end":30,"surface":"管仲","kind":"person","person_id":"h1v_8ap_b9y","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m043-0032","start":32,"end":34,"surface":"桓公","kind":"person","person_id":"9w2_c77_53m","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m043-0046","start":46,"end":48,"surface":"管仲","kind":"person","person_id":"h1v_8ap_b9y","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m043-0062","start":62,"end":64,"surface":"易牙","kind":"person","person_id":"3lq_bkx_u08","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m043-0090","start":90,"end":92,"surface":"開方","kind":"person","person_id":"j0b_1s6_k98","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m043-0118","start":118,"end":120,"surface":"豎刀","kind":"person","person_id":"e1v_3is_1tq","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m043-0142","start":142,"end":144,"surface":"管仲","kind":"person","person_id":"h1v_8ap_b9y","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m043-0147","start":147,"end":149,"surface":"桓公","kind":"person","person_id":"9w2_c77_53m","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m043-0151","start":151,"end":153,"surface":"管仲","kind":"person","person_id":"h1v_8ap_b9y","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m043-0158","start":158,"end":160,"surface":"三子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、族稱或未定指代，不補未見姓名與成員；官禮等級不直接當授官。"},{"id":"c-shiji-032-qi:m043-0161","start":161,"end":163,"surface":"三子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、族稱或未定指代，不補未見姓名與成員；官禮等級不直接當授官。"}],"chapter_id":"c-shiji-032-qi","book_id":"b-shiji-032","work_id":"w-shiji","source_id":"s-shiji-032-qi"},{"id":"c-shiji-032-qi:p045","text":"四十三年。初，齊桓公之夫人三：曰王姬、徐姬、蔡姬，皆無子。桓公好內，多內寵，如夫人者六人，長衛姬，生無詭；少衛姬，生惠公元；鄭姬，生孝公昭；葛嬴，生昭公潘；密姬，生懿公商人；宋華子，生公子雍。桓公與管仲屬孝公於宋襄公，以為太子。雍巫有寵於衛共姬，因宦者豎刀以厚獻於桓公，亦有寵，桓公許之立無詭。管仲卒，五公子皆求立。冬十月乙亥，齊桓公卒。易牙入，與豎刀因內寵殺群吏，而立公子無詭為君。太子昭奔宋。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-032-qi:m045-0007","start":7,"end":10,"surface":"齊桓公","kind":"person","person_id":"9w2_c77_53m","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m045-0016","start":16,"end":18,"surface":"王姬","kind":"person","person_id":"wpi_4yz_de2","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m045-0019","start":19,"end":21,"surface":"徐姬","kind":"person","person_id":"id0_ryz_8tv","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m045-0022","start":22,"end":24,"surface":"蔡姬","kind":"person","person_id":"joh_mm0_i8m","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m045-0029","start":29,"end":31,"surface":"桓公","kind":"person","person_id":"9w2_c77_53m","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m045-0045","start":45,"end":48,"surface":"長衛姬","kind":"person","person_id":"wfu_ts5_cyz","status":"context