,"raw_end":7936,"raw_line":91},"chapter_id":"c-jinshu-098-shenchong","book_id":"b-jinshu-098","work_id":"w-jinshu","source_id":"s-jinshu-098-shenchong"},{"id":"c-songshu-063-shenyanzhi-shuren:p001","text":"沈演之字臺真，吳興武康人也。高祖充，晉車騎將軍，吳國內史。曾祖勁，冠軍陳祐長史，戍金墉城，為鮮卑慕容恪所陷，不屈節見殺，追贈東陽太守。祖赤黔，廷尉卿。父叔任，少有幹質，初為揚州主簿，高祖太尉參軍，吳、山陰令，治皆有聲。朱齡石伐蜀，為齡石建威府司馬，加建威將軍。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":63,"last_line":63,"raw_start":5827,"raw_end":5957,"raw_character_offsets":[5827,5828,5829,5830,5831,5832,5833,5834,5835,5836,5837,5838,5839,5840,5841,5842,5843,5844,5845,5846,5847,5848,5849,5850,5851,5852,5853,5854,5855,5856,5857,5858,5859,5860,5861,5862,5863,5864,5865,5866,5867,5868,5869,5870,5871,5872,5873,5874,5875,5876,5877,5878,5879,5880,5881,5882,5883,5884,5885,5886,5887,5888,5889,5890,5891,5892,5893,5894,5895,5896,5897,5898,5899,5900,5901,5902,5903,5904,5905,5906,5907,5908,5909,5910,5911,5912,5913,5914,5915,5916,5917,5918,5919,5920,5921,5922,5923,5924,5925,5926,5927,5928,5929,5930,5931,5932,5933,5934,5935,5936,5937,5938,5939,5940,5941,5942,5943,5944,5945,5946,5947,5948,5949,5950,5951,5952,5953,5954,5955,5956],"revision_id":2118589},"mentions":[{"id":"c-songshu-063-shenyanzhi-shuren:p001:m0000","start":0,"end":3,"surface":"沈演之","kind":"person","person_id":"bc8_80d_613","status":"contextual_provisional"},{"id":"c-songshu-063-shenyanzhi-shuren:p001:m0004","start":4,"end":6,"surface":"臺真","kind":"person","person_id":"bc8_80d_613","status":"contextual_provisional"},{"id":"c-songshu-063-shenyanzhi-shuren:p001:m0016","start":16,"end":17,"surface":"充","kind":"person","person_id":"4c2_19b_bf4","status":"contextual_provisional"},{"id":"c-songshu-063-shenyanzhi-shuren:p001:m0031","start":31,"end":32,"surface":"勁","kind":"person","person_id":"4c2_19b_bf4_A","status":"contextual_provisional"},{"id":"c-songshu-063-shenyanzhi-shuren:p001:m0068","start":68,"end":70,"surface":"赤黔","kind":"person","person_id":"4c2_19b_bf4_AA","status":"contextual_provi