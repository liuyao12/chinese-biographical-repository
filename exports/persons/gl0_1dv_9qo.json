mily_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-wu060-quancong0","person_id":"gl0_1dv_9qo","event_type":"death","source_term":"梟其將軍尹盧","date_expression":null,"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-060","chapter_id":"c-sanguozhi-060-quancong","source_id":"s-sanguozhi-060-quancong","paragraph_id":"c-sanguozhi-060-quancong:line036","quote":"　　黃武元年，魏以舟軍大出洞口，權使呂範督諸將拒之，軍營相望。敵數以輕船抄擊，琮常帶甲仗兵，伺候不休。頃之，敵數千人出江中，琮擊破之，梟其將軍尹盧。遷琮綏南將軍，進封錢唐侯。四年，假節領九江太守。七年，權到皖，使琮與輔國將軍陸遜擊曹休，破之於石亭。是時丹楊、吳、會山民復為寇賊，攻沒屬縣，權分三郡險地為東安郡，琮領太守。至，明賞罰。招誘降附，數年中，得萬餘人。權召琮還牛渚，罷東安郡。黃龍元年，遷衛將軍、左護軍、徐州牧，尚公主。","person_mention_id":"c-sanguozhi-060-quancong:line036:m0071"}],"interpretation_note":"本來源所記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-sanguozhi-060-quancong:line036:m0071","start":71,"end":73,"surface":"尹盧","kind":"person","person_id":"gl0_1dv_9qo","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-060-quancong:line036","chapter_id":"c-sanguozhi-060-quancong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-060-quancong:line036","text":"　　黃武元年，魏以舟軍大出洞口，權使呂範督諸將拒之，軍營相望。敵數以輕船抄擊，琮常帶甲仗兵，伺候不休。頃之，敵數千人出江中，琮擊破之，梟其將軍尹盧。遷琮綏南將軍，進封錢唐侯。四年，假節領九江太守。七年，權到皖，使琮與輔國將軍陸遜擊曹休，破之於石亭。是時丹楊、吳、會山民復為寇賊，攻沒屬縣，權分三郡險地為東安郡，琮領太守。至，明賞罰。招誘降附，數年中，得萬餘人。權召琮還牛渚，罷東安郡。黃龍元年，遷衛將軍、左護軍、徐州牧，尚公主。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-060-quancong:line036:m0016","start":16,"end":17,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-quancong:line036:m0018"