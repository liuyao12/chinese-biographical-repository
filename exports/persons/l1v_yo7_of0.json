6,"end":8,"surface":"知伯","kind":"person","person_id":"l1v_yo7_of0","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p039","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m039-0058","start":58,"end":60,"surface":"知伯","kind":"person","person_id":"l1v_yo7_of0","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p039","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m039-0074","start":74,"end":76,"surface":"知伯","kind":"person","person_id":"l1v_yo7_of0","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p039","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m039-0106","start":106,"end":108,"surface":"知伯","kind":"person","person_id":"l1v_yo7_of0","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p039","chapter_id":"c-shiji-043-zhao"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji043-103","person_id":"l1v_yo7_of0","surfaces":["知伯"],"scope":"same_chapter","chapter_ids":["c-shiji-043-zhao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-043-zhao:p035","quote":"晉出公十一年，知伯伐鄭。趙簡子疾，使太子毋卹將而圍鄭。知伯醉，以酒灌撃毋卹。毋卹群臣請死之。毋卹曰：「君所以置毋卹，爲能忍訽。」然亦慍知伯。知伯歸，因謂簡子，使廢毋卹，簡子不聽。毋卹由此怨知伯。"},{"paragraph_id":"c-shiji-043-zhao:p039","quote":"襄子立四年，知伯與趙、韓、魏盡分其范、中行故地。晉出公怒，告齊、魯，欲以伐四卿。四卿恐，遂共攻出公。出公奔齊，道死。知伯乃立昭公曾孫驕，是爲晉懿公。知伯益驕。請地韓、魏，韓、魏與之。請地趙，趙不與，以其圍鄭之辱。知伯怒，遂率韓、魏攻趙。趙襄子懼，乃奔保晉陽。"}],"rationale":"限本篇連續敘事、是為、諡稱及明示親屬語境。周舍／周捨按諫臣同段暫接；兩位周、中山武公與趙武公、子朝與趙朝分開。圍鄭晉陽知伯與較早知伯文子仍分候選，不因同爵或熟知姓名合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-043-zhao:p035","text":"晉出公十一年，知伯伐鄭。趙簡子疾，使太子毋卹將而圍鄭。知伯醉，以酒灌撃毋卹。毋卹群臣請死之。毋卹曰：「君所以置毋卹，爲能忍訽。」然亦慍知伯。知伯歸，因謂簡子，使廢毋卹，簡子不聽。毋卹由此怨知伯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-043-zhao:m035-0000","start":0,"end":3,"surface":"晉出公","kind":"person","person_id":"