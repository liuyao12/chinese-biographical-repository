{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"o91_chj_aaw","canonical_person_id":"o91_chj_aaw","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["o91_chj_aaw"],"persons":[{"id":"o91_chj_aaw","label":"韓元興（北魏尚書，據梁山）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"韓元興","mention_ids":["c-songshu-050-yuanhuzhi-complete:p004:m0090"]}],"evidence":[{"mention_id":"c-songshu-050-yuanhuzhi-complete:p004:m0090","paragraph_id":"c-songshu-050-yuanhuzhi-complete:p004","chapter_id":"c-songshu-050-yuanhuzhi-complete","quote":"韓元興"}],"review":"ai_provisional","identity_note":"韓元興（北魏尚書，據梁山），以宋書卷五十垣護之傳的戰事辨識。"}],"source_mention_summary":[{"source_id":"s-songshu-050-yuanhuzhi-complete-ws2371899","work_id":"w-songshu","book_id":"b-songshu-050","chapter_id":"c-songshu-050-yuanhuzhi-complete","raw_mention_count":1,"mention_ids":["c-songshu-050-yuanhuzhi-complete:p004:m0090"],"paragraph_ids":["c-songshu-050-yuanhuzhi-complete:p004"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-songshu-050-yuanhuzhi-complete:p004:m0090","mention_ids":["c-songshu-050-yuanhuzhi-complete:p004:m0090"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-songshu-050-yuanhuzhi-complete-ws2371899"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-songshu-050-yuanhuzhi-complete:p004:m0090","start":90,"end":93,"surface":"韓元興","kind":"person","person_id":"o91_chj_aaw","status":"contextual_provisional","paragraph_id":"c-songshu-050-yuanhuzhi-complete:p004","chapter_id":"c-songshu-050-yuanhuzhi-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-songshu-050-yuanhuzhi-complete:p004","text":"還為江夏王義恭驃騎戶曹參軍，戍淮陰。加建武將軍，領濟北太守。率二千人復隨張永攻碻磝，先據委粟津。虜杜道儁與偽尚書伏連來援碻磝，護之拒之，賊因引軍東去。蕭思話遣護之迎軍至梁山，偽尚書韓元興率精騎卒至，護之依險拒戰，斬其都軍長史，甲首數十，賊乃退。思話將引還，誑護之云：「沈慶之救軍垂至，可急於濟口立橋。」護之揣知其意，即分遣白丁。思話復令度河戍乞活堡以防追軍。三十年春，太祖崩，還屯歷下。聞世祖入討，率所領馳赴，上嘉之，以為督冀州青州之濟南樂安太原三郡諸軍事、寧遠將軍、冀州刺史。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":48,"last_line":48,"raw_start":4050,"raw_end":4554,"raw_character_offsets":[4050,4051,4052,4053,4054,4055,4056,4057,4058,4059,4060,4061,4062,4063,4064,4065,4066,4067,4068,4069,4070,4071,4072,4073,4074,4075,4076,4077,4078,4079,4080,4081,4082,4083,4084,4085,4086,4087,4088,4089,4090,4091,4092,4093,4094,4095,4096,4097,4098,4099,4100,4101,4102,4103,4104,4105,4106,4107,4108,4109,4110,4111,4112,4186,4187,4188,4189,4190,4191,4192,4193,4194,4195,4196,4197,4198,4199,4200,4201,4202,4203,4204,4205,4206,4207,4208,4209,4210,4211,4212,4213,4214,4215,4216,4217,4218,4219,4220,4221,4222,4223,4224,4225,4226,4227,4228,4229,4230,4231,4232,4233,4234,4235,4236,4237,4238,4239,4240,4241,4242,4243,4244,4245,4246,4247,4248,4249,4250,4251,4252,4253,4254,4255,4256,4257,4258,4259,4260,4261,4262,4263,4264,4265,4266,4267,4268,4269,4270,4271,4272,4273,4274,4275,4276,4277,4278,4279,4280,4281,4282,4283,4284,4285,4286,4287,4288,4289,4290,4291,