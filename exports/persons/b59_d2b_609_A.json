","person_id":"b59_d2b_609_A","status":"contextual_provisional"}],"chapter_id":"c-liangshu-020-chen-huya-zhangchong","book_id":"b-liangshu-020","work_id":"w-liangshu","source_id":"s-liangshu-020-chen-huya-zhangchong-ws1506948"},{"id":"c-nanqishu-049-zhangchong:p006","text":"明年二月，梁王出沔口，圍魯山城。遣軍主曹景宗等過江攻郢城，未及盡濟，沖遣中兵參軍陳光靜等開門出擊，爲義師所破，光靜戰死，沖固守不出。景宗於是據石橋浦，連軍相續，下至加湖。東昏遣軍主巴西梓潼二郡太守吳子陽、光子衿、李文釗、陳虎牙等十三軍援郢，至加湖不得進，乃築城舉烽，城內亦舉火應之。而內外各自保，不能相救。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":62,"last_line":62,"raw_start":4298,"raw_end":4451,"raw_character_offsets":[4298,4299,4300,4301,4302,4303,4304,4305,4306,4307,4308,4309,4310,4311,4312,4313,4314,4315,4316,4317,4318,4319,4320,4321,4322,4323,4324,4325,4326,4327,4328,4329,4330,4331,4332,4333,4334,4335,4336,4337,4338,4339,4340,4341,4342,4343,4344,4345,4346,4347,4348,4349,4350,4351,4352,4353,4354,4355,4356,4357,4358,4359,4360,4361,4362,4363,4364,4365,4366,4367,4368,4369,4370,4371,4372,4373,4374,4375,4376,4377,4378,4379,4380,4381,4382,4383,4384,4385,4386,4387,4388,4389,4390,4391,4392,4393,4394,4395,4396,4397,4398,4399,4400,4401,4402,4403,4404,4405,4406,4407,4408,4409,4410,4411,4412,4413,4414,4415,4416,4417,4418,4419,4420,4421,4422,4423,4424,4425,4426,4427,4428,4429,4430,4431,4432,4433,4434,4435,4436,4437,4438,4439,4440,4441,4442,4443,4444,4445,4446,4447,4448,4449,4450],"revision_id":2261984},"mentions":[{"id":"c-nanqishu-049-zhangchong:p006:m0019","start":19,"end":22,"surface":"曹景宗","kind":"person","person_id":"a02_614_f84_A","status":"contextual_provisional"},{"id":"c-nanqishu-049-zhangchong:p006:m0034","start":34,"end":35,"surface":"沖","kind":"person","person_id":"d50_8f5_wul_AAACBB","status":"contextual_provisional"},{"id":"c-nanqishu-049-zhangchong:p006:m0040","start":40,"end":43,"surface":"陳光靜","kind":"person","person_id":"e11_33f_2ec","status":"contextual_provisional"},{"id":"c-nanqishu-049-zhangchong:p006:m0055","start":55,"end":57,"surface":"光靜","kind":"person","person_id":"e11_33f_2