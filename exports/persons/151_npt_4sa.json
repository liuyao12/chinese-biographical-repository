{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"151_npt_4sa","canonical_person_id":"151_npt_4sa","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["151_npt_4sa"],"persons":[{"id":"151_npt_4sa","label":"驪姬（龜策列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"驪姬","mention_ids":["c-shiji-128-guice:m004-0083"]}],"evidence":[{"mention_id":"c-shiji-128-guice:m004-0083","chapter_id":"c-shiji-128-guice","paragraph_id":"c-shiji-128-guice:p004","quote":"驪姬"}]}],"source_mention_summary":[{"source_id":"s-shiji128-guice","work_id":"w-shiji","book_id":"b-shiji-128","chapter_id":"c-shiji-128-guice","mention_count":1,"mention_ids":["c-shiji-128-guice:m004-0083"],"paragraph_ids":["c-shiji-128-guice:p004"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji128-guice"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-128-guice:m004-0083","start":83,"end":85,"surface":"驪姬","kind":"person","person_id":"151_npt_4sa","status":"contextual_provisional","paragraph_id":"c-shiji-128-guice:p004","chapter_id":"c-shiji-128-guice"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-128-guice:p004","text":"夫摓策定數，灼龜觀兆，變化無窮，是以擇賢而用占焉，可謂聖人重事者乎！周公卜三龜，而武王有瘳。紂為暴虐，而元龜不占。晉文將定襄王之位，卜得黃帝之兆，卒受彤弓之命。獻公貪驪姬之色，卜而兆有口象，其禍竟流五世。楚靈將背周室，卜而龜逆，終被乾谿之敗。兆應信誠於內，而時人明察見之於外，可不謂兩合者哉！君子謂夫輕卜筮，無神明者，悖；背人道，信禎祥者，鬼神不得其正。故書建稽疑，五謀而卜筮居其二，五占從其多，明有而不專之道也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-128-guice:m004-0034","start":34,"end":36,"surface":"周公","kind":"person","person_id":"7bh_cjo_tgj","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m004-0041","start":41,"end":43,"surface":"武王","kind":"person","person_id":"4mt_tfo_obl","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m004-0046","start":46,"end":47,"surface":"紂","kind":"person","person_id":"ouo_jje_54i","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m004-0057","start":57,"end":59,"surface":"晉文","kind":"person","person_id":"3mh_bbn_f5z","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m004-0061","start":61,"end":63,"surface":"襄王","kind":"person","person_id":"92v_7sv_bs6","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m004-0068","start":68,"end":70,"surface":"黃帝","kind":"person","person_id":"oo3_xcl_jsi","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m004-0080","start":80,"end":82,"surface":"獻公","kind":"person","person_id":"4qg_5t3_7uq","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m004-0083","start":83,"end":85,"surface":"驪姬","kind":"person","person_id":"151_npt_4sa","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m004-0102","start":102,"end":104,"surface":"楚靈","kind":"person","person_id":"nd6_46s_u58","status":"contextual_provisional"}],"chapter_id":"c-shiji-128-guice","book_id":"b-shiji-128","work_id":"w-shiji","source_id":"s-shiji128-guice"}],"sources":[{"chapter_id":"c-shiji-128-guice","work_id":"w-shiji","book_id":"b-shiji-128","source_id":"s-shiji128-guice","source":{"title":"史記／卷128","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷128","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷128&oldid=7904127","revision_id":7904127,"accessed_on":"2026-10-11","extent":"固定修訂全文95段，篇文5段、褚先生補文89段、索隱述贊1段。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"ht