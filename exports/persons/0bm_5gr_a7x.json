_A","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m010-0258","start":258,"end":262,"surface":"常山王義","kind":"person","person_id":"zht_ze7_m2d","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m010-0263","start":263,"end":264,"surface":"帝","kind":"person","person_id":"zht_ze7_m2d","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m010-0268","start":268,"end":269,"surface":"弘","kind":"person","person_id":"zht_ze7_m2d","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m010-0277","start":277,"end":279,"surface":"太后","kind":"person","person_id":"i30_mjq_6q8_A","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m010-0286","start":286,"end":289,"surface":"軹侯朝","kind":"person","person_id":"4tb_tcb_9tq","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m010-0299","start":299,"end":302,"surface":"絳侯勃","kind":"person","person_id":"koy_6jg_gcc","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m010-0318","start":318,"end":322,"surface":"壺關侯武","kind":"person","person_id":"x8h_bgr_mc5","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m010-0332","start":332,"end":334,"surface":"太后","kind":"person","person_id":"i30_mjq_6q8_A","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m010-0335","start":335,"end":338,"surface":"呂王嘉","kind":"person","person_id":"woj_cq6_ajq","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m010-0347","start":347,"end":350,"surface":"肅王台","kind":"person","person_id":"acg_se3_w5x_A","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m010-0351","start":351,"end":353,"surface":"呂產","kind":"person","person_id":"acg_se3_w5x_B","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m010-0364","start":364,"end":368,"surface":"齊悼惠王","kind":"person","person_id":"yqp_nlb_p1p_AB","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m010-0369","start":369,"end":371,"surface":"興居","kind":"person","person_id":"yqp_nlb_p1p_ABC","status":"contextual_provisional"}],"chapter_id":"c-shiji-009-lvhou","book_id":"b-shiji-009","work_id":"w-shiji","source_id":"s-shiji-009-lvhou"},{"id":"c-shiji-057-zhou:p008","text":"勃既定燕而歸，高祖已崩矣，以列侯事孝惠帝。孝惠帝六年，置太尉官，以勃為太尉。十歲，高后崩。呂祿以趙王為漢上將軍，呂產以呂王為漢相國，秉漢權，欲危劉氏。勃為太尉，不得入軍門。陳平為丞相，不得任事。於是勃與平謀，卒誅諸呂而立孝文皇帝。其語在呂后、孝文事中。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-057-zhou:m008-0000","start":0,"end":1,"surface":"勃","kind":"person","person_id":"koy_6jg_gcc","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m008-0007","start":7,"end":9,"surface":"高祖","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m008-0017","start":17,"end":20,"surface":"孝惠帝","kind":"person","person_id":"6c5_di7_e68","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m008-0021","start":21,"end":24,"surface":"孝惠帝","kind":"person","person_id":"6c5_di7_e68","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m008-0033","start":33,"end":34,"surface":"勃","kind":"person","person_id":"koy_6jg_gcc","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m008-0041","start":41,"end":43,"surface":"高后","kind":"person","person_id":"i30_mjq_6q8_A","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m008-0045","start":45,"end":47,"surface":"呂祿","kind":"person","person_id":"561_608_i0z","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m008-0056","start":56,"end":58,"surface":"呂產","kind":"person","person_id":"acg_se3_w5x_B","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m008-0072","start":72,"end":74,"surface":"劉氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者、假設侯嗣、職署或未定回指；不補姓名、親屬成員或爵位所指。"},{"id":"c-shiji-057-zhou:m008-0075","start":75,"end":76,"surface":"勃","kind":"person","person_id":"koy_6jg_gcc","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m008-0086","start":86,"end":88,"surface":"陳平","kind":"person","person_id":"i3f_9l9_g53","status"