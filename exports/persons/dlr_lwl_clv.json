v","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p047","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-070-zhang:m047-0038","start":38,"end":40,"surface":"大王","kind":"person","person_id":"dlr_lwl_clv","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p047","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-070-zhang:m047-0041","start":41,"end":43,"surface":"大王","kind":"person","person_id":"dlr_lwl_clv","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p047","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-070-zhang:m047-0066","start":66,"end":68,"surface":"大王","kind":"person","person_id":"dlr_lwl_clv","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p047","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-070-zhang:m047-0094","start":94,"end":96,"surface":"大王","kind":"person","person_id":"dlr_lwl_clv","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p047","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-070-zhang:m048-0023","start":23,"end":24,"surface":"王","kind":"person","person_id":"dlr_lwl_clv","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p048","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-070-zhang:m048-0057","start":57,"end":59,"surface":"大王","kind":"person","person_id":"dlr_lwl_clv","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p048","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-070-zhang:m049-0000","start":0,"end":2,"surface":"燕王","kind":"person","person_id":"dlr_lwl_clv","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p049","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-070-zhang:m049-0052","start":52,"end":54,"surface":"燕王","kind":"person","person_id":"dlr_lwl_clv","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p049","chapter_id":"c-shiji-070-zhang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji070-036","person_id":"dlr_lwl_clv","scope":"same_chapter","chapter_ids":["c-shiji-070-zhang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"依第46至51段明示名字與引語範圍暫接，趙襄子姊與代王的故事另存未名；秦武王與秦惠王依卒立語境分開。韓王趙王及趙先王不按年代記憶補名；蘇秦謀齊的燕王齊王另存候選，不強與其他王同指或斷為異人。孟賁烏獲是比擬人物，不作在場者；紂為引古。擬議秦楚太子質子與秦女婚姻保留未解。","surfaces":["大王","燕昭王","燕王","王"],"evidence":[{"paragraph_id":"c-shiji-070-zhang:p046","quote":"北之燕，說燕昭王曰：「大王之所親莫如趙。昔趙襄子嘗以其姊為代王妻，欲并代，約與代王遇於句注之塞。乃令工人作為金斗，長其尾，令可以擊人。與代王飲，陰告廚人曰：『即酒酣樂，進熱啜，反鬬以擊之。』於是酒酣樂，進熱啜，廚人進斟，因反鬬以擊代王，殺之，王腦涂地。其姊聞之，因摩笄以自刺，故至今有摩笄之山。代王之亡，天下莫不聞。"},{"paragraph_id":"c-shiji-070-zhang:p047","quote":"「夫趙王之很戾無親，大王之所明見，且以趙王為可親乎？趙興兵攻燕，再圍燕都而劫大王，大王割十城以謝。今趙王已入朝澠池，效河閒以事秦。今大王不事秦，秦下甲雲中、九原，驅趙而攻燕，則易水、長城非大王之有也。"},{"paragraph_id":"c-shiji-070-zhang:p048","quote":"「且今時趙之於秦猶郡縣也，不敢妄舉師以攻伐。今王事秦，秦王必喜，趙不敢妄動，是西有彊秦之援，而南無齊趙之患，是故願大王孰計之。」"},{"paragraph_id":"c-shiji-070-zhang:p049","quote":"燕王曰：「寡人蠻夷僻處，雖大男子裁如嬰兒，言不足以采正計。今上客幸教之，請西面而事秦，獻恒山之尾五城。」燕王聽儀。儀歸報，未至咸陽而秦惠王卒，武王立。武王自為太子時不說張儀，及即位，群臣多讒張儀曰：「無信，左右賣國以取容。秦必復用之，恐為天下笑。」諸侯聞張儀有卻武王，皆畔衡，復合從。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-070-zhang:p046","text":"北之燕，說燕昭王曰：「大王之所親莫如趙。昔趙襄子嘗以其姊為代王妻，欲并代，約與代王遇於句注之塞。乃令工人作為金斗，長其尾，令可以擊人。與代王飲，陰告廚人曰：『即酒酣樂，進熱啜，反鬬以擊之。』於是酒酣樂，進熱啜，廚人進斟，因反鬬以擊代王，殺之，王腦涂地。其姊聞之，因摩笄以自刺，故至今有摩笄之山。代王之亡，天下莫不聞。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-070-zhang:m046-0005","start":5,"end":8,"surface":"燕昭王","kind":"person","person_id":"dlr_lwl_clv","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m046-0011","start":11,"end":13,"surface":"大王","kind":"person","person_id":"dlr_lwl_clv","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m046-0021","start":21,"end":24,"surface":"趙襄子","kind":"person","person_id":"rgy_07p_qo9","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m046-0026","start":26,"end":28,"surface":"其姊","kind":"person","person_id":"h2o_6n8_bid","status":"contextual_