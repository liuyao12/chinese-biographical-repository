ion_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-095-fankuang:m010-0184","start":184,"end":186,"surface":"孝景","kind":"person","person_id":"uvx_q8x_ou4","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p010","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:m015-0000","start":0,"end":2,"surface":"孝景","kind":"person","person_id":"uvx_q8x_ou4","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p015","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:m015-0057","start":57,"end":59,"surface":"孝景","kind":"person","person_id":"uvx_q8x_ou4","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p015","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:m015-0073","start":73,"end":75,"surface":"景帝","kind":"person","person_id":"uvx_q8x_ou4","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p015","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:m015-0087","start":87,"end":89,"surface":"景帝","kind":"person","person_id":"uvx_q8x_ou4","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p015","chapter_id":"c-shiji-095-fankuang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji095-041","person_id":"uvx_q8x_ou4","scope":"same_chapter","chapter_ids":["c-shiji-095-fankuang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["孝景","景帝"],"evidence":[{"paragraph_id":"c-shiji-095-fankuang:p010","quote":"孝惠六年，樊噲卒，謚為武侯。子伉代侯。而伉母呂須亦為臨光侯，高后時用事專權，大臣盡畏之。伉代侯九歲，高后崩。大臣誅諸呂、呂須婘屬，因誅伉。舞陽侯中絕數月。孝文帝既立，乃復封噲他庶子市人為舞陽侯，復故爵邑。市人立二十九歲卒，謚為荒侯。子他廣代侯。六歲，侯家舍人得罪他廣，怨之，乃上書曰：「荒侯市人病不能為人，令其夫人與其弟亂而生他廣，他廣實非荒侯子，不當代後。」詔下吏。孝景中六年，他廣奪侯為庶人，國除。"},{"paragraph_id":"c-shiji-095-fankuang:p015","quote":"孝景前三年，吳、楚、齊、趙反，上以寄為將軍，圍趙城，十月不能下。得俞侯欒布自平齊來，乃下趙城，滅趙，王自殺，除國。孝景中二年，寄欲取平原君為夫人，景帝怒，下寄吏，有罪，奪侯。景帝乃以商他子堅封為繆侯，續酈氏後。繆靖侯卒，子康侯遂成立。遂成卒，子懷侯世宗立。世宗卒，子侯終根立，為太常，坐法，國除。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定異稱。酈寄字況據第14段；夏侯嬰的嬰限定第16至21段，灌嬰限定第22至33段，桓嬰另人。第6與20、28段楚王信和反韓王信分人；未詳名王侯不補名。同名跨篇同指另待逐項證據。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-095-fankuang:p010","text":"孝惠六年，樊噲卒，謚為武侯。子伉代侯。而伉母呂須亦為臨光侯，高后時用事專權，大臣盡畏之。伉代侯九歲，高后崩。大臣誅諸呂、呂須婘屬，因誅伉。舞陽侯中絕數月。孝文帝既立，乃復封噲他庶子市人為舞陽侯，復故爵邑。市人立二十九歲卒，謚為荒侯。子他廣代侯。六歲，侯家舍人得罪他廣，怨之，乃上書曰：「荒侯市人病不能為人，令其夫人與其弟亂而生他廣，他廣實非荒侯子，不當代後。」詔下吏。孝景中六年，他廣奪侯為庶人，國除。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m010-0000","start":0,"end":2,"surface":"孝惠","kind":"person","person_id":"2u6_7bk_902","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m010-0005","start":5,"end":7,"surface":"樊噲","kind":"person","person_id":"d9y_q1n_fte","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m010-0015","start":15,"end":16,"surface":"伉","kind":"person","person_id":"d9y_q1n_fte_B","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m010-0020","start":20,"end":21,"surface":"伉","kind":"person","person_id":"d9y_q1n_fte_B","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m010-0022","start":22,"end":24,"surface":"呂須","kind":"person","person_id":"vqw_ylp_5mq","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m010-0030","start":30,"end":32,"surface":"高后","kind":"person","person_id":"mrj_1jl_2tk","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m010-0044","start":44,"end":45,"surface":"伉","kind":"person","person_id":"d9y_q1n_fte_B","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m010-0050","start":50,"end":52,"surface":"高后","kind":"person","person_id":"mrj_1jl_2tk","status":"contextual_provisional"},{"id":"c-shiji-095-fankua