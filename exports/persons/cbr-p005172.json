_provisional"},{"id":"c-shiji-093-hanlu:m005-0021","start":21,"end":22,"surface":"信","kind":"person","person_id":"cbr-p005152","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m005-0035","start":35,"end":38,"surface":"曼丘臣","kind":"person","person_id":"cbr-p005161","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m005-0039","start":39,"end":41,"surface":"王黃","kind":"person","person_id":"cbr-p005174","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m005-0046","start":46,"end":48,"surface":"趙利","kind":"person","person_id":"cbr-p005175","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m005-0053","start":53,"end":54,"surface":"信","kind":"person","person_id":"cbr-p005152","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m005-0060","start":60,"end":61,"surface":"信","kind":"person","person_id":"cbr-p005152","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m005-0062","start":62,"end":64,"surface":"冒頓","kind":"person","person_id":"cbr-p005172","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m005-0080","start":80,"end":82,"surface":"王黃","kind":"person","person_id":"cbr-p005174","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m005-0145","start":145,"end":147,"surface":"冒頓","kind":"person","person_id":"cbr-p005172","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m005-0154","start":154,"end":157,"surface":"高皇帝","kind":"person","person_id":"cbr-p005157","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m005-0164","start":164,"end":166,"surface":"冒頓","kind":"person","person_id":"cbr-p005172","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m005-0175","start":175,"end":176,"surface":"上","kind":"person","person_id":"cbr-p005157","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m005-0181","start":181,"end":182,"surface":"上","kind":"person","person_id":"cbr-p005157","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m005-0190","start":190,"end":