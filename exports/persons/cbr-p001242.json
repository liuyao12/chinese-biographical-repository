person_id":"c18_pif_asp","status":"contextual_provisional","paragraph_id":"c-shiji-033-lu:p044","chapter_id":"c-shiji-033-lu"},{"id":"c-shiji-033-lu:m044-0068","start":68,"end":69,"surface":"犖","kind":"person","person_id":"c18_pif_asp","status":"contextual_provisional","paragraph_id":"c-shiji-033-lu:p044","chapter_id":"c-shiji-033-lu"},{"id":"c-shiji-033-lu:m044-0078","start":78,"end":79,"surface":"犖","kind":"person","person_id":"c18_pif_asp","status":"contextual_provisional","paragraph_id":"c-shiji-033-lu:p044","chapter_id":"c-shiji-033-lu"},{"id":"c-shiji-033-lu:m046-0036","start":36,"end":39,"surface":"圉人犖","kind":"person","person_id":"c18_pif_asp","status":"contextual_provisional","paragraph_id":"c-shiji-033-lu:p046","chapter_id":"c-shiji-033-lu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji033-076","person_id":"c18_pif_asp","surfaces":["圉人犖","犖"],"scope":"same_chapter","chapter_ids":["c-shiji-033-lu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-033-lu:p044","quote":"三十二年，初，莊公筑臺臨黨氏，見孟女，說而愛之，許立爲夫人，割臂以盟。孟女生子斑。斑長，說梁氏女，往觀。圉人犖自墻外與梁氏女戲。斑怒，鞭犖。莊公聞之，曰：『犖有力焉，遂殺之，是未可鞭而置也。』斑未得殺，會莊公有疾。"},{"paragraph_id":"c-shiji-033-lu:p046","quote":"先時慶父與哀姜私通，欲立哀姜娣子開。及莊公卒而季友立斑，十月己未，慶父使圉人犖殺魯公子斑於黨氏。季友奔陳。慶父竟立莊公子開，是爲湣公。"}],"rationale":"按懿公被弒至魯文公的敘事角色、同段明示子／弟與柯盟、齊襄公殺魯桓公、晉立惠公等具體事件暫定異稱；同字爵稱依國別分開。公子揮不與前篇公子翚、晉襄父不與晉襄公、宣伯不與叔孫宣伯自動合併。數位疑讀與親屬異說仍待核對。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-033-lu:p044","text":"三十二年，初，莊公筑臺臨黨氏，見孟女，說而愛之，許立爲夫人，割臂以盟。孟女生子斑。斑長，說梁氏女，往觀。圉人犖自墻外與梁氏女戲。斑怒，鞭犖。莊公聞之，曰：『犖有力焉，遂殺之，是未可鞭而置也。』斑未得殺，會莊公有疾。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-033-lu:m044-0007","start":7,"end":9,"surface":"莊公","kind":"person","person_id":"x50_1p7_qkk","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m044-0012","start":12,"en