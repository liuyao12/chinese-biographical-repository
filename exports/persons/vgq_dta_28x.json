count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"3處獨立位置，3個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-sanguozhi-048-sun-liang-ws2085142"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-048-sun-liang:p010:m0200","surface":"孫憲","start":200,"end":202,"kind":"person","person_id":"vgq_dta_28x","status":"contextual_provisional","paragraph_id":"c-sanguozhi-048-sun-liang:p010","chapter_id":"c-sanguozhi-048-sun-liang"},{"id":"c-sanguozhi-048-sun-liang:p010:m0273","surface":"孫憲","start":273,"end":275,"kind":"person","person_id":"vgq_dta_28x","status":"contextual_provisional","paragraph_id":"c-sanguozhi-048-sun-liang:p010","chapter_id":"c-sanguozhi-048-sun-liang"},{"id":"c-sanguozhi-048-sun-liang:p010:m0292","surface":"憲","start":292,"end":293,"kind":"person","person_id":"vgq_dta_28x","status":"contextual_provisional","paragraph_id":"c-sanguozhi-048-sun-liang:p010","chapter_id":"c-sanguozhi-048-sun-liang"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-048-sun-liang:p010","text":"太平元年春二月朔，建業火。峻用征北大將軍文欽計，將征魏。八月，先遣欽及驃騎呂據、車騎劉纂、鎮南朱異、前將軍唐咨軍自江都入淮、泗。九月丁亥，峻卒，以從弟偏將軍綝爲侍中、武衞將軍，領中外諸軍事，召還據等。據聞綝代峻，大怒。己丑，大司馬呂岱卒。壬辰，太白犯南斗。據、欽、咨等表薦衞將軍滕胤爲丞相，綝不聽。癸卯，更以胤爲大司馬，代呂岱駐武昌。據引兵還，欲討綝。綝遣使以詔書告喻欽、咨等，使取據。冬十月丁未，遣孫憲及丁奉、施寬等以舟兵逆據於江都，遣將軍劉丞督步騎攻胤。胤兵敗夷滅。己酉，大赦，改年。辛亥，獲呂據於新州。十一月，以綝爲大將軍、假節，封永康侯。孫憲與將軍王惇謀殺綝，事覺，綝殺惇，迫憲令自殺。十二月，使五官中郎將刁玄告亂于蜀。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":24,"last_line":24,"raw_start":1218,"raw_end":1576,"raw_character_offsets":[1230,1231,1232,1233,1241,1267,1268,1269,1270,1271,1272,1273,1274,1275,1276,1277,1278,1279,1280,1281,1282,1283,1284,1285,1286,1287,1288,1289,1290,1291,1292,1293,1294,1295,1296,1297,1298,1299,1300,1301,1302,1303,1304,1305,1306,1307,1308,1309,1310,1311,1312,1313,1314,1315,1316,1317,1318,1319,1320,1321,1322,1323,1324,1325,1326,1327,1328,1329,1330,1331,1332,1333,1334,1335,1336,1337,1338,1339,1340,1341,1342,1343,1344,1345,1346,1347,1348,1349,1350,1351,1352,1353,1354,1355,1356,1357,1358,1359,1360,1361,1362,1363,1364,1365,1366,1367,1368,1369,1370,1371,1372,1373,1374,1375,1376,1377,1378,1379,1380,1381,1382,1383,1384,1385,1386,1387,1388,1389,1390,1391,1392,1393,1394,1395,1396,1397,1398,1399,1400,1401,1402,1403,1404,1405,1406,1407,1408,1409,1410,1411,1412,1413,1414,1415,1416,1417,1418,1419,1420,1421,1422,1423,1424,1425,1426,1427,1428,1429,1430,1431,1432,1433,1434,1435,1436,1437,1438,1439,1440,1441,1442,1443,1444,1445,1446,1447,1448,1449,1450,1451,1452,1453,1454,1455,1456,1457,1458,1459,1460,1461,1462,1463,1464,1465,1466,1467,1468,1469,1470,1471,1472,1473,1474,1475,1476,1477,1478,1479,1480,1481,1482,1483,1484,1485,1486,1487,1488,1489,1490,1491,1492,1493,1494,1495,1496,1497,1498,1499,1500,1501,1502,1503,1504,1505,1506,1507,1508,1509,1510,1511,1512,1513,1514,1515,1516,1517,1518,1519,1520,1521,1522,1523,1524,1525,1526,1527,1528,1529,1530,1531,1532,1533,1534,1535,1536,1537,1538,1539,1540,1541,1542,1543,1544,1545,1546,1547,1548,1549,1550,1551,1552,1553,1554,1555,1556,1557,1558,1559,1560,1561,1562,1563,1564,1565,1566,1567,1568,1569,1570,1571,1572,1573,1574,1575],"revision_id":2085142},"mentions":[{"id"