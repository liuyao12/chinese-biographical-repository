:319,"person_id":"799_f6c_778","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-063-guomo:p005:m0326","surface":"默","start":326,"end":327,"person_id":"799_f6c_778","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-063-guomo:p005:m0330","surface":"愆期","start":330,"end":332,"person_id":"dhx_wp0_d3a","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-063-guomo:p005:m0337","surface":"桓宣","start":337,"end":339,"person_id":"qak_wzz_t6i","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-063-guomo","book_id":"b-jinshu-063","work_id":"w-jinshu","source_id":"s-jinshu-063-guomo-ws2025242"},{"id":"c-jinshu-066-taokan:p017","text":"遣子斌與南中郎將桓宣西伐樊城，走石勒將郭敬。使兄子臻、竟陵太守李陽等共破新野，遂平襄陽。拜大將軍，劍履上殿，入朝不趨，贊拜不名。上表固讓，曰：「臣非貪於疇昔，而虛讓於今日。事有合于時宜，臣豈敢與陛下有違；理有益於聖世，臣豈與朝廷作異。臣常欲除諸浮長之事，遣諸虛假之用，非獨臣身而已。若臣杖國威靈，梟雄斬勒，則又何以加！」咸和七年六月疾篤，又上表遜位曰：","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":61,"last_line":61,"raw_start":7557,"raw_end":7742,"raw_character_offsets":[7559,7560,7561,7562,7563,7564,7565,7566,7567,7568,7569,7570,7571,7572,7573,7574,7575,7576,7577,7578,7579,7580,7581,7582,7583,7584,7585,7586,7587,7588,7589,7590,7591,7592,7593,7594,7595,7596,7597,7598,7599,7600,7601,7602,7603,7604,7605,7606,7607,7608,7609,7610,7611,7612,7613,7614,7615,7616,7617,7618,7619,7620,7621,7622,7623,7624,7625,7626,7627,7628,7629,7630,7631,7632,7633,7634,7635,7636,7637,7638,7639,7640,7641,7642,7643,7644,7645,7646,7647,7648,7649,7650,7651,7652,7653,7654,7655,7656,7657,7658,7659,7660,7661,7662,7663,7664,7665,7666,7667,7668,7669,7670,7671,7672,7673,7674,7675,7676,7677,7678,7679,7680,7681,7682,7683,7684,7685,7686,7687,7688,7689,7690,7691,7692,7693,7694,7695,7696,7697,7698,7699,7700,7701,7702,7703,7704,7705,7706,7707,7708,7709,7710,7711,7712,7713,7714,7715,7716,7717,7718,7724,7725,7726,7727,7730,7731,7732,7733,7734,7735,7736,7737,7738,7739,7740,7741],"revision_id":1527632},"mentions":[{"id":"c-jinshu-066-taokan:p017:m0002","surface":"斌","start":2,"end":3,"person_id":"byj_6mo_vpe","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p017:m0008","surface":"桓宣","start":8,"end":10,"person_id":"qak_wzz_t6i","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p017:m0016","surface":"石勒","start":16,"end":18,"person_id":"0c9_95a_18b","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p017:m0019","surface":"郭敬","start":19,"end":21,"person_id":"jaj_wtk_lgm","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p017:m0025","surface":"臻","start":25,"end":26,"person_id":"zyf_30n_e5t","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p017:m0031","surface":"李陽","start":31,"end":33,"person_id":"3se_4j0_fhb","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-066-taokan","book_id":"b-jinshu-066","work_id":"w-jinshu","source_id":"s-jinshu-066-taokan-ws1527632"},{"id":"c-jinshu-066-taokan:p018","text":"臣少長孤寒，始願有限。過蒙聖朝曆世殊恩、陛下睿鑒，寵靈彌泰。有始必終，自古而然。臣年垂八十，位極人臣，啟手啟足，當復何恨！但以陛下春秋尚富，餘寇不誅，山陵未反，所以憤愾兼懷，不能已已。臣雖不知命，年時已邁，國恩殊特，賜封長沙，隕越之日，當歸骨國土。臣父母舊葬，今在尋陽，緣存處亡，無心分違，已勒國臣修遷改之事，刻以來秋，奉迎窀穸，葬事訖，乃告老下籓。不圖所患，遂爾綿篤，伏枕感結，情不自勝。臣間者猶為犬馬之齒尚可小延，欲為陛下西平李雄，北吞石季龍，是以遣毌丘奧於巴東，授桓宣於襄陽。良圖未敘，於此長乖！此方之任，內外之要，願陛下速選臣代使，必得良才，奉宣王猷，遵成臣志，則臣死之日猶生之年。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":63,"last_line":63,"raw_start":7744,"raw_end":8041,"raw_character_offsets":[7746,7747,7748,7749,7750,7751,7752,7753,7754,7755,7756,7757,7758,7759,7760,7761,7762,7763,7764,7765,7766,7767,7768,7769,7770,7771,7772,7773,7774,7775,7776,7777,7778,7779,7780,7781,7782,7783,7784,7785,7786,7787,7788,7789,7790,7791,7792,7793,7794,7795,7796,7797,7798,7799,7800,7801,7802,7803,7804,7805,7806,7807,7808,7809,7810,7811,7812,7813,7814,7815,7816,7817,7818,7819,7820,7821,7822,7823,7824,7825,7826,7827,7828,7829,7830,7831,7832,7833,7834,7835,7836,7837,7838,7839,7840,7841,7842,7843,7844,78