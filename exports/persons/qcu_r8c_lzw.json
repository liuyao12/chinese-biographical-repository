_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-035-peixiu-peiwei:p028:m0169","start":169,"end":171,"surface":"陳午","kind":"person","person_id":"qcu_r8c_lzw","status":"source_explicit","paragraph_id":"c-jinshu-035-peixiu-peiwei:p028","chapter_id":"c-jinshu-035-peixiu-peiwei"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-035-peixiu-peiwei:p028","text":"初，趙王倫諂事賈后，頠甚惡之，倫數求官，頠與張華復固執不許，由是深為倫所怨。倫又潛懷篡逆，欲先除朝望，因廢賈后之際遂誅之，時年三十四。二子嵩、該，倫亦欲害之。梁王肜、東海王越稱頠父秀有勳王室，配食太廟，不宜滅其後嗣，故得不死，徙帶方；惠帝反正，追復頠本官，改葬以卿禮，諡曰成。以嵩嗣爵，為中書黃門侍郎。該出後從伯凱，為散騎常侍，並為乞活賊陳午所害。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-035-peixiu-peiwei:p028:m0002","start":2,"end":5,"surface":"趙王倫","kind":"person","person_id":"dkn_ge4_286_AAAAG","status":"contextual_provisional","interpretation_note":"完整裴秀／裴頠單元的具名、當時職位及敘事事件與已錄同時期seed相合；不由單純同名自動合。"},{"id":"c-jinshu-035-peixiu-peiwei:p028:m0007","start":7,"end":9,"surface":"賈后","kind":"person","person_id":"jmv_vc4_gep_*AAA","status":"contextual_provisional","interpretation_note":"完整裴秀／裴頠單元的具名、當時職位及敘事事件與已錄同時期seed相合；不由單純同名自動合。"},{"id":"c-jinshu-035-peixiu-peiwei:p028:m0010","start":10,"end":11,"surface":"頠","kind":"person","person_id":"kbq_kjc_n2f_AAB","status":"source_explicit"},{"id":"c-jinshu-035-peixiu-peiwei:p028:m0015","start":15,"end":16,"surface":"倫","kind":"person","person_id":"dkn_ge4_286_AAAAG","status":"contextual_provisional","interpretation_note":"完整裴秀／裴頠單元的具名、當時職位及敘事事件與已錄同時期seed相合；不由單純同名自動合。"},{"id":"c-jinshu-035-peixiu-peiwei:p028:m0020","start":20,"end":21,"surface":"頠","kind":"person","person_id":"kbq_kjc_n2f_AAB","status":