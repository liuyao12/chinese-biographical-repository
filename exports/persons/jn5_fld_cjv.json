{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"jn5_fld_cjv","canonical_person_id":"jn5_fld_cjv","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["jn5_fld_cjv"],"persons":[{"id":"jn5_fld_cjv","label":"高帝（袁盎鼂錯列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"高帝","mention_ids":["c-shiji-101-yuanchao:m010-0158"]}],"evidence":[{"mention_id":"c-shiji-101-yuanchao:m010-0158","chapter_id":"c-shiji-101-yuanchao","paragraph_id":"c-shiji-101-yuanchao:p010","quote":"高帝"}]}],"source_mention_summary":[{"source_id":"s-shiji-101-yuanchao","work_id":"w-shiji","book_id":"b-shiji-101","chapter_id":"c-shiji-101-yuanchao","mention_count":1,"mention_ids":["c-shiji-101-yuanchao:m010-0158"],"paragraph_ids":["c-shiji-101-yuanchao:p010"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-101-yuanchao"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-101-yuanchao:m010-0158","start":158,"end":160,"surface":"高帝","kind":"person","person_id":"jn5_fld_cjv","status":"contextual_provisional","paragraph_id":"c-shiji-101-yuanchao:p010","chapter_id":"c-shiji-101-yuanchao"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji101-022","person_id":"jn5_fld_cjv","surfaces":["高帝"],"scope":"same_chapter","chapter_ids":["c-shiji-101-yuanchao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-101-yuanchao:p010","quote":"盎告歸，道逢丞相申屠嘉，下車拜謁，丞相從車上謝袁盎。袁盎還，愧其吏，乃之丞相舍上謁，求見丞相。丞相良久而見之。盎因跪曰：「願請閒。」丞相曰：「使君所言公事，之曹與長史掾議，吾且奏之；即私邪，吾不受私語。」袁盎即跪說曰：「君為丞相，自度孰與陳平、絳侯？」丞相曰：「吾不如。」袁盎曰：「善，君即自謂不如。夫陳平、絳侯輔翼高帝，定天下，為將相，而誅諸呂，存劉氏；君乃為材官蹶張，遷為隊率，積功至淮陽守，非有奇計攻城野戰之功。且陛下從代來，每朝，郎官上書疏，未嘗不止輦受其言，言不可用置之，言可受採之，未嘗不稱善。何也？則欲以致天下賢士大夫。上日聞所不聞，明所不知，日益聖智；君今自閉鉗天下之口而日益愚。夫以聖主責愚相，君受禍不久矣。」丞相乃再拜曰：「嘉鄙野人，乃不知，將軍幸教。」引入與坐，為上客。"}],"rationale":"按本傳明示姓名、字及敘事承接；皇帝上字逐處依文景敘事核定，建元上另留未名。兄噲不合樊噲，兄子種不補具名父親。身份及官稱回指為代理首輪判讀，非人工覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-101-yuanchao:p010","text":"盎告歸，道逢丞相申屠嘉，下車拜謁，丞相從車上謝袁盎。袁盎還，愧其吏，乃之丞相舍上謁，求見丞相。丞相良久而見之。盎因跪曰：「願請閒。」丞相曰：「使君所言公事，之曹與長史掾議，吾且奏之；即私邪，吾不受私語。」袁盎即跪說曰：「君為丞相，自度孰與陳平、絳侯？」丞相曰：「吾不如。」袁盎曰：「善，君即自謂不如。夫陳平、絳侯輔翼高帝，定天下，為將相，而誅諸呂，存劉氏；君乃為材官蹶張，遷為隊率，積功至淮陽守，非有奇計攻城野戰之功。且陛下從代來，每朝，郎官上書疏，未嘗不止輦受其言，言不可用置之，言可受採之，未嘗不稱善。何也？則欲以致天下賢士大夫。上日聞所不聞，明所不知，日益聖智；君今自閉鉗天下之口而日益愚。夫以聖主責愚相，君受禍不久矣。」丞相乃再拜曰：「嘉鄙野人，乃不知，將軍幸教。」引入與坐，為上客。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-101-yuanchao:m010-0000","start":0,"end":1,"surface":"盎","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m010-0008","start":8,"end":11,"surface":"申屠嘉","kind":"person","person_id":"olo_0sp_7bd","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m010-0023","start":23,"end":25,"surface":"袁盎","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m010-0026","start":26,"end":28,"surface":"袁盎","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m010-0055","start":55,"end":56,"surface":"盎","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m010-0102","start":102,"end":104,"surface":"袁盎","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m010-0119","start":119,"end":121,"surface":"陳平","kind":"person","person_id":"n9g_zzh