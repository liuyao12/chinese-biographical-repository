ovisional","evidence":[{"chapter_id":"c-shiji-103-wanshi","source_id":"s-shiji-103-wanshi","paragraph_id":"c-shiji-103-wanshi:p024","quote":"御史大夫張叔者，名歐，安丘侯説之庶子也。孝文時以治刑名言事太子。然歐雖治刑名家，其人長者。景帝時尊重，常爲九卿。至武帝元朔四年，韓安國免，詔拜歐爲御史大夫。自歐爲吏，未嘗言案人，專以誠長者處官。官屬以爲長者，亦不敢大欺。上具獄事，有可卻，卻之；不可者，不得已，爲涕泣面對而封之。其愛人如此。"}],"interpretation_note":"明示父子或祖孫；分支字母不表示出生次序，孫望的父親不指定相如。","reviewer":"Codex（AI 代理）","human_reviewed":false,"parent_person_id":"afj_vl8_7fu"}}],"source_mention_summary":[{"source_id":"s-shiji-103-wanshi","work_id":"w-shiji","book_id":"b-shiji-103","chapter_id":"c-shiji-103-wanshi","mention_count":7,"mention_ids":["c-shiji-103-wanshi:m024-0004","c-shiji-103-wanshi:m024-0009","c-shiji-103-wanshi:m024-0033","c-shiji-103-wanshi:m024-0071","c-shiji-103-wanshi:m024-0079","c-shiji-103-wanshi:m026-0030","c-shiji-103-wanshi:m027-0032"],"paragraph_ids":["c-shiji-103-wanshi:p024","c-shiji-103-wanshi:p026","c-shiji-103-wanshi:p027"],"passage_count":3}],"most_mentioned_source_ids":["s-shiji-103-wanshi"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji103-013","subject_person_id":"afj_vl8_7fu_A","predicate":"father","object_person_id":"afj_vl8_7fu","status":"source_attested","evidence":[{"chapter_id":"c-shiji-103-wanshi","source_id":"s-shiji-103-wanshi","paragraph_id":"c-shiji-103-wanshi:p024","quote":"御史大夫張叔者，名歐，安丘侯説之庶子也。孝文時以治刑名言事太子。然歐雖治刑名家，其人長者。景帝時尊重，常爲九卿。至武帝元朔四年，韓安國免，詔拜歐爲御史大夫。自歐爲吏，未嘗言案人，專以誠長者處官。官屬以爲長者，亦不敢大欺。上具獄事，有可卻，卻之；不可者，不得已，爲涕泣面對而封之。其愛人如此。"}],"qualifiers":{"source_term":"安丘侯説之庶子","historicity":"historical_tradition","parentage_description":"庶子","birth_ordinal":null},"interpretation_note":"明示來源親屬與排行分存；甲乙為失名佔位，孫望不指定相如為父，不依誣告盜嫂補兄嫂。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conf