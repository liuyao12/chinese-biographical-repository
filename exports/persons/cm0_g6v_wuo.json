{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cm0_g6v_wuo","canonical_person_id":"cm0_g6v_wuo","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["cm0_g6v_wuo"],"persons":[{"id":"cm0_g6v_wuo","label":"申伯（《崧高》）","status":"active","historicity":"historical_tradition","aliases":[],"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-023","source_id":"s-nanqishu-023-wangjian-ws1545488","chapter_id":"c-nanqishu-023-wangjian","paragraph_id":"c-nanqishu-023-wangjian:p006","quote":"申","kind":"person_reference","mention_id":"c-nanqishu-023-wangjian:p006:r0401"}],"review":"ai_provisional","identity_note":"齊高帝所引《詩·大雅·崧高》稱申，詩中稱申伯。"}],"source_mention_summary":[],"most_mentioned_source_ids":[],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[],"relations":[],"title_holdings":[],"address_assertions":[],"person_references":[{"id":"c-nanqishu-023-wangjian:p006:r0401","paragraph_id":"c-nanqishu-023-wangjian:p006","person_id":"cm0_g6v_wuo","quote":"　　上壞宋明帝紫極殿，以材柱起宣陽門。儉與褚淵及叔父僧虔連名上表諫曰：「臣聞德者身之基，儉者德之輿。春臺將立，晉卿秉議，北宮肇構，漢臣盡規。彼二君者，或列國常侯，或守文中主，尚使諫諍在義卽悅，況陛下聖哲應期，臣等職司隆重，敢藉前誥，竊乃有心。陛下登庸宰物，節省之教旣昭，龍袞琁極，簡約之訓彌遠。乾華外構，采椽不斲，紫極故材，爲宣陽門，臣等未譬也。夫移心疾於股肱，非良醫之美；畏影迹而馳騖，豈靜處之方？且又三農在日，千畛咸事，輟望歲之勤，興土木之役，非所以宣昭大猷，光示遐邇。若以門居宮南，重陽所屬，年月稍久，漸就淪胥，自可隨宜脩理而合度，改作之煩，於是乎息。所啓謬合，請付外施行。」上手詔酬納。宋世外六門設竹籬，是年初，有發白虎樽者，言「白門三重門，竹籬穿不完」。上感其言，改立都墻。儉又諫，上答曰：「吾欲令後世無以加也。」朝廷初基，制度草創，儉識舊事，問無不答。上歎曰：「《詩》云：『維嶽降神，生甫及申。』今亦天爲我生儉也。」","note":"見《詩·大雅·崧高》「亹亹申伯」。","referent_role":"third_person","start":401,"end":402,"surface":"申","chapter_id":"c-nanqishu-023-wangjian","book_id":"b-nanqishu-023","work_id":"w-nanqishu","source_id":"s-nanqishu-023-wangjian-ws1545488"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-023-wangjian:p006","text":"　　上壞宋明帝紫極殿，以材柱起宣陽門。儉與褚淵及叔父僧虔連名上表諫曰：「臣聞德者身之基，儉者德之輿。春臺將立，晉卿秉議，北宮肇構，漢臣盡規。彼二君者，或列國常侯，或守文中主，尚使諫諍在義卽悅，況陛下聖哲應期，臣等職司隆重，敢藉前誥，竊乃有心。陛下登庸宰物，節省之教旣昭，龍袞琁極，簡約之訓彌遠。乾華外構，采椽不斲，紫極故材，爲宣陽門，臣等未譬也。夫移心疾於股肱，非良醫之美；畏影迹而馳騖，豈靜處之方？且又三農在日，千畛咸事，輟望歲之勤，興土木之役，非所以宣昭大猷，光示遐邇。若以門居宮南，重陽所屬，年月稍久，漸就淪胥，自可隨宜脩理而合度，改作之煩，於是乎息。所啓謬合，請付外施行。」上手詔酬納。宋世外六門設竹籬，是年初，有發白虎樽者，言「白門三重門，竹籬穿不完」。上感其言，改立都墻。儉又諫，上答曰：「吾欲令後世無以加也。」朝廷初基，制度草創，儉識舊事，問無不答。上歎曰：「《詩》云：『維嶽降神，生甫及申。』今亦天爲我生儉也。」","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-nanqishu-023-wangjian:p006:m0019","person_id":"7r6_k52_qji_ABAAAAEAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段實名及敘述視點。","start":19,"end":20,"surface":"儉"},{"id":"c-nanqishu-023-wangjian:p006:m0021","person_id":"jyx_72x_8t2","kind":"person","status":"contextual_provisional","interpretation_note":"依本段實名及敘述視點。","start":21,"end":23,"surface":"褚淵"},{"id":"c-nanqishu-023-wangjian:p006:m0026","person_id":"7r6_k52_qji_ABAAAAEB","kind":"person","status":"contextual_provisional","interpretation_note":"依本段實名及敘述視點。","start":26,"end":28,"surface":"僧虔"},{"id":"c-nanqishu-023-wangjian:p006:u0036","person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"合指同上表三人或所舉漢魏兩朝人物。","start":36,"end":37,"surface":"臣","candidate_person_ids":["7r6_k52_qji_ABAAAAEAA","jyx_72x_8t2","7r6_k52_qji_ABAAAAEB"]},{"id":"c-nanqishu-023-wangjian:p006:u0055","person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"晉臣諫築臺的典故，該表未具名。","start":55,"end":57,"surface":"晉卿"},{"i