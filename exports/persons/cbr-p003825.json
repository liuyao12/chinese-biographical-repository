03825","status":"contextual_provisional","paragraph_id":"c-shiji-066-wu:p009","chapter_id":"c-shiji-066-wu"}],"relations":[{"id":"a-shiji031-030","subject_person_id":"cbr-p001059","predicate":"father","object_person_id":"cbr-p001035","status":"source_attested","evidence":[{"chapter_id":"c-shiji-031-wu","source_id":"s-shiji-031-wu","paragraph_id":"c-shiji-031-wu:p019","quote":"四年，王餘眛卒，欲授弟季札。季札讓，逃去。於是吳人曰：「先王有命，兄卒弟代立，必致季子。季子今逃位，則王餘眛後立。今卒，其子當代。」乃立王餘眛之子僚爲王。"}],"qualifiers":{"source_term":"之子","historicity":"historical_tradition"},"interpretation_note":"只保存本篇明示父母、祖父、兄弟或妃關係；夏史引語保留敘事來源，不補未見姓名、闕代或同父同母。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji031-006","person_id":"cbr-p001059","title":"王","kind":"royal_rank","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-031-wu","source_id":"s-shiji-031-wu","paragraph_id":"c-shiji-031-wu:p019","quote":"乃立王餘眛之子僚爲王。"}],"attestations":[{"id":"th-shiji031-006:a001","paragraph_id":"c-shiji-031-wu:p019","start":75,"end":76,"surface":"王","person_mention_id":"c-shiji-031-wu:m019-0073","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-031-wu","source_id":"s-shiji-031-wu","paragraph_id":"c-shiji-031-wu:p019","quote":"乃立王餘眛之子僚爲王。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"來源授予、自立與用稱分開；日期只錄原表述，不以死亡自動終止官爵。夫槩自立與闔廬爭位分存，不選唯一合法王號。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji066-006","person_id":"cbr-p003825","title":"吳王","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-066-wu","source_id":"s-shiji-066-wu","paragraph_id":"c-shiji-066-wu:p006","quote":"伍胥既至宋，宋有華氏之亂，乃與太子建俱奔於鄭。鄭人甚善之。太子建又適晉，晉頃公曰：「太子既善鄭，鄭信太子。太子能為我內應，而我攻其外，滅鄭必矣。滅鄭而封太子。」太子乃還鄭。事未會，會自私欲殺其從者，從者知其謀，乃告之於鄭。鄭定公與子產誅殺太子建。建有子名勝。伍胥懼，乃與勝俱奔吳。到昭關，昭關欲執之。伍胥遂與勝獨身步走，幾不得脫。追者在後。至江，江上有一漁父乘船，知伍胥之急，乃渡伍胥。伍胥既渡，解其劍曰：「此劍直百金，以與父。」父曰：「楚國之法，得伍胥者賜粟五萬石，爵執珪，豈徒百金劍邪！」不受。伍胥未至吳而疾，止中道，乞食。至於吳，吳王僚方用事，公子光為將。伍胥乃因公子光以求見吳王。"}],"attestations":[{"id":"th-shiji066-006:a001","paragraph_id":"c-shiji-066-wu:p006","start":268,"end":270,"surface":"吳王","person_mention_id":"c-shiji-066-wu:m006-0268","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授官事件與文獻用稱分存。首次提及、逃亡、死亡不推定任期終點；平王、昭王、闔廬、夫差王稱隨敘事分辨。夫概自立王不作合法授爵，封堂谿未補侯爵；王子綦佯充王及石乞事成為卿的未遂條件均不當實際任職。白公的號與封邑分存，未確定爵級。來源相對年序未換算為精確紀年，版本及稱號性質仍待覆核。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji031-034","person_id":"cbr-p001059","surfaces":["僚","王僚"],"scope":"same_chapter","chapter_ids":["c-shiji-031-wu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-031-wu:p019","quote":"四年，王餘眛卒，欲授弟季札。季札讓，逃去。於是吳人曰：「先王有命，兄卒弟代立，必致季子。季子今逃位，則王餘眛後立。今卒，其子當代。」乃立王餘眛之子僚爲王。"},{"paragraph_id":"c-shiji-031-wu:p020","quote":"王僚二年，公子光伐楚，敗而亡王舟。光懼，襲楚，復得王舟而還。"},{"paragraph_id":"c-shiji-031-wu:p021","quote":"五年，楚之亡臣伍子胥來奔，公子光客之。公子光者，王諸樊之子也。常以爲吾父兄弟四人，當傳至季子。季子即不受國，光父先立。即不傳季子，光當立。陰納賢士，欲以襲王僚。"},{"paragraph_id":"c-shiji-031-wu:p023","quote":"伍子胥之初奔吳，説吳王僚以伐楚之利。公子光曰：「胥之父兄爲僇於楚，欲自報其仇耳。未見其利。」於是伍員知光有他志，乃求勇士專諸，見之光。光喜，乃客伍子胥。子胥退而耕於野，以待專諸之事。"},{"paragraph_id":"c-shiji-031-wu:p024","quote":"十二年冬，楚平王卒。十三年春，吳欲因楚喪而伐之，使公子蓋餘、燭庸以兵圍楚之六、灊。使季札於晉，以觀諸侯之變。楚發兵絶吳兵後，吳兵不得還。於是吳公子光曰：「此時不可失也。」告專諸曰：「不索何獲！我眞王嗣，當立，吾欲求之。季子雖至，不吾廢也。」專諸曰：「王僚可殺也。母老子弱，而兩公子將兵攻楚，楚絶其路。方今吳外困於楚，而內空無骨鯁之臣，是無奈我何。」光曰：「我身，子之身也。」四月丙子，光伏甲士於窟室，而謁王僚飲。王僚使兵陳於道，自王宮至光之家，門階戶席，皆王僚之親也，人夾持鈹。公子光詳爲足疾，入於窟室，使專諸置匕首於炙魚之中以進食。手匕首刺王僚，鈹交於匈，遂弑王僚。公子光竟代立爲王，是爲吳王闔廬。闔廬乃以專諸子爲卿。"},{"paragraph_id":"c-shiji-031-wu:p025","quote":"季子至，曰：「苟先君無廢祀，民人無廢主，社稷有奉，乃吾君也。吾敢誰怨乎？哀死事生，以待天命。非我生亂，立者從之，先人之道也。」復命，哭僚墓，復位而待。吳公子燭庸、蓋餘二人將兵遇圍於楚者，聞公子光弑王僚自立，乃以其兵降楚，楚封之於舒。"}],"rationale":"按本卷弑僚代立、伐楚入郢、吳越戰事或所引夏史的敘事語境暫定異稱；光／闔廬、伍員／子胥及子常／囊瓦有具體事件相接。前卷闔閭與本卷闔廬原字並存；來源記載不等於已校定史實。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji036-045","person_id":"cbr-p001059","surfaces":["吳王僚"],"scope":"cross_chapter","chapter_ids":["c-shiji-031-wu","c-shiji-036-chenqi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-031-wu:p019","quote":"四年，王餘眛卒，欲授弟季札。季札讓，逃去。於是吳人曰：「先王有命，兄卒弟代立，必致季子。季子今逃位，則王餘眛後立。今卒，其子當代。」乃立王餘眛之子僚爲王。"},{"paragraph_id":"c-shiji-036-chenqi:p023","quote":"十年，陳火。十五年，吳王僚使公子光伐陳，取胡、沈而去。二十八年，吳王闔閭與子胥敗楚入郢。是年，惠公卒，子懷公柳立。"}],"rationale":"本篇第23段按明示名與稱號、陳／杞世系及具體敘事暫定「吳王僚」同指；引句均保留，不按同名字面跨篇合併。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji066-018","person_id":"cbr-p003825","surfaces":["吳王","吳王僚","王","王僚"],"scope":"same_chapter","chapter_ids":["c-shiji-066-wu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-066-wu:p006","quote":"伍胥既至宋，宋有華氏之亂，乃與太子建俱奔於鄭。鄭人甚善之。太子建又適晉，晉頃公曰：「太子既善鄭，鄭信太子。太子能為我內應，而我攻其外，滅鄭必矣。滅鄭而封太子。」太子乃還鄭。事未會，會自私欲殺其從者，從者知其謀，乃告之於鄭。鄭定公與子產誅殺太子建。建有子名勝。伍胥懼，乃與勝俱奔吳。到昭關，昭關欲執之。伍胥遂與勝獨身步走，幾不得脫。追者在後。至江，江上有一漁父乘船，知伍胥之急，乃渡伍胥。伍胥既渡，解其劍曰：「此劍直百金，以與父。」父曰：「楚國之法，得伍胥者賜粟五萬石，爵執珪，豈徒百金劍邪！」不受。伍胥未至吳而疾，止中道，乞食。至於吳，吳王僚方用事，公子光為將。伍胥乃因公子光以求見吳王。"},{"paragraph_id":"c-shiji-066-wu:p007","quote":"久之，楚平王以其邊邑鐘離與吳邊邑卑梁氏俱蠶，兩女子爭桑相攻，乃大怒，至於兩國舉兵相伐。吳使公子光伐楚，拔其鐘離、居巢而歸。伍子胥說吳王僚曰：「楚可破也。願復遣公子光。」公子光謂吳王曰：「彼伍胥父兄為戮於楚，而勸王伐楚者，欲以自報其讎耳。伐楚未可破也。」伍胥知公子光有內志，欲殺王而自立，未可說以外事，乃進專諸於公子光，退而與太子建之子勝耕於野。"},{"paragraph_id":"c-shiji-066-wu:p008","quote":"五年而楚平王卒。初，平王所奪太子建秦女生子軫，及平王卒，軫竟立為後，是為昭王。吳王僚因楚喪，使二公子將兵往襲楚。楚發兵絕吳兵之後，不得歸。吳國內空，而公子光乃令專諸襲刺吳王僚而自立，是為吳王闔廬。闔廬既立，得志，乃召伍員以為行人，而與謀國事。"},{"paragraph_id":"c-shiji-066-wu:p009","quote":"楚誅其大臣郤宛、伯州犁，伯州犁之孫伯嚭亡奔吳，吳亦以嚭為大夫。前王僚所遣二公子將兵伐楚者，道絕不得歸。後聞闔廬弒王僚自立，遂以其兵降楚，楚封之於舒。闔廬立三年，乃興師與伍胥、伯嚭伐楚，拔舒，遂禽故吳反二將軍。因欲至郢，將軍孫武曰：「民勞，未可，且待之。」乃歸。"}],"rationale":"依本篇明示姓名及局部敘事暫接異稱：公子光自立為闔廬、軫立為昭王、勝號白公；王稱隨敘事主體分段。王子綦佯充王不接昭王，與後文司馬子綦暫分候選但不斷言異人。悼公與陽生按本文分存，矛盾待版本覆核；鮑氏不強接鮑牧。未名父子只按本段明示保存，不補姓名。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji066-liao","person_ids":["cbr-p001059","cbr-p003825"],"canonical_person_id":"cbr-p001059","scope":"cross_chapter","chapter_ids":["c-shiji-031-wu","c-shiji-066-wu"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-031-wu","source_id":"s-shiji-031-wu","paragraph_id":"c-shiji-031-wu:p024","quote":"十二年冬，楚平王卒。十三年春，吳欲因楚喪而伐之，使公子蓋餘、燭庸以兵圍楚之六、灊。使季札於晉，以觀諸侯之變。楚發兵絶吳兵後，吳兵不得還。於是吳公子光曰：「此時不可失也。」告專諸曰：「不索何獲！我眞王嗣，當立，吾欲求之。季子雖至，不吾廢也。」專諸曰：「王僚可殺也。母老子弱，而兩公子將兵攻楚，楚絶其路。方今吳外困於楚，而內空無骨鯁之臣，是無奈我何。」光曰：「我身，子之身也。」四月丙子，光伏甲士於窟室，而謁王僚飲。王僚使兵陳於道，自王宮至光之家，門階戶席，皆王僚之親也，人夾持鈹。公子光詳爲足疾，入於窟室，使專諸置匕首於炙魚之中以進食。手匕首刺王僚，鈹交於匈，遂弑王僚。公子光竟代立爲王，是爲吳王闔廬。闔廬乃以專諸子爲卿。","mention_ids":["c-shiji-031-wu:m024-0125","c-shiji-031-wu:m024-0202","c-shiji-031-wu:m024-0206","c-shiji-031-wu:m024-0228","c-shiji-031-wu:m024-0271","c-shiji-031-wu:m024-0281"]},{"chapter_id":"c-shiji-066-wu","source_id":"s-shiji-066-wu","paragraph_id":"c-shiji-066-wu:p008","quote":"五年而楚平王卒。初，平王所奪太子建秦女生子軫，及平王卒，軫竟立為後，是為昭王。吳王僚因楚喪，使二公子將兵往襲楚。楚發兵絕吳兵之後，不得歸。吳國內空，而公子光乃令專諸襲刺吳王僚而自立，是為吳王闔廬。闔廬既立，得志，乃召伍員以為行人，而與謀國事。","mention_ids":["c-shiji-066-wu:m008-0039","c-shiji-066-wu:m008-0084"]}],"rationale":"兩篇同記楚平王卒後吳王僚遣公子伐楚、軍隊被阻，公子光使專諸刺僚而自立。未用二公子群體反推個別成員。 已發ID及各篇原文保留。同書各篇不作獨立見證；同指不代表年代、敘事或稱號任期已核定。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-031-wu:p019","text":"四年，王餘眛卒，欲授弟季札。季札讓，逃去。於是吳人曰：「先王有命，兄卒弟代立，必致季子。季子今逃位，則王餘眛後立。今卒，其子當代。」乃立王餘眛之子僚爲王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-031-wu:m019-0003","start":3,"end":6,"surface":"王餘眛","kind":"person","person_id":"cbr-p001035","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m019-0011","start":11,"end":13,"surface":"季札","kind":"person","person_id":"cbr-p001036","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m019-0014","start":14,"end":16,"surface":"季札","kind":"person","person_id":"cbr-p001036","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m019-0023","start":23,"end":25,"surface":"吳人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、族稱或未定指代；有虞等不直接補作熟知個人，仍待覆核。"},{"id":"c-shiji-031-wu:m019-0028","start":28,"end":30,"surface":"先王","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、族稱或未定指代；有虞等不直接補作熟知個人，仍待覆核。"},{"id":"c-shiji-031-wu:m019-0041","start":41,"end":43,"surface":"季子","kind":"person","person_id":"cbr-p001036","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m019-0044","start":44,"end":46,"surface":"季子","kind":"person","person_id":"cbr-p001036","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m019-0051","start":51,"end":54,"surface":"王餘眛","kind":"person","person_id":"cbr-p001035","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m019-0068","start":68,"end":71,"surface":"王餘眛","kind":"person","person_id":"cbr-p001035","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m019-0073","start":73,"end":74,"surface":"僚","kind":"person","person_id":"cbr-p001059","status":"contextual_provisional"}],"chapter_id":"c-shiji-031-wu","book_id":"b-shiji-031","work_id":"w-shiji","source_id":"s-shiji-031-wu"},{"id":"c-shiji-031-wu:p020","text":"王僚二年，公子光伐楚，敗而亡王舟。光懼，襲楚，復得王舟而還。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-031-wu:m020-0000","start":0,"end":2,"surface":"王僚","kind":"person","person_id":"cbr-p001059","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m020-0005","start":5,"end":8,"surface":"公子光","kind":"person","person_id":"cbr-p000424","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m020-0017","start":17,"end":18,"surface":"光","kind":"person","person_id":"cbr-p000424","status":"contextual_provisional"}],"chapter_id":"c-shiji-031-wu","book_id":"b-shiji-031","work_id":"w-shiji","source_id":"s-shiji-031-wu"},{"id":"c-shiji-031-wu:p021","text":"五年，楚之亡臣伍子胥來奔，公子光客之。公子光者，王諸樊之子也。常以爲吾父兄弟四人，當傳至季子。季子即不受國，光父先立。即不傳季子，光當立。陰納賢士，欲以襲王僚。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-031-wu:m021-0007","start":7,"end":10,"surface":"伍子胥","kind":"person","person_id":"cbr-p000423","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m021-0013","start":13,"end":16,"surface":"公子光","kind":"person","person_id":"cbr-p000424","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m021-0019","start":19,"end":22,"surface":"公子光","kind":"person","person_id":"cbr-p000424","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m021-0024","start":24,"end":27,"surface":"王諸樊","kind":"person","person_id":"cbr-p001033","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m021-0044","start":44,"end":46,"surface":"季子","kind":"person","person_id":"cbr-p001036","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m021-0047","start":47,"end":49,"surface":"季子","kind":"person","person_id":"cbr-p001036","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m021-0054","start":54,"end":55,"surface":"光","kind":"person","person_id":"cbr-p000424","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m021-0062","start":62,"end":64,"surface":"季子","kind":"person","person_id":"cbr-p001036","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m021-0065","start":65,"end":66,"surface":"光","kind":"person","person_id":"cbr-p000424","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m021-0077","start":77,"end":79,"surface":"王僚","kind":"person","person_id":"cbr-p001059","status":"contextual_provisional"}],"chapter_id":"c-shiji-031-wu","book_id":"b-shiji-031","work_id":"w-shiji","source_id":"s-shiji-031-wu"},{"id":"c-shiji-031-wu:p023","text":"伍子胥之初奔吳，説吳王僚以伐楚之利。公子光曰：「胥之父兄爲僇於楚，欲自報其仇耳。未見其利。」於是伍員知光有他志，乃求勇士專諸，見之光。光喜，乃客伍子胥。子胥退而耕於野，以待專諸之事。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-031-wu:m023-0000","start":0,"end":3,"surface":"伍子胥","kind":"person","person_id":"cbr-p000423","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m023-0010","start":10,"end":12,"surface":"王僚","kind":"person","person_id":"cbr-p001059","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m023-0018","start":18,"end":21,"surface":"公子光","kind":"person","person_id":"cbr-p000424","status":"co