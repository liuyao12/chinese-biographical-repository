t":249,"end":251,"surface":"伍胥","kind":"person","person_id":"cbr-p003808","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m006-0268","start":268,"end":271,"surface":"吳王僚","kind":"person","person_id":"cbr-p003825","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m006-0275","start":275,"end":278,"surface":"公子光","kind":"person","person_id":"cbr-p003826","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m006-0281","start":281,"end":283,"surface":"伍胥","kind":"person","person_id":"cbr-p003808","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m006-0285","start":285,"end":288,"surface":"公子光","kind":"person","person_id":"cbr-p003826","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m006-0291","start":291,"end":293,"surface":"吳王","kind":"person","person_id":"cbr-p003825","status":"contextual_provisional"}],"chapter_id":"c-shiji-066-wu","book_id":"b-shiji-066","work_id":"w-shiji","source_id":"s-shiji-066-wu"},{"id":"c-shiji-066-wu:p007","text":"久之，楚平王以其邊邑鐘離與吳邊邑卑梁氏俱蠶，兩女子爭桑相攻，乃大怒，至於兩國舉兵相伐。吳使公子光伐楚，拔其鐘離、居巢而歸。伍子胥說吳王僚曰：「楚可破也。願復遣公子光。」公子光謂吳王曰：「彼伍胥父兄為戮於楚，而勸王伐楚者，欲以自報其讎耳。伐楚未可破也。」伍胥知公子光有內志，欲殺王而自立，未可說以外事，乃進專諸於公子光，退而與太子建之子勝耕於野。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-066-wu:m007-0003","start":3,"end":6,"surface":"楚平王","kind":"person","person_id":"cbr-p003813","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m007-0022","start":22,"end":25,"surface":"兩女子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代，未補姓名及成員；鮑氏不直接等同鮑牧。"},{"id":"c-shiji-066-wu:m007-0045","start":45,"end":48,"surface":"公子光","kind":"person","person_id":"cbr-p003826","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m007-0061","start":61,"end":64,"surface":"伍子胥","kind":"person","person_id":"cbr-p003808","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m007-0065","start":65,"end":68,"surface":"吳王僚","kind":"person","person_id":"cbr-p003825","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m007-0079","start":79,"end":82,"surface":"公子光","kind":"person","person_id":"cbr-p003826","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m007-0084","start":84,"end":87,"surface":"公子光","kind":"person","person_id":"cbr-p003826","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m007-0088","start":88,"end":90,"surface":"吳王","kind":"person","person_id":"cbr-p003825","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m007-0094","start":94,"end":96,"surface":"伍胥","kind":"person","person_id":"cbr-p003808","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m007-0096","start":96,"end":98,"surface":"父兄","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代，未補姓名及成員；鮑氏不直接等同鮑牧。"},{"id":"c-shiji-066-wu:m007-0105","start":105,"end":106,"surface":"王","kind":"person","person_id":"cbr-p003825","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m007-0126","start":126,"end":128,"surface":"伍胥","kind":"person","person_id":"cbr-p003808","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m007-0129","start":129,"end":132,"surface":"公子光","kind":"person","person_id":"cbr-p003826","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m007-0138","start":138,"end":139,"surface":"王","kind":"person","person_id":"cbr-p003825","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m007-0152","start":152,"end":154,"surface":"專諸","kind":"person","person_id":"cbr-p003828","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m007-0155","start":155,"end":158,"surface":"公子光","kind":"person","person_id":"cbr-p003826","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m007-0162","start":162,"end":165,"surface":"太子建","kind":"person","person_id":"cbr-p003814","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m007-0167","start":167,"end":168,"surface":"勝","kind":"person","person_id":"cbr-p003823","status":"contextual_provisional"}],"chapter_id":"c-shiji-066-wu","book_id":"b-shiji-066","work_id":"w-shiji","source_id":"s-shiji-066-wu"},{"id":"c-shiji-066-wu:p008","text":"五年而楚平王卒。初，平王所奪太子建秦女生子軫，及平王卒，軫竟立為後，是為昭王。吳王僚因楚喪，使二公子將兵往襲楚。楚發兵絕吳兵之後，不得歸。吳國內空，而公子光乃令專諸襲刺吳王僚而自立，是為吳王闔廬。闔廬既立，得志，乃召伍員以為行人，而與謀國事。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-066-wu:m008-0003","start":3,"end":6,"surface":"楚平王","kind":"person","person_id":"cbr-p003813","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m008-0010","start":10,"end":12,"surface":"平王","kind":"person","person_id":"cbr-p003813","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m008-0014","start":14,"end":17,"surface":"太子建","kind":"person","person_id":"cbr-p003814","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m008-0017","start":17,"end":19,"surface":"秦女","kind":"person","person_id":"cbr-p003816","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m008-0021","start":21,"end":22,"surface":"軫","kind":"person","person_id":"cbr-p003817","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m008-0024","start":24,"end":26,"surface":"平王","kind":"person","person_id":"cbr-p003813","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m008-0028","start":28,"end":29,"surface":"軫","kind":"person","person_id":"cbr-p003817","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m008-0036","start":36,"end":38,"surface":"昭王","kind":"person","person_id":"cbr-p003817","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m008-0039","start":39,"end":42,"surface":"吳王僚","kind":"person","person_id":"cbr-p003825","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m008-0047","start":47,"end":50,"surface":"二公子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代，未補姓名及成員；鮑氏不直接等同鮑牧。"},{"id":"c-shiji-066-wu:m008-0075","start":75,"end":78,"surface":"公子光","kind":"person","person_id":"cbr-p003826","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m008-0080","start":80,"end":82,"surface":"專諸","kind":"person","person_id":"cbr-p003828","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m008-0084","start":84,"end":87,"surface":"吳王僚","kind":"person","person_id":"cbr-p003825","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m008-0093","start":93,"end":97,"surface":"吳王闔廬","kind":"person","person_id":"cbr-p003826","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m008-0098","start":98,"end":100,"surface":"闔廬","kind":"person","person_id":"cbr-p003826","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m008-0108","start":108,"end":110,"surface":"伍員","kind":"person","person_id":"cbr-p003808","status":"contextual_provisional"}],"chapter_id":"c-shiji-066-wu","book_id":"b-shiji-066","work_id":"w-shiji","source_id":"s-shiji-066-wu"},{"id":"c-shiji-066-wu:p009","text":"楚誅其大臣郤宛、伯州犁，伯州犁之孫伯嚭亡奔吳，吳亦以嚭為大夫。前王僚所遣二公子將兵伐楚者，道絕不得歸。後聞闔廬弒王僚自立，遂以其兵降楚，楚封之於舒。闔廬立三年，乃興師與伍胥、伯嚭伐楚，拔舒，遂禽故吳反二將軍。因欲至郢，將軍孫武曰：「民勞，未可，且待之。」乃歸。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-066-wu:m009-0005","start":5,"end":7,"surface":"郤宛","kind":"person","person_id":"cbr-p003829","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m009-0008","start":8,"end":11,"surface":"伯州犁","kind":"person","person_id":"cbr-p003830","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m009-0012","start":12,"end":15,"surface":"伯州犁","kind":"person","person_id":"cbr-p003830","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m009-0017","start":17,"end":19,"surface":"伯嚭","kind":"person","person_id":"cbr-p003831","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m009-0026","start":26,"end":27,"surface":"嚭","kind":"person","person_id":"cbr-p003831","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m009-0032","start":32,"end":34,"surface":"王僚","kind":"person","person_id":"cbr-p003825","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m009-0036","start":36,"end":39,"surface":"二公子","kind":"unresolved","person_id":null,"status":"unresolved","n