xt_layer":"received_chapter","mentions":[{"id":"c-shiji-031-wu:m024-0005","start":5,"end":8,"surface":"楚平王","kind":"person","person_id":"cbr-p000421","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m024-0027","start":27,"end":29,"surface":"蓋餘","kind":"person","person_id":"cbr-p001061","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m024-0030","start":30,"end":32,"surface":"燭庸","kind":"person","person_id":"cbr-p001062","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m024-0042","start":42,"end":44,"surface":"季札","kind":"person","person_id":"cbr-p001036","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m024-0071","start":71,"end":74,"surface":"公子光","kind":"person","person_id":"cbr-p000424","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m024-0086","start":86,"end":88,"surface":"專諸","kind":"person","person_id":"cbr-p001060","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m024-0109","start":109,"end":111,"surface":"季子","kind":"person","person_id":"cbr-p001036","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m024-0120","start":120,"end":122,"surface":"專諸","kind":"person","person_id":"cbr-p001060","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m024-0125","start":125,"end":127,"surface":"王僚","kind":"person","person_id":"cbr-p001059","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m024-0131","start":131,"end":135,"surface":"母老子弱","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、族稱或未定指代；有虞等不直接補作熟知個人，仍待覆核。"},{"id":"c-shiji-031-wu:m024-0137","start":137,"end":140,"surface":"兩公子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、族稱或未定指代；有虞等不直接補作熟知個人，仍待覆核。"},{"id":"c-shiji-031-wu:m024-0174","start":174,"end":175,"surface":"光","kind":"person","person_id":"cbr-p000424","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m024-0192","start":192,"end":193,"surface":"光","kind":"person","person_id":"cbr-p000424","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m024-0202","start":202,"end":204,"surface":"王僚","kind":"person","person_id":"cbr-p001059","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m024-0206","start":206,"end":208,"surface":"王僚","kind":"person","person_id":"cbr-p001059","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m024-0218","start":218,"end":219,"surface":"光","kind":"person","person_id":"cbr-p000424","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m024-0228","start":228,"end":230,"surface":"王僚","kind":"person","person_id":"cbr-p001059","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m024-0239","start":239,"end":242,"surface":"公子光","kind":"person","person_id":"cbr-p000424","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m024-0253","start":253,"end":255,"surface":"專諸","kind":"person","person_id":"cbr-p001060","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m024-0271","start":271,"end":273,"surface":"王僚","kind":"person","person_id":"cbr-p001059","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m024-0281","start":281,"end":283,"surface":"王僚","kind":"person","person_id":"cbr-p001059","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m024-0284","start":284,"end":287,"surface":"公子光","kind":"person","person_id":"cbr-p000424","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m024-0297","start":297,"end":299,"surface":"闔廬","kind":"person","person_id":"cbr-p000424","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m024-0300","start":300,"end":302,"surface":"闔廬","kind":"person","person_id":"cbr-p000424","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m024-0304","start":304,"end":306,"surface":"專諸","kind":"person","person_id":"cbr-p001060","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m024-0306","start":306,"end":307,"surface":"子","kind":"person","person_id":"cbr-p001079","status":"contextual_provisional"}],"chapter_id":"c-shiji-031-wu","book_id":"b-shiji-031","work_id":"w-shiji","source_id":"s-shiji-031-wu"},{"id":"c-shiji-031-wu:p025","text":"季子至，曰：「苟先君無廢祀，民人無廢主，社稷有奉，乃吾君也。吾敢誰怨乎？哀死事生，以待天命。非我生亂，立者從之，先人之道也。」復命，哭僚墓，復位而待。吳公子燭庸、蓋餘二人將兵遇圍於楚者，聞公子光弑王僚自立，乃以其兵降楚，楚封之於舒。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-031-wu:m025-0000","start":0,"end":2,"surface":"季子","kind":"person","person_id":"cbr-p001036","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m025-0008","start":8,"end":10,"surface":"先君","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、族稱或未定指代；有虞等不直接補作熟知個人，仍待覆核。"},{"id":"c-shiji-031-wu:m025-0056","start":56,"end":58,"surface":"先人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、族稱或未定指代；有虞等不直接補作熟知個人，仍待覆核。"},{"id":"c-shiji-031-wu:m025-0067","start":67,"end":68,"surface":"僚","kind":"person","person_id":"cbr-p001059","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m025-0078","start":78,"end":80,"surface":"燭庸","kind":"person","person_id":"cbr-p001062","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m025-0081","start":81,"end":83,"surface":"蓋餘","kind":"person","person_id":"cbr-p001061","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m025-0094","start":94,"end":97,"surface":"公子光","kind":"person","person_id":"cbr-p000424","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m025-0098","start":98,"end":100,"surface":"王僚","kind":"person","person_id":"cbr-p001059","status":"contextual_provisional"}],"chapter_id":"c-shiji-031-wu","book_id":"b-shiji-031","work_id":"w-shiji","source_id":"s-shiji-031-wu"},{"id":"c-shiji-036-chenqi:p023","text":"十年，陳火。十五年，吳王僚使公子光伐陳，取胡、沈而去。二十八年，吳王闔閭與子胥敗楚入郢。是年，惠公卒，子懷公柳立。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-036-chenqi:m023-0010","start":10,"end":13,"surface":"吳王僚","kind":"person","person_id":"cbr-p001059","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m023-0014","start":14,"end":17,"surface":"公子光","kind":"person","person_id":"cbr-p000424","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m023-0032","start":32,"end":36,"surface":"吳王闔閭","kind":"person","person_id":"cbr-p000424","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m023-0037","start":37,"end":39,"surface":"子胥","kind":"person","person_id":"cbr-p000423","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m023-0047","start":47,"end":49,"surface":"惠公","kind":"person","person_id":"cbr-p001499","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m023-0052","start":52,"end":55,"surface":"懷公柳","kind":"person","person_id":"cbr-p001503","status":"contextual_provisional"}],"chapter_id":"c-shiji-036-chenqi","book_id":"b-shiji-036","work_id":"w-shiji","source_id":"s-shiji-036-chenqi"},{"id":"c-shiji-066-wu:p006","text":"伍胥既至宋，宋有華氏之亂，乃與太子建俱奔於鄭。鄭人甚善之。太子建又適晉，晉頃公曰：「太子既善鄭，鄭信太子。太子能為我內應，而我攻其外，滅鄭必矣。滅鄭而封太子。」太子乃還鄭。事未會，會自私欲殺其從者，從者知其謀，乃告之於鄭。鄭定公與子產誅殺太子建。建有子名勝。伍胥懼，乃與勝俱奔吳。到昭關，昭關欲執之。伍胥遂與勝獨身步走，幾不得脫。追者在後。至江，江上有一漁父乘船，知伍胥之急，乃渡伍胥。伍胥既渡，解其劍曰：「此劍直百金，以與父。」父曰：「楚國之法，得伍胥者賜粟五萬石，爵執珪，豈徒百金劍邪！」不受。伍胥未至吳而疾，止中道，乞食。至於吳，吳王僚方用事，公子光為將。伍胥乃因公子光以求見吳王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-066-wu:m006-0000","start":0,"end":2,"surface":"伍胥","kind":"person","person_id":"cbr-p003808","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m006-0008","start":8,"end":10,"surface":"華氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者、官署借稱或未定指代，不補姓名或成員。"},{"id":"c-shiji-066-wu:m006-0015","start":15,"end":18,"surface":"太子建","kind":"person","person_id":"cbr-p003814","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m006-0023","start":23,"end":25,"surface":"鄭人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者、官署借稱或未定指代，不補姓名或成員。"},{"id":"c-shiji-066-wu:m006-0029","start":29,"end":32,"surface":"太子建","kind":"person","person_id":"cbr-p003814","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m006-0036","start":36