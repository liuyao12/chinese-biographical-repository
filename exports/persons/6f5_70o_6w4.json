rovisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-123-dayuan","source_id":"s-shiji123-dayuan","paragraph_id":"c-shiji-123-dayuan:p017","quote":"是後天子數問騫大夏之屬。騫既失侯，因言曰：「臣居匈奴中，聞烏孫王號昆莫，昆莫之父，匈奴西邊小國也。匈奴攻殺其父，而昆莫生棄於野。烏嗛肉蜚其上，狼往乳之。單于怪以為神，而收長之。及壯，使將兵，數有功，單于復以其父之民予昆莫，令長守於西（城）［域］。昆莫收養其民，攻旁小邑，控弦數萬，習攻戰。單于死，昆莫乃率其眾遠徙，中立，不肯朝會匈奴。匈奴遣奇兵擊，不勝，以為神而遠之，因羈屬之，不大攻。今單于新困於漢，而故渾邪地空無人。蠻夷俗貪漢財物，今誠以此時而厚幣賂烏孫，招以益東，居故渾邪之地，與漢結昆弟，其勢宜聽，聽則是斷匈奴右臂也。既連烏孫，自其西大夏之屬皆可招來而為外臣。」天子以為然，拜騫為中郎將，將三百人，馬各二匹，牛羊以萬數，齎金幣帛直數千巨萬，多持節副使，道可使，使遺之他旁國。"}],"source_assertion_id":"a-shiji123-004","interpretation_note":"依本篇明示父子接家族根；未名保持未名，分支字母不表示出生排行，生母與婚姻另存。","reviewer":"Codex（AI 代理）"}},{"id":"6f5_70o_6w4","label":"江都翁主","status":"active","historicity":"historical_tradition","aliases":[{"surface":"公主","mention_ids":["c-shiji-110-xiongnu:m047-0050"]},{"surface":"宗室女江都翁主","mention_ids":["c-shiji-123-dayuan:m025-0012"]},{"surface":"翁主","mention_ids":["c-shiji-123-dayuan:m025-0067"]}],"evidence":[{"mention_id":"c-shiji-110-xiongnu:m047-0050","chapter_id":"c-shiji-110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p047","quote":"公主"},{"mention_id":"c-shiji-123-dayuan:m025-0012","chapter_id":"c-shiji-123-dayuan","paragraph_id":"c-shiji-123-dayuan:p025","quote":"宗室女江都翁主"},{"mention_id":"c-shiji-123-dayuan:m025-0067","chapter_id":"c-shiji-123-dayuan","paragraph_id":"c-shiji-123-dayuan:p025","quote":"翁主"}]}],"source_mention_summary":[{"source_id":"s-shiji123-dayuan","work_id":"w-shiji","book_id":"b-shiji-123","chapter_id":"c-shiji-123-dayuan","mention_count":2,"mention_ids":["c-shiji-123-dayuan:m025-0012","c-shiji-123-dayuan:m025-0067"],"paragraph_ids":["c-shiji-123-dayuan:p025"],"table_cell_ids":[],"passage_count":1},{"source_id":"s-shiji110-xiongnu","work_id":"w-shiji","book_id":"b-shiji-110","chapter_id":"c-shiji-110-xiongnu","mention_count":1,"mention_ids":["c-shiji-110-xiongnu:m047-0050"],"paragraph_ids":["c-shiji-110-xiongnu:p047"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji123-dayuan"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji110-019","subject_person_id":"6f5_70o_6w4","predicate":"spouse","object_person_id":"3jf_ce1_jy2_A","status":"source_attested","evidence":[{"chapter_id":"c-shiji-110-xiongnu","source_id":"s-shiji110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p047","quote":"漢使楊信於匈奴。是時漢東拔穢貉、朝鮮以爲郡，而西置酒泉郡以鬲絕胡與羌通之路。漢又西通月氏、大夏，又以公主妻烏孫王，以分匈奴西方之援國。又北益廣田至胘雷爲塞，而匈奴終不敢以爲言。是歳，翕侯信死，漢用事者以匈奴爲已弱，可臣從也。楊信爲人剛直屈彊，素非貴臣，單于不親。單于欲召入，不肯去節，單于乃坐穹廬外見楊信。楊信既見單于，說曰：「即欲和親，以單于太子爲質於漢。」單于曰：「非故約。故約，漢常遣翁主，給繒絮食物有品，以和親，而匈奴亦不擾邊。今乃欲反古，令吾太子爲質，無幾矣。」匈奴俗，見漢使非中貴人，其儒先，以爲欲說，折其辯；其少年，以爲欲刺，折其氣。每漢使入匈奴，匈奴輒報償。漢留匈奴使，匈奴亦留漢使，必得當乃肯止。"}],"qualifiers":{"source_term":"以公主妻烏孫王","historicity":"historical_tradition"},"interpretation_note":"妻字明示已成婚配，未名夫妻各保留人物；不補父母、子女、婚年或與前代冒頓所請漢公主混同。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji123-009","subject_person_id":"3jf_ce1_jy2_A","predicate":"spouse","object_person_id":"6f5_70o_6w4","status":"source_attested","evidence":[{"chapter_id":"c-shiji-123-dayuan","source_id":"s-shiji123-dayuan","paragraph_id":"c-shiji-123-dayuan:p025","quote":"烏孫以千匹馬聘漢女，漢遣宗室女江都翁主往妻烏孫，烏孫王昆莫以為右夫人。匈奴亦遣女妻昆莫，昆莫以為左夫人。昆莫曰「我老」，乃令其孫岑娶妻翁主。烏孫多馬，其富人至有四五千匹馬。"}],"qualifiers":{"source_term":"烏孫王昆莫以為右夫人"},"interpretation_note":"依本篇明示稱謂及局部敘事記錄；未名者不補姓名，不補同母、排行或缺失世代。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-110-xiongnu:m047-0050","start":50,"end":52,"surface":"公主","kind":"person","person_id":"6f5_70o_6w4","status":"contextual_provisional","paragraph_id":"c-shiji-110-xiongnu:p047","chapter_id":"c-shiji-110-xiongnu"},{"id":"c-shiji-123-dayuan:m025-00