"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m031-0000","start":0,"end":2,"surface":"黥布","kind":"person","person_id":"664_wah_z4z","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m031-0013","start":13,"end":14,"surface":"布","kind":"person","person_id":"664_wah_z4z","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m031-0035","start":35,"end":36,"surface":"布","kind":"person","person_id":"664_wah_z4z","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m031-0049","start":49,"end":50,"surface":"布","kind":"person","person_id":"664_wah_z4z","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m031-0052","start":52,"end":54,"surface":"肥誅","kind":"person","person_id":"ns2_4jx_cpp","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m031-0055","start":55,"end":56,"surface":"嬰","kind":"person","person_id":"mdl_l60_pwy","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m031-0089","start":89,"end":90,"surface":"布","kind":"person","person_id":"664_wah_z4z","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m031-0093","start":93,"end":95,"surface":"高帝","kind":"person","person_id":"vok_rjp_tag","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m031-0099","start":99,"end":100,"surface":"嬰","kind":"person","person_id":"mdl_l60_pwy","status":"contextual_provisional"}],"chapter_id":"c-shiji-095-fankuang","book_id":"b-shiji-095","work_id":"w-shiji","source_id":"s-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:p032","text":"嬰自破布歸，高帝崩，嬰以列侯事孝惠帝及呂太后。太后崩，呂祿等以趙王自置為將軍，軍長安，為亂。齊哀王聞之，舉兵西，且入誅不當為王者。上將軍呂祿等聞之，乃遣嬰為大將，將軍往擊之。嬰行至滎陽，乃與絳侯等謀，因屯兵滎陽，風齊王以誅呂氏事，齊兵止不前。絳侯等既誅諸呂，齊王罷兵歸，嬰亦罷兵自滎陽歸，與絳侯、陳平共立代王為孝文皇帝。孝文皇帝於是益封嬰三千戶，賜黃金千斤，拜為太尉。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m032-0000","start":0,"end":1,"surface":"嬰","kind":"person","person_id":"mdl_l60_pwy","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m032