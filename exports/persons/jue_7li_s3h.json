ind":"person","person_id":"jue_7li_s3h","status":"contextual_provisional","paragraph_id":"c-shiji-123-dayuan:p026","chapter_id":"c-shiji-123-dayuan"}],"relations":[],"title_holdings":[{"id":"th-shiji123-024","person_id":"jue_7li_s3h","title":"安息王","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-123-dayuan","source_id":"s-shiji123-dayuan","paragraph_id":"c-shiji-123-dayuan:p026","quote":"初，漢使至安息，安息王令將二萬騎迎於東界。東界去王都數千里。行比至，過數十城，人民相屬甚多。漢使還，而後發使隨漢使來觀漢廣大，以大鳥卵及黎軒善眩人獻于漢。及宛西小國驩潛、大益，宛東姑師、扜穼、蘇薤之屬，皆隨漢使獻見天子，天子大悅；而漢使窮河源，河源出于窴，其山多玉石，采來，天子案古圖書，名河所出山曰崑崙云。"}],"attestations":[{"id":"th-shiji123-024:a001","paragraph_id":"c-shiji-123-dayuan:p026","start":8,"end":11,"surface":"安息王","person_mention_id":"c-shiji-123-dayuan:m026-0008","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"原文授任、繼位與用稱分存；未知起訖保持未知，不因死亡自動終止。從驃侯等原稱不默改。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-123-dayuan:p026","text":"初，漢使至安息，安息王令將二萬騎迎於東界。東界去王都數千里。行比至，過數十城，人民相屬甚多。漢使還，而後發使隨漢使來觀漢廣大，以大鳥卵及黎軒善眩人獻于漢。及宛西小國驩潛、大益，宛東姑師、扜穼、蘇薤之屬，皆隨漢使獻見天子，天子大悅；而漢使窮河源，河源出于窴，其山多玉石，采來，天子案古圖書，名河所出山曰崑崙云。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-123-dayuan:m026-0008","start":8,"end":11,"surface":"安息王","kind":"person","person_id":"jue_7li_s3h","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m026-0068","start":68,"end":73,"surface":"黎軒善眩人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-123-dayuan:m026-0107","start":107,"end":109,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayu