{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"4rt_vz6_obh","canonical_person_id":"4rt_vz6_obh","id_aliases":["4rt_vz6_obh-"],"identity_policy":"contextual_provisional","person_ids":["4rt_vz6_obh"],"persons":[{"id":"4rt_vz6_obh","label":"項悍（傅靳蒯成列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"項悍","mention_ids":["c-shiji-098-fujin:m007-0182"]}],"evidence":[{"mention_id":"c-shiji-098-fujin:m007-0182","chapter_id":"c-shiji-098-fujin","paragraph_id":"c-shiji-098-fujin:p007","quote":"項悍"}],"id_aliases":["4rt_vz6_obh-"]}],"source_mention_summary":[{"source_id":"s-shiji-098-fujin","work_id":"w-shiji","book_id":"b-shiji-098","chapter_id":"c-shiji-098-fujin","mention_count":1,"mention_ids":["c-shiji-098-fujin:m007-0182"],"paragraph_ids":["c-shiji-098-fujin:p007"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-098-fujin"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-098-fujin:m007-0182","start":182,"end":184,"surface":"項悍","kind":"person","person_id":"4rt_vz6_obh","status":"contextual_provisional","paragraph_id":"c-shiji-098-fujin:p007","chapter_id":"c-shiji-098-fujin"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji098-024","person_id":"4rt_vz6_obh","surfaces":["項悍"],"scope":"same_chapter","chapter_ids":["c-shiji-098-fujin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-098-fujin:p007","quote":"別之河內，擊趙將賁郝軍朝歌，破之，所將卒得騎將二人，車馬二百五十匹。從攻安陽以東，至棘蒲，下七縣。別攻破趙軍，得其將司馬二人，候四人，降吏卒二千四百人。從攻下邯鄲。別下平陽，身斬守相，所將卒斬兵守、郡守各一人，降鄴。從攻朝歌、邯鄲，及別擊破趙軍，降邯鄲郡六縣。還軍敖倉，破項籍軍成皋南，擊絕楚饟道，起滎陽至襄邑。破項冠軍魯下。略地東至繒、郯、下邳，南至蘄、竹邑。擊項悍濟陽下。還擊項籍陳下，破之。別定江陵，降江陵柱國、大司馬以下八人，身得江陵王，生致之雒陽，因定南郡。從至陳，取楚王信，剖符世世勿絕，定食四千六百戶，號信武侯。"}],"rationale":"依傅寬、靳歙、周緤分段敘事及明示姓名定位；楚王信與平城下韓信分存，單稱參勃哙敞不補姓，兩位信武侯分持有人，周昌不按同名跨篇合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-098-fujin:p007","text":"別之河內，擊趙將賁郝軍朝歌，破之，所將卒得騎將二人，車馬二百五十匹。從攻安陽以東，至棘蒲，下七縣。別攻破趙軍，得其將司馬二人，候四人，降吏卒二千四百人。從攻下邯鄲。別下平陽，身斬守相，所將卒斬兵守、郡守各一人，降鄴。從攻朝歌、邯鄲，及別擊破趙軍，降邯鄲郡六縣。還軍敖倉，破項籍軍成皋南，擊絕楚饟道，起滎陽至襄邑。破項冠軍魯下。略地東至繒、郯、下邳，南至蘄、竹邑。擊項悍濟陽下。還擊項籍陳下，破之。別定江陵，降江陵柱國、大司馬以下八人，身得江陵王，生致之雒陽，因定南郡。從至陳，取楚王信，剖符世世勿絕，定食四千六百戶，號信武侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-098-fujin:m007-0008","start":8,"end":10,"surface":"賁郝","kind":"person","person_id":"phx_lyu_9ym","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m007-0136","start":136,"end":138,"surface":"項籍","kind":"person","person_id":"nrp_vv5_hry","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m007-0157","start":157,"end":159,"surface":"項冠","kind":"person","person_id":"63o_61u_6tf","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m007-0182","start":182,"end":184,"surface":"項悍","kind":"person","person_id":"4rt_vz6_obh","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m007-0190","start":190,"end":192,"surface":"項籍","kind":"person","person_id":"nrp_vv5_hry","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m007-0219","start":219,"end":222,"surface":"江陵王","kind":"person","person_id":"ex1_pps_iby","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m007-0239","start":239,"end":242,"surface":"楚王信","kind":"person","person_id":"mfd_hor_95c","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m007-0259","start":259,"end":262,"surface":"信武侯","kind":"person","person_id":"7dv_lqp_y4z","status":"contextual_provisional"}],"ch