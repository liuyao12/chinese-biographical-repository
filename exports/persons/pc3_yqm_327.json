amily_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-073-baiwang:m004-0047","start":47,"end":49,"surface":"廉頗","kind":"person","person_id":"pc3_yqm_327","status":"contextual_provisional","paragraph_id":"c-shiji-073-baiwang:p004","chapter_id":"c-shiji-073-baiwang"},{"id":"c-shiji-073-baiwang:m004-0113","start":113,"end":115,"surface":"廉頗","kind":"person","person_id":"pc3_yqm_327","status":"contextual_provisional","paragraph_id":"c-shiji-073-baiwang:p004","chapter_id":"c-shiji-073-baiwang"},{"id":"c-shiji-073-baiwang:m004-0173","start":173,"end":175,"surface":"廉頗","kind":"person","person_id":"pc3_yqm_327","status":"contextual_provisional","paragraph_id":"c-shiji-073-baiwang:p004","chapter_id":"c-shiji-073-baiwang"},{"id":"c-shiji-073-baiwang:m004-0187","start":187,"end":189,"surface":"廉頗","kind":"person","person_id":"pc3_yqm_327","status":"contextual_provisional","paragraph_id":"c-shiji-073-baiwang:p004","chapter_id":"c-shiji-073-baiwang"},{"id":"c-shiji-073-baiwang:m004-0220","start":220,"end":222,"surface":"廉頗","kind":"person","person_id":"pc3_yqm_327","status":"contextual_provisional","paragraph_id":"c-shiji-073-baiwang:p004","chapter_id":"c-shiji-073-baiwang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji073-015","person_id":"pc3_yqm_327","scope":"same_chapter","chapter_ids":["c-shiji-073-baiwang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"依長平敘事明示姓名、替將次序與局部回指暫接；王龁龁、趙括馬服子與白起武安君按本篇明示。應侯不補未見姓名，趙王接前段趙孝成王、秦王接開篇秦昭王，各限此敘事。反閒廉頗且降的話語及趙卒數保留來源層，不作已確證事實或跨篇調和。","surfaces":["廉頗"],"evidence":[{"paragraph_id":"c-shiji-073-baiwang:p004","quote":"四十七年，秦使左庶長王龁攻韓，取上黨。上黨民走趙。趙軍長平，以按據上黨民。四月，龁因攻趙。趙使廉頗將。趙軍士卒犯秦斥兵，秦斥兵斬趙裨將茄。六月，陷趙軍，取二鄣四尉。七月，趙軍筑壘壁而守之。秦又攻其壘，取二尉，敗其陣，奪西壘壁。廉頗堅壁以待秦，秦數挑戰，趙兵不出。趙王數以為讓。而秦相應侯又使人行千金於趙為反閒，曰：「秦之所惡，獨畏馬服子趙括將耳，廉頗易與，且降矣。」趙王既怒廉頗軍多失亡，軍數敗，又反堅壁不敢戰，而又聞秦反閒之言，因使趙括代廉頗將以擊秦。秦聞馬服子將，乃陰使武安君白起為上將軍。而王龁為尉裨將，令軍中有敢泄武安君將者斬。趙括至，則出兵擊秦軍。秦軍詳敗而走，張二奇兵以劫之。趙軍逐勝，追造秦壁。壁堅拒不得入，而秦奇兵二萬五千人絕趙軍後，又一軍五千騎絕趙壁閒，趙軍分而為二，糧道絕。而秦出輕兵擊之。趙戰不利，因筑壁堅守，以待救至。秦王聞趙食道絕，王自之河內，賜民爵各一級，發年十五以上悉詣長平，遮絕趙救及糧食。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-073-baiwang:p004","text":"四十七年，秦使左庶長王龁攻韓，取上黨。上黨民走趙。趙軍長平，以按據上黨民。四月，龁因攻趙。趙使廉頗將。趙軍士卒犯秦斥兵，秦斥兵斬趙裨將茄。六月，陷趙軍，取二鄣四尉。七月，趙軍筑壘壁而守之。秦又攻其壘，取二尉，敗其陣，奪西壘壁。廉頗堅壁以待秦，秦數挑戰，趙兵不出。趙王數以為讓。而秦相應侯又使人行千金於趙為反閒，曰：「秦之所惡，獨畏馬服子趙括將耳，廉頗易與，且降矣。」趙王既怒廉頗軍多失亡，軍數敗，又反堅壁不敢戰，而又聞秦反閒之言，因使趙括代廉頗將以擊秦。秦聞馬服子將，乃陰使武安君白起為上將軍。而王龁為尉裨將，令軍中有敢泄武安君將者斬。趙括至，則出兵擊秦軍。秦軍詳敗而走，張二奇兵以劫之。趙軍逐勝，追造秦壁。壁堅拒不得入，而秦奇兵二萬五千人絕趙軍後，又一軍五千騎絕趙壁閒，趙軍分而為二，糧道絕。而秦出輕兵擊之。趙戰不利，因筑壁堅守，以待救至。秦王聞趙食道絕，王自之河內，賜民爵各一級，發年十五以上悉詣長平，遮絕趙救及糧食。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-073-baiwang:m004-0007","start":7,"end":12,"surface":"左庶長王龁","kind":"person","person_id":"0th_8iq_2q0","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m004-0040","start":40,"end":41,"surface":"龁","kind":"person","person_id":"0th_8iq_2q0","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m004-0047","start":47,"end":49,"surface":"廉頗","kind":"person","person_id":"pc3_yqm_327","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m004-0064","start":64,"end":68,"surface":"趙裨將茄","kind":"person","person_id":"p1g_3h6_97x","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m004-0079","start":79,"end":81,"surface":"四尉","kind":"unresolved","person_id":null,"status":"unresolved","note":"數量化尉官群體未名，不建立假定個別人物。"},{"id":"c-shiji-073-baiwang:m004-0101","start":101,"end":103,"surface":"二尉","kind":"unresolved","person_id":null,"status":"unresolved","note":"數量化尉官群體未名，不建立假定個別人物。"},{"id":"c-shiji-073-baiwang:m004-0113","start":113,"end":115,"surface":"廉頗","kind":"person","person_id":"pc3_yqm_327","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m004-01