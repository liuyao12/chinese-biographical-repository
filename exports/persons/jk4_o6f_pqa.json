{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"jk4_o6f_pqa","canonical_person_id":"jk4_o6f_pqa","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["jk4_o6f_pqa"],"persons":[{"id":"jk4_o6f_pqa","label":"共王（韓長孺列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"共王","mention_ids":["c-shiji-108-han:m005-0463"]}],"evidence":[{"mention_id":"c-shiji-108-han:m005-0463","chapter_id":"c-shiji-108-han","paragraph_id":"c-shiji-108-han:p005","quote":"共王"}]}],"source_mention_summary":[{"source_id":"s-shiji-108-han","work_id":"w-shiji","book_id":"b-shiji-108","chapter_id":"c-shiji-108-han","mention_count":1,"mention_ids":["c-shiji-108-han:m005-0463"],"paragraph_ids":["c-shiji-108-han:p005"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-108-han"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-108-han:m005-0463","start":463,"end":465,"surface":"共王","kind":"person","person_id":"jk4_o6f_pqa","status":"contextual_provisional","paragraph_id":"c-shiji-108-han:p005","chapter_id":"c-shiji-108-han"}],"relations":[],"title_holdings":[{"id":"th-shiji108-012","person_id":"jk4_o6f_pqa","title":"共王","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-108-han","source_id":"s-shiji-108-han","paragraph_id":"c-shiji-108-han:p005","quote":"公孫詭、羊勝説孝王求爲帝太子及益地事，恐漢大臣不聽，乃陰使人刺漢用事謀臣。及殺故呉相袁盎，景帝遂聞詭、勝等計畫，乃遣使捕詭、勝，必得。漢使十輩至梁，相以下舉國大索，月餘不得。內史安國聞詭、勝匿孝王所，安國入見王而泣曰：「主辱臣死。大王無良臣，故事紛紛至此。今詭、勝不得，請辭賜死。」王曰：「何至此？」安國泣數行下，曰：「大王自度於皇帝，孰與太上皇之與高皇帝及皇帝之與臨江王親？」孝王曰：「弗如也。」安國曰：「夫太上、臨江親父子之閒，然而高帝曰『提三尺劍取天下者朕也』，故太上皇終不得制事，居于櫟陽。臨江王，適長太子也，以一言過，廢王臨江；用宮垣事，卒自殺中尉府。何者？治天下終不以私亂公。語曰：『雖有親父，安知其不爲虎？雖有親兄，安知其不爲狼？』今大王列在諸侯，悅一邪臣浮説，犯上禁，橈明法。天子以太后故，不忍致法於王。太后日夜涕泣，幸大王自改，而大王終不覺寤。有如太后宮車即晏駕，大王尚誰攀乎？」語未卒，孝王泣數行下，謝安國曰：「吾今出詭、勝。」詭、勝自殺。漢使還報，梁事皆得釋，安國之力也。於是景帝、太后益重安國。孝王卒，共王即位，安國坐法失官，居家。"}],"attestations":[{"id":"th-shiji108-012:a001","paragraph_id":"c-shiji-108-han:p005","start":463,"end":465,"surface":"共王","person_mention_id":"c-shiji-108-han:m005-0463","usage":"posthumous_usage"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"保存本段來源用稱與追述，未明授任日期保持未知；含諡王稱不補生前用稱期間。適長原詞保留，尚未據此裁定實際嫡庶或出生排行。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-108-han:p005","text":"公孫詭、羊勝説孝王求爲帝太子及益地事，恐漢大臣不聽，乃陰使人刺漢用事謀臣。及殺故呉相袁盎，景帝遂聞詭、勝等計畫，乃遣使捕詭、勝，必得。漢使十輩至梁，相以下舉國大索，月餘不得。內史安國聞詭、勝匿孝王所，安國入見王而泣曰：「主辱臣死。大王無良臣，故事紛紛至此。今詭、勝不得，請辭賜死。」王曰：「何至此？」安國泣數行下，曰：「大王自度於皇帝，孰與太上皇之與高皇帝及皇帝之與臨江王親？」孝王曰：「弗如也。」安國曰：「夫太上、臨江親父子之閒，然而高帝曰『提三尺劍取天下者朕也』，故太上皇終不得制事，居于櫟陽。臨江王，適長太子也，以一言過，廢王臨江；用宮垣事，卒自殺中尉府。何者？治天下終不以私亂公。語曰：『雖有親父，安知其不爲虎？雖有親兄，安知其不爲狼？』今大王列在諸侯，悅一邪臣浮説，犯上禁，橈明法。天子以太后故，不忍致法於王。太后日夜涕泣，幸大王自改，而大王終不覺寤。有如太后宮車即晏駕，大王尚誰攀乎？」語未卒，孝王泣數行下，謝安國曰：「吾今出詭、勝。」詭、勝自殺。漢使還報，梁事皆得釋，安國之力也。於是景帝、太后益重安國。孝王卒，共王即位，安國坐法失官，居家。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-108-han:m005-0000","start":0,"end":3,"surface":"公孫詭","kind":"person","person_id":"v4l_7vt_hsb","status":"contextual_provisional"},{"id":"c-shiji-108-han:m005-0004","start":4,"end":6,"surface":"羊勝","kind":"person","person_id":"ezo_6oj_gne","status":"contextual_provisional"},{"id":"c-shiji-108-han:m005-0007","start":7,"end":9,"surface":"孝王","kind":"person","person_id":"l5d_ywu_jfb","status":"contextual_provisional"},{"id":"c-shiji-108-han:m005-0011","start":1