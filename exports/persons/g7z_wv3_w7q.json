,"kind":"person","person_id":"g7z_wv3_w7q","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-043-wangcheng:line124","chapter_id":"c-jinshu-043-wangcheng"},{"id":"c-jinshu-066-taokan:p004:m0055","surface":"扈瑰","start":55,"end":57,"person_id":"g7z_wv3_w7q","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-066-taokan:p004","chapter_id":"c-jinshu-066-taokan"}],"relations":[],"title_holdings":[{"id":"th-w043-cheng-124-13","person_id":"g7z_wv3_w7q","title":"天門太守","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-043","chapter_id":"c-jinshu-043-wangcheng","source_id":"s-jinshu-043-wangcheng","paragraph_id":"c-jinshu-043-wangcheng:line124","quote":"初，澄命武陵諸郡同討杜弢，天門太守扈瑰次於益陽。武陵內史武察為其郡夷所害，瑰以孤軍引還。澄怒，以杜曾代瑰。夷袁遂，瑰故吏也，托為瑰報仇，遂舉兵逐曾，自稱平晉將軍。澄使司馬毌丘邈討之，為遂所敗。會元帝征澄為軍諮祭酒，於是赴召。","person_mention_id":"c-jinshu-043-wangcheng:line124:m0017"}],"attestations":[{"id":"th-w043-cheng-124-13:a","paragraph_id":"c-jinshu-043-wangcheng:line124","start":13,"end":17,"surface":"天門太守","person_mention_id":"c-jinshu-043-wangcheng:line124:m0017","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-043-wangcheng:line124","text":"初，澄命武陵諸郡同討杜弢，天門太守扈瑰次於益陽。武陵內史武察為其郡夷所害，瑰以孤軍引還。澄怒，以杜曾代瑰。夷袁遂，瑰故吏也，托為瑰報仇，遂舉兵逐曾，自稱平晉將軍。澄使司馬毌丘邈討之，為遂所敗。會元帝征澄為軍諮祭酒，於是赴召。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-043-wangcheng:line124:m0002","start":2,"end":3,"surface":"澄","kind":"person","person_id":"rlk_lz