i-057-yufan:line023:m0057"}],"attestations":[{"id":"t-wu057-yufan-2:a","paragraph_id":"c-sanguozhi-057-yufan:line023","person_mention_id":"c-sanguozhi-057-yufan:line023:m0057","start":53,"end":56,"surface":"大司農","usage":"narrative","date_expression":null}],"human_reviewed":false,"reviewer":"Codex（AI 代理）","model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-057-yufan:line023","text":"權既為吳王，歡宴之末。自起行酒，翻伏地陽醉，不持。權去，翻起坐。權於是大怒，手劍欲擊之，侍坐者莫不惶遽。惟大司農劉基起抱權諫曰：\"大王以三爵之後殺善士，雖翻有罪，天下孰知之?且大王以能容賢畜眾，故海內望風，今一朝棄之，可乎？\"權曰：\"曹孟德尚殺孔文舉，孤於虞翻何有哉！\"基曰：\"孟德輕害士人，天下非之。大王躬行德義，欲與堯、舜比隆，何得自喻於彼乎？\"翻由是得免。權因敕左右，自今酒後言殺，皆不得殺。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-057-yufan:line023:m0000","start":0,"end":1,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-yufan:line023:m0016","start":16,"end":17,"surface":"翻","kind":"person","person_id":"izi_e36_p1g","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-yufan:line023:m0025","start":25,"end":26,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-yufan:line023:m0028","start":28,"end":29,"surface":"翻","kind":"person","person_id":"izi_e36_p1g","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-yufan:line023:m0032","start":32,"end":33,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-yufan:line023:m0057","start":57,"end":58,"surface":"基","kind":"person","person_id":"0l7_5ov_1hf","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-yufan: