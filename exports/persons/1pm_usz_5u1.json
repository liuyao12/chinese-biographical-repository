required":false},"family_paths":[],"mentions":[{"id":"c-songshu-049-yuqiujin:p001:m0070","start":70,"end":72,"surface":"張驃","kind":"person","person_id":"1pm_usz_5u1","status":"contextual_provisional","paragraph_id":"c-songshu-049-yuqiujin:p001","chapter_id":"c-songshu-049-yuqiujin"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-songshu-049-yuqiujin:p001","text":"虞丘進字豫之，東海郯人也。少時隨謝玄討苻堅，有功，封關內侯。隆安中，從高祖征孫恩，戍句章城，被圍數十日，無日不戰，身被數創。至餘姚呵浦，破賊張驃，追至海鹽故治及婁縣。於蒲濤口與孫恩水戰，又被重創。追恩至鬱洲，又至石鹿頭，還海鹽大柱，頻戰有功。元興元年，又從高祖東征臨海，於石步固與盧循相守二十餘日。二年，又從高祖至東陽，破徐道覆。其年，又至臨松穴破賊，追至永嘉千江，又至安固，累戰皆有功。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":41,"last_line":41,"raw_start":3184,"raw_end":3378,"raw_character_offsets":[3184,3185,3186,3187,3188,3189,3190,3191,3192,3193,3194,3195,3196,3197,3198,3199,3200,3201,3202,3203,3204,3205,3206,3207,3208,3209,3210,3211,3212,3213,3214,3215,3216,3217,3218,3219,3220,3221,3222,3223,3224,3225,3226,3227,3228,3229,3230,3231,3232,3233,3234,3235,3236,3237,3238,3239,3240,3241,3242,3243,3244,3245,3246,3247,3248,3249,3250,3251,3252,3253,3254,3255,3256,3257,3258,3259,3260,3261,3262,3263,3264,3265,3266,3267,3268,3269,3270,3271,3272,3273,3274,3275,3276,3277,3278,3279,3280,3281,3282,3283,3284,3285,3286,3287,3288,3289,3290,3291,3292,3293,3294,3295,3296,3297,3298,3299,3300,3301,3302,3303,3304,3305,3306,3307,3308,3309,3310,3311,3312,3313,3314,3315,3316,3317,3318,3319,3320,3321,3322,3323,3324,3325,3326,3327,3328,3329,3330,3331,3332,3333,3334,3335,3336,3337,3338,3339,3340,3341,3342,3343,3344,3345,3346,3347,3348,3349,3350,3351,3352,3353,3354,3355,3356,3357,3358,3359,3360,3361,3362,3363,3364,3365,3366,3367,3368,3369,3370,3371,3372,3373,3374,3375,3376,3377],"revision_id":2118585},"mentions":[{"id":"c-songshu-049-yuqiujin:p001:m0000","start":0,"end":3,"