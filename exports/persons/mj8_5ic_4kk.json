id":"c-songshu-044-wyd1739-xiehui:p008","chapter_id":"c-songshu-044-wyd1739-xiehui"},{"id":"c-songshu-044-wyd1739-xiehui:p016:m0375","start":375,"end":378,"surface":"殿道鸞","status":"contextual_provisional","interpretation_note":"依本傳實指語境及已收近系/同事件角色辨識；精確種子附canonical-seeds，不據同名單獨合併。","kind":"person","person_id":"mj8_5ic_4kk","source_role_key":"daoluan","paragraph_id":"c-songshu-044-wyd1739-xiehui:p016","chapter_id":"c-songshu-044-wyd1739-xiehui"},{"id":"c-songshu-064-peisongzhi:p004:m0143","start":143,"end":146,"surface":"殷道鸞","kind":"person","person_id":"mj8_5ic_4kk","status":"contextual_provisional","interpretation_note":"本單元元嘉三年奉使名單具名，暫發來源局部身份；不因同姓/相近名與別篇人強合。","paragraph_id":"c-songshu-064-peisongzhi:p004","chapter_id":"c-songshu-064-peisongzhi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-song044-wyd-role-daoluan","person_id":"mj8_5ic_4kk","surfaces":["殷道鸞","殿道鸞"],"scope":"cross_chapter","chapter_ids":["c-songshu-044-wyd1739-xiehui","c-songshu-064-peisongzhi"],"status":"contextual_provisional","confidence_level":"medium","identification_basis":{"kind":"source_context","target_mention_ids":["c-songshu-044-wyd1739-xiehui:p008:m0094","c-songshu-044-wyd1739-xiehui:p016:m0375"]},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-044","source_id":"s-songshu-044-wyd1739-xiehui","chapter_id":"c-songshu-044-wyd1739-xiehui","paragraph_id":"c-songshu-044-wyd1739-xiehui:p008","quote":"之諸姪咸無所染況彼府州文武並列王職荷國榮任身雖在外乃心辰極夫轉禍貴速後機則凶遂使王師臨郊雷電皆至噬臍之恨亦將何及時益州刺史蕭摹之巴西太守劉道產被徵還始至江陵晦並繫縶沒其財貨以充軍資竟陵內史殷道鸞未之郡以為諮議參軍以弟遯為冠軍竟陵內史總留任兄子世猷為建威將軍南平太守劉粹若至周超能破之者卽以為龍驤將軍雍州刺史晦率二萬發自江陵舟艦列自江津至于破冢旍旂相照蔽奪日光晦乃歎曰恨不得以此為勤王之師自領湘州刺史以張劭為輔國將軍劭不受命晦檄京邑曰王室多故禍難薦臻營陽失德自絶宗廟廬陵王構鬩有本屢被猜嫌且居喪失禮遐邇所具積怨犯上自貽非道羣后釋位爰登聖明亂之未乂職有所係按車騎大將軍王弘侍中王曇首謬蒙時私叨竊權要弘於永初之始實荷不世之恩元嘉之讓自謂任遇浮淺進誣先皇委誠之寄退長嫌隙異同之端曇首往因使下訪以今上起居不能光揚令德彰於朝聽其言多誣故不具說王華賊亡之餘賞擢之次先帝常見訪逮庶有一分可取而華禀性凶猜多所忍害曩者縱人入城託疾辭事此都士庶咸所聞知以其所啟及"},{"work_id":"w-songshu","book_id":"b-songshu-064","source_id":"s-song064-ws1748217","chapter_id":"c-songshu-064-peisongzhi","paragraph_id":"c-songshu-064-peisongzhi:p004","quote":"太祖元嘉三年，誅司徒徐羨之等，分遣大使，巡行天下。通直散騎常侍袁渝、司徒左西掾孔邈使揚州，尚書三公郎陸子真、起部甄法崇使荊州，員外散騎常侍范雍、司徒主簿龐遵使南兗州，前尚書右丞孔默使南、北二豫州，撫軍參軍王歆之使徐州，冗從僕射車宗使青兗州，松之使湘州，尚書殿中郎阮長之使雍州，前竟陵太守殷道鸞使益州，員外散騎常侍李耽之使廣州，郎中殷斌使梁州、南秦州，前員外散騎侍郎阮園客使交州，駙馬都尉、奉朝請潘思先使寧州，並兼散騎常侍。班宣詔書曰：「昔王者巡功，群后述職，不然則有存省之禮，聘眺之規。所以觀民立政，命事考績，上下偕通，遐邇咸被，故能功昭長世，道歷遠年。朕以寡闇，屬承洪業，夤畏在位，昧於治道，夕惕惟憂，如臨淵谷。懼國俗陵頹，民風凋僞，眚厲違和，水旱傷業。雖躬勤庶事，思弘攸宜，而機務惟殷，顧循多闕，政刑乖謬，未獲具聞。豈誠素弗孚，使群心莫盡，納隍之愧，在予一人。以歳時多難，王道未壹，卜徵之禮，廢而未修，眷彼氓庶，無忘攸恤。今使兼散騎常侍渝等申令四方，周行郡邑，親見刺史二千石官長，申述至誠，廣詢治要，觀察吏政，訪求民隱，旌舉操行，存問所疾。禮俗得失，一依周典，每各爲書，還具條奏，俾朕昭然，若親覽焉。大夫君子，其各悉心敬事，無惰乃力。其有咨謀遠圖，謹言中誠，陳之使者，無或隱遺。方將敬納良規，以補其闕。勉哉勖之，稱朕意焉。」"}],"rationale":"本源具名/限定省稱與已收同朝或同古事角色對照；見精確canonical-seed-recall；此為本篇有資格首選，非同字即同人。","human_reviewed":false,"model":null},{"id":"d-song064-yindao","person_id":"mj8_5ic_4kk","surfaces":["殷道鸞"],"scope":"same_chapter","status":"contextual_provisional","confidence_level":"medium","identification_basis":{"kind":"source_context","target_mention_ids":["c-songshu-064-peisongzhi:p004:m0143"]},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-064","chapter_id":"c-songshu-064-peisongzhi","source_id":"s-song064-ws1748217","paragraph_id":"c-songshu-064-peisongzhi:p004","quote":"太祖元嘉三年，誅司徒徐羨之等，分遣大使，巡行天下。通直散騎常侍袁渝、司徒左西掾孔邈使揚州，尚書三公郎陸子真、起部甄法崇使荊州，員外散騎常侍范雍、司徒主簿龐遵使南兗州，前尚書右丞孔默使南、北二豫州，撫軍參軍王歆之使徐州，冗從僕射車宗使青兗州，松之使湘州，尚書殿中郎阮長之使雍州，前竟陵太守殷道鸞使益州，員外散騎常侍李耽之使廣州，郎中殷斌使梁州、南秦州，前員外散騎侍郎阮園客使交州，駙馬都尉、奉朝請潘思先使寧州，並兼散騎常侍。班宣詔書曰：「昔王者巡功，群后述職，不然則有存省之禮，聘眺之規。所以觀民立政，命事考績，上下偕通，遐邇咸被，故能功昭長世，道歷遠年。朕以寡闇，屬承洪業，夤畏在位，昧於治道，夕惕惟憂，如臨淵谷。懼國俗陵頹，民風凋僞，眚厲違和，水旱傷業。雖躬勤庶事，思弘攸宜，而機務惟殷，顧循多闕，政刑乖謬，未獲具聞。豈誠素弗孚，使群心莫盡，納隍之愧，在予一人。以歳時多難，王道未壹，卜徵之禮，廢而未修，眷彼氓庶，無忘攸恤。今使兼散騎常侍渝等申令四方，周行郡邑，親見刺史二千石官長，申述至誠，廣詢治要，觀察吏政，訪求民隱，旌舉操行，存問所疾。禮俗得失，一依周典，每各爲書，還具條奏，俾朕昭然，若親覽焉。大夫君子，其各悉心敬事，無惰乃力。其有咨謀遠圖，謹言中誠，陳之使者，無或隱遺。方將敬納良規，以補其闕。勉哉勖之，稱朕意焉。」"}],"rationale":"本單元元嘉三年奉使名單具名，暫發來源局部身份；不因同姓/相近名與別篇人強合。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null}],"equivale