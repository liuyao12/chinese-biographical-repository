_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-chenshu-023-lushan-complete:p002:m0136","start":136,"end":139,"surface":"向文政","kind":"person","person_id":"lgu_bqp_6ye","status":"contextual_provisional","paragraph_id":"c-chenshu-023-lushan-complete:p002","chapter_id":"c-chenshu-023-lushan-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-chenshu-023-lushan-complete:p002","text":"繕幼有志尚，以雅正知名。起家梁宣惠武陵王法曹參軍。承聖中，授中書侍郎，掌東宮管記。江陵陷，繕微服遁還京師。紹泰元年，除司徒右長史，御史中丞，以父任所終，固辭不就。高祖引繕為司徒司馬，遷給事黃門侍郎、領步兵校尉、通直散騎常侍，兼侍中。永定元年，遷侍中。時留異擁割東陽，新安人向文政與異連結，因據本郡，朝廷以繕為貞威將軍、新安太守。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":35,"last_line":35,"raw_start":2413,"raw_end":2591,"raw_character_offsets":[2413,2414,2415,2416,2417,2418,2419,2420,2421,2422,2423,2424,2425,2426,2427,2428,2429,2430,2431,2432,2433,2434,2435,2436,2437,2438,2439,2440,2441,2442,2443,2444,2445,2446,2447,2448,2449,2450,2451,2452,2453,2454,2455,2456,2457,2458,2459,2460,2461,2462,2463,2464,2465,2471,2472,2473,2474,2477,2478,2479,2480,2481,2482,2483,2484,2485,2486,2487,2488,2489,2490,2491,2492,2493,2494,2495,2496,2497,2498,2499,2500,2501,2502,2503,2504,2505,2506,2507,2508,2509,2510,2511,2512,2513,2514,2515,2516,2517,2518,2519,2520,2521,2522,2523,2524,2525,2526,2527,2528,2529,2530,2531,2532,2533,2534,2535,2541,2542,2543,2544,2547,2548,2549,2550,2551,2552,2553,2554,2555,2556,2557,2558,2559,2560,2561,2562,2563,2564,2565,2566,2567,2568,2569,2570,2571,2572,2573,2574,2575,2576,2577,2578,2579,2580,2581,2582,2583,2584,2585,2586,2587,2588,2589,2590],"revision_id":1514496},"mentions":[{"id":"c-chenshu-023-lushan-complete:p002:m0000","start":0,"end":1,"surface":"繕","kind":"person","person_id":"