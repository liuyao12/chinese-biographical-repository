","person_id":"p8b_7w1_y3q","surface":"約","start":417,"end":418,"kind":"person","status":"contextual_provisional","interpretation_note":"殿本依本段所書姓名與上下文。"},{"id":"c-liangshu-033-wangyun-wyd:p003:m0431","person_id":"mxz_qw8_acd_A","surface":"王筠","start":431,"end":433,"kind":"person","status":"contextual_provisional","interpretation_note":"殿本依本段所書姓名與上下文。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":"cbr-ai-transcription-sha256:7053558e6ae66bd8cf78b874c228cebd0f6693575c192ac8fc72b37815b9569a","source_layer":"received_biography","column_projection":[{"column":"58R07","pdf_page":58,"half":"右","leaf":"十六下","column_from_right":7,"start":10,"end":21,"text":"起家中軍臨川王行參軍遷"},{"column":"58R08","pdf_page":58,"half":"右","leaf":"十六下","column_from_right":8,"start":0,"end":21,"text":"太子舍人除尚書殿中郎王氏過江以來未有居郎署"},{"column":"58R09","pdf_page":58,"half":"右","leaf":"十六下","column_from_right":9,"start":0,"end":21,"text":"者或勸逡巡不就筠曰陸平原東南之秀王文度獨步"},{"column":"58R10","pdf_page":58,"half":"右","leaf":"十六下","column_from_right":10,"start":0,"end":21,"text":"江東吾得比蹤昔人何所多恨乃欣然就職尚書令沈"},{"column":"58L01","pdf_page":58,"half":"左","leaf":"十七上","column_from_right":1,"start":0,"end":21,"text":"約當世辭宗每見筠文咨嗟吟咏以為不逮也嘗謂筠"},{"column":"58L02","pdf_page":58,"half":"左","leaf":"十七上","column_from_right":2,"start":0,"end":21,"text":"昔蔡伯喈見王仲宣稱曰王公之孫也吾家書籍悉當"},{"column":"58L03","pdf_page":58,"half":"左","leaf":"十七上","column_from_right":3,"start":0,"end":21,"text":"相與僕雖不敏請附斯言自謝朓諸賢零落已後平生"},{"column":"58L04","pdf_page":58,"half":"左","leaf":"十七上","column_from_right":4,"start":0,"end":21,"text":"意好殆將都絕不謂疲暮復逢於君約於郊居宅造閣"},{"column":"58L05","pdf_page":58,"half":"左","leaf":"十七上","column_from_right":5,"start":0,"end":21,"text":"齋筠為草木十詠書之於壁皆直寫文詞不加篇題約"},{"column":"58L06","pdf_page":58,"half":"左","leaf":"十七上","column_from_right":6,"start":0,"end":21,"text":"謂人云此詩指物呈形無假題署約製郊居賦構思積"},{"column":"58L07","pdf_page":58,"half":"左","leaf":"十七上","column_from_right":7,"start":0,"end":19,"text":"時猶未都畢乃要筠示其草筠讀至雌霓連踡約"},{"column":"58L08","pdf_page":58,"half":"左","leaf":"十七上","column_from_right":8,"start":0,"end":19,"text":"撫掌欣抃曰僕嘗恐人呼為霓次至墜石磓星及"},{"column":"58L09","pdf_page":58,"half":"左","leaf":"十七上","column_from_right":9,"start":0,"end":21,"text":"水懸坎而帶坻筠皆擊節稱贊約曰知音者希真賞殆"},{"column":"58L10","pdf_page":58,"half":"左","leaf":"十七上","column_from_right":10,"start":0,"end":21,"text":"絕所以相要政在此數句耳筠又嘗為詩呈約卽報書"},{"column":"59R01","pdf_page":59,"half":"右","leaf":"十七下","column_from_right":1,"start":0,"end":21,"text":"云覽所示詩實為麗則聲和被紙光影盈字夔牙接響"},{"column":"59R02","pdf_page":59,"half":"右","leaf":"十七下","column_from_right":2,"start":0,"end":21,"text":"顧有餘慚孔翠羣翔豈不多愧古情拙目每佇新奇爛"},{"column":"59R03","pdf_page":59,"half":"右","leaf":"十七下","column_from_right":3,"start":0,"end":21,"text":"然總至權輿已盡會昌昭發蘭揮玉振克諧之義寧比"},{"column":"59R04","pdf_page":59,"half":"右","leaf":"十七下","column_from_right":4,"start":0,"end":21,"text":"笙簧思力所該一至乎此歎服吟研周流忘念昔時幼"},{"column":"59R05","pdf_page":59,"half":"右","leaf":"十七下","column_from_right":5,"start":0,"end":21,"text":"壯頗愛斯文舍咀之間倐焉疲暮不及後進誠非一人"},{"column":"59R06","pdf_page":59,"half":"右","leaf":"十七下","column_from_right":6,"start":0,"end":21,"text":"擅美推能實歸吾子遲比閑日清覯乃申筠為文能壓"},{"column":"59R07","pdf_page":59,"half":"右","leaf":"十七下","column_from_right":7,"start":0,"end":21,"text":"強韻每公宴並作辭必妍美約常從容啓高祖曰晚來"},{"column":"59R08","pdf_page":59,"half":"右","leaf":"十七下","column_from_right":8,"start":0,"end":8,"text":"名家惟見王筠獨步"}]},"chapter_id":"c-liangshu-033-wangyun-wyd","book_id":"b-liangshu-033","work_id":"w-liangshu","source_id":"s-liangshu-033-wangyun-wyd1739"},{"id":"c-liangshu-033-wangyun:p003","text":"起家中軍臨川王行參軍，遷太子舍人，除尚書殿中郎。王氏過江以來，未有居郎署者，或勸逡巡不就，筠曰：「陸平原東南之秀，王文度獨步江東，吾得比蹤昔人，何所多恨。」乃欣然就職。尚書令沈約，當世辭宗，每見筠文，咨嗟吟詠，以爲不逮也。嘗謂筠：「昔蔡伯喈見王仲宣稱曰：『王公之孫也，吾家書籍，悉當相與。』僕雖不敏，請附斯言。自謝朓諸賢零落已後，平生意好，殆將都絕，不謂疲暮，復逢於君。」約於郊居宅造閣齋，筠爲草木十詠，書之於壁，皆直寫文詞，不加篇題。約謂人云：「此詩指物呈形，無假題署。」約制《郊居賦》，構思積時，猶未都畢，乃要筠示其草，筠讀至「雌霓連蜷」，約撫掌欣抃曰：「僕嘗恐人呼爲霓。」次至「墜石磓星」，及「冰懸坎而帶坻」。筠皆擊節稱讚。約曰：「知音者希，真賞殆絕，所以相要，政在此數句耳。」筠又嘗爲詩呈約，卽報書云：「覽所示詩，實爲麗則，聲和被紙，光影盈字。夔、牙接響，顧有餘慚；孔翠羣翔，豈不多愧。古情拙目，每佇新奇，爛然總至，權輿已盡。會昌昭發，蘭揮玉振，克諧之義，寧比笙簧。思力所該，一至乎此，嘆服吟研，周流忘念。昔時幼壯，頗愛斯文，含咀之間，倏焉疲暮。不及後進，誠非一人，擅美推能，實歸吾子。遲比閑日，清覯乃申。」筠爲文能壓強韻，每公宴並作，辭必妍美。約常從容啓高祖曰：「晚來名家，唯見王筠獨步。」","mentions":[{"id":"c-liangshu-033-wangyun:p003:u0024","person_id":null,"surface":"王氏","start":24,"end":26,"kind":"unresolved","status":"unresolved","interpretation_note":"過江以來的王氏家族。"},{"id":"c-liangshu-033-wangyun:p003:u0038","person_id":null,"surface":"或","start":38,"end":39,"kind":"unresolved","status":"unresolved","interpretation_note":"勸不就的未具名人。"},{"id":"c-liangshu-033-wangyun:p003:m0045","person_id":"mxz_qw8_acd_A","surface":"筠","start":45,"end":46,"kind":"person","status":"contextual_provisional","interpretation_note":"按同一見證的原字和敘事。"},{"id":"c-liangshu-033-wangyun:p003:m0049","person_id":"69h_uhy_hta","surface":"陸平原","start":49,"end":52,"kind":"person","status":"contextual_provisional","interpretation_note":"按同一見證的原字和敘事。"},{"id":"c-liangshu-033-wangyun:p003:m0057","person_id":"a8f_ec8_e74_AAAAA","surface":"王文度","start":57,"end":60,"kind":"person","status":"contextual_provisional","interpretation_note":"按同一見證的原字和敘事。"},{"id":"c-liangshu-033-wangyun:p003:u0069","person_id":null,"surface":"昔人","start":69,"end":71,"kind":"unresolved","status":"unresolved","interpretation_note":"並舉陸機、王坦之。"},{"id":"c-liangshu-033-wangyun:p003:m0087","person_id":"p8b_7w1_y3q","surface":"沈約","start":87,"end":89,"kind":"person","status":"contextual_provisional","interpretation_note":"按同一見證的原字和敘事。"},{"id":"c-liangshu-033-wangyun:p003:m0097","person_id":"mxz_qw8_acd_A","surface":"筠","start":97,"end":98,"kind":"person","status":"contextual_provisional","interpretation_note":"按同一見證的原字和敘事。"},{"id":"c-liangshu-033-wangyun:p003:m0113","person_id":"mxz_qw8_acd_A","surface":"筠","start":113,"end":114,"kind":"person","status":"contextual_provisional","interpretation_note":"按同一見證的原字和敘事。"},{"id":"c-liangshu-033-wangyun:p003:m0117","person_id":"gs5_qqu_9ui","surface":"蔡伯喈","start":117,"end":120,"kind":"person","status":"contextual_provisional","interp