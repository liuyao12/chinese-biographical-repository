text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":92,"last_line":92,"raw_start":4316,"raw_end":4419,"raw_character_offsets":[4316,4317,4318,4319,4320,4321,4322,4323,4324,4325,4326,4327,4328,4329,4330,4331,4332,4333,4334,4335,4336,4337,4338,4339,4340,4341,4342,4343,4344,4345,4346,4347,4348,4349,4350,4351,4352,4353,4354,4355,4356,4357,4358,4359,4360,4361,4362,4363,4364,4365,4366,4367,4368,4369,4370,4371,4372,4373,4374,4375,4376,4377,4378,4379,4380,4381,4382,4383,4384,4385,4386,4387,4388,4389,4390,4391,4392,4393,4394,4395,4396,4397,4398,4399,4400,4401,4402,4403,4404,4405,4406,4407,4408,4409,4410,4411,4412,4413,4414,4415,4416,4417,4418],"revision_id":1501803},"mentions":[{"id":"c-nanqishu-053-local-officials-complete:p035:m0002","start":2,"end":4,"surface":"琇之","kind":"person","person_id":"f84_da6_42a_AAAA","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p035:m0066","start":66,"end":68,"surface":"琇之","kind":"person","person_id":"f84_da6_42a_AAAA","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p035:m0077","start":77,"end":79,"surface":"琇之","kind":"person","person_id":"f84_da6_42a_AAAA","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-053-local-officials-complete","book_id":"b-nanqishu-053","work_id":"w-nanqishu","source_id":"s-nanqishu-053-local-officials-complete-ws1501803"},{"id":"c-nanqishu-053-local-officials-complete:p036","text":"　　遷尚書左丞，又以職事知名。轉前軍將軍，兼少府。遷驍騎將軍，少府如故。出爲寧朔將軍、高宗冠軍征虜長史、江夏內史。還爲正員常侍，兼左民尚書、廷尉卿。出爲臨海太守，在任清約，罷郡還，獻乾薑二十斤，世祖嫌少，及知琇之清，乃歎息。除武陵王前軍長史，未拜，仍出爲輔國將軍，監吳興郡，尋拜太守，治稱清嚴。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":94,"last_line":94,"raw_start":4421,"raw_end":4568,"raw_character_offsets":[4421,4422,4423,4424,4425,4426,4427,4428,4429,4430,4431,4432,4433,4434,4435,4436,4437,4438,4439,4440,4441,4442,4443,4444,4445,4446,4447,4448,4449,4450,4451,4452,4453,4454,4455,4456,4457,4458,4459,4460,4461,4462,4463,4464,4465,4466,4467,4468,4469,4470,4471,4472,4473,4474,4475,4476,4477,4478,4479,4480,4481,4482,4483,4484,4485,4486,4487,4488,4489,4490,4491,4492,4493,4494,4495,4496,4497,4498,4499,4500,4501,4502,4503,4504,4505,4506,4507,4508,4509,4510,4511,4512,4513,4514,4515,4516,4517,4518,4519,4520,4521,4522,4523,4524,4525,4526,4527,4528,4529,4530,4531,4532,4533,4534,4535,4536,4537,4538,4539,4540,4541,4542,4543,4544,4545,4546,4547,4548,4549,4550,4551,4552,4553,4554,4555,4556,4557,4558,4559,4560,4561,4562,4563,4564,4565,4566,4567],"revision_id":1501803},"mentions":[{"id":"c-nanqishu-053-local-officials-complete:p036:m0043","start":43,"end":45,"surface":"高宗","kind":"person","person_id":"w4m_9tw_147","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p036:m0097","start":97,"end":99,"surface":"世祖","kind":"person","person_id":"kix_r92_2ed","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p036:m0104","start":104,"end":106,"surface":"琇之","kind":"person","person_id":"f84_da6_42a_AAAA","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-053-local-officials-complete","book_id":"b-nanqishu-053","work_id":"w-nanqishu","source_id":"s-nanqishu-053-local-officials-complete-ws1501803"},{"id":"c-nanqishu-053-local-officials-complete:p037","text":"　　高宗輔政，防制諸蕃，致密旨於上佐。隆昌元年，遷琇之爲寧朔將軍、晉熙王冠軍長史，行郢州事，江夏內史。琇之辭，不許。未拜，卒。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":96,"last_line":96,"raw_start":4570,"raw_end":4640,"raw_character_offsets":[4570,4571,4572,4573,4574,4575,4576,4577,4578,4579,4580,4581,4582,4583,4584,4585,4586,4587,4588,4594,4595,4596,4597,4600,4601,4602,4603,4604,4605,4606,4607,4608,4609,4610,4611,4612,4613,4614,4615,4616,4617,4618,4619,4620,4621,4622,4623,4624,4625,4626,4627,4628,4629,4630,4631,4632,4633,4634,4635,4636,4637,4638,4639],"revision_id":1501803},"mentions":[{"id":"c-nanqishu-053-local-officials-complete:p037:m0002","start":2,"end":4,"surface":"高宗","k