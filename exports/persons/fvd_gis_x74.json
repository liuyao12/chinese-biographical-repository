nguozhi-050-xu:line026","chapter_id":"c-sanguozhi-050-xu"},{"id":"c-sanguozhi-057-yufan:line013-pei01-02:m0190","start":190,"end":193,"surface":"刘扬州","kind":"person","person_id":"fvd_gis_x74","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-057-yufan:line013-pei01-02","chapter_id":"c-sanguozhi-057-yufan"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-050-wu:line014","text":"景常隨堅征伐有功，拜騎都尉。袁術上景領丹楊太守，討故太守周昕，遂據其郡。孫策與孫河、呂範依景，合眾共討涇縣山賊祖郎。郎敗走。會為劉繇所迫，景復北依術，術以為督軍中郎將，與孫賁共討樊能、於麋於橫江，又擊笮融、薛禮於秣陵。時策被創牛渚，降賊復反，景攻討，盡禽之。從討劉繇，繇奔豫章，策遣景、賁到壽春報術。術方與劉備爭徐州，以景為為廣陵太守。術後僭號。策以書喻術，術不納，便絕江津，不與通，使人告景。景即委郡東歸，策復以景為丹揚太守。漢遣議郎王誧銜命南行，表景為揚武將軍，領郡如故。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-050-wu:line014:m0000","start":0,"end":1,"surface":"景","kind":"person","person_id":"ere_ume_47r","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-wu:line014:m0003","start":3,"end":4,"surface":"堅","kind":"person","person_id":"ki7_rgz_3l4","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-wu:line014:m0015","start":15,"end":16,"surface":"術","kind":"person","person_id":"865_b69_cb0","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-wu:line014:m0017","start":17,"end":18,"surface":"景","kind":"person","person_id":"ere_ume_47r","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-wu:line014:m0028","start":28,"end":30,"surface":"周昕","kind":"person","person_id":"lsy_sjz_pse","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-wu:line014:m0037","start":37,"end":38,"surface":"策","kind":"person","person_id":"e9c_070_567","status":"contextu