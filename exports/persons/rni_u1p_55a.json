不時迎輔，陰圖之。又殺天水太守封尚，欲揚威西土。召隴西太守韓稚會議，未決。稚子朴有武幹，斬異議者，即收兵伐輔。輔與稚戰于遮多穀口，輔軍敗績，為天水故帳下督富整所殺。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":57,"last_line":57,"raw_start":4204,"raw_end":4413,"raw_character_offsets":[4206,4207,4208,4209,4210,4211,4212,4213,4214,4215,4216,4217,4218,4219,4220,4221,4222,4223,4224,4225,4226,4227,4228,4229,4230,4231,4232,4233,4234,4235,4236,4237,4238,4239,4240,4241,4242,4243,4244,4245,4246,4247,4248,4249,4250,4251,4252,4253,4254,4255,4256,4257,4258,4259,4260,4261,4262,4263,4264,4265,4266,4267,4268,4269,4270,4271,4272,4273,4274,4275,4276,4277,4278,4279,4280,4281,4282,4283,4284,4285,4286,4287,4288,4289,4290,4291,4292,4293,4294,4295,4296,4297,4298,4299,4300,4301,4302,4303,4304,4305,4306,4307,4308,4309,4310,4311,4312,4313,4314,4315,4316,4317,4318,4319,4320,4321,4322,4323,4324,4325,4326,4327,4328,4329,4330,4331,4332,4333,4334,4335,4336,4337,4338,4339,4340,4341,4342,4343,4344,4345,4346,4347,4348,4349,4350,4351,4352,4353,4354,4355,4356,4357,4358,4359,4360,4361,4362,4363,4364,4365,4366,4367,4368,4369,4370,4371,4372,4373,4374,4375,4376,4377,4378,4379,4380,4381,4382,4383,4384,4385,4386,4387,4388,4389,4390,4391,4392,4393,4394,4395,4396,4397,4398,4399,4400,4401,4402,4403,4404,4405,4406,4407,4408,4409,4410,4411,4412],"revision_id":2413335},"mentions":[{"id":"c-jinshu-060-zhangfu:p003:m0009","surface":"長沙王乂","start":9,"end":13,"person_id":"4c6_984_9ed","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfu:p003:m0014","surface":"河間王顒","start":14,"end":18,"person_id":"ed0_313_bea","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfu:p003:m0031","surface":"惠帝","start":31,"end":33,"person_id":"7e0_f69_1ac","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfu:p003:m0040","surface":"劉沈","start":40,"end":42,"person_id":"e7d_w1d_ybe","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfu:p003:m0047","surface":"皇甫重","start":