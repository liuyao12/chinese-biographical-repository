儒","kind":"person","person_id":"7r6_k52_qji_ABDB","status":"contextual_provisional"},{"id":"c-jinshu-076-wangbin:line046:m0024","start":24,"end":26,"surface":"傅祗","kind":"person","person_id":"6x2_7cd_tw2","status":"contextual_provisional"},{"id":"c-jinshu-076-wangbin:line046:m0033","start":33,"end":34,"surface":"廙","kind":"person","person_id":"7r6_k52_qji_ABDA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangbin:line046:m0043","start":43,"end":45,"surface":"劉機","kind":"person","person_id":"4jn_rcu_wkb","status":"contextual_provisional"},{"id":"c-jinshu-076-wangbin:line046:m0050","start":50,"end":52,"surface":"元帝","kind":"person","person_id":"dkn_ge4_286_AAAAAAA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangbin:line046:m0069","start":69,"end":71,"surface":"華軼","kind":"person","person_id":"p86_bh6_jm2","status":"contextual_provisional"},{"id":"c-jinshu-076-wangbin:line046:m0078","start":78,"end":80,"surface":"湣帝","kind":"person","person_id":"pss_n95_7x4","status":"contextual_provisional"}],"source_position":{"first_line":46,"last_line":46,"revision_id":2180533,"editorial_excerpt_boundary":false},"chapter_id":"c-jinshu-076-wangbin","book_id":"b-jinshu-076","work_id":"w-jinshu","source_id":"s-jinshu-076-wangbin"}],"sources":[{"chapter_id":"c-jinshu-068-gurong","work_id":"w-jinshu","book_id":"b-jinshu-068","source_id":"s-jinshu-068-gurong-ws2581578","source":{"title":"晉書卷六十八·顧榮","provider":"Wikisource","permalink":"https://zh.wikisource.org/w/index.php?oldid=2581578","url":"https://zh.wikisource.org/w/index.php?oldid=2581578","revision_id":2581578,"edition":"維基文庫固定修訂","accessed_on":"2026-11-22","review_status":"text_checked","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫授權。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","extent":"晉書卷六十八·顧榮","text_scope":"complete_biography_unit","raw_path":"source-evidence/jin068-roll/ws2581578.wikitext","raw_file_sha256":"51c836e14087ecf3b0f6577aae470c286607c067dd0331e306b5a3c42f3d10dc","collation_witnesses":["source-evidence/jin068-roll/volume-reading.json"]}},{"chapter_id":"c-jinshu-076-wangbin","work_id":"w-jinshu","book_id":"b-jinshu-076","source_id":"s-jinshu-076-wangbin","source":{"title":"《晉書》卷76（王彬傳）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7076&oldid=2180533","permalink":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7076&oldid=2180533","revision_id":2180533,"accessed_on":"2026-10-18","extent":"王彬完整四原段，其他傳記另錄。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，未親核底本影像","response_sha256":"c6c7c41bf93c491f6f69b058ecc493e979d65f3e65397d20055284f2e829cd30","wikitext_sha256":"872701db949f6f58ea6f183425617dfa82353177d2cc026037bfad953a60cd71","normalization":{"character_conversion":{},"extraction_note":"保留原字及標點；僅移除原段縮排。","excerpts":[{"proposed_paragraph_id":"c-jinshu-076-wangbin:line046","source_lines":[46,46],"raw_quote":"彬字世儒。少稱雅正，弱冠，不就州郡之命。光祿大夫傅祗辟為掾。後與兄廙俱渡江，為揚州刺史劉機建武長史。元帝引為鎮東賊曹參軍，轉典兵參軍。豫討華軼功，封都亭侯，湣帝召為尚書郎，以道險不就。遷建安太守，徙義興內史，未之職，轉軍諮祭酒。","raw_quote_sha256":"f3d08d3e962f98599df686c00627e520f63359a1ca2482fe5a4c43ed9f34450e","selected_text_sha256":"f3d08d3e962f98599df686c00627e520f63359a1ca2482fe5a4c43ed9f34450e","begin_anchor":"彬字世儒。少稱雅正，弱冠，不就州郡之","end_anchor":"守，徙義興內史，未之職，轉軍諮祭酒。"},{"proposed_paragraph_id":"c-jinshu-076-wangbin:line048","source_lines":[48,48],"raw_quote":"中興建，稍遷侍中。從兄敦舉兵石頭，帝使彬勞之。會周顗遇害，彬素與顗善，先往哭顗，甚慟。既而見敦，敦怪其有慘容，而問其所以。彬曰：「向哭伯仁，情未能已。」敦怒曰：「伯仁自致刑戮，且凡人遇汝，復何為者哉！」彬曰：「伯仁長者，君之親友，在朝雖無謇諤，亦非阿黨，而赦後加以極刑，所以傷惋也。」因勃然數敦曰：「兄抗旌犯順，殺戮忠良，謀圖不軌，禍及門戶。」音辭慷慨，聲淚俱下。敦大怒，厲聲曰：「爾狂悖乃可至此，為吾不能殺汝邪！」時王導在坐，為之懼，勸彬起謝。彬曰：「有腳疾已來，見天子尚欲不拜，何跪之有！此復何所謝！」敦曰：「腳痛孰若頸痛？」彬意氣自若，殊無懼容。後敦議舉兵向京師，彬諫甚苦。敦變色目左右，將收彬，彬正色曰：「君昔歲害兄，今又殺弟邪？」先是，彬從兄豫章太守棱為敦所害，敦以彬親故容忍之。俄而以彬為豫章太守。彬為人樸素方直，乏風味之好，雖居顯貴，常布衣蔬食。遷前將軍、江州刺史。","raw_quote_sha256":"71a8b5f32b67281085cae98c227cee7907400d835b4071fd0b8cf9e0a2e4d119","selected_text_sha256":"71a8b5f32b67281085cae98c227cee7907400d835b4071fd0b8cf9e0a2e4d119","begin_anchor":"中興建，稍遷侍中。從兄敦舉兵石頭，帝","end_anchor":"貴，常布衣蔬食。遷前將軍、江州刺史。"},{"proposed_paragraph_id":"c-jinshu-076-wangbin:line050","source_lines":[50,50],"raw_quote":"及敦死，王含欲投王舒，王應勸含投彬。含曰：「大將軍平素與江州云何，汝欲歸之？」應曰：「此乃所以宜往也。江州當人強盛時，能立同異，此非常人所及。睹衰厄，必興湣惻。荊州守文，豈能意外行事！」含不從，遂共投舒，舒果沈含父子于江。彬聞應來，密具船以待之。既不至，深以為恨。","raw_quote_sha256":"a1ee93c717f96341bd0671d41b2ff1d52c407d358d8c7ebde6d608966fc88d3b","selected_text_sha256":"a1ee93c717f96341bd0671d41b2ff1d52c407d358d8c7ebde6d608966fc88d3b","begin_anchor":"及敦死，王含欲投王舒，王應勸含投彬。","end_anchor":"來，密具船以待之。既不至，深以為恨。"},{"proposed_paragraph_id":"c-jinshu-076-wangbin:line052","source_lines":[52,52],"raw_quote":"敦平，有司奏彬及兄子安成太守籍之，並是敦親，皆除名。詔曰：「司徒導以大義滅親，其後昆雖或有違，猶將百世宥之，況彬等公之近親。」乃原之。徵拜光祿勳，轉度支尚書。蘇峻平後，改築新宮，彬為大匠。以營創勳勞，賜爵關內侯，遷尚書右僕射。卒官，年五十九。贈特進、衛將軍，加散騎常侍，諡曰肅。長子彭之嗣，位至黃門郎。次彪之，最知名。","raw_quote_sha256":"ad3b975e66cdd1e8ff7925d16c3c7b0a8f1f76532037c500192eff7f49d969dd","selected_text_sha256":"ad3b975e66cdd1e8ff7925d16c3c7b0a8f1f76532037c500192eff7f49d969dd","begin_anchor":"敦平，有司奏彬及兄子安成太守籍之，並","end_anchor":"彭之嗣，位至黃門郎。次彪之，最知名。"}]}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true}}
