"}],"relations":[{"id":"a-shiji005-027","subject_person_id":"cbr-p000345","predicate":"spouse","object_person_id":"cbr-p000346","status":"source_attested","evidence":[{"paragraph_id":"c-shiji-005-qin:p009","quote":"以女弟繆嬴為豐王妻","chapter_id":"c-shiji-005-qin","source_id":"s-shiji-005-qin"}],"qualifiers":{"source_term":"妻","historicity":"historical_tradition"},"interpretation_note":"只保存本文明示關係，不由繼位或熟知世系推導；數位見證仍待校勘。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji005-042","subject_person_id":"cbr-p000345","predicate":"sister","object_person_id":"cbr-p000344","status":"source_attested","evidence":[{"paragraph_id":"c-shiji-005-qin:p009","quote":"襄公元年，以女弟繆嬴為豐王妻","chapter_id":"c-shiji-005-qin","source_id":"s-shiji-005-qin"}],"qualifiers":{"source_term":"女弟","historicity":"historical_tradition"},"interpretation_note":"姊與女弟按原文保存；不推定同父同母或補造姓名。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-005-qin:p009","text":"襄公元年，以女弟繆嬴為豐王妻。襄公二年，戎圍犬丘，世父擊之，為戎人所虜。歲餘，復歸世父。七年春，周幽王用褒姒廢太子，立褒姒子為適，數欺諸侯，諸侯叛之。西戎犬戎與申侯伐周，殺幽王酈山下。而秦襄公將兵救周，戰甚力，有功。周避犬戎難，東徙雒邑，襄公以兵送周平王。平王封襄公為諸侯，賜之岐以西之地。曰：「戎無道，侵奪我岐、豐之地，秦能攻逐戎，即有其地。」與誓，封爵之。襄公於是始國，與諸侯通使聘享之禮，乃用騮駒、黃牛、羝羊各三，祠上帝西畤。十二年，伐戎而至岐，卒。生文公。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m009-0000","start":0,"end":2,"surface":"襄公","kind":"person","person_id":"cbr-p000344","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0008","start":8,"end":10,"surface":"繆嬴","kind":"person","person_id":"cbr-p000345","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0011","start":11,"end":13,"surface":"豐王","kind":"person","person_id":"cbr-p000346","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0015","start":15,"end":17,"surface":"襄公","kind":"person","person_id":"cbr-p000344","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0025","start":25,"end":27,"surfac