hapter_id":"c-shiji-130-taishigong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-130-taishigong:p012","text":"於是論次其文。七年而太史公遭李陵之禍，幽於縲紲。乃喟然而嘆曰：「是余之罪也夫！是余之罪也夫！身毀不用矣。」退而深惟曰：「夫詩書隱約者，欲遂其志之思也。昔西伯拘羑里，演周易；孔子戹陳蔡，作春秋；屈原放逐，著離騷；左丘失明，厥有國語；孫子臏腳，而論兵法；不韋遷蜀，世傳呂覽；韓非囚秦，說難、孤憤；詩三百篇，大抵賢聖發憤之所為作也。此人皆意有所郁結，不得通其道也，故述往事，思來者。」於是卒述陶唐以來，至于麟止，自黃帝始。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m012-0010","start":10,"end":13,"surface":"太史公","kind":"person","person_id":"pme_eis_xqi_*A*AAAAA","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m012-0014","start":14,"end":16,"surface":"李陵","kind":"person","person_id":"3tq_5qz_qb9","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m012-0076","start":76,"end":78,"surface":"西伯","kind":"person","person_id":"yi5_jym_uoz","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m012-0086","start":86,"end":88,"surface":"孔子","kind":"person","person_id":"8zh_d7n_e93","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m012-0096","start":96,"end":98,"surface":"屈原","kind":"person","person_id":"e7f_ip0_jk1","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m012-0105","start":105,"end":107,"surface":"左丘","kind":"person","person_id":"asu_nj9_wb8","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m012-0115","start":115,"end":117,"surface":"孫子","kind":"person","person_id":"0jo_9fp_dpo","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m012-0125","start":125,"end":127,"surface":"不韋","kind":"person","person_id":"puu_6hs_m4f","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m012-0135","start":135,"end":137,"surface":"韓非","kind":"person","person_id":"0ze_qgj_quv","status":"contextual_provisional