itness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-054-zhouyu:line025-pei01-01:m0006","start":6,"end":7,"surface":"備","kind":"person","person_id":"5f2_396_25c","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-zhouyu:line025-pei01-01:m0008","start":8,"end":9,"surface":"瑜","kind":"person","person_id":"f56_938_997","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-zhouyu:line025-pei01-01:m0012","start":12,"end":13,"surface":"仁","kind":"person","person_id":"8po_0xd_0vn","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-zhouyu:line025-pei01-01:m0029","start":29,"end":32,"surface":"張益德","kind":"person","person_id":"qtm_fq1_1ca","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-zhouyu:line025-pei01-01:m0053","start":53,"end":54,"surface":"仁","kind":"person","person_id":"8po_0xd_0vn","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-zhouyu:line025-pei01-01:m0056","start":56,"end":57,"surface":"仁","kind":"person","person_id":"8po_0xd_0vn","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-zhouyu:line025-pei01-01:m0064","start":64,"end":65,"surface":"瑜","kind":"person","person_id":"f56_938_997","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"}],"annotation_status":"reviewed","source_position":{"first_line":25,"last_line":25,"revision_id":2387393,"raw_start":3195,"raw_end":3267,"character_positions":[3195,3196,3197,3198,3199,3200,3201,3202,3203,3204,3205,3206,3207,3208,3209,3210,3211,3212,3213,3214,3215,3216,3217,3218,3219,3220,3221,3222,3223,3224,3225,3226,3227,3228,3229,3230,3231,3232,3233,3234,3235,3236,3237,3238,3239,3240,3241,3242,3243,3244,3245,3246,3247,3248,3249,3250,3251,3252,3253,3254,3255,3256,3257,3258,3259,3260,3261,3262,3263,3264,3265,3266]},"attribution":{"annotator":"裴松之","attribution_kind":"quoted_work","source_label":"吳錄","attribution_marker":"《吳錄》曰：","quoted_work":"吳錄"},"attachment":{"received_paragraph_id":"c-sanguozhi-054-zhouyu:line025","received_codepoint":26,"note_ordinal":1,"source_ordinal":1},"chapter_id":"c-sanguozhi-054-zhouyu","book_id":"b-sanguozhi-054","work_id":"w-sanguozhi","source_id":"s-sanguozhi-054-zhouyu"},{"id":"c-sanguozhi-054-zhouyu:line027","text":"　　權拜瑜偏將軍，領南郡太守。以下雋、漢昌、劉陽、州陵為奉邑，屯據江陵。劉備以左將軍領荊州牧，治公安，備詣京見權，瑜上疏曰：「劉備以梟雄之姿，而有關羽、張飛熊虎之將，必非久屈為人用者。愚謂大計宜徙備置吳，盛為築宮室，多其美女玩好，以娛其耳目，分此二人，各置一方，使如瑜者得挾與攻戰，大事可定也。今猥割土地以資業之，聚此三人，俱在疆場，恐蛟龍得雲雨，終非池中物也。」權以曹公在北方，當廣攬英雄，又恐備難卒制，故不納。是時劉璋為益州牧。外有張魯寇侵，瑜乃詣京見權曰：「今曹操新折衄，方憂在腹心，未能與將軍連兵相事也。乞與奮威俱進取蜀，得蜀而並張魯，因留奮威固守其地，好與馬超結援。瑜還與將軍據襄陽以蹙操，北方可圖也。」權許之。瑜還江陵為行裝，而道於巴丘病卒，時年三十六。權素服舉哀。感動左右。喪當還吳，又迎之蕪湖，眾事費度，一為供給。後著令曰：「故將軍周瑜、程普，其有人客，皆不得問。」","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-054-zhouyu:line027:m0002","start":2,"end":3,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-zhouyu:line027:m0004","start":4,"end":5,"surface":"瑜","kind":"person","person_id":"f56_938_997","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-zhouyu:line027:m0036","start":36,"end":38,"surface":"劉備","kind":"person","person_id":"5f2_396_25c","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-zhouyu:line027:m0051","start":51,"end":52,"surface":"備","kind":"person","person_id":"5f2_396_25c","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-zhouyu:line027:m0055","start":55,"end":56,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-zhouyu:line027:m0057","start":57,"end":58,"surface":"瑜","kind":"person","person_id":"f56_938_997","status":"contextual_provisional","interpretation_note":"依