r_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-043-jiangxiao-complete:p003","text":"　　初，宋明帝勑斆出繼從叔愻，爲從祖淳後。於是僕射王儉啓：「禮無後小宗之文，近世緣情，皆由父祖之命，未有旣孤之後，出繼宗族也。雖復臣子一揆，而義非天屬。江忠簡胤嗣所寄，唯斆一人，傍無眷屬。斆宜還本。若不欲江愻絕後，可以斆小兒繼愻爲孫。」尚書參議，謂「間世立後，禮無其文。荀顗無子立孫，墜禮之始。何琦又立此論，義無所據」。於是斆還本家，詔使自量立後者。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":15,"last_line":15,"raw_start":532,"raw_end":707,"raw_character_offsets":[532,533,534,535,536,537,538,539,540,541,542,543,544,545,546,547,548,549,550,551,552,553,554,555,556,557,558,559,560,561,562,563,564,565,566,567,568,569,570,571,572,573,574,575,576,577,578,579,580,581,582,583,584,585,586,587,588,589,590,591,592,593,594,595,596,597,598,599,600,601,602,603,604,605,606,607,608,609,610,611,612,613,614,615,616,617,618,619,620,621,622,623,624,625,626,627,628,629,630,631,632,633,634,635,636,637,638,639,640,641,642,643,644,645,646,647,648,649,650,651,652,653,654,655,656,657,658,659,660,661,662,663,664,665,666,667,668,669,670,671,672,673,674,675,676,677,678,679,680,681,682,683,684,685,686,687,688,689,690,691,692,693,694,695,696,697,698,699,700,701,702,703,704,705,706],"revision_id":2400356},"mentions":[{"id":"c-nanqishu-043-jiangxiao-complete:p003:m0004","start":4,"end":7,"surface":"宋明帝","kind":"person","person_id":"cti_o52_4nz","status":"contextual_provisional"},{"id":"c-nanqishu-043-jiangxiao-complete:p003:m0008","start":8,"end":9,"surface":"斆","kind":"person","person_id":"s2k_e90_mxi","status":"contextual_provisional"},{"id":"c-nanqishu-043-jiangxiao-complete:p003:m0013","start":13,"end":14,"surface":"愻","kind":"person","person_id":"k44_d1k_2le","status":"contextual_provisional"},{"id":"c-nanqishu-043-jiangxiao-complete:p003:m0018","start":18,"end":19,"surface":"淳","kind":"person","person_id":"700_4nm_ab2","status":"contextual_provisional"},{"id":"c-nanqishu-043-jiangxiao-complete:p003:m0025","start":25,"end":27,"surface":"王儉","kind":"person","person_id":"7r6_k52_qji_