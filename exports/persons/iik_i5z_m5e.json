{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"iik_i5z_m5e","canonical_person_id":"iik_i5z_m5e","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["iik_i5z_m5e"],"persons":[{"id":"iik_i5z_m5e","label":"春申（游俠列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"春申","mention_ids":["c-shiji-124-youxia:m005-0020"]}],"evidence":[{"mention_id":"c-shiji-124-youxia:m005-0020","chapter_id":"c-shiji-124-youxia","paragraph_id":"c-shiji-124-youxia:p005","quote":"春申"}]}],"source_mention_summary":[{"source_id":"s-shiji124-youxia","work_id":"w-shiji","book_id":"b-shiji-124","chapter_id":"c-shiji-124-youxia","mention_count":1,"mention_ids":["c-shiji-124-youxia:m005-0020"],"paragraph_ids":["c-shiji-124-youxia:p005"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji124-youxia"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-124-youxia:m005-0020","start":20,"end":22,"surface":"春申","kind":"person","person_id":"iik_i5z_m5e","status":"contextual_provisional","paragraph_id":"c-shiji-124-youxia:p005","chapter_id":"c-shiji-124-youxia"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-124-youxia:p005","text":"古布衣之俠，靡得而聞已。近世延陵、孟嘗、春申、平原、信陵之徒，皆因王者親屬，藉於有土卿相之富厚，招天下賢者，顯名諸侯，不可謂不賢者矣。比如順風而呼，聲非加疾，其埶激也。至如閭巷之俠，脩行砥名，聲施於天下，莫不稱賢，是為難耳。然儒、墨皆排擯不載。自秦以前，匹夫之俠，湮滅不見，余甚恨之。以余所聞，漢興有朱家、田仲、王公、劇孟、郭解之徒，雖時扞當世之文罔，然其私義廉絜退讓，有足稱者。名不虛立，士不虛附。至如朋黨宗彊比周，設財役貧，豪暴侵淩孤弱，恣欲自快，游俠亦醜之。余悲世俗不察其意，而猥以朱家、郭解等令與暴豪之徒同類而共笑之也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-124-youxia:m005-0014","start":14,"end":16,"surface":"延陵","kind":"person","person_id":"9o9_3nf_hyq","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m005-0017","start":17,"end":19,"surface":"孟嘗","kind":"person","person_id":"6l6_dtm_6tt","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m005-0020","start":20,"end":22,"surface":"春申","kind":"person","person_id":"iik_i5z_m5e","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m005-0023","start":23,"end":25,"surface":"平原","kind":"person","person_id":"0td_td4_i0v","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m005-0026","start":26,"end":28,"surface":"信陵","kind":"person","person_id":"3k9_4y0_6z1","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m005-0113","start":113,"end":116,"surface":"儒、墨","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-124-youxia:m005-0150","start":150,"end":152,"surface":"朱家","kind":"person","person_id":"hn3_zjy_ggs","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m005-0153","start":153,"end":155,"surface":"田仲","kind":"person","person_id":"qg3_81p_5ti","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m005-0156","start":156,"end":158,"surface":"王公","kind":"person","person_id":"t00_u9v_yvd","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m005-0159","start":159,"end":161,"surface":"劇孟","kind":"person","person_id":"5se_9f5_u2q","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m005-0162","start":162,"end":164,"surface":"郭解","kind":"person","person_id":"5if_pf6_zos_A","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m005-0244","start":244,"end":246,"surface":"朱家","kind":"person","person_id":"hn3_zjy_ggs","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m005-0247","start":247,"end":249,"