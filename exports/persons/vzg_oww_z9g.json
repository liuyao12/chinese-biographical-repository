itness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-songshu-092-ruanchangzhi:relative_death_date2-207","kind":"relative_death_date","person_id":"vzg_oww_z9g","source_quote":"至郡少時而母亡","reading":"元嘉十一年受臨海至十四年子卒之間，母先卒並已葬。","note":"元嘉十一年受臨海至十四年子卒之間，母先卒並已葬。","paragraph_id":"c-songshu-092-ruanchangzhi:p002","start_codepoint":207,"end_codepoint":214,"human_reviewed":false,"not_before":434,"not_after":437,"chapter_id":"c-songshu-092-ruanchangzhi","source_id":"s-songshu-092-ruanchangzhi-ws2195614"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-song092-changzhi-mother","subject_person_id":"qkt_yf2_rsg","object_person_id":"vzg_oww_z9g","predicate":"mother","qualifiers":{"source_term":"而母亡","reading_basis":{"kind":"song092_prose_kin","unit":"changzhi"}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-092","chapter_id":"c-songshu-092-ruanchangzhi","source_id":"s-songshu-092-ruanchangzhi-ws2195614","paragraph_id":"c-songshu-092-ruanchangzhi:p002","quote":"長之年十五喪父，有孝性，哀感傍人。服除，蔬食者猶積載。閑居篤學，未嘗有惰容。初為諸府參軍，除員外散騎侍郎。母老，求補襄垣令，督郵無禮，鞭之，去職。尋補廬陵王義真車騎行正參軍，平越長史，東莞太守。入為尚書殿中郎，出為武昌太守。時王弘為江州，雅相知重，引為車騎從事中郎。入為太子中舍人，中書侍郎，以母老固辭朝直，補彭城王義康平北諮議參軍。元嘉九年，遷臨川內史，以南土卑濕，母年老，非所宜，辭不就。十一年，復除臨海太守。至郡少時而母亡，葬畢，不勝憂，十四年，卒，時年五十九。","subject_person_mention_id":"c-songshu-092-ruanchangzhi:p002:m0000","object_person_reference_id":"c-songshu-092-ruanchangzhi:p002:r0212"}],"status":"source_attested","interpretation_note":"從求縣、辭朝直、辭出臨川至臨海奉母，文中只見母稱。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"me