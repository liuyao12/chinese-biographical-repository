y_paths":[],"mentions":[{"id":"c-shiji-071-chugan:m005-0017","start":17,"end":19,"surface":"胡衍","kind":"person","person_id":"cbr-p004157","status":"contextual_provisional","paragraph_id":"c-shiji-071-chugan:p005","chapter_id":"c-shiji-071-chugan"},{"id":"c-shiji-071-chugan:m005-0020","start":20,"end":22,"surface":"胡衍","kind":"person","person_id":"cbr-p004157","status":"contextual_provisional","paragraph_id":"c-shiji-071-chugan:p005","chapter_id":"c-shiji-071-chugan"},{"id":"c-shiji-071-chugan:m005-0155","start":155,"end":157,"surface":"胡衍","kind":"person","person_id":"cbr-p004157","status":"contextual_provisional","paragraph_id":"c-shiji-071-chugan:p005","chapter_id":"c-shiji-071-chugan"},{"id":"c-shiji-071-chugan:m005-0189","start":189,"end":191,"surface":"胡衍","kind":"person","person_id":"cbr-p004157","status":"contextual_provisional","paragraph_id":"c-shiji-071-chugan:p005","chapter_id":"c-shiji-071-chugan"},{"id":"c-shiji-071-chugan:m005-0216","start":216,"end":217,"surface":"衍","kind":"person","person_id":"cbr-p004157","status":"contextual_provisional","paragraph_id":"c-shiji-071-chugan:p005","chapter_id":"c-shiji-071-chugan"},{"id":"c-shiji-071-chugan:m005-0271","start":271,"end":273,"surface":"胡衍","kind":"person","person_id":"cbr-p004157","status":"contextual_provisional","paragraph_id":"c-shiji-071-chugan:p005","chapter_id":"c-shiji-071-chugan"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji071-016","person_id":"cbr-p004157","surfaces":["胡衍","衍"],"scope":"same_chapter","chapter_ids":["c-shiji-071-chugan"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-071-chugan:p005","quote":"昭王元年，樗里子將伐蒲。蒲守恐，請胡衍。胡衍為蒲謂樗里子曰：「公之攻蒲，為秦乎？為魏乎？為魏則善矣，為秦則不為賴矣。夫衛之所以為衛者，以蒲也。今伐蒲入於魏，衛必折而從之。魏亡西河之外而無以取者，兵弱也。今并衛於魏，魏必彊。魏彊之日，西河之外必危矣。且秦王將觀公之事，害秦而利魏，王必罪公。」樗里子曰：「柰何？」胡衍曰：「公釋蒲勿攻，臣試為公入言之，以德衛君。」樗里子曰：「善。」胡衍入蒲，謂其守曰：「樗里子知蒲之病矣，其言曰必拔蒲。衍能令釋蒲勿攻。」蒲守恐，因再拜曰：「願以請。」因效金三百斤，曰：「秦兵茍退，請必言子於衛君，使子為南面。」故胡衍受金於蒲以自貴於衛。於是遂解蒲而去。還擊皮氏，皮氏未降，又去。"}],"rationale":"依前6段明示名字與局部敘事暫接，樗里子名疾與智囊嚴君明示相配。樗裏只取末句人物比擬，不取陰鄉地名；預言天子不補漢代皇帝。惠王、武王、昭王依卒立分辨；未名韓女、蒲守與衛君不補姓名，異母不補惠王母。游騰引古知伯齊桓公不當同期在場者。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-071-chugan:p005","text":"昭王元年，樗里子將伐蒲。蒲守恐，請胡衍。胡衍為蒲謂樗里子曰：「公之攻蒲，為秦乎？為魏乎？為魏則善矣，為秦則不為賴矣。夫衛之所以為衛者，以蒲也。今伐蒲入於魏，衛必折而從之。魏亡西河之外而無以取者，兵弱也。今并衛於魏，魏必彊。魏彊之日，西河之外必危矣。且秦王將觀公之事，害秦而利魏，王必罪公。」樗里子曰：「柰何？」胡衍曰：「公釋蒲勿攻，臣試為公入言之，以德衛君。」樗里子曰：「善。」胡衍入蒲，謂其守曰：「樗里子知蒲之病矣，其言曰必拔蒲。衍能令釋蒲勿攻。」蒲守恐，因再拜曰：「願以請。」因效金三百斤，曰：「秦兵茍退，請必言子於衛君，使子為南面。」故胡衍受金於蒲以自貴於衛。於是遂解蒲而去。還擊皮氏，皮氏未降，又去。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-071-chugan:m005-0000","start":0,"end":2,"surface":"昭王","kind":"person","person_id":"cbr-p004149","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m005-0005","start":5,"end":8,"surface":"樗里子","kind":"person","person_id":"cbr-p004142","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m005-0012","start":12,"end":14,"surface":"蒲守","kind":"person","person_id":"cbr-p004156","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m005-0017","start":17,"end":19,"surface":"胡衍","kind":"person","person_id":"cbr-p004157","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m005-0020","start":20,"end":22,"surface":"胡衍","kind":"person","person_id":"cbr-p004157","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m005-0025","start":25,"end":28,"surface":"樗里子","kind":"person","person_id":"cbr-p004142","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m005-0031","start":31,"end":32,"surface":"公","kind":"person","person_id":"cbr-p004142","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m005-0125","start":125,"end":127,"surface":"秦王","kind":"person","person_id":"cbr-p004149","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m005-0129","start":129,"end":130,"surface":"公","kind":"person","person_id":"cbr-p004142","status":"con