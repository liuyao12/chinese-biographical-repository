_layer":"received_chapter","mentions":[{"id":"c-shiji-032-qi:m066-0005","start":5,"end":7,"surface":"慶封","kind":"person","person_id":"ect_ro2_yyf","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m066-0012","start":12,"end":14,"surface":"慶封","kind":"person","person_id":"ect_ro2_yyf","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m066-0016","start":16,"end":18,"surface":"崔杼","kind":"person","person_id":"xgd_r31_cmr","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m066-0032","start":32,"end":34,"surface":"慶舍","kind":"person","person_id":"9ec_mww_wxr","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m066-0042","start":42,"end":45,"surface":"田文子","kind":"person","person_id":"dfy_5r0_ek4","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m066-0046","start":46,"end":48,"surface":"桓子","kind":"person","person_id":"usk_ybs_z1y","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m066-0056","start":56,"end":64,"surface":"田、鮑、高、欒氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、族稱或未定指代；齊秉意茲等疑讀待版本校勘，不補熟知姓名。"},{"id":"c-shiji-032-qi:m066-0070","start":70,"end":72,"surface":"慶舍","kind":"person","person_id":"9ec_mww_wxr","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m066-0075","start":75,"end":77,"surface":"慶封","kind":"person","person_id":"ect_ro2_yyf","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m066-0087","start":87,"end":89,"surface":"慶封","kind":"person","person_id":"ect_ro2_yyf","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m066-0103","start":103,"end":104,"surface":"封","kind":"person","person_id":"ect_ro2_yyf","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m066-0132","start":132,"end":134,"surface":"莊公","kind":"person","person_id":"9w2_c77_53m_AAAA","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m066-0136","start":136,"end":138,"surface":"崔杼","kind":"person","person_id":"xgd_r31_cmr","status":"contextual_provisional"}],"chapter_id":"c-shiji-032-qi","b