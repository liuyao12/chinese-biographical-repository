],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-044-luchen:line067","text":"諶字子諒，清敏有理思，好《老》《莊》，善屬文。選尚武帝女滎陽公主，拜駙馬都尉，未成禮而公主卒。後州舉秀才，辟太尉掾。洛陽沒，隨志北依劉琨，與志俱為劉粲所虜。粲據晉陽，留諶為參軍。琨收散卒，引猗盧騎還攻粲。粲敗走，諶得赴琨，先父母兄弟在平陽者，悉為劉聰所害。琨為司空，以諶為主薄，轉從事中郎。琨妻即諶之從母，既加親愛，又重其才地。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-044-luchen:line067:m0000","start":0,"end":1,"surface":"諶","kind":"person","person_id":"m8n_ntm_79h_ABBA","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luchen:line067:m0002","start":2,"end":4,"surface":"子諒","kind":"person","person_id":"m8n_ntm_79h_ABBA","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luchen:line067:m0025","start":25,"end":27,"surface":"武帝","kind":"person","person_id":"hgm_jvn_hle","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luchen:line067:m0028","start":28,"end":32,"surface":"滎陽公主","kind":"person","person_id":"hgm_jvn_hle_B","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luchen:line067:m0043","start":43,"end":45,"surface":"公主","kind":"person","person_id":"hgm_jvn_hle_B","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luchen:line067:m0063","start":63,"end":64,"surface":"志","kind":"person","person_id":"m8n_ntm_79h_ABB","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luchen:line067:m0066","start":66,"end":68,"surface":"劉琨","kind":"person","person_id":"b21_e55_8bd","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luchen:line067:m0070","start":70,"end":71,"surface":"志","kind":"person","person_id":"m8n_ntm_79h_ABB","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-l