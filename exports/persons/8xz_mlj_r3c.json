{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"8xz_mlj_r3c","canonical_person_id":"8xz_mlj_r3c","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["8xz_mlj_r3c"],"persons":[{"id":"8xz_mlj_r3c","label":"韓千秋（南越列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"韓千秋","mention_ids":["c-shiji-113-nanyue:m009-0104","c-shiji-113-nanyue:m009-0309","c-shiji-113-nanyue:m009-0382"]},{"surface":"千秋","mention_ids":["c-shiji-113-nanyue:m009-0152","c-shiji-113-nanyue:m009-0341"]}],"evidence":[{"mention_id":"c-shiji-113-nanyue:m009-0104","chapter_id":"c-shiji-113-nanyue","paragraph_id":"c-shiji-113-nanyue:p009","quote":"韓千秋"},{"mention_id":"c-shiji-113-nanyue:m009-0152","chapter_id":"c-shiji-113-nanyue","paragraph_id":"c-shiji-113-nanyue:p009","quote":"千秋"},{"mention_id":"c-shiji-113-nanyue:m009-0309","chapter_id":"c-shiji-113-nanyue","paragraph_id":"c-shiji-113-nanyue:p009","quote":"韓千秋"},{"mention_id":"c-shiji-113-nanyue:m009-0341","chapter_id":"c-shiji-113-nanyue","paragraph_id":"c-shiji-113-nanyue:p009","quote":"千秋"},{"mention_id":"c-shiji-113-nanyue:m009-0382","chapter_id":"c-shiji-113-nanyue","paragraph_id":"c-shiji-113-nanyue:p009","quote":"韓千秋"}]},{"id":"8xz_mlj_r3c_A","label":"延年","status":"active","historicity":"historical_tradition","aliases":[{"surface":"延年","mention_ids":["c-shiji-113-nanyue:m009-0400"]}],"evidence":[{"mention_id":"c-shiji-113-nanyue:m009-0400","chapter_id":"c-shiji-113-nanyue","paragraph_id":"c-shiji-113-nanyue:p009","quote":"延年"}],"family_path":{"connection":"father","generation_distance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-113-nanyue","source_id":"s-shiji113-nanyue","paragraph_id":"c-shiji-113-nanyue:p009","quote":"天子聞嘉不聽王，王、王太后弱孤不能制，使者怯無決。又以為王、王太后已附漢，獨呂嘉為亂，不足以興兵，欲使莊參以二千人往使。參曰：「以好往，數人足矣；以武往，二千人無足以為也。」辭不可，天子罷參也。郟壯士故濟北相韓千秋奮曰：「以區區之越，又有王、太后應，獨相呂嘉為害，願得勇士二百人，必斬嘉以報。」於是天子遣千秋與王太后弟樛樂將二千人往，入越境。呂嘉等乃遂反，下令國中曰：「王年少。太後，中國人也，又與使者亂，專欲內屬，盡持先王寶器入獻天子以自媚，多從人，行至長安，虜賣以為僮仆。取自脫一時之利，無顧趙氏社稷，為萬世慮計之意。」乃與其弟將卒攻殺王、太后及漢使者。遣人告蒼梧秦王及其諸郡縣，立明王長男越妻子術陽侯建德為王。而韓千秋兵入，破數小邑。其後越直開道給食，未至番禺四十里，越以兵擊千秋等，遂滅之。使人函封漢使者節置塞上，好為謾辭謝罪，發兵守要害處。於是天子曰：「韓千秋雖無成功，亦軍鋒之冠。」封其子延年為成安侯。樛樂，其姊為王太后，首願屬漢，封其子廣德為龍亢侯。乃下赦曰：「天子微，諸侯力政，譏臣不討賊。今呂嘉、建德等反，自立晏如，令罪人及江淮以南樓船十萬師往討之。」"}],"source_assertion_id":"a-shiji113-009","interpretation_note":"分支字元不表排行；只接明示父系來源，闕代不造父親。","reviewer":"Codex（AI 代理）","parent_person_id":"8xz_mlj_r3c"}}],"source_mention_summary":[{"source_id":"s-shiji113-nanyue","work_id":"w-shiji","book_id":"b-shiji-113","chapter_id":"c-shiji-113-nanyue","mention_count":5,"mention_ids":["c-shiji-113-nanyue:m009-0104","c-shiji-113-nanyue:m009-0152","c-shiji-113-nanyue:m009-0309","c-shiji-113-nanyue:m009-0341","c-shiji-113-nanyue:m009-0382"],"paragraph_ids":["c-shiji-113-nanyue:p009"],"table_cell_ids":[],"passage_count":1},{"source_id":"table-witness-shiji-020","work_id":"w-shiji","book_id":"b-shiji-020","chapter_id":"table-chapter-shiji-020","mention_count":1,"mention_ids":["shiji-020-t1-r046-c01-m000"],"paragraph_ids":[],"table_cell_ids":["shiji-020-t1-r046-c01"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji113-nanyue"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji113-009","subject_person_id":"8xz_mlj_r3c_A","predicate":"father","object_person_id":"8xz_mlj_r3c","status":"source_attested","evidence":[{"chapter_id":"c-shiji-113-nanyue","source_id":"s-shiji113-nanyue","paragraph_id":"c-shiji-113-nanyue:p009","quote":"天子聞嘉不聽王，王、王太后弱孤不能制，使者怯無決。又以為王、王太后已附漢，獨呂嘉為亂，不足以興兵，欲使莊參以二千人往使。參曰：「以好往，數人足矣；以武往，二千人無足以為也。」辭不可，天子罷參也。郟壯士故濟北相韓千秋奮曰：「以區區之越，又有王、太后應，獨相呂嘉為害，願得勇士二百人，必斬嘉以報。」於是天子遣千秋與王太后弟樛樂將二千人往，入越境。呂嘉等乃遂反，下令國中曰：「王年少。太後，中國人也，又與使者亂，專欲內屬，盡持先王寶器入獻天子以自媚，多從人，行至長安，虜賣以為僮仆。取自脫一時之利，無顧趙氏社稷，為萬世慮計之意。」乃與其弟將卒攻殺王、太后及漢使者。遣人告蒼梧秦王及其諸郡縣，立明王長男越妻子術陽侯建德為王。而韓千秋兵入，破數小邑。其後越直開道給食，未至番禺四十里，越以兵擊千秋等，遂滅之。使人函封漢使者節置塞上，好為謾辭謝罪，發兵守要害處。於是天子曰：「韓千秋雖無成功，亦軍鋒之冠。」封其子延年為成安侯。樛樂，其姊為王太后，首願屬漢，封其子廣德為龍亢侯。乃下赦曰：「天子微，諸侯力政，譏臣不討賊。今呂嘉、建德等反，自立晏如，令罪人及江淮以南樓船十萬師往討之。」"}],"qualifiers":{"source_term":"封其子延年"},"interpretation_note":"其子承接韓千秋，不補生母。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-113-nanyue:m009-0104","start":104,"end":107,"surface":"韓千秋","kind":"person","person_id":"8xz_mlj_r3c","status":"contextual_provisional","paragraph_id":"c-shiji-113-nanyue:p009","chapter_id":"c-shiji-113-nanyue"},{"id":"c-shiji-113-nanyue:m009-0152","start":152,"end":154,"surface":"千秋","kind":"person","person_id":"8xz_mlj_r3c","status":"contextual_provisional","paragraph_id":"c-shiji-113-nanyue:p009","chapter_id":"c-shiji-113-nanyue"},{"id":"c-shiji-113-nanyue:m009-0309","start":309,"end":312,"surface":"韓千秋","kind":"person","person_id":"8xz_mlj_r3c","status":"contextual_provisional","paragraph_id":"c-shiji-113-nanyue:p009","chapter_id":"c-shiji-113-nanyue"},{"id":"c-shiji-113-nanyue:m009-0341","start":341,"end":343,"surface":"千秋","kind":"person","person_id":"8xz_mlj_r3c","status":"contextual_provisional","paragraph_id":"c-shiji-113-nanyue:p009","chapter_id":"c-shiji-113-nanyue"},{"id":"c-shiji-113-nanyue:m009-0382","start":382,"end":385,"surface":"韓千秋","kind":"person","person_id":"8xz_mlj_r3c","status":"contextual_provisional","paragraph_id":"c-shiji-113-nanyue:p009","chapter_id":"c-shiji-113-nanyue"}],"relations":[{"id":"a-shiji113-009","subject_person_id":"8xz_mlj_r3c_A","predicate":"father","object_person_id":"8xz_mlj_r3c","status":"source_attested","evidence":[{"chapter_id":"c-shiji-113-nanyue","source_id":"s-shiji113-nanyue","paragraph_id":"c-shiji-113-nanyue:p009","quote":"天子聞嘉不聽王，王、王太后弱孤不能制，使者怯無決。又以為王、王太后已附漢，獨呂嘉為亂，不足以