002","quote":"彖妹為竟陵王子良妃，子良世子昭胄時年八歲，見武帝而形容慘悴，帝問其故，昭胄流涕曰：「臣舅負罪，今在尚方，臣母悲泣不食已積日，臣所以不寧。」帝曰：「特為兒赦之。」","subject_person_mention_id":"c-nanshi-026-yuanfei-family:p002:m0014","object_person_mention_id":"c-nanshi-026-yuanfei-family:p002:m0010"}]}},{"id":"x3q_cqm_dup_B","label":"蕭昭穎（永新侯，昭冑弟）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"昭穎","mention_ids":["c-nanqishu-040-zhaozhou:p003:m0026","c-nanqishu-040-zhaozhou:p003:m0306","c-nanqishu-040-zhaozhou:p003:m0340","c-zizhitongjian-144-zhaozhou-brothers:p002:m0016"]}],"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-040","source_id":"s-nanqishu-040-zhaozhou-ws2272748","chapter_id":"c-nanqishu-040-zhaozhou","paragraph_id":"c-nanqishu-040-zhaozhou:p003","quote":"昭穎","mention_id":"c-nanqishu-040-zhaozhou:p003:m0026"},{"work_id":"w-nanqishu","book_id":"b-nanqishu-040","source_id":"s-nanqishu-040-zhaozhou-ws2272748","chapter_id":"c-nanqishu-040-zhaozhou","paragraph_id":"c-nanqishu-040-zhaozhou:p003","quote":"昭穎","mention_id":"c-nanqishu-040-zhaozhou:p003:m0306"},{"work_id":"w-nanqishu","book_id":"b-nanqishu-040","source_id":"s-nanqishu-040-zhaozhou-ws2272748","chapter_id":"c-nanqishu-040-zhaozhou","paragraph_id":"c-nanqishu-040-zhaozhou:p003","quote":"昭穎","mention_id":"c-nanqishu-040-zhaozhou:p003:m0340"},{"work_id":"w-zizhitongjian","book_id":"b-zizhitongjian-144","source_id":"s-zizhitongjian-144-zhaozhou-brothers-ws803184","chapter_id":"c-zizhitongjian-144-zhaozhou-brothers","paragraph_id":"c-zizhitongjian-144-zhaozhou-brothers:p002","quote":"昭穎","mention_id":"c-zizhitongjian-144-zhaozhou-brothers:p002:m0016"}],"review":"ai_provisional","identity_note":"昭冑與弟永新侯昭穎逃奔，兄弟同被誅。","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"x3q_cqm_dup","source_assertion_id":null,"parent_connection":{"type":"shared_father_through_siblings","sibling_assertion_ids":["a-nanqi040-zhaozhou-m-brother"],"sibling_father_assertion_id":"a-nanshi-026-yuanfei-family-father-zhaozhou"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-040","source_id":"s-nanqishu-040-zhaozhou-ws2272748","chapter_id":"c-nanqishu-040-zhaozhou","paragraph_id":"c-nanqishu-040-zhaozhou:p003","quote":"及陳顯達起事，王侯復入宮。昭冑懲往時之懼，與弟永新侯昭穎逃奔江西，變形爲道人。崔慧景舉兵，昭冑兄弟出投之。慧景事敗，昭冑兄弟首出投臺軍主胡松，各以王侯還第。不自安，謀爲身計。子良故防閤桑偃爲梅蟲兒軍副，結前巴西太守蕭寅，謀立昭冑。昭冑許事克用寅爲尚書左僕射、護軍將軍。以寅有部曲，大事皆委之。時胡松領軍在新亭，寅遣人說之，云「須昏人出，寅等便率兵奉昭冑入臺，閉城號令。昏人必還就將軍，將軍但閉壘不應，則三公不足得也。」松又許諾。會東昏新起芳樂苑，月許日不復出遊，偃等議募健兒百餘人從萬春門入突取之，昭冑以爲不可。偃同黨王山沙慮事久無成，以事告御刀徐僧重。寅遣人殺山沙於路，吏於麝中得其事迹，昭冑兄弟與同黨皆伏誅。昭穎官至寧朔將軍、彭城太守。梁王定京邑，追贈昭冑散騎常侍、撫軍將軍，昭穎黃門郎。梁受禪，降封昭冑子周監利侯。","subject_person_mention_id":"c-nanqishu-040-zhaozhou:p003:m0026","object_person_mention_id":"c-nanqishu-040-zhaozhou:p003:m0013","relationship_anchor":{"paragraph_id":"c-nanqishu-040-zhaozhou:p003","surface":"與弟永新侯昭穎","start":21,"end":28},"source_assertion_id":"a-nanqi040-zhaozhou-m-brother","source_term":"與弟永新侯昭穎"},{"work_id":"w-nanshi","book_id":"b-nanshi-026","source_id":"s-nanshi-026-yuanfei-family-ws1477359","chapter_id":"c-nanshi-026-yuanfei-family","paragraph_id":"c-nanshi-026-yuanfei-family:p002","quote":"彖妹為竟陵王子良妃，子良世子昭胄時年八歲，見武帝而形容慘悴，帝問其故，昭胄流涕曰：「臣舅負罪，今在尚方，臣母悲泣不食已積日，臣所以不寧。」帝曰：「特為兒赦之。」","subject_person_mention_id":"c-nanshi-026-yuanfei-family:p002:m0014","object_person_mention_id":"c-nanshi-026-yuanfei-family:p002:m0010","source_assertion_id":"a-nanshi-026-yuanfei-family-father-zhaozhou","source_term":"子良世子昭胄"}],"status":"contextual_provisional","interpretation_note":"同傳明記事主父、兄弟姊妹，再據此繫父系。","human_reviewed":false}}],"source_mention_summary":[{"source_id":"s-nanqishu-040-zhaozhou-ws2272748","work_id":"w-nanqishu","book_id":"b-nanqishu-040","chapter_id":"c-nanqishu-040-zhaozhou","raw_mention_count":3,"mention_ids":["c-nanqishu-040-zhaozhou:p003:m0026","c-nanqishu-040-zhaozhou:p003:m0306","c-nanqishu-040-zhaozhou:p003:m0340"],"paragraph_ids":["c-nanqishu-040-zhaozhou:p003"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-nanqishu-040-zhaozhou:p003:m0026","mention_ids":["c-nanqishu-040-zhaozhou