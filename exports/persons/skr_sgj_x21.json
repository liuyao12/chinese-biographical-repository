":123,"revision_id":2595687,"projection_sha256":"b7e0baeb80d7f815f98af891a3bdbcbbf559d55dbf22169476343d0b762b320a","source_layer":"received_biography"},"chapter_id":"c-jinshu-045-guoyi","book_id":"b-jinshu-045","work_id":"w-jinshu","source_id":"s-jinshu-045-ws2595687-guoyi"},{"id":"c-jinshu-059-jiong:p010","text":"翊軍校尉李含奔于長安，詐云受密詔，使河間王顒誅冏，因導以利謀。顒從之，上表曰：","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-059-jiong:p010:m0110","start":4,"end":6,"surface":"李含","kind":"person","person_id":"skr_sgj_x21","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p010:m0111","start":18,"end":22,"surface":"河間王顒","kind":"person","person_id":"ed0_313_bea","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p010:m0112","start":23,"end":24,"surface":"冏","kind":"person","person_id":"ee0_b2a_68e","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p010:m0113","start":31,"end":32,"surface":"顒","kind":"person","person_id":"ed0_313_bea","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"}],"source_position":{"first_line":110,"last_line":110,"revision_id":2650517},"chapter_id":"c-jinshu-059-jiong","book_id":"b-jinshu-059","work_id":"w-jinshu","source_id":"s-jinshu-059-ws2650517-jiong"},{"id":"c-jinshu-059-jiong:p012","text":"臣受重任，蕃衛方嶽，見冏所行，實懷激憤。即日翊軍校尉李含乘驛密至，宣騰詔旨。臣伏讀感切，五情若灼。《春秋》之義，君親無將。冏擁強兵，樹置私黨，權官要職，莫非腹心。雖復重責之誅，恐不義服。今輒勒兵，精卒十萬，與州征並協忠義，共會洛陽。驃騎將軍長沙王乂，同奮忠誠，廢冏還第。有不順命，軍法從事。成都王穎明德茂親，功高勳重，往歲去就，允合眾望，宜為宰輔，代冏阿衡之任。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-059-jiong:p012:m0122","start":0,"end":1,"surface":"臣","kind":"person","person_id":"ed0_313_bea","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p012:m0123","start":11,"end":12,"surface":"冏","kind":"person","person_id":"ee0_b2a_68e","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p012:m0124","start":26,"end":28,"surface":"李含","kind":"person","person_id":"skr_sgj_x21","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p012:m0125","start":38,"end":39,"surface":"臣","kind":"person","person_id":"ed0_313_bea","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p012:m0126","start":61,"end":62,"surface":"冏","kind":"person","person_id":"ee0_b2a_68e","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p012:m0127","start":120,"end":124,"surface":"長沙王乂","kind":"person","person_id":"4c6_984_9ed","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p012:m0128","start":131,"end":132,"surface":"冏","kind":"person","person_id":"ee0_b2a_68e","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p012:m0129","start":145,"end":149,"surface":"成都王穎","kind":"person","person_id":"e81_f09_000","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p012:m0130","start":175,"end":176,"surface":"冏","kind":"person","person_id":"ee0_b2a_68e","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"}],"source_position":{"first_line":114,"last_line":114,"revision_id":2650517},"chapter_id":"c-jinshu-059-jiong","book_id":"b-jinshu-059","work_id":"w-jinshu","source_id":"s-jinshu-059-ws2650517-jiong"},{"id":"c-jinshu-059-yi:p004","text":"顒本以乂弱冏強，冀乂為冏所擒，然後以乂為辭，宣告四方共討之，因廢帝立成都王，己為宰相，專制天下。即而乂殺冏，其計不果，乃潛使侍中馮蓀、河南尹李含、中書令卞粹等襲乂。乂並誅之。顒遂與穎同伐京都。穎遣刺客圖乂，時長沙國左常侍王矩侍直，見客色動，遂殺之。詔以乂為大都督以距顒。連戰自八月至十月，朝議以乂、穎兄弟，可以辭說而釋，乃使中書令王衍行太尉，光祿勳石陋行司徒，使說穎，令與乂分陝而居，穎不從。乂因致書於穎曰：","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-059-yi:p004:m0045","start":0,"end":1,"surface":"顒","kind":"person","person_id":"ed0_313_bea","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p004:m0046","start":3,"end":4,"surface":"乂","kind":"person","person_id":"4c6_984_9ed","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p004:m0047","start":5,"end":6,"surface":"冏","kind":"person","person_id":"ee0_b2a_68e","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p004:m0048","start":9,"end":10,"surface":"乂","kind":"person","person_id":"4c6_984_9ed","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p004:m0049","start":11,"end":12,"surface":"冏","kind":"person","person_id":"ee0_b2a_68e","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p004:m0050","start":18,"end":19,"surface":"乂","kind":"person","person_id":"4c6_984_9ed","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p004:m0051","start":32,"end":33,"surface":"帝","kind":"person","person_id":"7e0_f69_1ac","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p004:m0052","start":34,"end":37,"surface":"成都王","kind":"person","person_id":"e81_f09_000","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p004:m0053","start":38,"end":39,"surface":"己","kind":"person","person_id":"ed0_313_bea","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p004:m0054","start":50,"end":51,"surface":"乂","kind":"person","person_id":"4c6_984_9ed","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jins