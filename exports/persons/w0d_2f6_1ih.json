d":"xnj_cjk_pcj_*A","status":"contextual_provisional"}],"chapter_id":"c-shiji-093-hanlu","book_id":"b-shiji-093","work_id":"w-shiji","source_id":"s-shiji-093-hanlu"},{"id":"c-shiji-093-hanlu:p015","text":"豨常告歸過趙，趙相周昌見豨賓客隨之者千餘乘，邯鄲官舍皆滿。豨所以待賓客布衣交，皆出客下。豨還之代，周昌乃求入見。見上，具言豨賓客盛甚，擅兵於外數歲，恐有變。上乃令人覆案豨客居代者財物諸不法事，多連引豨。豨恐，陰令客通使王黃、曼丘臣所。及高祖十年七月，太上皇崩，使人召豨，豨稱病甚。九月，遂與王黃等反，自立為代王，劫略趙、代。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-093-hanlu:m015-0000","start":0,"end":1,"surface":"豨","kind":"person","person_id":"k12_clz_joc","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m015-0007","start":7,"end":9,"surface":"趙相","kind":"person","person_id":"cok_fra_foo","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m015-0009","start":9,"end":11,"surface":"周昌","kind":"person","person_id":"cok_fra_foo","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m015-0012","start":12,"end":13,"surface":"豨","kind":"person","person_id":"k12_clz_joc","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m015-0029","start":29,"end":30,"surface":"豨","kind":"person","person_id":"k12_clz_joc","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m015-0044","start":44,"end":45,"surface":"豨","kind":"person","person_id":"k12_clz_joc","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m015-0049","start":49,"end":51,"surface":"周昌","kind":"person","person_id":"cok_fra_foo","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m015-0057","start":57,"end":58,"surface":"上","kind":"person","person_id":"moi_ml7_uxh_A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m015-0061","start":61,"end":62,"surface":"豨","kind":"person","person_id":"k12_clz_joc","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m015-0078","start":78,"end":79,"surface":"上","kind":"person","person_id":"moi_ml7_uxh_A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m015-0084","start":84,"end":85,"surface":"豨","kind":"person","person_id":"k12_clz_joc","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m015-0099","start":99,"end":100,"surface":"豨","kind":"person","person_id":"k12_clz_joc","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m015-0101","start":101,"end":102,"surface":"豨","kind":"person","person_id":"k12_clz_joc","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m015-0109","start":109,"end":111,"surface":"王黃","kind":"person","person_id":"ugv_ua1_1vs","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m015-0112","start":112,"end":115,"surface":"曼丘臣","kind":"person","person_id":"84r_unt_2kk","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m015-0118","start":118,"end":120,"surface":"高祖","kind":"person","person_id":"moi_ml7_uxh_A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m015-0125","start":125,"end":128,"surface":"太上皇","kind":"person","person_id":"moi_ml7_uxh","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m015-0133","start":133,"end":134,"surface":"豨","kind":"person","person_id":"k12_clz_joc","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m015-0135","start":135,"end":136,"surface":"豨","kind":"person","person_id":"k12_clz_joc","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m015-0145","start":145,"end":147,"surface":"王黃","kind":"person","person_id":"ugv_ua1_1vs","status":"contextual_provisional"}],"chapter_id":"c-shiji-093-hanlu","book_id":"b-shiji-093","work_id":"w-shiji","source_id":"s-shiji-093-hanlu"},{"id":"c-shiji-093-hanlu:p016","text":"上聞，乃赦趙、代吏人為豨所詿誤劫略者，皆赦之。上自往，至邯鄲，喜曰：「豨不南據漳水，北守邯鄲，知其無能為也。」趙相奏斬常山守、尉，曰：「常山二十五城，豨反，亡其二十城。」上問曰：「守、尉反乎？」對曰：「不反。」上曰：「是力不足也。」赦之，復以為常山守、尉。上問周昌曰：「趙亦有壯士可令將者乎？」對曰：「有四人。」四人謁，上謾罵曰：「豎子能為將乎？」四人慚伏。上封之各千戶，以為將。左右諫曰：「從入蜀、漢，伐楚，功未遍行，今此何功而封？」上曰：「非若所知！陳豨反，邯鄲以北皆豨有，吾以羽檄徵天下兵，未有至者，今唯獨邯鄲中兵耳。吾胡愛四千戶封四人，不以慰趙子弟！」皆曰：「善。」於是上曰：「陳豨將誰？」曰：「王黃、曼丘臣，皆故賈人。」上曰：「吾知之矣。」乃各以千金購黃、臣等。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-093-hanlu:m016-0000","start":0,"end":1,"surface":"上","kind":"person","person_id":"moi_ml7_uxh_A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m016-0011","start":11,"end":12,"surface":"豨","kind":"person","person_id":"k12_clz_joc","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m016-0023","start":23,"end":24,"surface":"上","kind":"person","person_id":"moi_ml7_uxh_A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m016-0035","start":35,"end":36,"surface":"豨","kind":"person","person_id":"k12_clz_joc","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m016-0055","start":55,"end":57,"surface":"趙相","kind":"person","person_id":"cok_fra_foo","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m016-0059","start":59,"end":62,"surface":"常山守","kind":"person","person_id":"q9f_hno_txx","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m016-0063","start":63,"end":64,"surface":"尉","kind":"person","person_id":"w3g_k4m_zrn","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m016-0075","start":75,"end":76,"surface":"豨","kind":"person","person_id":"k12_clz_joc","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m016-0085","start":85,"end":86,"surface":"上","kind":"person","person_id":"moi_ml7_uxh_A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m016-0092","start":92,"end":93,"surface":"尉","kind":"person","person_id":"w3g_k4m_zrn","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m016-0105","start":105,"end":106,"surface":"上","kind":"person","person_id":"moi_ml7_uxh_A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m016-0122","start":122,"end":125,"surface":"常山守","kind":"person","person_id":"q9f_hno_txx","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m016-0126","start":126,"end":127,"surface":"尉","kind":"person","person_id":"w3g_k4m_zrn","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m016-0128","start":128,"end":129,"surface":"上","kind":"person","person_id":"moi_ml7_uxh_A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m016-0130","start":130,"end":132,"surface":"周昌","kind":"person","person_id":"cok_fra_foo","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m016-0160","start":160,"end":161,"surface":"上","kind":"person","person_id":"moi_ml7_uxh_A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m016-0179","start":179,"end":180,"surface":"上","kind":"person","person_id":"moi_ml7_uxh_A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m016-0218","start":218,"end":219,"surface":"上","kind":"person","person_id":"moi_ml7_uxh_A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m016-0227","start":227,"end":229,"surface":"陳豨","kind":"person","person_id":"k12_clz_joc","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m016-0236","start":236,"end":237,"surface":"豨","kind":"person","person_id":"k12_clz_joc","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m016-0289","start":289,"end":290,"surface":"上","kind":"person","person_id":"moi_ml7_uxh_A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m016-0293","start":293,"end":295,"surface":"陳豨","kind":"person","person_id":"k12_clz_joc","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m016-0302","start":302,"end":304,"surface":"王黃","kind":"person","person_id":"ugv_ua1_1vs","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m016-0305","start":305,"end":308,"surface":"曼丘臣","kind":"person","person_id":"84r_unt_2kk","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m016-0315","start":315,"end":316,"surface":"上","kind":"person","person_id":"moi_ml7_uxh_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-093-hanlu","book_id":"b-shiji-093","work_id":"w-shiji","source_id":"s-shiji-093-hanlu"},{"id":"c-shiji-093-hanlu:p017","text":"十一年冬，漢兵擊斬陳豨將侯敞、王黃於曲逆下，破豨將張春於聊城，斬首萬餘。太尉勃入定太原、代地。十二月，上自擊東垣，東垣不下，卒罵上；東垣降，卒罵者斬之，不罵者黥之。更命東垣為真定。王黃、曼丘臣其麾下受購賞之，皆生得，以故陳豨軍遂敗。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-093-hanlu:m017-0009","start":9,"end":11,"surface":"陳豨","kind":"person","person_id":"k12_clz_joc","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m017-0012","start":12,"end":14,"surface":"侯敞","kind":"person","person_id":"3jk_04c_cyw","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m017-0015","start":15,"end":17,"surface":"王黃","kind":"person","person_id":"ugv_ua1_1vs","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m017-0023","start":23,"end":24,"surface":"豨","kind":"person","person_id":"k12_clz_joc","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m017-0025","start":25,"end":27,"surface":"張春","kind":"person","person_id":"qf1_qbc_81g","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m017-0038","start":38,"end":39,"surface":"勃","kind":"person","person_id":"04g_x9a_lho","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m017-0051","start":51,"end":52,"surface":"上","kind":"person","person_id":"moi_ml7_uxh_A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m017-0064","start":64,"end":65,"surface":"上","kind":"person","person_id":"moi_ml7_uxh_A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m017-0090","start":90,"end":92,"surface":"王黃","kind":"person","person_id":"ugv_ua1_1vs","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m017-0093","start":93,"end":96,"surface":"曼丘臣","kind":"person","person_id":"84r_unt_2kk","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m017-0110","start":110,"end":112,"surface":"陳豨","kind":"person","person_id":"k12_clz_joc","status":"contextual_provisional"}],"chapter_id":"c-shiji-093-hanlu","book_id":"b-shiji-093","work_id":"w-shiji","source_id":"s-shiji-093-hanlu"}],"sources":[{"chapter_id":"c-shiji-008-gaozu","work_id":"w-shiji","book_id":"b-shiji-008","source_id":"s-shiji-008-gaozu","source":{"title":"史記／卷008","provi