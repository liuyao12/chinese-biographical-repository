ids":["c-shiji-008-gaozu:m064-0022"],"paragraph_ids":["c-shiji-008-gaozu:p064"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-093-hanlu"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-008-gaozu:m064-0022","start":22,"end":25,"surface":"曼丘臣","kind":"person","person_id":"w0d_2f6_1ih","status":"contextual_provisional","paragraph_id":"c-shiji-008-gaozu:p064","chapter_id":"c-shiji-008-gaozu"},{"id":"c-shiji-093-hanlu:m005-0035","start":35,"end":38,"surface":"曼丘臣","kind":"person","person_id":"84r_unt_2kk","status":"contextual_provisional","paragraph_id":"c-shiji-093-hanlu:p005","chapter_id":"c-shiji-093-hanlu"},{"id":"c-shiji-093-hanlu:m015-0112","start":112,"end":115,"surface":"曼丘臣","kind":"person","person_id":"84r_unt_2kk","status":"contextual_provisional","paragraph_id":"c-shiji-093-hanlu:p015","chapter_id":"c-shiji-093-hanlu"},{"id":"c-shiji-093-hanlu:m016-0305","start":305,"end":308,"surface":"曼丘臣","kind":"person","person_id":"84r_unt_2kk","status":"contextual_provisional","paragraph_id":"c-shiji-093-hanlu:p016","chapter_id":"c-shiji-093-hanlu"},{"id":"c-shiji-093-hanlu:m017-0093","start":93,"end":96,"surface":"曼丘臣","kind":"person","person_id":"84r_unt_2kk","status":"contextual_provisional","paragraph_id":"c-shiji-093-hanlu:p017","chapter_id":"c-shiji-093-hanlu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji093-011","person_id":"84r_unt_2kk","scope":"same_chapter","chapter_ids":["c-shiji-093-hanlu"],"status":"contextual_provisional","rationale":"明示姓名及局部敘事承接；引古、未名者及短稱另存候選。臧茶與臧荼、高后與呂后待跨稱判讀，不因近形或熟知姓名自動合併。","reviewer":"Codex（AI 代理）","surfaces":["曼丘臣"],"evidence":[{"paragraph_id":"c-shiji-093-hanlu:p005","quote":"七年冬，上自往擊，破信軍銅鞮，斬其將王喜。信亡走匈奴。（與）其與白土人曼丘臣、王黃等立趙苗裔趙利為王，復收信敗散兵，而與信及冒頓謀攻漢。匈奴仗左右賢王將萬餘騎與王黃等屯廣武以南，至晉陽，與漢兵戰，漢大破之，追至于離石，復破之。匈奴復聚兵樓煩西北，漢令車騎擊破匈奴。匈奴常敗走，漢乘勝追北，聞冒頓居代（上）谷，高皇帝居晉陽，使人視冒頓，還報曰「可擊」。上遂至平城。上出白登，匈奴騎圍上，上乃使人厚遺閼氏。閼氏乃說冒頓曰：「今得漢地，猶不能居；且兩主不相緱」居七日，胡騎稍引去。時天大霧，漢使人往來，胡不覺。護軍中尉陳平言上曰：「胡者全兵，請令彊弩傅兩矢外向，徐行出圍。」入平城，漢救兵亦到，胡騎遂解去。漢亦罷兵歸。韓信為匈奴將兵往來擊邊。"},{"paragraph_id":"c-shiji-093-hanlu:p015","quote":"豨常告歸過趙，趙相周昌見豨賓客隨之者千餘乘，邯鄲官舍皆滿。豨所以待賓客布衣交，皆出客下。豨還之代，周昌乃求入見。見上，具言豨賓客盛甚，擅兵於外數歲，恐有變。上乃令人覆案豨客居代者財物諸不法事，多連引豨。豨恐，陰令客通使王黃、曼丘臣所。及高祖十年七月，太上皇崩，使人召豨，豨稱病甚。九月，遂與王黃等反，自立為代王，劫略趙、代。"},{"paragraph_id":"c-shiji-093-hanlu:p016","quote":"上聞，乃赦趙、代吏人為豨所詿誤劫略者，皆赦之。上自往，至邯鄲，喜曰：「豨不南據漳水，北守邯鄲，知其無能為也。」趙相奏斬常山守、尉，曰：「常山二十五城，豨反，亡其二十城。」上問曰：「守、尉反乎？」對曰：「不反。」上曰：「是力不足也。」赦之，復以為常山守、尉。上問周昌曰：「趙亦有壯士可令將者乎？」對曰：「有四人。」四人謁，上謾罵曰：「豎子能為將乎？」四人慚伏。上封之各千戶，以為將。左右諫曰：「從入蜀、漢，伐楚，功未遍行，今此何功而封？」上曰：「非若所知！陳豨反，邯鄲以北皆豨有，吾以羽檄徵天下兵，未有至者，今唯獨邯鄲中兵耳。吾胡愛四千戶封四人，不以慰趙子弟！」皆曰：「善。」於是上曰：「陳豨將誰？」曰：「王黃、曼丘臣，皆故賈人。」上曰：「吾知之矣。」乃各以千金購黃、臣等。"},{"paragraph_id":"c-shiji-093-hanlu:p017","quote":"十一年冬，漢兵擊斬陳豨將侯敞、王黃於曲逆下，破豨將張春於聊城，斬首萬餘。太尉勃入定太原、代地。十二月，上自擊東垣，東垣不下，卒罵上；東垣降，卒罵者斬之，不罵者黥之。更命東垣為真定。王黃、曼丘臣其麾下受購賞之，皆生得，以故陳豨軍遂敗。"}]}],"equivalence_decisions":[{"id":"eq-shiji093-man","person_ids":["w0d_2f6_1ih","84r_unt_2kk"],"canonical_person_id":"w0d_2f6_1ih","scope":"cross_chapter","chapter_ids":["c-shiji-008-gaozu","c-shiji-093-hanlu"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-008-gaozu","source_id":"s-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p064","quote":"七年，匈奴攻韓王信馬邑，信因與謀反太原。白土曼丘臣、王黃立故趙將趙利為王以反，高祖自往擊之。會天寒，士卒墮指者什二三，遂至平城。匈奴圍我平城，七日而後罷去。令樊噲止定代地。立兄劉仲為代王。","mention_ids":["c-shiji-008-gaozu:m064-0022"]},{"chapter_id":"c-shiji-093-hanlu","source_id":"s-shiji-093-hanlu","paragraph_id":"c-shiji-093-hanlu:p005","quote":"七年冬，上自往擊，破信軍銅鞮，斬其將王喜。信亡走匈奴。（與）其與白土人曼丘臣、王黃等立趙苗裔趙利為王，復收信敗散兵，而與信及冒頓謀攻漢。匈奴仗左右賢王將萬餘騎與王黃等屯廣武以南，至晉陽，與漢兵戰，漢大破之，追至于離石，復破之。匈奴復聚兵樓煩西北，漢令車騎擊破匈奴。匈奴常敗走，漢乘勝追北，聞冒頓居代（上）谷，高皇帝居晉陽，使人視冒頓，還報曰「可擊」。上遂至平城。上出白登，匈奴騎圍上，上乃使人厚遺閼氏。閼氏乃說冒頓曰：「今得漢地，猶不能居；且兩主不相緱」居七日，胡騎稍引去。時天大霧，漢使人往來，胡不覺。護軍中尉陳平言上曰：「胡者全兵，請令彊弩傅兩矢外向，徐行出圍。」入平城，漢救兵亦到，胡騎遂解去。漢亦罷兵歸。韓信為匈奴將兵往來擊邊。","mention_ids":["c-shiji-093-hanlu:m005-0035"]}],"rationale":"白土曼丘臣與王黃立趙利反漢的姓名地望及共同事件相配。 各篇原字、原文與已發ID保留，同書不視為獨立見證；同指不確證所有紀年、任職、親屬或敘事，不按全域同名批量改號。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-008-gaozu:p064","text":"七年，匈奴攻韓王信馬邑，信因與謀反太原。白土曼丘臣、王黃立故趙將趙利為王以反，高祖自往擊之。會天寒，士卒墮指者什二三，遂至平城。匈奴圍我平城，七日而後罷去。令樊噲止定代地。立兄劉仲為代王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m064-0006","start":6,"end":9,"surface":"韓王信","kind":"person","person_id":"hm1_rqr_l9u","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m064-0012","start":12,"end":13,"surface":"信","kind":"person","person_id":"hm1_rqr_l9u","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m064-0022","start":22,"end":25,"surface":"曼丘臣","kind":"person","person_id":"w0d_2f6_1ih","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m064-0026","start":26,"end":28,"surface":"王黃","kind":"person","person_id":"4q3_8yy_0ys","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m064-0032","start":32,"end":34,"surface":"趙利","kind":"person","person_id":"ibi_qk6_07w","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m064-0039","start":39,"end":41,"surface":"高祖","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m064-0079","start":79,"end":81,"surface":"樊噲","kind":"person","person_id":"b1r_inb_fts","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m064-0088","start":88,"end":90,"surface":"劉仲","kind":"person","person_id":"hp2_cuk_57t","status":"contextual_provisional"}],"chapter_id":"c-shiji-008-gaozu","book_id":"b-shiji-008","work_id":"w-shiji","source_id":"s-shiji-008-g