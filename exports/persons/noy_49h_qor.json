m013-0000","start":0,"end":3,"surface":"孝惠帝","kind":"person","person_id":"noy_49h_qor","status":"contextual_provisional","paragraph_id":"c-shiji-097-luli:p013","chapter_id":"c-shiji-097-luli"},{"id":"c-shiji-097-luli:m018-0015","start":15,"end":18,"surface":"孝惠帝","kind":"person","person_id":"noy_49h_qor","status":"contextual_provisional","paragraph_id":"c-shiji-097-luli:p018","chapter_id":"c-shiji-097-luli"},{"id":"c-shiji-097-luli:m018-0019","start":19,"end":22,"surface":"孝惠帝","kind":"person","person_id":"noy_49h_qor","status":"contextual_provisional","paragraph_id":"c-shiji-097-luli:p018","chapter_id":"c-shiji-097-luli"},{"id":"c-shiji-097-luli:m018-0089","start":89,"end":91,"surface":"孝惠","kind":"person","person_id":"noy_49h_qor","status":"contextual_provisional","paragraph_id":"c-shiji-097-luli:p018","chapter_id":"c-shiji-097-luli"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji097-018","person_id":"noy_49h_qor","scope":"same_chapter","chapter_ids":["c-shiji-097-luli"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["孝惠","孝惠帝"],"evidence":[{"paragraph_id":"c-shiji-097-luli:p013","quote":"孝惠帝時，呂太后用事，欲王諸呂，畏大臣有口者，陸生自度不能爭之，乃病免家居。以好畤田地善，可以家焉。有五男，乃出所使越得橐中裝賣千金，分其子，子二百金，令為生產。陸生常安車駟馬，從歌舞鼓琴瑟侍者十人，寶劍直百金，謂其子曰：「與汝約：過汝，汝給吾人馬酒食，極欲，十日而更。所死家，得寶劍車騎侍從者。一歲中往來過他客，率不過再三過，數見不鮮，無久慁公為也。」"},{"paragraph_id":"c-shiji-097-luli:p018","quote":"辟陽侯幸呂太后，人或毀辟陽侯於孝惠帝，孝惠帝大怒，下吏，欲誅之。呂太后慚，不可以言。大臣多害辟陽侯行，欲遂誅之。辟陽侯急，因使人欲見平原君。平原君辭曰：「獄急，不敢見君。」乃求見孝惠幸臣閎籍孺，說之曰：「君所以得幸帝，天下莫不聞。今辟陽侯幸太后而下吏，道路皆言君讒，欲殺之。今日辟陽侯誅，旦日太后含怒，亦誅君。何不肉袒為辟陽侯言於帝？帝聽君出辟陽侯，太后大驩。兩主共幸君，君貴富益倍矣。」於是閎籍孺大恐，從其計，言帝，果出辟陽侯。辟陽侯之囚，欲見平原君，平原君不見辟陽侯，辟陽侯以為倍己，大怒。及其成功出之，乃大驚。"}],"rationale":"按酈生、陸賈與朱建分傳及敘事承接限定異稱；尉他尉佗原字分存。平原君據明示朱建另候選；朱建兩處未名子尚不合併，淮陰侯與單稱韓信跨篇同指待證。引語古王及神話人物與當事人分開。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-097-luli:p013","text":"孝惠帝時，呂太后用事，欲王諸呂，畏大臣有口者，陸生自度不能爭之，乃病免家居。以好畤田地善，可以家焉。有五男，乃出所使越得橐中裝賣千金，分其子，子二百金，令為生產。陸生常安車駟馬，從歌舞鼓琴瑟侍者十人，寶劍直百金，謂其子曰：「與汝約：過汝，汝給吾人馬酒食，極欲，十日而更。所死家，得寶劍車騎侍從者。一歲中往來過他客，率不過再三過，數見不鮮，無久慁公為也。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-097-luli:m013-0000","start":0,"end":3,"surface":"孝惠帝","kind":"person","person_id":"noy_49h_qor","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m013-0005","start":5,"end":8,"surface":"呂太后","kind":"person","person_id":"otq_r9b_d3z","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m013-0023","start":23,"end":25,"surface":"陸生","kind":"person","person_id":"fjo_zh4_b7q","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m013-0051","start":51,"end":53,"surface":"五男","kind":"unresolved","person_id":null,"status":"unresolved","note":"來源未名群體，不補具名成員或確切子序數。"},{"id":"c-shiji-097-luli:m013-0081","start":81,"end":83,"surface":"陸生","kind":"person","person_id":"fjo_zh4_b7q","status":"contextual_provisional"}],"chapter_id":"c-shiji-097-luli","book_id":"b-shiji-097","work_id":"w-shiji","source_id":"s-shiji-097-luli"},{"id":"c-shiji-097-luli:p018","text":"辟陽侯幸呂太后，人或毀辟陽侯於孝惠帝，孝惠帝大怒，下吏，欲誅之。呂太后慚，不可以言。大臣多害辟陽侯行，欲遂誅之。辟陽侯急，因使人欲見平原君。平原君辭曰：「獄急，不敢見君。」乃求見孝惠幸臣閎籍孺，說之曰：「君所以得幸帝，天下莫不聞。今辟陽侯幸太后而下吏，道路皆言君讒，欲殺之。今日辟陽侯誅，旦日太后含怒，亦誅君。何不肉袒為辟陽侯言於帝？帝聽君出辟陽侯，太后大驩。兩主共幸君，君貴富益倍矣。」於是閎籍孺大恐，從其計，言帝，果出辟陽侯。辟陽侯之囚，欲見平原君，平原君不見辟陽侯，辟陽侯以為倍己，大怒。及其成功出之，乃大驚。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-097-luli:m018-0000","start":0,"end":3,"surface":"辟陽侯","kind":"person","person_id":"697_9f9_d41","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m018-0004","start":4,"end":7,"surface":"呂太后","kind":"person","person_id":"otq_r9b_d3z","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m018-0011","start":11,"end":14,"surface":"辟陽侯","kind":"person","person_id":"697_9f9_d41","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m018-0015","start":15,"end":18,"surface":"孝惠帝","kind":"person","person_id"