ions":[],"passages":[{"id":"c-shiji-036-chenqi:p007","text":"桓公二十三年，魯隱公初立。二十六年，衛殺其君州吁。三十三年，魯弒其君隱公。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-036-chenqi:m007-0000","start":0,"end":2,"surface":"桓公","kind":"person","person_id":"lmu_nbm_rzo_AB","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m007-0007","start":7,"end":10,"surface":"魯隱公","kind":"person","person_id":"lc6_cup_v9c_AA","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m007-0022","start":22,"end":24,"surface":"州吁","kind":"person","person_id":"xrt_zof_cbt_AA","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m007-0034","start":34,"end":36,"surface":"隱公","kind":"person","person_id":"lc6_cup_v9c_AA","status":"contextual_provisional"}],"chapter_id":"c-shiji-036-chenqi","book_id":"b-shiji-036","work_id":"w-shiji","source_id":"s-shiji-036-chenqi"},{"id":"c-shiji-037-wei:p010","text":"莊公五年，取齊女爲夫人，好而無子。又取陳女爲夫人，生子，蚤死。陳女女弟亦幸於莊公，而生子完。完母死，莊公令夫人齊女子之，立爲太子。莊公有寵妾，生子州吁。十八年，州吁長，好兵，莊公使將。石碏諫莊公曰：「庶子好兵，使將，亂自此起。」不聽。二十三年，莊公卒，太子完立，是爲桓公。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-037-wei:m010-0000","start":0,"end":2,"surface":"莊公","kind":"person","person_id":"xrt_zof_cbt_A","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m010-0006","start":6,"end":8,"surface":"齊女","kind":"person","person_id":"h68_ts0_5vs","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m010-0009","start":9,"end":11,"surface":"夫人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、並稱、匿名者、校勘或尚未定指代；不補姓名、親屬、闕代或成員。"},{"id":"c-shiji-037-wei:m010-0019","start":19,"end":21,"surface":"陳女","kind":"person","person_id":"ca5_zxe_kxk","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m010-0022","start":22,"end":24,"surface":"夫人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、並稱、匿名者、校勘或尚未定指代；不補姓名、親屬、闕代或成員。"},{"id":"c-shiji-037-wei:m010-0025","start":2