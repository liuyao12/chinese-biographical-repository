rt_zof_cbt_A","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m010-0092","start":92,"end":94,"surface":"石碏","kind":"person","person_id":"yt0_0mx_ah5","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m010-0095","start":95,"end":97,"surface":"莊公","kind":"person","person_id":"xrt_zof_cbt_A","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m010-0100","start":100,"end":102,"surface":"庶子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、並稱、匿名者、校勘或尚未定指代；不補姓名、親屬、闕代或成員。"},{"id":"c-shiji-037-wei:m010-0122","start":122,"end":124,"surface":"莊公","kind":"person","person_id":"xrt_zof_cbt_A","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m010-0126","start":126,"end":129,"surface":"太子完","kind":"person","person_id":"xrt_zof_cbt_AB","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m010-0133","start":133,"end":135,"surface":"桓公","kind":"person","person_id":"xrt_zof_cbt_AB","status":"contextual_provisional"}],"chapter_id":"c-shiji-037-wei","book_id":"b-shiji-037","work_id":"w-shiji","source_id":"s-shiji-037-wei"},{"id":"c-shiji-037-wei:p011","text":"桓公二年，弟州吁驕奢，桓公絀之，州吁出奔。十三年，鄭伯弟段攻其兄，不勝，亡，而州吁求與之友。十六年，州吁收聚衞亡人以襲殺桓公，州吁自立爲衞君。爲鄭伯弟段欲伐鄭，請宋、陳、蔡與倶，三國皆許州吁。州吁新立，好兵，弒桓公，衞人皆不愛。石碏乃因桓公母家於陳，詳爲善州吁。至鄭郊，石碏與陳侯共謀，使右宰丑進食，因殺州吁于濮，而迎桓公弟晉於邢而立之，是爲宣公。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-037-wei:m011-0000","start":0,"end":2,"surface":"桓公","kind":"person","person_id":"xrt_zof_cbt_AB","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m011-0006","start":6,"end":8,"surface":"州吁","kind":"person","person_id":"xrt_zof_cbt_AA","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m011-0011","start":11,"end":13,"surface":"桓公","kind":"person","person_id":"xrt_zof_cbt_AB","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m011-0016","start":16,"end":18,"surface":"州吁","kind":"person","person_id":"xrt_zof_cbt_AA","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m01