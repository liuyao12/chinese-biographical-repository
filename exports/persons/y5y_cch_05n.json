043-wangyan:p005:m0021","start":21,"end":22,"surface":"妃","kind":"person","person_id":"y5y_cch_05n","status":"contextual_provisional","resolution_note":"王衍女為太子妃；奏疏中太子/皇太子承湣懷太子，妃是衍女；梁王肜為書信受者。","paragraph_id":"c-jinshu-043-wangyan:p005","chapter_id":"c-jinshu-043-wangyan"},{"id":"c-jinshu-043-wangyan:p005:m0069","start":69,"end":70,"surface":"妃","kind":"person","person_id":"y5y_cch_05n","status":"contextual_provisional","resolution_note":"王衍女為太子妃；奏疏中太子/皇太子承湣懷太子，妃是衍女；梁王肜為書信受者。","paragraph_id":"c-jinshu-043-wangyan:p005","chapter_id":"c-jinshu-043-wangyan"},{"id":"c-jinshu-053-minhuai-family:p004:m0054","start":54,"end":56,"surface":"王氏","kind":"person","person_id":"y5y_cch_05n","status":"contextual_provisional","source_role":"wangwife","paragraph_id":"c-jinshu-053-minhuai-family:p004","chapter_id":"c-jinshu-053-minhuai-family"},{"id":"c-jinshu-053-minhuai-family:p004:m0061","start":61,"end":65,"surface":"太孫太妃","kind":"person","person_id":"y5y_cch_05n","status":"contextual_provisional","source_role":"wangwife","paragraph_id":"c-jinshu-053-minhuai-family:p004","chapter_id":"c-jinshu-053-minhuai-family"}],"relations":[{"id":"a-jin053-zang-raised-by-wang","subject_person_id":"dkn_ge4_286_AAAAIAAAB","predicate":"raised_by","object_person_id":"y5y_cch_05n","status":"source_attested","qualifiers":{"source_term":"還妃王氏以母之","source_clause_binding":{"kind":"received_sima_family_roles","role":"zang-raised-by-wang"},"biological_mother_not_inferred":true,"source_reported_maternal_role_only":true},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-053","source_id":"s-jinshu-053-ws2595666-rendered-family","chapter_id":"c-jinshu-053-minhuai-family","paragraph_id":"c-jinshu-053-minhuai-family:p004","quote":"臧字敬文。永康元年四月，封臨淮王。己巳，詔曰：「咎徵數發，奸回作變，遹既逼廢，非命而沒。今立臧為皇太孫。還妃王氏以母之，稱太孫太妃。太子官屬即轉為太孫官屬。趙王倫行太孫太傅。」五月，倫與太孫俱之東宮，太孫自西掖門出，車服侍從皆湣懷之舊也。到銅駝街，宮人哭，侍從者皆哽咽，路人抆淚焉。桑復生於西廂，太孫廢，乃枯。永甯元年正月，趙王倫篡位，廢為濮陽王，與帝俱遷金墉，尋被害。太安初，追諡曰哀。","subject_person_mention_id":"c-jinshu-053-minhuai-family:p004:m0000","object_person_mention_id":"c-jinshu-053-minhuai-family:p004:m0054"}],"reviewer":"Codex（AI代理）","human_reviewed":false,"model":null}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-043-wangyan:p005","text":"後曆北軍中候、中領軍、尚書令。女為湣懷太子妃，太子為賈后所誣，衍懼禍，自表離婚。賈后既廢，有司奏衍，曰：「衍與司徒梁王肜書，寫呈皇太子手與妃及衍書，陳見誣見狀。肜等伏讀，辭旨懇惻。衍備位大臣，應以議責也。太子被誣得罪，衍不能守死善道，即求離婚。得太子手書，隱蔽不出。志在苟免，無忠蹇之操。宜加顯責，以厲臣節。可禁錮終身。」從之。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-043-wangyan:p005:m0015","start":15,"end":16,"surface":"女","kind":"person","person_id":"y5y_cch_05n","status":"contextual_provisional","resolution_note":"衍之女，未由他書補名惠風。"},{"id":"c-jinshu-043-wangyan:p005:m0017","start":17,"end":21,"surface":"湣懷太子","kind":"person","person_id":"dkn_ge4_286_AAAAIAAA","status":"contextual_provisional","resolution_note":"王衍女為太子妃；奏疏中太子/皇太子承湣懷太子，妃是衍女；梁王肜為書信受者。"},{"id":"c-jinshu-043-wangyan:p005:m0021","start":21,"end":22,"surface":"妃","kind":"person","person_id":"y5y_cch_05n","status":"contextual_provisional","resolution_note":"王衍女為太子妃；奏疏中太子/皇太子承湣懷太子，妃是衍女；梁王肜為書信受者。"},{"id":"c-jinshu-043-wangyan:p005:m0023","start":23,"end":25,"surface":"太子","kind":"person","person_id":"dkn_ge4_286_AAAAIAAA","status":"contextual_provisional","resolution_note":"王衍女為太子妃；奏疏中太子/皇太子承湣懷太子，妃是衍女；梁王肜為書信受者。"},{"id":"c-jinshu-043-wangyan:p005:m0026","start":26,"end":28,"surface":"賈后","kind":"person","person_id":"jmv_vc4_gep_*AAA","status":"contextual_provisional","resolution_note":"王衍女為太子妃；奏疏中太子/皇太子承湣懷太子，妃是衍女；梁王肜為書信受者。"},{"id":"c-jinshu-043-wangyan:p005:m0031","start":31,"end":32,"surface":"衍","kind":"person","person_id":"kwx_czc_d4c_A","status":"contextual_provisional","resolution_note":"王衍女為太子妃；奏疏中太子/皇太子承湣懷太子，妃是衍女；梁王肜為書信受者。"},{"id":"c-jinshu-043-wangyan:p005:m0040","start":40,"end":42,"surface":"賈后","kind":"person","person_i