preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-043-wangyan:p005","text":"後曆北軍中候、中領軍、尚書令。女為湣懷太子妃，太子為賈后所誣，衍懼禍，自表離婚。賈后既廢，有司奏衍，曰：「衍與司徒梁王肜書，寫呈皇太子手與妃及衍書，陳見誣見狀。肜等伏讀，辭旨懇惻。衍備位大臣，應以議責也。太子被誣得罪，衍不能守死善道，即求離婚。得太子手書，隱蔽不出。志在苟免，無忠蹇之操。宜加顯責，以厲臣節。可禁錮終身。」從之。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-043-wangyan:p005:m0015","start":15,"end":16,"surface":"女","kind":"person","person_id":"y5y_cch_05n","status":"contextual_provisional","resolution_note":"衍之女，未由他書補名惠風。"},{"id":"c-jinshu-043-wangyan:p005:m0017","start":17,"end":21,"surface":"湣懷太子","kind":"person","person_id":"74e_68c_9ae","status":"contextual_provisional","resolution_note":"王衍女為太子妃；奏疏中太子/皇太子承湣懷太子，妃是衍女；梁王肜為書信受者。"},{"id":"c-jinshu-043-wangyan:p005:m0021","start":21,"end":22,"surface":"妃","kind":"person","person_id":"y5y_cch_05n","status":"contextual_provisional","resolution_note":"王衍女為太子妃；奏疏中太子/皇太子承湣懷太子，妃是衍女；梁王肜為書信受者。"},{"id":"c-jinshu-043-wangyan:p005:m0023","start":23,"end":25,"surface":"太子","kind":"person","person_id":"74e_68c_9ae","status":"contextual_provisional","resolution_note":"王衍女為太子妃；奏疏中太子/皇太子承湣懷太子，妃是衍女；梁王肜為書信受者。"},{"id":"c-jinshu-043-wangyan:p005:m0026","start":26,"end":28,"surface":"賈后","kind":"person","person_id":"jmv_vc4_gep_*AAA","status":"contextual_provisional","resolution_note":"王衍女為太子妃；奏疏中太子/皇太子承湣懷太子，妃是衍女；梁王肜為書信受者。"},{"id":"c-jinshu-043-wangyan:p005:m0031","start":31,"end":32,"surface":"衍","kind":"person","person_id":"kwx_czc_d4c_A","status":"contextual_provisional","resolution_note":"王衍女為太子妃；奏疏中太子/皇太子承湣懷太子，妃是衍女；梁王肜為書信受者。"},{"id":"c-jinshu-043-wangyan:p005:m0040","start":40,"end":42,"surface":"賈后","kind":"person","person_id":"jmv_vc4_gep_*AAA","status":"contextual_provisional","resolution_note":"王衍女為太子妃；奏疏中太子/皇太子承湣懷太子，妃是衍女；梁王肜為書信受者。"},{"id":"c-jinshu-043-wangyan:p005:m0048","start":48,"end":49,"surface":"衍","kind":"person","person_id":"kwx_czc_d4c_A","status":"contextual_pro