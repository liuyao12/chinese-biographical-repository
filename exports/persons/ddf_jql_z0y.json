ferred_relations":[{"id":"a-shiji071-004","subject_person_id":"f4j_73i_aup","predicate":"mother","object_person_id":"ddf_jql_z0y","status":"source_attested","evidence":[{"chapter_id":"c-shiji-071-chugan","source_id":"s-shiji-071-chugan","paragraph_id":"c-shiji-071-chugan:p010","quote":"武王竟至周，而卒於周。其弟立，為昭王。王母宣太后，楚女也。楚懷王怨前秦敗楚於丹陽而韓不救，乃以兵圍韓雍氏。韓使公仲侈告急於秦。秦昭王新立，太后楚人，不肯救。公仲因甘茂，茂為韓言於秦昭王曰：「公仲方有得秦救，故敢捍楚也。今雍氏圍，秦師不下殽，公仲且仰首而不朝，公叔且以國南合於楚。楚、韓為一，魏氏不敢不聽，然則伐秦之形成矣。不識坐而待伐孰與伐人之利？」秦王曰：「善。」乃下師於殽以救韓。楚兵去。"}],"qualifiers":{"source_term":"王母宣太后","historicity":"historical_tradition"},"interpretation_note":"只取明示兄弟、母與孫，異母不補同母、兄弟不補父親、孫不補闕代。曾參故事中的同名殺人者分存，不把誣傳當孝子殺人事實；燕王使太子不單據此補父子。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-071-chugan:m010-0019","start":19,"end":24,"surface":"王母宣太后","kind":"person","person_id":"ddf_jql_z0y","status":"contextual_provisional","paragraph_id":"c-shiji-071-chugan:p010","chapter_id":"c-shiji-071-chugan"},{"id":"c-shiji-071-chugan:m010-0025","start":25,"end":27,"surface":"楚女","kind":"person","person_id":"ddf_jql_z0y","status":"contextual_provisional","paragraph_id":"c-shiji-071-chugan:p010","chapter_id":"c-shiji-071-chugan"},{"id":"c-shiji-071-chugan:m010-0069","start":69,"end":71,"surface":"太后","kind":"person","person_id":"ddf_jql_z0y","status":"contextual_provisional","paragraph_id":"c-shiji-071-chugan:p010","chapter_id":"c-shiji-071-chugan"},{"id":"c-shiji-071-chugan:m011-0025","start":25,"end":28,"surface":"宣太后","kind":"person","person_id":"ddf_jql_z0y","status":"contextual_provisional","paragraph_id":"c-shiji-071-chugan:p011","chapter_id":"c-shiji-071-chugan"}],"relations":[{"id":"a-shiji071-004","subject_person_id":"f4j_73i_aup","predicate":"mother","object_person_id":"ddf_jql_z0y","status":"source_attested","evidence":[{"chapter_id":"c-shiji-071-chugan","source_id":"s-shiji-071-chu