{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004869","identity_policy":"contextual_provisional","person_ids":["cbr-p004869"],"persons":[{"id":"cbr-p004869","label":"荀卿（李斯列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"荀卿","mention_ids":["c-shiji-087-lisi:m002-0002","c-shiji-087-lisi:m002-0041","c-shiji-087-lisi:m011-0073"]}],"evidence":[{"mention_id":"c-shiji-087-lisi:m002-0002","chapter_id":"c-shiji-087-lisi","paragraph_id":"c-shiji-087-lisi:p002","quote":"荀卿"},{"mention_id":"c-shiji-087-lisi:m002-0041","chapter_id":"c-shiji-087-lisi","paragraph_id":"c-shiji-087-lisi:p002","quote":"荀卿"},{"mention_id":"c-shiji-087-lisi:m011-0073","chapter_id":"c-shiji-087-lisi","paragraph_id":"c-shiji-087-lisi:p011","quote":"荀卿"}]}],"mentions":[{"id":"c-shiji-087-lisi:m002-0002","start":2,"end":4,"surface":"荀卿","kind":"person","person_id":"cbr-p004869","status":"contextual_provisional","paragraph_id":"c-shiji-087-lisi:p002","chapter_id":"c-shiji-087-lisi"},{"id":"c-shiji-087-lisi:m002-0041","start":41,"end":43,"surface":"荀卿","kind":"person","person_id":"cbr-p004869","status":"contextual_provisional","paragraph_id":"c-shiji-087-lisi:p002","chapter_id":"c-shiji-087-lisi"},{"id":"c-shiji-087-lisi:m011-0073","start":73,"end":75,"surface":"荀卿","kind":"person","person_id":"cbr-p004869","status":"contextual_provisional","paragraph_id":"c-shiji-087-lisi:p011","chapter_id":"c-shiji-087-lisi"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji087-002","person_id":"cbr-p004869","surfaces":["荀卿"],"scope":"same_chapter","chapter_ids":["c-shiji-087-lisi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-087-lisi:p002","quote":"乃從荀卿學帝王之術。學已成，度楚王不足事，而六國皆弱，無可為建功者，欲西入秦。辭於荀卿曰：「斯聞得時無怠，今萬乘方爭時，遊者主事。今秦王欲吞天下，稱帝而治，此布衣馳騖之時而遊說者之秋也。處卑賤之位而計不為者，此禽鹿視肉，人面而能彊行者耳。故詬莫大於卑賤，而悲莫甚於窮困。久處卑賤之位，困苦之地，非世而惡利，自讬於無為，此非士之情也。故斯將西說秦王矣。」"},{"paragraph_id":"c-shiji-087-lisi:p011","quote":"斯長男由為三川守，諸男皆尚秦公主，女悉嫁秦諸公子。三川守李由告歸咸陽，李斯置酒於家，百官長皆前為壽，門廷車騎以千數。李斯喟然而歎曰：「嗟乎！吾聞之荀卿曰『物禁大盛』。夫斯乃上蔡布衣，閭巷之黔首，上不知其駑下，遂擢至此。當今人臣之位無居臣上者，可謂富貴極矣。物極則衰，吾未知所稅駕也！」"}],"rationale":"依李斯入秦及諫逐客書局部承接暫接；辭師時秦王未定，與莊襄王卒後所說秦王分開候選，未按同稱全域合併。引古人物與黃帝傳說性分存，短稱斯限李斯敘事。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-087-lisi:p002","text":"乃從荀卿學帝王之術。學已成，度楚王不足事，而六國皆弱，無可為建功者，欲西入秦。辭於荀卿曰：「斯聞得時無怠，今萬乘方爭時，遊者主事。今秦王欲吞天下，稱帝而治，此布衣馳騖之時而遊說者之秋也。處卑賤之位而計不為者，此禽鹿視肉，人面而能彊行者耳。故詬莫大於卑賤，而悲莫甚於窮困。久處卑賤之位，困苦之地，非世而惡利，自讬於無為，此非士之情也。故斯將西說秦王矣。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-087-lisi:m002-0002","start":2,"end":4,"surface":"荀卿","kind":"person","person_id":"cbr-p004869","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m002-0015","start":15,"end":17,"surface":"楚王","kind":"person","person_id":"cbr-p004870","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m002-0041","start":41,"end":43,"surface":"荀卿","kind":"person","person_id":"cbr-p004869","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m002-0046","start":46,"end":47,"surface":"斯","kind":"person","person_id":"cbr-p004868","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m002-0060","start":60,"end":62,"surface":"遊者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、普通類稱或未定對象不補姓名；人犬不當特定人物。"},{"id":"c-shiji-087-lisi:m002-0066","start":66,"end":68,"surface":"秦王","kind":"person","person_id":"cbr-p004871","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m002-0167","start":167,"end":168,"surface":"斯","kind":"person","person_id":"cbr-p004868","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m002-0171","start":171,"end":173,"surface":"秦王","kind":"person","person_id":"cbr-p004871","status":"contextual_provisional"}],"chapter_id":"c-shiji-087-lisi","book_id":"b-shiji-087","work_id":"w-shiji","source_id":"s-shiji-087-lisi"},{"id":"c-shiji-087-lisi:p011","text":"斯長男由為三川守，諸男皆尚秦公主，女悉嫁秦諸公子。三川守李由告歸咸陽，李斯置酒於家，百官長皆前為壽，門廷車騎以千數。李斯喟然而歎曰：「嗟乎！吾聞之荀卿曰『物禁大盛』。夫斯乃上蔡布衣，閭巷之黔首，上不知其駑下，遂擢至此。當今人臣之位無居臣上者，可謂富貴極矣。物極則衰，吾未知所稅駕也！」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-087-lisi:m011-0000","start":0,"end":1,"surface":"斯","kind":"person","person_id":"cbr-p004868","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m011-0003","start":3,"end":4,"surface":"由","kind":"person","person_id":"cbr-p004894","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m011-0009","start":9,"end":11,"surface":"諸男","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或泛稱保留未解，不拆為未名個人；樂名、寶名不當人物。"},{"id":"c-shiji-087-lisi:m011-0013","start":13,"end":16,"surface":"秦公主","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或泛稱保留未解，不拆為未名個人；樂名、寶名不當人物。"},{"id":"c-shiji-087-lisi:m011-0017","start":17,"end":18,"surface":"女","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或泛稱保留未解，不拆為未名個人；樂名、寶名不當人物。"},{"id":"c-shiji-087-lisi:m011-0020","start":20,"end":24,"surface":"秦諸公子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或泛稱保留未解，不拆為未名個人；樂名、寶名不當人物。"},{"id":"c-shiji-087-lisi:m011-0025","start":25,"end":30,"surface":"三川守李由","kind":"person","person_id":"cbr-p004894","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m011-0035","start":35,"end":37,"surface":"李斯","kind":"person","person_id":"cbr-p004868","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m011-0042","start":42,"end":45,"surface":"百官長","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或泛稱保留未解，不拆為未名個人；樂名、寶名不當人物。"},{"id":"c-shiji-087-lisi:m011-0058","start":58,"end":60,"surface":"李斯","kind":"person","person_id":"cbr-p004868","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m011-0073","start":73,"end":75,"surface":"荀卿","kind":"person","person_id":"cbr-p004869","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m011-0084","start":84,"end":85,"surface"