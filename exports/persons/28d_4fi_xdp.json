d_4fi_xdp","status":"contextual_provisional","paragraph_id":"c-shiji-052-qidaohui:p042","chapter_id":"c-shiji-052-qidaohui"},{"id":"c-shiji-052-qidaohui:m043-0016","start":16,"end":18,"surface":"文帝","kind":"person","person_id":"28d_4fi_xdp","status":"contextual_provisional","paragraph_id":"c-shiji-052-qidaohui:p043","chapter_id":"c-shiji-052-qidaohui"}],"relations":[],"title_holdings":[{"id":"th-shiji052-028","person_id":"28d_4fi_xdp","title":"孝文帝","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-052-qidaohui","source_id":"s-shiji-052-qidaohui","paragraph_id":"c-shiji-052-qidaohui:p017","quote":"王既罷兵歸，而代王來立，是為孝文帝。"}],"attestations":[{"id":"th-shiji052-028:a001","paragraph_id":"c-shiji-052-qidaohui:p017","start":14,"end":17,"surface":"孝文帝","person_mention_id":"c-shiji-052-qidaohui:m017-0014","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予、任事、提議、回敘及用稱分開；年號僅留原語，不反算公曆起訖。朱虛、東牟許封趙梁而未實現不記實授，死亡不自動終止全部稱號。章與興居授王兩處年表述各留原段，不擅調和。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji052-020","person_id":"28d_4fi_xdp","surfaces":["代王","孝文","孝文帝","文帝"],"scope":"same_chapter","chapter_ids":["c-shiji-052-qidaohui"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-052-qidaohui:p015","quote":"大臣議欲立齊王，而瑯邪王及大臣曰：「齊王母家駟鈞，惡戾，虎而冠者也。方以呂氏故幾亂天下，今又立齊王，是欲復為呂氏也。代王母家薄氏，君子長者；且代王又親高帝子，於今見在，且最為長。以子則順，以善人則大臣安。」於是大臣乃謀迎立代王，而遣朱虛侯以誅呂氏事告齊王，令罷兵。"},{"paragraph_id":"c-shiji-052-qidaohui:p017","quote":"王既罷兵歸，而代王來立，是為孝文帝。"},{"paragraph_id":"c-shiji-052-qidaohui:p018","quote":"孝文帝元年，盡以高后時所割齊之城陽、瑯邪、濟南郡復與齊，而徙瑯邪王王燕，益封朱虛侯、東牟侯各二千戶。"},{"paragraph_id":"c-shiji-052-qidaohui:p022","quote":"後二年，孝文帝盡封齊悼惠王子罷軍等七人皆為列侯。"},{"paragraph_id":"c-shiji-052-qidaohui:p024","quote":"後一歲，孝文帝以所封悼惠王子分齊為王，齊孝王將閭以悼惠王子楊虛侯為齊王。故齊別郡盡以王悼惠王子：子志為濟北王，子辟光為濟南王，子賢為菑川王，子卬為膠西王，子雄渠為膠東王，與城陽、齊凡七王。"},{"paragraph_id":"c-shiji-052-qidaohui:p033","quote":"城陽景王章，齊悼惠王子，以朱虛侯與大臣共誅諸呂，而章身首先斬相國呂王產於未央宮。孝文帝既立，益封章二千戶，賜金千斤。孝文二年，以齊之城陽郡立章為城陽王。立二年卒，子喜立，是為共王。"},{"paragraph_id":"c-shiji-052-qidaohui:p036","quote":"濟北王興居，齊悼惠王子，以東牟侯助大臣誅諸呂，功少。及文帝從代來，興居曰：「請與太仆嬰入清宮。」廢少帝，共與大臣尊立孝文帝。"},{"paragraph_id":"c-shiji-052-qidaohui:p037","quote":"孝文帝二年，以齊之濟北郡立興居為濟北王，與城陽王俱立。立二年，反。始大臣誅呂氏時，朱虛侯功尤大，許盡以趙地王朱虛侯，盡以梁地王東牟侯。及孝文帝立，聞朱虛、東牟之初欲立齊王，故絀其功。及二年，王諸子，乃割齊二郡以王章、興居。章、興居自以失職奪功。章死，而興居聞匈奴大入漢，漢多發兵，使丞相灌嬰擊之，文帝親幸太原，以為天子自擊胡，遂發兵反於濟北。天子聞之，罷丞相及行兵，皆歸長安。使棘蒲侯柴將軍擊破虜濟北王，王自殺，地入于漢，為郡。"},{"paragraph_id":"c-shiji-052-qidaohui:p038","quote":"後十二年，文帝十六年，復以齊悼惠王子安都侯志為濟北王。十一年，吳楚反時，志堅守，不與諸侯合謀。吳楚已平，徙志王菑川。"},{"paragraph_id":"c-shiji-052-qidaohui:p039","quote":"濟南王辟光，齊悼惠王子，以勒侯孝文十六年為濟南王。十一年，與吳楚反。漢擊破，殺辟光，以濟南為郡，地入于漢。"},{"paragraph_id":"c-shiji-052-qidaohui:p040","quote":"菑川王賢，齊悼惠王子，以武城侯文帝十六年為菑川王。十一年，與吳楚反，漢擊破，殺賢。"},{"paragraph_id":"c-shiji-052-qidaohui:p042","quote":"膠西王卬，齊悼惠王子，以昌平侯文帝十六年為膠西王。十一年，與吳楚反。漢擊破，殺卬，地入于漢，為膠西郡。"},{"paragraph_id":"c-shiji-052-qidaohui:p043","quote":"膠東王雄渠，齊悼惠王子，以白石侯文帝十六年為膠東王。十一年，與吳楚反，漢擊破，殺雄渠，地入于漢，為膠東郡。"}],"rationale":"依明示名與王國、世次的局部敘事暫接；齊、城陽與菑川同諡者分開，興居與志分開。校勘建延及內史勳士未擅選讀法，未名帝后不補姓名，案件只保存來源敘事。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-052-qidaohui:p015","text":"大臣議欲立齊王，而瑯邪王及大臣曰：「齊王母家駟鈞，惡戾，虎而冠者也。方以呂氏故幾亂天下，今又立齊王，是欲復為呂氏也。代王母家薄氏，君子長者；且代王又親高帝子，於今見在，且最為長。以子則順，以善人則大臣安。」於是大臣乃謀迎立代王，而遣朱虛侯以誅呂氏事告齊王，令罷兵。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-052-qidaohui:m015-0000","start":0,"end":2,"surface":"大臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、未名者、未核官稱或代詞，不補姓名及家屬成員。"},{"id":"c-shiji-052-qidaohui:m015-0005","start":5,"end":7,"surface":"齊王","kind":"person","person_id":"byp_ks5_71a_AA","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m015-0009","start":9,"end":12,"surface":"瑯邪王","kind":"person","pers