":"c-shiji-052-qidaohui:m036-0033","start":33,"end":35,"surface":"興居","kind":"person","person_id":"byp_ks5_71a_AC","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m036-0040","start":40,"end":43,"surface":"太仆嬰","kind":"person","person_id":"o3z_4md_e9l","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m036-0049","start":49,"end":51,"surface":"少帝","kind":"person","person_id":"4vo_tst_9dm","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m036-0054","start":54,"end":56,"surface":"大臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、官稱、未名者或待核回指；不補姓名，王作動詞不當人名。"},{"id":"c-shiji-052-qidaohui:m036-0058","start":58,"end":61,"surface":"孝文帝","kind":"person","person_id":"28d_4fi_xdp","status":"contextual_provisional"}],"chapter_id":"c-shiji-052-qidaohui","book_id":"b-shiji-052","work_id":"w-shiji","source_id":"s-shiji-052-qidaohui"},{"id":"c-shiji-052-qidaohui:p037","text":"孝文帝二年，以齊之濟北郡立興居為濟北王，與城陽王俱立。立二年，反。始大臣誅呂氏時，朱虛侯功尤大，許盡以趙地王朱虛侯，盡以梁地王東牟侯。及孝文帝立，聞朱虛、東牟之初欲立齊王，故絀其功。及二年，王諸子，乃割齊二郡以王章、興居。章、興居自以失職奪功。章死，而興居聞匈奴大入漢，漢多發兵，使丞相灌嬰擊之，文帝親幸太原，以為天子自擊胡，遂發兵反於濟北。天子聞之，罷丞相及行兵，皆歸長安。使棘蒲侯柴將軍擊破虜濟北王，王自殺，地入于漢，為郡。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-052-qidaohui:m037-0000","start":0,"end":3,"surface":"孝文帝","kind":"person","person_id":"28d_4fi_xdp","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m037-0013","start":13,"end":15,"surface":"興居","kind":"person","person_id":"byp_ks5_71a_AC","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m037-0016","start":16,"end":19,"surface":"濟北王","kind":"person","person_id":"byp_ks5_71a_AC","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m037-0021","start":21,"end":24,"surface":"城陽王","kind":"person","person_id":"byp_ks5_71a_AB","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m037-0041","start":41,"end":44,"surface":"朱虛侯","kind":"person","person_id":"byp_ks5_71a_AB","status":"contextual_