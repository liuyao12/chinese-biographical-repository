{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000096","identity_policy":"contextual_provisional","person_ids":["cbr-p000096"],"persons":[{"id":"cbr-p000096","label":"女房","status":"active","historicity":"historical_tradition","aliases":[{"surface":"女房","mention_ids":["c-shiji-003-yin:m005-0105"]}],"evidence":[{"mention_id":"c-shiji-003-yin:m005-0105","chapter_id":"c-shiji-003-yin","paragraph_id":"c-shiji-003-yin:p005","quote":"女房"}],"identity_note":"依《殷本紀》的特定敘事建立；個別史實及出土材料對應尚未覆核，不按同名跨卷合併。","review":"ai_provisional"}],"mentions":[{"id":"c-shiji-003-yin:m005-0105","start":105,"end":107,"surface":"女房","kind":"person","person_id":"cbr-p000096","status":"source_identified","paragraph_id":"c-shiji-003-yin:p005","chapter_id":"c-shiji-003-yin"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-003-yin:p005","text":"伊尹名阿衡。阿衡欲奸湯而無由，乃為有莘氏媵臣，負鼎俎，以滋味說湯，致于王道。或曰，伊尹處士，湯使人聘迎之，五反，然後肯往從湯，言素王及九主之事。湯舉任以國政。伊尹去湯適夏。既醜有夏，復歸于亳。入自北門，遇女鳩、女房，作女鳩女房。","mentions":[{"id":"c-shiji-003-yin:m005-0000","start":0,"end":2,"surface":"伊尹","kind":"person","person_id":"cbr-p000094","status":"source_identified"},{"id":"c-shiji-003-yin:m005-0003","start":3,"end":5,"surface":"阿衡","kind":"person","person_id":"cbr-p000094","status":"source_identified"},{"id":"c-shiji-003-yin:m005-0006","start":6,"end":8,"surface":"阿衡","kind":"person","person_id":"cbr-p000094","status":"source_identified"},{"id":"c-shiji-003-yin:m005-0010","start":10,"end":11,"surface":"湯","kind":"person","person_id":"cbr-p000077","status":"source_identified"},{"id":"c-shiji-003-yin:m005-0017","start":17,"end":20,"surface":"有莘氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"氏族、群體、官稱或未定個人指代；不由熟知故事補出姓名。"},{"id":"c-shiji-003-yin:m005-0031","start":31,"end":32,"surface":"湯","kind":"person","person_id":"cbr-p000077","status":"source_identified"},{"id":"c-shiji-003-yin:m005-00