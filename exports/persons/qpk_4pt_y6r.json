_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-032-chu-suanzi:line040:m0045","start":45,"end":47,"surface":"康帝","kind":"person","person_id":"qpk_4pt_y6r","status":"contextual_provisional","paragraph_id":"c-jinshu-032-chu-suanzi:line040","chapter_id":"c-jinshu-032-chu-suanzi"},{"id":"c-jinshu-032-chu-suanzi:line042:m0247","start":247,"end":249,"surface":"先帝","kind":"person","person_id":"qpk_4pt_y6r","status":"contextual_provisional","paragraph_id":"c-jinshu-032-chu-suanzi:line042","chapter_id":"c-jinshu-032-chu-suanzi"},{"id":"c-jinshu-032-chu-suanzi:line050:m0109","start":109,"end":110,"surface":"康","kind":"person","person_id":"qpk_4pt_y6r","status":"contextual_provisional","paragraph_id":"c-jinshu-032-chu-suanzi:line050","chapter_id":"c-jinshu-032-chu-suanzi"},{"id":"c-jinshu-093-chupou:line051:m0091","start":91,"end":93,"surface":"吳王","kind":"person","person_id":"qpk_4pt_y6r","status":"contextual_provisional","interpretation_note":"本紀咸和元年封皇弟岳為吳王、二年改琅邪王，與本傳蘇峻亂前任吳王文學及後文康帝為琅邪王相合；不據此倒定授官年。","paragraph_id":"c-jinshu-093-chupou:line051","chapter_id":"c-jinshu-093-chupou"},{"id":"c-jinshu-093-chupou:line051:m0143","start":143,"end":145,"surface":"康帝","kind":"person","person_id":"qpk_4pt_y6r","status":"contextual_provisional","paragraph_id":"c-jinshu-093-chupou:line051","chapter_id":"c-jinshu-093-chupou"},{"id":"c-jinshu-093-chupou:line051:m0146","start":146,"end":149,"surface":"琅邪王","kind":"person","person_id":"qpk_4pt_y6r","status":"contextual_provisional","paragraph_id":"c-jinshu-093-chupou:line051","chapter_id":"c-jinshu-093-chupou"},{"id":"c-jinshu-093-chupou:line051:m0177","start":177,"end":179,"surface":"康帝","kind":"person","person_id":"qpk_4pt_y6r","status":"contextual_provisional","paragraph_id":"c-jinshu-093-chupou:line051","chapter_id":"c-jinshu-093-chupou"},{"id":"c-jinshu-093-chupou:line053:m0242","start":242,"end":244,"surface":"先帝","kind":"person","person_id":"qpk_4pt_y6r","status":"contextual_provisional","paragraph_id":"c-jinshu-093-chupou:line053","chapter_id":"c-jinshu-093-chupou"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-jinshu093-chupou-kang-langye","person_id":"qpk_4pt_y6r","surfaces":["康帝","琅邪王"],"scope":"same_chapter","chapter_ids":["c-jinshu-093-chupou"],"status":"contextual_provisional","confidence_level":"high","identification_basis":{"kind":"source_context","target_mention_ids":["c-jinshu-093-chupou:line051:m0143","c-jinshu-093-chupou:line051:m0146","c-jinshu-093-chupou:line051:m0177"]},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-093","source_id":"s-jinshu-093-chupou","chapter_id":"c-jinshu-093-chupou","paragraph_id":"c-jinshu-093-chupou:line051","quote":"裒少有簡貴之風，與京兆杜乂俱有盛名，冠于中興。譙國桓彝見而目之曰：「季野有皮裏春秋。」言其外無臧否，而內有所褒貶也。謝安亦雅重之，恆云：「裒雖不言，而四時之氣亦備矣。」初辟西陽王掾、吳王文學。蘇峻之構逆也，車騎將軍郗鑒以裒為參軍。峻平，以功封都鄉亭侯，稍遷司徒從事中郎，除給事黃門侍郎。康帝為琅邪王時，將納妃，妙選素望，詔娉裒女為妃，於是出為豫章太守。及康帝即位，徵拜侍中，遷尚書。以后父，苦求外出，除建威將軍、江州刺史，鎮半洲。在官清約，雖居方伯，恆使私童樵採。頃之，徵為衛將軍，領中書令。裒以中書銓管詔命，不宜以姻戚居之，固讓，詔以為左將卦、兗州刺史、都督兗州徐州之琅邪諸軍事、假節，鎮金城，又領琅邪內史。"}],"rationale":"康帝為琅邪王時將納妃明示同人前後稱謂；與褚后傳先入琅邪王妃、及康帝即位相合，不用後世會稽王或同王號替代。","human_reviewed":false,"model":null,"references":[{"title":"《晉書》卷32（康獻褚皇后傳）","url":"https://zh.wikisource.org/w/index.php?oldid=1543614","source_revision":1543614,"work_id":"w-jinshu","book_id":"b-jinshu-032","chapter_id":"c-jinshu-032-chu-suanzi","source_id":"s-jinshu-032-chu-suanzi","paragraph_id":"c-jinshu-032-chu-suanzi:line040","quote":"康獻褚皇后諱蒜子，河南陽翟人也。父裒，見《外戚傳》。后聰明有器識，少以名家入為琅邪王妃。及康帝即位，立為皇后，封母謝氏為尋陽鄉君。","scope":"native_received_parallel_passage","image_verified":false}]},{"id":"d-jinshu093-chupou-kang-predecessor","person_id":"qpk_4pt_y6r","surfaces":["先帝"],"scope":"same_chapter","chapter_ids":["c-jinshu-093-chupou"],"status":"contextual_provisional","confidence_level":"high","identification_basis":{"kind":"source_context","target_mention_ids":["c-jinshu-093-chupou:line053:m0242"]},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-093","source_id":"s-jinshu-093-chupou","chapter_id":"c-jinshu-093-chupou","paragraph_id":"c-jinshu-093-chupou:line053","quote":"初，裒總角詣庾亮，亮使郭璞筮之。卦成，璞駭然，亮曰：「有不祥乎？」璞曰：「此非人臣卦，不知此年少何以乃表斯祥？二十年外，吾言方驗。」及此二十九年而康獻皇太后臨朝，有司以裒皇太后父，議加不臣之禮，拜侍中、衛將軍、錄尚書事，持節、都督、刺史如故。裒以近戚，懼獲譏嫌，上疏固請居籓，曰：「臣以虛鄙，才不周用，過蒙國恩，累忝非據。無勞受寵，負愧實深，豈可復加殊特之命，顯號重疊！臣有何勳可以克堪？何顏可以冒進？委身聖世，豈復遺力，實懼顛墜，所誤者大。今王略未振，萬機至殷，陛下宜委誠宰輔，一遵先帝任賢之道，虛己受成，坦平心於天下，無宜內示私親之舉，朝野失望，所損豈少！」於是改授都督徐兗青揚州之晉陵吳國諸軍事、衛將軍、徐兗二州刺史、假節、鎮京口。"}],"rationale":"康獻太后臨朝、穆帝在位的疏文中先帝暫取康帝，與本傳前段康帝即位及后傳康穆交替相合；不作跨篇固定詞對照。","human_reviewed":false,"model":null,"references":[{"title":"《晉書》卷32（康獻褚皇后傳）","url":"https://zh.wikisource.org/w/index.php?oldid=1543614","source_revision":1543614,"work_id":"w-jinshu","book_id":"b-jinshu-032","chapter_id":"c-jinshu-032-chu-suanzi","source_id":"s-jinshu-032-chu-suanzi","paragraph_id":"c-jinshu-032-chu-suanzi:line042","quote":"及穆帝即位，尊后曰皇太后。時帝幼沖，未親國政。領司徒蔡謨等上奏曰：「嗣皇誕哲岐嶷，繼承天統，率土宅心，兆庶蒙賴。陛下體茲坤道，訓隆文母。昔塗山光夏，簡狄熙殷，實由宣哲，以隆休祚。伏惟陛下德侔二媯，淑美關雎，臨朝攝政，以寧天下。今社稷危急，兆庶懸命，臣等章惶，一日萬機，事運之期，天祿所鍾，非復沖虛高讓之日。漢和熹、順烈，並亦臨朝，近明穆故事，以為先制。臣等不勝悲怖，謹伏地上請。乞陛下上順祖宗，下念臣吏，推公弘道，以協天人，則萬邦承慶，群黎更生。」太后詔曰：「帝幼沖，當賴群公卿士將順匡救，以酬先帝禮賢之意，且是舊德世濟之美，則莫重之命不墜，祖宗之基有奉，是其所以欲正位于內而已。所奏懇到，形于翰墨，執省未究，以悲以懼。先后允恭謙抑，思順坤道，所以不距群情，固為國計。豈敢執守沖闇，以違先旨。輒敬從所奏。」於是臨朝稱制。有司奏，謝夫人既封，荀、卞二夫人亦應追贈，皆后之前母也。太后不許。太常殷融議依鄭玄義，衛將軍裒在宮庭則盡臣敬，太后歸寧之日自如家人之禮。太后詔曰：「典禮誠所未詳，如所奏，是情所不能安也，更詳之。」征西將軍翼、南中郎尚議謂「父尊盡於一家，君敬重於天下，鄭玄義合情禮之中」。太后從之。自後朝臣皆敬裒焉。","scope":"native_received_parallel_passage","image_verified":false}]},{"id":"d-jinshu093-chupou-wuwang-yue","person_id":"qpk_4pt_y6r","surfaces":["吳王"],"scope":"same_chapter","chapter_ids":["c-jinshu-093-chupou"],"status":"contextual_provisional","confidence_level":"high","identification_basis":{"kind":"source_context","target_mention_ids":["c-jinshu-093-chupou:line051:m0091"]},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-093","source_id":"s-jinshu-093-chupou","chapter_id":"c-jinshu-093-chupou","paragraph_id":"c-jinshu-093-chupou:line051","quote":"裒少有簡貴之風，與京兆杜乂俱有盛名，冠于中興。譙國桓彝見而目之曰：「季野有皮裏春秋。」言其外無臧否，而內有所褒貶也。謝安亦雅重之，恆云：「裒雖不言，而四時之氣亦備矣。」初辟西陽王掾、吳王文學。蘇峻之構逆也，車騎將軍郗鑒以裒為參軍。峻平，以功封都鄉亭侯，稍遷司徒從事中郎，除給事黃門侍郎。康帝為琅邪王時，將納妃，妙選素望，詔娉裒女為妃，於是出為豫章太守。及康帝即位，徵拜侍中，遷尚書。以后父，苦求外出，除建威將軍、江州刺史，鎮半洲。在官清約，雖居方伯，恆使私童樵採。頃之，徵為衛將軍，領中書令。裒以中書銓管詔命，不宜以姻戚居之，固讓，詔以為左將卦、兗州刺史、都督兗州徐州之琅邪諸軍事、假節，鎮金城，又領琅邪內史。"}],"references":[{"title":"《晉書》卷七（成帝紀）","url":"https://zh.wikisource.org/w/index.php?title=晉書/卷007&oldid=2582704","source_revision":2582704,"work_id":"w-jinshu","book_id":"b-jinshu-007","quote":"冬十月，封魏武帝玄孫曹勵爲陳留王<ref>曹勱　宋本、[[藝文類聚|類聚]]五一、[[冊府元龜|冊府]]一七三、御覽二０一引晉中興書及[[通典]]七四「勱」並作「勵」。</ref>，以紹魏。丙寅，衛將軍、汝南王祐薨。己巳，封皇弟岳爲吳王。車騎將軍、南頓王宗有罪，伏誅，貶其族爲馬氏。免太宰、西陽王羕，降爲弋陽縣王。庚辰，赦百里內五歲以下刑。是月，劉曜將黃秀、帛成寇酂，平北將軍魏該帥衆奔襄陽。","scope":"external_received_parallel_passage","image_verified":false},{"title":"《晉書》卷七（成帝紀）","url":"https://zh.wikisource.org/w/index.php?title=晉書/卷007&oldid=2582704","source_revision":2582704,"work_id":"w-jinshu","book_id":"b-jinshu-007","quote":"十二月辛亥，蘇峻使其將韓晃入姑孰，屠于湖。壬子，彭城王雄、章武王休叛，奔峻。庚申，京師戒嚴。假護軍將軍庾亮節爲征討都督，以右衛將軍趙胤爲冠軍將軍、歷陽太守，使與左將軍司馬流帥師距峻，戰於慈湖，流敗，死之。假驍騎將軍鐘雅節，帥舟軍，與趙胤爲前鋒，以距峻。丙寅，徒封琅邪王昱爲會稽王，吳王岳爲琅邪王。辛未，宣城內桓彝及峻戰于蕪湖，彝軍敗績。軍騎將軍郗鑒遣廣陵相劉矩帥師赴京師。","scope":"external_received_parallel_passage","image_verified":false}],"rationale":"本紀咸和元年封皇弟岳為吳王、二年改封琅邪王；本傳初任吳王文學在蘇峻構逆以前，後文明康帝原為琅邪王，稱號沿革與時序互證。只辨府主人，不推算褚裒授官年份。","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-032-chu-suanzi:line040","text":"康獻褚皇后諱蒜子，河南陽翟人也。父裒，見《外戚傳》。后聰明有器識，少以名家入為琅邪王妃。及康帝即位，立為皇后，封母謝氏為尋陽鄉君。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-032-chu-suanzi:line040:m0000","start":0,"end":5,"surface":"康獻褚皇后","kind":"person","person_id":"xke_dj3_6ba_AAB","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line040:m0006","start":6,"end":8,"surface":"蒜子","kind":"person","person_id":"xke_dj3_6ba_AAB","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line040:m0017","start":17,"end":18,"surface":"裒","kind":"person","person_id":"xke_dj3_6ba_AA","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line040:m0039","start":39,"end":43,"surface":"琅邪王妃","kind":"person","person_id":"xke_dj3_6ba_AAB","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line040:m0045","start":45,"end":47,"surface":"康帝","kind":"person","person_id":"qpk_4pt_y6r","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line040:m0057","start":57,"end":59,"surface":"謝氏","kind":"person","person_id":"d11_4kx_51l","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line040:m0060","start":60,"end":64,"surface":"尋陽鄉君","kind":"person","person_id":"d11_4kx_51l","status":"contextual_provisional"}],"source_position":{"first_line":40,"last_line":40,"revision_id":1543614,"editorial_excerpt_boundary":false},"chapter_id":"c-jinshu-032-chu-suanzi","book_id":"b-jinshu-032","work_id":"w-jinshu","source_id":"s-jinshu-032-chu-suanzi"},{"id":"c-jinshu-032-chu-suanzi:line042","text":"及穆帝即位，尊后曰皇太后。時帝幼沖，未親國政。領司徒蔡謨等上奏曰：「嗣皇誕哲岐嶷，繼承天統，率土宅心，兆庶蒙賴。陛下體茲坤道，訓隆文母。昔塗山光夏，簡狄熙殷，實由宣哲，以隆休祚。伏惟陛下德侔二媯，淑美關雎，臨朝攝政，以寧天下。今社稷危急，兆庶懸命，臣等章惶，一日萬機，事運之期，天祿所鍾，非復沖虛高讓之日。漢和熹、順烈，並亦臨朝，近明穆故事，以為先制。臣等不勝悲怖，謹伏地上請。乞陛下上順祖宗，下念臣吏，推公弘道，以協天人，則萬邦承慶，群黎更生。」太后詔曰：「帝幼沖，當賴群公卿士將順匡救，以酬先帝禮賢之意，且是舊德世濟之美，則莫重之命不墜，祖宗之基有奉，是其所以欲正位于內而已。所奏懇到，形于翰墨，執省未究，以悲以懼。先后允恭謙抑，思順坤道，所以不距群情，固為國計。豈敢執守沖闇，以違先旨。輒敬從所奏。」於是臨朝稱制。有司奏，謝夫人既封，荀、卞二夫人亦應追贈，皆后之前母也。太后不許。太常殷融議依鄭玄義，衛將軍裒在宮庭則盡臣敬，太后歸寧之日自如家人之禮。太后詔曰：「典禮誠所未詳，如所奏，是情所不能安也，更詳之。」征西將軍翼、南中郎尚議謂「父尊盡於一家，君敬重於天下，鄭玄義合情禮之中」。太后從之。自後朝臣皆敬裒焉。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-032-chu-suanzi:line042:m0001","start":1,"end":3,"surface":"穆帝","kind":"person","person_id":"84i_4jp_gmc","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0009","start":9,"end":12,"surface":"皇太后","kind":"person","person_id":"xke_dj3_6ba_AAB","status":"contextual_provi