2:m0224","start":224,"end":226,"surface":"太后","kind":"person","person_id":"xke_dj3_6ba_AAB","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0230","start":230,"end":231,"surface":"帝","kind":"person","person_id":"84i_4jp_gmc","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0247","start":247,"end":249,"surface":"先帝","kind":"person","person_id":"qpk_4pt_y6r","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0310","start":310,"end":312,"surface":"先后","kind":"person","person_id":"4qr_wrk_3vd_A","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0364","start":364,"end":367,"surface":"謝夫人","kind":"person","person_id":"d11_4kx_51l","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0370","start":370,"end":371,"surface":"荀","kind":"person","person_id":"o86_niw_j9s","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0372","start":372,"end":373,"surface":"卞","kind":"person","person_id":"mpc_jpz_86r","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0388","start":388,"end":390,"surface":"太后","kind":"person","person_id":"xke_dj3_6ba_AAB","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0395","start":395,"end":397,"surface":"殷融","kind":"person","person_id":"ali_hbb_4bn","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0399","start":399,"end":401,"surface":"鄭玄","kind":"person","person_id":"95f_p0e_7s8","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0406","start":406,"end":407,"surface":"裒","kind":"person","person_id":"xke_dj3_6ba_AA","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0415","start":415,"end":417,"surface":"太后","kind":"person","person_id":"xke_dj3_6ba_AAB","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0428","start":428,"end":430,"surface":"太后","kind":"person","person_id":"xke_dj3_6ba_AAB","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0462","start":462,"end":463,"surface":"翼","kind":"person","person_id":"kwv_z32_1b4","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0467","start":467,"end":468,"surface":"尚","kind":"person","person_id":"e3f_d0s_c13","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0485","start":485,"end":487,"surface":"鄭玄","kind":"person","person_id":"95f_p0e_7s8","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0495","start":495,"end":497,"surface":"太后","kind":"person","person_id":"xke_dj3_6ba_AAB","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0506","start":506,"end":507,"surface":"裒","kind":"person","person_id":"xke_dj3_6ba_AA","status":"contextual_provisional"}],"source_position":{"first_line":42,"last_line":42,"revision_id":1543614,"editorial_excerpt_boundary":false},"chapter_id":"c-jinshu-032-chu-suanzi","book_id":"b-jinshu-032","work_id":"w-jinshu","source_id":"s-jinshu-032-chu-suanzi"},{"id":"c-jinshu-032-chu-suanzi:line050","text":"太元九年，崩于顯陽殿，年六十一，在位凡四十年。太后於帝為從嫂，朝議疑其服。太學博士徐藻議曰：「資父事君而敬同。又禮云『其夫屬父道者，妻皆母道也』，則夫屬君道，妻亦后道矣。服后以齊，母之義也。魯譏逆祀，以明尊卑。今上躬奉康、穆、哀皇及靖后之祀，致敬同于所天，豈可敬之以君道，而服廢於本親。謂應齊衰期。」從之。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-032-chu-suanzi:line050:m0023","start":23,"end":25,"surface":"太后","kind":"person","person_id":"xke_dj3_6ba_AAB","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line050:m0026","start":26,"end":27,"surface":"帝","kind":"person","person_id":"uke_dff_yrf","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line050:m0041","start":41,"end":43,"surface":"徐藻","kind":"person","person_id":"yzr_t9c_k7v","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line050:m0105","start":105,"end":107,"surface":"今上","kind":"person","person_id":"uke_dff_yrf","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line050:m0109","start":109,"end":110,"surface":"康","kind":"person","person_id":"qpk_4pt_y6r","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line050:m0111","start":111,"end":112,"surface":"穆","kind":"person","person_id":"84i_4jp_gmc","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line050:m0113","start":113,"end":114,"surface":"哀","kind":"person","person_id":"emb_vx4_gm9","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line050:m0116","start":116,"end":118,"surface":"靖后","kind":"person","person_id":"puf_csp_mxf","status":"contextual_provisional"}],"source_position":{"first_line":50,"last_line":50,"revision_id":1543614,"editorial_excerpt_boundary":false},"chapter_id":"c-jinshu-032-chu-suanzi","book_id":"b-jinshu-032","work_id":"w-jinshu","source_id":"s-jinshu-032-chu-suanzi"},{"id":"c-jinshu-093-chupou:line051","text":"裒少有簡貴之風，與京兆杜乂俱有盛名，冠于中興。譙國桓彝見而目之曰：「季野有皮裏春秋。」言其外無臧否，而內有所褒貶也。謝安亦雅重之，恆云：「裒雖不言，而四時之氣亦備矣。」初辟西陽王掾、吳王文學。蘇峻之構逆也，車騎將軍郗鑒以裒為參軍。峻平，以功封都鄉亭侯，稍遷司徒從事中郎，除給事黃門侍郎。康帝為琅邪王時，將納妃，妙選素望，詔娉裒女為妃，於是出為豫章太守。及康帝即位，徵拜侍中，遷尚書。以后父，苦求外出，除建威將軍、江州刺史，鎮半洲。在官清約，雖居方伯，恆使私童樵採。頃之，徵為衛將軍，領中書令。裒以中書銓管詔命，不宜以姻戚居之，固讓，詔以為左將卦、兗州刺史、都督兗州徐州之琅邪諸軍事、假節，鎮金城，又領琅邪內史。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-093-chupou:line051:m0000","start":0,"end":1,"surface":"裒","kind":"person","person_id":"xke_dj3_6ba_AA","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line051:m0011","start":11,"end":13,"surface":"杜乂","kind":"person","person_id":"a2u_2ji_h68","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line051:m0025","start":25,"end":27,"surface":"桓彝","kind":"person","person_id":"t0p_jv4_1p6","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line051:m0034","start":34,"end":36,"surface":"季野","kind":"person","person_id":"xke_dj3_6ba_AA","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line051:m0058","start":58,"end":60,"surface":"謝安","kind":"person","person_id":"aa6_83c_juy_B","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line051:m0069","start":69,"end":70,"surface":"裒","kind":"person","person_id":"xke_dj3_6ba_AA","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line051:m0086","start":86,"end":89,"surface":"西陽王","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"卷七及五十九支持西陽王羕；待匯入亮之子羕的原文親屬斷言，再以司馬亮支正式配號，避免建立無可解析親屬路徑的家族 ID。"},{"id":"c-jinshu-093-chupou:line051:m0091","start":91,"end":93,"surface":"吳王","kind":"person","person_id":"qpk_4pt_y6r","status":"contextual_provisional","interpretation_note":"本紀咸和元年封皇弟岳為吳王、二年改琅邪王，與本傳蘇峻亂前任吳王文學及後文康帝為琅邪王相合；不據此倒定授官年。"},{"id":"c-jinshu-093-chupou:line051:m0096","start":96,"end":98,"surface":"蘇峻","kind":"person","person_id":"lrg_cze_g1l","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line051:m0107","start":107,"end":109,"surface":"郗鑒","kind":"person","person_id":"6lr_zci_i0j","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line051:m0110","start":110,"end":111,"surface":"裒","kind":"person","person_id":"xke_dj3_6ba_AA","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line051:m0115","start":115,"end":116,"surface":"峻","kind":"person","person_id":"lrg_cze_g1l","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line051:m0143","start":143,"end":145,"surface":"康帝","kind":"person","person_id":"qpk_4pt_y6r","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line051:m0146","start":146,"end":149,"surface":"琅邪王","kind":"person","person_id":"qpk_4pt_y6r","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line051:m0162","start":162,"end":163,"surface":"裒","kind":"person","person_id":"xke_dj3_6ba_AA","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line051:m0177","start":177,"end":179,"surface":"康帝","kind":"person","person_id":"qpk_4pt_y6r","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line051:m0246","start":246,"end":247,"surface":"裒","kind":"person","person_id":"xke_dj3_6ba_AA","status":"contextual_provisional"}],"source_position":{"first_line":51,"last_line":51,"revision_id":1548000,"editorial_excerpt_boundary":false},"chapter_id":"c-jinshu-093-chupou","book_id":"b-jinshu-093","work_id":"w-jinshu","source_id":"s-jinshu-093-chupou"},{"id":"c-jinshu-093-chupou:line053","text":"初，裒總角詣庾亮，亮使郭璞筮之。卦成，璞駭然，亮曰：「有不祥乎？」璞曰：「此非人臣卦，不知此年少何以乃表斯祥？二十年外，吾言方驗。」及此二十九年而康獻皇太后臨朝，有司以裒皇太后父，議加不臣之禮，拜侍中、衛將軍、錄尚書事，持節、都督、刺史如故。裒以近戚，懼獲譏嫌，上疏固請居籓，曰：「臣以虛鄙，才不周用，過蒙國恩，累忝非據。無勞受寵，負愧實深，豈可復加殊特之命，顯號重疊！臣有何勳可以克堪？何顏可以冒進？委身聖世，豈復遺力，實懼顛墜，所誤者大。今王略未振，萬機至殷，陛下宜委誠宰輔，一遵先帝任賢之道，虛己受成，坦平心於天下，無宜內示私親之舉，朝野失望，所損豈少！」於是改授都督徐兗青揚州之晉陵吳國諸軍事、衛將軍、徐兗二州刺史、假節、鎮京口。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-093-chupou:line053:m0002","start":2,"end":3,"surface":"裒","kind":"person","person_id":"xke_dj3_6ba_AA","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line053:m0006","start":6,"end":8,"surface":"庾亮","kind":"person","person_id":"kk2_p9l_dro","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line053:m0009","start":9,"end":10,"surface":"亮","kind":"person","person_id":"kk2_p9l_dro","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line053:m0011","start":11,"end":13,"surface":"郭璞","kind":"person","person_id":"2i5_4eo_tve","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line053:m0019","start":19,"end":20,"surface":"璞","kind":"person","person_id":"2i5_4eo_tve","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line053:m0023","start":23,"end":24,"surface":"亮","kind":"person","person_id":"kk2_p9l_dro","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line053:m0033","start":33,"end":34,"surface":"璞","kind":"person","person_id":"2i5_4eo_tve","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line053:m0073","start":73,"end":78,"surface":"康獻皇太后","kind":"person","person_id":"xke_dj3_6ba_AAB","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line053:m0084","start":84,"end":85,"surface":"裒","kind":"person","person_id":"xke_dj3_6ba_AA","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line053:m0085","start":85,"end":88,"surface":"皇太后","kind":"person","person_id":"xke_dj3_6ba_AAB","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line053:m0121","start":121,"end":122,"surface":"裒","kind":"person","person_id":"xke_dj3_6ba_AA","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line053:m0232","start":232,"end":234,"surface":"陛下","kind":"person","person_id":"xke_dj3_6ba_AAB","status":"contextual_provisional"},{"id":"c-jinshu-093-chupou:line053:m0242","start":242,"end":244,"surface":"先帝","kind":"person","person_id":"qpk_4pt_y6r","status":"contextual_provisional"}],"source_position":{"first_line":53,"last_line":53,"revision_id":1548000,"editorial_excerpt_boundary":false},"chapter_id":"c-jinshu-093-chupou","book_id":"b-jinshu-093","work_id":"w-jinshu","source_id":"s-jinshu-093-chupou"}],"sources":[{"chapter_id":"c-jinshu-032-chu-suanzi","work_id":"w-jinshu","book_id":"b-jinshu-032","source_id":"s-jinshu-032-chu-suanzi","source":{"title":"《晉書》卷32（康獻褚皇后傳）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?oldid=1543614","permalink":"https://zh.wikisource.org/w/index.php?oldid=1543614","revision_id":1543614,"accessed_on":"2026-10-19","extent":"康獻褚皇后完整六原段及數位注語；非全卷。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，底本影像未核","response_sha256":"662028853af3848a3f71cc750fcc290b8e5af62354baecdb3158bcb95f511f0a","wikitext_sha256":"82cd88cad08dac2b1bbb57371dc460a43806730b4da42c143f041374bd6866c5","normalization":{"character_conversion":{},"extraction_note":"展開年號模板，移除段首縮排，數位校勘注另存；未改原字。","excerpts":[{"proposed_paragraph_id":"c-jinshu-032-chu-suanzi:line040","source_lines":[40,40],"raw_quote":"　　康獻褚皇后諱蒜子，河南陽翟人也。父裒，見《外戚傳》。后聰明有器識，少以名家入為琅邪王妃。及康帝即位，立為皇后，封母謝氏為尋陽鄉君。","raw_quote_sha256":"1643944692230e47c515871e414fc4c5b4df92c171958f59c6263a0c0b3edc68","selected_text_sha256":"f9361bbecb2e2632233b10c7cf70f71674ef6882d699cf8ad7b649ad7cc4b82a","begin_anchor":"康獻褚皇后諱蒜子，河南陽翟人也。父裒","end_anchor":"即位，立為皇后，封母謝氏為尋陽鄉君。"},{"proposed_paragraph_id":"c-jinshu-032-chu-suanzi:line042","source_lines":[42,42],"raw_quote":"　　及穆帝即位，尊后曰皇太后。時帝幼沖，未親國政。領司徒蔡謨等上奏曰：「嗣皇誕哲岐嶷，繼承天統，率土宅心，兆庶蒙賴。陛下體茲坤道，訓隆文母。昔塗山光夏，簡狄熙殷，實由宣哲，以隆休祚。伏惟陛下德侔二媯，淑美關雎，臨朝攝政，以寧天下。今社稷危急，兆庶懸命，臣等章惶，一日萬機，事運之期，天祿所鍾，非復沖虛高讓之日。漢和熹、順烈，並亦臨朝，近明穆故事，以為先制。臣等不勝悲怖，謹伏地上請。乞陛下上順祖宗，下念臣吏，推公弘道，以協天人，則萬邦承慶，群黎更生。」太后詔曰：「帝幼沖，當賴群公卿士將順匡救，以酬先帝禮賢之意，且是舊德世濟之美，則莫重之命不墜，祖宗之基有奉，是其所以欲正位于內而已。所奏懇到，形于翰墨，執省未究，以悲以懼。先后允恭謙抑，思順坤道，所以不距群情，固為國計。豈敢執守沖闇，以違先旨。輒敬從所奏。」於是臨朝稱制。有司奏，謝夫人既封，荀、卞二夫人亦應追贈，皆后之前母也。太后不許。太常殷融議依鄭玄義，衛將軍裒在宮庭則盡臣敬，太后歸寧之日自如家人之禮。太后詔曰：「典禮誠所未詳，如所奏，是情所不能安也，更詳之。」征西將軍翼、南中郎尚議謂「父尊盡於一家，君敬重於天下，鄭玄義合情禮之中」。太后從之。自後朝臣皆敬裒焉。","raw_quote_sha256":"9e4d1aac1a45f30e3910ced3b14742002cfe59b142cf8c6933ca5fe968ea813a","selected_text_sha256":"485657cefa9fb705992094a25a7bb6329583541b27fe461b57466349bd622c9b","begin_anchor":"及穆帝即位，尊后曰皇太后。時帝幼沖，","end_anchor":"之中」。太后從之。自後朝臣皆敬裒焉。"},{"proposed_paragraph_id":"c-jinshu-032-chu-suanzi:line044","source_lines":[44,44],"raw_quote":"　　帝既冠，太后詔曰：「昔遭不造，帝在幼沖，皇緒之微，眇若贅旒。百辟卿士率遵前朝，勸喻攝政。以社稷之重，先代成義，僶俛敬從，弗遑固守。仰憑七廟之靈，俯仗群后之力，帝加元服，禮成德備，當陽親覽，臨御萬國。今歸事反政，一依舊典。」于是居崇德宮，手詔群公曰：「昔以皇帝幼沖，從群后之議，既以闇弱，又頻丁極艱，銜恤歷祀，沈憂在疚。司徒親尊德重，訓救其弊，王室之不壞，實公是憑。帝既備茲冠禮，而四海未一，五胡叛逆，豺狼當路，費役日興，百姓困苦。願諸君子思量遠算，戮力一心，輔翼幼主，匡救不逮。未亡人永歸別宮，以終餘齒。仰惟家國，故以一言託懷。」","raw_quote_sha256":"912e1f0ab6ae7c9c049a5890a2552edb86d4e7ff732f36386678ae9619789eeb","selected_text_sha256":"56647afd488c02ef801c9ee3033f2d55443488b8824f256eee789d283b7c9e0b","begin_anchor":"帝既冠，太后詔曰：「昔遭不造，帝在幼","end_anchor":"以終餘齒。仰惟家國，故以一言託懷。」"},{"proposed_paragraph_id":"c-jinshu-032-chu-suanzi:line046","source_lines":[46,46],"raw_quote":"　　及哀帝、海西公之世，太后復臨朝稱制<ref>「及哀帝、海西公之世，太后復臨朝稱制」李校：《哀帝紀》惟興寧二年帝以服藥致疾，崇德太后復臨朝攝政，至《海西公紀》不言有臨朝事，「世」字當是「際」字之誤。</ref>。桓溫之廢海西公也，太后方在佛屋燒香，內侍啟云「外有急奏」，太后乃出。尚倚戶前視奏數行，乃曰「我本自疑此」，至半便止，索筆答奏云：「未亡人罹此百憂，感念存沒，心焉如割。」溫始呈詔草，慮太后意異，悚動流汗，見于顏色。及詔出，溫大喜。","raw_quote_sha256":"74b73571300986be993a6f8e81b6447966e687b38a0c27e64cb2b544d77abbb5","selected_text_sha256":"f18963deb7b2fd3dadd18576a0665105a8cbee577b3c3691d6ca0616eff37e02","begin_anchor":"及哀帝、海西公之世，太后復臨朝稱制。","end_anchor":"悚動流汗，見于顏色。及詔出，溫大喜。","removed_digital_editorial_notes":[{"text":"「及哀帝、海西公之世，太后復臨朝稱制」李校：《哀帝紀》惟興寧二年帝以服藥致疾，崇德太后復臨朝攝政，至《海西公紀》不言有臨朝事，「世」字當是「際」字之誤。","text_layer":"modern_digital_apparatus","independently_verified":false}]},{"proposed_paragraph_id":"c-jinshu-032-chu-suanzi:line048","source_lines":[48,48],"raw_quote":"　　簡文帝即位，尊后為崇德太后。及帝崩，孝武帝幼沖，桓溫又薨。群臣啟曰：「王室多故，禍艱仍臻，國憂始周，復喪元輔，天下惘然，若無攸濟。主上雖聖資奇茂，固天誕縱。而春秋尚富，如在諒闇，蒸蒸之思，未遑庶事。伏惟陛下德應坤厚，宣慈聖善，遭家多艱，臨朝親覽。光大之美，化洽在昔，謳歌流詠，播溢無外。雖有莘熙殷，妊姒隆周，未足以喻。是以五謀克從，人鬼同心，仰望來蘇，懸心日月。夫隨時之義，周易所尚，寧固社稷，大人之任。伏願陛下撫綜萬機，釐和政道，以慰祖宗，以安兆庶。不勝憂國喁喁至誠。」太后詔曰：「王室不幸，仍有艱屯。覽省啟事，感增悲歎。內外諸君，並以主上春秋沖富，加蒸蒸之慕，未能親覽，號令宜有所由。苟可安社稷，利天下，亦豈有所執，輒敬從所啟。但闇昧之闕，望盡弼諧之道。」於是太后復臨朝。帝既冠，乃詔曰：「皇帝婚冠禮備，遐邇宅心，宜當陽親覽，緝熙惟始。今歸政事，率由舊典。」於是復稱崇德太后。","raw_quote_sha256":"5402b89f67bc88082f293691f05f62eb74261f1e59903d5ce1d86200cecf0159","selected_text_sha256":"b4d1d85d4376c564609b7062e2c943ae3c297df0d7c61a628382c89e2d2a59bf","begin_anchor":"簡文帝即位，尊后為崇德太后。及帝崩，","end_anchor":"政事，率由舊典。」於是復稱崇德太后。"},{"proposed_paragraph_id":"c-jinshu-032-chu-suanzi:line050","source_lines":[50,50],"raw_quote":"　　{{YL|太元九年}}，崩于顯陽殿，年六十一，在位凡四十年。太后於帝為從嫂，朝議疑其服。太學博士徐藻議曰：「資父事君而敬同。又禮云『其夫屬父道者，妻皆母道也』，則夫屬君道，妻亦后道矣。服后以齊，母之義也。魯譏逆祀，以明尊卑<ref>「以明尊卑」：《禮志·中》、《宋志·二》、《[[通典]]·八〇》、《[[文獻通考|通考]]·一二一》「尊卑」皆作「尊尊」，乃用穀梁傳文公二年「君子不以親親害尊尊」之義。徐藻、徐邈父子治穀梁，此作「尊尊」為是。</ref>。今上躬奉康、穆、哀皇及靖后之祀，致敬同于所天，豈可敬之以君道，而服廢於本親。謂應齊衰期。」從之。","raw_quote_sha256":"3e0b257e63ac1ac257bc338324fe266b5ad784b54150b2d0c348a2bac4b20c48","selected_text_sha256":"026ff8771f56b4edfe187d2fe1e96b105fcc69e92ef2fd1f92120a6ed7210ed9","begin_anchor":"太元九年，崩于顯陽殿，年六十一，在位","end_anchor":"，而服廢於本親。謂應齊衰期。」從之。","removed_digital_editorial_notes":[{"text":"「以明尊卑」：《禮志·中》、《宋志·二》、《[[通典]]·八〇》、《[[文獻通考|通考]]·一二一》「尊卑」皆作「尊尊」，乃用穀梁傳文公二年「君子不以親親害尊尊」之義。徐藻、徐邈父子治穀梁，此作「尊尊」為是。","text_layer":"modern_digital_apparatus","independently_verified":false}]}]}}},{"chapter_id":"c-jinshu-093-chupou","work_id":"w-jinshu","book_id":"b-jinshu-093","source_id":"s-jinshu-093-chupou","source":{"title":"《晉書》卷93（褚裒傳）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?oldid=1548000","permalink":"https://zh.wikisource.org/w/index.php?oldid=1548000","revision_id":1548000,"accessed_on":"2026-10-19","extent":"褚裒完整六原段；非全卷。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，底本影像未核","response_sha256":"6d02e6526fbe0ac37a60ed32fcf594cabcc23c07073038695f8605724923a893","wikitext_sha256":"8fc7f8b8a8a5a33a18c016006082a49f92e418f8fba965e1068b3e4e2016ff7e","normalization":{"character_conversion":{},"extraction_note":"展開年號模板、移除段首縮排；數位校勘注另存，未改原字。","excerpts":[{"proposed_paragraph_id":"c-jinshu-093-chupou:line049","source_lines":[49,49],"raw_quote":"　　褚裒，字季野，康獻皇后父也。祖䂮，有局量，以幹用稱。嘗為縣吏，事有不合，令欲鞭之，䂮曰：「物各有所施，榱椽之材不合以為籓落也，願明府垂察。」乃舍之。家貧，辭吏。年垂五十，鎮南將軍羊祜與䂮有舊，言于武帝，始被升用，官至安東將軍。父洽，武昌太守。","raw_quote_sha256":"50fd468e17ed43a89f2f8aaf107337998cef176ed52308dcc3c923a451f0dd02","selected_text_sha256":"40354c55703e1dd9eb707d3d24a832cadafe1a343522ab3310e3a1f860e8effc","begin_anchor":"褚裒，字季野，康獻皇后父也。祖䂮，有","end_anchor":"升用，官至安東將軍。父洽，武昌太守。"},{"proposed_paragraph_id":"c-jinshu-093-chupou:line051","source_lines":[51,51],"raw_quote":"　　裒少有簡貴之風，與京兆杜乂俱有盛名，冠于中興。譙國桓彝見而目之曰：「季野有皮裏春秋。」言其外無臧否，而內有所褒貶也。謝安亦雅重之，恆云：「裒雖不言，而四時之氣亦備矣。」初辟西陽王掾、吳王文學。蘇峻之構逆也，車騎將軍郗鑒以裒為參軍。峻平，以功封都鄉亭侯，稍遷司徒從事中郎，除給事黃門侍郎。康帝為琅邪王時，將納妃，妙選素望，詔娉裒女為妃，於是出為豫章太守。及康帝即位，徵拜侍中，遷尚書。以-{后}-父，苦求外出，除建威將軍、江州刺史，鎮半洲<ref>半洲　各本誤作「平州」，今從殿本。與庾懌傳合。</ref>。在官清約，雖居方伯，恆使私童樵採。頃之，徵為衛將軍，領中書令。裒以中書銓管詔命，不宜以姻戚居之，固讓，詔以為左將卦、兗州刺史、都督兗州徐州之琅邪諸軍事、假節，鎮金城，又領琅邪內史。","raw_quote_sha256":"a4152fdb88efe8c96087948b9e0d56fdda1987038474e5dcd5d9c59a37829fdc","selected_text_sha256":"a8a234ec5c0ff606cd420d920f112e89ac403a238582290e9eb30bcf5ada50c9","begin_anchor":"裒少有簡貴之風，與京兆杜乂俱有盛名，","end_anchor":"諸軍事、假節，鎮金城，又領琅邪內史。","removed_digital_editorial_notes":[{"text":"半洲　各本誤作「平州」，今從殿本。與庾懌傳合。","text_layer":"modern_digital_apparatus","independently_verified":false}]},{"proposed_paragraph_id":"c-jinshu-093-chupou:line053","source_lines":[53,53],"raw_quote":"　　初，裒總角詣庾亮，亮使郭璞筮之。卦成，璞駭然，亮曰：「有不祥乎？」璞曰：「此非人臣卦，不知此年少何以乃表斯祥？二十年外，吾言方驗。」及此二十九年而康獻皇太后臨朝，有司以裒皇太后父，議加不臣之禮，拜侍中、衛將軍、錄尚書事，持節、都督、刺史如故。裒以近戚，懼獲譏嫌，上疏固請居籓，曰：「臣以虛鄙，才不周用，過蒙國恩，累忝非據。無勞受寵，負愧實深，豈可復加殊特之命，顯號重疊！臣有何勳可以克堪？何顏可以冒進？委身聖世，豈復遺力，實懼顛墜，所誤者大。今王略未振，萬機至殷，陛下宜委誠宰輔，一遵先帝任賢之道，虛己受成，坦平心於天下，無宜內示私親之舉<ref>無宜內示私親之舉　「宜」，各本作「疑」，殿本作「宜」。周校：「無宜」猶「不宜」也。今從之。</ref>，朝野失望，所損豈少！」於是改授都督徐兗青揚州之晉陵吳國諸軍事、衛將軍、徐兗二州刺史、假節、鎮京口。","raw_quote_sha256":"dc5a2ea5a5bf87208266f12a0949c4bf5f77d3d528cfc9723d8a39ae9c198d5b","selected_text_sha256":"293a1caadca4101240b55ee653be82330dc7469a91a288ea9290a91bb23144ca","begin_anchor":"初，裒總角詣庾亮，亮使郭璞筮之。卦成","end_anchor":"衛將軍、徐兗二州刺史、假節、鎮京口。","removed_digital_editorial_notes":[{"text":"無宜內示私親之舉　「宜」，各本作「疑」，殿本作「宜」。周校：「無宜」猶「不宜」也。今從之。","text_layer":"modern_digital_apparatus","independently_verified":false}]},{"proposed_paragraph_id":"c-jinshu-093-chupou:line055","source_lines":[55,55],"raw_quote":"　　永和初，復徵裒，將以為揚州、錄尚書事。吏部尚書劉遐說裒曰：「會稽王令德，國之周公也，足下宜以大政付之。」裒長史王胡之亦勸焉，於是固辭歸籓，朝野咸嘆服之。進號征北大將軍、開府儀同三司，固辭開府。裒又以政道在於得才，宜委賢任能，升敬舊齒，乃薦前光祿大夫顧和、侍中殷浩。疏奏，即以和為尚書令，浩為揚州刺史。","raw_quote_sha256":"31305e205146290a8cdb79f0381ea5c28b8e37f1a0bd39ff7b26a5fae14470b2","selected_text_sha256":"5b6173c6a6c4ba635083b61468b05d1f1b1ad217da1b970d789722b9bfcc788e","begin_anchor":"永和初，復徵裒，將以為揚州、錄尚書事","end_anchor":"疏奏，即以和為尚書令，浩為揚州刺史。"},{"proposed_paragraph_id":"c-jinshu-093-chupou:line057","source_lines":[57,57],"raw_quote":"　　及石季龍死，裒上表請伐之，即日戒嚴，直指泗口。朝議以裒事任貴重，不宜深入，可先遣偏師。裒重陳前所遣前鋒督護王頤之等徑造彭城，示以威信，後遣督護麋嶷進軍下邳，賊即奔潰，嶷率所領據其城池，今宜速發，以成聲勢，於是除征討大都督青、揚、徐、兗、豫五州諸軍事。裒率眾三萬徑進彭城，河朔士庶歸降者日以千計，裒撫納之，甚得其歡心。先遣督護徐龕伐沛<ref>徐龕　考異：太山太守徐龕先已爲石勒所殺，當從穆紀作「王龕」。按：[[資治通鑑|通鑑]]九八亦作「王龕」。校文：此「徐」字疑本「王」之訛。</ref>，獲偽相支重，郡中二千餘人歸降。魯郡山有五百餘家，亦建義請援，裒遣龕領銳卒三千迎之。龕違裒節度，軍次代陂，為石遵將李菟所敗<ref>李菟　周校：穆紀及載記作「李農」。按：通鑑九八亦作「李農」。</ref>，死傷太半，龕執節不撓，為賊所害。裒以《[[春秋]]》責帥，授任失所，威略虧損，上疏自貶，以征北將軍行事，求留鎮廣陵。詔以偏帥之責，不應引咎，逋寇未殄，方鎮任重，不宜貶降，使還鎮京口，解征討都督。","raw_quote_sha256":"ae6f874cfae5c2724035121c4ec7b46f45ecccc99195fe88d4a676ecedea52c0","selected_text_sha256":"c94e62ef37fb2ef69081daae2489f16e6a67618266df41d3e16556115dcde7af","begin_anchor":"及石季龍死，裒上表請伐之，即日戒嚴，","end_anchor":"，不宜貶降，使還鎮京口，解征討都督。","removed_digital_editorial_notes":[{"text":"徐龕　考異：太山太守徐龕先已爲石勒所殺，當從穆紀作「王龕」。按：[[資治通鑑|通鑑]]九八亦作「王龕」。校文：此「徐」字疑本「王」之訛。","text_layer":"modern_digital_apparatus","independently_verified":false},{"text":"李菟　周校：穆紀及載記作「李農」。按：通鑑九八亦作「李農」。","text_layer":"modern_digital_apparatus","independently_verified":false}]},{"proposed_paragraph_id":"c-jinshu-093-chupou:line059","source_lines":[59,59],"raw_quote":"　　時石季龍新死，其國大亂，遺戶二十萬口渡河，將歸順，乞師救援。會裒已旋，威勢不接，莫能自拔，皆為慕容皝及苻健之眾所掠，死亡咸盡。裒以遠圖不就，憂慨發病。及至京口，聞哭聲甚眾，裒問：「何哭之多？」左右曰：「代陂之役也。」裒益慚恨。{{YL|永和五年}}卒，年四十七，遠近嗟悼，吏士哀慕之。贈侍中、太傅，本官如故，諡曰元穆。子歆，字幼安，以學行知名，歷散騎常侍、秘書監。","raw_quote_sha256":"e6f86ed56709ca292a0f8a9156e8f9558f22c472d3f531fb27d2cc8cead8e1f8","selected_text_sha256":"a3753d9019abc7019411fcae0331ca81ef68d6aa54ec79be8025a3ef8168208f","begin_anchor":"時石季龍新死，其國大亂，遺戶二十萬口","end_anchor":"安，以學行知名，歷散騎常侍、秘書監。"}]}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true}}
