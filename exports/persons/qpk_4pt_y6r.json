f":"data/corpus/jinshu/032-chu-suanzi.json"}]},{"id":"d-jinshu093-chupou-kang-predecessor","person_id":"qpk_4pt_y6r","surfaces":["先帝"],"scope":"same_chapter","chapter_ids":["c-jinshu-093-chupou"],"status":"contextual_provisional","confidence_level":"high","identification_basis":{"kind":"source_context","target_mention_ids":["c-jinshu-093-chupou:line053:m0242"]},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-093","source_id":"s-jinshu-093-chupou","chapter_id":"c-jinshu-093-chupou","paragraph_id":"c-jinshu-093-chupou:line053","quote_passage_ref":"data/corpus/jinshu/093-chupou.json"}],"rationale":"康獻太后臨朝、穆帝在位的疏文中先帝暫取康帝，與本傳前段康帝即位及后傳康穆交替相合；不作跨篇固定詞對照。","human_reviewed":false,"model":null,"references":[{"title":"《晉書》卷32（康獻褚皇后傳）","url":"https://zh.wikisource.org/w/index.php?oldid=1543614","source_revision":1543614,"work_id":"w-jinshu","book_id":"b-jinshu-032","chapter_id":"c-jinshu-032-chu-suanzi","source_id":"s-jinshu-032-chu-suanzi","paragraph_id":"c-jinshu-032-chu-suanzi:line042","scope":"native_received_parallel_passage","image_verified":false,"quote_passage_ref":"data/corpus/jinshu/032-chu-suanzi.json"}]},{"id":"d-jinshu093-chupou-wuwang-yue","person_id":"qpk_4pt_y6r","surfaces":["吳王"],"scope":"same_chapter","chapter_ids":["c-jinshu-093-chupou"],"status":"contextual_provisional","confidence_level":"high","identification_basis":{"kind":"source_context","target_mention_ids":["c-jinshu-093-chupou:line051:m0091"]},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-093","source_id":"s-jinshu-093-chupou","chapter_id":"c-jinshu-093-chupou","paragraph_id":"c-jinshu-093-chupou:line051","quote_passage_ref":"data/corpus/jinshu/093-chupou.json"}],"references":[{"title":"《晉書》卷七（成帝紀）","url":"https://zh.wikisource.org/w/index.php?title=晉書/卷007&oldid=2582704","source_revision":2582704,"work_id":"w-jinshu","book_id":"b-jinshu-007","quote":"冬十月，封魏武帝玄孫曹勵爲陳留王<ref>曹勱　宋本、[[藝文類聚|類聚]]五一、[[冊府元龜|冊府]]一七三、御覽二０一引晉中興書及[[通典]]七四「勱」並作「勵」。</ref>，以紹魏。丙寅，衛將軍、汝南王祐薨。己巳，封皇弟岳爲吳王。車騎將軍、南頓王宗有罪，伏誅，貶其族爲馬氏。免太宰、西陽王羕，降爲弋陽縣王。庚辰，赦百里內五歲以下刑。是月，劉曜將黃秀、帛成寇酂，平北將軍魏該帥衆奔襄陽。","scope":"external_received_parallel_passage","image_verified":false},{"title":"《晉書》卷七（成帝紀）","url":"https://zh.wikisource.org/w/index.php?title=晉書/卷007&oldid=2582704","source_revision":2582704,"work_id":"w-jinshu","book_id":"b-jinshu-007","quote":"十二月辛亥，蘇峻使其將韓晃入姑孰，屠于湖。壬子，彭城王雄、章武王休叛，奔峻。庚申，京師戒嚴。假護軍將軍庾亮節爲征討都督，以右衛將軍趙胤爲冠軍將軍、歷陽太守，使與左將軍司馬流帥師距峻，戰於慈湖，流敗，死之。假驍騎將軍鐘雅節，帥舟軍，與趙胤爲前鋒，以距峻。丙寅，徒封琅邪王昱爲會稽王，吳王岳爲琅邪王。辛未，宣城內桓彝及峻戰于蕪湖，彝軍敗績。軍騎將軍郗鑒遣廣陵相劉矩帥師赴京師。","scope":"external_received_parallel_passage","image_verified":false}],"rationale":"本紀咸和元年封皇弟岳為吳王、二年改封琅邪王；本傳初任吳王文學在蘇峻構逆以前，後文明康帝原為琅邪王，稱號沿革與時序互證。只辨府主人，不推算褚裒授官年份。","human_reviewed":false,"model":null}],"equivalence_decisions":[],"sources":[{"chapter_id":"c-jinshu-032-chu-suanzi","work_id":"w-jinshu","book_id":"b-jinshu-032","source_id":"s-jinshu-032-chu-suanzi","source_ref":"corpus/jinshu/032-chu-suanzi.json"},{"chapter_id":"c-jinshu-073-yu-yi-bing-tiao","work_id":"w-jinshu","book_id":"b-jinshu-073","source_id":"s-jinshu-073-yu-yi-bing-tiao","source_ref":"corpus/jinshu/073-yu-yi-bing-tiao.json"},{"chapter_id":"c-jinshu-075-taiyuan-wang","work_id":"w-jinshu","book_id":"b-jinshu-075","source_id":"s-jinshu-075-taiyuan-wang","source_ref":"corpus/jinshu/075-taiyuan-wang.json"},{"chapter_id":"c-jinshu-077-yinhao","work_id":"w-jinshu","book_id":"b-jinshu-077","source_id":"s-jinshu-077-yinhao","source_ref":"corpus/jinshu/077-yinhao.json"},{"chapter_id":"c-jinshu-093-chupou","work_id":"w-jinshu","book_id":"b-jinshu-093","source_id":"s-jinshu-093-chupou","source_ref":"corpus/jinshu/093-chupou.json"},{"chapter_id":"c-jinshu-098-huanwen","work_id":"w-jinshu","book_id":"b-jinshu-098","source_id":"s-jinshu-098-ws2614273","source_ref":"corpus/jinshu/098-huanwen.json"}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"c