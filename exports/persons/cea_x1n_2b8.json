ent_to_named_adopter","biological_father_person_id":null},"evidence":[{"work_id":"w-chenshu","book_id":"b-chenshu-008","source_id":"s-chenshu-008-zhouwenyu-born-and-adopted-names-ws1750028","chapter_id":"c-chenshu-008-zhouwenyu-born-and-adopted-names","paragraph_id":"c-chenshu-008-zhouwenyu-born-and-adopted-names:p003","quote":"薈哀之，乃隨文育至家，就其母請文育養為己子，母遂與之。","subject_person_mention_id":"c-chenshu-008-zhouwenyu-born-and-adopted-names:p003:m0015","object_person_mention_id":"c-chenshu-008-zhouwenyu-born-and-adopted-names:p003:m0000"}],"status":"source_attested","interpretation_note":"文育與其生母分別在場，周薈向生母請求收養並獲同意。收養不變更本生父系。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"title_holdings":[{"id":"th-nan023-wangzhi-m3-39","person_id":"cea_x1n_2b8","title":"都督","kind":"office","mode":"attestation","attestations":[{"id":"th-nan023-wangzhi-m3-39:a","person_mention_id":"c-nanshi-023-wangzhi-zizhen:p003:m0041","usage":"narrative","date_expression":null,"paragraph_id":"c-nanshi-023-wangzhi-zizhen:p003","surface":"都督","start":39,"end":41}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-023","source_id":"s-nanshi-023-wangzhi-zizhen-ws2478204","chapter_id":"c-nanshi-023-wangzhi-zizhen","paragraph_id":"c-nanshi-023-wangzhi-zizhen:p003","quote":"魏平荊州，侯瑱鎮盆城，與質不協，質率所部依於留異。陳永定二年，武帝命質率所部隨都督周文育討王琳。質與琳素善，或譖雲於軍中潛信交通，武帝命文育殺質，文育啟救之，獲免。文帝嗣位，以為五兵尚書。宣帝輔政，為司徒左長史。坐招聚博徒，免官。後為都官尚書。卒，諡曰安子。弟固。","person_mention_id":"c-nanshi-023-wangzhi-zizhen:p003:m0041"}],"status":"source_attested","interpretation_note":"按本見證原職名及其所屬人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"person_references":[{"id":"c-chenshu-008-zhouwenyu-born-and-adopted-names:p003:r0002","surface":"之","start":2,"end":3,"person_id":"cea_x1n_2b8","referent_role":"third_person","paragraph_id":"c-chenshu-008-zhouwenyu-born-and-adopted-names:p003","quote":"薈哀之，乃隨文育至家，就其母請文育養為己子，母遂與之。","note":"幼時的項猛奴，是敘事用後名文育所指的受養人。","chapter_id":"c-chenshu-008-zhouwenyu-born-and-adopted-names","book_id":"b-chenshu-008","work_id":"w-chenshu","source_id":"s-chenshu-008-zhouwenyu-born-and-adopted-names-ws1750028"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-chenshu-008-zhouwenyu-born-and-adopted-names:p001","text":"周文育字景德，義興陽羨人也。少孤貧，本居新安壽昌縣，姓項氏，名猛奴。","mentions":[{"id":"c-chenshu-008-zhouwenyu-born-and-adopted-names:p001:m0000","surface":"周文育","start":0,"end":3,"person_id":"cea_x1n_2b8","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-chenshu-008-zhouwenyu-born-and-adopted-names:p001:m0004","surface":"景德","start":4,"end":6,"person_id":"cea_x1n_2b8","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-chenshu-008-zhouwenyu-born-and-adopted-names:p001:m0031","surface":"猛奴","start":31,"end":33,"person_id":"cea_x1n_2b8","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":1750028,"source_layer":"received_biography","first_line":19,"last_line":19,"line_start":2,"line_end":36,"raw_start":1247,"raw_end":1281,"raw_character_offsets":[1247,1248,1249,1250,1251,1252,1253,1254,1255,1256,1257,1258,1259,1260,1261,1262,1263,1264,1265,1266,1267,1268,1269,1270,1271,1272,1273,1274,1275,1276,1277,1278,1279,1280],"projection_sha256":"30413b16823ca8b3d89c195356bfa74a326de5ab573b7e1c087c81e6bf991fbf"},"chapter_id":"c-chenshu-008-zhouwenyu-born-and-adopted-names","book_id":"b-chenshu-008","work_id":"w-chenshu","source_id":"s-chenshu-008-zhouwenyu-born-and-adopted-names-ws1750028"},{"id":"c-chenshu-008-zhouwenyu-born-and-adopted-names:p003","text":"薈哀之，乃隨文育至家，就其母請文育養為己子，母遂與之。","mentions"