onal","paragraph_id":"c-shiji-048-chenshe:p003","chapter_id":"c-shiji-048-chenshe"},{"id":"c-shiji-048-chenshe:m003-0017","start":17,"end":18,"surface":"廣","kind":"person","person_id":"cbr-p002980","status":"contextual_provisional","paragraph_id":"c-shiji-048-chenshe:p003","chapter_id":"c-shiji-048-chenshe"},{"id":"c-shiji-048-chenshe:m003-0041","start":41,"end":42,"surface":"廣","kind":"person","person_id":"cbr-p002980","status":"contextual_provisional","paragraph_id":"c-shiji-048-chenshe:p003","chapter_id":"c-shiji-048-chenshe"},{"id":"c-shiji-048-chenshe:m003-0047","start":47,"end":48,"surface":"廣","kind":"person","person_id":"cbr-p002980","status":"contextual_provisional","paragraph_id":"c-shiji-048-chenshe:p003","chapter_id":"c-shiji-048-chenshe"},{"id":"c-shiji-048-chenshe:m003-0179","start":179,"end":181,"surface":"吳廣","kind":"person","person_id":"cbr-p002980","status":"contextual_provisional","paragraph_id":"c-shiji-048-chenshe:p003","chapter_id":"c-shiji-048-chenshe"},{"id":"c-shiji-048-chenshe:m004-0027","start":27,"end":29,"surface":"吳叔","kind":"person","person_id":"cbr-p002980","status":"contextual_provisional","paragraph_id":"c-shiji-048-chenshe:p004","chapter_id":"c-shiji-048-chenshe"},{"id":"c-shiji-048-chenshe:m005-0051","start":51,"end":53,"surface":"吳廣","kind":"person","person_id":"cbr-p002980","status":"contextual_provisional","paragraph_id":"c-shiji-048-chenshe:p005","chapter_id":"c-shiji-048-chenshe"},{"id":"c-shiji-048-chenshe:m005-0068","start":68,"end":70,"surface":"吳叔","kind":"person","person_id":"cbr-p002980","status":"contextual_provisional","paragraph_id":"c-shiji-048-chenshe:p005","chapter_id":"c-shiji-048-chenshe"},{"id":"c-shiji-048-chenshe:m010-0097","start":97,"end":99,"surface":"吳叔","kind":"person","person_id":"cbr-p002980","status":"contextual_provisional","paragraph_id":"c-shiji-048-chenshe:p010","chapter_id":"c-shiji-048-chenshe"}],"relations":[],"title_holdings":[{"id":"th-shiji048-002","person_id":"cbr-p002980","title":"屯長","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-048-chenshe","source_id":"s-shiji-048-chenshe","paragraph_id":"c-shiji-048-chenshe:p002","quote":"二世元年七月，發閭左適戍漁陽，九百人屯大澤鄉。陳勝、吳廣皆次當行，為屯長。會天大雨，道不通，度已失期。失期，法皆斬。陳勝、吳廣乃謀曰：「今亡亦死，舉大計亦死，等死，死國可乎？」陳勝曰：「天下苦秦久矣。吾聞二世少子也，不當立，當立者乃公子扶蘇。扶蘇以數諫故，上使外將兵。今或聞無罪，二世殺之。百姓多聞其賢，未知其死也。項燕為楚將，數有功，愛士卒，楚人憐之。或以為死，或以為亡。今誠以吾眾詐自稱公子扶蘇、項燕，為天下唱，宜多應者。」吳廣以為然。乃行卜。卜者知其指意，曰：「足下事皆成，有功。然足下卜之鬼乎！」陳勝、吳廣喜，念鬼，曰：「此教我先威眾耳。」乃丹書帛曰「陳勝王」，置人所罾魚腹中。卒買魚烹食，得魚腹中書，固以怪之矣。又间令吳廣之次所旁叢祠中，夜篝火，狐鳴呼曰「大楚興，陳勝王」。卒皆夜驚恐。旦日，卒中往往語，皆指目陳勝。"}],"attestations":[{"id":"th-shiji048-002:a001","paragraph_id":"c-shiji-048-chenshe:p002","start":34,"end":36,"surface":"屯長","person_mention_id":"c-shiji-048-chenshe:m002-0026","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予、自立、既有用稱與冒稱分開；未知任期不由戰敗、被殺、歸報或首次提及推端點。詐稱與矯命不證合法或真實身份，制度種類仍待核。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji048-006","person_id":"cbr-p002980","title":"都尉","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-048-chenshe","source_id":"s-shiji-048-chenshe","paragraph_id":"c-shiji-048-chenshe:p003","quote":"吳廣素愛人，士卒多為用者。將尉醉，廣故數言欲亡，忿恚尉，令辱之，以激怒其眾。尉果笞廣。尉劍挺，廣起，奪而殺尉。陳勝佐之，并殺兩尉。召令徒屬曰：「公等遇雨，皆已失期，失期當斬。藉第令毋斬，而戍死者固十六七。且壯士不死即已，死即舉大名耳，王侯將相寧有種乎！」徒屬皆曰：「敬受命。」乃詐稱公子扶蘇、項燕，從民欲也。袒右，稱大楚。為壇而盟，祭以尉首。陳勝自立為將軍，吳廣為都尉。攻大澤鄉，收而攻蘄。蘄下，乃令符離人葛嬰將兵徇蘄以東。攻銍、酇、苦、柘、譙皆下之。行收兵。比至陳，車六七百乘，騎千余，卒數萬人。攻陳，陳守令皆不在，獨守丞與戰譙門中。弗勝，守丞死，乃入據陳。數日，號令召三老、豪傑與皆來會計事。三老、豪傑皆曰：「將軍身被堅執銳，伐無道，誅暴秦，復立楚國之社稷，功宜為王。」陳涉乃立為王，號為張楚。"}],"attestations":[{"id":"th-shiji048-006:a001","paragraph_id":"c-shiji-048-chenshe:p003","start":182,"end":184,"surface":"都尉","person_mention_id":"c-shiji-048-chenshe:m003-0179","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予、自立、既有用稱與冒稱分開；未知任期不由戰敗、被殺、歸報或首次提及推端點。詐稱與矯命不證合法或真實身份，制度種類仍待核。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji048-008","person_id":"cbr-p002980","title":"假王","kind":"unclassified","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-048-chenshe","source_id":"s-shiji-048-chenshe","paragraph_id":"c-shiji-048-chenshe:p004","quote":"當此時，諸郡縣苦秦吏者，皆刑其長吏，殺之以應陳涉。乃以吳叔為假王，監諸將以西擊滎陽。令陳人武臣、張耳、陳餘徇趙地，令汝陰人鄧宗徇九江郡。當此時，楚兵數千人為聚者，不可勝數。"}],"attestations":[{"id":"th-shiji048-008:a001","paragraph_id":"c-shiji-048-chenshe:p004","start":30,"end":32,"surface":"假王","person_mention_id":"c-shiji-048-chenshe:m004-0027","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-048-chenshe","source_id":"s-shiji-048-chenshe","paragraph_id":"c-shiji-048-chenshe:p004","quote":"當此時，諸郡縣苦秦吏者，皆刑其長吏，殺之以應陳涉。乃以吳叔為假王，監諸將以西擊滎陽。令陳人武臣、張耳、陳餘徇趙地，令汝陰人鄧宗徇九江郡。當此時，楚兵數千人為聚者，不可勝數。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予、自立、既有用稱與冒稱分開；未知任期不由戰敗、被殺、歸報或首次提及推端點。詐稱與矯命不證合法或真實身份，制度種類仍待核。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji048-018","person_id":"cbr-p002980","surfaces":["叔","吳叔","吳廣","廣"],"scope":"same_chapter","chapter_ids":["c-shiji-048-chenshe"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-048-chenshe:p001","quote":"陳勝者，陽城人也，字涉。吳廣者，陽夏人也，字叔。陳涉少時，嘗與人傭耕。輟耕之壟上，悵恨久之，曰：「苟富貴，無相忘。」傭者笑而應曰：「若為佣耕，何富貴也？」陳涉太息曰：「嗟乎，燕雀安知鴻鵠之志哉！」"},{"paragraph_id":"c-shiji-048-chenshe:p002","quote":"二世元年七月，發閭左適戍漁陽，九百人屯大澤鄉。陳勝、吳廣皆次當行，為屯長。會天大雨，道不通，度已失期。失期，法皆斬。陳勝、吳廣乃謀曰：「今亡亦死，舉大計亦死，等死，死國可乎？」陳勝曰：「天下苦秦久矣。吾聞二世少子也，不當立，當立者乃公子扶蘇。扶蘇以數諫故，上使外將兵。今或聞無罪，二世殺之。百姓多聞其賢，未知其死也。項燕為楚將，數有功，愛士卒，楚人憐之。或以為死，或以為亡。今誠以吾眾詐自稱公子扶蘇、項燕，為天下唱，宜多應者。」吳廣以為然。乃行卜。卜者知其指意，曰：「足下事皆成，有功。然足下卜之鬼乎！」陳勝、吳廣喜，念鬼，曰：「此教我先威眾耳。」乃丹書帛曰「陳勝王」，置人所罾魚腹中。卒買魚烹食，得魚腹中書，固以怪之矣。又间令吳廣之次所旁叢祠中，夜篝火，狐鳴呼曰「大楚興，陳勝王」。卒皆夜驚恐。旦日，卒中往往語，皆指目陳勝。"},{"paragraph_id":"c-shiji-048-chenshe:p003","quote":"吳廣素愛人，士卒多為用者。將尉醉，廣故數言欲亡，忿恚尉，令辱之，以激怒其眾。尉果笞廣。尉劍挺，廣起，奪而殺尉。陳勝佐之，并殺兩尉。召令徒屬曰：「公等遇雨，皆已失期，失期當斬。藉第令毋斬，而戍死者固十六七。且壯士不死即已，死即舉大名耳，王侯將相寧有種乎！」徒屬皆曰：「敬受命。」乃詐稱公子扶蘇、項燕，從民欲也。袒右，稱大楚。為壇而盟，祭以尉首。陳勝自立為將軍，吳廣為都尉。攻大澤鄉，收而攻蘄。蘄下，乃令符離人葛嬰將兵徇蘄以東。攻銍、酇、苦、柘、譙皆下之。行收兵。比至陳，車六七百乘，騎千余，卒數萬人。攻陳，陳守令皆不在，獨守丞與戰譙門中。弗勝，守丞死，乃入據陳。數日，號令召三老、豪傑與皆來會計事。三老、豪傑皆曰：「將軍身被堅執銳，伐無道，誅暴秦，復立楚國之社稷，功宜為王。」陳涉乃立為王，號為張楚。"},{"paragraph_id":"c-shiji-048-chenshe:p004","quote":"當此時，諸郡縣苦秦吏者，皆刑其長吏，殺之以應陳涉。乃以吳叔為假王，監諸將以西擊滎陽。令陳人武臣、張耳、陳餘徇趙地，令汝陰人鄧宗徇九江郡。當此時，楚兵數千人為聚者，不可勝數。"},{"paragraph_id":"c-shiji-048-chenshe:p005","quote":"葛嬰至東城，立襄彊為楚王。嬰後聞陳王已立，因殺襄彊，還報。至陳，陳王誅殺葛嬰。陳王令魏人周市北徇魏地。吳廣圍滎陽。李由為三川守，守滎陽，吳叔弗能下。陳王徵國之豪傑與計，以上蔡人房君蔡賜為上柱國。"},{"paragraph_id":"c-shiji-048-chenshe:p010","quote":"將軍田臧等相與謀曰：「周章軍已破矣，秦兵旦暮至，我圍滎陽城弗能下，秦軍至，必大敗。不如少遺兵，足以守熒一作「滎」陽，悉精兵迎秦軍。今假王驕，不知兵權，不可與計，非誅之，事恐敗。」因相與矯王令以誅吳叔，獻其首於陳王。陳王使使賜田臧楚令尹印，使為上將。田臧乃使諸將李歸等守滎陽城，自以精兵西迎秦軍於敖倉。與戰，田臧死，軍破。章邯進兵擊李歸等滎陽下，破之，李歸等死。"}],"rationale":"限明示名、字及局部軍事角色；陳勝涉、吳廣叔、蔡賜房君與周文周章暫接，吳廣韓廣分開。引文四君短稱及比擬人物另留候選，詐稱扶蘇項燕不合陳吳，褚賈署稱不補姓名。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-048-chenshe:p001","text":"陳勝者，陽城人也，字涉。吳廣者，陽夏人也，字叔。陳涉少時，嘗與人傭耕。輟耕之壟上，悵恨久之，曰：「苟富貴，無相忘。」傭者笑而應曰：「若為佣耕，何富貴也？」陳涉太息曰：「嗟乎，燕雀安知鴻鵠之志哉！」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-048-chenshe:m001-0000","start":0,"end":2,"surface":"陳勝","kind":"person","person_id":"cbr-p002979","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m001-0010","start":10,"end":11,"surface":"涉","kind":"person","person_id":"cbr-p002979","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m001-0012","start":12,"end":14,"surface":"吳廣","kind":"person","person_id":"cbr-p002980","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m001-0022","start":22,"end":23,"surface":"叔","kind":"person","person_id":"cbr-p002980","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m001-0024","start":24,"end":26,"surface":"陳涉","kind":"person","person_id":"cbr-p002979","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m001-0058","start":58,"end":60,"surface":"傭者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱、對話或未名者待核；普通動詞、詐稱與矯命不當真實人物身份。"},{"id":"c-shiji-048-chenshe:m001-0077","start":77,"end":79,"surface":"陳涉","kind":"person","person_id":"cbr-p002979","status":"contextual_provisional"}],"chapter_id":"c-shiji-048-chenshe","book_id":"b-shiji-048","work_id":"w-shiji","source_id":"s-shiji-048-chenshe"},{"id":"c-shiji-048-chenshe:p002","text":"二世元年七月，發閭左適戍漁陽，九百人屯大澤鄉。陳勝、吳廣皆次當行，為屯長。會天大雨，道不通，度已失期。失期，法皆斬。陳勝、吳廣乃謀曰：「今亡亦死，舉大計亦死，等死，死國可乎？」陳勝曰：「天下苦秦久矣。吾聞二世少子也，不當立，當立者乃公子扶蘇。扶蘇以數諫故，上使外將兵。今或聞無罪，二世殺之。百姓多聞其賢，未知其死也。項燕為楚將，數有功，愛士卒，楚人憐之。或以為死，或以為亡。今誠以吾眾詐自稱公子扶蘇、項燕，為天下唱，宜多應者。」吳廣以為然。乃行卜。卜者知其指意，曰：「足下事皆成，有功。然足下卜之鬼乎！」陳勝、吳廣喜，念鬼，曰：「此教我先威眾耳。」乃丹書帛曰「陳勝王」，置人所罾魚腹中。卒買魚烹食，得魚腹中書，固以怪之矣。又间令吳廣之次所旁叢祠中，夜篝火，狐鳴呼曰「大楚興，陳勝王」。卒皆夜驚恐。旦日，卒中往往語，皆指目陳勝。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-048-chenshe:m002-0000","start":0,"end":2,"surface":"二世","kind":"person","person_id":"cbr-p002981","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m002-0015","start":15,"end":18,"surface":"九百人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱、對話或未名者待核；普通動詞、詐稱與矯命不當真實人物身份。"},{"id":"c-shiji-048-chenshe:m002-0023","start":23,"end":25,"surface":"陳勝","kind":"person","person_id":"cbr-p002979","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m002-0026","start":26,"end":28,"surface":"吳廣","kind":"person","person_id":"cbr-p002980","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m002-0058","start":58,"end":60,"surface":"陳勝","kind":"person","person_id":"cbr-p002979","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m002-0061","start":61,"end":63,"surface":"吳廣","kind":"person","person_id":"cbr-p002980","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m002-0088","start":88,"end":