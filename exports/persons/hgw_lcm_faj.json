d":"hgw_lcm_faj","predicate":"mother","qualifiers":{"source_term":"禕、儀以其母"},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-048","chapter_id":"c-sanguozhi-048-sun-liang","source_id":"s-sanguozhi-048-sun-liang-ws2085142","paragraph_id":"c-sanguozhi-048-sun-liang:p014","quote":"五月，魏征東大將軍諸葛誕以淮南之衆保壽春城，遣將軍朱成稱臣上疏，又遣子靚、長史吳綱諸牙門子弟爲質。六月，使文欽、唐咨、全端等步騎三萬救誕。朱異自虎林率衆襲夏口，夏口督孫壹奔魏。秋七月，綝率衆救壽春，次于鑊里，朱異至自夏口，綝使異爲前部督，與丁奉等將介士五萬解圍。八月，會稽南部反，殺都尉。鄱陽、新都民爲亂，廷尉丁密、步兵校尉鄭胄、將軍鍾離牧率軍討之。朱異以軍士乏食引還，綝大怒，九月朔己巳，殺異於鑊里。辛未，綝自鑊里還建業。甲申，大赦。十一月，全緒子禕、儀以其母奔魏。十二月，全端、懌等自壽春城詣司馬文王。","subject_person_mention_id":"c-sanguozhi-048-sun-liang:p014:m0225","object_person_mention_id":"c-sanguozhi-048-sun-liang:p014:m0229"}],"status":"source_attested","interpretation_note":"依固定見證同段親屬原詞及所屬敘事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"a-wu048-yi2-mother","subject_person_id":"s8g_w4d_sl2","object_person_id":"hgw_lcm_faj","predicate":"mother","qualifiers":{"source_term":"禕、儀以其母"},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-048","chapter_id":"c-sanguozhi-048-sun-liang","source_id":"s-sanguozhi-048-sun-liang-ws2085142","paragraph_id":"c-sanguozhi-048-sun-liang:p014","quote":"五月，魏征東大將軍諸葛誕以淮南之衆保壽春城，遣將軍朱成稱臣上疏，又遣子靚、長史吳綱諸牙門子弟爲質。六月，使文欽、唐咨、全端等步騎三萬救誕。朱異自虎林率衆襲夏口，夏口督孫壹奔魏。秋七月，綝率衆救壽春，次于鑊里，朱異至自夏口，綝使異爲前部督，與丁奉等將介士五萬解圍。八月，會稽南部反，殺都尉。鄱陽、新都民爲亂，廷尉丁密、步兵校尉鄭胄、將軍鍾離牧率軍討之。朱異以軍士乏食引還，綝大怒，九月朔己巳，殺異於鑊里。辛未，綝自鑊里還建業。甲申，大赦。十一月，全緒子禕、儀以其母奔魏。十二月，全端、懌等自壽春城詣司馬文王。","subject_person_mention_id":"c-sanguozhi-048-sun-liang:p014:m0227","object_person_mention_id":"c-sanguozhi-048-sun-liang:p014:m0229"}],"status":"source_attested","interpretation_note":"依固定見證同段親屬原詞及所屬敘事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-048-sun-liang:p014:m0229","surface":"其母","start":229,"end":231,"kind":"person","person_id":"hg