,"text":"太史公曰：深惟士之游宦所以至封侯者，微甚。然多至御史大夫即去者。諸為大夫而丞相次也，其心冀幸丞相物故也。或乃陰私相毀害，欲代之。然守之日久不得，或為之日少而得之，至於封侯，真命也夫！御史大夫鄭君守之數年不得，匡君居之未滿歲，而韋丞相死，即代之矣，豈可以智巧得哉！多有賢聖之才，困妯囡者眾甚也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhang:m029-0000","start":0,"end":3,"surface":"太史公","kind":"person","person_id":"2ed_ew8_szv","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m029-0095","start":95,"end":97,"surface":"鄭君","kind":"person","person_id":"33z_av8_anq","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m029-0104","start":104,"end":106,"surface":"匡君","kind":"person","person_id":"484_day_gmv","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m029-0113","start":113,"end":116,"surface":"韋丞相","kind":"person","person_id":"vna_am7_jn5_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-096-zhang","book_id":"b-shiji-096","work_id":"w-shiji","source_id":"s-shiji-096-zhang"}],"sources":[{"chapter_id":"c-shiji-096-zhang","work_id":"w-shiji","book_id":"b-shiji-096","source_id":"s-shiji-096-zhang","source":{"title":"史記／卷096","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷096","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷096&oldid=8770206","revision_id":8770206,"accessed_on":"2026-10-09","extent":"29段傳世文字含兩處太史公論，另附1段分層索隱述贊；首HTML區塊即正文，不刪頭2段。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"固定HTML一致，只去外緣空白；亨周苛、（不）、困妯囡及邴丞相等原字保留。","note":"全30個HTML區塊已讀，未核底本影像。後段征和以後丞相記述在此見證未署補作者，不冒署褚先生。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical"}}
