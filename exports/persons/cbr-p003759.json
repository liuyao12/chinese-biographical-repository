64-sima:p001","chapter_id":"c-shiji-064-sima"},{"id":"c-shiji-064-sima:m001-0312","start":312,"end":314,"surface":"穰苴","kind":"person","person_id":"cbr-p003759","status":"contextual_provisional","paragraph_id":"c-shiji-064-sima:p001","chapter_id":"c-shiji-064-sima"},{"id":"c-shiji-064-sima:m001-0475","start":475,"end":477,"surface":"穰苴","kind":"person","person_id":"cbr-p003759","status":"contextual_provisional","paragraph_id":"c-shiji-064-sima:p001","chapter_id":"c-shiji-064-sima"},{"id":"c-shiji-064-sima:m001-0518","start":518,"end":520,"surface":"穰苴","kind":"person","person_id":"cbr-p003759","status":"contextual_provisional","paragraph_id":"c-shiji-064-sima:p001","chapter_id":"c-shiji-064-sima"},{"id":"c-shiji-064-sima:m001-0708","start":708,"end":710,"surface":"穰苴","kind":"person","person_id":"cbr-p003759","status":"contextual_provisional","paragraph_id":"c-shiji-064-sima:p001","chapter_id":"c-shiji-064-sima"},{"id":"c-shiji-064-sima:m002-0023","start":23,"end":25,"surface":"穰苴","kind":"person","person_id":"cbr-p003759","status":"contextual_provisional","paragraph_id":"c-shiji-064-sima:p002","chapter_id":"c-shiji-064-sima"},{"id":"c-shiji-064-sima:m002-0026","start":26,"end":27,"surface":"苴","kind":"person","person_id":"cbr-p003759","status":"contextual_provisional","paragraph_id":"c-shiji-064-sima:p002","chapter_id":"c-shiji-064-sima"},{"id":"c-shiji-064-sima:m002-0087","start":87,"end":89,"surface":"穰苴","kind":"person","person_id":"cbr-p003759","status":"contextual_provisional","paragraph_id":"c-shiji-064-sima:p002","chapter_id":"c-shiji-064-sima"},{"id":"c-shiji-064-sima:m003-0016","start":16,"end":18,"surface":"穰苴","kind":"person","person_id":"cbr-p003759","status":"contextual_provisional","paragraph_id":"c-shiji-064-sima:p003","chapter_id":"c-shiji-064-sima"},{"id":"c-shiji-064-sima:m004-0041","start":41,"end":43,"surface":"穰苴","kind":"person","person_id":"cbr-p003759","status":"contextual_provisional","paragraph_id":"c-shiji-064-sima:p004","chapter_id":"c-shiji-064-sima"},{"id":"c-shiji-064-sima:m004-0078","start":78,"end":80,"surface":"穰苴","kind":"person","person_id":"cbr-p003759","status":"contextual_provisional","paragraph_id":"c-shiji-064-sima:p004","chapter_id":"c-shiji-064-sima"},{"id":"c-shiji-065-sun:m008-0044","start":44,"end":48,"surface":"司馬穰苴","kind":"person","person_id":"cbr-p003787","status":"contextual_provisional","paragraph_id":"c-shiji-065-sun:p008","chapter_id":"c-shiji-065-sun"}],"relations":[{"id":"a-shiji064-001","subject_person_id":"cbr-p003759","predicate":"ancestor","object_person_id":"cbr-p003760","status":"source_attested","evidence":[{"chapter_id":"c-shiji-064-sima","source_id":"s-shiji-064-sima","paragraph_id":"c-shiji-064-sima:p001","quote":"司馬穰苴者，田完之苗裔也。齊景公時，晉伐阿、甄，而燕侵河上，齊師敗績。景公患之。晏嬰乃薦田穰苴曰：「穰苴雖田氏庶孽，然其人文能附眾，武能威敵，願君試之。」景公召穰苴，與語兵事，大說之，以為將軍，將兵捍燕晉之師。穰苴曰：「臣素卑賤，君擢之閭伍之中，加之大夫之上，士卒未附，百姓不信，人微權輕，願得君之寵臣，國之所尊，以監軍，乃可。」於是景公許之，使莊賈往。穰苴既辭，與莊賈約曰：「旦日日中會於軍門。」穰苴先馳至軍，立表下漏待賈。賈素驕貴，以為將己之軍而己為監，不甚急；親戚左右送之，留飲。日中而賈不至。穰苴則仆表決漏，入，行軍勒兵，申明約束。約束既定，夕時，莊賈乃至。穰苴曰：「何後期為？」賈謝曰：「不佞大夫親戚送之，故留。」穰苴曰：「將受命之日則忘其家，臨軍約束則忘其親，援枹鼓之急則忘其身。今敵國深侵，邦內騷動，士卒暴露於境，君寢不安席，食不甘味，百姓之命皆懸於君，何謂相送乎！」召軍正問曰：「軍法期而後至者云何？」對曰：「當斬。」莊賈懼，使人馳報景公，請救。既往，未及反，於是遂斬莊賈以徇三軍。三軍之士皆振慄。久之，景公遣使者持節赦賈，馳入軍中。穰苴曰：「將在軍，君令有所不受。」問軍正曰：「馳三軍法何？」正曰：「當斬。」使者大懼。穰苴曰：「君之使不可殺之。」乃斬其僕、車之左駙、馬之左驂，以徇三軍。遣使者還報，然後行。士卒次舍井灶飲食問疾醫藥，身自拊循之。悉取將軍之資糧享士卒，身與士卒平分糧食。最比其羸弱者，三日而後勒兵。病者皆求行，爭奮出為之赴戰。晉師聞之，為罷去。燕師聞之，度水而解。於是追擊之，遂取所亡封內故境而引兵歸。未至國，釋兵旅，解約束，誓盟而後入邑。景公與諸大夫郊迎，勞師成禮，然後反歸寢。既見穰苴，尊為大司馬。田氏日以益尊於齊。"}],"qualifiers":{"source_term":"田完之苗裔","historicity":"historical_tradition"},"interpretation_note":"只記明示祖先與原文苗裔或曾孫，不補直接父子或闕代。和與齊威王身份及世系仍待核版本，來源陳述不當獨立史實確證。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji064-001","person_id":"cbr-p003759","title":"將軍","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-064-sima","source_id":"s-shiji-064-sima","paragraph_id":"c-shiji-064-sima:p001","quote":"司馬穰苴者，田完之苗裔也。齊景公時，晉伐阿、甄，而燕侵河上，齊師敗績。景公患之。晏嬰乃薦田穰苴曰：「穰苴雖田氏庶孽，然其人文能附眾，武能威敵，願君試之。」景公召穰苴，與語兵事，大說之，以為將軍，將兵捍燕晉之師。穰苴曰：「臣素卑賤，君擢之閭伍之中，加之大夫之上，士卒未附，百姓不信，人微權輕，願得君之寵臣，國之所尊，以監軍，乃可。」於是景公許之，使莊賈往。穰苴既辭，與莊賈約曰：「旦日日中會於軍門。」穰苴先馳至軍，立表下漏待賈。賈素驕貴，以為將己之軍而己為監，不甚急；親戚左右送之，留飲。日中而賈不至。穰苴則仆表決漏，入，行軍勒兵，申明約束。約束既定，夕時，莊賈乃至。穰苴曰：「何後期為？」賈謝曰：「不佞大夫親戚送之，故留。」穰苴曰：「將受命之日則忘其家，臨軍約束則忘其親，援枹鼓之急則忘其身。今敵國深侵，邦內騷動，士卒暴露於境，君寢不安席，食不甘味，百姓之命皆懸於君，何謂相送乎！」召軍正問曰：「軍法期而後至者云何？」對曰：「當斬。」莊賈懼，使人馳報景公，請救。既往，未及反，於是遂斬莊賈以徇三軍。三軍之士皆振慄。久之，景公遣使者持節赦賈，馳入軍中。穰苴曰：「將在軍，君令有所不受。」問軍正曰：「馳三軍法何？」正曰：「當斬。」使者大懼。穰苴曰：「君之使不可殺之。」乃斬其僕、車之左駙、馬之左驂，以徇三軍。遣使者還報，然後行。士卒次舍井灶飲食問疾醫藥，身自拊循之。悉取將軍之資糧享士卒，身與士卒平分糧食。最比其羸弱者，三日而後勒兵。病者皆求行，爭奮出為之赴戰。晉師聞之，為罷去。燕師聞之，度水而解。於是追擊之，遂取所亡封內故境而引兵歸。未至國，釋兵旅，解約束，誓盟而後入邑。景公與諸大夫郊迎，勞師成禮，然後反歸寢。既見穰苴，尊為大司馬。田氏日以益尊於齊。"}],"attestations":[{"id":"th-shiji064-001:a001","paragraph_id":"c-shiji-064-sima:p001","start":94,"end":96,"surface":"將軍","person_mention_id":"c-shiji-064-sima:m001-0105","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-064-sima","source_id":"s-shiji-064-sima","paragraph_id":"c-shiji-064-sima:p001","quote":"司馬穰苴者，田完之苗裔也。齊景公時，晉伐阿、甄，而燕侵河上，齊師敗績。景公患之。晏嬰乃薦田穰苴曰：「穰苴雖田氏庶孽，然其人文能附眾，武能威敵，願君試之。」景公召穰苴，與語兵事，大說之，以為將軍，將兵捍燕晉之師。穰苴曰：「臣素卑賤，君擢之閭伍之中，加之大夫之上，士卒未附，百姓不信，人微權輕，願得君之寵臣，國之所尊，以監軍，乃可。」於是景公許之，使莊賈往。穰苴既辭，與莊賈約曰：「旦日日中會於軍門。」穰苴先馳至軍，立表下漏待賈。賈素驕貴，以為將己之軍而己為監，不甚急；親戚左右送之，留飲。日中而賈不至。穰苴則仆表決漏，入，行軍勒兵，申明約束。約束既定，夕時，莊賈乃至。穰苴曰：「何後期為？」賈謝曰：「不佞大夫親戚送之，故留。」穰苴曰：「將受命之日則忘其家，臨軍約束則忘其親，援枹鼓之急則忘其身。今敵國深侵，邦內騷動，士卒暴露於境，君寢不安席，食不甘味，百姓之命皆懸於君，何謂相送乎！」召軍正問曰：「軍法期而後至者云何？」對曰：「當斬。」莊賈懼，使人馳報景公，請救。既往，未及反，於是遂斬莊賈以徇三軍。三軍之士皆振慄。久之，景公遣使者持節赦賈，馳入軍中。穰苴曰：「將在軍，君令有所不受。」問軍正曰：「馳三軍法何？」正曰：「當斬。」使者大懼。穰苴曰：「君之使不可殺之。」乃斬其僕、車之左駙、馬之左驂，以徇三軍。遣使者還報，然後行。士卒次舍井灶飲食問疾醫藥，身自拊循之。悉取將軍之資糧享士卒，身與士卒平分糧食。最比其羸弱者，三日而後勒兵。病者皆求行，爭奮出為之赴戰。晉師聞之，為罷去。燕師聞之，度水而解。於是追擊之，遂取所亡封內故境而引兵歸。未至國，釋兵旅，解約束，誓盟而後入邑。景公與諸大夫郊迎，勞師成禮，然後反歸寢。既見穰苴，尊為大司馬。田氏日以益尊於齊。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授任與來源用稱分存；首次提及、被斬或發疾而死不補稱號起訖。景公退穰苴的適用職位未定，將軍及大司馬任期終點仍保留未知。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji064-002","person_id":"cbr-p003759",