id":"c-shiji-064-sima:m002-0020","start":20,"end":22,"surface":"景公","kind":"person","person_id":"cbr-p003761","status":"contextual_provisional"},{"id":"c-shiji-064-sima:m002-0023","start":23,"end":25,"surface":"穰苴","kind":"person","person_id":"cbr-p003759","status":"contextual_provisional"},{"id":"c-shiji-064-sima:m002-0026","start":26,"end":27,"surface":"苴","kind":"person","person_id":"cbr-p003759","status":"contextual_provisional"},{"id":"c-shiji-064-sima:m002-0032","start":32,"end":34,"surface":"田乞","kind":"person","person_id":"cbr-p003767","status":"contextual_provisional"},{"id":"c-shiji-064-sima:m002-0035","start":35,"end":37,"surface":"田豹","kind":"person","person_id":"cbr-p003768","status":"contextual_provisional"},{"id":"c-shiji-064-sima:m002-0042","start":42,"end":46,"surface":"高、國等","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、族稱、泛稱或未定指代；不補姓名或成員。"},{"id":"c-shiji-064-sima:m002-0050","start":50,"end":52,"surface":"田常","kind":"person","person_id":"cbr-p003769","status":"contextual_provisional"},{"id":"c-shiji-064-sima:m002-0053","start":53,"end":55,"surface":"簡公","kind":"person","person_id":"cbr-p003770","status":"contextual_provisional"},{"id":"c-shiji-064-sima:m002-0058","start":58,"end":65,"surface":"高子、國子之族","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、族稱、泛稱或未定指代；不補姓名或成員。"},{"id":"c-shiji-064-sima:m002-0067","start":67,"end":68,"surface":"常","kind":"person","person_id":"cbr-p003769","status":"contextual_provisional"},{"id":"c-shiji-064-sima:m002-0070","start":70,"end":71,"surface":"和","kind":"person","person_id":"cbr-p003771","status":"contextual_provisional"},{"id":"c-shiji-064-sima:m002-0076","start":76,"end":79,"surface":"齊威王","kind":"person","person_id":"cbr-p003771","status":"contextual_provisional"},{"id":"c-shiji-064-sima:m002-0087","start":87,"end":89,"surface":"穰苴","kind":"person","person_id":"cbr-p003759","status":"contextual_provisional"},{"id":"c-shiji-064-sima:m002-0093","start":93,"end":95,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、族稱、泛稱或未定指代；不補姓名或成員。"}],"chapter_id":"c-shiji-064-sima","book_id":"b-shiji-064","work_id":"w-shiji","source_id":"s-shiji-064-sima"},{"id":"c-shiji-064-sima:p003","text":"齊威王使大夫追論古者司馬兵法而附穰苴於其中，因號曰司馬穰苴兵法。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-064-sima:m003-0000","start":0,"end":3,"surface":"齊威王","kind":"person","person_id":"cbr-p003771","status":"contextual_provisional"},{"id":"c-shiji-064-sima:m003-0004","start":4,"end":6,"surface":"大夫","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、族稱、泛稱或未定指代；不補姓名或成員。"},{"id":"c-shiji-064-sima:m003-0016","start":16,"end":18,"surface":"穰苴","kind":"person","person_id":"cbr-p003759","status":"contextual_provisional"}],"chapter_id":"c-shiji-064-sima","book_id":"b-shiji-064","work_id":"w-shiji","source_id":"s-shiji-064-sima"},{"id":"c-shiji-064-sima:p004","text":"太史公曰：余讀司馬兵法，閎廓深遠，雖三代征伐，未能竟其義，如其文也，亦少褒矣。若夫穰苴，區區為小國行師，何暇及司馬兵法之揖讓乎？世既多司馬兵法，以故不論，著穰苴之列傳焉。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-064-sima:m004-0000","start":0,"end":3,"surface":"太史公","kind":"person","person_id":"cbr-p003772","status":"contextual_provisional"},{"id":"c-shiji-064-sima:m004-0041","start":41,"end":43,"surface":"穰苴","kind":"person","person_id":"cbr-p003759","status":"contextual_provisional"},{"id":"c-shiji-064-sima:m004-0064","start":64,"end":65,"surface":"世","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、族稱、泛稱或未定指代；不補姓名或成員。"},{"id":"c-shiji-064-sima:m004-0078","start":78,"end":80,"surface":"穰苴","kind":"person","person_id":"cbr-p003759","status":"contextual_provisional"}],"chapter_id":"c-shiji-064-sima","book_id":"b-shiji-064","work_id":"w-shiji","source_id":"s-shiji-064-sima"},{"id":"c-shiji-065-sun:p008","text":"吳起於是聞魏文侯賢，欲事之。文侯問李克曰：「吳起何如人哉？」李克曰：「起貪而好色，然用兵司馬穰苴不能過也。」於是魏文侯以為將，擊秦，拔五城。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-065-sun:m008-0000","start":0,"end":2,"surface":"吳起","kind":"person","person_id":"cbr-p003782","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m008-0005","start":5,"end":8,"surface":"魏文侯","kind":"person","person_id":"cbr-p003785","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m008-0014","start":14,"end":16,"surface":"文侯","kind":"person","person_id":"cbr-p003785","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m008-0017","start":17,"end":19,"surface":"李克","kind":"person","person_id":"cbr-p003786","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m008-0022","start":22,"end":24,"surface":"吳起","kind":"person","person_id":"cbr-p003782","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m008-0030","start":30,"end":32,"surface":"李克","kind":"person","person_id":"cbr-p003786","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m008-0035","start":35,"end":36,"surface":"起","kind":"person","person_id":"cbr-p003782","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m008-0044","start":44,"end":48,"surface":"司馬穰苴","kind":"person","person_id":"cbr-p003787","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m008-0056","start":56,"end":59,"surface":"魏文侯","kind":"person","person_id":"cbr-p003785","status":"contextual_provisional"}],"chapter_id":"c-shiji-065-sun","book_id":"b-shiji-065","work_id":"w-shiji","source_id":"s-shiji-065-sun"}],"sources":[{"chapter_id":"c-shiji-064-sima","work_id":"w-shiji","book_id":"b-shiji-064","source_id":"s-shiji-064-sima","source":{"title":"史記／卷064","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷064","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷064&oldid=7895410","revision_id":7895410,"accessed_on":"2026-10-09","extent":"4段正文，排除註釋版及2段導覽，無索隱述贊。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/"