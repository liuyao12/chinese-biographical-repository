{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004361","identity_policy":"contextual_provisional","person_ids":["cbr-p004361"],"persons":[{"id":"cbr-p004361","label":"夜食客未名（孟嘗君列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"客","mention_ids":["c-shiji-075-mengchang:m004-0110","c-shiji-075-mengchang:m004-0121","c-shiji-075-mengchang:m004-0146"]}],"evidence":[{"mention_id":"c-shiji-075-mengchang:m004-0110","chapter_id":"c-shiji-075-mengchang","paragraph_id":"c-shiji-075-mengchang:p004","quote":"客"},{"mention_id":"c-shiji-075-mengchang:m004-0121","chapter_id":"c-shiji-075-mengchang","paragraph_id":"c-shiji-075-mengchang:p004","quote":"客"},{"mention_id":"c-shiji-075-mengchang:m004-0146","chapter_id":"c-shiji-075-mengchang","paragraph_id":"c-shiji-075-mengchang:p004","quote":"客"}]}],"source_mention_summary":[{"source_id":"s-shiji-075-mengchang","work_id":"w-shiji","book_id":"b-shiji-075","chapter_id":"c-shiji-075-mengchang","mention_count":3,"mention_ids":["c-shiji-075-mengchang:m004-0110","c-shiji-075-mengchang:m004-0121","c-shiji-075-mengchang:m004-0146"],"paragraph_ids":["c-shiji-075-mengchang:p004"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-075-mengchang"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-075-mengchang:m004-0110","start":110,"end":111,"surface":"客","kind":"person","person_id":"cbr-p004361","status":"contextual_provisional","paragraph_id":"c-shiji-075-mengchang:p004","chapter_id":"c-shiji-075-mengchang"},{"id":"c-shiji-075-mengchang:m004-0121","start":121,"end":122,"surface":"客","kind":"person","person_id":"cbr-p004361","status":"contextual_provisional","paragraph_id":"c-shiji-075-mengchang:p004","chapter_id":"c-shiji-075-mengchang"},{"id":"c-shiji-075-mengchang:m004-0146","start":146,"end":147,"surface":"客","kind":"person","person_id":"cbr-p004361","status":"contextual_provisional","paragraph_id":"c-shiji-075-mengchang:p004","chapter_id":"c-shiji-075-mengchang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji075-032","person_id":"cbr-p004361","scope":"same_chapter","chapter_ids":["c-shiji-075-mengchang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"依入秦、返齊及食客敘事明示姓名與局部回指暫接。未名夜食客、蔽光者、狗盜鷄鳴兩客、幸姬及勸說毀者各存角色，不補姓名或全域連所有客稱；木土偶保持寓言。蘇代內嵌秦昭王王稱與外層孟嘗君君稱分辨，楚王割地與楚懷王得出暫分候選，不確證異人；田甲劫王與孟嘗君反謀指控分開，不把指控當史實。","surfaces":["客"],"evidence":[{"paragraph_id":"c-shiji-075-mengchang:p004","quote":"孟嘗君在薛，招致諸侯賓客及亡人有罪者，皆歸孟嘗君。孟嘗君舍業厚遇之，以故傾天下之士。食客數千人，無貴賤一與文等。孟嘗君待客坐語，而屛風後常有侍史，主記君所與客語，問親戚居處。客去，孟嘗君已使使存問，獻遺其親戚。孟嘗君曾待客夜食，有一人蔽火光。客怒，以飯不等，輟食辭去。孟嘗君起，自持其飯比之。客慚，自剄。士以此多歸孟嘗君。孟嘗君客無所擇，皆善遇之。人人各自以爲孟嘗君親己。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-075-mengchang:p004","text":"孟嘗君在薛，招致諸侯賓客及亡人有罪者，皆歸孟嘗君。孟嘗君舍業厚遇之，以故傾天下之士。食客數千人，無貴賤一與文等。孟嘗君待客坐語，而屛風後常有侍史，主記君所與客語，問親戚居處。客去，孟嘗君已使使存問，獻遺其親戚。孟嘗君曾待客夜食，有一人蔽火光。客怒，以飯不等，輟食辭去。孟嘗君起，自持其飯比之。客慚，自剄。士以此多歸孟嘗君。孟嘗君客無所擇，皆善遇之。人人各自以爲孟嘗君親己。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-075-mengchang:m004-0000","start":0,"end":3,"surface":"孟嘗君","kind":"person","person_id":"cbr-p004330","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m004-0008","start":8,"end":12,"surface":"諸侯賓客","kind":"unresolved","person_id":null,"status":"unresolved","note":"寓言木土偶、未名群體、族屬或未定指代，不當真人或補群體成員；二人需各按已定位客角色解讀，不將所有客稱接同一人。"},{"id":"c-shiji-075-mengchang:m004-0013","start":13,"end":18,"surface":"亡人有罪者","kind":"unresolved","person_id":null,"status":"unresolved","note":"寓言木土偶、未名群體、族屬或未定指代，不當真人或補群體成員；二人需各按已定位客角色解讀，不將所有客稱接同一人。"},{"id":"c-shiji-075-mengchang:m004-0021","start":21,"end":24,"surface":"孟嘗君","kind":"person","person_id":"cbr-p004330","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m004-