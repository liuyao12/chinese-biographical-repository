b_i2n_AAAA","status":"contextual_provisional"},{"id":"c-nanqishu-049-wanghuan-complete:p006:m0113","start":113,"end":114,"surface":"奐","kind":"person","person_id":"q7m_r8k_2vn_AA","status":"contextual_provisional"},{"id":"c-nanqishu-049-wanghuan-complete:p006:m0174","start":174,"end":176,"surface":"王晏","kind":"person","person_id":"i08_s4b_5bb","status":"contextual_provisional"},{"id":"c-nanqishu-049-wanghuan-complete:p006:m0179","start":179,"end":180,"surface":"奐","kind":"person","person_id":"q7m_r8k_2vn_AA","status":"contextual_provisional"},{"id":"c-nanqishu-049-wanghuan-complete:p006:m0233","start":233,"end":234,"surface":"奐","kind":"person","person_id":"q7m_r8k_2vn_AA","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-049-wanghuan-complete","book_id":"b-nanqishu-049","work_id":"w-nanqishu","source_id":"s-nanqishu-049-wanghuan-complete-ws2261984"},{"id":"c-nanshi-022-wangjian:p009","text":"帝幸樂遊宴集，謂儉曰：「卿好音樂，孰與朕同？」儉曰：「沐浴唐風，事兼比屋，亦既在齊，不知肉味。」帝稱善。後幸華林宴集，使各效伎藝。褚彥回彈琵琶，王僧虔、柳世隆彈琴，沈文季歌子夜來，張敬兒舞。儉曰：「臣無所解，唯知誦書。」因跪上前誦相如封禪書。上笑曰：「此盛德之事，吾何以堪之。」後上使陸澄誦孝經，起自「仲尼居」，儉曰：「澄所謂博而寡要。臣請誦之。」乃誦君子之事上章。上曰：「善，張子布更覺非奇也。」於是王敬則脫朝服袒，以絳糾髻，奮臂拍張，叫動左右。上不悅曰：「豈聞三公如此。」答曰：「臣以拍張，故得三公，不可忘拍張。」時以為名答。","mentions":[{"id":"c-nanshi-022-wangjian:p009:m0008","person_id":"7r6_k52_qji_ABAAAAEAA","start":8,"end":9,"surface":"儉","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanshi-022-wangjian:p009:m0023","person_id":"7r6_k52_qji_ABAAAAEAA","start":23,"end":24,"surface":"儉","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanshi-022-wangjian:p009:m0065","person_id":"jyx_72x_8t2","start":65,"end":68,"surface":"褚彥回","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanshi-022-wangjian:p009:m0072","person_id":"7r6_k52_qji_ABAAAAEB","start":72,"end":75,"surface":"王僧虔","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanshi-022-wangj