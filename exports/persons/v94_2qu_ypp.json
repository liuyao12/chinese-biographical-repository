isions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-shiji124-001","person_id":"v94_2qu_ypp","event_type":"death","status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-124-youxia","source_id":"s-shiji124-youxia","paragraph_id":"c-shiji-124-youxia:p001","quote":"韓子曰：「儒以文亂法，而俠以武犯禁。」二者皆譏，而學士多稱於世云。至如以術取宰相卿大夫，輔翼其世主，功名俱著於春秋，固無可言者。及若季次、原憲，閭巷人也，讀書懷獨行君子之德，義不苟合當世，當世亦笑之。故季次、原憲終身空室蓬戶，褐衣疏食不厭。死而已四百餘年，而弟子志之不倦。今遊俠，其行雖不軌於正義，然其言必信，其行必果，已諾必誠，不愛其軀，赴士之阨困，既已存亡死生矣，而不矜其能，羞伐其德，蓋亦有足多者焉。","person_mention_id":"c-shiji-124-youxia:m001-0066"}],"source_term":"死而已四百餘年","interpretation_note":"明示死亡敘述連個人與原句；概數及朝代範圍不換算單一年，誅族不據此逐一補造家屬死亡。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"mentions":[{"id":"c-shiji-067-disciples:m076-0000","start":0,"end":3,"surface":"公皙哀","kind":"person","person_id":"v94_2qu_ypp","status":"contextual_provisional","paragraph_id":"c-shiji-067-disciples:p076","chapter_id":"c-shiji-067-disciples"},{"id":"c-shiji-067-disciples:m076-0004","start":4,"end":6,"surface":"季次","kind":"person","person_id":"v94_2qu_ypp","status":"contextual_provisional","paragraph_id":"c-shiji-067-disciples:p076","chapter_id":"c-shiji-067-disciples"},{"id":"c-shiji-067-disciples:m077-0020","start":20,"end":22,"surface":"季次","kind":"person","person_id":"v94_2qu_ypp","status":"contextual_provisional","paragraph_id":"c-shiji-067-disciples:p077","chapter_id":"c-shiji-067-disciples"},{"id":"c-shiji-124-youxia:m001-0066","start":66,"end":68,"surface":"季次","kind":"person","person_id":"v94_2qu_ypp","status":"contextual_provisional","paragraph_id":"c-shiji-124-youxia:p001","chapter_id":"c-shiji-124-youxia"},{"id":"c-shiji-124-youxia:m001-0101","start":101,"end":103,"surface":"季次","kind":"person","person_id":"v94_2qu_ypp","status":"contextual_provisional","paragraph_id":"c-shiji-124-youxia:p001","chapter_id":"c-shiji-124-youxia"},{"id":"c-shiji-124-youxia:m004-0097","start":97,"end":99,"surface":"季次","kind":"person","person_id":"v94_2qu_ypp","status":"contextual_provisional","paragraph_id":"c-shiji-124-youxia:p004","chapter_id":"c-shiji-124-youxia"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji067-057","person_id":"v94_2qu_ypp","scope":"same_chapter","chapter_ids":["c-shiji-067-disciples"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["公皙哀","季次"],"evidence":[{"paragraph_id":"c-shiji-067-disciples:p076","quote":"公皙哀字季次。"},{"paragraph_id":"c-shiji-067-disciples:p077","quote":"孔子曰：「天下無行，多爲家臣，仕於都；唯季次未嘗仕。」"}],"rationale":"依篇內明示姓名字稱及局部問答暫接。吳越王稱按夫差句踐連續敘事；第71段夫子指原憲，第90段指代未定。傳易短何分田子莊何與楊何，傳授不當父子；引古人物保留傳說性。冉季字子產不接鄭子產，原憲子思不接孔子後世子思；名錄各條同字子徒、子聲、子上、皙等均保留不同候選，鄭國是此條人名。魯昭公夫人孟子不接戰國孟子。全152段明示姓名首輪已存，未名者、代詞、版本及跨篇身份待覆核。"},{"id":"d-shiji124-context-six-001","person_id":"v94_2qu_ypp","scope":"cross_chapter","chapter_ids":["c-shiji-124-youxia","c-shiji-067-disciples"],"status":"contextual_provisional","confidence_level":"high","surfaces":["季次"],"identification_basis":{"kind":"source_context","target_mention_ids":["c-shiji-124-youxia:m001-0066","c-shiji-124-youxia:m001-0101","c-shiji-124-youxia:m004-0097"]},"evidence":[{"chapter_id":"c-shiji-124-youxia","paragraph_id":"c-shiji-124-youxia:p001","quote":"韓子曰：「儒以文亂法，而俠以武犯禁。」二者皆譏，而學士多稱於世云。至如以術取宰相卿大夫，輔翼其世主，功名俱著於春秋，固無可言者。及若季次、原憲，閭巷人也，讀書懷獨行君子之德，義不苟合當世，當世亦笑之。故季次、原憲終身空室蓬戶，褐衣疏食不厭。死而已四百餘年，而弟子志之不倦。今遊俠，其行雖不軌於正義，然其言必信，其行必果，已諾必誠，不愛其軀，赴士之阨困，既已存亡死生矣，而不矜其能，羞伐其德，蓋亦有足多者焉。"},{"chapter_id":"c-shiji-124-youxia","paragraph_id":"c-shiji-124-youxia:p004","quote":"今拘學或抱咫尺之義，久孤於世，豈若卑論儕俗，與世沈浮而取榮名哉！而布衣之徒，設取予然諾，千里誦義，為死不顧世，此亦有所長，非苟而已也。故士窮窘而得委命，此豈非人之所謂賢豪間者邪？誠使鄉曲之俠，予季次、原憲比權量力，效功於當世，不同日而論矣。要以功見言信，俠客之義又曷可少哉！"},{"chapter_id":"c-shiji-067-disciples","paragraph_id":"c-shiji-067-disciples:p076","quote":"公皙哀字季次。"},{"chapter_id":"c-shiji-067-disciples","paragraph_id":"c-shiji-067-disciples:p077","quote":"孔子曰：「天下無行，多爲家臣，仕於都；唯季次未嘗仕。」"}],"rationale":"〈仲尼弟子列傳〉明言公皙哀字季次，下一段記唯季次未嘗仕，與本篇季次不苟合當世相合。 只辨同指，保留正文與文字錨，不由本段添加親屬或推算生卒。","prior_source_qualifications":[{"source_mention_ids":["c-shiji-124-youxia:m001-0066","c-shiji-124-youxia:m001-0101","c-shiji-124-youxia:m004-0097"],"metadata":{"label":"季次（游俠列傳候選）","status":"active","historicity":"historical_tradition"},"original_registry_record_sha256":"57e10ce73c60d38afccb1c4ef52e4f08e62f19d14709025f7135e9c924f3806c","qualification":"原來源候選資格留作判讀背景，非另一現役人物或舊號別名。"}],"human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-067-disciples:p076","text":"公皙哀字季次。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-067-disciples:m076-0000","start":0,"end":3,"surface":"公皙哀","kind":"person","person_id":"v94_2qu_ypp","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m076-0004","start":4,"end":6,"surface":"季次","kind":"person","person_id":"v94_2qu_ypp","status":"contextual_provisional"}],"chapter_id":"c-shiji-067-disciples","book_id":"b-shiji-067","work_id":"w-shiji","source_id":"s-shiji-067-disciples"},{"id":"c-shiji-067-disciples:p077","text":"孔子曰：「天下無行，多爲家臣，仕於都；唯季次未嘗仕。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-067-disciples:m077-0000","start":0,"end":2,"surface":"孔子","kind":"person","person_id":"fp6_ia6_7yw","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m077-0012","start":12,"end":14,"surface":"家臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代，未補姓名、成員或親屬；譬喻與未遂取室不作已確證家屬。"},{"id":"c-shiji-067-disciples:m077-0020","start":20,"end":22,"surface":"季次","kind":"person","person_id":"v94_2qu_ypp","status":"contextual_provisional"}],"chapter_id":"c-shiji-067-disciples","book_id":"b-shiji-067","work_id":"w-shiji","source_id":"s-shiji-067-disciples"},{"id":"c-shiji-124-youxia:p001","text":"韓子曰：「儒以文亂法，而俠以武犯禁。」二者皆譏，而學士多稱於世云。至如以術取宰相卿大夫，輔翼其世主，功名俱著於春秋，固無可言者。及若季次、原憲，閭巷人也，讀書懷獨行君子之德，義不苟合當世，當世亦笑之。故季次、原憲終身空室蓬戶，褐衣疏食不厭。死而已四百餘年，而弟子志之不倦。今遊俠，其行雖不軌於正義，然其言必信，其行必果，已諾必誠，不愛其軀，赴士之阨困，既已存亡死生矣，而不矜其能，羞伐其德，蓋亦有足多者焉。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-124-youxia:m001-0000","start":0,"end":2,"surface":"韓子","kind":"person","person_id":"n2o_l90_fnm","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m001-0066","start":66,"end":68,"surface":"季次","kind":"person","person_id":"v94_2qu_ypp","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m001-0069","start":69,"end":71,"surface":"原憲","kind":"person","person_id":"b26_2bj_z9b","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m001-0101","start":101,"end":103,"surface":"季次","kind":"person","person_id":"v94_2qu_ypp","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m001-0104","start":104,"end":106,"surface":"原憲","kind":"person","person_id":"b26_2bj_z9b","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m001-0129","start":129,"end":131,"surface":"弟子","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-124-youxia","book_id":"b-shiji-124","work_id":"w-shiji","source_id":"s-shiji124-youxia"},{"id":"c-shiji-124-youxia:p004","text":"今拘學或抱咫尺之義，久孤於世，豈若卑論儕俗，與世沈浮而取榮名哉！而布衣之徒，設取予然諾，千里誦義，為死不顧世，此亦有所長，非苟而已也。故士窮窘而得委命，此豈非人之所謂賢豪間者邪？誠使鄉曲之俠，予季次、原憲比權量力，效功於當世，不同日而論矣。要以功見言信，俠客之義又曷可少哉！","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-124-youxia:m004-0097","start":97,"end":99,"surface":"季次","kind":"person","person_id":"v94_2qu_ypp","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m004-0100","start":100,"end":102,"surface":"原憲","kind":"person","person_id":"b26_2bj_z9b","status":"contextual_provisional"}],"chapter_id":"c-shiji-124-youxia","book_id":"b-shiji-124","work_id":"w-shiji","source_id":"s-