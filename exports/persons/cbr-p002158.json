{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p002158","identity_policy":"contextual_provisional","person_ids":["cbr-p002158"],"persons":[{"id":"cbr-p002158","label":"后稷（鄭世家引語候選）","status":"active","historicity":"legendary_tradition","aliases":[{"surface":"后稷","mention_ids":["c-shiji-042-zheng:m021-0284"]}],"evidence":[{"mention_id":"c-shiji-042-zheng:m021-0284","chapter_id":"c-shiji-042-zheng","paragraph_id":"c-shiji-042-zheng:p021","quote":"后稷"}]}],"mentions":[{"id":"c-shiji-042-zheng:m021-0284","start":284,"end":286,"surface":"后稷","kind":"person","person_id":"cbr-p002158","status":"contextual_provisional","paragraph_id":"c-shiji-042-zheng:p021","chapter_id":"c-shiji-042-zheng"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji042-064","person_id":"cbr-p002158","scope":"same_chapter","chapter_ids":["c-shiji-042-zheng"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["后稷"],"evidence":[{"paragraph_id":"c-shiji-042-zheng:p021","quote":"四十一年，助楚撃晉。自晉文公之過無禮，故背晉助楚。四十三年，晉文公與秦穆公共圍鄭，討其助楚攻晉者，及文公過時之無禮也。初，鄭文公有三夫人，寵子五人，皆以罪蚤死。公怒，溉逐群公子。子蘭奔晉，從晉文公圍鄭。時蘭事晉文公甚謹，愛幸之，乃私於晉，以求入鄭爲太子。晉於是欲得叔詹爲僇。鄭文公恐，不敢謂叔詹言。詹聞，言於鄭君曰：「臣謂君，君不聽臣，晉卒爲患。然晉所以圍鄭，以詹，詹死而赦鄭國，詹之願也。」乃自殺。鄭人以詹尸與晉。晉文公曰：「必欲一見鄭君，辱之而去。」鄭人患之，乃使人私於秦曰：「破鄭益晉，非秦之利也。」秦兵罷。晉文公欲入蘭爲太子，以告鄭。鄭大夫石癸曰：「吾聞姞姓乃后稷之元妃，其後當有興者。子蘭母，其後也。且夫人子盡已死，餘庶子無如蘭賢。今圍急，晉以爲請，利孰大焉！」遂許晉，與盟，而卒立子蘭爲太子，晉兵乃罷去。"}],"rationale":"依本篇名字、是為、世系及連續事件暫接異稱；同諡不同國分開，建子勝與聲公勝不合併，如兄弟為譬喻不作親屬。述贊與正文不算獨立來源，省稱、古字與校勘仍待核。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-042-zheng:p021","text":"四十一年，助楚撃晉。自晉文公之過無禮，故背晉助楚。四十三年，晉文公與秦穆公共圍鄭，討其助楚攻晉者，及文公過時之無禮也。初，鄭文公有三夫人，寵子五人，皆以罪蚤死。公怒，溉逐群公子。子蘭奔晉，從晉文公圍鄭。時蘭事晉文公甚謹，愛幸之，乃私於晉，以求入鄭爲太子。晉於是欲得叔詹爲僇。鄭文公恐，不敢謂叔詹言。詹聞，言於鄭君曰：「臣謂君，君不聽臣，晉卒爲患。然晉所以圍鄭，以詹，詹死而赦鄭國，詹之願也。」乃自殺。鄭人以詹尸與晉。晉文公曰：「必欲一見鄭君，辱之而去。」鄭人患之，乃使人私於秦曰：「破鄭益晉，非秦之利也。」秦兵罷。晉文公欲入蘭爲太子，以告鄭。鄭大夫石癸曰：「吾聞姞姓乃后稷之元妃，其後當有興者。子蘭母，其後也。且夫人子盡已死，餘庶子無如蘭賢。今圍急，晉以爲請，利孰大焉！」遂許晉，與盟，而卒立子蘭爲太子，晉兵乃罷去。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-042-zheng:m021-0011","start":11,"end":14,"surface":"晉文公","kind":"person","person_id":"cbr-p002151","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m021-0030","start":30,"end":33,"surface":"晉文公","kind":"person","person_id":"cbr-p002151","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m021-0034","start":34,"end":37,"surface":"秦穆公","kind":"person","person_id":"cbr-p002155","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m021-0050","start":50,"end":52,"surface":"文公","kind":"person","person_id":"cbr-p002151","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m021-0061","start":61,"end":64,"surface":"鄭文公","kind":"person","person_id":"cbr-p002147","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m021-0065","start":65,"end":68,"surface":"三夫人","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名、群體、夢中或神祇指代及提議用稱保留；不補姓名、個人成員或授位事實。"},{"id":"c-shiji-042-zheng:m021-0069","start":69,"end":73,"surface":"寵子五人","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名、群體、夢中或神祇指代及提議用稱保留；不補姓名、個人成員或授位事實。"},{"id":"c-shiji-042-zheng:m021-0085","start":85,"end":88,"surface":"群公子","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名、群體、夢中或神祇指代及提議用稱保留；不補姓名、個人成員或授位事實。"},{"id":"c-shiji-042-zheng:m021-0089","start":89,"end":91,"surface":"子蘭","kind":"person","person_id":"cbr-p002156","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m021-0095","start":95,"end":98,"surface":"晉文公","kind":"person","person_id":"cbr-p002151","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m021-0102","start":102,"end":103,"surface":"蘭","kind":"person","person_id":"cbr-p002156","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m021-0104","start":104,"end":107,"surface":"晉文公","kind":"person","person_id":"cbr-p002151","status":"contextual_provisional"},{"id":"c-shiji-042-zheng