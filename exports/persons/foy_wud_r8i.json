16","chapter_id":"c-shiji-105-bianque"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji105-028","person_id":"foy_wud_r8i","surfaces":["小子","諸嬰兒小子"],"scope":"same_chapter","chapter_ids":["c-shiji-105-bianque"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-105-bianque:p016","quote":"齊王中子諸嬰兒小子病，召臣意診切其脈，告曰：「氣鬲病。病使人煩懣，食不下，時嘔沫。病得之（少）［心］憂，數忔食飲。」臣意即為之作下氣湯以飲之，一日氣下，二日能食，三日即病愈。所以知小子之病者，診其脈，心氣也，濁躁而經也，此絡陽病也。脈法曰「脈來數疾去難而不一者，病主在心」。周身熱，脈盛者，為重陽。重陽者，逿心主。故煩懣食不下則絡脈有過，絡脈有過則血上出，血上出者死。此悲心所生也，病得之憂也。"}],"rationale":"依本篇姓名、原稱及敘事回指暫定；醫案引語與附載注釋分層，未按同名自動跨篇合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-105-bianque:p016","text":"齊王中子諸嬰兒小子病，召臣意診切其脈，告曰：「氣鬲病。病使人煩懣，食不下，時嘔沫。病得之（少）［心］憂，數忔食飲。」臣意即為之作下氣湯以飲之，一日氣下，二日能食，三日即病愈。所以知小子之病者，診其脈，心氣也，濁躁而經也，此絡陽病也。脈法曰「脈來數疾去難而不一者，病主在心」。周身熱，脈盛者，為重陽。重陽者，逿心主。故煩懣食不下則絡脈有過，絡脈有過則血上出，血上出者死。此悲心所生也，病得之憂也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-105-bianque:m016-0004","start":4,"end":9,"surface":"諸嬰兒小子","kind":"person","person_id":"foy_wud_r8i","status":"contextual_provisional"},{"id":"c-shiji-105-bianque:m016-0012","start":12,"end":14,"surface":"臣意","kind":"person","person_id":"yg7_rda_vb8","status":"contextual_provisional"},{"id":"c-shiji-105-bianque:m016-0058","start":58,"end":60,"surface":"臣意","kind":"person","person_id":"yg7_rda_vb8","status":"contextual_provisional"},{"id":"c-shiji-105-bianque:m016-0090","start":90,"end":92,"surface":"小子","kind":"person","person_id":"foy_wud_r8i","status":"contextual_provisional"}],"chapter_id":"c-shiji-105-bianque","book_id":"b-shiji-105","work_id":"w-shiji","source_id":"s-shiji-105-bianque"}],"sources":[{"chapter_id":"c-shiji-105-bianque","work_id":"w-shiji","book_id":"b-shiji-105","source_id":"s-shiji-105-bianque","source":{"title":"史記／卷105","provider":"維基文庫","url":"ht