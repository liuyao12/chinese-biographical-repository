":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-003-yin:m030-0071","start":71,"end":73,"surface":"祖伊","kind":"person","person_id":"61b_fc5_6h4","status":"source_identified","paragraph_id":"c-shiji-003-yin:p030","chapter_id":"c-shiji-003-yin"},{"id":"c-shiji-003-yin:m030-0186","start":186,"end":188,"surface":"祖伊","kind":"person","person_id":"61b_fc5_6h4","status":"source_identified","paragraph_id":"c-shiji-003-yin:p030","chapter_id":"c-shiji-003-yin"},{"id":"c-shiji-004-zhou:m010-0023","start":23,"end":25,"surface":"祖伊","kind":"person","person_id":"61b_fc5_6h4","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p010","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-038-song:m001-0041","start":41,"end":43,"surface":"祖伊","kind":"person","person_id":"61b_fc5_6h4","status":"contextual_provisional","paragraph_id":"c-shiji-038-song:p001","chapter_id":"c-shiji-038-song"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji004-010","person_id":"61b_fc5_6h4","surfaces":["祖伊"],"scope":"cross_chapter","chapter_ids":["c-shiji-003-yin","c-shiji-004-zhou"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-003-yin:p030","quote":"紂之臣祖伊聞之"},{"paragraph_id":"c-shiji-004-zhou:p010","quote":"殷之祖伊聞之"}],"rationale":"依前後本紀相同人物職事、事件或敘事脈絡暫定同指；不將同名、官稱或字形用作全庫自動匹配。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji038-012","person_id":"61b_fc5_6h4","surfaces":["祖伊"],"scope":"cross_chapter","chapter_ids":["c-shiji-003-yin","c-shiji-038-song"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-003-yin:p030","quote":"西伯歸，乃陰修德行善，諸侯多叛紂而往歸西伯。西伯滋大，紂由是稍失權重。王子比干諫，弗聽。商容賢者，百姓愛之，紂廢之。及西伯伐飢國，滅之，紂之臣祖伊聞之而咎周，恐，奔告紂曰：「天既訖我殷命，假人元龜，無敢知吉，非先王不相我後人，維王淫虐用自絕，故天棄我，不有安食，不虞知天性，不迪率典。今我民罔不欲喪，曰『天曷不降威，大命胡不至』？今王其柰何？」紂曰：「我生不有命在天乎！」祖伊反，曰：「紂不可諫矣。」西伯既卒，周武王之東伐，至盟津，諸侯叛殷會周者八百。諸侯皆曰：「紂可伐矣。」武王曰：「爾未知天命。」乃復歸。"},{"paragraph_id":"c-shiji-038-song:p001","quote":"微子開者，殷帝乙之首子而帝紂之庶兄也。紂既立，不明，淫亂於政，微子數諫，紂不聽。及祖伊以周西伯昌之修德，滅黎國，懼禍至，以告紂。紂曰：「我生不有命在天乎？是何能爲！」於是微子度紂終不可諫，欲死之，及去，未能自決，乃問於太師、少師曰：「殷不有治政，不治四方。我祖遂陳於上，紂沈湎於酒，婦人是用，亂敗湯德於下。殷既小大好草竊姦宄，卿士師師非度，皆有罪辜，乃无維獲，小民乃并興，相爲敵讎。今殷其典喪！若涉水无津涯。殷遂喪，越至于今。」曰：「太師，少師，我其發出往？吾家保于喪？今女无故告予，顛躋，如之何其？」太師若曰：「王子，天篤下菑亡殷國，乃毋畏畏，不用老長。今殷民乃陋淫神祇之祀。今誠得治國，國治身死不恨。爲死，終不得治，不如去。」遂亡。"}],"rationale":"按本篇明示名與稱號、宋國世系及具體事件暫同指；未把同字短名全域合併，所有引句與未定處保留。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-003-yin:p030","text":"西伯歸，乃陰修德行善，諸侯多叛紂而往歸西伯。西伯滋大，紂由是稍失權重。王子比干諫，弗聽。商容賢者，百姓愛之，紂廢之。及西伯伐飢國，滅之，紂之臣祖伊聞之而咎周，恐，奔告紂曰：「天既訖我殷命，假人元龜，無敢知吉，非先王不相我後人，維王淫虐用自絕，故天棄我，不有安食，不虞知天性，不迪率典。今我民罔不欲喪，曰『天曷不降威，大命胡不至』？今王其柰何？」紂曰：「我生不有命在天乎！」祖伊反，曰：「紂不可諫矣。」西伯既卒，周武王之東伐，至盟津，諸侯叛殷會周者八百。諸侯皆曰：「紂可伐矣。」武王曰：「爾未知天命。」乃復歸。","mentions":[{"id":"c-shiji-003-yin:m030-0000","start":0,"end":2,"surface":"西伯","kind":"person","person_id":"y4i_pjk_4gn_A","status":"source_identified"},{"id":"c-shiji-003-yin:m030-0015","start":15,"end":16,"surface":"紂","kind":"person","person_id":"lwx_9yq_ad7","status":"source_identified"},{"id":"c-shiji-003-yin:m030-0019","start":19,"end":21,"surface":"西伯","kind":"person","person_id":"y4i_pjk_4gn_A","status":"source_identified"},{"id":"c-shiji-003-yin:m030-0022","start":22,"end":24,"surface":"西伯","kind":"person","person_id":"y4i_pjk_4gn_A","status":"source_identified"},{"id":"c-shiji-003-yin:m030-0027","start":27,"end":28,"surface":"紂","kind":"person","person_id":"lwx_9yq_ad7","status":"source_identified"},{"id":"c-shiji-003-yin:m030-0035","start":35,"end":39,"surface":"王子比干","kind":"person","person_id":"xtq_oi8_w82","status":"source_identified"},{"id":"c-shiji-003-yin:m030-0044","start":44,"end":4