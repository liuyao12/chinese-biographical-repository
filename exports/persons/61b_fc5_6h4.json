4gn_A","status":"source_identified"},{"id":"c-shiji-003-yin:m030-0205","start":205,"end":208,"surface":"周武王","kind":"person","person_id":"y4i_pjk_4gn_AA","status":"source_identified"},{"id":"c-shiji-003-yin:m030-0232","start":232,"end":233,"surface":"紂","kind":"person","person_id":"lwx_9yq_ad7","status":"source_identified"},{"id":"c-shiji-003-yin:m030-0238","start":238,"end":240,"surface":"武王","kind":"person","person_id":"y4i_pjk_4gn_AA","status":"source_identified"}],"chapter_id":"c-shiji-003-yin","book_id":"b-shiji-003","work_id":"w-shiji","source_id":"s-shiji-003-yin"},{"id":"c-shiji-004-zhou:p010","text":"明年，伐犬戎。明年，伐密須。明年，敗耆國。殷之祖伊聞之，懼，以告帝紂。紂曰：「不有天命乎？是何能為！」明年，伐邘。明年，伐崇侯虎。而作豐邑，自岐下而徙都豐。明年，西伯崩，太子發立，是為武王。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-004-zhou:m010-0023","start":23,"end":25,"surface":"祖伊","kind":"person","person_id":"61b_fc5_6h4","status":"source_identified"},{"id":"c-shiji-004-zhou:m010-0032","start":32,"end":34,"surface":"帝紂","kind":"person","person_id":"lwx_9yq_ad7","status":"source_identified"},{"id":"c-shiji-004-zhou:m010-0035","start":35,"end":36,"surface":"紂","kind":"person","person_id":"lwx_9yq_ad7","status":"source_identified"},{"id":"c-shiji-004-zhou:m010-0061","start":61,"end":64,"surface":"崇侯虎","kind":"person","person_id":"hka_te6_9q1","status":"source_identified"},{"id":"c-shiji-004-zhou:m010-0081","start":81,"end":83,"surface":"西伯","kind":"person","person_id":"y4i_pjk_4gn_A","status":"source_identified"},{"id":"c-shiji-004-zhou:m010-0085","start":85,"end":88,"surface":"太子發","kind":"person","person_id":"y4i_pjk_4gn_AA","status":"source_identified"},{"id":"c-shiji-004-zhou:m010-0092","start":92,"end":94,"surface":"武王","kind":"person","person_id":"y4i_pjk_4gn_AA","status":"source_identified"}],"chapter_id":"c-shiji-004-zhou","book_id":"b-shiji-004","work_id":"w-shiji","source_id":"s-shiji-004-zhou"},{"id":"c-shiji-038-song:p001","text":"微子開者，殷帝乙之首子而帝紂之庶兄也。紂既立，不明，淫亂於政，微子數諫，紂不聽。及祖伊以周西伯昌之修德，滅黎國，懼禍至，以告紂。紂曰：「我生不有命在天乎？是何能爲！」於是微子度紂終不可諫，欲死之，及去，未能自決，乃問於太師、少師曰：「殷不有治政，不治四方。我祖遂陳於上，紂沈湎於酒，婦人是用，亂敗湯德於下。殷既小大好草竊姦宄，卿士師師非度，皆有罪辜，乃无維獲，小民乃并興，相爲敵讎。今殷其典喪！若涉水无津涯。殷遂喪，越至于今。」曰：「太師，少師，我其發出往？吾家保于喪？今女无故告予，顛躋，如之何其？」太師若曰：「王子，天篤下菑亡殷國，乃毋畏畏，不用老長。今殷民乃陋淫神祇之祀。今誠得治國，國治身死不恨。爲死，終不得治，不如去。」遂亡。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-038-song:m001-0000","start":0,"end":3,"surface":"微子開","kind":"person","person_id":"buv_igi_gpn_A","status":"contextual_provisional"},{"id":"c-shiji-038-song:m001-0005","start":5,"end":8,"surface":"殷帝乙","kind":"person","person_id":"buv_igi_gpn","status":"contextual_provisional"},{"id":"c-shiji-038-song:m001-0012","start":12,"end":14,"surface":"帝紂","kind":"person","person_id":"lwx_9yq_ad7","status":"contextual_provisional"},{"id":"c-shiji-038-song:m001-0019","start":19,"end":20,"surface":"紂","kind":"person","person_id":"lwx_9yq_ad7","status":"contextual_provisional"},{"id":"c-shiji-038-song:m001-0031","start":31,"end":33,"surface":"微子","kind":"person","person_id":"buv_igi_gpn_A","status":"contextual_provisional"},{"id":"c-shiji-038-song:m001-0036","start":36,"end":37,"surface":"紂","kind":"person","person_id":"lwx_9yq_ad7","status":"contextual_provisional"},{"id":"c-shiji-038-song:m001-0041","start":41,"end":43,"surface":"祖伊","kind":"person","person_id":"61b_fc5_6h4","status":"contextual_provisional"},{"id":"c-shiji-038-song:m001-0044","start":44,"end":48,"surface":"周西伯昌","kind":"person","person_id":"y4i_pjk_4gn_A","status":"contextual_provisional"},{"id":"c-shiji-038-song:m001-0062","start":62,"end":63,"surface":"紂","kind":"person","person_id":"lwx_9yq_ad7","status":"contextual_provisional"},{"id":"c-shiji-038-song:m001-0064","start":64,"end":65,"surface":"紂","kind":"person","person_id":"lwx_9yq_ad7","status":"contextual_provisional"},{"id":"c-shiji-038-song:m001-0085","start":85,"end":87,"surface":"微子","kind":"person","person_id":"buv_igi_gpn_A","status":"contextual_provisional"},{"id":"c-shiji-038-song:m001-0088","start":