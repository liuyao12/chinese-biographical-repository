d":"paragraph"}],"mention_count":3,"duplicate_mention_count":0,"paragraph_occurrence_count":3,"table_occurrence_count":0,"passage_count":2,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"3處獨立位置，3個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-chenshu-013-ws1511906-rendered-xunlang"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-chenshu013-xiao-brother-lang","subject_person_id":"k1s_ws8_h2d","predicate":"brother","object_person_id":"vh4_rsb_xo3_AA","status":"source_attested","qualifiers":{"source_term":"及弟曉","relative_birth_order":{"older_person_id":"vh4_rsb_xo3_AA","younger_person_id":"k1s_ws8_h2d","operator":"lt","scope":"siblings","older_ordinal":null,"younger_ordinal":null},"shared_father":null,"absolute_ordinal":null},"evidence":[{"work_id":"w-chenshu","book_id":"b-chenshu-013","chapter_id":"c-chenshu-013-xunlang-rendered","source_id":"s-chenshu-013-ws1511906-rendered-xunlang","paragraph_id":"c-chenshu-013-xunlang-rendered:p002","quote":"朗少慷慨，有將帥大略，起家梁廬陵王行參軍。侯景之亂，朗招率徒旅，據巢湖閒，無所屬。臺城陷後，簡文帝密詔授朗雲麾將軍、豫州刺史，令與外藩討景。景使儀同宋子仙、任約等頻往征之，朗據山立砦自守，子仙不能克。時京師大饑，百姓皆於江外就食，朗更招致部曲，解衣推食，以相賑贍，眾至數萬人。侯景敗於巴陵，朗出自濡須截景，破其後軍。王僧辯東討，朗遣其將范寶勝及弟曉領兵二千助之。侯景平後，又別破齊將郭元建於踟躕山。梁承聖二年，率部曲萬餘家濟江，入宣城郡界立頓。梁元帝授朗持節、通直散騎常侍、安南將軍、都督南兗州諸軍事、南兗州刺史。未行而荊州陷。","subject_person_mention_id":"c-chenshu-013-xunlang-rendered:p002:m0023","object_person_mention_id":"c-chenshu-013-xunlang-rendered:p002:m0021"}],"reviewer":"Codex（AI代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,