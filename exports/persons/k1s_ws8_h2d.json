朗"},"edge":{"assertion_id":"a-chenshu013-xiao-brother-lang","traversal":"named_person_to_brother","clause_anchor":{"paragraph_id":"c-chenshu-013-xunlang-rendered:p002","start":164,"end":174,"surface":"朗遣其將范寶勝及弟曉"},"rule":"topic_di_enumeration","seed_role_mid":"c-chenshu-013-xunlang-rendered:p002:m0021","target_role_mid":"c-chenshu-013-xunlang-rendered:p002:m0023","assertions_path":"corpus/chenshu/013-xunlang-rendered-assertions.json"}},"work_id":"w-chenshu","book_id":"b-chenshu-013","source_id":"s-chenshu-013-ws1511906-rendered-xunlang"}],"life_events":[{"id":"le-chenshu013-xiao-killed","person_id":"k1s_ws8_h2d","event_type":"death","status":"source_attested","date_expression":null,"source_term":"景歷殺曉","evidence":[{"work_id":"w-chenshu","book_id":"b-chenshu-013","chapter_id":"c-chenshu-013-xunlang-rendered","source_id":"s-chenshu-013-ws1511906-rendered-xunlang","paragraph_id":"c-chenshu-013-xunlang-rendered:p004","quote":"高祖崩，宣太后與舍人蔡景歷祕不發喪，朗弟曉在都微知之，乃謀率其家兵襲臺。事覺，景歷殺曉，仍繫其兄弟。世祖即位，並釋之。因厚撫慰朗，令與侯安都等共拒王琳。琳平，遷使持節、安北將軍、散騎常侍、都督霍晉合三州諸軍事、合州刺史。天嘉六年卒，時年四十八。贈南豫州刺史，諡曰壯。子法尚嗣。","person_mention_id":"c-chenshu-013-xunlang-rendered:p004:m0045"}],"interpretation_note":"各受者按本完整段主語鏈；不由高祖或朗的背景年填他人死亡，不倒算出生。","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-chenshu-013-xunlang-rendered:p002:m0023","kind":"person","person_id":"k1s_ws8_h2d","start":173,"end":174,"surface":"曉","status":"contextual_provisional","paragraph_id":"c-chenshu-013-xunlang-rendered:p002","chapter_id":"c-chenshu-013-xunlang-rendered"},{"id":"c-chenshu-013-xunlang-rendered:p004:m0043","kind":"person","person_id":"k1s_ws8_h2d","start":20,"end":21,"surface":"曉","status":"contextual_provisional","paragraph_id":"c-chenshu-013-xunlang-rendered:p004","chapter_id":"c-chenshu-013-xunlang-rendered"},{"id":"c-chenshu-013-xunlang-rendered:p004:m0045","kind":"person","person_id":"k1s_ws8_h2d","start":42,"end":43,"surface":"曉","status":"contextual_provisional","paragraph_id":"c-chenshu-013-xunlang-rendered:p004","chapter_id":"c-chenshu-013-xunlang-rendered"}],"relations":[{"id":"a-chenshu013-xiao-brother-lang","subject_person_id":"k1s_ws8_h2d","predicate":"brother","object_person_id":"vh4_rsb_xo3_AA","status":"source_attested","qualifiers":{"source_term":"及弟曉","relative_birth_order":{"older_person_id":"vh4_rsb_xo3_AA","younger_person_id":"k1s_ws8_h2d","operator":"lt","scope":"siblings","older_ordinal":null,"younger_ordinal":null},"shared_father":null,"absolute_ordinal":null},"evidence":[{"work_id":"w-chenshu","book_id":"b-chenshu-013","chapter_id":"c-chenshu-013-xunlang-rendered","source_id":"s-chenshu-013-ws1511906-rendered-xunlang","paragraph_id":"c-chenshu-013-xunlang-rendered:p002","quote":"朗少慷慨，有將帥大略，起家梁廬陵王行參軍。侯景之亂，朗招率徒旅，據巢湖閒，無所屬。臺城陷後，簡文帝密詔授朗雲麾將軍、豫州刺史，令與外藩討景。景使儀同宋子仙、任約等頻往征之，朗據山立砦自守，子仙不能克。時京師大饑，百姓皆於江外就食，朗更招致部曲，解衣推食，以相賑贍，眾至數萬人。侯景敗於巴陵，朗出自濡須截景，破其後軍。王僧辯東討，朗遣其將范寶勝及弟曉領兵二千助之。侯景平後，又別破齊將郭元建於踟躕山。梁承聖二年，率部曲萬餘家濟江，入宣城郡界立頓。梁元帝授朗持節、通直散騎常侍、安南將軍、都督南兗州諸軍事、南兗州刺史。未行而荊州陷。","subject_person_mention_id":"c-chenshu-013-xunlang-rendered:p002:m0023","object_person_mention_id":"c-chenshu-013-xunlang-rendered:p002:m0021"}],"reviewer":"Codex（AI代理）","human_reviewed":false,"model":null}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[{"older_person_id":"vh4_rsb_xo3_AA","younger_person_id":"k1s_ws8_h2d","operator":"lt","scope":"siblings","older_ordinal":null,"younger_ordinal":null,"assertion_id":"a-chenshu013-xiao-brother-lang","person_id":"k1s_ws8_h2d","evidence":[{"work_id":"w-chenshu","book_id":"b-chenshu-013","chapter_id":"c-chenshu-013-xunlang-rendered","source_id":"s-chenshu-013-ws1511906-rendered-xunlang","paragraph_id":"c-chenshu-013-xunlang-rendered:p002","quote":"朗少慷慨，有將帥大略，起家梁廬陵王行參軍。侯景之亂，朗招率徒旅，據巢湖閒，無所屬。臺城陷後，簡文帝密詔授朗雲麾將軍、豫州刺史，令與外藩討景。景使儀同宋子仙、任約等頻往征之，朗據山立砦自守，子仙不能克。時京師大饑，百姓皆於江外就食，朗更招致部曲，解衣推食，以相賑贍，眾至數萬人。侯景敗於巴陵，朗出自濡須截景，破其後軍。王僧辯東討，朗遣其將范寶勝及弟曉領兵二千助之。侯景平後，又別破齊將郭元建於踟躕山。梁承聖二年，率部曲萬餘家濟江，入宣城郡界立頓。梁元帝授朗持節、通直散騎常侍、安南將軍、都督南兗州諸軍事、南兗