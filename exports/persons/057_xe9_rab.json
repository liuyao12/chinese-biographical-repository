aph_id":"c-shiji-040-chu:p001","quote":"呉回"},{"mention_id":"c-shiji-040-chu:m002-0000","chapter_id":"c-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p002","quote":"呉回"},{"mention_id":"c-shiji-130-taishigong:m052-0005","chapter_id":"c-shiji-130-taishigong","paragraph_id":"c-shiji-130-taishigong:p052","quote":"吳回"}]}],"source_mention_summary":[{"source_id":"s-shiji-042-zheng","work_id":"w-shiji","book_id":"b-shiji-042","chapter_id":"c-shiji-042-zheng","raw_mention_count":1,"mention_ids":["c-shiji-042-zheng:m001-0244"],"paragraph_ids":["c-shiji-042-zheng:p001"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-shiji-042-zheng:m001-0244","mention_ids":["c-shiji-042-zheng:m001-0244"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-shiji-042-zheng"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"referent_interpretations":[{"id":"ri-shiji117-zhurong","paragraph_id":"c-shiji-117-xiangru:p052","target_mention_ids":["c-shiji-117-xiangru:m052-0100"],"source_terms":["祝融"],"status":"unresolved","default_alternative_id":null,"evidence":{"work_id":"w-shiji","book_id":"b-shiji-117","chapter_id":"c-shiji-117-xiangru","source_id":"s-shiji117-xiangru","paragraph_id":"c-shiji-117-xiangru:p052","quote":"邪絕少陽而登太陰兮，與真人乎相求。互折窈窕以右轉兮，橫厲飛泉以正東。悉徵靈圉而選之兮，部乘眾神於瑤光。使五帝先導兮，反太一而從陵陽。左玄冥而右含靁兮，前陸離而後潏湟。厮征北僑而役羡門兮，屬岐伯使尚方。祝融驚而蹕御兮，清氛氣而後行。屯余車其萬乘兮，綷雲蓋而樹華旗。使勾芒其將行兮，吾欲往乎南嬉。","mention_ids":["c-shiji-117-xiangru:m052-0100"]},"alternatives":[{"id":"ri-shiji117-zhurong-zhongli","attribution":"《史記》卷40〈楚世家〉","referent_kind":"legendary_person","candidate_person_ids":["off_msa_t3x"],"interpretation":"此處指重黎：楚世家稱帝嚳命重黎曰祝融。","source_reference_ids":["shiji040-chu-zhurong-holders"]},{"id":"ri-shiji117-zhurong-wuhui","attribution":"《史記》卷40〈楚世家〉","referent_kind":"legendary_person","candidate_person_ids":["uk3_s1y_7c7"],"interpretation":"此處指呉回：楚世家稱其承重黎後復居火正，為祝融。","source_reference_ids":["shiji040-chu-zhurong-holders"]},{"id":"ri-shiji117-zhurong-zhengzu","attribution":"《史記》卷42〈鄭世家〉太史伯語","referent_kind":"legendary_person","candidate_person_ids":["057_xe9_rab"],"interpretation":"此處指鄭世家所存高辛氏火正祖系候選；該篇所稱是否即重黎或呉回未定。","source_reference_ids":["shiji042-zheng-zhurong-ancestor"]},{"id":"ri-shiji117-zhurong-cult-deity","attribution":"《史記》楚、鄭世家相關敘事","referent_kind":"divinity","candidate_person_ids":[],"interpretation":"此處泛指受祭的火神／祖神，或指祝融職名所形成的神格；不指定為個別持名者。","source_reference_ids":["shiji040-kui-zhurong-cult","shiji042-zheng-zhurong-ancestor"]}],"references":[{"id":"shiji040-chu-zhurong-holders","title":"《史記》卷40〈楚世家〉重黎與呉回先後為祝融","url":"https://github.com/liuyao12/chinese-biographical-repository/blob/b54c37f60d7537b4cfc00b0960ebad90ad5bcd99/corpus/shiji/040.json#L48-L49","source_commit":"b54c37f60d7537b4cfc00b0960ebad90ad5bcd99","source_blob":"1a89ed689d7870b62022003f7bf205f15701ef63","quote":"楚之先祖出自帝顓頊髙陽。髙陽者，黃帝之孫，昌意之子也。髙陽生稱，稱生巻章，巻章生重黎。重黎爲帝嚳髙辛居火正，甚有功，能光融天下，帝嚳命曰祝融。共工氏作亂，帝嚳使重黎誅之而不盡。帝乃以庚寅日誅重黎，而以其弟呉回爲重黎後，復居火正，爲祝融。","read_line_range":[48,49],"cached_response_sha256":"d7e0f384d0e7db0e1df01e7ca1cbdcc08f48a9e731d202d4c4a2f1727484675b","image_verified":false,"scope":"internal_fixed_source_excerpt","source_revision_url":"https://zh.wikisource.org/w/index.php?title=史記/卷040&oldid=8736796"},{"id":"shiji040-kui-zhurong-cult","title":"《史記》卷40〈楚世家〉夔不祀祝融","url":"https://github.com/liuyao12/chinese-biographical-repository/blob/b54c37f60d7537b4cfc00b0960ebad90ad5bcd99/corpus/shiji/040.json#L1633-L1634","source_commit":"b54c37f60d7537b4cfc00b0960ebad90ad5bcd99","source_blob":"1a89ed689d7870b62022003f7bf205f15701ef63","quote":"滅夔，夔不祀祝融、鬻熊故也。","read_line_range":[1633,1634],"cached_response_sha256":"d7e0f384d0e7db0e1df01e7ca1cbdcc08f48a9e731d202d4c4a2f1727484675b","image_verified":false,"scope":"internal_fixed_source_excerpt","source_revision_url":"https://zh.wikisource.org/w/index.php?title=史記/卷040&oldid=8736796"},{"id":"shiji042-zheng-zhurong-ancestor","title":"《史記》卷42〈鄭世家〉太史伯論祝融","url":"https://github.com/liuyao12/chinese-biographical-repository/blob/b54c37f60d7537b4cfc00b0960ebad90ad5bcd99/corpus/shiji/042.json#L45-L46","source_commit":"b54c37f60d7537b4cfc00b0960ebad90ad5bcd99","source_blob":"ec30c61f177838d29a72aa96d5e25a7136d41015","quote":"昔祝融爲髙辛氏火正，其功大矣，而其於周未有興者，楚其後也。","read_line_range":[45,46],"cached_response_sha256":"2d8344022cadece1e6b25756e038602bf7cb04234594b4ebbf5ab33b76db5b23","image_verified":false,"scope":"internal_fixed_source_excerpt","source_revision_url":"https://zh.wikisource.org/w/index.php?title=史記/卷042&oldid=8736804"}],"note":"本句本身只敘祝融在賦中驚動並清道，不提供名、世代或可與楚、鄭祖系相連的親屬標記。《楚世家》同一祖系敘事明言重黎受祝融之名，後又稱呉回承後、復居火正為祝融；篇末另提夔不祀祝融。《鄭世家》太史伯語亦以祝融為高辛氏火正祖系。這些記載證明稱名有多重承襲／祭祀層次，不能僅憑賦中同名選定重黎、呉回或單一神格，故維持未決，不建立人物ID或同指邊。","reviewer":"Codex（AI代理）","human_reviewed":false,"work_id":"w-shiji","book_id":"b-shiji-117","chapter_id":"c-shiji-117-xiangru","source_id":"s-shiji117-xiangru"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-042-zheng:m001-0244","start":244,"end":246,"surface":"祝融","kind":"person","person_id":"057_xe9_rab","status":"contextual_provisional","paragraph_id":"c-shiji-042-zheng:p001","chapter_id":"c-shiji-042-zheng"}],"relations":[],"title_holdings":[{"id":"th-shiji042-002","person_id":"057_xe9_rab","title":"火正","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-042-zheng","source_id":"s-shiji-042-zheng","paragraph_id":"c-shiji-042-zheng:p001","quote":"鄭桓公友者，周厲王少子而宣王庶弟也。宣王立二十二年，友初封于鄭。封三十三歳，百姓皆便愛之。幽王以爲司徒。和集周民，周民皆説，河雒之閒，人便思之。爲司徒一歳，幽王以褒后故，王室治多邪，諸侯或畔之。於是桓公問太史伯曰：「王室多故，予安逃死乎？」太史伯對曰：「獨雒之東土，河濟之南可居。」公曰：「何以？」對曰：「地近虢、鄶，虢、鄶之君貪而好利，百姓不附。今公爲司徒，民皆愛公，公誠請居之，虢、鄶之君見公方用事，輕分公地。公誠居之，虢、鄶之民皆公之民也。」公曰：「吾欲南之江上，何如？」對曰：「昔祝融爲髙辛氏火正，其功大矣，而其於周未有興者，楚其後也。周衰，楚必興。興，非鄭之利也。」公曰：「吾欲居西方，何如？」對曰：「其民貪而好利，難久居。」公曰：「周衰，何國興者？」對曰：「齊、秦、晉、楚乎？夫齊，姜姓，伯夷之後也，伯夷佐堯典禮。秦，嬴姓，伯翳之後也，伯翳佐舜懷柔百物。及楚之先，皆嘗有功於天下。而周武王克紂後，成王封叔虞于唐，其地阻險，以此有德與周衰并，亦必興矣。」桓公曰：「善。」於是卒言王，東徙其民雒東，而虢、鄶果獻十邑，竟國之。"}],"attestations":[{"id":"th-shiji042-002:a001","paragraph_id":"c-shiji-042-zheng:p001","start":250,"end":252,"surface":"火正","person_mention_id":"c-shiji-042-zheng:m001-0244","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"原文授予與用稱分開；相對年表述未換算，未知起訖不由卒日、逃亡或首次用稱補造，復入與廢黜仍待逐項保存。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji042-007","person_id":"057_xe9_rab","surfaces":["祝融"],"scope":"same_chapter","chapter_ids":["c-shiji-042-zheng"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-042-zheng:p001","quote":"鄭桓公友者，周厲王少子而宣王庶弟也。宣王立二十二年，友初封于鄭。封三十三歳，百姓皆便愛之。幽王以爲司徒。和集周民，周民皆説，河雒之閒，人便思之。爲司徒一歳，幽王以褒后故，王室治多邪，諸侯或畔之。於是桓公問太史伯曰：「王室多故，予安逃死乎？」太史伯對曰：「獨雒之東土，河濟之南可居。」公曰：「何以？」對曰：「地近虢、鄶，虢、鄶之君貪而好利，百姓不附。今公爲司徒，民皆愛公，公誠請居之，虢、鄶之君見公方用事，輕分公地。公誠居之，虢、鄶之民皆公之民也。」公曰：「吾欲南之江上，何如？」對曰：「昔祝融爲髙辛氏火正，其功大矣，而其於周未有興者，楚其後也。周衰，楚必興。興，非鄭之利也。」公曰：「吾欲居西方，何如？」對曰：「其民貪而好利，難久居。」公曰：「周衰，何國興者？」對曰：「齊、秦、晉、楚乎？夫齊，姜姓，伯夷之後也，伯夷佐堯典禮。秦，嬴姓，伯翳之後也，伯翳佐舜懷柔百物。及楚之先，皆嘗有功於天下。而周武王克紂後，成王封叔虞于唐，其地阻險，以此有德與周衰并，亦必興矣。」桓公曰：「善。」於是卒言王，東徙其民雒東，而虢、鄶果獻十邑，竟國之。"}],"rationale":"依本篇名字、是為、世系及連續事件暫接異稱；同諡不同國分開，建子勝與聲公勝不合併，如兄弟為譬喻不作親屬。述贊與正文不算獨立來