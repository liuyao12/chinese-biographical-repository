on_id":"k7x_gmp_ffr","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m001-0377","start":377,"end":378,"surface":"舜","kind":"person","person_id":"wex_fkp_gc1","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m001-0397","start":397,"end":400,"surface":"周武王","kind":"person","person_id":"k6e_9qv_u98","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m001-0401","start":401,"end":402,"surface":"紂","kind":"person","person_id":"jvs_fct_yow","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m001-0404","start":404,"end":406,"surface":"成王","kind":"person","person_id":"vht_3iv_u7e","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m001-0407","start":407,"end":409,"surface":"叔虞","kind":"person","person_id":"x2v_zid_ab0","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m001-0432","start":432,"end":434,"surface":"桓公","kind":"person","person_id":"mgh_3bh_rit_A","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m001-0444","start":444,"end":445,"surface":"王","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名、群體、泛稱或指代待核；不補姓名、成員或親屬關係。"}],"chapter_id":"c-shiji-042-zheng","book_id":"b-shiji-042","work_id":"w-shiji","source_id":"s-shiji-042-zheng"},{"id":"c-shiji-117-xiangru:p052","text":"邪絕少陽而登太陰兮，與真人乎相求。互折窈窕以右轉兮，橫厲飛泉以正東。悉徵靈圉而選之兮，部乘眾神於瑤光。使五帝先導兮，反太一而從陵陽。左玄冥而右含靁兮，前陸離而後潏湟。厮征北僑而役羡門兮，屬岐伯使尚方。祝融驚而蹕御兮，清氛氣而後行。屯余車其萬乘兮，綷雲蓋而樹華旗。使勾芒其將行兮，吾欲往乎南嬉。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m052-0011","start":11,"end":13,"surface":"真人","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"「真人」在「與真人乎相求」中為泛稱仙真，未指名特定人物，不另建個人ID。"},{"id":"c-shiji-117-xiangru:m052-0036","start":36,"end":38,"surface":"靈圉","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"「靈圉」在本篇另見p016、p058；句中列於靈類及眾神之間，未見足以判為一名可辨個體的證據，故不建立個人ID。"},{"id":"c-shiji-117-xiangru:m052-0045","start":45,"end":47,"surface":"眾神","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"「眾神」為集合稱呼，沒有逐一命名，不拆造個人。"},{"id":"c-shiji-117-xiangru:m052-0052","start":52,"end":54,"surface":"五帝","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"本句神帝群稱，不指定五個世系人物；五畤與古注轉報五時分存。"},{"id":"c-shiji-117-xiangru:m052-0059","start":59,"end":61,"surface":"太一","kind":"person","person_id":"d88_6lt_6ex","status":"contextual_provisional","interpretation_note":"如淳注指天極大星中太一常居，古注又釋為太一返回其所居、陵陽侍從；依此記作神話／星神人物。卷12「（大夫）［太一］」屬未定校讀，不據此接合。"},{"id":"c-shiji-117-xiangru:m052-0063","start":63,"end":65,"surface":"陵陽","kind":"person","person_id":"i4v_y28_wx0","status":"contextual_provisional","interpretation_note":"古注明稱仙人陵陽子明，與陽子古注所述陽陵子不能倒字合併。"},{"id":"c-shiji-117-xiangru:m052-0067","start":67,"end":69,"surface":"玄冥","kind":"person","person_id":"dal_xne_xt3","status":"contextual_provisional","interpretation_note":"古注稱北方黑帝之佐，只記神話身份，不補官爵任期或與其他祖系相接。"},{"id":"c-shiji-117-xiangru:m052-0071","start":71,"end":73,"surface":"含靁","kind":"person","person_id":"21k_m7f_sxc","status":"contextual_provisional","interpretation_note":"本篇含靁依所引注為黔嬴，造化神與水神兩說分存；不改原字，不將外部用字冒作本文別名。"},{"id":"c-shiji-117-xiangru:m052-0076","start":76,"end":78,"surface":"陸離","kind":"person","person_id":"oha_39m_mfa","status":"contextual_provisional","interpretation_note":"《史記集解》引《漢書音義》明釋本篇「陸離」為神名，故建立本篇所指的傳說神格ID。平行《漢書》作「長離」，顏師古另釋為靈鳥；不改本篇字形、不將長離接作別名，保留讀法差異。"},{"id":"c-shiji-117-xiangru:m052-0080","start":80,"end":82,"surface":"潏湟","kind":"person","person_id":"oj8_zfy_dkl","status":"contextual_provisional","interpretation_note":"本篇潏湟依注為神名；漢書矞皇用字另存，不先作跨見證別名定論。"},{"id":"c-shiji-117-xiangru:m052-0085","start":85,"end":87,"surface":"北僑","kind":"person","person_id":"36f_f1a_2zd","status":"contextual_provisional","interpretation_note":"本篇《史記》作「北僑」；依《集解》引徐廣為燕人、形解而仙者。平行《漢書》同句作「伯僑」，顏師古讀作姓征名伯僑，暫接為同一傳說人物；張揖說王子僑，顏師古明言非王子僑，故不與王子僑合併。"},{"id":"c-shiji-117-xiangru:m052-0089","start":89,"end":91,"surface":"羡門","kind":"person","person_id":"44s_fyq_t0d","status":"contextual_provisional","interpretation_note":"張揖釋碣石仙人羡門高，與始皇本紀碣石求羨門的名號及地域互證；保留羡／羨原字，不把高誓併成同名，也不補仙人生卒或任期。"},{"id":"c-shiji-117-xiangru:m052-0094","start":94,"end":96,"surface":"岐伯","kind":"person","person_id":"l4l_iz8_ao0","status":"contextual_provisional","interpretation_note":"本篇岐伯主方藥，張揖明釋黃帝太醫；孝武本紀公玉帶亦引黃帝時岐伯，暫接同一傳說人物，不據賦辭增造官職或出行事件。"},{"id":"c-shiji-117-xiangru:m052-0100","start":100,"end":102,"surface":"祝融","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"本句只稱祝融驚而蹕御；《史記》卷40記重黎與其弟呉回先後受祝融之名，卷42另以祝融稱高辛氏火正祖系，卷40篇末又見祝融祀典。所指可為不同傳說人物、神格或職名，未能定一，詳見本段異說記錄。"},{"id":"c-shiji-117-xiangru:m052-0132","start":132,"end":134,"surface":"勾芒","kind":"person","person_id":"hd8_aho_qei","status":"contextual_provisional","interpretation_note":"本篇勾芒與漢書句芒各存，古注稱東方青帝之佐；不按造形補生平或親屬。"}],"chapter_id":"c-shiji-117-xiangru","book_id":"b-shiji-117","work_id":"w-shiji","source_id":"s-shiji117-xiangru"}],"sources":[{"chapter_id":"c-shiji-042-zheng","work_id":"w-shiji","book_id":"b-shiji-042","source_id":"s-shiji-042-zheng","source":{"title":"史記／卷042","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷042","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷042&oldid=2016409","revision_id":2016409,"accessed_on":"2026-10-09","extent":"59段正文及1段分層索隱述贊；排除2個dd導覽，只去除段落外緣空白。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"固定修訂與取得時HTML一致；保留古代異體、九月（辛）［丁］亥等校勘符號及溉逐、掔羊、持兩端等疑讀，不擅選讀法。","note":"全60段數位正文已閱讀；未核古籍影像、可靠底本及現代研究。"}}},{"chapter_id":"c-shiji-117-xiangru","work_id":"w-shiji","book_id":"b-shiji-117","source_id":"s-shiji117-xiangru","source":{"title":"史記／卷117","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷117","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷117&oldid=10371549","revision_id":10371549,"accessed_on":"2026-10-11","extent":"固定修訂全文71段，包括賦、書與末段索隱述贊。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"去header2、目錄標記及現代節標；quote模板保留全文，br轉段落；罕字模板保留第一參數字形，描述未作正文；連結保留顯示字。未核影像。 移除防轉換控制外殼，保留內字云。","note":"第58段U+E0FA私用字缺字與頌中重句原樣保存，不猜補；末段索隱述贊分層。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true}}
