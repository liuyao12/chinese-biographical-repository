,"table_id":"shiji-022","table_fragment_id":"shiji-022-digital-table-1","table_row_id":"shiji-022-t1-r052","table_cell_id":"shiji-022-t1-r052-c02","work_id":"w-shiji","book_id":"b-shiji-022","chapter_id":"table-chapter-shiji-022","source_id":"table-witness-shiji-022","source_revision":"2607038","kind":"table_person_mention","quote_ref":"cell"}],"date_range_normalizations":[{"earliest":{"era":"BCE","era_year":156,"year":-155},"latest":{"era":"BCE","era_year":155,"year":-154},"year_numbering":"astronomical","precision":"year_range","basis":"regnal_year_crosses_ce_year","status":"editorial_provisional","original_quote":"嘉為丞相五歲，孝文帝崩，孝景帝即位。二年，晁錯為內史，貴幸用事，諸法令多所請變更，議以謫罰侵削諸侯。而丞相嘉自絀所言不用，疾錯。錯為內史，門東出，不便，更穿一門南出。南出者，太上皇廟堧垣。嘉聞之，欲因此以法錯擅穿宗廟垣為門，奏請誅錯。錯客有語錯，錯恐，夜入宮上謁，自歸景帝。至朝，丞相奏請誅內史錯。景帝曰：「錯所穿非真廟垣，乃外堧垣，故他官居其中，且又我使為之，錯無罪。」罷朝，嘉謂長史曰：「吾悔不先斬錯，乃先請之，為錯所賣。」至舍，因歐血而死。謚為節侯。子共侯蔑代，三年卒。子侯去病代，三十一年卒。子侯臾代，六歲，坐為九江太守受故官送有罪，國除。","evidence":[{"chapter_id":"c-shiji-096-zhang","source_id":"s-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p018","person_mention_id":"c-shiji-096-zhang:m018-0000","quote_passage_ref":"data/corpus/shiji/096.json"}],"references":[{"title":"《史記·漢興以來將相名臣年表》景帝年序起點","url":"https://zh.wikisource.org/w/index.php?title=史記/卷022&oldid=2607038","quote":"孝景元年","scope":"received_regnal_year_attestation","table_cell_id":"shiji-022-t1-r051-c01","image_verified":false},{"title":"《史記·漢興以來將相名臣年表》原年欄","url":"https://zh.wikisource.org/w/index.php?title=史記/卷022&oldid=2607038","quote":"二","scope":"received_regnal_year_attestation","table_cell_id":"shiji-022-t1-r052-c01","image_verified":false},{"title":"《史記·漢興以來將相名臣年表》數位西元對照","url":"https://zh.wikisource.org/w/index.php?title=史記/卷022&oldid=2607038","quote":"155","scope":"digital_editorial_regnal_year_equivalence_only","table_cell_id":"shiji-022-t1-r052-c00","image_verified":false},{"title":"《史記·漢興以來將相名臣年表》同年死亡記載","url":"https://zh.wikisource.org/w/index.php?title=史記/卷022&oldid=2607038","quote":"立皇子德為河閒王，閼為臨江王，餘為淮陽王，非為汝南王，彭祖為廣川王，發為長沙王。四月中，孝文太后崩。嘉卒。","scope":"received_parallel_event","table_cell_id":"shiji-022-t1-r052-c02","image_verified":false},{"title":"《史記·張丞相列傳》漢初歲首","url":"https://zh.wikisource.org/w/index.php?title=史記/卷096&oldid=8770206","quote":"以高祖十月始至霸上，因故秦時本以十月為歲首，弗革。","scope":"received_calendar_rule","image_verified":false}],"rationale":"本篇景帝紀年與年表原年欄、死亡敘事相配；西元數字僅取數位編者對照，與受傳原文分列。漢初仍以十月為歲首，死亡月份不明，該年可能落前一西元年末或對照年，保留兩年範圍，不當確定單年。嘉卒與表中太后四月卒分句，不據此替申屠嘉補死亡月份。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"record_id":"le-shiji096-006","person_id":"yph_dkb_w4w","date_role":"life_event","event_type":"death"}],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji011-011","person_id":"yph_dkb_w4w","surfaces":["申屠嘉"],"scope":"cross_chapter","chapter_ids":["c-shiji-010-wendi","c-shiji-011-jingdi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-010-wendi:p011","quote_passage_ref":"data/corpus/shiji/010.json"},{"paragraph_id":"c-shiji-011-jingdi:p003","quote_passage_ref":"data/corpus/shiji/011.json"}],"rationale":"景帝朝、七國戰事及前卷接任／分封敘事相接，所列異稱按上下文暫定；同名不作全庫替換，未名者不補姓名。申屠／申徒嘉依前卷朝廷職事與本卷丞相卒事暫定，仍待列傳及版本覆核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji096-025","person_id":"yph_dkb_w4w","scope":"same_chapter","chapter_ids":["c-shiji-096-zhang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["嘉","申屠","申屠丞相嘉","申屠嘉","丞相"],"evidence":[{"paragraph_id":"c-shiji-096-zhang:p016","quote_passage_ref":"data/corpus/shiji/096.json"},{"paragraph_id":"c-shiji-096-zhang:p017","quote_passage_ref":"data/corpus/shiji/096.json"},{"paragraph_id":"c-shiji-096-zhang:p018","quote_passage_ref":"data/corpus/shiji/096.json"},{"paragraph_id":"c-shiji-096-zhang:p019","quote_passage_ref":"data/corpus/shiji/096.json"},{"paragraph_id":"c-shiji-096-zhang:p020","quote_passage_ref":"data/corpus/shiji/096.json"},{"paragraph_id":"c-shiji-096-zhang:p030","quote_passage_ref":"data/corpus/shiji/096.json"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定短稱；韋賢與韋玄成分傳區別，第23段掾陳平另候選，第25段長安相工田文不與孟嘗君合併。趙堯、任敖、申屠嘉、鄧通、晁錯的短名依各段人物語境，王陵夫人與王陵分人。張蒼父長不滿五尺的長為身長敘述，不作父名。王侯與太子未詳名不補名，跨篇同指另待證據。 第十七段入朝、奏事、困鄧通、受謝及鄧通引語的丞相均為申屠嘉，第十八段奏誅內史者亦同；丞相府為地點，竇廣國擬相另記未實行。"},{"id":"d-shiji101-005","person_id":"yph_dkb_w4w","surfaces":["丞相嘉","嘉","申屠嘉"],"scope":"same_chapter","chapter_ids":["c-shiji-101-yuanchao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-101-yuanchao:p010","quote_passage_ref":"data/corpus/shiji/101.json"},{"paragraph_id":"c-shiji-101-yuanchao:p018","quote_passage_ref":"data/corpus/shiji/101.json"}],"rationale":"按本傳明示姓名、字及敘事承接；皇帝上字逐處依文景敘事核定，建元上另留未名。兄噲不合樊噲，兄子種不補具名父親。身份及官稱回指為代理首輪判讀，非人工覆核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji101-context-003","person_id":"yph_dkb_w4w","surfaces":["丞相"],"scope":"same_chapter","chapter_ids":["c-shiji-101-yuanchao"],"status":"contextual_provisional","evidence":[{"work_id":"w-shiji","book_id":"b-shiji-101","chapter_id":"c-shiji-101-yuanchao","source_id":"s-shiji-101-yuanchao","paragraph_id":"c-shiji-101-yuanchao:p018","mention_ids":["c-shiji-101-yuanchao:m018-0113","c-shiji-101-yuanchao:m018-0154","c-shiji-101-yuanchao:m018-0188"],"quote_passage_ref":"data/corpus/shiji/101.json"}],"rationale":"丞相奏事、丞相謝與丞相遂發病死皆承同段申屠嘉，未名長史不補身份。 保留原詞及位置，不按同字全域配對；未核書影。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"equivalence_decisions":[{"id":"eq-shiji096-continuation-shentujia","person_ids":["yph_dkb_w4w"],"canonical_person_id":"yph_dkb_w4w","scope":"cross_chapter","chapter_ids":["c-shiji-096-zhang","c-shiji-011-jingdi","c-shiji-101-yuanchao"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-096-zhang","source_id":"s-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p016","mention_ids":["c-shiji-096-zhang:m016-0000","c-shiji-096-zhang:m016-0080","c-shiji-096-zhang:m016-0096","c-shiji-096-zhang:m016-0177"],"quote_passage_ref":"data/corpus/shiji/096.json"},{"chapter_id":"c-shiji-096-zhang","source_id":"s-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p017