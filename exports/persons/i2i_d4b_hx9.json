,"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-057-northern-wei-complete:p014","text":"偽昌黎王馮莎向司州，荒人桓天生說莎云：「諸蠻皆響應。」莎至，蠻竟不動。莎大怒，於淮邊獵而去。及壽春摧敗，朐山不拔，虜主出定州，大治道路，聲欲南行，不敢進。迺與偽梁郡王計曰：「兵出彭、泗間，無復鬬志，要當一兩戰得還歸。」既於淮陽被破，一時奔走。青、徐間赴義民，先是或抄虜運車，更相殺掠，往往得南歸者數千家。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":36,"last_line":36,"raw_start":2960,"raw_end":3112,"raw_character_offsets":[2960,2961,2962,2963,2964,2965,2966,2967,2968,2969,2970,2971,2972,2973,2974,2975,2976,2977,2978,2979,2980,2981,2982,2983,2984,2985,2986,2987,2988,2989,2990,2991,2992,2993,2994,2995,2996,2997,2998,2999,3000,3001,3002,3003,3004,3005,3006,3007,3008,3009,3010,3011,3012,3013,3014,3015,3016,3017,3018,3019,3020,3021,3022,3023,3024,3025,3026,3027,3028,3029,3030,3031,3032,3033,3034,3035,3036,3037,3038,3039,3040,3041,3042,3043,3044,3045,3046,3047,3048,3049,3050,3051,3052,3053,3054,3055,3056,3057,3058,3059,3060,3061,3062,3063,3064,3065,3066,3067,3068,3069,3070,3071,3072,3073,3074,3075,3076,3077,3078,3079,3080,3081,3082,3083,3084,3085,3086,3087,3088,3089,3090,3091,3092,3093,3094,3095,3096,3097,3098,3099,3100,3101,3102,3103,3104,3105,3106,3107,3108,3109,3110,3111],"revision_id":1999801},"mentions":[{"id":"c-nanqishu-057-northern-wei-complete:p014:m0004","start":4,"end":6,"surface":"馮莎","kind":"person","person_id":"d91_oe3_mrc","status":"contextual_provisional"},{"id":"c-nanqishu-057-northern-wei-complete:p014:m0012","start":12,"end":15,"surface":"桓天生","kind":"person","person_id":"i2i_d4b_hx9","status":"contextual_provisional"},{"id":"c-nanqishu-057-northern-wei-complete:p014:m0016","start":16,"end":17,"surface":"莎","kind":"person","person_id":"d91_oe3_mrc","status":"contextual_provisional"},{"id":"c-nanqishu-057-northern-wei-complete:p014:m0027","start":27,"end":28,"surface":"莎","kind":"person","person_id":"d91_oe3_mrc","status":"contextual_provisional"},{"id":"c-nanqishu-057-northern-wei-complete:p014:m0035","start":35,"end":36,"surface":"莎","kind":"person","person_id":"d91_oe3_mrc","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-057-northern-wei-complete","book_id":"b-nanqishu-057","work_id":"w-nanqishu","source_id":"s-nanqishu-057-northern-wei-complete-ws1999801"},{"id":"c-nanqishu-057-northern-wei-complete:p018","text":"明年，邊人桓天生作亂，虜遣步騎萬餘人助之，至比陽，為征虜將軍戴僧靜等所破。荒人胡丘生起義懸瓠，為虜所擊，戰敗南奔。偽安南將軍遼東公、平南將軍上谷公又攻舞陰，舞陰戍主輔國將軍殷公愍拒破之。六年，虜又遣眾助桓天生，與輔國將軍曹虎戰，大敗於隔城。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":44,"last_line":44,"raw_start":4362,"raw_end":4648,"raw_character_offsets":[4362,4363,4364,4365,4366,4367,4368,4369,4370,4371,4372,4373,4374,4375,4376,4377,4378,4379,4380,4381,4382,4383,4384,4385,4386,4387,4388,4389,4390,4391,4392,4393,4394,4395,4396,4397,4398,4399,4400,4401,4402,4403,4404,4405,4406,4407,4408,4409,4410,4411,4412,4413,4414,4415,4416,4417,4418,4419,4420,4421,4422,4423,4424,4425,4426,4427,4428,4429,4430,4431,4432,4433,4434,4435,4436,4437,4438,4439,4606,4607,4608,4609,4610,4611,4612,4613,4614,4615,4616,4617,4618,4619,4620,4621,4622,4623,4624,4625,4626,4627,4628,4629,4630,4631,4632,4633,4634,4635,4636,4637,4638,4639,4640,4641,4642,4643,4644,4645,4646,4647],"revision_id":1999801},"mentions":[{"id":"c-nanqishu-057-northern-wei-complete:p018:m0005","start":5,"end":8,"surface":"桓天生","kind":"person","person_id":"i2i_d4b_hx9","status":"contextual_provisional"},{"id":"c-nanqishu-057-northern-wei-complete:p018:m0101","start":101,"end":104,"surface":"桓天生","kind":"person","person_id":"i2i_d4b_hx9","status":"contextual_provisional"},{"id":"c-nanqishu-057-northern-wei-complete:p018:m0110","start":110,"end":112,"surface":"曹虎","kind":"person","person_id":"jg8_wco_v2f","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-057-northern-wei-complete","book_id":"b-nanqishu-057","work_id