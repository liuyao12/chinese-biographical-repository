{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000348","identity_policy":"contextual_provisional","person_ids":["cbr-p000348"],"persons":[{"id":"cbr-p000348","label":"竫公","status":"active","historicity":"historical_tradition","aliases":[{"surface":"竫公","mention_ids":["c-shiji-005-qin:m010-0182","c-shiji-005-qin:m010-0185","c-shiji-005-qin:m010-0212"]}],"evidence":[{"mention_id":"c-shiji-005-qin:m010-0182","chapter_id":"c-shiji-005-qin","paragraph_id":"c-shiji-005-qin:p010","quote":"竫公"},{"mention_id":"c-shiji-005-qin:m010-0185","chapter_id":"c-shiji-005-qin","paragraph_id":"c-shiji-005-qin:p010","quote":"竫公"},{"mention_id":"c-shiji-005-qin:m010-0212","chapter_id":"c-shiji-005-qin","paragraph_id":"c-shiji-005-qin:p010","quote":"竫公"}],"identity_note":"依本卷特定時代與敘事暫定身份；稱號同字不跨時代合併，未見本名不補造。","review":"ai_provisional"}],"mentions":[{"id":"c-shiji-005-qin:m010-0182","start":182,"end":184,"surface":"竫公","kind":"person","person_id":"cbr-p000348","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p010","chapter_id":"c-shiji-005-qin"},{"id":"c-shiji-005-qin:m010-0185","start":185,"end":187,"surface":"竫公","kind":"person","person_id":"cbr-p000348","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p010","chapter_id":"c-shiji-005-qin"},{"id":"c-shiji-005-qin:m010-0212","start":212,"end":214,"surface":"竫公","kind":"person","person_id":"cbr-p000348","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p010","chapter_id":"c-shiji-005-qin"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-005-qin:p010","text":"文公元年，居西垂宮。三年，文公以兵七百人東獵。四年，至汧渭之會。曰：「昔周邑我先秦嬴於此，後卒獲為諸侯。」乃卜居之，占曰吉，即營邑之。十年，初為鄜畤，用三牢。十三年，初有史以紀事，民多化者。十六年，文公以兵伐戎，戎敗走。於是文公遂收周餘民有之，地至岐，岐以東獻之周。十九年，得陳寶。二十年，法初有三族之罪。二十七年，伐南山大梓，豐大特。四十八年，文公太子卒，賜謚為竫公。竫公之長子為太子，是文公孫也。五十年，文公卒，葬西山。竫公子立，是為寧公。","annotation_status":"named_mentio