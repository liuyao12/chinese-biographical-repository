ested","evidence":[{"chapter_id":"c-shiji-080-leyi","source_id":"s-shiji-080-leyi","paragraph_id":"c-shiji-080-leyi:p001","quote":"樂毅者，其先祖曰樂羊。樂羊為魏文侯將，伐取中山，魏文侯封樂羊以靈壽。樂羊死，葬於靈壽，其後子孫因家焉。中山復國，至趙武靈王時復滅中山，而樂氏後有樂毅。"}],"attestations":[{"id":"th-shiji080-001:a001","paragraph_id":"c-shiji-080-leyi:p001","start":17,"end":18,"surface":"將","person_mention_id":"c-shiji-080-leyi:m001-0011","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授任與文獻用稱分存；卒、出走及降趙不自動終止所有爵位，未見日期保持未定。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji080-002","person_id":"cbr-p004556","surfaces":["樂羊"],"scope":"same_chapter","chapter_ids":["c-shiji-080-leyi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-080-leyi:p001","quote":"樂毅者，其先祖曰樂羊。樂羊為魏文侯將，伐取中山，魏文侯封樂羊以靈壽。樂羊死，葬於靈壽，其後子孫因家焉。中山復國，至趙武靈王時復滅中山，而樂氏後有樂毅。"}],"rationale":"樂閒明示為樂毅子，樂叔明示為孫，不補闕代父親；樂乘為樂閒宗不補兄弟。燕王喜來書及趙襄王君序各限本段，曹相國未見名字不回填。河上丈人至蓋公師承不作父子。依本篇明示姓名、君序與來書答書範圍暫接；燕惠王來書寡人指惠王、將軍指樂毅，樂毅答書先王指昭王、足下君王指惠王。伍子胥引古首吳王指闔閭，後吳王在夫差賜鴟夷後指夫差。父兄與群臣不補具體親屬，王齊為反間假說不作授王爵。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-080-leyi:p001","text":"樂毅者，其先祖曰樂羊。樂羊為魏文侯將，伐取中山，魏文侯封樂羊以靈壽。樂羊死，葬於靈壽，其後子孫因家焉。中山復國，至趙武靈王時復滅中山，而樂氏後有樂毅。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-080-leyi:m001-0000","start":0,"end":2,"surface":"樂毅","kind":"person","person_id":"cbr-p004555","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m001-0008","start":8,"end":10,"surface":"樂羊","kind":"person","person_id":"cbr-p004556","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m001-0011","start":11,"end":13,"surface":"樂羊","kind":"person","person_id":"cbr-p004556","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m001-0014","start":14,"end":17,"surface":"魏文侯","kind":"