end":368,"surface":"齊悼惠王","kind":"person","person_id":"yqp_nlb_p1p_AB","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m010-0369","start":369,"end":371,"surface":"興居","kind":"person","person_id":"pdj_awg_50i","status":"contextual_provisional"}],"chapter_id":"c-shiji-009-lvhou","book_id":"b-shiji-009","work_id":"w-shiji","source_id":"s-shiji-009-lvhou"},{"id":"c-shiji-009-lvhou:p017","text":"太傅產、丞相平等言，武信侯呂祿上侯，位次第一，請立為趙王。太后許之，追尊祿父康侯為趙昭王。九月，燕靈王建薨，有美人子，太后使人殺之，無後，國除。八年十月，立呂肅王子東平侯呂通為燕王，封通弟呂莊為東平侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-009-lvhou:m017-0000","start":0,"end":3,"surface":"太傅產","kind":"person","person_id":"acg_se3_w5x_B","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m017-0004","start":4,"end":7,"surface":"丞相平","kind":"person","person_id":"i3f_9l9_g53","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m017-0013","start":13,"end":15,"surface":"呂祿","kind":"person","person_id":"561_608_i0z","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m017-0029","start":29,"end":31,"surface":"太后","kind":"person","person_id":"i30_mjq_6q8_A","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m017-0038","start":38,"end":40,"surface":"康侯","kind":"person","person_id":"c90_m9w_lqu","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m017-0048","start":48,"end":52,"surface":"燕靈王建","kind":"person","person_id":"yqp_nlb_p1p_AG","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m017-0055","start":55,"end":57,"surface":"美人","kind":"person","person_id":"wuf_z4a_3vn","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m017-0057","start":57,"end":58,"surface":"子","kind":"person","person_id":"djc_n3a_hms","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m017-0059","start":59,"end":61,"surface":"太后","kind":"person","person_id":"i30_mjq_6q8_A","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m017-0069","start":69,"end":71,"su