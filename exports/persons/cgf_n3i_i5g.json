red","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-058-luxun:line033:m0069","start":69,"end":71,"surface":"朱桓","kind":"person","person_id":"cgf_n3i_i5g","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-058-luxun:line033","chapter_id":"c-sanguozhi-058-luxun"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-058-luxun:line033","text":"七年，權使鄱陽太守周魴譎魏大司馬曹休。休果舉眾入皖，乃召遜假黃鉞，為大都督，逆休。休既覺知，恥見欺誘，自恃兵馬精多，遂交戰。遜自為中部，令朱桓、全琮為左右冀，三道俱近，果沖休伏兵，因驅走之，追亡逐北，逕至夾石，斬獲萬餘，牛馬騾驢車乘萬輛，軍資器械略盡。休還，疽發背死。諸軍振旅過武昌，權令左右以御蓋覆遜，入出殿門。凡所賜遜，皆御物上珍，於時莫與為比。遣還西陵。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-058-luxun:line033:m0003","start":3,"end":4,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line033:m0009","start":9,"end":11,"surface":"周魴","kind":"person","person_id":"iuc_mqu_3jm","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line033:m0017","start":17,"end":18,"surface":"休","kind":"person","person_id":"h7n_w5t_i1c_AA","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line033:m0019","start":19,"end":20,"surface":"休","kind":"person","person_id":"h7n_w5t_i1c_AA","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line033:m0028","start":28,"end":29,"surface":"遜","kind":"person","person_id":"lii_454_vuv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line033:m0039","start":39,"end":40,"surface":"休","kind":"person","person_id":"h