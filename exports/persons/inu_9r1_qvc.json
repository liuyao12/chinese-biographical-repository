不與通，使人告景。景即委郡東歸，策復以景為丹揚太守。漢遣議郎王誧銜命南行，表景為揚武將軍，領郡如故。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-050-wu:line014:m0000","start":0,"end":1,"surface":"景","kind":"person","person_id":"ere_ume_47r","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-wu:line014:m0003","start":3,"end":4,"surface":"堅","kind":"person","person_id":"ki7_rgz_3l4","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-wu:line014:m0015","start":15,"end":16,"surface":"術","kind":"person","person_id":"865_b69_cb0","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-wu:line014:m0017","start":17,"end":18,"surface":"景","kind":"person","person_id":"ere_ume_47r","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-wu:line014:m0028","start":28,"end":30,"surface":"周昕","kind":"person","person_id":"lsy_sjz_pse","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-wu:line014:m0037","start":37,"end":38,"surface":"策","kind":"person","person_id":"e9c_070_567","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-wu:line014:m0039","start":39,"end":41,"surface":"孫河","kind":"person","person_id":"07n_fwj_5jn","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-wu:line014:m0042","start":42,"end":44,"surface":"呂範","kind":"person","person_id":"908_816_219","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-wu:line014:m0045","start":45,"end":46,"surface":"景","kind":"person","person_id":"ere_ume_47r","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-wu:line014:m0056","start":56,"end":57,"surface":"郎","kind":"person","person_id":"r9q_7ps_byt","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguo