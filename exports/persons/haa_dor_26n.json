6","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授受、文獻用稱與任期端點分存；日期限所屬敘事，未跨段套用。故侯與失侯保留原文事件，不以死亡自動終止所有爵位。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji114-030","person_id":"haa_dor_26n","title":"案道侯","kind":"noble_rank","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-114-dongyue","source_id":"s-shiji114-dongyue","paragraph_id":"c-shiji-114-dongyue:p009","quote":"故越衍侯吳陽前在漢，漢使歸諭餘善，餘善弗聽。及橫海將軍先至，越衍侯吳陽以其邑七百人反，攻越軍於漢陽。從建成侯敖，與其率，從繇王居股謀曰：「餘善首惡，劫守吾屬。今漢兵至，眾彊，計殺餘善，自歸諸將，儻幸得脫。」乃遂俱殺餘善，以其眾降橫海將軍，故封繇王居股為東成侯，萬戶；封建成侯敖為開陵侯；封越衍侯吳陽為北石侯；封橫海將軍說為案道侯；封橫海校尉福為繚嫈侯。福者，成陽共王子，故為海常侯，坐法失侯。舊從軍無功，以宗室故侯。諸將皆無成功，莫封。東越將多軍，漢兵至，棄其軍降，封為無錫侯。"}],"attestations":[{"id":"th-shiji114-030:a001","paragraph_id":"c-shiji-114-dongyue:p009","start":161,"end":164,"surface":"案道侯","person_mention_id":"c-shiji-114-dongyue:m009-0023","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-114-dongyue","source_id":"s-shiji114-dongyue","paragraph_id":"c-shiji-114-dongyue:p009","quote":"故越衍侯吳陽前在漢，漢使歸諭餘善，餘善弗聽。及橫海將軍先至，越衍侯吳陽以其邑七百人反，攻越軍於漢陽。從建成侯敖，與其率，從繇王居股謀曰：「餘善首惡，劫守吾屬。今漢兵至，眾彊，計殺餘善，自歸諸將，儻幸得脫。」乃遂俱殺餘善，以其眾降橫海將軍，故封繇王居股為東成侯，萬戶；封建成侯敖為開陵侯；封越衍侯吳陽為北石侯；封橫海將軍說為案道侯；封橫海校尉福為繚嫈侯。福者，成陽共王子，故為海常侯，坐法失侯。舊從軍無功，以宗室故侯。諸將皆無成功，莫封。東越將多軍，漢兵至，棄其軍降，封為無錫侯。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授受、文獻用稱與任期端點分存；日期限所屬敘事，未跨段套用。故侯與失侯保留原文事件，不以死亡自動終止所有爵位。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-114-dongyue:p008","text":"餘善刻「武帝」璽自立，詐其民，為妄言。天子遣橫海將軍韓說出句章，浮海從東方往；樓船將軍楊仆出武林；中尉王溫舒出梅嶺；越侯為戈船、下瀨將軍，出若邪、白沙。元封元年冬，咸入東越。東越素發兵距險，使徇北將軍守武林，敗樓船軍數校尉，殺長吏。樓船將軍率錢唐轅終古斬徇北將軍，為御兒侯。自兵未往。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-114-dongyue:m008-0000","start":0,"end":2,"surface":"餘善","kind":"person","person_id":"jcd_7n3_ttu","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m008-0019","start":19,"end":21,"surface":"天子","kind":"person","person_id":"y1h_fo3_brs","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m008-0026","start":26,"end":28,"surface":"韓說","kind":"person","person_id":"haa_dor_26n","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m008-0039","start":39,"end":43,"surface":"樓船將軍","kind":"person","person_id":"vpa_634_wf3","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m008-0043","start":43,"end":45,"surface":"楊仆","kind":"person","person_id":"vpa_634_wf3","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m008-0051","start":51,"end":54,"surface":"王溫舒","kind":"person","person_id":"0c3_ttl_f14","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m008-0061","start":61,"end":63,"surface":"戈船","kind":"person","person_id":"ys3_xrq_d6u","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m008-0064","start":64,"end":66,"surface":"下瀨","kind":"person","person_id":"905_rao_ff0","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m008-0096","start":96,"end":100,"surface":"徇北將軍","kind":"person","person_id":"u5g_scl_2bs","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m008-0105","start":105,"end":107,"surface":"樓船","kind":"person","person_id":"vpa_634_wf3","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m008-0116","start":116,"end":120,"surface":"樓船將軍","kind":"person","person_id":"vpa_634_wf3","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m008-0123","start":123,"end":126,"surface":"轅終古","kind":"person","person_id":"08e_bwz_ync","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m008-0127","start":127,"end":131,"surface":"徇北將軍","kind":"person","person_id":"u5g_scl_2bs","status":"contextual_provisional"}],"chapter_id":"c-shiji-114-dongyue","book_id":"b-shiji-114","work_id":"w-shiji","source_id":"s-shiji114-dongyue"},{"id":"c-shiji-114-dongyue:p009","text":"故越衍侯吳陽前在漢，漢使歸諭餘善，餘善弗聽。及橫海將軍先至，越衍侯吳陽以其邑七百人反，攻越軍於漢陽。從建成侯敖，與其率，從繇王居股謀曰：「餘善首惡，劫守吾屬。今漢兵至，眾彊，計殺餘善，自歸諸將，儻幸得脫。」乃遂俱殺餘善，以其眾降橫海將軍，故封繇王居股為東成侯，萬戶；封建成侯敖為開陵侯；封越衍侯吳陽為北石侯；封橫海將軍說為案道侯；封橫海校尉福為繚嫈侯。福者，成陽共王子，故為海常侯，坐法失侯。舊從軍無功，以宗室故侯。諸將皆無成功，莫封。東越將多軍，漢兵至，棄其軍降，封為無錫侯。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-114-dongyue:m009-0004","start":4,"end":6,"surface":"吳陽","kind":"person","person_id":"bxw_vv0_1t3","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m009-0014","start":14,"end":16,"surface":"餘善","kind":"person","person_id":"jcd_7n3_ttu","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m009-0017","start":17,"end":19,"surface":"餘善","kind":"person","person_id":"jcd_7n3_ttu","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m009-0023","start":23,"end":27,"surface":"橫海將軍","kind":"person","person_id":"haa_dor_26n","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m009-0033","start":33,"end":35,"surface":"吳陽","kind":"person","person_id":"bxw_vv0_1t3","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m009-0054","start":54,"end":55,"surface":"敖","kind":"person","person_id":"43i_62q_gf6","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m009-0063","start":63,"end":65,"surface":"居股","kind":"person","person_id":"1bh_uew_js1","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m009-0069","start":69,"end":71,"surface":"餘善","kind":"person","person_id":"jcd_7n3_ttu","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m009-0089","start":89,"end":91,"surface":"餘善","kind":"person","person_id":"jcd_7n3_ttu","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m009-0107","start":107,"end":109,"surface":"餘善","kind":"person","pe