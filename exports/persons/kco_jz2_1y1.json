hu-062-zuti:p004:m0045","surface":"董瞻","start":45,"end":47,"person_id":"kco_jz2_1y1","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-062-zuti:p004","chapter_id":"c-jinshu-062-zuti"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-062-zuti:p004","text":"初，北中郎將劉演距于石勒也，流人塢主張平、樊雅等在譙，演署平爲豫州刺史，雅爲譙郡太守。又有董瞻、于武、謝浮等十餘部，眾各數百，皆統屬平。逖誘浮使取平，浮譎平與會，遂斬以獻逖。帝嘉逖勳，使運糧給之，而道遠不至，軍中大饑。進據太丘。樊雅遣眾夜襲逖，遂入壘，拔戟大呼，直趣逖幕，軍土大亂。逖命左右距之，督護董昭與賊戰，走之。逖率眾追討，而張平餘眾助雅攻逖。蓬陂塢主陳川，自號甯朔將軍、陳留太守。逖遣使求救於川，川遣將李頭率眾援之，逖遂克譙城。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":89,"last_line":89,"raw_start":8970,"raw_end":9190,"raw_character_offsets":[8972,8973,8974,8975,8976,8977,8978,8979,8980,8981,8982,8983,8984,8985,8986,8987,8988,8989,8990,8991,8992,8993,8994,8995,8996,8997,8998,8999,9000,9001,9002,9003,9004,9005,9006,9007,9008,9009,9010,9011,9012,9013,9014,9015,9016,9017,9018,9019,9020,9021,9022,9023,9024,9025,9026,9027,9028,9029,9030,9031,9032,9033,9034,9035,9036,9037,9038,9039,9040,9041,9042,9043,9044,9045,9046,9047,9048,9049,9050,9051,9052,9053,9054,9055,9056,9057,9058,9059,9060,9061,9062,9063,9064,9065,9066,9067,9068,9069,9070,9071,9072,9073,9074,9075,9076,9077,9078,9079,9080,9081,9082,9083,9084,9085,9086,9087,9088,9089,9090,9091,9092,9093,9094,9095,9096,9097,9098,9099,9100,9101,9102,9103,9104,9105,9106,9107,9108,9109,9110,9111,9112,9113,9114,9115,9116,9117,9118,9119,9120,9121,9122,9123,9124,9125,9126,9127,9128,9129,9130,9131,9132,9133,9134,9135,9136,9137,9138,9139,9140,9141,9142,9143,9144,9145,9146,9147,9148,9149,9150,9151,9152,9153,9154,9155,9156,9157,9158,9159,9160,9161,9162,9163,9164,9165,9166,9167,9168,9169,9170,9171,9172,9173,9174,9175,9176,9177,9178,9179,9180,9181,9182,9183,9184,9185,9186,9187,9188,9189],"revision_id":2629226},"mentions