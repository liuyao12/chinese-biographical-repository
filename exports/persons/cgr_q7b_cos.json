ace":"瞻","start":10,"end":11,"person_id":"5r7_x6g_gtf","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan-sons-intro:p001:m0012","surface":"夏","start":12,"end":13,"person_id":"cgr_q7b_cos","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan-sons-intro:p001:m0014","surface":"琦","start":14,"end":15,"person_id":"07z_b9y_29n","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan-sons-intro:p001:m0016","surface":"旗","start":16,"end":17,"person_id":"0wt_4fd_ozd","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan-sons-intro:p001:m0018","surface":"斌","start":18,"end":19,"person_id":"byj_6mo_vpe","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan-sons-intro:p001:m0020","surface":"稱","start":20,"end":21,"person_id":"5fa_457_ec8","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan-sons-intro:p001:m0022","surface":"範","start":22,"end":23,"person_id":"9ec_nm1_cfh","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan-sons-intro:p001:m0024","surface":"岱","start":24,"end":25,"person_id":"287_n93_pi3","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-066-taokan-sons-intro","book_id":"b-jinshu-066","work_id":"w-jinshu","source_id":"s-jinshu-066-taokan-sons-intro-ws1527632"},{"id":"c-jinshu-066-taokan:p012","text":"太興初，進號平南將軍，尋加都督交州軍事。及王敦舉兵反，詔侃以本官領江州刺史，尋轉都督、湘州刺史。敦得志，上侃復本職，加散騎常侍。時交州刺史王諒為賊梁碩所陷，侃遣將高寶進擊平之。以侃領交州刺史。錄前後功，封次子夏為都亭侯，進號征南大將軍、開府儀同三司。及王敦平，遷都督荊、雍、益、梁州諸軍事，領護南蠻校尉、征西大將軍、荊州刺史，余如故。楚郢士女莫不相慶。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":51,"last_line":51,"raw_start":5864,"raw_end":6042,"raw_character_offsets":[5866,5867,5868,5869,5870,5871,5872,5873,5874,5875,5876,5877,5878,5879,5880,5881,5882,5883,5884,5885,5886,5887,5888,5889,5890,5891,5892,5893,5894,5895,5896,5897,5898,5899,5900,5901,5902,5903,5904,5905,5906,5907,5908,5909,5910,5911