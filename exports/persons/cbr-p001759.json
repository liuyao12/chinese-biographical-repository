tions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji039-197","person_id":"cbr-p001759","surfaces":["欒枝"],"scope":"same_chapter","chapter_ids":["c-shiji-039-jin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-039-jin:p066","quote":"四年，楚成王及諸侯圍宋，宋公孫固如晉告急。先軫曰：「報施定霸，於今在矣。」狐偃曰：「楚新得曹而初婚於衞，若伐曹、衞，楚必救之，則宋免矣。」於是晉作三軍。趙衰舉郤縠將中軍，郤臻佐之；使狐偃將上軍，狐毛佐之，命趙衰爲卿；欒枝將下軍，先軫佐之；荀林父御戎，魏犫爲右：往伐。冬十二月，晉兵先下山東，而以原封趙衰。"},{"paragraph_id":"c-shiji-039-jin:p079","quote":"晉先軫曰：「秦伯不用蹇叔，反其衆心，此可撃。」欒枝曰：「未報先君施於秦，撃之，不可。」先軫曰：「秦侮吾孤，伐吾同姓，何德之報？」遂撃之。襄公墨衰絰。四月，敗秦師于殽，虜秦三將孟明視、西乞秫、白乙丙以歸。遂墨以葬文公。文公夫人秦女，謂襄公曰：「秦欲得其三將戮之。」公許，遣之。先軫聞之，謂襄公曰：「患生矣。」軫乃追秦將。秦將渡河，已在船中，頓首謝，卒不反。"}],"rationale":"按本篇明示名與稱號、晉世系與具體事件暫定所列提及同指；附各段原文，未按同字短名全域合併；紀年與版本差異待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-039-jin:p066","text":"四年，楚成王及諸侯圍宋，宋公孫固如晉告急。先軫曰：「報施定霸，於今在矣。」狐偃曰：「楚新得曹而初婚於衞，若伐曹、衞，楚必救之，則宋免矣。」於是晉作三軍。趙衰舉郤縠將中軍，郤臻佐之；使狐偃將上軍，狐毛佐之，命趙衰爲卿；欒枝將下軍，先軫佐之；荀林父御戎，魏犫爲右：往伐。冬十二月，晉兵先下山東，而以原封趙衰。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m066-0003","start":3,"end":6,"surface":"楚成王","kind":"person","person_id":"cbr-p000398","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m066-0012","start":12,"end":16,"surface":"宋公孫固","kind":"person","person_id":"cbr-p001654","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m066-0021","start":21,"end":23,"surface":"先軫","kind":"person","person_id":"cbr-p001742","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m066-0037","start":37,"end":39,"surface":"狐偃","kind":"person","person_id":"cbr-p001740","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m066-0073","start":73,"end":75,"surface":"三軍","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m066-0076","start":76,"end":78,"surface":"趙衰","kind":"person","person_id":"cbr-p000329","status":"contextual_pro