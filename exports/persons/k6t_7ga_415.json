ay_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-059-yi:p006:m0102","start":82,"end":85,"surface":"羊玄之","kind":"person","person_id":"k6t_7ga_415","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。","paragraph_id":"c-jinshu-059-yi:p006","chapter_id":"c-jinshu-059-yi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-059-yi:p006","text":"穎復書曰：「文、景受圖，武皇乘運，庶幾堯、舜，共康政道，恩隆洪業，本枝百世。豈期骨肉豫禍，後族專權，楊、賈縱毒，齊、趙內篡。幸以誅夷，而未靜息。每憂王室，心悸肝爛。羊玄之、皇甫商等恃寵作禍，能不興慨！於是征西羽檄，四海雲應。本謂仁兄同其所懷，便當內擒商等，收級遠送。如何迷惑，自為戎首！上矯君詔，下離愛弟，推移輦轂，妄動兵威，還任豺狼，棄戮親善。行惡求福，如何自勉！前遣陸機董督節鉞，雖黃橋之退，而溫南收勝，一彼一此，未足增慶也。今武士百萬，良將銳猛，要當與兄整頓海內。若能從太尉之命，斬商等首，投戈退讓，自求多福，穎亦自歸鄴都，與兄同之。奉覽來告，緬然慷慨。慎哉大兄，深思進退也！」","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-059-yi:p006:m0093","start":0,"end":1,"surface":"穎","kind":"person","person_id":"e81_f09_000","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p006:m0094","start":6,"end":7,"surface":"文","kind":"person","person_id":"dkn_ge4_286_AAAAI","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p006:m0095","start":8,"end":9,"surface":"景","kind":"person","person_id":"dkn_ge4_286_AAAAH","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p006:m0096","start":12,"end":14,"surface":"武皇","kind":"person","person_id":"hgm_jvn_hle","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p006:m0097","start":19,"end":20,"surface":"堯","kind":"person","person_id":"oho_r3f_c6y","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p006