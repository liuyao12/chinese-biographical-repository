red","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-057-lumao:line074:m0031","start":31,"end":33,"surface":"蔣纂","kind":"person","person_id":"0fw_jau_stm","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-057-lumao:line074","chapter_id":"c-sanguozhi-057-lumao"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-057-lumao:line074","text":"陸瑁字子璋，丞相遜弟也。少好學篤義。陳國陳融、陳留濮陽逸、沛郡蔣纂、廣陵袁迪等，皆單貧有志。就瑁游處，瑁割少分甘，與同豐約。及同郡徐原，爰居會稽，素不相識，臨死遺書，托以孤弱，瑁為起立墳墓，收導其子，又瑁從父績早亡，二男一女，皆數歲以還，瑁迎攝養，至長乃別。州郡辟舉，皆不就。時尚書暨艷盛明臧否，差斷三署。頗揚人暗昧之失，以顯其謫。瑁與書曰：\"夫聖人嘉善矜愚，忘過記功，以成美化。加今王業始建，將一大統，此乃漢高棄瑕錄用之時也，若令善惡異流，貴汝穎月旦之評，誠可以厲俗明教，然恐未易行也。宜遠模仲尼之泛愛，中則郭泰之弘濟，近有益於大道也。\"艷不能行，卒以致敗。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-057-lumao:line074:m0001","start":1,"end":2,"surface":"瑁","kind":"person","person_id":"36u_j3u_i3z","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-lumao:line074:m0003","start":3,"end":5,"surface":"子璋","kind":"person","person_id":"36u_j3u_i3z","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-lumao:line074:m0008","start":8,"end":9,"surface":"遜","kind":"person","person_id":"lii_454_vuv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-lumao:line074:m0020","start":20,"end":22,"surface":"陳融","kind":"person","person_id":"7zk_tzn_4nb","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-lumao:line074:m0025","start":25,"end":28,"surface":"濮陽逸","kind":"person","person_id":"3yy_t64_6nq","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-san