:p013","text":"二月，徙梁王恢為趙王。呂王產徙為梁王，梁王不之國，為帝太傅。立皇子平昌侯太為呂王。更名梁曰呂，呂曰濟川。太后女弟呂媭有女為營陵侯劉澤妻，澤為大將軍。太后王諸呂，恐即崩後劉將軍為害，乃以劉澤為瑯邪王，以慰其心。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-009-lvhou:m013-0004","start":4,"end":7,"surface":"梁王恢","kind":"person","person_id":"yqp_nlb_p1p_AD","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m013-0008","start":8,"end":10,"surface":"趙王","kind":"person","person_id":"yqp_nlb_p1p_AD","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m013-0011","start":11,"end":14,"surface":"呂王產","kind":"person","person_id":"acg_se3_w5x_B","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m013-0026","start":26,"end":29,"surface":"帝太傅","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定官稱；不補造姓名或把身世指控當定論。"},{"id":"c-shiji-009-lvhou:m013-0033","start":33,"end":37,"surface":"平昌侯太","kind":"person","person_id":"s8f_9yk_r9y","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m013-0052","start":52,"end":54,"surface":"太后","kind":"person","person_id":"i30_mjq_6q8_A","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m013-0056","start":56,"end":58,"surface":"呂媭","kind":"person","person_id":"68y_cvr_pg1","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m013-0058","start":58,"end":60,"surface":"有女","kind":"person","person_id":"0as_za5_mdt","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m013-0064","start":64,"end":66,"surface":"劉澤","kind":"person","person_id":"jo4_4bf_0ra","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m013-0068","start":68,"end":69,"surface":"澤","kind":"person","person_id":"jo4_4bf_0ra","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m013-0074","start":74,"end":76,"surface":"太后","kind":"person","person_id":"i30_mjq_6q8_A","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m013-0077","start":77,"end":79,"surface":"諸呂","kind":"unresolved","person_id":null,"status":"unresolv