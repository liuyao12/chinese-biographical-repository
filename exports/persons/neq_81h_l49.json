{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"neq_81h_l49","canonical_person_id":"neq_81h_l49","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["neq_81h_l49"],"persons":[{"id":"neq_81h_l49","label":"呂后（儒林列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"呂后","mention_ids":["c-shiji-121-rulin:m004-0183"]},{"surface":"呂太后","mention_ids":["c-shiji-121-rulin:m007-0029"]}],"evidence":[{"mention_id":"c-shiji-121-rulin:m004-0183","chapter_id":"c-shiji-121-rulin","paragraph_id":"c-shiji-121-rulin:p004","quote":"呂后"},{"mention_id":"c-shiji-121-rulin:m007-0029","chapter_id":"c-shiji-121-rulin","paragraph_id":"c-shiji-121-rulin:p007","quote":"呂太后"}]}],"source_mention_summary":[{"source_id":"s-shiji121-rulin","work_id":"w-shiji","book_id":"b-shiji-121","chapter_id":"c-shiji-121-rulin","mention_count":2,"mention_ids":["c-shiji-121-rulin:m004-0183","c-shiji-121-rulin:m007-0029"],"paragraph_ids":["c-shiji-121-rulin:p004","c-shiji-121-rulin:p007"],"table_cell_ids":[],"passage_count":2}],"most_mentioned_source_ids":["s-shiji121-rulin"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-121-rulin:m004-0183","start":183,"end":185,"surface":"呂后","kind":"person","person_id":"neq_81h_l49","status":"contextual_provisional","paragraph_id":"c-shiji-121-rulin:p004","chapter_id":"c-shiji-121-rulin"},{"id":"c-shiji-121-rulin:m007-0029","start":29,"end":32,"surface":"呂太后","kind":"person","person_id":"neq_81h_l49","status":"contextual_provisional","paragraph_id":"c-shiji-121-rulin:p007","chapter_id":"c-shiji-121-rulin"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-121-rulin:p004","text":"及高皇帝誅項籍，舉兵圍魯，魯中諸儒尚講誦習禮樂，弦歌之音不絕，豈非聖人之遺化，好禮樂之國哉？故孔子在陳曰：「歸與！歸與！吾黨之小子狂簡，斐然成章，不知所以裁之。」夫齊魯之閒於文學，自古以來，其天性也。故漢興，然後諸儒始得修其經藝，講習大射鄉飲之禮。叔孫通作漢禮儀，因為太常，諸生弟子共定者，咸為選首，於是喟然嘆興於學。然尚有干戈，平定四海，亦未暇遑庠序之事也。孝惠、呂后時，公卿皆武力有功之臣。孝文時頗徵用，然孝文帝本好刑名之言。及至孝景，不任儒者，而竇太后又好黃老之術，故諸博士具官待問，未有進者。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m004-0001","start":1,"end":4,"surface":"高皇帝","kind":"person","person_id":"x85_w53_dyq","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m004-0005","start":5,"end":7,"surface":"項籍","kind":"person","person_id":"mtg_mtp_8oz","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m004-0013","start":13,"end":17,"surface":"魯中諸儒","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m004-0033","start":33,"end":35,"surface":"聖人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m004-0047","start":47,"end":49,"surface":"孔子","kind":"person","person_id":"t0d_uf0_f2f","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m004-0124","start":124,"end":127,"surface":"叔孫通","kind":"person","person_id":"o57_ilh_v3i","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m004-0137","start":137,"end":141,"surface":"諸生弟子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m004-0180","start":180,"end":182,"surface":"孝惠","kind":"person","person_id":"f2v_ue2_c9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m004-0183","start":183,"end":185,"surface":"呂后","kind":"person","person_id":"neq_81h_l49","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m004-0187","start":187,"end":189,"surface":"公卿","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m004-0197","start":197,"end":199,"surface":"孝文","kind":"person","person_id":"vz8_68e_j99","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m004-0205","start":205,"end":208,"surface":"孝文帝","kind":"person","person_id":"vz8_68e_j99","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m004-0217","start":217,"end":219,"surface":"孝景","kind":"person","person_id":"8s8_8m3_upb","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m004-0226","start":226,"end":229,"surface":"竇太后","kind":"person","person_id":"r4k_my1_3w5","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m004-0237","start":237,"end":240,"surface":"諸博士","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-121-rulin","book_id":"b-shiji-121","work_id":"w-shiji","source_id":"s-shiji121-rulin"},{"id":"c-shiji-121-rulin:p007","text":"申公者，魯人也。高祖過魯，申公以弟子從師入見高祖于魯南宮。呂太后時，申公游學長安，與劉郢同師。已而郢為楚王，令申公傅其太子戊。戊不好學，疾申公。及王郢卒，戊立為楚王，胥靡申公。申公恥之，歸魯，退居家教，終身不出門，復謝絕賓客，獨王命召之乃往。弟子自遠方至受業者百餘人。申公獨以詩經為訓以教，無傳（疑），疑者則闕不傳。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m007-0000","start":0,"end":2,"surface":"申公","kind":"person","person_id":"wxo_k8i_1it","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m007-0008","start":8,"end":10,"surface":"高祖","kind":"person","person_id":"x85_w53_dyq","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m007-0013","start":13,"end":15,"surface":"申公","kind":"person","person_id":"wxo_k8i_1it","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m007-0016","start":16,"end":18,"surface":"弟子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m007-0019","start":19,"end":20,"surface":"師","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m007-0022","start":22,"end":24,"surface