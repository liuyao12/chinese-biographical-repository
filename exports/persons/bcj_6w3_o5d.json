{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"bcj_6w3_o5d","canonical_person_id":"bcj_6w3_o5d","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["bcj_6w3_o5d"],"persons":[{"id":"bcj_6w3_o5d","label":"彭寶孫（梁北道軍）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"彭寶孫","mention_ids":["c-liangshu-028-xiahoudan-complete:p002:m0148"]}],"evidence":[{"mention_id":"c-liangshu-028-xiahoudan-complete:p002:m0148","paragraph_id":"c-liangshu-028-xiahoudan-complete:p002","chapter_id":"c-liangshu-028-xiahoudan-complete","quote":"彭寶孫"}],"review":"ai_provisional","identity_note":"彭寶孫（梁北道軍），見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-liangshu-028-xiahoudan-complete-ws1511902","work_id":"w-liangshu","book_id":"b-liangshu-028","chapter_id":"c-liangshu-028-xiahoudan-complete","raw_mention_count":1,"mention_ids":["c-liangshu-028-xiahoudan-complete:p002:m0148"],"paragraph_ids":["c-liangshu-028-xiahoudan-complete:p002"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-liangshu-028-xiahoudan-complete:p002:m0148","mention_ids":["c-liangshu-028-xiahoudan-complete:p002:m0148"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-liangshu-028-xiahoudan-complete-ws1511902"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-liangshu-028-xiahoudan-complete:p002:m0148","start":148,"end":151,"surface":"彭寶孫","kind":"person","person_id":"bcj_6w3_o5d","status":"contextual_provisional","paragraph_id":"c-liangshu-028-xiahoudan-complete:p002","chapter_id":"c-liangshu-028-xiahoudan-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-028-xiahoudan-complete:p002","text":"六年，大舉北伐。先遣豫州刺史裴邃帥譙州刺史湛僧智、歷陽太守明紹世、南譙太守魚弘、晉熙太守張澄，並世之驍將，自南道伐壽陽城，未克而邃卒。乃加亶使持節，馳驛代邃，與魏將河間王元琛、臨淮王元彧等相拒，頻戰克捷。尋有密敕，班師合肥，以休士馬，須堰成復進。七年夏，淮堰水盛，壽陽城將沒，高祖復遣北道軍元樹帥彭寶孫、陳慶之等稍進，亶帥湛僧智、魚弘、張澄等通清流澗，將入淮、肥。魏軍夾肥築城，出亶軍後，亶與僧智還襲，破之。進攻黎漿，貞威將軍韋放自北道會焉。兩軍既合，所向皆降下。凡降城五十二，獲男女口七萬五千人，米二十萬石。詔以壽陽依前代置豫州，合肥鎮改爲南豫州，以亶爲使持節、都督豫州緣淮南豫霍義定五州諸軍事、雲麾將軍、豫、南豫二州刺史。壽春久罹兵荒，百姓多流散，亶輕刑薄賦，務農省役，頃之民戶充復。大通二年，進號平北將軍。三年，卒於州鎮。高祖聞之，卽日素服舉哀，贈車騎將軍。諡曰襄。州民夏侯簡等五百人表請爲亶立碑置祠，詔許之。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":53,"last_line":53,"raw_start":3488,"raw_end":3903,"raw_character_offsets":[3488,3489,3490,3491,3492,3493,3494,3495,3496,3497,3498,3499,3500,3501,3502,3503,3504,3505,3506,3507,3508,3509,3510,3511,3512,3513,3514,3515,3516,3517,3518,3519,3520,3521,3522,3523,3524,3525,3526,3527,3528,3529,3530,3531,3532,3533,3534,3535,3536,3537,3538,3539,3540,3541,3542,3543,3544,3545,3546,3547,3548,3549,3550,3551,3552,3553,3554,3555,3556,3557,3558,3559,3560,3561,3562,3563,3564,3565,3566,3567,3568,3569,3570,3571,3572,3573,3574,3575,3576,3577,3578,3579,3580,3581,3582,3583,3584,3585,3586,3587,3588,3589,3590,3591,3592,3593,3594,3595,3596,3597,3598,3599,3600,3601,3602,3603,3604,3605,3606,3607,3608,3609,3610,3611,3612,3613,3614,3615,3616,3617,3618,3619,3620,3621,