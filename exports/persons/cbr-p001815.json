{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p001815","identity_policy":"contextual_provisional","person_ids":["cbr-p001815"],"persons":[{"id":"cbr-p001815","label":"范獻子（止平公自殺者）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"范獻子","mention_ids":["c-shiji-039-jin:m119-0065","c-shiji-039-jin:m126-0038"]},{"surface":"獻子","mention_ids":["c-shiji-039-jin:m126-0042"]}],"evidence":[{"mention_id":"c-shiji-039-jin:m119-0065","chapter_id":"c-shiji-039-jin","paragraph_id":"c-shiji-039-jin:p119","quote":"范獻子"},{"mention_id":"c-shiji-039-jin:m126-0038","chapter_id":"c-shiji-039-jin","paragraph_id":"c-shiji-039-jin:p126","quote":"范獻子"},{"mention_id":"c-shiji-039-jin:m126-0042","chapter_id":"c-shiji-039-jin","paragraph_id":"c-shiji-039-jin:p126","quote":"獻子"}]}],"mentions":[{"id":"c-shiji-039-jin:m119-0065","start":65,"end":68,"surface":"范獻子","kind":"person","person_id":"cbr-p001815","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p119","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m126-0038","start":38,"end":41,"surface":"范獻子","kind":"person","person_id":"cbr-p001815","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p126","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m126-0042","start":42,"end":44,"surface":"獻子","kind":"person","person_id":"cbr-p001815","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p126","chapter_id":"c-shiji-039-jin"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji039-253","person_id":"cbr-p001815","surfaces":["獻子","范獻子"],"scope":"same_chapter","chapter_ids":["c-shiji-039-jin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-039-jin:p119","quote":"六年，魯襄公朝晉。晉欒逞有罪，奔齊。八年，齊莊公微遣欒逞於曲沃，以兵隨之。齊兵上太行，欒逞從曲沃中反，襲入絳。絳不戒，平公欲自殺，范獻子止公，以其徒撃逞，逞敗走曲沃。曲沃攻逞，逞死，遂滅欒氏宗。逞者，欒書孫也。其入絳，與魏氏謀。齊莊公聞逞敗，乃還，取晉之朝歌去，以報臨菑之役也。"},{"paragraph_id":"c-shiji-039-jin:p126","quote":"九年，魯季氏逐其君昭公，昭公居乾侯。十一年，衞、宋使使請晉納魯君。季平子私賂范獻子，獻子受之，乃謂晉君曰：「季氏無罪。」不果入魯君。"}],"rationale":"按本篇明示名與稱號、晉世系與具體事件暫定所列提及同指；附各段原文，未按同字短名全域合併；紀年與版本差異待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-039-jin:p119","text":"六年，魯襄公朝晉。晉欒逞有罪，奔齊。八年，齊莊公微遣欒逞於曲沃，以兵隨之。齊兵上太行，欒逞從曲沃中反，襲入絳。絳不戒，平公欲自殺，范獻子止公，以其徒撃逞，逞敗走曲沃。曲沃攻逞，逞死，遂滅欒氏宗。逞者，欒書孫也。其入絳，與魏氏謀。齊莊公聞逞敗，乃還，取晉之朝歌去，以報臨菑之役也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m119-0003","start":3,"end":6,"surface":"魯襄公","kind":"person","person_id":"cbr-p001273","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m119-0009","start":9,"end":12,"surface":"晉欒逞","kind":"person","person_id":"cbr-p001814","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m119-0021","start":21,"end":24,"surface":"齊莊公","kind":"person","person_id":"cbr-p000264","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m119-0026","start":26,"end":28,"surface":"欒逞","kind":"person","person_id":"cbr-p001814","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m119-0043","start":43,"end":45,"surface":"欒逞","kind":"person","person_id":"cbr-p001814","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m119-0059","start":59,"end":61,"surface":"平公","kind":"person","person_id":"cbr-p000416","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m119-0065","start":65,"end":68,"surface":"范獻子","kind":"person","person_id":"cbr-p001815","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m119-0075","start":75,"end":76,"surface":"逞","kind":"person","person_id":"cbr-p001814","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m119-0077","start":77,"end":78,"surface":"逞","kind":"person","person_id":"cbr-p001814","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m119-0086","start":86,"end":87,"surface":"逞","kind":"person","person_id":"cbr-p001814","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m119-0088","start":88,"end"