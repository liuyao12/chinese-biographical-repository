start":2,"end":5,"surface":"衛皇后","kind":"person","person_id":"l5c_h8i_d5q","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m023-0008","start":8,"end":12,"surface":"燕王定國","kind":"person","person_id":"jo4_4bf_0ra_AA","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m023-0016","start":16,"end":17,"surface":"偃","kind":"person","person_id":"vbr_ff1_yc4","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m023-0037","start":37,"end":38,"surface":"偃","kind":"person","person_id":"vbr_ff1_yc4","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m023-0046","start":46,"end":48,"surface":"主父","kind":"person","person_id":"vbr_ff1_yc4","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m023-0066","start":66,"end":67,"surface":"親","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-112-pingjin:m023-0072","start":72,"end":74,"surface":"昆弟","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-112-pingjin","book_id":"b-shiji-112","work_id":"w-shiji","source_id":"s-shiji112-pingjin"},{"id":"c-shiji-112-pingjin:p025","text":"元朔二年，主父言齊王內淫佚行僻，上拜主父為齊相。至齊，遍召昆弟賓客，散五百金予之，數之曰：「始吾貧時，昆弟不我衣食，賓客不我內門；今吾相齊，諸君迎我或千里。吾與諸君絕矣，毋復入偃之門！」乃使人以王與姊姦事動王，王以為終不得脫罪，恐效燕王論死，乃自殺。有司以聞。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-112-pingjin:m025-0005","start":5,"end":7,"surface":"主父","kind":"person","person_id":"vbr_ff1_yc4","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m025-0008","start":8,"end":10,"surface":"齊王","kind":"person","person_id":"qok_ik2_99j_A","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m025-0016","start":16,"end":17,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m025-0018","start":18,"end":20,"surface":"主父","kind":"person","person_id":"vbr_ff1_yc4","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m025-0029","start":29,"end":