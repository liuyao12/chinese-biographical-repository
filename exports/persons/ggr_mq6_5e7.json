decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-035-peixiu-peiwei:p014:m0025","start":25,"end":27,"surface":"周弼","kind":"person","person_id":"ggr_mq6_5e7","status":"source_explicit","paragraph_id":"c-jinshu-035-peixiu-peiwei:p014","chapter_id":"c-jinshu-035-peixiu-peiwei"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-035-peixiu-peiwei:p014","text":"頠字逸民。弘雅有遠識，博學稽古，自少知名。御史中丞周弼見而歎曰：「頠若武庫，五兵縱橫，一時之傑也。」賈充即頠從母夫也，表「秀有佐命之勳，不幸嫡長喪亡，遺孤稚弱。頠才德英茂，足以興隆國嗣。」詔頠襲爵，頠固讓，不許。太康二年，徵為太子中庶子，遷散騎常侍。惠帝既位，轉國子祭酒，兼右軍將軍。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-035-peixiu-peiwei:p014:m0000","start":0,"end":1,"surface":"頠","kind":"person","person_id":"kbq_kjc_n2f_AAB","status":"source_explicit"},{"id":"c-jinshu-035-peixiu-peiwei:p014:m0002","start":2,"end":4,"surface":"逸民","kind":"person","person_id":"kbq_kjc_n2f_AAB","status":"contextual_provisional","interpretation_note":"完整裴秀／裴頠單元的具名、當時職位及敘事事件與已錄同時期seed相合；不由單純同名自動合。"},{"id":"c-jinshu-035-peixiu-peiwei:p014:m0025","start":25,"end":27,"surface":"周弼","kind":"person","person_id":"ggr_mq6_5e7","status":"source_explicit"},{"id":"c-jinshu-035-peixiu-peiwei:p014:m0033","start":33,"end":34,"surface":"頠","kind":"person","person_id":"kbq_kjc_n2f_AAB","status":"source_explicit"},{"id":"c-jinshu-035-peixiu-peiwei:p014:m0050","start":50,"end":52,"surface":"賈充","kind":"person","person_id":"jmv_vc4_gep_*AA","status":"contextual_provisional","interpretation_note":"完整裴秀／裴頠單元的具名、當時職位及敘事事件與已錄同時期seed相合；不由單純同名自動合。"},{"id":"c-jinshu-035-peixiu-peiwei:p014:m0053","start":53,"end":54,"surface":"頠","kind":"person","perso