reviewed":false,"model":null},{"id":"a-songshu066-wang-001","subject_person_id":"7r6_k52_qji_ABDABAA","predicate":"father","object_person_id":"7r6_k52_qji_ABDABA","status":"source_attested","qualifiers":{"source_term":"父茂之","lineage":"paternal"},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-066","chapter_id":"c-songshu-066-wangjinghong","source_id":"s-songshu-066-wangjinghong","paragraph_id":"c-songshu-066-wangjinghong:p001","quote":"王敬弘，琅邪臨沂人也。與高祖諱同，故稱字。曾祖廙，晉驃騎將軍。祖胡之，司州刺史。父茂之，晉陵太守。"}],"interpretation_note":"按具名原文及本段承接記錄，原稱與身份分存，不補未名生母或絕對排行。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"person_id":"7r6_k52_qji_ABDABA","title":"晉陵太守","surname":"王","ming":"茂之","additional_names":[],"work_id":"w-jinshu","book_id":"b-jinshu-076","chapter_id":"c-jinshu-076-wangyi-family","source_id":"s-jinshu-076-wangyi-family","paragraph_id":"c-jinshu-076-wangyi-family:p004","quote":"子頤之嗣，仕至東海內史。頤之弟胡之，字修齡，弱冠有聲譽，歷郡守、侍中、丹陽尹。素有風眩疾，發動甚數，而神明不損。石季龍死，朝廷欲綏輯河洛，以胡之為西中郎將、司州刺史、假節，以疾固辭，未行而卒。子茂之亦有美譽，官至晉陵太守。子敬弘，義熙末為尚書。","note":"姓名、字與稱號分存；未名者不補。辨認用稱不等於每個敘事時點已任，對讀原句與固定修訂另外保留。","status":"editorial_provisional","human_reviewed":false,"model":null,"zi":"興元","references":[{"title":"《南史》四庫全書本卷24正文","url":"https://zh.wikisource.org/w/index.php?title=%E5%8D%97%E5%8F%B2+%28%E5%9B%9B%E5%BA%AB%E5%85%A8%E6%9B%B8%E6%9C%AC%29%2F%E5%8D%B724&oldid=754387","source_revision":754387,"source_position":{"first_line":14,"last_line":14,"start":51,"end":61},"quote":"父茂之字興元晉陵太守","scope":"primary_parallel_explicit_courtesy_name","image_verified":false}]}],"mentions":[{"id":"c-jinshu-076-wangyi-family:p004:m0097","start":97,"end":99,"surface":"茂之","kind":"person","person_id":"7r6_k52_qji_ABDABA","status":"contextual_provisional","paragraph_id":"c-jinshu-076-wangyi-family:p004","chapter_id":"c-jinshu-076-wa