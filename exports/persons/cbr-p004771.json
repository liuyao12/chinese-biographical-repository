4769","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m030-0049","start":49,"end":51,"surface":"文帝","kind":"person","person_id":"cbr-p004771","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m030-0064","start":64,"end":66,"surface":"賈生","kind":"person","person_id":"cbr-p004769","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m030-0084","start":84,"end":86,"surface":"賈生","kind":"person","person_id":"cbr-p004769","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m030-0087","start":87,"end":90,"surface":"梁懷王","kind":"person","person_id":"cbr-p004784","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m030-0093","start":93,"end":96,"surface":"梁懷王","kind":"person","person_id":"cbr-p004784","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m030-0097","start":97,"end":99,"surface":"文帝","kind":"person","person_id":"cbr-p004771","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m030-0111","start":111,"end":113,"surface":"賈生","kind":"person","person_id":"cbr-p004769","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"},{"id":"c-shiji-084-qujia:p031","text":"文帝復封淮南厲王子四人皆為列侯。賈生諫，以為患之興自此起矣。賈生數上疏，言諸侯或連數郡，非古之制，可稍削之。文帝不聽。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m031-0000","start":0,"end":2,"surface":"文帝","kind":"person","person_id":"cbr-p004771","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m031-0004","start":4,"end":8,"surface":"淮南厲王","kind":"person","person_id":"cbr-p004785","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m031-0008","start":8,"end":11,"surface":"子四人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未能逐一辨識的後裔，保留原稱，不補造姓名與闕代。"},{"id":"c-shiji-084-qujia:m031-0016","start":16,"end":18,"surface":"賈生","kind":"person","person_id":"cbr-p004769","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m031-0030","start":30,"end":32,"surface":"賈生","kind":"person","person_id":"cbr-p004769","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m031-0037","start":37,"end":39,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未能逐一辨識的後裔，保留原稱，不補造姓名與闕代。"},{"id":"c-shiji-084-qujia:m031-0054","start":54,"end":56,"surface":"文帝","kind":"person","person_id":"cbr-p004771","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"},{"id":"c-shiji-084-qujia:p032","text":"居數年，懷王騎，墮馬而死，無後。賈生自傷為傅無狀，哭泣歲餘，亦死。賈生之死時年三十三矣。及孝文崩，孝武皇帝立，舉賈生之孫二人至郡守，而賈嘉最好學，世其家，與余通書。至孝昭時，列為九卿。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m032-0004","start":4,"end":6,"surface":"懷王","kind":"person","person_id":"cbr-p004784","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m032-0016","start":16,"end":18,"surface":"賈生","kind":"person","person_id":"cbr-p004769","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m032-0033","start":33,"end":35,"surface":"賈生","kind":"person","person_id":"cbr-p004769","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m032-0045","start":45,"end":47,"surface":"孝文","kind":"person","person_id":"cbr-p004771","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m032-0049","start":49,"end":53,"surface":"孝武皇帝","kind":"person","person_id":"cbr-p004786","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m032-0056","start":56,"end":58,"surface":"賈生","kind":"person","person_id":"cbr-p004769","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m032-0058","start":58,"end":62,"surface":"之孫二人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未能逐一辨識的後裔，保留原稱，不補造姓名與闕代。"},{"id":"c-shiji-084-qujia:m032-0067","start":67,"end":69,"surface":"賈嘉","kind":"person","person_id":"cbr-p004787","status":"contextual_provisional"},