ace":"賈生","kind":"person","person_id":"cbr-p004769","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m021-0019","start":19,"end":23,"surface":"諸老先生","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代保持未解。"},{"id":"c-shiji-084-qujia:m021-0027","start":27,"end":29,"surface":"賈生","kind":"person","person_id":"cbr-p004769","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m021-0044","start":44,"end":46,"surface":"諸生","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代保持未解。"},{"id":"c-shiji-084-qujia:m021-0057","start":57,"end":60,"surface":"孝文帝","kind":"person","person_id":"cbr-p004771","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"},{"id":"c-shiji-084-qujia:p022","text":"賈生以為漢興至孝文二十餘年，天下和洽，而固當改正朔，易服色，法制度，定官名，興禮樂，乃悉草具其事儀法，色尚黃，數用五，為官名，悉更秦之法。孝文帝初即位，謙讓未遑也。諸律令所更定，及列侯悉就國，其說皆自賈生發之。於是天子議以為賈生任公卿之位。絳、灌、東陽侯、馮敬之屬盡害之，乃短賈生曰：「雒陽之人，年少初學，專欲擅權，紛亂諸事。」於是天子後亦疏之，不用其議，乃以賈生為長沙王太傅。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m022-0000","start":0,"end":2,"surface":"賈生","kind":"person","person_id":"cbr-p004769","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m022-0069","start":69,"end":72,"surface":"孝文帝","kind":"person","person_id":"cbr-p004771","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m022-0090","start":90,"end":92,"surface":"列侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代保持未解。"},{"id":"c-shiji-084-qujia:m022-0100","start":100,"end":102,"surface":"賈生","kind":"person","person_id":"cbr-p004769","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m022-0107","start":107,"end":109,"surface":"天子","kind":"person","person_id":"cbr-p004771","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m022-0112","start":112,"end":114,"surface":"賈生","kind":"person","person_id":"cbr-p004769","st