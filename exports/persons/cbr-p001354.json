4-yan","mention_count":6,"mention_ids":["c-shiji-034-yan:m023-0030","c-shiji-034-yan:m023-0047","c-shiji-034-yan:m023-0182","c-shiji-034-yan:m023-0204","c-shiji-034-yan:m025-0045","c-shiji-034-yan:m027-0060"],"paragraph_ids":["c-shiji-034-yan:p023","c-shiji-034-yan:p025","c-shiji-034-yan:p027"],"passage_count":3}],"most_mentioned_source_ids":["s-shiji-034-yan"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-034-yan:m023-0030","start":30,"end":33,"surface":"齊湣王","kind":"person","person_id":"cbr-p001354","status":"contextual_provisional","paragraph_id":"c-shiji-034-yan:p023","chapter_id":"c-shiji-034-yan"},{"id":"c-shiji-034-yan:m023-0047","start":47,"end":49,"surface":"齊王","kind":"person","person_id":"cbr-p001354","status":"contextual_provisional","paragraph_id":"c-shiji-034-yan:p023","chapter_id":"c-shiji-034-yan"},{"id":"c-shiji-034-yan:m023-0182","start":182,"end":184,"surface":"齊王","kind":"person","person_id":"cbr-p001354","status":"contextual_provisional","paragraph_id":"c-shiji-034-yan:p023","chapter_id":"c-shiji-034-yan"},{"id":"c-shiji-034-yan:m023-0204","start":204,"end":205,"surface":"王","kind":"person","person_id":"cbr-p001354","status":"contextual_provisional","paragraph_id":"c-shiji-034-yan:p023","chapter_id":"c-shiji-034-yan"},{"id":"c-shiji-034-yan:m025-0045","start":45,"end":47,"surface":"湣王","kind":"person","person_id":"cbr-p001354","status":"contextual_provisional","paragraph_id":"c-shiji-034-yan:p025","chapter_id":"c-shiji-034-yan"},{"id":"c-shiji-034-yan:m027-0060","start":60,"end":62,"surface":"閔王","kind":"person","person_id":"cbr-p001354","status":"contextual_provisional","paragraph_id":"c-shiji-034-yan:p027","chapter_id":"c-shiji-034-yan"}],"relations":[{"id":"a-shiji034-018","subject_person_id":"cbr-p001362","predicate":"father","object_person_id":"cbr-p001354","status":"source_attested","evidence":[{"chapter_id":"c-shiji-034-yan","source_id":"s-shiji-034-yan","paragraph_id":"c-shiji-034-yan:p027","quote":"惠王為太子時，與樂毅有隙；及即位，疑毅，使騎劫代將。樂毅亡走趙。齊田單以即墨擊敗燕軍，騎劫死，燕兵引歸，齊悉復得其故城。閔王死于莒，乃立其子為襄王。"}],"qualifiers":{"source_term":"其子","historicity":"historical_tradition"},"interpretation_note":"保存本篇明示子、其女、婦、夫人及祖先說；九世不補闕名或直接父親，未見子字的繼位不自動推父子。太子平／燕昭王身份與攻燕年代尚待覆核。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji034-098","person_id":"cbr-p001354","surfaces":["湣王","王","閔王","齊湣王","齊王"],"scope":"same_chapter","chapter_ids":["c-shiji-034-yan"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-034-yan:p023","quote":"三年，國大亂，百姓恫恐。將軍市被與太子平謀，將攻子之。諸將謂齊湣王曰：「因而赴之，破燕必矣。」齊王因令人謂燕太子平曰：「寡人聞太子之義，將廢私而立公，飭君臣之義，明父子之位。寡人之國小，不足以爲先後。雖然，則唯太子所以令之。」太子因要黨聚衆，將軍市被圍公宮，攻子之，不克。將軍市被及百姓反攻太子平，將軍市被死，以徇。因搆難數月，死者數萬，衆人恫恐，百姓離志。孟軻謂齊王曰：「今伐燕，此文、武之時，不可失也。」王因令章子將五都之兵，以因北地之衆以伐燕。士卒不戰，城門不閉，燕君噲死，齊大勝。燕子之亡二年，而燕人共立太子平，是爲燕昭王。"},{"paragraph_id":"c-shiji-034-yan:p025","quote":"二十八年，燕國殷富，士卒樂軼輕戰，於是遂以樂毅爲上將軍，與秦、楚、三晉合謀以伐齊。齊兵敗，湣王出亡於外。燕兵獨追北，入至臨淄，盡取齊寶，燒其宮室宗廟。齊城之不下者，獨唯聊、莒、卽墨，其餘皆屬燕，六歳。"},{"paragraph_id":"c-shiji-034-yan:p027","quote":"惠王為太子時，與樂毅有隙；及即位，疑毅，使騎劫代將。樂毅亡走趙。齊田單以即墨擊敗燕軍，騎劫死，燕兵引歸，齊悉復得其故城。閔王死于莒，乃立其子為襄王。"}],"rationale":"依周初封建、燕君世系、割地救燕、讓國及秦滅諸國的具體語境暫定異稱。繼位不自動證父子；同爵者分國別與前後世代。太子平／燕昭王依本篇明示，不表示年代及世系已校定。作君奭為書名，君奭不説之君奭才暫解召公稱呼。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-034-yan:p023","text":"三年，國大亂，百姓恫恐。將軍市被與太子平謀，將攻子之。諸將謂齊湣王曰：「因而赴之，破燕必矣。」齊王因令人謂燕太子平曰：「寡人聞太子之義，將廢私而立公，飭君臣之義，明父子之位。寡人之國小，不足以爲先後。雖然，則唯太子所以令之。」太子因要黨聚衆，將軍市被圍公宮，攻子之，不克。將軍市被及百姓反攻太子平，將軍市被死，以徇。因搆難數月，死者數萬，衆人恫恐，百姓離志。孟軻謂齊王曰：「今伐燕，此文、武之時，不可失也。」王因令章子將五都之兵，以因北地之衆以伐燕。士卒不戰，城門不閉，燕君噲死，齊大勝。燕子之亡二年，而燕人共立太子平，是爲燕昭王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-034-yan:m023-0007","start":7,"end":9,"surface":"百姓","kind":"unresolved","person_id":null,"status":"unresolved","