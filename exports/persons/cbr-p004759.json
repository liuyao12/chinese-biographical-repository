-chu:m078-0342","start":342,"end":345,"surface":"秦昭王","kind":"person","person_id":"cbr-p000308","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m078-0346","start":346,"end":348,"surface":"昭王","kind":"person","person_id":"cbr-p000308","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m078-0350","start":350,"end":353,"surface":"一將軍","kind":"person","person_id":"cbr-p001965","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m078-0360","start":360,"end":362,"surface":"秦王","kind":"person","person_id":"cbr-p001965","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m078-0363","start":363,"end":365,"surface":"楚王","kind":"person","person_id":"cbr-p001923","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m078-0392","start":392,"end":395,"surface":"楚懷王","kind":"person","person_id":"cbr-p001923","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m078-0401","start":401,"end":403,"surface":"昭子","kind":"unresolved","person_id":null,"status":"unresolved","note":"本段先記昭雎勸懷王不往秦，末作悔不用昭子言；暫留未定異稱，不直接與第85段昭子同指。"},{"id":"c-shiji-040-chu:m078-0408","start":408,"end":410,"surface":"楚王","kind":"person","person_id":"cbr-p001923","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m078-0421","start":421,"end":423,"surface":"楚王","kind":"person","person_id":"cbr-p001923","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m078-0432","start":432,"end":434,"surface":"楚王","kind":"person","person_id":"cbr-p001923","status":"contextual_provisional"}],"chapter_id":"c-shiji-040-chu","book_id":"b-shiji-040","work_id":"w-shiji","source_id":"s-shiji-040-chu"},{"id":"c-shiji-084-qujia:p007","text":"時秦昭王與楚婚，欲與懷王會。懷王欲行，屈平曰：「秦虎狼之國，不可信，不如毋行。」懷王稚子子蘭勸王行：「奈何絕秦歡？」懷王卒行。入武關，秦伏兵絕其後，因留懷王，以求割地。懷王怒，不聽。亡走趙，趙不內。復之秦，竟死於秦而歸葬。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m007-0001","start":1,"end":4,"surface":"秦昭王","kind":"person","person_id":"cbr-p004758","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m007-0010","start":10,"end":12,"surface":"懷王","kind":"person","person_id":"cbr-p004746","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m007-0014","start":14,"end":16,"surface":"懷王","kind":"person","person_id":"cbr-p004746","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m007-0019","start":19,"end":21,"surface":"屈平","kind":"person","person_id":"cbr-p004745","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m007-0040","start":40,"end":42,"surface":"懷王","kind":"person","person_id":"cbr-p004746","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m007-0044","start":44,"end":46,"surface":"子蘭","kind":"person","person_id":"cbr-p004759","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m007-0058","start":58,"end":60,"surface":"懷王","kind":"person","person_id":"cbr-p004746","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m007-0076","start":76,"end":78,"surface":"懷王","kind":"person","person_id":"cbr-p004746","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m007-0084","start":84,"end":86,"surface":"懷王","kind":"person","person_id":"cbr-p004746","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"},{"id":"c-shiji-084-qujia:p008","text":"長子頃襄王立，以其弟子蘭為令尹。楚人既咎子蘭以勸懷王入秦而不反也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m008-0002","start":2,"end":5,"surface":"頃襄王","kind":"person","person_id":"cbr-p004760","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m008-0010","start":10,"end":12,"surface":"子蘭","kind":"person","person_id":"cbr-p004759","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m008-0016","start":16,"end":18,"surface":"楚人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或泛稱保持未解，不補姓名。"},{"id":"c-shiji-084-qujia:m008-0020","start":20,"end":22,"surface":"子蘭","kind":"person","person_id":"cbr-p004759","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m008-0024","start":24,"end":26,"surface":"懷王","kind":"person","person_id":"cbr-p004746","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"},{"id":"c-shiji-084-qujia:p009","text":"屈平既嫉之，雖放流，睠顧楚國，系心懷王，不忘欲反，冀幸君之一悟，俗之一改也。其存君興國而欲反覆之，一篇之中三致志焉。然終無可奈何，故不可以反，卒以此見懷王之終不悟也。人君無愚智賢不肖，莫不欲求忠以自為，舉賢以自佐，然亡國破家相隨屬，而聖君治國累世而不見者，其所謂忠者不忠，而所謂賢者不賢也。懷王以不知忠臣之分，故內惑於鄭袖，外欺於張儀，疏屈平而信上官大夫、令尹子蘭。兵挫地削，亡其六郡，身客死於秦，為天下笑。此不知人之禍也。《易》曰：「井泄不食，為我心惻，可以汲。王明，并受其福。」王之不明，豈足福哉？","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m009-0000","start":0,"end":2,"surface":"屈平","kind":"person","person_id":"cbr-p004745","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m009-0017","start":17,"end":19,"surface":"懷王","kind":"person","person_id":"cbr-p004746","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m009-0075","start":75,"end":77,"surface":"懷王","kind":"person","person_id":"cbr-p004746","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m009-0083","start":83,"end":85,"surface":"人君","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或泛稱保持未解，不補姓名。"},{"id":"c-shiji-084-qujia:m009-0117","start":117,"end":119,"surface":"聖君","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或泛稱保持未解，不補姓名。"},{"id":"c-shiji-084-qujia:m009-0145","start":145,"end":147,"surface":"懷王","kind":"person","person_id":"cbr-p004746","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m009-0150","start":150,"end":152,"surface":"忠臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或泛稱保持未解，不補姓名。"},{"id":"c-shiji-084-qujia:m009-0159","start":159,"end":161,"surface":"鄭袖","kind":"person","person_id":"cbr-p004756","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m009-0165","start":165,"end":167,"surface":"張儀","kind":"person","person_id":"cbr-p004753","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m009-0169","start":169,"end":171,"surface":"屈平","kind":"person","person_id":"cbr-p004745","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m009-0173","start":173,"end":177,"surface":"上官大夫","kind":"person","person_id":"cbr-p004747","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m009-0178","start":178,"end":182,"surface":"令尹子蘭","kind":"person","person_id":"cbr-p004759","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"},{"id":"c-shiji-084-qujia:p010","text":"令尹子蘭聞之大怒，卒使上官大夫短屈原於頃襄王，頃襄王怒而遷之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m010-0000","start":0,"end":4,"surface":"令尹子蘭","kind":"person","person_id":"cbr-p004759","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m010-0011","start":11,"end":15,"surface":"上官大夫","kind":"person","person_id":"cbr-p004747","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m010-0016","start":16,"end":18,"surface":"屈原","kind":"person","person_id":"cbr-p004745","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m010-0019","start":19,"end":22,"surface":"頃襄王","kind":"person","person_id":"cbr-p004760","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m010-0023","start":23,"end":26,"surface":"頃襄王","kind":"person","person_id":"cbr-p004760","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"}],"sources":[{"chapter_id":"c-shiji-040-chu","work_id":"w-shiji","book_id":"b-shiji-040","source_id":"s-shiji-040-chu","source":{"title":"史記／卷040","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷040","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷040&oldid=8736796","revision_id":8736796,"accessed_on":"2026-10-09","extent":"9