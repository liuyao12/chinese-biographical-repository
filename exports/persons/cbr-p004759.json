084-qujia:m008-0020"]},{"surface":"令尹子蘭","mention_ids":["c-shiji-084-qujia:m009-0178","c-shiji-084-qujia:m010-0000"]}],"evidence":[{"mention_id":"c-shiji-084-qujia:m007-0044","chapter_id":"c-shiji-084-qujia","paragraph_id":"c-shiji-084-qujia:p007","quote":"子蘭"},{"mention_id":"c-shiji-084-qujia:m008-0010","chapter_id":"c-shiji-084-qujia","paragraph_id":"c-shiji-084-qujia:p008","quote":"子蘭"},{"mention_id":"c-shiji-084-qujia:m008-0020","chapter_id":"c-shiji-084-qujia","paragraph_id":"c-shiji-084-qujia:p008","quote":"子蘭"},{"mention_id":"c-shiji-084-qujia:m009-0178","chapter_id":"c-shiji-084-qujia","paragraph_id":"c-shiji-084-qujia:p009","quote":"令尹子蘭"},{"mention_id":"c-shiji-084-qujia:m010-0000","chapter_id":"c-shiji-084-qujia","paragraph_id":"c-shiji-084-qujia:p010","quote":"令尹子蘭"}]},{"id":"cbr-p004760","label":"頃襄王（屈原賈生列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"頃襄王","mention_ids":["c-shiji-084-qujia:m008-0002","c-shiji-084-qujia:m010-0019","c-shiji-084-qujia:m010-0023"]}],"evidence":[{"mention_id":"c-shiji-084-qujia:m008-0002","chapter_id":"c-shiji-084-qujia","paragraph_id":"c-shiji-084-qujia:p008","quote":"頃襄王"},{"mention_id":"c-shiji-084-qujia:m010-0019","chapter_id":"c-shiji-084-qujia","paragraph_id":"c-shiji-084-qujia:p010","quote":"頃襄王"},{"mention_id":"c-shiji-084-qujia:m010-0023","chapter_id":"c-shiji-084-qujia","paragraph_id":"c-shiji-084-qujia:p010","quote":"頃襄王"}]}],"mentions":[{"id":"c-shiji-040-chu:m078-0320","start":320,"end":322,"surface":"子蘭","kind":"person","person_id":"cbr-p001951","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p078","chapter_id":"c-shiji-040-chu"},{"id":"c-shiji-084-qujia:m007-0044","start":44,"end":46,"surface":"子蘭","kind":"person","person_id":"cbr-p004759","status":"contextual_provisional","paragraph_id":"c-shiji-084-qujia:p007","chapter_id":"c-shiji-084-qujia"},{"id":"c-shiji-084-qujia:m008-0010","start":10,"end":12,"surface":"子蘭","kind":"person","person_id":"cbr-p004759","status":"contextual_provisional","paragraph_id":"c-shiji-084-qujia:p008","chapter_id":"c-shiji-084-qujia"},{"id":"c-shiji-084-qujia:m008-0020","start":20,"end":22,"surface":"子蘭","kind":"person","person_id":"cbr-p004759","status":"contextual_provisional","paragraph_id":"c-shiji-084-qujia:p008","chapter_id":"c-shiji-084-qujia"},{"id":"c-shiji-084-qujia:m009-0178","start":178,"end":182,"surface":"令尹子蘭","kind":"person","person_id":"cbr-p004759","status":"contextual_provisional","paragraph_id":"c-shiji-084-qujia:p009","chapter_id":"c-shiji-084-qujia"},{"id":"c-shiji-084-qujia:m010-0000","start":0,"end":4,"surface":"令尹子蘭","kind":"person","person_id":"cbr-p004759","status":"contextual_provisional","paragraph_id":"c-shiji-084-qujia:p010","chapter_id":"c-shiji-084-qujia"}],"relations":[{"id":"a-shiji040-079","subject_person_id":"cbr-p001951","predicate":"father","object_person_id":"cbr-p001923","status":"source_attested","evidence":[{"chapter_id":"c-shiji-040-chu","source_id":"s-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p078","quote":"二十七年，秦大夫有私與楚太子鬬，楚太子殺之而亡歸。二十八年，秦乃與齊、韓、魏共攻楚，殺楚將唐眛，取我重丘而去。二十九年，秦復攻楚，大破楚，楚軍死者二萬，殺我將軍景缺。懷王恐，乃使太子爲質於齊以求平。三十年，秦復伐楚，取八城。秦昭王遺楚王書曰：「始寡人與王約爲弟兄，盟于黃棘，太子爲質，至驩也。太子陵殺寡人之重臣，不謝而亡去，寡人誠不勝怒，使兵侵君王之邊。今聞君王乃令太子質於齊以求平。寡人與楚接境壤界，故爲婚姻，所從相親久矣。而今秦楚不驩，則無以令諸侯。寡人願與君王會武關，面相約，結盟而去，寡人之願也。敢以聞下執事。」楚懷王見秦王書，患之。欲往，恐見欺；無往，恐秦怒。昭雎曰：「王毋行，而發兵自守耳。秦虎狼，不可信，有并諸侯之心。」懷王子子蘭勸王行，曰：「柰何絶秦之驩心！」於是往會秦昭王。昭王詐令一將軍伏兵武關，號爲秦王。楚王至，則閉武關，遂與西至咸陽，朝章臺，如蕃臣，不與亢禮。楚懷王大怒，悔不用昭子言。秦因留楚王，要以割巫、黔中之郡。楚王欲盟，秦欲先得地。楚王怒曰：「秦詐我而又彊要我以地！」不復許秦。秦因留之。"}],"qualifiers":{"source_term":"子、生、弟或母稱","historicity":"historical_tradition"},"interpretation_note":"保存本段明示生育、兄弟、母子來源主張，未由繼位或同稱補闕代、母名與共有父母；版本及他篇異說仍待核。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji084-001","subject_person_id":"cbr-p004759","predicate":"father","object_person_id":"cbr-p004746","status":"source_attested","evidence":[{"chapter_id":"c-shiji-084-qujia","source_id":"s-shiji-084-qujia","paragraph_id":"c-shiji-084-qujia:p007","quote":"時秦昭王與楚婚，欲與懷王會。懷王欲行，屈平曰：「秦虎狼之國，不可信，不如毋行。」懷王稚子子蘭勸王行：「奈何絕秦歡？」懷王卒行。入武關，秦伏兵絕其後，因留懷王，以求割地。懷王怒，不聽。亡走趙，趙不內。復之秦，竟死於秦而歸葬。"}],"qualifiers":{"source_term":"懷王稚子子蘭","historicity":"historical_tradition"},"interpretation_note":"依明示子弟保存來源主張；頃襄王長子承接上段懷王。賈嘉孫稱不補闕代父親，未名四子不造姓名。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji084-003","subject_person_id":"cbr-p004759","predicate":"brother","object_person_id":"cbr-p004760","status":"source_attested","evidence":[{"chapter_id":"c-shiji-084-qujia","source_id":"s-shiji-084-qujia","paragraph_id":"c-shiji-084-qujia:p008","quote":"長子頃襄王立，以其弟子蘭為令尹。楚人既咎子蘭以勸懷王入秦而不反也。"}],"qualifiers":{"source_term":"其弟子蘭","historicity":"historical_tradition"},"interpretation_note":"依明示子弟保存來源主張；頃襄王長子承接上段懷王。賈嘉孫稱不補闕代父親，未名四子不造姓名。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji084-003","person_id":"cbr-p004759","title":"令尹","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-084-qujia","source_id":"s-shiji-084-qujia","paragraph_id":"c-shiji-084-qujia:p008","quote":"長子頃襄王立，以其弟子蘭為令尹。楚人既咎子蘭以勸懷王入秦而不反也。"}],"attestations":[{"id":"th-shiji084-003:a001","paragraph_id":"c-shiji-084-qujia:p008","start":13,"end":15,"surface":"令尹","person_mention_id":"c-shiji-084-qujia:m008-0010","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-084-qujia","source_id":"s-shiji-084-qujia","paragraph_id":"c-shiji-084-qujia:p008","quote":"長子頃襄王立，以其弟子蘭為令尹。楚人既咎子蘭以勸懷王入秦而不反也。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"用稱與實際授任分存，未知起訖不補造；長沙太傅第19段為先述、第22段為事件，可能同一任期不當兩次實任。議任公卿不記已授；賈嘉九卿附述層次待覆核。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji084-015","person_id":"cbr-p004759","scope":"same_chapter","chapter_ids":["c-shiji-084-qujia"],"status":"contextual_provisional","rationale":"依明示姓名、懷王入秦及子蘭頃襄王敘事暫接；漁父保留匿名，不補身世。嵌套王稱與代詞尚待逐處核定。","reviewer":"Codex（AI 代理）","surfaces":["令尹子蘭","子蘭"],"evidence":[{"paragraph_id":"c-shiji-084-qujia:p007","quote":"時秦昭王與楚婚，欲與懷王會。懷王欲行，屈平曰：「秦虎狼之國，不可信，不如毋行。」懷王稚子子蘭勸王行：「奈何絕秦歡？」懷王卒行。入武關，秦伏兵絕其後，因留懷王，以求割地。懷王怒，不聽。亡走趙，趙不內。復之秦，竟死於秦而歸葬。"},{"paragraph_id":"c-shiji-084-qujia:p008","quote":"長子頃襄王立，以其弟子蘭為令尹。楚人既咎子蘭以勸懷王入秦而不反也。"},{"paragraph_id":"c-shiji-084-qujia:p009","quote":"屈平既嫉之，雖放流，睠顧楚國，系心懷王，不忘欲反，冀幸君之一悟，俗之一改也。其存君興國而欲反覆之，一篇之中三致志焉。然終無可奈何，故不可以反，卒以此見懷王之終不悟也。人君無愚智賢不肖，莫不欲求忠以自為，舉賢以自佐，然亡國破家相隨屬，而聖君治國累世而不見者，其所謂忠者不忠，而所謂賢者不賢也。懷王以不知忠臣之分，故內惑於鄭袖，外欺於張儀，疏屈平而信上官大夫、令尹子蘭。兵挫地削，亡其六郡，身客死於秦，為天下笑。此不知人之禍也。《易》曰：「井泄不食，為我心惻，可以汲。王明，并受其福。」王之不明，豈足福哉？"},{"paragraph_id":"c-shiji-084-qujia:p010","quote":"令尹子蘭聞之大怒，卒使上官大夫短屈原於頃襄王，頃襄王怒而遷之。"}]}],"equivalence_decisions":[{"id":"eq-shiji084-zilan","person_ids":["cbr-p001951","cbr-p004759"],"canonical_person_id":"cbr-p001951","scope":"cross_chapter","chapter_ids":["c-shiji-040-chu","c-shiji-084-qujia"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-040-chu","source_id":"s-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p078","quote":"二十七年，秦大夫有私與楚太子鬬，楚太子殺之而亡歸。二十八年，秦乃與齊、韓、魏共攻楚，殺楚將唐眛，取我重丘而去。二十九年，秦復攻楚，大破楚，楚軍死者二萬，殺我將軍景缺。懷王恐，乃使太子爲質於齊以求平。三十年，秦復伐楚，取八城。秦昭王遺楚王書曰：「始寡人與王約爲弟兄，盟于黃棘，太子爲質，至驩也。太子陵殺寡人之重臣，不謝而亡去，寡人誠不勝怒，使兵侵君王之邊。今聞君王乃令太子質於齊以求平。寡人與楚接境壤界，故爲婚姻，所從相親久矣。而今秦楚不驩，則無以令諸侯。寡人願與君王會武關，面相約，結盟而去，寡人之願也。敢以聞下執事。」楚懷王見秦王書，患之。欲往，恐見欺；無往，恐秦怒。昭雎曰：「王毋行，而發兵自守耳。秦虎狼，不可信，有并諸侯之心。」懷王子子蘭勸王行，曰：「柰何絶秦之驩心！」於是往會秦昭王。昭王詐令一將軍伏兵武關，號爲秦王。楚王至，則閉武關，遂與西至咸陽，朝章臺，如蕃臣，不與亢禮。楚懷王大怒，悔不用昭子言。秦因留楚王，要以割巫、黔中之郡。楚王欲盟，秦欲先得地。楚王怒曰：「秦詐我而又彊要我以地！」不復許秦。秦因留之。","mention_ids":["c-shiji-040-chu:m078-0320"]},{"chapter_id":"c-shiji-084-qujia","source_id":"s-shiji-084-qujia","paragraph_id":"c-shiji-084-qujia:p007","quote":"時秦昭王與楚婚，欲與懷王會。懷王欲行，屈平曰：「秦虎狼之國，不可信，不如毋行。」懷王稚子子蘭勸王行：「奈何絕秦歡？」懷王卒行。入武關，秦伏兵絕其後，因留懷王，以求割地。懷王怒，不聽。亡走趙，趙不內。復之秦，竟死於秦而歸葬。","mention_ids":["c-shiji-084-qujia:m007-0044"]}],"rationale":"兩篇懷王子子蘭勸其赴秦會武關，親屬稱、勸行之語與共同會盟留秦事件相配。反對者一作昭雎一作屈平的差異保留，不以同指調和人物角色。 各篇原字、原文與已發ID保留，同書不視為獨立見證；同指不確證所有紀年、任職、親屬或敘事，不按全域同名批量改號。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":