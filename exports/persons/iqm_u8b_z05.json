":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m028-0052","start":52,"end":54,"surface":"髙后","kind":"person","person_id":"iqm_u8b_z05","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m028-0055","start":55,"end":57,"surface":"文帝","kind":"person","person_id":"813_l7p_3rl","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m028-0058","start":58,"end":60,"surface":"孝景","kind":"person","person_id":"fys_4me_v3o","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m028-0062","start":62,"end":64,"surface":"張王","kind":"person","person_id":"net_rj0_wi8_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-089-zhanger","book_id":"b-shiji-089","work_id":"w-shiji","source_id":"s-shiji-089-zhanger"},{"id":"c-shiji-089-zhanger:p029","text":"張敖，髙后六年薨。子偃爲魯元王。以母呂后女故，呂后封爲魯元王。元王弱，兄弟少，乃封張敖他姬子二人：壽爲樂昌侯，侈爲信都侯。髙后崩，諸呂無道，大臣誅之，而廢魯元王及樂昌侯、信諸侯。孝文帝即位，復封故魯元王偃爲南宮侯，續張氏。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-089-zhanger:m029-0000","start":0,"end":2,"surface":"張敖","kind":"person","person_id":"net_rj0_wi8_A","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m029-0003","start":3,"end":5,"surface":"髙后","kind":"person","person_id":"iqm_u8b_z05","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m029-0009","start":9,"end":11,"surface":"子偃","kind":"person","person_id":"net_rj0_wi8_AA","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m029-0012","start":12,"end":15,"surface":"魯元王","kind":"person","person_id":"net_rj0_wi8_AA","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m029-0018","start":18,"end":21,"surface":"呂后女","kind":"person","person_id":"kct_zti_uvd_A","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m029-0023","start":23,"end":25,"surface":"呂后","kind":"person","person_id":"iqm_u8b_z05","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m029-0027","start":27,"end":30,"surface":"魯元王","kind":"person","person_id":