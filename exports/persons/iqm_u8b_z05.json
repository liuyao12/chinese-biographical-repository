h_id":"c-shiji-089-zhanger:p028","quote":"魯元公主"},{"mention_id":"c-shiji-089-zhanger:m029-0018","chapter_id":"c-shiji-089-zhanger","paragraph_id":"c-shiji-089-zhanger:p029","quote":"呂后女"}],"family_path":{"connection":"father","generation_distance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-089-zhanger","source_id":"s-shiji-089-zhanger","paragraph_id":"c-shiji-089-zhanger:p023","quote":"漢三年，韓信已定魏地，遣張耳與韓信撃破趙井陘，斬陳餘泜水上，追殺趙王歇襄國。漢立張耳爲趙王。漢五年，張耳薨，謚爲景王。子敖嗣立爲趙王。髙祖長女魯元公主爲趙王敖后。","source_term":"髙祖長女魯元公主"}],"source_assertion_id":"a-shiji089-006","interpretation_note":"以此受傳正文的明示近親主張配置局部家族；不合併跨篇候選身份、不補闕名世代，不表示遠祖世系已核實。分支字元不是長幼排行。","reviewer":"Codex（AI 代理）","parent_person_id":"kct_zti_uvd"},"id_aliases":["cbr-p004999"]}],"source_mention_summary":[{"source_id":"s-shiji-089-zhanger","work_id":"w-shiji","book_id":"b-shiji-089","chapter_id":"c-shiji-089-zhanger","mention_count":5,"mention_ids":["c-shiji-089-zhanger:m026-0178","c-shiji-089-zhanger:m028-0052","c-shiji-089-zhanger:m029-0003","c-shiji-089-zhanger:m029-0023","c-shiji-089-zhanger:m029-0061"],"paragraph_ids":["c-shiji-089-zhanger:p026","c-shiji-089-zhanger:p028","c-shiji-089-zhanger:p029"],"passage_count":3}],"most_mentioned_source_ids":["s-shiji-089-zhanger"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji089-010","subject_person_id":"kct_zti_uvd_A","predicate":"mother","object_person_id":"iqm_u8b_z05","status":"source_attested","evidence":[{"chapter_id":"c-shiji-089-zhanger","source_id":"s-shiji-089-zhanger","paragraph_id":"c-shiji-089-zhanger:p029","quote":"張敖，髙后六年薨。子偃爲魯元王。以母呂后女故，呂后封爲魯元王。元王弱，兄弟少，乃封張敖他姬子二人：壽爲樂昌侯，侈爲信都侯。髙后崩，諸呂無道，大臣誅之，而廢魯元王及樂昌侯、信諸侯。孝文帝即位，復封故魯元王偃爲南宮侯，續張氏。"}],"qualifiers":{"source_term":"呂后女","historicity":"historical_tradition"},"interpretation_note":"按明示親屬保存；父事不作父系，他姬不補姓名或推二子同母。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-089-zhanger:m026-0178","start":178,"end":180,"surface":"呂后","kind":"person","person_id":"iqm_u8b_z05","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p026","chapter_id":"c-shiji-089-zhanger"},{"id":"c-shiji-089-zhanger:m028-0052","start":52,"end":54,"surface":"髙后","kind":"person","person_id":"iqm_u8b_z05","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p028","chapter_id":"c-shiji-089-zhanger"},{"id":"c-shiji-089-zhanger:m029-0003","start":3,"end":5,"surface":"髙后","kind":"person","person_id":"iqm_u8b_z05","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p029","chapter_id":"c-shiji-089-zhanger"},{"id":"c-shiji-089-zhanger:m029-0023","start":23,"end":25,"surface":"呂后","kind":"person","person_id":"iqm_u8b_z05","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p029","chapter_id":"c-shiji-089-zhanger"},{"id":"c-shiji-089-zhanger:m029-0061","start":61,"end":63,"surface":"髙后","kind":"person","person_id":"iqm_u8b_z05","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p029","chapter_id":"c-shiji-089-zhanger"}],"relations":[{"id":"a-shiji089-010","subject_person_id":"kct_zti_uvd_A","predicate":"mother","object_person_id":"iqm_u8b_z05","status":"source_attested","evidence":[{"chapter_id":"c-shiji-089-zhanger","source_id":"s-shiji-089-zhanger","paragraph_id":"c-shiji-089-zhanger:p029","quote":"張敖，髙后六年薨。子偃爲魯元王。以母呂后女故，呂后封爲魯元王。元王弱，兄弟少，乃封張敖他姬子二人：壽爲樂昌侯，侈爲信都侯。髙后崩，諸呂無道，大臣誅之，而廢魯元王及樂昌侯、信諸侯。孝文帝即位，復封故魯元王偃爲南宮侯，續張氏。"}],"qualifiers":{"source_term":"呂后女","historicity":"historical_tradition"},"interpretation_note":"按明示親屬保存；父事不作父系，他姬不補姓名或推二子同母。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji089-050","person_id":"iqm_u8b_z05","scope":"same_chapter","chapter_ids":["c-shiji-089-zhanger"],"status":"contextual_provisional","rationale":"按明示姓名及局部語境承接；武臣與趙歇、張敖的趙王用稱限各段，張黡張黶按同行事件暫接但原字分存。未名者不補姓名。","reviewer":"Codex（AI 代理）","surfaces":["呂后","髙后"],"evidence":[{"paragraph_id":"c-shiji-089-zhanger:p026","quote":"漢九年，貫髙怨家知其謀，乃上變告之。於是上皆并逮捕趙王、貫髙等。十餘人皆爭自剄，貫髙獨怒罵曰：「誰令公爲之？今王實無謀，而并捕王；公等皆死，誰白王不反者！」乃轞車膠致，與王詣長安。治張敖之罪。上乃詔趙群臣賓客有敢從王皆族。貫髙與客孟舒等十餘人，皆自髡鉗，爲王家奴，從來。貫髙至，對獄，曰：「獨吾屬爲之，王實不知。」吏治榜笞數千，刺剟，身無可撃者，終不復言。呂后數言張王以魯元公主故，不宜有此。上怒曰：「使張敖據天下，豈少而女乎！」不聽。廷尉以貫髙事辭聞，上曰：「壯士！誰知者，以私問之。」中大夫泄公曰：「臣之邑子，素知之。此固趙國立名義不侵爲然諾者也。」上使泄公持節問之箯輿前。仰視曰：「泄公邪？」泄公勞苦如生平驩，與語，問張王果有計謀不。髙曰：「人情寧不各愛其父母妻子乎？今吾三族皆以論死，豈以王易吾親哉！顧爲王實不反，獨吾等爲之。」具道本指所以爲者王不知狀。於是泄公入，具以報，上乃赦趙王。"},{"paragraph_id":"c-shiji-089-zhanger:p028","quote":"張敖已出，以尚魯元公主故，封爲宣平侯。於是上賢張王諸客，以鉗奴從張王入關，無不爲諸侯相、郡守者。及孝惠、髙后、文帝、孝景時，張王客子孫皆得爲二千石。"},{"paragraph_id":"c-shiji-089-zhanger:p029","quote":"張敖，髙后六年薨。子偃爲魯元王。以母呂后女故，呂后封爲魯元王。元王弱，兄弟少，乃封張敖他姬子二人：壽爲樂昌侯，侈爲信都侯。髙后崩，諸呂無道，大臣誅之，而廢魯元王及樂昌侯、信諸侯。孝文帝即位，復封故魯元王偃爲南宮侯，續張氏。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-089-zhanger:p026","text":"漢九年，貫髙怨家知其謀，乃上變告之。於是上皆并逮捕趙王、貫髙等。十餘人皆爭自剄，貫髙獨怒罵曰：「誰令公爲之？今王實無謀，而并捕王；公等皆死，誰白王不反者！」乃轞車膠致，與王詣長安。治張敖之罪。上乃詔趙群臣賓客有敢從王皆族。貫髙與客孟舒等十餘人，皆自髡鉗，爲王家奴，從來。貫髙至，對獄，曰：「獨吾屬爲之，王實不知。」吏治榜笞數千，刺剟，身無可撃者，終不復言。呂后數言張王以魯元公主故，不宜有此。上怒曰：「使張敖據天下，豈少而女乎！」不聽。廷尉以貫髙事辭聞，上曰：「壯士！誰知者，以私問之。」中大夫泄公曰：「臣之邑子，素知之。此固趙國立名義不侵爲然諾者也。」上使泄公持節問之箯輿前。仰視曰：「泄公邪？」泄公勞苦如生平驩，與語，問張王果有計謀不。髙曰：「人情寧不各愛其父母妻子乎？今吾三族皆以論死，豈以王易吾親哉！顧爲王實不反，獨吾等爲之。」具道本指所以爲者王不知狀。於是泄公入，具以報，上乃赦趙王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-089-zhanger:m026-0004","start":4,"end":6,"surface":"貫髙","kind":"person","person_id":"axo_it5_tk0","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m026-0006","start":6,"end":8,"surface":"怨家","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、