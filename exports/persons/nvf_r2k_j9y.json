-jingdi"}],"relations":[],"title_holdings":[{"id":"th-shiji011-003","person_id":"nvf_r2k_j9y","title":"魏其侯","kind":"noble_rank","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-011-jingdi","source_id":"s-shiji-011-jingdi","paragraph_id":"c-shiji-011-jingdi:p004","quote":"封大將軍竇嬰為魏其侯"}],"attestations":[{"id":"th-shiji011-003:a001","paragraph_id":"c-shiji-011-jingdi:p004","start":136,"end":139,"surface":"魏其侯","person_mention_id":"c-shiji-011-jingdi:m004-0133","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-011-jingdi","source_id":"s-shiji-011-jingdi","paragraph_id":"c-shiji-011-jingdi:p004","quote":"封大將軍竇嬰為魏其侯"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予／貶降、用稱與有效時段分開；日期原表述未換算，未知端點不當無限延伸，不以死亡補終止。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-011-jingdi:p004","text":"三年正月乙巳，赦天下。長星出西方。天火燔雒陽東宮大殿城室。吳王濞、楚王戊、趙王遂、膠西王卬、濟南王辟光、菑川王賢、膠東王雄渠反，發兵西鄉。天子為誅晁錯，遣袁盎諭告，不止，遂西圍梁。上乃遣大將軍竇嬰、太尉周亞夫將兵誅之。六月乙亥。赦亡軍及楚元王子藝等與謀反者。封大將軍竇嬰為魏其侯。立楚元王子平陸侯禮為楚王。立皇子端為膠西王，子勝為中山王。徙濟北王志為菑川王，淮陽王餘為魯王，汝南王非為江都王。齊王將廬、燕王嘉皆薨。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-011-jingdi:m004-0029","start":29,"end":32,"surface":"吳王濞","kind":"person","person_id":"tpx_x74_xhk","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0033","start":33,"end":36,"surface":"楚王戊","kind":"person","person_id":"5jd_t02_cdy","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0037","start":37,"end":40,"surface":"趙王遂","kind":"person","person_id":"yqp_nlb_p1p_AEA","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0041","start":41,"end":45,"surface":"膠西王卬","kind":"person","person_id":"naf_4g1_vmz","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0046","start":46,"end":51,"surface":"濟南王辟光","kind":"person","person_id":"sym_fqo_4zf","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0052","start":52,"end":56,"surface":"菑川王賢","kind":"person","person_id":"vrf_8lm_g7h","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0057","start":57,"end":62,"surface":"膠東王雄渠","kind":"person","person_id":"tc7_le7_5xb","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0069","start":69,"end":71,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACA","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0073","start":73,"end":75,"surface":"晁錯","kind":"person","person_id":"f0u_lxn_ztw","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0077","start":77,"end":79,"surface":"袁盎","kind":"person","person_id":"ibu_a0b_ggu","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0090","start":90,"end":91,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_ACA","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0096","start":96,"end":98,"surface":"竇嬰","kind":"person","person_id":"nvf_r2k_j9y","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0101","start":101,"end":104,"surface":"周亞夫","kind":"person","person_id":"nwx_f88_xfu","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0118","start":118,"end":121,"surface":"楚元王","kind":"person","person_id":"zju_pdu_xge","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0121","start":121,"end":123,"surface":"子藝","kind":"person","person_id":"zju_pdu_xge_A","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0133","start":133,"end":135,"surface":"竇嬰","kind":"person","person_id":"nvf_r2k_j9y","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0141","start":141,"end":144,"surface":"楚元王","kind":"person","person_id":"zju_pdu_xge","status":"contextual_provis