ial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-099-huanxuan:p018:m0055","start":55,"end":58,"surface":"楊道護","kind":"person","person_id":"6cs_rzs_yln","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。","paragraph_id":"c-jinshu-099-huanxuan:p018","chapter_id":"c-jinshu-099-huanxuan"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-099-huanxuan:p018","text":"新野人庾仄聞玄受九錫，乃起義兵，襲馮該於襄陽，走之。仄有眾七千，于城南設壇，祭祖宗七廟。南蠻參軍庾彬、安西參軍楊道護、江安令鄧襄子謀為內應。仄本仲堪黨，桓偉既死，石康未至，故乘間而發，江陵震動。桓濟之子亮起兵于羅縣，自號平南將軍、湘州刺史，以討仄為名。南蠻校尉羊僧壽與石康共攻襄陽，仄眾散，奔姚興，彬等皆遇害。長沙相陶延壽以亮乘亂起兵，遣收之。玄徙亮於衡陽，誅其同謀桓奧等。","source_position":{"kind":"wikitext_codepoint_positions","raw_path":"sources/jinshu/wikisource-2644703-raw.wikitext","raw_start":4672,"raw_end":4861,"character_positions":[4674,4675,4676,4677,4678,4679,4680,4681,4682,4683,4684,4685,4686,4687,4688,4689,4690,4691,4692,4693,4694,4695,4696,4697,4698,4699,4700,4701,4702,4703,4704,4705,4706,4707,4708,4709,4710,4711,4712,4713,4714,4715,4716,4717,4718,4719,4720,4721,4722,4723,4724,4725,4726,4727,4728,4729,4730,4731,4732,4733,4734,4735,4736,4737,4738,4739,4740,4741,4742,4743,4744,4745,4746,4747,4748,4749,4750,4751,4752,4753,4754,4755,4756,4757,4758,4759,4760,4761,4762,4763,4764,4765,4766,4767,4768,4769,4770,4771,4772,4773,4774,4775,4776,4777,4778,4779,4780,4781,4782,4783,4784,4785,4786,4787,4788,4789,4790,4791,4792,4793,4794,4795,4796,4797,4798,4799,4800,4801,4802,4803,4804,4805,4806,4807,4808,4809,4810,4811,4812,4813,4814,4815,4816,4817,4818,4819,4820,4821,4822,4823,4824,4825,4826,4827,4828,4829,4830,4831,4832,4833,4834,4835,4836,4837,4838,4839,4840,4841,4842,4843,4844,4845,4846,4847,4848,4849,4850,4851,4852,4853,4854,4855,4856,4857,