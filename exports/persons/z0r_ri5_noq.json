on_id":"z0r_ri5_noq","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xuezong:line049:m0063","start":63,"end":64,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xuezong:line049:m0072","start":72,"end":73,"surface":"綜","kind":"person","person_id":"yt7_qwp_k7p","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"}],"annotation_status":"reviewed","source_position":{"first_line":49,"last_line":49,"revision_id":2086397,"raw_start":6346,"raw_end":6431,"character_positions":[6346,6347,6353,6354,6355,6356,6359,6360,6361,6362,6363,6364,6365,6366,6367,6368,6369,6370,6371,6372,6373,6374,6375,6376,6377,6378,6379,6380,6381,6382,6383,6384,6385,6386,6387,6388,6389,6390,6391,6392,6393,6394,6395,6396,6397,6398,6399,6400,6401,6402,6403,6404,6405,6406,6407,6408,6409,6410,6411,6412,6413,6414,6415,6416,6417,6418,6419,6420,6421,6422,6423,6424,6425,6426,6427,6428,6429,6430]},"chapter_id":"c-sanguozhi-053-xuezong","book_id":"b-sanguozhi-053","work_id":"w-sanguozhi","source_id":"s-sanguozhi-053-xuezong"},{"id":"c-sanguozhi-057-lumao:line076","text":"嘉禾元年，公車征瑁，拜議郎、選曹尚書。孫權忿公孫淵之巧詐反覆，欲親征之，瑁上疏諫曰：","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-057-lumao:line076:m0008","start":8,"end":9,"surface":"瑁","kind":"person","person_id":"36u_j3u_i3z","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-lumao:line076:m0019","start":19,"end":21,"surface":"孫權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-lumao:line076:m0022","start":22,"end":25,"surface":"公孫淵","kind":"person","person_id":"z0r_ri5_noq","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-lumao:line076:m0036","start":36,"end":37,"surface":"瑁","kind":"person","person_id":"36u_j3u_i3z","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"}],"annotation_status":"reviewed","source_position":{"first_line":76,"last_line":76,"revision_id":2638131,"raw_start":13597,"raw_end":13648,"character_positions":[13604,13605,13606,13607,13610,13611,13612,13613,13614,13615,13616,13617,13618,13619,13620,13621,13622,13623,13624,13625,13626,13627,13628,13629,13630,13631,13632,13633,13634,13635,13636,13637,13638,13639,13640,13641,13642,13643,13644,13645,13646,13647]},"chapter_id":"c-sanguozhi-057-lumao","book_id":"b-sanguozhi-057","work_id":"w-sanguozhi","source_id":"s-sanguozhi-057-lumao"},{"id":"c-sanguozhi-057-lumao:line077","text":"臣聞聖王之御遠夷，羈縻而已，不常保有，故古者制地，謂之荒服，言慌惚無常，不可保也。今淵東夷小丑，屏在海隅，雖托人面，與禽獸無異。國家所為不愛貨寶遠以加之者，非嘉其德義也，誠欲誘納愚弄，以規其馬耳。淵之驕黠，恃遠負命，此乃荒貊常態，豈足深怪？昔漢諸帝亦嘗銳意以事外夷，馳使散貨，充滿西域，雖時有恭從，然其使人見害，財貨並沒，不可勝數。今陛下不忍悁悁之忿，欲越巨海，身踐其土，群臣愚議，竊謂不安。何者？北寇與國，壤地連接，苟有間隙，應機而至。夫所以越海求馬，曲意於淵者，為赴目前之急，除腹心之疾也；而更棄本追末，捐近治遠，忿以改規，激以動眾，斯乃猾虜所願聞，非大吳之至計也。又兵家之術，以功役相疲，勞逸相待，得失之間，所覺輒多。且沓渚去淵，道裡尚遠，今到其岸，兵勢三分，使強者進取，次當守船，又次運糧，行人雖多，難得悉用。加以單步負糧，經遠深入，賊地多馬，邀截無常。若淵狙詐，與北未絕，動眾之日，唇齒相濟。若實孑然無所憑賴，其畏怖遠迸，或難卒滅。使天誅稽於朔野，山虜承間而起，恐非萬安之長慮也。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-057-lumao:line077:m0042","start":42,"end":43,"surface":"淵","kind":"person","person_id":"z0r_ri5_noq","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-lumao:line077:m0098","start":98,"end":99,"surface":"淵","kind":"person","person_id":"z0r_ri5_noq","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-lumao:line077:m0230","start":230,"end":231,"surface":"淵","kind":"person","person_id":"z0r_ri5_noq","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-lumao:line077:m0316","start":316,"end":317,"surface":"淵","kind":"person","person_id":"z0r_ri5_noq","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-lumao:line077:m0382","start":382,"end":383,"surface":"淵","kind