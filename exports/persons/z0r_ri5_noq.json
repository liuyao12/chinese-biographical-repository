,2957,2958,2959,2960,2961,2962,2963,2964,2965,2966,2967]},"chapter_id":"c-sanguozhi-052-zhangzhao-complete","book_id":"b-sanguozhi-052","work_id":"w-sanguozhi","source_id":"s-sanguozhi-052-zhangzhao-complete"},{"id":"c-sanguozhi-058-luxun:line040","text":"權遂征夷州，得不補失。及公孫淵背盟，權欲往征。遜上疏曰：","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-058-luxun:line040:m0000","start":0,"end":1,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line040:m0012","start":12,"end":15,"surface":"公孫淵","kind":"person","person_id":"z0r_ri5_noq","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line040:m0018","start":18,"end":19,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line040:m0023","start":23,"end":24,"surface":"遜","kind":"person","person_id":"lii_454_vuv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"}],"annotation_status":"reviewed","source_position":{"first_line":40,"last_line":40,"revision_id":2131313,"raw_start":4230,"raw_end":4258,"character_positions":[4230,4231,4232,4233,4234,4235,4236,4237,4238,4239,4240,4241,4242,4243,4244,4245,4246,4247,4248,4249,4250,4251,4252,4253,4254,4255,4256,4257]},"chapter_id":"c-sanguozhi-058-luxun","book_id":"b-sanguozhi-058","work_id":"w-sanguozhi","source_id":"s-sanguozhi-058-luxun"},{"id":"c-sanguozhi-058-luxun:line041","text":"淵憑險恃固，拘留大使，名馬不獻，實可仇忿。蠻夷猾夏，未染王化，鳥竄荒裔，拒逆王師，至令陛下爰赫斯怒，欲勞萬乘泛輕越海，不慮其危而涉不測。方今天下雲擾，群雄虎爭，英豪踴躍，張聲大視。陛下以神武之姿，誕膺期運，破操烏林，敗備西陵，禽羽荊州，斯三虜者當世雄傑。皆摧其鋒。聖化所綏，萬里草偃，方蕩平華夏，總一大猷。今不忍小忿，而發雷霆之怒，違垂堂之戒，輕萬乘之重，此臣之所惑也。臣聞志行萬里者，不中道而輟足；圖四海者，匪懷細以害大。強寇在境，荒服未庭，陛下乘桴遠征，必致窺闟，戚至而憂，悔之無及。若使大事時捷，則淵不討自服；今乃遠惜遼東眾之與馬，奈何獨欲捐江東萬安之本業而不借乎？乞息六師，以威大虜，早定中夏，垂耀將來。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-058-luxun:line041:m0000","start":0,"end":1,"surface":"淵","kind":"person","person_id":"z0r_ri5_noq","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line041:m0104","start":104,"end":105,"surface":"操","kind":"person","person_id":"dad_b77_b38","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line041:m0109","start":109,"end":110,"surface":"備","kind":"person","person_id":"5f2_396_25c","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line041:m0114","start":114,"end":115,"surface":"羽","kind":"person","person_id":"1c2_03c_9ea","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line041:m0252","start":252,"end":253,"surface":"淵","kind":"person","person_id":"z0r_ri5_noq","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"}],"annotation_status":"reviewed","source_position":{"first_line":41,"last_line":41,"revision_id":2131313,"raw_start":4259,"raw_end":4575,"character_positions":[4267,4268,4269,4270,4271,4272,4273,4274,4275,4276,4277,4278,4279,4280,4281,4282,4283,4284,4285,4286,4287,4288,4289,4290,4291,4292,4293,4294,4295,4296,4297,4298,4299,4300,4301,4302,4303,4304,4305,4306,4307,4308,4309,4310,4311,4312,4313,4314,4315,4316,4317,4318,4319,4320,4321,4322,4323,4324,4325,4326,4327,4328,4329,4330,4331,4332,4333,4334,4335,4336,4337,4338,4339,4340,4341,4342,4343,4344,4345,4346,4347,4348,4349,4350,4351,4352,4353,4354,4355,4356,4357,4358,4359,4360,4361,4362,4363,4364,4365,4366,4367,4368,4369,4370,4371,4372,4373,4374,4375,4376,4377,4378,4379,4380,4381,4382,4383,4384,4385,4386,4387,4388,4389,4390,4391,4392,4393,4394,4395,4396,4397,4398,4399,4400,4401,4402,4403,4404,4405,4406,4407,4408,4409,4410,4411,4412,4413,4414,4415,4416,4417,4418,4419,4420,4421,4422,4423,4424,4425,4426,4427,4428,4429,4430,4431,4432,4433,4434,4435,4436,4437,4438,4439,4440,4441,4442,4443,4444,4445,4446,4447,4448,4449,4450,4451,4452,4453,4454,4455,4456,44