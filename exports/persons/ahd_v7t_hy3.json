不就。除鷹揚將軍、鎮蠻護軍、西陽太守。從溫征伐有功，遷督荊州之南陽襄陽新野義陽順陽雍州之京兆揚州之義成七郡軍事、甯朔將軍、義成新野二郡太守，鎮襄陽。又從溫破姚襄。及虜周成，進號征虜將軍，賜爵豐城公。尋遷振威將軍、江州刺史、領鎮蠻護軍、西陽譙二郡太守。溫之破姚襄也，獲襄將張駿、楊凝等，徙于尋陽。沖在江陵，未及之職，而駿率其徒五百人殺江州督護趙毗，掠武昌府庫，將妻子北叛。沖遣將討獲之，遽還所鎮。","source_position":{"kind":"wikitext_codepoint_positions","raw_path":"sources/jinshu/wikisource-1536331-raw.wikitext","raw_start":5350,"raw_end":5583,"character_positions":[5352,5353,5354,5355,5356,5357,5358,5359,5360,5361,5362,5363,5364,5365,5366,5367,5368,5369,5370,5371,5372,5373,5374,5375,5376,5377,5378,5379,5380,5381,5382,5383,5384,5385,5386,5387,5388,5389,5390,5391,5392,5393,5394,5395,5396,5397,5398,5399,5400,5401,5402,5403,5404,5405,5406,5407,5408,5409,5410,5411,5412,5413,5414,5415,5416,5417,5418,5419,5420,5421,5422,5423,5424,5425,5426,5427,5428,5429,5430,5431,5432,5433,5434,5435,5436,5437,5438,5439,5440,5441,5442,5443,5444,5445,5446,5447,5448,5449,5450,5451,5452,5453,5454,5455,5456,5457,5458,5459,5460,5461,5462,5463,5464,5465,5466,5467,5468,5469,5470,5471,5472,5473,5474,5475,5476,5477,5478,5479,5480,5481,5482,5483,5484,5485,5486,5487,5488,5489,5490,5491,5492,5493,5494,5495,5496,5497,5498,5499,5500,5501,5502,5503,5504,5505,5506,5507,5508,5509,5510,5511,5512,5513,5514,5515,5516,5517,5518,5519,5520,5521,5522,5523,5524,5525,5526,5527,5528,5529,5530,5531,5532,5533,5534,5535,5536,5537,5538,5539,5540,5541,5542,5543,5544,5545,5546,5547,5548,5549,5550,5551,5552,5553,5554,5555,5556,5557,5558,5559,5560,5561,5562,5563,5564,5565,5566,5567,5568,5569,5570,5571,5572,5573,5574,5575,5576,5577,5578,5579,5580,5581,5582]},"mentions":[{"id":"c-jinshu-074-huan-family:p023:m0000","start":0,"end":1,"surface":"沖","kind":"person","person_id":"u9s_w6j_8mc_AE","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。"},{"id":"c-jinshu-074-huan-family:p023:m0002","start":2,"end":4,"surface":"幼子","kind":"person","person_id":"u9s_w6j_8mc_AE","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。"},{"id":"c-jinshu-074-huan-family:p023:m0005"