8ci_A","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0152","start":152,"end":153,"surface":"賜","kind":"person","person_id":"li9_cmb_8ci_AA","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0163","start":163,"end":164,"surface":"頗","kind":"person","person_id":"li9_cmb_8ci_AAA","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0165","start":165,"end":169,"surface":"平陽公主","kind":"person","person_id":"921_w24_4mr","status":"contextual_provisional"}],"chapter_id":"c-shiji-095-fankuang","book_id":"b-shiji-095","work_id":"w-shiji","source_id":"s-shiji-095-fankuang"},{"id":"c-shiji-113-nanyue:p002","text":"高后時，有司請禁南越關市鐵器。佗曰：「高帝立我，通使物，今高後聽讒臣，別異蠻夷，隔絕器物，此必長沙王計也，欲倚中國，擊滅南越而并王之，自為功也。」於是佗乃自尊號為南越武帝，發兵攻長沙邊邑，敗數縣而去焉。高後遣將軍隆慮侯灶往擊之。會暑溼，士卒大疫，兵不能踰嶺。歲餘，高后崩，即罷兵。佗因此以兵威邊，財物賂遺閩越、西甌、駱，役屬焉，東西萬餘里。乃乘黃屋左纛，稱制，與中國侔。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-113-nanyue:m002-0000","start":0,"end":2,"surface":"高后","kind":"person","person_id":"i30_mjq_6q8_A","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m002-0015","start":15,"end":16,"surface":"佗","kind":"person","person_id":"bvb_d1z_fd0","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m002-0019","start":19,"end":21,"surface":"高帝","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m002-0029","start":29,"end":31,"surface":"高後","kind":"person","person_id":"i30_mjq_6q8_A","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m002-0047","start":47,"end":50,"surface":"長沙王","kind":"person","person_id":"8ip_ubw_ssk","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m002-0075","start":75,"end":76,"surface":"佗","kind":"person","person_id":"bvb_d1z_fd0","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m002-0101","start":101,"end":103,"surface":"高後","kind":"person","person_id":"i30_mjq_6q8_A","status":"contextual_provisional"},{"id":"c-shiji-113-n