。及審後主不死，乃遣其部將辛昉馳驛赴京師歸款。隋文帝大悅，謂昉曰：「猛懷其舊主，送故情深，即是我之誠臣。保守一方，不勞兵甲，又是我之功臣。」即日拜昉開府儀同三司，仍詔猛與行軍總管韋洸便留嶺表經略。","note":"此爵屬伯信。","chapter_id":"c-nanshi-024-wangmeng","book_id":"b-nanshi-024","work_id":"w-nanshi","source_id":"s-nanshi-024-wangmeng-ws1765279"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[{"parent_person_id":"5ye_fwj_neh","scope":"sons_of_parent","ordinal":7,"position":"unspecified","interpretation_status":"source_attested","assertion_id":"a-nanshi024-wangmeng-chen-son-2","person_id":"5ye_fwj_neh_B","evidence":[{"work_id":"w-chenshu","book_id":"b-chenshu-028","source_id":"s-chenshu-028-wangmeng-commanders-context-ws2581394","chapter_id":"c-chenshu-028-wangmeng-commanders-context","paragraph_id":"c-chenshu-028-wangmeng-commanders-context:p002","quote":"衡陽王伯信字孚之，世祖第七子也。","subject_person_mention_id":"c-chenshu-028-wangmeng-commanders-context:p002:m0003","object_person_reference_id":"c-chenshu-028-wangmeng-commanders-context:p002:r0009","relationship_anchor":{"paragraph_id":"c-chenshu-028-wangmeng-commanders-context:p002","surface":"世祖第七子","start":9,"end":14}}]}],"preferred_birth_order_constraints":[{"parent_person_id":"5ye_fwj_neh","scope":"sons_of_parent","ordinal":7,"position":"unspecified","interpretation_status":"source_attested","assertion_id":"a-nanshi024-wangmeng-chen-son-2","person_id":"5ye_fwj_neh_B","evidence":[{"work_id":"w-chenshu","book_id":"b-chenshu-028","source_id":"s-chenshu-028-wangmeng-commanders-context-ws2581394","chapter_id":"c-chenshu-028-wangmeng-commanders-context","paragraph_id":"c-chenshu-028-wangmeng-commanders-context:p002","quote":"衡陽王伯信字孚之，世祖第七子也。","subject_person_mention_id":"c-chenshu-028-wangmeng-commanders-context:p002:m0003","object_person_reference_id":"c-chenshu-028-wangmeng-commanders-context:p002:r0009","relationship_anchor":{"paragraph_id":"c-chenshu-028-wangmeng-commanders-context:p002","surface":"世祖第七子","start":9,"end":14}}]}],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":