uman_reviewed":false,"model":null},{"id":"th-nanshi024-wangmeng-m4-59","person_id":"5ye_fwj_neh_B","title":"西衡州刺史","kind":"office","mode":"attestation","attestations":[{"id":"th-nanshi024-wangmeng-m4-59:a","person_mention_id":"c-nanshi-024-wangmeng:p004:m0067","usage":"narrative","date_expression":null,"paragraph_id":"c-nanshi-024-wangmeng:p004","surface":"西衡州刺史","start":59,"end":64}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-024","source_id":"s-nanshi-024-wangmeng-ws1765279","chapter_id":"c-nanshi-024-wangmeng","paragraph_id":"c-nanshi-024-wangmeng:p004","quote":"禎明二年，詔授鎭南大將軍、都督二十四州諸軍事，尋命徙鎭廣州。未之鎭，而隋師濟江，猛總督所部赴援。時廣州刺史臨汝侯方慶、西衡州刺史衡陽王伯信並隸猛督府，各觀望不至。猛使高州刺史戴智烈、清遠太守曾孝遠各以輕兵就斬之而發其兵。及聞台城不守，乃舉哀素服，藉稿不食，歎曰：「申包胥獨何人哉。」因勒兵緣江拒守，以固誠節。及審後主不死，乃遣其部將辛昉馳驛赴京師歸款。隋文帝大悅，謂昉曰：「猛懷其舊主，送故情深，即是我之誠臣。保守一方，不勞兵甲，又是我之功臣。」即日拜昉開府儀同三司，仍詔猛與行軍總管韋洸便留嶺表經略。","person_mention_id":"c-nanshi-024-wangmeng:p004:m0067"}],"status":"source_attested","interpretation_note":"按本見證原職名及其所屬人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"th-nanshi024-wangmeng-m4-64","person_id":"5ye_fwj_neh_B","title":"衡陽王","kind":"noble_rank","mode":"attestation","attestations":[{"id":"th-nanshi024-wangmeng-m4-64:a","person_mention_id":"c-nanshi-024-wangmeng:p004:m0067","usage":"narrative","date_expression":null,"paragraph_id":"c-nanshi-024-wangmeng:p004","surface":"衡陽王","start":64,"end":67}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-024","source_id":"s-nanshi-024-wangmeng-ws1765279","chapter_id":"c-nanshi-024-wangmeng","paragraph_id":"c-nanshi-024-wangmeng:p004","quote":"禎明二年，詔授鎭南大將軍、都督二十四州諸軍事，尋命徙鎭廣州。未之鎭，而隋師濟江，猛總督所部赴援。時廣州刺史臨汝侯方慶、西衡州刺史衡陽王伯信並隸猛督府，各觀望不至。猛使高州刺史戴智烈、清遠太守曾孝遠各以輕兵就斬之而發其兵。及聞台城不守，乃舉哀素服，藉稿不食，歎