rt":614,"end":616,"surface":"將軍","kind":"person","person_id":"cbr-p004662","status":"contextual_provisional"}],"chapter_id":"c-shiji-083-luzou","book_id":"b-shiji-083","work_id":"w-shiji","source_id":"s-shiji-083-luzou"},{"id":"c-shiji-083-luzou:p016","text":"臣聞忠無不報，信不見疑，臣常以為然，徒虛語耳。昔者荊軻慕燕丹之義，白虹貫日，太子畏之；衛先生為秦畫長平之事，太白蝕昴，而昭王疑之。夫精變天地而信不喻兩主，豈不哀哉！今臣盡忠竭誠，畢議願知，左右不明，卒從吏訊，為世所疑，是使荊軻、衛先生復起，而燕、秦不悟也。願大王孰察之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-083-luzou:m016-0000","start":0,"end":1,"surface":"臣","kind":"person","person_id":"cbr-p004689","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m016-0012","start":12,"end":13,"surface":"臣","kind":"person","person_id":"cbr-p004689","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m016-0025","start":25,"end":27,"surface":"荊軻","kind":"person","person_id":"cbr-p004695","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m016-0028","start":28,"end":30,"surface":"燕丹","kind":"person","person_id":"cbr-p004696","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m016-0038","start":38,"end":40,"surface":"太子","kind":"person","person_id":"cbr-p004696","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m016-0043","start":43,"end":46,"surface":"衛先生","kind":"person","person_id":"cbr-p004697","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m016-0060","start":60,"end":62,"surface":"昭王","kind":"person","person_id":"cbr-p004658","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m016-0074","start":74,"end":76,"surface":"兩主","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或譬喻保留；燕尾生不直接當作另一具名人物。"},{"id":"c-shiji-083-luzou:m016-0083","start":83,"end":84,"surface":"臣","kind":"person","person_id":"cbr-p004689","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m016-0094","start":94,"end":96,"surface":"左右","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或譬喻保留；燕尾生不直接當作另一具名人物。