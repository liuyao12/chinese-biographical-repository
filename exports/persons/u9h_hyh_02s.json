ntime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-songshu-049-liuzhong:p002:m0274","start":274,"end":276,"surface":"徐邕","kind":"person","person_id":"u9h_hyh_02s","status":"contextual_provisional","paragraph_id":"c-songshu-049-liuzhong:p002","chapter_id":"c-songshu-049-liuzhong"}],"relations":[],"title_holdings":[{"id":"th-songshu-049-liuzhong-2-270","title":"魯郡太守","kind":"office","mode":"attestation","person_id":"u9h_hyh_02s","attestations":[{"id":"th-songshu-049-liuzhong-2-270:a","paragraph_id":"c-songshu-049-liuzhong:p002","start":270,"end":274,"surface":"魯郡太守","person_mention_id":"c-songshu-049-liuzhong:p002:m0274","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-049","chapter_id":"c-songshu-049-liuzhong","source_id":"s-songshu-049-liuzhong-ws2118585","paragraph_id":"c-songshu-049-liuzhong:p002","quote":"義旗將建，高祖版鍾為郡主簿。明日，從入京城。將向京邑，高祖命曰：「預是彭沛鄉人赴義者，並可依劉主簿。」於是立為義隊，恒在左右，連戰皆捷。明日，桓謙屯于東陵，卞範之屯覆舟山西，高祖疑賊有伏兵，顧視左右，正見鍾，謂之曰：「此山下當有伏兵，卿可率部下稍往撲之。」鍾應聲馳進，果有伏兵數百，一時奔走。桓玄西奔，其夕，高祖止桓謙故營，遣鍾宿據東府，轉鎮軍參軍督護。桓歆寇歷陽，遣鍾助豫州刺史魏詠之討之，歆即奔迸。除南齊國內史，封安丘縣五等侯。自陳情事，改葬父祖及親屬十喪，高祖厚加資給。轉車騎長史，兼行參軍。司馬叔璠與彭城劉謐、劉懷玉等自蕃城攻鄒山，魯郡太守徐邕失守，鍾率軍討平之。","person_mention_id":"c-songshu-049-liuzhong:p002:m0274"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-songshu-049-liuzhong:p002","text":"義旗將建，高祖版鍾為郡主簿。明日，從入京城。將向京邑，高祖命曰：「預是彭沛鄉人赴義者，並可依劉主簿。」於是立為義隊，恒在左右，連戰皆捷。明日，桓謙屯于東陵，卞範之屯覆舟山西，高祖疑賊有伏兵，顧視左右，正見鍾，謂之曰：「此山下當有伏兵，卿可率部下稍往撲之。」鍾應聲馳進，果有伏兵數百，一時奔走。桓玄西奔，其夕，高祖止桓謙故營，遣鍾宿據東府，轉鎮軍參軍督護。桓歆寇歷陽，遣鍾助豫州刺史魏詠之討之，歆即奔迸。除南齊國內史，封安丘縣五等侯。自陳情事，改葬父祖及親屬十喪，高祖厚加資給。轉車騎長史，兼行參軍。司馬叔璠與彭城劉謐、劉懷玉等自蕃城攻鄒山，魯郡太守徐邕失守，鍾率軍討平之。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":30,"last_line":30,"raw_start":1878,"raw_end":2198,"raw_character_offsets":[1878,1879,1880,1881,1882,1883,1884,1885,1886,1887,1888,1889,1890,1891,1892,1893,1894,1895,1896,1897,1898,1899,1900,1901,1902,1903,1904,1905,1906,1907,1908,1909,1910,1911,1912,1913,1914,1915,1916,1917,1918,1919,1920,1921,1922,1923,1924,1925,1926,1927,1928,1929,1930,1931,1932,1933,1934,1935,1936,1937,1938,1939,1940,1941,1942,1943,1944,1945,1946,1947,1948,1949,1950,1951,1952,1953,1954,1955,1956,1957,1958,1959,1960,1961,1962,1963,1964,1965,1966,1967,1968,1969,1970,1971,1972,1973,1974,1975,1976,1977,1978,1979,1980,1981,1982,1983,1984,1985,1986,1987,1988,1989,1990,1991,1992,1993,1994,1995,1996,1997,1998,1999,2000,2001,2002,2003,2004,2005,2006,2007,2008,2009,2010,2011,2012,2013,2014,2015,2016,2017,2018,2019,2020,2021,2022,2023,2024,2025,2026,2027,2028,2029,2030,2031,2032,2033,2034,2035,2036,2037,2038,2039,2040,2041,2042,2043,2044,2045,2046,2047,2048,2049,2050,2051,2052,2053,2054,2055,2056,2057,2058,2059,2060,2061,2062,2063,2064,2065,2066,2067,2068,2069,2070,2071,2072,2073,2074,2075,2076,2077,2078,2079,2080,2081,2082,2083,2084,2085,2086,2087,2088,2089,2090,2091,2092,2093,2094,2095,2096,2097,2098,2099,2100,2101,2102,2103,2104,2105,2106,2107,2108,2109,2110,2111,2112,2113,2114,2115,2116,2117,2118,2119,2120,2121,2156,2157,2158,2159,2160,2161,2162,2163,2164,2165,2166,2167,2168,2169,2170,2171,2172,2173,2174,2175,2176,2177,2178,2179,2180,2181,2182,2183,2184,2185,2186,2187,2188,2189,2190,2191,2192,2193,2194,2195,2196,2197],"revision_id":2118585},"mentions":[{"id":"c-songshu-049-liuzhong:p002:m0008","start":8,"end":9,"surface":"鍾","kind":"person","person_id":"vcd_ee3_q63","status":"contextual_provisional"},{"id":"c-songshu-049-liuzhong:p002:m0071","start":71,"end":73,"surface":"桓謙","kind":"person","person_id":"u9s_w6j_8mc_AEB","status":"contextual_provisional"},{"id":"c-s