23-wangjian:p015:m0037","person_id":"7r6_k52_qji_ABAAAAEAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段實名及敘述視點。","start":37,"end":38,"surface":"儉"},{"id":"c-nanqishu-023-wangjian:p015:m0043","person_id":"jyx_72x_8t2","kind":"person","status":"contextual_provisional","interpretation_note":"依本段實名及敘述視點。","start":43,"end":45,"surface":"褚淵"},{"id":"c-nanqishu-023-wangjian:p015:m0050","person_id":"77h_id3_a0i_AA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段實名及敘述視點。","start":50,"end":52,"surface":"陸澄"},{"id":"c-nanqishu-023-wangjian:p015:m0061","person_id":"7r6_k52_qji_ABAAAAEAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段實名及敘述視點。","start":61,"end":62,"surface":"儉"},{"id":"c-nanqishu-023-wangjian:p015:m0078","person_id":"7r6_k52_qji_ABAAAAEAB","kind":"person","status":"contextual_provisional","interpretation_note":"依本段實名及敘述視點。","start":78,"end":79,"surface":"遜"}],"source_position":{"revision_id":1545488,"first_line":91,"last_line":91,"raw_start":7091,"raw_end":7183,"line_start":0,"line_end":92,"source_layer":"received_biography"},"chapter_id":"c-nanqishu-023-wangjian","book_id":"b-nanqishu-023","work_id":"w-nanqishu","source_id":"s-nanqishu-023-wangjian-ws1545488"},{"id":"c-nanshi-019-chaozong:p005","text":"爲人恃才使酒，多所陵忽，在直省常醉。上召見，語及北方事，超宗曰：「虜動來二十年矣，佛出亦無如之何。」以失儀出爲南郡王中軍司馬。人問曰：「承有朝命，定是何府？」超宗怨望，答曰：「不知是司馬，爲是司驢；旣是驢府，政應爲司驢。」爲有司奏，以怨望免，禁錮十年。後司徒褚彥回因送湘州刺史王僧虔，閣道壞，墜水；僕射王儉驚跣下車。超宗拊掌笑曰：「落水三公，墜車僕射。」彥回出水，沾濕狼藉。超宗先在僧虔舫，抗聲曰：「有天道焉，天所不容，地所不受。投畀河伯，河伯不受。」彥回大怒曰：「寒士不遜。」超宗曰：「不能賣袁、劉得富貴，焉免寒士。」前後言誚，稍布朝野。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"start":28,"end":30,"surface":"超宗","id":"c-nanshi-019-chaozong:p005:m0028","person_id":"aa6_83c_juy_CDAABA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作超宗。"},{"start":33,"end":34,"surface":"虜","id":"c-nanshi-019-chaozong:p005:u0033","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"北方外敵，非指某一君主。"},{"start":41,"end":42,"surface":"佛","id":"c-nanshi-019-chaozong:p005:u0041","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"譬言佛出亦無可奈何。"},{"start":63,"end":64,"surface":"人","id":"c-nanshi-019-chaozong:p005:u0063","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"問朝命者姓名未載。"},{"start":79,"end":81,"surface":"超宗","id":"c-nanshi-019-chaozong:p005:m0079","person_id":"aa6_83c_juy_CDAABA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作超宗。"},{"start":112,"end":114,"surface":"有司","id":"c-nanshi-019-chaozong:p005:u0112","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"劾奏超宗者。"},{"start":129,"end":132,"surface":"褚彥回","id":"c-nanshi-019-chaozong:p005:m0129","person_id":"jyx_72x_8t2","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作褚淵。"},{"start":138,"end":141,"surface":"王僧虔","id":"c-nanshi-019-chaozong:p005:m0138","person_id":"7r6_k52_qji_ABAAAAEB","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作王僧虔。"},{"start":151,"end":153,"surface":"王儉","id":"c-nanshi-019-chaozong:p005:m0151","person_id":"7r6_k52_qji_ABAAAAEAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作王儉。"},{"start":158,"end":160,"surface":"超宗","id":"c-nanshi-019-chaozong:p005:m0158","person_id":"aa6_83c_juy_CDAABA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作超宗。"},{"start":177,"end":179,"surface":"彥回","id":"c-nanshi-019-chaozong:p005:m0177","person_id":"jyx_72x_8t2","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作褚淵。"},{"start":187,"end":189,"surface":"超宗","id":"c-nanshi-019-chaozong:p005:m0187","person_id":"aa6_83c_juy_CDAABA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作超宗。"},{"start":191,"end":193,"surface":"僧虔","id":"c-nan