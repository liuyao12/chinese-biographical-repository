l"},{"id":"c-nanshi-016-wangzhan-xuanmo:p001:m0134","start":134,"end":135,"surface":"楷","kind":"person","person_id":"q7m_r8k_2vn_C","status":"contextual_provisional"},{"id":"c-nanshi-016-wangzhan-xuanmo:p001:m0139","start":139,"end":142,"surface":"殷道矜","kind":"person","person_id":"gtj_19g_u2l","status":"contextual_provisional"},{"id":"c-nanshi-016-wangzhan-xuanmo:p001:m0143","start":143,"end":144,"surface":"瞻","kind":"person","person_id":"31b_fd1_f77_C","status":"contextual_provisional"},{"id":"c-nanshi-016-wangzhan-xuanmo:p001:m0161","start":161,"end":162,"surface":"嶷","kind":"person","person_id":"ijh_3fs_6u2","status":"contextual_provisional"},{"id":"c-nanshi-016-wangzhan-xuanmo:p001:m0164","start":164,"end":166,"surface":"阿玉","kind":"person","person_id":"ijh_3fs_6u2","status":"contextual_provisional"},{"id":"c-nanshi-016-wangzhan-xuanmo:p001:m0183","start":183,"end":184,"surface":"瞻","kind":"person","person_id":"31b_fd1_f77_C","status":"contextual_provisional"}],"chapter_id":"c-nanshi-016-wangzhan-xuanmo","book_id":"b-nanshi-016","work_id":"w-nanshi","source_id":"s-nanshi-016-wangzhan-xuanmo-ws1963381"},{"id":"c-nanshi-019-chaozong:p005","text":"爲人恃才使酒，多所陵忽，在直省常醉。上召見，語及北方事，超宗曰：「虜動來二十年矣，佛出亦無如之何。」以失儀出爲南郡王中軍司馬。人問曰：「承有朝命，定是何府？」超宗怨望，答曰：「不知是司馬，爲是司驢；旣是驢府，政應爲司驢。」爲有司奏，以怨望免，禁錮十年。後司徒褚彥回因送湘州刺史王僧虔，閣道壞，墜水；僕射王儉驚跣下車。超宗拊掌笑曰：「落水三公，墜車僕射。」彥回出水，沾濕狼藉。超宗先在僧虔舫，抗聲曰：「有天道焉，天所不容，地所不受。投畀河伯，河伯不受。」彥回大怒曰：「寒士不遜。」超宗曰：「不能賣袁、劉得富貴，焉免寒士。」前後言誚，稍布朝野。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"start":28,"end":30,"surface":"超宗","id":"c-nanshi-019-chaozong:p005:m0028","person_id":"aa6_83c_juy_CDAABA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作超宗。"},{"start":33,"end":34,"surface":"虜","id":"c-nanshi-019-chaozong:p005:u0033","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"北方外敵，非指某一君主。"},{"start":41,"end":42,"surface":"佛","id":"c-nanshi-019-chaozong:p005:u0041","kind":"unresolved","person_id":null,"s