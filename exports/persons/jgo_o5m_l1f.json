angci:p003:m0002","person_id":"jgo_o5m_l1f","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作秉。","paragraph_id":"c-nanshi-022-wangci:p003","chapter_id":"c-nanshi-022-wangci"},{"id":"c-nanshi-022-wangjian:p014:m0014","person_id":"jgo_o5m_l1f","start":14,"end":17,"surface":"劉彥節","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。","paragraph_id":"c-nanshi-022-wangjian:p014","chapter_id":"c-nanshi-022-wangjian"}],"relations":[{"id":"a-nanshi022-wangci-130-5-2","subject_person_id":"jgo_o5m_l1f_A","object_person_id":"jgo_o5m_l1f","predicate":"father","status":"source_attested","qualifiers":{"source_term":"女","lineage":"paternal","reading_basis":{"kind":"nanshi022_wangci_family_roles","source_quote":"慈妻劉彥節女","start":0,"end":6,"subject_anchor_id":"c-nanshi-022-wangci:p003:r0005","object_anchor_id":"c-nanshi-022-wangci:p003:m0002"}},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-022","chapter_id":"c-nanshi-022-wangci","source_id":"s-nanshi-022-wangci-ws1477957","paragraph_id":"c-nanshi-022-wangci:p003","quote":"慈妻劉彥節女，子觀尚武帝長女吳縣公主，修婦禮，姑未嘗交答。江夏王鋒為南徐州，王妃，慈女也，以慈為東海太守，行南徐州府州事。還為冠軍將軍、廬陵王中軍長史，未拜，永明九年卒。贈太常，諡懿。子泰。"}],"interpretation_note":"同句親屬與婚配當事人，姓名及稱謂各按所在字位。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"title_holdings":[],"address_assertions":[],"person_references":[{"id":"c-nanshi-016-wangzhan-xuanmo:p001:r0043","paragraph_id":"c-nanshi-016-wangzhan-xuanmo:p001","start":43,"end":45,"surface":"君侯","person_id":"jgo_o5m_l1f","referent_role":"addressee","quote":"寬弟瞻字明遠，一字叔鸞。負氣傲俗，好貶裁人物。仕宋爲王府參軍。嘗詣劉彦節，直登榻曰：「君侯是公孫，僕是公子，引滿促膝，唯餘二人。」彦節外跡雖酬之，意甚不悅。齊豫章王嶷少時，早與瞻友。瞻常候嶷髙論，齊武帝時在大床寢，瞻謂嶷曰：「帳中人物亦復隨人寢興。」嶷言次忽問王景文兄楷賢愚何如殷道矜，瞻曰：「卿遂復言他人兄邪。」武帝笑稱嶷小名阿玉，「汝兄愚，那得忽來王參軍此句」。瞻曰：「直恐如卿來談。」武帝銜之，未嘗形色。後暦黃門侍郎。","note":"依本段敘事、稱謂及語者受者定。","chapter_id":"c-nanshi-016-wangzhan-xuanmo","book_id":"b-nanshi-016","work_id":"w-nanshi","source_id":"s-nanshi-016-wangzhan-xuanmo-ws1963381"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-023-wangjian:p015","text":"儉弟遜，昇明中，爲丹陽丞，告劉秉事，不蒙封賞。建元初，爲晉陵太守，有怨言，儉慮爲禍，因褚淵啓聞。中丞陸澄依事舉奏。詔曰：「儉門世載德，竭誠佐命，特降刑書，宥遜以遠。」徙永嘉郡，道伏誅。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-nanqishu-023-wangjian:p015:m0000","person_id":"7r6_k52_qji_ABAAAAEAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段實名及敘述視點。","start":0,"end":1,"surface":"儉"},{"id":"c-nanqishu-023-wangjian:p015:m0002","person_id":"7r6_k52_qji_ABAAAAEAB","kind":"person","status":"contextual_provisional","interpretation_note":"依本段實名及敘述視點。","start":2,"end":3,"surface":"遜"},{"id":"c-nanqishu-023-wangjian:p015:m0014","person_id":"jgo_o5m_l1f","kind":"person","status":"contextual_provisional","interpretation_note":"依本段實名及敘述視點。","start":14,"end":16,"surface":"劉秉"},{"id":"c-nanqishu-023-wangjian:p015:m0037","person_id":"7r6_k52_qji_ABAAAAEAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段實名及敘述視點。","start":37,"end":38,"surface":"儉"},{"id":"c-nanqishu-023-wangjian:p015:m0043","person_id":"jyx_72x_8t2","kind":"person","status":"contextual_provisional","interpretation_note":"依本段實名及敘述視點。","start":43,"end":45,"surface":"褚淵"},{"id":"c-nanqishu-023-wangjian:p015:m0050","person_id":"77h_id3_a0i_AA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段實名及敘述視點。","start":50,"end":52,"surface":"陸澄"},{"id":"c-nanqishu-023-wangjian:p015:m0061","person_id":"7r6_k52_qji_ABAAAAEAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段實名及敘述視點。","start":61,"end":62,"surface":"儉"},{"id":"c-nanqishu-023-wangjian:p015:m0078","person_id":"7r6_k52_qji_ABAAAAEAB","kind":"person","status":"contextual_provisional","interpretation_note":"依本段實名及敘述視點。","start":78,"end":79,"surface":"遜"}],"source_position":{"revision_id":1545488,"first_line":91,"last_line":91,"raw_start":