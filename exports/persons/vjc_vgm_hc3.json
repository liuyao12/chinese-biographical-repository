ntion_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-sanguozhi-048-sun-hao-ws2085142","s-sanguozhi-050-he"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-wu050-he-5","person_id":"vjc_vgm_hc3","event_type":"death","source_term":"擊殺熙","date_expression":null,"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-050","chapter_id":"c-sanguozhi-050-he","source_id":"s-sanguozhi-050-he","paragraph_id":"c-sanguozhi-050-he:line058-pei02-01","quote":"《江表傳》曰：皓以張布女為美人，有寵，皓問曰：「汝父所在？」答曰：「賊以殺之。」皓大怒，棒殺之。後思其顏色，使巧工刻木作美人形象，恆置座側。問左右：「布復有女否？」答曰：「布大女適故衛尉馮朝子純。」即奪純妻入宮，大有寵，拜為左夫人，晝夜與夫人房宴，不聽朝政，使尚方以金作華燧、步搖、假髻以千數。令宮人著以相撲，朝成夕敗，輒出更作，工匠因緣偷盜，府藏為空。會夫人死，皓哀愍思念，葬於苑中，大作塚，使工匠刻柏作木人，內塚中以為兵衛，以金銀珍玩之物送葬，不可稱計。已葬之後，皓治喪於內，半年不出。國人見葬太奢麗，皆謂皓已死，所葬者是也。皓舅子何都顏狀似皓，云都代立。臨海太守奚熙信訛言，舉兵欲還誅都，都叔父植時為備海督，擊殺熙，夷三族，訛言乃息，而人心猶疑。","person_mention_id":"c-sanguozhi-050-he:line058-pei02-01:m0285"}],"interpretation_note":"本來源所記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-sanguozhi-048-sun-hao:p025:m0185","surface":"奚熙","start":185,"end":187,"kind":"person","person_id":"vjc_vgm_hc3","status":"contextual_provisional","paragraph_id":"c-sanguozhi-048-sun-hao:p025","cha