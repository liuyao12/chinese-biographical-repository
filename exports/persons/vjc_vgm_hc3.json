person_mention_id":"c-sanguozhi-050-he:line058-pei02-01:m0285"}],"attestations":[{"id":"t-wu050-he-7:a","paragraph_id":"c-sanguozhi-050-he:line058-pei02-01","person_mention_id":"c-sanguozhi-050-he:line058-pei02-01:m0285","start":280,"end":284,"surface":"臨海太守","usage":"narrative","date_expression":null}],"human_reviewed":false,"reviewer":"Codex（AI 代理）","model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-048-sun-hao:p025","text":"《江表傳》曰：定，汝南人，本孫權給使也，後出補吏。定佞邪僭媚，自表先帝舊人，求還內侍，皓以爲樓下都尉，典知酤糴事，專爲威福。而皓信任，委以衆事。定爲子求少府李勗女，不許。定挾忿譖勗於皓，皓尺口誅之，焚其尸。定又使諸將各上好犬，皆千里遠求，一犬至直數千匹。御犬率具纓，直錢一萬。一犬一兵，養以捕兎供厨。所獲無幾。吳人皆歸罪於定，而皓以爲忠勤，賜爵列侯。　《吳歷》曰：中書郎奚熙譖宛陵令賀惠。惠，劭弟也。遣使者徐粲訊治，熙又譖粲顧護不即決斷。皓遣使就宛陵斬粲，收惠付獄。會赦得免。","text_layer":"witness_appended_pei_songzhi_note","annotation_status":"reviewed","source_position":{"first_line":72,"last_line":72,"raw_start":12189,"raw_end":12431,"raw_character_offsets":[12189,12192,12193,12194,12197,12198,12199,12200,12201,12202,12203,12204,12205,12206,12207,12208,12209,12210,12211,12212,12213,12214,12215,12216,12217,12218,12219,12220,12221,12222,12223,12224,12225,12226,12227,12228,12229,12230,12231,12232,12233,12234,12235,12236,12237,12238,12239,12240,12241,12242,12243,12244,12245,12246,12247,12248,12249,12250,12251,12252,12253,12254,12255,12256,12257,12258,12259,12260,12261,12262,12263,12264,12265,12266,12267,12268,12269,12270,12271,12272,12273,12274,12275,12276,12277,12278,12279,12280,12281,12282,12283,12284,12285,12286,12287,12288,12289,12290,12291,12292,12293,12294,12295,12296,12297,12298,12299,12300,12301,12302,12303,12304,12305,12306,12307,12308,12309,12310,12311,12312,12313,12314,12315,12316,12317,12318,12319,12320,12321,12322,12323,12324,12325,12326,12327,12328,12329,12330,12331,12332,12333,12334,12335,12336,12337,12338,12339,12340,12341,12342,12343,12344,12345,12346,12347,12348,12349,12350,12351,