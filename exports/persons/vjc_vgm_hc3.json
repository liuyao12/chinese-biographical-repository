22,12623,12624,12625,12626,12627,12628,12629,12630,12631,12632,12633,12634,12635,12636,12637,12638,12639,12640,12974,12975,12976,12977,12978,12979,12980,12981,12982,12983,12984,12985,12986,12987,12988,12989,12990,12991,12992,12993,12994,12995,12996,12997,12998,12999,13000,13001,13002,13003,13004,13005,13006,13007,13008,13009,13010,13011,13012,13013,13014,13015,13016,13017,13018,13019,13020,13021,13022,13023,13024,13025,13026,13027,13028,13029,13030,13031,13032,13033,13034,13035,13036,13037,13038,13039,13040,13041,13042,13043,13044,13045,13046,13047,13048,13049,13050,13051,13052,13053,13054,13055],"revision_id":2085142},"mentions":[{"id":"c-sanguozhi-048-sun-hao:p027:m0020","surface":"奚熙","start":20,"end":22,"kind":"person","person_id":"vjc_vgm_hc3","status":"contextual_provisional"},{"id":"c-sanguozhi-048-sun-hao:p027:m0027","surface":"郭誕","start":27,"end":29,"kind":"person","person_id":"ysv_lf4_srp","status":"contextual_provisional"},{"id":"c-sanguozhi-048-sun-hao:p027:m0058","surface":"何植","start":58,"end":60,"kind":"person","person_id":"382_7fc_57a","status":"contextual_provisional"}],"chapter_id":"c-sanguozhi-048-sun-hao","book_id":"b-sanguozhi-048","work_id":"w-sanguozhi","source_id":"s-sanguozhi-048-sun-hao-ws2085142"},{"id":"c-sanguozhi-050-he:line058-pei02-01","text":"《江表傳》曰：皓以張布女為美人，有寵，皓問曰：「汝父所在？」答曰：「賊以殺之。」皓大怒，棒殺之。後思其顏色，使巧工刻木作美人形象，恆置座側。問左右：「布復有女否？」答曰：「布大女適故衛尉馮朝子純。」即奪純妻入宮，大有寵，拜為左夫人，晝夜與夫人房宴，不聽朝政，使尚方以金作華燧、步搖、假髻以千數。令宮人著以相撲，朝成夕敗，輒出更作，工匠因緣偷盜，府藏為空。會夫人死，皓哀愍思念，葬於苑中，大作塚，使工匠刻柏作木人，內塚中以為兵衛，以金銀珍玩之物送葬，不可稱計。已葬之後，皓治喪於內，半年不出。國人見葬太奢麗，皆謂皓已死，所葬者是也。皓舅子何都顏狀似皓，云都代立。臨海太守奚熙信訛言，舉兵欲還誅都，都叔父植時為備海督，擊殺熙，夷三族，訛言乃息，而人心猶疑。","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-050-he:line058-pei02-01:m0007","start":7,"end":8,"surface":"皓","kind":"person","person_id":"05e_9bb_55a","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-he:line058-pei02-01:m0010","start":10,"end":11,"surface":"布","kind":"person","person_id":"vzp_x