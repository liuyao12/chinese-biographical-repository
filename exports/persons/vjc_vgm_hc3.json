,4364,4365,4366,4367,4368,4369,4370,4371,4372,4373,4374,4375,4376,4377]},"attribution":{"annotator":"裴松之","attribution_kind":"quoted_work","source_label":"江表傳","attribution_marker":"《江表傳》曰：","quoted_work":"江表傳"},"attachment":{"received_paragraph_id":"c-sanguozhi-050-he:line058","received_codepoint":268,"note_ordinal":2,"source_ordinal":1},"chapter_id":"c-sanguozhi-050-he","book_id":"b-sanguozhi-050","work_id":"w-sanguozhi","source_id":"s-sanguozhi-050-he"},{"id":"c-sanguozhi-061-lukai:line042","text":"　　建衡元年，疾病。皓遣中書令董朝問所欲言，凱陳：“何定不可任用，宣授外任，不宜委以國事。奚熙小吏，建起浦裡田，欲復嚴密故跡，亦不可聽。姚信、樓玄、賀劭、張悌、郭逴、薛瑩、滕脩及族弟喜，抗，或清白忠勤，或姿才卓茂，皆社稷之楨干，國家之良輔。願陛下重留神思，訪以時務，各盡其忠，拾遺萬一。”遂卒，時年七十二。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-061-lukai:line042:m0010","start":10,"end":11,"surface":"皓","kind":"person","person_id":"05e_9bb_55a","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line042:m0015","start":15,"end":17,"surface":"董朝","kind":"person","person_id":"hj9_ig8_998","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line042:m0022","start":22,"end":23,"surface":"凱","kind":"person","person_id":"61q_ogq_ueq","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line042:m0026","start":26,"end":28,"surface":"何定","kind":"person","person_id":"h6n_ozv_ytl","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line042:m0045","start":45,"end":47,"surface":"奚熙","kind":"person","person_id":"vjc_vgm_hc3","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line042:m0068","start":68,"end":70,"surface":"姚信","kind":"person","person_id":"evj_3wb_3l3","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line042:m0071","start":71,"end":73,"surface":"樓玄","kind":"person","person_id":"30b_08l_rxm","status":"context