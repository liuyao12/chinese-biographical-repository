{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p002287","identity_policy":"contextual_provisional","person_ids":["cbr-p002287"],"persons":[{"id":"cbr-p002287","label":"替代嬰兒（趙世家未名者）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"兒","mention_ids":["c-shiji-043-zhao:m016-0348"]},{"surface":"孤兒","mention_ids":["c-shiji-043-zhao:m016-0387"]},{"surface":"他人嬰兒","mention_ids":["c-shiji-043-zhao:m016-0228"]}],"evidence":[{"mention_id":"c-shiji-043-zhao:m016-0348","chapter_id":"c-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p016","quote":"兒"},{"mention_id":"c-shiji-043-zhao:m016-0387","chapter_id":"c-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p016","quote":"孤兒"},{"mention_id":"c-shiji-043-zhao:m016-0228","chapter_id":"c-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p016","quote":"他人嬰兒"}]}],"source_mention_summary":[{"source_id":"s-shiji-043-zhao","work_id":"w-shiji","book_id":"b-shiji-043","chapter_id":"c-shiji-043-zhao","mention_count":3,"mention_ids":["c-shiji-043-zhao:m016-0228","c-shiji-043-zhao:m016-0348","c-shiji-043-zhao:m016-0387"],"paragraph_ids":["c-shiji-043-zhao:p016"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-043-zhao"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-043-zhao:m016-0228","start":228,"end":232,"surface":"他人嬰兒","kind":"person","person_id":"cbr-p002287","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p016","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m016-0348","start":348,"end":349,"surface":"兒","kind":"person","person_id":"cbr-p002287","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p016","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m016-0387","start":387,"end":389,"surface":"孤兒","kind":"person","person_id":"cbr-p002287","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p016","chapter_id":"c-shiji-043-zhao"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji043-058","person_id":"cbr-p002287","surfaces":["他人嬰兒","兒","孤兒"],"scope":"same_chapter","chapter_ids":["c-shiji-043-zhao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-043-zhao:p016","quote":"趙朔妻成公姊，有遺腹，走公宮匿。趙朔客曰公孫杵臼，杵臼謂朔友人程嬰曰：「胡不死？」程嬰曰：「朔之婦有遺腹，若幸而男，吾奉之；卽女也，吾徐死耳。」居無何，而朔婦免身，生男。屠岸賈聞之，索於宮中。夫人置兒叱罅祝曰：「趙宗滅乎，若號；卽不滅，若無聲。」及索，兒竟無聲。已脱，程嬰謂公孫杵臼曰：「今一索不得，後必且復索之，柰何？」公孫杵臼曰：「立孤與死孰難？」程嬰曰：「死易，立孤難耳。」公孫杵臼曰：「趙氏先君遇子厚，子彊爲其難者，吾爲其易者，請先死。」乃二人謀取他人嬰兒負之，衣以文葆，匿山中。程嬰出，謬謂諸將軍曰：「嬰不肖，不能立趙孤。誰能與我千金，吾告趙氏孤處。」諸將皆喜，許之，發師隨程嬰攻公孫杵臼。杵臼謬曰：「小人哉程嬰！昔下宮之難不能死，與我謀匿趙氏孤兒，今又賣我。縱不能立，而忍賣之乎！」抱兒呼曰：「天乎天乎！趙氏孤兒何罪？請活之，獨殺杵臼可也。」諸將不許，遂殺杵臼與孤兒。諸將以爲趙氏孤兒良已死，皆喜。然趙氏眞孤乃反在，程嬰卒與倶匿山中。"}],"rationale":"限本篇明示名字、是為與連續事件暫接異稱；真孤與替代兒分開，馬匹、群體與闕代不當個人，不以模型記憶補熟知姓名。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-043-zhao:p016","text":"趙朔妻成公姊，有遺腹，走公宮匿。趙朔客曰公孫杵臼，杵臼謂朔友人程嬰曰：「胡不死？」程嬰曰：「朔之婦有遺腹，若幸而男，吾奉之；卽女也，吾徐死耳。」居無何，而朔婦免身，生男。屠岸賈聞之，索於宮中。夫人置兒叱罅祝曰：「趙宗滅乎，若號；卽不滅，若無聲。」及索，兒竟無聲。已脱，程嬰謂公孫杵臼曰：「今一索不得，後必且復索之，柰何？」公孫杵臼曰：「立孤與死孰難？」程嬰曰：「死易，立孤難耳。」公孫杵臼曰：「趙氏先君遇子厚，子彊爲其難者，吾爲其易者，請先死。」乃二人謀取他人嬰兒負之，衣以文葆，匿山中。程嬰出，謬謂諸將軍曰：「嬰不肖，不能立趙孤。誰能與我千金，吾告趙氏孤處。」諸將皆喜，許之，發師隨程嬰攻公孫杵臼。杵臼謬曰：「小人哉程嬰！昔下宮之難不能死，與我謀匿趙氏孤兒，今又賣我。縱不能立，而忍賣之乎！」抱兒呼曰：「天乎天乎！趙氏孤兒何罪？請活之，獨殺杵臼可也。」諸將不許，遂殺杵臼與孤兒。諸將以爲趙氏孤兒良已死，皆喜。然趙氏眞孤乃反在，程嬰卒與倶匿山中。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-043-zhao:m016-0000","start":0,"end":2,"surface":"趙朔","kind":"person","person_id":"cbr-p002270","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m016-0002","start":2,"end":3,"surface":"妻","kind":"person","person_id":"cbr-p002272","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m016-0003","start":3,"end":5,"surface":"成公","kind":"person","person_id":"cbr-p002268","status":"contextual_