henshu-007-liujingyan:p002:m0029","object_person_reference_id":"c-chenshu-007-liujingyan:p002:r0019","relationship_anchor":{"paragraph_id":"c-chenshu-007-liujingyan:p002","surface":"先娶吳興錢氏","start":25,"end":31}}],"status":"source_attested","interpretation_note":"陳宣帝先娶錢氏。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"a-nan012-liujingyan-d-xian","subject_person_id":"icd_mkz_d9n_C","object_person_id":"b13_njz_24q","predicate":"mother","qualifiers":{"source_term":"錢貴妃生","nan012_liujingyan_reading":"d-xian"},"evidence":[{"work_id":"w-chenshu","book_id":"b-chenshu-028","source_id":"s-chenshu-028-liujingyan-children-ws2581394","chapter_id":"c-chenshu-028-liujingyan-children","paragraph_id":"c-chenshu-028-liujingyan-children:p002","quote":"錢貴妃生河東王叔獻","subject_person_mention_id":"c-chenshu-028-liujingyan-children:p002:m0007","object_person_mention_id":"c-chenshu-028-liujingyan-children:p002:m0000","relationship_anchor":{"paragraph_id":"c-chenshu-028-liujingyan-children:p002","surface":"錢貴妃生","start":0,"end":4}}],"status":"source_attested","interpretation_note":"錢貴妃生河東王叔獻。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"a-nan012-liujingyan-m-qian-wife","subject_person_id":"b13_njz_24q","object_person_id":"icd_mkz_d9n","predicate":"spouse","qualifiers":{"source_term":"先娶吳興錢氏","nan012_liujingyan_reading":"m-qian-wife"},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-012","source_id":"s-nanshi-012-liujingyan-ws2060595","chapter_id":"c-nanshi-012-liujingyan","paragraph_id":"c-nanshi-012-liujingyan:p002","quote":"初，宣帝居鄉里，先娶吳興錢氏，及即位，拜貴妃，甚有寵。后傾心下之，每尚方供奉物，其上者皆推于貴妃，而己御其次焉。宣帝崩，始興王叔陵為亂，後主賴后與吳媼救而獲免。後主即位，尊后為皇太后，宮曰弘範。是時新失淮南地，隋師臨江，又國遭大喪，後主患創不能聽政。其誅叔陵，供大行喪事，邊境防守及百司眾務，雖假後主之敕，實皆決之於后。後主創愈，乃歸政焉。后性謙謹，未嘗以宗族為請，雖衣食亦無所分遺。陳亡，入長安。隋大業十二年，薨於東都，年八十三。葬於洛陽之芒山。","subject_person_mention_id":"c-nanshi-012-liujingyan:p002:m0012","object_person_reference_id":"c-nanshi-012-liujingyan:p002:r0002","relationship_anchor":{"paragraph_id":"c-nanshi-012-liujingyan:p002","surface":"先娶吳興錢氏","start":8,"end":14}}],"status":"source_attested","interpretation_note":"陳宣帝先娶錢氏。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-chenshu-007-liujingyan:p002:m0029","surface":"錢氏","start":29,"end":31,"person_id":"b13_njz_24q","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-chenshu-007-liujingyan:p002","chapter_id":"c-chenshu-007-liujingyan"},{"id":"c-chenshu-028-liujingyan-children:p002:m0000","surface":"錢貴妃","start":0,"end":3,"person_id":"b13_njz_24q","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-chenshu-028-liujingyan-children:p002","chapter_id":"c-chenshu-028-liujingyan-children"},{"id":"c-nanshi-012-liujingyan:p002:m0012","surface":"錢氏","start":12,"end":14,"person_id":"b13_njz_24q","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-nanshi-012-liujingyan:p002","chapter_id":"c-nanshi-012-liujingyan"}],"relations":[{"id":"a-nan012-liujingyan-c-qian-wife","subject_person_id":"b13_njz_24q","object_person_id":"icd_mkz_d9n","predicate":"spouse","qualifiers":{"source_term":"先娶吳興錢氏","nan012_liujingyan_reading":"c-qian-wife"},"evidence":[{"work_id":"w-chenshu","book_id":"b-chenshu-007","source_id":"s-chenshu-007-liujingyan-ws2015446","chapter_id":"c-chenshu-007-liujingyan","paragraph_id":"c-chenshu-007-liujingyan:p002","quote":"后美姿容，身長七尺二寸，手垂過膝。初，高宗居鄉里，先娶吳興錢氏女，及即位，拜為貴妃，甚有寵，后傾心下之。每尚方供奉之物，其上者皆推於貴妃，而己御其次焉。高宗崩，始興王叔陵為亂，後主賴后與樂安君吳氏救而獲免，事在叔陵傳。後主即位，尊后為皇太后，宮曰弘範。當是之時，新失淮南之地，隋師臨江，又國遭大喪，後主病瘡不能聽政，其誅叔陵、供大行喪事、邊境防守及百司红務，雖假以後主之命，實皆決之於后。後主瘡愈，乃歸政焉。陳亡入長安，大業十一年薨於東都，年八十三，葬洛陽之邙山。","subject_person_mention_id":"c-chenshu-007-liujingyan:p002:m0029","object_person_reference_id":"c-chenshu-007-liujingyan:p002: