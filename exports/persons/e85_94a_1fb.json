ons_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-073-yuliang:line069:m0033","start":33,"end":35,"surface":"樊峻","kind":"person","person_id":"e85_94a_1fb","status":"resolved","paragraph_id":"c-jinshu-073-yuliang:line069","chapter_id":"c-jinshu-073-yuliang"}],"relations":[],"title_holdings":[{"id":"th-yu4-069-29-e85_94a_1fb","person_id":"e85_94a_1fb","title":"西陽太守","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-073","source_id":"s-jinshu-073-yuliang","chapter_id":"c-jinshu-073-yuliang","paragraph_id":"c-jinshu-073-yuliang:line069","person_mention_id":"c-jinshu-073-yuliang:line069:m0033","quote_passage_ref":"data/corpus/jinshu/073-yuliang.json"}],"attestations":[{"id":"th-yu4-069-29-e85_94a_1fb:a1","paragraph_id":"c-jinshu-073-yuliang:line069","start":29,"end":33,"surface":"西陽太守","person_mention_id":"c-jinshu-073-yuliang:line069:m0033","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"原稱、授任及用稱分錄；任命不等於已到任；缺年月、同母及生年不補，不以死亡一律截止職爵。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[{"id":"pa-yu4-69-42-e85_94a_1fb-service_location","person_id":"e85_94a_1fb","relation":"service_location","place":{"source_name":"邾城","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"source_term":"時石勒新死，亮有開復中原之謀，乃解豫州授輔國將軍毛寶，使與西陽太守樊峻精兵一萬，俱戍邾城。又以陶稱為南中郎將、江夏相，率部曲五千人入沔中。亮弟翼為南蠻校尉、南郡太守，鎮江陵。以武昌太守陳囂為輔國將軍、梁州刺史，趣子午。又遣偏軍伐蜀，至江陽，執偽荊州刺史李閎、巴郡太守黃植，送於京都。亮當率大眾十萬，據石城，為諸軍聲援，乃上疏曰：「蜀胡二寇凶虐滋甚，內相誅鋤，眾叛親離。蜀甚弱而胡尚強，並佃並守，修進取之備。襄陽北接宛許，南阻漢水，其險足固，其土足食。臣宜移鎮襄陽之石城下，並遣諸軍羅布江沔。比及數年，戎士習練，乘釁齊進，以臨河洛。大勢一舉，眾知存亡，開反善之路，宥逼協之罪，因天時，順人情，誅逋逆，雪大恥，實聖朝之所先務也。願陛下許其所陳，濟其此舉。淮泗壽陽所宜進據，臣輒簡練部分。乞槐棘參議，以定經略。」帝下其議。時王導與亮意同，郗鑒議以資用未備，不可大舉。亮又上疏，便欲遷鎮。會寇陷邾城，毛寶赴水而死。亮陳謝，自貶三等，行安西將軍。有詔復位。尋拜司空，餘官如故，固讓不拜。","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-073","source_id":"s-jinshu-073-yuliang","chapter_id":"c-jinshu-073-yuliang","paragraph_id":"c-jinshu-073-yuliang:line069","person_mention_id":"c-jinshu-073-yuliang:line069:m0033","quote_passage_ref":"data/corpus/jinshu/073-yuliang.json"}],"interpretation_note":"來源明俱戍邾城，非僅官稱轄地；不由此猜死亡河川或卒地。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"qualifiers":{"source_position":"西陽太守"}},{"id":"pa-yu4-69-29-e85_94a_1fb-service_location","person_id":"e85_94a_1fb","relation":"service_location","place":{"source_name":"西陽","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"source_term":"西陽太守","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-073","source_id":"s-jinshu-073-yuliang","chapter_id":"c-jinshu-073-yuliang","paragraph_id":"c-jinshu-073-yuliang:line069","person_mention_id":"c-jinshu-073-yuliang:line069:m0033","quote_passage_ref":"data/corpus/jinshu/073-yuliang.json"}],"interpretation_note":"僅來源官稱所帶任事轄地；非到任、居處或籍貫，亦不據此終止其他職位。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"qualifiers":{"source_position":"西陽太守"}}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"sources":[{"chapter_id":"c-jinshu-073-yuliang","work_id":"w-jinshu","book_id":"b-jinshu-073","source_id":"s-jinshu-073-yuliang","source_ref":"corpus/jinshu/073-yuliang.json"}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true},"passage_refs":[{"chapter":"corpus/jinshu/073-yuliang.json","id":"c-jinshu-073-yuliang:line069"}]}
