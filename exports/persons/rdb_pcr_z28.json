_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-nanqishu-059-western-polities-complete:source_review18-0","kind":"source_review","person_id":"rdb_pcr_z28","source_quote":"太祖即位，欲綏懷異俗。建元元年，詔曰：「昔絕國入贄，美稱前冊，殊俗內款，聲流往記。偽虜茄蘆鎮主、陰平郡公楊廣香，怨結同族，舋起親黨，當宋之世，遂舉地降敵。茄蘆失守，華陽暫驚。近單使先馳，宣揚皇威，廣香等追其遠世之誠，仰〔我〕惟新之化，肉袒請附，復地千里，氐羌雜種，咸同歸從。宜時領納，厚加優卹。廣香翻迷反正，可特量所授。部曲酋豪，隨名酬賞。」以廣香為督沙州諸軍事、平羌校尉、沙州刺史。尋進號征虜將軍。","reading":"楊廣香歸齊及建元元年優詔自成。其後督沙州、平羌、進號各有句位。","note":"楊廣香歸齊及建元元年優詔自成。其後督沙州、平羌、進號各有句位。","paragraph_id":"c-nanqishu-059-western-polities-complete:p018","start_codepoint":0,"end_codepoint":200,"human_reviewed":false,"chapter_id":"c-nanqishu-059-western-polities-complete","source_id":"s-nanqishu-059-western-polities-complete-ws1748911"},{"id":"c-nanqishu-059-western-polities-complete:variant_review18-132","kind":"variant_review","person_id":"rdb_pcr_z28","source_quote":"咸同歸從","reading":"固定本從字，武英殿本順。屬詔書本文，原注釋避梁諱。","note":"固定本從字，武英殿本順。屬詔書本文，原注釋避梁諱。","paragraph_id":"c-nanqishu-059-western-polities-complete:p018","start_codepoint":132,"end_codepoint":136,"human_reviewed":false,"chapter_id":"c-nanqishu-059-western-polities-complete","source_id":"s-nanqishu-059-western-polities-complete-ws1748911"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-qi059-yangjiong-father","subject_person_id":"sl2_clv_v9l","object_person_id":"rdb_pcr_z28","predicate":"father","qualifiers":{"source_term":"廣香子北部鎮將軍郡事炅"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-059","chapter_id":"c-nanqishu-059-western-polities-complete","source_id":"s-nanqishu-059-western-polities-complete-ws1748911","paragraph_id":"c-nanqishu-059-western-polities-complete:p022","quote":"使道寶步出魏興，分軍泝墊江，俱會晉壽。太祖以文弘背叛，進廣香為持節、都督西秦州刺史。廣香子北部鎮將軍郡事炅為征虜將軍、武都太守。以難當正胤楊後起為持節、寧朔將軍、平羌校尉、北秦州刺史、武都王，鎮武興，即文弘從兄子也。","subject_person_mention_id":"c-nanqishu-059-western-polities-complete:p022:m0052","object_person_mention_id":"c-nanqishu-059-western-polities-complete:p022:m0028"}],"status":"source_attested","interpretation_note":"炅為武都太守。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-qi059-yang-guangxiang-death","person_id":"rdb_pcr_z28","event_type":"death","source_term":"病死","source_anchor":{"paragraph_id":"c-nanqishu-059-western-polities-complete:p023","start":26,"end":28,"surface":"病死"},"date_expression":null,"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-059","chapter_id":"c-nanqishu-059-western-polities-complete","source_id":"s-nanqishu-059-western-polities-complete-ws1748911","paragraph_id":"c-nanqishu-059-western-polities-complete:p023","quote":"三年，文弘歸降，復以為征西將軍、北秦州刺史。先是廣香病死，氐眾半奔文弘，半詣梁州刺史崔慧景。文弘遣從子後起進據白水。白水居晉壽上流，西接涪界，東帶益路，北連陰平、茄蘆，為形勝之地。晉壽太守楊公則啟經略之宜，上答曰：「文弘罪不可恕，事中政應且加恩耳。卿若能襲破白水，必加厚賞。」","person_mention_id":"c-nanqishu-059-western-polities-complete:p023:m0024"}],"status":"source_attested","interpretation_note":"按同段人物與次第核所屬卒事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"mentions":[{"id":"c-nanqishu-059-western-polities-complete:p017:m0073","start":73,"end":75,"surface":"廣香","kind":"person","person_id":"rdb_pcr_z28","status":"contextual_provisional","paragraph_id":"c-nanqishu-059-western-polities-complete:p017","chapter_id":"c-nanqishu-059-western-polities-complete"},{"id":"c-nanqishu-059-western-polities-complete:p018:m0052","start":52,"end":55,"surface":"楊廣香","kind":"person","person_id":"rdb_pcr_z28","status":"contextual_provisional","paragraph_id":"c-nanqishu-059-western-polities-complete:p018","chapter_id":"c-nanqishu-059-western-polities-complete"},{"id":"c-nanqishu-059-western-polities-complete:p018:m0098","start":98,"end":100,"surface":"廣香","kind":"person","person_id":"rdb_pcr_z28","status":"contextual_provisional","paragraph_id":"c-nanqishu-059-western-polities-complete:p018","chapter