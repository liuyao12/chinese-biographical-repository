inds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-wu048-yi2-father","subject_person_id":"s8g_w4d_sl2","object_person_id":"984_9e1_5e9_B","predicate":"father","qualifiers":{"source_term":"全緒子禕、儀"},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-048","chapter_id":"c-sanguozhi-048-sun-liang","source_id":"s-sanguozhi-048-sun-liang-ws2085142","paragraph_id":"c-sanguozhi-048-sun-liang:p014","quote":"五月，魏征東大將軍諸葛誕以淮南之衆保壽春城，遣將軍朱成稱臣上疏，又遣子靚、長史吳綱諸牙門子弟爲質。六月，使文欽、唐咨、全端等步騎三萬救誕。朱異自虎林率衆襲夏口，夏口督孫壹奔魏。秋七月，綝率衆救壽春，次于鑊里，朱異至自夏口，綝使異爲前部督，與丁奉等將介士五萬解圍。八月，會稽南部反，殺都尉。鄱陽、新都民爲亂，廷尉丁密、步兵校尉鄭胄、將軍鍾離牧率軍討之。朱異以軍士乏食引還，綝大怒，九月朔己巳，殺異於鑊里。辛未，綝自鑊里還建業。甲申，大赦。十一月，全緒子禕、儀以其母奔魏。十二月，全端、懌等自壽春城詣司馬文王。","subject_person_mention_id":"c-sanguozhi-048-sun-liang:p014:m0227","object_person_mention_id":"c-sanguozhi-048-sun-liang:p014:m0222"}],"status":"source_attested","interpretation_note":"依固定見證同段親屬原詞及所屬敘事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"a-wu048-yi2-mother","subject_person_id":"s8g_w4d_sl2","object_person_id":"hgw_lcm_faj","predicate":"mother","qualifiers":{"source_term":"禕、儀以其母"},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-048","chapter_id":"c-sanguozhi-048-sun-liang","source_id":"s-sanguozhi-048-sun-liang-ws2085142","paragraph_id":"c-sanguozhi-048-sun-liang:p014","quote":"五月，魏征東大將軍諸葛誕以淮南之衆保壽春城，遣將軍朱成稱臣上疏，又遣子靚、長史吳綱諸牙門子弟爲質。六月，使文欽、唐咨、全端等步騎三萬救誕。朱異自虎林率衆襲夏口，夏口督孫壹奔魏。秋七月，綝率衆救壽春，次于鑊里，朱異至自夏口，綝使異爲前部督，與丁奉等將介士五萬解圍。八月，會稽南部反，殺都尉。鄱陽、新都民爲亂，廷尉丁密、步兵校尉鄭胄、將軍鍾離牧率軍討之。朱異以軍士乏食引還，綝大怒，九月朔己巳，殺異於鑊里。辛未，綝自鑊里還建業。甲申，大赦。十一月，全緒子禕、儀以其母奔魏。十二月，全端、懌等自壽春城詣司馬文王。","subject_person_mention_id":"c-sanguozhi-048-sun-liang:p014:m0227","object_person_mention_id":"c-sanguozhi-048-sun-liang:p014:m0229"}],"status":"source_attested","interpretation_note":"依固定見證同段親屬原詞及所屬敘事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"a-wu060-yi-uncle-儀","subject_person_id":"s8g_w4d_sl2","object_person_id":"42v_re3_e0f","predicate":"paternal_uncle","qualifiers":{"source_term":"懌兄子禕、儀、靜","sanguozhi060_family":"yi-uncle-儀"},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-060","chapter_id":"c-sanguozhi-060-quancong","source_id":"s-sanguozhi-060-quancong","paragraph_id":"c-sanguozhi-060-quancong:line042","quote":"　　琮既親重，宗族子弟並蒙寵貴，賜累千金，然猶謙虛接士，貌無驕色。十二年卒，子懌嗣。後襲業領兵，救諸葛誕於壽春，出城先降，魏以為平東將軍，封臨湘侯。懌兄子禕、儀、靜等亦降魏，皆歷郡守列侯。","subject_person_mention_id":"c-sanguozhi-060-quancong:line042:m0079","object_person_mention_id":"c-sanguozhi-060-quancong:line042:m0074"}],"interpretation_note":"按具名兩端和本句明言之親稱定向。未名連接人留缺。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-048-sun-liang:p014:m0227","surface":"儀","start":227,"end":228,"kind":"person","person_id":"s8g_w4d_sl2","status":"contextual_provisional","paragraph_id":"c-sanguozhi-048-sun-liang:p014","chapter_id":"c-sanguozhi-048-sun-liang"},{"id":"c-sanguozhi-050-quan:line050:m0170","start":170,"end":172,"surface":"全儀","kind":"person","person_id":"s8g_w4d_sl2","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-050-quan:line050","chapter_id":"c-sanguozhi-050-quan"},{"id":"c-sanguozhi-060-quancong:line042:m0079","start":79,"end":80,"surface":"儀","kind":"person","person_id":"s8g_w4d_sl2","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-060-quancong:line042","chapter_id":"c-sanguozhi-060-quancong"}],"relations":[{"id":"a-wu048-yi2-father","subject_person_id":"s8g_w4d_sl2","object_person_id":"984_9e1_5e9_B","predicate":"father","qualifiers":{"source_term":"全緒子禕、儀"},"evidence":[{"work_id":"w-sanguozhi","book_i