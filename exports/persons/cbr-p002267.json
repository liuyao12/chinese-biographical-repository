{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p002267","identity_policy":"contextual_provisional","person_ids":["cbr-p002267"],"persons":[{"id":"cbr-p002267","label":"趙穿（趙世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"趙穿","mention_ids":["c-shiji-043-zhao:m013-0081"]}],"evidence":[{"mention_id":"c-shiji-043-zhao:m013-0081","chapter_id":"c-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p013","quote":"趙穿"}]}],"mentions":[{"id":"c-shiji-043-zhao:m013-0081","start":81,"end":83,"surface":"趙穿","kind":"person","person_id":"cbr-p002267","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p013","chapter_id":"c-shiji-043-zhao"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji043-038","person_id":"cbr-p002267","surfaces":["趙穿"],"scope":"same_chapter","chapter_ids":["c-shiji-043-zhao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-043-zhao:p013","quote":"靈公立十四年，益驕。趙盾驟諫，靈公弗聽。及食熊蹯，胹不熟，殺宰人，持其尸出，趙盾見之。靈公由此懼，欲殺盾。盾素仁愛人，嘗所食桑下餓人反捍救盾，盾以得亡。未出境，而趙穿弒靈公而立襄公弟黑臀，是爲成公。趙盾復反，任國政。君子譏盾「爲正卿，亡不出境，反不討賊」，故太史書曰「趙盾弒其君」。晉景公時而趙盾卒，諡爲宣孟，子朔嗣。"}],"rationale":"限本篇明示名字、是為與連續事件暫接異稱；真孤與替代兒分開，馬匹、群體與闕代不當個人，不以模型記憶補熟知姓名。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-043-zhao:p013","text":"靈公立十四年，益驕。趙盾驟諫，靈公弗聽。及食熊蹯，胹不熟，殺宰人，持其尸出，趙盾見之。靈公由此懼，欲殺盾。盾素仁愛人，嘗所食桑下餓人反捍救盾，盾以得亡。未出境，而趙穿弒靈公而立襄公弟黑臀，是爲成公。趙盾復反，任國政。君子譏盾「爲正卿，亡不出境，反不討賊」，故太史書曰「趙盾弒其君」。晉景公時而趙盾卒，諡爲宣孟，子朔嗣。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-043-zhao:m013-0000","start":0,"end":2,"surface":"靈公","kind":"person","person_id":"cbr-p002264","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m013-0010","start":10,"end":12,"surface":"趙盾","kind":"person","person_id":"cbr-p002259","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m013-0015","star