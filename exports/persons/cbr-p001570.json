{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p001570","canonical_person_id":"i8i_rvh_4lp_AAA","id_aliases":["cbr-p001570"],"identity_policy":"contextual_provisional","person_ids":["i8i_rvh_4lp_AAA"],"persons":[{"id":"i8i_rvh_4lp_AA","label":"遫（衛穆公）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"穆公遫","mention_ids":["c-shiji-037-wei:m023-0206"]},{"surface":"穆公","mention_ids":["c-shiji-037-wei:m024-0000","c-shiji-037-wei:m024-0049"]}],"evidence":[{"mention_id":"c-shiji-037-wei:m023-0206","chapter_id":"c-shiji-037-wei","paragraph_id":"c-shiji-037-wei:p023","quote":"穆公遫"},{"mention_id":"c-shiji-037-wei:m024-0000","chapter_id":"c-shiji-037-wei","paragraph_id":"c-shiji-037-wei:p024","quote":"穆公"},{"mention_id":"c-shiji-037-wei:m024-0049","chapter_id":"c-shiji-037-wei","paragraph_id":"c-shiji-037-wei:p024","quote":"穆公"}],"family_path":{"connection":"father","generation_distance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-037-wei","source_id":"s-shiji-037-wei","paragraph_id":"c-shiji-037-wei:p023","quote":"成公三年，晉欲假道於衞救宋，成公不許。晉更從南河度，救宋。徴師於衞，衞大夫欲許，成公不肯。大夫元咺攻成公，成公出奔。晉文公重耳伐衞，分其地予宋，討前過無禮及不救宋患也。衞成公遂出奔陳。二歳，如周求入，與晉文公會。晉使人鴆衞成公，成公私於周主鴆，令薄，得不死。已而周爲請晉文公，卒入之衞，而誅元咺，衞君瑕出奔。七年，晉文公卒。十二年，成公朝晉襄公。十四年，秦穆公卒。二十六年，齊邴歜弒其君懿公。三十五年，成公卒，子穆公遫立。","source_term":"子穆公遫"}],"source_assertion_id":"a-shiji037-044","interpretation_note":"以此受傳正文的明示近親主張配置局部家族；不合併跨篇候選身份、不補闕名世代，不表示遠祖世系已核實。分支字元不是長幼排行。","reviewer":"Codex（AI 代理）","parent_person_id":"i8i_rvh_4lp_A"},"id_aliases":["cbr-p001568"]},{"id":"i8i_rvh_4lp_AAA","label":"臧（衛定公）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"定公臧","mention_ids":["c-shiji-037-wei:m024-0054"]},{"surface":"定公","mention_ids":["c-shiji-037-wei:m024-0059","c-shiji-037-wei:m025-0184"]}],"evidence":[{"mention_id":"c-shiji-037-wei:m024-0054","chapter_id":"c-shiji-037-wei","paragraph_id":"c-shiji-037-wei:p024","quote":"定公臧"},{"mention_id"