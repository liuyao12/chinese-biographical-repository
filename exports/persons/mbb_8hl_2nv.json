preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-liangshu-028-peisui-complete:p004:m0078","start":78,"end":80,"surface":"元康","kind":"person","person_id":"mbb_8hl_2nv","status":"contextual_provisional","paragraph_id":"c-liangshu-028-peisui-complete:p004","chapter_id":"c-liangshu-028-peisui-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-028-peisui-complete:p004","text":"五年，征邵陽洲，魏人爲長橋斷淮以濟。邃築壘逼橋，每戰輒克，於是密作沒突艦。會甚雨，淮水暴溢，邃乘艦徑造橋側，魏衆驚潰，邃乘勝追擊，大破之。進克羊石城，斬城主元康。又破霍丘城，斬城主甯永仁。平小峴，攻合肥。以功封夷陵縣子，邑三百戶。遷冠軍長史、廣陵太守。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":18,"last_line":18,"raw_start":680,"raw_end":806,"raw_character_offsets":[680,681,682,683,684,685,686,687,688,689,690,691,692,693,694,695,696,697,698,699,700,701,702,703,704,705,706,707,708,709,710,711,712,713,714,715,716,717,718,719,720,721,722,723,724,725,726,727,728,729,730,731,732,733,734,735,736,737,738,739,740,741,742,743,744,745,746,747,748,749,750,751,752,753,754,755,756,757,758,759,760,761,762,763,764,765,766,767,768,769,770,771,772,773,774,775,776,777,778,779,780,781,782,783,784,785,786,787,788,789,790,791,792,793,794,795,796,797,798,799,800,801,802,803,804,805],"revision_id":1511902},"mentions":[{"id":"c-liangshu-028-peisui-complete:p004:m0018","start":18,"end":19,"surface":"邃","kind":"person","person_id":"vtp_lo9_0af","status":"contextual_provisional"},{"id":"c-liangshu-028-peisui-complete:p004:m0046","start":46,"end":47,"surface":"邃","kind":"person","person_id":"vtp_lo9_0af","status":"contextual_provisional"},{"id":"c-liangshu-028-peisui-complete:p004:m0059","start":59,"end":60,"surface":"邃","kind":"person","person_id":"vtp_lo9_0af","status":"contextu