m0138","surface":"晞","start":138,"end":139,"person_id":"v5s_1ew_vh0","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p012:m0220","surface":"劉暾","start":220,"end":222,"person_id":"mbq_jhy_9er","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p012:m0227","surface":"溫畿","start":227,"end":229,"person_id":"1nq_ikq_xut","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p012:m0233","surface":"杜育","start":233,"end":235,"person_id":"7eg_jgh_zgj","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p012:m0241","surface":"廣平","start":241,"end":243,"person_id":"de1_i6j_2qu","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p012:m0244","surface":"武安公主","start":244,"end":248,"person_id":"ow9_krl_b4a","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p012:m0281","surface":"王贊","start":281,"end":283,"person_id":"i0y_g49_jd6","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p012:m0284","surface":"陳午","start":284,"end":286,"person_id":"dcs_ymm_847","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-061-gouxi","book_id":"b-jinshu-061","work_id":"w-jinshu","source_id":"s-jinshu-061-gouxi-ws7903772"},{"id":"c-jinshu-061-gouxi:p014","text":"晞以京邑荒饉日甚，寇難交至，表請遷都，遣從事中郎劉會領船數十艘，宿衛五百人，獻穀千斛以迎帝。朝臣多有異同。俄而京師陷，晞與王贊屯倉垣。豫章王端及和鬱等東奔晞，晞群官尊端為皇太子，置行台。端承制以晞領太子太傅、都督中外諸軍、錄尚書，自倉垣徙屯蒙城，贊屯陽夏。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":92,"last_line":92,"raw_start":7219,"raw_end":7349,"raw_character_offsets":[7221,7222,7223,7224,7225,7226,7227,7228,7229,7230,7231,7232,7233,7234,7235,7236,7237,7238,7239,7240,7241,7242,7243,7244,7245,7246,7247,7248,7249,7250,7251,7252,7253,7254,7255,7256,7257,7258,7259,7260,7261,7262,7263,7264,7265,7266,7267,7268,7269,7270,7271,7272,7273,7274,7275,7276,7277,7278,7279,7280,7281,7282,7283,7284,7285,7286,7287,7288,7289,7290,7291,7292,7293,7294,7295,7296,7297,7298,7299,7300,7301,7302,7303,7304,7305,7306,7307,7308,7309,7310,7311,7312,7313,7314,7315,7316,7317,7318,7319,7320,7321,7322,7323,7324,7325,7326,7327,7328,7329,7330,7331,7332,7333,7334,7335,7336,7337,7338,7339,7340,7341,7342,7343,7344,7345,7346,7347,7348],"revision_id":7903772},"mentions":[{"id":"c-jinshu-061-gouxi:p014:m0000","surface":"晞","start":0,"end":1,"person_id":"v5s_1ew_vh0","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p014:m0024","surface":"劉會","start":24,"end":26,"person_id":"qci_q43_th6","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p014:m0059","surface":"晞","start":59,"end":60,"person_id":"v5s_1ew_vh0","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p014:m0061","surface":"王贊","start":61,"end":63,"person_id":"i0y_g49_jd6","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p014:m0067","surface":"豫章王端","start":67,"end":71,"person_id":"7xu_sss_agn","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p014:m0072","surface":"和鬱","start":72,"end":74,"person_id":"cks_kw6_zkz","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p014:m0077","surface":"晞","start":77,"end":78,"person_id":"v5s_1ew_vh0","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p014:m0079","surface":"晞","start":79,"end":80,"person_id":"v5s_1ew_vh0","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p014:m0083","surface":"端","start":83,"end":84,"person_id":"7xu_sss_agn","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p014:m0093","surface":"端","start":93,"end":94,"person_id":"7xu_sss_agn","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p014:m0097","surface":"晞","start":97,"end":98,"person_id":"v5s_1ew_vh0","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p014:m0123","surface":"贊","start":123,"end":124,"person_id":"i0y_g49_jd6","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-061-gouxi","book_id":"b-jinshu-061","work_id":"w-jinshu","source_id":"s-jinshu-061-gouxi-ws7903772"},{"id":"c-jinshu-061-gouxi:p015","text":"晞出於孤微，位至上將，志頗盈滿，奴婢將千人，侍妾數十，終日累夜不出戶庭，刑政苛虐，縱情肆欲。遼西閻亨以書固諫，晞怒，殺之。晞從事中郎明預有疾居家，聞之，乃舉病諫晞曰：「皇晉遭百六之數，當危難之機，明公親稟廟算，將為國家除暴。閻亨美士，奈何無罪一旦殺之！」晞怒白；「我自殺閻亨，何關人事，而舉病來罵我！」左右為之戰慄，預曰：「以明公以禮見進，預欲以禮自盡。今明公怒預，其若遠近怒明公何！昔堯舜之在上也，以和理而興；桀紂之在上也，以惡逆而滅。天子且猶如此，況人臣乎！願明公且置其怒而思預之言。」晞有慚色。由是眾心稍離，莫為致用，加以疾疫饑饉，其將溫畿、傅宣皆叛之。石勒攻陽夏，滅王贊，馳襲蒙城，執晞，署為司馬，月餘乃殺之。晞無子，弟純亦遇害。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":94,"last_line":94,"raw_start":7351,"raw_end":7672,"raw_character_offsets":[7353,7354,7355,7356,7357,7358,7359,7360,7361,7362,7363,7364,7365,7366,7367,7368,7369,7370,7371,7372,7373,7374,7375,7376,7377,7378,7379,7380,7381,7382,7383,7384,7385,7386,7387,7388,7389,7390,7391,7392,7393,7394,7395,7396,7397,7398,7399,7400,7401,7402,7403,7404,7405,7406,7407,7408,7409,7410,7411,7412,7413,7414,7415,7416,7417,7418,7419,7420,7421,7422,7423,7424,7425,7426,7427,7428,7429,7430,7431,7432,7433,7434,7435,7436,7437,7438,7439,7440,7441,7442,7443,7444,7445,7446,7447,7448,7449,7450,7451,7452,7453,7454,7455,7456,7457,7458,7459,7460,7461,7462,7463,7464,7465,7466,7467,7468,7469,7470,7471,7472,7473,7474,7475,7476,7477,7478,7479,7480,7481,7482,7483,7484,7485,7486,7487,7488,7489,7490,7491,7492,7493,7494,7495,7496,7497,7498,7499,7500,7501,7502,7503,7504,7505,7506,7507,7508,7509,7510,7511,7512,7513,7514,7515,7516,7517,7518,7519,7520,7521,7522,7523,7524,7525,7526,7527,7528,7529,7530,7531,7532,7533,7534,7535,7536,7537,7538,7539,7540,7541,7542,7543,7544,7545,7546,7547,7548,7549,7550,7551,7552,7553,7554,7555,7556,7557,7558,7559,7560,7561,7562,7563,7564,7565,7566,7567,7568,7569,7570,7571,7572,7573,7574,7575,7576,7577,7578,7579,7580,7581,7582,7583,7584,7585,7586,7587,7588,7589,7590,7591,7592,7593,7594,7595,7596,759