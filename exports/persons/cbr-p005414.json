her","object_person_id":"cbr-p005400","status":"source_attested","evidence":[{"chapter_id":"c-shiji-096-zhang","source_id":"s-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p014","quote":"蒼為丞相十餘年，魯人公孫臣上書言漢土德時，其符有黃龍當見。詔下其議張蒼，張蒼以為非是，罷之。其後黃龍見成紀，於是文帝召公孫臣以為博士，草土德之歷制度，更元年。張丞相由此自絀，謝病稱老。蒼任人為中候，大為姦利，上以讓蒼，蒼遂病免。蒼為丞相十五歲而免。孝景前五年，蒼卒，謚為文侯。子康侯代，八年卒。子類代為侯，八年，坐臨諸侯喪後就位不敬，國除。"}],"qualifiers":{"source_term":"子康侯代，八年卒。子類代為侯","historicity":"historical_tradition"},"interpretation_note":"按原文明示親屬保存；父事不作生父，繼位不自行推父子，不補闕代或同母。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji096-007","subject_person_id":"cbr-p005414","predicate":"grandfather","object_person_id":"cbr-p005362","status":"source_attested","evidence":[{"chapter_id":"c-shiji-096-zhang","source_id":"s-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p015","quote":"初，張蒼父長不滿五尺，及生蒼，蒼長八尺餘，為侯、丞相。蒼子復長。及孫類，長六尺餘，坐法失侯。蒼之免相後，老，口中無齒，食乳，女子為乳母。妻妾以百數，嘗孕者不復幸。蒼年百有餘歲而卒。"}],"qualifiers":{"source_term":"及孫類","historicity":"historical_tradition"},"interpretation_note":"按原文明示親屬保存；父事不作生父，繼位不自行推父子，不補闕代或同母。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji096-040","person_id":"cbr-p005414","title":"侯","kind":"noble_rank","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-096-zhang","source_id":"s-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p014","quote":"蒼為丞相十餘年，魯人公孫臣上書言漢土德時，其符有黃龍當見。詔下其議張蒼，張蒼以為非是，罷之。其後黃龍見成紀，於是文帝召公孫臣以為博士，草土德之歷制度，更元年。張丞相由此自絀，謝病稱老。蒼任人為中候，大為姦利，上以讓蒼，蒼遂病免。蒼為丞相十五歲而免。孝景前五年，蒼卒，謚為文侯。子康侯代，八年卒。子類代為侯，八年，坐臨諸侯喪後就位不敬，國除。"}],"attestations":[{"id":"th-shiji096-040:a001","paragraph_id":"c-shiji-096-zhang:p014","start":151,"end":152,"surface":"侯","person_mention_id":"c-shiji-096-zhang:m014-0148","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-096-zhang","source_id":"s-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p014","quote":"蒼為丞相十餘年，魯人公孫臣上書言漢土德時，其符有黃龍當見。詔下其議張蒼，張蒼以為非是，罷之。其後黃龍見成紀，於是文帝召公孫臣以為博士，草土德之歷制度，更元年。張丞相