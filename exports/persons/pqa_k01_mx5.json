"1bd_b18_3c0","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-xiao:p001:m0424","surface":"堅","start":424,"end":425,"person_id":"1bd_b18_3c0","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-xiao:p001:m0443","surface":"堅","start":443,"end":444,"person_id":"1bd_b18_3c0","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-xiao:p001:m0449","surface":"孟威","start":449,"end":451,"person_id":"pqa_k01_mx5","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-xiao:p001:m0456","surface":"丁彥遠","start":456,"end":459,"person_id":"cut_ey4_n8y","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-xiao:p001:m0464","surface":"吉祖沖","start":464,"end":467,"person_id":"thd_hmr_nie","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-058-zhou-xiao","book_id":"b-jinshu-058","work_id":"w-jinshu","source_id":"s-jinshu-058-zhou-xiao-ws1775463"},{"id":"c-jinshu-058-zhou-xiao:p002","text":"虓竟以病卒於太原。其子興迎致其喪，冠軍將軍謝玄親臨哭之，因上疏曰：「臣聞旌善表功，崇義明節，所以振揚聲教，垂美來葉。故西夷校尉、梓潼太守周虓，執心忠烈，厲節寇庭，遂嬰禍荒裔，痛窴泉壤。臣毎悲其志，以爲蘇武之賢，不復過也。前宣告并州，訪求虓喪，並索其家。負荷數千，始得來至。即以資送，還其舊隴。伏願聖朝追其志心，表其殊節，使負霜之志不墜於地，則榮慰存亡，惠被幽顯矣。」孝武帝詔曰：「虓厲志貞亮，無愧古烈。未及拔身，奄隕厥命。甄表義節，國之典也。贈龍驤將軍、益州刺史，賻錢二十萬，布百匹。」又贍賜其家。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":96,"last_line":96,"raw_start":9231,"raw_end":9482,"raw_character_offsets":[9233,9234,9235,9236,9237,9238,9239,9240,9241,9242,9243,9244,9245,9246,9247,9248,9249,9250,9251,9252,9253,9254,9255,9256,9257,9258,9259,9260,9261,9262,9263,9264,9265,9266,9267,9268,9269,9270,9271,9272,9273,9274,9275,9276,9277,9278,9279,9280,9281,9282,9283,9284,9285,9286,9287,9288,9289,9290,9291,9292,9293,9294,9295,9296,9297,9298,9299,9300,9301,9302,9303,9304,9305,9306,9307,9308,9309,9310,9311,9312,9313,9314,9315,9316,9317,9318,9319,9320,9321,9322,9323,9324,9325,9326,9327,9328,9329,9330,9331,9332,9333,9334,9335,9336,9337,9338,9339,9340,9341,9342,9343,93