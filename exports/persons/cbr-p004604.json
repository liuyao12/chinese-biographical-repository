0294","start":294,"end":296,"surface":"相如","kind":"person","person_id":"mjy_lip_a2o","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m007-0298","start":298,"end":301,"surface":"趙禦史","kind":"person","person_id":"2rz_j0z_ij3","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m007-0309","start":309,"end":311,"surface":"秦王","kind":"person","person_id":"djb_njc_1kd","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m007-0312","start":312,"end":314,"surface":"趙王","kind":"person","person_id":"d9b_5t4_9eb","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m007-0320","start":320,"end":322,"surface":"群臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未定指代保存，不補姓名。"},{"id":"c-shiji-081-lianlin:m007-0332","start":332,"end":334,"surface":"秦王","kind":"person","person_id":"djb_njc_1kd","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m007-0337","start":337,"end":340,"surface":"藺相如","kind":"person","person_id":"mjy_lip_a2o","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m007-0351","start":351,"end":353,"surface":"趙王","kind":"person","person_id":"d9b_5t4_9eb","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m007-0356","start":356,"end":358,"surface":"秦王","kind":"person","person_id":"djb_njc_1kd","status":"contextual_provisional"}],"chapter_id":"c-shiji-081-lianlin","book_id":"b-shiji-081","work_id":"w-shiji","source_id":"s-shiji-081-lianlin"},{"id":"c-shiji-081-lianlin:p008","text":"既罷歸國，以相如功大，拜爲上卿，位在廉頗之右。廉頗曰：「我爲趙將，有攻城野戰之大功，而藺相如徒以口舌爲勞，而位居我上，且相如素賤人，吾羞，不忍爲之下。」宣言曰：「我見相如，必辱之。」相如聞，不肯與會。相如毎朝時，常稱病，不欲與廉頗爭列。已而相如出，望見廉頗，相如引車避匿。於是舍人相與諫曰：「臣所以去親戚而事君者，徒慕君之髙義也。今君與廉頗同列，廉君宣惡言而君畏匿之，恐懼殊甚，且庸人尚羞之，況於將相乎！臣等不肖，請辭去。」藺相如固止之，曰：「公之視廉將軍孰與秦王？」曰：「不若也。」相如曰：「夫以秦王之威，而相如廷叱之，辱其群臣，相如雖駑，獨畏廉將軍哉？顧吾念之，彊秦之所以不敢加兵於趙者，徒以吾兩人在也。今兩虎共鬥，其勢不倶生。吾所以爲此者，以先國家之急而後私讎也。」廉頗聞之，肉袒負荊，因賓客至藺相如門謝罪。曰：「鄙賤之人，不知將軍寬之至此也。」卒相與驩，爲刎頸之交。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-081-lianlin:m008-0006","start":6,"end":8,"surface":"相如","kind":"person","person_id":"mjy_lip_a2o","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m008-0018","start":18,"end":20,"surface":"廉頗","kind":"person","person_id":"we8_3f9_z9b","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m008-0023","start":23,"end":25,"surface":"廉頗","kind":"person","person_id":"we8_3f9_z9b","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m008-0043","start":43,"end":46,"surface":"藺相如","kind":"person","person_id":"mjy_lip_a2o","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m008-0060","start":60,"end":62,"surface":"相如","kind":"person","person_id":"mjy_lip_a2o","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m008-0083","start":83,"end":85,"surface":"相如","kind":"person","person_id":"mjy_lip_a2o","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m008-0091","start":91,"end":93,"surface":"相如","kind":"person","person_id":"mjy_lip_a2o","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m008-0100","start":100,"end":102,"surface":"相如","kind":"person","person_id":"mjy_lip_a2o","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m008-0113","start":113,"end":115,"surface":"廉頗","kind":"person","person_id":"we8_3f9_z9b","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m008-0120","start":120,"end":122,"surface":"相如","kind":"person","person_id":"mjy_lip_a2o","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m008-0126","start":126,"end":128,"surface":"廉頗","kind":"person","person_id":"we8_3f9_z9b","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m008-0129","start":129,"end":131,"surface":"相如","kind":"person","person_id":"mjy_lip_a2o","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m008-0138","start":138,"end":140,"surface":"舍人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未定指代保存，不補姓名。"},{"id":"c-shiji-081-lianlin:m008-0150","start":15