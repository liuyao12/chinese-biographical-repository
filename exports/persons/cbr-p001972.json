{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p001972","identity_policy":"contextual_provisional","person_ids":["cbr-p001972"],"persons":[{"id":"cbr-p001972","label":"樗裏疾（楚篇合秦議者）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"樗裏疾","mention_ids":["c-shiji-040-chu:m075-0059","c-shiji-040-chu:m075-0074","c-shiji-040-chu:m076-0083","c-shiji-040-chu:m076-0251"]},{"surface":"樗里子","mention_ids":["c-shiji-040-chu:m076-0280"]},{"surface":"疾","mention_ids":["c-shiji-040-chu:m076-0255","c-shiji-040-chu:m076-0268"]}],"evidence":[{"mention_id":"c-shiji-040-chu:m075-0059","chapter_id":"c-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p075","quote":"樗裏疾"},{"mention_id":"c-shiji-040-chu:m075-0074","chapter_id":"c-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p075","quote":"樗裏疾"},{"mention_id":"c-shiji-040-chu:m076-0083","chapter_id":"c-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p076","quote":"樗裏疾"},{"mention_id":"c-shiji-040-chu:m076-0251","chapter_id":"c-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p076","quote":"樗裏疾"},{"mention_id":"c-shiji-040-chu:m076-0280","chapter_id":"c-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p076","quote":"樗里子"},{"mention_id":"c-shiji-040-chu:m076-0255","chapter_id":"c-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p076","quote":"疾"},{"mention_id":"c-shiji-040-chu:m076-0268","chapter_id":"c-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p076","quote":"疾"}]}],"mentions":[{"id":"c-shiji-040-chu:m075-0059","start":59,"end":62,"surface":"樗裏疾","kind":"person","person_id":"cbr-p001972","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p075","chapter_id":"c-shiji-040-chu"},{"id":"c-shiji-040-chu:m075-0074","start":74,"end":77,"surface":"樗裏疾","kind":"person","person_id":"cbr-p001972","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p075","chapter_id":"c-shiji-040-chu"},{"id":"c-shiji-040-chu:m076-0083","start":83,"end":86,"surface":"樗裏疾","kind":"person","person_id":"cbr-p001972","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p076","chapter_id":"c-shiji-040-chu"},{"id":"c-shiji-040-chu:m076-0251","start":251,"end":254,"surface":"樗裏疾","kind":"person","person_id":"cbr-p001972","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p076","chapter_id":"c-shiji-040-chu"},{"id":"c-shiji-040-chu:m076-0255","start":255,"end":256,"surface":"疾","kind":"person","person_id":"cbr-p001972","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p076","chapter_id":"c-shiji-040-chu"},{"id":"c-shiji-040-chu:m076-0268","start":268,"end":269,"surface":"疾","kind":"person","person_id":"cbr-p001972","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p076","chapter_id":"c-shiji-040-chu"},{"id":"c-shiji-040-chu:m076-0280","start":280,"end":283,"surface":"樗里子","kind":"person","person_id":"cbr-p001972","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p076","chapter_id":"c-shiji-040-chu"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji040-070","person_id":"cbr-p001972","surfaces":["樗裏疾","樗里子","疾"],"scope":"same_chapter","chapter_ids":["c-shiji-040-chu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-040-chu:p075","quote":"二十〈六〉年，齊湣王欲爲從長，惡楚之與秦合，乃使使遺楚王書曰：「寡人患楚之不察於尊名也。今秦惠王死，武王立，張儀走魏，樗裏疾、公孫衍用，而楚事秦。夫樗裏疾善乎韓，而公孫衍善乎魏；楚必事秦，韓、魏恐，必因二人求合於秦，則燕、趙亦宜事秦。四國爭事秦，則楚爲郡縣矣。王何不與寡人并力收韓、魏、燕、趙，與爲從而尊周室，以案兵息民，令於天下？莫敢不樂聽，則王名成矣。王率諸侯并伐，破秦必矣。王取武關、蜀、漢之地，私呉、越之富而擅江海之利，韓、魏割上黨，西薄函谷，則楚之彊百萬也。且王欺於張儀，亡地漢中，兵銼藍田，天下莫不代王懷怒。今乃欲先事秦！願大王孰計之。」"},{"paragraph_id":"c-shiji-040-chu:p076","quote":"楚王業已欲和於秦，見齊王書，猶豫不決，下其議群臣。群臣或言和秦，或曰聽齊。昭雎曰：「王雖東取地於越，不足以刷恥；必且取地於秦，而後足以刷恥於諸侯。王不如深善齊、韓以重樗裏疾，如是則王得韓、齊之重以求地矣。秦破韓宜陽，而韓猶復事秦者，以先王墓在平陽，而秦之武遂去之七十里，以故尤畏秦。不然，秦攻三川，趙攻上黨，楚攻河外，韓必亡。楚之救韓，不能使韓不亡，然存韓者楚也。韓已得武遂於秦，以河山爲塞，所報德莫如楚厚，臣以爲其事王必疾。齊之所信於韓者，以韓公子眛爲齊相也。韓已得武遂於秦，王甚善之，使之以齊、韓重樗裏疾，疾得齊、韓之重，其主弗敢棄疾也。今又益之以楚之重，樗里子必言秦，復與楚之侵地矣。」於是懷王許之，竟不合秦，而合齊以善韓。"}],"rationale":"本篇具名出使、合秦或說楚事件內暫接，未與他篇同名候選批量合併；短稱及未見名字仍待核。 疾得及弗敢棄疾的疾接續樗裏疾；必疾不標。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-040-chu:p075","text":"二十〈六〉年，齊湣王欲爲從長，惡楚之與秦合，乃使使遺楚王書曰：「寡人患楚之不察於尊名也。今秦惠王死，武王立，張儀走魏，樗裏疾、公孫衍用，而楚事秦。夫樗裏疾善乎韓，而公孫衍善乎魏；楚必事秦，韓、魏恐，必因二人求合於秦，則燕、趙亦宜事秦。四國爭事秦，則楚爲郡縣矣。王何不與寡人并力收韓、魏、燕、趙，與爲從而尊周室，以案兵息民，令於天下？莫敢不樂聽，則王名成矣。王率諸侯并伐，破秦必矣。王取武關、蜀、漢之地，私呉、越之富而擅江海之利，韓、魏割上黨，西薄函谷，則楚之彊百萬也。且王欺於張儀，亡地漢中，兵銼藍田，天下莫不代王懷怒。今乃欲先事秦！願大王孰計之。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m075-0007","start":7,"end":10,"surface":"齊湣王","kind":"person","person_id":"cbr-p002034","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m075-0026","start":26,"end":28,"surface":"楚王","kind":"person","person_id":"cbr-p001923","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m075-0045","start":45,"end":48,"surface":"秦惠王","kind":"person","person_id":"cbr-p000290","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m075-0050","start":50,"end":52,"surface":"武王","kind":"person","person_id":"cbr-p000480","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m075-0054","start":54,"end":56,"surface":"張儀","kind":"person","person_id":"cbr-p000464","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m075-0059","start":59,"end":62,"surface":"樗裏疾","kind":"person","person_id":"cbr-p001972","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m075-0063","start":63,"end":66,"surface":"公孫衍","kind":"person","person_id":"cbr-p001971","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m075-0074","start":74,"end":77,"surface":"樗裏疾","kind":"person","person_id":"cbr-p001972","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m075-0082","start":82,"end":85,"surface":"公孫衍","kind":"person","person_id":"cbr-p001971","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m075-0130","start":130,"end":131,"surface":"王","kind":"person","person_id":"cbr-p001923","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m075-0173","start":173,"end":174,"surface":"王","kind":"person","person_id":"cbr-p001923","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m075-0178","start":178,"end":179,"surface":"王","kind":"person","person_id":"cbr-p001923","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m075-0190","start":190,"end":191,"surface":"王","kind":"person","person_id":"cbr-p001923","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m075-0235","start":235,"end":236,"surface":"王","kind":"person","person_id":"cbr-p001923","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m075-0238","start":238,"end":240,"surface":"張儀","kind":"person","person_id":"cbr-p000464","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m075-0256","start":256,"end":257,"surface":"王","kind":"person","person_id":"cbr-p001923","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m075-0268","start":268,"end":270,"surface":"大王","kind":"person","person_id":"cbr-p001923","status":"contextual_provisional"}],"chapter_id":"c-shiji-040-chu","book_id":"b-shiji-040","work_id":"w-shiji","source_id":"s-shiji-040-chu"},{"id":"c-shiji-040-chu:p076","text":"楚王業已欲和於秦，見齊王書，猶豫不決，下其議群臣。群臣或言和秦，或曰聽齊。昭雎曰：「王雖東取地於越，不足以刷恥；必且取地於秦，而後足以刷恥於諸侯。王不如深善齊、韓以重樗裏疾，如是則王得韓、齊之重以求地矣。秦破韓宜陽，而韓猶復事秦者，以先王墓在平陽，而秦之武遂去之七十里，以故尤畏秦。不然，秦攻三川，趙攻上黨，楚攻河外，韓必亡。楚之救韓，不能使韓不亡，然存韓者楚也。韓已得武遂於秦，以河山爲塞，所報德莫如楚厚，臣以爲其事王必疾。齊之所信於韓者，以韓公子眛爲齊相也。韓已得武遂於秦，王甚善之，使之以齊、韓重樗裏疾，疾得齊、韓之重，其主弗敢棄疾也。今又益之以楚之重，樗里子必言秦，復與楚之侵地矣。」於是懷王許之，竟不合秦，而合齊以善韓。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m076-0000","start":0,"end":2,"surface":"楚王","kind":"person","person_id":"cbr-p001923","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m076-0010","start":10,"end":12,"surface":"齊王","kind":"person","person_id":"cbr-p002034","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m076-0037","start":37,"end":39,"surface":"昭雎","kind":"person","person_id":"cbr-p001945","status