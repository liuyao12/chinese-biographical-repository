r_id":"c-shiji-117-xiangru"}],"relations":[],"title_holdings":[{"id":"th-shiji117-006","person_id":"fu9_7ic_bp3","title":"狗監","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-117-xiangru","source_id":"s-shiji117-xiangru","paragraph_id":"c-shiji-117-xiangru:p003","quote":"居久之，蜀人楊得意為狗監，侍上。上讀子虛賦而善之，曰：「朕獨不得與此人同時哉！」得意曰：「臣邑人司馬相如自言為此賦。」上驚，乃召問相如。相如曰：「有是。然此乃諸侯之事，未足觀也。請為天子游獵賦，賦成奏之。」上許，令尚書給筆劄。相如以「子虛」，虛言也，為楚稱；「烏有先生」者，烏有此事也，為齊難；「無是公」者，無是人也，明天子之義。故空藉此三人為辭，以推天子諸侯之苑囿。其卒章歸之於節儉，因以風諫。奏之天子，天子大說。其辭曰："}],"attestations":[{"id":"th-shiji117-006:a001","paragraph_id":"c-shiji-117-xiangru:p003","start":10,"end":12,"surface":"狗監","person_mention_id":"c-shiji-117-xiangru:m003-0006","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授任與文獻用稱分存；受金失官與歲餘復召為郎分事件。原文未明示公元日期，不補年份或任期；死亡不自動終止全部官爵。","reviewer":"Codex（AI 代理）"}],"address_assertions":[{"id":"pa-shiji117-005","person_id":"fu9_7ic_bp3","relation":"biographical_origin","place":{"source_name":"蜀","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-117-xiangru","source_id":"s-shiji117-xiangru","paragraph_id":"c-shiji-117-xiangru:p003","quote":"居久之，蜀人楊得意為狗監，侍上。上讀子虛賦而善之，曰：「朕獨不得與此人同時哉！」得意曰：「臣邑人司馬相如自言為此賦。」上驚，乃召問相如。相如曰：「有是。然此乃諸侯之事，未足觀也。請為天子游獵賦，賦成奏之。」上許，令尚書給筆劄。相如以「子虛」，虛言也，為楚稱；「烏有先生」者，烏有此事也，為齊難；「無是公」者，無是人也，明天子之義。故空藉此三人為辭，以推天子諸侯之苑囿。其卒章歸之於節儉，因以風諫。奏之天子，天子大說。其辭曰："}],"source_term":"蜀人楊得意","interpretation_note":"來源人地稱謂，保留原字與地名範圍；不推出生地或現代轄區。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-117-xiangru:p003","text":"居久之，蜀人楊得意為狗監，侍上。上讀子虛賦而善之，曰：「朕獨不得與此人同時哉！」得意曰：「臣邑人司馬相如自言為此賦。」上驚，乃召問相如。相如曰：「有是。然此乃諸侯之事，未