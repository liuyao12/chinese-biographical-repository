person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":1765279,"source_layer":"received_biography","first_line":131,"last_line":131,"line_start":28,"line_end":56,"raw_start":6419,"raw_end":6447,"raw_character_offsets":[6419,6420,6421,6422,6423,6424,6425,6426,6427,6428,6429,6430,6431,6432,6433,6434,6435,6436,6437,6438,6439,6440,6441,6442,6443,6444,6445,6446],"projection_sha256":"b6cd6bc1c831e9805482ceeefb979c7717b960d90679cb808eee2ef0be9b3cac"},"chapter_id":"c-nanshi-024-guhaozhi","book_id":"b-nanshi-024","work_id":"w-nanshi","source_id":"s-nanshi-024-guhaozhi-ws1765279"},{"id":"c-nanshi-024-wangsiyuan:p002","text":"齊建元初，曆竟陵王司徒録事參軍、太子中舍人。文惠太子與竟陵王子良素好士，並蒙賞接。思遠求出爲遠郡，除建安內史。長兄思玄卒，思遠友于甚至，表乞自解，不許。及祥日又固陳，武帝乃許之。仍除中書郎、大司馬諮議。詔舉士，竟陵王子良薦思遠及呉郡顧暠之、陳郡殷叡。時邵陵王子貞爲呉郡，除思遠爲呉郡丞，以本官行郡事，論者以爲得人。後拜御史中丞。臨海太守沈昭略贓私，思遠依事劾奏，明帝及思遠從兄晏、昭略叔父文季並請止之，思遠不從，案事如故。","mentions":[{"id":"c-nanshi-024-wangsiyuan:p002:m0030","surface":"子良","start":30,"end":32,"person_id":"x3q_cqm_dup","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangsiyuan:p002:m0041","surface":"思遠","start":41,"end":43,"person_id":"0cf_pqs_mnm","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangsiyuan:p002:m0057","surface":"思玄","start":57,"end":59,"person_id":"7r6_k52_qji_ABDACABCA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangsiyuan:p002:m0061","surface":"思遠","start":61,"end":63,"person_id":"0cf_pqs_mnm","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangsiyuan:p002:m0108","surface":"子良","start":108,"end":110,"person_id":"x3q_cqm_dup","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangsiyuan:p002:m0111","surface":"思遠","start":111,"end":