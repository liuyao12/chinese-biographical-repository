amily_paths":[],"mentions":[{"id":"c-songshu-049-kuaien:p002:m0049","start":49,"end":51,"surface":"張堅","kind":"person","person_id":"w95_vjq_owm","status":"contextual_provisional","paragraph_id":"c-songshu-049-kuaien:p002","chapter_id":"c-songshu-049-kuaien"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-songshu-049-kuaien:p002","text":"從平京城，進定京邑，以寧遠將軍領幢。隨振武將軍道規西討，虜桓仙客，克偃月壘，遂平江陵。義熙二年，賊張堅據應城反，恩擊破之，封都鄉侯。從伐廣固，又有戰功。盧循逼京邑，恩戰于查浦，賊退走。與王仲德等追破循別將范崇民於南陵。循既走還廣州，恩又領千餘人隨劉藩追徐道覆於始興，斬之。遷龍驤將軍、蘭陵太守。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":19,"last_line":19,"raw_start":1055,"raw_end":1202,"raw_character_offsets":[1055,1056,1057,1058,1059,1060,1061,1062,1063,1064,1065,1066,1067,1068,1069,1070,1071,1072,1073,1074,1075,1076,1077,1078,1079,1080,1081,1082,1083,1084,1085,1086,1087,1088,1089,1090,1091,1092,1093,1094,1095,1096,1097,1098,1099,1100,1101,1102,1103,1104,1105,1106,1107,1108,1109,1110,1111,1112,1113,1114,1115,1116,1117,1118,1119,1120,1121,1122,1123,1124,1125,1126,1127,1128,1129,1130,1131,1132,1133,1134,1135,1136,1137,1138,1139,1140,1141,1142,1143,1144,1145,1146,1147,1148,1149,1150,1151,1152,1153,1154,1155,1156,1157,1158,1159,1160,1161,1162,1163,1164,1165,1166,1167,1168,1169,1170,1171,1172,1173,1174,1175,1176,1177,1178,1179,1180,1181,1182,1183,1184,1185,1186,1187,1188,1189,1190,1191,1192,1193,1194,1195,1196,1197,1198,1199,1200,1201],"revision_id":2118585},"mentions":[{"id":"c-songshu-049-kuaien:p002:m0023","start":23,"end":25,"surface":"道規","kind":"person","person_id":"3qs_nqa_ioa_AAC","status":"contextual_provisional"},{"id":"c-songshu-049-kuaien:p002:m0029","start":29,"end":32,"surface":"桓仙客","kind":"person","person_id":"jxk_yz0_g8j","status":"contextual_provisional"},{"id":"c-songshu-049-kuaien:p002:m0049","start":49,"end":51,"