:"c-shiji-086-cike:p009","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m010-0080","start":80,"end":82,"surface":"襄子","kind":"person","person_id":"cbr-p004830","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p010","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m010-0083","start":83,"end":85,"surface":"襄子","kind":"person","person_id":"cbr-p004830","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p010","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m010-0115","start":115,"end":117,"surface":"襄子","kind":"person","person_id":"cbr-p004830","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p010","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m011-0006","start":6,"end":8,"surface":"襄子","kind":"person","person_id":"cbr-p004830","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p011","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m011-0022","start":22,"end":24,"surface":"襄子","kind":"person","person_id":"cbr-p004830","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p011","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m011-0030","start":30,"end":32,"surface":"襄子","kind":"person","person_id":"cbr-p004830","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p011","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m011-0055","start":55,"end":57,"surface":"襄子","kind":"person","person_id":"cbr-p004830","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p011","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m011-0167","start":167,"end":169,"surface":"襄子","kind":"person","person_id":"cbr-p004830","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p011","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m011-0312","start":312,"end":314,"surface":"襄子","kind":"person","person_id":"cbr-p004830","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p011","chapter_id":"c-shiji-086-cike"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji086-019","person_id":"cbr-p004830","scope":"same_chapter","chapter_ids":["c-shiji-086-cike"],"status":"contextual_provisional","rationale":"依專諸刺僚、公子光自立闔閭與豫讓報智伯敘事暫接。專諸之子、豫讓妻友保持未名；范中行氏與母老子弱未補名，嵌套對話指代待核。","reviewer":"Codex（AI 代理）","surfaces":["襄子","趙襄子"],"evidence":[{"paragraph_id":"c-shiji-086-cike:p009","quote":"豫讓者，晉人也，故嘗事范氏及中行氏，而無所知名。去而事智伯，智伯甚尊寵之。及智伯伐趙襄子，趙襄子與韓、魏合謀滅智伯，滅智伯之後而三分其地。趙襄子最怨智伯，漆其頭以爲飲器。豫讓遁逃山中，曰：「嗟乎！士爲知己者死，女爲説己者容。今智伯知我，我必爲報讎而死，以報智伯，則吾魂魄不愧矣。」乃變名姓爲刑人，入宮涂廁，中挾匕首，欲以刺襄子。襄子如廁，心動，執問涂廁之刑人，則豫讓，内持刀兵，曰：「欲爲智伯報仇！」左右欲誅之。襄子曰：「彼義人也，吾謹避之耳。且智伯亡無後，而其臣欲爲報仇，此天下之賢人也。」卒醳去之。"},{"paragraph_id":"c-shiji-086-cike:p010","quote":"居頃之，豫讓又漆身爲厲，呑炭爲啞，使形狀不可知，行乞於市。其妻不識也。行見其友，其友識之，曰：「汝非豫讓邪？」曰：「我是也。」其友爲泣曰：「以子之才，委質而臣事襄子，襄子必近幸子。近幸子，乃爲所欲，顧不易邪？何乃殘身苦形，欲以求報襄子，不亦難乎！」豫讓曰：「既已委質臣事人，而求殺之，是懷二心以事其君也。且吾所爲者極難耳！然所以爲此者，將以愧天下後世之爲人臣懷二心以事其君者也。」"},{"paragraph_id":"c-shiji-086-cike:p011","quote":"既去，頃之，襄子當出，豫讓伏於所當過之橋下。襄子至橋，馬驚，襄子曰：「此必是豫讓也。」使人問之，果豫讓也。於是襄子乃數豫讓曰：「子不嘗事范、中行氏乎？智伯盡滅之，而子不爲報讎，而反委質臣於智伯。智伯亦已死矣，而子獨何以爲之報讎之深也？」豫讓曰：「臣事范、中行氏，范、中行氏皆衆人遇我，我故衆人報之。至於智伯，國士遇我，我故國士報之。」襄子喟然嘆息而泣曰：「嗟乎豫子！子之爲智伯，名既成矣，而寡人赦子，亦已足矣。子其自爲計，寡人不復釋子！」使兵圍之。豫讓曰：「臣聞明主不掩人之美，而忠臣有死名之義。前君已寬赦臣，天下莫不稱君之賢。今日之事，臣固伏誅，然願請君之衣而撃之焉，以致報讎之意，則雖死不恨。非所敢望也，敢布腹心！」於是襄子大義之，乃使使持衣與豫讓。豫讓拔劍三躍而撃之，曰：「吾可以下報智伯矣！」遂伏劍自殺。死之日，趙國志士聞之，皆爲涕泣。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-086-cike:p009","text":"豫讓者，晉人也，故嘗事范氏及中行氏，而無所知名。去而事智伯，智伯甚尊寵之。及智伯伐趙襄子，趙襄子與韓、魏合謀滅智伯，滅智伯之後而三分其地。趙襄子最怨智伯，漆其頭以爲飲器。豫讓遁逃山中，曰：「嗟乎！士爲知己者死，女爲説己者容。今智伯知我，我必爲報讎而死，以報智伯，則吾魂魄不愧矣。」乃變名姓爲刑人，入宮涂廁，中挾匕首，欲以刺襄子。襄子如廁，心動，執問涂廁之刑人，則豫讓，内持刀兵，曰：「欲爲智伯報仇！」左右欲誅之。襄子曰：「彼義人也，吾謹避之耳。且智伯亡無後，而其臣欲爲報仇，此天下之賢人也。」卒醳去之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-086-cike:m009-0000","start":0,"end":2,"surface":"豫讓","kind":"person","person_id":"cbr-p004828","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m009-0011","start":11,"end":13,"surface":"范氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名氏稱或尚待核定的嵌套親屬指代，不補姓名。"},{"id":"c-shiji-086-cike:m009-0014","start":14,"end":17,"surface":"中行氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名氏稱或尚待核定的嵌套親屬指代，不補姓名。"},{"id":"c-shiji-086-cike:m009-0027","start":27,"end":29,"surface":"智伯","kind":"person","person_id":"cbr-p004829","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m009-0030","start":30,"end":32,"surface":"智伯","kind":"person","person_id":"cbr-p004829","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m009-0038","start":38,"end":40,"surface":"智伯","kind":"person","person_id":"cbr-p004829","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m009-0041","start":41,"end":44,"surface":"趙襄子","kind":"person","person_id":"cbr-p004830","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m009-0045","start":45,"end":48,"surface":"趙襄子","kind":"person","person_id":"cbr-p004830","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m009-0055","start":55,"end":57,"surface":"智伯","kind":"person","person_id":"cbr-p004829","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m009-0059","start":59,"end":61,"surface":"智伯","kind":"person","person_id":"cbr-p004829","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m009-0069","start":69,"end":72,"surface":"趙襄子","kind":"person","person_id":"cbr-p004830","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m009-0074","start":74,"end":76,"surface":"智伯","kind":"person","person_id":"cbr-p004829","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m009-0085","start":85,"end":87,"surface":"豫讓","kind":"person","person_id":"cbr-p004828","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m009-0113","start":113,"end":115,"surface":"智伯","kind":"person","person_id":"cbr-p004829","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m009-0128","start":128,"end":130,"surface":"智伯","kind":"person","person_id":"cbr-p004829","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m009-0161","start":161,"end":163,"surface":"襄子","kind":"person","person_id":"cbr-p004830","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m009-0164","start":164,"end":166,"surface":"襄子","kind":"person","person_id":"cbr-p004830","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m009-0181","start":181,"end":183,"surface":"豫讓","kind":"person","person_id":"cbr-p004828","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m009-0194","start":194,"end":196,"surface":"智伯","kind":"person","person_id":"cbr-p004829","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m009-0200","start":200,"end":202,"surface":"左右","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名氏稱或尚待核定的嵌套親屬指代，不補姓名。"},{"id":"c-shiji-086-cike:m009-0206","start":206,"end":208,"surface":"襄子","kind":"person","person_id":"cbr-p004830","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m009-0223","start":223,"end":225,"surface":"智伯","kind":"person","person_id":"cbr-p004829","status":"contextual_provisional"}],"chapter_id":"c-shiji-086-cike","book_id":"b-shiji-086","work_id":"w-shiji","source_id":"s-shiji-086-cike"},{"id":"c-shiji-086-cike:p010","text":"居頃之，豫讓又漆身爲厲，呑炭爲啞，使形狀不可知，行乞於市。其妻不識也。行見其友，其友識之，曰：「汝非豫讓邪？」曰：「我是也。」其友爲泣曰：「以子之才，委質而臣事襄子，襄子必近幸子。近幸子，乃爲所欲，顧不易邪？何乃殘身苦形，欲以求報襄子，不亦難乎！」豫讓曰：「既已委質臣事人，而求殺之，是懷二心以事其君也。且吾所爲者極難耳！然所以爲此者，將以愧天下後世之爲人臣懷二心以事其君者也。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-086-cike:m010-0004","start":4,"end":6,"surface":"豫讓","kind":"person","person_id":"cbr-p004828","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m010-0029","start":29,"end":31,"surface":"其妻","kind":"person","person_id":"cbr-p004831","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m010-0037","start":37,"end":39,"surface":"其友","kind":"person","person_id":"cbr-p004832","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m010-0040","start":40,"end":42,"surface":"其友","kind":"person","person_id":"cbr-p004832","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m010-0050","start":50,"end":52,"surface":"豫讓","kind":"person","person_id":"cbr-p004828","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m010-0063","start":63,"end":65,"surface":"其友","kind":"person","person_id":"cbr-p004832","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m010-0080","start":80,"end":82,"surface":"襄子","kind":"person","person_id":"cbr-p004830","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m010-0083","start":83,"end":85,"surface":"襄子","kind":"person","person_id":"cbr-p004830","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m010-0115","start":115,"end":117,"surface":"襄子","kind":"person","person_id":"cbr-p004830","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m010-0124","start":124,"end":126,"surface":"豫讓","kind":"person","person_id":"cbr-p004828","status":"contextual_provisional"}],"chapter_id":"c-shiji-086-cike","book_id":"b-shiji-086","work_id":"w-shiji","source_id":"s-shiji-086-cike"},{"id":"c-shiji-086-cike:p011","text":"既去，頃之，襄子當出，豫讓伏於所當過之橋下。襄子至橋，馬驚，襄子曰：「此必是豫讓也。」使人問之，果豫讓也。於是襄子乃數豫讓曰：「子不嘗事范、中行氏乎？智伯盡滅之，而子不爲報讎，而反委質臣於智伯。智伯亦已死矣，而子獨何以爲之報讎之深也？」豫讓曰：「臣事范、中行氏，范、中行氏皆衆人遇我，我故衆人報之。至於智伯，國士遇我，我故國士報之。」襄子喟然嘆息而泣曰：「嗟乎豫子！子之爲智伯，名既成矣，而寡人赦子，亦已足矣。子其自爲計，寡人不復釋子！」使兵圍之。豫讓曰：「臣聞明主不掩人之美，而忠臣有死名之義。前君已寬赦臣，天下莫不稱君之賢。今日之事，臣固伏誅，然願請君之衣而撃之焉，以致報讎之意，則雖死不恨。非所敢望也，敢布腹心！」於是襄子大義之，乃使使持衣與豫讓。豫讓拔劍三躍而撃之，曰：「吾可以下報智伯矣！」遂伏劍自殺。死之日，趙國志士聞之，皆爲涕泣。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-086-cike:m011-0006","start":6,"end":8,"surface":"襄子","kind":"person","person_id":"cbr-p004830","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m011-0011","start":11,"end":13,"surface":"豫讓","kind":"person","person_id":"cbr-p004828","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m011-0022","start":22,"end":24,"surface":"襄子","kind":"person","person_id":"cbr-p004830","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m011-0030","start":30,"end":32,"surface":"襄子","kind":"person","person_id":"cbr-p004830","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m011-0038","start":38,"end":40,"surface":"豫讓","kind":"person","person_id":"cbr-p004828","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m011-0043","start":43,"end":45,"surface":"使人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名氏稱或尚待核定的嵌套親屬指代，不補姓名。"},{"id":"c-shiji-086-cike:m011-0049","start":49,"end":51,"surface":"豫讓","kind":"person","person_id":"cbr-p004828","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m011-0055","start":55,"end":57,"surface":"襄子","kind":"person","person_id":"cbr-p004830","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m011-0059","start":59,"end":61,"surface":"豫讓","kind":"person","person_id":"cbr-p004828","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m011-0068","start":68,"end":73,"surface":"范、中行氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名氏稱或尚待核定的嵌套親屬指代，不補姓名。"},{"id":"c-shiji-086-cike:m011-0075","start":75,"end":77,"surface":"智伯","kind":"person","person_id":"cbr-p004829","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m011-0094","start":94,"end":96,"surface":"智伯","kind":"person","person_id":"cbr-p004829","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m011-0097","start":97,"end":99,"surface":"智伯","kind":"person","person_id":"cbr-p004829","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m011-0118","start":118,"end":120,"surface":"豫讓","kind":"person","person_id":"cbr-p004828","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m011-0125","start":125,"end":130,"surface":"范、中行氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名氏稱或尚待核定的嵌套親屬指代，不補姓名。"},{"id":"c-shiji-086-cike:m011-0131","start":131,"end":136,"surface":"范、中行氏","k