e":"譙縱","kind":"person","person_id":"j5i_ahk_7yx","status":"contextual_provisional","source_role_key":"song051_p001_p003_p047_p048"},{"id":"c-songshu-051-wyd1739-zongshi:p002:m0139","start":139,"end":142,"surface":"文處茂","kind":"person","person_id":"wyp_5n0_d6z","status":"contextual_provisional","source_role_key":"song051_p001_p003_p047_p048"},{"id":"c-songshu-051-wyd1739-zongshi:p002:m0142","start":142,"end":144,"surface":"温祚","kind":"person","person_id":"gtj_2ev_amw","status":"contextual_provisional","source_role_key":"song051_p001_p003_p047_p048"},{"id":"c-songshu-051-wyd1739-zongshi:p002:m0166","start":166,"end":170,"surface":"諸葛長民","kind":"person","person_id":"1e1_hte_wn0","status":"contextual_provisional","source_role_key":"song051_p001_p003_p047_p048"}],"source_position":{"raw_projection_ref":"source-evidence/song051-wyd1739-zongshi/transcription-projection.json","raw_file_sha256":"aa7b16d610871f77b747adbe0edb84f8775e1d404140a1e3f6284dccd11aaa45","unit_key":"unit002","source_layer":"received_chapter","first_line":7,"last_line":16},"chapter_id":"c-songshu-051-wyd1739-zongshi","book_id":"b-songshu-051","work_id":"w-songshu","source_id":"s-songshu-051-wyd1739-zongshi"},{"id":"c-songshu-051-wyd1739-zongshi:p003","text":"不復立道憐請據彭城以漸修朔朝議以彭城縣遠使鎮山陽進號征虜將軍督淮北軍郡事北東海太守并州刺史義昌太守如故以破索度真功封新渝縣男食邑五百戶從高祖征廣固常為軍鋒及城陷慕容超將親兵突圍走道憐所部獲之加使持節進號左將軍七年解并州加北徐州刺史移鎮彭城八年高祖伐劉毅徵為都督兗青二州晉陵京口淮南諸軍郡事兗青州刺史持節將軍太守如故還鎮京口九年甲仗五十人入殿以廣固功改封竟陵縣公食邑千戶減先封戶邑之半以賜次子義宗十一年進號中軍將軍加散騎常","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-songshu-051-wyd1739-zongshi:p003:m0003","kind":"person","start":3,"end":5,"surface":"道憐","person_id":"3qs_nqa_ioa_AAB","status":"contextual_provisional","source_role_key":"daolian"},{"id":"c-songshu-051-wyd1739-zongshi:p003:m0053","start":53,"end":56,"surface":"索度真","kind":"person","person_id":"uwo_nwk_wpn","status":"contextual_provisional","source_role_key":"song051_p001_p003_p047_p048","interpretation_note":"同篇再次明書全名，與 p001 相連。"},{"id":"c-songshu-051-wy