nts":[],"identity_decisions":[{"id":"d-zhou041-houjing","person_id":"bzc_sjc_rgu","surfaces":["侯景"],"scope":"cross_chapter","chapter_ids":["c-zhoushu-041-wangbao-ws2432538","c-liangshu-041-wanggui-ws1512987"],"status":"contextual_provisional","evidence":[{"work_id":"w-zhoushu","book_id":"b-zhoushu-041","source_id":"s-zhoushu041-ws2432538","chapter_id":"c-zhoushu-041-wangbao-ws2432538","paragraph_id":"c-zhoushu-041-wangbao-ws2432538:p002","quote":"襃識量淵通，志懷沉靜。美風儀，善談笑，博覽史傳，尤工屬文。梁國子祭酒蕭子雲，襃之姑夫也，特善草隸。襃少以姻戚，去來其家，遂相模範。俄而名亞子雲，竝見重於世。梁武帝喜其才藝，遂以弟鄱陽王恢之女妻之。起家祕書郎，轉太子舍人，襲爵南昌縣侯。稍遷祕書丞。宣成王大器，簡文帝之冢嫡，即襃之姑子也。于時盛選僚佐，乃以襃為文學。尋遷安成郡守。及侯景渡江，建業擾亂，襃輯寧所部，見稱於時。","mention_ids":["c-zhoushu-041-wangbao-ws2432538:p002:m0165"]},{"work_id":"w-liangshu","book_id":"b-liangshu-041","source_id":"s-liangshu041-ws1512987","chapter_id":"c-liangshu-041-wanggui-ws1512987","paragraph_id":"c-liangshu-041-wanggui-ws1512987:p005","quote":"子褒，字子漢，七歲能屬文。外祖司空袁昂愛之，謂賓客曰：「此兒當成吾宅相。」弱冠舉秀才，除秘書郎、太子舍人，以父憂去職。服闋，襲封南昌侯，除武昌王文學、太子洗馬，兼東宮管記，遷司徒屬，秘書丞，出爲安成內史。太清中，侯景陷京城，江州刺史當陽公大心舉州附賊，賊轉寇南中，褒猶據郡拒守。大寶二年，世祖命徵褒赴江陵，旣至，以爲忠武將軍、南平內史，俄遷吏部尚書、侍中。承聖二年，遷尚書右僕射，仍參掌選事，又加侍中。其年，遷左僕射，參掌如故。三年，江陵陷，入于周。","mention_ids":["c-liangshu-041-wanggui-ws1512987:p005:m0106"]}],"rationale":"完整王襃本傳/書信局部角色及同朝時序辨識；來源局部登記不宣稱與外篇同名必異，拒近名/同廟號全域匹配；不補未知親屬或年。","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-041-wanggui-ws1512987:p005","text":"子褒，字子漢，七歲能屬文。外祖司空袁昂愛之，謂賓客曰：「此兒當成吾宅相。」弱冠舉秀才，除秘書郎、太子舍人，以父憂去職。服闋，襲封南昌侯，除武昌王文學、太子洗馬，兼東宮管記，遷司徒屬，秘書丞，出爲安成內史。太清中，侯景陷京城，江州刺史當陽公大心舉州附賊，賊轉寇南中，褒猶據郡拒守。大寶二年，世祖命徵褒赴江陵，旣至，以爲忠武將軍、南平內史，俄遷吏部尚書、侍中。承聖二年，遷尚書右僕射，仍參掌選事，又加侍中。其年，遷左僕射，參掌如故。三年，江陵陷，入于周。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","source_position":{"first_line":19,"last_line":19,"revision_id":1512987,"raw_start":1221,"raw_end":1462,"raw_character_offsets":[1223,1224,1225,1226,1227,1228,1229,1230,1231,1232,1233,1234,1235,1236,1237,1238,1239,1240,1241,1242,1243,1244,1245,1246,1247,1248,1249,1250,1251,1252,1253,1254,1255,1