rence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-058-zhou-fang-ws1775463","s-jinshu-066-taokan-ws1527632"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-058-zhou-fang:p004:m0545","surface":"蘇溫","start":545,"end":547,"person_id":"7qk_ant_12f","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-058-zhou-fang:p004","chapter_id":"c-jinshu-058-zhou-fang"},{"id":"c-jinshu-066-taokan:p009:m0086","surface":"蘇溫","start":86,"end":88,"person_id":"7qk_ant_12f","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-066-taokan:p009","chapter_id":"c-jinshu-066-taokan"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-058-zhou-fang:p004","text":"時梁州刺史張光卒，湣帝以侍中第五猗爲征南大將軍，監荊、梁、益、寧四州，出自武關。賊率杜曾、摯瞻、胡混等並迎猗，奉之，聚兵數萬，破陶侃於石城，攻平南將軍荀崧於宛，不克，引兵向江陵。王敦以從弟暠爲荊州刺史，令督護征虜將軍趙誘、襄陽太守硃軌、陵江將軍黃峻等討曾，而大敗於女觀湖，誘、軌並遇害。曾遂逐暠，徑造沔口，大爲寇害，威震江、沔。元帝命訪擊之。訪有眾八千，進至沌陽。曾等銳氣甚盛，訪曰：「先人有奪人之心，軍之善謀也。」使將軍李恆督左甄，許朝督右甄，訪自領中軍，高張旗幟。曾果畏訪，先攻左右甄。曾勇冠三軍，訪甚惡之，自於陣後射雉以安眾心。令其眾曰：「一甄敗，鳴三鼓；兩甄敗，鳴六鼓。」趙胤領其父余兵屬左甄，力戰，敗而復合。胤馳馬告訪，訪怒，叱令更進。胤號哭還戰，自旦至申，兩甄皆敗。訪聞鼓音，選精銳八百人，自行酒飲之，敕不得妄動，聞鼓音乃進。賊未至三十歩，訪親鳴鼓，將士皆騰躍奔赴，曾遂大潰，殺千餘人。訪夜追之，諸將請待明日，訪曰：「曾驍勇能戰，向之敗也，彼勞我逸，是以克之。宜及其衰乘之，可滅。」鼓行而進，遂定漢、沔。曾等走固武當。訪以功遷南中郎將、督梁州諸軍、梁州刺史，屯襄陽。訪謂其僚佐曰：「昔城濮之役，晉文以得臣不死而有憂色，今不斬曾，禍難未已。」於是出其不意，又擊破之，曾遁走。訪部將蘇溫收曾詣軍，並獲第五猗、胡混、摯瞻等，送於王敦。又白敦，説猗逼於曾，不宜殺。敦不從而斬之。進位安南將軍、持節，都督、刺史如故。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":74,"last_line":74,"raw_start":6513,"raw_end":7148,"raw_character_offsets":[6515,6516,6517,6518,6519,6520,6521,6522,6523,6524,6525,6526,6527,6528,6529,6530,6531,6532,6535,6538,6539,6540,6541,6542,6543,6544,6545,6546,6547,6548,6549,6550,6551,6552,6553,6554,6555,6556,6557,6558,6559,6560,6561,6562,6563,6564,6565,6566,6567,6568,6569,6570,6571,6572,6573,6574,6575,6576,6577,6578,6579,6580,6581,6582,6583,6584,6585,6586,6587,6588,6589,6590,6591,6592,6593,6594,6595,6598,6601,6602,6603,6604,6605,6606,6607,6608,6609,6610,6611,6612,6613,6614,6615,6616,6617,6618,6619,6620,6621,6622,6623,6624,6625,6626,6629,6632,6633,6634,6635,6636,6637,6638,6639,6640,6641,6642,6643,6644,6645,6646,6647,6648,6649,6650,6651,6652,6653,6654,6655,6656,6657,6658,6659,6660,6661,6662,6663,6664,6665,6666,6667,6668,6669,6670,6671,6672,6673,6674,6675,6676,6677,6678,6679,6680,6681,6682,6683,6684,6685,6686,6687,6688,6689,6690,6691,6692,6693,6694,6695,6696,6697,6698,6699,6700,6701,6702,6703,6704,6705,6706,6707,6708,6709,6710,6711,6712,6713,6714,6715,6716,6717,6718,6719,6720,6721,6722,6723,6724,6725,6726,6727,6728,6729,6730,6731,6732,6733,6734,6735,6736,6737,6738,6739,6740,6741,6742,6743,6744,6745,6746,6747,6748,6749,6750,6751,6752,6753,6754,6755,6756,6757,6758,6759,6760,6761,6762,6763,6764,6765,6766,6767,6768,6769,6770,6771,6772,6773,6774,6775,6776,6777,6778,6779,6780,6781,6782,6783,6784,6785,6788,6791,6792,6793,6794,6795,6796,6797,6798,6799,6800,6801,6802,6803,6804,6805,6806,6807,6808,6809,6810,6811,6812,6813,6814,6815,6816,6817,6818,6819,6820,6821,6822,6823,6824,6825,6826,6827,6828,6829,6830,6831,6832,6833,6834,6835,6836,683