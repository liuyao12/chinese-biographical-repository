ess_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-061-gouxi:p014","text":"晞以京邑荒饉日甚，寇難交至，表請遷都，遣從事中郎劉會領船數十艘，宿衛五百人，獻穀千斛以迎帝。朝臣多有異同。俄而京師陷，晞與王贊屯倉垣。豫章王端及和鬱等東奔晞，晞群官尊端為皇太子，置行台。端承制以晞領太子太傅、都督中外諸軍、錄尚書，自倉垣徙屯蒙城，贊屯陽夏。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":92,"last_line":92,"raw_start":7219,"raw_end":7349,"raw_character_offsets":[7221,7222,7223,7224,7225,7226,7227,7228,7229,7230,7231,7232,7233,7234,7235,7236,7237,7238,7239,7240,7241,7242,7243,7244,7245,7246,7247,7248,7249,7250,7251,7252,7253,7254,7255,7256,7257,7258,7259,7260,7261,7262,7263,7264,7265,7266,7267,7268,7269,7270,7271,7272,7273,7274,7275,7276,7277,7278,7279,7280,7281,7282,7283,7284,7285,7286,7287,7288,7289,7290,7291,7292,7293,7294,7295,7296,7297,7298,7299,7300,7301,7302,7303,7304,7305,7306,7307,7308,7309,7310,7311,7312,7313,7314,7315,7316,7317,7318,7319,7320,7321,7322,7323,7324,7325,7326,7327,7328,7329,7330,7331,7332,7333,7334,7335,7336,7337,7338,7339,7340,7341,7342,7343,7344,7345,7346,7347,7348],"revision_id":7903772},"mentions":[{"id":"c-jinshu-061-gouxi:p014:m0000","surface":"晞","start":0,"end":1,"person_id":"v5s_1ew_vh0","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p014:m0024","surface":"劉會","start":24,"end":26,"person_id":"qci_q43_th6","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p014:m0059","surface":"晞","start":59,"end":60,"person_id":"v5s_1ew_vh0","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p014:m0061","surface":"王贊","start":61,"end":63,"person_id":"i0y_g49_jd6","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p014:m0067","surface":"豫章王端","start":67,"end":71,"person_id":"7xu_sss_agn","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p014:m0072","surface":"和鬱","start":72,"end":74,"person_id":"cks_kw6_zkz","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p014:m0077","surface":"晞","start":77,"end":78,"person_id":"v5s_1ew_vh0","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p014:m0079","surface":"晞","start":79,"end":80,"person_id":"v5s_1ew_vh0","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p014:m0083","surface":"端","start":83,"end":84,"person_id":"7xu_sss_agn","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p014:m0093","surface":"端","start":93,"end":94,"person_id":"7xu_sss_agn","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p014:m0097","surface":"晞","start":97,"end":98,"person_id":"v5s_1ew_vh0","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p014:m0123","surface":"贊","start":123,"end":124,"person_id":"i0y_g49_jd6","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-061-gouxi","book_id":"b-jinshu-061","work_id":"w-jinshu","source_id":"s-jinshu-061-gouxi-ws7903772"},{"id":"c-jinshu-064-simaduan:p001","text":"端初封廣川王，銓之為皇太子也，轉封豫章，禮秩如皇子，拜散騎常侍、平南將軍、都督江州諸軍事、假節。當之國，會洛陽陷沒，端東奔苟晞于蒙。晞立為皇太子，七十日，為石勒所沒。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":52,"last_line":52,"raw_start":3017,"raw_end":3102,"raw_character_offsets":[3019,3020,3021,3022,3023,3024,3025,3026,3027,3028,3029,3030,3031,3032,3033,3034,3035,3036,3037,3038,3039,3040,3041,3042,3043,3044,3045,3046,3047,3048,3049,3050,3051,3052,3053,3054,3055,3056,3057,3058,3059,3060,3061,3062,3063,3064,3065,3066,3067,3068,3069,3070,3071,3072,3073,3074,3075,3076,3077,3078,3079,3080,3081,3082,3083,3084,3085,3086,3087,3088,3089,3090,3091,3092,3093,3094,3095,3096,3097,3098,3099,3100,3101],"revision_id":2622004},"mentions":[{"id":"c-jinshu-064-simaduan:p001:m0000","surface":"端","start":0,"end":1,"person_id":"7xu_sss_agn","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-064-simaduan:p001:m0007","surface":"銓","start":7,"end":8,"person_id":"e9x_60x_9m9","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-064-simaduan:p001:m0061","surface":"苟晞","start":61,"end":63,"person_id":"v5s_1ew_vh0","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-064-simaduan:p001:m0078","surface":"石勒","start":78,"end":80,"person_id":"0c9_95a_18b","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-064-simaduan","book_id":"b-jinshu-064","work_id":"w-jinshu","source_id":"s-jinshu-064-simaduan-ws2622004"},{"id":"c-jinshu-064-simaxia:p001","text":"清河康王遐，字深度，美容儀，有精彩，武帝愛之。既受封，出繼叔父城陽哀王兆。太康十年，封渤海郡，曆右將軍、散騎常侍、前將軍。元康初，進撫軍將軍，加侍中，遐長而懦弱，無所是非。性好內，不能接士大夫。及楚王瑋之舉兵也，使遐收衛瓘，而瓘故吏榮晦遂盡殺瓘子孫，遐不能禁，為世所尤。永康元年薨，時年二十八。四子：覃、籥、銓、端。覃嗣立。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":44,"last_line":44,"raw_start":2303,"raw_end":2537,"raw_character_offsets":[2305,2306,2307,2308,2309,2310,2311,2312,2313,2314,2315,2316,2317,2318,2319,2320,2321,2322,2323,2324,2325,2326,2327,2328,2329,2330,2331,2332,2333,2334,2335,2336,2337,2338,2339,2340,2341,2347,2348,2349,2350,2353,2354,2355,2356,2357,2358,2359,2360,2361,2362,2363,2364,2365,2366,2367,2368,2369,2370,2371,2372,2373,2374,2375,2376,2377,2378,2379,2380,2381,2382,2383,2384,2385,2386,2387,2388,2389,2390,2391,2392,2393,2394,2395,2396,2397,2398,2399,2400,2401,2402,2403,2404,2405,2406,2407,2408,2409,2410,2411,2412,2413,2414,2415,2416,2417,2418,2419,2420,2421,2422,2423,2424,2425,2426,2427,2428,2429,2430,2431,2432,2433,2434,2435,2436,2437,2438,2439,2440,2441,2442,2443,2444,2445,2446,2452,2453,2454,2455,2463,2464,2465,2466,2467,2468,2469,2470,2471,2472,2473,2474,2475,2476,2477,2478,2479,2480,2532,2533,2534,2535,2536],"revision_id":2622004},"mentions":[{"id":"c-jinshu-064-simaxia:p001:m0000","surface":"清河康王遐","start":0,"end":5,"person_id":"dn2_wer_1hg","kind":"person","status":"contextual_provisional"},{"id":