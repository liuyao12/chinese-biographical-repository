_id":"cbr-p005094","status":"contextual_provisional","paragraph_id":"c-shiji-091-qingbu:p018","chapter_id":"c-shiji-091-qingbu"},{"id":"c-shiji-091-qingbu:m020-0046","start":46,"end":48,"surface":"賁赫","kind":"person","person_id":"cbr-p005094","status":"contextual_provisional","paragraph_id":"c-shiji-091-qingbu:p020","chapter_id":"c-shiji-091-qingbu"}],"relations":[],"title_holdings":[{"id":"th-shiji091-018","person_id":"cbr-p005094","title":"中大夫","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-091-qingbu","source_id":"s-shiji-091-qingbu","paragraph_id":"c-shiji-091-qingbu:p014","quote":"布所幸姬疾，請就醫，醫家與中大夫賁赫對門，姬數如醫家，賁赫自以為侍中，乃厚餽遺，從姬飲醫家。姬侍王，從容語次，譽赫長者也。王怒曰：「汝安從知之？」具說狀。王疑其與亂。赫恐，稱病。王愈怒，欲捕赫。赫言變事，乘傳詣長安。布使人追，不及。赫至，上變，言布謀反有端，可先未發誅也。上讀其書，語蕭相國。相國曰：「布不宜有此，恐仇怨妄誣之。請擊赫，使人微驗淮南王。」淮南王布見赫以罪亡，上變，固已疑其言國陰事；漢使又來，頗有所驗，遂族赫家，發兵反。反書聞，上乃赦賁赫，以為將軍。"}],"attestations":[{"id":"th-shiji091-018:a001","paragraph_id":"c-shiji-091-qingbu:p014","start":13,"end":16,"surface":"中大夫","person_mention_id":"c-shiji-091-qingbu:m014-0016","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予與用稱分存；常冠軍不作官名，欲為帝不作即帝位，稱病反楚死亡不補官爵終期。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji091-019","person_id":"cbr-p005094","title":"侍中","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-091-qingbu","source_id":"s-shiji-091-qingbu","paragraph_id":"c-shiji-091-qingbu:p014","quote":"布所幸姬疾，請就醫，醫家與中大夫賁赫對門，姬數如醫家，賁赫自以為侍中，乃厚餽遺，從姬飲醫家。姬侍王，從容語次，譽赫長者也。王怒曰：「汝安從知之？」具說狀。王疑其與亂。赫恐，稱病。王愈怒，欲捕赫。赫言變事，乘傳詣長安。布使人追，不及。赫至，上變，言布謀反有端，可先未發誅也。上讀其書，語蕭相國。相國曰：「布不宜有此，恐仇怨妄誣之。請擊赫，使人微驗淮南王。」淮南王布見赫以罪亡，上變，固已疑其言國陰事；漢使又來，頗有所驗，遂族赫家，發兵反。反書聞，上乃赦賁赫，以為將軍。"}],"attestations":[{"id":"th-shiji091-019:a001","paragraph_id":"c-shiji-091-qingbu:p014","start":32,"end":34,"surface":"侍中","person_mention_id":"c-shiji-091-qingbu:m014-0027","usage":"narrati