age":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-091-qingbu","source_id":"s-shiji-091-qingbu","paragraph_id":"c-shiji-091-qingbu:p018","quote":"立皇子長為淮南王，封賁赫為期思侯，諸將率多以功封者。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予與用稱分存；常冠軍不作官名，欲為帝不作即帝位，稱病反楚死亡不補官爵終期。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji091-035","person_id":"cbr-p005094","scope":"same_chapter","chapter_ids":["c-shiji-091-qingbu"],"status":"contextual_provisional","rationale":"按本段明示姓名及局部敘事承接；布與兩王號按英布主線暫接。番君與長沙哀王分候選，所幸姬不與番君女合併；皋陶引古疑問不作祖先定論。","reviewer":"Codex（AI 代理）","surfaces":["賁赫","赫"],"evidence":[{"paragraph_id":"c-shiji-091-qingbu:p014","quote":"布所幸姬疾，請就醫，醫家與中大夫賁赫對門，姬數如醫家，賁赫自以為侍中，乃厚餽遺，從姬飲醫家。姬侍王，從容語次，譽赫長者也。王怒曰：「汝安從知之？」具說狀。王疑其與亂。赫恐，稱病。王愈怒，欲捕赫。赫言變事，乘傳詣長安。布使人追，不及。赫至，上變，言布謀反有端，可先未發誅也。上讀其書，語蕭相國。相國曰：「布不宜有此，恐仇怨妄誣之。請擊赫，使人微驗淮南王。」淮南王布見赫以罪亡，上變，固已疑其言國陰事；漢使又來，頗有所驗，遂族赫家，發兵反。反書聞，上乃赦賁赫，以為將軍。"},{"paragraph_id":"c-shiji-091-qingbu:p018","quote":"立皇子長為淮南王，封賁赫為期思侯，諸將率多以功封者。"},{"paragraph_id":"c-shiji-091-qingbu:p020","quote":"【索隱述贊】九江初筮，當刑而王。既免徒中，聚盜江上。再雄楚卒，頻破秦將。病為羽疑，歸受漢杖。賁赫見毀，卒致無妄。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-091-qingbu:p014","text":"布所幸姬疾，請就醫，醫家與中大夫賁赫對門，姬數如醫家，賁赫自以為侍中，乃厚餽遺，從姬飲醫家。姬侍王，從容語次，譽赫長者也。王怒曰：「汝安從知之？」具說狀。王疑其與亂。赫恐，稱病。王愈怒，欲捕赫。赫言變事，乘傳詣長安。布使人追，不及。赫至，上變，言布謀反有端，可先未發誅也。上讀其書，語蕭相國。相國曰：「布不宜有此，恐仇怨妄誣之。請擊赫，使人微驗淮南王。」淮南王布見赫以罪亡，上變，固已疑其言國陰事；漢使又來，頗有所驗，遂族赫家，發兵反。反書聞，上乃赦賁赫，以為將軍。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-091-qingbu:m014-0000","start":0,"end":1,"surface":"布","kind":"person","person_id":"cbr-p005060","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m014-0010","start":10,"end":12,"surface":"醫家","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未定指代或匿名者保留原文