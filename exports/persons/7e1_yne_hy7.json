policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-055-dingfeng:line130:m0006","start":6,"end":8,"surface":"胡遵","kind":"person","person_id":"7e1_yne_hy7","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-055-dingfeng:line130","chapter_id":"c-sanguozhi-055-dingfeng"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-055-dingfeng:line130","text":"魏遣諸葛誕、胡遵等攻東興，諸葛恪率軍拒之。諸將皆曰：「敵聞太傅自來，上岸必遁走。」奉獨曰：「不然。彼動其境內，悉許、洛兵大舉而來，必有成規，豈虛還哉？無恃敵之不至，恃吾有以勝之。」及恪上岸，奉與將軍唐咨、呂據、留贊等，俱從山西上。奉曰：「今諸軍行遲，若敵據便地，則難與爭鋒矣。」乃辟諸軍使下道，帥麾下三千人徑進。時北風，奉舉帆二日至，遂據徐塘。天寒雪，敵諸將置酒高會，奉見其前部兵少，相謂曰：「取封侯爵賞，正在今日！」乃使兵解鎧著冑，持短兵。敵人從而笑焉，不爲設備。奉縱兵斫之，大破敵前屯。會據等至，魏軍遂潰。遷滅寇將軍，進封都鄉侯。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-055-dingfeng:line130:m0002","start":2,"end":5,"surface":"諸葛誕","kind":"person","person_id":"655_392_7f8","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-055-dingfeng:line130:m0006","start":6,"end":8,"surface":"胡遵","kind":"person","person_id":"7e1_yne_hy7","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-055-dingfeng:line130:m0013","start":13,"end":16,"surface":"諸葛恪","kind":"person","person_id":"512_1cd_a4b","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-055-dingfeng:line130:m0029","start":29,"end":31,"surface":"太傅","kind":"person","person_id":"512_1cd_a4b","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-055-dingfeng:line130:m0041","start":41,"end":42,"surface":"奉","kind":"person","person_id":"nd1_eoc_wrb","status":"contextual_provisional",