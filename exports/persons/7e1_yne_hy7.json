從左右，甚見接待。還為校尉，稍遷徐州刺史，封夏陽子。匈奴中部帥劉猛叛，使驍騎路蕃討之，以奮為監軍、假節，頓軍硜北，為蕃後繼。擊猛，破之，猛帳下將李恪斬猛而降。以功累遷征南將軍、假節、都督荊州諸軍事，遷護軍，加散騎常侍。奮家世將門，晚乃好學，有刀筆之用，所在有聲績，居邊特有威惠。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":39,"last_line":39,"raw_start":2828,"raw_end":3020,"raw_character_offsets":[2828,2829,2830,2831,2832,2833,2834,2835,2836,2837,2838,2839,2840,2841,2842,2843,2844,2845,2846,2847,2848,2849,2850,2851,2852,2853,2854,2855,2856,2857,2858,2859,2860,2861,2862,2863,2864,2865,2866,2867,2868,2869,2870,2871,2872,2873,2874,2875,2876,2877,2878,2879,2880,2881,2882,2883,2884,2885,2886,2887,2888,2889,2890,2891,2892,2893,2894,2895,2896,2897,2898,2899,2900,2901,2902,2903,2904,2905,2906,2907,2908,2909,2910,2911,2912,2913,2914,2915,2916,2917,2918,2919,2920,2921,2922,2923,2924,2925,2926,2927,2928,2929,2930,2931,2932,2933,2934,2935,2936,2937,2938,2939,2940,2941,2942,2943,2944,2945,2946,2947,2948,2949,2950,2951,2952,2953,2954,2955,2956,2957,2958,2959,2960,2961,2962,2963,2964,2965,2966,2967,2968,2969,2970,2971,2972,2973,2974,2975,2976,2977,2978,2979,2980,2981,2982,2983,2984,2985,2986,2987,2988,2989,2990,2991,2992,2993,2994,2995,2996,2997,2998,2999,3000,3001,3002,3003,3004,3005,3006,3007,3008,3009,3010,3011,3012,3013,3014,3015,3016,3017,3018,3019],"revision_id":2413329},"mentions":[{"id":"c-jinshu-057-hu-fen:p001:m0000","surface":"胡奮","start":0,"end":2,"person_id":"z0n_1jd_fda","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-hu-fen:p001:m0004","surface":"玄威","start":4,"end":6,"person_id":"z0n_1jd_fda","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-hu-fen:p001:m0022","surface":"遵","start":22,"end":23,"person_id":"7e1_yne_hy7","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-hu-fen:p001:m0027","surface":"奮","start":27,"end":28,"person_id":"z0n_1jd_fda","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-hu-fen:p001:m0041","surface":"宣帝","start":41,"end":43,"person_id":"dkn_ge4_286_AAAA","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-hu-fen:p001:m0084","surface":"劉猛","start":84,"end":86,"person_id":"229_0iw_k82","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-hu-fen:p001:m0091","surface":"路蕃","start":91,"end":93,"person_id":"put_948_8d4","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-hu-fen:p001:m0097","surface":"奮","start":97,"end":98,"person_id":"z0n_1jd_fda","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-hu-fen:p001:m0125","surface":"李恪","start":125,"end":127,"person_id":"dl2_2vb_2cp","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-hu-fen:p001:m0162","surface":"奮","start":162,"end":163,"person_id":"z0n_1jd_fda","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-057-hu-fen","book_id":"b-jinshu-057","work_id":"w-jinshu","source_id":"s-jinshu-057-hu-fen-ws2413329"},{"id":"c-sanguozhi-055-dingfeng:line130","text":"魏遣諸葛誕、胡遵等攻東興，諸葛恪率軍拒之。諸將皆曰：「敵聞太傅自來，上岸必遁走。」奉獨曰：「不然。彼動其境內，悉許、洛兵大舉而來，必有成規，豈虛還哉？無恃敵之不至，恃吾有以勝之。」及恪上岸，奉與將軍唐咨、呂據、留贊等，俱從山西上。奉曰：「今諸軍行遲，若敵據便地，則難與爭鋒矣。」乃辟諸軍使下道，帥麾下三千人徑進。時北風，奉舉帆二日至，遂據徐塘。天寒雪，敵諸將置酒高會，奉見其前部兵少，相謂曰：「取封侯爵賞，正在今日！」乃使兵解鎧著冑，持短兵。敵人從而笑焉，不爲設備。奉縱兵斫之，大破敵前屯。會據等至，魏軍遂潰。遷滅寇將軍，進封都鄉侯。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-055-dingfeng:line130:m0002","start":2,"end":5,"surface":"諸葛誕","kind":"person","person_id":"655_392_7f8","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-055-dingfeng:line130:m0006","start":6,"end":8,"surface":"胡遵","kind":"person","person_id":"7e1_yne_hy7","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-055-dingfeng:line130:m0013","start":13,"end":16,"surface":"諸葛恪","kind":"person","person_id":"512_1cd_a4b","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-055-dingfeng:line130:m0029","start":29,"end":31,"surface":"太傅","kind":"person","person_i