red","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-wu056-lvfan1","person_id":"gm2_vj1_ai4","event_type":"death","source_term":"梟其大將陳牧","date_expression":null,"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-056","chapter_id":"c-sanguozhi-056-lvfan","source_id":"s-sanguozhi-056-lvfan","paragraph_id":"c-sanguozhi-056-lvfan:line047","quote":"　　是時下邳陳瑀自號吳都太守，住海西，與強族嚴白虎交通。策自將討虎，別遣範與徐逸攻瑀於海西，梟其大將陳牧。又從攻祖郎於陵陽，太史慈於勇裡。七縣平定，拜征虜中郎將，征江夏，還平鄱陽。策薨，奔喪於吳。後權復征江夏，範與張昭留守。曹公至赤壁，與周瑜等俱拒破之，拜裨將軍，領彭澤太守，以彭澤、柴桑、歷陽為奉邑。劉備詣京見權，範密請留備。後遷平南將軍，屯柴桑。","person_mention_id":"c-sanguozhi-056-lvfan:line047:m0050"}],"interpretation_note":"本來源所記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-sanguozhi-056-lvfan:line047:m0050","start":50,"end":52,"surface":"陳牧","kind":"person","person_id":"gm2_vj1_ai4","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-056-lvfan:line047","chapter_id":"c-sanguozhi-056-lvfan"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-056-lvfan:line047","text":"　　是時下邳陳瑀自號吳都太守，住海西，與強族嚴白虎交通。策自將討虎，別遣範與徐逸攻瑀於海西，梟其大將陳牧。又從攻祖郎於陵陽，太史慈於勇裡。七縣平定，拜征虜中郎將，征江夏，還平鄱陽。策薨，奔喪於吳。後權復征江夏，範與張昭留守。曹公至赤壁，與周瑜等俱拒破之，拜裨將軍，領彭澤太守，以彭澤、柴桑、歷陽為奉邑。劉備詣京見權，範密請留備。後遷平南將軍，屯柴桑。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-056-lvfan:line047:m0006","start":6,"end":8,"surface":"陳瑀","kind":"person","person_id":"b88_fje_bm1","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-056-lvfan:line047:m0022","start":22,"end":25,"surface":"嚴白虎","kind":"person","person_id":"t6b_f6t_oin","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"