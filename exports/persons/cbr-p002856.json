63-laohan:m006-0015","start":15,"end":19,"surface":"周太史儋","kind":"person","person_id":"cbr-p003724","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m006-0020","start":20,"end":23,"surface":"秦獻公","kind":"person","person_id":"cbr-p003725","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m006-0053","start":53,"end":54,"surface":"儋","kind":"person","person_id":"cbr-p003724","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m006-0055","start":55,"end":57,"surface":"老子","kind":"person","person_id":"cbr-p003720","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m006-0063","start":63,"end":64,"surface":"世","kind":"unresolved","person_id":null,"status":"unresolved","note":"引例、群體、泛稱、學說或未定指代；不補姓名、成員或肯定史實。"},{"id":"c-shiji-063-laohan:m006-0070","start":70,"end":72,"surface":"老子","kind":"person","person_id":"cbr-p003720","status":"contextual_provisional"}],"chapter_id":"c-shiji-063-laohan","book_id":"b-shiji-063","work_id":"w-shiji","source_id":"s-shiji-063-laohan"},{"id":"c-shiji-063-laohan:p007","text":"老子之子名宗，宗為魏將，封於段干。宗子注，注子宮，宮玄孫假，假仕於漢孝文帝。而假之子解為膠西王卬太傅，因家于齊焉。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-063-laohan:m007-0000","start":0,"end":2,"surface":"老子","kind":"person","person_id":"cbr-p003720","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m007-0005","start":5,"end":6,"surface":"宗","kind":"person","person_id":"cbr-p003726","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m007-0007","start":7,"end":8,"surface":"宗","kind":"person","person_id":"cbr-p003726","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m007-0017","start":17,"end":18,"surface":"宗","kind":"person","person_id":"cbr-p003726","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m007-0019","start":19,"end":20,"surface":"注","kind":"person","person_id":"cbr-p003727","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m007-0021","start":21,"end":22,"surface":"注","kind":"person","person_id":"cbr-p003727","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m007-0023","start":23,"end":24,"surface":"宮","kind":"person","person_id":"cbr-p003728","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m007-0025","start":25,"end":26,"surface":"宮","kind":"person","person_id":"cbr-p003728","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m007-0028","start":28,"end":29,"surface":"假","kind":"person","person_id":"cbr-p003729","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m007-0030","start":30,"end":31,"surface":"假","kind":"person","person_id":"cbr-p003729","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m007-0033","start":33,"end":37,"surface":"漢孝文帝","kind":"person","person_id":"cbr-p003731","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m007-0039","start":39,"end":40,"surface":"假","kind":"person","person_id":"cbr-p003729","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m007-0042","start":42,"end":43,"surface":"解","kind":"person","person_id":"cbr-p003730","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m007-0044","start":44,"end":48,"surface":"膠西王卬","kind":"person","person_id":"cbr-p003732","status":"contextual_provisional"}],"chapter_id":"c-shiji-063-laohan","book_id":"b-shiji-063","work_id":"w-shiji","source_id":"s-shiji-063-laohan"},{"id":"c-shiji-063-laohan:p008","text":"世之學老子者則絀儒學，儒學亦絀老子。「道不同不相為謀」，豈謂是邪？李耳無為自化，清靜自正。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-063-laohan:m008-0003","start":3,"end":5,"surface":"老子","kind":"person","person_id":"cbr-p003720","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m008-0015","start":15,"end":17,"surface":"老子","kind":"person","person_id":"cbr-p003720","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m008-0033","start":33,"end":35,"surface":"李耳","kind":"person","person_id":"cbr-p003720","status":"contextual_provisional"}],"chapter_id":"c-shiji-063-laohan","book_id":"b-shiji-063","work_id":"w-shiji","source_id":"s-shiji-063-laohan"},{"id":"c-shiji-063-laohan:p009","text":"莊子者，蒙人也，名周。周嘗為蒙漆園吏，與梁惠王、齊宣王同時。其學無所不闚，然其要本歸於老子之言。故其著書十餘萬言，大抵率寓言也。作漁父、盜跖、胠篋，以詆訿孔子之徒，以明老子之術。畏累虛、亢桑子之屬，皆空語無事實。然善屬書離辭，指事類情，用剽剝儒、墨，雖當世宿學不能自解免也。其言洸洋自恣以適己，故自王公大人不能器之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-063-laohan:m009-0000","start":0,"end":2,"surface":"莊子","kind":"person","person_id":"cbr-p003733","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m009-0009","start":9,"end":10,"surface":"周","kind":"person","person_id":"cbr-p003733","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m009-0011","start":11,"end":12,"surface":"周","kind":"person","person_id":"cbr-p003733","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m009-0020","start":20,"end":23,"surface":"梁惠王","kind":"person","person_id":"cbr-p003734","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m009-0024","start":24,"end":27,"surface":"齊宣王","kind":"person","person_id":"cbr-p003735","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m009-0043","start":43,"end":45,"surface":"老子","kind":"person","person_id":"cbr-p003720","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m009-0077","start":77,"end":79,"surface":"孔子","kind":"person","person_id":"cbr-p003721","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m009-0084","start":84,"end":86,"surface":"老子","kind":"person","person_id":"cbr-p003720","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m009-0089","start":89,"end":92,"surface":"畏累虛","kind":"unresolved","person_id":null,"status":"unresolved","note":"引例、群體、泛稱、學說或未定指代；不補姓名、成員或肯定史實。"},{"id":"c-shiji-063-laohan:m009-0093","start":93,"end":96,"surface":"亢桑子","kind":"unresolved","person_id":null,"status":"unresolved","note":"引例、群體、泛稱、學說或未定指代；不補姓名、成員或肯定史實。"},{"id":"c-shiji-063-laohan:m009-0121","start":121,"end":124,"surface":"儒、墨","kind":"unresolved","person_id":null,"status":"unresolved","note":"引例、群體、泛稱、學說或未定指代；不補姓名、成員或肯定史實。"},{"id":"c-shiji-063-laohan:m009-0128","start":128,"end":130,"surface":"宿學","kind":"unresolved","person_id":null,"status":"unresolved","note":"引例、群體、泛稱、學說或未定指代；不補姓名、成員或肯定史實。"},{"id":"c-shiji-063-laohan:m009-0149","start":149,"end":153,"surface":"王公大人","kind":"unresolved","person_id":null,"status":"unresolved","note":"引例、群體、泛稱、學說或未定指代；不補姓名、成員或肯定史實。"}],"chapter_id":"c-shiji-063-laohan","book_id":"b-shiji-063","work_id":"w-shiji","source_id":"s-shiji-063-laohan"},{"id":"c-shiji-063-laohan:p026","text":"太史公曰：老子所貴道，虛無，因應變化於無為，故著書辭稱微妙難識。莊子散道德，放論，要亦歸之自然。申子卑卑，施之於名實。韓子引繩墨，切事情，明是非，其極慘礉少恩。皆原於道德之意，而老子深遠矣。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-063-laohan:m026-0000","start":0,"end":3,"surface":"太史公","kind":"person","person_id":"cbr-p003752","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m026-0005","start":5,"end":7,"surface":"老子","kind":"person","person_id":"cbr-p003720","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m026-0032","start":32,"end":34,"surface":"莊子","kind":"person","person_id":"cbr-p003733","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m026-0048","start":48,"end":50,"surface":"申子","kind":"person","person_id":"cbr-p003737","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m026-0059","start":59,"end":61,"surface":"韓子","kind":"person","person_id":"cbr-p003739","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m026-0089","start":89,"end":91,"surface":"老子","kind":"person","person_id":"cbr-p003720","status":"contextual_provisional"}],"chapter_id":"c-shiji-063-laohan","book_id":"b-shiji-063","work_id":"w-shiji","source_id":"s-shiji-063-laohan"}],"sources":[{"chapter_id":"c-shiji-047-kong","work_id":"w-shiji","book_id":"b-shiji-047","source_id":"s-shiji-047-kong","source":{"title":"史記／卷047","provider":"維基文庫","url":"