n:p008","chapter_id":"c-shiji-063-laohan"},{"id":"c-shiji-063-laohan:m008-0015","start":15,"end":17,"surface":"老子","kind":"person","person_id":"cbr-p003720","status":"contextual_provisional","paragraph_id":"c-shiji-063-laohan:p008","chapter_id":"c-shiji-063-laohan"},{"id":"c-shiji-063-laohan:m008-0033","start":33,"end":35,"surface":"李耳","kind":"person","person_id":"cbr-p003720","status":"contextual_provisional","paragraph_id":"c-shiji-063-laohan:p008","chapter_id":"c-shiji-063-laohan"},{"id":"c-shiji-063-laohan:m009-0043","start":43,"end":45,"surface":"老子","kind":"person","person_id":"cbr-p003720","status":"contextual_provisional","paragraph_id":"c-shiji-063-laohan:p009","chapter_id":"c-shiji-063-laohan"},{"id":"c-shiji-063-laohan:m009-0084","start":84,"end":86,"surface":"老子","kind":"person","person_id":"cbr-p003720","status":"contextual_provisional","paragraph_id":"c-shiji-063-laohan:p009","chapter_id":"c-shiji-063-laohan"},{"id":"c-shiji-063-laohan:m026-0005","start":5,"end":7,"surface":"老子","kind":"person","person_id":"cbr-p003720","status":"contextual_provisional","paragraph_id":"c-shiji-063-laohan:p026","chapter_id":"c-shiji-063-laohan"},{"id":"c-shiji-063-laohan:m026-0089","start":89,"end":91,"surface":"老子","kind":"person","person_id":"cbr-p003720","status":"contextual_provisional","paragraph_id":"c-shiji-063-laohan:p026","chapter_id":"c-shiji-063-laohan"}],"relations":[{"id":"a-shiji063-001","subject_person_id":"cbr-p003726","predicate":"father","object_person_id":"cbr-p003720","status":"source_attested","evidence":[{"chapter_id":"c-shiji-063-laohan","source_id":"s-shiji-063-laohan","paragraph_id":"c-shiji-063-laohan:p007","quote":"老子之子名宗，宗為魏將，封於段干。宗子注，注子宮，宮玄孫假，假仕於漢孝文帝。而假之子解為膠西王卬太傅，因家于齊焉。"}],"qualifiers":{"source_term":"老子之子名宗","historicity":"historical_tradition"},"interpretation_note":"按子、玄孫及母明文保存。宮玄孫假只記祖先及原文闕代，不補直接父子；說難引例中的關係保留引文敘事範圍，不作獨立史實確證，未名者不補姓名。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji063-001","person_id":"cbr-p003720","title":"周守藏室之史","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-063-laohan","source_id":"s-shiji-063-laohan","paragraph_id":"c-shiji-063-laohan:p001","quote":"老子者，楚苦縣厲鄉曲仁里人也，姓李氏，名耳，字耼，周守藏室之史也。"}],"attestations":[{"id":"th-shiji063-001:a001","paragraph_id":"c-shiji-063-laohan:p001","start":25,"end":31,"surface":"周守藏室之史","person_mention_id":"c-shiji-063-laohan:m001-0023","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"依來源用稱保存，公號與帝稱不當生前已授同字諡稱；引例保留敘事範圍，不據首次用稱或死亡補任期。制度未定用稱保留未分類。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji047-034","person_id":"cbr-p002856","surfaces":["老子"],"scope":"same_chapter","chapter_ids":["c-shiji-047-kong"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-047-kong:p006","quote":"魯南宮敬叔言魯君曰：「請與孔子適周。」魯君與之一乘車，兩馬，一豎子俱，適周問禮，蓋見老子云。辭去，而老子送之曰：「吾聞富貴者送人以財，仁人者送人以言。吾不能富貴，竊仁人之號，送子以言，曰：『聰明深察而近於死者，好議人者也。博辯廣大危其身者，發人之惡者也。為人子者毋以有己，為人臣者毋以有己。』」孔子自周反于魯，弟子稍益進焉。"}],"rationale":"限本篇明示名、字、對話自稱、世系及附贊局部對應；世系求與冉求分開，武不接漢武帝，今皇帝與高皇帝不補姓名。子路仲由明示同指另存，冉有冉求與秦繆秦穆仍待核；附贊不當獨立作者正文或獨立見證。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji063-001","person_id":"cbr-p003720","surfaces":["李耳","老子","耳","耼"],"scope":"same_chapter","chapter_ids":["c-shiji-063-laohan"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-063-laohan:p001","quote":"老子者，楚苦縣厲鄉曲仁里人也，姓李氏，名耳，字耼，周守藏室之史也。"},{"paragraph_id":"c-shiji-063-laohan:p002","quote":"孔子適周，將問禮於老子。老子曰：「子所言者，其人與骨皆已朽矣，獨其言在耳。且君子得其時則駕，不得其時則蓬累而行。吾聞之，良賈深藏若虛，君子盛德容貌若愚。去子之驕氣與多欲，態色與淫志，是皆無益於子之身。吾所以告子，若是而已。」孔子去，謂弟子曰：「鳥，吾知其能飛；魚，吾知其能游；獸，吾知其能走。走者可以為罔，游者可以為綸，飛者可以為矰。至於龍，吾不能知其乘風雲而上天。吾今日見老子，其猶龍邪！」"},{"paragraph_id":"c-shiji-063-laohan:p003","quote":"老子修道德，其學以自隱無名為務。居周久之，見周之衰，乃遂去。至關，關令尹喜曰：「子將隱矣，彊為我著書。」於是老子乃著書上下篇，言道德之意五千餘言而去，莫知其所終。"},{"paragraph_id":"c-shiji-063-laohan:p005","quote":"蓋老子百有六十餘歲，或言二百餘歲，以其修道而養壽也。"},{"paragraph_id":"c-shiji-063-laohan:p006","quote":"自孔子死之後百二十九年，而史記周太史儋見秦獻公曰：「始秦與周合，合五百歲而離，離七十歲而霸王者出焉。」或曰儋即老子，或曰非也，世莫知其然否。老子，隱君子也。"},{"paragraph_id":"c-shiji-063-laohan:p008","quote":"世之學老子者則絀儒學，儒學亦絀老子。「道不同不相為謀」，豈謂是邪？李耳無為自化，清靜自正。"},{"paragraph_id":"c-shiji-063-laohan:p009","quote":"莊子者，蒙人也，名周。周嘗為蒙漆園吏，與梁惠王、齊宣王同時。其學無所不闚，然其要本歸於老子之言。故其著書十餘萬言，大抵率寓言也。作漁父、盜跖、胠篋，以詆訿孔子之徒，以明老子之術。畏累虛、亢桑子之屬，皆空語無事實。然善屬書離辭，指事類情，用剽剝儒、墨，雖當世宿學不能自解免也。其言洸洋自恣以適己，故自王公大人不能器之。"},{"paragraph_id":"c-shiji-063-laohan:p026","quote":"太史公曰：老子所貴道，虛無，因應變化於無為，故著書辭稱微妙難識。莊子散道德，放論，要亦歸之自然。申子卑卑，施之於名實。韓子引繩墨，切事情，明是非，其極慘礉少恩。皆原於道德之意，而老子深遠矣。"},{"paragraph_id":"c-shiji-063-laohan:p007","quote":"老子之子名宗，宗為魏將，封於段干。宗子注，注子宮，宮玄孫假，假仕於漢孝文帝。而假之子解為膠西王卬太傅，因家于齊焉。"}],"rationale":"依開篇姓名與敘事局部短稱暫接，未名引例人物不補名。老萊子及太史儋與老子分候選不表示確定不同，書名與否定非字不當人物提及，故事與身份確證分開。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji063-lao","person_ids":["cbr-p002856","cbr-p003720"],"canonical_person_id":"cbr-p002856","scope":"cross_chapter","chapter_ids":["c-shiji-047-kong","c-shiji-063-laohan"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-047-kong","source_id":"s-shiji-047-kong","paragraph_id":"c-shiji-047-kong:p006","quote":"魯南宮敬叔言魯君曰：「請與孔子適周。」魯君與之一乘車，兩馬，一豎子俱，適周問禮，蓋見老子云。辭去，而老子送之曰：「吾聞富貴者送人以財，仁人者送人以言。吾不能富貴，竊仁人之號，送子以言，曰：『聰明深察而近於死者，好議人者也。博辯廣大危其身者，發人之惡者也。為人子者毋以有己，為人臣者毋以有己。』」孔子自周反于魯，弟子稍益進焉。","mention_ids":["c-shiji-047-kong:m006-0042","c-shiji-047-kong:m006-0050"]},{"chapter_id":"c-shiji-063-laohan","source_id":"s-shiji-063-laohan","paragraph_id":"c-shiji-063-laohan:p002","quote":"孔子適周，將問禮於老子。老子曰：「子所言者，其人與骨皆已朽矣，獨其言在耳。且君子得其時則駕，不得其時則蓬累而行。吾聞之，良賈深藏若虛，君子盛德容貌若愚。去子之驕氣與多欲，態色與淫志，是皆無益於子之身。吾所以告子，若是而已。」孔子去，謂弟子曰：「鳥，吾知其能飛；魚，吾知其能游；獸，吾知其能走。走者可以為罔，游者可以為綸，飛者可以為矰。至於龍，吾不能知其乘風雲而上天。吾今日見老子，其猶龍邪！」","mention_ids":["c-shiji-063-laohan:m002-0009","c-shiji-063-laohan:m002-0012","c-shiji-063-laohan:m002-0187"]}],"rationale":"兩篇同記孔子適周問禮見老子，敘事人物及事件相配；本篇老萊子與儋的身份爭議不隨之判定。 已發ID與原文保留，同書不同篇不當獨立見證；身份暫接不等於史實、年表或來源優先已定。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-047-kong:p006","text":"魯南宮敬叔言魯君曰：「請與孔子適周。」魯君與之一乘車，兩馬，一豎子俱，適周問禮，蓋見老子云。辭去，而老子送之曰：「吾聞富貴者送人以財，仁人者送人以言。吾不能富貴，竊仁人之號，送子以言，曰：『聰明深察而近於死者，好議人者也。博辯廣大危其身者，發人之惡者也。為人子者毋以有己，為人臣者毋以有己。』」孔子自周反于魯，弟子稍益進焉。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-047-kong:m006-0001","start":1,"end":5,"surface":"南宮敬叔","kind":"person","person_id":"cbr-p002831","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m006-0006","start":6,"end":8,"surface":"魯君","kind":"person","person_id":"cbr-p002857","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m006-0013","start":13,"end":15,"surface":"孔子","kind":"person","person_id":"cbr-p002851","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m006-0019","start":19,"end":21,"surface":"魯君","kind":"person","person_id":"cbr-p002857","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m006-0030","start":30,"end":33,"surface":"一豎子","kind":"unresolved","person_id":null,"status":"unresolved","note":"宗族、群體、神怪、官稱或說話對象未定，不補成員姓名及親屬。"},{"id":"c-shiji-047-kong:m006-0042","start":42,"end":44,"surface":"老子","kind":"person","person_id":"cbr-p002856","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m006-0050","start":50,"end":52,"surface":"老子","kind":"person","person_id":"cbr-p002856","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m006-0147","start":147,"end":149,"surface":"孔子","kind":"person","person_id":"cbr-p002851","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m006-0155","start":155,"end":157,"surface":"弟子","kind":"unresolved","person_id":null,"status":"unresolved","note":"宗族、群體、神怪、官稱或說話對象未定，不補成員姓名及親屬。"}],"chapter_id":"c-shiji-047-kong","book_id":"b-shiji-047","work_id":"w-shiji","source_id":"s-shiji-047-kong"},{"id":"c-shiji-063-laohan:p001","text":"老子者，楚苦縣厲鄉曲仁里人也，姓李氏，名耳，字耼，周守藏室之史也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"i