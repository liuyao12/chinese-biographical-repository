erson_id":"fu8_kck_4vb","status":"contextual_provisional"}],"chapter_id":"c-shiji-070-zhang","book_id":"b-shiji-070","work_id":"w-shiji","source_id":"s-shiji-070-zhang"},{"id":"c-shiji-070-zhang:p052","text":"陳軫者，游說之士。與張儀俱事秦惠王，皆貴重，爭寵。張儀惡陳軫於秦王曰：「軫重幣輕使秦楚之閒，將為國交也。今楚不加善於秦而善軫者，軫自為厚而為王薄也。且軫欲去秦而之楚，王胡不聽乎？」王謂陳軫曰：「吾聞子欲去秦之楚，有之乎？」軫曰：「然。」王曰：「儀之言果信矣。」軫曰：「非獨儀知之也，行道之士盡知之矣。昔子胥忠於其君而天下爭以為臣，曾參孝於其親而天下願以為子。故賣僕妾不出閭巷而售者，良僕妾也；出婦嫁於鄉曲者，良婦也。今軫不忠其君，楚亦何以軫為忠乎？忠且見棄，軫不之楚何歸乎？」王以其言為然，遂善待之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-070-zhang:m052-0000","start":0,"end":2,"surface":"陳軫","kind":"person","person_id":"bvi_h86_vk1","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m052-0010","start":10,"end":12,"surface":"張儀","kind":"person","person_id":"5an_r55_hee","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m052-0014","start":14,"end":17,"surface":"秦惠王","kind":"person","person_id":"x9j_eu1_vck","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m052-0025","start":25,"end":27,"surface":"張儀","kind":"person","person_id":"5an_r55_hee","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m052-0028","start":28,"end":30,"surface":"陳軫","kind":"person","person_id":"bvi_h86_vk1","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m052-0031","start":31,"end":33,"surface":"秦王","kind":"person","person_id":"x9j_eu1_vck","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m052-0036","start":36,"end":37,"surface":"軫","kind":"person","person_id":"bvi_h86_vk1","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m052-0061","start":61,"end":62,"surface":"軫","kind":"person","person_id":"bvi_h86_vk1","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m052-0064","start":64,"end":65,"surface":"軫","kind":"person","person_id":"bvi_h86_vk1","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m052-0070","start":70,"end":71,"surface":"王","kind":"person","person_id":"x9j_eu1_vck","status