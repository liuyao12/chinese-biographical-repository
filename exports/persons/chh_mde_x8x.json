pter_id":"c-shiji-042-zheng"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji042-025","person_id":"chh_mde_x8x","surfaces":["公子馮","馮"],"scope":"same_chapter","chapter_ids":["c-shiji-042-zheng"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-042-zheng:p005","quote":"二十四年，宋繆公卒，公子馮奔鄭。鄭侵周地，取禾。二十五年，衞州吁弒其君桓公自立，與宋伐鄭，以馮故也。二十七年，始朝周桓王。桓王怒其取禾，弗禮也。二十九年，莊公怒周弗禮，與魯易祊、許田。三十三年，宋殺孔父。三十七年，莊公不朝周，周桓王率陳、蔡、虢、衞伐鄭。莊公與祭仲、髙渠彌發兵自救，王師大敗。祝聸射中王臂。祝聸請從之，鄭伯止之，曰：「犯長且難之，況敢陵天子乎？」乃止。夜令祭仲問王疾。"}],"rationale":"依本篇名字、是為、世系及連續事件暫接異稱；同諡不同國分開，建子勝與聲公勝不合併，如兄弟為譬喻不作親屬。述贊與正文不算獨立來源，省稱、古字與校勘仍待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-042-zheng:p005","text":"二十四年，宋繆公卒，公子馮奔鄭。鄭侵周地，取禾。二十五年，衞州吁弒其君桓公自立，與宋伐鄭，以馮故也。二十七年，始朝周桓王。桓王怒其取禾，弗禮也。二十九年，莊公怒周弗禮，與魯易祊、許田。三十三年，宋殺孔父。三十七年，莊公不朝周，周桓王率陳、蔡、虢、衞伐鄭。莊公與祭仲、髙渠彌發兵自救，王師大敗。祝聸射中王臂。祝聸請從之，鄭伯止之，曰：「犯長且難之，況敢陵天子乎？」乃止。夜令祭仲問王疾。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-042-zheng:m005-0005","start":5,"end":8,"surface":"宋繆公","kind":"person","person_id":"isl_ylr_h73","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m005-0010","start":10,"end":13,"surface":"公子馮","kind":"person","person_id":"chh_mde_x8x","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m005-0029","start":29,"end":32,"surface":"衞州吁","kind":"person","person_id":"nqv_ba2_zh4","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m005-0033","start":33,"end":37,"surface":"其君桓公","kind":"person","person_id":"pwu_2l0_l7l","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m005-0046","start":46,"end":47,"surface":"馮","kind":"person","person_id":"chh_mde_x8x","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m005-0057","start":57,"end":60,"surface":"周桓王","kind":"person","person_id":"y81_o3y_nw3","status":"contextual_provisional"}