],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-050-quan:line050","text":"孫亮全夫人，全尚女也。（尚）從祖母公主愛之，每進見輒與俱。及潘夫人母子有寵，全主自以與孫和母有隙，乃勸權為潘氏男亮納夫人，亮遂為嗣。夫人立為皇后，以尚為城門校尉，封都亭侯，代滕胤為太常、衛將軍，進封永平侯，錄尚書事。時全氏侯有五人，並典兵馬。其餘為侍郎、騎都尉，宿衛左右，自吳興，外戚貴盛莫及。及魏大將諸葛誕以壽春來附，而全懌、全端、全禕、全儀等並因此際降魏。全熙謀洩見殺，由是諸全衰弱。會孫綝廢亮為會稽王，後又黜為候官侯。夫人隨之國，居候官，尚將家屬徙零陵，追見殺。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-050-quan:line050:m0001","start":1,"end":2,"surface":"亮","kind":"person","person_id":"hqp_o1w_ihy","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-quan:line050:m0002","start":2,"end":5,"surface":"全夫人","kind":"person","person_id":"vl3_bta_0h1_A","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-quan:line050:m0007","start":7,"end":8,"surface":"尚","kind":"person","person_id":"vl3_bta_0h1","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-quan:line050:m0012","start":12,"end":13,"surface":"尚","kind":"person","person_id":"vl3_bta_0h1","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-quan:line050:m0017","start":17,"end":19,"surface":"公主","kind":"person","person_id":"xpt_euv_2zx","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-quan:line050:m0030","start":30,"end":33,"surface":"潘夫人","kind":"person","person_id":"21k_qde_yg6","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-quan:line050:m0038","start":38,"end":40,"surface":"全主","kind":"person","person_id":"xpt_euv_2zx","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-quan:line050:m0043","start":43,"end":45,"surface":"孫和","kind":"person","person_id":"572_278_cba_A","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-