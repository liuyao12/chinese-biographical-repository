amily_paths":[],"mentions":[{"id":"c-shiji-092-hanxin:m014-0166","start":166,"end":170,"surface":"齊王田廣","kind":"person","person_id":"2sg_8ra_hq5","status":"contextual_provisional","paragraph_id":"c-shiji-092-hanxin:p014","chapter_id":"c-shiji-092-hanxin"},{"id":"c-shiji-092-hanxin:m014-0202","start":202,"end":203,"surface":"廣","kind":"person","person_id":"2sg_8ra_hq5","status":"contextual_provisional","paragraph_id":"c-shiji-092-hanxin:p014","chapter_id":"c-shiji-092-hanxin"},{"id":"c-shiji-092-hanxin:m015-0000","start":0,"end":3,"surface":"齊王廣","kind":"person","person_id":"2sg_8ra_hq5","status":"contextual_provisional","paragraph_id":"c-shiji-092-hanxin:p015","chapter_id":"c-shiji-092-hanxin"},{"id":"c-shiji-092-hanxin:m015-0262","start":262,"end":265,"surface":"齊王廣","kind":"person","person_id":"2sg_8ra_hq5","status":"contextual_provisional","paragraph_id":"c-shiji-092-hanxin:p015","chapter_id":"c-shiji-092-hanxin"},{"id":"c-shiji-097-luli:m005-0324","start":324,"end":326,"surface":"田廣","kind":"person","person_id":"tj9_mpe_fwt","status":"contextual_provisional","paragraph_id":"c-shiji-097-luli:p005","chapter_id":"c-shiji-097-luli"},{"id":"c-shiji-097-luli:m005-0390","start":390,"end":392,"surface":"齊王","kind":"person","person_id":"tj9_mpe_fwt","status":"contextual_provisional","paragraph_id":"c-shiji-097-luli:p005","chapter_id":"c-shiji-097-luli"},{"id":"c-shiji-097-luli:m006-0015","start":15,"end":17,"surface":"齊王","kind":"person","person_id":"tj9_mpe_fwt","status":"contextual_provisional","paragraph_id":"c-shiji-097-luli:p006","chapter_id":"c-shiji-097-luli"},{"id":"c-shiji-097-luli:m006-0078","start":78,"end":80,"surface":"齊王","kind":"person","person_id":"tj9_mpe_fwt","status":"contextual_provisional","paragraph_id":"c-shiji-097-luli:p006","chapter_id":"c-shiji-097-luli"},{"id":"c-shiji-097-luli:m006-0483","start":483,"end":485,"surface":"田廣","kind":"person","person_id":"tj9_mpe_fwt","status":"contextual_provisional","paragraph_id":"c-shiji-097-luli:p006","chapter_id":"c-shiji-097-luli"},{"id":"c-shiji-097-luli:m007-0024","start":24,"end":26,"surface":"齊王","kind":"person","person_id":"tj9_mpe_fwt","status":"contextual_provisional","paragraph_id":"c-shiji-097-luli:p007","chapter_id":"c-shiji-097-luli"},{"id":"c-shiji-097-luli:m007-0026","start":26,"end":28,"surface":"田廣","kind":"person","person_id":"tj9_mpe_fwt","status":"contextual_provisional","paragraph_id":"c-shiji-097-luli:p007","chapter_id":"c-shiji-097-luli"},{"id":"c-shiji-097-luli:m007-0090","start":90,"end":92,"surface":"齊王","kind":"person","person_id":"tj9_mpe_fwt","status":"contextual_provisional","paragraph_id":"c-shiji-097-luli:p007","chapter_id":"c-shiji-097-luli"}],"relations":[],"title_holdings":[{"id":"th-shiji092-016","person_id":"2sg_8ra_hq5","title":"齊王","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-092-hanxin","source_id":"s-shiji-092-hanxin","paragraph_id":"c-shiji-092-hanxin:p014","quote":"信引兵東，未渡平原，聞漢王使酈食其已說下齊，韓信欲止。范陽辯士蒯通說信曰：『將軍受詔擊齊，而漢獨發閒使下齊，寧有詔止將軍乎？何以得毋行也！且酈生一士，伏軾掉三寸之舌，下齊七十餘城，將軍將數萬眾，歲餘乃下趙五十餘，爲將數歲，反不如一豎儒之功乎？』於是信然之，從其計，遂渡河。齊已聽酈生，即留縱酒，罷備漢守御。信因襲齊歷下軍，遂至臨菑。齊王田廣以酈生賣己，乃亨之，而走髙密，使使之楚請救。韓信已定臨菑，遂東追廣至髙密西。楚亦使龍且將，號稱二十萬，救齊。"}],"attestations":[{"id":"th-shiji092-016:a001","paragraph_id":"c-shiji-092-hanxin:p014","start":166,"end":168,"surface":"齊王","person_mention_id":"c-shiji-092-hanxin:m014-0166","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予與用稱分存；假王請求不作已授，稱病被捕死亡不自動補任期終點。連敖依頁面註記保留改字前形，不宣稱已核底本。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji092-013","person_id":"2sg_8ra_hq5","scope":"same_chapter","chapter_ids":["c-shiji-092-hanxin"],"status":"contextual_provisional","rationale":"按明示姓名及局部事件承接；王號限敘事主體，酈食其酈生及蒯通蒯生暫接，未名者與引古人物各存。不補邯欣翳及周召等短稱完整姓名。","reviewer":"Codex（AI 代理）","surfaces":["廣","齊王廣","齊王田廣"],"evidence":[{"paragraph_id":"c-shiji-092-hanxin:p014","quote":"信引兵東，未渡平原，聞漢王使酈食其已說下齊，韓信欲止。范陽辯士蒯通說信曰：『將軍受詔擊齊，而漢獨發閒使下齊，寧有詔止將軍乎？何以得毋行也！且酈生一士，伏軾掉三寸之舌，下齊七十餘城，將軍將數萬眾，歲餘乃下趙五十餘，爲將數歲，反不如一豎儒之功乎？』於是信然之，從其計，遂渡河。齊已聽酈生，即留縱酒，罷備漢守御。信因襲齊歷下軍，遂至臨菑。齊王田廣以酈生賣己，乃亨之，而走髙密，使使之楚請救。韓信已定臨菑，遂東追廣至髙密西。楚亦使龍且將，號稱二十萬，救齊。"},{"paragraph_id":"c-shiji-092-hanxin:p015","quote":"齊王廣、龍且并軍與信戰，未合。人或說龍且曰：『漢兵遠鬬窮戰，其鋒不可當。齊、楚自居其地戰，兵易敗散。不如深壁，令齊王使其信臣招所亡城，亡城聞其王在，楚來救，必反漢。漢兵二千里客居，齊城皆反之，其勢無所得食，可無戰而降也。』龍且曰：『吾平生知韓信爲人，易與耳。且夫救齊不戰而降之，吾何功？今戰而勝之，齊之半可得，何爲止！』遂戰，與信夾濰水陳。韓信乃夜令人爲萬餘囊，滿盛沙，壅水上流，引軍半渡，擊龍且，詳不勝，還走。龍且果喜曰：『固知信怯也。』遂追信渡水。信使人決壅囊，水大至。龍且軍大半不得渡，即急擊，殺龍且。龍且水東軍散走，齊王廣亡去。信遂追北至城陽，皆虜楚卒。"}]},{"id":"d-shiji097-009","person_id":"tj9_mpe_fwt","surfaces":["田廣","齊王"],"scope":"same_chapter","chapter_ids":["c-shiji-097-luli"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-097-luli:p005","quote":"漢三年秋，項羽擊漢，拔滎陽，漢兵遁保鞏、洛。楚人聞淮陰侯破趙，彭越數反梁地，則分兵救之。淮陰方東擊齊，漢王數困滎陽、成皋，計欲捐成皋以東，屯鞏、洛以拒楚。酈生因曰：「臣聞知天之天者，王事可成；不知天之天者，王事不可成。王者以民人為天，而民人以食為天。夫敖倉，天下轉輸久矣，臣聞其下乃有藏粟甚多。楚人拔滎陽，不堅守敖倉，乃引而東，令適卒分守成皋，此乃天所以資漢也。方今楚易取而漢反卻，自奪其便，臣竊以為過矣。且兩雄不俱立，楚漢久相持不決，百姓騷動，海內搖蕩，農夫釋耒，工女下機，天下之心未有所定也。願足下急復進兵，收取滎陽，據敖倉之粟，塞成皋之險，杜大行之道，距蜚狐之口，守白馬之津，以示諸侯效實形制之勢，則天下知所歸矣。方今燕、趙已定，唯齊未下。今田廣據千里之齊，田閒將二十萬之眾，軍於歷城，諸田宗彊，負海阻河濟，南近楚，人多變詐，足下雖遣數十萬師，未可以歲月破也。臣請得奉明詔說齊王，使為漢而稱東藩。」上曰：「善。」"},{"paragraph_id":"c-shiji-097-luli:p006","quote":"乃從其畫，復守敖倉，而使酈生說齊王曰：「王知天下之所歸乎？」王曰：「不知也。」曰：「王知天下之所歸，則齊國可得而有也；若不知天下之所歸，即齊國未可得保也。」齊王曰：「天下何所歸？」曰：「歸漢。」曰：「先生何以言之？」曰：「漢王與項王力西面擊秦，約先入咸陽者王之。漢王先入咸陽，項王負約不與而王之漢中。項王遷殺義帝，漢王聞之，起蜀漢之兵擊三秦，出關而責義帝之處，收天下之兵，立諸侯之後。降城即以侯其將，得賂即以分其士，與天下同其利，豪英賢才皆樂為之用。諸侯之兵四面而至，蜀漢之粟方船而下。項王有倍約之名，殺義帝之負；於人之功無所記，於人之罪無所忘；戰勝而不得其賞，拔城而不得其封；非項氏莫得用事；為人刻印，刓而不能授；攻城得賂，積而不能賞：天下畔之，賢才怨之，而莫為之用。故天下之士歸於漢王，可坐而策也。夫漢王發蜀漢，定三秦；涉西河之外，援上黨之兵；下井陘，誅成安君；破北魏，舉三十二城：此蚩尤之兵也，非人之力也，天之福也。今已據敖倉之粟，塞成皋之險，守白馬之津，杜大行之阪，距蜚狐之口，天下後服者先亡矣。王疾先下漢王，齊國社稷可得而保也；不下漢王，危亡可立而待也。」田廣以為然，乃聽酈生，罷歷下兵守戰備，與酈生日縱酒。"},{"paragraph_id":"c-shiji-097-luli:p007","quote":"淮陰侯聞酈生伏軾下齊七十餘城，乃夜度兵平原襲齊。齊王田廣聞漢兵至，以為酈生賣己，乃曰：「汝能止漢軍，我活汝；不然，我將亨汝！」酈生曰：「舉大事不細謹，盛德不辭讓。而公不為若更言！」齊王遂亨酈生，引兵東走。"}],"rationale":"按酈生、陸賈與朱建分傳及敘事承接限定異稱；尉他尉佗原字分存。平原君據明示朱建另候選；朱建兩處未名子尚不合併，淮陰侯與單稱韓信跨篇同指待證。引語古王及神話人物與當事人分開。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji097-guang","person_ids":["2sg_8ra_hq5","tj9_mpe_fwt"],"canonical_person_id":"2sg_8ra_hq5","scope":"cross_chapter","chapter_ids":["c-shiji-092-hanxin","c-shiji-097-luli"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-092-hanxin","source_id":"s-shiji-092-hanxin","paragraph_id":"c-shiji-092-hanxin:p014","quote":"信引兵東，未渡平原，聞漢王使酈食其已說下齊，韓信欲止。范陽辯士蒯通說信曰：『將軍受詔擊齊，而漢獨發閒使下齊，寧有詔止將軍乎？何以得毋行也！且酈生一士，伏軾掉三寸之舌，下齊七十餘城，將軍將數萬眾，歲餘乃下趙五十餘，爲將數歲，反不如一豎儒之功乎？』於是信然之，從其計，遂渡河。齊已聽酈生，即留縱酒，罷備漢守御。信因襲齊歷下軍，遂至臨菑。齊王田廣以酈生賣己，乃亨之，而走髙密，使使之楚請救。韓信已定臨菑，遂東追廣至髙密西。楚亦使龍且將，號稱二十萬，救齊。","mention_ids":["c-shiji-092-hanxin:m014-0166","c-shiji-092-hanxin:m014-0202"]},{"chapter_id":"c-shiji-097-luli","source_id":"s-shiji-097-luli","paragraph_id":"c-shiji-097-luli:p007","quote":"淮陰侯聞酈生伏軾下齊七十餘城，乃夜度兵平原襲齊。齊王田廣聞漢兵至，以為酈生賣己，乃曰：「汝能止漢軍，我活汝；不然，我將亨汝！」酈生曰：「舉大事不細謹，盛德不辭讓。而公不為若更言！」齊王遂亨酈生，引兵東走。","mention_ids":["c-shiji-097-luli:m007-0024","c-shiji-097-luli:m007-0026","c-shiji-097-luli:m007-0090"]}],"rationale":"齊王田廣聽酈生罷守、漢軍襲齊後疑其賣己而亨之、向東亡走，同一姓名王號及事件相配；亨原字分存。 各篇原字、原文與已發ID保留，同書不視為獨立見證；同指不確證所有紀年、任職、親屬或敘事，不按全域同名批量改號。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-092-hanxin:p014","text":"信引兵東，未渡平原，聞漢王使酈食其已說下齊，韓信欲止。范陽辯士蒯通說信曰：『將軍受詔擊齊，而漢獨發閒使下齊，寧有詔止將軍乎？何以得毋行也！且酈生一士，伏軾掉三寸之舌，下齊七十餘城，將軍將數萬眾，歲餘乃下趙五十餘，爲將數歲，反不如一豎儒之功乎？』於是信然之，從其計，遂渡河。齊已聽酈生，即留縱酒，罷備漢守御。信因襲齊歷下軍，遂至臨菑。齊王田廣以酈生賣己，乃亨之，而走髙密，使使之楚請救。韓信已定臨菑，遂東追廣至髙密西。楚亦使龍且將，號稱二十萬，救齊。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-092-hanxin:m014-0000","start":0,"end":1,"surface":"信","kind":"person","person_id":"v8v_2nz_wdy","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m014-0011","start":11,"end":13,"surface":"漢王","kind":"person","person_id":"cz8_no4_4jl","status":