{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p005109","identity_policy":"contextual_provisional","person_ids":["cbr-p005109"],"persons":[{"id":"cbr-p005109","label":"田廣（淮陰侯列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"齊王田廣","mention_ids":["c-shiji-092-hanxin:m014-0166"]},{"surface":"廣","mention_ids":["c-shiji-092-hanxin:m014-0202"]},{"surface":"齊王廣","mention_ids":["c-shiji-092-hanxin:m015-0000","c-shiji-092-hanxin:m015-0262"]}],"evidence":[{"mention_id":"c-shiji-092-hanxin:m014-0166","chapter_id":"c-shiji-092-hanxin","paragraph_id":"c-shiji-092-hanxin:p014","quote":"齊王田廣"},{"mention_id":"c-shiji-092-hanxin:m014-0202","chapter_id":"c-shiji-092-hanxin","paragraph_id":"c-shiji-092-hanxin:p014","quote":"廣"},{"mention_id":"c-shiji-092-hanxin:m015-0000","chapter_id":"c-shiji-092-hanxin","paragraph_id":"c-shiji-092-hanxin:p015","quote":"齊王廣"},{"mention_id":"c-shiji-092-hanxin:m015-0262","chapter_id":"c-shiji-092-hanxin","paragraph_id":"c-shiji-092-hanxin:p015","quote":"齊王廣"}]}],"mentions":[{"id":"c-shiji-092-hanxin:m014-0166","start":166,"end":170,"surface":"齊王田廣","kind":"person","person_id":"cbr-p005109","status":"contextual_provisional","paragraph_id":"c-shiji-092-hanxin:p014","chapter_id":"c-shiji-092-hanxin"},{"id":"c-shiji-092-hanxin:m014-0202","start":202,"end":203,"surface":"廣","kind":"person","person_id":"cbr-p005109","status":"contextual_provisional","paragraph_id":"c-shiji-092-hanxin:p014","chapter_id":"c-shiji-092-hanxin"},{"id":"c-shiji-092-hanxin:m015-0000","start":0,"end":3,"surface":"齊王廣","kind":"person","person_id":"cbr-p005109","status":"contextual_provisional","paragraph_id":"c-shiji-092-hanxin:p015","chapter_id":"c-shiji-092-hanxin"},{"id":"c-shiji-092-hanxin:m015-0262","start":262,"end":265,"surface":"齊王廣","kind":"person","person_id":"cbr-p005109","status":"contextual_provisional","paragraph_id":"c-shiji-092-hanxin:p015","chapter_id":"c-shiji-092-hanxin"}],"relations":[],"title_holdings":[{"id":"th-shiji092-016","person_id":"cbr-p005109","title":"齊王","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-092-hanxin","source_id":"s-shiji-092-hanxin","paragraph_id":"c-shiji-092-hanxin:p014","quote":"信引兵東，未渡平原，聞漢王使酈食其已說下齊，韓信欲止。范陽辯士蒯通說信曰：『將軍受詔擊齊，而漢獨發閒使下齊，寧有詔止將軍乎？何以得毋行也！且酈生一士，伏軾掉三寸之舌，下齊七十餘城，將軍將數萬眾，歲餘乃下趙五十餘，爲將數歲，反不如一豎儒之功乎？』於是信然之，從其計，遂渡河。齊已聽酈生，即留縱酒，罷備漢守御。信因襲齊歷下軍，遂至臨菑。齊王田廣以酈生賣己，乃亨之，而走髙密，使使之楚請救。韓信已定臨菑，遂東追廣至髙密西。楚亦使龍且將，號稱二十萬，救齊。"}],"attestations":[{"id":"th-shiji092-016:a001","paragraph_id":"c-shiji-092-hanxin:p014","start":166,"end":168,"surface":"齊王","person_mention_id":"c-shiji-092-hanxin:m014-0166","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予與用稱分存；假王請求不作已授，稱病被捕死亡不自動補任期終點。連敖依頁面註記保留改字前形，不宣稱已核底本。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji092-013","person_id":"cbr-p005109","scope":"same_chapter","chapter_ids":["c-shiji-092-hanxin"],"status":"contextual_provisional","rationale":"按明示姓名及局部事件承接；王號限敘事主體，酈食其酈生及蒯通蒯生暫接，未名者與引古人物各存。不補邯欣翳及周召等短稱完整姓名。","reviewer":"Codex（AI 代理）","surfaces":["廣","齊王廣","齊王田廣"],"evidence":[{"paragraph_id":"c-shiji-092-hanxin:p014","quote":"信引兵東，未渡平原，聞漢王使酈食其已說下齊，韓信欲止。范陽辯士蒯通說信曰：『將軍受詔擊齊，而漢獨發閒使下齊，寧有詔止將軍乎？何以得毋行也！且酈生一士，伏軾掉三寸之舌，下齊七十餘城，將軍將數萬眾，歲餘乃下趙五十餘，爲將數歲，反不如一豎儒之功乎？』於是信然之，從其計，遂渡河。齊已聽酈生，即留縱酒，罷備漢守御。信因襲齊歷下軍，遂至臨菑。齊王田廣以酈生賣己，乃亨之，而走髙密，使使之楚請救。韓信已定臨菑，遂東追廣至髙密西。楚亦使龍且將，號稱二十萬，救齊。"},{"paragraph_id":"c-shiji-092-hanxin:p015","quote":"齊王廣、龍且并軍與信戰，未合。人或說龍且曰：『漢兵遠鬬窮戰，其鋒不可當。齊、楚自居其地戰，兵易敗散。不如深壁，令齊王使其信臣招所亡城，亡城聞其王在，楚來救，必反漢。漢兵二千里客居，齊城皆反之，其勢無所得食，可無戰而降也。』龍且曰：『吾平生知韓信爲人，易與耳。且夫救齊不戰而降之，吾何功？今戰而勝之，齊之半可得，何爲止！』遂戰，與信夾濰水陳。韓信乃夜令人爲萬餘囊，滿盛沙，壅水上流，引軍半渡，擊龍且，詳不勝，還走。龍且果喜曰：『固知信怯也。』遂追信渡水。信使人決壅囊，水大至。龍且軍大半不得渡，即急擊，殺龍且。龍且水東軍散走，齊王廣亡去。信遂追北至城陽，皆虜楚卒。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-092-hanx