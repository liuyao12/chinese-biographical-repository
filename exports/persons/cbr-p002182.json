r-p002182","predicate":"brother","object_person_id":"cbr-p002177","status":"source_attested","evidence":[{"chapter_id":"c-shiji-042-zheng","source_id":"s-shiji-042-zheng","paragraph_id":"c-shiji-042-zheng:p033","quote":"成公三年，楚共王曰「鄭成公孤有德焉」，使人來與盟。成公私與盟。秋，成公朝晉，晉曰「鄭私平於楚」，執之。使欒書伐鄭。四年春，鄭患晉圍，公子如乃立成公庶兄繻爲君。其四月，晉聞鄭立君，乃歸成公。鄭人聞成公歸，亦殺君繻，迎成公。晉兵去。"}],"qualifiers":{"source_term":"成公庶兄繻","historicity":"historical_tradition"},"interpretation_note":"依明示子、母、兄弟及祖系保存來源主張；不把繼位當父子，不由兄弟推同母。傳說及夢中祖先主張保留敘事性，不冒稱已證史實。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji042-088","person_id":"cbr-p002182","scope":"same_chapter","chapter_ids":["c-shiji-042-zheng"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["君繻","繻"],"evidence":[{"paragraph_id":"c-shiji-042-zheng:p033","quote":"成公三年，楚共王曰「鄭成公孤有德焉」，使人來與盟。成公私與盟。秋，成公朝晉，晉曰「鄭私平於楚」，執之。使欒書伐鄭。四年春，鄭患晉圍，公子如乃立成公庶兄繻爲君。其四月，晉聞鄭立君，乃歸成公。鄭人聞成公歸，亦殺君繻，迎成公。晉兵去。"}],"rationale":"依本篇名字、是為、世系及連續事件暫接異稱；同諡不同國分開，建子勝與聲公勝不合併，如兄弟為譬喻不作親屬。述贊與正文不算獨立來源，省稱、古字與校勘仍待核。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-042-zheng:p033","text":"成公三年，楚共王曰「鄭成公孤有德焉」，使人來與盟。成公私與盟。秋，成公朝晉，晉曰「鄭私平於楚」，執之。使欒書伐鄭。四年春，鄭患晉圍，公子如乃立成公庶兄繻爲君。其四月，晉聞鄭立君，乃歸成公。鄭人聞成公歸，亦殺君繻，迎成公。晉兵去。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-042-zheng:m033-0000","start":0,"end":2,"surface":"成公","kind":"person","person_id":"cbr-p002177","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m033-0005","start":5,"end":8,"surface":"楚共王","kind":"person","person_id":"cbr-p002179","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m033-0010","start":10,"end":13,"surface":"鄭成公","kind":"person","person_id":"cbr-p002177","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m033-0019","start":19,"end":21,"surface":"使人","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名、群體、夢中或神祇指代及提議用稱保留；不補姓名、個人成