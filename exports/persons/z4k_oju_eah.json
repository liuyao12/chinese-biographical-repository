s_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-076-guzhong:line120:m0088","start":88,"end":90,"surface":"馬流","kind":"person","person_id":"z4k_oju_eah","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-076-guzhong:line120","chapter_id":"c-jinshu-076-guzhong"},{"id":"c-jinshu-076-guzhong:line122:m0172","start":172,"end":174,"surface":"馬流","kind":"person","person_id":"z4k_oju_eah","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-076-guzhong:line122","chapter_id":"c-jinshu-076-guzhong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-076-guzhong:line120","text":"峻遣將弘徽領甲卒五百，鼓行而前。衆與颺、悊要擊徽，戰于高莋，大破之，收其軍實。謨以冰當還任，故便去郡。衆遣颺率諸軍屯無錫。冰至，鎮禦亭，恐賊從海虞道入，衆自往備之。而賊率張健、馬流攻無錫，颺等大敗，庚冰亦失守，健等遂據吳城。衆自海虞由婁縣東倉與賊別率交戰，破之，義軍又集進屯烏苞。會稽內史王舒、吳興內史虞潭並檄衆為五郡大督護，統諸義軍討健。潭遣將姚休為衆前鋒，與賊戰沒。衆還守紫壁。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-076-guzhong:line120:m0000","start":0,"end":1,"surface":"峻","kind":"person","person_id":"lrg_cze_g1l","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-076-guzhong:line120:m0003","start":3,"end":5,"surface":"弘徽","kind":"person","person_id":"875_36b_0ca","status":"contextual_