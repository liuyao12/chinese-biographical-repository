me_ai_required":false},"family_paths":[],"mentions":[{"id":"c-songshu-049-liuzhong:p004:m0054","start":54,"end":56,"surface":"譙亢","kind":"person","person_id":"r55_08x_nb8","status":"contextual_provisional","paragraph_id":"c-songshu-049-liuzhong:p004","chapter_id":"c-songshu-049-liuzhong"}],"relations":[],"title_holdings":[{"id":"th-songshu-049-liuzhong-4-48","title":"冠軍征討督護","kind":"office","mode":"attestation","person_id":"r55_08x_nb8","attestations":[{"id":"th-songshu-049-liuzhong-4-48:a","paragraph_id":"c-songshu-049-liuzhong:p004","start":48,"end":54,"surface":"冠軍征討督護","person_mention_id":"c-songshu-049-liuzhong:p004:m0054","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-049","chapter_id":"c-songshu-049-liuzhong","source_id":"s-songshu-049-liuzhong-ws2118585","paragraph_id":"c-songshu-049-liuzhong:p004","quote":"高祖討劉毅，鍾率軍繼王鎮惡。江陵平定，仍隨朱齡石伐蜀，為前鋒，由外水，至于彭模，去成都二百里。偽冠軍征討督護譙亢等兩岸連營，層樓重柵，眾號三萬。鍾于時脚疾不能行，齡石乃詣鍾謀曰：「今天時盛熱，而賊嚴兵固險，攻之未必可拔，祇增疲困。計其人情恇撓，必不久安，且欲養銳息兵，以伺其隙。隙而乘之，乃可捷事。然決機兩陳，公本有所委，卿意謂何﹖」鍾曰：「不然。前揚聲言大眾向內水，譙道福不敢舍涪城。今重軍卒至，出其不意，蜀人已破膽矣。賊今阻兵守險，是其懼不敢戰，非能持久堅守也。因其兇懼，盡銳攻之，其勢必克。鼓行而進，成都必不能守矣。今若緩兵相守，彼將知人虛實，涪軍忽并來力距我，人情既安，良將又集，此求戰不獲，軍食無資，當為蜀子虜耳。」齡石從之。明日進攻，陷其二城，斬其大將侯輝、譙詵，逕平成都。","person_mention_id":"c-songshu-049-liuzhong:p004:m0054"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-songshu-049-liuzhong:p004","text":"高祖討劉毅，鍾率軍繼王鎮惡。江陵平定，仍隨朱齡石伐蜀，為前鋒，由外水，至于彭模，去成都二百里。偽冠軍征討督護譙亢等兩岸連營，層樓重柵，眾號三萬。鍾于時脚疾不能行，齡石乃詣鍾謀曰：「今天時盛熱，而賊嚴兵固險，攻之未必可拔，祇增疲困。計其人情恇撓，必不久安，且欲養銳息兵，以伺其隙。隙而乘之，乃可捷事。然決機兩陳，公本有所委，卿意謂何﹖」鍾曰：「不然。前揚聲言大眾向內水，譙道福不敢舍涪城。今重軍卒至，出其不意，蜀人已破膽矣。賊今阻兵守險，是其懼不敢戰，非能持久堅守也。因其兇懼，盡銳攻之，其勢必克。鼓行而進，成都必不能守矣。今若緩兵相守，彼將知人虛實，涪軍忽并來力距我，人情既安，良將又集，此求戰不獲，軍食無資，當為蜀子虜耳。」齡石從之。明日進攻，陷其二城，斬其大將侯輝、譙詵，逕平成都。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":34,"last_line":34,"raw_start":2493,"raw_end":2880,"raw_character_offsets":[2493,2494,2495,2496,2497,2498,2499,2500,2501,2502,2503,2504,2505,2506,2507,2508,2509,2510,2511,2512,2513,2514,2515,2516,2517,2518,2519,2520,2521,2522,2523,2524,2525,2526,2527,2528,2529,2530,2531,2532,2533,2534,2535,2536,2537,2538,2539,2540,2541,2542,2543,2544,2545,2546,2547,2548,2549,2550,2551,2552,2553,2554,2555,2556,2557,2558,2559,2560,2561,2562,2563,2564,2565,2566,2567,2568,2569,2570,2571,2572,2573,2574,2575,2576,2577,2578,2579,2580,2581,2582,2583,2584,2585,2586,2587,2588,2589,2590,2591,2592,2593,2594,2595,2596,2597,2598,2599,2600,2601,2602,2603,2604,2605,2606,2607,2608,2609,2610,2611,2612,2613,2614,2615,2616,2617,2618,2619,2620,2621,2622,2623,2624,2625,2626,2627,2628,2629,2630,2631,2632,2633,2634,2635,2636,2637,2638,2639,2640,2641,2642,2643,2644,2645,2646,2647,2648,2649,2650,2651,2652,2653,2654,2655,2656,2657,2658,2659,2660,2661,2662,2663,2664,2665,2666,2667,2668,2669,2670,2671,2672,2673,2674,2675,2676,2677,2678,2679,2680,2681,2682,2683,2684,2685,2686,2687,2688,2689,2690,2691,2692,2693,2694,2695,2696,2697,2698,2699,2700,2701,2702,2703,2704,2705,2706,2707,2708,2709,2710,2711,2712,2713,2714,2715,2716,2717,2718,2719,2720,2721,2722,2723,2724,2725,2726,2727,2728,2729,2730,2731,2732,2733,2734,2735,2736,2737,2738,2739,2740,2741,2742,2743,2744,2745,2746,2747,2748,2749,2750,2751,2752,2753,2754,2755,2756,2757,2758,2759,2760,2761,2762,2763,2764,2765,2766,2767,2768,2769,2770,2771,2772,2773,2774,2775,2776,2821,2822,2823,2824,2825,2826,2827,2828,2829,2830,2831,2832,2833,2834,2835,2836,2837,2838,2839,2840,2841,2842,2843,2844,2845,2846,2847,2848,2849,2850,2851,2852,2853,2854,2855,2856,2857,2858,2859,2860,2861,2862,2863,2864,2865,2866,2867,2868,2869,2870,2871,2