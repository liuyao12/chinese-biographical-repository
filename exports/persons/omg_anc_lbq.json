book_id":"b-nanqishu-042","source_id":"s-nanqishu-042-wangxu-yan-ws1507997","chapter_id":"c-nanqishu-042-wangxu-yan","paragraph_id":"c-nanqishu-042-wangxu-yan:p001","quote":"晏弟詡，永明中爲少府卿。六年，敕位未登黃門郎，不得畜女妓。詡與射聲校尉陰玄智坐畜妓免官，禁錮十年。敕特原詡禁錮。後出爲輔國將軍、始興內史。廣州刺史劉纘爲奴所殺，詡率郡兵討之。延興元年，授詡持節廣州刺史。詡亦篤舊。晏誅，上又遣南中郎司馬蕭季敞襲詡殺之。","person_mention_id":"c-nanqishu-042-wangxu-yan:p001:m0073"}],"status":"source_attested","interpretation_note":"遇害者為劉纘，行兇奴未具名。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-nanqishu-042-wangxu-yan:p001:m0073","surface":"劉纘","start":73,"end":75,"person_id":"omg_anc_lbq","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-nanqishu-042-wangxu-yan:p001","chapter_id":"c-nanqishu-042-wangxu-yan"},{"id":"c-nanqishu-057-northern-wei-complete:p016:m0011","start":11,"end":13,"surface":"劉纘","kind":"person","person_id":"omg_anc_lbq","status":"contextual_provisional","paragraph_id":"c-nanqishu-057-northern-wei-complete:p016","chapter_id":"c-nanqishu-057-northern-wei-complete"},{"id":"c-nanqishu-057-northern-wei-complete:p019:m0018","start":18,"end":20,"surface":"劉纘","kind":"person","person_id":"omg_anc_lbq","status":"contextual_provisional","paragraph_id":"c-nanqishu-057-northern-wei-complete:p019","chapter_id":"c-nanqishu-057-northern-wei-complete"}],"relations":[],"title_holdings":[{"id":"th-nanshi024-wangyan-brothers-q1-69","person_id":"omg_anc_lbq","title":"廣州刺史","kind":"office","mode":"attestation","attestations":[{"id":"th-nanshi024-wangyan-brothers-q1-69:a","person_mention_id":"c-nanqishu-042-wangxu-yan:p001:m0073","usage":"narrative","date_expression":null,"paragraph_id":"c-nanqishu-042-wangxu-yan:p001","surface":"廣州刺史","start":69,"end":73}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-042","source_id":"s-nanqishu-042-wangxu-ya