,2066,2067,2068,2069,2070,2071,2072,2073,2074,2075,2076,2082,2083,2084,2085,2088,2089,2090,2091,2092,2093,2094,2095,2096,2097,2098,2099,2100,2101,2102,2103,2104,2105,2106,2107,2108,2109,2110,2111,2112,2113,2114,2115,2116,2117,2118,2119,2120,2121],"projection_sha256":"3d14658b3ab89a45f15d71ba45ceb482fb6ae51aeb22716ab205819469367b0a"},"chapter_id":"c-nanqishu-042-wangxu-yan","book_id":"b-nanqishu-042","work_id":"w-nanqishu","source_id":"s-nanqishu-042-wangxu-yan-ws1507997"},{"id":"c-nanqishu-057-northern-wei-complete:p016","text":"永明元年冬，遣驍騎將軍劉纘、前軍將軍張謨使虜。明年冬，虜使李道固報聘，世祖於玄武湖水步軍講武，登龍舟引見之。自此歲使往來，疆埸無事。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":40,"last_line":40,"raw_start":3783,"raw_end":3900,"raw_character_offsets":[3788,3789,3790,3791,3794,3795,3796,3797,3798,3799,3800,3801,3802,3803,3804,3805,3806,3807,3808,3809,3810,3811,3812,3813,3814,3815,3816,3817,3818,3819,3820,3821,3822,3823,3824,3869,3870,3871,3872,3873,3874,3875,3876,3877,3878,3879,3880,3881,3882,3883,3884,3885,3886,3887,3888,3889,3890,3891,3892,3893,3894,3895,3896,3897,3898,3899],"revision_id":1999801},"mentions":[{"id":"c-nanqishu-057-northern-wei-complete:p016:m0011","start":11,"end":13,"surface":"劉纘","kind":"person","person_id":"omg_anc_lbq","status":"contextual_provisional"},{"id":"c-nanqishu-057-northern-wei-complete:p016:m0029","start":29,"end":32,"surface":"李道固","kind":"person","person_id":"9qd_qoj_hyt","status":"contextual_provisional"},{"id":"c-nanqishu-057-northern-wei-complete:p016:m0035","start":35,"end":37,"surface":"世祖","kind":"person","person_id":"kix_r92_2ed","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-057-northern-wei-complete","book_id":"b-nanqishu-057","work_id":"w-nanqishu","source_id":"s-nanqishu-057-northern-wei-complete-ws1999801"},{"id":"c-nanqishu-057-northern-wei-complete:p019","text":"至七年，遣使邢產、侯靈紹復通好。先是劉纘再使虜，太后馮氏悅而親之。馮氏有計略，作皇誥十八篇，偽左僕射李思沖稱史臣注解。是歲，馮氏死。八年，世祖還隔城所俘獲二千餘人。","text_layer":"received_chapter","annotation_statu