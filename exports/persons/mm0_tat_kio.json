ies":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-jinshu-066-taokan:identity10-68","kind":"identity","person_id":"mm0_tat_kio","source_quote":"交州秀才劉沈俱謀反","reading":"臨賀杜弘事，與雍州刺史同名人分存。","note":"臨賀杜弘事，與雍州刺史同名人分存。","paragraph_id":"c-jinshu-066-taokan:p010","start_codepoint":68,"end_codepoint":77,"human_reviewed":false,"chapter_id":"c-jinshu-066-taokan","source_id":"s-jinshu-066-taokan-ws1527632"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-066-taokan:p010:m0072","surface":"劉沈","start":72,"end":74,"person_id":"mm0_tat_kio","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-066-taokan:p010","chapter_id":"c-jinshu-066-taokan"},{"id":"c-jinshu-066-taokan:p010:m0144","surface":"劉沈","start":144,"end":146,"person_id":"mm0_tat_kio","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-066-taokan:p010","chapter_id":"c-jinshu-066-taokan"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-066-taokan:p010","text":"先是，廣州人背刺史郭訥，迎長沙人王機為刺史。機復遣使詣王敦，乞為交州。敦從之，而機未發。會杜弘據臨賀，因機乞降，勸弘取廣州，弘遂與溫邵及交州秀才劉沈俱謀反。或勸侃且住始興，觀察形勢。侃不聽，直至廣州。弘遣使偽降。侃知其詐，先於封口起發石車。俄而弘率輕兵而至，知侃有備，乃退。侃追擊破之，執劉沈于小桂。又遣部將許高討機，斬之，傳首京都。諸將皆請乘勝擊溫邵，侃笑曰：「吾威名已著，何事遣兵，但一函紙自足耳。」於是下書諭之。邵懼而走，追獲於始興。以功封柴桑侯，食邑四千戶。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":47,"last_line":47,"raw_start":5564,"raw_end":5799,"raw_character_offsets":[5566,5567,5568,5569,5570,5571,5572,5573,5574,5575,5576,5577,5578,5579,5580,5581,5582,5583,5584,5585,5586,5587,5588,5589,5590,5