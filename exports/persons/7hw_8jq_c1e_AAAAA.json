001","surface":"祖暄","start":14,"end":16}}],"status":"source_attested","interpretation_note":"傳首明祖。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanshi-024-wangmeng:p005","text":"猛母妻子先留建鄴，因隨後主入京，詔賜宅及什物甚厚，別賚物一千段，及遣璽書勞猛。仍討平山越，馳驛奏聞。時文帝幸河東，會猛使至，大悅。楊素賀，因曰：「昔漢武此地聞喜，用改縣名，王猛今者告捷，遠符前事。」於是又降璽書褒賞，以其長子繕爲開府儀同三司。猛尋卒于廣州，文帝聞而痛之，遣使弔祭，贈上開府儀同三司，封歸仁縣公。命其子繕襲，仍授普州刺史。仁壽元年，繕弟續表陳猛志，求葬關中，詔許之。仍贈使持節、大將軍、宋州刺史、三州諸軍事，諡曰成。","mentions":[{"id":"c-nanshi-024-wangmeng:p005:m0000","surface":"猛","start":0,"end":1,"person_id":"72e_1a7_3ac_AAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangmeng:p005:m0002","surface":"妻","start":2,"end":3,"person_id":"pnw_wov_a66","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangmeng:p005:m0037","surface":"猛","start":37,"end":38,"person_id":"72e_1a7_3ac_AAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangmeng:p005:m0058","surface":"猛","start":58,"end":59,"person_id":"72e_1a7_3ac_AAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangmeng:p005:m0065","surface":"楊素","start":65,"end":67,"person_id":"7hw_8jq_c1e_AAAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangmeng:p005:m0086","surface":"王猛","start":86,"end":88,"person_id":"72e_1a7_3ac_AAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangmeng:p005:m0112","surface":"繕","start":112,"end":113,"person_id":"72e_1a7_3ac_AAAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"