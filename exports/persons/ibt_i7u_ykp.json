6,8947,8948,8949,8950,8951,8952,8953,8954,8955,8956,8957,8958,8959,8960,8961,8962,8963,8964,8965,8966,8967,8968,9149,9150,9151,9152,9153,9154,9155,9156,9157,9158,9159,9160,9161,9162,9163,9164,9165,9166,9167,9168,9169,9170,9171,9172,9173,9174,9175,9176,9177,9178,9179,9180,9181,9182,9183,9184,9185,9186,9187,9188,9189,9190,9191,9192,9193,9194,9477,9478,9479,9480,9483,9484,9485,9486,9487,9488,9489,9490,9491,9492,9493,9494,9495,9496,9497,9498,9499,9500]},"chapter_id":"c-sanguozhi-052-zhugejin-complete","book_id":"b-sanguozhi-052","work_id":"w-sanguozhi","source_id":"s-sanguozhi-052-zhugejin-complete"},{"id":"c-sanguozhi-057-yufan:line019","text":"孫權以為騎都尉。翻數犯顏諫爭，權不能悅。又性不協俗，多見謗毀，坐徙丹楊涇縣。呂蒙圖取關羽，稱疾還建業，以翻兼知醫術，請以自隨，亦欲因此令翻得釋也。後蒙舉軍西上，南郡太守麋芳開城出降。蒙未據郡城而作樂沙上。翻渭蒙曰：“今區區一心者麋將軍也，城中之人豈可盡信，何不急入城持其管答乎？”蒙即從之。時城中有伏計，賴翻謀不行。關羽既敗，權使翻筮之，得兌下坎上，節，五爻變之臨，翻曰：\"不出二日，必當斷頭。\"果如翻言。權曰：\"卿不及伏羲，可與東方朔為比矣。\"","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-057-yufan:line019:m0001","start":1,"end":2,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-yufan:line019:m0008","start":8,"end":9,"surface":"翻","kind":"person","person_id":"izi_e36_p1g","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-yufan:line019:m0015","start":15,"end":16,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-yufan:line019:m0039","start":39,"end":40,"surface":"蒙","kind":"person","person_id":"ibt_i7u_ykp","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-yufan:line019:m0042","start":42,"end":44,"surface":"關羽","kind":"person","person_id":"1c2_03c_9ea","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-yufan:line019:m0052","start":52,"end":53,"surface":"翻","kind":"person","person_id":"izi_e36_p1g",