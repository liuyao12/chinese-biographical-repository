公安、南郡。遜徑進，領宜都太守，拜撫邊將軍，封華亭侯。備宜都太守樊友委郡走，諸城長吏及蠻夷君長皆降。遜請金銀銅印，以假授初附。是歲建安二十四年十一月也。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-058-luxun:line019:m0000","start":0,"end":1,"surface":"羽","kind":"person","person_id":"1c2_03c_9ea","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line019:m0002","start":2,"end":3,"surface":"遜","kind":"person","person_id":"lii_454_vuv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line019:m0022","start":22,"end":23,"surface":"遜","kind":"person","person_id":"lii_454_vuv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line019:m0035","start":35,"end":36,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line019:m0043","start":43,"end":44,"surface":"遜","kind":"person","person_id":"lii_454_vuv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line019:m0045","start":45,"end":47,"surface":"呂蒙","kind":"person","person_id":"ibt_i7u_ykp","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line019:m0060","start":60,"end":61,"surface":"遜","kind":"person","person_id":"lii_454_vuv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line019:m0081","start":81,"end":82,"surface":"備","kind":"person","person_id":"5f2_396_25c","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line019:m0086","start":86,"end":88,"surface":"樊友","kind":"person","person_id":"nbv_n3v_1ig","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line019:m0104","start":104,"end":105,"surface":"遜","kind":"person","person_id":"lii_454_vuv","status":"contextual_provision