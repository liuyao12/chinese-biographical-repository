,"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"id":"name-jin037-near-louquan","person_id":"eo9_x3l_q7v","surname":"樓","ming":"權","additional_names":[],"chapter_id":"c-jinshu-037-gaomi-nanyang-ws2630018","paragraph_id":"c-jinshu-037-gaomi-nanyang-ws2630018:p005","person_mention_id":"c-jinshu-037-gaomi-nanyang-ws2630018:p005:m0097","source_anchor":{"start":97,"end":99,"surface":"樓權"},"quote":"南陽王模，字元表，少好學，與元帝及范陽王虓俱有稱於宗室。初封平昌公。惠帝末，拜冗從僕射，累遷太子庶子、員外散騎常侍。成都王穎奔長安，東海王越以模為北中郎將，鎮鄴。永興初，成都王穎故帳下督公師籓、樓權、郝昌等攻鄴，模左右謀應之。廣平太守丁邵率眾救模，范陽王虓又遣兗州刺史苟晞援之，籓等散走。遷鎮東大將軍，鎮許昌。進爵南陽王。永嘉初，轉征西大將軍、開府、都督秦雍梁益諸軍事，代河間王顒鎮關中。模感丁邵之德，敕國人為邵生立碑。","note":"來源具名原字；氏稱不補本名，所報異文分見數位校記，不加成無資格全域異名。","status":"editorial_provisional","human_reviewed":false,"model":null,"work_id":"w-jinshu","book_id":"b-jinshu-037","source_id":"s-jinshu037-gaomi-nanyang-ws2630018"}],"mentions":[{"id":"c-jinshu-037-gaomi-nanyang-ws2630018:p005:m0097","start":97,"end":99,"surface":"樓權","kind":"person","person_id":"eo9_x3l_q7v","status":"contextual_provisional","source_identity_role":"louquan","identity_reading_ref":"source-evidence/jin037-gaomi-nanyang/identity-readings.json#louquan","paragraph_id":"c-jinshu-037-gaomi-nanyang-ws2630018:p005","chapter_id":"c-jinshu-037-gaomi-nanyang-ws2630018"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-037-gaomi-nanyang-ws2630018:p005","text":"南陽王模，字元表，少好學，與元帝及范陽王虓俱有稱於宗室。初封平昌公。惠帝末，拜冗從僕射，累遷太子庶子、員外散騎常侍。成都王穎奔長安，東海王越以模為北中郎將，鎮鄴。永興初，成都王穎故帳下督公師籓、樓權、郝昌等攻鄴，模左右謀應之。廣平太守丁邵率眾救模，范陽王虓又遣兗州刺史苟晞援之，籓等散走。遷鎮東大將軍，鎮許昌。進爵南陽王。永嘉初，轉征西大將軍、開府、都督秦雍梁益諸軍事，代河間王顒鎮關中。模感丁邵之德，敕國人為邵