scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[{"paragraph_id":"c-shiji-111-wei-huo:p013","source_term":"呼毒尼為下摩侯","person_ids":["ppl_k5e_2iw"],"status":"reported_not_collated","adopted":false,"received_reading":"呼毒尼","reported_reading":"謼毒尼","quote":"下摩侯謼毒尼","commentator":"漢書數位表文（平行記載）","url":"https://zh.wikisource.org/wiki/漢書/卷017","image_verified":false,"interpretation_note":"僅保存已讀數位見證的所報異文或同封號平行名稱；不改本篇原字，不增加全域別名，也不宣稱影像校勘或各版本人名已確定同指。"}],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-111-wei-huo:m013-0229","start":229,"end":232,"surface":"呼毒尼","kind":"person","person_id":"ppl_k5e_2iw","status":"contextual_provisional","paragraph_id":"c-shiji-111-wei-huo:p013","chapter_id":"c-shiji-111-wei-huo"}],"relations":[],"title_holdings":[{"id":"th-shiji111-133","person_id":"ppl_k5e_2iw","title":"裨王","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-111-wei-huo","source_id":"s-shiji111-wei-huo","paragraph_id":"c-shiji-111-wei-huo:p013","quote_passage_ref":"data/corpus/shiji/111.json"}],"attestations":[{"id":"th-shiji111-133:a001","paragraph_id":"c-shiji-111-wei-huo:p013","start":227,"end":229,"surface":"裨王","person_mention_id":"c-shiji-111-wei-huo:m013-0229","usage":"narrative","date_expression":"其秋","normalized_date":{"era":"BCE","era_year":121,"year":-120,"year_numbering":"astronomical","precision":"year","status":"editorial_provisional","original_quote":"其秋，單于怒渾邪王居西方數為漢所破，亡數萬人，以驃騎之兵也。單于怒，欲召誅渾邪王。渾邪王與休屠王等謀欲降漢，使人先要邊。是時大行李息將城河上，得渾邪王使，即馳傳以聞。天子聞之，於是恐其以詐降而襲邊，乃令驃騎將軍將兵往迎之。驃騎既渡河，與渾邪王眾相望。渾邪王裨將見漢軍而多欲不降者，頗遁去。驃騎乃馳入與渾邪王相見，斬其欲亡者八千人，遂獨遣渾邪王乘傳先詣行在所，盡將其眾渡河，降者數萬，號稱十萬。既至長安，天子所以賞賜者數十巨萬。封渾邪王萬戶，為漯陰侯。封其裨王呼毒尼為下摩侯，鷹庇為煇渠侯，禽為河綦侯，大當戶銅離為常樂侯。於是天子嘉驃騎之功曰：「驃騎將軍去病率師攻匈奴西域王渾邪，王及厥眾萌咸相奔，率以軍糧接食，并將控弦萬有餘人，誅獟駻，獲首虜八千餘級，降異國之王三十二人，戰士不離傷，十萬之眾咸懷集服，仍與之勞，爰及河塞，庶幾無患，幸既永綏矣。以千七百戶益封驃騎將軍。」減隴西、北地、上郡戍卒之半，以寬天下之繇。","evidence":[{"chapter_id":"c-shiji-111-wei-huo","source_id":"s-shiji111-wei-huo","paragraph_id":"c-shiji-111-wei-huo:p013","quote_passage_ref":"data/corpus/shiji/111.json"},{"chapter_id":"c-shiji-111-wei-huo","source_id":"s-shiji111-wei-huo","paragraph_id":"c-shiji-111-wei-huo:p011","quote_passage_ref":"data/corpus/shiji/111.json"}],"references":[{"title":"《資治通鑑》數位編輯年標","url":"https://zh.wikisource.org/wiki/資治通鑑/卷019","quote":"元狩二年（庚申，公元前一二一年）","scope":"digital_editorial_regnal_year_equivalence_only","image_verified":false}],"rationale":"其秋承本篇元狩二年春、其夏；暫前121年，只取年精度。鷹庇受封年另有索隱引表異說，未據之改寫本篇敘事年代。","reviewer":"Codex（AI 代理）","human_reviewed":false}}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"保留本篇秋季用稱與明示受封，未補此前任期或終點；霍去病益封戶數不另作新授爵。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji111-136","person_id":"ppl_k5e_2iw","title":"下摩侯","kind":"noble_rank","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-111-wei-huo","source_id":"s-shiji111-wei-huo","paragraph_id":"c-shiji-111-wei-huo:p013","quote_passage_ref":"data/corpus/shiji/111.json"}],"attestations":[{"id":"th-shiji111-136:a001","paragraph_id":"c-shiji-111-wei-huo:p013","start":233,"end":236,"surface":"下摩侯","person_mention_id":"c-shiji-111-wei-huo:m013-0229","usage":"narrative","date_expression":"其秋","normalized_date":{"era":"BCE","era_year":121,"year":-120,"year_numbering":"astronomical","precision":"year","status":"editorial_provisional","original_quote":"其秋，單于怒渾邪王居西方數為漢所破，亡數萬人，以驃騎之兵也。單于怒，欲召誅渾邪王。渾邪王與休屠王等謀欲降漢，使人先要邊。是時大行