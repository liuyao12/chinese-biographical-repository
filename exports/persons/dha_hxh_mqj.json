is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-jinshu-070-liuchao:source_review3-293","kind":"source_review","person_id":"dha_hxh_mqj","source_quote":"峻使任讓將兵入收超及鍾雅","reading":"通鑑九十四作蘇逸使任讓；成帝紀繫咸和四年正月，作爲賊所害。","note":"通鑑九十四作蘇逸使任讓；成帝紀繫咸和四年正月，作爲賊所害。","paragraph_id":"c-jinshu-070-liuchao:p003","start_codepoint":293,"end_codepoint":305,"human_reviewed":false,"chapter_id":"c-jinshu-070-liuchao","source_id":"s-jinshu-070-liuchao-ws2595540"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin070-liuzhang-ancestor","subject_person_id":"dha_hxh_mqj","object_person_id":"yqp_nlb_p1p_ABF","predicate":"ancestor","qualifiers":{"source_term":"漢城陽景王章之後也"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-070","chapter_id":"c-jinshu-070-liuchao","source_id":"s-jinshu-070-liuchao-ws2595540","paragraph_id":"c-jinshu-070-liuchao:p001","quote":"劉超字世瑜，琅邪臨沂人，漢城陽景王章之後也。章七世孫封臨沂縣慈鄉侯，子孫因家焉。父和，爲琅邪國上軍將軍。超少有志尚，爲縣小吏，稍遷琅邪國記室掾。以忠謹清慎爲元帝所拔，恒親侍左右，遂從渡江，轉安東府舍人，專掌文檄。相府建，又爲舍人。于時天下擾亂，伐叛討貳，超自以職在近密，而書跡與帝手筆相類，乃絕不與人交書。時出休沐，閉門不通賓客，由是漸得親密。以左右勤勞，賜爵原鄉亭侯，食邑七百戶，轉行參軍。","subject_person_mention_id":"c-jinshu-070-liuchao:p001:m0000","object_person_mention_id":"c-jinshu-070-liuchao:p001:m0017"}],"status":"source_attested","interpretation_note":"受封慈鄉侯為劉章七世孫，名氏未書；劉超與此侯間世次未詳。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"a-jin070-liuhe-father","subject_person_id":"dha_hxh_mqj","object_person_id":"gyj_vvj_38e","predicate":"father","qualifiers":{"source_term":"父和，爲琅邪國上軍將軍"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-070","chapter_id":"c-jinshu-070-liuchao","source_id":"s-jinshu-070-liuchao-ws2595540","paragraph_id":"c-jinshu-070-liuchao:p001","quote":"劉超字世瑜，琅邪臨沂人，漢城陽景王章之後也。章七世孫封臨沂縣慈鄉侯，子孫因家焉。父和，爲琅邪國上軍將軍。超少有志尚，爲縣小吏，稍遷琅邪國記室掾。以忠謹清慎爲元帝所拔，恒親侍左右，遂從渡江，轉安東府舍人，專掌文檄。相府建，又爲舍人。于時天下擾亂，伐叛討貳，超自以職在近密，而書跡與帝手筆相類，乃絕不與人交書。時出休沐，閉門不通賓客，由是漸得親密。以左右勤勞，賜爵原鄉亭侯，食邑七百戶，轉行參軍。","subject_person_mention_id":"c-jinshu-070-liuchao:p001:m0000","object_person_mention_id":"c-jinshu-070-liuchao:p001:m0041"}],"status":"source_attested","interpretation_note":"官與親屬同句，同名劉和分存。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-w044-huaheng-j7-1","person_id":"dha_hxh_mqj","event_type":"death","source_term":"爲賊所害","date_expression":null,"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-007","chapter_id":"c-jinshu-007-jin044-huaheng","source_id":"s-jinshu-007-jin044-huaheng","paragraph_id":"c-jinshu-007-jin044-huaheng:siege","quote":"侍中鐘雅、右衛將軍劉超謀奉帝出，爲賊所害。","person_mention_id":"c-jinshu-007-jin044-huaheng:siege:m0009"}],"interpretation_note":"依本來源登記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"le-w044-huaheng-liu","person_id":"dha_hxh_mqj","event_type":"death","source_term":"鐘雅、劉超之死","date_expression":null,"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-044","chapter_id":"c-jinshu-044-huaheng","source_id":"s-jinshu-044-huaheng","paragraph_id":"c-jinshu-044-huaheng:line099","quote":"初，恆為州大中正，鄉人任讓輕薄無行，為恆所黜。及讓在峻軍中，任勢多所殺害，見恆輒恭敬，不肆其虐。鐘雅、劉超之死，亦將及恆，讓盡心救衛，故得免。","person_mention_id":"c-jinshu-044-huaheng:line099:m0051"}],"interpretation_note":"依本來源登記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"le-jin070-liuchao","person_id":"dha_hxh_mqj","event_type":"death","source_term":"任讓不奉詔，因害之","source_anchor":{"paragraph_id":"c-jinshu-070-liuchao:p003","start":323,"end":332,"surface":"任讓不奉詔，因害之"},"date_expression":null,"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-070","chapter_id":"c-jinshu-070-liuchao","source_id":"s-jinshu-070-liuchao-ws2595540","paragraph_id":"c-jinshu-070-liuchao:p003","quote":"及蘇峻謀逆，超代趙胤爲左衛將軍。時京邑大亂，朝士多遣家人入東避難。義興故吏欲迎超家，而超不聽，盡以妻孥入處宮內。及王師敗績，王導以超爲右衛將軍，親侍成帝。屬太后崩，軍衛禮章損闕，超躬率將士奉營山陵。峻遷車駕石頭，時天大雨，道路沈陷，超與侍中鍾雅步侍左右，賊給馬不肯騎，而悲哀慷慨。峻聞之，甚不平，然未敢加害，而以其所親信許方等補司馬督、殿中監，外託宿衛，內實防禦超等。時饑饉米貴，峻等問遺，一無所受，繾綣朝夕，臣節愈恭。帝時年八歲，雖幽厄之中，超猶啟授孝經、論語。溫嶠等至，峻猜忌朝士，而超爲帝所親遇，疑之尤甚。後王導出奔，超與懷德令匡術、建康令管旆等密謀，將欲奉帝而出。未及期，事泄，峻使任讓將兵入收超及鍾雅。帝抱持悲泣曰：「還我侍中、右衛！」任讓不奉詔，因害之。及峻平，任讓與陶侃有舊，侃欲特不誅之，乃請於帝。帝曰：「讓是殺我侍中、右衛者，不可宥。」由是遂誅讓。及超將改葬，帝痛念之不已，詔遷高顯近地葬之，使出入得瞻望其墓。追贈衛尉，諡曰忠。","person_mention_id":"c-jinshu-070-liuchao:p003:m0301"}],"status":"source_attested","interpretation_note":"按同段人物與次第核所屬卒事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"mentions":[{"id":"c-jinshu-007-jin044-huaheng:siege:m0009","start":9,"end":11,"surface":"劉超","kind":"person","person_id":"dha_hxh_mqj","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-007-jin044-huaheng:siege","chapter_id":"c-jinshu-007-jin044-huaheng"},{"id":"c-jinshu-044-huaheng:line099:m0051","start":51,"end":53,"surface":"劉超","kind":"person","person_id":"dha_hxh_mqj","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-044-huaheng:line099","chapter_id":"c-jinshu-044-huaheng"},{"id":"c-jinshu-070-appraisal:p001:m0154","surface":"劉超","start":154,"end":156,"person_id":"dha_hxh_mqj","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-070-appraisal:p001","chapter_id":"c-jinshu-070-appraisal"},{"id":"c-jinshu-070-liuchao:p001:m0000","surface":"劉超","start":0,"end":2,"person_id":"dha_hxh_mqj","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-070-liuchao:p001","chapter_id":"c-jinshu-070-liuchao"},{"id":"c-jinshu-070-liuchao:p003:m0301","surface":"超","start":301,"end":302,"person_id":"dha_hxh_mqj","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-070-liuchao:p003","chapter_id":"c-jinshu-070-liuchao"},{"id":"c-jinshu-070-zhongya:p005:m0049","surface":"劉超","start":49,"end":51,"person_id":"dha_hxh_mqj","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-070-zhongya:p005","chapter_id":"c-jinshu-070-zhongya"}],"relations":[{"id":"a-jin070-liuzhang-ancestor","subject_person_id":"dha_hxh_mqj","object_person_id":"yqp_nlb_p1p_ABF","predicate":"ancestor","qualifiers":{"source_term":"漢城陽景王章之後也"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-070","chapter_id":"c-jinshu-070-liuchao","source_id":"s-jinshu-070-liuchao-ws2595540","paragraph_id":"c-jinshu-070-liuchao:p001","quote":"劉超字世瑜，琅邪臨沂人，漢城陽景王章之後也。章七世孫封臨沂縣慈鄉侯，子孫因家焉。父和，爲琅邪國上軍將軍。超少有志尚，爲縣小吏，稍遷琅邪國記室掾。以忠謹清慎爲元帝所拔，恒親侍左右，遂從渡江，轉安東府舍人，專掌文檄。相府建，又爲舍人。于時天下擾亂，伐叛討貳，超自以職在近密，而書跡與帝手筆相類，乃絕不與人交書。時出休沐，閉門不通賓客，由是漸得親密。以左右勤勞，賜爵原鄉亭侯，食邑七百戶，轉行參軍。","subject_person_mention_id":"c-jinshu-070-liuchao:p001:m0000","object_person_mention_id":"c-jinshu-070-liuchao:p001:m0017"}],"status":"source_attested","interpretation_note":"受封慈鄉侯為劉章七世孫，名氏未書；劉超與此侯間世次未詳。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"a-jin070-liuhe-father","subject_person_id":"dha_hxh_mqj","object_person_id":"gyj_vvj_38e","predicate":"father","qualifiers":{"source_term":"父和，爲琅邪國上軍將軍"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-070","chapter_id":"c-jinshu-070-liuchao","source_id":"s-jinshu-070-liuchao-ws2595540","paragraph_id":"c-jinshu-070-liuchao:p001","quote":"劉超字世瑜，琅邪臨沂人，漢城陽景王章之後也。章七世孫封臨沂縣慈鄉侯，子孫因家焉。父和，爲琅邪國上軍將軍。超少有志尚，爲縣小吏，稍遷琅邪國記室掾。以忠謹清慎爲元帝所拔，恒親侍左右，遂從渡江，轉安東府舍人，專掌文檄。相府建，又爲舍人。于時天下擾亂，伐叛討貳，超自以職在近密，而書跡與帝手筆相類，乃絕不與人交書。時出休沐，閉門不通賓客，由是漸得親密。以左右勤勞，賜爵原鄉亭侯，食邑七百戶，轉行參軍。","subject_person_mention_id":"c-jinshu-070-liuchao:p001:m0000","object_person_mention_id":"c-jinshu-070-liuchao:p001:m0041"}],"status":"source_attested","interpretation_note":"官與親屬同句，同名劉和分存。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"title_holdings":[{"id":"th-w044-huaheng-j7-liu","person_id":"dha_hxh_mqj","title":"右衛將軍","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-007","chapter_id":"c-jinshu-007-jin044-huaheng","source_id":"s-jinshu-007-jin044-huaheng","paragraph_id":"c-jinshu-007-jin044-huaheng:siege","quote":"侍中鐘雅、右衛將軍劉超謀奉帝出，爲賊所害。",