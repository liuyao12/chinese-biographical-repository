":13,"surface":"任讓","kind":"person","person_id":"a58_f53_e3b","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-huaheng:line099:m0019","start":19,"end":20,"surface":"恆","kind":"person","person_id":"eom_42c_5zd","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-huaheng:line099:m0024","start":24,"end":25,"surface":"讓","kind":"person","person_id":"a58_f53_e3b","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-huaheng:line099:m0026","start":26,"end":27,"surface":"峻","kind":"person","person_id":"lrg_cze_g1l","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-huaheng:line099:m0038","start":38,"end":39,"surface":"恆","kind":"person","person_id":"eom_42c_5zd","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-huaheng:line099:m0048","start":48,"end":50,"surface":"鐘雅","kind":"person","person_id":"j81_pcr_llk","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-huaheng:line099:m0051","start":51,"end":53,"surface":"劉超","kind":"person","person_id":"dha_hxh_mqj","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-huaheng:line099:m0059","start":59,"end":60,"surface":"恆","kind":"person","person_id":"eom_42c_5zd","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-huaheng:line099:m0061","start":61,"end":62,"surface":"讓","kind":"person","person_id":"a58_f53_e3b","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"source_position":{"first_line":99,"last_line":99,"revision_id":1775345},"source_quote":{"witness":"j44","quote":"　　初，恆為州大中正，鄉人任讓輕薄無行，為恆所黜。及讓在峻軍中，任勢多所殺害，見恆輒恭敬，不肆其虐。鐘雅、劉超之死，亦將及恆，讓盡心救衛，故得免。","raw_start":7808,"raw_end":7881,"raw_line":99},"chapter_id":"c-jinshu-044-huaheng","book_id":"b-jinshu-044","work_id":"w-jinshu","source_id":"s-jinshu-044-huaheng"},{"id":"c-jinshu-070-appraisal:p001","text":"史臣曰：應詹行業聿修，文史足用，入居列位，則嘉謀屢陳；出撫藩條，則惠政斯洽。甘卓伐暴寧亂，庸績克宣，作鎮扞城，威略具舉。及兇渠犯順，志在勤王。既而人撓其謀，天奪其鑒，疑留不斷，自取誅夷。卞壼束帶立朝，以匡正爲己任；褰裳衛主，蹈忠義以成名。遂使臣死於君，子死於父，惟忠與孝，萃其一門。古稱社稷之臣，忠貞之謂矣。劉超勤肅奉上，鍾雅正直當官。屬巨猾滔天，幼君危逼，乃崎嶇寇難，契闊艱虞，匪石爲心，寒松比操，貞軌皆沒，亮跡雙升。雖高赫在難彌恭，荀息繼之以死，方之二子，曾何足云！","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":122,"last_line":122,"raw_start":12352,"raw_end":12594,"raw_character_offsets":[12359,12360,12361,12362,12363,12364,12365,12366,12367,12368,12369,12370,12371,12372,12373,12374,12375,12376,12377,12378,12379,12380,12381,12382,12383,12384,12385,12386,12387,12388,12389,12390,12391,12392,12393,12394,12395,12396,12397,12398,12399,12400,12401,12402,12403,12404,12405,12406,12407,12408,12409,12410,12411,12412,12413,12414,12415,12416,12417,12418,12419,12420,12421,12422,12423,12424,12425,12426,12427,12428,12429,12430,12431,12432,12433,12434,12435,12436,12437,12438,12439,12440,12441,12442,12443,12444,12445,12446,12447,12448,12449,12450,12451,12452,12453,12454,12455,12456,12457,12458,12459,12460,12461,12462,12463,12464,12465,12466,12467,12468,12469,12470,12471,12472,12473,12474,12475,12476,12477,12478,12479,12480,12481,12482,12483,12484,12485,12486,12487,12488,12489,12490,12491,12492,12493,12494,12495,12496,12497,12498,12499,12500,12501,12502,12503,12504,12505,12506,12507,12508,12509,12510,12511,12512,12513,12514,12515,12516,12517,12518,12519,12520,12521,12522,12523,12524,12525,12526,12527,12528,12529,12530,12531,12532,12533,12534,12535,12536,12537,12538,12539,12540,12541,12542,12543,12544,12545,12546,12547,12548,12549,12550,12551,12552,12553,12554,12555,12556,12557,12558,12559,12560,12561,12562,12563,12564,12565,12566,12567,12568,12569,12570,12571,12572,12573,12574,12575,12576,12577,12578,12579,12580,12581,12582,12583,12584,12585,12586,12587,12588,12589,12590,12591,12592,12593],"revision_id":2595540},"mentions":[{"id":"c-jinshu-070-appraisal:p001:m0004","surface":"應詹","start":4,"end":6,"person_id":"4kn_kz5_zrm","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-070-appraisal:p001:m0038","surface":"甘卓","start":38,"end":40,"person_id":"csn_tgm_oe7","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-070-appraisal:p001:m0093","surface":"卞壼","start":93,"end":95,"person_id":"4z4_ujq_8yo","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-070-appraisal:p001:m0154","surface":"劉超","start":154,"end":156,"person_id":"dha_hxh_mqj","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-070-appraisal:p001:m0161","surface":"鍾雅","start":161,"end":163,"person_id":"j81_pcr_llk","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-070-appraisal:p001:m0211","surface":"高赫","start":211,"end":213,"person_id":"xzx_na4_wp8","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-070-appraisal:p001:m0218","surface":"荀息","start":218,"end":220,"person_id":"g14_wpb_odv","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-070-appraisal","book_id":"b-jinshu-070","work_id":"w-jinshu","source_id":"s-jinshu-070-appraisal-ws2595540"},{"id":"c-jinshu-070-liuchao:p001","text":"劉超字世瑜，琅邪臨沂人，漢城陽景王章之後也。章七世孫封臨沂縣慈鄉侯，子孫因家焉。父和，爲琅邪國上軍將軍。超少有志尚，爲縣小吏，稍遷琅邪國記室掾。以忠謹清慎爲元帝所拔，恒親侍左右，遂從渡江，轉安東府舍人，專掌文檄。相府建，又爲舍人。于時天下擾亂，伐叛討貳，超自以職在近密，而書跡與帝手筆相類，乃絕不與人交書。時出休沐，閉門不通賓客，由是漸得親密。以左右勤勞，賜爵原鄉亭侯，食邑七百戶，轉行參軍。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":100,"last_line":100,"raw_start":10241,"raw_end":10444,"raw_character_offsets":[10248,10249,10250,10251,10252,10253,10254,10255,10256,10257,10258,10259,10260,10261,10262,10263,10264,10265,10266,10267,10268,10269,10270,10271,10272,10273,10274,10275,10276,10277,10278,10279,10280,10281,10282,10283,10284,10285,10286,10287,10288,10289,10290,10291,10292,10293,10294,10295,10296,10297,10298,10299,10300,10301,10302,10303,10304,10305,10306,10307,10308,10309,10310,10311,10312,10313,10314,10315,10316,10317,10318,10319,10320,10321,10322,10323,10324,10325,10326,10327,10328,10329,10330,10331,10332,10333,10334,10335,10336,10337,10338,10339,10340,10341,10342,10343,10344,10345,10346,10347,10348,10349,10350,10351,10352,10353,10354,10355,10356,10357,10358,10359,10360,10361,10362,10363,10364,10365,10366,10367,10368,10369,10370,10371,10372,10373,10374,10375,10376,10377,10378,10379,10380,10381,10382,10383,10384,10385,10386,10387,10388,10389,10390,10391,10392,10393,10394,10395,10396,10397,10398,10399,10400,10401,10402,10403,10404,10405,10406,10407,10408,10409,10410,10411,10412,10413,10414,10415,10416,10417,10418,10419,10420,10421,10422,10423,10424,10425,10426,10427,10428,10429,10430,10431,10432,10433,10434,10435,10436,10437,10438,10439,10440,10441,10442,10443],"revision_id":2595540},"mentions":[{"id":"c-jinshu-070-liuchao:p001:m0000","surface":"劉超","start":0,"end":2,"person_id":"dha_hxh_mqj","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-070-liuchao:p001:m0017","surface":"章","start":17,"end":18,"person_id":"yqp_nlb_p1p_ABF","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-070-liuchao:p001:m0041","surface":"和","start":41,"end":42,"person_id":"gyj_vvj_38e","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-070-liuchao:p001:m0078","surface":"元帝","start":78,"end":80,"person_id":"dkn_ge4_286_AAAAAAA","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-070-liuchao","book_id":"b-jinshu-070","work_id":"w-jinshu","source_id":"s-jinshu-070-liuchao-ws2595540"},{"id":"c-jinshu-070-liuchao:p003","text":"及蘇峻謀逆，超代趙胤爲左衛將軍。時京邑大亂，朝士多遣家人入東避難。義興故吏欲迎超家，而超不聽，盡以妻孥入處宮內。及王師敗績，王導以超爲右衛將軍，親侍成帝。屬太后崩，軍衛禮章損闕，超躬率將士奉營山陵。峻遷車駕石頭，時天大雨，道路沈陷，超與侍中鍾雅步侍左右，賊給馬不肯騎，而悲哀慷慨。峻聞之，甚不平，然未敢加害，而以其所親信許方等補司馬督、殿中監，外託宿衛，內實防禦超等。時饑饉米貴，峻等問遺，一無所受，繾綣朝夕，臣節愈恭。帝時年八歲，雖幽厄之中，超猶啟授孝經、論語。溫嶠等至，峻猜忌朝士，而超爲帝所親遇，疑之尤甚。後王導出奔，超與懷德令匡術、建康令管旆等密謀，將欲奉帝而出。未及期，事泄，峻使任讓將兵入收超及鍾雅。帝抱持悲泣曰：「還我侍中、右衛！」任讓不奉詔，因害之。及峻平，任讓與陶侃有舊，侃欲特不誅之，乃請於帝。帝曰：「讓是殺我侍中、右衛者，不可宥。」由是遂誅讓。及超將改葬，帝痛念之不已，詔遷高顯近地葬之，使出入得瞻望其墓。追贈衛尉，諡曰忠。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":104,"last_line":104,"raw_start":10889,"raw_end":11370,"raw_character_offsets":[10896,10897,10898,10899,10900,10901,10902,10903,10904,10905,10906,10907,10908,10909,10910,10911,10912,10913,10914,10915,10916,10917,10918,10919,10920,10921,10922,10923,10924,10925,10926,10927,10928,10929,10930,10931,10932,10933,10934,10935,10936,10937,10938,10939,10940,10941,10942,10943,10944,10945,10946,10947,10948,10949,10950,10951,10952,10953,10954,10955,10956,10957,10958,10959,10960,10961,10962,10963,10964,10965,10966,10967,10968,10969,10970,10971,10972,10973,10974,10975,10976,10977,10978,10979,10980,10981,10982,10983,10984,10985,10986,10987,10988,10989,10990,10991,10992,10993,10994,10995,10996,10997,10998,10999,11000,11001,11002,11003,11004,11005,11006,11007,11008,11009,11010,11011,11012,11013,11014,11015,11016,11017,11018,11019,11020,11021,11022,11023,11024,11025,11026,11027,11028,11029,11030,11031,11032,11033,11034,11035,11036,11037,11038,11039,11040,11041,11042,11043,11044,11045,11046,11047,11048,11049,11050,11051,11052,11053,11054,11055,11056,11057,11058,11059,11060,11061,11062,11063,11064,11065,11066,11067,11068,11069,11070,11071,11072,11073,11074,11075,11076,11077,11078,11079,11080,11081,11082,11083,11084,11085,11086,11087,11088,11089,11090,11091,11092,11093,11094,11095,11096,11097,11098,11099,11100,11101,11102,11103,11104,11105,11106,11107,11108,11109,11110,11111,11112,11113,11114,11115,11116,11117,11118,11119,11120,11121,11122,11123,11124,11125,11126,11127,11128,11129,11130,11131,11132,11133,11134,11135,11136,11137,11138,11139,11140,11141,11142,11143,11144,11145,11146,11147,11148,11149,11150,11151,11152,11153,11154,11155,11156,11157,11158,11159,11160,11161,11162,11163,11164,11165,11166,11167,11168,11169,11170,11171,11172,11173,11174,11175,11176,11177,11178,11179,11180,11181,11182,11183,11184,11185,11186,11187,11188,11189,11190,11191,11192,11193,11194,11195,11196,11197,11198,11199,11200,11201,11253,11254,11255,11256,11257,11258,11259,11260,112