登","kind":"person","person_id":"572_278_cba_C","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-deng:line012:m0003","start":3,"end":5,"surface":"子高","kind":"person","person_id":"572_278_cba_C","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-deng:line012:m0006","start":6,"end":7,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-deng:line012:m0018","start":18,"end":19,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-deng:line012:m0024","start":24,"end":25,"surface":"登","kind":"person","person_id":"572_278_cba_C","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-deng:line012:m0035","start":35,"end":36,"surface":"登","kind":"person","person_id":"572_278_cba_C","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-deng:line012:m0045","start":45,"end":46,"surface":"登","kind":"person","person_id":"572_278_cba_C","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-deng:line012:m0067","start":67,"end":70,"surface":"諸葛恪","kind":"person","person_id":"512_1cd_a4b","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-deng:line012:m0071","start":71,"end":73,"surface":"張休","kind":"person","person_id":"roi_rz4_ute_A","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-deng:line012:m0074","start":74,"end":76,"surface":"顧譚","kind":"person","person_id":"syc_ik6_bq5_**AAA","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-deng:line012:m0077","start":77,"end":79,"surface":"陳表","kind":"person","person_id":"djn_r5z_2w9","status":"contextual_prov