{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"rdi_4hu_4m7","canonical_person_id":"rdi_4hu_4m7","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["rdi_4hu_4m7"],"persons":[{"id":"rdi_4hu_4m7","label":"賈棱〔陸機軍將；帝紀作崇〕","status":"active","historicity":"historical_tradition","aliases":[{"surface":"賈棱","mention_ids":["c-jinshu-054-lu-ji:p029:m0412"]}],"evidence":[{"mention_id":"c-jinshu-054-lu-ji:p029:m0412","paragraph_id":"c-jinshu-054-lu-ji:p029","chapter_id":"c-jinshu-054-lu-ji","quote":"賈棱"}],"review":"ai_provisional","identity_note":"賈棱〔陸機軍將；帝紀作崇〕，見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-jinshu-054-lu-ji-ws2605147","work_id":"w-jinshu","book_id":"b-jinshu-054","chapter_id":"c-jinshu-054-lu-ji","raw_mention_count":1,"mention_ids":["c-jinshu-054-lu-ji:p029:m0412"],"paragraph_ids":["c-jinshu-054-lu-ji:p029"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-054-lu-ji:p029:m0412","mention_ids":["c-jinshu-054-lu-ji:p029:m0412"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-054-lu-ji-ws2605147"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-054-lu-ji:p029:m0412","start":412,"end":414,"surface":"賈棱","kind":"person","person_id":"rdi_4hu_4m7","status":"contextual_provisional","paragraph_id":"c-jinshu-054-lu-ji:p029","chapter_id":"c-jinshu-054-lu-ji"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-054-lu-ji:p029","text":"時成都王穎推功不居，勞謙下士。機既感全濟之恩，又見朝廷屢有變難，謂穎必能康隆晉室，遂委身焉。穎以機參大將軍軍事，表為平原內史。太安初，穎與河間王顒起兵討長沙王乂，假機後將軍、河北大都督，督北中郎將王粹、冠軍牽秀等諸軍二十餘萬人。機以三世為將，道家所忌，又羈旅入宦，屯居群士之右，而王粹、牽秀等皆有怨心，固辭都督。穎不許。機鄉人孫惠亦勸機讓都督于粹，機曰：「將謂吾為首鼠避賊，適所以速禍也。」遂行。穎謂機曰：「若功成事定，當爵為郡公，位以台司，將軍勉之矣！」機曰：「昔齊桓任夷吾以建九合之功，燕惠疑樂毅以失垂成之業，今日之事，在公不在機也。」穎左長史盧志心害機寵，言於穎曰：「陸機自比管、樂，擬君暗主，自古命將遣師，未有臣陵其君而可以濟事者也。」穎默然。機始臨戎，而牙旗折，意甚惡之。列軍自朝歌至於河橋，鼓聲聞數百里，漢、魏以來，出師之盛，未嘗有也。長沙王乂奉天子與機戰于鹿苑，機軍大敗，赴七里澗而死者如積焉，水為之不流，將軍賈棱皆死之。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":68,"last_line":68,"raw_start":6709,"raw_end":7127,"raw_character_offsets":[6709,6710,6711,6712,6713,6714,6715,6716,6717,6718,6719,6720,6721,6722,6723,6724,6725,6726,6727,6728,6729,6730,6731,6732,6733,6734,6735,6736,6737,6738,6739,6740,6741,6742,6743,6744,6745,6746,6747,6748,6749,6750,6751,6752,6753,6754,6755,6756,6757,6758,6759,6760,6761,6762,6763,6764,6765,6766,6767,6768,6769,6770,6771,6772,6773,6774,6775,6776,6777,6778,6779,6780,6781,6782,6783,6784,6785,6786,6787,6788,6789,6790,6791,6792,6793,6794,6795,6796,6797,6798,6799,6800,6801,6802,6803,6804,6805,6806,6807,6808,6809,6810,6811,6812,6813,6814,6815,6816,6817,6818,6819,6820,6821,6822,6823,6824,6825,6826,6827,6828,6829,6830,6831,6832,6833,6834,6835,6836,6837,6838,6839,6840,6841,6842,6843,6844,6845,6846,6847,6848,6849,6850,6851,6852,6853,6854,6855,6856,6857,6858,6859,6860,6861,6862,6863,6864,6865,6866,6867,6868,6869,6870,6871,6872,6873,6874,6875,6876,6877,6878,6879,6880,6881,6882,6883,6884,6885