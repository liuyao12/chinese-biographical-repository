olicy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-060-yanding:p002:m0025","surface":"王毗","start":25,"end":27,"person_id":"l53_vss_g0u","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-060-yanding:p002","chapter_id":"c-jinshu-060-yanding"},{"id":"c-jinshu-060-yanding:p003:m0012","surface":"王毗","start":12,"end":14,"person_id":"l53_vss_g0u","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-060-yanding:p003","chapter_id":"c-jinshu-060-yanding"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-060-yanding:p002","text":"鼎少有大志，因西土人思歸，欲立功鄉里，乃與撫軍長史王毗、司馬傳遜懷翼戴秦王之計，謂疇、捷等曰：「山東非霸王處，不如關中。」河陽令傅暢遺鼎書，勸奉秦王過洛陽，謁拜山陵，徑據長安，綏合夷晉，興起義眾，克復宗廟，雪社稷之恥。鼎得書，便欲詣洛，流人謂北道近河，懼有抄截，欲南自武關向長安。疇等皆山東人，咸不願西入，荀籓及疇、捷等並逃散。鼎追籓不及，暅等見殺，唯顗、述走得免。遂奉秦王行，止上洛，為山賊所襲，殺百餘人，率餘眾西至藍田。時劉聰向長安，為雍州刺史賈疋所逐，走還平陽。疋遣人奉迎秦王，遂至長安，而與大司馬南陽王保、衛將軍梁芬、京兆尹梁綜等並同心推戴，立王為皇太子，登壇告天，立社稷宗廟，以鼎為太子詹事，總攝百揆。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":94,"last_line":94,"raw_start":7949,"raw_end":8257,"raw_character_offsets":[7951,7952,7953,7954,7955,7956,7957,7958,7959,7960,7961,7962,7963,7964,7965,7966,7967,7968,7969,7970,7971,7972,7973,7974,7975,7976,7977,7978,7979,7980,7981,7982,7983,7984,7985,7986,7987,7988,7989,7990,7991,7992,7993,7994,7995,7996,7997,7998,7999,8000,8001,8002,8003,8004,8005,8006,8007,8008,8009,8010,8011,8012,8013,8014,8015,8016,8017,8018,8019,8020,8021,8022,8023,8024,8025,8026,8027,8028,8029