rson","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan-sons-intro:p001:m0022","surface":"範","start":22,"end":23,"person_id":"9ec_nm1_cfh","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan-sons-intro:p001:m0024","surface":"岱","start":24,"end":25,"person_id":"287_n93_pi3","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-066-taokan-sons-intro","book_id":"b-jinshu-066","work_id":"w-jinshu","source_id":"s-jinshu-066-taokan-sons-intro-ws1527632"},{"id":"c-jinshu-066-taokan:p017","text":"遣子斌與南中郎將桓宣西伐樊城，走石勒將郭敬。使兄子臻、竟陵太守李陽等共破新野，遂平襄陽。拜大將軍，劍履上殿，入朝不趨，贊拜不名。上表固讓，曰：「臣非貪於疇昔，而虛讓於今日。事有合于時宜，臣豈敢與陛下有違；理有益於聖世，臣豈與朝廷作異。臣常欲除諸浮長之事，遣諸虛假之用，非獨臣身而已。若臣杖國威靈，梟雄斬勒，則又何以加！」咸和七年六月疾篤，又上表遜位曰：","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":61,"last_line":61,"raw_start":7557,"raw_end":7742,"raw_character_offsets":[7559,7560,7561,7562,7563,7564,7565,7566,7567,7568,7569,7570,7571,7572,7573,7574,7575,7576,7577,7578,7579,7580,7581,7582,7583,7584,7585,7586,7587,7588,7589,7590,7591,7592,7593,7594,7595,7596,7597,7598,7599,7600,7601,7602,7603,7604,7605,7606,7607,7608,7609,7610,7611,7612,7613,7614,7615,7616,7617,7618,7619,7620,7621,7622,7623,7624,7625,7626,7627,7628,7629,7630,7631,7632,7633,7634,7635,7636,7637,7638,7639,7640,7641,7642,7643,7644,7645,7646,7647,7648,7649,7650,7651,7652,7653,7654,7655,7656,7657,7658,7659,7660,7661,7662,7663,7664,7665,7666,7667,7668,7669,7670,7671,7672,7673,7674,7675,7676,7677,7678,7679,7680,7681,7682,7683,7684,7685,7686,7687,7688,7689,7690,7691,7692,7693,7694,7695,7696,7697,7698,7699,7700,7701,7702,7703,7704,7705,7706,7707,7708,7709,7710,7711,7712,7713,7714,7715,7716,7717,7718,7724,7725,7726,7727,7730,7731,7732,7733,7734,7735,7736,7737,7738,7739,7740,7741],"revision_id":1527632},"mentions":[{"id":"c-jinshu-066-taokan:p017:m0002","surface":"斌","start":2,"end":3,"person_id":"byj_6mo_vpe","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p017:m00