l"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-wu063-zhaoda-1","subject_person_id":"1ym_27m_i6s","object_person_id":"9vq_kh2_cfv","predicate":"teacher","qualifiers":{"source_term":"公孫滕少師事達","relationship_basis":"teaching"},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-063","chapter_id":"c-sanguozhi-063-zhaoda","source_id":"s-sanguozhi-063-zhaoda","paragraph_id":"c-sanguozhi-063-zhaoda:line039","quote":"達寶惜其術，自闞澤、殷禮皆名儒善士，親屈節就學，達祕而不告，太史丞公孫滕少師事達，勤苦累年，達許敎之者有年數矣，臨當喻語而輒復止。滕他日齎酒具，候顏色，拜跪而請。達曰：「吾先人得此術，欲圖爲帝王師，至仕來三世，不過太史郎，誠不欲復傳之。且此術微妙，頭乘尾除，一算之法，父子不相語。然以子篤好不倦，今真以相授矣。」飲酒數行，達起取素書兩眷，大如手指，達曰：「當寫讀此，則自解也。吾久廢，不復省之。今欲思論一過，數日當以相與。」滕如期往，至乃陽求索書，驚言失之，云：「女婿昨來，必是渠所竊。」遂從此絕。","subject_person_mention_id":"c-sanguozhi-063-zhaoda:line039:m0033","object_person_mention_id":"c-sanguozhi-063-zhaoda:line039:m0000"}],"interpretation_note":"以此來源所述兩端為據。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-063-zhaoda:line039:m0033","start":33,"end":36,"surface":"公孫滕","kind":"person","person_id":"1ym_27m_i6s","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-063-zhaoda:line039","chapter_id":"c-sanguozhi-063-zhaoda"},{"id":"c-sanguozhi-063-zhaoda:line039:m0065","start":65,"end":66,"surface":"滕","kind":"person","person_id":"1ym_27m_i6s","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-063-zhaoda:line039","chapter_id":"c-sanguozhi-063-zhaoda"},{"id":"c-sanguozhi-063-zhaoda:line039:m0212","start":212,"end":213,"surface":"滕","kind":"person","person_id":"1ym_27m_i6s","status":"contextual_pro