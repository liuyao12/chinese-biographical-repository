er_constraints":[],"identity_decisions":[{"id":"d-shiji054-041","person_id":"g9g_mv1_6zj","surfaces":["蓋公"],"scope":"same_chapter","chapter_ids":["c-shiji-054-cao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-054-cao:p009","quote":"孝惠帝元年，除諸侯相國法，更以參為齊丞相。參之相齊，齊七十城。天下初定，悼惠王富於春秋，參盡召長老諸生，問所以安集百姓，如齊故［俗］諸儒以百數，言人人殊，參未知所定。聞膠西有蓋公，善治黃老言，使人厚幣請之。既見蓋公，蓋公為言治道貴清靜而民自定，推此類具言之。參於是避正堂，舍蓋公焉。其治要用黃老術，故相齊九年，齊國安集，大稱賢相。"}],"rationale":"依本篇明示姓名與局部軍事、任官及子嗣敘事暫接；曹氏時、襄不按單字全域配對。未名者不補姓名，秦司馬夷字待底本核定，田既與田溉不擅同指。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji080-044","person_id":"g9g_mv1_6zj","scope":"same_chapter","chapter_ids":["c-shiji-080-leyi"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["蓋公"],"evidence":[{"paragraph_id":"c-shiji-080-leyi:p020","quote":"太史公曰：始齊之蒯通及主父偃讀樂毅之報燕王書，未嘗不廢書而泣也。樂臣公學黃帝、老子，其本師號曰河上丈人，不知其所出。河上丈人教安期生，安期生教毛翕公，毛翕公教樂瑕公，樂瑕公教樂臣公，樂臣公教蓋公。蓋公教於齊高密、膠西，為曹相國師。"}],"rationale":"樂閒明示為樂毅子，樂叔明示為孫，不補闕代父親；樂乘為樂閒宗不補兄弟。燕王喜來書及趙襄王君序各限本段，曹相國未見名字不回填。河上丈人至蓋公師承不作父子。依本篇明示姓名、君序與來書答書範圍暫接；燕惠王來書寡人指惠王、將軍指樂毅，樂毅答書先王指昭王、足下君王指惠王。伍子胥引古首吳王指闔閭，後吳王在夫差賜鴟夷後指夫差。父兄與群臣不補具體親屬，王齊為反間假說不作授王爵。"}],"equivalence_decisions":[{"id":"eq-shiji080-gaigong","person_ids":["g9g_mv1_6zj"],"canonical_person_id":"g9g_mv1_6zj","scope":"cross_chapter","chapter_ids":["c-shiji-080-leyi","c-shiji-054-cao"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-080-leyi","source_id":"s-shiji-080-leyi","paragraph_id":"c-shiji-080-leyi:p020","quote":"太史公曰：始齊之蒯通及主父偃讀樂毅之報燕王書，未嘗不廢書而泣也。樂臣公學黃帝、老子，其本師號曰河上丈人，不知其所出。河上丈人教安期生，安期生教毛翕公，毛翕公教樂瑕公，樂瑕公教樂臣公，樂臣公教蓋公。蓋公教於齊高密、膠西，為曹相國師。","mention_ids":["c-shiji-080-leyi:m020-0095","c-shiji-080-leyi:m020-0098"]},{"chapter_id":"c-shiji-054-cao","source_id":"s-shiji-054-cao","paragraph_id":"c-shiji-054-cao:p009","quote":"孝惠帝元年，除諸侯相國法，更以參為齊丞相。參之相齊，齊七十城。天下初定，悼惠王富於春秋，參盡召長老諸生，問所以安集百姓，如齊故［俗］諸儒以百數，言人人殊，參未知所定。聞膠西有蓋公，善治黃老言，使人厚幣請之。既見蓋公，蓋公為言治道貴清靜而民自定，推此類具言之。參於是避正堂，舍蓋公焉。其治要用黃老術，故相齊九年，齊國安集，大稱賢相。","mention_ids":["c-shiji-054-cao:m009-0087","c-shiji-054-cao:m009-0105","c-shiji-054-cao:m009-0108","c-shiji-054-cao:m009-0137"]}],"rationale":"本篇蓋公教於膠西並為曹相國師，曹相國世家曹參聞膠西蓋公善黃老而厚幣請之、舍正堂為之，地點、學說及受教者相配。師承不作血親，不補完整師承年代。 原文與提及錨點保留，同書不當獨立見證，未核底本影像。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true}],"passages":[{"id":"c-shiji-054-cao:p009","text":"孝惠帝元年，除諸侯相國法，更以參為齊丞相。參之相齊，齊七十城。天下初定，悼惠王富於春秋，參盡召長老諸生，問所以安集百姓，如齊故［俗］諸儒以百數，言人人殊，參未知所定。聞膠西有蓋公，善治黃老言，使人厚幣請之。既見蓋公，蓋公為言治道貴清靜而民自定，推此類具言之。參於是避正堂，舍蓋公焉。其治要用黃老術，故相齊九年，齊國安集，大稱賢相。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-054-cao:m009-0000","start":0,"end":3,"surface":"孝惠帝","kind":"person","person_id":"yqp_nlb_p1p_AA","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m009-0015","start":15,"end":16,"surface":"參","kind":"person","person_id":"37j_16p_7n8","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m009-0021","start":21,"end":22,"surface":"參","kind":"person","person_id":"37j_16p_7n8","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m009-0036","start":36,"end":39,"surface":"悼惠王","kind":"person","person_id":"yqp_nlb_p1p_AB","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m009-0044","start":44,"end":45,"surface":"參","kind":"person","person_id":"37j_16p_7n8","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m009-0047","start":47,"end":51,"surface":"長老諸生","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名署稱、群體、學說合稱或代詞待核，不補姓名、親屬成員或全域帝號。"},{"id":"c-shiji-054-cao:m009-0077","start":77,"end":78,"surface":"參","kind":"person","person_id":"37j_16p_7n8","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m009-0087","start":87,"end":89,"surface":"蓋公","kind":"person","person_id":"g9g_mv1_6zj","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m009-0092","start":92,"end":94,"surface":"黃老","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名署稱、群體、學說合稱或代詞待核，不補姓名、親屬成員或全域帝號。"},{"id":"c-shiji-054-cao:m009-0105","start":105,"end":107,"surface":"