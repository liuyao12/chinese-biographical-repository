id":"s-shiji-007-xiangyu"},{"id":"c-shiji-008-gaozu:p051","text":"項羽解而東歸。漢王欲引而西歸，用留侯、陳平計，乃進兵追項羽，至陽夏南止軍，與齊王信、建成侯彭越期會而擊楚軍。至固陵，不會。楚擊漢軍，大破之。漢王復入壁，深塹而守之。用張良計，於是韓信、彭越皆往。及劉賈入楚地，圍壽春，漢王敗碧陵，乃使使者召大司馬周殷舉九江兵而迎（之）武王，行屠城父，隨（何）劉賈、齊梁諸侯皆大會垓下。立武王布為淮南王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m051-0000","start":0,"end":2,"surface":"項羽","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m051-0007","start":7,"end":9,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m051-0016","start":16,"end":18,"surface":"留侯","kind":"person","person_id":"ea5_zvr_hlp","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m051-0019","start":19,"end":21,"surface":"陳平","kind":"person","person_id":"i3f_9l9_g53","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m051-0027","start":27,"end":29,"surface":"項羽","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m051-0038","start":38,"end":41,"surface":"齊王信","kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m051-0045","start":45,"end":47,"surface":"彭越","kind":"person","person_id":"9qt_orl_5f2","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m051-0070","start":70,"end":72,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m051-0083","start":83,"end":85,"surface":"張良","kind":"person","person_id":"ea5_zvr_hlp","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m051-0089","start":89,"end":91,"surface":"韓信","kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m051-0092","start":92,"end":94,"surface":"彭越","kind":"person","person_id":"9qt_orl_5f2","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m051-0098","start":