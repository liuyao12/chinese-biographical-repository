_provisional"},{"id":"c-shiji-065-sun:m001-0444","start":444,"end":446,"surface":"吳王","kind":"person","person_id":"dna_233_hvk","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m001-0464","start":464,"end":466,"surface":"孫子","kind":"person","person_id":"vax_w2r_0za","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m001-0484","start":484,"end":486,"surface":"闔廬","kind":"person","person_id":"dna_233_hvk","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m001-0487","start":487,"end":489,"surface":"孫子","kind":"person","person_id":"vax_w2r_0za","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m001-0513","start":513,"end":515,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代；不補姓名、成員或肯定公主同一性。"},{"id":"c-shiji-065-sun:m001-0516","start":516,"end":518,"surface":"孫子","kind":"person","person_id":"vax_w2r_0za","status":"contextual_provisional"}],"chapter_id":"c-shiji-065-sun","book_id":"b-shiji-065","work_id":"w-shiji","source_id":"s-shiji-065-sun"},{"id":"c-shiji-065-sun:p002","text":"孫武既死，後百餘歲有孫臏。臏生阿鄄之閒，臏亦孫武之後世子孫也。孫臏嘗與龐涓俱學兵法。龐涓既事魏，得為惠王將軍，而自以為能不及孫臏，乃陰使召孫臏。臏至，龐涓恐其賢於己，疾之，則以法刑斷其兩足而黥之，欲隱勿見。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-065-sun:m002-0000","start":0,"end":2,"surface":"孫武","kind":"person","person_id":"vax_w2r_0za","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m002-0010","start":10,"end":12,"surface":"孫臏","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m002-0013","start":13,"end":14,"surface":"臏","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m002-0020","start":20,"end":21,"surface":"臏","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m002-0022","start":22,"end":24,"surface":"孫武","kind":"person","person_id":"vax_w2r_0za","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m002-0031","start":31,"end":33,"surface":"孫臏","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m002-0035","start":35,"end":37,"surface":"龐涓","kind":"person","person_id":"id5_d3k_vsc","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m002-0042","start":42,"end":44,"surface":"龐涓","kind":"person","person_id":"id5_d3k_vsc","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m002-0050","start":50,"end":52,"surface":"惠王","kind":"person","person_id":"t8k_az0_xk2","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m002-0062","start":62,"end":64,"surface":"孫臏","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m002-0069","start":69,"end":71,"surface":"孫臏","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m002-0072","start":72,"end":73,"surface":"臏","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m002-0075","start":75,"end":77,"surface":"龐涓","kind":"person","person_id":"id5_d3k_vsc","status":"contextual_provisional"}],"chapter_id":"c-shiji-065-sun","book_id":"b-shiji-065","work_id":"w-shiji","source_id":"s-shiji-065-sun"},{"id":"c-shiji-066-wu:p009","text":"楚誅其大臣郤宛、伯州犁，伯州犁之孫伯嚭亡奔吳，吳亦以嚭為大夫。前王僚所遣二公子將兵伐楚者，道絕不得歸。後聞闔廬弒王僚自立，遂以其兵降楚，楚封之於舒。闔廬立三年，乃興師與伍胥、伯嚭伐楚，拔舒，遂禽故吳反二將軍。因欲至郢，將軍孫武曰：「民勞，未可，且待之。」乃歸。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-066-wu:m009-0005","start":5,"end":7,"surface":"郤宛","kind":"person","person_id":"d0b_8uf_u5w","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m009-0008","start":8,"end":11,"surface":"伯州犁","kind":"person","person_id":"q1y_uet_htw","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m009-0012","start":12,"end":15,"surface":"伯州犁","kind":"person","person_id":"q1y_uet_htw","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m009-0017","start":17,"end":19,"surface":"伯嚭","kind":"person","person_id":"q1y_uet_htw_*A","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m009-0026","start":26,"end":27,"surface":"嚭","kind":"person","person_id":"q1y_uet_htw_*A","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m009-0032","start":32,"end":34,"surface":"王僚","kind":"person","person_id":"l0i_j1y_txo","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m009-0036","start":36,"end":39,"surface":"二公子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代，未補姓名及成員；鮑氏不直接等同鮑牧。"},{"id":"c-shiji-066-wu:m009-0053","start":53,"end":55,"surface":"闔廬","kind":"person","person_id":"yb7_umd_09d","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m009-0056","start":56,"end":58,"surface":"王僚","kind":"person","person_id":"l0i_j1y_txo","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m009-0074","start":74,"end":76,"surface":"闔廬","kind":"person","person_id":"yb7_umd_09d","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m009-0084","start":84,"end":86,"surface":"伍胥","kind":"person","person_id":"g9h_5ih_ug1_A","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m009-0087","start":87,"end":89,"surface":"伯嚭","kind":"person","person_id":"q1y_uet_htw_*A","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m009-0100","start":100,"end":103,"surface":"二將軍","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代，未補姓名及成員；鮑氏不直接等同鮑牧。"},{"id":"c-shiji-066-wu:m009-0111","start":111,"end":113,"surface":"孫武","kind":"person","person_id":"own_sic_s7j","status":"contextual_provisional"}],"chapter_id":"c-shiji-066-wu","book_id":"b-shiji-066","work_id":"w-shiji","source_id":"s-shiji-066-wu"},{"id":"c-shiji-066-wu:p011","text":"九年，吳王闔廬謂子胥、孫武曰：「始子言郢未可入，今果何如？」二子對曰：「楚將囊瓦貪，而唐、蔡皆怨之。王必欲大伐之，必先得唐、蔡乃可。」闔廬聽之，悉興師與唐、蔡伐楚，與楚夾漢水而陳。吳王之弟夫概將兵請從，王不聽，遂以其屬五千人擊楚將子常。己卯，楚昭王出奔。庚辰，吳王入郢。子常敗走，奔鄭。於是吳乘勝而前，五戰，遂至郢。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-066-wu:m011-0003","start":3,"end":7,"surface":"吳王闔廬","kind":"person","person_id":"yb7_umd_09d","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m011-0008","start":8,"end":10,"surface":"子胥","kind":"person","person_id":"g9h_5ih_ug1_A","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m011-0011","start":11,"end":13,"surface":"孫武","kind":"person","person_id":"own_sic_s7j","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m011-0030","start":30,"end":32,"surface":"二子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代，未補姓名及成員；鮑氏不直接等同鮑牧。"},{"id":"c-shiji-066-wu:m011-0038","start":38,"end":40,"surface":"囊瓦","kind":"person","person_id":"548_u01_jnh","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m011-0050","start":50,"end":51,"surface":"王","kind":"person","person_id":"yb7_umd_09d","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m011-0067","start":67,"end":69,"surface":"闔廬","kind":"person","person_id":"yb7_umd_09d","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m011-0090","start":90,"end":92,"surface":"吳王","kind":"person","person_id":"yb7_umd_09d","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m011-0094","start":94,"end":96,"surface":"夫概","kind":"person","person_id":"9j5_0wx_64h","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m011-0101","start":101,"end":102,"surface":"王","kind":"person","person_id":"yb7_umd_09d","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m011-0115","start":115,"end":117,"surface":"子常","kind":"person","person_id":"548_u01_jnh","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m011-0121","start":121,"end":124,"surface":"楚昭王","kind":"person","person_id":"rjl_5bl_0dm_A","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m011-0130","start":130,"end":132,"surface":"吳王","kind":"person","person_id":"yb7_umd_09d","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m011-0135","start":135,"end":137,"surface":"子常","kind":"person","person_id":"548_u01_jnh","status":"contextual_provisional"}],"chapter_id":"c-shiji-066-wu","book_id":"b-shiji-066","work_id":"w-shiji","source_id":"s-shiji-066-wu"},{"id":"c-shiji-066-wu:p014","text":"後二歲，闔廬使太子夫差將兵伐楚，取番。楚懼吳復大來，乃去郢，徙於鄀。當是時，吳以伍子胥、孫武之謀，西破彊楚，北威齊晉，南服越人。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-066-wu:m014-0004","start":4,"end":6,"surface":"闔廬","kind":"person","person_id":"yb7_umd_09d","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m014-0007","start":7,"end":11,"surface":"太子夫差","kind":"person","person_id":"yb7_umd_09d_A","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m014-0040","start":40,"end":43,"surface":"伍子胥","kind":"person","person_id":"g9h_5ih_ug1_A","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m014-0044","start":44,"end":46,"surface":"孫武","kind":"person","person_id":"own_sic_s7j","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m014-0061","start":61,"end":63,"surface":"越人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代，未補姓名及成員；鮑氏不直接等同鮑牧。"}],"chapter_id":"c-shiji-066-wu","book_id":"b-shiji-066","work_id":"w-shiji","source_id":"s-shiji-066-wu"}],"sources":[{"chapter_id":"c-shiji-065-sun","work_id":"w-shiji","book_id":"b-shiji-065","source_id":"s-shiji-065-sun","source":{"title":"史記／卷065","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷065","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷065&oldid=2567048","revision_id":2567048,"accessed_on":"2026-10-09","extent":"14段正文，排除註釋版及2段導覽，無索隱述贊。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"取得時HTML與固定修訂一致，只去外緣空白。已核（即封）是正文括號文字，原樣保留，不當新增授爵事件。保留控棬、搏撠、擣虛、鉆火、贏糧、戰鬬等原字。","note":"全14段已核讀，未核可靠底本、影像或現代研究。"}}},{"chapter_id":"c-shiji-066-wu","work_id":"w-shiji","book_id":"