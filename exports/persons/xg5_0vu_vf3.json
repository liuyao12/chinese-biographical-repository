_mentioned_source_ids":["s-jinshu-072-guopu-ws2595548"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-jinshu-072-guopu:identity29-98","kind":"identity","person_id":"xg5_0vu_vf3","source_quote":"呼曰：「嗣祖，嗣祖，焉知非福！」","reading":"承王敦所重的潁川陳述；原文以嗣祖呼其人。","note":"承王敦所重的潁川陳述；原文以嗣祖呼其人。","paragraph_id":"c-jinshu-072-guopu:p029","start_codepoint":98,"end_codepoint":114,"human_reviewed":false,"chapter_id":"c-jinshu-072-guopu","source_id":"s-jinshu-072-guopu-ws2595548"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-072-guopu:p029:m0070","surface":"陳述","start":70,"end":72,"person_id":"xg5_0vu_vf3","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-072-guopu:p029","chapter_id":"c-jinshu-072-guopu"},{"id":"c-jinshu-072-guopu:p029:m0102","surface":"嗣祖","start":102,"end":104,"person_id":"xg5_0vu_vf3","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-072-guopu:p029","chapter_id":"c-jinshu-072-guopu"},{"id":"c-jinshu-072-guopu:p029:m0105","surface":"嗣祖","start":105,"end":107,"person_id":"xg5_0vu_vf3","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-072-guopu:p029","chapter_id":"c-jinshu-072-guopu"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-072-guopu:p029","text":"璞以母憂去職，卜葬地于暨陽，去水百步許。人以近水為言，璞曰：「當即為陸矣。」其後沙漲，去墓數十里皆為桑田。未期，王敦起璞為記室參軍。是時潁川陳述為大將軍掾，有美名，為敦所重，未幾而沒。璞哭之哀甚，呼曰：「嗣祖，嗣祖，焉知非福！」夫幾而敦作難。時明帝即位逾年，未改號，而熒惑守房。璞時休歸，帝乃遣使齎手詔問璞。會暨陽縣復上言曰赤烏見。璞乃上疏請改年肆赦，文多不載。璞嘗為人葬，帝微服往觀之，因問主人何以葬龍角，此法當滅族。主人曰：「郭璞雲此葬龍耳，不出三年當致天子也。」帝曰：「出天子邪？」答曰：「能致天子問耳。」帝甚異之。璞素與桓彝友善，彝每造之，或值璞在婦間，便入。璞曰：「卿來，他處自可徑前，但不可廁上相尋耳。必客主有殃。」彝後因醉詣璞，正逢在廁，掩而觀之，見璞裸身被髮，銜刀設醊。璞見彝，撫心大驚曰：「吾每屬卿勿來，反更如是！非但禍吾，卿亦不免矣。天實為之，將以誰咎！」璞終嬰王敦之禍，彝亦死蘇峻之難。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":66,"last_line":66,"raw_start":5304,"raw_end":5708,"raw_character_offsets":[5304,5305,5306,5307,5308,5309,5310,5311,5312,5313,5314,5315,5316,5317,5318,5319,5320,5321,5322,5323,5324,5325,5326,5327,5328,5329,5330,5331,5332,5333,5334,5335,5336,5337,5338,5339,5340,5341,5342,5343,5344,5345,5346,5347,5348,5349,5350,5351,5352,5353,5354,5355,5356,5357,5358,5359,5360,5361,5362,5363,5364,5365,5366,5367,5368,5369,5370,5371,5372,5373,5374,5375,5376,5377,5378,5379,5380,5381,5382,5383,5384,5385,5386,5387,5388,5389,5390,5391,5392,5393,5394,5395,5396,5397,5398,5399,5400,5401,5402,5403,5404,5405,5406,5407,5408,5409,5410,5411,5412,5413,5414,5415,5416,5417,5418,5419,5420,5421,5422,5423,5424,5425,5426,5427,5428,5429,5430,5431,5432,5433,5434,5435,5436,5437,5438,5439,5440,5441,5442,5443,5444,5445,5446,5447,5448,5449,5450,5451,5452,5453,5454,5455,5456,5457,5458,5459,5460,5461,5462,5463,5464,5465,5466,5467,5468,5469,5470,5471,5472,5473,5474,5475,5476,5477,5478,5479,5480,5481,5482,5483,5484,5485,5486,5487,5488,5489,5490,5491,5492,5493,5494,5495,5496,5497,5498,5499,5500,5501,5502,5503,5504,5505,5506,5507,5508,5509,5510,5511,5512,5513,5514,5515,5516,5517,5518,5519,5520,5521,5522,5523,5524,5525,5526,5527,5528,5529,5530,5531,5532,5533,5534,5535,5536,5537,5538,5539,5540,5541,5542,5543,5544,5545,5546,5547,5548,5549,5550,5551,5552,5553,5554,5555,5556,5557,5558,5559,5560,5561,5562,5563,5564,5565,5566,5567,5568,5569,5570,5571,5572,5573,5574,5575,5576,5577,5578,5579,5