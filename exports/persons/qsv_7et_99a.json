{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"qsv_7et_99a","canonical_person_id":"qsv_7et_99a","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["qsv_7et_99a"],"persons":[{"id":"qsv_7et_99a","label":"格增","status":"active","historicity":"historical_tradition","aliases":[{"surface":"格增","mention_ids":["c-jinshu-063-liju:p006:m0290"]}],"evidence":[{"mention_id":"c-jinshu-063-liju:p006:m0290","paragraph_id":"c-jinshu-063-liju:p006","chapter_id":"c-jinshu-063-liju","quote":"格增"}],"review":"ai_provisional","identity_note":"格增，見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-jinshu-063-liju-ws2025242","work_id":"w-jinshu","book_id":"b-jinshu-063","chapter_id":"c-jinshu-063-liju","raw_mention_count":1,"mention_ids":["c-jinshu-063-liju:p006:m0290"],"paragraph_ids":["c-jinshu-063-liju:p006"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-063-liju:p006:m0290","mention_ids":["c-jinshu-063-liju:p006:m0290"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-063-liju-ws2025242"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-063-liju:p006:m0290","surface":"格增","start":290,"end":292,"person_id":"qsv_7et_99a","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-063-liju:p006","chapter_id":"c-jinshu-063-liju"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-063-liju:p006","text":"先是，聰使其將趙固鎮洛陽，長史周振與固不協，密陳固罪。矩之破暢也，帳中得聰書，敕暢平矩訖，過洛陽，收固斬之，便以振代固。矩送以示固，固即斬振父子，遂率騎一千來降，矩還令守洛。後數月，聰遣其太子粲率劉雅生等步騎十萬屯孟津北岸，分遣雅生攻趙固於洛。固奔陽城山，遣弟告急，矩遣郭誦屯洛口以救之。誦使將張皮簡精卒千人夜渡河。粲候者告有兵至，粲恃其眾，不以為虞。既而誦等奄至，十道俱攻，粲眾驚擾，一時奔潰，殺傷太半，因據其營，獲其器械軍資不可勝數。及旦，粲見皮等人少，更與雅生悉餘眾攻之，苦戰二十餘日不能下。矩進救之，使壯士三千泛舟迎皮。賊臨河列陣，作長鉤以鉤船，連戰數日不得渡。矩夜遣部將格增潛濟入皮壘，與皮選精騎千餘，而殺所獲牛馬，焚燒器械，夜穴圍而出，奔武牢。聰追之，不及而退。聰因憤恚，發病而死。帝嘉其功，除矩都督河南三郡軍事、安西將軍、滎陽太守，封修武縣侯。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":37,"last_line":37,"raw_start":2557,"raw_end":2938,"raw_character_offsets":[2559,2560,2561,2562,2563,2564,2565,2566,2567,2568,2569,2570,2571,2572,2573,2574,2575,2576,2577,2578,2579,2580,2581,2582,2583,2584,2585,2586,2587,2588,2589,2590,2591,2592,2593,2594,2595,2596,2597,2598,2599,2600,2601,2602,2603,2604,2605,2606,2607,2608,2609,2610,2611,2612,2613,2614,2615,2616,2617,2618,2619,2620,2621,2622,2623,2624,2625,2626,2627,2628,2629,2630,2631,2632,2633,2634,2635,2636,2637,2638,2639,2640,2641,2642,2643,2644,2645,2646,2647,2648,2649,2650,2651,2652,2653,2654,2655,2656,2657,2658,2659,2660,2661,2662,2663,2664,2665,2666,2667,2668,2669,2670,2671,2672,2673,2674,2675,2676,2677,2678,2679,2680,2681,2682,2683,2684,2685,2686,2687,2688,2689,2690,2691,2692,2693,2694,2695,2696,2697,2698,2699,2700,2701,2702,2703,2704,2705,2706,2707,2708,2709,2710,2711,2712,2713,2714,2715,2716,2717,2718,2719,2720,2721,2722,2723,2724,2725,2726,2727,2728,2729,2730,2731,2732,2733,2734,2735,2736,2737,2738,2739,2740,2741,2742,2743,2744,2745,2746,2747,2748,2749,2750,