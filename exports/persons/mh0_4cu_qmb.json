:true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-067-wenqiao:line034:m0260","start":260,"end":262,"surface":"褚誕","kind":"person","person_id":"mh0_4cu_qmb","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-067-wenqiao:line034","chapter_id":"c-jinshu-067-wenqiao"}],"relations":[],"title_holdings":[{"id":"th-w067-wen-43","person_id":"mh0_4cu_qmb","title":"尋陽太守","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-067","chapter_id":"c-jinshu-067-wenqiao","source_id":"s-jinshu-067-wenqiao","paragraph_id":"c-jinshu-067-wenqiao:line034","quote":"賊臣祖約、蘇峻同惡相濟，用生邪心。天奪其魄，死期將至。譴負天地，自絕人倫。寇不可縱，宜增軍討撲，輒屯次湓口。即日護軍庾亮至，宣太后詔，寇逼宮城，王旅撓敗，出告藩臣，謀寧社稷。後將軍郭默、冠軍將軍趙胤、奮武將軍龔保與嶠督護王愆期、西陽太守鄧嶽、鄱陽內史紀瞻，率其所領，相尋而至。逆賊肆凶，陵蹈宗廟，火延宮掖，矢流太極，二御幽逼，宰相困迫，殘虐朝士，劫辱子女。承問悲惶，精魂飛散。嶠闇弱不武，不能殉難，哀恨自咎，五情摧隕，慙負先帝託寄之重，義在畢力，死而後已。今躬率所統，為士卒先，催進諸軍，一時電擊。西陽太守鄧嶽、尋陽太守褚誕等連旗相繼，宣城內史桓彝已勒所屬屯濱江之要，江夏相周撫乃心求征，軍已向路。","person_mention_id":"c-jinshu-067-wenqiao:line034:m0260"}],"attestations":[{"id":"th-w043-wen-43:a","paragraph_id":"c-jinshu-067-wenqiao:line034","start":256,"end":260,"surface":"尋陽太守","person_mention_id":"c-jinshu-067-wenqiao:line034:m0260","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-067-wenqiao:line034","text":"賊臣祖約、蘇峻同惡相濟，用生邪心。天奪其魄，死期將至。譴負天地，自絕人倫。寇不可縱，宜增軍討撲，輒屯次湓口。即日護軍庾亮至，宣太后詔，寇逼宮城，王旅撓敗，出告藩臣，謀寧社稷。後將軍郭默、冠軍將軍趙胤、奮武將軍龔保與嶠督護王愆期、西陽太守鄧嶽、鄱陽內史紀瞻，率其所領，相尋而至。逆賊肆凶，陵蹈宗廟，火延宮掖，矢流太極，二御幽逼，宰相困迫，殘虐朝士，劫辱子女。承問悲惶，精魂飛散