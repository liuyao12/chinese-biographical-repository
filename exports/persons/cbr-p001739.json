{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p001739","identity_policy":"contextual_provisional","person_ids":["cbr-p001739"],"persons":[{"id":"cbr-p001739","label":"狐毛（重耳從者）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"狐毛","mention_ids":["c-shiji-039-jin:m066-0097"]},{"surface":"毛","mention_ids":["c-shiji-039-jin:m050-0058"]}],"evidence":[{"mention_id":"c-shiji-039-jin:m066-0097","chapter_id":"c-shiji-039-jin","paragraph_id":"c-shiji-039-jin:p066","quote":"狐毛"},{"mention_id":"c-shiji-039-jin:m050-0058","chapter_id":"c-shiji-039-jin","paragraph_id":"c-shiji-039-jin:p050","quote":"毛"}]}],"mentions":[{"id":"c-shiji-039-jin:m050-0058","start":58,"end":59,"surface":"毛","kind":"person","person_id":"cbr-p001739","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p050","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m066-0097","start":97,"end":99,"surface":"狐毛","kind":"person","person_id":"cbr-p001739","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p066","chapter_id":"c-shiji-039-jin"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji039-177","person_id":"cbr-p001739","surfaces":["毛","狐毛"],"scope":"same_chapter","chapter_ids":["c-shiji-039-jin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-039-jin:p050","quote":"子圉之亡，秦怨之，乃求公子重耳，欲内之。子圉之立，畏秦之伐也。乃令國中諸從重耳亡者與期，期盡不到者盡滅其家。狐突之子毛及偃從重耳在秦，弗肯召。懷公怒，囚狐突。突曰：「臣子事重耳有年數矣，今召之，是教之反君也。何以教之？」懷公卒殺狐突。秦繆公乃發兵送内重耳，使人告欒、郤之黨爲内應，殺懷公於髙梁，入重耳。重耳立，是爲文公。"},{"paragraph_id":"c-shiji-039-jin:p066","quote":"四年，楚成王及諸侯圍宋，宋公孫固如晉告急。先軫曰：「報施定霸，於今在矣。」狐偃曰：「楚新得曹而初婚於衞，若伐曹、衞，楚必救之，則宋免矣。」於是晉作三軍。趙衰舉郤縠將中軍，郤臻佐之；使狐偃將上軍，狐毛佐之，命趙衰爲卿；欒枝將下軍，先軫佐之；荀林父御戎，魏犫爲右：往伐。冬十二月，晉兵先下山東，而以原封趙衰。"}],"rationale":"按本篇明示名與稱號、晉世系與具體事件暫定所列提及同指；附各段原文，未按同字短名全域合併；紀年與版本差異待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-039-jin:p050","text":"子圉之亡，秦怨之，乃求公子重耳，欲内之。子圉之立，畏秦之伐也。乃令國中諸從重耳亡者與期，期盡不到者盡滅其家。狐突之子毛及偃從重耳在秦，弗肯召。懷公怒，囚狐突。突曰：「臣子事重耳有年數矣，今召之，是教之反君也。何以教之？」懷公卒殺狐突。秦繆公乃發兵送内重耳，使人告欒、郤之黨爲内應，殺懷公於髙梁，入重耳。重耳立，是爲文公。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m050-0000","start":0,"end":2,"surface":"子圉","kind":"person","person_id":"cbr-p000390","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m050-0011","start":11,"end":15,"surface":"公子重耳","kind":"person","person_id":"cbr-p000252","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m050-0020","start":20,"end":22,"surface":"子圉","kind":"person","person_id":"cbr-p000390","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m050-0037","start":37,"end":39,"surface":"重耳","kind":"person","person_id":"cbr-p000252","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m050-0054","start":54,"end":56,"surface":"狐突","kind":"person","person_id":"cbr-p001730","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m050-0058","start":58,"end":59,"surface":"毛","kind":"person","person_id":"cbr-p001739","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m050-0060","start":60,"end":61,"surface":"偃","kind":"person","person_id":"cbr-p001740","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m050-0062","start":62,"end":64,"surface":"重耳","kind":"person","person_id":"cbr-p000252","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m050-0071","start":71,"end":73,"surface":"懷公","kind":"person","person_id":"cbr-p000390","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m050-0076","start":76,"end":78,"surface":"狐突","kind":"person","person_id":"cbr-p001730","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m050-0079","start":79,"end":80,"surface":"突","kind":"person","person_id":"cbr-p001730","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m050-0086","start":86,"end":88,"surface":"重耳","kind":"person","person_id":"cbr-p000252","status":"contextual_provisional"},{"id":"c-shi