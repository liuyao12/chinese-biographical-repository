ty_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-012-wudi:m009-0002","start":2,"end":5,"surface":"薄誘忌","kind":"person","person_id":"mqw_09p_4c8","status":"contextual_provisional","paragraph_id":"c-shiji-012-wudi:p009","chapter_id":"c-shiji-012-wudi"},{"id":"c-shiji-012-wudi:m009-0080","start":80,"end":81,"surface":"忌","kind":"person","person_id":"mqw_09p_4c8","status":"contextual_provisional","paragraph_id":"c-shiji-012-wudi:p009","chapter_id":"c-shiji-012-wudi"},{"id":"c-shiji-012-wudi:m009-0129","start":129,"end":130,"surface":"忌","kind":"person","person_id":"mqw_09p_4c8","status":"contextual_provisional","paragraph_id":"c-shiji-012-wudi:p009","chapter_id":"c-shiji-012-wudi"},{"id":"c-shiji-012-wudi:m009-0223","start":223,"end":224,"surface":"忌","kind":"person","person_id":"mqw_09p_4c8","status":"contextual_provisional","paragraph_id":"c-shiji-012-wudi:p009","chapter_id":"c-shiji-012-wudi"},{"id":"c-shiji-012-wudi:m022-0032","start":32,"end":34,"surface":"薄忌","kind":"person","person_id":"mqw_09p_4c8","status":"contextual_provisional","paragraph_id":"c-shiji-012-wudi:p022","chapter_id":"c-shiji-012-wudi"},{"id":"c-shiji-012-wudi:m051-0031","start":31,"end":33,"surface":"薄忌","kind":"person","person_id":"mqw_09p_4c8","status":"contextual_provisional","paragraph_id":"c-shiji-012-wudi:p051","chapter_id":"c-shiji-012-wudi"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji012-019","person_id":"mqw_09p_4c8","surfaces":["忌","薄忌","薄誘忌"],"scope":"same_chapter","chapter_ids":["c-shiji-012-wudi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-012-wudi:p009","quote":"亳人薄誘忌奏祠泰一方，曰：「天神貴者泰一，泰一佐曰五帝。古者天子以春秋祭泰一東南郊，用太牢具，七日，為壇開八通之鬼道。」於是天子令太祝立其祠長安東南郊，常奉祠如忌方。其後人有上書，言「古者天子三年一用太牢具祠神三一：天一，地一，泰一」。天子許之，令太祝領祠之忌泰一壇上，如其方。後人復有上書，言「古者天子常以春秋解祠，祠黃帝用一梟破鏡；冥羊用羊；祠馬行用一青牡馬；泰一、皋山山君、地長用牛；武夷君用乾魚；陰陽使者以一牛」。令祠官領之如其方，而祠於忌泰一壇旁。"},{"paragraph_id":"c-shiji-012-wudi:p022","quote":"上遂郊雍，至隴西，西登空桐，幸甘泉。令祠官寬舒等具泰一祠壇，壇放薄忌泰一壇，壇三垓。五帝壇環居其下，各如其方，黃帝西南，除八通鬼道。泰一所用，如雍一畤物，而加醴棗脯之屬，殺一牦牛以為俎豆牢具。而五帝獨有俎豆醴進。其下四方地，為餟食群神從者及北斗云。已祠，胙餘皆燎之。其牛色白，鹿居其中，彘在鹿中，水而洎之。祭日以牛，祭月以羊彘特。泰一祝宰則衣紫及繡。五帝各如其色，日赤，月白。"},{"paragraph_id":"c-shiji-012-wudi:p051","quote":"今天子所興祠，泰一、后土，三年親郊祠，建漢家封禪，五年一修封。薄忌泰一及三一、冥羊、馬行、赤星，五，寬舒之祠官以歲時致禮。凡六祠，皆太祝領之。至如八神諸神，明年、凡山他名祠，行過則祀，去則已。方士所興祠，各自主，其人終則已，祠官弗主。他祠皆如其故。今上封禪，其後十二歲而還，徧於五嶽、四瀆矣。而方士之候祠神人，入海求蓬萊，終無有驗。而公孫卿之候神者，猶以大人跡為解，無其效。天子益怠厭方士之怪迂語矣，然終羈縻弗絕，冀遇其真。自此之後，方士言祠神者彌眾，然其效可睹矣。"}],"rationale":"依本篇封禪、方士、授官與神異引語的明示語境判讀異稱；神祇或傳說不轉為已確證生平，跨篇同指仍待版本與專門研究核對。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-012-wudi:p009","text":"亳人薄誘忌奏祠泰一方，曰：「天神貴者泰一，泰一佐曰五帝。古者天子以春秋祭泰一東南郊，用太牢具，七日，為壇開八通之鬼道。」於是天子令太祝立其祠長安東南郊，常奉祠如忌方。其後人有上書，言「古者天子三年一用太牢具祠神三一：天一，地一，泰一」。天子許之，令太祝領祠之忌泰一壇上，如其方。後人復有上書，言「古者天子常以春秋解祠，祠黃帝用一梟破鏡；冥羊用羊；祠馬行用一青牡馬；泰一、皋山山君、地長用牛；武夷君用乾魚；陰陽使者以一牛」。令祠官領之如其方，而祠於忌泰一壇旁。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-012-wudi:m009-0002","start":2,"end":5,"surface":"薄誘忌","kind":"person","person_id":"mqw_09p_4c8","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m009-0007","start":7,"end":9,"surface":"泰一","kind":"unresolved","person_id":null,"status":"unresolved","note":"神祇、群體、匿名者或未定指代，保留來源，不補未見姓名與成員。"},{"id":"c-shiji-012-wudi:m009-0018","start":18,"end":20,"surface":"泰一","kind":"unresolved","person_id":null,"status":"unresolved","note":"神祇、群體、匿名者或未定指代，保留來源，不補未見姓名與成員。"},{"id":"c-shiji-012-wudi:m009-0021","start":21,"end":23,"surface":"泰一","kind":"unresolved","person_id":null,"status":"unresolved","note":"神祇、群體、匿名者或未定指代，保留來源，