{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"b19_h5h_hji","canonical_person_id":"b19_h5h_hji","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["b19_h5h_hji"],"persons":[{"id":"b19_h5h_hji","label":"趙韶","status":"active","historicity":"historical_tradition","aliases":[{"surface":"趙韶","mention_ids":["c-jinshu-066-taocheng:p001:m0199"]}],"evidence":[{"mention_id":"c-jinshu-066-taocheng:p001:m0199","paragraph_id":"c-jinshu-066-taocheng:p001","chapter_id":"c-jinshu-066-taocheng","quote":"趙韶"}],"review":"ai_provisional","identity_note":"趙韶，見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-jinshu-066-taocheng-ws1527632","work_id":"w-jinshu","book_id":"b-jinshu-066","chapter_id":"c-jinshu-066-taocheng","raw_mention_count":1,"mention_ids":["c-jinshu-066-taocheng:p001:m0199"],"paragraph_ids":["c-jinshu-066-taocheng:p001"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-066-taocheng:p001:m0199","mention_ids":["c-jinshu-066-taocheng:p001:m0199"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-066-taocheng-ws1527632"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-066-taocheng:p001:m0199","surface":"趙韶","start":199,"end":201,"person_id":"b19_h5h_hji","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-066-taocheng:p001","chapter_id":"c-jinshu-066-taocheng"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-066-taocheng:p001","text":"稱，東中郎將、南平太守、南蠻校尉、假節。性虓勇不倫，與諸弟不協。後加建威將軍。咸康五年，庾亮以稱為監江夏隨義陽三郡軍事、南中郎將、江夏相，以本所領二千人自隨。到夏口，輕將二百人下見亮。亮大會吏佐，責稱前後罪惡，稱拜謝，因罷出。亮使人於閣外收之，棄市，亮上疏曰：「案稱，大司馬侃之孽子，父亡不居喪位，荒耽於酒，昧利偷榮，擅攝五郡，自謂監軍，輒召王官，聚之軍府。故車騎將軍劉弘曾孫安寓居江夏，及將楊恭、趙韶，並以言色有忤，稱放聲當殺，安、恭懼，自赴水而死，韶於獄自盡。將軍郭開從稱往長沙赴喪，稱疑開附其兄弟，乃反縛懸頭於帆檣，仰而彈之，鼓棹渡江二十餘里，觀者數千，莫不震駭。又多藏匿府兵，收坐應死。臣猶未忍直上，且免其司馬。稱肆縱醜言，無所顧忌，要結諸將，欲阻兵構難。諸將惶懼，莫敢酬答，由是奸謀未即髮露。臣以侃勳勞王室，是以依違容掩，故表為南中郎將，與臣相近，思欲有以匡救之。而稱豺狼愈甚，發言激切，不忠不孝，莫此之甚。苟利社稷，義有專斷，輒收稱伏法。」","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":86,"last_line":86,"raw_start":9660,"raw_end":10095,"raw_character_offsets":[9662,9663,9664,9665,9666,9667,9668,9669,9670,9671,9672,9673,9674,9675,9676,9677,9678,9679,9680,9681,9682,9683,9684,9685,9686,9687,9688,9689,9690,9691,9692,9693,9694,9695,9696,9697,9698,9699,9700,9706,9707,9708,9709,9712,9713,9714,9715,9716,9717,9718,9719,9720,9721,9722,9723,9724,9725,9726,9727,9728,9729,9730,9731,9732,9733,9734,9735,9736,9737,9738,9739,9740,9741,9742,9743,9744,9745,9746,9747,9748,9749,9750,9751,9752,9753,9754,9755,9756,9757,9758,9759,9760,9761,9762,9763,9764,9765,9766,9767,9768,9769,9770,9771,9772,9773,9774,9775,9776,9777,9778,9779,9780,9781,9782,9783,9784,9785,9786,9787,9788,9789,9790,9791,9792,9793,9794,9795,9796,9797,9798,9799,9800,9801,9802,9803,9804,9805,9806,9807,9808,9809,9810,9811,9812,9813,9814,9815,9816,9817,9818,9819,9820,9821,9822,9823,9824,9825,9826,9827,9828,9829,9830,9831,9832,9833,9834,9835,9836,9837,9838,98