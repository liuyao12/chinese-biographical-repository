ji-115-chaoxian"},{"id":"c-shiji-115-chaoxian:m008-0078","start":78,"end":79,"surface":"唊","kind":"person","person_id":"m61_2wu_0ru","status":"contextual_provisional","paragraph_id":"c-shiji-115-chaoxian:p008","chapter_id":"c-shiji-115-chaoxian"},{"id":"c-shiji-115-chaoxian:m008-0184","start":184,"end":185,"surface":"唊","kind":"person","person_id":"m61_2wu_0ru","status":"contextual_provisional","paragraph_id":"c-shiji-115-chaoxian:p008","chapter_id":"c-shiji-115-chaoxian"}],"relations":[],"title_holdings":[{"id":"th-shiji115-014","person_id":"m61_2wu_0ru","title":"將軍","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-115-chaoxian","source_id":"s-shiji115-chaoxian","paragraph_id":"c-shiji-115-chaoxian:p008","quote":"左將軍已并兩軍，即急擊朝鮮。朝鮮相路人、相韓陰、尼谿相參、將軍王唊相與謀曰：「始欲降樓船，樓船今執，獨左將軍并將，戰益急，恐不能與，（戰）王又不肯降。」陰、唊、路人皆亡降漢。路人道死。元封三年夏，尼谿相參乃使人殺朝鮮王右渠來降。王險城未下，故右渠之大臣成巳又反，復攻吏。左將軍使右渠子長降、相路人之子最告諭其民，誅成巳，以故遂定朝鮮，為四郡。封參為澅清侯，陰為荻苴侯，唊為平州侯，長［降］為幾侯。最以父死頗有功，為溫陽侯。"}],"attestations":[{"id":"th-shiji115-014:a001","paragraph_id":"c-shiji-115-chaoxian:p008","start":29,"end":31,"surface":"將軍","person_mention_id":"c-shiji-115-chaoxian:m008-0031","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授任與文獻用稱分存，素侍中為追述舊職；日期僅限原段明示紀年，不補月份日或未知任期。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji115-018","person_id":"m61_2wu_0ru","title":"平州侯","kind":"noble_rank","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-115-chaoxian","source_id":"s-shiji115-chaoxian","paragraph_id":"c-shiji-115-chaoxian:p008","quote":"左將軍已并兩軍，即急擊朝鮮。朝鮮相路人、相韓陰、尼谿相參、將軍王唊相與謀曰：「始欲降樓船，樓船今執，獨左將軍并將，戰益急，恐不能與，（戰）王又不肯降。」陰、唊、路人皆亡降漢。路人道死。元封三年夏，尼谿相參乃使人殺朝鮮王右渠來降。王險城未下，故右渠之大臣成巳又反，復攻吏。左將軍使右渠子長降、相路人之子最告諭其民，誅成巳，以故遂定朝鮮，為四郡。封參為澅清侯，陰為荻苴侯，唊為平州侯，長［降］為幾侯。最以父死頗有功，為溫陽侯。"}],"attestations":[{"id":"th-shiji115-018:a001","paragraph_id":"c-shiji-1