{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p001238","identity_policy":"contextual_provisional","person_ids":["cbr-p001238"],"persons":[{"id":"cbr-p001238","label":"施伯（魯人）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"施伯","mention_ids":["c-shiji-033-lu:m040-0053"]}],"evidence":[{"mention_id":"c-shiji-033-lu:m040-0053","chapter_id":"c-shiji-033-lu","paragraph_id":"c-shiji-033-lu:p040","quote":"施伯"}]}],"source_mention_summary":[{"source_id":"s-shiji-033-lu","work_id":"w-shiji","book_id":"b-shiji-033","chapter_id":"c-shiji-033-lu","mention_count":1,"mention_ids":["c-shiji-033-lu:m040-0053"],"paragraph_ids":["c-shiji-033-lu:p040"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-033-lu"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-033-lu:m040-0053","start":53,"end":55,"surface":"施伯","kind":"person","person_id":"cbr-p001238","status":"contextual_provisional","paragraph_id":"c-shiji-033-lu:p040","chapter_id":"c-shiji-033-lu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji033-072","person_id":"cbr-p001238","surfaces":["施伯"],"scope":"same_chapter","chapter_ids":["c-shiji-033-lu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-033-lu:p040","quote":"八年，齊公子糾來奔。九年，魯欲內子糾於齊，後桓公，桓公發兵擊魯，魯急，殺子糾。召忽死。齊告魯生致管仲。魯人施伯曰：『齊欲得管仲，非殺之也，將用之，用之則爲魯患。不如殺，以其尸與之。』莊公不聽，遂囚管仲與齊。齊人相管仲。"}],"rationale":"按懿公被弒至魯文公的敘事角色、同段明示子／弟與柯盟、齊襄公殺魯桓公、晉立惠公等具體事件暫定異稱；同字爵稱依國別分開。公子揮不與前篇公子翚、晉襄父不與晉襄公、宣伯不與叔孫宣伯自動合併。數位疑讀與親屬異說仍待核對。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-033-lu:p040","text":"八年，齊公子糾來奔。九年，魯欲內子糾於齊，後桓公，桓公發兵擊魯，魯急，殺子糾。召忽死。齊告魯生致管仲。魯人施伯曰：『齊欲得管仲，非殺之也，將用之，用之則爲魯患。不如殺，以其尸與之。』莊公不聽，遂囚管仲與齊。齊人相管仲。","annotation_status"