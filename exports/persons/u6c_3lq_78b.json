idence/jin040-wyd1739-jiachong/transcription-projection.json","raw_file_sha256":"209d9b8a8a2f183a7ad3ed749da0273d85e177f9ff7feaf3ceea7edc3ffeabd0","unit_key":"unit021","source_layer":"received_chapter","first_line":197,"last_line":206},"chapter_id":"c-jinshu-040-wyd1739-jiachong","book_id":"b-jinshu-040","work_id":"w-jinshu","source_id":"s-jinshu-040-wyd1739-jiachong"},{"id":"c-jinshu-043-wyd1739-shantao:p014","text":"臣咸皆率職時黃門侍郎王恂庾純始於太極東堂聽政評尚書奏事多論刑獄不論選舉臣以為不先所難而辨其所易陛下初臨萬國人思盡誠每於聽政之日命公卿大臣先議選舉各言所見後進儁才鄉邑尤異才堪任用者皆以名奏主者隨缺先敘是爵人於朝與衆共之之義也朝廷從之永嘉三年出為征南將軍都督荆湘交廣四州諸軍事假節鎮襄陽于時四方寇亂天下分崩王威不振朝野危懼簡優游卒歲唯酒是耽諸習氏荆土豪族有佳園池簡每出遊嬉多之池上置酒輒醉名之曰高陽池時有童兒歌曰山公出何許往","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-043-wyd1739-shantao:p014:m0010","start":10,"end":12,"surface":"王恂","kind":"person","person_id":"4ad_c48_dfd","status":"contextual_provisional","resolution_note":"固定完整山濤單元逐處語境角色；原字、時層、引語主客與來源限定見本源role ledger。"},{"id":"c-jinshu-043-wyd1739-shantao:p014:m0012","start":12,"end":14,"surface":"庾純","kind":"person","person_id":"u6c_3lq_78b","status":"contextual_provisional","resolution_note":"固定完整山濤單元逐處語境角色；原字、時層、引語主客與來源限定見本源role ledger。"},{"id":"c-jinshu-043-wyd1739-shantao:p014:m0035","start":35,"end":36,"surface":"臣","kind":"person","person_id":"4kf_elm_6ww_AE","status":"contextual_provisional","resolution_note":"固定完整山濤單元逐處語境角色；原字、時層、引語主客與來源限定見本源role ledger。"},{"id":"c-jinshu-043-wyd1739-shantao:p014:m0047","start":47,"end":49,"surface":"陛下","kind":"person","person_id":"83d_b6e_058","status":"contextual_provisional","resolution_note":"固定完整山濤單元逐處語境角色；原字、時層、引語主客與來源限定見本源role ledger。"},{"id":"c-jinshu-043-wyd1739-shantao:p014:m0159","start":159,"end":160,"surface":"簡","kind":"person","person_id":"4kf_elm_6ww_AE","status":"contextual_provisional","resolution_note":"固定完整山濤單元逐處語境角色；原字、時層、引語主客與來源限定見本源role ledger。"},{"id":"c-jinshu-043-wyd1739-shantao:p014:m0179","start":179,"end":180,"surface":"簡","kind":"person","person_id":"4kf_elm_6ww_AE","status":"contextual_provisional","resolution_note":"固定完整山濤單元逐處語境角色；原字、時層、引語主客與來源限定見本源role ledger。"},{"id":"c-jinshu-043-wyd1739-shantao:p014:m0204","start":204,"end":206,"surface":"山公","kind":"person","person_id":"4kf_elm_6ww_AE","status":"contextual_provisional","resolution_note":"固定完整山濤單元逐處語境角色；原字、時層、引語主客與來源限定見本源role ledger。"}],"source_position":{"raw_projection_ref":"source-evidence/jin043-wyd1739-shantao/transcription-projection.json","raw_file_sha256":"ef5c37602549867433d9829f259bdfa01a66bdd0ab8c1344b6f5c98d5be4c437","unit_key":"unit014","source_layer":"received_chapter","first_line":127,"last_line":136},"chapter_id":"c-jinshu-043-wyd1739-shantao","book_id":"b-jinshu-043","work_id":"w-jinshu","source_id":"s-jinshu-043-wyd1739-shantao"},{"id":"c-jinshu-074-huan-family:p016","text":"石秀，幼有令名，風韻秀徹，博涉君書尤善《老》《莊》。常獨處一室，簡于應接，時人方之庾純。甚為簡文帝所重。豁為荊州，請為鷹揚將軍、竟陵太守，非其好也。尋代叔父沖為甯遠將軍、江州刺史、領鎮蠻護軍、西陽太守，居尋陽。性放曠，常弋釣林澤，不以榮爵嬰心。善騎射，發則命中。嘗從沖獵，登九井山，徒旅甚盛，觀者傾坐，石秀未嘗屬目，止嘯詠而已。謝安嘗訪以世務，默然不答，安甚怪之。他日，安以語其從弟嗣，嗣以問之，石秀曰：「世事此公所諳，吾又何言哉！」在州五年，以疾去職。年四十三卒於家，朝野悼惜之。追贈後將軍，後改贈太常。子稚玉嗣。玄之篡也，以石秀一門之令，封稚玉為臨沅王。","source_position":{"kind":"wikitext_codepoint_positions","raw_path":"sources/jinshu/wikisource-1536331-raw.wikitext","raw_start":3941,"raw_end":4236,"character_positions":[3943,3944,3945,3946,3947,3948,3949,3950,3951,3952,3953,3954,3955,3956,3957,3958,3959,3960,3961,3962,3968,3971,3972,3978,3981,3982,3983,3984,3985,3986,3987,3988,3989,3990,3991,3992,3993,3994,3995,3996,3997,3998,3999,4000,4001,4002,4003,4004,4005,4006,4007,4008,4009,4010,4011,4012,4013,4014,4015,4016,4017,4018,4019,4020,4021,4022,4023,4024,4025,4026,4027,4028,4029,4030,4031,4032,4033,4034,4035,4036,4037,4038,4039,4040,4041,4042,4043,4044,4045,4046,4047,4048,4049,4050,4051,4052,4053,4054,4055,4056,4057,4058,4059,4060,4061,4062,4063,4064,4065,4066,4067,4068,4069,4070,4071,4072,4073,4074,4075,4076,4077,4078,4079,4080,4081,4082,4083,4084,4085,4086,4087,4088,4089,4090,4091,4092,4093,4094,4095,4096,4097,4098,4099,4100,4101,4102,4103,4104,4105,4106,4107,4108,4109,4110,41