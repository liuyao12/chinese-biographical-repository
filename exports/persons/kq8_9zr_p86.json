ual_provisional","paragraph_id":"c-shiji-126-huaji:p022","chapter_id":"c-shiji-126-huaji"},{"id":"c-shiji-126-huaji:m022-0316","start":316,"end":318,"surface":"陛下","kind":"person","person_id":"kq8_9zr_p86","status":"contextual_provisional","paragraph_id":"c-shiji-126-huaji:p022","chapter_id":"c-shiji-126-huaji"},{"id":"c-shiji-126-huaji:m022-0329","start":329,"end":331,"surface":"武帝","kind":"person","person_id":"kq8_9zr_p86","status":"contextual_provisional","paragraph_id":"c-shiji-126-huaji:p022","chapter_id":"c-shiji-126-huaji"},{"id":"c-shiji-126-huaji:m022-0368","start":368,"end":369,"surface":"帝","kind":"person","person_id":"kq8_9zr_p86","status":"contextual_provisional","paragraph_id":"c-shiji-126-huaji:p022","chapter_id":"c-shiji-126-huaji"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-126-huaji:p014","text":"武帝時有所幸倡郭舍人者，發言陳辭雖不合大道，然令人主和說。武帝少時，東武侯母常養帝，帝壯時，號之曰「大乳母」。率一月再朝。朝奏入，有詔使幸臣馬游卿以帛五十匹賜乳母，又奉飲糒飱養乳母。乳母上書曰：「某所有公田，願得假倩之。」帝曰：「乳母欲得之乎？」以賜乳母。乳母所言，未嘗不聽。有詔得令乳母乘車行馳道中。當此之時，公卿大臣皆敬重乳母。乳母家子孫奴從者橫暴長安中，當道掣頓人車馬，奪人衣服。聞於中，不忍致之法。有司請徙乳母家室，處之於邊。奏可。乳母當入至前，面見辭。乳母先見郭舍人，為下泣。舍人曰：「即入見辭去，疾步數還顧。」乳母如其言，謝去，疾步數還顧。郭舍人疾言罵之曰：「咄！老女子！何不疾行！陛下已壯矣，寧尚須汝乳而活邪？尚何還顧！」於是人主憐焉悲之，乃下詔止無徙乳母，罰謫譖之者。","annotation_status":"in_progress","text_layer":"witness_appended_chu_note","mentions":[{"id":"c-shiji-126-huaji:m014-0000","start":0,"end":2,"surface":"武帝","kind":"person","person_id":"kq8_9zr_p86","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m014-0007","start":7,"end":10,"surface":"郭舍人","kind":"person","person_id":"kdu_i1o_jtw","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m014-0024","start":24,"end":26,"surface":"人主","kind":"person","person_id":"kq8_9zr_p86","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m014-0029","start":29,"end":31,"surface":"武帝","kind":"person","pe