{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000836","identity_policy":"contextual_provisional","person_ids":["cbr-p000836"],"persons":[{"id":"cbr-p000836","label":"呂平","status":"active","historicity":"historical_tradition","aliases":[{"surface":"呂平","mention_ids":["c-shiji-009-lvhou:m008-0102"]}],"evidence":[{"mention_id":"c-shiji-009-lvhou:m008-0102","chapter_id":"c-shiji-009-lvhou","paragraph_id":"c-shiji-009-lvhou:p008","quote":"呂平"}]}],"mentions":[{"id":"c-shiji-009-lvhou:m008-0102","start":102,"end":104,"surface":"呂平","kind":"person","person_id":"cbr-p000836","status":"contextual_provisional","paragraph_id":"c-shiji-009-lvhou:p008","chapter_id":"c-shiji-009-lvhou"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-009-lvhou:p008","text":"四月，太后欲侯諸呂，乃先封高祖之功臣郎中令無擇為博城侯。魯元公主薨，賜謚為魯元太后。子偃為魯王。魯王父，宣平侯張敖也。封齊悼惠王子章為朱虛侯，以呂祿女妻之。齊丞相壽為平定侯。少府延為梧侯。乃封呂種為沛侯，呂平為扶柳侯，張買為南宮侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-009-lvhou:m008-0003","start":3,"end":5,"surface":"太后","kind":"person","person_id":"cbr-p000717","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m008-0013","start":13,"end":15,"surface":"高祖","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m008-0018","start":18,"end":23,"surface":"郎中令無擇","kind":"person","person_id":"cbr-p000830","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m008-0028","start":28,"end":32,"surface":"魯元公主","kind":"person","person_id":"cbr-p000714","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m008-0037","start":37,"end":41,"surface":"魯元太后","kind":"person","person_id":"cbr-p000714","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m008-0043","start":43,"end":44,"surface":"偃","kind":"person","person_id":"cbr-p0