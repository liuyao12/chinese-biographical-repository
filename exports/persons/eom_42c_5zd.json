rial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-061-zhou-family:p007:m0114","start":114,"end":116,"surface":"華恆","kind":"person","person_id":"eom_42c_5zd","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。","paragraph_id":"c-jinshu-061-zhou-family:p007","chapter_id":"c-jinshu-061-zhou-family"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-061-zhou-family:p007","text":"嵩怏怏不悅，臨發，與散騎郎張嶷在侍中戴邈坐，褒貶朝士，又詆毀邈，邈密表之。帝召嵩入，面責之曰：「卿矜豪傲慢，敢輕忽朝廷，由吾不德故耳。」嵩跪謝曰：「昔唐虞至聖，四凶在朝。陛下雖聖明禦世，亦安能無碌碌之臣乎！」帝怒，收付廷尉。廷尉華恆以嵩大不敬棄市論，嶷以扇和減罪除名。時顗方貴重，帝隱忍。久之，補廬陵太守，不之職，更拜御史中丞。","source_position":{"raw_start":1586,"raw_end":1752,"raw_text":"　　嵩怏怏不悅，臨發，與散騎郎張嶷在侍中戴邈坐，褒貶朝士，又詆毀邈，邈密表之。帝召嵩入，面責之曰：「卿矜豪傲慢，敢輕忽朝廷，由吾不德故耳。」嵩跪謝曰：「昔唐虞至聖，四凶在朝。陛下雖聖明禦世，亦安能無碌碌之臣乎！」帝怒，收付廷尉。廷尉華恆以嵩大不敬棄市論，嶷以扇和減罪除名。時顗方貴重，帝隱忍。久之，補廬陵太守，不之職，更拜御史中丞。","display_wrapper_start":0,"display_wrapper_end":0,"raw_path":"sources/jinshu/wikisource-7903772-raw.wikitext"},"mentions":[{"id":"c-jinshu-061-zhou-family:p007:m0000","start":0,"end":1,"surface":"嵩","kind":"person","person_id":"3xx_gdy_or6_AAB","status":"contextual_provisional","interpretation_note":"069顗傳弟嵩與本061明三子相合；非賁嵩。"},{"id":"c-jinshu-061-zhou-family:p007:m0013","start":13,"end":15,"surface":"張嶷","kind":"person","person_id":"ldo_tw7_nv8","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p007:m0018","start":18,"end":20,"surface":"戴邈","kind":"person","person_id":"qxw_ax7_qew","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p007:m0030","start":30,"end":31,"surface":"邈","kind":"person","person_id":"qxw_ax7_qew","status":"contextual_provisional","interpre