3","start":93,"end":95,"surface":"靳尚","kind":"person","person_id":"5b0_v43_0o7","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p023","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-070-zhang:m023-0096","start":96,"end":97,"surface":"尚","kind":"person","person_id":"5b0_v43_0o7","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p023","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-070-zhang:m023-0162","start":162,"end":164,"surface":"靳尚","kind":"person","person_id":"5b0_v43_0o7","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p023","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-070-zhang:m023-0190","start":190,"end":192,"surface":"靳尚","kind":"person","person_id":"5b0_v43_0o7","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p023","chapter_id":"c-shiji-070-zhang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji070-017","person_id":"5b0_v43_0o7","scope":"same_chapter","chapter_ids":["c-shiji-070-zhang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["尚","靳尚"],"evidence":[{"paragraph_id":"c-shiji-070-zhang:p023","quote":"秦要楚欲得黔中地，欲以武關外易之。楚王曰：「不願易地，願得張儀而獻黔中地。」秦王欲遣之，口弗忍言。張儀乃請行。惠王曰：「彼楚王怒子之負以商於之地，是且甘心於子。」張儀曰：「秦彊楚弱，臣善靳尚，尚得事楚夫人鄭袖，袖所言皆從。且臣奉王之節使楚，楚何敢加誅。假令誅臣而為秦得黔中之地，臣之上願。」遂使楚。楚懷王至則囚張儀，將殺之。靳尚謂鄭袖曰：「子亦知子之賤於王乎？」鄭袖曰：「何也？」靳尚曰：「秦王甚愛張儀而不欲出之，今將以上庸之地六縣賂楚，美人聘楚，以宮中善歌謳者為媵。楚王重地尊秦，秦女必貴而夫人斥矣。不若為言而出之。」於是鄭袖日夜言懷王曰：「人臣各為其主用。今地未入秦，秦使張儀來，至重王。王未有禮而殺張儀，秦必大怒攻楚。妾請子母俱遷江南，毋為秦所魚肉也。」懷王後悔，赦張儀，厚禮之如故。"}],"rationale":"按第1至23段局部明示姓名與引語判讀；魏襄王卒後哀王受話語境分開。楚懷王與秦惠王在出使鄭袖段分辨，不按最近名字或全域王字判讀。擬議秦女、美人與子母不補姓名或婚姻；未名齊王不按年代記憶定名，異稱、史實及時序仍待覆核。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-070-zhang:p023","text":"秦要楚欲得黔中地，欲以武關外易之。楚王曰：「不願易地，願得張儀而獻黔中地。」秦王欲遣之，口弗忍言。張儀乃請行。惠王曰：「彼楚王怒子之負以商於之地，是且甘心於子。」張儀曰：「秦彊楚弱，臣善靳尚，尚得事楚夫人鄭袖，袖所言皆從。且臣奉王之節使楚，楚何敢加誅。假令誅臣而為秦得黔中之地，臣之上願。」遂使楚。楚懷王至則囚張儀，將殺之。靳尚謂鄭袖曰：「子亦知子之賤於王乎？」鄭袖曰：「何也？」靳尚曰：「秦王甚愛張儀而不欲出之，今將以上庸之地六縣賂楚，美人聘楚，以宮中善歌謳者為媵。楚王重地尊秦，秦女必貴而夫人斥矣。不若為言而出之。」於是鄭袖日夜言懷王曰：「人臣各為其主用。今地未入秦，秦使張儀來，至重王。王未有禮而殺張儀，秦必大怒攻楚。妾請子母俱遷江南，毋為秦所魚肉也。」懷王後悔，赦張儀，厚禮之如故。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-070-zhang:m023-0017","start":17,"end":19,"surface":"楚王","kind":"person","person_id":"tq2_jdt_200","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m023-0029","start":29,"end":31,"surface":"張儀","kind":"person","person_id":"5an_r55_hee","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m023-0038","start":38,"end":40,"surface":"秦王","kind":"person","person_id":"x9j_eu1_vck","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m023-0049","start":49,"end":51,"surface":"張儀","kind":"person","person_id":"5an_r55_hee","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m023-0055","start":55,"end":57,"surface":"惠王","kind":"person","person_id":"x9j_eu1_vck","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m023-0061","start":61,"end":63,"surface":"楚王","kind":"person","person_id":"tq2_jdt_200","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m023-0081","start":81,"end":83,"surface":"張儀","kind":"person","person_id":"5an_r55_hee","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m023-0093","start":93,"end":95,"surface":"靳尚","kind":"person","person_id":"5b0_v43_0o7","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m023-0096","start":96,"end":97,"surface":"尚","kind":"person","person_id":"5b0_v43_0o7","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m023-0099","start":99,"end":104,"surface":"楚夫人鄭袖","kind":"person","person_id":"7s1_ctn_j9k","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m023-0105","start":105,"end":106,"surface":"袖","kind":"person","person_id":"7s1_ctn_j9k","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m023-0114","start":114,"end":115,"surface":"王","kind":"person","person_i