{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p005354","identity_policy":"contextual_provisional","person_ids":["cbr-p005354"],"persons":[{"id":"cbr-p005354","label":"漢武帝未詳名（樊酈滕灌列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"天子","mention_ids":["c-shiji-095-fankuang:m033-0115"]}],"evidence":[{"mention_id":"c-shiji-095-fankuang:m033-0115","chapter_id":"c-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p033","quote":"天子"}]}],"mentions":[{"id":"c-shiji-095-fankuang:m033-0115","start":115,"end":117,"surface":"天子","kind":"person","person_id":"cbr-p005354","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p033","chapter_id":"c-shiji-095-fankuang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji095-104","person_id":"cbr-p005354","scope":"same_chapter","chapter_ids":["c-shiji-095-fankuang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["天子"],"evidence":[{"paragraph_id":"c-shiji-095-fankuang:p033","quote":"三歲，絳侯勃免相就國，嬰為丞相，罷太尉官。是歲，匈奴大入北地、上郡，令丞相嬰將騎八萬五千往擊匈奴。匈奴去，濟北王反，詔乃罷嬰之兵。後歲餘，嬰以丞相卒，謚曰懿侯。子平侯阿代侯。二十八年卒，子彊代侯。十三年，彊有罪，絕二歲。元光三年，天子封灌嬰孫賢為臨汝侯，續灌氏後，八歲，坐行賕有罪，國除。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定異稱。酈寄字況據第14段；夏侯嬰的嬰限定第16至21段，灌嬰限定第22至33段，桓嬰另人。第6與20、28段楚王信和反韓王信分人；未詳名王侯不補名。同名跨篇同指另待逐項證據。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-095-fankuang:p033","text":"三歲，絳侯勃免相就國，嬰為丞相，罷太尉官。是歲，匈奴大入北地、上郡，令丞相嬰將騎八萬五千往擊匈奴。匈奴去，濟北王反，詔乃罷嬰之兵。後歲餘，嬰以丞相卒，謚曰懿侯。子平侯阿代侯。二十八年卒，子彊代侯。十三年，彊有罪，絕二歲。元光三年，天子封灌嬰孫賢為臨汝侯，續灌氏後，八歲，坐行賕有罪，國除。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m033-0003","start":3,"end":6,"surface":"絳侯勃","kind":"person","person_id":"cbr-p005276","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m033-0011","start":11,"end":12,"surface":"嬰","kind":"person","person_id":"cbr-p005296