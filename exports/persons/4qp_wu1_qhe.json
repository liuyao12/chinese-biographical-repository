{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-123-dayuan:m024-0244","start":244,"end":246,"surface":"王恢","kind":"person","person_id":"4qp_wu1_qhe","status":"contextual_provisional","paragraph_id":"c-shiji-123-dayuan:p024","chapter_id":"c-shiji-123-dayuan"},{"id":"c-shiji-123-dayuan:m024-0373","start":373,"end":375,"surface":"王恢","kind":"person","person_id":"4qp_wu1_qhe","status":"contextual_provisional","paragraph_id":"c-shiji-123-dayuan:p024","chapter_id":"c-shiji-123-dayuan"},{"id":"c-shiji-123-dayuan:m024-0393","start":393,"end":394,"surface":"恢","kind":"person","person_id":"4qp_wu1_qhe","status":"contextual_provisional","paragraph_id":"c-shiji-123-dayuan:p024","chapter_id":"c-shiji-123-dayuan"},{"id":"c-shiji-123-dayuan:m024-0402","start":402,"end":403,"surface":"恢","kind":"person","person_id":"4qp_wu1_qhe","status":"contextual_provisional","paragraph_id":"c-shiji-123-dayuan:p024","chapter_id":"c-shiji-123-dayuan"},{"id":"c-shiji-123-dayuan:m030-0099","start":99,"end":101,"surface":"王恢","kind":"person","person_id":"4qp_wu1_qhe","status":"contextual_provisional","paragraph_id":"c-shiji-123-dayuan:p030","chapter_id":"c-shiji-123-dayuan"}],"relations":[],"title_holdings":[{"id":"th-shiji123-020","person_id":"4qp_wu1_qhe","title":"浩侯","kind":"noble_rank","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-123-dayuan","source_id":"s-shiji123-dayuan","paragraph_id":"c-shiji-123-dayuan:p024","quote":"自博望侯開外國道以尊貴，其後從吏卒皆爭上書言外國奇怪利害，求使。天子為其絕遠，非人所樂往，聽其言，予節，募吏民毋問所從來，為具備人眾遣之，以廣其道。來還不能毋侵盜幣物，及使失指，天子為其習之，輒覆案致重罪，以激怒令贖，復求使。使端無窮，而輕犯法。其吏卒亦輒復盛推外國所有，言大者予節，言小者為副，故妄言無行之徒皆爭效之。其使皆貧人子，私縣官齎物，欲賤市以私其利外國。外國亦厭漢使人人有言輕重，度漢兵遠不能至，而禁其食物以苦漢使。漢使乏絕積怨，至相攻擊。而樓蘭、姑師小國耳，當空道，攻劫漢使王恢等尤甚。而匈奴奇兵時時遮擊使西國者。使者爭遍言外國災害，皆有城邑，兵弱易擊。於是天子以故遣從驃侯破奴將屬國騎及郡兵數萬，至匈河水，欲以擊胡，胡皆去。其明年，擊姑師，破奴與輕騎七百餘先至，虜樓蘭王，遂破姑師。因舉兵威以困烏孫、大宛之屬。還，封破奴為浞野侯。王恢數使，為樓蘭所苦，言天子，天子發兵令恢佐破奴擊破之，封恢為浩侯。於是酒泉列亭鄣至玉門矣。"}],"attestations":[{"id":"th-shiji123-020:a001","paragraph_id":"c-shiji-123-dayuan:p024","start":404,"end":406,"surface":"浩侯","person_mention_id":"c-shiji-123-dayuan:m024-0244","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-123-dayuan","source_id":"s-shiji123-dayuan","paragraph_id":"c-shiji-123-dayuan:p024","quote":"自博望侯開外國道以尊貴，其後從吏卒皆爭上書言外國奇怪利害，求使。天子為其絕遠，非人所樂往，聽其言，予節，募吏民毋問所從來，為具備人眾遣之，以廣其道。來還不能毋侵盜幣物，及使失指，天子為其習之，輒覆案致重罪，以激怒令贖，復求使。使端無窮，而輕犯法。其吏卒亦輒復盛推外國所有，言大者予節，言小者為副，故妄言無行之徒皆爭效之。其使皆貧人子，私縣官齎物，欲賤市以私其利外國。外國亦厭漢使人人有言輕重，度漢兵遠不能至，而禁其食物以苦漢使。漢使乏絕積怨，至相攻擊。而樓蘭、姑師小國耳，當空道，攻劫漢使王恢等尤甚。而匈奴奇兵時時遮擊使西國者。使者爭遍言外國災害，皆有城邑，兵弱易擊。於是天子以故遣從驃侯破奴將屬國騎及郡兵數萬，至匈河水，欲以擊胡，胡皆去。其明年，擊姑師，破奴與輕騎七百餘先至，虜樓蘭王，遂破姑師。因舉兵威以困烏孫、大宛之屬。還，封破奴為浞野侯。王恢數使，為樓蘭所苦，言天子，天子發兵令恢佐破奴擊破之，封恢為浩侯。於是酒泉列亭鄣至玉門矣。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"原文授任、繼位與用稱分存；未知起訖保持未知，不因死亡自動終止。從驃侯等原稱不默改。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-123-dayuan:p024","text":"自博望侯開外國道以尊貴，其後從吏卒皆爭上書言外國奇怪利害，求使。天子為其絕遠，非人所樂往，聽其言，予節，募吏民毋問所從來，為具備人眾遣之，以廣其道。來還不能毋侵盜幣物，及使失指，天子為其習之，輒覆案致重罪，以激怒令贖，復求使。使端無窮，而輕犯法。其吏卒亦輒復盛推外國所有，言大者予節，言小者為副，故妄言無行之徒皆爭效之。其使皆貧人子，私縣官齎物，欲賤市以私其利外國。外國亦厭漢使人人有言輕重，度漢兵遠不能至，而禁其食物以苦漢使。漢使乏絕積怨，至相攻擊。而樓蘭、姑師小國耳，當空道，攻劫漢使王恢等尤甚。而匈奴奇兵時時遮擊使西國者。使者爭遍言外國災害，皆有城邑，兵弱易擊。於是天子以故遣從驃侯破奴將屬國騎及郡兵數萬，至匈河水，欲以擊胡，胡皆去。其明年，擊姑師，破奴與輕騎七百餘先至，虜樓蘭王，遂破姑師。因舉兵威以困烏孫、大宛之屬。還，封破奴為浞野侯。王恢數使，為樓蘭所苦，言天子，天子發兵令恢佐破奴擊破之，封恢為浩侯。於是酒泉列亭鄣至玉門矣。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-123-dayuan:m024-0001","start":1,"end":4,"surface":"博望侯","kind":"person","person_id":"531_10q_cq4","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m024-0032","start":32,"end":34,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m024-0089","start":89,"end":91,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m024-0244","start":244,"end":246,"surface":"王恢","kind":"person","person_id":"4qp_wu1_qhe","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m024-0286","start":286,"end":288,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m024-0294","start":294,"end":296,"surface":"破奴","kind":"person","person_id":"pkk_5wt_74f","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m024-0328","start":328,"end":330,"surface":"破奴","kind":"person","person_id":"pkk_5wt_74f","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m024-0340","start":340,"end":343,"surface":"樓蘭王","kind":"person","person_id":"lx3_ne1_5h4","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m024-0366","start":366,"end":368,"surface":"破奴","kind":"person","person_id":"pkk_5wt_74f","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m024-0373","start":373,"end":375,"surface":"王恢","kind":"person","person_id":"4qp_wu1_qhe","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m024-0385","start":385,"end":387,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m024-0388","start":388,"end":390,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m024-0393","start":393,"end":394,"surface":"恢","kind":"person","person_id":"4qp_wu1_qhe","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m024-0395","start":395,"end":397,"surface":"破奴","kind":"person","person_id":"pkk_5wt_74f","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m024-0402","start":402,"end":403,"surface":"恢","kind":"person","person_id":"4qp_wu1_qhe","status":"contextual_provisional"}],"chapter_id":"c-shiji-123-dayuan","book_id":"b-shiji-123","work_id":"w-shiji","source_id":"s-shiji123-dayuan"},{"id":"c-shiji-123-dayuan:p030","text":"天子已嘗使浞野侯攻樓蘭，以七百騎先至，虜其王，以定漢等言為然，而欲侯寵姬李氏，拜李廣利為貳師將軍，發屬國六千騎，及郡國惡少年數萬人，以往伐宛。期至貳師城取善馬，故號「貳師將軍」。趙始成為軍正，故浩侯王恢使導軍，而李哆為校尉，制軍事。是歲太初元年也。而關東蝗大起，蜚西至敦煌。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-123-dayuan:m030-0000","start":0,"end":2,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0005","start":5,"end":8,"surface":"浞野侯","kind":"person","person_id":"pkk_5wt_74f","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0020","start":20,"end":22,"surface":"其王","kind":"person","person_id":"lx3_ne1_5h4","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0024","start":24,"end":26,"surface":"定漢","kind":"person","person_id":"pbn_4mh_7ix","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0034","start":34,"end":38,"surface":"寵姬李氏","kind":"person","person_id":"z3p_px0_z7c","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0040","start":40,"end":43,"surface":"李廣利","kind":"person","person_id":"pez_8dn_r76","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0044","start":44,"end":48,"surface":"貳師將軍","kind":"person","person_id":"pez_8dn_r76","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0083","start":83,"end":87,"surface":"貳師將軍","kind":"person","person_id":"pez_8dn_r76","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0089","start":89,"end":92,"surface":"趙始成","kind":"person","person_id":"zpc_ufe_fc2","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0099","start":99,"end":101,"surface":"王恢","kind":"person","person_id":"4qp_wu1_qhe","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0106","start":106,"end":108,"surface":"李哆","kind":"person","person_id":"ey5_6f2_7to","status":