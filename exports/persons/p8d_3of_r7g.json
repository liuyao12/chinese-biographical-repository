3-shantao:p022:m0161","r5":"c-jinshu-043-shantao:p022:m0167"},"fields":{"career_067":{"paragraph_id":"c-jinshu-043-shantao:p022","start":7,"end":11,"surface":"征南將軍"},"career_068":{"paragraph_id":"c-jinshu-043-shantao:p022","start":12,"end":26,"surface":"都督荊、湘、交、廣四州諸軍事"},"career_069":{"paragraph_id":"c-jinshu-043-shantao:p022","start":27,"end":29,"surface":"假節"}},"inside_role_fields":{},"human_reviewed":false,"slot":"addresses_005"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-043","source_id":"s-jinshu-043-ws2618531-shantao","chapter_id":"c-jinshu-043-shantao","paragraph_id":"c-jinshu-043-shantao:p022","quote":"永嘉三年，出為征南將軍、都督荊、湘、交、廣四州諸軍事、假節，鎮襄陽。于時四方寇亂，天下分崩，王威不振，朝野危懼。簡優遊卒歲，唯酒是耽。諸習氏，荊土豪族，有佳園池，簡每出嬉遊，多之池上，置酒輒醉，名之曰高陽池。時有童兒歌曰：「山公出何許，往至高陽池。日夕倒載歸，酩酊無所知。時時能騎馬，倒著白接䍦。舉鞭問葛疆：何如并州兒？」疆家在并州，簡愛將也。","person_mention_id":"c-jinshu-043-shantao:p022:m0161"}],"interpretation_note":"原籍/返回/遷徙/鎮所/家居分存，原鄉里與洛不補現代地址。家在并州為葛疆家址，不稱其在本事件現居并州；不把官地或遷處當卒地。","status":"source_attested","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-043-shantao:p022","text":"永嘉三年，出為征南將軍、都督荊、湘、交、廣四州諸軍事、假節，鎮襄陽。于時四方寇亂，天下分崩，王威不振，朝野危懼。簡優遊卒歲，唯酒是耽。諸習氏，荊土豪族，有佳園池，簡每出嬉遊，多之池上，置酒輒醉，名之曰高陽池。時有童兒歌曰：「山公出何許，往至高陽池。日夕倒載歸，酩酊無所知。時時能騎馬，倒著白接䍦。舉鞭問葛疆：何如并州兒？」疆家在并州，簡愛將也。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-043-shantao:p022:m0056","start":56,"end":57,"surface":"簡","kind":"person","person_id":"0uv_x8k_mfc_AE","status":"contextual_provisional","resolution_note":"童歌山公指山簡，不承傳首山濤；并州兒不硬套山該或葛疆。"},{"id":"c-jinshu-043-shantao:p022:m0067","start":67,"end":70,"surface":"諸習氏","kind":"unresolved","person_id":null,"status":"unresolved","resolution_note":"童歌山公指山簡，不承傳首山濤；并州兒不硬套山該或葛疆。"},{"id":"c-jinshu-043-shantao:p022:m0081","start":81,"end":82,"surface":"簡","kind":"person","p