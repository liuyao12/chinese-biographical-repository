erred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-052-later-literature-complete:p037","text":"　　初，宋武平關中，得姚興指南車，有外形而無機巧，每行，使人於內轉之。昇明中，太祖輔政，使沖之追修古法。沖之改造銅機，圓轉不窮，而司方如一，馬均以來未有也。時有北人索馭驎者，亦云能造指南車，太祖使與沖之各造，使於樂遊苑對共校試，而頗有差僻，乃毀焚之。永明中，竟陵王子良好古，沖之造欹器獻之。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":160,"last_line":160,"raw_start":8028,"raw_end":8173,"raw_character_offsets":[8028,8029,8030,8031,8032,8033,8034,8035,8036,8037,8038,8039,8040,8041,8042,8043,8044,8045,8046,8047,8048,8049,8050,8051,8052,8053,8054,8055,8056,8057,8058,8059,8060,8061,8062,8063,8064,8065,8066,8067,8068,8069,8070,8071,8072,8073,8074,8075,8076,8077,8078,8079,8080,8081,8082,8083,8084,8085,8086,8087,8088,8089,8090,8091,8092,8093,8094,8095,8096,8097,8098,8099,8100,8101,8102,8103,8104,8105,8106,8107,8108,8109,8110,8111,8112,8113,8114,8115,8116,8117,8118,8119,8120,8121,8122,8123,8124,8125,8126,8127,8128,8129,8130,8131,8132,8133,8134,8135,8136,8137,8138,8139,8140,8141,8142,8143,8144,8145,8146,8147,8148,8149,8150,8151,8152,8153,8154,8155,8156,8157,8158,8159,8160,8161,8162,8163,8164,8165,8166,8167,8168,8169,8170,8171,8172],"revision_id":2371079},"mentions":[{"id":"c-nanqishu-052-later-literature-complete:p037:m0039","start":39,"end":41,"surface":"太祖","kind":"person","person_id":"47p_kjh_ez7","status":"contextual_provisional"},{"id":"c-nanqishu-052-later-literature-complete:p037:m0045","start":45,"end":47,"surface":"沖之","kind":"person","person_id":"vcm_d77_tsz_AA","status":"contextual_provisional"},{"id":"c-nanqishu-052-later-literature-complete:p037:m0052","start":52,"end":54,"surface":"沖之","kind":"person","person_id":"vcm_d77_tsz_AA","status":"contextual_provisional"},{"id":"c-nanqishu-052-later-literature-complete:p037:m0082","start":82,"end":85,"surface":"索馭驎","kind":"person","person_id":"5vp_0hh_b2g","status":"contextual_provisional"},{"id":"c-nanqishu-052-later-literature-complete:p037:m0095","start