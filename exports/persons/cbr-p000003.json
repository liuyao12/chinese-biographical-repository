p010","chapter_id":"c-shiji-008-gaozu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji003-009","person_id":"7x2_x55_1b6","surfaces":["蚩尤"],"scope":"cross_chapter","chapter_ids":["c-shiji-001-wudi","c-shiji-003-yin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-001-wudi:p002","quote":"蚩尤作亂"},{"paragraph_id":"c-shiji-003-yin:p009","quote":"昔蚩尤與其大夫作亂百姓"}],"rationale":"依連續敘事、相同職事及事件暫定跨卷同指；不按同名自動合併到其他來源。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-001-wudi:p002","text":"軒轅之時，神農氏世衰。諸侯相侵伐，暴虐百姓，而神農氏弗能征。於是軒轅乃習用干戈，以征不享，諸侯咸來賓從。而蚩尤最爲暴，莫能伐。炎帝欲侵陵諸侯，諸侯咸歸軒轅。軒轅乃修德振兵，治五氣，蓺五種，撫萬民，度四方，教熊羆貔貅貙虎，以與炎帝戰於阪泉之野。三戰，然後得其志。蚩尤作亂，不用帝命。於是黃帝乃徵師諸侯，與蚩尤戰於涿鹿之野，遂禽殺蚩尤。而諸侯咸尊軒轅爲天子，代神農氏，是爲黃帝。天下有不順者，黃帝從而征之，平者去之，披山通道，未嘗寧居。","mentions":[{"id":"c-shiji-001-wudi:m002-0000","start":0,"end":2,"surface":"軒轅","kind":"person","person_id":"8jz_o3s_obt","status":"source_identified"},{"id":"c-shiji-001-wudi:m002-0005","start":5,"end":8,"surface":"神農氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"可能為個人、官職、群體、氏族或國號；不憑本篇未明示的外部對應補造身份。"},{"id":"c-shiji-001-wudi:m002-0023","start":23,"end":26,"surface":"神農氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"可能為個人、官職、群體、氏族或國號；不憑本篇未明示的外部對應補造身份。"},{"id":"c-shiji-001-wudi:m002-0032","start":32,"end":34,"surface":"軒轅","kind":"person","person_id":"8jz_o3s_obt","status":"source_identified"},{"id":"c-shiji-001-wudi:m002-0053","start":53,"end":55,"surface":"蚩尤","kind":"person","person_id":"7x2_x55_1b6","status":"source_identified"},{"id":"c-shiji-001-wudi:m002-0063","start":63,"end":65,"surface":"炎帝","kind":"person","person_id":"rd5_bjt_8ed","status":"source_identified"},{"id":"c-shiji-001-wudi:m002-0075","start":75,"end":77,"surface":"軒轅","kind":"person","person_id":"8jz_o3s_obt","status":"source_identified"},{"id":"c-shiji-001-wudi:m002-0078","start":78,"end":80,"surface":"軒轅","kind":"person","person_id":"8jz_o3s_obt","status":"source_identified"},{"id":"c-shiji-001-wudi:m002-0112","start":112,"end":114,"surface":"炎帝","kind":"person","person_id":"rd5_bjt_8ed","status":"source_identified"},{"id":"c-shiji-001-wudi:m002-0130","start":130,"end":132,"surface":"蚩尤","kind":"person","person_id":"7x2_x55_1b6","status":"source_identified"},{"id":"c-shiji-001-wudi:m002-0142","start":142,"end":144,"surface":"黃帝","kind":"person","person_id":"8jz_o3s_obt","status":"source_identified"},{"id":"c-shiji-001-wudi:m002-0151","start":151,"end":153,"surface":"蚩尤","kind":"person","person_id":"7x2_x55_1b6","status":"source_identified"},{"id":"c-shiji-001-wudi:m002-0163","start":163,"end":165,"surface":"蚩尤","kind":"person","person_id":"7x2_x55_1b6","status":"source_identified"},{"id":"c-shiji-001-wudi:m002-0171","start":171,"end":173,"surface":"軒轅","kind":"person","person_id":"8jz_o3s_obt","status":"source_identified"},{"id":"c-shiji-001-wudi:m002-0178","start":178,"end":181,"surface":"神農氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"可能為個人、官職、群體、氏族或國號；不憑本篇未明示的外部對應補造身份。"},{"id":"c-shiji-001-wudi:m002-0184","start":184,"end":186,"surface":"黃帝","kind":"person","person_id":"8jz_o3s_obt","status":"source_identified"},{"id":"c-shiji-001-wudi:m002-0194","start":194,"end":196,"surface":"黃帝","kind":"person","person_id":"8jz_o3s_obt","status":"source_identified"}],"chapter_id":"c-shiji-001-wudi","book_id":"b-shiji-001","work_id":"w-shiji","source_id":"s-shiji-001-wudi"},{"id":"c-shiji-003-yin:p009","text":"湯歸至于泰卷陶，中𤳹作誥。既絀夏命，還亳，作湯誥：「維三月，王自至於東郊。告諸侯群后：『毋不有功於民，勤力迺事。予乃大罰殛女，毋予怨。』曰：『古禹、皋陶久勞于外，其有功乎民，民乃有安。東為江，北為濟，西為河，南為淮，四瀆已修，萬民乃有居。后稷降播，農殖百穀。三公咸有功于民，故后有立。昔蚩尤與其大夫作亂百姓，帝乃弗予，有狀。先王言不可不勉。』曰：『不道，毋之在國，女毋我怨。』」以令諸侯。伊尹作咸有一德，咎單作明居。","mentions":[{"id":"c-shiji-003-yin:m009-0000","start":0,"end":1,"surface":"湯","kind":"person","person_id":"tpz_x3m_e0h","status":"source_identified"},{"id":"c-shiji-003-yin:m009-0008","start":8,"end":10,"surface":"中𤳹","kind":"person","person_id":"dxw_mqx_r82","status":"source_identified"},{"id":"c-shiji-003-yin:m009-0030","start":30,"end":31,"surface":"王","kind":"person","person_id":"tpz_x3m_e0h","status":"contextual_provisional","interpretation_note":"只依本段對話的君主與事件暫定，不作全篇通用的帝／王匹配。"},{"id":"c-shiji-003-yin:m009-0072","start":72,"end":73,"surface":"禹","kind":"person","person_id":"6ip_dr3_fbl","status":"source_identified"},{"id":"c-shiji-003-yin:m009-0074","start":74,"end":76,"surface":"皋陶","kind":"person","person_id":"p3l_pp3_n6i","status":"source_identified"},{"id":"c-shiji-003-yin:m009-0119","start":119,"end":121,"surface":"后稷","kind":"person","person_id":"jqy_1fv_u7v","status":"source_identified"},{"id":"c-shiji-003-yin:m009-0129","start":129,"end":131,"surface":"三公","kind":"unresolved","person_id":null,"status":"unresolved","note":"氏族、群體、官稱或未定個人指代；不由熟知故事補出姓名。"},{"id":"c-shiji-003-yin:m009-0143","start":143,"end":145,"surface":"蚩尤","kind":"person","person_id":"7x2_x55_1b6","status":"source_identified"},{"id":"c-shiji-003-yin:m009-0147","start":147,"end":149,"surface":"大夫","kind":"unresolved","person_id":null,"status":"unresolved","note":"氏族、群體、官稱或未定個人指代；不由熟知故事補出姓名。"},{"id":"c-shiji-003-yin:m009-0154","start":154,"end":158,"surface":"帝乃弗予","kind":"unresolved","person_id":null,"status":"unresolved","note":"氏族、群體、官稱或未定個人指代；不由熟知故事補出姓名。"},{"id":"c-shiji-003-yin:m009-0162","start":162,"end":164,"surface":"先王","kind":"unresolved","person_id":null,"status":"unresolved","note":"氏族、群體、官稱或未定個人指代；不由熟知故事補出姓名。"},{"id":"c-shiji-003-yin:m009-0194","start":194,"end":196,"surface":"伊尹","kind":"person","person_id":"itn_zi2_il4","status":"source_identified"},{"id":"c-shiji-003-yin:m009-0202","start":202,"end":204,"surface":"咎單","kind":"person","person_id":"0h0_68r_si5","status":"source_identified"}],"chapter_id":"c-shiji-003-yin","book_id":"b-shiji-003","work_id":"w-shiji","source_id":"s-shiji-003-yin"},{"id":"c-shiji-008-gaozu:p010","text":"於是樊噲從劉季來。沛令後悔，恐其有變，乃閉城城守，欲誅蕭、曹。蕭、曹恐，踰城保劉季。劉季乃書帛射城上，謂沛父老曰：「天下苦秦久矣。今父老雖為沛令守，諸侯并起，今屠沛。沛今共誅令，擇子弟可立者立之，以應諸侯，則家室完。不然，父子俱屠，無為也。」父老乃率子弟共殺沛令，開城門迎劉季，欲以為沛令。劉季曰：「天下方擾，諸侯并起，今置將不善，壹敗塗地。吾非敢自愛，恐能薄，不能完父兄子弟。此大事，願更相推擇可者。」蕭、曹等皆文吏，自愛，恐事不就，後秦種族其家，盡讓劉季。諸父老皆曰：「平生所聞劉季諸珍怪，當貴，且卜筮之，莫如劉季最吉。」於是劉季數讓。眾莫敢為，乃立季為沛公。祠黃帝，祭蚩尤於沛庭，而釁鼓旗，幟皆赤。由所殺蛇白帝子，殺者赤帝子，故上赤。於是少年豪吏如蕭、曹、樊噲等皆為收沛子弟二三千人，攻胡陵、方與，還守豐。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m010-0002","start":2,"end":4,"surface":"樊噲","kind":"person","person_id":"b1r_inb_fts","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m010-0005","start":5,"end":7,"surface":"劉季","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m010-0009","start":9,"end":11,"surface":"沛令","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名官稱或傳說指稱尚待覆核；不補姓名或親屬。"},{"id":"c-shiji-008-gaozu:m010-0027","start":27,"end":28,"surface":"蕭","kind":"person","person_id":"xd8_uww_5ok","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m010-0029","start":29,"end":30,"surface":"曹","kind":"person","person_id":"37j_16p_7n8","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m010-0031","start":31,"end":32,"surface":"蕭","kind":"person","person_id":"xd8_uww_5ok","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m010-0033","start":33,"end":34,"surface":"曹","kind":"person","person_id":"37j_16p_7n8","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m010-0039","start":39,"end":41,"surface":"劉季","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m010-0042","start":42,"end":44,"surface":"劉季","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m010-0070","start":70,"end":72,"surface":"沛令","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名官稱或傳說指稱尚待覆核；不補姓名或親屬。"},{"id":"c-shiji-008-gaozu:m010-0129","start":129,"end":131,"surface":"沛令","kind":"unresol