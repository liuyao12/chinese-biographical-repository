valence_decisions":[],"passages":[{"id":"c-jinshu-098-huanwen:p020","text":"溫性儉，每燕惟下七奠柈茶果而已。然以雄武專朝，窺覦非望，或臥對親僚曰：「為爾寂寂，將為文景所笑。」眾莫敢對。既而撫枕起曰：「既不能流芳後世，不足復遺臭萬載邪！」嘗行經王敦墓，望之曰：「可人，可人！」其心跡若是。時有遠方比丘尼名有道術，於別室浴，溫竊窺之。尼倮身先以刀自破腹，次斷兩足。浴竟出，溫問吉凶，尼云：「公若作天子，亦當如是。」","source_position":{"kind":"wikitext_codepoint_positions","raw_path":"sources/jinshu/wikisource-2614273-raw.wikitext","raw_start":12312,"raw_end":12479,"character_positions":[12312,12313,12314,12315,12316,12317,12318,12319,12320,12321,12322,12323,12324,12325,12326,12327,12328,12329,12330,12331,12332,12333,12334,12335,12336,12337,12338,12339,12340,12341,12342,12343,12344,12345,12346,12347,12348,12349,12350,12351,12352,12353,12354,12355,12356,12357,12358,12359,12360,12361,12362,12363,12364,12365,12366,12367,12368,12369,12370,12371,12372,12373,12374,12375,12376,12377,12378,12379,12380,12381,12382,12383,12384,12385,12386,12387,12388,12389,12390,12391,12392,12393,12394,12395,12396,12397,12398,12399,12400,12401,12402,12403,12404,12405,12406,12407,12408,12409,12410,12411,12412,12413,12414,12415,12416,12417,12418,12419,12420,12421,12422,12423,12424,12425,12426,12427,12428,12429,12430,12431,12432,12433,12434,12435,12436,12437,12438,12439,12440,12441,12442,12443,12444,12445,12446,12447,12448,12449,12450,12451,12452,12453,12454,12455,12456,12457,12458,12459,12460,12461,12462,12463,12464,12465,12466,12467,12468,12469,12470,12471,12472,12473,12474,12475,12476,12477,12478]},"mentions":[{"id":"c-jinshu-098-huanwen:p020:m0000","start":0,"end":1,"surface":"溫","kind":"person","person_id":"u9s_w6j_8mc_AA","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。"},{"id":"c-jinshu-098-huanwen:p020:m0043","start":43,"end":44,"surface":"文","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"篡志語境及教育部成語典參考支持晉文王司馬昭；非親讀古注","candidate_person_ids":["dkn_ge4_286_AAAAI"]},{"id":"c-jinshu-098-huanwen:p020:m0044","start":44,"end":45,"surface":"景","kind":"unresolved","person_id":null,"status":"unresolve