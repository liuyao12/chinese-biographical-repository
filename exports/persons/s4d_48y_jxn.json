{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"s4d_48y_jxn","canonical_person_id":"s4d_48y_jxn","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["s4d_48y_jxn"],"persons":[{"id":"s4d_48y_jxn","label":"京房（字君明）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"京房","mention_ids":["c-jinshu-076-wangyi-family:line033:m0138","c-sanguozhi-063-appraisal:line046-pei01-02:m0133"]}],"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-076","chapter_id":"c-jinshu-076-wangyi-family","source_id":"s-jinshu-076-wangyi-family","paragraph_id":"c-jinshu-076-wangyi-family:line033","mention_id":"c-jinshu-076-wangyi-family:line033:m0138","quote":"京房"},{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-063","chapter_id":"c-sanguozhi-063-appraisal","source_id":"s-sanguozhi-063-appraisal","paragraph_id":"c-sanguozhi-063-appraisal:line046-pei01-02","mention_id":"c-sanguozhi-063-appraisal:line046-pei01-02:m0133","quote":"京房"}],"review":"ai_provisional","identity_note":"依本傳及所引字、親屬或術業辨識。"}],"source_mention_summary":[{"source_id":"s-jinshu-076-wangyi-family","work_id":"w-jinshu","book_id":"b-jinshu-076","chapter_id":"c-jinshu-076-wangyi-family","raw_mention_count":1,"mention_ids":["c-jinshu-076-wangyi-family:line033:m0138"],"paragraph_ids":["c-jinshu-076-wangyi-family:line033"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-076-wangyi-family:line033:m0138","mention_ids":["c-jinshu-076-wangyi-family:line033:m0138"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"},{"source_id":"s-sanguozhi-063-appraisal","work_id":"w-sanguozhi","book_id":"b-sanguozhi-063","chapter_id":"c-sanguozhi-063-appraisal","raw_mention_count":1,"mention_ids":["c-sanguozhi-063-appraisal:line046-pei01-02:m0133"],"paragraph_ids":["c-sanguozhi-063-appraisal:line046-pei01-02"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-sanguozhi-063-appraisal:line046-pei01-02:m0133","mention_ids":["c-sanguozhi-063-appraisal:line046-pei01-02:m0133"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-076-wangyi-family","s-sanguozhi-063-appraisal"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-076-wangyi-family:line033:m0138","start":138,"end":140,"surface":"京房","kind":"person","person_id":"s4d_48y_jxn","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-076-wangyi-family:line033","chapter_id":"c-jinshu-076-wangyi-family"},{"id":"c-sanguozhi-063-appraisal:line046-pei01-02:m0133","start":133,"end":135,"surface":"京房","kind":"person","person_id":"s4d_48y_jxn","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-063-appraisal:line046-pei01-02","chapter_id":"c-sanguozhi-063-appraisal"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-076-wangyi-family:line033","text":"又臣昔嘗侍於先後，說陛下誕育之日，光明映室，白毫生於額之左，相者謂當王有四海。又臣以壬申歲見用為鄱陽內史，七月，四星聚於牽牛。又臣郡有枯樟更生。及臣後還京都，陛下見臣白兔，命臣作賦。時琅邪郡又獻甘露，陛下命臣嘗之。又驃騎將軍導向臣說晉陵有金鐸之瑞，郭璞雲必致中興。璞之爻筮，雖京房、管輅不過也。明天之歷數在陛下矣。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-076-wangyi-family:line033:u0006","start":6,"end":8,"surface":"先後","kind":"unresolved","person_id":null,"status":"unresolved","unresolved_kind":"source_variant_identity","interpretation_note":"殿本先后，憶元帝生時，與元夏侯太妃本傳對讀；本疏此處無名，與王廙自言老母分列。"},{"id":"c-jinshu-076-wangyi-family:line033:m0112","start":112,"end":113,"surface":"導","kind":"person","person_id":"7r6_k52_qji_ABAA","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-076-wangyi-family:line033:m0124","start":124,"end":126,"surface":"郭璞","kind":"person","person_id":"2i5_4eo_tve","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-076-wangyi-family:line033:m0132","start":132,"end":133,"surface":"璞","kind":"person","person_id":"2i5_4eo_tve","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-076-wangyi-family:line033:m0138","start":138,"end":140,"surface":"京房","kind":"person","person_id":"s4d_48y_jxn","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-076-wangyi-family:line033:m0141","start":141,"end":143,"surface":"管輅","kind":"person","person_id":"r7r_kq9_iap","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"source_position":{"first_line":33,"last_line":33,"raw_start":2354,"raw_end":2511,"revision_id":2180533},"chapter_id":"c-jinshu-076-wangyi-family","book_id":"b-jinshu-076","work_id":"w-jinshu","source_id":"s-jinshu-076-wangyi-family"},{"id":"c-sanguozhi-063-appraisal:line046-pei01-02","text":"臣松之以爲盛云「君子志其大者，無所取諸」，故評家之旨，非新聲也。其餘所譏，則皆爲非理。自中原酷亂，至于建安，數十年間，生民殆盡，比至小康，皆百死之餘耳。江左雖有兵革，不能如中國之甚也，焉知達不算其安危，知禍有多少，利在東南，以全其身乎？而責不知魏氏將興，流播吳越，在京房之籌，猶不能自免刑戮，況達但以祕術見薄，在悔吝之間乎！古之道術，蓋非一方，探賾之功，豈惟六爻，苟得其要，則可以易而知之矣，迴轉一籌，胡足怪哉？達之推算，窮其要妙以知幽測隱，何愧于古！而以裨、梓限之，謂達爲妄，非篤論也。","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-063-appraisal:line046-pei01-02:m0000","start":0,"end":3,"surface":"臣松之","kind":"person","person_id":"vpy_180_2oi_AA","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-063-appraisal:line046-pei01-02:m0005","start":5,"end":6,"surface":"盛","kind":"person","person_id":"e74_385_649","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-063-appraisal:line046-pei01-02:m0094","start":94,"end":95,"surface":"達","kind":"person","person_id":"9vq_kh2_cfv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-063-appraisal:line046-pei01-02:m0133","start":133,"end":135,"surface":"京房","kind":"person","person_id":"s4d_48y_jxn","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-063-appraisal:line046-pei01-02:m0147","start":147,"end":148,"surface":"達","kind":"person","person_id":"9vq_kh2_cfv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-063-appraisal:line046-pei01-02:m0206","start":206,"end":207,"surface":"達","kind":"person","person_id":"9vq_kh2_cfv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-063-appraisal:line046-pei01-02:m0228","surface":"裨","start":228,"end":229,"kind":"person","person_id":"1xb_k1f_7m8","status":"contextual_provisional","interpretation_note":"按本段具名及前後親稱、官職定位。"},{"id":"c-sanguozhi-063-appraisal:line046-pei01-02:m0230","surface":"梓","start":230,"end":231,"kind":"person","person_id":"mp0_koq_6os","status":"contextual_provisional","interpretation_note":"按本段具名及前後親稱、官職定位。"},{"id":"c-sanguozhi-063-appraisal:line046-pei01-02:m0235","start":235,"end":236,"surface":"達","kind":"person","person_id":"9vq_kh2_cfv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"}],"annotation_status":"reviewed","source_position":{"first_line":46,"last_line":46,"revision_id":2188657,"raw_start":3134,"raw_end":3378,"character_positions":[3134,3135,3136,3137,3138,3139,3140,3141,3142,3143,3144,3145,3146,3147,3148,3149,3150,3151,3152,3153,3154,3155,3156,3157,3158,3159,3160,3161,3162,3163,3164,3165,3166,3167,3168,3169,3170,3171,3172,3173,3174,3175,3176,3177,3178,3179,3180,3181,3182,3183,3184,3185,3186,3187,3188,3189,3190,3191,3192,3193,3194,3195,3196,3197,3198,3199,3200,3201,3202,3203,3204,3205,3206,3207,3208,3209,3210,3211,3212,3213,3214,3215,3216,3217,3218,3219,3220,3221,3222,3223,3224,3225,3226,3227,3228,3229,3230,3231,3232,3233,3234,3235,3236,3237,3238,3239,3240,3241,3242,3243,3244,3245,3246,3247,3248,3249,3250,3251,3252,3253,3254,3255,3256,3257,3258,3259,3260,3261,3262,3263,3264,3265,3266,3267,3268,3269,3270,3271,3272,3273,3274,3275,3276,3277,3278,3279,3280,3281,3282,3283,3284,3285,3286,3287,3288,3289,3290,3291,3292,3293,3294,3295,3296,3297,3298,3299,3300,3301,3302,3303,3304,3305,3306,3307,3308,3309,3310,3311,3312,3313,3314,3315,3316,3317,3318,3319,3320,3321,3322,3323,3324,3325,3326,3327,3328,3329,3330,3331,3332,3333,3334,3335,3336,3337,3338,3339,3340,3341,3342,3343,3344,3345,3346,3347,3348,3349,3350,3351,3352,3353,3354,3355,3356,3357,3358,3359,3360,3361,3362,3363,3364,3365,3366,3367,3368,3369,3370,3371,3372,3373,3374,3375,3376,3377]},"attribution":{"annotator":"裴松之","attribution_kind":"editorial_judgment","source_label":"裴松之按","attribution_marker":"臣松之以爲"},"attachment":{"received_paragraph_id":"c-sanguozhi-063-appraisal:line046","received_codepoint":47,"note_ordinal":1,"source_ordinal":2},"chapter_id":"c-sanguozhi-063-appraisal","book_id":"b-sanguozhi-063","work_id":"w-sanguozhi","source_id":"s-sanguozhi-063-appraisal"}],"sources":[{"chapter_id":"c-jinshu-076-wangyi-family","work_id":"w-jinshu","book_id":"b-jinshu-076","source_id":"s-jinshu-076-wangyi-family","source":{"title":"《晉書》卷七十六（數位選錄）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7076&oldid=2180533","permalink":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7076&oldid=2180533","revision_id":2180533,"accessed_on":"2026-10-18","extent":"王廙題自第27至43行全文，含中興賦疏與附敘子孫。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，未親核底本影像","response_sha256":"c6c7c41bf93c491f6f69b058ecc493e979d65f3e65397d20055284f2e829cd30","wikitext_sha256":"872701db949f6f58ea6f183425617dfa82353177d2cc026037bfad953a60cd71","normalization":{"character_conversion":{},"extraction_note":"去首部空白，宋書ref校勘記另存，正文原字不改；不補平南將領的疑缺字。","excerpts":[{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:p001","source_lines":[27,28],"raw_quote":"王廙，字世將，丞相導從弟，而元帝姨弟也。父正，尚書郎。廙少能屬文，多所通涉，工書畫，善音樂、射御、博弈、雜伎。辟太傅掾，轉參軍。豫迎大駕，封武陵縣侯，拜尚書郎，出為濮陽太守。元帝作鎮江左，廙棄郡過江。帝見之大悅，以為司馬。頻守廬江、鄱陽二郡。豫討周馥、杜韜，以功累增封邑，除冠軍將軍，鎮石頭，領丞相軍諮祭酒。王敦啟為甯遠將軍、荊州刺史。","raw_quote_sha256":"8147d33d3202efaa1adf4a1c6aa137d71d239827b11033011846a53f38708001","selected_text_sha256":"8147d33d3202efaa1adf4a1c6aa137d71d239827b11033011846a53f38708001","begin_anchor":"王廙，字世將，丞相導從弟，而元","end_anchor":"。王敦啟為甯遠將軍、荊州刺史。"},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:line029","source_lines":[29,29],"raw_quote":"及帝即位，廙奏《中興賦》，上疏曰：","raw_quote_sha256":"561a1b9943833462648e1a80c82c5b21545b67f168b95ab6fcd1b0b706c38cb3","begin_anchor":"及帝即位，廙奏《中興賦》，上","end_anchor":"位，廙奏《中興賦》，上疏曰："},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:line031","source_lines":[31,31],"raw_quote":"{{quote|臣托備肺腑，幼蒙洪潤，愛自齠齔，至於弱冠，陛下之所撫育，恩侔于兄弟，義同于交友，思欲攀龍鱗附鳳翼者，有年矣，是以昔忝濮陽，棄官遠跡，扶持老母，攜將細弱，越長江歸陛下者，誠以道之所存，願託餘廕故也。天誘其願，遇陛下中興，當大明之盛，而守局遐外，不得奉瞻大禮，聞問之日，悲喜交集。昔司馬相如不得睹封禪之事，慷慨發憤，況臣情則骨肉，服膺聖化哉！","raw_quote_sha256":"9c582a92a469b985f92ae4aa27b0923109fe382bfd152e7e946d5908dd879e1b","begin_anchor":"臣托備肺腑，幼蒙洪潤，愛自齠","end_anchor":"，況臣情則骨肉，服膺聖化哉！"},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:line033","source_lines":[33,33],"raw_quote":"又臣昔嘗侍於先後，說陛下誕育之日，光明映室，白毫生於額之左，相者謂當王有四海。又臣以壬申歲見用為鄱陽內史，七月，四星聚於牽牛。又臣郡有枯樟更生。及臣後還京都，陛下見臣白兔，命臣作賦。時琅邪郡又獻甘露，陛下命臣嘗之。又驃騎將軍導向臣說晉陵有金鐸之瑞，郭璞雲必致中興。璞之爻筮，雖京房、管輅不過也。明天之歷數在陛下矣。","raw_quote_sha256":"bcbf3609e16aec908eb74b7bbfdb2b537098914823eeadaa9c2c2a2584c5535e","begin_anchor":"又臣昔嘗侍於先後，說陛下誕育","end_anchor":"不過也。明天之歷數在陛下矣。"},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:line035","source_lines":[35,35],"raw_quote":"臣少好文學，志在史籍，而飄放遐外，嘗與桀寇為對。臣犬馬之年四十三矣，未能上報天施，而愆負屢彰。恐先朝露，填溝壑，令微情不得上達，謹竭其頑，獻《[[中興賦]]》一篇。雖未雖以宣揚盛美，亦是詩人嗟歎詠歌之義也。}}","raw_quote_sha256":"13767a378d657e26ab2c4bdf3c61b8cc9d445b23d36464fb24b1a9c385026fda","begin_anchor":"臣少好文學，志在史籍，而飄放","end_anchor":"美，亦是詩人嗟歎詠歌之義也。"},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:line037","source_lines":[37,37],"raw_quote":"文多不載。","raw_quote_sha256":"3cec09c8474251e248ac71bdc8dc6bf63032579c75e9016438e0480dd0821c80","begin_anchor":"文多不載。","end_anchor":"文多不載。"},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:p002","source_lines":[39,40],"raw_quote":"初，王敦左遷陶侃，使廙代為荊州。將吏馬俊、鄭攀等上書請留侃，敦不許。廙為俊等所襲，奔于江安。賊杜曾與俊、攀北迎第五猗以距廙。廙督諸軍討曾，又為曾所敗。敦命湘州刺史甘卓、豫章太守周廣等助廙擊曾，曾衆潰，廙得到州。廙性俊率，嘗從南下，旦自尋陽，迅風飛帆，暮至都，倚舫樓長嘯，神氣甚逸。王導謂庾亮曰：「世將為傷時識事。」亮曰：「正足舒其逸氣耳。」廙在州大誅戮侃時將佐，及征士皇甫方回，於是大失荊土之望，人情乖阻。帝乃征廙為輔國將軍，加散騎常侍。以母喪去職。服闋，拜征虜將軍，進左衛將軍。","raw_quote_sha256":"713e46789dcf7fe1c521542418159b142d29f81e58c3e6357597be46caf9c662","selected_text_sha256":"713e46789dcf7fe1c521542418159b142d29f81e58c3e6357597be46caf9c662","begin_anchor":"初，王敦左遷陶侃，使廙代為荊州","end_anchor":"服闋，拜征虜將軍，進左衛將軍。"},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:p003","source_lines":[41,42],"raw_quote":"及王敦構禍，帝遣廙喻敦，既不能諫其悖逆，乃為敦所留，受任助亂。敦得志，以廙為平南將領護南蠻校尉、荊州刺史。尋病卒。帝猶以親故，深痛湣之。喪還京都，皇太子親臨拜柩，如家人之禮。贈侍中、驃騎將軍，諡曰康。明帝與大將軍溫嶠書曰：「痛謝鯤未絕於口，世將復至於此。並盛年雋才，不遂其志，痛切於心。廙明古多通，鯤遠有識致。其言雖未足令人改聽，然味之不倦，近未易有也。坐相視盡，如何！」","raw_quote_sha256":"b2c8c3b975ba6ac7732d8b4a11f0ec1be353f9f1fb577963a649d9140d52c2bb","selected_text_sha256":"b2c8c3b975ba6ac7732d8b4a11f0ec1be353f9f1fb577963a649d9140d52c2bb","begin_anchor":"及王敦構禍，帝遣廙喻敦，既不能","end_anchor":"近未易有也。坐相視盡，如何！」"},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:p004","source_lines":[43,44],"raw_quote":"子頤之嗣，仕至東海內史。頤之弟胡之，字修齡，弱冠有聲譽，歷郡守、侍中、丹陽尹。素有風眩疾，發動甚數，而神明不損。石季龍死，朝廷欲綏輯河洛，以胡之為西中郎將、司州刺史、假節，以疾固辭，未行而卒。子茂之亦有美譽，官至晉陵太守。子敬弘，義熙末為尚書。","raw_quote_sha256":"07b3bbc4071f24625a64510a17080b7ab063923ca9f6d5febeb0893dfefef0c6","selected_text_sha256":"07b3bbc4071f24625a64510a17080b7ab063923ca9f6d5febeb0893dfefef0c6","begin_anchor":"子頤之嗣，仕至東海內史。頤之弟","end_anchor":"陵太守。子敬弘，義熙末為尚書。"}]},"raw_path":"source-evidence/jin079-lang-zhong-xuan-dai/external/jin076-ws2180533.wikitext","raw_file_sha256":"872701db949f6f58ea6f183425617dfa82353177d2cc026037bfad953a60cd71"}},{"chapter_id":"c-sanguozhi-063-appraisal","work_id":"w-sanguozhi","book_id":"b-sanguozhi-063","source_id":"s-sanguozhi-063-appraisal","source":{"title":"三國志卷六十三·吳書十八","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?oldid=2188657","permalink":"https://zh.wikisource.org/w/index.php?oldid=2188657","revision_id":2188657,"accessed_on":"2026-11-21","edition":"維基文庫固定修訂，裴注與正文分層。","extent":"第46至46行。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古籍原文，維基文庫轉錄。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","raw_path":"source-evidence/sanguozhi063-wu-liu-zhao/sanguozhi063-ws2188657.wikitext","raw_file_sha256":"09476ea05c8009bbbcf1f0bab016a7fec3b22878ab03752df55992912f97344b","wikitext_sha256":"09476ea05c8009bbbcf1f0bab016a7fec3b22878ab03752df55992912f97344b","collation_witnesses":["source-evidence/sanguozhi063-appraisal/reading.json"]}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true}}
