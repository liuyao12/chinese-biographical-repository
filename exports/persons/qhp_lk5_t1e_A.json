,"status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m002-0381","start":381,"end":383,"surface":"鄧通","kind":"person","person_id":"qow_wy0_7d2","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m002-0392","start":392,"end":395,"surface":"長公主","kind":"person","person_id":"c0b_mpt_epd","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m002-0396","start":396,"end":398,"surface":"鄧通","kind":"person","person_id":"qow_wy0_7d2","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m002-0415","start":415,"end":418,"surface":"長公主","kind":"person","person_id":"c0b_mpt_epd","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m002-0436","start":436,"end":439,"surface":"孝景帝","kind":"person","person_id":"yqp_nlb_p1p_ACA","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m002-0451","start":451,"end":454,"surface":"周文仁","kind":"person","person_id":"leq_v5u_u2n","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m002-0455","start":455,"end":456,"surface":"仁","kind":"person","person_id":"leq_v5u_u2n","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m002-0466","start":466,"end":469,"surface":"今天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m002-0476","start":476,"end":480,"surface":"韓王孫嫣","kind":"person","person_id":"l9e_fbr_36a_*AB*A","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m002-0484","start":484,"end":487,"surface":"李延年","kind":"person","person_id":"qhp_lk5_t1e_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-125-ningxing","book_id":"b-shiji-125","work_id":"w-shiji","source_id":"s-shiji125-ningxing"},{"id":"c-shiji-125-ningxing:p004","text":"李延年，中山人也。父母及身兄弟及女，皆故倡也。延年坐法腐，給事狗中。而平陽公主言延年女弟善舞，上見，心說之，及入永巷，而召貴延年。延年善歌，為變新聲，而上方興天地祠，欲造樂詩歌弦之。延年善承意，弦次初詩。其女弟亦幸，有子男。延年佩二千石印，號協聲律。與上臥起，甚貴幸，埒如韓嫣也。久之，寖與中人亂，出入驕恣。及其女弟李夫人卒后，愛弛，則禽誅延年昆弟也。自是之后，內寵嬖臣大底外戚之家，然不足數也。衛青、霍去病亦以外戚貴幸，然頗用材能自進。","annotation_status":"in_progres