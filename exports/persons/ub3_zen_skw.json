"paragraph_id":"c-shiji-113-nanyue:p004","quote":"佗孫胡為南越王。此時閩越王郢興兵擊南越邊邑，胡使人上書曰：「兩越俱為藩臣，毋得擅興兵相攻擊。今閩越興兵侵臣，臣不敢興兵，唯天子詔之。」於是天子多南越義，守職約，為興師，遣兩將軍往討閩越。兵未踰嶺，閩越王弟餘善殺郢以降，於是罷兵。"}],"qualifiers":{"source_term":"閩越王弟餘善","relative_birth_order":{"older_person_id":"xp5_39k_w5w","younger_person_id":"ub3_zen_skw","operator":"lt","older_ordinal":null,"younger_ordinal":null,"scope":"siblings","interpretation_status":"source_attested"}},"interpretation_note":"明記弟，保存長幼而不補排行。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-113-nanyue:m004-0102","start":102,"end":104,"surface":"餘善","kind":"person","person_id":"ub3_zen_skw","status":"contextual_provisional","paragraph_id":"c-shiji-113-nanyue:p004","chapter_id":"c-shiji-113-nanyue"}],"relations":[{"id":"a-shiji113-002","subject_person_id":"ub3_zen_skw","predicate":"brother","object_person_id":"xp5_39k_w5w","status":"source_attested","evidence":[{"chapter_id":"c-shiji-113-nanyue","source_id":"s-shiji113-nanyue","paragraph_id":"c-shiji-113-nanyue:p004","quote":"佗孫胡為南越王。此時閩越王郢興兵擊南越邊邑，胡使人上書曰：「兩越俱為藩臣，毋得擅興兵相攻擊。今閩越興兵侵臣，臣不敢興兵，唯天子詔之。」於是天子多南越義，守職約，為興師，遣兩將軍往討閩越。兵未踰嶺，閩越王弟餘善殺郢以降，於是罷兵。"}],"qualifiers":{"source_term":"閩越王弟餘善","relative_birth_order":{"older_person_id":"xp5_39k_w5w","younger_person_id":"ub3_zen_skw","operator":"lt","older_ordinal":null,"younger_ordinal":null,"scope":"siblings","interpretation_status":"source_attested"}},"interpretation_note":"明記弟，保存長幼而不補排行。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[{"older_person_id":"xp5_39k_w5w","younger_person_id":"ub3_zen_skw","operator":"lt","older_ordinal":null,"younger_ordinal":null,"scope":"siblings","interpretation_status":"source_attested","assertion_id":"a-shiji113-002","person_id":"ub3_zen_skw","evidence":[{"chapter_id":"c-shiji-113-na