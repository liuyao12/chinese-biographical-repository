uded_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji113-002","subject_person_id":"ub3_zen_skw","predicate":"brother","object_person_id":"xp5_39k_w5w","status":"source_attested","evidence":[{"chapter_id":"c-shiji-113-nanyue","source_id":"s-shiji113-nanyue","paragraph_id":"c-shiji-113-nanyue:p004","quote":"佗孫胡為南越王。此時閩越王郢興兵擊南越邊邑，胡使人上書曰：「兩越俱為藩臣，毋得擅興兵相攻擊。今閩越興兵侵臣，臣不敢興兵，唯天子詔之。」於是天子多南越義，守職約，為興師，遣兩將軍往討閩越。兵未踰嶺，閩越王弟餘善殺郢以降，於是罷兵。"}],"qualifiers":{"source_term":"閩越王弟餘善","relative_birth_order":{"older_person_id":"xp5_39k_w5w","younger_person_id":"ub3_zen_skw","operator":"lt","older_ordinal":null,"younger_ordinal":null,"scope":"siblings","interpretation_status":"source_attested"}},"interpretation_note":"明記弟，保存長幼而不補排行。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji114-006","subject_person_id":"ub3_zen_skw","predicate":"brother","object_person_id":"xp5_39k_w5w","status":"source_attested","evidence":[{"chapter_id":"c-shiji-114-dongyue","source_id":"s-shiji114-dongyue","paragraph_id":"c-shiji-114-dongyue:p004","quote":"至建元六年，閩越擊南越。南越守天子約，不敢擅發兵擊而以聞。上遣大行王恢出豫章，大農韓安國出會稽，皆為將軍。兵未踰嶺，閩越王郢發兵距險。其弟餘善乃與相、宗族謀曰：「王以擅發兵擊南越，不請，故天子兵來誅。今漢兵眾彊，今即幸勝之，后來益多，終滅國而止。今殺王以謝天子。天子聽，罷兵，固一國完；不聽，乃力戰；不勝，即亡入海。」皆曰「善」。即鏦殺王，使使奉其頭致大行。大行曰：「所為來者誅王。今王頭至，謝罪，不戰而耘，利莫大焉。」乃以便宜案兵告大農軍，而使使奉王頭馳報天子。詔罷兩將兵，曰：「郢等首惡，獨無諸孫繇君丑不與謀焉。」乃使郎中將立丑為越繇王，奉閩越先祭祀。"}],"qualifiers":{"source_term":"其弟餘善","relative_birth_order":{"older_person_id":"xp5_39k_w5w","younger_person_id":"ub3_zen_skw","operator":"lt","older_ordinal":null,"younger_ordinal":null,"scope":"siblings","interpretation_status":"source_attested"}},"interpretation_note":"其弟承接郢，保存相對長幼，不補排行或父親。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-shiji114-p009-ub3_zen_skw","person_id":"ub3_zen_skw","event_type":"death","status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-114-dongyue","source_id":"s-shiji114-dongyue","paragraph_id":"c-shiji-114-dongyue:p009","quote":"故越衍侯吳陽前在漢，漢使歸諭餘善，餘善弗聽。及橫海將軍先至，越衍侯吳陽以其邑七百人反，攻越軍於漢陽。從建成侯敖，與其率，從繇王居股謀曰：「餘善首惡，劫守吾屬。今漢兵至，眾彊，計殺餘善，自歸諸將，儻幸得脫。」乃遂俱殺餘善，以其眾降橫海將軍，故封繇王居股為東成侯，萬戶；封建成侯敖為開陵侯；封越衍侯吳陽為北石侯；封橫海將軍說為案道侯；封橫海校尉福為繚嫈侯。福者，成陽共王子，故為海常侯，坐法失侯。舊從軍無功，以宗室故侯。諸將皆無成功，莫封。東越將多軍，漢兵至，棄其軍降，封為無錫侯。","person_mention_id":"c-shiji-114-dongyue:m009-0014"}],"interpretation_note":"被殺、斬或誅按明示個人死亡記錄，三校尉群體不拆姓名；未記地點不補，死亡不自動終止所有稱號。第9段日期承接尚待另核。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"mentions":[{"id":"c-shiji-113-nanyue:m004-0102","start":102,"end":104,"surface":"餘善","kind":"person","person_id":"ub3_zen_skw","status":"contextual_provisional","paragraph_id":"c-shiji-113-nanyue:p004","chapter_id":"c-shiji-113-nanyue"},{"id":"c-shiji-114-dongyue:m004-0069","start":69,"end":71,"surface":"餘善","kind":"person","person_id":"ub3_zen_skw","status":"contextual_provisional","paragraph_id":"c-shiji-114-dongyue:p004","chapter_id":"c-shiji-114-dongyue"},{"id":"c-shiji-114-dongyue:m005-0000","start":0,"end":2,"surface":"餘善","kind":"person","person_id":"ub3_zen_skw","status":"contextual_provisional","paragraph_id":"c-shiji-114-dongyue:p005","chapter_id":"c-shiji-114-dongyue"},{"id":"c-shiji-114-dongyue:m005-0038","start":38,"end":40,"surface":"餘善","kind":"person","person_id":"ub3_zen_skw","status":"contextual_provisional","paragraph_id":"c-shiji-114-dongyue:p005","chapter_id":"c-shiji-114-dongyue"},{"id":"c-shiji-114-dongyue:m005-0049","start":49,"end":51,"surface":"餘善","kind":"person","person_id":"ub3_zen_skw","status":"contextual_provisional","paragraph_id":"c-shiji-114-dongyue:p005","chapter_id":"c-shiji-114-dongyue"},{"id":"c-shiji-114-dongyue:m005-0071","start":71,"end":73,"surface":"餘善","kind":"person","person_id":"ub3_zen_skw","status":"contextual_provisional",