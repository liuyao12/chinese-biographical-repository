":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-043-wangrong:p010:m0033","start":33,"end":34,"surface":"子","kind":"person","person_id":"43s_gru_94d","status":"contextual_provisional","resolution_note":"倫子未明是哪一子，獨立匿名來源身份。","paragraph_id":"c-jinshu-043-wangrong:p010","chapter_id":"c-jinshu-043-wangrong"},{"id":"c-jinshu-043-wangrong:p010:m0058","start":58,"end":60,"surface":"少年","kind":"person","person_id":"43s_gru_94d","status":"contextual_provisional","resolution_note":"博士王繇指欲取戎的倫子，非齊王冏。","paragraph_id":"c-jinshu-043-wangrong:p010","chapter_id":"c-jinshu-043-wangrong"},{"id":"c-jinshu-043-wyd1739-wangrong:p007:m0022","start":22,"end":23,"surface":"子","kind":"person","person_id":"43s_gru_94d","status":"contextual_provisional","resolution_note":"倫子未明是哪一子，獨立匿名來源身份。","paragraph_id":"c-jinshu-043-wyd1739-wangrong:p007","chapter_id":"c-jinshu-043-wyd1739-wangrong"},{"id":"c-jinshu-043-wyd1739-wangrong:p007:m0043","start":43,"end":45,"surface":"少年","kind":"person","person_id":"43s_gru_94d","status":"contextual_provisional","resolution_note":"博士王繇指欲取戎的倫子，非齊王冏。","paragraph_id":"c-jinshu-043-wyd1739-wangrong:p007","chapter_id":"c-jinshu-043-wyd1739-wangrong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-jin043-wyd-wangrong-c-jinshu-043-wangrong-p010-m0033","person_id":"43s_gru_94d","surfaces":["子","少年"],"scope":"cross_chapter","chapter_ids":["c-jinshu-043-wyd1739-wangrong","c-jinshu-043-wangrong"],"status":"contextual_provisional","confidence_level":"moderate","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-043","source_id":"s-jinshu-043-wyd1739-wangrong","chapter_id":"c-jinshu-043-wyd1739-wangrong","paragraph_id":"c-jinshu-043-wyd1739-wangrong:p007","quote":"也頠誅戎坐免官齊王冏起義孫秀錄戎於城內趙王倫子欲取戎為軍司博士王繇曰濬沖譎詐多端安肯為少年用乃止惠帝反宮以戎為尚書令既而河間王顒遣使就說成都王穎將誅齊王冏檄書至冏謂戎曰孫秀作逆天子幽逼孤糾合義兵掃除元惡臣子之節信著神明二王聽讒造構大難當賴忠謀以和不協卿其善為我籌之戎曰公首舉義衆匡定大業開闢已來未始有也然論功報賞不及有勞朝野失望人懷貳志今二王帶甲百萬其鋒不可當若以王就第不失故爵委權崇讓此求安之計也冏謀臣葛旟怒曰漢魏以來","mention_ids":["c-jinshu-043-wyd1739-wangrong:p007:m0022","c-jinshu-043-wyd1739-wangrong:p007:m0043"]},{"work_id":"w-jinshu","book_id":"b-jinshu-043","source_id":"s-jinshu-043-ws2618531-wangrong","chapter_id":"c-jinshu-043-wangrong","paragraph_id":"c-jinshu-043-wangrong:p010","quote":"裴頠，戎之婿也，頠誅，戎坐免官。齊王冏起義，孫秀祿戎於城內，趙王倫子欲取戎為軍司。博士王繇曰：「濬沖譎詐多端，安肯為少年用？」乃止。惠帝反宮，以戎為尚書令。既而河間王顒遣使就說成都王穎，將誅齊王冏。檄書至，冏謂戎曰：「孫秀作逆，天子幽逼。孤糾合義兵，掃除元惡，臣子之節，信著神明。二王聽讒，造構大難，當賴忠謀，以和不協。卿其善為我籌之。」戎曰：「公首舉義眾，匡定大業，開闢以來，未始有也。然論功報嘗，不及有勞，朝野失望，人懷貳志。今二王帶甲百萬，其鋒不可當，若以王就第，不失故爵。委權崇讓，此求安之計也。」冏謀臣葛旟怒曰：「漢魏以來，王公就第，甯有得保妻子乎！議者可斬。」於是百官震悚，戎偽藥發墮廁，得不及禍。","mention_id":"c-jinshu-043-wangrong:p010:m0033"}],"rationale":"同一王戎完整本傳相同敘事、角色與引語域的跨見證首選；綁既有真MID/完整原段及動態現役端點，不以label或ID推同人。","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-043-wangrong:p010","text":"裴頠，戎之婿也，頠誅，戎坐免官。齊王冏起義，孫秀祿戎於城內，趙王倫子欲取戎為軍司。博士王繇曰：「濬沖譎詐多端，安肯為少年用？」乃止。惠帝反宮，以戎為尚書令。既而河間王顒遣使就說成都王穎，將誅齊王冏。檄書至，冏謂戎曰：「孫秀作逆，天子幽逼。孤糾合義兵，掃除元惡，臣子之節，信著神明。二王聽讒，造構大難，當賴忠謀，以和不協。卿其善為我籌之。」戎曰：「公首舉義眾，匡定大業，開闢以來，未始有也。然論功報嘗，不及有勞，朝野失望，人懷貳志。今二王帶甲百萬，其鋒不可當，若以王就第，不失故爵。委權崇讓，此求安之計也。」冏謀臣葛旟怒曰：「漢魏以來，王公就第，甯有得保妻子乎！議者可斬。」於是百官震悚，戎偽藥發墮廁，得不及禍。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-043-wangrong:p010:m0000","start":0,"end":2,"surface":"裴頠","kind":"person","person_id":"kbq_kjc_n2f_AAB","status":"contextual_provisional","resolution_note":"八王亂時域，冏引語之孤/戎引語之公屬冏，卿是冏對戎；兩王群指顒與穎但不拆單代詞。"},{"id":"c-jinshu-043-wangrong:p010:m0003","start":3,"end":4,"surface":"戎","kind":"person","person_id":"ehx_cqg_nfx_AA","status":"contextual_provisional","resolution_note":"八王亂時域，冏引語之孤/戎引語之公屬冏，卿是冏對戎；兩王群指顒與穎但不拆單代詞。"},{"id":"c-jinshu-043-wangrong:p010:m0008","start":8,"end":9,"surface":"頠","kind":"person","person_id":"kbq_kjc_n2f