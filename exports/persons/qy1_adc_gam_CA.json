provisional"},{"id":"c-shiji-037-wei:m020-0092","start":92,"end":93,"surface":"申","kind":"person","person_id":"kt8_3kv_44r_A","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m020-0094","start":94,"end":96,"surface":"戴公","kind":"person","person_id":"kt8_3kv_44r_A","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m020-0097","start":97,"end":99,"surface":"戴公","kind":"person","person_id":"kt8_3kv_44r_A","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m020-0105","start":105,"end":106,"surface":"燬","kind":"person","person_id":"i8i_rvh_4lp","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m020-0107","start":107,"end":109,"surface":"文公","kind":"person","person_id":"i8i_rvh_4lp","status":"contextual_provisional"}],"chapter_id":"c-shiji-037-wei","book_id":"b-shiji-037","work_id":"w-shiji","source_id":"s-shiji-037-wei"},{"id":"c-shiji-037-wei:p023","text":"成公三年，晉欲假道於衞救宋，成公不許。晉更從南河度，救宋。徴師於衞，衞大夫欲許，成公不肯。大夫元咺攻成公，成公出奔。晉文公重耳伐衞，分其地予宋，討前過無禮及不救宋患也。衞成公遂出奔陳。二歳，如周求入，與晉文公會。晉使人鴆衞成公，成公私於周主鴆，令薄，得不死。已而周爲請晉文公，卒入之衞，而誅元咺，衞君瑕出奔。七年，晉文公卒。十二年，成公朝晉襄公。十四年，秦穆公卒。二十六年，齊邴歜弒其君懿公。三十五年，成公卒，子穆公遫立。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-037-wei:m023-0000","start":0,"end":2,"surface":"成公","kind":"person","person_id":"i8i_rvh_4lp_A","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m023-0014","start":14,"end":16,"surface":"成公","kind":"person","person_id":"i8i_rvh_4lp_A","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m023-0035","start":35,"end":37,"surface":"大夫","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、並稱、匿名者、校勘或尚未定指代；不補姓名、親屬、闕代或成員。"},{"id":"c-shiji-037-wei:m023-0040","start":40,"end":42,"surface":"成公","kind":"person","person_id":"i8i_rvh_4lp_A","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m023-0045","start":45,"end":47,"surface":"大夫","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、並稱、匿名者、校勘或尚未定指代；不補姓名、親屬、闕代或成員。"},{"id":"c-shiji-037-wei:m023