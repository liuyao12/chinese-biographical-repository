extual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-sanguozhi-057-luotong:line061-pei01-01:reading-000-130","kind":"annotation_sentence","paragraph_id":"c-sanguozhi-057-luotong:line061-pei01-01","start_codepoint":0,"end_codepoint":130,"source_quote":"谢承《后汉书》曰：俊字孝远，有文武才幹，少为郡吏，察孝廉，补尚书郎，擢拜陈相。值袁术僭号，兄弟忿争，天下鼎沸，群贼并起，陈与比界，奸慝四布，俊厉威武，保疆境，贼不敢犯。养济百姓，灾害不生，岁获丰稔。后术军众饥困，就俊求粮。俊疾恶术，初不应答。术怒，密使人杀俊。","person_id":"bvu_zfh_14y","related_person_ids":["khh_wth_u1d","865_b69_cb0"],"reading":"謝承後漢書載俊官至陳相。袁術求糧不應，使人殺之。","chapter_id":"c-sanguozhi-057-luotong","source_id":"s-sanguozhi-057-luotong"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-wu057-luotong-0","subject_person_id":"7tc_utz_m7l","object_person_id":"bvu_zfh_14y","predicate":"father","qualifiers":{"source_term":"父俊"},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-057","chapter_id":"c-sanguozhi-057-luotong","source_id":"s-sanguozhi-057-luotong","paragraph_id":"c-sanguozhi-057-luotong:line061","quote":"駱統字公緒，會稽烏傷人也。父俊，官至陳相。為袁術所害。統母改適，為華歆小妻，統時八歲，遂與親客歸會稽。其母送之，拜辭上車，面而不顧，其母泣涕於後。御者曰：「夫人猶在也。」統曰：「不欲增母思，故不顧耳。」事適母甚謹。時饑荒，鄉里及遠方客多有困乏，統為之飲食衰少。其姊仁愛有行，寡歸無子，見統甚哀之，數問其故。統曰：「士大夫糟糠不足，我何心獨飽!」姊曰：「誠如是，何不告我，而自苦若此？」乃自以私粟與統，又以告母，母亦賢之，遂使分施，由是顯名。","subject_person_mention_id":"c-sanguozhi-057-luotong:line061:m0001","object_person_mention_id":"c-sanguozhi-057-luotong:line061:m0014"}],"interpretation_note":"以此來源所述兩端為據。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-wu057-luotong1","person_id":"bvu_zfh_14y","event_type":"death","source_term":"為袁術所害","date_expression":null,"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-057","chapter_id":"c-sanguozhi-057-luotong","source_id":"