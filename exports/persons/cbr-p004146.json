shiji","book_id":"b-shiji-005","chapter_id":"c-shiji-005-qin","mention_count":1,"mention_ids":["c-shiji-005-qin:m068-0021"],"paragraph_ids":["c-shiji-005-qin:p068"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-071-chugan"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-005-qin:m068-0021","start":21,"end":23,"surface":"魏章","kind":"person","person_id":"2pv_dtb_lrw","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p068","chapter_id":"c-shiji-005-qin"},{"id":"c-shiji-071-chugan:m002-0064","start":64,"end":66,"surface":"魏章","kind":"person","person_id":"m1q_tly_ucl","status":"contextual_provisional","paragraph_id":"c-shiji-071-chugan:p002","chapter_id":"c-shiji-071-chugan"},{"id":"c-shiji-071-chugan:m003-0015","start":15,"end":17,"surface":"魏章","kind":"person","person_id":"m1q_tly_ucl","status":"contextual_provisional","paragraph_id":"c-shiji-071-chugan:p003","chapter_id":"c-shiji-071-chugan"},{"id":"c-shiji-071-chugan:m007-0048","start":48,"end":50,"surface":"魏章","kind":"person","person_id":"m1q_tly_ucl","status":"contextual_provisional","paragraph_id":"c-shiji-071-chugan:p007","chapter_id":"c-shiji-071-chugan"},{"id":"c-shiji-071-chugan:m008-0011","start":11,"end":13,"surface":"魏章","kind":"person","person_id":"m1q_tly_ucl","status":"contextual_provisional","paragraph_id":"c-shiji-071-chugan:p008","chapter_id":"c-shiji-071-chugan"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji071-005","person_id":"m1q_tly_ucl","surfaces":["魏章"],"scope":"same_chapter","chapter_ids":["c-shiji-071-chugan"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-071-chugan:p002","quote":"秦惠王八年，爵樗里子右更，使將而伐曲沃，盡出其人，取其城，地入秦。秦惠王二十五年，使樗里子為將伐趙，虜趙將軍莊豹，拔藺。明年，助魏章攻楚，敗楚將屈丐，取漢中地。秦封樗里子，號為嚴君。"},{"paragraph_id":"c-shiji-071-chugan:p003","quote":"秦惠王卒，太子武王立，逐張儀、魏章，而以樗里子、甘茂為左右丞相。秦使甘茂攻韓，拔宜陽。使樗里子以車百乘入周。周以卒迎之，意甚敬。楚王怒，讓周，以其重秦客。游騰為周說楚王曰：「知伯之伐仇猶，遺之廣車，因隨之以兵，仇猶遂亡。何則？無備故也。齊桓公伐蔡，號曰誅楚，其實襲蔡。今秦，虎狼之國，使樗里子以車百乘入周，周以仇猶、蔡觀焉，故使長戟居前，彊弩在後，名曰衛疾，而實囚之。且夫周豈能無憂其社稷哉？恐一旦亡國以憂大王。」楚王乃悅。"},{"paragraph_id":"c-shiji-071-chugan:p007","quote":"甘茂者，下蔡人也。事下蔡史舉先生，學百家之說。因張儀、樗里子而求見秦惠王。王見而說之，使將，而佐魏章略定漢中地。"},{"paragraph_id":"c-shiji-071-chugan:p008","quote":"惠王卒，武王立。張儀、魏章去，東之魏。蜀侯煇、相壯反，秦使甘茂定蜀。還，而以甘茂為左丞相，以樗里子為右丞相。"}],"rationale":"依前6段明示名字與局部敘事暫接，樗里子名疾與智囊嚴君明示相配。樗裏只取末句人物比擬，不取陰鄉地名；預言天子不補漢代皇帝。惠王、武王、昭王依卒立分辨；未名韓女、蒲守與衛君不補姓名，異母不補惠王母。游騰引古知伯齊桓公不當同期在場者。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji071-wei","person_ids":["2pv_dtb_lrw","m1q_tly_ucl"],"canonical_person_id":"2pv_dtb_lrw","scope":"cross_chapter","chapter_ids":["c-shiji-005-qin","c-shiji-071-chugan"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-005-qin","source_id":"s-shiji-005-qin","paragraph_id":"c-shiji-005-qin:p068","quote":"武王元年，與魏惠王會臨晉。誅蜀相壯。張儀、魏章皆東出之魏。伐義渠、丹、犁。二年，初置丞相，摢裏疾、甘茂為左右丞相。張儀死於魏。三年，與韓襄王會臨晉外。南公揭卒，摢裏疾相韓。武王謂甘茂曰：「寡人欲容車通三川，窺周室，死不恨矣。」其秋，使甘茂、庶長封伐宜陽。四年，拔宜陽，斬首六萬。涉河，城武遂。魏太子來朝。武王有力好戲，力士任鄙、烏獲、孟說皆至大官。王與孟說舉鼎，絕臏。八月，武王死。族孟說。武王取魏女為后，無子。立異母弟，是為昭襄王。昭襄母楚人，姓羋氏，號宣太后。武王死時，昭襄王為質於燕，燕人送歸，得立。","mention_ids":["c-shiji-005-qin:m068-0021"]},{"chapter_id":"c-shiji-071-chugan","source_id":"s-shiji-071-chugan","paragraph_id":"c-shiji-071-chugan:p008","quote":"惠王卒，武王立。張儀、魏章去，東之魏。蜀侯煇、相壯反，秦使甘茂定蜀。還，而以甘茂為左丞相，以樗里子為右丞相。","mention_ids":["c-shiji-071-chugan:m008-0011"]}],"rationale":"兩篇張儀與魏章在秦武王立後東去魏，姓名、共同人物及出秦事件相配。 各篇原文與已發ID保留；同書篇章不當獨立見證。同指不確證年代、任職、人物傳說或所有敘事，版本仍待覆核。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-005-qin:p068","text":"武王元年，與魏惠王會臨晉。誅蜀相壯。張儀、魏章皆東出之魏。伐義渠、丹、犁。二年，初置丞相，摢裏疾、甘茂為左右丞相。張儀死於魏。三年，與韓襄王會臨晉外。南公揭卒，摢裏疾相韓。武王謂甘茂曰：「寡人欲容車通三川，窺周室，死不恨矣。」其秋，使甘茂、庶長封伐宜陽。四年，拔宜陽，斬首六萬。涉河，城武遂。魏太子來朝。武王有力好戲，力士任鄙、烏獲、孟說皆至大官。王與孟說舉鼎，絕臏。八月，武王死。族孟說。武王取魏女為后，無子。立異母弟，是為昭襄王。昭襄母楚人，姓羋氏，號宣太后。武王死時，昭襄王為質於燕，燕人送歸，得立。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m068-0000","start":0,"end":2,"surface":"武王","kind":"person","person_id":"y97_huh_vuz_AAAAAAAAAAAAABAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0006","start":6,"end":9,"surface":"魏惠王","kind":"person","person_id":"bhp_5xd_88r","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0014","start":14,"end":17,"surface":"蜀相壯","kind":"person","person_id":"kqe_x0t_s25","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0018","start":18,"end":20,"surface":"張儀","kind":"person","person_id":"uq6_74z_vtv","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0021","start":21,"end":23,"surface":"魏章","kind":"person","person_id":"2pv_dtb_lrw","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0045","start":45,"end":48,"surface":"摢裏疾","kind":"person","person_id":"r9n_0vc_ywa","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0049","start":49,"end":51,"surface":"甘茂","kind":"person","person_id":"8im_m5e_cpy","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0057","start":57,"end":59,"surface":"張儀","kind":"person","person_id":"uq6_74z_vtv","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0067","start":67,"end":70,"surface":"韓襄王","kind":"person","person_id":"a0a_4q4_biw","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0075","start":75,"end":78,"surface":"南公揭","kind":"person","person_id":"iln_cic_3d5","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0080","start":80,"end":83,"surface":"摢裏疾","kind":"person","person_id":"r9n_0vc_ywa","status":"contextual_provisional"},{"id":"c-shiji-00