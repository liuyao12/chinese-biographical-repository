":"q6q_ax8_y9p","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m002-0042","start":42,"end":45,"surface":"樗里子","kind":"person","person_id":"fae_ax5_a6k","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m002-0051","start":51,"end":56,"surface":"趙將軍莊豹","kind":"person","person_id":"yg1_ml2_61c","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m002-0064","start":64,"end":66,"surface":"魏章","kind":"person","person_id":"m1q_tly_ucl","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m002-0070","start":70,"end":74,"surface":"楚將屈丐","kind":"person","person_id":"mrk_rv8_zvi","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m002-0082","start":82,"end":85,"surface":"樗里子","kind":"person","person_id":"fae_ax5_a6k","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m002-0088","start":88,"end":90,"surface":"嚴君","kind":"person","person_id":"fae_ax5_a6k","status":"contextual_provisional"}],"chapter_id":"c-shiji-071-chugan","book_id":"b-shiji-071","work_id":"w-shiji","source_id":"s-shiji-071-chugan"},{"id":"c-shiji-071-chugan:p003","text":"秦惠王卒，太子武王立，逐張儀、魏章，而以樗里子、甘茂為左右丞相。秦使甘茂攻韓，拔宜陽。使樗里子以車百乘入周。周以卒迎之，意甚敬。楚王怒，讓周，以其重秦客。游騰為周說楚王曰：「知伯之伐仇猶，遺之廣車，因隨之以兵，仇猶遂亡。何則？無備故也。齊桓公伐蔡，號曰誅楚，其實襲蔡。今秦，虎狼之國，使樗里子以車百乘入周，周以仇猶、蔡觀焉，故使長戟居前，彊弩在後，名曰衛疾，而實囚之。且夫周豈能無憂其社稷哉？恐一旦亡國以憂大王。」楚王乃悅。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-071-chugan:m003-0000","start":0,"end":3,"surface":"秦惠王","kind":"person","person_id":"q6q_ax8_y9p","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m003-0005","start":5,"end":9,"surface":"太子武王","kind":"person","person_id":"oaj_udd_7d9","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m003-0012","start":12,"end":14,"surface":"張儀","kind":"person","person_id":"0tj_vst_yao","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m003-0015","start":15,"end":17,"surface":"魏章","kind":"person","person_id":"m1q_tly_ucl","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m003-0020","start":20,"end":23,"surface":"樗里子","kind":"person","person_id":"fae_ax5_a6k","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m003-0024","start":24,"end":26,"surface":"甘茂","kind":"person","person_id":"xcr_p13_j7x","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m003-0034","start":34,"end":36,"surface":"甘茂","kind":"person","person_id":"xcr_p13_j7x","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m003-0044","start":44,"end":47,"surface":"樗里子","kind":"person","person_id":"fae_ax5_a6k","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m003-0052","start":52,"end":53,"surface":"周","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、國稱、未名者或預言中的未定指代，不補人物及成員。"},{"id":"c-shiji-071-chugan:m003-0054","start":54,"end":55,"surface":"周","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、國稱、未名者或預言中的未定指代，不補人物及成員。"},{"id":"c-shiji-071-chugan:m003-0064","start":64,"end":66,"surface":"楚王","kind":"person","person_id":"nbk_qg1_64o","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m003-0069","start":69,"end":70,"surface":"周","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、國稱、未名者或預言中的未定指代，不補人物及成員。"},{"id":"c-shiji-071-chugan:m003-0074","start":74,"end":76,"surface":"秦客","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、國稱、未名者或預言中的未定指代，不補人物及成員。"},{"id":"c-shiji-071-chugan:m003-0077","start":77,"end":79,"surface":"游騰","kind":"person","person_id":"65u_rbx_hst","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m003-0080","start":80,"end":81,"surface":"周","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、國稱、未名者或預言中的未定指代，不補人物及成員。"},{"id":"c-shiji-071-chugan:m003-0082","start":82,"end":84,"surface":"楚王","kind":"person","person_id":"nbk_qg1_64o","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m003-0087","start":87,"end":89,"surface":"知伯","kind":"person","person_id":"d70_b62_mly","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m003-0091","start":91,"end":93,"surface":"仇猶","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、國稱、未名者或預言中的未定指代，不補人物及成員。"},{"id":"c-shiji-071-chugan:m003-0105","start":105,"end":107,"surface":"仇猶","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、國稱、未名者或預言中的未定指代，不補人物及成員。"},{"id":"c-shiji-071-chugan:m003-0118","start":118,"end":121,"surface":"齊桓公","kind":"person","person_id":"sii_gh4_8vi","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m003-0143","start":143,"end":146,"surface":"樗里子","kind":"person","person_id":"fae_ax5_a6k","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m003-0151","start":151,"end":152,"surface":"周","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、國稱、未名者或預言中的未定指代，不補人物及成員。"},{"id":"c-shiji-071-chugan:m003-0153","start":153,"end":154,"surface":"周","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、國稱、未名者或預言中的未定指代，不補人物及成員。"},{"id":"c-shiji-071-chugan:m003-0155","start":155,"end":157,"surface":"仇猶","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、國稱、未名者或預言中的未定指代，不補人物及成員。"},{"id":"c-shiji-071-chugan:m003-0177","start":177,"end":178,"surface":"疾","kind":"person","person_id":"fae_ax5_a6k","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m003-0186","start":186,"end":187,"surface":"周","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、國稱、未名者或預言中的未定指代，不補人物及成員。"},{"id":"c-shiji-071-chugan:m003-0203","start":203,"end":205,"surface":"大王","kind":"person","person_id":"nbk_qg1_64o","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m003-0207","start":207,"end":209,"surface":"楚王","kind":"person","person_id":"nbk_qg1_64o","status":"contextual_provisional"}],"chapter_id":"c-shiji-071-chugan","book_id":"b-shiji-071","work_id":"w-shiji","source_id":"s-shiji-071-chugan"},{"id":"c-shiji-071-chugan:p007","text":"甘茂者，下蔡人也。事下蔡史舉先生，學百家之說。因張儀、樗里子而求見秦惠王。王見而說之，使將，而佐魏章略定漢中地。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-071-chugan:m007-0000","start":0,"end":2,"surface":"甘茂","kind":"person","person_id":"xcr_p13_j7x","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m007-0012","start":12,"end":16,"surface":"史舉先生","kind":"person","person_id":"usb_mt6_egg","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m007-0024","start":24,"end":26,"surface":"張儀","kind":"person","person_id":"0tj_vst_yao","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m007-0027","start":27,"end":30,"surface":"樗里子","kind":"person","person_id":"fae_ax5_a6k","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m007-0033","start":33,"end":36,"surface":"秦惠王","kind":"person","person_id":"q6q_ax8_y9p","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m007-0037","start":37,"end":38,"surface":"王","kind":"person","person_id":"q6q_ax8_y9p","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m007-0048","start":48,"end":50,"surface":"魏章","kind":"person","person_id":"m1q_tly_ucl","status":"contextual_provisional"}],"chapter_id":"c-shiji-071-chugan","book_id":"b-shiji-071","work_id":"w-shiji","source_id":"s-shiji-071-chugan"},{"id":"c-shiji-071-chugan:p008","text":"惠王卒，武王立。張儀、魏章去，東之魏。蜀侯煇、相壯反，秦使甘茂定蜀。還，而以甘茂為左丞相，以樗里子為右丞相。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-071-chugan:m008-0000","start":0,"end":2,"surface":"惠王","kind":"person","person_id":"q6q_ax8_y9p","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m008-0004","start":4,"end":6,"surface":"武王","kind":"person","person_id":"oaj_udd_7d9","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m008-0008","start":8,"end":10,"surface":"張儀","kind":"person","person_id":"0tj_vst_yao","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m008-0011","start":11,"end":13,"surface":"魏章","kind":"person","per