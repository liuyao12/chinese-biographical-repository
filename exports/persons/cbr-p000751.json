,"text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m004-0003","start":3,"end":5,"surface":"呂公","kind":"person","person_id":"cbr-p000751","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m004-0006","start":6,"end":8,"surface":"沛令","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名官稱或傳說指稱尚待覆核；不補姓名或親屬。"},{"id":"c-shiji-008-gaozu:m004-0035","start":35,"end":37,"surface":"蕭何","kind":"person","person_id":"cbr-p000720","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m004-0063","start":63,"end":65,"surface":"高祖","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m004-0094","start":94,"end":96,"surface":"呂公","kind":"person","person_id":"cbr-p000751","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m004-0105","start":105,"end":107,"surface":"呂公","kind":"person","person_id":"cbr-p000751","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m004-0114","start":114,"end":116,"surface":"高祖","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m004-0128","start":128,"end":130,"surface":"蕭何","kind":"person","person_id":"cbr-p000720","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m004-0133","start":133,"end":135,"surface":"劉季","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m004-0145","start":145,"end":147,"surface":"高祖","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m004-0165","start":165,"end":167,"surface":"呂公","kind":"person","person_id":"cbr-p000751","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m004-0171","start":171,"end":173,"surface":"高祖","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m004-0174","start":174,"end":176,"surface":"高祖","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id