g_cases":[{"id":"c-nanqishu-059-western-polities-complete:source_review22-0","kind":"source_review","person_id":"gxd_sho_nx7","source_quote":"使道寶步出魏興，分軍泝墊江，俱會晉壽。太祖以文弘背叛，進廣香為持節、都督西秦州刺史。廣香子北部鎮將軍郡事炅為征虜將軍、武都太守。以難當正胤楊後起為持節、寧朔將軍、平羌校尉、北秦州刺史、武都王，鎮武興，即文弘從兄子也。","reading":"王道寶進兵、楊廣香所進銜、其子炅任載與楊後起受封在同段，用原詞分界。","note":"王道寶進兵、楊廣香所進銜、其子炅任載與楊後起受封在同段，用原詞分界。","paragraph_id":"c-nanqishu-059-western-polities-complete:p022","start_codepoint":0,"end_codepoint":108,"human_reviewed":false,"chapter_id":"c-nanqishu-059-western-polities-complete","source_id":"s-nanqishu-059-western-polities-complete-ws1748911"},{"id":"c-nanqishu-059-western-polities-complete:variant_review22-42","kind":"variant_review","person_id":"gxd_sho_nx7","source_quote":"廣香子北部鎮將軍郡事炅","reading":"楊炅父廣香，本卷下又有炅子崇祖。父子及所終官證分錄。","note":"楊炅父廣香，本卷下又有炅子崇祖。父子及所終官證分錄。","paragraph_id":"c-nanqishu-059-western-polities-complete:p022","start_codepoint":42,"end_codepoint":53,"human_reviewed":false,"chapter_id":"c-nanqishu-059-western-polities-complete","source_id":"s-nanqishu-059-western-polities-complete-ws1748911"},{"id":"c-nanqishu-059-western-polities-complete:variant_review22-100","kind":"variant_review","person_id":"gxd_sho_nx7","source_quote":"即文弘從兄子也","reading":"後起一處稱文弘從兄子，後一段作從子。難當正胤是原稱，無直接父名。","note":"後起一處稱文弘從兄子，後一段作從子。難當正胤是原稱，無直接父名。","paragraph_id":"c-nanqishu-059-western-polities-complete:p022","start_codepoint":100,"end_codepoint":107,"human_reviewed":false,"chapter_id":"c-nanqishu-059-western-polities-complete","source_id":"s-nanqishu-059-western-polities-complete-ws1748911"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-qi059-yanghouqi-brother","subject_person_id":"gxd_sho_nx7","object_person_id":"qqo_7en_sew","predicate":"brother","qualifiers":{"source_term":"後起弟後明"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-059","chapter_id":"c-nanqishu-059-western-polities-complete","source_id":"s-nanqishu-059-western-polities-complete-ws1748911","paragraph_id":"c-nanqishu-059-western-polities-complete:p024","quote":"世祖即位，進後起號冠軍將軍。永明元年，以征虜將軍炅為沙州刺史、陰平王，將軍如故。二年，八座奏，後起（勒）〔勤〕彰款塞，忠著邊城。進號征虜將軍。四年，後起卒，詔曰：「後起奄至殞逝，惻愴于懷。綏禦邊服，宜詳其選。行輔國將軍、北秦州刺史、武都王楊集始，幹局沈亮，乃心忠款，必能緝境寧民、宣揚聲教。可持節、輔國將軍、北秦州刺史、平羌校尉、武都王。」後起弟後明為龍驤將軍、白水太守。集始弟集朗為寧朔將軍。五年，有司奏集始驅狐剪棘，仰化邊服。母以子貴，宜加榮寵。除集始母姜氏為太夫人，假銀印。九年，八座奏，楊炅嗣勤西牧，馳款內昭，宜增戎章，用輝遐外。進號前將軍。","subject_person_mention_id":"c-nanqishu-059-western-polities-complete:p024:m0006","object_person_mention_id":"c-nanqishu-059-western-polities-complete:p024:m0173"}],"status":"source_attested","interpretation_note":"後明任白水太守。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-qi059-yang-houqi-death","person_id":"gxd_sho_nx7","event_type":"death","source_term":"卒","source_anchor":{"paragraph_id":"c-nanqishu-059-western-polities-complete:p024","start":76,"end":77,"surface":"卒"},"date_expression":"四年","evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-059","chapter_id":"c-nanqishu-059-western-polities-complete","source_id":"s-nanqishu-059-western-polities-complete-ws1748911","paragraph_id":"c-nanqishu-059-western-polities-complete:p024","quote":"世祖即位，進後起號冠軍將軍。永明元年，以征虜將軍炅為沙州刺史、陰平王，將軍如故。二年，八座奏，後起（勒）〔勤〕彰款塞，忠著邊城。進號征虜將軍。四年，後起卒，詔曰：「後起奄至殞逝，惻愴于懷。綏禦邊服，宜詳其選。行輔國將軍、北秦州刺史、武都王楊集始，幹局沈亮，乃心忠款，必能緝境寧民、宣揚聲教。可持節、輔國將軍、北秦州刺史、平羌校尉、武都王。」後起弟後明為龍驤將軍、白水太守。集始弟集朗為寧朔將軍。五年，有司奏集始驅狐剪棘，仰化邊服。母以子貴，宜加榮寵。除集始母姜氏為太夫人，假銀印。九年，八座奏，楊炅嗣勤西牧，馳款內昭，宜增戎章，用輝遐外。進號前將軍。","person_mention_id":"c-nanqishu-059-western-polities-complete:p024:m0006"}],"status":"source_attested","interpretation_note":"按同段人物與次第核所屬卒事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"mentions":[{"id":"c-nanqishu-059-western-polities-complete:p022:m0069","start":69,"end":72,"surface":"楊後起","kind":"person","person_id":"gxd_sho_nx7","status":"contextual_provisional","paragraph_id":"c-nanqishu-059-western-polities-co