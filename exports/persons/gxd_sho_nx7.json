":"後明","kind":"person","person_id":"qqo_7en_sew","status":"contextual_provisional"},{"id":"c-nanqishu-059-western-polities-complete:p024:m0186","start":186,"end":188,"surface":"集始","kind":"person","person_id":"5ss_qfy_aid","status":"contextual_provisional"},{"id":"c-nanqishu-059-western-polities-complete:p024:m0189","start":189,"end":191,"surface":"集朗","kind":"person","person_id":"eap_k63_06j","status":"contextual_provisional"},{"id":"c-nanqishu-059-western-polities-complete:p024:m0203","start":203,"end":205,"surface":"集始","kind":"person","person_id":"5ss_qfy_aid","status":"contextual_provisional"},{"id":"c-nanqishu-059-western-polities-complete:p024:m0226","start":226,"end":228,"surface":"集始","kind":"person","person_id":"5ss_qfy_aid","status":"contextual_provisional"},{"id":"c-nanqishu-059-western-polities-complete:p024:m0229","start":229,"end":231,"surface":"姜氏","kind":"person","person_id":"qp1_872_mda","status":"contextual_provisional"},{"id":"c-nanqishu-059-western-polities-complete:p024:m0247","start":247,"end":249,"surface":"楊炅","kind":"person","person_id":"sl2_clv_v9l","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-059-western-polities-complete","book_id":"b-nanqishu-059","work_id":"w-nanqishu","source_id":"s-nanqishu-059-western-polities-complete-ws1748911"},{"id":"c-nanqishu-059-western-polities-complete:p028","text":"建武二年，氐、虜寇漢中。梁州刺史蕭懿遣前氐王楊後起弟子元秀收合義兵，氐眾響應，斷虜運道。虜亦遣偽南梁州刺史仇池公楊靈珍據泥山以相拒格。元秀病死，符幼孫領其眾。高宗詔曰：「仇池公楊元秀，氐王苗胤，乃心忠勇，醜虜凶逼，血誠彌厲，宣播朝威，招誘戎種，萬里齊契，響然歸從。誠効顯著，寔有可嘉。不幸殞喪，悽愴于懷。夫死事加恩，陽秋明義。宜追覃榮典，以弘勸奬。贈仇池公。持歸國。」","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":67,"last_line":67,"raw_start":4865,"raw_end":5049,"raw_character_offsets":[4865,4866,4867,4868,4869,4870,4871,4872,4873,4874,4875,4876,4877,4878,4879,4880,4881,4882,4883,4884,4885,4886,4887,4888,4889,4890,4891,4892,4893,4894,4895,4896,4897,4898,4899,4900,4901,4902,4903,4904,4905,4906,4907,4908,4909,4910,4911,4912,4913,4914,4915,4916,4917,4918,4919,4920,4