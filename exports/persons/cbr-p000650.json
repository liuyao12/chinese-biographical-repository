er_id":"c-shiji-007-xiangyu","book_id":"b-shiji-007","work_id":"w-shiji","source_id":"s-shiji-007-xiangyu"},{"id":"c-shiji-007-xiangyu:p035","text":"項王聞淮陰侯已舉河北，破齊、趙，且欲擊楚，乃使龍且往擊之。淮陰侯與戰，騎將灌嬰擊之，大破楚軍，殺龍且。韓信因自立為齊王。項王聞龍且軍破，則恐，使盱台人武涉往說淮陰侯。淮陰侯弗聽。是時，彭越復反，下梁地，絕楚糧。項王乃謂海春侯大司馬曹咎等曰：「謹守成皋，則漢欲挑戰，慎勿與戰，毋令得東而已。我十五日必誅彭越，定梁地，復從將軍。」乃東，行擊陳留、外黃。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-007-xiangyu:m035-0000","start":0,"end":2,"surface":"項王","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m035-0003","start":3,"end":6,"surface":"淮陰侯","kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m035-0023","start":23,"end":25,"surface":"龍且","kind":"person","person_id":"sr6_5zr_1f3","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m035-0029","start":29,"end":32,"surface":"淮陰侯","kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m035-0037","start":37,"end":39,"surface":"灌嬰","kind":"person","person_id":"sj9_pfu_fwh","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m035-0048","start":48,"end":50,"surface":"龍且","kind":"person","person_id":"sr6_5zr_1f3","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m035-0051","start":51,"end":53,"surface":"韓信","kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m035-0060","start":60,"end":62,"surface":"項王","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m035-0063","start":63,"end":65,"surface":"龍且","kind":"person","person_id":"sr6_5zr_1f3","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m035-0075","start":75,"end":77,"surface":"武涉","kind":"person","person_id":"3la_fcr_q0l","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m035-0079","start":79,"end":82,"surface":"淮陰侯","kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m035-0083","start":83,"end":86,"surface":"淮陰侯","kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m035-0092","start":92,"end":94,"surface":"彭越","kind":"person","person_id":"9qt_orl_5f2","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m035-0105","start":105,"end":107,"surface":"項王","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m035-0109","start":109,"end":117,"surface":"海春侯大司馬曹咎","kind":"person","person_id":"1re_sks_vyx","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m035-0150","start":150,"end":152,"surface":"彭越","kind":"person","person_id":"9qt_orl_5f2","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m035-0159","start":159,"end":161,"surface":"將軍","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、匿名者、群體、動物或未定指代保留待核；不補姓名、闕代或個別成員。"}],"chapter_id":"c-shiji-007-xiangyu","book_id":"b-shiji-007","work_id":"w-shiji","source_id":"s-shiji-007-xiangyu"},{"id":"c-shiji-007-xiangyu:p037","text":"漢果數挑楚軍戰，楚軍不出。使人辱之，五六日，大司馬怒，渡兵汜水。士卒半渡，漢擊之，大破楚軍，盡得楚國貨賂。大司馬咎、長史翳、塞王欣皆自剄汜水上。大司馬咎者，故蘄獄掾，長史欣亦故櫟陽獄吏，兩人嘗有德於項梁，是以項王信任之。當是時，項王在睢陽，聞海春侯軍敗，則引兵還。漢軍方圍鐘離眛於滎陽東，項王至，漢軍畏楚，盡走險阻。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-007-xiangyu:m037-0022","start":22,"end":25,"surface":"大司馬","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、匿名者、群體、動物或未定指代保留待核；不補姓名、闕代或個別成員。"},{"id":"c-shiji-007-xiangyu:m037-0053","start":53,"end":57,"surface":"大司馬咎","kind":"person","person_id":"1re_sks_vyx","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m037-0058","start":58,"end":61,"surface":"長史翳","kind":"person","person_id":"3j2_4x7_nzr","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m037-0062","start":62,"end":65,"surface":"塞王欣","kind":"person","person_id":"o8z_o5j_2e8","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m037-0072","start":72,"end":76,"surface":"大司馬咎","kind":"person","person_id":"1re_sks_vyx","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m037-0083","start":83,"end":86,"surface":"長史欣","kind":"person","person_id":"o8z_o5j_2e8","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m037-0099","start":99,"end":101,"surface":"項梁","kind":"person","person_id":"5xt_rg8_7zs_A","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m037-0104","start":104,"end":106,"surface":"項王","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m037-0114","start":114,"end":116,"surface":"項王","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m037-0121","start":121,"end":124,"surface":"海春侯","kind":"person","person_id":"1re_sks_vyx","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m037-0136","start":136,"end":139,"surface":"鐘離眛","kind":"person","person_id":"tb2_zhz_mol","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m037-0144","start":144,"end":146,"surface":"項王","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"}],"chapter_id":"c-shiji-007-xiangyu","book_id":"b-shiji-007","work_id":"w-shiji","source_id":"s-shiji-007-xiangyu"},{"id":"c-shiji-008-gaozu:p045","text":"四年，項羽乃謂海春侯大司馬曹咎曰：「謹守成皋。若漢挑戰，慎勿與戰，無令得東而已。我十五日必定梁地，復從將軍。」乃行擊陳留、外黃、睢陽，下之。漢果數挑楚軍，楚軍不出，使人辱之五六日，大司馬怒，度兵汜水。士卒半渡，漢擊之，大破楚軍，盡得楚國金玉貨賂。大司馬咎、長史欣皆自剄汜水上。項羽至睢陽，聞海春侯破，乃引兵還。漢軍方圍鐘離眛於滎陽東，項羽至，盡走險阻。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m045-0003","start":3,"end":5,"surface":"項羽","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m045-0007","start":7,"end":10,"surface":"海春侯","kind":"person","person_id":"1re_sks_vyx","status":"contextual_provisional"},{"id":"c-shiji