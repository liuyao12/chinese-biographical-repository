,{"id":"c-shiji-008-gaozu:m045-0145","start":145,"end":148,"surface":"海春侯","kind":"person","person_id":"1re_sks_vyx","status":"contextual_provisional","paragraph_id":"c-shiji-008-gaozu:p045","chapter_id":"c-shiji-008-gaozu"}],"relations":[],"title_holdings":[{"id":"th-shiji007-042","person_id":"1re_sks_vyx","title":"海春侯","kind":"noble_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-007-xiangyu","source_id":"s-shiji-007-xiangyu","paragraph_id":"c-shiji-007-xiangyu:p035","quote":"海春侯大司馬曹咎"}],"attestations":[{"id":"th-shiji007-042:a001","paragraph_id":"c-shiji-007-xiangyu:p035","start":109,"end":112,"surface":"海春侯","person_mention_id":"c-shiji-007-xiangyu:m035-0109","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"保存授號／用稱與有效時段證據；敘事位置不是確定曆日，未知端點不當無限延伸，亦不以卒日補終止。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji007-043","person_id":"1re_sks_vyx","title":"大司馬","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-007-xiangyu","source_id":"s-shiji-007-xiangyu","paragraph_id":"c-shiji-007-xiangyu:p035","quote":"海春侯大司馬曹咎"}],"attestations":[{"id":"th-shiji007-043:a001","paragraph_id":"c-shiji-007-xiangyu:p035","start":112,"end":115,"surface":"大司馬","person_mention_id":"c-shiji-007-xiangyu:m035-0109","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"保存授號／用稱與有效時段證據；敘事位置不是確定曆日，未知端點不當無限延伸，亦不以卒日補終止。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji007-041","person_id":"1re_sks_vyx","surfaces":["大司馬咎","曹咎","海春侯","海春侯大司馬曹咎"],"scope":"same_chapter","chapter_ids":["c-shiji-007-xiangyu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-007-xiangyu:p002","quote":"項籍少時，學書不成，去，學劍，又不成。項梁怒之。籍曰：「書足以記名姓而已。劍一人敵，不足學，學萬人敵！」於是項梁乃教籍兵法，籍大喜，略知其意，又不肯竟學。項梁嘗有櫟陽逮，乃請蘄獄掾曹咎書抵櫟陽獄掾司馬欣，以故事得已。項梁殺人，與籍避仇於吳中。吳中賢士大夫皆出項梁下。每吳中有大繇役及喪，項梁常為主辦，陰以兵法部勒賓客及子弟，以是知其能。秦始皇帝游會稽，渡浙江，梁與籍俱觀。籍曰：「彼可取而代也。」梁掩其口，曰：「毋妄言，族矣！」梁以此奇籍。籍長八尺餘，力能扛鼎，才氣過人，雖吳中子弟皆已憚籍矣。"},{"paragraph_id":"c-shiji-007-xiangyu:p035","quote":"項王聞淮陰侯已舉河北，破齊、趙，且欲擊楚，乃使龍且往擊之。淮陰侯與戰，騎將灌嬰擊之，大破楚軍，殺龍且。韓信因自立為齊王。項王聞龍且軍破，則恐，使盱台人武涉往說淮陰侯。淮陰侯弗聽。是時，彭越復反，下梁地，絕楚糧。項王乃謂海春侯大司馬曹咎等曰：「謹守成皋，則漢欲挑戰，慎勿與戰，毋令得東而已。我十五日必誅彭越，定梁地，復從將軍。」乃東，行擊陳留、外黃。"},{"paragraph_id":"c-shiji-007-xiangyu:p037","quote":"漢果數挑楚軍戰，楚軍不出。使人辱之，五六日，大司馬怒，渡兵汜水。士卒半渡，漢擊之，大破楚軍，盡得楚國貨賂。大司馬咎、長史翳、塞王欣皆自剄汜水上。大司馬咎者，故蘄獄掾，長史欣亦故櫟陽獄吏，兩人嘗有德於項梁，是以項王信任之。當是時，項王在睢陽，聞海春侯軍敗，則引兵還。漢軍方圍鐘離眛於滎陽東，項王至，漢軍畏楚，盡走險阻。"}],"rationale":"故蘄獄掾的回述支持曹咎與大司馬咎同指；海春侯大司馬曹咎明示稱號，不據追稱推定授予日期。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji008-066","person_id":"1re_sks_vyx","surfaces":["大司馬","大司馬咎","曹咎","海春侯"],"scope":"cross_chapter","chapter_ids":["c-shiji-007-xiangyu","c-shiji-008-gaozu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-007-xiangyu:p002","quote":"項籍少時，學書不成，去，學劍，又不成。項梁怒之。籍曰：「書足以記名姓而已。劍一人敵，不足學，學萬人敵！」於是項梁乃教籍兵法，籍大喜，略知其意，又不肯竟學。項梁嘗有櫟陽逮，乃請蘄獄掾曹咎書抵櫟陽獄掾司馬欣，以故事得已。項梁殺人，與籍避仇於吳中。吳中賢士大夫皆出項梁下。每吳中有大繇役及喪，項梁常為主辦，陰以兵法部勒賓客及子弟，以是知其能。秦始皇帝游會稽，渡浙江，梁與籍俱觀。籍曰：「彼可取而代也。」梁掩其口，曰：「毋妄言，族矣！」梁以此奇籍。籍長八尺餘，力能扛鼎，才氣過人，雖吳中子弟皆已憚籍矣。"},{"paragraph_id":"c-shiji-008-gaozu:p045","quote":"四年，項羽乃謂海春侯大司馬曹咎曰：「謹守成皋。若漢挑戰，慎勿與戰，無令得東而已。我十五日必定梁地，復從將軍。」乃行擊陳留、外黃、睢陽，下之。漢果數挑楚軍，楚軍不出，使人辱之五六日，大司馬怒，度兵汜水。士卒半渡，漢擊之，大破楚軍，盡得楚國金玉貨賂。大司馬咎、長史欣皆自剄汜水上。項羽至睢陽，聞海春侯破，乃引兵還。漢軍方圍鐘離眛於滎陽東，項羽至，盡走險阻。"}],"rationale":"僅在所列漢初戰事、分封與家族敘事內暫定同指；前卷對讀須依相接事件，不據同名全域合併，仍待異源覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-007-xiangyu:p002","text":"項籍少時，學書不成，去，學劍，又不成。項梁怒之。籍曰：「書足以記名姓而已。劍一人敵，不足學，學萬人敵！」於是項梁乃教籍兵法，籍大喜，略知其意，又不肯竟學。項梁嘗有櫟陽逮，乃請蘄獄掾曹咎書抵櫟陽獄掾司馬欣，以故事得已。項梁殺人，與籍避仇於吳中。吳中賢士大夫皆出項梁下。每吳中有大繇役及喪，項梁常為主辦，陰以兵法部勒賓客及子弟，以是知其能。秦始皇帝游會稽，渡浙江，梁與籍俱觀。籍曰：「彼可取而代也。」梁掩其口，曰：「毋妄言，族矣！」梁以此奇籍。籍長八尺餘，力能扛鼎，才氣過人，雖吳中子弟皆已憚籍矣。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-007-xiangyu:m002-0000","start":0,"end":2,"surface":"項籍","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m002-0019","start":19,"end":21,"surface":"項梁","kind":"person","person_id":"5xt_rg8_7zs_A","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m002-0024","start":24,"end":25,"surface":"籍","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m002-0054","start":54,"end":56,"surface":"項梁","kind":"person","person_id":"5xt_rg8_7zs_A","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m002-0058","start":58,"end":59,"surface":"籍","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m002-0062","start":62,"end":63,"surface":"籍","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m002-0077","start":77,"end":79,"surface":"項梁","kind":"person","person_id":"5xt_rg8_7zs_A","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m002-0090","start":90,"end":92,"surface":"曹咎","kind":"person","person_id":"1re_sks_vyx","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m002-0098","start":98,"end":101,"surface":"司馬欣","kind":"person","person_id":"o8z_o5j_2e8","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m002-0108","start":108,"end":110,"surface":"項梁","kind":"person","person_id":"5xt_rg8_7zs_A","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m002-0114","start":114,"end":115,"surface":"籍","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m002-0123","start":123,"end":127,"surface":"賢士大夫","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱或短稱尚待逐處覆核；不補姓名或推造個別成員。"},{"id":"c-shiji-007-xiangyu:m002-0129