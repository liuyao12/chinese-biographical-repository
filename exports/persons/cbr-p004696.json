{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004696","identity_policy":"contextual_provisional","person_ids":["cbr-p004696"],"persons":[{"id":"cbr-p004696","label":"燕丹引古（魯仲連鄒陽列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"燕丹","mention_ids":["c-shiji-083-luzou:m016-0028"]},{"surface":"太子","mention_ids":["c-shiji-083-luzou:m016-0038"]},{"surface":"丹","mention_ids":["c-shiji-083-luzou:m018-0041"]}],"evidence":[{"mention_id":"c-shiji-083-luzou:m016-0028","chapter_id":"c-shiji-083-luzou","paragraph_id":"c-shiji-083-luzou:p016","quote":"燕丹"},{"mention_id":"c-shiji-083-luzou:m016-0038","chapter_id":"c-shiji-083-luzou","paragraph_id":"c-shiji-083-luzou:p016","quote":"太子"},{"mention_id":"c-shiji-083-luzou:m018-0041","chapter_id":"c-shiji-083-luzou","paragraph_id":"c-shiji-083-luzou:p018","quote":"丹"}]}],"source_mention_summary":[{"source_id":"s-shiji-083-luzou","work_id":"w-shiji","book_id":"b-shiji-083","chapter_id":"c-shiji-083-luzou","mention_count":3,"mention_ids":["c-shiji-083-luzou:m016-0028","c-shiji-083-luzou:m016-0038","c-shiji-083-luzou:m018-0041"],"paragraph_ids":["c-shiji-083-luzou:p016","c-shiji-083-luzou:p018"],"passage_count":2}],"most_mentioned_source_ids":["s-shiji-083-luzou"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-083-luzou:m016-0028","start":28,"end":30,"surface":"燕丹","kind":"person","person_id":"cbr-p004696","status":"contextual_provisional","paragraph_id":"c-shiji-083-luzou:p016","chapter_id":"c-shiji-083-luzou"},{"id":"c-shiji-083-luzou:m016-0038","start":38,"end":40,"surface":"太子","kind":"person","person_id":"cbr-p004696","status":"contextual_provisional","paragraph_id":"c-shiji-083-luzou:p016","chapter_id":"c-shiji-083-luzou"},{"id":"c-shiji-083-luzou:m018-0041","start":41,"end":42,"surface":"丹","kind":"person","person_id":"cbr-p004696","status":"contextual_provisional","paragraph_id":"c-shiji-083-luzou:p018","chapter_id":"c-shiji-083-luzou"}],"relations":[],"title_holdings":[{"id":"th-shiji083-006","person_id":"cbr-p004696","title":"太子","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-083-luzou","source_id":"s-shiji-083-luzou","paragraph_id":"c-shiji-083-luzou:p016","quote":"臣聞忠無不報，信不見疑，臣常以為然，徒虛語耳。昔者荊軻慕燕丹之義，白虹貫日，太子畏之；衛先生為秦畫長平之事，太白蝕昴，而昭王疑之。夫精變天地而信不喻兩主，豈不哀哉！今臣盡忠竭誠，畢議願知，左右不明，卒從吏訊，為世所疑，是使荊軻、衛先生復起，而燕、秦不悟也。願大王孰察之。"}],"attestations":[{"id":"th-shiji083-006:a001","paragraph_id":"c-shiji-083-luzou:p016","start":38,"end":40,"surface":"太子","person_mention_id":"c-shiji-083-luzou:m016-0038","usage":"retrospective"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"引古用稱、任職事件與未知起訖分存；三去相概述不補造三段任期，拒封及欲爵未實現不作授爵，未知日期與終點保持未定。 此記錄出於引古言論，不視為敘事當時任職。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji083-041","person_id":"cbr-p004696","scope":"same_chapter","chapter_ids":["c-shiji-083-luzou"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"按獄中上書引古與梁廷敘事分層，保留原稱。枚生及衛先生未以記憶補姓名；王奢不改作趙奢。燕丹與丹限荊軻句群，臣與大王限鄒陽對梁孝王的上書。","surfaces":["丹","太子","燕丹"],"evidence":[{"paragraph_id":"c-shiji-083-luzou:p016","quote":"臣聞忠無不報，信不見疑，臣常以為然，徒虛語耳。昔者荊軻慕燕丹之義，白虹貫日，太子畏之；衛先生為秦畫長平之事，太白蝕昴，而昭王疑之。夫精變天地而信不喻兩主，豈不哀哉！今臣盡忠竭誠，畢議願知，左右不明，卒從吏訊，為世所疑，是使荊軻、衛先生復起，而燕、秦不悟也。願大王孰察之。"},{"paragraph_id":"c-shiji-083-luzou:p018","quote":"諺曰：「有白頭如新，傾蓋如故。」何則？知與不知也。故昔樊於期逃秦之燕，藉荊軻首以奉丹之事；王奢去齊之魏，臨城自剄以卻齊而存魏。夫王奢、樊於期非新於齊、秦而故於燕、魏也，所以去二國死兩君者，行合於志而慕義無窮也。是以蘇秦不信於天下，而為燕尾生；白圭戰亡六城，為魏取中山。何則？誠有以相知也。蘇秦相燕，燕人惡之於王，王按劍而怒，食以駃騠；白圭顯於中山，中山人惡之魏文侯，文侯投之以夜光之璧。何則？兩主二臣，剖心坼肝相信，豈移於浮辭哉！"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-083-luzou:p016","text":"臣聞忠無不報，信不見疑，臣常以為然，徒虛語耳。昔者荊軻慕