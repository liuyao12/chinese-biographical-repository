dence":[{"chapter_id":"c-shiji-130-taishigong","source_id":"s-shiji130-taishigong","paragraph_id":"c-shiji-130-taishigong:p052","quote":"重黎業之，吳回接之；殷之季世，粥子牒之。周用熊繹，熊渠是續。莊王之賢，乃復國陳；既赦鄭伯，班師華元。懷王客死，蘭咎屈原；好諛信讒，楚并於秦。嘉莊王之義，作楚世家第十。","mention_ids":["c-shiji-130-taishigong:m052-0000"]},{"chapter_id":"c-shiji-040-chu","source_id":"s-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p001","quote":"楚之先祖出自帝顓頊髙陽。髙陽者，黃帝之孫，昌意之子也。髙陽生稱，稱生巻章，巻章生重黎。重黎爲帝嚳髙辛居火正，甚有功，能光融天下，帝嚳命曰祝融。共工氏作亂，帝嚳使重黎誅之而不盡。帝乃以庚寅日誅重黎，而以其弟呉回爲重黎後，復居火正，爲祝融。","mention_ids":["c-shiji-040-chu:m001-0040","c-shiji-040-chu:m001-0080"]}],"rationale":"卷130提要言重黎承業、吳回接續；卷40載吳回為重黎之弟並承其後。此處的重黎是傳承中的單一祖名，不拆成兩個官職人物，也不與南正重、北正黎補作同一身份。","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-040-chu:p001","text":"楚之先祖出自帝顓頊髙陽。髙陽者，黃帝之孫，昌意之子也。髙陽生稱，稱生巻章，巻章生重黎。重黎爲帝嚳髙辛居火正，甚有功，能光融天下，帝嚳命曰祝融。共工氏作亂，帝嚳使重黎誅之而不盡。帝乃以庚寅日誅重黎，而以其弟呉回爲重黎後，復居火正，爲祝融。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m001-0006","start":6,"end":11,"surface":"帝顓頊髙陽","kind":"person","person_id":"2to_ofg_fuz","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m001-0012","start":12,"end":14,"surface":"髙陽","kind":"person","person_id":"2to_ofg_fuz","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m001-0016","start":16,"end":18,"surface":"黃帝","kind":"person","person_id":"8jz_o3s_obt","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m001-0021","start":21,"end":23,"surface":"昌意","kind":"person","person_id":"dsc_tie_q5s","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m001-0027","start":27,"end":29,"surface":"髙陽","kind":"person","person_id":"2to_ofg_fuz","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m001-0030","start":30,"end":31,"surface":"稱","kind":"person","person_id":"2b9_5sw_foy","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m001-0032","start":32,"end":33,"surface":"稱","kind":"person","person_id":"2b9_5sw_foy","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m001-0034","start":34,"end":36,"surface":"巻章","kind":"person","person_id":"nuq_wqa_cu6","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m001-0037","start":37,"end":39,"surface":"巻章","kind":"person","person_id":"nuq_wqa_cu6","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m001-0040","start":40,"end":42,"surface":"重黎","kind":"person","person_id":"off_msa_t3x","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m001-0043","start":43,"end":45,"surface":"重黎","kind":"person","person_id":"off_msa_t3x","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m001-0046","start":46,"end":50,"surface":"帝嚳髙辛","kind":"person","person_id":"9qr_quf_02m","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m001-0064","start":64,"end":66,"surface":"帝嚳","kind":"person","person_id":"9qr_quf_02m","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m001-0071","start":71,"end":74,"surface":"共工氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"本處為氏族／群體稱呼，與祖系中的具名個人分開，未補全體成員。"},{"id":"c-shiji-040-chu:m001-0077","start":77,"end":79,"surface":"帝嚳","kind":"person","person_id":"9qr_quf_02m","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m001-0080","start":80,"end":82,"surface":"重黎","kind":"person","person_id":"off_msa_t3x","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m001-0088","start":88,"end":89,"surface":"帝","kind":"person","person_id":"9qr_quf_02m","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m001-0095","start":95,"end":97,"surface":"重黎","kind":"person","person_id":"off_msa_t3x","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m001-0102","start":102,"end":104,"surface":"呉回","kind":"person","person_id":"uk3_s1y_7c7","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m001-0105","start":105,"end":107,"surface":"重黎","kind":"person","person_id":"off_msa_t3x","status":"contextual_provisional"}],"chapter_id":"c-shiji-040-chu","book_id":"b-shiji-040","work_id":"w-shiji","source_id":"s-shiji-040-chu"},{"id":"c-shiji-117-xiangru:p052","text":"邪絕少陽而登太陰兮，與真人乎相求。互折窈窕以右轉兮，橫厲飛泉以正東。悉徵靈圉而選之兮，部乘眾神於瑤光。使五帝先導兮，反太一而從陵陽。左玄冥而右含靁兮，前陸離而後潏湟。厮征北僑而役羡門兮，屬岐伯使尚方。祝融驚而蹕御兮，清氛氣而後行。屯余車其萬乘兮，綷雲蓋而樹華旗。使勾芒其將行兮，吾欲往乎南嬉。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m052-0011","start":11,"end":13,"surface":"真人","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"「真人」在「與真人乎相求」中為泛稱仙真，未指名特定人物，不另建個人ID。"},{"id":"c-shiji-117-xiangru:m052-0036","start":36,"end":38,"surface":"靈圉","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"「靈圉」在本篇另見p016、p058；句中列於靈類及眾神之間，未見足以判為一名可辨個體的證據，故不建立個人ID。"},{"id":"c-shiji-117-xiangru:m052-0045","start":45,"end":47,"surface":"眾神","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"「眾神」為集合稱呼，沒有逐一命名，不拆造個人。"},{"id":"c-shiji-117-xiangru:m052-0052","start":52,"end":54,"surface":"五帝","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"本句神帝群稱，不指定五個世系人物；五畤與古注轉報五時分存。"},{"id":"c-shiji-117-xiangru:m052-0059","start":59,"end":61,"surface":"太一","kind":"person","person_id":"d88_6lt_6ex","status":"contextual_provisional","interpretation_note":"如淳注指天極大星中太一常居，古注又釋為太一返回其所居、陵陽侍從；依此記作神話／星神人物。卷12「（大夫）［太一］」屬未定校讀，不據此接合。"},{"id":"c-shiji-117-xiangru:m052-0063","start":63,"end":65,"surface":"陵陽","kind":"person","person_id":"i4v_y28_wx0","status":"contextual_provisional","interpretation_note":"古注明稱仙人陵陽子明，與陽子古注所述陽陵子不能倒字合併。"},{"id":"c-shiji-117-xiangru:m052-0067","start":67,"end":69,"surface":"玄冥","kind":"person","person_id":"dal_xne_xt3","status":"contextual_provisional","interpretation_note":"古注稱北方黑帝之佐，只記神話身份，不補官爵任期或與其他祖系相接。"},{"id":"c-shiji-117-xiangru:m052-0071","start":71,"end":73,"surface":"含靁","kind":"person","person_id":"21k_m7f_sxc","status":"contextual_provisional","interpretation_note":"本篇含靁依所引注為黔嬴，造化神與水神兩說分存；不改原字，不將外部用字冒作本文別名。"},{"id":"c-shiji-117-xiangru:m052-0076","start":76,"end":78,"surface":"陸離","kind":"person","person_id":"oha_39m_mfa","status":"contextual_provisional","interpretation_note":"《史記集解》引《漢書音義》明釋本篇「陸離」為神名，故建立本篇所指的傳說神格ID。平行《漢書》作「長離」，顏師古另釋為靈鳥；不改本篇字形、不將長離接作別名，保留讀法差異。"},{"id":"c-shiji-117-xiangru:m052-0080","start":80,"end":82,"surface":"潏湟","kind":"person","person_id":"oj8_zfy_dkl","status":"contextual_provisional","interpretation_note":"本篇潏湟依注為神名；漢書矞皇用字另存，不先作跨見證別名定論。"},{"id":"c-shiji-117-xiangru:m052-0085","start":85,"end":87,"surface":"北僑","kind":"person","person_id":"36f_f1a_2zd","status":"contextual_provisional","interpretation_note":"本篇《史記》作「北僑」；依《集解》引徐廣為燕人、形解而仙者。平行《漢書》同句作「伯僑」，顏師古讀作姓征名伯僑，暫接為同一傳說人物；張揖說王子僑，顏師古明言非王子僑，故不與王子僑合併。"},{"id":"c-shiji-117-xiangru:m052-0089","start":89,"end":91,"surface":"羡門","kind":"person","person_id":"44s_fyq_t0d","status":"contextual_provisional","interpretation_note":"張揖釋碣石仙人羡門高，與始皇本紀碣石求羨門的名號及地域互證；保留羡／羨原字，不把高誓併成同名，也不補仙人生卒或任期。"},{"id":"c-shiji-117-xiangru:m052-0094","start":94,"end":96,"surface":"岐伯","kind":"person","person_id":"l4l_iz8_ao0","status":"contextual_provisional","interpretation_note":"本篇岐伯主方藥，張揖明釋黃帝太醫；孝武本紀公玉帶亦引黃帝時岐伯，暫接同一傳說人物，不據賦辭增造官職或出行事件。"},{"id":"c-shiji-117-xiangru:m052-0100","start":100,"end":102,"surface":"祝融","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"本句只稱祝融驚而蹕御；《史記》卷40記重黎與其弟呉回先後受祝融之名，卷42另以祝融稱高辛氏火正祖系，卷40篇末又見祝融祀典。所指可為不同傳說人物、神格或職名，未能定一，詳見本段異說記錄。"},{"id":"c-shiji-117-xiangru:m052-0132","start":132,"end":134,"surface":"勾芒","kind":"person","person_id":"hd8_aho_qei","status":"contextual_provisional","interpretation_note":"本篇勾芒與漢書句芒各存，古注稱東方青帝之佐；不按造形補生平或親屬。"}],"chapter_id":"c-shiji-117-xiangru","book_id":"b-shiji-117","work_id":"w-shiji","source_id":"s-shiji117-xiangru"},{"id":"c-shiji-130-taishigong:p052","text":"重黎業之，吳回接之；殷之季世，粥子牒之。周用熊繹，熊渠是續。莊王之賢，乃復國陳；既赦鄭伯，班師華元。懷王客死，蘭咎屈原；好諛信讒，楚并於秦。嘉莊王之義，作楚世家第十。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m052-0000","start":0,"end":2,"s