ngshao-qingfu","subject_person_id":"nbb_y6s_bfz_AA","object_person_id":"9ye_u8v_u9b","predicate":"brother","qualifiers":{"source_term":"僧紹弟慶符"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-054","chapter_id":"c-nanqishu-054-recluses-complete","source_id":"s-nanqishu-054-recluses-complete-ws1762878","paragraph_id":"c-nanqishu-054-recluses-complete:p006","quote":"　　昇明中，太祖爲太傅，教辟僧紹及顧歡、臧榮緒以旍幣之禮，徵爲記室參軍，不至。僧紹弟慶符，爲青州，僧紹乏糧食，隨慶符之鬱洲，住弇榆山，栖雲精舍，欣玩水石，竟不一入州城。建元元年冬，詔曰：「朕側席思士，載懷塵外。齊郡明僧紹標志高栖，耽情墳素，幽貞之操，宜加賁飾。」徵爲正員郎，稱疾不就。其後與崔思祖書曰：「明居士標意可重，吾前旨竟未達邪？小敘欲有講事，卿可至彼，具述吾意，令與慶符俱歸。」又曰：「不食周粟而食周薇，古猶發議。在今寧得息談邪？聊以爲笑。」","subject_person_mention_id":"c-nanqishu-054-recluses-complete:p006:m0014","object_person_mention_id":"c-nanqishu-054-recluses-complete:p006:m0042"}],"status":"source_attested","interpretation_note":"弟為青州，僧紹依其居鬱洲。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"title_holdings":[{"id":"th-nanqishu-027-wangshi-concordance-7-4","title":"寧朔將軍","kind":"office","mode":"attestation","person_id":"9ye_u8v_u9b","attestations":[{"id":"th-nanqishu-027-wangshi-concordance-7-4:a","paragraph_id":"c-nanqishu-027-wangshi-concordance:p007","start":4,"end":8,"surface":"寧朔將軍","person_mention_id":"c-nanqishu-027-wangshi-concordance:p007:m0008","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-027","chapter_id":"c-nanqishu-027-wangshi-concordance","source_id":"s-nanqishu-027-wangshi-concordance-ws1508012","paragraph_id":"c-nanqishu-027-wangshi-concordance:p007","quote":"懷珍又遣寧朔將軍明慶符與廣之擊降延僧，遣高麗使詣京師。","person_mention_id":"c-nanqishu-027-wangshi-concordance:p007:m0008"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_const