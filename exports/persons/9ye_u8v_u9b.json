ded_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-nanqishu-054-recluses-complete:source_review9-0","kind":"source_review","person_id":"9ye_u8v_u9b","source_quote":"　　慶符，建元初，爲黃門。","reading":"建元初任黃門為慶符本段任履。前文青州及供兄食是同人。","note":"建元初任黃門為慶符本段任履。前文青州及供兄食是同人。","paragraph_id":"c-nanqishu-054-recluses-complete:p009","start_codepoint":0,"end_codepoint":13,"human_reviewed":false,"chapter_id":"c-nanqishu-054-recluses-complete","source_id":"s-nanqishu-054-recluses-complete-ws1762878"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-qi054-mingshao-qingfu","subject_person_id":"nbb_y6s_bfz_AA","object_person_id":"9ye_u8v_u9b","predicate":"brother","qualifiers":{"source_term":"僧紹弟慶符"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-054","chapter_id":"c-nanqishu-054-recluses-complete","source_id":"s-nanqishu-054-recluses-complete-ws1762878","paragraph_id":"c-nanqishu-054-recluses-complete:p006","quote":"　　昇明中，太祖爲太傅，教辟僧紹及顧歡、臧榮緒以旍幣之禮，徵爲記室參軍，不至。僧紹弟慶符，爲青州，僧紹乏糧食，隨慶符之鬱洲，住弇榆山，栖雲精舍，欣玩水石，竟不一入州城。建元元年冬，詔曰：「朕側席思士，載懷塵外。齊郡明僧紹標志高栖，耽情墳素，幽貞之操，宜加賁飾。」徵爲正員郎，稱疾不就。其後與崔思祖書曰：「明居士標意可重，吾前旨竟未達邪？小敘欲有講事，卿可至彼，具述吾意，令與慶符俱歸。」又曰：「不食周粟而食周薇，古猶發議。在今寧得息談邪？聊以爲笑。」","subject_person_mention_id":"c-nanqishu-054-recluses-complete:p006:m0014","object_person_mention_id":"c-nanqishu-054-recluses-complete:p006:m0042"}],"status":"source_attested","interpretation_note":"弟為青州，僧紹依其居鬱洲。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-027-wangshi-concordance:p007:m0008","start":8,"end":11,"surface":"明慶符","kind":"person","person_id":"9ye_u8v_u9b","status":"contextual_provisional","paragraph_id":"c-nanqishu-027-wangshi-concor