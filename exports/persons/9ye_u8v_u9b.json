4-recluses-complete:p007:m0091","start":91,"end":93,"surface":"僧紹","kind":"person","person_id":"nbb_y6s_bfz_AA","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p007:m0109","start":109,"end":111,"surface":"僧紹","kind":"person","person_id":"nbb_y6s_bfz_AA","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p007:m0147","start":147,"end":149,"surface":"世祖","kind":"person","person_id":"kix_r92_2ed","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p007:m0151","start":151,"end":153,"surface":"僧紹","kind":"person","person_id":"nbb_y6s_bfz_AA","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p007:m0173","start":173,"end":175,"surface":"元琳","kind":"person","person_id":"nbb_y6s_bfz_AAB","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p007:m0177","start":177,"end":179,"surface":"仲璋","kind":"person","person_id":"nbb_y6s_bfz_AAB","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-054-recluses-complete","book_id":"b-nanqishu-054","work_id":"w-nanqishu","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:p009","text":"　　慶符，建元初，爲黃門。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":38,"last_line":38,"raw_start":1567,"raw_end":1580,"raw_character_offsets":[1567,1568,1569,1570,1571,1572,1573,1574,1575,1576,1577,1578,1579],"revision_id":1762878},"mentions":[{"id":"c-nanqishu-054-recluses-complete:p009:m0002","start":2,"end":4,"surface":"慶符","kind":"person","person_id":"9ye_u8v_u9b","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-054-recluses-complete","book_id":"b-nanqishu-054","work_id":"w-nanqishu","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-058-southern-and-eastern-complete:p033","text":"六年，以始興太守房法乘代楷。法乘至鎮，屬疾不理事，專好讀書。長史伏登之因此擅權，改易將吏，不令法乘知。錄事房季文白之，法乘大怒，繫登之於獄。十餘日，登之厚賂法乘妹夫崔景叔得出，將部曲襲州執法乘，謂之曰：「使君既有疾，不宜勞。」囚之別室。法乘無事，復就登之求書讀，登之曰：「使君靜處猶恐動疾，豈可看書。」遂不與。乃啟法乘心疾動，不任視事，世祖仍以登之為交州刺史。法乘還至嶺而卒。法乘，清河人。昇明中，為太祖驃騎中兵，至左中郎將。性方簡，身長八尺三寸，行出人上，常自俯屈。青州刺史明慶符亦長與法乘等，朝廷唯此二人。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":84,"last_line":84,"raw_start":7441,"raw_end":7696,"raw_character_offsets":[7441,7442,7443,7444,7445,7446,7447,7448,7449,7450,7451,7452,7453,7454,7455,7456,7457,7458,7459,7460,7461,7462,7463,7464,7465,7466,7467,7468,7469,7470,7471,7472,7473,7474,7475,7476,7477,7478,7479,7480,7481,7482,7483,7484,7485,7486,7487,7488,7489,7490,7491,7492,7493,7494,7495,7496,7497,7498,7499,7500,7501,7502,7503,7504,7505,7506,7507,7508,7509,7510,7511,7512,7513,7514,7515,7516,7517,7518,7519,7520,7521,7522,7523,7524,7525,7526,7527,7528,7529,7530,7531,7532,7533,7534,7535,7536,7537,7538,7539,7540,7541,7542,7543,7544,7545,7546,7547,7548,7549,7550,7551,7552,7553,7554,7555,7556,7557,7558,7559,7560,7561,7562,7563,7564,7565,7566,7567,7568,7569,7570,7571,7572,7573,7574,7575,7576,7577,7578,7579,7580,7581,7582,7583,7584,7585,7586,7587,7588,7589,7590,7591,7592,7593,7594,7595,7596,7597,7598,7599,7600,7601,7602,7603,7604,7605,7606,7607,7608,7609,7610,7611,7612,7613,7614,7615,7616,7617,7618,7619,7620,7621,7622,7623,7624,7625,7626,7627,7628,7629,7630,7631,7632,7633,7634,7635,7636,7637,7638,7639,7640,7641,7642,7643,7644,7645,7646,7647,7648,7649,7650,7651,7652,7653,7654,7655,7656,7657,7658,7659,7660,7661,7662,7663,7664,7665,7666,7667,7668,7669,7670,7671,7672,7673,7674,7675,7676,7677,7678,7679,7680,7681,7682,7683,7684,7685,7686,7687,7688,7689,7690,7691,7692,7693,7694,7695],"revision_id":2638629},"mentions":[{"id":"c-nanqishu-058-southern-and-eastern-complete:p033:m0008","start":8,"end":11,"surface":"房法乘","kind":"person","person_id":"ds6_4ib_0ni","status":"contextual_provisional"},{"id":"c-nanqishu-058-southern-and-eastern-complete:p033:m0012","start":12,"end":13,"surface":"楷","kind":"person","person_id":"jnv_f5v_nr2","status":"contextual_provisional"},{"id":"c-nanqishu-058-southern-and-eas