偽告顥有異志。秀不詳察，即收顥及襄陽中正李邁，殺之，厚待晉興，以為己部曲督。前衛尉石崇、黃門郎潘嶽皆與秀有嫌，並見誅。於是京邑君子不樂其生矣。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":65,"last_line":65,"raw_start":6015,"raw_end":6183,"raw_character_offsets":[6017,6018,6019,6020,6021,6022,6023,6024,6025,6026,6027,6028,6029,6030,6031,6032,6033,6034,6035,6036,6037,6038,6039,6040,6041,6042,6043,6044,6045,6046,6047,6048,6049,6050,6051,6052,6053,6054,6055,6056,6057,6058,6059,6060,6061,6062,6063,6064,6065,6066,6067,6068,6069,6070,6071,6072,6073,6074,6075,6076,6077,6078,6079,6080,6081,6082,6083,6084,6085,6086,6087,6088,6089,6090,6091,6092,6093,6094,6095,6096,6097,6098,6099,6100,6101,6102,6103,6104,6105,6106,6107,6108,6109,6110,6111,6112,6113,6114,6115,6116,6117,6118,6119,6120,6121,6122,6123,6124,6125,6126,6127,6128,6129,6130,6131,6132,6133,6134,6135,6136,6137,6138,6139,6140,6141,6142,6143,6144,6145,6146,6147,6148,6149,6150,6151,6152,6153,6154,6155,6156,6157,6158,6159,6160,6161,6162,6163,6164,6165,6166,6167,6168,6169,6170,6171,6172,6173,6174,6175,6176,6177,6178,6179,6180,6181,6182],"revision_id":2650517},"mentions":[{"id":"c-jinshu-059-prince-lun:p004:m0000","surface":"倫","start":0,"end":1,"person_id":"dkn_ge4_286_AAAAG","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-lun:p004:m0013","surface":"秀","start":13,"end":14,"person_id":"8x5_e5i_yle","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-lun:p004:m0015","surface":"秀","start":15,"end":16,"person_id":"8x5_e5i_yle","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-lun:p004:m0028","surface":"秀","start":28,"end":29,"person_id":"8x5_e5i_yle","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-lun:p004:m0033","surface":"倫","start":33,"end":34,"person_id":"dkn_ge4_286_AAAAG","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-lun:p004:m0035","surface":"秀","start":35,"end":36,"person_id":"8x5_e5i_yle","kind":"