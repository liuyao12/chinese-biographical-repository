"40l_mfp_yr6","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p010","chapter_id":"c-shiji-122-kuli"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-122-kuli:p010","text":"周陽由者，其父趙兼以淮南王舅父侯周陽，故因姓周陽氏。由以宗家任爲郎，事孝文及景帝。景帝時，由爲郡守。武帝卽位，吏治尚循謹甚，然由居二千石中，最爲暴酷驕恣。所愛者，撓法活之；所憎者，曲法誅滅之。所居郡，必夷其豪。爲守，視都尉如令。爲都尉，必陵太守，奪之治。與汲黯倶爲忮，司馬安之文惡，倶在二千石列，同車未嘗敢均茵伏。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-122-kuli:m010-0000","start":0,"end":3,"surface":"周陽由","kind":"person","person_id":"xgx_g4a_c28_A","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m010-0007","start":7,"end":9,"surface":"趙兼","kind":"person","person_id":"xgx_g4a_c28","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m010-0010","start":10,"end":13,"surface":"淮南王","kind":"person","person_id":"g0j_yhl_z02","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m010-0022","start":22,"end":25,"surface":"周陽氏","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m010-0026","start":26,"end":27,"surface":"由","kind":"person","person_id":"xgx_g4a_c28_A","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m010-0028","start":28,"end":30,"surface":"宗家","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m010-0035","start":35,"end":37,"surface":"孝文","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m010-0038","start":38,"end":40,"surface":"景帝","kind":"person","person_id":"yqp_nlb_p1p_ACA","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m010-0041","start":41,"end":43,"surface":"景帝","kind":"person","person_id":"yqp_nlb_p1p_ACA","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m010-0045","start":45,"end":46,"surface"