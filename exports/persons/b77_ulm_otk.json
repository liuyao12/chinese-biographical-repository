son","person_id":"h1o_o6t_3ru","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m012-0045","start":45,"end":47,"surface":"戈船","kind":"person","person_id":"4zn_n9v_k0v","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m012-0048","start":48,"end":50,"surface":"下厲","kind":"person","person_id":"iw9_udd_jr2","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m012-0054","start":54,"end":57,"surface":"馳義侯","kind":"person","person_id":"dzl_mvt_l93","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m012-0076","start":76,"end":80,"surface":"伏波將軍","kind":"person","person_id":"vib_10x_51n","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m012-0083","start":83,"end":87,"surface":"樓船將軍","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m012-0097","start":97,"end":99,"surface":"尉佗","kind":"person","person_id":"bvb_d1z_fd0","status":"contextual_provisional"}],"chapter_id":"c-shiji-113-nanyue","book_id":"b-shiji-113","work_id":"w-shiji","source_id":"s-shiji113-nanyue"}],"table_passages":[{"id":"shiji-020-t1-r054-c05","column":5,"rowspan":1,"colspan":1,"text":"一。六年四月癸亥，侯趙光元年。","source_row":55,"source_column":6,"printed_page":null,"person_mentions":[{"id":"shiji-020-t1-r054-c05-m000","start":10,"end":12,"surface":"趙光","person_id":"b77_ulm_otk","status":"contextual_provisional","interpretation_note":"按同列封國、封爵事由及本傳相同事件接合；不以數位年份作另一件事件證據，授爵與戰役、父死分開。","identity_evidence":[{"work_id":"w-shiji","book_id":"b-shiji-113","chapter_id":"c-shiji-113-nanyue","source_id":"s-shiji113-nanyue","source_revision":8735632,"paragraph_id":"c-shiji-113-nanyue:p012","person_id":"b77_ulm_otk","quote":"蒼梧王趙光者，越王同姓，聞漢兵至，及越揭陽令定自定屬漢；越桂林監居翁諭甌駱屬漢：皆得為侯。戈船、下厲將軍兵及馳義侯所發夜郎兵未下，南越已平矣。遂為九郡。伏波將軍益封。樓船將軍兵以陷堅為將梁侯。自尉佗初王後，五世九十三歲而國亡焉。"}]}],"table_id":"shiji-020","table_fragment_id":"shiji-020-digital-table-1","table_row_id":"shiji-020-t1-r054","table_cell_id":"shiji-020-t1-r054-c05","work_id":"w-shiji","book_id":"b-shiji-0