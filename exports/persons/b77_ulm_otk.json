riginal_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"person_id":"b77_ulm_otk","title":"蒼梧王","surname":"趙","ming":"光","additional_names":["蒼梧秦王"],"chapter_id":"c-shiji-113-nanyue","paragraph_id":"c-shiji-113-nanyue:p012","quote":"蒼梧王趙光者，越王同姓，聞漢兵至，及越揭陽令定自定屬漢；越桂林監居翁諭甌駱屬漢：皆得為侯。戈船、下厲將軍兵及馳義侯所發夜郎兵未下，南越已平矣。遂為九郡。伏波將軍益封。樓船將軍兵以陷堅為將梁侯。自尉佗初王後，五世九十三歲而國亡焉。","note":"姓名與蒼梧王據本段，蒼梧秦王據已辨同人的前文；同姓不補父祖。","status":"editorial_provisional","human_reviewed":false,"work_id":"w-shiji","book_id":"b-shiji-113","source_id":"s-shiji113-nanyue"}],"mentions":[{"id":"c-shiji-113-nanyue:m008-0042","start":42,"end":46,"surface":"蒼梧秦王","kind":"person","person_id":"b77_ulm_otk","status":"contextual_provisional","paragraph_id":"c-shiji-113-nanyue:p008","chapter_id":"c-shiji-113-nanyue"},{"id":"c-shiji-113-nanyue:m009-0282","start":282,"end":286,"surface":"蒼梧秦王","kind":"person","person_id":"b77_ulm_otk","status":"contextual_provisional","paragraph_id":"c-shiji-113-nanyue:p009","chapter_id":"c-shiji-113-nanyue"},{"id":"c-shiji-113-nanyue:m012-0003","start":3,"end":5,"surface":"趙光","kind":"person","person_id":"b77_ulm_otk","status":"contextual_provisional","paragraph_id":"c-shiji-113-nanyue:p012","chapter_id":"c-shiji-113-nanyue"}],"relations":[],"title_holdings":[{"id":"th-table-shiji020-r054-founding-grant","person_id":"b77_ulm_otk","title":"隨桃侯","kind":"noble_rank","mode":"grant","status":"source_attested","source_representation":"table_cells","evidence":[{"kind":"table_cell","table_id":"shiji-020","table_cell_id":"shiji-020-t1-r054-c00","quote":"隨桃。","work_id":"w-shiji","book_id":"b-shiji-020","chapter_id":"table-chapter-shiji-020","source_id":"table-witness-shiji-020","source_revision":"2607036","source_role":"fief_name"},{"kind":"table_cell","table_id":"shiji-020","table_cell_id":"shiji-020-t1-r054-c01","quote":"以南越蒼梧王聞漢兵至降侯。","work_id":"w-shiji","book_id":"b-shiji-020","chapter_id":"table-chapter-shiji-020","source