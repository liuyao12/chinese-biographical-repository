ants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-liangshu-003-xiewei-princes:p003:m0017","start":17,"end":18,"surface":"歡","kind":"person","person_id":"yqs_lxt_73d","status":"contextual_provisional","interpretation_note":"昭明太子之子歡受封豫章，原句以下另封譽、察。","paragraph_id":"c-liangshu-003-xiewei-princes:p003","chapter_id":"c-liangshu-003-xiewei-princes"}],"relations":[],"title_holdings":[],"address_assertions":[],"person_references":[{"id":"c-liangshu-033-wangyun-wyd:p005:r0100","person_id":"yqs_lxt_73d","surface":"豫章王","start":100,"end":103,"paragraph_id":"c-liangshu-033-wangyun-wyd:p005","referent_role":"third_person","quote":"普通元年以母憂去職筠有孝性毀瘠過禮服闋後疾廢久之六年除尚書吏部郎遷太子中庶子領羽林監又改領步兵中大通二年遷司徒左長史三年昭明太子薨勅為哀策文復見嗟賞尋出為貞威將軍臨海太守在郡被訟不調累年大同初起為雲麾豫章王長史遷秘書監五年除太府卿明年遷度支尚書中大同元年出為明威將軍永嘉太守以疾固辭徙為光祿大夫俄遷雲騎將軍司徒左長史太清二年侯景寇逼筠時不入城明年太宗卽位為太子詹事筠舊宅先為賊所焚乃寓居國子祭酒蕭子雲宅夜忽有盜攻之驚懼墜井卒時年六十九家人十餘人同遇害","note":"據殿本本段原字、上下文及說話視點。","chapter_id":"c-liangshu-033-wangyun-wyd","book_id":"b-liangshu-033","work_id":"w-liangshu","source_id":"s-liangshu-033-wangyun-wyd1739"},{"id":"c-liangshu-033-wangyun:p005:r0122","person_id":"yqs_lxt_73d","surface":"豫章王","start":122,"end":125,"paragraph_id":"c-liangshu-033-wangyun:p005","referent_role":"third_person","quote":"普通元年，以母憂去職。筠有孝性，毀瘠過禮，服闋後，疾廢久之。六年，除尚書吏部郎，遷太子中庶子，領羽林監，又改領步兵。中大通二年，遷司徒左長史。三年，昭明太子薨，敕爲哀策文，復見嗟賞。尋出爲貞威將軍、臨海太守，在郡被訟，不調累年。大同初，起爲雲麾豫章王長史，遷秘書監。五年，除太府卿。明年，遷度支尚書。中大同元年，出爲明威將軍、永嘉太守，以疾固辭，徙爲光祿大夫，俄遷雲騎將軍、司徒左長史。太清二年，侯景寇逼，筠時不入城。明年，太宗卽位，爲太子詹事。筠舊宅先爲賊所焚，乃寓居國子祭酒蕭子雲宅，夜忽有盜攻之，驚懼墜井卒，時年六十九。家人十餘人同遇害。","note":"據本段話語視點及上文職號。","chapter_id":"c-liangshu-033-wangyun","book_id":"b-liangshu-033","work_id":"w-liangshu","source_id":"s-liangshu-033-wangyun-ws1514481"},{"start":174,"end":177,"surface":"豫章王","id":"c-nanshi-019-xieyu-descendants:p008:r0174","paragraph_id":"c-nanshi-019-xieyu-descendants:p008","person_id":"yqs_lxt_73d","referent_role":"third_person","quote":"子微字玄度，美風采，好學善屬文，位兼中書舍人。與河東裴子野、沛國劉顯同官友善。時魏中山王元略還北，梁武帝餞於武德殿，賦詩三十韻，限三刻成。微二刻便就，文甚美，帝再覽焉。又爲臨汝侯猷制放生文，亦見賞於世。後除尙書左丞。及昭明太子薨，帝立晉安王綱爲皇太子，將出詔，唯召尙書右僕射何敬容、宣惠將軍孔休源及微三人與議。微時年位尙輕，而任遇已重。後卒於北中郎豫章王長史、南蘭陵太守。文集二十卷。","note":"本句按敘述視點回指蕭歡。","chapter_id":"c-nanshi-019-xieyu-descendants","book_id":"b-nanshi-019","work_id":"w-nanshi","source_id":"s-nanshi-019-xieyu-descendants-ws1531762"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-003-xiewei-princes:p003","text":"癸丑，立昭明太子子南徐州刺史華容公歡爲豫章郡王","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-liangshu-003-xiewei-princes:p003:m0017","start":17,"end":18,"surface":"歡","kind":"person","person_id":"yqs_lxt_73d","status":"contextual_provisional","interpretation_note":"昭明太子之子歡受封豫章，原句以下另封譽、察。"}],"source_position":{"first_line":206,"last_line":206,"revision_id":2401780,"editorial_excerpt_boundary":true,"raw_line_start_codepoint":44,"raw_line_end_codepoint":67},"chapter_id":"c-liangshu-003-xiewei-princes","book_id":"b-liangshu-003","work_id":"w-liangshu","source_id":"s-liangshu-003-xiewei-princes-ws2401780"},{"id":"c-liangshu-033-wangyun-wyd:p005","text":"普通元年以母憂去職筠有孝性毀瘠過禮服闋後疾廢久之六年除尚書吏部郎遷太子中庶子領羽林監又改領步兵中大通二年遷司徒左長史三年昭明太子薨勅為哀策文復見嗟賞尋出為貞威將軍臨海太守在郡被訟不調累年大同初起為雲麾豫章王長史遷秘書監五年除太府卿明年遷度支尚書中大同元年出為明威將軍永嘉太守以疾固辭徙為光祿大夫俄遷雲騎將軍司徒左長史太清二年侯景寇逼筠時不入城明年太宗卽位為太子詹事筠舊宅先為賊所焚乃寓居國子祭酒蕭子雲宅夜忽有盜攻之驚懼墜井卒時年六十九家人十餘人同遇害","mentions":[{"id":"c-liangshu-033-wangyun-wyd:p005:m0009","person_id":"mxz_qw8_acd_A","surface":"筠","start":9,"end":10,"kind":"person","status":"contextual_provisional","interpretation_note":"殿本依本段所書姓名與上下文。"},{"id":"c-liangshu-033-wangyun-wyd:p005:m0162","person_id":"5d1_8jg_amy","surface":"侯景","start":162,"end":164,"kind":"person","status":"contextual_provisional","interpretation_note":"殿本依本段所書姓名與上下文。"},{"id":"c-liangshu-033-w