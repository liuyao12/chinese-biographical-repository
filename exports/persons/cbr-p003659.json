{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003659","identity_policy":"contextual_provisional","person_ids":["cbr-p003659"],"persons":[{"id":"cbr-p003659","label":"太史公（三王世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"太史公","mention_ids":["c-shiji-060-sanwang:m017-0000","c-shiji-060-sanwang:m018-0018"]}],"evidence":[{"mention_id":"c-shiji-060-sanwang:m017-0000","chapter_id":"c-shiji-060-sanwang","paragraph_id":"c-shiji-060-sanwang:p017","quote":"太史公"},{"mention_id":"c-shiji-060-sanwang:m018-0018","chapter_id":"c-shiji-060-sanwang","paragraph_id":"c-shiji-060-sanwang:p018","quote":"太史公"}]}],"mentions":[{"id":"c-shiji-060-sanwang:m017-0000","start":0,"end":3,"surface":"太史公","kind":"person","person_id":"cbr-p003659","status":"contextual_provisional","paragraph_id":"c-shiji-060-sanwang:p017","chapter_id":"c-shiji-060-sanwang"},{"id":"c-shiji-060-sanwang:m018-0018","start":18,"end":21,"surface":"太史公","kind":"person","person_id":"cbr-p003659","status":"contextual_provisional","paragraph_id":"c-shiji-060-sanwang:p018","chapter_id":"c-shiji-060-sanwang"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji060-027","person_id":"cbr-p003659","surfaces":["太史公"],"scope":"same_chapter","chapter_ids":["c-shiji-060-sanwang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-060-sanwang:p017","quote":"太史公曰：古人有言曰「愛之欲其富，親之欲其貴」。故王者壃土建國，封立子弟，所以褒親親，序骨肉，尊先祖，貴支體，廣同姓於天下也。是以形勢彊而王室安。自古至今，所由來久矣。非有異也，故弗論箸也。燕齊之事，無足采者。然封立三王，天子恭讓，群臣守義，文辭爛然，甚可觀也，是以附之世家。"},{"paragraph_id":"c-shiji-060-sanwang:p018","quote":"褚先生曰：臣幸得以文學為侍郎，好覽觀太史公之列傳。傳中稱三王世家文辭可觀，求其世家終不能得。竊從長老好故事者取其封策書，編列其事而傳之，令後世得觀賢主之指意。"}],"rationale":"按明示奏議署稱、封策、三王敘事與局部帝稱暫接；光與安依職事先分候選，單名不補姓。王夫人閎母與三王子嗣依來源所見稱謂，請議與實授、指控與史實分辨，原文及傳承限制保留。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-060-sanwang:p017","text":"太史公曰：古人有言曰「愛之欲其富，親之欲其貴」。故王者壃土建國，封立子弟，所以褒親親，序骨肉，尊先祖，貴支體，廣同姓於天下也。是以形勢彊而王室安。自古至今，所由來久矣。非有異也，故弗論箸也。燕齊之事，無足采者。然封立三王，天子恭讓，群臣守義，文辭爛然，甚可觀也，是以附之世家。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-060-sanwang:m017-0000","start":0,"end":3,"surface":"太史公","kind":"person","person_id":"cbr-p003659","status":"contextual_provisional"},{"id":"c-shiji-060-sanwang:m017-0025","start":25,"end":27,"surface":"王者","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、祖先或未定指代；不補未見姓名、成員或確定親屬。"},{"id":"c-shiji-060-sanwang:m017-0034","start":34,"end":36,"surface":"子弟","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、祖先或未定指代；不補未見姓名、成員或確定親屬。"},{"id":"c-shiji-060-sanwang:m017-0044","start":44,"end":46,"surface":"骨肉","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、祖先或未定指代；不補未見姓名、成員或確定親屬。"},{"id":"c-shiji-060-sanwang:m017-0048","start":48,"end":50,"surface":"先祖","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、祖先或未定指代；不補未見姓名、成員或確定親屬。"},{"id":"c-shiji-060-sanwang:m017-0056","start":56,"end":58,"surface":"同姓","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、祖先或未定指代；不補未見姓名、成員或確定親屬。"},{"id":"c-shiji-060-sanwang:m017-0111","start":111,"end":113,"surface":"天子","kind":"person","person_id":"cbr-p003661","status":"contextual_provisional"},{"id":"c-shiji-060-sanwang:m017-0116","start":116,"end":118,"surface":"群臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、祖先或未定指代；不補未見姓名、成員或確定親屬。"}],"chapter_id":"c-shiji-060-sanwang","book_id":"b-shiji-060","work_id":"w-shiji","source_id":"s-shiji-060-sanwang"},{"id":"c-shiji-060-sanwang:p018","text":"褚先生曰：臣幸得以文學為侍郎，好覽觀太史公之列傳。傳中稱三王世家文辭可觀，求其世家終不能得。竊從長老好故事者取其封策書，編列其事而傳之，令後世得觀賢主之指意。","annotation_status":"named_mentions_first_pass","text_layer":"witness_appended_chu_note","mentions":[{"id":"c-shiji-060-sanwang:m018-0000","start":0,"end":3,"surface":"褚先生","kind":"person","person_