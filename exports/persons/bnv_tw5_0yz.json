art":43,"end":46,"surface":"公玊帶","kind":"person","person_id":"bnv_tw5_0yz","status":"contextual_provisional","paragraph_id":"c-shiji-012-wudi:p042","chapter_id":"c-shiji-012-wudi"},{"id":"c-shiji-012-wudi:m042-0121","start":121,"end":122,"surface":"帶","kind":"person","person_id":"bnv_tw5_0yz","status":"contextual_provisional","paragraph_id":"c-shiji-012-wudi:p042","chapter_id":"c-shiji-012-wudi"},{"id":"c-shiji-012-wudi:m049-0000","start":0,"end":3,"surface":"公玊帶","kind":"person","person_id":"bnv_tw5_0yz","status":"contextual_provisional","paragraph_id":"c-shiji-012-wudi:p049","chapter_id":"c-shiji-012-wudi"},{"id":"c-shiji-012-wudi:m049-0084","start":84,"end":85,"surface":"帶","kind":"person","person_id":"bnv_tw5_0yz","status":"contextual_provisional","paragraph_id":"c-shiji-012-wudi:p049","chapter_id":"c-shiji-012-wudi"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji012-033","person_id":"bnv_tw5_0yz","surfaces":["公玊帶","帶"],"scope":"same_chapter","chapter_ids":["c-shiji-012-wudi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-012-wudi:p042","quote":"初，天子封泰山，泰山東北阯古時有明堂處，處險不敞。上欲治明堂奉高旁，未曉其制度。濟南人公玊帶上黃帝時明堂圖。明堂圖中有一殿，四面無壁，以茅蓋，通水，圜宮垣為複道，上有樓，從西南入，命曰昆侖，天子從之入，以拜祠上帝焉。於是上令奉高作明堂汶上，如帶圖。及五年修封，則祠泰一、五帝於明堂上坐，令高皇帝祠坐對之。祠后土於下房，以二十太牢。天子從昆侖道入，始拜明堂如郊禮。禮畢，燎堂下。而上又上泰山，有祕祠其顛。而泰山下祠五帝，各如其方，黃帝并赤帝，而有司侍祠焉。泰山上舉火，下悉應之。"},{"paragraph_id":"c-shiji-012-wudi:p049","quote":"公玊帶曰：「黃帝時雖封泰山，然風后、封鉅、岐伯令黃帝封東泰山，禪凡山合符，然後不死焉。」天子既令設祠具，至東泰山，東泰山卑小，不稱其聲，乃令祠官禮之，而不封禪焉。其後令帶奉祠候神物。夏，遂還泰山，修五年之禮如前，而加禪祠石閭。石閭者，在泰山下阯南方，方士多言此僊人之閭也，故上親禪焉。"}],"rationale":"依本篇封禪、方士、授官與神異引語的明示語境判讀異稱；神祇或傳說不轉為已確證生平，跨篇同指仍待版本與專門研究核對。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-012-wudi:p042","text":"初，天子封泰山，泰山東北阯古時有明堂處，處險不敞。上欲治明堂奉高旁，未曉其制度。濟南人公玊帶上黃帝時明堂圖。明堂圖中有一殿，四面無壁，以茅蓋，通水，圜宮垣為複道，上有樓，從西南入，命曰昆侖，天子從之入，以拜祠上帝焉。於是上令奉高作明堂汶上，如帶圖。及五年修封，則祠泰一、五帝於明堂上坐，令高皇帝祠坐對之。祠后土於下房，以二十太牢。天子從昆侖道入，始拜明堂如郊禮。禮畢，燎堂下。而上又上泰山，有祕祠其顛。而泰山下祠五帝，各如其方，黃帝并赤帝，而有司侍祠焉。泰山上舉火，下悉應之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-012-wudi:m042-0002","start":2,"end":4,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m042-0043","start":43,"end":46,"surface":"公玊帶","kind":"person","person_id":"bnv_tw5_0yz","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m042-0047","start":47,"end":49,"surface":"黃帝","kind":"person","person_id":"8jz_o3s_obt","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m042-0095","start":95,"end":97,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m042-0104","start":104,"end":106,"surface":"上帝","kind":"unresolved","person_id":null,"status":"unresolved","note":"神祇、群體、匿名者或未定指代，保留來源，不補未見姓名與成員。"},{"id":"c-shiji-012-wudi:m042-0121","start":121,"end":122,"surface":"帶","kind":"person","person_id":"bnv_tw5_0yz","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m042-0132","start":132,"end":134,"surface":"泰一","kind":"unresolved","person_id":null,"status":"unresolved","note":"神祇、群體、匿名者或未定指代，保留來源，不補未見姓名與成員。"},{"id":"c-shiji-012-wudi:m042-0135","start":135,"end":137,"surface":"五帝","kind":"unresolved","person_id":null,"status":"unresolved","note":"神祇、群體、匿名者或未定指代，保留來源，不補未見姓名與成員。"},{"id":"c-shiji-012-wudi:m042-0144","start":144,"end":147,"surface":"高皇帝","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m042-0153","start":153,"end":155,"surface":"后土","kind":"unresolved","person_id":null,"status":"unresolved","note":"神祇、群體、匿名者或未定指代，保留來源，不補未見姓名與成員。"},{"id":"c-shiji-012-wudi:m042-0165","start":165,"end":167,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m042-0206","start":206,"end":208,"surface":"五帝","kind":"unr