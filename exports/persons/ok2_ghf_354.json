eiwei:p018:m0193","start":193,"end":195,"surface":"中宮","kind":"person","person_id":"jmv_vc4_gep_*AAA","status":"contextual_provisional","interpretation_note":"完整裴秀／裴頠單元的具名、當時職位及敘事事件與已錄同時期seed相合；不由單純同名自動合。"},{"id":"c-jinshu-035-peixiu-peiwei:p018:m0231","start":231,"end":232,"surface":"頠","kind":"person","person_id":"kbq_kjc_n2f_AAB","status":"source_explicit"}],"source_position":{"first_line":54,"last_line":54,"revision_id":2506399,"source_layer":"received_biography","raw_projection_ref":"source-evidence/jin035-peixiu-peiwei/raw-projection.json","unit_key":"line054","raw_file_sha256":"b27aa9fc386b5f40990822d615febffcb8b8cd6df3fe6f74585274ff733c12be"},"chapter_id":"c-jinshu-035-peixiu-peiwei","book_id":"b-jinshu-035","work_id":"w-jinshu","source_id":"s-jinshu-035-peixiu-peiwei-ws2506399"},{"id":"c-jinshu-053-minhuai-family:p001","text":"湣懷太子遹，字熙祖，惠帝長子，母曰謝才人。幼而聰慧，武帝愛之，恆在左右。嘗與諸皇子共戲殿上，惠帝來朝，執諸皇子手，次至太子，帝曰：「是汝兒也。」惠帝乃止。宮中嘗夜失火，武帝登樓望之。太子時年五歲，牽帝裾入暗中。帝問其故，太子曰：「暮夜倉卒，宜備非常，不宜令照見人君也。」由是奇之。嘗從帝觀豕牢，言於帝曰：「豕甚肥，何不殺以享士，而使久費五穀？」帝嘉其意，即使烹之。因撫其背，謂廷尉傅祗曰：「此兒當興我家。」嘗對群臣稱太子似宣帝，於是令譽流於天下。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","source_position":{"acquisition":"current_rendered_tool_text","reported_revision_id":2595666,"fixed_body_obtained":false,"tool_line":130},"mentions":[{"id":"c-jinshu-053-minhuai-family:p001:m0000","start":0,"end":5,"surface":"湣懷太子遹","kind":"person","person_id":"dkn_ge4_286_AAAAIAAA","status":"contextual_provisional","source_role":"yu"},{"id":"c-jinshu-053-minhuai-family:p001:m0007","start":7,"end":9,"surface":"熙祖","kind":"person","person_id":"dkn_ge4_286_AAAAIAAA","status":"contextual_provisional","source_role":"yu"},{"id":"c-jinshu-053-minhuai-family:p001:m0010","start":10,"end":12,"surface":"惠帝","kind":"person","person_id":"dkn_ge4_286_AAAAIAA","status":"contextual_provisional","source_role":"hui"},{"id":"c-jinshu-053-minhuai-family:p001:m0017","start":17,"end":20,"surface":"謝才人","kind":"person","person_id":"ok2_ghf_354","status":"co