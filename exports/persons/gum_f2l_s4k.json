nd":14,"surface":"孝文皇帝","kind":"person","person_id":"gum_f2l_s4k","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p011","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m012-0004","start":4,"end":6,"surface":"孝文","kind":"person","person_id":"gum_f2l_s4k","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p012","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m014-0056","start":56,"end":58,"surface":"文帝","kind":"person","person_id":"gum_f2l_s4k","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p014","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m016-0046","start":46,"end":49,"surface":"孝文帝","kind":"person","person_id":"gum_f2l_s4k","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p016","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m016-0109","start":109,"end":112,"surface":"孝文帝","kind":"person","person_id":"gum_f2l_s4k","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p016","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m017-0031","start":31,"end":33,"surface":"文帝","kind":"person","person_id":"gum_f2l_s4k","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p017","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m017-0141","start":141,"end":143,"surface":"文帝","kind":"person","person_id":"gum_f2l_s4k","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p017","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m017-0144","start":144,"end":146,"surface":"文帝","kind":"person","person_id":"gum_f2l_s4k","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p017","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m017-0238","start":238,"end":240,"surface":"文帝","kind":"person","person_id":"gum_f2l_s4k","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p017","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m017-0278","start":278,"end":280,"surface":"文帝","kind":"person","person_id":"gum_f2l_s4k","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p017","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m018-0007","start":7,"end":10,"surface":"孝文帝","kind":"person","person_id":"gum_f2l_s4k","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p018","chapter_id":"c-shiji-096-zhang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji096-026","person_id":"gum_f2l_s4k","scope":"same_chapter","chapter_ids":["c-shiji-096-zhang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["代王","孝文","孝文帝","孝文皇帝","文帝"],"evidence":[{"paragraph_id":"c-shiji-096-zhang:p011","quote":"蒼與絳侯等尊立代王為孝文皇帝。四年，丞相灌嬰卒，張蒼為丞相。"},{"paragraph_id":"c-shiji-096-zhang:p012","quote":"自漢興至孝文二十餘年，會天下初定，將相公卿皆軍吏。張蒼為計相時，緒正律歷。以高祖十月始至霸上，因故秦時本以十月為歲首，弗革。推五德之運，以為漢當水德之時，尚黑如故。吹律調樂，入之音聲，及以比定律令。若百工，天下作程品。至於為丞相，卒就之，故漢家言律歷者，本之張蒼。蒼本好書，無所不觀，無所不通，而尤善律歷。"},{"paragraph_id":"c-shiji-096-zhang:p014","quote":"蒼為丞相十餘年，魯人公孫臣上書言漢土德時，其符有黃龍當見。詔下其議張蒼，張蒼以為非是，罷之。其後黃龍見成紀，於是文帝召公孫臣以為博士，草土德之歷制度，更元年。張丞相由此自絀，謝病稱老。蒼任人為中候，大為姦利，上以讓蒼，蒼遂病免。蒼為丞相十五歲而免。孝景前五年，蒼卒，謚為文侯。子康侯代，八年卒。子類代為侯，八年，坐臨諸侯喪後就位不敬，國除。"},{"paragraph_id":"c-shiji-096-zhang:p016","quote":"申屠丞相嘉者，梁人，以材官蹶張從高帝擊項籍，遷為隊率。從擊黥布軍，為都尉。孝惠時，為淮陽守。孝文帝元年，舉故吏士二千石從高皇帝者，悉以為關內侯，食邑二十四人，而申屠嘉食邑五百戶。張蒼已為丞相，嘉遷為御史大夫。張蒼免相，孝文帝欲用皇后弟竇廣國為丞相，曰：「恐天下以吾私廣國。」廣國賢有行，故欲相之，念久之不可，而高帝時大臣又皆多死，餘見無可者，乃以御史大夫嘉為丞相，因故邑封為故安侯。"},{"paragraph_id":"c-shiji-096-zhang:p017","quote":"嘉為人廉直，門不受私謁。是時太中大夫鄧通方隆愛幸，賞賜累巨萬。文帝嘗燕飲通家，其寵如是。是時丞相入朝，而通居上傍，有怠慢之禮。丞相奏事畢，因言曰：「陛下愛幸臣，則富貴之；至於朝廷之禮，不可以不肅！」上曰：「君勿言，吾私之。」罷朝坐府中，嘉為檄召鄧通詣丞相府，不來，且斬通。通恐，入言文帝。文帝曰：「汝第往，吾今使人召若。」通至丞相府，免冠，徒跣，頓首謝。嘉坐自如，故不為禮，責曰：「夫朝廷者，高皇帝之朝廷也。通小臣，戲殿上，大不敬，當斬。吏今行斬之！」通頓首，首盡出血，不解。文帝度丞相已困通，使使者持節召通，而謝丞相曰：「此吾弄臣，君釋之。」鄧通既至，為文帝泣曰：「丞相幾殺臣。」"},{"paragraph_id":"c-shiji-096-zhang:p018","quote":"嘉為丞相五歲，孝文帝崩，孝景帝即位。二年，晁錯為內史，貴幸用事，諸法令多所請變更，議以謫罰侵削諸侯。而丞相嘉自絀所言不用，疾錯。錯為內史，門東出，不便，更穿一門南出。南出者，太上皇廟堧垣。嘉聞之，欲因此以法錯擅穿宗廟垣為門，奏請誅錯。錯客有語錯，錯恐，夜入宮上謁，自歸景帝。至朝，丞相奏請誅內史錯。景帝曰：「錯所穿非真廟垣，乃外堧垣，故他官居其中，且又我使為之，錯無罪。」罷朝，嘉謂長史曰：「吾悔不先斬錯，乃先請之，為錯所賣。」至舍，因歐血而死。謚為節侯。子共侯蔑代，三年卒。子侯去病代，三十一年卒。子侯臾代，六歲，坐為九江太守受故官送有罪，國除。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定短稱；韋賢與韋玄成分傳區別，第23段掾陳平另候選，第25段長安相工田文不與孟嘗君合併。趙堯、任敖、申屠嘉、鄧通、晁錯的短名依各段人物語境，王陵夫人與王陵分人。張蒼父長不滿五尺的長為身長敘述，不作父名。王侯與太子未詳名不補名，跨篇同指另待證據。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-096-zhang:p011","text":"蒼與絳侯等尊立代王為孝文皇帝。四年，丞相灌嬰卒，張蒼為丞相。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhang:m011-0000","start":0,"end":1,"surface":"蒼","kind":"person","person_id":"796_nkw_0jz_A","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m011-0002","start":2,"end":4,"surface":"絳侯","kind":"person","person_id":"pdd_ww5_imn","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m011-0007","start":7,"end":9,"surface":"代王","kind":"person","person_id":"gum_f2l_s4k","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m011-0010","start":10,"end":14,"surface":"孝文皇帝","kind":"person","person_id":"gum_f2l_s4k","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m011-0020","start":20,"end":22,"surface":"灌嬰","kind":"person","person_id":"wrg_tw6_e8v","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m011-0024","start":24,"end":26,"surface":"張蒼","kind":"person","person_id":"796_nkw_0jz_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-096-zhang","book_id":"b-shiji-096","work_id":"w-shiji","source_id":"s-shiji-096-zhang"},{"id":"c-shiji-096-zhang:p012","text":"自漢興至孝文二十餘年，會天下初定，將相公卿皆軍吏。張蒼為計相時，緒正律歷。以高祖十月始至霸上，因故秦時本以十月為歲首，弗革。推五德之運，以為漢當水德之時，尚黑如故。吹律調樂，入之音聲，及以比定律令。若百工，天下作程品。至於為丞相，卒就之，故漢家言律歷者，本之張蒼。蒼本好書，無所不觀，無所不通，而尤善律歷。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhang:m012-0004","start":4,"end":6,"surface":"孝文","kind":"person","person_id":"gum_f2l_s4k","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m012-0025","start":25,"end":27,"surface":"張蒼","kind":"person","person_id":"796_nkw_0jz_A","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m012-0038","start":38,"end":40,"surface":"高祖","kind":"person","person_id":"h8q_zyo_i2l","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m012-0129","start":129,"end":131,"surface":"張蒼","kind":"person","person_id":"796_nkw_0jz_A","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m012-0132","start":132,"end":133,"surface":"蒼","kind":"person","person_id":"796_nkw_0jz_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-096-zhang","book_id":"b-shiji-096","work_id":"w-shiji","source_id":"s-shiji-096-zhang"},{"id":"c-shiji-096-zhang:p014","text":"蒼為丞相十餘年，魯人公孫臣上書言漢土德時，其符有黃龍當見。詔下其議張蒼，張蒼以為非是，罷之。其後黃龍見成紀，於是文帝召公孫臣以為博士，草土德之歷制度，更元年。張丞相由此自絀，謝病稱老。蒼任人為中候，大為姦利，上以讓蒼，蒼遂病免。蒼為丞相十五歲而免。孝景前五年，蒼卒，謚為文侯。子康侯代，八年卒。子類代為侯，八年，坐臨諸侯喪後就位不敬，國除。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhang:m014-0000","start":0,"end":1,"surface":"蒼","kind":"person","person_id":"796_nkw_0jz_A","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m014-0010","start":10,"end":13,"surface":"公孫臣","kind":"person","person_id":"7kl_if8_wye","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m014-0033","start":33,"end":35,"surface":"張蒼","kind":"person","person_id":"796_nkw_0jz_A","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m014-0036","start":36,"end":38,"surface":"張蒼","kind":"person","person_id":"796_nkw_0jz_A","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m014-0056","start":56,"end":58,"surface":"文帝","kind":"person","person_id":"gum_f2l_s4k","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m014-0059","start":59,"end":62,"surface":"公孫臣","kind":"person","person_id":"7kl_if8_wye","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m014-0079","start":79,"end":82,"surface":"張丞相","kind":"person","person_id":"796_nkw_0jz_A","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m014-0092","start":92,"end":93,"surface":"蒼","kind":"person","person_id":"796_nkw_0jz_A","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m014-0107","start":107,"end":108,"surface":"蒼","kind":"person","person_id":"796_nkw_0jz_A","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m014-0109","start":109,"end":110,"surface":"蒼","kind":"person","person_id":"796_nkw_0jz_A","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m014-0114","start":114,"end":115,"surface":"蒼","kind":"person","person_id":"796_nkw_0jz_A","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m014-0124","start":124,"end":126,"surface":"孝景","kind":"person","person_id":"6e8_159_ryk","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m014-0130","start":130,"end":131,"surface":"蒼","kind":"person","person_id":"796_nkw_0jz_A","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m014-0139","start":139,"end":141,"surface":"康侯","kind":"person","person_id":"796_nkw_0jz_AA","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m014-0148","start":148,"end":149,"surface":"類","kind":"person","person_id":"796_nkw_0jz_AAA","status":"contextual_provisional"}],"chapter_id":"c-shiji-096-zhang","book_id":"b-shiji-096","work_id":"w-shiji","source_id":"s-shiji-096-zhang"},{"id":"c-shiji-096-zhang:p016","text":"申屠丞相嘉者，梁人，以材官蹶張從高帝擊項籍，遷為隊率。從擊黥布軍，為都尉。孝惠時，為淮陽守。孝文帝元年，舉故吏士二千石從高皇帝者，悉以為關內侯，食邑二十四人，而申屠嘉食邑五百戶。張蒼已為丞相，嘉遷為御史大夫。張蒼免相，孝文帝欲用皇后弟竇廣國為丞相，曰：「恐天下以吾私廣國。」廣國賢有行，故欲相之，念久之不可，而高帝時大臣又皆多死，餘見無可者，乃以御史大夫嘉為丞相，因故邑封為故安侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhang:m016-0000","start":0,"end":5,"surface":"申屠丞相嘉","kind":"person","person_id":"yph_dkb_w4w","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m016-0016","start":16,"end":18,"surface":"高帝","kind":"person","person_id":"h8q_zyo_i2l","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m016-0019","start":19,"end":21,"surface":"項籍","kind":"person","person_id":"jej_8s3_01z","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m016-0029","start":29,"end":31,"surface":"黥布","kind":"person","person_id":"e4c_pkg_cq7","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m016-0037","start":37,"end":39,"surface":"孝惠","kind":"person","person_id":"srh_4ts_334","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m016-0046","start":46,"end":49,"surface":"孝文帝","kind":"person","person_id":"gum_f2l_s4k","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m016-0060","start":60,"end":63,"surface":"高皇帝","kind":"person","person_id":"h8q_zyo_i2l","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m016-0080","start":80,"end":83,"surface":"申屠嘉","kind":"person","person_id":"yph_dkb_w4w","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m016-0089","start":89,"end":91,"surface":"張蒼","kind":"person","person_id":"796_nkw_0jz_A","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m016-0096","start":96,"end":97,"surface":"嘉","kind":"person","person_id":"yph_dkb_w4w","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m016-0104","start":104,"end":106,"surface":"張蒼","kind":"person","person_id":"796_nkw_0jz_A","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m016-0109","start":109,"end":112,"surface":"孝文帝","kind":"person","person_id":"gum_f2l_s4k","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m016-0114","start":114,"end":116,"surface":"皇后","kind":"person","person_id":"6af_362_yyq","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m016-0117","start":117,"end":120,"surface":"竇廣國","kind":"person","person_id":"3tp_ab0_hlx","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m016-0133","start":133,"end":135,"surface":"廣國","kind":"person","person_id":"3tp_ab0_hlx","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m016-0137","start":137,"end":139,"surface":"廣國","kind":"person","person_id":"3tp_ab0_hlx","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m016-0155","start":155,"end":157,"surface":"高帝","kind":"person","person_id":"h8q_zyo_i2l","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m016-0177","start":177,"end":178,"surface":"嘉","kind":"person","person_id":"yph_dkb_w4w","status":"contextual_provisional"}],"chapter_id":"c-shiji-096-zhang","book_id":"b-shiji-096","work_id":"w-shiji","source_id":"s-shiji-096-zhang"},{"id":"c-shiji-096-zhang:p017","text":"嘉為人廉直，門不受私謁。是時太中大夫鄧通方隆愛幸，賞賜累巨萬。文帝嘗燕飲通家，其寵如是。是時丞相入朝，而通居上傍，有怠慢之禮。丞相奏事畢，因言曰：「陛下愛幸臣，則富貴之；至於朝廷之禮，不可以不肅！」上曰：「君勿言，吾私之。」罷朝坐府中，嘉為檄召鄧通詣丞相府，不來，且斬通。通恐，入言文帝。文帝曰：「汝第往，吾今使人召若。」通至丞相府，免冠，徒跣，頓首謝。嘉坐自如，故不為禮，責曰：「夫朝廷者，高皇帝之朝廷也。通小臣，戲殿上，大不敬，當斬。吏今行斬之！」通頓首，首盡出血，不解。文帝度丞相已困通，使使者持節召通，而謝丞相曰：「此吾弄臣，君釋之。」鄧通既至，為文帝泣曰：「丞相幾殺臣。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhang:m017-0000","start":0,"end":1,"surface":"嘉","kind":"person","person_id":"yph_dkb_w4w","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m017-0018","start":18,"end":20,"surface":"鄧通","kind":"person","person_id":"qow_wy0_7d2","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m017-0031","start":31,"end":33,"surface":"文帝","kind":"person","person_id":"gum_f2l_s4k","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m017-0036","start":36,"end":37,"surface":"通","kind":"person","person_id":"qow_wy0_7d2","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m017-0052","start":52,"end":53,"surface":"通","kind":"person","person_id":"qow_wy0_7d2","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m017-0118","start":118,"end":119,"surface":"嘉","kind":"person","person_id":"yph_dkb_w4w","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m017-0122","start":122,"end":124,"surface":"鄧通","kind":"person","person_id":"qow_wy0_7d2","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m017-0134"