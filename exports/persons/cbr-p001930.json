on_id":"cbr-p001931","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m043-0276","start":276,"end":277,"surface":"尚","kind":"person","person_id":"cbr-p001932","status":"contextual_provisional"}],"chapter_id":"c-shiji-040-chu","book_id":"b-shiji-040","work_id":"w-shiji","source_id":"s-shiji-040-chu"},{"id":"c-shiji-040-chu:p046","text":"昭王元年，楚衆不説費無忌，以其讒亡太子建，殺伍奢子父與郤宛。宛之宗姓伯氏子及子胥皆奔呉，呉兵數侵楚，楚人怨無忌甚。楚令尹子常誅無忌以説衆，衆乃喜。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m046-0000","start":0,"end":2,"surface":"昭王","kind":"person","person_id":"cbr-p001915","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m046-0009","start":9,"end":12,"surface":"費無忌","kind":"person","person_id":"cbr-p001930","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m046-0017","start":17,"end":20,"surface":"太子建","kind":"person","person_id":"cbr-p001929","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m046-0022","start":22,"end":24,"surface":"伍奢","kind":"person","person_id":"cbr-p001931","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m046-0027","start":27,"end":29,"surface":"郤宛","kind":"person","person_id":"cbr-p001980","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m046-0030","start":30,"end":31,"surface":"宛","kind":"person","person_id":"cbr-p001980","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m046-0034","start":34,"end":37,"surface":"伯氏子","kind":"person","person_id":"cbr-p001981","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m046-0038","start":38,"end":40,"surface":"子胥","kind":"person","person_id":"cbr-p001933","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m046-0053","start":53,"end":55,"surface":"無忌","kind":"person","person_id":"cbr-p001930","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m046-0060","start":60,"end":62,"surface":"子常","kind":"person","person_id":"cbr-p001934","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m046