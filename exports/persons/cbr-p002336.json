2343","predicate":"father","object_person_id":"cbr-p002336","status":"source_attested","evidence":[{"chapter_id":"c-shiji-043-zhao","source_id":"s-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p042","quote":"其後娶空同氏，生五子。襄子爲伯魯之不立也，不肯立子，且必欲傳位與伯魯子代成君。成君先死，乃取代成君子浣立爲太子。襄子立三十三年卒，浣立，是爲獻侯。"}],"qualifiers":{"source_term":"代成君子浣","historicity":"historical_tradition"},"interpretation_note":"限本文姊、兄弟、娶、子與曾孫語境；繼位不單獨推父子，五子群體不補名字或母子鏈。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji043-020","person_id":"cbr-p002336","title":"代成君","kind":"noble_rank","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-043-zhao","source_id":"s-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p038","quote":"襄子姊前爲代王夫人。簡子旣葬，未除服，北登夏屋，請代王。使廚人操銅枓以食代王及從者，行斟，陰令宰人各以枓撃殺代王及從官，遂興兵平代地。其姊聞之，泣而呼天，摩笄自殺。代人憐之，所死地名之爲摩笄之山。遂以代封伯魯子周爲代成君。伯魯者，襄子兄，故太子。太子蚤死，故封其子。"}],"attestations":[{"id":"th-shiji043-020:a001","paragraph_id":"c-shiji-043-zhao:p038","start":107,"end":110,"surface":"代成君","person_mention_id":"c-shiji-043-zhao:m038-0107","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-043-zhao","source_id":"s-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p038","quote":"襄子姊前爲代王夫人。簡子旣葬，未除服，北登夏屋，請代王。使廚人操銅枓以食代王及從者，行斟，陰令宰人各以枓撃殺代王及從官，遂興兵平代地。其姊聞之，泣而呼天，摩笄自殺。代人憐之，所死地名之爲摩笄之山。遂以代封伯魯子周爲代成君。伯魯者，襄子兄，故太子。太子蚤死，故封其子。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予、既有用稱及追尊分存；不由卒、出奔、自立或短稱推定此前所有任期。相國四年是當時敘事時長，未推曆日。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji043-107","person_id":"cbr-p002336","surfaces":["代成君","周","成君"],"scope":"same_chapter","chapter_ids":["c-shiji-043-zhao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-043-zhao:p038","quote":"襄子姊前爲代王夫人。簡子旣葬，未除服，北登夏屋，請代王。使廚人操銅枓以食代王及從者，行斟，陰令宰人各以枓撃殺代王及從官，遂興兵平代地。其姊聞之，泣而呼天，摩笄自殺。代人憐之，所死地