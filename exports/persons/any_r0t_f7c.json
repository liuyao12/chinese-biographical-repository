l"},{"id":"c-shiji-081-lianlin:m020-0130","start":130,"end":132,"surface":"趙王","kind":"person","person_id":"d9b_5t4_9eb_AA","status":"contextual_provisional"}],"chapter_id":"c-shiji-081-lianlin","book_id":"b-shiji-081","work_id":"w-shiji","source_id":"s-shiji-081-lianlin"},{"id":"c-shiji-081-lianlin:p026","text":"趙王遷七年，秦使王翦攻趙，趙使李牧、司馬尚禦之。秦多與趙王寵臣郭開金，爲反間，言李牧、司馬尚欲反。趙王乃使趙蔥及齊將顏聚代李牧。李牧不受命，趙使人微捕得李牧，斬之。廢司馬尚。後三月，王翦因急撃趙，大破殺趙蔥，虜趙王遷及其將顏聚，遂滅趙。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-081-lianlin:m026-0000","start":0,"end":3,"surface":"趙王遷","kind":"person","person_id":"33k_p1u_8v9","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m026-0008","start":8,"end":10,"surface":"王翦","kind":"person","person_id":"60u_e89_x8d","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m026-0015","start":15,"end":17,"surface":"李牧","kind":"person","person_id":"qbg_2pe_t58","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m026-0018","start":18,"end":21,"surface":"司馬尚","kind":"person","person_id":"x3j_j8y_j74","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m026-0027","start":27,"end":29,"surface":"趙王","kind":"person","person_id":"33k_p1u_8v9","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m026-0031","start":31,"end":33,"surface":"郭開","kind":"person","person_id":"a2x_dkn_fj9","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m026-0040","start":40,"end":42,"surface":"李牧","kind":"person","person_id":"qbg_2pe_t58","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m026-0043","start":43,"end":46,"surface":"司馬尚","kind":"person","person_id":"x3j_j8y_j74","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m026-0049","start":49,"end":51,"surface":"趙王","kind":"person","person_id":"33k_p1u_8v9","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m026-0053","start":53,"end":55,"surface":"趙蔥","kind":"person","person_id":"d4o_xs0_n1j","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m026-0056","start":56,"end":60,"surface":"齊將顏聚","kind":"person","person_id":"d28_lyw_tjf","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m026-0061","start":61,"end":63,"surface":"李牧","kind":"person","person_id":"qbg_2pe_t58","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m026-0064","start":64,"end":66,"surface":"李牧","kind":"person","person_id":"qbg_2pe_t58","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m026-0071","start":71,"end":73,"surface":"使人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未定角色或泛論保存，不補姓名。"},{"id":"c-shiji-081-lianlin:m026-0076","start":76,"end":78,"surface":"李牧","kind":"person","person_id":"qbg_2pe_t58","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m026-0083","start":83,"end":86,"surface":"司馬尚","kind":"person","person_id":"x3j_j8y_j74","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m026-0091","start":91,"end":93,"surface":"王翦","kind":"person","person_id":"60u_e89_x8d","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m026-0101","start":101,"end":103,"surface":"趙蔥","kind":"person","person_id":"d4o_xs0_n1j","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m026-0105","start":105,"end":108,"surface":"趙王遷","kind":"person","person_id":"33k_p1u_8v9","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m026-0111","start":111,"end":113,"surface":"顏聚","kind":"person","person_id":"d28_lyw_tjf","status":"contextual_provisional"}],"chapter_id":"c-shiji-081-lianlin","book_id":"b-shiji-081","work_id":"w-shiji","source_id":"s-shiji-081-lianlin"},{"id":"c-shiji-102-zhangfeng:p012","text":"當是之時，匈奴新大入朝那，殺北地都尉卬。上以胡寇爲意，乃卒復問唐曰：「公何以知吾不能用廉頗、李牧也？」唐對曰：「臣聞上古王者之遣將也，跪而推轂，曰閫以內者，寡人制之；閫以外者，將軍制之。軍功爵賞皆決於外，歸而奏之。此非虛言也。臣大父言，李牧爲趙將居邊，軍市之租皆自用饗士，賞賜決於外，不從中擾也。委任而責成功，故李牧乃得盡其智能，遣選車千三百乘，彀騎萬三千，百金之士十萬，是以北逐單于，破東胡，滅澹林，西抑彊秦，南支韓、魏。當是之時，趙幾霸。其後會趙王遷立，其母倡也。王遷立，乃用郭開讒，卒誅李牧，令顏聚代之。是以兵破士北，爲秦所禽滅。今臣竊聞魏尚爲雲中守，其軍市租盡以饗士卒，［出］私養錢，五日一椎牛，饗賓客軍吏舍人，是以匈奴遠避，不近雲中之塞。虜曾一入，尚率車騎擊之，所殺其眾。夫士卒盡家人子，起田中從軍，安知尺籍伍符。終日力戰，斬首捕虜，上功莫府，一言不相應，文吏以法繩之。其賞不行而吏奉法必用。臣愚，以爲陛下法太明，賞太輕，罰太重。且雲中守魏尚坐上功首虜差六級，陛下下之吏，削其爵，罰作之。由此言之，陛下雖得廉頗、李牧，弗能用也。臣誠愚，觸忌諱，死罪死罪！」文帝説。是日令馮唐持節赦魏尚，復以爲雲中守，而拜唐爲車騎都尉，主中尉及郡國車士。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-102-zhangfeng:m012-0018","start":18,"end":19,"surface":"卬","kind":"person","person_id":"97s_gzq_ow9","status":"contextual_provisional"},{"id":"c-shiji-102-zhangfeng:m012-0020","start":20,"end":21,"surface":"上","kind":"person","person_id":"065_z0k_4dc","status":"contextual_provisional"},{"id":"c-shiji-102-zhangfeng:m012-0031","start":31,"end":32,"surface":"唐","kind":"person","person_id":"rl6_a40_3hj_AA","status":"contextual_provisional"},{"id":"c-shiji-102-zhangfeng:m012-0043","start":43,"end":45,"surface":"廉頗","kind":"person","person_id":"mag_s6n_b0c","status":"contextual_provisional"},{"id":"c-shiji-102-zhangfeng:m012-0046","start":46,"end":48,"surface":"李牧","kind":"person","person_id":"1as_2bm_qu5","status":"contextual_provisional"},{"id":"c-shiji-102-zhangfeng:m012-0051","start":51,"end":52,"surface":"唐","kind":"person","person_id":"rl6_a40_3hj_AA","status":"contextual_provisional"},{"id":"c-shiji-102-zhangfeng:m012-0058","start":58,"end":62,"surface":"上古王者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、典故或待辨指代；父老與父知之乎在本段為對馮唐的稱呼，不新增馮唐父親。"},{"id":"c-shiji-102-zhangfeng:m012-0114","start":114,"end":116,"surface":"大父","kind":"person","person_id":"rl6_a40_3hj","status":"contextual_provisional"},{"id":"c-shiji-102-zhangfeng:m012-0118","start":118,"end":120,"surface":"李牧","kind":"person","person_id":"1as_2bm_qu5","status":"contextual_provisional"},{"id":"c-shiji-102-zhangfeng:m012-0156","start":156,"end":158,"surface":"李牧","kind":"person","person_id":"1as_2bm_qu5","status":"contextual_provisional"},{"id":"c-shiji-102-zhangfeng:m012-0190","start":190,"end":192,"surface":"單于","kind":"unresolved","person_id":null,"st