d":"c-shiji-069-su:m051-0107","start":107,"end":109,"surface":"秦王","kind":"person","person_id":"cbr-p004074","status":"contextual_provisional","paragraph_id":"c-shiji-069-su:p051","chapter_id":"c-shiji-069-su"},{"id":"c-shiji-069-su:m051-0149","start":149,"end":151,"surface":"秦王","kind":"person","person_id":"cbr-p004074","status":"contextual_provisional","paragraph_id":"c-shiji-069-su:p051","chapter_id":"c-shiji-069-su"},{"id":"c-shiji-069-su:m051-0155","start":155,"end":156,"surface":"王","kind":"person","person_id":"cbr-p004074","status":"contextual_provisional","paragraph_id":"c-shiji-069-su:p051","chapter_id":"c-shiji-069-su"},{"id":"c-shiji-069-su:m051-0344","start":344,"end":345,"surface":"王","kind":"person","person_id":"cbr-p004074","status":"contextual_provisional","paragraph_id":"c-shiji-069-su:p051","chapter_id":"c-shiji-069-su"},{"id":"c-shiji-069-su:m051-0358","start":358,"end":359,"surface":"王","kind":"person","person_id":"cbr-p004074","status":"contextual_provisional","paragraph_id":"c-shiji-069-su:p051","chapter_id":"c-shiji-069-su"},{"id":"c-shiji-069-su:m051-0407","start":407,"end":409,"surface":"秦王","kind":"person","person_id":"cbr-p004074","status":"contextual_provisional","paragraph_id":"c-shiji-069-su:p051","chapter_id":"c-shiji-069-su"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji069-053","person_id":"cbr-p004074","scope":"same_chapter","chapter_ids":["c-shiji-069-su"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["王","秦王"],"evidence":[{"paragraph_id":"c-shiji-069-su:p051","quote":"今王若欲因禍為福，轉敗為功，則莫若挑霸齊而尊之，使使盟於周室，焚秦符，曰「其大上計，破秦；其次，必長賓之」。秦挾賓以待破，秦王必患之。秦五世伐諸侯，今為齊下，秦王之志苟得窮齊，不憚以國為功。然則王何不使辯士以此言說秦王曰：「燕、趙破宋肥齊，尊之為之下者，燕、趙非利之也。燕、趙不利而勢為之者，以不信秦王也。然則王何不使可信者接收燕、趙，令涇陽君、高陵君先於燕、趙？秦有變，因以為質，則燕、趙信秦。秦為西帝，燕為北帝，趙為中帝，立三帝以令於天下。韓、魏不聽則秦伐之，齊不聽則燕、趙伐之，天下孰敢不聽？天下服聽，因驅韓、魏以伐齊，曰『必反宋地，歸楚淮北』。反宋地，歸楚淮北，燕、趙之所利也；並立三帝，燕、趙之所願也。夫實得所利，尊得所願，燕、趙棄齊如脫躧矣。今不收燕、趙，齊霸必成。諸侯贊齊而王不從，是國伐也；諸侯贊齊而王從之，是名卑也。今收燕、趙，國安而名尊；不收燕、趙，國危而名卑。夫去尊安而取危卑，智者不為也。」秦王聞若說，必若刺心然。則王何不使辯士以此若言說秦？秦必取，齊必伐矣。"}],"rationale":"按姓名、字稱、遊說對象及嵌入書信局部暫接。蘇代初見燕王、過魏魏王齊王及書信秦王楚王等另存候選，未按歷史年代補熟名；不斷言這些候選必為異人。燕噲讓位段與燕昭王書信分辨，書信內外王稱按引語範圍。穰侯舅與太后母局部暫接，未補姓名或秦王親屬世系。故事家屬與蘇秦家屬分存；全67段明示姓名首輪已存，版本年代、匿名者代詞及其他身份尚待覆核。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-069-su:p051","text":"今王若欲因禍為福，轉敗為功，則莫若挑霸齊而尊之，使使盟於周室，焚秦符，曰「其大上計，破秦；其次，必長賓之」。秦挾賓以待破，秦王必患之。秦五世伐諸侯，今為齊下，秦王之志苟得窮齊，不憚以國為功。然則王何不使辯士以此言說秦王曰：「燕、趙破宋肥齊，尊之為之下者，燕、趙非利之也。燕、趙不利而勢為之者，以不信秦王也。然則王何不使可信者接收燕、趙，令涇陽君、高陵君先於燕、趙？秦有變，因以為質，則燕、趙信秦。秦為西帝，燕為北帝，趙為中帝，立三帝以令於天下。韓、魏不聽則秦伐之，齊不聽則燕、趙伐之，天下孰敢不聽？天下服聽，因驅韓、魏以伐齊，曰『必反宋地，歸楚淮北』。反宋地，歸楚淮北，燕、趙之所利也；並立三帝，燕、趙之所願也。夫實得所利，尊得所願，燕、趙棄齊如脫躧矣。今不收燕、趙，齊霸必成。諸侯贊齊而王不從，是國伐也；諸侯贊齊而王從之，是名卑也。今收燕、趙，國安而名尊；不收燕、趙，國危而名卑。夫去尊安而取危卑，智者不為也。」秦王聞若說，必若刺心然。則王何不使辯士以此若言說秦？秦必取，齊必伐矣。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m051-0001","start":1,"end":2,"surface":"王","kind":"person","person_id":"cbr-p004070","status":"contextual_provisional"},{"id":"c-shiji-069-su:m051-0024","start":24,"end":26,"surface":"使使","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、氏族、未名者或未定指代，不補姓名與成員；趙莊戰名性質未定。"},{"id":"c-shiji-069-su:m051-0061","start":61,"end":63,"surface":"秦王","kind":"person","person_id":"cbr-p004074","status":"contextual_provisional"},{"id":"c-shiji-069-su:m051-0071","start":71,"end":73,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、氏族、未名者或未定指代，不補姓名與成員；趙莊戰名性質未定。"},{"id":"c-shiji-069-su:m051-0079","start":79,"end":81,"surface":"秦王","kind":"person","person_id":"cbr-p004074","status":"contextual_provisional"},{"id":"c-shiji-069-su:m051-0097","start":97,"end":98,"surface":"王","kind":"person","person_id":"cbr-p004070","status":"contextual_provisional"},{"id":"c-shiji-069-su:m051-0101","start":101,"end":103,"surface":"辯士","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、氏族、未名者或未定指代，不補姓名與成員；趙莊戰名性質未定。"},{"id":"c-shiji-069-su:m051-010