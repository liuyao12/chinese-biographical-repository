tle_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji039-179","person_id":"cbr-p001741","surfaces":["賈佗"],"scope":"same_chapter","chapter_ids":["c-shiji-039-jin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-039-jin:p051","quote":"晉文公重耳，晉獻公之子也。自少好士，年十七，有賢士五人：曰趙衰；狐偃咎犯，文公舅也；賈佗；先軫；魏武子。自獻公爲太子時，重耳固已成人矣。獻公卽位，重耳年二十一。獻公十三年，以驪姬故，重耳備蒲城守秦。獻公二十一年，獻公殺太子申生，驪姬讒之，恐，不辭獻公而守蒲城。獻公二十二年，獻公使宦者履鞮趣殺重耳。重耳踰垣，宦者逐斬其衣袪。重耳遂奔狄。狄，其母國也。是時重耳年四十三。從此五士，其餘不名者數十人，至狄。"}],"rationale":"按本篇明示名與稱號、晉世系與具體事件暫定所列提及同指；附各段原文，未按同字短名全域合併；紀年與版本差異待核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji040-145","person_id":"cbr-p002021","surfaces":["賈佗"],"scope":"same_chapter","chapter_ids":["c-shiji-040-chu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-040-chu:p040","quote":"初，子比自晉歸，韓宣子問叔向曰：「子比其濟乎？」對曰：「不就。」宣子曰：「同惡相求，如市賈焉，何爲不就？」對曰：「無與同好，誰與同惡？取國有五難：有寵無人，一也；有人無主，二也；有主無謀，三也；有謀而無民，四也；有民而無德，五也。子比在晉十三年矣，晉、楚之從不聞通者，可謂無人矣；族盡親叛，可謂無主矣；無釁而動，可謂無謀矣；爲羈終世，可謂無民矣；亡無愛徴，可謂無德矣。王虐而不忌，子比渉五難以弒君，誰能濟之！有楚國者，其棄疾乎？君陳、蔡，方城外屬焉。苛慝不作，盜賊伏隱，私欲不違，民無怨心。先神命之，國民信之。羋姓有亂，必季實立，楚之常也。子比之官，則右尹也；數其貴寵，則庶子也；以神所命，則又遠之；民無懷焉，將何以立？」宣子曰：「齊桓、晉文不亦是乎？」對曰：「齊桓，衞姬之子也，有寵於釐公。有鮑叔牙、賓須無、隰朋以爲輔，有莒、衞以爲外主，有髙、國以爲内主。從善如流，施惠不倦。有國，不亦宜乎？昔我文公，狐季姬之子也，有寵於獻公。好學不倦。生十七年，有士五人，有先大夫子餘、子犯以爲腹心，有魏犫、賈佗以爲股肱，有齊、宋、秦、楚以爲外主，有欒、郤、狐、先以爲内主。亡十九年，守志彌篤。惠、懷棄民，民從而與之。故文公有國，不亦宜乎？子比無施於民，無援於外，去晉，晉不送；歸楚，楚不迎。何以有國！」子比果不終焉，卒立者棄疾，如叔向言也。"}],"rationale":"本篇具名角色先保存候選；尚未與他篇同名或同稱人物完成事件、世系與版本比對，不作確定不同人或確定同人的結論。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji040-jiatuo","person_ids":["cbr-p001741","cbr-p002021"],"canonical_person_id":"cbr-p001741","scope":"cross_chapter","chapter_ids":["c-shiji-039-jin","c-shiji-040-chu"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-039-jin","source_id":"s-shiji-039-jin","paragraph_id":"c-shiji-039-jin:p051","quote":"晉文公重耳，晉獻公之子也。自少好士，年十七，有賢士五人：曰趙衰；狐偃咎犯，文公舅也；賈佗；先軫；魏武子。自獻公爲太子時，重耳固已成人矣。獻公卽位，重耳年二十一。獻公十三年，以驪姬故，重耳備蒲城守秦。獻公二十一年，獻公殺太子申生，驪姬讒之，恐，不辭獻公而守蒲城。獻公二十二年，獻公使宦者履鞮趣殺重耳。重耳踰垣，宦者逐斬其衣袪。重耳遂奔狄。狄，其母國也。是時重耳年四十三。從此五士，其餘不名者數十人，至狄。","mention_ids":["c-shiji-039-jin:m051-0042"]},{"chapter_id":"c-shiji-040-chu","source_id":"s-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p040","quote":"初，子比自晉歸，韓宣子問叔向曰：「子比其濟乎？」對曰：「不就。」宣子曰：「同惡相求，如市賈焉，何爲不就？」對曰：「無與同好，誰與同惡？取國有五難：有寵無人，一也；有人無主，二也；有主無謀，三也；有謀而無民，四也；有民而無德，五也。子比在晉十三年矣，晉、楚之從不聞通者，可謂無人矣；族盡親叛，可謂無主矣；無釁而動，可謂無謀矣；爲羈終世，可謂無民矣；亡無愛徴，可謂無德矣。王虐而不忌，子比渉五難以弒君，誰能濟之！有楚國者，其棄疾乎？君陳、蔡，方城外屬焉。苛慝不作，盜賊伏隱，私欲不違，民無怨心。先神命之，國民信之。羋姓有亂，必季實立，楚之常也。子比之官，則右尹也；數其貴寵，則庶子也；以神所命，則又遠之；民無懷焉，將何以立？」宣子曰：「齊桓、晉文不亦是乎？」對曰：「齊桓，衞姬之子也，有寵於釐公。有鮑叔牙、賓須無、隰朋以爲輔，有莒、衞以爲外主，有髙、國以爲内主。從善如流，施惠不倦。有國，不亦宜乎？昔我文公，狐季姬之子也，有寵於獻公。好學不倦。生十七年，有士五人，有先大夫子餘、子犯以爲腹心，有魏犫、賈佗以爲股肱，有齊、宋、秦、楚以爲外主，有欒、郤、狐、先以爲内主。亡十九年，守志彌篤。惠、懷棄民，民從而與之。故文公有國，不亦宜乎？子比無施於民，無援於外，去晉，晉不送；歸楚，楚不迎。何以有國！」子比果不終焉，卒立者棄疾，如叔向言也。","mention_ids":["c-shiji-040-chu:m040-0448"]}],"rationale":"兩篇文公少時十七年有五士的相同敘事均列賈佗，依姓名及具體隨從背景暫同指。 原ID與證據保留，版本及人工審閱尚未完成。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-039-jin:p051","text":"晉文公重耳，晉獻公之子也。自少好士，年十七，有賢士五人：曰趙衰；狐偃咎犯，文公舅也；賈佗；先軫；魏武子。自獻公爲太子時，重耳固已成人矣。獻公卽位，重耳年二十一。獻公十三年，以驪姬故，重耳備蒲城守秦。獻公二十一年，獻公殺太子申生，驪姬讒之，恐，不辭獻公而守蒲城。獻公二十二年，獻公使宦者履鞮趣殺重耳。重耳踰垣，宦者逐斬其衣袪。重耳遂奔狄。狄，其母國也。是時重耳年四十三。從此五士，其餘不名者數十人，至狄。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m051-0000","start":0,"end":5,"surface":"晉文公重耳","kind":"person","person_id":"cbr-p000252","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m051-0006","start":6,"end":9,"surface":"晉獻公","kind":"person","person_id":"cbr-p000374","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m051-0029","start":29,"end":31,"surface":"趙衰","kind":"person","person_id":"cbr-p000329","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m051-0032","start":32,"end":36,"surface":"狐偃咎犯","kind":"person","person_id":"cbr-p001740","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m051-0037","start":37,"end":39,"surface":"文公","kind":"perso