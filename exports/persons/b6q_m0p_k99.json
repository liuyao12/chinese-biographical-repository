{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"b6q_m0p_k99","canonical_person_id":"b6q_m0p_k99","id_aliases":["cbr-p004302"],"identity_policy":"contextual_provisional","person_ids":["b6q_m0p_k99"],"persons":[{"id":"b6q_m0p_k99","label":"伊尹（孟子荀卿列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"伊尹","mention_ids":["c-shiji-074-mengxun:m005-0173"]}],"evidence":[{"mention_id":"c-shiji-074-mengxun:m005-0173","chapter_id":"c-shiji-074-mengxun","paragraph_id":"c-shiji-074-mengxun:p005","quote":"伊尹"}],"id_aliases":["cbr-p004302"]}],"source_mention_summary":[{"source_id":"s-shiji-074-mengxun","work_id":"w-shiji","book_id":"b-shiji-074","chapter_id":"c-shiji-074-mengxun","mention_count":1,"mention_ids":["c-shiji-074-mengxun:m005-0173"],"paragraph_ids":["c-shiji-074-mengxun:p005"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-074-mengxun"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-074-mengxun:m005-0173","start":173,"end":175,"surface":"伊尹","kind":"person","person_id":"b6q_m0p_k99","status":"contextual_provisional","paragraph_id":"c-shiji-074-mengxun:p005","chapter_id":"c-shiji-074-mengxun"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji074-026","person_id":"b6q_m0p_k99","surfaces":["伊尹"],"scope":"same_chapter","chapter_ids":["c-shiji-074-mengxun"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-074-mengxun:p005","quote":"是以騶子重於齊。適梁，惠王郊迎，執賓主之禮。適趙，平原君側行撇席。如燕，昭王擁彗先驅，請列弟子之座而受業，筑碣石宮，身親往師之。作主運。其游諸侯見尊禮如此，豈與仲尼菜色陳蔡，孟軻困於齊梁同乎哉！故武王以仁義伐紂而王，伯夷餓不食周粟；衛靈公問陳，而孔子不答；梁惠王謀欲攻趙，孟軻稱大王去邠。此豈有意阿世俗茍合而已哉！持方枘欲內圜鑿，其能入乎？或曰，伊尹負鼎而勉湯以王，百里奚飯牛車下而繆公用霸，作先合，然後引之大道。騶衍其言雖不軌，儻亦有牛鼎之意乎？"}],"rationale":"依前5段明示稱名與局部敘事暫接，孟軻與孟子人稱分辨書名；第5段騶子限接前段騶衍。騶忌、騶衍與三騶群體不混，齊宣王威王與燕昭王分開。夫子引言、孫子、大王去邠與繆公不按記憶補名字；仲尼與孔子已發ID各保留，跨篇暫同指另存於本篇equivalences記錄。引古與傳說保持來源層，不作已確證年代與事實。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-074-mengxun:p005","text":"是以騶子重於齊。適梁，惠王郊迎，執賓主之禮。適趙，平原君側行撇席。如燕，昭王擁彗先驅，請列弟子之座而受業，筑碣石宮，身親往師之。作主運。其游諸侯見尊禮如此，豈與仲尼菜色陳蔡，孟軻困於齊梁同乎哉！故武王以仁義伐紂而王，伯夷餓不食周粟；衛靈公問陳，而孔子不答；梁惠王謀欲攻趙，孟軻稱大王去邠。此豈有意阿世俗茍合而已哉！持方枘欲內圜鑿，其能入乎？或曰，伊尹負鼎而勉湯以王，百里奚飯牛車下而繆公用霸，作先合，然後引之大道。騶衍其言雖不軌，儻亦有牛鼎之意乎？","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-074-mengxun:m005-0002","start":2,"end":4,"surface":"騶子","kind":"person","person_id":"k22_9pd_uu4","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m005-0011","start":11,"end":13,"surface":"惠王","kind":"person","person_id":"nvv_s6a_cve","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m005-0025","start":25,"end":28,"surface":"平原君","kind":"person","person_id":"i02_muu_r2s","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m005-0036","start":36,"end":38,"surface":"昭王","kind":"person","person_id":"pic_g3r_frm","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m005-0080","start":80,"end":82,"surface":"仲尼","kind":"person","person_id":"nu5_o75_tzs","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m005-0087","start":87,"end":89,"surface":"孟軻","kind":"person","person_id":"1h5_8jc_qp7","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m005-0098","start":98,"end":100,"surface":"武王","kind":"person","person_id":"gnt_6z9_vud","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m005-0104","start":104,"end":105,"surface":"紂","kind":"person","person_id":"5sx_o5n_zj6","sta