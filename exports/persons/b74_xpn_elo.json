ed_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-112-pingjin:m015-0034","start":34,"end":36,"surface":"陳涉","kind":"person","person_id":"b74_xpn_elo","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p015","chapter_id":"c-shiji-112-pingjin"},{"id":"c-shiji-112-pingjin:m015-0138","start":138,"end":140,"surface":"陳涉","kind":"person","person_id":"b74_xpn_elo","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p015","chapter_id":"c-shiji-112-pingjin"},{"id":"c-shiji-112-pingjin:m015-0252","start":252,"end":254,"surface":"陳涉","kind":"person","person_id":"b74_xpn_elo","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p015","chapter_id":"c-shiji-112-pingjin"},{"id":"c-shiji-112-pingjin:m015-0332","start":332,"end":334,"surface":"陳涉","kind":"person","person_id":"b74_xpn_elo","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p015","chapter_id":"c-shiji-112-pingjin"},{"id":"c-shiji-112-pingjin:m019-0339","start":339,"end":341,"surface":"陳勝","kind":"person","person_id":"b74_xpn_elo","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p019","chapter_id":"c-shiji-112-pingjin"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-112-pingjin:p015","text":"臣聞天下之患在於土崩，不在於瓦解，古今一也。何謂土崩？秦之末世是也。陳涉無千乘之尊，尺土之地，身非王公大人名族之后，無鄉曲之譽，非有孔、墨、曾子之賢，陶朱、猗頓之富也，然起窮巷，奮棘矜，偏袒大呼而天下從風，此其故何也？由民困而主不恤，下怨而上不知（也），俗已亂而政不修，此三者陳涉之所以為資也。是之謂土崩。故曰天下之患在於土崩。何謂瓦解？吳、楚、齊、趙之兵是也。七國謀為大逆，號皆稱萬乘之君，帶甲數十萬，威足以嚴其境內，財足以勸其士民，然不能西攘尺寸之地而身為禽於中原者，此其故何也？非權輕於匹夫而兵弱於陳涉也，當是之時，先帝之德澤未衰而安土樂俗之民眾，故諸侯無境外之助。此之謂瓦解，故曰天下之患不在瓦解。由是觀之，天下誠有土崩之勢，雖布衣窮處之士或首惡而危海內，陳涉是也。況三晉之君或存乎！天下雖未有大治也，誠能無土崩之勢，雖有彊國勁兵不得旋踵而身為禽矣，吳、楚、齊、趙是也。況群臣百姓能為亂乎哉！此二體者，安危之明要也，賢主所留意而深察也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-112-pingjin:m015-0034","start":34,"end":36,"surface":"陳涉","kind":"person","person_id":"b74_xpn_elo","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0066","start":66,"end":67,"surface":"孔","kind":"person","person_id":"wsh_uzd_aj3","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0068","start":68,"end":69,"surface":"墨","kind":"person","person_id":"lni_lzq_7s0","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0070","start":70,"end":72,"surface":"曾子","kind":"person","person_id":"zvp_ubd_334","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0075","start":75,"end":77,"surface":"陶朱","kind":"person","person_id":"2n9_bsn_ad1","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0078","start":78,"end":80,"surface":"猗頓","kind":"person","person_id":"3r9_0to_we7","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0138","start":138,"end":140,"surface":"陳涉","kind":"person","person_id":"b74_xpn_elo","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0181","start":181,"end":183,"surface":"七國","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-112-pingjin:m015-0252","start":252,"end":254,"surface":"陳涉","kind":"person","person_id":"b74_xpn_elo","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0261","start":261,"end":263,"surface":"先帝","kind":"person","person_id":"moo_r04_tz1","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0332","start":332,"end":334,"surface":"陳涉","kind":"person","person_id":"b74_xpn_elo","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0338","start":338,"end":342,"surface":"三晉之君","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-112-pingjin","book_id":"b-shiji-112","work_id":"w-shiji","source_id":"s-shiji112-pingjin"},{"id":"c-shiji-112-pingjin:p019","text":"及至秦王，蠶食天下，并吞戰國，稱號曰皇帝，主海內之政，壞諸侯之城，銷其兵，鑄以為鐘虡，示不復用。元元黎民得免於戰國，逢明天子，人人自以為更生。向使秦緩其刑罰，薄賦斂，省繇役，貴仁義，賤權利，上篤厚，下智巧，變風易俗，化於海內，則世世必安矣。秦不行是風而修其故俗，為智巧權利者進，篤厚忠信者退；法嚴政峻，諂諛者眾，日聞其美，意廣心軼。欲肆威海外，乃使蒙恬將兵以北攻胡，辟地進境，戍於北河，蜚芻芻粟以隨其后。又使尉[佗]屠睢將樓船之士南攻百越，使監祿鑿渠運糧，深入越，越人遁逃。曠日持久，糧食絕乏，越人擊之，秦兵大敗。秦乃使尉佗將卒以戍越。當是時，秦禍北構於胡，南掛於越，宿兵無用之地，進而不得退。行十餘年，丁男被甲，丁女轉輸，苦不聊生，自經於道樹，死者相望。及秦皇帝崩，天下大叛。陳勝、吳廣舉陳，武臣、張耳舉趙，項梁舉吳，田儋舉齊，景駒舉郢，周市舉魏，韓廣舉燕，窮山通谷豪士并起，不可勝載也。然皆非公侯之后，非長官之吏也。無尺寸之勢，起閭巷，杖棘矜，應時而皆動，不謀而俱起，不約而同會，壤長地進，至于霸王，時教使然也。秦貴為天子，富有天下，滅世絕祀者，窮兵之禍也。故周失之弱，秦失之彊，不變之患也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-112-pingjin:m019-0002","start":2,"end":4,"surface":"秦王","kind":"person","person_id":"ny0_svo_ifn","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m019-0059","start":59,"end":62,"surface":"明天子","kind":"person","person_id":"ny0_svo_ifn","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m019-0174","start":174,"end":176,"surface":"蒙恬","kind":"person","person_id":"8kz_4ad_0fq","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m019-0204","start":204,"end":208,"surface":"尉[佗]","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-112-pingjin:m019-0208","start":208,"end":210,"surface":"屠睢","kind":"person","person_id":"5ep_xih_trk","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m019-0221","start":221,"end":223,"surface":"監祿","kind":"person","person_id":"a1r_v0c_ghw","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m019-0260","start":260,"end":262,"surface":"尉佗","kind":"person","person_id":"qig_axh_3z6","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m019-0329","start":329,"end":332,"surface":"秦皇帝","kind":"person","person_id":"ny0_svo_ifn","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m019-0339","start":339,"end":341,"surface":"陳勝","kind":"person","person_id":"b74_xpn_elo","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m019-