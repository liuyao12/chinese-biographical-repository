[],"passages":[{"id":"c-jinshu-035-peikai-family:p016","text":"楷長兄黎，次兄康，並知名。康子盾，少曆顯位。永嘉中，為徐州刺史，委任長史司馬奧。奧勸盾刑殺立威，大發良人為兵，有不奉法者罪便至死。在任三年，百姓嗟怨。東海王越，盾妹夫也。越既薨，騎督滿衡便引所發良人東還。尋而劉元海遣將王桑、趙固向彭城，前鋒數騎至下邳，文武不堪苛政，悉皆散走，盾、奧奔淮陰，妻子為賊人所得。奧又誘盾降趙固。固妻盾女，有寵，盾向女涕泣，固遂殺之。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-035-peikai-family:p016:m0000","start":0,"end":1,"surface":"楷","kind":"person","person_id":"530_f9d_4bd","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p016:m0003","start":3,"end":4,"surface":"黎","kind":"person","person_id":"2vl_svq_ynl","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p016:m0007","start":7,"end":8,"surface":"康","kind":"person","person_id":"y8f_xr3_osd","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p016:m0013","start":13,"end":14,"surface":"康","kind":"person","person_id":"y8f_xr3_osd","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p016:m0015","start":15,"end":16,"surface":"盾","kind":"person","person_id":"gul_dv0_595","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p016:m0036","start":36,"end":39,"surface":"司馬奧","kind":"person","person_id":"xbg_ioy_mi3","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p016:m0040","start":40,"end":41,"surface":"奧","kind":"person","person_id":"xbg_ioy_mi3","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p016:m0042","start":42,"end":43,"surface":"盾","kind":"person","person_id":"gul_dv0_595","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p016:m0075","start":75,"end":79,"surface":"東海王越","kind":"person","person_id":"9o2_vhv_r7y","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p016:m0080","start":80,"end":81,"surface":"盾","kind":"person","person_id":"gul_dv0_595","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p016:m0081","start":81,"end":82,"surface":"妹","kind":"person","person_id":