-095-fankuang:m014-0113","start":113,"end":114,"surface":"寄","kind":"person","person_id":"bni_7nd_jnt_B","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m014-0120","start":120,"end":122,"surface":"酈況","kind":"person","person_id":"bni_7nd_jnt_B","status":"contextual_provisional"}],"chapter_id":"c-shiji-095-fankuang","book_id":"b-shiji-095","work_id":"w-shiji","source_id":"s-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:p021","text":"嬰自上初起沛，常為太僕，竟高祖崩。以太僕事孝惠。孝惠帝及高后德嬰之脫孝惠、魯元於下邑之閒也，乃賜嬰縣北第第一，曰「近我」，以尊異之。孝惠帝崩，以太僕事高后。高后崩，代王之來，嬰以太僕與東牟侯入清宮，廢少帝，以天子法駕迎代王代邸，與大臣共立為孝文皇帝，復為太僕。八歲卒，謚為文侯。子夷侯灶立，七年卒。子共侯賜立，三十一年卒。子侯頗尚平陽公主。立十九歲，元鼎二年，坐與父御婢姦罪，自殺，國除。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m021-0000","start":0,"end":1,"surface":"嬰","kind":"person","person_id":"e9l_7dr_a7o","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0013","start":13,"end":15,"surface":"高祖","kind":"person","person_id":"vok_rjp_tag","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0021","start":21,"end":23,"surface":"孝惠","kind":"person","person_id":"2u6_7bk_902","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0024","start":24,"end":27,"surface":"孝惠帝","kind":"person","person_id":"2u6_7bk_902","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0028","start":28,"end":30,"surface":"高后","kind":"person","person_id":"mrj_1jl_2tk","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0031","start":31,"end":32,"surface":"嬰","kind":"person","person_id":"e9l_7dr_a7o","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0034","start":34,"end":36,"surface":"孝惠","kind":"person","person_id":"2u6_7bk_902","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0037","start":37,"end":39,"surface":"魯元","kind":"person","person_id":"kki_4ee_3i7","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0048","start":48,"end":49,"surface":"嬰","kind":"person","person_id":"e9l_7dr_a7o","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0066","start":66,"end":69,"surface":"孝惠帝","kind":"person","person_id":"2u6_7bk_902","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0075","start":75,"end":77,"surface":"高后","kind":"person","person_id":"mrj_1jl_2tk","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0078","start":78,"end":80,"surface":"高后","kind":"person","person_id":"mrj_1jl_2tk","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0082","start":82,"end":84,"surface":"代王","kind":"person","person_id":"gp2_6ib_1za","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0087","start":87,"end":88,"surface":"嬰","kind":"person","person_id":"e9l_7dr_a7o","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0092","start":92,"end":95,"surface":"東牟侯","kind":"person","person_id":"lui_r6i_tzm","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0100","start":100,"end":102,"surface":"少帝","kind":"person","person_id":"mcx_uqw_9lx","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0109","start":109,"end":111,"surface":"代王","kind":"person","person_id":"gp2_6ib_1za","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0120","start":120,"end":124,"surface":"孝文皇帝","kind":"person","person_id":"gp2_6ib_1za","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0142","start":142,"end":143,"surface":"灶","kind":"person","person_id":"e9l_7dr_a7o_A","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0152","start":152,"end":154,"surface":"賜立","kind":"person","person_id":"e9l_7dr_a7o_AA","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0163","start":163,"end":164,"surface":"頗","kind":"person","person_id":"e9l_7dr_a7o_AAA","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0165","start":165,"end":169,"surface":"平陽公主","kind":"person","person_id":"921_w24_4mr","status":"contextual_provisional"}],"chapter_id":"c-shiji-095-fankuang","book_id":"b-shiji-095","work_id":"w-shiji","source_id":"s-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:p032","text":"嬰自破布歸，高帝崩，嬰以列侯事孝惠帝及呂太后。太后崩，呂祿等以趙王自置為將軍，軍長安，為亂。齊哀王聞之，舉兵西，且入誅不當為王者。上將軍呂祿等聞之，乃遣嬰為大將，將軍往擊之。嬰行至滎陽，乃與絳侯等謀，因屯兵滎陽，風齊王以誅呂氏事，齊兵止不前。絳侯等既誅諸呂，齊王罷兵歸，嬰亦罷兵自滎陽歸，與絳侯、陳平共立代王為孝文皇帝。孝文皇帝於是益封嬰三千戶，賜黃金千斤，拜為太尉。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m032-0000","start":0,"end":1,"surface":"嬰","kind":"person","person_id":"mdl_l60_pwy","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m032-0003","start":3,"end":4,"surface":"布","kind":"person","person_id":"664_wah_z4z","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m032-0006","start":6,"end":8,"surface":"高帝","kind":"person","person_id":"vok_rjp_tag","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m032-0010","start":10,"end":11,"surface":"嬰","kind":"person","person_id":"mdl_l60_pwy","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m032-0015","start":15,"end":18,"surface":"孝惠帝","kind":"person","person_id":"2u6_7bk_902","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m032-0019","start":19,"end":22,"surface":"呂太后","kind":"person","person_id":"mrj_1jl_2tk","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m032-0023","start":23,"end":25,"surface":"太后","kind":"person","person_id":"mrj_1jl_2tk","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m032-0027","start":27,"end":29,"surface":"呂祿","kind":"person","person_id":"699_ven_lj5","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m032-0046","start":46,"end":49,"surface":"齊哀王","kind":"person","person_id":"ybw_usv_89e","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m032-0068","start":68,"end":70,"surface":"呂祿","kind":"person","person_id":"699_ven_lj5","status"