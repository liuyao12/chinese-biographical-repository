,5585,5586,5587,5588,5589,5590,5591,5592,5593,5594,5595,5596,5597,5598,5599,5600,5601,5602,5603,5604,5605,5606,5607,5608,5609,5610,5611,5612,5613,5614,5615,5616,5617,5618,5619,5620,5621,5622,5623,5624,5625,5626,5627,5628,5629,5630,5631,5632,5633,5634,5635,5636,5637,5638,5639,5640,5641,5642],"first_line":90,"last_line":90,"revision_id":2603570,"projection_sha256":"1f9169323e5d6d57c3caec6ee773f337f37e2856d05d60810d763ba9e49305a6","source_layer":"received_biography","editorial_subsection":"羲之子 徽之","quotation_block_markup":false},"chapter_id":"c-jinshu-080-wangxizhi","book_id":"b-jinshu-080","work_id":"w-jinshu","source_id":"s-jinshu-080-ws2603570-wangxizhi"},{"id":"c-jinshu-080-wangxizhi:p038","text":"時吳中一士大夫家有好竹，欲觀之，便出坐輿造竹下，諷嘯良久。主人灑掃請坐，徽之不顧。將出，主人乃閉門，徽之便以此賞之，盡歎而去。嘗寄居空宅中，便令種竹。或問其故，徽之但嘯詠，指竹曰：「何可一日無此君邪！」嘗居山陰，夜雪初霽，月色清朗，四望皓然，獨酌酒詠左思《招隱詩》，忽憶戴逵。逵時在剡，便夜乘小船詣之，經宿方至，造門不前而反。人問其故，徽之曰：「本乘興而行，興盡而反，何必見安道邪！」雅性放誕，好聲色，嘗夜與弟獻之共讀《高士傳贊》，獻之賞井丹高潔，徽之曰：「未若長卿慢世也。」其傲達若此。時人皆欽其才而穢其行。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-080-wangxizhi:p038:m0003","start":3,"end":7,"surface":"一士大夫","kind":"person","person_id":"hqa_t8u_ym9","status":"contextual_provisional","resolution_note":"依完整傳/附敘之敘事、引語發受話人與逐項身份覆核；非全域同字匹配。"},{"id":"c-jinshu-080-wangxizhi:p038:m0029","start":29,"end":31,"surface":"主人","kind":"person","person_id":"hqa_t8u_ym9","status":"contextual_provisional","resolution_note":"依完整傳/附敘之敘事、引語發受話人與逐項身份覆核；非全域同字匹配。"},{"id":"c-jinshu-080-wangxizhi:p038:m0036","start":36,"end":38,"surface":"徽之","kind":"person","person_id":"h6m_eaq_gv4","status":"contextual_provisional","resolution_note":"依完整傳/附敘之敘事、引語發受話人與逐項身份覆核；非全域同字匹配。"},{"id":"c-jinshu-080-wangxizhi:p038:m0044","start":44,"end":46,"surface":"主人","kind":"person","person_id":"hqa_t8u_ym9","status":"contextual_provisional","resolution_note":"依完整傳/附敘之敘事、引語發受話人與逐項身份覆核；非全域同字匹配。"},{"id":"c-jinshu-080-wangxizhi:p038:m0050","start":50,"end":52,"surface":"徽之","kind":"person","person_id":"h6m_e