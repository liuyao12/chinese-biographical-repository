gs":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-080-wangxizhi:p037","text":"徽之字子猷。性卓犖不羈，為大司馬桓溫參軍，蓬首散帶，不綜府事。又為車騎桓沖騎兵參軍，沖問：「卿署何曹？」對曰：「似是馬曹。」又問：「管幾馬？」曰：「不知馬，何由知數！」又問：「馬比死多少？」曰：「未知生，焉知死！」嘗從沖行，值暴雨，徽之因下馬排入車中，謂曰：「公豈得獨擅一車！」沖嘗謂徽之曰：「卿在府日久，比當相料理。」徽之初不酬答，直高視，以手版柱頰云：「西山朝來致有爽氣耳。」","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-080-wangxizhi:p037:m0000","start":0,"end":2,"surface":"徽之","kind":"person","person_id":"h6m_eaq_gv4","status":"contextual_provisional","resolution_note":"依完整傳/附敘之敘事、引語發受話人與逐項身份覆核；非全域同字匹配。"},{"id":"c-jinshu-080-wangxizhi:p037:m0003","start":3,"end":5,"surface":"子猷","kind":"person","person_id":"h6m_eaq_gv4","status":"contextual_provisional","resolution_note":"依完整傳/附敘之敘事、引語發受話人與逐項身份覆核；非全域同字匹配。"},{"id":"c-jinshu-080-wangxizhi:p037:m0016","start":16,"end":18,"surface":"桓溫","kind":"person","person_id":"u9s_w6j_8mc_AA","status":"contextual_provisional","resolution_note":"依完整傳/附敘之敘事、引語發受話人與逐項身份覆核；非全域同字匹配。"},{"id":"c-jinshu-080-wangxizhi:p037:m0035","start":35,"end":37,"surface":"桓沖","kind":"person","person_id":"u9s_w6j_8mc_AE","status":"contextual_provisional","resolution_note":"依完整傳/附敘之敘事、引語發受話人與逐項身份覆核；非全域同字匹配。"},{"id":"c-jinshu-080-wangxizhi:p037:m0042","start":42,"end":43,"surface":"沖","kind":"person","person_id":"u9s_w6j_8mc_AE","status":"contextual_provisional","resolution_note":"依完整傳/附敘之敘事、引語發受話人與逐項身份覆核；非全域同字匹配。"},{"id":"c-jinshu-080-wangxizhi:p037:m0046","start":46,"end":47,"surface":"卿","kind":"person","person_id":"h6m_eaq_gv4","status":"contextual_provisional","resolution_note":"依完整傳/附敘之敘事、引語發受話人與逐項身份覆核；非全域同字匹配。"},{"id":"c-jinshu-080-wangxizhi:p037:m0109","start":109,"end":110,"surface":"沖","kind":"person","person_id":"u9s_w6j_8mc_AE","status":"contextual_provisional","resolution_note":"依完整傳/附敘之敘事、引語發受話人與逐項身份覆核；非全域同字匹配。"}