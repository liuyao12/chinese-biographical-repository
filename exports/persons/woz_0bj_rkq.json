t_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-042-jiangshi-complete:p003:m0101","start":101,"end":104,"surface":"王洪範","kind":"person","person_id":"woz_0bj_rkq","status":"contextual_provisional","paragraph_id":"c-nanqishu-042-jiangshi-complete:p003","chapter_id":"c-nanqishu-042-jiangshi-complete"},{"id":"c-nanqishu-042-jiangshi-complete:p003:m0132","start":132,"end":134,"surface":"洪範","kind":"person","person_id":"woz_0bj_rkq","status":"contextual_provisional","paragraph_id":"c-nanqishu-042-jiangshi-complete:p003","chapter_id":"c-nanqishu-042-jiangshi-complete"}],"relations":[],"title_holdings":[{"id":"th-nanqishu-042-jiangshi-complete-3-97","title":"晉壽太守","kind":"office","mode":"attestation","person_id":"woz_0bj_rkq","attestations":[{"id":"th-nanqishu-042-jiangshi-complete-3-97:a","paragraph_id":"c-nanqishu-042-jiangshi-complete:p003","start":97,"end":101,"surface":"晉壽太守","person_mention_id":"c-nanqishu-042-jiangshi-complete:p003:m0101","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-042","chapter_id":"c-nanqishu-042-jiangshi-complete","source_id":"s-nanqishu-042-jiangshi-complete-ws1507997","paragraph_id":"c-nanqishu-042-jiangshi-complete:p003","quote":"　　高宗輔政，委以心腹。隆昌元年，自正員郎補丹陽丞，中書郎。高宗爲驃騎，鎮東府，以祏爲諮議參軍，領南平昌太守，與蕭誄對直東府省內。時新立海陵，人情未服，高宗胛上有赤誌，常祕不傳，祏勸帝出以示人。晉壽太守王洪範罷任還，上袒示之，曰：「人皆謂此是日月相。卿幸無泄言。」洪範曰：「公日月之相在軀，如何可隱。轉當言之公卿。」上大悅。會直後張伯、尹瓚等屢謀竊發，祏、誄憂虞無計，每夕輙託事外出。及入纂議定，加祏寧朔將軍。高宗爲宣城王，太史密奏圖緯云「一號當得十四年」。祏入，帝喜以示祏曰：「得此復何所望。」及卽位，遷守衞尉，將軍如故。封安陸縣侯，邑千戶。祏祖遵，以后父贈金紫光祿大夫；父德隣，以帝舅亦贈光祿大夫。","person_mention_id":"c-nanqishu-042-jiangshi-complete:p003:m0101"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-042-jiangshi-complete:p003","text":"　　高宗輔政，委以心腹。隆昌元年，自正員郎補丹陽丞，中書郎。高宗爲驃騎，鎮東府，以祏爲諮議參軍，領南平昌太守，與蕭誄對直東府省內。時新立海陵，人情未服，高宗胛上有赤誌，常祕不傳，祏勸帝出以示人。晉壽太守王洪範罷任還，上袒示之，曰：「人皆謂此是日月相。卿幸無泄言。」洪範曰：「公日月之相在軀，如何可隱。轉當言之公卿。」上大悅。會直後張伯、尹瓚等屢謀竊發，祏、誄憂虞無計，每夕輙託事外出。及入纂議定，加祏寧朔將軍。高宗爲宣城王，太史密奏圖緯云「一號當得十四年」。祏入，帝喜以示祏曰：「得此復何所望。」及卽位，遷守衞尉，將軍如故。封安陸縣侯，邑千戶。祏祖遵，以后父贈金紫光祿大夫；父德隣，以帝舅亦贈光祿大夫。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":72,"last_line":72,"raw_start":4847,"raw_end":5155,"raw_character_offsets":[4847,4848,4849,4850,4851,4852,4853,4854,4855,4856,4857,4858,4864,4865,4866,4867,4870,4871,4872,4873,4874,4875,4876,4877,4878,4879,4880,4881,4882,4883,4884,4885,4886,4887,4888,4889,4890,4891,4892,4893,4894,4895,4896,4897,4898,4899,4900,4901,4902,4903,4904,4905,4906,4907,4908,4909,4910,4911,4912,4913,4914,4915,4916,4917,4918,4919,4920,4921,4922,4923,4924,4925,4926,4927,4928,4929,4930,4931,4932,4933,4934,4935,4936,4937,4938,4939,4940,4941,4942,4943,4944,4945,4946,4947,4948,4949,4950,4951,4952,4953,4954,4955,4956,4957,4958,4959,4960,4961,4962,4963,4964,4965,4966,4967,4968,4969,4970,4971,4972,4973,4974,4975,4976,4977,4978,4979,4980,4981,4982,4983,4984,4985,4986,4987,4988,4989,4990,4991,4992,4993,4994,4995,4996,4997,4998,4999,5000,5001,5002,5003,5004,5005,5006,5007,5008,5009,5010,5011,5012,5