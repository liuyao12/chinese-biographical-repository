ong:m039-0036","start":36,"end":37,"surface":"餘","kind":"person","person_id":"yqp_nlb_p1p_ACAL","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m039-0041","start":41,"end":42,"surface":"端","kind":"person","person_id":"yqp_nlb_p1p_ACAN","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m039-0066","start":66,"end":69,"surface":"仁賢者","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、未名皇帝或未定指代；不補未見姓名、親屬成員或確定身份。"},{"id":"c-shiji-059-wuzong:m039-0071","start":71,"end":72,"surface":"浡","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、未名皇帝或未定指代；不補未見姓名、親屬成員或確定身份。"},{"id":"c-shiji-059-wuzong:m039-0076","start":76,"end":78,"surface":"兒姁","kind":"person","person_id":"lbj_a32_053","status":"contextual_provisional"}],"chapter_id":"c-shiji-059-wuzong","book_id":"b-shiji-059","work_id":"w-shiji","source_id":"s-shiji-059-wuzong"},{"id":"c-shiji-130-taishigong:p061","text":"成皋之臺，薄氏始基。詘意適代，厥崇諸竇。栗姬偩貴，王氏乃遂。陳後太驕，卒尊子夫。嘉夫德若斯，作外戚世家十九。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m061-0005","start":5,"end":7,"surface":"薄氏","kind":"person","person_id":"9zj_vf7_86a_A","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m061-0017","start":17,"end":19,"surface":"諸竇","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-130-taishigong:m061-0020","start":20,"end":22,"surface":"栗姬","kind":"person","person_id":"6zy_q58_1rh","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m061-0025","start":25,"end":27,"surface":"王氏","kind":"person","person_id":"6d6_eg1_o3a_A","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m061-0030","start":30,"end":32,"surface":"陳後","kind":"person","person_id":"mj4_uma_km7","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m061-0037","start":37,"end":39,"surface":"子夫","kind":"person","person_id":"l5c_h8i_d5q","status":"contextual_provisional"}],"chapter_i