"},{"id":"c-shiji-059-wuzong:m001-0013","start":13,"end":16,"surface":"母五人","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、未名皇帝或未定指代；不補未見姓名、親屬成員或確定身份。"},{"id":"c-shiji-059-wuzong:m001-0024","start":24,"end":26,"surface":"栗姬","kind":"person","person_id":"6zy_q58_1rh","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m001-0028","start":28,"end":29,"surface":"榮","kind":"person","person_id":"yqp_nlb_p1p_ACAH","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m001-0030","start":30,"end":31,"surface":"德","kind":"person","person_id":"yqp_nlb_p1p_ACAB","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m001-0032","start":32,"end":34,"surface":"閼于","kind":"person","person_id":"yqp_nlb_p1p_ACAC","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m001-0035","start":35,"end":37,"surface":"程姬","kind":"person","person_id":"dlu_57f_6uq","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m001-0039","start":39,"end":40,"surface":"餘","kind":"person","person_id":"yqp_nlb_p1p_ACAL","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m001-0041","start":41,"end":42,"surface":"非","kind":"person","person_id":"yqp_nlb_p1p_ACAK","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m001-0043","start":43,"end":44,"surface":"端","kind":"person","person_id":"yqp_nlb_p1p_ACAN","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m001-0045","start":45,"end":48,"surface":"賈夫人","kind":"person","person_id":"lyq_p1r_87n","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m001-0050","start":50,"end":52,"surface":"彭祖","kind":"person","person_id":"yqp_nlb_p1p_ACAF","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m001-0053","start":53,"end":54,"surface":"勝","kind":"person","person_id":"yqp_nlb_p1p_ACAI","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m001-0055","start":55,"end":57,"surface":"唐姬","kind":"person","person_id":"vg4_1z7_894","status":"contextual_provis