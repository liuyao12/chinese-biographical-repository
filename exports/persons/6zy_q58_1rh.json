contextual_provisional"}],"chapter_id":"c-shiji-049-waiqi","book_id":"b-shiji-049","work_id":"w-shiji","source_id":"s-shiji-049-waiqi"},{"id":"c-shiji-049-waiqi:p022","text":"長公主日譽王夫人男之美，景帝亦賢之，又有曩者所夢日符，計未有所定。王夫人知帝望栗姬，因怒未解，陰使人趣大臣立栗姬為皇后。大行奏事畢，曰：「『子以母貴，母以子貴』，今太子母無號，宜立為皇后。」景帝怒曰：「是而所宜言邪！」遂案誅大行，而廢太子為臨江王。栗姬愈恚恨，不得見，以憂死。卒立王夫人為皇后，其男為太子，封皇后兄信為蓋侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-049-waiqi:m022-0000","start":0,"end":3,"surface":"長公主","kind":"person","person_id":"yqp_nlb_p1p_ACF","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m022-0005","start":5,"end":8,"surface":"王夫人","kind":"person","person_id":"6d6_eg1_o3a_A","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m022-0012","start":12,"end":14,"surface":"景帝","kind":"person","person_id":"yqp_nlb_p1p_ACA","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m022-0033","start":33,"end":36,"surface":"王夫人","kind":"person","person_id":"6d6_eg1_o3a_A","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m022-0039","start":39,"end":41,"surface":"栗姬","kind":"person","person_id":"6zy_q58_1rh","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m022-0054","start":54,"end":56,"surface":"栗姬","kind":"person","person_id":"6zy_q58_1rh","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m022-0060","start":60,"end":62,"surface":"大行","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、集體、制度稱號或待核短稱；不補姓名或年表。"},{"id":"c-shiji-049-waiqi:m022-0082","start":82,"end":84,"surface":"太子","kind":"person","person_id":"yqp_nlb_p1p_ACAH","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m022-0095","start":95,"end":97,"surface":"景帝","kind":"person","person_id":"yqp_nlb_p1p_ACA","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m022-0112","start":112,"end":114,"surface":"大行","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、集體、制度稱號或待核短稱；不補姓名或年表。"},{"id":"c-shiji-049-waiqi:m022-0