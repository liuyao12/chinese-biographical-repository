01-wudi:m024-0577","start":577,"end":578,"surface":"龍","kind":"person","person_id":"rjb_0hy_dsi","status":"source_identified"},{"id":"c-shiji-001-wudi:m024-0609","start":609,"end":610,"surface":"舜","kind":"person","person_id":"ddb_l4j_4j2","status":"source_identified"},{"id":"c-shiji-001-wudi:m024-0652","start":652,"end":654,"surface":"三苗","kind":"unresolved","person_id":null,"status":"unresolved","note":"可能為個人、官職、群體、氏族或國號；不憑本篇未明示的外部對應補造身份。"}],"annotation_status":"in_progress","chapter_id":"c-shiji-001-wudi","book_id":"b-shiji-001","work_id":"w-shiji","source_id":"s-shiji-001-wudi"},{"id":"c-shiji-002-xia:p025","text":"於是夔行樂，祖考至，羣后相讓，鳥獸翔舞，簫韶九成，鳳皇來儀，百獸率舞，百官信諧。帝用此作歌曰：「陟天之命，維時維幾。」乃歌曰：「股肱喜哉，元首起哉，百工熙哉！」皋陶拜手稽首揚言曰：「念哉，率爲興事，慎乃憲，敬哉！」乃更爲歌曰：「元首明哉，股肱良哉，庶事康哉！」又歌曰：「元首叢脞哉，股肱惰哉，萬事墮哉！」帝拜曰：「然，往欽哉！」於是天下皆宗禹之明度數聲樂，爲山川神主。","mentions":[{"id":"c-shiji-002-xia:m025-0002","start":2,"end":3,"surface":"夔","kind":"person","person_id":"wfn_d71_zaw","status":"source_identified"},{"id":"c-shiji-002-xia:m025-0006","start":6,"end":8,"surface":"祖考","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、氏族、官職或未定指代；不推造個別姓名。"},{"id":"c-shiji-002-xia:m025-0040","start":40,"end":41,"surface":"帝","kind":"person","person_id":"ddb_l4j_4j2","status":"contextual_provisional","interpretation_note":"依本段與前後段的帝舜及對話敘事暫定為舜，非全篇所有「帝」的自動對應。"},{"id":"c-shiji-002-xia:m025-0080","start":80,"end":82,"surface":"皋陶","kind":"person","person_id":"p3l_pp3_n6i","status":"source_identified"},{"id":"c-shiji-002-xia:m025-0152","start":152,"end":153,"surface":"帝","kind":"person","person_id":"ddb_l4j_4j2","status":"contextual_provisional","interpretation_note":"依本段與前後段的帝舜及對話敘事暫定為舜，非全篇所有「帝」的自動對應。"},{"id":"c-shiji-002-xia:m025-0170","start":170,"end":171,"surface":"禹","kind":"person","person_id":"6ip_dr3_fbl","status":"source_identified"}],"annotation_status":"in_progress","chapter_id":"c-shiji-002-xia","book_id":"b-shiji-002","work_id":"w-shiji","source_id":"s-shiji-002-xia"},{"id":"c-shiji-036-chenqi:p030","text":"舜之後，周武王封之陳，至楚惠王滅之，有世家言。禹之後，周武王封之杞，楚惠王滅之，有世家言。契之後為殷，殷有本紀言。殷破，周封其後於宋，齊湣王滅之，有世家言。后稷之後為周，秦昭王滅之，有本紀言。皋陶之後，或封英、六，楚穆王滅之，無譜。伯夷之後，至周武王復封於齊，曰太公望，陳氏滅之，有世家言。伯翳之後，至周平王時封為秦，項羽滅之，有本紀言。垂、益、夔、龍，其後不知所封，不見也。右十一人者，皆唐虞之際名有功德臣也；其五人之後皆至帝王，餘乃為顯諸侯。滕、薛、騶，夏、殷、周之閒封也，小，不足齒列，弗論也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-036-chenqi:m030-0000","start":0,"end":1,"surface":"舜","kind":"person","person_id":"ddb_l4j_4j2","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m030-0004","start":4,"end":7,"surface":"周武王","kind":"person","person_id":"y4i_pjk_4gn_AA","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m030-0012","start":12,"end":15,"surface":"楚惠王","kind":"person","person_id":"bff_e4b_8yv","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m030-0023","start":23,"end":24,"surface":"禹","kind":"person","person_id":"6ip_dr3_fbl","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m030-0027","start":27,"end":30,"surface":"周武王","kind":"person","person_id":"y4i_pjk_4gn_AA","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m030-0034","start":34,"end":37,"surface":"楚惠王","kind":"person","person_id":"bff_e4b_8yv","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m030-0045","start":45,"end":46,"surface":"契","kind":"person","person_id":"ea8_yum_lvj","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m030-0067","start":67,"end":70,"surface":"齊湣王","kind":"person","person_id":"zpv_ei1_hhy","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m030-0078","start":78,"end":80,"surface":"后稷","kind":"person","person_id":"jqy_1fv_u7v","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m030-0085","start":85,"end":88,"surface":"秦昭王","kind":"person","person_id":"ao3_0fy_d45","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m030-0096","start":96,"end":98,"surface":"皋陶","kind":"person","person_id":"p3l_pp3_n6i","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m030