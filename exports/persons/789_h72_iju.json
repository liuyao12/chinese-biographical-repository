ngs":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-130-taishigong:p019","text":"秦失其道，豪桀并擾；項梁業之，子羽接之；殺慶救趙，諸侯立之；誅嬰背懷，天下非之。作項羽本紀第七。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m019-0010","start":10,"end":12,"surface":"項梁","kind":"person","person_id":"ral_wzb_i85","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m019-0015","start":15,"end":17,"surface":"子羽","kind":"person","person_id":"789_h72_iju","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m019-0021","start":21,"end":22,"surface":"慶","kind":"person","person_id":"352_9gz_u46","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m019-0031","start":31,"end":32,"surface":"嬰","kind":"person","person_id":"3nf_ycv_rto","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m019-0033","start":33,"end":34,"surface":"懷","kind":"person","person_id":"utx_gsk_11a","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m019-0041","start":41,"end":43,"surface":"項羽","kind":"person","person_id":"789_h72_iju","status":"contextual_provisional"}],"chapter_id":"c-shiji-130-taishigong","book_id":"b-shiji-130","work_id":"w-shiji","source_id":"s-shiji130-taishigong"},{"id":"c-shiji-130-taishigong:p020","text":"子羽暴虐，漢行功德；憤發蜀漢，還定三秦；誅籍業帝，天下惟寧，改制易俗。作高祖本紀第八。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m020-0000","start":0,"end":2,"surface":"子羽","kind":"person","person_id":"789_h72_iju","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m020-0021","start":21,"end":22,"surface":"籍","kind":"person","person_id":"789_h72_iju","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m020-0036","start":36,"end":38,"surface":"高祖","kind":"person","person_id":"c34_m74_tgb","status":"contextual_provisional"}],"chapter_id":"c-shiji-130-taishigong","book_id":"b-shiji-130","work_id":"w-shiji","source_id":"s-shiji130-taishigong"},{"id":"c-shiji-130-taishigong:p102","text":"收西河、上黨之兵，從至彭城；越之侵掠梁地以苦項羽。作魏豹彭越列傳第三十。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m102-0014","start":14,"end":15,"surface":"越","kind":"person","person_id":"r1m_zuy_q06","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m102-0022","start":22,"end":24,"surface":"項羽","kind":"person","person_id":"789_h72_iju","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m102-0026","start":26,"end":28,"surface":"魏豹","kind":"person","person_id":"iu1_rte_fj1","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m102-0028","start":28,"end":30,"surface":"彭越","kind":"person","person_id":"r1m_zuy_q06","status":"contextual_provisional"}],"chapter_id":"c-shiji-130-taishigong","book_id":"b-shiji-130","work_id":"w-shiji","source_id":"s-shiji130-taishigong"},{"id":"c-shiji-130-taishigong:p103","text":"以淮南叛楚歸漢，漢用得大司馬殷，卒破子羽于垓下。作黥布列傳第三十一。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m103-0011","start":11,"end":15,"surface":"大司馬殷","kind":"person","person_id":"8rz_6rw_rik","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m103-0018","start":18,"end":20,"surface":"子羽","kind":"person","person_id":"789_h72_iju","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m103-0025","start":25,"end":27,"surface":"黥布","kind":"person","person_id":"yb7_low_xpl","status":"contextual_provisional"}],"chapter_id":"c-shiji-130-taishigong","book_id":"b-shiji-130","work_id":"w-shiji","source_id":"s-shiji130-taishigong"},{"id":"c-shiji-130-taishigong:p104","text":"楚人迫我京索，而信拔魏趙，定燕齊，使漢三分天下有其二，以滅項籍。作淮陰侯列傳第三十二。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m104-0008","start":8,"end":9,"surface":"信","kind":"person","person_id":"2nx_tda_i4j","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m104-0029","start":29,"end":31,"surface":"項籍","kind":"person","person_id":"789_h72_iju","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m104-0033","start":33,"end":36,"surface":"淮陰侯","kind":"person","person_id":"2nx_tda_i4j","status":"contextual_provisional"}],"chapter_id":"c-shiji-130-taishigong","book_id":"b-shiji-130","work_id":"w-shiji","source_id":"s-shiji130-taishigong"},{"id":"c-shiji-130-taishigong:p105","text":"楚漢相距鞏洛，而韓信為填潁川，盧綰絕籍糧餉。作韓信盧綰列傳第三十三。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m105-0008","start":8,"end":10,"surface":"韓信","kind":"person","person_id":"g46_8kv_3i8","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m105-0015","start":15,"end":17,"surface":"盧綰","kind":"person","person_id":"ef3_dqb_tig","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m105-0018","start":18,"end":19,"surface":"籍","kind":"person","person_id":"789_h72_iju","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m105-0023","start":23,"end":25,"surface":"韓信","kind":"person","person_id":"g46_8kv_3i8","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m105-0025","start":25,"end":27,"surface":"盧綰","kind":"person","person_id":"ef3_dqb_tig","status":"contextual_provisional"}],"chapter_id":"c-shiji-130-taishigong","book_id":"b-shiji-130","work_id":"w-shiji","source_id":"s-shiji130-taishigong"},{"id":"c-shiji-130-taishigong:p106","text":"諸侯畔項王，唯齊連子羽城陽，漢得以閒遂入彭城。作田儋列傳第三十四。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m106-0003","start":3,"end":5,"surface":"項王","kind":"person","person_id":"789_h72_iju","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m106-0009","start":9,"end":11,"surface":"子羽","kind":"person","person_id":"789_h72_iju","status":"contextual_p