":"person","person_id":"cbr-p004363","status":"contextual_provisional","paragraph_id":"c-shiji-075-mengchang:p012","chapter_id":"c-shiji-075-mengchang"},{"id":"c-shiji-075-mengchang:m012-0063","start":63,"end":65,"surface":"呂禮","kind":"person","person_id":"cbr-p004363","status":"contextual_provisional","paragraph_id":"c-shiji-075-mengchang:p012","chapter_id":"c-shiji-075-mengchang"},{"id":"c-shiji-075-mengchang:m012-0170","start":170,"end":172,"surface":"呂禮","kind":"person","person_id":"cbr-p004363","status":"contextual_provisional","paragraph_id":"c-shiji-075-mengchang:p012","chapter_id":"c-shiji-075-mengchang"},{"id":"c-shiji-075-mengchang:m012-0194","start":194,"end":196,"surface":"呂禮","kind":"person","person_id":"cbr-p004363","status":"contextual_provisional","paragraph_id":"c-shiji-075-mengchang:p012","chapter_id":"c-shiji-075-mengchang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji075-034","person_id":"cbr-p004363","scope":"same_chapter","chapter_ids":["c-shiji-075-mengchang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"依局部敘事姓名、書信受話及回指暫接。第11段其後齊王限接前段齊湣王，馮驩初敘與復位故事中的齊秦兩王未自動接湣襄或昭王；內嵌秦王王君與外層孟嘗君君稱分辨。馮驩馮先生馮公與局部驩相配，馮軾與代舍非其人名。親弗、周最與原字保留，魏冉書信子稱按受話限定；孟嘗諸子不補個別子嗣。","surfaces":["呂禮"],"evidence":[{"paragraph_id":"c-shiji-075-mengchang:p011","quote":"其後，秦亡將呂禮相齊，欲困蘇代。代乃謂孟嘗君曰：「周最於齊，至厚也，而齊王逐之，而聽親弗相呂禮者，欲取秦也。齊、秦合，則親弗與呂禮重矣。有用，齊、秦必輕君。君不如急北兵，趨趙以和秦、魏，收周最以厚行，且反齊王之信，又禁天下之變。齊無秦，則天下集齊，親弗必走，則齊王孰與爲其國也！」於是孟嘗君從其計，而呂禮嫉害於孟嘗君。"},{"paragraph_id":"c-shiji-075-mengchang:p012","quote":"孟嘗君懼，乃遺秦相穰侯魏冉書曰：「吾聞秦欲以呂禮收齊，齊，天下之彊國也，子必輕矣。齊秦相取以臨三晉，呂禮必并相矣，是子通齊以重呂禮也。若齊免於天下之兵，其讎子必深矣。子不如勸秦王伐齊。齊破，吾請以所得封子。齊破，秦畏晉之彊，秦必重子以取晉。晉國敝於齊而畏秦，晉必重子以取秦。是子破齊以爲功，挾晉以爲重；是子破齊定封，秦、晉交重子。若齊不破，呂禮復用，子必大窮。」於是穰侯言於秦昭王伐齊，而呂禮亡。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-075-mengchang:p011","text":"其後，秦亡將呂禮相齊，欲困蘇代。代乃謂孟嘗君曰：「周最於齊，至厚也，而齊王逐之，而聽親弗相呂禮者，欲取秦也。齊、秦合，則親弗與呂禮重矣。有用，齊、秦必輕君。君不如急北兵，趨趙以和秦、魏，收周最以厚行，且反齊王之信，又禁天下之變。齊無秦，則天下集齊，親弗必走，則齊王孰與爲其國也！」於是孟嘗君從其計，而呂禮嫉害於孟嘗君。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-075-mengchang:m011-0006","start":6,"end":8,"surface":"呂禮","kind":"person","person_id":"cbr-p004363","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m011-0013","start":13,"end":15,"surface":"蘇代","kind":"person","person_id":"cbr-p004349","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m011-0016","start":16,"end":17,"surface":"代","kind":"person","person_id":"cbr-p004349","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m011-0019","start":19,"end":22,"surface":"孟嘗君","kind":"person","person_id":"cbr-p004330","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m011-0025","start":25,"end":27,"surface":"周最","kind":"person","person_id":"cbr-p004364","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m011-0035","start":35,"end":37,"surface":"齊王","kind":"person","person_id":"cbr-p004345","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m011-0042","start":42,"end":44,"surface":"親弗","kind":"person","person_id":"cbr-p004365","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m011-0045","start":45,"end":47,"surface":"呂禮","kind":"person","person_id":"cbr-p004363","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m011-0060","start":60,"end":62,"surface":"親弗","kind":"person","person_id":"cbr-p004365","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m011-0063","start":63,"end":65,"surface":"呂禮","kind":"person","person_id":"cbr-p004363","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m011-0076","start":76,"end":77,"surface":"君","kind":"person","person_id":"cbr-p004330","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m011-0078","start":78,"end":79,"surface":"君","kind":"person","person_id":"cbr-p004330","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang