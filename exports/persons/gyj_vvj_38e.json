"c-jinshu-070-liuchao:p001:m0041"}],"status":"source_attested","interpretation_note":"官與親屬同句，同名劉和分存。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-070-liuchao:p001:m0041","surface":"和","start":41,"end":42,"person_id":"gyj_vvj_38e","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-070-liuchao:p001","chapter_id":"c-jinshu-070-liuchao"}],"relations":[{"id":"a-jin070-liuhe-father","subject_person_id":"dha_hxh_mqj","object_person_id":"gyj_vvj_38e","predicate":"father","qualifiers":{"source_term":"父和，爲琅邪國上軍將軍"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-070","chapter_id":"c-jinshu-070-liuchao","source_id":"s-jinshu-070-liuchao-ws2595540","paragraph_id":"c-jinshu-070-liuchao:p001","quote":"劉超字世瑜，琅邪臨沂人，漢城陽景王章之後也。章七世孫封臨沂縣慈鄉侯，子孫因家焉。父和，爲琅邪國上軍將軍。超少有志尚，爲縣小吏，稍遷琅邪國記室掾。以忠謹清慎爲元帝所拔，恒親侍左右，遂從渡江，轉安東府舍人，專掌文檄。相府建，又爲舍人。于時天下擾亂，伐叛討貳，超自以職在近密，而書跡與帝手筆相類，乃絕不與人交書。時出休沐，閉門不通賓客，由是漸得親密。以左右勤勞，賜爵原鄉亭侯，食邑七百戶，轉行參軍。","subject_person_mention_id":"c-jinshu-070-liuchao:p001:m0000","object_person_mention_id":"c-jinshu-070-liuchao:p001:m0041"}],"status":"source_attested","interpretation_note":"官與親屬同句，同名劉和分存。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-070-liuchao:p001","text":"劉超字世瑜，琅邪臨沂人，漢城陽景王章之後也。章七世孫封臨沂縣慈鄉侯，子孫因家焉。父和，爲琅邪國上軍將軍。超少有志尚，爲縣小吏，稍遷琅邪國記室掾。以忠謹清慎爲元帝所拔，恒親侍左右，遂從渡江，轉安東府舍人，專掌文檄。相府建，又爲舍人。于時天下擾亂，伐叛討貳，超自以職在近密，而書跡與帝手筆相類，乃絕不與人交書。時出休沐，閉門不通賓客，由是漸得親密。以左右勤勞，賜爵原鄉亭侯，食邑七百戶，轉行參軍。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":100,"last_line":100,"raw_start":10241,"