id":"c-shiji-058-liang"},{"id":"c-shiji-058-liang:m010-0032","start":32,"end":35,"surface":"長公主","kind":"person","person_id":"kvm_6zv_6ez","status":"contextual_provisional","paragraph_id":"c-shiji-058-liang:p010","chapter_id":"c-shiji-058-liang"},{"id":"c-shiji-058-liang:m012-0073","start":73,"end":76,"surface":"長公主","kind":"person","person_id":"kvm_6zv_6ez","status":"contextual_provisional","paragraph_id":"c-shiji-058-liang:p012","chapter_id":"c-shiji-058-liang"}],"relations":[],"title_holdings":[{"id":"th-shiji058-024","person_id":"kvm_6zv_6ez","title":"長公主","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-058-liang","source_id":"s-shiji-058-liang","paragraph_id":"c-shiji-058-liang:p009","quote":"其夏四月，上立膠東王為太子。梁王怨袁盎及議臣，乃與羊勝、公孫詭之屬陰使人刺殺袁盎及他議臣十餘人。逐其賊，未得也。於是天子意梁王，逐賊，果梁使之。乃遣使冠蓋相望於道，覆按梁，捕公孫詭、羊勝。公孫詭、羊勝匿王後宮。使者責二千石急，梁相軒丘豹及內史韓安國進諫王，王乃令勝、詭皆自殺，出之。上由此怨望於梁王。梁王恐，乃使韓安國因長公主謝罪太后，然后得釋。"}],"attestations":[{"id":"th-shiji058-024:a001","paragraph_id":"c-shiji-058-liang:p009","start":160,"end":163,"surface":"長公主","person_mention_id":"c-shiji-058-liang:m009-0160","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授封、改封、敘事用稱與諡稱分存；相對年數及來源年號保留，不換算公曆，不從首次用稱或死亡補任期。未名群體不造個別官爵。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji058-019","person_id":"kvm_6zv_6ez","surfaces":["長公主"],"scope":"same_chapter","chapter_ids":["c-shiji-058-liang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-058-liang:p009","quote":"其夏四月，上立膠東王為太子。梁王怨袁盎及議臣，乃與羊勝、公孫詭之屬陰使人刺殺袁盎及他議臣十餘人。逐其賊，未得也。於是天子意梁王，逐賊，果梁使之。乃遣使冠蓋相望於道，覆按梁，捕公孫詭、羊勝。公孫詭、羊勝匿王後宮。使者責二千石急，梁相軒丘豹及內史韓安國進諫王，王乃令勝、詭皆自殺，出之。上由此怨望於梁王。梁王恐，乃使韓安國因長公主謝罪太后，然后得釋。"},{"paragraph_id":"c-shiji-058-liang:p010","quote":"上怒稍解，因上書請朝。既至關，茅蘭說王，使乘布車，從兩騎入，匿於長公主園。漢使使迎王，王已入關，車騎盡居外，不知王處。太后泣曰：「帝殺吾子！」景帝憂恐。於是梁王伏斧質於闕下，謝罪，然後太后、景帝大喜，相泣，復如故。悉召王從官入關。然景帝益疏王，不同車輦矣。"},{"paragraph_id":"c-shiji-058-liang:p012","quote":"孝王慈孝，每聞太后病，口不能食，居不安寢，常欲留長安侍太后。太后亦愛之。及聞梁王薨，竇太后哭極哀，不食，曰：「帝果殺吾子！」景帝哀懼，不知所為。與長公主計之，乃分梁為五國，盡立孝王男五人為王，女五人皆食湯沐邑。於是奏之太后，太后乃說，為帝加壹湌。"}],"rationale":"按明示姓名、世系與局部王號暫接。梁武、勝、參、登、義、買、襄等不按同王號合併；梁王勝與羊勝分辨。李太后陳太后分存；主張、指控、泛稱與授職分辨，正文與附述各保留。官爵全史與跨篇身份仍待覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-058-liang:p009","text":"其夏四月，上立膠東王為太子。梁王怨袁盎及議臣，乃與羊勝、公孫詭之屬陰使人刺殺袁盎及他議臣十餘人。逐其賊，未得也。於是天子意梁王，逐賊，果梁使之。乃遣使冠蓋相望於道，覆按梁，捕公孫詭、羊勝。公孫詭、羊勝匿王後宮。使者責二千石急，梁相軒丘豹及內史韓安國進諫王，王乃令勝、詭皆自殺，出之。上由此怨望於梁王。梁王恐，乃使韓安國因長公主謝罪太后，然后得釋。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-058-liang:m009-0005","start":5,"end":6,"surface":"上","kind":"person","person_id":"82d_8vl_8i1_B","status":"contextual_provisional"},{"id":"c-shiji-058-liang:m009-0007","start":7,"end":10,"surface":"膠東王","kind":"person","person_id":"lk7_lyu_ui4","status":"contextual_provisional"},{"id":"c-shiji-058-liang:m009-0011","start":11,"end":13,"surface":"太子","kind":"person","person_id":"lk7_lyu_ui4","status":"contextual_provisional"},{"id":"c-shiji-058-liang:m009-0014","start":14,"end":16,"surface":"梁王","kind":"person","person_id":"82d_8vl_8i1_A","status":"contextual_provisional"},{"id":"c-shiji-058-liang:m009-0017","start":17,"end":19,"surface":"袁盎","kind":"person","person_id":"ndp_kf2_zbo","status":"contextual_provisional"},{"id":"c-shiji-058-liang:m009-0020","start":20,"end":22,"surface":"議臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、所舉古事或未定指代；不補來源未見姓名、成員及關係。"},{"id":"c-shiji-058-liang:m009-0025","start":25,"end":27,"surface":"羊勝","kind":"person","person_id":"fo7_9ev_cht","status":"contextual_provisional"},{"id":"c-shiji-058-liang:m009-0028","start":28,"end":31,"surface":"公孫詭","kind":"person","person_id":"2bl_b4d_kfg","status":"contextual_provisional"},{"id":"c-s