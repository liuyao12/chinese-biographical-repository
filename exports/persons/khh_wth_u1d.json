ong:line061-pei01-01","text":"谢承《后汉书》曰：俊字孝远，有文武才幹，少为郡吏，察孝廉，补尚书郎，擢拜陈相。值袁术僭号，兄弟忿争，天下鼎沸，群贼并起，陈与比界，奸慝四布，俊厉威武，保疆境，贼不敢犯。养济百姓，灾害不生，岁获丰稔。后术军众饥困，就俊求粮。俊疾恶术，初不应答。术怒，密使人杀俊。","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-057-luotong:line061-pei01-01:m0000","start":0,"end":2,"surface":"谢承","kind":"person","person_id":"khh_wth_u1d","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-luotong:line061-pei01-01:m0009","start":9,"end":10,"surface":"俊","kind":"person","person_id":"bvu_zfh_14y","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-luotong:line061-pei01-01:m0011","start":11,"end":13,"surface":"孝远","kind":"person","person_id":"bvu_zfh_14y","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-luotong:line061-pei01-01:m0040","start":40,"end":42,"surface":"袁术","kind":"person","person_id":"865_b69_cb0","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-luotong:line061-pei01-01:m0070","start":70,"end":71,"surface":"俊","kind":"person","person_id":"bvu_zfh_14y","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-luotong:line061-pei01-01:m0100","start":100,"end":101,"surface":"术","kind":"person","person_id":"865_b69_cb0","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-luotong:line061-pei01-01:m0107","start":107,"end":108,"surface":"俊","kind":"person","person_id":"bvu_zfh_14y","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-luotong:line061-pei01-01:m0111","start":111,"end":112,"surface":"俊","kind":"person","person_id":"bvu_zfh_14y","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-luotong:line061-pei01-01:m0114","start":114,"end":115,"surface":"术","kind":"person","person_id":"865_b69_cb0","status":"cont