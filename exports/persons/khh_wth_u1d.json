悌，勤脩操行，太守李肃察孝廉。肃后坐事伏法，康敛尸送丧还颍川，行服，礼终，举茂才，历三郡太守，所在称治，后拜庐江太守。","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-057-luji:line037-pei01-01:m0000","start":0,"end":2,"surface":"谢承","kind":"person","person_id":"khh_wth_u1d","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-luji:line037-pei01-01:m0009","start":9,"end":10,"surface":"康","kind":"person","person_id":"tfy_qzo_rqx","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-luji:line037-pei01-01:m0011","start":11,"end":13,"surface":"季宁","kind":"person","person_id":"tfy_qzo_rqx","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-luji:line037-pei01-01:m0026","start":26,"end":28,"surface":"李肃","kind":"person","person_id":"tlp_ivr_mb3","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-luji:line037-pei01-01:m0032","start":32,"end":33,"surface":"肃","kind":"person","person_id":"tlp_ivr_mb3","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-luji:line037-pei01-01:m0039","start":39,"end":40,"surface":"康","kind":"person","person_id":"tfy_qzo_rqx","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"}],"annotation_status":"reviewed","source_position":{"first_line":37,"last_line":37,"revision_id":2638131,"raw_start":8055,"raw_end":8131,"character_positions":[8055,8056,8057,8058,8059,8060,8061,8062,8063,8064,8065,8066,8067,8068,8069,8070,8071,8072,8073,8074,8075,8076,8077,8078,8079,8080,8081,8082,8083,8084,8085,8086,8087,8088,8089,8090,8091,8092,8093,8094,8095,8096,8097,8098,8099,8100,8101,8102,8103,8104,8105,8106,8107,8108,8109,8110,8111,8112,8113,8114,8115,8116,8117,8118,8119,8120,8121,8122,8123,8124,8125,8126,8127,8128,8129,8130]},"attribution":{"annotator":"裴松之","attribution_kind":"quoted_work","source_label":"謝承後漢書","attribution_marker":"谢承《后汉书》曰：","quoted_work":"謝承後漢書"},"attachment":{"received_paragraph_id":"c-sanguozhi-057-luji:line037","received_codepoint":23,"note_ordinal":1,"source_ordinal":1},"chapter_id":"c-sanguozhi-057-luji","book_id":"b-sanguozhi-057","work_id":"w-sanguozhi","source_id":"s-sanguozhi-057-luji"},{"id":"c-sanguozhi-057-luotong:line061-pei01-01","text":"谢承《后汉书》曰：俊字孝远，有文武才幹，少为郡吏，察孝廉，补尚书郎，擢拜陈相。值袁术僭号，兄弟忿争，天下鼎沸，群贼并起，陈与比界，奸慝四布，俊厉威武，保疆境，贼不敢犯。养济百姓，灾害不生，岁获丰稔。后术军众饥困，就俊求粮。俊疾恶术，初不应答。术怒，密使人杀俊。","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-057-luotong:line061-pei01-01:m0000","start":0,"end":2,"surface":"谢承","kind":"person","person_id":"khh_wth_u1d","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-luotong:line061-pei01-01:m0009","start":9,"end":10,"surface":"俊","kind":"person","person_id":"bvu_zfh_14y","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-luotong:line061-pei01-01:m0011","start":11,"end":13,"surface":"孝远","kind":"person","person_id":"bvu_zfh_14y","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-luotong:line061-pei01-01:m0040","start":40,"end":42,"surface":"袁术","kind":"person","person_id":"865_b69_cb0","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-luotong:line061-pei01-01:m0070","start":70,"end":71,"surface":"俊","kind":"person","person_id":"bvu_zfh_14y","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-luotong:line061-pei01-01:m0100","start":100,"end":101,"surface":"术","kind":"person","person_id":"865_b69_cb0","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-luotong:line061-pei01-01:m0107","start":107,"end":108,"surface":"俊","kind":"person","person_id":"bvu_zfh_14y","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-luotong:line061-pei01-01:m0111","start":