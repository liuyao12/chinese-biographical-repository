{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p005289","identity_policy":"contextual_provisional","person_ids":["cbr-p005289"],"persons":[{"id":"cbr-p005289","label":"陳平（樊酈滕灌列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"陳平","mention_ids":["c-shiji-095-fankuang:m009-0068","c-shiji-095-fankuang:m009-0083","c-shiji-095-fankuang:m032-0148"]}],"evidence":[{"mention_id":"c-shiji-095-fankuang:m009-0068","chapter_id":"c-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p009","quote":"陳平"},{"mention_id":"c-shiji-095-fankuang:m009-0083","chapter_id":"c-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p009","quote":"陳平"},{"mention_id":"c-shiji-095-fankuang:m032-0148","chapter_id":"c-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p032","quote":"陳平"}]}],"mentions":[{"id":"c-shiji-095-fankuang:m009-0068","start":68,"end":70,"surface":"陳平","kind":"person","person_id":"cbr-p005289","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p009","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:m009-0083","start":83,"end":85,"surface":"陳平","kind":"person","person_id":"cbr-p005289","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p009","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:m032-0148","start":148,"end":150,"surface":"陳平","kind":"person","person_id":"cbr-p005289","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p032","chapter_id":"c-shiji-095-fankuang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji095-039","person_id":"cbr-p005289","scope":"same_chapter","chapter_ids":["c-shiji-095-fankuang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["陳平"],"evidence":[{"paragraph_id":"c-shiji-095-fankuang:p009","quote":"其後盧綰反，高帝使噲以相國擊燕。是時高帝病甚，人有惡噲黨於呂氏，即上一日宮車晏駕，則噲欲以兵盡誅滅戚氏、趙王如意之屬。高帝聞之大怒，乃使陳平載絳侯代將，而即軍中斬噲。陳平畏呂后，執噲詣長安。至則高祖已崩，呂后釋噲，使復爵邑。"},{"paragraph_id":"c-shiji-095-fankuang:p032","quote":"嬰自破布歸，高帝崩，嬰以列侯事孝惠帝及呂太后。太后崩，呂祿等以趙王自置為將軍，軍長安，為亂。齊哀王聞之，舉兵西，且入誅不當為王者。上將軍呂祿等聞之，乃遣嬰為大將，將軍往擊之。嬰行至滎陽，乃與絳侯等謀，因屯兵滎陽，風齊王以誅呂氏事，齊兵止不前。絳侯等既誅諸呂，齊王罷兵歸，嬰亦罷兵自滎陽歸，與絳侯、陳平共立代王為孝文皇帝。孝文皇帝於是益封嬰三千戶，賜黃金千斤，拜為太尉。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定異稱。酈寄字況據第14段；夏侯嬰的嬰限定第16至21段，灌嬰限定第22至33段，桓嬰另人。第6與20、28段楚王信和反韓王信分人；未詳名王侯不補名。同名跨篇同指另待逐項證據。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-095-fankuang:p009","text":"其後盧綰反，高帝使噲以相國擊燕。是時高帝病甚，人有惡噲黨於呂氏，即上一日宮車晏駕，則噲欲以兵盡誅滅戚氏、趙王如意之屬。高帝聞之大怒，乃使陳平載絳侯代將，而即軍中斬噲。陳平畏呂后，執噲詣長安。至則高祖已崩，呂后釋噲，使復爵邑。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m009-0002","start":2,"end":4,"surface":"盧綰","kind":"person","person_id":"cbr-p005284","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0006","start":6,"end":8,"surface":"高帝","kind":"person","person_id":"cbr-p005253","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0009","start":9,"end":10,"surface":"噲","kind":"person","person_id":"cbr-p005252","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0018","start":18,"end":20,"surface":"高帝","kind":"person","person_id":"cbr-p005253","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0026","start":26,"end":27,"surface":"噲","kind":"person","person_id":"cbr-p005252","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0042","start":42,"end":43,"surface":"噲","kind":"person","person_id":"cbr-p005252","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0052","start":52,"end":56,"surface":"趙王如意","kind":"person","person_id":"cbr-p005265","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0059","start":59,"end":61,"surface":"高帝","kind":"person","person_id":"cbr-p005253","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0068","start":68,"end":70,"surface":"陳平","kind":"person","person_id":"cbr-p005289","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0071","start":71,"end":73,"surface":"絳侯","kind":"person","person_id":"cbr-p005276","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0081","start":81,"end":82,"surface":"噲","kind":"person","person_id":"cbr-p005252","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0083","start":83,"end":85,"surface":"陳平","kind":"person","person_id":"cbr-p005289","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0086","start":86,"end":88,"surface":"呂后","kind":"person","person_id":"cbr-p005285","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0090","start":90,"end":91,"surface":"噲","kind":"person","person_id":"cbr-p005252","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0097","start":97,"end":99,"surface":"高祖","kind":"person","person_id":"cbr-p005253","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0102","start":102,"end":104,"surface":"呂后","kind":"person","person_id":"cbr-p005285","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0105","start":105,"end":106,"surface":"噲","kind":"person","person_id":"cbr-p005252","status":"contextual_provisional"}],"chapter_id":"c-shiji-095-fankuang","book_id":"b-shiji-095","work_id":"w-shiji","source_id":"s-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:p032","text":"嬰自破布歸，高帝崩，嬰以列侯事孝惠帝及呂太后。太后崩，呂祿等以趙王自置為將軍，軍長安，為亂。齊哀王聞之，舉兵西，且入誅不當為王者。上將軍呂祿等聞之，乃遣嬰為大將，將軍往擊之。嬰行至滎陽，乃與絳侯等謀，因屯兵滎陽，風齊王以誅呂氏事，齊兵止不前。絳侯等既誅諸呂，齊王罷兵歸，嬰亦罷兵自滎陽歸，與絳侯、陳平共立代王為孝文皇帝。孝文皇帝於是益封嬰三千戶，賜黃金千斤，拜為太尉。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m032-0000","start":0,"end":1,"surface":"嬰","kind":"person","person_id":"cbr-p005296","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m032-0003","start":3,"end":4,"surface":"布","kind":"person","person_id":"cbr-p005287","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m032-0006","start":6,"end":8,"surface":"高帝","kind":"person","person_id":"cbr-p005253","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m032-0010","start":10,"end":11,"surface":"嬰","kind":"person","person_id":"cbr-p005296","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m032-0015","start":15,"end":18,"surface":"孝惠帝","kind":"person","person_id":"cbr-p005290","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m032-0019","start":19,"end":22,"surface":"呂太后","kind":"person","person_id":"cbr-p005285","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m032-0023","start":23,"end":25,"surface":"太后","kind":"person","person_id":"cbr-p005285","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m032-0027","start":27,"end":29,"surface":"呂祿","kind":"person","person_id":"cbr-p005315","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m032-0046","start":46,"end":49,"surface":"齊哀王","kind":"person","person_id":"cbr-p005331","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m032-0068","start":68,"end":70,"surface":"呂祿","kind":"person","person_id":"cbr-p005315","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m032-0076","start":76,"end":77,"surface":"嬰","kind":"person","person_id":"cbr-p005296","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m032-0087","start":87,"end":88,"surface":"嬰","kind":"person","person_id":"cbr-p005296","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m032-0095","start":95,"end":97,"surface":"絳侯","kind":"person","person_id":"cbr-p005276","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m032-0107","start":107,"end":109,"surface":"齊王","kind":"person","person_id":"cbr-p005331","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m032-0121","start":121,"end":123,"surface":"絳侯","kind":"person","person_id":"cbr-p005276","status":"contextual_provisional"},{"id":"c-shiji-095-fankua