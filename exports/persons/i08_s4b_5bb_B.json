{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"i08_s4b_5bb_B","canonical_person_id":"i08_s4b_5bb_B","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["i08_s4b_5bb_B"],"persons":[{"id":"i08_s4b_5bb_A","label":"王德元（王晏子，初名湛）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"德元","mention_ids":["c-liangshu-033-wangsengru:p003:m0123","c-nanqishu-042-wangdeyuan-names:p001:m0002","c-nanqishu-042-wangdeyuan-names:p001:m0015"]},{"surface":"湛","mention_ids":["c-nanqishu-042-wangdeyuan-names:p001:m0019"]}],"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-033","source_id":"s-liangshu-033-wangsengru-ws1514481","chapter_id":"c-liangshu-033-wangsengru","paragraph_id":"c-liangshu-033-wangsengru:p003","quote":"德元","mention_id":"c-liangshu-033-wangsengru:p003:m0123"},{"work_id":"w-nanqishu","book_id":"b-nanqishu-042","source_id":"s-nanqishu-042-wangdeyuan-names-ws1507997","chapter_id":"c-nanqishu-042-wangdeyuan-names","paragraph_id":"c-nanqishu-042-wangdeyuan-names:p001","quote":"德元","mention_id":"c-nanqishu-042-wangdeyuan-names:p001:m0002"},{"work_id":"w-nanqishu","book_id":"b-nanqishu-042","source_id":"s-nanqishu-042-wangdeyuan-names-ws1507997","chapter_id":"c-nanqishu-042-wangdeyuan-names","paragraph_id":"c-nanqishu-042-wangdeyuan-names:p001","quote":"德元","mention_id":"c-nanqishu-042-wangdeyuan-names:p001:m0015"},{"work_id":"w-nanqishu","book_id":"b-nanqishu-042","source_id":"s-nanqishu-042-wangdeyuan-names-ws1507997","chapter_id":"c-nanqishu-042-wangdeyuan-names","paragraph_id":"c-nanqishu-042-wangdeyuan-names:p001","quote":"湛","mention_id":"c-nanqishu-042-wangdeyuan-names:p001:m0019"}],"review":"ai_provisional","identity_note":"齊王晏傳載世祖以劉湛、江湛不善終命改其名。","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"i08_s4b_5bb","source_assertion_id":"a-liang033-wangsengru-deyuan","evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-033","source_id":"s-liangshu-033-wangsengru-ws1514481","chapter_id":"c-liangshu-033-wangsengru","paragraph_id":"c-liangshu-033-wangsengru:p003","quote":"仕齊，起家王國左常侍、太學博士。尚書僕射王晏深相賞好。晏爲丹陽尹，召補郡功曹，使僧孺撰《東宮新記》。遷大司馬豫章王行參軍，又兼太學博士。司徒竟陵王子良開西邸招文學，僧孺亦遊焉。文惠太子聞其名，召入東宮，直崇明殿。欲擬爲宮僚，文惠薨，不果。時王晏子德元出爲晉安郡，以僧孺補郡丞，除候官令。建武初，有詔舉士，揚州刺史始安王遙光表薦秘書丞王暕及僧孺曰：「前候官令東海王僧孺，年三十五，理尚棲約，思致悟敏，旣筆耕爲養，亦傭書成學。至乃照螢映雪，編蒲緝柳，先言往行，人物雅俗，甘泉遺儀，南宮故事，畫地成圖，抵掌可述；豈直鼮鼠有必對之辯，竹書無落簡之謬，訪對不休，質疑斯在。」除尚書儀曹郎，遷治書侍御史，出爲錢唐令。初，僧孺與樂安任昉遇竟陵王西邸，以文學友會，及是將之縣，昉贈詩，其略曰：「惟子見知，惟余知子。觀行視言，要終猶始。敬之重之，如蘭如芷。形應影隨，曩行今止。百行之首，立人斯著。子之有之，誰毀誰譽。修名旣立，老至何遽。誰其執鞭，吾爲子御。劉《略》班《藝》，虞《志》荀《錄》，伊昔有懷，交相欣勗。下帷無倦，升高有屬。嘉爾晨燈，惜余夜燭。」其爲士友推重如此。","subject_person_mention_id":"c-liangshu-033-wangsengru:p003:m0123","object_person_mention_id":"c-liangshu-033-wangsengru:p003:m0120"}],"status":"contextual_provisional","interpretation_note":"德元之父王晏。","human_reviewed":false}},{"id":"i08_s4b_5bb_B","label":"王德和（王德元弟）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"德和","mention_ids":["c-nanqishu-042-wangdeyuan-names:p001:m0059"]}],"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-042","source_id":"s-nanqishu-042-wangdeyuan-names-ws1507997","chapter_id":"c-nanqishu-042-wangdeyuan-names","paragraph_id":"c-nanqishu-042-wangdeyuan-names:p001","quote":"德和","mention_id":"c-nanqishu-042-wangdeyuan-names:p001:m0059"}],"review":"ai_provisional","identity_note":"齊王晏傳載與兄德元俱被誅。","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"i08_s4b_5bb","source_assertion_id":null,"parent_connection":{"type":"shared_father_through_siblings","sibling_assertion_ids":["a-liang033-wangsengru-dehe"],"sibling_father_assertion_id":"a-liang033-wangsengru-deyuan-d"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-042","source_id":"s-nanqishu-042-wangdeyuan-names-ws1507997","chapter_id":"c-nanqishu-042-wangdeyuan-names","paragraph_id":"c-nanqishu-042-wangdeyuan-names:p001","quote":"晏子德元，有意尚。至車騎長史。德元初名湛，世祖謂晏曰：「劉湛、江湛，竝不善終，此非佳名也。」晏乃改之。至是與弟晉安王友德和俱被誅。","subject_person_mention_id":"c-nanqishu-042-wangdeyuan-names:p001:m0002","object_person_mention_id":"c-nanqishu-042-wangdeyuan-names:p001:m0000","source_assertion_id":"a-liang033-wangsengru-deyuan-d","source_term":"晏子德元"},{"work_id":"w-nanqishu","book_id":"b-nanqishu-042","source_id":"s-nanqishu-042-wangdeyuan-names-ws1507997","chapter_id":"c-nanqishu-042-wangdeyuan-names","paragraph_id":"c-nanqishu-042-wangdeyuan-names:p001","quote":"晏子德元，有意尚。至車騎長史。德元初名湛，世祖謂晏曰：「劉湛、江湛，竝不善終，此非佳名也。」晏乃改之。至是與弟晉安王友德和俱被誅。","subject_person_mention_id":"c-nanqishu-042-wangdeyuan-names:p001:m0015","object_person_mention_id":"c-nanqishu-042-wangdeyuan-names:p001:m0059","source_assertion_id":"a-liang033-wangsengru-dehe","source_term":"與弟晉安王友德和"}],"status":"contextual_provisional","interpretation_note":"德和為晏子德元之弟，兩條原證同段。","human_reviewed":false}}],"source_mention_summary":[{"source_id":"s-nanqishu-042-wangdeyuan-names-ws1507997","work_id":"w-nanqishu","book_id":"b-nanqishu-042","chapter_id":"c-nanqishu-042-wangdeyuan-names","raw_mention_count":1,"mention_ids":["c-nanqishu-042-wangdeyuan-names:p001:m0059"],"paragraph_ids":["c-nanqishu-042-wangdeyuan-names:p001"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-nanqishu-042-wangdeyuan-names:p001:m0059","mention_ids":["c-nanqishu-042-wangdeyuan-names:p001:m0059"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-nanqishu-042-wangdeyuan-names-ws1507997"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpreta