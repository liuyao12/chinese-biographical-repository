541,7542,7543,7544,7545,7546,7547,7548,7549,7550,7551,7552,7553,7554,7555,7556,7557,7558,7559,7560,7561,7562,7563,7564,7565,7566,7567,7568,7569,7570,7571,7572,7573,7574,7575,7576,7577,7578,7579,7580,7581,7582,7583,7584,7585,7586,7587,7593,7594,7595,7596,7599,7600,7601,7602,7603,7604,7605,7606,7607,7608,7609,7610,7611,7612,7613,7614,7617,7620,7621,7622,7623,7624,7625,7626,7627,7628,7629,7630,7631,7632,7633,7634,7635,7636,7637,7638,7639,7640],"revision_id":1775463},"mentions":[{"id":"c-jinshu-058-zhou-fang:p006:m0002","surface":"訪","start":2,"end":3,"person_id":"c6b_s71_vt7","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-fang:p006:m0011","surface":"陳訓","start":11,"end":13,"person_id":"juz_2ha_pf0","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-fang:p006:m0015","surface":"訪","start":15,"end":16,"person_id":"c6b_s71_vt7","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-fang:p006:m0017","surface":"陶侃","start":17,"end":19,"person_id":"twd_erg_kmz","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-fang:p006:m0054","surface":"訪","start":54,"end":55,"person_id":"c6b_s71_vt7","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-fang:p006:m0098","surface":"撫","start":98,"end":99,"person_id":"smf_swf_i2l","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-fang:p006:m0100","surface":"光","start":100,"end":101,"person_id":"fqd_otm_jc2","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-058-zhou-fang","book_id":"b-jinshu-058","work_id":"w-jinshu","source_id":"s-jinshu-058-zhou-fang-ws1775463"},{"id":"c-jinshu-062-zuti:p007","text":"石勒不敢窺兵河南，使成皋縣修逖母墓，因與逖書，求通使交市，逖不報書，而聽互市，收利十倍，於是公私豐贍，士馬日滋。方當推鋒越河，掃清冀朔，會朝廷將遣戴若思爲都督，逖以若思是吳人，雖有才望，無弘致遠識，且已翦荊棘，收河南地，而若思雍容，一旦來統之，意甚怏怏。且聞王敦與劉隗等構隙，慮有內難，大功不遂。感激發病，乃致妻孥汝南大木山下。時中原士庶咸謂逖當進據武牢，而反置家險厄，或諫之，不納。逖雖內懷憂憤，而圖進取不輟，營繕武牢城，城北臨黃河，西接成皋，四望甚遠。逖恐南無堅壘，必爲賊所襲，乃使從子汝南太守濟率汝陽太守張敞、新蔡內史周閎率眾築壘。未成，而逖病甚。先是，華譚、庾闡問術人戴洋，洋曰：「祖豫州九月當死。」初有妖星見於豫州之分，曆陽陳訓又謂人曰：「今年西北大將當死。」逖亦見星，曰：「爲我矣！方平河北，而天欲殺我，此乃不祐國也。」俄卒於雍丘，時年五十六。豫州士女若喪考妣，譙梁百姓爲之立祠。冊贈車騎將軍。王敦久懷逆亂，畏逖不敢發，至是始得肆意焉。尋以逖弟約代領其眾。約別有傳。逖兄納。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":95,"last_line":95,"raw_start":10008,"raw_end":10468,"raw_character_offsets":[10010,10011,10012,10013,10014,10015,10016,10017,10018,10019,10020,10021,10022,10023,10024,10025,10026,10027,10028,10029,10030,10031,10032,10033,10034,10035,10036,10037,10038,10039,10040,10041,10042,10043,10044,10045,10046,10047,10048,10049,10050,10051,10052,10053,10054,10055,10056,10057,10058,10059,10060,10061,10062,10063,10064,10065,10066,10067,10068,10069,10070,10071,10072,10073,10074,10075,10076,10077,10078,10079,10080,10081,10082,10083,10084,10085,10086,10087,10088,10089,10090,10091,10092,10093,10094,10095,10096,10097,10098,10099,10100,10101,10102,10103,10104,10105,10106,10107,10108,10109,10110,10111,10112,10113,10114,10115,10116,10117,10118,10119,10120,10121,10122,10123,10124,10125,10126,10127,10128,10129,10130,10131,10132,10133,10134,10135,10136,10137,10138,10139,10140,10141,10142,10143,10144,10145,10146,10147,10148,10149,10150,10151,10152,10153,10154,10155,10156,10157,10158,10159,10160,10161,10162,10163,10164,10165,10166,10167,10168,10169,10170,10171,10172,10173,10174,10175,10176,10177,10178,10179,10180,10181,10182,10183,10184,10185,10186,10187,10188,10189,10190,10191,10192,10193,10194,10195,10196,10197,10198,10199,10200,10201,10202,10203,10204,10205,10206,10207,10208,10209,10210,10211,10212,10213,10214,10215,10216,10217,10218,10219,10220,10221,10222,10223,10224,10225,10226,10227,10228,10229,10230,10231,10232,10233,10234,10235,10236,10237,10238,10239,10240,10241,10242,10243,10244,10245,10246,10247,10248,10249,10250,10251,10252,10253,10254,10255,10256,10257,10258,10259,10260,10261,10262,10263,10264,10265,10266,10267,10268,10269,10270,10271,10272,10273,10274,10275,10276,10277,10278,10279,10280,10281,10282,10283,10284,10285,10