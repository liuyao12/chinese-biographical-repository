稽古，隆於興繼，為胤歸訴，乞丐餘罪，還兵復爵，使失旦之雞，復得鳴。抱罪之臣，展其後效。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-054-zhouyu:line035:m0003","start":3,"end":5,"surface":"周瑜","kind":"person","person_id":"f56_938_997","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-zhouyu:line035:m0006","start":6,"end":7,"surface":"胤","kind":"person","person_id":"f56_938_997_B","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-zhouyu:line035:m0043","start":43,"end":44,"surface":"瑜","kind":"person","person_id":"f56_938_997","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-zhouyu:line035:m0082","start":82,"end":84,"surface":"曹操","kind":"person","person_id":"dad_b77_b38","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-zhouyu:line035:m0089","start":89,"end":91,"surface":"曹仁","kind":"person","person_id":"8po_0xd_0vn","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-zhouyu:line035:m0118","start":118,"end":120,"surface":"方叔","kind":"person","person_id":"h56_iok_efr","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-zhouyu:line035:m0123","surface":"信","start":123,"end":124,"kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional","interpretation_note":"按本段具名及前後親稱、官職定位。"},{"id":"c-sanguozhi-054-zhouyu:line035:m0125","surface":"布","start":125,"end":126,"kind":"person","person_id":"zxd_afr_2xg","status":"contextual_provisional","interpretation_note":"按本段具名及前後親稱、官職定位。"},{"id":"c-sanguozhi-054-zhouyu:line035:m0151","start":151,"end":154,"surface":"漢高帝","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-zhouyu:line035:m0259","start":259,"end":260,"surface":"瑜","kind":"person","person_id":"f56_938_997","status":"contextual_provisio