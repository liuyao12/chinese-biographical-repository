{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p001246","identity_policy":"contextual_provisional","person_ids":["cbr-p001246"],"persons":[{"id":"cbr-p001246","label":"鍼季","status":"active","historicity":"historical_tradition","aliases":[{"surface":"鍼季","mention_ids":["c-shiji-033-lu:m045-0167"]}],"evidence":[{"mention_id":"c-shiji-033-lu:m045-0167","chapter_id":"c-shiji-033-lu","paragraph_id":"c-shiji-033-lu:p045","quote":"鍼季"}]}],"source_mention_summary":[{"source_id":"s-shiji-033-lu","work_id":"w-shiji","book_id":"b-shiji-033","chapter_id":"c-shiji-033-lu","mention_count":1,"mention_ids":["c-shiji-033-lu:m045-0167"],"paragraph_ids":["c-shiji-033-lu:p045"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-033-lu"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-033-lu:m045-0167","start":167,"end":169,"surface":"鍼季","kind":"person","person_id":"cbr-p001246","status":"contextual_provisional","paragraph_id":"c-shiji-033-lu:p045","chapter_id":"c-shiji-033-lu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji033-080","person_id":"cbr-p001246","surfaces":["鍼季"],"scope":"same_chapter","chapter_ids":["c-shiji-033-lu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-033-lu:p045","quote":"莊公有三弟，長曰慶父，次曰叔牙，次曰季友。莊公取齊女爲夫人曰哀姜。哀姜無子。哀姜娣曰叔姜，生子開。莊公無適嗣，愛孟女，欲立其子斑。莊公病，而問嗣於弟叔牙。叔牙曰：『一繼一及，魯之常也。慶父在，可爲嗣，君何憂？』莊公患叔牙欲立慶父，退而問季友。季友曰：『請以死立斑也。』莊公曰：『曩者叔牙欲立慶父，柰何？』季友以莊公命命牙待於鍼巫氏，使鍼季劫飲叔牙以鴆，曰：『飲此則有後奉祀；不然，死且無後。』牙遂飲鴆而死，魯立其子爲叔孫氏。八月癸亥，莊公卒，季友竟立子斑爲君，如莊公命。侍喪，舍于黨氏。"}],"rationale":"按懿公被弒至魯文公的敘事角色、同段明示子／弟與柯盟、齊襄公殺魯桓公、晉立惠公等具體事件暫定異稱；同字爵稱依國別分開。公子揮不與前篇公子翚、晉襄父不與晉襄公、宣伯不與叔孫宣伯自動合併。數位疑讀與親屬異說仍待核對。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-033-lu:p045","text"