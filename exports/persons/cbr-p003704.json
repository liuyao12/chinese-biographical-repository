":238,"end":240,"surface":"管仲","kind":"person","person_id":"cbr-p000243","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m030-0247","start":247,"end":250,"surface":"鮑叔牙","kind":"person","person_id":"cbr-p001103","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m030-0252","start":252,"end":254,"surface":"管仲","kind":"person","person_id":"cbr-p000243","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m030-0267","start":267,"end":269,"surface":"桓公","kind":"person","person_id":"cbr-p000235","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m030-0270","start":270,"end":272,"surface":"桓公","kind":"person","person_id":"cbr-p000235","status":"contextual_provisional"}],"chapter_id":"c-shiji-032-qi","book_id":"b-shiji-032","work_id":"w-shiji","source_id":"s-shiji-032-qi"},{"id":"c-shiji-033-lu:p040","text":"八年，齊公子糾來奔。九年，魯欲內子糾於齊，後桓公，桓公發兵擊魯，魯急，殺子糾。召忽死。齊告魯生致管仲。魯人施伯曰：『齊欲得管仲，非殺之也，將用之，用之則爲魯患。不如殺，以其尸與之。』莊公不聽，遂囚管仲與齊。齊人相管仲。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-033-lu:m040-0003","start":3,"end":7,"surface":"齊公子糾","kind":"person","person_id":"cbr-p001101","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m040-0016","start":16,"end":18,"surface":"子糾","kind":"person","person_id":"cbr-p001101","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m040-0022","start":22,"end":24,"surface":"桓公","kind":"person","person_id":"cbr-p000235","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m040-0025","start":25,"end":27,"surface":"桓公","kind":"person","person_id":"cbr-p000235","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m040-0036","start":36,"end":38,"surface":"子糾","kind":"person","person_id":"cbr-p001101","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m040-0039","start":39,"end":41,"surface":"召忽","kind":"person","person_id":"cbr-p001102","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m040-0048","start":48,"end":50,"surface":"管仲","kind":"person","person_id":"cbr-p000243","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m040-0051","start":51,"end":53,"surface":"魯人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未指名者、地點氏稱、未定官稱或未解指代；不補姓名、成員與父系。"},{"id":"c-shiji-033-lu:m040-0053","start":53,"end":55,"surface":"施伯","kind":"person","person_id":"cbr-p001238","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m040-0061","start":61,"end":63,"surface":"管仲","kind":"person","person_id":"cbr-p000243","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m040-0091","start":91,"end":93,"surface":"莊公","kind":"person","person_id":"cbr-p001106","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m040-0098","start":98,"end":100,"surface":"管仲","kind":"person","person_id":"cbr-p000243","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m040-0103","start":103,"end":105,"surface":"齊人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未指名者、地點氏稱、未定官稱或未解指代；不補姓名、成員與父系。"},{"id":"c-shiji-033-lu:m040-0106","start":106,"end":108,"surface":"管仲","kind":"person","person_id":"cbr-p000243","status":"contextual_provisional"}],"chapter_id":"c-shiji-033-lu","book_id":"b-shiji-033","work_id":"w-shiji","source_id":"s-shiji-033-lu"},{"id":"c-shiji-062-guanyan:p001","text":"管仲夷吾者，潁上人也。少時常與鮑叔牙游，鮑叔知其賢。管仲貧困，常欺鮑叔，鮑叔終善遇之，不以為言。已而鮑叔事齊公子小白，管仲事公子糾。及小白立為桓公，公子糾死，管仲囚焉。鮑叔遂進管仲。管仲既用，任政於齊，齊桓公以霸，九合諸侯，一匡天下，管仲之謀也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-062-guanyan:m001-0000","start":0,"end":4,"surface":"管仲夷吾","kind":"person","person_id":"cbr-p003701","status":"contextual_provisional"},{"id":"c-shiji-062-guanyan:m001-0015","start":15,"end":18,"surface":"鮑叔牙","kind":"person","person_id":"cbr-p003702","status":"contextual_provisional"},{"id":"c-shiji-062-guanyan:m001-0020","start":20,"end":22,"surface":"鮑叔","kind":"person","person_id":"cbr-p003702","status":"contextual_provisional"},{"id":"c-shiji-062-guanyan:m001-0026","start":26,"end":2