end":65,"surface":"公子糾","kind":"person","person_id":"cbr-p003704","status":"contextual_provisional","paragraph_id":"c-shiji-062-guanyan:p001","chapter_id":"c-shiji-062-guanyan"},{"id":"c-shiji-062-guanyan:m001-0074","start":74,"end":77,"surface":"公子糾","kind":"person","person_id":"cbr-p003704","status":"contextual_provisional","paragraph_id":"c-shiji-062-guanyan:p001","chapter_id":"c-shiji-062-guanyan"},{"id":"c-shiji-062-guanyan:m002-0111","start":111,"end":114,"surface":"公子糾","kind":"person","person_id":"cbr-p003704","status":"contextual_provisional","paragraph_id":"c-shiji-062-guanyan:p002","chapter_id":"c-shiji-062-guanyan"}],"relations":[{"id":"a-shiji032-017","subject_person_id":"cbr-p001101","predicate":"brother","object_person_id":"cbr-p000363","status":"source_attested","evidence":[{"chapter_id":"c-shiji-032-qi","source_id":"s-shiji-032-qi","paragraph_id":"c-shiji-032-qi:p029","quote":"初，襄公之醉殺魯桓公，通其夫人，殺誅數不當，淫於婦人，數欺大臣，群弟恐禍及，故次弟糾奔魯。其母魯女也。管仲、召忽傅之。次弟小白奔莒，鮑叔傅之。小白母，衛女也，有寵於釐公。小白自少好善大夫高傒。及雍林人殺無知，議立君，高、國先陰召小白於莒。魯聞無知死，亦發兵送公子糾，而使管仲別將兵遮莒道，射中小白帶鉤。小白詳死，管仲使人馳報魯。魯送糾者行益遲，六日至齊，則小白已入，高傒立之，是為桓公。"}],"qualifiers":{"source_term":"次弟","historicity":"historical_tradition"},"interpretation_note":"逐項保存本文母子、兄弟、姊妹、配偶及祖先說；祖不補代數，異母女性不合併，不以史記記載當已確證身世。蔡姬原文弗絕不推婚姻終止。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji032-019","subject_person_id":"cbr-p001101","predicate":"mother","object_person_id":"cbr-p001146","status":"source_attested","evidence":[{"chapter_id":"c-shiji-032-qi","source_id":"s-shiji-032-qi","paragraph_id":"c-shiji-032-qi:p029","quote":"初，襄公之醉殺魯桓公，通其夫人，殺誅數不當，淫於婦人，數欺大臣，群弟恐禍及，故次弟糾奔魯。其母魯女也。管仲、召忽傅之。次弟小白奔莒，鮑叔傅之。小白母，衛女也，有寵於釐公。小白自少好善大夫高傒。及雍林人殺無知，議立君，高、國先陰召小白於莒。魯聞無知死，亦發兵送公子糾，而使管仲別將兵遮莒道，射中小白帶鉤。小白詳死，管仲使人馳報魯。魯送糾者行益遲，六日至齊，則小白已入，高傒立之，是為桓公。"}],"qualifiers":{"source_term":"其母","historicity":"historical_tradition"},"interpretation_note":"逐項保存本文母子、兄弟、姊妹、配偶及祖先說；祖不補代數，異母女性不合併，不以史記記載當已確證身世。蔡姬原文弗絕不推婚姻終止。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji062-003","person_id":"cbr-p003704","title":"公子","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-062-guanyan","source_id":"s-shiji-062-guanyan","paragraph_id":"c-shiji-062-guanyan:p001","quote":"管仲夷吾者，潁上人也。少時常與鮑叔牙游，鮑叔知其賢。管仲貧困，常欺鮑叔，鮑叔終善遇之，不以為言。已而鮑叔事齊公子小白，管仲事公子糾。及小白立為桓公，公子糾死，管仲囚焉。鮑叔遂進管仲。管仲既用，任政於齊，齊桓公以霸，九合諸侯，一匡天下，管仲之謀也。"}],"attestations":[{"id":"th-shiji062-003:a001","paragraph_id":"c-shiji-062-guanyan:p001","start":62,"end":64,"surface":"公子","person_mention_id":"c-shiji-062-guanyan:m001-0062","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"按來源用稱保存；公子、相齊、齊相、仆御與公號按原文分辨，不據首次用稱或死亡補任期。公號敘事不當諡號已在生前使用。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji032-056","person_id":"cbr-p001101","surfaces":["公子糾","子糾","糾"],"scope":"same_chapter","chapter_ids":["c-shiji-032-qi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-032-qi:p029","quote":"初，襄公之醉殺魯桓公，通其夫人，殺誅數不當，淫於婦人，數欺大臣，群弟恐禍及，故次弟糾奔魯。其母魯女也。管仲、召忽傅之。次弟小白奔莒，鮑叔傅之。小白母，衛女也，有寵於釐公。小白自少好善大夫高傒。及雍林人殺無知，議立君，高、國先陰召小白於莒。魯聞無知死，亦發兵送公子糾，而使管仲別將兵遮莒道，射中小白帶鉤。小白詳死，管仲使人馳報魯。魯送糾者行益遲，六日至齊，則小白已入，高傒立之，是為桓公。"},{"paragraph_id":"c-shiji-032-qi:p030","quote":"桓公之中鉤，詳死以誤管仲，已而載溫車中馳行，亦有高、國內應，故得先入立，發兵距魯。秋，與魯戰于乾時，魯兵敗走，齊兵掩絕魯歸道。齊遺魯書曰：「子糾兄弟，弗忍誅，請魯自殺之。召忽、管仲讎也，請得而甘心醢之。不然，將圍魯。」魯人患之，遂殺子糾于笙瀆。召忽自殺，管仲請囚。桓公之立，發兵攻魯，心欲殺管仲。鮑叔牙曰：「臣幸得從君，君竟以立。君之尊，臣無以增君。君將治齊，即高傒與叔牙足也。君且欲霸王，非管夷吾不可。夷吾所居國國重，不可失也。」於是桓公從之。乃詳為召管仲欲甘心，實欲用之。管仲知之，故請往。鮑叔牙迎受管仲，及堂阜而脫桎梏，齋祓而見桓公。桓公厚禮以為大夫，任政。"}],"rationale":"按本篇小白立桓公、管仲任政、葵丘盟會及齊君／母親的明示敘事相接暫定；魯與齊的同號君主、同氏女性分開，不作全庫字串合併。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji033-050","person_id":"cbr-p001101","surfaces":["子糾","齊公子糾"],"scope":"cross_chapter","chapter_ids":["c-shiji-032-qi","c-shiji-033-lu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-032-qi:p029","quote":"初，襄公之醉殺魯桓公，通其夫人，殺誅數不當，淫於婦人，數欺大臣，群弟恐禍及，故次弟糾奔魯。其母魯女也。管仲、召忽傅之。次弟小白奔莒，鮑叔傅之。小白母，衛女也，有寵於釐公。小白自少好善大夫高傒。及雍林人殺無知，議立君，高、國先陰召小白於莒。魯聞無知死，亦發兵送公子糾，而使管仲別將兵遮莒道，射中小白帶鉤。小白詳死，管仲使人馳報魯。魯送糾者行益遲，六日至齊，則小白已入，高傒立之，是為桓公。"},{"paragraph_id":"c-shiji-033-lu:p040","quote":"八年，齊公子糾來奔。九年，魯欲內子糾於齊，後桓公，桓公發兵擊魯，魯急，殺子糾。召忽死。齊告魯生致管仲。魯人施伯曰：『齊欲得管仲，非殺之也，將用之，用之則爲魯患。不如殺，以其尸與之。』莊公不聽，遂囚管仲與齊。齊人相管仲。"}],"rationale":"按懿公被弒至魯文公的敘事角色、同段明示子／弟與柯盟、齊襄公殺魯桓公、晉立惠公等具體事件暫定異稱；同字爵稱依國別分開。公子揮不與前篇公子翚、晉襄父不與晉襄公、宣伯不與叔孫宣伯自動合併。數位疑讀與親屬異說仍待核對。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji062-004","person_id":"cbr-p003704","surfaces":["公子糾"],"scope":"same_chapter","chapter_ids":["c-shiji-062-guanyan"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-062-guanyan:p001","quote":"管仲夷吾者，潁上人也。少時常與鮑叔牙游，鮑叔知其賢。管仲貧困，常欺鮑叔，鮑叔終善遇之，不以為言。已而鮑叔事齊公子小白，管仲事公子糾。及小白立為桓公，公子糾死，管仲囚焉。鮑叔遂進管仲。管仲既用，任政於齊，齊桓公以霸，九合諸侯，一匡天下，管仲之謀也。"},{"paragraph_id":"c-shiji-062-guanyan:p002","quote":"管仲曰：「吾始困時，嘗與鮑叔賈，分財利多自與，鮑叔不以我為貪，知我貧也。吾嘗為鮑叔謀事而更窮困，鮑叔不以我為愚，知時有利不利也。吾嘗三仕三見逐於君，鮑叔不以我為不肖，知我不遭時也。吾嘗三戰三走，鮑叔不以我怯，知我有老母也。公子糾敗，召忽死之，吾幽囚受辱，鮑叔不以我為無恥，知我不羞小節而恥功名不顯于天下也。生我者父母，知我者鮑子也。」"}],"rationale":"依明示姓名、齊公子小白立桓公、晏平仲嬰與對話說話者及御者妻敘事局部暫接；不全域按短字匹配，不把書名當人名，未名人物不補全名。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji062-jiu","person_ids":["cbr-p001101","cbr-p003704"],"canonical_person_id":"cbr-p001101","scope":"cross_chapter","chapter_ids":["c-shiji-032-qi","c-shiji-062-guanyan"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-032-qi","source_id":"s-shiji-032-qi","paragraph_id":"c-shiji-032-qi:p029","quote":"初，襄公之醉殺魯桓公，通其夫人，殺誅數不當，淫於婦人，數欺大臣，群弟恐禍及，故次弟糾奔魯。其母魯女也。管仲、召忽傅之。次弟小白奔莒，鮑叔傅之。小白母，衛女也，有寵於釐公。小白自少好善大夫高傒。及雍林人殺無知，議立君，高、國先陰召小白於莒。魯聞無知死，亦發兵送公子糾，而使管仲別將兵遮莒道，射中小白帶鉤。小白詳死，管仲使人馳報魯。魯送糾者行益遲，六日至齊，則小白已入，高傒立之，是為桓公。","mention_ids":["c-shiji-032-qi:m029-0041","c-shiji-032-qi:m029-0129","c-shiji-032-qi:m029-0166"]},{"chapter_id":"c-shiji-062-guanyan","source_id":"s-shiji-062-guanyan","paragraph_id":"c-shiji-062-guanyan:p001","quote":"管仲夷吾者，潁上人也。少時常與鮑叔牙游，鮑叔知其賢。管仲貧困，常欺鮑叔，鮑叔終善遇之，不以為言。已而鮑叔事