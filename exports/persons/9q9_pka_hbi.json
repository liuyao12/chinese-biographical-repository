{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"9q9_pka_hbi","canonical_person_id":"9q9_pka_hbi","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["9q9_pka_hbi"],"persons":[{"id":"9q9_pka_hbi","label":"安僖皇后〔王獻之女〕","status":"active","historicity":"historical_tradition","aliases":[{"surface":"安僖皇后","mention_ids":["c-jinshu-080-wangxizhi:p047:m0062"]}],"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-080","chapter_id":"c-jinshu-080-wangxizhi","source_id":"s-jinshu-080-ws2603570-wangxizhi","paragraph_id":"c-jinshu-080-wangxizhi:p047","mention_id":"c-jinshu-080-wangxizhi:p047:m0062","quote":"安僖皇后"}],"identity_note":"身份依固定《晉書》卷80完整王羲之及子孫附敘；跨篇同指及各項親屬、官序、紀年需分存來源判斷。本次只增來源/身份標記，不表示其他來源或後續無typed資料。未經人工/圖像核校。本傳以後父明其父為獻之，原稱安僖皇后；未從外部補個人名。","review":"ai_provisional"}],"source_mention_summary":[{"source_id":"s-jinshu-080-ws2603570-wangxizhi","work_id":"w-jinshu","book_id":"b-jinshu-080","chapter_id":"c-jinshu-080-wangxizhi","raw_mention_count":1,"mention_ids":["c-jinshu-080-wangxizhi:p047:m0062"],"paragraph_ids":["c-jinshu-080-wangxizhi:p047"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-080-wangxizhi:p047:m0062","mention_ids":["c-jinshu-080-wangxizhi:p047:m0062"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-080-ws2603570-wangxizhi"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-080-wangxizhi:p047:m0062","start":62,"end":66,"surface":"安僖皇后","kind":"person","person_id":"9q9_pka_hbi","status":"contextual_provisional","resolution_note":"依完整傳/附敘之敘事、引語發受話人與逐項身份覆核；非全域同字匹配。","paragraph_id":"c-jinshu-080-wangxizhi:p047","chapter_id":"c-jinshu-080-wangxizhi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-080-wangxizhi:p047","text":"未幾，獻之遇疾，家人為上章，道家法應首過，問其有何得失。對曰：「不覺餘事，惟憶與郗家離婚。」獻之前妻，郗曇女也。俄而卒於官。安僖皇后立，以後父追贈侍中、特進、光祿大夫、太宰，諡曰憲。無子，以兄子靜之嗣，位至義興太守。時議者以為羲之草隸，江左中朝莫有及者，獻之骨力遠不及父，而頗有媚趣。桓玄雅愛其父子書，各為一帙，置左右以玩之。始羲之所與共游者許邁。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-080-wangxizhi:p047:m0003","start":3,"end":5,"surface":"獻之","kind":"person","person_id":"sm1_jfi_7k2","status":"contextual_provisional","resolution_note":"依完整傳/附敘之敘事、引語發受話人與逐項身份覆核；非全域同字匹配。"},{"id":"c-jinshu-080-wangxizhi:p047:m0046","start":46,"end":48,"surface":"獻之","kind":"person","person_id":"sm1_jfi_7k2","status":"contextual_provisional","resolution_note":"依完整傳/附敘之敘事、引語發受話人與逐項身份覆核；非全域同字匹配。"},{"id":"c-jinshu-080-wangxizhi:p047:m0048","start":48,"end":50,"surface":"前妻","kind":"person","person_id":"lr9_qtc_tnz","status":"contextual_provisional","resolution_note":"依完整傳/附敘之敘事、引語發受話人與逐項身份覆核；非全域同字匹配。"},{"id":"c-jinshu-080-wangxizhi:p047:m0051","start":51,"end":53,"surface":"郗曇","kind":"person","person_id":"e5k_f2i_cog","status":"contextual_provisional","resolution_note":"依完整傳/附敘之敘事、引語發受話人與逐項身份覆核；非全域同字匹配。"},{"id":"c-jinshu-080-wangxizhi:p047:m0053","start":53,"end":54,"surface":"女","k