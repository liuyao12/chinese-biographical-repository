wangxizhi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-080-wangxizhi:p044","text":"起家州主簿、秘書郎，轉丞，以選尚新安公主。嘗經吳郡，聞顧辟彊有名園。先不相識，乘平肩輿徑入。時辟彊方集賓友，而獻之遊歷既畢，傍若無人。辟彊勃然數之曰：「傲主人，非禮也。以貴驕士，非道也。失是二者，不足齒之傖耳。」便驅出門。獻之傲如也，不以屑意。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-080-wangxizhi:p044:m0016","start":16,"end":20,"surface":"新安公主","kind":"person","person_id":"ysc_t4f_w1a","status":"contextual_provisional","resolution_note":"依完整傳/附敘之敘事、引語發受話人與逐項身份覆核；非全域同字匹配。"},{"id":"c-jinshu-080-wangxizhi:p044:m0027","start":27,"end":30,"surface":"顧辟彊","kind":"person","person_id":"ovt_36p_urc","status":"contextual_provisional","resolution_note":"依完整傳/附敘之敘事、引語發受話人與逐項身份覆核；非全域同字匹配。"},{"id":"c-jinshu-080-wangxizhi:p044:m0047","start":47,"end":49,"surface":"辟彊","kind":"person","person_id":"ovt_36p_urc","status":"contextual_provisional","resolution_note":"依完整傳/附敘之敘事、引語發受話人與逐項身份覆核；非全域同字匹配。"},{"id":"c-jinshu-080-wangxizhi:p044:m0055","start":55,"end":57,"surface":"獻之","kind":"person","person_id":"7r6_k52_qji_ABDCBE","status":"contextual_provisional","resolution_note":"依完整傳/附敘之敘事、引語發受話人與逐項身份覆核；非全域同字匹配。"},{"id":"c-jinshu-080-wangxizhi:p044:m0067","start":67,"end":69,"surface":"辟彊","kind":"person","person_id":"ovt_36p_urc","status":"contextual_provisional","resolution_note":"依完整傳/附敘之敘事、引語發受話人與逐項身份覆核；非全域同字匹配。"},{"id":"c-jinshu-080-wangxizhi:p044:m0111","start":111,"end":113,"surface":"獻之","kind":"person","person_id":"7r6_k52_qji_ABDCBE","status":"contextual_provisional","resolution_note":"依完整傳/附敘之敘事、引語發受話人與逐項身份覆核；非全域同字匹配。"}],"source_position":{"raw_start":6591,"raw_end":6715,"raw_character_offsets":[6593,6594,6595,6596,6597,6598,6599,6600,6601,6602,6603,6604,6605,6606,6607,6608,6609,6610,6611,6612,6613,6614,6615,6616,6617,6618,6619,6620,6621,