{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000600","identity_policy":"contextual_provisional","person_ids":["cbr-p000600"],"persons":[{"id":"cbr-p000600","label":"魏咎","status":"active","historicity":"historical_tradition","aliases":[{"surface":"魏咎","mention_ids":["c-shiji-006-shihuang:p058:m0144","c-shiji-006-shihuang:p059:m0133"]}],"evidence":[{"mention_id":"c-shiji-006-shihuang:p058:m0144","chapter_id":"c-shiji-006-shihuang","paragraph_id":"c-shiji-006-shihuang:p058","quote":"魏咎"},{"mention_id":"c-shiji-006-shihuang:p059:m0133","chapter_id":"c-shiji-006-shihuang","paragraph_id":"c-shiji-006-shihuang:p059","quote":"魏咎"}],"identity_note":"依本卷特定語境暫定人物；保留本文字形，不補未見姓名與讀法。","review":"ai_provisional"}],"mentions":[{"id":"c-shiji-006-shihuang:p058:m0144","start":144,"end":146,"surface":"魏咎","kind":"person","person_id":"cbr-p000600","status":"contextual_provisional","paragraph_id":"c-shiji-006-shihuang:p058","chapter_id":"c-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:p059:m0133","start":133,"end":135,"surface":"魏咎","kind":"person","person_id":"cbr-p000600","status":"contextual_provisional","paragraph_id":"c-shiji-006-shihuang:p059","chapter_id":"c-shiji-006-shihuang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-006-shihuang:p058","text":"七月，戍卒陳勝等反故荊地，為「張楚」。勝自立為楚王，居陳，遣諸將徇地。山東郡縣少年苦秦吏，皆殺其守尉令丞反，以應陳涉，相立為侯王，合從西鄉，名為伐秦，不可勝數也。謁者使東方來，以反者聞二世。二世怒，下吏。後使者至，上問，對曰：「群盜，郡守尉方逐捕，今盡得，不足憂。」上悅。武臣自立為趙王，魏咎為魏王，田儋為齊王。沛公起沛。項梁舉兵會稽郡。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:p058:m0005","start":5,"end":7,"surface":"陳勝","kind":"person","person_id":"cbr-p000598","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p058:m0019","start":19,"end":20,"surface":"勝","kind":"person","person_id":"cbr-p000598","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p058:m0023","start":23,"end":25,"surface":"楚王","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、官稱或待核指代；未補姓名、闕代與親屬成員。"},{"id":"c-shiji-006-shihuang:p058:m0056","start":56,"end":58,"surface":"陳涉","kind":"person","person_id":"cbr-p000598","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p058:m0092","start":92,"end":94,"surface":"二世","kind":"person","person_id":"cbr-p000534","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p058:m0095","start":95,"end":97,"surface":"二世","kind":"person","person_id":"cbr-p000534","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p058:m0103","start":103,"end":105,"surface":"使者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、官稱或待核指代；未補姓名、闕代與親屬成員。"},{"id":"c-shiji-006-shihuang:p058:m0136","start":136,"end":138,"surface":"武臣","kind":"person","person_id":"cbr-p000599","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p058:m0144","start":144,"end":146,"surface":"魏咎","kind":"person","person_id":"cbr-p000600","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p058:m0150","start":150,"end":152,"surface":"田儋","kind":"person","person_id":"cbr-p000601","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p058:m0156","start":156,"end":158,"surface":"沛公","kind":"person","person_id":"cbr-p000602","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p058:m0161","start":161,"end":163,"surface":"項梁","kind":"person","person_id":"cbr-p000603","status":"contextual_provisional"}],"chapter_id":"c-shiji-006-shihuang","book_id":"b-shiji-006","work_id":"w-shiji","source_id":"s-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:p059","text":"二年冬，陳涉所遣周章等將西至戲，兵數十萬。二世大驚，與群臣謀曰：「柰何？」少府章邯曰：「盜已至，眾彊，今發近縣不及矣。酈山徒多，請赦之，授兵以擊之。」二世乃大赦天下，使章邯將，擊破周章軍而走，遂殺章曹陽。二世益遣長史司馬欣、董翳佐章邯擊盜，殺陳勝城父，破項梁定陶，滅魏咎臨濟。楚地盜名將已死，章邯乃北渡河，擊趙王歇等於鉅鹿。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions"