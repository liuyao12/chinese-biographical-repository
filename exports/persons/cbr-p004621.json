{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004621","identity_policy":"contextual_provisional","person_ids":["cbr-p004621"],"persons":[{"id":"cbr-p004621","label":"白起（廉頗藺相如列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"秦將白起","mention_ids":["c-shiji-081-lianlin:m016-0017"]}],"evidence":[{"mention_id":"c-shiji-081-lianlin:m016-0017","chapter_id":"c-shiji-081-lianlin","paragraph_id":"c-shiji-081-lianlin:p016","quote":"秦將白起"}]}],"mentions":[{"id":"c-shiji-081-lianlin:m016-0017","start":17,"end":21,"surface":"秦將白起","kind":"person","person_id":"cbr-p004621","status":"contextual_provisional","paragraph_id":"c-shiji-081-lianlin:p016","chapter_id":"c-shiji-081-lianlin"}],"relations":[],"title_holdings":[{"id":"th-shiji081-021","person_id":"cbr-p004621","title":"秦將","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-081-lianlin","source_id":"s-shiji-081-lianlin","paragraph_id":"c-shiji-081-lianlin:p016","quote":"趙括既代廉頗，悉更約束，易置軍吏。秦將白起聞之，縱奇兵，詳敗走，而絶其糧道，分斷其軍爲二，士卒離心。四十餘日，軍餓，趙括出鋭卒自博戰，秦軍射殺趙括。括軍敗，數十萬之衆遂降秦，秦悉阬之。趙前後所亡凡四十五萬。明年，秦兵遂圍邯鄲，歳餘，幾不得脱。賴楚、魏諸侯來救，乃得解邯鄲之圍。趙王亦以括母先言，竟不誅也。"}],"attestations":[{"id":"th-shiji081-021:a001","paragraph_id":"c-shiji-081-lianlin:p016","start":17,"end":19,"surface":"秦將","person_mention_id":"c-shiji-081-lianlin:m016-0017","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"官名、角色及授任分存，各次將兵另列；首次用稱、病、逃亡、被俘或死亡不自動終止所有官爵，未明日期保持未定。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji081-022","person_id":"cbr-p004621","scope":"same_chapter","chapter_ids":["c-shiji-081-lianlin"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["秦將白起"],"evidence":[{"paragraph_id":"c-shiji-081-lianlin:p016","quote":"趙括既代廉頗，悉更約束，易置軍吏。秦將白起聞之，縱奇兵，詳敗走，而絶其糧道，分斷其軍爲二，士卒離心。四十餘日，軍餓，趙括出鋭卒自博戰，秦軍射殺趙括。括軍敗，數十萬之衆遂降秦，秦悉阬之。趙前後所亡凡四十五萬。明年，秦兵遂圍邯鄲，歳餘，幾不得脱。賴楚、魏諸侯來救，乃得解邯鄲之圍。趙王亦以括母先言，竟不誅也。"}],"rationale":"依本篇明示姓名、國別君序與代將敘事暫接；李牧牧在明示北邊主題內同指，趙王遷王稱限定末次代將。北邊早年趙王、他人及單于未名分存，不強接悼襄；太史公讓頗承接廉藺敘事，其他引語指代待逐處覆核。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-081-lianlin:p016","text":"趙括既代廉頗，悉更約束，易置軍吏。秦將白起聞之，縱奇兵，詳敗走，而絶其糧道，分斷其軍爲二，士卒離心。四十餘日，軍餓，趙括出鋭卒自博戰，秦軍射殺趙括。括軍敗，數十萬之衆遂降秦，秦悉阬之。趙前後所亡凡四十五萬。明年，秦兵遂圍邯鄲，歳餘，幾不得脱。賴楚、魏諸侯來救，乃得解邯鄲之圍。趙王亦以括母先言，竟不誅也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-081-lianlin:m016-0000","start":0,"end":2,"surface":"趙括","kind":"person","person_id":"cbr-p004619","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m016-0004","start":4,"end":6,"surface":"廉頗","kind":"person","person_id":"cbr-p004600","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m016-0014","start":14,"end":16,"surface":"軍吏","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未定角色或複數指代保存，不補姓名。"},{"id":"c-shiji-081-lianlin:m016-0017","start":17,"end":21,"surface":"秦將白起","kind":"person","person_id":"cbr-p004621","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m016-0058","start":58,"end":60,"surface":"趙括","kind":"person","person_id":"cbr-p004619","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m016-0071","start":71,"end":73,"surface":"趙括","kind":"person","person_id":"cbr-p004619","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m016-0074","start":74,"end":75,"surface":"括","kind":"person","person_id":"cbr-p004619","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m016-0078","start":78,"end":83,"surface":"數十萬之衆","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未定角色或複數指代保存，不補姓名。"},{"id":"c-shiji-081-lianlin:m016-0125","start":125,"end":127,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未定角色或複數指代保存，不補姓名。"},{"id":"c-shiji-081-lianlin:m016-0