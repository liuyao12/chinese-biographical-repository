ual_provisional"},{"id":"c-shiji-095-fankuang:m024-0220","start":220,"end":222,"surface":"項羽","kind":"person","person_id":"qcp_ou0_2g1","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0224","start":224,"end":226,"surface":"項冠","kind":"person","person_id":"uxv_exs_5k3","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0251","start":251,"end":253,"surface":"王武","kind":"person","person_id":"6sl_m8t_cxz","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0275","start":275,"end":277,"surface":"王武","kind":"person","person_id":"6sl_m8t_cxz","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0279","start":279,"end":281,"surface":"桓嬰","kind":"person","person_id":"snk_jy6_dgf","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0304","start":304,"end":306,"surface":"漢王","kind":"person","person_id":"vok_rjp_tag","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0315","start":315,"end":317,"surface":"韓信","kind":"person","person_id":"j4e_gam_0tl","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0327","start":327,"end":328,"surface":"嬰","kind":"person","person_id":"mdl_l60_pwy","status":"contextual_provisional"}],"chapter_id":"c-shiji-095-fankuang","book_id":"b-shiji-095","work_id":"w-shiji","source_id":"s-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:p025","text":"三年，以列侯食邑杜平鄉。以御史大夫受詔將郎中騎兵東屬相國韓信，擊破齊軍於歷下，所將卒虜車騎將軍華毋傷及將吏四十六人。降下臨菑，得齊守相田光。追齊相田橫至嬴、博，破其騎，所將卒斬騎將一人，生得騎將四人。攻下嬴、博，破齊將軍田吸於千乘，所將卒斬吸。東從韓信攻龍且、留公旋於高密，卒斬龍且，生得右司馬、連尹各一人，樓煩將十人，身生得亞將周蘭。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m025-0028","start":28,"end":30,"surface":"韓信","kind":"person","person_id":"j4e_gam_0tl","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m025-0047","start":47,"end":50,"surface":"華毋傷","kind":"person","person_id":"6mp_d5b_nax","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m025-0067","start":67,"end":69,"surface":"田光","kind":"person","person_id":"dnb_rcf_15u","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m025-0073","start":73,"end":75,"surface":"田橫","kind":"person","person_id":"7v9_n58_3l5","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m025-0110","start":110,"end":112,"surface":"田吸","kind":"person","person_id":"ybx_5gn_njg","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m025-0120","start":120,"end":121,"surface":"吸","kind":"person","person_id":"ybx_5gn_njg","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m025-0124","start":124,"end":126,"surface":"韓信","kind":"person","person_id":"j4e_gam_0tl","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m025-0127","start":127,"end":129,"surface":"龍且","kind":"person","person_id":"zip_jr2_0be","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m025-0130","start":130,"end":133,"surface":"留公旋","kind":"person","person_id":"bcq_8mf_d5t","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m025-0139","start":139,"end":141,"surface":"龍且","kind":"person","person_id":"zip_jr2_0be","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m025-0165","start":165,"end":167,"surface":"周蘭","kind":"person","person_id":"li0_tpv_g5x","status":"contextual_provisional"}],"chapter_id":"c-shiji-095-fankuang","book_id":"b-shiji-095","work_id":"w-shiji","source_id":"s-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:p026","text":"齊地已定，韓信自立為齊王，使嬰別將擊楚將公杲於魯北，破之。轉南，破薛郡長，身虜騎將一人。攻（博）［傅］陽，前至下相以東南僮、取慮、徐。度淮，盡降其城邑，至廣陵。項羽使項聲、薛公、郯公復定淮北。嬰度淮北，擊破項聲、郯公下邳，斬薛公，下下邳，擊破楚騎於平陽，遂降彭城，虜柱國項佗，降留、薛、沛、酂、蕭、相。攻苦、譙，復得亞將周蘭。與漢王會頤鄉。從擊項籍軍於陳下，破之，所將卒斬樓煩將二人，虜騎將八人。賜益食邑二千五百戶。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m026-0005","start":5,"end":7,"surface":"韓信","kind":"person","person_id":"j4e_gam_0tl","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0014","start":14,"end":15,"surface":"嬰","kind":"person","person_id":"mdl_l60_pwy","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0020","start":20,"end":22,"surface":"公杲","kind":"person","person_id":"p3e_kto_76o","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0080","start":80,"end":82,"surface":"項羽","kind":"person","person_id":"qcp_ou0_2g1","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0083","start":83,"end":85,"surface":"項聲","kind":"person","person_id":"97x_bw8_rqz","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0086","start":86,"end":88,"surface":"薛公","kind":"person","person_id":"1wy_ygt_gre","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0089","start":89,"end":91,"surface":"郯公","kind":"person","person_id":"bhy_6ln_wvi","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0096","start":96,"end":97,"surface":"嬰","kind":"person","person_id":"mdl_l60_pwy","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0103","start":103,"end":105,"surface":"項聲","kind":"person","person_id":"97x_bw8_rqz","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0106","start":106,"end":108,"surface":"郯公","kind":"person","person_id":"bhy_6ln_wvi","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0112","start":112,"end":114,"surface":"薛公","kind":"person","person_id":"1wy_ygt_gre","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0135","start":135,"end":137,"surface":"項佗","kind":"person","person_id":"9pq_9wn_9y1","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0160","start":160,"end":162,"surface":"周蘭","kind":"person","person_id":"li0_tpv_g5x","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0164","start":164,"end":166,"surface":"漢王","kind":"person","person_id":"vok_rjp_tag","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0172","start":172,"end":174,"surface":"項籍","kind":"person","person_id":"qcp_ou0_2g1","status":"contextual_provisional"}],"chapter_id":"c-shiji-095-fankuang","book_id":"b-shiji-095","work_id":"w-shiji","source_id":"s-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:p028","text":"漢王立為皇帝，賜益嬰邑三千戶。其秋，以車騎將軍從擊破燕王臧荼。明年，從至陳，取楚王信。還，剖符，世世勿絕，食潁陰二千五百戶，號曰潁陰侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m028-0000","start":0,"end":2,"surface":"漢王","kind":"person","person_id":"vok_rjp_tag","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m028-0009","start":9,"end":10,"surface":"嬰","kind":"person","person_id":"mdl_l60_pwy","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m028-0028","start":28,"end":30,"surface":"臧荼","kind":"person","person_id":"un2_jcz_dkt","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m028-0039","start":39,"end":42,"surface":"楚王信","kind":"person","person_id":"j4e_gam_0tl","status":"contextual_provisional"}],"chapter_id":"c-shiji-095-fankuang","book_id":"b-shiji-095","work_id":"w-shiji","source_id":"s-shiji-095-fankuang"}],"sources":[{"chapter_id":"c-shiji-095-fankuang","work_id":"w-shiji","book_id":"b-shiji-095","source_id":"s-shiji-095-fankuang","source":{"title":"史記／卷095","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷095","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷095&oldid=2298709","revision_id":2298709,"accessed_on":"2026-10-09","extent":"34段傳世正文含太史公論，另附1段分層索隱述贊；排除導覽與空白。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"固定HTML一致，只去外緣空白；樊噌、（肩）［屏］、（博）［傅］、（太卜）太仆、穎陰等原字保留。","note":"全37個HTML區塊已讀，未核底本影像。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_number