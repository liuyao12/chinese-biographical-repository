ang"},{"id":"c-shiji-095-fankuang:m025-0028","start":28,"end":30,"surface":"韓信","kind":"person","person_id":"j4e_gam_0tl","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p025","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:m025-0124","start":124,"end":126,"surface":"韓信","kind":"person","person_id":"j4e_gam_0tl","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p025","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:m026-0005","start":5,"end":7,"surface":"韓信","kind":"person","person_id":"j4e_gam_0tl","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p026","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:m028-0039","start":39,"end":42,"surface":"楚王信","kind":"person","person_id":"j4e_gam_0tl","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p028","chapter_id":"c-shiji-095-fankuang"}],"relations":[],"title_holdings":[{"id":"th-shiji095-019","person_id":"j4e_gam_0tl","title":"楚王","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-095-fankuang","source_id":"s-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p006","quote":"項籍既死，漢王為帝，以噲堅守戰有功，益食八百戶。從高帝攻反燕王臧荼，虜荼，定燕地。楚王韓信反，噲從至陳，取信，定楚。更賜爵列侯，與諸侯剖符，世世勿絕，食舞陽，號為舞陽侯，除前所食。以將軍從高祖攻反韓王信於代。自霍人以往至雲中，與絳侯等共定之，益食千五百戶。因擊陳豨與曼丘臣軍，戰襄國，破柏人，先登，降定清河、常山凡二十七縣，殘東垣，遷為左丞相。破得綦毋卹、尹潘軍於無終、廣昌。破豨別將胡人王黃軍於代南，因擊韓信軍於參合。軍所將卒斬韓信，破豨胡騎橫谷，斬將軍趙既，虜代丞相馮梁、守孫奮、大將王黃、將軍、（太卜）太仆解福等十人。與諸將共定代鄉邑七十三。其後燕王盧綰反，噲以相國擊盧綰，破其丞相抵薊南，定燕地，凡縣十八，鄉邑五十一。益食邑千三百戶，定食舞陽五千四百戶。從，斬首百七十六級，虜二百八十八人。別，破軍七，下城五，定郡六，縣五十二，得丞相一人，將軍十二人，二千石已下至三百石十一人。"}],"attestations":[{"id":"th-shiji095-019:a001","paragraph_id":"c-shiji-095-fankuang:p006","start":41,"end":43,"surface":"楚王","person_mention_id":"c-shiji-095-fankuang:m006-0041","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"原文實授、敘事用稱及諡稱分存；未明示時任期起訖未知。爵號用字不擅自補足，單稱侯不自動展開爵邑名；死亡、被捕、罷兵不自動作所有官爵終點。欲拜李必駱甲為騎將未作實授，左右校尉據實際令授。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji095-092","person_id":"j4e_gam_0tl","title":"相國","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-095-fankuang","source_id":"s-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p024","quote":"復以中謁者從降下碭，以至彭城。項羽擊，大破漢王。漢王遁而西，嬰從還，軍於雍丘。王武、魏公申徒反，從擊破之。攻下黃，西收兵，軍於滎陽。楚騎來眾，漢王乃擇軍中可為（車）騎將者，皆推故秦騎士重泉人李必、駱甲習騎兵，今為校尉，可為騎將。漢王欲拜之，必、甲曰：「臣故秦民，恐軍不信臣，臣願得大王左右善騎者傅之。」灌嬰雖少，然數力戰，乃拜灌嬰為中大夫，令李必、駱甲為左右校尉，將郎中騎兵擊楚騎於滎陽東，大破之。受詔別擊楚軍後，絕其餉道，起陽武至襄邑。擊項羽之將項冠於魯下，破之，所將卒斬右司馬、騎將各一人。擊破柘公王武，軍於燕西，所將卒斬樓煩將五人，連尹一人。擊王武別將桓嬰白馬下，破之，所將卒斬都尉一人。以騎渡河南，送漢王到雒陽，使北迎相國韓信軍於邯鄲。還至敖倉，嬰遷為御史大夫。"}],"attestations":[{"id":"th-shiji095-092:a001","paragraph_id":"c-shiji-095-fankuang:p024","start":313,"end":315,"surface":"相國","person_mention_id":"c-shiji-095-fankuang:m024-0315","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"原文實授、敘事用稱及諡稱分存；未明示時任期起訖未知。爵號用字不擅自補足，單稱侯不自動展開爵邑名；死亡、被捕、罷兵不自動作所有官爵終點。欲拜李必駱甲為騎將未作實授，左右校尉據實際令授。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji095-014","person_id":"j4e_gam_0tl","scope":"same_chapter","chapter_ids":["c-shiji-095-fankuang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["信","楚王信","楚王韓信","韓信"],"evidence":[{"paragraph_id":"c-shiji-095-fankuang:p006","quote":"項籍既死，漢王為帝，以噲堅守戰有功，益食八百戶。從高帝攻反燕王臧荼，虜荼，定燕地。楚王韓信反，噲從至陳，取信，定楚。更賜爵列侯，與諸侯剖符，世世勿絕，食舞陽，號為舞陽侯，除前所食。以將軍從高祖攻反韓王信於代。自霍人以往至雲中，與絳侯等共定之，益食千五百戶。因擊陳豨與曼丘臣軍，戰襄國，破柏人，先登，降定清河、常山凡二十七縣，殘東垣，遷為左丞相。破得綦毋卹、尹潘軍於無終、廣昌。破豨別將胡人王黃軍於代南，因擊韓信軍於參合。軍所將卒斬韓信，破豨胡騎橫谷，斬將軍趙既，虜代丞相馮梁、守孫奮、大將王黃、將軍、（太卜）太仆解福等十人。與諸將共定代鄉邑七十三。其後燕王盧綰反，噲以相國擊盧綰，破其丞相抵薊南，定燕地，凡縣十八，鄉邑五十一。益食邑千三百戶，定食舞陽五千四百戶。從，斬首百七十六級，虜二百八十八人。別，破軍七，下城五，定郡六，縣五十二，得丞相一人，將軍十二人，二千石已下至三百石十一人。"},{"paragraph_id":"c-shiji-095-fankuang:p020","quote":"漢王立為帝。其秋，燕王臧荼反，嬰以太僕從擊荼。明年，從至陳，取楚王信。更食汝陰，剖符世世勿絕。以太僕從擊代，至武泉、雲中，益食千戶。因從擊韓信軍胡騎晉陽旁，大破之。追北至平城，為胡所圍，七日不得通。高帝使使厚遺閼氏，冒頓開圍一角。高帝出欲馳，嬰固徐行，弩皆持滿外向，卒得脫。益食嬰細陽千戶。復以太僕從擊胡騎句注北，大破之。以太僕擊胡騎平城南，三陷陳，功為多，賜所奪邑五百戶。以太僕擊陳豨、黥布軍，陷陳卻敵，益食千戶，定食汝陰六千九百戶，除前所食。"},{"paragraph_id":"c-shiji-095-fankuang:p024","quote":"復以中謁者從降下碭，以至彭城。項羽擊，大破漢王。漢王遁而西，嬰從還，軍於雍丘。王武、魏公申徒反，從擊破之。攻下黃，西收兵，軍於滎陽。楚騎來眾，漢王乃擇軍中可為（車）騎將者，皆推故秦騎士重泉人李必、駱甲習騎兵，今為校尉，可為騎將。漢王欲拜之，必、甲曰：「臣故秦民，恐軍不信臣，臣願得大王左右善騎者傅之。」灌嬰雖少，然數力戰，乃拜灌嬰為中大夫，令李必、駱甲為左右校尉，將郎中騎兵擊楚騎於滎陽東，大破之。受詔別擊楚軍後，絕其餉道，起陽武至襄邑。擊項羽之將項冠於魯下，破之，所將卒斬右司馬、騎將各一人。擊破柘公王武，軍於燕西，所將卒斬樓煩將五人，連尹一人。擊王武別將桓嬰白馬下，破之，所將卒斬都尉一人。以騎渡河南，送漢王到雒陽，使北迎相國韓信軍於邯鄲。還至敖倉，嬰遷為御史大夫。"},{"paragraph_id":"c-shiji-095-fankuang:p025","quote":"三年，以列侯食邑杜平鄉。以御史大夫受詔將郎中騎兵東屬相國韓信，擊破齊軍於歷下，所將卒虜車騎將軍華毋傷及將吏四十六人。降下臨菑，得齊守相田光。追齊相田橫至嬴、博，破其騎，所將卒斬騎將一人，生得騎將四人。攻下嬴、博，破齊將軍田吸於千乘，所將卒斬吸。東從韓信攻龍且、留公旋於高密，卒斬龍且，生得右司馬、連尹各一人，樓煩將十人，身生得亞將周蘭。"},{"paragraph_id":"c-shiji-095-fankuang:p026","quote":"齊地已定，韓信自立為齊王，使嬰別將擊楚將公杲於魯北，破之。轉南，破薛郡長，身虜騎將一人。攻（博）［傅］陽，前至下相以東南僮、取慮、徐。度淮，盡降其城邑，至廣陵。項羽使項聲、薛公、郯公復定淮北。嬰度淮北，擊破項聲、郯公下邳，斬薛公，下下邳，擊破楚騎於平陽，遂降彭城，虜柱國項佗，降留、薛、沛、酂、蕭、相。攻苦、譙，復得亞將周蘭。與漢王會頤鄉。從擊項籍軍於陳下，破之，所將卒斬樓煩將二人，虜騎將八人。賜益食邑二千五百戶。"},{"paragraph_id":"c-shiji-095-fankuang:p028","quote":"漢王立為皇帝，賜益嬰邑三千戶。其秋，以車騎將軍從擊破燕王臧荼。明年，從至陳，取楚王信。還，剖符，世世勿絕，食潁陰二千五百戶，號曰潁陰侯。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定異稱。酈寄字況據第14段；夏侯嬰的嬰限定第16至21段，灌嬰限定第22至33段，桓嬰另人。第6與20、28段楚王信和反韓王信分人；未詳名王侯不補名。同名跨篇同指另待逐項證據。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-095-fankuang:p006","text":"項籍既死，漢王為帝，以噲堅守戰有功，益食八百戶。從高帝攻反燕王臧荼，虜荼，定燕地。楚王韓信反，噲從至陳，取信，定楚。更賜爵列侯，與諸侯剖符，世世勿絕，食舞陽，號為舞陽侯，除前所食。以將軍從高祖攻反韓王信於代。自霍人以往至雲中，與絳侯等共定之，益食千五百戶。因擊陳豨與曼丘臣軍，戰襄國，破柏人，先登，降定清河、常山凡二十七縣，殘東垣，遷為左丞相。破得綦毋卹、尹潘軍於無終、廣昌。破豨別將胡人王黃軍於代南，因擊韓信軍於參合。軍所將卒斬韓信，破豨胡騎橫谷，斬將軍趙既，虜代丞相馮梁、守孫奮、大將王黃、將軍、（太卜）太仆解福等十人。與諸將共定代鄉邑七十三。其後燕王盧綰反，噲以相國擊盧綰，破其丞相抵薊南，定燕地，凡縣十八，鄉邑五十一。益食邑千三百戶，定食舞陽五千四百戶。從，斬首百七十六級，虜二百八十八人。別，破軍七，下城五，定郡六，縣五十二，得丞相一人，將軍十二人，二千石已下至三百石十一人。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c