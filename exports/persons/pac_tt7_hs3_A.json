"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-wu061-panjun-6","subject_person_id":"pac_tt7_hs3_A","object_person_id":"pac_tt7_hs3","predicate":"father","qualifiers":{"source_term":"濬子翥"},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-061","chapter_id":"c-sanguozhi-061-panjun","source_id":"s-sanguozhi-061-panjun","paragraph_id":"c-sanguozhi-061-panjun:line014-pei04-01","quote":"吴书曰：骠骑将军步骘屯沤口，求召募诸郡以增兵。权以问濬，濬曰：「豪将在民间，耗乱为害，加骘有名势，在所所媚，不可听也。」权从之。中郎将豫章徐宗，有名士也，尝到京师，与孔融交结，然儒生诞节，部曲宽纵，不奉节度，为众作殿，濬遂斩之。其奉法不惮私议，皆此类也。归义隐蕃，以口辩为豪杰所善，濬子翥亦与周旋，馈饷之。濬闻大怒，疏责翥曰：「吾受国厚恩，志报以命，尔辈在都，当念恭顺，亲贤慕善，何故与降虏交，以粮饷之？在远闻此，心震面热，惆怅累旬。疏到，急就往使受杖一百，促责所饷。」当时人咸怪濬，而蕃果图叛诛夷，众乃归服。","subject_person_mention_id":"c-sanguozhi-061-panjun:line014-pei04-01:m0143","object_person_mention_id":"c-sanguozhi-061-panjun:line014-pei04-01:m0026"}],"interpretation_note":"以此來源所述兩端為據。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"a-wu061-panjun-7","subject_person_id":"pac_tt7_hs3_A","object_person_id":"pac_tt7_hs3","predicate":"father","qualifiers":{"source_term":"濬卒，子翥嗣"},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-061","chapter_id":"c-sanguozhi-061-panjun","source_id":"s-sanguozhi-061-panjun","paragraph_id":"c-sanguozhi-061-panjun:line018","quote":"　　赤烏二年，濬卒，子翥嗣。濬女配建昌侯孫慮。","subject_person_mention_id":"c-sanguozhi-061-panjun:line018:m0011","object_person_mention_id":"c-sanguozhi-061-panjun:line018:m0007"}],"interpretation_note":"以此來源所述兩端為據。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"a-wu061-panjun-10","subject_person_id":"ids_z6v_f03","object_person_id":"pac_tt7_hs3_A","predicate":"brother","qualifiers":{"source_term":"翥弟祕"},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-061","chapter_id":"c-sanguozhi-061-panjun","source_id":"s-sanguozhi-061-panjun","paragraph_id":"c-sanguozhi-061-panjun:line018-pei01-01","quote":"吴书曰：翥字文