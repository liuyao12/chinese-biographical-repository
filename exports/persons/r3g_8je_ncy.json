shu-036-wei-comparison:p006:m0002","c-jinshu-036-wei-comparison:p006:m0052","c-jinshu-036-wei-comparison:p006:m0234"],"paragraph_ids":["c-jinshu-036-wei-comparison:p003","c-jinshu-036-wei-comparison:p006"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-036-wei-comparison:p003:m0425","mention_ids":["c-jinshu-036-wei-comparison:p003:m0425"],"kind":"paragraph"},{"canonical_mention_id":"c-jinshu-036-wei-comparison:p006:m0002","mention_ids":["c-jinshu-036-wei-comparison:p006:m0002"],"kind":"paragraph"},{"canonical_mention_id":"c-jinshu-036-wei-comparison:p006:m0052","mention_ids":["c-jinshu-036-wei-comparison:p006:m0052"],"kind":"paragraph"},{"canonical_mention_id":"c-jinshu-036-wei-comparison:p006:m0234","mention_ids":["c-jinshu-036-wei-comparison:p006:m0234"],"kind":"paragraph"}],"mention_count":4,"duplicate_mention_count":0,"paragraph_occurrence_count":4,"table_occurrence_count":0,"passage_count":2,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"4處獨立位置，4個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu036-wei-ws2108231-rendered-comparison"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin036-xuan-fanchang-marriage","subject_person_id":"q1l_utb_rfn_**AAB","predicate":"spouse","object_person_id":"r3g_8je_ncy","status":"source_attested","qualifiers":{"source_term":"公主","source_terms":["武帝敕瓘第四子宣尚繁昌公主","宣尚公主"],"source_clause_binding":{"rule":"fixed_jin036_complete_unit_close_kin","slot":"xuan-fanchang-marriage"}},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-036","source_id":"s-jinshu036-wei-ws2108231-rendered-comparison","chapter_id":"c-jinshu-036-wei-comparison","paragraph_id":"c-jinshu-036-wei-comparison:p003","quote":"事平，朝議封瓘。瓘以克蜀之功，羣帥之力，二將跋扈，自取滅亡，雖運智謀，而無搴旗之效，固讓不受。除使持節、都督關中諸軍事、鎮西將軍，尋遷都督徐州諸軍事、鎮東將軍，增封菑陽侯，以余爵封弟實開陽亭侯。泰始初，轉征東將軍，進爵為公，都督青州諸軍事、青州刺史，加征東大將軍、青州牧。所在皆有政績。除征北大將軍、都督幽州諸軍事、幽州刺史、護烏桓校尉。至鎮，表立平州，後兼督之。于時幽并東有務桓，西有力微，並為邊害。瓘離間二虜，遂致嫌隙，於是務桓降而力微以憂死。朝廷嘉其功，賜一子亭侯。瓘乞以封弟，未受命而卒，子密受封為亭侯。瓘六男無爵，悉讓二弟，遠近稱之。累求入朝，既至，武帝善遇之，俄使旋鎮。咸甯初，徵拜尚書令，加侍中。性嚴整，以法禦下，視尚書若參佐，尚書郎若掾屬。瓘學問深博，明習文藝，與尚書郎敦煌索靖俱善草書，時人號為「一台二妙」。漢末張芝亦善草書，論者謂「瓘得伯英筋，靖得伯英肉」。太康初，遷司空，侍中、令如故。為政清簡，甚得朝野聲譽。武帝敕瓘第四子宣尚繁昌公主。瓘自以諸生之胄，婚對微素，抗表固辭，不許。又領太子少傅，加千兵百騎鼓吹之府。以日蝕，瓘與太尉汝南王亮、司徒魏舒俱遜位，帝不聽。","subject_person_mention_id":"c-jinshu-036-wei-comparison:p003:m0423","object_person_mention_id":"c-jinshu-036-wei-comparison:p003:m0425"},{"work_id":"w-jinshu","book_id":"b-jinshu-036","source_id":"s-jinshu036-wei-ws2108231-rendered-comparison","chapter_id":"c-jinshu-036-wei-comparison","paragraph_id":"c-jinshu-036-wei-comparison:p006","quote":"宣尚公主，數有酒色之過。楊駿素與瓘不平，駿復欲自專權重，宣若離婚，瓘必遜位，於是遂與黃門等毀之，諷帝奪宣公主。瓘慚懼，告老遜立。乃下詔曰：「司空瓘年未致仕，而遜讓歷年，欲及神志未衰，以果本情，至真之風，實感吾心。今聽其所執，進位太保，以公就第。給親兵百人，置長史、司馬、從事中郎掾屬；及大車、官騎、麾蓋、鼓吹諸威儀，一如舊典。給廚田十頃、園五十畝、錢百萬、絹五百匹；床帳簟褥，主者務令優備，以稱吾崇賢之意焉。」有司又奏收宣付廷尉，免瓘位，詔不許。帝后知黃門虛構，欲還復主，而宣疾亡。","subject_person_mention_id":"c-jinshu-036-wei-comparison:p006:m0000","object_person_mention_id":"c-jinshu-036-wei-comparison:p006:m0002"}],"interpretation_note":"賜婚命令不是父女證；p006宣尚公主及離婚敘事證婚配已存在；不填婚年。","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"id":"name-jin036-fan_chang-literal","person_id":"r3g_8je_ncy","surname":null,"ming":null,"hao":null,"title":"繁昌公主","additional_names":[],"chapter_id":"c-jinshu-036-wei-comparison","paragraph_id":"c-jinshu-036-wei-comparison:p003","person_mention_id":"c-jinshu-036-wei-comparison:p003:m0425","source_anchor":{"start":425,"end":429,"surface":"繁昌公主"},"quote":"事平，朝議封瓘。瓘以克蜀之功，羣帥之力，二將跋扈，自取滅亡，雖運智謀，而無搴旗之效，固讓不受。除使持節、都督關中諸軍事、鎮西將軍，尋遷都督徐州諸軍事、鎮東將軍，增封菑陽侯，以余爵封弟實開陽亭侯。泰始初，轉征東將軍，進爵為公，都督青州諸軍事、青州刺史，加征東大將軍、青州牧。所在皆有政績。除征北大將軍、都督幽州諸軍事、幽州刺史、護烏桓校尉。至鎮，表立平州，後兼督之。于時幽并東有務桓，西有力微，並為邊害。瓘離間二虜，遂致嫌隙，於是務桓降而力微以憂死。朝廷嘉其功，賜一子亭侯。瓘乞以封弟，未受命而卒，子密受封為亭侯。瓘六男無爵，悉讓二弟，遠近稱之。累求入朝，既至，武帝善遇之，俄使旋鎮。咸甯初，徵拜尚書令，加侍中。性嚴整，以法禦下，視尚書若參佐，尚書郎若掾屬。瓘學問深博，明習文藝，與尚書郎敦煌索靖俱善草書，時人號為「一台二妙」。漢末張芝亦善草書，論者謂「瓘得伯英筋，靖得伯英肉」。太康初，遷司空，侍中、令如故。為政清簡，甚得朝野聲譽。武帝敕瓘第四子宣尚繁昌公主。瓘自以諸生之胄，婚對微素，抗表固辭，不許。又領太子少傅，加千兵百騎鼓吹之府。以日蝕，瓘與太尉汝南王亮、司徒魏舒俱遜位，帝不聽。","status":"editorial_provisional","human_reviewed":false,"model":null,"work_id":"w-jinshu","book_id":"b-jinshu-036","source_id":"s-jinshu036-wei-ws2108231-rendered-comparison"}],"mentions":[{"id":"c-jinshu-036-wei-comparison:p003:m0425","start":425,"end":429,"surface":"繁昌公主","kind":"person","person_id":"r3g_8je_ncy","status":"contextual_provisional","paragraph_id":"c-jinshu-036-wei-comparison:p003","chapter_id":"c-jinshu-036-wei-comparison"},{"id":"c-jinshu-036-wei-comparison:p006:m0002","start":2,"end":4,"surface":"公主","kind":"person","person_id":"r3g_8je_ncy","status":"contextual_provisional","paragraph_id":"c-jinshu-036-wei-comparison:p006","chapter_id":"c-jinshu-036-wei-comparison"},{"id":"c-jinshu-036-wei-comparison:p006:m0052","start":52,"end":54,"surface":"公主","kind":"person","person_id":"r3g_8je_ncy","status":"contextual_provisional","paragraph_id":"c-jinshu-036-wei-comparison:p006","chapter_id":"c-jinshu-036-wei-comparison"},{"id":"c-jinshu-036-wei-comparison:p006:m0234","start":234,"end":235,"surface":"主","kind":"person","person_id":"r3g_8je_ncy","status":"contextual_provisional","paragraph_id":"c-jinshu-036-wei-comparison:p006","chapter_id":"c-jinshu-036-wei-comparison"}],"relations":[{"id":"a-jin036-xuan-fanchang-marriage","subject_person_id":"q1l_utb_rfn_**AAB","predicate":"spouse","object_person_id":"r3g_8je_ncy","status":"source_attested","qualifiers":{"source_term":"公主","source_terms":["武帝敕瓘第四子宣尚繁昌公主","宣尚公主"],"source_clause_b