tual_provisional"}],"chapter_id":"c-jinshu-036-wei-comparison","book_id":"b-jinshu-036","work_id":"w-jinshu","source_id":"s-jinshu036-wei-ws2108231-rendered-comparison"},{"id":"c-jinshu-036-wei-comparison:p006","text":"宣尚公主，數有酒色之過。楊駿素與瓘不平，駿復欲自專權重，宣若離婚，瓘必遜位，於是遂與黃門等毀之，諷帝奪宣公主。瓘慚懼，告老遜立。乃下詔曰：「司空瓘年未致仕，而遜讓歷年，欲及神志未衰，以果本情，至真之風，實感吾心。今聽其所執，進位太保，以公就第。給親兵百人，置長史、司馬、從事中郎掾屬；及大車、官騎、麾蓋、鼓吹諸威儀，一如舊典。給廚田十頃、園五十畝、錢百萬、絹五百匹；床帳簟褥，主者務令優備，以稱吾崇賢之意焉。」有司又奏收宣付廷尉，免瓘位，詔不許。帝后知黃門虛構，欲還復主，而宣疾亡。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","captured_source_position":{"unit_key":"p006","projection_ref":"source-evidence/jin036-wei-comparison/projection.json","capture_sha256":"6db27cbd14cb251ba7ab4e58e9064b02d808cd893b02c044e359c7ccedd73659","source_response_sha256":"6dc95bd5962acbb6d2e8d3854ee215d7693d07f11b5224e5bcaa53af7d531dfb","capture_kind":"fixed_revision_HTML_rendered_text_extract","revision_id":2108231,"parsed_block_index":8},"mentions":[{"id":"c-jinshu-036-wei-comparison:p006:m0000","start":0,"end":1,"surface":"宣","kind":"person","person_id":"q1l_utb_rfn_**AAB","status":"contextual_provisional"},{"id":"c-jinshu-036-wei-comparison:p006:m0002","start":2,"end":4,"surface":"公主","kind":"person","person_id":"r3g_8je_ncy","status":"contextual_provisional"},{"id":"c-jinshu-036-wei-comparison:p006:m0012","start":12,"end":14,"surface":"楊駿","kind":"person","person_id":"603_131_11e","status":"contextual_provisional"},{"id":"c-jinshu-036-wei-comparison:p006:m0016","start":16,"end":17,"surface":"瓘","kind":"person","person_id":"q1l_utb_rfn_**AA","status":"contextual_provisional"},{"id":"c-jinshu-036-wei-comparison:p006:m0020","start":20,"end":21,"surface":"駿","kind":"person","person_id":"603_131_11e","status":"contextual_provisional"},{"id":"c-jinshu-036-wei-comparison:p006:m0028","start":28,"end":29,"surface":"宣","kind":"person","person_id":"q1l_utb_rfn_**AAB","status":"contextual_provisional"},{"id":"c-jinshu-036-wei-comparison:p006:m0033","start":33,"end":34,"surface":"瓘","k