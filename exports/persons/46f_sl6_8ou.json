,9008,9009,9010,9011,9012,9013,9014,9015,9016],"revision_id":1762878},"mentions":[{"id":"c-nanqishu-054-recluses-complete:p067:m0002","start":2,"end":5,"surface":"沈驎士","kind":"person","person_id":"46f_sl6_8ou","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p067:m0006","start":6,"end":8,"surface":"雲禎","kind":"person","person_id":"46f_sl6_8ou","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p067:m0017","start":17,"end":19,"surface":"膺期","kind":"person","person_id":"gr7_me5_ol4","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-054-recluses-complete","book_id":"b-nanqishu-054","work_id":"w-nanqishu","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:p068","text":"　　驎士少好學，家貧，織簾誦書，口手不息。宋元嘉末，文帝令尚書僕射何尚之抄撰五經，訪舉學士，縣以驎士應選。尚之謂子偃曰：「山東故有奇士也。」少時，驎士稱疾歸郷，更不與人物通。養孤兄子，義著郷曲。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":174,"last_line":174,"raw_start":9019,"raw_end":9116,"raw_character_offsets":[9019,9020,9021,9022,9023,9024,9025,9026,9027,9028,9029,9030,9031,9032,9033,9034,9035,9036,9037,9038,9039,9040,9041,9042,9043,9044,9045,9046,9047,9048,9049,9050,9051,9052,9053,9054,9055,9056,9057,9058,9059,9060,9061,9062,9063,9064,9065,9066,9067,9068,9069,9070,9071,9072,9073,9074,9075,9076,9077,9078,9079,9080,9081,9082,9083,9084,9085,9086,9087,9088,9089,9090,9091,9092,9093,9094,9095,9096,9097,9098,9099,9100,9101,9102,9103,9104,9105,9106,9107,9108,9109,9110,9111,9112,9113,9114,9115],"revision_id":1762878},"mentions":[{"id":"c-nanqishu-054-recluses-complete:p068:m0002","start":2,"end":4,"surface":"驎士","kind":"person","person_id":"46f_sl6_8ou","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p068:m0033","start":33,"end":36,"surface":"何尚之","kind":"person","person_id":"d84_kqu_2g5","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p068:m0048","start":48,"end":50,"surface":"驎士","kind":"person","person_id":"46f_sl6_8ou","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p068:m0053","start":53,"end":55,"surface":"尚之","kind":"person","person_id":"d84_kqu_2g5","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p068:m0057","start":57,"end":58,"surface":"偃","kind":"person","person_id":"pbz_pni_tco","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p068:m0073","start":73,"end":75,"surface":"驎士","kind":"person","person_id":"46f_sl6_8ou","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-054-recluses-complete","book_id":"b-nanqishu-054","work_id":"w-nanqishu","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:p069","text":"　　或勸驎士仕，答曰：「魚縣獸檻，天下一契，聖人玄悟，所以每履吉先。吾誠未能景行坐忘，何爲不希企日損。」乃作《玄散賦》以絕世。太守孔山士辟，不應。宗人徐州刺史曇慶、侍中懷文、左率勃來候之，驎士未嘗答也。隱居餘不吳差山，講經教授，從學者數十百人，各營屋宇，依止其側。驎士重陸機《連珠》，每爲諸生講之。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":176,"last_line":176,"raw_start":9118,"raw_end":9267,"raw_character_offsets":[9118,9119,9120,9121,9122,9123,9124,9125,9126,9127,9128,9129,9130,9131,9132,9133,9134,9135,9136,9137,9138,9139,9140,9141,9142,9143,9144,9145,9146,9147,9148,9149,9150,9151,9152,9153,9154,9155,9156,9157,9158,9159,9160,9161,9162,9163,9164,9165,9166,9167,9168,9169,9170,9171,9172,9173,9174,9175,9176,9177,9178,9179,9180,9181,9182,9183,9184,9185,9186,9187,9188,9189,9190,9191,9192,9193,9194,9195,9196,9197,9198,9199,9200,9201,9202,9203,9204,9205,9206,9207,9208,9209,9210,9211,9212,9213,9214,9215,9216,9217,9218,9219,9220,9221,9222,9223,9224,9225,9226,9227,9228,9229,9230,9231,9232,9233,9234,9235,9236,9237,9238,9239,9240,9241,9242,9243,9244,9245,9246,9247,9248,9249,9250,9251,9252,9253,9254,9255,9256,9257,9258,9259,9260,9261,9262,9263,9264,9265,9266],"revision_id":1762878},"mentions":[{"id":"c-nanqishu-054-recluses-complete:p069:m0004","start":4,"end":6,"surface":"驎士","kind":"person","person_id":"46f_sl6_8ou","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p069:m0065","start":65,"end":68,"surface":"孔山士","kind":"person","person_id":"940_0ui_v3o","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p069:m0079","start":79,"end":81,"surface":"曇慶","kind":"person","person_id":"mr2_8h9_bgl","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p069:m0084","start":84,"end":86,"surface":"懷文","kind":"person","person_id":"njd_hwp_506","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p069:m0089","start":89,"end":90,"surface":"勃","kind":"person","person_id":"k7j_9yf_vhd","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p069:m0094","start":94,"end":96,"surface":"驎士","kind":"person","person_id":"46f_sl6_8ou","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p069:m0132","start":132,"end":134,"surface":"驎士","kind":"person","person_id":"46f_sl6_8ou","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-054-recluses-complete","book_id":"b-nanqishu-054","work_id":"w-nanqishu","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:p070","text":"　　征北張永爲吳興，請驎士入郡。驎士聞郡後堂有好山水，乃往停數月。永欲請爲功曹，使人致意。驎士曰：「明府德履沖素，留心山谷，民是以被褐負杖，忘其疲病。必欲飾渾沌以蛾眉，冠越客於文冕，走雖不敏，請附高節，有蹈東海而死爾。」永乃止。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":178,"last_line":178,"raw_start":9269,"raw_end":9383,"raw_character_offsets":[9269,9270,9271,9272,9273,9274,9275,9276,9277,9278,9279,9280,9281,9282,9283,9284,9285,9286,9287,9288,9289,9290,9291,9292,9293,9294,9295,9296,9297,9298,9299,9300,9301,9302,9303,9304,9305,9306,9307,9308,9309,9310,9311,9312,9313,9314,9315,9316,9317,9318,9319,9320,9321,9322,9323,9324,9325,9326,9327,9328,9329,9330,9331,9332,9333,9334,9335,9336,9337,9338,9339,9340,9341,9342,9343,9344,9345,9346,9347,9348,9349,9350,9351,9352,9353,9354,9355,9356,9357,9358,9359,9360,9361,9362,9363,9364,9365,9366,9367,9368,9369,9370,9371,9372,9373,9374,9375,9376,9377,9378,9379,9380,9381,9382],"revision_id":1762878},"mentions":[{"id":"c-nanqishu-054-recluses-complete:p070:m0004","start":4,"end":6,"surface":"張永","kind":"person","person_id":"d50_8f5_wul_AAAAE","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p070:m0011","start":11,"end":13,"surface":"驎士","kind":"person","person_id":"46f_sl6_8ou","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p070:m0016","start":16,"end":18,"surface":"驎士","kind":"person","person_id":"46f_sl6_8ou","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p070:m0033","start":33,"end":34,"surface":"永","kind":"person","person_id":"d50_8f5_wul_AAAAE","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p070:m0045","start":45,"end":47,"surface":"驎士","kind":"person","person_id":"46f_sl6_8ou","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-054-recluses-complete","book_id":"b-nanqishu-054","work_id":"w-nanqishu","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:p071","text":"　　昇明末，太守王奐上表薦之，詔徵爲奉朝請，不就。永明六年，吏部郎沈淵、中書郎沈約又表薦驎士義行，曰：「吳興沈驎士，英風夙挺，峻節早樹，貞粹稟於天然，綜博生乎篤習。家世孤貧，藜藿不給，懷書而耕，白首無倦，挾琴採薪，行歌不輟。長兄早卒，孤姪數四，攝尪鞠稚，吞苦推甘。年踰七十，業行無改。元嘉以來，聘召仍疊，玉質踰潔，霜操日嚴。若使聞政王庭，服道槐掖，必能孚朝規於邊鄙，播聖澤於荒垂。」詔又徵爲太學博士，建武二年，徵著作郎，永元二年，徵太子舍人，竝不就。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":180,"last_line":180,"raw_start":9385,"raw_end":9610,"raw_character_offsets":[9385,9386,9387,9388,9389,9390,9391,9392,9393,9394,9395,9396,9397,9398,9399,9400,9401,9402,9403,9404,9405,9406,9407,9408,9409,9410,9411,9412,9413,9414,9415,9416,9417,9418,9419,9420,9421,9422,9423,9424,9425,9426,9427,9428,9429,9430,9431,9432,9433,9434,9435,9436,9437,9438,9439,9440,9441,9442,9443,9444,9445,9446,9447,9448,9449,9450,9451,9452,9453,9454,9455,9456,9457,9458,9459,9460,9461,9462,9463,9464,9465,9466,9467,9468,9469,9470,9471,9472,9473,9474,9475,9476,9477,9478,9479,9480,9481,9482,9483,9484,9485,9486,9487,9488,9489,9490,9491,9492,9493,9494,9495,9496,9497,9498,9499,9500,9501,9502,9503,9504,9505,9506,9507,9508,9509,9510,9511,9512,9513,9514,9515,9516,9517,9518,9519,9520,9521,9522,9523,9524,9525,9526,9527,9528,9529,9530,9531,9532,9533,9534,9535,9536,9537,9538,9539,9540,9541,9542,9543,9544,9545,9546,9547,9548,9549,9550,9551,9552,9553,9554,9555,9556,9557,9558,9559,9560,9561,9562,9563,9564,9565,9566,9567,9568,9569,9570,9571,9572,9573,9574,9575,9576,9577,9578,9579,9580,9581,9582,9583,9584,9585,9586,9587,9588,9589,9590,9591,9592,9593,9594,9595,9596,9597,9598,9599,9600,9601,9602,9603,9604,9605,9606,9607,9608,9609],"revision_id":1762878},"mentions":[{"id":"c-nanqishu-054-recluses-complete:p071:m0008","start":8,"end":10,"surface":"王奐","kind":"person","person_id":"q7m_r8k_2vn_AA","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p071:m0033","start":33,"end":35,"surface":"沈淵","kind":"person","person_id":"r80_ijz_5vy","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p071:m0039","start":39,"end":41,"surface":"沈約","kind":"person","person_id":"p8b_7w1_y3q","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p071:m0044","start":44,"end":46,"surface":"驎士","kind":"person","person_id":"46f_sl6_8ou","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p071:m0054","start":54,"end":57,"surface":"沈驎士","kind":"person","person_id":"46f_sl6_8ou","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-054-recluses-complete","book_id":"b-nanqishu-054","work_id":"w-nanqishu","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:p072","text":"　　驎士負薪汲水，幷日而食，守操終老。篤學不倦，遭火，燒書數千卷，驎士年過八十，耳目猶聦明，手以反故抄寫，火下細書，復成二三千卷，滿數十篋，時人以爲養身靜嘿之所致也。著《周易兩繫莊子內篇訓》，注《易經》、《禮記》、《春秋》、《尚書》、《論語》、《孝經》、《喪服》、《老子》要略數十卷。以楊王孫、皇甫謐深達生死，而終禮矯偽，乃自作終制。年八十六，卒。","text_layer":"received_chapter","annotation_status":"reviewed","so