b_f8w","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m011-0075","start":75,"end":79,"surface":"生子三人","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或未核定指代；未由熟知世系補造人物。"},{"id":"c-shiji-005-qin:m011-0082","start":82,"end":84,"surface":"武公","kind":"person","person_id":"y97_huh_vuz_AAAB","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m011-0088","start":88,"end":90,"surface":"武公","kind":"person","person_id":"y97_huh_vuz_AAAB","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m011-0091","start":91,"end":93,"surface":"德公","kind":"person","person_id":"y97_huh_vuz_AAAA","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m011-0096","start":96,"end":99,"surface":"魯姬子","kind":"person","person_id":"zbu_bun_98q","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m011-0101","start":101,"end":103,"surface":"出子","kind":"person","person_id":"y97_huh_vuz_AAAC","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m011-0104","start":104,"end":106,"surface":"寧公","kind":"person","person_id":"vs8_u6b_f8w","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m011-0108","start":108,"end":113,"surface":"大庶長弗忌","kind":"person","person_id":"zkl_2cm_e8u","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m011-0114","start":114,"end":116,"surface":"威壘","kind":"person","person_id":"mp8_xcr_ihc","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m011-0117","start":117,"end":119,"surface":"三父","kind":"person","person_id":"3v2_uap_0g0","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m011-0124","start":124,"end":126,"surface":"出子","kind":"person","person_id":"y97_huh_vuz_AAAC","status":"contextual_provisional"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-005-qin:p012","text":"出子六年，三父等復共令人賊殺出子。出子生五歲立，立六年卒。三父等乃復立故太子武公。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m012-0000","start":0,"