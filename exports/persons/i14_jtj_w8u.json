provisional","paragraph_id":"c-songshu-048-maoxiuzhi:p005","chapter_id":"c-songshu-048-maoxiuzhi"}],"relations":[],"title_holdings":[{"id":"th-songshu-047-liujingxuan-12-59","title":"龍驤將軍","kind":"office","mode":"attestation","person_id":"i14_jtj_w8u","attestations":[{"id":"th-songshu-047-liujingxuan-12-59:a","paragraph_id":"c-songshu-047-liujingxuan:p012","start":59,"end":63,"surface":"龍驤將軍","person_mention_id":"c-songshu-047-liujingxuan:p012:m0063","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-047","chapter_id":"c-songshu-047-liujingxuan","source_id":"s-songshu-047-liujingxuan-ws2190557","paragraph_id":"c-songshu-047-liujingxuan:p012","quote":"假敬宣節，監征蜀諸軍事，郡如故。既入峽，分遣振武將軍、巴東太守溫祚以二千人揚聲外水，自率益州刺史鮑陋、輔國將軍文處茂、龍驤將軍時延祖由墊江而進。敬宣率先士卒，轉戰而前，達遂寧郡之黃虎，去成都五百里。偽輔國將軍譙道福等悉眾距險，相持六十餘日，大小十餘戰，賊固守不敢出。敬宣不得進，食糧盡，軍中多疾疫，死者太半，引軍還。譙縱送毛璩一門諸喪，其妻女、文處茂母何，并諸士人喪柩，浮之中流，敬宣皆拯接致歸。為有司所奏，免官，削封三分之一。","person_mention_id":"c-songshu-047-liujingxuan:p012:m0063"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-songshu-047-liujingxuan:p012","text":"假敬宣節，監征蜀諸軍事，郡如故。既入峽，分遣振武將軍、巴東太守溫祚以二千人揚聲外水，自率益州刺史鮑陋、輔國將軍文處茂、龍驤將軍時延祖由墊江而進。敬宣率先士卒，轉戰而前，達遂寧郡之黃虎，去成都五百里。偽輔國將軍譙道福等悉眾距險，相持六十餘日，大小十餘戰，賊固守不敢出。敬宣不得進，食糧盡，軍中多疾疫，死者太半，引軍還。譙縱送毛璩一門諸喪，其妻女、文處茂母何，并諸士人喪柩，浮之中流，敬宣皆拯接致歸。為有司所奏，免官，削封三分之一。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":67,"last_line":67,"raw_start":6932,"raw_end":7146,"raw_character_offsets":[6932,6933,6934,6935,6936,6937,6938,6939,6940,6941,6942,6943,6944,6945,6946,6947,6948,6949,6950,6951,