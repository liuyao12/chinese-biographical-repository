hiji-074-mengxun","s-shiji112-pingjin","s-shiji130-taishigong"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-006-shihuang:p064:block07:m0045","start":45,"end":47,"surface":"墨翟","kind":"person","person_id":"tjx_q6x_kc7","status":"contextual_provisional","paragraph_id":"c-shiji-006-shihuang:p064:block07","chapter_id":"c-shiji-006-shihuang"},{"id":"c-shiji-074-mengxun:m012-0068","start":68,"end":70,"surface":"墨翟","kind":"person","person_id":"tjx_q6x_kc7","status":"contextual_provisional","paragraph_id":"c-shiji-074-mengxun:p012","chapter_id":"c-shiji-074-mengxun"},{"id":"c-shiji-112-pingjin:m015-0068","start":68,"end":69,"surface":"墨","kind":"person","person_id":"tjx_q6x_kc7","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p015","chapter_id":"c-shiji-112-pingjin"},{"id":"c-shiji-130-taishigong:m003-0749","start":749,"end":751,"surface":"墨子","kind":"person","person_id":"tjx_q6x_kc7","status":"contextual_provisional","paragraph_id":"c-shiji-130-taishigong:p003","chapter_id":"c-shiji-130-taishigong"}],"relations":[],"title_holdings":[{"id":"th-shiji074-010","person_id":"tjx_q6x_kc7","title":"大夫","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-074-mengxun","source_id":"s-shiji-074-mengxun","paragraph_id":"c-shiji-074-mengxun:p012","quote":"而趙亦有公孫龍為堅白同異之辯，劇子之言；魏有李悝，盡地力之教；楚有尸子、長盧；阿之吁子焉。自如孟子至于吁子，世多有其書，故不論其傳云。蓋墨翟，宋之大夫，善守御，為節用。或曰并孔子時，或曰在其後。"}],"attestations":[{"id":"th-shiji074-010:a001","paragraph_id":"c-shiji-074-mengxun:p012","start":73,"end":75,"surface":"大夫","person_mention_id":"c-shiji-074-mengxun:m012-0068","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予、文獻用稱與任事分存，未知日期與終點不補；淳于髡欲以卿相位待而謝去不作已任，春申君死亡不直接作全部爵位終點。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji074-053","person_id":"tjx_q6x_kc7","scope":"same_chapter","chapter_ids":["c-shiji-074-mengxun"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"依本段明示人名及局部敘事暫接，淳于髡髡先生、騶奭奭與晏嬰晏各限所述範圍；管引古不補管仲。薦髡客子稱及兩次獻馬獻謳者保留未名候選，不確證不同匿名人物。齊王命列大夫與齊宣、齊襄王分候選，未因敘事相鄰自動同指；群體之徒、之屬及學說合稱不補成員。欲以卿相待而謝去不當任官，李斯弟子不當子嗣，墨翟年代或曰異說保留。","surfaces":["墨翟"],"evidence":[{"paragraph_id":"c-shiji-074-mengxun:p012","quote":"而趙亦有公孫龍為堅白同異之辯，劇子之言；魏有李悝，盡地力之教；楚有尸子、長盧；阿之吁子焉。自如孟子至于吁子，世多有其書，故不論其傳云。蓋墨翟，宋之大夫，善守御，為節用。或曰并孔子時，或曰在其後。"}]},{"id":"d-shiji130-remaining11-001","person_id":"tjx_q6x_kc7","scope":"cross_chapter","chapter_ids":["c-shiji-130-taishigong","c-shiji-074-mengxun"],"status":"contextual_provisional","confidence_level":"high","source_context_confidence":"high_contextual","surfaces":["墨子"],"identification_basis":{"kind":"source_context","target_mention_ids":["c-shiji-130-taishigong:m003-0749"]},"evidence":[{"chapter_id":"c-shiji-130-taishigong","paragraph_id":"c-shiji-130-taishigong:p003","quote":"太史公學天官於唐都，受易於楊何，習道論於黃子。太史公仕於建元元封之閒，愍學者之不達其意而師悖，乃論六家之要指曰：\n《易大傳》：「天下一致而百慮，同歸而殊涂。」夫陰陽、儒、墨、名、法、道德，此務為治者也，直所從言之異路，有省不省耳。嘗竊觀陰陽之術，大祥而眾忌諱，使人拘而多所畏；然其序四時之大順，不可失也。儒者博而寡要，勞而少功，是以其事難盡從；然其序君臣父子之禮，列夫婦長幼之別，不可易也。墨者儉而難遵，是以其事不可遍循；然其彊本節用，不可廢也。法家嚴而少恩；然其正君臣上下之分，不可改矣。名家使人儉而善失真；然其正名實，不可不察也。道家使人精神專一，動合無形，贍足萬物。其為術也，因陰陽之大順，采儒墨之善，撮名法之要，與時遷移，應物變化，立俗施事，無所不宜，指約而易操，事少而功多。儒者則不然。以為人主天下之儀表也，主倡而臣和，主先而臣隨。如此則主勞而臣逸。至於大道之要，去健羨，絀聰明，釋此而任術。夫神大用則竭，形大勞則敝。形神騷動，欲與天地長久，非所聞也。\n夫陰陽四時、八位、十二度、二十四節各有教令，順之者昌，逆之者不死則亡，未必然也，故曰「使人拘而多畏」。夫春生夏長，秋收冬藏，此天道之大經也，弗順則無以為天下綱紀，故曰「四時之大順，不可失也」。\n夫儒者以六藝為法。六藝經傳以千萬數，累世不能通其學，當年不能究其禮，故曰「博而寡要，勞而少功」。若夫列君臣父子之禮，序夫婦長幼之別，雖百家弗能易也。\n墨者亦尚堯舜道，言其德行曰：「堂高三尺，土階三等，茅茨不翦，采椽不刮。食土簋，啜土刑，糲粱之食，藜霍之羹。夏日葛衣，冬日鹿裘。」其送死，桐棺三寸，舉音不盡其哀。教喪禮，必以此為萬民之率。使天下法若此，則尊卑無別也。夫世異時移，事業不必同，故曰「儉而難遵」。要曰彊本節用，則人給家足之道也。此墨子之所長，雖百長弗能廢也。\n法家不別親疏，不殊貴賤，一斷於法，則親親尊尊之恩絕矣。可以行一時之計，而不可長用也，故曰「嚴而少恩」。若尊主卑臣，明分職不得相踰越，雖百家弗能改也。\n名家苛察繳繞，使人不得反其意，專決於名而失人情，故曰「使人儉而善失真」。若夫控名責實，參伍不失，此不可不察也。\n道家無為，又曰無不為，其實易行，其辭難知。其術以虛無為本，以因循為用。無成埶，無常形，故能究萬物之情。不為物先，不為物後，故能為萬物主。有法無法，因時為業；有度無度，因物與合。故曰「聖人不朽，時變是守。虛者道之常也，因者君之綱」也。群臣并至，使各自明也。其實中其聲者謂之端，實不中其聲者謂之窾。窾言不聽，姦乃不生，賢不肖自分，白黑乃形。在所欲用耳，何事不成。乃合大道，混混冥冥。光燿天下，復反無名。凡人所生者神也，所讬者形也。神大用則竭，形大勞則敝，形神離則死。死者不可復生，離者不可復反，故聖人重之。由是觀之，神者生之本也，形者生之具也。不先定其神［形］，而曰「我有以治天下」，何由哉？"},{"chapter_id":"c-shiji-074-mengxun","paragraph_id":"c-shiji-074-mengxun:p012","quote":"而趙亦有公孫龍為堅白同異之辯，劇子之言；魏有李悝，盡地力之教；楚有尸子、長盧；阿之吁子焉。自如孟子至于吁子，世多有其書，故不論其傳云。蓋墨翟，宋之大夫，善守御，為節用。或曰并孔子時，或曰在其後。"}],"prior_source_qualifications":[{"source_mention_ids":["c-shiji-130-taishigong:m003-0749"],"metadata":{"label":"墨子（太史公自序候選）","status":"active","historicity":"historical_tradition"},"original_registry_record_sha256":"4b752a04459e1d612bc06d81bba79a5f275761a77ff386774b31a0a8ce777b02","qualification":"合併前來源限定人物label/status/historicity逐值保留；非對現役人物資格的改寫。"}],"identity_scope_qualifications":{"source_specific_review":"130p003父太史公六家論墨子節用，074p012明墨翟為節用、守御；不把墨家群體都變為墨翟本人，保與孔子同時/稍後的本傳並說。","new_event_kinship_date_assertions":false,"quote_attribution_verified":null,"confidence":"high_contextual","source_historicity_not_overwritten":true},"rationale":"130p003父太史公六家論墨子節用，074p012明墨翟為節用、守御；不把墨家群體都變為墨翟本人，保與孔子同時/稍後的本傳並說。 僅辨同一來源人物，保原字、篇題引用、人名錨及頻次；不由此新增親屬或紀年。","human_reviewed":false,"model":null}],"equivalence_decisions":[{"id":"eq-shiji112-exemplars-mo","person_ids":["tjx_q6x_kc7"],"canonical_person_id":"tjx_q6x_kc7","status":"contextual_provisional","scope":"cross_chapter","chapter_ids":["c-shiji-112-pingjin","c-shiji-006-shihuang","c-shiji-074-mengxun"],"evidence":[{"chapter_id":"c-shiji-112-pingjin","source_id":"s-shiji112-pingjin","paragraph_id":"c-shiji-112-pingjin:p015","quote":"臣聞天下之患在於土崩，不在於瓦解，古今一也。何謂土崩？秦之末世是也。陳涉無千乘之尊，尺土之地，身非王公大人名族之后，無鄉曲之譽，非有孔、墨、曾子之賢，陶朱、猗頓之富也，然起窮巷，奮棘矜，偏袒大呼而天下從風，此其故何也？由民困而主不恤，下怨而上不知（也），俗已亂而政不修，此三者陳涉之所以為資也。是之謂土崩。故曰天下之患在於土崩。何謂瓦解？吳、楚、齊、趙之兵是也。七國謀為大逆，號皆稱萬乘之君，帶甲數十萬，威足以嚴其境內，財足以勸其士民，然不能西攘尺寸之地而身為禽於中原者，此其故何也？非權輕於匹夫而兵弱於陳涉也，當是之時，先帝之德澤未衰而安土樂俗之民眾，故諸侯無境外之助。此之謂瓦解，故曰天下之患不在瓦解。由是觀之，天下誠有土崩之勢，雖布衣窮處之士或首惡而危海內，陳涉是也。況三晉之君或存乎！天下雖未有大治也，誠能無土崩之勢，雖有彊國勁兵不得旋踵而身為禽矣，吳、楚、齊、趙是也。況群臣百姓能為亂乎哉！此二體者，安危之明要也，賢主所留意而深察也。","mention_ids":["c-shiji-112-pingjin:m015-0068"],"text_layer":"received_chapter"},{"chapter_id":"c-shiji-006-shihuang","source_id":"s-shiji-006-shihuang","paragraph_id":"c-shiji-006-shihuang:p064:block07","quote":"秦王既沒，餘威振於殊俗。陳涉，罋牖繩樞之子，甿隸之人，而遷徙之徒，才能不及中人，非有仲尼、墨翟之賢，陶朱、猗頓之富，躡足行伍之閒，而倔起什伯之中，率罷散之卒，將數百之眾，而轉攻秦。斬木為兵，揭竿為旗，天下雲集響應，贏糧而景從，山東豪俊遂并起而亡秦族矣。","mention_ids":["c-shiji-006-shihuang:p064:block07:m0045"],"text_layer":"received_chapter"},{"chapter_id":"c-shiji-074-mengxun","source_id":"s-shiji-074-mengxun","paragraph_id":"c-shiji-074-mengxun:p012","quote":"而趙亦有公孫龍為堅白同異之辯，劇子之言；魏有李悝，盡地力之教；楚有尸子、長盧；阿之吁子焉。自如孟子至于吁子，世多有其書，故不論其傳云。蓋墨翟，宋之大夫，善守御，為節用。或曰并孔子時，或曰在其後。","mention_ids":["c-shiji-074-mengxun:m012-0068"],"text_layer":"received_chapter"}],"rationale":"孔墨曾子之賢的墨，按始皇篇同為陳涉才能對比所稱墨翟與孟荀傳墨翟暫接；墨家群稱不由此全域標成墨翟。 原文、引古與附詔層各存；不以引用時間當人物存世或授官時間。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true}],"passages":[{"id":"c-shiji-006-shihuang:p064:block07","text":"秦王既沒，餘威振於殊俗。陳涉，罋牖繩樞之子，甿隸之人，而遷徙之徒，才能不及中人，非有仲尼、墨翟之賢，陶朱、猗頓之富，躡足行伍之閒，而倔起什伯之中，率罷散之卒，將數百之眾，而轉攻秦。斬木為兵，揭竿為旗，天下雲集響應，贏糧而景從，山東豪俊遂并起而亡秦族矣。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:p064:block07:m0000","start":0,"end":2,"surface":"秦王","kind":"person","person_id":"ao3_0fy_d45_AAA","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p064:block07:m0012","start":12,"end":14,"surface":"陳涉","kind":"person","person_id":"pom_ycp_ha5","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p064:block07:m0042","start":42,"end":44,"surface":"仲尼","kind":"person","person_id":"j5s_4zz_bos","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p064:block07:m0045","start":45,"end":47,"surface":"墨翟","kind":"person","person_id":"tjx_q6x_kc7","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p064:block07:m0050","start":50,"end":52,"surface":"陶朱","kind":"person","person_id":"yhm_h9f_8p0","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p064:block07:m0053","start":53,"end":55,"surface":"猗頓","kind":"person","person_id":"kxz_6nu_h9u","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p064:block07:m0122","start":122,"end":124,"surface":"秦族","kind":"unresolved","person_id":null,"status":"unresolved","note":"泛稱、群體或未核指代，不據引文譬喻補造個人。"}],"source_block_kind":"witness_dd","chapter_id":"c-shiji-006-shihuang","book_id":"b-shiji-006","work_id":"w-shiji","source_id":"s-shiji-006-shihuang"},{"id":"c-shiji-074-mengxun:p012","text":"而趙亦有公孫龍為堅白同異之辯，劇子之言；魏有李悝，盡地力之教；楚有尸子、長盧；阿之吁子焉。自如孟子至于吁子，世多有其書，故不論其傳云。蓋墨翟，宋之大夫，善守御，為節用。或曰并孔子時，或曰在其後。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-074-mengxun:m012-0004","start":4,"end":7,"surface":"公孫龍","kind":"person","person_id":"5l5_0v4_gqg","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m012-0015","start":15,"end":17,"surface":"劇子","kind":"person","person_id":"lg2_cqw_2hr","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m012-0022","start":22,"end":24,"surface":"李悝","kind":"person","person_id":"wyx_6d2_xxp","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m012-0033","start":33,"end":35,"surface":"尸子","kind":"person","person_id":"b4v_jbu_4sr","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m012-0036","start":36,"end":38,"surface":"長盧","kind":"person","person_id":"fx4_ybu_7b9","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m012-0041","start":41,"end":43,"surface":"吁子","kind":"person","person_id":"3nq_r49_oo5","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m012-0047","start":47,"end":49,"surface":"孟子","kind":"person","person_id":"saz_old_5fi","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m012-0051","start":51,"end":53,"surface":"吁子","kind":"person","person_id":"3nq_r49_oo5","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m012-0068","start":68,"end":70,"surface":"墨翟","kind":"person","person_id":"tjx_q6x_kc7","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m012-0084","start":84,"end":86,"surface":"或曰","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名群體、族屬、學說合稱或匿名說話者保持未定；不將黃老儒墨自動拆為人名，也不補群體成員。"},{"id":"c-shiji-074-mengxun:m012-0087","start":87,"end":89,"surface":"孔子","kind":"person","person_id":"fp6_ia6_7yw","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m012-0091","start":91,"end":93,"surface":"或曰","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名群體、族屬、學說合稱或匿名說話者保持未定；不將黃老儒墨自動拆為人名，也不補群體成員。"}],"chapter_id":"c-shiji-074-mengxun","book_id":"b-shiji-074","work_id":"w-shiji","source_id":"s-shiji-074-mengxun"},{"id":"c-shiji-112-pingjin:p015","text":"臣聞天下之患在於土崩，不在於瓦解，古今一也。何謂土崩？秦之末世是也。陳涉無千乘之尊，尺土之地，身非王公大人名族之后，無鄉曲之譽，非有孔、墨、曾子之賢，陶朱、猗頓之富也，然起窮巷，奮棘矜，偏袒大呼而天下從風，此其故何也？由民困而主不恤，下怨而上不知（也），俗已亂而政不修，此三者陳涉之所以為資也。是之謂土崩。故曰天下之患在於土崩。何謂瓦解？吳、楚、齊、趙之兵是也。七國謀為大逆，號皆稱萬乘之君，帶甲數十萬，威足以嚴其境內，財足以勸其士民，然不能西攘尺寸之地而身為禽於中原者，此其故何也？非權輕於匹夫而兵弱於陳涉也，當是之時，先帝之德澤未衰而安土樂俗之民眾，故諸侯無境外之助。此之謂瓦解，故曰天下之患不在瓦解。由是觀之，天下誠有土崩之勢，雖布衣窮處之士或首惡而危海內，陳涉是也。況三晉之君或存乎！天下雖未有大治也，誠能無土崩之勢，雖有彊國勁兵不得旋踵而身為禽矣，吳、楚、齊、趙是也。況群臣百姓能為亂乎哉！此二體者，安危之明要也，賢主所留意而深察也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-112-pingjin:m015-0034","start":34,"end":36,"surface":"陳涉","kind":"person","person_id":"pom_ycp_ha5","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0066","start":66,"end":67,"surface":"孔","kind":"person","person_id":"fp6_ia6_7yw","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0068","start":68,"end":69,"surface":"墨","kind":"person","person_id":"tjx_q6x_kc7","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0070","start":70,"end":72,"surface":"曾子","kind":"person","person_id":"c7w_nyj_95u","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0075","start":75,"end":77,"surface":"陶朱","kind":"person","person_id":"yhm_h9f_8p0","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0078","start":78,"end":80,"surface":"猗頓","kind":"person","person_id":"kxz_6nu_h9u","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0138","start":138,"end":140,"surface":"陳涉","kind":"person","person_id":"pom_ycp_ha5","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0181","start":181,"end":183,"surface":"七國","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-112-pingjin:m015-0252","start":252,"end":254,"surface":"陳涉","kind":"person","person_id":"pom_ycp_ha5","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0261","start":261,"end":263,"surface":"先帝","kind":"person","person_id":"moo_r04_tz1","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0332","start":332,"end":334,"surface":"陳涉","kind":"person","person_id":"pom_ycp_ha5","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0338","start":338,"end":342,"surface":"三晉之君","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-112-pingjin","book_id":"b-shiji-112","work_id":"w-shiji","source_id":"s-shiji112-pingjin"},{"id":"c-shiji-130-taishigong:p003","text":"太史公學天官於唐都，受易於楊何，習道論於黃子。太史公仕於建元元封之閒，愍學者之不達其意而師悖，乃論六家之要指曰：\n《易大傳》：「天下一致而百慮，同歸而殊涂。」夫陰陽、儒、墨、名、法、道德，此務為治者也，直所從言之異路，有省不省耳。嘗竊觀陰陽之術，大祥而眾忌諱，使人拘而多所畏；然其序四時之大順，不可失也。儒者博而寡要，勞而少功，是以其事難盡從；然其序君臣父子之禮，列夫婦長幼之別，不可易也。墨者儉而難遵，是以其事不可遍循；然其彊本節用，不可廢也。法家嚴而少恩；然其正君臣上下之分，不可改矣。名家使人儉而善失真；然其正名實，不可不察也。道家使人精神專一，動合無形，贍足萬物。其為術也，因陰陽之大順，采儒墨之善，撮名法之要，與時遷移，應物變化，立俗施事，無所不宜，指約而易操，事少而功多。儒者則不然。以為人主天下之儀表也，主倡而臣和，主先而臣隨。如此則主勞而臣逸。至於大道之要，去健羨，絀聰明，釋此而任術。夫神大用則竭，形大勞則敝。形神騷動，欲與天地長久，非所聞也。\n夫陰陽四時、八位、十二度、二十四節各有教令，順之者昌，逆之者不死則亡，未必然也，故曰「使人拘而多畏」。夫春生夏長，秋收冬藏，此天道之大經也，弗順則無以為天下綱紀，故曰「四時之大順，不可失也」。\n夫儒者以六藝為法。六藝經傳以千萬數，累世不能通其學，當年不能究其禮，故曰「博而寡要，勞而少功」。若夫列君臣父子之禮，序夫婦長幼之別，雖百家弗能易也。\n墨者亦尚堯舜道，言其德行曰：「堂高三尺，土階三等，茅茨不翦，采椽不刮。食土簋，啜土刑，糲粱之食，藜霍之羹。夏日葛衣，冬日鹿裘。」其送死，桐棺三寸，舉音不盡其哀。教喪禮，必以此為萬民之率。使天下法若此，則尊卑無別也。夫世異時移，事業不必同，故曰「儉而難遵」。要曰彊本節用，則人給家足之道也。此墨子之所長，雖百長弗能廢也。\n法家不別親疏，不殊貴賤，一斷於法，則親親尊尊之恩絕矣。可以行一時之計，而不可長用也，故曰「嚴而少恩」。若尊主卑臣，明分職不得相踰越，雖百家弗能改也。\n名家苛察繳繞，使人不得反其意，專決於名而失人情，故曰「使人儉而善失真」。若夫控名責實，參伍不失，此不可不察也。\n道家無為，又曰無不為，其實易行，其辭難知。其術以虛無為本，以因循為用。無成埶，無常形，故能究萬物之情。不為物先，不為物後，故能為萬物主。有法無法，因時為業；有度無度，因物與合。故曰「聖人不朽，時變是守。虛者道之常也，因者君之綱」也。群臣并至，使各自明也。其實中其聲者謂之端，實不中其聲者謂之窾。窾言不聽，姦乃不生，賢不肖自分，白黑乃形。在所欲用耳，何事不成。乃合大道，混混冥冥。光燿天下，復反無名。凡人所生者神也，所讬者形也。神大用則竭，形大勞則敝，形神離則死。死者不可復生，離者不可復反，故聖人重之。由是觀之，神者生之本也，形者生之具也。不先定其神［形］，而曰「我有以治天下」，何由哉？","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m003-0000","start":0,"end":3,"surface":"太史公","kind":"person","person_id":"pme_eis_xqi_*A*AAAA","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m003-0007","start":7,"end":9,"surface":"唐都","kind":"person","person_id":"yt8_m1o_8bl","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m003-0013","start":13,"end":15,"surface":"楊何","kind":"person","person_id":"rpk_mne_stx","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m003-0020","start":20,"end":22,"surface":"黃子","kind":"person","person_id":"9tx_4t9_4jj","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m003-0023","start":23,"end":26,"surface":"太史公","kind":"person","person_id":"pme_eis_xqi_*A*AAAA","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m003-0608","start":608,"end":609,"surface":"堯","kind":"person","person_id":"oho_r3f_c6y","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m003-0609","start":609,"end":610,"surface":"舜","kind":"person","person_id":"ddb_l4j_4j2","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m003-0749","start":749,"end":751,"surface":"墨子","kind":"person","person_id":"tjx_q6x_kc7","status":"contextual_provisional"}],"chapter_id":"c-shiji-130-taishigong","book_id":"b-shiji-130","work_id":"w-shiji","source_id":"s-shiji130-taishigong"}],"sources":[{"chapter_id":"c-shiji-006-shihuang","work_id":"w-shiji","book_id":"b-shiji-006","source_id":"s-shiji-006-shihuang","source":{"title":"史記／卷006","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷006","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷006&oldid=7907969","revision_id":7907969,"accessed_on":"2026-10-09","extent":"數位見證127個文字區塊，含16個dd刻辭或嵌入引文及卷末附載班固記；排除導覽、跨站連結與註號。","image_verified":false,"rights":"古代原文與附載文字；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"note":"正文未改寫；行內校勘標記及附載文字仍待逐處核對。固定版本正文HTML重讀一致。","editorial_readings":[{"paragraph_id":"c-shiji-006-shihuang:p010","witness_form":"（四）［是］","body_reading":"四","note":"數位見證行內校勘標記另存；正文保留改讀前的字，不稱已校定底本。"},{"paragraph_id":"c-shiji-006-shihuang:p016","witness_form":"（薊）［荊］","body_reading":"薊","note":"數位見證行內校勘標記另存；正文保留改讀前的字，不稱已校定底本。"},{"paragraph_id":"c-shiji-006-shihuang:p051","witness_form":"（其）","body_reading":"","note":"數位見證行內刪字標記另存；未核底本，不稱校定讀法。"},{"paragraph_id":"c-shiji-006-shihuang:p061","witness_form":"（者）","body_reading":"","note":"數位見證行內刪字標記另存；未核底本，不稱校定讀法。"}],"extraction_note":"按正文p及dd區塊原有次序錄入；dd用前一段ID加block後綴，既有p段落ID不變。正文前兩個dd為維基百科與文言維基大典導覽，排除。"}}},{"chapter_id":"c-shiji-074-mengxun","work_id":"w-shiji","book_id":"b-shiji-074","source_id":"s-shiji-074-mengxun","source":{"title":"史記／卷074","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷074","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷074&oldid=79081