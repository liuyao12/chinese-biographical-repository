虛，軼野馬而𨎥騊駼，乘遺風而射遊騏；儵眒淒浰，靁動熛至，星流霆擊，弓不虛發，中必決眥，洞胷達腋，絕乎心繫，獲若雨獸，揜草蔽地。於是楚王乃弭節裴回，翱翔容與，覽乎陰林，觀壯士之暴怒，與猛獸之恐懼，徼𧮬受詘，殫睹衆物之變態。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m007-0006","start":6,"end":8,"surface":"專諸","kind":"person","person_id":"qq3_6ej_sfv","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m007-0016","start":16,"end":18,"surface":"楚王","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m007-0066","start":66,"end":68,"surface":"陽子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m007-0071","start":71,"end":73,"surface":"纖阿","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m007-0157","start":157,"end":159,"surface":"楚王","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-117-xiangru","book_id":"b-shiji-117","work_id":"w-shiji","source_id":"s-shiji117-xiangru"}],"sources":[{"chapter_id":"c-shiji-117-xiangru","work_id":"w-shiji","book_id":"b-shiji-117","source_id":"s-shiji117-xiangru","source":{"title":"史記／卷117","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷117","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷117&oldid=10371549","revision_id":10371549,"accessed_on":"2026-10-11","extent":"固定修訂全文71段，包括賦、書與末段索隱述贊。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"去header2、目錄標記及現代節標；quote模板保留全文，br轉段落；罕字模板保留第一參數字形，描述未作正文；連結保留顯示字。未核影像。 移除防轉換控制外殼，保留內字云。","note":"第58段U+E0FA私用字缺字與頌中重句原樣保存，不猜補；末段索隱述贊分層。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical"}}
