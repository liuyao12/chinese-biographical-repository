{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004574","identity_policy":"contextual_provisional","person_ids":["cbr-p004574"],"persons":[{"id":"cbr-p004574","label":"夫差引古（樂毅列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"夫差","mention_ids":["c-shiji-080-leyi:m011-0038"]},{"surface":"吳王","mention_ids":["c-shiji-080-leyi:m011-0053"]}],"evidence":[{"mention_id":"c-shiji-080-leyi:m011-0038","chapter_id":"c-shiji-080-leyi","paragraph_id":"c-shiji-080-leyi:p011","quote":"夫差"},{"mention_id":"c-shiji-080-leyi:m011-0053","chapter_id":"c-shiji-080-leyi","paragraph_id":"c-shiji-080-leyi:p011","quote":"吳王"}]}],"source_mention_summary":[{"source_id":"s-shiji-080-leyi","work_id":"w-shiji","book_id":"b-shiji-080","chapter_id":"c-shiji-080-leyi","mention_count":2,"mention_ids":["c-shiji-080-leyi:m011-0038","c-shiji-080-leyi:m011-0053"],"paragraph_ids":["c-shiji-080-leyi:p011"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-080-leyi"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-080-leyi:m011-0038","start":38,"end":40,"surface":"夫差","kind":"person","person_id":"cbr-p004574","status":"contextual_provisional","paragraph_id":"c-shiji-080-leyi:p011","chapter_id":"c-shiji-080-leyi"},{"id":"c-shiji-080-leyi:m011-0053","start":53,"end":55,"surface":"吳王","kind":"person","person_id":"cbr-p004574","status":"contextual_provisional","paragraph_id":"c-shiji-080-leyi:p011","chapter_id":"c-shiji-080-leyi"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji080-020","person_id":"cbr-p004574","scope":"same_chapter","chapter_ids":["c-shiji-080-leyi"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["吳王","夫差"],"evidence":[{"paragraph_id":"c-shiji-080-leyi:p011","quote":"臣聞之，善作者不必善成，善始者不必善終。昔伍子胥說聽於闔閭，而吳王遠跡至郢；夫差弗是也，賜之鴟夷而浮之江。吳王不寤先論之可以立功，故沈子胥而不悔；子胥不蚤見主之不同量，是以至於入江而不化。"}],"rationale":"樂閒明示為樂毅子，樂叔明示為孫，不補闕代父親；樂乘為樂閒宗不補兄弟。燕王喜來書及趙襄王君序各限本段，曹相國未見名字不回填。河上丈人至蓋公師承不作父子。依本篇明示姓名、君序與來書答書範圍暫接；燕惠王來書寡人指惠王、將軍指樂毅，樂毅答書先王指昭王、足下君王指惠王。伍子胥引古首吳王指闔閭，後吳王在夫差賜鴟夷後指夫差。父兄與群臣不補具體親屬，王齊為反間假說不作授王爵。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-080-leyi:p011","text":"臣聞之，善作者不必善成，善始者不必善終。昔伍子胥說聽於闔閭，而吳王遠跡至郢；夫差弗是也，賜之鴟夷而浮之江。吳王不寤先論之可以立功，故沈子胥而不悔；子胥不蚤見主之不同量，是以至於入江而不化。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-080-leyi:m011-0000","start":0,"end":1,"surface":"臣","kind":"person","person_id":"cbr-p004555","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m011-0021","start":21,"end":24,"surface":"伍子胥","kind":"person","person_id":"cbr-p004572","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m011-0027","start":27,"end":29,"surface":"闔閭","kind":"person","person_id":"cbr-p004573","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m011-0031","start":31,"end":33,"surface":"吳王","kind":"person","person_id":"cbr-p004573","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m011-0038","start":38,"end":40,"surface":"夫差","kind":"person","person_id":"cbr-p004574","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m011-0053","start":53,"end":55,"surface":"吳王","kind":"person","person_id":"cbr-p004574","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m011-0067","start":67,"end":69,"surface":"子胥","kind":"person","person_id":"cbr-p004572","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m011-0073","start":73,"end":75,"surface":"子胥","kind":"person","person_id":"cbr-p004572","status":"contextual_provisional"}],"chapter_id":"c-shiji-080-leyi","book_id":"b-shiji-080","work_id":"w-shiji","source_id":"s-shiji-080-leyi"}],"sources":[{"chapter_id":"c-shiji-080-leyi","work_id":"w-shiji","book_id":"b-shiji-080","source_id":"s-shiji-080-leyi",