6-0164","start":164,"end":166,"surface":"陳嬰","kind":"person","person_id":"6us_ibm_u05","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p006","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-091-qingbu:m002-0079","start":79,"end":81,"surface":"陳嬰","kind":"person","person_id":"6us_ibm_u05","status":"contextual_provisional","paragraph_id":"c-shiji-091-qingbu:p002","chapter_id":"c-shiji-091-qingbu"}],"relations":[{"id":"a-shiji007-003","subject_person_id":"6us_ibm_u05","predicate":"mother","object_person_id":"a19_9ni_9mq","status":"source_attested","evidence":[{"paragraph_id":"c-shiji-007-xiangyu:p004","quote":"陳嬰母謂嬰曰","chapter_id":"c-shiji-007-xiangyu","source_id":"s-shiji-007-xiangyu"}],"qualifiers":{"source_term":"母","historicity":"historical_tradition"},"interpretation_note":"只保存本文明示親屬陳述；不推導闕代、同父同母或未見姓名。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji007-064","person_id":"6us_ibm_u05","title":"東陽令史","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-007-xiangyu","source_id":"s-shiji-007-xiangyu","paragraph_id":"c-shiji-007-xiangyu:p004","quote":"廣陵人召平於是為陳王徇廣陵，未能下。聞陳王敗走，秦兵又且至，乃渡江矯陳王命，拜梁為楚王上柱國。曰：「江東已定，急引兵西擊秦。」項梁乃以八千人渡江而西。聞陳嬰已下東陽，使使欲與連和俱西。陳嬰者，故東陽令史，居縣中，素信謹，稱為長者。東陽少年殺其令，相聚數千人，欲置長，無適用，乃請陳嬰。嬰謝不能，遂彊立嬰為長，縣中從者得二萬人。少年欲立嬰便為王，異軍蒼頭特起。陳嬰母謂嬰曰：「自我為汝家婦，未嘗聞汝先古之有貴者。今暴得大名，不祥。不如有所屬，事成猶得封侯，事敗易以亡，非世所指名也。」嬰乃不敢為王。謂其軍吏曰：「項氏世世將家，有名於楚。今欲舉大事，將非其人，不可。我倚名族，亡秦必矣。」於是眾從其言，以兵屬項梁。項梁渡淮，黥布、蒲將軍亦以兵屬焉。凡六七萬人，軍下邳。"}],"attestations":[{"id":"th-shiji007-064:a001","paragraph_id":"c-shiji-007-xiangyu:p004","start":97,"end":101,"surface":"東陽令史","person_mention_id":"c-shiji-007-xiangyu:m004-0076","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"故字指此前任職，本段事件時已否任職未知。","reviewer":"Codex（AI 代理）","human_reviewed":false},{"id":"th-shiji007-066","person_id":"6us_ibm_u05","title":"楚上柱國","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-007-xiangyu","source_id":"s-shiji-007-xiangyu","paragraph_id":"c-shiji-007-xiangyu:p006","quote":"居鄛人范增，年七十，素居家，好奇計，往說項梁曰：「陳勝敗固當。夫秦滅六國，楚最無罪。自懷王入秦不反，楚人憐之至今，故楚南公曰『楚雖三戶，亡秦必楚』也。今陳勝首事，不立楚後而自立，其勢不長。今君起江東，楚蠭起之將皆爭附君者，以君世世楚將，為能復立楚之後也。」於是項梁然其言，乃求楚懷王孫心民間，為人牧羊，立以為楚懷王，從民所望也。陳嬰為楚上柱國，封五縣，與懷王都盱台。項梁自號為武信君。"}],"attestations":[{"id":"th-shiji007-066:a001","paragraph_id":"c-shiji-007-xiangyu:p006","start":167,"end":171,"surface":"楚上柱國","person_mention_id":"c-shiji-007-xiangyu:m006-0164","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"原文明示官爵用稱；起點未知，死亡不自動當官爵終點。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"address_assertions":[{"id":"pa-shiji007-008","person_id":"6us_ibm_u05","relation":"residence","place":{"source_name":"東陽","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-007-xiangyu","source_id":"s-shiji-007-xiangyu","paragraph_id":"c-shiji-007-xiangyu:p004","quote":"廣陵人召平於是為陳王徇廣陵，未能下。聞陳王敗走，秦兵又且至，乃渡江矯陳王命，拜梁為楚王上柱國。曰：「江東已定，急引兵西擊秦。」項梁乃以八千人渡江而西。聞陳嬰已下東陽，使使欲與連和俱西。陳嬰者，故東陽令史，居縣中，素信謹，稱為長者。東陽少年殺其令，相聚數千人，欲置長，無適用，乃請陳嬰。嬰謝不能，遂彊立嬰為長，縣中從者得二萬人。少年欲立嬰便為王，異軍蒼頭特起。陳嬰母謂嬰曰：「自我為汝家婦，未嘗聞汝先古之有貴者。今暴得大名，不祥。不如有所屬，事成猶得封侯，事敗易以亡，非世所指名也。」嬰乃不敢為王。謂其軍吏曰：「項氏世世將家，有名於楚。今欲舉大事，將非其人，不可。我倚名族，亡秦必矣。」於是眾從其言，以兵屬項梁。項梁渡淮，黥布、蒲將軍亦以兵屬焉。凡六七萬人，軍下邳。","person_mention_id":"c-shiji-007-xiangyu:m004-0076"}],"source_term":"故東陽令史，居縣中","interpretation_note":"居縣中所指東陽，不推為出生或籍貫。","reviewer":"Codex（AI 代理）","human_reviewed":false},{"id":"pa-shiji007-013","person_id":"6us_ibm_u05","relation":"residence","place":{"source_name":"盱台","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-007-xiangyu","source_id"