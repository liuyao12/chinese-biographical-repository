。章邯之滅陳勝，破呂臣軍，布乃引兵北擊秦左右校，破之清波，引兵而東。聞項梁定江東會稽，涉江而西。陳嬰以項氏世為楚將，乃以兵屬項梁，渡淮南，英布、蒲將軍亦以兵屬項梁。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-091-qingbu:m002-0000","start":0,"end":2,"surface":"陳勝","kind":"person","person_id":"2xk_syj_egr","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m002-0006","start":6,"end":7,"surface":"布","kind":"person","person_id":"zxd_afr_2xg","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m002-0009","start":9,"end":11,"surface":"番君","kind":"person","person_id":"o0l_em5_5v9","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m002-0024","start":24,"end":26,"surface":"番君","kind":"person","person_id":"o0l_em5_5v9","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m002-0027","start":27,"end":29,"surface":"其女","kind":"person","person_id":"o0l_em5_5v9_B","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m002-0032","start":32,"end":34,"surface":"章邯","kind":"person","person_id":"4jv_qte_5p4","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m002-0036","start":36,"end":38,"surface":"陳勝","kind":"person","person_id":"2xk_syj_egr","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m002-0040","start":40,"end":42,"surface":"呂臣","kind":"person","person_id":"onj_4n3_xwi","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m002-0044","start":44,"end":45,"surface":"布","kind":"person","person_id":"zxd_afr_2xg","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m002-0066","start":66,"end":68,"surface":"項梁","kind":"person","person_id":"5xt_rg8_7zs_A","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m002-0079","start":79,"end":81,"surface":"陳嬰","kind":"person","person_id":"6us_ibm_u05","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m002-0082","start":82,"end":84,"surface":"項氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、族稱或群體不補姓名成員。"},{"id":"c-shiji-091-qingbu:m002