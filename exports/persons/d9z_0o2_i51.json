_0o2_i51","status":"contextual_provisional"},{"id":"c-jinshu-096-lienv:zhongyan-mother:p001:m0068","start":68,"end":69,"surface":"渾","kind":"person","person_id":"a8f_ec8_e74_AB","status":"contextual_provisional"},{"id":"c-jinshu-096-lienv:zhongyan-mother:p001:m0071","start":71,"end":72,"surface":"濟","kind":"person","person_id":"a8f_ec8_e74_ABB","status":"contextual_provisional"}],"source_position":{"first_line":26,"last_line":26,"revision_id":2625341,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-096-lienv","book_id":"b-jinshu-096","work_id":"w-jinshu","source_id":"s-jinshu-096-lienv"}],"sources":[{"chapter_id":"c-jinshu-096-lienv","work_id":"w-jinshu","book_id":"b-jinshu-096","source_id":"s-jinshu-096-lienv","source":{"title":"列女傳·列傳第六十六（數位選錄）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=晉書/卷096&oldid=2625341","permalink":"https://zh.wikisource.org/w/index.php?title=晉書/卷096&oldid=2625341","revision_id":2625341,"accessed_on":"2026-10-18","extent":"荀崧及相關家族傳文局部選錄；不是全卷。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，底本影像未核","response_sha256":"678d31393caea3868cfcee297612f9fb761421eb84fa4fc0355bdd7072a81820","wikitext_sha256":"2a30a87df259042f1f5d783dd7b9674ff174208aae03383fad28ab3c88dbabb5","normalization":{"character_conversion":{},"extraction_note":"移除段首排版空白，展開維基連結的顯示文字；選段無實際年號模板。原始字元與差異另外保存。","excerpts":[{"proposed_paragraph_id":"c-jinshu-096-lienv:xunguan:p001","source_lines":[68,68],"raw_quote":"[[晉書/卷075#荀崧|荀崧]]小女灌，幼有奇節。崧為襄城太守，為杜曾所圍，力弱食盡，欲求救于故吏平南將軍石覽，計無從出。灌時年十三，乃率勇士數千人，逾城突圍夜出。賊追甚急，灌督厲將士，且戰且前，得入魯陽山獲免。自詣覽乞師，又為崧書與南中郎將周訪請援，仍結為兄弟，訪即遣子撫率三千人會石覽俱救崧。賊聞兵至，散走，灌之力也。","raw_quote_sha256":"a620349a50a8214e281db353a26f63dba8c8484e4159fca02ce2b7121075b25d","selected_text_sha256":"a0b9f1298ca75d31737a8a2b24358d8fd8a72b09f2cfd1d700d7b3c3daa91d2b","begin_anchor":"荀崧小女灌，幼有奇節。崧為襄城","end_anchor":"崧。賊聞兵至，散走，灌之力也。"},{"proposed_paragraph_id":"c-jinshu-096-lienv:zhongyan-mother:p001","source_lines":[26,26],"raw_quote":"[[晉書/卷042#王渾|王渾]]妻鍾氏，字琰，潁川人，魏太傅繇曾孫也。父徽，黃門郎。琰數歲能屬文，及長，聰慧弘雅，博覽記籍。美容止，善嘯詠，禮儀法度為中表所則。既適渾，生濟。渾嘗共琰坐，濟趨庭而過，渾欣然曰：「生子如此，足慰人心。」琰笑曰：「若使新婦得配參軍，生子故不翅如此。」參軍，謂渾中弟淪也。琰女亦有才淑，為求賢夫。時有兵家子甚俊，濟欲妻之，白琰，琰曰：「要令我見之。」濟令此兵與群小雜處，琰自幃中察之，既而謂濟曰：「緋衣者非汝所拔乎？」濟曰：「是。」琰曰：「此人才足拔萃，然地寒壽促，不足展其器用，不可與婚。」遂止。其人數年果亡。琰明鑒遠識，皆此類也。","raw_quote_sha256":"7bbe46c409f8f69d34d54fcc0368693be235441d332975b6bbf2ba9a05f871ed","selected_text_sha256":"1288790567eb088a3b3315d03f63c733efa467465a84840c77db8409c83ebb97","begin_anchor":"王渾妻鍾氏，字琰，潁川人，魏太","end_anchor":"法度為中表所則。既適渾，生濟。"}]},"quality_note":"荀灌兵數本見證作數千，現代論文引作數十；只記見證差異，保留原字，未親核論文所報印本。詳見docs/source-reviews/jinshu096-xunguan-force-count.json。"}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true}}
