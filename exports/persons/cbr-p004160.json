{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004160","identity_policy":"contextual_provisional","person_ids":["cbr-p004160"],"persons":[{"id":"cbr-p004160","label":"史舉（樗里子甘茂列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"史舉先生","mention_ids":["c-shiji-071-chugan:m007-0012"]},{"surface":"史舉","mention_ids":["c-shiji-071-chugan:m014-0099"]}],"evidence":[{"mention_id":"c-shiji-071-chugan:m007-0012","chapter_id":"c-shiji-071-chugan","paragraph_id":"c-shiji-071-chugan:p007","quote":"史舉先生"},{"mention_id":"c-shiji-071-chugan:m014-0099","chapter_id":"c-shiji-071-chugan","paragraph_id":"c-shiji-071-chugan:p014","quote":"史舉"}]}],"mentions":[{"id":"c-shiji-071-chugan:m007-0012","start":12,"end":16,"surface":"史舉先生","kind":"person","person_id":"cbr-p004160","status":"contextual_provisional","paragraph_id":"c-shiji-071-chugan:p007","chapter_id":"c-shiji-071-chugan"},{"id":"c-shiji-071-chugan:m014-0099","start":99,"end":101,"surface":"史舉","kind":"person","person_id":"cbr-p004160","status":"contextual_provisional","paragraph_id":"c-shiji-071-chugan:p014","chapter_id":"c-shiji-071-chugan"}],"relations":[],"title_holdings":[{"id":"th-shiji071-015","person_id":"cbr-p004160","title":"監門","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-071-chugan","source_id":"s-shiji-071-chugan","paragraph_id":"c-shiji-071-chugan:p014","quote":"齊使甘茂於楚，楚懷王新與秦合婚而驩。而秦聞甘茂在楚，使人謂楚王曰：「願送甘茂於秦。」楚王問於范蜎曰：「寡人欲置相於秦，孰可？」對曰：「臣不足以識之。」楚王曰：「寡人欲相甘茂，可乎？」對曰：「不可。夫史舉，下蔡之監門也，大不為事君，小不為家室，以茍賤不廉聞於世，甘茂事之順焉。故惠王之明，武王之察，張儀之辯，而甘茂事之，取十官而無罪。茂誠賢者也，然不可相於秦。夫秦之有賢相，非楚國之利也。且王前嘗用召滑於越，而內行章義之難，越國亂，故楚南塞厲門而郡江東。計王之功所以能如此者，越國亂而楚治也。今王知用諸越而忘用諸秦，臣以王為鉅過矣。然則王若欲置相於秦，則莫若向壽者可。夫向壽之於秦王，親也，少與之同衣，長與之同車，以聽事。王必相向壽於秦，則楚國之利也。」於是使使請秦相向壽於秦。秦卒相向壽。而甘茂竟不得復入秦，卒於魏。"}],"attestations":[{"id":"th-shiji071-015:a001","paragraph_id":"c-shiji-071-chugan:p014","start":105,"end":107,"surface":"監門","person_mention_id":"c-shiji-071-chugan:m014-0099","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"來源授官、封爵及文獻用稱分存，未知起訖不補曆日；右更、上卿制度種類待核，不因卒或亡去終止全部官爵。秦以相印迎甘茂而甘茂不往，不作實任秦相；齊授上卿另記。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji071-019","person_id":"cbr-p004160","scope":"same_chapter","chapter_ids":["c-shiji-071-chugan"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"依甘茂附傳明示史舉先生、蜀侯煇與相壯，秦惠王卒武王立的局部敘事分辨；未按同名跨篇合併，版本與任職年代待覆核。","surfaces":["史舉","史舉先生"],"evidence":[{"paragraph_id":"c-shiji-071-chugan:p007","quote":"甘茂者，下蔡人也。事下蔡史舉先生，學百家之說。因張儀、樗里子而求見秦惠王。王見而說之，使將，而佐魏章略定漢中地。"},{"paragraph_id":"c-shiji-071-chugan:p014","quote":"齊使甘茂於楚，楚懷王新與秦合婚而驩。而秦聞甘茂在楚，使人謂楚王曰：「願送甘茂於秦。」楚王問於范蜎曰：「寡人欲置相於秦，孰可？」對曰：「臣不足以識之。」楚王曰：「寡人欲相甘茂，可乎？」對曰：「不可。夫史舉，下蔡之監門也，大不為事君，小不為家室，以茍賤不廉聞於世，甘茂事之順焉。故惠王之明，武王之察，張儀之辯，而甘茂事之，取十官而無罪。茂誠賢者也，然不可相於秦。夫秦之有賢相，非楚國之利也。且王前嘗用召滑於越，而內行章義之難，越國亂，故楚南塞厲門而郡江東。計王之功所以能如此者，越國亂而楚治也。今王知用諸越而忘用諸秦，臣以王為鉅過矣。然則王若欲置相於秦，則莫若向壽者可。夫向壽之於秦王，親也，少與之同衣，長與之同車，以聽事。王必相向壽於秦，則楚國之利也。」於是使使請秦相向壽於秦。秦卒相向壽。而甘茂竟不得復入秦，卒於魏。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-071-chugan:p007","text":"甘茂者，下蔡人也。事下蔡史舉先生，學百家之說。因張儀、樗里子而求見秦惠王。王見而說之，使將，而佐魏章略定漢中地。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-071-chugan:m007-0000","start":0,"end":2,"surface":"甘茂","kind":"person","person_id":"cbr-p004151","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m007-0012","start":12,"end":16,"surface":"史舉先生","kind":"person","person_id":"cbr-p004160","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m007-0024","start":24,"end":26,"surface":"張儀","kind":"person","person_id":"cbr-p004150","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m007-0027","start":27,"end":30,"surface":"樗里子","kind":"person","person_id":"cbr-p004142","stat