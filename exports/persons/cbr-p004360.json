{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004360","canonical_person_id":"xv2_ujg_1pe","id_aliases":["cbr-p004360"],"identity_policy":"contextual_provisional","person_ids":["xv2_ujg_1pe"],"persons":[{"id":"xv2_ujg_1pe","label":"楚王割東國未定（孟嘗君列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"楚王","mention_ids":["c-shiji-075-mengchang:m009-0170"]}],"evidence":[{"mention_id":"c-shiji-075-mengchang:m009-0170","chapter_id":"c-shiji-075-mengchang","paragraph_id":"c-shiji-075-mengchang:p009","quote":"楚王"}],"id_aliases":["cbr-p004360"]}],"source_mention_summary":[{"source_id":"s-shiji-075-mengchang","work_id":"w-shiji","book_id":"b-shiji-075","chapter_id":"c-shiji-075-mengchang","mention_count":1,"mention_ids":["c-shiji-075-mengchang:m009-0170"],"paragraph_ids":["c-shiji-075-mengchang:p009"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-075-mengchang"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-075-mengchang:m009-0170","start":170,"end":172,"surface":"楚王","kind":"person","person_id":"xv2_ujg_1pe","status":"contextual_provisional","paragraph_id":"c-shiji-075-mengchang:p009","chapter_id":"c-shiji-075-mengchang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji075-031","person_id":"xv2_ujg_1pe","scope":"same_chapter","chapter_ids":["c-shiji-075-mengchang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"依入秦、返齊及食客敘事明示姓名與局部回指暫接。未名夜食客、蔽光者、狗盜鷄鳴兩客、幸姬及勸說毀者各存角色，不補姓名或全域連所有客稱；木土偶保持寓言。蘇代內嵌秦昭王王稱與外層孟嘗君君稱分辨，楚王割地與楚懷王得出暫分候選，不確證異人；田甲劫王與孟嘗君反謀指控分開，不把指控當史實。","surfaces":["楚王"],"evidence":[{"paragraph_id":"c-shiji-075-mengchang:p009","quote":"孟嘗君怨秦，將以齊爲韓、魏攻楚，因與韓、魏攻秦，而借兵食於西周。蘇代爲西周謂曰：「君以齊爲韓、魏攻楚九年，取宛、葉以北以彊韓、魏，今復攻秦以益之。韓、魏南無楚憂，西無秦患，則齊危矣。韓、魏必輕齊畏秦，臣爲君危之。君不如令敝邑深合於秦，而君無攻，又無借兵食。君臨函谷而無攻，令敝邑以君之情謂秦昭王曰『薛公必不破秦以彊韓、魏。其攻秦也，欲王之令楚王割東國以與齊，而秦出楚懷王以爲和』。君令敝邑以此惠秦，秦得無破而以東國自免也，秦必欲之。楚王得出，必德齊。齊得東國益彊，而薛世世無患矣。秦不大弱，而處三晉之西，三晉必重齊。」薛公曰：「善。」因令韓、魏賀秦，使三國無攻，而不借兵食於西周矣。是時，楚懷王入秦，秦留之，故欲必出之。秦不果出楚懷王。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-075-mengchang:p009","text":"孟嘗君怨秦，將以齊爲韓、魏攻楚，因與韓、魏攻秦，而借兵食於西周。蘇代爲西周謂曰：「君以齊爲韓、魏攻楚九年，取宛、葉以北以彊韓、魏，今復攻秦以益之。韓、魏南無楚憂，西無秦患，則齊危矣。韓、魏必輕齊畏秦，臣爲君危之。君不如令敝邑深合於秦，而君無攻，又無借兵食。君臨函谷而無攻，令敝邑以君之情謂秦昭王曰『薛公必不破秦以彊韓、魏。其攻秦也，欲王之令楚王割東國以與齊，而秦出楚懷王以爲和』。君令敝邑以此惠秦，秦得無破而以東國自免也，秦必欲之。楚王得出，必德齊。齊得東國益彊，而薛世世無患矣。秦不大弱，而處三晉之西，三晉必重齊。」薛公曰：「善。」因令韓、魏賀秦，使三國無攻，而不借兵食於西周矣。是時，楚懷王入秦，秦留之，故欲必出之。秦不果出楚懷王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-075-mengchang:m009-0000","start":0,"end":3,"surface":"孟嘗君","kind":"person","person_id":"7s4_7ac_lhn_AA","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m009-0032","start":32,"end":34,"surface":"蘇代","kind":"person","person_id":"2ih_dpv_yf7","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m009-0041","start":41,"end":42,"surface":"君","kind":"person","person_id":"7s4_7ac_lhn_AA","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m009-0102","start":102,"end":103,"surface":"君","kind":"person","person_id":"7s4_7ac_lhn_AA","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m009-0106","start":106,"end":107,"surface":"君","kind":"person","person_id":"7s4_7ac_lhn_AA","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m009-0118","start":118,"end":119,"surface":"君","kind":"person","person_id":"7s4_7ac_lhn_AA","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m0