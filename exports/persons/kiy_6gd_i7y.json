rface":"蘇溫","start":545,"end":547,"person_id":"7qk_ant_12f","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-fang:p004:m0554","surface":"第五猗","start":554,"end":557,"person_id":"kiy_6gd_i7y","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-fang:p004:m0558","surface":"胡混","start":558,"end":560,"person_id":"vdc_f7b_ye9","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-fang:p004:m0561","surface":"摯瞻","start":561,"end":563,"person_id":"0bf_g2u_uq9","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-fang:p004:m0567","surface":"王敦","start":567,"end":569,"person_id":"39o_b6y_n74","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-fang:p004:m0575","surface":"猗","start":575,"end":576,"person_id":"kiy_6gd_i7y","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-058-zhou-fang","book_id":"b-jinshu-058","work_id":"w-jinshu","source_id":"s-jinshu-058-zhou-fang-ws1775463"},{"id":"c-jinshu-076-wangyi-family:p002","text":"初，王敦左遷陶侃，使廙代為荊州。將吏馬俊、鄭攀等上書請留侃，敦不許。廙為俊等所襲，奔于江安。賊杜曾與俊、攀北迎第五猗以距廙。廙督諸軍討曾，又為曾所敗。敦命湘州刺史甘卓、豫章太守周廣等助廙擊曾，曾衆潰，廙得到州。廙性俊率，嘗從南下，旦自尋陽，迅風飛帆，暮至都，倚舫樓長嘯，神氣甚逸。王導謂庾亮曰：「世將為傷時識事。」亮曰：「正足舒其逸氣耳。」廙在州大誅戮侃時將佐，及征士皇甫方回，於是大失荊土之望，人情乖阻。帝乃征廙為輔國將軍，加散騎常侍。以母喪去職。服闋，拜征虜將軍，進左衛將軍。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-076-wangyi-family:p002:m0002","start":2,"end":4,"surface":"王敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0006","start":6,"end":8,"surface":"陶侃","kind":"person","person_id":"twd_erg_kmz","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0010","start":10,"end":11,"surface":"廙","kind":"person","person_id":"7r6_k52_qji_ABDA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0018","start":18,"end":20,"surface":"馬俊","kind":"person","person_id":"0w5_r48_tfo","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0021","start":21,"end":23,"surface":"鄭攀","kind":"person","person_id":"200_oqy_d7c","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0028","start":28,"end":29,"surface":"侃","kind":"person","person_id":"twd_erg_kmz","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0030","start":30,"end":31,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0034","start":34,"end":35,"surface":"廙","kind":"person","person_id":"7r6_k52_qji_ABDA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0036","start":36,"end":37,"surface":"俊","kind":"person","person_id":"0w5_r48_tfo","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0047","start":47,"end":49,"surface":"杜曾","kind":"person","person_id":"4vd_pg5_o8x","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0050","start":50,"end":51,"surface":"俊","kind":"person","person_id":"0w5_r48_tfo","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0052","start":52,"end":53,"surface":"攀","kind":"person","person_id":"200_oqy_d7c","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0055","start":55,"end":58,"surface":"第五猗","kind":"person","person_id":"kiy_6gd_i7y","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0060","start":60,"end":61,"surface":"廙","kind":"person","person_id":"7r6_k52_qji_ABDA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0062","start":62,"end":63,"surface":"廙","kind":"person","person_id":"7r6_k52_qji_ABDA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0067","start":67,"end":68,"surface":"曾","kind":"person","person_id":"4vd_pg5_o8x","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0071","start":71,"end":72,"surface":