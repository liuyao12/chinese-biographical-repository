{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003039","identity_policy":"contextual_provisional","person_ids":["cbr-p003039"],"persons":[{"id":"cbr-p003039","label":"王廖（陳涉世家褚氏引文候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"王廖","mention_ids":["c-shiji-048-chenshe:m023-0222"]}],"evidence":[{"mention_id":"c-shiji-048-chenshe:m023-0222","chapter_id":"c-shiji-048-chenshe","paragraph_id":"c-shiji-048-chenshe:p023","quote":"王廖"}]}],"source_mention_summary":[{"source_id":"s-shiji-048-chenshe","work_id":"w-shiji","book_id":"b-shiji-048","chapter_id":"c-shiji-048-chenshe","mention_count":1,"mention_ids":["c-shiji-048-chenshe:m023-0222"],"paragraph_ids":["c-shiji-048-chenshe:p023"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-048-chenshe"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-048-chenshe:m023-0222","start":222,"end":224,"surface":"王廖","kind":"person","person_id":"cbr-p003039","status":"contextual_provisional","paragraph_id":"c-shiji-048-chenshe:p023","chapter_id":"c-shiji-048-chenshe"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji048-077","person_id":"cbr-p003039","surfaces":["王廖"],"scope":"same_chapter","chapter_ids":["c-shiji-048-chenshe"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-048-chenshe:p023","quote":"孝公既沒，惠文王、武王、昭王蒙故業，因遺策，南取漢中，西舉巴蜀，東割膏腴之地，收要害之郡。諸侯恐懼，會盟而謀弱秦。不愛珍器重寶肥饒之地，以致天下之士。合從締交，相與為一。當此之時，齊有孟嘗，趙有平原，楚有春申，魏有信陵：此四君者，皆明知而忠信，寬厚而愛人，尊賢而重士。約從連衡，兼韓、魏、燕、趙、宋、衛、中山之眾。於是六國之士有甯越、徐尚、蘇秦、杜赫之屬為之謀，齊明、周聚、陳軫、邵滑、樓緩、翟景、蘇厲、樂毅之徒通其意，吳起、孫臏、帶他、兒良、王廖、田忌、廉頗、趙奢之倫制其兵。嘗以什倍之地，百萬之師，仰關而攻秦。秦人開關而延敵，九國之師遁逃而不敢進。秦無亡矢遺鏃之費，而天下固已困矣。於是從散約敗，爭割地而賂秦。秦有余力而制其獘，追亡逐北，伏尸百萬，流血漂櫓，因利乘便，宰割天下，分裂山河，彊國請服，弱國入朝。"}],"rationale":"限明示名、字及局部軍事角色；陳勝涉、吳廣叔、蔡賜房君與周文周章暫接，吳廣韓廣分開。引文四君短稱及比擬人物另留候選，詐稱扶蘇項燕不合陳吳，褚賈署稱不補姓名。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-048-chenshe:p023","text":"孝公既沒，惠文王、武王、昭王蒙故業，因遺策，南取漢中，西舉巴蜀，東割膏腴之地，收要害之郡。諸侯恐懼，會盟而謀弱秦。不愛珍器重寶肥饒之地，以致天下之士。合從締交，相與為一。當此之時，齊有孟嘗，趙有平原，楚有春申，魏有信陵：此四君者，皆明知而忠信，寬厚而愛人，尊賢而重士。約從連衡，兼韓、魏、燕、趙、宋、衛、中山之眾。於是六國之士有甯越、徐尚、蘇秦、杜赫之屬為之謀，齊明、周聚、陳軫、邵滑、樓緩、翟景、蘇厲、樂毅之徒通其意，吳起、孫臏、帶他、兒良、王廖、田忌、廉頗、趙奢之倫制其兵。嘗以什倍之地，百萬之師，仰關而攻秦。秦人開關而延敵，九國之師遁逃而不敢進。秦無亡矢遺鏃之費，而天下固已困矣。於是從散約敗，爭割地而賂秦。秦有余力而制其獘，追亡逐北，伏尸百萬，流血漂櫓，因利乘便，宰割天下，分裂山河，彊國請服，弱國入朝。","annotation_status":"named_mentions_first_pass","text_layer":"witness_appended_chu_note","mentions":[{"id":"c-shiji-048-chenshe:m023-0000","start":0,"end":2,"surface":"孝公","kind":"person","person_id":"cbr-p002975","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m023-0005","start":5,"end":8,"surface":"惠文王","kind":"person","person_id":"cbr-p002976","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m023-0009","start":9,"end":11,"surface":"武王","kind":"person","person_id":"cbr-p003017","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m023-0012","start":12,"end":14,"surface":"昭王","kind":"person","person_id":"cbr-p003018","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m023-0092","start":92,"end":94,"surface":"孟嘗","kind":"person","person_id":"cbr-p003019","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m023-0097","start":97,"end":99,"surface":"平原","kind":"person","person_id":"cbr-p003020","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m023-0102","start":102,"end":104,"surface":"春申","kind":"person","person_id":"cbr-p003021","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m023-0107","start":107,"end":109,"surface":"信陵","kind":"person","person_id":"cbr-p003022","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m023-0111","start":111,"end":113,"surface":"四君","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱、對話或未名者待核；普通動詞、詐稱與矯命