onal"},{"id":"c-jinshu-059-prince-ying:p008:m0365","surface":"徽","start":365,"end":366,"person_id":"fb9_e1a_dc1","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-059-prince-ying","book_id":"b-jinshu-059","work_id":"w-jinshu","source_id":"s-jinshu-059-prince-ying-ws2650517"},{"id":"c-jinshu-059-prince-ying:p009","text":"穎之敗也，官屬並奔散，惟盧志隨從不怠，論者稱之。其後汲桑害東贏公騰，稱為穎報仇，遂出穎棺，載之於軍中，每事啟靈，以行軍令。桑敗，度棺于故井中。穎故臣收之，改葬於洛陽，懷帝加以縣王禮。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":165,"last_line":165,"raw_start":17086,"raw_end":17179,"raw_character_offsets":[17088,17089,17090,17091,17092,17093,17094,17095,17096,17097,17098,17099,17100,17101,17102,17103,17104,17105,17106,17107,17108,17109,17110,17111,17112,17113,17114,17115,17116,17117,17118,17119,17120,17121,17122,17123,17124,17125,17126,17127,17128,17129,17130,17131,17132,17133,17134,17135,17136,17137,17138,17139,17140,17141,17142,17143,17144,17145,17146,17147,17148,17149,17150,17151,17152,17153,17154,17155,17156,17157,17158,17159,17160,17161,17162,17163,17164,17165,17166,17167,17168,17169,17170,17171,17172,17173,17174,17175,17176,17177,17178],"revision_id":2650517},"mentions":[{"id":"c-jinshu-059-prince-ying:p009:m0000","surface":"穎","start":0,"end":1,"person_id":"x4m_ygm_1d3","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-ying:p009:m0012","surface":"盧志","start":12,"end":14,"person_id":"m8n_ntm_79h_ABB","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-ying:p009:m0026","surface":"汲桑","start":26,"end":28,"person_id":"i8p_oo3_u9t","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-ying:p009:m0029","surface":"東贏公騰","start":29,"end":33,"person_id":"59u_70h_y1y","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-ying:p009:m0036","surface":"穎","start":36,"end":37,"person_id":"x4m_ygm_1d3","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-pr