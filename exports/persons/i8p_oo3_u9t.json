m0106","surface":"汲桑","start":106,"end":108,"person_id":"i8p_oo3_u9t","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p002:m0110","surface":"公師籓","start":110,"end":113,"person_id":"5jk_raq_mqx","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p002:m0115","surface":"石勒","start":115,"end":117,"person_id":"0c9_95a_18b","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-061-gouxi","book_id":"b-jinshu-061","work_id":"w-jinshu","source_id":"s-jinshu-061-gouxi-ws7903772"},{"id":"c-jinshu-061-gouxi:p007","text":"時懷帝惡越專權，乃詔晞曰：「朕以不德，戎車屢興，上懼宗廟之累，下湣兆庶之困，當賴方岳，為國籓翰。公威震赫然，梟斬籓、桑，走降喬、朗，魏植之徒復以誅除，豈非高識明斷，朕用委成。加王彌、石勒為社稷之憂，故有詔委統六州。而公謙分小節，稽違大命，非所謂與國同憂也。今復遣詔，便施檄六州，協同大舉，翦除國難，稱朕意焉。」晞復移諸征鎮州郡曰：","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":80,"last_line":80,"raw_start":5654,"raw_end":5821,"raw_character_offsets":[5656,5657,5658,5659,5660,5661,5662,5663,5664,5665,5666,5667,5668,5669,5670,5671,5672,5673,5674,5675,5676,5677,5678,5679,5680,5681,5682,5683,5684,5685,5686,5687,5688,5689,5690,5691,5692,5693,5694,5695,5696,5697,5698,5699,5700,5701,5702,5703,5704,5705,5706,5707,5708,5709,5710,5711,5712,5713,5714,5715,5716,5717,5718,5719,5720,5721,5722,5723,5724,5725,5726,5727,5728,5729,5730,5731,5732,5733,5734,5735,5736,5737,5738,5739,5740,5741,5742,5743,5744,5745,5746,5747,5748,5749,5750,5751,5752,5753,5754,5755,5756,5757,5758,5759,5760,5761,5762,5763,5764,5765,5766,5767,5768,5769,5770,5771,5772,5773,5774,5775,5776,5777,5778,5779,5780,5781,5782,5783,5784,5785,5786,5787,5788,5789,5790,5791,5792,5793,5794,5795,5796,5797,5798,5799,5800,5801,5802,5803,5804,5805,5806,5807,5808,5809,5810,5811,5812,5813,5814,5815,5816,5817,5818,5819,5820],"revision_id":7903772},"mentions":[{"id":"c-jinshu-061-gouxi:p007:m0001","surface":"懷帝","start":1,"end":3,"person_id":"83d_b6e_058","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p007:m0004","surface":"越","start":4,"