,"end":25,"person_id":"9o2_vhv_r7y","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-yue:p004:m0031","surface":"潘滔","start":31,"end":33,"person_id":"yir_cmm_s73","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-yue:p004:m0053","surface":"苟晞","start":53,"end":55,"person_id":"v5s_1ew_vh0","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-yue:p004:m0064","surface":"晞","start":64,"end":65,"person_id":"v5s_1ew_vh0","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-059-prince-yue","book_id":"b-jinshu-059","work_id":"w-jinshu","source_id":"s-jinshu-059-prince-yue-ws2650517"},{"id":"c-jinshu-059-prince-yue:p006","text":"王彌入許，越遣左司馬王斌率甲士五千人入衛京都。鄄城自壞，越惡之，移屯濮陽，又遷于滎陽。召田甄等六率，甄不受命，越遣監軍劉望討甄。初，東嬴公騰之鎮鄴也，攜并州將田甄、甄弟蘭、任祉、祁濟、李惲、薄盛等部眾萬餘人至鄴，遣就谷冀州，號為乞活。及騰敗，甄等邀破汲桑於赤橋，越以甄為汲郡，蘭為钜鹿大守。甄求魏郡，越不許，甄怒，故召不至。望既渡河，甄退。李惲、薄盛斬田蘭，率其眾降，甄、祉、濟棄軍奔上黨。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":193,"last_line":193,"raw_start":19943,"raw_end":20166,"raw_character_offsets":[19945,19946,19947,19948,19949,19950,19951,19952,19953,19954,19955,19956,19957,19958,19959,19960,19961,19962,19963,19964,19965,19966,19967,19968,19969,19970,19971,19972,19973,19974,19975,19976,19977,19978,19979,19980,19981,19982,19983,19984,19985,19986,19987,19988,19989,19990,19991,19992,19993,20020,20021,20022,20023,20024,20025,20026,20027,20028,20029,20030,20031,20032,20033,20034,20035,20036,20037,20038,20039,20040,20041,20042,20043,20044,20045,20046,20047,20048,20049,20050,20051,20052,20053,20054,20055,20056,20057,20058,20059,20060,20061,20062,20063,20064,20065,20066,20067,20068,20069,20070,20071,20072,20073,20074,20075,20076,20077,20078,20079,20080,20081,20082,20083,20084,20085,20086,20087,20088,20089,20090,20091,20092,20093,20094,20095,20096,20097,20098,20099,20100,20101,20102,20103,20104,20105,20106,20107,20108,20109,20110,20111,20112,20113,20114,20115,20116,20117,20118,20119,2012