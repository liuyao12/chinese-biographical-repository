17","start":117,"end":118,"surface":"圍","kind":"person","person_id":"cbr-p001889","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m029-0122","start":122,"end":124,"surface":"子比","kind":"person","person_id":"cbr-p001890","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m029-0128","start":128,"end":129,"surface":"圍","kind":"person","person_id":"cbr-p001889","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m029-0133","start":133,"end":135,"surface":"靈王","kind":"person","person_id":"cbr-p001889","status":"contextual_provisional"}],"chapter_id":"c-shiji-040-chu","book_id":"b-shiji-040","work_id":"w-shiji","source_id":"s-shiji-040-chu"},{"id":"c-shiji-040-chu:p031","text":"七月，楚以諸侯兵伐呉，圍朱方。八月，克之，囚慶封，滅其族。以封徇，曰：「無效齊慶封弒其君而弱其孤，以盟諸大夫！」封反曰：「莫如楚共王庶子圍弒其君兄之子員而代之立！」於是靈王使（棄）疾殺之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m031-0022","start":22,"end":24,"surface":"慶封","kind":"person","person_id":"cbr-p000419","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m031-0030","start":30,"end":31,"surface":"封","kind":"person","person_id":"cbr-p000419","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m031-0039","start":39,"end":41,"surface":"慶封","kind":"person","person_id":"cbr-p000419","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m031-0056","start":56,"end":57,"surface":"封","kind":"person","person_id":"cbr-p000419","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m031-0063","start":63,"end":66,"surface":"楚共王","kind":"person","person_id":"cbr-p001886","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m031-0068","start":68,"end":69,"surface":"圍","kind":"person","person_id":"cbr-p001889","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m031-0075","start":75,"end":76,"surface":"員","kind":"person","person_id":"cbr-p001888","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m031-0084","start":84,"end":86,"surface":"靈王","kind":"person","person_id":"cbr-p001889","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m031-0087","start":87,"end":91,"surface":"（棄）疾","kind":"person","person_id":"cbr-p001892","status":"contextual_provisional"}],"chapter_id":"c-shiji-040-chu","book_id":"b-shiji-040","work_id":"w-shiji","source_id":"s-shiji-040-chu"},{"id":"c-shiji-040-chu:p039","text":"初，共王有寵子五人，無適立，乃望祭群神，請神決之，使主社稷，而陰與巴姬埋璧於室内，召五公子齋而入。康王跨之，靈王肘加之，子比、子皙皆遠之。平王幼，抱其上而拜，壓紐。故康王以長立，至其子失之；圍爲靈王，及身而弒；子比爲王十餘日，子皙不得立，又倶誅。四子皆絶無後。唯獨棄疾後立，爲平王，竟續楚祀，如其神符。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m039-0002","start":2,"end":4,"surface":"共王","kind":"person","person_id":"cbr-p001886","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m039-0033","start":33,"end":35,"surface":"巴姬","kind":"person","person_id":"cbr-p001914","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m039-0042","start":42,"end":45,"surface":"五公子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、寓言人物或未定指代，未補未見姓名、全體成員或親屬關係。"},{"id":"c-shiji-040-chu:m039-0049","start":49,"end":51,"surface":"康王","kind":"person","person_id":"cbr-p001887","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m039-0054","start":54,"end":56,"surface":"靈王","kind":"person","person_id":"cbr-p001889","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m039-0060","start":60,"end":62,"surface":"子比","kind":"person","person_id":"cbr-p001890","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m039-0063","start":63,"end":65,"surface":"子皙","kind":"person","person_id":"cbr-p001891","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m039-0069","start":69,"end":71,"surface":"平王","kind":"person","person_id":"cbr-p001892","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m039-0083","start":83,"end":85,"surface":"康王","kind":"person","person_id":"cbr-p001887","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m039-0095","start":95,"end":96,"surface":"圍","k