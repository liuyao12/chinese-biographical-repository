ph"},{"canonical_mention_id":"c-jinshu-063-liju:p005:m0034","mention_ids":["c-jinshu-063-liju:p005:m0034"],"kind":"paragraph"}],"mention_count":3,"duplicate_mention_count":0,"paragraph_occurrence_count":3,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"3處獨立位置，3個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-063-guomo-ws2025242"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin063-guozhi-mo-brother","subject_person_id":"u3k_407_1d7","object_person_id":"799_f6c_778","predicate":"brother","qualifiers":{"source_term":"默遣弟芝"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-063","chapter_id":"c-jinshu-063-guomo","source_id":"s-jinshu-063-guomo-ws2025242","paragraph_id":"c-jinshu-063-guomo:p001","quote":"郭默，河內懷人。少微賤，以壯勇事太守裴整，為督將。永嘉之亂，默率遺眾自為塢主，以漁舟抄東歸行旅，積年遂致巨富，流人依附者漸眾。撫循將士，甚得其歡心。默婦兄同郡陸嘉取官米數石餉妹，默以為違制，將殺嘉，嘉懼，奔石勒。默乃自射殺婦，以明無私。遣使謁劉琨，琨加默河內太守。劉元海遣從子曜討默，曜列三屯圍之，欲使餓死。默送妻子為質，並請糴焉，糴畢，設守。曜怒，沈默妻子于河而攻之。默遣弟芝求救于劉琨，琨知默狡猾，留之而緩其救。默更遣人告急。會芝出城浴馬，使強與俱歸。默乃遣芝質于石勒，勒以默多詐，封默書與劉曜。默使人伺得勒書，便突圍投李矩。後與矩並力距劉、石，事見矩傳。","subject_person_mention_id":"c-jinshu-063-guomo:p001:m0188","object_person_mention_id":"c-jinshu-063-guomo:p001:m0000"}],"status":"source_attested","interpretation_note":"弟芝奉郭默命求救。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"a-jin063-guozhi-brother","subject_person_id":"u3k_407_1d7","object_person_id":"799_f6c_778","predicate":"brother","qualifiers":{"source_term":"遣弟芝"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-063","chapter_id":"c-jinshu-063-liju","source_id":"s-jinshu-063-liju-ws2025242","paragraph_id":"c-jinshu-063-liju:p005","quote":"先是，郭默聞矩被攻，遣弟芝率眾援之。既而聞破暢，芝復馳來赴矩。矩乃與芝馬五百匹，分軍為三道，夜追賊，復大獲而旋。","subject_person_mention_id":"c-jinshu-063-liju:p005:m0012","object_person_mention_id":"c-jinshu-063-liju:p005:m0003"}],"status":"source_attested","interpretation_note":"芝為默弟。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-063-guomo:p001:m0188","surface":"芝","start":188,"end":189,"person_id":"u3k_407_1d7","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-063-guomo:p001","chapter_id":"c-jinshu-063-guomo"},{"id":"c-jinshu-063-guomo:p001:m0202","surface":"之","start":202,"end":203,"person_id":"u3k_407_1d7","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-063-guomo:p001","chapter_id":"c-jinshu-063-guomo"},{"id":"c-jinshu-063-guomo:p001:m0216","surface":"芝","start":216,"end":217,"person_id":"u3k_407_1d7","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-063-guomo:p001","chapter_id":"c-jinshu-063-guomo"},{"id":"c-jinshu-063-guomo:p001:m0231","surface":"芝","start":231,"end":232,"person_id":"u3k_407_1d7","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-063-guomo:p001","chapter_id":"c-jinshu-063-guomo"},{"id":"c-jinshu-063-liju:p005:m0012","surface":"芝","start":12,"end":13,"person_id":"u3k_407_1d7","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-063-liju:p005","chapter_id":"c-jinshu-063-liju"},{"id":"c-jinshu-063-liju:p005:m0024","surface":"芝","start":24,"end":25,"person_id":"u3k_407_1d7","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-063-liju:p005","chapter_id":"c-jinshu-063-liju"},{"id":"c-jinshu-063-liju:p005:m0034","surface":"芝","start"