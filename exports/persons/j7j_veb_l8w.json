ional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-044-zhengmao:line013","chapter_id":"c-jinshu-044-zhengmao"},{"id":"c-jinshu-044-zhengmao:line015:m0033","start":33,"end":35,"surface":"王肅","kind":"person","person_id":"j7j_veb_l8w","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-044-zhengmao:line015","chapter_id":"c-jinshu-044-zhengmao"},{"id":"c-jinshu-044-zhengmao:line015:m0048","start":48,"end":49,"surface":"肅","kind":"person","person_id":"j7j_veb_l8w","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-044-zhengmao:line015","chapter_id":"c-jinshu-044-zhengmao"},{"id":"c-shishuoxinyu-030-jin098-dun-early:kaizi:m0010","start":10,"end":12,"surface":"王肅","kind":"person","person_id":"j7j_veb_l8w","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-shishuoxinyu-030-jin098-dun-early:kaizi","chapter_id":"c-shishuoxinyu-030-jin098-dun-early"},{"start":51,"end":53,"surface":"王肅","id":"c-songshu-060-wangzhunzhi:p003:m0051","person_id":"j7j_veb_l8w","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作肅。","paragraph_id":"c-songshu-060-wangzhunzhi:p003","chapter_id":"c-songshu-060-wangzhunzhi"}],"relations":[],"title_holdings":[{"id":"th-w044-zhengmao-20","person_id":"j7j_veb_l8w","title":"河南尹","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-044","chapter_id":"c-jinshu-044-zhengmao","source_id":"s-jinshu-044-zhengmao","paragraph_id":"c-jinshu-044-zhengmao:line013","quote":"魏武帝初封諸子為侯，精選賓友，袤與徐幹俱為臨淄侯文學，轉司隸功曹從事。司空王朗辟為掾，袤舉高陽許允、扶風魯芝、東萊王基，朗皆命之，後咸至大位，有重名。袤遷尚書郎。出為黎陽令，吏民悅服。太守班下屬城，特見甄異，為諸縣之最。遷尚書右丞。轉濟陰太守，下車旌表孝悌，敬禮賢能，興立庠序，開誘後進。調補大將軍從事中郎，拜散騎常侍。會廣平太守缺，宣帝謂袤曰：「賢叔大匠垂稱于陽平、魏郡，百姓蒙惠化。且盧子家、王子雍繼踵此郡，使世不乏賢，故復相屈。」袤在廣平，以德化為先，善作條教，郡中愛之。徵拜侍中，百姓戀慕，涕泣路隅。遷少府。高貴鄉公即位，袤與河南尹王肅備法駕奉迎於元城，封廣昌亭侯。徙光祿勳，領宗正。","person_mention_id":"c-jinshu-044-zhengmao:line013:m0198"}],"attestations":[{"id":"th-w043-zhengmao-20:a","paragraph_id":"c-jinshu-044-zhengmao:line013","start":267,"end":270,"surface":"河南尹","person_mention_id":"c-jinshu-044-zhengmao:line013:m0198","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"th-w044-zhengmao-21","person_id":"j7j_veb_l8w","title":"中領軍","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-044","chapter_id":"c-jinshu-044-zhengmao","source_id":"s-jinshu-044-zhengmao","paragraph_id":"c-jinshu-044-zhengmao:line015","quote":"毌丘儉作亂，景帝自出征之，百官祖送於城東，袤疾病不任會。帝謂中領軍王肅曰：「唯不見鄭光祿為恨。」肅以語袤，袤自輿追帝，及於近道。帝笑曰：「故知侯生必來也。」遂與袤共載，曰：「計將何先？」袤曰：「昔與儉俱為台郎，特所知悉。其人好謀而不達事情，自昔建勳幽州，志望無限。文欽勇而無算。今大軍出其不意，江、淮之卒銳而不能固，深溝高壘以挫其氣，此亞夫之長也。」帝稱善。轉太常。高貴鄉公議立明堂辟雍，精選博士，袤舉劉毅、劉寔、程咸、庾峻，後並至公輔大位。及常道鄉公立，與議定策，進封安城鄉侯，邑千戶。景元初，疾病失明，屢乞骸骨，不許。拜光祿大夫。五等初建，封密陵伯。","person_mention_id":"c-jinshu-044-zhengmao:line015:m0033"}],"attestations":[{"id":"th-w043-zhengmao-21:a","paragraph_id":"c-jinshu-044-zhengmao:line015","start":30,"end":33,"surface":"中領軍","person_mention_id":"c-jinshu-044-zhengmao:line015:m0033","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-044-zhengmao:line013","text":"魏武帝初封諸子為侯，精選賓友，袤與徐幹俱為臨淄侯文學，轉司隸功曹從事。司空王朗辟為掾，袤舉高陽許允、扶風魯芝、東萊王基，朗皆命之，後咸至大位，有重名。袤遷尚書郎。出為黎陽令，吏民悅服。太守班下屬城，特見甄異，為諸縣之最。遷尚書右丞。轉濟陰太守，下車旌表孝悌，敬禮賢能，興立庠序，開誘後進。調補大將軍從事中郎，拜散騎常侍。會廣平太守缺，宣帝謂袤曰：「賢叔大匠垂稱于陽平、魏郡，百姓蒙惠化。且盧子家、王子雍繼踵此郡，使世不乏賢，故復相屈。」袤在廣平，以德化為先，善作條教，郡中愛之。徵拜侍中，百姓戀慕，涕泣路隅。遷少府。高貴鄉公即位，袤與河南尹王肅備法駕奉迎於元城，封廣昌亭侯。徙光祿勳，領宗正。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-044-zhengmao:line013:m0000","start":0,"end":3,"surface":"魏武帝","kind":"person","person_id":"dad_b77_b38","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-zhengmao:line013:m0015","start":15,"end":16,"surface":"袤","kind":"person","person_id":"ae4_588_bdb_A","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-zhengmao:line013:m0017","start":17,"end":19,"surface":"徐幹","kind":"person","person_id":"6cf_d80_a57","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-zhengmao:line013:m0021","start":21,"end":24,"surface":"臨淄侯","kind":"person","person_id":"p6s_2qn_p8n","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-zhengmao:line013:m0037","start":37,"end":39,"surface":"王朗","kind":"person","person_id":"d21_081_910","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-zhengmao:line013:m0043","start":43,"end":44,"surface":"袤","kind":"person","person_id":"ae4_588_bdb_A","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-zhengmao:line013:m0047","start":47,"end":49,"surface":"許允","kind":"person","person_id":"s0c_yo6_6gq","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-zhengmao:line013:m0052","start":52,"end":54,"surface":"魯芝","kind":"person","person_id":"p2q_m63_1jq","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-zhengmao:line013:m0057","start":57,"end":59,"surface":"王基","kind":"person","person_id":"7f4_2d4_c15","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-zhengmao:line013:m0060","start":60,"end":61,"