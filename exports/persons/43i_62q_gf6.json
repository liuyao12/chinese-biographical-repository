onical_mention_id":"shiji-020-t1-r061-c06-m000","mention_ids":["shiji-020-t1-r061-c06-m000"],"kind":"table_cell"}],"mention_count":2,"duplicate_mention_count":0,"paragraph_occurrence_count":0,"table_occurrence_count":2,"passage_count":2,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"2處獨立位置，2個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-shiji114-dongyue","table-witness-shiji-020"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"person_id":"43i_62q_gf6","title":"開陵侯","surname":null,"ming":"敖","additional_names":["建成侯"],"chapter_id":"c-shiji-114-dongyue","paragraph_id":"c-shiji-114-dongyue:p009","quote":"故越衍侯吳陽前在漢，漢使歸諭餘善，餘善弗聽。及橫海將軍先至，越衍侯吳陽以其邑七百人反，攻越軍於漢陽。從建成侯敖，與其率，從繇王居股謀曰：「餘善首惡，劫守吾屬。今漢兵至，眾彊，計殺餘善，自歸諸將，儻幸得脫。」乃遂俱殺餘善，以其眾降橫海將軍，故封繇王居股為東成侯，萬戶；封建成侯敖為開陵侯；封越衍侯吳陽為北石侯；封橫海將軍說為案道侯；封橫海校尉福為繚嫈侯。福者，成陽共王子，故為海常侯，坐法失侯。舊從軍無功，以宗室故侯。諸將皆無成功，莫封。東越將多軍，漢兵至，棄其軍降，封為無錫侯。","references":[{"title":"漢書顏師古注","url":"https://github.com/kanripo/KR2a0007/blob/683113d4baf6febecaf2ccb7913df87c4d68d454/KR2a0007_095.txt#L416-L418","source_commit":"683113d4baf6febecaf2ccb7913df87c4d68d454","source_blob_sha":"b41576d7d677e481940c3a7f222a09837c85e8f7","response_sha256":"defa20130c3e1235164fab6d887a3f2b72894874b5658a6383ad028f356b344a","raw_quote":"及故粤建成侯敖與繇王居股謀俱殺餘善以其衆降¶\n横海軍封居股為東成侯萬户封敖為開陵侯(師古曰/功臣表)¶\n(云開陵侯建成以故東粤建成侯斬餘/善侯二千户而此𫝊云名敖疑表誤)封陽為印石侯¶","quote":"而此𫝊云名敖疑表誤","scope":"primary_commentary_reference_not_image_collation","image_verified":false},{"title":"《史記・建元以來侯者年表》原列","url":"https://zh.wikisource.org/w/index.php?title=史記/卷020&oldid=2607036","quote":"六。元年閏月癸卯，侯建成元年。","table_id":"shiji-020","table_cell_id":"shiji-020-t1-r061-c06","work_id":"w-shiji","book_id":"b-shiji-020","chapter_id":"table-chapter-shiji-020","source_id":"table-witness-shiji-020","source_revision":"2607036","scope":"received_table_person_identity","image_verified":false}],"note":"本傳建成侯敖及漢書注名敖作名；原表建成保留為來源讀法，不採作本名。","status":"editorial_provisional","human_reviewed":false,"work_id":"w-shiji","book_id":"b-shiji-114","source_id":"s-shiji114-dongyue"}],"mentions":[{"id":"c-shiji-114-dongyue:m009-0054","start":54,"end":55,"surface":"敖","kind":"person","person_id":"43i_62q_gf6","status":"contextual_provisional","paragraph_id":"c-shiji-114-dongyue:p009","chapter_id":"c-shiji-114-dongyue"},{"id":"c-shiji-114-dongyue:m009-0137","start":137,"end":138,"surface":"敖","kind":"person","person_id":"43i_62q_gf6","status":"contextual_provisional","paragraph_id":"c-shiji-114-dongyue:p009","chapter_id":"c-shiji-114-dongyue"}],"relations":[],"title_holdings":[{"id":"th-table-shiji020-r061-founding-grant","person_id":"43i_62q_gf6","title":"開陵侯","kind":"noble_rank","mode":"grant","status":"source_attested","source_representation":"table_cells","evidence":[{"kind":"table_cell","table_id":"shiji-020","table_cell_id":"shiji-020-t1-r061-c00","quote":"開陵。","work_id":"w-shiji","book_id":"b-shiji-020","chapter_id":"table-chapter-shiji-020","source_id":"table-witness-shiji-020","source_revision":"2607036","source_role":"fief_name"},{"kind":"table_cell","table_id":"shiji-020","table_cell_id":"shiji-020-t1-r061-c01","quote":"以故東越建成侯與繇王共斬東越王餘善功侯。","work_id":"w-shiji","book_id":"b-shiji-020","chapter_id":"table-chapter-shiji-020","source_id":"table-witness-shiji-020","source_revision":"2607036","source_role":"merit"},{"kind":"table_cell","table_id":"shiji-020","table_cell_id":"shiji-020-t