ent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-nanqishu-055-filial-complete:source_review32-0","kind":"source_review","person_id":"zqk_nnv_z03","source_quote":"　　鴈門解仲恭，亦僑居南郡。家行敦睦，得纖豪財利，輙與兄弟平分。母病經時不差，入山採藥，遇一老父語之曰：「得丁公藤，病立愈。此藤近在前山際高樹垂下便是也。」忽然不見。仲恭如其言得之，治病，母即差。至今江陵人猶有識此藤者。","reading":"解仲恭母病事中的老父無名，文末為江陵傳聞，原身分不補。","note":"解仲恭母病事中的老父無名，文末為江陵傳聞，原身分不補。","paragraph_id":"c-nanqishu-055-filial-complete:p032","start_codepoint":0,"end_codepoint":110,"human_reviewed":false,"chapter_id":"c-nanqishu-055-filial-complete","source_id":"s-nanqishu-055-filial-complete-ws1545598"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-055-filial-complete:p032:m0004","start":4,"end":7,"surface":"解仲恭","kind":"person","person_id":"zqk_nnv_z03","status":"contextual_provisional","paragraph_id":"c-nanqishu-055-filial-complete:p032","chapter_id":"c-nanqishu-055-filial-complete"},{"id":"c-nanqishu-055-filial-complete:p032:m0083","start":83,"end":85,"surface":"仲恭","kind":"person","person_id":"zqk_nnv_z03","status":"contextual_provisional","paragraph_id":"c-nanqishu-055-filial-complete:p032","chapter_id":"c-nanqishu-055-filial-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-055-filial-complete:p032","text":"　　鴈門解仲恭，亦僑居南郡。家行敦睦，得纖豪財利，輙與兄弟平分。母病經時