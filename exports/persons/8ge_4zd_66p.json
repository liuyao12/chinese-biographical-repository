m0136","start":136,"end":137,"surface":"潘","person_id":"8ge_4zd_66p","kind":"person","status":"contextual_provisional","interpretation_note":"承前潘淑妃，姓氏省稱。","paragraph_id":"c-nanshi-011-yuanqigui:p001","chapter_id":"c-nanshi-011-yuanqigui"},{"id":"c-songshu-041-yuanqigui:p001:m0111","start":111,"end":112,"surface":"潘","person_id":"8ge_4zd_66p","kind":"person","status":"contextual_provisional","interpretation_note":"姓潘，以淑妃稱此人。","paragraph_id":"c-songshu-041-yuanqigui:p001","chapter_id":"c-songshu-041-yuanqigui"},{"id":"c-songshu-041-yuanqigui:p001:m0141","start":141,"end":142,"surface":"潘","person_id":"8ge_4zd_66p","kind":"person","status":"contextual_provisional","interpretation_note":"承前潘淑妃，姓氏省稱。","paragraph_id":"c-songshu-041-yuanqigui:p001","chapter_id":"c-songshu-041-yuanqigui"}],"relations":[],"title_holdings":[],"address_assertions":[],"person_references":[{"id":"c-nanshi-011-panshufei:p001:r0001","start":1,"end":3,"surface":"淑妃","person_id":"8ge_4zd_66p","paragraph_id":"c-nanshi-011-panshufei:p001","referent_role":"third_person","quote":"潘淑妃者，本以貌進，始未見賞。帝好乘羊車經諸房，淑妃每莊飾褰帷以候，並密令左右以鹹水灑地。帝每至戶，羊輒舐地不去。帝曰：「羊乃為汝徘徊，況於人乎。」于此愛傾後宮。","note":"按本句指潘淑妃（宋文帝）。","chapter_id":"c-nanshi-011-panshufei","book_id":"b-nanshi-011","work_id":"w-nanshi","source_id":"s-nanshi-011-panshufei-ws2288359"},{"id":"c-nanshi-011-panshufei:p001:r0024","start":24,"end":26,"surface":"淑妃","person_id":"8ge_4zd_66p","paragraph_id":"c-nanshi-011-panshufei:p001","referent_role":"third_person","quote":"潘淑妃者，本以貌進，始未見賞。帝好乘羊車經諸房，淑妃每莊飾褰帷以候，並密令左右以鹹水灑地。帝每至戶，羊輒舐地不去。帝曰：「羊乃為汝徘徊，況於人乎。」于此愛傾後宮。","note":"按本句指潘淑妃（宋文帝）。","chapter_id":"c-nanshi-011-panshufei","book_id":"b-nanshi-011","work_id":"w-nanshi","source_id":"s-nanshi-011-panshufei-ws2288359"},{"id":"c-nanshi-011-panshufei:p001:r0064","start":64,"end":65,"surface":"汝","person_id":"8ge_4zd_66p","paragraph_id":"c-nanshi-011-panshufei:p001","referent_role":"addressee","quote":"潘淑妃者，本以貌進，始未見賞。帝好乘羊車經諸房，淑妃每莊飾褰帷以候，並密令左右以鹹水灑地。帝每至戶，羊輒舐地不去。帝曰：「羊乃為汝徘徊，況於人乎。」于此愛傾後宮。","note":"按本句指潘淑妃（宋文帝）。","chapter_id":"c-nanshi-011-panshufei","book_id":"b-nanshi-011","work_id":"w-nanshi","source_id":"s-nanshi-011-panshufei-ws2288359"},{"id":"c-nanshi-011-yuanqigui:p001:r0107","start":107,"end":109,"surface":"淑妃","person_id":"8ge_4zd_66p","paragraph_id":"c-nanshi-011-yuanqigui:p001","referent_role":"third_person","quote":"文元袁皇后諱齊媯，陳郡陽夏人，左光祿大夫湛之庶女也。母本卑賤，后年至六歲方見舉。後適文帝，初拜宜都王妃，生子劭、東陽獻公主英娥。上待后恩禮甚篤，袁氏貧薄，后每就上求錢帛以贍之。上性儉，所得不過五三萬、五三十匹。後潘淑妃有寵，愛傾後宮，咸言所求無不得。后聞之，未知信否，乃因潘求三十萬錢與家，以觀上意，宿昔便得。因此恚恨稱疾，不復見上，遂憤恚成疾。元嘉十七年疾篤，上執手流涕，問所欲言。后視上良久，乃引被覆面，崩于顯陽殿。上甚悼痛之，詔前永嘉太守顏延之為哀策，文甚麗。及奏，上自益「撫存悼亡，感今懷昔。」八字以致意焉。有司奏諡宣皇后，詔諡曰元。初，后生劭，自詳視之，使馳白帝：「此兒形貌異常，必破國亡家，不可舉。」便欲殺之。文帝狼狽至後殿戶外，手掇幔禁之乃止。","note":"按本句指潘淑妃（宋文帝）。","chapter_id":"c-nanshi-011-yuanqigui","book_id":"b-nanshi-011","work_id":"w-nanshi","source_id":"s-nanshi-011-yuanqigui-ws2288359"},{"id":"c-songshu-041-yuanqigui:p001:r0112","start":112,"end":114,"surface":"淑妃","person_id":"8ge_4zd_66p","paragraph_id":"c-songshu-041-yuanqigui:p001","referent_role":"third_person","quote":"文帝袁皇后諱齊媯，陳郡陽夏人，左光祿大夫敬公湛之庶女也。母本卑賤，后年五六歲，方見舉。後適太祖，初拜宜都王妃。生子劭、東陽獻公主英娥。上待后恩禮甚篤，袁氏貧薄，后每就上求錢帛以贍與之，上性節儉，所得不過三五萬、三五十匹。後潘淑妃有寵，愛傾後宮，咸言所求無不得，后聞之，欲知信否，乃因潘求三十萬錢與家，以觀上意，信宿便得。因此恚恨甚深，稱疾不復見上。上每入，必他處回避。上數掩伺之，不能得。始興王濬諸庶子問訊，后未嘗視也。后遂憤恚成疾。元嘉十七年，疾篤，上執手流涕問所欲言，后視上良久，乃引被覆面。崩于顯陽殿，時年三十六。上甚相悼痛，詔前永嘉太守顏延之為哀策，文甚麗。其辭曰：","note":"按本句指潘淑妃（宋文帝）。","chapter_id":"c-songshu-041-yuanqigui","book_id":"b-songshu-041","work_id":"w-songshu","source_id":"s-songshu-041-yuanqigui-ws2634831"},{"id":"c-songshu-046-zhao-family-witness:p003:r0034","paragraph_id":"c-songshu-046-zhao-family-witness:p003","start":34,"end":36,"surface":"潘妃","person_id":"8ge_4zd_66p","referent_role":"third_person","quote":"典筆吏取筆不如意，鞭五十。子倩，尚文帝第四女海鹽公主。初，始興王濬以潘妃之寵，故得出入後宮，遂與公主私通。及適倩，倩入宮而怒，肆詈搏擊，引絕帳帶。事上聞，有詔離婚，殺主所生蔣美人，伯符慚懼發病卒。諡曰肅。傳國至孫勗，齊受禪，國除。","note":"依本段敘事、稱謂及語者受者定。","chapter_id":"c-songshu-046-zhao-family-witness","book_id":"b-songshu-046","work_id":"w-songshu","source_id":"s-songshu-046-zhao-family-witness-ws2118581"},{"id":"c-songshu-046-zhaoqian-complete:p001:r0021","paragraph_id":"c-songshu-046-zhaoqian-complete:p001","start":21,"end":23,"surface":"潘妃","person_id":"8ge_4zd_66p","referent_role":"third_person","quote":"子倩，尚文帝第四女海鹽公主。初，始興王濬以潘妃之寵，故得出入後宮，遂與公主私通。及適倩，倩入宮而怒，肆詈搏擊，引絕帳帶。事上聞，有詔離婚，殺主所生蔣美人，","note":"依本段敘事、稱謂及語者受者定。","chapter_id":"c-songshu-046-zhaoqian-complete","book_id":"b-songshu-046","work_id":"w-songshu","source_id":"s-songshu-046-zhaoqian-complete-ws2118581"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanshi-011-panshufei:p001","text":"潘淑妃者，本以貌進，始未見賞。帝好乘羊車經諸房，淑妃每莊飾褰帷以候，並密令左右以鹹水灑地。帝每至戶，羊輒舐地不去。帝曰：「羊乃為汝徘徊，況於人乎。」于此愛傾後宮。","mentions":[{"id":"c-nanshi-011-panshufei:p001:m0000","start":0,"end":1,"surface":"潘","person_id":"8ge_4zd_66p","kind":"person","status":"contextual_provisional","interpretation_note":"傳文僅以姓潘及淑妃之號辨人。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":2288359,"first_line":40,"last_line":40,"raw_start":2802,"raw_end":2883,"raw_character_offsets":[2802,2803,2804,2805,2806,2807,2808,2809,2810,2811,2812,2813,2814,2815,2816,2817,2818,2819,2820,2821,2822,2823,2824,2825,2826,2827,2828,2829,2830,2831,2832,2833,2834,2835,2836,2837,2838,2839,2840,2841,2842,2843,2844,2845,2846,2847,2848,2849,2850,2851,2852,2853,2854,2855,2856,2857,2858,2859,2860,2861,2862,2863,2864,2865,2866,2867,2868,2869,2870,2871,2872,2873,2874,2875,2876,2877,2878,2879,2880,2881,2882],"projection_sha256":"6d024d9f4b8852f0e4ab470067369a646605234526f3ac7526c6cb03546ea16b","source_layer":"received_biography","editorial_excerpt_boundary":false},"chapter_id":"c-nanshi-011-panshufei","book_id":"b-nanshi-011","work_id":"w-nanshi","source_id":"s-nanshi-011-panshufei-ws2288359"},{"id":"c-nanshi-011-yuanqigui:p001","text":"文元袁皇后諱齊媯，陳郡陽夏人，左光祿大夫湛之庶女也。母本卑賤，后年至六歲方見舉。後適文帝，初拜宜都王妃，生子劭、東陽獻公主英娥。上待后恩禮甚篤，袁氏貧薄，后每就上求錢帛以贍之。上性儉，所得不過五三萬、五三十匹。後潘淑妃有寵，愛傾後宮，咸言所求無不得。后聞之，未知信否，乃因潘求三十萬錢與家，以觀上意，宿昔便得。因此恚恨稱疾，不復見上，遂憤恚成疾。元嘉十七年疾篤，上執手流涕，問所欲言。后視上良久，乃引被覆面，崩于顯陽殿。上甚悼痛之，詔前永嘉太守顏延之為哀策，文甚麗。及奏，上自益「撫存悼亡，感今懷昔。」八字以致意焉。有司奏諡宣皇后，詔諡曰元。初，后生劭，自詳視之，使馳白帝：「此兒形貌異常，必破國亡家，不可舉。」便欲殺之。文帝狼狽至後殿戶外，手掇幔禁之乃止。","mentions":[{"id":"c-nanshi-011-yuanqigui:p001:m0006","start":6,"end":8,"surface":"齊媯","person_id":"3tt_4ey_uti_A","kind":"person","status":"contextual_provisional","interpretation_note":"本段具名或具姓人物為袁齊媯。"},{"id":"c-nanshi-011-yuanqigui:p001:m0020","start":20,"end":21,"surface":"湛","person_id":"3tt_4ey_uti","kind":"person","status":"contextual_provisional","interpretation_note":"本段具名或具姓人物為袁湛。"},{"id":"c-nanshi-011-yuanqigui:p001:m0054","start":54,"end":55,"surface":"劭","person_id":"fof_k8v_7md","kind":"person","status":"contextual_provisional","interpretation_note":"本段具名或具姓人物為宋元凶劭。"},{"id":"c-nanshi-011-yuanqigui:p001:m0061","start":61,"end":63,"surface":"英娥","person_id":"3bh_k4m_fg4_A","kind":"person","status":"contextual_provisional","interpretation_note":"本段具名或具姓人物為東陽獻公主。"},{"id":"c-nanshi-011-yuanqigui:p001:u0072","start":72,"end":74,"surface":"袁氏","person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"皇后本家共稱。"},{"id":"c-nanshi-011-yuanqigui:p001:m0106","start":106,"end":107,"surface":"潘","person_id":"8ge_4zd_66p","kind":"person","status":"contextual_provisional","interpretation_note":"姓潘，以淑妃稱此人。"},{"id":"c-nanshi-011-yuanqigui:p001:m0136","start":136,"end":137,"surface":"潘","person_id":"8ge_4zd_66p","kind":"person","status":"contextual_provisional","interpretation_note":"承前潘淑妃，姓氏省稱。"},{"id":"c-nanshi-011-yuanqigui:p001:m0222","start":222,"end":225,"surface":"顏延之","person_id":"ftg_rxy_day","kind":"person","status":"contextual_provisional","interpretation_note":"本段具名或具姓人物為顏延之。"},{"id":"c-nanshi-011-yuanqigui:p001:m0275","start":275,"end":276,"surface":"劭","person_id":"fof_k8v_7md","kind":"person","status":"contextual_provisional","interpretation_note":"本段具名或具姓人物為宋元凶劭。"}],"text_layer":"received_chapter","annotation_status":"reviewed","sou