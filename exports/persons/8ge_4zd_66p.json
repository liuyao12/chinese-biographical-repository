{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"8ge_4zd_66p","canonical_person_id":"8ge_4zd_66p","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["8ge_4zd_66p"],"persons":[{"id":"8ge_4zd_66p","label":"潘淑妃（宋文帝）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"潘淑妃","mention_ids":["c-liangshu-007-dinglingguang:p003:m0201","c-nanshi-012-dinglingguang:p002:m0131"]}],"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-011","chapter_id":"c-nanshi-011-yuanqigui","source_id":"s-nanshi-011-yuanqigui-ws2288359","paragraph_id":"c-nanshi-011-yuanqigui:p001","quote":"潘","mention_id":"c-nanshi-011-yuanqigui:p001:m0106"},{"work_id":"w-nanshi","book_id":"b-nanshi-011","chapter_id":"c-nanshi-011-yuanqigui","source_id":"s-nanshi-011-yuanqigui-ws2288359","paragraph_id":"c-nanshi-011-yuanqigui:p001","quote":"潘","mention_id":"c-nanshi-011-yuanqigui:p001:m0136"},{"work_id":"w-songshu","book_id":"b-songshu-041","chapter_id":"c-songshu-041-yuanqigui","source_id":"s-songshu-041-yuanqigui-ws2634831","paragraph_id":"c-songshu-041-yuanqigui:p001","quote":"潘","mention_id":"c-songshu-041-yuanqigui:p001:m0111"},{"work_id":"w-songshu","book_id":"b-songshu-041","chapter_id":"c-songshu-041-yuanqigui","source_id":"s-songshu-041-yuanqigui-ws2634831","paragraph_id":"c-songshu-041-yuanqigui:p001","quote":"潘","mention_id":"c-songshu-041-yuanqigui:p001:m0141"},{"work_id":"w-nanshi","book_id":"b-nanshi-011","chapter_id":"c-nanshi-011-panshufei","source_id":"s-nanshi-011-panshufei-ws2288359","paragraph_id":"c-nanshi-011-panshufei:p001","quote":"潘","mention_id":"c-nanshi-011-panshufei:p001:m0000"},{"work_id":"w-songshu","book_id":"b-songshu-046","chapter_id":"c-songshu-046-zhao-family-witness","source_id":"s-songshu-046-zhao-family-witness-ws2118581","paragraph_id":"c-songshu-046-zhao-family-witness:p003","quote":"潘妃","kind":"person_reference","mention_id":"c-songshu-046-zhao-family-witness:p003:r0034"},{"work_id":"w-s