-nanshi-011-panshufei:p001","chapter_id":"c-nanshi-011-panshufei"},{"id":"c-nanshi-011-yuanqigui:p001:m0106","start":106,"end":107,"surface":"潘","person_id":"8ge_4zd_66p","kind":"person","status":"contextual_provisional","interpretation_note":"姓潘，以淑妃稱此人。","paragraph_id":"c-nanshi-011-yuanqigui:p001","chapter_id":"c-nanshi-011-yuanqigui"},{"id":"c-nanshi-011-yuanqigui:p001:m0136","start":136,"end":137,"surface":"潘","person_id":"8ge_4zd_66p","kind":"person","status":"contextual_provisional","interpretation_note":"承前潘淑妃，姓氏省稱。","paragraph_id":"c-nanshi-011-yuanqigui:p001","chapter_id":"c-nanshi-011-yuanqigui"},{"id":"c-nanshi-012-dinglingguang:p002:m0131","surface":"潘淑妃","start":131,"end":134,"person_id":"8ge_4zd_66p","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-nanshi-012-dinglingguang:p002","chapter_id":"c-nanshi-012-dinglingguang"},{"id":"c-songshu-041-yuanqigui:p001:m0111","start":111,"end":112,"surface":"潘","person_id":"8ge_4zd_66p","kind":"person","status":"contextual_provisional","interpretation_note":"姓潘，以淑妃稱此人。","paragraph_id":"c-songshu-041-yuanqigui:p001","chapter_id":"c-songshu-041-yuanqigui"},{"id":"c-songshu-041-yuanqigui:p001:m0141","start":141,"end":142,"surface":"潘","person_id":"8ge_4zd_66p","kind":"person","status":"contextual_provisional","interpretation_note":"承前潘淑妃，姓氏省稱。","paragraph_id":"c-songshu-041-yuanqigui:p001","chapter_id":"c-songshu-041-yuanqigui"}],"relations":[],"title_holdings":[],"address_assertions":[],"person_references":[{"id":"c-nanshi-011-panshufei:p001:r0001","start":1,"end":3,"surface":"淑妃","person_id":"8ge_4zd_66p","paragraph_id":"c-nanshi-011-panshufei:p001","referent_role":"third_person","quote":"潘淑妃者，本以貌進，始未見賞。帝好乘羊車經諸房，淑妃每莊飾褰帷以候，並密令左右以鹹水灑地。帝每至戶，羊輒舐地不去。帝曰：「羊乃為汝徘徊，況於人乎。」于此愛傾後宮。","note":"按本句指潘淑妃（宋文帝）。","chapter_id":"c-nanshi-011-panshufei","book_id":"b-nanshi-011","work_id":"w-nanshi","source_id":"s-nanshi-011-panshufei-ws2288359"},{"id":"c-nanshi-011-panshufei:p001:r0024","start":24,"end":26,"surface":"淑妃","person_id":"8ge_4zd_66p","paragraph_id":"c-nanshi-011-panshufei:p001","referent_role":"third_person","quote":"潘淑妃者，本以貌進，始未見賞。帝好乘羊車經諸房，淑妃每莊飾褰帷以候，並密令左右以鹹水灑地。帝每至戶，羊輒舐地不去。帝曰：「羊乃為汝徘徊，況於人乎。」于此愛傾後宮。","note":"按本句指潘淑妃（宋文帝）。","chapter_id":"c-nanshi-011-panshufei","book_id":"b-nanshi-011","work_id":"w-nanshi","source_id":"s-nanshi-011-panshufei-ws2288359"},{"id":"c-nanshi-011-panshufei:p001:r0064","start":64,"end":65,"surface":"汝","person_id":"8ge_4zd_66p","paragraph_id":"c-nanshi-011-panshufei:p001","referent_role":"addressee","quote":"潘淑妃者，本以貌進，始未見賞。帝好乘羊車經諸房，淑妃每莊飾褰帷以候，並密令左右以鹹水灑地。帝每至戶，羊輒舐地不去。帝曰：「羊乃為汝徘徊，況於人乎。」于此愛傾後宮。","note":"按本句指潘淑妃（宋文帝）。","chapter_id":"c-nanshi-011-panshufei","book_id":"b-nanshi-011","work_id":"w-nanshi","source_id":"s-nanshi-011-panshufei-ws2288359"},{"id":"c-nanshi-011-yuanqigui:p001:r0107","start":107,"end":109,"surface":"淑妃","person_id":"8ge_4zd_66p","paragraph_id":"c-nanshi-011-yuanqigui:p001","referent_role":"third_person","quote":"文元袁皇后諱齊媯，陳郡陽夏人，左光祿大夫湛之庶女也。母本卑賤，后年至六歲方見舉。後適文帝，初拜宜都王妃，生子劭、東陽獻公主英娥。上待后恩禮甚篤，袁氏貧薄，后每就上求錢帛以贍之。上性儉，所得不過五三萬、五三十匹。後潘淑妃有寵，愛傾後宮，咸言所求無不得。后聞之，未知信否，乃因潘求三十萬錢與家，以觀上意，宿昔便得。因此恚恨稱疾，不復見上，遂憤恚成疾。元嘉十七年疾篤，上執手流涕，問所欲言。后視上良久，乃引被覆面，崩于顯陽殿。上甚悼痛之，詔前永嘉太守顏延之為哀策，文甚麗。及奏，上自益「撫存悼亡，感今懷昔。」八字以致意焉。有司奏諡宣皇后，詔諡曰元。初，后生劭，自詳視之，使馳白帝：「此兒形貌異常，必破國亡家，不可舉。」便欲殺之。文帝狼狽至後殿戶外，手掇幔禁之乃止。","note":"按本句指潘淑妃（宋文帝）。","chapter_id":"c-nanshi-011-yuanqigui","book_id":"b-nanshi-011","work_id":"w-nanshi","source_id":"s-nanshi-011-yuanqigui-ws2288359"},{"id":"c-nanshi-012-consorts-editorial:p002:r0097","surface":"潘嫗","start":97,"end":99,"person_id":"8ge_4zd_66p","referent_role":"third_person","paragraph_id":"c-nanshi-012-consorts-editorial:p002","quote":"宋氏因晉之舊典，聘納有方，俔天作儷，必四嶽之後。自元嘉以降，內職稍繁，所選止於軍署，徵引極乎廝皁，非若晉氏采擇，濫及冠冕者焉。而愛止帷房，權無外授，戚屬餼賚，歲時不過肴漿，斯為美矣。及文帝之傾惑潘嫗，謀及婦人；大明之淪沒殷姬，並后匹嫡，其為喪敗，亦已甚矣。","note":"依同段姓名、引者及所答者。","chapter_id":"c-nanshi-012-consorts-editorial","book_id":"b-nanshi-012","work_id":"w-nanshi","source_id":"s-nanshi-012-consorts-editorial-ws2060595"},{"id":"c-songshu-041-yuanqigui:p001:r0112","start":112,"end":114,"surface":"淑妃","person_id":"8ge_4zd_66p","paragraph_id":"c-songshu-041-yuanqigui:p001","referent_role":"third_person","quote":"文帝袁皇后諱齊媯，陳郡陽夏人，左光祿大夫敬公湛之庶女也。母本卑賤，后年五六歲，方見舉。後適太祖，初拜宜都王妃。生子劭、東陽獻公主英娥。上待后恩禮甚篤，袁氏貧薄，后每就上求錢帛以贍與之，上性節儉，所得不過三五萬、三五十匹。後潘淑妃有寵，愛傾後宮，咸言所求無不得，后聞之，欲知信否，乃因潘求三十萬錢與家，以觀上意，信宿便得。因此恚恨甚深，稱疾不復見上。上每入，必他處回避。上數掩伺之，不能得。始興王濬諸庶子問訊，后未嘗視也。后遂憤恚成疾。元嘉十七年，疾篤，上執手流涕問所欲言，后視上良久，乃引被覆面。崩于顯陽殿，時年三十六。上甚相悼痛，詔前永嘉太守顏延之為哀策，文甚麗。其辭曰：","note":"按本句指潘淑妃（宋文帝）。","chapter_id":"c-songshu-041-yuanqigui","book_id":"b-songshu-041","work_id":"w-songshu","source_id":"s-songshu-041-yuanqigui-ws2634831"},{"id":"c-songshu-046-zhao-family-witness:p003:r0034","paragraph_id":"c-songshu-046-zhao-family-witness:p003","start":34,"end":36,"surface":"潘妃","person_id":"8ge_4zd_66p","referent_role":"third_person","quote":"典筆吏取筆不如意，鞭五十。子倩，尚文帝第四女海鹽公主。初，始興王濬以潘妃之寵，故得出入後宮，遂與公主私通。及適倩，倩入宮而怒，肆詈搏擊，引絕帳帶。事上聞，有詔離婚，殺主所生蔣美人，伯符慚懼發病卒。諡曰肅。傳國至孫勗，齊受禪，國除。","note":"依本段敘事、稱謂及語者受者定。","chapter_id":"c-songshu-046-zhao-family-witness","book_id":"b-songshu-046","work_id":"w-songshu","source_id":"s-songshu-046-zhao-family-witness-ws2118581"},{"id":"c-songshu-046-zhaoqian-complete:p001:r0021","paragraph_id":"c-songshu-046-zhaoqian-complete:p001","start":21,"end":23,"surface":"潘妃","person_id":"8ge_4zd_66p","referent_role":"third_person","quote":"子倩，尚文帝第四女海鹽公主。初，始興王濬以潘妃之寵，故得出入後宮，遂與公主私通。及適倩，倩入宮而怒，肆詈搏擊，引絕帳帶。事上聞，有詔離婚，殺主所生蔣美人，","note":"依本段敘事、稱謂及語者受者定。","chapter_id":"c-songshu-046-zhaoqian-complete","book_id":"b-songshu-046","work_id":"w-songshu","source_id":"s-songshu-046-zhaoqian-complete-ws2118581"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-007-dinglingguang:p003","text":"禮，母以子貴。皇儲所生，不容無敬。宋泰豫元年六月，議百官以吏敬敬帝所生陳太妃，則宋明帝在時，百官未有敬。臣竊謂「母以子貴」，義著《春秋》。皇太子副貳宸極，率土咸執吏禮，旣盡禮皇儲，則所生不容無敬。但帝王妃嬪，義與外隔，以理以例，無致敬之道也。今皇太子聖睿在躬，儲禮夙備，子貴之道，抑有舊章。王侯妃主常得通信問者，及六宮三夫人雖與貴嬪同列，並應以敬皇太子之禮敬貴嬪。宋元嘉中，始興、武陵國臣並以吏敬敬所生潘淑妃、路淑媛。貴嬪于宮臣雖非小君，其義不異，與宋泰豫朝議百官以吏敬敬帝所生，事義正同。謂宮閹施敬宜同吏禮，詣神虎門奉牋致謁；年節稱慶，亦同如此。婦人無閫外之事，賀及問訊牋什，所由官報聞而已。夫婦人之道，義無自專，若不仰繫於夫，則當俯繫於子。榮親之道，應極其所榮，未有子所行而所從不足者也。故《春秋》凡王命爲夫人，則禮秩與子等。列國雖異於儲貳，而從尊之義不殊。前代依准，布在舊事。貴嬪載誕元良，克固大業，禮同儲君，實惟舊典。尋前代始置貴嬪，位次皇后，爵無所視；其次職者，位視相國，爵比諸侯王。此貴嬪之禮，已高朝列；況母儀春宮，義絕常算。且儲妃作配，率由盛則；以婦逾姑，彌乖從序。謂貴嬪典章，一與太子不異。","mentions":[{"id":"c-liangshu-007-dinglingguang:p003:m0035","surface":"陳太妃","start":35,"end":38,"person_id":"989_en9_fv0_A","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-liangshu-007-dinglingguang:p003:m0201","surface":"潘淑妃","start":201,"end":204,"person_id":"8ge_4zd_66p","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-liangshu-007-dinglingguang:p003:m0205","surface":"路淑媛","start":205,"end":208,"person_id":"bfe_7hz_jcb","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":1566494,"source_layer":"received_biography","first_line":53,"last_line":53,"line_start":3,"line_end":510,"raw_start":2725,"raw_end":3232,"raw_character_offsets":[2725,2726,2727,2728,2729,2730,2731,2732,2733,2734,2735,2736,2737,2738,2739,2740,2741,2742,2743,2744,2745,2746,2747,2748,2749,2750,2751,2752,2753,2754,2755,2756,2757,2758,2759,2760,2761,2762,2763,2764,2765,2766,2767,2768,2769,2770,2771,2772,2773,2774,2775,2776,2777,2778,2779,2780,2781,2782,2783,2784,2785,2786,2787,2788,2789,2790,2791,2792,2793,2794,2795,2796,2797,2798,2799,2800,2801,2802,2803,2804,2805,2806,2807,2808,2809,2810,2811,2812,2813,2814,2815,2816,2817,2818,2819,2820,2821,2822,2823,2824,2825,2826,2827,2828,2829,2830,2831,2832,2833,2834,2835,2836,2837,2838,2839,2840,2841,2842,2843,2844,2845,2846,2847,2848,2849,2850,2851,2852,2853,2854,2855,2856,2857,2858,2859,2860,2861,2862,2863,2864,2865,2866,2867,2868,2869,2870,2871,2872,2873,2874,2875,2876,2877,2878,2879,2880,2881,2882,2883,2884,28