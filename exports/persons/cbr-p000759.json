{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000759","canonical_person_id":"huq_dao_urx","id_aliases":["cbr-p000759"],"identity_policy":"contextual_provisional","person_ids":["huq_dao_urx"],"persons":[{"id":"huq_dao_urx","label":"東陽甯君","status":"active","historicity":"historical_tradition","aliases":[{"surface":"東陽甯君","mention_ids":["c-shiji-008-gaozu:m011-0227","c-shiji-008-gaozu:m011-0283"]}],"evidence":[{"mention_id":"c-shiji-008-gaozu:m011-0227","chapter_id":"c-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p011","quote":"東陽甯君"},{"mention_id":"c-shiji-008-gaozu:m011-0283","chapter_id":"c-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p011","quote":"東陽甯君"}],"id_aliases":["cbr-p000759"]}],"source_mention_summary":[{"source_id":"s-shiji-008-gaozu","work_id":"w-shiji","book_id":"b-shiji-008","chapter_id":"c-shiji-008-gaozu","mention_count":2,"mention_ids":["c-shiji-008-gaozu:m011-0227","c-shiji-008-gaozu:m011-0283"],"paragraph_ids":["c-shiji-008-gaozu:p011"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-008-gaozu"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-008-gaozu:m011-0227","start":227,"end":231,"surface":"東陽甯君","kind":"person","person_id":"huq_dao_urx","status":"contextual_provisional","paragraph_id":"c-shiji-008-gaozu:p011","chapter_id":"c-shiji-008-gaozu"},{"id":"c-shiji-008-gaozu:m011-0283","start":283,"end":287,"surface":"東陽甯君","kind":"person","person_id":"huq_dao_urx","status":"contextual_provisional","paragraph_id":"c-shiji-008-gaozu:p011","chapter_id":"c-shiji-008-gaozu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-008-gaozu:p011","text":"秦二世二年，陳涉之將周章軍西至戲而還。燕、趙、齊、魏皆自立為王。項氏起吳。秦泗川監平將兵圍豐，二日，出與戰，破之。命雍齒守豐，引兵之薛。泗州守壯敗於薛，走至戚，沛公左司馬得泗川守壯，殺之。沛公還軍亢父，至方與，（周市來攻方與）未戰。陳王使魏人周市略地。周市使人謂雍齒曰：「豐，故梁徙也。今魏地已定者數十城。齒今下魏，魏以齒為侯守豐。不下，且屠豐。」雍齒雅不欲屬沛公，及魏招之，即反為魏守豐。沛公引兵攻豐，不能取。沛公病，還之沛。沛公怨雍齒與豐子弟叛之，聞東陽甯君、秦嘉立景駒為假王，在留，乃往從之，欲請兵以攻豐。是時秦將章邯從陳，別將司馬夷將兵北定楚地，屠相，至碭。東陽甯君、沛公引兵西，與戰蕭西，不利。還收兵聚留，引兵攻碭，三日乃取碭。因收碭兵，得五六千人。攻下邑，拔之。還軍豐。聞項梁在薛，從騎百餘往見之。項梁益沛公卒五千人，五大夫將十人。沛公還，引兵攻豐。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m011-0000","start":0,"end":3,"surface":"秦二世","kind":"person","person_id":"ao3_0fy_d45_AAAA","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m011-0006","start":6,"end":8,"surface":"陳涉","kind":"person","person_id":"pom_ycp_ha5","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m011-0010","start":10,"end":12,"surface":"周章","kind":"person","person_id":"idu_gor_8a1","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m011-0032","start":32,"end":34,"surface":"項氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、匿名者、假稱或同名指代待覆核；不據字串補姓名或實際爵位。"},{"id":"c-shiji-008-gaozu:m011-0037","start":37,"end":42,"surface":"秦泗川監平","kind":"person","person_id":"s0b_5z2_duo","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m011-0058","start":58,"end":60,"surface":"雍齒","kind":"person","person_id":"q2q_a6e_9hs","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m011-0068","start":68,"end":72,"surface":"泗州守壯","kind":"person","person_id":"l6d_hvp_ot3","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m011-0080","start":80,"end":82,"surface":"沛公","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m011-0082","start":82,"e