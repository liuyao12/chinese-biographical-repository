ntions":[{"id":"c-jinshu-070-bianhu:p005:m0166","surface":"謝端","start":166,"end":168,"person_id":"exj_27x_l3u","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-070-bianhu:p005","chapter_id":"c-jinshu-070-bianhu"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-070-bianhu:p005","text":"壼年九歲，爲先母弟表所見孤背。十二，蒙亡母張所見覆育。壼以陋賤，不能榮親，家產屢空，養道多闕，存無歡娛，終不備禮，拊心永恨，五內抽割。於公無效如彼，私情艱苦如此，實無情顏昧冒榮進。若廢壼一人，江北便有傾危之慮，壼居事之日功績以隆者，誠不得私其身。今東中郎岐嶷自然，神明日茂，軍司馬、諸參佐並以明德宣力王事，壼之去留，曾無損益。賀循、謝端、顧景、丁琛、傅晞等皆荷恩命，高枕家門。壼委質二府，漸冉五載，考效則不能已彰，論心則頻累恭順，柰何哀孤之日不見愍恕哉！","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":68,"last_line":68,"raw_start":6206,"raw_end":6442,"raw_character_offsets":[6213,6214,6215,6216,6217,6218,6219,6220,6221,6222,6223,6224,6225,6226,6227,6228,6229,6230,6231,6232,6233,6234,6235,6236,6237,6238,6239,6240,6241,6242,6243,6244,6245,6246,6247,6248,6249,6250,6251,6252,6253,6254,6255,6256,6257,6258,6259,6260,6261,6262,6263,6264,6265,6266,6267,6268,6269,6270,6271,6272,6273,6274,6275,6276,6277,6278,6279,6280,6281,6282,6283,6284,6285,6286,6287,6288,6289,6290,6291,6292,6293,6294,6295,6296,6297,6298,6299,6300,6301,6302,6303,6304,6305,6306,6307,6308,6309,6310,6311,6312,6313,6314,6315,6316,6317,6318,6319,6320,6321,6322,6323,6324,6325,6326,6327,6328,6329,6330,6331,6332,6333,6334,6335,6336,6337,6338,6339,6340,6341,6342,6343,6344,6345,6346,6347,6348,6349,6350,6351,6352,6353,6354,6355,6356,6357,6358,6359,6360,6361,6362,6363,6364,6365,6366,6367,6368,6369,6370,6371,6372,6373,6374,6375,6376,6377,6378,6379,6380,6381,6382,6383,6384,6385,6386,6387,6388,6389,6390,6391,6392,6393,6394,6395,6396,6397,6398,6399,6400,6401,6402,6403,6404,6405,6406,6407,6408,6409,6410,6411,6412,6413,6414,6415,6416,6417,6418,6419,6420,6421,6422,6423,6424,6425,6426,6427,6428,64