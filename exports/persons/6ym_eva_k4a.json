":83,"surface":"王温舒","kind":"person","person_id":"6ym_eva_k4a","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p035","chapter_id":"c-shiji-122-kuli"},{"id":"c-shiji-122-kuli:m036-0000","start":0,"end":2,"surface":"温舒","kind":"person","person_id":"6ym_eva_k4a","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p036","chapter_id":"c-shiji-122-kuli"},{"id":"c-shiji-122-kuli:m037-0001","start":1,"end":3,"surface":"温舒","kind":"person","person_id":"6ym_eva_k4a","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p037","chapter_id":"c-shiji-122-kuli"},{"id":"c-shiji-122-kuli:m037-0032","start":32,"end":34,"surface":"温舒","kind":"person","person_id":"6ym_eva_k4a","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p037","chapter_id":"c-shiji-122-kuli"},{"id":"c-shiji-122-kuli:m038-0104","start":104,"end":107,"surface":"王温舒","kind":"person","person_id":"6ym_eva_k4a","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p038","chapter_id":"c-shiji-122-kuli"},{"id":"c-shiji-122-kuli:m042-0060","start":60,"end":63,"surface":"王温舒","kind":"person","person_id":"6ym_eva_k4a","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p042","chapter_id":"c-shiji-122-kuli"}],"relations":[],"title_holdings":[{"id":"th-shiji122-055","person_id":"6ym_eva_k4a","title":"中尉","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-122-kuli","source_id":"s-shiji122-kuli","paragraph_id":"c-shiji-122-kuli:p028","quote":"是時趙禹、張湯以深刻爲九卿矣，然其治尚寬，輔法而行，而縱以鷹撃毛摯爲治。後會五銖錢白金起，民爲姦，京師尤甚，乃以縱爲右内史，王温舒爲中尉。温舒至惡，其所爲不先言縱，縱必以氣淩之，敗壞其功。其治，所誅殺甚多，然取爲小治，姦益不勝，直指始出矣。吏之治以斬殺縛束爲務，閻奉以惡用矣。縱廉，其治放郅都。上幸鼎湖，病久，已而卒起幸甘泉，道多不治。上怒曰：「縱以我爲不復行此道乎？」嗛之。至冬，楊可方受告緡，縱以爲此亂民，部吏捕其爲可使者。天子聞，使杜式治，以爲廢格沮事，棄縱市。後一歳，張湯亦死。"}],"attestations":[{"id":"th-shiji122-055:a001","paragraph_id":"c-shiji-122-kuli:p028","start":66,"end":68,"surface":"中尉","person_mention_id":"c-shiji-122-kuli:m028-0062","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"依原文區分授任、貶任與用稱；未明日期保持未知，死亡不自動終止官爵。敘事時長不反推公元年。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji122-056","person_id":"6ym_eva_k4a","title":"縣亭長","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-122-kuli","source_id":"s-shiji122-kuli","paragraph_id":"c-shiji-122-kuli:p029","quote":"王温舒者，陽陵人也。少時椎埋爲姦。已而試補縣亭長，數廢。爲吏，以治獄至廷史。事張湯，遷爲御史。督盜賊，殺傷甚多，稍遷至廣平都尉。擇郡中豪敢任吏十餘人，以爲爪牙，皆把其陰重罪，而縱使督盜賊，快其意所欲得。此人雖有百罪，弗法；卽有避，因其事夷之，亦滅宗。以其故齊趙之郊盜賊不敢近廣平，廣平聲爲道不拾遺。上聞，遷爲河内太守。"}],"attestations":[{"id":"th-shiji122-056:a001","paragraph_id":"c-shiji-122-kuli:p029","start":21,"end":24,"surface":"縣亭長","person_mention_id":"c-shiji-122-kuli:m029-0000","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-122-kuli","source_id":"s-shiji122-kuli","paragraph_id":"c-shiji-122-kuli:p029","quote":"王温舒者，陽陵人也。少時椎埋爲姦。已而試補縣亭長，數廢。爲吏，以治獄至廷史。事張湯，遷爲御史。督盜賊，殺傷甚多，稍遷至廣平都尉。擇郡中豪敢任吏十餘人，以爲爪牙，皆把其陰重罪，而縱使督盜賊，快其意所欲得。此人雖有百罪，弗法；卽有避，因其事夷之，亦滅宗。以其故齊趙之郊盜賊不敢近廣平，廣平聲爲道不拾遺。上聞，遷爲河内太守。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"依原文區分授任、貶任與用稱；未明日期保持未知，死亡不自動終止官爵。敘事時長不反推公元年。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji122-057","person_id":"6ym_eva_k4a","title":"廷史","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-122-kuli","source_id":"s-shiji122-kuli","paragraph_id":"c-shiji-122-kuli:p029","quote":"王温舒者，陽陵人也。少時椎埋爲姦。已而試補縣亭長，數廢。爲吏，以治獄至廷史。事張湯，遷爲御史。督盜賊，殺傷甚多，稍遷至廣平都尉。擇郡中豪敢任吏十餘人，以爲爪牙，皆把其陰重罪，而縱使督盜賊，快其意所欲得。此人雖有百罪，弗法；卽有避，因其事夷之，亦滅宗。以其故齊趙之郊盜賊不敢近廣平，廣平聲爲道不拾遺。上聞，遷爲河内太守。"}],"attestations":[{"id":"th-shiji122-057:a001","paragraph_id":"c-shiji-122-kuli:p029","start":35,"end":37,"surface":"廷史","person_mention_id":"c-shiji-122-kuli:m029-0000","u