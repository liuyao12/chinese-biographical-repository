4_9ed","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p007:m0130","start":141,"end":142,"surface":"臣","kind":"person","person_id":"4c6_984_9ed","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p007:m0131","start":159,"end":161,"surface":"陛下","kind":"person","person_id":"7e0_f69_1ac","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p007:m0132","start":165,"end":166,"surface":"臣","kind":"person","person_id":"4c6_984_9ed","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p007:m0133","start":178,"end":180,"surface":"凶人","kind":"unresolved","person_id":null,"status":"unresolved","resolution_note":"群體／匿名／典故或指代仍待專項辨識，不補造單人。"},{"id":"c-jinshu-059-yi:p007:m0134","start":186,"end":188,"surface":"陛下","kind":"person","person_id":"7e0_f69_1ac","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"}],"source_position":{"first_line":142,"last_line":142,"revision_id":2650517},"chapter_id":"c-jinshu-059-yi","book_id":"b-jinshu-059","work_id":"w-jinshu","source_id":"s-jinshu-059-ws2650517-yi"},{"id":"c-jinshu-059-yi:p008","text":"殿中左右恨乂功垂成而敗，謀劫出之，更以距穎。越懼難作，欲遂誅乂。黃門郎潘滔勸越密告張方，方遣部將郅輔勒兵三千，就金墉收乂，至營，炙而殺之。乂冤痛之聲達於左右，三軍莫不為之垂涕。時年二十八。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-059-yi:p008:m0135","start":5,"end":6,"surface":"乂","kind":"person","person_id":"4c6_984_9ed","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p008:m0136","start":20,"end":21,"surface":"穎","kind":"person","person_id":"e81_f09_000","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p008:m0137","start":22,"end":23,"surface":"越","kind":"person","person_id":"9o2_vhv_r7y","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p008:m0138","start":30,"end":31,"surface":"乂","kind":"person","person_id":"4c6_984_9ed","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p008:m0139","start":35,"end":37,"surface":"潘滔","kind":"person","person_id":"yir_cmm_s73","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p008:m0140","start":38,"end":39,"surface":"越","kind":"person","person_id":"9o2_vhv_r7y","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p008:m0141","start":41,"end":43,"surface":"張方","kind":"person","person_id":"eti_fp9_fq5","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p008:m0142","start":44,"end":45,"surface":"方","kind":"person","person_id":"eti_fp9_fq5","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p008:m0143","start":48,"end":50,"surface":"郅輔","kind":"person","person_id":"7pf_yw5_2cs","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p008:m0144","start":59,"end":60,"surface":"乂","kind":"person","person_id":"4c6_984_9ed","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p008:m0145","start":69,"end":70,"surface":"乂","kind":"person","person_id":"4c6_984_9ed","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"}],"source_position":{"first_line":144,"last_line":144,"revision_id":2650517},"chapter_id":"c-jinshu-059-yi","book_id":"b-jinshu-059","work_id":"w-jinshu","source_id":"s-jinshu-059-ws2650517-yi"},{"id":"c-jinshu-059-yi:p009","text":"乂將殯於城東，官屬莫敢往，故掾劉佑獨送之，步持喪車，悲號斷絕，哀感路人。張方以其義士，不之問也。初，乂執權之始，洛下謠曰：「草木萌牙殺長沙。」乂以正月二十五日廢，二十七日死，如謠言焉。永嘉中，懷帝以乂子碩嗣，拜散騎常侍，後沒于劉聰。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-059-yi:p009:m0146","start":0,"end":1,"surface":"乂","kind":"person","person_id":"4c6_984_9ed","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p009:m0147","start":15,"end":17,"surface":"劉佑","kind":"person","person_id":"wcy_ts1_qf8","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p009:m0148","start":36,"end":38,"surface":"張方","kind":"person","person_id":"eti_fp9_fq5","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p009:m0149","start":50,"end":51,"surface":"乂","kind":"person","person_id":"4c6_984_9ed","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p009:m0150","start":67,"end":69,"surface":"長沙","kind":"person","person_id":"4c6_984_9ed","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p009:m0151","start":71,"end":72,"surface":"乂","kind":"person","person_id":"4c6_984_9ed","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p009:m0152","start":96,"end":98,"surface":"懷帝","kind":"person","person_id":"83d_b6e_058","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p009:m0153","start":99,"end":100,"surface":"乂","kind":"person","person_id":"4c6_984_9ed","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p009:m0154","start":101,"end":102,"surface":"碩","kind":"person","person_id":"a2b_qzo_dik","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-yi:p009:m0155","start":113,"end":115,"surface":"劉聰","kind":"person","person_id":"d96_1fa_e9a","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"}],"source_position":{"first_line":146,"last_line":146,"revision_id":2650517},"chapter_id":"c-jinshu-059-yi","book_id":"b-jinshu-059","work_id":"w-jinshu","source_id":"s-jinshu-059-ws2650517-yi"},{"id":"c-jinshu-061-zhou-family:p021","text":"惠帝幸鄴，成都王穎以馥守河南尹。陳眕、上官已等奉清河王覃為太子，加馥衛將軍、錄尚書，馥辭不受。覃令馥與上官已合軍，馥認已小人縱暴，終為國賊，乃共司隸滿奮等謀共除之，謀泄，為已所襲，奮被害，馥走得免。及已為張方所敗，召馥還攝河南尹。暨東海王越迎大駕，以馥為中領軍，未就，遷司隸校尉，加散騎常侍、假節，都督諸軍事于澠池。帝還宮，出為平東將軍、都督揚州諸軍事，代劉准為鎮東將軍，與周玘等討陳敏，滅之，以功封永甯伯。","source_position":{"raw_start":3436,"raw_end":3642,"raw_text":"　　惠帝幸鄴，成都王穎以馥守河南尹。陳眕、上官已等奉清河王覃為太子，加馥衛將軍、錄尚書，馥辭不受。覃令馥與上官已合軍，馥認已小人縱暴，終為國賊，乃共司隸滿奮等謀共除之，謀泄，為已所襲，奮被害，馥走得免。及已為張方所敗，召馥還攝河南尹。暨東海王越迎大駕，以馥為中領軍，未就，遷司隸校尉，加散騎常侍、假節，都督諸軍事于澠池。帝還宮，出為平東將軍、都督揚州諸軍事，代劉准為鎮東將軍，與周玘等討陳敏，滅之，以功封永甯伯。","display_wrapper_start":0,"display_wrapper_end":0,"raw_path":"sources/jinshu/wikisource-7903772-raw.wikitext"},"mentions":[{"id":"c-jinshu-061-zhou-family:p021:m0000","start":0,"end":2,"surface":"惠帝","kind":"person","person_id":"7e0_f69_1ac","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p021:m0005","start":5,"end":9,"surface":"成都王穎","kind":"person","person_id":"e81_f09_000","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p021:m0010","start":10,"end":11,"surface":"馥","kind":"person","person_id":"3xx_gdy_or6_BA","status":"contextual_provisional","interpretation_note":"076王廙元帝鎮江左、討周馥脈絡與本段相合；不是只從單字馥匹配韓馥。"},{"id":"c-jinshu-061-zhou-family:p021:m0016","start":16,"end":18,"surface":"陳眕","kind":"person","person_id":"p1n_kla_0x7","status":"contextual_provisional","interpretation_note":"兩固定數位見證同一清河王太子事件，姓氏相異，原字不改；暫不裁定名姓。"},{"id":"c-jinshu-061-zhou-family:p021:m0019","start":19,"end":22,"surface":"上官已","kind":"person","person_id":"j42_q6m_ymn","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p021:m0024","start":24,"end":28,"surface":"清河王覃","kind":"person","person_id":"2tx_lqb_26u","status":"contextual_provisional","interpretatio