_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-061-zhou-family:p021:m0102","start":102,"end":104,"surface":"張方","kind":"person","person_id":"eti_fp9_fq5","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。","paragraph_id":"c-jinshu-061-zhou-family:p021","chapter_id":"c-jinshu-061-zhou-family"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-061-zhou-family:p021","text":"惠帝幸鄴，成都王穎以馥守河南尹。陳眕、上官已等奉清河王覃為太子，加馥衛將軍、錄尚書，馥辭不受。覃令馥與上官已合軍，馥認已小人縱暴，終為國賊，乃共司隸滿奮等謀共除之，謀泄，為已所襲，奮被害，馥走得免。及已為張方所敗，召馥還攝河南尹。暨東海王越迎大駕，以馥為中領軍，未就，遷司隸校尉，加散騎常侍、假節，都督諸軍事于澠池。帝還宮，出為平東將軍、都督揚州諸軍事，代劉准為鎮東將軍，與周玘等討陳敏，滅之，以功封永甯伯。","source_position":{"raw_start":3436,"raw_end":3642,"raw_text":"　　惠帝幸鄴，成都王穎以馥守河南尹。陳眕、上官已等奉清河王覃為太子，加馥衛將軍、錄尚書，馥辭不受。覃令馥與上官已合軍，馥認已小人縱暴，終為國賊，乃共司隸滿奮等謀共除之，謀泄，為已所襲，奮被害，馥走得免。及已為張方所敗，召馥還攝河南尹。暨東海王越迎大駕，以馥為中領軍，未就，遷司隸校尉，加散騎常侍、假節，都督諸軍事于澠池。帝還宮，出為平東將軍、都督揚州諸軍事，代劉准為鎮東將軍，與周玘等討陳敏，滅之，以功封永甯伯。","display_wrapper_start":0,"display_wrapper_end":0,"raw_path":"sources/jinshu/wikisource-7903772-raw.wikitext"},"mentions":[{"id":"c-jinshu-061-zhou-family:p021:m0000","start":0,"end":2,"surface":"惠帝","kind":"person","person_id":"7e0_f69_1ac","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p021:m0005","start":5,"end":9,"surface":"成都王穎","kind":"person","person_id":"e81_f09_000","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p021:m0010","start":10,"end":11,"surface":"馥","kind":"person","person_id":"3xx_gdy_or6_BA","status":"contextual_provisional","interpretation_note":"076王廙元帝鎮江左、討周馥脈絡與本段相合；不是只從單字馥匹配韓馥。"},{"id":"c-jinshu-061-zhou-family:p021:m0016","start":16,"end":18,"surface":"陳