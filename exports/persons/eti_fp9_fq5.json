ook_id":"b-jinshu-061","chapter_id":"c-jinshu-061-zhou-family","raw_mention_count":1,"mention_ids":["c-jinshu-061-zhou-family:p021:m0102"],"paragraph_ids":["c-jinshu-061-zhou-family:p021"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-061-zhou-family:p021:m0102","mention_ids":["c-jinshu-061-zhou-family:p021:m0102"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-044-luzhi"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-w044-luzhi-zhangfang","person_id":"eti_fp9_fq5","event_type":"death","source_term":"顒斬張方","date_expression":null,"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-044","chapter_id":"c-jinshu-044-luzhi","source_id":"s-jinshu-044-luzhi","paragraph_id":"c-jinshu-044-luzhi:line064","quote":"及東海王越奉迎大駕，顒啟帝復穎還鄴，以志為魏郡太守，加左將軍，隨穎北鎮。行達洛陽，而平昌公模遣前鋒督護馮嵩距穎。穎還長安，未至而聞顒斬張方，求和於越。穎住華陰，志進長安，詣闕陳謝，即還就穎于武關。奔南陽，復為劉陶所驅，回詣河北。及穎薨，官屬奔散，唯志親自殯送，時人嘉之。越命志為軍諮祭酒，遷衛尉，永嘉末，轉尚書。洛陽沒，志將妻子北投并州刺史劉琨。至陽邑，為劉粲所虜，與次子謐、詵等俱遇害於平陽。長子諶。","person_mention_id":"c-jinshu-044-luzhi:line064:m0067"}],"interpretation_note":"依本來源登記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":