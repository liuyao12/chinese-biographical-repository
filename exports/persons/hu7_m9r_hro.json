12916],"projection_sha256":"de12257ca9be53c88baac3c10b3f40dfaf13b25c1f9d2d1af6939cc134bb78bc","editorial_excerpt_boundary":true},"chapter_id":"c-nanshi-023-wangmai","book_id":"b-nanshi-023","work_id":"w-nanshi","source_id":"s-nanshi-023-wangmai-ws2478204"},{"id":"c-nanshi-023-wangzhi-zizhen:p003","text":"魏平荊州，侯瑱鎮盆城，與質不協，質率所部依於留異。陳永定二年，武帝命質率所部隨都督周文育討王琳。質與琳素善，或譖雲於軍中潛信交通，武帝命文育殺質，文育啟救之，獲免。文帝嗣位，以為五兵尚書。宣帝輔政，為司徒左長史。坐招聚博徒，免官。後為都官尚書。卒，諡曰安子。弟固。","mentions":[{"id":"c-nanshi-023-wangzhi-zizhen:p003:m0005","surface":"侯瑱","start":5,"end":7,"person_id":"8fx_ugl_pnj_A","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangzhi-zizhen:p003:m0012","surface":"質","start":12,"end":13,"person_id":"q7m_r8k_2vn_ABAD","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangzhi-zizhen:p003:m0016","surface":"質","start":16,"end":17,"person_id":"q7m_r8k_2vn_ABAD","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangzhi-zizhen:p003:m0022","surface":"留異","start":22,"end":24,"person_id":"ops_dvl_l64","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangzhi-zizhen:p003:m0034","surface":"質","start":34,"end":35,"person_id":"q7m_r8k_2vn_ABAD","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangzhi-zizhen:p003:m0041","surface":"周文育","start":41,"end":44,"person_id":"cea_x1n_2b8","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangzhi-zizhen:p003:m0045","surface":"王琳","start":45,"end":47,"person_id":"hu7_m9r_hro","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangzhi-zizhen:p003:m0048","surface":"質","start":48,"end":49,"person_id":"q7m_r8k_2vn_ABAD","kind":"person","status":"contextual_provisional","interpretation_note":