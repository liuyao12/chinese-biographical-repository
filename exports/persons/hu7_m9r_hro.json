之。天嘉二年還朝，復爲侍中。卒，諡曰貞子。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"start":0,"end":1,"surface":"瑒","id":"c-nanshi-021-wangyu:p001:m0000","person_id":"7r6_k52_qji_ABAAAAAABAAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作瑒。"},{"start":2,"end":3,"surface":"瑜","id":"c-nanshi-021-wangyu:p001:m0002","person_id":"7r6_k52_qji_ABAAAAAABAAB","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作瑜。"},{"start":4,"end":6,"surface":"子珪","id":"c-nanshi-021-wangyu:p001:m0004","person_id":"7r6_k52_qji_ABAAAAAABAAB","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作瑜。"},{"start":34,"end":36,"surface":"袁憲","id":"c-nanshi-021-wangyu:p001:m0034","person_id":"6qj_3sw_6fo","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作憲。"},{"start":41,"end":43,"surface":"王琳","id":"c-nanshi-021-wangyu:p001:m0041","person_id":"hu7_m9r_hro","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作琳。"},{"start":77,"end":78,"surface":"瑜","id":"c-nanshi-021-wangyu:p001:m0077","person_id":"7r6_k52_qji_ABAAAAAABAAB","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作瑜。"},{"start":79,"end":80,"surface":"憲","id":"c-nanshi-021-wangyu:p001:m0079","person_id":"6qj_3sw_6fo","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作憲。"},{"start":90,"end":93,"surface":"楊遵彥","id":"c-nanshi-021-wangyu:p001:m0090","person_id":"fum_370_iq6_AAAED","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作楊。"}],"source_position":{"revision_id":1752646,"source_layer":"received_biography","raw_start":7421,"raw_end":7538,"raw_character_offsets":[7421,7422,7423,7424,7425,7426,7427,7428,7429,7430,7431,7432,7433,7434,7435,7436,7437,7438,7439,7440,7441,7442,7443,7444,7445,7446,7447,7448,7449,7450,7451,7452,7453,7454,7455,7456,7457,7458,7459,746