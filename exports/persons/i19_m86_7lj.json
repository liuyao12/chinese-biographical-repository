fault":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-062-huzong:line032:m0286","start":286,"end":288,"surface":"黃定","kind":"person","person_id":"i19_m86_7lj","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-062-huzong:line032","chapter_id":"c-sanguozhi-062-huzong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-062-huzong:line032","text":"　　其一曰：“天綱弛絕，四海分崩，群生憔悴，士人播越，兵寇所加，邑無居民，風塵煙火，往往而處。自三代以來，大亂之極，未有若今時者也。臣質志薄，處時無方，繫於土壤，不能翻飛，遂為曹氏執事戎役。遠處河朔，天衢隔絕，雖望風慕義，思托大命，愧無因緣，得展其志。每往來者，竊聽風化，伏知陛下齊德乾坤，同明日月，神武之姿，受之自然。敷演皇極，流化萬里，自江以南，戶受覆燾。英雄俊傑，上達之士，莫不心歌腹詠，樂在歸附者也。今年六月末，奉聞吉日，龍興踐阼，恢弘大繇，整理天綱，將使遺民，睹見定主。營武王伐殷，殷氏倒戈；高祖誅項，四面楚歌。方之今日，未足以喻。臣質不勝吳天至願，謹遣所親同郡黃定恭行奉表，及托降叛，間關求達，其欲所陳，載列於左。”","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-062-huzong:line032:m0067","start":67,"end":68,"surface":"質","kind":"person","person_id":"354_b66_61e","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-062-huzong:line032:m0241","start":241,"end":243,"surface":"武王","kind":"person","person_id":"y4i_pjk_4gn_AA","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-062-huzong:line032:m0251","start":251,"end":253,"surface":"高祖","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-062-huzong:line032:m0254","start":254,"end":255,"surface":"項","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-062-huzong:line032:m0272","start":272,"end":273,"surface":"質","kind":"person","person_id":"354_b66_61e",