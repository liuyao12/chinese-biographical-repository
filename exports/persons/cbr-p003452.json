tatus":"contextual_provisional"},{"id":"c-shiji-056-chen:m016-0003","start":3,"end":5,"surface":"高帝","kind":"person","person_id":"cbr-p003428","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m016-0007","start":7,"end":8,"surface":"平","kind":"person","person_id":"cbr-p003418","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m016-0009","start":9,"end":12,"surface":"呂太后","kind":"person","person_id":"cbr-p003451","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m016-0013","start":13,"end":15,"surface":"呂嬃","kind":"person","person_id":"cbr-p003452","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m016-0025","start":25,"end":27,"surface":"使者","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、泛稱官職、氏族或代詞待覆核，不補姓名或未見家屬。"},{"id":"c-shiji-056-chen:m016-0028","start":28,"end":29,"surface":"平","kind":"person","person_id":"cbr-p003418","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m016-0030","start":30,"end":32,"surface":"灌嬰","kind":"person","person_id":"cbr-p003435","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m016-0037","start":37,"end":38,"surface":"平","kind":"person","person_id":"cbr-p003418","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m016-0057","start":57,"end":60,"surface":"呂太后","kind":"person","person_id":"cbr-p003451","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m016-0074","start":74,"end":75,"surface":"平","kind":"person","person_id":"cbr-p003418","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m016-0088","start":88,"end":90,"surface":"太后","kind":"person","person_id":"cbr-p003451","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m016-0102","start":102,"end":104,"surface":"孝惠","kind":"person","person_id":"cbr-p003453","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m016-0108","start":108,"end":110,"surface":"呂嬃","kind":"person","person_id":"cbr-p003452","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m016-0116","start":116,"end":118,"surface":"樊噲","kind":"person","person_id":"cbr-p003450","status":"contextual_provisional"}],"chapter_id":"c-shiji-056-chen","book_id":"b-shiji-056","work_id":"w-shiji","source_id":"s-shiji-056-chen"},{"id":"c-shiji-056-chen:p022","text":"呂嬃常以前陳平爲高帝謀執樊噲，數讒曰：「陳平爲相非治事，日飲醇酒，戲婦女。」陳平聞，日益甚。呂太后聞之，私獨喜。面質呂嬃於陳平曰：「鄙語曰『兒婦人口不可用』，顧君與我何如耳。無畏呂嬃之讒也。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-056-chen:m022-0000","start":0,"end":2,"surface":"呂嬃","kind":"person","person_id":"cbr-p003452","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m022-0005","start":5,"end":7,"surface":"陳平","kind":"person","person_id":"cbr-p003418","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m022-0008","start":8,"end":10,"surface":"高帝","kind":"person","person_id":"cbr-p003428","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m022-0012","start":12,"end":14,"surface":"樊噲","kind":"person","person_id":"cbr-p003450","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m022-0020","start":20,"end":22,"surface":"陳平","kind":"person","person_id":"cbr-p003418","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m022-0034","start":34,"end":36,"surface":"婦女","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、泛稱官職、氏族或代詞待覆核，不補姓名或未見家屬。"},{"id":"c-shiji-056-chen:m022-0038","start":38,"end":40,"surface":"陳平","kind":"person","person_id":"cbr-p003418","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m022-0046","start":46,"end":49,"surface":"呂太后","kind":"person","person_id":"cbr-p003451","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m022-0058","start":58,"end":60,"surface":"呂嬃","kind":"person","person_id":"cbr-p003452","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m022-0061","start":61,"end":63,"surface":"陳平","kind":"person","person_id":"cbr-p003418","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m022-0089","start":89,"end":91,"sur