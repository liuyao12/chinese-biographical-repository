traints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-043-wangrong:p011","text":"戎以晉室方亂，慕蘧伯玉之為人，與時舒卷，無蹇諤之節。自經典選，未嘗進寒素，退虛名，但與時浮沈，戶調門選而已。尋拜司徒，雖位總鼎司，而委事僚采。間乘小馬，從便門而出遊，見者不知其三公也。故吏多至大官，道路相遇輒避之。性好興利，廣收八方園田水碓，周遍天下。積實聚錢，不知紀極，每自執牙籌，晝夜算計，恆若不足。而又儉嗇，不自奉養，天下人謂之膏肓之疾。女適裴頠，貸錢數萬，久而未還。女後歸寧，戎色不悅，女遽還直，然後乃歡。從子將婚，戎遺其一單衣，婚訖而更責取。家有好李，常出貨之，恐人得種，恆鑽其核。以此獲譏於世。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-043-wangrong:p011:m0000","start":0,"end":1,"surface":"戎","kind":"person","person_id":"48e_04a_3d8","status":"contextual_provisional","resolution_note":"女適裴頠與歸寧同一女；從子單衣婚事不補其父/姓名。"},{"id":"c-jinshu-043-wangrong:p011:m0008","start":8,"end":11,"surface":"蘧伯玉","kind":"person","person_id":"nd8_vw5_w1w","status":"contextual_provisional","resolution_note":"女適裴頠與歸寧同一女；從子單衣婚事不補其父/姓名。"},{"id":"c-jinshu-043-wangrong:p011:m0088","start":88,"end":90,"surface":"三公","kind":"person","person_id":"48e_04a_3d8","status":"contextual_provisional","resolution_note":"乘小馬出遊者戎。"},{"id":"c-jinshu-043-wangrong:p011:m0172","start":172,"end":173,"surface":"女","kind":"person","person_id":"cxf_421_onp","status":"contextual_provisional","resolution_note":"女適裴頠與歸寧同一女；從子單衣婚事不補其父/姓名。"},{"id":"c-jinshu-043-wangrong:p011:m0174","start":174,"end":176,"surface":"裴頠","kind":"person","person_id":"svm_6fh_34r","status":"contextual_provisional","resolution_note":"女適裴頠與歸寧同一女；從子單衣婚事不補其父/姓名。"},{"id":"c-jinshu-043-wangrong:p011:m0187","start":187,"end":188,"surface":"女","kind":"person","person_id":"cxf_421_onp","status":"contextual_provisional","resolution_note":"女適裴頠與歸寧同一女；從子單衣婚事不補其父/姓名。"},{"id":"c-jinshu-043-wangrong:p011:m0192","start":192,"end":193,"surface":"戎","kind":"person","person_id":"48e_04a_3d8","status":"contextual_provisional","resolution_note":"女適裴頠與歸寧同一女；從子單衣婚事不補其父/姓名。"},{"id":"c-jinshu-043-wangrong:p011:m0197","start":197,"end":198,"surface":"女","kind":"person","person_id":"cxf_421_onp"