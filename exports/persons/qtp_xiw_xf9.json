ine013:m0172","mention_ids":["c-sanguozhi-060-heqi:line013:m0172"],"kind":"paragraph"}],"mention_count":3,"duplicate_mention_count":0,"paragraph_occurrence_count":3,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"3處獨立位置，3個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-sanguozhi-060-heqi"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-wu060-heqi1","person_id":"qtp_xiw_xf9","event_type":"death","source_term":"齊乃斬蕃","date_expression":null,"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-060","chapter_id":"c-sanguozhi-060-heqi","source_id":"s-sanguozhi-060-heqi","paragraph_id":"c-sanguozhi-060-heqi:line013","quote":"　　侯官既平。而建安、漢興、南平復亂，齊進兵建安，立都尉府，是歲八年也。郡發屬縣五千兵，各使本縣長將之，皆受齊節度。賊洪明、洪進、苑御、吳免、華當等五人，率各萬戶，連屯漢興，吳五六千戶別屯大潭。鄒臨六千戶別屯蓋竹，大潭同出餘汗。軍討漢興，經餘汗。齊以為賊眾兵少，深入無繼，恐為所斷，令松陽長丁蕃留備余汗。蕃本與齊鄰城，恥見部伍，辭不肯留。齊乃斬蕃，於是軍中震慄。無不用命。遂分兵留備，進討明等，連大破之。臨陳斬明，其免、當、進、御皆降。轉擊蓋竹，軍向大潭，三將又降。凡討治斬首六千級，名帥盡擒。復立縣邑，料出兵萬人，拜為平東校尉。十年，轉討上饒，分以為建平縣。","person_mention_id":"c-sanguozhi-060-heqi:line013:m0145"}],"interpretation_note":"本來源所記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-sanguozhi-060-heqi:line013:m0145","start":145,"end":147,"surface":"丁蕃","kind":"person","person_id":"qtp_xiw_xf9","status":"contextual_provisional","interpretation_not