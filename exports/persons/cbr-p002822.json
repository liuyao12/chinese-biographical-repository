{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p002822","identity_policy":"contextual_provisional","person_ids":["cbr-p002822"],"persons":[{"id":"cbr-p002822","label":"子（田世家髙唐守者讀法未定）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"子","mention_ids":["c-shiji-046-tian:m030-0143"]}],"evidence":[{"mention_id":"c-shiji-046-tian:m030-0143","chapter_id":"c-shiji-046-tian","paragraph_id":"c-shiji-046-tian:p030","quote":"子"}]}],"mentions":[{"id":"c-shiji-046-tian:m030-0143","start":143,"end":144,"surface":"子","kind":"person","person_id":"cbr-p002822","status":"contextual_provisional","paragraph_id":"c-shiji-046-tian:p030","chapter_id":"c-shiji-046-tian"}],"relations":[],"title_holdings":[{"id":"th-shiji046-023","person_id":"cbr-p002822","title":"守髙唐","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-046-tian","source_id":"s-shiji-046-tian","paragraph_id":"c-shiji-046-tian:p030","quote":"威王二十三年，與趙王會平陸。二十四年，與魏王會田於郊。魏王問曰：「王亦有寶乎？」威王曰：「無有。」梁王曰：「若寡人國小也，尚有徑寸之珠照車前後各十二乘者十枚，奈何以萬乘之國而無寶乎？」威王曰：「寡人之所以爲寶與王異。吾臣有檀子者，使守南城，則楚人不敢爲寇東取，泗上十二諸侯皆來朝。吾臣有子者，使守髙唐，則趙人不敢東漁於河。吾吏有黔夫者，使守徐州，則燕人祭北門，趙人祭西門，徙而從者七千餘家。吾臣有種首者，使備盜賊，則道不拾遺。將以照千里，豈特十二乘哉！」梁惠王慚，不懌而去。"}],"attestations":[{"id":"th-shiji046-023:a001","paragraph_id":"c-shiji-046-tian:p030","start":147,"end":150,"surface":"守髙唐","person_mention_id":"c-shiji-046-tian:m030-0143","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予、任事與文獻用稱分存；欲使為卿且辭未當已任，諡稱不當生前任職，死亡或首次用稱不補任期。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji046-116","person_id":"cbr-p002822","scope":"same_chapter","chapter_ids":["c-shiji-046-tian"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["子"],"evidence":[{"paragraph_id":"c-shiji-046