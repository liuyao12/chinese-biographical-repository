{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"ed1_i53_e38","canonical_person_id":"ed1_i53_e38","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["ed1_i53_e38"],"persons":[{"id":"ed1_i53_e38","label":"劉徵〔浮海抄東南〕","status":"active","historicity":"historical_tradition","aliases":[{"surface":"劉徵","mention_ids":["c-jinshu-067-xijian:line084:m0003"]}],"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-067","chapter_id":"c-jinshu-067-xijian","source_id":"s-jinshu-067-xijian","paragraph_id":"c-jinshu-067-xijian:line084","mention_id":"c-jinshu-067-xijian:line084:m0003","quote":"劉徵"}],"identity_note":"郗鑒傳賊帥，成帝紀亦記海賊劉徵。","review":"ai_provisional"}],"source_mention_summary":[{"source_id":"s-jinshu-067-xijian","work_id":"w-jinshu","book_id":"b-jinshu-067","chapter_id":"c-jinshu-067-xijian","raw_mention_count":1,"mention_ids":["c-jinshu-067-xijian:line084:m0003"],"paragraph_ids":["c-jinshu-067-xijian:line084"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-067-xijian:line084:m0003","mention_ids":["c-jinshu-067-xijian:line084:m0003"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-067-xijian"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-067-xijian:line084:m0003","start":3,"end":5,"surface":"劉徵","kind":"person","person_id":"ed1_i53_e38","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-067-xijian:line084","chapter_id":"c-jinshu-067-xijian"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-067-xijian:line084","text":"時賊帥劉徵聚眾數千，浮海抄東南諸縣。鑒遂城京口，加都督揚州之晉陵吳郡諸軍事，率眾討平之。進位太尉。後以寢疾，上疏遜位曰：「臣疾彌留，遂至沈篤，自忖氣力，差理難冀。有生有死，自然之分。但忝位過才，會無以報，上慙先帝，下愧日月。伏枕哀歎，抱恨黃泉。臣今虛乏，救命朝夕，輒以府事付長史劉遐，乞骸骨歸丘園。惟願陛下崇山海之量，弘濟大猷，任賢使能，事從簡易，使康哉之歌復興於今，則臣雖死，猶生之日耳。臣所統錯雜，率多北人，或逼遷徙，或是新附，百姓懷土，皆有歸本之心。臣宣國恩，示以好惡，處與田宅，漸得少安。聞臣疾篤，眾情駭動，若當北渡，必啟寇心。太常臣謨，平簡貞正，素望所歸，謂可以為都督、徐州刺史。臣亡兄息晉陵內史邁，謙愛養士，甚為流亡所宗，又是臣門戶子弟，堪任兗州刺史。公家之事，知無不為，是以敢希祁奚之舉。」疏奏，以蔡謨為鑒軍司。鑒尋薨，時年七十一。帝朝晡哭于朝堂，遣御史持節護喪事，贈一依溫嶠故事。冊曰：「惟公道德沖邃，體識弘遠，忠亮雅正，行為世表，歷位內外，勳庸彌著。乃者約峻狂狡，毒流朝廷，社稷之危，賴公以寧。功侔古烈，勳邁桓文。方倚大猷，藩翼時難，昊天不弔，奄忽薨殂，朕用震悼于厥心。夫爵以顯德，諡以表行，所以崇明軌迹，丕揚徽劭。今贈太宰，諡曰文成，祠以太牢。魂而有靈，嘉茲寵榮。」","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-067-xijian:line084:m0003","start":3,"end":5,"surface":"劉徵","kind":"person","person_id":"ed1_i53_e38","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-xijian:line084:m0018","start":18,"end":19,"surface":"鑒","kind":"person","person_id":"6lr_zci_i0j","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-xijian:line084:m0139","start":139,"end":141,"surface":"劉遐","kind":"person","person_id":"q1u_ata_ox5","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-xijian:line084:m0271","start":271,"end":272,"surface":"謨","kind":"person","person_id":"b98_957_r7h","status":"contextual_provisional","interpretation_not