tity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji116-001","subject_person_id":"b1y_l5y_xmz","predicate":"ancestor","object_person_id":"pd6_bus_9va","status":"source_attested","evidence":[{"chapter_id":"c-shiji-116-xinanyi","source_id":"s-shiji116-xinanyi","paragraph_id":"c-shiji-116-xinanyi:p002","quote":"始楚威王時，使將軍莊蹻將兵循江上，略巴、黔中以西。莊蹻者，故楚莊王苗裔也。蹻至滇池，地方三百里，旁平地，肥饒數千里，以兵威定屬楚。欲歸報，會秦擊奪楚巴、黔中郡，道塞不通，因還，以其眾王滇，變服，從其俗，以長之。秦時常頞略通五尺道，諸此國頗置吏焉。十餘歲，秦滅。及漢興，皆棄此國而開蜀故徼。巴蜀民或竊出商賈，取其筰馬、僰僮、髦牛，以此巴蜀殷富。"}],"qualifiers":{"source_term":"故楚莊王苗裔也"},"interpretation_note":"苗裔為遠祖陳述，世代未知，不作直接父親或預接整條父系。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-116-xinanyi:m002-0009","start":9,"end":11,"surface":"莊蹻","kind":"person","person_id":"b1y_l5y_xmz","status":"contextual_provisional","paragraph_id":"c-shiji-116-xinanyi:p002","chapter_id":"c-shiji-116-xinanyi"},{"id":"c-shiji-116-xinanyi:m002-0025","start":25,"end":27,"surface":"莊蹻","kind":"person","person_id":"b1y_l5y_xmz","status":"contextual_provisional","paragraph_id":"c-shiji-116-xinanyi:p002","chapter_id":"c-shiji-116-xinanyi"},{"id":"c-shiji-116-xinanyi:m002-0037","start":37,"end":38,"surface":"蹻","kind":"person","person_id":"b1y_l5y_xmz","status":"contextual_provisional","paragraph_id":"c-shiji-116-xinanyi:p002","chapter_id":"c-shiji-116-xinanyi"},{"id":"c-shiji-116-xinanyi:m012-0005","start":5,"end":7,"surface":"莊蹻","kind":"person","person_id":"b1y_l5y_xmz","status":"contextual_provisional","paragraph_id":"c-shiji-116-xinanyi:p012","chapter_id":"c-shiji-116-xinanyi"}],"relations":[{"id":"a-shiji116-001","subject_person_id":"b1y_l5y_xmz","predicate":"ancestor","object_person_id":"pd6_bus_9va","status":"sour