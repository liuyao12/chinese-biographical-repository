fault":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-053-xuezong:line045:m0348","start":348,"end":350,"surface":"虞褒","kind":"person","person_id":"4ip_uus_vok","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-053-xuezong:line045","chapter_id":"c-sanguozhi-053-xuezong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-053-xuezong:line045","text":"交阯糜泠、九真都龐二縣，皆兄死弟妻其嫂，世以此為俗，長吏恣聽，不能禁制。日郡男女夥體，不以為羞。由此言之，可謂蟲豸，有靦面目耳。然而土廣人眾，阻險毒害，易以為亂，難使從治。縣官羈縻，示令威服，田戶之租賦，裁取供辦，貴致遠珍名珠、香藥、象牙、犀角、玳瑁、珊瑚、琉璃、鸚鵡、翡翠、孔雀、奇物，充備寶玩，不必仰其賦入，以益中國也。然在九甸之外，長吏之選，類不精核。漢時法寬，多自放恣，故數反違法。珠崖之廢，起於長吏睹其好發，髡取為髲。及臣所見，南海黃蓋為日南太守，下車以供設不豐，撾殺主薄，仍見驅逐。九真太守儋萌為妻父周京作主人，並請大吏，酒酣作樂。功曹番歆起舞屬京，京不肯起，歆猶迫強，萌忿杖歆，亡於郡內。歆弟苗帥眾攻府，毒矢射萌，萌至物故。交阯太守士燮遣兵致討，卒不能克。又故刺史會稽朱符，多以鄉人虞褒、劉彥之徒分作長吏，侵虐百姓，強賦於民黃魚一枚收稻一斛，百姓怨叛，山賊並出，攻州突郡。符走入海，流離喪亡。次得南陽張津，與荊州牧劉表為隙，兵弱敵強，歲歲興軍，諸將厭患，去留自在。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-053-xuezong:line045:m0221","start":221,"end":223,"surface":"黃蓋","kind":"person","person_id":"no2_m87_78v","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xuezong:line045:m0251","start":251,"end":253,"surface":"儋萌","kind":"person","person_id":"dbc_qjy_48j","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xuezong:line045:m0256","start":256,"end":258,"surface":"周京","kind":"person","person_id":"b44_x3s_5oz","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xuezong:line045:m0274","start":274,"end":276,"surface":"番歆","kind":"person","person_id":"4p1_22p_iib","status":"contextual_provisional","interpretation_note":"依本段姓名與