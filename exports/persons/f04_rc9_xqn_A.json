r","mentions":[{"id":"c-shiji-046-tian:m049-0000","start":0,"end":2,"surface":"襄王","kind":"person","person_id":"zan_qcc_jy5_AAAAAABAAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m049-0006","start":6,"end":10,"surface":"太史氏女","kind":"person","person_id":"f04_rc9_xqn_A","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m049-0016","start":16,"end":19,"surface":"君王后","kind":"person","person_id":"f04_rc9_xqn_A","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m049-0022","start":22,"end":23,"surface":"建","kind":"person","person_id":"zan_qcc_jy5_AAAAAABAAAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m049-0024","start":24,"end":27,"surface":"太史敫","kind":"person","person_id":"f04_rc9_xqn","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m049-0052","start":52,"end":55,"surface":"君王后","kind":"person","person_id":"f04_rc9_xqn_A","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m049-0056","start":56,"end":59,"surface":"君王后","kind":"person","person_id":"f04_rc9_xqn_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-046-tian","book_id":"b-shiji-046","work_id":"w-shiji","source_id":"s-shiji-046-tian"},{"id":"c-shiji-046-tian:p053","text":"十六年，秦滅周。君王后卒。二十三年，秦置東郡。二十八年，王入朝秦，秦王政置酒咸陽。三十五年，秦滅韓。三十七年，秦滅趙。三十八年，燕使荊軻刺秦王，秦王覺，殺軻。明年，秦破燕，燕王亡走遼東。明年，秦滅魏，秦兵次於歴下。四十二年，秦滅楚。明年，虜代王嘉，滅燕王喜。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-046-tian:m053-0008","start":8,"end":11,"surface":"君王后","kind":"person","person_id":"f04_rc9_xqn_A","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m053-0028","start":28,"end":29,"surface":"王","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、對話、稱謂或索隱述贊短稱待核，不補姓名及成員。"},{"id":"c-shiji-046-tian:m053-0033","start":33,"end":36,"surface":"秦王政","kind":"person","person_id":"dxz_9j5_10h","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m053-0066","start":66,"end":68,"surface":"荊軻","kind":"person","person_id":"44u_z5w_09n","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m053-0069","start":69,"end":71,"surface":"秦王","kind":"person","person_id":"dxz_9j5_10h","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m053-0072","start":72,"end":74,"surface":"秦王","kind":"person","person_id":"dxz_9j5_10h","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m053-0077","start":77,"end":78,"surface":"軻","kind":"person","person_id":"44u_z5w_09n","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m053-0086","start":86,"end":88,"surface":"燕王","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、對話、稱謂或索隱述贊短稱待核，不補姓名及成員。"},{"id":"c-shiji-046-tian:m053-0120","start":120,"end":123,"surface":"代王嘉","kind":"person","person_id":"wjp_1iw_3qf","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m053-0125","start":125,"end":128,"surface":"燕王喜","kind":"person","person_id":"foo_tch_2bb","status":"contextual_provisional"}],"chapter_id":"c-shiji-046-tian","book_id":"b-shiji-046","work_id":"w-shiji","source_id":"s-shiji-046-tian"},{"id":"c-shiji-046-tian:p054","text":"四十四年，秦兵撃齊。齊王聽相后勝計，不戰，以兵降秦。秦虜王建，遷之共。遂滅齊爲郡。天下壹并於秦，秦王政立號爲皇帝。始，君王后賢，事秦謹，與諸侯信，齊亦東邊海上，秦日夜攻三晉、燕、楚，五國各自救於秦，以故王建立四十餘年不受兵。君王后死，后勝相齊，多受秦閒金，多使賓客入秦，秦又多予金，客皆爲反閒，勸王去從朝秦，不修攻戰之備，不助五國攻秦，秦以故得滅五國。五國已亡，秦兵卒入臨淄，民莫敢格者。王建遂降，遷於共。故齊人怨王建不蚤與諸侯合從攻秦，聽姦臣賓客以亡其國，歌之曰：「松耶柏耶？住建共者客耶？」疾建用客之不詳也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-046-tian:m054-0010","start":10,"end":12,"surface":"齊王","kind":"person","person_id":"zan_qcc_jy5_AAAAAABAAAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m054-0014","start":14,"end":16,"surface":"后勝","kind":"person","person_id":"9oc_37g_jlc","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m054-0028","start":28,"end":30,"surface":"王建","kind":"person","person_id":"zan_qcc_jy5_AAAAAABAAAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m054-0048","start":48,"end":51,"surface":"秦王政","kind":"person","person_id":"dxz_9j5_10h","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m054-0059","start":59,"end":62,"surface":"君王后","kind":"person","person_id":"f04_rc9_xqn_A","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m054-0101","start":101,"end":103,"surface":"王建","kind":"person","person_id":"zan_qcc_jy5_AAAAAABAAAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m054-0112","start":112,"end":115,"surface":"君王后","kind":"person","person_id":"f04_rc9_xqn_A","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m054-0117","start":117,"end":119,"surface":"后勝","kind":"person","person_id":"9oc_37g_jlc","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m054-0130","start":130,"end":132,"surface":"賓客","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、對話、稱謂或索隱述贊短稱待核，不補姓名及成員。"},{"id":"c-shiji-046-tian:m054-0194","start":194,"end":196,"surface":"王建","kind":"person","person_id":"zan_qcc_jy5_AAAAAABAAAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m054-0207","start":207,"end":209,"surface":"王建","kind":"person","person_id":"zan_qcc_jy5_AAAAAABAAAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m054-0222","start":222,"end":224,"surface":"賓客","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、對話、稱謂或索隱述贊短稱待核，不補姓名及成員。"},{"id":"c-shiji-046-tian:m054-0240","start":240,"end":241,"surface":"建","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、對話、稱謂或索隱述贊短稱待核，不補姓名及成員。"},{"id":"c-shiji-046-tian:m054-0248","start":248,"end":249,"surface":"建","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、對話、稱謂或索隱述贊短稱待核，不補姓名及成員。"}],"chapter_id":"c-shiji-046-tian","book_id":"b-shiji-046","work_id":"w-shiji","source_id":"s-shiji-046-tian"},{"id":"c-shiji-082-tiandan:p008","text":"初，淖齒之殺湣王也，莒人求湣王子法章，得之太史嬓之家，為人灌園。嬓女憐而善遇之。後法章私以情告女，女遂與通。及莒人共立法章為齊王，以莒距燕，而太史氏女遂為后，所謂「君王后」也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-082-tiandan:m008-0002","start":2,"end":4,"surface":"淖齒","kind":"person","person_id":"4w3_yw4_lcm","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m008-0006","start":6,"end":8,"surface":"湣王","kind":"person","person_id":"pyc_fs9_nif","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m008-0013","start":13,"end":15,"surface":"湣王","kind":"person","person_id":"pyc_fs9_nif","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m008-0016","start":16,"end":18,"surface":"法章","kind":"person","person_id":"pyc_fs9_nif_A","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m008-0021","start":21,"end":24,"surface":"太史嬓","kind":"person","person_id":"y5g_spw_43b","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m008-0032","start":32,"end":34,"surface":"嬓女","kind":"person","person_id":"y5g_spw_43b_A","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m008-0041","start":41,"end":43,"surface":"法章","kind":"person","person_id":"pyc_fs9_nif_A","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m008-0047","start":47,"end":48,"surface":"女","kind":"person","person_id":"y5g_spw_43b_A","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m008-0049","start":49,"end":50,"surface":"女","kind":"person","person_id":"y5g_spw_43b_A","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m008-0059","start":59,"end":61,"surface":"法章","kind":"person","person_id":"pyc_fs9_nif_A","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m008-0062","start":62,"end":64,"surface":"齊王","kind":"person","person_id":"pyc_fs9_nif_A","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m008-0071","start":71,"end":75,"surface":"太史氏女","kind":"person","person_id":"y5g_spw_43b_A","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m008-0082","start":82,"end":85,"surface":"君王后","kind":"person","person_id":"y5g_spw_43b_A","status":"contextua