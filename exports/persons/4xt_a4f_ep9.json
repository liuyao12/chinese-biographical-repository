al_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-060-zhonglimu:line093:m0074","surface":"縣長","start":74,"end":76,"kind":"person","person_id":"4xt_a4f_ep9","status":"contextual_provisional","interpretation_note":"按本段具名及前後親稱、官職定位。","paragraph_id":"c-sanguozhi-060-zhonglimu:line093","chapter_id":"c-sanguozhi-060-zhonglimu"}],"relations":[],"title_holdings":[],"address_assertions":[],"person_references":[{"id":"c-sanguozhi-060-zhonglimu:line093:r0108","paragraph_id":"c-sanguozhi-060-zhonglimu:line093","start":108,"end":109,"surface":"僕","person_id":"4xt_a4f_ep9","referent_role":"speaker_self","quote":"宮，自行義事，僕為民主，當以法","note":"依對話說話者、受書者及上下句定位。","chapter_id":"c-sanguozhi-060-zhonglimu","book_id":"b-sanguozhi-060","work_id":"w-sanguozhi","source_id":"s-sanguozhi-060-zhonglimu"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-060-zhonglimu:line093","text":"　　鍾離牧字子幹，會稽山陰人，漢魯相意七世孫也。少爰居永興，躬自墾田，種稻二十餘畝。臨熟，縣民有識認之。牧曰：“本以田荒，故墾之耳。”遂以稻與縣人。縣長聞之，召民繋獄，欲繩以法，牧為之請。長曰：“君慕承宮，自行義事，僕為民主，當以法率下，何得寢公憲而從君邪？”牧曰：“此是郡界，緣君意顧，故來蹔住。今以少稻而殺此民，何心復留？”遂出裝，還山陰，長自往止之，為釋繋民。民慚懼，率妻子舂所取稻得六十斛米，送還牧，牧閉門不受。民輸置道旁，莫有取者。牧由此發名。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-060-zhonglimu:line093:m0002","start":2,"end":5,"surface":"鍾離牧","kind":"person","person_id":"2ue_nmk_m3s_A","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-zhonglimu:line093:m0006","start":6,"end":8,"surface":"子幹","kind":"person","person_id":"2ue_nmk_m3s_A","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-zhonglimu:line093:m0018","surface":"意","start":18,"end":19,"kind":"person","person_id":"l23_2g0_02j","status":"contextual_provisional","interpretation_note":"按本段具名及前後親稱、官職定位。"},{"id":"c-sanguozhi-06