person_mention_id":"c-nanqishu-055-filial-complete:p033:m0016"}],"status":"source_attested","interpretation_note":"父員外郎。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-055-filial-complete:p033","text":"　　江泌字士清，濟陽考城人也。父亮之，員外郎。泌少貧，晝日斫屟，夜讀書，隨月光握卷升屋。性行仁義，衣弊，恐虱饑死，乃復取置衣中。數日閒，終身無復虱。母亡後，以生闕供養，遇鮭不忍食。食菜不食心，以其有生意也。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":137,"last_line":137,"raw_start":4904,"raw_end":5007,"raw_character_offsets":[4904,4905,4906,4907,4908,4909,4910,4911,4912,4913,4914,4915,4916,4917,4918,4919,4920,4921,4922,4923,4924,4925,4926,4927,4928,4929,4930,4931,4932,4933,4934,4935,4936,4937,4938,4939,4940,4941,4942,4943,4944,4945,4946,4947,4948,4949,4950,4951,4952,4953,4954,4955,4956,4957,4958,4959,4960,4961,4962,4963,4964,4965,4966,4967,4968,4969,4970,4971,4972,4973,4974,4975,4976,4977,4978,4979,4980,4981,4982,4983,4984,4985,4986,4987,4988,4989,4990,4991,4992,4993,4994,4995,4996,4997,4998,4999,5000,5001,5002,5003,5004,5005,5006],"revision_id":1545598},"mentions":[{"id":"c-nanqishu-055-filial-complete:p033:m0002","start":2,"end":4,"surface":"江泌","kind":"person","person_id":"iqu_kre_msh","status":"contextual_provisional"},{"id":"c-nanqishu-055-filial-complete:p033:m0005","start":5,"end":7,"surface":"士清","kind":"person","person_id":"iqu_kre_msh","status":"contextual_provisional"},{"id":"c-nanqishu-055-filial-complete:p033:m0016","start":16,"end":18,"surface":"亮之","kind":"person","person_id":"beo_sz4_1mr","status":"contextual_provisional"},{"id":"c-nanqishu-055-filial-complete:p033:m0023","start":23,"end":24,"surface":"泌","kind":"person","person_id":"iqu_kre_msh","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-055-filial-complete","book_id":"b-nanqishu-055","work_id":"w-nanqishu","source_id":"s-nanqishu-055-filial-complete-ws1545598"},{"id":"c-nanqishu-055-filial-complete:p034","text":"　　歷仕南中郎行參軍，所給募吏去役，得時病，莫有舍之者，吏扶杖投泌，泌親自隱卹，吏死，泌爲買棺。無僮役，兄弟共輿埋之。領國子助教。乘牽車至染烏頭，見老翁步行，下車載之，躬自步去。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":139,"last_line":139,"raw_start":5009,"raw_end":5098,"raw_character_offsets":[5009,5010,5011,5012,5013,5014,5015,5016,5017,5018,5019,5020,5021,5022,5023,5024,5025,5026,5027,5028,5029,5030,5031,5032,5033,5034,5035,5036,5037,5038,5039,5040,5041,5042,5043,5044,5045,5046,5047,5048,5049,5050,5051,5052,5053,5054,5055,5056,5057,5058,5059,5060,5061,5062,5063,5064,5065,5066,5067,5068,5069,5070,5071,5072,5073,5074,5075,5076,5077,5078,5079,5080,5081,5082,5083,5084,5085,5086,5087,5088,5089,5090,5091,5092,5093,5094,5095,5096,5097],"revision_id":1545598},"mentions":[{"id":"c-nanqishu-055-filial-complete:p034:m0032","start":32,"end":33,"surface":"泌","kind":"person","person_id":"iqu_kre_msh","status":"contextual_provisional"},{"id":"c-nanqishu-055-filial-complete:p034:m0034","start":34,"end":35,"surface":"泌","kind":"person","person_id":"iqu_kre_msh","status":"contextual_provisional"},{"id":"c-nanqishu-055-filial-complete:p034:m0043","start":43,"end":44,"surface":"泌","kind":"person","person_id":"iqu_kre_msh","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-055-filial-complete","book_id":"b-nanqishu-055","work_id":"w-nanqishu","source_id":"s-nanqishu-055-filial-complete-ws1545598"},{"id":"c-nanqishu-055-filial-complete:p035","text":"　　世祖以爲南康王子琳侍讀。建武中，明帝害諸王後，泌憂念子琳，詣誌公道人問其禍福。誌公覆香鑪灰示之，曰：「都盡。無所餘。」及子琳被害，泌往哭之，淚盡，繼之以血。親視殯葬，乃去。時廣漢王侍讀嚴桓之亦哭王盡哀。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":141,"last_line":141,"raw_start":5100,"raw_end":5203,"raw_character_offsets":[5100,5101,5102,5103,5104,5105,5106,5107,5108,5109,5110,5111,5112,5113,5114,5115,5116,5117,5118,5119,5120,5121,5122,5123,5124,5125,5126,5127,5128,5129,5130,