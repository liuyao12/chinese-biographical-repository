rson","person_id":"cbr-p001929","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m046-0022","start":22,"end":24,"surface":"伍奢","kind":"person","person_id":"cbr-p001931","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m046-0027","start":27,"end":29,"surface":"郤宛","kind":"person","person_id":"cbr-p001980","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m046-0030","start":30,"end":31,"surface":"宛","kind":"person","person_id":"cbr-p001980","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m046-0034","start":34,"end":37,"surface":"伯氏子","kind":"person","person_id":"cbr-p001981","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m046-0038","start":38,"end":40,"surface":"子胥","kind":"person","person_id":"cbr-p001933","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m046-0053","start":53,"end":55,"surface":"無忌","kind":"person","person_id":"cbr-p001930","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m046-0060","start":60,"end":62,"surface":"子常","kind":"person","person_id":"cbr-p001934","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m046-0063","start":63,"end":65,"surface":"無忌","kind":"person","person_id":"cbr-p001930","status":"contextual_provisional"}],"chapter_id":"c-shiji-040-chu","book_id":"b-shiji-040","work_id":"w-shiji","source_id":"s-shiji-040-chu"},{"id":"c-shiji-040-chu:p047","text":"四年，呉三公子奔楚，楚封之以捍呉。五年，呉伐取楚之六、潛。七年，楚使子常伐呉，呉大敗楚於豫章。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m047-0003","start":3,"end":7,"surface":"呉三公子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、寓言人物或未定指代，未補未見姓名、全體成員或親屬關係。"},{"id":"c-shiji-040-chu:m047-0034","start":34,"end":36,"surface":"子常","kind":"person","person_id":"cbr-p001934","status":"contextual_provisional"}],"chapter_id":"c-shiji-040-chu","book_id":"b-shiji-040","work_id":"w-shiji","source_id":"s-shiji-040-chu"},{"id":"c-shiji-040-chu:p048","text":"十年冬，呉王闔閭、伍子胥、伯與唐、蔡倶伐楚，楚大敗，呉兵遂入郢，辱平王之墓，以伍子胥故也。呉兵之來，楚使子常以兵迎之，夾漢水陣。呉伐敗子常，子常亡奔鄭。楚兵走，呉乘勝逐之，五戰及郢。己卯，昭王出奔。庚辰，呉人入郢。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m048-0004","start":4,"end":8,"surface":"呉王闔閭","kind":"person","person_id":"cbr-p000424","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m048-0009","start":9,"end":12,"surface":"伍子胥","kind":"person","person_id":"cbr-p001933","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m048-0013","start":13,"end":14,"surface":"伯","kind":"unresolved","person_id":null,"status":"unresolved","note":"本版僅作伯，未補嚭字或直接連到他篇伯嚭；需核對版本與同一伐楚事件。"},{"id":"c-shiji-040-chu:m048-0033","start":33,"end":35,"surface":"平王","kind":"person","person_id":"cbr-p001892","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m048-0039","start":39,"end":42,"surface":"伍子胥","kind":"person","person_id":"cbr-p001933","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m048-0052","start":52,"end":54,"surface":"子常","kind":"person","person_id":"cbr-p001934","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m048-0067","start":67,"end":69,"surface":"子常","kind":"person","person_id":"cbr-p001934","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m048-0070","start":70,"end":72,"surface":"子常","kind":"person","person_id":"cbr-p001934","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m048-0094","start":94,"end":96,"surface":"昭王","kind":"person","person_id":"cbr-p001915","status":"contextual_provisional"}],"chapter_id":"c-shiji-040-chu","book_id":"b-shiji-040","work_id":"w-shiji","source_id":"s-shiji-040-chu"}],"sources":[{"chapter_id":"c-shiji-040-chu","work_id":"w-shiji","book_id":"b-shiji-040","source_id":"s-shiji-040-chu","source":{"title":"史記／卷040","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷040","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷040&oldid=8736796","revision_id":8736796,"accessed_on":"2026-10-09","extent":"96段正文及1段分層索隱述贊；排除2個dd導覽