68,2169,2172,2173,2179,2180,2181,2182,2185,2186,2187,2188,2189,2190]},"chapter_id":"c-sanguozhi-061-lukai","book_id":"b-sanguozhi-061","work_id":"w-sanguozhi","source_id":"s-sanguozhi-061-lukai"},{"id":"c-sanguozhi-065-wangfan-complete:p003","text":"　　甘露二年，丁忠使晉還，皓大會群臣，蕃沉醉頓伏。皓疑而不悅，舉蕃出外。頃之請還，酒亦不解。蕃性有威嚴，行止自若，皓大怒，呵左右於殿下斬之。衛將軍滕牧、征西將軍留平請，不能得。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":14,"last_line":14,"raw_start":314,"raw_end":769,"raw_character_offsets":[314,315,321,322,323,324,332,333,334,335,336,337,338,339,340,341,342,343,344,345,346,347,348,349,350,351,352,353,354,355,356,357,358,359,360,361,362,363,364,365,366,367,368,369,370,371,372,373,374,375,376,377,378,379,380,381,382,383,384,385,386,387,388,389,390,391,392,393,394,395,396,397,398,399,400,401,402,403,404,405,406,407,408,409,410,411,412,413],"revision_id":2589669},"mentions":[{"id":"c-sanguozhi-065-wangfan-complete:p003:m0007","surface":"丁忠","start":7,"end":9,"kind":"person","person_id":"ips_zzr_q22","status":"contextual_provisional"},{"id":"c-sanguozhi-065-wangfan-complete:p003:m0013","surface":"皓","start":13,"end":14,"kind":"person","person_id":"05e_9bb_55a","status":"contextual_provisional"},{"id":"c-sanguozhi-065-wangfan-complete:p003:m0019","surface":"蕃","start":19,"end":20,"kind":"person","person_id":"z8o_i3j_zja","status":"contextual_provisional"},{"id":"c-sanguozhi-065-wangfan-complete:p003:m0025","surface":"皓","start":25,"end":26,"kind":"person","person_id":"05e_9bb_55a","status":"contextual_provisional"},{"id":"c-sanguozhi-065-wangfan-complete:p003:m0032","surface":"蕃","start":32,"end":33,"kind":"person","person_id":"z8o_i3j_zja","status":"contextual_provisional"},{"id":"c-sanguozhi-065-wangfan-complete:p003:m0046","surface":"蕃","start":46,"end":47,"kind":"person","person_id":"z8o_i3j_zja","status":"contextual_provisional"},{"id":"c-sanguozhi-065-wangfan-complete:p003:m0057","surface":"皓","start":57,"end":58,"kind":"person","person_id":"05e_9bb_55a","status":"contextual_provisional"},{"id":"c-sanguozhi-065-wangfan-complete:p003:m0073","surface":"滕牧","start":73,"end":75,"kind":"person","person_id":"e1z_w57_m3h","status":"contextual_provisional"},{"id":"c-sanguozhi-065-wangfan-complete:p003:m0080","surface":"留平","start":80,"end":82,"kind":"person","person_id":"uqc_ejd_tc4","status":"contextual_provisional"}],"chapter_id":"c-sanguozhi-065-wangfan-complete","book_id":"b-sanguozhi-065","work_id":"w-sanguozhi","source_id":"s-sanguozhi-065-wangfan-complete-ws2589669"},{"id":"c-sanguozhi-065-wangfan-complete:p004","text":"《江表傳》曰：皓用巫史之言，谓建业宫不利，乃西巡武昌，仍有迁都之意，恐群臣不从，乃大请会，赐将吏。问蕃“射不主皮，为力不同科，其义云何”？蕃思惟未答，即於殿上斩蕃。出登来山，使亲近将（跳）蕃首，作虎跳狼争咋齧之，头皆碎坏，欲以示威，使众不敢犯也。此与本传不同。吴录曰：皓每於会，因酒酣，辄令侍臣嘲谑公卿，以为笑乐。万彧既为左丞相，蕃嘲彧曰：“鱼潜於渊，出水煦沫。何则？物有本性，不可横处非分也。彧出自谿谷，羊质虎皮，虚受光赫之宠，跨越三九之位，犬马犹能识养，将何以报厚施乎！”彧曰：“唐虞之朝无谬举之才，造父之门无驽蹇之质，蕃上诬明选，下讪桢幹，何伤於日月，適多见其不知量耳。”臣松之按本传云丁忠使晋还，皓为大会，於会中杀蕃，检忠从北还在此年之春，彧时尚未为丞相，至秋乃为相耳。吴录所言为乖互不同。","text_layer":"witness_appended_pei_songzhi_note","annotation_status":"reviewed","source_position":{"first_line":14,"last_line":14,"raw_start":418,"raw_end":767,"raw_character_offsets":[418,419,420,421,422,423,424,425,426,427,428,429,430,431,432,433,434,435,436,437,438,439,440,441,442,443,444,445,446,447,448,449,450,451,452,453,454,455,456,457,458,459,460,461,462,463,464,465,466,467,468,469,470,471,472,473,474,475,476,477,478,479,480,481,482,483,484,485,486,487,488,489,490,491,492,493,494,495,496,497,498,499,500,501,502,503,504,505,506,507,508,509,510,511,512,513,514,515,516,517,518,519,520,521,522,523,524,525,526,527,528,529,530,531,532,533,534,535,536,537,538,539,540,541,542,543,544,545,546,547,548,549,550,551,552,553,554,555,556,557,558,559,560,561,562,563,564,565,566,567,568,569,570,571,572,573,574,575,576,577,578,579,580,581,582,583,584,585,586,587,588,589,590,591,592,593,594,595,596,597,598,599,600,601,602,603,604,605,606,607,608,609,610,611,612,613,614,615,616,617,618,619,620,621,622,623,624,625,626,627,628,629,630,631,632,633,634,635,636,637,638,639