red","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-061-lukai:line021:m0212","start":212,"end":214,"surface":"丁忠","kind":"person","person_id":"ips_zzr_q22","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-061-lukai:line021","chapter_id":"c-sanguozhi-061-lukai"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-061-lukai:line021","text":"　　陸凱字敬風，吳郡吳人，丞相遜族子也。黃武初為永興、諸暨長，所在有治跡，拜建武都尉，領兵。雖統軍眾，手不釋書。好《太玄》，論演其意，以筮輒驗。赤烏中，除儋耳太守，討朱崖，斬獲有功，遷為建武校尉。五鳳二年，討山賊陳毖於零陵。斬毖克捷，拜巴丘督、偏將軍，封都鄉侯，轉為武昌右部督。與諸將共赴壽春；還，累遷蕩魏、綏遠將軍。孫休即位，拜征北將軍，假節領豫州牧。孫皓立，遷鎮西大將軍，都督巴丘，領荊州牧，進封嘉興侯。孫皓與晉平，使者丁忠自北還，說皓弋陽可襲，凱諫止，語在《皓傳》。寶鼎元年，遷左丞相。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-061-lukai:line021:m0002","start":2,"end":4,"surface":"陸凱","kind":"person","person_id":"61q_ogq_ueq","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line021:m0005","start":5,"end":7,"surface":"敬風","kind":"person","person_id":"61q_ogq_ueq","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line021:m0015","start":15,"end":16,"surface":"遜","kind":"person","person_id":"lii_454_vuv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line021:m0106","start":106,"end":108,"surface":"陳毖","kind":"person","person_id":"60a_wcj_b3n","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line021:m0113","start":113,"end":114,"surface":"毖","kind":"person","person_id":"60a_wcj_b3n","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line021:m015