不顧言其為浮淺較可識别而世人惑焉猶不檢之以言行也近濟隂魏諷山陽曹偉皆以傾邪敗沒熒惑當世挾持姦慝驅動後生雖刑於鈇鉞大為烱戒然所汙染固以衆矣可不慎與","text_layer":"received_chapter","annotation_status":"in_progress","source_position":{"first_line":169,"last_line":180,"revision_id":"214fcafa79894355909c9d8c2c1533089e7791c6","projection_sha256":"2d4cf6733af83b87bfe9ba0b87ec230b8ff3803f523171e5c54f7277f072dfd2","source_fragments":[{"line":169,"raw_start":23,"raw_end":33,"text":"人或毁已當退而求之於"},{"line":170,"raw_start":0,"raw_end":21,"text":"身若己有可毁之行則彼言當矣若己無可毁之行則"},{"line":171,"raw_start":0,"raw_end":21,"text":"彼言妄矣當則無怨於彼妄則無害於身又何反報焉"},{"line":172,"raw_start":0,"raw_end":21,"text":"且聞人毁己而忿者惡醜聲之加人也人報者滋甚不"},{"line":173,"raw_start":0,"raw_end":21,"text":"如黙而自脩己也諺曰救寒莫如重裘止謗莫如自脩"},{"line":174,"raw_start":0,"raw_end":21,"text":"斯言信矣若與是非之士凶險之人近猶不可况與對"},{"line":176,"raw_start":0,"raw_end":21,"text":"校乎其害深矣夫虛偽之人言不根道行不顧言其為"},{"line":177,"raw_start":0,"raw_end":21,"text":"浮淺較可識别而世人惑焉猶不檢之以言行也近濟"},{"line":178,"raw_start":0,"raw_end":21,"text":"隂魏諷山陽曹偉皆以傾邪敗沒熒惑當世挾持姦慝"},{"line":179,"raw_start":0,"raw_end":21,"text":"驅動後生雖刑於鈇鉞大為烱戒然所汙染固以衆矣"},{"line":180,"raw_start":0,"raw_end":4,"text":"可不慎與"}],"source_layer":"received_biography"},"mentions":[{"id":"c-sanguozhi-027-wangchang:unit009:m0158","start":158,"end":160,"surface":"魏諷","kind":"person","person_id":"vhp_i3i_jj4","status":"contextual_provisional","interpretation_note":"依本完整敘事與固定平行語境辨識；原稱保留。"},{"id":"c-sanguozhi-027-wangchang:unit009:m0162","start":162,"end":164,"surface":"曹偉","kind":"person","person_id":"fd6_eb0_e04","status":"contextual_provisional","interpretation_note":"依本完整敘事與固定平行語境辨識；原稱保留。"}],"chapter_id":"c-sanguozhi-027-wangchang","book_id":"b-sanguozhi-027","work_id":"w-sanguozhi","source_id":"s-sanguozhi-027-wangchang"},{"id":"c-sanguozhi-027-wangchang:unit014","text":"臣松之以為文舒復擬則文淵顯言人之失魏諷曹偉事陷惡逆著以為誡差無可尤至若郭伯益劉公幹雖其人皆往善惡有定然既友之於昔不宜復毁之於今而乃形于翰墨永傳後葉於舊交則違乆要之義於子孫則揚人前世之惡於夫鄙懐深所不取善乎東方之誡子也以首陽為拙柳下為工寄㫖古人無傷當時方之馬王不亦逺哉","text_layer":"witness_appended_pei_songzhi_note","annotation_status":"in_progress","source_position":{"fi