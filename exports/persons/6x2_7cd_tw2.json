-wangbin:line046:m0043","start":43,"end":45,"surface":"劉機","kind":"person","person_id":"4jn_rcu_wkb","status":"contextual_provisional"},{"id":"c-jinshu-076-wangbin:line046:m0050","start":50,"end":52,"surface":"元帝","kind":"person","person_id":"dkn_ge4_286_AAAAAAA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangbin:line046:m0069","start":69,"end":71,"surface":"華軼","kind":"person","person_id":"p86_bh6_jm2","status":"contextual_provisional"},{"id":"c-jinshu-076-wangbin:line046:m0078","start":78,"end":80,"surface":"湣帝","kind":"person","person_id":"pss_n95_7x4","status":"contextual_provisional"}],"source_position":{"first_line":46,"last_line":46,"revision_id":2180533,"editorial_excerpt_boundary":false},"chapter_id":"c-jinshu-076-wangbin","book_id":"b-jinshu-076","work_id":"w-jinshu","source_id":"s-jinshu-076-wangbin"},{"id":"c-songshu-048-fuhongzhi-zhao-family:p001","text":"弘之高祖晉司徒祗，後封靈州公，不欲封本縣，故祗一門還復泥陽。曾祖暢，祕書丞，沒胡，生子洪，晉穆帝永和中，胡亂得還。洪生韶，梁州刺史，散騎常侍。韶生弘之。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":67,"last_line":67,"raw_start":5934,"raw_end":6064,"raw_character_offsets":[5934,5935,5936,5937,5938,5939,5940,5941,5942,5943,5944,5945,5946,5947,5948,5949,5950,5951,5952,5953,5954,5955,5956,5957,5958,5959,5960,5961,5962,5963,5964,5965,5966,5967,5968,5969,5970,5971,5972,5973,5974,5975,5976,5977,5978,5979,5980,5981,5982,5983,5984,5985,5986,5987,5988,5989,5990,5991,5992,5993,5994,6049,6050,6051,6052,6053,6054,6055,6056,6057,6058,6059,6060,6061,6062,6063],"revision_id":1791560},"mentions":[{"id":"c-songshu-048-fuhongzhi-zhao-family:p001:m0000","start":0,"end":2,"surface":"弘之","kind":"person","person_id":"258_ae3_26e_AAA","status":"contextual_provisional"},{"id":"c-songshu-048-fuhongzhi-zhao-family:p001:m0007","start":7,"end":8,"surface":"祗","kind":"person","person_id":"6x2_7cd_tw2","status":"contextual_provisional"},{"id":"c-songshu-048-fuhongzhi-zhao-family:p001:m0022","start":22,"end":23,"surface":"祗","kind":"person","person_id":"6x2_7cd_tw2","status":"contextual_provisional"},{"id":"c-songshu-048-fuhongzhi-zhao-family:p001:m0032","start":32,"end":33,"surface":"暢","kind":"person","person_id":"258_ae3_26e","status":"contextual_provisional"},{"id":"c-songshu-048-fuhongzhi-zhao-family:p001:m0043","start":43,"end":44,"surface":"洪","kind":"person","person_id":"258_ae3_26e_A","status":"contextual_provisional"},{"id":"c-songshu-048-fuhongzhi-zhao-family:p001:m0057","start":57,"end":58,"surface":"洪","kind":"person","person_id":"258_ae3_26e_A","status":"contextual_provisional"},{"id":"c-songshu-048-fuhongzhi-zhao-family:p001:m0059","start":59,"end":60,"surface":"韶","kind":"person","person_id":"258_ae3_26e_AA","status":"contextual_provisional"},{"id":"c-songshu-048-fuhongzhi-zhao-family:p001:m0071","start":71,"end":72,"surface":"韶","kind":"person","person_id":"258_ae3_26e_AA","status":"contextual_provisional"},{"id":"c-songshu-048-fuhongzhi-zhao-family:p001:m0073","start":73,"end":75,"surface":"弘之","kind":"person","person_id":"258_ae3_26e_AAA","status":"contextual_provisional"}],"chapter_id":"c-songshu-048-fuhongzhi-zhao-family","book_id":"b-songshu-048","work_id":"w-songshu","source_id":"s-songshu-048-fuhongzhi-zhao-family-ws1791560"},{"id":"c-songshu-048-fuhongzhi:p001","text":"傅弘之字仲度，北地泥陽人。傅氏舊屬靈州，漢末郡境為虜所侵，失土寄寓馮翊，置泥陽、富平二縣，靈州廢不立，故傅氏悉屬泥陽。晉武帝太康三年，復立靈州縣，傅氏還屬靈州。弘之高祖晉司徒祗，後封靈州公，不欲封本縣，故祗一門還復泥陽。曾祖暢，祕書丞，沒胡，生子洪，晉穆帝永和中，胡亂得還。洪生韶，梁州刺史，散騎常侍。韶生弘之。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":67,"last_line":67,"raw_start":5854,"raw_end":6064,"raw_character_offsets":[5854,5855,5856,5857,5858,5859,5860,5861,5862,5863,5864,5865,5866,5867,5868,5869,5870,5871,5872,5873,5874,5875,5876,5877,5878,5879,5880,5881,5882,5883,5884,5885,5886,5887,5888,5889,5890,5891,5892,5893,5894,5895,5896,5897,5898,5899,5900,5901,5902,5903,5904,5905,5906,5907,5908,5909,5910,5911,5912,5913,5914,5915,5916,5917,5918,5919,5920,5921,5922,5923,5924,5925,5926,5927,5928,5929,5930,5931,5932,5933