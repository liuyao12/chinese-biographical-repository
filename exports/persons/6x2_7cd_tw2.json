太守蘇韶，辭意懇切，形于文墨。含之固讓，乃在王未薨之前，葬後躊躇，窮於對罰而攝職耳。臣從弟祗為州都，意在欲隆風教，議含已過，不良之人遂相扇動，冀挾名義，法外致案，足有所邀，中正龐騰便割含品。臣雖無祁大夫之德，見含為騰所侮，謹表以聞，乞朝廷以時博議，無令騰得妄弄刀尺。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":68,"last_line":68,"raw_start":5617,"raw_end":5822,"raw_character_offsets":[5619,5620,5621,5622,5623,5624,5625,5626,5627,5628,5629,5630,5631,5632,5633,5634,5635,5636,5637,5638,5639,5640,5641,5642,5643,5644,5645,5646,5647,5648,5649,5650,5651,5652,5653,5654,5655,5656,5657,5658,5659,5660,5661,5662,5663,5664,5665,5666,5667,5668,5669,5670,5671,5672,5673,5674,5675,5676,5677,5678,5679,5680,5681,5682,5683,5684,5685,5686,5687,5688,5689,5690,5691,5692,5693,5694,5695,5696,5697,5698,5699,5700,5701,5702,5703,5704,5705,5706,5707,5708,5709,5710,5711,5712,5713,5714,5715,5716,5717,5718,5719,5720,5721,5722,5723,5724,5725,5726,5727,5728,5729,5730,5731,5732,5733,5734,5735,5736,5737,5738,5739,5740,5741,5742,5743,5744,5745,5746,5747,5748,5749,5750,5751,5752,5753,5754,5755,5756,5757,5758,5759,5760,5761,5762,5763,5764,5765,5766,5767,5768,5769,5770,5771,5772,5773,5774,5775,5776,5777,5778,5779,5780,5781,5782,5783,5784,5785,5786,5787,5788,5789,5790,5791,5792,5793,5794,5795,5796,5797,5798,5799,5800,5801,5802,5803,5804,5805,5806,5807,5808,5809,5810,5811,5812,5813,5814,5815,5816,5817],"revision_id":2413335},"mentions":[{"id":"c-jinshu-060-lihan:p004:m0001","surface":"含","start":1,"end":2,"person_id":"skr_sgj_x21","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-lihan:p004:m0068","surface":"蘇韶","start":68,"end":70,"person_id":"qtj_50r_xk6","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-lihan:p004:m0081","surface":"含","start":81,"end":82,"person_id":"skr_sgj_x21","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-lihan:p004:m0108","surface":"臣","start":108,"end":109,"person_id":"2rh_opu_xtn","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-lihan:p004:m0111","surface":"祗","start":111,"en