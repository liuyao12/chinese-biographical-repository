songshu-048-fuhongzhi:p001:m0153","start":153,"end":155,"surface":"弘之","kind":"person","person_id":"258_ae3_26e_AAA","status":"contextual_provisional"}],"chapter_id":"c-songshu-048-fuhongzhi","book_id":"b-songshu-048","work_id":"w-songshu","source_id":"s-songshu-048-fuhongzhi-ws1791560"}],"sources":[{"chapter_id":"c-jinshu-035-peikai-family","work_id":"w-jinshu","book_id":"b-jinshu-035","source_id":"s-jinshu-035-peikai-ws2506399","source":{"title":"《晉書》卷三十五裴楷及附傳（固定數位選錄）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7035&oldid=2506399","permalink":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7035&oldid=2506399","revision_id":2506399,"accessed_on":"2026-10-21","extent":"完整裴楷及輿、瓚、憲、康盾邵、綽遐與八裴八王19段；不是完整卷035，不含陳騫裴秀頠及史評。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄，保留見證歸屬；數位文字依CC BY-SA 4.0。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":null,"wikitext_sha256":"b27aa9fc386b5f40990822d615febffcb8b8cd6df3fe6f74585274ff733c12be","response_sha256":"e7fc20a0864866bfb68f1f92b542b6f542edebed2052fcf550244ed46206fa35","raw_file":"sources/witnesses/jin035-ws2506399.wikitext","normalization":{"character_conversion":{},"extraction_note":"展開連結顯示字、去粗體排版；標題另層。㲄、俊郎、雲及缺閉引號原樣保留。"}}},{"chapter_id":"c-jinshu-053-minhuai-yu","work_id":"w-jinshu","book_id":"b-jinshu-053","source_id":"s-jinshu-053-minhuai-yu-ws2595666","source":{"title":"晉書卷五十三·愍懷太子","provider":"Wikisource","permalink":"https://zh.wikisource.org/w/index.php?oldid=2595666","url":"https://zh.wikisource.org/w/index.php?oldid=2595666","revision_id":2595666,"edition":"維基文庫固定修訂","accessed_on":"2026-11-22","review_status":"text_checked","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫授權。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","extent":"晉書卷五十三·愍懷太子","text_scope":"complete_biography_unit","raw_path":"source-evidence/jin096-wanghuifeng/external/ws53-ws2595666.wikitext","raw_file_sha256":"6164fe2fb3f9c2033f45f7bf35b2b32b7c32ac5884fb65f9511b7e7ef0af8968","collation_witnesses":["source-evidence/jin053-roll/volume-reading.json"]}},{"chapter_id":"c-jinshu-060-lihan","work_id":"w-jinshu","book_id":"b-jinshu-060","source_id":"s-jinshu-060-lihan-ws2413335","source":{"title":"晉書卷六十·李含","provider":"Wikisource","permalink":"https://zh.wikisource.org/w/index.php?oldid=2413335","url":"https://zh.wikisource.org/w/index.php?oldid=2413335","revision_id":2413335,"edition":"維基文庫固定修訂","accessed_on":"2026-11-22","review_status":"text_checked","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫授權。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","extent":"晉書卷六十·李含","text_scope":"complete_biography_unit","raw_path":"source-evidence/jin060-roll/ws2413335.wikitext","raw_file_sha256":"672a23c2f4dfdcdbd4f29d98e5bc94bacbf82cba6e5759da81c2a7f6add365ef","collation_witnesses":["source-evidence/jin060-roll/volume-reading.json"]}},{"chapter_id":"c-jinshu-076-wangbin","work_id":"w-jinshu","book_id":"b-jinshu-076","source_id":"s-jinshu-076-wangbin","source":{"title":"《晉書》卷76（王彬傳）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7076&oldid=2180533","permalink":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7076&oldid=2180533","revision_id":2180533,"accessed_on":"2026-10-18","extent":"王彬完整四原段，其他傳記另錄。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，未親核底本影像","response_sha256":"c6c7c41bf93c491f6f69b058ecc493e979d65f3e65397d20055284f2e829cd30","wikitext_sha256":"872701db949f6f58ea6f183425617dfa82353177d2cc026037bfad953a60cd71","normalization":{"character_conversion":{},"extraction_note":"保留原字及標點；僅移除原段縮排。","excerpts":[{"proposed_paragraph_id":"c-jinshu-076-wangbin:line046","source_lines":[46,46],"raw_quote":"彬字世儒。少稱雅正，弱冠，不就州郡之命。光祿大夫傅祗辟為掾。後與兄廙俱渡江，為揚州刺史劉機建武長史。元帝引為鎮東賊曹參軍，轉典兵參軍。豫討華軼功，封都亭侯，湣帝召為尚書郎，以道險不就。遷建安太守，徙義興內史，未之職，轉軍諮祭酒。","raw_quote_sha256":"f3d08d3e962f98599df686c00627e520f63359a1ca2482fe5a4c43ed9f34450e","selected_text_sha256":"f3d08d3e962f98599df686c00627e520f63359a1ca2482fe5a4c43ed9f34450e","begin_anchor":"彬字世儒。少稱雅正，弱冠，不就州郡之","end_anchor":"守，徙義興內史，未之職，轉軍諮祭酒。"},{"proposed_paragraph_id":"c-jinshu-076-wangbin:line048","source_lines":[48,48],"raw_quote":"中興建，稍遷侍中。從兄敦舉兵石頭，帝使彬勞之。會周顗遇害，彬素與顗善，先往哭顗，甚慟。既而見敦，敦怪其有慘容，而問其所以。彬曰：「向哭伯仁，情未能已。」敦怒曰：「伯仁自致刑戮，且凡人遇汝，復何為者哉！」彬曰：「伯仁長者，君之親友，在朝雖無謇諤，亦非阿黨，而赦後加以極刑，所以傷惋也。」因勃然數敦曰：「兄抗旌犯順，殺戮忠良，謀圖不軌，禍及門戶。」音辭慷慨，聲淚俱下。敦大怒，厲聲曰：「爾狂悖乃可至此，為吾不能殺汝邪！」時王導在坐，為之懼，勸彬起謝。彬曰：「有腳疾已來，見天子尚欲不拜，何跪之有！此復何所謝！」敦曰：「腳痛孰若頸痛？」彬意氣自若，殊無懼容。後敦議舉兵向京師，彬諫甚苦。敦變色目左右，將收彬，彬正色曰：「君昔歲害兄，今又殺弟邪？」先是，彬從兄豫章太守棱為敦所害，敦以彬親故容忍之。俄而以彬為豫章太守。彬為人樸素方直，乏風味之好，雖居顯貴，常布衣蔬食。遷前將軍、江州刺史。","raw_quote_sha256":"71a8b5f32b67281085cae98c227cee7907400d835b4071fd0b8cf9e0a2e4d119","selected_text_sha256":"71a8b5f32b67281085cae98c227cee7907400d835b4071fd0b8cf9e0a2e4d119","begin_anchor":"中興建，稍遷侍中。從兄敦舉兵石頭，帝","end_anchor":"貴，常布衣蔬食。遷前將軍、江州刺史。"},{"proposed_paragraph_id":"c-jinshu-076-wangbin:line050","source_lines":[50,50],"raw_quote":"及敦死，王含欲投王舒，王應勸含投彬。含曰：「大將軍平素與江州云何，汝欲歸之？」應曰：「此乃所以宜往也。江州當人強盛時，能立同異，此非常人所及。睹衰厄，必興湣惻。荊州守文，豈能意外行事！」含不從，遂共投舒，舒果沈含父子于江。彬聞應來，密具船以待之。既不至，深以為恨。","raw_quote_sha256":"a1ee93c717f96341bd0671d41b2ff1d52c407d358d8c7ebde6d608966fc88d3b","selected_text_sha256":"a1ee93c717f96341bd0671d41b2ff1d52c407d358d8c7ebde6d608966fc88d3b","begin_anchor":"及敦死，王含欲投王舒，王應勸含投彬。","end_anchor":"來，密具船以待之。既不至，深以為恨。"},{"proposed_paragraph_id":"c-jinshu-076-wangbin:line052","source_lines":[52,52],"raw_quote":"敦平，有司奏彬及兄子安成太守籍之，並是敦親，皆除名。詔曰：「司徒導以大義滅親，其後昆雖或有違，猶將百世宥之，況彬等公之近親。」乃原之。徵拜光祿勳，轉度支尚書。蘇峻平後，改築新宮，彬為大匠。以營創勳勞，賜爵關內侯，遷尚書右僕射。卒官，年五十九。贈特進、衛將軍，加散騎常侍，諡曰肅。長子彭之嗣，位至黃門郎。次彪之，最知名。","raw_quote_sha256":"ad3b975e66cdd1e8ff7925d16c3c7b0a8f1f76532037c500192eff7f49d969dd","selected_text_sha256":"ad3b975e66cdd1e8ff7925d16c3c7b0a8f1f76532037c500192eff7f49d969dd","begin_anchor":"敦平，有司奏彬及兄子安成太守籍之，並","end_anchor":"彭之嗣，位至黃門郎。次彪之，最知名。"}]}}},{"chapter_id":"c-songshu-048-fuhongzhi","work_id":"w-songshu","book_id":"b-songshu-048","source_id":"s-songshu-048-fuhongzhi-ws1791560","source":{"title":"傅弘之","provider":"Wikisource","permalink":"https://zh.wikisource.org/w/index.php?oldid=1791560","url":"https://zh.wikisource.org/w/index.php?oldid=1791560","revision_id":1791560,"edition":"維基文庫固定修訂","accessed_on":"2026-11-21","review_status":"text_checked","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫授權。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","extent":"傅弘之","text_scope":"complete_biography_unit","raw_path":"source-evidence/song046-zhang-complete/external/song048-ws1791560.wikitext","raw_file_sha256":"0b275f284af779a0c075ee4741b527fb1dd4a5921c3d3f3ea167939e0e50a916"}},{"chapter_id":"c-songshu-048-fuhongzhi-zhao-family","work_id":"w-songshu","book_id":"b-songshu-048","source_id":"s-songshu-048-fuhongzhi-zhao-family-ws1791560","source":{"title":"傅弘之父系原句","provider":"Wikisource","permalink":"https://zh.wikisource.org/w/index.php?oldid=1791560","url":"https://zh.wikisource.org/w/index.php?oldid=1791560","revision_id":1791560,"edition":"維基文庫固定修訂","accessed_on":"2026-11-21","review_status":"text_checked","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫授權。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","extent":"傅弘之父系原句","text_scope":"partial_chapter","raw_path":"source-evidence/song046-zhang-complete/external/song048-ws1791560.wikitext","raw_file_sha256":"0b275f284af779a0c075ee4741b527fb1dd4a5921c3d3f3ea167939e0e50a916"}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true}}
