_286_AAAAIAN","status":"contextual_provisional","source_role":"yan"}],"chapter_id":"c-jinshu-064-wudi-sons-rendered","book_id":"b-jinshu-064","work_id":"w-jinshu","source_id":"s-jinshu-064-ws2622004-rendered-wudi-sons"},{"id":"c-jinshu-076-wangbin:line046","text":"彬字世儒。少稱雅正，弱冠，不就州郡之命。光祿大夫傅祗辟為掾。後與兄廙俱渡江，為揚州刺史劉機建武長史。元帝引為鎮東賊曹參軍，轉典兵參軍。豫討華軼功，封都亭侯，湣帝召為尚書郎，以道險不就。遷建安太守，徙義興內史，未之職，轉軍諮祭酒。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-076-wangbin:line046:m0000","start":0,"end":1,"surface":"彬","kind":"person","person_id":"7r6_k52_qji_ABDB","status":"contextual_provisional"},{"id":"c-jinshu-076-wangbin:line046:m0002","start":2,"end":4,"surface":"世儒","kind":"person","person_id":"7r6_k52_qji_ABDB","status":"contextual_provisional"},{"id":"c-jinshu-076-wangbin:line046:m0024","start":24,"end":26,"surface":"傅祗","kind":"person","person_id":"6x2_7cd_tw2","status":"contextual_provisional"},{"id":"c-jinshu-076-wangbin:line046:m0033","start":33,"end":34,"surface":"廙","kind":"person","person_id":"7r6_k52_qji_ABDA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangbin:line046:m0043","start":43,"end":45,"surface":"劉機","kind":"person","person_id":"4jn_rcu_wkb","status":"contextual_provisional"},{"id":"c-jinshu-076-wangbin:line046:m0050","start":50,"end":52,"surface":"元帝","kind":"person","person_id":"dkn_ge4_286_AAAAAAA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangbin:line046:m0069","start":69,"end":71,"surface":"華軼","kind":"person","person_id":"p86_bh6_jm2","status":"contextual_provisional"},{"id":"c-jinshu-076-wangbin:line046:m0078","start":78,"end":80,"surface":"湣帝","kind":"person","person_id":"dkn_ge4_286_AAAAIAND","status":"contextual_provisional"}],"source_position":{"first_line":46,"last_line":46,"revision_id":2180533,"editorial_excerpt_boundary":false},"chapter_id":"c-jinshu-076-wangbin","book_id":"b-jinshu-076","work_id":"w-jinshu","source_id":"s-jinshu-076-wangbin"}],"sources":[{"chapter_id":"c-jinshu-035-peikai-f