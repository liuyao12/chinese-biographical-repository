6-20:a001","paragraph_id":"c-jinshu-076-wangbin:line046","start":20,"end":24,"surface":"光祿大夫","person_mention_id":"c-jinshu-076-wangbin:line046:m0024","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"只按本段任命、轉任、降職或見稱保存；未知起訖留空，不以卒年終止全部稱號，也不把府主職位作受任者本官。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"th-songshu-048-fuhongzhi-1-84","title":"晉司徒","kind":"office","mode":"attestation","person_id":"6x2_7cd_tw2","attestations":[{"id":"th-songshu-048-fuhongzhi-1-84:a","paragraph_id":"c-songshu-048-fuhongzhi:p001","start":84,"end":87,"surface":"晉司徒","person_mention_id":"c-songshu-048-fuhongzhi:p001:m0087","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-048","chapter_id":"c-songshu-048-fuhongzhi","source_id":"s-songshu-048-fuhongzhi-ws1791560","paragraph_id":"c-songshu-048-fuhongzhi:p001","quote":"傅弘之字仲度，北地泥陽人。傅氏舊屬靈州，漢末郡境為虜所侵，失土寄寓馮翊，置泥陽、富平二縣，靈州廢不立，故傅氏悉屬泥陽。晉武帝太康三年，復立靈州縣，傅氏還屬靈州。弘之高祖晉司徒祗，後封靈州公，不欲封本縣，故祗一門還復泥陽。曾祖暢，祕書丞，沒胡，生子洪，晉穆帝永和中，胡亂得還。洪生韶，梁州刺史，散騎常侍。韶生弘之。","person_mention_id":"c-songshu-048-fuhongzhi:p001:m0087"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"th-songshu-048-fuhongzhi-1-91","title":"靈州公","kind":"noble_rank","mode":"attestation","person_id":"6x2_7cd_tw2","attestations":[{"id":"th-songshu-048-fuhongzhi-1-91:a","paragraph_id":"c-songshu-048-fuhongzhi:p001","start":91,"end":94,"surface":"靈州公","person_mention_id":"c-songshu-048-fuhongzhi:p001:m0087","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-048","chapter_id":"c-songshu-048-fuhongzhi","source_id":"s-songshu-048-fuhongzhi-ws1791560","paragraph_id":"c-songshu-048-fuhongzhi:p001","quote":"傅弘之字仲度，北地泥陽人。傅氏舊屬靈州，漢末郡境為虜所侵，失土寄寓馮翊，置泥陽、富平二縣，靈州廢不立，故傅氏悉屬泥陽。晉武帝太康三年，復立靈州縣，傅氏還屬靈州。弘之高祖晉司徒祗，後封靈州公，不欲封本縣，故祗一門還復泥陽。曾祖暢，祕書丞，沒胡，生子洪，晉穆帝永和中，胡亂得還。洪生韶，梁州刺史，散騎常侍。韶生弘之。","person_mention_id":"c-songshu-048-fuhongzhi:p001:m0087"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-035-peikai-family:p005","text":"楷子瓚娶楊駿女，然楷素輕駿，與之不平。駿既執政，乃轉為衛尉，遷太子少師，優遊無事，默如也。及駿誅，楷以婚親收付廷尉，將加法。是日事倉卒，誅戮縱橫，眾人為之震恐。楷容色不變，舉動自若，索紙筆與親故書。賴侍中傅祗救護得免，猶坐去官。太保衛瓘、太宰亮稱楷貞正不阿附，宜蒙爵土，乃封臨海侯，食邑二千戶。代楚王瑋為北軍中候，加散騎常侍。瑋怨瓘、亮斥己任楷，楷聞之，不敢拜，轉為尚書。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-035-peikai-family:p005:m0000","start":0,"end":1,"surface":"楷","kind":"person","person_id":"530_f9d_4bd","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p005:m0002","start":2,"end":3,"surface":"瓚","kind":"person","person_id":"99p_632_txb","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p005:m0004","start":4,"end":6,"surface":"楊駿","kind":"person","person_id":"603_131_11e","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p005:m0006","start":6,"end":7,"surface":"女","kind":"person","person_id":"wpv_w1b_yvx","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p005:m0009","start":9,"end":10,"surface":"楷","kind":"person","person_id":"530_f9d_4bd","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p005:m0012","start":12,"end":13,"surface":"駿","kind":"person","person_id":"603