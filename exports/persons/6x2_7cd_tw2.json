c-jinshu-053-minhuai-family","book_id":"b-jinshu-053","work_id":"w-jinshu","source_id":"s-jinshu-053-ws2595666-rendered-family"},{"id":"c-jinshu-064-wudi-sons-rendered:p019","text":"吳敬王晏，字平度，太康十年受封，食丹陽、吳興並吳三郡，曆射聲校尉、後軍將軍。與兄淮南王允共攻趙王倫，允敗，收晏付廷尉，欲殺之。傅祗於朝堂正色而爭，於是群官並諫，倫乃貶為賓徒縣王。後徙封代王。倫誅，詔復晏本封，拜上軍大將軍、開府，加侍中。長沙王乂、成都王穎之相攻也，乂以晏為前鋒都督，數交戰。永嘉中，為太尉、太將軍。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","source_position":{"acquisition":"current_rendered_tool_text","reported_revision_id":2622004,"fixed_body_obtained":false,"tool_line":208},"mentions":[{"id":"c-jinshu-064-wudi-sons-rendered:p019:m0000","start":0,"end":4,"surface":"吳敬王晏","kind":"person","person_id":"dkn_ge4_286_AAAAIAN","status":"contextual_provisional","source_role":"yan"},{"id":"c-jinshu-064-wudi-sons-rendered:p019:m0006","start":6,"end":8,"surface":"平度","kind":"person","person_id":"dkn_ge4_286_AAAAIAN","status":"contextual_provisional","source_role":"yan"},{"id":"c-jinshu-064-wudi-sons-rendered:p019:m0040","start":40,"end":44,"surface":"淮南王允","kind":"person","person_id":"dkn_ge4_286_AAAAIAD","status":"contextual_provisional","source_role":"yun"},{"id":"c-jinshu-064-wudi-sons-rendered:p019:m0046","start":46,"end":49,"surface":"趙王倫","kind":"person","person_id":"dkn_ge4_286_AAAAG","status":"contextual_provisional","source_role":"lun"},{"id":"c-jinshu-064-wudi-sons-rendered:p019:m0050","start":50,"end":51,"surface":"允","kind":"person","person_id":"dkn_ge4_286_AAAAIAD","status":"contextual_provisional","source_role":"yun"},{"id":"c-jinshu-064-wudi-sons-rendered:p019:m0054","start":54,"end":55,"surface":"晏","kind":"person","person_id":"dkn_ge4_286_AAAAIAN","status":"contextual_provisional","source_role":"yan"},{"id":"c-jinshu-064-wudi-sons-rendered:p019:m0061","start":61,"end":62,"surface":"之","kind":"pronoun","person_id":"dkn_ge4_286_AAAAIAN","status":"contextual_provisional","source_role":"yan","voice":"reported_object_pronoun","source_reference_binding":{"kind":"received_sima_family_prono