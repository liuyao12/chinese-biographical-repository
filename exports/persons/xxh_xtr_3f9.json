騎常侍、金紫光祿大夫。元嘉二十五年卒，時年七十二。","mentions":[{"id":"c-songshu-093-ruanwanling:p002:m0000","surface":"萬齡","start":0,"end":2,"person_id":"wv8_l6v_kp9","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-songshu-093-ruanwanling:p002:m0011","surface":"孟昶","start":11,"end":13,"person_id":"70y_je5_bm0","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-songshu-093-ruanwanling:p002:m0019","surface":"袁豹","start":19,"end":21,"person_id":"xxh_xtr_3f9","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-songshu-093-ruanwanling:p002:m0022","surface":"江夷","start":22,"end":24,"person_id":"f8f_8b2_11c","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-songshu-093-ruanwanling:p002:m0027","surface":"昶","start":27,"end":28,"person_id":"70y_je5_bm0","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-songshu-093-ruanwanling:p002:m0034","surface":"昶","start":34,"end":35,"person_id":"70y_je5_bm0","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-songshu-093-ruanwanling:p002:m0041","surface":"萬齡","start":41,"end":43,"person_id":"wv8_l6v_kp9","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":1962755,"source_layer":"received_biography","first_line":74,"last_line":74,"line_start":0,"line_end":165,"raw_start":5368,"raw_end":5533,"raw_character_offsets":[5368,5369,5370,5371,5372,5373,5374,5375,5376,5377,5378,5379,5380,5381,5382,5383,5384,5385,5386,5387,5388,5389,5390,5391,5392,5395,5398,5399,5400,5401,5402,5403,5404,5405,5406,5407,5408,5409,5410,5411,5412,5413,5414,5415,5416,5417,5418,5419,5420,5421,5422,5423,5424,5425,5426,5427,5428,5429,5430,5431,5432,5433,5434,5435,5436,5437,5438,5441,5444,5445,5446,5447,5448,5449