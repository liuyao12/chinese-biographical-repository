iewed","source_position":{"revision_id":2190655,"first_line":99,"last_line":99,"line_start":0,"line_end":2,"raw_start":7651,"raw_end":7653,"raw_character_offsets":[7651,7652],"projection_sha256":"8d313c43d0b68ea30beb4f55d3b8dca2cf954044775295bc6cd051e7b16d3359","source_layer":"received_biography"},"chapter_id":"c-songshu-052-yuantan-line","book_id":"b-songshu-052","work_id":"w-songshu","source_id":"s-songshu-052-yuantan-line-ws2190655"},{"id":"c-songshu-093-ruanwanling-wyd:p001","text":"阮萬齡陳留尉氏人也祖思曠左光祿大夫父寧黃門侍郎萬齡少知名自通直郎為孟昶建威長史時袁豹江夷相係為昶司馬時人謂昶府有三素望萬齡家在會稽剡縣頗有素情永初末自侍中解職東歸徵為秘書監加給事中不就尋除左民尚書復起應命遷太常出為湘州刺史在州無政績還為東陽太守又被免復為散騎常侍金紫光祿大夫元嘉二十五年卒時年七十二","mentions":[{"id":"c-songshu-093-ruanwanling-wyd:p001:m0000","person_id":"wv8_l6v_kp9","surface":"阮萬齡","start":0,"end":3,"kind":"person","status":"contextual_provisional","interpretation_note":"根據該處敘事、說話或受書角色。"},{"id":"c-songshu-093-ruanwanling-wyd:p001:m0010","person_id":"03n_n2r_8rt","surface":"思曠","start":10,"end":12,"kind":"person","status":"contextual_provisional","interpretation_note":"根據該處敘事、說話或受書角色。"},{"id":"c-songshu-093-ruanwanling-wyd:p001:m0018","person_id":"03n_n2r_8rt_B","surface":"寧","start":18,"end":19,"kind":"person","status":"contextual_provisional","interpretation_note":"根據該處敘事、說話或受書角色。"},{"id":"c-songshu-093-ruanwanling-wyd:p001:m0023","person_id":"wv8_l6v_kp9","surface":"萬齡","start":23,"end":25,"kind":"person","status":"contextual_provisional","interpretation_note":"根據該處敘事、說話或受書角色。"},{"id":"c-songshu-093-ruanwanling-wyd:p001:m0033","person_id":"70y_je5_bm0","surface":"孟昶","start":33,"end":35,"kind":"person","status":"contextual_provisional","interpretation_note":"根據該處敘事、說話或受書角色。"},{"id":"c-songshu-093-ruanwanling-wyd:p001:m0040","person_id":"xxh_xtr_3f9","surface":"袁豹","start":40,"end":42,"kind":"person","status":"contextual_provisional","interpretation_note":"根據該處敘事、說話或受書角色。"},{"id":"c-songshu-093-ruanwanling-wyd:p001:m0042","person_id":"f8f_8b2_11c","surface":"江夷","start":42,"end":44,"kind":"person","status":"con