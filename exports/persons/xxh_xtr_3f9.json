gshu-052-yuantan-line","paragraph_id":"c-songshu-052-yuantan-line:p001","quote":"湛弟豹字士蔚","object_person_mention_id":"c-songshu-052-yuantan-line:p001:m0002"}],"interpretation_note":"依固定原句核對稱謂及親屬方向。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"title_holdings":[{"id":"th-nanshi024-ruanwanling-s1-52","person_id":"xxh_xtr_3f9","title":"司馬","kind":"office","mode":"attestation","attestations":[{"id":"th-nanshi024-ruanwanling-s1-52:a","person_mention_id":"c-nanshi-024-ruanwanling:p001:m0043","usage":"narrative","date_expression":null,"paragraph_id":"c-nanshi-024-ruanwanling:p001","surface":"司馬","start":52,"end":54}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-024","source_id":"s-nanshi-024-ruanwanling-ws1765279","chapter_id":"c-nanshi-024-ruanwanling","paragraph_id":"c-nanshi-024-ruanwanling:p001","quote":"阮萬齡，陳留尉氏人。祖思曠，左光祿大夫。父甯，黃門侍郎。萬齡少知名，爲孟昶建威長史。時袁豹、江夷相系爲昶司馬，時人謂昶府有三素望。萬齡家在會稽剡縣，頗有素情，位左戸尚書，太常。出爲湘州刺史，無政績。後爲散騎常侍、金紫光祿大夫，卒。","person_mention_id":"c-nanshi-024-ruanwanling:p001:m0043"}],"status":"source_attested","interpretation_note":"按本見證原職名及其所屬人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"th-nanshi024-ruanwanling-m2-28","person_id":"xxh_xtr_3f9","title":"司馬","kind":"office","mode":"attestation","attestations":[{"id":"th-nanshi024-ruanwanling-m2-28:a","person_mention_id":"c-songshu-093-ruanwanling:p002:m0019","usage":"narrative","date_expression":null,"paragraph_id":"c-songshu-093-ruanwanling:p002","surface":"司馬","start":28,"end":30}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-093","source_id":"s-songshu-093-ruanwanling-ws1962755","chapter_id":"c-songshu-093-ruanwanling","paragraph_id":"c-songshu-093-ruanwanling:p002","quote":"萬齡少知名，自通直郎爲孟昶建威長史。時袁豹、江夷相係爲昶司馬，時人謂昶府有三素望。萬齡家在會稽剡縣，頗有素情，永初末，自侍中解職東歸，徴爲祕書監，加給事中，不就。尋除左民尚書，復起應命，遷太常，出爲湘州刺史，在州無政績。還爲東陽太守，又被免。復爲散騎常侍、金紫光祿大夫。元嘉二十五年卒，時年七十二。","person_mention_id":"c-songshu-093-ruanwanling:p002:m0019"}],"status":"source_attested","interpretation_note":"按本見證原職名及其所屬人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"th-song093-wyd-r1-48","person_id":"xxh_xtr_3f9","title":"司馬","kind":"office","mode":"attestation","attestations":[{"id":"th-song093-wyd-r1-48:a","person_mention_id":"c-songshu-093-ruanwanling-wyd:p001:m0040","usage":"narrative","date_expression":null,"paragraph_id":"c-songshu-093-ruanwanling-wyd:p001","surface":"司馬","start":48,"end":50}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-093","source_id":"s-songshu-093-ruanwanling-wyd1739","chapter_id":"c-songshu-093-ruanwanling-wyd","paragraph_id":"c-songshu-093-ruanwanling-wyd:p001","quote":"阮萬齡陳留尉氏人也祖思曠左光祿大夫父寧黃門侍郎萬齡少知名自通直郎為孟昶建威長史時袁豹江夷相係為昶司馬時人謂昶府有三素望萬齡家在會稽剡縣頗有素情永初末自侍中解職東歸徵為秘書監加給事中不就尋除左民尚書復起應命遷太常出為湘州刺史在州無政績還為東陽太守又被免復為散騎常侍金紫光祿大夫元嘉二十五年卒時年七十二","person_mention_id":"c-songshu-093-ruanwanling-wyd:p001:m0040"}],"status":"source_attested","interpretation_note":"按本見證原職名及其所屬人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-099-yinzhongwen:p005","text":"仲文善屬文，為世所重，謝靈運嘗云：「若殷仲文讀書半袁豹，則文才不減班固。」言其文多而見書少也。","source_position":{"kind":"wikitext_codepoint_positions","raw_path":"sources/jinshu/wikisource-2644703-raw.wikitext","raw_start":11671,"raw_end":11720,"character_positions":[11673,11674,11675,11676,11677,11678,11679,11680,11681,11682,11683,11684,11685,11686,11687,11688,11689,11690,11691,