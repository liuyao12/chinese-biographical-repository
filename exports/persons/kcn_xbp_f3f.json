tion_ids":["c-jinshu-044-luqin-family-rendered:p009:m0104"],"paragraph_ids":["c-jinshu-044-luqin-family-rendered:p009"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-044-luqin-family-rendered:p009:m0104","mention_ids":["c-jinshu-044-luqin-family-rendered:p009:m0104"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-059-ws2650517-wei-ying-children","s-jinshu044-lu-rendered-oldcapture"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"person_id":"kcn_xbp_f3f","surname":"劉","ming":"陶","additional_names":[],"chapter_id":"c-jinshu-044-luqin-family-rendered","paragraph_id":"c-jinshu-044-luqin-family-rendered:p009","person_mention_id":"c-jinshu-044-luqin-family-rendered:p009:m0104","quote":"及東海王越奉迎大駕，顒啟帝復穎還鄴，以志為魏郡太守，加左將軍，隨穎北鎮。行達洛陽，而平昌公模遣前鋒督護馮嵩距穎。穎還長安，未至而聞顒斬張方，求和於越。穎住華陰，志進長安，詣闕陳謝，即還就穎于武關。奔南陽，復為劉陶所驅，回詣河北。及穎薨，官屬奔散，唯志親自殯送，時人嘉之。越命志為軍諮祭酒，遷衛尉，永嘉末，轉尚書。洛陽沒，志將妻子北投并州刺史劉琨。至陽邑，為劉粲所虜，與次子謐、詵等俱遇害於平陽。長子諶。","note":"本段明寫劉粲／劉陶；本源可定名，但與他篇同名者分別記排除或未決。","status":"editorial_provisional","human_reviewed":false,"model":null,"work_id":"w-jinshu","book_id":"b-jinshu-044","source_id":"s-jinshu044-lu-rendered-oldcapture"}],"mentions":[{"id":"c-jinshu-044-luqin-family-rendered:p009:m0104","start":104,"end":106,"surface":"劉陶","kind":"person","person_id":"kcn_xbp_f3f","status":"contextual_provisional","resolution_note":"本篇來源內具名角色；跨篇同指未作肯定。身份審讀：liutao。","source_identity_role":"liutao","identity_reading_ref":"source-evidence/jin044-lu-rendered/identity-readings.json#liutao","paragraph_id":"c-jinshu-044-luqin-family-rendered:p009","chapter_id":"c-jinshu-044-luqin-family-rendered"},{"id":"c-jinshu-059-wei-ying-children:p002:m0127","start":127,"end":129,"surface":"劉陶","kind":"person","person_id":"kcn_xbp_f3f","status":"contextual_provisional","source_role":"liutao","paragraph_id":"c-jinshu-059-wei-ying-children:p002","chapter_id":"c-jinshu-059-wei-ying-children"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-044-luqin-family-rendered:p009","text":"及東海王越奉迎大駕，顒啟帝復穎還鄴，以志為魏郡太守，加左將軍，隨穎北鎮。行達洛陽，而平昌公模遣前鋒督護馮嵩距穎。穎還長安，未至而聞顒斬張方，求和於越。穎住華陰，志進長安，詣闕陳謝，即還就穎于武關。奔南陽，復為劉陶所驅，回詣河北。及穎薨，官屬奔散，唯志親自殯送，時人嘉之。越命志為軍諮祭酒，遷衛尉，永嘉末，轉尚書。洛陽沒，志將妻子北投并州刺史劉琨。至陽邑，為劉粲所虜，與次子謐、詵等俱遇害於平陽。長子諶。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","source_position":{"rendered_tool_line":202,"capture_ref":"source-evidence/jin044-lu-rendered/received-rendered-capture.json","capture_kind":"existing_rendered_text_not_raw","projection":"remove leading ideographic spaces and tool-link wrappers only"},"mentions":[{"id":"c-jinshu-044-luqin-family-rendered:p009:m0001","start":1,"end":5,"surface":"東海王越","kind":"person","person_id":"dkn_ge4_286_AAADBA","status":"contextual_provisional","resolution_note":"依本篇角色及已列原段，首選沿用現役身份；限制另列。身份審讀：yue。","source_identity_role":"yue","identity_reading_ref":"source-evidence/jin044-lu-rendered/identity-readings.json#yue"},{"id":"c-jinshu-044-luqin-family-rendered:p009:m0010","start":