ayer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-063-appraisal:line046-pei01-01:m0000","start":0,"end":2,"surface":"孫盛","kind":"person","person_id":"e74_385_649","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-063-appraisal:line046-pei01-01:m0016","start":16,"end":18,"surface":"裨竈","kind":"person","person_id":"1xb_k1f_7m8","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-063-appraisal:line046-pei01-01:m0019","start":19,"end":21,"surface":"梓慎","kind":"person","person_id":"mp0_koq_6os","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-063-appraisal:line046-pei01-01:m0037","start":37,"end":38,"surface":"達","kind":"person","person_id":"9vq_kh2_cfv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-063-appraisal:line046-pei01-01:m0062","start":62,"end":63,"surface":"達","kind":"person","person_id":"9vq_kh2_cfv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-063-appraisal:line046-pei01-01:m0192","start":192,"end":194,"surface":"仲尼","kind":"person","person_id":"fp6_ia6_7yw","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"}],"annotation_status":"reviewed","source_position":{"first_line":46,"last_line":46,"revision_id":2188657,"raw_start":2923,"raw_end":3134,"character_positions":[2923,2924,2925,2926,2927,2928,2929,2930,2931,2932,2933,2934,2935,2936,2937,2938,2939,2940,2941,2942,2943,2944,2945,2946,2947,2948,2949,2950,2951,2952,2953,2954,2955,2956,2957,2958,2959,2960,2961,2962,2963,2964,2965,2966,2967,2968,2969,2970,2971,2972,2973,2974,2975,2976,2977,2978,2979,2980,2981,2982,2983,2984,2985,2986,2987,2988,2989,2990,2991,2992,2993,2994,2995,2996,2997,2998,2999,3000,3001,3002,3003,3004,3005,3006,3007,3008,3009,3010,3011,3012,3013,3014,3015,3016,3017,3018,3019,3020,3021,3022,3023,3024,3025,3026,3027,3028,3029,3030,3031,3032,3033,3034,3035,3036,3037,3038,3039,3040,3041,3042,3043,3044,3045,3046,3047,3048,3049,3050,3051,3052,3053,3054,3055,3056,3057,3058,3059,3060,3061,3062,3063,3064,3065,3066,3067,3068,3069,3070,3071,3072,3073,3074,3075,3076,3077,3078,3079,3080,3081,3082,3083,3084,3085,3086,3087,3088,3089,3090,3091,3092,3093,3094,3095,3096,3097,3098,3099,3100,3101,3102,3103,3104,3105,3106,3107,3108,3109,3110,3111,3112,3113,3114,3115,3116,3117,3118,3119,3120,3121,3122,3123,3124,3125,3126,3127,3128,3129,3130,3131,3132,3133]},"attribution":{"annotator":"裴松之","attribution_kind":"quoted_author","source_label":"孫盛論","attribution_marker":"孫盛曰："},"attachment":{"received_paragraph_id":"c-sanguozhi-063-appraisal:line046","received_codepoint":47,"note_ordinal":1,"source_ordinal":1},"chapter_id":"c-sanguozhi-063-appraisal","book_id":"b-sanguozhi-063","work_id":"w-sanguozhi","source_id":"s-sanguozhi-063-appraisal"},{"id":"c-sanguozhi-063-appraisal:line046-pei01-02","text":"臣松之以爲盛云「君子志其大者，無所取諸」，故評家之旨，非新聲也。其餘所譏，則皆爲非理。自中原酷亂，至于建安，數十年間，生民殆盡，比至小康，皆百死之餘耳。江左雖有兵革，不能如中國之甚也，焉知達不算其安危，知禍有多少，利在東南，以全其身乎？而責不知魏氏將興，流播吳越，在京房之籌，猶不能自免刑戮，況達但以祕術見薄，在悔吝之間乎！古之道術，蓋非一方，探賾之功，豈惟六爻，苟得其要，則可以易而知之矣，迴轉一籌，胡足怪哉？達之推算，窮其要妙以知幽測隱，何愧于古！而以裨、梓限之，謂達爲妄，非篤論也。","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-063-appraisal:line046-pei01-02:m0000","start":0,"end":3,"surface":"臣松之","kind":"person","person_id":"vpy_180_2oi_AA","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-063-appraisal:line046-pei01-02:m0005","start":5,"end":6,"surface":"盛","kind":"person","person_id":"e74_385_649","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-063-appraisal:line046-pei01-02:m0094","start":94,"end":95,"surface":"達","kind":"person","person_id":"9vq_kh2_cfv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-063-appraisal:line046-pei01-02:m0133","start":133,"end":135,"surface":"京房","kind":"person","person_id":"s4d_