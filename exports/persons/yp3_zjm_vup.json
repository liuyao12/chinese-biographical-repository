eviewed":false,"evidence":[{"chapter_id":"c-shiji-039-jin","source_id":"s-shiji-039-jin","paragraph_id":"c-shiji-039-jin:p051","quote":"晉文公重耳，晉獻公之子也。自少好士，年十七，有賢士五人：曰趙衰；狐偃咎犯，文公舅也；賈佗；先軫；魏武子。自獻公爲太子時，重耳固已成人矣。獻公卽位，重耳年二十一。獻公十三年，以驪姬故，重耳備蒲城守秦。獻公二十一年，獻公殺太子申生，驪姬讒之，恐，不辭獻公而守蒲城。獻公二十二年，獻公使宦者履鞮趣殺重耳。重耳踰垣，宦者逐斬其衣袪。重耳遂奔狄。狄，其母國也。是時重耳年四十三。從此五士，其餘不名者數十人，至狄。","source_term":"晉獻公之子"}],"source_assertion_id":"a-shiji039-038","interpretation_note":"以此受傳正文的明示近親主張配置局部家族；不合併跨篇候選身份、不補闕名世代，不表示遠祖世系已核實。分支字元不是長幼排行。","reviewer":"Codex（AI 代理）","parent_person_id":"6di_ywz_ju4_AA"}},{"id":"yp3_zjm_vup","label":"廧咎如少女（趙世家未名者）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"其少女","mention_ids":["c-shiji-043-zhao:m010-0056"]}],"evidence":[{"mention_id":"c-shiji-043-zhao:m010-0056","chapter_id":"c-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p010","quote":"其少女"}]}],"source_mention_summary":[{"source_id":"s-shiji-043-zhao","work_id":"w-shiji","book_id":"b-shiji-043","chapter_id":"c-shiji-043-zhao","raw_mention_count":1,"mention_ids":["c-shiji-043-zhao:m010-0056"],"paragraph_ids":["c-shiji-043-zhao:p010"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-shiji-043-zhao:m010-0056","mention_ids":["c-shiji-043-zhao:m010-0056"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-shiji-043-zhao"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisio