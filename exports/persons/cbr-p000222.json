iji-039-jin:m015-0022","start":22,"end":25,"surface":"周平王","kind":"person","person_id":"cbr-p000222","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m015-0026","start":26,"end":28,"surface":"虢公","kind":"person","person_id":"cbr-p001703","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m015-0031","start":31,"end":35,"surface":"曲沃莊伯","kind":"person","person_id":"cbr-p001550","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m015-0036","start":36,"end":38,"surface":"莊伯","kind":"person","person_id":"cbr-p001550","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m015-0047","start":47,"end":49,"surface":"鄂侯","kind":"person","person_id":"cbr-p001702","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m015-0050","start":50,"end":51,"surface":"光","kind":"person","person_id":"cbr-p001551","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m015-0054","start":54,"end":56,"surface":"哀侯","kind":"person","person_id":"cbr-p001551","status":"contextual_provisional"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"}],"sources":[{"chapter_id":"c-shiji-004-zhou","work_id":"w-shiji","book_id":"b-shiji-004","source_id":"s-shiji-004-zhou","source":{"title":"史記／卷004","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷004","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷004&oldid=7909147","revision_id":7909147,"accessed_on":"2026-10-09","extent":"正文全文；排除註釋版導覽、現代節標題與註號；行內校勘標記另存。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫 CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[{"paragraph_id":"c-shiji-004-zhou:p017","witness_form":"［左］","body_reading":"","note":"數位見證行內校勘標記另存；有兩讀時正文保存改讀前的字，不宣稱已完成校勘。"},{"paragraph_id":"c-shiji-004-zhou:p039","witness_form":"（又作湦）","body_reading":"","note":"數位見證行內校勘標記另存；有兩讀時正文保存改讀前的字，不宣稱已完成校勘。"},{"paragraph_id":"c-shiji-004-zhou:p074"