{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"255_233_b52","canonical_person_id":"255_233_b52","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["255_233_b52"],"persons":[{"id":"255_233_b52","label":"劉穆之","status":"active","historicity":"historical_tradition","aliases":[{"surface":"劉穆之","mention_ids":["c-songshu-053-yu-dengzhi:line045:m0135"]}],"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-053","chapter_id":"c-songshu-053-yu-dengzhi","source_id":"s-songshu-053-yu-dengzhi","paragraph_id":"c-songshu-053-yu-dengzhi:line045","mention_id":"c-songshu-053-yu-dengzhi:line045:m0135","quote":"劉穆之"}],"review":"ai_provisional","identity_note":"按本批完整傳文單元辨識；不由同姓合併，不補未見父母、生母、生卒。"}],"source_mention_summary":[{"source_id":"s-songshu-053-yu-dengzhi","work_id":"w-songshu","book_id":"b-songshu-053","chapter_id":"c-songshu-053-yu-dengzhi","mention_count":1,"mention_ids":["c-songshu-053-yu-dengzhi:line045:m0135"],"paragraph_ids":["c-songshu-053-yu-dengzhi:line045"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-songshu-053-yu-dengzhi"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"person_id":"255_233_b52","title":null,"surname":"劉","ming":"穆之","additional_names":[],"work_id":"w-songshu","book_id":"b-songshu-053","chapter_id":"c-songshu-053-yu-dengzhi","source_id":"s-songshu-053-yu-dengzhi","paragraph_id":"c-songshu-053-yu-dengzhi:line045","quote":"登之少以強濟自立。初為晉會稽王道子太傅參軍。義旗初，又為高祖鎮軍參軍。以預討桓玄功，封曲江縣五等男。參大司馬琅邪王軍事，豫州別駕從事史，大司馬主簿，司徒左西曹屬。登之雖不涉學，善於世事，王弘、謝晦、江夷之徒，皆相知友。轉太尉主簿。義熙十二年，高祖北伐，登之擊節驅馳，退告劉穆之，以母老求郡。于時士庶咸憚遠役，而登之二三其心，高祖大怒，除吏名。大軍發後，乃以補鎮蠻護軍、西陽太守。入為太子庶子，尚書左丞。出為新安太守。","note":"原文具名用稱分錄姓、名；不把官名、王號或字當本名，不改寫原字。","status":"editorial_provisional","human_reviewed":false,"model":null}],"mentions":[{"id":"c-songshu-053-yu-dengzhi:line045:m0135","start":135,"end":138,"surface":"劉穆之","kind":"person","person_id":"255_233_b52","status":"contextual_provisional","paragraph_id":"c-songshu-053-yu-dengzhi:line045","chapter_id":"c-songshu-053-yu-dengzhi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-songshu-053-yu-dengzhi:line045","text":"登之少以強濟自立。初為晉會稽王道子太傅參軍。義旗初，又為高祖鎮軍參軍。以預討桓玄功，封曲江縣五等男。參大司馬琅邪王軍事，豫州別駕從事史，大司馬主簿，司徒左西曹屬。登之雖不涉學，善於世事，王弘、謝晦、江夷之徒，皆相知友。轉太尉主簿。義熙十二年，高祖北伐，登之擊節驅馳，退告劉穆之，以母老求郡。于時士庶咸憚遠役，而登之二三其心，高祖大怒，除吏名。大軍發後，乃以補鎮蠻護軍、西陽太守。入為太子庶子，尚書左丞。出為新安太守。","annotation_status":"in_progress","mentions":[{"id":"c-songshu-053-yu-dengzhi:line045:m0000","start":0,"end":2,"surface":"登之","kind":"person","person_id":"4qr_wrk_3vd_DDBA","status":"contextual_provisional"},{"id":"c-songshu-053-yu-dengzhi:line045:m0012","start":12,"end":17,"surface":"會稽王道子","kind":"person","person_id":"dkn_ge4_286_AAAAAAAFA","status":"contextual_provisional"},{"id":"c-songshu-053-yu-dengzhi:line045:m0028","start":28,"end":30,"surface":"高祖","kind":"person","person_id":"3dv_ken_w58","status":"contextual_provisional"},{"id":"c-songshu-053-yu-dengzhi:line045:m0038","start":38,"end":40,"surface":"桓玄","kind":"person","person_id":"lf6_f95_379","status":"contextual_provisional"},{"id":"c-songshu-053-yu-dengzhi:line045:m0054","start":54,"end":57,"surface":"琅邪王","kind":"unresolved","person_id":null,"status":"unresolved","note":"本段晉末桓玄、義熙北伐脈絡中的大司馬琅邪王主要候選為德文；與元帝、康帝及道子等同號者有年代反證，未核同任職句前暫不具體掛號。","candidate_person_ids":["ije_ngm_cmj"],"candidate_labels":["晉恭帝德文"]},{"id":"c-songshu-053-yu-dengzhi:line045:m0081","start":81,"end":83,"surface":"登之","kind":"person","person_id":"4qr_wrk_3vd_DDBA","status":"contextual_provisional"},{"id":"c-songshu-053-yu-dengzhi:line045:m0093","start":93,"end":95,"surface":"王弘","kind":"person","person_id":"7r6_k52_qji_ABAAAAA","status":"contextual_provisional"},{"id":"c-songshu-053-yu-dengzhi:line045:m0096","start":96,"end":98,"surface":"謝晦","kind":"person","person_id":"aa6_83c_juy_AAAA","status":"contextual_provisional"},{"id":"c-songshu-053-yu-dengzhi:line045:m0099","start":99,"end":101,"surface":"江夷","kind":"person","person_id":"f8f_8b2_11c","status":"contextual_provisional"},{"id":"c-songshu-053-yu-dengzhi:line045:m0121","start":121,"end":123,"surface":"高祖","kind":"person","person_id":"3dv_ken_w58","status":"contextual_provisional"},{"id":"c-songshu-053-yu-dengzhi:line045:m0126","start":126,"end":128,"surface":"登之","kind":"person","person_id":"4qr_wrk_3vd_DDBA","status":"contextual_provisional"},{"id":"c-songshu-053-yu-dengzhi:line045:m0135","start":135,"end":138,"surface":"劉穆之","kind":"person","person_id":"255_233_b52","status":"contextual_provisional"},{"id":"c-songshu-053-yu-dengzhi:line045:m0140","start":140,"end":141,"surface":"母","kind":"unresolved","person_id":null,"status":"unresolved","note":"明載母老，未明名；不由父廓補生母或配偶。","candidate_person_ids":[],"candidate_labels":["庾登之未名母親"]},{"id":"c-songshu-053-yu-dengzhi:line045:m0155","start":155,"end":157,"surface":"登之","kind":"person","person_id":"4qr_wrk_3vd_DDBA","status":"contextual_provisional"},{"id":"c-songshu-053-yu-dengzhi:line045:m0162","start":162,"end":164,"surface":"高祖","kind":"person","person_id":"3dv_ken_w58","status":"contextual_provisional"},{"id":"c-songshu-053-yu-dengzhi:line045:m0191","start":191,"end":193,"surface":"太子","kind":"unresolved","person_id":null,"status":"unresolved","note":"職稱內太子為實際府主候選但缺明確入任年；不單按敘事順序認作劉義符。","candidate_person_ids":[],"candidate_labels":["晉末或宋初太子，待核入任時段"]}],"source_position":{"first_line":45,"last_line":45,"revision_id":1996685,"editorial_excerpt_boundary":false},"text_layer":"received_chapter","chapter_id":"c-songshu-053-yu-dengzhi","book_id":"b-songshu-053","work_id":"w-songshu","source_id":"s-songshu-053-yu-dengzhi"}],"sources":[{"chapter_id":"c-songshu-053-yu-dengzhi","work_id":"w-songshu","book_id":"b-songshu-053","source_id":"s-songshu-053-yu-dengzhi","source":{"title":"《宋書》卷五十三〈庾登之及子沖遠〉","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?oldid=1996685","permalink":"https://zh.wikisource.org/w/index.php?oldid=1996685","revision_id":1996685,"accessed_on":"2026-10-19","extent":"《宋書》卷五十三〈庾登之及子沖遠〉完整傳文單元；非全卷。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"edition":"維基文庫數位轉錄；未核底本影像","response_sha256":"3cc63ab23c4ef74af4b62e3f025df8ce78559d0850089ac074aba95be474403c","wikitext_sha256":"95226c86fe13d535c410f8134c09048a22423305a5a65c8111dbde136802cbae","rights":"古代正文；維基文庫數位轉錄保留來源及共享授權資訊。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"extraction_note":"刪除段首縮排、維基連結語法與粗體符號；YL年號模板取顯示字；-{字}-取實際指定字；ref數位校勘注另存，正文不校改。","excerpts":[{"paragraph_id":"c-songshu-053-yu-dengzhi:line043","source_lines":[43,43],"raw_quote":"庾登之字元龍，潁川𨻳陵人也。曾祖冰，晉司空。祖蘊，廣州刺史。父廓，<ref>父廓　「廓」晉書作「廓之」。東晉南北朝人名後之「之」字，有時可省去。</ref>東陽太守。","raw_quote_sha256":"d9b9e240fc08766daff5dac9021eb4834d5a687d8c64d4d6e465acb02b7e7b9d","selected_text_sha256":"cc847aba6a2c46ee29930fd865091013d8ba3b7cdc9dc3900f34038b26f704d5","removed_digital_editorial_notes":[{"text":"父廓　「廓」晉書作「廓之」。東晉南北朝人名後之「之」字，有時可省去。","independently_verified":false,"text_layer":"modern_digital_apparatus"}]},{"paragraph_id":"c-songshu-053-yu-dengzhi:line045","source_lines":[45,45],"raw_quote":"登之少以強濟自立。初為晉會稽王道子太傅參軍。義旗初，又為高祖鎮軍參軍。以預討桓玄功，封曲江縣五等男。參大司馬琅邪王軍事，豫州別駕從事史，大司馬主簿，司徒左西曹屬。登之雖不涉學，善於世事，王弘、謝晦、江夷之徒，皆相知友。轉太尉主簿。義熙十二年，高祖北伐，登之擊節驅馳，退告劉穆之，以母老求郡。于時士庶咸憚遠役，而登之二三其心，高祖大怒，除吏名。大軍發後，乃以補鎮蠻護軍、西陽太守。入為太子庶子，尚書左丞。出為新安太守。","raw_quote_sha256":"c8a56bae481f5e2fb48ec824f9785b6fd34fca69571ae87953db807cc69f235c","selected_text_sha256":"c8a56bae481f5e2fb48ec824f9785b6fd34fca69571ae87953db807cc69f235c","removed_digital_editorial_notes":[]},{"paragraph_id":"c-songshu-053-yu-dengzhi:line047","source_lines":[47,47],"raw_quote":"謝晦為撫軍將軍、荊州刺史，請為長史、南郡太守，仍為衞軍長史，太守如故。登之與晦俱曹氏壻，名位本同，一旦為之佐，意甚不愜。到廳牋，唯云「即日恭到」，初無感謝之言。每入覲見，備持箱囊几席之屬，一物不具不坐。晦常優容之。晦拒王師，欲使登之留守，登之不許，語在晦傳。晦敗，登之以無任免罪，禁錮還家。","raw_quote_sha256":"f3dd2e6299c4f6e1a133cf8282221cf41002765c44dd60ab73af7d769adde5dd","selected_text_sha256":"f3dd2e6299c4f6e1a133cf8282221cf41002765c44dd60ab73af7d769adde5dd","removed_digital_editorial_notes":[]},{"paragraph_id":"c-songshu-053-yu-dengzhi:line049","source_lines":[49,49],"raw_quote":"元嘉五年，起為衡陽王義季征虜長史。義季年少，未親政，眾事一以委之。尋加南東海太守。入為司徒右長史，尚書吏部郎，司徒左長史，南東海太守。府公彭城王義康專覽政事，不欲自下厝懷，而登之性剛，每陳己意，義康甚不悅，出為吳郡太守。州郡相臨，執意無改，因其莅任贓貨，以事免官。弟炳之時為臨川內史，登之隨弟之郡，優游自適。俄而除豫章太守，便道之官。登之初至臨川，吏民咸相輕侮，豫章與臨川接境，郡又華大，儀迓光赫，土人並驚歎焉。十八年，遷江州刺史。疾篤，徵為中護軍，未拜。二十年，卒，時年六十二。即以為贈。","raw_quote_sha256":"3531e5e5485303ada50bd1358a4eca85ee8a71e407fe12213b215c71c7c1c3b5","selected_text_sha256":"3531e5e5485303ada50bd1358a4eca85ee8a71e407fe12213b215c71c7c1c3b5","removed_digital_editorial_notes":[]},{"paragraph_id":"c-songshu-053-yu-dengzhi:line051","source_lines":[51,51],"raw_quote":"子沖遠，<ref>子沖遠　「沖遠」南史作「仲遠」。</ref>太宗鎮姑孰，為衞軍長史，卒於豫章太守，追贈侍中。","raw_quote_sha256":"9af951a4e7da4833c2603a6792e784523f0c31b60964266553ce38be3130674e","selected_text_sha256":"9c299def46c7915590ef0d67201f166ca8ff37bdcb9f44110c10912a6f3322b2","removed_digital_editorial_notes":[{"text":"子沖遠　「沖遠」南史作「仲遠」。","independently_verified":false,"text_layer":"modern_digital_apparatus"}]}],"verified_interparagraph_blank_lines":[{"source_lines":[50,50],"raw_quote":"","raw_quote_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","revision_id":1996685,"scope":"完整原段之間的空白，不是省略敘事"}]}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true}}
