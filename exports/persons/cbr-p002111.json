d":"cbr-p002111","status":"contextual_provisional","paragraph_id":"c-shiji-042-zheng:p003","chapter_id":"c-shiji-042-zheng"},{"id":"c-shiji-042-zheng:m003-0056","start":56,"end":58,"surface":"武公","kind":"person","person_id":"cbr-p002111","status":"contextual_provisional","paragraph_id":"c-shiji-042-zheng:p003","chapter_id":"c-shiji-042-zheng"},{"id":"c-shiji-042-zheng:m003-0063","start":63,"end":64,"surface":"公","kind":"person","person_id":"cbr-p002111","status":"contextual_provisional","paragraph_id":"c-shiji-042-zheng:p003","chapter_id":"c-shiji-042-zheng"},{"id":"c-shiji-042-zheng:m003-0072","start":72,"end":73,"surface":"公","kind":"person","person_id":"cbr-p002111","status":"contextual_provisional","paragraph_id":"c-shiji-042-zheng:p003","chapter_id":"c-shiji-042-zheng"},{"id":"c-shiji-042-zheng:m003-0079","start":79,"end":81,"surface":"武公","kind":"person","person_id":"cbr-p002111","status":"contextual_provisional","paragraph_id":"c-shiji-042-zheng:p003","chapter_id":"c-shiji-042-zheng"},{"id":"c-shiji-042-zheng:m028-0116","start":116,"end":118,"surface":"武公","kind":"person","person_id":"cbr-p002111","status":"contextual_provisional","paragraph_id":"c-shiji-042-zheng:p028","chapter_id":"c-shiji-042-zheng"}],"relations":[{"id":"a-shiji042-003","subject_person_id":"cbr-p002111","predicate":"father","object_person_id":"cbr-p002095","status":"source_attested","evidence":[{"chapter_id":"c-shiji-042-zheng","source_id":"s-shiji-042-zheng","paragraph_id":"c-shiji-042-zheng:p002","quote":"二歳，犬戎殺幽王於驪山下，并殺桓公。鄭人共立其子掘突，是爲武公。"}],"qualifiers":{"source_term":"其子掘突","historicity":"historical_tradition"},"interpretation_note":"保存本段明示子、生育、母稱與兄弟來源主張；不把繼位獨自作父子，不補未知母名或同父同母。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji042-017","person_id":"cbr-p002111","surfaces":["公","掘突","武公"],"scope":"same_chapter","chapter_ids":["c-shiji-042-zheng"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-042-zheng:p002","quote":"二歳，犬戎殺幽王於驪山下，并殺桓公。鄭人共立其子掘突，是爲武公。"},{"paragraph_id":"c-shiji-042-zheng:p003","quote":"武公十年，娶申侯女爲夫人，曰武姜。生太子寤生，生之難，及生，夫人弗愛。後生少子叔段，段生易，夫人愛之。二十七年，武公疾。夫人請公，欲立段爲太子，公弗聽。是歳，武公卒，寤生立，是爲莊公。"},{"paragraph_id":"c-shiji-042-zheng:p028","quote":"七年，鄭與晉盟鄢陵。八年，楚莊王以鄭與晉盟，來伐，圍鄭三月，鄭以城降楚。楚王入自皇門，鄭襄公肉袒掔羊以迎，曰：「孤不能事邊邑，使君王懷怒以及獘邑，孤之罪也。敢不惟命是聽。君王遷之江南，及以賜諸侯，亦惟命是聽。若君王不忘厲、宣王，桓、武公，哀不忍絶其社稷，錫不毛之地，使復得改事君王，孤之願也，然非所敢望也。敢布腹心，惟命是聽。」莊王爲卻三十里而後舍。楚群臣曰：「自郢至此，士大夫亦久勞矣。今得國捨之，何如？」莊王曰：「所爲伐，伐不服也。今已服，尚何求乎？」卒去。晉聞楚之伐鄭，發兵救鄭。其來持兩端，故遲，比至河，楚兵已去。晉將率或欲渡，或欲還，卒渡河。莊王聞，還撃晉。鄭反助楚，大破晉軍於河上。十年，晉來伐鄭，以其反晉而親楚也。"}],"rationale":"依本篇名字、是為、世系及連續事件暫接異稱；同諡不同國分開，建子勝與聲公勝不合併，如兄弟為譬喻不作親屬。述贊與正文不算獨立來源，省稱、古字與校勘仍待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-042-zheng:p002","text":"二歳，犬戎殺幽王於驪山下，并殺桓公。鄭人共立其子掘突，是爲武公。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-042-zheng:m002-0006","start":6,"end":8,"surface":"幽王","kind":"person","person_id":"cbr-p002098","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m002-0015","start":15,"end":17,"surface":"桓公","kind":"person","person_id":"cbr-p002095","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m002-0024","start":24,"end":26,"surface":"掘突","kind":"person","person_id":"cbr-p002111","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m002-0029","start":29,"end":31,"surface":"武公","kind":"person","person_id":"cbr-p002111","status":"contextual_provisional"}],"chapter_id":"c-shiji-042-zheng","book_id":"b-shiji-042","work_id":"w-shiji","source_id":"s-shiji-042-zheng"},{"id":"c-shiji-042-zheng:p003","text":"武公十年，娶申侯女爲夫人，曰武姜。生太子寤生，生之難，及生，夫人弗愛。後生少子叔段，段生易，夫人愛之。二十七年，武公疾。夫人請公，欲立段爲太子，公弗聽。是歳，武公卒，寤生立，是爲莊公。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-042-zheng:m003-0000","start":0,"end":2,"surface":"武公","kind":"person","person_id":"cbr-p002111","status":"contextual_provisi