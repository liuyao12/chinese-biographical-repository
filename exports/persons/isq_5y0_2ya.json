_mention_id":"c-jinshu-098-huanwen:p028:m0189","mention_ids":["c-jinshu-098-huanwen:p028:m0189"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-074-ws1536331","s-jinshu-098-ws2614273"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-074-huan-family:p022:m0128","start":128,"end":130,"surface":"陸始","kind":"person","person_id":"isq_5y0_2ya","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。","paragraph_id":"c-jinshu-074-huan-family:p022","chapter_id":"c-jinshu-074-huan-family"},{"id":"c-jinshu-098-huanwen:p028:m0189","start":189,"end":191,"surface":"陸始","kind":"person","person_id":"isq_5y0_2ya","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。","paragraph_id":"c-jinshu-098-huanwen:p028","chapter_id":"c-jinshu-098-huanwen"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-074-huan-family:p022","text":"秘字穆子。少有才氣，不倫於俗。初拜秘書郎，兄溫抑而不用。久之，為輔國將軍、宣城內史。時梁州刺史司馬勳叛入蜀，秘以本官監梁益二州征討軍事、假節。勳平，還郡。後為散騎常侍，徙中領軍。孝武帝初即位，妖賊盧竦入宮，秘與左衛將軍殷康俱入擊之。溫入朝，竊考竦事，收尚書陸始等，罹罪者甚眾。秘亦免官，居於宛陵，每憤憤有不平之色。溫疾篤，秘與溫子熙、濟等謀共廢沖。沖密知之，不敢入。頃溫氣絕，先遣力士拘錄熙、濟，而後臨喪。秘於是廢棄，遂居於墓所，放志田園，好遊山水。後起為散騎常侍，凡三表自陳。詔曰：「秘受遇先朝。是以延之。而頻有讓表，以棲尚告誠，兼有疾疢，省用增歎。可順其所執。」秘素輕沖，沖時貴盛，秘恥常侍位卑，故不應朝命，與謝安書及詩十首，辭理可觀，其文多引簡文帝之眄遇。先沖卒。長子蔚，官至散騎常侍、遊擊將軍。玄篡，以為醴陵王。","source_position":{"kind":"wikitext_codepoint_positions","raw_path":"sources/jinshu/wikisource-1536331-raw.wikitext","raw_start":4932,"raw_end":5339,"character_positions":[4934,4935,4936,4937,4938,4939,4940,4941,4942,4943,4944,4945,4946,4947,4948,4949,4950,4951,4952,4953,4954,4955,4956,4957,4958,4959,4960,4961,4962,4963,4964,4965,4966,4967,4968,4969,4970,4971,4972,4973,4974,4975,4976,4977,4978,4979,4980,4981,4982,4983,4984,4985,4986,4987,4988,4989,4990,4991,4992,4993,4994,4995,4996,4997,4998,4999,5000,5001,5002,5003,5004,5005,5006,5007,5008,5009,5010,5011,5012,5013,5014,5015,5016,5017,5018,5019,5020,5021,5022,5023,5024,5025,5026,5027,5028,5029,5030,5031,5032,5033,5034,5035,5073,5074,5075,5076,5077,5078,5079,5080,5081,5082,5083,5084,5085,5086,5087,5088,5089,5090,5091,5092,5093,5094,5095,5096,5097,5098,5099,5100,5101,5102,5103,5104,5105,5106,5107,5108,5109,5110,5111,5112,5113,5114,5115,5116,5117,5118,5119,5120,5121,5122,5123,5124,5125,5126,5127,5128,5129,5130,5131,5132,5133,5134,5135,5136,5137,5138,5139,5140,5141,5142,5143,5144,5145,5146,5147,5148,5149,5150,5151,5152,5153,5154,5155,5156,5157,5158,5159,5160,5161,5162,5163,5164,5165,5166,5167,5168,5169,5170,5171,5172,5173,5174,5175,5176,5177,5178,5179,5180,5181,5182,5183,5184,5185,5186,5187,5188,5189,5190,5191,5192,5193,5194,5195,5196,5197,5198,5199,5200,5201,5202,5203,5204,5205,5206,5207,5208,5209,5210,5211,5212,5213,5220,5221,5222,5223,5224,5225,5226,5227,5228,5229,5230,5231,5232,5233,5234,5235,5236,5237,5238,5239,5240,5241,5242,5243,5244,5245,5246,5247,5248,5249,5250,5251,5252,5253,5254,5255,5256,5257,5258,5261,5262,5263,5264,5265,5266,5267,5268,5269,5270,5271,5272,5273,5274,5275,5276,5277,5278,