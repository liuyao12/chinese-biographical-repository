n_id":"c-shiji-126-huaji:m019-0178","chapter_id":"c-shiji-126-huaji","paragraph_id":"c-shiji-126-huaji:p019","quote":"衛將軍"},{"mention_id":"c-shiji-126-huaji:m019-0206","chapter_id":"c-shiji-126-huaji","paragraph_id":"c-shiji-126-huaji:p019","quote":"大將軍"}]}],"source_mention_summary":[{"source_id":"s-shiji126-huaji","work_id":"w-shiji","book_id":"b-shiji-126","chapter_id":"c-shiji-126-huaji","mention_count":1,"mention_ids":["c-shiji-126-huaji:m019-0011"],"paragraph_ids":["c-shiji-126-huaji:p019"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji126-huaji"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji126-005","subject_person_id":"w1c_mpi_xgb","predicate":"brother","object_person_id":"udi_l0u_sbn","status":"source_attested","evidence":[{"chapter_id":"c-shiji-126-huaji","source_id":"s-shiji126-huaji","paragraph_id":"c-shiji-126-huaji:p019","quote":"武帝時，大將軍衛青者，衛后兄也，封為長平侯。從軍擊匈奴，至余吾水上而還，斬首捕虜，有功來歸，詔賜金千斤。將軍出宮門，齊人東郭先生以方士待詔公車，當道遮衛將軍車，拜謁曰：「願白事。」將軍止車前，東郭先生旁車言曰：「王夫人新得幸於上，家貧。今將軍得金千斤，誠以其半賜王夫人之親，人主聞之必喜。此所謂奇策便計也。」衛將軍謝之曰：「先生幸告之以便計，請奉教。」於是衛將軍乃以五百金為王夫人之親壽。王夫人以聞武帝。帝曰：「大將軍不知為此。」問之安所受計策，對曰：「受之待詔者東郭先生。」詔召東郭先生，拜以為郡都尉。東郭先生久待詔公車，貧困饑寒，衣敝，履不完。行雪中，履有上無下，足盡踐地。道中人笑之，東郭先生應之曰：「誰能履行雪中，令人視之，其上履也，其履下處乃似人足者乎？」及其拜為二千石，佩青緺出宮門，行謝主人。故所以同官待詔者，等比祖道於都門外。榮華道路，立名當世。此所謂衣褐懷寶者也。當其貧困時，人莫省視；至其貴也，乃爭附之。諺曰：「相馬失之瘦，相士失之貧。」其此之謂邪？"}],"qualifiers":{"source_term":"衛后兄也","relative_birth_order":{"older_person_id":"w1c_mpi_xgb","younger_person_id":"udi_l0u_sbn","operator":"lt","scope":"siblings","older_ordinal":null,"younger_ordinal":null}},"interpretation_note":"依原句明示親屬保存；未名者不補姓名，乳母不當皇帝生母，受幸不推婚姻。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"famil