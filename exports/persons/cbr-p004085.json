-zhang:m005-0030","start":30,"end":32,"surface":"舍人","kind":"person","person_id":"cbr-p004089","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m005-0043","start":43,"end":45,"surface":"蘇君","kind":"person","person_id":"cbr-p004085","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m005-0046","start":46,"end":48,"surface":"蘇君","kind":"person","person_id":"cbr-p004085","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m005-0080","start":80,"end":82,"surface":"蘇君","kind":"person","person_id":"cbr-p004085","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m005-0096","start":96,"end":98,"surface":"張儀","kind":"person","person_id":"cbr-p004084","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m005-0116","start":116,"end":118,"surface":"蘇君","kind":"person","person_id":"cbr-p004085","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m005-0135","start":135,"end":137,"surface":"蘇君","kind":"person","person_id":"cbr-p004085","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m005-0138","start":138,"end":140,"surface":"蘇君","kind":"person","person_id":"cbr-p004085","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m005-0143","start":143,"end":144,"surface":"儀","kind":"person","person_id":"cbr-p004084","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m005-0149","start":149,"end":151,"surface":"蘇君","kind":"person","person_id":"cbr-p004085","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m005-0153","start":153,"end":154,"surface":"儀","kind":"person","person_id":"cbr-p004084","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m005-0160","start":160,"end":162,"surface":"張儀","kind":"person","person_id":"cbr-p004084","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m005-0170","start":170,"end":172,"surface":"楚相","kind":"person","person_id":"cbr-p004087","status":"contextual_provisional"}],"chapter_id":"c-shiji-070-zhang","book_id":"b-shiji-070","work_id":"w-shiji","source_id":"s-shiji-070-zhang"},{"id":"c-shiji-070-zhang:p014","text":"「且夫諸侯之為從者，將以安社稷尊主彊兵顯名也。今從者一天下，約為昆弟，刑白馬以盟洹水之上，以相堅也。而親昆弟同父母，尚有爭錢財，而欲恃詐偽反覆蘇秦之餘謀，其不可成亦明矣。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-070-zhang:m014-0003","start":3,"end":5,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、未定身分或擬議婚姻，不補姓名、實受關係或成員。"},{"id":"c-shiji-070-zhang:m014-0051","start":51,"end":54,"surface":"親昆弟","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、未定身分或擬議婚姻，不補姓名、實受關係或成員。"},{"id":"c-shiji-070-zhang:m014-0055","start":55,"end":57,"surface":"父母","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、未定身分或擬議婚姻，不補姓名、實受關係或成員。"},{"id":"c-shiji-070-zhang:m014-0071","start":71,"end":73,"surface":"蘇秦","kind":"person","person_id":"cbr-p004085","status":"contextual_provisional"}],"chapter_id":"c-shiji-070-zhang","book_id":"b-shiji-070","work_id":"w-shiji","source_id":"s-shiji-070-zhang"},{"id":"c-shiji-070-zhang:p024","text":"張儀既出，未去，聞蘇秦死，乃說楚王曰：「秦地半天下，兵敵四國，被險帶河，四塞以為固。虎賁之士百餘萬，車千乘，騎萬匹，積粟如丘山。法令既明，士卒安難樂死，主明以嚴，將智以武，雖無出甲，席卷常山之險，必折天下之脊，天下有後服者先亡。且夫為從者，無以異於驅群羊而攻猛虎，虎之與羊不格明矣。今王不與猛虎而與群羊，臣竊以為大王之計過也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-070-zhang:m024-0000","start":0,"end":2,"surface":"張儀","kind":"person","person_id":"cbr-p004084","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m024-0009","start":9,"end":11,"surface":"蘇秦","kind":"person","person_id":"cbr-p004085","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m024-0015","start":15,"end":17,"surface":"楚王","kind":"person","person_id":"cbr-p004103","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m024-0042","start":42,"end":46,"surface":"虎賁之士","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或擬議質子婚姻，未證已實行，姓名與身分不補造。"},{"id":"c-shiji-070-zhang:m024-0069","start":69,"end":71,"surface":"士卒","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或擬議質子婚姻，未證已實行，姓名與身分不補造。"},{"id":"c-shiji-070-zhang:m024-0116","start":116,"end":119,"surface":"為從者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或擬議質子婚姻，未證已實行，姓名與身分不補造。"},{"id":"c-shiji-070-zhang:m024-0142","start":142,"end":143,"surface":"王","kind":"person","person_id":"cbr-p004103","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m024-0156","start":156,"end":158,"surface":"大王","kind":"person","person_id":"cbr-p004103","status":"contextual_provisional"}],"chapter_id":"c-shiji-070-zhang","book_id":"b-shiji-070","work_id":"w-shiji","source_id":"s-shiji-070-zhang"},{"id":"c-shiji-070-zhang:p031","text":"「凡天下而以信約從親相堅者蘇秦，封武安君，相燕，即陰與燕王謀伐破齊而分其地；乃詳有罪出走入齊，齊王因受而相之；居二年而覺，齊王大怒，車裂蘇秦於市。夫以一詐偽之蘇秦，而欲經營天下，混一諸侯，其不可成亦明矣。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-070-zhang:m031-0013","start":13,"end":15,"surface":"蘇秦","kind":"person","person_id":"cbr-p004085","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m031-0017","start":17,"end":20,"surface":"武安君","kind":"person","person_id":"cbr-p004085","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m031-0027","start":27,"end":29,"surface":"燕王","kind":"person","person_id":"cbr-p004117","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m031-0047","start":47,"end":49,"surface":"齊王","kind":"person","person_id":"cbr-p004118","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m031-0061","start":61,"end":63,"surface":"齊王","kind":"person","person_id":"cbr-p004118","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m031-0068","start":68,"end":70,"surface":"蘇秦","kind":"person","person_id":"cbr-p004085","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m031-0079","start":79,"end":81,"surface":"蘇秦","kind":"person","person_id":"cbr-p004085","status":"contextual_provisional"}],"chapter_id":"c-shiji-070-zhang","book_id":"b-shiji-070","work_id":"w-shiji","source_id":"s-shiji-070-zhang"},{"id":"c-shiji-070-zhang:p043","text":"「凡大王之所信為從者恃蘇秦。蘇秦熒惑諸侯，以是為非，以非為是，欲反齊國，而自令車裂於市。夫天下之不可一亦明矣。今楚與秦為昆弟之國，而韓梁稱為東藩之臣，齊獻魚鹽之地，此斷趙之右臂也。夫斷右臂而與人鬬，失其黨而孤居，求欲毋危，豈可得乎？","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-070-zhang:m043-0002","start":2,"end":4,"surface":"大王","kind":"person","person_id":"cbr-p004114","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m043-0011","start":11,"end":13,"surface":"蘇秦","kind":"person","person_id":"cbr-p004085","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m043-0014","start":14,"end":16,"surface":"蘇秦","kind":"person","person_id":"cbr-p004085","status":"contextual_provisional"}],"chapter_id":"c-shiji-070-zhang","book_id":"b-shiji-070","work_id":"w-shiji","source_id":"s-shiji-070-zhang"},{"id":"c-shiji-070-zhang:p059","text":"太史公曰：三晉多權變之士，夫言從衡彊秦者大抵皆三晉之人也。夫張儀之行事甚於蘇秦，然世惡蘇秦者，以其先死，而儀振暴其短以扶其說，成其衡道。要之，此兩人真傾危之士哉！","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-070-zhang:m059-0000","start":0,"end":3,"surface":"太史公","kind":"person","person_id":"cbr-p004141","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m059-0030","start":30,"end":32,"surface":"張儀","kind":"person","person_id":"cbr-p004084","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m059-0037","start":37,"end":39,"surface":"蘇秦","kind":"person","person_id":"cbr-p004085","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m059-0043","start":43,"end":45,"surface":"蘇秦","kind":"person","person_id":"cbr-p004085","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m059-0053","start":53,"end":54,"surface":"儀","kind":"person","person_id":"cbr-p004084","status":"contextual_provisional"}],"chapter_id":"c-shiji-070-zhang","book_id":"b-shiji-070","work_id":"w-shiji","source_id":"s-shiji-070-zhang"}],"sources":[{"chapter_id":"c-shiji-070-zhang","work_id":"w-shiji","boo