ence":[{"work_id":"w-jinshu","book_id":"b-jinshu-064","source_id":"s-jinshu-064-ws2622004-rendered-wudi-sons","chapter_id":"c-jinshu-064-wudi-sons-rendered","paragraph_id":"c-jinshu-064-wudi-sons-rendered:p013","quote":"清河康王遐，字深度，美容儀，有精彩，武帝愛之。既受封，出繼叔父城陽哀王兆。太康十年，封渤海郡，曆右將軍、散騎常侍、前將軍。元康初，進撫軍將軍，加侍中，遐長而懦弱，無所是非。性好內，不能接士大夫。及楚王瑋之舉兵也，使遐收衛瓘，而瓘故吏榮晦遂盡殺瓘子孫，遐不能禁，為世所尤。永康元年薨，時年二十八。四子：覃、籥、銓、端。覃嗣立。","subject_person_mention_id":"c-jinshu-064-wudi-sons-rendered:p013:m0150","object_person_mention_id":"c-jinshu-064-wudi-sons-rendered:p013:m0000"}],"source_assertion_id":"a-jin064-qin-father-xia","interpretation_note":"依本源明示生父接既有司馬鈞家族；ID字母只為唯一子支位置，不代表出生排行。收繼與母系另存，不改生父。","reviewer":"Codex（AI 代理）","parent_person_id":"dkn_ge4_286_AAAAIAF"}}],"source_mention_summary":[{"source_id":"s-jinshu-064-ws2622004-rendered-wudi-sons","work_id":"w-jinshu","book_id":"b-jinshu-064","chapter_id":"c-jinshu-064-wudi-sons-rendered","raw_mention_count":1,"mention_ids":["c-jinshu-064-wudi-sons-rendered:p014:m0139"],"paragraph_ids":["c-jinshu-064-wudi-sons-rendered:p014"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-064-wudi-sons-rendered:p014:m0139","mention_ids":["c-jinshu-064-wudi-sons-rendered:p014:m0139"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-064-ws2622004-rendered-wudi-sons"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin064-qin-mother-zhou","subject_person_id":"dkn_ge4_286_AAAAIAFA","predicate":"mother","object_person_id":"7c9_e07_973_A","status":"source_attested","qualifiers":{"source_term":"康王正妃周氏所生","source_clause_binding":{"kind":"received_sima_family_roles","source_scope":"c-jinshu-064-wudi-sons-rendered","role":"qin-mother-zhou"}},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-064","source_id":"s-jinshu-064-ws2622004-rendered-wudi-sons","chapter_id":"c-jinshu-064-wudi-sons-rendered","paragraph_id":"c-jinshu-064-wudi-sons-rendered:p014","quote":"及沖太孫薨，齊王冏表曰：「東宮曠然，塚嗣莫繼。天下大業，帝王神器，必建儲副，以固洪基。今者後宮未有孕育，不可庶幸將來而虛天緒，非祖宗之遺志，社稷之長計也。禮，兄弟之子猶子，故漢成無嗣，繼由定陶；孝和之絕，安以紹興。此先王之令典，往代之成式也。清河王覃神姿岐嶷，慧智早成，康王正妃周氏所生，先帝眾孫之中，於今為嫡。昔薄姬賢明，文則承位。覃外祖恢世載名德，覃宜奉宗廟之重，統無窮之祚，以甯四海顒顒之望。覃兄弟雖並出紹，可簡令淑還為國胤，不替其嗣。輒諮大將軍穎及群公卿士，咸同大願。請具禮儀，擇日迎拜。」遂立覃為皇太子。既而河間王顒協遷大駕，表成都王穎為皇太弟，廢覃復為清河王。初，覃為清河世子，所佩金鈴欻生隱起如麻粟，祖母陳太妃以為不祥，毀而賣之。占者以金是晉行大興之祥，覃為皇胤，是其瑞也。毀而賣之，象覃見廢不終之驗也。永嘉初，前北軍中候任城呂雍、度支校尉陳顏等謀立覃為太子，事覺，幽于金墉城。未幾，被害，時年十四，葬以庶人禮。","subject_person_mention_id":"c-jinshu-064-wudi-sons-rendered:p014:m0121","object_person_mention_id":"c-jinshu-064-wudi-sons-rendered:p014:m0139"}],"reviewer":"Codex（AI代理）","human_reviewed":false,"model":null},{"id":"a-jin064-zhou-father-hui","subject_person_id":"7c9_e07_973_A","predicate":"father","object_person_id":"7c9_e07_973","status":"contextual_provisional","qualifiers":{"source_term":"康王正妃周氏所生","source_clause_binding":{"kind":"received_sima_family_roles","source_scope":"c-jinshu-064-wudi-sons-rendered","role":"zhou-father-hui"},"source_composed_parent_bridge":{"basis":["覃生母周氏","覃外祖恢"],"literal_father_sentence":false,"kind":"mother_and_maternal_grandfather_same_child","mother_assertion_id":"a-jin064-qin-mother-zhou","maternal_grandfather_assertion_id":"a-jin064-qin-maternal-grandfather-hui","child_person_id":"dkn_ge4_286_AAAAIAFA","mother_person_id":"7c9_e07_973_A","maternal_grandfather_person_id":"7c9_e07_973","same_child":true,"same_mother":true,"lineage":"maternal","derived":true,"stat