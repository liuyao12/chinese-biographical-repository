{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p001805","canonical_person_id":"pai_09n_rza","id_aliases":["cbr-p001805"],"identity_policy":"contextual_provisional","person_ids":["pai_09n_rza"],"persons":[{"id":"pai_09n_rza","label":"郤鉤（三郤記事）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"郤鉤","mention_ids":["c-shiji-039-jin:m112-0222"]}],"evidence":[{"mention_id":"c-shiji-039-jin:m112-0222","chapter_id":"c-shiji-039-jin","paragraph_id":"c-shiji-039-jin:p112","quote":"郤鉤"}],"id_aliases":["cbr-p001805"]}],"source_mention_summary":[{"source_id":"s-shiji-039-jin","work_id":"w-shiji","book_id":"b-shiji-039","chapter_id":"c-shiji-039-jin","mention_count":1,"mention_ids":["c-shiji-039-jin:m112-0222"],"paragraph_ids":["c-shiji-039-jin:p112"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-039-jin"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-039-jin:m112-0222","start":222,"end":224,"surface":"郤鉤","kind":"person","person_id":"pai_09n_rza","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p112","chapter_id":"c-shiji-039-jin"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji039-243","person_id":"pai_09n_rza","surfaces":["郤鉤"],"scope":"same_chapter","chapter_ids":["c-shiji-039-jin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-039-jin:p112","quote":"厲公多外嬖姬，歸，欲盡去群大夫而立諸姬兄弟。寵姬兄曰胥童，嘗與郤至有怨，及欒書又怨郤至不用其計而遂敗楚，乃使人閒謝楚。楚來詐厲公曰：「鄢陵之戰，實至召楚，欲作亂，内子周立之。會與國不具，是以事不成。」厲公告欒書。欒書曰：「其殆有矣！願公試使人之周微考之。」果使郤至於周。欒書又使公子周見郤至，郤至不知見賣也。厲公驗之，信然，遂怨郤至，欲殺之。八年，厲公獵，與姬飲，郤至殺豕奉進，宦者奪之。郤至射殺宦者。公怒，曰：「季子欺予！」將誅三郤，未發也。郤鉤欲攻公，曰：「我雖死，公亦病矣。」郤至曰：「信不反君，智不害民，勇不作亂。失此三者，誰與我？我死耳！」十二月壬午，公令胥童以兵八百人襲攻殺三郤。胥童因以劫欒書、中行偃于朝，曰：「不殺二子，患必及公。」公曰：「一旦殺三卿，寡人不忍益也。」對曰：「人將忍君。」公弗聽，謝欒書等以誅郤氏罪：「大夫復位。」二子頓首曰：「幸甚幸甚！」公使胥童爲卿。閏月乙卯，厲公游匠驪氏，欒書、中行偃以其黨襲捕厲公，囚之，殺胥童，而使人迎公子周于周而立之，是爲悼公。"}],"rationale":"按本篇明示名與稱號、晉世系與具體事件暫定所列提及同指；附各段原文，未按同字短名全域合併；紀年與版本差異待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-039-jin:p112","text":"厲公多外嬖姬，歸，欲盡去群大夫而立諸姬兄弟。寵姬兄曰胥童，嘗與郤至有怨，及欒書又怨郤至不用其計而遂敗楚，乃使人閒謝楚。楚來詐厲公曰：「鄢陵之戰，實至召楚，欲作亂，内子周立之。會與國不具，是以事不成。」厲公告欒書。欒書曰：「其殆有矣！願公試使人之周微考之。」果使郤至於周。欒書又使公子周見郤至，郤至不知見賣也。厲公驗之，信然，遂怨郤至，欲殺之。八年，厲公獵，與姬飲，郤至殺豕奉進，宦者奪之。郤至射殺宦者。公怒，曰：「季子欺予！」將誅三郤，未發也。郤鉤欲攻公，曰：「我雖死，公亦病矣。」郤至曰：「信不反君，智不害民，勇不作亂。失此三者，誰與我？我死耳！」十二月壬午，公令胥童以兵八百人襲攻殺三郤。胥童因以劫欒書、中行偃于朝，曰：「不殺二子，患必及公。」公曰：「一旦殺三卿，寡人不忍益也。」對曰：「人將忍君。」公弗聽，謝欒書等以誅郤氏罪：「大夫復位。」二子頓首曰：「幸甚幸甚！」公使胥童爲卿。閏月乙卯，厲公游匠驪氏，欒書、中行偃以其黨襲捕厲公，囚之，殺胥童，而使人迎公子周于周而立之，是爲悼公。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m112-0000","start":0,"end":2,"surface":"厲公","kind":"person","person_id":"f42_zl0_lkq","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m112-0003","start":3,"end":6,"surface":"外嬖姬","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m112-0017","start":17,"end":21,"surface":"諸姬兄弟","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m112-0022","start":22,"end":25,"surface":"寵姬兄","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m112-0026","start":26,"end":28,"surface":"胥童","kind":"person","person_id":"4ym_j77_5al","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m112-0031","start":31,"end":33,"surface":"郤至","kind":"