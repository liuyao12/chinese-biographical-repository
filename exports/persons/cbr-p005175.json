u:m005-0026"],"paragraph_ids":["c-shiji-057-zhou:p005"],"passage_count":1},{"source_id":"s-shiji-093-hanlu","work_id":"w-shiji","book_id":"b-shiji-093","chapter_id":"c-shiji-093-hanlu","mention_count":1,"mention_ids":["c-shiji-093-hanlu:m005-0046"],"paragraph_ids":["c-shiji-093-hanlu:p005"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-008-gaozu"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-008-gaozu:m064-0032","start":32,"end":34,"surface":"趙利","kind":"person","person_id":"cbr-p000798","status":"contextual_provisional","paragraph_id":"c-shiji-008-gaozu:p064","chapter_id":"c-shiji-008-gaozu"},{"id":"c-shiji-008-gaozu:m075-0002","start":2,"end":4,"surface":"趙利","kind":"person","person_id":"cbr-p000798","status":"contextual_provisional","paragraph_id":"c-shiji-008-gaozu:p075","chapter_id":"c-shiji-008-gaozu"},{"id":"c-shiji-008-gaozu:m083-0083","start":83,"end":85,"surface":"趙利","kind":"person","person_id":"cbr-p000798","status":"contextual_provisional","paragraph_id":"c-shiji-008-gaozu:p083","chapter_id":"c-shiji-008-gaozu"},{"id":"c-shiji-057-zhou:m005-0026","start":26,"end":28,"surface":"趙利","kind":"person","person_id":"cbr-p003488","status":"contextual_provisional","paragraph_id":"c-shiji-057-zhou:p005","chapter_id":"c-shiji-057-zhou"},{"id":"c-shiji-093-hanlu:m005-0046","start":46,"end":48,"surface":"趙利","kind":"person","person_id":"cbr-p005175","status":"contextual_provisional","paragraph_id":"c-shiji-093-hanlu:p005","chapter_id":"c-shiji-093-hanlu"}],"relations":[],"title_holdings":[{"id":"th-shiji093-009","person_id":"cbr-p005175","title":"王","kind":"royal_rank","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-093-hanlu","source_id":"s-shiji-093-hanlu","paragraph_id":"c-shiji-093-hanlu:p005","quote":"七年冬，上自往擊，破信軍銅鞮，斬其將王喜。信亡走匈奴。（與）其與白土人曼丘臣、王黃等立趙苗裔趙利為王，復收信敗散兵，而與信及冒頓謀攻漢。匈奴仗左右賢王將萬餘騎與王黃等屯廣武以南，至晉陽，與漢兵戰，漢大破之，追至于離石，復破之。匈奴復聚兵樓煩西北，漢令車騎擊破匈奴。匈奴常敗走，漢乘勝追北，聞冒頓居代（上）谷，高皇帝居晉陽，使人視冒頓，還報曰「可擊」。上遂至平城。上出白登，匈奴騎圍上，上乃使人厚遺閼氏。閼氏乃說冒頓曰：「今得漢地，猶不能居；且兩主不相緱」居七日，胡騎稍引去。時天大霧，漢使人往來，胡不覺。護軍中尉陳平言上曰：「胡者全兵，請令彊弩傅兩矢外向，徐行出圍。」入平城，漢救兵亦到，胡騎遂解去。漢亦罷兵歸。韓信為匈奴將兵往來擊邊。"}],"attestations":[{"id":"th-shiji093-009:a001","paragraph_id":"c-shiji-093-hanlu:p005","start":49,"end":50,"surface":"王","person_mention_id":"c-shiji-093-hanlu:m005-0046","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":"七年冬","evidence":[{"chapter_id":"c-shiji-093-hanlu","source_id":"s-shiji-093-hanlu","paragraph_id":"c-shiji-093-hanlu:p005","quote":"七年冬，上自往擊，破信軍銅鞮，斬其將王喜。信亡走匈奴。（與）其與白土人曼丘臣、王黃等立趙苗裔趙利為王，復收信敗散兵，而與信及冒頓謀攻漢。匈奴仗左右賢王將萬餘騎與王黃等屯廣武以南，至晉陽，與漢兵戰，漢大破之，追至于離石，復破之。匈奴復聚兵樓煩西北，漢令車騎擊破匈奴。匈奴常敗走，漢乘勝追北，聞冒頓居代（上）谷，高皇帝居晉陽，使人視冒頓，還報曰「可擊」。上遂至平城。上出白登，匈奴騎圍上，上乃使人厚遺閼氏。閼氏乃說冒頓曰：「今得漢地，猶不能居；且兩主不相緱」居七日，胡騎稍引去。時天大霧，漢使人往來，胡不覺。護軍中尉陳平言上曰：「胡者全兵，請令彊弩傅兩矢外向，徐行出圍。」入平城，漢救兵亦到，胡騎遂解去。漢亦罷兵歸。韓信為匈奴將兵往來擊邊。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"按實授、自立與用稱保存；許韓王在先不作已授。明示相對年月保持原文，死亡、降漢、失侯之後裔敘事不替本人任期補終點。虜綰原字保留，以本段盧綰主語承接授爵，未核底本影像。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji057-021","person_id":"cbr-p003488","surfaces":["趙利"],"scope":"same_chapter","chapter_ids":["c-shiji-057-zhou"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-057-zhou:p005","quote":"擊陳豨，屠馬邑。所將卒斬豨將軍乘馬絺。擊韓信、陳豨、趙利軍於樓煩，破之。得豨將宋最、鴈門守圂。因轉攻得雲中守遬、丞相箕肆、將勳。定鴈門郡十七縣，雲中郡十二縣。因復擊豨靈丘，破之，斬豨，得豨丞相程縱、將軍陳武、都尉高肆。定代郡九縣。"}],"rationale":"按明示姓名、軍事近接、父子承爵與局部皇帝敘事暫接。周勃和勝之的絳侯分開，亞夫條侯與平曲支不混；代地韓信依韓王信近接而不接淮陰侯。未名人物、單名官員不補姓，校勘字不作定本，相術預言不作史實已驗。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji093-025","person_id":"cbr-p005175","scope":"same_chapter","chapter_ids":["c-shiji-093-hanlu"],"status":"contextual_provisional","rationale":"明示姓名及局部敘事承接；引古、未名者及短稱另存候選。臧茶與臧荼、高后與呂后待跨稱判讀，不因近形或熟知姓名自動合併。","reviewer":"Codex（AI 代理）","surfaces":["趙利"],"evidence":[{"paragraph_id":"c-shiji-093-hanlu:p005","quote":"七年冬，上自往擊，破信軍銅鞮，斬其將王喜。信亡走匈奴。（與）其與白土人曼丘臣、王黃等立趙苗裔趙利為王，復收信敗散兵，而與信及冒頓謀攻漢。匈奴仗左右賢王將萬餘騎與王黃等屯廣武以南，至晉陽，與漢兵戰，漢大破之，追至于離石，復破之。匈奴復聚兵樓煩西北，漢令車騎擊破匈奴。匈奴常敗走，漢乘勝追北，聞冒頓居代（上）谷，高皇帝居晉陽，使人視冒頓，還報曰「可擊」。上遂至平城。上出白登，匈奴騎圍上，上乃使人厚遺閼氏。閼氏乃說冒頓曰：「今得漢地，猶不能居；且兩主不相緱」居七日，胡騎稍引去。時天大霧，漢使人往來，胡不覺。護軍中尉陳平言上曰：「胡者全兵，請令彊弩傅兩矢外向，徐行出圍。」入平城，漢救兵亦到，胡騎遂解去。漢亦罷兵歸。韓信為匈奴將兵往來擊邊。"}]}],"equivalence_decisions":[{"id":"eq-shiji057-zhaoli","person_ids":["cbr-p000798","cbr-p003488"],"canonical_person_id":"cbr-p000798","scope":"cross_chapter","chapter_ids":["c-shiji-008-gaozu","c-shiji-057-zhou"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-008-gaozu","source_id":"s-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p083","quote":"十一月，高祖自布軍至長安。十二月，高祖曰：「秦始皇帝、楚隱王陳涉、魏安釐王、齊緡王、趙悼襄王皆絕無後，予守冢各十家，秦皇帝二十家，魏公子無忌五家。」赦代地吏民為陳豨、趙利所劫掠者，皆赦之。陳豨降將言豨反時，燕王盧綰使人之豨所，與陰謀。上使辟陽侯迎綰，綰稱病。辟陽侯歸，具言綰反有端矣。二月，使樊噲、周勃將兵擊燕王綰，赦燕吏民與反者。立皇子建為燕王。","mention_ids":["c-shiji-008-gaozu:m083-0083"]},{"chapter_id":"c-shiji-057-zhou","source_id":"s-shiji-057-zhou","paragraph_id":"c-shiji-057-zhou:p005","quote":"擊陳豨，屠馬邑。所將卒斬豨將軍乘馬絺。擊韓信、陳豨、趙利軍於樓煩，破之。得豨將宋最、鴈門守圂。因轉攻得雲中守遬、丞相箕肆、將勳。定鴈門郡十七縣，雲中郡十二縣。因復擊豨靈丘，破之，斬豨，得豨丞相程縱、將軍陳武、都尉高肆。定代郡九縣。","mention_ids":["c-shiji-057-zhou:m005-0026"]}],"rationale":"同為陳豨代地軍事組合中的趙利，姓名、地區與共同人物暫接。 已發ID、原字與各篇證據保留，身份判讀不代替年代、史實或來源優先；同書各篇不當獨立見證。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"eq-shiji093-li","person_ids":["cbr-p000798","cbr-p005175"],"canonical_person_id":"cbr-p000798","scope":"cross_chapter","chapter_ids":["c-shiji-008-gaozu","c-shiji-093-hanlu"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-008-gaozu","source_id":"s-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p064","quote":"七年，匈奴攻韓王信馬邑，信因與謀反太原。白土曼丘臣、王黃立故趙將趙利為王以反，高祖自往擊之。會天寒，士卒墮指者什二三，遂至平城。匈奴圍我平城，七日而後罷去。令樊噲止定代地。立兄劉仲為代王。","mention_ids":["c-shiji-008-gaozu:m064-0032"]},{"chapter_id":"c-shiji-093-hanlu","source_id":"s-shiji-093-hanlu","paragraph_id":"c-shiji-093-hanlu:p005","quote":"七年冬，上自往擊，破信軍銅鞮，斬其將王喜。信亡走匈奴。（與）其與白土人曼丘臣、王黃等立趙苗裔趙利為王，復收信敗散兵，而與信及冒頓謀攻漢。匈奴仗左右賢王將萬餘騎與王黃等屯廣武以南，至晉陽，與漢兵戰，漢大破之，追至于離石，復破之。匈奴復聚兵樓煩西北，漢令車騎擊破匈奴。匈奴常敗走，漢乘勝追北，聞冒頓居代（上）谷，高皇帝居晉陽，使人視冒頓，還報曰「可擊」。上遂至平城。上出白登，匈奴騎圍上，上乃使人厚遺閼氏。閼氏乃說冒頓曰：「今得漢地，猶不能居；且兩主不相緱」居七日，胡騎稍引去。時天大霧，漢使人往來，胡不覺。護軍中尉陳平言上曰：「胡者全兵，請令彊弩傅兩矢外向，徐行出圍。」入平城，漢救兵亦到，胡騎遂解去。漢亦罷兵歸。韓信為匈奴將兵往來擊邊。","mention_ids":["c-shiji-093-hanlu:m005-0046"]}],"rationale":"曼丘臣王黃所立趙利同一事件相配，故趙將與趙苗裔敘述均保留。 各篇原字、原文與已發ID保留，同書不視為獨立見證；同指不確證所有紀年、任職、親屬或敘事，不按全域同名批量改號。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-008-gaozu:p064","text":"七年，匈奴攻韓王信馬邑，信因與謀反太原。白土曼丘臣、王黃立故趙將趙利為王以反，高祖自往擊之。會天寒，士卒墮指者什二三，遂至平城。匈奴圍我平城，七日而後罷去。令樊噲止定代地。立兄劉仲為代王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m064-0006","start":6,"end":9,"surface":"韓王信","kind":"person","person_id":"cbr-p000774","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m064-0012","start":12,"end":13,"surface":"信","kind":"person","person_id":"cbr-p000774","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m064-0022","start":22,"end":25,"surface":"曼丘臣","kind":"person","person_id":"cbr-p000796","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m064-0026","start":26,"end":28,"surface":"王黃","kind":"person","person_id":"cbr-p000797","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m064-0032","start":32,"end":34,"surface":"趙利","kind":"person","person_id":"cbr-p000798","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m064-0039","start":39,"end":41,"surface":"高祖","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m064-0079","start":79,"end":81,"surface":"樊噲","kind":"person","person_id":"cbr-p000691","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m064-0088","start":88,"end":90,"surface":"劉仲","kind":"person","person_id":"cbr-p000799","status":"contextual_provisional"}],"chapter_id":"c-shiji-008-gaozu","book_id":"b-shiji-008","work_id":"w-shiji","source_id":"s-shiji-008-gaozu"},{"id":"c-shiji-008-gaozu:p075","text":"豨將趙利守東垣，高祖攻之，不下。月餘，卒罵高祖，高祖怒。城降，令出罵者斬之，不罵者原之。於是乃分趙山北，立子恒以為代王，都晉陽。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m075-0000","start":0,"end":1,"surface":"豨","kind":"person","person_id":"cbr-p000801","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m075-0002","start":2,"end":4,"surface":"趙利","kind":"person","person_id":"cbr-p000798","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m075-0008","start":8,"end":10,"surface":"高祖","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m075-0021","start":21,"end":23,"surface":"高祖","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m075-0024","start":24,"end":26,"surface":"高祖","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m075-0054","start":54,"end":55,"surface":"恒","kind":"person","person_id":"cbr-p000806","status":"contextual_provisional"}],"chapter_id":"c-shiji-008-gaozu","book_id":"b-shiji-008","work_id":"w-shiji","source_id":"s-shiji-008-gaozu"},{"id":"c-shiji-008-gaozu:p083","text":"十一月，高祖自布軍至長安。十二月，高祖曰：「秦始皇帝、楚隱王陳涉、魏安釐王、齊緡王、趙悼襄王皆絕無後，予守冢各十家，秦皇帝二十家，魏公子無忌五家。」赦代地吏民為陳豨、趙利所劫掠者，皆赦之。陳豨降將言豨反時，燕王盧綰使人之豨所，與陰謀。上使辟陽侯迎綰，綰稱病。辟陽侯歸，具言綰反有端矣。二月，使樊噲、周勃將兵擊燕王綰，赦燕吏民與反者。立皇子建為燕王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m083-0004","start":4,"end":6,"surface":"高祖","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m083-0007","start":7,"end":9,"surface":"布軍","kind":"person","person_id":"cbr-p000656","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m083-0017","start":17,"end":19,"surface":"高祖","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m083-0022","start":22,"end":26,"surface":"秦始皇帝","kind":"person","person_id":"cbr-p000533","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m083-0030","start":30,"end":32,"surface":"陳涉","kind":"person","person_id":"cbr-p000598","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m083-0033","start":33,"end":37,"surface":"魏安釐王","kind":"person","person_id":"cbr-p000811","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m083-0038","start":38,"end":41,"surface":"齊緡王","kind":"person","person_id":"cbr-p000812","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m083-0042","start":42,"end":46,"surface":"趙悼襄王","kind":"person","person_id":"cbr-p000813","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m083-0058","start":58,"end":61,"surface":"秦皇帝","kind":"person","person_id":"cbr-p000533","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m083-0065","start":65,"end":70,"surface":"魏公子無忌","kind":"person","person_id":"cbr-p000532","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m083-0080","start":80,"end":82,"surface":"陳豨","kind":"person","person_id":"cbr-p000801","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m083-0083","start":83,"end":85,"surface":"趙利","kind":"person","person_id":"cbr-p000798","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m083-0094","start":94,"end":96,"surface":"陳豨","kind":"person","person_id":"cbr-p000801","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m083-0099","start":99,"end":100,"surface":"豨","kind":"person","person_id":"cbr-p000801","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m083-0105","start":105,"end":107,"surface":"盧綰","kind":"person","person_id":"cbr-p000780","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m083-0110","start":110,"end":111,"surface":"豨","kind":"person","person_id":"cbr-p000801","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m083-0119","start":119,"end":122,"surface":"辟陽侯","kind":"person","person_id":"cbr-p000814","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m083-0123","start":123,"end":124,"surface":"綰","kind":"person","person_id":"cbr-p000780","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m083-0125","start":125,"end":126,"surface":"綰","kind":"person","person_id":"cbr-p000780","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m083-0129","start":129,"end":132,"surface":"辟陽侯","kind":"person","person_id":"cbr-p000814","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m083-0136","start":136,"end":137,"surface":"綰","kind":"person","person_id":"cbr-p000780","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m083-0146","start":146,"end":148,"surface":"樊噲","kind":"person","person_id":"cbr-p000691","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m083-0149","start":149,"end":151,"surface":"周勃","kind":"person","person_id":"cbr-p000805","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m083-0156","start":156,"end":157,"surface":"綰","kind":"person","person_id":"cbr-p000780","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m083-0167","start":167,"end":170,"surface":"皇子建","kind":"person","person_id":"cbr-p000815","status":"contextual_provisional"}],"chapter_id":"c-shiji-008-gaozu","book_id":"b-shiji-008","work_id":"w-shiji","source_id":"s-shiji-008-gaozu"},{"id":"c-shiji-057-zhou:p005","text":"擊陳豨，屠馬邑。所將卒斬豨將軍乘馬絺。擊韓信、陳豨、趙利軍於樓煩，破之。得豨將宋最、鴈門守圂。因轉攻得雲中守遬、丞相箕肆、將勳。定鴈門郡十七縣，雲中郡十二縣。因復擊豨靈丘，破之，斬豨，得豨丞相程縱、將軍陳武、都尉高肆。定代郡九縣。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-057-zhou:m005-0001","start":1,"end":3,"surface":"陳豨","kind":"person","person_id":"cbr-p003486","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m005-0008","start":8,"end":11,"surface":"所將卒","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者、假設侯嗣、職署或未定回指；不補姓名、親屬成員或爵位所指。"},{"id":"c-shiji-057-zhou:m005-0012","start":12,"end":13,"surface":"豨","kind":"person","person_id":"cbr-p003486","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m005-0015","start":15,"end":18,"surface":"乘馬絺","kind":"person","person_id":"cbr-p003487","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m005-0020","start":20,"end":22,"surface":"韓信","kind":"person","person_id":"cbr-p003485","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m005-0023","start":23,"end":25,"surface":"陳豨","kind":"person","person_id":"cbr-p003486","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m005-0026","start":26,"end":28,"surface":"趙利","kind":"person","person_id":"cbr-p003488","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m005-0037","start":37,"end":38,"surface":"豨","kind":"person","person_id":"cbr-p003486","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m005-0039","start":39,"end":41,"surface":"宋最","kind":"person","person_id":"cbr-p003489","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m005-0042","start":42,"end":46,"surface":"鴈門守圂","kind":"person","person_id":"cbr-p003490","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m005-0051","start":51,"end":55,"surface":"雲中守遬","kind":"person","person_id":"cbr-p003491","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m005-0058","start":58,"end":60,"surface":"箕肆","kind":"person","person_id":"cbr-p003492","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m005-0062","start":62,"end":63,"surface":"勳","kind":"person","person_id":"cbr-p003493","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m005-0082","start":82,"end":83,"surface":"豨","kind":"person","person_id":"cbr-p003486","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m005-0090","start":90,"end":91,"surface":"豨","kind":"person","person_id":"cbr-p003486","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m005-0093","start":93,"end":94,"surface":"豨","kind":"pers