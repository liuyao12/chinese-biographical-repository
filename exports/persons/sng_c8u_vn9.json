_provisional"},{"id":"c-shiji-067-disciples:m001-0004","start":4,"end":9,"surface":"受業身通者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者、氏族或未定指代，尚未補姓名及成員。"},{"id":"c-shiji-067-disciples:m001-0017","start":17,"end":21,"surface":"異能之士","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者、氏族或未定指代，尚未補姓名及成員。"},{"id":"c-shiji-067-disciples:m001-0026","start":26,"end":28,"surface":"顏淵","kind":"person","person_id":"dng_dw6_2qy_A","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0029","start":29,"end":32,"surface":"閔子騫","kind":"person","person_id":"we8_mkq_luc","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0033","start":33,"end":36,"surface":"冉伯牛","kind":"person","person_id":"n7v_qo9_v4f","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0037","start":37,"end":39,"surface":"仲弓","kind":"person","person_id":"5bo_dxd_69k_A","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0043","start":43,"end":45,"surface":"冉有","kind":"person","person_id":"wnp_vk6_qhe","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0046","start":46,"end":48,"surface":"季路","kind":"person","person_id":"cgc_imx_hn5","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0052","start":52,"end":54,"surface":"宰我","kind":"person","person_id":"4uh_n5r_0id","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0055","start":55,"end":57,"surface":"子貢","kind":"person","person_id":"dpn_mmt_rm9","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0061","start":61,"end":63,"surface":"子游","kind":"person","person_id":"mqt_zhu_byy","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0064","start":64,"end":66,"surface":"子夏","kind":"person","person_id":"z8l_wje_08d","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0067","start":67,"end":68,"surface":"師","kind":"person","person_id":"482_ly0_otk","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0071","start":71,"end":72,"surface":"參","kind":"person","person_id":"c7w_nyj_95u","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0075","start":75,"end":76,"surface":"柴","kind":"person","person_id":"b7o_fu7_sjf","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0079","start":79,"end":80,"surface":"由","kind":"person","person_id":"cgc_imx_hn5","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0083","start":83,"end":84,"surface":"回","kind":"person","person_id":"dng_dw6_2qy_A","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0088","start":88,"end":89,"surface":"賜","kind":"person","person_id":"dpn_mmt_rm9","status":"contextual_provisional"}],"chapter_id":"c-shiji-067-disciples","book_id":"b-shiji-067","work_id":"w-shiji","source_id":"s-shiji-067-disciples"},{"id":"c-shiji-067-disciples:p031","text":"宰予字子我。利口辯辭。既受業，問：「三年之喪不已久乎？君子三年不爲禮，禮必壞；三年不爲樂，樂必崩。舊穀既沒，新穀既升，鉆燧改火，期可已矣。」子曰：「於汝安乎？」曰：「安。」「汝安則爲之。君子居喪，食旨不甘，聞樂不樂，故弗爲也。」宰我出，子曰：「予之不仁也！子生三年然後免於父母之懷。夫三年之喪，天下之通義也。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-067-disciples:m031-0000","start":0,"end":2,"surface":"宰予","kind":"person","person_id":"4uh_n5r_0id","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m031-0003","start":3,"end":5,"surface":"子我","kind":"person","person_id":"4uh_n5r_0id","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m031-0070","start":70,"end":71,"surface":"子","kind":"person","person_id":"0xl_7ir_tmn","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m031-0114","start":114,"end":116,"surface":"宰我","kind":"person","person_id":"4uh_n5r_0id","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m031-0118","start":118,"end":119,"surface":"子","kind":"person","person_id":"0xl_7ir_tmn","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m031-0122","start":122,"end":123,"surface":"予","kind":"person","person_id":"4uh_n5r_0id","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m031-0136","start":136,"end":138,"surface":"父母","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、氏族、未名者或未定指代；不補姓名、成員或官職持有人。"}],"chapter_id":"c-shiji-067-disciples","book_id":"b-shiji-067","work_id":"w-shiji","source_id":"s-shiji-067-disciples"},{"id":"c-shiji-067-disciples:p032","text":"宰予晝寢。子曰：「朽木不可雕也，糞土之墻不可圬也。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-067-disciples:m032-0000","start":0,"end":2,"surface":"宰予","kind":"person","person_id":"4uh_n5r_0id","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m032-0005","start":5,"end":6,"surface":"子","kind":"person","person_id":"0xl_7ir_tmn","status":"contextual_provisional"}],"chapter_id":"c-shiji-067-disciples","book_id":"b-shiji-067","work_id":"w-shiji","source_id":"s-shiji-067-disciples"},{"id":"c-shiji-067-disciples:p033","text":"宰我問五帝之德，子曰：「予非其人也。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-067-disciples:m033-0000","start":0,"end":2,"surface":"宰我","kind":"person","person_id":"4uh_n5r_0id","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m033-0003","start":3,"end":5,"surface":"五帝","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、氏族、未名者或未定指代；不補姓名、成員或官職持有人。"},{"id":"c-shiji-067-disciples:m033-0008","start":8,"end":9,"surface":"子","kind":"person","person_id":"0xl_7ir_tmn","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m033-0012","start":12,"end":13,"surface":"予","kind":"person","person_id":"4uh_n5r_0id","status":"contextual_provisional"}],"chapter_id":"c-shiji-067-disciples","book_id":"b-shiji-067","work_id":"w-shiji","source_id":"s-shiji-067-disciples"},{"id":"c-shiji-067-disciples:p034","text":"宰我爲臨菑大夫，與田常作亂，以夷其族，孔子恥之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-067-disciples:m034-0000","start":0,"end":2,"surface":"宰我","kind":"person","person_id":"4uh_n5r_0id","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m034-0009","start":9,"end":11,"surface":"田常","kind":"person","person_id":"rv1_o3i_m12","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m034-0016","start":16,"end":18,"surface":"其族","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、氏族、未名者或未定指代；不補姓名、成員或官職持有人。"},{"id":"c-shiji-067-disciples:m034-0019","start":19,"end":21,"surface":"孔子","kind":"person","person_id":"0xl_7ir_tmn","status":"contextual_provisional"}],"chapter_id":"c-shiji-067-disciples","book_id":"b-shiji-067","work_id":"w-shiji","source_id":"s-shiji-067-disciples"},{"id":"c-shiji-067-disciples:p064","text":"南遊至江，從弟子三百人，設取予去就，名施乎諸侯。孔子聞之，曰：「吾以言取人，失之宰予；以貌取人，失之子羽。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-067-disciples:m064-0006","start":6,"end":11,"surface":"弟子三百人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代，未補姓名、成員或親屬；譬喻與未遂取室不作已確證家屬。"},{"id":"c-shiji-067-disciples:m064-0021","start":21,"end":23,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代，未補姓名、成員或親屬；譬喻與未遂取室不作已確證家屬。"},{"id":"c-shiji-067-disciples:m064-0024","start":24,"end":26,"surface":"孔子","kind":"person","person_id":"0xl_7ir_tmn","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m064-0040","start":40,"end":42,"surface":"宰予","kind":"person","person_id":"4uh_n5r_0id","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m064-0050","start":50,"end":52,"surface":"子羽","kind":"person","person_id":"oxa_rta_lvd","status":"contextual_provisional"}],"chapter_id":"c-shiji-067-disciples","book_id":"b-shiji-067","work_id":"w-shiji","source_id":"s-shiji-067-disciples"}],"sources":[{"chapter_id":"c-shiji-001-wudi","work_id":"w-shiji","book_id"