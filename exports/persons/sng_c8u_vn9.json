d":2,"surface":"宰我","kind":"person","person_id":"4uh_n5r_0id","status":"contextual_provisional","paragraph_id":"c-shiji-067-disciples:p034","chapter_id":"c-shiji-067-disciples"},{"id":"c-shiji-067-disciples:m064-0040","start":40,"end":42,"surface":"宰予","kind":"person","person_id":"4uh_n5r_0id","status":"contextual_provisional","paragraph_id":"c-shiji-067-disciples:p064","chapter_id":"c-shiji-067-disciples"}],"relations":[],"title_holdings":[{"id":"th-shiji067-009","person_id":"4uh_n5r_0id","title":"臨菑大夫","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-067-disciples","source_id":"s-shiji-067-disciples","paragraph_id":"c-shiji-067-disciples:p034","quote":"宰我爲臨菑大夫，與田常作亂，以夷其族，孔子恥之。"}],"attestations":[{"id":"th-shiji067-009:a001","paragraph_id":"c-shiji-067-disciples:p034","start":3,"end":7,"surface":"臨菑大夫","person_mention_id":"c-shiji-067-disciples:m034-0000","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"保存授予事件與文獻用稱，不以首次用稱、死亡或出奔推定全部任期邊界。閔損不仕、漆彫開未能信而未出仕、孔子可使等評論均不當已任。相魯衞與相衞照原文，未定官名或精確時段；有若共立為師不作官職。楊何元朔中用稱未換算精確日期。諡稱及來源敘事仍待底本與研究覆核。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji067-008","person_id":"4uh_n5r_0id","surfaces":["予","子我","宰予","宰我"],"scope":"same_chapter","chapter_ids":["c-shiji-067-disciples"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-067-disciples:p001","quote":"孔子曰「受業身通者七十有七人」，皆異能之士也。德行：顏淵，閔子騫，冉伯牛，仲弓。政事：冉有，季路。言語：宰我，子貢。文學：子游，子夏。師也辟，參也魯，柴也愚，由也喭，回也屢空。賜不受命而貨殖焉，億則屢中。"},{"paragraph_id":"c-shiji-067-disciples:p031","quote":"宰予字子我。利口辯辭。既受業，問：「三年之喪不已久乎？君子三年不爲禮，禮必壞；三年不爲樂，樂必崩。舊穀既沒，新穀既升，鉆燧改火，期可已矣。」子曰：「於汝安乎？」曰：「安。」「汝安則爲之。君子居喪，食旨不甘，聞樂不樂，故弗爲也。」宰我出，子曰：「予之不仁也！子生三年然後免於父母之懷。夫三年之喪，天下之通義也。」"},{"paragraph_id":"c-shiji-067-disciples:p032","quote":"宰予晝寢。子曰：「朽木不可雕也，糞土之墻不可圬也。」"},{"paragraph_id":"c-shiji-067-disciples:p033","quote":"宰我問五帝之德，子曰：「予非其人也。」"},{"paragraph_id":"c-shiji-067-disciples:p034","quote":"宰我爲臨菑大夫，與田常作亂，以夷其族，孔子恥之。"},{"paragraph_id":"c-shiji-067-disciples:p064","quote":"南遊至江，從弟子三百人，設取予去就，名施乎諸侯。孔子聞之，曰：「吾以言取人，失之宰予；以貌取人，失之子羽。」"}],"rationale":"依篇內明示姓名字稱及局部問答暫接。吳越王稱按夫差句踐連續敘事；第71段夫子指原憲，第90段指代未定。傳易短何分田子莊何與楊何，傳授不當父子；引古人物保留傳說性。冉季字子產不接鄭子產，原憲子思不接孔子後世子思；名錄各條同字子徒、子聲、子上、皙等均保留不同候選，鄭國是此條人名。魯昭公夫人孟子不接戰國孟子。全152段明示姓名首輪已存，未名者、代詞、版本及跨篇身份待覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji067-zai","person_ids":["sng_c8u_vn9","4uh_n5r_0id"],"canonical_person_id":"sng_c8u_vn9","scope":"cross_chapter","chapter_ids":["c-shiji-001-wudi","c-shiji-067-disciples"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-001-wudi","source_id":"s-shiji-001-wudi","paragraph_id":"c-shiji-001-wudi:p028","quote":"太史公曰：學者多稱五帝，尚矣。然尚書獨載堯以來；而百家言黃帝，其文不雅馴，薦紳先生難言之。孔子所傳宰予問五帝德及帝繫姓，儒者或不傳。余嘗西至空桐，北過涿鹿，東漸於海，南浮江淮矣，至長老皆各往往稱黃帝、堯、舜之處，風教固殊焉，總之不離古文者近是。予觀春秋、國語，其發明五帝德、帝繫姓章矣，顧弟弗深考，其所表見皆不虛。書缺有間矣，其軼乃時時見於他說。非好學深思，心知其意，固難爲淺見寡聞道也。余并論次，擇其言尤雅者，故著爲本紀書首。","mention_ids":["c-shiji-001-wudi:m028-0049"]},{"chapter_id":"c-shiji-067-disciples","source_id":"s-shiji-067-disciples","paragraph_id":"c-shiji-067-disciples:p033","quote":"宰我問五帝之德，子曰：「予非其人也。」","mention_ids":["c-shiji-067-disciples:m033-0000","c-shiji-067-disciples:m033-0012"]}],"rationale":"兩篇同載宰予問五帝德，本篇宰予字子我與宰我問五帝之德相接；不據此確證作亂敘事。 各篇原文與已發ID保留；同書篇章不當獨立見證。同指不確證年代、任職、人物傳說或所有敘事，版本仍待覆核。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-001-wudi:p028","text":"太史公曰：學者多稱五帝，尚矣。然尚書獨載堯以來；而百家言黃帝，其文不雅馴，薦紳先生難言之。孔子所傳宰予問五帝德及帝繫姓，儒者或不傳。余嘗西至空桐，北過涿鹿，東漸於海，南浮江淮矣，至長老皆各往往稱黃帝、堯、舜之處，風教固殊焉，總之不離古文者近是。予觀春秋、國語，其發明五帝德、帝繫姓章矣，顧弟弗深考，其所表見皆不虛。書缺有間矣，其軼乃時時見於他說。非好學深思，心知其意，固難爲淺見寡聞道也。余并論次，擇其言尤雅者，故著爲本紀書首。","mentions":[{"id":"c-shiji-001-wudi:m028-0000","start":0,"end":3,"surface":"太史公","kind":"unresolved","person_id":null,"status":"unresolved","note":"作者署稱；待與其他篇章的自述及書目證據連結，不先據署稱單獨合併。"},{"id":"c-shiji-001-wudi:m028-0020","start":20,"end":21,"surface":"堯","kind":"person","person_id":"oho_r3f_c6y","status":"source_identified"},{"id":"c-shiji-001-wudi:m028-0028","start":28,"end":30,"surface":"黃帝","kind":"person","person_id":"8jz_o3s_obt","status":"source_identified"},{"id":"c-shiji-001-wudi:m028-0045","start":45,"end":47,"surface":"孔子","kind":"person","person_id":"fp6_ia6_7yw","status":"source_identified"},{"id":"c-shiji-001-wudi:m028-0049","start":49,"end":51,"surface":"宰予","kind":"person","person_id":"sng_c8u_vn9","status":"source_identified"},{"id":"c-shiji-001-wudi:m028-0097","start":97,"end":99,"surface":"黃帝","kind":"person","person_id":"8jz_o3s_obt","status":"source_identified"},{"id":"c-shiji-001-wudi:m028-0100","start":100,"end":101,"surface":"堯","kind":"person","person_id":"oho_r3f_c6y","status":"source_identified"},{"id":"c-shiji-001-wudi:m028-0102","start":102,"end":103,"surface":"舜","kind":"person","person_id":"ddb_l4j_4j2","status":"source_identified"}],"annotation_status":"in_progress","chapter_id":"c-shiji-001-wudi","book_id":"b-shiji-001","work_id":"w-shiji","source_id":"s-shiji-001-wudi"},{"id":"c-shiji-032-qi:p077","text":"簡公四年春，初，簡公與父陽生俱在魯也，監止有寵焉。及即位，使為政。田成子憚之，驟顧於朝。御鞅言簡公曰：「田、監不可并也，君其擇焉。」弗聽。子我夕，田逆殺人，逢之，遂捕以入。田氏方睦，使囚病而遺守囚者酒，醉而殺守者，得亡。子我盟諸田於陳宗。初，田豹欲為子我臣，使公孫言豹，豹有喪而止。後卒以為臣，幸於子我。子我謂曰：「吾盡逐田氏而立女，可乎？」對曰：「我遠田氏矣。且其違者不過數人，何盡逐焉！」遂告田氏。子行曰：「彼得君，弗先，必禍子。」子行舍於公宮。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-032-qi:m077-0000","start":0,"end":2,"surface":"簡公","kind":"person","person_id":"wuz_yxe_b9k_AA","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m077-0008","start":8,"end":10,"surface":"簡公","kind":"person","person_id":"wuz_yxe_b9k_AA","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m077-0012","start":12,"end":14,"surface":"陽生","kind":"person","person_id":"wuz_yxe_b9k_A","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m077-0019","start":19,"end"