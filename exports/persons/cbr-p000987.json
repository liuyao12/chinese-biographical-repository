hiji-012-wudi","mention_count":18,"mention_ids":["c-shiji-012-wudi:m017-0009","c-shiji-012-wudi:m017-0012","c-shiji-012-wudi:m017-0101","c-shiji-012-wudi:m017-0134","c-shiji-012-wudi:m017-0140","c-shiji-012-wudi:m017-0162","c-shiji-012-wudi:m017-0296","c-shiji-012-wudi:m018-0016","c-shiji-012-wudi:m018-0018","c-shiji-012-wudi:m018-0132","c-shiji-012-wudi:m018-0191","c-shiji-012-wudi:m018-0254","c-shiji-012-wudi:m018-0295","c-shiji-012-wudi:m018-0338","c-shiji-012-wudi:m024-0059","c-shiji-012-wudi:m024-0086","c-shiji-012-wudi:m024-0105","c-shiji-012-wudi:m025-0050"],"paragraph_ids":["c-shiji-012-wudi:p017","c-shiji-012-wudi:p018","c-shiji-012-wudi:p024","c-shiji-012-wudi:p025"],"passage_count":4}],"most_mentioned_source_ids":["s-shiji-012-wudi"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji012-005","subject_person_id":"b4l_2ug_qy3","predicate":"spouse","object_person_id":"tzq_88y_69k","status":"source_attested","evidence":[{"chapter_id":"c-shiji-012-wudi","source_id":"s-shiji-012-wudi","paragraph_id":"c-shiji-012-wudi:p018","quote":"是時上方憂河決，而黃金不就，乃拜大為五利將軍。居月餘，得四金印，佩天士將軍、地土將軍、大通將軍、天道將軍印。制詔御史：「昔禹疏九江，決四瀆。閒者河溢皋陸，隄繇不息。朕臨天下二十有八年，天若遺朕士而大通焉。乾稱『蜚龍』，『鴻漸于般』，意庶幾與焉。其以二千戶封地士將軍大為樂通侯。」賜列侯甲第，僮千人。乘輿斥車馬帷帳器物以充其家。又以衛長公主妻之，齎金萬斤，更名其邑曰當利公主。天子親如五利之第。使者存問所給，連屬於道。自大主將相以下，皆置酒其家，獻遺之。於是天子又刻玉印曰「天道將軍」，使使衣羽衣，夜立白茅上，五利將軍亦衣羽衣，立白茅上受印，以示弗臣也。而佩「天道」者，且為天子道天神也。於是五利常夜祠其家，欲以下神。神未至而百鬼集矣，然頗能使之。其後治裝行，東入海，求其師云。大見數月，佩六印，貴振天下，而海上燕齊之閒，莫不搤捥而自言有禁方，能神僊矣。"}],"qualifiers":{"source_term":"妻之","historicity":"historical_tradition"},"interpretation_note":"保存來源明示姊或配偶，不補姓名、同父同母或婚姻曆日。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mention