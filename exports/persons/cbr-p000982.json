":"received_chapter","mentions":[{"id":"c-shiji-012-wudi:m025-0003","start":3,"end":6,"surface":"公孫卿","kind":"person","person_id":"lgo_cwi_085","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m025-0030","start":30,"end":32,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m025-0041","start":41,"end":42,"surface":"卿","kind":"person","person_id":"lgo_cwi_085","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m025-0047","start":47,"end":49,"surface":"文成","kind":"person","person_id":"zg6_76t_xid","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m025-0050","start":50,"end":52,"surface":"五利","kind":"person","person_id":"b4l_2ug_qy3","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m025-0055","start":55,"end":56,"surface":"卿","kind":"person","person_id":"lgo_cwi_085","status":"contextual_provisional"}],"chapter_id":"c-shiji-012-wudi","book_id":"b-shiji-012","work_id":"w-shiji","source_id":"s-shiji-012-wudi"}],"sources":[{"chapter_id":"c-shiji-012-wudi","work_id":"w-shiji","book_id":"b-shiji-012","source_id":"s-shiji-012-wudi","source":{"title":"史記／卷012","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷012","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷012&oldid=8733061","revision_id":8733061,"accessed_on":"2026-10-09","extent":"本篇52個p區塊，自孝武皇帝者至太史公論贊；排除導覽dd、索隱述贊、現代版權告示及style／script樣式程式內容。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"去除正文區塊內嵌style內容，保留同段史文；保留行內校勘符號及公玊帶等原字。","note":"固定版本與實讀HTML一致；未核底本、影像或本紀傳承研究。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical"}}
