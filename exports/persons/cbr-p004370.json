66,"end":69,"surface":"傳舍長","kind":"person","person_id":"cbr-p004370","status":"contextual_provisional","paragraph_id":"c-shiji-075-mengchang:p014","chapter_id":"c-shiji-075-mengchang"},{"id":"c-shiji-075-mengchang:m014-0135","start":135,"end":138,"surface":"傳舍長","kind":"person","person_id":"cbr-p004370","status":"contextual_provisional","paragraph_id":"c-shiji-075-mengchang:p014","chapter_id":"c-shiji-075-mengchang"},{"id":"c-shiji-075-mengchang:m014-0186","start":186,"end":189,"surface":"傳舍長","kind":"person","person_id":"cbr-p004370","status":"contextual_provisional","paragraph_id":"c-shiji-075-mengchang:p014","chapter_id":"c-shiji-075-mengchang"},{"id":"c-shiji-075-mengchang:m014-0190","start":190,"end":192,"surface":"舍長","kind":"person","person_id":"cbr-p004370","status":"contextual_provisional","paragraph_id":"c-shiji-075-mengchang:p014","chapter_id":"c-shiji-075-mengchang"},{"id":"c-shiji-075-mengchang:m015-0088","start":88,"end":91,"surface":"傳舍長","kind":"person","person_id":"cbr-p004370","status":"contextual_provisional","paragraph_id":"c-shiji-075-mengchang:p015","chapter_id":"c-shiji-075-mengchang"}],"relations":[],"title_holdings":[{"id":"th-shiji075-017","person_id":"cbr-p004370","title":"傳舍長","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-075-mengchang","source_id":"s-shiji-075-mengchang","paragraph_id":"c-shiji-075-mengchang:p014","quote":"初，馮驩聞孟嘗君好客，躡蹻而見之。孟嘗君曰；「先生遠辱，何以教文也？」馮驩曰：「聞君好士，以貧身歸於君。」孟嘗君置傳舍十日，孟嘗君問傳舍長曰：「客何所爲？」答曰：「馮先生甚貧，猶有一劍耳，又蒯緱。彈其劍而歌曰『長鋏歸來乎，食無魚』。」孟嘗君遷之幸舍，食有魚矣。五日，又問傳舍長。答曰：「客復彈劍而歌曰『長鋏歸來乎，出無輿』。」孟嘗君遷之代舍，出入乘輿車矣。五日，孟嘗君復問傳舍長。舍長答曰：「先生又嘗彈劍而歌曰『長鋏歸來乎，無以爲家』。」孟嘗君不悅。"}],"attestations":[{"id":"th-shiji075-017:a001","paragraph_id":"c-shiji-075-mengchang:p014","start":66,"end":69,"surface":"傳舍長","person_mention_id":"c-shiji-075-mengchang:m014-0066","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授官、授稱、文獻用稱與諡稱分存；未知日期與終點不補。初馮驩段落為回述，不把跨段順序當連續任期，擬請相秦與許以所得封子不當實授；囚、出關或死亡不直接終止全部官爵。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji075-041","person_id":"cbr-p004370","scope":"same_chapter","chapter_ids":["c-shiji-075-mengchang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"依局部敘事姓名、書信受話及回指暫接。第11段其後齊王限接前段齊湣王，馮驩初敘與復位故事中的齊秦兩王未自動接湣襄或昭王；內嵌秦王王君與外層孟嘗君君稱分辨。馮驩馮先生馮公與局部驩相配，馮軾與代舍非其人名。親弗、周最與原字保留，魏冉書信子稱按受話限定；孟嘗諸子不補個別子嗣。","surfaces":["傳舍長","舍長"],"evidence":[{"paragraph_id":"c-shiji-075-mengchang:p014","quote":"初，馮驩聞孟嘗君好客，躡蹻而見之。孟嘗君曰；「先生遠辱，何以教文也？」馮驩曰：「聞君好士，以貧身歸於君。」孟嘗君置傳舍十日，孟嘗君問傳舍長曰：「客何所爲？」答曰：「馮先生甚貧，猶有一劍耳，又蒯緱。彈其劍而歌曰『長鋏歸來乎，食無魚』。」孟嘗君遷之幸舍，食有魚矣。五日，又問傳舍長。答曰：「客復彈劍而歌曰『長鋏歸來乎，出無輿』。」孟嘗君遷之代舍，出入乘輿車矣。五日，孟嘗君復問傳舍長。舍長答曰：「先生又嘗彈劍而歌曰『長鋏歸來乎，無以爲家』。」孟嘗君不悅。"},{"paragraph_id":"c-shiji-075-mengchang:p015","quote":"居朞年，馮驩無所言。孟嘗君時相齊，封萬戸於薛。其食客三千人。邑入不足以奉客，使人出錢於薛。歳餘不入，貸錢者多不能與其息，客奉將不給。孟嘗君憂之，問左右：「何人可使收債於薛者？」傳舍長曰：「代舍客馮公形容狀貌甚辯，長者，無他伎能，宜可令收債。」孟嘗君乃進馮驩而請之曰：「賓客不知文不肖，幸臨文者三千餘人，邑入不足以奉賓客，故出息錢於薛。薛歳不入，民頗不與其息。今客食恐不給，願先生責之。」馮驩曰；「諾。」辭行，至薛，召取孟嘗君錢者皆會，得息錢十萬。乃多釀酒，買肥牛，召諸取錢者，能與息者皆來，不能與息者亦來，皆持取錢之券書合之。齊爲會，日殺牛置酒。酒酣，乃持券如前合之，能與息者，與爲期；貧不能與息者，取其券而燒之。曰：「孟嘗君所以貸錢者，爲民之無者以爲本業也；所以求息者，爲無以奉客也。今富給者以要期，貧窮者燔券書以捐之。諸君彊飲食。有君如此，豈可負哉！」坐者皆起，再拜。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-075-mengchang:p014","text":"初，馮驩聞孟嘗君好客，躡蹻而見之。孟嘗君曰；「先生遠辱，何以教文也？」馮驩曰：「聞君好士，以貧身歸於君。」孟嘗君置傳舍十日，孟嘗君問傳舍長曰：「客何所爲？」答曰：「馮先生甚貧，猶有一劍耳，又蒯緱。彈其劍而歌曰『長鋏歸來乎，食無魚』。」孟嘗君遷之幸舍，食有魚矣。五日，又問傳舍長。答曰：「客復彈劍而歌曰『長鋏歸來乎，出無輿』。」孟嘗君遷之代舍，出入乘輿車矣。五日，孟嘗君復問傳舍長。舍長答曰：「先生又嘗彈劍而歌曰『長鋏歸來乎，無以爲家』。」孟嘗君不悅。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-075-mengchang:m014-0002","start":2,"end":4,"surface":"馮驩","kind":"person","person_id":"cbr-p004369","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m014-0005","start":5,"end":8,"surface":"孟嘗君","kind":"person","person_id":"cbr-p004330","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m014-0009","start":9,"end":10,"surface":"客","kind":"unresolved","person_id":null,"status":"unresolved","note":"好客為喜愛賓客之義，這個客字不專指馮驩；原錨點ID及字位保留。"},{"id":"c-shiji-075-mengchang:m014-0017","start":17,"end":20,"surface":"孟嘗君","kind":"person","person_id":"cbr-p004330","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m014-0023","start":23,"end":25,"surface":"先生","kind":"person","person_id":"cbr-p004369","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m014-0031","start":31,"end":32,"surface":"文","kind":"person","person_id":"cbr-p004330","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m014-0035","start":35,"end":37,"surface":"馮驩","kind":"person","person_id":"cbr-p004369","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m014-0041","start":41,"end":42,"surface":"君","kind":"person","person_id":"cbr-p004330","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m014-0050","start":50,"end":51,"surface":"君","kind":"person","person_id":"cbr-p004330","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m014-0053","start":53,"end":56,"surface":"孟嘗君","kind":"person","person_id":"cbr-p004330","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m014-0062","start":62,"end":65,"surface":"孟嘗君","kind":"person","person_id":"cbr-p004330","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m014-0066","start":66,"end":69,"surface":"傳舍長","kind":"person","person_id":"cbr-p004370","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m014-0072","start":72,"end":73,"surface":"客","kind":"person","person_id":"cbr-p004369","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m014-0082","start":82,"end":85,"surface":"馮先生","kind":"person","person_id":"cbr-p004369","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m014-0117","start":117,"end":120,"surface":"孟嘗君","kind":"person","person_id":"cbr-p004330","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m014-0135","start":135,"end":138,"surface":"傳舍長","kind":"person","person_id":"cbr-p004370","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m014-0143","start":143,"end":144,"surface":"客","kind":"person","person_id":"cbr-p004369","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m014-0163","start":163,"end":166,"surface":"孟嘗君","kind":"person","person_id":"cbr-p004330","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m014-0168","start":168,"end":170,"surface":"代舍","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名使者、族屬或可能混作人名的乘車／館舍詞保持未定；馮軾不當馮驩，代舍不當蘇代，不補成員或親屬鏈。"},{"id":"c-shiji-075-mengchang:m014-0181","start":181,"end":184,"surface":"孟嘗君","kind":"person","person_id":"cbr-p004330","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m014-0186","start":186,"end":189,"surface":"傳舍長","kind":"person","person_id":"cbr-p004370","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m014-0190","start":190,"end":192,"surface":"舍長","kind":"person","person_id":"cbr-p004370","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m014-0196","start":196,"end":198,"surface":"先生","kind":"person","person_id":"cbr-p004369","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m014-0219","start":219,"end":222,"surface":"孟嘗君","kind":"person","person_id":"cbr-p004330","status":"contextual_provisional"}],"chapter_id":"c-shiji-075-mengchang","book_id":"b-shiji-075","work_id":"w-shiji","source_id":"s-shiji-075-mengchang"},{"id":"c-shiji-075-mengchang:p015","text":"居朞年，馮驩無所言。孟嘗君時相齊，封萬戸於薛。其食客三千人。邑入不足以奉客，使人出錢於薛。歳餘不入，貸錢者多不能與其息，客奉將不給。孟嘗君憂之，問左右：「何人可使收債於薛者？」傳舍長曰：「代舍客馮公形容狀貌甚辯，長者，無他伎能，宜可令收債。」孟嘗君乃進馮驩而請之曰：「賓客不知文不肖，幸臨文者三千餘人，邑入不足以奉賓客，故出息錢於薛。薛歳不入，民頗不與其息。今客食恐不給，願先生責之。」馮驩曰；「諾。」辭行，至薛，召取孟嘗君錢者皆會，得息錢十萬。乃多釀酒，買肥牛，召諸取錢者，能與息者皆來，不能與息者亦來，皆持取錢之券書合之。齊爲會，日殺牛置酒。酒酣，乃持券如前合之，能與息者，與爲期；貧不能與息者，取其券而燒之。曰：「孟嘗君所以貸錢者，爲民之無者以爲本業也；所以求息者，爲無以奉客也。今富給者以要期，貧窮者燔券書以捐之。諸君彊飲食