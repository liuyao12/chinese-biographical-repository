cy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-wu052-zz-teacher","subject_person_id":"roi_rz4_ute","object_person_id":"dsp_hdz_2xc","predicate":"teacher","qualifiers":{"source_term":"從白侯子安受","relationship_basis":"teaching"},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-052","chapter_id":"c-sanguozhi-052-zhangzhao-complete","source_id":"s-sanguozhi-052-zhangzhao-complete","paragraph_id":"c-sanguozhi-052-zhangzhao-complete:line012","quote":"張昭字子布，彭城人也。少好學，善隸書，從白侯子安受《左氏春秋》，博覽眾書，與琅邪趙昱、東海王朗俱發名友善。弱冠察孝廉，不就。與朗共論舊君諱事，州裡才士陳琳等皆稱善之。刺史陶謙舉茂才，不應，謙以爲輕己，遂見拘執。昱傾身營救，方以得免。漢末大亂，徐方士民多避難揚土，昭皆南渡江。孫策創業，命昭爲長史、撫軍中郎將，升堂拜母，如比肩之舊，文武之事，一以委昭。昭每得北方士大夫書疏，專歸美於昭，昭欲嘿而不宣則懼有私，宣之則恐非宜，進退不安。策聞之，歡笑曰：\"昔管仲相齊，一則仲父，二則仲父，而桓公爲霸者宗。今子布賢，我能用之，其功名獨不在我乎!\"，","subject_person_mention_id":"c-sanguozhi-052-zhangzhao-complete:line012:m0000","object_person_mention_id":"c-sanguozhi-052-zhangzhao-complete:line012:m0020"}],"interpretation_note":"此條按本句所明言。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-052-zhangzhao-complete:line012:m0020","start":20,"end":24,"surface":"白侯子安","kind":"person","person_id":"dsp_hdz_2xc","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-sanguozhi-052-zhangzhao-complete:line012","chapter_id":"c-sanguozhi-052-zhangzhao-complete"}],"relations":[{"id":"a-wu052-zz-teacher","subject_person_id":"roi_rz4_ute","object_person_id":"dsp_hdz_2xc","predicate":"teacher","qualifiers":{"source_term":"從白侯子安受","relationship_basis":"teaching"},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-052","chapter_id":"c-sanguozhi-052-zhangzhao-complete","source_id":"s-