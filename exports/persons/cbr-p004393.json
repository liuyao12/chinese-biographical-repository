5","c-shiji-076-pingyu:m009-0009","c-shiji-076-pingyu:m009-0030"],"paragraph_ids":["c-shiji-076-pingyu:p007","c-shiji-076-pingyu:p009"],"passage_count":2},{"source_id":"s-shiji-074-mengxun","work_id":"w-shiji","book_id":"b-shiji-074","chapter_id":"c-shiji-074-mengxun","mention_count":1,"mention_ids":["c-shiji-074-mengxun:m012-0004"],"paragraph_ids":["c-shiji-074-mengxun:p012"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-076-pingyu"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-074-mengxun:m012-0004","start":4,"end":7,"surface":"公孫龍","kind":"person","person_id":"cbr-p004323","status":"contextual_provisional","paragraph_id":"c-shiji-074-mengxun:p012","chapter_id":"c-shiji-074-mengxun"},{"id":"c-shiji-076-pingyu:m007-0018","start":18,"end":21,"surface":"公孫龍","kind":"person","person_id":"cbr-p004393","status":"contextual_provisional","paragraph_id":"c-shiji-076-pingyu:p007","chapter_id":"c-shiji-076-pingyu"},{"id":"c-shiji-076-pingyu:m007-0033","start":33,"end":34,"surface":"龍","kind":"person","person_id":"cbr-p004393","status":"contextual_provisional","paragraph_id":"c-shiji-076-pingyu:p007","chapter_id":"c-shiji-076-pingyu"},{"id":"c-shiji-076-pingyu:m007-0065","start":65,"end":66,"surface":"龍","kind":"person","person_id":"cbr-p004393","status":"contextual_provisional","paragraph_id":"c-shiji-076-pingyu:p007","chapter_id":"c-shiji-076-pingyu"},{"id":"c-shiji-076-pingyu:m009-0005","start":5,"end":8,"surface":"公孫龍","kind":"person","person_id":"cbr-p004393","status":"contextual_provisional","paragraph_id":"c-shiji-076-pingyu:p009","chapter_id":"c-shiji-076-pingyu"},{"id":"c-shiji-076-pingyu:m009-0009","start":9,"end":12,"surface":"公孫龍","kind":"person","person_id":"cbr-p004393","status":"contextual_provisional","paragraph_id":"c-shiji-076-pingyu:p009","chapter_id":"c-shiji-076-pingyu"},{"id":"c-shiji-076-pingyu:m009-0030","start":30,"end":33,"surface":"公孫龍","kind":"person","person_id":"cbr-p004393","status":"contextual_provisional","paragraph_id":"c-shiji-076-pingyu:p009","chapter_id":"c-shiji-076-pingyu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji074-047","person_id":"cbr-p004323","scope":"same_chapter","chapter_ids":["c-shiji-074-mengxun"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"依本段明示人名及局部敘事暫接，淳于髡髡先生、騶奭奭與晏嬰晏各限所述範圍；管引古不補管仲。薦髡客子稱及兩次獻馬獻謳者保留未名候選，不確證不同匿名人物。齊王命列大夫與齊宣、齊襄王分候選，未因敘事相鄰自動同指；群體之徒、之屬及學說合稱不補成員。欲以卿相待而謝去不當任官，李斯弟子不當子嗣，墨翟年代或曰異說保留。","surfaces":["公孫龍"],"evidence":[{"paragraph_id":"c-shiji-074-mengxun:p012","quote":"而趙亦有公孫龍為堅白同異之辯，劇子之言；魏有李悝，盡地力之教；楚有尸子、長盧；阿之吁子焉。自如孟子至于吁子，世多有其書，故不論其傳云。蓋墨翟，宋之大夫，善守御，為節用。或曰并孔子時，或曰在其後。"}]},{"id":"d-shiji076-020","person_id":"cbr-p004393","scope":"same_chapter","chapter_ids":["c-shiji-076-pingyu"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"依毛遂合從與邯鄲救援的姓名、稱呼及局部回指暫接，楚王留未名，湯文王保存引古。毛遂明示遂短稱與敘事遂副詞分開；相士非任相。李同父邯鄲傳舍吏及李侯按同段父稱暫接，不把父封爵改成李同追贈。第7段舉平原君之趙王未逕接惠文或孝成，親戚、子孫與食客群體未補個別世系。","surfaces":["公孫龍","龍"],"evidence":[{"paragraph_id":"c-shiji-076-pingyu:p007","quote":"虞卿欲以信陵君之存邯鄲爲平原君請封。公孫龍聞之，夜駕見平原君曰：「龍聞虞卿欲以信陵君之存邯鄲爲君請封，有之乎？」平原君曰：「然。」龍曰：「此甚不可。且王舉君而相趙者，非以君之智能爲趙國無有也。割東武城而封君者，非以君爲有功也，而以國人無勳，乃以君爲親戚故也。君受相印不辭無能，割地不言無功者，亦自以爲親戚故也。今信陵君存邯鄲而請封，是親戚受城而國人計功也。此甚不可。且虞卿操其兩權，事成，操右券以責；事不成，以虛名德君。君必勿聽也。」平原君遂不聽虞卿。"},{"paragraph_id":"c-shiji-076-pingyu:p009","quote":"平原君厚待公孫龍。公孫龍善爲堅白之辯，及鄒衍過趙言至道，乃絀公孫龍。"}]}],"equivalence_decisions":[{"id":"eq-shiji076-gong","person_ids":["cbr-p004323","cbr-p004393"],"canonical_person_id":"cbr-p004323","scope":"cross_chapter","chapter_ids":["c-shiji-074-mengxun","c-shiji-076-pingyu"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-074-mengxun","source_id":"s-shiji-074-mengxun","paragraph_id":"c-shiji-074-mengxun:p012","quote":"而趙亦有公孫龍為堅白同異之辯，劇子之言；魏有李悝，盡地力之教；楚有尸子、長盧；阿之吁子焉。自如孟子至于吁子，世多有其書，故不論其傳云。蓋墨翟，宋之大夫，善守御，為節用。或曰并孔子時，或曰在其後。","mention_ids":["c-shiji-074-mengxun:m012-0004"]},{"chapter_id":"c-shiji-076-pingyu","source_id":"s-shiji-076-pingyu","paragraph_id":"c-shiji-076-pingyu:p009","quote":"平原君厚待公孫龍。公孫龍善爲堅白之辯，及鄒衍過趙言至道，乃絀公孫龍。","mention_ids":["c-shiji-076-pingyu:m009-0005","c-shiji-076-pingyu:m009-0009","c-shiji-076-pingyu:m009-0030"]}],"rationale":"孟荀傳趙公孫龍為堅白同異之辯與本傳平原君所待公孫龍善堅白之辯，姓名、趙地及特定辯學相配。 各篇原字、原文與已發ID保留，同書不視為獨立見證；同指不確證所有紀年、任職、親屬或敘事，不按全域同名批量改號。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-074-mengxun:p012","text":"而趙亦有公孫龍為堅白同異之辯，劇子之言；魏有李悝，盡地力之教；楚有尸子、長盧；阿之吁子焉。自如孟子至于吁子，世多有其書，故不論其傳云。蓋墨翟，宋之大夫，善守御，為節用。或曰并孔子時，或曰在其後。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-074-mengxun:m012-0004","start":4,"end":7,"surface":"公孫龍","kind":"person","person_id":"cbr-p004323","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m012-0015","start":15,"end":17,"surface":"劇子","kind":"person","person_id":"cbr-p004324","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m012-0022","start":22,"end":24,"surface":"李悝","kind":"person","person_id":"cbr-p004325","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m012-0033","start":33,"end":35,"surface":"尸子","kind":"person","person_id":"cbr-p004326","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m012-0036","start":36,"end":38,"surface":"長盧","kind":"person","person_id":"cbr-p004327","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m012-0041","start":41,"end":43,"surface":"吁子","kind":"person","person_id":"cbr-p004328","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m012-0047","start":47,"end":49,"surface":"孟子","kind":"person","person_id":"cbr-p004280","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m012-0051","start":51,"end":53,"surface":"吁子","kind":"person","person_id":"cbr-p004328","status":"contextual_provisional"},