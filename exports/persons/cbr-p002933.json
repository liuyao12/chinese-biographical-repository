ei:m034-0006","start":6,"end":10,"surface":"孔圉文子","kind":"person","person_id":"cbr-p001587","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m034-0011","start":11,"end":15,"surface":"太子蒯聵","kind":"person","person_id":"cbr-p001585","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m034-0016","start":16,"end":17,"surface":"姊","kind":"person","person_id":"cbr-p001588","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m034-0019","start":19,"end":20,"surface":"悝","kind":"person","person_id":"cbr-p001589","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m034-0025","start":25,"end":28,"surface":"渾良夫","kind":"person","person_id":"cbr-p001590","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m034-0031","start":31,"end":34,"surface":"孔文子","kind":"person","person_id":"cbr-p001587","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m034-0036","start":36,"end":38,"surface":"良夫","kind":"person","person_id":"cbr-p001590","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m034-0040","start":40,"end":42,"surface":"悝母","kind":"person","person_id":"cbr-p001588","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m034-0043","start":43,"end":45,"surface":"太子","kind":"person","person_id":"cbr-p001585","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m034-0048","start":48,"end":50,"surface":"悝母","kind":"person","person_id":"cbr-p001588","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m034-0051","start":51,"end":53,"surface":"良夫","kind":"person","person_id":"cbr-p001590","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m034-0054","start":54,"end":56,"surface":"太子","kind":"person","person_id":"cbr-p001585","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m034-0057","start":57,"end":59,"surface":"太子","kind":"person","person_id":"cbr-p001585","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m034-0060","start":60,"end":62,"surface":"良夫","kind":"person","person_id":"cbr-p001590","status"