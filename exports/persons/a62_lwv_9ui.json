,"end":64,"surface":"唐蒙","kind":"person","person_id":"a62_lwv_9ui","status":"contextual_provisional","paragraph_id":"c-shiji-117-xiangru:p031","chapter_id":"c-shiji-117-xiangru"},{"id":"c-shiji-117-xiangru:m032-0174","start":174,"end":177,"surface":"中郎將","kind":"person","person_id":"a62_lwv_9ui","status":"contextual_provisional","paragraph_id":"c-shiji-117-xiangru:p032","chapter_id":"c-shiji-117-xiangru"},{"id":"c-shiji-117-xiangru:m032-0197","start":197,"end":199,"surface":"使者","kind":"person","person_id":"a62_lwv_9ui","status":"contextual_provisional","paragraph_id":"c-shiji-117-xiangru:p032","chapter_id":"c-shiji-117-xiangru"},{"id":"c-shiji-117-xiangru:m035-0005","start":5,"end":7,"surface":"唐蒙","kind":"person","person_id":"a62_lwv_9ui","status":"contextual_provisional","paragraph_id":"c-shiji-117-xiangru:p035","chapter_id":"c-shiji-117-xiangru"},{"id":"c-shiji-130-taishigong:m128-0000","start":0,"end":2,"surface":"唐蒙","kind":"person","person_id":"a62_lwv_9ui","status":"contextual_provisional","paragraph_id":"c-shiji-130-taishigong:p128","chapter_id":"c-shiji-130-taishigong"}],"relations":[],"title_holdings":[{"id":"th-shiji116-006","person_id":"a62_lwv_9ui","title":"番陽令","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-116-xinanyi","source_id":"s-shiji116-xinanyi","paragraph_id":"c-shiji-116-xinanyi:p003","quote_passage_ref":"data/corpus/shiji/116.json"}],"attestations":[{"id":"th-shiji116-006:a001","paragraph_id":"c-shiji-116-xinanyi:p003","start":26,"end":29,"surface":"番陽令","person_mention_id":"c-shiji-116-xinanyi:m003-0029","usage":"narrative","date_expression":"建元六年","normalized_date_range":{"earliest":{"era":"BCE","era_year":136,"year":-135},"latest":{"era":"BCE","era_year":135,"year":-134},"year_numbering":"astronomical","precision":"year_range","basis":"regnal_year_crosses_ce_year","status":"editorial_provisional","original_quote":"建元六年，大行王恢擊東越，東越殺王郢以報。恢因兵威使番陽令唐蒙風指曉南越。南越食蒙蜀枸醬，蒙問所從來，曰「道西北牂柯，牂柯江廣數里，出番禺城下」。蒙歸至長安，問蜀賈人，賈人曰：「獨蜀出枸醬，多持竊出市夜郎。夜郎者，臨牂柯江，江廣百餘步，足以行船。南越以財物役屬夜郎，西至同師，然亦不能臣使也。」蒙乃上書說上曰：「南越王黃屋左纛，地東西萬餘里，名為外臣，實一州主也。今以長沙、豫章往，水道多絕，難行。竊聞夜郎所有精兵，可得十餘萬，浮船牂柯江，出其不意，此制越一奇也。誠以漢之彊，巴蜀之饒，通夜郎道，為置吏，易甚。」上許之。乃拜蒙為郎中將，將千人，食重萬餘人，從巴蜀筰關入，遂見夜郎侯多同。蒙厚賜，喻以威德，約為置吏，使其子為令。夜郎旁小邑皆貪漢繒帛，以為漢道險，終不能有也，乃且聽蒙約。還報，乃以為犍為郡。發巴蜀卒治道，自僰道指牂柯江。蜀人司馬相如亦言西夷邛、筰可置郡。使相如以郎中將往喻，皆如南夷，為置一都尉，十餘縣，屬蜀。","evidence":[{"chapter_id":"c-shiji-116-xinanyi","source_id":"s-shiji116-xinanyi","paragraph_id":"c-shiji-116-xinanyi:p003","quote_passage_ref":"data/corpus/shiji/116.json"}],"references":[{"title":"《史記曆書》索隱·太初改歲首","url":"https://zh.wikisource.org/w/index.php?title=史記三家註/卷026&oldid=2514838","quote":"然漢始以建亥爲年首，今改以建寅，故以七年爲元年。","scope":"received_calendar_rule","text_layer":"suoyin_commentary","revision_id":2514838,"image_verified":false},{"title":"《史記·漢興以來將相名臣年表》","url":"https://zh.wikisource.org/w/index.php?title=史記/卷022&oldid=2607038","table_id":"shiji-022","table_cell_id":"shiji-022-t1-r067-c01","scope":"received_regnal_year_attestation","image_verified":false,"quote_passage_ref":"data/historical-tables/shiji-022.json"},{"title":"《史記·漢興以來將相名臣年表》","url":"https://zh.wikisource.org/w/index.php?title=史記/卷022&oldid=2607038","table_id":"shiji-022","table_cell_id":"shiji-022-t1-r072-c01","scope":"received_regnal_year_attestation","image_verified":false,"quote_passage_ref":"data/historical-tables/shiji-022.json"},{"title":"《史記·漢興以來將相名臣年表》","url":"https://zh.wikisource.org/w/index.php?title=史記/卷022&oldid=2607038","table_id":"shiji-022","table_cell_id":"shiji-022-t1-r072-c00","scope":"digital_editorial_regnal_year_equivalence_only","image_verified":false,"quote_passage_ref":"data/historical-tables/shiji-022.json"}],"regnal_year_table":{"kind":"table_year_row","table_id":"shiji-022","work_id":"w-shiji","book_id":"b-shiji-022","chapter_id":"table-chapter-shiji-022","source_id":"table-witness-shiji-022","source_revision":"2607038","era_name":"建元","year_source_term":"六年","era_anchor_cell_id":"shiji-022-t1-r067-c01","regnal_year_cell_id":"shiji-022