d":"c-shiji-116-xinanyi:p003","chapter_id":"c-shiji-116-xinanyi"},{"id":"c-shiji-116-xinanyi:m003-0040","start":40,"end":41,"surface":"蒙","kind":"person","person_id":"a62_lwv_9ui","status":"contextual_provisional","paragraph_id":"c-shiji-116-xinanyi:p003","chapter_id":"c-shiji-116-xinanyi"},{"id":"c-shiji-116-xinanyi:m003-0045","start":45,"end":46,"surface":"蒙","kind":"person","person_id":"a62_lwv_9ui","status":"contextual_provisional","paragraph_id":"c-shiji-116-xinanyi:p003","chapter_id":"c-shiji-116-xinanyi"},{"id":"c-shiji-116-xinanyi:m003-0073","start":73,"end":74,"surface":"蒙","kind":"person","person_id":"a62_lwv_9ui","status":"contextual_provisional","paragraph_id":"c-shiji-116-xinanyi:p003","chapter_id":"c-shiji-116-xinanyi"},{"id":"c-shiji-116-xinanyi:m003-0147","start":147,"end":148,"surface":"蒙","kind":"person","person_id":"a62_lwv_9ui","status":"contextual_provisional","paragraph_id":"c-shiji-116-xinanyi:p003","chapter_id":"c-shiji-116-xinanyi"},{"id":"c-shiji-116-xinanyi:m003-0262","start":262,"end":263,"surface":"蒙","kind":"person","person_id":"a62_lwv_9ui","status":"contextual_provisional","paragraph_id":"c-shiji-116-xinanyi:p003","chapter_id":"c-shiji-116-xinanyi"},{"id":"c-shiji-116-xinanyi:m003-0293","start":293,"end":294,"surface":"蒙","kind":"person","person_id":"a62_lwv_9ui","status":"contextual_provisional","paragraph_id":"c-shiji-116-xinanyi:p003","chapter_id":"c-shiji-116-xinanyi"},{"id":"c-shiji-116-xinanyi:m003-0339","start":339,"end":340,"surface":"蒙","kind":"person","person_id":"a62_lwv_9ui","status":"contextual_provisional","paragraph_id":"c-shiji-116-xinanyi:p003","chapter_id":"c-shiji-116-xinanyi"},{"id":"c-shiji-116-xinanyi:m012-0017","start":17,"end":19,"surface":"唐蒙","kind":"person","person_id":"a62_lwv_9ui","status":"contextual_provisional","paragraph_id":"c-shiji-116-xinanyi:p012","chapter_id":"c-shiji-116-xinanyi"},{"id":"c-shiji-117-xiangru:m031-0008","start":8,"end":10,"surface":"唐蒙","kind":"person","person_id":"a62_lwv_9ui","status":"contextual_provisional","paragraph_id":"c-shiji-117-xiangru:p031","chapter_id":"c-shiji-117-xiangru"},{"id":"c-shiji-117-xiangru:m031-0062","start":62,"end":64,"surface":"唐蒙","kind":"person","person_id":"a62_lwv_9ui","status":"contextual_provisional","paragraph_id":"c-shiji-117-xiangru:p031","chapter_id":"c-shiji-117-xiangru"},{"id":"c-shiji-117-xiangru:m035-0005","start":5,"end":7,"surface":"唐蒙","kind":"person","person_id":"a62_lwv_9ui","status":"contextual_provisional","paragraph_id":"c-shiji-117-xiangru:p035","chapter_id":"c-shiji-117-xiangru"}],"relations":[],"title_holdings":[{"id":"th-shiji116-006","person_id":"a62_lwv_9ui","title":"番陽令","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-116-xinanyi","source_id":"s-shiji116-xinanyi","paragraph_id":"c-shiji-116-xinanyi:p003","quote":"建元六年，大行王恢擊東越，東越殺王郢以報。恢因兵威使番陽令唐蒙風指曉南越。南越食蒙蜀枸醬，蒙問所從來，曰「道西北牂柯，牂柯江廣數里，出番禺城下」。蒙歸至長安，問蜀賈人，賈人曰：「獨蜀出枸醬，多持竊出市夜郎。夜郎者，臨牂柯江，江廣百餘步，足以行船。南越以財物役屬夜郎，西至同師，然亦不能臣使也。」蒙乃上書說上曰：「南越王黃屋左纛，地東西萬餘里，名為外臣，實一州主也。今以長沙、豫章往，水道多絕，難行。竊聞夜郎所有精兵，可得十餘萬，浮船牂柯江，出其不意，此制越一奇也。誠以漢之彊，巴蜀之饒，通夜郎道，為置吏，易甚。」上許之。乃拜蒙為郎中將，將千人，食重萬餘人，從巴蜀筰關入，遂見夜郎侯多同。蒙厚賜，喻以威德，約為置吏，使其子為令。夜郎旁小邑皆貪漢繒帛，以為漢道險，終不能有也，乃且聽蒙約。還報，乃以為犍為郡。發巴蜀卒治道，自僰道指牂柯江。蜀人司馬相如亦言西夷邛、筰可置郡。使相如以郎中將往喻，皆如南夷，為置一都尉，十餘縣，屬蜀。"}],"attestations":[{"id":"th-shiji116-006:a001","paragraph_id":"c-shiji-116-xinanyi:p003","start":26,"end":29,"surface":"番陽令","person_mention_id":"c-shiji-116-xinanyi:m003-0029","usage":"narrative","date_expression":"建元六年"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授任與文獻用稱分開。使其子為令記授任；未名子不補姓名。稱君不擴寫王號，番陽原字保留；未知任期端點不補。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji116-007","person_id":"a62_lwv_9ui","title":"郎中將","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-116-xinanyi","source_id":"s-shiji116-xinanyi","paragraph_id":"c-shiji-116-xinanyi:p003","quote":"建元六年，大行王恢擊東越，東越殺王郢以報。恢因兵威使番陽令唐蒙風指曉南越。南越食蒙蜀枸醬，蒙問所從來，曰「道西北牂柯，牂柯江廣數里，出番禺城下」。蒙歸至長安，問蜀賈人，賈人曰：「獨蜀出枸醬，多持竊出市夜郎。夜郎者，臨牂柯江，江廣百餘步，足以行船。南越以財物役屬夜郎，西至同師，然亦不能臣使也。」蒙乃上書說上曰：「南越王黃屋左纛，地東西萬餘里，名為外臣，實一州主也。今以長沙、豫章往，水道多絕，難行。竊聞夜郎所有精兵，可得十餘萬，浮船牂柯江，出其不意，此制越一奇也。誠以漢之彊，巴蜀之饒，通夜郎道，為置吏，易甚。」上許之。乃拜蒙為郎中將，將千人，食重萬餘人，從巴蜀筰關入，遂見夜郎侯多同。蒙厚賜，喻以威德，約為置吏，使其子為令。夜郎旁小邑皆貪漢繒帛，以為漢道險，終不能有也，乃且聽蒙約。還報，乃以為犍為郡。發巴蜀卒治道，自僰道指牂柯江。蜀人司馬相如亦言西夷邛、筰可置郡。使相如以郎中將往喻，皆如南夷，為置一都尉，十餘縣，屬蜀。"}],"attestations":[{"id":"th-shiji116-007:a001","paragraph_id":"c-shiji-116-xinanyi:p003","start":264,"end":267,"surface":"郎中將","person_mention_id":"c-shiji-116-xinanyi:m003-0029","usage":"narrative","date_expression":"建元六年"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":"建元六年","evidence":[{"chapter_id":"c-shiji-116-xinanyi","source_id":"s-shiji116-xinanyi","paragraph_id":"c-shiji-116-xinanyi:p003","quote":"建元六年，大行王恢擊東越，東越殺王郢以報。恢因兵威使番陽令唐蒙風指曉南越。南越食蒙蜀枸醬，蒙問所從來，曰「道西北牂柯，牂柯江廣數里，出番禺城下」。蒙歸至長安，問蜀賈人，賈人曰：「獨蜀出枸醬，多持竊出市夜郎。夜郎者，臨牂柯江，江廣百餘步，足以行船。南越以財物役屬夜郎，西至同師，然亦不能臣使也。」蒙乃上書說上曰：「南越王黃屋左纛，地東西萬餘里，名為外臣，實一州主也。今以長沙、豫章往，水道多絕，難行。竊聞夜郎所有精兵，可得十餘萬，浮船牂柯江，出其不意，此制越一奇也。誠以漢之彊，巴蜀之饒，通夜郎道，為置吏，易甚。」上許之。乃拜蒙為郎中將，將千人，食重萬餘人，從巴蜀筰關入，遂見夜郎侯多同。蒙厚賜，喻以威德，約為置吏，使其子為令。夜郎旁小邑皆貪漢繒帛，以為漢道險，終不能有也，乃且聽蒙約。還報，乃以為犍為郡。發巴蜀卒治道，自僰道指牂柯江。蜀人司馬相如亦言西夷邛、筰可置郡。使相如以郎中將往喻，皆如南夷，為置一都尉，十餘縣，屬蜀。"}],"normalized_date":{"era":"BCE","era_year":135,"year":-134,"year_numbering":"astronomical","precision":"year","status":"editorial_provisional","original_quote":"建元六年，大行王恢擊東越，東越殺王郢以報。恢因兵威使番陽令唐蒙風指曉南越。南越食蒙蜀枸醬，蒙問所從來，曰「道西北牂柯，牂柯江廣數里，出番禺城下」。蒙歸至長安，問蜀賈人，賈人曰：「獨蜀出枸醬，多持竊出市夜郎。夜郎者，臨牂柯江，江廣百餘步，足以行船。南越以財物役屬夜郎，西至同師，然亦不能臣使也。」蒙乃上書說上曰：「南越王黃屋左纛，地東西萬餘里，名為外臣，實一州主也。今以長沙、豫章往，水道多絕，難行。竊聞夜郎所有精兵，可得十餘萬，浮船牂柯江，出其不意，此制越一奇也。誠以漢之彊，巴蜀之饒，通夜郎道，為置吏，易甚。」上許之。乃拜蒙為郎中將，將千人，食重萬餘人，從巴蜀筰關入，遂見夜郎侯多同。蒙厚賜，喻以威德，約為置吏，使其子為令。夜郎旁小邑皆貪漢繒帛，以為漢道險，終不能有也，乃且聽蒙約。還報，乃以為犍為郡。發巴蜀卒治道，自僰道指牂柯江。蜀人司馬相如亦言西夷邛、筰可置郡。使相如以郎中將往喻，皆如南夷，為置一都尉，十餘縣，屬蜀。","evidence":[{"chapter_id":"c-shiji-116-xinanyi","source_id":"s-shiji116-xinanyi","paragraph_id":"c-shiji-116-xinanyi:p003","quote":"建元六年，大