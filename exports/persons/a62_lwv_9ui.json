lved","person_id":null,"status":"unresolved"},{"id":"c-shiji-116-xinanyi:m003-0256","start":256,"end":257,"surface":"上","kind":"person","person_id":"nvi_c32_k29","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m003-0262","start":262,"end":263,"surface":"蒙","kind":"person","person_id":"a62_lwv_9ui","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m003-0290","start":290,"end":292,"surface":"多同","kind":"person","person_id":"98i_dd4_aof","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m003-0293","start":293,"end":294,"surface":"蒙","kind":"person","person_id":"a62_lwv_9ui","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m003-0308","start":308,"end":310,"surface":"其子","kind":"person","person_id":"98i_dd4_aof_A","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m003-0339","start":339,"end":340,"surface":"蒙","kind":"person","person_id":"a62_lwv_9ui","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m003-0369","start":369,"end":373,"surface":"司馬相如","kind":"person","person_id":"usb_lgr_ksa","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m003-0385","start":385,"end":387,"surface":"相如","kind":"person","person_id":"usb_lgr_ksa","status":"contextual_provisional"}],"chapter_id":"c-shiji-116-xinanyi","book_id":"b-shiji-116","work_id":"w-shiji","source_id":"s-shiji116-xinanyi"},{"id":"c-shiji-116-xinanyi:p012","text":"西南外徼，莊蹻首通。漢因大夏，乃命唐蒙。勞洸、靡莫，異俗殊風。夜郎最大，邛、筰稱雄。及置郡縣，萬代推功。","annotation_status":"in_progress","text_layer":"witness_appended_suoyin_zan","mentions":[{"id":"c-shiji-116-xinanyi:m012-0005","start":5,"end":7,"surface":"莊蹻","kind":"person","person_id":"b1y_l5y_xmz","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m012-0017","start":17,"end":19,"surface":"唐蒙","kind":"person","person_id":"a62_lwv_9ui","status":"contextual_provisional"}],"chapter_id":"c-shiji-116-xinanyi","book_id":"b-shiji-116","work_id":"w-shiji","source_id":"s-shiji116-xinanyi"},{"id":"c-shiji-117-xiangru:p031","text":"相如為郎數歲，會唐蒙使略通夜郎西僰中，發巴蜀吏卒千人，郡又多為發轉漕萬餘人，用興法誅其渠帥，巴蜀民大驚恐。上聞之，乃使相如責唐蒙，因喻告巴蜀民以非上意。檄曰：","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m031-0000","start":0,"end":2,"surface":"相如","kind":"person","person_id":"usb_lgr_ksa","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m031-0008","start":8,"end":10,"surface":"唐蒙","kind":"person","person_id":"a62_lwv_9ui","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m031-0043","start":43,"end":45,"surface":"渠帥","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m031-0053","start":53,"end":54,"surface":"上","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m031-0059","start":59,"end":61,"surface":"相如","kind":"person","person_id":"usb_lgr_ksa","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m031-0062","start":62,"end":64,"surface":"唐蒙","kind":"person","person_id":"a62_lwv_9ui","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m031-0073","start":73,"end":74,"surface":"上","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"}],"chapter_id":"c-shiji-117-xiangru","book_id":"b-shiji-117","work_id":"w-shiji","source_id":"s-shiji117-xiangru"},{"id":"c-shiji-117-xiangru:p035","text":"相如還報。唐蒙已略通夜郎，因通西南夷道，發巴、蜀、廣漢卒，作者數萬人。治道二歲，道不成，士卒多物故，費以巨萬計。蜀民及漢用事者多言其不便。是時邛筰之君長聞南夷與漢通，得賞賜多，多欲原為內臣妾，請吏，比南夷。天子問相如，相如曰：「邛、筰、厓、駹者近蜀，道亦易通，秦時嘗通為郡縣，至漢興而罷。今誠複通，為置郡縣，愈於南夷。」天子以為然，乃拜相如為中郎將，建節往使。副使王然於、壺充國、呂越人馳四乘之傳，因巴蜀吏幣物以賂西夷。至蜀，蜀太守以下郊迎，縣令負弩矢先驅，蜀人以為寵。於是卓王孫、臨邛諸公皆因門下獻牛酒以交驩。卓王孫喟然而歎，自以得使女尚司馬長卿晚，而厚分與其女財，與男等同。司馬長卿便略定西夷，邛、筰、厓、駹、斯榆之君皆請為內臣。除邊關，關益斥，西至沬、若水，南至牂柯為徼，通零關道，橋孫水以通邛都。還報天子，天子大說。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m035-0000","start":0,"end":2,"surface":"相如","kind":"person","person_id":"usb_lgr_ksa","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0005","start":5,"end":7,"surface":"唐蒙","kind":"person","person_id":"a62_lwv_9ui","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0073","start":73,"end":75,"surface":"之君","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m035-0103","start":103,"end":105,"surface":"天子","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0106","start":106,"end":108,"surface":"相如","kind":"person","person_id":"usb_lgr_ksa","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0109","start":109,"end":111,"surface":"相如","kind":"person","person_id":"usb_lgr_ksa","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0160","start":160,"end":162,"surface":"天子","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0168","start":168,"end":170,"surface":"相如","kind":"person","person_id":"usb_lgr_ksa","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0182","start":182,"end":185,"surface":"王然於","kind":"person","person_id":"hpw_2ip_uqk","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0186","start":186,"end":189,"surface":"壺充國","kind":"person","person_id":"8wd_fcv_stu","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0190","start":190,"end":193,"surface":"呂越人","kind":"person","person_id":"miw_t0v_k64","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0213","start":213,"end":216,"surface":"蜀太守","kind":"person","person_id":"2zx_wew_zui","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0237","start":237,"end":240,"surface":"卓王孫","kind":"person","person_id":"lh2_c9g_7vs","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0256","start":256,"end":259,"surface":"卓王孫","kind":"person","person_id":"lh2_c9g_7vs","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0270","start":270,"end":274,"surface":"司馬長卿","kind":"person","pe