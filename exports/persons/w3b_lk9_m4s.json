3325,3326,3327,3328,3329,3330],"revision_id":1748911},"mentions":[{"id":"c-nanqishu-059-western-polities-complete:p019:m0004","start":4,"end":7,"surface":"范柏年","kind":"person","person_id":"w3b_lk9_m4s","status":"contextual_provisional"},{"id":"c-nanqishu-059-western-polities-complete:p019:m0013","start":13,"end":16,"surface":"李烏奴","kind":"person","person_id":"mky_3oo_gaa","status":"contextual_provisional"},{"id":"c-nanqishu-059-western-polities-complete:p019:m0020","start":20,"end":22,"surface":"文弘","kind":"person","person_id":"zdb_1c5_ffp","status":"contextual_provisional"},{"id":"c-nanqishu-059-western-polities-complete:p019:m0025","start":25,"end":27,"surface":"烏奴","kind":"person","person_id":"mky_3oo_gaa","status":"contextual_provisional"},{"id":"c-nanqishu-059-western-polities-complete:p019:m0040","start":40,"end":43,"surface":"王玄邈","kind":"person","person_id":"hgq_k4y_crp","status":"contextual_provisional"},{"id":"c-nanqishu-059-western-polities-complete:p019:m0056","start":56,"end":60,"surface":"豫章王嶷","kind":"person","person_id":"ijh_3fs_6u2","status":"contextual_provisional"},{"id":"c-nanqishu-059-western-polities-complete:p019:m0063","start":63,"end":65,"surface":"烏奴","kind":"person","person_id":"mky_3oo_gaa","status":"contextual_provisional"},{"id":"c-nanqishu-059-western-polities-complete:p019:m0072","start":72,"end":74,"surface":"烏奴","kind":"person","person_id":"mky_3oo_gaa","status":"contextual_provisional"},{"id":"c-nanqishu-059-western-polities-complete:p019:m0080","start":80,"end":82,"surface":"烏奴","kind":"person","person_id":"mky_3oo_gaa","status":"contextual_provisional"},{"id":"c-nanqishu-059-western-polities-complete:p019:m0091","start":91,"end":93,"surface":"廣香","kind":"person","person_id":"rdb_pcr_z28","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-059-western-polities-complete","book_id":"b-nanqishu-059","work_id":"w-nanqishu","source_id":"s-nanqishu-059-western-polities-complete-ws1748911"},{"id":"c-nanqishu-059-western-polities-complete:p020","text":"夫廢興無謬，逆順有恒，古今共貫；賢愚同察。梁州刺史范柏年懷挾詭態，首鼠兩端，既已被伐，盤桓稽命。遂潛遣李烏奴叛。楊文弘扇誘邊疆荒雜。柏年今已梟禽，烏奴頻被摧破，計其餘燼，行自消夷。今遣參軍行晉壽太守王道寶、參軍事行北巴西新巴二郡太守任湜之、行宕渠太守王安會領銳卒三千，遄塗風邁，浮川電掩。又命輔國將軍三巴校尉明惠照、巴郡太守魯休烈、南巴西太守柳弘稱、益州刺史傅琰，竝簡徒競騖，選甲爭馳。雍州水步，行次魏興，并山東僑舊，會于南鄭。或汎舟墊江，或飛旍劍道，腹背飊騰，表裏震擊。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":51,"last_line":51,"raw_start":3333,"raw_end":3609,"raw_character_offsets":[3334,3335,3336,3337,3338,3339,3340,3341,3342,3343,3344,3345,3346,3347,3348,3349,3350,3351,3352,3353,3354,3355,3356,3357,3358,3359,3360,3361,3362,3363,3364,3365,3366,3367,3368,3369,3370,3371,3372,3373,3374,3375,3376,3416,3417,3418,3419,3420,3421,3422,3423,3424,3425,3426,3427,3428,3429,3430,3431,3432,3433,3434,3435,3436,3437,3438,3439,3440,3441,3442,3443,3444,3445,3446,3447,3448,3449,3450,3451,3452,3453,3454,3455,3456,3457,3458,3459,3460,3461,3462,3463,3464,3465,3466,3467,3468,3469,3470,3471,3472,3473,3474,3475,3476,3477,3478,3479,3480,3481,3482,3483,3484,3485,3486,3487,3488,3489,3490,3491,3492,3493,3494,3495,3496,3497,3498,3499,3500,3501,3502,3503,3504,3505,3506,3507,3508,3509,3510,3511,3512,3513,3514,3515,3516,3517,3518,3519,3520,3521,3522,3523,3524,3525,3526,3527,3528,3529,3530,3531,3532,3533,3534,3535,3536,3537,3538,3539,3540,3541,3542,3543,3544,3545,3546,3547,3548,3549,3550,3551,3552,3553,3554,3555,3556,3557,3558,3559,3560,3561,3562,3563,3564,3565,3566,3567,3568,3569,3570,3571,3572,3573,3574,3575,3576,3577,3578,3579,3580,3581,3582,3583,3584,3585,3586,3587,3588,3589,3590,3591,3592,3593,3594,3595,3596,3597,3598,3599,3600,3601,3602,3603,3604,3605,3606,3607,3608],"revision_id":1748911},"mentions":[{"id":"c-nanqishu-059-western-polities-complete:p020:m0025","start":25,"end":28,"surface":"范柏年","kind":"person","person_id":"w3b_lk9_m4s","status":"contextual_provisional"},{"id":"c-nanqishu-059-western-polities-complete:p020:m0051","start":51,"end":54,"surface":"李烏奴","kind":"person","person_id":"mky_3oo_gaa","status":"contextual_provisional"},{"id":