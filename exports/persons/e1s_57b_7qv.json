{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"e1s_57b_7qv","canonical_person_id":"e1s_57b_7qv","id_aliases":["cbr-p003569"],"identity_policy":"contextual_provisional","person_ids":["e1s_57b_7qv"],"persons":[{"id":"e1s_57b_7qv","label":"尹霸（梁孝王世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"郎中尹霸","mention_ids":["c-shiji-058-liang:m016-0217"]}],"evidence":[{"mention_id":"c-shiji-058-liang:m016-0217","chapter_id":"c-shiji-058-liang","paragraph_id":"c-shiji-058-liang:p016","quote":"郎中尹霸"}],"id_aliases":["cbr-p003569"]}],"source_mention_summary":[{"source_id":"s-shiji-058-liang","work_id":"w-shiji","book_id":"b-shiji-058","chapter_id":"c-shiji-058-liang","mention_count":1,"mention_ids":["c-shiji-058-liang:m016-0217"],"paragraph_ids":["c-shiji-058-liang:p016"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-058-liang"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-058-liang:m016-0217","start":217,"end":221,"surface":"郎中尹霸","kind":"person","person_id":"e1s_57b_7qv","status":"contextual_provisional","paragraph_id":"c-shiji-058-liang:p016","chapter_id":"c-shiji-058-liang"}],"relations":[],"title_holdings":[{"id":"th-shiji058-036","person_id":"e1s_57b_7qv","title":"郎中","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-058-liang","source_id":"s-shiji-058-liang","paragraph_id":"c-shiji-058-liang:p016","quote":"梁平王襄十四年，母曰陳太后。共王母曰李太后。李太后，親平王之大母也。而平王之后姓任，曰任王后。任王后甚有寵於平王襄。初，孝王在時，有罍樽，直千金。孝王誡後世，善保罍樽，無得以與人。任王后聞而欲得罍樽。平王大母李太后曰：「先王有命，無得以罍樽與人。他物雖百巨萬，猶自恣也。」任王后絕欲得之。平王襄直使人開府取罍樽，賜任王后。李太后大怒，漢使者來，欲自言，平王襄及任王后遮止，閉門，李太后與爭門，措指，遂不得見漢使者。李太后亦私與食官長及郎中尹霸等士通亂，而王與任王后以此使人風止李太后，李太后內有淫行，亦已。後病薨。病時，任后未嘗請病；薨，又不持喪。"}],"attestations":[{"id":"th-shiji058-036:a001","paragraph_id":"c-shiji-058-liang:p016","start":217,"end":219,"surface":"郎中","person_mention_id":"c-shiji-058-liang:m016-0217","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授封、改封、敘事用稱與諡稱分存；相對年數及來源年號保留，不換算公曆，不從首次用稱或死亡補任期。未名群體不造個別官爵。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji058-030","person_id":"e1s_57b_7qv","surfaces":["郎中尹霸"],"scope":"same_chapter","chapter_ids":["c-shiji-058-liang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-058-liang:p016","quote":"梁平王襄十四年，母曰陳太后。共王母曰李太后。李太后，親平王之大母也。而平王之后姓任，曰任王后。任王后甚有寵於平王襄。初，孝王在時，有罍樽，直千金。孝王誡後世，善保罍樽，無得以與人。任王后聞而欲得罍樽。平王大母李太后曰：「先王有命，無得以罍樽與人。他物雖百巨萬，猶自恣也。」任王后絕欲得之。平王襄直使人開府取罍樽，賜任王后。李太后大怒，漢使者來，欲自言，平王襄及任王后遮止，閉門，李太后與爭門，措指，遂不得見漢使者。李太后亦私與食官長及郎中尹霸等士通亂，而王與任王后以此使人風止李太后，李太后內有淫行，亦已。後病薨。病時，任后未嘗請病；薨，又不持喪。"}],"rationale":"按明示姓名、世系與局部王號暫接。梁武、勝、參、登、義、買、襄等不按同王號合併；梁王勝與羊勝分辨。李太后陳太后分存；主張、指控、泛稱與授職分辨，正文與附述各保留。官爵全史與跨篇身份仍待覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-058-liang:p016","text":"梁平王襄十四年，母曰陳太后。共王母曰李太后。李太后，親平王之大母也。而平王之后姓任，曰任王后。任王后甚有寵於平王襄。初，孝王在時，有罍樽，直千金。孝王誡後世，善保罍樽，無得以與人。任王后聞而欲得罍樽。平王大母李太后曰：「先王有命，無得以罍樽與人。他物雖百巨萬，猶自恣也。」任王后絕欲得之。平王襄直使人開府取罍樽，賜任王后。李太后大怒，漢使者來，欲自言，平王襄及任王后遮止，閉門，李太后與爭門，措指，遂不得見漢使者。李太后亦私與食官長及郎中尹霸等士通亂，而王與任王后以此使人風止李太后，李太后內有淫行，亦已。後病薨。病時，任后未嘗請病；薨，又不持喪。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-058-liang:m016-0000","start":0,"end":4,"surface":"梁平王襄","kind":"person","person_id":"82d_8vl_8i1_AAA","status":"contextual_provisional"},{"id":"c-