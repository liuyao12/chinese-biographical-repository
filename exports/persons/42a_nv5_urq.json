ce_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-003-yin","source_id":"s-shiji-003-yin","paragraph_id":"c-shiji-003-yin:p031","quote":"紂愈淫亂不止。微子數諫不聽，乃與大師、少師謀，遂去。比干曰：「為人臣者，不得不以死爭。」迺強諫紂。紂怒曰：「吾聞聖人心有七竅。」剖比干，觀其心。箕子懼，乃詳狂為奴，紂又囚之。殷之大師、少師乃持其祭樂器奔周。周武王於是遂率諸侯伐紂。紂亦發兵距之牧野。甲子日，紂兵敗。紂走，入登鹿臺，衣其寶玉衣，赴火而死。周武王遂斬紂頭，縣之大白旗。殺妲己。釋箕子之囚，封比干之墓，表商容之閭。封紂子武庚祿父，以續殷祀，令修行盤庚之政。殷民大說。於是周武王為天子。其後世貶帝號，號為王。而封殷後為諸侯，屬周。","person_mention_id":"c-shiji-003-yin:m031-0166"}],"source_term":"殺妲己","interpretation_note":"依本段明言崩、卒、死或殺害保存；剖心、醢、脯保留原語。未知年分不補造；不據死亡推定全部稱號終點。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"mentions":[{"id":"c-beishi-072-zhanglihua-gaojiong:p001:m0053","surface":"妲己","start":53,"end":55,"person_id":"42a_nv5_urq","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-beishi-072-zhanglihua-gaojiong:p001","chapter_id":"c-beishi-072-zhanglihua-gaojiong"},{"id":"c-shiji-003-yin:m028-0065","start":65,"end":67,"surface":"妲己","kind":"person","person_id":"42a_nv5_urq","status":"source_identified","paragraph_id":"c-shiji-003-yin:p028","chapter_id":"c-shiji-003-yin"},{"id":"c-shiji-003-yin:m028-0068","start":68,"end":70,"surface":"妲己","kind":"person","person_id":"42a_nv5_urq","status":"source_identified","paragraph_id":"c-shiji-003-yin:p028","chapter_id":"c-shiji-003-yin"},{"id":"c-shiji-003-yin:m031-0166","start":166,"end":168,"surface":"妲己","kind":"person","person_id":"42a_nv5_urq","status":"source_identified","paragraph_id":"c-shiji-003-yin:p031","chapter_id":"c-shiji-003-yin"},{"id":"c-suishu-041-zhanglihua-gaojiong:p002:m0056","surface":"妲己","start":56,"end":58,"person_id":"42a_nv5_urq","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-suishu-041-zhanglihua-gaojiong:p002","chapter_id":"c-suishu-041-zhanglihua-gaojiong"},{"id":"c-zizhitongjian-177-zhanglihua-gaojiong:p001:m0044","surface":"妲己","start":44,"end":46,"person_id":"42a_nv5_urq","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-zizhitongjian-177-zhanglihua-gaojiong:p001","chapter_id":"c-zizhitongjian-177-zhanglihua-gaojiong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-beishi-072-zhanglihua-gaojiong:p001","text":"九年，晉王廣大舉伐陳，以熲為無帥長史，三軍皆取斷於熲。及陳平，晉王欲納陳主寵姬張麗華。熲曰：「武王滅殷，戮妲己。今平陳國，不宜取麗華。」乃命斬之。王甚不悅。","mentions":[{"id":"c-beishi-072-zhanglihua-gaojiong:p001:m0003","surface":"晉王廣","start":3,"end":6,"person_id":"ce8_yhf_283_AAAAAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-beishi-072-zhanglihua-gaojiong:p001:m0039","surface":"張麗華","start":39,"end":42,"person_id":"3jv_fyp_o96","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-beishi-072-zhanglihua-gaojiong:p001:m0047","surface":"武王","start":47,"end":49,"person_id":"y4i_pjk_4gn_AA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-beishi-072-zhanglihua-gaojiong:p001:m0053","surface":"妲己","start":53,"end":55,"person_id":"42a_nv5_urq","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":1153541,"source_layer":"received_biography","first_line":17,"last_line":17,"line_start":0,"line_end":78,"raw_start":1222,"raw_end":1300,"raw_character_offsets":[1222,1223,1224,1225,1226,1227,1228,1229,1230,1231,1232,1233,1234,1235,1236,1237,1238,1239,1240,1241,1242,1243,1244,1245,1246,1247,1248,1249,1250,1251,1252,1253,1254,1255,1256,1257,1258,1259,1260,1261,1262,1263,1264,1265,1266,1267,1268,1269,1270,1271,1272,1273,1274,1275,1276,1277,1278,1279,1280,1281,1282,1283,1284,1285,1286,1287,1288,1289,1290,1291,1292,1293,1294,1295,1296,1297,1298,1299],"projection_sha256":"d4d98e6f8931fbc65520db4cba1b5a1ccf48647ce9b68f0807c25b130f4000c7"},"chapter_id":"c-beishi-072-zhanglihua-gaojiong","book_id":"b-beishi-072","work_id":"w-beishi","source_id":"s-beishi-072-zhanglihua-gaojiong-ws1153541"},{"id":"c-shiji-003-yin:p028","text":"帝紂資辨捷疾，聞見甚敏；材力過人，手格猛獸；知足以距諫，言足以飾非；矜人臣以能，高天下以聲，以為皆出己之下。好酒淫樂，嬖於婦人。愛妲己，妲己之言是從。於是使師涓作新淫聲，北里之舞，靡靡之樂。厚賦稅以實鹿臺之錢，而盈鉅橋之粟。益收狗馬奇物，充仞宮室。益廣沙丘苑臺，多取野獸蜚鳥置其中。慢於鬼神。大㝡樂戲於沙丘，以酒為池，縣肉為林，使男女倮相逐其閒，為長夜之飲。","mentions":[{"id":"c-shiji-003-yin:m028-0000","start":0,"end":2,"surface":"帝紂","kind":"person","person_id":"lwx_9yq_ad7","status":"source_identified"},{"id":"c-shiji-003-yin:m028-0065","start":65,"end":67,"surface":"妲己","kind":"person","person_id":"42a_nv5_urq","status":"source_identified"},{"id":"c-shiji-003-yin:m028-0068","start":68,"end":70,"surface":"妲己","kind":"person","person_id":"42a_nv5_urq","status":"source_identified"},{"id":"c-shiji-003-yin:m028-0078","start":78,"end":80,"surface":"師涓","kind":"person","person_id":"pda_eev_m2h","status":"source_identified"}],"annotation_status":"in_progress","chapter_id":"c-shiji-003-yin","book_id":"b-shiji-003","work_id":"w-shiji","source_id":"s-shiji-003-yin"},{"id":"c-shiji-003-yin:p031","text":"紂愈淫亂不止。微子數諫不聽，乃與大師、少師謀，遂去。比干曰：「為人臣者，不得不以死爭。」迺強諫紂。紂怒曰：「吾聞聖人心有七竅。」剖比干，觀其心。箕子懼，乃詳狂為奴，紂又囚之。殷之大師、少師乃持其祭樂器奔周。周武王於是遂率諸侯伐紂。紂亦發兵距之牧野。甲子日，紂兵敗。紂走，入登鹿臺，衣其寶玉衣，赴火而死。周武王遂斬紂頭，縣之大白旗。殺妲己。釋箕子之囚，封比干之墓，表商容之閭。封紂子武庚祿父，以續殷祀，令修行盤庚之政。殷民大說。於是周武王為天子。其後世貶帝號，號為王。而封殷後為諸侯，屬周。","mentions":[{"id":"c-shiji-003-yin:m031-0000","start":0,"end":1,"surface":"紂","kind":"person","person_id":"lwx_9yq_ad7","status":"source_identified"},{"id":"c-shiji-003-yin:m031-0007","start":7,"end":9,"surface":"微子","kind":"person","person_id":"buv_igi_gpn_A","status":"source_identified"},{"id":"c-shiji-003-yin:m031-0016","start":16,"end":18,"surface":"大師","kind":"unresolved","person_id":null,"status":"unresolved","note":"氏族、群體、官稱或未定個人指代；不由熟知故事補出姓名。"},{"id":"c-shiji-003-yin:m031-0019","start":19,"end":21,"surface":"少師","kind":"unresolv