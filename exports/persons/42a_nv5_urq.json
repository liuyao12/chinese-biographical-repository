son","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-suishu-041-zhanglihua-gaojiong:p002:m0042","surface":"張麗華","start":42,"end":45,"person_id":"3jv_fyp_o96","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-suishu-041-zhanglihua-gaojiong:p002:m0050","surface":"武王","start":50,"end":52,"person_id":"y4i_pjk_4gn_AA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-suishu-041-zhanglihua-gaojiong:p002:m0056","surface":"妲己","start":56,"end":58,"person_id":"42a_nv5_urq","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":11122985,"source_layer":"received_biography","first_line":10,"last_line":10,"line_start":239,"line_end":320,"raw_start":1216,"raw_end":1297,"raw_character_offsets":[1216,1217,1218,1219,1220,1221,1222,1223,1224,1225,1226,1227,1228,1229,1230,1231,1232,1233,1234,1235,1236,1237,1238,1239,1240,1241,1242,1243,1244,1245,1246,1247,1248,1249,1250,1251,1252,1253,1254,1255,1256,1257,1258,1259,1260,1261,1262,1263,1264,1265,1266,1267,1268,1269,1270,1271,1272,1273,1274,1275,1276,1277,1278,1279,1280,1281,1282,1283,1284,1285,1286,1287,1288,1289,1290,1291,1292,1293,1294,1295,1296],"projection_sha256":"84a5ef4c1728d5377acf9fd88ab413441a3e296f4da2c0bec21c4fdaccc1c561"},"chapter_id":"c-suishu-041-zhanglihua-gaojiong","book_id":"b-suishu-041","work_id":"w-suishu","source_id":"s-suishu-041-zhanglihua-gaojiong-ws11122985"},{"id":"c-zizhitongjian-177-zhanglihua-gaojiong:p001","text":"高熲先入建康，熲子德弘為晉王廣記室，廣使德弘馳詣熲所，令留張麗華，熲曰：「昔太公蒙面以斬妲己，今豈可留麗華！」乃斬之於青溪。德弘還報，廣變色曰：「昔人云，『無德不報』，我必有以報高公矣！」由是恨熲。","mentions":[{"id":"c-zizhitongjian-177-zhanglihua-gaojiong:p001:m0000","surface":"高熲","start":0,"end":2,"person_id":"goh_vpj_95z_A","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-zizhitongjian-177-zhanglihua-ga