"surface":"夫護","start":293,"end":295,"person_id":"2gy_9l8_jmz","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-jiapi:p001:m0298","surface":"疋","start":298,"end":299,"person_id":"ys9_5w4_sye","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-060-jiapi","book_id":"b-jinshu-060","work_id":"w-jinshu","source_id":"s-jinshu-060-jiapi-ws2413335"},{"id":"c-jinshu-060-suochen:p002","text":"及成都王穎劫遷惠帝幸鄴，穎為王浚所破，帝遂播越。河間王顒使張方及綝東迎乘輿，以功拜鷹楊將軍，轉南陽王模從事中郎。劉聰侵掠關東，以綝為奮威將軍以禦之，斬聰將呂逸，又破聰党劉豐，遷新平太守。聰將蘇鐵、劉五斗等劫掠三輔，除綝安西將軍、馮翊太守。綝有威恩，華夷向服，賊不敢犯。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":118,"last_line":118,"raw_start":9572,"raw_end":9708,"raw_character_offsets":[9574,9575,9576,9577,9578,9579,9580,9581,9582,9583,9584,9585,9586,9587,9588,9589,9590,9591,9592,9593,9594,9595,9596,9597,9598,9599,9600,9601,9602,9603,9604,9605,9606,9607,9608,9609,9610,9611,9612,9613,9614,9615,9616,9617,9618,9619,9620,9621,9622,9623,9624,9625,9626,9627,9628,9629,9630,9631,9632,9633,9634,9635,9636,9637,9638,9639,9640,9641,9642,9643,9644,9645,9646,9647,9648,9649,9650,9651,9652,9653,9654,9655,9656,9657,9658,9659,9660,9661,9662,9663,9664,9665,9666,9667,9668,9669,9670,9671,9672,9673,9674,9675,9676,9677,9678,9679,9680,9681,9682,9683,9684,9685,9686,9687,9688,9689,9690,9691,9692,9693,9694,9695,9696,9697,9698,9699,9700,9701,9702,9703,9704,9705,9706,9707],"revision_id":2413335},"mentions":[{"id":"c-jinshu-060-suochen:p002:m0001","surface":"成都王穎","start":1,"end":5,"person_id":"x4m_ygm_1d3","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-suochen:p002:m0007","surface":"惠帝","start":7,"end":9,"person_id":"7e0_f69_1ac","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-suochen:p002:m0012","surface":"穎","start":12,"end":13,"person_id":"x4m_ygm_1d3","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-suochen:p002:m0014","surface":"王浚","start":14,"end":16,"person_id":"9c1_ff0_1b5",