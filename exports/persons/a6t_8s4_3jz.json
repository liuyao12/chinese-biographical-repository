:42,"end":46,"surface":"平昌公模","kind":"person","person_id":"a6t_8s4_3jz","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-044-luzhi:line064","chapter_id":"c-jinshu-044-luzhi"},{"id":"c-jinshu-059-prince-yong:p006:m0016","surface":"南陽王模","start":16,"end":20,"person_id":"a6t_8s4_3jz","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-059-prince-yong:p006","chapter_id":"c-jinshu-059-prince-yong"},{"id":"c-jinshu-060-jiapi:p001:m0086","surface":"南陽王模","start":86,"end":90,"person_id":"a6t_8s4_3jz","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-060-jiapi:p001","chapter_id":"c-jinshu-060-jiapi"},{"id":"c-jinshu-060-suochen:p002:m0047","surface":"南陽王模","start":47,"end":51,"person_id":"a6t_8s4_3jz","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-060-suochen:p002","chapter_id":"c-jinshu-060-suochen"},{"id":"c-jinshu-060-suochen:p003:m0011","surface":"模","start":11,"end":12,"person_id":"a6t_8s4_3jz","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-060-suochen:p003","chapter_id":"c-jinshu-060-suochen"},{"id":"c-jinshu-062-zuti:p002:m0078","surface":"平昌公模","start":78,"end":82,"person_id":"a6t_8s4_3jz","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-062-zuti:p002","chapter_id":"c-jinshu-062-zuti"}],"relations":[],"title_holdings":[{"id":"th-w044-luzhi-20","person_id":"a6t_8s4_3jz","title":"平昌公","kind":"noble_rank","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-044","chapter_id":"c-jinshu-044-luzhi","source_id":"s-jinshu-044-luzhi","paragraph_id":"c-jinshu-044-luzhi:line064","quote":"及東海王越奉迎大駕，顒啟帝復穎還鄴，以志為魏郡太守，加左將軍，隨穎北鎮。行達洛陽，而平昌公模遣前鋒督護馮嵩距穎。穎還長安，未至而聞顒斬張方，求和於越。穎住華陰，志進長安，詣闕陳謝，即還就穎于武關。奔南陽，復為劉陶所驅，回詣河北。及穎薨，官屬奔散，唯志親自殯送，時人嘉之。越命志為軍諮祭酒，遷衛尉，永嘉末，轉尚書。洛陽沒，志將妻子北投并州刺史劉琨。至陽邑，為劉粲所虜，與次子謐、詵等俱遇害於平陽。長子諶。","person_mention_id":"c-jinshu-044-luzhi:line064:m0042"}],"attestations":[{"id":"th-w043-luzhi-20:a","