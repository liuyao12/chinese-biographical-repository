onal"},{"id":"c-jinshu-060-suochen:p003:m0118","surface":"綝","start":118,"end":119,"person_id":"u3p_4ou_4st","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-060-suochen","book_id":"b-jinshu-060","work_id":"w-jinshu","source_id":"s-jinshu-060-suochen-ws2413335"},{"id":"c-jinshu-062-zuti:p002","text":"辟齊王冏大司馬掾、長沙王乂驃騎祭酒，轉主簿，累遷太子中舍人、豫章王從事中郎。從惠帝北伐，王師敗績于蕩陰，遂退還洛。大駕西幸長安，關東諸侯范陽王虓、高密王略、平昌公模等競召之，皆不就。東海王越以逖爲典兵參軍、濟陰太守，母喪不之官。及京師大亂，逖率親黨數百家避地淮泗，以所乘車馬載同行老疾，躬自徒步，藥物衣糧與眾共之，又多權略，是以少長咸宗之，推逖爲行主。達泗口，元帝拟用爲徐州刺史，尋徵軍諮祭酒，居丹徒之京口。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":85,"last_line":85,"raw_start":8428,"raw_end":8634,"raw_character_offsets":[8430,8431,8432,8433,8434,8435,8436,8437,8438,8439,8440,8441,8442,8443,8444,8445,8446,8447,8448,8449,8450,8451,8452,8453,8454,8455,8456,8457,8458,8459,8460,8461,8462,8463,8464,8465,8466,8467,8468,8469,8470,8471,8472,8473,8474,8475,8476,8477,8478,8479,8480,8481,8482,8483,8484,8485,8486,8487,8488,8489,8490,8491,8492,8493,8494,8495,8496,8497,8498,8499,8500,8501,8502,8503,8504,8505,8506,8507,8508,8509,8510,8511,8512,8513,8514,8515,8516,8517,8518,8519,8520,8521,8522,8523,8524,8525,8526,8527,8528,8529,8530,8531,8532,8533,8534,8535,8536,8537,8538,8539,8540,8541,8542,8543,8544,8545,8546,8547,8548,8549,8550,8551,8552,8553,8554,8555,8556,8557,8558,8559,8560,8561,8562,8563,8564,8565,8566,8567,8568,8569,8570,8571,8572,8573,8574,8575,8576,8577,8578,8579,8580,8581,8582,8583,8584,8585,8586,8587,8588,8589,8590,8591,8592,8593,8594,8595,8596,8597,8598,8599,8600,8601,8602,8603,8604,8605,8606,8607,8608,8609,8610,8611,8612,8613,8614,8615,8616,8617,8618,8619,8620,8621,8622,8623,8624,8625,8626,8627,8628,8629,8630,8631,8632,8633],"revision_id":2629226},"mentions":[{"id":"c-jinshu-062-zuti:p002:m0001","surface":"齊王冏","start":1,"end":4,"person_id":"ee0_b2a_68e","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-062-zuti:p002:m0009","surface":"長沙王乂","start":9,"end":13,"person_id":"4c6_98