"end":65,"surface":"子反","kind":"person","person_id":"ylo_ygy_hws","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p026","chapter_id":"c-shiji-040-chu"}],"relations":[],"title_holdings":[{"id":"th-shiji040-037","person_id":"ylo_ygy_hws","title":"將軍","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-040-chu","source_id":"s-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p026","quote":"共王十六年，晉伐鄭。鄭告急，共王救鄭。與晉兵戰鄢陵，晉敗楚，射中共王目。共王召將軍子反。子反嗜酒，從者豎陽穀進酒醉。王怒，射殺子反，遂罷兵歸。"}],"attestations":[{"id":"th-shiji040-037:a001","paragraph_id":"c-shiji-040-chu:p026","start":39,"end":41,"surface":"將軍","person_mention_id":"c-shiji-040-chu:m026-0041","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"保存本段明示命名、既有官稱或任事用語；未知授予日與終點不按戰日、死亡、出奔或被俘補造。具體職稱制度含義仍待核。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji039-085","person_id":"k41_zyq_5ik","surfaces":["子反","楚將子反"],"scope":"cross_chapter","chapter_ids":["c-shiji-031-wu","c-shiji-039-jin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-031-wu:p005","quote":"王壽夢二年，楚之亡大夫申公巫臣怨楚將子反而犇晉，自晉使吳，教吳用兵乘車，令其子爲吳行人，吳於是始通於中國。吳伐楚。十六年，楚共王伐吳，至衡山。"},{"paragraph_id":"c-shiji-039-jin:p106","quote":"十六年，楚將子反怨巫臣，滅其族。巫臣怒，遺子反書曰：「必令子罷於奔命！」乃請使呉，令其子爲呉行人，教呉乘車用兵。呉晉始通，約伐楚。"},{"paragraph_id":"c-shiji-039-jin:p111","quote":"六年春，鄭倍晉與楚盟，晉怒。欒書曰：「不可以當吾世而失諸侯。」乃發兵。厲公自將，五月度河。聞楚兵來救，范文子請公欲還。郤至曰：「發兵誅逆，見彊辟之，無以令諸侯。」遂與戰。癸巳，射中楚共王目，楚兵敗於鄢陵。子反收餘兵，拊循欲復戰，晉患之。共王召子反，其侍者豎陽穀進酒，子反醉，不能見。王怒，讓子反，子反死。王遂引兵歸。晉由此威諸侯，欲以令天下求霸。"}],"rationale":"按本篇明示名與稱號、晉世系與具體事件暫定所列提及同指；附各段原文，未按同字短名全域合併；紀年與版本差異待核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji040-079","person_id":"ylo_ygy_hws","surfaces":["子反"],"scope":"same_chapter","chapter_ids":["c-shiji-040-chu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-040-chu:p026","quote":"共王十六年，晉伐鄭。鄭告急，共王救鄭。與晉兵戰鄢陵，晉敗楚，射中共王目。共王召將軍子反。子反嗜酒，從者豎陽穀進酒醉。王怒，射殺子反，遂罷兵歸。"}],"rationale":"依本段明示人物與職事暫定；未與他篇同稱候選自動合併，原字及疑名保留。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji040-zifan","person_ids":["k41_zyq_5ik","ylo_ygy_hws"],"canonical_person_id":"k41_zyq_5ik","scope":"cross_chapter","chapter_ids":["c-shiji-039-jin","c-shiji-040-chu"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-039-jin","source_id":"s-shiji-039-jin","paragraph_id":"c-shiji-039-jin:p111","quote":"六年春，鄭倍晉與楚盟，晉怒。欒書曰：「不可以當吾世而失諸侯。」乃發兵。厲公自將，五月度河。聞楚兵來救，范文子請公欲還。郤至曰：「發兵誅逆，見彊辟之，無以令諸侯。」遂與戰。癸巳，射中楚共王目，楚兵敗於鄢陵。子反收餘兵，拊循欲復戰，晉患之。共王召子反，其侍者豎陽穀進酒，子反醉，不能見。王怒，讓子反，子反死。王遂引兵歸。晉由此威諸侯，欲以令天下求霸。","mention_ids":["c-shiji-039-jin:m111-0102","c-shiji-039-jin:m111-0121","c-shiji-039-jin:m111-0133","c-shiji-039-jin:m111-0145","c-shiji-039-jin:m111-0148"]},{"chapter_id":"c-shiji-040-chu","source_id":"s-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p026","quote":"共王十六年，晉伐鄭。鄭告急，共王救鄭。與晉兵戰鄢陵，晉敗楚，射中共王目。共王召將軍子反。子反嗜酒，從者豎陽穀進酒醉。王怒，射殺子反，遂罷兵歸。","mention_ids":["c-shiji-040-chu:m026-0041","c-shiji-040-chu:m026-0044","c-shiji-040-chu:m026-0063"]}],"rationale":"兩篇同記鄢陵、共王中目、召子反而豎陽穀進酒致醉，具體事件相接暫同指；晉篇讓而死與楚篇射殺兩說並存，不選定優先。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-031-wu:p005","text":"王壽夢二年，楚之亡大夫申公巫臣怨楚將子反而犇晉，自晉使吳，教吳用兵乘車，令其子爲吳行人，吳於是始通於中國。吳伐楚。十六年，楚共王伐吳，至衡山。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-031-wu:m005-0000","start":0,"end":3,"surface":"王壽夢","kind":"person","person_id":"5dm_e40_rqh_AAAAAAAAAAAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m005-0011","start":11,"end":15,"surface":"申公巫臣","kind":"person","person_id":"4d0_phq_cjk","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m005-0018","start":18,"end":20,"surface":"子反","kind":"person","person_id":"k41_zyq_5ik","status":"contextual