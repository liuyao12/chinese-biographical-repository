id":"c-shiji-007-xiangyu:m007-0239","start":239,"end":241,"surface":"李由","kind":"person","person_id":"423_9wn_ew3","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p007","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-007-xiangyu:m008-0028","start":28,"end":30,"surface":"李由","kind":"person","person_id":"423_9wn_ew3","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p008","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-008-gaozu:m013-0049","start":49,"end":51,"surface":"李由","kind":"person","person_id":"423_9wn_ew3","status":"contextual_provisional","paragraph_id":"c-shiji-008-gaozu:p013","chapter_id":"c-shiji-008-gaozu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji008-025","person_id":"423_9wn_ew3","surfaces":["李由"],"scope":"cross_chapter","chapter_ids":["c-shiji-007-xiangyu","c-shiji-008-gaozu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-007-xiangyu:p007","quote":"居數月，引兵攻亢父，與齊田榮、司馬龍且軍救東阿，大破秦軍於東阿。田榮即引兵歸，逐其王假。假亡走楚。假相田角亡走趙。角弟田閒故齊將，居趙不敢歸。田榮立田儋子市為齊王。項梁已破東阿下軍，遂追秦軍。數使使趣齊兵，欲與俱西。田榮曰：「楚殺田假，趙殺田角、田閒，乃發兵。」項梁曰：「田假為與國之王，窮來從我，不忍殺之。」趙亦不殺田角、田閒以市於齊。齊遂不肯發兵助楚。項梁使沛公及項羽別攻城陽，屠之。西破秦軍濮陽東，秦兵收入濮陽。沛公、項羽乃攻定陶。定陶未下，去，西略地至雝丘，大破秦軍，斬李由。還攻外黃，外黃未下。"},{"paragraph_id":"c-shiji-008-gaozu:p013","quote":"秦軍復振，守濮陽，環水。楚軍去而攻定陶，定陶未下。沛公與項羽西略地至雍丘之下，與秦軍戰，大破之，斬李由。還攻外黃，外黃未下。"}],"rationale":"只在所列原句的秦末楚漢軍事／分封敘事內暫定同指；有前卷錨點時對讀相接事件，不把同名作全庫匹配規則，仍待異源覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-007-xiangyu:p007","text":"居數月，引兵攻亢父，與齊田榮、司馬龍且軍救東阿，大破秦軍於東阿。田榮即引兵歸，逐其王假。假亡走楚。假相田角亡走趙。角弟田閒故齊將，居趙不敢歸。田榮立田儋子市為齊王。項梁已破東阿下軍，遂追秦軍。數使使趣齊兵，欲與俱西。田榮曰：「楚殺田假，趙殺田角、田閒，乃發兵。」項梁曰：「田假為與國之王，窮來從我，不忍殺之。」趙亦不殺田角、田閒以市於齊。齊遂不肯發兵助楚。項梁使沛公及項羽別攻城陽，屠之。西破秦軍濮陽東，秦兵收入濮陽。沛公、項羽乃攻定陶。定陶未下，去，西略地至雝丘，大破秦軍，斬李由。還攻外黃，外黃未下。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"