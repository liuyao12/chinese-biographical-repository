1268,1269,1270,1271,1272,1273,1274,1275,1276,1277,1278,1279,1280,1281,1282,1283,1284,1285,1286,1287,1288,1289,1290,1291,1292,1293,1294,1295,1296,1302,1303,1304,1305,1308,1309,1310,1311,1312,1313,1314,1315,1316,1317,1318,1319,1320,1321]},"chapter_id":"c-sanguozhi-056-zhuzhi","book_id":"b-sanguozhi-056","work_id":"w-sanguozhi","source_id":"s-sanguozhi-056-zhuzhi"},{"id":"c-sanguozhi-056-zhuzhi:line017-pei01-01","text":"《江表傳》載治說賁曰：「破虜將軍昔率義兵入討董卓，聲冠中夏，義士壯之。討逆繼世，廓定六郡，特以君侯骨肉至親，器為時生，故表漢朝，剖符大郡，兼建將校，仍關綜兩府，榮冠宗室，為遠近所瞻。加討虜聰明神武，繼承洪業，攬結英雄，周濟世務，軍眾日盛，事業日隆，雖昔蕭王之在河北，無以加也，必克成王基，應運東南。故劉玄德遠布腹心，求見拯救，此天下所共知也。前在東聞道路之言，雲將軍有異趣，良用憮然。今曹公阻兵，傾覆漢室，幼帝流離，百姓元元未知所歸。而中國蕭條，或百里無煙，城邑空虛，道殣相望，士嘆於外，婦怨乎室，加之以師旅，因之以饑饉，以此料之，豈能越長江與我爭利哉？將軍當斯時也，而欲背骨肉之親，違萬安之計，割同氣之膚，啖虎狼之口，為一女子，改慮易圖，失機毫釐，差以千里，豈不惜哉！」","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-056-zhuzhi:line017-pei01-01:m0006","start":6,"end":7,"surface":"治","kind":"person","person_id":"oix_a6t_ovk","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-056-zhuzhi:line017-pei01-01:m0008","start":8,"end":9,"surface":"賁","kind":"person","person_id":"8jx_b5c_t2q","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-056-zhuzhi:line017-pei01-01:m0012","start":12,"end":16,"surface":"破虜將軍","kind":"person","person_id":"ki7_rgz_3l4","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-056-zhuzhi:line017-pei01-01:m0022","start":22,"end":24,"surface":"董卓","kind":"person","person_id":"a50_1e6_4bf","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-056-zhuzhi:line017-pei01-01:m0035","start":35,"end":37,"surface":"討逆","kind":"person","person_id":"e9c_070_567","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-056-zhuzhi:line017-pei01-01:m0092","start":92,"end":94,"surface":"討虜","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","int