u-055-pan-ni:p024:m0107","mention_ids":["c-jinshu-055-pan-ni:p024:m0107"],"kind":"paragraph"}],"mention_count":7,"duplicate_mention_count":0,"paragraph_occurrence_count":7,"table_occurrence_count":0,"passage_count":3,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"7處獨立位置，7個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"},{"source_id":"s-jinshu-055-appraisal-ws2316433","work_id":"w-jinshu","book_id":"b-jinshu-055","chapter_id":"c-jinshu-055-appraisal","raw_mention_count":1,"mention_ids":["c-jinshu-055-appraisal:p001:m0192"],"paragraph_ids":["c-jinshu-055-appraisal:p001"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-055-appraisal:p001:m0192","mention_ids":["c-jinshu-055-appraisal:p001:m0192"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-055-pan-ni-ws2316433"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-jinshu-055-pan-ni:source_review1-0","kind":"source_review","person_id":"54l_hzh_um4","source_quote":"岳從子尼。尼字正叔。祖勖，漢東海相。父滿，平原內史。並以學行稱。尼少有清才，與岳俱以文章見知。性靜退不競，唯以勤學著述為事。著《安身論》以明所守，其辭曰：","reading":"潘尼字正叔、祖勖父滿。「從子」依本傳親稱，另敘著論。","note":"潘尼字正叔、祖勖父滿。「從子」依本傳親稱，另敘著論。","paragraph_id":"c-jinshu-055-pan-ni:p001","start_codepoint":0,"end_codepoint":77,"human_reviewed":false,"chapter_id":"c-jinshu-055-pan-ni","source_id":"s-jinshu-055-pan-ni-ws2316433"},{"id":"c-jinshu-055-pan-ni:source_review2-0","kind":"source_review","person_id":"54l_hzh_um4","source_quote":"蓋崇德莫大乎安身，安身莫尚乎存正，存正莫重乎無私，無私莫深乎寡欲。是以君子安其身而後動，易其心而後語，定其交而後求，篤其志而後行。然則動者，吉凶之端也；語者，榮辱之主也；求者，利病之幾也；行者，安危之決也。故君子不妄動也，動必適其道；不徒語也，語必經於理；不苟求也，求必造於義；不虛行也，行必由於正。夫然，用能免或系之凶，享自天之祐。故身不安則殆，言不從則悖，交不審則惑，行不篤則危。四者行乎中，則憂患接乎外矣。憂患之接，必生於自私，而興於有欲。自私者不能成其私，有欲者不能濟其欲，理之至也。欲苟不濟，能無爭乎？私苟不從，能無伐乎？人人自私，家家有欲，眾欲並爭，群私交伐。爭，則亂之萌也；伐，則怨之府也。怨亂既構，危害及之，得不懼乎？","reading":"安身論由安身守正、無私寡欲立論。","note":"安身論由安身守正、無私寡欲立論。","paragraph_id":"c-jinshu-055-pan-ni:p002","start_codepoint":0,"end_codepoint":317,"human_reviewed":false,"chapter_id":"c-jinshu-055-pan-ni","source_id":"s-jinshu-055-pan-ni-ws2316433"},{"id":"c-jinshu-055-pan-ni:source_review3-0","kind":"source_review","person_id":"54l_hzh_um4","source_quote":"然棄本要末之徒，知進忘退之士，莫不飾才銳智，抽鋒擢穎，傾側乎勢利之交，馳騁乎當塗之務。朝有彈冠之朋，野有結綬之友，党與熾于前，榮名扇其後。握權，則赴者鱗集；失寵，則散者瓦解；求利，則托刎頸之歡；爭路，則構刻骨之隙。於是浮偽波騰，曲辯雲沸，寒暑殊聲，朝夕異價，駑蹇希奔放之跡，鉛刀競一割之用。至於愛惡相攻，與奪交戰，誹謗噂𠴲，毀譽縱橫，君子務能，小人伐技，風穨於上，俗弊於下。禍結而恨爭也不強，患至而悔伐之未辯，大者傾國喪家，次則覆身滅祀。其故何邪？豈不始於私欲而終於爭伐哉？","reading":"續論逐利者依附權勢，私欲終於爭伐。","note":"續論逐利者依附權勢，私欲終於爭伐。","paragraph_id":"c-jinshu-055-pan-ni:p003","start_codepoint":0,"end_codepoint":237,"human_reviewed":false,"chapter_id":"c-jinshu-055-pan-ni","source_id":"s-jinshu-055-pan-ni-ws2316433"},{"id":"c-jinshu-055-pan-ni:source_review4-0","kind":"source_review","person_id":"54l_hzh_um4","source_quote":"君子則不然。知自私之害公也，然後外其身；知有欲之傷德也，故遠絕榮利；知爭競之遘災也，故犯而不校；知好伐之招怨也，故有功而不德。安身而不為私，故身正而私全；慎言而不適欲，故言濟而欲從；定交而不求益，故交立而益厚；謹行而不求名，故行成而名美。止則立乎無私之域，行則由乎不爭之塗，必將通天下之理，而濟萬物之性。天下猶我，故與天下同其欲；己猶萬物，故與萬物同其利。","reading":"君子之行以去私欲、息爭伐為本，推至與物同利。","note":"君子之行以去私欲、息爭伐為本，推至與物同利。","paragraph_id":"c-jinshu-055-pan-ni:p004","start_codepoint":0,"end_codepoint":178,"human_reviewed":false,"chapter_id":"c-jinshu-055-pan-ni","source_id":"s-jinshu-055-pan-ni-ws2316433"},{"id":"c-jinshu-055-pan-ni:source_review5-0","kind":"source_review","person_id":"54l_hzh_um4","source_quote":"夫能保其安者，非謂崇生生之厚而耽逸豫之樂也，不忘危而已。有期進者，非謂窮貴寵之榮而藉名位之重也，不忘退而已。存其治者，非謂嚴刑政之威而明司察之禁也，不忘亂而已。故寢蓬室，隱陋巷，披短褐，茹藜藿，環堵而居，易衣而出，苟存乎道，非不安也。雖坐華殿，載文軒，服黼繡，御方丈，重門而處，成列而行，不得與之齊榮。用天時，分地利，甘布衣，安藪澤，沾體塗足，耕而後食，苟崇乎德，非不進也。雖居高位，饗重祿，執權衡，握機秘，功蓋當時，勢侔人主，不得與之比逸。遺意慮，沒才智，忘肝膽，棄形器，貌若無能，志若不及，苟正乎心，非不治也。雖繁計策，廣術藝，審刑名，峻法制，文辯流離，論議絕世，不得與之爭功。故安也者，安乎道者也。進也者，進乎德者也。治也者，治乎心者也。未有安身而不能保國家，進德而不能處富貴，治心而不能治萬物者也。","reading":"安在不忘危、進在不忘退、保治在不忘亂。","note":"安在不忘危、進在不忘退、保治在不忘亂。","paragraph_id":"c-jinshu-055-pan-ni:p005","start_codepoint":0,"end_codepoint":353,"human_reviewed":false,"chapter_id":"c-jinshu-055-pan-ni","source_id":"s-jinshu-055-pan-ni-ws2316433"},{"id":"c-jinshu-055-pan-ni:source_review6-0","kind":"source_review","person_id":"54l_hzh_um4","source_quote":"然思危所以求安，慮退所以能進，懼亂所以保治，戒亡所以獲存也。若乃弱志虛心，曠神遠致，徙倚乎不拔之根，浮游乎無垠之外，不自貴於物而物宗焉，不自重於人而人敬焉。可親而不可慢也，可尊而不可遠也。親之如不足，天下莫之能狎也；舉之如易勝，而當世莫之能困也。達則濟其道而不榮也，窮則善其身而不悶也，用則立於上而非爭也，舍則藏於下而非讓也。夫榮之所不能動者，則辱之所不能加也；利之所不能勸者，則害之所不能嬰也。譽之所不能益者，則毀之所不能損也。","reading":"列行己不加外物及寵辱不動。","note":"列行己不加外物及寵辱不動。","paragraph_id":"c-jinshu-055-pan-ni:p006","start_codepoint":0,"end_codepoint":215,"human_reviewed":false,"chapter_id":"c-jinshu-055-pan-ni","source_id":"s-jinshu-055-pan-ni-ws2316433"},{"id":"c-jinshu-055-pan-ni:source_review7-0","kind":"source_review","person_id":"54l_hzh_um4","source_quote":"今之學者誠能釋自私之心，塞有欲之求，杜交爭之原，去矜伐之態，動則行乎至通之路，靜則入乎大順之門，泰則翔乎寥廓之宇，否則淪乎渾冥之泉，邪氣不能幹其度，外物不能擾其神，哀樂不能蕩其守，死生不能易其真，而以造化為工匠，天地為陶鈞，名位為糟粕，勢利為埃塵，治其內而不飾其外，求諸己而不假諸人，忠肅以奉上，愛敬以事親，可以御一體，可以牧萬民，可以處富貴，可以安賤貧，經盛衰而不改，則庶幾乎能安身矣。","reading":"收束釋私寡欲，治內而不飾外。","note":"收束釋私寡欲，治內而不飾外。","paragraph_id":"c-jinshu-055-pan-ni:p007","start_codepoint":0,"end_codepoint":194,"human_reviewed":false,"chapter_id":"c-jinshu-055-pan-ni","source_id":"s-jinshu-055-pan-ni-ws2316433"},{"id":"c-jinshu-055-pan-ni:source_review8-0","kind":"source_review","person_id":"54l_hzh_um4","source_quote":"初應州辟，後以父老，辭位致養。太康中，舉秀才，為太常博士。歷高陸令、淮南王允鎮東參軍。元康初，拜太子舍人，上《釋奠頌》。其辭曰：","reading":"初辟辭養，太康中舉秀才，元康初拜舍人，上釋奠頌。","note":"初辟辭養，太康中舉秀才，元康初拜舍人，上釋奠頌。","paragraph_id":"c-jinshu-055-pan-ni:p008","start_codepoint":0,"end_codepoint":64,"human_reviewed":false,"chapter_id":"c-jinshu-055-pan-ni","source_id":"s-jinshu-055-pan-ni-ws2316433"},{"id":"c-jinshu-055-pan-ni:source_review9-0","kind":"source_review","person_id":"54l_hzh_um4","source_quote":"元康元年冬十二月，上以皇太子富於春秋，而人道之始莫先於孝悌，初命講《孝經》於崇正殿。實應天縱生知之量，微言奧義，發自聖問，業終而體達。三年春閏月，將有事於上庠，釋奠于先師，禮也。越二十四日丙申，侍祠者既齊，輿駕次於太學。太傅在前，少傅在後，恂恂乎弘保訓之道；宮臣畢從，三率備衛，濟濟乎肅翼贊之敬。乃掃壇為殿，懸幕為宮。夫子位於西序，顏回侍於北墉。宗伯掌禮，司儀辯位。二學儒官，搢紳先生之徒，垂纓佩玉，規行矩步者，皆端委而陪於堂下，以待執事之命。設樽篚於兩楹之間，陳罍洗於阼階之左。几筵既布，鐘懸既列，我後乃躬拜俯之勤，資在三之義。謙光之美彌劭，闕里之教克崇，穆穆焉，邕邕焉，真先王之徽典，不刊之美業，允不可替已。於是牲饋之事既終，享獻之禮已畢，釋玄衣，御春服，馳齋禁，反故式。天子乃命內外群司，百辟卿士，蕃王三事，至於學徒國子，咸來觀禮，我後皆延而與之燕。金石簫管之音，八佾六代之舞，鏗鏘闛閤，般辟俯仰，可以澄神滌欲，移風易俗者，罔不畢奏。抑淫哇，屏《鄭》《衛》，遠佞邪，釋巧辯。是日也，人無愚智，路無遠邇，離鄉越國，扶老攜幼，不期而俱萃。皆延頸以視，傾耳以聽，希道慕業，洗心革志，想洙、泗之風，歌來蘇之惠。然後知居室之善，著應乎千里之外；不言之化，洋溢於九有之內。於熙乎若典，固皇代之壯觀，萬載之一會也。尼昔忝禮官，嘗聞俎豆。今廁末列，親睹盛美，瀸漬徽猷，沐浴芳潤，不知手舞口詠，竊作頌一篇。義近辭陋，不足測盛德之形容，光聖明之遐度。其辭曰：","reading":"元康元年講經和三年春釋奠、二十四日丙申見頌序。","note":"元康元年講經和三年春釋奠、二十四日丙申見頌序。","paragraph_id":"c-jinshu-055-pan-ni:p009","start_codepoint":0,"end_codepoint":622,"human_reviewed":false,"chapter_id":"c-jinshu-055-pan-ni","source_id":"s-jinshu-055-pan-ni-ws2316433"},{"id":"c-jinshu-055-pan-ni:source_review10-0","kind":"source_review","person_id":"54l_hzh_um4","source_quote":"三元迭運，五德代微。黃精既亢，素靈乃暉。有皇承天，造我晉畿。祚以大寶，登以龍飛。宣基誕命，景熙遐緒，三分自文，受終惟武。席捲要蠻，蕩定荒阻；道濟群生，化流率土。後帝承哉，丕隆曾構。奄有萬方，光宅宇宙。","reading":"頌辭由晉之受命起筆。","note":"頌辭由晉之受命起筆。","paragraph_id":"c-jinshu-055-pan-ni:p010","start_codepoint":0,"end_codepoint":100,"human_reviewed":false,"chapter_id":"c-jinshu-055-pan-ni","source_id":"s-jinshu-055-pan-ni-ws2316433"},{"id":"c-jinshu-055-pan-ni:source_review11-0","kind":"source_review","person_id":"54l_hzh_um4","source_quote":"篤生上嗣，繼期挺秀。聖敬日躋，浚哲閎茂。留精儒術，敦閱古訓。遵道讓齒，降心下問。鋪以金聲，光以玉潤。如日之升，如乾之運。乃延台保，乃命學臣。聖容穆穆，侍講訚訚。抽演微言，啟發道真。探幽窮賾，溫故知新。講業既終，精義既研。崇聖重師，卜日告奠。陳其三牢，引其四縣。既戒既式，乃盥乃薦。","reading":"頌皇儲嗜學、講經和禮儀。","note":"頌皇儲嗜學、講經和禮儀。","paragraph_id":"c-jinshu-055-pan-ni:p011","start_codepoint":0,"end_codepoint":140,"human_reviewed":false,"chapter_id":"c-jinshu-055-pan-ni","source_id":"s-jinshu-055-pan-ni-ws2316433"},{"id":"c-jinshu-055-pan-ni:source_review12-0","kind":"source_review","person_id":"54l_hzh_um4","source_quote":"恂恂孔聖，百王攸希。亹亹顏生，好學無違。曰皇儲后，體神合幾。兆吉先見，知來洞微。濟濟二宮，藹藹庶僚。俊乂鱗萃，髦士盈朝。如彼和肆，莫匪瓊瑤；如彼儀鳳，樂我《雲》《韶》。瓊瑤誰剖？四門洞開；《雲》《韶》奚樂？神人允諧。蟬冕耀庭。細珮振階。德以謙光，仁以恩懷。我酒惟清，我肴惟馨。舞以六代，歌以九成。","reading":"援孔顏及群臣禮教以頌儲。","note":"援孔顏及群臣禮教以頌儲。","paragraph_id":"c-jinshu-055-pan-ni:p012","start_codepoint":0,"end_codepoint":148,"human_reviewed":false,"chapter_id":"c-jinshu-055-pan-ni","source_id":"s-jinshu-055-pan-ni-ws2316433"},{"id":"c-jinshu-055-pan-ni:source_review13-0","kind":"source_review","person_id":"54l_hzh_um4","source_quote":"莘莘胄子，祁祁學生。洗心自百，觀國之榮。學猶蒔苗，化若偃草。博我以文，弘我以道。萬邦蟬蛻，矧乃俊造。鑽蚌瑩珠，剖石摛藻。絲匪玄黃，水罔方圓。引之斯流，染之斯鮮。若金受範，若埴在甄。上好如雲，下效如川。","reading":"頌胄子與學生的化育，兼釋奠頌辭。","note":"頌胄子與學生的化育，兼釋奠頌辭。","paragraph_id":"c-jinshu-055-pan-ni:p013","start_codepoint":0,"end_codepoint":100,"human_reviewed":false,"chapter_id":"c-jinshu-055-pan-ni","source_id":"s-jinshu-055-pan-ni-ws2316433"},{"id":"c-jinshu-055-pan-ni:source_review14-0","kind":"source_review","person_id":"54l_hzh_um4","source_quote":"昔在周興，王化之始。曰文曰武，時惟世子。今我皇儲，齊聖通理。緝熙重光，于穆不已。于穆伊何？思文哲後。媚茲一人，實副元首。孝洽家邦，光照九有。純嘏自晉，永世昌阜。微微下臣，過充近侍。猥躡風雲，鸞龍是廁。身澡芳流，目玩盛事。竭誠作頌，祗詠聖志。","reading":"援周世子故事頌當代儲副，以禮治收束。","note":"援周世子故事頌當代儲副，以禮治收束。","paragraph_id":"c-jinshu-055-pan-ni:p014","start_codepoint":0,"end_codepoint":120,"human_reviewed":false,"chapter_id":"c-jinshu-055-pan-ni","source_id":"s-jinshu-055-pan-ni-ws2316433"},{"id":"c-jinshu-055-pan-ni:source_review15-0","kind":"source_review","person_id":"54l_hzh_um4","source_quote":"出為宛令，在任寬而不縱，恤隱勤政，厲公平而遺人事。入補尚書郎，俄轉著作郎。為《乘輿箴》，其辭曰：","reading":"宛令及著作郎官次，引乘輿箴。","note":"宛令及著作郎官次，引乘輿箴。","paragraph_id":"c-jinshu-055-pan-ni:p015","start_codepoint":0,"end_codepoint":48,"human_reviewed":false,"chapter_id":"c-jinshu-055-pan-ni","source_id":"s-jinshu-055-pan-ni-ws2316433"},{"id":"c-jinshu-055-pan-ni:source_review16-0","kind":"source_review","person_id":"54l_hzh_um4","source_quote":"《易》稱「有天地然後有人倫，有父子然後有君臣」。傳曰：「大者天地，其次君臣。」然君臣父子之道，天地人倫之本，未有以先之者也。故天生蒸人而樹之君，使司牧之，將以導群生之性，而理萬物之情。豈以寵一人之身，極無量之欲，如斯而已哉！夫古之為君者，無欲而至公，故有茅茨土階之儉；而後之為君，有欲而自利，故有瑤台瓊室之侈。無欲者，天下共推之；有欲者，天下共爭之。推之之極，雖禪代猶脫屣；爭之之極，雖劫殺而不避。故曰「天下非一人之天下，乃天下之天下」，安可求而得，辭而已者乎！","reading":"箴序以天地君臣父子鋪陳教化。","note":"箴序以天地君臣父子鋪陳教化。","paragraph_id":"c-jinshu-055-pan-ni:p016","start_codepoint":0,"end_codepoint":231,"human_reviewed":false,"chapter_id":"c-jinshu-055-pan-ni","source_id":"s-jinshu-055-pan-ni-ws2316433"},{"id":"c-jinshu-055-pan-ni:source_review17-0","kind":"source_review","person_id":"54l_hzh_um4","source_quote":"夫修諸己而化諸人，出乎邇而見乎遠者，言行之謂也。故人主所患，莫甚於不知其過；而所美，莫美于好聞其過。若有君於此，而曰予必無過，唯其言而莫之違，斯孔子所謂其庶幾乎一言而喪國者也。蓋君子之過，如日月之蝕：過也，人皆見之，更也，人皆仰之。雖以堯、舜、湯、武之盛，必有誹謗之木，敢諫之鼓，盤杅之銘，無諱之史，所以閑其邪僻而納諸正道，其自維持如此之備。故箴規之興，將以救過補闕，然猶依違諷喻，使言之者無罪，聞之者足以自誡。先儒既援古義，舉內外之殊，而高祖亦序六官，論成敗之要，義正辭約，又盡善矣。自《虞人箴》以至於《百官》，非唯規其所司，誠欲人主斟酌其得失焉。《春秋傳》曰「命百官箴王闕」，則亦天子之事也。","reading":"論人主聞過、虛心納諫而辨群臣。","note":"論人主聞過、虛心納諫而辨群臣。","paragraph_id":"c-jinshu-055-pan-ni:p017","start_codepoint":0,"end_codepoint":298,"human_reviewed":false,"chapter_id":"c-jinshu-055-pan-ni","source_id":"s-jinshu-055-pan-ni-ws2316433"},{"id":"c-jinshu-055-pan-ni:source_review18-0","kind":"source_review","person_id":"54l_hzh_um4","source_quote":"尼以為王者膺受命之期，當神器之運，總萬機而撫四海，簡群才而審所授，孜孜於得人，汲汲于聞過，雖廷爭面折，猶將祈請而求焉。至於箴規，諫之順者，曷為獨闕之哉？是以不量其學陋思淺，因負擔之餘，嘗試撰而述之。不敢斥至尊之號，故以「乘輿」目篇。蓋帝王之事至大，而古今之變至眾，文繁而義詭，意局而辭野，將欲希企前賢，仿佛崇軌，譬猶丘坻之望華岱，恆星之系日月也，其不逮明矣。頌曰：","reading":"箴序接任賢納諫之論，轉引箴辭。","note":"箴序接任賢納諫之論，轉引箴辭。","paragraph_id":"c-jinshu-055-pan-ni:p018","start_codepoint":0,"end_codepoint":182,"human_reviewed":false,"chapter_id":"c-jinshu-055-pan-ni","source_id":"s-jinshu-055-pan-ni-ws2316433"},{"id":"c-jinshu-055-pan-ni:source_review19-0","kind":"source_review","person_id":"54l_hzh_um4","source_quote":"元元遂初，芒芒太始。清濁同流，玄黃錯歭。上下弗形，尊卑靡紀。赫胥悠哉，大庭尚矣。皇極啟建，兩儀既分。彝倫需永序，萬邦已紛。國事明王，家奉嚴君。各有攸尊，德用不勤。羲、農已降，暨于夏、殷。或禪或傳，乃質乃文。","reading":"箴辭自天地初分與皇極各位發端。","note":"箴辭自天地初分與皇極各位發端。","paragraph_id":"c-jinshu-055-pan-ni:p019","start_codepoint":0,"end_codepoint":103,"human_reviewed":false,"chapter_id":"c-jinshu-055-pan-ni","source_id":"s-jinshu-055-pan-ni-ws2316433"},{"id":"c-jinshu-055-pan-ni:source_review20-0","kind":"source_review","person_id":"54l_hzh_um4","source_quote":"太上無名，下知有之。仁義不存，而人歸孝慈。無為無執，何欲何思。忠信之薄，禮刑實滋。既譽既畏，以侮以欺。作誓作盟，而人始叛疑。煌煌四海，藹藹萬乘，菲誓焉憑？左輔右弼，前疑後丞。一日萬機，業業兢兢。夫出其言善，則千里是應；而莫餘違，亦喪邦有征。樞機之動，式以廢興。殷監不遠，若之何勿懲！","reading":"引太上無名與後世刑禮所滋。","note":"引太上無名與後世刑禮所滋。","paragraph_id":"c-jinshu-055-pan-ni:p020","start_codepoint":0,"end_codepoint":141,"human_reviewed":false,"chapter_id":"c-jinshu-055-pan-ni","source_id":"s-jinshu-055-pan-ni-ws2316433"},{"id":"c-jinshu-055-pan-ni:source_review21-0","kind":"source_review","person_id":"54l_hzh_um4","source_quote":"且厚味臘毒，豐屋生災。辛作琁室，而夏興瑤台。糟丘酒池，象箸玉杯。厥肴伊何？龍肝豹胎。惟此哲婦，職為亂階。殷用喪師，夏亦不恢。是以帝堯在位，茅茨不翦。周文日昃，昧旦丕顯。夫德輶如毛，而或舉之者鮮。故《濩》有慚德，《武》未盡善。下世道衰，末俗化淺。耽樂逸游，荒淫沈湎。不式古訓，而好是佞辯；不遵王路，而覆車是踐。成敗之效，載在先典。匪唯陵夷，厥世用殄。故曰樹君如之何？將人是司牧。視之猶傷，而知其寒燠。故能撫之斯柔，而敦之斯睦；無遠不懷，靡思不服。夫豈厭縱一人，而玩其耳目；內迷聲色，外荒弛逐；不修政事，而終於顛覆？","reading":"歷引奢欲、女禍及殷夏亡國故事。","note":"歷引奢欲、女禍及殷夏亡國故事。","paragraph_id":"c-jinshu-055-pan-ni:p021","start_codepoint":0,"end_codepoint":256,"human_reviewed":false,"chapter_id":"c-jinshu-055-pan-ni","source_id":"s-jinshu-055-pan-ni-ws2316433"},{"id":"c-jinshu-055-pan-ni:source_review22-0","kind":"source_review","person_id":"54l_hzh_um4","source_quote":"昔唐氏授舜，舜亦命禹。受終納祖，丕承天序。放桀惟湯，克殷伊武。故禪代非一姓，社稷無常主。四嶽三塗，九州之阻。彭蠡、洞庭，殷商之旅。虞夏之隆，非由尺土。而紂之百克，卒於絕緒。故王者無親，唯在擇人。傾蓋惟舊，白首乃新。望由釣夫，伊起有莘。負鼎鼓刀，而謀合聖神。夫豈借官左右，而取介近臣。蓋有國有家者，莫雲我聰，或此面從；莫謂我智，聽受未易。甘言美疾，鮮不為累。由夷逃寵，遠於脫屣。奈何人主，位極則侈？","reading":"由禪代無常、擇人到甘言之惑，屬箴辭。","note":"由禪代無常、擇人到甘言之惑，屬箴辭。","paragraph_id":"c-jinshu-055-pan-ni:p022","start_codepoint":0,"end_codepoint":198,"human_reviewed":false,"chapter_id":"c-jinshu-055-pan-ni","source_id":"s-jinshu-055-pan-ni-ws2316433"},{"id":"c-jinshu-055-pan-ni:source_review23-0","kind":"source_review","person_id":"54l_hzh_um4","source_quote":"知人則哲，惟帝所難。唐朝既泰，四族作奸。周室既隆，而管、蔡不虔。匪我二聖，孰弭斯患？若九德咸受，俊乂在官，君非臣莫治，臣非君莫安。故《書》美康哉，而《易》貴金蘭。有皇司國，敢告納言。","reading":"援唐虞、周室之戒，收於以賢治國。","note":"援唐虞、周室之戒，收於以賢治國。","paragraph_id":"c-jinshu-055-pan-ni:p023","start_codepoint":0,"end_codepoint":91,"human_reviewed":false,"chapter_id":"c-jinshu-055-pan-ni","source_id":"s-jinshu-055-pan-ni-ws2316433"},{"id":"c-jinshu-055-pan-ni:source_review24-0","kind":"source_review","person_id":"54l_hzh_um4","source_quote":"及趙王倫篡位，孫秀專政，忠良之士皆罹禍酷。尼遂疾篤，取假拜掃墳墓。聞齊王冏起義，乃赴許昌。冏引為參軍，與謀時務，兼管書記。事平，封安昌公。歷黃門侍郎、散騎常侍、侍中、秘書監。永興末，為中書令。時三王戰爭，皇家多故，尼職居顯要，從容而已。雖憂虞不及，而備嘗艱難。永嘉中，遷太常卿。洛陽將沒，攜家屬東出成皋，欲還鄉里。道遇賊，不得前，病卒於塢壁，年六十餘。","reading":"趙王倫時請假，赴齊王冏，至太常卿；東出成皋病卒塢壁。","note":"趙王倫時請假，赴齊王冏，至太常卿；東出成皋病卒塢壁。","paragraph_id":"c-jinshu-055-pan-ni:p024","start_codepoint":0,"end_codepoint":176,"human_reviewed":false,"chapter_id":"c-jinshu-055-pan-ni","source_id":"s-jinshu-055-pan-ni-ws2316433"},{"id":"c-jinshu-055-pan-ni:source_relationship1-0","kind":"source_relationship","person_id":"54l_hzh_um4","source_quote":"岳從子尼","reading":"本傳稱從子，父滿與祖勖各具名，未補確切親等。","note":"本傳稱從子，父滿與祖勖各具名，未補確切親等。","paragraph_id":"c-jinshu-055-pan-ni:p001","start_codepoint":0,"end_codepoint":4,"human_reviewed":false,"related_person_id":"d2b_1d3_333","chapter_id":"c-jinshu-055-pan-ni","source_id":"s-jinshu-055-pan-ni-ws2316433"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin055-volume-ni-grandfather","subject_person_id":"54l_hzh_um4","object_person_id":"5wd_bti_0bb","predicate":"grandfather","qualifiers":{"source_term":"祖勖"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-055","chapter_id":"c-jinshu-055-pan-ni","source_id":"s-jinshu-055-pan-ni-ws2316433","paragraph_id":"c-jinshu-055-pan-ni:p001","quote":"岳從子尼。尼字正叔。祖勖，漢東海相。父滿，平原內史。並以學行稱。尼少有清才，與岳俱以文章見知。性靜退不競，唯以勤學著述為事。著《安身論》以明所守，其辭曰：","subject_person_mention_id":"c-jinshu-055-pan-ni:p001:m0003","object_person_mention_id":"c-jinshu-055-pan-ni:p001:m0011"}],"status":"source_attested","interpretation_note":"本傳專名勖為祖。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"a-jin055-volume-ni-father","subject_person_id":"54l_hzh_um4","object_person_id":"vpu_ikf_hdu","predicate":"father","qualifiers":{"source_term":"父滿"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-055","chapter_id":"c-jinshu-055-