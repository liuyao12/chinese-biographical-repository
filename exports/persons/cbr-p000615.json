{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000615","canonical_person_id":"lz2_9j4_p17","id_aliases":["cbr-p000615"],"identity_policy":"contextual_provisional","person_ids":["lz2_9j4_p17"],"persons":[{"id":"lz2_9j4_p17","label":"平原（四君稱呼）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"平原","mention_ids":["c-shiji-006-shihuang:p064:block05:m0093"]}],"evidence":[{"mention_id":"c-shiji-006-shihuang:p064:block05:m0093","chapter_id":"c-shiji-006-shihuang","paragraph_id":"c-shiji-006-shihuang:p064:block05","quote":"平原"}],"identity_note":"依本卷特定語境暫定人物；保留本文字形，不補未見姓名與讀法。","review":"ai_provisional","id_aliases":["cbr-p000615"]}],"source_mention_summary":[{"source_id":"s-shiji-006-shihuang","work_id":"w-shiji","book_id":"b-shiji-006","chapter_id":"c-shiji-006-shihuang","mention_count":1,"mention_ids":["c-shiji-006-shihuang:p064:block05:m0093"],"paragraph_ids":["c-shiji-006-shihuang:p064:block05"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-006-shihuang"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-006-shihuang:p064:block05:m0093","start":93,"end":95,"surface":"平原","kind":"person","person_id":"lz2_9j4_p17","status":"contextual_provisional","paragraph_id":"c-shiji-006-shihuang:p064:block05","chapter_id":"c-shiji-006-shihuang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-006-shihuang:p064:block05","text":"孝公既沒，惠王、武王蒙故業，因遺冊，南兼漢中，西舉巴、蜀，東割膏腴之地，收要害之郡。諸侯恐懼，會盟而謀弱秦，不愛珍器重寶肥美之地，以致天下之士，合從締交，相與為一。當是時，齊有孟嘗，趙有平原，楚有春申，魏有信陵。此四君者，皆明知而忠信，寬厚而愛人，尊賢重士，約從離衡，并韓、魏、燕、楚、齊、趙、宋、衛、中山之眾。於是六國之士有寧越、徐尚、蘇秦、杜赫之屬為之謀，齊明、周最、陳軫、昭滑、樓緩、翟景、蘇厲、樂毅之徒通其意，吳起、孫臏、帶佗、兒良、王廖、田忌、廉頗、趙奢之朋制其兵。常以十倍之地，百萬之眾，叩關而攻秦。秦人開關延敵，九國之師逡巡遁逃而不敢進。秦無亡矢遺鏃之費，而天下諸侯已困矣。於是從散約解，爭割地而奉秦。秦有餘力而制其敝，追亡逐北，伏尸百萬，流血漂櫓。因利乘便，宰割天下，分裂河山，彊國請服，弱國入朝。延及孝文王、莊襄王，享國日淺，國家無事。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:p064:block05:m0000","start":0,"end":2,"surface":"孝公","kind":"person","person_id":"y97_huh_vuz_AAAAAAAAAAAAABAAAAA","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p064:block05:m0005","start":5,"end":7,"surface":"惠王","kind":"person","person_id":"y97_huh_vuz_AAAAAAAAAAAAABAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p064:block05:m0008","start":8,"end":10,"surface":"武王","kind":"person","person_id":"y97_huh_vuz_AAAAAAAAAAAAABAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p064:block05:m0088","start":88,"end":90,"surface":"孟嘗","kind":"person","person_id":"7pl_s0g_rkh","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p064:block05:m0093","start":93,"end":95,"surface":"平原","kind":"person","person_id":"lz2_9j4_p17","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p064:block05:m0098","start":98,"end":100,"surface":"春申","kind":"person","person_id":"epj_utq_pyg","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p064:block05:m0103","start":103,"end":105,"surface":"信陵","kind":"person","person_id":"o4b_bje_i31","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p064:block05:m0107","start":107,"end":110,"surface":"四君者","kind":"unresolved","person_id":null,"status":"unresolved","note":"泛稱、群體或未核指代，不據引文譬喻補造個人。"},{"id":"c-shiji-006-shihuang:p064:block05:m0163","start":163,"end":165,"surface":"寧越","kind":"person","person_id":"ccx_50c_ssi","status":"contextual_prov