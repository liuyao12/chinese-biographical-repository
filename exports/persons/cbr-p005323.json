{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p005323","identity_policy":"contextual_provisional","person_ids":["cbr-p005323"],"persons":[{"id":"cbr-p005323","label":"冒頓（樊酈滕灌列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"冒頓","mention_ids":["c-shiji-095-fankuang:m020-0108"]}],"evidence":[{"mention_id":"c-shiji-095-fankuang:m020-0108","chapter_id":"c-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p020","quote":"冒頓"}]}],"mentions":[{"id":"c-shiji-095-fankuang:m020-0108","start":108,"end":110,"surface":"冒頓","kind":"person","person_id":"cbr-p005323","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p020","chapter_id":"c-shiji-095-fankuang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji095-073","person_id":"cbr-p005323","scope":"same_chapter","chapter_ids":["c-shiji-095-fankuang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["冒頓"],"evidence":[{"paragraph_id":"c-shiji-095-fankuang:p020","quote":"漢王立為帝。其秋，燕王臧荼反，嬰以太僕從擊荼。明年，從至陳，取楚王信。更食汝陰，剖符世世勿絕。以太僕從擊代，至武泉、雲中，益食千戶。因從擊韓信軍胡騎晉陽旁，大破之。追北至平城，為胡所圍，七日不得通。高帝使使厚遺閼氏，冒頓開圍一角。高帝出欲馳，嬰固徐行，弩皆持滿外向，卒得脫。益食嬰細陽千戶。復以太僕從擊胡騎句注北，大破之。以太僕擊胡騎平城南，三陷陳，功為多，賜所奪邑五百戶。以太僕擊陳豨、黥布軍，陷陳卻敵，益食千戶，定食汝陰六千九百戶，除前所食。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定異稱。酈寄字況據第14段；夏侯嬰的嬰限定第16至21段，灌嬰限定第22至33段，桓嬰另人。第6與20、28段楚王信和反韓王信分人；未詳名王侯不補名。同名跨篇同指另待逐項證據。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-095-fankuang:p020","text":"漢王立為帝。其秋，燕王臧荼反，嬰以太僕從擊荼。明年，從至陳，取楚王信。更食汝陰，剖符世世勿絕。以太僕從擊代，至武泉、雲中，益食千戶。因從擊韓信軍胡騎晉陽旁，大破之。追北至平城，為胡所圍，七日不得通。高帝使使厚遺閼氏，冒頓開圍一角。高帝出欲馳，嬰固徐行，弩皆持滿外向，卒得脫。益食嬰細陽千戶。復以太僕從擊胡騎句注北，大破之。以太僕擊胡騎平城南，三陷陳，功為多，賜所奪邑五百戶。以太僕擊陳豨、黥布軍，陷陳卻敵，益食千戶，定食汝陰六千九百戶，除前所食。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m020-0000","start":0,"end":2,"surface":"漢王","kind":"person","person_id":"cbr-p005