_provisional"}],"chapter_id":"c-shiji-095-fankuang","book_id":"b-shiji-095","work_id":"w-shiji","source_id":"s-shiji-095-fankuang"}],"sources":[{"chapter_id":"c-shiji-095-fankuang","work_id":"w-shiji","book_id":"b-shiji-095","source_id":"s-shiji-095-fankuang","source":{"title":"史記／卷095","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷095","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷095&oldid=2298709","revision_id":2298709,"accessed_on":"2026-10-09","extent":"34段傳世正文含太史公論，另附1段分層索隱述贊；排除導覽與空白。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"固定HTML一致，只去外緣空白；樊噌、（肩）［屏］、（博）［傅］、（太卜）太仆、穎陰等原字保留。","note":"全37個HTML區塊已讀，未核底本影像。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical"}}
