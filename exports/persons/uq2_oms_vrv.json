torial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-074-huan-family:p012:m0289","start":289,"end":290,"surface":"母","kind":"person","person_id":"uq2_oms_vrv","status":"contextual_provisional","interpretation_note":"母稱不推生母","paragraph_id":"c-jinshu-074-huan-family:p012","chapter_id":"c-jinshu-074-huan-family"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-074-huan-family:p012","text":"初，袁真以壽陽叛，石虔以甯遠將軍、南頓太守帥諸將攻之，克其南城。又擊苻堅將王鑒於石橋，獲馬五百匹。除竟陵太守，以父憂去職。尋而苻堅又寇淮南，詔曰：「石虔文武器幹，禦戎有方。古人絕哭，金革弗避，況在餘哀，豈得辭事！可授奮威將軍、南平太守。」尋進冠軍將軍。苻堅荊州刺史梁成、襄陽太守閻震率眾入寇竟陵，石虔與弟石民距之。賊阻敖水，屯管城。石虔設計夜渡水，既濟，賊始覺，力戰破之，進克管城，擒震，斬首七千級，俘獲萬人，馬數百匹，牛羊千頭，具裝鎧三百領。成以輕騎走保襄陽。石虔復領河東太守，進據樊城，逐堅兗州刺史張崇，納降二千家而還。沖卒，石虔以冠軍將軍監豫州揚州五郡軍事、豫州刺史。尋以母憂去職。服闋，復本位。久之，命移鎮馬頭，石虔求停曆陽，許之。","source_position":{"kind":"wikitext_codepoint_positions","raw_path":"sources/jinshu/wikisource-1536331-raw.wikitext","raw_start":2768,"raw_end":3193,"character_positions":[2770,2771,2772,2773,2774,2775,2776,2777,2778,2779,2780,2781,2782,2783,2784,2785,2786,2787,2788,2789,2790,2791,2792,2793,2794,2795,2796,2797,2798,2799,2800,2801,2802,2803,2804,2805,2806,2807,2808,2809,2810,2811,2812,2813,2814,2815,2816,2817,2818,2819,2820,2821,2822,2823,2824,2825,2826,2827,2828,2829,2830,2831,2832,2833,2834,2835,2836,2837,2838,2839,2840,2841,2842,2843,2850,2851,2852,2853,2854,2855,2856,2857,2858,2859,2860,2861,2862,2863,2864,2865,2866,2867,2868,2869,2870,2871,2872,2873,2874,2875,2876,2877,2878,2879,2880,2881,2882,2883,2884,2885,2886,2887,2888,2889,2890,2891,2892,2893,2896,2897,2898,2899,2900,2901,2902,2903,2904,2905,2906,2907,2908,2909,2910,2911,2982,2983,2984,2985,2986,2987,2988,2989,2990,2991,2992,2993,2994,3020,3021,3022,3023,3024,3025,3026,3027,3028,3029,3030,303