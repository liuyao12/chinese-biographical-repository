_id":"c-songshu-052-xieshu","paragraph_id":"c-songshu-052-xieshu:p004","quote":"述","mention_id":"c-songshu-052-xieshu:p004:m0041"},{"work_id":"w-songshu","book_id":"b-songshu-052","source_id":"s-songshu-052-xieshu-ws2190655","chapter_id":"c-songshu-052-xieshu","paragraph_id":"c-songshu-052-xieshu:p005","quote":"謝述","mention_id":"c-songshu-052-xieshu:p005:m0104"},{"work_id":"w-songshu","book_id":"b-songshu-052","source_id":"s-songshu-052-xieshu-ws2190655","chapter_id":"c-songshu-052-xieshu","paragraph_id":"c-songshu-052-xieshu:p005","quote":"謝述","mention_id":"c-songshu-052-xieshu:p005:m0139"},{"work_id":"w-songshu","book_id":"b-songshu-052","source_id":"s-songshu-052-xieshu-ws2190655","chapter_id":"c-songshu-052-xieshu","paragraph_id":"c-songshu-052-xieshu:p005","quote":"述","mention_id":"c-songshu-052-xieshu:p005:m0000"},{"work_id":"w-songshu","book_id":"b-songshu-052","source_id":"s-songshu-052-xieshu-ws2190655","chapter_id":"c-songshu-052-xieshu","paragraph_id":"c-songshu-052-xieshu:p005","quote":"述","mention_id":"c-songshu-052-xieshu:p005:m0119"}],"review":"ai_provisional","identity_note":"甝弟，字景先，小字道兒。兩書同載江陵奉兄純喪及元嘉中佐劉義康；與後世同名者隔開。","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"aa6_83c_juy_AB","source_assertion_id":null,"parent_connection":{"type":"shared_father_through_siblings","sibling_assertion_ids":["a-nanshi019-shu-han-younger","a-nanshi019-han-chun-younger","a-nanshi019-chun-yu-younger"],"sibling_father_assertion_id":"a-nanshi019-yu-yun-father"},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-019","chapter_id":"c-nanshi-019-xieshu","source_id":"s-nanshi-019-xieshu-ws1531762","paragraph_id":"c-nanshi-019-xieshu:p001","quote":"甝弟述字景先，小字道兒。少有至行，隨純在江陵，純遇害，述奉純喪還都，至西塞遇暴風，純喪舫流漂不知所在，述乘小船尋求，經純妻庾舫過。庾遣人謂曰：「小郎去必無及，寧可存亡俱盡邪。」述號泣答曰：「若安全至岸，尙須營理；如其已致意外，述亦無心獨存。」因冒浪而進，見純喪幾沒，述號叫呼天，幸而獲免。咸以爲精誠所致，武帝聞而嘉之。及臨豫州，諷中正以爲迎主簿，甚被器遇。","subject_person_mention_id":"c-nanshi-019-xieshu:p001:m0002","object_person_mention_id":"c-nanshi-019-xieshu:p001:m0000","source_term":"甝弟述","source_assertion_id":"a-nanshi019-shu-han-younger"},{"work_id":"w-nanshi","book_id":"b-nanshi-019","chapter_id":"c-nanshi-019-xiechun-xiehan","source_id":"s-nanshi-019-xiechun-xiehan-ws1531762","paragraph_id":"c-nanshi-019-xiechun-xiehan:p002","quote":"純弟甝字景甝，位司徒右長史。","subject_person_mention_id":"c-nanshi-019-xiechun-xiehan:p002:m0002","object_person_mention_id":"c-nanshi-019-xiechun-xiehan:p002:m0000","source_term":"純弟甝","source_assertion_id":"a-nanshi019-han-chun-younger"},{"work_id":"w-nanshi","book_id":"b-nanshi-019","chapter_id":"c-nanshi-019-xiechun-xiehan","source_id":"s-nanshi-019-xiechun-xiehan-ws1531762","paragraph_id":"c-nanshi-019-xiechun-xiehan:p001","quote":"純字景懋，景仁弟也。劉毅鎮江陵，以爲衛軍長史、南平相。及王鎮惡襲毅，毅時病，佐史聞兵至，馳還入府，左右引車欲還外廨，純叱之曰：「我人吏也，逃欲安之。」及入，毅兵敗眾散，純爲人所殺。","subject_person_mention_id":"c-nanshi-019-xiechun-xiehan:p001:m0000","object_person_mention_id":"c-nanshi-019-xiechun-xiehan:p001:m0005","source_term":"景仁弟也","source_assertion_id":"a-nanshi019-chun-yu-younger"},{"work_id":"w-nanshi","book_id":"b-nanshi-019","chapter_id":"c-nanshi-019-xieyu-descendants","source_id":"s-nanshi-019-xieyu-descendants-ws1531762","paragraph_id":"c-nanshi-019-xieyu-descendants:p001","quote":"謝裕字景仁，朗弟允之子、而晦從父也。名與宋武帝諱同，故以字行。允字令度，位宣城內史。景仁幼爲從祖安所知，始爲前軍行參軍，會稽王世子元顯嬖人張法順權傾一時，內外無不造門，唯景仁不至，年三十而方爲著作佐郎。桓玄誅元顯，見景仁，謂四坐曰：「司馬庶人父子雲何不敗，遂令謝景仁三十而方佐著作郎。」玄建楚臺，以補黃門侍郎。及篡位，領驍騎將軍。","subject_person_mention_id":"c-nanshi-019-xieyu-descendants:p001:m0000","object_person_mention_id":"c-nanshi-019-xieyu-descendants:p001:m0008","source_term":"允之子","source_assertion_id":"a-nanshi019-yu-yun-father"}],"status":"contextual_provisional","human_reviewed":false,"interpretation_note":"具名兄弟句逐步連到其中一人的明父；父系為可撤回編輯組裝。"}},{"id":"aa6_83c_juy_ABCA","label":"謝約","status":"active","historicity":"historical_tradition","aliases":[{"surface":"約","mention_ids":["c-nanshi-019-xieshu:p004:m0113","c-nanshi-019-xiezong-xiewei:p001:m0024","c-nanshi-019-xiezong-xiewei:p002:m0017","c-songshu-052-xieshu:p006:m0005","c-songshu-052-xieshu:p006:m0035","c-songshu-052-xieshu:p006:m0054"]}],"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-019","chapter_id":"c-nanshi-019-xieshu","source_id":"s-nanshi-019-xieshu-ws1531762","paragraph_id":"c-nanshi-019-xieshu:p004","quote":"約","mention_id":"c-nanshi-019-xieshu:p004:m0113"},{"work_id":"w-nanshi","book_id":"b-nanshi-019","chapter_id":"c-nanshi-019-xiezong-xiewei","source_id":"s-nanshi-019-xiezong-xiewei-ws1531762","paragraph_id":"c-nanshi-019-xiezong-xiewei:p001","quote":"約","mention_id":"c-nanshi-019-xiezong-xiewei:p001:m0024"},{"work_id":"w-nanshi","book_id":"b-nanshi-019","chapter_id":"c-nanshi-019-xiezong-xiewei","source_id":"s-nanshi-019-xiezong-xiewei-ws1531762","paragraph_id":"c-nanshi-019-xiezong-xiewei:p002","quote":"約","mention_id":"c-nanshi-019-xiezong-xiewei:p002:m0017"},{"work_id":"w-songshu","book_id":"b-songshu-052","source_id":"s-songshu-052-xieshu-ws2190655","chapter_id":"c-songshu-052-xieshu","paragraph_id":"c-songshu-052-xieshu:p006","quote":"約","mention_id":"c-songshu-052-xieshu:p006:m0005"},{"work_id":"w-songshu","book_id":"b-songshu-052","source_id":"s-songshu-052-xieshu-ws2190655","chapter_id":"c-songshu-052-xieshu","paragraph_id":"c-songshu-052-xieshu:p006","quote":"約","mention_id":"c-songshu-052-xieshu:p006:m0035"},{"work_id":"w-songshu","book_id":"b-songshu-052","source_id":"s-songshu-052-xieshu-ws2190655","chapter_id":"c-songshu-052-xieshu","paragraph_id":"c-songshu-052-xieshu:p006","quote":"約","mention_id":"c-songshu-052-xieshu:p006:m0054"}],"review":"ai_provisional","identity_note":"謝述所列三子之一。","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"aa6_83c_juy_ABC","source_assertion_id":"a-nanshi019-shu-child-yue","evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-019","chapter_id":"c-nanshi-019-xieshu","source_id":"s-nanshi-019-xieshu-ws1531762","paragraph_id":"c-nanshi-019-xieshu:p004","quote":"述有心虛疾，性理時或乖謬，卒於吳興太守。喪還未至都數十里，殷景仁、劉湛同乘迎赴，望船流涕。及劉湛誅，義康外鎮，將行歎曰：「謝述唯勸吾退，劉湛唯勸吾進，述亡而湛存，吾所以得罪也。」文帝亦曰：「謝述若存，義康必不至此。」三子：綜、約、緯。","subject_person_mention_id":"c-nanshi-019-xieshu:p004:m0113","object_person_mention_id":"c-nanshi-019-xieshu:p004:m0000","source_term":"三子：綜、約、緯"}],"status":"contextual_provisional","human_reviewed":false,"interpretation_note":"此列以傳主述為父。「文帝亦曰」引語已畢，世系接回述。"}}],"source_mention_summary":[{"source_id":"s-songshu-052-xieshu-ws2190655","work_id":"w-songshu","book_id":"b-songshu-052","chapter_id":"c-songshu-052-xieshu","raw_mention_count":3,"mention_ids":["c-songshu-052-xieshu:p006:m0005","c-songshu-052-xieshu:p006:m0035","c-songshu-052-xieshu:p006:m0054"],"paragraph_ids":["c-songshu-052-xieshu:p006"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-songshu-052-xieshu:p006:m0005","mention_ids":["c-songshu-052-xieshu:p006:m0005"],"kind":"paragraph"},{"canonical_mention_id":"c-songshu-052-xieshu:p006:m0035","mention_ids":["c-songshu-052-xieshu:p006:m0035"],"kind":"paragraph"},{"canonical_mention_id":"c-songshu-052-xieshu:p006:m0054","mention_ids":["c-songshu-052-xieshu:p006:m0054"],"kind":"paragraph"}],"mention_count":3,"duplicate_mention_count":0,"paragraph_occurrence_count":3,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"3處獨立位置，3個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"},{"source_id":"s-nanshi-019-xiezong-xiewei-ws1531762","work_id":"w-nanshi","book_id":"b-nanshi-019","chapter_id":"c-nanshi-019-xiezong-xiewei","raw_mention_count":2,"mention_ids":["c-nanshi-019-xiezong-xiewei:p001:m0024","c-nanshi-019-xiezong-xiewei:p002:m0017"],"paragraph_ids":["c-nanshi-019-xiezong-xiewei:p001","c-nanshi-019-xiezong-xiewei:p002"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-nanshi-019-xiezong-xiewei:p001:m0024","mention_ids":["c-nanshi-019-xiezong-xiewei:p001:m0024"],"kind":"paragraph"},{"canonical_mention_id":"c-nanshi-019-xiezong-xiewei:p002:m0017","mention_ids":["c-nanshi-019-xiezong-xiewei:p002:m0017"],"kind":"paragraph"}],"men