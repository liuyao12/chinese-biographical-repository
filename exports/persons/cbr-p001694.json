son_id":"cbr-p001694","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p009","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m010-0005","start":5,"end":8,"surface":"文侯仇","kind":"person","person_id":"cbr-p001694","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p010","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m011-0006","start":6,"end":8,"surface":"文侯","kind":"person","person_id":"cbr-p001694","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p011","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m143-0021","start":21,"end":23,"surface":"文侯","kind":"person","person_id":"cbr-p001694","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p143","chapter_id":"c-shiji-039-jin"}],"relations":[{"id":"a-shiji039-010","subject_person_id":"cbr-p001694","predicate":"father","object_person_id":"cbr-p001692","status":"source_attested","evidence":[{"chapter_id":"c-shiji-039-jin","source_id":"s-shiji-039-jin","paragraph_id":"c-shiji-039-jin:p007","quote":"穆侯四年，取齊女姜氏爲夫人。七年，伐條。生太子仇。十年，伐千畝，有功。生少子，名曰成師。晉人師服曰：「異哉，君之命子也！太子曰仇，仇者讎也。少子曰成師，成師大號，成之者也。名自命也；物自定也。今適庶名反逆，此後晉其能毋亂乎？」"}],"qualifiers":{"source_term":"生太子仇","historicity":"historical_tradition"},"interpretation_note":"保存本段明示親屬或生育敘事；不由繼位補父子，不補闕代。母、女弟、庶孫等依原文；人物暫同指及不同篇主張仍待覆核。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji039-012","subject_person_id":"cbr-p001698","predicate":"father","object_person_id":"cbr-p001694","status":"source_attested","evidence":[{"chapter_id":"c-shiji-039-jin","source_id":"s-shiji-039-jin","paragraph_id":"c-shiji-039-jin:p010","quote":"三十五年，文侯仇卒，子昭侯伯立。"}],"qualifiers":{"source_term":"子昭侯伯","historicity":"historical_tradition"},"interpretation_note":"保存本段明示親屬或生育敘事；不由繼位補父子，不補闕代。母、女弟、庶孫等依原文；人物暫同指及不同篇主張仍待覆核。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji039-013","subject_person_id":"cbr-p001695","predicate":"brother","object_person_id":"cbr-p001694","status":"source_attested","evidence":[{"chapter_id":"c-shiji-039-jin","source_id":"s-shiji-039-jin","paragraph_id":"c-shiji-039-jin:p011","quote":"昭侯元年，封文侯弟成師于曲沃。曲沃邑大於翼。翼，晉君都邑也。成師封曲沃，號爲桓叔。靖侯庶孫欒賓相桓叔。桓叔是時年五十八矣，好德，晉國之衆皆附焉。君子曰：「晉之亂其在曲沃矣。末大於本而得民心，不亂何待！」"}],"qualifiers":{"source_term":"文侯弟成師","historicity":"historical_tradition"},"interpretation_note":"保存本段明示親屬或生育敘事；不由繼位補父子，不補闕代。母、女弟、庶孫等依原文；人物暫同指及不同篇主張仍待覆核。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji039-132","person_id":"cbr-p001694","surfaces":["太子仇","文侯","文侯仇"],"scope":"same_chapter","chapter_ids":["c-shiji-039-jin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-039-jin:p007","quote":"穆侯四年，取齊女姜氏爲夫人。七年，伐條。生太子仇。十年，伐千畝，有功。生少子，名曰成師。晉人師服曰：「異哉，君之命子也！太子曰仇，仇者讎也。少子曰成師，成師大號，成之者也。名自命也；物自定也。今適庶名反逆，此後晉其能毋亂乎？」"},{"paragraph_id":"c-shiji-039-jin:p008","quote":"二十七年，穆侯卒，弟殤叔自立，太子仇出奔。殤叔三年，周宣王崩。四年，穆侯太子仇率其徒襲殤叔而立，是爲文侯。"},{"paragraph_id":"c-shiji-039-jin:p009","quote":"文侯十年，周幽王無道，犬戎殺幽王，周東徙。而秦襄公始列爲諸侯。"},{"paragraph_id":"c-shiji-039-jin:p010","quote":"三十五年，文侯仇卒，子昭侯伯立。"},{"paragraph_id":"c-shiji-039-jin:p011","quote":"昭侯元年，封文侯弟成師于曲沃。曲沃邑大於翼。翼，晉君都邑也。成師封曲沃，號爲桓叔。靖侯庶孫欒賓相桓叔。桓叔是時年五十八矣，好德，晉國之衆皆附焉。君子曰：「晉之亂其在曲沃矣。末大於本而得民心，不亂何待！」"},{"paragraph_id":"c-shiji-039-jin:p143","quote":"天命叔虞，卒封於唐。桐珪旣削，河、汾是荒。文侯雖嗣，曲沃日彊。未知本末，祚傾桓莊。獻公昏惑，太子罹殃。重耳致霸，朝周河陽。靈旣喪德，厲亦無防。四卿侵侮。晉祚遽亡。"}],"rationale":"按本篇明示名與稱號、晉世系與具體事件暫定所列提及同指；附各段原文，未按同字短名全域合併；紀年與版本差異待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-039-jin:p007","text":"穆侯四年，取齊女姜氏爲夫人。七年，伐條。生太子仇。十年，伐千畝，有功。生少子，名曰成師。晉人師服曰：「異哉，君之命子也！太子曰仇，仇者讎也。少子曰成師，成師大號，成之者也。名自命也；物自定也。今適庶名反逆，此後晉其能毋亂乎？」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m007-0000","start":0,"end":2,"surface":"穆侯","kind":"person","person_id":"cbr-p001692","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m007-0006","start":6,"end":10,"surface":"齊女姜氏","kind":"person","person_id":"cbr-p001693","status":"contex