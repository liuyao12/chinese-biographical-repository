jin"},{"id":"c-shiji-039-jin:p010","text":"三十五年，文侯仇卒，子昭侯伯立。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m010-0005","start":5,"end":8,"surface":"文侯仇","kind":"person","person_id":"cbr-p001694","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m010-0011","start":11,"end":14,"surface":"昭侯伯","kind":"person","person_id":"cbr-p001698","status":"contextual_provisional"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"},{"id":"c-shiji-039-jin:p011","text":"昭侯元年，封文侯弟成師于曲沃。曲沃邑大於翼。翼，晉君都邑也。成師封曲沃，號爲桓叔。靖侯庶孫欒賓相桓叔。桓叔是時年五十八矣，好德，晉國之衆皆附焉。君子曰：「晉之亂其在曲沃矣。末大於本而得民心，不亂何待！」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m011-0000","start":0,"end":2,"surface":"昭侯","kind":"person","person_id":"cbr-p001698","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m011-0006","start":6,"end":8,"surface":"文侯","kind":"person","person_id":"cbr-p001694","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m011-0009","start":9,"end":11,"surface":"成師","kind":"person","person_id":"cbr-p001695","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m011-0030","start":30,"end":32,"surface":"成師","kind":"person","person_id":"cbr-p001695","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m011-0038","start":38,"end":40,"surface":"桓叔","kind":"person","person_id":"cbr-p001695","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m011-0041","start":41,"end":43,"surface":"靖侯","kind":"person","person_id":"cbr-p001689","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m011-0045","start":45,"end":47,"surface":"欒賓","kind":"person","person_id":"cbr-p001699","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m011-0048","start":48,"end":50,"surface":"桓叔","kind":"person","person_id":"cbr-p001695","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m011-0051","start":51,"end":53,"surface":"桓叔","kind":"person","person_id":"cbr-p001695","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m011-0064","start":64,"end":68,"surface":"晉國之衆","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m011-0072","start":72,"end":74,"surface":"君子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"},{"id":"c-shiji-039-jin:p143","text":"天命叔虞，卒封於唐。桐珪旣削，河、汾是荒。文侯雖嗣，曲沃日彊。未知本末，祚傾桓莊。獻公昏惑，太子罹殃。重耳致霸，朝周河陽。靈旣喪德，厲亦無防。四卿侵侮。晉祚遽亡。","annotation_status":"named_mentions_first_pass","text_layer":"witness_appended_suoyin_zan","mentions":[{"id":"c-shiji-039-jin:m143-0002","start":2,"end":4,"surface":"叔虞","kind":"person","person_id":"cbr-p000193","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m143-0021","start":21,"end":23,"surface":"文侯","kind":"person","person_id":"cbr-p001694","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m143-0038","start":38,"end":40,"surface":"桓莊","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m143-0041","start":41,"end":43,"surface":"獻公","kind":"person","person_id":"cbr-p000374","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m143-0046","start":46,"end":48,"surface":"太子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m143-0051","start":51,"end":53,"surface":"重耳","kind":"person","person_id":"cbr-p000252","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m143-0061","start":61,"end":62,"surface":"靈","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m143-0066","start":66,"end":67,"surface":"厲","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m143-0071","start":71,"end":73,"surface":"四卿","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"}],"sources":[{"chapter_id":"c-shiji-039-jin","work_id":"w-shiji","book_id":"b-shiji-039","source_id":"s-shiji-039-jin","source":{"title":"史記／卷039","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷039","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷039&oldid=2588534","revision_id":2588534,"accessed_on":"2026-10-09","extent":"142段正文，自晉唐叔虞至太史公論贊，另保留1段索隱述贊並分層；排除2個dd導覽及段首尾版面換行。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{"鲁":"魯","隐":"隱","绖":"絰"},"editorial_readings":[],"extraction_note":"固定版本與實讀HTML一致。第14段鲁隐轉魯隱，第46、79段绖轉絰，去除段首尾換行，其餘古字、內外異說及校勘保留。","note":"同版原始標記亦作子胛桓叔，不默補代字或莊伯名字。保留冀芮／郤芮、郤鉤、欒逞、示瞇明、歩陽、郤臻、砹、六（卿）［軍］、［復］等見證字；未核可靠底本、影像或專門研究。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical"}}
