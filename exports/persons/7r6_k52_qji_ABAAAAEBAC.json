tus":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作泰。"},{"start":55,"end":57,"surface":"中表","id":"c-nanshi-022-wangtai:p001:u0055","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"內外親，未逐名。"},{"start":81,"end":83,"surface":"家人","id":"c-nanshi-022-wangtai:p001:u0081","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"泰家中人，未具名。"},{"start":96,"end":97,"surface":"鋒","id":"c-nanshi-022-wangtai:p001:m0096","person_id":"47p_kjh_ez7_B","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作鋒。"},{"start":105,"end":108,"surface":"蕭子友","id":"c-nanshi-022-wangtai:p001:m0105","person_id":"bae_itg_oe5","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作子友。"},{"start":112,"end":113,"surface":"泰","id":"c-nanshi-022-wangtai:p001:m0112","person_id":"7r6_k52_qji_ABAAAAEBAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作泰。"},{"start":120,"end":122,"surface":"子侄","id":"c-nanshi-022-wangtai:p001:u0120","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"子侄合稱，未各舉名。"}],"source_position":{"revision_id":1477957,"source_layer":"received_biography","raw_start":10148,"raw_end":10271,"raw_character_offsets":[10148,10149,10150,10151,10152,10153,10154,10155,10156,10157,10158,10159,10160,10161,10162,10163,10164,10165,10166,10167,10168,10169,10170,10171,10172,10173,10174,10175,10176,10177,10178,10179,10180,10181,10182,10183,10184,10185,10186,10187,10188,10189,10190,10191,10192,10193,10194,10195,10196,10197,10198,10199,10200,10201,10202,10203,10204,10205,10206,10207,10208,10209,10210,10211,10212,10213,10214,10215,10216,10217,10218,10219,10220,10221,10222,10223,10224,10225,10226,10227,10228,10229,10230,10231,10232,10233,10234,10235,10236,10237,10238,10239,10240,10241,10242,10243,10244,10245,10246,10247,10248,10249,10250,10251,10252,10253,10254,10255,10256,10257,10258,10259,10260,10261,10262,1026