":"6bc_ky1_pgl","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-zhang-guang:p004:m0248","surface":"殷","start":248,"end":249,"person_id":"vbc_dpv_li5","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-zhang-guang:p004:m0255","surface":"光","start":255,"end":256,"person_id":"72h_bvx_bj5","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-zhang-guang:p004:m0276","surface":"燕","start":276,"end":277,"person_id":"6i0_r5m_4s1","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-zhang-guang:p004:m0303","surface":"正沖","start":303,"end":305,"person_id":"6bc_ky1_pgl","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-zhang-guang:p004:m0308","surface":"張燕","start":308,"end":310,"person_id":"6i0_r5m_4s1","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-zhang-guang:p004:m0337","surface":"光","start":337,"end":338,"person_id":"72h_bvx_bj5","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-zhang-guang:p004:m0363","surface":"光","start":363,"end":364,"person_id":"72h_bvx_bj5","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-057-zhang-guang","book_id":"b-jinshu-057","work_id":"w-jinshu","source_id":"s-jinshu-057-zhang-guang-ws2413329"},{"id":"c-jinshu-058-zhou-fu:p002","text":"咸和初，司徒王導以撫爲從事中郎，出爲甯遠將軍、江夏相。蘇峻作逆，率所領從溫嶠討之。峻平，遷監沔北軍事、南中郎將，鎮襄陽。石勒將郭敬率騎攻撫，撫不能守，率所領奔於武昌，坐免官。尋遷振威將軍、豫章太守，後代毌丘奧監巴東諸軍事、益州刺史、假節，將軍如故。尋進征虜將軍，加督甯州諸軍事。永和初，桓溫征蜀，進撫督梁州之漢中、巴西、梓潼、陰平四郡軍事，鎮彭模。撫擊破蜀余寇隗文、鄧定等，斬偽尚書僕射王誓、平南將軍王潤，以功遷平西將軍。隗文、鄧定等復反，立範賢子賁爲帝。初，賢爲李雄國師，以左道惑百姓，人多事之，賁遂有眾一萬。撫與龍驤將軍硃燾擊破斬之，以功進爵建城縣公。征西督護蕭敬文作亂，殺征虜將軍楊謹，據涪城，自號益州牧。恆溫使督護鄧遐助撫討之，不能拔，引退。溫又令梁州刺史司馬勳等會撫伐之。敬文固守，自二月至於八月，乃出降，撫斬之，傳首京師。升平中，進鎮西將軍。在州三十餘年，興寧三年卒，贈征西將軍，諡曰襄。子楚嗣。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":84,"last_line":84,"raw_start":7940,"raw_end":8381,"raw_character_offsets":[7942,7943,7944,7945,7946,7947,7948,7949,7950,7951,7952,7953,7954,7955,7956,79