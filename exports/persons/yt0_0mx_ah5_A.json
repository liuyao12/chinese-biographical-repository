ity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-076-jin076-roll-close:lun","text":"史臣曰：季孫行父稱見有禮於其君者，如孝子之養父母；無禮於其君者，如鷹鸇之逐鳥雀。是以石碏戮厚，叔向誅鮒，前史以為美譚。王敦之惡，不足矜其類。然而硃家容布，為大俠之首；酈寄載呂，興賣友之譏。亦所以激揚風俗，弘長名教。王彬艤船而厚其所薄，王舒沈江而薄其所厚，較之優劣，斷乎可知。思行、彪之厲風規於多僻之日，虞潭、顧衆徇貞心于危蹙之辰。龍管為出納之端，{制魚}魚非獻替之術，嘯父之對，何其鄙歟！","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-076-jin076-roll-close:lun:m0004","start":4,"end":8,"surface":"季孫行父","kind":"person","person_id":"y5g_euj_1xr","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-076-jin076-roll-close:lun:m0042","start":42,"end":44,"surface":"石碏","kind":"person","person_id":"yt0_0mx_ah5","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-076-jin076-roll-close:lun:m0045","start":45,"end":46,"surface":"厚","kind":"person","person_id":"yt0_0mx_ah5_A","status":"contextual_provisional","interpretation_note":"讀本段前後及對話，所指按此處記。"},{"id":"c-jinshu-076-jin076-roll-close:lun:m0047","start":47,"end":49,"surface":"叔向","kind":"person","person_id":"edm_4zm_yh1","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-076-jin076-roll-close:lun:m0050","start":50,"end":51,"surface":"鮒","kind":"person","person_id":"myx_4wr_ku6","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-076-jin076-roll-close:lun:m0059","start":59,"end":61,"surface":"王敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-076-jin076-roll-close:lun:m0072","start":72,"end":74,"surface":"硃家","kind":"person","person_id":"766_5dq_zws","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-076-jin076-roll-close:lun:m0075","start":75,"end":76,"surface":"布","kind":"person","person_id":"udu_dyy_4wd","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-076-jin076-roll-close:lun:m0083","start":83,"end":85,"surface":"酈寄","kind":"pe