{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000861","identity_policy":"contextual_provisional","person_ids":["cbr-p000861"],"persons":[{"id":"cbr-p000861","label":"呂通","status":"active","historicity":"historical_tradition","aliases":[{"surface":"呂通","mention_ids":["c-shiji-009-lvhou:m017-0085","c-shiji-009-lvhou:m029-0131"]}],"evidence":[{"mention_id":"c-shiji-009-lvhou:m017-0085","chapter_id":"c-shiji-009-lvhou","paragraph_id":"c-shiji-009-lvhou:p017","quote":"呂通"},{"mention_id":"c-shiji-009-lvhou:m029-0131","chapter_id":"c-shiji-009-lvhou","paragraph_id":"c-shiji-009-lvhou:p029","quote":"呂通"}]}],"mentions":[{"id":"c-shiji-009-lvhou:m017-0085","start":85,"end":87,"surface":"呂通","kind":"person","person_id":"cbr-p000861","status":"contextual_provisional","paragraph_id":"c-shiji-009-lvhou:p017","chapter_id":"c-shiji-009-lvhou"},{"id":"c-shiji-009-lvhou:m029-0131","start":131,"end":133,"surface":"呂通","kind":"person","person_id":"cbr-p000861","status":"contextual_provisional","paragraph_id":"c-shiji-009-lvhou:p029","chapter_id":"c-shiji-009-lvhou"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-009-lvhou:p017","text":"太傅產、丞相平等言，武信侯呂祿上侯，位次第一，請立為趙王。太后許之，追尊祿父康侯為趙昭王。九月，燕靈王建薨，有美人子，太后使人殺之，無後，國除。八年十月，立呂肅王子東平侯呂通為燕王，封通弟呂莊為東平侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-009-lvhou:m017-0000","start":0,"end":3,"surface":"太傅產","kind":"person","person_id":"cbr-p000823","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m017-0004","start":4,"end":7,"surface":"丞相平","kind":"person","person_id":"cbr-p000692","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m017-0013","start":13,"end":15,"surface":"呂祿","kind":"person","person_id":"cbr-p000829","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m017-0029","start":29,"end":31,"surface":"太后","kind":"person","person_id":"cbr-p000717","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m017-0038","start":38,"end":40,"surface":"康侯","kind":"person","person_id":"cbr-p000824","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m017-0048","start":48,"end":52,"surface":"燕靈王建","kind":"person","person_id":"cbr-p000815","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m017-0055","start":55,"end":57,"surface":"美人","kind":"person","person_id":"cbr-p000859","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m017-0057","start":57,"end":58,"surface":"子","kind":"person","person_id":"cbr-p000860","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m017-0059","start":59,"end":61,"surface":"太后","kind":"person","person_id":"cbr-p000717","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m017-0069","start":69,"end":71,"surface":"國除","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定官稱；不補造姓名或把身世指控當定論。"},{"id":"c-shiji-009-lvhou:m017-0078","start":78,"end":81,"surface":"呂肅王","kind":"person","person_id":"cbr-p000822","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m017-0085","start":85,"end":87,"surface":"呂通","kind":"person","person_id":"cbr-p000861","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m017-0094","start":94,"end":96,"surface":"呂莊","kind":"person","person_id":"cbr-p000862","status":"contextual_provisional"}],"chapter_id":"c-shiji-009-lvhou","book_id":"b-shiji-009","work_id":"w-shiji","source_id":"s-shiji-009-lvhou"},{"id":"c-shiji-009-lvhou:p029","text":"朱虛侯已殺產，帝命謁者持節勞朱虛侯。朱虛侯欲奪節信，謁者不肯，朱虛侯則從與載，因節信馳走，斬長樂衛尉呂更始。還，馳入北軍，報太尉。太尉起，拜賀朱虛侯曰：「所患獨呂產，今已誅，天下定矣。」遂遣人分部悉捕諸呂男女，無少長皆斬之。辛酉，捕斬呂祿，而笞殺呂媭。使人誅燕王呂通，而廢魯王偃。壬戌，以帝太傅食其復為左丞相。戊辰，徙濟川王王梁，立趙幽王子遂為趙王。遣朱虛侯章以誅諸呂氏事告齊王，令罷兵。灌嬰兵亦罷滎陽而歸。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-009-lvhou:m029-0000","start":0,"end":3,"surface":"朱虛侯","kind":"person","person_id":"cbr-p000832","sta