rences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-047-wangrong-wyd:p006","text":"又虜前後奉使不專漢人必介以匈奴備諸覘獲且設官分職彌見其情抑退舊苗扶任種戚師保則后族馮晉國總錄則邽姓直勒渴侯台鼎則丘頽苟仁端執政則目凌鉗耳至於東都羽儀西京簪帶崔孝伯程虞虯久在著作李元和郭季祐上于中書李思沖飾虜清官游明根泛居顯職今經典遠被詩史北流馮李之徒必欲遵尚直勒等類居致乖阻何則匈奴以氊騎為帷牀馳射為糇糧冠方帽則犯沙陵雪服左袵則風驟鳥逝若衣以朱裳戴之玄冕節其揖讓教以翔趨必同艱桎梏等懼冰淵婆娑𨃟躃困而不能前已及夫春草水生阻散馬之適秋風木落絕驅禽之歡息沸脣於桑墟別醍乳於冀俗聽韶雅如聾聵臨方丈若爰居馮李之徒固得志矣虜之凶族其如病何於是風土之思深愎戾之情動拂衣者連裾抽鋒者比鏃部落爭於下酋渠危於上我一舉而兼吞卞莊之勢必也且棘寶薦虞晉疆彌盛大鍾出智宿氏以亡帝畧遠孚無思不服鑾光幸岱匪暮斯朝臣請收籍依瀍茲書復掌猶取之內府藏之外籯於理有愜即事何損若狂言足採請決敕施行","mentions":[{"id":"c-nanqishu-047-wangrong-wyd:p006:u0041","surface":"馮晉國","start":41,"end":44,"person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"魏八十三上馮熙為太師、文明太后兄，字晉昌。此處晉國與晉昌異，保留同人待考。"},{"id":"c-nanqishu-047-wangrong-wyd:p006:u0049","surface":"直勒渴侯","start":49,"end":53,"person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"南齊使文音寫名，未獲兩名對讀。"},{"id":"c-nanqishu-047-wangrong-wyd:p006:u0056","surface":"丘頽","start":56,"end":58,"person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"與魏四十四苟頹音近，聲部異且苟頹傳歿年可能先於此疏；不合兩人。"},{"id":"c-nanqishu-047-wangrong-wyd:p006:u0058","surface":"苟仁端","start":58,"end":61,"person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"字面與同列丘頹、魏苟頹分別。"},{"id":"c-nanqishu-047-wangrong-wyd:p006:u0064","surface":"目凌","start":64,"end":66,"person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"未據身任即認作穆亮。"},{"id":"c-nanqishu-047-wangrong-wyd:p006:u0066","surface":"鉗耳","start":66,"end":68,"person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"本文單列；未能證是氏族借指誰。"},{"id":"c-nanqishu-047-wangrong-wyd:p006:m0078","surface":"崔孝伯","start":78,"end":81,"person_id":"822_eba_7d0","kind":"person","status":"contextual_provisional","interpretation_note":"對讀本傳上下文。"},{"id":"c-nanqishu-047-wangrong-wyd:p006:m0081","surface":"程虞虯","start":