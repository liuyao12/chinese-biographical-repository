guang:p005:m0214","surface":"難敵","start":214,"end":216,"person_id":"ql1_hvr_06f","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-zhang-guang:p005:m0218","surface":"邈","start":218,"end":219,"person_id":"xos_71y_0iw","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-zhang-guang:p005:m0221","surface":"援","start":221,"end":222,"person_id":"n4t_jiu_bd4","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-zhang-guang:p005:m0234","surface":"光","start":234,"end":235,"person_id":"72h_bvx_bj5","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-zhang-guang:p005:m0257","surface":"光","start":257,"end":258,"person_id":"72h_bvx_bj5","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-zhang-guang:p005:m0263","surface":"光","start":263,"end":264,"person_id":"72h_bvx_bj5","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-zhang-guang:p005:m0324","surface":"炅","start":324,"end":325,"person_id":"zc4_3gf_dcf","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-zhang-guang:p005:m0326","surface":"邁","start":326,"end":327,"person_id":"lil_j6z_oct","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-057-zhang-guang","book_id":"b-jinshu-057","work_id":"w-jinshu","source_id":"s-jinshu-057-zhang-guang-ws2413329"},{"id":"c-jinshu-057-zhang-guang:p006","text":"炅少辟太宰掾。邁多才略，有父風。州人推邁權領州事，與賊戰沒。別駕範曠及督護王喬奉光妻息，率其遺眾，還據魏興。其後義陽太守任愔為梁州，光妻子歸本郡。南平太守應詹白都督王敦，稱「光在梁州能興微繼絕，威振巴漢。值中原傾覆，征鎮失守，外無救助，內闕資儲，以寡敵眾，經年抗禦，厲節不撓，宜應追論顯贈，以慰存亡」。敦不能從。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":90,"last_line":90,"raw_start":7450,"raw_end":7606,"raw_character_offsets":[7450,7451,7452,7453,7454,7455,7456,7457,7458,7459,7460,7461,7462,7463,7464,7465,7466,7467,7468,7469,7470,7471,7472,7473,7474,7475,7476,7477,7478,7479,7480,7481,7482,7483,7484,7485,7486,7487,7488,7489,7490,7491,7492,7493,7494,7495,7496,7497,7498,7499,7500,750