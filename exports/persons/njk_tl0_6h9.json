d":"njk_tl0_6h9","status":"contextual_provisional","paragraph_id":"c-shiji-108-han:p009","chapter_id":"c-shiji-108-han"},{"id":"c-shiji-108-han:m012-0021","start":21,"end":23,"surface":"李廣","kind":"person","person_id":"njk_tl0_6h9","status":"contextual_provisional","paragraph_id":"c-shiji-108-han:p012","chapter_id":"c-shiji-108-han"}],"relations":[],"title_holdings":[{"id":"th-shiji108-024","person_id":"njk_tl0_6h9","title":"衞尉","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-108-han","source_id":"s-shiji-108-han","paragraph_id":"c-shiji-108-han:p009","quote":"當是時，漢伏兵車騎材官二十餘萬，匿馬邑旁谷中。衞尉李廣爲驍騎將軍，太仆公孫賀爲輕車將軍，大行王恢爲將屯將軍，太中大夫李息爲材官將軍。御史大夫韓安國爲護軍將軍，諸將皆屬護軍。約單于入馬邑而漢兵縱發。王恢、李息、李廣別從代主擊其輜重。於是單于入漢長城武州塞。未至馬邑百餘里，行掠鹵，徒見畜牧於野，不見一人。單于怪之，攻烽燧，得武州尉史。欲刺問尉史。尉史曰：「漢兵數十萬伏馬邑下。」單于顧謂左右曰：「幾爲漢所賣！」乃引兵還。出塞，曰：「吾得尉史，乃天也。」命尉史爲「天王」。塞下傳言單于已引去。漢兵追至塞，度弗及，即罷。王恢等兵三萬，聞單于不與漢合，度往擊輜重，必與單于精兵戰，漢兵勢必敗，則以便宜罷兵，皆無功。"}],"attestations":[{"id":"th-shiji108-024:a001","paragraph_id":"c-shiji-108-han:p009","start":23,"end":25,"surface":"衞尉","person_mention_id":"c-shiji-108-han:m009-0025","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"分開既任官稱與本段將軍授任；未明年月及終止事件保持未知。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji108-025","person_id":"njk_tl0_6h9","title":"驍騎將軍","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-108-han","source_id":"s-shiji-108-han","paragraph_id":"c-shiji-108-han:p009","quote":"當是時，漢伏兵車騎材官二十餘萬，匿馬邑旁谷中。衞尉李廣爲驍騎將軍，太仆公孫賀爲輕車將軍，大行王恢爲將屯將軍，太中大夫李息爲材官將軍。御史大夫韓安國爲護軍將軍，諸將皆屬護軍。約單于入馬邑而漢兵縱發。王恢、李息、李廣別從代主擊其輜重。於是單于入漢長城武州塞。未至馬邑百餘里，行掠鹵，徒見畜牧於野，不見一人。單于怪之，攻烽燧，得武州尉史。欲刺問尉史。尉史曰：「漢兵數十萬伏馬邑下。」單于顧謂左右曰：「幾爲漢所賣！」乃引兵還。出塞，曰：「吾得尉史，乃天也。」命尉史爲「天王」。塞下傳言單于已引去。漢兵追至塞，度弗及，即罷。王恢等兵三萬，聞單于不與漢合，度往擊輜重，必與單于精兵戰，漢兵勢必敗，則以便宜罷兵，皆無功。"}],"attestations":[{"id":"th-shiji108-025:a001","paragraph_id":"c-shiji-108-han:p009","start":28,"end":32,"surface":"驍騎將軍","person_mention_id":"c-shiji-108-han:m009-0025","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-108-han","source_id":"s-shiji-108-han","paragraph_id":"c-shiji-108-han:p009","quote":"當是時，漢伏兵車騎材官二十餘萬，匿馬邑旁谷中。衞尉李廣爲驍騎將軍，太仆公孫賀爲輕車將軍，大行王恢爲將屯將軍，太中大夫李息爲材官將軍。御史大夫韓安國爲護軍將軍，諸將皆屬護軍。約單于入馬邑而漢兵縱發。王恢、李息、李廣別從代主擊其輜重。於是單于入漢長城武州塞。未至馬邑百餘里，行掠鹵，徒見畜牧於野，不見一人。單于怪之，攻烽燧，得武州尉史。欲刺問尉史。尉史曰：「漢兵數十萬伏馬邑下。」單于顧謂左右曰：「幾爲漢所賣！」乃引兵還。出塞，曰：「吾得尉史，乃天也。」命尉史爲「天王」。塞下傳言單于已引去。漢兵追至塞，度弗及，即罷。王恢等兵三萬，聞單于不與漢合，度往擊輜重，必與單于精兵戰，漢兵勢必敗，則以便宜罷兵，皆無功。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"分開既任官稱與本段將軍授任；未明年月及終止事件保持未知。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji108-041","person_id":"njk_tl0_6h9","title":"將軍","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-108-han","source_id":"s-shiji-108-han","paragraph_id":"c-shiji-108-han:p012","quote":"車騎將軍衞青擊匈奴，出上谷，破胡蘢城。將軍李廣爲匈奴所得，復失之；公孫敖大亡卒：皆當斬，贖爲庶人。明年，匈奴大入邊，殺遼西太守，及入鴈門，所殺略數千人。車騎將軍衞青擊之，出鴈門。衞尉安國爲材官將軍，屯於漁陽。安國捕生虜，言匈奴遠去。即上書言方田作時，請且罷軍屯。罷軍屯月餘，匈奴大入上谷、漁陽。安國壁乃有七百餘人，出與戰，不勝，復入壁。匈奴虜略千餘人及畜產而去。天子聞之，怒，使使責讓安國。徒安國益東，屯右北平。是時匈奴虜言當入東方。"}],"attestations":[{"id":"th-shiji108-041:a001","paragraph_id":"c-shiji-108-han:p012","start":19,"end":21,"surface":"將軍","person_mention_id":"c-shiji-108-han:m012-0021","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"記來源任官或用稱；未明年月及終止事件保持未知，篇末附載評論不作獨立任官證據。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-108-han:p009","text":"當是時，漢伏兵車騎材官二十餘萬，匿馬邑旁谷中。衞尉李廣爲驍騎將軍，太仆公孫賀爲輕車將軍，大行王恢爲將屯將軍，太中大夫李息爲材官將軍。御史大夫韓安國爲護軍將軍，諸將皆屬護軍。約單于入馬邑而漢兵縱發。王恢、李息、李廣別從代主擊其輜重。於是單于入漢長城武州塞。未