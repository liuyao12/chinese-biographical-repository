tal-ws1477957","paragraph_id":"c-nanshi-022-wangzhi-digital:p004","quote":"志善草隸，當時以為楷法。齊遊擊將軍徐希秀亦號能書，常謂志為「書聖」。志家居建康禁中裏馬糞巷。父僧虔門風寬恕，志尤惇厚，所曆不以罪咎劾人。門下客嘗盜脫志車幰賣之，志知而不問，待之如初。賓客遊其門者，專蓋其過而稱其善。兄弟子侄皆篤實謙和，時人號馬糞諸王為長者。普通四年，志改葬，武帝厚賻贈之，諡曰安。有五子：緝、休、諲、操、素。","person_mention_id":"c-nanshi-022-wangzhi-digital:p004:m0017"}],"status":"source_attested","interpretation_note":"本句所載官名，任期無確切年月。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-021-wangzhi-wyd:p005","text":"志善草隸當時以為楷法齊游擊將軍徐希秀亦號能書常謂志為書聖","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"start":0,"end":1,"surface":"志","id":"c-liangshu-021-wangzhi-wyd:p005:m0000","person_id":"7r6_k52_qji_ABAAAAEBC","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作志。"},{"start":15,"end":18,"surface":"徐希秀","id":"c-liangshu-021-wangzhi-wyd:p005:m0015","person_id":"s39_595_p8u","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作徐希秀。"},{"start":24,"end":25,"surface":"志","id":"c-liangshu-021-wangzhi-wyd:p005:m0024","person_id":"7r6_k52_qji_ABAAAAEBC","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作志。"}],"source_position":{"revision_id":"cbr-ai-transcription-sha256:6cb11d29f5f1b17fccce41c7ab1b3a1a9407ce97bd0b109ce070c05ba50e8550","source_layer":"received_biography","column_projection":[{"pdf_page":5,"leaf":"三下","half":"右","column_from_right":8,"start":1,"end":21,"text":"志善草隸當時以為楷法齊游擊將軍徐希秀亦號"},{"pdf_page":5,"leaf":"三下","half":"右","column_from_right":9,"start":0,"end":8,"text":"能書常謂志為書聖"}]},"chapter_id":"c-liangshu-021-wangzhi-wyd","book_id":"b-liangshu-021","work_id":"w-liangshu","source_id":"s-liangshu-021-wangzhi-wyd1739"},{"id":"c-liangshu-021-wangzhi:p005","text":"志善草隸，當時以爲楷法。齊遊擊將軍徐希秀亦號能書，常