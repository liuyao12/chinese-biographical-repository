084-qujia"}],"relations":[],"title_holdings":[{"id":"th-shiji084-001","person_id":"qpw_pw5_eqn","title":"左徒","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-084-qujia","source_id":"s-shiji-084-qujia","paragraph_id":"c-shiji-084-qujia:p001","quote":"屈原者，名平，楚之同姓也。為楚懷王左徒。博聞彊志，明於治亂，嫻于辭令。入則與王圖議國事，以出號令；出則接遇賓客，應對諸侯。王甚任之。"}],"attestations":[{"id":"th-shiji084-001:a001","paragraph_id":"c-shiji-084-qujia:p001","start":17,"end":19,"surface":"左徒","person_mention_id":"c-shiji-084-qujia:m001-0005","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"用稱與實際授任分存，未知起訖不補造；長沙太傅第19段為先述、第22段為事件，可能同一任期不當兩次實任。議任公卿不記已授；賈嘉九卿附述層次待覆核。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji084-004","person_id":"qpw_pw5_eqn","title":"三閭大夫","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-084-qujia","source_id":"s-shiji-084-qujia","paragraph_id":"c-shiji-084-qujia:p011","quote":"屈原至於江濱，被髪行吟澤畔。顏色憔悴，形容枯槁。漁父見而問之曰：「子非三閭大夫歟？何故而至此？」屈原曰：「舉世混濁而我獨清，眾人皆醉而我獨醒，是以見放。」漁父曰：「夫聖人者，不凝滯於物而能與世推移。舉世混濁，何不隨其流而揚其波？眾人皆醉，何不餔其糟而啜其醨？何故懷瑾握瑜而自令見放為？」屈原曰：「吾聞之，新沐者必彈冠，新浴者必振衣，人又誰能以身之察察，受物之汶汶者乎？寧赴常流而葬乎江魚腹中耳，又安能以皓皓之白而蒙世俗之溫蠖乎？」"}],"attestations":[{"id":"th-shiji084-004:a001","paragraph_id":"c-shiji-084-qujia:p011","start":35,"end":39,"surface":"三閭大夫","person_mention_id":"c-shiji-084-qujia:m011-0048","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"用稱與實際授任分存，未知起訖不補造；長沙太傅第19段為先述、第22段為事件，可能同一任期不當兩次實任。議任公卿不記已授；賈嘉九卿附述層次待覆核。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji084-001","person_id":"qpw_pw5_eqn","surfaces":["先生","夫子","屈原","屈平","平"],"scope":"same_chapter","chapter_ids":["c-shiji-084-qujia"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-084-qujia:p001","quote":"屈原者，名平，楚之同姓也。為楚懷王左徒。博聞彊志，明於治亂，嫻于辭令。入則與王圖議國事，以出號令；出則接遇賓客，應對諸侯。王甚任之。"},{"paragraph_id":"c-shiji-084-qujia:p002","quote":"上官大夫與之同列，爭寵而心害其能。懷王使屈原造為憲令，屈平屬草槁未定。上官大夫見而欲奪之，屈平不與。因讒之曰：「王使屈平為令，眾莫不知，每一令出，平伐其功，（曰）以為『非我莫能為』也。」王怒而疏屈平。"},{"paragraph_id":"c-shiji-084-qujia:p003","quote":"屈平疾王聽之不聰也，讒諂之蔽明也，邪曲之害公也，方正之不容也，故憂愁幽思而作《離騷》。離騷者，猶離憂也。夫天者，人之始也；父母者，人之本也。人窮則反本，故勞苦倦極，未嘗不呼天也；疾痛慘怛，未嘗不呼父母也。屈平正道直行，竭忠盡智以事其君，讒人間之，可謂窮矣。信而見疑，忠而被謗，能無怨乎？屈平之作《離騷》，蓋自怨生也。《國風》好色而不淫，《小雅》怨誹而不亂。若《離騷》者，可謂兼之矣。上稱帝嚳，下道齊桓，中述湯武，以刺世事。明道德之廣崇，治亂之條貫，靡不畢見。其文約，其辭微，其志絜，其行廉。其稱文小而其指極大，舉類邇而見義遠。其志絜，故其稱物芳；其行廉，故死而不容自疏。濯淖汙泥之中，蟬蛻於濁穢，以浮游塵埃之外，不獲世之滋垢，皭然泥而不滓者也。推此志也，雖與日月爭光可也。"},{"paragraph_id":"c-shiji-084-qujia:p004","quote":"屈平既絀，其後秦欲伐齊。齊與楚從親，惠王患之。乃令張儀詳去秦，厚幣委質事楚，曰：「秦甚憎齊，齊與楚從親。楚誠能絕齊，秦願獻商、於之地六百里。」楚懷王貪而信張儀，遂絕齊，使使如秦受地。張儀詐之曰：「儀與王約六里，不聞六百里。」楚使怒去，歸告懷王。懷王怒，大興師伐秦。秦發兵擊之，大破楚師於丹、淅，斬首八萬，虜楚將屈丐，遂取楚之漢中地。懷王乃悉發國中兵以深入擊秦，戰於藍田。魏聞之，襲楚至鄧。楚兵懼，自秦歸。而齊竟怒不救楚，楚大困。"},{"paragraph_id":"c-shiji-084-qujia:p005","quote":"明年，秦割漢中地與楚以和。楚王曰：「不願得地，願得張儀而甘心焉。」張儀聞，乃曰：「以一儀而當漢中地，臣請往如楚。」如楚，又因厚幣用事者臣靳尚，而設詭辯於懷王之寵姬鄭袖。懷王竟聽鄭袖，復釋去張儀。是時屈平既疏，不復在位，使於齊，顧反，諫懷王曰：「何不殺張儀？」懷王悔，追張儀不及。"},{"paragraph_id":"c-shiji-084-qujia:p007","quote":"時秦昭王與楚婚，欲與懷王會。懷王欲行，屈平曰：「秦虎狼之國，不可信，不如毋行。」懷王稚子子蘭勸王行：「奈何絕秦歡？」懷王卒行。入武關，秦伏兵絕其後，因留懷王，以求割地。懷王怒，不聽。亡走趙，趙不內。復之秦，竟死於秦而歸葬。"},{"paragraph_id":"c-shiji-084-qujia:p009","quote":"屈平既嫉之，雖放流，睠顧楚國，系心懷王，不忘欲反，冀幸君之一悟，俗之一改也。其存君興國而欲反覆之，一篇之中三致志焉。然終無可奈何，故不可以反，卒以此見懷王之終不悟也。人君無愚智賢不肖，莫不欲求忠以自為，舉賢以自佐，然亡國破家相隨屬，而聖君治國累世而不見者，其所謂忠者不忠，而所謂賢者不賢也。懷王以不知忠臣之分，故內惑於鄭袖，外欺於張儀，疏屈平而信上官大夫、令尹子蘭。兵挫地削，亡其六郡，身客死於秦，為天下笑。此不知人之禍也。《易》曰：「井泄不食，為我心惻，可以汲。王明，并受其福。」王之不明，豈足福哉？"},{"paragraph_id":"c-shiji-084-qujia:p010","quote":"令尹子蘭聞之大怒，卒使上官大夫短屈原於頃襄王，頃襄王怒而遷之。"},{"paragraph_id":"c-shiji-084-qujia:p011","quote":"屈原至於江濱，被髪行吟澤畔。顏色憔悴，形容枯槁。漁父見而問之曰：「子非三閭大夫歟？何故而至此？」屈原曰：「舉世混濁而我獨清，眾人皆醉而我獨醒，是以見放。」漁父曰：「夫聖人者，不凝滯於物而能與世推移。舉世混濁，何不隨其流而揚其波？眾人皆醉，何不餔其糟而啜其醨？何故懷瑾握瑜而自令見放為？」屈原曰：「吾聞之，新沐者必彈冠，新浴者必振衣，人又誰能以身之察察，受物之汶汶者乎？寧赴常流而葬乎江魚腹中耳，又安能以皓皓之白而蒙世俗之溫蠖乎？」"},{"paragraph_id":"c-shiji-084-qujia:p018","quote":"屈原既死之後，楚有宋玉、唐勒、景差之徒者，皆好辭而以賦見稱；然皆祖屈原之從容辭令，終莫敢直諫。其後楚日以削，數十年竟為秦所滅。"},{"paragraph_id":"c-shiji-084-qujia:p019","quote":"自屈原沈汨羅後百有餘年，漢有賈生，為長沙王太傅，過湘水，投書以弔屈原。"},{"paragraph_id":"c-shiji-084-qujia:p023","quote":"賈生既辭往行，聞長沙卑溼，自以壽不得長，又以適去，意不自得。及渡湘水，為賦以弔屈原。其辭曰："},{"paragraph_id":"c-shiji-084-qujia:p024","quote":"共承嘉惠兮，俟罪長沙。側聞屈原兮，自沈汨羅。造讬湘流兮，敬弔先生。遭世罔極兮，乃隕厥身。嗚呼哀哉，逢時不祥！鸞鳳伏竄兮，鴟梟翺翔：闒茸尊顯兮，讒諛得志；賢聖逆曳兮，方正倒植。世謂伯夷貪兮，謂盜跖廉；莫邪為頓兮，鉛刀為銛。于嗟嚜嚜兮，生之無故！斡棄周鼎兮寶康瓠，騰駕罷牛兮驂蹇驢，驥垂兩耳兮服鹽車。章甫薦屨兮，漸不可久；嗟苦先生兮，獨離此咎！"},{"paragraph_id":"c-shiji-084-qujia:p025","quote":"訊曰：已矣，國其莫我知，獨堙郁兮其誰語？鳳漂漂其高遰兮，夫固自縮而遠去。襲九淵之神龍兮，沕深潛以自珍。彌融爚以隱處兮，夫豈從螘與蛭螾？所貴聖人之神德兮，遠濁世而自藏。使騏驥可得系羈兮，豈云異夫犬羊！般紛紛其離此尤兮，亦夫子之辜也！瞝九州而相君兮，何必懷此都也？鳳皇翔于千仞之上兮，覽德惪而下之；見細德之險微兮，搖增翮逝而去之。彼尋常之汙瀆兮，豈能容吞舟之魚！橫江湖之鱣鱏兮，固將制於蟻螻。"},{"paragraph_id":"c-shiji-084-qujia:p033","quote":"太史公曰：余讀離騷、天問、招魂、哀郢，悲其志。適長沙，觀屈原所自沈淵，未嘗不垂涕，想見其為人。及見賈生弔之，又怪屈原以彼其材，游諸侯，何國不容，而自令若是。讀服烏賦，同死生，輕去就，又爽然自失矣。"}],"rationale":"依前5段明示屈原名平、屈平與懷王張儀敘事暫接；湯武短稱各存，未補姓名。王、臣、吾等嵌套指代仍待逐處核定。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-084-qujia:p001","text":"屈原者，名平，楚之同姓也。為楚懷王左徒。博聞彊志，明於治亂，嫻于辭令。入則與王圖議國事，以出號令；出則接遇賓客，應對諸侯。王甚任之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m001-0000","start":0,"end":2,"surface":"屈原","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m001-0005","start":5,"end":6,"surface":"平","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m001-0014","start":14,"end":17,"surface":"楚懷王","kind":"person","person_id":"f7y_qvp_mch","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m001-0053","start":53,"end":55,"surface":"賓客","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛論或未定指代保留。"},{"id":"c-shiji-084-qujia:m001-0058","start":58,"end":60,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛論或未定指代保留。"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"},{"id":"c-shiji-084-qujia:p002","text":"上官大夫與之同列，爭寵而心害其能。懷王使屈原造為憲令，屈平屬草槁未定。上官大夫見而欲奪之，屈平不與。因讒之曰：「王使屈平為令，眾莫不知，每一令出，平伐其功，（曰）以為『非我莫能為』也。」王怒而疏屈平。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m002-0000","start":0,"end":4,"surface":"上官大夫","kind":"person","person_id":"xwc_7eh_kj1","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m002-0017","start":17,"end":19,"surface":"懷王","kind":"person","person_id":"f7y_qvp_mch","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m002-0020","start":20,"end":22,"surface":"屈原","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m002-0027","start":27,"end":29,"surface":"屈平","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m002-0035","start":35,"end":39,"surface":"上官大夫","kind":"person","person_id":"xwc_7eh_kj1","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m002-0045","start":45,"end":47,"surface":"屈平","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m002-0058","start":58,"end":60,"surface":"屈平","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m002-0063","start":63,"end":64,"surface":"眾","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛論或未定指代保留。"},{"id":"c-shiji-084-qujia:m002-0097","start":97,"end":99,"surface":"屈平","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"},{"id":"c-shiji-084-qujia:p003","text":"屈平疾王聽之不聰也，讒諂之蔽明也，邪曲之害公也，方正之不容也，故憂愁幽思而作《離騷》。離騷者，猶離憂也。夫天者，人之始也；父母者，人之本也。人窮則反本，故勞苦倦極，未嘗不呼天也；疾痛慘怛，未嘗不呼父母也。屈平正道直行，竭忠盡智以事其君，讒人間之，可謂窮矣。信而見疑，忠而被謗，能無怨乎？屈平之作《離騷》，蓋自怨生也。《國風》好色而不淫，《小雅》怨誹而不亂。若《離騷》者，可謂兼之矣。上稱帝嚳，下道齊桓，中述湯武，以刺世事。明道德之廣崇，治亂之條貫，靡不畢見。其文約，其辭微，其志絜，其行廉。其稱文小而其指極大，舉類邇而見義遠。其志絜，故其稱物芳；其行廉，故死而不容自疏。濯淖汙泥之中，蟬蛻於濁穢，以浮游塵埃之外，不獲世之滋垢，皭然泥而不滓者也。推此志也，雖與日月爭光可也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m003-0000","start":0,"end":2,"surface":"屈平","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m003-0061","start":61,"end":63,"surface":"父母","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛論或未定指代保留。"},{"id":"c-shiji-084-qujia:m003-0098","start":98,"end":100,"surface":"父母","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛論或未定指代保留。"},{"id":"c-shiji-084-qujia:m003-0102","start":102,"end":104,"surface":"屈平","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m003-0118","start":118,"end":120,"surface":"讒人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛論或未定指代保留。"},{"id":"c-shiji-084-qujia:m003-0143","start":143,"end":145,"surface":"屈平","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m003-0193","start":193,"end":195,"surface":"帝嚳","kind":"person","person_id":"irt_r82_b3b","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m003-0198","start":198,"end":200,"surface":"齊桓","kind":"person","person_id":"tib_iww_tkq","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m003-0203","start":203,"end":204,"surface":"湯","kind":"person","person_id":"vvt_6h5_czb","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m003-0204","start":204,"end":205,"surface":"武","kind":"person","person_id":"otx_w5y_yup","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"},{"id":"c-shiji-084-qujia:p004","text":"屈平既絀，其後秦欲伐齊。齊與楚從親，惠王患之。乃令張儀詳去秦，厚幣委質事楚，曰：「秦甚憎齊，齊與楚從親。楚誠能絕齊，秦願獻商、於之地六百里。」楚懷王貪而信張儀，遂絕齊，使使如秦受地。張儀詐之曰：「儀與王約六里，不聞六百里。」楚使怒去，歸告懷王。懷王怒，大興師伐秦。秦發兵擊之，大破楚師於丹、淅，斬首八萬，虜楚將屈丐，遂取楚之漢中地。懷王乃悉發國中兵以深入擊秦，戰於藍田。魏聞之，襲楚至鄧。楚兵懼，自秦歸。而齊竟怒不救楚，楚大困。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m004-0000","start":0,"end":2,"surface":"屈平","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m004-0018","start":18,"end":20,"surface":"惠王","kind":"person","person_id":"xxy_58r_nto","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m004-0025","start":25,"end":27,"surface":"張儀","kind":"person","person_id":"rq9_a9c_79b","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m004-0071","start":71,"end":74,"surface":"楚懷王","kind":"person","person_id":"f7y_qvp_mch","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m004-0077","start":77,"end":79,"surface":"張儀","kind":"person","person_id":"rq9_a9c_79b","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m004-0091","start":91,"end":93,"surface":"張儀","kind":"person","person_id":"rq9_a9c_79b","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m004-0112","start":112,"end":114,"surface":"楚使","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛論或未定指代保留。"},{"id":"c-shiji-084-qujia:m004-0119","start":119,"end":121,"surface":"懷王","kind":"person","person_id":"f7y_qvp_mch","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m004-0122","start":122,"end":124,"surface":"懷王","kind":"person","person_id":"f7y_qvp_mch","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m004-0153","start":153,"end":157,"surface":"楚將屈丐","kind":"person","person_id":"yx1_ywn_ylm","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m004-0166","start":166,"end":168,"surface":"懷王","kind":"person","person_id":"f7y_qvp_mch","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"},{"id":"c-shiji-084-qujia:p005","text":"明年，秦割漢中地與楚以和。楚王曰：「不願得地，願得張儀而甘心焉。」張儀聞，乃曰：「以一儀而當漢中地，臣請往如楚。」如楚，又因厚幣用事者臣靳尚，而設詭辯於懷王之寵姬鄭袖。懷王竟聽鄭袖，復釋去張儀。是時屈平既疏，不復在位，使於齊，顧反，諫懷王曰：「何不殺張儀？」懷王悔，追張儀不及。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m005-0025","start":25,"end":27,"surface":"張儀","kind":"person","person_id":"rq9_a9c_79b","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m005-0033","start":33,"end":35,"surface":"張儀","kind":"person","person_id":"rq9_a9c_79b","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m005-0064","start":64,"end":67,"surface":"用事者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛論或未定指代保留。"},{"id":"c-shiji-084-qujia:m005-0068","start":68,"end":70,"surface":"靳尚","kind":"person","person_id":"uqb_kzh_4me","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m005-0076","start":76,"end":78,"surface":"懷王","kind":"person","person_id":"f7y_qvp_mch","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m005-0081","start":81,"end":83,"surface":"鄭袖","kind":"person","person_id":"ozo_bsb_cnj","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m005-0084","start":84,"end":86,"surface":"懷王","kind":"person","person_id":"f7y_qvp_mch","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m005-0088","start":88,"end":90,"surface":"鄭袖","kind":"person","person_id":"ozo_bsb_cnj","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m005-0094","start":94,"end":96,"surface":"張儀","kind":"person","person_id":"rq9_a9c_79b","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m005-0099","start":99,"end":101,"surface":"屈平","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m005-0117","start":117,"end":119,"surface":"懷王","kind":"person","person_id":"f7y_qvp_mch","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m005-0125","start":125,"end":127,"surface":"張儀","kind":"person","person_id":"rq9_a9c_79b","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m005-0129","start":129,"end":131,"surface":"懷王","kind":"person","person_id":"f7y_qvp_mch","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m005-0134","start":134,"end":136,"surface":"張儀","kind":"person","person_id":"rq9_a9c_79b","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"},{"id":"c-shiji-084-qujia:p007","text":"時秦昭王與楚婚，欲與懷王會。懷王欲行，屈平曰：「秦虎狼之國，不可信，不如毋行。」懷王稚子子蘭勸王行：「奈何絕秦歡？」懷王卒行。入武關，秦伏兵絕其後，因留懷王，以求割地。懷王怒，不聽。亡走趙，趙不內。復之秦，竟死於秦而歸葬。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m007-0001","start":1,"end":4,"surface":"秦昭王","kind":"person","person_id":"l2j_rm8_h4z","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m007-0010","start":10,"end":12,"surface":"懷王","kind":"person","person_id":"f7y_qvp_mch","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m007-0014","start":14,"end":16,"surface":"懷王","kind":"person","person_id":"f7y_qvp_mch","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m007-0019","start":19,"end":21,"surface":"屈平","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m007-0040","start":40,"end":42,"surface":"懷王","kind":"person","person_id":"f7y_qvp_mch","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m007-0044","start":44,"end":46,"surface":"子蘭","kind":"person","person_id":"f7y_qvp_mch_A","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m007-0058","start":58,"end":60,"surface":"懷王","kind":"person","person_id":"f7y_qvp_mch","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m007-0076","start":76,"end":78,"surface":"懷王","kind":"person","person_id":"f7y_qvp_mch","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m007-0084","start":84,"end":86,"surface":"懷王","kind":"person","person_id":"f7y_qvp_mch","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"},{"id":"c-shiji-084-qujia:p009","text":"屈平既嫉之，雖放流，睠顧楚國，系心懷王，不忘欲反，冀幸君之一悟，俗之一改也。其存君興國而欲反覆之，一篇之中三致志焉。然終無可奈何，故不可以反，卒以此見懷王之終不悟也。人君無愚智賢不肖，莫不欲求忠以自為，舉賢以自佐，然亡國破家相隨屬，而聖君治國累世而不見者，其所謂忠者不忠，而所謂賢者不賢也。懷王以不知忠臣之分，故內惑於鄭袖，外欺於張儀，疏屈平而信上官大夫、令尹子蘭。兵挫地削，亡其六郡，身客死於秦，為天下笑。此不知人之禍也。《易》曰：「井泄不食，為我心惻，可以汲。王明，并受其福。」王之不明，豈足福哉？","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m009-0000","start":0,"end":2,"surface":"屈平","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m009-0017","start":17,"end":19,"surface":"懷王","kind":"person","person_id":"f7y_qvp_mch","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m009-0075","start":75,"end":77,"surface":"懷王","kind":"person","person_id":"f7y_qvp_mch","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m009-0083","start":83,"end":85,"surface":"人君","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或泛稱保持未解，不補姓名。"},{"id":"c-shiji-084-qujia:m009-0117","start":117,"end":119,"surface":"聖君","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或泛稱保持未解，不補姓名。"},{"id":"c-shiji-084-qujia:m009-0145","start":145,"end":147,"surface":"懷王","kind":"person","person_id":"f7y_qvp_mch","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m009-0150","start":150,"end":152,"surface":"忠臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或泛稱保持未解，不補姓名。"},{"id":"c-shiji-084-qujia:m009-0159","start":159,"end":161,"surface":"鄭袖","kind":"person","person_id":"ozo_bsb_cnj","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m009-0165","start":165,"end":167,"surface":"張儀","kind":"person","person_id":"rq9_a9c_79b","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m009-0169","start":169,"end":171,"surface":"屈平","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m009-0173","start":173,"end":177,"surface":"上官大夫","kind":"person","person_id":"xwc_7eh_kj1","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m009-0178","start":178,"end":182,"surface":"令尹子蘭","kind":"person","person_id":"f7y_qvp_mch_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"},{"id":"c-shiji-084-qujia:p010","text":"令尹子蘭聞之大怒，卒使上官大夫短屈原於頃襄王，頃襄王怒而遷之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m010-0000","start":0,"end":4,"surface":"令尹子蘭","kind":"person","person_id":"f7y_qvp_mch_A","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m010-0011","start":11,"end":15,"surface":"上官大夫","kind":"person","person_id":"xwc_7eh_kj1","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m010-0016","start":16,"end":18,"surface":"屈原","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m010-0019","start":19,"end":22,"surface":"頃襄王","kind":"person","person_id":"f7y_qvp_mch_B","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m010-0023","start":23,"end":26,"surface":"頃襄王","kind":"person","person_id":"f7y_qvp_mch_B","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"},{"id":"c-shiji-084-qujia:p011","text":"屈原至於江濱，被髪行吟澤畔。顏色憔悴，形容枯槁。漁父見而問之曰：「子非三閭大夫歟？何故而至此？」屈原曰：「舉世混濁而我獨清，眾人皆醉而我獨醒，是以見放。」漁父曰：「夫聖人者，不凝滯於物而能與世推移。舉世混濁，何不隨其流而揚其波？眾人皆醉，何不餔其糟而啜其醨？何故懷瑾握瑜而自令見放為？」屈原曰：「吾聞之，新沐者必彈冠，新浴者必振衣，人又誰能以身之察察，受物之汶汶者乎？寧赴常流而葬乎江魚腹中耳，又安能以皓皓之白而蒙世俗之溫蠖乎？」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m011-0000","start":0,"end":2,"surface":"屈原","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m011-0024","start":24,"end":26,"surface":"漁父","kind":"person","person_id":"rp7_jtw_344","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m011-0048","start":48,"end":50,"surface":"屈原","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m011-0062","start":62,"end":64,"surface":"眾人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或泛稱保持未解，不補姓名。"},{"id":"c-shiji-084-qujia:m011-0077","start":77,"end":79,"surface":"漁父","kind":"person","person_id":"rp7_jtw_344","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m011-0083","start":83,"end":85,"surface":"聖人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或泛稱保持未解，不補姓名。"},{"id":"c-shiji-084-qujia:m011-0114","start":114,"end":116,"surface":"眾人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或泛稱保持未解，不補姓名。"},{"id":"c-shiji-084-qujia:m011-0143","start":143,"end":145,"surface":"屈原","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"},{"id":"c-shiji-084-qujia:p018","text":"屈原既死之後，楚有宋玉、唐勒、景差之徒者，皆好辭而以賦見稱；然皆祖屈原之從容辭令，終莫敢直諫。其後楚日以削，數十年竟為秦所滅。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m018-0000","start":0,"end":2,"surface":"屈原","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m018-0009","start":9,"end":11,"surface":"宋玉","kind":"person","person_id":"0ng_one_sdy","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m018-0012","start":12,"end":14,"surface":"唐勒","kind":"person","person_id":"u2c_fe5_16n","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m018-0015","start":15,"end":17,"surface":"景差","kind":"person","person_id":"bwl_rr1_upp","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m018-0017","start":17,"end":19,"surface":"之徒","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代保持未解。"},{"id":"c-shiji-084-qujia:m018-0033","start":33,"end":35,"surface":"屈原","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"},{"id":"c-shiji-084-qujia:p019","text":"自屈原沈汨羅後百有餘年，漢有賈生，為長沙王太傅，過湘水，投書以弔屈原。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m019-0001","start":1,"end":3,"surface":"屈原","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m019-0014","start":14,"end":16,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m019-0032","start":32,"end":34,"surface":"屈原","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"},{"id":"c-shiji-084-qujia:p023","text":"賈生既辭往行，聞長沙卑溼，自以壽不得長，又以適去，意不自得。及渡湘水，為賦以弔屈原。其辭曰：","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m023-0000","start":0,"end":2,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m023-0039","start":39,"end":41,"surface":"屈原","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"},{"id":"c-shiji-084-qujia:p024","text":"共承嘉惠兮，俟罪長沙。側聞屈原兮，自沈汨羅。造讬湘流兮，敬弔先生。遭世罔極兮，乃隕厥身。嗚呼哀哉，逢時不祥！鸞鳳伏竄兮，鴟梟翺翔：闒茸尊顯兮，讒諛得志；賢聖逆曳兮，方正倒植。世謂伯夷貪兮，謂盜跖廉；莫邪為頓兮，鉛刀為銛。于嗟嚜嚜兮，生之無故！斡棄周鼎兮寶康瓠，騰駕罷牛兮驂蹇驢，驥垂兩耳兮服鹽車。章甫薦屨兮，漸不可久；嗟苦先生兮，獨離此咎！","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m024-0013","start":13,"end":15,"surface":"屈原","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m024-0030","start":30,"end":32,"surface":"先生","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m024-0071","start":71,"end":73,"surface":"讒諛","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未能逐一辨識的後裔，保留原稱，不補造姓名與闕代。"},{"id":"c-shiji-084-qujia:m024-0076","start":76,"end":78,"surface":"賢聖","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未能逐一辨識的後裔，保留原稱，不補造姓名與闕代。"},{"id":"c-shiji-084-qujia:m024-0089","start":89,"end":91,"surface":"伯夷","kind":"person","person_id":"5zv_8nc_ifz","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m024-0095","start":95,"end":97,"surface":"盜跖","kind":"person","person_id":"xu5_0nl_f5z","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m024-0161","start":161,"end":163,"surface":"先生","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"},{"id":"c-shiji-084-qujia:p025","text":"訊曰：已矣，國其莫我知，獨堙郁兮其誰語？鳳漂漂其高遰兮，夫固自縮而遠去。襲九淵之神龍兮，沕深潛以自珍。彌融爚以隱處兮，夫豈從螘與蛭螾？所貴聖人之神德兮，遠濁世而自藏。使騏驥可得系羈兮，豈云異夫犬羊！般紛紛其離此尤兮，亦夫子之辜也！瞝九州而相君兮，何必懷此都也？鳳皇翔于千仞之上兮，覽德惪而下之；見細德之險微兮，搖增翮逝而去之。彼尋常之汙瀆兮，豈能容吞舟之魚！橫江湖之鱣鱏兮，固將制於蟻螻。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m025-0069","start":69,"end":71,"surface":"聖人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未能逐一辨識的後裔，保留原稱，不補造姓名與闕代。"},{"id":"c-shiji-084-qujia:m025-0109","start":109,"end":111,"surface":"夫子","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"},{"id":"c-shiji-084-qujia:p033","text":"太史公曰：余讀離騷、天問、招魂、哀郢，悲其志。適長沙，觀屈原所自沈淵，未嘗不垂涕，想見其為人。及見賈生弔之，又怪屈原以彼其材，游諸侯，何國不容，而自令若是。讀服烏賦，同死生，輕去就，又爽然自失矣。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m033-0000","start":0,"end":3,"surface":"太史公","kind":"person","person_id":"4xh_zzy_gyn","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m033-0028","start":28,"end":30,"surface":"屈原","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m033-0049","start":49,"end":51,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m033-0056","start":56,"end":58,"surface":"屈原","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"}],"sources":[{"chapter_id":"c-shiji-084-qujia","work_id":"w-shiji","book_id":"b-shiji-084","source_id":"s-shiji-084-qujia","source":{"title":"史記／卷084","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷084","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷084&oldid=1568305","revision_id":1568305,"accessed_on":"2026-10-09","extent":"33段正文，屈原、懷沙、賈生及篇末評論；索隱述贊另層待收。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{"铦":"銛","鸮":"鴞"},"editorial_readings":[{"paragraph_id":"c-shiji-084-qujia:p017","witness_form":"（投）［沈］","body_reading":"投","note":"數位增刪改讀提示另存，正文保留增改前形式，未核影像，不當已校定。"},{"paragraph_id":"c-shiji-084-qujia:p025","witness_form":"（微）［徵］","body_reading":"微","note":"數位增刪改讀提示另存，正文保留增改前形式，未核影像，不當已校定。"}],"extraction_note":"固定HTML與取得時版本一致；兩項改讀前形投、微保留。正文去腳註標記[1]，註文另存。括號曰保留，簡體字形轉換明記。 第13至16段懷沙、第24至25段弔屈原賦及第27至29段服鳥賦按傳世正文次序保留，詩賦引古不視為敘事當時人物；第32段孝昭附述傳承仍待覆核。","note":"全33段正文與HTML篇界已核讀，明示姓名首輪已存；未核底本影像與現代研究。","digital_footnotes":[{"block_index":8,"anchor":