c-jinshu-077-yinhao"},{"id":"c-jinshu-077-yinhao:p011:m0060","start":60,"end":61,"surface":"之","kind":"person","person_id":"al7_2l9_13l","status":"contextual_provisional","interpretation_note":"依完整敘事／引語主語逐段辨識；原字不校改。","paragraph_id":"c-jinshu-077-yinhao:p011","chapter_id":"c-jinshu-077-yinhao"},{"id":"c-songshu-050-hufan:p002:m0012","start":12,"end":14,"surface":"韓伯","kind":"person","person_id":"al7_2l9_13l","status":"contextual_provisional","paragraph_id":"c-songshu-050-hufan:p002","chapter_id":"c-songshu-050-hufan"}],"relations":[{"id":"a-jin075-han-mother","subject_person_id":"al7_2l9_13l","object_person_id":"xa7_iwp_xxf","predicate":"mother","qualifiers":{"source_term":"母殷氏，高明有行"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-075","chapter_id":"c-jinshu-075-hanbo","source_id":"s-jinshu-075-hanbo-ws2645530","paragraph_id":"c-jinshu-075-hanbo:p001","quote":"韓伯，字康伯，潁川長社人也。母殷氏，高明有行。家貧窶，伯年數歲，至大寒，母方為作襦，令伯捉熨斗，而謂之曰：「且著襦，尋當作復褌。」伯曰：「不復須。」母問其故，對曰：「火在鬥中，而柄尚熱，今既著襦，下亦當暖。」母甚異之。及長，清和有思理，留心文藝。舅殷浩稱之曰：「康伯能自標置，居然是出群之器。」潁川庾龢名重一時，少所推服，常稱伯及王坦之曰：「思理倫和，我敬韓康伯；志力強正，吾愧王文度。自此以還，吾皆百之矣。」","subject_person_mention_id":"c-jinshu-075-hanbo:p001:m0000","object_person_mention_id":"c-jinshu-075-hanbo:p001:m0015"}],"status":"source_attested","interpretation_note":"母殷氏製襦事單列，名字未具。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"title_holdings":[{"id":"th-songshu-050-hufan-2-10","title":"太守","kind":"office","mode":"attestation","person_id":"al7_2l9_13l","attestations":[{"id":"th-songshu-050-hufan-2-10:a","paragraph_id":"c-songshu-050-hufan:p002","start":10,"end":12,"surface":"太守","person_mention_id":"c-songshu-050-hufan:p002:m0012","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-050","chapter_id":"c-songshu-050-hufan","source_id":"s-songshu-050-hufan-ws2371899","paragraph_id":"c-songshu-050-hufan:p002","quote":"藩少孤，居喪以毀稱。太守韓伯見之，謂藩叔尚書少廣曰：「卿此姪當以義烈成名。」州府辟召，不就。須二弟冠婚畢，及參郗恢征虜軍事。時殷仲堪為荊州刺史，藩外兄羅企生為仲堪參軍，藩請假還，過江陵省企生。仲堪要藩相見，接待甚厚。藩因說仲堪曰：「桓玄意趣不常，每怏怏於失職。節下崇待太過，非將來之計也。」仲堪色不悅。藩退而謂企生曰：「倒戈授人，必至之禍。若不早規去就，後悔無及。」玄自夏口襲仲堪，藩參玄後軍軍事。仲堪敗，企生果以附從及禍。藩轉參太尉、大將軍、相國軍事。","person_mention_id":"c-songshu-050-hufan:p002:m0012"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-075-fanjian:p002","text":"子啟，字榮期，雖經學不及堅，而以才義顯於當世。于時清談之士庾龢、韓伯、袁宏等，並相知友。為秘書郎，累居顯職，終於黃門侍郎。父子並有文筆傳於世。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":209,"last_line":209,"raw_start":16541,"raw_end":16614,"raw_character_offsets":[16543,16544,16545,16546,16547,16548,16549,16550,16551,16552,16553,16554,16555,16556,16557,16558,16559,16560,16561,16562,16563,16564,16565,16566,16567,16568,16569,16570,16571,16572,16573,16574,16575,16576,16577,16578,16579,16580,16581,16582,16583,16584,16585,16586,16587,16588,16589,16590,16591,16592,16593,16594,16595,16596,16597,16598,16599,16600,16601,16602,16603,16604,16605,16606,16607,16608,16609,16610,16611,16612,16613],"revision_id":2645530},"mentions":[{"id":"c-jinshu-075-fanjian:p002:m0001","surface":"啟","start":1,"end":2,"person_id":"teg_egr_8uv","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-075-fanjian:p002:m0012","surface":"堅","start":12,"end":13,"person_id":"uo0_d4m_gyl","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-075-fanjian:p002:m0029","surface":"庾龢","start":29,"end":31,"person_id":"4qr_wrk_3vd_BC","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-075-fanjian:p002:m0032","surface":"韓伯","start":32,"end":34,"person_id":"al7_2l9_13l","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-075-fanjian:p002:m0035","surface":"袁宏","start":35,"end":37,"person_id":"yin_215_w6q","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-075-fanjian","book_id":"b-jinshu-075","work_id":"w-jinshu","source_id":"s-jinshu-075-fanjian-ws2645530"},{"id":"c-jinshu-075-hanbo:p001","text":"韓伯，字康伯，潁川長社人也。母殷氏，高明有行。家貧窶，伯年數歲，至大寒，母方為作襦，令伯捉熨斗，而謂之曰：「且著襦，尋當作復褌。」伯曰：「不復須。」母問其故，對曰：「火在鬥中，而柄尚熱，今既著襦，下亦當暖。」母甚異之。及長，清和有思理，留心文藝。舅殷浩稱之曰：「康伯能自標置，居然是出群之器。」潁川庾龢名重一時，少所推服，常稱伯及王坦之曰：「思理倫和，我敬韓康伯；志力強正，吾愧王文度。自此以還，吾皆百之矣。」","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":226,"last_line":226,"raw_start":17780,"raw_end":17987,"raw_character_offsets":[17782,17783,17784,17785,17786,17787,17788,17789,17790,17791,17792,17793,17794,17795,17796,17797,17798,17799,17800,17801,17802,17803,17804,17805,17806,17807,17808,17809,17810,17811,17812,17813,17814,17815,17816,17817,17818,17819,17820,17821,17822,17823,17824,17825,17826,17827,17828,17829,17830,17831,17832,17833,17834,17835,17836,17837,17838,17839,17840,17841,17842,17843,17844,17845,17846,17847,17848,17849,17850,17851,17852,17853,17854,17855,17856,17857,17858,17859,17860,17861,17862,17863,17864,17865,17866,17867,17868,17869,17870,17871,17872,17873,17874,17875,17876,17877,17878,17879,17880,17881,17882,17883,17884,17885,17886,17887,17888,17889,17890,17891,17892,17893,17894,17895,17896,17897,17898,17899,17900,17901,17902,17903,17904,17905,17906,17907,17908,17909,17910,17911,17912,17913,17914,17915,17916,17917,17918,17919,17920,17921,17922,17923,17924,17925,17926,17927,17928,17929,17930,17931,17932,17933,17934,17935,17936,17937,17938,17939,17940,17941,17942,17943,17944,17945,17946,17947,17948,17949,17950,17951,17952,17953,17954,17955,17956,17957,17958,17959,17960,17961,17962,17963,17964,17965,17966,17967,17968,17969,17970,17971,17972,17973,17974,17975,17976,17977,17978,17979,17980,17981,17982,17983,17984,17985,17986],"revision_id":2645530},"mentions":[{"id":"c-jinshu-075-hanbo:p001:m0000","surface":"韓伯","start":0,"end":2,"person_id":"al7_2l9_13l","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-075-hanbo:p001:m0004","surface":"康伯","start":4,"end":6,"person_id":"al7_2l9_13l","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-075-hanbo:p001:m0015","surface":"殷氏","start":15,"end":17,"person_id":"xa7_iwp_xxf","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-075-hanbo:p001:m0124","surface":"殷浩","start":124,"end":126,"person_id":"djo_u3b_i9w_A","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-075-hanbo:p001:m0131","surface":"康伯","start":131,"end":133,"person_id":"al7_2l9_13l","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-075-hanbo:p001:m0149","surface":"庾龢","start":149,"end":151,"person_id":"4qr_wrk_3vd_BC","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-075-hanbo:p001:m0165","surface":"王坦之","start":165,"end":168,"person_id":"a8f_ec8_e74_AAAAA","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-075-hanbo:p001:m0179","surface":"康伯","start":179,"end":181,"person_id":"al7_2l9_13l","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-075-hanbo:p001:m0189","surface":"王文度","start":189,"end":192,"person_id":"a8f_ec8_e74_AAAAA","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-075-hanbo","book_id":"b-jinshu-075","work_id":"w-jinshu","source_id":"s-jinshu-075-hanbo-ws2645530"},{"id":"c-jinshu-075-hanbo:p002","text":"舉秀才，征佐著作郎，並不就。簡文帝居籓，引為談客，自司徒左西屬轉撫軍掾、中書郎、散騎常侍、豫章太守，入為侍中。陳郡周勰為謝安主簿，居喪廢禮，崇尚莊老，脫落名教。伯領中正，不通勰，議曰：「拜下之敬，猶違眾從禮。情理之極，不宜以多比為通。」時人憚焉。」識者謂伯可謂澄世所不能澄，而裁世所不能裁者矣，與夫容己順眾者，豈得同時而共稱哉！","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":228,"last_line":228,"raw_start":17989,"raw_end":18155,"raw_character_offsets":[17991,17992,17993,17994,17995,17996,17997,17998,17999,18000,18001,18002,18003,18004,18005,18006,18007,18008,18009,18010,18011,18012,18013,18014,1