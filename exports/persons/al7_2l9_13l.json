h_id":"c-jinshu-077-yinhao:p011","person_mention_id":"c-jinshu-077-yinhao:p011:m0053","quote":"浩雖被黜放，口無怨言，夷神委命，談詠不輟，雖家人不見其有流放之戚。但終日書空，作「咄咄怪事」四字而已。浩甥韓伯，浩素賞愛之，隨至徙所，經歲還都，浩送至渚側，詠曹顏遠詩云：「富貴他人合，貧賤親戚離。」因而泣下。後溫將以浩為尚書令，遺書告之，浩欣然許焉。將答書，慮有謬誤，開閉者數十，竟達空函，大忤溫意，由是遂絕。永和十二年卒。","source_anchor":{"paragraph_id":"c-jinshu-077-yinhao:p011","start":53,"end":55,"surface":"韓伯"},"note":"明冠姓名按原字；略名不由父姓或既有label倒填本句未見之姓，保留字形差異。","status":"editorial_provisional","human_reviewed":false,"model":null,"work_id":"w-jinshu","book_id":"b-jinshu-077","source_id":"s-jinshu-077-yinhao"}],"mentions":[{"id":"c-jinshu-077-yinhao:p011:m0052","start":52,"end":53,"surface":"甥","kind":"person","person_id":"al7_2l9_13l","status":"contextual_provisional","interpretation_note":"原詞 generic甥；不確定母系，不套舅甥模型。","paragraph_id":"c-jinshu-077-yinhao:p011","chapter_id":"c-jinshu-077-yinhao"},{"id":"c-jinshu-077-yinhao:p011:m0053","start":53,"end":55,"surface":"韓伯","kind":"person","person_id":"al7_2l9_13l","status":"contextual_provisional","interpretation_note":"依完整敘事／引語主語逐段辨識；原字不校改。","paragraph_id":"c-jinshu-077-yinhao:p011","chapter_id":"c-jinshu-077-yinhao"},{"id":"c-jinshu-077-yinhao:p011:m0060","start":60,"end":61,"surface":"之","kind":"person","person_id":"al7_2l9_13l","status":"contextual_provisional","interpretation_note":"依完整敘事／引語主語逐段辨識；原字不校改。","paragraph_id":"c-jinshu-077-yinhao:p011","chapter_id":"c-jinshu-077-yinhao"},{"id":"c-songshu-050-hufan:p002:m0012","start":12,"end":14,"surface":"韓伯","kind":"person","person_id":"al7_2l9_13l","status":"contextual_provisional","paragraph_id":"c-songshu-050-hufan:p002","chapter_id":"c-songshu-050-hufan"}],"relations":[],"title_holdings":[{"id":"th-songshu-050-hufan-2-10","title":"太守","kind":"office","mode":"attestation","person_id":"al7_2l9_13l","attestations":[{"id":"th-songshu-050-hufan-2-10:a","paragraph_id":"c-songshu-050-hufan:p002","start":10,"end":12,"surface":"太守","person_mention_id":"c-songshu-050-hufan:p002:m0012","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-050","chapter_id":"c-songshu-050-hufan","source_id":"s-songshu-050-hufan-ws2371899","paragraph_id":"c-songshu-050-hufan:p002","quote":"藩少孤，居喪以毀稱。太守韓伯見之，謂藩叔尚書少廣曰：「卿此姪當以義烈成名。」州府辟召，不就。須二弟冠婚畢，及參郗恢征虜軍事。時殷仲堪為荊州刺史，藩外兄羅企生為仲堪參軍，藩請假還，過江陵省企生。仲堪要藩相見，接待甚厚。藩因說仲堪曰：「桓玄意趣不常，每怏怏於失職。節下崇待太過，非將來之計也。」仲堪色不悅。藩退而謂企生曰：「倒戈授人，必至之禍。若不早規去就，後悔無及。」玄自夏口襲仲堪，藩參玄後軍軍事。仲堪敗，企生果以附從及禍。藩轉參太尉、大將軍、相國軍事。","person_mention_id":"c-songshu-050-hufan:p002:m0012"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-077-yinhao:p011","text":"浩雖被黜放，口無怨言，夷神委命，談詠不輟，雖家人不見其有流放之戚。但終日書空，作「咄咄怪事」四字而已。浩甥韓伯，浩素賞愛之，隨至徙所，經歲還都，浩送至渚側，詠曹顏遠詩云：「富貴他人合，貧賤親戚離。」因而泣下。後溫將以浩為尚書令，遺書告之，浩欣然許焉。將答書，慮有謬誤，開閉者數十，竟達空函，大忤溫意，由是遂絕。永和十二年卒。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-jinshu-077-yinhao:p011:m0000","start":0,"end":1,"surface":"浩","kind":"person","person_id":"djo_u3b_i9w_A","status":"contextual_provisional","interpretation_note":"依完整敘事／引語主語逐段辨識；原字不校改。"},{"id":"c-jinshu-077-yinhao:p011:m0026","start":26,"end":27,"surface":"其","kind":"person","person_id":"djo_u3b_i9w_A","status":"contextual_provisional","interpretation_note":"依完整敘事／引語主語逐段辨識；原字不校改。"},{"id":"c-jinshu-077-yinhao:p011:m0051","start":51,"end":52,"surface":"浩","kind":"person","person_id":"djo_u3b_i9w_A","status":"contextual_provisional","interpretation_note":"依完整敘事／引語主語逐段辨識；原字不校改。"},{"id":"c-jinshu-077-yinhao:p011:m0052","start":52,"end":53,"surface":"甥","kind":"person","person_id":"al7_2l9_13l","status":"contextual_provisional","interpretation_note":"原詞 generi