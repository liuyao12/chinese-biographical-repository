_count":0,"paragraph_occurrence_count":3,"table_occurrence_count":0,"passage_count":2,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"3處獨立位置，3個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"},{"source_id":"s-sanguozhi-053-xuezong","work_id":"w-sanguozhi","book_id":"b-sanguozhi-053","chapter_id":"c-sanguozhi-053-xuezong","raw_mention_count":1,"mention_ids":["c-sanguozhi-053-xuezong:line051:m0084"],"paragraph_ids":["c-sanguozhi-053-xuezong:line051"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-sanguozhi-053-xuezong:line051:m0084","mention_ids":["c-sanguozhi-053-xuezong:line051:m0084"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-shiji-096-zhang"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-053-xuezong:line051:m0084","start":84,"end":87,"surface":"漢元帝","kind":"person","person_id":"72m_dhb_tf7","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-053-xuezong:line051","chapter_id":"c-sanguozhi-053-xuezong"},{"id":"c-shiji-096-zhang:m027-0093","start":93,"end":96,"surface":"孝元帝","kind":"person","person_id":"72m_dhb_tf7","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p027","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m028-0103","start":103,"end":106,"surface":"孝元帝","kind":"person","person_id":"72m_dhb_tf7","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p028","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m028-0107","start":107,"end":109,"surface":"孝元","kind":"person","person_id":"72m_dhb_tf7","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p028","chapter_id":"c-shiji-096-zhang"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji096-070","person_id":"72m_dhb_tf7","scope":"same_chapter","chapter_ids":["c-shiji-096-zhang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["孝元","孝元帝"],"evidence":[{"paragraph_id":"c-shiji-096-zhang:p027","quote":"韋丞相玄成者，即前韋丞相子也。代父，後失列侯。其人少時好讀書，明於詩、論語。為吏至衛尉，徙為太子太傅。御史大夫薛君免，為御史大夫。于丞相乞骸骨免，而為丞相，因封故邑為扶陽侯。數年，病死。孝元帝親臨喪，賜賞甚厚。子嗣後。其治容容隨世俗浮沈，而見謂諂巧。而相工本謂之當為侯代父，而後失之；復自游宦而起，至丞相。父子俱為丞相，世閒美之，豈不命哉！相工其先知之。韋丞相卒，御史大夫匡衡代。"},{"paragraph_id":"c-shiji-096-zhang:p028","quote":"丞相匡衡者，東海人也。好讀書，從博士受詩。家貧，衡傭作以給食飲。才下，數射策不中，至九，乃中丙科。其經以不中科故明習。補平原文學卒史。數年，郡不尊敬。御史徵之，以補百石屬薦為郎，而補博士，拜為太子少傅，而事孝元帝。孝元好詩，而遷為光祿勳，居殿中為師，授教左右，而縣官坐其旁聽，甚善之，日以尊貴。御史大夫鄭弘坐事免，而匡君為御史大夫。歲餘，韋丞相死，匡君代為丞相，封樂安侯。以十年之閒，不出長安城門而至丞相，豈非遇時而命也哉！"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定短稱；韋賢與韋玄成分傳區別，第23段掾陳平另候選，第25段長安相工田文不與孟嘗君合併。趙堯、任敖、申屠嘉、鄧通、晁錯的短名依各段人物語境，王陵夫人與王陵分人。張蒼父長不滿五尺的長為身長敘述，不作父名。王侯與太子未詳名不補名，跨篇同指另待證據。"}],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-053-xuezong:line051","text":"夫帝王者，萬國之元首，天下之所繫命也。是以居則重門擊柝以戒不虞，行則清道案節以養威嚴，蓋所以存萬安之福，鎮四海之心。昔孔子疾時，托乘桴浮海之語，季由斯喜，拒以無所取才。漢元帝欲禦樓船，薛廣德請刎頸以血染車。何則？水火之險至危，非帝王所宜涉也。諺曰：『千金之子，坐不垂堂。』況萬乘之尊乎？今遼東戎貊小國，無城池之固，備御之術，器械銖鈍，犬羊無政，往必禽克，誠如明詔。然其方土寒埆，谷稼不殖，民習鞍馬，轉徙無常。卒聞大軍之至，自度不敵，鳥驚獸駭，長驅奔竄，一人匹馬，不可得見。雖獲空地，守之無益，此不可一也；加又洪流滉瀁，有成山之難，海行無常，風波難免，倏忽之間，人船異勢。雖有堯、舜之德，智無所施，賁、育之勇，力不得設，此不可二也；加以鬱霧冥其上，鹹水蒸其下，生流腫，轉相洿染，凡行海者，稀無斯患，此不可三也。天生神聖，顯以符瑞，當乘平喪亂，康此民物；嘉祥日集，海內垂定，逆虜凶虐，滅亡在近。中國一平，遼東自斃，但當拱手以待耳。今乃違必然之圖，尋至危之阻，忽九州之固，，肆一朝之忿，既非社稷之重計，又開闢以來所未嘗有，斯誠群僚所以傾身側息，食不甘味，寢不安席者也。惟陛下抑雷霆之威，忍赫斯之怒，遵乘橋之安，遠履冰之險，則臣子賴祉，天下幸甚。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-053-xuezong:line051:m0059","start":59,"end":61,"surface":"孔子","kind":"person","person_id":"fp6_ia6_7yw","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xuezong:line051:m0072","start":72,"end":74,"surface":"季由","kind":"person","person_id":"t7x_2x7_1fc","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xuezong:line051:m0084","start":84,"end":87,"surface":"漢元帝","kind":"person","person_id":"72m_dhb_tf7","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xuezong:line051:m0092","start":92,"end":95,"surface":"薛廣德","kind":"person","person_id":"620_9wu_92t","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xuezong:line051:m0287","start":287,"end":288,"surface":"堯","kind":"person","person_id":"oho_r3f_c6y","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xuezong:line051:m0289","start":289,"end":290,"surface":"舜","kind":"person","person_id":"ddb_l4j_4j2","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xuezong:line051:m0298","start":298,"end":299,"surface":"賁","kind":"person","person_id":"dwv_5hn_680","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xuezong:line051:m0300","start":300,"end":301,"surface":"育","kind":"person","person_id":"66l_m67_5ie","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"}],"annotation_status":"reviewed","source_position":{"first_line":51,"last_line":51,"revision_id":2086397,"raw_start":6433,"raw_end":6962,"characte