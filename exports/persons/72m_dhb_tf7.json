uplicate_mention_count":0,"paragraph_occurrence_count":3,"table_occurrence_count":0,"passage_count":2,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"3處獨立位置，3個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"},{"source_id":"s-jinshu-040-ws2606035-jiachong-family","work_id":"w-jinshu","book_id":"b-jinshu-040","chapter_id":"c-jinshu-040-jiachong-family","raw_mention_count":1,"mention_ids":["c-jinshu-040-jiachong-family:p006:m0032"],"paragraph_ids":["c-jinshu-040-jiachong-family:p006"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-040-jiachong-family:p006:m0032","mention_ids":["c-jinshu-040-jiachong-family:p006:m0032"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-shiji-096-zhang"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-040-jiachong-family:p006:m0032","kind":"person","person_id":"72m_dhb_tf7","surface":"元","start":32,"end":33,"status":"contextual_provisional","resolution_note":"依本傳完整敘事與本段角色辨識；逐人理由另存身份閱讀記錄。","paragraph_id":"c-jinshu-040-jiachong-family:p006","chapter_id":"c-jinshu-040-jiachong-family"},{"id":"c-shiji-096-zhang:m027-0093","start":93,"end":96,"surface":"孝元帝","kind":"person","person_id":"72m_dhb_tf7","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p027","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m028-0103","start":103,"end":106,"surface":"孝元帝","kind":"person","person_id":"72m_dhb_tf7","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p028","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m028-0107","start":107,"end":109,"surface":"孝元","kind":"person","person_id":"72m_dhb_tf7","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p028","chapter_id":"c-shiji-096-zhang"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji096-070","person_id":"72m_dhb_tf7","scope":"same_chapter","chapter_ids":["c-shiji-096-zhang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["孝元","孝元帝"],"evidence":[{"paragraph_id":"c-shiji-096-zhang:p027","quote":"韋丞相玄成者，即前韋丞相子也。代父，後失列侯。其人少時好讀書，明於詩、論語。為吏至衛尉，徙為太子太傅。御史大夫薛君免，為御史大夫。于丞相乞骸骨免，而為丞相，因封故邑為扶陽侯。數年，病死。孝元帝親臨喪，賜賞甚厚。子嗣後。其治容容隨世俗浮沈，而見謂諂巧。而相工本謂之當為侯代父，而後失之；復自游宦而起，至丞相。父子俱為丞相，世閒美之，豈不命哉！相工其先知之。韋丞相卒，御史大夫匡衡代。"},{"paragraph_id":"c-shiji-096-zhang:p028","quote":"丞相匡衡者，東海人也。好讀書，從博士受詩。家貧，衡傭作以給食飲。才下，數射策不中，至九，乃中丙科。其經以不中科故明習。補平原文學卒史。數年，郡不尊敬。御史徵之，以補百石屬薦為郎，而補博士，拜為太子少傅，而事孝元帝。孝元好詩，而遷為光祿勳，居殿中為師，授教左右，而縣官坐其旁聽，甚善之，日以尊貴。御史大夫鄭弘坐事免，而匡君為御史大夫。歲餘，韋丞相死，匡君代為丞相，封樂安侯。以十年之閒，不出長安城門而至丞相，豈非遇時而命也哉！"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定短稱；韋賢與韋玄成分傳區別，第23段掾陳平另候選，第25段長安相工田文不與孟嘗君合併。趙堯、任敖、申屠嘉、鄧通、晁錯的短名依各段人物語境，王陵夫人與王陵分人。張蒼父長不滿五尺的長為身長敘述，不作父名。王侯與太子未詳名不補名，跨篇同指另待證據。"}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-040-jiachong-family:p006","text":"充所定新律既班於天下，百姓便之。詔曰：「漢氏以來，法令嚴峻。故自元成之世，及建安、嘉平之間，咸欲辯章舊典，刪革刑書。述作體大，歷年無成。先帝湣元元之命陷於密網，親發德音，厘正名實。車騎將軍賈充，獎明聖意，諮詢善道。太傅鄭沖，又與司空荀顗、中書監荀勖、中軍將軍羊祜、中護軍王業，及廷尉杜友、守河南尹杜預、散騎侍郎裴楷、潁川太守周雄、齊相郭頎、騎都尉成公綏荀煇、尚書郎柳軌等，典正其事。朕每鑒其用心，常慨然嘉之。今法律既成，始班天下，刑寬禁簡，足以克當先旨。昔蕭何以定律受封，叔孫通以制儀爲奉常，賜金五百斤，弟子皆爲郎。夫立功立事，古之所重。自太傅、車騎以下，皆加祿賞。其詳依故典。」於是賜充子弟一人關內侯，絹五百匹。固讓，不許。","text_layer":"received_chapter","mentions":[{"id":"c-jinshu-040-jiachong-family:p006:m0000","kind":"person","person_id":"c27_590_7e3","surface":"充","start":0,"end":1,"status":"contextual_provisional","resolution_note":"依本傳完整敘事與本段角色辨識；逐人理由另存身份閱讀記錄。"},{"id":"c-jinshu-040-jiachong-family:p006:m0032","kind":"person","person_id":"72m_dhb_tf7","surface":"元","start":32,"end":33,"status":"contextual_provisional","resolution_note":"依本傳完整敘事與本段角色辨識；逐人理由另存身份閱讀記錄。"},{"id":"c-jinshu-040-jiachong-family:p006:m0033","kind":"person","person_id":"i8i_elt_kg7","surface":"成","start":33,"end":34,"status":"contextual_provisional","resolution_note":"依本傳完整敘事與本段角色辨識；逐人理由另存身份閱讀記錄。"},{"id":"c-jinshu-040-jiachong-family:p006:m0068","kind":"person","person_id":"dkn_ge4_286_AAAAI","surface":"先帝","start":68,"end":70,"status":"contextual_provisional","resolution_note":"依本傳完整敘事與本段角色辨識；逐人理由另存身份閱讀記錄。"},{"id":"c-jinshu-040-jiachong-family:p006:m0090","kind":"person","person_id":"c27_590_7e3","surface":"車騎","start":90,"end":92,"status":"contextual_provisional","resolution_note":"依本傳完整敘事與本段角色辨識；逐人理由另存身份閱讀記錄。"},{"id":"c-jinshu-040-jiachong-family:p006:m0094","kind":"person","person_id":"c27_590_7e3","surface":"賈充","start":94,"end":96,"status":"contextual_provisional","resolution_note":"依本傳完整敘事與本段角色辨識；逐人理由另存身份閱讀記錄。"},{"id":"c-jinshu-040-jiachong-family:p006:m0107","kind":"person","person_id":"wxk_zk0_zoi","surface":"太傅","start":107,"end":109,"status":"contextual_provisional","resolution_note":"依本傳完整敘事與本段角色辨識；逐人理由另存身份閱讀記錄。"},{"id":"c-jinshu-040-jiachong-family:p006:m0109","kind":"person","person_id":"wxk_zk0_zoi","surface":"鄭沖","start":109,"end":111,"status":"contextual_provisional","resolution_note":"依本傳完整敘事與本段角色辨識；逐人理由另存身份閱讀記錄。"},{"id":"c-jinshu-040-jiachong-family:p006:m0116","kind":"person","person_id":"yoo_ox0_545_BAA","surface":"荀顗","start":116,"end":118,"status":"contextual_provisional","resolution_note