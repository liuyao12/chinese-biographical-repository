838,6839,6840,6841,6842,6843,6844,6845,6846,6847,6848,6849,6850,6851,6852,6853,6854,6855,6856,6857,6858,6859,6860,6861,6862,6863,6864,6865,6866,6867,6868,6869,6870,6871,6872,6873,6874,6875,6876,6877,6878,6879,6880,6881,6882,6883,6884,6885,6886,6887,6888,6889,6890,6891,6892,6893,6894,6895,6896,6897,6898,6899,6900,6901,6902,6903,6904,6905,6906,6907,6908,6909,6910,6911,6912,6913,6914,6915,6916,6917,6918,6919,6920,6921,6922,6923,6924,6925,6926,6927,6928,6929,6930,6931,6932,6933,6934,6935,6936,6937,6938,6939,6940,6941,6942,6943,6944,6945,6946,6947,6948,6949,6950,6951,6952,6953,6954,6955,6956,6957,6958,6959]},"chapter_id":"c-sanguozhi-053-xuezong","book_id":"b-sanguozhi-053","work_id":"w-sanguozhi","source_id":"s-sanguozhi-053-xuezong"},{"id":"c-shiji-096-zhang:p027","text":"韋丞相玄成者，即前韋丞相子也。代父，後失列侯。其人少時好讀書，明於詩、論語。為吏至衛尉，徙為太子太傅。御史大夫薛君免，為御史大夫。于丞相乞骸骨免，而為丞相，因封故邑為扶陽侯。數年，病死。孝元帝親臨喪，賜賞甚厚。子嗣後。其治容容隨世俗浮沈，而見謂諂巧。而相工本謂之當為侯代父，而後失之；復自游宦而起，至丞相。父子俱為丞相，世閒美之，豈不命哉！相工其先知之。韋丞相卒，御史大夫匡衡代。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhang:m027-0000","start":0,"end":5,"surface":"韋丞相玄成","kind":"person","person_id":"vna_am7_jn5_A","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m027-0055","start":55,"end":57,"surface":"薛君","kind":"person","person_id":"ik4_61m_hqn","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m027-0065","start":65,"end":68,"surface":"于丞相","kind":"person","person_id":"tks_56f_4ir","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m027-0093","start":93,"end":96,"surface":"孝元帝","kind":"person","person_id":"72m_dhb_tf7","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m027-0177","start":177,"end":180,"surface":"韋丞相","kind":"person","person_id":"vna_am7_jn5_A","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m027-0186","start":186,"end":188,"surface":"匡衡","kind":"person","person_id":"484_day_gmv","status":"contextual_provisional"}],"chapter_id":"c-shiji-096-zhang","book_id":"b-shiji-096","work_id":"w-shiji","source_id":"s-shiji-096-zhang"},{"id":"c-shiji-096-zhang:p028","text":"丞相匡衡者，東海人也。好讀書，從博士受詩。家貧，衡傭作以給食飲。才下，數射策不中，至九，乃中丙科。其經以不中科故明習。補平原文學卒史。數年，郡不尊敬。御史徵之，以補百石屬薦為郎，而補博士，拜為太子少傅，而事孝元帝。孝元好詩，而遷為光祿勳，居殿中為師，授教左右，而縣官坐其旁聽，甚善之，日以尊貴。御史大夫鄭弘坐事免，而匡君為御史大夫。歲餘，韋丞相死，匡君代為丞相，封樂安侯。以十年之閒，不出長安城門而至丞相，豈非遇時而命也哉！","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhang:m028-0002","start":2,"end":4,"surface":"匡衡","kind":"person","person_id":"484_day_gmv","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m028-0024","start":24,"end":25,"surface":"衡","kind":"person","person_id":"484_day_gmv","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m028-0103","start":103,"end":106,"surface":"孝元帝","kind":"person","person_id":"72m_dhb_tf7","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m028-0107","start":107,"end":109,"surface":"孝元","kind":"person","person_id":"72m_dhb_tf7","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m028-0151","start":151,"end":153,"surface":"鄭弘","kind":"person","person_id":"33z_av8_anq","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m028-0158","start":158,"end":160,"surface":"匡君","kind":"person","person_id":"484_day_gmv","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m028-0169","start":169,"end":172,"surface":"韋丞相","kind":"person","person_id":"vna_am7_jn5_A","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m028-0174","start":174,"end":176,"surface":"匡君","kind":"person","person_id":"484_day_gmv","status":"contextual_provisional"}],"chapter_id":"c-shiji-096-zhang","book_id":"b-shiji-096","work_id":"w-shiji","source_id":"s-shiji-096-zhang"}],"sources":[{"chapter_id":"c-sanguozhi-053-xuezong","work_id":"w-sanguozhi","book_id":"b-sanguozhi-053","source_id":"s-sanguozhi-053-xuezong","source":{"title":"三國志卷五十三·吳書八","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?oldid=2086397","permalink":"h