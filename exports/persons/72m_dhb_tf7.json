ate_mention_count":0,"paragraph_occurrence_count":3,"table_occurrence_count":0,"passage_count":2,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"3處獨立位置，3個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"},{"source_id":"s-jinshu-040-wyd1739-jiachong","work_id":"w-jinshu","book_id":"b-jinshu-040","chapter_id":"c-jinshu-040-wyd1739-jiachong","raw_mention_count":1,"mention_ids":["c-jinshu-040-wyd1739-jiachong:p004:m0147"],"paragraph_ids":["c-jinshu-040-wyd1739-jiachong:p004"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-040-wyd1739-jiachong:p004:m0147","mention_ids":["c-jinshu-040-wyd1739-jiachong:p004:m0147"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-shiji-096-zhang"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-040-wyd1739-jiachong:p004:m0147","start":147,"end":148,"surface":"元","kind":"person","person_id":"72m_dhb_tf7","status":"contextual_provisional","resolution_note":"原文明示人物縮稱/受封個體，範圍限定本句；不從全域同字猜同人。","paragraph_id":"c-jinshu-040-wyd1739-jiachong:p004","chapter_id":"c-jinshu-040-wyd1739-jiachong"},{"id":"c-shiji-096-zhang:m027-0093","start":93,"end":96,"surface":"孝元帝","kind":"person","person_id":"72m_dhb_tf7","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p027","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m028-0103","start":103,"end":106,"surface":"孝元帝","kind":"person","person_id":"72m_dhb_tf7","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p028","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m028-0107","start":107,"end":109,"surface":"孝元","kind":"person","person_id":"72m_dhb_tf7","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p028","chapter_id":"c-shiji-096-zhang"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji096-070","person_id":"72m_dhb_tf7","scope":"same_chapter","chapter_ids":["c-shiji-096-zhang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["孝元","孝元帝"],"evidence":[{"paragraph_id":"c-shiji-096-zhang:p027","quote":"韋丞相玄成者，即前韋丞相子也。代父，後失列侯。其人少時好讀書，明於詩、論語。為吏至衛尉，徙為太子太傅。御史大夫薛君免，為御史大夫。于丞相乞骸骨免，而為丞相，因封故邑為扶陽侯。數年，病死。孝元帝親臨喪，賜賞甚厚。子嗣後。其治容容隨世俗浮沈，而見謂諂巧。而相工本謂之當為侯代父，而後失之；復自游宦而起，至丞相。父子俱為丞相，世閒美之，豈不命哉！相工其先知之。韋丞相卒，御史大夫匡衡代。"},{"paragraph_id":"c-shiji-096-zhang:p028","quote":"丞相匡衡者，東海人也。好讀書，從博士受詩。家貧，衡傭作以給食飲。才下，數射策不中，至九，乃中丙科。其經以不中科故明習。補平原文學卒史。數年，郡不尊敬。御史徵之，以補百石屬薦為郎，而補博士，拜為太子少傅，而事孝元帝。孝元好詩，而遷為光祿勳，居殿中為師，授教左右，而縣官坐其旁聽，甚善之，日以尊貴。御史大夫鄭弘坐事免，而匡君為御史大夫。歲餘，韋丞相死，匡君代為丞相，封樂安侯。以十年之閒，不出長安城門而至丞相，豈非遇時而命也哉！"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定短稱；韋賢與韋玄成分傳區別，第23段掾陳平另候選，第25段長安相工田文不與孟嘗君合併。趙堯、任敖、申屠嘉、鄧通、晁錯的短名依各段人物語境，王陵夫人與王陵分人。張蒼父長不滿五尺的長為身長敘述，不作父名。王侯與太子未詳名不補名，跨篇同指另待證據。"}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-040-wyd1739-jiachong:p004","text":"觀察上旨初文帝以景帝恢贊王業方傳位於舞陽侯攸充稱武帝寛仁且又居長有人君之德宜奉社稷及文帝寢疾武帝請問後事文帝曰知汝者賈公閭也帝襲王位拜充晉國衞將軍儀同三司給事中改封臨潁侯及受禪充以建明大命轉車騎將軍散騎常侍尚書僕射更封魯郡公母柳氏為魯國太夫人充所定新律既班于天下百姓便之詔曰漢氏以來法令嚴峻故自元成之世及建安嘉平之間咸欲辨章舊典刪革刑書述作體大歷年無成先帝愍元元之命陷於密網親發德音釐正名實車騎將軍賈充奬明聖意諮詢善道太","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-040-wyd1739-jiachong:p004:m0005","start":5,"end":7,"surface":"文帝","kind":"person","person_id":"dkn_ge4_286_AAAAI","status":"contextual_provisional"},{"id":"c-jinshu-040-wyd1739-jiachong:p004:m0008","start":8,"end":10,"surface":"景帝","kind":"person","person_id":"dkn_ge4_286_AAAAH","status":"contextual_provisional"},{"id":"c-jinshu-040-wyd1739-jiachong:p004:m0018","start":18,"end":22,"surface":"舞陽侯攸","kind":"person","person_id":"cac_ca2_008","status":"contextual_provisional"},{"id":"c-jinshu-040-wyd1739-jiachong:p004:m0022","start":22,"end":23,"surface":"充","kind":"person","person_id":"jmv_vc4_gep_*AA","status":"contextual_provisional"},{"id":"c-jinshu-040-wyd1739-jiachong:p004:m0024","start":24,"end":26,"surface":"武帝","kind":"person","person_id":"hgm_jvn_hle","status":"contextual_provisional"},{"id":"c-jinshu-040-wyd1739-jiachong:p004:m0042","start":42,"end":44,"surface":"文帝","kind":"person","person_id":"dkn_ge4_286_AAAAI","status":"contextual_provisional"},{"id":"c-jinshu-040-wyd1739-jiachong:p004:m0046","start":46,"end":48,"surface":"武帝","kind":"person","person_id":"hgm_jvn_hle","status":"contextual_provisional"},{"id":"c-jinshu-040-wyd1739-jiachong:p004:m0052","start":52,"end":54,"surface":"文帝","kind":"person","person_id":"dkn_ge4_286_AAAAI","status":"contextual_provisional"},{"id":"c-jinshu-040-wyd1739-jiachong:p004:m0058","start":58,"end":61,"surface":"賈公閭","kind":"person","person_id":"jmv_vc4_gep_*AA","status":"contextual_provisional"},{"id":"c-jinshu-040-wyd1739-jiachong:p004:m0062","start":62,"end":63,"surface":"帝","kind":"person","person_id":"hgm_jvn_hle","status":"contextual_provisional"},{"id":"c-jinshu-040-wyd1739-jiachong:p004:m0067","start":67,"end":68,"surface":"充","kind":"person","person_id":"jmv_vc4_gep_*AA","status":"contextual_provisional"},{"id":"c-jinshu-040-wyd1739-jiachong:p004:m0088","start":88,"end":89,"surface":"充","kind":"person","person_id":"jmv_vc4_gep