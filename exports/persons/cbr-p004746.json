":[{"id":"c-shiji-084-qujia:m007-0001","start":1,"end":4,"surface":"秦昭王","kind":"person","person_id":"cbr-p004758","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m007-0010","start":10,"end":12,"surface":"懷王","kind":"person","person_id":"cbr-p004746","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m007-0014","start":14,"end":16,"surface":"懷王","kind":"person","person_id":"cbr-p004746","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m007-0019","start":19,"end":21,"surface":"屈平","kind":"person","person_id":"cbr-p004745","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m007-0040","start":40,"end":42,"surface":"懷王","kind":"person","person_id":"cbr-p004746","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m007-0044","start":44,"end":46,"surface":"子蘭","kind":"person","person_id":"cbr-p004759","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m007-0058","start":58,"end":60,"surface":"懷王","kind":"person","person_id":"cbr-p004746","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m007-0076","start":76,"end":78,"surface":"懷王","kind":"person","person_id":"cbr-p004746","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m007-0084","start":84,"end":86,"surface":"懷王","kind":"person","person_id":"cbr-p004746","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"},{"id":"c-shiji-084-qujia:p008","text":"長子頃襄王立，以其弟子蘭為令尹。楚人既咎子蘭以勸懷王入秦而不反也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m008-0002","start":2,"end":5,"surface":"頃襄王","kind":"person","person_id":"cbr-p004760","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m008-0010","start":10,"end":12,"surface":"子蘭","kind":"person","person_id":"cbr-p004759","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m008-0016","start":16,"end":18,"surface":"楚人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或泛稱保持未解，不補姓名。"},{"id":"c-shiji-084-qujia:m008-0020","start":20,"end":22,"surface":"子蘭","kind":"person","person_id":"cbr-p004759","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m008-0024","start":24,"end":26,"surface":"懷王","kind":"person","person_id":"cbr-p004746","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"},{"id":"c-shiji-084-qujia:p009","text":"屈平既嫉之，雖放流，睠顧楚國，系心懷王，不忘欲反，冀幸君之一悟，俗之一改也。其存君興國而欲反覆之，一篇之中三致志焉。然終無可奈何，故不可以反，卒以此見懷王之終不悟也。人君無愚智賢不肖，莫不欲求忠以自為，舉賢以自佐，然亡國破家相隨屬，而聖君治國累世而不見者，其所謂忠者不忠，而所謂賢者不賢也。懷王以不知忠臣之分，故內惑於鄭袖，外欺於張儀，疏屈平而信上官大夫、令尹子蘭。兵挫地削，亡其六郡，身客死於秦，為天下笑。此不知人之禍也。《易》曰：「井泄不食，為我心惻，可以汲。王明，并受其福。」王之不明，豈足福哉？","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m009-0000","start":0,"end":2,"surface":"屈平","kind":"person","person_id":"cbr-p004745","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m009-0017","start":17,"end":19,"surface":"懷王","kind":"person","person_id":"cbr-p004746","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m009-0075","start":75,"end":77,"surface":"懷王","kind":"person","person_id":"cbr-p004746","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m009-0083","start":83,"end":85,"surface":"人君","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或泛稱保持未解，不補姓名。"},{"id":"c-shiji-084-qujia:m009-0117","start":117,"end":119,"surface":"聖君","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或泛稱保持未解，不補姓名。"},{"id":"c-shiji-084-qujia:m009-0145","start":145,"end":147,"surface":"懷王","kind":"person","person_id":"cbr-p004746","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m009-0150","start":150,"end":152,"surface":"忠臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或泛稱保持未解，不補姓名。"},{"id":"c-shiji-084-qujia:m009-0159","start":159,"end":161,"surface":"鄭袖","kind":"person","person_id":"cbr-p004756","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m009-0165","start":165,"end":167,"surface":"張儀","kind":"person","person_id":"cbr-p004753","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m009-0169","start":169,"end":171,"surface":"屈平","kind":"person","person_id":"cbr-p004745","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m009-0173","start":173,"end":177,"surface":"上官大夫","kind":"person","person_id":"cbr-p004747","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m009-0178","start":178,"end":182,"surface":"令尹子蘭","kind":"person","person_id":"cbr-p004759","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"}],"sources":[{"chapter_id":"c-shiji-084-qujia","work_id":"w-shiji","book_id":"b-shiji-084","source_id":"s-shiji-084-qujia","source":{"title":"史記／卷084","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷084","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷084&oldid=1568305","revision_id":1568305,"accessed_on":"2026-10-09","extent":"33段正文，屈原、懷沙、賈生及篇末評論；索隱述贊另層待收。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{"铦":"銛","鸮":"鴞"},"editorial_readings":[{"paragraph_id":"c-shiji-084-qujia:p017","witness_form":"（投）［沈］","body_reading":"投","note":"數位增刪改讀提示另存，正文保留增改前形式，未核影像，不當已校定。"},{"paragraph_id":"c-shiji-084-qujia:p025","witness_form":"（微）［徵］","body_reading":"微","note":"數位增刪改讀提示另存，正文保留增改前形式，未核影像，不當已校定。"}],"extraction_note":"固定HTML與取得時版本一致；兩項改讀前形投、微保留。正文去腳註標記[1]，註文另存。括號曰保留，簡體字形轉換明記。 第13至16段懷沙、第24至25段弔屈原賦及第27至29段服鳥賦按傳世正文次序保留，詩賦引古不視為敘事當時人物；第32段孝昭附述傳承仍待覆核。","note":"全33段正文與HTML篇界已核讀，明示姓名首輪已存；未核底本影像與現代研究。","digital_footnotes":[{"block_index":8,"anchor":"cite_ref-1","note_id":"cite_note-1","source_text":"纳","traditional_display":"納","character_conversion":{"纳":"納"},"n