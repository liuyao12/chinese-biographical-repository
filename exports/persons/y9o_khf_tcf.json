ject_person_mention_id":"c-nanqishu-043-jiangxiao-complete:p002:m0164"}],"status":"source_attested","interpretation_note":"原文下一詞「被遣」，屬舊婚。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"a-qi043-chuxiuzhi-daughter","subject_person_id":"y9o_khf_tcf","object_person_id":"xke_dj3_6ba_AAAAA","predicate":"father","qualifiers":{"source_term":"褚秀之女","lineage":"paternal"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-043","chapter_id":"c-nanqishu-043-jiangxiao-complete","source_id":"s-nanqishu-043-jiangxiao-complete-ws2400356","paragraph_id":"c-nanqishu-043-jiangxiao-complete:p002","quote":"　　少有美譽。桂陽王休範臨州，辟迎主簿，不就。尚孝武女臨汝公主，拜駙馬都尉。除著作郎，太子舍人，丹陽丞。時袁粲爲尹，見斆歎曰：「風流不墜，政在江郎。」數與晏賞，留連日夜。遷安成王撫軍記室，祕書丞，中書郎。斆庶祖母王氏老疾，斆視膳嘗藥，七十餘日不解衣。及累居內官，每以侍養陳請，朝廷優其朝直。尋轉安成王驃騎從事中郎。初，湛娶褚秀之女，被遣，褚淵爲衞軍，重斆爲人，先通音意，引爲長史。加寧朔將軍。從帝立，隨府轉司空長史，領臨淮太守，將軍如故。轉太尉從事中郎。齊臺建，爲吏部郎。太祖卽位，斆以祖母久疾連年，臺閣之職，永廢溫凊，啓乞自解。","subject_person_mention_id":"c-nanqishu-043-jiangxiao-complete:p002:m0164","object_person_mention_id":"c-nanqishu-043-jiangxiao-complete:p002:m0161"}],"status":"source_attested","interpretation_note":"此女後被遣，無自名。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-043-jiangxiao-complete:p002:m0164","start":164,"end":165,"surface":"女","kind":"person","person_id":"y9o_khf_tcf","status":"contextual_provisional","paragraph_id":"c-nanqishu-043-jiangxiao-complete:p002","chapter_id":"c-nanqishu-043-jiangxiao-complete"}],"relations":[{"id":"a-qi043-jiangzhan-marriage","subject_person_id":"o1i_tao_gu1","object_person_id":"y9o_khf_tcf","predicate":"spouse","qualifiers":{"source_term":"湛娶褚秀之女"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-043","chapter_id":"c-nanqishu-043-jiangxiao-complete","source_id":"s-nanqishu-043-jiangxiao-complete-ws2400356","paragraph_id":"c-nanqishu-043