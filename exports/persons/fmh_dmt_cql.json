brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0219","start":219,"end":220,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0221","start":221,"end":222,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0246","start":246,"end":247,"surface":"上","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0248","start":248,"end":249,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0257","start":257,"end":258,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0259","start":259,"end":260,"surface":"上","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"}],"chapter_id":"c-shiji-112-pingjin","book_id":"b-shiji-112","work_id":"w-shiji","source_id":"s-shiji112-pingjin"},{"id":"c-shiji-112-pingjin:p006","text":"汲黯曰：「弘位在三公，奉祿甚多。然為布被，此詐也。」上問弘。弘謝曰：「有之。夫九卿與臣善者無過黯，然今日庭詰弘，誠中弘之病。夫以三公為布被，誠飾詐欲以釣名。且臣聞管仲相齊，有三歸，侈擬於君，桓公以霸，亦上僭於君。晏嬰相景公，食不重肉，妾不衣絲，齊國亦治，此下比於民。今臣弘位為御史大夫，而為布被，自九卿以下至於小吏，無差，誠如汲黯言。且無汲黯忠，陛下安得聞此言。」天子以為謙讓，愈益厚之。卒以弘為丞相，封平津侯。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-112-pingjin:m006-0000","start":0,"end":2,"surface":"汲黯","kind":"person","person_id":"fmh_dmt_cql","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m006-0005","start":5,"end":6,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m006-0026","start":26,"end":27,"surface":"上","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m006-0028","start":28,"end":29,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-1