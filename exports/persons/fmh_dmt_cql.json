006-0047","start":47,"end":48,"surface":"黯","kind":"person","person_id":"fmh_dmt_cql","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p006","chapter_id":"c-shiji-112-pingjin"},{"id":"c-shiji-112-pingjin:m006-0163","start":163,"end":165,"surface":"汲黯","kind":"person","person_id":"fmh_dmt_cql","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p006","chapter_id":"c-shiji-112-pingjin"},{"id":"c-shiji-112-pingjin:m006-0169","start":169,"end":171,"surface":"汲黯","kind":"person","person_id":"fmh_dmt_cql","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p006","chapter_id":"c-shiji-112-pingjin"},{"id":"c-shiji-112-pingjin:m029-0325","start":325,"end":327,"surface":"汲黯","kind":"person","person_id":"fmh_dmt_cql","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p029","chapter_id":"c-shiji-112-pingjin"},{"id":"c-shiji-112-pingjin:m030-0188","start":188,"end":190,"surface":"汲黯","kind":"person","person_id":"fmh_dmt_cql","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p030","chapter_id":"c-shiji-112-pingjin"}],"relations":[],"title_holdings":[{"id":"th-shiji112-006","person_id":"fmh_dmt_cql","title":"主爵都尉","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-112-pingjin","source_id":"s-shiji112-pingjin","paragraph_id":"c-shiji-112-pingjin:p004","quote":"弘為人恢奇多聞，常稱以為人主病不廣大，人臣病不儉節。弘為布被，食不重肉。后母死，服喪三年。每朝會議，開陳其端，令人主自擇，不肯面折庭爭。於是天子察其行敦厚，辯論有餘，習文法吏事，而又緣飾以儒術，上大說之。二歲中，至左內史。弘奏事，有不可，不庭辯之。嘗與主爵都尉汲黯請閒，汲黯先發之，弘推其後，天子常說，所言皆聽，以此日益親貴。嘗與公卿約議，至上前，皆倍其約以順上旨。汲黯庭詰弘曰：「齊人多詐而無情實，始與臣等建此議，今皆倍之，不忠。」上問弘。弘謝曰：「夫知臣者以臣為忠，不知臣者以臣為不忠。」上然弘言。左右幸臣每毀弘，上益厚遇之。"}],"attestations":[{"id":"th-shiji112-006:a001","paragraph_id":"c-shiji-112-pingjin:p004","start":126,"end":130,"surface":"主爵都尉","person_mention_id":"c-shiji-112-pingjin:m004-0130","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"原文稱號與事件分存，未知端點不補造；死亡不自動終止官爵。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-112-pingjin:p004","text":"弘為人恢奇多聞，常稱以為人主病不廣大，人臣病不儉節。弘為布被，食不重肉。后母死，服喪三年。每朝會議，開陳其端，令人主自擇，不肯面折庭爭。於是天子察其行敦厚，辯論有餘，習文法吏事，而又緣飾以儒術，上大說之。二歲中，至左內史。弘奏事，有不可，不庭辯之。嘗與主爵都尉汲黯請閒，汲黯先發之，弘推其後，天子常說，所言皆聽，以此日益親貴。嘗與公卿約議，至上前，皆倍其約以順上旨。汲黯庭詰弘曰：「齊人多詐而無情實，始與臣等建此議，今皆倍之，不忠。」上問弘。弘謝曰：「夫知臣者以臣為忠，不知臣者以臣為不忠。」上然弘言。左右幸臣每毀弘，上益厚遇之。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-112-pingjin:m004-0000","start":0,"end":1,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0026","start":26,"end":27,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0036","start":36,"end":38,"surface":"后母","kind":"person","person_id":"fyw_e6a_8dl","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0070","start":70,"end":72,"surface":"天子","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0097","start":97,"end":98,"surface":"上","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0111","start":111,"end":112,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0130","start":130,"end":132,"surface":"汲黯","kind":"person","person_id":"fmh_dmt_cql","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0135","start":135,"end":137,"surface":"汲黯","kind":"person","person_id":"fmh_dmt_cql","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0141","start":141,"end":142,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0146","start":146,"end":148,"surface":"天子","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0171","start":171,"end":172,"surface":"上","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0180","start":180,"end":181,"surface":"上","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0183","start":183,"end":185,"surface":"汲黯","kind":"person","person_id":"fmh_dmt_cql","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0187","start":187,"end":188,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0217","start":217,"end":218,"surface":"上","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0219","start":219,"end":220,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0221","start":221,"end":222,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0246","start":246,"end":247,"surface":"上","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0248","start":248,"end":249,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0257","start":257,"end":258,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m004-0259","start":259,"end":260,"surface":"上","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"}],"chapter_id":"c-shiji-112-pingjin","book_id":"b-shiji-112","work_id":"w-shiji","source_id":"s-shiji112-pingjin"},{"id":"c-shiji-112-pingjin:p006","text":"汲黯曰：「弘位在三公，奉祿甚多。然為布被，此詐也。」上問弘。弘謝曰：「有之。夫九卿與臣善者無過黯，然今日庭詰弘，誠中弘之病。夫以三公為布被，誠飾詐欲以釣名。且臣聞管仲相齊，有三歸，侈擬於君，桓公以霸，亦上僭於君。晏嬰相景公，食不重肉，妾不衣絲，齊國亦治，此下比於民。今臣弘位為御史大夫，而為布被，自九卿以下至於小吏，無差，誠如汲黯言。且無汲黯忠，陛下安得聞此言。」天子以為謙讓，愈益厚之。卒以弘為丞相，封平津侯。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-112-pingjin:m006-0000","start":0,"end":2,"surface":"汲黯","kind":"person","person_id":"fmh_dmt_cql","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m006-0005","start":5,"end":6,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m006-0026","start":26,"end":27,"surface":"上","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m006-0028","start":28,"end":29,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m006-0030","start":30,"end":31,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m006-0047","start":47,"end":48,"surface":"黯","kind":"person","person_id":"fmh_dmt_cql","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m006-0054","start":54,"end":55,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m006-0058","start":58,"end":59,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m006-0081","start":81,"end":83,"surface":"管仲","kind":"person","person_id":"zgg_ncu_lxg","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m006-0095","start":95,"end":97,"surface":"桓公","kind":"person","person_id":"6ua_ti1_4bc","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m006-0106","start":106,"end":108,"surface":"晏嬰","kind":"person","person_id":"811_det_o9f","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m006-0109","start":109,"end":111,"surface":"景公","kind":"person","person_id":"i8v_5et_i28","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m006-0135","start":135,"end":136,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m006-0163","start":163,"end":165,"surface":"汲黯","kind":"person","person_id":"fmh_dmt_cql","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m006-0169","start":169,"end":171,"surface":"汲黯","kind":"person","person_id":"fmh_dmt_cql","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m006-0182","start":182,"end":184,"surface":"天子","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m006-0196","start":196,"end":197,"surface":"弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"}],"chapter_id":"c-shiji-112-pingjin","book_id":"b-shiji-112","work_id":"w-shiji","source_id":"s-shiji112-pingjin"},{"id":"c-shiji-112-pingjin:p029","text":"太皇太后詔大司徒大司空：「蓋聞治國之道，富民為始；富民之要，在於節儉。《孝經》曰『安上治民，莫善於禮』。『禮，與奢也寧儉』。昔者管仲相齊桓，霸諸侯，有九合一匡之功，而仲尼謂之不知禮，以其奢泰侈擬於君故也。夏禹卑宮室，惡衣服，后聖不循。由此言之，治之盛也，德優矣，莫高於儉。儉化俗民，則尊卑之序得，而骨肉之恩親，爭訟之原息。斯乃家給人足，刑錯之本也歟？可不務哉！夫三公者，百寮之率，萬民之表也。未有樹直表而得曲影者也。孔子不云乎，『子率而正，孰敢不正』。『舉善而教不能則勸』。維漢興以來，股肱宰臣身行儉約，輕財重義，較然著明，未有若故丞相平津侯公孫弘者也。位在丞相而為布被，脫粟之飯，不過一肉。故人所善賓客皆分奉祿以給之，無有所餘。誠內自克約而外從制。汲黯詰之，乃聞于朝，此可謂減於制度而可施行者也。德優則行，否則止，與內奢泰而外為詭服以釣虛譽者殊科。以病乞骸骨，孝武皇帝即制曰『賞有功，褒有德，善善惡惡，君宜知之。其省思慮，存精神，輔以醫藥』。賜告治病，牛酒雜帛。居數月，有瘳，視事。至元狩二年，竟以善終于相位。夫知臣莫若君，此其效也。弘子度嗣爵，后為山陽太守，坐法失侯。夫表德章義，所以率俗厲化，聖王之制，不易之道也。其賜弘後子孫之次當為後者爵關內侯，食邑三百戶，徵詣公車，上名尚書，朕親臨拜焉。」","annotation_status":"in_progress","text_layer":"witness_appended_edict","mentions":[{"id":"c-shiji-112-pingjin:m029-0000","start":0,"end":4,"surface":"太皇太后","kind":"person","person_id":"38x_hpr_ltp","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m029-0005","start":5,"end":8,"surface":"大司徒","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-112-pingjin:m029-0008","start":8,"end":11,"surface":"大司空