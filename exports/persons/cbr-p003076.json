{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003076","identity_policy":"contextual_provisional","person_ids":["cbr-p003076"],"persons":[{"id":"cbr-p003076","label":"幽王（外戚世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"幽王","mention_ids":["c-shiji-049-waiqi:m001-0075"]}],"evidence":[{"mention_id":"c-shiji-049-waiqi:m001-0075","chapter_id":"c-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p001","quote":"幽王"}]}],"source_mention_summary":[{"source_id":"s-shiji-049-waiqi","work_id":"w-shiji","book_id":"b-shiji-049","chapter_id":"c-shiji-049-waiqi","mention_count":1,"mention_ids":["c-shiji-049-waiqi:m001-0075"],"paragraph_ids":["c-shiji-049-waiqi:p001"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-049-waiqi"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-049-waiqi:m001-0075","start":75,"end":77,"surface":"幽王","kind":"person","person_id":"cbr-p003076","status":"contextual_provisional","paragraph_id":"c-shiji-049-waiqi:p001","chapter_id":"c-shiji-049-waiqi"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji049-028","person_id":"cbr-p003076","surfaces":["幽王"],"scope":"same_chapter","chapter_ids":["c-shiji-049-waiqi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-049-waiqi:p001","quote":"自古受命帝王及繼體守文之君，非獨內德茂也，蓋亦有外戚之助焉。夏之興也以涂山，而桀之放也以末喜。殷之興也以有娀，紂之殺也嬖妲己。周之興也以姜原及大任，而幽王之禽也淫於褒姒。故易基乾坤，詩始關雎，書美釐降，春秋譏不親迎。夫婦之際，人道之大倫也。禮之用，唯婚姻為兢兢。夫樂調而四時和，陰陽之變，萬物之統也。可不慎與？人能弘道，無如命何。甚哉，妃匹之愛，君不能得之於臣，父不能得之於子，況卑下乎！既驩合矣，或不能成子姓；能成子姓矣，或不能要其終：豈非命也哉？孔子罕稱命，蓋難言之也。非通幽明之變，惡能識乎性命哉？"}],"rationale":"按明示名、字及各帝后局部親屬敘事暫接；王夫人分景帝皇后與武帝趙妃，代王分文帝與後來少子武。未名者不補姓名，褚氏附載另留原語。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-049-waiqi:p001","text":"自古受命帝王及繼體守文之君，非獨內德茂也，蓋亦有外戚之助焉。夏之興也以涂山，而桀之放也以末喜。殷之興也以有娀，紂之殺也嬖妲己。周之興也以姜原及大任，而幽王之禽也淫於褒姒。故易基乾坤，詩始關雎，書美釐降，春秋譏不親迎。夫婦之際，人道之大倫也。禮之用，唯婚姻為兢兢。夫樂調而四時和，陰陽之變，萬物之統也。可不慎與？人能弘道，無如命何。甚哉，妃匹之愛，君不能得之於臣，父不能得之於子，況卑下乎！既驩合矣，或不能成子姓；能成子姓矣，或不能要其終：豈非命也哉？孔子罕稱命，蓋難言之也。非通幽明之變，惡能識乎性命哉？","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-049-waiqi:m001-0035","start":35,"end":37,"surface":"涂山","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或待核稱謂；不由熟悉生平補姓名。"},{"id":"c-shiji-049-waiqi:m001-0039","start":39,"end":40,"surface":"桀","kind":"person","person_id":"cbr-p003070","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m001-0044","start":44,"end":46,"surface":"末喜","kind":"person","person_id":"cbr-p003071","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m001-0052","start":52,"end":54,"surface":"有娀","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或待核稱謂；不由熟悉生平補姓名。"},{"id":"c-shiji-049-waiqi:m001-0055","start":55,"end":56,"surface":"紂","kind":"person","person_id":"cbr-p003072","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m001-0060","start":60,"end":62,"surface":"妲己","kind":"person","person_id":"cbr-p003073","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m001-0068","start":68,"end":70,"surface":"姜原","kind":"person","person_id":"cbr-p003074","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m001-0071","start":71,"end":73,"surface":"大任","kind":"person","person_id":"cbr-p003075","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m001-0075","start":75,"end":77,"surface":"幽王","kind":"person","person_id":"cbr-p003076","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m001-0082","start":82,"end":84,"surface":"褒姒","kind":"person","person_id":"cbr-p003077","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m001-0225","start":225,"end":227,"surface":"孔子","kind":"person","person_id":"cbr-p003078","status":"co