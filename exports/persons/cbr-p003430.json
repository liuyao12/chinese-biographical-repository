{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003430","canonical_person_id":"xtl_sr1_di0","id_aliases":["cbr-p003430"],"identity_policy":"contextual_provisional","person_ids":["xtl_sr1_di0"],"persons":[{"id":"xtl_sr1_di0","label":"項悍（陳丞相世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"項悍","mention_ids":["c-shiji-056-chen:m005-0081"]}],"evidence":[{"mention_id":"c-shiji-056-chen:m005-0081","chapter_id":"c-shiji-056-chen","paragraph_id":"c-shiji-056-chen:p005","quote":"項悍"}],"id_aliases":["cbr-p003430"]}],"source_mention_summary":[{"source_id":"s-shiji-056-chen","work_id":"w-shiji","book_id":"b-shiji-056","chapter_id":"c-shiji-056-chen","mention_count":1,"mention_ids":["c-shiji-056-chen:m005-0081"],"paragraph_ids":["c-shiji-056-chen:p005"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-056-chen"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-056-chen:m005-0081","start":81,"end":83,"surface":"項悍","kind":"person","person_id":"xtl_sr1_di0","status":"contextual_provisional","paragraph_id":"c-shiji-056-chen:p005","chapter_id":"c-shiji-056-chen"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji056-013","person_id":"xtl_sr1_di0","surfaces":["項悍"],"scope":"same_chapter","chapter_ids":["c-shiji-056-chen"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-056-chen:p005","quote":"久之，項羽略地至河上，陳平往歸之，從入破秦，賜平爵卿。項羽之東王彭城也，漢王還定三秦而東，殷王反楚。項羽乃以平爲信武君，將魏王咎客在楚者以往，擊降殷王而還。項王使項悍拜平爲都尉，賜金二十溢。居無何，漢王攻下殷。項王怒，將誅定殷者將吏。陳平懼誅，乃封其金與印，使使歸項王，而平身間行杖劎亡。渡河，船人見其美丈夫獨行，疑其亡將，要中當有金玉寶器，目之，欲殺平。平恐，乃解衣躶而佐刺船。船人知其無有，乃止。"}],"rationale":"依本篇明示名字、局部主語、授官爵與家世暫接。平城與負郭不作短名，韓王信與淮陰侯韓信、審食其與酈食其分開。上依高帝與孝文帝敘事換主語，指控與古代比擬不當已驗史實；未名者不補全名，女孫父親不由婚議推定。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-056-chen:p005","text":"久之，項羽略地至河上，陳平往歸之，從入破秦，賜平爵卿。項羽之東王彭城也，漢王還定三秦而東，殷王反楚。項羽乃以平爲信武君，將魏王咎客在楚者以往，擊降殷王而還。項王使項悍拜平爲都尉，賜金二十溢。居無何，漢王攻下殷。項王怒，將誅定殷者將吏。陳平懼誅，乃封其金與印，使使歸項王，而平身間行杖劎亡。渡河，船人見其美丈夫獨行，疑其亡將，要中當有金玉寶器，目之，欲殺平。平恐，乃解衣躶而佐刺船。船人知其無有，乃止。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-056-chen:m005-0003","start":3,"end":5,"surface":"項羽","kind":"person","person_id":"7xt_xw9_q0r","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m005-0011","start":11,"end":13,"surface":"陳平","kind":"person","person_id":"04f_hzf_n06","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m005-0023","start":23,"end":24,"surface":"平","kind":"person","person_id":"04f_hzf_n06","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m005-0027","start":27,"end":29,"surface":"項羽","kind":"person","person_id":"7xt_xw9_q0r","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m005-0036","start":36,"end":38,"surface":"漢王","kind":"person","person_id":"gcp_v0l_0vh","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m005-0045","start":45,"end":47,"surface":"殷王","kind":"person","person_id":"mys_kcy_y9o","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m005-0050","start":50,"end":52,"surface":"項羽","kind":"person","person_id":"7xt_xw9_q0r","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m005-0054","start":54,"end":55,"surface":"平","kind":"person","person_id":"04f_hzf_n06","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m005-0061","start":61,"end":64,"surface":"魏王咎","kind":"person","person_id":"1jv_ziq_uxq","status":"contextual_provision