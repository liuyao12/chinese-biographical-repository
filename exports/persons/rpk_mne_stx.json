rpk_mne_stx","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m083-0074","start":74,"end":75,"surface":"何","kind":"person","person_id":"rpk_mne_stx","status":"contextual_provisional"}],"chapter_id":"c-shiji-067-disciples","book_id":"b-shiji-067","work_id":"w-shiji","source_id":"s-shiji-067-disciples"},{"id":"c-shiji-121-rulin:p019","text":"自魯商瞿受易孔子，孔子卒，商瞿傳易，六世至齊人田何，字子莊，而漢興。田何傳東武人王同子仲，子仲傳菑川人楊何。何以易，元光元年徵，官至中大夫。齊人即墨成以易至城陽相。廣川人孟但以易為太子門大夫。魯人周霸，莒人衡胡，臨菑人主父偃，皆以易至二千石。然要言易者本於楊何之家。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m019-0002","start":2,"end":4,"surface":"商瞿","kind":"person","person_id":"66i_9gx_pc4","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m019-0006","start":6,"end":8,"surface":"孔子","kind":"person","person_id":"fp6_ia6_7yw","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m019-0009","start":9,"end":11,"surface":"孔子","kind":"person","person_id":"fp6_ia6_7yw","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m019-0013","start":13,"end":15,"surface":"商瞿","kind":"person","person_id":"66i_9gx_pc4","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m019-0023","start":23,"end":25,"surface":"田何","kind":"person","person_id":"aly_3ph_2la","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m019-0027","start":27,"end":29,"surface":"子莊","kind":"person","person_id":"aly_3ph_2la","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m019-0034","start":34,"end":36,"surface":"田何","kind":"person","person_id":"aly_3ph_2la","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m019-0040","start":40,"end":42,"surface":"王同","kind":"person","person_id":"yuy_gbn_g7e","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m019-0042","start":42,"end":44,"surface":"子仲","kind":"person","person_id":"yuy_gbn_g7e","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m019-0045","start":45,"end":47,"surface":"子仲","kind":"person","person_id":"yuy_gbn_g7e","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m019-0051","start":51,"end":53,"surface":"楊何","kind":"person","person_id":"rpk_mne_stx","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m019-0054","start":54,"end":55,"surface":"何","kind":"person","person_id":"rpk_mne_stx","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m019-0072","start":72,"end":75,"surface":"即墨成","kind":"person","person_id":"ji8_x93_yhn","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m019-0085","start":85,"end":87,"surface":"孟但","kind":"person","person_id":"gyn_ff7_fsv","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m019-0098","start":98,"end":100,"surface":"周霸","kind":"person","person_id":"57o_eji_ods","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m019-0103","start":103,"end":105,"surface":"衡胡","kind":"person","person_id":"fze_new_7ft","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m019-0109","start":109,"end":112,"surface":"主父偃","kind":"person","person_id":"vbr_ff1_yc4","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m019-0128","start":128,"end":130,"surface":"楊何","kind":"person","person_id":"rpk_mne_stx","status":"contextual_provisional"}],"chapter_id":"c-shiji-121-rulin","book_id":"b-shiji-121","work_id":"w-shiji","source_id":"s-shiji121-rulin"},{"id":"c-shiji-130-taishigong:p003","text":"太史公學天官於唐都，受易於楊何，習道論於黃子。太史公仕於建元元封之閒，愍學者之不達其意而師悖，乃論六家之要指曰：\n《易大傳》：「天下一致而百慮，同歸而殊涂。」夫陰陽、儒、墨、名、法、道德，此務為治者也，直所從言之異路，有省不省耳。嘗竊觀陰陽之術，大祥而眾忌諱，使人拘而多所畏；然其序四時之大順，不可失也。儒者博而寡要，勞而少功，是以其事難盡從；然其序君臣父子之禮，列夫婦長幼之別，不可易也。墨者儉而難遵，是以其事不可遍循；然其彊本節用，不可廢也。法家嚴而少恩；然其正君臣上下之分，不可改矣。名家使人儉而善失真；然其正名實，不可不察也。道家使人精神專一，動合無形，贍足萬物。其為術也，因陰陽之大順，采儒墨之善，撮名法之要，與時遷移，應物變化，立俗施事，無所不宜，指約而易操，事少而功多。儒者則不然。以為人主天下之儀表也，主倡而臣和，主先而臣隨。如此則主勞而臣逸。至於大道之要，去健羨，絀聰明，釋此而任術。夫神大用則竭，形大勞則敝。形神騷動，欲與天地長久，非所聞也。\n夫陰陽四時、八位、十二度、二十四節各有教令，順之者昌，逆之者不死則亡，未必然也，故曰「使人拘而多畏」。夫春生夏長，秋收冬藏，此天道之大經也，弗順則無以為天下綱紀，故曰「四時之大順，不可失也」。\n夫儒者以六藝為法。六藝經傳以千萬數，累世不能通其學，當年不能究其禮，故曰「博而寡要，勞而少功」。若夫列君臣父子之禮，序夫婦長幼之別，雖百家弗能易也。\n墨者亦尚堯舜道，言其德行曰：「堂高三尺，土階三等，茅茨不翦，采椽不刮。食土簋，啜土刑，糲粱之食，藜霍之羹。夏日葛衣，冬日鹿裘。」其送死，桐棺三寸，舉音不盡其哀。教喪禮，必以此為萬民之率。使天下法若此，則尊卑無別也。夫世異時移，事業不必同，故曰「儉而難遵」。要曰彊本節用，則人給家足之道也。此墨子之所長，雖百長弗能廢也。\n法家不別親疏，不殊貴賤，一斷於法，則親親尊尊之恩絕矣。可以行一時之計，而不可長用也，故曰「嚴而少恩」。若尊主卑臣，明分職不得相踰越，雖百家弗能改也。\n名家苛察繳繞，使人不得反其意，專決於名而失人情，故曰「使人儉而善失真」。若夫控名責實，參伍不失，此不可不察也。\n道家無為，又曰無不為，其實易行，其辭難知。其術以虛無為本，以因循為用。無成埶，無常形，故能究萬物之情。不為物先，不為物後，故能為萬物主。有法無法，因時為業；有度無度，因物與合。故曰「聖人不朽，時變是守。虛者道之常也，因者君之綱」也。群臣并至，使各自明也。其實中其聲者謂之端，實不中其聲者謂之窾。窾言不聽，姦乃不生，賢不肖自分，白黑乃形。在所欲用耳，何事不成。乃合大道，混混冥冥。光燿天下，復反無名。凡人所生者神也，所讬者形也。神大用則竭，形大勞則敝，形神離則死。死者不可復生，離者不可復反，故聖人重之。由是觀之，神者生之本也，形者生之具也。不先定其神［形］，而曰「我有以治天下」，何由哉？","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m003-0000","start":0,"end":3,"surface":"太史公","kind":"person","person_id":"pme_eis_xqi_*A*AAAA","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m003-0007","start":7,"end":9,"surface":"唐都","kind":"person","person_id":"yt8_m1o_8bl","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m003-0013","start":13,"end":15,"surface":"楊何","kind":"person","person_id":"rpk_mne_stx","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m003-0020","start":20,"end":22,"surface":"黃子","kind":"person","person_id":"9tx_4t9_4jj","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m003-0023","start":23,"end":26,"surface":"太史公","kind":"person","person_id":"pme_eis_xqi_*A*AAAA","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m003-0608","start":608,"end":609,"surface":"堯","kind":"person","person_id":"oho_r3f_c6y","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m003-0609","start":609,"end":610,"surface":"舜","kind":"person","person_id":"ddb_l4j_4j2","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m003-0749","start":749,"end":751,"surface":"墨子","kind":"person","person_id":"ego_jo3_7bf","status":"contextual_provisional"}],"chapter_id":"c-shiji-130-taishigong","book_id":"b-shiji-130","work_id":"w-shiji","source_