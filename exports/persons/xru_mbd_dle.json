{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"xru_mbd_dle","canonical_person_id":"xru_mbd_dle","id_aliases":["cbr-p004401"],"identity_policy":"contextual_provisional","person_ids":["xru_mbd_dle"],"persons":[{"id":"xru_mbd_dle","label":"齊王受虞卿未名（平原君虞卿列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"齊王","mention_ids":["c-shiji-076-pingyu:m016-0232"]}],"evidence":[{"mention_id":"c-shiji-076-pingyu:m016-0232","chapter_id":"c-shiji-076-pingyu","paragraph_id":"c-shiji-076-pingyu:p016","quote":"齊王"}],"id_aliases":["cbr-p004401"]}],"source_mention_summary":[{"source_id":"s-shiji-076-pingyu","work_id":"w-shiji","book_id":"b-shiji-076","chapter_id":"c-shiji-076-pingyu","mention_count":1,"mention_ids":["c-shiji-076-pingyu:m016-0232"],"paragraph_ids":["c-shiji-076-pingyu:p016"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-076-pingyu"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-076-pingyu:m016-0232","start":232,"end":234,"surface":"齊王","kind":"person","person_id":"xru_mbd_dle","status":"contextual_provisional","paragraph_id":"c-shiji-076-pingyu:p016","chapter_id":"c-shiji-076-pingyu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji076-028","person_id":"xru_mbd_dle","scope":"same_chapter","chapter_ids":["c-shiji-076-pingyu"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"依虞卿長平、割地與魏從敘事明示姓名及局部回指暫接，趙王以先後明示趙孝成王為限，秦齊兩王各留未名。樓昌昌、趙郝郝與樓緩緩樓子限本篇段落，公甫文伯及母相室保存引古角色，孔子逐魯不當已確證年表，母妻評語不補配偶。魏齊姓名與魏齊兩國詞分辨，馮亭保存太史公議論角色不確證邪説評價。","surfaces":["齊王"],"evidence":[{"paragraph_id":"c-shiji-076-pingyu:p016","quote":"虞卿聞之，往見王曰：「危哉樓子之所以爲秦者，是愈疑天下，而何慰秦之心哉？獨不言其示天下弱乎？且臣言勿予者，非固勿予而已也。秦索六城於王，而王以六城賂齊。齊，秦之深讎也，得王之六城，并力西擊秦，齊之聽王，不待辭之畢也。則是王失之於齊而取償於秦也。而齊、趙之深讎可以報矣，而示天下有能爲也。王以此發聲，兵未窺於境，臣見秦之重賂至趙而反媾於王也。從秦爲媾，韓、魏聞之，必盡重王；重王，必出重寶以先於王。則是王一舉而結三國之親，而與秦易道也。」趙王曰：「善。」則使虞卿東見齊王，與之謀秦。虞卿未返，秦使者已在趙矣。樓緩聞之，亡去。趙於是封虞卿以一城。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-076-pingyu:p016","text":"虞卿聞之，往見王曰：「危哉樓子之所以爲秦者，是愈疑天下，而何慰秦之心哉？獨不言其示天下弱乎？且臣言勿予者，非固勿予而已也。秦索六城於王，而王以六城賂齊。齊，秦之深讎也，得王之六城，并力西擊秦，齊之聽王，不待辭之畢也。則是王失之於齊而取償於秦也。而齊、趙之深讎可以報矣，而示天下有能爲也。王以此發聲，兵未窺於境，臣見秦之重賂至趙而反媾於王也。從秦爲媾，韓、魏聞之，必盡重王；重王，必出重寶以先於王。則是王一舉而結三國之親，而與秦易道也。」趙王曰：「善。」則使虞卿東見齊王，與之謀秦。虞卿未返，秦使者已在趙矣。樓緩聞之，亡去。趙於是封虞卿以一城。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-076-pingyu:m016-0000","start":0,"end":2,"surface":"虞卿","kind":"person","person_id":"cdg_kvt_y0p","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m016-0007","start":7,"end":8,"surface":"王","kind":"person","person_id":"8ga_fba_dw9","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m016-0013","start":13,"end":15,"surface":"樓子","kind":"person","person_id":"ow4_qy6_bx5","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m016-0066","start":66,"end":67,"surface":"王","kind":"person","person_id":"8ga_fba_dw9","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m016-0069","start":69,"end":70,"surface":"王","kind":"person","person_id":"8ga_fba_dw9","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m016-0085","start":85,"end":86,"surface":"王","kind":"person","person_id":"8ga_fba_dw9","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m016-0099","start":99,"end":100,"surface":"王","kind":"person","person_id":"8ga_fba_dw9","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m016-0110","start":110,"end":111,"sur