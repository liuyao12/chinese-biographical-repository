"c-nanqishu-043-wangsiyuan:p002:m0044","surface":"何昌宇","start":44,"end":47,"person_id":"3ea_uzt_2n2_DAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-043-wangsiyuan:p002:m0050","surface":"劉璡","start":50,"end":52,"person_id":"0ma_bmm_xha","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-043-wangsiyuan:p002:m0062","surface":"景素","start":62,"end":64,"person_id":"ccd_af3_98e_A","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-043-wangsiyuan:p002:m0070","surface":"思遠","start":70,"end":72,"person_id":"0cf_pqs_mnm","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":2400356,"source_layer":"received_biography","first_line":72,"last_line":72,"line_start":2,"line_end":100,"raw_start":4191,"raw_end":4289,"raw_character_offsets":[4191,4192,4193,4194,4195,4196,4197,4198,4199,4200,4201,4202,4203,4204,4205,4206,4207,4208,4209,4210,4211,4212,4213,4214,4215,4216,4217,4218,4219,4220,4221,4222,4223,4224,4225,4226,4227,4228,4229,4230,4231,4232,4233,4234,4235,4236,4237,4238,4239,4240,4241,4242,4243,4244,4245,4246,4247,4248,4249,4250,4251,4252,4253,4254,4255,4256,4257,4258,4259,4260,4261,4262,4263,4264,4265,4266,4267,4268,4269,4270,4271,4272,4273,4274,4275,4276,4277,4278,4279,4280,4281,4282,4283,4284,4285,4286,4287,4288],"projection_sha256":"ae8c8a11abecf328903e19733e721483eae887c45def54613db2489db6e9dcf2","editorial_excerpt_boundary":true},"chapter_id":"c-nanqishu-043-wangsiyuan","book_id":"b-nanqishu-043","work_id":"w-nanqishu","source_id":"s-nanqishu-043-wangsiyuan-ws2400356"},{"id":"c-nanshi-024-wangsiyuan:p001","text":"思遠，晏從父弟也。父羅雲，平西長史。思遠八歳父卒，祖弘之及外祖新安太守羊敬元並棲退高尚，故思遠少無仕心。宋建平王景素辟南徐州主簿，深見禮遇。景素被誅，左右離散，思遠親視殯葬，手種松柏，與廬江何昌宇、沛郡劉璡上表理之，事感朝廷。景素女廢爲庶人，思遠分衣食以相資贍。年長，爲備笄總，訪求素對，傾家送遣。","mentions":[{"id":"c-nanshi-024-wangsiyuan:p001:m0000","surface":"思遠","start":0,"end":2,"person_id":"0cf_pqs_mnm","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangsiyuan:p001:m0003","surface":"晏","start":3,"end":4,"person_id":"i08_s4b_5bb","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangsiyuan:p001:m0010","surface":"羅雲","start":10,"end":12,"person_id":"7r6_k52_qji_ABDACABC","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangsiyuan:p001:m0018","surface":"思遠","start":18,"end":20,"person_id":"0cf_pqs_mnm","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangsiyuan:p001:m0026","surface":"弘之","start":26,"end":28,"person_id":"7r6_k52_qji_ABDACAB","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangsiyuan:p001:m0035","surface":"羊敬元","start":35,"end":38,"person_id":"qav_j5i_grm","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangsiyuan:p001:m0045","surface":"思遠","start":45,"end":47,"person_id":"0cf_pqs_mnm","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangsiyuan:p001:m0056","surface":"景素","start":56,"end":58,"person_id":"ccd_af3_98e_A","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangsiyuan:p001:m0070","surface":"景素","start":70,"end":72,"person_id":"ccd_af3_98e_A","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangsiyuan:p001:m0080","surface":"思遠","start":80,"end":82,"person_id":"0cf_pqs_mnm","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangsiyuan:p001:m0095","surface":"何昌宇","start":95,"end":98,"person_id":"3ea_uzt_2n2_D