ragraph_id":"c-shiji-104-tianshu:p011","quote":"平陽主"}],"identity_note":"〈外戚世家〉王太后女、武帝姊；曹時與衛青婚姻各有來源，夏侯頗配偶及李延年段同號女子另存未決，不據此推三嫁。"}],"source_mention_summary":[{"source_id":"s-shiji125-ningxing","work_id":"w-shiji","book_id":"b-shiji-125","chapter_id":"c-shiji-125-ningxing","mention_count":1,"mention_ids":["c-shiji-125-ningxing:m004-0035"],"paragraph_ids":["c-shiji-125-ningxing:p004"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji125-ningxing"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"unresolved_identity_cases":[{"id":"ic-shiji095-pingyang-princesses","status":"unresolved","candidate_person_ids":["921_w24_4mr","nad_18h_5jc","ase_y0g_7gy"],"paragraph_ids":["c-shiji-095-fankuang:p021","c-shiji-049-waiqi:p024","c-shiji-049-waiqi:p028","c-shiji-125-ningxing:p004"],"note":"本篇夏侯頗所尚平陽公主，〈漢書·夏侯嬰傳〉又稱其隨外家姓、號孫公主；與〈外戚世家〉王太后女、武帝姊是否同人仍有疑點，暫不接合。李延年段只稱平陽公主，亦先保留候選；不由同號或大致同時推三段婚姻、父母及母家。","references":[{"url":"https://zh.wikisource.org/w/index.php?title=漢書/卷041&oldid=2342290","title":"《漢書·樊酈滕灌傅靳周傳》夏侯嬰段","quote":"初嬰為滕令奉車，故號滕公。及曾孫頗尚主，主隨外家姓，號孫公主，故滕公子孫更為孫氏。","status":"text_checked","image_verified":false,"access_note":"核讀現行數位頁相應正文及固定修訂頁尾，未核書影。"},{"title":"錢大昕《廿二史考異·漢書卷三·夏侯嬰傳》","author":"錢大昕","url":"https://www.shidianguji.com/zh/book/CADAL02082248/chapter/1lan8l5222bea","quote":"此夏侯頗所尚之平陽公主，蓋别是一人，不知何帝女也。","reference_kind":"historical_scholarship","status":"reference_only","image_verified":false,"accessed_on":"2026-10-15","note":"考證意見另列，不宣稱已獨立驗證全部論證或為最新研究。"}],"reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"chapter_id":"c-shiji-095-fankuang","source_id":"s-shiji-095-fankuang"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-125-ningxing:m004-0035","start":35,"end":39,"surface":"平陽公主","kind":"person","person_id":"ase_y0g_7gy","status":"contextual_provisional","paragraph_id":"c-shiji-125-ningxing:p004","chapter_id":"c-shiji-125-ningxing"}],"relations":[],"title_holdings":[{"id":"th-shiji125-013","person_id":"ase_y0g_7gy","title":"平陽公主","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-125-ningxing","source_id":"s-shiji125-ningxing","paragraph_id":"c-shiji-125-ningxing:p004","quote":"李延年，中山人也。父母及身兄弟及女，皆故倡也。延年坐法腐，給事狗中。而平陽公主言延年女弟善舞，上見，心說之，及入永巷，而召貴延年。延年善歌，為變新聲，而上方興天地祠，欲造樂詩歌弦之。延年善承意，弦次初詩。其女弟亦幸，有子男。延年佩二千石印，號協聲律。與上臥起，甚貴幸，埒如韓嫣也。久之，寖與中人亂，出入驕恣。及其女弟李夫人卒后，愛弛，則禽誅延年昆弟也。自是之后，內寵嬖臣大底外戚之家，然不足數也。衛青、霍去病亦以外戚貴幸，然頗用材能自進。"}],"attestations":[{"id":"th-shiji125-013:a001","paragraph_id":"c-shiji-125-ningxing:p004","start":35,"end":39,"surface":"平陽公主","person_mention_id":"c-shiji-125-ningxing:m004-0035","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"明示官爵或稱號用語按原字存錄；官至不作初任年，用稱不作授予，未知起訖保持未知。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-049-waiqi:p024","text":"景帝十三男，一男為帝，十二男皆為王。而兒姁早卒，其四子皆為王。王太后長女號日平陽公主，次為南宮公主，次為林慮公主。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-049-waiqi:m024-0000","start":0,"end":2,"surface":"景帝","kind":"person","person_id":"yqp_nlb_p1p_ACA","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m024-0002","start":2,"end":5,"surface":"十三男","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、集體、制度稱號或待