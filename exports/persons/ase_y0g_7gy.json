d":"c-shiji-095-fankuang:m021-0152","start":152,"end":153,"surface":"賜","kind":"person","person_id":"li9_cmb_8ci_AA","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0163","start":163,"end":164,"surface":"頗","kind":"person","person_id":"li9_cmb_8ci_AAA","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0165","start":165,"end":169,"surface":"平陽公主","kind":"person","person_id":"921_w24_4mr","status":"contextual_provisional"}],"chapter_id":"c-shiji-095-fankuang","book_id":"b-shiji-095","work_id":"w-shiji","source_id":"s-shiji-095-fankuang"},{"id":"c-shiji-125-ningxing:p004","text":"李延年，中山人也。父母及身兄弟及女，皆故倡也。延年坐法腐，給事狗中。而平陽公主言延年女弟善舞，上見，心說之，及入永巷，而召貴延年。延年善歌，為變新聲，而上方興天地祠，欲造樂詩歌弦之。延年善承意，弦次初詩。其女弟亦幸，有子男。延年佩二千石印，號協聲律。與上臥起，甚貴幸，埒如韓嫣也。久之，寖與中人亂，出入驕恣。及其女弟李夫人卒后，愛弛，則禽誅延年昆弟也。自是之后，內寵嬖臣大底外戚之家，然不足數也。衛青、霍去病亦以外戚貴幸，然頗用材能自進。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-125-ningxing:m004-0000","start":0,"end":3,"surface":"李延年","kind":"person","person_id":"qhp_lk5_t1e_A","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m004-0009","start":9,"end":10,"surface":"父","kind":"person","person_id":"qhp_lk5_t1e","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m004-0010","start":10,"end":11,"surface":"母","kind":"person","person_id":"f94_gpi_lqs","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m004-0013","start":13,"end":17,"surface":"兄弟及女","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-125-ningxing:m004-0023","start":23,"end":25,"surface":"延年","kind":"person","person_id":"qhp_lk5_t1e_A","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m004-0035","start":35,"end":39,"surface":"平陽公主","kind":"person","person_id":"ase_y0g_7gy","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m004-0040","start":40,"end":44,"surface":"延年女弟","kind":"person","person_id":"52o_i25_ekg","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m004-