irst_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-043-zhao:m046-0000","start":0,"end":2,"surface":"烈侯","kind":"person","person_id":"cbr-p002347","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m046-0005","start":5,"end":8,"surface":"魏文侯","kind":"person","person_id":"cbr-p002348","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m046-0013","start":13,"end":16,"surface":"太子撃","kind":"person","person_id":"cbr-p002349","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m046-0022","start":22,"end":27,"surface":"魏、韓、趙","kind":"unresolved","person_id":null,"status":"unresolved","note":"氏族、群體、未定指代與神異預言分存；不按地名、先後繼位或熟知身份補世系。"},{"id":"c-shiji-043-zhao:m046-0036","start":36,"end":38,"surface":"獻子","kind":"person","person_id":"cbr-p002343","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m046-0039","start":39,"end":41,"surface":"獻侯","kind":"person","person_id":"cbr-p002343","status":"contextual_provisional"}],"chapter_id":"c-shiji-043-zhao","book_id":"b-shiji-043","work_id":"w-shiji","source_id":"s-shiji-043-zhao"}],"sources":[{"chapter_id":"c-shiji-043-zhao","work_id":"w-shiji","book_id":"b-shiji-043","source_id":"s-shiji-043-zhao","source":{"title":"史記／卷043","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷043","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷043&oldid=7903603","revision_id":7903603,"accessed_on":"2026-10-09","extent":"121段正文及1段分層索隱述贊；排除2個dd導覽，只去除段落外緣空白。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"固定修訂與取得時HTML一致；保留古代異體及五世而（生）［至］趙夙等校勘符號。造父以下六世與叔帶以下五世不補闕代。","note":"已讀全121段數位正文及1段附載索隱述贊，後者另層保存；未核古籍影像、可靠底本或現代研究，首輪不是完成覆核。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":true}}
