status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-083-luzou:m004-0000","start":0,"end":2,"surface":"魯連","kind":"person","person_id":"cbr-p004656","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m004-0003","start":3,"end":6,"surface":"新垣衍","kind":"person","person_id":"cbr-p004662","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m004-0010","start":10,"end":13,"surface":"新垣衍","kind":"person","person_id":"cbr-p004662","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m004-0018","start":18,"end":25,"surface":"居此圍城之中者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛論或未定指代保留，不補未見姓名。"},{"id":"c-shiji-083-luzou:m004-0030","start":30,"end":33,"surface":"平原君","kind":"person","person_id":"cbr-p004663","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m004-0039","start":39,"end":41,"surface":"先生","kind":"person","person_id":"cbr-p004656","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m004-0049","start":49,"end":52,"surface":"平原君","kind":"person","person_id":"cbr-p004663","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m004-0069","start":69,"end":72,"surface":"魯仲連","kind":"person","person_id":"cbr-p004656","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m004-0077","start":77,"end":79,"surface":"鮑焦","kind":"person","person_id":"cbr-p004665","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m004-0091","start":91,"end":93,"surface":"眾人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛論或未定指代保留，不補未見姓名。"},{"id":"c-shiji-083-luzou:m004-0118","start":118,"end":120,"surface":"其士","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛論或未定指代保留，不補未見姓名。"},{"id":"c-shiji-083-luzou:m004-0123","start":123,"end":125,"surface":"其民","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛論或未定指代保留，不補未見姓名。"},{"id":"c-shiji-083-luzou:m004-0143","start":143,"end":144,"surface":"連","kind":"person","person_id":"cbr-p004656","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m004-0163","start":163,"end":165,"surface":"將軍","kind":"person","person_id":"cbr-p004662","status":"contextual_provisional"}],"chapter_id":"c-shiji-083-luzou","book_id":"b-shiji-083","work_id":"w-shiji","source_id":"s-shiji-083-luzou"},{"id":"c-shiji-083-luzou:p005","text":"新垣衍曰：「先生助之將柰何？」魯連曰：「吾將使梁及燕助之，齊、楚則固助之矣。」新垣衍曰：「燕則吾請以從矣；若乃梁者，則吾乃梁人也，先生惡能使梁助之？」魯連曰：「梁未睹秦稱帝之害故耳。使梁睹秦稱帝之害，則必助趙矣。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-083-luzou:m005-0000","start":0,"end":3,"surface":"新垣衍","kind":"person","person_id":"cbr-p004662","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m005-0006","start":6,"end":8,"surface":"先生","kind":"person","person_id":"cbr-p004656","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m005-0015","start":15,"end":17,"surface":"魯連","kind":"person","person_id":"cbr-p004656","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m005-0039","start":39,"end":42,"surface":"新垣衍","kind":"person","person_id":"cbr-p004662","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m005-0065","start":65,"end":67,"surface":"先生","kind":"person","person_id":"cbr-p004656","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m005-0075","start":75,"end":77,"surface":"魯連","kind":"person","person_id":"cbr-p004656","status":"contextual_provisional"}],"chapter_id":"c-shiji-083-luzou","book_id":"b-shiji-083","work_id":"w-shiji","source_id":"s-shiji-083-luzou"},{"id":"c-shiji-083-luzou:p006","text":"新垣衍曰：「秦稱帝之害何如？」魯連曰：「昔者齊威王嘗為仁義矣，率天下諸侯而朝周。周貧且微，諸侯莫朝，而齊獨朝之。居歲餘，周烈王崩，齊後往，周怒，赴於齊曰：『天崩地坼，天子下席。東藩之臣因齊後至，則斮。』齊威王勃然怒曰：『叱嗟，而母婢也！』卒為天下笑。故生則朝周，死則叱之，誠不忍其求也。彼天子固然，其無足怪。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-083-luzou:m006-0000","start":0,"end":3,"surface":"新垣衍","kind":"person","person_id":"cbr-p004662","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m006-0015","start":15,"end":17,"surface":"魯連","kind":"person","person_id":"cbr-p004656","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m006-0022","start":22,"end":25,"surface":"齊威王","kind":"person","person_id":"cbr-p004666","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m006-0034","start":34,"end":36,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、譬喻或未定指代；不依記憶補姓名與親屬。"},{"id":"c-shiji-083-luzou:m006-0045","start":45,"end":47,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、譬喻或未定指代；不依記憶補姓名與親屬。"},{"id":"c-shiji-083-luzou:m006-0060","start":60,"end":63,"surface":"周烈王","kind":"person","person_id":"cbr-p004667","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m006-0083","start":83,"end":85,"surface":"天子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、譬喻或未定指代；不依記憶補姓名與親屬。"},{"id":"c-shiji-083-luzou:m006-0088","start":88,"end":92,"surface":"東藩之臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、譬喻或未定指代；不依記憶補姓名與親屬。"},{"id":"c-shiji-083-luzou:m006-0101","start":101,"end":104,"surface":"齊威王","kind":"person","person_id":"cbr-p004666","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m006-0113","start":113,"end":115,"surface":"而母","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、譬喻或未定指代；不依記憶補姓名與親屬。"},{"id":"c-shiji-083-luzou:m006-0144","start":144,"end":146,"surface":"天子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、譬喻或未定指代；不依記憶補姓名與親屬。"}],"chapter_id":"c-shiji-083-luzou","book_id":"b-shiji-083","work_id":"w-shiji","source_id":"s-shiji-083-luzou"},{"id":"c-shiji-083-luzou:p007","text":"新垣衍曰：「先生獨不見夫仆乎？十人而從一人者，寧力不勝而智不若邪？畏之也。」魯仲連曰：「嗚呼！梁之比於秦若仆邪？」新垣衍曰：「然。」魯仲連曰：「吾將使秦王烹醢梁王。」新垣衍怏然不悅，曰：「噫嘻，亦太甚矣先生之言也！先生又惡能使秦王烹醢梁王？」魯仲連曰：「固也，吾將言之。昔者九侯、鄂侯、文王，紂之三公也。九侯有子而好，獻之於紂，紂以為惡，醢九侯。鄂侯爭之彊，辯之疾，故脯鄂侯。文王聞之，喟然而嘆，故拘之牖里之庫百日，欲令之死。曷為與人俱稱王，卒就脯醢之地？齊湣王之魯，夷維子為執策而從，謂魯人曰：『子將何以待吾君？』魯人曰：『吾將以十太牢待子之君。』夷維子曰：『子安取禮而來吾君？彼吾君者，天子也。天子巡狩，諸侯辟舍，納筦籥，攝衽抱机，視膳於堂下，天子已食，乃退而聽朝也。』魯人投其籥，不果納。不得入於魯，將之薛，假途於鄒。當是時，鄒君死，湣王欲入弔，夷維子謂鄒之孤曰：『天子弔，主人必將倍殯棺，設北面於南方，然後天子南面弔也。』鄒之群臣曰：『必若此，吾將伏劍而死。』固不敢入於鄒。鄒、魯之臣，生則不得事養，死則不得賻襚，然且欲行天子之禮於鄒、魯，鄒、魯之臣不果納。今秦萬乘之國也，梁亦萬乘之國也。俱據萬乘之國，各有稱王之名，睹其一戰而勝，欲從而帝之，是使三晉之大臣不如鄒、魯之仆妾也。且秦無已而帝，則且變易諸侯之大臣。彼將奪其所不肖而與其所賢，奪其所憎而與其所愛。彼又將使其子女讒妾為諸侯妃姬。處梁之宮。梁王安得晏然而已乎？而將軍又何以得故寵乎？」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-083-luzou:m007-0000","start":0,"end":3,"surface":"新垣衍","kind":"person","person_id":"cbr-p004662","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m007-0006","start":6,"end":8,"surface":"先生","kind":"person","person_id":"cbr-p004656","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m007-0038","start":38,"end":41,"surface":"魯仲連","kind":"person","person_id":"cbr-p004656","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m007-0057","start":57,"end":60,"surface":"新垣衍","kind":"person","person_id":"cbr-p004662","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m007-0066","start":66,"end":69,"surface":"魯仲連","kind":"person","person_id":"cbr-p004656","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m007-0075","start":75,"end":77,"surface":"秦王","kind":"person","person_id":"cbr-p004658","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m007-0079","start":79,"end":81,"surface":"梁王","kind":"person","person_id":"cbr-p004660","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m007-0083","start":83,"end":86,"surface":"新垣衍","kind":"person","person_id":"cbr-p004662","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m007-0101","start":101,"end":103,"surface":"先生","kind":"person","person_id":"cbr-p004656","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m007-0107","start":107,"end":109,"surface":"先生","kind":"person","person_id":"cbr-p004656","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m007-0113","start":113