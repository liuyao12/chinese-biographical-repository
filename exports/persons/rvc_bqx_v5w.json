0,2101,2102,2103,2104,2105,2106,2107,2108,2109,2115,2116,2117,2118,2121,2122,2123,2124,2125,2126,2127,2128,2129,2130,2131,2132],"projection_sha256":"35902ff374de2ea46fc29f42ff2b9f9c3e02678f70ad99cc648f82fdc011a32b","source_layer":"received_biography"},"mentions":[{"id":"c-liangshu-041-wanggui-ws1512987:p011:m0000","start":0,"end":2,"surface":"宗懍","kind":"person","person_id":"kh0_p5k_lqu","status":"contextual_provisional","interpretation_note":"依本段完整句法及人物角色辨識；稱謂不跨朝代或換任套用。"},{"id":"c-liangshu-041-wanggui-ws1512987:p011:m0003","start":3,"end":5,"surface":"元懍","kind":"person","person_id":"kh0_p5k_lqu","status":"contextual_provisional","interpretation_note":"依本段完整句法及人物角色辨識；稱謂不跨朝代或換任套用。"},{"id":"c-liangshu-041-wanggui-ws1512987:p011:m0009","start":9,"end":10,"surface":"承","kind":"person","person_id":"ckr_fwx_4c3","status":"contextual_provisional","interpretation_note":"依本段完整句法及人物角色辨識；稱謂不跨朝代或換任套用。"},{"id":"c-liangshu-041-wanggui-ws1512987:p011:m0031","start":31,"end":32,"surface":"懍","kind":"person","person_id":"kh0_p5k_lqu","status":"contextual_provisional","interpretation_note":"依本段完整句法及人物角色辨識；稱謂不跨朝代或換任套用。"},{"id":"c-liangshu-041-wanggui-ws1512987:p011:m0048","start":48,"end":52,"surface":"童子學士","kind":"person","person_id":"kh0_p5k_lqu","status":"contextual_provisional","interpretation_note":"依本段完整句法及人物角色辨識；稱謂不跨朝代或換任套用。"},{"id":"c-liangshu-041-wanggui-ws1512987:p011:m0059","start":59,"end":62,"surface":"湘東王","kind":"person","person_id":"rvc_bqx_v5w","status":"contextual_provisional","interpretation_note":"依本段完整句法及人物角色辨識；稱謂不跨朝代或換任套用。"},{"id":"c-liangshu-041-wanggui-ws1512987:p011:m0091","start":91,"end":93,"surface":"世祖","kind":"person","person_id":"rvc_bqx_v5w","status":"contextual_provisional","interpretation_note":"依本段完整句法及人物角色辨識；稱謂不跨朝代或換任套用。"},{"id":"c-liangshu-041-wanggui-ws1512987:p011:m0099","start":99,"end":101,"surface":"世祖","kind":"person","person_id":"rvc_bqx_v5w","status":"contextual_provisional","interpretation_note":"依本段完整句法及人物角色辨識；稱謂不跨朝代或換任套用。"},{"id":"c-liangshu-041-wanggui-ws1512987:p011:m0148","start":148,"end":149,"surface":"瑴","kind":"person","person_id":"y4a_gmc_c6h","status":"contextual_provisional","interpretation_note":"依本段完整句法及人物角色辨識；稱謂不跨朝代或換任套用。"}],"chapter_id":"c-liangshu-041-wanggui-ws1512987","book_id":"b-liangshu-041","work_id":"w-liangshu","source_id":"s-liangshu041-ws1512987"},{"text":"子野少時集注喪服、續裴氏家傳各二卷，抄合後漢事四十餘卷。又敕撰眾僧傳二十卷，百官九品二卷，附益諡法一卷，方國使圖一卷，文集二十卷：並行於世。又欲撰齊梁春秋，始草創，未就而卒。及葬，湘東王為之墓誌銘，陳于藏內。邵陵王又立墓誌，堙於羨道。羨道列志，自此始焉。子騫，官至通直郎。","source_position":{"start":11443,"end":11579,"raw":"子野少時集注喪服、續裴氏家傳各二卷，抄合後漢事四十餘卷。又敕撰眾僧傳二十卷，百官九品二卷，附益諡法一卷，方國使圖一卷，文集二十卷：並行於世。又欲撰齊梁春秋，始草創，未就而卒。及葬，湘東王為之墓誌銘，陳于藏內。邵陵王又立墓誌，堙於羨道。羨道列志，自此始焉。子騫，官至通直郎。","raw_path":"sources/nanshi/wikisource-1554233-raw.wikitext"},"id":"c-nanshi-033-pei-family:p023","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-nanshi-033-pei-family:p023:m0000","start":0,"end":2,"surface":"子野","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"字幾原、父昭明、著宋略、掌國史及中大通卒，梁030同字、同家系、同著述與朝事。"},{"id":"c-nanshi-033-pei-family:p023:m0090","start":90,"end":93,"surface":"湘東王","kind":"person","person_id":"rvc_bqx_v5w","status":"contextual_provisional","interpretation_note":"梁書卷05固定2312810正文首段明諱繹、天監十三年封湘東郡王；南史此為梁子野中大通二年卒葬時湘東王作誌，時段和唯一王號相合，辨繹，不把外證諱字補進本篇原文。"},{"id":"c-nanshi-033-pei-family:p023:m0094","start":94,"end":95,"surface":"之","kind":"pronoun","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"字幾原、父昭明、著宋略、掌國史及中大通卒，梁030同字、同家系、同著述與朝事。"},{"id":"c-nanshi-033-pei-family:p023:m0104","start":104,"end":107,"surface":"邵陵王","kind":"person","person_id":"81y_7i5_frc","status":"contextual_provisional","interpretation_note":"梁書卷29固定1538079正文邵陵攜王綸字世調、天監十三年封、普通五年奪爵後大通元年復封、中大通四年再免；子野中大通二年卒葬時位於復封有效敘事，故本源邵陵王辨綸，不據數位notes或維基百科。"},{"id":"c-nanshi-033-pei-family:p023:m0128","start":128,"end":129,"surface":"騫","kind":"person","person_id":"vpy_180_2oi_AAAAAA","status":"contextual_provisional","interpretation_note":"子野子騫官至通直郎，梁030同父同官同傳末位置作謇，保騫／謇兩來源原字。"}],"chapter_id":"c-nanshi-033-pei-family","book_id":"b-nanshi-033","work_id":"w-nanshi","source_id":"s-nanshi033-ws1554233"}],"sources":[{"chapter_id":"c-liangshu-041-wanggui-ws1512987","work_id":"w-liangshu","book_id":"b-liangshu-041","source_id":"s-liangshu041-ws1512987","source":{"title":"《梁書》卷四十一王規及王褒、劉瑴、宗懍完整選錄","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?oldid=1512987","permalink":"https://zh.wikisource.org/w/index.php?oldid=1512987","revision_id":1512987,"accessed_on":"2026-10-29","extent":"完整王規本傳、子王褒及劉瑴／宗懍附傳；止王承獨立傳前，非全卷。","text_scope":"partial_chapter","review_status":"text_checked","human_reviewed":false,"image_verified":false,"printed_base_edition":null,"edition":"固定數位轉錄，實際印本未知；未核書影，非武英殿本。","rights":"古代原文及維基文庫數位轉錄，保留數位歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","raw_file":"source-evidence/liang041-wanggui-ws1512987/liang041-fixed.wikitext","raw_path":"source-evidence/liang041-wanggui-ws1512987/liang041-fixed.wikitext","wikitext_sha256":"c19683a05200034bc5e35a92e79d390e2653d9c6f94cc021e06719a6062a0e4f","raw_file_sha256":"c19683a05200034bc5e35a92e79d390e2653d9c6f94cc021e06719a6062a0e4f","normalization":{"character_conversion":{},"extraction_note":"只展YL為原年號字串，去縮排及引文行首冒號；原字鐧、普通初及子漢保留。"}}},{"chapter_id":"c-nanshi-033-pei-family","work_id":"w-nanshi","book_id":"b-nanshi-033","source_id":"s-nanshi033-ws1554233","source":{"title":"南史/卷33","revision_id":1554233,"revision_timestamp":"2019-03-29T02:35:39Z","status":200,"response_sha256":"8380abe50572203e436afe87e646878898cffb422d117948c0f7a802b0086a5a","raw_sha256":"03f36d2b463faf43738af65819a8afae18d17df2da3a2b6e7a824a322b14dc86","url":"https://zh.wikisource.org/w/index.php?title=%E5%8D%97%E5%8F%B2%2F%E5%8D%B733&oldid=1554233","api_url":"https://zh.wikisource.org/w/api.php?action=query&format=json&formatversion=2&prop=revisions&rvprop=ids%7Ctimestamp%7Ccontent&rvslots=main&titles=%E5%8D%97%E5%8F%B2%2F%E5%8D%B733","image