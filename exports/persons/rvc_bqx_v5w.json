c-nanshi-019-jiqing:p005:m0068","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-019","chapter_id":"c-nanshi-019-jiqing","source_id":"s-nanshi-019-jiqing-ws1531762","paragraph_id":"c-nanshi-019-jiqing:p005","quote":"居白楊石井宅，朝中交好者載酒從之，客恆滿坐。時左丞庾仲容亦免歸，二人意相得，並肆情誕縱，或乘露車歷遊郊野，醉則執鐸輓歌，不屑物議。湘東王繹在荊鎮與書慰勉之。","person_mention_id":"c-nanshi-019-jiqing:p005:m0068"}],"status":"source_attested","interpretation_note":"本句所載官名，任期無確切年月。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"person_references":[{"start":65,"end":68,"surface":"湘東王","id":"c-nanshi-019-jiqing:p005:r0065","paragraph_id":"c-nanshi-019-jiqing:p005","person_id":"rvc_bqx_v5w","referent_role":"third_person","quote":"居白楊石井宅，朝中交好者載酒從之，客恆滿坐。時左丞庾仲容亦免歸，二人意相得，並肆情誕縱，或乘露車歷遊郊野，醉則執鐸輓歌，不屑物議。湘東王繹在荊鎮與書慰勉之。","note":"本句按敘述視點回指繹。","chapter_id":"c-nanshi-019-jiqing","book_id":"b-nanshi-019","work_id":"w-nanshi","source_id":"s-nanshi-019-jiqing-ws1531762"},{"start":5,"end":7,"surface":"元帝","id":"c-nanshi-021-wangchong:p002:r0005","paragraph_id":"c-nanshi-021-wangchong:p002","person_id":"rvc_bqx_v5w","referent_role":"third_person","quote":"侯景之亂，元帝承制，沖求解南郡讓王僧辯，並獻女伎十人，以助軍賞。侯景平，授丹陽尹。魏平江陵，敬帝爲太宰承制，以沖爲左長史。紹泰中，累遷左光祿大夫、尚書左僕射、開府儀同三司，給扶。","note":"本句按敘述視點回指梁元。","chapter_id":"c-nanshi-021-wangchong","book_id":"b-nanshi-021","work_id":"w-nanshi","source_id":"s-nanshi-021-wangchong-ws1752646"},{"start":59,"end":62,"surface":"湘東王","id":"c-nanshi-021-wangji:p002:r0059","paragraph_id":"c-nanshi-021-wangji:p002","person_id":"rvc_bqx_v5w","referent_role":"third_person","quote":"籍好學，有才氣，爲詩慕謝靈運。至其合也，殆無愧色。時人咸謂康樂之有王籍，如仲尼之有丘明，老聃之有嚴周。梁天監中，爲輕車湘東王諮議參軍，隨府會稽郡。至若邪溪賦詩云：「蟬噪林逾靜，鳥鳴山更幽。」劉孺見之，擊節不能已已。以公事免。","note":"本句按敘述視點回指王。","chapter_id":"c-nanshi-021-wangji","book_id":"b-nanshi-021","work_id":"w-nanshi","source_id":"s-nanshi-021-wangji-ws1752646"},{"start":96,"end":99,"surface":"湘東王","id":"c-nanshi-021-wangji:p003:r0096","paragraph_id":"c-nanshi-021-wangji:p003","person_id":"rvc_bqx_v5w","referent_role":"third_person","quote":"及爲中散大夫，彌忽忽不樂，乃至徒行市道，不擇交遊。有時塗中見相識，輒以笠傘覆面。後爲作唐侯相，小邑寡事，彌不樂，不理縣事。人有訟者，鞭而遣之。未幾而卒。籍又甚工草書，筆勢遒放，蓋孔琳之流亞也。湘東王集其文爲十卷云。","note":"本句按敘述視點回指王。","chapter_id":"c-nanshi-021-wangji","book_id":"b-nanshi-021","work_id":"w-nanshi","source_id":"s-nanshi-021-wangji-ws1752646"},{"start":15,"end":18,"surface":"梁元帝","id":"c-nanshi-021-wangyang:p001:r0015","paragraph_id":"c-nanshi-021-wangyang:p001","person_id":"rvc_bqx_v5w","referent_role":"third_person","quote":"瑒字子瑛，沈靜有器局，美風儀。梁元帝時，位太子中庶子。陳武帝入輔，以爲司徒左長史。文帝即位，累遷太子中庶子、散騎常侍、侍中。父沖嘗爲瑒辭領中庶子，文帝顧沖曰：「所以久留瑒于承華，正欲使太子微有瑒風法耳。」","note":"本句按敘述視點回指梁元。","chapter_id":"c-nanshi-021-wangyang","book_id":"b-nanshi-021","work_id":"w-nanshi","source_id":"s-nanshi-021-wangyang-ws1752646"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-nanshi033-湘東王","person_id":"rvc_bqx_v5w","surfaces":["湘東王"],"scope":"same_chapter","status":"contextual_provisional","confidence_level":"medium","identification_basis":{"kind":"source_context","target_mention_ids":["c-nanshi-033-pei-family:p023:m0090"]},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-033","chapter_id":"c-nanshi-033-pei-family","source_id":"s-nanshi033-ws1554233","paragraph_id":"c-nanshi-033-pei-family:p023","quote":"子野少時集注喪服、續裴氏家傳各二卷，抄合後漢事四十餘卷。又敕撰眾僧傳二十卷，百官九品二卷，附益諡法一卷，方國使圖一卷，文集二十卷：並行於世。又欲撰齊梁春秋，始草創，未就而卒。及葬，湘東王為之墓誌銘，陳于藏內。邵陵王又立墓誌，堙於羨道。羨道列志，自此始焉。子騫，官至通直郎。"}],"rationale":"梁書卷05固定2312810正文首段明諱繹、天監十三年封湘東郡王；南史此為梁子野中大通二年卒葬時湘東王作誌，時段和唯一王號相合，辨繹，不把外證諱字補進本篇原文。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null}],"equivalence_decisions":[],"passages":[{"id":"c-nanshi-019-jiqing:p005","text":"居白楊石井宅，朝中交好者載酒從之，客恆滿坐。時左丞庾仲容亦免歸，二人意相得，並肆情誕縱，或乘露車歷遊郊野，醉則執鐸輓歌，不屑物議。湘東王繹在荊鎮與書慰勉之。","text_layer":"received_chapter","annotation_status":"revi