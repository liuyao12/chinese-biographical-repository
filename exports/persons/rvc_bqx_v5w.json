,6276,6279,6282,6283,6284,6285,6286,6287,6288,6289,6290,6291,6292,6293,6294,6295,6296,6297,6298,6299,6300,6301,6302,6303,6304,6305,6306,6307,6308,6309,6310,6311,6312,6313],"projection_sha256":"c44b0b598ea8aabbf112cc9b7f40fd8d2a72ed754b4fa55b4cd79a209b05ec36"},"chapter_id":"c-nanshi-021-wangji","book_id":"b-nanshi-021","work_id":"w-nanshi","source_id":"s-nanshi-021-wangji-ws1752646"},{"id":"c-nanshi-021-wangji:p003","text":"及爲中散大夫，彌忽忽不樂，乃至徒行市道，不擇交遊。有時塗中見相識，輒以笠傘覆面。後爲作唐侯相，小邑寡事，彌不樂，不理縣事。人有訟者，鞭而遣之。未幾而卒。籍又甚工草書，筆勢遒放，蓋孔琳之流亞也。湘東王集其文爲十卷云。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"start":76,"end":77,"surface":"籍","id":"c-nanshi-021-wangji:p003:m0076","person_id":"p93_tgr_t8r_AA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作籍。"},{"start":89,"end":92,"surface":"孔琳之","id":"c-nanshi-021-wangji:p003:m0089","person_id":"bv7_fd0_qyg","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作孔琳。"}],"source_position":{"revision_id":1752646,"source_layer":"received_biography","raw_start":6316,"raw_end":6423,"raw_character_offsets":[6316,6317,6318,6319,6320,6321,6322,6323,6324,6325,6326,6327,6328,6329,6330,6331,6332,6333,6334,6335,6336,6337,6338,6339,6340,6341,6342,6343,6344,6345,6346,6347,6348,6349,6350,6351,6352,6353,6354,6355,6356,6357,6358,6359,6360,6361,6362,6363,6364,6365,6366,6367,6368,6369,6370,6371,6372,6373,6374,6375,6376,6377,6378,6379,6380,6381,6382,6383,6384,6385,6386,6387,6388,6389,6390,6391,6392,6393,6394,6395,6396,6397,6398,6399,6400,6401,6402,6403,6404,6405,6406,6407,6408,6409,6410,6411,6412,6413,6414,6415,6416,6417,6418,6419,6420,6421,6422],"projection_sha256":"3983ecd39a3356f7c573c9b080548674f1f11dc3aa42874bd06fd8683698633e"},"chapter_id":"c-nanshi-021-wangji","book_id":"b-nanshi-021","work_id":"w-nanshi","source_id":"s-nanshi-021-wangji-ws1752646"},{"id":"c-nanshi-021-wangyang:p001","text":"瑒字子瑛，沈靜有器局，美風儀。梁元帝時，位太子中庶子。陳武帝入輔，以爲司徒左長史。文帝即位，累遷太子中庶子、散騎常侍、侍中。父沖嘗爲瑒辭領中庶子，文帝顧沖曰：「所以久留瑒于承華，正欲使太子微有瑒風法耳。」","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"start":0,"end":1,"surface":"瑒","id":"c-nanshi-021-wangyang:p001:m0000","person_id":"7r6_k52_qji_ABAAAAAABAAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作瑒。"},{"start":2,"end":4,"surface":"子瑛","id":"c-nanshi-021-wangyang:p001:m0002","person_id":"7r6_k52_qji_ABAAAAAABAAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作瑒。"},{"start":63,"end":64,"surface":"沖","id":"c-nanshi-021-wangyang:p001:m0063","person_id":"7r6_k52_qji_ABAAAAAABAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作沖。"},{"start":66,"end":67,"surface":"瑒","id":"c-nanshi-021-wangyang:p001:m0066","person_id":"7r6_k52_qji_ABAAAAAABAAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作瑒。"},{"start":76,"end":77,"surface":"沖","id":"c-nanshi-021-wangyang:p001:m0076","person_id":"7r6_k52_qji_ABAAAAAABAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作沖。"},{"start":84,"end":85,"surface":"瑒","id":"c-nanshi-021-wangyang:p001:m0084","person_id":"7r6_k52_qji_ABAAAAAABAAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作瑒。"},{"start":96,"end":97,"surface":"瑒","id":"c-nanshi-021-wangyang:p001:m0096","person_id":"7r6_k52_qji_ABAAAAAABAAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作瑒。"}],"source_position":{"revision_id":1752646,"source_layer":"received_biography","raw_start":7209,"raw_end":7319,"raw_character_offsets":[7209,7210,7211,7212,7213,7214,7215,7216,7217,7218,7219,7220,7221,7222,7223,7224,7225,7226,7227,7228,7229,7230,7231,7232,7233,7234,7235,7236,7237,7238,7239,7240,7241,7242,7243,7244,7245,7246,7247,7248,7249,7250,7251,7252,7253,7254,7255,7256,7257,7258,7259,7260,7261,7262,7263,7264,7265,7266,7267,7268,7269,7270,7271,7274,7277,7278,7279,7280,7281,7282,7283,7284,7285,7286,7287,7288,7291,7294,7295,7296,7297,7298,7299,7300,7301,7302,7303,7304,7305,7306,7307,7308,7309,7310,7311,7312,7313,7314,7315,7316,7317,7318],"projection_sha256":"4780646d309b2b8ec2e705c071269f6becf7b93540da69eea53d812a1487cb4b"},"chapter_id":"c-nanshi-021-wangyang","book_id":"b-nanshi-021","work_id":"w-nanshi","source_id":"s-nanshi-021-wangyang-ws1752646"},{"text":"子野少時集注喪服、續裴氏家傳各二卷，抄合後漢事四十餘卷。又敕撰眾僧傳二十卷，百官九品二卷，附益諡法一卷，方國使圖一卷，文集二十卷：並行於世。又欲撰齊梁春秋，始草創，未就而卒。及葬，湘東王為之墓誌銘，陳于藏內。邵陵王又立墓誌，堙於羨道。羨道列志，自此始焉。子騫，官至通直郎。","source_position":{"start":11443,"end":11579,"raw":"子野少時集注喪服、續裴氏家傳各二卷，抄合後漢事四十餘卷。又敕撰眾僧傳二十卷，百官九品二卷，附益諡法一卷，方國使圖一卷，文集二十卷：並行於世。又欲撰齊梁春秋，始草創，未就而卒。及葬，湘東王為之墓誌銘，陳于藏內。邵陵王又立墓誌，堙於羨道。羨道列志，自此始焉。子騫，官至通直郎。","raw_path":"sources/nanshi/wikisource-1554233-raw.wikitext"},"id":"c-nanshi-033-pei-family:p023","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-nanshi-033-pei-family:p023:m0000","start":0,"end":2,"surface":"子野","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"字幾原、父昭明、著宋略、掌國史及中大通卒，梁030同字、同家系、同著述與朝事。"},{"id":"c-nanshi-033-pei-family:p023:m0090","start":90,"end":93,"surface":"湘東王","kind":"person","person_id":"rvc_bqx_v5w","status":"contextual_provisional","interpretation_note":"梁書卷05固定2312810正文首段明諱繹、天監十三年封湘東郡王；南史此為梁子野中大通二年卒葬時湘東王作誌，時段和唯一王號相合，辨繹，不把外證諱字補進本篇原文。"},{"id":"c-nanshi-033-pei-family:p023:m0094","start":94,"end":95,"surface":"之","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"字幾原、父昭明、著宋略、掌國史及中大通卒，梁030同字、同家系、同著述與朝事。"},{"id":"c-nanshi-033-pei-family:p023:m0104","start":104,"end":107,"surface":"邵陵王","kind":"person","person_id":"81y_7i5_frc","status":"contextual_provisional","interpretation_note":"梁書卷29固定1538079正文邵陵攜王綸字世調、天監十三年封、普通五年奪爵後大通元年復封、中大通四年再免；子野中大通二年卒葬時位於復封有效敘事，故本源邵陵王辨綸，不據數位notes或維基百科。"},{"id":"c-nanshi-033-pei-family:p023:m0128","start":128,"end":129,"surface":"騫","kind":"person","person_id":"vpy_180_2oi_AAAAAA","