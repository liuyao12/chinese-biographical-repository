_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-nanshi033-湘東王","person_id":"rvc_bqx_v5w","surfaces":["湘東王"],"scope":"same_chapter","status":"contextual_provisional","confidence_level":"medium","identification_basis":{"kind":"source_context","target_mention_ids":["c-nanshi-033-pei-family:p023:m0090"]},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-033","chapter_id":"c-nanshi-033-pei-family","source_id":"s-nanshi033-ws1554233","paragraph_id":"c-nanshi-033-pei-family:p023","quote":"子野少時集注喪服、續裴氏家傳各二卷，抄合後漢事四十餘卷。又敕撰眾僧傳二十卷，百官九品二卷，附益諡法一卷，方國使圖一卷，文集二十卷：並行於世。又欲撰齊梁春秋，始草創，未就而卒。及葬，湘東王為之墓誌銘，陳于藏內。邵陵王又立墓誌，堙於羨道。羨道列志，自此始焉。子騫，官至通直郎。"}],"rationale":"梁書卷05固定2312810正文首段明諱繹、天監十三年封湘東郡王；南史此為梁子野中大通二年卒葬時湘東王作誌，時段和唯一王號相合，辨繹，不把外證諱字補進本篇原文。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null}],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-041-wanggui-ws1512987:p003","text":"起家秘書郎，累遷太子舍人、安右南康王主簿、太子洗馬。天監十二年，改構太極殿，功畢，規獻《新殿賦》，其辭甚工。拜秘書丞。歷太子中舍人、司徒左西屬、從事中郎。晉安王綱出爲南徐州，高選僚屬，引爲雲麾諮議參軍。久之，出爲新安太守，父憂去職。服闋，襲封南昌縣侯，除中書黃門侍郎。敕與陳郡殷鈞、琅邪王錫、范陽張緬同侍東宮，俱爲昭明太子所禮。湘東王時爲京尹，與朝士宴集，屬規爲酒令。規從容對曰：「自江左以來，未有茲舉。」特進蕭琛、金紫傅昭在坐，並謂爲知言。普通初，陳慶之北伐，剋復洛陽，百僚稱賀，規退曰：「道家有云：非爲功難，成功難也。羯寇遊魂，爲日已久，桓溫得而復失，宋武竟無成功。我孤軍無援，深入寇境，威勢不接，饋運難繼，將是役也，爲禍階矣。」俄而王師覆沒，其識達事機多如此類。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","source_position":{"first_line":15,"last_line":15,"revision_id":1512987,"raw_start":429,"raw_end":772,"raw_character_offsets":[431,432,433,434,435,436,437,438,439,440,441,442,443,444,445,446,447,448,449,450,451,452,453,454,455,456,462,463,464,465,466,469,470,471,472,473,474,475,476,477,478,479,480,481,482,483,484,485,486,487,488,489,490,491,492,493,494,495,496,497,498,499,500,501,502,503,504,505,506,507,508,509,510,511,512,513,514,515,516,517,518,519,520,521,522,523,524,525,526,527,528,529,530,531,532,533,534,535,536,537,538,539,540,541,542,543,544,545,546,547,548,549,550,551,552,553,554,555,556,557,55