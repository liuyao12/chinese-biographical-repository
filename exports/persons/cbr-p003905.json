cbr-p003905","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m043-0355","start":355,"end":357,"surface":"子貢","kind":"person","person_id":"cbr-p003869","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m043-0368","start":368,"end":370,"surface":"子貢","kind":"person","person_id":"cbr-p003869","status":"contextual_provisional"}],"chapter_id":"c-shiji-067-disciples","book_id":"b-shiji-067","work_id":"w-shiji","source_id":"s-shiji-067-disciples"},{"id":"c-shiji-067-disciples:p044","text":"報吳王曰：「臣敬以大王之言告越王，越王大恐，曰：『孤不幸，少失先人，內不自量，抵罪於吳，軍敗身辱，棲於會稽，國爲虛莽，賴大王之賜，使得奉俎豆而修祭祀，死不敢忘，何謀之敢慮！』」後五日，越使大夫種頓首言於吳王曰：「東海役臣孤句踐使者臣種，敢修下吏問於左右。今竊聞大王將興大義，誅彊救弱，困暴齊而撫周室，請悉起境內士卒三千人，孤請自被堅執鋭，以先受矢石。因越賤臣種奉先人藏器，甲二十領，鈇屈盧之矛，步光之劍，以賀軍吏。」吳王大説，以告子貢曰：「越王欲身從寡人伐齊，可乎？」子貢曰：「不可。夫空人之國，悉人之眾，又從其君，不義。君受其幣，許其師，而辭其君。」吳王許諾，乃謝越王。於是吳王乃遂發九郡兵伐齊。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-067-disciples:m044-0001","start":1,"end":3,"surface":"吳王","kind":"person","person_id":"cbr-p003904","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m044-0009","start":9,"end":11,"surface":"大王","kind":"person","person_id":"cbr-p003904","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m044-0014","start":14,"end":16,"surface":"越王","kind":"person","person_id":"cbr-p003905","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m044-0017","start":17,"end":19,"surface":"越王","kind":"person","person_id":"cbr-p003905","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m044-0031","start":31,"end":33,"surface":"先人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、氏族、未名者或未定指代；不補姓名、成員或官職持有人。"},{"id":"c-shiji-067-disciples:m044-0060","start":60,"end":62,"surface":"大王","kind":"person","person_id":"cbr-p003904","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m044-0094","start":94,"end":97,"surface":"大夫種","kind":"person","person_id":"cbr-p003908","status":"contextual_provisional"},{"id"