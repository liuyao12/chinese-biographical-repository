ject_person_id":"cbr-p001559","status":"source_attested","evidence":[{"chapter_id":"c-shiji-037-wei","source_id":"s-shiji-037-wei","paragraph_id":"c-shiji-037-wei:p018","quote":"懿公之立也，百姓大臣皆不服。自懿公父惠公朔之讒殺太子伋代立至於懿公，常欲敗之，卒滅惠公之後而更立黔牟之弟昭伯頑之子申爲君，是爲戴公。戴公申元年卒。"}],"qualifiers":{"source_term":"黔牟之弟昭伯頑","historicity":"historical_tradition"},"interpretation_note":"保存本篇明示父、子、生、夫人與兄弟原稱，不由繼位推父子、不補同父同母或闕代；來源主張並非已確證史實。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji037-041","subject_person_id":"cbr-p001559","predicate":"brother","object_person_id":"cbr-p001553","status":"source_attested","evidence":[{"chapter_id":"c-shiji-037-wei","source_id":"s-shiji-037-wei","paragraph_id":"c-shiji-037-wei:p020","quote":"初，翟殺懿公也，衞人憐之，思復立宣公前死太子伋之後，伋子又死，而代伋死者子壽又無子。太子伋同母弟二人：其一曰黔牟，黔牟嘗代惠公爲君，八年復去；其二曰昭伯。昭伯、黔牟皆已前死，故立昭伯子申爲戴公。戴公卒，復立其弟燬爲文公。"}],"qualifiers":{"source_term":"同母弟二人其一黔牟","historicity":"historical_tradition"},"interpretation_note":"保存本篇明示父、子、生、夫人與兄弟原稱，不由繼位推父子、不補同父同母或闕代；來源主張並非已確證史實。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji037-061","person_id":"cbr-p001559","title":"君","kind":"noble_rank","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-037-wei","source_id":"s-shiji-037-wei","paragraph_id":"c-shiji-037-wei:p014","quote":"左右公子不平朔之立也，惠公四年，左右公子怨惠公之讒殺前太子伋而代立，乃作亂，攻惠公，立太子伋之弟黔牟爲君，惠公奔齊。"}],"attestations":[{"id":"th-shiji037-061:a001","paragraph_id":"c-shiji-037-wei:p014","start":51,"end":52,"surface":"君","person_mention_id":"c-shiji-037-wei:m014-0048","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":"四年","evidence":[{"chapter_id":"c-shiji-037-wei","source_id":"s-shiji-037-wei","paragraph_id":"c-shiji-037-wei:p014","quote":"左右公子不平朔之立也，惠公四年，左右公子怨惠公之讒殺前太子伋而代立，乃作亂，攻惠公，立太子伋之弟黔牟爲君，惠公奔齊。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"惠公四年立黔牟為君；出亡、復入不自動終止全部爵位，前後紀年不同保留。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji037-076","person_id":"cbr-p001559","surfaces":["衞君黔牟","黔牟"],"scope":"same_chapter","chapter_ids":["c-shiji-037-wei"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-037-wei:p014","quote":"左右公子不平朔之立也，惠公四年，左右公子怨惠公之讒殺前太子伋而代立，乃作亂，攻惠公，立太子伋之弟黔牟爲君，惠公奔齊。"},{"paragraph_id":"c-shiji-037-wei:p015","quote":"衞君黔牟立八年，齊襄公率諸侯奉王命共伐衞，納衞惠公，誅左右公子。衞君黔牟奔于周，惠公復立。惠公立三年出亡，亡八年復入，與前通年凡十三年矣。"},{"paragraph_id":"c-shiji-037-wei:p016","quote":"二十五年，惠公怨周之容舍黔牟，與燕伐周。周惠王奔温，衞、燕立惠王弟穨爲王。二十九年，鄭復納惠王。三十一年，惠公卒，子懿公赤立。"},{"paragraph_id":"c-shiji-037-wei:p018","quote":"懿公之立也，百姓大臣皆不服。自懿公父惠公朔之讒殺太子伋代立至於懿公，常欲敗之，卒滅惠公之後而更立黔牟之弟昭伯頑之子申爲君，是爲戴公。戴公申元年卒。"},{"paragraph_id":"c-shiji-037-wei:p020","quote":"初，翟殺懿公也，衞人憐之，思復立宣公前死太子伋之後，伋子又死，而代伋死者子壽又無子。太子伋同母弟二人：其一曰黔牟，黔牟嘗代惠公爲君，八年復去；其二曰昭伯。昭伯、黔牟皆已前死，故立昭伯子申爲戴公。戴公卒，復立其弟燬爲文公。"}],"rationale":"按本篇明示名與追稱、衛世系及具體事件暫定所列提及同指；每段原文附存，不按同名字面跨篇合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-037-wei:p014","text":"左右公子不平朔之立也，惠公四年，左右公子怨惠公之讒殺前太子伋而代立，乃作亂，攻惠公，立太子伋之弟黔牟爲君，惠公奔齊。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-037-wei:m014-0000","start":0,"end":4,"surface":"左右公子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、並稱、匿名者、校勘或尚未定指代；不補姓名、親屬、闕代或成員。"},{"id":"c-shiji-037-wei:m014-0006","start":6,"end":7,"surface":"朔","kind":"person","person_id":"cbr-p001557","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m014-0011","start":11,"end":13,"surface":"惠公","kind":"person","person_id":"cbr-p001557","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m014-0016","start":16,"end":20,"surface":"左右公子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、並稱、匿名者、校勘或尚未定指代；不補姓名、親屬、闕代或成員。"},{"id":"c-shiji-037-wei:m014-0021","start":21,"end":23,"surface":"惠公","kind":"person","person_id":"cbr-p001557","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m014-0027","start":27,"end":30,"surface":