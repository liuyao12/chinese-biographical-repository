ences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-liangshu-027-yinjun-complete:p003:m0185","start":185,"end":188,"surface":"繆道臻","kind":"person","person_id":"mmn_end_tse","status":"contextual_provisional","paragraph_id":"c-liangshu-027-yinjun-complete:p003","chapter_id":"c-liangshu-027-yinjun-complete"},{"id":"c-liangshu-027-yinjun-complete:p003:m0203","start":203,"end":206,"surface":"繆道臻","kind":"person","person_id":"mmn_end_tse","status":"contextual_provisional","paragraph_id":"c-liangshu-027-yinjun-complete:p003","chapter_id":"c-liangshu-027-yinjun-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-027-yinjun-complete:p003","text":"鈞體羸多疾，閉閤臥治，而百姓化其德，劫盜皆奔出境。嘗禽劫帥，不加考掠，但和言誚責。劫帥稽顙乞改過，鈞便命遣之，後遂爲善人。郡舊多山瘧，更暑必動，自鈞在任，郡境無復瘧疾。母憂去職，居喪過禮，昭明太子憂之，手書誡喻曰：「知比諸德，哀頓爲過，又所進殆無一溢，甚以酸耿。迥然一身，宗奠是寄，毀而滅性，聖教所不許。宜微自遣割，俯存禮制，穀粥果蔬，少加勉強。憂懷旣深，指故有及，並令繆道臻口具。」鈞答曰：「奉賜手令，並繆道臻宣旨，伏讀感咽，肝心塗地。小人無情，動不及禮，但稟生尫劣，假推年歲，罪戾所鐘，復加橫疾。頃者綿微，守盡晷漏，目亂玄黃，心迷哀樂，惟救危苦，未能以遠理自製。姜桂之滋，實聞前典，不避粱肉，復忝今慈，臣亦何人，降此憂愍。謹當循復聖言，思自補續，如脫申延，實由亭造。」服闋，遷五兵尚書，猶以頓瘵經時，不堪拜受，乃更授散騎常侍、領步兵校尉，侍東宮。尋改領中庶子。昭明太子薨，官屬罷，又領右遊擊，除國子祭酒，常侍如故。中大通四年，卒，時年四十九。諡曰貞子。二子：構，渥。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":58,"last_line":58,"raw_start":3730,"raw_end":4172,"raw_character_offsets":[