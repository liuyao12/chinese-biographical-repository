r-p004479","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m002-0232","start":232,"end":234,"surface":"范睢","kind":"person","person_id":"cbr-p004472","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m002-0243","start":243,"end":245,"surface":"張祿","kind":"person","person_id":"cbr-p004472","status":"contextual_provisional"}],"chapter_id":"c-shiji-079-fancai","book_id":"b-shiji-079","work_id":"w-shiji","source_id":"s-shiji-079-fancai"},{"id":"c-shiji-079-fancai:p019","text":"范睢既相秦，秦號曰張祿，而魏不知，以為范睢已死久矣。魏聞秦且東伐韓、魏，魏使須賈於秦。范睢聞之，為微行，敝衣閒步之邸，見須賈。須賈見之而驚曰：「范叔固無恙乎！」范睢曰：「然。」須賈笑曰：「范叔有說於秦邪？」曰：「不也。睢前日得過於魏相，故亡逃至此，安敢說乎！」須賈曰：「今叔何事？」范睢曰「臣為人庸賃。」須賈意哀之，留與坐飲食，曰：「范叔一寒如此哉！」乃取其一綈袍以賜之。須賈因問曰：「秦相張君，公知之乎？吾聞幸於王，天下之事皆決於相君。今吾事之去留在張君。孺子豈有客習於相君者哉？」范睢曰：「主人翁習知之。唯睢亦得謁，睢請為見君於張君。」須賈曰：「吾馬病，車軸折，非大車駟馬，吾固不出。」范睢曰：「願為君借大車駟馬於主人翁。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-079-fancai:m019-0000","start":0,"end":2,"surface":"范睢","kind":"person","person_id":"cbr-p004472","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m019-0009","start":9,"end":11,"surface":"張祿","kind":"person","person_id":"cbr-p004472","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m019-0019","start":19,"end":21,"surface":"范睢","kind":"person","person_id":"cbr-p004472","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m019-0038","start":38,"end":40,"surface":"須賈","kind":"person","person_id":"cbr-p004473","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m019-0043","start":43,"end":45,"surface":"范睢","kind":"person","person_id":"cbr-p004472","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m019-0060","start":60,"end":62,"surface":"須賈","kind":"person","person_id":"cbr-p004473","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m019-0063","start":63,"end":65,"surface":"須賈","kind":"person","person_id":"cbr-p004473","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m019-0072","start":72,"en