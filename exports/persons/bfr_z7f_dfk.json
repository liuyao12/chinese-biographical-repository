n_id":"c-jinshu-098-jin033-wangji:line017:m0039"}],"interpretation_note":"依本來源登記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-jinshu-057-jin067-xilong:begin:m0000","start":0,"end":2,"surface":"趙誘","kind":"person","person_id":"bfr_z7f_dfk","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-057-jin067-xilong:begin","chapter_id":"c-jinshu-057-jin067-xilong"},{"id":"c-jinshu-057-jin067-xilong:begin:m0004","start":4,"end":6,"surface":"元孫","kind":"person","person_id":"bfr_z7f_dfk","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-057-jin067-xilong:begin","chapter_id":"c-jinshu-057-jin067-xilong"},{"id":"c-jinshu-057-jin067-xilong:end:m0015","start":15,"end":16,"surface":"誘","kind":"person","person_id":"bfr_z7f_dfk","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-057-jin067-xilong:end","chapter_id":"c-jinshu-057-jin067-xilong"},{"id":"c-jinshu-067-xilong:line128:m0105","start":105,"end":107,"surface":"趙誘","kind":"person","person_id":"bfr_z7f_dfk","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-067-xilong:line128","chapter_id":"c-jinshu-067-xilong"},{"id":"c-jinshu-067-xilong:line128:m0188","start":188,"end":190,"surface":"趙誘","kind":"person","person_id":"bfr_z7f_dfk","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-067-xilong:line128","chapter_id":"c-jinshu-067-xilong"},{"id":"c-jinshu-098-jin033-wangji:line017:m0039","start":39,"end":41,"surface":"趙誘","kind":"person","person_id":"bfr_z7f_dfk","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line017","chapter_id":"c-jinshu-098-jin033-wangji"}],"relations":[],"title_holdings":[{"id":"th-w067-long-8","person_id":"bfr_z7f_dfk","title":"主簿","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-067","chapter_id":"c-jinshu-067-xilong","source_id":"s-jinshu-067-xilong","paragraph_id":"c-jinshu-067-xilong:line128","quote":"隆少為趙王倫所善，及倫專擅，召為散騎常侍。倫之篡也，以為揚州刺史。僚屬有犯，輒依台閣峻制繩之，遠近咸怨。尋加甯東將軍，未拜，而齊王冏檄至，中州人在軍者皆欲赴義，隆以兄子鑒為趙王掾，諸子悉在京洛，故猶豫未決。主簿趙誘、前秀才虞潭白隆曰：「當今上計，明使君自將精兵徑赴齊王；中計，明使君可留督攝，速遣猛將率精兵疾赴；下計，示遣兵將助，而稱背倫。」隆素敬別駕顧彥，密與謀之。彥曰：「趙誘下計，乃上策也。」西曹留承聞彥言，請見，曰：「不審明使君當今何施？」隆曰：「我俱受二帝恩，無所偏助，惟欲守州而已。」承曰：「天下者，世祖皇帝之天下也。太上承代已積十年，今上取四海不平，齊王應天順時，成敗之事可見。使君若顧二帝，自可不行，宜急下檄文，速遣精兵猛將。若其疑惑，此州豈可得保也！」隆無所言，而停檄六日。時甯遠將軍陳留王邃領東海都尉，鎮石頭，隆軍人西赴邃甚眾。隆遣從事于牛渚禁之，不得止。將士憤怒，夜扶邃為主而攻之，隆父子皆死，顧彥亦被害，誣隆聚合遠近，圖為不軌。隆之死也，時議莫不痛惜焉。","person_mention_id":"c-jinshu-067-xilong:line128:m0105"}],"attestations":[{"id":"th-w043-long-8:a","paragraph_id":"c-jinshu-067-xilong:line128","start":103,"end":105,"surface":"主簿","person_mention_id":"c-jinshu-067-xilong:line128:m0105","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-057-jin067-xilong:begin","text":"趙誘，字元孫，淮南人也。世以將顯。州辟主簿。值刺史郗隆被齊王冏檄，使起兵討趙王倫","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-057-jin067-xilong:begin:m0000","start":0,"end":2,"surface":"趙誘","kind":"person","person_id":"bfr_z7f_dfk","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-057-jin067-xilong:begin:m0004","start":4,"end":6,"surface":"元孫","kind":"person","person_id":"bfr_z7f_dfk","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-057-jin067-xilong:begin:m0025","start":25,"end":27,"surface":"郗隆","kind":"person","person_id"