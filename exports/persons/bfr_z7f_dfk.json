,"interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line017:m0042","start":42,"end":44,"surface":"杜曾","kind":"person","person_id":"4vd_pg5_o8x","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line017:m0046","start":46,"end":47,"surface":"曾","kind":"person","person_id":"4vd_pg5_o8x","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line017:m0050","start":50,"end":51,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line017:m0070","start":70,"end":71,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"source_position":{"first_line":17,"last_line":17,"revision_id":2614273},"source_quote":{"witness":"j98","quote":"建武初，又遷征南大將軍，開府如故。中興建，拜侍中、大將軍、江州牧。遣部將硃軌、趙誘伐杜曾，為曾所殺，敦自貶，免侍中，並辭牧不拜。尋加荊州牧，敦上疏曰：","raw_start":1151,"raw_end":1226,"raw_line":17},"chapter_id":"c-jinshu-098-jin033-wangji","book_id":"b-jinshu-098","work_id":"w-jinshu","source_id":"s-jinshu-098-jin033-wangji"}],"sources":[{"chapter_id":"c-jinshu-057-jin067-xilong","work_id":"w-jinshu","book_id":"b-jinshu-057","source_id":"s-jinshu-057-jin067-xilong","source":{"title":"晉書趙誘傳","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?oldid=2413329","permalink":"https://zh.wikisource.org/w/index.php?oldid=2413329","revision_id":2413329,"accessed_on":"2026-11-21","extent":"下列來源節錄。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"固定修訂相關原文，逐字核收。","raw_path":"source-evidence/jin067-xilong/external/j57-ws2413329.wikitext","wikitext_sha256":"b8c7c77af7cc2d9dd644c5b5223d1ca1a7b91b46ce5e894901f37c2013340eb1","raw_file_sha256":"b8c7c77af7cc2d9dd644c5b5223d1ca1a7b91b46ce5e89490