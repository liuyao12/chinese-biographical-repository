d":false,"evidence":[{"paragraph_id":"c-shiji-005-qin:p025","quote":"晉獻公卒。立驪姬子奚齊，其臣里克殺奚齊。荀息立卓子，克又殺卓子及荀息。夷吾使人請秦，求入晉。於是繆公許之，使百里傒將兵送夷吾。夷吾謂曰：「誠得立，請割晉之河西八城與秦。」及至，已立，而使丕鄭謝秦，背約不與河西城，而殺裏克。丕鄭聞之，恐，因與繆公謀曰：「晉人不欲夷吾，實欲重耳。今背秦約而殺裏克，皆呂甥、郤芮之計也。願君以利急召呂、郤，呂、郤至，則更入重耳便。」繆公許之，使人與丕鄭歸，召呂、郤。呂、郤等疑丕鄭有閒，乃言夷吾殺丕鄭。丕鄭子丕豹奔秦，說繆公曰：「晉君無道，百姓不親，可伐也。」繆公曰：「百姓茍不便，何故能誅其大臣？能誅其大臣，此其調也。」不聽，而陰用豹。","chapter_id":"c-shiji-005-qin","source_id":"s-shiji-005-qin","source_term":"子"}],"source_assertion_id":"a-shiji005-040","interpretation_note":"以此受傳正文的明示近親主張配置局部家族；不合併跨篇候選身份、不補闕名世代，不表示遠祖世系已核實。分支字元不是長幼排行。","reviewer":"Codex（AI 代理）","parent_person_id":"rlv_clg_euu"},"id_aliases":["cbr-p000387"]}],"source_mention_summary":[{"source_id":"s-shiji-005-qin","work_id":"w-shiji","book_id":"b-shiji-005","chapter_id":"c-shiji-005-qin","mention_count":4,"mention_ids":["c-shiji-005-qin:m025-0218","c-shiji-005-qin:m025-0281","c-shiji-005-qin:m027-0007","c-shiji-005-qin:m028-0057"],"paragraph_ids":["c-shiji-005-qin:p025","c-shiji-005-qin:p027","c-shiji-005-qin:p028"],"passage_count":3},{"source_id":"s-shiji-039-jin","work_id":"w-shiji","book_id":"b-shiji-039","chapter_id":"c-shiji-039-jin","mention_count":2,"mention_ids":["c-shiji-039-jin:m042-0108","c-shiji-039-jin:m044-0048"],"paragraph_ids":["c-shiji-039-jin:p042","c-shiji-039-jin:p044"],"passage_count":2}],"most_mentioned_source_ids":["s-shiji-005-qin"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji005-040","subject_person_id":"rlv_clg_euu_A","predicate":"father","object_person_id":"rlv_clg_euu","status":"source_attested","evidence":[{"paragraph_id":"c-shiji-005-qin:p025","quote":"丕鄭子丕豹奔秦","chapter_id":"c-shiji-005-qin","source_id":"s-shiji-005-qin"}],"qualifiers":{"source_term":"子","historicity":"historical_tradition"},"interpretation_note":"本文明示關係