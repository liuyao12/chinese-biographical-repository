{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004736","identity_policy":"contextual_provisional","person_ids":["cbr-p004736"],"persons":[{"id":"cbr-p004736","label":"舜引古（魯仲連鄒陽列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"舜","mention_ids":["c-shiji-083-luzou:m022-0132"]}],"evidence":[{"mention_id":"c-shiji-083-luzou:m022-0132","chapter_id":"c-shiji-083-luzou","paragraph_id":"c-shiji-083-luzou:p022","quote":"舜"}]}],"source_mention_summary":[{"source_id":"s-shiji-083-luzou","work_id":"w-shiji","book_id":"b-shiji-083","chapter_id":"c-shiji-083-luzou","mention_count":1,"mention_ids":["c-shiji-083-luzou:m022-0132"],"paragraph_ids":["c-shiji-083-luzou:p022"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-083-luzou"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-083-luzou:m022-0132","start":132,"end":133,"surface":"舜","kind":"person","person_id":"cbr-p004736","status":"contextual_provisional","paragraph_id":"c-shiji-083-luzou:p022","chapter_id":"c-shiji-083-luzou"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji083-081","person_id":"cbr-p004736","scope":"same_chapter","chapter_ids":["c-shiji-083-luzou"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"按末段引古與太史公論分層保留原稱；伊管短稱未補姓名。墨子與前文墨翟於同一上書暫接，周文王與前文文王暫接。","surfaces":["舜"],"evidence":[{"paragraph_id":"c-shiji-083-luzou:p022","quote":"臣聞明月之珠，夜光之璧，以闇投人於道路，人無不按劍相眄者。何則？無因而至前也。蟠木根柢，輪囷離詭，而為萬乘器者。何則？以左右先為之容也。故無因至前，雖出隨侯之珠，夜光之璧，猶結怨而不見德。故有人先談，則以枯木朽株樹功而不忘。今夫天下布衣窮居之士，身在貧賤，雖蒙堯、舜之術，挾伊、管之辯，懷龍逢、比干之意，欲盡忠當世之君，而素無根柢之容，雖竭精思，欲開忠信，輔人主之治，則人主必有按劍相眄之跡，是使布衣不得為枯木朽株之資也。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-083-luzou:p022","text":"臣聞明月之珠，夜光之璧，以闇投人於道路，人無不按劍相眄者。何則？無因而至前也。蟠木根柢，輪囷離詭，而為萬乘器者。何則？以左右先為之容也。故無因至前，雖出隨侯之珠，夜光之璧，猶結怨而不見德。故有人先談，則以枯木朽株樹功而不忘。今夫天下布衣窮居之士，身在貧賤，雖蒙堯、舜之術，挾伊、管之辯，懷龍逢、比干之意，欲盡忠當世之君，而素無根柢之容，雖竭精思，欲開忠信，輔人主之治，則人主必有按劍相眄之跡，是使布衣不得為枯木朽株之資也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-083-luzou:m022-0000","start":0,"end":1,"surface":"臣","kind":"person","person_id":"cbr-p004689","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m022-0060","start":60,"end":62,"surface":"左右","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代保留，不補姓名。"},{"id":"c-shiji-083-luzou:m022-0116","start":116,"end":122,"surface":"布衣窮居之士","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代保留，不補姓名。"},{"id":"c-shiji-083-luzou:m022-0130","start":130,"end":131,"surface":"堯","kind":"person","person_id":"cbr-p004732","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m022-0132","start":132,"end":133,"surface":"舜","kind":"person","person_id":"cbr-p004736","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m022-0137","start":137,"end":138,"surface":"伊","kind":"person","person_id":"cbr-p004737","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m022-0139","start":139,"end":140,"surface":"管","kind":"person","person_id":"cbr-p004738","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m022-0144","start":144,"end":146,"surface":"龍逢","kind":"person","person_id":"cbr-p004739","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m022-0147","start":147,"end":149,"surface":"比干","kind":"person","person_id":"cbr-p004704","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m022-0155","start":155,"end":159,"surface":"當世之君","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代保留，不補姓名。"},{"id":"c-shiji-083-luzou:m022-0179","start":179,"end":181,"surface":"人主","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代保留，不補姓名。"},{"id":"c-shiji-083-luzou:m022-0185",