{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004846","identity_policy":"contextual_provisional","person_ids":["cbr-p004846"],"persons":[{"id":"cbr-p004846","label":"燕狗屠未名（刺客列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"狗屠","mention_ids":["c-shiji-086-cike:m025-0009","c-shiji-086-cike:m025-0027"]}],"evidence":[{"mention_id":"c-shiji-086-cike:m025-0009","chapter_id":"c-shiji-086-cike","paragraph_id":"c-shiji-086-cike:p025","quote":"狗屠"},{"mention_id":"c-shiji-086-cike:m025-0027","chapter_id":"c-shiji-086-cike","paragraph_id":"c-shiji-086-cike:p025","quote":"狗屠"}]}],"mentions":[{"id":"c-shiji-086-cike:m025-0009","start":9,"end":11,"surface":"狗屠","kind":"person","person_id":"cbr-p004846","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p025","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m025-0027","start":27,"end":29,"surface":"狗屠","kind":"person","person_id":"cbr-p004846","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p025","chapter_id":"c-shiji-086-cike"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji086-035","person_id":"cbr-p004846","scope":"same_chapter","chapter_ids":["c-shiji-086-cike"],"status":"contextual_provisional","rationale":"依荊軻入燕敘事及明示異稱暫接；慶卿、荊卿指荊軻，田光之光限第28至29段，丹限太子丹敘事。魯句踐不與其他句踐合併；狗屠、主人及被虜韓趙王保留未名。嵌套代詞仍待逐處核定。","reviewer":"Codex（AI 代理）","surfaces":["狗屠"],"evidence":[{"paragraph_id":"c-shiji-086-cike:p025","quote":"荊軻既至燕，愛燕之狗屠及善撃筑者髙漸離。荊軻嗜酒，日與狗屠及髙漸離飲於燕市，酒酣以往，髙漸離撃筑，荊軻和而歌於市中，相樂也，已而相泣，旁若無人者。荊軻雖游於酒人乎，然其爲人沈深好書；其所游諸侯，盡與其賢豪長者相結。其之燕，燕之處士田光先生亦善待之，知其非庸人也。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-086-cike:p025","text":"荊軻既至燕，愛燕之狗屠及善撃筑者髙漸離。荊軻嗜酒，日與狗屠及髙漸離飲於燕市，酒酣以往，髙漸離撃筑，荊軻和而歌於市中，相樂也，已而相泣，旁若無人者。荊軻雖游於酒人乎，然其爲人沈深好書；其所游諸侯，盡與其賢豪長者相結。其之燕，燕之處士田光先生亦善待之，知其非庸人也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id"