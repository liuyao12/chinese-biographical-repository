{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"gu5_ugq_r65","canonical_person_id":"gu5_ugq_r65","id_aliases":["cbr-p004877"],"identity_policy":"contextual_provisional","person_ids":["gu5_ugq_r65"],"persons":[{"id":"gu5_ugq_r65","label":"黃帝引古傳說（李斯列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"黃帝","mention_ids":["c-shiji-087-lisi:m003-0218"]}],"evidence":[{"mention_id":"c-shiji-087-lisi:m003-0218","chapter_id":"c-shiji-087-lisi","paragraph_id":"c-shiji-087-lisi:p003","quote":"黃帝"}],"id_aliases":["cbr-p004877"]}],"source_mention_summary":[{"source_id":"s-shiji-087-lisi","work_id":"w-shiji","book_id":"b-shiji-087","chapter_id":"c-shiji-087-lisi","mention_count":1,"mention_ids":["c-shiji-087-lisi:m003-0218"],"paragraph_ids":["c-shiji-087-lisi:p003"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-087-lisi"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-087-lisi:m003-0218","start":218,"end":220,"surface":"黃帝","kind":"person","person_id":"gu5_ugq_r65","status":"contextual_provisional","paragraph_id":"c-shiji-087-lisi:p003","chapter_id":"c-shiji-087-lisi"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji087-010","person_id":"gu5_ugq_r65","surfaces":["黃帝"],"scope":"same_chapter","chapter_ids":["c-shiji-087-lisi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-087-lisi:p003","quote":"至秦，會莊襄王卒，李斯乃求為秦相文信侯呂不韋舍人；不韋賢之，任以為郎。李斯因以得說，說秦王曰：「胥人者，去其幾也。成大功者，在因瑕釁而遂忍之。昔者秦穆公之霸，終不東并六國者，何也？諸侯尚眾，周德未衰，故五伯迭興，更尊周室。自秦孝公以來，周室卑微，諸侯相兼，關東為六國，秦之乘勝役諸侯，蓋六世矣。今諸侯服秦，譬若郡縣。夫以秦之彊，大王之賢，由灶上騷除，足以滅諸侯，成帝業，為天下一統，此萬世之一時也。今怠而不急就，諸侯復彊，相聚約從，雖有黃帝之賢，不能并也。」秦王乃拜斯為長史，聽其計，陰遣謀士齎持金玉以游說諸侯。諸侯名士可下以財者，厚遺結之；不肯者，利劍刺之。離其君臣之計，秦王乃使其良將隨其後。秦王拜斯為客卿。"}],"rationale":"依李斯入秦及諫逐客書局部承接暫接；辭師時秦王未定，與莊襄王卒後所說秦王分開候選，未按同稱全域合併。引古人物與黃帝傳說性分存，短稱斯限李斯敘事。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-087-lisi:p003","text":"至秦，會莊襄王卒，李斯乃求為秦相文信侯呂不韋舍人；不韋賢之，任以為郎。李斯因以得說，說秦王曰：「胥人者，去其幾也。成大功者，在因瑕釁而遂忍之。昔者秦穆公之霸，終不東并六國者，何也？諸侯尚眾，周德未衰，故五伯迭興，更尊周室。自秦孝公以來，周室卑微，諸侯相兼，關東為六國，秦之乘勝役諸侯，蓋六世矣。今諸侯服秦，譬若郡縣。夫以秦之彊，大王之賢，由灶上騷除，足以滅諸侯，成帝業，為天下一統，此萬世之一時也。今怠而不急就，諸侯復彊，相聚約從，雖有黃帝之賢，不能并也。」秦王乃拜斯為長史，聽其計，陰遣謀士齎持金玉以游說諸侯。諸侯名士可下以財者，厚遺結之；不肯者，利劍刺之。離其君臣之計，秦王乃使其良將隨其後。秦王拜斯為客卿。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-087-lisi:m003-0004","start":4,"end":7,"surface":"莊襄王","kind":"person","person_id":"0cu_hq2_9t8","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m003-0009","start":9,"end":11,"surface":"李斯","kind":"person","person_id":"5ok_joj_etv","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m003-0014","start":14,"end":22,"surface":"秦相文信侯呂不韋","kind":"person","person_id":"qlv_q6m_tgs","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m003-0025","start":25,"end":27,"surface":"不韋","kind":"person","person_id":"qlv_q6m_tgs","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m003-0035","start":35,"end":37,"surface":"李斯","kind":"person","person_id":"5ok_joj_etv","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m003-0043","start":43,"end":45,"surface":"秦王","kind":"person","person_id":"z0a_bdl_gn5","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m003-0073","start":73,"end":76,"surface":"秦穆公","kind":"person","person_id":"mrt_kzm_qze","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m003-0090","start":90,"end":92,"surface":"諸侯","kind":"unresolved","p