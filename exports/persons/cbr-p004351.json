{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004351","canonical_person_id":"xt3_8e7_hvi","id_aliases":["cbr-p004351"],"identity_policy":"contextual_provisional","person_ids":["xt3_8e7_hvi"],"persons":[{"id":"xt3_8e7_hvi","label":"說秦昭王者未名（孟嘗君列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"人或説","mention_ids":["c-shiji-075-mengchang:m006-0028"]}],"evidence":[{"mention_id":"c-shiji-075-mengchang:m006-0028","chapter_id":"c-shiji-075-mengchang","paragraph_id":"c-shiji-075-mengchang:p006","quote":"人或説"}],"id_aliases":["cbr-p004351"]}],"source_mention_summary":[{"source_id":"s-shiji-075-mengchang","work_id":"w-shiji","book_id":"b-shiji-075","chapter_id":"c-shiji-075-mengchang","mention_count":1,"mention_ids":["c-shiji-075-mengchang:m006-0028"],"paragraph_ids":["c-shiji-075-mengchang:p006"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-075-mengchang"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-075-mengchang:m006-0028","start":28,"end":31,"surface":"人或説","kind":"person","person_id":"xt3_8e7_hvi","status":"contextual_provisional","paragraph_id":"c-shiji-075-mengchang:p006","chapter_id":"c-shiji-075-mengchang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji075-022","person_id":"xt3_8e7_hvi","scope":"same_chapter","chapter_ids":["c-shiji-075-mengchang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"依入秦、返齊及食客敘事明示姓名與局部回指暫接。未名夜食客、蔽光者、狗盜鷄鳴兩客、幸姬及勸說毀者各存角色，不補姓名或全域連所有客稱；木土偶保持寓言。蘇代內嵌秦昭王王稱與外層孟嘗君君稱分辨，楚王割地與楚懷王得出暫分候選，不確證異人；田甲劫王與孟嘗君反謀指控分開，不把指控當史實。","surfaces":["人或説"],"evidence":[{"paragraph_id":"c-shiji-075-mengchang:p006","quote":"齊湣王二十五年，復卒使孟嘗君入秦，昭王即以孟嘗君爲秦相。人或説秦昭王曰：「孟嘗君賢，而又齊族也，今相秦，必先齊而後秦，秦其危矣。」於是秦昭王乃止。囚孟嘗君，謀欲殺之。孟嘗君使人抵昭王幸姬求解。幸姬曰：「妾願得君狐白裘。」此時孟嘗君有一狐白裘，直千金，天下無雙，入秦獻之昭王，更無他裘。孟嘗君患之，遍問客，莫能對。最下坐有能爲狗盜者，曰：「臣能得狐白裘。」乃夜爲狗，以入秦宮臧中，取所獻狐白裘至，以獻秦王幸姬。幸姬爲言昭王，昭王釋孟嘗君。孟嘗君得出，即馳去，更封傳，變名姓以出關。夜半至函谷關。秦昭王後悔出孟嘗君，求之已去，即使人馳傳逐之。孟嘗君至關，關法鷄鳴而出客，孟嘗君恐追至，客之居下坐者有能爲鷄鳴，而鷄齊鳴，遂發傳出。出如食頃，秦追果至關，已後孟嘗君出，乃還。始孟嘗君列此二人於賓客，賓客盡羞之，及孟嘗君有秦難，卒此二人拔之。自是之後，客皆服。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-075-mengchang:p006","text":"齊湣王二十五年，復卒使孟嘗君入秦，昭王即以孟嘗君爲秦相。人或説秦昭王曰：「孟嘗君賢，而又齊族也，今相秦，必先齊而後秦，秦其危矣。」於是秦昭王乃止。囚孟嘗君，謀欲殺之。孟嘗君使人抵昭王幸姬求解。幸姬曰：「妾願得君狐白裘。」此時孟嘗君有一狐白裘，直千金，天下無雙，入秦獻之昭王，更無他裘。孟嘗君患之，遍問客，莫能對。最下坐有能爲狗盜者，曰：「臣能得狐白裘。」乃夜爲狗，以入秦宮臧中，取所獻狐白裘至，以獻秦王幸姬。幸姬爲言昭王，昭王釋孟嘗君。孟嘗君得出，即馳去，更封傳，變名姓以出關。夜半至函谷關。秦昭王後悔出孟嘗君，求之已去，即使人馳傳逐之。孟嘗君至關，關法鷄鳴而出客，孟嘗君恐追至，客之居下坐者有能爲鷄鳴，而鷄齊鳴，遂發傳出。出如食頃，秦追果至關，已後孟嘗君出，乃還。始孟嘗君列此二人於賓客，賓客盡羞之，及孟嘗君有秦難，卒此二人拔之。自是之後，客皆服。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-075-mengchang:m006-0000","start":0,"end":3,"surface":"齊湣王","kind":"person","person_id":"u68_y0a_f8x","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m006-0011","start":11,"end":14,"surface":"孟嘗君","kind":"person","person_id":"7s4_7ac_lhn_AA","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m006-0017","start":17,"end":19,"surface":"昭王","kind":"person","person_id":"ajv_agq_es1","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m006-0021","start":21,"end":24,"surface":"孟嘗君","kind":"person","person_id":"7s4_7ac_lhn_AA","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m006-0028","start":28,"end":31,"surface":"人或説","kind":"person","person_id":"xt3_8e7_hvi","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m006-0031","start":31,"end":34,"surface":"秦昭王","kind":"person","person_id":"ajv_agq_es1","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m006-0037","start":37,"end":40,"surface":"孟嘗君","kind":"person","person_id":"7s4_7ac_lhn_AA","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m006-0044","start":44,"end":46,"surface":"齊族","kind":"unresolved","person_id":null,"status":"unresolved","note":"寓言木土偶、未名群體、族屬或未定指代，不當真人或補群體成員；二人需各按已定位客角色解讀，不將所有客稱接同一人。"},{"id":"c-shiji-075-mengchang:m006-0067","start":67,"end":70,"surface":"秦昭王","kind":"person","person_id":"ajv_agq_es1","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m006-0074","start":74,"end":77,"surface":"孟嘗君","kind":"person","person_id":"7s4_7ac_lhn_AA","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m006-0083","start":83,"end":86,"surface":"孟嘗君","kind":"person","person_id":"7s4_7ac_lhn_AA","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m006-0089","start":89,"end":91,"surface":"昭王","kind":"person","person_id":"ajv_agq_es1","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m006-0091","start":91,"end":93,"surface":"幸姬","kind":"person","person_id":"db9_3sk_h2i","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m006-0096","start":96,"end":98,"surface":"幸姬","kind":"person","person_id":"db9_3sk_h2i","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m006-0104","start":104,"end":105,"surface":"君","kind":"person","person_id":"7s4_7ac_lhn_AA","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m006-0112","start":112,"end":115,"surface":"孟嘗君","kind":"person","person_id":"7s4_7ac_lhn_AA","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m006-0134","start":134,"end":136,"surface":"昭王","kind":"person","person_id":"ajv_agq_es1","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m006-0142","start":142,"end":145,"surface":"孟嘗君","kind":"person","person_id":"7s4_7ac_lhn_AA","status":"contextual_provisional"},{"id":"c-shiji-075-