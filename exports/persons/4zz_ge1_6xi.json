ongshu-042-wanghong:line091","quote":"弘明敏有思致，既以民望所宗，造次必存禮法，凡動止施為，及書翰儀體，後人皆依倣之，謂為王太保家法。雖歷任藩輔，不營財利，薨亡之後，家無餘業。而輕率少威儀，性又褊隘，人忤意者，輒面加責辱。少時嘗摴蒲公城子野舍，及後當權，有人就弘求縣，辭訴頗切。此人嘗以蒲戲得罪，弘詰之曰：「君得錢會戲，何用祿為！」答曰：「不審公城子野何在？」弘默然。"},{"work_id":"w-songshu","book_id":"b-songshu-042","source_id":"s-songshu-042-wanghong","chapter_id":"c-songshu-042-wanghong","paragraph_id":"c-songshu-042-wanghong:line093","quote":"子錫嗣。少以宰相子，起家為員外散騎，歷清職，中書郎，太子左衞率，江夏內史。高自位遇。太尉江夏王義恭當朝，錫箕踞大坐，殆無推敬。卒官。子僧亮嗣。齊受禪，降爵為侯，食邑五百戶。弘少子僧達，別有傳。"}],"source_assertion_id":"a-songshu042-phase5-001","interpretation_note":"保存原文明示關係與稱謂；不補未知共同父母、婚配或出生年份。","reviewer":"Codex（AI 代理）"}}],"source_mention_summary":[{"source_id":"s-nanqishu-044-shenwenji-complete-ws1507959","work_id":"w-nanqishu","book_id":"b-nanqishu-044","chapter_id":"c-nanqishu-044-shenwenji-complete","raw_mention_count":1,"mention_ids":["c-nanqishu-044-shenwenji-complete:p004:m0116"],"paragraph_ids":["c-nanqishu-044-shenwenji-complete:p004"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-nanqishu-044-shenwenji-complete:p004:m0116","mention_ids":["c-nanqishu-044-shenwenji-complete:p004:m0116"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-nanqishu-044-shenwenji-complete-ws1507959"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-qi044-shenwenji-marriage","subject_person_id":"408_ce3_5d8_A","object_person_id":"4zz_ge1_6xi","predicate":"spouse","qualifiers":{"source_term":"妻王氏"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-044","chapter_id":"c-nanqishu-044-shenwenji-complete","source_id":"s-nanqishu-044-shenwenji-complete-ws1507959","paragraph_id":"c-nanqishu-044-shenwenji-complete:p004","quote":"　　晉平王休祐爲南徐州，帝問褚淵須幹事人爲上佐，淵舉文季。轉寧朔將軍、驃騎長史、南東海太守。休祐被殺，雖用薨禮，僚佐多不敢至。文季獨往省墓展哀。出爲臨海太守。元徽初，遷散騎常侍，領後軍將軍，轉祕書監。出爲吳興太守。文季飲酒至五斗，妻王氏，王錫女，飲酒亦至三斗。文季與對飲竟日，而視事不廢。","subject_person_mention_id":"c-nanqishu-044-shenwenji-complete:p004:m0026","object_person_mention_id":"c-nanqishu-044-shenwenji-complete:p004:m0116"}],"status":"source_attested","interpretation_note":"王氏在原文同文季對飲。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"a-qi044-wangshi-father","subject_person_id":"4zz_ge1_6xi","object_person_id":"7r6_k52_qji_ABAAAAAA","predicate":"father","qualifiers":{"source_term":"王錫女","lineage":"paternal"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-044","chapter_id":"c-nanqishu-044-shenwenji-complete","source_id":"s-nanqishu-044-shenwenji-complete-ws1507959","paragraph_id":"c-nanqishu-044-shenwenji-complete:p004","quote":"　　晉平王休祐爲南徐州，帝問褚淵須幹事人爲上佐，淵舉文季。轉寧朔將軍、驃騎長史、南東海太守。休祐被殺，雖用薨禮，僚佐多不敢至。文季獨往省墓展哀。出爲臨海太守。元徽初，遷散騎常侍，領後軍將軍，轉祕書監。出爲吳興太守。文季飲酒至五斗，妻王氏，王錫女，飲酒亦至三斗。文季與對飲竟日，而視事不廢。","subject_person_mention_id":"c-nanqishu-044-shenwenji-complete:p004:m0116","object_person_mention_id":"c-nanqishu-044-shenwenji-complete:p004:m0119"}],"status":"source_attested","interpretation_note":"在劉宋元徽初段落，由時序排除梁代王錫。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-044-shenwenji-complete:p004:m0116","start":116,"end":118,"surface":"王氏","kind":"person","person_id":"4zz_ge1_6xi","status":"contextual_provisional","paragraph_id":"c-nanqishu-044-shenwenji-complete: