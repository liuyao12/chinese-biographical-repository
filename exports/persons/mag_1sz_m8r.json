surfaces":["武丁"],"evidence":[{"paragraph_id":"c-shiji-084-qujia:p028","quote":"萬物變化兮，固無休息。斡流而遷兮，或推而還。形氣轉續兮，變化而嬗。沕穆無窮兮，胡可勝言！禍兮福所倚，福兮禍所伏；憂喜聚門兮，吉凶同域。彼吳彊大兮，夫差以敗；越棲會稽兮，句踐霸世。斯游遂成兮，卒被五刑；傅說胥靡兮，乃相武丁。夫禍之與福兮，何異糾纆。命不可說兮，孰知其極？水激則旱兮，矢激則遠。萬物回薄兮，振蕩相轉。雲蒸雨降兮，錯繆相紛。大專槃物兮，坱軋無垠。天不可與慮兮，道不可與謀。遲數有命兮，惡識其時？"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-084-qujia:p028","text":"萬物變化兮，固無休息。斡流而遷兮，或推而還。形氣轉續兮，變化而嬗。沕穆無窮兮，胡可勝言！禍兮福所倚，福兮禍所伏；憂喜聚門兮，吉凶同域。彼吳彊大兮，夫差以敗；越棲會稽兮，句踐霸世。斯游遂成兮，卒被五刑；傅說胥靡兮，乃相武丁。夫禍之與福兮，何異糾纆。命不可說兮，孰知其極？水激則旱兮，矢激則遠。萬物回薄兮，振蕩相轉。雲蒸雨降兮，錯繆相紛。大專槃物兮，坱軋無垠。天不可與慮兮，道不可與謀。遲數有命兮，惡識其時？","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m028-0073","start":73,"end":75,"surface":"夫差","kind":"person","person_id":"v6t_g69_7z5","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m028-0084","start":84,"end":86,"surface":"句踐","kind":"person","person_id":"drd_2tl_s7k","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m028-0089","start":89,"end":90,"surface":"斯","kind":"person","person_id":"8rc_l89_zwn","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m028-0100","start":100,"end":102,"surface":"傅說","kind":"person","person_id":"ls3_l6g_l7d","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m028-0108","start":108,"end":110,"surface":"武丁","kind":"person","person_id":"mag_1sz_m8r","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"}],"sources":[{"chapter_id":"c-shiji-084-qujia","work_id":"w-shiji","book_id":"b-shiji-084","source_id":"s-shiji-084-qujia","source":{"title":"史記／卷084","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷084","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷084&oldid=1568305","revision_id":1568305,"accessed_on":"2026-10-09","extent":"33段正文，屈原、懷沙、賈生及篇末評論；索隱述贊另層待收。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creat