_AA","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m031-0196","start":196,"end":198,"surface":"將渠","kind":"person","person_id":"x1n_vdt_l94","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m031-0199","start":199,"end":201,"surface":"燕王","kind":"person","person_id":"lt4_hpv_4ku_AA","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m031-0219","start":219,"end":220,"surface":"王","kind":"person","person_id":"lt4_hpv_4ku_AA","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m031-0225","start":225,"end":227,"surface":"將渠","kind":"person","person_id":"x1n_vdt_l94","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m031-0250","start":250,"end":252,"surface":"廉頗","kind":"person","person_id":"tfz_fnj_ejn","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m031-0256","start":256,"end":258,"surface":"栗腹","kind":"person","person_id":"fo2_the_x22","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m031-0261","start":261,"end":265,"surface":"［樂乘］","kind":"unresolved","person_id":null,"status":"unresolved","note":"數位校勘字樣，不當本句已核定人物／戰事證據。"},{"id":"c-shiji-034-yan:m031-0266","start":266,"end":268,"surface":"卿秦","kind":"person","person_id":"y4b_zoh_zh7","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m031-0268","start":268,"end":272,"surface":"（樂乘）","kind":"unresolved","person_id":null,"status":"unresolved","note":"數位校勘字樣，不當本句已核定人物／戰事證據。"},{"id":"c-shiji-034-yan:m031-0275","start":275,"end":277,"surface":"樂閒","kind":"person","person_id":"svc_81f_pkz","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m031-0280","start":280,"end":282,"surface":"廉頗","kind":"person","person_id":"tfz_fnj_ejn","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m031-0293","start":293,"end":295,"surface":"燕人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、未定稱呼、書名或數位疑讀；不補姓名、性別與成員。"},{"id":"c-shiji-034-yan:m031-0298","start":298,"end":300,"surface":"趙人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、未定稱呼、書名或數位疑讀；不補姓名、性別與成員。"},{"id":"c-shiji-034-yan:m031-0305","start":305,"end":307,"surface":"將渠","kind":"person","person_id":"x1n_vdt_l94","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m031-0312","start":312,"end":314,"surface":"將渠","kind":"person","person_id":"x1n_vdt_l94","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m031-0320","start":320,"end":322,"surface":"將渠","kind":"person","person_id":"x1n_vdt_l94","status":"contextual_provisional"}],"chapter_id":"c-shiji-034-yan","book_id":"b-shiji-034","work_id":"w-shiji","source_id":"s-shiji-034-yan"},{"id":"c-shiji-034-yan:p033","text":"燕見秦且滅六國，秦兵臨易水，禍且至燕。太子丹陰養壯士二十人，使荊軻獻督亢地圖於秦，因襲刺秦王。秦王覺，殺軻，使將軍王翦撃燕。二十九年，秦攻拔我薊，燕王亡，徙居遼東，斬丹以獻秦。三十年，秦滅魏。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-034-yan:m033-0005","start":5,"end":7,"surface":"六國","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、未定稱呼、書名或數位疑讀；不補姓名、性別與成員。"},{"id":"c-shiji-034-yan:m033-0019","start":19,"end":22,"surface":"太子丹","kind":"person","person_id":"e3o_2bk_lhm","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m033-0024","start":24,"end":29,"surface":"壯士二十人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、未定稱呼、書名或數位疑讀；不補姓名、性別與成員。"},{"id":"c-shiji-034-yan:m033-0031","start":31,"end":33,"surface":"荊軻","kind":"person","person_id":"b83_37f_n0v","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m033-0044","start":44,"end":46,"surface":"秦王","kind":"person","person_id":"ao3_0fy_d45_AAA","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m033-0047","start":47,"end":49,"surface":"秦王","kind":"person","person_id":"ao3_0fy_d45_AAA","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m033-0052","start":52,"end":53,"surface":"軻","kind":"person","person_id":"b83_37f_n0v","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m033-0055","start":55,"end":59,"surface":"將軍王翦","kind":"person","person_id":"gdj_k53_v1x","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m033-0073","start":73,"end":75,"surface":"燕王","kind":"person","person_id":"lt4_hpv_4ku_AA","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m033-0083","start":83,"end":84,"surface":"丹","kind":"person","person_id":"e3o_2bk_lhm","status":"contextual_provisional"}],"chapter_id":"c-shiji-034-yan","book_id":"b-shiji-034","work_id":"w-shiji","source_id":"s-shiji-034-yan"},{"id":"c-shiji-034-yan:p034","text":"三十三年，秦拔遼東，虜燕王喜，卒滅燕。是歳，秦將王賁亦虜代王嘉。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-034-yan:m034-0011","start":11,"end":14,"surface":"燕王喜","kind":"person","person_id":"lt4_hpv_4ku_AA","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m034-0022","start":22,"end":26,"surface":"秦將王賁","kind":"person","person_id":"k7i_c3h_ssl","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m034-0028","start":28,"end":31,"surface":"代王嘉","kind":"person","person_id":"237_cbp_w2w","status":"contextual_provisional"}],"chapter_id":"c-shiji-034-yan","book_id":"b-shiji-034","work_id":"w-shiji","source_id":"s-shiji-034-yan"},{"id":"c-shiji-080-leyi:p015","text":"樂閒居燕三十餘年，燕王喜用其相栗腹之計，欲攻趙，而問昌國君樂閒。樂閒曰：「趙，四戰之國也，其民習兵，伐之不可。」燕王不聽，遂伐趙。趙使廉頗擊之，大破栗腹之軍於鄗，禽栗腹、樂乘。樂乘者，樂閒之宗也。於是樂閒奔趙，趙遂圍燕。燕重割地以與趙和，趙乃解而去。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-080-leyi:m015-0000","start":0,"end":2,"surface":"樂閒","kind":"person","person_id":"idh_bo6_4kq_A","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m015-0009","start":9,"end":12,"surface":"燕王喜","kind":"person","person_id":"usu_jat_0ky","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m015-0015","start":15,"end":17,"surface":"栗腹","kind":"person","person_id":"o3v_ms0_idw","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m015-0026","start":26,"end":31,"surface":"昌國君樂閒","kind":"person","person_id":"idh_bo6_4kq_A","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m015-0032","start":32,"end":34,"surface":"樂閒","kind":"person","person_id":"idh_bo6_4kq_A","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m015-0056","start":56,"end":58,"surface":"燕王","kind":"person","person_id":"usu_jat_0ky","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m015-0067","start":67,"end":69,"surface":"廉頗","kind":"person","person_id":"gt7_y57_atj","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m015-0074","start":74,"end":76,"surface":"栗腹","kind":"person","person_id":"o3v_ms0_idw","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m015-0082","start":82,"end":84,"surface":"栗腹","kind":"person","person_id":"o3v_ms0_idw","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m015-0085","start":85,"end":87,"surface":"樂乘","kind":"person","person_id":"9t6_8nc_nuo","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m015-0088","start":88,"end":90,"surface":"樂乘","kind":"person","person_id":"9t6_8nc_nuo","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m015-0092","start":92,"end":94,"surface":"樂閒","kind":"person","person_id":"idh_bo6_4kq_A","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m015-0100","start":100,"end":102,"surface":"樂閒","kind":"person","person_id":"idh_bo6_4kq_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-080-leyi","book_id":"b-shiji-080","work_id":"w-shiji","source_id":"s-shiji-080-leyi"},{"id":"c-shiji-080-leyi:p016","text":"燕王恨不用樂閒，樂閒既在趙，乃遺樂閒書曰：「紂之時，箕子不用，犯諫不怠，以冀其聽；商容不達，身祇辱焉，以冀其變。及民志不入，獄囚自出，然後二子退隱。故紂負桀暴之累，二子不失忠聖之名。何者？其憂患之盡矣。今寡人雖愚，不若紂之暴也；燕民雖亂，不若殷民之甚也。室有語，不相盡，以告鄰里。二者，寡人不為君取也。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-080-leyi:m016-0000","start":0,"end":2,"surface":"燕王","kind":"person","person_id":"usu_jat_0ky","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m016-0005","start":5,"end":7,"surface":"樂閒","kind":"person","person_id":"idh_bo6_4kq_