0-leyi:m016-0143","start":143,"end":145,"surface":"寡人","kind":"person","person_id":"usu_jat_0ky","status":"contextual_provisional","paragraph_id":"c-shiji-080-leyi:p016","chapter_id":"c-shiji-080-leyi"}],"relations":[{"id":"a-shiji034-020","subject_person_id":"lt4_hpv_4ku_AA","predicate":"father","object_person_id":"lt4_hpv_4ku_A","status":"source_attested","evidence":[{"chapter_id":"c-shiji-034-yan","source_id":"s-shiji-034-yan","paragraph_id":"c-shiji-034-yan:p030","quote":"孝王元年，秦圍邯鄲者解去。三年卒，子今王喜立。"}],"qualifiers":{"source_term":"子今王喜","historicity":"historical_tradition"},"interpretation_note":"保存本篇明示子、其女、婦、夫人及祖先說；九世不補闕名或直接父親，未見子字的繼位不自動推父子。太子平／燕昭王身份與攻燕年代尚待覆核。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji034-034","person_id":"lt4_hpv_4ku_AA","title":"今王","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-034-yan","source_id":"s-shiji-034-yan","paragraph_id":"c-shiji-034-yan:p030","quote":"孝王元年，秦圍邯鄲者解去。三年卒，子今王喜立。"}],"attestations":[{"id":"th-shiji034-034:a001","paragraph_id":"c-shiji-034-yan:p030","start":18,"end":20,"surface":"今王","person_mention_id":"c-shiji-034-yan:m030-0018","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"今王是本文對喜的當時稱呼，不改成諡號或據此推初任時日。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji034-048","person_id":"lt4_hpv_4ku_AA","surfaces":["今王喜","燕王","燕王喜","王"],"scope":"cross_chapter","chapter_ids":["c-shiji-006-shihuang","c-shiji-034-yan"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-006-shihuang:p019","quote":"二十五年，大興兵，使王賁將，攻燕遼東，得燕王喜。還攻代，虜代王嘉。王翦遂定荊江南地；降越君，置會稽郡。五月，天下大酺。"},{"paragraph_id":"c-shiji-034-yan:p030","quote":"孝王元年，秦圍邯鄲者解去。三年卒，子今王喜立。"},{"paragraph_id":"c-shiji-034-yan:p031","quote":"今王喜四年，秦昭王卒。燕王命相栗腹約歡趙，以五百金爲趙王酒。還報燕王曰：「趙王壯者皆死長平，其孤未壯，可伐也。」王召昌國君樂閒問之。對曰：「趙四戰之國，其民習兵，不可伐。」王曰：「吾以五而伐一。」對曰：「不可。」燕王怒，群臣皆以爲可。卒起二軍，車二千乘，栗腹將而攻鄗，卿秦攻代。唯獨大夫將渠謂燕王曰：「與人通關約交，以五百金飲人之王，使者報而反攻之，不祥，兵無成功。」燕王不聽，自將偏軍隨之。將渠引燕王綬止之曰：「王必無自往，往無成功。」王蹵之以足。將渠泣曰：「臣非以自爲，爲王也！」燕軍至宋子，趙使廉頗將，撃破栗腹於鄗。［樂乘］破卿秦（樂乘）於代。樂閒奔趙。廉頗逐之五百餘里，圍其國。燕人請和，趙人不許，必令將渠處和。燕相將渠以處和。趙聽將渠，解燕圍。"},{"paragraph_id":"c-shiji-034-yan:p033","quote":"燕見秦且滅六國，秦兵臨易水，禍且至燕。太子丹陰養壯士二十人，使荊軻獻督亢地圖於秦，因襲刺秦王。秦王覺，殺軻，使將軍王翦撃燕。二十九年，秦攻拔我薊，燕王亡，徙居遼東，斬丹以獻秦。三十年，秦滅魏。"},{"paragraph_id":"c-shiji-034-yan:p034","quote":"三十三年，秦拔遼東，虜燕王喜，卒滅燕。是歳，秦將王賁亦虜代王嘉。"}],"rationale":"依周初封建、燕君世系、割地救燕、讓國及秦滅諸國的具體語境暫定異稱。繼位不自動證父子；同爵者分國別與前後世代。太子平／燕昭王依本篇明示，不表示年代及世系已校定。作君奭為書名，君奭不説之君奭才暫解召公稱呼。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji080-022","person_id":"usu_jat_0ky","scope":"same_chapter","chapter_ids":["c-shiji-080-leyi"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["寡人","燕王","燕王喜"],"evidence":[{"paragraph_id":"c-shiji-080-leyi:p015","quote":"樂閒居燕三十餘年，燕王喜用其相栗腹之計，欲攻趙，而問昌國君樂閒。樂閒曰：「趙，四戰之國也，其民習兵，伐之不可。」燕王不聽，遂伐趙。趙使廉頗擊之，大破栗腹之軍於鄗，禽栗腹、樂乘。樂乘者，樂閒之宗也。於是樂閒奔趙，趙遂圍燕。燕重割地以與趙和，趙乃解而去。"},{"paragraph_id":"c-shiji-080-leyi:p016","quote":"燕王恨不用樂閒，樂閒既在趙，乃遺樂閒書曰：「紂之時，箕子不用，犯諫不怠，以冀其聽；商容不達，身祇辱焉，以冀其變。及民志不入，獄囚自出，然後二子退隱。故紂負桀暴之累，二子不失忠聖之名。何者？其憂患之盡矣。今寡人雖愚，不若紂之暴也；燕民雖亂，不若殷民之甚也。室有語，不相盡，以告鄰里。二者，寡人不為君取也。」"}],"rationale":"樂閒明示為樂毅子，樂叔明示為孫，不補闕代父親；樂乘為樂閒宗不補兄弟。燕王喜來書及趙襄王君序各限本段，曹相國未見名字不回填。河上丈人至蓋公師承不作父子。依本篇明示姓名、君序與來書答書範圍暫接；燕惠王來書寡人指惠王、將軍指樂毅，樂毅答書先王指昭王、足下君王指惠王。伍子胥引古首吳王指闔閭，後吳王在夫差賜鴟夷後指夫差。父兄與群臣不補具體親屬，王齊為反間假說不作授王爵。"}],"equivalence_decisions":[{"id":"eq-shiji080-xi","person_ids":["lt4_hpv_4ku_AA","usu_jat_0ky"],"canonical_person_id":"lt4_hpv_4ku_AA","scope":"cross_chapter","chapter_ids":["c-shiji-034-yan","c-shiji-080-leyi"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-034-yan","source_id":"s-shiji-034-yan","paragraph_id":"c-shiji-034-yan:p031","quote":"今王喜四年，秦昭王卒。燕王命相栗腹約歡趙，以五百金爲趙王酒。還報燕王曰：「趙王壯者皆死長平，其孤未壯，可伐也。」王召昌國君樂閒問之。對曰：「趙四戰之國，其民習兵，不可伐。」王曰：「吾以五而伐一。」對曰：「不可。」燕王怒，群臣皆以爲可。卒起二軍，車二千乘，栗腹將而攻鄗，卿秦