{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p001992","identity_policy":"contextual_provisional","person_ids":["cbr-p001992"],"persons":[{"id":"cbr-p001992","label":"周厲王（楚篇候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"周厲王","mention_ids":["c-shiji-040-chu:m005-0106"]},{"surface":"厲王","mention_ids":["c-shiji-040-chu:m007-0012","c-shiji-040-chu:m007-0015"]}],"evidence":[{"mention_id":"c-shiji-040-chu:m005-0106","chapter_id":"c-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p005","quote":"周厲王"},{"mention_id":"c-shiji-040-chu:m007-0012","chapter_id":"c-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p007","quote":"厲王"},{"mention_id":"c-shiji-040-chu:m007-0015","chapter_id":"c-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p007","quote":"厲王"}]}],"mentions":[{"id":"c-shiji-040-chu:m005-0106","start":106,"end":109,"surface":"周厲王","kind":"person","person_id":"cbr-p001992","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p005","chapter_id":"c-shiji-040-chu"},{"id":"c-shiji-040-chu:m007-0012","start":12,"end":14,"surface":"厲王","kind":"person","person_id":"cbr-p001992","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p007","chapter_id":"c-shiji-040-chu"},{"id":"c-shiji-040-chu:m007-0015","start":15,"end":17,"surface":"厲王","kind":"person","person_id":"cbr-p001992","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p007","chapter_id":"c-shiji-040-chu"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji040-116","person_id":"cbr-p001992","surfaces":["厲王","周厲王"],"scope":"same_chapter","chapter_ids":["c-shiji-040-chu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-040-chu:p005","quote":"熊渠生子三年。當周夷王之時，王室微，諸侯或不朝，相伐。熊渠甚得江漢閒民和，乃興兵伐庸、楊蠆，至于鄂。熊渠曰：「我蠻夷也，不與中國之號諡。」乃立其長子康爲句亶王，中子紅爲鄂王，少子執疵爲越章王，皆在江上楚蠻之地。及周厲王之時，暴虐，熊渠畏其伐楚，亦去其王。"},{"paragraph_id":"c-shiji-040-chu:p007","quote":"熊勇六年，而周人作亂，攻厲王，厲王出奔彘。熊勇十年，卒，弟熊嚴爲後。"}],"rationale":"本篇具名角色先保存候選；尚未與他篇同名或同稱人物完成事件、世系與版本比對，不作確定不同人或確定同人的結論。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-040-chu:p005","text":"熊渠生子三年。當周夷王之時，王室微，諸侯或不朝，相伐。熊渠甚得江漢閒民和，乃興兵伐庸、楊蠆，至于鄂。熊渠曰：「我蠻夷也，不與中國之號諡。」乃立其長子康爲句亶王，中子紅爲鄂王，少子執疵爲越章王，皆在江上楚蠻之地。及周厲王之時，暴虐，熊渠畏其伐楚，亦去其王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m005-0000","start":0,"end":2,"surface":"熊渠","kind":"person","person_id":"cbr-p001862","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m005-0008","start":8,"end":11,"surface":"周夷王","kind":"person","person_id":"cbr-p001991","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m005-0027","start":27,"end":29,"surface":"熊渠","kind":"person","person_id":"cbr-p001862","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m005-0043","start":43,"end":45,"surface":"楊蠆","kind":"unresolved","person_id":null,"status":"unresolved","note":"伐庸、楊蠆的對象名稱尚待地名／人名與版本核對，不補人物。"},{"id":"c-shiji-040-chu:m005-0050","start":50,"end":52,"surface":"熊渠","kind":"person","person_id":"cbr-p001862","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m005-0072","start":72,"end":75,"surface":"長子康","kind":"person","person_id":"cbr-p001863","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m005-0076","start":76,"end":79,"surface":"句亶王","kind":"person","person_id":"cbr-p001863","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m005-0080","start":80,"end":83,"surface":"中子紅","kind":"person","person_id":"cbr-p001864","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m005-0084","start":84,"end":86,"surface":"鄂王","kind":"person","person_id":"cbr-p001864","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m005-0089","start":89,"end":91,"surface":"執疵","kind":"person","person_id":"cbr-p001865","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m005-0092","start":92,"end":95,"surface":"越章王","kind":"person"