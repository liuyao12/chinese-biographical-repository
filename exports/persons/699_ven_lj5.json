count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-095-fankuang:m014-0023","start":23,"end":25,"surface":"呂祿","kind":"person","person_id":"699_ven_lj5","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p014","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:m014-0039","start":39,"end":41,"surface":"呂祿","kind":"person","person_id":"699_ven_lj5","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p014","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:m014-0073","start":73,"end":75,"surface":"呂祿","kind":"person","person_id":"699_ven_lj5","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p014","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:m014-0076","start":76,"end":78,"surface":"呂祿","kind":"person","person_id":"699_ven_lj5","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p014","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:m032-0027","start":27,"end":29,"surface":"呂祿","kind":"person","person_id":"699_ven_lj5","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p032","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:m032-0068","start":68,"end":70,"surface":"呂祿","kind":"person","person_id":"699_ven_lj5","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p032","chapter_id":"c-shiji-095-fankuang"}],"relations":[],"title_holdings":[{"id":"th-shiji095-046","person_id":"699_ven_lj5","title":"將軍","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-095-fankuang","source_id":"s-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p014","quote":"商事孝惠、高后時，商病，不治。其子寄，字況，與呂祿善。及高后崩，大臣欲誅諸呂，呂祿為將軍，軍於北軍，太尉勃不得入北軍，於是乃使人劫酈商，令其子況紿呂祿，呂祿信之，故與出游，而太尉勃乃得入據北軍，遂誅諸呂。是歲商卒，謚為景侯。子寄代侯。天下稱酈況賣交也。"}],"attestations":[{"id":"th-shiji095-046:a001","paragraph_id":"c-shiji-095-fankuang:p014","start":42,"end":44,"surface":"將軍","person_mention_id":"c-shiji-095-fankuang:m014-0039","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"原文實授、敘事用稱及諡稱分存；未明示時任期起訖未知。爵號用字不擅自補足，單稱侯不自動展開爵邑名；死亡、被捕、罷兵不自動作所有官爵終點。欲拜李必駱甲為騎將未作實授，左右校尉據實際令授。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji095-065","person_id":"699_ven_lj5","scope":"same_chapter","chapter_ids":["c-shiji-095-fankuang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["呂祿"],"evidence":[{"paragraph_id":"c-shiji-095-fankuang:p014","quote":"商事孝惠、高后時，商病，不治。其子寄，字況，與呂祿善。及高后崩，大臣欲誅諸呂，呂祿為將軍，軍於北軍，太尉勃不得入北軍，於是乃使人劫酈商，令其子況紿呂祿，呂祿信之，故與出游，而太尉勃乃得入據北軍，遂誅諸呂。是歲商卒，謚為景侯。子寄代侯。天下稱酈況賣交也。"},{"paragraph_id":"c-shiji-095-fankuang:p032","quote":"嬰自破布歸，高帝崩，嬰以列侯事孝惠帝及呂太后。太后崩，呂祿等以趙王自置為將軍，軍長安，為亂。齊哀王聞之，舉兵西，且入誅不當為王者。上將軍呂祿等聞之，乃遣嬰為大將，將軍往擊之。嬰行至滎陽，乃與絳侯等謀，因屯兵滎陽，風齊王以誅呂氏事，齊兵止不前。絳侯等既誅諸呂，齊王罷兵歸，嬰亦罷兵自滎陽歸，與絳侯、陳平共立代王為孝文皇帝。孝文皇帝於是益封嬰三千戶，賜黃金千斤，拜為太尉。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定異稱。酈寄字況據第14段；夏侯嬰的嬰限定第16至21段，灌嬰限定第22至33段，桓嬰另人。第6與20、28段楚王信和反韓王信分人；未詳名王侯不補名。同名跨篇同指另待逐項證據。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-095-fankuang:p014","text":"商事孝惠、高后時，商病，不治。其子寄，字況，與呂祿善。及高后崩，大臣欲誅諸呂，呂祿為將軍，軍於北軍，太尉勃不得入北軍，於是乃使人劫酈商，令其子況紿呂祿，呂祿信之，故與出游，而太尉勃乃得入據北軍，遂誅諸呂。是歲商卒，謚為景侯。子寄代侯。天下稱酈況賣交也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m014-0000","start":0,"end":1,"surface