table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-043-wangcheng:p003","text":"少曆顯位，累遷成都王穎從事中郎。穎嬖豎孟玖譖殺陸機兄弟，天下切齒。澄發玖私奸，勸穎殺玖，穎乃誅之，士庶莫不稱善。及穎敗，東海王越請為司空長史。以迎大駕勳，封南鄉侯。遷建威將軍、雍州刺史，不之職。時王敦、謝鯤、庾敳、阮修皆為衍所親善，號為四友，而亦與澄狎，又有光逸、胡毋輔之等亦豫焉。酣宴縱誕，窮歡極娛。","text_layer":"received_chapter","mentions":[{"id":"c-jinshu-043-wangcheng:p003:m0007","kind":"person","start":7,"end":11,"surface":"成都王穎","person_id":"e81_f09_000","status":"contextual_provisional","resolution_note":"依完整敘事角色判讀，原字保留，AI暫定。"},{"id":"c-jinshu-043-wangcheng:p003:m0016","kind":"person","start":16,"end":17,"surface":"穎","person_id":"e81_f09_000","status":"contextual_provisional","resolution_note":"依完整敘事角色判讀，原字保留，AI暫定。"},{"id":"c-jinshu-043-wangcheng:p003:m0019","kind":"person","start":19,"end":21,"surface":"孟玖","person_id":"qo1_13b_fj9","status":"contextual_provisional","resolution_note":"依完整敘事角色判讀，原字保留，AI暫定。"},{"id":"c-jinshu-043-wangcheng:p003:m0023","kind":"person","start":23,"end":25,"surface":"陸機","person_id":"69h_uhy_hta","status":"contextual_provisional","resolution_note":"依完整敘事角色判讀，原字保留，AI暫定。"},{"id":"c-jinshu-043-wangcheng:p003:m0025","kind":"unresolved","start":25,"end":27,"surface":"兄弟","person_id":null,"status":"unresolved","resolution_note":"陸機及陸雲群稱，非一人。"},{"id":"c-jinshu-043-wangcheng:p003:m0033","kind":"person","start":33,"end":34,"surface":"澄","person_id":"ehx_cqg_nfx_BB","status":"contextual_provisional","resolution_note":"依完整敘事角色判讀，原字保留，AI暫定。"},{"id":"c-jinshu-043-wangcheng:p003:m0035","kind":"person","start":35,"end":36,"surface":"玖","person_id":"qo1_13b_fj9","status":"contextual_provisional","resolution_note":"依完整敘事角色判讀，原字保留，AI暫定。"},{"id":"c-jinshu-043-wangcheng:p003:m0040","kind":"person","start":40,"end":41,"surface":"穎","person_id":"e81_f09_000","status":"contextual_provisional","resolution_note":"依完整敘事角色判讀，原字保留，AI暫定。"},{"id":"c-jinshu-043-wangcheng:p003:m0042","kin