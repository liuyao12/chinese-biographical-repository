ttested","evidence":[{"chapter_id":"c-shiji-102-zhangfeng","source_id":"s-shiji-102-zhangfeng","paragraph_id":"c-shiji-102-zhangfeng:p009","quote":"王生者，善爲黃老言，處士也。嘗召居廷中，三公九卿盡會立，王生老人，曰「吾韤解」，顧謂張廷尉：「爲我結韤！」釋之跪而結之。既已，人或謂王生曰：「獨柰何廷辱張廷尉，使跪結韤？」王生曰：「吾老且賤，自度終無益於張廷尉。張廷尉方今天下名臣，吾故聊辱廷尉，使跪結韤，欲以重之。」諸公聞之，賢王生而重張廷尉。"}],"attestations":[{"id":"th-shiji102-019:a001","paragraph_id":"c-shiji-102-zhangfeng:p009","start":10,"end":12,"surface":"處士","person_mention_id":"c-shiji-102-zhangfeng:m009-0000","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授官與用稱分存，未以後任或死亡推終點。官（卒）［率］將保留校勘符號，不擇定官名。嗇夫上林令任命諫止，不記已任。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji102-014","person_id":"7st_ix6_uvb","surfaces":["王生"],"scope":"same_chapter","chapter_ids":["c-shiji-102-zhangfeng"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-102-zhangfeng:p008","quote":"後文帝崩，景帝立，釋之恐，稱病。欲免去，懼大誅至；欲見謝，則未知何如。用王生計，卒見謝，景帝不過也。"},{"paragraph_id":"c-shiji-102-zhangfeng:p009","quote":"王生者，善爲黃老言，處士也。嘗召居廷中，三公九卿盡會立，王生老人，曰「吾韤解」，顧謂張廷尉：「爲我結韤！」釋之跪而結之。既已，人或謂王生曰：「獨柰何廷辱張廷尉，使跪結韤？」王生曰：「吾老且賤，自度終無益於張廷尉。張廷尉方今天下名臣，吾故聊辱廷尉，使跪結韤，欲以重之。」諸公聞之，賢王生而重張廷尉。"}],"rationale":"按本篇姓名、稱號及敘事承接逐處判讀；尚未作同名跨篇合併，身份與官稱回指待覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-102-zhangfeng:p008","text":"後文帝崩，景帝立，釋之恐，稱病。欲免去，懼大誅至；欲見謝，則未知何如。用王生計，卒見謝，景帝不過也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-102-zhangfeng:m008-0001","start":1,"end":3,"surface":"文帝","kind":"person","person_id":"065_z0k_4dc","status":"contextual_provisional"},{"id":"c-shiji-102-zhangfeng:m008-0005","start":5,"end":7,"surface":"景帝","kind":"person","person_id":"gys_oka_b4w","status":"contextual_provisional"},{"id"