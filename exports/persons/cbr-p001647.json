00"],"paragraph_ids":["c-shiji-038-song:p034","c-shiji-038-song:p035"],"passage_count":2}],"most_mentioned_source_ids":["s-shiji-038-song"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-038-song:m034-0135","start":135,"end":139,"surface":"公子御說","kind":"person","person_id":"cbr-p001647","status":"contextual_provisional","paragraph_id":"c-shiji-038-song:p034","chapter_id":"c-shiji-038-song"},{"id":"c-shiji-038-song:m034-0178","start":178,"end":180,"surface":"御說","kind":"person","person_id":"cbr-p001647","status":"contextual_provisional","paragraph_id":"c-shiji-038-song:p034","chapter_id":"c-shiji-038-song"},{"id":"c-shiji-038-song:m034-0183","start":183,"end":185,"surface":"桓公","kind":"person","person_id":"cbr-p001647","status":"contextual_provisional","paragraph_id":"c-shiji-038-song:p034","chapter_id":"c-shiji-038-song"},{"id":"c-shiji-038-song:m035-0000","start":0,"end":2,"surface":"桓公","kind":"person","person_id":"cbr-p001647","status":"contextual_provisional","paragraph_id":"c-shiji-038-song:p035","chapter_id":"c-shiji-038-song"},{"id":"c-shiji-038-song:m035-0051","start":51,"end":53,"surface":"桓公","kind":"person","person_id":"cbr-p001647","status":"contextual_provisional","paragraph_id":"c-shiji-038-song:p035","chapter_id":"c-shiji-038-song"},{"id":"c-shiji-038-song:m035-0066","start":66,"end":68,"surface":"桓公","kind":"person","person_id":"cbr-p001647","status":"contextual_provisional","paragraph_id":"c-shiji-038-song:p035","chapter_id":"c-shiji-038-song"},{"id":"c-shiji-038-song:m035-0083","start":83,"end":85,"surface":"桓公","kind":"person","person_id":"cbr-p001647","status":"contextual_provisional","paragraph_id":"c-shiji-038-song:p035","chapter_id":"c-shiji-038-song"},{"id":"c-shiji-038-song:m035-0100","start":100,"end":102,"surface":"桓公","kind":"person","person_id":"cbr-p001647","status":"contextual_provisional","paragraph_id":"c-shiji-038-song:p035","chapter_id":"c-shiji-038-song"}],"relations":[{"id":"a-shiji038-026","subject_person_id":"cbr-p001647","predicate":"brother","object_person_id":"cbr-p001641","status":"source_attested","evidence":[{"chapter_id":"c-shiji-038-song","source_id":"s-shiji-038-song","paragraph_id":"c-shiji-038-song:p034","quote":"十年夏，宋伐魯，戰於乘丘，魯生虜宋南宮萬。宋人請萬，萬歸宋。十一年秋，湣公與南宮萬獵，因博爭行，湣公怒，辱之，曰：「始吾敬若；今若，魯虜也。」萬有力，病此言，遂以局殺湣公于蒙澤。大夫仇牧聞之，以兵造公門。萬搏牧，牧齒著門闔死。因殺太宰華督，乃更立公子游爲君。諸公子奔蕭，公子御說奔亳。萬弟南宮牛將兵圍亳。冬，蕭及宋之諸公子共擊殺南宮牛，弒宋新君游而立湣公弟御說，是爲桓公。宋萬奔陳。宋人請以賂陳。陳人使婦人飲之醇酒，以革裹之，歸宋。宋人醢萬也。"}],"qualifiers":{"source_term":"湣公弟御說","historicity":"historical_tradition"},"interpretation_note":"保存本篇明示父、子、兄弟、夫人及曾庶孫說；不由繼位補父子，不補母名、共父母或闕代。來源主張與確證史實分開。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji038-028","subject_person_id":"cbr-p001649","predicate":"spouse","object_person_id":"cbr-p001647","status":"source_attested","evidence":[{"chapter_id":"c-shiji-038-song","source_id":"s-shiji-038-song","paragraph_id":"c-shiji-038-song:p035","quote":"桓公二年，諸矦伐宋，至郊而去。三年，齊桓公始霸。二十三年，迎衛公子燬於齊，立之，是爲衛文公。文公女弟爲桓公夫人。秦穆公即位。三十年，桓公病，太子茲甫讓其庶兄目夷爲嗣。桓公義太子意，竟不聽。三十一年春，桓公卒，太子茲甫立，是爲襄公。以其庶兄目夷爲相。未葬，而齊桓公會諸矦于葵丘，襄公往會。"}],"qualifiers":{"source_term":"爲桓公夫人","historicity":"historical_tradition"},"interpretation_note":"保存本篇明示父、子、兄弟、夫人及曾庶孫說；不由繼位補父子，不補母名、共父母或闕代。來源主張與確證史實分開。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji038-019","person_id":"cbr-p001647","title":"桓公","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-038-song","source_id":"s-shiji-038-song","paragraph_id":"c-shiji-038-song:p034","quote":"十年夏，宋伐魯，戰於乘丘，魯生虜宋南宮萬。宋人請萬，萬歸宋。十一年秋，湣公與南宮萬獵，因博爭行，湣公怒，辱之，曰：「始吾敬若；今若，魯虜也。」萬有力，病此言，遂以局殺湣公于蒙澤。大夫仇牧聞之，以兵造公門。萬搏牧，牧齒著門闔死。因殺太宰華督，乃更立公子游爲君。諸公子奔蕭，公子御說奔亳。萬弟南宮牛將兵圍亳。冬，蕭及宋之諸公子共擊殺南宮牛，弒宋新君游而立湣公弟御說，是爲桓公。宋萬奔陳。宋人請以賂陳。陳人使婦人飲之醇酒，以革裹之，歸宋。宋人醢萬也。"}],"attestations":[{"id":"th-shiji038-019:a001","paragraph_id":"c-shiji-038-song:p034","start":183,"end":185,"surface":"桓公","person_mention_id":"c-s