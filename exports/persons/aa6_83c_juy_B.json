urface":"玄","kind":"person","person_id":"r3n_se4_89p","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p003:m0025","start":25,"end":26,"surface":"玄","kind":"person","person_id":"r3n_se4_89p","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p003:m0046","start":46,"end":47,"surface":"安","kind":"person","person_id":"aa6_83c_juy_B","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p003:m0051","start":51,"end":53,"surface":"支遁","kind":"person","person_id":"qqe_pfr_n9v","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p003:m0061","start":61,"end":63,"surface":"其母","kind":"person","person_id":"fog_r7x_1uh","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p003:m0063","start":63,"end":65,"surface":"王氏","kind":"person","person_id":"fog_r7x_1uh","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p003:m0071","start":71,"end":72,"surface":"安","kind":"person","person_id":"aa6_83c_juy_B","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p003:m0079","start":79,"end":81,"surface":"王氏","kind":"person","person_id":"fog_r7x_1uh","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p003:m0086","start":86,"end":88,"surface":"新婦","kind":"person","person_id":"fog_r7x_1uh","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p003:m0099","start":99,"end":101,"surface":"此兒","kind":"person","person_id":"aa6_83c_juy_AA","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p003:m0107","start":107,"end":108,"surface":"朗","kind":"person","person_id":"aa6_83c_juy_AA","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p003:m0110","start":110,"end":111,"surface":"安","kind":"person","person_id":"aa6_83c_juy_B","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p003:m0117","start":117,"end":119,"surface":"家嫂","kind":"person","person_id":"fog_r7x_1uh","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p003:m0133","start":133,"end":134,"surface":"朗","kind":"person","person_id":"aa6_83c_juy_AA","status":"contextual_provisional"}],"source_position":{"first_line":125,"last_line":126,"revision_id":2645985,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-079-xielang-family","book_id":"b-jinshu-079","work_id":"w-jinshu","source_id":"s-jinshu-079-xielang-family"}],"sources":[{"chapter_id":"c-jinshu-065-wangdao-family","work_id":"w-jinshu","book_id":"b-jinshu-065","source_id":"s-jinshu-065-wangdao-family","source":{"title":"《晉書》卷六十五（數位選錄）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7065&oldid=1756144","permalink":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7065&oldid=1756144","revision_id":1756144,"accessed_on":"2026-10-18","extent":"王導傳首、弟與六子名單、王洽完整附傳、王珣附傳末段；其餘傳文待錄。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，未親核底本影像","response_sha256":"adb88c06681ebadbe1008de55022005077695c188196a2adbea1fd074cf8e1dc","wikitext_sha256":"98c7262170dcc4bf0f7e831fb693e46ff819e46fdd9407a484c787185901550a","normalization":{"character_conversion":{},"extraction_note":"只展開單字顯示語法、YL年號模板及粗體標記；不改原字。數位章首notes與小標題不作正文證據。","excerpts":[{"proposed_paragraph_id":"c-jinshu-065-wangdao-family:p001","source_lines":[12,13],"raw_quote":"　　王導，字茂弘，光祿大夫覽之孫也。父裁，鎮軍司馬。導少有風鑒，識量清遠。年十四，陳留高士張公見而奇之，謂其從兄敦曰：「此兒容貌志氣，將相之器也。」初襲祖爵即丘子。司空劉實尋引爲東閣祭酒，遷秘書郎、太子舍人、尚書郎，並不行。-{後}-參東海王越軍事。","raw_quote_sha256":"55cfcecac55deae6b31938ff8f5b24adfaf30edcacaf2d3f10689b893f57ccef","selected_text_sha256":"4305dd97e4210dddc55b1bc1be6dd65e205a9e76a083028fef942d7fb9f4b63e","begin_anchor":"王導，字茂弘，光祿大夫覽之孫也","end_anchor":"郎，並不行。後參東海王越軍事。"},{"proposed_paragraph_id":"c-jinshu-065-wangdao-family:p002","source_lines":[60,61],"raw_quote":"　　二弟：穎、敞，少與導俱知名，時人以穎方溫太真，以敞比鄧伯道，並早卒。導六子：'''悅、恬、洽、協、邵、薈'''。","raw_quote_sha256":"79aca2610036b59920f915415447b07befdc34fd18f6d4d03db4063313b6e256","selected_text_sha256":"72a361a1bd48a41d842525c3faf54958276d645db494bbdbc8a2503d721c2c68","begin_anchor":"二弟：穎、敞，少與導俱知名，時","end_anchor":"六子：悅、恬、洽、協、邵、薈。"},{"proposed_paragraph_id":"c-jinshu-065-wangdao-family:p003","source_lines":[74,75],"raw_quote":"　　洽字敬和，導諸子中最知名，與荀羨俱有美稱。弱冠，歷散騎、中書郎、中軍長史、司徒左長史、建武將軍、呉郡內史。徵拜領軍，尋加中書令，固讓，表疏十上。穆帝詔曰：「敬和清裁貴令，昔爲中書郎，吾時尚小，數呼見，意甚親之。今所以用爲令，既機任須才，且欲時時相見，共講文章，待以友臣之義。而累表固讓，甚違本懷。其催洽令拜。」苦讓，遂不受。{{YL|昇平二年}}卒於官，年三十六。二子：珣、瑉。","raw_quote_sha256":"684bc2179ddff68edb739dca10f31036191b0f7af4a76d25ad95faf63050c457","selected_text_sha256":"48268ce33170893d17253498e1418567cc0158bcd6c1d2d491a72cbce20d1d84","begin_anchor":"洽字敬和，導諸子中最知名，與荀","end_anchor":"於官，年三十六。二子：珣、瑉。"},{"proposed_paragraph_id":"c-jinshu-065-wangdao-family:p004","source_lines":[88,89],"raw_quote":"　　初，珣既與謝安有隙，在東聞安薨，便出京師，詣族弟獻之，曰：「吾欲哭謝公。」獻之驚曰：「所望於法護。」於是直前哭之甚慟。法護，珣小字也。珣五子：弘、虞、柳、孺、曇首，宋世並有高名。","raw_quote_sha256":"a94ba99a0de66bb37f92c4f6a67ad9f0cb5f0c9ba653a91696ecc19729b5a990","selected_text_sha256":"98f997a89e095667a540467d3f62c511eeb1774a196825a3f9b79c322e50c6d4","begin_anchor":"初，珣既與謝安有隙，在東聞安薨","end_anchor":"、柳、孺、曇首，宋世並有高名。"}]}}},{"chapter_id":"c-jinshu-079-xielang-family","work_id":"w-jinshu","book_id":"b-jinshu-079","source_id":"s-jinshu-079-xielang-family","source":{"title":"《晉書》卷七十九（數位選錄）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7079&oldid=2645985","permalink":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7079&oldid=2645985","revision_id":2645985,"accessed_on":"2026-10-18","extent":"謝安傳首、謝玄開篇、謝朗完整附傳及謝重、謝絢附傳；其餘傳文未錄。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，未親核底本影像","response_sha256":"d163328c2cd16ad7f6eb3d805fb7f9dbd03f98297a3bfd1d9c51897d21fe1333","wikitext_sha256":"5fa1f639fa36f784fc45cc19fc9b185fa59a64dab7b01f9390d09942c4f071ca","normalization":{"character_conversion":{},"extraction_note":"移除首部排版空白；數位節題另存，不納入傳世正文或據以補家世。","excerpts":[{"proposed_paragraph_id":"c-jinshu-079-xielang-family:p001","source_lines":[27,28],"raw_quote":"謝安，字安石，尚從弟也。父裒，太常卿。安年四歲時，譙郡桓彝見而歎曰：「此兒風神秀徹，後當不減王東海。」及總角，神識沈敏，風宇條暢，善行書。弱冠，詣王蒙，清言良久，既去，蒙子修曰：「向客何如大人？」蒙曰：「此客亹亹，為來逼人。」王導亦深器之。由是少有重名。","raw_quote_sha256":"812019dedb73fc9d58a79c6eb6ae3a327f7cc8005412a41c9c76b1e3a5fa0562","selected_text_sha256":"812019dedb73fc9d58a79c6eb6ae3a327f7cc8005412a41c9c76b1e3a5fa0562","begin_anchor":"謝安，字安石，尚從弟也。父裒，","end_anchor":"」王導亦深器之。由是少有重名。"},{"proposed_paragraph_id":"c-jinshu-079-xielang-family:p002","source_lines":[81,82],"raw_quote":"玄字幼度。少穎悟，與從兄朗俱為叔父安所器重。安嘗戒約子侄，因曰：「子弟亦何豫人事，而正欲使其佳？」諸人莫有言者。玄答曰：「譬如芝蘭玉樹，欲使其生於庭階耳。」安悅。玄少好佩紫羅香囊，安患之，而不欲傷其意，因戲賭取，即焚之，於此遂止。","raw_quote_sha256":"e8ed9f3f2d8d374b9f5514a2eaafcd74cac15564c9b2143837d26b35d35954b0","selected_text_sha256":"e8ed9f3f2d8d374b9f5514a2eaafcd74cac15564c9b2143837d26b35d35954b0","begin_anchor":"玄字幼度。少穎悟，與從兄朗俱為","end_anchor":"，因戲賭取，即焚之，於此遂止。"},{"proposed_paragraph_id":"c-jinshu-079-xielang-family:p003","source_lines":[125,126],"raw_quote":"朗字長度。父據，早卒。朗善言玄理，文義豔發，名亞于玄。總角時，病新起，體甚贏，未堪勞，于叔父安前與沙門支遁朗論，遂至相苦。其母王氏再遣信令還，安欲留，使竟論，王氏因出云：「新婦少遭艱難，一生所寄惟在此兒。」遂流涕攜朗去。安謂坐客曰：「家嫂辭情慷慨，恨不使朝士見之。」朗終於東陽太守。","raw_quote_sha256":"c6b9baa11b6aa7d347dd0f18ba5e39ec7c59e4cc4c6d7f732f6a049144032f9e","selected_text_sha256":"c6b9baa11b6aa7d347dd0f18ba5e39ec7c59e4cc4c6d7f732f6a049144032f9e","begin_anchor":"朗字長度。父據，早卒。朗善言玄","end_anchor":"使朝士見之。」朗終於東陽太守。"},{"proposed_paragraph_id":"c-jinshu-079-xielang-family:p004","source_lines":[129,130],"raw_quote":"子重，字景重，明秀有才名，為會稽王道子驃騎長史。嘗因侍坐，于時月夜明淨，道子歎以為佳。重率爾曰：「意謂乃不如微雲點綴。」道子因戲重曰：「卿居心不淨，乃復強欲滓穢太清邪！」","raw_quote_sha256":"51e7b9110edf612a3aeacd5f41ebb3d95de1847dfb7334acbdcee865b0744406","selected_text_sha256":"51e7b9110edf612a3aeacd5f41ebb3d95de1847dfb7334acbdcee865b0744406","begin_anchor":"子重，字景重，明秀有才名，為會","end_anchor":"心不淨，乃復強欲滓穢太清邪！」"},{"proposed_paragraph_id":"c-jinshu-079-xielang-family:p005","source_lines":[133,134],"raw_quote":"子絢，字宣映，曾於公坐戲調，無禮于其舅袁湛。湛甚不堪之，謂曰：「汝父昔已輕舅，汝今復來加我，可謂世無渭陽情也。」絢父重，即王胡之外孫，與舅亦有不協之論，湛故有此及雲。","raw_quote_sha256":"d45e4517b24e439d2e68a343133a89bbf3ddfb7a57e7ad92250b2ab04b4581b6","selected_text_sha256":"d45e4517b24e439d2e68a343133a89bbf3ddfb7a57e7ad92250b2ab04b4581b6","begin_anchor":"子絢，字宣映，曾於公坐戲調，無","end_anchor":"舅亦有不協之論，湛故有此及雲。"}],"omitted_digital_paratext":[{"kind":"digital_section_heading","not_received_text":true,"source_lines":[123,124],"source_revision":2645985,"raw_quote":"===安兄據子 朗===\n","raw_quote_sha256":"173d13e0baa1a6ea4a5c8786bc194e60f4acdc8b8f5cbcdc2f61c7cdfe10a365"},{"kind":"digital_section_heading","not_received_text":true,"source_lines":[127,128],"source_revision":2645985,"raw_quote":"====朗子 重====\n","raw_quote_sha256":"ee915800694a2c33b402f31d3761d57831fdcb6b30af334944603793104e42a1"},{"kind":"digital_section_heading","not_received_text":true,"source_lines":[131,132],"source_revision":2645985,"raw_quote":"=====重子 絢=====\n","raw_quote_sha256":"73f651f287b39557bd2d0a55b48923a36f8dfbc5603ee880f2a3828e4b0f30b8"}]}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true},"assembled_identity":{"person_id":"aa6_83c_juy_B","representative_source_person_id":"aa6_83c_juy_B","source_person_ids":["aa6_83c_juy_B"],"identity_equivalence_decision_ids":[],"parent_person_id":"aa6_83c_juy","source_assertion_id":"a-jinshu079-xie-001","assembly_id":"family-chenjun-xie-lang","root_person_id":"aa6_83c_juy","status":"editorial_preferred","human_reviewed":false}}
