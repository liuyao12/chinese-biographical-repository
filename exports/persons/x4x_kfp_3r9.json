{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"x4x_kfp_3r9","canonical_person_id":"x4x_kfp_3r9","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["x4x_kfp_3r9"],"persons":[{"id":"x4x_kfp_3r9","label":"周奇〔襄陽太守〕","status":"active","historicity":"historical_tradition","aliases":[{"surface":"周奇","mention_ids":["c-jinshu-034-duyu:p015:m0031"]}],"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-034","chapter_id":"c-jinshu-034-duyu","source_id":"s-jinshu-034-ws2567662-duyu","paragraph_id":"c-jinshu-034-duyu:p015","mention_id":"c-jinshu-034-duyu:p015:m0031","quote":"周奇"}],"identity_note":"原明襄陽太守周奇領軍，與參軍/牙門名單分職，籍貫不由襄陽太守推。 未經人工覆核。","review":"ai_provisional"}],"source_mention_summary":[{"source_id":"s-jinshu-034-ws2567662-duyu","work_id":"w-jinshu","book_id":"b-jinshu-034","chapter_id":"c-jinshu-034-duyu","raw_mention_count":1,"mention_ids":["c-jinshu-034-duyu:p015:m0031"],"paragraph_ids":["c-jinshu-034-duyu:p015"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-034-duyu:p015:m0031","mention_ids":["c-jinshu-034-duyu:p015:m0031"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-034-ws2567662-duyu"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-034-duyu:p015:m0031","start":31,"end":33,"surface":"周奇","kind":"person","person_id":"x4x_kfp_3r9","status":"source_explicit","paragraph_id":"c-jinshu-034-duyu:p015","chapter_id":"c-jinshu-034-duyu"}],"relations":[],"title_holdings":[{"id":"th-jin034-duyu-career_042","person_id":"x4x_kfp_3r9","status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-034","chapter_id":"c-jinshu-034-duyu","source_id":"s-jinshu-034-ws2567662-duyu","paragraph_id":"c-jinshu-034-duyu:p015","quote":"預以太康元年正月，陳兵於江陵，遣參軍樊顯、尹林、鄧圭、襄陽太守周奇等率眾循江西上，授以節度，旬日之間，累克城邑，皆如預策焉。又遣牙門管定、周旨、伍巢等率奇兵八百，泛舟夜渡，以襲樂鄉，多張旗幟，起火巴山，出於要害之地，以奪賊心。吳都督孫歆震恐，與伍延書曰：「北來諸軍，乃飛渡江也。」吳之男女降者萬餘口，旨、巢等伏兵樂鄉城外。歆遣軍出拒王浚，大敗而還。旨等發伏兵，隨歆軍而入，歆不覺，直至帳下，虜歆而還。故軍中為之謠曰：「以計代戰一當萬。」於是進逼江陵。吳督將伍延偽請降而列兵登陴，預攻克之。既平上流，於是沅湘以南，至於交廣，吳之州郡皆望風歸命，奉送印綬，預仗節稱詔而綏撫之。凡所斬及生獲吳都督、監軍十四，牙門、郡守百二十餘人。又因兵威，徙將士屯戍之家以實江北，南郡故地各樹之長吏，荊土肅然，吳人赴者如歸矣。","person_mention_id":"c-jinshu-034-duyu:p015:m0031"}],"reviewer":"Codex（AI代理）","human_reviewed":false,"model":null,"interpretation_note":"完整固定本傳逐角色判讀；起終年未知不補、來源用稱不冒授任。","fixed_source_fact_binding":{"kind":"fixed_witness_person_fact_slots","key":"jin034-duyu-kinship","slot":"career_042"},"title":"襄陽太守","kind":"office","mode":"attestation","source_career_role":{"kind":"fixed_witness_person_fact_slots","key":"jin034-duyu-kinship","slot":"career_042"},"attestations":[{"id":"th-jin034-duyu-career_042:a001","paragraph_id":"c-jinshu-034-duyu:p015","start":27,"end":31,"surface":"襄陽太守","person_mention_id":"c-jinshu-034-duyu:p015:m0031","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}}}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":