uses:line062:m0153","start":153,"end":155,"surface":"弘之","kind":"person","person_id":"7r6_k52_qji_ABDACAB","status":"contextual_provisional"},{"id":"c-songshu-093-recluses:line062:m0164","start":164,"end":166,"surface":"桓偉","kind":"person","person_id":"9j5_n7n_c3u","status":"contextual_provisional"},{"id":"c-songshu-093-recluses:line062:m0177","start":177,"end":180,"surface":"何無忌","kind":"person","person_id":"c9y_5dx_n1p","status":"contextual_provisional"},{"id":"c-songshu-093-recluses:line062:m0188","start":188,"end":190,"surface":"髙祖","kind":"person","person_id":"3dv_ken_w58","status":"contextual_provisional"},{"id":"c-songshu-093-recluses:line062:m0221","start":221,"end":223,"surface":"敬弘","kind":"person","person_id":"7r6_k52_qji_ABDABAA","status":"contextual_provisional"},{"id":"c-songshu-093-recluses:line062:m0273","start":272,"end":275,"surface":"王弘之","kind":"person","person_id":"7r6_k52_qji_ABDACAB","status":"contextual_provisional"},{"id":"c-songshu-093-recluses:line062:m0294","start":294,"end":297,"surface":"郭希林","kind":"person","person_id":"k8g_23w_bip","status":"contextual_provisional"},{"id":"c-songshu-093-recluses:line062:m0343","start":343,"end":344,"surface":"臣","kind":"person","person_id":"7r6_k52_qji_ABDABAA","status":"contextual_provisional"},{"id":"c-songshu-093-recluses:line062:m0346","start":346,"end":348,"surface":"弘之","kind":"person","person_id":"7r6_k52_qji_ABDACAB","status":"contextual_provisional"},{"id":"c-songshu-093-recluses:line062:m0354","start":354,"end":356,"surface":"希林","kind":"person","person_id":"k8g_23w_bip","status":"contextual_provisional"},{"id":"c-songshu-093-recluses:line062:m0364","start":364,"end":366,"surface":"弘之","kind":"person","person_id":"7r6_k52_qji_ABDACAB","status":"contextual_provisional"},{"id":"c-songshu-093-recluses:line062:m0373","start":373,"end":375,"surface":"太祖","kind":"person","person_id":"3bh_k4m_fg4","status":"contextual_provisional"},{"id":"c-songshu-093-recluses:line062:m0378","start":378,"end":380,"surface":"敬弘","kind":"person","person_id":"7r6_k52_qji_ABDABAA","status":"contextual_provisional"},{"id":"c-songshu-093-recluses:line062:m0389","start":389,"end":391,"surface":"弘之","kind":"person","person_id":"7r6_k52_qji_ABDACAB","status":"contextual_provisional"},{"id":"c-songshu-093-recluses:line062:m0449","start":449,"end":451,"surface":"敬弘","kind":"person","person_id":"7r6_k52_qji_ABDABAA","status":"contextual_provisional"}],"source_position":{"first_line":62,"last_line":62,"revision_id":1962755,"editorial_excerpt_boundary":false},"chapter_id":"c-songshu-093-recluses","book_id":"b-songshu-093","work_id":"w-songshu","source_id":"s-songshu-093-recluses"}],"sources":[{"chapter_id":"c-jinshu-032-he-empress","work_id":"w-jinshu","book_id":"b-jinshu-032","source_id":"s-jinshu-032-he-empress","source":{"title":"《晉書》卷32（穆章何皇后傳）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7032&oldid=1543614","permalink":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7032&oldid=1543614","revision_id":1543614,"accessed_on":"2026-10-19","extent":"穆章何皇后完整兩原段；非全卷。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，底本影像未核","response_sha256":"662028853af3848a3f71cc750fcc290b8e5af62354baecdb3158bcb95f511f0a","wikitext_sha256":"82cd88cad08dac2b1bbb57371dc460a43806730b4da42c143f041374bd6866c5","normalization":{"character_conversion":{},"extraction_note":"展開年號模板，移除段首空白；數位校勘注另存，保留正文原字。","excerpts":[{"proposed_paragraph_id":"c-jinshu-032-he-empress:line053","source_lines":[53,53],"raw_quote":"　　穆章何皇后諱法倪，廬江灊人也。父準，見《外戚傳》。以名家膺選。{{YL|升平元年}}八月，下璽書曰：「皇帝咨前太尉參軍何琦：混元資始，肇經人倫，爰及夫婦，以奉天地宗廟社稷。謀于公卿，咸以宜率由舊典。今使使持節太常彪之、宗正綜，以禮納采。」琦答曰：「前太尉參軍、都鄉侯糞土臣何琦稽首頓首再拜。皇帝嘉命，訪婚陋族，備數採擇。臣從祖弟故散騎侍郎準之遺女，未閑教訓，衣履若如人。欽承舊章，肅奉典制。」又使兼太保、武陵王晞，兼太尉、中領軍洽，持節奉冊立為皇后。","raw_quote_sha256":"0303816816288fdd1ca4a000a3b6682451da029a337302086964afbabb7f3b23","selected_text_sha256":"da00c4f820292364a13989b77495a0ed4885d0f7b51dbc1b16cba06c922de078","begin_anchor":"穆章何皇后諱法倪，廬江灊人也。父準，","end_anchor":"兼太尉、中領軍洽，持節奉冊立為皇后。"},{"proposed_paragraph_id":"c-jinshu-032-he-empress:line055","source_lines":[55,55],"raw_quote":"　　后無子。哀帝即位，稱穆皇后，居永安宮。桓玄篡位，移后入司徒府。路經太廟，后停輿慟哭，哀感路人。玄聞而怒曰：「天下禪代常理，何預何氏女子事耶！」乃降后為零陵縣君。與安帝俱西，至巴陵。及劉裕建義，殷仲文奉后還京都，下令曰：「戎車屢警，黎元阻饑。而膳御豐靡，豈與百姓同其儉約。減損供給，勿令游過。」后時以遠還，欲奉拜陵廟。有司以寇難未平，奏停。{{YL|元興三年}}崩<ref>元興三年崩：「元興」原作「永興」。商榷：「永興」當作「元興」，自穆帝升平元年至安帝元興三年，正四十八年。按：《安紀》、《[[建康實錄]]·一〇》皆在元興三年，今據改。</ref>，年六十六，在位凡四十八年。","raw_quote_sha256":"f4ace9a4d0b17ecd984409e9e79c6f1d15780003eece7090ab3c1c0b18c952bd","selected_text_sha256":"2e4d5b5b4dcc14342341f768999c49e8b1951423538f1a592bfe836a4605782f","begin_anchor":"后無子。哀帝即位，稱穆皇后，居永安宮","end_anchor":"興三年崩，年六十六，在位凡四十八年。","removed_digital_editorial_notes":[{"text":"元興三年崩：「元興」原作「永興」。商榷：「永興」當作「元興」，自穆帝升平元年至安帝元興三年，正四十八年。按：《安紀》、《[[建康實錄]]·一〇》皆在元興三年，今據改。","text_layer":"modern_digital_apparatus","independently_verified":false}]}]}}},{"chapter_id":"c-songshu-093-recluses","work_id":"w-songshu","book_id":"b-songshu-093","source_id":"s-songshu-093-recluses","source":{"title":"《宋書》卷93（王弘之、曇生與孔淳之傳）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E5%AE%8B%E6%9B%B8%2F%E5%8D%B793&oldid=1962755","permalink":"https://zh.wikisource.org/w/index.php?title=%E5%AE%8B%E6%9B%B8%2F%E5%8D%B793&oldid=1962755","revision_id":1962755,"accessed_on":"2026-10-19","extent":"王弘之及子曇生五原段、孔淳之四原段；同卷其他隱逸傳文未錄，不代表全卷完成。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，未親核底本影像","wikitext_sha256":"006115bbb0fa72042b9926f19b6ffbc952b7955b7f3a9fdf9c6fb3be71cb98aa","normalization":{"character_conversion":{},"extraction_note":"只去排版空白、展開原字形外殼及單參數年號模板及保留顯示字的維基連結外殼；數位ref另列，不改原字或標點，不以節題補姓名。","excerpts":[{"proposed_paragraph_id":"c-songshu-093-recluses:line060","source_lines":[60,60],"raw_quote":"王弘之字方平，琅邪臨沂人，宣訓衞尉鎭之弟也。","raw_quote_sha256":"8c856e8ccc99168f02ddf727d1cc7360f066ff7b1d918cc8820e2d5c8c989ba3","selected_text_sha256":"8c856e8ccc99168f02ddf727d1cc7360f066ff7b1d918cc8820e2d5c8c989ba3","begin_anchor":"王弘之字方平，琅邪臨沂人，宣訓衞尉鎭","end_anchor":"方平，琅邪臨沂人，宣訓衞尉鎭之弟也。"},{"proposed_paragraph_id":"c-songshu-093-recluses:line062","source_lines":[62,62],"raw_quote":"少孤貧，爲外祖-{徴}-士何准所撫育。從叔獻之及太原王恭，-{並}-貴重之。晉安帝隆安中，爲琅邪王中軍參軍，遷司徒主簿。家貧，而性好山水，求爲烏程令，<ref>求爲烏程令　「烏程」南史、-{御}-覽四八七引宋書作「烏傷」。</ref>尋以病歸。桓玄輔晉，桓謙以爲衞軍參軍。時琅邪殷仲文還姑孰，祖送傾朝，謙要弘之同行，答曰：「凡祖離送別，必在有情，下官與殷風馬不接，無縁扈從。」謙貴其言。母隨兄鎭之之安成郡，<ref>母隨兄鎭之之安成郡　「母」各本-{並}-作「毎」，據南史改。</ref>弘之解職同行，荊州刺史桓偉請爲南蠻長史。義熙初，何無忌又請爲右軍司馬。髙祖命爲徐州治中從事史，除員外散騎常侍，-{並}-不就。家在會稽上虞。從兄敬弘爲吏部尚書，奏曰：「聖明司契，載德惟新，垂-{鑑}-仄微，表揚隱介，默語仰風，荒遐傾首。前員外散騎常侍琅邪王弘之，恬漠丘園，放心居逸。前衞將軍參軍武昌郭希林，素履純潔，嗣徽前武。-{並}-撃壤聖朝，未蒙表飾，宜加旌聘，賁-{于}-丘園，以彰止遜之美，以祛動求之累。臣愚謂弘之可太子庶子，希林可著作郎。」即-{徴}-弘之爲庶子，不就。太祖即位，敬弘爲左-{僕}-射，又陳：「弘之髙行表-{於}-初筮，苦節彰-{於}-暮年，今内外晏然，當修太平之化，宜招空-{谷}-，以敦-{沖}-退之美。」元嘉四年，-{徴}-爲通直散騎常侍，又不就。敬弘嘗解貂裘與之，即着以采藥。","raw_quote_sha256":"5e9e34ead4450a6f958991d467c045c56c683116e9681d063cccb6e9f254406e","selected_text_sha256":"248af234d06e7504a83c195a1a44b8300db5859cac149dac227a6ea287164ad5","begin_anchor":"少孤貧，爲外祖徴士何准所撫育。從叔獻","end_anchor":"不就。敬弘嘗解貂裘與之，即着以采藥。","removed_digital_editorial_notes":[{"text":"求爲烏程令　「烏程」南史、-{御}-覽四八七引宋書作「烏傷」。","text_layer":"modern_digital_apparatus"},{"text":"母隨兄鎭之之安成郡　「母」各本-{並}-作「毎」，據南史改。","text_layer":"modern_digital_apparatus"}]},{"proposed_paragraph_id":"c-songshu-093-recluses:line064","source_lines":[64,64],"raw_quote":"性好釣，上虞江有一處名三石頭，弘之常垂綸-{於}-此。經過者不識之，或問：「漁師得魚賣不？」弘之曰：「亦自不得，得亦不賣。」日夕載魚入上虞郭，經親故門，各以一兩頭置門内而去。始-{寧}-沃川有佳山水，<ref>始-{寧}-沃川有佳山水　「沃川」各本-{並}-作「汰川」，據南史、建康實録改。按沃川即沃洲，在始-{寧}-縣境。</ref>弘之又依巖-{築}-室。謝靈運、顏延之-{並}-相欽重，靈運與廬陵王義眞牋曰：「會境既-{豐}-山水，是以江左嘉遁，-{並}-多居之。但季世慕榮，幽棲者寡，或-{復}--{才}-爲時求，弗獲從-{志}-。至若王弘之拂衣歸耕，踰歴三紀；孔淳之隱約窮岫，自始迄今；阮萬齡辭事就閑，纂成先業；浙河之外，棲遲山澤，如斯而已。既遠同羲、唐，亦激貪厲競。殿下愛素好古，常若布衣，毎意昔聞，虚想巖穴，若遣一介，<ref>若遣一介　「介」南史作「个」。禮大學：「若有一个臣。」</ref>有以相存，眞可謂千載盛美也。」","raw_quote_sha256":"b4d03a846ba2b52abeb67270ef29705a7d6fde817083a011223a00d46c632b39","selected_text_sha256":"aa35732151a46e13b0d137efc864128dcc084b43010eddd0913efef54c4677d7","begin_anchor":"性好釣，上虞江有一處名三石頭，弘之常","end_anchor":"一介，有以相存，眞可謂千載盛美也。」","removed_digital_editorial_notes":[{"text":"始-{寧}-沃川有佳山水　「沃川」各本-{並}-作「汰川」，據南史、建康實録改。按沃川即沃洲，在始-{寧}-縣境。","text_layer":"modern_digital_apparatus"},{"text":"若遣一介　「介」南史作「个」。禮大學：「若有一个臣。」","text_layer":"modern_digital_apparatus"}]},{"proposed_paragraph_id":"c-songshu-093-recluses:line066","source_lines":[66,66],"raw_quote":"弘之四年卒，時年六十三。顏延之欲爲作誄，書與弘之子-{曇}-生曰：「君家髙世之節，有識歸重，豫染豪翰，所應載述。況-{僕}--{託}-慕末風，竊以敍德爲事，但恨短筆不足書美。」誄竟不就。","raw_quote_sha256":"98d2c8d4eb6c22e79f7d479ae5d598e986bdbedb101070eac30c0301bedd4101","selected_text_sha256":"3611e6a3574731689ae1ac65d52e8b0c3a03604eb21da2bbe13db6b283d60a0d","begin_anchor":"弘之四年卒，時年六十三。顏延之欲爲作","end_anchor":"爲事，但恨短筆不足書美。」誄竟不就。"},{"proposed_paragraph_id":"c-songshu-093-recluses:line068","source_lines":[68,68],"raw_quote":"-{曇}-生好文義，以謙和見稱。歴顯位，吏部尚書，太常卿。大明末，爲呉興太守。太宗初，四方同逆，戰敗奔會稽，歸降被宥，終-{於}-中散大夫。","raw_quote_sha256":"b0e7f54131ac37dc3949d1fd531bfc9e68b733a103dfe9f33a7a38ab935f4226","selected_text_sha256":"6a721c25ec2686b96c803cac0863381cd5fb6950cb75723f1fd8f9a93ac13bf3","begin_anchor":"曇生好文義，以謙和見稱。歴顯位，吏部","end_anchor":"戰敗奔會稽，歸降被宥，終於中散大夫。"},{"proposed_paragraph_id":"c-songshu-093-recluses:line078","source_lines":[78,78],"raw_quote":"孔淳之字彦深，魯郡魯人也。祖惔，尚書祠部郎。父粲，祕書監-{徴}-，不就。","raw_quote_sha256":"e08c332904a4263abf24d68123effc7e91eb997d0dbb823d6267f592a180ce9d","selected_text_sha256":"e91afa096164f2f1d11d56487cdfc4433017fcfffc8a478318771a93701e5f27","begin_anchor":"孔淳之字彦深，魯郡魯人也。祖惔，尚書","end_anchor":"，尚書祠部郎。父粲，祕書監徴，不就。"},{"proposed_paragraph_id":"c-songshu-093-recluses:line080","source_lines":[80,80],"raw_quote":"淳之少有髙尚，愛好墳籍，爲太原王恭所稱。居會稽剡縣，性好山水，毎有所-{游}-，必窮其幽峻，或旬日忘歸。嘗-{游}-山，遇沙門釋法崇，因留共止，遂停三載。法崇嘆曰：「緬想人外，三十年矣，今乃傾蓋-{于}-茲，不覺老之將至也。」及淳之還反，不告以姓。除著作佐郎，太尉參軍，-{並}-不就。","raw_quote_sha256":"930341c337dbeecd9d8b216daa7189b76145cbb8643eb87b59c6bf6978ae1c41","selected_text_sha256":"bb58aefe079d98c9bd867b70ad3dd715329619bc4f330d2efd9e356b44e6dd4a","begin_anchor":"淳之少有髙尚，愛好墳籍，爲太原王恭所","end_anchor":"以姓。除著作佐郎，太尉參軍，並不就。"},{"proposed_paragraph_id":"c-songshu-093-recluses:line082","source_lines":[82,82],"raw_quote":"居喪至孝，廬-{于}-墓側。服闋，與-{徴}-士戴顒、王弘之及王敬弘等共爲人外之-{游}-。敬弘以女-{適}-淳之子尚。會稽太守謝方明苦要入郡，終不肯往。茅室蓬戸，庭草蕪逕，唯牀上有數巻書。元嘉初，-{復}--{徴}-爲散騎侍郎，乃逃-{于}-上虞縣界，家人莫知所之。弟默之爲廣州刺史，出都與別。司徒王弘要淳之集冶城，即日命駕東歸，遂不顧也。元嘉七年，卒，時年五十九。默之儒學，注-{穀}-梁春秋。","raw_quote_sha256":"73c664d828d9e0764d966cd39cd7142c7a72b29f1ef9838c9d8634d0d2ba931b","selected_text_sha256":"cf11977a38578aa5cd8bbd507915a88d95d2224b01716b291291fcba8991d6a7","begin_anchor":"居喪至孝，廬于墓側。服闋，與徴士戴顒","end_anchor":"，時年五十九。默之儒學，注穀梁春秋。"},{"proposed_paragraph_id":"c-songshu-093-recluses:line084","source_lines":[84,84],"raw_quote":"默之子熙先，事在-{范}-曄傳。","raw_quote_sha256":"37b3392ab143e5b7b6f3432d3bf2deab473549a21a82ada3841c15a08a22570e","selected_text_sha256":"fa4cadbde259d1c7f84f4b90f20828d9a568b83907295532e6b46ab7fceb9e81","begin_anchor":"默之子熙先，事在范曄傳。","end_anchor":"默之子熙先，事在范曄傳。"}]},"response_sha256":"e715e1ac86b592e0b9f1ff085b7018abc415de6b534dceb093ab0d2e9e5cdd7d"}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true}}
