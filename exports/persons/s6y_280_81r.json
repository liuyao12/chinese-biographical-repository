{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"s6y_280_81r","canonical_person_id":"s6y_280_81r","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["s6y_280_81r"],"persons":[{"id":"s6y_280_81r","label":"晉安帝德宗","status":"active","historicity":"historical_tradition","aliases":[{"surface":"晉安帝","mention_ids":["c-songshu-093-recluses:line062:m0030"]},{"surface":"安帝","mention_ids":["c-jinshu-032-he-empress:line055:m0081"]}],"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-093","chapter_id":"c-songshu-093-recluses","source_id":"s-songshu-093-recluses","paragraph_id":"c-songshu-093-recluses:line062","mention_id":"c-songshu-093-recluses:line062:m0030","quote":"晉安帝"},{"work_id":"w-jinshu","book_id":"b-jinshu-032","chapter_id":"c-jinshu-032-he-empress","source_id":"s-jinshu-032-he-empress","paragraph_id":"c-jinshu-032-he-empress:line055","mention_id":"c-jinshu-032-he-empress:line055:m0081","quote":"安帝"}],"review":"ai_provisional","identity_note":"宋書王弘之及附傳人物，字號／君主稱謂依原段與已核平行正文辨識，正式判斷與來源記錄另存；未核影像。"}],"source_mention_summary":[{"source_id":"s-jinshu-032-he-empress","work_id":"w-jinshu","book_id":"b-jinshu-032","chapter_id":"c-jinshu-032-he-empress","mention_count":1,"mention_ids":["c-jinshu-032-he-empress:line055:m0081"],"paragraph_ids":["c-jinshu-032-he-empress:line055"],"table_cell_ids":[],"passage_count":1},{"source_id":"s-songshu-093-recluses","work_id":"w-songshu","book_id":"b-songshu-093","chapter_id":"c-songshu-093-recluses","mention_count":1,"mention_ids":["c-songshu-093-recluses:line062:m0030"],"paragraph_ids":["c-songshu-093-recluses:line062"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-jinshu-032-he-empress","s-songshu-093-recluses"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-032-he-empress:line055:m0081","start":81,"end":83,"surface":"安帝","kind":"person","person_id":"s6y_280_81r","status":"contextual_provisional","paragraph_id":"c-jinshu-032-he-empress:line055","chapter_id":"c-jinshu-032-he-empress"},{"id":"c-songshu-093-recluses:line062:m0030","start":30,"end":33,"surface":"晉安帝","kind":"person","person_id":"s6y_280_81r","status":"contextual_provisional","paragraph_id":"c-songshu-093-recluses:line062","chapter_id":"c-songshu-093-recluses"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-song093-andi","person_id":"s6y_280_81r","surfaces":["晉安帝"],"scope":"same_chapter","chapter_ids":["c-songshu-093-recluses"],"status":"contextual_provisional","confidence_level":"high","identification_basis":{"kind":"source_context","target_mention_ids":["c-songshu-093-recluses:line062:m0030"]},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-093","source_id":"s-songshu-093-recluses","chapter_id":"c-songshu-093-recluses","paragraph_id":"c-songshu-093-recluses:line062","quote":"少孤貧，爲外祖徴士何准所撫育。從叔獻之及太原王恭，並貴重之。晉安帝隆安中，爲琅邪王中軍參軍，遷司徒主簿。家貧，而性好山水，求爲烏程令，尋以病歸。桓玄輔晉，桓謙以爲衞軍參軍。時琅邪殷仲文還姑孰，祖送傾朝，謙要弘之同行，答曰：「凡祖離送別，必在有情，下官與殷風馬不接，無縁扈從。」謙貴其言。母隨兄鎭之之安成郡，弘之解職同行，荊州刺史桓偉請爲南蠻長史。義熙初，何無忌又請爲右軍司馬。髙祖命爲徐州治中從事史，除員外散騎常侍，並不就。家在會稽上虞。從兄敬弘爲吏部尚書，奏曰：「聖明司契，載德惟新，垂鑑仄微，表揚隱介，默語仰風，荒遐傾首。前員外散騎常侍琅邪王弘之，恬漠丘園，放心居逸。前衞將軍參軍武昌郭希林，素履純潔，嗣徽前武。並撃壤聖朝，未蒙表飾，宜加旌聘，賁于丘園，以彰止遜之美，以祛動求之累。臣愚謂弘之可太子庶子，希林可著作郎。」即徴弘之爲庶子，不就。太祖即位，敬弘爲左僕射，又陳：「弘之髙行表於初筮，苦節彰於暮年，今内外晏然，當修太平之化，宜招空谷，以敦沖退之美。」元嘉四年，徴爲通直散騎常侍，又不就。敬弘嘗解貂裘與之，即着以采藥。"}],"rationale":"本段明言晉安帝隆安中，按晉書本紀明載諱字辨德宗；名依已核正文，非由模型記憶補入。","references":[{"title":"《晉書》卷10安帝正文","url":"https://zh.wikisource.org/w/index.php?oldid=2567072","source_revision":2567072,"quote":"安皇帝諱德宗，字德宗，孝武帝長子也。","source_position":{"first_line":11,"last_line":11},"wikitext_sha256":"191bbf44a05c366e9ce2ae1556f05d317245ff0d923e97e99d5aad06c81e8794","image_verified":false}],"human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-032-he-empress:line055","text":"后無子。哀帝即位，稱穆皇后，居永安宮。桓玄篡位，移后入司徒府。路經太廟，后停輿慟哭，哀感路人。玄聞而怒曰：「天下禪代常理，何預何氏女子事耶！」乃降后為零陵縣君。與安帝俱西，至巴陵。及劉裕建義，殷仲文奉后還京都，下令曰：「戎車屢警，黎元阻饑。而膳御豐靡，豈與百姓同其儉約。減損供給，勿令游過。」后時以遠還，欲奉拜陵廟。有司以寇難未平，奏停。元興三年崩，年六十六，在位凡四十八年。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-032-he-empress:line055:m0000","start":0,"end":1,"surface":"后","kind":"person","person_id":"3ea_uzt_2n2_A","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line055:m0004","start":4,"end":6,"surface":"哀帝","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"待平行原文確認具體身份；保留原稱。"},{"id":"c-jinshu-032-he-empress:line055:m0010","start":10,"end":13,"surface":"穆皇后","kind":"person","person_id":"3ea_uzt_2n2_A","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line055:m0019","start":19,"end":21,"surface":"桓玄","kind":"person","person_id":"lf6_f95_379","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line055:m0025","start":25,"end":26,"surface":"后","kind":"person","person_id":"3ea_uzt_2n2_A","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line055:m0036","start":36,"end":37,"surface":"后","kind":"person","person_id":"3ea_uzt_2n2_A","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line055:m0047","start":47,"end":48,"surface":"玄","kind":"person","person_id":"lf6_f95_379","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line055:m0063","start":63,"end":67,"surface":"何氏女子","kind":"person","person_id":"3ea_uzt_2n2_A","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line055