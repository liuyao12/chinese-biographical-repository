nreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-089-jishao:p003:m0031","start":31,"end":33,"surface":"杜斌","kind":"person","person_id":"2vj_x53_foj","status":"contextual_provisional","interpretation_note":"依完整本傳敘事／引語主語辨識，不以最近姓名機械延續。","paragraph_id":"c-jinshu-089-jishao:p003","chapter_id":"c-jinshu-089-jishao"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-089-jishao:p003","text":"元康初，為給事黃門侍郎。時侍中賈謐以外戚之寵，年少居位，潘岳、杜斌等皆附托焉。謐求交於紹，紹距而不答。及謐誅，紹時在省，以不阿比凶族，封弋陽子，遷散騎常侍，領國子博士。太尉、廣陵公陳准薨，太常奏諡，紹駁曰：「諡號所以垂之不朽，大行受大名，細行受細名，文武顯于功德，靈厲表於暗蔽。自頃禮官協情，諡不依本。准諡為過，宜諡曰繆。」事下太常。時雖不從，朝廷憚焉。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-jinshu-089-jishao:p003:m0015","start":15,"end":17,"surface":"賈謐","kind":"person","person_id":"ga3_phu_mfa","status":"contextual_provisional","interpretation_note":"依完整本傳敘事／引語主語辨識，不以最近姓名機械延續。"},{"id":"c-jinshu-089-jishao:p003:m0028","start":28,"end":30,"surface":"潘岳","kind":"person","person_id":"d2b_1d3_333","status":"contextual_provisional","interpretation_note":"依完整本傳敘事／引語主語辨識，不以最近姓名機械延續。"},{"id":"c-jinshu-089-jishao:p003:m0031","start":31,"end":33,"surface":"杜斌","kind":"person","person_id":"2vj_x53_foj","status":"contextual_provisional","interpretation_note":"依完整本傳敘事／引語主語辨識，不以最近姓名機械延續。"},{"id":"c-jinshu-089-jishao:p003:m0037","start":37,"end":38,"surface":"焉","kind":"person","person_id":"ga3_phu_mfa","status":"contextual_provisional","interpretation_note":"依完整本傳敘事／引語主語辨識，不以最近姓名機械延續。"},{"id":"c-jinshu-089-jishao:p003:m0039","start":39,"end":40,"surface":"謐","kind":"person","person_id":"ga3_phu_mfa","status":"contextual_provisional","interpretation_note":"依完整本傳敘事／引語主語辨識，不以最近姓名機械延續。"},{"id":"c-jinshu-089-jishao:p003:m0043","start":43,"end":44,"surface":"紹","kind":