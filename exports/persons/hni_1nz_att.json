sional"},{"id":"c-jinshu-057-tao-huang:p010:m0035","surface":"猷","start":35,"end":36,"person_id":"hni_1nz_att","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-tao-huang:p010:m0045","surface":"湮","start":45,"end":46,"person_id":"hof_5ku_9ft","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-tao-huang:p010:m0057","surface":"猷","start":57,"end":58,"person_id":"hni_1nz_att","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-tao-huang:p010:m0063","surface":"王導","start":63,"end":65,"person_id":"7r6_k52_qji_ABAA","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-tao-huang:p010:m0072","surface":"馥","start":72,"end":73,"person_id":"rsf_77l_3fx","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-tao-huang:p010:m0079","surface":"韓晃","start":79,"end":81,"person_id":"af7_a2c_011","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-tao-huang:p010:m0093","surface":"回","start":93,"end":94,"person_id":"avm_nkd_4d6","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-057-tao-huang","book_id":"b-jinshu-057","work_id":"w-jinshu","source_id":"s-jinshu-057-tao-huang-ws2413329"},{"id":"c-jinshu-058-zhou-xie:p001","text":"勰字彥和。常緘父言。時中國亡官失守之士避亂來者，多居顯位，駕御呉人，呉人頗怨。勰因之欲起兵，潛結呉興郡功曹徐馥。馥家有部曲，勰使馥矯稱叔父劄命以合眾，豪俠樂亂者翕然附之，以討王導、刁協爲名。孫皓族人弼亦起兵於廣德以應之。馥殺呉興太守袁琇，有眾數千，將奉劄爲主。時劄以疾歸家，聞而大驚，乃告亂於義興太守孔侃。勰知劄不同，不敢發兵。馥黨懼，攻馥，殺之。孫弼眾亦潰，宣城太守陶猷滅之。元帝以周氏奕世豪望，呉人所宗，故不窮治，撫之如舊。勰爲劄所責，失志歸家，淫侈縱恣，毎謂人曰：「人生幾時，但當快意耳。」終於臨淮太守。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":36,"last_line":36,"raw_start":3051,"raw_end":3312,"raw_character_offsets":[3053,3054,3055,3056,3057,3058,3059,3060,3061,3062,3063,3064,3065,3066,3067,3068,3069,3070,3071,3072,3073,3074,3075,3076,3077,3078,3079,3080,3081,3082,3083,3084,3085,3086,3087,3088,3089,3090,3091,3092,3093,3094,3095,3096,3097,3098,3099,3100,3101,3102,3103,3104,3105,3106,3107,3108,3109,3110,3111,3112,3113,3114,