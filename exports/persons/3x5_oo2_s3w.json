{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"3x5_oo2_s3w","canonical_person_id":"3x5_oo2_s3w","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["3x5_oo2_s3w"],"persons":[{"id":"3x5_oo2_s3w","label":"段繁","status":"active","historicity":"historical_tradition","aliases":[{"surface":"段繁","mention_ids":["c-jinshu-062-liukun:p006:m0336"]}],"evidence":[{"mention_id":"c-jinshu-062-liukun:p006:m0336","paragraph_id":"c-jinshu-062-liukun:p006","chapter_id":"c-jinshu-062-liukun","quote":"段繁"}],"review":"ai_provisional","identity_note":"段繁，見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-jinshu-062-liukun-ws2629226","work_id":"w-jinshu","book_id":"b-jinshu-062","chapter_id":"c-jinshu-062-liukun","raw_mention_count":1,"mention_ids":["c-jinshu-062-liukun:p006:m0336"],"paragraph_ids":["c-jinshu-062-liukun:p006"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-062-liukun:p006:m0336","mention_ids":["c-jinshu-062-liukun:p006:m0336"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-062-liukun-ws2629226"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-062-liukun:p006:m0336","surface":"段繁","start":336,"end":338,"person_id":"3x5_oo2_s3w","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-062-liukun:p006","chapter_id":"c-jinshu-062-liukun"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-062-liukun:p006","text":"河南徐潤者，以音律自通，游於貴勢，琨甚愛之，署爲晉陽令。潤恃寵驕恣，干預琨政。奮威護軍令狐盛性亢直，數以此爲諫，並勸琨除潤，琨不納。初，單于猗迤以救東嬴公騰之功，琨表其弟猗盧爲代郡公，與劉希合眾於中山。王浚以琨侵己之地，數來擊琨，琨不能抗，由是聲實稍損。徐潤又譖令狐盛於琨曰：「盛將勸公稱帝矣。」琨不之察，便殺之。琨母曰：「汝不能弘經略，駕豪傑，專欲除勝己以自安，當何以得濟！如是，禍必及我。」不從。盛子泥奔于劉聰，具言虛實。聰大喜，以泥爲鄉導。屬上黨太守襲醇降於聰，雁門烏丸復反，琨親率精兵出禦之。聰遣子粲及令狐泥乘虛襲晉陽，太原太守高喬以郡降聰，琨父母並遇害。琨引猗盧並力攻粲，大敗之，死者十五六。琨乘勝追之，更不能克。猗盧以爲聰未可滅，遺琨牛羊車馬而去，留其將箕澹、段繁等戍晉陽。琨志在復仇，而屈於力弱，泣血屍立，撫慰傷痍，移居陽邑城，以招集亡散。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":22,"last_line":22,"raw_start":1523,"raw_end":1902,"raw_character_offsets":[1525,1526,1527,1528,1529,1530,1531,1532,1533,1534,1535,1536,1537,1538,1539,1540,1541,1542,1543,1544,1545,1546,1547,1548,1549,1550,1551,1552,1553,1554,1555,1556,1557,1558,1559,1560,1561,1562,1563,1564,1565,1566,1567,1568,1569,1570,1571,1572,1573,1574,1575,1576,1577,1578,1579,1580,1581,1582,1583,1584,1585,1586,1587,1588,1589,1590,1591,1592,1593,1594,1595,1596,1597,1598,1599,1600,1601,1602,1603,1604,1605,1606,1607,1608,1609,1610,1611,1612,1613,1614,1615,1616,1617,1618,1619,1620,1621,1622,1623,1624,1625,1626,1627,1628,1629,1630,1631,1632,1633,1634,1635,1636,1637,1638,1639,1640,1641,1642,1643,1644,1645,1646,1647,1648,1649,1650,1651,1652,1653,1654,1655,1656,1657,1658,1659,1660,1661,1662,1663,1664,1665,1666,1667,1668,1669,1670,1671,1672,1673,1674,1675,1676,1677,1678,1679,1680,1681,1682,1683,1684,1685,1686,1687,1688,1689,1690,1691,1692,1693,1694,1695,1696,1697,1698,1699,1700,1701,1702,1703,1704,1705,1706,1707,1708,1709,1710,17