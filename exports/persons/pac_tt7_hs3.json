2022,12025,12026,12027,12028,12029,12030,12031,12032,12033,12034,12035,12036,12037,12038,12039,12040,12041,12042,12043,12044,12045,12046,12047,12048,12049,12050,12051,12052,12053,12054,12055,12056,12057,12058,12059,12060,12061,12062,12063,12064,12065,12066,12067,12068,12069,12070,12071,12072,12073,12074,12075,12076,12077,12078,12079,12080,12081,12082,12083,12084,12085,12086,12087,12088,12089,12090,12091,12092,12093,12094,12095,12096,12097,12098,12099,12100,12101,12213,12214,12215,12216,12217,12218,12219,12220,12221,12222,12223,12224,12225,12226,12227,12228,12229,12230,12231,12232,12233]},"chapter_id":"c-sanguozhi-052-buzhi-complete","book_id":"b-sanguozhi-052","work_id":"w-sanguozhi","source_id":"s-sanguozhi-052-buzhi-complete"},{"id":"c-sanguozhi-052-buzhi-complete:line098","text":"伏聞諸典校擿抉細微，吹毛求瑕，重案深誣，輒欲陷人以成威福。無罪無辜，橫受大刑，是以使民跼天蹐地，誰不戰慄?昔之獄官，惟賢是任，故皋陶作士，呂侯贖刑，張、於廷尉，民無冤枉，休泰之祚，實由此興。今之小臣，動與古異，獄以賄成，輕忽人命，歸咎於上，爲國速怨，夫一人吁嗟，王道爲虧，甚可仇疾。明德慎罰，哲人惟刑，書傳所美。自今蔽獄，都下則宜諮顧雍，武昌則陸遜、潘浚，平心專意，務在得情，騭黨神明，受罪何恨？","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-sanguozhi-052-buzhi-complete:line098:m0064","start":64,"end":66,"surface":"皋陶","kind":"person","person_id":"p3l_pp3_n6i","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line098:m0074","start":74,"end":75,"surface":"張","kind":"person","person_id":"dq6_ovk_58c","status":"contextual_provisional","interpretation_note":"讀本段前後及對話，所指按此處記。"},{"id":"c-sanguozhi-052-buzhi-complete:line098:m0076","start":76,"end":77,"surface":"於","kind":"person","person_id":"tks_56f_4ir","status":"contextual_provisional","interpretation_note":"讀本段前後及對話，所指按此處記。"},{"id":"c-sanguozhi-052-buzhi-complete:line098:m0166","start":166,"end":168,"surface":"顧雍","kind":"person","person_id":"syc_ik6_bq5_**A","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line098:m0172","start":172,"end":174,"surface":"陸遜","kind":"person","person_id":"