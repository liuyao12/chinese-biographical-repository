rt_codepoint":109,"end_codepoint":121,"human_reviewed":false,"chapter_id":"c-jinshu-072-gehong","source_id":"s-jinshu-072-gehong-ws2595548"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-072-gehong:p001:m0114","surface":"何幼道","start":114,"end":117,"person_id":"dv5_0wl_61x","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-072-gehong:p001","chapter_id":"c-jinshu-072-gehong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-072-gehong:p001","text":"葛洪，字稚川，丹陽句容人也。祖系，吳大鴻臚。父悌，吳平後入晉，為邵陵太守。洪少好學，家貧，躬自伐薪以貿紙筆，夜輒寫書誦習，遂以儒學知名。性寡欲，無所愛玩，不知棋局幾道，摴蒱齒名。為人木訥，不好榮利，閉門卻掃，未嘗交遊。于余杭山見何幼道、郭文舉，目擊而已，各無所言。時或尋書問義，不遠數千里崎嶇冒涉，期於必得，遂究覽典籍，尤好神仙導養之法。從祖玄，吳時學道得仙，號曰葛仙公，以其練丹秘術授弟子鄭隱。洪就隱學，悉得其法焉。後師事南海太守上党鮑玄。玄亦內學，逆占將來，見洪深重之，以女妻洪。洪傳玄業，兼綜練醫術，凡所著撰，皆精核是非，而才章富贍。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":75,"last_line":75,"raw_start":6593,"raw_end":6863,"raw_character_offsets":[6593,6594,6595,6596,6597,6598,6599,6600,6601,6602,6603,6604,6605,6606,6607,6608,6609,6610,6611,6612,6613,6614,6615,6616,6617,6618,6619,6620,6621,6622,6623,6624,6625,6626,6627,6628,6629,6630,6631,6632,6633,6634,6635,6636,6637,6638,6639,6640,6641,6642,6643,6644,6645,6646,6647,6648,6649,6650,6651,6652,6653,6654,6655,6656,6657,6658,6659,6660,6661,6662,6663,6664,6665,6666,6667,6668,6669,6670,6671,6672,6673,6674,6675,6676,6677,6678,6679,6680,6681,6682,6683,6684,6685,6686,6687,6688,6689,6690,6691,6692,6693,6694,6695,6696,6697,6698,6699,6700,6701,6702,6703,6704,6705,6706,6707,6708,6709,6710,6711,6712,6713,6714,6715,6716,6717,6718,6719,6720,6