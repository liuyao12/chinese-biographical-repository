ong-complete:p007:m0014","c-sanguozhi-064-suncong-complete:p007:m0213","c-sanguozhi-064-suncong-complete:p007:m0336","c-sanguozhi-064-suncong-complete:p007:m0338","c-sanguozhi-064-suncong-complete:p007:m0379"]}],"evidence":[{"mention_id":"c-sanguozhi-064-suncong-complete:p007:m0014","paragraph_id":"c-sanguozhi-064-suncong-complete:p007","chapter_id":"c-sanguozhi-064-suncong-complete","quote":"紀"},{"mention_id":"c-sanguozhi-064-suncong-complete:p007:m0213","paragraph_id":"c-sanguozhi-064-suncong-complete:p007","chapter_id":"c-sanguozhi-064-suncong-complete","quote":"紀"},{"mention_id":"c-sanguozhi-064-suncong-complete:p007:m0336","paragraph_id":"c-sanguozhi-064-suncong-complete:p007","chapter_id":"c-sanguozhi-064-suncong-complete","quote":"紀"},{"mention_id":"c-sanguozhi-064-suncong-complete:p007:m0338","paragraph_id":"c-sanguozhi-064-suncong-complete:p007","chapter_id":"c-sanguozhi-064-suncong-complete","quote":"紀"},{"mention_id":"c-sanguozhi-064-suncong-complete:p007:m0379","paragraph_id":"c-sanguozhi-064-suncong-complete:p007","chapter_id":"c-sanguozhi-064-suncong-complete","quote":"紀"}],"review":"ai_provisional","identity_note":"全紀（全尚子，黃門侍郎），見本組原文及身份互校。","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"vl3_bta_0h1","source_assertion_id":"a-wu064-ji-shang-father","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-064","chapter_id":"c-sanguozhi-064-suncong-complete","source_id":"s-sanguozhi-064-suncong-complete-ws2263487","paragraph_id":"c-sanguozhi-064-suncong-complete:p007","quote":"江表傳曰：亮召全尚息黃門侍郎紀密謀，曰：「孫綝專勢，輕小於孤。孤見敕之，使速上岸，為唐諮等作援，而留湖中，不上岸一步。又委罪硃異，擅殺功臣，不先表聞。築第橋南，不復朝見。此為自在，無復所畏，不可久忍。今規取之，卿父作中軍都督，使密嚴整士馬，孤當自出臨橋，帥宿衛虎騎、左右無難一時圍之。作版詔敕綝所領皆解散，不得舉手，正爾自得之。卿去，但當使密耳。卿宣詔語卿父，勿令卿母知之，女人既不曉大事，且綝同堂姊，邂逅洩漏，誤孤非小也。」紀承詔，以告尚，尚無遠慮，以語紀母。母使人密語綝。綝夜發嚴兵廢亮，比明，兵已圍宮。亮大怒，上馬，帶鞬執弓欲出，曰：「孤大皇帝之適子，在位已五年，誰敢不從者？」侍中近臣及乳母共牽攀止之，乃不得出，嘆吒二日不食，罵其妻曰：「爾父憒憒，敗我大事！」又呼紀，紀曰：「臣父奉詔不謹，負上，無面目復見。」因自殺。孫盛曰：亮傳稱亮少聰慧，勢當先與紀謀，不先令妻知也。江表傳說漏洩有由，於事為詳矣。","subject_person_mention_id":"c-sanguozhi-064-suncong-complete:p007:m0014","object_person_mention_id":"c-sanguozhi-064-suncong-complete:p007:m0007","source_term":"全尚息黃門侍郎紀"}],"status":"contextual_provisional","human_reviewed":false,"interpretation_note":"按同段具名父子及親稱次第。"}}],"source_mention_summary":[{"source_id":"s-sanguozhi-064-suncong-complete-ws2263487","work_id":"w-sanguozhi","book_id":"b-sanguozhi-064","chapter_id":"c-sanguozhi-064-suncong-complete","raw_mention_count":5,"mention_ids":["c-sanguozhi-064-suncong-complete:p007:m0014","c-sanguozhi-064-suncong-complete:p007:m0213","c-sanguozhi-064-suncong-complete:p007:m0336","c-sanguozhi-064-suncong-complete:p007:m0338","c-sanguozhi-064-suncong-complete:p007:m0379"],"paragraph_ids":["c-sanguozhi-064-suncong-complete:p007"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-sanguozhi-064-suncong-complete:p007:m0014","mention_ids":["c-sanguozhi-064-suncong-complete:p007:m0014"],"kind":"paragraph"},{"canonical_mention_id":"c-sanguozhi-064-suncong-complete:p007:m0213","mention_ids":["c-sanguozhi-064-suncong-complete:p007:m0213"],"kind":"paragraph"},{"canonical_mention_id":"c-sanguozhi-064-suncong-complete:p007:m0336","mention_ids":["c-sanguozhi-064-suncong-complete:p007:m0336"],"kind":"paragraph"},{"canonical_mention_id":"c-sanguozhi-064-suncong-complete:p007:m0338","mention_ids":["c-sanguozhi-064-suncong-complete:p007:m0338"],"kind":"paragraph"},{"canonical_mention_id":"c-sanguozhi-064-suncong-complete:p007:m0379","mention_ids":["c-sanguozhi-064-suncong-complete:p007:m0379"],"kind":"paragraph"}],"mention_count":5,"duplicate_mention_count":0,"paragraph_occurrence_count":5,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"5處獨立位置，5個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-sanguozhi-064-suncong-complete-ws2263487"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-wu064-ji-shang-father","subject_person_id":"vl3_bta_0h1_B","object_person_id":"vl3_bta_0h1","predicate":"father","qualifiers":{"source_term":"全尚息黃門侍郎紀","lineage":"paternal"},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-064","chapter_id":"c-sanguozhi-064-suncong-complete","source_id":"s-sanguozhi-064-suncong-complete-ws2263487","paragraph_id":"c-sanguozhi-064-suncong-complete:p007","quote":"江表傳曰：亮召全尚息黃門侍郎紀密謀，曰：「孫綝專勢，輕小於孤。孤見敕之，使速上岸，為唐諮等作援，而留湖中，不上岸一步。又委罪硃異，擅殺功臣，不先表聞。築第橋南，不復朝見。此為自在，無復所畏，不可久忍。今規取之，卿父作中軍都督，使密嚴整士馬，孤當自出臨橋，帥宿衛虎騎、左右無難一時圍之。作版詔敕綝所領皆解散，不得舉手，正爾自得之。卿去，但當使密耳。卿宣詔語卿父，勿令卿母知之，女人既不曉大事，且綝同堂姊，邂逅洩漏，誤孤非小也。」紀承詔，以告尚，尚無遠慮，以語紀母。母使人密語綝。綝夜發嚴兵廢亮，比明，兵已圍宮。亮大怒，上馬，帶鞬執弓欲出，曰：「孤大皇帝之適子，在位已五年，誰敢不從者？」侍中近臣及乳母共牽攀止之，乃不得出，嘆吒二日不食，罵其妻曰：「爾父憒憒，敗我大事！」又呼紀，紀曰：「臣父奉詔不謹，負上，無面目復見。」因自殺。孫盛曰：亮傳稱亮少聰慧，勢當先與紀謀，不先令妻知也。江表傳說漏洩有由，於事為詳矣。","subject_person_mention_id":"c-sanguozhi-064-suncong-complete:p007:m0014","object_person_mention_id":"c-sanguozhi-064-suncong-complete:p007:m0007"}],"status":"source_attested","interpretation_note":"按同段具名父子及親稱次第。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[{"connection":"father","generation_distance":1,"parent_person_id":"vl3_bta_0h1","source_assertion_id":"a-wu064-ji-shang-father","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-064","chapter_id":"c-sanguozhi-064-suncong-complete","source_id":"s-sanguozhi-064-suncong-complete-ws2263487","paragraph_id":"c-sanguozhi-064-suncong-complete:p007","quote":"江表傳曰：亮召全尚息黃門侍郎紀密謀，曰：「孫綝專勢，輕小於孤。孤見敕之，使速