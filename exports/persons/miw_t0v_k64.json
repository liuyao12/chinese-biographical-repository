{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"miw_t0v_k64","canonical_person_id":"miw_t0v_k64","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["miw_t0v_k64"],"persons":[{"id":"miw_t0v_k64","label":"呂越人（西南夷列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"呂越人","mention_ids":["c-shiji-116-xinanyi:m005-0122","c-shiji-117-xiangru:m035-0190","c-shiji-123-dayuan:m023-0056"]}],"evidence":[{"mention_id":"c-shiji-116-xinanyi:m005-0122","chapter_id":"c-shiji-116-xinanyi","paragraph_id":"c-shiji-116-xinanyi:p005","quote":"呂越人"},{"mention_id":"c-shiji-117-xiangru:m035-0190","chapter_id":"c-shiji-117-xiangru","paragraph_id":"c-shiji-117-xiangru:p035","quote":"呂越人"},{"mention_id":"c-shiji-123-dayuan:m023-0056","chapter_id":"c-shiji-123-dayuan","paragraph_id":"c-shiji-123-dayuan:p023","quote":"呂越人"}]}],"source_mention_summary":[{"source_id":"s-shiji116-xinanyi","work_id":"w-shiji","book_id":"b-shiji-116","chapter_id":"c-shiji-116-xinanyi","mention_count":1,"mention_ids":["c-shiji-116-xinanyi:m005-0122"],"paragraph_ids":["c-shiji-116-xinanyi:p005"],"table_cell_ids":[],"passage_count":1},{"source_id":"s-shiji117-xiangru","work_id":"w-shiji","book_id":"b-shiji-117","chapter_id":"c-shiji-117-xiangru","mention_count":1,"mention_ids":["c-shiji-117-xiangru:m035-0190"],"paragraph_ids":["c-shiji-117-xiangru:p035"],"table_cell_ids":[],"passage_count":1},{"source_id":"s-shiji123-dayuan","work_id":"w-shiji","book_id":"b-shiji-123","chapter_id":"c-shiji-123-dayuan","mention_count":1,"mention_ids":["c-shiji-123-dayuan:m023-0056"],"paragraph_ids":["c-shiji-123-dayuan:p023"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji116-xinanyi","s-shiji117-xiangru","s-shiji123-dayuan"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-shiji123-006","person_id":"miw_t0v_k64","event_type":"death","status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-123-dayuan","source_id":"s-shiji123-dayuan","paragraph_id":"c-shiji-123-dayuan:p023","quote":"是時漢既滅越，而蜀、西南夷皆震，請吏入朝。於是置益州、越巂、牂柯、沈黎、汶山郡，欲地接以前通大夏。乃遣使柏始昌、呂越人等歲十餘輩，出此初郡抵大夏，皆復閉昆明，為所殺，奪幣財，終莫能通至大夏焉。於是漢發三輔罪人，因巴蜀士數萬人，遣兩將軍郭昌、衛廣等往擊昆明之遮漢使者，斬首虜數萬人而去。其後遣使，昆明復為寇，竟莫能得通。而北道酒泉抵大夏，使者既多，而外國益厭漢幣，不貴其物。","person_mention_id":"c-shiji-123-dayuan:m023-0056"}],"source_term":"為所殺","interpretation_note":"原文明示個人死亡；相對年月未換算公元年，泛論與群體未另造個人事件。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"mentions":[{"id":"c-shiji-116-xinanyi:m005-0122","start":122,"end":125,"surface":"呂越人","kind":"person","person_id":"miw_t0v_k64","status":"contextual_provisional","paragraph_id":"c-shiji-116-xinanyi:p005","chapter_id":"c-shiji-116-xinanyi"},{"id":"c-shiji-117-xiangru:m035-0190","start":190,"end":193,"surface":"呂越人","kind":"person","person_id":"miw_t0v_k64","status":"contextual_provisional","paragraph_id":"c-shiji-117-xiangru:p035","chapter_id":"c-shiji-117-xiangru"},{"id":"c-shiji-123-dayuan:m023-0056","start":56,"end":59,"surface":"呂越人","kind":"person","person_id":"miw_t0v_k64","status":"contextual_provisional","paragraph_id":"c-shiji-123-dayuan:p023","chapter_id":"c-shiji-123-dayuan"}],"relations":[],"title_holdings":[{"id":"th-shiji117-011","person_id":"miw_t0v_k64","title":"副使","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-117-xiangru","source_id":"s-shiji117-xiangru","paragraph_id":"c-shiji-117-xiangru:p035","quote":"相如還報。唐蒙已略通夜郎，因通西南夷道，發巴、蜀、廣漢卒，作者數萬人。治道二歲，道不成，士卒多物故，費以巨萬計。蜀民及漢用事者多言其不便。是時邛筰之君長聞南夷與漢通，得賞賜多，多欲原為內臣妾，請吏，比南夷。天子問相如，相如曰：「邛、筰、厓、駹者近蜀，道亦易通，秦時嘗通為郡縣，至漢興而罷。今誠複通，為置郡縣，愈於南夷。」天子以為然，乃拜相如為中郎將，建節往使。副使王然於、壺充國、呂越人馳四乘之傳，因巴蜀吏幣物以賂西夷。至蜀，蜀太守以下郊迎，縣令負弩矢先驅，蜀人以為寵。於是卓王孫、臨邛諸公皆因門下獻牛酒以交驩。卓王孫喟然而歎，自以得使女尚司馬長卿晚，而厚分與其女財，與男等同。司馬長卿便略定西夷，邛、筰、厓、駹、斯榆之君皆請為內臣。除邊關，關益斥，西至沬、若水，南至牂柯為徼，通零關道，橋孫水以通邛都。還報天子，天子大說。"}],"attestations":[{"id":"th-shiji117-011:a001","paragraph_id":"c-shiji-117-xiangru:p035","start":180,"end":182,"surface":"副使","person_mention_id":"c-shiji-117-xiangru:m035-0190","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授任與文獻用稱分存；受金失官與歲餘復召為郎分事件。原文未明示公元日期，不補年份或任期；死亡不自動終止全部官爵。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[{"id":"eq-shiji116-envoy-lvyueren","person_ids":["miw_t0v_k64"],"canonical_person_id":"miw_t0v_k64","scope":"cross_chapter","chapter_ids":["c-shiji-116-xinanyi","c-shiji-117-xiangru","c-shiji-123-dayuan"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-116-xinanyi","source_id":"s-shiji116-xinanyi","paragraph_id":"c-shiji-116-xinanyi:p005","quote":"及元狩元年，博望侯張騫使大夏來，言居大夏時見蜀布、邛竹、杖，使問所從來，曰「從東南身毒國，可數千里，得蜀賈人市」。或聞邛西可二千里有身毒國。騫因盛言大夏在漢西南，慕中國，患匈奴隔其道，誠通蜀，身毒國道便近，有利無害。於是天子乃令王然于、柏始昌、呂越人等，使閒出西夷西，指求身毒國。至滇，滇王嘗羌乃留，為求道西十餘輩。歲餘，皆閉昆明，莫能通身毒國。","mention_ids":["c-shiji-116-xinanyi:m005-0122"]},{"chapter_id":"c-shiji-117-xiangru","source_id":"s-shiji117-xiangru","paragraph_id":"c-shiji-117-xiangru:p035","quote":"相如還報。唐蒙已略通夜郎，因通西南夷道，發巴、蜀、廣漢卒，作者數萬人。治道二歲，道不成，士卒多物故，費以巨萬計。蜀民及漢用事者多言其不便。是時邛筰之君長聞南夷與漢通，得賞賜多，多欲原為內臣妾，請吏，比南夷。天子問相如，相如曰：「邛、筰、厓、駹者近蜀，道亦易通，秦時嘗通為郡縣，至漢興而罷。今誠複通，為置郡縣，愈於南夷。」天子以為然，乃拜相如為中郎將，建節往使。副使王然於、壺充國、呂越人馳四乘之傳，因巴蜀吏幣物以賂西夷。至蜀，蜀太守以下郊迎，縣令負弩矢先驅，蜀人以為寵。於是卓王孫、臨邛諸公皆因門下獻牛酒以交驩。卓王孫喟然而歎，自以得使女尚司馬長卿晚，而厚分與其女財，與男等同。司馬長卿便略定西夷，邛、筰、厓、駹、斯榆之君皆請為內臣。除邊關，關益斥，西至沬、若水，南至牂柯為徼，通零關道，橋孫水以通邛都。還報天子，天子大說。","mention_ids":["c-shiji-117-xiangru:m035-0190"]},{"chapter_id":"c-shiji-123-dayuan","source_id":"s-shiji123-dayuan","paragraph_id":"c-shiji-123-dayuan:p023","quote":"是時漢既滅越，而蜀、西南夷皆震，請吏入朝。於是置益州、越巂、牂柯、沈黎、汶山郡，欲地接以前通大夏。乃遣使柏始昌、呂越人等歲十餘輩，出此初郡抵大夏，皆復閉昆明，為所殺，奪幣財，終莫能通至大夏焉。於是漢發三輔罪人，因巴蜀士數萬人，遣兩將軍郭昌、衛廣等往擊昆明之遮漢使者，斬首虜數萬人而去。其後遣使，昆明復為寇，竟莫能得通。而北道酒泉抵大夏，使者既多，而外國益厭漢幣，不貴其物。","mention_ids":["c-shiji-123-dayuan:m023-0056"]}],"rationale":"兩名使者在同一西南求道使團中反覆並見，並有呂越人與王然於隨司馬相如使西夷的平行記事。據姓名、共同同僚及出使區域接合，屬上下文暫定；元狩初遣與南越破後多批遣使是不同次任務，不把年份或死亡敘述合成同一事件。 不據皆閉昆明為所殺的多批使者集合敘述，直接補柏始昌、呂越人的確切卒年或逐人死法。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true},{"id":"eq-shiji117-lvyueren","person_ids":["miw_t0v_k64"],"canonical_person_id":"miw_t0v_k64","scope":"cross_chapter","chapter_ids":["c-shiji-116-xinanyi","c-shiji-117-xiangru"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-116-xinanyi","source_id":"s-shiji116-xinanyi","paragraph_id":"c-shiji-116-xinanyi:p005","quote":"及元狩元年，博望侯張騫使大夏來，言居大夏時見蜀布、邛竹、杖，使問所從來，曰「從東南身毒國，可數千里，得蜀賈人市」。或聞邛西可二千里有身毒國。騫因盛言大夏在漢西南，慕中國，患匈奴隔其道，誠通蜀，身毒國道便近，有利無害。於是天子乃令王然于、柏始昌、呂越人等，使閒出西夷西，指求身毒國。至滇，滇王嘗羌乃留，為求道西十餘輩。歲餘，皆閉昆明，莫能通身毒國。","mention_ids":["c-shiji-116-xinanyi:m005-0122"]},{"chapter_id":"c-shiji-117-xiangru","source_id":"s-shiji117-xiangru","paragraph_id":"c-shiji-117-xiangru:p035","quote":"相如還報。唐蒙已略通夜郎，因通西南夷道，發巴、蜀、廣漢卒，作者數萬人。治道二歲，道不成，士卒多物故，費以巨萬計。蜀民及漢用事者多言其不便。是時邛筰之君長聞南夷與漢通，得賞賜多，多欲原為內臣妾，請吏，比南夷。天子問相如，相如曰：「邛、筰、厓、駹者近蜀，道亦易通，秦時嘗通為郡縣，至漢興而罷。今誠複通，為置郡縣，愈於南夷。」天子以為然，乃拜相如為中郎將，建節往使。副使王然於、壺充國、呂越人馳四乘之傳，因巴蜀吏幣物以賂西夷。至蜀，蜀太守以下郊迎，縣令負弩矢先驅，蜀人以為寵。於是卓王孫、臨邛諸公皆因門下獻牛酒以交驩。卓王孫喟然而歎，自以得使女尚司馬長卿晚，而厚分與其女財，與男等同。司馬長卿便略定西夷，邛、筰、厓、駹、斯榆之君皆請為內臣。除邊關，關益斥，西至沬、若水，南至牂柯為徼，通零關道，橋孫水以通邛都。還報天子，天子大說。","mention_ids":["c-shiji-117-xiangru:m035-0190"]}],"rationale":"兩篇漢廷通夜郎及出使西夷的相連敘事、姓名與任務互證；王然于／王然於保留來源異字。原始人物ID保留，同書平行篇章不當獨立見證，其他生平仍待核。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true}],"passages":[{"id":"c-shiji-116-xinanyi:p005","text":"及元狩元年，博望侯張騫使大夏來，言居大夏時見蜀布、邛竹、杖，使問所從來，曰「從東南身毒國，可數千里，得蜀賈人市」。或聞邛西可二千里有身毒國。騫因盛言大夏在漢西南，慕中國，患匈奴隔其道，誠通蜀，身毒國道便近，有利無害。於是天子乃令王然于、柏始昌、呂越人等，使閒出西夷西，指求身毒國。至滇，滇王嘗羌乃留，為求道西十餘輩。歲餘，皆閉昆明，莫能通身毒國。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-116-xinanyi:m005-0009","start":9,"end":11,"surface":"張騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m005-0070","start":70,"end":71,"surface":"騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m005-0110","start":110,"end":112,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m005-0114","start":114,"end":117,"surface":"王然于","kind":"person","person_id":"hpw_2ip_uqk","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m005-0118","start":118,"end":121,"surface":"柏始昌","kind":"person","person_id":"11q_2yl_qzt","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m005-0122","start":122,"end":125,"surface":"呂越人","kind":"person","person_id":"miw_t0v_k64","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m005-0145","start":145,"end":147,"surface":"嘗羌","kind":"person","person_id":"h0h_wsl_1nf","status":"contextual_provisional"}],"chapter_id":"c-shiji-116-xinanyi","book_id":"b-shiji-116","work_id":"w-shiji","source_id":"s-shiji116-xinanyi"},{"id":"c-shiji-117-xiangru:p035","text":"相如還報。唐蒙已略通夜郎，因通西南夷道，發巴、蜀、廣漢卒，作者數萬人。治道二歲，道不成，士卒多物故，費以巨萬計。蜀民及漢用事者多言其不便。是時邛筰之君長聞南夷與漢通，得賞賜多，多欲原為內臣妾，請吏，比南夷。天子問相如，相如曰：「邛、筰、厓、駹者近蜀，道亦易通，秦時嘗通為郡縣，至漢興而罷。今誠複通，為置郡縣，愈於南夷。」天子以為然，乃拜相如為中郎將，建節往使。副使王然於、壺充國、呂越人馳四乘之傳，因巴蜀吏幣物以賂西夷。至蜀，蜀太守以下郊迎，縣令負弩矢先驅，蜀人以為寵。於是卓王孫、臨邛諸公皆因門下獻牛酒以交驩。卓王孫喟然而歎，自以得使女尚司馬長卿晚，而厚分與其女財，與男等同。司馬長卿便略定西夷，邛、筰、厓、駹、斯榆之君皆請為內臣。除邊關，關益斥，西至沬、若水，南至牂柯為徼，通零關道，橋孫水以通邛都。還報天子，天子大說。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m035-0000","start":0,"end":2,"surface":"相如","kind":"person","person_id":"usb_lgr_ksa","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0005","start":5,"end":7,"surface":"唐蒙","kind":"person","person_id":"a62_lwv_9ui","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0073","start":73,"end":75,"surface":"之君","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m035-0103","start":103,"end":105,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0106","start":106,"end":108,"surface":"相如","kind":"person","person_id":"usb_lgr_ksa","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0109","start":109,"end":111,"surface":"相如","kind":"person","person_id":"usb_lgr_ksa","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0160","start":160,"end":162,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0168","start":168,"end":170,"surface":"相如","kind":"person","person_id":"usb_lgr_ksa","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0182","start":182,"end":185,"surface":"王然於","kind":"person","person_id":"hpw_2ip_uqk","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0186","start":186,"end":189,"surface":"壺充國","kind":"person","person_id":"8wd_fcv_stu","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0190","start":190,"end":193,"surface":"呂越人","kind":"person","person_id":"miw_t0v_k64","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0213","start":213,"end":216,"surface":"蜀太守","kind":"person","person_id":"2zx_wew_zui","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0237","start":237,"end":240,"surface":"卓王孫","kind":"person","person_id":"lh2_c9g_7vs","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0256","start":256,"end":259,"surface":"卓王孫","kind":"person","person_id":"lh2_c9g_7vs","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0270","start":270,"end":274,"surface":"司馬長卿","kind":"person","person_id":"usb_lgr_ksa","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0289","start":289,"end":293,"surface":"司馬長卿","kind":"person","person_id":"usb_lgr_ksa","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0309","start":309,"end":311,"surface":"之君","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m035-0354","start":354,"end":356,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0357","start":357,"end":359,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"}],"chapter_id":"c-shiji-117-xiangru","book_id":"b-shiji-117","work_id":"w-shiji","source_id":"s-shiji117-xiangru"},{"id":"c-shiji-123-dayuan:p023","text":"是時漢既滅越，而蜀、西南夷皆震，請吏入朝。於是置益州、越巂、牂柯、沈黎、汶山郡，欲地接以前通大夏。乃遣使柏始昌、呂越人等歲十餘輩，出此初郡抵大夏，皆復閉昆明，為所殺，奪幣財，終莫能通至大夏焉。於是漢發三輔罪人，因巴蜀士數萬人，遣兩將軍郭昌、衛廣等往擊昆明之遮漢使者，斬首虜數萬人而去。其後遣使，昆明復為寇，竟莫能得通。而北道酒泉抵大夏，使者既多，而外國益厭漢幣，不貴其物。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-123-dayuan:m023-0052","start":52,"end":55,"surface":"柏始昌","kind":"person","person_id":"11q_2yl_qzt","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m023-0056","start":56,"end":59,"surface":"呂越人","kind":"person","person_id":"miw_t0v_k64","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m023-0117","start":117,"end":119,"surface":"郭昌","kind":"person","person_id":"ey5_pne_opn","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m023-0120","start":120,"end":122,"surface":"衛廣","kind":"person","person_id":"s2j_zz4_t0r","status":"contextual_provisional"}],"chapter_id":"c-shiji-123-dayuan","book_id":"b-shiji-123","work_id":"w-shiji","source_id":"s-shiji123-dayuan"}],"sources":[{"chapter_id":"c-shiji-116-xinanyi","work_id":"w