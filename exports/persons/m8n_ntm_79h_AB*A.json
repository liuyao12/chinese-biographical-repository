le":"huidi","identity_reading_ref":"source-evidence/jin044-lu-rendered/identity-readings.json#huidi"},{"id":"c-jinshu-044-luqin-family-rendered:p007:m0348","start":348,"end":349,"surface":"志","kind":"person","person_id":"m8n_ntm_79h_ABB","status":"contextual_provisional","resolution_note":"依本篇角色及已列原段，首選沿用現役身份；限制另列。身份審讀：luzhi。","source_identity_role":"luzhi","identity_reading_ref":"source-evidence/jin044-lu-rendered/identity-readings.json#luzhi"}],"chapter_id":"c-jinshu-044-luqin-family-rendered","book_id":"b-jinshu-044","work_id":"w-jinshu","source_id":"s-jinshu044-lu-rendered-oldcapture"}],"sources":[{"chapter_id":"c-jinshu-044-luqin-family-rendered","work_id":"w-jinshu","book_id":"b-jinshu-044","source_id":"s-jinshu044-lu-rendered-oldcapture","source":{"title":"《晉書》卷四十四盧欽傳","provider":"Wikisource","url":"https://zh.wikisource.org/wiki/晉書/卷044","permalink":"https://zh.wikisource.org/w/index.php?oldid=1775345&title=晉書/卷044","revision_id":1775345,"edition":null,"review_status":"text_checked","image_verified":false,"text_scope":"partial_chapter","extent":"盧欽、浮、珽、志、諶十二完整正文段，止崔悅單元前；不含全卷史評。","capture_kind":"existing_rendered_text_not_raw","raw_acquired":false,"raw_revision":null,"revision_link_observed":1775345,"capture_ref":"source-evidence/jin044-lu-rendered/received-rendered-capture.json","quality_note":"重用既存rendered逐行捕獲；固定頁曾cache miss，raw403，沒有raw成功或圖校資格；實際底本未知，非四庫或武英殿認定。","rights":"古代原文；維基文庫數位轉錄CC BY-SA 4.0。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/"}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true},"assembled_identity":{"person_id":"m8n_ntm_79h_AB*A","representative_source_person_id":"m8n_ntm_79h_AB*A","source_person_ids":["m8n_ntm_79h_AB*A"],"identity_equivalence_decision_ids":[],"parent_person_id":null,"source_assertion_id":null,"connection":"grandfather","ancestor_person_id":"m8n_ntm_79h_AB","generation_distance":2,"intermediate_person_ids":[null],"ancestor_connection":{"type":"fixed_jin044_paternal_nephew_unknown_father","uncle_person_id":"m8n_ntm_79h_ABB","nephew_assertion_id":"a-jin044-lu-010","uncle_father_assertion_id":"a-jin044-lu-005","status":"contextual_provisional","owner":"c-jinshu-044-luqin-family-rendered","human_reviewed":false,"placement_status":"editorial_inferred","literal_grandfather_assertion":false,"same_father_independently_attested":false,"unknown_father_person_id":null,"unknown_father_name":null,"father_is_hao_asserted":false,"rationale":"本篇明志兄子綝、珽子志；編輯首選依盧氏近系，暫將志之未知兄視作與志同父而把綝接祖珽。此同父尚無獨立明文，故只是有資格的父系推接，不是來源直接祖孫斷言；父名留空，不補為皓。","references":[{"work_id":"w-jinshu","book_id":"b-jinshu-044","source_id":"s-jinshu044-lu-rendered-oldcapture","chapter_id":"c-jinshu-044-luqin-family-rendered","paragraph_id":"c-jinshu-044-luqin-family-rendered:p007","quote":"及乂死，穎表志為中書監，留鄴，參署相府事。乘與敗于蕩陰，穎遣志督兵迎帝。及王浚攻鄴，志勸穎奉天子還洛陽。時甲士尚萬五千人，志夜部分，至曉，眾皆成列，而程太妃戀鄴不欲去，穎未能決。俄而眾潰，唯志與子謐、兄子綝、殿中武賁千人而已，志復勸穎早發。時有道士姓黃，號曰聖人，太妃信之。及使呼人，道士求兩杯酒，飲訖，拋杯而去，於是志計始決。而人馬復散，志于營陣間尋索，得數乘鹿車，司馬督韓玄收集黃門，得百餘人。志入，帝問志曰：「何故散敗至此？」志曰：「賊去鄴尚八十里，而人士一朝駭散，太弟今欲奉陛下還洛陽。」帝曰：「甚佳。」於是禦犢車便發。屯騎校尉郝昌先領兵八千守洛陽，帝召之，至汲郡而昌至，兵仗甚盛。志喜於復振，啟天子宜下赦書，與百姓同其休慶。既達洛陽，志啟以滿奮為司隸校尉。奔散者多還，百官粗備，帝悅，賜志絹二百匹、綿百斤、衣一襲、鶴綾袍一領。","subject_person_mention_id":"c-jinshu-044-luqin-family-rendered:p007:m0102","object_person_mention_id":"c-jinshu-044-luqin-family-rendered:p007:m0006","assertion_id":"a-jin044-lu-010","scope":"source_nephew_of_elder_brother","url":"https://zh.wikisource.org/w/index.php?oldid=1775345&title=晉書/卷044","source_layer":"received_chapter","human_reviewed":false},{"work_id":"w-jinshu","book_id":"b-jinshu-044","source_id":"s-jinshu044-lu-rendered-oldcapture","chapter_id":"c-jinshu-044-luqin-family-rendered","paragraph_id":"c-jinshu-044-luqin-family-rendered:p004","quote":"欽弟珽，字子笏，衛尉卿。珽子志。","subject_person_mention_id":"c-jinshu-044-luqin-family-rendered:p004:m0014","object_person_mention_id":"c-jinshu-044-luqin-family-rendered:p004:m0002","assertion_id":"a-jin044-lu-005","scope":"source_uncle_named_father","url":"https://zh.wikisource.org/w/index.php?oldid=1775345&title=晉書/卷044","source_layer":"received_chapter","human_reviewed":false}]},"interpretation_note":"本篇明志兄子綝、珽子志；編輯首選依盧氏近系，暫將志之未知兄視作與志同父而把綝接祖珽。此同父尚無獨立明文，故只是有資格的父系推接，不是來源直接祖孫斷言；父名留空，不補為皓。","assembly_id":"family-fanyang-lu-zhi-yu","root_person_id":"m8n_ntm_79h","status":"editorial_preferred","human_reviewed":false}}
