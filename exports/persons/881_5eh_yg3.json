{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"881_5eh_yg3","canonical_person_id":"881_5eh_yg3","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["881_5eh_yg3"],"persons":[{"id":"881_5eh_yg3","label":"老子（日者列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"老子","mention_ids":["c-shiji-127-rizhe:m012-0118","c-shiji-127-rizhe:m012-0145","c-shiji-127-rizhe:m017-0088","c-shiji-127-rizhe:m020-0138"]}],"evidence":[{"mention_id":"c-shiji-127-rizhe:m012-0118","chapter_id":"c-shiji-127-rizhe","paragraph_id":"c-shiji-127-rizhe:p012","quote":"老子"},{"mention_id":"c-shiji-127-rizhe:m012-0145","chapter_id":"c-shiji-127-rizhe","paragraph_id":"c-shiji-127-rizhe:p012","quote":"老子"},{"mention_id":"c-shiji-127-rizhe:m017-0088","chapter_id":"c-shiji-127-rizhe","paragraph_id":"c-shiji-127-rizhe:p017","quote":"老子"},{"mention_id":"c-shiji-127-rizhe:m020-0138","chapter_id":"c-shiji-127-rizhe","paragraph_id":"c-shiji-127-rizhe:p020","quote":"老子"}]}],"source_mention_summary":[{"source_id":"s-shiji127-rizhe","work_id":"w-shiji","book_id":"b-shiji-127","chapter_id":"c-shiji-127-rizhe","mention_count":4,"mention_ids":["c-shiji-127-rizhe:m012-0118","c-shiji-127-rizhe:m012-0145","c-shiji-127-rizhe:m017-0088","c-shiji-127-rizhe:m020-0138"],"paragraph_ids":["c-shiji-127-rizhe:p012","c-shiji-127-rizhe:p017","c-shiji-127-rizhe:p020"],"passage_count":3}],"most_mentioned_source_ids":["s-shiji127-rizhe"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-127-rizhe:m012-0118","start":118,"end":120,"surface":"老子","kind":"person","person_id":"881_5eh_yg3","status":"contextual_provisional","paragraph_id":"c-shiji-127-rizhe:p012","chapter_id":"c-shiji-127-rizhe"},{"id":"c-shiji-127-rizhe:m012-0145","start":145,"end":147,"surface":"老子","kind":"person","person_id":"881_5eh_yg3","status":"contextual_provisional","paragraph_id":"c-shiji-127-rizhe:p012","chapter_id":"c-shiji-127-rizhe"},{"id":"c-shiji-127-rizhe:m017-0088","start":88,"end":90,"surface":"老子","kind":"person","person_id":"881_5eh_yg3","status":"contextual_provisional","paragraph_id":"c-shiji-127-rizhe:p017","chapter_id":"c-shiji-127-rizhe"},{"id":"c-shiji-127-rizhe:m020-0138","start":138,"end":140,"surface":"老子","kind":"person","person_id":"881_5eh_yg3","status":"contextual_provisional","paragraph_id":"c-shiji-127-rizhe:p020","chapter_id":"c-shiji-127-rizhe"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-127-rizhe:p012","text":"「且夫卜筮者，埽除設坐，正其冠帶，然後乃言事，此有禮也。言而鬼神或以饗，忠臣以事其上，孝子以養其親，慈父以畜其子，此有德者也。而以義置數十百錢，病者或以愈，且死或以生，患或以免，事或以成，嫁子娶婦或以養生：此之爲德，豈直數十百錢哉！此夫老子所謂『上德不德，是以有德』。今夫卜筮者利大而謝少，老子之云豈異於是乎？","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-127-rizhe:m012-0118","start":118,"end":120,"surface":"老子","kind":"person","person_id":"881_5eh_yg3","status":"contextual_provisional"},{"id":"c-shiji-127-rizhe:m012-0145","start":145,"end":147,"surface":"老子","kind":"person","person_id":"881_5eh_yg3","status":"contextual_provisional"}],"chapter_id":"c-shiji-127-rizhe","book_id":"b-shiji-127","work_id":"w-shiji","source_id":"s-shiji127-rizhe"},{"id":"c-shiji-127-rizhe:p017","text":"居三日，宋忠見賈誼於殿門外，乃相引屏語相謂自嘆曰：「道高益安，勢高益危。居赫赫之勢，失身且有日矣。夫卜而有不審，不見奪糈；爲人主計而不審，身無所處。此相去遠矣，猶天冠地屨也。此老子之所謂『無名者萬物之始』也。天地曠曠，物之熙熙，或安或危，莫知居之。我與若，何足預彼哉！彼久而愈安，雖曾氏之義未有以異也。」","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-127-rizhe:m017-0004","start":4,"end":6,"surface":"宋忠","kind":"person","person_id":"a5t_kff_al9","status":"contextual_provisional"},{"id":"c-shiji-127-rizhe:m017-0007","start":7,"end":9,"surface":"賈誼","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-127-rizhe:m017-0088","start":88,"end":90,"surface":"老子","kind":"person","person_id":"881_5eh_yg3","status":"contextual_provisional"},{"id":"c-shiji-127-rizhe:m017-0141","start":141,"end":143,"surface":"曾氏","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-127-rizhe","book_id":"b-shiji-127","work_id":"w-shiji","source_id":"s-shiji127-rizhe"},{"id":"c-shiji-127-rizhe:p020","text":"褚先生曰：臣爲郎時，游觀長安中，見卜筮之賢大夫，觀其起居行歩，坐起自動，誓正其衣冠而當鄕人也，有君子之風。見性好解婦來卜，對之顏色嚴振，未嘗見齒而笑也。從古以來，賢者避世，有居止舞澤者，有居民閒閉口不言，有隱居卜筮閒以全身者。夫司馬季主者，楚賢大夫，游學長安，通易經，術黃帝、老子，博聞遠見。觀其對二大夫貴人之談言，稱引古明王聖人道，固非淺聞小數之能。及卜筮立名聲千里者，各往往而在。傳曰：「富爲上，貴次之；既貴各各學一伎能立其身。」黃直，大夫也；陳君夫，婦人也：以相馬立名天下。齊張仲、曲成侯以善擊刺學用劍，立名天下。留長孺以相彘立名。滎陽褚氏以相牛立名。能以伎能立名者甚多，皆有高世絶人之風，何可勝言。故曰：「非其地，樹之不生；非其意，教之不成。」夫家之教子孫，當視其所以好，好含茍生活之道，因而成之。故曰：「制宅命子，足以觀士；子有處所，可謂賢人。」臣爲郎時，與太卜待詔爲郎者同署，言曰：「孝武帝時，聚會占家問之，某日可取婦乎？五行家曰可，堪輿家曰不可，建除家曰不吉，叢辰家曰大凶，歷家曰小凶，天人家曰小吉，太一家曰大吉。辯訟不決，以狀聞。制曰：『避諸死忌，以五行爲主。』」人取於五行者也。","annotation_status":"in_progress","text_layer":"witness_appended_chu_note","mentions":[{"id":"c-shiji-127-rizhe:m020-0000","start":0,"end":3,"surface":"褚先生","kind":"person","person_id":"fhc_80g_qnq","status":"contextual_provisional"},{"id":"c-shiji-127-rizhe:m020-0017","start":17,"end":23,"surface":"卜筮之賢大夫","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-127-rizhe:m020-0114","start":114,"end":118,"surface":"司馬季主","kind":"person","person_id":"r8r_74l_t6d","status":"contextual_provisional"},{"id":"c-shiji-127-rizhe:m020-0135","start":135,"end":137,"surface":"黃帝","kind":"person","person_id":"xpw_io6_vl8","status":"contextual_provisional"},{"id":"c-shiji-127-rizhe:m020-0138","start":138,"end":140,"surface":"老子","kind":"person","person_id":"88