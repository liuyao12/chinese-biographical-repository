currence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-040-ws2606035-jiachong-family"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin040-jiachong-family-041","subject_person_id":"2sz_6wo_ng7","predicate":"maternal_role","object_person_id":"q9s_7gg_7hu","status":"source_attested","qualifiers":{"received_family_frame":{"kind":"punctuated_received_family_frame","rule":"two_granddaughters_marital_context","roles":{"son":"c-jinshu-040-jiachong-family:p018:m0167","mother":"c-jinshu-040-jiachong-family:p018:m0169","emperor":"c-jinshu-040-jiachong-family:p018:m0172","husband":"c-jinshu-040-jiachong-family:p018:m0177","wife":"c-jinshu-040-jiachong-family:p018:m0179","grandfather":"c-jinshu-040-jiachong-family:p018:m0183"},"clause_start":164,"clause_end":189,"paragraph_sha256":"12a1e61217d5ef6fd9af40f11b04492412744f8c088218e28ceaeee7ad92fe4c","revision_id":2606035},"source_term":"母","role":"mother_unspecified","biological_mother":null,"father_person_id":null},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-040","chapter_id":"c-jinshu-040-jiachong-family","paragraph_id":"c-jinshu-040-jiachong-family:p018","source_id":"s-jinshu-040-ws2606035-jiachong-family","quote":"初，充前妻李氏淑美有才行，生二女褒、裕，褒一名荃，裕一名浚。父豐誅，李氏坐流徙。後娶城陽太守郭配女，即廣城君也。武帝踐阼，李以大赦得還，帝特詔充置左右夫人，充母亦敕充迎李氏。郭槐怒，攘袂數充曰：「刊定律令，爲佐命之功，我有其分。李那得與我並！」充乃答詔，托以謙沖，不敢當兩夫人盛禮，實畏槐也。而荃爲齊王攸妃，欲令充遣郭而還其母。時沛國劉含母，及帝舅羽林監王虔前妻，皆毌丘儉孫女。此例既多，質之禮官，俱不能決。雖不遣後妻，多異居私通。充自以宰相爲海內準則，乃爲李築室於永年里而不往來。荃、浚每號泣請充，充竟不往。會充當鎮關右，公卿供帳祖道，荃、浚懼充遂去，乃排幔出於坐中，叩頭流血，向充及群僚陳母應還之意。眾以荃王妃，皆驚起而散。充甚愧愕，遣黃門將宮人扶去。既而郭槐女爲皇太子妃，帝乃下詔斷如李比皆不得還，後荃恚憤而薨。初，槐欲省李氏，充曰：「彼有才氣，卿往不如不往。」及女爲妃，槐乃盛威儀而去。既入戸，李氏出迎，槐不覺腳屈，因遂再拜。自是充每出行，槐輒使人尋之，恐其過李也。初，充母柳見古今重節義，竟不知充與成濟事，以濟不忠，數追罵之。侍者聞之，無不竊笑。及將亡，充問所欲言，柳曰：「我教汝迎李新婦尚不肯，安問他事！」遂無言。及充薨後，李氏二女乃欲令其母祔葬，賈后弗之許也。及后廢，李氏乃得合葬。李氏作《女訓》行於世。","subject_person_mention_id":"c-jinshu-040-jiachong-family:p018:m0167","object_person_mention_id":"c-jinshu-040-jiachong-family:p018:m0169"}],"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"id":"nc-jin040-jiachong-045","person_id":"2sz_6wo_ng7","surname":"劉","ming":"含","additional_names":[],"chapter_id":"c-jinshu-040-jiachong-family","paragraph_id":"c-jinshu-040-jiachong-family:p018","person_mention_id":"c-jinshu-040-jiachong-family:p018:m0167","quote":"初，充前妻李氏淑美有才行，生二女褒、裕，褒一名荃，裕一名浚。父豐誅，李氏坐流徙。後娶城陽太守郭配女，即廣城君也。武帝踐阼，李以大赦得還，帝特詔充置左右夫人，充母亦敕充迎李氏。郭槐怒，攘袂數充曰：「刊定律令，爲佐命之功，我有其分。李那得與我並！」充乃答詔，托以謙沖，不敢當兩夫人盛禮，實畏槐也。而荃爲齊王攸妃，欲令充遣郭而還其母。時沛國劉含母，及帝舅羽林監王虔前妻，皆毌丘儉孫女。此例既多，質之禮官，俱不能決。雖不遣後妻，多異居私通。充自以宰相爲海內準則，乃爲李築室於永年里而不往來。荃、浚每號泣請充，充竟不往。會充當鎮關右，公卿供帳祖道，荃、浚懼充遂去，乃排幔出於坐中，叩頭流血，向充及群僚陳母應還之意。眾以荃王妃，皆驚起而散。充甚愧愕，遣黃門將宮人扶去。既而郭槐女爲皇太子妃，帝乃下詔斷如李比皆不得還，後荃恚憤而薨。初，槐欲省李氏，充曰：「彼有才氣，卿往不如不往。」及女爲妃，槐乃盛威儀而去。既入戸，李氏出迎，槐不覺腳屈，因遂再拜。自是充每出行，槐輒使人尋之，恐其過李也。初，充母柳見古今重節義，竟不知充與成濟事，以濟不忠，數追罵之。侍者聞之，無不竊笑。及將亡，充問所欲言，柳曰：「我教汝迎李新婦尚不肯，安問他事！」遂無言。及充薨後，李氏二女乃欲令其母祔葬，賈后弗之許也。及后廢，李氏乃得合葬。李氏作《女訓》行於世。","status":"editorial_provisional","human_reviewed":false,"model":null,"note":"本源所見稱名；按中古姓氏用法分讀，保原字及逐名錨，不作全庫權威選字。","fixed_biography_name_binding":{"kind":"fixed_punctuated_biography_name","source_revision":2606035,"paragraph_sha256":"12a1e61217d5ef6fd9af40f11b04492412744f8c088218e28ceaeee7ad92fe4c","mode":"full_name","name_mention_id":"c-jinshu-040-jiachong-family:p018:m0167","zi_mention_id":null,"alias_bindings":[],"title_prefix":null,"title_suffix":null},"work_