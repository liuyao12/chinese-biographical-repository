n"}],"qualifiers":{"source_term":"括母問奢其故","historicity":"historical_tradition"},"interpretation_note":"只保存明示子與母的來源主張；括母未名不補姓名，事其父及妾自稱不單憑字面推婚姻身分，繼位本身不作父子證據。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-shiji073-002","person_id":"ja0_1pr_vhk","event_type":"death","status":"source_attested","date_expression":"四十七年","source_term":"秦軍射殺趙括","evidence":[{"chapter_id":"c-shiji-073-baiwang","source_id":"s-shiji-073-baiwang","paragraph_id":"c-shiji-073-baiwang:p004","person_mention_id":"c-shiji-073-baiwang:m004-0165","quote_passage_ref":"data/corpus/shiji/073.json"},{"chapter_id":"c-shiji-073-baiwang","source_id":"s-shiji-073-baiwang","paragraph_id":"c-shiji-073-baiwang:p005","person_mention_id":"c-shiji-073-baiwang:m005-0045","quote_passage_ref":"data/corpus/shiji/073.json"}],"interpretation_note":"僅保存具名者明示死亡；被虜、王降、病及群體死亡不轉為個人死亡。秦二世時皆已死是已死陳述，不當兩人同年或秦二世年內死亡；原月日不轉公曆。","reviewer":"Codex（AI 代理）","human_reviewed":false,"date_context":{"kind":"continuous_paragraphs","paragraph_ids":["c-shiji-073-baiwang:p004","c-shiji-073-baiwang:p005"],"rationale":"第四段四十七年長平戰事、趙括代將，連續第五段至九月趙括戰死；兩段均有同人錨點，原九月保留於引句，不當公曆月。"},"normalized_date":{"era":"BCE","era_year":260,"year":-259,"year_numbering":"astronomical","precision":"year","status":"editorial_provisional","original_quote":"四十七年，秦使左庶長王龁攻韓，取上黨。上黨民走趙。趙軍長平，以按據上黨民。四月，龁因攻趙。趙使廉頗將。趙軍士卒犯秦斥兵，秦斥兵斬趙裨將茄。六月，陷趙軍，取二鄣四尉。七月，趙軍筑壘壁而守之。秦又攻其壘，取二尉，敗其陣，奪西壘壁。廉頗堅壁以待秦，秦數挑戰，趙兵不出。趙王數以為讓。而秦相應侯又使人行千金於趙為反閒，曰：「秦之所惡，獨畏馬服子趙括將耳，廉頗易與，且降矣。」趙王既怒廉頗軍多失亡，軍數敗，又反堅壁不敢戰，而又聞秦反閒之言，因使趙括代廉頗將以擊秦。秦聞馬服子將，乃陰使武安君白起為上將軍。而王龁為尉裨將，令軍中有敢泄武安君將者斬。趙括至，則出兵擊秦軍。秦軍詳敗而走，張二奇兵以劫之。趙軍逐勝，追造秦壁。壁堅拒不得入，而秦奇兵二萬五千人絕趙軍後，又一軍五千騎絕趙壁閒，趙軍分而為二，糧道絕。而秦出輕兵擊之。趙戰不利，因筑壁堅守，以待救至。秦王聞趙食道絕，王自之河內，賜民爵各一級，發年十五以上悉詣長平，遮絕趙救及糧食。","evidence":[{"chapter_id":"c-shiji-073-baiwang","source_id":"s-shiji-073-baiwang","paragraph_id":"c-shiji-073-baiwang:p004","person_mention_id":"c-shiji-073-baiwang:m004-0165","quote_passage_ref":"data/corpus/shiji/073.json"},{"chapter_id":"c-shiji-073-baiwang","source_id":"s-shiji-073-baiwang","paragraph_id":"c-shiji-073-baiwang:p005","person_mention_id":"c-shiji-073-baiwang:m005-0045","quote_passage_ref":"data/corpus/shiji/073.json"}],"references":[{"title":"〈六國年表〉秦紀年欄","url":"https://zh.wikisource.org/w/index.php?title=史記/卷015&oldid=2607002","quote":"四十七。白起破趙長平，殺卒四十五萬。","scope":"received_regnal_year_attestation","image_verified":false,"table_cell_id":"shiji-015-r217-c02"},{"title":"〈六國年表〉數位年欄","url":"https://zh.wikisource.org/w/index.php?title=史記/卷015&oldid=2607002","quote":"260","scope":"digital_editorial_regnal_year_equivalence_only","image_verified":false,"table_cell_id":"shiji-015-r217-c00"}],"rationale":"四十七年長平戰事連續第五段至九月趙括戰死，按原年號與年表四十七年及數位年欄暫定前260年。年表未獨立記趙括死亡，不作同名死亡互證；月份只留原文，未核影像及曆表、不推公曆日。","reviewer":"Codex（AI 代理）","human_reviewed":false}}],"mentions":[{"id":"c-shiji-043-zhao:m104-0012","start":12,"end":14,"surface":"趙括","kind":"person","person_id":"ja0_1pr_vhk","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p104","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m104-0020","start":20,"end":22,"surface":"趙括","kind":"person","person_id":"ja0_1pr_vhk","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p104","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m104-0023","start":23,"end":25,"surface":"趙括","kind":"person","person_id":"ja0_1pr_vhk","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p104","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-073-baiwang:m004-0165","start":165,"end":170,"surface":"馬服子趙括","kind":"person","person_id":"ja0_1pr_vhk","status":"contextual_provisional","paragraph_id":"c-shiji-073-baiwang:p004","chapter_id":"c-shiji-073-baiwang"},{"id":"c-shiji-073-baiwang:m004-0217","start":217,"end":219,"surface":"趙括","kind":"person","person_id":"ja0_1pr_vhk","status":"contextual_provisional","paragraph_id":"c-