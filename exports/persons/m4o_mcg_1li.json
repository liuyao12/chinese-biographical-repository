s_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-jin059-jiong-baitou","person_id":"m4o_mcg_1li","event_type":"death","source_term":"即收殺之","source_anchor":{"paragraph_id":"c-jinshu-059-jiong:p003","start":249,"end":253,"surface":"即收殺之"},"date_expression":null,"status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-059","source_id":"s-jinshu-059-ws2650517-jiong","chapter_id":"c-jinshu-059-jiong","paragraph_id":"c-jinshu-059-jiong:p003","quote":"冏於是輔政，居攸故宮，置掾屬四十人。大築第館，北取五穀市，南開諸署，毀壞廬舍以百數，使大匠營制，與西宮等。鑿千秋門牆以通西閣，後房施鐘懸，前庭舞八佾，沈於酒色，不入朝見。坐拜百官，符敕三臺，選舉不均，惟寵親昵。以車騎將軍何勖領中領軍。封葛𣄣為牟平公，路秀小黃公，衛毅陰平公，劉真安鄉公，韓泰封丘公，號曰「五公」，委以心膂。殿中御史桓豹奏事，不先經冏府，即考竟之。於是朝廷側目，海內失望矣。南陽處士鄭方露版極諫，主簿王豹屢有箴規，冏並不能用，遂奏豹殺之。有白頭公入大司馬府大呼，言有兵起，不出甲子旬。即收殺之。","person_mention_id":"c-jinshu-059-jiong:p003:m0073"}],"interpretation_note":"僅本篇明載死亡；不以沒于作死亡，不從報齡倒生年。無可綁年者留null。","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-jinshu-059-jiong:p003:m0073","start":227,"end":230,"surface":"白頭公","kind":"person","person_id":"m4o_mcg_1li","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。","paragraph_id":"c-jinshu-059-jiong:p003","chapter_id":"c-jinshu-059-jiong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-059-jiong:p003","text":"冏於是輔政，居攸故宮，置掾屬四十人。大築第館，北取五穀市，南開諸署，毀壞廬舍以百數，使大匠營制，與西宮等。鑿千秋門牆以通西閣，後房施鐘懸，前庭舞八佾，沈於酒色，不入朝見。坐拜百官，符敕三臺，選舉不均，惟寵親昵。以車騎將軍何勖領中領軍。封葛𣄣為牟平公，路秀小黃公，衛毅陰平公，劉真安鄉公，韓泰封丘公，號曰「五公」，委以心膂。殿中御史桓豹奏事，不先經冏府，即考竟之。於是朝廷側目，海內失望矣。南陽處士鄭方露版極諫，主簿王豹屢有箴規，冏並不能用，遂奏豹殺之。有白頭公入大司馬府大呼，言有兵起，不出甲子旬。即收殺之。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-059-jiong:p003:m0058","start":0,"end":1,"surface":"冏","kind":"person","person_id":"ee