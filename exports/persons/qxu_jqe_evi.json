:m024-0224","start":224,"end":226,"surface":"項冠","kind":"person","person_id":"uxv_exs_5k3","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0251","start":251,"end":253,"surface":"王武","kind":"person","person_id":"qxu_jqe_evi","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0275","start":275,"end":277,"surface":"王武","kind":"person","person_id":"qxu_jqe_evi","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0279","start":279,"end":281,"surface":"桓嬰","kind":"person","person_id":"snk_jy6_dgf","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0304","start":304,"end":306,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0315","start":315,"end":317,"surface":"韓信","kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m024-0327","start":327,"end":328,"surface":"嬰","kind":"person","person_id":"sj9_pfu_fwh","status":"contextual_provisional"}],"chapter_id":"c-shiji-095-fankuang","book_id":"b-shiji-095","work_id":"w-shiji","source_id":"s-shiji-095-fankuang"},{"id":"c-shiji-098-fujin:p006","text":"從定三秦。別西擊章平軍於隴西，破之，定隴西六縣，所將卒斬車司馬、候各四人，騎長十二人。從東擊楚，至彭城。漢軍敗還，保雍丘，去擊反者王武等。略梁地，別將擊邢說軍菑南，破之，身得說都尉二人，司馬、候十二人，降吏卒四千一百八十人。破楚軍滎陽東。三年，賜食邑四千二百戶。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-098-fujin:m006-0008","start":8,"end":10,"surface":"章平","kind":"person","person_id":"fs1_3m9_rj3","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m006-0065","start":65,"end":67,"surface":"王武","kind":"person","person_id":"qxu_jqe_evi","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m006-0076","start":76,"end":78,"surface":"邢說","kind":"person","person_id":"3qe_csy_8ad","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m006-0087","start":87,"end":88,"surface":"說","kind":"person","person_id":"3qe_csy_8ad","status":"contextua