original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-034-yanghu:p008:m0136","start":136,"end":138,"surface":"李憙","kind":"person","person_id":"k6u_jyu_5m3","status":"source_explicit","paragraph_id":"c-jinshu-034-yanghu:p008","chapter_id":"c-jinshu-034-yanghu"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-034-yanghu:p008","text":"今天下自服化以來，方漸八年，雖側席求賢，不遺幽賤，然臣不爾推有德，達有功，使聖聽知勝臣者多，未達者不少。假令有遺德於版築之下，有隱才于屠釣之間，而朝議用臣不以為非，臣處之不以為愧，所失豈不大哉！臣忝竊雖久，未若今日兼文武之極寵，等宰輔之高位也。且臣雖所見者狹，據今光祿大夫李憙執節高亮，在公正色；光祿大夫魯芝潔身寡欲，和而不同；光祿大夫李胤清亮簡素，立身在朝，皆服事華髮，以禮終始。","text_layer":"received_chapter","source_position":{"raw_start":1485,"raw_end":1676,"raw_character_offsets":[1485,1486,1487,1488,1489,1490,1491,1492,1493,1494,1495,1496,1497,1498,1499,1500,1501,1502,1503,1504,1505,1506,1507,1508,1509,1510,1511,1512,1513,1514,1515,1516,1517,1518,1519,1520,1521,1522,1523,1524,1525,1526,1527,1528,1529,1530,1531,1532,1533,1534,1535,1536,1537,1538,1539,1540,1541,1542,1543,1544,1545,1546,1547,1548,1549,1550,1551,1552,1553,1554,1555,1556,1557,1558,1559,1560,1561,1562,1563,1564,1565,1566,1567,1568,1569,1570,1571,1572,1573,1574,1575,1576,1577,1578,1579,1580,1581,1582,1583,1584,1585,1586,1587,1588,1589,1590,1591,1592,1593,1594,1595,1596,1597,1598,1599,1600,1601,1602,1603,1604,1605,1606,1607,1608,1609,1610,1611,1612,1613,1614,1615,1616,1617,1618,1619,1620,1621,1622,1623,1624,1625,1626,1627,1628,1629,1630,1631,1632,1633,1634,1635,1636,1637,1638,1639,1640,1641,1642,1643,1644,1645,1646,1647,1648,1649,1650,1651,1652,1653,1654,1655,1656,1657,1658,1659,1660,1661,1662,1663,1664,1665,1666,1667,1668,1669,1670,1671,1672,1673,1674,1675],"first_line":25,"last_line":25,"revision_id":2567662,"projection_sha256":"5bae4ef92b922d507f6546e66c458493