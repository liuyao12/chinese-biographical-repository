ook_id":"b-jinshu-080","work_id":"w-jinshu","source_id":"s-jinshu-080-wangxizhi-family"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-032-jin080-xumai:daoshi","text":"會有道士許邁者，朝臣時望多稱其得道。帝從容問焉，答曰：「邁是好山水人，本無道術","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-032-jin080-xumai:daoshi:m0004","start":4,"end":6,"surface":"許邁","person_id":"972_dh9_hz4","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。"},{"id":"c-jinshu-032-jin080-xumai:daoshi:m0028","start":28,"end":29,"surface":"邁","person_id":"972_dh9_hz4","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。"}],"source_quote":{"witness":"jin32","quote":"會有道士許邁者，朝臣時望多稱其得道。帝從容問焉，答曰：「邁是好山水人，本無道術","source_layer":"正文","raw_start":5855,"raw_end":5894,"raw_line":76},"chapter_id":"c-jinshu-032-jin080-xumai","book_id":"b-jinshu-032","work_id":"w-jinshu","source_id":"s-jinshu-032-jin080-xumai"},{"id":"c-jinshu-080-wangxizhi-family:line068","text":"羲之既去官，與東土人士盡山水之遊，弋釣為娛。又與道士許邁共修服食，采藥石不遠千里，遍游東中諸郡，窮諸名山，泛滄海，歎曰：「我卒當以樂死。」謝安嘗謂羲之曰：「中年以來，傷於哀樂，與親友別，輒作數日惡。」羲之曰：「年在桑榆，自然至此。頃正賴絲竹陶寫，恆恐兒輩覺，損其歡樂之趣。」朝廷以其誓苦，亦不復徵之。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-080-wangxizhi-family:line068:m0000","start":0,"end":2,"surface":"羲之","person_id":"326_faf_cd3","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。"},{"id":"c-jinshu-080-wangxizhi-family:line068:m0026","start":26,"end":28,"surface":"許邁","person_id":"972_dh9_hz4","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。"},{"id":"c-jinshu-080-wangxizhi-family:line068:m0069","start":69,"end":71,"surface":"謝安","person_id":"aa6_83c_juy_B","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。"},{"id":"c-jinshu-080-wangxizhi-family:line068:m0073","start":73,"end":75,"surface":"羲之","person_id":"326_faf_cd3","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。"},{"id":"c-jinshu-080-wangxizhi-family:line068:m0100","start":100,"end":102,"surface":"羲之","person_id":"326_faf_cd3","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。"}],"source_position":{"first_line":68,"last_line":68,"raw_start":4586,"raw_end":4738,"revision_id":2603570},"chapter_id":"c-jinshu-080-wangxizhi-family","book_id":"b-jinshu-080","work_id":"w-jinshu","source_id":"s-jinshu-080-wangxizhi-family"},{"id":"c-jinshu-080-wangxizhi-family:line116","text":"未幾，獻之遇疾，家人為上章，道家法應首過，問其有何得失。對曰：「不覺餘事，惟憶與郗家離婚。」獻之前妻，郗曇女也。俄而卒於官。安僖皇后立，以後父追贈侍中、特進、光祿大夫、太宰，諡曰憲。無子，以兄子靜之嗣，位至義興太守。時議者以為羲之草隸，江左中朝莫有及者，獻之骨力遠不及父，而頗有媚趣。桓玄雅愛其父子書，各為一帙，置左右以玩之。始羲之所與共游者許邁。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-080-wangxizhi-family:line116:m0003","start":3,"end":5,"surface":"獻之","person_id":"sm1_jfi_7k2","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。"},{"id":"c-jinshu-080-wangxizhi-family:line116:m0046","start":46,"end":48,"surface":"獻之","person_id":"sm1_jfi_7k2","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。"},{"id":"c-jinshu-080-wangxizhi-family:line116:m0051","start":51,"end":53,"surface":"郗曇","person_id":"e5k_f2i_cog","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。"},{"id":"c-jinshu-080-wangxizhi-family:line116:m0062","start":62,"end":66,"surface":"安僖皇后","person_id":"sm1_jfi_7k2_A","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。"},{"id":"c-jinshu-080-wangxizhi-family:line116:m0097","start":97,"end":99,"surface":"靜之","person_id":"326_faf_cd3_*A","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期