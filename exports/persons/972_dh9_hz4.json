s":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-w080-xu-sun","subject_person_id":"972_dh9_hz4","object_person_id":"4xl_1hw_6cg_A","predicate":"spouse","qualifiers":{"source_term":"遣婦孫氏還家"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-080","chapter_id":"c-jinshu-080-wangxizhi-family","source_id":"s-jinshu-080-wangxizhi-family","paragraph_id":"c-jinshu-080-wangxizhi-family:line120","quote":"許邁，字叔玄，一名映，丹陽句容人也。家世士族，而邁少恬靜，不慕仕進。未弱冠，嘗造郭璞，璞為之筮，遇《泰》之《大畜》，其上六爻發。璞謂曰：「君元吉自天，宜學升遐之道。」時南海太守鮑靚隱跡潛遁，人莫之知。邁乃往候之，探其至要。父母尚存，未忍違親。謂余杭懸霤山近延陵之茅山，是洞庭西門，潛通五嶽，陳安世、茅季偉常所遊處，於是立精舍於懸霤，而往來茅嶺之洞室，放絕世務，以尋仙館，朔望時節還家定省而已。父母既終，乃遣婦孫氏還家，遂攜其同志遍游名山焉。","subject_person_mention_id":"c-jinshu-080-wangxizhi-family:line120:m0000","object_person_mention_id":"c-jinshu-080-wangxizhi-family:line120:m0204"}],"interpretation_note":"許邁父母亡後遣妻孫氏還家。","status":"source_attested","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-032-jin080-xumai:daoshi:m0004","start":4,"end":6,"surface":"許邁","person_id":"972_dh9_hz4","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。","paragraph_id":"c-jinshu-032-jin080-xumai:daoshi","chapter_id":"c-jinshu-032-jin080-xumai"},{"id":"c-jinshu-032-jin080-xumai:daoshi:m0028","start":28,"end":29,"surface":"邁","person_id":"972_dh9_hz4","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。","paragraph_id":"c-jinshu-032-jin080-xumai:daoshi","chapter_id":"c-jinshu-032-jin080-xumai"},{"id":"c-jinshu-080-wangxizhi-family:line068:m0026","start":26,"end":28,"surface":"許邁","person_id":"972_dh9_hz4","kind":"person","stat