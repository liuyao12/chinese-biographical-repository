ntime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-049-shixie-complete:p010:m0041","surface":"陳時","start":41,"end":43,"kind":"person","person_id":"z49_zy2_ymh","status":"contextual_provisional","paragraph_id":"c-sanguozhi-049-shixie-complete:p010","chapter_id":"c-sanguozhi-049-shixie-complete"},{"id":"c-sanguozhi-049-shixie-complete:p010:m0058","surface":"時","start":58,"end":59,"kind":"person","person_id":"z49_zy2_ymh","status":"contextual_provisional","paragraph_id":"c-sanguozhi-049-shixie-complete:p010","chapter_id":"c-sanguozhi-049-shixie-complete"},{"id":"c-sanguozhi-060-lvdai:line051:m0030","start":30,"end":32,"surface":"陳時","kind":"person","person_id":"z49_zy2_ymh","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-060-lvdai:line051","chapter_id":"c-sanguozhi-060-lvdai"},{"id":"c-sanguozhi-060-lvdai:line051:m0072","surface":"時","start":72,"end":73,"kind":"person","person_id":"z49_zy2_ymh","status":"contextual_provisional","interpretation_note":"按本段具名及前後親稱、官職定位。","paragraph_id":"c-sanguozhi-060-lvdai:line051","chapter_id":"c-sanguozhi-060-lvdai"}],"relations":[],"title_holdings":[{"id":"t-wu060-t-wu060-lvdai17","person_id":"z49_zy2_ymh","kind":"office","title":"校尉","mode":"attestation","status":"source_attested","effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本句所載職官，任免時間未詳。","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-060","chapter_id":"c-sanguozhi-060-lvdai","source_id":"s-sanguozhi-060-lvdai","paragraph_id":"c-sanguozhi-060-lvdai:line051","quote":"　　交阯太守士燮卒，權以燮子徽為安遠將軍，領九真太守，以校尉陳時代燮。岱表分海南三郡為交州，以將軍戴良為刺史，海東四郡為廣州，岱自為刺史。遣良與時南入，而徽不承命，舉兵戍海口以拒良等。岱於是上疏請討徽罪，督兵三千人晨夜浮海。或謂岱曰：\"徽藉累世之恩，為一州所附，未易輕也。\"岱曰：\"今徽雖懷逆計，未虞吾之卒至，若我潛軍輕舉，掩其無備，破之必也。稽留不速，使得生心，嬰城固守，七郡百蠻，雲合響應，雖有智者，誰能圖之?\"遂行，過合浦，與良俱進。徽聞岱至，果大震怖，不知所出，即率兄弟六人肉袒迎岱。岱皆斬送其首，徽大將甘醴，桓治等率吏民攻岱，岱奮擊大破之，進封番禺侯。於是除廣州，復為交州如故。岱既定交州，復進討九真，斬獲以萬數。又遣從事南宣國化，暨徼外扶南、林邑、堂明諸王，各遣使奉貢。權嘉其功，進拜鎮南將軍。","person_mention_id":"c-sanguozhi-060-lvdai:line051:m0030"}],"attestations":[{"id":"t-wu060-t-wu060-lvdai17:a","paragraph_id":"c-sanguozhi-060-lvdai:line051","person_mention_id":"c-sanguozhi-060-lvdai:line051:m0030","start":28,"end":30,"surface":"校尉","usage":"narrative","date_expression":null}],"human_reviewed":false,"reviewer":"Codex（AI 代理）","model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-049-shixie-complete:p010","text":"　　權以交阯縣遠，乃分合浦以北為廣州，呂岱為刺史；交阯以南為交州，戴良為刺史。又遣陳時代燮為交阯太守。岱留南海，良與時俱前行到合浦，而燮子徽自署交阯太守，發宗兵拒良。良留合浦。交阯桓鄰，燮舉吏也，叩頭諫徽使迎良，徽怒，笞殺鄰。鄰兄治子發又合宗兵擊徽，徽閉門城守，治等攻之數月不能下，乃約和親，各罷兵還。而呂岱被詔誅徽，自廣州將兵晝夜馳入，過合浦，與良俱前。壹子中郎將匡與岱有舊，岱署匡師友從事，先移書交阯，告喻禍福，又遣匡見徽，說令服罪，雖失郡守，保無他憂。岱尋匡後至，徽兄祗，弟幹、頌等六人肉袒奉迎。岱謝令復服，前至郡下。明旦早施帳幔，請徽兄弟以次入，賓客滿坐。岱起，擁節讀詔書，數徵罪過，左右因反縛以出，即皆伏誅，傳首詣武昌。壹、䵋、匡後出，權原其罪，及燮質子廞，皆免為庶人。數歲，壹、䵋坐法誅。廞病卒，無子，妻寡居，詔在所月給俸米，賜錢四十萬。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":49,"last_line":49,"raw_start":6193,"raw_end":6700,"raw_character_offsets":[6193,6194,6195,6196,6197,6198,6199,6200,6201,6202,6203,6204,6205,6206,6207,6208,6209,6210,6211,6212,6213,6214,6215,6216,6217,6218,6219,6220,6221,6222,6223,6224,6225,6226,6227,6228,6229,6230,6231,6232,6233,6234,6235,6236,6237,6238,6239,6240,6241,6242,6243,6244,6245,6246,6247,6248,6249,6250,6251,6252,6253,6254,6255,6256,6257,6258,6259,6260,6261,6262,6263,6264,6265,6266,6267,6268,6269,6270,6271,6272,6273,6274,6275,6276,6277,6278,6279,6280,6281,6282,6283,6284,6285,6286,6287,6288,6289,6290,6291,6292,6293,6294,6295,6296,6297,6298,6299,6300,6301,6302,6303,6304,6305,6306,6307,6308,6309,6310,6311,6312,6313,6314,6315,6316,6317,6318,6319,6320,6321,6322,6323,6324,6325,6326,6327,6328,6329,6330,6331,6332,6333,6334,6335,6336,6337,6338,6339,6340,6341,6342,6343,6344,6345,6346,6347,6348,6349,6