"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji012-030","person_id":"1gk_6c4_iou","surfaces":["帝","泰帝"],"scope":"same_chapter","chapter_ids":["c-shiji-012-wudi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-012-wudi:p026","quote":"其年，既滅南越，上有嬖臣李延年以好音見。上善之，下公卿議，曰：「民閒祠尚有鼓舞之樂，今郊祠而無樂，豈稱乎？」公卿曰：「古者祀天地皆有樂，而神祇可得而禮。」或曰：「泰帝使素女鼓五十弦瑟，悲，帝禁不止，故破其瑟為二十五弦。」於是塞南越，禱祠泰一、后土，始用樂舞，益召歌兒，作二十五弦及箜篌瑟自此起。"}],"rationale":"依本篇封禪、方士、授官與神異引語的明示語境判讀異稱；神祇或傳說不轉為已確證生平，跨篇同指仍待版本與專門研究核對。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-012-wudi:p026","text":"其年，既滅南越，上有嬖臣李延年以好音見。上善之，下公卿議，曰：「民閒祠尚有鼓舞之樂，今郊祠而無樂，豈稱乎？」公卿曰：「古者祀天地皆有樂，而神祇可得而禮。」或曰：「泰帝使素女鼓五十弦瑟，悲，帝禁不止，故破其瑟為二十五弦。」於是塞南越，禱祠泰一、后土，始用樂舞，益召歌兒，作二十五弦及箜篌瑟自此起。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-012-wudi:m026-0012","start":12,"end":15,"surface":"李延年","kind":"person","person_id":"9x9_12x_dhb","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m026-0081","start":81,"end":83,"surface":"泰帝","kind":"person","person_id":"1gk_6c4_iou","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m026-0084","start":84,"end":86,"surface":"素女","kind":"person","person_id":"duy_acg_01x","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m026-0094","start":94,"end":95,"surface":"帝","kind":"person","person_id":"1gk_6c4_iou","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m026-0118","start":118,"end":120,"surface":"泰一","kind":"unresolved","person_id":null,"status":"unresolved","note":"神祇、群體、匿名者或未定指代，保留來源，不補未見姓名與成員。"},{"id":"c-shiji-012-wudi:m026-0121","start":121,"end":123,"surface":"后土","kind":"unresolved","person_id":null,"status":"unresolved","note":"神祇、群體、匿名者或未定指代，保留來源，不補未見姓名與成員。"}],"chapter_id":"c-shiji-012-wudi","book_id":"b-shiji-012","work_id":"w-shiji","source_id":"s-shiji-