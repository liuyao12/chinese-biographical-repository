:"c-shiji-117-xiangru:m024-0057","start":57,"end":60,"surface":"葛天氏","kind":"person","person_id":"p86_1w7_bns","status":"contextual_provisional","paragraph_id":"c-shiji-117-xiangru:p024","chapter_id":"c-shiji-117-xiangru"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji117-getianshi-commentary","person_id":"p86_1w7_bns","surfaces":["葛天氏"],"scope":"same_chapter","chapter_ids":["c-shiji-117-xiangru"],"status":"contextual_provisional","confidence_level":"high","identification_basis":{"kind":"ancient_commentary_explicit_identification","target_mention_ids":["c-shiji-117-xiangru:m024-0057"],"historical_event_attendance_not_inferred":true},"evidence":[{"chapter_id":"c-shiji-117-xiangru","source_id":"s-shiji117-xiangru","paragraph_id":"c-shiji-117-xiangru:p024","quote":"「於是乎遊戲懈怠，置酒乎昊天之台，張樂乎轇輵之宇；撞千石之鐘，立萬石之钜；建翠華之旗，樹靈鼉之鼓。奏陶唐氏之舞，聽葛天氏之歌，千人唱，萬人和，山陵為之震動，川穀為之蕩波。巴俞宋蔡，淮南于遮，文成顛歌，族舉遞奏，金鼓迭起，鏗鎗鐺剸，洞心駭耳。荊吳鄭衛之聲，韶濩武象之樂，陰淫案衍之音，鄢郢繽紛，激楚結風，俳優侏儒，狄鞮之倡，所以娛耳目而樂心意者，麗靡爛漫於前，靡曼美色於後。","mention_ids":["c-shiji-117-xiangru:m024-0057"]}],"references":[{"title":"《史記集解》卷一一七引《漢書音義》及郭璞注","url":"https://github.com/kanripo/KR2a0002/blob/73c4d2ba067d99a6de924ac952fd6921a958c7e7/KR2a0002_117.txt#L310-L311","source_commit":"73c4d2ba067d99a6de924ac952fd6921a958c7e7","source_blob":"ccded97eee2542083010172d857d6251a09a126c","quote":"奏陶唐氏之舞聽葛天氏之歌(漢書音義曰葛天氏古帝王之號也呂氏春秋曰葛天氏之樂三人操牛尾投足以歌)","verified_extent":{"start_line":310,"end_line":311},"scope":"ancient_commentary_identification","image_verified":false}],"rationale":"《史記集解》引《漢書音義》稱葛天氏為古帝王之號，足以把此處具名歌辭所歸者作傳說性人物記錄。張揖所述「三皇時君」只作注家說法，不據以指定其在三皇中的位置、年代或世系；不推成實際在場。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-117-xiangru:p024","text":"「於是乎遊戲懈怠，置酒乎昊天之台，張樂乎轇輵之宇；撞千石之鐘，立萬石之钜；建翠華之旗，樹靈鼉之鼓。奏陶唐氏之舞，聽葛天氏之歌，千人唱，萬人和，山陵為之震動，川穀為之蕩波。巴俞宋蔡，淮南于遮，文成顛歌，族舉遞奏，金鼓迭起，鏗鎗鐺剸，洞心駭耳。荊吳鄭衛之聲，韶濩武象之樂，陰淫案衍之音，鄢郢繽紛，激楚結風，俳優侏儒，狄鞮之倡，所以娛耳目而樂心意者，麗靡爛漫於前，靡曼美色於後。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m024-0050","start":50,"end":53,"surface":"陶唐氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"《史記集解》引郭璞說陶唐為堯號；《漢書》平行篇顏師古疑應作陰康。此處是「陶唐氏之舞」的樂舞典故，故不確定接到堯，也不推堯實際在場。"},{"id":"c-shiji-117-xiangru:m024-0057","start":57,"end":60,"surface":"葛天氏","kind":"person","person_id":"p86_1w7_bns","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m024-0151","start":151,"end":155,"surface":"俳優侏儒","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-117-xiangru","book_id":"b-shiji-117","work_id":"w-shiji","source_id":"s-shiji117-xiangru"}],"sources":[{"chapter_id":"c-shiji-117-xiangru","work_id":"w-shiji","book_id":"b-shiji-117","source_id":"s-shiji117-xiangru","source":{"title":"史記／卷117","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷117","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷117&oldid=10371549","revision_id":10371549,"accessed_on":"2026-10-11","extent":"固定修訂全文71段，包括賦、書與末段索隱述贊。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"去header2、目錄標記及現代節標；quote模板保留全文，br轉段落；罕字模板保留第一參數字形，描述未作正文；連結保留顯示字。未核影像。 移除防轉換控制外殼，保留內字云。","note":"第58段U+E0FA私用字缺字與頌中重句原樣保存，不猜補；末段索隱述贊分層。 p063頌句重複及截漏尚待核所選底本，差異存於annotation.transcription_discrepancies，不改現存轉錄。 p064「俎／徂」另存待核差異；不據比較轉錄逕改正文。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true}}
