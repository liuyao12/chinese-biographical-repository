erson_id":"5se_9f5_u2q","predicate":"mother","object_person_id":"qel_t1a_itz","status":"source_attested","evidence":[{"chapter_id":"c-shiji-124-youxia","source_id":"s-shiji124-youxia","paragraph_id":"c-shiji-124-youxia:p007","quote":"楚田仲以俠聞，喜劍，父事朱家，自以為行弗及。田仲已死，而雒陽有劇孟。周人以商賈為資，而劇孟以任俠顯諸侯。吳楚反時，條侯為太尉，乘傳車將至河南，得劇孟，喜曰：「吳楚舉大事而不求孟，吾知其無能為已矣。」天下騷動，宰相得之若得一敵國云。劇孟行大類朱家，而好博，多少年之戲。然劇孟母死，自遠方送喪蓋千乘。及劇孟死，家無餘十金之財。而符離人王孟亦以俠稱江淮之間。"}],"qualifiers":{"source_term":"劇孟母"},"interpretation_note":"依明示稱謂及段內敘事記錄；未名者不補姓名，不推同母、排行或婚姻。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-shiji101-007","person_id":"qel_t1a_itz","event_type":"death","status":"source_attested","date_expression":null,"source_term":"母死","evidence":[{"work_id":"w-shiji","book_id":"b-shiji-101","chapter_id":"c-shiji-101-yuanchao","source_id":"s-shiji-101-yuanchao","paragraph_id":"c-shiji-101-yuanchao:p014","quote":"吳楚已破，上更以元王子平陸侯禮為楚王，袁盎為楚相。嘗上書有所言，不用。袁盎病免居家，與閭里浮沈，相隨行，鬬雞走狗。雒陽劇孟嘗過袁盎，盎善待之。安陵富人有謂盎曰：「吾聞劇孟博徒，將軍何自通之？」盎曰：「劇孟雖博徒，然母死，客送葬車千餘乘，此亦有過人者。且緩急人所有。夫一旦有急叩門，不以親為解，不以存亡為辭，天下所望者，獨季心、劇孟耳。今公常從數騎，一旦有緩急，寧足恃乎！」罵富人，弗與通。諸公聞之，皆多袁盎。","person_mention_id":"c-shiji-101-yuanchao:m014-0107"}],"interpretation_note":"袁盎引劇孟母死、千乘送葬，主語是劇孟母，不是袁盎母，不知年地。 只保存本段明示死亡，不補本段未載的絕對年、享年或葬地；未核書影。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"le-shiji124-005","person_id":"qel_t1a_itz","event_type":"death","status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-124-youxia","source_id":"s-shiji124-youxia","paragraph_id":"c-shiji-124-youxia:p007","quote":"楚田仲以俠聞，喜劍，父事朱家，自以為行弗及。田仲已死，而雒陽有劇孟。周人以商賈為資，而劇孟以任俠顯諸侯。吳楚反時，條侯為太尉，乘傳車將至河南，得劇孟，喜曰：「吳楚舉大事而不求孟，吾知其無能為已矣。」天下騷動，宰相得之若得一敵國云。劇孟行大類朱家，而好博，多少年之戲。然劇孟母死，自遠方送喪蓋千乘。及劇孟死，家無餘十金之財。而符離人王孟亦以俠稱江淮之間。","person_mention_id":"c-shiji-124-youxia:m007-0134"}],"source_term":"劇孟母死","interpretation_note":"明示死亡敘述連個人與原句；概數及朝代範圍不換算單一年，誅族不據此逐一補造家屬死亡。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"mentions":[{"id":"c-shiji-101-yuanchao:m014-0107","start":107,"end":108,"surface":"母","kind":"person","person_id":"qel_t1a_itz","status":"contextual_provisional","paragraph_id":"c-shiji-101-yuanchao:p014","chapter_id":"c-shiji-101-yuanchao"},{"id":"c-shiji-124-youxia:m007-0134","start":134,"end":137,"surface":"劇孟母","kind":"person","person_id":"qel_t1a_itz","status":"contextual_provisional","paragraph_id":"c-shiji-124-youxia:p007","chapter_id":"c-shiji-124-youxia"}],"relations":[{"id":"a-shiji101-007","subject_person_id":"5se_9f5_u2q","predicate":"mother","object_person_id":"qel_t1a_itz","status":"source_attested","evidence":[{"chapter_id":"c-shiji-101-yuanchao","source_id":"s-shiji-101-yuanchao","paragraph_id":"c-shiji-101-yuanchao:p014","quote":"吳楚已破，上更以元王子平陸侯禮為楚王，袁盎為楚相。嘗上書有所言，不用。袁盎病免居家，與閭里浮沈，相隨行，鬬雞走狗。雒陽劇孟嘗過袁盎，盎善待之。安陵富人有謂盎曰：「吾聞劇孟博徒，將軍何自通之？」盎曰：「劇孟雖博徒，然母死，客送葬車千餘乘，此亦有過人者。且緩急人所有。夫一旦有急叩門，不以親為解，不以存亡為辭，天下所望者，獨季心、劇孟耳。今公常從數騎，一旦有緩急，寧足恃乎！」罵富人，弗與通。諸公聞之，皆多袁盎。"}],"qualifiers":{"source_term":"然母死","historicity":"historical_tradition"},"interpretation_note":"明示父、母、子、兄、弟及兄子分存。兄子以侄為主體、父系叔父為客體，不補種父的姓名；不由兄弟推定同父同母，不由太子推定長子。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji124-001","subject_person_id":"5se_9f5_u2q","predicate":"mother","object_person_id":"qel_t1a_itz","status":"source_attested","evidence":[{"chapter_id":"c-shiji-124-youxia","source_id":"s-shiji124-youxia","paragraph_id":"c-shiji-124-youxia:p007","quote":"楚田仲以俠聞，喜劍，父事朱家，自以為行弗及。田仲已死，而雒陽有劇孟。周人以商賈為資，而劇孟以任俠顯諸侯。吳楚反時，條侯為太尉，乘傳車將至河南，得劇孟，喜曰：「吳楚舉大事而不求孟，吾知其無能為已矣。」天下騷動，宰相得之若得一敵國云。劇孟行大類朱家，而好博，多少年之戲。然劇孟母死，自遠方送喪蓋千乘。及劇孟死，家無餘十金之財。而符離人王孟亦以俠稱江淮之間。"}],"qualifiers":{"source_term":"劇孟母"},"interpretation_note":"依明示稱謂及段內敘事記錄；未名者不補姓名，不推同母、排行或婚姻。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji101-042"