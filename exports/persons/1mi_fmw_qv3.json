{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"1mi_fmw_qv3","canonical_person_id":"1mi_fmw_qv3","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["1mi_fmw_qv3"],"persons":[{"id":"1mi_fmw_qv3","label":"史遊","status":"active","historicity":"historical_tradition","aliases":[{"surface":"史遊","mention_ids":["c-jinshu-062-zuna:p002:m0239"]}],"evidence":[{"mention_id":"c-jinshu-062-zuna:p002:m0239","paragraph_id":"c-jinshu-062-zuna:p002","chapter_id":"c-jinshu-062-zuna","quote":"史遊"}],"review":"ai_provisional","identity_note":"史遊，見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-jinshu-062-zuna-ws2629226","work_id":"w-jinshu","book_id":"b-jinshu-062","chapter_id":"c-jinshu-062-zuna","raw_mention_count":1,"mention_ids":["c-jinshu-062-zuna:p002:m0239"],"paragraph_ids":["c-jinshu-062-zuna:p002"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-062-zuna:p002:m0239","mention_ids":["c-jinshu-062-zuna:p002:m0239"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-062-zuna-ws2629226"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-062-zuna:p002:m0239","surface":"史遊","start":239,"end":241,"person_id":"1mi_fmw_qv3","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-062-zuna:p002","chapter_id":"c-jinshu-062-zuna"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-062-zuna:p002","text":"齊王冏建義，越王倫收冏弟北海王實及前前黃門郎弘農董祚弟艾，與冏俱起，皆將害之，納上疏救焉，並見宥。後爲中護軍、太子詹事，封晉昌公。以洛下將亂，乃避地東南。元帝作相，引爲軍諮祭酒。納好奕棋，王隱謂之曰：「禹惜寸陰，不聞數棋。」對曰：「我奕忘憂耳。」隱曰；「蓋聞古人遭逢，則以功達其道，若其不遇，則以言達其道。古必有之，今亦宜然。當晉未有書，而天下大亂，舊事蕩滅，君少長五都，游臣四方，華裔成敗，皆當聞見，何不記述而有裁成？應仲遠作《風俗通》，崔子真作《政論》，蔡伯喈作《勸學篇》，史遊作《急就章》，猶皆行於世，便成沒而不朽。僕雖無才，非志不立，故疾沒世而無聞焉，所以自強不息也。況國史明乎得失之跡，俱取散悉，此可兼濟，何必圍棋然後忘憂也！」納喟然歎曰：「非不悅子之道，力不足耳。」乃言之於帝曰：「自古小國猶有史官，況于大府，安可不置。」因舉隱，稱「清純亮直，學思沈敏，五經、群史多所綜悉，且好學不倦，從善如流。若使修著一代之典，褒貶與奪，誠一時之俊也。」帝以問記室參軍鐘雅，雅曰：「納所舉雖有史才，而今未能立也。」事遂停。然史官之立，自納始也。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":101,"last_line":101,"raw_start":10613,"raw_end":11098,"raw_character_offsets":[10615,10616,10617,10618,10619,10620,10621,10622,10623,10624,10625,10626,10627,10628,10629,10630,10631,10632,10633,10634,10635,10636,10637,10638,10639,10640,10641,10642,10643,10644,10645,10646,10647,10648,10649,10650,10651,10652,10653,10654,10655,10656,10657,10658,10659,10660,10661,10662,10663,10664,10665,10666,10667,10668,10669,10670,10671,10672,10673,10674,10675,10676,10677,10678,10679,10680,10681,10682,10683,10684,10685,10686,10687,10688,10689,10690,10691,10692,10693,10694,10695,10696,10697,10698,10699,10700,10701,10702,10703,10704,10705,10706,10707,10708,10709,10710,10711,10712,10713,10714,10715,10716,10717,10718,10719,10720,10721,10722,10723,10724,10725,10726,10727,10728,10729,10730,10731,10732,10733,10734,10735,10736,10737,10738,10739,10740,10741,10742,10743,10744,10745,10746,10747,10748,10749,10750,10751,10752,10753,10754,10755,10756,10757,10758,