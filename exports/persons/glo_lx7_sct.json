"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-034-yanghu:p036:m0005","start":5,"end":7,"surface":"杜宏","kind":"person","person_id":"glo_lx7_sct","status":"source_explicit","paragraph_id":"c-jinshu-034-yanghu:p036","chapter_id":"c-jinshu-034-yanghu"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-034-yanghu:p036","text":"皇帝使謁者杜宏告故侍中、太傅钜平成侯祜：昔吳為不恭，負險稱號，郊境不辟，多歷年所。祜受任南夏，思靜其難，外揚王化，內經廟略，著德推誠，江漢歸心，舉有成資，謀有全策。昊天不吊，所志不卒，朕用悼恨於厥心。乃班命群帥，致天之討，兵不逾時，一征而滅，疇昔之規，若合符契。夫賞不失勞，國有彝典，宜增啟土宇，以崇前命，而重違公高讓之素。今封夫人夏侯氏萬歲鄉君，食邑五千戶，又賜帛萬匹，穀萬斛。","text_layer":"received_chapter","source_position":{"raw_start":5881,"raw_end":6081,"raw_character_offsets":[5889,5890,5891,5892,5893,5894,5895,5896,5897,5898,5899,5900,5901,5902,5903,5904,5905,5906,5907,5908,5909,5910,5911,5912,5913,5914,5915,5916,5917,5918,5919,5920,5921,5922,5923,5924,5925,5926,5927,5928,5929,5930,5931,5932,5933,5934,5935,5936,5937,5938,5939,5940,5941,5942,5943,5944,5945,5946,5947,5948,5949,5950,5951,5952,5953,5954,5955,5956,5957,5958,5959,5960,5961,5962,5963,5964,5965,5966,5967,5968,5969,5970,5971,5972,5973,5974,5975,5976,5977,5978,5979,5980,5981,5982,5983,5984,5985,5986,5987,5988,5989,5990,5991,5992,5993,5994,5995,5996,5997,5998,5999,6000,6001,6002,6003,6004,6005,6006,6007,6008,6009,6010,6011,6012,6013,6014,6015,6016,6017,6018,6019,6020,6021,6022,6023,6024,6025,6026,6027,6028,6029,6030,6031,6032,6033,6034,6035,6036,6037,6038,6039,6040,6041,6042,6043,6044,6045,6046,6047,6048,6049,6050,6051,6052,6053,6054,6055,6056,6057,6058,6059,6060,6061,6062,6063,6064,6065,6066,6067,6068,6069,6070,6071,6072,6073,6074,6075,6076,6077,6078],"first_line":75,"last_line":75,"revision_id":2567662,"project