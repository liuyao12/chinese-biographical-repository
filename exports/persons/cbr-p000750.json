amed_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m002-0000","start":0,"end":2,"surface":"高祖","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m002-0080","start":80,"end":82,"surface":"王媼","kind":"person","person_id":"cbr-p000749","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m002-0083","start":83,"end":85,"surface":"武負","kind":"person","person_id":"cbr-p000750","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m002-0091","start":91,"end":93,"surface":"武負","kind":"person","person_id":"cbr-p000750","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m002-0094","start":94,"end":96,"surface":"王媼","kind":"person","person_id":"cbr-p000749","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m002-0106","start":106,"end":108,"surface":"高祖","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"}],"chapter_id":"c-shiji-008-gaozu","book_id":"b-shiji-008","work_id":"w-shiji","source_id":"s-shiji-008-gaozu"}],"sources":[{"chapter_id":"c-shiji-008-gaozu","work_id":"w-shiji","book_id":"b-shiji-008","source_id":"s-shiji-008-gaozu","source":{"title":"史記／卷008","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷008","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷008&oldid=2440965","revision_id":2440965,"accessed_on":"2026-10-09","extent":"本篇傳世正文91個p區塊，自「高祖，沛豐邑中陽里人」至太史公論贊；不含導覽標題、跨站連結及另署【索隱述贊】的後出文字。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{"馕":"饢"},"editorial_readings":[],"extraction_note":"正文91段均為p；前置兩個dd為跨站導覽，不收錄。排除sup註號，保留原有行內校勘符號。","note":"第48、57段馕僅作明示簡繁轉換為饢，詞義與疑讀待核，不逕改為餉或饟。數位轉錄尚未核紙本或影像。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_yea