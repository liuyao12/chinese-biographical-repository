emain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"start":325,"end":328,"surface":"苗乞食","id":"c-nanshi-021-wangsengda:p007:m0325","person_id":"v07_xz9_80n","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作苗。","paragraph_id":"c-nanshi-021-wangsengda:p007","chapter_id":"c-nanshi-021-wangsengda"}],"relations":[],"title_holdings":[{"id":"th-nanshi021-wangsengda-55-321","person_id":"v07_xz9_80n","title":"殿中將軍","kind":"office","mode":"attestation","attestations":[{"id":"th-nanshi021-wangsengda-55-321:a","paragraph_id":"c-nanshi-021-wangsengda:p007","start":321,"end":325,"surface":"殿中將軍","person_mention_id":"c-nanshi-021-wangsengda:p007:m0325","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-021","chapter_id":"c-nanshi-021-wangsengda","source_id":"s-nanshi-021-wangsengda-ws1752646","paragraph_id":"c-nanshi-021-wangsengda:p007","quote":"先是，何尚之致仕，復膺朝命，於宅設八關齋，大集朝士，自行香，次至僧達曰：「願郎且放鷹犬，勿復遊獵。」僧達答曰：「家養一老狗，放無處去，已復還。」尚之失色。大明中，以歸順功，封寧陵縣五等侯，累遷中書令。黃門郎路瓊之，太后兄慶之孫也，宅與僧達門並。嘗盛車服詣僧達，僧達將獵，已改服。瓊之就坐，僧達了不與語，謂曰：「身昔門下騶人路慶之者，是君何親？」遂焚瓊之所坐床。太后怒，泣涕於帝曰：「我尚在而人陵之，我死後乞食矣。」帝曰：「瓊之年少，無事詣王僧達門，見辱乃其宜耳。僧達貴公子，豈可以此加罪乎？」太后又謂帝曰：「我終不與王僧達俱生。」先是，南彭城蕃縣人高闍、沙門釋曇標、道方等共相誑惑，自言有鬼神龍鳳之瑞，常聞簫鼓音，與秣陵人藍宏期等謀爲亂，又結殿中將軍苗乞食等起兵攻宮門。事發，凡党與死者數十人。僧達屢經犯忤，上以爲終無悛心，因高闍事陷之，收付廷尉，於獄賜死。時年三十六。帝亦以爲恨，謂江夏王義恭曰：「王僧達遂不免死，追思太保餘烈，使人慨然。」於是詔太保華容文昭公門爵國姻，一不貶絶。","person_mention_id":"c-nanshi-021-wangsengda:p007:m0325"}],"status":"source_attested","interpretation_note":"本句所載官名，任期無確切年月。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanshi-021-wangsengda:p007","text":"先是，何尚之致仕，復膺朝命，於宅設八關齋