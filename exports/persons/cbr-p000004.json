{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000004","identity_policy":"contextual_provisional","person_ids":["cbr-p000004"],"persons":[{"id":"cbr-p000004","label":"炎帝","status":"active","historicity":"legendary_tradition","aliases":[{"surface":"炎帝","mention_ids":["c-shiji-001-wudi:m002-0063","c-shiji-001-wudi:m002-0112"]}],"evidence":[{"mention_id":"c-shiji-001-wudi:m002-0063","chapter_id":"c-shiji-001-wudi","paragraph_id":"c-shiji-001-wudi:p002","quote":"炎帝"},{"mention_id":"c-shiji-001-wudi:m002-0112","chapter_id":"c-shiji-001-wudi","paragraph_id":"c-shiji-001-wudi:p002","quote":"炎帝"}],"identity_note":"僅依本篇上下文建立；不因同名自動跨篇合併。","review":"ai_provisional"}],"source_mention_summary":[{"source_id":"s-shiji-001-wudi","work_id":"w-shiji","book_id":"b-shiji-001","chapter_id":"c-shiji-001-wudi","mention_count":2,"mention_ids":["c-shiji-001-wudi:m002-0063","c-shiji-001-wudi:m002-0112"],"paragraph_ids":["c-shiji-001-wudi:p002"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-001-wudi"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-001-wudi:m002-0063","start":63,"end":65,"surface":"炎帝","kind":"person","person_id":"cbr-p000004","status":"source_identified","paragraph_id":"c-shiji-001-wudi:p002","chapter_id":"c-shiji-001-wudi"},{"id":"c-shiji-001-wudi:m002-0112","start":112,"end":114,"surface":"炎帝","kind":"person","person_id":"cbr-p000004","status":"source_identified","paragraph_id":"c-shiji-001-wudi:p002","chapter_id":"c-shiji-001-wudi"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-001-wudi:p002","text":"軒轅之時，神農氏世衰。諸侯相侵伐，暴虐百姓，而神農氏弗能征。於是軒轅乃習用干戈，以征不享，諸侯咸來賓從。而蚩尤最爲暴，莫能伐。炎帝欲侵陵諸侯，諸侯咸歸軒轅。軒轅乃修德振兵，治五氣，蓺五種，撫萬民，度四方，教熊羆貔貅貙虎，以與炎帝戰於阪泉之野。三戰，然後得其志。蚩尤作亂，不用帝命。於是黃帝乃徵師諸侯，與蚩尤戰於涿鹿之野，遂禽殺蚩尤。而諸侯咸尊軒轅爲天子，代神農氏，是爲黃帝。天下有不順者，黃帝從而征之，平者去之，披山通道，未嘗寧居。","mentions":[{"id":"c-shiji-001-wudi:m002-0000","start":0,"end":2,"surface":"軒轅","kind":"person","person_id":"cbr-p000001","status":"source_identified"},{"id":"c-shiji-001-wudi:m002-0005","start":5,"end":8,"surface":"神農氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"可能為個人、官職、群體、氏族或國號；不憑本篇未明示的外部對應補造身份。"},{"id":"c-shiji-001-wudi:m002-0023","start":23,"end":26,"surface":"神農氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"可能為個人、官職、群體、氏族或國號；不憑本篇未明示的外部對應補造身份。"},{"id":"c-shiji-001-wudi:m002-0032","start":32,"end":34,"surface":"軒轅","kind":"person","person_id":"cbr-p000001","status":"source_identified"},{"id":"c-shiji-001-wudi:m002-0053","start":53,"end":55,"surface":"蚩尤","kind":"person","person_id":"cbr-p000003","status":"source_identified"},{"id":"c-shiji-001-wudi:m002-0063","start":63,"end":65,"surface":"炎帝","kind":"person","person_id":"cbr-p000004","status":"source_identified"},{"id":"c-shiji-001-wudi:m002-0075","start":75,"end":77,"surface":"軒轅","kind":"person","person_id":"cbr-p000001","status":"source_identified"},{"id":"c-shiji-001-wudi:m002-0078","start":78,"end":80,"surface":"軒轅","kind":"person","person_id":"cbr-p000001","status":"source_identified"},{"id":"c-shiji-001-wudi:m002-0112","start":112,"end":114,"surface":"炎帝","kind":"person","person_id":"cbr-p000004","status":"source_identified"},{"id":"c-shiji-001-wudi:m002-0130","start":130,"end":132,"surface":"蚩尤","kind":"person","person_id":"cbr-p000003","status":"source_identified"},{"id":"c-shiji-001-wudi:m002-0142","start":142,"end":144,"surface":"黃帝","kind":"person","person_id":"cbr-p000001","status":"source_identified"},{"id":"c-shiji-001-wudi:m002-0151","start":151,"end":153,"surface":"蚩尤","kind":"person","person_id":"cbr-p000003","status":"source_identified"},{"id":"c-shiji-001-wudi:m002-0163","start":163,"end":165,"surface":"蚩尤","kind":"person","person_id":"cbr-p000003","s