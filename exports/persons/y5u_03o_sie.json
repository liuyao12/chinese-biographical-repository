testations":[{"id":"th-shiji043-034:a001","paragraph_id":"c-shiji-043-zhao:p055","start":79,"end":81,"surface":"商君","person_mention_id":"c-shiji-043-zhao:m055-0079","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"官稱、任命與敘事王號分存；不由卒、首次用稱或迎立代推所有任期。「五國相王」趙獨否保留，先前武靈王用稱不等於此年受王號。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji044-026","person_id":"y5u_03o_sie","title":"秦將","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-044-wei","source_id":"s-shiji-044-wei","paragraph_id":"c-shiji-044-wei:p037","quote":"卅一年，秦、趙、齊共伐我，秦將商君詐我將軍公子卬而襲奪其軍，破之。秦用商君，東地至河，而齊、趙數破我，安邑近秦，於是徙治大梁。以公子赫爲太子。"}],"attestations":[{"id":"th-shiji044-026:a001","paragraph_id":"c-shiji-044-wei:p037","start":13,"end":15,"surface":"秦將","person_mention_id":"c-shiji-044-wei:m037-0015","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"用稱、授予、追尊與任事分存；爭太子、俘虜與死亡不推持有或全部有效終點。原紀年未換算，惠王敘事與追尊王號並存，版本及制度種類待核。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji043-146","person_id":"w6w_2q4_c9g","surfaces":["商君"],"scope":"same_chapter","chapter_ids":["c-shiji-043-zhao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-043-zhao:p055","quote":"肅侯元年，奪晉君端氏，徙處屯留。二年，與魏惠王遇於陰晉。三年，公子范襲邯鄲，不勝而死。四年，朝天子。六年，攻齊，拔髙唐。七年，公子刻攻魏首垣。十一年，秦孝公使商君伐魏，虜其將公子卬。趙伐魏。十二年，秦孝公卒，商君死。十五年，起壽陵。魏惠王卒。"}],"rationale":"限本篇明示姓名、是為與連續事件；太戊午／大戊午暫接但字形待底本核查。娃嬴／孟姚／惠后按本段明示暫接，不與先前夢辭孟姚按同名合併；王紲與較早公子紲分候選。君王職稱按各國上下文辨別，不全域匹配。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji044-068","person_id":"y5u_03o_sie","surfaces":["商君"],"scope":"same_chapter","chapter_ids":["c-shiji-044-wei"],"status":"contextual_