[{"id":"c-jinshu-059-jiong:p002:m0028","start":93,"end":95,"surface":"何勖","kind":"person","person_id":"7e9_372_c4a","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。","paragraph_id":"c-jinshu-059-jiong:p002","chapter_id":"c-jinshu-059-jiong"},{"id":"c-jinshu-059-jiong:p003:m0060","start":110,"end":112,"surface":"何勖","kind":"person","person_id":"7e9_372_c4a","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。","paragraph_id":"c-jinshu-059-jiong:p003","chapter_id":"c-jinshu-059-jiong"},{"start":140,"end":142,"surface":"何勖","kind":"person","person_id":"7e9_372_c4a","id":"c-jinshu-059-liang-yang:line024:m0140","paragraph_id":"c-jinshu-059-liang-yang:line024","chapter_id":"c-jinshu-059-liang-yang"},{"start":143,"end":144,"surface":"勖","kind":"person","person_id":"7e9_372_c4a","id":"c-jinshu-059-liang-yang:line024:m0143","paragraph_id":"c-jinshu-059-liang-yang:line024","chapter_id":"c-jinshu-059-liang-yang"}],"relations":[],"title_holdings":[{"id":"th-phase4-j-068","person_id":"7e9_372_c4a","title":"廷尉","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-059","source_id":"s-jinshu-059-liang-yang","chapter_id":"c-jinshu-059-liang-yang","paragraph_id":"c-jinshu-059-liang-yang:line024","quote":"及武帝寢疾，為楊駿所排，乃以亮為侍中、大司馬、假黃鉞、大都督、督豫州諸軍事，出鎮許昌，加軒懸之樂，六佾之舞。封子羕為西陽公。未發，帝大漸，詔留亮委以後事。楊駿聞之，從中書監華暠索詔視，遂不還。帝崩，亮懼駿疑己，辭疾不入，于大司馬門外敘哀而已，表求過葬。駿欲討亮，亮知之，問計于廷尉何勖。勖曰：「今朝廷皆歸心於公，公何不討人而懼為人所討！」或說亮率所領入廢駿，亮不能用，夜馳赴許昌，故得免。及駿誅，詔曰：「大司馬、汝南王亮體道沖粹，通識政理，宣翼之績，顯於本朝，《二南》之風，流于方夏，將憑遠猷，以康王化。其以亮為太宰、錄尚書事，入朝不趨，劍履上殿，增掾屬十人，給千兵百騎，與太保衛瓘對掌朝政。」亮論賞誅楊駿之功過差，欲以苟悅眾心，由是失望。","person_mention_id":"c-jinshu-059-liang-yang:line024:m0140"}],"attestations":[{"id":"th-phase4-j-068:a001","paragraph_id":"c-jinshu-059-liang-yang:line024","start":138,"end":140,"surface":"廷尉","person_mention_id":"c-jinshu-059-liang-yang:line024:m0140","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"來源限定用稱或任授；不把未載紀年補成單年，不以死亡結束全部職爵。兼領與職掌按原詞保留。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-jinshu059-new-7e9_372_c4a","person_id":"7e9_372_c4a","surfaces":["何勖","勖"],"scope":"same_chapter","chapter_ids":["c-jinshu-059-liang-yang"],"status":"contextual_provisional","confidence_level":"moderate","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-059","chapter_id":"c-jinshu-059-liang-yang","source_id":"s-jinshu-059-liang-yang","paragraph_id":"c-jinshu-059-liang-yang:line024","quote":"何勖","mention_id":"c-jinshu-059-liang-yang:line024:m0140","person_mention_id":"c-jinshu-059-liang-yang:line024:m0140"},{"work_id":"w-jinshu","book_id":"b-jinshu-059","chapter_id":"c-jinshu-059-liang-yang","source_id":"s-jinshu-059-liang-yang","paragraph_id":"c-jinshu-059-liang-yang:line024","quote":"勖","mention_id":"c-jinshu-059-liang-yang:line024:m0143","person_mention_id":"c-jinshu-059-liang-yang:line024:m0143"}],"rationale":"同一完整敘事單元的具名與短稱；人物ID為私有stage提案，父系依各自原文證據，沒有按同名跨篇合併。","references":[],"reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-059-jiong:p002","text":"冏因眾心怨望，潛與離狐王盛、潁川王處穆謀起兵誅倫。倫遣腹心張烏覘之，烏反，曰：「齊無異志。」冏既有成謀未發，恐或泄，乃與軍司管襲殺處穆，送首於倫，以安其意。謀定，乃收襲殺之。遂與豫州刺史何勖、龍驤將軍董艾等起軍，遣使告成都、河間、常山、新野四王，移檄天下征鎮、州郡縣國，咸使聞知。揚州刺史郗隆承檄，猶豫未決，參軍王邃斬之，送首於冏。冏屯軍陽翟，倫遣其將閭和、張泓、孫輔出堮阪，與冏交戰。冏軍失利，堅壘自守。會成都軍破倫眾于黃橋，冏乃出軍攻和等，大破之。及王輿廢倫，惠帝反正，冏誅討賊党既畢，率眾入洛，頓軍通章署，甲士數十萬，旌旗器械之盛，震於京都。天子就拜大司馬，加九錫之命，備物典策，如宣、景、文、武輔魏故事。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-059-jiong:p002:m0015","start":0,"end":1,"surface":"冏","kind":"person","person_id":"ee0_b2a_68e","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p002:m0016","start":11,"end":13,"surface":"王盛","kind":"person","person_id":"lwd_93l_vo3","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p002:m0017","start":16,"end":19,"surface":"王處穆","kind":"person","person_id":"414_jrh_fj0","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p002:m0018","start":23,"end":24,"surface":"倫","kind":"person","person_id":"dkn_ge4_286_AAAAG","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p002:m0019","start":25,"end":26,"surface":"倫","kind":"person","person_id":"dkn_ge4_286_AAAAG","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p002:m0020","start":29,"end":31,"surface":"張烏","kind":"person","person_id":"1gn_92g_8z7","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p002:m0021","start":34,"end":35,"surface":"烏","kind":"person","person_id":"1gn_92g_8z7","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p002:m0022","start":40,"end":41,"surface":"齊","kind":"person","person_id":"ee0_b2a_68e","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p002:m0023","start":46,"end":47,"surface":"冏","kind":"person","person_id":"ee0_b2a_68e","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p002:m0024","start":62,"end":64,"surface":"管襲","kind":"person","person_id":"va8_xga_761","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p002:m0025","start":65,"end":67,"surface":"處穆","kind":"person","person_id":"414_jrh_fj0","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具