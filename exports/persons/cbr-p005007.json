4997","status":"source_attested","evidence":[{"chapter_id":"c-shiji-089-zhanger","source_id":"s-shiji-089-zhanger","paragraph_id":"c-shiji-089-zhanger:p029","quote":"張敖，髙后六年薨。子偃爲魯元王。以母呂后女故，呂后封爲魯元王。元王弱，兄弟少，乃封張敖他姬子二人：壽爲樂昌侯，侈爲信都侯。髙后崩，諸呂無道，大臣誅之，而廢魯元王及樂昌侯、信諸侯。孝文帝即位，復封故魯元王偃爲南宮侯，續張氏。"}],"qualifiers":{"source_term":"張敖他姬子二人","historicity":"historical_tradition"},"interpretation_note":"按明示親屬保存；父事不作父系，他姬不補姓名或推二子同母。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji089-035","person_id":"cbr-p005007","title":"信都侯","kind":"noble_rank","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-089-zhanger","source_id":"s-shiji-089-zhanger","paragraph_id":"c-shiji-089-zhanger:p029","quote":"張敖，髙后六年薨。子偃爲魯元王。以母呂后女故，呂后封爲魯元王。元王弱，兄弟少，乃封張敖他姬子二人：壽爲樂昌侯，侈爲信都侯。髙后崩，諸呂無道，大臣誅之，而廢魯元王及樂昌侯、信諸侯。孝文帝即位，復封故魯元王偃爲南宮侯，續張氏。"}],"attestations":[{"id":"th-shiji089-035:a001","paragraph_id":"c-shiji-089-zhanger:p029","start":57,"end":60,"surface":"信都侯","person_mention_id":"c-shiji-089-zhanger:m029-0057","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-089-zhanger","source_id":"s-shiji-089-zhanger","paragraph_id":"c-shiji-089-zhanger:p029","quote":"張敖，髙后六年薨。子偃爲魯元王。以母呂后女故，呂后封爲魯元王。元王弱，兄弟少，乃封張敖他姬子二人：壽爲樂昌侯，侈爲信都侯。髙后崩，諸呂無道，大臣誅之，而廢魯元王及樂昌侯、信諸侯。孝文帝即位，復封故魯元王偃爲南宮侯，續張氏。"}]},"end":{"status":"source_event","event_type":"deposition","date_expression":"髙后崩","evidence":[{"chapter_id":"c-shiji-089-zhanger","source_id":"s-shiji-089-zhanger","paragraph_id":"c-shiji-089-zhanger:p029","quote":"張敖，髙后六年薨。子偃爲魯元王。以母呂后女故，呂后封爲魯元王。元王弱，兄弟少，乃封張敖他姬子二人：壽爲樂昌侯，侈爲信都侯。髙后崩，諸呂無道，大臣誅之，而廢魯元王及樂昌侯、信諸侯。孝文帝即位，復封故魯元王偃爲南宮侯，續張氏。"}]}},"interpretation_note":"保存明示授予、改封及用稱；十年追述不補起年，死亡不自動作任期終點；索隱述贊與正文分層。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji089-030","person_id":"cbr-p005007","scope":"same_chapter","chapter_ids":["c-shiji-089-