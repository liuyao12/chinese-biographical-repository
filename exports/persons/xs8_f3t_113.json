{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"xs8_f3t_113","canonical_person_id":"xs8_f3t_113","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["xs8_f3t_113"],"persons":[{"id":"xs8_f3t_113","label":"呼于屠王（未名）（衛將軍驃騎列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"呼于屠王","mention_ids":["c-shiji-111-wei-huo:m012-0368"]}],"evidence":[{"mention_id":"c-shiji-111-wei-huo:m012-0368","chapter_id":"c-shiji-111-wei-huo","paragraph_id":"c-shiji-111-wei-huo:p012","quote":"呼于屠王"}]}],"source_mention_summary":[{"source_id":"s-shiji111-wei-huo","work_id":"w-shiji","book_id":"b-shiji-111","chapter_id":"c-shiji-111-wei-huo","raw_mention_count":1,"mention_ids":["c-shiji-111-wei-huo:m012-0368"],"paragraph_ids":["c-shiji-111-wei-huo:p012"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-shiji-111-wei-huo:m012-0368","mention_ids":["c-shiji-111-wei-huo:m012-0368"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-shiji111-wei-huo"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-111-wei-huo:m012-0368","start":368,"end":372,"surface":"呼于屠王","kind":"person","person_id":"xs8_f3t_113","status":"contextual_provisional","paragraph_id":"c-shiji-111-wei-huo:p012","chapter_id":"c-shiji-111-wei-huo"}],"relations":[],"title_holdings":[{"id":"th-shiji111-120","person_id":"xs8_f3t_113","title":"呼于屠王","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-111-wei-huo","source_id":"s-shiji111-wei-huo","paragraph_id":"c-shiji-111-wei-huo:p012","quote_passage_ref":"data/corpus/shiji/111.json"}],"attestations":[{"id":"th-shiji111-120:a001","paragraph_id":"c-shiji-111-wei-huo:p012","start":368,"end":372,"surface":"呼于屠王","person_mention_id":"c-shiji-111-wei-huo:m012-0368","usage":"narrative","date_expression":"其夏","normalized_date":{"era":"BCE","era_year":121,"year":-120,"year_numbering":"astronomical","precision":"year","status":"editorial_provisional","original_quote":"其夏，驃騎將軍與合騎侯敖俱出北地，異道；博望侯張騫、郎中令李廣俱出右北平，異道：皆擊匈奴。郎中令將四千騎先至，博望侯將萬騎在後至。匈奴左賢王將數萬騎圍郎中令，郎中令與戰二日，死者過半，所殺亦過當。博望侯至，匈奴兵引去。博望侯坐行留，當斬，贖為庶人。而驃騎將軍出北地，已遂深入，與合騎侯失道，不相得，驃騎將軍踰居延至祁連山，捕首虜甚多。天子曰：「驃騎將軍踰居延，遂過小月氏，攻祁連山，得酋涂王，以眾降者二千五百人，斬首虜三萬二百級，獲五王，五王母，單于閼氏、王子五十九人，相國、將軍、當戶、都尉六十三人，師大率減什三，益封去病五千戶。賜校尉從至小月氏爵左庶長。鷹擊司馬破奴再從驃騎將軍斬遬濮王，捕稽沮王，千騎將得王、王母各一人，王子以下四十一人，捕虜三千三百三十人，前行捕虜千四百人，以千五百戶封破奴為從驃侯。校尉句王高不識，從驃騎將軍捕呼于屠王王子以下十一人，捕虜千七百六十八人，以千一百戶封不識為宜冠侯。校尉僕多有功，封為煇渠侯。」合騎侯敖坐行留不與驃騎會，當斬，贖為庶人。諸宿將所將士馬兵亦不如驃騎，驃騎所將常選，然亦敢深入，常與壯騎先其大（將）軍，軍亦有天幸，未嘗困絕也。然而諸宿將常坐留落不遇。由此驃騎日以親貴，比大將軍。","evidence":[{"chapter_id":"c-shiji-111-wei-huo","source_id":"s-shiji111-wei-huo","paragraph_id":"c-shiji-111-wei-huo:p012","quote_passage_ref":"data/corpus/shiji/111.json"},{"chapter_id":"c-shiji-111-wei-huo","source_id":"s-shiji111-wei-huo","paragraph_id":"c-shiji-111-wei-huo:p011","quote_passage_ref":"data/corpus/shiji/111.json"}],"references":[{"title":"《資治通鑑》數位編輯年標","url":"https://zh.wikisource.org/wiki/資治通鑑/卷019","quote":"元狩二年（庚申，公元前一二一年）","scope":"digital_editorial_regnal_year_equivalence_only","image_verified":false},{"title":"《資治通鑑》同年夏役","url":"https://zh.wikisource.org/wiki/資治通鑑/卷019","quote":"夏，去病復與合騎侯公孫敖將數萬騎俱出北地，異道。","scope":"received_parallel_event","image_verified":false}],"rationale":"其夏承前段元狩二年春，對讀通鑑同次夏役，暫前121年；僅年精度，不改本篇官稱、俘虜數字或補月日。","reviewer":"Codex（AI 代理）","human_reviewed":false}}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本次夏役用稱、封侯與贖為庶人分開。當斬而贖不作死亡，不將首次用稱或軍敗自動截斷全部官爵。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[{"era":"BCE","era_year":121,"year":-120,"year_numbering":"astronomical","precision":"year","status":"editorial_provisional","original_quote":"其夏，驃騎將軍與合騎侯敖俱出北地，異道；博望侯張騫、郎中令李廣俱出右北平，異道：皆擊匈奴。郎中令將四千騎先至，博望侯將萬騎在後至。匈奴左賢王將數萬騎圍郎中令，郎中令與戰二日，死者過半，所殺亦過當。博望侯至，匈奴兵引去。博望侯坐行留，當斬，贖為庶人。而驃騎將軍出北地，已遂深入，與合騎侯失道，不相得，驃騎將軍踰居延至祁連山，捕首虜甚多。天子曰：「驃騎將軍踰居延，遂過小月氏，攻祁連山，得酋涂王，以眾降者二千五百人，斬首虜三萬二百級，獲五王，五王母，單于閼氏、王子五十九人，相國、將軍、當戶、都尉六十三人，師大率減什三，益封去病五千戶。賜校尉從至小月氏爵左庶長。鷹擊司馬破奴再從驃騎將軍斬遬濮王，捕稽沮王，千騎將得王、王母各一人，王子以下四十一人，捕虜三千三百三十人，前行捕虜千四百人，以千五百戶封破奴為從驃侯。校尉句王高不識，從驃騎將軍捕呼于屠王王子以下十一人，捕虜千七百六十八人，以千一百戶封不識為宜冠侯。校尉僕多有功，封為煇渠侯。」合騎侯敖坐行留不與驃騎會，當斬，贖為庶人。諸宿將所將士馬兵亦不如驃騎，驃騎所將常選，然亦敢深入，常與壯騎先其大（將）軍，軍亦有天幸，未嘗困絕也。然而諸宿將常坐留落不遇。由此驃騎日以親貴，比大將軍。","evidence":[{"chapter_id":"c-shiji-111-wei-huo","source_id":"s-shiji111-wei-huo","paragraph_id":"c-shiji-111-wei-huo:p012","quote_passage_ref":"data/corpus/shiji/111.json"},{"chapter_id":"c-shiji-111-wei-huo","source_id":"s-shiji111-wei-huo","paragraph_id":"c-shiji-111-wei-huo:p011","quote_passage_ref":"data/corpus/shiji/111.json"}],"references":[{"title":"《資治通鑑》數位編輯年標","url":"https://zh.wikisource.org/wiki/資治通鑑/卷019","quote":"元狩二年（庚申，公元前一二一年）","scope":"digital_editorial_regnal_year_equivalence_only","image_verified":false},{"title":"《資治通鑑》同年夏役","url":"https://zh.wikisource.org/wiki/資治通鑑/卷019","quote":"夏，去病復與合騎侯公孫敖將數萬騎俱出北地，異道。","scope":"received_parallel_event","image_verified":false}],"rationale":"其夏承前段元狩二年春，對讀通鑑同次夏役，暫前121年；僅年精度，不改本篇官稱、俘虜數字或補月日。","reviewer":"Codex（AI 代理）","human_reviewed":