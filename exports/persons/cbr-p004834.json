us":"contextual_provisional"},{"id":"c-shiji-086-cike:m014-0132","start":132,"end":134,"surface":"老母","kind":"person","person_id":"cbr-p004833","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m014-0164","start":164,"end":166,"surface":"仲子","kind":"person","person_id":"cbr-p004835","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m014-0170","start":170,"end":173,"surface":"嚴仲子","kind":"person","person_id":"cbr-p004835","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m014-0178","start":178,"end":180,"surface":"聶政","kind":"person","person_id":"cbr-p004834","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m014-0191","start":191,"end":193,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未定稱呼保持未解，不補姓名。"},{"id":"c-shiji-086-cike:m014-0241","start":241,"end":243,"surface":"聶政","kind":"person","person_id":"cbr-p004834","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m014-0263","start":263,"end":265,"surface":"老母","kind":"person","person_id":"cbr-p004833","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m014-0266","start":266,"end":268,"surface":"老母","kind":"person","person_id":"cbr-p004833","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m014-0280","start":280,"end":283,"surface":"嚴仲子","kind":"person","person_id":"cbr-p004835","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m014-0286","start":286,"end":288,"surface":"聶政","kind":"person","person_id":"cbr-p004834","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m014-0295","start":295,"end":298,"surface":"嚴仲子","kind":"person","person_id":"cbr-p004835","status":"contextual_provisional"}],"chapter_id":"c-shiji-086-cike","book_id":"b-shiji-086","work_id":"w-shiji","source_id":"s-shiji-086-cike"},{"id":"c-shiji-086-cike:p015","text":"久之，聶政母死。既已葬，除服，聶政曰：「嗟乎！政乃市井之人，鼓刀以屠；而嚴仲子乃諸侯之卿相也，不遠千里，枉車騎而交臣。臣之所以待之，至淺鮮矣，未有大功可以稱者，而嚴仲子奉百金爲親壽，我雖不受，然是者徒深知政也。夫賢者以感忿睚眞諼而親信窮僻之人，而政獨安得嘿然而已乎！且前日要政，政徒以老母；老母今以天年終，政將爲知己者用。」乃遂西至濮陽，見嚴仲子曰：「前日所以不許仲子者，徒以親在；今不幸而母以天年終。仲子所欲報仇者爲誰？請得從事焉！」嚴仲子具告曰：「臣之仇韓相俠累，俠累又韓君之季父也，宗族盛多，居處兵衞甚設，臣欲使人刺之，（衆）終莫能就。今足下幸而不棄，請益其車騎壯士可爲足下輔翼者。」聶政曰：「韓之與衞，相去中閒不甚遠，今殺人之相，相又國君之親，此其勢不可以多人，多人不能無生得失，生得失則語泄，語泄是韓舉國而與仲子爲讎，豈不殆哉！」遂謝車騎人徒，聶政乃辭獨行。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-086-cike:m015-0003","start":3,"end":6,"surface":"聶政母","kind":"person","person_id":"cbr-p004833","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m015-0015","start":15,"end":17,"surface":"聶政","kind":"person","person_id":"cbr-p004834","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m015-0023","start":23,"end":24,"surface":"政","kind":"person","person_id":"cbr-p004834","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m015-0036","start":36,"end":39,"surface":"嚴仲子","kind":"person","person_id":"cbr-p004835","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m015-0081","start":81,"end":84,"surface":"嚴仲子","kind":"person","person_id":"cbr-p004835","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m015-0102","start":102,"end":103,"surface":"政","kind":"person","person_id":"cbr-p004834","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m015-0123","start":123,"end":124,"surface":"政","kind":"person","person_id":"cbr-p004834","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m015-0137","start":137,"end":138,"surface":"政","kind":"person","person_id":"cbr-p004834","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m015-0139","start":139,"end":140,"surface":"政","kind":"person","person_id":"cbr-p004834","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m015-0142","start":142,"end":144,"surface":"老母","kind":"person","person_id":"cbr-p004833","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m015-0145","start":145,"end":147,"surface":"老母","kind":"person","person_id":"cbr-p004833","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m015-0153","start":153,"end":154,"surface":"政","kind":"person","person_id":"cbr-p004834","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m015-0170","start":170,"end":173,"surface":"嚴仲子","kind":"person","person_id":"cbr-p004835","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m015-0182","start":182,"end":184,"surface":"仲子","kind":"person","person_id":"cbr-p004835","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m015-0201","start":201,"end":203,"surface":"仲子","kind":"person","person_id":"cbr-p004835","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m015-0218","start":218,"end":221,"surface":"嚴仲子","kind":"person","person_id":"cbr-p004835","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m015-0229","start":229,"end":233,"surface":"韓相俠累","kind":"person","person_id":"cbr-p004837","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m015-0234","start":234,"end":236,"surface":"俠累","kind":"person","person_id":"cbr-p004837","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m015-0237","start":237,"end":239,"surface":"韓君","kind":"person","person_id":"cbr-p004838","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m015-0244","start":244,"end":246,"surface":"宗族","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未定稱呼保持未解，不補姓名。"},{"id":"c-shiji-086-cike:m015-0251","start":251,"end":253,"surface":"兵衞","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未定稱呼保持未解，不補姓名。"},{"id":"c-shiji-086-cike:m015-0282","start":282,"end":286,"surface":"車騎壯士","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未定稱呼保持未解，不補姓名。"},{"id":"c-shiji-086-cike:m015-0295","start":295,"end":297,"surface":"聶政","kind":"person","person_id":"cbr-p004834","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m015-0321","start":321,"end":323,"surface":"國君","kind":"person","person_id":"cbr-p004838","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m015-0359","start":359,"end":361,"surface":"仲子","kind":"person","person_id":"cbr-p004835","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m015-0372","start":372,"end":376,"surface":"車騎人徒","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未定稱呼保持未解，不補姓名。"},{"id":"c-shiji-086-cike:m015-0377","start":377,"end":379,"surface":"聶政","kind":"person","person_id":"cbr-p004834","status":"contextual_provisional"}],"chapter_id":"c-shiji-086-cike","book_id":"b-shiji-086","work_id":"w-shiji","source_id":"s-shiji-086-cike"},{"id":"c-shiji-086-cike:p016","text":"杖劍至韓，韓相俠累方坐府上，持兵戟而衞侍者甚衆。聶政直入，上階刺殺俠累，左右大亂。聶政大呼，所撃殺者數十人，因自皮面決眼，自屠出腸，遂以死。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-086-cike:m016-0005","start":5,"end":9,"surface":"韓相俠累","kind":"person","person_id":"cbr-p004837","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m016-0018","start":18,"end":21,"surface":"衞侍者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未定稱呼保持未解，不補姓名。"},{"id":"c-shiji-086-cike:m016-0024","start":24,"end":26,"surface":"聶政","kind":"person","person_id":"cbr-p004834","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m016-0033","start":33,"end":35,"surface":"俠累","kind":"person","person_id":"cbr-p004837","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m016-0036","start":36,"end":38,"surface":"左右","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未定稱呼保持未解，不補姓名。"},{"id":"c-shiji-086-cike:m016-0041","start":41,"end":43,"surface":"聶政","kind":"person","person_id":"cbr-p004834","status":"contextual_provisional"}],"chapter_id":"c-shiji-086-cike","book_id":"b-shiji-086","work_id":"w-shiji","source_id":"s-shiji-086-cike"},{"id":"c-shiji-086-cike:p017","text":"韓取聶政尸暴於市，購問莫知誰子。於是韓縣之，有能言殺相俠累者予千金。久之莫知也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-086-cike:m017-0002","start":2,"end":4,"surface":"聶政","kind":"person","person_id":"cbr-p004834","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m017-0027","start":27,"end":29,"surface":"俠累","kind":"person","person_id":"cbr-p004837","status":"contextual_provisional"}],"chapter_id":"c-shiji-086-cike","book_id":"b-shiji-086","work_id":"w-shiji","source_id":"s-shiji-086-cike"},{"id":"c-shiji-086-cike:p018","text":"政姊榮聞人有刺殺韓相者，賊不得，國不知其名姓，暴其尸而縣之千金，乃於邑曰：「其是吾弟與？嗟乎，嚴仲子知吾弟！」立起，如韓，之市，而死者果政也，伏尸哭極哀，曰：「是軹深井里所謂聶政者也。」市行者諸衆人皆曰：「此人暴虐吾國相，王縣購其名姓千金，夫人不聞與？何敢來識之也？」榮應之曰：「聞之。然政所以蒙汚辱自棄於市販之閒者，爲老母幸無恙，妾未嫁也。親既以天年下世，妾已嫁夫，嚴仲子乃察舉吾弟困汚之中而交之，澤厚矣，可柰何！士固爲知己者死，今乃以妾尚在之故，重自刑以絶從，妾其柰何畏歿身之誅，終滅賢弟之名！」大驚韓市人。乃大呼天者三，卒於邑悲哀而死政之旁。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-086-cike:m018-0000","start":0,"end":1,"surface":"政","kind":"person","person_id":"cbr-p004834","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m018-0002","start":2,"end":3,"surface":"榮","kind":"person","person_id":"cbr-p004839","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m018-0047","start":47,"end":50,"surface":"嚴仲子","kind":"person","person_id":"cbr-p004835","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m018-0068","start":68,"end":69,"surface":"政","kind":"person","person_id":"cbr-p004834","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m018-0087","start":87,"end":89,"surface":"聶政","kind":"person","person_id":"cbr-p004834","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m018-0093","start":93,"end":99,"surface":"市行者諸衆人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未定稱呼保持未解，不補姓名。"},{"id":"c-shiji-086-cike:m018-0111","start":111,"end":112,"surface":"王","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未定稱呼保持未解，不補姓名。"},{"id":"c-shiji-086-cike:m018-0134","start":134,"end":135,"surface":"榮","kind":"person","person_id":"cbr-p004839","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m018-0144","start":144,"end":145,"surface":"政","kind":"person","person_id":"cbr-p004834","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m018-0160","start":160,"end":162,"surface":"老母","kind":"person","person_id":"cbr-p004833","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m018-0183","start":183,"end":184,"surface":"，","kind":"person","person_id":"cbr-p004840","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m018-0184","start":184,"end":187,"surface":"嚴仲子","kind":"person","person_id":"cbr-p004835","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m018-0252","start":252,"end":255,"surface":"韓市人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未定稱呼保持未解，不補姓名。"},{"id":"c-shiji-086-cike:m018-0270","start":270,"end":271,"surface":"政","kind":"person","person_id":"cbr-p004834","status":"contextual_provisional"}],"chapter_id":"c-shiji-086-cike","book_id":"b-shiji-086","work_id":"w-shiji","source_id":"s-shiji-086-cike"},{"id":"c-shiji-086-cike:p019","text":"晉、楚、齊、衞聞之，皆曰：「非獨政能也，乃其姊亦烈女也。鄕使政誠知其姊無濡忍之志，不重暴骸之難，必絶險千里以列其名，姊弟倶僇於韓市者，亦未必敢以身許嚴仲子也。嚴仲子亦可謂知人能得士矣！」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-086-cike:m019-0016","start":16,"end":17,"surface":"政","kind":"person","person_id":"cbr-p004834","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m019-0021","start":21,"end":23,"surface":"其姊","kind":"person","person_id":"cbr-p004839","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m019-0030","start":30,"end":31,"surface":"政","kind":"person","person_id":"cbr-p004834","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m019-0033","start":33,"end":35,"surface":"其姊","kind":"person","person_id":"cbr-p004839","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m019-0058","start":58,"end":60,"surface":"姊弟","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未定稱呼保持未解，不補姓名。"},{"id":"c-shiji-086-cike:m019-0074","start":74,"end":77,"surface":"嚴仲子","kind":"person","person_id":"cbr-p004835","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m019-0079","start":79,"end":82,"surface":"嚴仲子","kind":"person","person_id":"cbr-p004835","status":"contextual_provisional"}],"chapter_id":"c-shiji-086-cike","book_id":"b-shiji-086","work_id":"w-shiji","source_id":"s-shiji-086-cike"}],"sources":[{"chapter_id":"c-shiji-086-cike","work_id":"w-shiji","book_id":"b-shiji-086","source_id":"s-shiji-086-cike","source":{"title":"史記／卷086","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷086","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷086&oldid=2388562","revision_id":2388562,"accessed_on":"2026-10-09","extent":"38段正文含太史公論，排除導覽、索隱述贊及現代版權。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"固定HTML與取得時版本一致，只去外緣空白；（衆）按普通括號原文保留；第17段tooltip異文提示另存。","note":"全38段與HTML篇界已核讀，未核底本影像或現代研究。","digital_variant_notes":[{"paragraph_number":17,"body_reading":"縣","witness_tooltip":"一作「購縣」，又作「縣購」。","note":"數位見證未標明異文版本，另存，不代替正文。"}]}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical"}}
