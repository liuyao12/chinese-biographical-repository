r","mentions":[{"id":"c-shiji-083-luzou:m017-0001","start":1,"end":3,"surface":"卞和","kind":"person","person_id":"9j0_saz_b8g","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m017-0006","start":6,"end":8,"surface":"楚王","kind":"person","person_id":"y9v_xi8_8n3","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m017-0011","start":11,"end":13,"surface":"李斯","kind":"person","person_id":"9lp_b6m_laq","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m017-0016","start":16,"end":18,"surface":"胡亥","kind":"person","person_id":"n39_fsx_avv","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m017-0023","start":23,"end":25,"surface":"箕子","kind":"person","person_id":"xxu_9lb_1z0","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m017-0028","start":28,"end":30,"surface":"接輿","kind":"person","person_id":"8f4_qc5_g5e","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m017-0040","start":40,"end":42,"surface":"大王","kind":"person","person_id":"4qt_ofp_ysv","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m017-0044","start":44,"end":46,"surface":"卞和","kind":"person","person_id":"9j0_saz_b8g","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m017-0047","start":47,"end":49,"surface":"李斯","kind":"person","person_id":"9lp_b6m_laq","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m017-0054","start":54,"end":56,"surface":"楚王","kind":"person","person_id":"y9v_xi8_8n3","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m017-0057","start":57,"end":59,"surface":"胡亥","kind":"person","person_id":"n39_fsx_avv","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m017-0064","start":64,"end":65,"surface":"臣","kind":"person","person_id":"0z4_onh_r27","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m017-0066","start":66,"end":68,"surface":"箕子","kind":"person","person_id":"xxu_9lb_1z0","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m017-0069","start":69,"end":71,"surface":"接輿","kind":"person","person_id":"8f4_qc5_g5e","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m017-0074","start":74,"end":75,"surface":"臣","kind":"person","person_id":"0z4_onh_r27","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m017-0076","start":76,"end":78,"surface":"比干","kind":"person","person_id":"4bt_npm_axo","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m017-0081","start":81,"end":83,"surface":"子胥","kind":"person","person_id":"nna_uks_w03","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m017-0086","start":86,"end":87,"surface":"臣","kind":"person","person_id":"0z4_onh_r27","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m017-0097","start":97,"end":99,"surface":"大王","kind":"person","person_id":"4qt_ofp_ysv","status":"contextual_provisional"}],"chapter_id":"c-shiji-083-luzou","book_id":"b-shiji-083","work_id":"w-shiji","source_id":"s-shiji-083-luzou"},{"id":"c-shiji-083-luzou:p022","text":"臣聞明月之珠，夜光之璧，以闇投人於道路，人無不按劍相眄者。何則？無因而至前也。蟠木根柢，輪囷離詭，而為萬乘器者。何則？以左右先為之容也。故無因至前，雖出隨侯之珠，夜光之璧，猶結怨而不見德。故有人先談，則以枯木朽株樹功而不忘。今夫天下布衣窮居之士，身在貧賤，雖蒙堯、舜之術，挾伊、管之辯，懷龍逢、比干之意，欲盡忠當世之君，而素無根柢之容，雖竭精思，欲開忠信，輔人主之治，則人主必有按劍相眄之跡，是使布衣不得為枯木朽株之資也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-083-luzou:m022-0000","start":0,"end":1,"surface":"臣","kind":"person","person_id":"0z4_onh_r27","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m022-0060","start":60,"end":62,"surface":"左右","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代保留，不補姓名。"},{"id":"c-shiji-083-luzou:m022-0116","start":116,"end":122,"surface":"布衣窮居之士","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代保留，不補姓名。"},{"id":"c-shiji-083-luzou:m022-0130","start":130,"end":131,"surface":"堯","kind":"person","person_id":"vz2_xlj_noq","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m022-0132","start":132,"end":133,"surface":"舜","kind":"person","person_id":"aal_nze_fai","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m022-0137","start":137,"end":138,"surface":"伊","kind":"person","person_id":"qqj_r6h_knh","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m022-0139","start":139,"end":140,"surface":"管","kind":"person","person_id":"chm_jfj_3y8","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m022-0144","start":144,"end":146,"surface":"龍逢","kind":"person","person_id":"bnl_xoy_8z2","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m022-0147","start":147,"end":149,"surface":"比干","kind":"person","person_id":"4bt_npm_axo","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m022-0155","start":155,"end":159,"surface":"當世之君","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代保留，不補姓名。"},{"id":"c-shiji-083-luzou:m022-0179","start":179,"end":181,"surface":"人主","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代保留，不補姓名。"},{"id":"c-shiji-083-luzou:m022-0185","start":185,"end":187,"surface":"人主","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代保留，不補姓名。"}],"chapter_id":"c-shiji-083-luzou","book_id":"b-shiji-083","work_id":"w-shiji","source_id":"s-shiji-083-luzou"},{"id":"c-shiji-083-luzou:p025","text":"臣聞盛飾入朝者不以利汙義，砥厲名號者不以欲傷行，故縣名勝母而曾子不入，邑號朝歌而墨子回車。今欲使天下寥廓之士，攝於威重之權，主於位勢之貴，故回面汙行以事諂諛之人而求親近於左右，則士伏死堀穴巖巖之中耳，安肯有盡忠信而趨闕下者哉！","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-083-luzou:m025-0000","start":0,"end":1,"surface":"臣","kind":"person","person_id":"0z4_onh_r27","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m025-0030","start":30,"end":32,"surface":"曾子","kind":"person","person_id":"ov9_hou_2hp","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m025-0040","start":40,"end":42,"surface":"墨子","kind":"person","person_id":"06s_zyx_maw","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m025-0076","start":76,"end":80,"surface":"諂諛之人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代保留，不補姓名。"},{"id":"c-shiji-083-luzou:m025-0085","start":85,"end":87,"surface":"左右","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代保留，不補姓名。"}],"chapter_id":"c-shiji-083-luzou","book_id":"b-shiji-083","work_id":"w-shiji","source_id":"s-shiji-083-luzou"},{"id":"c-shiji-083-luzou:p026","text":"書奏梁孝王，孝王使人出之，卒為上客。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-083-luzou:m026-0002","start":2,"end":5,"surface":"梁孝王","kind":"person","person_id":"4qt_ofp_ysv","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m026-0006","start":6,"end":8,"surface":"孝王","kind":"person","person_id":"4qt_ofp_ysv","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m026-0008","start":8,"end":10,"surface":"使人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代保留，不補姓名。"},{"id":"c-shiji-083-luzou:m026-0011","start":11,"end":12,"surface":"之","kind":"person","person_id":"0z4_onh_r27","status":"contextual_provisional"}],"chapter_id":"c-shiji-083-luzou","book_id":"b-shiji-083","work_id":"w-shiji","source_id":"s-shiji-083-luzou"},{"id":"c-shiji-083-luzou:p027","text":"太史公曰：魯連其指意雖不合大義，然余多其在布衣之位，蕩然肆志，不詘於諸侯，談說於當世，折卿相之權。鄒陽辭雖不遜，然其比物連類，有足悲者，亦可謂抗直不橈矣，吾是以附之列傳焉。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-083-luzou:m027-0000","start":0,"end":3,"surface":"太史公","kind":"person","person_id":"hh3_ak4_jge","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m027-0005","start":5,"end":7,"surface":"魯連","kind":"person","person_id":"p7k_2z7_84m","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m027-0034","start":34,"end":36,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代保留，不補姓名。"},{"id":"c-shiji-083-luzou:m027-0044","start":44,"end":46,"surface":"卿相","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代保留，不補姓名。"},{"id":"c-shiji-083-luzou:m027-0049","start":49,"end":51,"surface":"鄒陽","kind":"person","person_id":"0z4_onh_r27","status":"contextual_provisional"}],"chapter_id":"c-shiji-083-luzou","book_id":"b-shiji-083","work_id":"w-shiji","source_id":"s-shiji-083-luzou"}],"sources":[{"chapter_id":"c-shiji-083-luzou","work_id":"w-shiji","book_id":"b-shiji-083","source_id":"s-shiji-083-luzou","source":{"title":"史記／卷083","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷083","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷083&oldid=2089252","revision_id":2089252,"accessed_on":"2026-10-09","extent":"27段正文，自魯仲連者至太史公論贊；排除人物導覽、索隱述贊及現代版權。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[{"paragraph_id":"c-shiji-083-luzou:p002","witness_form":"［湣王］","body_reading":"","note":"數位增刪改讀提示另存，正文保留增改前形式，未核影像，不當已校定。"},{"paragraph_id":"c-shiji-083-luzou:p007","witness_form":"［待］","body_reading":"","note":"數位增刪改讀提示另存，正文保留增改前形式，未核影像，不當已校定。"},{"paragraph_id":"c-shiji-083-luzou:p009","witness_form":"（使）","body_reading":"使","note":"數位增刪改讀提示另存，正文保留增改前形式，未核影像，不當已校定。"},{"paragraph_id":"c-shiji-083-luzou:p025","witness_form":"（巖）［藪］","body_reading":"巖","note":"數位增刪改讀提示另存，正文保留增改前形式，未核影像，不當已校定。"}],"extraction_note":"固定HTML與取得時版本一致，只去外緣空白；上書dd按原序；4項數位增刪改讀另存，正文保留前形，末段巖巖重複不擅校。","note":"全27段與HTML篇界已核讀；未核底本影像或現代研究，人物待逐段標註。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical"}}
