eferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-007-xiangyu:m003-0020","start":20,"end":24,"surface":"會稽守通","kind":"person","person_id":"32m_9wz_1y5","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p003","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-007-xiangyu:m003-0117","start":117,"end":118,"surface":"守","kind":"person","person_id":"32m_9wz_1y5","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p003","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-007-xiangyu:m003-0135","start":135,"end":136,"surface":"守","kind":"person","person_id":"32m_9wz_1y5","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p003","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-007-xiangyu:m003-0168","start":168,"end":169,"surface":"守","kind":"person","person_id":"32m_9wz_1y5","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p003","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-007-xiangyu:m003-0174","start":174,"end":175,"surface":"守","kind":"person","person_id":"32m_9wz_1y5","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p003","chapter_id":"c-shiji-007-xiangyu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji007-018","person_id":"32m_9wz_1y5","surfaces":["守","會稽守通"],"scope":"same_chapter","chapter_ids":["c-shiji-007-xiangyu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-007-xiangyu:p003","quote":"秦二世元年七月，陳涉等起大澤中。其九月，會稽守通謂梁曰：「江西皆反，此亦天亡秦之時也。吾聞先即制人，後則為人所制。吾欲發兵，使公及桓楚將。」是時桓楚亡在澤中。梁曰：「桓楚亡，人莫知其處，獨籍知之耳。」梁乃出，誡籍持劍居外待。梁復入，與守坐，曰：「請召籍，使受命召桓楚。」守曰：「諾。」梁召籍入。須臾，梁眴籍曰：「可行矣！」於是籍遂拔劍斬守頭。項梁持守頭，佩其印綬。門下大驚，擾亂，籍所擊殺數十百人。一府中皆慴伏，莫敢起。梁乃召故所知豪吏，諭以所為起大事，遂舉吳中兵。使人收下縣，得精兵八千人。梁部署吳中豪傑為校尉、候、司馬。有一人不得用，自言於梁。梁曰：「前時某喪使公主某事，不能辦，以此不任用公。」眾乃皆伏。於是梁為會稽守，籍為裨將，徇下縣。"}],"rationale":"會稽守通引入後召籍、被斬之守依同段行動暫定同指；後文梁為會稽守不在此省稱內。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-007-xiangyu:p003","text":"秦二世元年七月，陳涉等起大澤中。其九月，會稽守通謂梁曰：「江西皆反，此亦天亡秦之時也。吾聞先即制人，後則為人所制。吾欲發兵，使公及桓楚將。」是時桓楚亡在澤中。梁曰：「桓楚亡，人莫知其處，獨籍知之耳。」梁乃出，誡籍持劍居外待。梁復入，與守坐，曰：「請召籍，使受命召桓楚。」守曰：「諾。」梁召籍入。須臾，梁眴籍曰：「可行矣！」於是籍遂拔劍斬守頭。項梁持守頭，佩其印綬。門下大驚，擾亂，籍所擊殺數十百人。一府中皆慴伏，莫敢起。梁乃召故所知豪吏，諭以所為起大事，遂舉吳中兵。使人收下縣，得精兵八千人。梁部署吳中豪傑為校尉、候、司馬。有一人不得用，自言於梁。梁曰：「前時某喪使公主某事，不能辦，以此不任用公。」眾乃皆伏。於是梁為會稽守，籍為裨將，徇下縣。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-007-xiangyu:m003-0000","start":0,"end":3,"surface":"秦二世","kind":"person","person_id":"ao3_0fy_d45_AAAA","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m003-0008","start":8,"end":10,"surface":"陳涉","kind":"person","person_id":"pom_ycp_ha5","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m003-0020","start":20,"end":24,"surface":"會稽守通","kind":"person","person_id":"32m_9wz_1y5","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m003-0025","start":25,"end":26,"surface":"梁","kind":"person","person_id":"5xt_rg8_7zs_A","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m003-0065","start":65,"end":67,"surface":"桓楚","kind":"person","person_id":"0ri_3st_fjq","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m003-0072","start":72,"end":74,"surface":"桓楚","kind":"person","person_id":"0ri_3st_fjq","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m003-0079","start":79,"end":80,"surface":"梁","kind":"person","person_id":"5xt_rg8_7zs_A","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m003-0083","start":83,"end":85,"surface":"桓楚","kind":"person","person_id":"0ri_3st_fjq","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m003-0094","start":94,"end":95,"surface":"籍","kind":"person","person_id":"ob7_g6i_7pp","status":"context