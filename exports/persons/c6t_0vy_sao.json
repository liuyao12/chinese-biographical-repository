nd-eastern-complete:p033","chapter_id":"c-nanqishu-058-southern-and-eastern-complete"},{"id":"c-nanqishu-058-southern-and-eastern-complete:p033:m0131","start":131,"end":133,"surface":"登之","kind":"person","person_id":"c6t_0vy_sao","status":"contextual_provisional","paragraph_id":"c-nanqishu-058-southern-and-eastern-complete:p033","chapter_id":"c-nanqishu-058-southern-and-eastern-complete"},{"id":"c-nanqishu-058-southern-and-eastern-complete:p033:m0172","start":172,"end":174,"surface":"登之","kind":"person","person_id":"c6t_0vy_sao","status":"contextual_provisional","paragraph_id":"c-nanqishu-058-southern-and-eastern-complete:p033","chapter_id":"c-nanqishu-058-southern-and-eastern-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-058-southern-and-eastern-complete:p033","text":"六年，以始興太守房法乘代楷。法乘至鎮，屬疾不理事，專好讀書。長史伏登之因此擅權，改易將吏，不令法乘知。錄事房季文白之，法乘大怒，繫登之於獄。十餘日，登之厚賂法乘妹夫崔景叔得出，將部曲襲州執法乘，謂之曰：「使君既有疾，不宜勞。」囚之別室。法乘無事，復就登之求書讀，登之曰：「使君靜處猶恐動疾，豈可看書。」遂不與。乃啟法乘心疾動，不任視事，世祖仍以登之為交州刺史。法乘還至嶺而卒。法乘，清河人。昇明中，為太祖驃騎中兵，至左中郎將。性方簡，身長八尺三寸，行出人上，常自俯屈。青州刺史明慶符亦長與法乘等，朝廷唯此二人。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":84,"last_line":84,"raw_start":7441,"raw_end":7696,"raw_character_offsets":[7441,7442,7443,7444,7445,7446,7447,7448,7449,7450,7451,7452,7453,7454,7455,7456,7457,7458,7459,7460,7461,7462,7463,7464,7465,7466,7467,7468,7469,7470,7471,7472,7473,7474,7475,7476,7477,7478,7479,7480,7481,7482,7483,7484,7485,7486,7487,7488,7489,7490,7491,7492,7493,7494,7495,7496,7497,7498,7499,7500,7501,7502,7503,7504,7505,7506,7507,7508,7509,7510,7511,7512,7513,7514,7515,7516,7517,7518,7519,7520,7521,7522,7523,7524,7525,7526,7527,7528,7529,7530,7531,7532,7533,7534,7535,7536,7537,7538,7539,7540,7541,7542,7543,7544,7545,7546,7547,7548,7549,7550,7551,7552,7553,7554,7