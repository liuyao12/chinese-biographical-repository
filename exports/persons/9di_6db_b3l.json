4355909c9d8c2c1533089e7791c6","source_unit_id":"sgz009-caozhen-full","biography_subject_person_id":"30k_jzz_tpd_A","annotator":"裴松之","attribution":"裴注轉引或案語，非陳壽正文；未親見所引原書。","cited_work":"魏略","projected_start":4035,"projected_end":4193,"attached_note_to_paragraph_id":"c-sanguozhi-009-caozhen:p028","reported_attributions":[{"offset":0,"literal":"魏略曰"}]},"chapter_id":"c-sanguozhi-009-caozhen","book_id":"b-sanguozhi-009","work_id":"w-sanguozhi","source_id":"s-sanguozhi-009-caozhen"},{"id":"c-sanguozhi-024-cuilin:p002","text":"案王氏譜雄字元伯太保祥之宗也魏名臣表載安定太守孟達薦䧺曰臣聞明君以求賢為業忠臣以進善為效故易稱拔茅連茹傳曰舉爾所知臣不自量竊慕其義臣昔以人乏謬充備部職時涿郡太守王雄為西部從事與臣同僚雄天性良固果而有謀歴試三縣政成人和及在近職奉宣威恩懷柔有術清慎持法臣往年出使經過雄郡自說特受陛下拔擢之恩常勵節精心思投命為効言辭激揚情趣欵惻臣雖愚闇不識真偽以謂雄才兼資文武忠烈之性踰越倫輩今涿郡領戸三千孤寡之家參居其半北有守兵藩衛之固誠不足舒雄智力展其勤幹也臣受恩深厚無以報國不勝慺慺淺見之情謹冐陳聞詔曰昔蕭何薦韓信鄧禹進吳漢惟賢知賢也雄有膽智技能文武之姿吾宿知之今便以參散騎之選方使少在吾門下知指歸便大用之矣天下之士欲使皆先歴散騎然後出據州郡是吾本意也雄後為幽州刺史子渾涼州刺史次乂平北將軍司徒安豐侯戎渾之子太尉武陵侯衍荆州刺史澄皆乂之子","text_layer":"witness_appended_pei_songzhi_note","annotation_status":"named_mentions_first_pass","source_position":{"first_line":66,"last_line":75,"source_layer":"pei_annotation","unit_key":"cuilin-complete","raw_projection_ref":"source-evidence/sgz024-cuilin/projection.json"},"mentions":[{"id":"c-sanguozhi-024-cuilin:p002:w0001","start":1,"end":4,"surface":"王氏譜","kind":"work","person_id":null,"status":"contextual_provisional","interpretation_note":"依本段完整敘事、引語角色與明示近親官職辨識；非按同名批量合併。","work_id":"w-wangpu-sgz024-cuilin-reference"},{"id":"c-sanguozhi-024-cuilin:p002:m0004","start":4,"end":5,"surface":"雄","kind":"person","person_id":"ehx_cqg_nfx","status":"contextual_provisional","interpretation_note":"依本段完整敘事、引語角色與明示近親官職辨識；非按同名批量合併。"},{"id":"c-sanguozhi-024-cuilin:p002:m0006","start":6,"end":8,"surface":"元伯","kind":"person","person_id":"ehx_cqg_nfx","status":"contextual_provisional","interpretation_note":"依本段完整敘事、引語角色與明示近親官職辨識；非按同名批量合併。"},{"id":"c-sanguozhi-024-cuilin:p002:m0010","start":10,"end":11,"surface":"祥","kind":"person","person_id":"7r6_k52_qji_AA","status":"contextual_provisional","interp