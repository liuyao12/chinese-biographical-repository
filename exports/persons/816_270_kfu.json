"original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-043-wangyan:p002:m0027","start":27,"end":29,"surface":"盧欽","kind":"person","person_id":"816_270_kfu","status":"contextual_provisional","resolution_note":"泰始八年與後續任官時序分開；父承首段乂，導為共載受話者。","paragraph_id":"c-jinshu-043-wangyan:p002","chapter_id":"c-jinshu-043-wangyan"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-043-wangyan:p002","text":"泰始八年，詔舉奇才可以安邊者，衍初好論從橫之術，故尚書盧欽舉為遼東太守。不就，於是口不論世事，唯雅詠玄虛而已。嘗因宴集，為族人所怒，舉樏擲其面。衍初無言，引王導共載而去。然心不能平，在車中攬鏡自照，謂導曰：「爾看吾目光乃在牛背上矣。」父卒于北平，送故甚厚，為親識之所借貸，因以舍之。數年之間，家資罄盡，出就洛城西田園而居焉。後為太子舍人，還尚書郎。出補元城令，終日清談，而縣務亦理。入為中庶子、黃門侍郎。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-043-wangyan:p002:m0015","start":15,"end":16,"surface":"衍","kind":"person","person_id":"b0c_13f_c3a","status":"contextual_provisional","resolution_note":"泰始八年與後續任官時序分開；父承首段乂，導為共載受話者。"},{"id":"c-jinshu-043-wangyan:p002:m0027","start":27,"end":29,"surface":"盧欽","kind":"person","person_id":"816_270_kfu","status":"contextual_provisional","resolution_note":"泰始八年與後續任官時序分開；父承首段乂，導為共載受話者。"},{"id":"c-jinshu-043-wangyan:p002:m0061","start":61,"end":63,"surface":"族人","kind":"unresolved","person_id":null,"status":"unresolved","resolution_note":"擲樏者所屬族人，未定單人或多人，不能憑詞造名。"},{"id":"c-jinshu-043-wangyan:p002:m0069","start":69,"end":70,"surface":"其","kind":"person","person_id":"b0c_13f_c3a","status":"contextual_provisional","resolution_note":"受擲者衍。"},{"id":"c-jinshu-043-wangyan:p002:m0072","start":72,"end":73,"surface":"衍","kind":"person","person_id":"b0c_13f_c3a","status":"contextual_provisional","resolution_note":"泰始八年與後續任官時序分開；父承首段乂，導為共載受話者。"},{"id":"c-jinshu-043-wangyan:p002:m0078","start":78,