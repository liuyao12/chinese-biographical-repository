ind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-069-liuwei:p005","chapter_id":"c-jinshu-069-liuwei"},{"id":"c-jinshu-070-zhongya:p004:m0004","surface":"劉遐","start":4,"end":6,"person_id":"1eg_4i2_q9u","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-070-zhongya:p004","chapter_id":"c-jinshu-070-zhongya"},{"id":"c-jinshu-098-jin033-wangji:line057:m0042","start":42,"end":43,"surface":"遐","kind":"person","person_id":"1eg_4i2_q9u","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line057","chapter_id":"c-jinshu-098-jin033-wangji"},{"id":"c-jinshu-098-jin033-wangji:line067:m0061","start":61,"end":63,"surface":"劉遐","kind":"person","person_id":"1eg_4i2_q9u","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line067","chapter_id":"c-jinshu-098-jin033-wangji"},{"id":"c-jinshu-098-jin033-wangji:line073:m0041","start":41,"end":43,"surface":"劉遐","kind":"person","person_id":"1eg_4i2_q9u","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line073","chapter_id":"c-jinshu-098-jin033-wangji"}],"relations":[],"title_holdings":[{"id":"th-w098-dun-main-22","person_id":"1eg_4i2_q9u","title":"兗州刺史","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-098","chapter_id":"c-jinshu-098-jin033-wangji","source_id":"s-jinshu-098-jin033-wangji","paragraph_id":"c-jinshu-098-jin033-wangji:line057","quote":"今遣司徒導，鎮南將軍、丹陽尹嶠，建威將軍趙胤武旅三萬，十道並進；平西將軍邃率兗州刺史遐、奮武將軍峻、奮威將軍贍精銳三萬，水陸齊勢；朕親禦六軍，左衛將軍亮，右衛將軍胤，護軍將軍詹，領軍將軍瞻，中軍將軍壺，驍騎將軍艾，驃騎將軍、南頓王宗，鎮軍將軍、汝南王祐，太宰、西陽王羕被練三千，組甲三萬，總統諸軍，討鳳之罪。罪止一人，朕不濫刑。有能殺鳳送首，封五千戶侯，賞布五千匹。","person_mention_id":"c-jinshu-098-jin033-wangji:line057:m0042"}],"attestations":[{"id":"th-w043-dun-main-22:a","paragraph_id":"c-jinshu-098-jin033-wangji:line057","start":38,"end":42,"surface":"兗州刺史","person_mention_id":"c-jinshu-098-jin033-wangji:line057:m0042","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-006-jin098-shenchong:defeat","text":"劉遐又破沈充于青溪。","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-006-jin098-shenchong:defeat:m0000","start":0,"end":2,"surface":"劉遐","kind":"person","person_id":"1eg_4i2_q9u","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-006-jin098-shenchong:defeat:m0004","start":4,"end":6,"surface":"沈充","kind":"person","person_id":"4c2_19b_bf4","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"text_layer":"received_chapter","source_quote":{"witness":"j6","quote":"劉遐又破沈充于青溪。","raw_start":10420,"raw_end":10430,"raw_line":201},"chapter_id":"c-jinshu-006-jin098-shenchong","book_id":"b-jinshu-006","work_id":"w-jinshu","source_id":"s-jinshu-006-jin098-shenchong"},{"id":"c-jinshu-007-jin067-xijian:earlierliu","text":"北中郎將、徐州刺史、泉陵公劉遐卒。","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-007-jin067-xijian:earlierliu:m0013","start":13,"end":15,"surface":"劉遐","kind":"person","person_id":"1eg_4i2_q9u","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"text_layer":"received_chapter","source_quote":{"witness":"j7","quote":"北中郎將、徐州刺史、泉陵公劉遐卒。","raw_start":552,"raw_end":569,"raw_line":30},"chapter_id":"c-jinshu-007-jin067-xijian","book_id":"b-jinshu-007","work_id":"w-jinshu","source_id":"s-jinshu-007-jin067-xijian"},{"id":"c-jinshu-063-guomo:p002","text":"太興初，除潁川太守。默與石匆戰敗，矩轉蹙弱，默深憂懼，解印授其參軍殷嶠，謂之曰：「李使君遇吾甚厚，今遂棄去，無顏謝之，三日可白吾去也。」乃奔陽翟。矩聞之，大怒，遣其將郭誦追默，至襄城，及之。默棄家人，單馬馳去。默至京都，明帝授征虜將軍。劉遐卒，以默為北中郎將、監淮北軍事、假節。遐故部曲李龍等謀反，詔默與右衛將軍趙胤討平之。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":73,"last_line":73,"raw_start":6484,"raw_end":6648,"raw_character_offsets":[6486,6487,6488,6489,6490,6491,6492,6493,6494,6495,6496,6497,6498,6499,6500,6501,6502,6503,6504,6505,6506,6507,6508,6509,6510,6511,6512,6513,6514,6515,6516,6517,6518,6519,6520,6521,6522,6523,6524,6525,6526,6527,6528,6529,6530,6531,6532,6533,6534,6535,6536,6537,6538,6539,6540,6541,6542,6543,6544,6545,6546,6547,6548,6549,6550,6551,6552,6553,6554,6555,6556,6557,6558,6559,6560,6561,6562,6563,6564,6565,6566,6567,6568,6569,6570,6571,6572,6573,6574,6575,6576,6577,6578,6579,6580,6581,6582,6583,6584,6585,6586,6587,6588,6589,6590,6591,6592,6593,6594,6595,6596,6597,6598,6599,6600,6601,6602,6603,6604,6605,6606,6607,6608,6609,6610,6611,6612,6613,6614,6615,6616,6617,6618,6619,6620,6621,6622,6623,6624,6625,6626,6627,6628,6629,6630,6631,6632,6633,6634,6635,6636,6637,6638,6639,6640,6641,6642,6643,6644,6645,6646,6647],"revision_id":2025242},"mentions":[{"id":"c-jinshu-063-guomo:p002:m0010","surface":"默","start":10,"end":11,"person_id":"799_f6c_778","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-063-guomo:p002:m0012","surface":"石匆","start":12,"end":14,"person_id":"u1r_1qn_z55","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-063-guomo:p002:m0017","surface":"矩","start":17,"end":18,"person_id":"tqt_mih_3ao","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-063-guomo:p002:m0022","surface":"默","start":22,"end":23,"person_id":"799_f6c_778","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-063-guomo:p002:m0033","surface":"殷嶠","start":33,"end":35,"person_id":"23b_uts_9za","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-063-guomo:p002:m0073","surface":"矩","start":73,"end":74,"person_id":"tqt_mih_3ao","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-063-guomo:p002:m0083","surface":"郭誦","start":83,"end":85,"person_id":"vrn_xbk_wei","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-063-guomo:p002:m0086","surface":"默","start":86,"end":87,"person_id":"799_f6c_778","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-063-guomo:p002:m0095","surface":"默","start":95,"end":96,"person_id":"799_f6c_778","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-063-guomo:p002:m0105","surface":"默","start":105,"end":106,"person_id":"799_f6c_778","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-063-guomo:p002:m0110","surface":"明帝","start":110,"end":112,"person_id":"dkn_ge4_286_AAAAAAAA","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-063-guomo:p002:m0118","surface":"劉遐","start":118,"end":120,"person_id":"1eg_4i2_q9u","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-063-guomo:p002:m0123","surface":"默","start":123,"end":124,"person_id":"799_f6c_778","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-063-guomo:p002:m0143","surface":"李龍","start":143,"end":145,"person_id":"4ej_623_1t3","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-063-guomo:p002:m0150","surface":"默","start":150,"end":151,"person_id":"799_f6c_778","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-063-guomo:p002:m0156","surface":"趙胤","start":156,"end":158,"person_id":"cdb_09c_d8d","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-063-guomo","book_id":"b-jinshu-063","work_id":"w-jinshu","source_id":"s-jinshu-063-guomo-ws2025242"},{"id":"c-jinshu-067-wenqiao:line024","text":"及敦構逆，加嶠中壘將軍、持節、都督東安北部諸軍事。敦與王導書曰：「太真別來幾日，作如此事！」表誅姦臣，以嶠為首。募生得嶠者，當自拔其舌。及王含、錢鳳奄至都下，嶠燒朱雀桁以挫其鋒，帝怒之，嶠曰：「今宿衛寡弱，徵兵未至，若賊豕突，危及社稷，陛下何惜一橋。」賊果不得渡。嶠自率眾與賊夾水戰，擊王含，敗之，復督劉遐追錢鳳於江寧。事平，封建寧縣開國公，賜絹五千四百匹，進號前將軍。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-067-wenqiao:line024:m0001","start":1,"end":2,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line024:m0006","start":6,"end":7,"surface":"嶠","kind":"person","person_id":"6v8_pk9_7k5","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line024:m0025","start":25,"end":26,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line024:m0027","start":27,"end":29,"surface":"王導","kind":"person","person_id":"7r6_k52_qji_ABAA","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line024:m0033","start":33,"end":35,"surface":"太真","kind":"person","person_id":"6v8_pk9_7k5","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line024:m0052","start":52,"end":53,"surface":"嶠","kind":"person","person_id":"6v8_pk9_7k5","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line024:m0059","start":59,"end":60,"surface":"嶠","kind":"person","person_id":"6v8_pk9_7k5","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line024:m0069","start":69,"end":71,"surface":"王含","kind":"person","person_id":"mwc_md4_l0g","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line024:m0072","start":72,"end":74,"surface":"錢鳳","kind":"person","person_id":"762_5c8_663","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line024:m0079","start":79,"end":80,"surface":"嶠","kind":"person","person_id":"6v8_pk9_7k5","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line024:m0093","start":93,"end":94,"surface":"嶠","kind":"person","person_id":"6v8_pk9_7k5","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line024:m0132","start":132,"end":133,"surface":"嶠","kind":"person","person_id":"6v8_pk9_7k5","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line024:m0143","start":143,"end":145,"surface":"王含","kind":"person","person_id":"mwc_md4_l0g","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line024:m0151","start":151,"end":153,"surface":"劉遐","kind":"person","person_id":"1eg_4i2_q9u","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line024:m0154","start":154,"end":156,"surface":"錢鳳","kind":"person","person_id":"762_5c8_663","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"source_position":{"first_line":24,"last_line":24,"revision_id":2592755},"source_quote":{"witness":"j67","quote":"及敦構逆，加嶠中壘將軍、持節、都督東安北部諸軍事。敦與王導書曰：「太真別來幾日，作如此事！」表誅姦臣，以嶠為首。募生得嶠者，當自拔其舌。及王含、錢鳳奄至都下，嶠燒朱雀桁以挫其鋒，帝怒之，嶠曰：「今宿衛寡弱，徵兵未至，若賊豕突，危及社稷，陛下何惜一橋。」賊果不得渡。嶠自率眾與賊夾水戰，擊王含，敗之，復督劉遐追錢鳳於江寧。事平，封建寧縣開國公，賜絹五千四百匹，進號前將軍。","raw_start":1657,"raw_end":1842,"raw_line":24},"chapter_id":"c-jinshu-067-wenqiao","book_id":"b-jinshu-067","work_id":"w-jinshu","source_id":"s-jinshu-067-wenqiao"},{"id":"c-jinshu-069-liuwei:p005","text":"初，隗以王敦威權太盛，終不可制，勸帝出腹心以鎮方隅，故以譙王承為湘州，續用隗及戴若思為都督。敦甚惡之，與隗書曰：「頃承聖上顧眄足下，今大賊未滅，中原鼎沸，欲與足下周生之徒戮力王室，共靜海內。若其泰也，則帝祚於是乎隆；若其否也，則天下永無望矣。」隗答曰：「魚相忘於江湖，人相忘於道術。竭股肱之力，效之以忠貞，吾之志也。」敦得書甚怒。及敦作亂，以討隗為名，詔征隗還京師，百官迎之於道，隗岸幘大言，意氣自若。及入見，與刁協奏請誅王氏。不從，有懼色，率眾屯金城。及敦克石頭，隗攻之不拔，入宮告辭，帝雪涕與之別。隗至淮陰，為劉遐所襲，攜妻子及親信二百餘人奔于石勒，勒以為從事中郎、太子太傅。卒年六十一。子綏，初舉秀才，除駙馬都尉、奉朝請。隨隗奔勒，卒。孫波嗣。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":19,"last_line":19,"raw_start":1673,"raw_end":2000,"raw_character_offsets":[1675,1676,1677,1678,1679,1680,1681,1682,1683,1684,1685,1686,1687,1688,1689,1690,1691,1692,1693,1694,1695,1696,1697,1698,1699,1700,1701,1702,1703,1704,1705,1706,1707,1708,1709,1710,1711,1712,1713,1714,1715,1716,1717,1718,171