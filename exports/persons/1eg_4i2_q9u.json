ity":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-006-jin098-shenchong:defeat:m0000","start":0,"end":2,"surface":"劉遐","kind":"person","person_id":"1eg_4i2_q9u","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-006-jin098-shenchong:defeat","chapter_id":"c-jinshu-006-jin098-shenchong"},{"id":"c-jinshu-098-jin033-wangji:line057:m0042","start":42,"end":43,"surface":"遐","kind":"person","person_id":"1eg_4i2_q9u","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line057","chapter_id":"c-jinshu-098-jin033-wangji"},{"id":"c-jinshu-098-jin033-wangji:line067:m0061","start":61,"end":63,"surface":"劉遐","kind":"person","person_id":"1eg_4i2_q9u","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line067","chapter_id":"c-jinshu-098-jin033-wangji"},{"id":"c-jinshu-098-jin033-wangji:line073:m0041","start":41,"end":43,"surface":"劉遐","kind":"person","person_id":"1eg_4i2_q9u","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line073","chapter_id":"c-jinshu-098-jin033-wangji"}],"relations":[],"title_holdings":[{"id":"th-w098-dun-main-22","person_id":"1eg_4i2_q9u","title":"兗州刺史","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-098","chapter_id":"c-jinshu-098-jin033-wangji","source_id":"s-jinshu-098-jin033-wangji","paragraph_id":"c-jinshu-098-jin033-wangji:line057","quote":"今遣司徒導，鎮南將軍、丹陽尹嶠，建威將軍趙胤武旅三萬，十道並進；平西將軍邃率兗州刺史遐、奮武將軍峻、奮威將軍贍精銳三萬，水陸齊勢；朕親禦六軍，左衛將軍亮，右衛將軍胤，護軍將軍詹，領軍將軍瞻，中軍將軍壺，驍騎將軍艾，驃騎將軍、南頓王宗，鎮軍將軍、汝南王祐，太宰、西陽王羕被練三千，組甲三萬，總統諸軍，討鳳之罪。罪止一人，朕不濫刑。有能殺鳳送首，封五千戶侯，賞布五千匹。","person_mention_id":"c-jinshu-098-jin033-wangji:line057:m0042"}],"attestations":[{"id":"th-w043-dun-main-22:a","paragraph_id":"c-jinshu-098-jin033-wangji:line057","start":38,"end":42,"surface":"兗州刺史","person_mention_id":"c-jinshu-098-jin033-wangji:line057:m0042","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-006-jin098-shenchong:defeat","text":"劉遐又破沈充于青溪。","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-006-jin098-shenchong:defeat:m0000","start":0,"end":2,"surface":"劉遐","kind":"person","person_id":"1eg_4i2_q9u","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-006-jin098-shenchong:defeat:m0004","start":4,"end":6,"surface":"沈充","kind":"person","person_id":"4c2_19b_bf4","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"text_layer":"received_chapter","source_quote":{"witness":"j6","quote":"劉遐又破沈充于青溪。","raw_start":10420,"raw_end":10430,"raw_line":201},"chapter_id":"c-jinshu-006-jin098-shenchong","book_id":"b-jinshu-006","work_id":"w-jinshu","source_id":"s-jinshu-006-jin098-shenchong"},{"id":"c-jinshu-098-jin033-wangji:line057","text":"今遣司徒導，鎮南將軍、丹陽尹嶠，建威將軍趙胤武旅三萬，十道並進；平西將軍邃率兗州刺史遐、奮武將軍峻、奮威將軍贍精銳三萬，水陸齊勢；朕親禦六軍，左衛將軍亮，右衛將軍胤，護軍將軍詹，領軍將軍瞻，中軍將軍壺，驍騎將軍艾，驃騎將軍、南頓王宗，鎮軍將軍、汝南王祐，太宰、西陽王羕被練三千，組甲三萬，總統諸軍，討鳳之罪。罪止一人，朕不濫刑。有能殺鳳送首，封五千戶侯，賞布五千匹。","annotation_status":"reviewed","text_layer":"received_chapter","mentions":[{"id":"c-jinshu-098-jin033-wangji:line057:m0004","start":4,"end":5,"surface":"導","kind":"person","person_id":"7r6_k52_qji_ABAA","status":