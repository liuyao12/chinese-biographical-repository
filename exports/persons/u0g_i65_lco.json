amily_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-041-zhangrong-complete:p002:m0011","start":11,"end":14,"surface":"陸脩靜","kind":"person","person_id":"u0g_i65_lco","status":"contextual_provisional","paragraph_id":"c-nanqishu-041-zhangrong-complete:p002","chapter_id":"c-nanqishu-041-zhangrong-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-041-zhangrong-complete:p002","text":"　　融年弱冠，道士同郡陸脩靜以白鷺羽麈尾扇遺融，曰：「此旣異物，以奉異人。」宋孝武聞融有早譽，解褐爲新安王北中郎參軍。孝武起新安寺，僚佐多儭錢帛，融獨儭百錢。帝曰：「融殊貧，當序以佳祿。」出爲封溪令。從叔永出後渚送之，曰：「似聞朝旨，汝尋當還。」融曰：「不患不還，政恐還而復去。」廣越嶂嶮，獠賊執融，將殺食之，融神色不動，方作洛生詠，賊異之而不害也。浮海至交州，於海中作《海賦》曰：","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":14,"last_line":14,"raw_start":206,"raw_end":397,"raw_character_offsets":[206,207,208,209,210,211,212,213,214,215,216,217,218,219,220,221,222,223,224,225,226,227,228,229,230,231,232,233,234,235,236,237,238,239,240,241,242,243,244,245,246,247,248,249,250,251,252,253,254,255,256,257,258,259,260,261,262,263,264,265,266,267,268,269,270,271,272,273,274,275,276,277,278,279,280,281,282,283,284,285,286,287,288,289,290,291,292,293,294,295,296,297,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,318,319,320,321,322,323,324,325,326,327,328,329,330,331,332,333,334,335,336,337,338,339,340,341,342,343,344,345,346,347,348,349,350,351,352,353,354,355,356,357,358,359,360,361,362,363,364,365,366,367,368,369,370,371,372,373,374,375,376,377,378,379,380,381,382,383,384,385,386,387,388,389,390,391,392,393,394,395,396],"revision_id":2044621},"mentions":[{"id":"c-nanqishu-041-zhangrong-complete:p002:m0002","start":2,"end":3,"surface":"融","k