fault":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-053-xuezong:line043:m0171","start":171,"end":173,"surface":"任延","kind":"person","person_id":"fmf_376_4ip","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-053-xuezong:line043","chapter_id":"c-sanguozhi-053-xuezong"}],"relations":[],"title_holdings":[{"id":"t-wu053-t-wu053-xuezong5","person_id":"fmf_376_4ip","kind":"office","title":"九真太守","mode":"attestation","status":"source_attested","effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本句所載職官，任免時間未詳。","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-053","chapter_id":"c-sanguozhi-053-xuezong","source_id":"s-sanguozhi-053-xuezong","paragraph_id":"c-sanguozhi-053-xuezong:line043","quote":"昔帝舜南巡，卒於蒼梧。泰置桂林、南海、象郡，然則四國之內屬也，有自來矣。趙佗起番禺，懷服百越之君，珠宮之南是也。漢武帝誅呂嘉，開九郡，設交阯刺史以鎮監之。山川長遠，習俗不齊，言語同異，重譯乃通。民如禽獸，長幼無別，椎結徒跣，貫頭左衽，長吏之設，雖有若無。自斯以來，頗徙中國罪人雜居其間，稍使學書，粗知言語，使驛往來，觀見禮化。及後錫光為交阯，任延為九真太守，乃教其耕梨，使之冠履；為設媒官，始知聘娶；建立學校，導之經義。由此已降，四百餘年，頗有似類。自臣昔客始至之時，珠崖除州縣嫁娶，皆須八月引戶，人民集會之時，男女自相可適，乃為夫妻，父母不能止。","person_mention_id":"c-sanguozhi-053-xuezong:line043:m0171"}],"attestations":[{"id":"t-wu053-t-wu053-xuezong5:a","paragraph_id":"c-sanguozhi-053-xuezong:line043","person_mention_id":"c-sanguozhi-053-xuezong:line043:m0171","start":174,"end":178,"surface":"九真太守","usage":"narrative","date_expression":null}],"human_reviewed":false,"reviewer":"Codex（AI 代理）","model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-053-xuezong:line043","text":"昔帝舜南巡，卒於蒼梧。泰置桂林、南海、象郡，然則四國之內屬也，有自來矣。趙佗起番禺，懷服百越之君，珠宮之南是也。漢武帝誅呂嘉，開九郡，設交阯刺史以鎮監之。山川長遠，習俗不齊，言語同異，重譯乃通。民如禽獸，長幼無別，椎結徒跣，貫頭左衽，長吏之設，雖有若無。自斯以來，頗徙中國罪人雜居其間，稍使學書，粗知言語，使驛往來，觀見禮化。及後錫光為交阯，任延為九真太守，乃教其耕梨，使之冠履；為設媒官，始知聘娶；建立學校，導之經義。由此已降，四百餘年，頗有似類。自臣昔客始至之時，珠崖除州縣嫁娶，皆須八月引戶，人民集會之時，男女自相可適，乃為夫妻，父母不能止。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-053-xuezong:line043:m0001","start":1,"end":3,"surface":"帝舜","kind":"person","person_id":"ddb_l4j_4j2","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xuezong:line043:m0036","start":36,"end":38,"surface":"趙佗","kind":"person","person_id":"bvb_d1z_fd0","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xuezong:line043:m0056","start":56,"end":59,"surface":"漢武帝","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xuezong:line043:m0060","start":60,"end":62,"surface":"呂嘉","kind":"person","person_id":"jfm_184_2yb","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xuezong:line043:m0165","start":165,"end":167,"surface":"錫光","kind":"person","person_id":"pq1_qb7_zgq","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xuezong:line043:m0171","start":171,"end":173,"surface":"任延","kind":"person","person_id":"fmf_376_4ip","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"}],"annotation_status":"reviewed","source_position":{"first_line":43,"last_line":43,"revision_id":2086397,"raw_start":5259,"raw_end":5541,"character_positions":[5267,5268,5269,5270,5271,5272,5273,5274,5275,5276,5277,5278,5279,5280,5281,5282,5283,5284,5285,5286,5287,5288,5289,5290,5291,5292,5293,5294,5295,5296,5297,5298,5299,5300,5301,5302,5303,5304,5305,5306,5307,5308,5309,5310,5311,5312,5313,5314,5315,5316,5317,5318,5319,5320,5321,5322,5323,5324,5325,5326,5327,5328,5329,5330,5331,5332,5333,5334,5335,5336,5337,5338,5339,5340,5341,5342,5343,5344,5345,5346,5347,5348,5349,5350,5351,5352,5353,