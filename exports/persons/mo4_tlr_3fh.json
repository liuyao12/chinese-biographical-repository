quency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-004-zhou:m017-0114","start":114,"end":116,"surface":"尹佚","kind":"person","person_id":"mo4_tlr_3fh","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p017","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-004-zhou:m018-0091","start":91,"end":93,"surface":"史佚","kind":"person","person_id":"mo4_tlr_3fh","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p018","chapter_id":"c-shiji-004-zhou"}],"relations":[],"title_holdings":[],"address_assertions":[],"person_references":[{"id":"c-liangshu-033-wangsengru:p009:r0410","surface":"佚","start":410,"end":411,"person_id":"mo4_tlr_3fh","referent_role":"third_person","paragraph_id":"c-liangshu-033-wangsengru:p009","quote":"顧惟不肖，文質無所底，蓋困於衣食，迫於饑寒，依隱易農，所志不過鐘庾。久爲尺板鬥食之吏，以從皁衣黑綬之役，非有奇才絕學，雄略高謨，吐一言可以匡俗振民，動一議可以固邦興國。全璧歸趙，飛矢救燕，偃息籓魏，甘臥安郢，腦日逐，髓月支，擁十萬而橫行，提五千而深入，將能執圭裂壤，功勒景鐘，錦繡爲衣，朱丹被轂，斯大丈夫之志，非吾曹之所能及已。直以章句小才，蟲篆末藝，含吐緗縹之上，翩躚樽俎之側，委曲同之針縷，繁碎譬之米鹽，孰致顯榮，何能至到。加性疏澀，拙於進取，未嘗去來許、史，遨遊梁、竇，俯首脅肩，先意承旨。是以三葉靡遘，不與運幷，十年未徙，孰非能薄。及除舊佈新，清晷方旦，抱樂銜圖，訟謳有主，而猶限一吏于岑石，隔千里於泉亭，不得奉板中涓，預衣裳之會，提戈後勁，厠龍豹之謀。及其投劾歸來，恩均舊隸，升文石，登玉陛，一見而降顏色，再睹而接話言，非藉左右之容，無勞羣公之助。又非同席共研之夙逢，笥餌卮酒之早識，一旦陪武帳，仰文陛，備聃、佚之柱下，充嚴、朱之席上，入班九棘，出專千里，據操撮之雄官，參人倫之顯職，雖古之爵人不次，取士無名，未有躡影追風，奔驟之若此者也。","note":"依原有文體、發言者、受話人、王府或本傳前後文。","chapter_id":"c-liangshu-033-wangsengru","book_id":"b-liangshu-033","work_id":"w-liangshu","source_id":"s-liangshu-033-wangsengru-ws1514481"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji004-028","person_id":"mo4_tlr_3fh","surfaces":["尹佚","史佚"],"scope":"same_chapter","chapter_ids":["c-shiji-004-zhou"],"status":"contextual_provisional","evidence":[