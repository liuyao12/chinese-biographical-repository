{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"tfu_611_q19","canonical_person_id":"tfu_611_q19","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["tfu_611_q19"],"persons":[{"id":"tfu_611_q19","label":"潁陰侯嬰（本段稱呼）（魏其武安侯列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"潁陰侯嬰","mention_ids":["c-shiji-107-weiqi:m012-0018"]}],"evidence":[{"mention_id":"c-shiji-107-weiqi:m012-0018","chapter_id":"c-shiji-107-weiqi","paragraph_id":"c-shiji-107-weiqi:p012","quote":"潁陰侯嬰"}]}],"source_mention_summary":[{"source_id":"s-shiji-107-weiqi","work_id":"w-shiji","book_id":"b-shiji-107","chapter_id":"c-shiji-107-weiqi","mention_count":1,"mention_ids":["c-shiji-107-weiqi:m012-0018"],"paragraph_ids":["c-shiji-107-weiqi:p012"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-107-weiqi"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-107-weiqi:m012-0018","start":18,"end":22,"surface":"潁陰侯嬰","kind":"person","person_id":"tfu_611_q19","status":"contextual_provisional","paragraph_id":"c-shiji-107-weiqi:p012","chapter_id":"c-shiji-107-weiqi"}],"relations":[],"title_holdings":[{"id":"th-shiji107-039","person_id":"tfu_611_q19","title":"潁陰侯","kind":"noble_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-107-weiqi","source_id":"s-shiji-107-weiqi","paragraph_id":"c-shiji-107-weiqi:p012","quote":"灌將軍夫者，潁陰人也。夫父張孟，嘗為潁陰侯嬰舍人，得幸，因進之至二千石，故蒙灌氏姓為灌孟。吳楚反時，潁陰侯灌何為將軍，屬太尉，請灌孟為校尉。夫以千人與父俱。灌孟年老，潁陰侯彊請之，郁郁不得意，故戰常陷堅，遂死吳軍中。軍法，父子俱從軍，有死事，得與喪歸。灌夫不肯隨喪歸，奮曰：「願取吳王若將軍頭，以報父之仇。」於是灌夫被甲持戟，募軍中壯士所善願從者數十人。及出壁門，莫敢前。獨二人及從奴十數騎馳入吳軍，至吳將麾下，所殺傷數十人。不得前，復馳還，走入漢壁，皆亡其奴，獨與一騎歸。夫身中大創十餘，適有萬金良藥，故得無死。夫創少瘳，又復請將軍曰：「吾益知吳壁中曲折，請復往。」將軍壯義之，恐亡夫，乃言太尉，太尉乃固止之。吳已破，灌夫以此名聞天下。"}],"attestations":[{"id":"th-shiji107-039:a001","paragraph_id":"c-shiji-107-weiqi:p012","start":18,"end":21,"surface":"潁陰侯","person_mention_id":"c-shiji-107-weiqi:m012-0018","usage":"retrospective"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"按本段明示用稱記錄，不從任他官、案件、敘事位置或死亡補造爵位授任與終止。潁陰侯嬰及灌何為不同候選，分別記用稱。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-107-weiqi:p012","text":"灌將軍夫者，潁陰人也。夫父張孟，嘗為潁陰侯嬰舍人，得幸，因進之至二千石，故蒙灌氏姓為灌孟。吳楚反時，潁陰侯灌何為將軍，屬太尉，請灌孟為校尉。夫以千人與父俱。灌孟年老，潁陰侯彊請之，郁郁不得意，故戰常陷堅，遂死吳軍中。軍法，父子俱從軍，有死事，得與喪歸。灌夫不肯隨喪歸，奮曰：「願取吳王若將軍頭，以報父之仇。」於是灌夫被甲持戟，募軍中壯士所善願從者數十人。及出壁門，莫敢前。獨二人及從奴十數騎馳入吳軍，至吳將麾下，所殺傷數十人。不得前，復馳還，走入漢壁，皆亡其奴，獨與一騎歸。夫身中大創十餘，適有萬金良藥，故得無死。夫創少瘳，又復請將軍曰：「吾益知吳壁中曲折，請復往。」將軍壯義之，恐亡夫，乃言太尉，太尉乃固止之。吳已破，灌夫以此名聞天下。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-107-weiqi:m012-0000","start":0,"end":4,"surface":"灌將軍夫","kind":"person","person_id":"h1w_44g_vef_A","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m012-0011","start":11,"end":12,"surface":"夫","kind":"person","person_id":"h1w_44g_vef_A","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m012-0013","start":13,"end":15,"surface":"張孟","kind":"person","person_id":"h1w_44g_vef","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m012-0018","start":18,"end":22,"surface":"潁陰侯嬰","kind":"person","person_id":"tfu_611_q19","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m012-0042","start":42,"end":44,"surface":"灌孟","kind":"person","person_id":"h1w_44g_vef","status":"contextual_provisional"},{"id":