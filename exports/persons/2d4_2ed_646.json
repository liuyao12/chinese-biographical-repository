":221}],"effective_period":{"start":{"status":"source_event","event_type":"posthumous_grant","date_expression":null,"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-040","source_id":"s-nanqishu-040-zixiang-ws2272748","chapter_id":"c-nanqishu-040-zixiang","paragraph_id":"c-nanqishu-040-zixiang:p005","quote":"臨死，啓上曰：「劉寅等入齋檢仗，具如前啓。臣罪旣山海，分甘斧鉞。奉勑遣胡諧之、茹法亮賜重勞，其等至，竟無宣旨，便建旗入津，對城南岸築城守。臣累遣書信喚法亮渡，乞白服相見，其永不肯，羣小懼怖，遂致攻戰，此臣之罪也。臣此月二十五日束身投軍，希還天闕，停宅一月，臣自取盡，可使齊代無殺子之譏，臣免逆父之謗。旣不遂心，今便命盡，臨啓哽塞，知復何陳。」有司奏絕子響屬籍，削爵土，收付廷尉法獄治罪。賜爲蛸氏。諸所連坐，別下考論。贈劉寅侍中，席恭穆輔國將軍、益州刺史，江愈、殷曇粲黃門郎，周彥驍騎將軍。寅字景蕤，高平人也。有文義而學不閑世務。席恭穆，安定焉氏人，關隴豪族。","person_mention_id":"c-nanqishu-040-zixiang:p005:m0214"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-040","source_id":"s-nanqishu-040-zixiang-ws2272748","chapter_id":"c-nanqishu-040-zixiang","paragraph_id":"c-nanqishu-040-zixiang:p005","quote":"臨死，啓上曰：「劉寅等入齋檢仗，具如前啓。臣罪旣山海，分甘斧鉞。奉勑遣胡諧之、茹法亮賜重勞，其等至，竟無宣旨，便建旗入津，對城南岸築城守。臣累遣書信喚法亮渡，乞白服相見，其永不肯，羣小懼怖，遂致攻戰，此臣之罪也。臣此月二十五日束身投軍，希還天闕，停宅一月，臣自取盡，可使齊代無殺子之譏，臣免逆父之謗。旣不遂心，今便命盡，臨啓哽塞，知復何陳。」有司奏絕子響屬籍，削爵土，收付廷尉法獄治罪。賜爲蛸氏。諸所連坐，別下考論。贈劉寅侍中，席恭穆輔國將軍、益州刺史，江愈、殷曇粲黃門郎，周彥驍騎將軍。寅字景蕤，高平人也。有文義而學不閑世務。席恭穆，安定焉氏人，關隴豪族。","person_mention_id":"c-nanqishu-040-zixiang:p005:m0214"}],"status":"source_attested","interpretation_note":"按本見證原職名及其所屬人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"posthumous_basis":{"kind":"qi040_zixiang_officer_funeral_award","source_term":"臨死，啓上曰：「劉寅等入齋檢仗，具如前啓。臣罪旣山海，分甘斧鉞。奉勑遣胡諧之、茹法亮賜重勞，其等至，竟無宣旨，便建旗入津，對城南岸築城守。臣累遣書信喚法亮渡，乞白服相見，其永不肯，羣小懼怖，遂致攻戰，此臣之罪也。臣此月二十五日束身投軍，希還天闕，停宅一月，臣自取盡，可使齊代無殺子之譏，臣免逆父之謗。旣不遂心，今便命盡，臨啓哽塞，知復何陳。」有司奏絕子響屬籍，削爵土，收付廷尉法獄治罪。賜爲蛸氏。諸所連坐，別下考論。贈劉寅侍中，席恭穆輔國將軍、益州刺史，江愈、殷曇粲黃門郎，周彥驍騎將軍。寅字景蕤，高平人也。有文義而學不閑世務。席恭穆，安定焉氏人，關隴豪族。","death_term":"殺","grant_term":"贈","death_event_id":"le-nanqi040-zixiang-officer2","death_anchor":{"paragraph_id":"c-nanqishu-040-zixiang:p003","surface":"殺","start":223,"end":224},"grant_anchor":{"paragraph_id":"c-nanqishu-040-zixiang:p005","surfac