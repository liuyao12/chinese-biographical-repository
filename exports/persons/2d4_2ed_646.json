ce":[]}},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-049","chapter_id":"c-nanqishu-049-xiqian","source_id":"s-nanqishu-049-xiqian-ws2261984","paragraph_id":"c-nanqishu-049-xiqian:p001","quote":"時新蔡太守席謙，永明中爲中書郎王融所薦。父恭穆，鎮西司馬，爲魚復侯所害。至是謙鎮盆城，聞義師東下，曰：「我家世忠貞，殞死不二。」爲陳伯之所殺。","person_mention_id":"c-nanqishu-049-xiqian:p001:m0021"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"person_references":[{"id":"c-nanqishu-049-xiqian:p001:r0020","paragraph_id":"c-nanqishu-049-xiqian:p001","start":20,"end":21,"surface":"父","person_id":"2d4_2ed_646","referent_role":"third_person","quote":"父恭穆","note":"依句內語法、說話對象及本段承接辨識。","chapter_id":"c-nanqishu-049-xiqian","book_id":"b-nanqishu-049","work_id":"w-nanqishu","source_id":"s-nanqishu-049-xiqian-ws2261984"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-040-zixiang:p003","text":"七年，遷使持節、都督荊湘雍梁寧南北秦七州軍事、鎮軍將軍、荊州刺史。子響少好武，在西豫時，自選帶仗左右六十人，皆有膽幹。至鎮，數在內齋殺牛置酒，與之聚樂。令內人私作錦袍絳襖，欲餉蠻交易器仗。長史劉寅等連名密啓，上勑精檢。寅等懼，欲秘之。子響聞臺使至，不見勑，召寅及司馬席恭穆、諮議參軍江愈、殷曇粲、中兵參軍周彥、典籤吳脩之、王賢宗、魏景淵於琴臺下詰問之。寅等無言。脩之曰：「旣以降勑旨，政應方便答塞。」景淵曰：「故應先檢校。」子響大怒，執寅等於後堂殺之。以啓無江愈名，欲釋之，而用命者已加戮。上聞之怒，遣衞尉胡諧之、游擊將軍尹略、中書舍人茹法亮領齋仗數百人，檢捕羣小。勑：「子響若束首自歸，可全其性命。」","mentions":[{"id":"c-nanqishu-040-zixiang:p003:m0033","surface":"子響","start":33,"end":35,"person_id":"kix_r92_2ed_G","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-040-zixiang:p003:m0096","surface":"劉寅","start":96,"end":98,"person_id":"zoy_74m_fbk","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-040-zixiang:p003:m0109","surface":"寅","start":109,"end":110,"person_id":"zoy_74m_fbk","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-040-zixiang:p0