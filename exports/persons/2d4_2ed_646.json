d":"2d4_2ed_646","event_type":"death","source_term":"所害","source_anchor":{"paragraph_id":"c-nanqishu-049-xiqian:p001","start":33,"end":35,"surface":"所害"},"date_expression":null,"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-049","chapter_id":"c-nanqishu-049-xiqian","source_id":"s-nanqishu-049-xiqian-ws2261984","paragraph_id":"c-nanqishu-049-xiqian:p001","quote":"時新蔡太守席謙，永明中爲中書郎王融所薦。父恭穆，鎮西司馬，爲魚復侯所害。至是謙鎮盆城，聞義師東下，曰：「我家世忠貞，殞死不二。」爲陳伯之所殺。","person_mention_id":"c-nanqishu-049-xiqian:p001:m0021"}],"status":"source_attested","interpretation_note":"按同段人物與次第核所屬卒事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"mentions":[{"id":"c-nanqishu-040-zixiang:p003:m0133","surface":"席恭穆","start":133,"end":136,"person_id":"2d4_2ed_646","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-nanqishu-040-zixiang:p003","chapter_id":"c-nanqishu-040-zixiang"},{"id":"c-nanqishu-040-zixiang:p005:m0214","surface":"席恭穆","start":214,"end":217,"person_id":"2d4_2ed_646","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-nanqishu-040-zixiang:p005","chapter_id":"c-nanqishu-040-zixiang"},{"id":"c-nanqishu-040-zixiang:p005:m0264","surface":"席恭穆","start":264,"end":267,"person_id":"2d4_2ed_646","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-nanqishu-040-zixiang:p005","chapter_id":"c-nanqishu-040-zixiang"},{"id":"c-nanqishu-049-xiqian:p001:m0021","start":21,"end":23,"surface":"恭穆","kind":"person","person_id":"2d4_2ed_646","status":"contextual_provisional","paragraph_id":"c-nanqishu-049-xiqian:p001","chapter_id":"c-nanqishu-049-xiqian"}],"relations":[{"id":"a-qi049-xiqian-gongmu","subject_person_id":"2d4_2ed_646_A","object_person_id":"2d4_2ed_646","predicate":"father","qualifiers":{"source_term":"父恭穆","lineage":"paternal"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-049","chapter_id":"c-nanqishu-049-xiqian","source