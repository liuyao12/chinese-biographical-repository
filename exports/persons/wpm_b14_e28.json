{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"wpm_b14_e28","canonical_person_id":"wpm_b14_e28","id_aliases":["cbr-p004825"],"identity_policy":"contextual_provisional","person_ids":["wpm_b14_e28"],"persons":[{"id":"wpm_b14_e28","label":"楚平王（刺客列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"楚平王","mention_ids":["c-shiji-086-cike:m006-0014"]}],"evidence":[{"mention_id":"c-shiji-086-cike:m006-0014","chapter_id":"c-shiji-086-cike","paragraph_id":"c-shiji-086-cike:p006","quote":"楚平王"}],"id_aliases":["cbr-p004825"]}],"source_mention_summary":[{"source_id":"s-shiji-086-cike","work_id":"w-shiji","book_id":"b-shiji-086","chapter_id":"c-shiji-086-cike","mention_count":1,"mention_ids":["c-shiji-086-cike:m006-0014"],"paragraph_ids":["c-shiji-086-cike:p006"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-086-cike"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-086-cike:m006-0014","start":14,"end":17,"surface":"楚平王","kind":"person","person_id":"wpm_b14_e28","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p006","chapter_id":"c-shiji-086-cike"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji086-014","person_id":"wpm_b14_e28","scope":"same_chapter","chapter_ids":["c-shiji-086-cike"],"status":"contextual_provisional","rationale":"依專諸刺僚、公子光自立闔閭與豫讓報智伯敘事暫接。專諸之子、豫讓妻友保持未名；范中行氏與母老子弱未補名，嵌套對話指代待核。","reviewer":"Codex（AI 代理）","surfaces":["楚平王"],"evidence":[{"paragraph_id":"c-shiji-086-cike:p006","quote":"光既得專諸，善客待之。九年而楚平王死。春，呉王僚欲因楚喪，使其二弟公子蓋餘、屬庸將兵圍楚之灊；使延陵季子於晉，以觀諸侯之變。楚發兵絶呉將蓋餘、屬庸路，呉兵不得還。於是公子光謂專諸曰：「此時不可失，不求何獲！且光眞王嗣，當立，季子雖來，不吾廢也。」專諸曰：「王僚可殺也。母老子弱，而兩弟將兵伐楚，楚絶其後。方今呉外困於楚，而内空無骨鯁之臣，是無如我何。」公子光頓首曰：「光之身，子之身也。」"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-086-cike:p006","text":"光既得專諸，善客待之。九年而楚平王死。春，呉王僚欲因楚喪，使其二弟公子蓋餘、屬庸將兵圍楚之灊；使延陵季子於晉，以觀諸侯之變。楚發兵絶呉將蓋餘、屬庸路，呉兵不得還。於是公子光謂專諸曰：「此時不可失，不求何獲！且光眞王嗣，當立，季子雖來，不吾廢也。」專諸曰：「王僚可殺也。母老子弱，而兩弟將兵伐楚，楚絶其後。方今呉外困於楚，而内空無骨鯁之臣，是無如我何。」公子光頓首曰：「光之身，子之身也。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-086-cike:m006-0000","start":0,"end":1,"surface":"光","kind":"person","person_id":"m0z_vep_k8y_A","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m006-0003","start":3,"end":5,"surface":"專諸","kind":"person","person_id":"1f5_azb_lmy","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m006-0014","start":14,"end":17,"surface":"楚平王","kind":"person","person_id":"wpm_b14_e28","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m006-0021","start":21,"end":24,"surface":"呉王僚","kind":"person","person_id":"xyg_gxo_6tt_A","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m006-0033","start":33,"end":37,"surface":"公子蓋餘","kind":"person","person_id":"1vr_rmi_ay7","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m006-0038","start":38,"end":40,"surface":"屬庸","kind":"person","person_id":"gli_u6t_bjm","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m006-0048","start":48,"end":52,"surface":"延陵季子","kind":"person","person_id":"h2m_fay_h7r","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m006-0057","start":57,"end":59,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名氏稱或尚待核定的嵌套親屬指代，不補姓名。"},{"id":"c-shiji-086-cike:m006-0068","start":68,"end":70,"surface":"蓋餘","kind":"person","person_id":"1vr_rmi_ay7","status":"contextual_provisional"},{"id":"c-shiji-0