ree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-005-qin:m032-0257","start":257,"end":259,"surface":"弦高","kind":"person","person_id":"v8l_ue6_un4","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p032","chapter_id":"c-shiji-005-qin"},{"id":"c-shiji-039-jin:m078-0055","start":55,"end":57,"surface":"絃髙","kind":"person","person_id":"v8l_ue6_un4","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p078","chapter_id":"c-shiji-039-jin"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[{"id":"shiji-014-r215-c13-m000","start":10,"end":12,"surface":"弦高","person_id":"v8l_ue6_un4","status":"contextual_provisional","interpretation_note":"依本格國別、事件與本篇時間範圍核讀的完整名字暫定同指；非全域字串配對，省稱與世襲稱號另行核讀。","table_id":"shiji-014","table_fragment_id":"shiji-014-digital-table-1","table_row_id":"shiji-014-r215","table_cell_id":"shiji-014-r215-c13","work_id":"w-shiji","book_id":"b-shiji-014","chapter_id":"table-chapter-shiji-014","source_id":"table-witness-shiji-014","source_revision":"2607001","kind":"table_person_mention","quote":"鄭穆公蘭元年秦襲我，弦高詐之。"}],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji039-066","person_id":"v8l_ue6_un4","surfaces":["絃髙"],"scope":"cross_chapter","chapter_ids":["c-shiji-005-qin","c-shiji-039-jin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-005-qin:p032","quote":"鄭人有賣鄭於秦曰：「我主其城門，鄭可襲也。」繆公問蹇叔、百里傒，對曰：「徑數國千里而襲人，希有得利者。且人賣鄭，庸知我國人不有以我情告鄭者乎？不可。」繆公曰：「子不知也，吾已決矣。」遂發兵，使百里傒子孟明視，蹇叔子西乞術及白乙丙將兵。行日，百里傒、蹇叔二人哭之。繆公聞，怒曰：「孤發兵而子沮哭吾軍，何也？」二老曰：「臣非敢沮君軍。軍行，臣子與往；臣老，遲還恐不相見，故哭耳。」二老退，謂其子曰：「汝軍即敗，必於殽阨矣。」三十三年春，秦兵遂東，更晉地，過周北門。周王孫滿曰：「秦師無禮，不敗何待！」兵至滑，鄭販賣賈人弦高，持十二牛將賣之周，見秦兵，恐死虜，因獻其牛，曰：「聞大國將誅鄭，鄭君謹修守御備，使臣以牛十二勞軍士。」秦三將軍相謂曰：「將襲鄭，鄭今已覺之，往無及已。」滅滑。滑，晉之邊邑也。"},{"paragraph_id":"c-shiji-039-jin:p078","quote":"鄭人或賣其國於秦，秦繆公發兵往襲鄭。十二月，秦兵過我郊。襄公元年春，秦師過周，無禮，王孫滿譏之。兵至滑，鄭賈人絃髙將市于周，遇之，以十二牛勞秦師。秦師驚而還，滅滑而去。"}],"rationale":"按本篇明示名與稱號、晉世系與具體事件暫定所列提及同指；附各段原文，未按同字短名全域合併；紀年與版本差異待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-005-qin:p032","text":"鄭人有賣鄭於秦曰：「我主其城門，鄭可襲也。」繆公問蹇叔、百里傒，對曰：「徑數國千里而襲人，希有得利者。且人賣鄭，庸知我國人不有以我情告鄭者乎？不可。」繆公曰：「子不知也，吾已決矣。」遂發兵，使百里傒子孟明視，蹇叔子西乞術及白乙丙將兵。行日，百里傒、蹇叔二人哭之。繆公聞，怒曰：「孤發兵而子沮哭吾軍，何也？」二老曰：「臣非敢沮君軍。軍行，臣子與往；臣老，遲還恐不相見，故哭耳。」二老退，謂其子曰：「汝軍即敗，必於殽阨矣。」三十三年春，秦兵遂東，更晉地，過周北門。周王孫滿曰：「秦師無禮，不敗何待！」兵至滑，鄭販賣賈人弦高，持十二牛將賣之周，見秦兵，恐死虜，因獻其牛，曰：「聞大國將誅鄭，鄭君謹修守御備，使臣以牛十二勞軍士。」秦三將軍相謂曰：「將襲鄭，鄭今已覺之，往無及已。」滅滑。滑，晉之邊邑也。","annotation_status":"in_progress","mentions":[{"id":"c-shiji-005-qin:m032-0000","start":0,"end":2,"surface":"鄭人","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或待核指代；不由官稱或熟知世系補造個人。"},{"id":"c-shiji-005-qin:m032-0022","start":22,"end":24,"surface":"繆公","kind":"person","person_id":"y97_huh_vuz_AAAAA","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m032-0025","start":25,"end":27,"surface":"蹇叔","kind":"person","person_id":"7du_pfa_2s5","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m032-0028","start":28,"end":31,"surface":"百里傒","kind":"person","person_id":"ylb_ttg_8dr","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m032-0075","start":75,"end":77,"surface":"繆公","kind":"person","person_id":"y97_huh_vuz_AAAAA","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m032-0096","start":96,"end":99,"surface":"百里傒","kind":"person","person_id":"ylb_ttg_8dr","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m032-0100","start":100,"end":103,"surface":"孟明視","kind":"person","person_id":"ylb_ttg_8dr_A","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m032-0104","start":104,"end":106,"surface":"蹇叔","kind":"person","person_id":"7du_pfa_2s5","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m032-0107","start":107,"end":110,"surface":"西乞術","kind":"person","person_id":"7du_pfa_2s5_A","status":"contextual_provisional"