考績行能，以知優劣，各有條貫。後諸葛壹僞叛以誘魏將諸葛誕，權潛軍待之。和以權暴露外次，又戰者凶事，常憂勞憯怛，不復會同飲食，數上諫，戒令持重，務在全勝，權還，然後敢安。張純字元基，敦之子。","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-059-he:line028-pei01-01:m0006","start":6,"end":7,"surface":"和","kind":"person","person_id":"572_278_cba_A","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line028-pei01-01:m0015","start":15,"end":16,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line028-pei01-01:m0071","start":71,"end":72,"surface":"穎","kind":"person","person_id":"tm1_ycv_sdm","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line028-pei01-01:m0079","start":79,"end":80,"surface":"和","kind":"person","person_id":"572_278_cba_A","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line028-pei01-01:m0121","start":121,"end":124,"surface":"諸葛壹","kind":"person","person_id":"i9d_r75_8wu","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line028-pei01-01:m0130","start":130,"end":133,"surface":"諸葛誕","kind":"person","person_id":"655_392_7f8","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line028-pei01-01:m0134","start":134,"end":135,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line028-pei01-01:m0140","start":140,"end":141,"surface":"和","kind":"person","person_id":"572_278_cba_A","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line028-pei01-01:m0142","start":142,"end":143,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line028-pei01-01: