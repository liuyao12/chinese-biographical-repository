{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"0a5_n96_42c","canonical_person_id":"0a5_n96_42c","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["0a5_n96_42c"],"persons":[{"id":"0a5_n96_42c","label":"呂后（龜策列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"呂后","mention_ids":["c-shiji-128-guice:m003-0193"]}],"evidence":[{"mention_id":"c-shiji-128-guice:m003-0193","chapter_id":"c-shiji-128-guice","paragraph_id":"c-shiji-128-guice:p003","quote":"呂后"}]}],"source_mention_summary":[{"source_id":"s-shiji128-guice","work_id":"w-shiji","book_id":"b-shiji-128","chapter_id":"c-shiji-128-guice","raw_mention_count":1,"mention_ids":["c-shiji-128-guice:m003-0193"],"paragraph_ids":["c-shiji-128-guice:p003"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-shiji-128-guice:m003-0193","mention_ids":["c-shiji-128-guice:m003-0193"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-shiji128-guice"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-128-guice:m003-0193","start":193,"end":195,"surface":"呂后","kind":"person","person_id":"0a5_n96_42c","status":"contextual_provisional","paragraph_id":"c-shiji-128-guice:p003","chapter_id":"c-shiji-128-guice"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-128-guice:p003","text":"略聞夏殷欲卜者，乃取蓍龜，已則棄去之，以為龜藏則不靈，蓍久則不神。至周室之卜官，常寶藏蓍龜；又其大小先後，各有所尚，要其歸等耳。或以為聖王遭事無不定，決疑無不見，其設稽神求問之道者，以為後世衰微，愚不師智，人各自安，化分為百室，道散而無垠，故推歸之至微，要絜於精神也。或以為昆蟲之所長，聖人不能與爭。其處吉凶，別然否，多中於人。至高祖時，因秦太卜官。天下始定，兵革未息。及孝惠享國日少，呂后女主，孝文、孝景因襲掌故，未遑講試，雖父子疇官，世世相傳，其精微深妙，多所遺失。至今上即位，博開藝能之路，悉延百端之學，通一伎之士咸得自效，絕倫超奇者為右，無所阿私，數年之閒，太卜大集。會上欲擊匈奴，西攘大宛，南收百越，卜筮至預見表象，先圖其利。及猛將推鋒執節，獲勝於彼，而蓍龜時日亦有力於此。上尤加意，賞賜至或數千萬。如丘子明之屬，富溢貴寵，傾於朝廷。至以卜筮射蠱道，巫蠱時或頗中。素有眥睚不快，因公行誅，恣意所傷，以破族滅門者，不可勝數。百僚蕩恐，皆曰龜策能言。后事覺姦窮，亦誅三族。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-128-guice:m003-0165","start":165,"end":167,"surface":"高祖","kind":"person","person_id":"9v9_kk6_129","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m003-0186","start":186,"end":188,"surface":"孝惠","kind":"person","person_id":"cfi_c9n_ffr","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m003-0193","start":193,"end":195,"surface":"呂后","kind":"person","person_id":"0a5_n96_42c","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m003-0198","start":198,"end":200,"surface":"孝文","kind":"person","person_id":"s24_ndq_z65","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m003-0201","start":201,"end":203,"surface":"孝景","kind":"person","person_id":"jud_r0o_x9c","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m003-0236","start":236,"end":238,"surface":"今上","kind":"person","person_id":"vti_9il_trm","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m003-0289","start":289,"end":290,"surface":"上","kind":"person","person_id":"vti_9il_trm","status":"contextual_provisional"},{"id":"c-shiji-128-guice