iji-049-waiqi:p040","quote":"武帝"},{"mention_id":"c-shiji-049-waiqi:m042-0015","chapter_id":"c-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p042","quote":"武帝"},{"mention_id":"c-shiji-049-waiqi:m042-0028","chapter_id":"c-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p042","quote":"武帝"},{"mention_id":"c-shiji-049-waiqi:m043-0026","chapter_id":"c-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p043","quote":"武帝"},{"mention_id":"c-shiji-049-waiqi:m044-0025","chapter_id":"c-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p044","quote":"武帝"},{"mention_id":"c-shiji-049-waiqi:m044-0216","chapter_id":"c-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p044","quote":"武帝"},{"mention_id":"c-shiji-049-waiqi:m022-0147","chapter_id":"c-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p022","quote":"其男"},{"mention_id":"c-shiji-049-waiqi:m023-0004","chapter_id":"c-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p023","quote":"太子"},{"mention_id":"c-shiji-049-waiqi:m018-0181","chapter_id":"c-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p018","quote":"男"}],"family_path":{"connection":"father","generation_distance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-049-waiqi","source_id":"s-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p022","quote":"長公主日譽王夫人男之美，景帝亦賢之，又有曩者所夢日符，計未有所定。王夫人知帝望栗姬，因怒未解，陰使人趣大臣立栗姬為皇后。大行奏事畢，曰：「『子以母貴，母以子貴』，今太子母無號，宜立為皇后。」景帝怒曰：「是而所宜言邪！」遂案誅大行，而廢太子為臨江王。栗姬愈恚恨，不得見，以憂死。卒立王夫人為皇后，其男為太子，封皇后兄信為蓋侯。","source_term":"其男為太子"}],"source_assertion_id":"a-shiji049-029","interpretation_note":"以此受傳正文的明示近親主張配置局部家族；不合併跨篇候選身份、不補闕名世代，不表示遠祖世系已核實。分支字元不是長幼排行。","reviewer":"Codex（AI 代理）","parent_person_id":"r7z_ane_tmt"},"id_aliases":["cbr-p003145"]},{"id":"r7z_ane_tmt_AA","label":"據（外戚世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"衛太子","mention_ids":["c-shiji-049-waiqi:m043-0000"]},{"surface":"據","mention_ids":["c-shiji-049-waiqi:m026-0262","c-shiji-049-waiqi:m029-0093"]}],"evidence":[{"mention_id":"c-shiji-049-waiqi:m043-0000","chapter_id":"c-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p043","quote":"衛太子"},{"mention_id":"c-shiji-049-waiqi:m026-0262","chapter_id":"c-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p026","quote":"據"},{"mention_id":"c-shiji-049-waiqi:m029-0093","chapter_id":"c-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p029","quote":"據"}],"family_path":{"connection":"father","generation_distance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-049-waiqi","source_id":"s-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p026","quote":"衛皇后字子夫，生微矣。蓋其家號曰衛氏，出平陽侯邑。子夫為平陽主謳者。武帝初即位，數歲無子。平陽主求諸良家子女十餘人，飾置家。武帝祓霸上還，因過平陽主。主見所侍美人。上弗說。既飲，謳者進，上望見，獨說衛子夫。是日，武帝起更衣，子夫侍尚衣軒中，得幸。上還坐，驩甚。賜平陽主金千斤。主因奏子夫奉送入宮。子夫上車，平陽主拊其背曰：「行矣，彊飯，勉之！即貴，無相忘。」入宮歲餘，竟不復幸。武帝擇宮人不中用者，斥出歸之。衛子夫得見，涕泣請出。上憐之，復幸，遂有身，尊寵日隆。召其兄衛長君弟青為侍中。而子夫後大幸，有寵，凡生三女一男。男名據。","source_term":"男名據"}],"source_assertion_id":"a-shiji049-033","interpretation_note":"以此受傳正文的明示近親主張配置局部家族；不合併跨篇候選身份、不補闕名世代，不表示遠祖世系已核實。分支字元不是長幼排行。","reviewer":"Codex（AI 代理）","parent_person_id":"r7z_ane_tmt_A"},"id_aliases":["cbr-p003109"]}],"source_mention_summary":[{"source_id":"s-shiji-049-waiqi","work_id":"w-shiji","book_id":"b-shiji-049","chapter_id":"c-shiji-049-waiqi","mention_count":3,"mention_ids":["c-shiji-049-waiqi:m026-0262","c-shiji-049-waiqi:m029-0093","c-shiji-049-waiqi:m043-0000"],"paragraph_ids":["c-shiji-049-waiqi:p026","c-shiji-049-waiqi:p029","c-shiji-049-waiqi:p043"],"passage_count":3}],"most_mentioned_source_ids":["s-shiji-049-waiqi"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji049-032","subject_person_id":"r7z_ane_tmt_AA","predicate":"mother","object_person_id":"l5c_h8i_d5q","status":"source_attested","evidence":[{"chapte