{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"pg6_38p_8ec","canonical_person_id":"pg6_38p_8ec","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["pg6_38p_8ec"],"persons":[{"id":"pg6_38p_8ec","label":"呂僧珍（裴邃所致書者）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"呂僧珍","mention_ids":["c-liangshu-028-peisui-complete:p005:m0070"]}],"evidence":[{"mention_id":"c-liangshu-028-peisui-complete:p005:m0070","paragraph_id":"c-liangshu-028-peisui-complete:p005","chapter_id":"c-liangshu-028-peisui-complete","quote":"呂僧珍"}],"review":"ai_provisional","identity_note":"呂僧珍（裴邃所致書者），見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-liangshu-028-peisui-complete-ws1511902","work_id":"w-liangshu","book_id":"b-liangshu-028","chapter_id":"c-liangshu-028-peisui-complete","raw_mention_count":1,"mention_ids":["c-liangshu-028-peisui-complete:p005:m0070"],"paragraph_ids":["c-liangshu-028-peisui-complete:p005"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-liangshu-028-peisui-complete:p005:m0070","mention_ids":["c-liangshu-028-peisui-complete:p005:m0070"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-liangshu-028-peisui-complete-ws1511902"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-liangshu-028-peisui-complete:p005:m0070","start":70,"end":73,"surface":"呂僧珍","kind":"person","person_id":"pg6_38p_8ec","status":"contextual_provisional","paragraph_id":"c-liangshu-028-peisui-complete:p005","chapter_id":"c-liangshu-028-peisui-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-028-peisui-complete:p005","text":"邃與鄉人共入魏武廟，因論帝王功業。其妻甥王篆之密啓高祖，云「裴邃多大言，有不臣之迹。」由是左遷爲始安太守。邃志欲立功邊陲，不願閑遠，乃致書於呂僧珍曰：「昔阮咸、顏延有『二始』之歎。吾才不逮古人，今爲三始，非其願也，將如之何！」未及至郡，會魏攻宿預，詔邃拒焉。行次直瀆，魏衆退。遷右軍諮議參軍、豫章王雲麾府司馬，率所領助守石頭。出爲竟陵太守，開置屯田，公私便之。遷爲遊擊將軍、朱衣直閤，直殿省。尋遷假節、明威將軍、西戎校尉、北梁、秦二州刺史。復開創屯田數千頃，倉廩盈實，省息邊運，民吏獲安，乃相率餉絹千餘匹。邃從容曰：「汝等不應爾；吾又不可逆。」納其絹二匹而已。還爲給事中、雲騎將軍、朱衣直閤將軍，遷大匠卿。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":20,"last_line":20,"raw_start":810,"raw_end":1113,"raw_character_offsets":[810,811,812,813,814,815,816,817,818,819,820,821,822,823,824,825,826,827,828,829,830,831,832,833,834,835,836,837,838,839,840,841,842,843,844,845,846,847,848,849,850,851,852,853,854,855,856,857,858,859,860,861,862,863,864,865,866,867,868,869,870,871,872,873,874,875,876,877,878,879,880,881,882,883,884,885,886,887,888,889,890,891,892,893,894,895,896,897,898,899,900,901,902,903,904,905,906,907,908,909,910,911,912,913,914,915,916,917,918,919,920,921,922,923,924,925,926,927,928,929,930,931,932,933,934,935,936,937,938,939,940,941,942,943,944,945,946,947,948,949,950,951,952,953,954,955,956,957,958,959,960,961,962,963,964,965,966,967,968,969,970,971,972,973,974,975,976,977,978,979,980,981,982,983,984,985,986,987,988,989,990,991,992,993,994,995,996,997,998,999,1000,1001,1002,1003,1004,1005,1006,1007,1008,1009,1010,1011