d":"9hw_mvo_jk8","status":"contextual_provisional","paragraph_id":"c-shiji-045-han:p013","chapter_id":"c-shiji-045-han"},{"id":"c-shiji-086-cike:m014-0014","start":14,"end":18,"surface":"韓相俠累","kind":"person","person_id":"9hw_mvo_jk8","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p014","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m014-0036","start":36,"end":38,"surface":"俠累","kind":"person","person_id":"9hw_mvo_jk8","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p014","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m015-0229","start":229,"end":233,"surface":"韓相俠累","kind":"person","person_id":"9hw_mvo_jk8","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p015","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m015-0234","start":234,"end":236,"surface":"俠累","kind":"person","person_id":"9hw_mvo_jk8","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p015","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m016-0005","start":5,"end":9,"surface":"韓相俠累","kind":"person","person_id":"9hw_mvo_jk8","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p016","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m016-0033","start":33,"end":35,"surface":"俠累","kind":"person","person_id":"9hw_mvo_jk8","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p016","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m017-0027","start":27,"end":29,"surface":"俠累","kind":"person","person_id":"9hw_mvo_jk8","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p017","chapter_id":"c-shiji-086-cike"}],"relations":[],"title_holdings":[{"id":"th-shiji045-007","person_id":"9hw_mvo_jk8","title":"韓相","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-045-han","source_id":"s-shiji-045-han","paragraph_id":"c-shiji-045-han:p013","quote":"列侯三年，聶政殺韓相俠累。九年，秦伐我宜陽，取六邑。十三年，列侯卒，子文侯立。是歳魏文侯卒。"}],"attestations":[{"id":"th-shiji045-007:a001","paragraph_id":"c-shiji-045-han:p013","start":8,"end":10,"surface":"韓相","person_mention_id":"c-shiji-045-han:m013-0010","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予、既有用稱與任事分開；三世、初見、被俘、出質或死亡不推全部官爵起訖，爭太子不記持有。未知曆日不換算。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji086-005","person_id":"9hw_mvo_jk8","title":"韓相","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-086-cike","source_id":"s-shiji-086-cike","paragraph_id":"c-shiji-086-cike:p014","quote":"久之，濮陽嚴仲子事韓哀侯，與韓相俠累有卻。嚴仲子恐誅，亡去，游求人可以報俠累者。至齊，齊人或言聶政勇敢士也，避仇隱於屠者之閒。嚴仲子至門請，數反，然後具酒自暢聶政母前。酒酣，嚴仲子奉黃金百溢，前爲聶政母壽。聶政驚怪其厚，固謝嚴仲子。嚴仲子固進，而聶政謝曰：「臣幸有老母，家貧，客游以爲狗屠，可以旦夕得甘毳以養親。親供養備，不敢當仲子之賜。」嚴仲子辟人，因爲聶政言曰：「臣有仇，而行游諸侯衆矣；然至齊，竊聞足下義甚髙，故進百金者，將用爲大人麤糲之費，得以交足下之驩，豈敢以有求望邪！」聶政曰：「臣所以降志辱身居市井屠者，徒幸以養老母；老母在，政身未敢以許人也。」嚴仲子固讓，聶政竟不肯受也。然嚴仲子卒備賓主之禮而去。"}],"attestations":[{"id":"th-shiji086-005:a001","paragraph_id":"c-shiji-086-cike:p014","start":14,"end":16,"surface":"韓相","person_mention_id":"c-shiji-086-cike:m014-0014","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"實際授任與文獻用稱分存；四月丙子依本段事件，不換算絕對年。皇帝其明年保留相對日期；上客為禮遇。懸賞金邑、職稱首見、死亡、被虜或亡逃不推定任期起訖。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji045-056","person_id":"9hw_mvo_jk8","surfaces":["俠累"],"scope":"same_chapter","chapter_ids":["c-shiji-045-han"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-045-han:p013","quote":"列侯三年，聶政殺韓相俠累。九年，秦伐我宜陽，取六邑。十三年，列侯卒，子文侯立。是歳魏文侯卒。"}],"rationale":"限本篇明示姓名、號稱、是為與連續敘事；兩位韓武子、韓趙簡子、韓魏文侯及不同時段未名楚王分開。原字及韓姬弒悼公、蟣蝨等疑點不訂正；裸王與回敘指代留待核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji086-026","person_id":"9hw_mvo_jk8","scope":"same_chapter","chapter_ids":["c-shiji-086-cike"],"status":"contextual_provisional","rationale":"依聶政事與政姊榮明示姊弟承接，母與榮夫保留未名；韓君與哀侯暫不全域合併。臣妾君等對話指代仍待逐處核定。","reviewer":"Codex（AI 代理）","surfaces":["俠累","韓相俠累"],"evidence":[{"paragraph_id":"c-shiji-086-cike:p014","quote":"久之，濮陽嚴仲子事韓哀侯，與韓相俠累有卻。嚴仲子恐誅，亡去，游求人可以報俠累者。至齊，齊人或言聶政勇敢士也，避仇隱於屠者之閒。嚴仲子至門請，數反，然後具酒自暢聶政母前。酒酣，嚴仲子奉黃金百溢，前爲聶政母壽。聶政驚怪其厚，固謝嚴仲子。嚴仲子固進，而聶政謝曰：「臣幸有老母，家貧，客游以爲狗屠，可以旦夕得甘毳以養親。親供養備，不敢當仲子之賜。」嚴仲子辟人，因爲聶政言曰：「臣有仇，而行游諸侯衆矣；然至齊，竊聞足下義甚髙，故進百金者，將用爲大人麤糲之費，得以交足下之驩，豈敢以有求望邪！」聶政曰：「臣所以降志辱身居市井屠者，徒幸以養老母；老母在，政身未敢以許人也。」嚴仲子固讓，聶政竟不肯受也。然嚴仲子卒備賓主之禮而去。"},{"paragraph_id":"c-shiji-086-cike:p015","quote":"久之，聶政母死。既已葬，除服，聶政曰：「嗟乎！政乃市井之人，鼓刀以屠；而嚴仲子乃諸侯之卿相也，不遠千里，枉車騎而交臣。臣之所以待之，至淺鮮矣，未有大功可以稱者，而嚴仲子奉百金爲親壽，我雖不受，然是者徒深知政也。夫賢者以感忿睚眞諼而親信窮僻之人，而政獨安得嘿然而已乎！且前日要政，政徒以老母；老母今以天年終，政將爲知己者用。」乃遂西至濮陽，見嚴仲子曰：「前日所以不許仲子者，徒以親在；今不幸而母以天年終。仲子所欲報仇者爲誰？請得從事焉！」嚴仲子具告曰：「臣之仇韓相俠累，俠累又韓君之季父也，宗族盛多，居處兵衞甚設，臣欲使人刺之，（衆）終莫能就。今足下幸而不棄，請益其車騎壯士可爲足下輔翼者。」聶政曰：「韓之與衞，相去中閒不甚遠，今殺人之相，相又國君之親，此其勢不可以多人，多人不能無生得失，生得失則語泄，語泄是韓舉國而與仲子爲讎，豈不殆哉！」遂謝車騎人徒，聶政乃辭獨行。"},{"paragraph_id":"c-shiji-086-cike:p016","quote":"杖劍至韓，韓相俠累方坐府上，持兵戟而衞侍者甚衆。聶政直入，上階刺殺俠累，左右大亂。聶政大呼，所撃殺者數十人，因自皮面決眼，自屠出腸，遂以死。"},{"paragraph_id":"c-shiji-086-cike:p017","quote":"韓取聶政尸暴於市，購問莫知誰子。於是韓縣之，有能言殺相俠累者予千金。久之莫知也。"}]}],"equivalence_decisions":[{"id":"eq-shiji086-xia","person_ids":["9hw_mvo_jk8"],"canonical_person_id":"9hw_mvo_jk8","scope":"cross_chapter","chapter_ids":["c-shiji-086-cike","c-shiji-045-han"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-086-cike","source_id":"s-shiji-086-cike","paragraph_id":"c-shiji-086-cike:p016","quote":"杖劍至韓，韓相俠累方坐府上，持兵戟而衞侍者甚衆。聶政直入，上階刺殺俠累，左右大亂。聶政大呼，所撃殺者數十人，因自皮面決眼，自屠出腸，遂以死。","mention_ids":["c-shiji-086-cike:m016-0005","c-shiji-086-cike:m016-0033"]},{"chapter_id":"c-shiji-045-han","source_id":"s-shiji-045-han","paragraph_id":"c-shiji-045-han:p013","quote":"列侯三年，聶政殺韓相俠累。九年，秦伐我宜陽，取六邑。十三年，列侯卒，子文侯立。是歳魏文侯卒。","mention_ids":["c-shiji-045-han:m013-0010"]}],"rationale":"遭聶政刺殺的韓相俠累，具相同加害者與事件；兩篇君主紀年矛盾不抹除。各篇原字、原語與異說分存，同書互見不是獨立史實見證；不跨其他候選批量合併。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true}],"passages":[{"id":"c-shiji-045-han:p013","text":"列侯三年，聶政殺韓相俠累。九年，秦伐我宜陽，取六邑。十三年，列侯卒，子文侯立。是歳魏文侯卒。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-045-han:m013-0000","start":0,"end":2,"surface":"列侯","kind":"person","person_id":"y3i_rsz_brn_AAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-045-han:m013-0005","start":5,"end":7,"surface":"聶政","kind":"person","person_id":"ri4_ypz_y8z","status":"contextual_provisional"},{"id":"c-shiji-045-han:m013-0010","start":10,"end":12,"surface":"俠累","kind":"person","person_id":"9hw_mvo_jk8","status":"contextual_provisional"},{"id":"c-shiji-045-han:m013-0030","start":30,"end":32,"surface":"列侯","kind":"person","person_id":"y3i_rsz_brn_AAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-045-han:m013-0035","start":35,"end":37,"surface":"文侯","kind":"person","person_id":"y3i_rsz_brn_AAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-045-han:m013-0041","start":41,"end":44,"surface":"魏文侯","kind":"person","person_id":"lb9_zwn_ril","status":"contextual_provisional"}],"chapter_id":"c-shiji-045-han","book_id":"b-shiji-045","work_id":"w-shiji","source_id":"s-shiji-045-han"},{"id":"c-shiji-086-cike:p014","text":"久之，濮陽嚴仲子事韓哀侯，與韓相俠累有卻。嚴仲子恐誅，亡去，游求人可以報俠累者。至齊，齊人或言聶政勇敢士也，避仇隱於屠者之閒。嚴仲子至門請，數反，然後具酒自暢聶政母前。酒酣，嚴仲子奉黃金百溢，前爲聶政母壽。聶政驚怪其厚，固謝嚴仲子。嚴仲子固進，而聶政謝曰：「臣幸有老母，家貧，客游以爲狗屠，可以旦夕得甘毳以養親。親供養備，不敢當仲子之賜。」嚴仲子辟人，因爲聶政言曰：「臣有仇，而行游諸侯衆矣；然至齊，竊聞足下義甚髙，故進百金者，將用爲大人麤糲之費，得以交足下之驩，豈敢以有求望邪！」聶政曰：「臣所以降志辱身居市井屠者，徒幸以養老母；老母在，政身未敢以許人也。」嚴仲子固讓，聶政竟不肯受也。然嚴仲子卒備賓主之禮而去。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-086-cike:m014-0003","start":3,"end":8,"surface":"濮陽嚴仲子","kind":"person","person_id":"acr_zxn_ca3","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m014-0009","start":9,"end":12,"surface":"韓哀侯","kind