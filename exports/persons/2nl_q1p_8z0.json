"end":77,"surface":"樓緩","kind":"person","person_id":"p41_n3z_dlq","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m003-0081","start":81,"end":82,"surface":"公","kind":"person","person_id":"p41_n3z_dlq","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m003-0087","start":87,"end":89,"surface":"秦王","kind":"person","person_id":"ao3_0fy_d45","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m003-0093","start":93,"end":95,"surface":"魏冉","kind":"person","person_id":"r2f_mtq_05s","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m003-0102","start":102,"end":103,"surface":"公","kind":"person","person_id":"9zv_c2c_v3b","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m003-0104","start":104,"end":105,"surface":"公","kind":"person","person_id":"9zv_c2c_v3b","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m003-0113","start":113,"end":115,"surface":"樓子","kind":"person","person_id":"p41_n3z_dlq","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m003-0119","start":119,"end":121,"surface":"魏冉","kind":"person","person_id":"r2f_mtq_05s","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m003-0123","start":123,"end":124,"surface":"公","kind":"person","person_id":"9zv_c2c_v3b","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m003-0129","start":129,"end":131,"surface":"仇液","kind":"person","person_id":"9zv_c2c_v3b","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m003-0138","start":138,"end":140,"surface":"樓緩","kind":"person","person_id":"p41_n3z_dlq","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m003-0141","start":141,"end":143,"surface":"魏冉","kind":"person","person_id":"r2f_mtq_05s","status":"contextual_provisional"}],"chapter_id":"c-shiji-072-rang","book_id":"b-shiji-072","work_id":"w-shiji","source_id":"s-shiji-072-rang"},{"id":"c-shiji-076-pingyu:p014","text":"趙王計未定，樓緩從秦來，趙王與樓緩計之，曰：「予秦地何如毋予，孰吉？」緩辭讓曰：「此非臣之所能知也。」王曰：「雖然，試言公之私。」樓緩對曰：「王亦聞夫公甫文伯母乎？公甫文伯仕於魯，病死，女子爲自殺於房中者二人。其母聞之，弗哭也。其相室曰：『焉有子死而弗哭者乎？』其母曰：『孔子，賢人也，逐於魯，而是人不隨也。今死而婦人爲之自殺者二人，若是者必其於長者薄而於婦人厚也。』故從母言之，是爲賢母；從妻言之，是必不免爲妒妻。故其言一也，言者異則人心變矣。今臣新從秦來而言勿予，則非計也；言予之，恐王以臣爲爲秦也：故不敢對。使臣得爲大王計，不如予之。」王曰：「諾。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-076-pingyu:m014-0000","start":0,"end":2,"surface":"趙王","kind":"person","person_id":"q6w_qm5_w2b","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m014-0006","start":6,"end":8,"surface":"樓緩","kind":"person","person_id":"p41_n3z_dlq","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m014-0012","start":12,"end":14,"surface":"趙王","kind":"person","person_id":"q6w_qm5_w2b","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m014-0015","start":15,"end":17,"surface":"樓緩","kind":"person","person_id":"p41_n3z_dlq","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m014-0035","start":35,"end":36,"surface":"緩","kind":"person","person_id":"p41_n3z_dlq","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m014-0051","start":51,"end":52,"surface":"王","kind":"person","person_id":"q6w_qm5_w2b","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m014-0060","start":60,"end":61,"surface":"公","kind":"person","person_id":"p41_n3z_dlq","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m014-0065","start":65,"end":67,"surface":"樓緩","kind":"person","person_id":"p41_n3z_dlq","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m014-0071","start":71,"end":72,"surface":"王","kind":"person","person_id":"q6w_qm5_w2b","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m014-0075","start":75,"end":80,"surface":"公甫文伯母","kind":"person","person_id":"as3_a3z_9jx","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m014-0082","start":82,"end":86,"surface":"公甫文伯","kind":"person","person_id":"lue_xus_em2","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m014-0093","start":93,"end":95,"surface":"女子","kind":"unresolved","person_id":null,"sta