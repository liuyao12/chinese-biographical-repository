n_id":"yqp_nlb_p1p_AFA","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m020-0320","start":320,"end":322,"surface":"伍被","kind":"person","person_id":"h6u_yzh_mdx","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m020-0331","start":331,"end":333,"surface":"伍被","kind":"person","person_id":"h6u_yzh_mdx","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m020-0347","start":347,"end":349,"surface":"伍被","kind":"person","person_id":"h6u_yzh_mdx","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m020-0362","start":362,"end":363,"surface":"被","kind":"person","person_id":"h6u_yzh_mdx","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m020-0366","start":366,"end":367,"surface":"被","kind":"person","person_id":"h6u_yzh_mdx","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m020-0494","start":494,"end":495,"surface":"被","kind":"person","person_id":"h6u_yzh_mdx","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m020-0502","start":502,"end":503,"surface":"被","kind":"person","person_id":"h6u_yzh_mdx","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m020-0515","start":515,"end":518,"surface":"大將軍","kind":"person","person_id":"5dd_l1c_6g8","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m020-0527","start":527,"end":530,"surface":"大將軍","kind":"person","person_id":"5dd_l1c_6g8","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m020-0536","start":536,"end":537,"surface":"被","kind":"person","person_id":"h6u_yzh_mdx","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m020-0540","start":540,"end":541,"surface":"被","kind":"person","person_id":"h6u_yzh_mdx","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m020-0544","start":544,"end":546,"surface":"黃義","kind":"person","person_id":"lmb_f5y_bg8","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m020-0548","start":548,"end":551,"surface":"大將軍","kind":"person","person_id":"5dd_l1c_6g8","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m020-0558","start":558,"end":559,"surface":"被","kind":"person","person_id":"h6u_yzh_mdx","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m020-0562","start":562,"end":565,"surface":"大將軍","kind":"person","person_id":"5dd_l1c_6g8","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m020-0566","start":566,"end":569,"surface":"士大夫","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-118-huainan:m020-0573","start":573,"end":575,"surface":"士卒","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-118-huainan:m020-0598","start":598,"end":599,"surface":"被","kind":"person","person_id":"h6u_yzh_mdx","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m020-0619","start":619,"end":621,"surface":"曹梁","kind":"person","person_id":"l05_byq_v7h","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m020-0627","start":627,"end":630,"surface":"大將軍","kind":"person","person_id":"5dd_l1c_6g8","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m020-0641","start":641,"end":643,"surface":"士卒","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-118-huainan:m020-0654","start":654,"end":656,"surface":"士卒","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-118-huainan:m020-0676","start":676,"end":679,"surface":"皇太后","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-118-huainan:m020-0687","start":687,"end":689,"surface":"軍吏","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-118-huainan","book_id":"b-shiji-118","work_id":"w-shiji","source_id":"s-shiji118-huainan"},{"id":"c-shiji-118-huainan:p021","text":"淮南王見建已徵治，恐國陰事且覺，欲發，被又以為難，乃復問被曰：「公以為吳興兵是邪非也？」被曰：「以為非也。吳王至富貴也，舉事不當，身死丹徒，頭足異處，子孫無遺類。臣聞吳王悔之甚。願王孰慮之，無為吳王之所悔。」王曰：「男子之所死者一言耳。且吳何知反，漢將一日過成皋者四十餘人。今我令樓緩先要成皋之口，周被下潁川兵塞轘轅、伊闕之道，陳定發南陽兵守武關。河南太守獨有雒陽耳，何足憂。然此北尚有臨晉關、河東、上黨與河內、趙國。人言曰『絕成皋之口，天下不通』。據三川之險，招山東之兵，舉事如此，公以為何如？」被曰：「臣見其禍，未見其福也。」王曰：「左吳、趙賢、朱驕如皆以為有福，什事九成，公獨以為有禍無福，何也？」被曰：「大王之群臣近幸素能使眾者，皆前繋詔獄，餘無可用者。」王曰：「陳勝、吳廣無立錐之地，千人之聚，起於大澤，奮臂大呼而天下響應，西至於戲而兵百二十萬。今吾國雖小，然而勝兵者可得十餘萬，非直適戍之眾，釠鑿棘矜也，公何以言有禍無福？」被曰：「往者秦為無道，殘賊天下。興萬乘之駕，作阿房之宮，收太半之賦，發閭左之戍，父不寧子，兄不便弟，政苛刑峻，天下熬然若焦，民皆引領而望，傾耳而聽，悲號仰天，叩心而怨上，故陳勝大呼，天下響應。當今陛下臨制天下，一齊海內，汎愛蒸庶，布德施惠。口雖未言，聲疾雷霆，令雖未出，化馳如神，心有所懷，威動萬里，下之應上，猶影響也。而大將軍材能不特章邯、楊熊也。大王以陳勝、吳廣諭之，被以為過矣。」王曰：「茍如公言，不可徼幸邪？」被曰：「被有愚計。」王曰：「柰何？」被曰：「當今諸侯無異心，百姓無怨氣。朔方之郡田地廣，水草美，民徙者不足以實其地。臣之愚計，可偽為丞相御史請書，徙郡國豪桀任俠及有耐罪以上，赦令除其罪，產五十萬以上者，皆徙其家屬朔方之郡，益發甲卒，急其會日。又偽為左右都司空上林中都官詔獄（逮）書，［逮］諸侯太子幸臣。如此則民怨，諸侯懼，即使辯武隨而說之，儻可徼幸什得一乎？」王曰：「此可也。雖然，吾以為不至若此。」於是王乃令官奴入宮，作皇帝璽，丞相、御史、大將軍、軍吏、中二千石、都官令、丞印，及旁近郡太守、都尉印，漢使節法冠，欲如伍被計。使人偽得罪而西，事大將軍、丞相；一日發兵，使人即刺殺大將軍青，而說丞相下之，如發蒙耳。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-118-huainan:m021-0000","start":0,"end":3,"surface":"淮南王","kind":"person","person_id":"yqp_nlb_p1p_AFA","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m021-0004","start":4,"end":5,"surface":"建","kind":"person","person_id":"yqp_nlb_p1p_AFABA","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m021-0019","start":19,"end":20,"surface":"被","kind":"person","person_id":"h6u_yzh_mdx","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m021-0028","start":28,"end":29,"surface":"被","kind":"person","person_id":"h6u_yzh_mdx","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m021-0044","start":44,"end":45,"surface":"被","kind":"person","person_id":"h6u_yzh_mdx","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m021-0053","start":53,"end":55,"surface":"吳王","kind":"person","person_id":"yqp_nlb_p1p_CA","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m021-0083","start":83,"end":85,"surface":"吳王","kind":"person","person_id":"yqp_nlb_p1p_CA","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m021-0097","start":97,"end":99,"surface":"吳王","kind":"person","person_id":"yqp_nlb_p1p_CA","status":"contextual_provisional"},{"id":"c-shiji-1