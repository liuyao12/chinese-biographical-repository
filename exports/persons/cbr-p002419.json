{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p002419","identity_policy":"contextual_provisional","person_ids":["cbr-p002419"],"persons":[{"id":"cbr-p002419","label":"趙袑（趙世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"趙袑","mention_ids":["c-shiji-043-zhao:m073-0009"]}],"evidence":[{"mention_id":"c-shiji-043-zhao:m073-0009","chapter_id":"c-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p073","quote":"趙袑"}]}],"source_mention_summary":[{"source_id":"s-shiji-043-zhao","work_id":"w-shiji","book_id":"b-shiji-043","chapter_id":"c-shiji-043-zhao","mention_count":1,"mention_ids":["c-shiji-043-zhao:m073-0009"],"paragraph_ids":["c-shiji-043-zhao:p073"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-043-zhao"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-043-zhao:m073-0009","start":9,"end":11,"surface":"趙袑","kind":"person","person_id":"cbr-p002419","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p073","chapter_id":"c-shiji-043-zhao"}],"relations":[],"title_holdings":[{"id":"th-shiji043-051","person_id":"cbr-p002419","title":"右軍","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-043-zhao","source_id":"s-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p073","quote":"二十一年，攻中山。趙袑爲右軍，許鈞爲左軍，公子章爲中軍，王并將之。牛翦將車騎，趙希并將胡、代。趙與之陘，合軍曲陽，攻取丹丘、華陽、鴟之塞。王軍取鄗、石邑、封龍、東垣。中山獻四邑和，王許之，罷兵。二十三年，攻中山。二十五年，惠后卒。使周袑胡服傅王子何。二十六年，復攻中山，攘地北至燕、代，西至雲中、九原。"}],"attestations":[{"id":"th-shiji043-051:a001","paragraph_id":"c-shiji-043-zhao:p073","start":12,"end":14,"surface":"右軍","person_mention_id":"c-shiji-043-zhao:m073-0009","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"明示授予、自號及廢太子與敘事用稱分開；分趙而王章的未決計畫不是授予。死亡與傳國不推所有官爵終點，回敘太子不補曆日。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji043-190","person_id":"cbr-p002419","surfaces":["趙袑"],"scope":"same_chapter","chapter_ids":["c-shiji-043-zhao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-043-zhao:p073","quote":"二十一年，攻中山。趙袑爲右軍，許鈞爲左軍，公子章爲中軍，王并將之。牛翦將車騎，趙希并將胡、代。趙與之陘，合軍曲陽，攻取丹丘、華陽、鴟之塞。王軍取鄗、石邑、封龍、東垣。中山獻四邑和，王許之，罷兵。二十三年，攻中山。二十五年，惠后卒。使周袑胡服傅王子何。二十六年，復攻中山，攘地北至燕、代，西至雲中、九原。"}],"rationale":"限本篇人物、連續政治事件及明示生子是為敘事；武靈王／主父、王子何／惠文王及惠后吳娃按本文連接。公子章不與早期敬侯章合併，何不與較早趙何合併；髙信與信期、趙袑與周袑分候選。王賁不按熟知秦將同名接人。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-043-zhao:p073","text":"二十一年，攻中山。趙袑爲右軍，許鈞爲左軍，公子章爲中軍，王并將之。牛翦將車騎，趙希并將胡、代。趙與之陘，合軍曲陽，攻取丹丘、華陽、鴟之塞。王軍取鄗、石邑、封龍、東垣。中山獻四邑和，王許之，罷兵。二十三年，攻中山。二十五年，惠后卒。使周袑胡服傅王子何。二十六年，復攻中山，攘地北至燕、代，西至雲中、九原。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-043-zhao:m073-0006","start":6,"end":8,"surface":"中山","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、代詞、未名君主或版本疑字保留；不把帝王泛稱、父子群體與未決分封當已確證身份或任期。"},{"id":"c-shiji-043-zhao:m073-0009","start":9,"end":11,"surface":"趙袑","kind":"person","person_id":"cbr-p002419","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m073-0012","start":12,"end":14,"surface":"右軍","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、代詞、未名君主或版本疑字保留；不把帝王泛稱、父子群體與未決分封當已確證身份或任期。"},{"id":"c-shiji-043-zhao:m073-0015","start":15,"end":17,"surface":"許鈞","kind":"person","person_id":"cbr-p002420","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m073-0018","start":18,"end":20,"surface":"左軍","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、代詞、未名君主或版本疑字保留；不把帝王泛稱、父子群體與未決分封當已確證身份或任期。"},{"id":"c-shiji-043-zhao:m073-0021","start":21,"end":24,"surface":"公子章","kind":"person","person_id":"cbr-p002421","