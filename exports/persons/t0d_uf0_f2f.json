d":"c-shiji-121-rulin:m003-0055","start":55,"end":56,"surface":"涉","kind":"person","person_id":"x99_byd_sfy","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m003-0059","start":59,"end":61,"surface":"陳涉","kind":"person","person_id":"x99_byd_sfy","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m003-0093","start":93,"end":99,"surface":"縉紳先生之徒","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m003-0100","start":100,"end":102,"surface":"孔子","kind":"person","person_id":"t0d_uf0_f2f","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m003-0126","start":126,"end":128,"surface":"陳王","kind":"person","person_id":"x99_byd_sfy","status":"contextual_provisional"}],"chapter_id":"c-shiji-121-rulin","book_id":"b-shiji-121","work_id":"w-shiji","source_id":"s-shiji121-rulin"},{"id":"c-shiji-121-rulin:p004","text":"及高皇帝誅項籍，舉兵圍魯，魯中諸儒尚講誦習禮樂，弦歌之音不絕，豈非聖人之遺化，好禮樂之國哉？故孔子在陳曰：「歸與！歸與！吾黨之小子狂簡，斐然成章，不知所以裁之。」夫齊魯之閒於文學，自古以來，其天性也。故漢興，然後諸儒始得修其經藝，講習大射鄉飲之禮。叔孫通作漢禮儀，因為太常，諸生弟子共定者，咸為選首，於是喟然嘆興於學。然尚有干戈，平定四海，亦未暇遑庠序之事也。孝惠、呂后時，公卿皆武力有功之臣。孝文時頗徵用，然孝文帝本好刑名之言。及至孝景，不任儒者，而竇太后又好黃老之術，故諸博士具官待問，未有進者。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m004-0001","start":1,"end":4,"surface":"高皇帝","kind":"person","person_id":"x85_w53_dyq","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m004-0005","start":5,"end":7,"surface":"項籍","kind":"person","person_id":"mtg_mtp_8oz","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m004-0013","start":13,"end":17,"surface":"魯中諸儒","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m004-0033","start":33,"end":35,"surface":"聖人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m004-0047","start":47,"end":49,"surface":"孔子","kind":"person","person_id":"t0d_uf0_f2f","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m004-0124","start":124,"end":127,"surface":"叔孫通","kind":"person"