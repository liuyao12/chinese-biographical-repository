正，雅頌各得其所。世以混濁莫能用，是以仲尼干七十餘君無所遇，曰「茍有用我者，期月而已矣」。西狩獲麟，曰「吾道窮矣」。故因史記作春秋，以當王法，其辭微而指博，後世學者多錄焉。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m001-0000","start":0,"end":3,"surface":"太史公","kind":"person","person_id":"tvk_3qo_6n5","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m001-0042","start":42,"end":43,"surface":"幽","kind":"person","person_id":"f94_8tp_fuq","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m001-0043","start":43,"end":44,"surface":"厲","kind":"person","person_id":"zjb_ebl_vjy","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m001-0061","start":61,"end":63,"surface":"孔子","kind":"person","person_id":"t0d_uf0_f2f","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m001-0123","start":123,"end":125,"surface":"仲尼","kind":"person","person_id":"t0d_uf0_f2f","status":"contextual_provisional"}],"chapter_id":"c-shiji-121-rulin","book_id":"b-shiji-121","work_id":"w-shiji","source_id":"s-shiji121-rulin"},{"id":"c-shiji-121-rulin:p002","text":"自孔子卒後，七十子之徒散游諸侯，大者為師傅卿相，小者友教士大夫，或隱而不見。故子路居衛，子張居陳，澹臺子羽居楚，子夏居西河，子貢終於齊。如田子方、段干木、吳起、禽滑釐之屬，皆受業於子夏之倫，為王者師。是時獨魏文侯好學。后陵遲以至于始皇，天下并爭於戰國，懦術既絀焉，然齊魯之閒，學者獨不廢也。於威、宣之際，孟子、荀卿之列，咸遵夫子之業而潤色之，以學顯於當世。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m002-0001","start":1,"end":3,"surface":"孔子","kind":"person","person_id":"t0d_uf0_f2f","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m002-0006","start":6,"end":11,"surface":"七十子之徒","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m002-0013","start":13,"end":15,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m002-0028","start":28,"end":31,"surface":"士大夫","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m002-0039","start":39,"end":41,"surface":"子路","kind":"person","person_id":"wkl_tds_yi3","status":"contextual_provisional"