nd":"person","person_id":"t0d_uf0_f2f","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m017-0046","start":46,"end":49,"surface":"高堂生","kind":"person","person_id":"5sy_nhd_r99","status":"contextual_provisional"}],"chapter_id":"c-shiji-121-rulin","book_id":"b-shiji-121","work_id":"w-shiji","source_id":"s-shiji121-rulin"},{"id":"c-shiji-121-rulin:p019","text":"自魯商瞿受易孔子，孔子卒，商瞿傳易，六世至齊人田何，字子莊，而漢興。田何傳東武人王同子仲，子仲傳菑川人楊何。何以易，元光元年徵，官至中大夫。齊人即墨成以易至城陽相。廣川人孟但以易為太子門大夫。魯人周霸，莒人衡胡，臨菑人主父偃，皆以易至二千石。然要言易者本於楊何之家。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m019-0002","start":2,"end":4,"surface":"商瞿","kind":"person","person_id":"h6b_wgh_gr9","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m019-0006","start":6,"end":8,"surface":"孔子","kind":"person","person_id":"t0d_uf0_f2f","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m019-0009","start":9,"end":11,"surface":"孔子","kind":"person","person_id":"t0d_uf0_f2f","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m019-0013","start":13,"end":15,"surface":"商瞿","kind":"person","person_id":"h6b_wgh_gr9","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m019-0023","start":23,"end":25,"surface":"田何","kind":"person","person_id":"aly_3ph_2la","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m019-0027","start":27,"end":29,"surface":"子莊","kind":"person","person_id":"aly_3ph_2la","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m019-0034","start":34,"end":36,"surface":"田何","kind":"person","person_id":"aly_3ph_2la","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m019-0040","start":40,"end":42,"surface":"王同","kind":"person","person_id":"yuy_gbn_g7e","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m019-0042","start":42,"end":44,"surface":"子仲","kind":"person","person_id":"yuy_gbn_g7e","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m019-0045","start":45,"end":47,"surface":"子仲","kind":"person","