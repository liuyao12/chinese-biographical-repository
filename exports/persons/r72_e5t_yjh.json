may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-072-guopu:p028:m0004","surface":"任穀","start":4,"end":6,"person_id":"r72_e5t_yjh","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-072-guopu:p028","chapter_id":"c-jinshu-072-guopu"},{"id":"c-jinshu-072-guopu:p028:m0061","surface":"谷","start":61,"end":62,"person_id":"r72_e5t_yjh","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-072-guopu:p028","chapter_id":"c-jinshu-072-guopu"},{"id":"c-jinshu-072-guopu:p028:m0081","surface":"谷","start":81,"end":82,"person_id":"r72_e5t_yjh","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-072-guopu:p028","chapter_id":"c-jinshu-072-guopu"},{"id":"c-jinshu-072-guopu:p028:m0093","surface":"任穀","start":93,"end":95,"person_id":"r72_e5t_yjh","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-072-guopu:p028","chapter_id":"c-jinshu-072-guopu"},{"id":"c-jinshu-072-guopu:p028:m0359","surface":"穀","start":359,"end":360,"person_id":"r72_e5t_yjh","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-072-guopu:p028","chapter_id":"c-jinshu-072-guopu"},{"id":"c-jinshu-072-guopu:p028:m0389","surface":"穀","start":389,"end":390,"person_id":"r72_e5t_yjh","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-072-guopu:p028","chapter_id":"c-jinshu-072-guopu"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-072-guopu:p028","text":"時暨陽人任穀因耕息於樹下，忽有一人著羽衣就淫之，既而不知所在，穀遂有娠。積月將產，羽衣人復來，以刀穿其陰下，出一蛇子便去。谷遂成宦者。後詣闕上書，自雲有道術。帝留谷于宮中。璞復上疏曰：「任穀所為妖異，無有因由。陛下玄鑒廣覽，欲知其情狀，引之禁內，供給安處。臣聞為國以禮正，不聞以奇邪。所聽惟人，故神降之吉。陛下簡默居正，動遵典刑。案《周禮》，奇服怪人不入宮，況穀妖詭怪人之甚者，而登講肆之堂，密邇殿省之側，塵點日月，穢亂天聽，臣之私情竊所以不取也。陛下若以谷信為神靈所憑者，則應敬而遠之。夫神，聰明正直，接以人事。若以穀為妖蠱詐妄者，則當投畀裔土，不宜令褻近紫闈。若以穀或是神祇告譴、為國作眚者，則當克己修禮以弭其妖，不宜令谷安然自容，肆其邪變也。臣愚以為陰陽陶烝，變化萬端，亦是狐狸魍魎憑假作慝。願陛下采臣愚懷，特遣穀出。臣以人乏，忝荷史任，敢忘直筆，惟義是規。」其後元帝崩，穀因亡走。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":64,"last_line":64,"raw_start":4904,"raw_end":5302,"raw_character_offsets":[4904,4905,4906,4907,4908,4909,4910,4911,4912,4913,4914,4915,4916,4917,4918,4919,4920,4921,4922,4923,4924,4925,4926,4927,4928,4929,4930,4931,4932,4933,4934,4935,4936,4937,4938,4939,4940,4941,4942,4943,4944,4945,4946,4947,4948,4949,4950,4951,4952,4953,4954,4955,4956,4957,4958,4959,4960,4961,4962,4963,4964,4965,4966,4967,4968,4969,4970,4971,4972,4973,4974,4975,4976,4977,4978,4979,4980,4981,4982,4983,4984,4985,4986,4987,4988,4989,4990,4991,4992,4993,4994,4995,4996,4997,4998,4999,5000,5001,5002,5003,5004,5005,5006,5007,5008,5009,5010,5011,5012,5013,5014,5015,5016,5017,5018,5019,5020,5021,5022,5023,5024,5025,5026,5027,5028,5029,5030,5031,5032,5033,5034,5035,5036,5037,5038,5039,5040,5041,5042,5043,5044,5045,5046,5047,5048,5049,5050,5051,5052,5053,5054,5055,5056,5057,5058,5059,5060,5061,5062,5063,5064,5065,5066,5067,5068,5069,5070,5073,5074,5077,5078,5079,5080,5081,5082,5083,5084,5085,5086,5087,5088,5089,5090,5091,5092,5093,5094,5095,5096,5097,5098,5099,5100,5101,5102,5103,5104,5105,5106,5107,5108,5109,5110,5111,5112,5113,5114,5115,5116,5117,5118,5119,5120,5121,5122,5123,5124,5125,5126,5127,5128,5129,5130,5131,5132,5133,5134,5135,5136,5137,5138,5139,5140,5141,5142,5143,5144,5145,5146,5147,5148,5149,5150,5151,5152,5153,5154,5155,5156,5157,5158,5159,5160,5161,5162,5163,5164,5165,5166,5167,5168,5169,5170,5171,5172,5173,5174,5175,5176,5177,5178,5179,5180,5181,5182,5183,5184,5185,5186,5187,5188,5189,5190,5191,5192,5193,5194,5195,5196,5197,5198,5199,5200,5201,5202,5203,5204,5205,5206,5207,5208,5209,5210,5211,5212,5213,5214,5215,5216,5217,5218,5219,5220,5221,5222,5223,5224,5225,5226,5227,5228,5229,5230,5231,5232,5233,5234,5235,5236,5237,5238,5239,5240,5241,5242,5243,5244,5245,5246,5247,5248,5249,5250,5251,5252,5253,5