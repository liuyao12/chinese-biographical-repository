{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"0wy_1jp_os3","canonical_person_id":"0wy_1jp_os3","id_aliases":["cbr-p003628"],"identity_policy":"contextual_provisional","person_ids":["0wy_1jp_os3"],"persons":[{"id":"0wy_1jp_os3","label":"大行騫（五宗世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"大行騫","mention_ids":["c-shiji-059-wuzong:m033-0253"]}],"evidence":[{"mention_id":"c-shiji-059-wuzong:m033-0253","chapter_id":"c-shiji-059-wuzong","paragraph_id":"c-shiji-059-wuzong:p033","quote":"大行騫"}],"id_aliases":["cbr-p003628"]}],"source_mention_summary":[{"source_id":"s-shiji-059-wuzong","work_id":"w-shiji","book_id":"b-shiji-059","chapter_id":"c-shiji-059-wuzong","mention_count":1,"mention_ids":["c-shiji-059-wuzong:m033-0253"],"paragraph_ids":["c-shiji-059-wuzong:p033"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-059-wuzong"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-059-wuzong:m033-0253","start":253,"end":256,"surface":"大行騫","kind":"person","person_id":"0wy_1jp_os3","status":"contextual_provisional","paragraph_id":"c-shiji-059-wuzong:p033","chapter_id":"c-shiji-059-wuzong"}],"relations":[],"title_holdings":[{"id":"th-shiji059-059","person_id":"0wy_1jp_os3","title":"大行","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-059-wuzong","source_id":"s-shiji-059-wuzong","paragraph_id":"c-shiji-059-wuzong:p033","quote":"初，憲王舜有所不愛姬生長男棁。棁以母無寵故，亦不得幸於王。王後修生太子勃。王內多，所幸姬生子平、子商，王后希得幸。及憲王病甚，諸幸姬常侍病，故王后亦以妒媢不常侍病，輒歸舍。醫進藥，太子勃不自嘗藥，又不宿留侍病。及王薨，王后、太子乃至。憲王雅不以長子棁為人數，及薨，又不分與財物。郎或說太子、王后，令諸子與長子棁共分財物，太子、王后不聽。太子代立，又不收恤棁。棁怨王后、太子。漢使者視憲王喪，棁自言憲王病時，王后、太子不侍，及薨，六日出舍，太子勃私姦，飲酒，博戲，擊筑，與女子載馳，環城過市，入牢視囚。天子遣大行騫驗王后及問王勃，請逮勃所與姦諸證左，王又匿之。吏求捕勃大急，使人致擊笞掠，擅出漢所疑囚者。有司請誅憲王後修及王勃。上以修素無行，使棁陷之罪，勃無良師傅，不忍誅。有司請廢王後修，徙王勃以家屬處房陵，上許之。"}],"attestations":[{"id":"th-shiji059-059:a001","paragraph_id":"c-shiji-059-wuzong:p033","start":253,"end":255,"surface":"大行","person_mention_id":"c-shiji-059-wuzong:m033-0253","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"來源授封、徙封、承爵、職位與用稱分存；相對年數保持原語，不換算公曆或由死亡、首次提及補起訖。王號中的諡字不當生前正式授爵名。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji059-045","person_id":"0wy_1jp_os3","surfaces":["大行騫"],"scope":"same_chapter","chapter_ids":["c-shiji-059-wuzong"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-059-wuzong:p033","quote":"初，憲王舜有所不愛姬生長男棁。棁以母無寵故，亦不得幸於王。王後修生太子勃。王內多，所幸姬生子平、子商，王后希得幸。及憲王病甚，諸幸姬常侍病，故王后亦以妒媢不常侍病，輒歸舍。醫進藥，太子勃不自嘗藥，又不宿留侍病。及王薨，王后、太子乃至。憲王雅不以長子棁為人數，及薨，又不分與財物。郎或說太子、王后，令諸子與長子棁共分財物，太子、王后不聽。太子代立，又不收恤棁。棁怨王后、太子。漢使者視憲王喪，棁自言憲王病時，王后、太子不侍，及薨，六日出舍，太子勃私姦，飲酒，博戲，擊筑，與女子載馳，環城過市，入牢視囚。天子遣大行騫驗王后及問王勃，請逮勃所與姦諸證左，王又匿之。吏求捕勃大急，使人致擊笞掠，擅出漢所疑囚者。有司請誅憲王後修及王勃。上以修素無行，使棁陷之罪，勃無良師傅，不忍誅。有司請廢王後修，徙王勃以家屬處房陵，上許之。"}],"rationale":"依明示姓名、母子世系、局部王系及承爵敘事暫接；同名慶分支保存，王號不跨世代或支系套用，名非不當普通否定詞。未名皇帝、群體、指控與制度職稱不補事實；版本、跨篇與有效時段待覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-059-wuzong:p033","text":"初，憲王舜有所不愛姬生長男棁。棁以母無寵故，亦不得幸於王。王後修生太子勃。王內多，所幸姬生子平、子商，王后希得幸。及憲王病甚，諸幸姬常侍病，故王后亦以妒媢不常侍病，輒歸舍。醫進藥，太子勃不自嘗藥，又不宿留侍病。及王薨，王后、太子乃至。憲王雅不以長子棁為人數，及薨，又不分與財物。郎或說太子、王后，令諸子與長子棁共分財物，太子、王后不聽。太子代立，又不收恤棁。棁怨王后、太子。漢使者視憲王喪，棁自言憲王病時，王后、太子不侍，及薨，六日出舍，太子勃私姦，飲酒，博戲，擊筑，與女子載馳，環城過市，入牢視囚。天子遣大行騫驗王后及問王勃，請逮勃所與姦諸證左，王又匿之。吏求捕勃大急，使人致擊笞掠，擅出漢所疑囚者。有司請誅憲王後修及王勃。上以修素無行，使棁陷之罪，勃無良師傅，不忍誅。有司請廢王後修，徙王勃以