on_id":"u9s_w6j_8mc_AB","status":"source_attested","qualifiers":{"source_term":"子"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-074","source_id":"s-jinshu-074-ws1536331","chapter_id":"c-jinshu-074-huan-family","paragraph_id":"c-jinshu-074-huan-family:p006","quote":"雲字雲子。初為驃騎何充參軍、尚書郎，不拜。襲爵萬寧男，歷位建武將軍、義成太守。遭母憂去職。葬畢，起為江州刺史，稱疾，廬於墓次。詔書敦逼，固辭不行，服闋，然後蒞職。加都督司豫二州軍事、領鎮蠻護軍、西陽太守、假節。雲招集眾力，志在足兵，多所枉濫，眾皆嗟怨。時溫執權，有司不敢彈劾。昇平四年卒，贈平南將軍，諡曰貞。子序嗣，官至宣城內史。","subject_person_mention_id":"c-jinshu-074-huan-family:p006:m0155","object_person_mention_id":"c-jinshu-074-huan-family:p006:m0000"}],"interpretation_note":"依完整原段與具體錨點辨識；未補原文未述父母、配偶、世系或排行。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-074-huan-family:p006:m0155","start":155,"end":156,"surface":"序","kind":"person","person_id":"u9s_w6j_8mc_ABA","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。","paragraph_id":"c-jinshu-074-huan-family:p006","chapter_id":"c-jinshu-074-huan-family"},{"id":"c-songshu-047-liujingxuan:p001:m0057","start":57,"end":59,"surface":"桓序","kind":"person","person_id":"u9s_w6j_8mc_ABA","status":"contextual_provisional","paragraph_id":"c-songshu-047-liujingxuan:p001","chapter_id":"c-songshu-047-liujingxuan"},{"id":"c-songshu-047-liujingxuan:p001:m0066","start":66,"end":67,"surface":"序","kind":"person","person_id":"u9s_w6j_8mc_ABA","status":"contextual_provisional","paragraph_id":"c-songshu-047-liujingxuan:p001","chapter_id":"c-songshu-047-liujingxuan"},{"id":"c-songshu-047-liujingxuan:p001:m0101","start":101,"end":102,"surface":"序","kind":"person","person_id":"u9s_w6j_8mc_ABA","status":"contextual_provisional","paragraph_id":"c-songshu-047-liujingxuan:p001","chapter_id":"c-songshu-047-liujingxuan"}],"relations":[{"id":"a-huan-close-063","subject_person_id":"u9s_w6j_8mc_ABA","predicate":"father","object_person_id":"u9s_w6j_8mc_AB","status":"source_attested","qualifiers":{"source_term":"子"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-074","source_id":"s-jinshu-074-ws1536331","chapter_id":"c-jinshu-074-huan-family","paragraph_id":"c-jinshu-074-huan-family:p006","quote":"雲字雲子。初為驃騎何充參軍、尚書郎，不拜。襲爵萬寧男，歷位建武將軍、義成太守。遭母憂去職。葬畢，起為江州刺史，稱疾，廬於墓次。詔書敦逼，固辭不行，服闋，然後蒞職。加都督司豫二州軍事、領鎮蠻護軍、西陽太守、假節。雲招集眾力，志在足兵，多所枉濫，眾皆嗟怨。時溫執權，有司不敢彈劾。昇平四年卒，贈平南將軍，諡曰貞。子序嗣，官至宣城內史。","subject_person_mention_id":"c-jinshu-074-huan-family:p006:m0155","object_person_mention_id":"c-jinshu-074-huan-family:p006:m0000"}],"interpretation_note":"依完整原段與具體錨點辨識；未補原文未述父母、配偶、世系或排行。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"title_holdings":[{"id":"th-songshu-047-liujingxuan-1-53","title":"輔國將軍","kind":"office","mode":"attestation","person_id":"u9s_w6j_8mc_ABA","attestations":[{"id":"th-songshu-047-liujingxuan-1-53:a","paragraph_id":"c-songshu-047-liujingxuan:p001","start":53,"end":57,"surface":"輔國將軍","person_mention_id":"c-songshu-047-liujingxuan:p001:m0057","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-047","chapter_id":"c-songshu-047-liujingxuan","source_id":"s-songshu-047-liujingxuan-ws2190557","paragraph_id":"c-songshu-047-liujingxuan:p001","quote":"劉敬宣字萬壽，彭城人，漢楚元王交後也。祖建，征虜將軍。父牢之，鎮北將軍。敬宣八歲喪母，晝夜號泣，中表異之，輔國將軍桓序鎮蕪湖，牢之參序軍事。四月八日，敬宣見眾人灌佛，乃下頭上金鏡以為母灌，因悲泣不自勝。序歎息，謂牢之曰：「卿此兒既為家之孝子，必為國之忠臣。」起家為王恭前軍參軍，又參會稽世子元顯征虜軍事。","person_mention_id":"c-songshu-047-liujingxuan:p001:m0057"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-074-huan-family:p006","text":"雲字雲子。初為驃騎何充參軍、尚書郎，不拜。襲爵萬寧男，歷位建武將軍、義成太守。遭母憂去職。葬畢，起為江州刺史，稱疾，廬於墓次。詔書敦逼，固辭不行，服闋，然後蒞職。加都督司豫二州軍事、領鎮蠻護軍、西陽太守、假節。雲招集眾力，志在足兵，多所枉濫，眾皆嗟怨。時溫執權，有司不敢彈劾。昇平四年卒，贈平南將軍，諡曰貞。子序嗣，官至宣城內史。","source_position":{"kind":"wikitext_codepoint_positions","raw_path":"sources/jinshu/wikisource-1536331-raw.wikitext","raw_start":1335,"raw_end":1565,"character_positions":[1337,1338,1339,1340,1341,1342,1343,1344,1345,1346,1347,1348,1349,1350,1351,1352,1353,1354,1355,1356,1357,1358,1359,1360,1361,1362,1363,1364,1365,1366,1367,1368,1369,1370,1371,1372,1373,1374,1431,1432,1433,1434,1435,1436,1437,1438,1439,1440,1441,1442,1443,1444,1445,1446,1447,1448,1449,1450,1451,1452,1453,1454,1455,1456,1457,1458,1459,1460,1461,1462,1463,1464,1465,1466,1467,1468,1469,1470,1471,1472,1473,1474,1475,1476,1477,1478,1479,1480,1481,1482,1483,1484,1485,1486,1487,1488,1489,1490,1491,1492,1493,1494,1495,1496,1497,1498,1499,1500,1501,1502,1503,1504,1505,1506,1507,1508,1509,1510,1511,1512,1513,1514,1515,1516,1517,1518,1519,1520,1521,1522,1523,1524,1525,1526,1527,1528,1529,1530,1536,1537,1538,1539,1542,1543,1544,1545,1546,1547,1548,1549,1550,1551,1552,1553,1554,1555,1556,1557,1558,1559,1560,1561,1562,1563,1564]},"mentions":[{"id":"c-jinshu-074-huan-family:p006:m0000","start":0,"end":1,"surface":"雲","kind":"person","person_id":"u9s_w6j_8mc_AB","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。"},{"id":"c-jinshu-074-huan-family:p006:m0002","start":2,"end":4,"surface":"雲子","kind":"person","person_id":"u9s_w6j_8mc_AB","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。"},{"id":"c-jinshu-074-huan-family:p006:m0009","start":9,"end":11,"surface":"何充","kind":"person","person_id":"0os_htj_jqc","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。"},{"id":"c-jinshu-074-huan-family:p006:m0040","start":40,"end":41,"surface":"母","kind":"person","person_id":"ywa_wg3_39c"