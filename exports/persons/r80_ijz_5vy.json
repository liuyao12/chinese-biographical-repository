ly-literature-complete:p005:m0014","start":14,"end":16,"surface":"沈淵","kind":"person","person_id":"r80_ijz_5vy","status":"contextual_provisional"},{"id":"c-nanqishu-052-early-literature-complete:p005:m0018","start":18,"end":20,"surface":"王儉","kind":"person","person_id":"7r6_k52_qji_ABAAAAEAA","status":"contextual_provisional"},{"id":"c-nanqishu-052-early-literature-complete:p005:m0022","start":22,"end":23,"surface":"淵","kind":"person","person_id":"r80_ijz_5vy","status":"contextual_provisional"},{"id":"c-nanqishu-052-early-literature-complete:p005:m0026","start":26,"end":28,"surface":"王令","kind":"person","person_id":"7r6_k52_qji_ABAAAAEAA","status":"contextual_provisional"},{"id":"c-nanqishu-052-early-literature-complete:p005:m0034","start":34,"end":36,"surface":"靈鞠","kind":"person","person_id":"ax0_dwk_ohy","status":"contextual_provisional"},{"id":"c-nanqishu-052-early-literature-complete:p005:m0050","start":50,"end":51,"surface":"儉","kind":"person","person_id":"7r6_k52_qji_ABAAAAEAA","status":"contextual_provisional"},{"id":"c-nanqishu-052-early-literature-complete:p005:m0052","start":52,"end":54,"surface":"靈鞠","kind":"person","person_id":"ax0_dwk_ohy","status":"contextual_provisional"},{"id":"c-nanqishu-052-early-literature-complete:p005:m0080","start":80,"end":82,"surface":"王儉","kind":"person","person_id":"7r6_k52_qji_ABAAAAEAA","status":"contextual_provisional"},{"id":"c-nanqishu-052-early-literature-complete:p005:m0087","start":87,"end":89,"surface":"丘公","kind":"person","person_id":"ax0_dwk_ohy","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-052-early-literature-complete","book_id":"b-nanqishu-052","work_id":"w-nanqishu","source_id":"s-nanqishu-052-early-literature-complete-ws2371079"},{"id":"c-nanqishu-054-recluses-complete:p071","text":"　　昇明末，太守王奐上表薦之，詔徵爲奉朝請，不就。永明六年，吏部郎沈淵、中書郎沈約又表薦驎士義行，曰：「吳興沈驎士，英風夙挺，峻節早樹，貞粹稟於天然，綜博生乎篤習。家世孤貧，藜藿不給，懷書而耕，白首無倦，挾琴採薪，行歌不輟。長兄早卒，孤姪數四，攝尪鞠稚，吞苦推甘。年踰七十，業行無改。元嘉以來，聘召仍疊，玉質踰潔，霜操日嚴。若使聞政王庭，服道槐掖，必能孚朝規於邊鄙，播聖澤於荒垂。」詔又徵爲太學博士，建武二年，徵著作郎，永元二年，徵太子舍人，竝不就。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":180,"last_line":180,"raw_start":9385,"raw_end":9610,"raw_character_offsets":[9385,9386,9387,9388,9389,9390,9391,9392,9393,9394,9395,9396,9397,9398,9399,9400,9401,9402,9403,9404,9405,9406,9407,9408,9409,9410,9411,9412,9413,9414,9415,9416,9417,9418,9419,9420,9421,9422,9423,9424,9425,9426,9427,9428,9429,9430,9431,9432,9433,9434,9435,9436,9437,9438,9439,9440,9441,9442,9443,9444,9445,9446,9447,9448,9449,9450,9451,9452,9453,9454,9455,9456,9457,9458,9459,9460,9461,9462,9463,9464,9465,9466,9467,9468,9469,9470,9471,9472,9473,9474,9475,9476,9477,9478,9479,9480,9481,9482,9483,9484,9485,9486,9487,9488,9489,9490,9491,9492,9493,9494,9495,9496,9497,9498,9499,9500,9501,9502,9503,9504,9505,9506,9507,9508,9509,9510,9511,9512,9513,9514,9515,9516,9517,9518,9519,9520,9521,9522,9523,9524,9525,9526,9527,9528,9529,9530,9531,9532,9533,9534,9535,9536,9537,9538,9539,9540,9541,9542,9543,9544,9545,9546,9547,9548,9549,9550,9551,9552,9553,9554,9555,9556,9557,9558,9559,9560,9561,9562,9563,9564,9565,9566,9567,9568,9569,9570,9571,9572,9573,9574,9575,9576,9577,9578,9579,9580,9581,9582,9583,9584,9585,9586,9587,9588,9589,9590,9591,9592,9593,9594,9595,9596,9597,9598,9599,9600,9601,9602,9603,9604,9605,9606,9607,9608,9609],"revision_id":1762878},"mentions":[{"id":"c-nanqishu-054-recluses-complete:p071:m0008","start":8,"end":10,"surface":"王奐","kind":"person","person_id":"q7m_r8k_2vn_AA","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p071:m0033","start":33,"end":35,"surface":"沈淵","kind":"person","person_id":"r80_ijz_5vy","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p071:m0039","start":39,"end":41,"surface":"沈約","kind":"person","person_id":"p8b_7w1_y3q","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p071:m0044","start":44,"end":46,"surface":"驎士","kind":"person","person_id":"46f_sl6_8ou","status":"contextual_provisio