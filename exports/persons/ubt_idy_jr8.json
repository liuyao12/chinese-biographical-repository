窋立。不窋末年，夏后氏政衰，去稷不務，不窋以失其官而犇戎狄之間。不窋卒，子鞠立。鞠卒，子公劉立。公劉雖在戎狄之間，復修后稷之業，務耕種，行地宜，自漆、沮度渭，取材用，行者有資，居者有畜積，民賴其慶。百姓懷之，多徙而保歸焉。周道之興自此始，故詩人歌樂思其德。公劉卒，子慶節立，國於豳。","person_mention_id":"c-shiji-004-zhou:m003-0050"}],"source_term":"公劉卒","interpretation_note":"保存本段明言出生或卒；后稷出生故事具傳說性，不補生父、公元年或全部爵位終點。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"mentions":[{"id":"c-shiji-004-zhou:m003-0050","start":50,"end":52,"surface":"公劉","kind":"person","person_id":"ubt_idy_jr8","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p003","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-004-zhou:m003-0054","start":54,"end":56,"surface":"公劉","kind":"person","person_id":"ubt_idy_jr8","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p003","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-004-zhou:m003-0134","start":134,"end":136,"surface":"公劉","kind":"person","person_id":"ubt_idy_jr8","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p003","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-004-zhou:m004-0087","start":87,"end":89,"surface":"公劉","kind":"person","person_id":"ubt_idy_jr8","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p004","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-004-zhou:m007-0023","start":23,"end":25,"surface":"公劉","kind":"person","person_id":"ubt_idy_jr8","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p007","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-099-liushu:m002-0071","start":71,"end":73,"surface":"公劉","kind":"person","person_id":"ubt_idy_jr8","status":"contextual_provisional","paragraph_id":"c-shiji-099-liushu:p002","chapter_id":"c-shiji-099-liushu"},{"id":"c-shiji-110-xiongnu:m002-0005","start":5,"end":7,"surface":"公劉","kind":"person","person_id":"ubt_idy_jr8","status":"contextual_provisional","paragraph_id":"c-shiji-110-xiongnu:p002","chapter_id":"c-shiji-110-xiongnu"},{"id":"c-shiji-117-xiangru:m058-0073","start":73,"end":75,"surface":"公劉","kind":"person","person_id":"ubt_idy_jr8","status":"contextual_provisio