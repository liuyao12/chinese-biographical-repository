03-0134","start":134,"end":136,"surface":"公劉","kind":"person","person_id":"ubt_idy_jr8","status":"source_identified"},{"id":"c-shiji-004-zhou:m003-0139","start":139,"end":141,"surface":"慶節","kind":"person","person_id":"ea7_lok_3qv","status":"source_identified"}],"chapter_id":"c-shiji-004-zhou","book_id":"b-shiji-004","work_id":"w-shiji","source_id":"s-shiji-004-zhou"},{"id":"c-shiji-004-zhou:p004","text":"慶節卒，子皇仆立。皇仆卒，子差弗立。差弗卒，子毀隃立。毀隃卒，子公非立。公非卒，子高圉立。高圉卒，子亞圉立。亞圉卒，子公叔祖類立。公叔祖類卒，子古公亶父立。古公亶父復修后稷、公劉之業，積德行義，國人皆戴之。薰育戎狄攻之，欲得財物，予之。已復攻，欲得地與民。民皆怒，欲戰。古公曰：「有民立君，將以利之。今戎狄所為攻戰，以吾地與民。民之在我，與其在彼，何異。民欲以我故戰，殺人父子而君之，予不忍為。」乃與私屬遂去豳，度漆、沮，踰梁山，止於岐下。豳人舉國扶老攜弱，盡復歸古公於岐下。及他旁國聞古公仁，亦多歸之。於是古公乃貶戎狄之俗，而營筑城郭室屋，而邑別居之。作五官有司。民皆歌樂之，頌其德。","annotation_status":"in_progress","mentions":[{"id":"c-shiji-004-zhou:m004-0000","start":0,"end":2,"surface":"慶節","kind":"person","person_id":"ea7_lok_3qv","status":"source_identified"},{"id":"c-shiji-004-zhou:m004-0005","start":5,"end":7,"surface":"皇仆","kind":"person","person_id":"b6b_x4q_wih","status":"source_identified"},{"id":"c-shiji-004-zhou:m004-0009","start":9,"end":11,"surface":"皇仆","kind":"person","person_id":"b6b_x4q_wih","status":"source_identified"},{"id":"c-shiji-004-zhou:m004-0014","start":14,"end":16,"surface":"差弗","kind":"person","person_id":"6k3_ylu_5tf","status":"source_identified"},{"id":"c-shiji-004-zhou:m004-0018","start":18,"end":20,"surface":"差弗","kind":"person","person_id":"6k3_ylu_5tf","status":"source_identified"},{"id":"c-shiji-004-zhou:m004-0023","start":23,"end":25,"surface":"毀隃","kind":"person","person_id":"56r_ewo_1hp","status":"source_identified"},{"id":"c-shiji-004-zhou:m004-0027","start":27,"end":29,"surface":"毀隃","kind":"person","person_id":"56r_ewo_1hp","status":"source_identified"},{"id":"c-shiji-004-zhou:m004-0032","start":32,"end":34,"surface":"公非","kind":"person","person_id":"rcf_f6n_ykv","status":"source_identified"},{"id":"c-shiji-004-zhou:m004-0036","start":36,"end":38,"surface":"公非","kind":"person","person_id":"rcf_f6n_ykv","status