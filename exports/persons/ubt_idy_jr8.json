atus":"source_identified"}],"chapter_id":"c-shiji-004-zhou","book_id":"b-shiji-004","work_id":"w-shiji","source_id":"s-shiji-004-zhou"},{"id":"c-shiji-004-zhou:p007","text":"公季卒，子昌立，是為西伯。西伯曰文王，遵后稷、公劉之業，則古公、公季之法，篤仁，敬老，慈少。禮下賢者，日中不暇食以待士，士以此多歸之。伯夷、叔齊在孤竹，聞西伯善養老，盍往歸之。太顛、閎夭、散宜生、鬻子、辛甲大夫之徒皆往歸之。","annotation_status":"in_progress","mentions":[{"id":"c-shiji-004-zhou:m007-0000","start":0,"end":2,"surface":"公季","kind":"person","person_id":"y4i_pjk_4gn","status":"source_identified"},{"id":"c-shiji-004-zhou:m007-0005","start":5,"end":6,"surface":"昌","kind":"person","person_id":"y4i_pjk_4gn_A","status":"source_identified"},{"id":"c-shiji-004-zhou:m007-0010","start":10,"end":12,"surface":"西伯","kind":"person","person_id":"y4i_pjk_4gn_A","status":"source_identified"},{"id":"c-shiji-004-zhou:m007-0013","start":13,"end":15,"surface":"西伯","kind":"person","person_id":"y4i_pjk_4gn_A","status":"source_identified"},{"id":"c-shiji-004-zhou:m007-0016","start":16,"end":18,"surface":"文王","kind":"person","person_id":"y4i_pjk_4gn_A","status":"source_identified"},{"id":"c-shiji-004-zhou:m007-0020","start":20,"end":22,"surface":"后稷","kind":"person","person_id":"jqy_1fv_u7v","status":"source_identified"},{"id":"c-shiji-004-zhou:m007-0023","start":23,"end":25,"surface":"公劉","kind":"person","person_id":"ubt_idy_jr8","status":"source_identified"},{"id":"c-shiji-004-zhou:m007-0029","start":29,"end":31,"surface":"古公","kind":"person","person_id":"5dm_e40_rqh","status":"source_identified"},{"id":"c-shiji-004-zhou:m007-0032","start":32,"end":34,"surface":"公季","kind":"person","person_id":"y4i_pjk_4gn","status":"source_identified"},{"id":"c-shiji-004-zhou:m007-0067","start":67,"end":69,"surface":"伯夷","kind":"person","person_id":"eh7_raa_ap6","status":"source_identified"},{"id":"c-shiji-004-zhou:m007-0070","start":70,"end":72,"surface":"叔齊","kind":"person","person_id":"ktv_rwx_hp3","status":"source_identified"},{"id":"c-shiji-004-zhou:m007-0077","start":77,"end":79,"surface":"西伯","kind":"person","person_id":"y4i_pjk_4gn_A","status":"source_identified"},{"id":"c-shiji-004-zhou:m007-0088","start":88,"end":90,"surface":"太顛","kind":"person","person_id":"5pr_wl7_dk1","status":"source_identified"},{"id":"c-shiji-004-zhou:m007-0091","start":91,"end":93,"surface":"閎夭","kind":"person","person_id":"hv8_0ce_lw9","status":"source_identified"},{"id":"c-shiji-004-zhou:m007-0094","start":94,"end":97,"surface":"散宜生","kind":"person","person_id":"1dm_ebc_uzk","status":"source_identified"},{"id":"c-shiji-004-zhou:m007-0098","start":98,"end":100,"surface":"鬻子","kind":"person","person_id":"yql_pki_bko","status":"source_identified"},{"id":"c-shiji-004-zhou:m007-0101","start":101,"end":103,"surface":"辛甲","kind":"person","person_id":"wdr_m9a_k1r","status":"source_identified"}],"chapter_id":"c-shiji-004-zhou","book_id":"b-shiji-004","work_id":"w-shiji","source_id":"s-shiji-004-zhou"},{"id":"c-shiji-099-liushu:p002","text":"已而問婁敬，婁敬說曰：「陛下都洛陽，豈欲與周室比隆哉？」上曰：「然。」婁敬曰：「陛下取天下與周室異。周之先自后稷，堯封之邰，積德累善十有餘世。公劉避桀居豳。太王以狄伐故，去豳，杖馬箠居岐，國人爭隨之。及文王為西伯，斷虞芮之訟，始受命，呂望、伯夷自海濱來歸之。武王伐紂，不期而會孟津之上八百諸侯，皆曰紂可伐矣，遂滅殷。成王即位，周公之屬傅相焉，乃營成周洛邑，以此為天下之中也，諸侯四方納貢職，道裏均矣，有德則易以王，無德則易以亡。凡居此者，欲令周務以德致人，不欲依阻險，令後世驕奢以虐民也。及周之盛時，天下和洽，四夷鄉風，慕義懷德，附離而并事天子，不屯一卒，不戰一士，八夷大國之民莫不賓服，效其貢職。及周之衰也，分而為兩，天下莫朝，周不能制也。非其德薄也，而形勢弱也。今陛下起豐沛，收卒三千人，以之徑往而卷蜀漢，定三秦，與項羽戰滎陽，爭成皋之口，大戰七十，小戰四十，使天下之民肝腦涂地，父子暴骨中野，不可勝數，哭泣之聲未絕，傷痍者未起，而欲比隆於成康之時，臣竊以為不侔也。且夫秦地被山帶河，四塞以為固，卒然有急，百萬之眾可具也。因秦之故，資甚美膏腴之地，此所謂天府者也。陛下入關而都之，山東雖亂，秦之故地可全而有也。夫與人鬬，不搤其亢，拊其背，未能全其勝也。今陛下入關而都，案秦之故地，此亦搤天下之亢而拊其背也。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-099-liushu:m002-0003","start":3,"end":5,"surface":"婁敬","kind":"person","person_id":"e5s_bwt_y45","status":"contextual_provisional"},{"id":"c-shiji-099-liushu:m002-0006","start":6,"end":8,"surface":"婁敬","kind":"person","person_id":"e5s_bwt_y45","status":"contextual_provisional"},{"id":"c-shiji-099-liushu:m002-0012","start":12,"end":14,"surface":"陛下","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"}