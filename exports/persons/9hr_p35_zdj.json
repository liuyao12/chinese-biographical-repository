],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji097-024","person_id":"9hr_p35_zdj","scope":"same_chapter","chapter_ids":["c-shiji-097-luli"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["閎籍孺"],"evidence":[{"paragraph_id":"c-shiji-097-luli:p018","quote":"辟陽侯幸呂太后，人或毀辟陽侯於孝惠帝，孝惠帝大怒，下吏，欲誅之。呂太后慚，不可以言。大臣多害辟陽侯行，欲遂誅之。辟陽侯急，因使人欲見平原君。平原君辭曰：「獄急，不敢見君。」乃求見孝惠幸臣閎籍孺，說之曰：「君所以得幸帝，天下莫不聞。今辟陽侯幸太后而下吏，道路皆言君讒，欲殺之。今日辟陽侯誅，旦日太后含怒，亦誅君。何不肉袒為辟陽侯言於帝？帝聽君出辟陽侯，太后大驩。兩主共幸君，君貴富益倍矣。」於是閎籍孺大恐，從其計，言帝，果出辟陽侯。辟陽侯之囚，欲見平原君，平原君不見辟陽侯，辟陽侯以為倍己，大怒。及其成功出之，乃大驚。"}],"rationale":"按酈生、陸賈與朱建分傳及敘事承接限定異稱；尉他尉佗原字分存。平原君據明示朱建另候選；朱建兩處未名子尚不合併，淮陰侯與單稱韓信跨篇同指待證。引語古王及神話人物與當事人分開。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-097-luli:p018","text":"辟陽侯幸呂太后，人或毀辟陽侯於孝惠帝，孝惠帝大怒，下吏，欲誅之。呂太后慚，不可以言。大臣多害辟陽侯行，欲遂誅之。辟陽侯急，因使人欲見平原君。平原君辭曰：「獄急，不敢見君。」乃求見孝惠幸臣閎籍孺，說之曰：「君所以得幸帝，天下莫不聞。今辟陽侯幸太后而下吏，道路皆言君讒，欲殺之。今日辟陽侯誅，旦日太后含怒，亦誅君。何不肉袒為辟陽侯言於帝？帝聽君出辟陽侯，太后大驩。兩主共幸君，君貴富益倍矣。」於是閎籍孺大恐，從其計，言帝，果出辟陽侯。辟陽侯之囚，欲見平原君，平原君不見辟陽侯，辟陽侯以為倍己，大怒。及其成功出之，乃大驚。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-097-luli:m018-0000","start":0,"end":3,"surface":"辟陽侯","kind":"person","person_id":"697_9f9_d41","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m018-0004","start":4,"end":7,"surface":"呂太后","kind":"person","person_id":"otq_r9b_d3z","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m018-0011","start":11,"end":14,"surface":"辟陽侯","kind":"person","person_id":"697_9f9_d41","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m018-0015","start":15,"end":18,"surface":"孝惠帝","kind":"person","person_id":"noy_49h_qor","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m018-0019","start":19,"end":22,"surface":"孝惠帝","kind":"person","person_id":"noy_49h_qor","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m018-0032","start":32,"end":35,"surface