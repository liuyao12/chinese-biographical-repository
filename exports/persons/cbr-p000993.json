tart":619,"end":621,"surface":"天子","kind":"person","person_id":"cbr-p000941","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m021-0631","start":631,"end":633,"surface":"黃帝","kind":"person","person_id":"cbr-p000001","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m021-0647","start":647,"end":648,"surface":"卿","kind":"person","person_id":"cbr-p000993","status":"contextual_provisional"}],"chapter_id":"c-shiji-012-wudi","book_id":"b-shiji-012","work_id":"w-shiji","source_id":"s-shiji-012-wudi"},{"id":"c-shiji-012-wudi:p025","text":"其冬，公孫卿候神河南，見僊人跡緱氏城上，有物若雉，往來城上。天子親幸緱氏城視跡。問卿：「得毋效文成、五利乎？」卿曰：「僊者非有求人主，人主求之。其道非少寬假，神不來。言神事，事如迂誕，積以歲乃可致。」於是郡國各除道，繕治宮觀名山神祠所，以望幸矣。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-012-wudi:m025-0003","start":3,"end":6,"surface":"公孫卿","kind":"person","person_id":"cbr-p000993","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m025-0030","start":30,"end":32,"surface":"天子","kind":"person","person_id":"cbr-p000941","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m025-0041","start":41,"end":42,"surface":"卿","kind":"person","person_id":"cbr-p000993","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m025-0047","start":47,"end":49,"surface":"文成","kind":"person","person_id":"cbr-p000982","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m025-0050","start":50,"end":52,"surface":"五利","kind":"person","person_id":"cbr-p000987","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m025-0055","start":55,"end":56,"surface":"卿","kind":"person","person_id":"cbr-p000993","status":"contextual_provisional"}],"chapter_id":"c-shiji-012-wudi","book_id":"b-shiji-012","work_id":"w-shiji","source_id":"s-shiji-012-wudi"},{"id":"c-shiji-012-wudi:p028","text":"自得寶鼎，上與公卿諸生議封禪。封禪用希曠絕，莫知其儀禮，而群儒采封禪尚書、周官、王制之望祀射牛事。齊人丁公年九十餘，曰：「封者，合不死之名也。秦皇帝不得上封。陛下必欲上，稍上即無風雨，遂上封矣。」上於是乃令諸儒習射牛，草封禪儀。數年，至且行。天子既聞公孫卿及方士之言，黃帝以上封禪，皆致怪物與神通，欲放黃帝以嘗接神僊人蓬萊士，高世比德於九皇，而頗采儒術以文之。群儒既以不能辯明封禪事，又牽拘於詩書古文而不敢騁。上為封祠器示群儒，群儒或曰「不與古同」，徐偃又曰「太常諸生行禮不如魯善」，周霸屬圖封事，於是上絀偃、霸，盡罷諸儒弗用。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-012-wudi:m028-0051","start":51,"end":53,"surface":"丁公","kind":"person","person_id":"cbr-p001000","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m028-0071","start":71,"end":74,"surface":"秦皇帝","kind":"person","person_id":"cbr-p000533","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m028-0079","start":79,"end":81,"surface":"陛下","kind":"person","person_id":"cbr-p000941","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m028-0121","start":121,"end":123,"surface":"天子","kind":"person","person_id":"cbr-p000941","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m028-0125","start":125,"end":128,"surface":"公孫卿","kind":"person","person_id":"cbr-p000993","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m028-0134","start":134,"end":136,"surface":"黃帝","kind":"person","person_id":"cbr-p000001","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m028-0151","start":151,"end":153,"surface":"黃帝","kind":"person","person_id":"cbr-p000001","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m028-0168","start":168,"end":170,"surface":"九皇","kind":"unresolved","person_id":null,"status":"unresolved","note":"神祇、群體、匿名者或未定指代，保留來源，不補未見姓名與成員。"},{"id":"c-shiji-012-wudi:m028-0225","start":225,"end":227,"surface":"徐偃","kind":"person","person_id":"cbr-p001001","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m028-0242","start":242,"end":244,"surface":"周霸","kind":"person","person_id":"cbr-p001002","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m028-0253","start":253,"end":254,"surface":"偃","kind":"person","person_id":"cbr-p001001","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m028-0255","start":255,"end":256,"surface":"霸","kind":"person","person_id":"cbr-p001002","status":"contextual_provisional"}],"chapter_id":"c-shiji-012-wudi","book_id":"b-shiji-012","work_id":"w-shiji","source_id":"s-shiji-012-wudi"},{"id":"c-shiji-012-wudi:p030","text":"上遂東巡海上，行禮祠八神。齊人之上疏言神怪奇方者以萬數，然無驗者。乃益發船，令言海中神山者數千人求蓬萊神人。公孫卿持節常先行候名山，至東萊，言夜見一人，長數丈，就之則不見，見其跡甚大，類禽獸云。群臣有言見一老父牽狗，言「吾欲見巨公」，已忽不見。上既見大跡，未信，及群臣有言老父，則大以為僊人也。宿留海上，與方士傳車及閒使求僊人以千數。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-012-wudi:m030-0010","start":10,"end":12,"surface":"八神","kind":"unresolved","person_id":null,"status":"unresolved","note":"神祇、群體、匿名者或未定指代，保留來源，不補未見姓名與成員。"},{"id":"c-shiji-012-wudi:m030-0054","start":54,"end":57,"surface":"公孫卿","kind":"person","person_id":"cbr-p000993","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m030-0073","start":73,"end":75,"surface":"一人","kind":"unresolved","person_id":null,"status":"unresolved","note":"神祇、群體、匿名者或未定指代，保留來源，不補未見姓名與成員。"},{"id":"c-shiji-012-wudi:m030-0102","start":102,"end":105,"surface":"一老父","kind":"unresolved","person_id":null,"status":"unresolved","note":"神祇、群體、匿名者或未定指代，保留來源，不補未見姓名與成員。"},{"id":"c-shiji-012-wudi:m030-0136","start":136,"end":138,"surface":"老父","kind":"unresolved","person_id":null,"status":"unresolved","note":"神祇、群體、匿名者或未定指代，保留來源，不補未見姓名與成員。"}],"chapter_id":"c-shiji-012-wudi","book_id":"b-shiji-012","work_id":"w-shiji","source_id":"s-shiji-012-wudi"},{"id":"c-shiji-012-wudi:p036","text":"其春，公孫卿言見神人東萊山，若云「見天子」。天子於是幸緱氏城，拜卿為中大夫。遂至東萊，宿留之數日，毋所見，見大人跡。復遣方士求神怪采芝藥以千數。是歲旱。於是天子既出毋名，乃禱萬里沙，過祠泰山。還至瓠子，自臨塞決河，留二日，沈祠而去。使二卿將卒塞決河，河徙二渠，復禹之故跡焉。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-012-wudi:m036-0003","start":3,"end":6,"surface":"公孫卿","kind":"person","person_id":"cbr-p000993","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m036-0018","start":18,"end":20,"surface":"天子","kind":"person","person_id":"cbr-p000941","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m036-0022","start":22,"end":24,"surface":"天子","kind":"person","person_id":"cbr-p000941","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m036-0032","start":32,"end":33,"surface":"卿","kind":"person","person_id":"cbr-p000993","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m036-0078","start":78,"end":80,"surface":"天子","kind":"person","person_id":"cbr-p000941","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m036-0118","start":118,"end":119,"surface":"卿","kind":"person","person_id":"cbr-p000993","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m036-0131","start":131,"end":132,"surface":"禹","kind":"person","person_id":"cbr-p000043","status":"contextual_provisional"}],"chapter_id":"c-shiji-012-wudi","book_id":"b-shiji-012","work_id":"w-shiji","source_id":"s-shiji-012-wudi"},{"id":"c-shiji-012-wudi:p038","text":"公孫卿曰：「僊人可見，而上往常遽，以故不見。今陛下可為觀，如緱氏城，置脯棗，神人宜可致。且僊人好樓居。」於是上令長安則作蜚廉桂觀，甘泉則作益延壽觀，使卿持節設具而候神人，乃作通天臺，置祠具其下，將招來神僊之屬。於是甘泉更置前殿，始廣諸宮室。夏，有芝生殿防內中。天子為塞河，興通天臺，若有光雲，乃下詔曰：「甘泉防生芝九莖，赦天下，毋有復作。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-012-wudi:m038-0000","start":0,"end":3,"surface":"公孫卿","kind":"person","person_id":"cbr-p000993","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m038-0023","start":23,"end":25,"surface":"陛下","kind":"person","person_id":"cbr-p000941","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m038-0075","start":75,"end":76,"surface":"卿","kind":"person","person_id":"cbr-p000993","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m038-0130","start":130,"end":132,"surface":"天子","kind":"person","person_id":"cbr-p000941","status":"contextual_provisional"}],"chapter_id":"c-shiji-012-wudi","book_id":"b-shiji-012","work_id":"w-shiji","source_id":"s-shiji-012-wudi"},{"id":"c-shiji-012-wudi:p039","text":"其明年，伐朝鮮。夏，旱。公孫卿曰：「黃帝時封則天旱，乾封三年。」上乃下詔曰：「天旱，意乾封乎？其令天下尊祠靈星焉。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-012-wudi:m039-0012","start":12,"end":15,"surface":"公孫卿","kind":"person","person_id":"cbr-p000993","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m039-0018","start":18,"end":20,"surface":"黃帝","kind":"person","person_id":"cbr-p000001","status":"contextual_provisional"}],"chapter_id":"c-shiji-012-wudi","book_id":"b-shiji-012","work_id":"w-shiji","source_id":"s-shiji-012-wudi"},{"id":"c-shiji-012-wudi:p045","text":"上還，以柏梁災故，朝受計甘泉。公孫卿曰：「黃帝就青靈臺，十二日燒，黃帝乃治明庭。明庭，甘泉也。」方士多言古帝王有都甘泉者。其後天子又朝諸侯甘泉，甘泉作諸侯邸。勇之乃曰：「越俗有火災，復起屋必以大，用勝服之。」於是作建章宮，度為千門萬戶。前殿度高未央，其東則鳳闕，高二十餘丈。其西則唐中，數十里虎圈。其北治大池，漸臺高二十餘丈，名曰泰液池，中有蓬萊、方丈、瀛洲、壺梁，象海中神山龜魚之屬。其南有玉堂、璧門、大鳥之屬。乃立神明臺、井幹樓，度五十餘丈，輦道相屬焉。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-012-wudi:m045-0015","start":15,"end":18,"surface":"公孫卿","kind":"person","person_id":"cbr-p000993","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m045-0021","start":21,"end":23,"surface":"黃帝","kind":"person","person_id":"cbr-p000001","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m045-0033","start":33,"end":35,"surface":"黃帝","kind":"person","person_id":"cbr-p000001","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m045-0063","start":63,"end":65,"surface":"天子","kind":"person","person_id":"cbr-p000941","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m045-0079","start":79,"end":81,"surface":"勇之","kind":"person","person_id":"cbr-p001005","status":"contextual_provisional"}],"chapter_id":"c-shiji-012-wudi","book_id":"b-shiji-012","work_id":"w-shiji","source_id":"s-shiji-012-wudi"},{"id":"c-shiji-012-wudi:p051","text":"今天子所興祠，泰一、后土，三年親郊祠，建漢家封禪，五年一修封。薄忌泰一及三一、冥羊、馬行、赤星，五，寬舒之祠官以歲時致禮。凡六祠，皆太祝領之。至如八神諸神，明年、凡山他名祠，行過則祀，去則已。方士所興祠，各自主，其人終則已，祠官弗主。他祠皆如其故。今上封禪，其後十二歲而還，徧於五嶽、四瀆矣。而方士之候祠神人，入海求蓬萊，終無有驗。而公孫卿之候神者，猶以大人跡為解，無其效。天子益怠厭方士之怪迂語矣，然終羈縻弗絕，冀遇其真。自此之後，方士言祠神者彌眾，然其效可睹矣。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-012-wudi:m051-0001","start":1,"end":3,"surface":"天子","kind":"person","person_id":"cbr-p000941","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m051-0007","start":7,"end":9,"surface":"泰一","kind":"unresolved","person_id":null,"status":"unresolved","note":"神祇、群體、匿名者或未定指代，保留來源，不補未見姓名與成員。"},{"id":"c-shiji-012-wudi:m051-0010","start":10,"end":12,"surface":"后土","kind":"unresolved","person_id":null,"status":"unresolved","note":"神祇、群體、匿名者或未定指代，保留來源，不補未見姓名與成員。"},{"id":"c-shiji-012-wudi:m051-0031","start":31,"end":33,"surface":"薄忌","kind":"person","person_id":"cbr-p000979","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m051-0033","start":33,"end":35,"surface":"泰一","kind":"unresolved","person_id":null,"status":"unresolved","note":"神祇、群體、匿名者或未定指代，保留來源，不補未見姓名與成員。"},{"id":"c-shiji-012-wudi:m051-0036","start":36,"end":38,"surface":"三一","kind":"unresolved","person_id":null,"status":"unresolved","note":"神祇、群體、匿名者或未定指代，保留來源，不補未見姓名與成員。"},{"id":"c-shiji-012-wudi:m051-0039","start":39,"end":41,"surface":"冥羊","kind":"unresolved","person_id":null,"status":"unresolved","note":"神祇、群體、匿名者或未定指代，保留來源，不補未見姓名與成員。"},{"id":"c-shiji-012-wudi:m051-0042","start":42,"end":44,"surface":"馬行","kind":"unresolved","person_id":null,"status":"unresolved","note":"神祇、群體、匿名者或未定指代，保留來源，不補未見姓名與成員。"},{"id":"c-shiji-012-wudi:m051-0045","start":45,"end":47,"surface":"赤星","kind":"unresolved","person_id":null,"status":"unresolved","note":"神祇、群體、匿名者或未定指代，保留來源，不補未見姓名與成員。"},{"id":"c-shiji-012-wudi:m051-0050","start":50,"end":52,"surface":"寬舒","kind":"person","person_id":"cbr-p000978","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m051-0066","start":66,"end":68,"surface":"太祝","kind":"unresolved","person_id":null,"status":"unresolved","note":"神祇、群體、匿名者或未定指代，保留來源，不補未見姓名與成員。"},{"id":"c-shiji-012-wudi:m051-0073","start":73,"end":75,"surface":"八神","kind":"unresolved","person_id":null,"status":"unresolved","note":"神祇、群體、匿名者或未定指代，保留來源，不補未見姓名與成員。"},{"id":"c-shiji-012-wudi:m051-0167","start":167,"end":170,"surface":"公孫卿","kind":"person","person_id":"cbr-p000993","status":"contextual_provisional"},