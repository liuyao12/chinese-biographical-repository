{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"oob_8rk_z66","canonical_person_id":"oob_8rk_z66","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["oob_8rk_z66"],"persons":[{"id":"oob_8rk_z66","label":"魏其侯（酷吏列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"魏其侯","mention_ids":["c-shiji-122-kuli:m007-0030"]}],"evidence":[{"mention_id":"c-shiji-122-kuli:m007-0030","chapter_id":"c-shiji-122-kuli","paragraph_id":"c-shiji-122-kuli:p007","quote":"魏其侯"}]}],"source_mention_summary":[{"source_id":"s-shiji122-kuli","work_id":"w-shiji","book_id":"b-shiji-122","chapter_id":"c-shiji-122-kuli","mention_count":1,"mention_ids":["c-shiji-122-kuli:m007-0030"],"paragraph_ids":["c-shiji-122-kuli:p007"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji122-kuli"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-122-kuli:m007-0030","start":30,"end":33,"surface":"魏其侯","kind":"person","person_id":"oob_8rk_z66","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p007","chapter_id":"c-shiji-122-kuli"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-122-kuli:p007","text":"臨江王徴詣中尉府對簿，臨江王欲得刀筆爲書謝上，而都禁吏不予。魏其侯使人以閒與臨江王。臨江王旣爲書謝上，因自殺。竇太后聞之，怒，以危法中都，都免歸家。孝景帝乃使使持節拜都爲鴈門太守，而便道之官，得以便宜從事。匈奴素聞郅都節，居邊，爲引兵去，竟郅都死不近鴈門。匈奴至爲偶人象郅都，令騎馳射莫能中，見憚如此。匈奴患之。竇太后乃竟中都以漢法。景帝曰：「都忠臣。」欲釋之。竇太后曰：「臨江王獨非忠臣邪？」於是遂斬郅都。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-122-kuli:m007-0000","start":0,"end":3,"surface":"臨江王","kind":"person","person_id":"3sg_5re_qc2","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0011","start":11,"end":14,"surface":"臨江王","kind":"person","person_id":"3sg_5re_qc2","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0021","start":21,"end":22,"surface":"上","kind":"person","person_id":"av9_5kt_rys","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0024","start":24,"end":25,"surface":"都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0026","start":26,"end":27,"surface":"吏","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m007-0030","start":30,"end":33,"surface":"魏其侯","kind":"person","person_id":"oob_8rk_z66","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0038","start":38,"end":41,"surface":"臨江王","kind":"person","person_id":"3sg_5re_qc2","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0042","start":42,"end":45,"surface":"臨江王","kind":"person","person_id":"3sg_5re_qc2","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0049","start":49,"end":50,"surface":"上","kind":"person","person_id":"av9_5kt_rys","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0055","start":55,"end":58,"surface":"竇太后","kind":"person","person_id":"zcn_zyw_flp","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0067","start":67,"end":68,"surface":"都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0069","start":69,"end":70,"surface":"都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0074","start":74,"end":77,"surface":"孝景帝","kind":"person","person_id"