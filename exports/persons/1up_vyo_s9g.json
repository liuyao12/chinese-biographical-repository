{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"1up_vyo_s9g","canonical_person_id":"1up_vyo_s9g","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["1up_vyo_s9g"],"persons":[{"id":"1up_vyo_s9g","label":"徐榮祖（徐夤父）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"榮祖","mention_ids":["c-nanshi-059-wangsengru:p009:m0208"]}],"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-059","source_id":"s-nanshi-059-wangsengru-ws1553912","chapter_id":"c-nanshi-059-wangsengru","paragraph_id":"c-nanshi-059-wangsengru:p009","quote":"榮祖","mention_id":"c-nanshi-059-wangsengru:p009:m0208"}],"review":"ai_provisional","identity_note":"南史稱夤父榮祖，嘗獲罪繫獄。"},{"id":"1up_vyo_s9g_A","label":"徐夤（高平，徐榮祖子）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"徐夤","mention_ids":["c-nanshi-059-wangsengru:p003:m0093","c-nanshi-059-wangsengru:p009:m0196"]}],"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-059","source_id":"s-nanshi-059-wangsengru-ws1553912","chapter_id":"c-nanshi-059-wangsengru","paragraph_id":"c-nanshi-059-wangsengru:p003","quote":"徐夤","mention_id":"c-nanshi-059-wangsengru:p003:m0093"},{"work_id":"w-nanshi","book_id":"b-nanshi-059","source_id":"s-nanshi-059-wangsengru-ws1553912","chapter_id":"c-nanshi-059-wangsengru","paragraph_id":"c-nanshi-059-wangsengru:p009","quote":"徐夤","mention_id":"c-nanshi-059-wangsengru:p009:m0196"}],"review":"ai_provisional","identity_note":"齊西邸時同王僧孺為學林，與唐人徐夤分立。","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"1up_vyo_s9g","source_assertion_id":"a-nanshi059-wangsengru-xuyi","evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-059","source_id":"s-nanshi-059-wangsengru-ws1553912","chapter_id":"c-nanshi-059-wangsengru","paragraph_id":"c-nanshi-059-wangsengru:p009","quote":"虞羲字士光，會稽余姚人，盛有才藻，卒于晉安王侍郎。丘國賓，吳興人，以才志不遇，著書以譏揚雄。蕭文琰，蘭陵人。丘令楷，吳興人。江洪，濟陽人。竟陵王子良嘗夜集學士，刻燭為詩，四韻者則刻一寸，以此為率。文琰曰：「頓燒一寸燭，而成四韻詩，何難之有。」乃與令楷、江洪等共打銅缽立韻，響滅則詩成，皆可觀覽。劉孝孫，彭城人，博學通敏，而仕多不遂，常歎曰：「古人或開一說而致卿相，立談間而降白璧，書籍妄耳。」徐夤，高平人，有學行。父榮祖位秘書監，嘗有罪繫獄，旦日原之，而發皓白。齊武問其故，曰：「臣思愆於內，而發變於外。」當時稱之。","subject_person_mention_id":"c-nanshi-059-wangsengru:p009:m0196","object_person_mention_id":"c-nanshi-059-wangsengru:p009:m0208"}],"status":"contextual_provisional","interpretation_note":"徐夤下直書父榮祖。","human_reviewed":false}}],"source_mention_summary":[{"source_id":"s-nanshi-059-wangsengru-ws1553912","work_id":"w-nanshi","book_id":"b-nanshi-059","chapter_id":"c-nanshi-059-wangsengru","raw_mention_count":1,"mention_ids":["c-nanshi-059-wangsengru:p009:m0208"],"paragraph_ids":["c-nanshi-059-wangsengru:p009"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-nanshi-059-wangsengru:p009:m0208","mention_ids":["c-nanshi-059-wangsengru:p009:m0208"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-nanshi-059-wangsengru-ws1553912"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-nanshi059-wangsengru-xuyi","subject_person_id":"1up_vyo_s9g_A","object_person_id":"1up_vyo_s9g","predicate":"father","qualifiers":{"source_term":"父榮祖","nanshi059_wangsengru_reading":"xuyi","lineage":"paternal"},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-059","source_id":"s-nanshi-059-wangsengru-ws1553912","chapter_id":"c-nanshi-059-wangsengru","paragraph_id":"c-nanshi-059-wangsengru:p009","quote":"虞羲