vidence":[{"paragraph_id":"c-shiji-003-yin:p025","quote":"帝甲崩，子帝廩辛立","chapter_id":"c-shiji-003-yin","source_id":"s-shiji-003-yin"}],"qualifiers":{"source_term":"子","historicity":"historical_tradition"},"interpretation_note":"保存原文明示關係；不把繼位本身當作父子證據，未與出土材料對讀。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji003-047","subject_person_id":"kfj_bhr_cdz","predicate":"brother","object_person_id":"f41_iwq_mkl","status":"source_attested","evidence":[{"paragraph_id":"c-shiji-003-yin:p024","quote":"帝祖庚崩，弟祖甲立","chapter_id":"c-shiji-003-yin","source_id":"s-shiji-003-yin"}],"qualifiers":{"source_term":"弟","historicity":"historical_tradition","relative_age":"younger"},"interpretation_note":"保存原文明示關係；不把繼位本身當作父子證據，未與出土材料對讀。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji003-018","person_id":"kfj_bhr_cdz","surfaces":["祖甲","帝甲"],"scope":"same_chapter","chapter_ids":["c-shiji-003-yin"],"status":"source_explicit","evidence":[{"paragraph_id":"c-shiji-003-yin:p024","quote":"弟祖甲立，是為帝甲"}],"rationale":"本文明示同指。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji033-004","person_id":"kfj_bhr_cdz","surfaces":["祖甲"],"scope":"cross_chapter","chapter_ids":["c-shiji-003-yin","c-shiji-033-lu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-003-yin:p024","quote":"帝祖庚崩，弟祖甲立，是為帝甲。帝甲淫亂，殷復衰。"},{"paragraph_id":"c-shiji-033-lu:p009","quote":"周公歸，恐成王壯，治有所淫佚，乃作多士，作毋逸。毋逸稱：『爲人父母，爲業至長久，子孫驕奢忘之，以亡其家，爲人子可不慎乎！筆昔在殷王中宗，嚴恭敬畏天命，自度治民，震懼不敢荒寧，故中宗饗國七十五年。其在髙宗，久勞于外，爲與小人，作其即位，乃有亮闇，三年不言，言乃讙，不敢荒寧，密靖殷國，至于小大無怨，故髙宗饗國五十五年。其在祖甲，不義惟王，久爲小人于外，知小人之依，能保施小民，不侮寡，故祖甲饗國三十三年。』多士稱曰：『自湯至于帝乙，無不率祀明德，帝無不配天者。在今後嗣王紂，誕淫厥佚，不顧天及民之從也。其民皆可誅。』『文王日中昃不暇食，饗國五十年。』作此以誡成王。"}],"rationale":"按周初封建、武庚管蔡之亂、殷王廟號與魯君世系的具體語境暫定異稱。周公魯公與伯禽魯公依段落角色分開，王發不把普通動詞發當人名，世系與祈禱敘事仍待版本覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-003-yin:p024","text":"帝祖庚崩，弟祖甲立，是為帝甲。帝甲淫亂，殷復衰。","mentions":[{"id":"c-shiji-003-yin:m024-0000","start":0,"end":3,"surface":"帝祖庚","kind":"person","person_id":"f41_iwq_mkl","status":"source_identified"},{"id":"c-shiji-003-yin:m024-0006","start":6,"end":8,"surface":"祖甲","kind":"person","person_id":"kfj_bhr_cdz","status":"source_identified"},{"id":"c-shiji-003-yin:m024-0012","start":12,"end":14,"surface":"帝甲","kind":"person","person_id":"kfj_bhr_cdz","status":"source_identified"},{"id":"c-shiji-003-yin:m024-0015","start":15,"end":17,"surface":"帝甲","kind":"person","person_id":"kfj_bhr_cdz","status":"source_identified"}],"chapter_id":"c-shiji-003-yin","book_id":"b-shiji-003","work_id":"w-shiji","source_id":"s-shiji-003-yin"},{"id":"c-shiji-003-yin:p025","text":"帝甲崩，子帝廩辛立。帝廩辛崩，弟庚丁立，是為帝庚丁。帝庚丁崩，子帝武乙立。殷復去亳，徙河北。","mentions":[{"id":"c-shiji-003-yin:m025-0000","start":0,"end":2,"surface":"帝甲","kind":"person","person_id":"kfj_bhr_cdz","status":"source_identified"},{"id":"c-shiji-003-yin:m025-0005","start":5,"end":8,"surface":"帝廩辛","kind":"person","person_id":"blx_v56_6o2","status":"source_identified"},{"id":"c-shiji-003-yin:m025-0010","start":10,"end":13,"surface":"帝廩辛","kind":"person","person_id":"blx_v56_6o2","status":"source_identified"},{"id":"c-shiji-003-yin:m025-0016","start":16,"end":18,"surface":"庚丁","kind":"person","person_id":"iop_qvt_un3","status":"source_identified"},{"id":"c-shiji-003-yin:m025-0022","start":22,"end":25,"surface":"帝庚丁","kind":"person","person_id":"iop_qvt_un3","status":"source_identified"},{"id":"c-shiji-003-yin:m025-0026","start":26,"end":29,"surface":"帝庚丁","kind":"person","person_id":"iop_qvt_un3","status":"source_identified"},{"id":"c-shiji-003-yin:m025-0032","start":32,"end":35,"surface":"帝武乙","kind":"person","person_id":"n51_9zm_sqh","status":"source_identified"}],"chapter_id":"c-shiji-003-yin","book_id":"b-shiji-003","work_id":"w-shiji","source_id":"s-shiji-003-yin"},{"id":"c-shiji-033-lu:p009","text":"周公歸，恐成王壯，治有所淫佚，乃作多士，作毋逸。毋逸稱：『爲人父母，爲業至長久，子孫驕奢忘之，以亡其家，爲人子可不慎乎！筆昔在殷王中宗，嚴恭敬畏天命，自度治民，震懼不敢荒寧，故中宗饗國七十五年。其在髙宗，久勞于外，爲與小人，作其即位，乃有亮闇，三年不言，言乃讙，不敢荒寧，密靖殷國，至于小大無怨，故髙宗饗國五十五年。其在祖甲，不義惟王，久爲小人于外，知小人之依，能保施小民，不侮寡，故祖甲饗國三十三年。』多士稱曰：『自湯至于帝乙，無不率祀明德，帝無不配天者。在今後嗣王紂，誕淫厥佚，不顧天及民之從也。其民皆可誅。』『文王日中昃不暇食，饗國五十年。』作此以誡成王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-033-lu:m009-0000","start":0,"end":2,"surface":"周公","kind":"person","person_id":"y4i_pjk_4gn_AD","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m009-0005","start":5,"end":7,"surface":"成王","kind":"person","person_id":"qna_m75_pj8","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m009-0031","start":31,"end":33,"surface":"父母","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或未定稱謂，少昊傳說稱呼未另核；不補姓名與成員。"},{"id":"c-shiji-033-lu:m009-0040","start":40,"end":42,"surface":"子孫","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或未定稱謂，少昊傳說稱呼未另核；不補姓名與成員。"},{"id":"c-shiji-033-lu:m009-0063","start":63,"end":67,"surface":"殷王中宗","kind":"person","person_id":"ta6_n0m_glj","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m009-0088","start":88,"end":90,"surface":"中宗","kind":"person","person_id":"ta6_n0m_glj","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m009-0099","start":99,"end":101,"surface":"髙宗","kind":"person","person_id":"cld_aan_e20","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m009-0149","start":149,"end":151,"surface":"髙宗","kind":"person","person_id":"cld_aan_e20","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m009-0160","start":160,"end":162,"surface":"祖甲","kind":"person","person_id":"kfj_bhr_cdz","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m009-0192","start":192,"end":194,"surface":"祖甲","kind":"person","person_id":"kfj_bhr_cdz","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m009-0209","start":209,"end":210,"surface":"湯","kind":"person","person_id":"tpz_x3m_e0h","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m009-0212","start":212,"end":214,"surface":"帝乙","kind":