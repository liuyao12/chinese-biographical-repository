{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p005193","canonical_person_id":"7mw_nab_5z6","id_aliases":["cbr-p005193"],"identity_policy":"contextual_provisional","person_ids":["7mw_nab_5z6"],"persons":[{"id":"7mw_nab_5z6","label":"淮陰（用稱）（韓信盧綰列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"淮陰","mention_ids":["c-shiji-093-hanlu:m011-0116"]}],"evidence":[{"mention_id":"c-shiji-093-hanlu:m011-0116","chapter_id":"c-shiji-093-hanlu","paragraph_id":"c-shiji-093-hanlu:p011","quote":"淮陰"}],"id_aliases":["cbr-p005193"]}],"source_mention_summary":[{"source_id":"s-shiji-093-hanlu","work_id":"w-shiji","book_id":"b-shiji-093","chapter_id":"c-shiji-093-hanlu","mention_count":1,"mention_ids":["c-shiji-093-hanlu:m011-0116"],"paragraph_ids":["c-shiji-093-hanlu:p011"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-093-hanlu"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-093-hanlu:m011-0116","start":116,"end":118,"surface":"淮陰","kind":"person","person_id":"7mw_nab_5z6","status":"contextual_provisional","paragraph_id":"c-shiji-093-hanlu:p011","chapter_id":"c-shiji-093-hanlu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji093-043","person_id":"7mw_nab_5z6","scope":"same_chapter","chapter_ids":["c-shiji-093-hanlu"],"status":"contextual_provisional","rationale":"明示姓名及局部敘事承接；引古、未名者及短稱另存候選。臧茶與臧荼、高后與呂后待跨稱判讀，不因近形或熟知姓名自動合併。","reviewer":"Codex（AI 代理）","surfaces":["淮陰"],"evidence":[{"paragraph_id":"c-shiji-093-hanlu:p011","quote":"漢十二年，東擊黥布，豨常將兵居代，漢使樊噲擊斬豨。其裨將降，言燕王綰使范齊通計謀於豨所。高祖使使召盧綰，綰稱病。上又使辟陽侯審食其、御史大夫趙堯往迎燕王，因驗問左右。綰愈恐，閉匿，謂其幸臣曰：「非劉氏而王，獨我與長沙耳。往年春，漢族淮陰，夏，誅彭越，皆呂后計。今上病，屬任呂后。呂后婦人，專欲以事誅異姓王者及大功臣。」乃遂稱病不行。其左右皆亡匿。語頗泄，辟陽侯聞之，歸具報上，上益怒。又得匈奴降者，降者言張勝亡在匈奴，為燕使。於是上曰：「盧綰果反矣！」使樊噲擊燕。燕王綰悉將其宮人家屬騎數千居長城下，侯伺，幸上病愈，自入謝。四月，高祖崩，盧綰遂將其眾亡入匈奴，匈奴以為東胡盧王。綰為蠻夷所侵奪，常思復歸。居歲餘，死胡中。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-093-hanlu:p011","text":"漢十二年，東擊黥布，豨常將兵居代，漢使樊噲擊斬豨。其裨將降，言燕王綰使范齊通計謀於豨所。高祖使使召盧綰，綰稱病。上又使辟陽侯審食其、御史大夫趙堯往迎燕王，因驗問左右。綰愈恐，閉匿，謂其幸臣曰：「非劉氏而王，獨我與長沙耳。往年春，漢族淮陰，夏，誅彭越，皆呂后計。今上病，屬任呂后。呂后婦人，專欲以事誅異姓王者及大功臣。」乃遂稱病不行。其左右皆亡匿。語頗泄，辟陽侯聞之，歸具報上，上益怒。又得匈奴降者，降者言張勝亡在匈奴，為燕使。於是上曰：「盧綰果反矣！」使樊噲擊燕。燕王綰悉將其宮人家屬騎數千居長城下，侯伺，幸上病愈，自入謝。四月，高祖崩，盧綰遂將其眾亡入匈奴，匈奴以為東胡盧王。綰為蠻夷所侵奪，常思復歸。居歲餘，死胡中。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-093-hanlu:m011-0007","start":7,"end":9,"surface":"黥布","kind":"person","person_id":"ehh_a65_95j","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m011-0010","start":10,"end":11,"surface":"豨","kind":"person","person_id":"k12_clz_joc","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m011-0019","start":19,"end":21,"surface":"樊噲","kind":"person","person_id":"wzh_9d5_a6v","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m011-0023","start":23,"end":24,"surface":"豨","kind":"person","person_id":"k12_clz_joc","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m011-0031","start":31,"end":34,"surface":"燕王綰","kind":"person","person_id":"jjl_irg_zke_A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m011-0035","start":35,"end":37,"surface":"范齊","kind":"person","person_id":"bz6_7ka_tht","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m011-0041","start":41,"end":42,"surface":"豨","kind":"person","person_id":"k12_clz_joc","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m011-0044","start":44,"end":46,"surface":"高祖","kind":"pe