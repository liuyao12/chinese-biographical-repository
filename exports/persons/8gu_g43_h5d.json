start":18,"end":21,"surface":"斛斯蘭","kind":"person","person_id":"8gu_g43_h5d","status":"contextual_provisional","paragraph_id":"c-songshu-051-suduozhen-husilan:p001","chapter_id":"c-songshu-051-suduozhen-husilan"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-songshu-047-menglongfu:p001","text":"龍符，懷玉弟也。驍果有膽氣，幹力絕人。少好游俠，結客於閭里。早為高祖所知，既克京城，以龍符為建武參軍。江乘、羅落、覆舟三戰，並有功。參鎮軍軍事，封平昌縣五等子，加寧遠將軍、淮陵太守。與劉藩、向彌征桓歆、桓石康，破斬之。除建威將軍、東海太守。索虜斛蘭、索度真侵邊，彭、沛騷擾，高祖遣龍符、建威將軍道憐北討，一戰破之。追斛蘭至光水溝邊，被創奔走。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":38,"last_line":38,"raw_start":3169,"raw_end":3340,"raw_character_offsets":[3169,3170,3171,3172,3173,3174,3175,3176,3177,3178,3179,3180,3181,3182,3183,3184,3185,3186,3187,3188,3189,3190,3191,3192,3193,3194,3195,3196,3197,3198,3199,3200,3201,3202,3203,3204,3205,3206,3207,3208,3209,3210,3211,3212,3213,3214,3215,3216,3217,3218,3219,3220,3221,3222,3223,3224,3225,3226,3227,3228,3229,3230,3231,3232,3233,3234,3235,3236,3237,3238,3239,3240,3241,3242,3243,3244,3245,3246,3247,3248,3249,3250,3251,3252,3253,3254,3255,3256,3257,3258,3259,3260,3261,3262,3263,3264,3265,3266,3267,3268,3269,3270,3271,3272,3273,3274,3275,3276,3277,3278,3279,3280,3281,3282,3283,3284,3285,3286,3287,3288,3289,3290,3291,3292,3293,3294,3295,3296,3297,3298,3299,3300,3301,3302,3303,3304,3305,3306,3307,3308,3309,3310,3311,3312,3313,3314,3315,3316,3317,3318,3319,3320,3321,3322,3323,3324,3325,3326,3327,3328,3329,3330,3331,3332,3333,3334,3335,3336,3337,3338,3339],"revision_id":2190557},"mentions":[{"id":"c-songshu-047-menglongfu:p001:m0000","start":0,"end":2,"surface":"龍符","kind":"person","person_id":"3ut_u0d_j6w_*AAA","status":"contextual_provisional"},{"id":"c-songshu-047-menglongfu:p001:m0003","start":3,"end":5,"surface":"懷玉","kind":"person","person_id":"zuf