y_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-sanguozhi-052-zhangzhao-complete:line022-pei01-01:reading-000-166","kind":"received_sentence","paragraph_id":"c-sanguozhi-052-zhangzhao-complete:line022-pei01-01","person_id":"8b2_aac_6d7","related_person_ids":["roi_rz4_ute","572_278_cba","y97_huh_vuz_AAAAA","6di_ywz_ju4_AAA","xxq_5y6_8sr"],"start_codepoint":0,"end_codepoint":166,"source_quote":"习凿齿曰：张昭於是乎不臣矣！夫臣人者，三谏不从则奉身而退，身苟不绝，何忿懟之有？且秦穆违谏，卒霸西戎，晋文暂怒，终成大业。遗誓以悔过见录，狐偃无怨绝之辞，君臣道泰，上下俱荣。今权悔往之非而求昭，后益回虑降心，不远而复，是其善也。昭为人臣，不度权得道，匡其后失，夙夜匪懈，以延来誉，乃追忿不用，归罪於君，闭户拒命，坐待焚灭，岂不悖哉！","reading":"習鑿齒評論廷諫與閉門。引秦穆公、晉文公、狐偃，屬於評者舉例。","chapter_id":"c-sanguozhi-052-zhangzhao-complete","source_id":"s-sanguozhi-052-zhangzhao-complete"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-028-wangling:unit004:m0220","start":220,"end":222,"surface":"習氏","kind":"person","person_id":"8b2_aac_6d7","status":"contextual_provisional","interpretation_note":"依本完整敘事與對話scope辨識，不用nearest規則。","paragraph_id":"c-sanguozhi-028-wangling:unit004","chapter_id":"c-sanguozhi-028-wangling"},{"id":"c-sanguozhi-028-wangling:unit004:m0233","start":233,"end":235,"surface":"鑿齒","kind":"person","person_id":"8b2_aac_6d7","status":"contextual_provisional","interpretation_note":"依本完整敘事與對話scope辨識，不用nearest規則。","paragraph_id":"c-sanguozhi-028-wangling:unit004","chapter_id":"c-sanguozhi-028-wangling"},{"id":"c-sanguozhi-028-wangling:unit004:m0236","start":236,"end":237,"surface":"自","kind":"person","person_id":"8b2_aac_6d7","status":"contextual_provisional","interpretation_note":"逐字句域判讀；非最近人物推定。","paragraph_id":"c-sanguozhi-028-wangling:unit004","chapter_id":"c-sanguozhi-028-wangling"},{"id":"c-sanguozhi-052-zhangzhao-complete:line022-pei01-01:m0000","start":0,"end":3