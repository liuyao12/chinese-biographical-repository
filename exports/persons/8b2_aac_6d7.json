rface":"習鑿齒","start":11,"end":14,"person_id":"8b2_aac_6d7","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-056-sun-chuo:p002:m0017","surface":"綽","start":17,"end":18,"person_id":"9c1_b3c_cb7","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-056-sun-chuo:p002:m0023","surface":"鑿齒","start":23,"end":25,"person_id":"8b2_aac_6d7","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-056-sun-chuo:p002:m0039","surface":"鑿齒","start":39,"end":41,"person_id":"8b2_aac_6d7","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-056-sun-chuo","book_id":"b-jinshu-056","work_id":"w-jinshu","source_id":"s-jinshu-056-sun-chuo-ws1557685"},{"id":"c-sanguozhi-028-wangling:unit004","text":"漢晉春秋曰凌愚謀以帝㓜制於彊臣不堪為主楚王彪長而才欲迎立之以興曹氏凌使人告廣廣曰凡舉大事應本人情今曹爽以驕奢失民何平叔虛而不治丁畢桓鄧雖並有宿望皆専競於世加變易朝典政令數改所存雖髙而事不下接民習於舊衆莫之從故雖勢傾四海聲震天下同日斬戮名士減半而百姓安之莫或之哀失民故也今懿情雖難量事未有逆而擢用賢能廣樹勝己脩先朝之政令副衆心之所求爽之所以為惡者彼莫不必改夙夜匪懈以恤民為先父子兄弟並握兵要未易亡也凌不從臣松之以為如此言之類皆前史所不載而獨出習氏且制言法體不似於昔疑悉鑿齒所自造者也","text_layer":"witness_appended_pei_songzhi_note","annotation_status":"in_progress","source_position":{"first_line":47,"last_line":54,"revision_id":"214fcafa79894355909c9d8c2c1533089e7791c6","source_layer":"pei_annotation","projection_sha256":"1084022ba656c49b4727bac9944d491ec2270e12b6fb05846f6831e60bf8a0c7","raw_character_positions":[{"line":47,"column":20},{"line":47,"column":21},{"line":47,"column":22},{"line":47,"column":23},{"line":48,"column":1},{"line":48,"column":2},{"line":48,"column":3},{"line":48,"column":4},{"line":48,"column":5},{"line":48,"column":6},{"line":48,"column":7},{"line":48,"column":8},{"line":48,"column":9},{"line":48,"column":10},{"line":48,"column":11},{"line":48,"column":12},{"line":48,"column":13},{"line":48,"column":14},{"line":48,"column":15},{"line":48,"column":16},{"line":48,"column":17},{"line":48,"column":18},{"line":48,"column":19},{"line":48,"column":20},{"line":48,"column":21},{"line":48,"column":22},{"line":48,"column":23},{"line":48,"column":24},{"line":48,