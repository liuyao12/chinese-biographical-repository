ice:m013-0073","start":73,"end":75,"surface":"豫且","kind":"person","person_id":"uiq_fxy_s78","status":"contextual_provisional","paragraph_id":"c-shiji-128-guice:p013","chapter_id":"c-shiji-128-guice"},{"id":"c-shiji-128-guice:m013-0092","start":92,"end":94,"surface":"豫且","kind":"person","person_id":"uiq_fxy_s78","status":"contextual_provisional","paragraph_id":"c-shiji-128-guice:p013","chapter_id":"c-shiji-128-guice"},{"id":"c-shiji-128-guice:m013-0105","start":105,"end":107,"surface":"豫且","kind":"person","person_id":"uiq_fxy_s78","status":"contextual_provisional","paragraph_id":"c-shiji-128-guice:p013","chapter_id":"c-shiji-128-guice"},{"id":"c-shiji-128-guice:m013-0156","start":156,"end":158,"surface":"豫且","kind":"person","person_id":"uiq_fxy_s78","status":"contextual_provisional","paragraph_id":"c-shiji-128-guice:p013","chapter_id":"c-shiji-128-guice"}],"relations":[],"title_holdings":[],"address_assertions":[{"id":"pa-shiji128-003","person_id":"uiq_fxy_s78","relation":"residence","place":{"source_name":"上流之廬","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-128-guice","source_id":"s-shiji128-guice","paragraph_id":"c-shiji-128-guice:p013","quote":"於是王乃使人馳而往問泉陽令曰：「漁者幾何家？名誰為豫且？豫且得龜，見夢於王，王故使我求之。」泉陽令乃使吏案籍視圖，水上漁者五十五家，上流之廬，名為豫且。泉陽令曰：「諾。」乃與使者馳而問豫且曰：「今昔汝漁何得？」豫且曰：「夜半時舉網得龜。」使者曰：「今龜安在？」曰：「在籠中。」使者曰：「王知子得龜，故使我求之。」豫且曰：「諾。」即繋龜而出之籠中，獻使者。"}],"source_term":"水上漁者五十五家，上流之廬，名為豫且","interpretation_note":"住所依原句上流之廬保存，泉陽背景保留於同段證據，不拼接原文沒有的地名，不推現代轄區。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-128-guice:p012","text":"宋元王二年，江使神龜使於河，至於泉陽，漁者豫且舉網得而囚之。置之籠中。夜半，龜來見夢於宋元王曰：「我為江使於河，而幕網當吾路。泉陽豫且得我，我不能去。身在患中，莫可告語。王有德義，故來告訴。」元王惕然而悟。乃召博士衛平而問之曰：「今寡人夢見一丈夫，延頸而長頭，衣玄繡之衣而乘輜車，來見夢於寡人曰：『我為江使於河，而幕網當吾路。泉陽豫且得我，我不能去。身在患中，莫可告語。王有德義，故來告訴。』是何物也？」衛平乃援式而起，仰天而視月之光，觀斗所指，定日處鄉。規矩為輔，副以權衡。四維已定，八卦相望。視其吉凶，介蟲先見。乃對元王曰：「今昔壬子，宿在牽牛。河水大會，鬼神相謀。漢正南北，江河固期，南風新至，江使先來。白雲壅漢，萬物盡留。斗柄指日，使者當囚。玄服而乘輜車，其名為龜。王急使人問而求之。」王曰：「善。」","annotation_status":"in_progress","text_layer":"witness_appended_chu_note","mentions":[{"id":"c-shiji-128-guice:m012-0000","start":0,"end":3,"surface":"宋元王","kind":"person","person_id":"a4t_7hv_0s6","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m012-0008","start":8,"end":10,"surface":"神龜","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-128-guice:m012-0021","start":21,"end":23,"surface":"豫且","kind":"person","person_id":"uiq_fxy_s78","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m012-0043","start":43,"end":46,"surface":"宋元王","kind":"person","person_id":"a4t_7hv_0s6","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m012-0065","start":65,"end":67,"surface":"豫且","kind":"person","person_id":"uiq_fxy_s78","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m012-0096","start":96,"end":98,"surface":"元王","kind":"person","person_id":"a4t_7hv_0s6","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m012-0107","start":107,"end":109,"surface":"衛平","kind":"person","person_id":"p27_7v5_rgy","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m012-0165","start":165,"end":167,"surface":"豫且","kind":"person","person_id":"uiq_fxy_s78","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m012-0202","start":202,"end":204,"surface":"衛平","kind":"person","person_id":"p27_7v5_rgy","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m012-0260","start":260,"end":262,"surface":"元王","kind":"person","person_id":"a4t_7hv_0s6","status":"contextual_provisional"}],"chapter_id":"c-shiji-128-guice","book_id":"b-shiji-128","work_id":"w-shiji","source_id":"s-shiji128-guice"},{"id":"c-shiji-128-guice:p013","text":"於是王乃使人馳而往問泉陽令曰：「漁者幾何家？名誰為豫且？豫且得龜，見夢於王，王故使我求之。」泉陽令乃使吏案籍視圖，水上漁者五十五家，上流之廬，名為豫且。泉陽令曰：「諾。」乃與使者馳而問豫且曰：「今昔汝漁何得？」豫且曰：「夜半時舉網得龜。」使者曰：「今龜安在？」曰：「在籠中。」使者曰：「王知子得龜，故使我求之。」豫且曰：「諾。」即繋龜而出之籠中，獻使者。","annotation_status":"in_progress","text_layer":"witness_appended_chu_note","mentions":[{"id":"c-shiji-128-guice:m013-0002","start":2,"end":3,"surface":"王","kind":"person","person_id":"a4t_7hv_0s6","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m013-0010","start":10,"end":13,"surface":"泉陽令","kind":"person","person_id":"4sb_h3r_tey","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m013-0025","start":25,"end":27,"surface":"豫且","kind":"person","person_id":"uiq_fxy_s78","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m013-0028","start":28,"end":30,"surface":"豫且","kind":"person","person_id":"uiq_fxy_s78","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m013-0036","start":36,"end":37,"surface":"王","kind":"person","person_id":"a4t_7hv_0s6","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m013-0038","start":38,"end":39,"surface":"王","kind":"person","person_id":"a4t_7hv_0s6","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m013-0046","start":46,"end":49,"surface":"泉陽令","kind":"person","person_id":"4sb_h3r_tey","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m013-0073","start":73,"end":75,"surface":"豫且","kind":"person","person_id":"uiq_fxy_s78","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m013-0076","start":76,"end":79,"surface":"泉陽令","kind":"person","person_id":"4sb_h3r_tey","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m013-0087","start":87,"end":89,"surface":"使者","kind":"person","person_id":"ywc_x00_1rh","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m013-0092","start":92,"end":94,"surface":"豫且","kind":"person","person_id":"uiq_fxy_s78","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m013-0105","start":105,"end":107,"surface":"豫且","kind":"person","person_id":"uiq_fxy_s78","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m013-0119","start":119,"end":121,"surface":"使者","kind":"person","person_id":"ywc_x00_1rh","s