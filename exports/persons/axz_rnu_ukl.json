{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"axz_rnu_ukl","canonical_person_id":"axz_rnu_ukl","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["axz_rnu_ukl"],"persons":[{"id":"axz_rnu_ukl","label":"汲桑","status":"active","historicity":"historical_tradition","aliases":[{"surface":"汲桑","mention_ids":["c-jinshu-059-wei-ying-children:p002:m0017"]}],"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-059","source_id":"s-jinshu-059-ws2650517-wei-ying-children","chapter_id":"c-jinshu-059-wei-ying-children","paragraph_id":"c-jinshu-059-wei-ying-children:p002","mention_id":"c-jinshu-059-wei-ying-children:p002:m0017","quote":"汲桑"}],"review":"ai_provisional"}],"source_mention_summary":[{"source_id":"s-jinshu-059-ws2650517-wei-ying-children","work_id":"w-jinshu","book_id":"b-jinshu-059","chapter_id":"c-jinshu-059-wei-ying-children","raw_mention_count":1,"mention_ids":["c-jinshu-059-wei-ying-children:p002:m0017"],"paragraph_ids":["c-jinshu-059-wei-ying-children:p002"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-059-wei-ying-children:p002:m0017","mention_ids":["c-jinshu-059-wei-ying-children:p002:m0017"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-059-ws2650517-wei-ying-children"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"id":"name-jin059-wei-ying-children-jisang","person_id":"axz_rnu_ukl","surname":"汲","ming":"桑","additional_names":[],"chapter_id":"c-jinshu-059-wei-ying-children","paragraph_id":"c-jinshu-059-wei-ying-children:p002","person_mention_id":"c-jinshu-059-wei-ying-children:p002:m0017","source_anchor":{"paragraph_id":"c-jinshu-059-wei-ying-children:p002","start":17,"end":19,"surface":"汲桑"},"quote":"穎既廢，河北思之。鄴中故將公師籓、汲桑等起兵以迎穎，眾情翕然。顒復拜穎鎮軍大將軍、都督河北諸軍事，給兵千人，鎮鄴。穎至洛，而東海王越率眾迎大駕，所在鋒起。穎以北方盛強，懼不可進，自洛陽奔關中。值大駕還洛，穎自華陰趨武關，出新野。帝詔鎮南將軍劉弘、南中郎將劉陶收捕穎，於是棄母妻，單車與二子廬江王普、中都王廓渡河赴朝歌，收合故將士數百人，欲就公師籓。頓丘太守馮嵩執穎及普、廓送鄴，范陽王虓幽之，而無他意。屬虓暴薨，虓長史劉輿見穎為鄴都所服，慮為後患，秘不發喪，偽令人為臺使，稱詔夜賜穎死。穎謂守者田徽曰：「范陽王亡乎？」徽曰：「不知。」穎曰：「卿年幾？」徽曰：「五十。」穎曰：「知天命不？」徽曰：「不知。」穎曰：「我死之後，天下安乎不安乎？我自放逐，於今三年，身體手足不見洗沐，取數斗湯來！」其二子號泣，穎敕人將去。乃散發東首臥，命徽縊之，時年二十八。二子亦死。鄴中哀之。","status":"contextual_provisional","human_reviewed":false,"model":null,"work_id":"w-jinshu","book_id":"b-jinshu-059","source_id":"s-jinshu-059-ws2650517-wei-ying-children"}],"mentions":[{"id":"c-jinshu-059-wei-ying-children:p002:m0017","start":17,"end":19,"surface":"汲桑","kind":"person","person_id":"axz_rnu_ukl","status":"contextual_provisional","source_role":"jisang","paragraph_id":"c-jinshu-059-wei-ying-children:p002","chapter_id":"c-jinshu-059-wei-ying-children"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-059-wei-ying-children:p002","text":"穎既廢，河北思之。鄴中故將公師籓、汲桑等起兵以迎穎，眾情翕然。顒復拜穎鎮軍大將軍、都督河北諸軍事，給兵千人，鎮鄴。穎至洛，而東海王越率眾迎大駕，所在鋒起。穎以北方盛強，懼不可進，自洛陽奔關中。值大駕還洛，穎自華陰趨武關，出新野。帝詔鎮南將軍劉弘、南中郎將劉陶收捕穎，於是棄母妻，單車與二子廬江王普、中都王廓渡河赴朝歌，收合故將士數百人，欲就公師籓。頓丘太守馮嵩執穎及普、廓送鄴，范陽王虓幽之，而無他意。屬虓暴薨，虓長史劉輿見穎為鄴都所服，慮為後患，秘不發喪，偽令人為臺使，稱詔夜賜穎死。穎謂守者田徽曰：「范陽王亡乎？」徽曰：「不知。」穎曰：「卿年幾？」徽曰：「五十。」穎曰：「知天命不？」徽曰：「不知。」穎曰：「我死之後，天下安乎不安乎？我自放逐，於今三年，身體手足不見洗沐，取數斗湯來！」其二子號泣，穎敕人將去。乃散發東首臥，命徽縊之，時年二十八。二子亦死。鄴中哀之。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","source_position":{"raw_start":16697,"raw_end":17084,"raw_line":163,"wikitext_sha256":"a83fe708c8dffc5965863d337a19fd4e7222ae41e29aa99e1c2a11ed8030d1d3"},"mentions":[{"id":"c-jinshu-059-wei-ying-children:p002:m0000","start":0,"end":1,"surface":"穎","kind":"person","person_id":"dkn_ge4_286_AAAAIAC","status":"contextual_provisional","source_role":"ying"},{"id":"c-jinshu-059-wei-ying-children:p002:m0013","start":13,"end":16,"surface":"公師籓","kind":"person","person_id":"xmp_cnb_pvt","status":"contextual_provisional","source_role":"gongshifan"},{"id":"c-jinshu-059-wei-ying-children:p002:m0017","start":17,"end":19,"surface":"汲桑","kind":"person","person_id":"axz_rnu_ukl","status":"contextual_provisional","source_role":"jisang"},{"id":"c-jinshu-059-wei-ying-children:p002:m0024","start":24,"end":25,"surface":"穎","kind":"person","person_id":"dkn_ge4_286_AAAAIAC","status":"contextual_provisional","source_role":"ying"},{"id":"c-jinshu-059-wei-ying-children:p002:m0031","start":31,"end":32,"surface":"顒","kind":"person","person_id":"ed0_313_bea","status":"contextual_provisional","source_role":"yong"},{"id":"c-jinshu-059-wei-ying-children:p002:m0034","start":34,"end":35,"surface":"穎","kind":"person","person_id":"dkn_ge4_286_AAAAIAC","status":"contextual_provisional","source_role":"ying"},{"id":"c-jinshu-059-wei-ying-children:p002:m0057","start":57,"end":58,"surface":"穎","kind":"person","person_id":"dkn_ge4_286_AAAAIAC","status":"contextual_provisional","source_role":"ying"},{"id":"c-jinshu-059-wei-ying-children:p002:m0062","start":62,"end":66,"surface":"東海王越","kind":"person","person_id":"dkn_ge4_286_AAADBA","status":"contextual_provisional","source_role":"yue"},{"id":"c-jinshu-059-wei-ying-children:p002:m0069","start":69,"end":71,"surface":"大駕","kind":"person","person_id":