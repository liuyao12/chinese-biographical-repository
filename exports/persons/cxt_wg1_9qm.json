w-shiji","source_id":"s-shiji-100-jibu"},{"id":"c-shiji-100-jibu:p006","text":"季布母弟丁公，爲楚將。丁公爲項羽逐窘髙祖彭城西，短兵接，髙祖急，顧丁公曰：「兩賢豈相戹哉！」於是丁公引兵而還，漢王遂解去。及項王滅，丁公謁見髙祖。髙祖以丁公徇軍中，曰：「丁公爲項王臣不忠，使項王失天下者，乃丁公也。」遂斬丁公，曰：「使後世爲人臣者無效丁公！」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-100-jibu:m006-0000","start":0,"end":2,"surface":"季布","kind":"person","person_id":"udu_dyy_4wd","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m006-0004","start":4,"end":6,"surface":"丁公","kind":"person","person_id":"7ul_aeb_w4e","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m006-0011","start":11,"end":13,"surface":"丁公","kind":"person","person_id":"7ul_aeb_w4e","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m006-0014","start":14,"end":16,"surface":"項羽","kind":"person","person_id":"cxt_wg1_9qm","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m006-0018","start":18,"end":20,"surface":"髙祖","kind":"person","person_id":"r5s_fud_iv8","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m006-0028","start":28,"end":30,"surface":"髙祖","kind":"person","person_id":"r5s_fud_iv8","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m006-0033","start":33,"end":35,"surface":"丁公","kind":"person","person_id":"7ul_aeb_w4e","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m006-0048","start":48,"end":50,"surface":"丁公","kind":"person","person_id":"7ul_aeb_w4e","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m006-0055","start":55,"end":57,"surface":"漢王","kind":"person","person_id":"r5s_fud_iv8","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m006-0062","start":62,"end":64,"surface":"項王","kind":"person","person_id":"cxt_wg1_9qm","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m006-0066","start":66,"end":68,"surface":"丁公","kind":"person","person_id":"7ul_aeb_w4e","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m006-0070","start":70,"end":72,"surface":"髙祖","kind":"person","person_id":"r5s_fud_iv8","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m006-0073","start":73,"end":75,"surface":"髙祖","kind":"person","person_id":"r5s_fud_iv8","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m006-0076","start":76,"end":78,"surface":"丁公","kind":"person","person_id":"7ul_aeb_w4e","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m006-0085","start":85,"end":87,"surface":"丁公","kind":"person","person_id":"7ul_aeb_w4e","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m006-0088","start":88,"end":90,"surface":"項王","kind":"person","person_id":"cxt_wg1_9qm","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m006-0095","start":95,"end":97,"surface":"項王","kind":"person","person_id":"cxt_wg1_9qm","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m006-0103","start":103,"end":105,"surface":"丁公","kind":"person","person_id":"7ul_aeb_w4e","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m006-0110","start":110,"end":112,"surface":"丁公","kind":"person","person_id":"7ul_aeb_w4e","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m006-0125","start":125,"end":127,"surface":"丁公","kind":"person","person_id":"7ul_aeb_w4e","status":"contextual_provisional"}],"chapter_id":"c-shiji-100-jibu","book_id":"b-shiji-100","work_id":"w-shiji","source_id":"s-shiji-100-jibu"},{"id":"c-shiji-100-jibu:p008","text":"使於齊，未還，漢召彭越，責以謀反，夷三族。已而梟彭越頭於雒陽下，詔曰：「有敢收視者，輒捕之。」布從齊還，奏事彭越頭下，祠而哭之。吏捕布以聞。上召布，罵曰：「若與彭越反邪？吾禁人勿收，若獨祠而哭之，與越反明矣。趣亨之。」方提趣湯，布顧曰：「願一言而死。」上曰：「何言？」布曰：「方上之困於彭城，敗滎陽、成皋閒，項王所以（遂）不能［遂］西，徒以彭王居梁地，與漢合從苦楚也。當是之時，彭王一顧，與楚則漢破，與漢而楚破。且垓下之會，微彭王，項氏不亡。天下已定，彭王剖符受封，亦欲傳之萬世。今陛下一徵兵於梁，彭王病不行，而陛下疑以爲反，反形未見，以苛小案誅滅之，臣恐功臣人人自危也。今彭王已死，臣生不如死，請就亨。」於是上乃釋布罪，拜爲都尉。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-100-jibu:m008-0009","start":9,"end":11,"surface":"彭越","kind":"person","person_id":"j8g_yef_isr","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m008-0024","start":24,"end":26,"surface":"彭越","kind":"person","person_id":"j8g_yef_isr","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m008-0047","start":47,"end":48,"surface":"布","kind":"person","person_id":"jx9_cov_qe0","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m008-0054","start":54,"end":56,"surface":"彭越","kind":"person","person_id":"j8g_yef_isr","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m008-0066","start":66,"end":67,"surface":"布","kind":"person","person_id":"jx9_cov_qe0","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m008-0072","start":72,"end":73,"surface":"布","kind":"person","person_id":"jx9_cov_qe0","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m008-0080","start":80,"end":82,"surface":"彭越","kind":"person","person_id":"j8g_yef_isr","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m008-0099","start":99,"end":100,"surface":"越","kind":"person","person_id":"j8g_yef_isr","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m008-0114","start":114,"end":115,"surface":"布","kind":"person","person_id":"jx9_cov_qe0","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m008-0134","start":134,"end":135,"surface":"布","kind":"person","person_id":"jx9_cov_qe0","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m008-0154","start":154,"end":156,"surface":"項王","kind":"person","person_id":"cxt_wg1_9qm","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m008-0170","start":170,"end":172,"surface":"彭王","kind":"person","person_id":"j8g_yef_isr","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m008-0189","start":189,"end":191,"surface":"彭王","kind":"person","person_id":"j8g_yef_isr","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m008-0213","start":213,"end":215,"surface":"彭王","kind":"person","person_id":"j8g_yef_isr","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m008-0226","start":226,"end":228,"surface":"彭王","kind":"person","person_id":"j8g_yef_isr","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m008-0249","start":249,"end":251,"surface":"彭王","kind":"person","person_id":"j8g_yef_isr","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m008-0287","start":287,"end":289,"surface":"彭王","kind":"person","person_id":"j8g_yef_isr","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m008-0308","start":308,"end":309,"surface":"布","kind":"person","person_id":"jx9_cov_qe0","status":"contextual_provisional"}],"chapter_id":"c-shiji-100-jibu","book_id":"b-shiji-100","work_id":"w-shiji","source_id":"s-shiji-100-jibu"},{"id":"c-shiji-100-jibu:p011","text":"太史公曰：以項羽之氣，而季布以勇顯於楚，身屨（典）軍搴旗者數矣，可謂壯士。然至被刑戮，爲人奴而不死，何其下也！彼必自負其材，故受辱而不羞，欲有所用其未足也，故終爲漢名將。賢者誠重其死。夫婢妾賤人感慨而自殺者，非能勇也，其計畫無復之耳。欒布哭彭越，趣湯如歸者，彼誠知所處，不自重其死。雖往古烈士，何以加哉！","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-100-jibu:m011-0000","start":0,"end":3,"surface":"太史公","kind":"person","person_id":"nuz_py4_4la","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m011-0006","start":6,"end":8,"surface":"項羽","kind":"person","person_id":"cxt_wg1_9qm","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m011-0012","start":12,"end":14,"surface":"季布","kind":"person","person_id":"udu_dyy_4wd","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m011-0093","start":93,"end":97,"surface":"婢妾賤人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、合稱或待辨匿名指代，不補成員。"},{"id":"c-shiji-100-jibu:m011-0117","start":117,"end":119,"surface":"欒布","kind":"person","person_id":"jx9_cov_qe0","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m011-0120","start":120,"end":122,"surface":"彭越","kind":"person","person_id":"j8g_yef_isr","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m011-0142","start":142,"end":146,"surface":"往古烈士","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、合稱或待辨匿名指代，不補成員。"}],"chapter_id":"c-shiji-100-jibu","book_id":"b-shiji-100","work_id":"w-shiji","source_id":