-lu:p023","chapter_id":"c-shiji-033-lu"},{"id":"c-shiji-033-lu:m023-0006","start":6,"end":8,"surface":"武公","kind":"person","person_id":"cbr-p000214","status":"contextual_provisional","paragraph_id":"c-shiji-033-lu:p023","chapter_id":"c-shiji-033-lu"},{"id":"c-shiji-033-lu:m023-0194","start":194,"end":196,"surface":"武公","kind":"person","person_id":"cbr-p000214","status":"contextual_provisional","paragraph_id":"c-shiji-033-lu:p023","chapter_id":"c-shiji-033-lu"}],"relations":[{"id":"a-shiji033-011","subject_person_id":"cbr-p001224","predicate":"father","object_person_id":"cbr-p000214","status":"source_attested","evidence":[{"chapter_id":"c-shiji-033-lu","source_id":"s-shiji-033-lu","paragraph_id":"c-shiji-033-lu:p023","quote":"武公九年春，武公與長子括，少子戲，西朝周宣王。宣王愛戲，欲立戲爲魯太子。周之樊仲山父諫宣王曰：『廢長立少，不順；不順，必犯王命；犯王命，必誅之：故出令不可不順也。令之不行，政之不立；行而不順，民將棄上。夫下事上，少事長，所以爲順。今天子建諸矦，立其少，是教民逆也。若魯從之，諸矦效之，王命將有所壅；若弗從而誅之，是自誅王命也。誅之亦失，不誅亦失，王其圖之。』宣王弗聽，卒立戲爲魯太子。夏，武公歸而卒，戲立，是爲懿公。"}],"qualifiers":{"source_term":"長子","historicity":"historical_tradition"},"interpretation_note":"只錄本篇明示父親、兄弟與父系叔父；不從繼位、祭祀祈禱或未錄文字補父子、闕代及姓名。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji033-012","subject_person_id":"cbr-p001225","predicate":"father","object_person_id":"cbr-p000214","status":"source_attested","evidence":[{"chapter_id":"c-shiji-033-lu","source_id":"s-shiji-033-lu","paragraph_id":"c-shiji-033-lu:p023","quote":"武公九年春，武公與長子括，少子戲，西朝周宣王。宣王愛戲，欲立戲爲魯太子。周之樊仲山父諫宣王曰：『廢長立少，不順；不順，必犯王命；犯王命，必誅之：故出令不可不順也。令之不行，政之不立；行而不順，民將棄上。夫下事上，少事長，所以爲順。今天子建諸矦，立其少，是教民逆也。若魯從之，諸矦效之，王命將有所壅；若弗從而誅之，是自誅王命也。誅之亦失，不誅亦失，王其圖之。』宣王弗聽，卒立戲爲魯太子。夏，武公歸而卒，戲立，是爲懿公。"}],"qualifiers":{"source_term":"少子","historicity":"historical_tradition"},"interpretation_note":"只錄本篇明示父親、兄弟與父系叔父；不從繼位、祭祀祈禱或未錄文字補父子、闕代及姓名。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji033-024","person_id":"cbr-p000214","surfaces":["武公"],"scope":"cross_chapter","chapter_ids":["c-shiji-004-zhou","c-shiji-033-lu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-004-zhou:p036","quote":"召公、周公二相行政，號曰「共和」。共和十四年，厲王死于彘。太子靜長於召公家，二相乃共立之為王，是為宣王。宣王即位，二相輔之，修政，法文、武、成、康之遺風，諸侯復宗周。十二年，魯武公來朝。"},{"paragraph_id":"c-shiji-033-lu:p023","quote":"武公九年春，武公與長子括，少子戲，西朝周宣王。宣王愛戲，欲立戲爲魯太子。周之樊仲山父諫宣王曰：『廢長立少，不順；不順，必犯王命；犯王命，必誅之：故出令不可不順也。令之不行，政之不立；行而不順，民將棄上。夫下事上，少事長，所以爲順。今天子建諸矦，立其少，是教民逆也。若魯從之，諸矦效之，王命將有所壅；若弗從而誅之，是自誅王命也。誅之亦失，不誅亦失，王其圖之。』宣王弗聽，卒立戲爲魯太子。夏，武公歸而卒，戲立，是爲懿公。"}],"rationale":"按周初封建、武庚管蔡之亂、殷王廟號與魯君世系的具體語境暫定異稱。周公魯公與伯禽魯公依段落角色分開，王發不把普通動詞發當人名，世系與祈禱敘事仍待版本覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-004-zhou:p036","text":"召公、周公二相行政，號曰「共和」。共和十四年，厲王死于彘。太子靜長於召公家，二相乃共立之為王，是為宣王。宣王即位，二相輔之，修政，法文、武、成、康之遺風，諸侯復宗周。十二年，魯武公來朝。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-004-zhou:m036-0000","start":0,"end":2,"surface":"召公","kind":"person","person_id":"cbr-p000211","status":"source_identified"},{"id":"c-shiji-004-zhou:m036-0003","start":3,"end":5,"surface":"周公","kind":"person","person_id":"cbr-p000212","status":"source_identified"},{"id":"c-shiji-004-zhou:m036-0005","start":5,"end":7,"surface":"二相","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官號或文字疑讀；保留錨點，不補熟知姓名或假定同指。"},{"id":"c-shiji-004-zhou:m036-0023","start":23,"end":25,"surface":"厲王","kind":"person","person_id":"cbr-p000208","status":"source_identified"},{"id":"c-shiji-004-zhou:m036-0029","start":29,"end":32,"surface":"太子靜","kind":"person","person_id":"cbr-p000213","status":"source_identified"},{"id":"c-shiji-004-zhou:m036-0034","start":34,"end":36,"surface":"召公","kind":"person","person_id":"cbr-p000211","status":"source_identified"},{"id":"c-shiji-004-zhou:m036-0038","start":38,"end":40,"surface":"二相","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官號或文字疑讀；保留錨點，不補熟知姓名或假定同指。"},{"id":"c-shiji-004-zhou:m036-0049","start":49,"end":51,"surface":"宣王","kind":"person","person_id":"cbr-p000213","status":"source_identified"},{