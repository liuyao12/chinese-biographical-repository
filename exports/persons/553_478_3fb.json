0,"raw_end":21,"text":"器仗振旅而還王基州㤗皆有功於是遷昶征南大將"},{"line":250,"raw_start":0,"raw_end":21,"text":"軍儀同三司進封京陵侯毌邱儉文欽作亂引兵拒儉"},{"line":251,"raw_start":0,"raw_end":21,"text":"欽有功封二子亭侯關内侯進位驃騎將軍諸葛誕反"},{"line":252,"raw_start":0,"raw_end":21,"text":"昶據夾石以逼江陵持施績全熙使不得東誕既誅詔"},{"line":253,"raw_start":0,"raw_end":21,"text":"曰昔孫臏佐趙直湊大梁西兵驟進亦所以成東征之"},{"line":254,"raw_start":0,"raw_end":21,"text":"勢也増邑千戸并前四千七百户遷司空持節都督如"},{"line":255,"raw_start":0,"raw_end":21,"text":"故甘露四年薨諡曰穆侯子渾嗣咸熙中為越騎校尉"}],"source_layer":"received_biography"},"mentions":[{"id":"c-sanguozhi-027-wangchang:unit017:m0010","start":10,"end":11,"surface":"汝","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"未決指稱；不以最近人物、同姓或同名強配。"},{"id":"c-sanguozhi-027-wangchang:unit017:m0083","start":83,"end":84,"surface":"吾","kind":"person","person_id":"a8f_ec8_e74_A","status":"contextual_provisional","interpretation_note":"依本完整敘事與固定平行語境辨識；原稱保留。"},{"id":"c-sanguozhi-027-wangchang:unit017:m0153","start":153,"end":159,"surface":"太尉司馬宣王","kind":"person","person_id":"dkn_ge4_286_AAAA","status":"contextual_provisional","interpretation_note":"依本完整敘事與固定平行語境辨識；原稱保留。"},{"id":"c-sanguozhi-027-wangchang:unit017:m0160","start":160,"end":161,"surface":"昶","kind":"person","person_id":"a8f_ec8_e74_A","status":"contextual_provisional","interpretation_note":"依本完整敘事與固定平行語境辨識；原稱保留。"},{"id":"c-sanguozhi-027-wangchang:unit017:m0189","start":189,"end":190,"surface":"昶","kind":"person","person_id":"a8f_ec8_e74_A","status":"contextual_provisional","interpretation_note":"依本完整敘事與固定平行語境辨識；原稱保留。"},{"id":"c-sanguozhi-027-wangchang:unit017:m0255","start":255,"end":261,"surface":"太傅司馬宣王","kind":"person","person_id":"dkn_ge4_286_AAAA","status":"contextual_provisional","interpretation_note":"依本完整敘事與固定平行語境辨識；原稱保留。"},{"id":"c-sanguozhi-027-wangchang:unit017:m0263","start":263,"end":265,"surface":"曹爽","kind":"person","person_id":"30k_jzz_tpd_AA","status":"contextual_provisional","interpretation_note":"依本完整敘事與固定平行語境辨識；原稱保留。"},{"id":"c-sanguozhi-0