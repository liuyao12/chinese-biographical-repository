{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000726","identity_policy":"contextual_provisional","person_ids":["cbr-p000726"],"persons":[{"id":"cbr-p000726","label":"鄭忠","status":"active","historicity":"historical_tradition","aliases":[{"surface":"鄭忠","mention_ids":["c-shiji-007-xiangyu:m032-0041","c-shiji-008-gaozu:m043-0093"]}],"evidence":[{"mention_id":"c-shiji-007-xiangyu:m032-0041","chapter_id":"c-shiji-007-xiangyu","paragraph_id":"c-shiji-007-xiangyu:p032","quote":"鄭忠"},{"mention_id":"c-shiji-008-gaozu:m043-0093","chapter_id":"c-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p043","quote":"鄭忠"}]}],"mentions":[{"id":"c-shiji-007-xiangyu:m032-0041","start":41,"end":43,"surface":"鄭忠","kind":"person","person_id":"cbr-p000726","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p032","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-008-gaozu:m043-0093","start":93,"end":95,"surface":"鄭忠","kind":"person","person_id":"cbr-p000726","status":"contextual_provisional","paragraph_id":"c-shiji-008-gaozu:p043","chapter_id":"c-shiji-008-gaozu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji008-070","person_id":"cbr-p000726","surfaces":["鄭忠"],"scope":"cross_chapter","chapter_ids":["c-shiji-007-xiangyu","c-shiji-008-gaozu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-007-xiangyu:p032","quote":"是時，彭越渡河擊楚東阿，殺楚將軍薛公。項王乃自東擊彭越。漢王得淮陰侯兵，欲渡河南。鄭忠說漢王，乃止壁河內。使劉賈將兵佐彭越，燒楚積聚。項王東擊破之，走彭越。漢王則引兵渡河，復取成皋，軍廣武，就敖倉食。項王已定東海來，西，與漢俱臨廣武而軍，相守數月。"},{"paragraph_id":"c-shiji-008-gaozu:p043","quote":"漢王跳，獨與滕公共車出成皋玉門，北渡河，馳宿修武。自稱使者，晨馳入張耳、韓信壁，而奪之軍。乃使張耳北益收兵趙地，使韓信東擊齊。漢王得韓信軍，則復振。引兵臨河，南饗軍小修武南，欲復戰。郎中鄭忠乃說止漢王，使高壘深塹，勿與戰。漢王聽其計，使盧綰、劉賈將卒二萬人，騎數百，渡白馬津，入楚地，與彭越復擊破楚軍燕郭西，遂復下梁地十餘城。"}],"rationale":"僅在所列漢初戰事、分封與家族敘事內暫定同指；前卷對讀須依相接事件，不據同名全域合併，仍待異源覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-007-xiangyu:p032","text":"是時，彭越渡河擊楚東阿，殺楚將軍薛公。項王乃自東擊彭越。漢王得淮陰侯兵，欲渡河南。鄭忠說漢王，乃止壁河內。使劉賈將兵佐彭越，燒楚積聚。項王東擊破之，走彭越。漢王則引兵渡河，復取成皋，軍廣武，就敖倉食。項王已定東海來，西，與漢俱臨廣武而軍，相守數月。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-007-xiangyu:m032-0003","start":3,"end":5,"surface":"彭越","kind":"person","person_id":"cbr-p000707","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m032-0016","start":16,"end":18,"surface":"薛公","kind":"person","person_id":"cbr-p000725","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m032-0019","start":19,"end":21,"surface":"項王","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m032-0025","start":25,"end":27,"surface":"彭越","kind":"person","person_id":"cbr-p000707","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m032-0028","start":28,"end":30,"surface":"漢王","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m032-0031","start":31,"end":34,"surface":"淮陰侯","kind":"person","person_id":"cbr-p000724","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m032-0041","start":41,"end":43,"surface":"鄭忠","kind":"person","person_id":"cbr-p000726","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m032-0044","start":44,"end":46,"surface":"漢王","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m032-0054","start":54,"end":56,"surface":"劉賈","kind":"person","person_id":"cbr-p000727","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m032-0059","start":59,"end":61,"surface":"彭越","kind":"person","person_id":"cbr-p000707","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m032-0067","start":67,"end":69,"surface":"項王","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m032-0075","start":75,"end":77,"surface":"彭越","kind":"person","person_id":"cbr-p000707","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m032-0078","start":78,"end":80,"surface":"漢王","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m032-0100","start":100,"end":102,"surface":"項王","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m032-0111","start":111,"end":112,"surface":"漢","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、匿名者、群體、動物或未定指代保留待核；不補姓名、闕代或個別成員。"}],"chapter_id":"c-shiji-007-xiangyu","book_id":"b-shiji-007","work_id":"w-shiji","source_id":"s-shiji-007-xiangyu"},{"id":"c-shiji-008-gaozu:p043","text":"漢王跳，獨與滕公共車出成皋玉門，北渡河，馳宿修武。自稱使者，晨馳入張耳、韓信壁，而奪之軍。乃使張耳北益收兵趙地，使韓信東擊齊。漢王得韓信軍，則復振。引兵臨河，南饗軍小修武南，欲復戰。郎中鄭忠乃說止漢王，使高壘深塹，勿與戰。漢王聽其計，使盧綰、劉賈將卒二萬人，騎數百，渡白馬津，入楚地，與彭越復擊破楚軍燕郭西，遂復下梁地十餘城。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m043-0000","start":0,"end":2,"surface":"漢王","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m043-0006","start":6,"end":8,"surface":"滕公","kind":"person","person_id":"cbr-p000715","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m043-0033","start":33,"end":35,"surface":"張耳","kind":"person","person_id":"cbr-p000676","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m043-0036","start":36,"end":38,"surface":"韓信","kind":"person","person_id":"cbr-p000724","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m043-0047","start":47,"end":49,"surface":"張耳","kind":"person","person_id":"cbr-p000676","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m043-0057","start":57,"end":59,"surface":"韓信","kind":"person","person_id":"cbr-p000724","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m043-0063","start":63,"end":65,"surface":"漢王","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m043-0066","start