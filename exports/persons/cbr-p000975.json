wudi:m006-0182","start":182,"end":184,"surface":"少君","kind":"person","person_id":"87n_vk2_1ig","status":"contextual_provisional","paragraph_id":"c-shiji-012-wudi:p006","chapter_id":"c-shiji-012-wudi"},{"id":"c-shiji-012-wudi:m006-0194","start":194,"end":196,"surface":"少君","kind":"person","person_id":"87n_vk2_1ig","status":"contextual_provisional","paragraph_id":"c-shiji-012-wudi:p006","chapter_id":"c-shiji-012-wudi"},{"id":"c-shiji-012-wudi:m006-0197","start":197,"end":199,"surface":"少君","kind":"person","person_id":"87n_vk2_1ig","status":"contextual_provisional","paragraph_id":"c-shiji-012-wudi:p006","chapter_id":"c-shiji-012-wudi"},{"id":"c-shiji-012-wudi:m006-0233","start":233,"end":235,"surface":"少君","kind":"person","person_id":"87n_vk2_1ig","status":"contextual_provisional","paragraph_id":"c-shiji-012-wudi:p006","chapter_id":"c-shiji-012-wudi"},{"id":"c-shiji-012-wudi:m007-0000","start":0,"end":2,"surface":"少君","kind":"person","person_id":"87n_vk2_1ig","status":"contextual_provisional","paragraph_id":"c-shiji-012-wudi:p007","chapter_id":"c-shiji-012-wudi"},{"id":"c-shiji-012-wudi:m008-0004","start":4,"end":7,"surface":"李少君","kind":"person","person_id":"87n_vk2_1ig","status":"contextual_provisional","paragraph_id":"c-shiji-012-wudi:p008","chapter_id":"c-shiji-012-wudi"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji012-011","person_id":"87n_vk2_1ig","surfaces":["少君","李少君"],"scope":"same_chapter","chapter_ids":["c-shiji-012-wudi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-012-wudi:p006","quote":"是時而李少君亦以祠灶、穀道、卻老方見上，上尊之。少君者，故深澤侯入以主方。匿其年及所生長，常自謂七十，能使物，卻老。其游以方遍諸侯。無妻子。人聞其能使物及不死，更饋遺之，常餘金錢帛衣食。人皆以為不治產業而饒給，又不知其何所人，愈信，爭事之。少君資好方，善為巧發奇中。嘗從武安侯飲，坐中有年九十餘老人，少君乃言與其大父游射處，老人為兒時從其大父行，識其處，一坐盡驚。少君見上，上有故銅器，問少君。少君曰：「此器齊桓公十年陳於柏寢。」已而案其刻，果齊桓公器。一宮盡駭，以少君為神，數百歲人也。"},{"paragraph_id":"c-shiji-012-wudi:p007","quote":"少君言於上曰：「祠灶則致物，致物而丹沙可化為黃金，黃金成以為飲食器則益壽，益壽而海中蓬萊僊者可見，見之以封禪則不死，黃帝是也。臣嘗游海上，見安期生，食臣棗，大如瓜。安期生僊者，通蓬萊中，合則見人，不合則隱。」於是天子始親祠灶，而遣方士入海求蓬萊安期生之屬，而事化丹沙諸藥齊為黃金矣。"},{"paragraph_id":"c-shiji-012-wudi:p008","quote":"居久之，李少君病死。天子以為化去不死也，而使黃錘史寬舒受其方。求蓬萊安期生莫能得，而海上燕齊怪迂之方士多相效，更言神事矣。"}],"rationale":"按開篇景帝子、王太后與皇子分封／繼位敘事，以及本段方士、祠事或飲宴語境暫定異稱；同名不全域合併。平原君另建候選，不與戰國人物合併；神異引語不作史實背書。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-012-wudi:p006","text":"是時而李少君亦以祠灶、穀道、卻老方見上，上尊之。少君者，故深澤侯入以主方。匿其年及所生長，常自謂七十，能使物，卻老。其游以方遍諸侯。無妻子。人聞其能使物及不死，更饋遺之，常餘金錢帛衣食。人皆以為不治產業而饒給，又不知其何所人，愈信，爭事之。少君資好方，善為巧發奇中。嘗從武安侯飲，坐中有年九十餘老人，少君乃言與其大父游射處，老人為兒時從其大父行，識其處，一坐盡驚。少君見上，上有故銅器，問少君。少君曰：「此器齊桓公十年陳於柏寢。」已而案其刻，果齊桓公器。一宮盡駭，以少君為神，數百歲人也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-012-wudi:m006-0003","start":3,"end":6,"surface":"李少君","kind":"person","person_id":"87n_vk2_1ig","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m006-0018","start":18,"end":19,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m006-0020","start":20,"end":21,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m006-0024","start":24,"end":26,"surface":"少君","kind":"person","person_id":"87n_vk2_1ig","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m006-0029","start":29,"end":33,"surface":"深澤侯入","kind":"person","person_id":"e74_jhr_fqm","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m006-0120","start":120,"end":122,"surface":"少君","kind":"person","person_id":"87n_vk2_1ig","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m006-0135","start":135,"end":138,"surface":"武安侯","kind":"person","person_id":"f3j_nl2_i2g","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m006-0143","start":143,"end":149,"surface":"年九十餘老人","kind":"unresolved","person_id":null,"status":"unresolved","note":"學說合稱、群體、匿名者或未定指代；不補未見姓名及成員。"},{