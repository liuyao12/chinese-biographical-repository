id":"3ab_c04_e8d","status":"source_explicit"},{"id":"c-jinshu-034-yanghu:p039:m0221","start":221,"end":223,"surface":"衛瓘","kind":"person","person_id":"67b_2b2_4b8","status":"source_explicit"},{"id":"c-jinshu-034-yanghu:p039:m0260","start":260,"end":261,"surface":"瓘","kind":"person","person_id":"67b_2b2_4b8","status":"contextual"},{"id":"c-jinshu-034-yanghu:p039:m0288","start":288,"end":289,"surface":"倫","kind":"person","person_id":"dkn_ge4_286_AAAAG","status":"contextual"}],"chapter_id":"c-jinshu-034-yanghu","book_id":"b-jinshu-034","work_id":"w-jinshu","source_id":"s-jinshu-034-ws2567662-yanghu"},{"id":"c-songshu-060-xunbozi:p003","text":"義熙九年，上表曰：「臣聞咎繇亡後，臧文以為深歎；伯氏奪邑，管仲所以稱仁。功高可百世不泯，濫賞無崇朝宜許。故太傅鉅平侯祜，明德通賢，宗臣莫二，勳參佐命，功成平吳，而後嗣闕然，烝嘗莫寄。漢以蕭何元功，故絕世輒紹。愚謂鉅平之封，宜同酇國。故太尉廣陵公陳准，黨翼孫秀，禍加淮南，竊饗大國，因罪為利。值西朝政刑失裁，中興復因而不奪。今王道惟新，豈可不大判臧否，謂廣陵之國，宜在削除。故太保衞瓘本爵蕭陽縣公，既被橫禍，及進第秩，始贈蘭陵，又轉江夏。中朝公輔，多非理終，瓘功德不殊，亦無緣獨受偏賞，宜復本封，以正國章。」詔付門下。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-songshu-060-xunbozi:p003:m0010","start":10,"end":11,"surface":"臣","kind":"person","person_id":"yoo_ox0_545_BABAAABAA","status":"contextual_provisional"},{"id":"c-songshu-060-xunbozi:p003:m0012","start":12,"end":14,"surface":"咎繇","kind":"person","person_id":"p7b_fs6_0uh","status":"contextual_provisional"},{"id":"c-songshu-060-xunbozi:p003:m0017","start":17,"end":19,"surface":"臧文","kind":"person","person_id":"mb8_di2_q6p","status":"contextual_provisional"},{"id":"c-songshu-060-xunbozi:p003:m0024","start":24,"end":26,"surface":"伯氏","kind":"person","person_id":"7ms_t82_run","status":"contextual_provisional"},{"id":"c-songshu-060-xunbozi:p003:m0029","start":29,"end":31,"surface":"管仲","kind":"person","person_id":"h1v_8ap_b9y","status":"contextual_provisional"},{"id":"c-songshu-060-xunbozi:p003:m0058","start":58,"end":59,"surface":"祜","kind":"person","person_id":"jpr_6g0_a2d","status":"contextual_provisional"},{"id":"c-songshu-060-xunbozi:p003:m0081","start":81,"end":83,"surface":"後嗣","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"祜後嗣的概稱，未辨個別人物。"},{"id":"c-songshu-060-xunbozi:p003:m0093","start":93,"end":95,"surface":"蕭何","kind":"person","person_id":"xd8_uww_5ok","status":"contextual_provisional"},{"id":"c-songshu-060-xunbozi:p003:m0122","start":122,"end":124,"surface":"陳准","kind":"person","person_id":"9w8_tqh_ysn_B*AA","status":"contextual_provisional"},{"id":"c-songshu-060-xunbozi:p003:m0127","start":127,"end":129,"surface":"孫秀","kind":"person","person_id":"8x5_e5i_yle","status":"contextual_provisional"},{"id":"c-songshu-060-xunbozi:p003:m0132","start":132,"end":134,"surface":"淮南","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"淮南為被害封國君的轉稱；待核晉書本傳後指人，非逕以地名建人。"},{"id":"c-songshu-060-xunbozi:p003:m0189","start":189,"end":191,"surface":"衞瓘","kind":"person","person_id":"6ds_k56_idw","status":"contextual_provisional"},{"id":"c-songshu-060-xunbozi:p003:m0228","start":228,"end":229,"surface":"瓘","kind":"person","person_id":"6ds_k56_idw","status":"contextual_provisional"}],"source_position":{"first_line":95,"last_line":96,"revision_id":1996694,"editorial_excerpt_boundary":true},"chapter_id":"c-songshu-060-xunbozi","book_id":"b-songshu-060","work_id":"w-songshu","source_id":"s-songshu-060-xunbozi"}],"sources":[{"chapter_id":"c-jinshu-034-yanghu","work_id":"w-jinshu","book_id":"b-jinshu-034","source_id":"s-jinshu-034-ws2567662-yanghu","source":{"title":"《晉書》卷三十四羊祜完整本傳及家屬續敘","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=晉書/卷034&oldid=2567662","permalink":"https://zh.wikisource.org/w/index.php?title=晉書/卷034&oldid=2567662","revision_id":2567662,"accessed_on":"2026-10-22","extent":"羊祜節題至下一同級杜預節題前，41完整原行，含家屬、承嗣與引錄文書；非全卷，卷末共評未重複匯入。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文公版；維基文庫數位文字保來源歸屬並依CC BY-SA4.0。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":null,"raw_file":"sources/witnesses/jin034-ws2567662.wikitext","raw_path":"sources/witnesses/jin034-ws2567662.wikitext","wikitext_sha256":"0dc292f7743a95456ac8fa2977ba82bcaa35e1dd9cebe32fb2ecfab2f21f7a71","raw_file_sha256":"0dc292f7743a95456ac8fa2977ba82bcaa35e1dd9cebe32fb2ecfab2f21f7a71","normalization":{"character_conversion":{},"extraction_note":"僅排版空白、quote/YL模板外殼、wiki連結/粗體標記投影；原字/標點不改，原文與所有排版排除位合為完整節界。實際古本未核。"}}},{"chapter_id":"c-songshu-060-xunbozi","work_id":"w-songshu","book_id":"b-songshu-060","source_id":"s-songshu-060-xunbozi","source":{"title":"《宋書》卷60（數位選錄）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E5%AE%8B%E6%9B%B8/%E5%8D%B760&oldid=1996694","permalink":"https://zh.wikisource.org/w/index.php?title=%E5%AE%8B%E6%9B%B8/%E5%8D%B760&oldid=1996694","revision_id":1996694,"accessed_on":"2026-10-18","extent":"荀伯子及族弟附傳完整八段","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，未親核底本影像","response_sha256":"4d214309ba547bf979a60fdb76576b4767fe0c79210f1d37a4f95ec09ca60853","wikitext_sha256":"a9b03405240b25c24c2fa2b999e921483d7c1d78a3ed6f1eb1807a289bf02a97","normalization":{"character_conversion":{},"extraction_note":"只去段首排版空白及連結語法；ref校勘文字與正文分存。異體不轉換，未親核所報印本。","excerpts":[{"proposed_paragraph_id":"c-songshu-060-xunbozi:p001","source_lines":[91,92],"raw_quote":"荀伯子，潁川潁陰人也。祖羨，驃騎將軍。父猗，祕書郎。","raw_quote_sha256":"3316b34f10c1c4661b5c227dc9b806e8aac8fb66425ac77720e5f89cf2a231cf","selected_text_sha256":"3316b34f10c1c4661b5c227dc9b806e8aac8fb66425ac77720e5f89cf2a231cf","begin_anchor":"荀伯子，潁川潁陰人也。祖羨，驃","end_anchor":"祖羨，驃騎將軍。父猗，祕書郎。","digital_editorial_notes":[]},{"proposed_paragraph_id":"c-songshu-060-xunbozi:p002","source_lines":[93,94],"raw_quote":"伯子少好學，博覽經傳，而通率好為雜戲，遨遊閭里，故以此失清塗。解褐為駙馬都尉，奉朝請，員外散騎侍郎。著作郎徐廣重其才學，舉伯子及王韶之並為佐郎，助撰晉史及著桓玄等傳。遷尚書祠部郎。","raw_quote_sha256":"2082d511b885366b7bc07d354df34e9ea4a663e8542fe1ecbb911312d7762c0e","selected_text_sha256":"2082d511b885366b7bc07d354df34e9ea4a663e8542fe1ecbb911312d7762c0e","begin_anchor":"伯子少好學，博覽經傳，而通率好","end_anchor":"史及著桓玄等傳。遷尚書祠部郎。","digital_editorial_notes":[]},{"proposed_paragraph_id":"c-songshu-060-xunbozi:p003","source_lines":[95,96],"raw_quote":"義熙九年，上表曰：「臣聞咎繇亡後，臧文以為深歎；伯氏奪邑，管仲所以稱仁。功高可百世不泯，濫賞無崇朝宜許。故太傅鉅平侯祜，明德通賢，宗臣莫二，勳參佐命，功成平吳，而後嗣闕然，烝嘗莫寄。漢以蕭何元功，故絕世輒紹。愚謂鉅平之封，宜同酇國。故太尉廣陵公陳准，黨翼孫秀，禍加淮南，竊饗大國，因罪為利。值西朝政刑失裁，中興復因而不奪。今王道惟新，豈可不大判臧否，謂廣陵之國，宜在削除。故太保衞瓘本爵蕭陽縣公，<ref>故太保衞瓘本爵蕭陽縣公　「蕭陽」南史、晉書衞瓘傳、羊祜傳並作「菑陽」。錢大昕廿二史考異云：「蕭陽，晉書作菑陽。考晉書地理志不見此二縣名。」</ref>既被橫禍，及進第秩，始贈蘭陵，又轉江夏。中朝公輔，多非理終，瓘功德不殊，亦無緣獨受偏賞，宜復本封，以正國章。」詔付門下。","raw_quote_sha256":"97c479ab7b0f7d5fce1e5e6597a6f268c93757ef64f264eb2c53bb9c9cb88e67","selected_text_sha256":"2bf43a2b5f645409b2856e31871d673a353d83f6b2b6c71a46d1b3a7c567e5cb","begin_anchor":"義熙九年，上表曰：「臣聞咎繇亡","end_anchor":"復本封，以正國章。」詔付門下。","digital_editorial_notes":[{"raw_quote":"<ref>故太保衞瓘本爵蕭陽縣公　「蕭陽」南史、晉書衞瓘傳、羊祜傳並作「菑陽」。錢大昕廿二史考異云：「蕭陽，晉書作菑陽。考晉書地理志不見此二縣名。」</ref>","raw_start":198,"raw_end":278,"body_offset":198,"text_layer":"digital_editorial_note","printed_editions_directly_checked":false}]},{"proposed_paragraph_id":"c-songshu-060-xunbozi:p004","source_lines":[97,98],"raw_quote":"前散騎常侍江夏公衞璵上表自陳曰：「臣乃祖故太保瓘，於魏咸熙之中，太祖文皇帝為元輔之日，封蕭陽侯，大晉受禪，進爵為公，歷位太保，總錄朝政。于時賈庶人及諸王用事，忌瓘忠節，故楚王瑋矯詔致禍。前朝以瓘秉心忠正，加以伐蜀之勳，故追封蘭陵郡公。永嘉之中，東海王越食蘭陵，換封江夏，戶邑如舊。臣高祖散騎侍郎璪，瓘之嫡孫，<ref>瓘之嫡孫　各本並脫「瓘」字。孫虨宋書考論云：「璪下當脫瓘字。」按晉書衞瓘傳，璪為瓘之孫。孫說是，今訂補。</ref>纂承封爵。中宗元皇帝以曾祖故右衞將軍崇承襲，逮于臣身。伏聞祠部郎荀伯子表，欲貶降復封蕭陽。夫趙氏之忠，寵延累葉，漢祖開封，誓以山河。伏願陛下錄既往之勳，垂罔極之施，乞出臣表，付外參詳。」潁川陳茂先亦上表曰：「祠部郎荀伯子表臣七世祖太尉准禍加淮南，不應濫賞。尋先臣以剪除賈謐，封海陵公，事在淮南遇禍之前。後廣陵雖在擾攘之際，臣祖乃始蒙殊遇，歷位元、凱。後被遠外，乃作平州，而猶不至除國，良以先勳深重，百世不泯故也。聖明御世，英輔係興，曾無疑議，以為濫賞。臣以微弱，未齒人倫，加始勉視息，封爵兼嗣。伏願陛下遠錄舊勳，特垂矜察。」詔皆付門下，並不施行。","raw_quote_sha256":"548dde3f6233ec021cc4a7206a6b7f1cc9bc504013f772116bbc3b1ba4642ad5","selected_text_sha256":"cf3458af2f860fab8747c35495e3fb6fb9bfb18dcfbb8e78991d104f467ac096","begin_anchor":"前散騎常侍江夏公衞璵上表自陳曰","end_anchor":"矜察。」詔皆付門下，並不施行。","digital_editorial_notes":[{"raw_quote":"<ref>瓘之嫡孫　各本並脫「瓘」字。孫虨宋書考論云：「璪下當脫瓘字。」按晉書衞瓘傳，璪為瓘之孫。孫說是，今訂補。</ref>","raw_start":154,"raw_end":217,"body_offset":154,"text_layer":"digital_editorial_note","printed_editions_directly_checked":false}]},{"proposed_paragraph_id":"c-songshu-060-xunbozi:p005","source_lines":[99,100],"raw_quote":"伯子為世子征虜功曹，國子博士。妻弟謝晦薦達之，入為尚書左丞，出補臨川內史。車騎將軍王弘稱之曰：「沈重不華，有平陽侯之風。」伯子常自矜廕籍之美，謂弘曰：「天下膏粱，唯使君與下官耳。宣明之徒，不足數也。」遷散騎常侍，本邑大中正。又上表曰：「伏見百官位次，陳留王在零陵王上，臣愚竊以為疑。昔武王剋殷，封神農之後於焦，黃帝之後於祝，帝堯之後於薊，帝舜之後於陳，夏後於𣏌，殷後於宋。𣏌、陳並為列國，而薊、祝、焦無聞焉。斯則褒崇所承，優於遠代之顯驗也。是以春秋次序諸侯，宋居𣏌、陳之上。考之近世，事亦有徵。晉泰始元年，詔賜山陽公劉康子弟一人爵關內侯，衞公姬署、宋侯孔紹子一人駙馬都尉。又泰始三年，太常上博士劉憙等議，稱衞公署於大晉在三恪之數，應降稱侯。臣以零陵王位宜在陳留之上。」從之。","raw_quote_sha256":"86d75ec94991f4008282ce5b8d440902181a72965e7dafc5704f9212fa9aae93","selected_text_sha256":"86d75ec94991f4008282ce5b8d440902181a72965e7dafc5704f9212fa9aae93","begin_anchor":"伯子為世子征虜功曹，國子博士。","end_anchor":"零陵王位宜在陳留之上。」從之。","digital_editorial_notes":[]},{"proposed_paragraph_id":"c-songshu-060-xunbozi:p006","source_lines":[101,102],"raw_quote":"遷太子僕，御史中丞，莅職懃恪，有匪躬之稱，立朝正色，外內憚之。凡所奏劾，莫不深相謗毀，或延及祖禰，示其切直，又頗雜謿戲，故世人以此非之。出補司徒左長史，東陽太守。元嘉十五年，卒官，時年六十一。文集傳於世。","raw_quote_sha256":"cc9a06f73f61573e8f0a0831fb615f4864677abcbf7ebad53b0bb9a4fe899816","selected_text_sha256":"cc9a06f73f61573e8f0a0831fb615f4864677abcbf7ebad53b0bb9a4fe899816","begin_anchor":"遷太子僕，御史中丞，莅職懃恪，","end_anchor":"卒官，時年六十一。文集傳於世。","digital_editorial_notes":[]},{"proposed_paragraph_id":"c-songshu-060-xunbozi:p007","source_lines":[103,104],"raw_quote":"子赤松，為尚書左丞，<ref>子赤松為尚書左丞　宋本作「左丞」，弘治本、北監本、毛本、殿本、局本作「右丞」，本書顏延之傳亦作「尚書左丞荀赤松」，未知孰是。今姑從宋本及顏延之傳作「左丞」。</ref>以徐湛之黨，為元凶所殺。","raw_quote_sha256":"c1ab6af9e6f05fb53417f60c683bdc11c1b84184069019689c4b3dc7c385f799","selected_text_sha256":"01d867be11ae0febe4f6210d601c21a505475848d86531f3ed180758516f6c09","begin_anchor":"子赤松，為尚書左丞，以徐湛之黨","end_anchor":"左丞，以徐湛之黨，為元凶所殺。","digital_editorial_notes":[{"raw_quote":"<ref>子赤松為尚書左丞　宋本作「左丞」，弘治本、北監本、毛本、殿本、局本作「右丞」，本書顏延之傳亦作「尚書左丞荀赤松」，未知孰是。今姑從宋本及顏延之傳作「左丞」。</ref>","raw_start":10,"raw_end":99,"body_offset":10,"text_layer":"digital_editorial_note","printed_editions_directly_checked":false}]},{"proposed_paragraph_id":"c-songshu-060-xunbozi:p008","source_lines":[105,106],"raw_quote":"伯子族弟昶字茂祖，與伯子絕服五世。元嘉初，以文義至中書郎。昶子萬秋字元寶，亦用才學自顯。世祖初，為晉陵太守。坐於郡立華林閣，置主書、主衣，下獄免。前廢帝末，為御史中丞，卒官。","raw_quote_sha256":"5fe409fdedc3816f58cff333ffca13de5fee0be9b3c89313b4f87d3732acca38","selected_text_sha256":"5fe409fdedc3816f58cff333ffca13de5fee0be9b3c89313b4f87d3732acca38","begin_anchor":"伯子族弟昶字茂祖，與伯子絕服五","end_anchor":"。前廢帝末，為御史中丞，卒官。","digital_editorial_notes":[]}]}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true}}
