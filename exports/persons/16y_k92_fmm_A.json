3102,3103,3104,3105,3106,3107,3108,3109,3110,3111,3112,3113,3114,3115,3116,3117,3118,3119,3120,3121,3122,3123,3124,3125,3126,3127,3128,3129,3130,3131,3132,3133,3134,3135,3136,3142,3143,3144,3145,3148,3149,3150,3151,3152,3153,3154,3155,3156,3157,3158,3159,3160,3161,3162,3163,3164,3165,3166,3167,3168,3169,3170,3171,3172,3173,3174,3175,3176,3177,3178,3179,3180,3181,3182,3183,3184,3185,3186,3187,3188,3189]},"chapter_id":"c-sanguozhi-059-he","book_id":"b-sanguozhi-059","work_id":"w-sanguozhi","source_id":"s-sanguozhi-059-he"},{"id":"c-sanguozhi-059-he:line028-pei01-01","text":"《吳書》曰：和少岐嶷有智意，故權尤愛幸，常在左右，衣服禮秩雕玩珍異之賜，諸子莫得比焉。好文學，善騎射，承師涉學，精識聦敏，尊敬師傅，愛好人物。穎等每朝見進賀，和常降意，歡以待之。講校經義，綜察是非，及訪諮朝臣，考績行能，以知優劣，各有條貫。後諸葛壹僞叛以誘魏將諸葛誕，權潛軍待之。和以權暴露外次，又戰者凶事，常憂勞憯怛，不復會同飲食，數上諫，戒令持重，務在全勝，權還，然後敢安。張純字元基，敦之子。","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-059-he:line028-pei01-01:m0006","start":6,"end":7,"surface":"和","kind":"person","person_id":"572_278_cba_A","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line028-pei01-01:m0015","start":15,"end":16,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line028-pei01-01:m0071","start":71,"end":72,"surface":"穎","kind":"person","person_id":"tm1_ycv_sdm","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line028-pei01-01:m0079","start":79,"end":80,"surface":"和","kind":"person","person_id":"572_278_cba_A","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line028-pei01-01:m0121","start":121,"end":124,"surface":"諸葛壹","kind":"person","person_id":"i9d_r75_8wu","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line028-pei01-01:m0130","start":130,"end":133,"surface":"諸葛誕","kind":"person","person_id":"655_392_7f8","status":"contextual_provisional"