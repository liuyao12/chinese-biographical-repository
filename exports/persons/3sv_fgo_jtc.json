id":"c-jinshu-060-qianxiu"},{"id":"c-jinshu-060-qianxiu:p002:m0021","surface":"昌","start":21,"end":22,"person_id":"3sv_fgo_jtc","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-060-qianxiu:p002","chapter_id":"c-jinshu-060-qianxiu"},{"id":"c-jinshu-076-yutan:line097:m0088","start":88,"end":90,"surface":"張昌","kind":"person","person_id":"3sv_fgo_jtc","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-076-yutan:line097","chapter_id":"c-jinshu-076-yutan"},{"id":"c-jinshu-076-yutan:line097:m0104","start":104,"end":105,"surface":"昌","kind":"person","person_id":"3sv_fgo_jtc","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-076-yutan:line097","chapter_id":"c-jinshu-076-yutan"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-044-luzhi:line058","text":"及河間王顒納李含之說，欲內除二王，樹穎儲副，遣報穎，穎將應之，志正諫，不從。及冏滅，穎遙執期權，遂懷觖望之心。以長沙王乂在內，不得恣其所欲，密欲去乂。時荊州有張昌之亂，穎表求親征，朝廷許之。會昌等平，乃回兵以討乂。志諫曰：「公前有復皇祚之大勳，及事平，歸功於齊，辭九錫之賞，不當朝政之權，振陽翟饑人，葬黃橋白骨，皆盛德之事，四海之人莫不荷賴矣。逆寇縱肆，猾擾荊、楚，今公掃清群難，南土以寧，振旅而旋，頓軍關外，文服入朝，此霸王者之事也。」穎不納。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-044-luzhi:line058:m0001","start":1,"end":5,"surface":"河間王顒","kind":"person","person_id":"ed0_313_bea","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line058:m0006","start":6,"end":8,"surface":"李含","kind":"person","person_id":"skr_sgj_x21","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line058:m0018","start":18,"end":19,"surface":"穎","kind":"person","person_id":"e81_f09_000","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line058:m0024","start":24,"end":25,"surface":"穎","