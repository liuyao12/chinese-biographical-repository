:"3sv_fgo_jtc","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-044-luzhi:line058","chapter_id":"c-jinshu-044-luzhi"},{"id":"c-jinshu-044-luzhi:line058:m0096","start":96,"end":97,"surface":"昌","kind":"person","person_id":"3sv_fgo_jtc","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-044-luzhi:line058","chapter_id":"c-jinshu-044-luzhi"},{"id":"c-jinshu-076-yutan:line097:m0088","start":88,"end":90,"surface":"張昌","kind":"person","person_id":"3sv_fgo_jtc","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-076-yutan:line097","chapter_id":"c-jinshu-076-yutan"},{"id":"c-jinshu-076-yutan:line097:m0104","start":104,"end":105,"surface":"昌","kind":"person","person_id":"3sv_fgo_jtc","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-076-yutan:line097","chapter_id":"c-jinshu-076-yutan"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-044-luzhi:line058","text":"及河間王顒納李含之說，欲內除二王，樹穎儲副，遣報穎，穎將應之，志正諫，不從。及冏滅，穎遙執期權，遂懷觖望之心。以長沙王乂在內，不得恣其所欲，密欲去乂。時荊州有張昌之亂，穎表求親征，朝廷許之。會昌等平，乃回兵以討乂。志諫曰：「公前有復皇祚之大勳，及事平，歸功於齊，辭九錫之賞，不當朝政之權，振陽翟饑人，葬黃橋白骨，皆盛德之事，四海之人莫不荷賴矣。逆寇縱肆，猾擾荊、楚，今公掃清群難，南土以寧，振旅而旋，頓軍關外，文服入朝，此霸王者之事也。」穎不納。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-044-luzhi:line058:m0001","start":1,"end":5,"surface":"河間王顒","kind":"person","person_id":"ed0_313_bea","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line058:m0006","start":6,"end":8,"surface":"李含","kind":"person","person_id":"skr_sgj_x21","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line058:m0018","start":18,"end":19,"surface":"穎","kind":"person","person_id":"e81_f09_000","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line058:m0024","start":24,"end":25,"surface":"穎","kind":"person","person_id":"e81_f09_000","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line058:m0026","start":26,"end":27,"surface":"穎","kind":"person","person_id":"e81_f09_000","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line058:m0031","start":31,"end":32,"surface":"志","kind":"person","person_id":"m8n_ntm_79h_ABB","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line058:m0039","start":39,"end":40,"surface":"冏","kind":"person","person_id":"ee0_b2a_68e","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line058:m0042","start":42,"end":43,"surface":"穎","kind":"person","person_id":"e81_f09_000","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line058:m0056","start":56,"end":60,"surface":"長沙王乂","kind":"person","person_id":"4c6_984_9ed","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line058:m0073","start":73,"end":74,"surface":"乂","kind":"person","person_id":"4c6_984_9ed","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line058:m0079","start":79,"end":81,"surface":"張昌","kind":"person","person_id":"3sv_fgo_jtc","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line058:m0084","start":84,"end":85,"surface":"穎","kind":"person","person_id":"e81_f09_000","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line058:m0096","start":96,"end":97,"surface":"昌","kind":"person","person_id":"3sv_fgo_jtc","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line058:m0105","start":105,"end":106,"surface":"乂","kind":"person","person_id":"4c6_984_9ed","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line058:m0107","start":107,"end":108,"surface":"志","kind":"person","person_id":"m8n_ntm_79h_ABB","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line058:m0219","start":219,"end":220,"surface":"穎","kind":"person","person_id":"e81_f09_000","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"source_position":{"first_line":58,"last_line":58,"revision_id":1775345},"source_quote":{"witness":"j44","quote":"　　及河間王顒納李含之說，欲內除二王，樹穎儲副，遣報穎，穎將應之，志正諫，不從。及冏滅，穎遙執期權，遂懷觖望之心。以長沙王乂在內，不得恣其所欲，密欲去乂。時荊州有張昌之亂，穎表求親征，朝廷許之。會昌等平，乃回兵以討乂。志諫曰：「公前有復皇祚之大勳，及事平，歸功於齊，辭九錫之賞，不當朝政之權，振陽翟饑人，葬黃橋白骨，皆盛德之事，四海之人莫不荷賴矣。逆寇縱肆，猾擾荊、楚，今公掃清群難，南土以寧，振旅而旋，頓軍關外，文服入朝，此霸王者之事也。」穎不納。","raw_start":4454,"raw_end":4679,"raw_line":58},"chapter_id":"c-jinshu-044-luzhi","book_id":"b-jinshu-044","work_id":"w-jinshu","source_id":"s-jinshu-044-luzhi"},{"id":"c-jinshu-076-yutan:line097","text":"虞潭，字思奧，會稽餘姚人，吳騎都尉翻之孫也。父忠，仕至宜都太守。吳之亡也，堅壁不降，遂死之。潭清貞有檢操，州辟從事、主簿，舉秀才，大司馬、齊王冏請為祭酒，除祁鄉令，徙醴陵令。值張昌作亂，郡縣多從之，潭獨起兵斬昌別率鄧穆等。襄陽太守華恢上潭領建平太守，以疾固辭。遂周旋征討，以軍功賜爵都亭侯。陳敏反，潭東下討敏弟贊于江州。廣州刺史王矩上潭領廬陵太守。綏撫荒餘，咸得其所。又與諸軍共平陳恢，仍轉南康太守，進爵東鄉侯。尋被元帝檄，使討江州刺史華軼。潭至廬陵，會軼已平，而湘川賊杜弢猶盛。江州刺史衛展上潭並領安成太守。時甘卓屯宜陽，為杜弢所逼。潭進軍救卓，卓上潭領長沙太守，固辭不就。王敦版潭為湘東太守，復以疾辭。弢平後，元帝召補丞相軍諮祭酒，轉琅邪國中尉。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-076-yutan:line097:m0000","start":0,"end":2,"surface":"虞潭","kind":"person","person_id":"9v9_cj5_dor","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-076-yutan:line097:m0004","start":4,"end":6,"surface":"思奧","kind":"person","person_id":"9v9_cj5_dor","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-076-yutan:line097:m0017","start":17,"end":18,"surface":"翻","kind":"person","person_id":"izi_e36_p1g","status":"contextual_provisional","interpretation_note