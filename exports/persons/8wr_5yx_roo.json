ot_independent_witness_passages","count_explanation":"2處獨立位置，2個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-weishu-weishou-058-yangchun-ws2087998"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-weishu-weishou-058-yangchun:p008:m0137","start":137,"end":140,"surface":"元恒芝","kind":"person","person_id":"8wr_5yx_roo","status":"contextual_provisional","interpretation_note":"完整單元逐段敘述及引語角色覆核；原稱不改，具體判讀見reading-review。","paragraph_id":"c-weishu-weishou-058-yangchun:p008","chapter_id":"c-weishu-weishou-058-yangchun"},{"id":"c-weishu-weishou-058-yangchun:p008:m0147","start":147,"end":149,"surface":"恒芝","kind":"person","person_id":"8wr_5yx_roo","status":"contextual_provisional","interpretation_note":"完整單元逐段敘述及引語角色覆核；原稱不改，具體判讀見reading-review。","paragraph_id":"c-weishu-weishou-058-yangchun:p008","chapter_id":"c-weishu-weishou-058-yangchun"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-weishu-weishou-058-yangchun:p008","text":"正光五年，除輔國將軍、南秦州刺史。時南秦州反叛，路又阻塞，仍停長安。轉授岐州，復除撫軍將軍、衞尉卿。轉左衞將軍，又兼尚書右僕射，馳驛詣并肆，齎絹三萬匹，募召恒朔流民，揀充軍士。不行。尋加衞將軍，出除都督雍南豳二州諸軍事、本將軍、雍州刺史，又進號車騎大將軍、儀同三司。蕭寶夤、元恒芝諸軍為賊所敗，恒芝從渭北東渡，椿使追之，不止。寶夤後至，留於逍遙園內，收集將士，猶得萬餘，由是三輔人心，頗得安帖。于時，涇岐及豳悉已陷賊，扶風以西，非復國有。椿乃鳩募內外，得七千餘人，遣兄子錄事參軍侃率以防禦。詔椿以本官加侍中、兼尚書右僕射為行臺，節度關西諸將，其統內五品已下、郡縣須有補用者，任即擬授。椿遇暴疾，頻啟乞解。詔許之，以蕭寶夤代椿為刺史、行臺。","text_layer":"received_chapter","annotation_status":"in_progress","source_position":{"revision_id":2087998,"raw_start":5148,"raw_end":5467,"source_layer":"received_biography","raw_character_offsets":[5148,5149,5150,5151,5152,5153,5154,5155,5156,5157,5158,5159,5160,5161,5162,5163,5164,5165,5166,5167,5168,5169,5170,5171,5172,5173,5174,5175,5176,5177,5178,5179,5180,5181,5182,5183,5184,5185,5186,5187,5188,5189,5190,5191,5192,5193,5194,5195,5196,5197,5198,5199,5200,5201,5202,5203,5204,5205,5206,5207,5208,5209,5210,5211,5212,5213,5214,5215,5216,5217,5218,5219,5220,5221,5222,5223,5224,5225,5226,5227,5228,5229,5230,5231,5232,5233,5234,5235,5236,5237,5238,5239,5240,5241,5242,5243,5244,5245,5246,5247,5248,5249,5250,5251,5252,5253,5254,5255,5256,5257,5258,5259,5260,5261,5262,5263,5264,5265,5266,5267,5268,5269,5270,5271,5272,5273,5274,5275,5276,5277,5278,5279,5280,5281,5282,5283,5284,5285,5286,5287,5288,5289,5290,5291,5292,5293,5294,5295,5296,5297,5298,5299,5300,5301,5302,5303,5304,5305,5306,5307,5308,5309,5310,5311,5312,5313,5314,5315,5316,5317,5318,5319,5320,5321,5322,5323,5324,5325,5326,5327,5328,5329,5330,5331,5332,5333,5334,5335,5336,5337,5338,5339,5340,5341,5342,5343,5344,5345,5346,5347,5348,5349,5350,5351,5352,5353,5354,5355,5356,5357,5358,5359,5360,5361,5362,5363,5364,5365,5366,5367,5368,5369,5370,5371,5372,5373,5374,5375,5376,5377,5378,5379,5380,5381,5382,5383,5384,5385,5386,5387,5388,5389,5390,5391,5392,5393,5394,5395,5396,5397,5398,5399,5400,5401,5402,5403,5404,5405,5406,5407,5408,5409,5410,5411,5412,5413,5414,5415,5416,5417,5418,5419,5420,5421,5422,5423,5424,5425,5426,5427,5428,5429,5430,5431,5432,5433,5434,5435,5436,5437,5438,5439,5440,5441,5442,5443,5444,5445,5446,5447,5448,5449,5450,5451,5452,5453,5454,5455,5456,5457,5458,5459,5460,5461,5462,5463,5464,5465,5466],"projection_sha256":"bfeb6029c07fad83822c4ec12c0fa43f6f5e55bc6e96338f4d718e78113f2065"},"mentions":[{"id":"c-weishu-weishou-058-yangchu