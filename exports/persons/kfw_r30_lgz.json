rpretation_note":"奉道固命與景微率眾赴安都。","paragraph_id":"c-songshu-088-song88:p002","chapter_id":"c-songshu-088-song88"},{"id":"c-songshu-088-xueandu:p002:m0007","start":7,"end":10,"surface":"傅靈越","kind":"person","person_id":"kfw_r30_lgz","identification_status":"contextual_provisional","interpretation_note":"與道固之子同領部眾。","paragraph_id":"c-songshu-088-xueandu:p002","chapter_id":"c-songshu-088-xueandu"}],"relations":[],"title_holdings":[{"id":"th-song088-daogu-17","person_id":"kfw_r30_lgz","title":"軍主","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"work_id":"w-songshu","book_id":"b-songshu-088","chapter_id":"c-songshu-088-song88","source_id":"s-songshu-088-song88-ws2069210","paragraph_id":"c-songshu-088-song88:p002","quote":"景和元年，出為寧朔將軍、冀州刺史，鎮歷城。泰始二年，進號輔國將軍，又進號征虜將軍。時徐州刺史薛安都同逆，上即還道固本號為徐州代之。道固不受命，遣子景微、軍主傅靈越率眾赴安都。既而為土人起義所攻，屢戰失利，閉門自守。會四方平定，上遣使宣慰，道固奉詔歸順。先是與沈文秀共引虜，虜既至，固守距之，因被圍逼。虜每進，輒為道固所摧。三年，以為都督冀青兗幽并五州諸軍事、前將軍、冀州刺史，加節，又進號平北將軍。其年，為虜所陷，被送桑乾，死於虜中。","person_mention_id":"c-songshu-088-song88:p002:m0078"}],"attestations":[{"id":"th-song088-daogu-17:a","paragraph_id":"c-songshu-088-song88:p002","start":76,"end":78,"surface":"軍主","person_mention_id":"c-songshu-088-song88:p002:m0078","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本傳在此用以指明具名人物。","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null}],"address_assertions":[{"id":"pa-songshu-088-fulingyue-origin","person_id":"kfw_r30_lgz","relation":"biographical_origin","place":{"source_name":"清河","place_id":null,"modern_identification":null},"source_term":"清河人也","date_expression":null,"status":"source_attested","source_anchor":{"paragraph_id":"c-songshu-088-fulingyue:p001","start":232,"end":236,"surface":"清河人也"},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-088","chapter_id":"c-songshu-088-fulingyue","source_id":"s-songshu-088-fulingyue-ws2069210","paragraph_id":"c-songshu-088-fulingyue:p001","quote":"靈越，清河人也。","person_mention_id":"c-songshu-088-fulingyue:p001:m0229"}],"interpretation_note":"附敘末句所報籍貫。","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null}],"person_references":[{"id":"c-songshu-088-fulingyue:p001:r0041","paragraph_id":"c-songshu-088-fulingyue:p001","start":41,"end":42,"surface":"我","person_id":"kfw_r30_lgz","referent_role":"speaker_self","quote":"我傅靈越也。","note":"傅靈越對擒得自己的軍人自報姓名。","chapter_id":"c-songshu-088-fulingyue","book_id":"b-songshu-088","work_id":"w-songshu","source_id":"s-songshu-088-fulingyue-ws2069210"},{"id":"c-songshu-088-fulingyue:p001:r0049","paragraph_id":"c-songshu-088-fulingyue:p001","start":49,"end":50,"surface":"賊","person_id":"kfw_r30_lgz","referent_role":"speaker_self","quote":"汝得賊何不即殺。","note":"傅靈越用擒者的立場指自己。","chapter_id":"c-songshu-088-fulingyue","book_id":"b-songshu-088","work_id":"w-songshu","source_id":"s-songshu-088-fulingyue-ws2069210"},{"id":"c-songshu-088-fulingyue:p001:r0068","paragraph_id":"c-songshu-088-fulingyue:p001","start":68,"end":69,"surface":"其","person_id":"kfw_r30_lgz","referent_role":"third_person","quote":"詰其叛逆","note":"劉勔詰問被俘的傅靈越。","chapter_id":"c-songshu-088-fulingyue","book_id":"b-songshu-088","work_id":"w-songshu","source_id":"s-songshu-088-fulingyue-ws2069210"},{"id":"c-songshu-088-fulingyue:p001:r0084","paragraph_id":"c-songshu-088-fulingyue:p001","start":84,"end":85,"surface":"我","person_id":"kfw_r30_lgz","referent_role":"speaker_self","quote":"九州唱義，豈獨在我。","note":"傅靈越回答劉勔。","chapter_id":"c-songshu-088-fulingyue","book_id":"b-songshu-088","work_id":"w-songshu","source_id":"s-songshu-088-fulingyue-ws2069210"},{"id":"c-songshu-088-fulingyue:p001:r0115","paragraph_id":"c-songshu-088-fulingyue:p001","start":115,"end":116,"surface":"卿","person_id":"kfw_r30_lgz","referent_role":"addressee","quote":"卿何不早歸天闕","note":"劉勔問傅靈越何以未早歸。","chapter_id":"c-songshu-088-fulingyue","book_id":"b-songshu-088","work_id":"w-songshu","source_id":"s-songshu-088-fulingyue-ws2069210"},{"id":"c-songshu-088-fulingyue:p001:r0198","paragraph_id":"c-songshu-088-fulingyue:p001","start":198,"end":199,"surface":"其","person_id":"kfw_r30_lgz","referent_role":"third_person","quote":"勔壯其意","note":"敘述劉勔對傅靈越的評價。","chapter_id":"c-songshu-088-fulingyue","book_id":"b-songshu-088","work_id":"w-songshu","source_id":"s-songshu-088-fulingyue-ws2069210"},{"id":"c-songshu-088-fulingyue:p001:r0227","paragraph_id":"c-songshu-088-fulingyue:p001","start":227,"end":228,"surface":"之","person_id":"kfw_r30_lgz","referent_role":"third_person","quote":"乃殺之。","note":"傅靈越拒改供詞，為受害者。","chapter_id":"c-songshu-088-fulingyue","book_id":"b-songshu-088","work_id":"w-songshu","source_id":"s-songshu-088-fulingyue-ws2069210"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-songshu-088-fulingyue:p001","text":"時武衞將軍王廣之領軍隸劉勔，攻殷琰於壽陽，傅靈越奔逃，為廣之軍人所生禽，厲聲曰：「我傅靈越也。汝得賊何不即殺。」生送詣勔，勔躬自慰勞，詰其叛逆，對曰：「九州唱義，豈獨在我。」勔又問：「四方阻逆，無戰不禽，主上皆加以曠蕩，即其才用。卿何不早歸天闕，乃逃命草間乎？」靈越答曰：「薛公舉兵淮北，威震天下，不能專任智勇，委付子姪，致敗之由，實在於此。然事之始末，備皆參豫，人生歸於一死，實無面求活。」勔壯其意，送還京師。太宗欲加原宥，靈越辭對如一，終不回改，乃殺之。靈越，清河人也。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-songshu-088-fulingyue:p001:m0005","start":5,"end":8,"surface":"王廣之","kind":"person","person_id":"m4d_lon_pyg","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:m0011","start":11,"end":13,"surface":"劉勔","kind":"person","person_id":"e2r_5iw_ui0_A","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:m0015","start":15,"end":17,"surface":"殷琰","kind":"person","person_id":"mj8_5ic_4kk_A","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:m0021","start":21,"end":24,"surface":"傅靈越","kind":"person","person_id":"kfw_r30_lgz","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:m0028","start":28,"end":30,"surface":"廣之","kind":"person","person_id":"m4d_lon_pyg","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:u0030","start":30,"end":32,"surface":"軍人","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"王廣之部下，姓名、人數未詳。"},{"id":"c-songshu-088-fulingyue:p001:m0042","start":42,"end":45,"surface":"傅靈越","kind":"person","person_id":"kfw_r30_lgz","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:u0047","start":47,"end":48,"surface":"汝","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"靈越呼擒獲者；未能定位到具名者。"},{"id":"c-songshu-088-fulingyue:p001:m0059","start":59,"end":60,"surface":"勔","kind":"person","person_id":"e2r_5iw_ui0_A","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:m0061","start":61,"end":62,"surface":"勔","kind":"person","person_id":"e2r_5iw_ui0_A","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:m0087","start":87,"end":88,"surface":"勔","kind":"person","person_id":"e2r_5iw_ui0_A","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:u0111","start":111,"end":112,"surface":"其","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"劉勔泛指前句所說各方被俘者。"},{"id":"c-songshu-088-fulingyue:p001:m0131","start":131,"end":133,"surface":"靈越","kind":"person","person_id":"kfw_r30_lgz","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:u0158","start":158,"end":160,"surface":"子姪","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"靈越泛稱薛安都委任的子姪，未逐一指名，保留群體。"},{"id":"c-songshu-088-fulingyue:p001:m0196","start":196,"end":197,"surface":"勔","kind":"person","person_id":"e2r_5iw_ui0_A","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:m0213","start":213,"end":215,"surface":"靈越","kind":"person","person_id":"kfw_r30_lgz","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:m0229","start":229,"end":231,"surface":"靈越","kind":"person","person_id":"kfw_r30_lgz","identification_status":"contextual_provisional"}],"chapter_id":"c-songshu-088-fulingyue","book_id":"b-songshu-088","work_id":"w-songshu","source_id":"s-songshu-088-fulingyue-ws2069210"},{"id":"c-songshu-088-song88:p002","text":"景和元年，出為寧朔將軍、冀州刺史，鎮歷城。泰始二年，進號輔國將軍，又進號征虜將軍。時徐州刺史薛安都同逆，上即還道固本號為徐州代之。道固不受命，遣子景微、軍主傅靈越率眾赴安都。既而為土人起義所攻，屢戰失利，閉門自守。會四方平定，上遣使宣慰，道固奉詔歸順。先是與沈文秀共引虜，虜既至，固守距之，因被圍逼。虜每進，輒為道固所摧。三年，以為都督冀青兗幽并五州諸軍事、前將軍、冀州刺史，加節，又進號平北將軍。其年，為虜所陷，被送桑乾，死於虜中。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-songshu-088-song88:p002:m0046","start":46,"end":49,"surface":"薛安都","kind":"person","person_id":"u3k_51j_4ul_A","identification_status":"contextual_provisional","interpretation_note":"徐州刺史，景微、傅靈越赴援者。"},{"id":"c-songshu-088-song88:p002:m0055","start":55,"end":57,"surface":"道固","kind":"person","person_id":"23q_wcp_hny","identification_status":"contextual_provisional","interpretation_note":"此時的受命者。"},{"id":"c-songshu-088-song88:p002:m0000","start":65,"end":67,"surface":"道固","kind":"person","person_id":"23q_wcp_hny","identification_status":"contextual_provisional","interpretation_note":"拒受徐州之命，遣子應薛安都。"},{"id":"c-songshu-088-song88:p002:m0008","start":73,"end":75,"surface":"景微","kind":"person","person_id":"23q_wcp_hny_A","identification_status":"contextual_provisional","interpretation_note":"崔道固之子。此傳正文作景微。"},{"id":"c-songshu-088-song88:p002:m0078","start":78,"end":81,"surface":"傅靈越","kind":"person","person_id":"kfw_r30_lgz","identification_status":"contextual_provisional","interpretation_note":"奉道固命與景微率眾赴安都。"},{"id":"c-songshu-088-song88:p002:m0082","start":82,"end":83,"surface":"眾","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"景微、傅靈越所率人眾，個人未具名。"},{"id":"c-songshu-088-song88:p002:m0084","start":84,"end":86,"surface":"安都","kind":"person","person_id":"u3k_51j_4ul_A","identification_status":"contextual_provisional","interpretation_note":"承本句前文徐州刺史薛安都。"},{"id":"c-songshu-088-song88:p002:m0090","start":90,"end":92,"surface":"土人","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"當地起兵者，集體未逐人具名。"},{"id":"c-songshu-088-song88:p002:m0115","start":115,"end":116,"surface":"使","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"明帝所遣使者，名與人數未載。"},{"id":"c-songshu-088-song88:p002:m0119","start":119,"end":121,"surface":"道固","kind":"person","person_id":"23q_wcp_hny","identification_status":"contextual_provisional","interpretation_note":"奉詔歸順者。"},{"id":"c-songshu-088-song88:p002:m0129","start":129,"end":132,"surface":"沈文秀","kind":"person","person_id":"jyf_yg2_dqk_A","identification_status":"contextual_provisional","interpretation_note":"同卷有本傳，與崔道固共引北魏軍。"},{"id":"c-songshu-088-song88:p002:m0134","start":134,"end":135,"surface":"虜","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"史書稱北魏方面，未具名將領。"},{"id":"c-songshu-088-song88:p002:m0136","start":136,"end":137,"surface":"虜","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"所引北魏軍。"},{"id":"c-songshu-088-song88:p002:m0143","start":143,"end":144,"surface":"之","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"指已至的北魏軍，非單一人物。"},{"id":"c-songshu-088-song88:p002:m0150","start":150,"end":151,"surface":"虜","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"圍城的北魏軍。"},{"id":"c-songshu-088-song88:p002:m0156","start":156,"end":158,"surface":"道固","kind":"person","person_id":"23q_wcp_hny","identification_status":"contextual_provisional","interpretation_note":"抵禦圍城魏軍者。"},{"id":"c-songshu-088-song88:p002:m0203","start":203,"end":204,"surface":"虜","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"攻陷城池的北魏軍。"},{"id":"c-songshu-088-song88:p002:m0214","start":214,"end":215,"surface":"虜","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"用作政權或其轄境，未具名個人。"}],"source_position":{"raw_character_offsets":[6188,6189,6190,6191,6192,6193,6194,6195,6196,6197,6198,6199,6200,6201,6202,6203,6204,6205,6206,6207,6208,6209,6210,6211,6212,6213,6214,6215,6216,6217,6218,6219,6220,6221,6222,6223,6224,6225,6226,6227,6228,6229,6230,6231,6232,6233,6234,6235,6236,6237,6238,6239,6240,6241,6242,6243,6244,6245,6246,6247,6248,6249,6250,6251,6252,6253,6254,6255,6256,6257,6258,6259,6260,6261,6262,6263,6264,6265,6266,6267,6268,6269,6270,6271,6272,6273,6274,6327,6328,6329,6330,6331,6332,6333,6334,6335,6336,6337,6338,6339,6340,6341,6342,6343,6344,6345,6346,6347,6348,6349,6350,6351,6352,6353,6354,6355,6356,6357,6358,6359,6360,6361,6362,6363,6364,6365,6366,6367,6368,6369,6370,6371,6372,6373,6374,6375,6376,6377,6378,6379,6380,6381,6382,6383,6384,6385,6386,6387,6388,6389,6390,6391,6392,6393,6394,6395,6396,6397,6398,6399,6400,6401,6402,6403,6404,6405,6406,6407,6408,6409,6410,6411,6412,6413,6414,6415,6416,6417,6418,6419,6420,6421,6422,6423,6424,6425,6426,6427,6428,6429,6430,6431,6432,6433,6434,6435,6436,6437,6438,6439,6440,6441,6442,6443,6444,6445,6446,6447,6448,6449,6450,6451,6452,6453,6454,6455,6456],"raw_start":6188,"raw_end":6457,"revision_id":2069210,"projection_sha256":"28fa6f4a6686660a367face159634bdea30624f4a79df98aa65f46a035f6066c","source_layer":"received_biography"},"chapter_id":"c-songshu-088-song88","book_id":"b-songshu-088","work_id":"w-songshu","source_id":"s-songshu-088-song88-ws2069210"},{"id":"c-songshu-088-xueandu:p002","text":"道固遣子景徵、傅靈越領眾，並應安都。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-songshu-088-xueandu:p002:m0000","start":0,"end":2,"surface":"道固","kind":"person","person_id":"23q_wcp_hny","identification_status":"contextual_provisional","interpretation_note":"本段前文已明冀州刺史崔道固。"},{"id":"c-songshu-088-xueandu:p002:m0004","start":4,"end":6,"surface":"景徵","kind":"person","person_id":"23q_wcp_hny_A","identification_status":"contextual_provisional","interpretation_note":"同父、同軍主、同赴薛安都一事，與崔道固傳景微暫作同一人；兩處字形分存。"},{"id":"c-songshu-088-xueandu:p002:m0007","start":7,"end":10,"surface":"傅靈越","kind":"person","person_id":"kfw_r30_lgz","identification_status":"contextual_provisional","interpretation_note":"與道固之子同領部眾。"},{"id":"c-songshu-088-xueandu:p002:m0015","start":15,"end":17,"surface":"安都","kind":"person","person_id":"u3k_51j_4ul_A","identification_status":"contextual_provisional","interpretation_note":"本傳傳主。"}],"chapter_id":"c-songshu-088-xueandu","book_id":"b-songshu-088","work_id":"w-songshu","source_id":"s-songshu-088-xueandu-ws2069210"}],"sources":[{"chapter_id":"c-songshu-088-fulingyue","work_id":"w-songshu","book_id":"b-songshu-088","source_id":"s-songshu-088-fulingyue-ws2069210","source":{"title":"宋書卷88・薛安都","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=宋書/卷88&oldid=2069210","permalink":"https://zh.wikisource.org/w/index.php?title=宋書/卷88&oldid=2069210","revision_id":2069210,"accessed_on":"2026-11-20","edition":"維基文庫固定修訂原始文字，底本待考，未核書影。","extent":"薛安都傳內傅靈越被俘至遇害及籍貫的連續附敘；同段接程天祚，另事。","section_locator":"薛安都","text_scope":"partial_chapter","image_verified":false,"review_status":"text_checked","rights":"古代正文；維基文庫貢獻者數位轉錄與標點。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","raw_url":"https://zh.wikisource.org/w/index.php?title=宋書/卷88&oldid=2069210&action=raw","raw_line":30,"raw_line_start":0,"raw_line_end":237,"following_text":"時輔國將軍、山陽內史程天祚","raw_path":"sources/songshu/songshu088-ws2069210.wikitext","raw_file_sha256":"1b5a5777efe7553db3e1b0d95cfc5b8cbffaf1b37ba9ddb5327eb5714d4d398d"}},{"chapter_id":"c-songshu-088-song88","work_id":"w-songshu","book_id":"b-songshu-088","source_id":"s-songshu-088-song88-ws2069210","source":{"title":"宋書卷88·崔道固傳","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=宋書/卷88&oldid=2069210","permalink":"https://zh.wikisource.org/w/index.php?title=宋書/卷88