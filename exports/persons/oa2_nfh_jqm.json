:true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-056-jiang-tong:p020:m0142","surface":"曹攄","start":142,"end":144,"person_id":"oa2_nfh_jqm","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-056-jiang-tong:p020","chapter_id":"c-jinshu-056-jiang-tong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-056-jiang-tong:p020","text":"及太子廢，徙許昌，賈后諷有司不聽宮臣追送。統與宮臣冒禁至伊水，拜辭道左，悲泣流漣。都官從事悉收統等付河南、洛陽獄。付郡者，河南尹樂廣悉散遣之，系洛陽者猶未釋。都官從事孫琰說賈謐曰：「所以廢徙太子，以為惡故耳。東宮故臣冒罪拜辭，涕泣路次，不顧重辟，乃更彰太子之德，不如釋之。」謐語洛陽令曹攄，由是皆免。及太子薨，改葬，統作誄敘哀，為世所重。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":49,"last_line":49,"raw_start":4780,"raw_end":4951,"raw_character_offsets":[4782,4783,4784,4785,4786,4787,4788,4789,4790,4791,4792,4793,4794,4795,4796,4797,4798,4799,4800,4801,4802,4803,4804,4805,4806,4807,4808,4809,4810,4811,4812,4813,4814,4815,4816,4817,4818,4819,4820,4821,4822,4823,4824,4825,4826,4827,4828,4829,4830,4831,4832,4833,4834,4835,4836,4837,4838,4839,4840,4841,4842,4843,4844,4845,4846,4847,4848,4849,4850,4851,4852,4853,4854,4855,4856,4857,4858,4859,4860,4861,4862,4863,4864,4865,4866,4867,4868,4869,4870,4871,4872,4873,4874,4875,4876,4877,4878,4879,4880,4881,4882,4883,4884,4885,4886,4887,4888,4889,4890,4891,4892,4893,4894,4895,4896,4897,4898,4899,4900,4901,4902,4903,4904,4905,4906,4907,4908,4909,4910,4911,4912,4913,4914,4915,4916,4917,4918,4919,4920,4921,4922,4923,4924,4925,4926,4927,4928,4929,4930,4931,4932,4933,4934,4935,4936,4937,4938,4939,4940,4941,4942,4943,4944,4945,4946,4947,4948,4949,4950],"revision_id":1557685},"mentions":[{"id":"c-jinshu-056-jiang-tong:p020:m0021","surface":"統","start":21,"end":22,"person_id":"z8m_9y0_s2w","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-056-jiang-tong:p0