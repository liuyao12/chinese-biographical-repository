redicate":"father","qualifiers":{"source_term":"協子彝上疏訟之"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-069","chapter_id":"c-jinshu-069-diaoxie","source_id":"s-jinshu-069-diaoxie-ws2012453","paragraph_id":"c-jinshu-069-diaoxie:p003","quote":"敦平後，周顗、戴若思等皆被顯贈，惟協以出奔不在其例。咸康中，協子彝上疏訟之。在位者多以明帝之世褒貶已定，非所得更議，且協不能抗節隕身，乃出奔遇害，不可復其官爵也。丹陽尹殷融議曰：「王敦惡逆，罪不容誅，則協之善亦不容賞。若以忠非良圖，謀事失算，以此為責者，蓋在於譏議之間耳。即凶殘之誅以為國刑，將何以沮勸乎！當敦專逼之時，慶賞威刑專自己出，是以元帝慮深崇本，以協為比，事由國計，蓋不為私。昔孔甯、儀行父從君于昏，楚復其位者，君之黨故也。況協之比君，在於義順。且中興四佐，位為朝首。于時事窮計屈，奉命違寇，非為逃刑。謂宜顯贈，以明忠義。」時庾冰輔政，疑不能決。左光祿大夫蔡謨與冰書曰：","subject_person_mention_id":"c-jinshu-069-diaoxie:p003:m0032","object_person_mention_id":"c-jinshu-069-diaoxie:p003:m0030"}],"status":"source_attested","interpretation_note":"子彝疏訟父死後未獲褒贈。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-jin069-diaoyi","person_id":"dsl_mbe_xfq","event_type":"death","source_term":"卒於官","source_anchor":{"paragraph_id":"c-jinshu-069-diaoyi:p001","start":77,"end":80,"surface":"卒於官"},"date_expression":null,"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-069","chapter_id":"c-jinshu-069-diaoyi","source_id":"s-jinshu-069-diaoyi-ws2012453","paragraph_id":"c-jinshu-069-diaoyi:p001","quote":"彝字大倫。少遭家難。王敦誅後，彝斬仇人党，以首祭父墓，詣廷尉請罪，朝廷特宥之，由是知名，歷尚書吏部郎、吳國內史，累遷北中郎將、徐兗二州刺史、假節，鎮廣陵，卒於官。","person_mention_id":"c-jinshu-069-diaoyi:p001:m0000"}],"status":"source_attested","interpretation_note":"按同段人物與次第核所屬卒事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"mentions":[{"id":"c-jinshu-069-diaoxie:p003:m0032","surface":"彝","start":32,"end":33,"person_id":"dsl_mbe_xfq","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-069-diaoxie:p003","chapter_id":"c-jinshu-069-diaoxie"},{"id":"c-jinshu-069-diaoyi:p001:m0000","surface":"彝","start":0,"end":1,"person_id":"dsl_mbe_xfq","kind":"