討平之。誕世兄車騎參軍新興太守景世、景世弟寶世，詣廷尉歸罪，並徙遠州。乾秀奪國。世祖初，徙者並得還。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":26,"last_line":26,"raw_start":1740,"raw_end":1939,"raw_character_offsets":[1740,1741,1742,1743,1744,1745,1746,1747,1748,1749,1750,1751,1752,1753,1754,1755,1756,1757,1758,1759,1760,1761,1762,1763,1764,1765,1766,1767,1768,1769,1770,1771,1772,1773,1774,1775,1776,1777,1778,1779,1780,1781,1782,1783,1784,1785,1786,1787,1788,1789,1790,1791,1792,1793,1794,1795,1796,1797,1798,1799,1800,1801,1802,1803,1804,1805,1806,1807,1808,1809,1810,1811,1812,1813,1814,1815,1816,1817,1818,1819,1820,1821,1822,1823,1824,1825,1826,1827,1828,1829,1830,1831,1832,1833,1834,1835,1836,1837,1838,1839,1840,1841,1842,1843,1844,1845,1846,1847,1848,1849,1850,1851,1852,1853,1854,1855,1856,1857,1858,1859,1860,1861,1862,1863,1864,1865,1866,1867,1868,1869,1870,1871,1872,1873,1874,1875,1876,1877,1878,1879,1880,1881,1882,1883,1884,1885,1886,1887,1888,1889,1890,1891,1892,1893,1894,1895,1896,1897,1898,1899,1900,1901,1902,1903,1904,1905,1906,1907,1908,1909,1910,1911,1912,1913,1914,1915,1916,1917,1918,1919,1920,1921,1922,1923,1924,1925,1926,1927,1928,1929,1930,1931,1932,1933,1934,1935,1936,1937,1938],"revision_id":2371899},"mentions":[{"id":"c-songshu-050-hu-fan-household:p001:m0001","start":1,"end":3,"surface":"隆世","kind":"person","person_id":"otw_1ui_wba_A","status":"contextual_provisional"},{"id":"c-songshu-050-hu-fan-household:p001:m0012","start":12,"end":14,"surface":"隆世","kind":"person","person_id":"otw_1ui_wba_A","status":"contextual_provisional"},{"id":"c-songshu-050-hu-fan-household:p001:m0017","start":17,"end":19,"surface":"乾秀","kind":"person","person_id":"otw_1ui_wba_AA","status":"contextual_provisional"},{"id":"c-songshu-050-hu-fan-household:p001:m0021","start":21,"end":22,"surface":"藩","kind":"person","person_id":"otw_1ui_wba","status":"contextual_provisional"},{"id":"c-songshu-050-hu-fan-household:p001:m0034","start":34,"end":35,"surface":"藩","kind":"per