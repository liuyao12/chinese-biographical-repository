ragraph_id":"c-jinshu-073-yuliang:line057","person_mention_id":"c-jinshu-073-yuliang:line057:m0037","quote_passage_ref":"data/corpus/jinshu/073-yuliang.json"}],"attestations":[{"id":"th-yu4-057-4-d9b_790_9f0:a1","paragraph_id":"c-jinshu-073-yuliang:line057","start":4,"end":6,"surface":"將軍","person_mention_id":"c-jinshu-073-yuliang:line057:m0037","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"原稱、授任及用稱分錄；任命不等於已到任；缺年月、同母及生年不補，不以死亡一律截止職爵。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"th-yu4-069-20-d9b_790_9f0","person_id":"d9b_790_9f0","title":"輔國將軍","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-073","source_id":"s-jinshu-073-yuliang","chapter_id":"c-jinshu-073-yuliang","paragraph_id":"c-jinshu-073-yuliang:line069","person_mention_id":"c-jinshu-073-yuliang:line069:m0024","quote_passage_ref":"data/corpus/jinshu/073-yuliang.json"}],"attestations":[{"id":"th-yu4-069-20-d9b_790_9f0:a1","paragraph_id":"c-jinshu-073-yuliang:line069","start":20,"end":24,"surface":"輔國將軍","person_mention_id":"c-jinshu-073-yuliang:line069:m0024","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"原稱、授任及用稱分錄；任命不等於已到任；缺年月、同母及生年不補，不以死亡一律截止職爵。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[{"id":"pa-yu4-69-42-d9b_790_9f0-service_location","person_id":"d9b_790_9f0","relation":"service_location","place":{"source_name":"邾城","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"source_term":"時石勒新死，亮有開復中原之謀，乃解豫州授輔國將軍毛寶，使與西陽太守樊峻精兵一萬，俱戍邾城。又以陶稱為南中郎將、江夏相，率部曲五千人入沔中。亮弟翼為南蠻校尉、南郡太守，鎮江陵。以武昌太守陳囂為輔國將軍、梁州刺史，趣子午。又遣偏軍伐蜀，至江陽，執偽荊州刺史李閎、巴郡太守黃植，送於京都。亮當率大眾十萬，據石城，為諸軍聲援，乃上疏曰：「蜀胡二寇凶虐滋甚，內相誅鋤，眾叛親離。蜀甚弱而胡尚強，並佃並守，修進取之備。襄陽北接宛許，南阻漢水，其險足固，其土足食。臣宜移鎮襄陽之石城下，並遣諸軍羅布江沔。比及數年，戎士習練，乘釁齊進，以臨河洛。大勢一舉，眾知存亡，開反善之路，宥逼協之罪，因天時，順人情，誅逋逆，雪大恥，實聖朝之所先務也。願陛下許其所陳，濟其此舉。淮泗壽陽所宜進據，臣輒簡練部分。乞槐棘參議，以定經略。」帝下其議。時王導與亮意同，郗鑒議以資用未備，不可大舉。亮又上疏，便欲遷鎮。會寇陷邾城，毛寶赴水而死。亮陳謝，自貶三等，行安西將軍。有詔復位。尋拜司空，餘官如故，固讓不拜。","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-073","source_id":"s-jinshu-073-yuliang","chapter_id":"c-jinshu-073-yuliang","paragraph_id":"c-jinshu-073-yuliang:line069","person_mention_id":"c-jinshu-073-yuliang:line069:m0024","quote_passage_ref":"data/corpus/jinshu/073-yuliang.json"}],"interpretation_note":"來源明俱戍邾城，非僅官稱轄地；不由此猜死亡河川或卒地。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"qualifiers":{"source_position":"輔國將軍"}}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-jin007-annal-0467","person_id":"d9b_790_9f0","surfaces":["毛寳"],"scope":"same_chapter","chapter_ids":["c-jinshu-007-huan-annal-xianhe3"],"status":"contextual_provisional","confidence_level":"medium","identification_basis":{"kind":"source_context"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-007","source_id":"s-jinshu-007-huan-annal-xianhe3","chapter_id":"c-jinshu-007-huan-annal-xianhe3","paragraph_id":"c-jinshu-007-huan-annal-xianhe3:p001","quote_passage_ref":"data/corpus/jinshu/007-huan-annal-xianhe3.json"}],"rationale":"依完整本年度敘事與既有來源身份辨識；原字保留，新身份限本數位見證。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null}],"equivalence_decisions":[],"sources":[{"chapter_id":"c-jinshu-007-huan-annal-xianhe3","work_id":"w-jinshu","book_id":"b-jinshu-007","source_id":"s-jinshu-007-huan-annal-xianhe3","source_ref":"corpus/jinshu/007-huan-annal-xianhe3.json"},{"chapter_id":"c-jinshu-073-yuliang","work_id":"w-jinshu","book_id":"b-jinshu-073","source_id":"s-jinshu-073-yuliang","source_ref":"corpus/jinshu/073-yuliang.json"}],"time_policy":{"unknown_is_not_u