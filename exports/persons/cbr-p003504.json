{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003504","identity_policy":"contextual_provisional","person_ids":["cbr-p003504"],"persons":[{"id":"cbr-p003504","label":"孝惠帝（絳侯周勃世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"孝惠帝","mention_ids":["c-shiji-057-zhou:m008-0017","c-shiji-057-zhou:m008-0021"]}],"evidence":[{"mention_id":"c-shiji-057-zhou:m008-0017","chapter_id":"c-shiji-057-zhou","paragraph_id":"c-shiji-057-zhou:p008","quote":"孝惠帝"},{"mention_id":"c-shiji-057-zhou:m008-0021","chapter_id":"c-shiji-057-zhou","paragraph_id":"c-shiji-057-zhou:p008","quote":"孝惠帝"}]}],"mentions":[{"id":"c-shiji-057-zhou:m008-0017","start":17,"end":20,"surface":"孝惠帝","kind":"person","person_id":"cbr-p003504","status":"contextual_provisional","paragraph_id":"c-shiji-057-zhou:p008","chapter_id":"c-shiji-057-zhou"},{"id":"c-shiji-057-zhou:m008-0021","start":21,"end":24,"surface":"孝惠帝","kind":"person","person_id":"cbr-p003504","status":"contextual_provisional","paragraph_id":"c-shiji-057-zhou:p008","chapter_id":"c-shiji-057-zhou"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji057-037","person_id":"cbr-p003504","surfaces":["孝惠帝"],"scope":"same_chapter","chapter_ids":["c-shiji-057-zhou"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-057-zhou:p008","quote":"勃既定燕而歸，高祖已崩矣，以列侯事孝惠帝。孝惠帝六年，置太尉官，以勃為太尉。十歲，高后崩。呂祿以趙王為漢上將軍，呂產以呂王為漢相國，秉漢權，欲危劉氏。勃為太尉，不得入軍門。陳平為丞相，不得任事。於是勃與平謀，卒誅諸呂而立孝文皇帝。其語在呂后、孝文事中。"}],"rationale":"按明示姓名、軍事近接、父子承爵與局部皇帝敘事暫接。周勃和勝之的絳侯分開，亞夫條侯與平曲支不混；代地韓信依韓王信近接而不接淮陰侯。未名人物、單名官員不補姓，校勘字不作定本，相術預言不作史實已驗。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-057-zhou:p008","text":"勃既定燕而歸，高祖已崩矣，以列侯事孝惠帝。孝惠帝六年，置太尉官，以勃為太尉。十歲，高后崩。呂祿以趙王為漢上將軍，呂產以呂王為漢相國，秉漢權，欲危劉氏。勃為太尉，不得入軍門。陳平為丞相，不得任事。於是勃與平謀，卒誅諸呂而立孝文皇帝。其語在呂后、孝文事中。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mention