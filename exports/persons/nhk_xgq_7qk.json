{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"nhk_xgq_7qk","canonical_person_id":"nhk_xgq_7qk","id_aliases":["cbr-p004679"],"identity_policy":"contextual_provisional","person_ids":["nhk_xgq_7qk"],"persons":[{"id":"nhk_xgq_7qk","label":"燕王聊城未名（魯仲連鄒陽列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"燕王","mention_ids":["c-shiji-083-luzou:m011-0040","c-shiji-083-luzou:m012-0283"]}],"evidence":[{"mention_id":"c-shiji-083-luzou:m011-0040","chapter_id":"c-shiji-083-luzou","paragraph_id":"c-shiji-083-luzou:p011","quote":"燕王"},{"mention_id":"c-shiji-083-luzou:m012-0283","chapter_id":"c-shiji-083-luzou","paragraph_id":"c-shiji-083-luzou:p012","quote":"燕王"}],"id_aliases":["cbr-p004679"]}],"source_mention_summary":[{"source_id":"s-shiji-083-luzou","work_id":"w-shiji","book_id":"b-shiji-083","chapter_id":"c-shiji-083-luzou","mention_count":2,"mention_ids":["c-shiji-083-luzou:m011-0040","c-shiji-083-luzou:m012-0283"],"paragraph_ids":["c-shiji-083-luzou:p011","c-shiji-083-luzou:p012"],"passage_count":2}],"most_mentioned_source_ids":["s-shiji-083-luzou"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-083-luzou:m011-0040","start":40,"end":42,"surface":"燕王","kind":"person","person_id":"nhk_xgq_7qk","status":"contextual_provisional","paragraph_id":"c-shiji-083-luzou:p011","chapter_id":"c-shiji-083-luzou"},{"id":"c-shiji-083-luzou:m012-0283","start":283,"end":285,"surface":"燕王","kind":"person","person_id":"nhk_xgq_7qk","status":"contextual_provisional","paragraph_id":"c-shiji-083-luzou:p012","chapter_id":"c-shiji-083-luzou"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji083-024","person_id":"nhk_xgq_7qk","scope":"same_chapter","chapter_ids":["c-shiji-083-luzou"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"依本段明示稱名與嵌套引古範圍暫定；未名者不以他篇或記憶直接補名。","surfaces":["燕王"],"evidence":[{"paragraph_id":"c-shiji-083-luzou:p011","quote":"吾聞之，智者不倍時而棄利，勇士不死而滅名，忠臣不先身而後君。今公行一朝之忿，不顧燕王之無臣，非忠也；殺身亡聊城，而威不信於齊，非勇也；功敗名滅，後世無稱焉，非智也。三者世主不臣，說士不載，故智者不再計，勇士不怯死。今死生榮辱，貴賤尊卑，此時不再至，願公詳計而無與俗同。"},{"paragraph_id":"c-shiji-083-luzou:p012","quote":"且楚攻齊之南陽，魏攻平陸，而齊無南面之心，以為亡南陽之害小，不如得濟北之利大，故定計審處之。今秦人下兵，魏不敢東面；衡秦之勢成，楚國之形危；齊棄南陽，斷右壤，定濟北，計猶且為之也。且夫齊之必決於聊城，公勿再計。今楚魏交退於齊，而燕救不至。以全齊之兵，無天下之規，與聊城共據期年之敝，則臣見公之不能得也。且燕國大亂，君臣失計，上下迷惑，栗腹以十萬之眾五折於外，以萬乘之國被圍於趙，壤削主困，為天下僇笑。國敝而禍多，民無所歸心。今公又以敝聊之民距全齊之兵，是墨翟之守也。食人炊骨，士無反外之心，是孫臏之兵也。能見於天下。雖然，為公計者，不如全車甲以報於燕。車甲全而歸燕，燕王必喜；身全而歸於國，士民如見父母，交游攘臂而議於世，功業可明。上輔孤主以制群臣，下養百姓以資說士，矯國更俗，功名可立也。亡意亦捐燕棄世，東游於齊乎？裂地定封，富比乎陶、衛，世世稱孤，與齊久存，又一計也。此兩計者，顯名厚實也，願公詳計而審處一焉。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-083-luzou:p011","text":"吾聞之，智者不倍時而棄利，勇士不死而滅名，忠臣不先身而後君。今公行一朝之忿，不顧燕王之無臣，非忠也；殺身亡聊城，而威不信於齊，非勇也；功敗名滅，後世無稱焉，非智也。三者世主不臣，說士不載，故智者不再計，勇士不怯死。今死生榮辱，貴賤尊卑，此時不再至，願公詳計而無與俗同。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-083-luzou:m011-0021","start":21,"end":23,"surface":"忠臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、譬喻或未定指代；不依記憶補姓名與親屬。"},{"id":"c-shiji-083-luzou:m011-0031","start":31,"end":32,"surface":"公","kind":"person","person_id":"6i8_efe_yzr","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m011-0040","start":40,"end":42,"surface":"燕王","kind":"person","person_id":"nhk_xgq_7qk","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m011-0084","start":84,"end":86,"surface":"世主","kind":"unresolved","person_id":null,"status":"unresolved","no