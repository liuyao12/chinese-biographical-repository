gqb_6ar","status":"contextual_provisional"}],"chapter_id":"c-sanguozhi-049-shixie-complete","book_id":"b-sanguozhi-049","work_id":"w-sanguozhi","source_id":"s-sanguozhi-049-shixie-complete-ws2075209"},{"id":"c-sanguozhi-052-buzhi-complete:line088","text":"孫權爲討虜將軍，召騭爲主記。除海鹽長，還辟車騎將軍東曹掾。建安十五年，出領鄱陽太守。歳中，徙交州刺史、立武中郎將。領武射吏千人，便道南行。明年，追拜使持節、征南中郎將。劉表所置蒼梧太守呉巨陰懷異心，外附內違。騭降意懷誘，請與相見，因斬徇之，威聲大震。士燮兄弟，相率供命，南土之賓，自此始也。益州大姓雍闓等殺蜀所署太守正昂，與燮相聞，求欲內附。騭因承製遣使宣恩撫納，由是加拜平戎將軍，封廣信侯。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-sanguozhi-052-buzhi-complete:line088:m0000","start":0,"end":2,"surface":"孫權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line088:m0009","start":9,"end":10,"surface":"騭","kind":"person","person_id":"snv_2iq_jes","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line088:m0084","start":84,"end":86,"surface":"劉表","kind":"person","person_id":"866_0fd_205","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line088:m0092","start":92,"end":94,"surface":"呉巨","kind":"person","person_id":"o4w_m9s_2kp","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line088:m0104","start":104,"end":105,"surface":"騭","kind":"person","person_id":"snv_2iq_jes","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line088:m0125","start":125,"end":127,"surface":"士燮","kind":"person","person_id":"p2p_gqb_6ar","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line088:m0149","start":149,"end":151,"surface":"雍闓","kind":"person","person_id":"7vv_kii_wu6","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line088:m0158","start":158,"end":160,"surface"