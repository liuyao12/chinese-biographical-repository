shu-040-zixiang:p005","chapter_id":"c-nanqishu-040-zixiang"},{"id":"c-nanqishu-040-zixiang:p005:m0075","surface":"法亮","start":75,"end":77,"person_id":"u4m_so3_3c0","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-nanqishu-040-zixiang:p005","chapter_id":"c-nanqishu-040-zixiang"},{"id":"c-nanshi-044-wudifive-nan:p003:m0012","surface":"茹法亮","start":12,"end":15,"person_id":"u4m_so3_3c0","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-nanshi-044-wudifive-nan:p003","chapter_id":"c-nanshi-044-wudifive-nan"},{"id":"c-nanshi-044-wudifive-nan:p004:m0011","surface":"法亮","start":11,"end":13,"person_id":"u4m_so3_3c0","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-nanshi-044-wudifive-nan:p004","chapter_id":"c-nanshi-044-wudifive-nan"},{"id":"c-nanshi-044-zixiang-nan:p001:m0027","surface":"法亮","start":27,"end":29,"person_id":"u4m_so3_3c0","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-nanshi-044-zixiang-nan:p001","chapter_id":"c-nanshi-044-zixiang-nan"}],"relations":[],"title_holdings":[{"id":"th-nanqi040-wudifive-lun1-122","person_id":"u4m_so3_3c0","title":"中書舍人","kind":"office","mode":"attestation","attestations":[{"id":"th-nanqi040-wudifive-lun1-122:a","person_mention_id":"c-nanqishu-040-zilun:p001:m0126","usage":"narrative","date_expression":null,"paragraph_id":"c-nanqishu-040-zilun:p001","surface":"中書舍人","start":122,"end":126}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-040","source_id":"s-nanqishu-040-zilun-ws2272748","chapter_id":"c-nanqishu-040-zilun","paragraph_id":"c-nanqishu-040-zilun:p001","quote":"巴陵王子倫字雲宗，世祖第十三子也。永明七年，爲持節、都督南豫司二州軍事、南中郎將、南豫州刺史。十年，遷北中郎將、南琅邪彭城二郡太守。鬱林卽位，以南彭城祿力優厚，奪子倫與中書舍人綦母珍之，更以南蘭陵代之。隆昌元年，遷散騎常侍、左將軍。延興元年，遣中書舍人茹法亮殺子倫，子倫正衣冠出受詔，曰：「鳥之將死，其鳴也哀；人之將死，其言也善。先朝昔滅劉氏，今日之事，理數固然。君是身家舊人，今銜此使，當由事不獲已。」法亮不敢荅而退。年十六。","person_mention_id":"c-nanqishu-040-zilun:p001:m0126"}],"status":"source_attested","interpretation_note":"按本見證原職名及其所屬人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"th-nanqi040-zixiang-m3-264-茹法亮","person_id":"u4m_so3_3c0","title":"中書舍人","kind":"office","mode":"attestation","attestations":[{"id":"th-nanqi040-zixiang-m3-264-茹法亮:a","person_mention_id":"c-nanqishu-040-zixiang:p003:m0268","usage":"narrative","date_expression":null,"paragraph_id":"c-nanqishu-040-zixiang:p003","surface":"中書舍人","start":264,"end":268}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-040","source_id":"s-nanqishu-040-zixiang-ws2272748","chapter_id":"c-nanqishu-040-zixiang","paragraph_id":"c-nanqishu-040-zixiang:p003","quote":"七年，遷使持節、都督荊湘雍梁寧南北秦七州軍事、鎮軍將軍、荊州刺史。子響少好武，在西豫時，自選帶仗左右六十人，皆有膽幹。至鎮，數在內齋殺牛置酒，與之聚樂。令內人私作錦袍絳襖，欲餉蠻交易器仗。長史劉寅等連名密啓，上勑精檢。寅等懼，欲秘之。子響聞臺使至，不見勑，召寅及司馬席恭穆、諮議參軍江愈、殷曇粲、中兵參軍周彥、典籤吳脩之、王賢宗、魏景淵於琴臺下詰問之。寅等無言。脩之曰：「旣以降勑旨，政應方便答塞。」景淵曰：「故應先檢校。」子響大怒，執寅等於後堂殺之。以啓無江愈名，欲釋之，而用命者已加戮。上聞之怒，遣衞尉胡諧之、游擊將軍尹略、中書舍人茹法亮領齋仗數百人，檢捕羣小。勑：「子響若束首自歸，可全其性命。」","person_mention_id":"c-nanqishu-040-zixiang:p003:m0268"}],"status":"source_attested","interpretation_note":"按本見證原職名及其所屬人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"person_references":[{"id":"c-nanqishu-040-zilun:p001:r0182","surface":"君","start":182,"end":183,"person_id":"u4m_so3_3c0","referent_role":"addressee","paragraph_id":"c-nanqishu-040-zilun:p001","quote":"巴陵王子倫字雲宗，世祖第十三子也。永明七年，爲持節、都督南豫司二州軍事、南中郎將、南豫州刺史。十年，遷北中郎將、南琅邪彭城二郡太守。鬱林卽位，以南彭城祿力優厚，奪子倫與中書舍人綦母珍之，更以南蘭陵代之。隆昌元年，遷散騎常侍、左將軍。延興元年，遣中書舍人茹法亮殺子倫，子倫正衣冠出受詔，曰：「鳥之將死，其鳴也哀；人之將死，其言也善。先朝昔滅劉氏，今日之事，理數固然。君是身家舊人，今銜此使，當由事不獲已。」法亮不敢荅而退。年十六。","note":"依同段姓名、引者及所答者。","chapter_id":"c-nanqishu-040-zilun","book_id":"b-nanqishu-040","work_id":"w-nanqishu","source_id":"s-nanqishu-040-zilun-ws2272748"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-040-zilun:p001","text":"巴陵王子倫字雲宗，世祖第十三子也。永明七年，爲持節、都督南豫司二州軍事、南中郎將、南豫州刺史。十年，遷北中郎將、南琅邪彭城二郡太守。鬱林卽位，以南彭城祿力優厚，奪子倫與中書舍人綦母珍之，更以南蘭陵代之。隆昌元年，遷散騎常侍、左將軍。延興元年，遣中書舍人茹法亮殺子倫，子倫正衣冠出受詔，曰：「鳥之將死，其鳴也哀；人之將死，其言也善。先朝昔滅劉氏，今日之事，理數固然。君是身家舊人，今銜此使，當由事不獲已。」法亮不敢荅而退。年十六。","mentions":[{"id":"c-nanqishu-040-zilun:p001:m0003","surface":"子倫","start":3,"end":5,"person_id":"kix_r92_2ed_K","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-040-zilun:p001:m0006","surface":"雲宗","start":6,"end":8,"person_id":"kix_r92_2ed_K","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-040-zilun:p001:m0081","surface":"子倫","start":81,"end":83,"person_id":"kix_r92_2ed_K","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-040-zilun:p001:m0088","surface":"綦母珍之","start":88,"end":92,"person_id":"b0u_gc0_om9","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-040-zilun:p001:m0126","surface":"茹法亮","start":126,"end":129,"person_id":"u4m_so3_3c0","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-040-zilun:p001:m0130","surface":"子倫","start":130,"end":132,"person_id":"kix_r92_2ed_K","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-040-zilun:p001:m0133","surface":"子倫","start":133,"end":135,"person_id":"kix_r92_2ed_K","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-040-zilun:p001:m0202","surface":"法亮","start":202,"end":204,"person_id":"u4m_so3_3c0","kind":"person","status":"