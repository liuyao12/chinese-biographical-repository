ace":"侍者","kind":"person","person_id":"804_dli_wzj","status":"contextual_provisional","paragraph_id":"c-shiji-118-huainan:p010","chapter_id":"c-shiji-118-huainan"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-118-huainan:p010","text":"盡誅所與謀者。於是乃遣淮南王，載以輜車，令縣以次傳。是時袁盎諫上曰：「上素驕淮南王，弗為置嚴傅相，以故至此。且淮南王為人剛，今暴摧折之。臣恐卒逢霧露病死。陛下為有殺弟之名，柰何！」上曰：「吾特苦之耳，今復之。」縣傳淮南王者皆不敢發車封。淮南王乃謂侍者曰：「誰謂乃公勇者？吾安能勇！吾以驕故不聞吾過至此。人生一世閒，安能邑邑如此！」乃不食死。至雍，雍令發封，以死聞。上哭甚悲，謂袁盎曰：「吾不聽公言，卒亡淮南王。」盎曰：「不可柰何，願陛下自寬。」上曰：「為之柰何？」盎曰：「獨斬丞相、御史以謝天下乃可。」上即令丞相、御史逮考諸縣傳送淮南王不發封餽侍者，皆棄市。乃以列侯葬淮南王於雍，守冢三十戶。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-118-huainan:m010-0004","start":4,"end":6,"surface":"謀者","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-118-huainan:m010-0011","start":11,"end":14,"surface":"淮南王","kind":"person","person_id":"yqp_nlb_p1p_AF","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m010-0028","start":28,"end":30,"surface":"袁盎","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m010-0031","start":31,"end":32,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m010-0035","start":35,"end":36,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m010-0038","start":38,"end":41,"surface":"淮南王","kind":"person","person_id":"yqp_nlb_p1p_AF","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m010-0045","start":45,"end":48,"surface":"嚴傅相","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-118-huainan:m010-0055","start":55,"end":58,"surface":"淮南王","kind":"person","person_id":"yqp_nlb_p1p_AF","status":"contextual_provisional