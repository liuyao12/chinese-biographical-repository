，可以興嗟；既葬釋于儲君，何其斯酷。徇以苟合，不求其正，以當代之元良，為諸侯之庶子，檀弓習於變禮者也，杜預其有焉。","text_layer":"received_chapter","source_position":{"raw_start":11484,"raw_end":11733,"raw_character_offsets":[11486,11487,11488,11489,11490,11491,11492,11493,11494,11495,11496,11497,11498,11499,11500,11501,11502,11503,11504,11505,11506,11507,11508,11509,11510,11511,11512,11513,11514,11515,11516,11517,11518,11519,11520,11521,11522,11523,11524,11525,11526,11527,11528,11529,11530,11531,11532,11533,11534,11535,11536,11537,11538,11539,11540,11541,11542,11543,11544,11545,11546,11547,11548,11549,11550,11551,11552,11553,11554,11555,11556,11557,11558,11559,11560,11561,11562,11563,11564,11565,11566,11567,11568,11569,11570,11571,11572,11573,11574,11575,11576,11577,11578,11579,11580,11581,11582,11583,11584,11585,11586,11587,11588,11589,11590,11591,11592,11593,11594,11595,11596,11597,11598,11599,11600,11601,11602,11603,11604,11605,11606,11607,11608,11609,11610,11611,11612,11613,11614,11615,11616,11617,11618,11619,11620,11621,11622,11623,11624,11625,11626,11627,11628,11629,11630,11631,11632,11633,11634,11635,11636,11637,11640,11641,11644,11645,11646,11647,11648,11649,11650,11651,11652,11653,11654,11655,11656,11657,11658,11659,11660,11661,11662,11663,11664,11665,11666,11667,11668,11669,11670,11671,11672,11673,11674,11675,11676,11677,11678,11679,11680,11681,11682,11683,11684,11685,11686,11687,11688,11689,11690,11691,11692,11693,11694,11695,11696,11697,11698,11699,11700,11701,11702,11703,11704,11705,11706,11707,11708,11709,11710,11711,11712,11713,11714,11715,11716,11717,11718,11719,11720,11721,11722,11723,11724,11725,11726,11727,11728,11729,11730,11731,11732],"first_line":135,"last_line":135,"revision_id":2567662,"projection_sha256":"0d9384efa0ec348a3a3a4d6cb0b5bf63af46dd66ec8579aebd7d1d9a1d86eb5a","source_layer":"received_criticism","editorial_subsection":" 【評贊】 ","quotation_block_markup":false},"mentions":[{"id":"c-jinshu-034-duyu:p026:m0014","start":14,"end":16,"surface":"羊公","kind":"person","person_id":"dqd_5q9_pkz_BD","