uired":false},"family_paths":[],"name_components":[{"person_id":"8f5_74b_457","title":null,"surname":"張","ming":"健","additional_names":[],"work_id":"w-jinshu","book_id":"b-jinshu-073","chapter_id":"c-jinshu-073-yu-yi-bing-tiao","source_id":"s-jinshu-073-yu-yi-bing-tiao","paragraph_id":"c-jinshu-073-yu-yi-bing-tiao:line094","quote":"會蘇峻作逆，遣兵攻冰，冰不能禦，便棄郡奔會稽。會稽內史王舒以冰行奮武將軍，距峻別率張健于吳中。時健党甚眾，諸將莫敢先進。冰率眾擊健走之，於是乘勝西進，赴於京都。又遣司馬滕含攻賊石頭城，拔之。冰勳為多，封新吳縣侯，固辭不受。遷給事黃門侍郎，又讓不拜。司空郗鑒請為長史，不就。出補振威將軍、會稽內史。徵為領軍將軍，又辭。尋入為中書監、揚州刺史、都督揚豫兗三州軍事、征虜將軍、假節。","note":"原文具名用稱分錄姓、名；不把官名、王號或字當本名，不改寫原字。","status":"editorial_provisional","human_reviewed":false,"model":null}],"mentions":[{"id":"c-jinshu-073-yu-yi-bing-tiao:line094:m0041","start":41,"end":43,"surface":"張健","kind":"person","person_id":"8f5_74b_457","status":"contextual_provisional","paragraph_id":"c-jinshu-073-yu-yi-bing-tiao:line094","chapter_id":"c-jinshu-073-yu-yi-bing-tiao"},{"id":"c-jinshu-073-yu-yi-bing-tiao:line094:m0048","start":48,"end":49,"surface":"健","kind":"person","person_id":"8f5_74b_457","status":"contextual_provisional","paragraph_id":"c-jinshu-073-yu-yi-bing-tiao:line094","chapter_id":"c-jinshu-073-yu-yi-bing-tiao"},{"id":"c-jinshu-073-yu-yi-bing-tiao:line094:m0064","start":64,"end":65,"surface":"健","kind":"person","person_id":"8f5_74b_457","status":"contextual_provisional","paragraph_id":"c-jinshu-073-yu-yi-bing-tiao:line094","chapter_id":"c-jinshu-073-yu-yi-bing-tiao"},{"id":"c-jinshu-073-yu-yi-bing-tiao:line094:m0066","start":66,"end":67,"surface":"之","kind":"person","person_id":"8f5_74b_457","status":"contextual_provisional","paragraph_id":"c-jinshu-073-yu-yi-bing-tiao:line094","chapter_id":"c-jinshu-073-yu-yi-bing-tiao"},{"id":"c-jinshu-100-phase5-sujun:line125:m0574","start":574,"end":576,"surface":"張健","kind":"person","person_id":"8f5_74b_457","paragraph_id":"c-jinshu-100-phase5-sujun:line125","chapter_id":"c-jinshu-100-phase5-sujun"},{"id":"c-zizhitongjian-094-xiyang-kinship:line126:m0054","start":54,"end":56,"surface":"張健","kind":"person","person_id":"8f5_74b_457","paragraph_id":"c-zizhitongjian-094-xiyang-kinship:line126","chapter_id":"c-zizhitongjian-094-xiyang-kinship"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-phase5-100-張健","person_id":"8f5_74b_457","surfaces":["張健"],"scope":"same_chapter","chapter_ids":["c-jinshu-100-phase5-sujun"],"status":"contextual_provisional","confidence_level":"moderate","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-100","source_id":"s-jinshu-100-phase5","chapter_id":"c-jinshu-100-phase5-sujun","paragraph_id":"c-jinshu-100-phase5-sujun:line125","quote":"時溫嶠、陶侃已唱義于武昌，峻聞兵起，用參軍賈甯計，還據石頭，更分兵距諸義軍，所過無不殘滅。嶠等將至，峻遂遷天子于石頭，逼迫居人，盡聚之後苑，使懷德令匡術守苑城。嶠等既到，乃築壘于白石，峻率眾攻之，幾至陷沒。東西抄掠，多所擒虜，兵威日盛，戰無不克，由是義眾沮衄，人懷異計。朝士之奔義軍者，皆云：「峻狡黠有智力，其徒黨驍勇，所向無敵。惟當以天討有罪，誅滅不久；若以人事言之，未易除也。」溫嶠怒曰：「諸君怯懦，乃是譽賊。」及後累戰不捷，嶠亦深憚之。管商等進攻吳郡，焚吳縣、海監、嘉興，敗諸義軍。韓晃又攻宣城，害太守桓彝。商等又焚余杭，而大敗于武康，退還義興。嶠與趙胤率步兵萬人，從白石南上，欲以臨之。峻與匡孝將八千人逆戰，峻遣子碩與孝以數十騎先薄趙胤，敗之。峻望見胤走，曰：「孝能破賊，我更不如乎！」因舍其眾，與數騎北下突陣，不得入，將回趨白木陂，牙門彭世、李千等投之以矛，墜馬，斬首臠割之，焚其骨，三軍皆稱萬歲。峻司馬任讓等共立峻弟逸為主。求峻屍不獲，碩乃發庾亮父母墓，剖棺焚屍。逸閉城自守。韓晃聞峻死，引兵赴石頭。管商及弘徽進攻庱亭壘，督護李閎及輕車長史滕含擊破之，斬首千級。商率眾走延陵，李閎與庱亭諸軍追之，斬獲數千級。商詣庾亮降，匡術舉苑城降。韓晃與蘇逸等並力攻術，不能陷。溫嶠等選精銳將攻賊營，碩率驍勇數百渡淮而戰，於陣斬碩。晃等震懼，以其眾奔張健于曲阿，門厄不得出，更相蹈藉，死者萬數。逸為李湯所執，斬于車騎府。","person_mention_id":"c-jinshu-100-phase5-sujun:line125:m0574"}],"rationale":"依完整同段主語、親屬及事件辨識短稱；已有人物須同一蘇峻亂、彭城王系或相同君主脈絡，不以同名合併。馗、權、植、釋的局部父系獨立於馗接防的跨篇推論。","references":[],"reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"d-phase4-094-8f5_74b_457","person_id":"8f5_74b_457","surfaces":["張健"],"scope":"same_chapter","chapter_ids":["c-zizhitongjian-094-xiyang-kinship"],"status":"contextual_provisional","confidence_level":"moderate","evidence":[{"work_id":"w-zizhitongjian","book_id":"b-zizhitongjian-094","source_id":"s-zizhitongjian-094-xiyang-kinship","chapter_id":"c-zizhitongjian-094-xiyang-kinship","paragraph_id":"c-zizhitongjian-094-xiyang-kinship:line126","quote":"二月，丙戌，諸軍攻石頭。建成長史滕含擊蘇逸，大破之。蘇碩帥驍勇數百，渡准而戰，溫嶠擊斬之。韓晃等懼，以其眾就張健於曲阿，門隘不得出，更相蹈藉，死者萬數。西軍獲蘇逸，斬之。滕含部將曹據抱帝奔溫嶠船，群臣見帝，頓首號泣請罪。殺西陽王羕，並其二子播、充、孫崧及彭城王雄。陶侃與任讓有舊，為請其死。帝曰：「是殺吾侍中、右衛者，不可赦也。」乃殺之。司徒導入石頭，令取故節，陶侃笑曰：「蘇武節似不如是。」導有慚色。丁亥，大赦。","person_mention_id":"c-zizhitongjian-094-xiyang-kinship:line126:m0054"}],"rationale":"與既有073庾冰傳蘇峻別率張健同一亂事及曲阿餘黨。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-073-yu-yi-bing-tiao:line094","text":"會蘇峻作逆，遣兵攻冰，冰不能禦，便棄郡奔會稽。會稽內史王舒以冰行奮武將軍，距峻別率張健于吳中。時健党甚眾，諸將莫敢先進。冰率眾擊健走之，於是乘勝西進，赴於京都。又遣司馬滕含攻賊石頭城，拔之。冰勳為多，封新吳縣侯，固辭不受。遷給事黃門侍郎，又讓不拜。司空郗鑒請為長史，不就。出補振威將軍、會稽內史。徵為領軍將軍，又辭。尋入為中書監、揚州刺史、都督揚豫兗三州軍事、征虜將軍、假節。","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-073-yu-yi-bing-tiao:line094:m0001","start":1,"end":3,"surface":"蘇峻","kind":"person","person_id":"lrg_cze_g1l","status":"contextual_provisional"},{"id":"c-jinshu-073-yu-yi-bing-tiao:line094:m0009","start":9,"end":10,"surface":"冰","kind":"person","person_id":"4qr_wrk_3vd_D","status":"contextual_provisional"},{"id":"c-jinshu-073-yu-yi-bing-tiao:line094:m0011","start":11,"end":12,"surface":"冰","kind":"person","person_id":"4qr_wrk_3vd_D","status":"contextual_provisional"},{"id":"c-jinshu-073-yu-yi-bing-tiao:line094:m0027","start":27,"end":29,"surface":"王舒","kind":"person","person_id":"nbl_2bu_99w","status":"contextual_provisional"},{"id":"c-jinshu-073-yu-yi-bing-tiao:line094:m0030","start":30,"end":31,"surface":"冰","kind":"person","person_id":"4qr_wrk_3vd_D","status":"contextual_provisional"},{"id":"c-jinshu-073-yu-yi-bing-tiao:line094:m0038","start":38,"end":39,"surface":"峻","kind":"person","person_id":"lrg_cze_g1l","status":"contextual_provisional"},{"id":"c-jinshu-073-yu-yi-bing-tiao:line094:m0041","start":41,"end":43,"surface":"張健","kind":"person","person_id":"8f5_74b_457","status":"contextual_provisional"},{"id":"c-jinshu-073-yu-yi-bing-tiao:line094:m0048","start":48,"end":49,"surface":"健","kind":"person","person_id":"8f5_74b_457","status":"contextual_provisional"},{"id":"c-jinshu-073-yu-yi-bing-tiao:line094:m0060","start":60,"end":61,"surface":"冰","kind":"person","person_id":"4qr_wrk_3vd_D","status":"contextual_provisional"},{"id":"c-jinshu-073-yu-yi-bing-tiao:line094:m0064","start":64,"end":65,"surface":"健","kind":"person","person_id":"8f5_74b_457","status":"contextual_provisional"},{"id":"c-jinshu-073-yu-yi-bing-tiao:line094:m0066","start":66,"end":67,"surface":"之","kind":"person","person_id":"8f5_74b_457","status":"contextual_provisional"},{"id":"c-jinshu-073-yu-yi-bing-tiao:line094:m0084","start":84,"end":86,"surface":"滕含","kind":"person","person_id":"9ef_a32_155","status":"contextual_provisional"},{"id":"c-jinshu-073-yu-yi-bing-tiao:line094:m0095","start":95,"end":96,"surface":"冰","kind":"person","person_id":"4qr_wrk_3vd_D","status":"contextual_provisional"},{"id":"c-jinshu-073-yu-yi-bing-tiao:line094:m0126","start":126,"end":128,"surface":"郗鑒","kind":"person","person_id":"6lr_zci_i0j","status":"contextual_provisional"}],"source_position":{"first_line":94,"last_line":94,"revision_id":2296501,"editorial_excerpt_boundary":false},"text_layer":"received_chapter","chapter_id":"c-jinshu-073-yu-yi-bing-tiao","book_id":"b-jinshu-073","work_id":"w-jinshu","source_id":"s-jinshu-073-yu-yi-bing-tiao"},{"id":"c-jinshu-100-phase5-sujun:line125","text":"時溫嶠、陶侃已唱義于武昌，峻聞兵起，用參軍賈甯計，還據石頭，更分兵距諸義軍，所過無不殘滅。嶠等將至，峻遂遷天子于石頭，逼迫居人，盡聚之後苑，使懷德令匡術守苑城。嶠等既到，乃築壘于白石，峻率眾攻之，幾至陷沒。東西抄掠，多所擒虜，兵威日盛，戰無不克，由是義眾沮衄，人懷異計。朝士之奔義軍者，皆云：「峻狡黠有智力，其徒黨驍勇，所向無敵。惟當以天討有罪，誅滅不久；若以人事言之，未易除也。」溫嶠怒曰：「諸君怯懦，乃是譽賊。」及後累戰不捷，嶠亦深憚之。管商等進攻吳郡，焚吳縣、海監、嘉興，敗諸義軍。韓晃又攻宣城，害太守桓彝。商等又焚余杭，而大敗于武康，退還義興。嶠與趙胤率步兵萬人，從白石南上，欲以臨之。峻與匡孝將八千人逆戰，峻遣子碩與孝以數十騎先薄趙胤，敗之。峻望見胤走，曰：「孝能破賊，我更不如乎！」因舍其眾，與數騎北下突陣，不得入，將回趨白木陂，牙門彭世、李千等投之以矛，墜馬，斬首臠割之，焚其骨，三軍皆稱萬歲。峻司馬任讓等共立峻弟逸為主。求峻屍不獲，碩乃發庾亮父母墓，剖棺焚屍。逸閉城自守。韓晃聞峻死，引兵赴石頭。管商及弘徽進攻庱亭壘，督護李閎及輕車長史滕含擊破之，斬首千級。商率眾走延陵，李閎與庱亭諸軍追之，斬獲數千級。商詣庾亮降，匡術舉苑城降。韓晃與蘇逸等並力攻術，不能陷。溫嶠等選精銳將攻賊營，碩率驍勇數百渡淮而戰，於陣斬碩。晃等震懼，以其眾奔張健于曲阿，門厄不得出，更相蹈藉，死者萬數。逸為李湯所執，斬于車騎府。","mentions":[{"id":"c-jinshu-100-phase5-sujun:line125:m0001","start":1,"end":3,"surface":"溫嶠","kind":"person","person_id":"6v8_pk9_7k5"},{"id":"c-jinshu-100-phase5-sujun:line125:m0004","start":4,"end":6,"surface":"陶侃","kind":"person","person_id":"twd_erg_kmz"},{"id":"c-jinshu-100-phase5-sujun:line125:m0013","start":13,"end":14,"surface":"峻","kind":"person","person_id":"lrg_cze_g1l"},{"id":"c-jinshu-100-phase5-sujun:line125:m0021","start":21,"end":23,"surface":"賈甯","kind":"person","person_id":"7e6_202_9b5"},{"id":"c-jinshu-100-phase5-sujun:line125:m0045","start":45,"end":46,"surface":"嶠","kind":"person","person_id":"6v8_pk9_7k5"},{"id":"c-jinshu-100-phase5-sujun:line125:m0050","start":50,"end":51,"surface":"峻","kind":"person","person_id":"lrg_cze_g1l"},{"id":"c-jinshu-100-phase5-sujun:line125:m0053","start":53,"end":55,"surface":"天子","kind":"person","person_id":"dkn_ge4_286_AAAAAAAAA"},{"id":"c-jinshu-100-phase5-sujun:line125:m0061","start":61,"end":63,"surface":"居人","kind":"unresolved","person_id":null,"status":"unresolved","resolution_note":"被遷後苑居民集合，未逐名。"},{"id":"c-jinshu-100-phase5-sujun:line125:m0066","start":66,"end":67,"surface":"之","kind":"unresolved","person_id":null,"status":"unresolved","resolution_note":"居民群體代詞。"},{"id":"c-jinshu-100-phase5-sujun:line125:m0074","start":74,"end":76,"surface":"匡術","kind":"person","person_id":"44b_097_e2b"},{"id":"c-jinshu-100-phase5-sujun:line125:m0080","start":80,"end":81,"surface":"嶠","kind":"person","person_id":"6v8_pk9_7k5"},{"id":"c-jinshu-100-phase5-sujun:line125:m0092","start":92,"end":93,"surface":"峻","kind":"person","person_id":"lrg_cze_g1l"},{"id":"c-jinshu-100-phase5-sujun:line125:m0135","start":135,"end":137,"surface":"朝士","kind":"unresolved","person_id":null,"status":"unresolved","resolution_note":"奔義軍的官員集合，未名。"},{"id":"c-jinshu-100-phase5-sujun:line125:m0147","start":147,"end":148,"surface":"峻","kind":"person","person_id":"lrg_cze_g1l"},{"id":"c-jinshu-100-phase5-sujun:line125:m0154","start":154,"end":155,"surface":"其","kind":"person"