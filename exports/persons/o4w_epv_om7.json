ths":[],"mentions":[{"id":"c-jinshu-070-ganzhuo:p003:m0136","surface":"谷儉","start":136,"end":138,"person_id":"o4w_epv_om7","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-070-ganzhuo:p003","chapter_id":"c-jinshu-070-ganzhuo"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-070-ganzhuo:p003","text":"中興初，以邊寇未靜，學校陵遲，特聽不試孝廉，而秀才猶依舊策試。卓上疏以爲：「答問損益，當須博通古今，明達政體，必求諸墳索，乃堪其舉。臣所忝州往遭寇亂，學校久替，人士流播，不得比之餘州。策試之由，當藉學功，謂宜同孝廉例，申與期限。」疏奏，朝議不許。卓於是精加隱括，備禮舉桂陽谷儉爲秀才。儉辭不獲命，州厚禮遣之。諸州秀才聞當考試，皆憚不行，惟儉一人到臺，遂不復策試。儉恥其州少士，乃表求試，以高第除中郎。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":40,"last_line":40,"raw_start":3227,"raw_end":3443,"raw_character_offsets":[3234,3235,3236,3237,3238,3239,3240,3241,3242,3243,3244,3245,3246,3247,3248,3249,3250,3251,3252,3253,3254,3255,3256,3257,3258,3259,3260,3261,3262,3263,3264,3265,3266,3267,3268,3269,3270,3271,3279,3280,3281,3282,3283,3284,3285,3286,3287,3288,3289,3290,3291,3292,3293,3294,3295,3296,3297,3298,3299,3300,3301,3302,3303,3304,3305,3306,3307,3308,3309,3310,3311,3312,3313,3314,3315,3316,3317,3318,3319,3320,3321,3322,3323,3324,3325,3326,3327,3328,3329,3330,3331,3332,3333,3334,3335,3336,3337,3338,3339,3340,3341,3342,3343,3344,3345,3346,3347,3348,3349,3350,3351,3352,3353,3354,3357,3358,3359,3360,3361,3362,3363,3364,3365,3366,3367,3368,3369,3370,3371,3372,3373,3374,3375,3376,3377,3378,3379,3380,3381,3382,3383,3384,3385,3386,3387,3388,3389,3390,3391,3392,3393,3394,3395,3396,3397,3398,3399,3400,3401,3402,3403,3404,3405,3406,3407,3408,3409,3410,3411,3412,3413,3414,3415,3416,3417,3418,3419,3420,3421,3422,3423,3424,3425,3426,3427,3428,3429,3430,3431,3432,3433,3434,3435,3436,3437,3438,3439,3440,3441,3442],"revision_id":2595540},"mentions":[{"id":"c-jinshu-070-ganzhuo:p003:m0136","surface":"谷儉","st