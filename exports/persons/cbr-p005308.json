{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p005308","identity_policy":"contextual_provisional","person_ids":["cbr-p005308"],"persons":[{"id":"cbr-p005308","label":"陳勝（樊酈滕灌列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"陳勝","mention_ids":["c-shiji-095-fankuang:m011-0011"]}],"evidence":[{"mention_id":"c-shiji-095-fankuang:m011-0011","chapter_id":"c-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p011","quote":"陳勝"}]}],"mentions":[{"id":"c-shiji-095-fankuang:m011-0011","start":11,"end":13,"surface":"陳勝","kind":"person","person_id":"cbr-p005308","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p011","chapter_id":"c-shiji-095-fankuang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji095-058","person_id":"cbr-p005308","scope":"same_chapter","chapter_ids":["c-shiji-095-fankuang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["陳勝"],"evidence":[{"paragraph_id":"c-shiji-095-fankuang:p011","quote":"曲周侯酈商者，高陽人。陳勝起時，商聚少年東西略人，得數千。沛公略地至陳留，六月餘，商以將卒四千人屬沛公於岐。從攻長社，先登，賜爵封信成君。從沛公攻緱氏，絕河津，破秦軍洛陽東。從攻下宛、穰，定十七縣。別將攻旬關，定漢中。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定異稱。酈寄字況據第14段；夏侯嬰的嬰限定第16至21段，灌嬰限定第22至33段，桓嬰另人。第6與20、28段楚王信和反韓王信分人；未詳名王侯不補名。同名跨篇同指另待逐項證據。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-095-fankuang:p011","text":"曲周侯酈商者，高陽人。陳勝起時，商聚少年東西略人，得數千。沛公略地至陳留，六月餘，商以將卒四千人屬沛公於岐。從攻長社，先登，賜爵封信成君。從沛公攻緱氏，絕河津，破秦軍洛陽東。從攻下宛、穰，定十七縣。別將攻旬關，定漢中。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m011-0003","start":3,"end":5,"surface":"酈商","kind":"person","person_id":"cbr-p005307","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m011-0011","start":11,"end":13,"surface":"陳勝","kind":"person","person_id":"cbr-p005308","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m011-0016",