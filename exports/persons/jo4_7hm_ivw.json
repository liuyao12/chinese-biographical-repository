-098-wangdun-comparison:p023:m0335"],"paragraph_ids":["c-jinshu-098-wangdun-comparison:p023"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-098-wangdun-comparison:p023:m0335","mention_ids":["c-jinshu-098-wangdun-comparison:p023:m0335"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-061-ws7903772","s-jinshu098-wangdun-ws2614273-comparison"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-061-zhou-family:p014:m0098","start":98,"end":100,"surface":"周筵","kind":"person","person_id":"jo4_7hm_ivw","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。","paragraph_id":"c-jinshu-061-zhou-family:p014","chapter_id":"c-jinshu-061-zhou-family"},{"id":"c-jinshu-098-wangdun-comparison:p023:m0335","start":335,"end":337,"surface":"周莚","person_id":"jo4_7hm_ivw","kind":"person","paragraph_id":"c-jinshu-098-wangdun-comparison:p023","chapter_id":"c-jinshu-098-wangdun-comparison"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-jin098-zhouyan","person_id":"jo4_7hm_ivw","surfaces":["周莚"],"scope":"cross_chapter","chapter_ids":["c-jinshu-098-wangdun-comparison","c-jinshu-061-zhou-family"],"status":"contextual_provisional","confidence_level":"moderate","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-098","source_id":"s-jinshu098-wangdun-ws2614273-comparison","chapter_id":"c-jinshu-098-wangdun-comparison","paragraph_id":"c-jinshu-098-wangdun-comparison:p023","quote":"先帝以聖德應運，創業江東，司徒導首居心膂，以道翼讚。故大將軍敦參處股肱，或內或外，夾輔之勳，與有力焉。階緣際會，遂據上宰，杖節專征，委以五州。刁協、劉隗立朝不允，敦抗義致討，情希鬻拳，兵雖犯順，猶嘉乃誠，禮秩優崇，人臣無貳。事解之後，劫掠城邑，放恣兵人，侵及宮省；背違赦信，誅戮大臣；縱凶極逆，不朝而退。六合阻心，人情同憤。先帝含垢忍恥，容而不責，委任如舊，禮秩有加。朕以不天，尋丁酷罰，煢煢在疚，哀悼靡寄。而敦曾無臣子追遠之誠，又無輔孤同獎之操，繕甲聚兵，盛夏來至，輒以天官假授私屬，將以威脅朝廷，傾危宗社。朕湣其狂戾，冀其覺悟，故且含隱以觀其終。而敦矜其不義之強，有侮弱朝廷之志，棄親用羈，背賢任惡。錢鳳豎子，專為謀主，逞其凶慝，誣罔忠良。周嵩亮直，讜言致禍；周劄、周莚累世忠義，聽受讒構，殘夷其宗。秦人之酷，刑不過五。敦之誅戮，傍濫無辜，滅人之族，莫知其罪。天下駭心，道路以目。神怒人怨，篤疾所嬰，昏荒悖逆，日以滋其，輒立兄息以自承代，多樹私黨，莫非同惡，未有宰相繼體而不由王命者也。頑凶相獎，無所顧忌，擅錄冶工，輒割運漕，志騁凶醜，以窺神器。社稷之危，匪夕則旦。天下長奸，敦以隕斃。鳳承凶宄，彌復煽逆。是可忍也，孰不可忍也！","mention_ids":["c-jinshu-098-wangdun-comparison:p023:m0335"]},{"work_id":"w-jinshu","book_id":"b-jinshu-061","source_id":"s-jinshu-061-ws7903772","chapter_id":"c-jinshu-061-zhou-family","paragraph_id":"c-jinshu-061-zhou-family:p014","quote":"王敦既害顗而使人吊嵩，嵩曰：「亡兄天下人，為天下人所殺，復何所吊！」敦甚銜之，懼失人情，故未加害，用為從事中郎。嵩，王應嫂父也，以顗橫遇禍，意恆憤憤，嘗眾中云：「應不宜統兵。」敦密使妖人李脫誣嵩及周筵潛相署置，遂害之。嵩精於事佛，臨刑猶於市誦經云。","mention_id":"c-jinshu-061-zhou-family:p014:m0098"}],"rationale":"完整本源敘事的姓名/稱號、在位階段或往來事件與現役來源角色相合；引古只判同指，不作在場/任職/故事史實已證。","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-061-zhou-family:p014","text":"王敦既害顗而使人吊嵩，嵩曰：「亡兄天下人，為天下人所殺，復何所吊！」敦甚銜之，懼失人情，故未加害，用為從事中郎。嵩，王應嫂父也，以顗橫遇禍，意恆憤憤，嘗眾中云：「應不宜統兵。」敦密使妖人李脫誣嵩及周筵潛相署置，遂害之。嵩精於事佛，臨刑猶於市誦經云。","source_position":{"raw_start":2608,"raw_end":2734,"raw_text":"　　王敦既害顗而使人吊嵩，嵩曰：「亡兄天下人，為天下人所殺，復何所吊！」敦甚銜之，懼失人情，故未加害，用為從事中郎。嵩，王應嫂父也，以顗橫遇禍，意恆憤憤，嘗眾中云：「應不宜統兵。」敦密使妖人李脫誣嵩及周筵潛相署置，遂害之。嵩精於事佛，臨刑猶於市誦經云。","display_wrapper_start":0,"display_wrapper_end":0,"raw_path":"sources/jinshu/wikisource-7903772-raw.wikitext"},"mentions":[{"id":"c-jinshu-061-zhou-family:p014:m0000","start":0,"end":2,"surface":"王敦","kind":"person","person_id":"7r6_k52_qji_ABBA","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p014:m0004","start":4,"end":5,"surface":"顗","kind":"person","person_id":"3xx_gdy_or6_AAA","status":"contextual_provisional","interpretation_note":"069完整本傳明父浚、弟嵩、子閔，與061三代脈絡相合。"},{"id":"c-jinshu-061-zhou-family:p014:m0009","start":9,"end":10,"surface":"嵩","kind":"person","person_id":"3xx_gdy_or6_AAB","status":"contextual_provisional","interpretation_note":"069顗傳弟嵩與本061明三子相合；非賁嵩。"},{"id":"c-jinshu-061-zhou-family:p014:m0011","start":11,"end":12,"surface":"嵩","kind":"person","person_id":"3xx_gdy_or6_AAB","status":"contextual_provisional","interpretation_note":"069顗傳弟嵩與本061明三子相合；非賁嵩。"},{"id":"c-jinshu-061-zhou-family:p014:m0015","start":15,"end":17,"surface":"亡兄","kind":"person","person_id":"3xx_gdy_or6_AAA","status":"contextual_provisional","interpretation_note":"069完整本傳明父浚、弟嵩、子閔，與061三代脈絡相合。"},{"id":"c-jinshu-061-zhou-family:p014:m0034","start":34,"end":35,"surface":"敦","kind":"person","person_id":"7r6_k52_qji_ABBA","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p014:m0056","start":56,"end":57,"surface":"嵩","kind":"person","person_id":"3xx_gdy_or6_AAB","status":"contextual_provisional","interpretation_note":"069顗傳弟嵩與本061明三子相合；非賁嵩。"},{"id":"c-jinshu-061-zhou-family:p014:m0058","start":58,"end":60,"surface":"王應","kind":"person","person_id":"mwc_md4_l0g_A","status":"contextual_provisional","interpretation_note":"與王敦及周顗遭害共同事件接既有王應；嫂之丈夫仍未名。"},{"id":"c-jinshu-061-zhou-family:p014:m0060","start":60,"end":61,"surface":"嫂","kind":"person","person_id":"3xx_gdy_or6_AABA","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p014:m0065","start":65,"end":66,"surface":"顗","kind":"person","person_id":"3xx_gdy_or6_AAA",