on_id":"6re_l9t_wfh","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-064-jin044-luzhi:parent","chapter_id":"c-jinshu-064-jin044-luzhi"}],"relations":[{"id":"a-w044-luzhi-chengmu","subject_person_id":"e81_f09_000","object_person_id":"6re_l9t_wfh","predicate":"mother","qualifiers":{"source_term":"程才人生成都王穎。"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-064","chapter_id":"c-jinshu-064-jin044-luzhi","source_id":"s-jinshu-064-jin044-luzhi","paragraph_id":"c-jinshu-064-jin044-luzhi:parent","quote":"程才人生成都王穎。","subject_person_mention_id":"c-jinshu-064-jin044-luzhi:parent:m0004","object_person_mention_id":"c-jinshu-064-jin044-luzhi:parent:m0000"}],"interpretation_note":"此條按本句所明言。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"title_holdings":[{"id":"th-w044-luzhi-9","person_id":"6re_l9t_wfh","title":"太妃","kind":"royal_rank","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-044","chapter_id":"c-jinshu-044-luzhi","source_id":"s-jinshu-044-luzhi","paragraph_id":"c-jinshu-044-luzhi:line060","quote":"及乂死，穎表志為中書監，留鄴，參署相府事。乘與敗于蕩陰，穎遣志督兵迎帝。及王浚攻鄴，志勸穎奉天子還洛陽。時甲士尚萬五千人，志夜部分，至曉，眾皆成列，而程太妃戀鄴不欲去，穎未能決。俄而眾潰，唯志與子謐、兄子綝、殿中武賁千人而已，志復勸穎早發。時有道士姓黃，號曰聖人，太妃信之。及使呼人，道士求兩杯酒，飲訖，拋杯而去，於是志計始決。而人馬復散，志于營陣間尋索，得數乘鹿車，司馬督韓玄收集黃門，得百餘人。志入，帝問志曰：「何故散敗至此？」志曰：「賊去鄴尚八十里，而人士一朝駭散，太弟今欲奉陛下還洛陽。」帝曰：「甚佳。」於是禦犢車便發。屯騎校尉郝昌先領兵八千守洛陽，帝召之，至汲郡而昌至，兵仗甚盛。志喜於復振，啟天子宜下赦書，與百姓同其休慶。既達洛陽，志啟以滿奮為司隸校尉。奔散者多還，百官粗備，帝悅，賜志絹二百匹、綿百斤、衣一襲、鶴綾袍一領。","person_mention_id":"c-jinshu-044-luzhi:line060:m0075"}],"attestations":[{"id":"th-w043-luzhi-9:a","paragraph_id":"c-jinshu-044-luzhi:line060","start":76,"end":78,"surface":"太妃","person_mention_id":"c-jinshu-044-luzhi:line060:m0075","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"person_references":[{"id":"c-jinshu-044-luzhi:line056:r0387","paragraph_id":"c-jinshu-044-luzhi:line056","start":387,"end":388,"surface":"母","person_id":"6re_l9t_wfh","referent_role":"third_person","quote":"計之上也。」穎納之，遂以母疾還籓，委重於冏。由是穎","note":"依所引原句及對話角色辨識。","chapter_id":"c-jinshu-044-luzhi","book_id":"b-jinshu-044","work_id":"w-jinshu","source_id":"s-jinshu-044-luzhi"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-044-luzhi:line056","text":"志字子道，初辟公府掾、尚書郎，出為鄴令。成都王穎之鎮鄴也，愛其才量，委以心膂，遂為謀主。齊王冏起義，遣使告穎。穎召志計事，志曰：「趙王無道，肆行篡逆，四海人神，莫不憤怒。今殿下總率三軍，應期電發，子來之眾，不召自至。掃夷凶逆，必有征無戰。然兵事至重，聖人所慎。宜旌賢任才，以收時望。」穎深然之，改選上佐，高辟掾屬，以志為諮議參軍，仍補左長史，專掌文翰。穎前鋒都督趙驤為倫所敗，士眾震駭，議者多欲還保朝歌。志曰：「今我軍失利，敵新得勝，必有輕易陵轢之情，若頓兵不進，三軍畏衄，懼不可用。且戰何能無勝負，宜更選精兵，星行倍道，出賊不意，此用兵之奇也。」穎從之。及倫敗，志勸穎曰：「齊王眾號百萬，與張泓等相持不能決，大王逕得濟河，此之大勳，莫之與比，而齊王今當與大王共輔朝政。志聞兩雄不俱處，功名不並立，今宜因太妃微疾，求還定省，推崇齊王，徐結四海之心，此計之上也。」穎納之，遂以母疾還籓，委重於冏。由是穎獲四海之譽，天下歸心。朝廷封志為武強侯，加散騎常侍。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-044-luzhi:line056:m0000","start":0,"end":1,"surface":"志","kind":"person","person_id":"m8n_ntm_79h_ABB","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line056:m0002","start":2,"end":4,"surface":"子道","kind":"person","person_id":"m8n_ntm_79h_ABB","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line056:m0020","start":20,"end":24,"surface":"成都王穎","kind":"person","person_id":"e81_f09_000","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line056:m0044","start":44,"end":47,"surface":"齊王冏","kind":"person","person_id":"ee0_b2a_68e","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line056:m0053","start":53,"end":54,"surface":"