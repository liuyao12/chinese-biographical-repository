{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"4k0_mri_buk","canonical_person_id":"4k0_mri_buk","id_aliases":["cbr-p005284"],"identity_policy":"contextual_provisional","person_ids":["4k0_mri_buk"],"persons":[{"id":"4k0_mri_buk","label":"盧綰（樊酈滕灌列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"盧綰","mention_ids":["c-shiji-095-fankuang:m006-0278","c-shiji-095-fankuang:m006-0287","c-shiji-095-fankuang:m009-0002"]}],"evidence":[{"mention_id":"c-shiji-095-fankuang:m006-0278","chapter_id":"c-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p006","quote":"盧綰"},{"mention_id":"c-shiji-095-fankuang:m006-0287","chapter_id":"c-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p006","quote":"盧綰"},{"mention_id":"c-shiji-095-fankuang:m009-0002","chapter_id":"c-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p009","quote":"盧綰"}],"id_aliases":["cbr-p005284"]}],"source_mention_summary":[{"source_id":"s-shiji-095-fankuang","work_id":"w-shiji","book_id":"b-shiji-095","chapter_id":"c-shiji-095-fankuang","mention_count":3,"mention_ids":["c-shiji-095-fankuang:m006-0278","c-shiji-095-fankuang:m006-0287","c-shiji-095-fankuang:m009-0002"],"paragraph_ids":["c-shiji-095-fankuang:p006","c-shiji-095-fankuang:p009"],"passage_count":2}],"most_mentioned_source_ids":["s-shiji-095-fankuang"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-095-fankuang:m006-0278","start":278,"end":280,"surface":"盧綰","kind":"person","person_id":"4k0_mri_buk","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p006","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:m006-0287","start":287,"end":289,"surface":"盧綰","kind":"person","person_id":"4k0_mri_buk","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p006","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:m009-0002","start":2,"end":4,"surface":"盧綰","kind":"person","person_id":"4k0_mri_buk","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p009","chapter_id":"c-shiji-095-fankuang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji095-034","person_id":"4k0_mri_buk","scope":"same_chapter","chapter_ids":["c-shiji-095-fankuang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["盧綰"],"evidence":[{"paragraph_id":"c-shiji-095-fankuang:p006","quote":"項籍既死，漢王為帝，以噲堅守戰有功，益食八百戶。從高帝攻反燕王臧荼，虜荼，定燕地。楚王韓信反，噲從至陳，取信，定楚。更賜爵列侯，與諸侯剖符，世世勿絕，食舞陽，號為舞陽侯，除前所食。以將軍從高祖攻反韓王信於代。自霍人以往至雲中，與絳侯等共定之，益食千五百戶。因擊陳豨與曼丘臣軍，戰襄國，破柏人，先登，降定清河、常山凡二十七縣，殘東垣，遷為左丞相。破得綦毋卹、尹潘軍於無終、廣昌。破豨別將胡人王黃軍於代南，因擊韓信軍於參合。軍所將卒斬韓信，破豨胡騎橫谷，斬將軍趙既，虜代丞相馮梁、守孫奮、大將王黃、將軍、（太卜）太仆解福等十人。與諸將共定代鄉邑七十三。其後燕王盧綰反，噲以相國擊盧綰，破其丞相抵薊南，定燕地，凡縣十八，鄉邑五十一。益食邑千三百戶，定食舞陽五千四百戶。從，斬首百七十六級，虜二百八十八人。別，破軍七，下城五，定郡六，縣五十二，得丞相一人，將軍十二人，二千石已下至三百石十一人。"},{"paragraph_id":"c-shiji-095-fankuang:p009","quote":"其後盧綰反，高帝使噲以相國擊燕。是時高帝病甚，人有惡噲黨於呂氏，即上一日宮車晏駕，則噲欲以兵盡誅滅戚氏、趙王如意之屬。高帝聞之大怒，乃使陳平載絳侯代將，而即軍中斬噲。陳平畏呂后，執噲詣長安。至則高祖已崩，呂后釋噲，使復爵邑。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定異稱。酈寄字況據第14段；夏侯嬰的嬰限定第16至21段，灌嬰限定第22至33段，桓嬰另人。第6與20、28段楚王信和反韓王信分人；未詳名王侯不補名。同名跨篇同指另待逐項證據。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-095-fankuang:p006","text":"項籍既死，漢王為帝，以噲堅守戰有功，益食八百戶。從高帝攻反燕王臧荼，虜荼，定燕地。楚王韓信反，噲從至陳，取信，定楚。更賜爵列侯，與諸侯剖符，世世勿絕，食舞陽，號為舞陽侯，除前所食。以將軍從高祖攻反韓王信於代。自霍人以往至雲中，與絳侯等共定之，益食千五百戶。因擊陳豨與曼丘臣軍，戰襄國，破柏人，先登，降定清河、常山凡二十七縣，殘東垣，遷為左丞相。破得綦毋卹、尹潘軍於無終、廣昌。破豨別將胡人王黃軍於代南，因擊韓信軍於參合。軍所將卒斬韓信，破豨胡騎橫谷，斬將軍趙既，虜代丞相馮梁、守孫奮、大將王黃、將軍、（太卜）太仆解福等十人。與諸將共定代鄉邑七十三。其後燕王盧綰反，噲以相國擊盧綰，破其丞相抵薊南，定燕地，凡縣十八，鄉邑五十一。益食邑千三百戶，定食舞陽五千四百戶。從，斬首百七十六級，虜二百八十八人。別，破軍七，下城五，定郡六，縣五十二，得丞相一人，將軍十二人，二千石已下至三百石十一人。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m006-0000","start":0,"end":2,"surface":"項籍","kind":"person","person_id":"qcp_ou0_2g1","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m006-0005","start":5,"end":7,"surface":"漢王","kind":"person","person_id":"vok_rjp_tag","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m006-0011","start":11,"end":12,"surface":"噲","kind":"person","person_id":"d9y_q1n_fte","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m006-0025","start":25,"end":27,"surface":"高帝","kind":"person","person_id":"vok_rjp_tag","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m006-0031","start":31,"end":33,"surface":"臧荼","kind":"person","person_id":"un2_jcz_dkt","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m006-0035","start":35,"end":36,"surface":"荼","kind":"person","person_id":"un2_jcz_dkt","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m006-0041","start":41,"end":45,"surface":"楚王韓信","kind":"person","person_id":"j4e_gam_0tl","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m006-0047","start":47,"end":48,"surface":"噲","kind":"person","person_id":"d9y_q1n_fte","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m006-0053","start":53,"end":54,"surface":"信","kind":"person","person_id":"j4e_gam_0tl","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m006-0094","start":94,"end":96,"surface":"高祖","kind":"person","person_id":"vok_rjp_tag","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m006-0098","start":98,"end":101,"surface":"韓王信","kind":"person","person_id":"39e_wj9_6m0","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m006-0114","start":114,"end":116,"surface":"絳侯","kind":"person","person_id":"s8n_dgg_60b","status":"contextu