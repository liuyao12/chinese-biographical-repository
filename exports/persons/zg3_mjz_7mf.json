true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-064-simachong:p001:m0086","surface":"劉耽","start":86,"end":88,"person_id":"zg3_mjz_7mf","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-064-simachong:p001","chapter_id":"c-jinshu-064-simachong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-064-simachong:p001","text":"東海哀王沖，字道讓。元帝以東海王越世子毗沒于石勒，不知存亡，乃以沖繼毗後，稱東海世子，以毗陵郡增本封邑萬戶，又改食下邳、蘭陵，以越妃裴氏為太妃，拜長水校尉。高選僚佐，以沛國劉耽為司馬，潁川庾懌為功曹，吳郡顧和為主簿。永昌初，遷中軍將軍，加散騎常侍。及東海太妃薨，因發毗喪。沖即王位，以滎陽益東海國，轉車騎將軍，徙驃騎將軍。咸康七年薨，年三十一，贈侍中、驃騎大將軍、儀同三司，無子。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":72,"last_line":72,"raw_start":3997,"raw_end":4196,"raw_character_offsets":[3999,4000,4001,4002,4003,4004,4005,4006,4007,4008,4009,4010,4011,4012,4013,4014,4015,4016,4017,4018,4019,4020,4021,4022,4023,4024,4025,4026,4027,4028,4029,4030,4031,4032,4033,4034,4035,4036,4037,4038,4039,4040,4041,4042,4043,4044,4045,4046,4047,4048,4049,4050,4051,4052,4053,4054,4055,4056,4057,4058,4059,4060,4061,4062,4063,4064,4065,4066,4067,4068,4069,4070,4071,4072,4073,4074,4075,4076,4077,4078,4079,4080,4081,4082,4083,4084,4085,4086,4087,4088,4089,4090,4091,4092,4093,4094,4095,4096,4097,4098,4099,4100,4101,4102,4103,4104,4105,4106,4107,4108,4109,4110,4111,4112,4113,4114,4115,4116,4117,4118,4119,4120,4121,4122,4123,4124,4125,4126,4127,4128,4129,4130,4131,4132,4133,4134,4135,4136,4137,4138,4139,4140,4141,4142,4143,4144,4145,4146,4147,4148,4149,4150,4151,4152,4153,4154,4155,4156,4157,4158,4159,4165,4166,4167,4168,4171,4172,4173,4174,4175,4176,4177,4178,4179,4180,4181,4182,4183,4184,4185,4186,4187,4188,4189,4190,4191,4192,4193,4194,4195],"revision_id":2622004},"mentions":[{"id":"c-jinshu-064-simachong:p001:m0000","surface":"東海哀王沖","start":