_id":"c-shiji-060-sanwang","book_id":"b-shiji-060","work_id":"w-shiji","source_id":"s-shiji-060-sanwang"},{"id":"c-shiji-060-sanwang:p010","text":"四月丁酉，奏未央宮。六年四月戊寅朔，癸卯，御史大夫湯下丞相，丞相下中二千石，二千石下郡太守、諸侯相，丞書從事下當用者。如律令。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-060-sanwang:m010-0025","start":25,"end":26,"surface":"湯","kind":"person","person_id":"cbr-p003637","status":"contextual_provisional"},{"id":"c-shiji-060-sanwang:m010-0027","start":27,"end":29,"surface":"丞相","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、祖先或未定指代；不補未見姓名、成員或確定親屬。"},{"id":"c-shiji-060-sanwang:m010-0030","start":30,"end":32,"surface":"丞相","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、祖先或未定指代；不補未見姓名、成員或確定親屬。"},{"id":"c-shiji-060-sanwang:m010-0033","start":33,"end":37,"surface":"中二千石","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、祖先或未定指代；不補未見姓名、成員或確定親屬。"},{"id":"c-shiji-060-sanwang:m010-0038","start":38,"end":41,"surface":"二千石","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、祖先或未定指代；不補未見姓名、成員或確定親屬。"},{"id":"c-shiji-060-sanwang:m010-0042","start":42,"end":45,"surface":"郡太守","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、祖先或未定指代；不補未見姓名、成員或確定親屬。"},{"id":"c-shiji-060-sanwang:m010-0046","start":46,"end":49,"surface":"諸侯相","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、祖先或未定指代；不補未見姓名、成員或確定親屬。"},{"id":"c-shiji-060-sanwang:m010-0050","start":50,"end":52,"surface":"丞書","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、祖先或未定指代；不補未見姓名、成員或確定親屬。"}],"chapter_id":"c-shiji-060-sanwang","book_id":"b-shiji-060","work_id":"w-shiji","source_id":"s-shiji-060-sanwang"},{"id":"c-shiji-060-sanwang:p011","text":"「維六年四月乙巳，皇帝使御史大夫湯廟立子閎為齊王。曰：於戲，小子閎，受茲青社！朕承祖考，維稽古建爾國家，封于東土，世為漢藩輔。於戲念哉！抱朕之詔，惟命不于常。人之好德，克明顯光。義之不圖，俾君子怠。悉爾心，允執其中，天祿永終。厥有愆不臧，乃凶于而國，害于爾躬。於戲，保國艾民，可不敬與！王其戒之。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-060-sanwang:m011-0009","start":9,"end":11,"surface":"皇帝","kind":"person","person_id":"cbr-p003661","status":"contextual_provisional"},{"id":"c-shiji-060-sanwang:m011-0016","start":16,"end":17,"surface":"湯","kind":"person","person_id":"cbr-p003637","status":"contextual_provisional"},{"id":"c-shiji-060-sanwang:m011-0020","start":20,"end":21,"surface":"閎","kind":"person","person_id":"cbr-p003647","status":"contextual_provisional"},{"id":"c-shiji-060-sanwang:m011-0022","start":22,"end":24,"surface":"齊王","kind":"person","person_id":"cbr-p003647","status":"contextual_provisional"},{"id":"c-shiji-060-sanwang:m011-0032","start":32,"end":33,"surface":"閎","kind":"person","person_id":"cbr-p003647","status":"contextual_provisional"},{"id":"c-shiji-060-sanwang:m011-0041","start":41,"end":43,"surface":"祖考","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、祖先或未定指代；不補未見姓名、成員或確定親屬。"},{"id":"c-shiji-060-sanwang:m011-0095","start":95,"end":97,"surface":"君子","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、祖先或未定指代；不補未見姓名、成員或確定親屬。"}],"chapter_id":"c-shiji-060-sanwang","book_id":"b-shiji-060","work_id":"w-shiji","source_id":"s-shiji-060-sanwang"},{"id":"c-shiji-060-sanwang:p013","text":"「維六年四月乙巳，皇帝使御史大夫湯廟立子旦為燕王。曰：於戲，小子旦，受茲玄社！朕承祖考，維稽古，建爾國家，封于北土，世為漢藩輔。於戲！葷粥氏虐老獸心，侵犯寇盜，加以姦巧邊萌。於戲！朕命將率徂征厥罪，萬夫長，千夫長，三十有二君皆來，降期奔師。葷粥徙域，北州以綏。悉爾心，毋作怨，毋卹德，毋乃廢備。非教士不得從徵。於戲，保國艾民，可不敬與！王其戒之。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-060-sanwang:m013-0009","start":9,"end":11,"surface":"皇帝","kind":"person","person_id":"cbr-p003661","status":"contextual_provisional"},{"id":"c-shiji-060-sanwang:m013-0016","start":16,"end":17,"surface":"湯","kind":"person","person_id":"cbr-p003637","status":"contextual_provisional"},{"id":"c-shiji-060-sanwang:m013-0020","start":20,"end":21,"surface":"旦","kind":"person","person_id":"cbr-p003648","status":"contextual_provisional"},{"id":"c-shiji-060-sanwang:m013-0022","start":22,"end":24,"surface":"燕王","kind":"person","person_id":"cbr-p003648","status":"contextual_provisional"},{"id":"c-shiji-060-sanwang:m013-0032","start":32,"end":33,"surface":"旦","kind":"person","person_id":"cbr-p003648","status":"contextual_provisional"},{"id":"c-shiji-060-sanwang:m013-0041","start":41,"end":43,"surface":"祖考","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、祖先或未定指代；不補未見姓名、成員或確定親屬。"},{"id":"c-shiji-060-sanwang:m013-0067","start":67,"end":70,"surface":"葷粥氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、祖先或未定指代；不補未見姓名、成員或確定親屬。"},{"id":"c-shiji-060-sanwang:m013-0092","start":92,"end":94,"surface":"將率","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、祖先或未定指代；不補未見姓名、成員或確定親屬。"},{"id":"c-shiji-060-sanwang:m013-0099","start":99,"end":102,"surface":"萬夫長","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、祖先或未定指代；不補未見姓名、成員或確定親屬。"},{"id":"c-shiji-060-sanwang:m013-0103","start":103,"end":106,"surface":"千夫長","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、祖先或未定指代；不補未見姓名、成員或確定親屬。"},{"id":"c-shiji-060-sanwang:m013-0107","start":107,"end":112,"surface":"三十有二君","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、祖先或未定指代；不補未見姓名、成員或確定親屬。"},{"id":"c-shiji-060-sanwang:m013-0148","start":148,"end":150,"surface":"教士","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、祖先或未定指代；不補未見姓名、成員或確定親屬。"}],"chapter_id":"c-shiji-060-sanwang","book_id":"b-shiji-060","work_id":"w-shiji","source_id":"s-shiji-060-sanwang"},{"id":"c-shiji-060-sanwang:p015","text":"「維六年四月乙巳，皇帝使御史大夫湯廟立子胥為廣陵王。曰：於戲，小子胥，受茲赤社！朕承祖考，維稽古建爾國家，封于南土，世為漢藩輔。古人有言曰：『大江之南，五湖之閒，其人輕心。楊州保疆，三代要服，不及以政。』於戲！悉爾心，戰戰兢兢，乃惠乃順，毋侗好軼，毋邇宵人，維法維則。《書》云：『臣不作威，不作福，靡有後羞。』於戲，保國艾民，可不敬與！王其戒之。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-060-sanwang:m015-0009","start":9,"end":11,"surface":"皇帝","kind":"person","person_id":"cbr-p003661","status":"contextual_provisional"},{"id":"c-shiji-060-sanwang:m015-0016","start":16,"end":17,"surface":"湯","kind":"person","person_id":"cbr-p003637","status":"contextual_provisional"},{"id":"c-shiji-060-sanwang:m015-0020","start":20,"end":21,"surface":"胥","kind":"person","person_id":"cbr-p003649","status":"contextual_provisional"},{"id":"c-shiji-060-sanwang:m015-0022","start":22,"end":25,"surface":"廣陵王","kind":"person","person_id":"cbr-p003649","status":"contextual_provisional"},{"id":"c-shiji-060-sanwang:m015-0033","start":33,"end":34,"surface":"胥","kind":"person","person_id":"cbr-p003649","status":"contextual_provisional"},{"id":"c-shiji-060-sanwang:m015-0042","start":42,"end":44,"surface":"祖考","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、祖先或未定指代；不補未見姓名、成員或確定親屬。"},{"id":"c-shiji-060-sanwang:m015-0126","start":126,"end":128,"surface":"宵人","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、祖先或未定指代；不補未見姓名、成員或確定親屬。"}],"chapter_id":"c-shiji-060-sanwang","book_id":"b-shiji-060","work_id":"w-shiji","source_id":"s-shiji-060-sanwang"}],"sources":[{"chapter_id":"c-shiji-060-sanwang","work_id":"w-shiji","book_id":"b-shiji-060","source_id":"s-shiji-060-sanwang","source":{"title":"史記／卷060","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷060","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷060&oldid=7909290","revision_id":7909290,"accessed_on":"2026-10-09","extent":"32段來源區塊：前17段含奏議、三策及3處右某王策標記，後15段為褚先生附述。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"取得時HTML與固定修訂一致，只去外緣空白；保留太仆、承天于、酂、西（湊）［溱］、壃、箸、［立］廣陵王、墝埆、無卹德／無俷德、無修德、闕及滫等見證字與符號。3處dd為策後來源標記，保留在原序，不當導航排