person_id":"cbr-p003637","status":"contextual_provisional"},{"id":"c-shiji-060-sanwang:m006-0515","start":515,"end":516,"surface":"閎","kind":"person","person_id":"cbr-p003647","status":"contextual_provisional"},{"id":"c-shiji-060-sanwang:m006-0518","start":518,"end":519,"surface":"旦","kind":"person","person_id":"cbr-p003648","status":"contextual_provisional"},{"id":"c-shiji-060-sanwang:m006-0521","start":521,"end":522,"surface":"胥","kind":"person","person_id":"cbr-p003649","status":"contextual_provisional"}],"chapter_id":"c-shiji-060-sanwang","book_id":"b-shiji-060","work_id":"w-shiji","source_id":"s-shiji-060-sanwang"},{"id":"c-shiji-060-sanwang:p007","text":"「丞相臣青翟、太仆臣賀、行御史大夫事太常臣充、太子少傅臣安行宗正事昧死言：臣青翟等前奏大司馬臣去病上疏言，皇子未有號位，臣謹與御史大夫臣湯、中二千石、二千石、諫大夫、博士臣慶等昧死請立皇子臣閎等為諸侯王。陛下讓文武，躬自切，及皇子未教。群臣之議，儒者稱其術，或誖其心。陛下固辭弗許，家皇子為列侯。臣青翟等竊與列侯臣壽成等二十七人議，皆曰以為尊卑失序。高皇帝建天下，為漢太祖，王子孫，廣支輔。先帝法則弗改，所以宣至尊也。臣請令史官擇吉日，具禮儀上，御史奏輿地圖，他皆如前故事。」制曰：「可。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-060-sanwang:m007-0004","start":4,"end":6,"surface":"青翟","kind":"person","person_id":"cbr-p003636","status":"contextual_provisional"},{"id":"c-shiji-060-sanwang:m007-0010","start":10,"end":11,"surface":"賀","kind":"person","person_id":"cbr-p003641","status":"contextual_provisional"},{"id":"c-shiji-060-sanwang:m007-0021","start":21,"end":22,"surface":"充","kind":"person","person_id":"cbr-p003638","status":"contextual_provisional"},{"id":"c-shiji-060-sanwang:m007-0023","start":23,"end":29,"surface":"太子少傅臣安","kind":"person","person_id":"cbr-p003640","status":"contextual_provisional"},{"id":"c-shiji-060-sanwang:m007-0038","start":38,"end":40,"surface":"青翟","kind":"person","person_id":"cbr-p003636","status":"contextual_provisional"},{"id":"c-shiji-060-sanwang:m007-0047","start":47,"end":49,"surface":"去病","kind":"person","person_id":"cbr-p003633","status":"contextual_provisional"},{"id":"c-shiji-060-sanwang:m007-0068","start":68,"end":69,"surface":"湯","kind":"person","per