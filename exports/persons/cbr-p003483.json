{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003483","identity_policy":"contextual_provisional","person_ids":["cbr-p003483"],"persons":[{"id":"cbr-p003483","label":"潁校勘侯（絳侯周勃世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"潁（陽）［陰］侯","mention_ids":["c-shiji-057-zhou:m003-0175"]}],"evidence":[{"mention_id":"c-shiji-057-zhou:m003-0175","chapter_id":"c-shiji-057-zhou","paragraph_id":"c-shiji-057-zhou:p003","quote":"潁（陽）［陰］侯"}]}],"source_mention_summary":[{"source_id":"s-shiji-057-zhou","work_id":"w-shiji","book_id":"b-shiji-057","chapter_id":"c-shiji-057-zhou","mention_count":1,"mention_ids":["c-shiji-057-zhou:m003-0175"],"paragraph_ids":["c-shiji-057-zhou:p003"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-057-zhou"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-057-zhou:m003-0175","start":175,"end":183,"surface":"潁（陽）［陰］侯","kind":"person","person_id":"cbr-p003483","status":"contextual_provisional","paragraph_id":"c-shiji-057-zhou:p003","chapter_id":"c-shiji-057-zhou"}],"relations":[],"title_holdings":[{"id":"th-shiji057-014","person_id":"cbr-p003483","title":"潁（陽）［陰］侯","kind":"noble_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-057-zhou","source_id":"s-shiji-057-zhou","paragraph_id":"c-shiji-057-zhou:p003","quote":"項羽至，以沛公為漢王。漢王賜勃爵為威武侯。從入漢中，拜為將軍。還定三秦，至秦，賜食邑懷德。攻槐裏、好畤，最。擊趙賁、內史保於咸陽，最。北攻漆。擊章平、姚卬軍。西定汧。還下郿、頻陽。圍章邯廢丘。破西丞。擊盜巴軍，破之。攻上邽。東守峣關。轉擊項籍。攻曲逆，最。還守敖倉，追項籍。籍已死，因東定楚地泗（川）［水］、東海郡，凡得二十二縣。還守雒陽、櫟陽，賜與潁（陽）［陰］侯共食鐘離。以將軍從高帝反者燕王臧荼，破之易下。所將卒當馳道為多。賜爵列侯，剖符世世勿絕。食絳八千一百八十戶，號絳侯。"}],"attestations":[{"id":"th-shiji057-014:a001","paragraph_id":"c-shiji-057-zhou:p003","start":175,"end":183,"surface":"潁（陽）［陰］侯","person_mention_id":"c-shiji-057-zhou:m003-0175","usage":"narrative"}],"effective_period":{"start":