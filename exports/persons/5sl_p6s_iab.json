:[],"passages":[{"id":"c-sanguozhi-052-compiler-appraisal:line124","text":"評曰：張昭受遺輔佐，功勳克舉，忠謇方直，動不爲己。而以嚴見憚，以高見外，既不處宰相，又不登師保，從容閭巷，養老而已，以此明權之不及策也。顧雍依杖素業，而將之智局，故能究極榮位。諸葛瑾、歩騭並以德度規檢見器當世，張承，顧邵虛心長者，好尚人物，周昭之論，稱之甚美，故詳錄焉。譚獻納在公，有忠貞之節。休、承修志，咸庶爲善。愛惡相攻，流播南裔，哀哉!","text_layer":"received_chapter","narrative_role":"compiler_appraisal","annotation_status":"reviewed","mentions":[{"id":"c-sanguozhi-052-compiler-appraisal:line124:m0003","start":3,"end":5,"surface":"張昭","kind":"person","person_id":"roi_rz4_ute","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-compiler-appraisal:line124:m0061","start":61,"end":62,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-compiler-appraisal:line124:m0065","start":65,"end":66,"surface":"策","kind":"person","person_id":"e9c_070_567","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-compiler-appraisal:line124:m0068","start":68,"end":70,"surface":"顧雍","kind":"person","person_id":"syc_ik6_bq5_**A","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-compiler-appraisal:line124:m0088","start":88,"end":91,"surface":"諸葛瑾","kind":"person","person_id":"lpo_z63_vzb","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-compiler-appraisal:line124:m0092","start":92,"end":94,"surface":"歩騭","kind":"person","person_id":"snv_2iq_jes","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-compiler-appraisal:line124:m0105","start":105,"end":107,"surface":"張承","kind":"person","person_id":"roi_rz4_ute_B","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-compiler-appraisal:line124:m0108","start":108,"end":110,"surface":"顧邵","kind":"person","person_id":"syc_ik6_bq5_**AA","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sa