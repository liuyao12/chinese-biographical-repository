rson_ids":["snv_2iq_jes","szg_rhg_18d"],"start_codepoint":0,"end_codepoint":15,"source_quote":"穎川周昭著書稱歩騭及嚴畯等曰：","reading":"敘者標明周昭著論，論及步騭、嚴畯等人。","chapter_id":"c-sanguozhi-052-zhouzhao-complete","source_id":"s-sanguozhi-052-zhouzhao-complete"},{"id":"c-sanguozhi-052-zhouzhao-complete:line116:reading-000-124","kind":"received_sentence","paragraph_id":"c-sanguozhi-052-zhouzhao-complete:line116","person_id":"5sl_p6s_iab","related_person_ids":[],"start_codepoint":0,"end_codepoint":124,"source_quote":"古今賢士大夫所以失名喪身傾家害國者，其由非一也，然要其大歸，總其常患，四者而已。急論議一也，爭名勢二也，重朋黨三也，務欲速四也。急論議則傷人，爭名勢則敗友，重朋黨則蔽主，務欲速則失德，此四者不除，未有能全也。當世君子能不然者，亦比有之，豈獨古人乎！","reading":"周昭先列損人、敗友、蔽主、失德之四患。","chapter_id":"c-sanguozhi-052-zhouzhao-complete","source_id":"s-sanguozhi-052-zhouzhao-complete"},{"id":"c-sanguozhi-052-zhouzhao-complete:line116:reading-124-157","kind":"received_sentence","paragraph_id":"c-sanguozhi-052-zhouzhao-complete:line116","person_id":"5sl_p6s_iab","related_person_ids":["syc_ik6_bq5_**AA","lpo_z63_vzb","snv_2iq_jes","szg_rhg_18d","roi_rz4_ute_B"],"start_codepoint":124,"end_codepoint":157,"source_quote":"然論其絶異，未若顧豫章、諸葛使君、歩丞相、嚴衞尉、張奮威之爲美也。","reading":"列五人官稱，張奮威指任奮威將軍的張承。","chapter_id":"c-sanguozhi-052-zhouzhao-complete","source_id":"s-sanguozhi-052-zhouzhao-complete"},{"id":"c-sanguozhi-052-zhouzhao-complete:line116:reading-157-254","kind":"received_sentence","paragraph_id":"c-sanguozhi-052-zhouzhao-complete:line116","person_id":"5sl_p6s_iab","related_person_ids":["syc_ik6_bq5_**AA","lpo_z63_vzb","snv_2iq_jes","szg_rhg_18d","roi_rz4_ute_B","fp6_ia6_7yw"],"start_codepoint":157,"end_codepoint":254,"source_quote":"《論語》言『夫子恂恂然善誘人』，又曰『成人之美，不成人之惡』，豫章有之矣。『望之儼然，即之也溫，聽其言也厲』，使君體之矣。『恭而安，威而不猛』，丞相履之矣。學不求祿，心無苟得，衞尉，奮威蹈之矣。","reading":"取《論語》及儒者行誼，分舉顧邵、諸葛瑾、步騭、嚴畯、張承。","chapter_id":"c-sanguozhi-052-zhouzhao-complete","source_id":"s-sanguozhi-052-zhouzhao-complete"},{"id":"c-sanguozhi-052-zhouzhao-complete:line116:reading-254-287","kind":"received_sentence","paragraph_id":"c-sanguozhi-052-zhouzhao-complete:line116","person_id":"5sl_p6s_iab","related_person_ids":["syc_ik6_bq5_**AA","lpo_z63_vzb","snv_2iq_jes","szg_rhg_18d","roi_rz4_ute_B"],"start_codepoint":254,"end_codepoint":287,"source_quote":"此五君者，雖德實有差，輕重不同，至於趣捨大檢，不犯四者，懼一揆也。","reading":"五君德實有差，論者以其同不犯四患。","chapter_id":"c-sanguozhi-052-zhouzhao-complete","source_id":"s-sanguozhi-052-zhouzhao-complete"},{"id":"c-sanguozhi-052-zhouzhao-complete:line116:reading-328-358","kind":"received_sentence","paragraph_id":"c-sanguozhi-052-zhouzhao-complete:line116","person_id":"5sl_p6s_iab","related_person_ids":["lpo_z63_vzb","snv_2iq_jes","szg_rhg_18d"],"start_codepoint":328,"end_codepoint":358,"source_quote":"使君、丞相、衞尉三君，昔以布衣俱相友善，諸論者因各敘其優劣。","reading":"三君為諸葛瑾、步騭、嚴畯。","chapter_id":"c-sanguozhi-052-zhouzhao-complete","source_id":"s-sanguozhi-052-zhouzhao-complete"},{"id":"c-sanguozhi-052-zhouzhao-complete:line118:reading-000-075","kind":"received_sentence","paragraph_id":"c-sanguozhi-052-zhouzhao-complete:line118","person_id":"5sl_p6s_iab","related_person_ids":["szg_rhg_18d","snv_2iq_jes","lpo_z63_vzb"],"start_codepoint":0,"end_codepoint":75,"source_quote":"初，先衞尉，次丞相，而後有使君也。其後並事明主，經營世務，出處之才有不同，先後之名須反其初，此世常人所決勤薄也。至於三君分好，卒無虧損，豈非古人交哉！","reading":"周昭記三人早先品次、實際任官及始終交好。","chapter_id":"c-sanguozhi-052-zhouzhao-complete","source_id":"s-sanguozhi-052-zhouzhao-complete"},{"id":"c-sanguozhi-052-zhouzhao-complete:line118:reading-135-222","kind":"received_sentence","paragraph_id":"c-sanguozhi-052-zhouzhao-complete:line118","person_id":"5sl_p6s_iab","related_person_ids":["szg_rhg_18d","lpo_z63_vzb","snv_2iq_jes","fp6_ia6_7yw"],"start_codepoint":135,"end_codepoint":222,"source_quote":"後徙九列，遷典八座，榮不足以自曜，祿不足以自奉。至於二君，皆位爲上將，窮富極貴。衞尉既無求欲，二君又不稱薦，各守所志。保其名好。孔子曰：『君子矜而不爭，群而不黨。』斯有風矣。","reading":"嚴畯的職位、俸祿與另外兩君並論，又引孔子語。","chapter_id":"c-sanguozhi-052-zhouzhao-complete","source_id":"s-sanguozhi-052-zhouzhao-complete"},{"id":"c-sanguozhi-052-zhouzhao-complete:line118:reading-393-468","kind":"received_sentence","paragraph_id":"c-sanguozhi-052-zhouzhao-complete:line118","person_id":"5sl_p6s_iab","related_person_ids":["syc_ik6_bq5_**AA","lpo_z63_vzb","snv_2iq_jes","szg_rhg_18d","roi_rz4_ute_B"],"start_codepoint":393,"end_codepoint":468,"source_quote":"若乃經國家，當軍旅，於馳騖之際，立霸王之功，此五者未爲過人。至其純粹履道，求不苟得，升降當世，保全名行，邈然絶俗，實有所師。故粗論其事，以示後之君子。","reading":"周昭以保全名行結論。","chapter_id":"c-sanguozhi-052-zhouzhao-complete","source_id":"s-sanguozhi-052-zhouzhao-complete"},{"id":"c-sanguozhi-052-zhouzhao-complete:line120:reading-000-023","kind":"received_sentence","paragraph_id":"c-sanguozhi-052-zhouzhao-complete:line120","person_id":"5sl_p6s_iab","related_person_ids":["4qw_13i_jn6","57a_8f8_a32","idb_k2n_p9s"],"start_codepoint":0,"end_codepoint":23,"source_quote":"周昭者字恭遠，與韋曜、薛瑩、華覈並述《呉書》，","reading":"字恭遠及參修《吳書》。卷五十三華覈所述同修名單另具梁廣。","chapter_id":"c-sanguozhi-052-zhouzhao-complete","source_id":"s-sanguozhi-052-zhouzhao-complete"},{"id":"c-sanguozhi-052-zhouzhao-complete:line120:reading-023-049","kind":"received_sentence","paragraph_id":"c-sanguozhi-052-zhouzhao-complete:line120","person_id":"5sl_p6s_iab","related_person_ids":["idb_k2n_p9s","0fo_c5c_4yh"],"start_codepoint":23,"end_codepoint":49,"source_quote":"後爲中書郎，坐事下獄，覈表救之，孫休不聽，遂伏法云。","reading":"任中書郎、下獄，華覈表救，孫休不聽，周昭伏法。","chapter_id":"c-sanguozhi-052-zhouzhao-complete","source_id":"s-sanguozhi-052-zhouzhao-complete"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-wu052-zhouzhao-death","person_id":"5sl_p6s_iab","event_type":"death","source_term":"遂伏法","date_expression":null,"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-052","chapter_id":"c-sanguozhi-052-zhouzhao-complete","source_id":"s-sanguozhi-052-zhouzhao-complete","paragraph_id":"c-sanguozhi-052-zhouzhao-complete:line120","quote":"周昭者字恭遠，與韋曜、薛瑩、華覈並述《呉書》，後爲中書郎，坐事下獄，覈表救之，孫休不聽，遂伏法云。","person_mention_id":"c-sanguozhi-052-zhouzhao-complete:line120:m0000"}],"interpretation_note":"依本來源登記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"le-wu053-xueying1","person_id":"5sl_p6s_iab","event_type":"death","source_term":"昭、廣先亡","date_expression":null,"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-053","chapter_id":"c-sanguozhi-053-xueying","source_id":"s-sanguozhi-053-xueying","paragraph_id":"c-sanguozhi-053-xueying:line066","quote":"臣聞五帝三王皆立史官，敘錄功美，垂之無窮。漢時司馬遷、班固，咸命世大才，所撰精妙，與六經俱傳。大吳受命，建國南土。大皇帝末年，命太史令丁孚、郎中項峻始撰《吳書》。孚、峻俱非史才，其所撰作，不足紀錄。至少帝時，更差韋曜、周昭、薛瑩、梁廣及臣五人，訪求往事，所共撰立，備有本末。昭、廣先亡，曜負恩蹈罪，瑩出為將，復以過徙，其書遂委滯，迄今末撰奏。臣愚淺才劣，適可為瑩等記注而已，若使撰合，必襲孚、峻之跡，懼墜大皇帝之元功，損當世之盛美。瑩涉學既博，文章尤妙，同寮之中，瑩為冠首。今者見吏，雖多經學，記述之才，如瑩者少，是以慺慺為國惜之。實欲使卒垂成之功，編於前史之末。奏上之後，退填溝壑，無所復恨。","person_mention_id":"c-sanguozhi-053-xueying:line066:m0109"}],"interpretation_note":"本來源所記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-sanguozhi-052-compiler-appraisal:line124:m0120","start":120,"end":122,"surface":"周昭","kind":"person","person_id":"5sl_p6s_iab","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-sanguozhi-052-compiler-appraisal:line124","chapter_id":"c-sanguozhi-052-compiler-appraisal"},{"id":"c-sanguozhi-052-zhouzhao-complete:line114:m0002","start":2,"end":4,"surface":"周昭","kind":"person","person_id":"5sl_p6s_iab","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-sanguozhi-052-zhouzhao-complete:line114","chapter_id":"c-sanguozhi-052-zhouzhao-complete"},{"id":"c-sanguozhi-052-zhouzhao-complete:line120:m0000","start":0,"end":2,"surface":"周昭","kind":"person","person_id":"5sl_p6s_iab","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-sanguozhi-052-zhouzhao-complete:line120","chapter_id":"c-sanguozhi-052-zhouzhao-complete"},{"id":"c-sanguozhi-052-zhouzhao-complete:line120:m0004","start":4,"end":6,"surface":"恭遠","kind":"person","