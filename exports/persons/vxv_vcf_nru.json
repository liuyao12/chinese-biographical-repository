{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"vxv_vcf_nru","canonical_person_id":"vxv_vcf_nru","id_aliases":["cbr-p004515"],"identity_policy":"contextual_provisional","person_ids":["vxv_vcf_nru"],"persons":[{"id":"vxv_vcf_nru","label":"管夷吾管仲引古（范睢蔡澤列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"管夷吾","mention_ids":["c-shiji-079-fancai:m024-0121"]},{"surface":"管仲","mention_ids":["c-shiji-079-fancai:m031-0181"]}],"evidence":[{"mention_id":"c-shiji-079-fancai:m024-0121","chapter_id":"c-shiji-079-fancai","paragraph_id":"c-shiji-079-fancai:p024","quote":"管夷吾"},{"mention_id":"c-shiji-079-fancai:m031-0181","chapter_id":"c-shiji-079-fancai","paragraph_id":"c-shiji-079-fancai:p031","quote":"管仲"}],"id_aliases":["cbr-p004515"]}],"source_mention_summary":[{"source_id":"s-shiji-079-fancai","work_id":"w-shiji","book_id":"b-shiji-079","chapter_id":"c-shiji-079-fancai","mention_count":2,"mention_ids":["c-shiji-079-fancai:m024-0121","c-shiji-079-fancai:m031-0181"],"paragraph_ids":["c-shiji-079-fancai:p024","c-shiji-079-fancai:p031"],"passage_count":2}],"most_mentioned_source_ids":["s-shiji-079-fancai"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-079-fancai:m024-0121","start":121,"end":124,"surface":"管夷吾","kind":"person","person_id":"vxv_vcf_nru","status":"contextual_provisional","paragraph_id":"c-shiji-079-fancai:p024","chapter_id":"c-shiji-079-fancai"},{"id":"c-shiji-079-fancai:m031-0181","start":181,"end":183,"surface":"管仲","kind":"person","person_id":"vxv_vcf_nru","status":"contextual_provisional","paragraph_id":"c-shiji-079-fancai:p031","chapter_id":"c-shiji-079-fancai"}],"relations":[],"title_holdings":[{"id":"th-shiji079-020","person_id":"vxv_vcf_nru","title":"仲父","kind":"unclassified","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-079-fancai","source_id":"s-shiji-079-fancai","paragraph_id":"c-shiji-079-fancai:p024","quote":"秦昭王聞魏齊在平原君所，欲為范睢必報其仇，乃詳為好書遺平原君曰；「寡人聞君之高義，願與君為布衣之友，君幸過寡人，寡人願與君為十日之飲。」平原君畏秦，且以為然，而入秦見昭王。昭王與平原君飲數日，昭王謂平原君曰：「昔周文王得呂尚以為太公，齊桓公得管夷吾以為仲父，今范君亦寡人之叔父也。范君之仇在君之家，願使人歸取其頭來；不然，吾不出君於關。」平原君曰：「貴而為交者，為賤也；富而為交者，為貧也。夫魏齊者，勝之友也，在，固不出也，今又不在臣所。」昭王乃遺趙王書曰：「王之弟在秦，范君之仇魏齊在平原君之家。王使人疾持其頭來；不然，吾舉兵而伐趙，又不出王之弟於關。」趙孝成王乃發卒圍平原君家，急，魏齊夜亡出，見趙相虞卿。虞卿度趙王終不可說，乃解其相印，與魏齊亡，閒行，念諸侯莫可以急抵者，乃復走大梁，欲因信陵君以走楚。信陵君聞之，畏秦，猶豫未肯見，曰：「虞卿何如人也？」時侯嬴在旁，曰：「人固未易知，知人亦未易也。夫虞卿躡屩檐簦，一見趙王，賜白璧一雙，黃金百鎰；再見，拜為上卿；三見，卒受相印，封萬戶侯。當此之時，天下爭知之。夫魏齊窮困過虞卿，虞卿不敢重爵祿之尊，解相印，捐萬戶侯而閒行。急士之窮而歸公子，公子曰『何如人』。人固不易知，知人亦未易也！」信陵君大慚，駕如野迎之。魏齊聞信陵君之初難見之，怒而自剄。趙王聞之，卒取其頭予秦。秦昭王乃出平原君歸趙。"}],"attestations":[{"id":"th-shiji079-020:a001","paragraph_id":"c-shiji-079-fancai:p024","start":126,"end":128,"surface":"仲父","person_mention_id":"c-shiji-079-fancai:m024-0121","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-079-fancai","source_id":"s-shiji-079-fancai","paragraph_id":"c-shiji-079-fancai:p024","quote":"秦昭王聞魏齊在平原君所，欲為范睢必報其仇，乃詳為好書遺平原君曰；「寡人聞君之高義，願與君為布衣之友，君幸過寡人，寡人願與君為十日之飲。」平原君畏秦，且以為然，而入秦見昭王。昭王與平原君飲數日，昭王謂平原君曰：「昔周文王得呂尚以為太公，齊桓公得管夷吾以為仲父，今范君亦寡人之叔父也。范君之仇在君之家，願使人歸取其頭來；不然，吾不出君於關。」平原君曰：「貴而為交者，為賤也；富而為交者，為貧也。夫魏齊者，勝之友也，在，固不出也，今又不在臣所。」昭王乃遺趙王書曰：「王之弟在秦，范君之仇魏齊在平原君之家。王使人疾持其頭來；不然，吾舉兵而伐趙，又不出王之弟於關。」趙孝成王乃發卒圍平原君家，急，魏齊夜亡出，見趙相虞卿。虞卿度趙王終不可說，乃解其相印，與魏齊亡，閒行，念諸侯莫可以急抵者，乃復走大梁，欲因信陵君以走楚。信陵君聞之，畏秦，猶豫未肯見，曰：「虞卿何如人也？」時侯嬴在旁，曰：「人固未易知，知人亦未易也。夫虞卿躡屩檐簦，一見趙王，賜白璧一雙，黃金百鎰；再見，拜為上卿；三見，卒受相印，封萬戶侯。當此之時，天下爭知之。夫魏齊窮困過虞卿，虞卿不敢重爵祿之尊，解相印，捐萬戶侯而閒行。急士之窮而歸公子，公子曰『何如人』。人固不易知，知人亦未易也！」信陵君大慚，駕如野迎之。魏齊聞信陵君之初難見之，怒而自剄。趙王聞之，卒取其頭予秦。秦昭王乃出平原君歸趙。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授任、實際去職及用稱分存，首次出現、降敵、出走、被誅與死亡不自動終止全部官爵；叔父仲父太公為尊稱不推血緣。擬長為應侯、稱孤與黃金印紫綬願望不當實授。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji079-044","person_id":"vxv_vcf_nru","surfaces":["管仲","管夷吾"],"scope":"same_chapter","chapter_ids":["c-shiji-079-fancai"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-079-fancai:p024","quote":"秦昭王聞魏齊在平原君所，欲為范睢必報其仇，乃詳為好書遺平原君曰；「寡人聞君之高義，願與君為布衣之友，君幸過寡人，寡人願與君為十日之飲。」平原君畏秦，且以為然，而入秦見昭王。昭王與平原君飲數日，昭王謂平原君曰：「昔周文王得呂尚以為太公，齊桓公得管夷吾以為仲父，今范君亦寡人之叔父也。范君之仇在君之家，願使人歸取其頭來；不然，吾不出君於關。」平原君曰：「貴而為交者，為賤也；富而為交者，為貧也。夫魏齊者，勝之友也，在，固不出也，今又不在臣所。」昭王乃遺趙王書曰：「王之弟在秦，范君之仇魏齊在平原君之家。王使人疾持其頭來；不然，吾舉兵而伐趙，又不出王之弟於關。」趙孝成王乃發卒圍平原君家，急，魏齊夜亡出，見趙相虞卿。虞卿度趙王終不可說，乃解其相印，與魏齊亡，閒行，念諸侯莫可以急抵者，乃復走大梁，欲因信陵君以走楚。信陵君聞之，畏秦，猶豫未肯見，曰：「虞卿何如人也？」時侯嬴在旁，曰：「人固未易知，知人亦未易也。夫虞卿躡屩檐簦，一見趙王，賜白璧一雙，黃金百鎰；再見，拜為上卿；三見，卒受相印，封萬戶侯。當此之時，天下爭知之。夫魏齊窮困過虞卿，虞卿不敢重爵祿之尊，解相印，捐萬戶侯而閒行。急士之窮而歸公子，公子曰『何如人』。人固不易知，知人亦未易也！」信陵君大慚，駕如野迎之。魏齊聞信陵君之初難見之，怒而自剄。趙王聞之，卒取其頭予秦。秦昭王乃出平原君歸趙。"},{"paragraph_id":"c-shiji-079-fancai:p031","quote":"蔡澤曰：「主聖臣賢，天下之盛福也；君明臣直，國之福也；父慈子孝，夫信妻貞，家之福也。故比干忠而不能存殷，子胥智而不能完吳，申生孝而晉國亂。是皆有忠臣孝子，而國家滅亂者，何也？無明君賢父以聽之，故天下以其君父為僇辱而憐其臣子。今商君、吳起、大夫種之為人臣，是也；其君，非也。故世稱三子致功而不見德，豈慕不遇世死乎？夫待死而後可以立忠成名，是微子不足仁，孔子不足聖，管仲不足大也。夫人之立功，豈不期於成全邪？身與名俱全者，上也。名可法而身死者，其次也。名在僇辱而身全者，下也。」於是應侯稱善。"}],"rationale":"按全35段明示姓名與局部引語暫接，范睢張祿范叔范君應侯分說話範圍；蔡澤先生綱成君依具體敘事。越王事大夫種與句踐敘事相配，更新候選標籤保留ID。馬服／馬服子依同段長平角色暫接未補姓名，白公仍未定，韓子未強接韓非，喬松不補神仙，范中行族稱不接范睢。王之弟、改讀前止足及引古異說各留，預言與擬議方案不當史實核定。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-079-fancai:p024","text":"秦昭王聞魏齊在平原君所，欲為范睢必報其仇，乃詳為好書遺平原君曰；「寡人聞君之高義，願與君為布衣之友，君幸過寡人，寡人願與君為十日之飲。」平原君畏秦，且以為然，而入秦見昭王。昭王與平原君飲數日，昭王謂平原君曰：「昔周文王得呂尚以為太公，齊桓公得管夷吾以為仲父，今范君亦寡人之叔父也。范君之仇在君之家，願使人歸取其頭來；不然，吾不出君於關。」平原君曰：「貴而為交者，為賤也；富而為交者，為貧也。夫魏齊者，勝之友也，在，固不出也，今又不在臣所。」昭王乃遺趙王書曰：「王之弟在秦，范君之仇魏齊在平原君之家。王使人疾持其頭來；不然，吾舉兵而伐趙，又不出王之弟於關。」趙孝成王乃發卒圍平原君家，急，魏齊夜亡出，見趙相虞卿。虞卿度趙王終不可說，乃解其相印，與魏齊亡，閒行，念諸