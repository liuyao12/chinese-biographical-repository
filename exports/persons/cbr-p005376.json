g"},{"id":"c-shiji-096-zhang:m008-0057","start":57,"end":59,"surface":"高后","kind":"person","person_id":"cbr-p005376","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p008","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m008-0060","start":60,"end":62,"surface":"高后","kind":"person","person_id":"cbr-p005376","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p008","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m008-0093","start":93,"end":95,"surface":"高后","kind":"person","person_id":"cbr-p005376","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p008","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m009-0004","start":4,"end":6,"surface":"高后","kind":"person","person_id":"cbr-p005376","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p009","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m010-0017","start":17,"end":19,"surface":"呂后","kind":"person","person_id":"cbr-p005376","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p010","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m010-0037","start":37,"end":39,"surface":"呂后","kind":"person","person_id":"cbr-p005376","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p010","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m010-0100","start":100,"end":102,"surface":"高后","kind":"person","person_id":"cbr-p005376","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p010","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m010-0125","start":125,"end":127,"surface":"高后","kind":"person","person_id":"cbr-p005376","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p010","chapter_id":"c-shiji-096-zhang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji096-018","person_id":"cbr-p005376","surfaces":["呂后","呂太后","高后"],"scope":"same_chapter","chapter_ids":["c-shiji-096-zhang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-096-zhang:p005","quote":"昌為人彊力，敢直言，自蕭、曹等皆卑下之。昌嘗燕時入奏事，高帝方擁戚姬，昌還走，高帝逐得，騎周昌項，問曰：「我何如主也？」昌仰曰：「陛下即桀紂之主也。」於是上笑之，然尤憚周昌。及帝欲廢太子，而立戚姬子如意為太子，大臣固爭之，莫能得；上以留侯策即止。而周昌廷爭之彊，上問其說，昌為人吃，又盛怒，曰：「臣口不能言，然臣期期知其不可。陛下雖欲廢太子，臣期期不奉詔。」上欣然而笑。既罷，呂后側耳於東箱聽，見周昌，為跪謝曰：「微君，太子幾廢。」"},{"paragraph_id":"c-shiji-096-zhang:p006","quote":"是後戚姬子如意為趙王，年十歲，高祖憂即萬歲之後不全也。趙堯年少，為符璽御史。趙人方與公謂御史大夫周昌曰：「君之史趙堯，年雖少，然奇才也，君必異之，是且代君之位。」周昌笑曰；「堯年少，刀筆吏耳，何能至是乎！」居頃之，趙堯侍高祖。高祖獨心不樂，悲歌，群臣不知上之所以然。趙堯進請問曰：「陛下所為不樂，非為趙王年少而戚夫人與呂后有卻邪？備萬歲之後而趙王不能自全乎？」高祖曰：「然。吾私憂之，不知所出。」堯曰：「陛下獨宜為趙王置貴彊相，及呂后、太子、群臣素所敬憚乃可。」高祖曰：「然。吾念之欲如是，而群臣誰可者？」堯曰：「御史大夫周昌，其人堅忍質直，且自呂后、太子及大臣皆素敬憚之。獨昌可。」高祖曰：「善。」於是乃召周昌，謂曰：「吾欲固煩公，公彊為我相趙王。」周昌泣曰：「臣初起從陛下，陛下獨柰何中道而棄之於諸侯乎？」高祖曰：「吾極知其左遷，然吾私憂趙王，念非公無可者。公不得已彊行！」於是徙御史大夫周昌為趙相。"},{"paragraph_id":"c-shiji-096-zhang:p008","quote":"高祖崩，呂太后使使召趙王，其相周昌令王稱疾不行。使者三反，周昌固為不遣趙王。於是高后患之，乃使使召周昌。周昌至，謁高后，高后怒而罵周昌曰：「爾不知我之怨戚氏乎？而不遣趙王，何？」昌既徵，高后使使召趙王，趙王果來。至長安月餘，飲藥而死。周昌因謝病不朝見，三歲而死。"},{"paragraph_id":"c-shiji-096-zhang:p009","quote":"後五歲，高后聞御史大夫江邑侯趙堯高祖時定趙王如意之畫，乃抵堯罪，以廣阿侯任敖為御史大夫。"},{"paragraph_id":"c-shiji-096-zhang:p010","quote":"任敖者，故沛獄吏。高祖嘗辟吏，吏系呂后，遇之不謹。任敖素善高祖，怒，擊傷主呂后吏。及高祖初起，敖以客從為御史，守豐二歲，高祖立為漢王，東擊項籍，敖遷為上黨守。陳豨反時，敖堅守，封為廣阿侯，食千八百戶。高后時為御史大夫。三歲免，以平陽侯曹窋為御史大夫。高后崩，（不）與大臣共誅呂祿等。免，以淮南相張蒼為御史大夫。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定短稱；韋賢與韋玄成分傳區別，第23段掾陳平另候選，第25段長安相工田文不與孟嘗君合併。趙堯、任敖、申屠嘉、鄧通、晁錯的短名依各段人物語境，王陵夫人與王陵分人。張蒼父長不滿五尺的長為身長敘述，不作父名。王侯與太子未詳名不補名，跨篇同指另待證據。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-096-zhang:p005","text":"昌為人彊力，敢直言，自蕭、曹等皆卑下之。昌嘗燕時入奏事，高帝方擁戚姬，昌還走，高帝逐得，騎周昌項，問曰：「我何如主也？」昌仰曰：「陛下即桀紂之主也。」於是上笑之，然尤憚周昌。及帝欲廢太子，而立戚姬子如意為太子，大臣固爭之，莫能得；上以留侯策即止。而周昌廷爭之彊，上問其說，昌為人吃，又盛怒，曰：「臣口不能言，然臣期期知其不可。陛下雖欲廢太子，臣期期不奉詔。」上欣然而笑。既罷，呂后側耳於東箱聽，見周昌，為跪謝曰：「微君，太子幾廢。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhang:m005-0000","start":0,"end":1,"surface":"昌","kind":"person","person_id":"cbr-p005370","status":"cont