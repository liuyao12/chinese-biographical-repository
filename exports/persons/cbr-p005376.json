3,"end":275,"surface":"呂后","kind":"person","person_id":"cbr-p005376","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m006-0276","start":276,"end":278,"surface":"太子","kind":"person","person_id":"cbr-p005377","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m006-0288","start":288,"end":289,"surface":"昌","kind":"person","person_id":"cbr-p005370","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m006-0292","start":292,"end":294,"surface":"高祖","kind":"person","person_id":"cbr-p005364","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m006-0304","start":304,"end":306,"surface":"周昌","kind":"person","person_id":"cbr-p005370","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m006-0322","start":322,"end":324,"surface":"趙王","kind":"person","person_id":"cbr-p005375","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m006-0326","start":326,"end":328,"surface":"周昌","kind":"person","person_id":"cbr-p005370","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m006-0355","start":355,"end":357,"surface":"高祖","kind":"person","person_id":"cbr-p005364","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m006-0371","start":371,"end":373,"surface":"趙王","kind":"person","person_id":"cbr-p005375","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m006-0396","start":396,"end":398,"surface":"周昌","kind":"person","person_id":"cbr-p005370","status":"contextual_provisional"}],"chapter_id":"c-shiji-096-zhang","book_id":"b-shiji-096","work_id":"w-shiji","source_id":"s-shiji-096-zhang"},{"id":"c-shiji-096-zhang:p008","text":"高祖崩，呂太后使使召趙王，其相周昌令王稱疾不行。使者三反，周昌固為不遣趙王。於是高后患之，乃使使召周昌。周昌至，謁高后，高后怒而罵周昌曰：「爾不知我之怨戚氏乎？而不遣趙王，何？」昌既徵，高后使使召趙王，趙王果來。至長安月餘，飲藥而死。周昌因謝病不朝見，三歲而死。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhang:m008-0000","start":0,"end":2,"surface":"高祖","kind":"person","person_id":"cbr-p005364","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m008-0004","start":4,"end":7,"surface":"呂太后","kind":"person","person_id":"cbr-p005376","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m008-0010","start":10,"end":12,"surface":"趙王","kind":"person","person_id":"cbr-p005375","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m008-0015","start":15,"end":17,"surface":"周昌","kind":"person","person_id":"cbr-p005370","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m008-0029","start":29,"end":31,"surface":"周昌","kind":"person","person_id":"cbr-p005370","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m008-0035","start":35,"end":37,"surface":"趙王","kind":"person","person_id":"cbr-p005375","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m008-0040","start":40,"end":42,"surface":"高后","kind":"person","person_id":"cbr-p005376","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m008-0049","start":49,"end":51,"surface":"周昌","kind":"person","person_id":"cbr-p005370","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m008-0052","start":52,"end":54,"surface":"周昌","kind":"person","person_id":"cbr-p005370","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m008-0057","start":57,"end":59,"surface":"高后","kind":"person","person_id":"cbr-p005376","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m008-0060","start":60,"end":62,"surface":"高后","kind":"person","person_id":"cbr-p005376","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m008-0065","start":65,"end":67,"surface":"周昌","kind":"person","person_id":"cbr-p005370","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m008-0076","start":76,"end":78,"surface":"戚氏","kind":"person","person_id":"cbr-p005374","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m008-0083","start":83,"end":85,"surface":"趙王","kind":"person","person_id":"cbr-p005375","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m008-0089","start":89,"end":90,"surface":"昌","kind":"person","person_id":"cbr-p005370","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m008-0093","start":93,"end":95,"surface":"高后","kind":"person","person_id":"cbr-p005376","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m008-0098","start":98,"end":100,"surface":"趙王","kind":"person","person_id":"cbr-p005375","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m008-0101","start":101,"end":103,"surface":"趙王","kind":"person","person_id":"cbr-p005375","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m008-0117","start":117,"end":119,"surface":"周昌","kind":"person","person_id":"cbr-p005370","status":"contextual_provisional"}],"chapter_id":"c-shiji-096-zhang","book_id":"b-shiji-096","work_id":"w-shiji","source_id":"s-shiji-096-zhang"},{"id":"c-shiji-096-zhang:p009","text":"後五歲，高后聞御史大夫江邑侯趙堯高祖時定趙王如意之畫，乃抵堯罪，以廣阿侯任敖為御史大夫。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhang:m009-0004","start":4,"end":6,"surface":"高后","kind":"person","person_id":"cbr-p005376","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m009-0014","start":14,"end":16,"surface":"趙堯","kind":"person","person_id":"cbr-p005393","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m009-0016","start":16,"end":18,"surface":"高祖","kind":"person","person_id":"cbr-p005364","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m009-0020","start":20,"end":22,"surface":"趙王","kind":"person","person_id":"cbr-p005375","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m009-0022","start":22,"end":24,"surface":"如意","kind":"person","person_id":"cbr-p005375","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m009-0029","start":29,"end":30,"surface":"堯","kind":"person","person_id":"cbr-p005393","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m009-0036","start":36,"end":38,"surface":"任敖","kind":"person","person_id":"cbr-p005395","status":"contextual_provisional"}],"chapter_id":"c-shiji-096-zhang","book_id":"b-shiji-096","work_id":"w-shiji","source_id":"s-shiji-096-zhang"},{"id":"c-shiji-096-zhang:p010","text":"任敖者，故沛獄吏。高祖嘗辟吏，吏系呂后，遇之不謹。任敖素善高祖，怒，擊傷主呂后吏。及高祖初起，敖以客從為御史，守豐二歲，高祖立為漢王，東擊項籍，敖遷為上黨守。陳豨反時，敖堅守，封為廣阿侯，食千八百戶。高后時為御史大夫。三歲免，以平陽侯曹窋為御史大夫。高后崩，（不）與大臣共誅呂祿等。免，以淮南相張蒼為御史大夫。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhang:m010-0000","start":0,"end":2,"surface":"任敖","kind":"person","person_id":"cbr-p005395","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m010-0009","start":9,"end":11,"surface":"高祖","kind":"person","person_id":"cbr-p005364","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m010-0017","start":17,"end":19,"surface":"呂后","kind":"person","person_id":"cbr-p005376","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m010-0025","start":25,"end":27,"surface":"任敖","kind":"person","person_id":"cbr-p005395","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m010-0029","start":29,"end":31,"surface":"高祖","kind":"person","person_id":"cbr-p005364","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m010-0037","start":37,"end":39,"surface":"呂后","kind":"person","person_id":"cbr-p005376","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m010-0042","start":42,"end":44,"surface":"高祖","kind":"person","person_id":"cbr-p005364","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m010-0047","start":47,"end":48,"surface":"敖","kind":"person","person_id":"cbr-p005395","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m010-0060","start":60,"end":62,"surface":"高祖","kind":"person","person_id":"cbr-p005364","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m010-0064","start":64,"end":66,"surface":"漢王","kind":"person","person_id":"cbr-p005364","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m010-0072","start":72,"end":73,"surface":"敖","kind":"person","person_id":"cbr-p005395","status":"contextual_provisional"},{"id":"c-shiji-0