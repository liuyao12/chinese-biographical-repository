_id":"c-shiji-124-youxia:m014-0211","chapter_id":"c-shiji-124-youxia","paragraph_id":"c-shiji-124-youxia:p014","quote":"解"},{"mention_id":"c-shiji-124-youxia:m014-0213","chapter_id":"c-shiji-124-youxia","paragraph_id":"c-shiji-124-youxia:p014","quote":"解"},{"mention_id":"c-shiji-124-youxia:m014-0233","chapter_id":"c-shiji-124-youxia","paragraph_id":"c-shiji-124-youxia:p014","quote":"解"},{"mention_id":"c-shiji-124-youxia:m014-0248","chapter_id":"c-shiji-124-youxia","paragraph_id":"c-shiji-124-youxia:p014","quote":"解"},{"mention_id":"c-shiji-124-youxia:m014-0263","chapter_id":"c-shiji-124-youxia","paragraph_id":"c-shiji-124-youxia:p014","quote":"解"},{"mention_id":"c-shiji-124-youxia:m014-0272","chapter_id":"c-shiji-124-youxia","paragraph_id":"c-shiji-124-youxia:p014","quote":"解"},{"mention_id":"c-shiji-124-youxia:m014-0285","chapter_id":"c-shiji-124-youxia","paragraph_id":"c-shiji-124-youxia:p014","quote":"郭解翁伯"},{"mention_id":"c-shiji-124-youxia:m016-0007","chapter_id":"c-shiji-124-youxia","paragraph_id":"c-shiji-124-youxia:p016","quote":"郭解"},{"mention_id":"c-shiji-124-youxia:m017-0048","chapter_id":"c-shiji-124-youxia","paragraph_id":"c-shiji-124-youxia:p017","quote":"翁伯"}],"family_path":{"connection":"father","generation_distance":1,"parent_person_id":"5if_pf6_zos","status":"contextual_provisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-124-youxia","source_id":"s-shiji124-youxia","paragraph_id":"c-shiji-124-youxia:p009","quote":"郭解，軹人也，字翁伯，善相人者許負外孫也。解父以任俠，孝文時誅死。解為人短小精悍，不飲酒。少時陰賊，慨不快意，身所殺甚眾。以軀借交報仇，藏命作姦剽攻，不休及鑄錢掘冢，固不可勝數。適有天幸，窘急常得脫，若遇赦。及解年長，更折節為儉，以德報怨，厚施而薄望。然其自喜為俠益甚。既已振人之命，不矜其功，其陰賊著於心，卒發於睚眦如故云。而少年慕其行，亦輒為報仇，不使知也。解姊子負解之勢，與人飲，使之嚼。非其任，彊必灌之。人怒，拔刀刺殺解姊子，亡去。解姊怒曰：「以翁伯之義，人殺吾子，賊不得。」棄其尸於道，弗葬，欲以辱解。解使人微知賊處。賊窘自歸，具以實告解。解曰：「公殺之固當，吾兒不直。」遂去其賊，罪其姊子，乃收而葬之。諸公聞之，皆多解之義，益附焉。"}],"source_assertion_id":"a-shiji124-002","interpretation_note":"本篇明示父子共根，未名父親或子保持未名；分支不表示排行，母系與旁親另存。","reviewer":"Codex（AI 代理）"}},{"id":"t6d_sky_m3x","label":"郭解兄子（未名）（游俠列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"解兄子","mention_ids":["c-shiji-124-youxia:m013-0089"]}],"evidence":[{"mention_id":"c-shiji-124-youxia:m013-0089","chapter_id":"c-shiji-124-youxia","paragraph_id":"c-shiji-124-youxia:p013","quote":"解兄子"}]}],"source_mention_summary":[{"source_id":"s-shiji124-youxia","work_id":"w-shiji","book_id":"b-shiji-124","chapter_id":"c-shiji-124-youxia","mention_count":1,"mention_ids":["c-shiji-124-youxia:m013-0089"],"paragraph_ids":["c-shiji-124-youxia:p013"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji124-youxia"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji124-007","subject_person_id":"t6d_sky_m3x","predicate":"paternal_uncle","object_person_id":"5if_pf6_zos_A","status":"source_attested","evidence":[{"chapter_id":"c-shiji-124-youxia","source_id":"s-shiji124-youxia","paragraph_id":"c-shiji-124-youxia:p013","quote":"及徙豪富茂陵也，解家貧，不中訾，吏恐，不敢不徙。衛將軍為言：「郭解家貧不中徙。」上曰：「布衣權至使將軍為言，此其家不貧。」解家遂徙。諸公送者出千餘萬。軹人楊季主子為縣掾，舉徙解。解兄子斷楊掾頭。由此楊氏與郭氏為仇。"}],"qualifiers":{"source_term":"解兄子","lineage":"paternal","generation_difference":-1,"father_person_id":null},"interpretation_note":"兄子記父系伯叔與姪關係；郭解是該子父親之弟，父親未名，不補排行數字或同母。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-124-youxia:m013-0089","start":89,"end":92,"surface":"解兄子","kind":"person","person_id":"t6d_sky_m3x","status":"contextual_provisional","paragraph_id":"c-shiji-124-youxia:p013","chapter_id":"c-shiji-124-youxia"}],"relations":[{"id":"a-shiji124-007","subject_person_id":"t6d_sky_m3x","predicate":"paternal_unc