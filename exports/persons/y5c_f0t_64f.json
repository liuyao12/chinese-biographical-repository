eserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-059-jiong:p011:m0120","start":232,"end":234,"surface":"張偉","kind":"person","person_id":"y5c_f0t_64f","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。","paragraph_id":"c-jinshu-059-jiong:p011","chapter_id":"c-jinshu-059-jiong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-059-jiong:p011","text":"王室多故，禍難罔已。大司馬冏雖唱義有興復皇位之功，而定都邑，克寧社稷，實成都王勳力也。而冏不能固守臣節，實協異望。在許昌營有東西掖門，官置治書侍御史，長史、司馬直立左右，如侍臣之儀。京城大清，篡逆誅夷，而率百萬之眾來繞洛城。阻兵經年，不一朝覲，百官拜伏，晏然南面。壞樂官市署，用自增廣。輒取武庫秘杖，嚴列不解。故東萊王蕤知其逆節，表陳事狀，而見誣陷，加罪黜徙。以樹私黨，僭立官屬。幸妻嬖妾，名號比之中宮。沈湎酒色，不恤群黎。董艾放縱，無所畏忌，中丞按奏，而取退免。張偉惚恫，擁停詔可，葛旟小豎，維持國命。操弄王爵，貨賂公行。群奸聚黨，擅斷殺生。密署腹心，實為貨謀。斥罪忠良，伺窺神器。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-059-jiong:p011:m0114","start":10,"end":14,"surface":"大司馬冏","kind":"person","person_id":"ee0_b2a_68e","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p011:m0115","start":36,"end":39,"surface":"成都王","kind":"person","person_id":"e81_f09_000","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p011:m0116","start":44,"end":45,"surface":"冏","kind":"person","person_id":"ee0_b2a_68e","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p011:m0117","start":156,"end":160,"surface":"東萊王蕤","kind":"person","person_id":"m3u_w8n_d2k","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p011:m0118","start":190,"end":194,"surface":"幸妻嬖妾","kind":"unresolved","person_id":null,"status":"unresolved","resolution_note":"