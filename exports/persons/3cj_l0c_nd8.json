tion_id":"c-jinshu-064-simapeng:p001:m0030","object_person_mention_id":"c-jinshu-064-simapeng:p001:m0000"}],"status":"source_attested","interpretation_note":"㻱薨子和嗣。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"a-jin064-peng-father","subject_person_id":"3cj_l0c_nd8","object_person_id":"dkn_ge4_286_AAAAAAAD","predicate":"father","qualifiers":{"source_term":"晞三子：綜、㻱、遵"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-064","chapter_id":"c-jinshu-064-simaxi","source_id":"s-jinshu-064-simaxi-ws2622004","paragraph_id":"c-jinshu-064-simaxi:p003","quote":"太元六年，晞卒于新安，時年六十六。孝武帝三日臨於西堂，詔曰：「感惟摧慟，便奉迎靈柩，並改移妃應氏及故世子梁王諸喪，家屬悉還。」復下詔曰：「故前武陵王體自皇極，克己思愆。仰惟先朝仁宥之旨，豈可情禮靡寄！其追封新甯郡王，邑千戶。」晞三子：綜、㻱、遵。以遵嗣。追贈綜給事中，㻱散騎郎。十二年，追復晞武陵國，綜、㻱各復先官，㻱還繼梁國。","subject_person_mention_id":"c-jinshu-064-simaxi:p003:m0119","object_person_mention_id":"c-jinshu-064-simaxi:p003:m0005"}],"status":"source_attested","interpretation_note":"出繼梁王翹為另一事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-064-simapeng:p001:m0000","surface":"梁王㻱","start":0,"end":3,"person_id":"3cj_l0c_nd8","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-064-simapeng:p001","chapter_id":"c-jinshu-064-simapeng"},{"id":"c-jinshu-064-simaxi:p002:m0114","surface":"㻱","start":114,"end":115,"person_id":"3cj_l0c_nd8","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-064-simaxi:p002","chapter_id":"c-jinshu-064-simaxi"},{"id":"c-jinshu-064-simaxi:p003:m0119","surface":"㻱","start":119,"end":120,"person_id":"3cj_l0c_nd8","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-064-simaxi:p003","chapter_id":"c-jinshu-064-simaxi"}],"relations":[{"id":"a-jin064-he-father","subject_person_id":"066_2n0_0po","object_person_id":"3cj_l0c_nd8","predicate":"f