021-0056","start":56,"end":57,"surface":"說","kind":"person","person_id":"p77_x5q_v4n","status":"source_identified","paragraph_id":"c-shiji-003-yin:p021","chapter_id":"c-shiji-003-yin"},{"id":"c-shiji-003-yin:m021-0084","start":84,"end":85,"surface":"說","kind":"person","person_id":"p77_x5q_v4n","status":"source_identified","paragraph_id":"c-shiji-003-yin:p021","chapter_id":"c-shiji-003-yin"},{"id":"c-shiji-003-yin:m021-0092","start":92,"end":93,"surface":"說","kind":"person","person_id":"p77_x5q_v4n","status":"source_identified","paragraph_id":"c-shiji-003-yin:p021","chapter_id":"c-shiji-003-yin"},{"id":"c-shiji-003-yin:m021-0143","start":143,"end":145,"surface":"傅說","kind":"person","person_id":"p77_x5q_v4n","status":"source_identified","paragraph_id":"c-shiji-003-yin:p021","chapter_id":"c-shiji-003-yin"}],"relations":[],"title_holdings":[{"id":"th-shiji003-029","person_id":"p77_x5q_v4n","title":"相","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-003-yin","source_id":"s-shiji-003-yin","paragraph_id":"c-shiji-003-yin:p021","quote":"帝小乙崩，子帝武丁立。帝武丁即位，思復興殷，而未得其佐。三年不言，政事決定於冢宰，以觀國風。武丁夜夢得聖人，名曰說。以夢所見視群臣百吏，皆非也。於是迺使百工營求之野，得說於傅險中。是時說為胥靡，筑於傅險。見於武丁，武丁曰是也。得而與之語，果聖人，舉以為相，殷國大治。故遂以傅險姓之，號曰傅說。"}],"attestations":[{"id":"th-shiji003-029:a001","paragraph_id":"c-shiji-003-yin:p021","start":126,"end":127,"surface":"相","person_mention_id":"c-shiji-003-yin:m021-0143","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-003-yin","source_id":"s-shiji-003-yin","paragraph_id":"c-shiji-003-yin:p021","quote":"帝小乙崩，子帝武丁立。帝武丁即位，思復興殷，而未得其佐。三年不言，政事決定於冢宰，以觀國風。武丁夜夢得聖人，名曰說。以夢所見視群臣百吏，皆非也。於是迺使百工營求之野，得說於傅險中。是時說為胥靡，筑於傅險。見於武丁，武丁曰是也。得而與之語，果聖人，舉以為相，殷國大治。故遂以傅險姓之，號曰傅說。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"明言立或任相保存事件，父子、兄弟另由親屬主張解析，不以先王崩推出同年授任。中宗與高后保留用稱，未知年代、終點與授予方式不補造。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[{"id":"shiji-013-t2-r021-c00-m001","start":11,"end":13,"surface":"傅說","person_id":"p77_x5q_v4n","status":"contextual_provisional","interpretation_note":"依〈三代世表〉殷王世系與《殷本紀》暫定同指；湯子太丁與武乙子太丁分別辨認。","table_id":"shiji-013","table_fragment_id":"shiji-013-digital-table-2","table_row_id":"shiji-013-t2-r021","table_cell_id":"shiji-013-t2-r021-c00","work_id":"w-shiji","book_id":"b-shiji-013","chapter_id":"table-chapter-shiji-013","source_id":"table-witness-shiji-013","source_revision":"2606991","kind":"table_person_mention","quote":"帝武丁。雉升鼎耳雊。得傅說。稱高宗。"}],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji003-016","person_id":"p77_x5q_v4n","surfaces":["說","傅說"],"scope":"same_chapter","chapter_ids":["c-shiji-003-yin"],"status":"source_explicit","evidence":[{"paragraph_id":"c-shiji-003-yin:p021","quote":"故遂以傅險姓之，號曰傅說"},{"paragraph_id":"c-shiji-003-yin:p021","quote":"名曰說"}],"rationale":"結合本段名曰說、得說與傅險姓之的敘事，同指個人。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-035-peiwei:p006","text":"遷尚書左僕射，侍中如故。頠雖後之親屬，然雅望素隆，四海不謂之以親戚進也，惟恐其不居位。俄復使頠專任門下事，固讓，不聽。頠上言：「賈模適亡，復以臣代，崇外戚之望，彰偏私之舉。後族何常有能自保，皆知重親無脫者也。然漢二十四帝惟孝文、光武、明帝不重外戚，皆保其宗，豈將獨賢，實以安理故也。昔穆叔不拜越禮之饗，臣亦不敢聞殊常之詔。」又表云：「咎繇謨虞，伊尹相商，呂望翊周，蕭張佐漢，咸播功化，光格四極。暨于繼體，咎單、傅說，祖己、樊仲，亦隆中興。或明揚側陋，或起自庶族，豈非尚德之舉，以臻斯美哉！曆觀近世，不能慕遠，溺於近情，多任後親，以致不靜。昔疏廣戒太子以舅氏為官屬，前世以為知禮。況朝廷何取于外戚，正復才均，尚當先其疏者，以明至公。漢世不用馮野王，即其事也。」表上，皆優詔敦譬。","text_layer":"received_chapter","mentions":[{"id":"c-jinshu-035-peiwei:p006:m0012","start":12,"end":13,"surface":"頠","kind":"person","person_id":"4ni_4t1_4o9_AAB","status":"contextual_provisional","resolution_note":"root已採納裴頠同指，以4ni_4t1_4o9_AAB為keeper；本研究初次capture早於該接合，dc7僅歷史輸入，不是當前候選或alias。"},{"id":"c-jinshu-035-peiwei:p006:m0014","start":14,"end":15,"surface":"後","kind":"person","person_id":"c27_590_7e3_A","status":"contextual_provisional","resolution_note":"040p017–018郭槐女/太子妃/賈后，與本段太子廢黜/趙王倫事相同。"},{"id":"c-jins