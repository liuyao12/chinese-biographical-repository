s_assertions":[],"table_occurrences":[{"id":"shiji-013-t2-r021-c00-m001","start":11,"end":13,"surface":"傅說","person_id":"p77_x5q_v4n","status":"contextual_provisional","interpretation_note":"依〈三代世表〉殷王世系與《殷本紀》暫定同指；湯子太丁與武乙子太丁分別辨認。","table_id":"shiji-013","table_fragment_id":"shiji-013-digital-table-2","table_row_id":"shiji-013-t2-r021","table_cell_id":"shiji-013-t2-r021-c00","work_id":"w-shiji","book_id":"b-shiji-013","chapter_id":"table-chapter-shiji-013","source_id":"table-witness-shiji-013","source_revision":"2606991","kind":"table_person_mention","quote":"帝武丁。雉升鼎耳雊。得傅說。稱高宗。"}],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji003-016","person_id":"p77_x5q_v4n","surfaces":["說","傅說"],"scope":"same_chapter","chapter_ids":["c-shiji-003-yin"],"status":"source_explicit","evidence":[{"paragraph_id":"c-shiji-003-yin:p021","quote":"故遂以傅險姓之，號曰傅說"},{"paragraph_id":"c-shiji-003-yin:p021","quote":"名曰說"}],"rationale":"結合本段名曰說、得說與傅險姓之的敘事，同指個人。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji-fushuo-specific-context-crosschapter","person_id":"p77_x5q_v4n","scope":"cross_chapter","chapter_ids":["c-shiji-003-yin","c-shiji-084-qujia","c-shiji-124-youxia","c-shiji-130-taishigong"],"status":"contextual_provisional","confidence_level":"high","surfaces":["傅說"],"evidence":[{"work_id":"w-shiji","book_id":"b-shiji-003","source_id":"s-shiji-003-yin","chapter_id":"c-shiji-003-yin","paragraph_id":"c-shiji-003-yin:p021","quote":"帝小乙崩，子帝武丁立。帝武丁即位，思復興殷，而未得其佐。三年不言，政事決定於冢宰，以觀國風。武丁夜夢得聖人，名曰說。以夢所見視群臣百吏，皆非也。於是迺使百工營求之野，得說於傅險中。是時說為胥靡，筑於傅險。見於武丁，武丁曰是也。得而與之語，果聖人，舉以為相，殷國大治。故遂以傅險姓之，號曰傅說。"},{"work_id":"w-shiji","book_id":"b-shiji-084","source_id":"s-shiji-084-qujia","chapter_id":"c-shiji-084-qujia","paragraph_id":"c-shiji-084-qujia:p028","quote":"萬物變化兮，固無休息。斡流而遷兮，或推而還。形氣轉續兮，變化而嬗。沕穆無窮兮，胡可勝言！禍兮福所倚，福兮禍所伏；憂喜聚門兮，吉凶同域。彼吳彊大兮，夫差以敗；越棲會稽兮，句踐霸世。斯游遂成兮，卒被五刑；傅說胥靡兮，乃相武丁。夫禍之與福兮，何異糾纆。命不可說兮，孰知其極？水激則旱兮，矢激則遠。萬物回薄兮，振蕩相轉。雲蒸雨降兮，錯繆相紛。大專槃物兮，坱軋無垠。天不可與慮兮，道不可與謀。遲數有命兮，惡識其時？"},{"work_id":"w-shiji","book_id":"b-shiji-124","source_id":"s-shiji124-youxia","chapter_id":"c-shiji-124-youxia","paragraph_id":"c-shiji-124-youxia:p002","quote":"且緩急，人之所時有也。太史公曰：昔者虞舜窘於井廩，伊尹負於鼎俎，傅說匿於傅險，呂尚困於棘津，夷吾桎梏，百里飯牛，仲尼畏匡，菜色陳、蔡。此皆學士所謂有道仁人也，猶然遭此菑，況以中材而涉亂世之末流乎？其遇害何可勝道哉！"},{"work_id":"w-shiji","book_id":"b-shiji-130","source_id":"s-shiji130-taishigong","chapter_id":"c-shiji-130-taishigong","paragraph_id":"c-shiji-130-taishigong:p015","quote":"維契作商，爰及成湯；太甲居桐，德盛阿衡；武丁得說，乃稱高宗；帝辛湛湎，諸侯不享。作殷本紀第三。"}],"prior_source_qualifications":[{"metadata":{"label":"傅說引古（屈原賈生列傳候選）","status":"active","historicity":"historical_tradition"},"source_mention_ids":["c-shiji-084-qujia:m028-0100"],"original_registry_record_sha256":"7b66b9a8ec122170663c9aaec519d75e08792a17878fa1c897e427b228474808","qualification":"原來源人物所有非alias/evidence欄位逐值保留；只辨同指，不提高史實或引古事件資格。"}],"rationale":"084服鳥賦引古明言傅說胥靡乃相武丁；003同述說為胥靡筑傅險、武丁舉以為相，並號傅說。姓名、胥靡身分、武丁及由困至相的事件鏈全部相合。","interpretation_note":"084是賈生賦中引古，不是賈生時代在場者；003夢得說與聖人稱述屬傳世敘事，合人不提高夢兆／上古史實可驗性。保持historical_tradition，不新增任期／生卒或姓氏構件。","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null},{"id":"d-shiji084-038","person_id":"p77_x5q_v4n","scope":"same_chapter","chapter_ids":["c-shiji-084-qujia"],"status":"contextual_provisional","rationale":"依兩賦引古與篇末敘事暫定；斯未補為李斯，兩位懷王依楚與梁語境分開。賈嘉孝昭時附述層次未作作者年代確證。","reviewer":"Codex（AI 代理）","surfaces":["傅說"],"evidence":[{"paragraph_id":"c-shiji-084-qujia:p028","quote":"萬物變化兮，固無休息。斡流而遷兮，或推而還。形氣轉續兮，變化而嬗。沕穆無窮兮，胡可勝言！禍兮福所倚，福兮禍所伏；憂喜聚門兮，吉凶同域。彼吳彊大兮，夫差以敗；越棲會稽兮，句踐霸世。斯游遂成兮，卒被五刑；傅說胥靡兮，乃相武丁。夫禍之與福兮，何異糾纆。命不可說兮，孰知其極？水激則旱兮，矢激則遠。萬物回薄兮，振蕩相轉。雲蒸雨降兮，錯繆相紛。大專槃物兮，坱軋無垠。天不可與慮兮，道不可與謀。遲數有命兮，惡識其時？"}]},{"id":"d-shiji124-allusion-seven-003","person_id":"p77_x5q_v4n","scope":"cross_chapter","chapter_ids":["c-shiji-124-youxia","c-shiji-003-yin"],"status":"contextual_provisional","confidence_level":"high","surfaces":["傅說"],"identification_basis":{"kind":"source_context","target_mention_ids":["c-shiji-124-youxia:m002-0032"]},"evidence":[{"chapter_id":"c-shiji-124-youxia","paragraph_id":"c-shiji-124-youxia:p002","quote":"且緩急，人之所時有也。太史公曰：昔者虞舜窘於井廩，伊尹負於鼎俎，傅說匿於傅險，呂尚困於棘津，夷吾桎梏，百里飯牛，仲尼畏匡，菜色陳、蔡。此皆學士所謂有道仁人也，猶然遭此菑，況以中材而涉亂世之末流乎？其遇害何可勝道哉！"},{"chapter_id":"c-shiji-003-yin","paragraph_id":"c-shiji-003-yin:p021","quote":"帝小乙崩，子帝武丁立。帝武丁即位，思復興殷，而未得其佐。三年不言，政事決定於冢宰，以觀國風。武丁夜夢得聖人，名曰說。以夢所見視群臣百吏，皆非也。於是迺使百工營求之野，得說於傅險中。是時說為胥靡，筑於傅險。見於武丁，武丁曰是也。得而與之語，果聖人，舉以為相，殷國大治。故遂以傅險姓之，號曰傅說。"}],"rationale":"傅險築牆、武丁求說的來源敘事相合。 本篇將古人困厄作引古例證；只接人物身份，不由此確證全部傳說細節、共同時代、親屬或新日期。","prior_source_qualifications":[{"source_mention_ids":["c-shiji-124-youxia:m002-0032"],"metadata":{"label":"傅說（游俠列傳候選）","status":"active","historicity":"historical_tradition"},"original_registry_record_sha256":"3ce643311eda055f99772f1a9d4ae7949df2180dbff9bdde4aaaf7c9cbe8e00b","qualification":"原來源候選資格留作判讀背景，不是現役人物或舊號別名。"}],"human_reviewed":false,"model":null},{"id":"d-shiji130-first50-stage2-cross-22","person_id":"p77_x5q_v4n","scope":"cross_chapter","chapter_ids":["c-shiji-130-taishigong","c-shiji-003-yin"],"status":"contextual_provisional","confidence_level":"high","surfaces":["說"],"identification_basis":{"kind":"source_context","target_mention_ids":["c-shiji-130-taishigong:m015-0023"]},"evidence":[{"work_id":"w-shiji","book_id":"b-shiji-130","source_id":"s-shiji130-taishigong","chapter_id":"c-shiji-130-taishigong","paragraph_id":"c-shiji-130-taishigong:p015","quote":"維契作商，爰及成湯；太甲居桐，德盛阿衡；武丁得說，乃稱高宗；帝辛湛湎，諸侯不享。作殷本紀第三。"},{"work_id":"w-shiji","book_id":"b-shiji-003","source_id":"s-shiji-003-yin","chapter_id":"c-shiji-003-yin","paragraph_id":"c-shiji-003-yin:p021","quote":"帝小乙崩，子帝武丁立。帝武丁即位，思復興殷，而未得其佐。三年不言，政事決定於冢宰，以觀國風。武丁夜夢得聖人，名曰說。以夢所見視群臣百吏，皆非也。於是迺使百工營求之野，得說於傅險中。是時說為胥靡，筑於傅險。見於武丁，武丁曰是也。得而與之語，果聖人，舉以為相，殷國大治。故遂以傅險姓之，號曰傅說。"}],"prior_source_qualifications":[{"source_mention_ids":["c-shiji-130-taishigong:m015-0023"],"metadata":{"label":"說（武丁得說）（太史公自序候選）","status":"active","historicity":"historical_tradition"},"original_registry_record_sha256":"5c185d0527966fa0bda0fb10f2988eb0a425ae24397b8fed1482a1616023a3ba","qualification":"合併前來源限定判讀；逐值保留，不替代現役人物既有姓名、historicty或review。"}],"rationale":"武丁傅險得說舉相，明號傅說；不接韓說中行說。 原詞、篇題、引語/補作層及來源傳統資格不改；不新增生平、遠祖連接或日期。","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-061-zhou-family:p010","text":"夫傅說之相高宗，申召之輔宣王，管仲之佐齊桓，衰范之翼晉文，或宗師其道，垂拱受成，委以權重，終至匡主，未有憂其逼己，還為國蠹者也。始田氏擅齊，王莽篡漢，皆藉封土之強，假累世之寵，因暗弱之主，資母后之權，樹比周之黨，階絕滅之勢，然後乃能行其私謀，以成篡奪之禍耳。豈遇立功之主，為天人所相，而能運其奸計，以濟其不軌者哉！光武以王族奮于閭閻，因時之望，收攬英奇，遂續漢業，以美中興之功。及天下既定，頗廢黜功臣者，何哉？武力之士不達國體，以立一時之功，不可久假以權勢，其興廢之事，亦可見矣。近者三國鼎峙，並以雄略之才，命世之能，皆委賴俊哲，終成功業，貽之後嗣，未有愆失遺方來之恨者也。","source_position":{"raw_start":1911,"raw_end":2200,"raw_text":"　　夫傅說之相高宗，申召之輔宣王，管仲之佐齊桓，衰范之翼晉文，或宗師其道，垂拱受成，委以權重，終至匡主，未有憂其逼己，還為國蠹者也。始田氏擅齊，王莽篡漢，皆藉封土之強，假累世之寵，因暗弱之主，資母后之權，樹比周之黨，階絕滅之勢，然後乃能行其私謀，以成篡奪之禍耳。豈遇立功之主，為天人所相，而能運其奸計，以濟其不軌者哉！光武以王族奮于閭閻，因時之望，收攬英奇，遂續漢業，以美中興之功。及天下既定，頗廢黜功臣者，何哉？武力之士不達國體，以立一時之功，不可久假以權勢，其興廢之事，亦可見矣。近者三國鼎峙，並以雄略之才，命世之能，皆委賴俊哲，終成功業，貽之後嗣，未有愆失遺方來之恨者也。","display_wrapper_start":0,"display_wrapper_end":0,"raw_path":"sources/jinshu/wikisource-7903772-raw.wikitext"},"mentions":[{"id":"c-jinshu-061-zhou-family:p010:m0001","start":1,"end":3,"surface":"傅說","kind":"person","person_id":"p77_x5q_v4n","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p010:m0005","start":5,"end":7,"surface":"高宗","kind":"person","person_id":"cld_aan_e20","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p010:m0008","start":8,"end":9,"surface":"申","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"本單元明見人物；尚未原生匯入。","candidate_person_ids":[]},{"id":"c-jinshu-061-zhou-family:p010:m0009","start":9,"end":10,"surface":"召","kind":"person","person_id":"s74_0jk_msn","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p010:m0012","start":12,"end":14,"surface":"宣王","kind":"person","person_id":"lt5_gcv_iqh","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"}