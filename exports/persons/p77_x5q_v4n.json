dentified"},{"id":"c-shiji-003-yin:m021-0011","start":11,"end":14,"surface":"帝武丁","kind":"person","person_id":"cld_aan_e20","status":"source_identified"},{"id":"c-shiji-003-yin:m021-0038","start":38,"end":40,"surface":"冢宰","kind":"unresolved","person_id":null,"status":"unresolved","note":"氏族、群體、官稱或未定個人指代；不由熟知故事補出姓名。"},{"id":"c-shiji-003-yin:m021-0046","start":46,"end":48,"surface":"武丁","kind":"person","person_id":"cld_aan_e20","status":"source_identified"},{"id":"c-shiji-003-yin:m021-0056","start":56,"end":57,"surface":"說","kind":"person","person_id":"p77_x5q_v4n","status":"source_identified"},{"id":"c-shiji-003-yin:m021-0084","start":84,"end":85,"surface":"說","kind":"person","person_id":"p77_x5q_v4n","status":"source_identified"},{"id":"c-shiji-003-yin:m021-0092","start":92,"end":93,"surface":"說","kind":"person","person_id":"p77_x5q_v4n","status":"source_identified"},{"id":"c-shiji-003-yin:m021-0104","start":104,"end":106,"surface":"武丁","kind":"person","person_id":"cld_aan_e20","status":"source_identified"},{"id":"c-shiji-003-yin:m021-0107","start":107,"end":109,"surface":"武丁","kind":"person","person_id":"cld_aan_e20","status":"source_identified"},{"id":"c-shiji-003-yin:m021-0143","start":143,"end":145,"surface":"傅說","kind":"person","person_id":"p77_x5q_v4n","status":"source_identified"}],"annotation_status":"in_progress","chapter_id":"c-shiji-003-yin","book_id":"b-shiji-003","work_id":"w-shiji","source_id":"s-shiji-003-yin"},{"id":"c-shiji-084-qujia:p028","text":"萬物變化兮，固無休息。斡流而遷兮，或推而還。形氣轉續兮，變化而嬗。沕穆無窮兮，胡可勝言！禍兮福所倚，福兮禍所伏；憂喜聚門兮，吉凶同域。彼吳彊大兮，夫差以敗；越棲會稽兮，句踐霸世。斯游遂成兮，卒被五刑；傅說胥靡兮，乃相武丁。夫禍之與福兮，何異糾纆。命不可說兮，孰知其極？水激則旱兮，矢激則遠。萬物回薄兮，振蕩相轉。雲蒸雨降兮，錯繆相紛。大專槃物兮，坱軋無垠。天不可與慮兮，道不可與謀。遲數有命兮，惡識其時？","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m028-0073","start":73,"end":75,"surface":"夫差","kind":"person","person_id":"v6t_g69_7z5","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m028-0084","start":84,"end":86,"surface":"句踐","kind":"person","person_id":"drd_2tl_s7k","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m028-0089","start":89,"end":90,"surface":"斯","kind":"person","person_id":"8rc_l89_zwn","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m028-0100","start":100,"end":102,"surface":"傅說","kind":"person","person_id":"p77_x5q_v4n","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m028-0108","start":108,"end":110,"surface":"武丁","kind":"person","person_id":"mag_1sz_m8r","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"},{"id":"c-shiji-124-youxia:p002","text":"且緩急，人之所時有也。太史公曰：昔者虞舜窘於井廩，伊尹負於鼎俎，傅說匿於傅險，呂尚困於棘津，夷吾桎梏，百里飯牛，仲尼畏匡，菜色陳、蔡。此皆學士所謂有道仁人也，猶然遭此菑，況以中材而涉亂世之末流乎？其遇害何可勝道哉！","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-124-youxia:m002-0011","start":11,"end":14,"surface":"太史公","kind":"person","person_id":"pme_eis_xqi_*A*AAAAA","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m002-0018","start":18,"end":20,"surface":"虞舜","kind":"person","person_id":"ddb_l4j_4j2","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m002-0025","start":25,"end":27,"surface":"伊尹","kind":"person","person_id":"itn_zi2_il4","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m002-0032","start":32,"end":34,"surface":"傅說","kind":"person","person_id":"p77_x5q_v4n","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m002-0039","start":39,"end":41,"surface":"呂尚","kind":"person","person_id":"1g3_02y_oor","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m002-0046","start":46,"end":48,"surface":"夷吾","kind":"person","person_id":"h1v_8ap_b9y","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m002-0051","start":51,"end":53,"surface":"百里","kind":"person","person_id":"ylb_ttg_8dr","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m002-0056","start":56,"end":58,"surface":"仲尼","kind":"person","person_id":"fp6_ia6_7yw","status":"contextual_provisional"}],"chapter_id":"c-shiji-124-youxia","book_id":"b-shiji-124","work_id":"w-shiji","source_id":"s-shiji124-youxia"},{"id":"c-shiji-130-taishigong:p015","text":"維契作商，爰及成湯；太甲居桐，德盛阿衡；武丁得說，乃稱高宗；帝辛湛湎，諸侯不享。作殷本紀第三。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m015-0001","start":1,"end":2,"surface":"契","kind":"person","person_id":"ea8_yum_lvj","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m015-0007","start":7,"end":9,"surface":"成湯","kind":"person","person_id":"tpz_x3m_e0h","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m015-0010","start":10,"end":12,"surface":"太甲","kind":"person","person_id":"2qj_hw4_si9","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m015-0017","start":17,"end":19,"surface":"阿衡","kind":"person","person_id":"itn_zi2_il4","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m015-0020","start":20,"end":22,"surface":"武丁","kind":"person","person_id":"cld_aan_e20","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m015-0023","start":23,"end":24,"surface":"說","kind":"person","person_id":"p77_x5q_v4n","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m015-0027","start":27,"end":29,"surface":"高宗","kind":"person","person_id":"cld_aan_e20","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m015-0030","start":30,"end":32,"surface":"帝辛","kind":"person","person_id":"lwx_9yq_ad7","status":"contextual_provisional"}],"chapter_id":"c-shiji-130-taishigong","book_id":"b-shiji-130","work_id":"w-shiji","source_id":"s-shiji130-taishigong"}],"table_passages":[{"id":"shiji-013-t2-r021-c00","column":0,"rowspan":1,"colspan":1,"text":"帝武丁。雉升鼎耳雊。得傅說。稱高宗。","source_row":21,"source_column":1,"printed_page":null,"person_mentions":[{"id":"shiji-013-t2-r021-c00-m000","start":1,"end":3,"surface":"武丁","person_id":"cld_aan_e20","status":"contextual_provisiona