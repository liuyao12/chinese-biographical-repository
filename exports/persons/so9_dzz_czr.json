070,2071,2072,2073,2074,2075,2076,2077,2078,2079,2080,2081,2082,2083,2084,2085,2086,2087,2088,2089,2090,2091,2092,2093,2094,2095,2096,2097,2233,2234,2235,2236,2237,2238,2239,2240,2241,2242,2243,2244,2245,2246,2247,2248,2249,2250,2251,2252,2253,2254,2255,2256,2257,2258,2259,2260,2261,2262,2263,2264,2265,2266,2267,2268,2269,2270,2271,2272,2273,2274,2275,2276,2277,2278,2279,2280,2281,2282,2283,2284,2285,2286,2287,2288,2289,2290,2291,2292,2293,2294,2295,2296,2297,2298,2299,2300,2301,2302,2303,2304,2305,2306,2307,2308,2309,2310,2311,2312,2313,2314,2315,2316,2317,2318,2319,2320,2321,2322,2323,2324,2325,2326,2327,2328,2329,2330,2331,2332,2333,2334,2335,2336,2337,2338,2339,2340,2341,2342,2343,2344,2345,2346,2347,2348,2349,2350,2351,2352,2353,2354,2355,2356,2357,2358,2359,2360,2361,2362],"projection_sha256":"05d1c9bc1d79ebaef8bc23e96625ad452cb4fda31466dd3e675394d2ccd9dec2"},"chapter_id":"c-nanqishu-020-wangbaoming","book_id":"b-nanqishu-020","work_id":"w-nanqishu","source_id":"s-nanqishu-020-wangbaoming-ws2074177"},{"id":"c-nanqishu-032-zhangdai-family:p009","text":"尋加散騎常侍。建元元年，出爲左將軍、吳郡太守。太祖知岱歷任清直，至郡未幾，手敕岱曰：「大邦任重，乃未欲回換，但總戎務殷，宜須望實，今用卿爲護軍。」加給事中。岱拜竟，詔以家爲府。陳疾。明年，遷金紫光祿大夫，領鄱陽王師。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":48,"last_line":48,"raw_start":2251,"raw_end":2366,"raw_character_offsets":[2251,2252,2253,2254,2255,2256,2257,2263,2264,2265,2266,2269,2270,2271,2272,2273,2274,2275,2276,2277,2278,2279,2280,2281,2282,2283,2284,2285,2286,2287,2288,2289,2290,2291,2292,2293,2294,2295,2296,2297,2298,2299,2300,2301,2302,2303,2304,2305,2306,2307,2308,2309,2310,2311,2312,2313,2314,2315,2316,2317,2318,2319,2320,2321,2322,2323,2324,2325,2326,2327,2328,2329,2330,2331,2332,2333,2334,2335,2336,2337,2338,2339,2340,2341,2342,2343,2344,2345,2346,2347,2348,2349,2350,2351,2352,2353,2354,2355,2356,2357,2358,2359,2360,2361,2362,2363,2364,2365],"revision_id":1513918},"mentions":[{"id":"c-nanqishu-032-zhangdai-family:p009:m0026","start":26,"end":27,"surface":"岱","kind":"person","person_id":"d50_8f5_wul_AAAAD","status":"contextual_provisional"},{"id":"c-nanqishu-032-zhangdai-family:p009:m0039","start":39,"end":40,"surface":"岱","kind":"person","person_id":"d50_8f5_wul_AAAAD","status":"contextual_provisional"},{"id":"c-nanqishu-032-zhangdai-family:p009:m0078","start":78,"end":79,"surface":"岱","kind":"person","person_id":"d50_8f5_wul_AAAAD","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-032-zhangdai-family","book_id":"b-nanqishu-032","work_id":"w-nanqishu","source_id":"s-nanqishu-032-zhangdai-family-ws1513918"},{"id":"c-nanqishu-049-wanghuan-complete:p004","text":"出爲吳興太守，秩中二千石，將軍如故。尋進號征虜將軍。建元元年，進號左將軍。明年，遷太常，領鄱陽王師，仍轉侍中，祕書監，領驍騎將軍。又遷征虜將軍、臨川王鎮西長史、領南蠻校尉、南郡內史。奐一歲三遷，上表固讓南蠻曰：「今天地初辟，萬物載新，荊蠻來威，巴濮不擾。但使邊民樂業，有司脩務，本府舊州，日就殷阜。臣昔遊西土，較見盈虛，兼日者戎燼之後，痍毀難復。雖復緝以善政，未及來蘇。今復割撤大府，制置偏校，崇望不足以助強，語實安能以相弊？且資力旣分，職司增廣，衆勞務倍，文案滋煩。非獨臣見其難，竊以爲國計非允。」見許。於是罷南蠻校尉官。進號前將軍。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":17,"last_line":17,"raw_start":488,"raw_end":763,"raw_character_offsets":[488,489,490,491,492,493,494,495,496,497,498,499,500,501,502,503,504,505,506,507,508,509,510,511,512,513,519,520,521,522,525,526,527,528,529,530,531,532,533,534,535,536,537,538,539,540,541,542,543,544,545,546,547,548,549,550,551,552,553,554,555,556,557,558,559,560,561,562,563,564,565,566,567,568,569,570,571,572,573,574,575,576,577,578,579,580,581,582,583,584,585,586,587,588,589,590,591,592,593,594,595,596,597,598,599,600,601,602,603,604,605,606,607,608,609,610,611,612,613,614,615,616,617,618,619,620,621,622,623,624,625,626,627,628,629,630,631,632,633,634,635,636,637,638,639,640,641,642,643,644,645,646,647,648,649,650,651,652,653,654,655,656,657,658,659,660,661,662,663,664,665,666,667,668,669,670,671,672,673,674,675,676,677,678,679,680,681,682,683,684,685,686,687,688,689,690,691,692,693,694,695,696,697,698,699,700,701,702,703,704,705,706,707,708,709,710,711,712,713,714,715,716,717,718,719,720,721,722,723,724,725,