entions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-059-he:line030:m0043","start":43,"end":45,"surface":"劉寶","kind":"person","person_id":"c59_mmq_mmm","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-059-he:line030","chapter_id":"c-sanguozhi-059-he"},{"id":"c-sanguozhi-059-he:line030:m0054","start":54,"end":55,"surface":"寶","kind":"person","person_id":"c59_mmq_mmm","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-059-he:line030","chapter_id":"c-sanguozhi-059-he"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-059-he:line030","text":"是時有司頗以條書問事，和以爲姦妄之人，將因事錯意，以生禍心，不可長也，表宜絕之。又都督劉寶白庶子丁晏，晏亦白寶，和謂晏曰：「文武在事，當能幾人，因隙構簿，圖相危害，豈有福哉？」遂兩釋之，使之從厚。常言當世士人宜講脩術學，校習射御，以周世務，而但交游博弈以妨事業，非進取之謂。後羣寮侍宴，言及博弈，以爲妨事費日而無益於用，勞精損思而終無所成，非所以進德脩業，積累功緒者也。且志士愛日惜力，君子慕其大者，高山景行，恥非其次。夫以天地長乆，而人居其間，有白駒過隙之喻，年齒一暮，榮華不再。凡所患者，在於人情所不能絕，誠能絕無益之欲以奉德義之塗，棄不急之務以脩功業之基，其於名行，豈不善哉？夫人情猶不能無嬉娛，嬉娛之好，亦在於飲宴琴書射御之間，何必博弈，然後爲歡。乃命侍坐者八人，各著論以矯之。於是中庶子韋曜退而論奏，和以示賔客。時蔡穎好弈，直事在署者頗斆焉，故以此諷之。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-059-he:line030:m0011","start":11,"end":12,"surface":"和","kind":"person","person_id":"572_278_cba_A","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"i