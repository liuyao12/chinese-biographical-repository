，進爵為伯。","text_layer":"received_chapter","annotation_status":"in_progress","source_position":{"revision_id":2087998,"raw_start":657,"raw_end":845,"source_layer":"received_biography","raw_character_offsets":[657,658,659,660,661,662,663,664,665,666,667,668,669,670,671,672,673,674,675,676,677,678,679,680,681,682,683,684,685,686,687,688,689,690,691,692,693,694,695,696,697,698,699,700,701,702,703,704,705,706,707,708,709,710,711,712,713,714,715,716,717,718,719,720,721,722,723,724,725,726,727,728,729,730,731,732,733,734,735,736,737,738,739,740,741,742,743,744,745,746,747,748,749,750,751,752,753,754,755,756,757,758,759,760,761,762,763,764,765,766,767,768,769,770,771,772,773,774,775,776,777,778,779,780,781,782,783,784,785,786,787,788,789,790,791,792,793,794,795,796,797,798,799,800,801,802,803,804,805,806,807,808,809,810,811,812,813,814,815,816,817,818,819,820,821,822,823,824,825,826,827,828,829,830,831,832,833,834,835,836,837,838,839,840,841,842,843,844],"projection_sha256":"823af8ba0ca7714d2875c686704bdc2a0849a6c4a4042ad01e5d87260ddf24c1"},"mentions":[{"id":"c-weishu-weishou-058-yangbo-yangkan:p004:m0004","start":4,"end":7,"surface":"崔慧景","kind":"person","person_id":"tvq_7my_nqh","status":"contextual_provisional","interpretation_note":"完整本源上下文與已錄同朝／同事來源核對之首選；逐人理由見identity-review。"},{"id":"c-weishu-weishou-058-yangbo-yangkan:p004:m0008","start":8,"end":10,"surface":"蕭衍","kind":"person","person_id":"fo7_f8v_rmf","status":"contextual_provisional","interpretation_note":"完整本源上下文與已錄同朝／同事來源核對之首選；逐人理由見identity-review。"},{"id":"c-weishu-weishou-058-yangbo-yangkan:p004:m0037","start":37,"end":39,"surface":"高祖","kind":"person","person_id":"8dc_745_f37","status":"contextual_provisional","interpretation_note":"完整本源上下文與已錄同朝／同事來源核對之首選；逐人理由見identity-review。"},{"id":"c-weishu-weishou-058-yangbo-yangkan:p004:m0043","start":43,"end":47,"surface":"彭城王勰","kind":"person","person_id":"tpb_cd9_6lc","status":"contextual_provisional","interpretation_note":"中軍彭城王勰與高祖賭射，同場元遙及播；源內名爵可辨，不補父子攸鏈。"},{"id":"c