:81,"end":82,"surface":"客","kind":"person","person_id":"upk_0j8_ffk","status":"contextual_provisional","paragraph_id":"c-shiji-044-wei:p036","chapter_id":"c-shiji-044-wei"},{"id":"c-shiji-044-wei:m036-0162","start":162,"end":163,"surface":"客","kind":"person","person_id":"upk_0j8_ffk","status":"contextual_provisional","paragraph_id":"c-shiji-044-wei:p036","chapter_id":"c-shiji-044-wei"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji044-066","person_id":"upk_0j8_ffk","surfaces":["外黃徐子","客"],"scope":"same_chapter","chapter_ids":["c-shiji-044-wei"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-044-wei:p036","quote":"卅年，魏伐趙，趙告急齊。齊宣王用孫子計，救趙撃魏。魏遂大興師，使龐涓將，而令太子申爲上將軍。過外黃，外黃徐子謂太子曰：『臣有百戰百勝之術。』太子曰：『可得聞乎？』客曰：『固願效之。』曰：『太子自將攻齊，大勝并莒，則富不過有魏，貴不益爲王。若戰不勝齊，則萬世无魏矣。此臣之百戰百勝之術也。』太子曰：『諾，請必從公之言而還矣。』客曰：『太子雖欲還，不得矣。彼勸太子戰攻，欲啜汁者衆。太子雖欲還，恐不得矣。』太子因欲還，其御曰：『將出而還，與北同。』太子果與齊人戰，敗於馬陵。齊虜魏太子申，殺將軍涓，軍遂大破。"}],"rationale":"限本篇明示姓名、是為及同段連續語境；外黃徐子／客按同一勸還對話暫接，龐涓／涓按同一馬陵戰暫接。孫子與孫臏、公子赫與襄王、齊王與齊宣王仍分候選；武下將識國別待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-044-wei:p036","text":"卅年，魏伐趙，趙告急齊。齊宣王用孫子計，救趙撃魏。魏遂大興師，使龐涓將，而令太子申爲上將軍。過外黃，外黃徐子謂太子曰：『臣有百戰百勝之術。』太子曰：『可得聞乎？』客曰：『固願效之。』曰：『太子自將攻齊，大勝并莒，則富不過有魏，貴不益爲王。若戰不勝齊，則萬世无魏矣。此臣之百戰百勝之術也。』太子曰：『諾，請必從公之言而還矣。』客曰：『太子雖欲還，不得矣。彼勸太子戰攻，欲啜汁者衆。太子雖欲還，恐不得矣。』太子因欲還，其御曰：『將出而還，與北同。』太子果與齊人戰，敗於馬陵。齊虜魏太子申，殺將軍涓，軍遂大破。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-044-wei:m036-0012","start":12,"end":15,"surface":"齊宣王","kind":"person","person_id":"jlp_iua_bsf","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m036-0016","start":16,"end":18,"surface":"孫子","kind":"person","person_id":"tsk_1dl_p70","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m036-0032","start":32,"end":34,"surface":"龐涓","kind":"person","person_id":"gv0_6h6_ek6","status