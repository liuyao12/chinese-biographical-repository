故太公望封於營丘，地澙鹵，人民寡，於是太公勸其女功，極技巧，通魚鹽，則人物歸之，繦至而輻湊。故齊冠帶衣履天下，海岱之閒斂袂而往朝焉。其後齊中衰，管子修之，設輕重九府，則桓公以霸，九合諸侯，一匡天下；而管氏亦有三歸，位在陪臣，富於列國之君。是以齊富彊至於威、宣也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-129-huozhi:m004-0104","start":104,"end":107,"surface":"太公望","kind":"person","person_id":"o6i_h2h_p8x","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m004-0122","start":122,"end":124,"surface":"太公","kind":"person","person_id":"o6i_h2h_p8x","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m004-0175","start":175,"end":177,"surface":"管子","kind":"person","person_id":"s42_8cl_8n4","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m004-0187","start":187,"end":189,"surface":"桓公","kind":"person","person_id":"j1b_ffs_x7d","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m004-0203","start":203,"end":205,"surface":"管氏","kind":"person","person_id":"s42_8cl_8n4","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m004-0229","start":229,"end":230,"surface":"威","kind":"person","person_id":"1jw_cyx_37h","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m004-0231","start":231,"end":232,"surface":"宣","kind":"person","person_id":"i4l_q6t_81o","status":"contextual_provisional"}],"chapter_id":"c-shiji-129-huozhi","book_id":"b-shiji-129","work_id":"w-shiji","source_id":"s-shiji129-huozhi"}],"sources":[{"chapter_id":"c-shiji-129-huozhi","work_id":"w-shiji","book_id":"b-shiji-129","source_id":"s-shiji129-huozhi","source":{"title":"史記／卷129","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷129","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷129&oldid=7904128","revision_id":7904128,"accessed_on":"2026-10-11","extent":"固定修訂全文43段，篇文42段、索隱述贊1段。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"去header2、現代節標及索隱述贊層