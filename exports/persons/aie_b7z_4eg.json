ima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-liangshu-033-wangyun-rendered:p003:m0024","kind":"person","start":378,"end":379,"surface":"牙","person_id":"aie_b7z_4eg","status":"contextual_provisional","source_role":"ya","paragraph_id":"c-liangshu-033-wangyun-rendered:p003","chapter_id":"c-liangshu-033-wangyun-rendered"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-033-wangyun-rendered:p003","text":"起家中軍臨川王行參軍，遷太子舍人，除尚書殿中郎。王氏過江以來，未有居郎署者，或勸逡巡不就，筠曰：「陸平原東南之秀，王文度獨步江東，吾得比蹤昔人，何所多恨。」乃欣然就職。尚書令沈約，當世辭宗，每見筠文，咨嗟吟詠，以爲不逮也。嘗謂筠：「昔蔡伯喈見王仲宣稱曰：『王公之孫也，吾家書籍，悉當相與。』僕雖不敏，請附斯言。自謝朓諸賢零落已後，平生意好，殆將都絕，不謂疲暮，復逢於君。」約於郊居宅造閣齋，筠爲草木十詠，書之於壁，皆直寫文詞，不加篇題。約謂人云：「此詩指物呈形，無假題署。」約制《郊居賦》，構思積時，猶未都畢，乃要筠示其草，筠讀至「雌霓連蜷」，約撫掌欣抃曰：「僕嘗恐人呼爲霓。」次至「墜石磓星」，及「冰懸坎而帶坻」。筠皆擊節稱讚。約曰：「知音者希，真賞殆絕，所以相要，政在此數句耳。」筠又嘗爲詩呈約，卽報書云：「覽所示詩，實爲麗則，聲和被紙，光影盈字。夔、牙接響，顧有餘慚；孔翠羣翔，豈不多愧。古情拙目，每佇新奇，爛然總至，權輿已盡。會昌昭發，蘭揮玉振，克諧之義，寧比笙簧。思力所該，一至乎此，嘆服吟研，周流忘念。昔時幼壯，頗愛斯文，含咀之間，倏焉疲暮。不及後進，誠非一人，擅美推能，實歸吾子。遲比閑日，清覯乃申。」筠爲文能壓強韻，每公宴並作，辭必妍美。約常從容啓高祖曰：「晚來名家，唯見王筠獨步。」","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-liangshu-033-wangyun-rendered:p003:m0001","kind":"person","start":4,"end":7,"surface":"臨川王","person_id":"cav_2xc_9bq_AC","status":"contextual_provisional","source_role":"linchuan_wang"},{"id":"c-liangshu-033-wangyun-rendered:p003:m0002","kind":"person","start":45,"end":46,"surface":"筠","person_id":"7r6_k52_qji_ABAAAAEBDA","status":"contextual_provisional","source_role":"wangyun"},{"id":"c-liangshu-033-wangyun-rendered:p003:m0003"