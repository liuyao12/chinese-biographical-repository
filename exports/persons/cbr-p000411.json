88-0017","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"保存本段明示命、使、立、遷或敘事用稱；將某軍保留原詞作任事描述。原紀年不換算公曆，未知起訖不由卒、出奔、被俘或首次提及補造；追諡另待覆核。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji039-026","person_id":"cbr-p000411","title":"卿","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-039-jin","source_id":"s-shiji-039-jin","paragraph_id":"c-shiji-039-jin:p103","quote":"十二年冬，齊頃公如晉，欲上尊晉景公爲王，景公讓不敢。晉始作六（卿）［軍］，韓厥、鞏朔、趙穿、荀騅、趙括、趙旃皆爲卿。智罃自楚歸。"}],"attestations":[{"id":"th-shiji039-026:a001","paragraph_id":"c-shiji-039-jin:p103","start":56,"end":57,"surface":"卿","person_mention_id":"c-shiji-039-jin:m103-0043","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":"十二年冬","evidence":[{"chapter_id":"c-shiji-039-jin","source_id":"s-shiji-039-jin","paragraph_id":"c-shiji-039-jin:p103","quote":"十二年冬，齊頃公如晉，欲上尊晉景公爲王，景公讓不敢。晉始作六（卿）［軍］，韓厥、鞏朔、趙穿、荀騅、趙括、趙旃皆爲卿。智罃自楚歸。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"保存本段明示命、使、立、遷或敘事用稱；將某軍保留原詞作任事描述。原紀年不換算公曆，未知起訖不由卒、出奔、被俘或首次提及補造；追諡另待覆核。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji032-054","person_id":"cbr-p000411","surfaces":["趙穿"],"scope":"cross_chapter","chapter_ids":["c-shiji-005-qin","c-shiji-032-qi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-005-qin:p041","quote":"共公二年，晉趙穿弒其君靈公。三年，楚莊王彊，北兵至雒，問周鼎。共公立五年卒，子桓公立。"},{"paragraph_id":"c-shiji-032-qi:p054","quote":"惠公二年，長翟來，王子城父攻殺之，埋之於北門。晉趙穿弒其君靈公。"}],"rationale":"按本篇小白立桓公、管仲任政、葵丘盟會及齊君／母親的明示敘事相接暫定；魯與齊的同號君主、同氏女性分開，不作全庫字串合併。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji039-074","person_id":"cbr-p000411","surfaces":["趙穿"],"scope":"cross_chapter","chapter_ids":["c-shiji-005-qin","c-shiji-039-jin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-005-qin:p041","quote":"共公二年，晉趙穿弒其君靈公。三年，楚莊王彊，北兵至雒，問周鼎。共公立五年卒，子桓公立。"},{"paragraph_id":"c-shiji-039-jin:p084","quote":"四年，伐秦，取少梁。秦亦取晉之郩。六年，秦康公伐晉，取羈馬。晉侯怒，使趙盾、趙穿、郤缺撃秦，大戰河曲，趙穿最有功。七年，晉六卿患隨會之在秦，常爲晉亂，乃詳令魏壽餘反晉降秦。秦使隨會之魏，因執會以歸晉。"},{"paragraph_id":"c-shiji-039-jin:p088","quote":"盾遂奔，未出晉境。乙丑，盾昆弟將軍趙穿襲殺靈公於桃園而迎趙盾。趙盾素貴，得民和；靈公少，侈，民不附，故爲弒易。盾復位。晉太史董狐書曰「趙盾弒其君」，以視於朝。盾曰：「弒者趙穿，我無罪。」太史曰：「子爲正卿，而亡不出境，反不誅國亂，非子而誰？」孔子聞之，曰：「董狐，古之良史也，書法不隱。宣子，良大夫也，爲法受惡。惜也，出疆乃免。」"},{"paragraph_id":"c-shiji-039-jin:p089","quote":"趙盾使趙穿迎襄公弟黑臀于周而立之，是爲成公。"},{"paragraph_id":"c-shiji-039-jin:p103","quote":"十二年冬，齊頃公如晉，欲上尊晉景公爲王，景公讓不敢。晉始作六（卿）［軍］，韓厥、鞏朔、趙穿、荀騅、趙括、趙旃皆爲卿。智罃自楚歸。"}],"rationale":"按本篇明示名與稱號、晉世系與具體事件暫定所列提及同指；附各段原文，未按同字短名全域合併；紀年與版本差異待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-005-qin:p041","text":"共公二年，晉趙穿弒其君靈公。三年，楚莊王彊，北兵至雒，問周鼎。共公立五年卒，子桓公立。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m041-0000","start":0,"end":2,"surface":"共公","kind":"person","person_id":"cbr-p000410","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m041-0005","start":5,"end":8,"surface":"晉趙穿","kind":"person","person_id":"cbr-p000411","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m041-0011","start":11,"end":13,"surface":"靈公","kind":"person","person_id":"cbr-p000412","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m041-0017","start":17,"end":20,"surface":"楚莊王","kind":"person","person_id":"cbr-p000257","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m041-0031","start":31,"end":33,"surface":"共公","kind":"person","person_id":"cbr-p000410","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m041-0039","start":39,"end":41,"surface":"桓公","kind":"person","person_id":"cbr-p000413","status":"contextual_provisional"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-032-qi:p054","text":"惠公二年，長翟來，王子城父攻殺之，埋之於北門。晉趙穿弒其君靈公。","annotation_stat