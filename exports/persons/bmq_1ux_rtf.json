cisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-080-wangxizhi-family:line120:m0149","start":149,"end":152,"surface":"茅季偉","person_id":"bmq_1ux_rtf","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。","paragraph_id":"c-jinshu-080-wangxizhi-family:line120","chapter_id":"c-jinshu-080-wangxizhi-family"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-080-wangxizhi-family:line120","text":"許邁，字叔玄，一名映，丹陽句容人也。家世士族，而邁少恬靜，不慕仕進。未弱冠，嘗造郭璞，璞為之筮，遇《泰》之《大畜》，其上六爻發。璞謂曰：「君元吉自天，宜學升遐之道。」時南海太守鮑靚隱跡潛遁，人莫之知。邁乃往候之，探其至要。父母尚存，未忍違親。謂余杭懸霤山近延陵之茅山，是洞庭西門，潛通五嶽，陳安世、茅季偉常所遊處，於是立精舍於懸霤，而往來茅嶺之洞室，放絕世務，以尋仙館，朔望時節還家定省而已。父母既終，乃遣婦孫氏還家，遂攜其同志遍游名山焉。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-080-wangxizhi-family:line120:m0000","start":0,"end":2,"surface":"許邁","person_id":"972_dh9_hz4","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。"},{"id":"c-jinshu-080-wangxizhi-family:line120:m0004","start":4,"end":6,"surface":"叔玄","person_id":"972_dh9_hz4","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。"},{"id":"c-jinshu-080-wangxizhi-family:line120:m0009","start":9,"end":10,"surface":"映","person_id":"972_dh9_hz4","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。"},{"id":"c-jinshu-080-wangxizhi-family:line120:m0024","start":24,"end":25,"surface":"邁","person_id":"972_dh9_hz4","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。"},{"id":"c-jinshu-080-wangxizhi-family:line120:m0040","start