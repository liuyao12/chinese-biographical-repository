,"family_paths":[],"mentions":[{"id":"c-jinshu-064-simapeng:p001:m0053","surface":"孔樸","start":53,"end":55,"person_id":"jyy_l58_hvg","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-064-simapeng:p001","chapter_id":"c-jinshu-064-simapeng"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-064-simapeng:p001","text":"梁王㻱，字賢明，出繼梁王翹，官至永安太僕，與父晞俱廢。薨，子和嗣。太元中復國。薨，子珍之嗣。桓玄篡位，國人孔樸奉珍之奔于壽陽。桓玄敗，珍之歸朝廷。太將軍武陵王令曰：「梁王珍之理悟貞立，蒙險違難，撫義懷順，載奔闕庭。值壽陽擾亂，在危克固，且可通直散騎郎。」累遷遊擊將軍、左衛、太常。劉裕伐姚泓，請為諮議參軍。裕將弱王室，誣其罪害之。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":83,"last_line":83,"raw_start":5104,"raw_end":5327,"raw_character_offsets":[5106,5107,5108,5109,5110,5111,5112,5113,5114,5115,5116,5117,5118,5119,5120,5121,5122,5123,5124,5125,5126,5127,5128,5129,5130,5131,5132,5133,5134,5135,5136,5137,5138,5139,5140,5141,5142,5143,5144,5145,5146,5147,5148,5149,5150,5151,5152,5153,5154,5155,5156,5157,5158,5159,5160,5161,5162,5163,5164,5165,5166,5167,5224,5225,5226,5227,5228,5229,5230,5231,5232,5233,5234,5235,5236,5237,5238,5239,5240,5241,5242,5243,5244,5245,5246,5247,5248,5249,5250,5251,5252,5253,5254,5255,5256,5257,5258,5259,5260,5261,5262,5263,5264,5265,5266,5267,5268,5269,5270,5271,5272,5273,5274,5275,5276,5277,5278,5279,5280,5281,5282,5283,5284,5285,5286,5287,5288,5289,5290,5291,5292,5293,5294,5295,5296,5297,5298,5299,5300,5301,5302,5303,5304,5305,5306,5307,5308,5309,5310,5311,5312,5313,5314,5315,5316,5317,5318,5319,5320,5321,5322,5323,5324,5325,5326],"revision_id":2622004},"mentions":[{"id":"c-jinshu-064-simapeng:p001:m0000","surface":"梁王㻱","start":0,"end":3,"person_id":"3cj_l0c_nd8","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-064-simapeng:p001:m0010","surface":"梁王翹","start":10,"end":13,"person_id":"ong_3kb_v90",