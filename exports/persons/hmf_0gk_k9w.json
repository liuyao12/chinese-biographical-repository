hiji-104-tianshu"},{"id":"c-shiji-104-tianshu:m012-0006","start":6,"end":9,"surface":"衛將軍","kind":"person","person_id":"hmf_0gk_k9w","status":"contextual_provisional","paragraph_id":"c-shiji-104-tianshu:p012","chapter_id":"c-shiji-104-tianshu"},{"id":"c-shiji-104-tianshu:m012-0015","start":15,"end":17,"surface":"將軍","kind":"person","person_id":"hmf_0gk_k9w","status":"contextual_provisional","paragraph_id":"c-shiji-104-tianshu:p012","chapter_id":"c-shiji-104-tianshu"},{"id":"c-shiji-104-tianshu:m012-0050","start":50,"end":53,"surface":"衛將軍","kind":"person","person_id":"hmf_0gk_k9w","status":"contextual_provisional","paragraph_id":"c-shiji-104-tianshu:p012","chapter_id":"c-shiji-104-tianshu"},{"id":"c-shiji-104-tianshu:m012-0054","start":54,"end":56,"surface":"將軍","kind":"person","person_id":"hmf_0gk_k9w","status":"contextual_provisional","paragraph_id":"c-shiji-104-tianshu:p012","chapter_id":"c-shiji-104-tianshu"},{"id":"c-shiji-104-tianshu:m012-0130","start":130,"end":132,"surface":"將軍","kind":"person","person_id":"hmf_0gk_k9w","status":"contextual_provisional","paragraph_id":"c-shiji-104-tianshu:p012","chapter_id":"c-shiji-104-tianshu"},{"id":"c-shiji-104-tianshu:m012-0139","start":139,"end":141,"surface":"將軍","kind":"person","person_id":"hmf_0gk_k9w","status":"contextual_provisional","paragraph_id":"c-shiji-104-tianshu:p012","chapter_id":"c-shiji-104-tianshu"},{"id":"c-shiji-104-tianshu:m012-0188","start":188,"end":191,"surface":"衛將軍","kind":"person","person_id":"hmf_0gk_k9w","status":"contextual_provisional","paragraph_id":"c-shiji-104-tianshu:p012","chapter_id":"c-shiji-104-tianshu"},{"id":"c-shiji-104-tianshu:m012-0226","start":226,"end":229,"surface":"衛將軍","kind":"person","person_id":"hmf_0gk_k9w","status":"contextual_provisional","paragraph_id":"c-shiji-104-tianshu:p012","chapter_id":"c-shiji-104-tianshu"},{"id":"c-shiji-104-tianshu:m012-0272","start":272,"end":274,"surface":"將軍","kind":"person","person_id":"hmf_0gk_k9w","status":"contextual_provisional","paragraph_id":"c-shiji-104-tianshu:p012","chapter_id":"c-shiji-104-tianshu"},{"id":"c-shiji-104-tianshu:m012-0306","start":306,"end":308,"surface":"將軍","kind":"person","person_id":"hmf_0gk_k9w","status":"contextual_provisional","paragraph_id":"c-shiji-104-tianshu:p012","chapter_id":"c-shiji-104-tianshu"},{"id":"c-shiji-104-tianshu:m012-0321","start":321,"end":324,"surface":"衛將軍","kind":"person","person_id":"hmf_0gk_k9w","status":"contextual_provisional","paragraph_id":"c-shiji-104-tianshu:p012","chapter_id":"c-shiji-104-tianshu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji104-018","person_id":"hmf_0gk_k9w","surfaces":["將軍","衛將軍"],"scope":"same_chapter","chapter_ids":["c-shiji-104-tianshu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-104-tianshu:p008","quote":"仁以壯健為衛將軍舍人，數從擊匈奴。衛將軍進言仁，仁為郎中。數歲，為二千石丞相長史，失官。其後使刺舉三河。上東巡，仁奏事有辭，上說，拜為京輔都尉。月餘，上遷拜為司直。數歲，坐太子事。時左相自將兵，令司直田仁主閉守城門，坐縱太子，下吏誅死。仁發兵，長陵令車千秋上變仁，仁族死。陘城今在中山國。"},{"paragraph_id":"c-shiji-104-tianshu:p011","quote":"乃為衛將軍舍人，與田仁會，俱為舍人，居門下，同心相愛。此二人家貧，無錢用以事將軍家監，家監使養惡齧馬。兩人同床臥，仁竊言曰：「不知人哉家監也！」任安曰：「將軍尚不知人，何乃家監也！」衛將軍從此兩人過平陽主，主家令兩人與騎奴同席而食，此二子拔刀列斷席別坐。主家皆怪而惡之，莫敢呵。"},{"paragraph_id":"c-shiji-104-tianshu:p012","quote":"其後有詔募擇衛將軍舍人以為郎，將軍取舍人中富給者，令具鞌馬絳衣玉具劍，欲入奏之。會賢大夫少府趙禹來過衛將軍，將軍呼所舉舍人以示趙禹。趙禹以次問之，十餘人無一人習事有智略者。趙禹曰：「吾聞之，將門之下必有將類。傳曰『不知其君視其所使，不知其子視其所友』。今有詔舉將軍舍人者，欲以觀將軍而能得賢者文武之士也。今徒取盎人子上之，又無智略，如木偶人衣之綺繡耳，將柰之何？」於是趙禹悉召衛將軍舍人百餘人，以次問之，得田仁、任安，曰：「獨此兩人可耳，餘無可用者。」衛將軍見此兩人貧，意不平。趙禹去，謂兩人曰：「各自具樾象絳衣。」兩人對曰：「家貧無用具也。」將軍怒曰：「今兩君家自為貧，何為出此言？鞅鞅如有移德於我者，何也？」將軍不得已，上籍以聞。有詔召見衛將軍舍人，此二人前見，詔問能略相推第也。田仁對曰；「提桴鼓立軍門，使士大夫樂死戰鬬，仁不及任安。」任安對曰：「夫決嫌疑，定是非，辯治官，使百姓無怨心，安不及仁也。」武帝大笑曰：「善。」使任安護北軍，使田仁護邊田穀於河上。此兩人立名天下。"}],"rationale":"依本篇姓名、原稱及敘事回指暫定；褚補與正文分層，未按同名自動跨篇合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-104-tianshu:p008","text":"仁以壯健為衛將軍舍人，數從擊匈奴。衛將軍進言仁，仁為郎中。數歲，為二千石丞相長史，失官。其後使刺舉三河。上東巡，仁奏事有辭，上說，拜為京輔都尉。月餘，上遷拜為司直。數歲，坐太子事。時左相自將兵，令司直田仁主閉守城門，坐縱太子，下吏誅死。仁發兵，長陵令車千秋上變仁，仁族死。陘城今在中山國。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-104-tianshu:m008-0000","start":0,"end":1,"surface":"仁","kind":"person","person_id":"gyt_axg_s7t_A","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m008-0005","start":5,"end":8,"surface":"衛將軍","kind":"person","person_id":"hmf_0gk_k9w","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m008-0017","start":17,"end":20,"surface":"衛將軍","kind":"person","person_id":"hmf_0gk_k9w","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m008-0022","start":22,"end":23,"surface":"仁","kind":"person","person_id":"gyt_axg_s7t_A","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m008-0024","start":24,"end":25,"surface":"仁","kind":"person","person_id":"gyt_axg_s7t_A","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m008-0056","start":56,"end":57,"surface":"仁","kind":"person","person_id":"gyt_axg_s7t_A","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m008-0086","start":86,"end":88,"surface":"太子","kind":"person","person_id":"64t_pmo_3d4","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m008-0091","start":91,"end":93,"surface":"左相","kind":"person","person_id":"x8h_4i8_xwm","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m008-0100","start":100,"end":102,"surface":"田仁","kind":"person","person_id":"gyt_axg_s7t_A","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m008-0110","start":110,"end":112,"surface":"太子","kind":"person","person_id":"64t_pmo_3d4","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m008-0118","start":118,"end":119,"surface":"仁","kind":"person","person_id":"gyt_axg_s7t_A","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m008-0125","start":125,"end":128,"surface":"車千秋","kind":"person","person_id":"14z_ay0_40z","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m008-0130","start":130,"end":131,"surface":"仁","kind":"person","person_id":"gyt_axg_s7t_A","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m008-0132","start":132,"end":133,"surface":"仁","kind":"person","person_id":"gyt_axg_s7t_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-104-tianshu","book_id":"b-shiji-104","work_id":"w-shiji","source_id":"s-shiji-104-tianshu"},{"id":"c-shiji-104-tianshu:p011","text":"乃為衛將軍舍人，與田仁會，俱為舍人，居門下，同心相愛。此二人家貧，無錢用以事將軍家監，家監使養惡齧馬。兩人同床臥，仁竊言曰：「不知人哉家監也！」任安曰：「將軍尚不知人，何乃家監也！」衛將軍從此兩人過平陽主，主家令兩人與騎奴同席而食，此二子拔刀列斷席別坐。主家皆怪而惡之，莫敢呵。","annotation_status":"named_mentions_first_pass","text_layer":"witness_appended_chu_note","mentions":[{"id":"c-shiji-104-tianshu:m011-0002","start":2,"end":5,"surface":"衛將軍","kind":"person","person_id":"hmf_0gk_k9w","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m011-0009","start":9,"end":11,"surface":"田仁","kind":"person","person_id":"gyt_axg_s7t_A","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m011-0038","start":38,"end":40,"surface":"將軍","kind":"person","person_id":"hmf_0gk_k9w","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m011-0040","start":40,"end":42,"surface":"家監","kind":"person","person_id":"xw0_62h_nxt","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m011-0043","start":43,"end":45,"surface":"家監","kind":"person","person_id":"xw0_62h_nxt","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m011-0057","start":57,"end":58,"surface":"仁","kind":"person","person_id":"gyt_axg_s7t_A","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m011-0067","start":67,"end":69,"surface":"家監","kind":"person","person_id":"xw0_62h_nxt","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m011-0072","start":72,"end":74,"surface":"任安","kind":"person","person_id":"y9g_gi6_sn7","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m011-0077","start":77,"end":79,"surface":"將軍","kind":"person","person_id":"hmf_0gk_k9w","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m011-0086","start":86,"end":88,"surface":"家監","kind":"person","person_id":"xw0_62h_nxt","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m011-0091","start":91,"end":94,"surface":"衛將軍","kind":"person","person_id":"hmf_0gk_k9w","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m011-0099","start":99,"end":102,"surface":"平陽主","kind":"person","person_id":"6bp_mr9_l3w","status":"contextual_provisional"}],"chapter_id":"c-shiji-104-tianshu","book_id":"b-shiji-104","work_id":"w-shiji","source_id":"s-shiji-104-tianshu"},{"id":"c-shiji-104-tianshu:p012","text":"其後有詔募擇衛將軍舍人以為郎，將軍取舍人中富給者，令具鞌馬絳衣玉具劍，欲入奏之。會賢大夫少府趙禹來過衛將軍，將軍呼所舉舍人以示趙禹。趙禹以次問之，十餘人無一人習事有智略者。趙禹曰：「吾聞之，將門之下必有將類。傳曰『不知其君視其所使，不知其子視其所友』。今有詔舉將軍舍人者，欲以觀將軍而能得賢者文武之士也。今徒取盎人子上之，又無智略，如木偶人衣之綺繡耳，將柰之何？」於是趙禹悉召衛將軍舍人百餘人，以次問之，得田仁、任安，曰：「獨此兩人可耳，餘無可用者。」衛將軍見此兩人貧，意不平。趙禹去，謂兩人曰：「各自具樾象絳衣。」兩人對曰：「家貧無用具也。」將軍怒曰：「今兩君家自為貧，何為出此言？鞅鞅如有移德於我者，何也？」將軍不得已，上籍以聞。有詔召見衛將軍舍人，此二人前見，詔問能略相推第也。田仁對曰；「提桴鼓立軍門，使士大夫樂死戰鬬，仁不及任安。」任安對曰：「夫決嫌疑，定是非，辯治官，使百姓無怨心，安不及仁也。」武帝大笑曰：「善。」使任安護北軍，使田仁護邊田穀於河上。此兩人立名天下。","annotation_status":"named_mentions_first_pass","text_layer":"witness_appended_chu_note","mentions":[{"id":"c-shiji-104-tianshu:m012-0006","start":6,"end":9,"surface":"衛將軍","kind":"person","person_id":"hmf_0gk_k9w","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m012-0015","start":15,"end":17,"surface":"將軍","kind":"person","person_id":"hmf_0gk_k9w","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m012-0046","start":46,"end":48,"surface":"趙禹","kind":"person","person_id":"3xa_jvi_o6n","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m012-0050","start":50,"end":53,"surface":"衛將軍","kind":"person","person_id":"hmf_0gk_k9w","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m012-0054","start":54,"end":56,"surface":"將軍","kind":"person","person_id":"hmf_0gk_k9w","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m012-0063","start":63,"end":6