0074","start":74,"end":76,"surface":"出於","kind":"person","person_id":"8w8_yyv_mrh","status":"contextual_provisional","paragraph_id":"c-shiji-105-bianque:p024","chapter_id":"c-shiji-105-bianque"},{"id":"c-shiji-105-bianque:m024-0092","start":92,"end":94,"surface":"出於","kind":"person","person_id":"8w8_yyv_mrh","status":"contextual_provisional","paragraph_id":"c-shiji-105-bianque:p024","chapter_id":"c-shiji-105-bianque"}],"relations":[],"title_holdings":[{"id":"th-shiji105-024","person_id":"8w8_yyv_mrh","title":"命婦","kind":"honorific","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-105-bianque","source_id":"s-shiji-105-bianque","paragraph_id":"c-shiji-105-bianque:p024","quote":"齊北宮司空命婦出於病，眾醫皆以為風入中，病主在肺，刺其足少陽脈。臣意診其脈，曰：「病氣疝，客於膀胱，難於前後溲，而溺赤。病見寒氣則遺溺，使人腹腫。」出於病得之欲溺不得，因以接內。所以知出於病者，切其脈大而實，其來難，是蹶陰之動也。脈來難者，疝氣之客於膀胱也。腹之所以腫者，言蹶陰之絡結小肮也。蹶陰有過則脈結動，動則腹腫。臣意即灸其足蹶陰之脈，左右各一所，即不遺溺而溲清，小肮痛止。即更為火齊湯以飲之，三日而疝氣散，即愈。"}],"attestations":[{"id":"th-shiji105-024:a001","paragraph_id":"c-shiji-105-bianque:p024","start":5,"end":7,"surface":"命婦","person_mention_id":"c-shiji-105-bianque:m024-0007","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"依原文保存爵位、王號及身分用稱；齊王故為陽虛侯明示前後用稱，但未據此補起訖年或自行判定封爵終止事件。齊桓侯身分爭議與命婦、美人分類仍待覆核，不以官職中的侯字轉成封爵。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji105-039","person_id":"8w8_yyv_mrh","surfaces":["出於"],"scope":"same_chapter","chapter_ids":["c-shiji-105-bianque"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-105-bianque:p024","quote":"齊北宮司空命婦出於病，眾醫皆以為風入中，病主在肺，刺其足少陽脈。臣意診其脈，曰：「病氣疝，客於膀胱，難於前後溲，而溺赤。病見寒氣則遺溺，使人腹腫。」出於病得之欲溺不得，因以接內。所以知出於病者，切其脈大而實，其來難，是蹶陰之動也。脈來難者，疝氣之客於膀胱也。腹之所以腫者，言蹶陰之絡結小肮也。蹶陰有過則脈結動，動則腹腫。臣意即灸其足蹶陰之脈，左右各一所，即不遺溺而溲清，小肮痛止。即更為火齊湯以飲之，三日而疝氣散，即愈。"}],"ration