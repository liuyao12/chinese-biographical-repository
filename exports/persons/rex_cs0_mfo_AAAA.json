:[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji038-102","person_id":"rex_cs0_mfo_AAAA","surfaces":["景公","景公頭曼"],"scope":"same_chapter","chapter_ids":["c-shiji-038-song"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-038-song:p052","quote":"元公三年，楚公子棄疾弒靈王，自立爲平王。八年，宋火。十年，元公毋信，詐殺諸公子，大夫華、向氏作亂。楚平王太子建來奔，見諸華氏相攻亂，建去如鄭。十五年，元公爲魯昭公避季氏居外，爲之求入魯，行道卒，子景公頭曼立。"},{"paragraph_id":"c-shiji-038-song:p053","quote":"景公十六年，魯陽虎來奔，已復去。二十五年，孔子過宋，宋司馬桓魋惡之，欲殺孔子，孔子微服去。三十年，曹倍宋，又倍晉，宋伐曹，晉不救，遂滅曹有之。三十六年，齊田常弒簡公。"},{"paragraph_id":"c-shiji-038-song:p054","quote":"三十七年，楚惠王滅陳。熒惑守心。心，宋之分野也。景公憂之。司星子韋曰：「可移於相。」景公曰：「相，吾之股肱。」曰：「可移於民。」景公曰：「君者待民。」曰：「可移於歲。」景公曰：「歲饑民困，吾誰爲君！」子韋曰：「天髙聽卑。君有君人之言三，熒惑宜有動。」於是候之，果徙三度。"},{"paragraph_id":"c-shiji-038-song:p055","quote":"六十四年，景公卒。宋公子特攻殺太子而自立，是爲昭公。昭公者，元公之曾庶孫也。昭公父公孫糾，糾父公子褍秦，褍秦即元公少子也。景公殺昭公父糾，故昭公怨殺太子而自立。"}],"rationale":"按本篇明示名與稱號、宋國世系及具體事件暫同指；未把同字短名全域合併，所有引句與未定處保留。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji130-early-cross-chapter-27","person_id":"rex_cs0_mfo_AAAA","scope":"cross_chapter","chapter_ids":["c-shiji-038-song","c-shiji-130-taishigong"],"status":"contextual_provisional","confidence_level":"high","surfaces":["景公"],"identification_basis":{"kind":"source_context","target_mention_ids":["c-shiji-130-taishigong:m050-0041"]},"evidence":[{"chapter_id":"c-shiji-038-song","paragraph_id":"c-shiji-038-song:p054","quote":"三十七年，楚惠王滅陳。熒惑守心。心，宋之分野也。景公憂之。司星子韋曰：「可移於相。」景公曰：「相，吾之股肱。」曰：「可移於民。」景公曰：「君者待民。」曰：「可移於歲。」景公曰：「歲饑民困，吾誰爲君！」子韋曰：「天髙聽卑。君有君人之言三，熒惑宜有動。」於是候之，果徙三度。"},{"chapter_id":"c-shiji-130-taishigong","paragraph_id":"c-shiji-130-taishigong:p050","quote":"嗟箕子乎！嗟箕子乎！正言不用，乃反為奴。武庚既死，周封微子。襄公傷於泓，君子孰稱。景公謙德，熒惑退行。剔成暴虐，宋乃滅亡。喜微子問太師，作宋世家第八。"}],"rationale":"宋景公謙德、熒惑退行，同一子韋星占事件。","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-072-guopu:p013","text":"往年歲末，太白蝕月，今在歲始，日有咎謫。會未數旬，大眚再見。日月告釁，見懼詩人，無曰天高，其鑒不遠。故宋景言善，熒惑退次；光武甯亂，呼沲結冰。此明天人之懸符，有若形影之相應。應之以德，則休祥臻；酬之以怠，則咎征作。陛下宜恭承靈譴，敬天之怒，施沛然之恩，諧玄同之化，上所以允塞天意，下所以弭息群謗。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":34,"last_line":34,"raw_start":2906,"raw_end":3054,"raw_character_offsets":[2906,2907,2908,2909,2910,2911,2912,2913,2914,2915,2916,2917,2918,2919,2920,2921,2922,2923,2924,2925,2926,2927,2928,2929,2930,2931,2932,2933,2934,2935,2936,2937,2938,2939,2940,2941,2942,2943,2944,2945,2946,2947,2948,2949,2950,2951,2952,2953,2954,2955,2956,2957,2958,2959,2960,2961,2962,2963,2964,2965,2966,2967,2968,2969,2970,2971,2972,2973,2974,2975,2976,2977,2978,2979,2980,2981,2982,2983,2984,2985,2986,2987,2988,2989,2990,2991,2992,2993,2994,2995,2996,2997,2998,2999,3000,3001,3002,3003,3004,3005,3006,3007,3008,3009,3010,3011,3012,3013,3014,3015,3016,3017,3018,3019,3020,3021,3022,3023,3024,3025,3026,3027,3028,3029,3030,3031,3032,3033,3034,3035,3036,3037,3038,3039,3040,3041,3042,3043,3044,3045,3046,3047,3048,3049,3050,3051,3052,3053],"revision_id":2595548},"mentions":[{"id":"c-jinshu-072-guopu:p013:m0051","surface":"宋景","start":51,"end":53,"person_id":"rex_cs0_mfo_AAAA","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-072-guopu:p013:m0061","surface":"光武","start":61,"end":63,"person_id":"vzz_va9_1nh","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-072-guopu","book_id":"b-jinshu-072","work_id":"w-jinshu","source_id":"s-jinshu-072-guopu-ws2595548"},{"id":"c-sanguozhi-061-lukai:line063-pei01-04","text":"臣闻宫功当起，夙夜反侧，是以频烦上事，往往留中，不见省报，於邑叹息，企想应罢。昨食时，被诏曰：『君所谏，诚是大趣，然未合鄙意，如何？此宫殿不利，宜当避之，乃可以妨劳役，长坐不利宫乎？父之不安，子亦何倚？』臣拜纸诏，伏读一周，不觉气结於胸，而涕泣雨集也。臣年已六十九，荣禄已重，於臣过望，复何所冀？所以勤勤数进苦言者，臣伏念大皇帝创基立业，劳苦勤至，白发生於鬓肤，黄耇被於甲胄。天下始静，晏驾早崩，自含息之类，能言之伦，无不歔欷，如丧考妣。幼主嗣统，柄在臣下，军有连征之费，民有彫残之损。贼臣干政，公家空竭。今强敌当涂，西州倾覆，孤罢之民，宜当畜养，广力肆业，以备有虞。且始徙都，属有军征，战士流离，州郡骚扰，而大功复起，徵召四方，斯非保国致治之渐也。臣闻为人主者，攘灾以德，除咎以义。故汤遭大旱，身祷桑林，荧惑守心，宋景退殿，是以旱魃销亡，妖星移舍。今宫室之不利，但当克己复礼，笃汤、宋之至道，愍黎庶之困苦，何忧宫之不安，灾之不销乎？陛下不务脩德，而务筑宫室，若德之不脩，行之不贵，虽殷辛之瑶台，秦皇之阿房，何止而不丧身覆国，宗庙作墟乎？夫兴土功，高台榭，既致水旱，民又多疾，其不疑也？为父长安，使子无倚，此乃子离於父，臣离於陛下之象也。臣子一离，虽念克骨，茅茨不翦，复何益焉？是以大皇帝居于南宫，自谓过於阿房。故先朝大臣，以为宫室宜厚，备卫非常，大皇帝曰：『逆虏游魂，当爱育百姓，何聊趣於不急？』然臣下恳恻，由不获已，故裁调近郡，苟副众心，比当就功，犹豫三年。当此之时，寇钞慑威，不犯我境，师徒奔北，且西阻岷、汉，南州无事，尚犹冲让，未肯筑宫，况陛下危恻之世，又乏大皇帝之德，可不虑哉？原陛下留意，臣不虚言。","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-061-lukai:line063-pei01-04:m0343","start":343,"end":344,"surface":"汤","kind":"person","person_id":"tpz_x3m_e0h","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line063-pei01-04:m0358","start":358,"end":360,"surface":"宋景","kind":"person","person_id":"rex_cs0_mfo_AAAA","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line063-pei01-04:m0442","start":442,"end":444,"surface":"殷辛","kind":"person","person_id":"lwx_9yq_ad7","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line063-pei01-04:m0448","start":448,"end":450,"surface":"秦皇","kind":"person","person_id":"ao3_0fy_d45_AAA","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"}],"annotation_status":"reviewed","source_position":{"first_line":63,"last_line":63,"revision_id":2085162,"raw_start":6496,"raw_end":7201,"character_positions":[6496,6497,6498,6499,6500,6501,6502,6503,6504,6505,6506,6507,6508,6509,6510,6511,6512,6513,6514,6515,6516,6517,6518,6519,6520,6521,6522,6523,6524,6525,6526,6527,6528,6529,6530,6531,6532,6533,6534,6535,6536,6537,6538,6539,6540,6541,6542,6543,6544,6545,6546,6547,6548,6549,6550,6551,6552,6553,6554,6555,6556,6557,6558,6559,6560,6561,6562,6563,6564,6565,6566,6567,6568,6569,6570,6571,6572,6573,6574,6575,6576,6577,6578,6579,6580,6581,6582,6583,6584,6585,6586,6587,6588,6589,6590,6591,6592,6593,6594,6595,6596,6597,6598,6599,6600,6601,6602,6603,6604,6605,6606,6607,6608,6609,6610,6611,6612,6613,6614,6615,6616,6617,6618,6619,6620,6621,6622,6623,6624,6625,6626,6627,6628,6629,6630,6631,6632,6633,6634,6635,6636,6637,6638,6639,6640,6641,6642,6643,6644,6645,6646,6647,6648,6649,6650,6651,6652,6653,6654,6655,6656,6657,6658,6659,6660,