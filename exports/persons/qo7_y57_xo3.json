ble_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"2處獨立位置，2個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu037-qiao-cheng-wuji-ws2630018"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"id":"name-jin037-qiao-huanjing","person_id":"qo7_y57_xo3","surname":"桓","ming":"景","additional_names":[],"chapter_id":"c-jinshu-037-qiao-cheng-wuji-ws2630018","paragraph_id":"c-jinshu-037-qiao-cheng-wuji-ws2630018:p004","person_mention_id":"c-jinshu-037-qiao-cheng-wuji-ws2630018:p004:m0059","source_anchor":{"paragraph_id":"c-jinshu-037-qiao-cheng-wuji-ws2630018:p004","start":59,"end":61,"surface":"桓景"},"quote":"烈王無忌字公壽，承之難，以年小獲免。咸和中，拜散騎侍郎，累遷屯騎校尉、中書、黃門侍郎。江州刺史褚裒當之鎮，無忌及丹陽尹桓景等餞於版橋。時王暠子丹陽丞耆之在坐，無忌志欲復仇，拔刀將手刃之，裒、景命左右救捍獲免。御史中丞車灌奏無忌欲專殺人，付廷尉科罪。成帝詔曰：「王敦作亂，閔王遇禍，尋事原情，今王何責。然公私憲制，亦巳有斷，王當以體國為大，豈可尋繹由來，以亂朝憲。主者其申明法令，自今已往，有犯必誅。」於是聽以贖論。","status":"editorial_provisional","human_reviewed":false,"model":null,"work_id":"w-jinshu","book_id":"b-jinshu-037","source_id":"s-jinshu037-qiao-cheng-wuji-ws2630018"}],"mentions":[{"id":"c-jinshu-037-qiao-cheng-wuji-ws2630018:p004:m0059","start":59,"end":61,"surface":"桓景","kind":"person","person_id":"qo7_y57_xo3","status":"contextual_provisional","source_identity_role":"huanjing","identity_reading_ref":"source-evidence/jin037-qiao-cheng-wuji/identity-decisions.json#huanj