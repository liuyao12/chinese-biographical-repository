在周，程伯休甫其後也。當周宣王時，失其守而為司馬氏。司馬氏世典周史。惠襄之閒，司馬氏去周適晉。晉中軍隨會奔秦，而司馬氏入少梁。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m001-0002","start":2,"end":4,"surface":"顓頊","kind":"person","person_id":"4iv_r1b_pij","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m001-0006","start":6,"end":9,"surface":"南正重","kind":"person","person_id":"jfx_k4u_hb1","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m001-0013","start":13,"end":16,"surface":"北正黎","kind":"person","person_id":"oiq_apr_p95","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m001-0042","start":42,"end":45,"surface":"重黎氏","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-130-taishigong:m001-0054","start":54,"end":58,"surface":"程伯休甫","kind":"person","person_id":"xgn_ado_9u1","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m001-0063","start":63,"end":66,"surface":"周宣王","kind":"person","person_id":"ijn_8su_yxp","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m001-0073","start":73,"end":76,"surface":"司馬氏","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-130-taishigong:m001-0077","start":77,"end":80,"surface":"司馬氏","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-130-taishigong:m001-0085","start":85,"end":87,"surface":"惠襄","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-130-taishigong:m001-0090","start":90,"end":93,"surface":"司馬氏","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-130-taishigong:m001-0101","start":101,"end":103,"surface":"隨會","kind":"person","person_id":"jar_u1c_pag","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m001-0107","start":107,"end":110,"surface":"司馬氏","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-130-taishigong","book_id":"b-shiji-130","work_id":"w-shiji","source_id":"s-shiji130-taishi