{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p005425","identity_policy":"contextual_provisional","person_ids":["cbr-p005425"],"persons":[{"id":"cbr-p005425","label":"漢宣帝（張丞相列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"孝宣帝","mention_ids":["c-shiji-096-zhang:m024-0023","c-shiji-096-zhang:m026-0055"]}],"evidence":[{"mention_id":"c-shiji-096-zhang:m024-0023","chapter_id":"c-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p024","quote":"孝宣帝"},{"mention_id":"c-shiji-096-zhang:m026-0055","chapter_id":"c-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p026","quote":"孝宣帝"}]}],"source_mention_summary":[{"source_id":"s-shiji-096-zhang","work_id":"w-shiji","book_id":"b-shiji-096","chapter_id":"c-shiji-096-zhang","mention_count":2,"mention_ids":["c-shiji-096-zhang:m024-0023","c-shiji-096-zhang:m026-0055"],"paragraph_ids":["c-shiji-096-zhang:p024","c-shiji-096-zhang:p026"],"passage_count":2}],"most_mentioned_source_ids":["s-shiji-096-zhang"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-096-zhang:m024-0023","start":23,"end":26,"surface":"孝宣帝","kind":"person","person_id":"cbr-p005425","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p024","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m026-0055","start":55,"end":58,"surface":"孝宣帝","kind":"person","person_id":"cbr-p005425","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p026","chapter_id":"c-shiji-096-zhang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji096-067","person_id":"cbr-p005425","scope":"same_chapter","chapter_ids":["c-shiji-096-zhang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["孝宣帝"],"evidence":[{"paragraph_id":"c-shiji-096-zhang:p024","quote":"邴丞相吉者，魯國人也。以讀書好法令至御史大夫。孝宣帝時，以有舊故，封為列侯，而因為丞相。明於事，有大智，後世稱之。以丞相病死。子顯嗣。後坐騎至廟，不敬，有詔奪爵一級，失列侯，得食故國邑。顯為吏至太仆，坐官秏亂，身及子男有姦贓，免為庶人。"},{"paragraph_id":"c-shiji-096-zhang:p026","quote":"黃丞相霸者，淮陽人也。以讀書為吏，至潁川太守。治潁川，以禮義條教喻告化之。犯法者，風曉令自殺。化大行，名聲聞。孝宣帝下制曰：「潁川太守霸，以宣布詔令治民，道不拾遺，男女異路，獄中無重囚。賜爵關內侯，黃金百斤。」徵為京兆尹而至丞相，復以禮義為治。以丞相病死。子嗣，後為列侯。黃丞相卒，以御史大夫于定國代。于丞相已有廷尉傳，在張廷尉語中。于丞相去，御史大夫韋玄成代。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定短稱；韋賢與韋玄成分傳區別，第23段掾陳平另候選，第25段長安相工田文不與孟嘗君合併。趙堯、任敖、申屠嘉、鄧通、晁錯的短名依各段人物語境，王陵夫人與王陵分人。張蒼父長不滿五尺的長為身長敘述，不作父名。王侯與太子未詳名不補名，跨篇同指另待證據。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-096-zhang:p024","text":"邴丞相吉者，魯國人也。以讀書好法令至御史大夫。孝宣帝時，以有舊故，封為列侯，而因為丞相。明於事，有大智，後世稱之。以丞相病死。子顯嗣。後坐騎至廟，不敬，有詔奪爵一級，失列侯，得食故國邑。顯為吏至太仆，坐官秏亂，身及子男有姦贓，免為庶人。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhang:m024-0000","start":0,"end":4,"surface":"邴丞相吉","kind":"person","person_id":"cbr-p005423","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m024-0023","start":23,"end":26,"surface":"孝宣帝","kind":"person","person_id":"cbr-p005425","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m024-0064","start":64,"end":65,"surface":"顯","kind":"person","person_id":"cbr-p005437","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m024-0093","start":93,"end":94,"surface":"顯","kind":"person","person_id":"cbr-p005437","status":"contextual_provisional"}],"chapter_id":"c-shiji-096-zhang","book_id":"b-shiji-096","work_id":"w-shiji","source_id":"s-shiji-096-zhang"},{"id":"c-shiji-096-zhang:p026","text":"黃丞相霸者，淮陽人也。以讀書為吏，至潁川太守。治潁川，以禮義條教喻告化之。犯法者，風曉令自殺。化大行，名聲聞。孝宣帝下制曰：「潁川太守霸，以宣布詔令治民，道不拾遺，男女異路，獄中無重囚。賜爵關內侯，黃金百斤。」徵為京兆尹而至丞相，復以禮義為治。以丞相病死。子嗣，後為列侯。黃丞相卒，以御史大夫于定國代。于丞相已有廷尉傳，在張廷尉語中。于丞相去，御史大夫韋玄成代。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhang:m026-0000","start":0,"end":4,"surface":"黃丞相霸","kind":"person","person_id":"cbr-p005420","status":"contextua