9,7980,7981,7982,7983,7984,7985,7986,7987,7988,7989,7990,7991,7992,7993,7994,7995,7996,7997,7998,7999,8000,8001,8002,8003,8004,8005,8006,8007,8008,8009,8010,8011,8012,8013,8014,8015,8016,8017,8018,8019,8020,8021,8022,8023,8024,8025,8026,8027,8028,8029,8030,8031,8032,8033,8034,8035,8036,8037,8038,8039,8040,8041,8042,8043,8044,8045,8046,8047,8048,8049,8050,8051,8052,8053,8054,8055,8056,8057,8058,8059,8060,8061,8062,8063,8064,8065,8066,8067,8068,8069,8070,8071,8072,8073,8074,8075,8076,8077,8078,8079,8080,8081,8082,8083,8084,8085,8086,8087,8088,8089,8090,8091,8092,8093,8094,8095,8096,8097,8098,8099,8100,8101,8102,8103,8104,8105,8106,8107,8108,8109],"projection_sha256":"fda398d5e882583e882ac1a9a1cf7b804688ee12743f59cf60c86e0c5579bbcb"},"chapter_id":"c-nanshi-011-hejingying","book_id":"b-nanshi-011","work_id":"w-nanshi","source_id":"s-nanshi-011-hejingying-ws2288359"},{"id":"c-nanshi-016-wangxuanmiao:p003","text":"延興元年，爲中護軍。明帝使玄邈往江州殺晉安王子懋，玄邈苦辭不行，及遣王廣之往廣陵取安陸王子敬，玄邈不得已奉旨。建武中，卒於護軍，贈雍州刺史，諡壯侯。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":143,"last_line":143,"raw_start":8814,"raw_end":8892,"raw_character_offsets":[8814,8815,8816,8817,8818,8819,8820,8821,8822,8823,8824,8825,8826,8827,8828,8829,8830,8831,8832,8833,8834,8835,8836,8837,8838,8839,8840,8841,8842,8843,8844,8845,8846,8847,8848,8849,8850,8851,8852,8853,8854,8855,8856,8857,8858,8859,8860,8861,8862,8863,8864,8865,8866,8867,8868,8869,8870,8871,8872,8873,8876,8879,8880,8881,8882,8883,8884,8885,8886,8887,8888,8889,8890,8891],"revision_id":1963381},"mentions":[{"id":"c-nanshi-016-wangxuanmiao:p003:m0013","start":13,"end":15,"surface":"玄邈","kind":"person","person_id":"hgq_k4y_crp","status":"contextual_provisional"},{"id":"c-nanshi-016-wangxuanmiao:p003:m0022","start":22,"end":24,"surface":"子懋","kind":"person","person_id":"ltu_nhs_gk6","status":"contextual_provisional"},{"id":"c-nanshi-016-wangxuanmiao:p003:m0025","start":25,"end":27,"surface":"玄邈","kind":"person","person_id":"hgq_k4y_crp","status":"contextual_provisional"},{"id":"c-nanshi-016-wangxuanmiao:p003:m0034","start":34,"end":37,"surface":"王廣之","kind":"person","person_id":"m4d_lon_pyg","status":"contextual_provisional"},{"id":"c-nanshi-016-wangxuanmiao:p003:m0044","start":44,"end":46,"surface":"子敬","kind":"person","person_id":"kix_r92_2ed_A","status":"contextual_provisional"},{"id":"c-nanshi-016-wangxuanmiao:p003:m0047","start":47,"end":49,"surface":"玄邈","kind":"person","person_id":"hgq_k4y_crp","status":"contextual_provisional"}],"chapter_id":"c-nanshi-016-wangxuanmiao","book_id":"b-nanshi-016","work_id":"w-nanshi","source_id":"s-nanshi-016-wangxuanmiao-ws1963381"},{"id":"c-songshu-088-fulingyue:p001","text":"時武衞將軍王廣之領軍隸劉勔，攻殷琰於壽陽，傅靈越奔逃，為廣之軍人所生禽，厲聲曰：「我傅靈越也。汝得賊何不即殺。」生送詣勔，勔躬自慰勞，詰其叛逆，對曰：「九州唱義，豈獨在我。」勔又問：「四方阻逆，無戰不禽，主上皆加以曠蕩，即其才用。卿何不早歸天闕，乃逃命草間乎？」靈越答曰：「薛公舉兵淮北，威震天下，不能專任智勇，委付子姪，致敗之由，實在於此。然事之始末，備皆參豫，人生歸於一死，實無面求活。」勔壯其意，送還京師。太宗欲加原宥，靈越辭對如一，終不回改，乃殺之。靈越，清河人也。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-songshu-088-fulingyue:p001:m0005","start":5,"end":8,"surface":"王廣之","kind":"person","person_id":"m4d_lon_pyg","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:m0011","start":11,"end":13,"surface":"劉勔","kind":"person","person_id":"e2r_5iw_ui0_A","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:m0015","start":15,"end":17,"surface":"殷琰","kind":"person","person_id":"mj8_5ic_4kk_A","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:m0021","start":21,"end":24,"surface":"傅靈越","kind":"person","person_id":"kfw_r30_lgz","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:m0028","start":28,"end":30,"surface":"廣之","kind":"person","person_id":"m4d_lon_pyg","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:u0030","start":30,"end":32,"surface":"軍人","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"王廣之部下，姓名、人數未詳。"},{"id":"c-songshu-088-fulingyue:p001:m0042","start":42,"end":45,"surface":"傅靈越","kind":"person","person_id":"kfw_r30_lgz","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:u0047","start":47,"end":48,"surface":"汝","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"靈越呼擒獲者；未能定位到具名者。"},{"id":"c-songshu-088-fulingyue:p001:m0059","start":59,"end":60,"surface":"勔","kind":"person","person_id":"e2r_5iw_ui0_A","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:m0061","start":61,"end":62,"surface":"勔","kind":"person","person_id":"e2r_5iw_ui0_A","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:m0087","start":87,"end":88,"surface":"勔","kind":"person","person_id":"e2r_5iw_ui0_A","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:u0111","start":111,"end":112,"surface":"其","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"劉勔泛指前句所說各方被俘者。"},{"id":"c-songshu-088-fulingyue:p001:m0131","start":131,"end":133,"surface":"靈越","kind":"person","person_id":"kfw_r30_lgz","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:u0158","start":158,"end":160,"surface":"子姪","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"靈越泛稱薛安都委任的子姪，未逐一指名，保留群體。"},{"id":"c-songshu-088-fulingyue:p001:m0196","start":196,"end":197,"surface":"勔","kind":"person","person_id":"e2r_5iw_ui0_A","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:m0213","start":213,"end":215,"surface":"靈越","kind":"person","person_id":"kfw_r30_lgz","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:m0229","start":229,"end":231,"surface":"靈越","kind":"person","person_id":"kfw_r30_lgz","identification_status":"contextual_provisional"}],"chapter_id":"c-songshu-088-ful