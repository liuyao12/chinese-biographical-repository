nshi-016-wangxuanmiao:p003:m0013","start":13,"end":15,"surface":"玄邈","kind":"person","person_id":"hgq_k4y_crp","status":"contextual_provisional"},{"id":"c-nanshi-016-wangxuanmiao:p003:m0022","start":22,"end":24,"surface":"子懋","kind":"person","person_id":"ltu_nhs_gk6","status":"contextual_provisional"},{"id":"c-nanshi-016-wangxuanmiao:p003:m0025","start":25,"end":27,"surface":"玄邈","kind":"person","person_id":"hgq_k4y_crp","status":"contextual_provisional"},{"id":"c-nanshi-016-wangxuanmiao:p003:m0034","start":34,"end":37,"surface":"王廣之","kind":"person","person_id":"m4d_lon_pyg","status":"contextual_provisional"},{"id":"c-nanshi-016-wangxuanmiao:p003:m0044","start":44,"end":46,"surface":"子敬","kind":"person","person_id":"kix_r92_2ed_A","status":"contextual_provisional"},{"id":"c-nanshi-016-wangxuanmiao:p003:m0047","start":47,"end":49,"surface":"玄邈","kind":"person","person_id":"hgq_k4y_crp","status":"contextual_provisional"}],"chapter_id":"c-nanshi-016-wangxuanmiao","book_id":"b-nanshi-016","work_id":"w-nanshi","source_id":"s-nanshi-016-wangxuanmiao-ws1963381"},{"id":"c-songshu-088-fulingyue:p001","text":"時武衞將軍王廣之領軍隸劉勔，攻殷琰於壽陽，傅靈越奔逃，為廣之軍人所生禽，厲聲曰：「我傅靈越也。汝得賊何不即殺。」生送詣勔，勔躬自慰勞，詰其叛逆，對曰：「九州唱義，豈獨在我。」勔又問：「四方阻逆，無戰不禽，主上皆加以曠蕩，即其才用。卿何不早歸天闕，乃逃命草間乎？」靈越答曰：「薛公舉兵淮北，威震天下，不能專任智勇，委付子姪，致敗之由，實在於此。然事之始末，備皆參豫，人生歸於一死，實無面求活。」勔壯其意，送還京師。太宗欲加原宥，靈越辭對如一，終不回改，乃殺之。靈越，清河人也。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-songshu-088-fulingyue:p001:m0005","start":5,"end":8,"surface":"王廣之","kind":"person","person_id":"m4d_lon_pyg","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:m0011","start":11,"end":13,"surface":"劉勔","kind":"person","person_id":"e2r_5iw_ui0_A","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:m0015","start":15,"end":17,"surface":"殷琰","kind":"person","person_id":"mj8_5ic_4kk_A","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:m0021","start":21,"end":24,"surface":"傅靈越","kind":"person","person_id":"kfw_r30_lgz","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:m0028","start":28,"end":30,"surface":"廣之","kind":"person","person_id":"m4d_lon_pyg","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:u0030","start":30,"end":32,"surface":"軍人","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"王廣之部下，姓名、人數未詳。"},{"id":"c-songshu-088-fulingyue:p001:m0042","start":42,"end":45,"surface":"傅靈越","kind":"person","person_id":"kfw_r30_lgz","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:u0047","start":47,"end":48,"surface":"汝","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"靈越呼擒獲者；未能定位到具名者。"},{"id":"c-songshu-088-fulingyue:p001:m0059","start":59,"end":60,"surface":"勔","kind":"person","person_id":"e2r_5iw_ui0_A","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:m0061","start":61,"end":62,"surface":"勔","kind":"person","person_id":"e2r_5iw_ui0_A","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:m0087","start":87,"end":88,"surface":"勔","kind":"person","person_id":"e2r_5iw_ui0_A","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:u0111","start":111,"end":112,"surface":"其","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"劉勔泛指前句所說各方被俘者。"},{"id":"c-songshu-088-fulingyue:p001:m0131","start":131,"end":133,"surface":"靈越","kind":"person","person_id":"kfw_r30_lgz","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:u0158","start":158,"end":160,"surface":"子姪","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"靈越泛稱薛安都委任的子姪，未逐一指名，保留群體。"},{"id":"c-songshu-088-fulingyue:p001:m0196","start":196,"end":197,"surface":"勔","kind":"person","person_id":"e2r_5iw_ui0_A","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:m0213","start":213,"end":215,"surface":"靈越","kind":"person","person_id":"kfw_r30_lgz","identification_status":"contextual_provisional"},{"id":"c-songshu-088-fulingyue:p001:m0229","start":229,"end":231,"surface":"靈越","kind":"person","person_id":"kfw_r30_lgz","identification_status":"contextual_provisional"}],"chapter_id":"c-songshu-088-fulingyue","book_id":"b-songshu-088","work_id":"w-songshu","source_id":"s-songshu-088-fulingyue-ws2069210"}],"sources":[{"chapter_id":"c-nanqishu-027-wangshi-concordance","work_id":"w-nanqishu","book_id":"b-nanqishu-027","source_id":"s-nanqishu-027-wangshi-concordance-ws1508012","source":{"title":"齊二十七其餘王氏具名選句","provider":"Wikisource","permalink":"https://zh.wikisource.org/w/index.php?oldid=1508012","url":"https://zh.wikisource.org/w/index.php?oldid=1508012","revision_id":1508012,"edition":"維基文庫固定修訂","accessed_on":"2026-11-21","review_status":"text_checked","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫授權。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","extent":"齊二十七其餘王氏具名選句","text_scope":"partial_chapter","raw_path":"sources/nanqishu/nanqi027-ws1508012.wikitext","raw_file_sha256":"babad7828a5a97654c1313db5b7a6eb5c19555d5639193051fd8694d9f8ecfcd"}},{"chapter_id":"c-nanqishu-027-wangxuanmiao","work_id":"w-nanqishu","book_id":"b-nanqishu-027","source_id":"s-nanqishu-027-wangxuanmiao-ws1508012","source":{"title":"王玄載傳弟玄邈","provider":"Wikisource","permalink":"https://zh.wikisource.org/w/index.php?oldid=1508012","url":"https://zh.wikisource.org/w/index.php?oldid=1508012","revision_id":1508012,"edition":"維基文庫固定修訂","accessed_on":"2026-11-21","review_status":"text_checked","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫授權。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","extent":"王玄載傳弟玄邈","text_scope":"complete_biography_unit","raw_path":"sources/nanqishu/nanqi027-ws1508012.wikitext","raw_file_sha256":"babad7828a5a97654c1313db5b7a6eb5c1