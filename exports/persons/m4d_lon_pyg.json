source_position":{"first_line":23,"last_line":23,"raw_start":1377,"raw_end":1388,"raw_character_offsets":[1377,1378,1379,1380,1381,1382,1383,1384,1385,1386,1387],"revision_id":1508012},"mentions":[{"id":"c-nanqishu-027-wangshi-concordance:p006:m0001","start":1,"end":4,"surface":"王廣之","kind":"person","person_id":"m4d_lon_pyg","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-027-wangshi-concordance","book_id":"b-nanqishu-027","work_id":"w-nanqishu","source_id":"s-nanqishu-027-wangshi-concordance-ws1508012"},{"id":"c-nanqishu-027-wangshi-concordance:p007","text":"懷珍又遣寧朔將軍明慶符與廣之擊降延僧，遣高麗使詣京師。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":23,"last_line":23,"raw_start":1414,"raw_end":1441,"raw_character_offsets":[1414,1415,1416,1417,1418,1419,1420,1421,1422,1423,1424,1425,1426,1427,1428,1429,1430,1431,1432,1433,1434,1435,1436,1437,1438,1439,1440],"revision_id":1508012},"mentions":[{"id":"c-nanqishu-027-wangshi-concordance:p007:m0000","start":0,"end":2,"surface":"懷珍","kind":"person","person_id":"w3a_mm0_hw1_*A","status":"contextual_provisional"},{"id":"c-nanqishu-027-wangshi-concordance:p007:m0008","start":8,"end":11,"surface":"明慶符","kind":"person","person_id":"9ye_u8v_u9b","status":"contextual_provisional"},{"id":"c-nanqishu-027-wangshi-concordance:p007:m0012","start":12,"end":14,"surface":"廣之","kind":"person","person_id":"m4d_lon_pyg","status":"contextual_provisional"},{"id":"c-nanqishu-027-wangshi-concordance:p007:m0016","start":16,"end":18,"surface":"延僧","kind":"person","person_id":"9wk_za0_43k","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-027-wangshi-concordance","book_id":"b-nanqishu-027","work_id":"w-nanqishu","source_id":"s-nanqishu-027-wangshi-concordance-ws1508012"},{"id":"c-nanqishu-027-wangxuanmiao:p006","text":"高宗使玄邈往江州殺晉安王子懋，玄邈苦辭不行，及遣王廣之往廣陵取安陸王子敬，玄邈不得已奉旨。給鼓吹置佐。建武元年，遷持節、都督南兖兖徐青冀五州軍事、平北將軍、南兖州刺史，轉護軍將軍，加散騎常侍。四年，卒，年七十二。贈安北將軍、雍州刺史。諡曰壯侯。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":102,"last_line":102,"raw_start":6856,"raw_end":6985,"raw_character_offsets":[6856,6857,6858,6859,6860,6861,6862,6863,6864,6865,6866,6867,6868,6869,6870,6871,6872,6873,6874,6875,6876,6877,6878,6879,6880,6881,6882,6883,6884,6885,6886,6887,6888,6889,6890,6891,6892,6893,6894,6895,6896,6897,6898,6899,6900,6901,6902,6903,6904,6905,6906,6912,6913,6914,6915,6918,6919,6920,6921,6922,6923,6924,6925,6926,6927,6928,6929,6930,6931,6932,6933,6934,6935,6936,6937,6938,6939,6940,6941,6942,6943,6944,6945,6946,6947,6948,6949,6950,6951,6952,6953,6954,6955,6956,6957,6958,6959,6960,6961,6962,6963,6964,6965,6966,6967,6968,6969,6970,6971,6972,6973,6974,6975,6976,6977,6978,6979,6980,6981,6982,6983,6984],"revision_id":1508012},"mentions":[{"id":"c-nanqishu-027-wangxuanmiao:p006:m0003","start":3,"end":5,"surface":"玄邈","kind":"person","person_id":"hgq_k4y_crp","status":"contextual_provisional"},{"id":"c-nanqishu-027-wangxuanmiao:p006:m0012","start":12,"end":14,"surface":"子懋","kind":"person","person_id":"ltu_nhs_gk6","status":"contextual_provisional"},{"id":"c-nanqishu-027-wangxuanmiao:p006:m0015","start":15,"end":17,"surface":"玄邈","kind":"person","person_id":"hgq_k4y_crp","status":"contextual_provisional"},{"id":"c-nanqishu-027-wangxuanmiao:p006:m0024","start":24,"end":27,"surface":"王廣之","kind":"person","person_id":"m4d_lon_pyg","status":"contextual_provisional"},{"id":"c-nanqishu-027-wangxuanmiao:p006:m0034","start":34,"end":36,"surface":"子敬","kind":"person","person_id":"kix_r92_2ed_A","status":"contextual_provisional"},{"id":"c-nanqishu-027-wangxuanmiao:p006:m0037","start":37,"end":39,"surface":"玄邈","kind":"person","person_id":"hgq_k4y_crp","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-027-wangxuanmiao","book_id":"b-nanqishu-027","work_id":"w-nanqishu","source_id":"s-nanqishu-027-wangxuanmiao-ws1508012"},{"id":"c-nanshi-011-hejingying-izumo:p003","text":"澄者本剡縣寒人嘗於南岸逼略人家女為秣陵縣所錄南郡王語縣散遣之澄又逼求姨女為妾姨不與澄詣建康令沈徽孚訟之徽孚曰姨女可為婦不可為妾澄曰僕父為給事中門戶既盛姨家猶是寒賤政可為妾耳徽孚訶而遣之十一年為皇太孫妃又有女巫子楊珉之亦有美貌妃尤愛之與同寢處如伉儷及太孫即帝位為皇后封后嫡母劉為高昌縣都鄉君所生母宋為餘杭廣昌鄉君后將拜鏡在牀無因墮地其冬與太后同日謁太廟楊珉之為帝所幸常居中侍明帝為輔與王晏徐孝嗣王廣之並面請不聽又令蕭諶坦之固請皇后與帝同席坐流涕覆面謂坦之曰楊郎好年少無罪過何可枉殺坦之耳語於帝曰此事別有一意不可令人聞帝謂皇后為阿奴曰阿奴蹔去坦之乃曰外間並云楊珉之與皇后有異情彰聞遐邇帝不得已乃為敕坦之馳報明帝即令建康行刑而果有赦原之而珉之已死","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-nanshi-011-hejingying-izumo:p003:m0000","start":0,"end":1,"surface":"澄","person_id":"cbe_2j4_a10","kind":"person","status":"contextual_provisional","interpretation_note":"依本段及兩書互見紀傳繫人。"},{"id":"c-nanshi-011-hejingying-izumo:p003:u0013","start":13,"end":16,"surface":"人家女","person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"此女子未名。"},{"id":"c-nanshi-011-hejingying-izumo:p003:m0022","start":22,"end":25,"surface":"南郡王","person_id":"iop_ybd_afm","kind":"person","status":"contextual_provisional","interpretation_note":"依本段及兩書互見紀傳繫人。"},{"id":"c-nanshi-011-hejingying-izumo:p003:u0034","start":34,"end":36,"surface":"姨女","person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"馬澄姨母之女。"},{"id":"c-nanshi-011-hejingying-izumo:p003:u0038","start":38,"end":39,"surface":"姨","person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"馬澄姨母。"},{"id":"c-nanshi-011-hejingying-izumo:p003:m0046","start":46,"end":49,"surface":"沈徽孚","person_id":"4cd_j3u_56v","kind":"person","status":"contextual_provisional","interpretation_note":"依本段及兩書互見紀傳繫人。"},{"id":"c-nanshi-011-hejingying-izumo:p003:u0066","start":66,"end":67,"surface":"父","person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"馬澄引父官為詞，未載姓名。"},{"id":"c-nanshi-011-hejingying-izumo:p003:m0102","start":102,"end":104,"surface":"女巫","person_id":"mj9_tz2_mtq","kind":"person","status":"contextual_provisional","interpretation_note":"依本段及兩書互見紀傳繫人。"},{"id":"c-nanshi-011-hejingying-izumo:p003:m0105","start":105,"end":108,"surface":"楊珉之","person_id":"ur2_4yl_xwz","kind":"person","status":"contextual_provisional","interpretation_no