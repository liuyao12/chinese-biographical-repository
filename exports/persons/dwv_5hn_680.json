:["c-shiji-092-hanxin:p020"],"table_cell_ids":[],"passage_count":1},{"source_id":"s-shiji-101-yuanchao","work_id":"w-shiji","book_id":"b-shiji-101","chapter_id":"c-shiji-101-yuanchao","mention_count":1,"mention_ids":["c-shiji-101-yuanchao:m005-0182"],"paragraph_ids":["c-shiji-101-yuanchao:p005"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-070-zhang"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-070-zhang:m034-0213","start":213,"end":215,"surface":"孟賁","kind":"person","person_id":"dwv_5hn_680","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p034","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-070-zhang:m034-0236","start":236,"end":238,"surface":"孟賁","kind":"person","person_id":"dwv_5hn_680","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p034","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-079-fancai:m013-0367","start":367,"end":369,"surface":"孟賁","kind":"person","person_id":"dwv_5hn_680","status":"contextual_provisional","paragraph_id":"c-shiji-079-fancai:p013","chapter_id":"c-shiji-079-fancai"},{"id":"c-shiji-092-hanxin:m020-0169","start":169,"end":171,"surface":"孟賁","kind":"person","person_id":"dwv_5hn_680","status":"contextual_provisional","paragraph_id":"c-shiji-092-hanxin:p020","chapter_id":"c-shiji-092-hanxin"},{"id":"c-shiji-101-yuanchao:m005-0182","start":182,"end":183,"surface":"賁","kind":"person","person_id":"dwv_5hn_680","status":"contextual_provisional","note":"原合稱賁育依孟康注拆為兩人；舊起點ID保留於賁，育另有逐人錨點，原文不改。","paragraph_id":"c-shiji-101-yuanchao:p005","chapter_id":"c-shiji-101-yuanchao"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji070-028","person_id":"dwv_5hn_680","scope":"same_chapter","chapter_ids":["c-shiji-070-zhang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"依第24至45段明示名字與遊說受話範圍暫接。韓王趙王及趙先王不按年代記憶補名；蘇秦謀齊的燕王齊王另存候選，不強與其他王同指或斷為異人。孟賁烏獲是比擬人物，不作在場者；紂為引古。擬議秦楚太子質子與秦女婚姻保留未解。","surfaces":["孟賁"],"evidence":[{"paragraph_id":"c-shiji-070-zhang:p034","quote":"張儀去楚，因遂之韓，說韓王曰：「韓地險惡山居，五穀所生，非菽而麥，民之食大抵飯菽飯藿羹。一歲不收，民不饜糟糠。地不過九百里，無二歲之食。料大王之卒，悉之不過三十萬，而廝徒負養在其中矣。除守徼亭鄣塞，見卒不過二十萬而已矣。秦帶甲百餘萬，車千乘，騎萬匹，虎賁之士跿跔科頭貫頤奮戟者，至不可勝計。秦馬之良，戎兵之眾，探前趹後蹄閒三尋騰者，不可勝數。山東之士被甲蒙胄以會戰，秦人捐甲徒裼以趨敵，左挈人頭，右挾生虜。夫秦卒與山東之卒，猶孟賁之與怯夫；以重力相壓，猶烏獲之與嬰兒。夫戰孟賁、烏獲之士以攻不服之弱國，無異垂千鈞之重於鳥卵之上，必無幸矣。"}]},{"id":"d-shiji079-025","person_id":"dwv_5hn_680","surfaces":["孟賁"],"scope":"same_chapter","chapter_ids":["c-shiji-079-fancai"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-079-fancai:p013","quote":"秦王屏左右，宮中虛無人。秦王跽而請曰：「先生何以幸教寡人？」范睢曰：「唯唯。」有閒，秦王復跽而請曰：「先生何以幸教寡人？」范睢曰：「唯唯。」若是者三。秦王跽曰：「先生卒不幸教寡人邪？」范睢曰：「非敢然也。臣聞昔者呂尚之遇文王也，身為漁父而釣於渭濱耳。若是者，交疏也。已說而立為太師，載與俱歸者，其言深也。故文王遂收功於呂尚而卒王天下。鄉使文王疏呂尚而不與深言，是周無天子之德，而文武無與成其王業也。今臣羈旅之臣也，交疏於王，而所願陳者皆匡君之事，處人骨肉之閒，願效愚忠而未知王之心也。此所以王三問而不敢對者也。臣非有畏而不敢言也。臣知今日言之於前而明日伏誅於後，然臣不敢避也。大王信行臣之言，死不足以為臣患，亡不足以為臣憂，漆身為厲被髪為狂不足以為臣恥。且以五帝之聖焉而死，三王之仁焉而死，五伯之賢焉而死，烏獲、任鄙之力焉而死，成荊、孟賁、王慶忌、夏育之勇焉而死。死者，人之所必不免也。處必然之勢，可以少有補於秦，此臣之所大願也，臣又何患哉！伍子胥橐載而出昭關，夜行晝伏，至於陵水，無以糊其口，厀行蒲伏，稽首肉袒，鼓腹吹篪，乞食於吳市，卒興吳國，闔閭為伯。使臣得盡謀如伍子胥，加之以幽囚，終身不復見，是臣之說行也，臣又何憂？箕子、接輿漆身為厲，被髪為狂，無益於主。假使臣得同行於箕子，可以有補於所賢之主，是臣之大榮也，臣有何恥？臣之所恐者，獨恐臣死之後，天下見臣之盡忠而身死，因以是杜口裹足，莫肯鄉秦耳。足下上畏太后之嚴，下惑於姦臣之態，居深宮之中，不離阿保之手，終身迷惑，無與昭姦。大者宗廟滅覆，小者身以孤危，此臣之所恐耳。若夫窮辱之事，死亡之患，臣不敢畏也。臣死而秦治，是臣死賢於生。」秦王跽曰：「先生是何言也！夫秦國辟遠，寡人愚不肖，先生乃幸辱至於此，是天以寡人慁先生而存先王之宗廟也。寡人得受命於先生，是天所以幸先王，而不棄其孤也。先生柰何而言若是！事無小大，上及太后，下至大臣，願先生悉以教寡人，無疑寡人也。」范睢拜，秦王亦拜。"}],"rationale":"按全35段明示姓名與局部引語暫接，范睢張祿范叔范君應侯分說話範圍；蔡澤先生綱成君依具體敘事。越王事大夫種與句踐敘事相配，更新候選標籤保留ID。馬服／馬服子依同段長平角色暫接未補姓名，第32段白公已按四子敘事及集解釋名暫接白起，韓子未強接韓非，喬松不補神仙，范中行族稱不接范睢。王之弟、改讀前止足及引古異說各留，預言與擬議方案不當史實核定。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji092-040","person_id":"dwv_5hn_680","scope":"same_chapter","chapter_ids":["c-shiji-092-hanxin"],"status":"contextual_provisional","rationale":"按明示姓名及局部事件承接；王號限敘事主體，酈食其酈生及蒯通蒯生暫接，未名者與引古人物各存。不補邯欣翳及周召等短稱完整姓名。","reviewer":"Codex（AI 代理）","surfaces":["孟賁"],"evidence":[{"paragraph_id":"c-shiji-092-hanxin:p020","quote":"後數日，蒯通復說曰：『夫聽者事之候也，計者事之機也，聽過計失而能久安者，鮮矣。聽不失一二者，不可亂以言；計不失本末者，不可紛以辭。夫隨廝養之役者，失萬乘之權；守儋石之祿者，闕卿相之位。故知者決之斷也，疑者事之害也，審豪氂之小計，遺天下之大數，智誠知之，決弗敢行者，百事之禍也。故曰「猛虎之猶豫，不若蜂蠆之致螫；騏驥之跼躅，不如駑馬之安步；孟賁之狐疑，不如庸夫之必至也；雖有舜禹之智，吟而不言，不如瘖聾之指麾也」。此言貴能行之。夫功者難成而易敗，時者難得而易失也。時乎時，不再來。願足下詳察之。』韓信猶豫不忍倍漢，又自以爲功多，漢終不奪我齊，遂謝蒯通。蒯通說不聽，已詳狂爲巫。"}]},{"id":"d-shiji101-benyu-mengben","person_id":"dwv_5hn_680","surfaces":["賁"],"scope":"same_chapter","chapter_ids":["c-shiji-101-yuanchao"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-101-yuanchao","source_id":"s-shiji-101-yuanchao","paragraph_id":"c-shiji-101-yuanchao:p005","quote":"淮南王至雍，病死，聞，上輟食，哭甚哀。盎入，頓首請罪。上曰：「以不用公言至此。」盎曰：「上自寬，此往事，豈可悔哉！且陛下有高世之行者三，此不足以毀名。」上曰：「吾高世行三者何事？」盎曰：「陛下居代時，太后嘗病，三年，陛下不交睫，不解衣，湯藥非陛下口所嘗弗進。夫曾參以布衣猶難之，今陛下親以王者修之，過曾參孝遠矣。夫諸呂用事，大臣專制，然陛下從代乘六傳馳不測之淵，雖賁育之勇不及陛下。陛下至代邸，西向讓天子位者再，南面讓天子位者三。夫許由一讓，而陛下五以天下讓，過許由四矣。且陛下遷淮南王，欲以苦其志，使改過，有司衛不謹，故病死。」於是上乃解，曰：「將柰何？」盎曰：「淮南王有三子，唯在陛下耳。」於是文帝立其三子皆為王。盎由此名重朝廷。","mention_ids":["c-shiji-101-yuanchao:m005-0182"]}],"rationale":"賁育為古勇士的合稱，依孟康注分解，並與其他篇勇士用稱比對；此處不是當時在場人物，不補生卒或爵位。","references":[{"url":"https://zh.wikisource.org/w/index.php?title=史記三家註/卷101&oldid=2514771","revision_id":2514771,"revision_timestamp":"2025-01-06T08:31:19Z","response_sha256":"cf92eb44d816d41d69d847483ebf6120d660b015b116ae244d5e9e8dd6ce2fe0","image_verified":false,"verification_scope":"specified_digital_commentary_passages_only","title":"《史記集解》賁育注","commentator":"孟康","quote":"孟賁、夏育，皆古勇者也。","scope":"explicit_commentary_decomposition","note":"一個合稱分為兩名古勇士，各字各連人物；未核書影。"}],"reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"equivalence_decisions":[{"id":"eq-shiji092-review-mengben","person_ids":["dwv_5hn_680"],"canonical_person_id":"dwv_5hn_680","scope":"cross_chapter","chapter_ids":["c-shiji-092-hanxin","c-shiji-070-zhang"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-092-hanxin","source_id":"s-shiji-092-hanxin","paragraph_id":"c-shiji-092-hanxin:p020","quote":"後數日，蒯通復說曰：『夫聽者事之候也，計者事之機也，聽過計失而能久安者，鮮矣。聽不失一二者，不可亂以言；計不失本末者，不可紛以辭。夫隨廝養之役者，失萬乘之權；守儋石之祿者，闕卿相之位。故知者決之斷也，疑者事之害也，審豪氂之小計，遺天下之大數，智誠知之，決弗敢行者，百事之禍也。故曰「猛虎之猶豫，不若蜂蠆之致螫；騏驥之跼躅，不如駑馬之安步；孟賁之狐疑，不如庸夫之必至也；雖有舜禹之智，吟而不言，不如瘖聾之指麾也」。此言貴能行之。夫功者難成而易敗，時者難得而易失也。時乎時，不再來。願足下詳察之。』韓信猶豫不忍倍漢，又自以爲功多，漢終不奪我齊，遂謝蒯通。蒯通說不聽，已詳狂爲巫。","mention_ids":["c-shiji-092-hanxin:m020-0169"]},{"chapter_id":"c-shiji-070-zhang","source_id":"s-shiji-070-zhang","paragraph_id":"c-shiji-070-zhang:p034","quote":"張儀去楚，因遂之韓，說韓王曰：「韓地險惡山居，五穀所生，非菽而麥，民之食大抵飯菽飯藿羹。一歲不收，民不饜糟糠。地不過九百里，無二歲之食。料大王之卒，悉之不過三十萬，而廝徒負養在其中矣。除守徼亭鄣塞，見卒不過二十萬而已矣。秦帶甲百餘萬，車千乘，騎萬匹，虎賁之士跿跔科頭貫頤奮戟者，至不可勝計。秦馬之良，戎兵之眾，探前趹後蹄閒三尋騰者，不可勝數。山東之士被甲蒙胄以會戰，秦人捐甲徒裼以趨敵，左挈人頭，右挾生虜。夫秦卒與山東之卒，猶孟賁之與怯夫；以重力相壓，猶烏獲之與嬰兒。夫戰孟賁、烏獲之士以攻不服之弱國，無異垂千鈞之重於鳥卵之上，必無幸矣。","mention_ids":["c-shiji-070-zhang:m034-0213","c-shiji-070-zhang:m034-0236"]}],"rationale":"孟賁之勇力與怯夫對舉的特定典故配置；比同事件弱，不據此接孟說、不推年代。 只接合本處身份，原字、傳說性與敘述分存，不推親屬、年代或任期，不設省稱全域別名；同書不同篇不當獨立見證，未核書影。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true},{"id":"eq-shiji101-core-015","person_ids":["dwv_5hn_680"],"canonical_person_id":"dwv_5hn_680","scope":"cross_chapter","chapter_ids":["c-shiji-070-zhang","c-shiji-079-fancai","c-shiji-092-hanxin","c-shiji-101-yuanchao"],"status":"contextual_provisional","evidence":[{"work_id":"w-shiji","book_id":"b-shiji-070","chapter_id":"c-shiji-070-zhang","source_id":"s-shiji-070-zhang","paragraph_id":"c-shiji-070-zhang:p034","quote":"張儀去楚，因遂之韓，說韓王曰：「韓地險惡山居，五穀所生，非菽而麥，民之食大抵飯菽飯藿羹。一歲不收，民不饜糟糠。地不過九百里，無二歲之食。料大王之卒，悉之不過三十萬，而廝徒負養在其中矣。除守徼亭鄣塞，見卒不過二十萬而已矣。秦帶甲百餘萬，車千乘，騎萬匹，虎賁之士跿跔科頭貫頤奮戟者，至不可勝計。秦馬之良，戎兵之眾，探前趹後蹄閒三尋騰者，不可勝數。山東之士被甲蒙胄以會戰，秦人捐甲徒裼以趨敵，左挈人頭，右挾生虜。夫秦卒與山東之卒，猶孟賁之與怯夫；以重力相壓，猶烏獲之與嬰兒。夫戰孟賁、烏獲之士以攻不服之弱國，無異垂千鈞之重於鳥卵之上，必無幸矣。","mention_ids":["c-shiji-070-zhang:m034-0213","c-shiji-070-zhang:m034-0236"]},{"work_id":"w-shiji","book_id":"b-shiji-079","chapter_id":"c-shiji-079-fancai","source_id":"s-shiji-079-fancai","paragraph_id":"c-shiji-079-fancai:p013","quote":"秦王屏左右，宮中虛無人。秦王跽而請曰：「先生何以幸教寡人？」范睢曰：「唯唯。」有閒，秦王復跽而請曰：「先生何以幸教寡人？」范睢曰：「唯唯。」若是者三。秦王跽曰：「先生卒不幸教寡人邪？」范睢曰：「非敢然也。臣聞昔者呂尚之遇文王也，身為漁父而釣於渭濱耳。若是者，交疏也。已說而立為太師，載與俱歸者，其言深也。故文王遂收功於呂尚而卒王天下。鄉使文王疏呂尚而不與深言，是周無天子之德，而文武無與成其王業也。今臣羈旅之臣也，交疏於王，而所願陳者皆匡君之事，處人骨肉之閒，願效愚忠而未知王之心也。此所以王三問而不敢對者也。臣非有畏而不敢言也。臣知今日言之於前而明日伏誅於後，然臣不敢避也。大王信行臣之言，死不足以為臣患，亡不足以為臣憂，漆身為厲被髪為狂不足以為臣恥。且以五帝之聖焉而死，三王之仁焉而死，五伯之賢焉而死，烏獲、任鄙之力焉而死，成荊、孟賁、王慶忌、夏育之勇焉而死。死者，人之所必不免也。處必然之勢，可以少有補於秦，此臣之所大願也，臣又何患哉！伍子胥橐載而出昭關，夜行晝伏，至於陵水，無以糊其口，厀行蒲伏，稽首肉袒，鼓腹吹篪，乞食於吳市，卒興吳國，闔閭為伯。使臣得盡謀如伍子胥，加之以幽囚，終身不復見，是臣之說行也，臣又何憂？箕子、接輿漆身為厲，被髪為狂，無益於主。假使臣得同行於箕子，可以有補於所賢之主，是臣之大榮也，臣有何恥？臣之所恐者，獨恐臣死之後，天下見臣之盡忠而身死，因以是杜口裹足，莫肯鄉秦耳。足下上畏太后之嚴，下惑於姦臣之態，居深宮之中，不離阿保之手，終身迷惑，無與昭姦。大者宗廟滅覆，小者身以孤危，此臣之所恐耳。若夫窮辱之事，死亡之患，臣不敢畏也。臣死而秦治，是臣死賢於生。」秦王跽曰：「先生是何言也！夫秦國辟遠，寡人愚不肖，先生乃幸辱至於此，是天以寡人慁先生而存先王之宗廟也。寡人得受命於先生，是天所以幸先王，而不棄其孤也。先生柰何而言若是！事無小大，上及太后，下至大臣，願先生悉以教寡人，無疑寡人也。」范睢拜，秦王亦拜。","mention_ids":["c-shiji-079-fancai:m013-0367"]},{"work_id":"w-shiji","book_id":"b-shiji-092","chapter_id":"c-shiji-092-hanxin","source_id":"s-shiji-092-hanxin","paragraph_id":"c-shiji-092-hanxin:p020","quote":"後數日，蒯通復說曰：『夫聽者事之候也，計者事之機也，聽過計失而能久安者，鮮矣。聽不失一二者，不可亂以言；計不失本末者，不可紛以辭。夫隨廝養之役者，失萬乘之權；守儋石之祿者，闕卿相之位。故知者決之斷也，疑者事之害也，審豪氂之小計，遺天下之大數，智誠知之，決弗敢行者，百事之禍也。故曰「猛虎之猶豫，不若蜂蠆之致螫；騏驥之跼躅，不如駑馬之安步；孟賁之狐疑，不如庸夫之必至也；雖有舜禹之智，吟而不言，不如瘖聾之指麾也」。此言貴能行之。夫功者難成而易敗，時者難得而易失也。時乎時，不再來。願足下詳察之。』韓信猶豫不忍倍漢，又自以爲功多，漢終不奪我齊，遂謝蒯通。蒯通說不聽，已詳狂爲巫。","mention_ids":["c-shiji-092-hanxin:m020-0169"]},{"work_id":"w-shiji","book_id":"b-shiji-101","chapter_id":"c-shiji-101-yuanchao","source_id":"s-shiji-101-yuanchao","paragraph_id":"c-shiji-101-yuanchao:p005","quote":"淮南王至雍，病死，聞，上輟食，哭甚哀。盎入，頓首請罪。上曰：「以不用公言至此。」盎曰：「上自寬，此往事，豈可悔哉！且陛下有高世之行者三，此不足以毀名。」上曰：「吾高世行三者何事？」盎曰：「陛下居代時，太后嘗病，三年，陛下不交睫，不解衣，湯藥非陛下口所嘗弗進。夫曾參以布衣猶難之，今陛下親以王者修之，過曾參孝遠矣。夫諸呂用事，大臣專制，然陛下從代乘六傳馳不測之淵，雖賁育之勇不及陛下。陛下至代邸，西向讓天子位者再，南面讓天子位者三。夫許由一讓，而陛下五以天下讓，過許由四矣。且陛下遷淮南王，欲以苦其志，使改過，有司衛不謹，故病死。」於是上乃解，曰：「將柰何？」盎曰：「淮南王有三子，唯在陛下耳。」於是文帝立其三子皆為王。盎由此名重朝廷。","mention_ids":["c-shiji-101-yuanchao:m005-0182"]}],"rationale":"各篇以孟賁為古勇士的對比或典故；101賁育依孟康注分為孟賁、夏育，079同列孟賁與夏育之勇。暫接同一古勇士，不據典故補確知生卒、國籍或秦武王力士孟說身份。 限所列事件、親屬或稱謂語境；原文異字與各來源引句保留，同書互見不當獨立證據票數，未核書影。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true,"references":[{"url":"https://zh.wikisource.org/w/index.php?title=史記三家註/卷101&oldid=2514771","revision_id":2514771,"revision_timestamp":"2025-01-06T08:31:19Z","response_sha256":"cf92eb44d816d41d69d847483ebf6120d660b015b116ae244d5e9e8dd6ce2fe0","image_verified":false,"verification_scope":"specified_digital_commentary_passages_only","title":"《史記集解》賁育注","commentator":"孟康","quote":"孟賁、夏育，皆古勇者也。","scope":"explicit_commentary_decomposition","note":"一個合稱分為兩名古勇士，各字各連人物；未核書影。"}]}],"passages":[{"id":"c-shiji-070-zhang:p034","text":"張儀去楚，因遂之韓，說韓王曰：「韓地險惡山居，五穀所生，非菽而麥，民之食大抵飯菽飯藿羹。一歲不收，民不饜糟糠。地不過九百里，無二歲之食。料大王之卒，悉之不過三十萬，而廝徒負養在其中矣。除守徼亭鄣塞，見卒不過二十萬而已矣。秦帶甲百餘萬，車千乘，騎萬匹，虎賁之士跿跔科頭貫頤奮戟者，至不可勝計。秦馬之良，戎兵之眾，探前趹後蹄閒三尋騰者，不可勝數。山東之士被甲蒙胄以會戰，秦人捐甲徒裼以趨敵，左挈人頭，右挾生虜。夫秦卒與山東之卒，猶孟賁之與怯夫；以重力相壓，猶烏獲之與嬰兒。夫戰孟賁、烏獲之士以攻不服之弱國，無異垂千鈞之重於鳥卵之上，必無幸矣。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-070-zhang:m034-0000","start":0,"end":2,"surface":"張儀","kind":"person","person_id":"uq6_74z_vtv","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m034-0011","start":11,"end":13,"surface":"韓王","kind":"person","person_id":"5mj_zds_atm","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m034-0069","start":69,"end":71,"surface":"大王","kind":"person","person_id":"5mj_zds_atm","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m034-0083","start":83,"end":87,"surface":"廝徒負養","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或擬議質子婚姻，未證已實行，姓名與身分