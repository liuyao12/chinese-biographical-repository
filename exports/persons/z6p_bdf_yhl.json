mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-w067-jian-qian-mother","subject_person_id":"762_5c8_663","object_person_id":"z6p_bdf_yhl","predicate":"mother","qualifiers":{"source_term":"錢鳳母年八十"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-067","chapter_id":"c-jinshu-067-xijian","source_id":"s-jinshu-067-xijian","paragraph_id":"c-jinshu-067-xijian:line078","quote":"及鳳等平，溫嶠上議，請宥敦佐吏，鑒以為先王崇君臣之教，故貴伏死之節；昏亡之主，故開待放之門。王敦佐吏雖多逼迫，然居逆亂之朝，無出關之操，準之前訓，宜加義責。又奏錢鳳母年八十，宜蒙全宥。乃從之。封高平侯，賜絹四千八百匹。帝以其有器望，萬機動靜輒問之，乃詔鑒特草上表疏，以從簡易。王導議欲贈周札官，鑒以為不合，語在札傳。導不從。鑒於是駮之曰：「敦之逆謀，履霜日久，緣札開門，令王師不振。若敦前者之舉，義同桓文，則先帝可為幽厲邪？」朝臣雖無以難，而不能從。俄而遷車騎將軍、都督徐兗青三州軍事、兗州刺史、假節，鎮廣陵。尋而帝崩，鑒與王導、卞壼、溫嶠、庾亮、陸曄等並受遺詔，輔少主，進位車騎大將軍、開府儀同三司，加散騎常侍。","subject_person_mention_id":"c-jinshu-067-xijian:line078:m0001","object_person_mention_id":"c-jinshu-067-xijian:line078:m0080"}],"interpretation_note":"此條按本句所明言。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"age_assertions":[{"id":"age-w067-jian-qianmother","person_id":"z6p_bdf_yhl","source_number":"八十","source_term":"年八十","value":80,"unit":"source_age_years","counting":"unspecified_source_age","birth_year":null,"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-067","chapter_id":"c-jinshu-067-xijian","source_id":"s-jinshu-067-xijian","paragraph_id":"c-jinshu-067-xijian:line078","quote":"及鳳等平，溫嶠上議，請宥敦佐吏，鑒以為先王崇君臣之教，故貴伏死之節；昏亡之主，故開待放之門。王敦佐吏雖多逼迫，然居逆亂之朝，無出關之操，準之前訓，宜加義責。又奏錢鳳