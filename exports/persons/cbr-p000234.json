surface":"齊桓公","kind":"person","person_id":"cbr-p000235","status":"source_identified"}],"chapter_id":"c-shiji-004-zhou","book_id":"b-shiji-004","work_id":"w-shiji","source_id":"s-shiji-004-zhou"},{"id":"c-shiji-039-jin:p020","text":"晉侯二十八年，齊桓公始霸。曲沃武公伐晉侯緡，滅之，盡以其寶器賂獻于周釐王。釐王命曲沃武公爲晉君，列爲諸侯，於是盡併晉地而有之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m020-0000","start":0,"end":2,"surface":"晉侯","kind":"person","person_id":"cbr-p001708","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m020-0007","start":7,"end":10,"surface":"齊桓公","kind":"person","person_id":"cbr-p000235","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m020-0013","start":13,"end":17,"surface":"曲沃武公","kind":"person","person_id":"cbr-p001704","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m020-0018","start":18,"end":21,"surface":"晉侯緡","kind":"person","person_id":"cbr-p001708","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m020-0033","start":33,"end":36,"surface":"周釐王","kind":"person","person_id":"cbr-p000234","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m020-0037","start":37,"end":39,"surface":"釐王","kind":"person","person_id":"cbr-p000234","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m020-0040","start":40,"end":44,"surface":"曲沃武公","kind":"person","person_id":"cbr-p001704","status":"contextual_provisional"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"}],"sources":[{"chapter_id":"c-shiji-004-zhou","work_id":"w-shiji","book_id":"b-shiji-004","source_id":"s-shiji-004-zhou","source":{"title":"史記／卷004","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷004","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷004&oldid=7909147","revision_id":7909147,"accessed_on":"2026-10-09","extent":"正文全文；排除註釋版導覽、現代節標題與註號；行內校勘標記另存。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫 CC BY-SA 4.0，保留署名及固定版本。","license_url":"http