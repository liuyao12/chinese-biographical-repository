r-p000230","status":"source_identified"},{"id":"c-shiji-004-zhou:m048-0009","start":9,"end":13,"surface":"釐王胡齊","kind":"person","person_id":"cbr-p000234","status":"source_identified"},{"id":"c-shiji-004-zhou:m048-0015","start":15,"end":17,"surface":"釐王","kind":"person","person_id":"cbr-p000234","status":"source_identified"},{"id":"c-shiji-004-zhou:m048-0020","start":20,"end":23,"surface":"齊桓公","kind":"person","person_id":"cbr-p000235","status":"source_identified"}],"chapter_id":"c-shiji-004-zhou","book_id":"b-shiji-004","work_id":"w-shiji","source_id":"s-shiji-004-zhou"},{"id":"c-shiji-004-zhou:p049","text":"五年，釐王崩，子惠王閬立。惠王二年。初，莊王嬖姬姚，生子穨，穨有寵。及惠王即位，奪其大臣以為囿，故大夫邊伯等五人作亂，謀召燕、衛師，伐惠王。惠王犇溫，已居鄭之櫟。立釐王弟穨為王。樂及徧舞，鄭、虢君怒。四年，鄭與虢君伐殺王穨，復入惠王。惠王十年，賜齊桓公為伯。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-004-zhou:m049-0003","start":3,"end":5,"surface":"釐王","kind":"person","person_id":"cbr-p000234","status":"source_identified"},{"id":"c-shiji-004-zhou:m049-0008","start":8,"end":11,"surface":"惠王閬","kind":"person","person_id":"cbr-p000236","status":"source_identified"},{"id":"c-shiji-004-zhou:m049-0013","start":13,"end":15,"surface":"惠王","kind":"person","person_id":"cbr-p000236","status":"source_identified"},{"id":"c-shiji-004-zhou:m049-0020","start":20,"end":22,"surface":"莊王","kind":"person","person_id":"cbr-p000230","status":"source_identified"},{"id":"c-shiji-004-zhou:m049-0023","start":23,"end":25,"surface":"姬姚","kind":"person","person_id":"cbr-p000237","status":"source_identified"},{"id":"c-shiji-004-zhou:m049-0027","start":27,"end":29,"surface":"子穨","kind":"person","person_id":"cbr-p000238","status":"source_identified"},{"id":"c-shiji-004-zhou:m049-0030","start":30,"end":31,"surface":"穨","kind":"person","person_id":"cbr-p000238","status":"source_identified"},{"id":"c-shiji-004-zhou:m049-0035","start":35,"end":37,"surface":"惠王","kind":"person","person_id":"cbr-p000236","status":"source_identified"},{"id":"c-shiji-004-zhou:m049-0051","start":51,"end":53,"surf