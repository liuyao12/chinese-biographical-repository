:[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji067-073","person_id":"7ff_u3q_0hy","scope":"same_chapter","chapter_ids":["c-shiji-067-disciples"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["子遲","樊遲","樊須"],"evidence":[{"paragraph_id":"c-shiji-067-disciples:p094","quote":"樊須字子遲。少孔子三十六歳。"},{"paragraph_id":"c-shiji-067-disciples:p095","quote":"樊遲請學稼，孔子曰：「吾不如老農。」請學圃，曰：「吾不如老圃。」樊遲出，孔子曰：「小人哉樊須也！上好禮，則民莫敢不敬；上好義，則民莫敢不服；上好信，則民莫敢不用情。夫如是，則四方之民襁負其子而至矣，焉用稼！」"},{"paragraph_id":"c-shiji-067-disciples:p096","quote":"樊遲問仁，子曰：「愛人。」問智，曰：「知人。」"}],"rationale":"依篇內明示姓名字稱及局部問答暫接。吳越王稱按夫差句踐連續敘事；第71段夫子指原憲，第90段指代未定。傳易短何分田子莊何與楊何，傳授不當父子；引古人物保留傳說性。冉季字子產不接鄭子產，原憲子思不接孔子後世子思；名錄各條同字子徒、子聲、子上、皙等均保留不同候選，鄭國是此條人名。魯昭公夫人孟子不接戰國孟子。全152段明示姓名首輪已存，未名者、代詞、版本及跨篇身份待覆核。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-067-disciples:p094","text":"樊須字子遲。少孔子三十六歳。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-067-disciples:m094-0000","start":0,"end":2,"surface":"樊須","kind":"person","person_id":"7ff_u3q_0hy","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m094-0003","start":3,"end":5,"surface":"子遲","kind":"person","person_id":"7ff_u3q_0hy","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m094-0007","start":7,"end":9,"surface":"孔子","kind":"person","person_id":"0xl_7ir_tmn","status":"contextual_provisional"}],"chapter_id":"c-shiji-067-disciples","book_id":"b-shiji-067","work_id":"w-shiji","source_id":"s-shiji-067-disciples"},{"id":"c-shiji-067-disciples:p095","text":"樊遲請學稼，孔子曰：「吾不如老農。」請學圃，曰：「吾不如老圃。」樊遲出，孔子曰：「小人哉樊須也！上好禮，則民莫敢不敬；上好義，則民莫敢不服；上好信，則民莫敢不用情。夫如是，則四方之民襁負其子而至矣，焉用稼！」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-067-disciples:m095-0000","start":0,"end":2,"surface":"樊遲","kind":"person","person_id":"7ff_u3q_0hy","status":"context