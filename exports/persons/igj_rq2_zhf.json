"c-liangshu-033-wangsengru:p005:m0040","surface":"道愍","start":40,"end":42,"person_id":"igj_rq2_zhf","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-liangshu-033-wangsengru:p005","chapter_id":"c-liangshu-033-wangsengru"},{"id":"c-nanshi-059-wangsengru:p005:m0120","surface":"湯道湣","start":120,"end":123,"person_id":"igj_rq2_zhf","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-nanshi-059-wangsengru:p005","chapter_id":"c-nanshi-059-wangsengru"}],"relations":[],"title_holdings":[{"id":"th-liang033-wangsengru-m5-19","person_id":"igj_rq2_zhf","title":"典簽","kind":"office","mode":"attestation","attestations":[{"id":"th-liang033-wangsengru-m5-19:a","person_mention_id":"c-liangshu-033-wangsengru:p005:m0021","usage":"narrative","date_expression":null,"paragraph_id":"c-liangshu-033-wangsengru:p005","surface":"典簽","start":19,"end":21}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-033","source_id":"s-liangshu-033-wangsengru-ws1514481","chapter_id":"c-liangshu-033-wangsengru","paragraph_id":"c-liangshu-033-wangsengru:p005","quote":"出爲仁威南康王長史，行府、州、國事。王典簽湯道愍暱於王，用事府內，僧孺每裁抑之，道愍遂謗訟僧孺，逮詣南司。奉箋辭府曰：「下官不能避溺山隅，而正冠李下，旣貽疵辱，方致徽繩，解籙收簪，且歸初服。竊以董生偉器，止相驕王；賈子上才，爰傅卑土。下官生年有值，謬仰清塵，假翼西雍，竊步東閣，多慚袨服，取亂長裾，高榻相望，直居坐右，長階如畫，獨在僚端。借其從容之詞，假以寬和之色，恩禮遠過申、白，榮望多厠應、徐。厚德難逢，小人易說。方謂離腸隕首，不足以報一言；露膽披誠，何能以酬屢顧。寧謂罻羅裁舉，微禽先落；閶闔始吹，細草仍墜。一辭九畹，方去五雲。縱天網是漏，聖恩可恃，亦復孰寄心骸，何施眉目。方當橫潭亂海，就魚鱉而爲羣；披榛捫樹，從虺蛇而相伍。豈復仰聽金聲，式瞻玉色。顧步高軒，悲如霰委；踟躕下席，淚若綆縻。」","person_mention_id":"c-liangshu-033-wangsengru:p005:m0021"}],"status":"source_attested","interpretation_note":"按本見證原職名及其所屬人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"th-nanshi059-wangsengru-m5-118","person_id":"igj_rq2_zhf","title":"典簽","kind":"office","mode":"attestation","attestations":[{"id":"th-nanshi059-wangsengru-m5-118:a","person_mention_id":"c-nanshi-059-wangsengru:p005:m0120","usage":"narrative","date_expression":null,"paragraph_id":"c-nanshi-059-wangsengru:p005","surface":"典簽","start":118,"end":120}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-059","source_id":"s-nanshi-059-wangsengru-ws1553912","chapter_id":"c-nanshi-059-wangsengru","paragraph_id":"c-nanshi-059-wangsengru:p005","quote":"時武帝制春景明志詩五百字，敕沈約以下辭人同作，帝以僧孺為工。曆少府卿，尚書吏部郎，參大選，請謁不行。出為仁威南康王長史、蘭陵太守，行府、州、國事。初，帝問僧孺妾媵之數，對曰：「臣室無傾視。」及在南徐州，友人以妾寓之，行還，妾遂懷孕。為王典簽湯道湣所糾，逮詣南司，坐免官，久之不調。友人廬江何炯猶為王府記室，僧孺乃與炯書以見其意。後為安成王參軍事，鎮右中記室參軍。","person_mention_id":"c-nanshi-059-wangsengru:p005:m0120"}],"status":"source_attested","interpretation_note":"按本見證原職名及其所屬人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-033-wangsengru:p005","text":"出爲仁威南康王長史，行府、州、國事。王典簽湯道愍暱於王，用事府內，僧孺每裁抑之，道愍遂謗訟僧孺，逮詣南司。奉箋辭府曰：「下官不能避溺山隅，而正冠李下，旣貽疵辱，方致徽繩，解籙收簪，且歸初服。竊以董生偉器，止相驕王；賈子上才，爰傅卑土。下官生年有值，謬仰清塵，假翼西雍，竊步東閣，多慚袨服，取亂長裾，高榻相望，直居坐右，長階如畫，獨在僚端。借其從容之詞，假以寬和之色，恩禮遠過申、白，榮望多厠應、徐。厚德難逢，小人易說。方謂離腸隕首，不足以報一言；露膽披誠，何能以酬屢顧。寧謂罻羅裁舉，微禽先落；閶闔始吹，細草仍墜。一辭九畹，方去五雲。縱天網是漏，聖恩可恃，亦復孰寄心骸，何施眉目。方當橫潭亂海，就魚鱉而爲羣；披榛捫樹，從虺蛇而相伍。豈復仰聽金聲，式瞻玉色。顧步高軒，悲如霰委；踟躕下席，淚若綆縻。」","mentions":[{"id":"c-liangshu-033-wangsengru:p005:m0021","surface":"湯道愍","start":21,"end":24,"person_id":"igj_rq2_zhf","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-liangshu-033-wangsengru:p005:m0033","surface":"僧孺","start":33,"end":35,"person_id":"59d_72d_924_AAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-liangshu-033-wangsengru:p005:m0040","surface":"道愍","start":40,"end":4