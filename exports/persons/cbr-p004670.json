ou:m007-0614","start":614,"end":616,"surface":"將軍","kind":"person","person_id":"cbr-p004662","status":"contextual_provisional"}],"chapter_id":"c-shiji-083-luzou","book_id":"b-shiji-083","work_id":"w-shiji","source_id":"s-shiji-083-luzou"},{"id":"c-shiji-083-luzou:p023","text":"是以聖王制世御俗，獨化於陶鈞之上，而不牽於卑亂之語，不奪於眾多之口。故秦皇帝任中庶子蒙嘉之言，以信荊軻之說，而匕首竊發；周文王獵涇、渭，載呂尚而歸，以王天下。故秦信左右而殺，周用烏集而王。何則？以其能越攣拘之語，馳域外之議，獨觀於昭曠之道也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-083-luzou:m023-0002","start":2,"end":4,"surface":"聖王","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代保留，不補姓名。"},{"id":"c-shiji-083-luzou:m023-0035","start":35,"end":38,"surface":"秦皇帝","kind":"person","person_id":"cbr-p004740","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m023-0042","start":42,"end":44,"surface":"蒙嘉","kind":"person","person_id":"cbr-p004741","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m023-0049","start":49,"end":51,"surface":"荊軻","kind":"person","person_id":"cbr-p004695","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m023-0060","start":60,"end":63,"surface":"周文王","kind":"person","person_id":"cbr-p004670","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m023-0069","start":69,"end":71,"surface":"呂尚","kind":"person","person_id":"cbr-p004742","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m023-0082","start":82,"end":84,"surface":"左右","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代保留，不補姓名。"}],"chapter_id":"c-shiji-083-luzou","book_id":"b-shiji-083","work_id":"w-shiji","source_id":"s-shiji-083-luzou"}],"sources":[{"chapter_id":"c-shiji-083-luzou","work_id":"w-shiji","book_id":"b-shiji-083","source_id":"s-shiji-083-luzou","source":{"title":"史記／卷083","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷083","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷083&oldid=2089252","revision_id":2089252,"accessed_on":"2026-1