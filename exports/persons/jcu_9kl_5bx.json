_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-117-xiangru:m052-0085","start":85,"end":87,"surface":"北僑","kind":"person","person_id":"jcu_9kl_5bx","status":"contextual_provisional","interpretation_note":"《集解》引徐廣釋為燕人、形解而仙者，故建立來源限定的傳說人物記錄。本文「北僑」原字保留；《漢書》平行文作「伯僑」，顏師古釋為姓征名伯僑，與本篇「征北僑」是否同人及如何句讀均未定，不合併字形或補姓名。","paragraph_id":"c-shiji-117-xiangru:p052","chapter_id":"c-shiji-117-xiangru"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji117-daren-beiqiao","person_id":"jcu_9kl_5bx","surfaces":["北僑"],"scope":"same_chapter","chapter_ids":["c-shiji-117-xiangru"],"status":"contextual_provisional","confidence_level":"medium","identification_basis":{"kind":"ancient_commentary_explicitly_identifies_person","target_mention_ids":["c-shiji-117-xiangru:m052-0085"],"historical_event_attendance_not_inferred":true},"evidence":[{"chapter_id":"c-shiji-117-xiangru","source_id":"s-shiji117-xiangru","paragraph_id":"c-shiji-117-xiangru:p052","quote":"邪絕少陽而登太陰兮，與真人乎相求。互折窈窕以右轉兮，橫厲飛泉以正東。悉徵靈圉而選之兮，部乘眾神於瑤光。使五帝先導兮，反太一而從陵陽。左玄冥而右含靁兮，前陸離而後潏湟。厮征北僑而役羡門兮，屬岐伯使尚方。祝融驚而蹕御兮，清氛氣而後行。屯余車其萬乘兮，綷雲蓋而樹華旗。使勾芒其將行兮，吾欲往乎南嬉。","mention_ids":["c-shiji-117-xiangru:m052-0085"]}],"references":[{"title":"《史記集解》卷117·徐廣釋北僑","url":"https://github.com/kanripo/KR2a0002/blob/73c4d2ba067d99a6de924ac952fd6921a958c7e7/KR2a0002_117.txt#L524-L525","quote":"斯征北僑(徐廣曰燕人也形解而僊也)","source_commit":"73c4d2ba067d99a6de924ac952fd6921a958c7e7","source_blob":"ccded97eee2542083010172d857d6251a09a126c","scope":"徐廣注將北僑解為燕人、解形成仙者；此注足以支持北僑為傳說人物稱名。","image_verified":false},{"title":"《漢書》卷57下·顏師古釋征伯僑","url":"https://github.com/kanripo/KR2a0007/blob/683113d4baf6febecaf2ccb7913df87c4d68d454/KR2a0007_057.txt#L937-L939","quote":"《漢書》作「厮征伯僑」；顏師古釋「征伯僑者仙人，姓征名伯僑」，並辨其非王子僑。","source_commit":"683113d4baf6febecaf2ccb7913df87c4d68d454","source_blob":"44cd0a168123204ab8369c8382018dbaaa846a86","scope":"平行文本及注釋；不據此回改《史記》「北僑」，亦不將兩名自動合併。","image_verified":false}],"rationale":"《集解》引徐廣釋為燕人、形解而仙者，故建立來源限定的傳說人物記錄。本文「北僑」原字保留；《漢書》平行文作「伯僑」，顏師古釋為姓征名伯僑，與本篇「征北僑」是否同人及如何句讀均未定，不合併字形或補姓名。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-117-xiangru:p052","text":"邪絕少陽而登太陰兮，與真人乎相求。互折窈窕以右轉兮，橫厲飛泉以正東。悉徵靈圉而選之兮，部乘眾神於瑤光。使五帝先導兮，反太一而從陵陽。左玄冥而右含靁兮，前陸離而後潏湟。厮征北僑而役羡門兮，屬岐伯使尚方。祝融驚而蹕御兮，清氛氣而後行。屯余車其萬乘兮，綷雲蓋而樹華旗。使勾芒其將行兮，吾欲往乎南嬉。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m052-0036","start":36,"end":38,"surface":"靈圉","kind":"person","person_id":"9g4_bbq_zvr","status":"contextual_provisional","interpretation_note":"本篇《大人賦》第16、52、58段三見「靈圉」，郭璞兩注均稱仙人名，暫接為同一傳說人物。「靈圉淳圉」未標點；淳圉是否異文、異名或並列名未定，不登記為確定別名。僅核數位文字，未核書影。"},{"id":"c-shiji-117-xiangru:m052-0052","start":52,"end":54,"surface":"五帝","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"本句神帝群稱，不指定五個世系人物；五畤與古注轉報五時分存。"},{"id":"c-shiji-117-xiangru:m052-0059","start":59,"end":61,"surface":"太一","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m052-0063","start":63,"end":65,"surface":"陵陽","kind":"person","person_id":"i4v_y28_wx0","status":"contextual_provisional","interpretation_note":"古注明稱仙人陵陽子明，與陽子古注所述陽陵子不能倒字合併。"},{"id":"c-shiji-117-xiangru:m052-0067","start":67,"end":69,"surface":"玄冥","kind":"person","person_id":"dal_xne_xt3","status":"contextual_provisional","interpretation_note":"古注稱北方黑帝之佐，只記神話身份，不補官爵任期或與其他祖系相接。"},{"id":"c-shiji-117-xiangru:m052-0071","start":71,"end":73,"surface":"含靁","kind":"person","person_id":"21k_m7f_sxc","status":"contextual_provisional","interpretation_note":"本篇含靁依所引注為黔嬴，造化神與水神兩說分存；不改原字，不將外部用字冒作本文別名。"},{"id":"c-shiji-117-xiangru:m052-0076","start":76,"end":78,"surface":"陸離","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"本篇陸離與漢書長離的神名／靈鳥解釋分存，未改字或強接個人。"},{"id":"c-shiji-117-xiangru:m052-0080","start":80,"end":82,"surface":"潏湟","kind":"person","person_id":"oj8_zfy_dkl","status":"contextual_provisional","interpretation_note":"本篇潏湟依注為神名；漢書矞皇用字另存，不先作跨見證別名定論。"},{"id":"c-shiji-117-xiangru:m052-0085","start":85,"end":87,"surface":"北僑","kind":"person","person_id":"jcu_9kl_5bx","status":"contextual_provisional","interpretation_note":"《集解》引徐廣釋為燕人、形解而仙者，故建立來源限定的傳說人物記錄。本文「北僑」原字保留；《漢書》平行文作「伯僑」，顏師古釋為姓征名伯僑，與本篇「征北僑」是否同人及如何句讀均未定，不合併字形或補姓名。"},{"id":"c-shiji-117-xiangru:m052-0089","start":89,"end":91,"surface":"羡門","kind":"person","person_id":"44s_fyq_t0d","status":"contextual_provisional","interpretation_note":"張揖釋碣石仙人羡門高，與始皇本紀碣石求羨門的名號及地域互證；保留羡／羨原字，不把高誓併成同名，也不補仙人生卒或任期。"},{"id":"c-shiji-117-xiangru:m052-0094","start":94,"end":96,"surface":"岐伯","kind":"person","person_id":"l4l_iz8_ao0","status":"contextual_provisional","interpretation_note":"本篇岐伯主方藥，張揖明釋黃帝太醫；孝武本紀公玉帶亦引黃帝時岐伯，暫接同一傳說人物，不據賦辭增造官職或出行事件。"},{"id":"c-shiji-117-xiangru:m052-0100","start":100,"end":102,"surface":"祝融","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m052-0132","start":132,"end":134,"surface":"勾芒","kind":"person","person_id":"hd8_aho_qei","status":"contextual_provisional","interpretation_note":"本篇勾芒與漢書句芒各存，古注稱東方青帝之佐；不按造形補生平或親屬。"}],"chapter_id":"c-shiji-117-xiangru","book_id":"b-shiji-117","work_id":"w-shiji","source_id":"s-shiji117-xiangru"}],"sources":[{"chapter_id":"c-shiji-117-xiangru","work_id":"w-shiji","book_id":"b-shiji-117","source_id":"s-shiji117-xiangru","source":{"title":"史記／卷117","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷117","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷117&oldid=10371549","revision_id":10371549,"accessed_on":"2026-10-11","extent":"固定修訂全文71段，包括賦、書與末段索隱述贊。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],