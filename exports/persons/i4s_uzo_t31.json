{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"i4s_uzo_t31","canonical_person_id":"i4s_uzo_t31","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["i4s_uzo_t31"],"persons":[{"id":"i4s_uzo_t31","label":"淳維（匈奴列傳祖源傳說候選）","status":"active","historicity":"legendary_tradition","aliases":[{"surface":"淳維","mention_ids":["c-shiji-110-xiongnu:m001-0015","c-shiji-110-xiongnu:m008-0001"]}],"evidence":[{"mention_id":"c-shiji-110-xiongnu:m001-0015","chapter_id":"c-shiji-110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p001","quote":"淳維"},{"mention_id":"c-shiji-110-xiongnu:m008-0001","chapter_id":"c-shiji-110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p008","quote":"淳維"}]}],"source_mention_summary":[{"source_id":"s-shiji110-xiongnu","work_id":"w-shiji","book_id":"b-shiji-110","chapter_id":"c-shiji-110-xiongnu","mention_count":2,"mention_ids":["c-shiji-110-xiongnu:m001-0015","c-shiji-110-xiongnu:m008-0001"],"paragraph_ids":["c-shiji-110-xiongnu:p001","c-shiji-110-xiongnu:p008"],"passage_count":2}],"most_mentioned_source_ids":["s-shiji110-xiongnu"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-110-xiongnu:m001-0015","start":15,"end":17,"surface":"淳維","kind":"person","person_id":"i4s_uzo_t31","status":"contextual_provisional","paragraph_id":"c-shiji-110-xiongnu:p001","chapter_id":"c-shiji-110-xiongnu"},{"id":"c-shiji-110-xiongnu:m008-0001","start":1,"end":3,"surface":"淳維","kind":"person","person_id":"i4s_uzo_t31","status":"contextual_provisional","paragraph_id":"c-shiji-110-xiongnu:p008","chapter_id":"c-shiji-110-xiongnu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-110-xiongnu:p001","text":"匈奴，其先祖夏后氏之苗裔也，曰淳維。唐虞以上有山戎、獫狁、葷粥，居于北蠻，隨畜牧而轉移。其畜之所多則馬、牛、羊，其奇畜則橐駞、驢、驘、駃騠、騊駼、騨騱。逐水草遷徙，毋城郭常處耕田之業，然亦各有分地。毋文書，以言語爲約束。兒能騎羊，引弓射鳥鼠；少長則射狐兔：用爲食。士力能毋弓，盡爲甲騎。其俗，寬則隨畜，因射獵禽獸爲生業，急則人習戰攻以侵伐，其天性也。其長兵則弓矢，短兵則刀鋋。利則進，不利則退，不羞遁走。茍利所在，不知禮義。自君王以下，咸食畜肉，衣其皮革，被旃裘。壯者食肥美，老者食其餘。貴壯健，賤老弱。父死，妻其後母；兄弟死，皆取其妻妻之。其俗有名不諱，而無姓字。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-110-xiongnu:m001-0015","start":15,"end":17,"surface":"淳維","kind":"person","person_id":"i4s_uzo_t31","status":"contextual_provisional"}],"chapter_id":"c-shiji-110-xiongnu","book_id":"b-shiji-110","work_id":"w-shiji","source_id":"s-shiji110-xiongnu"},{"id":"c-shiji-110-xiongnu:p008","text":"自淳維以至頭曼千有餘歳，時大時小，別散分離，尚矣，其世傳不可得而次云。然至冒頓而匈奴最彊大，盡服從北夷，而南與中國爲敵國，其世傳國官號乃可得而記云。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-110-xiongnu:m008-0001","start":1,"end":3,"surface":"淳維","kind":"person","person_id":"i4s_uzo_t31","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m008-0005","start":5,"end":7,"surface":"頭曼","kind":"person","person_id":"wjt_htu_081","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m008-0037","start":37,"end":39,"surface":"冒頓","kind":"person","person_id":"wop_txs_2xf","status":"contextual_provisional"}],"chapter_id":"c-shiji-110-xiongnu","book_id":"b-shiji-110","work_id":"w-shiji","source_id":"s-shiji110-xiongnu"}],"sources":[{"chapter_id":"c-shiji-110-xiongnu","work_id":"w-shiji","book_id":"b-shiji-110","source_id":"s-shiji110-xiongnu","source":{"title":"史記／卷110","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷110","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷110&oldid=8735645","revision_id":8735645,"accessed_on":"2026-10-11","extent":"固定數位見證去介面及現代節標題後61段，末段為太史公論。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"去 header2 介面及現代單于節標題、太史公曰節標題；移除單字語言轉換包裹與下劃線標籤，紀年 YL 模板保留顯示原詞。其餘原字、標點及段落次序保留，不從小標題補正文人名。","note":"未核底本影像。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical"}}
