贈。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[{"older_person_id":"x18_cng_88g_A","younger_person_id":"x18_cng_88g_B","operator":"lt","scope":"siblings","older_ordinal":null,"younger_ordinal":null,"assertion_id":"a-w044-zhengqiu-younger","person_id":"x18_cng_88g_B","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-044","chapter_id":"c-jinshu-044-zhengqiu","source_id":"s-jinshu-044-zhengqiu","paragraph_id":"c-jinshu-044-zhengqiu:line033","quote":"球字子瑜。少辟宰府，入侍二宮。成都王為大將軍，起義討趙王倫，球自頓丘太守為右長史，以功封平壽公。累遷侍中、尚書、散騎常侍、中護軍、尚書右僕射，領吏部。永嘉二年卒，追贈金紫光祿大夫，諡曰元。球弟豫，永嘉末為尚書。","subject_person_mention_id":"c-jinshu-044-zhengqiu:line033:m0096","object_person_mention_id":"c-jinshu-044-zhengqiu:line033:m0000"}]}],"preferred_birth_order_constraints":[{"older_person_id":"x18_cng_88g_A","younger_person_id":"x18_cng_88g_B","operator":"lt","scope":"siblings","older_ordinal":null,"younger_ordinal":null,"assertion_id":"a-w044-zhengqiu-younger","person_id":"x18_cng_88g_B","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-044","chapter_id":"c-jinshu-044-zhengqiu","source_id":"s-jinshu-044-zhengqiu","paragraph_id":"c-jinshu-044-zhengqiu:line033","quote":"球字子瑜。少辟宰府，入侍二宮。成都王為大將軍，起義討趙王倫，球自頓丘太守為右長史，以功封平壽公。累遷侍中、尚書、散騎常侍、中護軍、尚書右僕射，領吏部。永嘉二年卒，追贈金紫光祿大夫，諡曰元。球弟豫，永嘉末為尚書。","subject_person_mention_id":"c-jinshu-044-zhengqiu:line033:m0096","object_person_mention_id":"c-jinshu-044-zhengqiu:line033:m0000"}]}],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-044-zhengmo:line030","text":"太康元年卒，時年六十八，諡曰成。尚書令衛瓘奏：「默才行名望，宜居論道，五升九卿，位未稱德，宜贈三司。」而後父楊駿先欲以女妻默子豫，默曰：「吾每讀《雋不疑傳》，常想其人。畏遠權貴，奕世所守。」遂辭之。駿深為恨。至此，駿議不同，遂不施行。默寬沖博愛，謙虛溫謹，不以才地矜物，事上以禮，遇下以和，雖僮豎廝養不加聲色，而猶有嫌怨，故士君子以為居世之難。子球。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-044-zhengmo:line030:m0019","start":19,"end":21,"surface":"衛瓘","kind":"person","person_id":"67b_