constraints":[],"identity_decisions":[{"id":"d-shiji008-089","person_id":"cbr-p000816","surfaces":["良醫","醫"],"scope":"same_chapter","chapter_ids":["c-shiji-008-gaozu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-008-gaozu:p084","quote":"高祖擊布時，為流矢所中，行道病。病甚，呂后迎良醫，醫入見，高祖問醫，醫曰：「病可治。」於是高祖嫚罵之曰：「吾以布衣提三尺劍取天下，此非天命乎？命乃在天，雖扁鵲何益！」遂不使治病，賜金五十斤罷之。已而呂后問：「陛下百歲後，蕭相國即死，令誰代之？」上曰：「曹參可。」問其次，上曰：「王陵可。然陵少憨，陳平可以助之。陳平智有餘，然難以獨任。周勃重厚少文，然安劉氏者必勃也，可令為太尉。」呂后復問其次，上曰：「此後亦非而所知也。」"}],"rationale":"僅在所列漢初戰事、分封與家族敘事內暫定同指；前卷對讀須依相接事件，不據同名全域合併，仍待異源覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-008-gaozu:p084","text":"高祖擊布時，為流矢所中，行道病。病甚，呂后迎良醫，醫入見，高祖問醫，醫曰：「病可治。」於是高祖嫚罵之曰：「吾以布衣提三尺劍取天下，此非天命乎？命乃在天，雖扁鵲何益！」遂不使治病，賜金五十斤罷之。已而呂后問：「陛下百歲後，蕭相國即死，令誰代之？」上曰：「曹參可。」問其次，上曰：「王陵可。然陵少憨，陳平可以助之。陳平智有餘，然難以獨任。周勃重厚少文，然安劉氏者必勃也，可令為太尉。」呂后復問其次，上曰：「此後亦非而所知也。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m084-0000","start":0,"end":2,"surface":"高祖","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m084-0003","start":3,"end":4,"surface":"布","kind":"person","person_id":"cbr-p000656","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m084-0019","start":19,"end":21,"surface":"呂后","kind":"person","person_id":"cbr-p000717","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m084-0022","start":22,"end":24,"surface":"良醫","kind":"person","person_id":"cbr-p000816","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m084-0025","start":25,"end":26,"surface":"醫","kind":"person","person_id":"cbr-p000816","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m084-0029","start":29,"end":31,"surface":"高祖","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m084-0032","start":32,"end":33,"surface":"醫","kind":"person","person_id":"cbr-p000816","status":"contextual_provisional"},{"id":"c-shiji-00