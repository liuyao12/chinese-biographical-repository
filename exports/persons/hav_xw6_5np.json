{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"hav_xw6_5np","canonical_person_id":"hav_xw6_5np","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["hav_xw6_5np"],"persons":[{"id":"hav_xw6_5np","label":"陳勝（南越列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"陳勝","mention_ids":["c-shiji-113-nanyue:m001-0088","c-shiji-113-nanyue:m001-0110"]}],"evidence":[{"mention_id":"c-shiji-113-nanyue:m001-0088","chapter_id":"c-shiji-113-nanyue","paragraph_id":"c-shiji-113-nanyue:p001","quote":"陳勝"},{"mention_id":"c-shiji-113-nanyue:m001-0110","chapter_id":"c-shiji-113-nanyue","paragraph_id":"c-shiji-113-nanyue:p001","quote":"陳勝"}]}],"source_mention_summary":[{"source_id":"s-shiji113-nanyue","work_id":"w-shiji","book_id":"b-shiji-113","chapter_id":"c-shiji-113-nanyue","mention_count":2,"mention_ids":["c-shiji-113-nanyue:m001-0088","c-shiji-113-nanyue:m001-0110"],"paragraph_ids":["c-shiji-113-nanyue:p001"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji113-nanyue"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-113-nanyue:m001-0088","start":88,"end":90,"surface":"陳勝","kind":"person","person_id":"hav_xw6_5np","status":"contextual_provisional","paragraph_id":"c-shiji-113-nanyue:p001","chapter_id":"c-shiji-113-nanyue"},{"id":"c-shiji-113-nanyue:m001-0110","start":110,"end":112,"surface":"陳勝","kind":"person","person_id":"hav_xw6_5np","status":"contextual_provisional","paragraph_id":"c-shiji-113-nanyue:p001","chapter_id":"c-shiji-113-nanyue"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-113-nanyue:p001","text":"南越王尉佗者，真定人也，姓趙氏。秦時已并天下，略定楊越，置桂林、南海、象郡，以謫徙民，與越雜處十三歲。佗，秦時用為南海龍川令。至二世時，南海尉任囂病且死，召龍川令趙佗語曰：「聞陳勝等作亂，秦為無道，天下苦之，項羽、劉季、陳勝、吳廣等州郡各共興軍聚眾，虎爭天下，中國擾亂，未知所安，豪傑畔秦相立。南海僻遠，吾恐盜兵侵地至此，吾欲興兵絕新道，自備，待諸侯變，會病甚。且番禺負山險，阻南海，東西數千里，頗有中國人相輔，此亦一州之主也，可以立國。郡中長吏無足與言者，故召公告之。」即被佗書，行南海尉事。囂死，佗即移檄告橫浦、陽山、湟谿關曰：「盜兵且至，急絕道聚兵自守！」因稍以法誅秦所置長吏，以其黨為假守。秦已破滅，佗即擊并桂林、象郡，自立為南越武王。高帝已定天下，為中國勞苦，故釋佗弗誅。漢十一年，遣陸賈因立佗為南越王，與剖符通使，和集百越，毋為南邊患害，與長沙接境。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-113-nanyue:m001-0003","start":3,"end":5,"surface":"尉佗","kind":"person","person_id":"bvb_d1z_fd0","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m001-0051","start":51,"end":52,"surface":"佗","kind":"person","person_id":"bvb_d1z_fd0","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m001-0064","start":64,"end":66,"surface":"二世","kind":"person","person_id":"ntz_hml_tl6","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m001-0071","start":71,"end":73,"surface":"任囂","kind":"person","person_id":"e8q_4ar_5bh","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m001-0081","start":81,"end":83,"surface":"趙佗","kind":"person","person_id":"bvb_d1z_fd0","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m001-0088","start":88,"end":90,"surface":"陳勝","kind":"person","person_id":"hav_xw6_5np","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m001-0104","start":104,"end":106,"surface":"項羽","kind":"person","person_id":"67a_vl4_hwv","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m001-0107","start":107,"end":109,"surface":"劉季","kind":"person","person_id":"jhm_171_fem","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m00