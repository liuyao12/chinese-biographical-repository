{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"282_wxp_l9r","canonical_person_id":"282_wxp_l9r","id_aliases":["282_wxp_l9r-"],"identity_policy":"contextual_provisional","person_ids":["282_wxp_l9r"],"persons":[{"id":"282_wxp_l9r","label":"周公（劉敬叔孫通列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"周公","mention_ids":["c-shiji-099-liushu:m002-0163"]}],"evidence":[{"mention_id":"c-shiji-099-liushu:m002-0163","chapter_id":"c-shiji-099-liushu","paragraph_id":"c-shiji-099-liushu:p002","quote":"周公"}],"id_aliases":["282_wxp_l9r-"]}],"source_mention_summary":[{"source_id":"s-shiji-099-liushu","work_id":"w-shiji","book_id":"b-shiji-099","chapter_id":"c-shiji-099-liushu","mention_count":1,"mention_ids":["c-shiji-099-liushu:m002-0163"],"paragraph_ids":["c-shiji-099-liushu:p002"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-099-liushu"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-099-liushu:m002-0163","start":163,"end":165,"surface":"周公","kind":"person","person_id":"282_wxp_l9r","status":"contextual_provisional","paragraph_id":"c-shiji-099-liushu:p002","chapter_id":"c-shiji-099-liushu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji099-018","person_id":"282_wxp_l9r","surfaces":["周公"],"scope":"same_chapter","chapter_ids":["c-shiji-099-liushu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-099-liushu:p002","quote":"已而問婁敬，婁敬說曰：「陛下都洛陽，豈欲與周室比隆哉？」上曰：「然。」婁敬曰：「陛下取天下與周室異。周之先自后稷，堯封之邰，積德累善十有餘世。公劉避桀居豳。太王以狄伐故，去豳，杖馬箠居岐，國人爭隨之。及文王為西伯，斷虞芮之訟，始受命，呂望、伯夷自海濱來歸之。武王伐紂，不期而會孟津之上八百諸侯，皆曰紂可伐矣，遂滅殷。成王即位，周公之屬傅相焉，乃營成周洛邑，以此為天下之中也，諸侯四方納貢職，道裏均矣，有德則易以王，無德則易以亡。凡居此者，欲令周務以德致人，不欲依阻險，令後世驕奢以虐民也。及周之盛時，天下和洽，四夷鄉風，慕義懷德，附離而并事天子，不屯一卒，不戰一士，八夷大國之民莫不賓服，效其貢職。及周之衰也，分而為兩，天下莫朝，周不能制也。非其德薄也，而形勢弱也。今陛下起豐沛，收卒三千人，以之徑往而卷蜀漢，定三秦，與項羽戰滎陽，爭成皋之口，大戰七十，小戰四十，使天下之民肝腦涂地，父子暴骨中野，不可勝數，哭泣之聲未絕，傷痍者未起，而欲比隆於成康之時，臣竊以為不侔也。且夫秦地被山帶河，四塞以為固，卒然有急，百萬之眾可具也。因秦之故，資甚美膏腴之地，此所謂天府者也。陛下入關而都之，山東雖亂，秦之故地可全而有也。夫與人鬬，不搤其亢，拊其背，未能全其勝也。今陛下入關而都，案秦之故地，此亦搤天下之亢而拊其背也。」"}],"rationale":"依婁敬賜姓劉氏及叔孫通叔孫生敘事承接；各引語依人物事件範圍定位。從遠祖不補父系，和親假設不當實際生育，太子未定錨點留待逐項整理。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-099-liushu:p002","text":"已而問婁敬，婁敬說曰：「陛下都洛陽，豈欲與周室比隆哉？」上曰：「然。」婁敬曰：「陛下取天下與周室異。周之先自后稷，堯封之邰，積德累善十有餘世。公劉避桀居豳。太王以狄伐故，去豳，杖馬箠居岐，國人爭隨之。及文王為西伯，斷虞芮之訟，始受命，呂望、伯夷自海濱來歸之。武王伐紂，不期而會孟津之上八百諸侯，皆曰紂可伐矣，遂滅殷。成王即位，周公之屬傅相焉，乃營成周洛邑，以此為天下之中也，諸侯四方納貢職，道裏均矣，有德則易以王，無德則易以亡。凡居此者，欲令周務以德致人，不欲依阻險，令後世驕奢以虐民也。及周之盛時，天下和洽，四夷鄉風，慕義懷德，附離而并事天子，不屯一卒，不戰一士，八夷大國之民莫不賓服，效其貢職。及周之衰也，分而為兩，天下莫朝，周不能制也。非其德薄也，而形勢弱也。今陛下起豐沛，收卒三千人，以之徑往而卷蜀漢，定三秦，與項羽戰滎陽，爭成皋之口，大戰七十，小戰四十，使天下之民肝腦涂地，父子暴骨中野，不可勝數，哭泣之聲未絕，傷痍者未起，而欲比隆於成康之時，臣竊以為不侔也。且夫秦地被山帶河，四塞以為固，卒然有急，百萬之眾可具也。因秦之故，資甚美膏腴之地，此所謂天府者也。陛下入關而都之，山東雖亂，秦之故地可全而有也。夫與人鬬，不搤其亢，拊其背，未能全其勝也。今陛下入關而都，案秦之故地，此亦搤天下之亢而拊其背也。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-099-liushu:m002-0003","start":3,"end":5,"surface":"婁敬","kind":"person","person_id":"yv1_5v4_pjs","status":"contextual_provisional"},{"id":"c-shiji-099-liushu:m002-0006","start":6,"end":8,"surface":"婁敬","kind":"person","person_id":"yv1_5v4_pjs","status":"contextual_provisional"},{"id":"c-shiji-099-liushu:m002-0035","start":35,"end":37,"surface":"婁敬","kind":"person","person_id":"yv1_5v4_pjs","status":"contextual_provisional"},{"id":"c-shiji-099-liushu:m002-0054","start":54,"end":56,"surface":"后稷","kind":"person","person_id":"6l4_h2o_qll","status":"contextual_provisional"},{"id":"c-s