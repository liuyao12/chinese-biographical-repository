}],"most_mentioned_source_ids":["s-sanguozhi-053-chengbing"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-sanguozhi-053-chengbing:line027:reading-000-246","kind":"received_sentence","paragraph_id":"c-sanguozhi-053-chengbing:line027","start_codepoint":0,"end_codepoint":246,"source_quote":"　　程秉字德樞，汝南南頓人也。逮事鄭玄，後避亂交州，與劉熙考論大義，遂博通五經。士燮命為長史。權聞其名儒，以禮徵，秉既到，拜太子太傅。黃武四年，權為太子登娉周瑜女，秉守太常，迎妃於吳，權親幸秉船，深見優禮。既還，秉從容進說登曰：「婚姻人倫之始，王教之基，是以聖王重之，所以率先眾庶，風化天下，故《詩》美《關睢》，以為稱首。願太子尊禮教於閨房，存《周南》之所詠，則道化隆於上，頌聲作於下矣。」登笑曰：「將順其美，匡救其惡，誠所賴於傅君也。」病卒官。著《周易摘》《尚書駁》《論語弼》，凡三萬餘言。","person_id":"eus_x4z_ogu","related_person_ids":["95f_p0e_7s8","4j2_9t6_18d","p2p_gqb_6ar","572_278_cba","572_278_cba_C","f56_938_997","f56_938_997_A"],"reading":"鄭玄與劉熙分見「逮事」「考論」，士燮命長史。黃武四年孫權為子登聘周瑜女；太子太傅程秉守太常迎妃。","chapter_id":"c-sanguozhi-053-chengbing","source_id":"s-sanguozhi-053-chengbing"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-wu053-chengbing0","person_id":"eus_x4z_ogu","event_type":"death","source_term":"病卒官","date_expression":null,"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-053","chapter_id":"c-sanguozhi-053-chengbing","source_id":"s-sanguozhi-053-chengbing","paragraph_id":"c-sanguozhi-053-chengbing:line027","quote":"　　程秉字德樞，汝南南頓人也。逮事鄭玄，後避亂交州，與劉熙考論大義，遂博通五經。士燮命為長史。權聞其名儒，以禮徵，秉既到，拜太子太傅。黃武四年，權為太子登娉周瑜女，秉守太常，迎妃於吳，權親幸秉船，深見優禮。既還，秉從容進說登曰：「婚姻人倫之始，王教之基，是以聖王重之，所以率先眾庶，風化天下，故《詩》美《關睢》，以為稱首。願太子尊禮教於閨房，存《周南》之所詠，則道化隆於上，頌聲作於下矣。」登笑曰：「將順其美，匡救其惡，誠所賴於