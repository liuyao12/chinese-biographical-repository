tive","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"孔休源在此段的官序。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"th-liang050-xiezheng-26-wyd","person_id":"g7c_o6p_gu1","title":"宣惠將軍","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-050","chapter_id":"c-liangshu-050-xiezheng-wyd","source_id":"s-liangshu-050-xiezheng-wyd1739","paragraph_id":"c-liangshu-050-xiezheng-wyd:p004","quote":"中大通元年以父喪去職續又丁母憂詔起為貞威將軍還攝本任服闋除尚書左丞三年昭明太子薨高祖立晉安王綱為皇太子將出詔唯召尚書左僕射何敬容宣惠將軍孔休源及徵三人與議徵時年位尚輕而任遇已重四年累遷中書郎鴻臚卿舍人如故六年出為北中郎豫章王長史南蘭陵太守大同二年卒官時年三十七友人琅邪王籍集其文為二十卷","person_mention_id":"c-liangshu-050-xiezheng-wyd:p004:m0068"}],"attestations":[{"paragraph_id":"c-liangshu-050-xiezheng-wyd:p004","surface":"宣惠將軍","start":64,"end":68,"id":"th-liang050-xiezheng-26-wyd:a1","person_mention_id":"c-liangshu-050-xiezheng-wyd:p004:m0068","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"孔休源在此段的官序。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"th-nanshi019-xieyu-descendants-94-141","person_id":"g7c_o6p_gu1","title":"宣惠將軍","kind":"office","mode":"attestation","attestations":[{"id":"th-nanshi019-xieyu-descendants-94-141:a","paragraph_id":"c-nanshi-019-xieyu-descendants:p008","start":141,"end":145,"surface":"宣惠將軍","person_mention_id":"c-nanshi-019-xieyu-descendants:p008:m0145","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-019","chapter_id":"c-nanshi-019-xieyu-descendants","source_id":"s-nanshi-019-xieyu-descendants-ws1531762","paragraph_id":"c-nanshi-019-xieyu-descendants:p008","quote":"子微字玄度，美風采，好學善屬文，位兼中書舍人。與河東裴子野、沛國劉顯同官友善。時魏中山王元略還北，梁武帝餞於武德殿，賦詩三十韻，限三刻成。微二刻便就，文甚美，帝再覽焉。又爲臨汝侯猷制放生文，亦見賞於世。後除尙書左丞。及昭明太子薨，帝立晉安王綱爲皇太子，將出詔，唯召尙書右僕射何敬容、宣惠將軍孔休源及微三人與議。微時年位尙輕，而任遇已重。後卒於北中郎豫章王長史、南蘭陵太守。文集二十卷。","person_mention_id":"c-nanshi-019-xieyu-descendants:p008:m0145"}],"status":"source_attested","interpretation_note":"本句所載官名，任期無確切年月。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-050-xiezheng-wyd:p004","text":"中大通元年以父喪去職續又丁母憂詔起為貞威將軍還攝本任服闋除尚書左丞三年昭明太子薨高祖立晉安王綱為皇太子將出詔唯召尚書左僕射何敬容宣惠將軍孔休源及徵三人與議徵時年位尚輕而任遇已重四年累遷中書郎鴻臚卿舍人如故六年出為北中郎豫章王長史南蘭陵太守大同二年卒官時年三十七友人琅邪王籍集其文為二十卷","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-liangshu-050-xiezheng-wyd:p004:u0013","start":13,"end":14,"surface":"母","person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"謝徵母，傳未具名。"},{"id":"c-liangshu-050-xiezheng-wyd:p004:m0046","start":46,"end":47,"surface":"綱","person_id":"rtd_v0b_nyn","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"},{"id":"c-liangshu-050-xiezheng-wyd:p004:m0061","start":61,"end":64,"surface":"何敬容","person_id":"8ke_fzu_5pg","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"},{"id":"c-liangshu-050-xiezheng-wyd:p004:m0068","start":68,"end":71,"surface":"孔休源","person_id":"g7c_o6p_gu1","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"},{"id":"c-liangshu-050-xiezheng-wyd:p004:m0072","start":72,"end":73,"surface":"徵","person_id":"684_eaa_511_AAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"},{"id":"c-liangshu-050-xiezheng-wyd:p004:u0073","start":73,"end"