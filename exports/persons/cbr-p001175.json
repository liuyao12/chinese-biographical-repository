{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p001175","identity_policy":"contextual_provisional","person_ids":["cbr-p001175"],"persons":[{"id":"cbr-p001175","label":"盧蒲嫳","status":"active","historicity":"historical_tradition","aliases":[{"surface":"盧蒲嫳","mention_ids":["c-shiji-032-qi:m065-0165"]}],"evidence":[{"mention_id":"c-shiji-032-qi:m065-0165","chapter_id":"c-shiji-032-qi","paragraph_id":"c-shiji-032-qi:p065","quote":"盧蒲嫳"}]}],"mentions":[{"id":"c-shiji-032-qi:m065-0165","start":165,"end":168,"surface":"盧蒲嫳","kind":"person","person_id":"cbr-p001175","status":"contextual_provisional","paragraph_id":"c-shiji-032-qi:p065","chapter_id":"c-shiji-032-qi"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-032-qi:p065","text":"景公元年，初，崔杼生子成及彊，其母死，取東郭女，生明。東郭女使其前夫子無咎與其弟偃相崔氏。成有罪，二相急治之，立明為太子。成請老於崔［杼］，崔杼許之，二相弗聽，曰：「崔，宗邑，不可。」成、彊怒，告慶封。慶封與崔杼有郤，欲其敗也。成、彊殺無咎、偃於崔杼家，家皆奔亡。崔杼怒，無人，使一宦者御，見慶封。慶封曰：「請為子誅之。」使崔杼仇盧蒲嫳攻崔氏，殺成、彊，盡滅崔氏，崔杼婦自殺。崔杼毋歸，亦自殺。慶封為相國，專權。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-032-qi:m065-0000","start":0,"end":2,"surface":"景公","kind":"person","person_id":"cbr-p001072","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m065-0007","start":7,"end":9,"surface":"崔杼","kind":"person","person_id":"cbr-p000263","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m065-0010","start":10,"end":12,"surface":"子成","kind":"person","person_id":"cbr-p001169","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m065-0013","start":13,"end":14,"surface":"彊","kind":"person","person_id":"cbr-p001170","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m065-0015","start":15,"end":17,"surface":"其母","kind":"person","person_id":"cbr-p001212","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m065-0020","start":20,"end":23,"surface":"東郭女","kind":"person",