u","book_id":"b-jiutangshu-089","chapter_id":"c-jiutangshu-089-tang89","source_id":"s-jiutangshu-089-tang89-ws2589393","paragraph_id":"c-jiutangshu-089-tang89:p001","quote":"王方慶，雍州咸陽人也，周少司空石泉公褒之曾孫也。其先自琅邪南度，居於丹陽，爲江左冠族。褒北徙入關，始家咸陽焉。祖鼒，隋衞尉丞。伯父弘讓，有美名，貞觀中爲中書舍人。父弘直，爲漢王元昌友，畋獵無度，乃上書切諫，","subject_person_mention_id":"c-jiutangshu-089-tang89:p001:m0000","object_person_mention_id":"c-jiutangshu-089-tang89:p001:m0082","source_term":"父弘直"}],"status":"contextual_provisional","human_reviewed":false,"interpretation_note":"王方慶本傳明載父弘直。"}},{"id":"7r6_k52_qji_ABAAAAEAAAAAAAAA","label":"王光輔","status":"active","historicity":"historical_tradition","aliases":[{"surface":"光輔","mention_ids":["c-jiutangshu-089-tang89:p002:m0131"]}],"evidence":[{"work_id":"w-jiutangshu","book_id":"b-jiutangshu-089","chapter_id":"c-jiutangshu-089-tang89","source_id":"s-jiutangshu-089-tang89-ws2589393","paragraph_id":"c-jiutangshu-089-tang89:p002","quote":"光輔","mention_id":"c-jiutangshu-089-tang89:p002:m0131"}],"identity_note":"《舊唐書》本傳載王方慶長子光輔。","review":"ai_provisional","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"7r6_k52_qji_ABAAAAEAAAAAAAA","source_assertion_id":"a-jiutangshu-089-tang89-m0131-death-father","evidence":[{"work_id":"w-jiutangshu","book_id":"b-jiutangshu-089","chapter_id":"c-jiutangshu-089-tang89","source_id":"s-jiutangshu-089-tang89-ws2589393","paragraph_id":"c-jiutangshu-089-tang89:p002","quote":"長安二年五月卒，贈袞州都督，諡曰貞。中宗即位，以宮僚之舊，追贈吏部尚書。方慶博學好著述，所撰雜書凡二百餘卷。尤精《三禮》，好事者多詢訪之。每所酬答，鹹有典據，故時人編次，名曰《禮雜答問》。聚書甚多，不減秘閣，至於圖畫，亦多異本。諸子莫能守其業，卒後尋亦散亡。長子光輔，開元中官至潞州刺史。少子晙，工書知名，尤善琴棋，而性多嚴整，官至殿中侍御史。","subject_person_mention_id":"c-jiutangshu-089-tang89:p002:m0131","object_person_mention_id":"c-jiutangshu-089-tang89:p002:m0036","source_term":"長子光輔"}],"status":"contextual_provisional","human_reviewed":false,"interpretation_note":"王方慶本傳列光輔為長子。"}}],"source_mention_summary":[{"source_id":"s-jiutangshu-089-tang89-ws2589393","work_id":"w-jiutangshu","book_id":"b-jiutangshu-089","chapter_id":"c-jiutangshu-089-tang89","raw_mention_count":1,"mention_ids":["c-jiutangshu-089-tang89:p002:m0131"],"paragraph_ids":["c-jiutangshu-089-tang89:p002"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jiutangshu-089-tang89:p002:m0131","mention_ids":["c-jiutangshu-089-tang89:p002:m0131"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jiutangshu-089-tang89-ws2589393"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jiutangshu-089-tang89-m0131-death-father","subject_person_id":"7r6_k52_qji_ABAAAAEAAAAAAAAA","predicate":"father","object_person_id":"7r6_k52_qji_ABAAAAEAAAAAAAA","status":"source_attested","qualifiers":{"source_term":"長子光輔","lineage":"paternal","birth_order":{"parent_person_id":"7r6_k52_qji_ABAAAAEAAAAAAAA","scope":"sons_of_parent","ordinal":1,"position":"unspecified","interpretation_status":"source_attested"}},"evidence":[{"work_id":"w-jiutangshu","book_id":"b-jiutangshu-089","chapter_id":"c-jiutangshu-089-tang89","source_id":"s-jiutangshu-089-tang89-ws2589393","paragraph_id":"c-jiutangshu-089-tang89:p002","quote":"長安二年五月卒，贈袞州都督，諡曰貞。中宗即位，以宮僚之舊，追贈吏部尚書。方慶博學好著述，所撰雜書凡二百餘卷。尤精《三禮》，好事者多詢訪之。每所酬答，鹹有典據，故時人編次，名曰《禮雜答問》。聚書甚多，不減秘閣，至於圖畫，亦多異本。諸子莫能守其業，卒後尋亦散亡。長子光輔，開元中官至潞州刺史。少子晙，工書知名，尤善琴棋，而性多嚴整，官至殿中侍御史。","subject_person_mention_id":"c-jiutangshu-089-tang89:p002:m0131","object_person_mention_id":"c-jiuta