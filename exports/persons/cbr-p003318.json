{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003318","canonical_person_id":"bwv_p3h_q1j","id_aliases":["cbr-p003318"],"identity_policy":"contextual_provisional","person_ids":["bwv_p3h_q1j"],"persons":[{"id":"bwv_p3h_q1j","label":"趙賁（曹相國世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"趙賁","mention_ids":["c-shiji-054-cao:m003-0042","c-shiji-054-cao:m003-0050","c-shiji-054-cao:m003-0104","c-shiji-054-cao:m004-0095"]}],"evidence":[{"mention_id":"c-shiji-054-cao:m003-0042","chapter_id":"c-shiji-054-cao","paragraph_id":"c-shiji-054-cao:p003","quote":"趙賁"},{"mention_id":"c-shiji-054-cao:m003-0050","chapter_id":"c-shiji-054-cao","paragraph_id":"c-shiji-054-cao:p003","quote":"趙賁"},{"mention_id":"c-shiji-054-cao:m003-0104","chapter_id":"c-shiji-054-cao","paragraph_id":"c-shiji-054-cao:p003","quote":"趙賁"},{"mention_id":"c-shiji-054-cao:m004-0095","chapter_id":"c-shiji-054-cao","paragraph_id":"c-shiji-054-cao:p004","quote":"趙賁"}],"id_aliases":["cbr-p003318"]}],"source_mention_summary":[{"source_id":"s-shiji-054-cao","work_id":"w-shiji","book_id":"b-shiji-054","chapter_id":"c-shiji-054-cao","mention_count":4,"mention_ids":["c-shiji-054-cao:m003-0042","c-shiji-054-cao:m003-0050","c-shiji-054-cao:m003-0104","c-shiji-054-cao:m004-0095"],"paragraph_ids":["c-shiji-054-cao:p003","c-shiji-054-cao:p004"],"passage_count":2}],"most_mentioned_source_ids":["s-shiji-054-cao"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-054-cao:m003-0042","start":42,"end":44,"surface":"趙賁","kind":"person","person_id":"bwv_p3h_q1j","status":"contextual_provisional","paragraph_id":"c-shiji-054-cao:p003","chapter_id":"c-shiji-054-cao"},{"id":"c-shiji-054-cao:m003-0050","start":50,"end":52,"surface":"趙賁","kind":"person","person_id":"bwv_p3h_q1j","status":"contextual_provisional","paragraph_id":"c-shiji-054-cao:p003","chapter_id":"c-shiji-054-cao"},{"id":"c-shiji-054-cao:m003-0104","start":104,"end":106,"surface":"趙賁","kind":"person","person_id":"bwv_p3h_q1j","status":"contextual_provisional","paragraph_id":"c-shiji-054-cao:p003","chapter_id":"c-shiji-054-cao"},{"id":"c-shiji-054-cao:m004-0095","start":95,"end":97,"surface":"趙賁","kind":"person","person_id":"bwv_p3h_q1j","status":"contextual_provisional","paragraph_id":"c-shiji-054-cao:p004","chapter_id":"c-shiji-054-cao"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji054-012","person_id":"bwv_p3h_q1j","surfaces":["趙賁"],"scope":"same_chapter","chapter_ids":["c-shiji-054-cao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-054-cao:p003","quote":"其後從攻東郡尉軍，破之成武南。擊王離軍成陽南，復攻之杠裏，大破之。追北，西至開封，擊趙賁軍，破之，圍趙賁開封城中。西擊將楊熊軍於曲遇，破之，虜秦司馬及御史各一人。遷為執珪。從攻陽武，下軒轅、緱氏，絕河津，還擊趙賁軍尸北，破之。從南攻犨，與南陽守齮戰陽城郭東，陷陳，取宛，虜齮，盡定南陽郡。從西攻武關、峣關，取之。前攻秦軍藍田南，又夜擊其北，秦軍大破，遂至咸陽，滅秦。"},{"paragraph_id":"c-shiji-054-cao:p004","quote":"項羽至，以沛公為漢王。漢王封參為建成侯。從至漢中，遷為將軍。從還定三秦，初攻下辯、故道、雍、斄。擊章平軍於好畤南，破之，圍好畤，取壤鄉。擊三秦軍壤東及高櫟，破之。復圍章平，章平出好畤走。因擊趙賁、內史保軍，破之。東取咸陽，更名曰新城。參將兵守景陵二十日，三秦使章平等攻參，參出擊，大破之。賜食邑於寧秦。參以將軍引兵圍章邯於廢丘。以中尉從漢王出臨晉關。至河內，下修武，渡圍津，東擊龍且、項他定陶，破之。東取碭、蕭、彭城。擊項籍軍，漢軍大敗走。參以中尉圍取雍丘。王武反於外黃，程處反於燕，往擊，盡破之。柱天侯反於衍氏，又進破取衍氏。擊羽嬰於昆陽，追至葉。還攻武彊，因至滎陽。參自漢中為將軍中尉，從擊諸侯，及項羽敗，還至滎陽，凡二歲。"}],"rationale":"依本篇明示姓名與局部軍事、任官及子嗣敘事暫接；曹氏時、襄不按單字全域配對。未名者不補姓名，秦司馬夷字待底本核定，田既與田溉不擅同指。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-054-cao:p003","text":"其後從攻東郡尉軍，破之成武南。擊王離軍成陽南，復攻之杠裏，大破之。追北，西至開封，擊趙賁軍，破之，圍趙賁開封城中。西擊將楊熊軍於曲遇，破之，虜秦司馬及御史各一人。遷為執珪。從攻陽武，下軒轅、緱氏，絕河津，還擊趙賁軍尸北，破之。從南攻犨，與南陽守齮戰陽城郭東，陷陳，取宛，虜齮，盡定南陽郡。從西攻武關、峣關，取之。前攻秦軍藍田南，又夜擊其北，秦軍大破，遂至咸陽，滅秦。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-054-cao:m003-0000","start":0,"end":1,"surface":"其","kind":"person","person_id":"913_1wz_ofu","status":"contextual_provisional","note":"其後從攻承接前段曹參軍事行程與爵秩敘事；同段遷為執珪的隱含受授者據此暫接曹參，非最近人名楊熊或南陽守齮。"},{"id":"c-shiji-054-cao:m003-0004","start":4,"end":7,"surface":"東郡尉","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名署稱、群體、學說合稱或代詞待核，不補姓名、親屬成員或全域帝號。"},{"id":"c-shiji-054-cao:m003-0016","start":16,"end":18,"surface":"王離","kind":"person","person_id":"d0z_er0_gco","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m003-0042","start":42,"end":44,"surface":"趙賁","kind":"person","person_id":"bwv_p3h_q1j","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m003-0050","start":50,"end":52,"surface":"趙賁","kind":"person","person_id":"bwv_p3h_q1j","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m003-0060","start":60,"end":62,"surface":"楊熊","kind":"person","person_id":"3ja_mh8_wrw","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m003-0071","start":71,"end":74,"surface":"秦司馬","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名署稱、群體、學說合稱或代詞待核，不補姓名、親屬成員或全域帝號。"},{"id":"c-shiji-054-cao:m003-0075","start":75,"end":80,"surface":"御史各一人","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名署稱、群體、學說合稱或代詞待核，不補姓名、親屬成員或全域帝號。"},{"id":"c-shiji-054-cao:m003-0104","start":104,"end":106,"surface":"趙賁","kind":"person","person_id":"bwv_p3h_q1j","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m003-0119","start":119,"end":123,"surface":"南陽守齮","kind":"person","person_id":"dwf_eik_t2x","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m003-0136","start":136,"end":137,"surface":"齮","kind":"person","person_id":"dwf_eik_t2x","status":"contextual_provisional"}],"chapter_id":"c-shiji-054-cao","book_id":"b-shiji-054","work_id":