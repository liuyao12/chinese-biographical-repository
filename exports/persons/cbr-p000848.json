俞侯，呂更始為贅其侯，呂忿為呂城侯，及諸侯丞相五人。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-009-lvhou:m009-0000","start":0,"end":2,"surface":"太后","kind":"person","person_id":"i30_mjq_6q8_A","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m009-0009","start":9,"end":11,"surface":"孝惠","kind":"person","person_id":"yqp_nlb_p1p_AA","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m009-0013","start":13,"end":15,"surface":"子彊","kind":"person","person_id":"wjf_wa5_eu9","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m009-0021","start":21,"end":23,"surface":"不疑","kind":"person","person_id":"qtn_m4s_poh","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m009-0024","start":24,"end":27,"surface":"常山王","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或稱號仍待逐處覆核，不補熟知名字。"},{"id":"c-shiji-009-lvhou:m009-0028","start":28,"end":30,"surface":"子山","kind":"person","person_id":"zht_ze7_m2d","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m009-0035","start":35,"end":37,"surface":"子朝","kind":"person","person_id":"4tb_tcb_9tq","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m009-0041","start":41,"end":43,"surface":"子武","kind":"person","person_id":"x8h_bgr_mc5","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m009-0048","start":48,"end":50,"surface":"太后","kind":"person","person_id":"i30_mjq_6q8_A","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m009-0058","start":58,"end":62,"surface":"酈侯呂台","kind":"person","person_id":"acg_se3_w5x_A","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m009-0066","start":66,"end":68,"surface":"太后","kind":"person","person_id":"i30_mjq_6q8_A","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m009-0071","start":71,"end":75,"surface":"建成康侯","kind":"person","person_id":"c90_m9w_lqu","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m009-0075","start":75,"end":77,"surface":"釋之","kin