,"end":150,"surface":"鯤","kind":"person","person_id":"4ij_7ik_fgy","status":"contextual_provisional"}],"source_position":{"first_line":41,"last_line":42,"revision_id":2180533,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-076-wangyi-family","book_id":"b-jinshu-076","work_id":"w-jinshu","source_id":"s-jinshu-076-wangyi-family"},{"id":"c-jinshu-076-wangyi-family:p004","text":"子頤之嗣，仕至東海內史。頤之弟胡之，字修齡，弱冠有聲譽，歷郡守、侍中、丹陽尹。素有風眩疾，發動甚數，而神明不損。石季龍死，朝廷欲綏輯河洛，以胡之為西中郎將、司州刺史、假節，以疾固辭，未行而卒。子茂之亦有美譽，官至晉陵太守。子敬弘，義熙末為尚書。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-076-wangyi-family:p004:m0001","start":1,"end":3,"surface":"頤之","kind":"person","person_id":"7r6_k52_qji_ABDAA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p004:m0012","start":12,"end":14,"surface":"頤之","kind":"person","person_id":"7r6_k52_qji_ABDAA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p004:m0015","start":15,"end":17,"surface":"胡之","kind":"person","person_id":"7r6_k52_qji_ABDAB","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p004:m0019","start":19,"end":21,"surface":"修齡","kind":"person","person_id":"7r6_k52_qji_ABDAB","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p004:m0056","start":56,"end":59,"surface":"石季龍","kind":"person","person_id":"u61_ylg_6av","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p004:m0070","start":70,"end":72,"surface":"胡之","kind":"person","person_id":"7r6_k52_qji_ABDAB","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p004:role0073","start":73,"end":77,"surface":"西中郎將","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"擬授後以疾固辭、未行而卒，不連成現任者。"},{"id":"c-jinshu-076-wangyi-family:p004:role0078","start":78,"end":82,"surface":"司州刺史","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"擬授後以疾固辭、未行而卒，不連成現任者。"},{"id":"c-jinshu-076-wangyi-family:p004:role0083","start":83,"end":85,"surface":"假節","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"擬授後以疾固辭、未行而卒，不連成現任者。"},{"id":"c-jinshu-076-wangyi-family:p004:m0097","start":97,"end":99,"surface":"茂之","kind":"person","person_id":"7r6_k52_qji_ABDABA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p004:m0112","start":112,"end":114,"surface":"敬弘","kind":"person","person_id":"7r6_k52_qji_ABDABAA","status":"contextual_provisional"}],"source_position":{"first_line":43,"last_line":44,"revision_id":2180533,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-076-wangyi-family","book_id":"b-jinshu-076","work_id":"w-jinshu","source_id":"s-jinshu-076-wangyi-family"}],"sources":[{"chapter_id":"c-jinshu-076-wangyi-family","work_id":"w-jinshu","book_id":"b-jinshu-076","source_id":"s-jinshu-076-wangyi-family","source":{"title":"《晉書》卷七十六（數位選錄）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7076&oldid=2180533","permalink":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7076&oldid=2180533","revision_id":2180533,"accessed_on":"2026-10-18","extent":"王廙傳首、末段及子嗣共四段，中興賦等中段未錄，非完整列傳。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，未親核底本影像","response_sha256":"c6c7c41bf93c491f6f69b058ecc493e979d65f3e65397d20055284f2e829cd30","wikitext_sha256":"872701db949f6f58ea6f183425617dfa82353177d2cc026037bfad953a60cd71","normalization":{"character_conversion":{},"extraction_note":"去首部空白，宋書ref校勘記另存，正文原字不改；不補平南將領的疑缺字。","excerpts":[{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:p001","source_lines":[27,28],"raw_quote":"王廙，字世將，丞相導從弟，而元帝姨弟也。父正，尚書郎。廙少能屬文，多所通涉，工書畫，善音樂、射御、博弈、雜伎。辟太傅掾，轉參軍。豫迎大駕，封武陵縣侯，拜尚書郎，出為濮陽太守。元帝作鎮江左，廙棄郡過江。帝見之大悅，以為司馬。頻守廬江、鄱陽二郡。豫討周馥、杜韜，以功累增封邑，除冠軍將軍，鎮石頭，領丞相軍諮祭酒。王敦啟為甯遠將軍、荊州刺史。","raw_quote_sha256":"8147d33d3202efaa1adf4a1c6aa137d71d239827b11033011846a53f38708001","selected_text_sha256":"8147d33d3202efaa1adf4a1c6aa137d71d239827b11033011846a53f38708001","begin_anchor":"王廙，字世將，丞相導從弟，而元","end_anchor":"。王敦啟為甯遠將軍、荊州刺史。"},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:p002","source_lines":[39,40],"raw_quote":"初，王敦左遷陶侃，使廙代為荊州。將吏馬俊、鄭攀等上書請留侃，敦不許。廙為俊等所襲，奔于江安。賊杜曾與俊、攀北迎第五猗以距廙。廙督諸軍討曾，又為曾所敗。敦命湘州刺史甘卓、豫章太守周廣等助廙擊曾，曾衆潰，廙得到州。廙性俊率，嘗從南下，旦自尋陽，迅風飛帆，暮至都，倚舫樓長嘯，神氣甚逸。王導謂庾亮曰：「世將為傷時識事。」亮曰：「正足舒其逸氣耳。」廙在州大誅戮侃時將佐，及征士皇甫方回，於是大失荊土之望，人情乖阻。帝乃征廙為輔國將軍，加散騎常侍。以母喪去職。服闋，拜征虜將軍，進左衛將軍。","raw_quote_sha256":"713e46789dcf7fe1c521542418159b142d29f81e58c3e6357597be46caf9c662","selected_text_sha256":"713e46789dcf7fe1c521542418159b142d29f81e58c3e6357597be46caf9c662","begin_anchor":"初，王敦左遷陶侃，使廙代為荊州","end_anchor":"服闋，拜征虜將軍，進左衛將軍。"},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:p003","source_lines":[41,42],"raw_quote":"及王敦構禍，帝遣廙喻敦，既不能諫其悖逆，乃為敦所留，受任助亂。敦得志，以廙為平南將領護南蠻校尉、荊州刺史。尋病卒。帝猶以親故，深痛湣之。喪還京都，皇太子親臨拜柩，如家人之禮。贈侍中、驃騎將軍，諡曰康。明帝與大將軍溫嶠書曰：「痛謝鯤未絕於口，世將復至於此。並盛年雋才，不遂其志，痛切於心。廙明古多通，鯤遠有識致。其言雖未足令人改聽，然味之不倦，近未易有也。坐相視盡，如何！」","raw_quote_sha256":"b2c8c3b975ba6ac7732d8b4a11f0ec1be353f9f1fb577963a649d9140d52c2bb","selected_text_sha256":"b2c8c3b975ba6ac7732d8b4a11f0ec1be353f9f1fb577963a649d9140d52c2bb","begin_anchor":"及王敦構禍，帝遣廙喻敦，既不能","end_anchor":"近未易有也。坐相視盡，如何！」"},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:p004","source_lines":[43,44],"raw_quote":"子頤之嗣，仕至東海內史。頤之弟胡之，字修齡，弱冠有聲譽，歷郡守、侍中、丹陽尹。素有風眩疾，發動甚數，而神明不損。石季龍死，朝廷欲綏輯河洛，以胡之為西中郎將、司州刺史、假節，以疾固辭，未行而卒。子茂之亦有美譽，官至晉陵太守。子敬弘，義熙末為尚書。","raw_quote_sha256":"07b3bbc4071f24625a64510a17080b7ab063923ca9f6d5febeb0893dfefef0c6","selected_text_sha256":"07b3bbc4071f24625a64510a17080b7ab063923ca9f6d5febeb0893dfefef0c6","begin_anchor":"子頤之嗣，仕至東海內史。頤之弟","end_anchor":"陵太守。子敬弘，義熙末為尚書。"}]}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true},"assembled_identity":{"person_id":"7r6_k52_qji_ABDAA","representative_source_person_id":"7r6_k52_qji_ABDAA","source_person_ids":["7r6_k52_qji_ABDAA"],"identity_equivalence_decision_ids":[],"parent_person_id":"7r6_k52_qji_ABDA","source_assertion_id":"a-jinshu076-wang-005","assembly_id":"family-langye-wang-dao","root_person_id":"7r6_k52_qji","status":"editorial_preferred","human_reviewed":false}}
