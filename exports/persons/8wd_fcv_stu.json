ers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-shiji117-xiangru","s-shiji123-dayuan"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-117-xiangru:m035-0186","start":186,"end":189,"surface":"壺充國","kind":"person","person_id":"8wd_fcv_stu","status":"contextual_provisional","paragraph_id":"c-shiji-117-xiangru:p035","chapter_id":"c-shiji-117-xiangru"},{"id":"c-shiji-123-dayuan:m034-0041","start":41,"end":44,"surface":"壺充國","kind":"person","person_id":"8wd_fcv_stu","status":"contextual_provisional","paragraph_id":"c-shiji-123-dayuan:p034","chapter_id":"c-shiji-123-dayuan"}],"relations":[],"title_holdings":[{"id":"th-shiji117-010","person_id":"8wd_fcv_stu","title":"副使","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-117-xiangru","source_id":"s-shiji117-xiangru","paragraph_id":"c-shiji-117-xiangru:p035","quote":"相如還報。唐蒙已略通夜郎，因通西南夷道，發巴、蜀、廣漢卒，作者數萬人。治道二歲，道不成，士卒多物故，費以巨萬計。蜀民及漢用事者多言其不便。是時邛筰之君長聞南夷與漢通，得賞賜多，多欲原為內臣妾，請吏，比南夷。天子問相如，相如曰：「邛、筰、厓、駹者近蜀，道亦易通，秦時嘗通為郡縣，至漢興而罷。今誠複通，為置郡縣，愈於南夷。」天子以為然，乃拜相如為中郎將，建節往使。副使王然於、壺充國、呂越人馳四乘之傳，因巴蜀吏幣物以賂西夷。至蜀，蜀太守以下郊迎，縣令負弩矢先驅，蜀人以為寵。於是卓王孫、臨邛諸公皆因門下獻牛酒以交驩。卓王孫喟然而歎，自以得使女尚司馬長卿晚，而厚分與其女財，與男等同。司馬長卿便略定西夷，邛、筰、厓、駹、斯榆之君皆請為內臣。除邊關，關益斥，西至沬、若水，南至牂柯為徼，通零關道，橋孫水以通邛都。還報天子，天子大說。"}],"attestations":[{"id":"th-shiji117-010:a001","paragraph_id":"c-shiji-117-xiangru:p035","start":180,"end":182,"surface":"副使","person_mention_id":"c-shiji-117-xiangru:m035-0186","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授任與文獻用稱分存；受金失官與歲餘復召為郎分事件。原文未明示公元日期，不補年份或任期；死亡不自動終止全部官爵。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji123-030","person_id":"8wd_fcv_stu","title":"鴻臚","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-123-dayuan","source_id":"s-shiji123-dayuan","paragraph_id":"c-shiji-123-dayuan:p034","quote":"初，貳師起敦煌西，以為人多，道上國不能食，乃分為數軍，從南北道。校尉王申生、故鴻臚壺充國等千餘人，別到郁成。郁成城守，不肯給食其軍。王申生去大軍二百里，（偵）［偩］而輕之，責郁成。郁成食不肯出，窺知申生軍日少，晨用三千人攻，戮殺申生等，軍破，數人脫亡，走貳師。貳師令搜粟都尉上官桀往攻破郁成。郁成王亡走康居，桀追至康居。康居聞漢已破宛，乃出郁成王予桀，桀令四騎士縛守詣大將軍。四人相謂曰：「郁成王漢國所毒，今生將去，卒失大事。」欲殺，莫敢先擊。上邽騎士趙弟最少，拔劍擊之，斬郁成王，齎頭。弟、桀等逐及大將軍。"}],"attestations":[{"id":"th-shiji123-030:a001","paragraph_id":"c-shiji-123-dayuan:p034","start":39,"end":41,"surface":"鴻臚","person_mention_id":"c-shiji-123-dayuan:m034-0041","usage":"retrospective","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"原文授任、繼位與用稱分存；未知起訖保持未知，不因死亡自動終止。從驃侯等原稱不默改。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji117-123-huchongguo-identity","person_id":"8wd_fcv_stu","scope":"cross_chapter","chapter_ids":["c-shiji-117-xiangru","c-shiji-123-dayuan"],"status":"contextual_provisional","confidence_level":"moderate","surfaces":["壺充國"],"identification_basis":{"kind":"source_context","target_mention_ids":["c-shiji-117-xiangru:m035-0186"]},"evidence":[{"chapter_id":"c-shiji-117-xiangru","paragraph_id":"c-shiji-117-xiangru:p035","quote":"副使王然於、壺充國、呂越人馳四乘之傳"},{"chapter_id":"c-shiji-123-dayuan","paragraph_id":"c-shiji-123-dayuan:p034","quote":"校尉王申生、故鴻臚壺充國等千餘人"}],"rationale":"兩篇均載罕見全名「壺充國」；卷117稱其為司馬相如西南夷使團副使，卷123追稱「故鴻臚」並記入貳師伐大宛軍。人物活動與官職次序相容，未見矛盾，但兩篇沒有直接互指；依同名及時序暫定同人，不把副使、鴻臚合併成同一職稱時段，也不推任期。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"equivalence_decisions":[{"id":"eq-shiji117-123-huchongguo","person_ids":["8wd_fcv_stu"],"canonical_person_id":"8wd_fcv_stu","scope":"cross_chapter","chapter_ids":["c-shiji-117-xiangru","c-shiji-123-dayuan"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-117-xiangru","source_id":"s-shiji117-xiangru","paragraph_id":"c-shiji-117-xiangru:p035","quote":"副使王然於、壺充國、呂越人馳四乘之傳","mention_ids":["c-shiji-117-xiangru:m035-0186"]},{"chapter_id":"c-shiji-123-dayuan","source_id":"s-shiji123-dayuan","paragraph_id":"c-shiji-123-dayuan:p034","quote":"校尉王申生、故鴻臚壺充國等千餘人","mention_ids":["c-shiji-123-dayuan:m034-0041"]}],"rationale":"兩篇均載罕見全名「壺充國」；卷117稱其為司馬相如西南夷使團副使，卷123追稱「故鴻臚」並記入貳師伐大宛軍。人物活動與官職次序相容，未見矛盾，但兩篇沒有直接互指；依同名及時序暫定同人，不把副使、鴻臚合併成同一職稱時段，也不推任期。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true}],"passages":[{"id":"c-shiji-117-xiangru:p035","text":"相如還報。唐蒙已略通夜郎，因通西南夷道，發巴、蜀、廣漢卒，作者數萬人。治道二歲，道不成，士卒多物故，費以巨萬計。蜀民及漢用事者多言其不便。是時邛筰之君長聞南夷與漢通，得賞賜多，多欲原為內臣妾，請吏，比南夷。天子問相如，相如曰：「邛、筰、厓、駹者近蜀，道亦易通，秦時嘗通為郡縣，至漢興而罷。今誠複通，為置郡縣，愈於南夷。」天子以為然，乃拜相如為中郎將，建節往使。副使王然於、壺充國、呂越人馳四乘之傳，因巴蜀吏幣物以賂西夷。至蜀，蜀太守以下郊迎，縣令負弩矢先驅，蜀人以為寵。於是卓王孫、臨邛諸公皆因門下獻牛酒以交驩。卓王孫喟然而歎，自以得使女尚司馬長卿晚，而厚分與其女財，與男等同。司馬長卿便略定西夷，邛、筰、厓、駹、斯榆之君皆請為內臣。除邊關，關益斥，西至沬、若水，南至牂柯為徼，通零關道，橋孫水以通邛都。還報天子，天子大說。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m035-0000","start":0,"end":2,"surface":"相如","kind":"person","person_id":"usb_lgr_ksa","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0005","start":5,"end":7,"surface":"唐蒙","kind":"person","person_id":"a62_lwv_9ui","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m035-0073","start":73,"end":75