equired":false},"family_paths":[],"mentions":[{"id":"c-jinshu-071-xiongyuan:p005:m0222","surface":"穰苴","start":222,"end":224,"person_id":"nlg_owl_qwb","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-071-xiongyuan:p005","chapter_id":"c-jinshu-071-xiongyuan"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-071-xiongyuan:p005","text":"轉丞相參軍。是時琅邪國侍郎王鑒勸帝親征杜弢，遠又上疏曰：「皇綱失統，中夏多故，聖主肇祚，遠奉西都。梓宮外次，未反園陵，逆寇游魂，國賊未夷。明公憂勞，乃心王室，伏讀聖教，人懷慷慨。杜弢小豎，寇抄湘川，比年征討，經載不夷。昔高宗伐鬼方，三年乃克，用兵之難，非獨在今。伏以古今之霸王遭時艱難，亦有親征以隆大勳，亦有遣將以平小寇。今公親征，文武將吏、度支籌量、舟輿器械所出若足用者，然後可征。愚謂宜如前遣五千人，徑與水軍進征，既可得速，必不後時。昔齊用穰苴，燕晉退軍；秦用王翦，克平南荊。必使督護得才，即賊不足慮也。」會弢已平，轉從事中郎，累遷太子中庶子、尚書左丞、散騎常侍。帝每歎其忠公，謂曰：「卿在朝正色，不茹柔吐剛，忠亮至到，可為王臣也。吾所欣賴，卿其勉之！」","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":35,"last_line":35,"raw_start":2714,"raw_end":3043,"raw_character_offsets":[2714,2715,2716,2717,2718,2719,2720,2721,2722,2723,2724,2725,2726,2727,2728,2729,2730,2731,2732,2733,2734,2735,2736,2737,2738,2739,2740,2741,2742,2743,2744,2745,2746,2747,2748,2749,2750,2751,2752,2753,2754,2755,2756,2757,2758,2759,2760,2761,2762,2763,2764,2765,2766,2767,2768,2769,2770,2771,2772,2773,2774,2775,2776,2777,2778,2779,2780,2781,2782,2783,2784,2785,2786,2787,2788,2789,2790,2791,2792,2793,2794,2795,2796,2797,2798,2799,2800,2801,2802,2803,2804,2805,2806,2807,2808,2809,2810,2811,2812,2813,2814,2815,2816,2817,2818,2819,2820,2821,2822,2823,2824,2825,2826,2827,2828,2829,2830,2831,2832,2833,2834,2835,2836,2837,2838,2839,2840,2841,2842,2843,2844,2845,2846,2847,2848,2849,2850,2851,2852,2853,2854,2855,2856,2857,2858,2859,2860,2861,2862,2863,2864,2865,2866,2867,2868,2869,2870,2871,2872,2873,2874,2875,2876,2877,2878,2879,2880,2881,2882,2883,2884,2885,2886,2887,2888,2889,2890,2891,2892,2893,2894,2895,2896,2897,2898,2899,2