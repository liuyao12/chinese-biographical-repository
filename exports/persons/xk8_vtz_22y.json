"person_id":"39o_b6y_n74","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-zhang-guang:p006:m0087","surface":"光","start":87,"end":88,"person_id":"72h_bvx_bj5","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-zhang-guang:p006:m0151","surface":"敦","start":151,"end":152,"person_id":"39o_b6y_n74","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-057-zhang-guang","book_id":"b-jinshu-057","work_id":"w-jinshu","source_id":"s-jinshu-057-zhang-guang-ws2413329"},{"id":"c-jinshu-063-weigai:p003","text":"曜嘗攻李矩，該破之。及矩將迎郭默，該遣軍助之，又與河南尹任愔相連結。後漸饑弊，曜寇日至，欲率眾南徙，眾不從，該遂單騎走至南陽。帝又以為前鋒都督、平北將軍、雍州刺史。馬瞻率該餘眾降曜。曜徵發既苦，瞻又驕虐，部曲遣使呼該，該密往赴之，其眾殺瞻而納該。該遷於新野，率眾助周訪討平杜曾，詔以該為順陽太守。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":66,"last_line":66,"raw_start":5925,"raw_end":6075,"raw_character_offsets":[5927,5928,5929,5930,5931,5932,5933,5934,5935,5936,5937,5938,5939,5940,5941,5942,5943,5944,5945,5946,5947,5948,5949,5950,5951,5952,5953,5954,5955,5956,5957,5958,5959,5960,5961,5962,5963,5964,5965,5966,5967,5968,5969,5970,5971,5972,5973,5974,5975,5976,5977,5978,5979,5980,5981,5982,5983,5984,5985,5986,5987,5988,5989,5990,5991,5992,5993,5994,5995,5996,5997,5998,5999,6000,6001,6002,6003,6004,6005,6006,6007,6008,6009,6010,6011,6012,6013,6014,6015,6016,6017,6018,6019,6020,6021,6022,6023,6024,6025,6026,6027,6028,6029,6030,6031,6032,6033,6034,6035,6036,6037,6038,6039,6040,6041,6042,6043,6044,6045,6046,6047,6048,6049,6050,6051,6052,6053,6054,6055,6056,6057,6058,6059,6060,6061,6062,6063,6064,6065,6066,6067,6068,6069,6070,6071,6072,6073,6074],"revision_id":2025242},"mentions":[{"id":"c-jinshu-063-weigai:p003:m0000","surface":"曜","start":0,"end":1,"person_id":"fee_97f_681","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-063-weigai:p003:m0003","surface":"李矩","start":3,"end":5,"person_id":"tqt_mih_3ao","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-063-weigai:p003:m0006","