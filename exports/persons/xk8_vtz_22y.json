57-zhang-guang:p006:m0060","surface":"任愔","start":60,"end":62,"person_id":"xk8_vtz_22y","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-057-zhang-guang:p006","chapter_id":"c-jinshu-057-zhang-guang"},{"id":"c-jinshu-063-weigai:p003:m0028","surface":"任愔","start":28,"end":30,"person_id":"xk8_vtz_22y","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-063-weigai:p003","chapter_id":"c-jinshu-063-weigai"},{"id":"c-jinshu-098-jin033-wangji:line045:m0254","start":254,"end":256,"surface":"任愔","kind":"person","person_id":"xk8_vtz_22y","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line045","chapter_id":"c-jinshu-098-jin033-wangji"}],"relations":[],"title_holdings":[{"id":"th-w098-dun-main-4","person_id":"xk8_vtz_22y","title":"義陽太守","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-098","chapter_id":"c-jinshu-098-jin033-wangji","source_id":"s-jinshu-098-jin033-wangji","paragraph_id":"c-jinshu-098-jin033-wangji:line045","quote":"敦至石頭，欲攻劉隗，其將杜弘曰：「劉隗死士眾多，未易可克，不如攻石頭。周劄少恩，兵不為用，攻之必敗。劄敗，則隗自走。」敦從之。劄果開城門納弘。諸將與敦戰，王師敗績。既入石頭，擁兵不朝，放肆兵士劫掠內外。官省奔散，惟有侍中二人侍帝。帝脫戎衣，著朝服，顧而言曰：「欲得我處，但當早道，我自還琅邪，何至困百姓如此！」敦收周顗、戴若思害之。以敦為丞相、江州牧，進爵武昌郡公，邑萬戶，使太常荀崧就拜，又加羽葆鼓吹，並偽讓不受。還屯武昌，多害忠良，寵樹親戚，以兄含為衛將軍、都督沔南軍事、領南蠻校尉、荊州刺史，以義陽太守任愔督河北諸軍事、南中郎將，敦又自督寧、益二州。","person_mention_id":"c-jinshu-098-jin033-wangji:line045:m0254"}],"attestations":[{"id":"th-w043-dun-main-4:a","paragraph_id":"c-jinshu-098-jin033-wangji:line045","start":250,"end":254,"surface":"義陽太守","person_mention_id":"c-jinshu-098-jin033-wangji:line045:m0254","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"th-w098-dun-main-5","person_id":"xk8_vtz_22y","title":"南中郎將","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-098","chapter_id":"c-jinshu-098-jin033-wangji","source_id":"s-jinshu-098-jin033-wangji","paragraph_id":"c-jinshu-098-jin033-wangji:line045","quote":"敦至石頭，欲攻劉隗，其將杜弘曰：「劉隗死士眾多，未易可克，不如攻石頭。周劄少恩，兵不為用，攻之必敗。劄敗，則隗自走。」敦從之。劄果開城門納弘。諸將與敦戰，王師敗績。既入石頭，擁兵不朝，放肆兵士劫掠內外。官省奔散，惟有侍中二人侍帝。帝脫戎衣，著朝服，顧而言曰：「欲得我處，但當早道，我自還琅邪，何至困百姓如此！」敦收周顗、戴若思害之。以敦為丞相、江州牧，進爵武昌郡公，邑萬戶，使太常荀崧就拜，又加羽葆鼓吹，並偽讓不受。還屯武昌，多害忠良，寵樹親戚，以兄含為衛將軍、都督沔南軍事、領南蠻校尉、荊州刺史，以義陽太守任愔督河北諸軍事、南中郎將，敦又自督寧、益二州。","person_mention_id":"c-jinshu-098-jin033-wangji:line045:m0254"}],"attestations":[{"id":"th-w043-dun-main-5:a","paragraph_id":"c-jinshu-098-jin033-wangji:line045","start":263,"end":267,"surface":"南中郎將","person_mention_id":"c-jinshu-098-jin033-wangji:line045:m0254","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-057-zhang-guang:p006","text":"炅少辟太宰掾。邁多才略，有父風。州人推邁權領州事，與賊戰沒。別駕範曠及督護王喬奉光妻息，率其遺眾，還據魏興。其後義陽太守任愔為梁州，光妻子歸本郡。南平太守應詹白都督王敦，稱「光在梁州能興微繼絕，威振巴漢。值中原傾覆，征鎮失守，外無救助，內闕資儲，以寡敵眾，經年抗禦，厲節不撓，宜應追論顯贈，以慰存亡」。敦不能從。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":90,"last_line":90,"raw_start":7450,"raw_end":7606,"raw_character_offsets":[7450,7451,7452,7453,7454,7455,7456,7457,7458,7459,7460,7461,7462,7463,7464,7465,7466,7467,7468,7469,7470,7471,7472,7473,7474,7475,7476,7477,7478,7479,7480,7481,7482,7483,7484,7485,7486,7487,7488,7489,7490,7491,7492,7493,7494,7495,7496,7497,7498,7499,7500,7501,7502,7503,7504,7505,7506,7507,