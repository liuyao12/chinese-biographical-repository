ree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-098-jin033-wangji:line045:m0254","start":254,"end":256,"surface":"任愔","kind":"person","person_id":"xk8_vtz_22y","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line045","chapter_id":"c-jinshu-098-jin033-wangji"}],"relations":[],"title_holdings":[{"id":"th-w098-dun-main-4","person_id":"xk8_vtz_22y","title":"義陽太守","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-098","chapter_id":"c-jinshu-098-jin033-wangji","source_id":"s-jinshu-098-jin033-wangji","paragraph_id":"c-jinshu-098-jin033-wangji:line045","quote":"敦至石頭，欲攻劉隗，其將杜弘曰：「劉隗死士眾多，未易可克，不如攻石頭。周劄少恩，兵不為用，攻之必敗。劄敗，則隗自走。」敦從之。劄果開城門納弘。諸將與敦戰，王師敗績。既入石頭，擁兵不朝，放肆兵士劫掠內外。官省奔散，惟有侍中二人侍帝。帝脫戎衣，著朝服，顧而言曰：「欲得我處，但當早道，我自還琅邪，何至困百姓如此！」敦收周顗、戴若思害之。以敦為丞相、江州牧，進爵武昌郡公，邑萬戶，使太常荀崧就拜，又加羽葆鼓吹，並偽讓不受。還屯武昌，多害忠良，寵樹親戚，以兄含為衛將軍、都督沔南軍事、領南蠻校尉、荊州刺史，以義陽太守任愔督河北諸軍事、南中郎將，敦又自督寧、益二州。","person_mention_id":"c-jinshu-098-jin033-wangji:line045:m0254"}],"attestations":[{"id":"th-w043-dun-main-4:a","paragraph_id":"c-jinshu-098-jin033-wangji:line045","start":250,"end":254,"surface":"義陽太守","person_mention_id":"c-jinshu-098-jin033-wangji:line045:m0254","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"th-w098-dun-main-5","person_id":"xk8_vtz_22y","title":"南中郎將","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-098","chapter_id":"c-jinshu-098-jin033-wangji","source_id":"s-jinshu-098-jin033-wangji","paragraph_id":"c-jinshu-098-jin033-wangji:line045","quote":"敦至石頭，欲攻劉隗，其