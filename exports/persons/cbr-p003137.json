22-0039","start":39,"end":41,"surface":"栗姬","kind":"person","person_id":"cbr-p003137","status":"contextual_provisional","paragraph_id":"c-shiji-049-waiqi:p022","chapter_id":"c-shiji-049-waiqi"},{"id":"c-shiji-049-waiqi:m022-0054","start":54,"end":56,"surface":"栗姬","kind":"person","person_id":"cbr-p003137","status":"contextual_provisional","paragraph_id":"c-shiji-049-waiqi:p022","chapter_id":"c-shiji-049-waiqi"},{"id":"c-shiji-049-waiqi:m022-0124","start":124,"end":126,"surface":"栗姬","kind":"person","person_id":"cbr-p003137","status":"contextual_provisional","paragraph_id":"c-shiji-049-waiqi:p022","chapter_id":"c-shiji-049-waiqi"}],"relations":[{"id":"a-shiji049-027","subject_person_id":"cbr-p003136","predicate":"mother","object_person_id":"cbr-p003137","status":"source_attested","evidence":[{"chapter_id":"c-shiji-049-waiqi","source_id":"s-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p020","quote":"景帝長男榮，其母栗姬。栗姬，齊人也。立榮為太子。長公主嫖有女，欲予為妃。栗姬妒，而景帝諸美人皆因長公主見景帝，得貴幸，皆過栗姬，栗姬日怨怒，謝長公主，不許。長公主欲予王夫人，王夫人許之。長公主怒，而日讒栗姬短於景帝曰：「栗姬與諸貴夫人幸姬會，常使侍者祝唾其背，挾邪媚道。」景帝以故望之。"}],"qualifiers":{"source_term":"其母栗姬","historicity":"historical_tradition"},"interpretation_note":"按明示子女、生、母、兄弟姊及婚姻的局部敘事保存；祖孫不作父子，不補未名者姓名。衛青子數各層原語並存，親屬判讀不代表數量已核定。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji049-089","person_id":"cbr-p003137","surfaces":["栗姬"],"scope":"same_chapter","chapter_ids":["c-shiji-049-waiqi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-049-waiqi:p020","quote":"景帝長男榮，其母栗姬。栗姬，齊人也。立榮為太子。長公主嫖有女，欲予為妃。栗姬妒，而景帝諸美人皆因長公主見景帝，得貴幸，皆過栗姬，栗姬日怨怒，謝長公主，不許。長公主欲予王夫人，王夫人許之。長公主怒，而日讒栗姬短於景帝曰：「栗姬與諸貴夫人幸姬會，常使侍者祝唾其背，挾邪媚道。」景帝以故望之。"},{"paragraph_id":"c-shiji-049-waiqi:p021","quote":"景帝嘗體不安，心不樂，屬諸子為王者於栗姬，曰：「百歲後，善視之。」栗姬怒，不肯應，言不遜。景帝恚，心嗛之而未發也。"},{"paragraph_id":"c-shiji-049-waiqi:p022","quote":"長公主日譽王夫人男之美，景帝亦賢之，又有曩者所夢日符，計未有所定。王夫人知帝望栗姬，因怒未解，陰使人趣大臣立栗姬為皇后。大行奏事畢，曰：「『子以母貴，母以子貴』，今太子母無號，宜立為皇后。」景帝怒曰：「是而所宜言邪！」遂案誅大行，而廢太子為臨江王。栗姬愈恚恨，不得見，以憂死。卒立王夫人為皇后，其男為太子，封皇后兄信為蓋侯。"}],"rationale":"按明示名、字及各帝后局部親屬敘事暫接；王夫人分景帝皇后與武帝趙妃，代王分文帝與後來少子武。未名者不補姓名，褚氏附載另留原語。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-049-waiqi:p020","text":"景帝長男榮，其母栗姬。栗姬，齊人也。立榮為太子。長公主嫖有女，欲予為妃。栗姬妒，而景帝諸美人皆因長公主見景帝，得貴幸，皆過栗姬，栗姬日怨怒，謝長公主，不許。長公主欲予王夫人，王夫人許之。長公主怒，而日讒栗姬短於景帝曰：「栗姬與諸貴夫人幸姬會，常使侍者祝唾其背，挾邪媚道。」景帝以故望之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-049-waiqi:m020-0000","start":0,"end":2,"surface":"景帝","kind":"person","person_id":"cbr-p003061","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m020-0004","start":4,"end":5,"surface":"榮","kind":"person","person_id":"cbr-p003136","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m020-0008","start":8,"end":10,"surface":"栗姬","kind":"person","person_id":"cbr-p003137","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m020-0011","start":11,"end":13,"surface":"栗姬","kind":"person","person_id":"cbr-p003137","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m020-0019","start":19,"end":20,"surface":"榮","kind":"person","person_id":"cbr-p003136","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m020-0024","start":24,"end":28,"surface":"長公主嫖","kind":"person","person_id":"cbr-p003090","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m020-0036","start":36,"end":38,"surface":"栗姬","kind":"person","person_id":"cbr-p003137","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m020-0041","start":41,"end":43,"surface":"景帝","kind":"person","person_id":"cbr-p003061","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m020-0043","start":43,"end":46,"surface":"諸美人","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、集體、制度稱號或待核短稱；不補姓名或年表。"},{"id":"c-shiji-049-waiqi:m020-0048","start":48,"end":51,"surface":"長公主","kind":"person","person_id":"cbr-p003090","status":"contextual_provisional"},{"id":"c-shiji-049