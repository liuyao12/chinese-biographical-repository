{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"0q2_ioh_psy","canonical_person_id":"0q2_ioh_psy","id_aliases":["cbr-p002408"],"identity_policy":"contextual_provisional","person_ids":["0q2_ioh_psy"],"persons":[{"id":"0q2_ioh_psy","label":"周袑（趙世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"周袑","mention_ids":["c-shiji-043-zhao:m071-0006","c-shiji-043-zhao:m073-0116"]}],"evidence":[{"mention_id":"c-shiji-043-zhao:m071-0006","chapter_id":"c-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p071","quote":"周袑"},{"mention_id":"c-shiji-043-zhao:m073-0116","chapter_id":"c-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p073","quote":"周袑"}],"id_aliases":["cbr-p002408"]}],"source_mention_summary":[{"source_id":"s-shiji-043-zhao","work_id":"w-shiji","book_id":"b-shiji-043","chapter_id":"c-shiji-043-zhao","mention_count":2,"mention_ids":["c-shiji-043-zhao:m071-0006","c-shiji-043-zhao:m073-0116"],"paragraph_ids":["c-shiji-043-zhao:p071","c-shiji-043-zhao:p073"],"passage_count":2}],"most_mentioned_source_ids":["s-shiji-043-zhao"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-043-zhao:m071-0006","start":6,"end":8,"surface":"周袑","kind":"person","person_id":"0q2_ioh_psy","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p071","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m073-0116","start":116,"end":118,"surface":"周袑","kind":"person","person_id":"0q2_ioh_psy","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p073","chapter_id":"c-shiji-043-zhao"}],"relations":[],"title_holdings":[{"id":"th-shiji043-055","person_id":"0q2_ioh_psy","title":"傅","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-043-zhao","source_id":"s-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p073","quote":"二十一年，攻中山。趙袑爲右軍，許鈞爲左軍，公子章爲中軍，王并將之。牛翦將車騎，趙希并將胡、代。趙與之陘，合軍曲陽，攻取丹丘、華陽、鴟之塞。王軍取鄗、石邑、封龍、東垣。中山獻四邑和，王許之，罷兵。二十三年，攻中山。二十五年，惠后卒。使周袑胡服傅王子何。二十六年，復攻中山，攘地北至燕、代，西至雲中、九原。"}],"attestations":[{"id":"th-shiji043-055:a001","paragraph_id":"c-shiji-043-zhao:p073","start":120,"end":121,"surface":"傅","person_mention_id":"c-shiji-043-zhao:m073-0116","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"明示授予、自號及廢太子與敘事用稱分開；分趙而王章的未決計畫不是授予。死亡與傳國不推所有官爵終點，回敘太子不補曆日。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji043-179","person_id":"0q2_ioh_psy","surfaces":["周袑"],"scope":"same_chapter","chapter_ids":["c-shiji-043-zhao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-043-zhao:p071","quote":"趙文、趙造、周袑、趙俊皆諫止王毋胡服，如故法便。王曰：「先王不同俗，何古之法？帝王不相襲，何禮之循？虙戲、神農教而不誅，黃帝、堯、舜誅而不怒。及至三王，隨時制法，因事制禮。法度制令各順其宜，衣服器械各便其用。故禮也不必一道，而便國不必古。聖人之興也不相襲而王，夏、殷之衰也不易禮而滅。然則反古未可非，而循禮未足多也。且服奇者志淫，則是鄒、魯無奇行也；俗辟者民易，則是吳、越無秀士也。且聖人利身謂之服，便事謂之禮。夫進退之節，衣服之制者，所以齊常民也，非所以論賢者也。故齊民與俗流，賢者與變倶。故諺曰『以書御者不盡馬之情，以古制今者不達事之變』。循法之功，不足以髙世；法古之學，不足以制今。子不及也。」遂胡服招騎射。"},{"paragraph_id":"c-shiji-043-zhao:p073","quote":"二十一年，攻中山。趙袑爲右軍，許鈞爲左軍，公子章爲中軍，王并將之。牛翦將車騎，趙希并將胡、代。趙與之陘，合軍曲陽，攻取丹丘、華陽、鴟之塞。王軍取鄗、石邑、封龍、東垣。中山獻四邑和，王許之，罷兵。二十三年，攻中山。二十五年，惠后卒。使周袑胡服傅王子何。二十六年，復攻中山，攘地北至燕、代，西至雲中、九原。"}],"rationale":"限本篇人物、連續政治事件及明示生子是為敘事；武靈王／主父、王子何／惠文王及惠后吳娃按本文連接。公子章不與早期敬侯章合併，何不與較早趙何合併；髙信與信期、趙袑與周袑分候選。王賁不按熟知秦將同名接人。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-043-zhao:p071","text":"趙文、趙造、周袑、趙俊皆諫止王毋胡服，如故法便。王曰：「先王不同俗，何古之法？帝王不相襲，何禮之循？虙戲、神農教而不誅，黃帝、堯、舜誅而不怒。及至三王，隨時制法，因事制禮。法度制令各順其宜，衣服器械各便其用。故禮也不必一道，而便國不必古。聖人之興也不相襲而王，夏、殷之衰也不易禮而滅。然則反古未可非，而循禮未足多也。且服奇者志淫，則是鄒、魯無奇行也；俗辟者民易，則是吳、越無秀士也。且聖人利身謂之服，便事謂之禮。夫進退之節，衣服之制者，所以齊常民也，非所以論賢者也。故齊民與俗流，賢者與變倶。故諺曰『以書御者不盡馬之情，以古制今者不達事之變』。循法之功，不足以髙世；法古之學，不足以制今。子不及也。」遂胡服招騎射。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-043-zhao:m071-0000","start":0,"end":2,"surface":"趙文","kind":"person","person_id":"ue1_qha_ehn","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m071-0003","start":3,"end":5,"surface":"趙造","kind":"person","person_id":"bfv_clh_n6y","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m071-0006","start":6,"end":8,"surface":"周袑","kind":"person","person_id":"0q2_ioh_psy","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m071-0009","start":9,"end":11,"surface":"趙俊","kind":"person","person_id":"ybw_y4h_z69","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m071-0014","start":14,"end":15,"surface":"王","kind":"person","person_id":"txj_z8z_5me_A","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m071-0024","start":24,"end":25,"surface":"王","kind":"person","person_id":"txj_z8z_5me_A","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m071-0028","start":28,"end":30,"surface":"先王","kind":"unresolved","person_id":null,"status":"unresolved","note":"先王泛稱，不連當前武靈王。"},{"id":"c-shiji-043-zhao:m071-0039","start":39,"end":41,"surface":"帝王","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、代詞、未名君主或版本疑字保留；不把帝王泛稱、父子群體與未決分封當已確證身份或任期。"},{"id":"c-shiji-043-zhao:m071-0050","start":50,"end":52,"surface":"虙戲","kind":"person","person_id":"xop_byp_p7d","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m071-0053","start":53,"end":55,"surface":"神農","kind":"person","person_id":"0rm_hvx_4a6","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m071-0060","start":60,"end":62,"surface":"黃帝","kind":"person","person_id":"mnl_v