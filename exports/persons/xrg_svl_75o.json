raph_id":"c-nanqishu-049-wanghuan-complete:p003","start":128,"end":129,"surface":"母","person_id":"xrg_svl_75o","referent_role":"third_person","quote":"晏父母在都","note":"依句內語法、說話對象及本段承接辨識。","chapter_id":"c-nanqishu-049-wanghuan-complete","book_id":"b-nanqishu-049","work_id":"w-nanqishu","source_id":"s-nanqishu-049-wanghuan-complete-ws2261984"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-049-wanghuan-complete:p003","text":"昇明初，遷冠軍將軍、丹陽尹。初，王晏父普曜爲沈攸之長史，常慮攸之舉事，不得還。時奐爲吏部，轉普曜爲內職，晏深德之。及晏仕世祖府，奐從弟蘊反，世祖謂晏曰：「王奐宋家外戚，王蘊親同逆黨，旣其羣從，豈能無異意。我欲具以啓聞。」晏叩頭曰：「王奐脩謹，保無異志。晏父母在都，請以爲質。」世祖乃止。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":15,"last_line":15,"raw_start":341,"raw_end":484,"raw_character_offsets":[341,342,343,344,345,346,347,348,349,350,351,352,353,354,355,356,357,358,359,360,361,362,363,364,365,366,367,368,369,370,371,372,373,374,375,376,377,378,379,380,381,382,383,384,385,386,387,388,389,390,391,392,393,394,395,396,397,398,399,400,401,402,403,404,405,406,407,408,409,410,411,412,413,414,415,416,417,418,419,420,421,422,423,424,425,426,427,428,429,430,431,432,433,434,435,436,437,438,439,440,441,442,443,444,445,446,447,448,449,450,451,452,453,454,455,456,457,458,459,460,461,462,463,464,465,466,467,468,469,470,471,472,473,474,475,476,477,478,479,480,481,482,483],"revision_id":2261984},"mentions":[{"id":"c-nanqishu-049-wanghuan-complete:p003:m0016","start":16,"end":18,"surface":"王晏","kind":"person","person_id":"i08_s4b_5bb","status":"contextual_provisional"},{"id":"c-nanqishu-049-wanghuan-complete:p003:m0019","start":19,"end":21,"surface":"普曜","kind":"person","person_id":"7r6_k52_qji_ABDACABB","status":"contextual_provisional"},{"id":"c-nanqishu-049-wanghuan-complete:p003:m0022","start":22,"end":25,"surface":"沈攸之","kind":"person","person_id":"16c_0og_lvl_A","status":"contextual_provisional"}