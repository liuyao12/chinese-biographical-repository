izations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-032-qi:p071","text":"四十八年，與魯定公好會夾谷。犁鉏曰：「孔丘知禮而怯，請令萊人為樂，因執魯君，可得志。」景公害孔丘相魯，懼其霸，故從犁鉏之計。方會，進萊樂，孔子歷階上，使有司執萊人斬之，以禮讓景公。景公慚，乃歸魯侵地以謝，而罷去。是歲，晏嬰卒。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-032-qi:m071-0006","start":6,"end":9,"surface":"魯定公","kind":"person","person_id":"ath_xsq_n4i","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m071-0014","start":14,"end":16,"surface":"犁鉏","kind":"person","person_id":"35b_1t3_p8s","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m071-0019","start":19,"end":21,"surface":"孔丘","kind":"person","person_id":"fp6_ia6_7yw","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m071-0028","start":28,"end":30,"surface":"萊人","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、族稱或未定指代；齊秉意茲等疑讀待版本校勘，不補熟知姓名。"},{"id":"c-shiji-032-qi:m071-0035","start":35,"end":37,"surface":"魯君","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、族稱或未定指代；齊秉意茲等疑讀待版本校勘，不補熟知姓名。"},{"id":"c-shiji-032-qi:m071-0043","start":43,"end":45,"surface":"景公","kind":"person","person_id":"wuz_yxe_b9k","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m071-0046","start":46,"end":48,"surface":"孔丘","kind":"person","person_id":"fp6_ia6_7yw","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m071-0057","start":57,"end":59,"surface":"犁鉏","kind":"person","person_id":"35b_1t3_p8s","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m071-0069","start":69,"end":71,"surface":"孔子","kind":"person","person_id":"fp6_ia6_7yw","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m071-0079","start":79,"end":81,"surface":"萊人","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、族稱或未定指代；齊秉意茲等疑讀待版本校勘，不補熟知姓名。"},{"id":"c-shiji-032-qi:m071-0087","start":87,"end":89,"surface":"景公","kind":"pers