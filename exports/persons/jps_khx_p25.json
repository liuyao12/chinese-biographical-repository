008-0000","start":0,"end":2,"surface":"吳起","kind":"person","person_id":"61h_0sk_4pb","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m008-0005","start":5,"end":8,"surface":"魏文侯","kind":"person","person_id":"p9l_wy7_y7m","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m008-0014","start":14,"end":16,"surface":"文侯","kind":"person","person_id":"p9l_wy7_y7m","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m008-0017","start":17,"end":19,"surface":"李克","kind":"person","person_id":"jps_khx_p25","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m008-0022","start":22,"end":24,"surface":"吳起","kind":"person","person_id":"61h_0sk_4pb","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m008-0030","start":30,"end":32,"surface":"李克","kind":"person","person_id":"jps_khx_p25","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m008-0035","start":35,"end":36,"surface":"起","kind":"person","person_id":"61h_0sk_4pb","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m008-0044","start":44,"end":48,"surface":"司馬穰苴","kind":"person","person_id":"jaw_b0s_ujn","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m008-0056","start":56,"end":59,"surface":"魏文侯","kind":"person","person_id":"p9l_wy7_y7m","status":"contextual_provisional"}],"chapter_id":"c-shiji-065-sun","book_id":"b-shiji-065","work_id":"w-shiji","source_id":"s-shiji-065-sun"},{"id":"c-shiji-129-huozhi:p009","text":"白圭，周人也。當魏文侯時，李克務盡地力，而白圭樂觀時變，故人棄我取，人取我與。夫歲孰取穀，予之絲漆；繭出取帛絮，予之食。太陰在卯，穰；明歲衰惡。至午，旱；明歲美。至酉，穰；明歲衰惡。至子，大旱；明歲美，有水。至卯，積著率歲倍。欲長錢，取下穀；長石斗，取上種。能薄飲食，忍嗜欲，節衣服，與用事僮仆同苦樂，趨時若猛獸摯鳥之發。故曰：「吾治生產，猶伊尹、呂尚之謀，孫吳用兵，商鞅行法是也。是故其智不足與權變，勇不足以決斷，仁不能以取予，彊不能有所守，雖欲學吾術，終不告之矣。」蓋天下言治生祖白圭。白圭其有所試矣，能試有所長，非茍而已也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-129-huozhi:m009-0000","start":0,"end":2,"surface":"白圭","kind":"person","person_id":"evw_7hk_sqo","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m009-0008","start":8,"end":11,"surface":"魏文侯","kind":"person","person_id":"nxl_qt6_cpl_AAAAAA*A*A","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m009-0013","start":13,"end":15,"surface":"李克","kind":"person","person_id":"jps_khx_p25","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m009-0021","start":21,"end":23,"surface":"白圭","kind":"person","person_id":"evw_7hk_sqo","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m009-0171","start":171,"end":173,"surface":"伊尹","kind":"person","person_id":"itn_zi2_il4","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m009-0174","start":174,"end":176,"surface":"呂尚","kind":"person","person_id":"1g3_02y_oor","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m009-0179","start":179,"end":180,"surface":"孫","kind":"person","person_id":"vax_w2r_0za","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m009-0180","start":180,"end":181,"surface":"吳","kind":"person","person_id":"61h_0sk_4pb","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m009-0184","start":184,"end":186,"surface":"商鞅","kind":"person","person_id":"2wp_usr_ncd","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m009-0242","start":242,"end":244,"surface":"白圭","kind":"person","person_id":"evw_7hk_sqo","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m009-0245","start":245,"end":247,"surface":"白圭","kind":"person","person_id":"evw_7hk_sqo","status":"contextual_provisional"}],"chapter_id":"c-shiji-129-huozhi","book_id":"b-shiji-129","work_id":"w-shiji","source_id":"s-shiji129-huozhi"}],"table_passages":[{"id":"shiji-015-r072-c03","column":3,"rowspan":1,"colspan":1,"text":"二十。卜相，李克、翟璜爭。","source_row":73,"source_column":4,"printed_page":null,"person_mentions":[{"id":"shiji-015-r072-c03-m006","start":6,"end":8,"surface":"李克","person_id":"jps_khx_p25","status":"contextual_provisional","interpretation_note":"依國別、紀年及原格上下文暫定；保留異文，不據同名自動合併。"},{"id":"shiji-015-r072-c03-m009","start":9,"end":11,"surface":"翟璜","person_id":"z1v_bog_yo6