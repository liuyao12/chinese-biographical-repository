,"paragraph_id":"c-shiji-004-zhou:p042","chapter_id":"c-shiji-004-zhou"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-004-zhou:p042","text":"幽王以虢石父為卿，用事，國人皆怨。石父為人佞巧善諛好利，王用之。又廢申后，去太子也。申侯怒，與繒、西夷犬戎攻幽王。幽王舉烽火徵兵，兵莫至。遂殺幽王驪山下，虜褒姒，盡取周賂而去。於是諸侯乃即申侯而共立故幽王太子宜臼，是為平王，以奉周祀。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-004-zhou:m042-0000","start":0,"end":2,"surface":"幽王","kind":"person","person_id":"fd5_uxa_0c9","status":"source_identified"},{"id":"c-shiji-004-zhou:m042-0003","start":3,"end":6,"surface":"虢石父","kind":"person","person_id":"6o1_fcy_vcy","status":"source_identified"},{"id":"c-shiji-004-zhou:m042-0017","start":17,"end":19,"surface":"石父","kind":"person","person_id":"6o1_fcy_vcy","status":"source_identified"},{"id":"c-shiji-004-zhou:m042-0034","start":34,"end":36,"surface":"申后","kind":"person","person_id":"wft_r8s_naw","status":"source_identified"},{"id":"c-shiji-004-zhou:m042-0042","start":42,"end":44,"surface":"申侯","kind":"person","person_id":"1ag_0z1_mlq","status":"source_identified"},{"id":"c-shiji-004-zhou:m042-0054","start":54,"end":56,"surface":"幽王","kind":"person","person_id":"fd5_uxa_0c9","status":"source_identified"},{"id":"c-shiji-004-zhou:m042-0057","start":57,"end":59,"surface":"幽王","kind":"person","person_id":"fd5_uxa_0c9","status":"source_identified"},{"id":"c-shiji-004-zhou:m042-0071","start":71,"end":73,"surface":"幽王","kind":"person","person_id":"fd5_uxa_0c9","status":"source_identified"},{"id":"c-shiji-004-zhou:m042-0078","start":78,"end":80,"surface":"褒姒","kind":"person","person_id":"rkn_3l3_3j3","status":"source_identified"},{"id":"c-shiji-004-zhou:m042-0094","start":94,"end":96,"surface":"申侯","kind":"person","person_id":"1ag_0z1_mlq","status":"source_identified"},{"id":"c-shiji-004-zhou:m042-0100","start":100,"end":102,"surface":"幽王","kind