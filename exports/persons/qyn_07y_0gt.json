7,"end":229,"surface":"曹丘","kind":"person","person_id":"tnc_ag2_eej","status":"contextual_provisional"}],"chapter_id":"c-shiji-100-jibu","book_id":"b-shiji-100","work_id":"w-shiji","source_id":"s-shiji-100-jibu"},{"id":"c-shiji-101-yuanchao:p006","text":"袁盎常引大體慨。宦者趙同以數幸，常害袁盎，袁盎患之。盎兄子種為常侍騎，持節夾乘，說盎曰：「君與鬬，廷辱之，使其毀不用。」孝文帝出，趙同參乘，袁盎伏車前曰：「臣聞天子所與共六尺輿者，皆天下豪英。今漢雖乏人，陛下獨奈何與刀鋸餘人載！」於是上笑，下趙同。趙同泣下車。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-101-yuanchao:m006-0000","start":0,"end":2,"surface":"袁盎","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m006-0010","start":10,"end":12,"surface":"趙同","kind":"person","person_id":"qyn_07y_0gt","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m006-0018","start":18,"end":20,"surface":"袁盎","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m006-0021","start":21,"end":23,"surface":"袁盎","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m006-0026","start":26,"end":27,"surface":"盎","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m006-0029","start":29,"end":30,"surface":"種","kind":"person","person_id":"c6v_07v_vxz","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m006-0041","start":41,"end":42,"surface":"盎","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m006-0060","start":60,"end":63,"surface":"孝文帝","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m006-0065","start":65,"end":67,"surface":"趙同","kind":"person","person_id":"qyn_07y_0gt","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m006-0070","start":70,"end":72,"surface":"袁盎","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m006-0117","start":117,"end":118,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m006-0121","start":121,"end":123,"surface":"趙同","kind":"person","person_id":"qyn_07y_0gt","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m006-0124","start":124,"end":126,"surface":"趙同","kind":"person","person_id":"qyn_07y_0gt","status":"contextual_provisional"}],"chapter_id":"c-shiji-101-yuanchao","book_id":"b-shiji-101","work_id":"w-shiji","source_id":"s-shiji-101-yuanchao"},{"id":"c-shiji-125-ningxing:p001","text":"諺曰「力田不如逢年，善仕不如遇合」，固無虛言。非獨女以色媚，而士宦亦有之。昔以色幸者多矣。至漢興，高祖至暴抗也，然籍孺以佞幸；孝惠時有閎孺。此兩人非有材能，徒以婉佞貴幸，與上臥起，公卿皆因關說。故孝惠時郎侍中皆冠鵕䴊，貝帶，傅脂粉，化閎、籍之屬也。兩人徙家安陵。孝文時中寵臣，士人則鄧通，宦者則趙同、北宮伯子。北宮伯子以愛人長者；而趙同以星氣幸，常為文帝參乘；鄧通無伎能。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-125-ningxing:m001-0049","start":49,"end":51,"surface":"高祖","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m001-0057","start":57,"end":59,"surface":"籍孺","kind":"person","person_id":"wbf_66x_6s2","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m001-0063","start":63,"end":65,"surface":"孝惠","kind":"person","person_id":"yqp_nlb_p1p_AA","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m001-0067","start":67,"end":69,"surface":"閎孺","kind":"person","person_id":"nxn_szf_9gi","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m001-0085","start":85,"end":89,"surface":"與上臥起","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-125-ningxing:m001-0098","start":98,"end":100,"surface":"孝惠","kind":"person","person_id":"yqp_nlb_p1p_AA","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m001-0117","start":117,"end":118,"surface":"閎","kind":"person","person_id":"nxn_szf_9gi","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m001-0119","start":119,"end":120,"