iji-101-yuanchao:m006-0124","start":124,"end":126,"surface":"趙同","kind":"person","person_id":"qyn_07y_0gt","status":"contextual_provisional","paragraph_id":"c-shiji-101-yuanchao:p006","chapter_id":"c-shiji-101-yuanchao"},{"id":"c-shiji-125-ningxing:m001-0147","start":147,"end":149,"surface":"趙同","kind":"person","person_id":"qyn_07y_0gt","status":"contextual_provisional","paragraph_id":"c-shiji-125-ningxing:p001","chapter_id":"c-shiji-125-ningxing"},{"id":"c-shiji-125-ningxing:m001-0166","start":166,"end":168,"surface":"趙同","kind":"person","person_id":"qyn_07y_0gt","status":"contextual_provisional","paragraph_id":"c-shiji-125-ningxing:p001","chapter_id":"c-shiji-125-ningxing"}],"relations":[],"title_holdings":[{"id":"th-shiji101-011","person_id":"qyn_07y_0gt","title":"宦者","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-101-yuanchao","source_id":"s-shiji-101-yuanchao","paragraph_id":"c-shiji-101-yuanchao:p006","quote":"袁盎常引大體慨。宦者趙同以數幸，常害袁盎，袁盎患之。盎兄子種為常侍騎，持節夾乘，說盎曰：「君與鬬，廷辱之，使其毀不用。」孝文帝出，趙同參乘，袁盎伏車前曰：「臣聞天子所與共六尺輿者，皆天下豪英。今漢雖乏人，陛下獨奈何與刀鋸餘人載！」於是上笑，下趙同。趙同泣下車。"}],"attestations":[{"id":"th-shiji101-011:a001","paragraph_id":"c-shiji-101-yuanchao:p006","start":8,"end":10,"surface":"宦者","person_mention_id":"c-shiji-101-yuanchao:m006-0010","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"實授、任事、敘事用稱與先前官職分存。欲使將而不肯不作已任，九卿只記類別，智囊為稱號，死亡不自動終止官爵。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji100-018","person_id":"qyn_07y_0gt","surfaces":["趙同"],"scope":"cross_chapter","chapter_ids":["c-shiji-100-jibu","c-shiji-101-yuanchao","c-shiji-125-ningxing"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-100-jibu","source_id":"s-shiji-100-jibu","paragraph_id":"c-shiji-100-jibu:p004","quote":"楚人曹丘生，辯士，數招權顧金錢。事貴人趙同等，與竇長君善。季布聞之，寄書諫竇長君曰：「吾聞曹丘生非長者，勿與通。」及曹丘生歸，欲得書請季布。竇長君曰：「季將軍不説足下，足下無往。」固請書，遂行。使人先發書，季布果大怒，待曹丘。曹丘至，即揖季布曰：「楚人諺曰『得黃金百（斤），不如得季布一諾』，足下何以得此聲於梁楚閒哉？且仆楚人，足下亦楚人也。仆游揚足下之名於天下，顧不重邪？何足下距仆之深也！」季布乃大説，引入，留數月，爲上客，厚送之。季布名所以益聞者，曹丘揚之也。","mention_ids":["c-shiji-100-jibu:m004-0019"]},{"chapter_id":"c-shiji-101-yuanchao","source_id":"s-shiji-101-yuanchao","paragraph_id":"c-shiji-101-yuanchao:p006","quote":"袁盎常引大體慨。宦者趙同以數幸，常害袁盎，袁盎患之。盎兄子種為常侍騎，持節夾乘，說盎曰：「君與鬬，廷辱之，使其毀不用。」孝文帝出，趙同參乘，袁盎伏車前曰：「臣聞天子所與共六尺輿者，皆天下豪英。今漢雖乏人，陛下獨奈何與刀鋸餘人載！」於是上笑，下趙同。趙同泣下車。","mention_ids":["c-shiji-101-yuanchao:m006-0010","c-shiji-101-yuanchao:m006-0065","c-shiji-101-yuanchao:m006-0121","c-shiji-101-yuanchao:m006-0124"]},{"chapter_id":"c-shiji-125-ningxing","source_id":"s-shiji125-ningxing","paragraph_id":"c-shiji-125-ningxing:p001","quote":"諺曰「力田不如逢年，善仕不如遇合」，固無虛言。非獨女以色媚，而士宦亦有之。昔以色幸者多矣。至漢興，高祖至暴抗也，然籍孺以佞幸；孝惠時有閎孺。此兩人非有材能，徒以婉佞貴幸，與上臥起，公卿皆因關說。故孝惠時郎侍中皆冠鵕䴊，貝帶，傅脂粉，化閎、籍之屬也。兩人徙家安陵。孝文時中寵臣，士人則鄧通，宦者則趙同、北宮伯子。北宮伯子以愛人長者；而趙同以星氣幸，常為文帝參乘；鄧通無伎能。","mention_ids":["c-shiji-125-ningxing:m001-0147","c-shiji-125-ningxing:m001-0166"]}],"rationale":"袁盎篇與佞幸篇均明示孝文時宦者趙同為參乘；季布篇曹丘生所事趙同，對讀漢書同一曹丘段趙談及李奇明解宦者趙談，與徐廣所記避諱異名相合。只接漢文帝朝此人，不與春秋趙同合。 原詞、引文與錨點分存，同書互見不作獨立史實票數；未核書影。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"references":[{"title":"《漢書》卷三十七·曹丘生事趙談·李奇注","commentator":"李奇","quote":"宦者趙談也","url":"https://github.com/kanripo/KR2a0007/blob/683113d4baf6febecaf2ccb7913df87c4d68d454/KR2a0007_037.txt","source_kind":"received_ancient_commentary","witness_commit":"683113d4baf6febecaf2ccb7913df87c4d68d454","page_id":"KR2a0007_WYG_037-3b","witness_sha256":"59ecdbc05321c32c68c4cc4d4287b5c5f9b2f61f8bc5ae5a47df6c5bfd09b64c","verification_scope":"specified_digital_quote_only","image_verified":false},{"title":"《史記三家註》卷一百·趙同·集解","commentator":"徐廣","quote":"《漢書》作『趙談』，司馬遷以其父名談，故改之。","url":"https://zh.wikisource.org/w/index.php?title=史記三家註/卷100&oldid=2514770","source_kind":"receive