{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003493","identity_policy":"contextual_provisional","person_ids":["cbr-p003493"],"persons":[{"id":"cbr-p003493","label":"勳（絳侯周勃世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"勳","mention_ids":["c-shiji-057-zhou:m005-0062"]}],"evidence":[{"mention_id":"c-shiji-057-zhou:m005-0062","chapter_id":"c-shiji-057-zhou","paragraph_id":"c-shiji-057-zhou:p005","quote":"勳"}]}],"mentions":[{"id":"c-shiji-057-zhou:m005-0062","start":62,"end":63,"surface":"勳","kind":"person","person_id":"cbr-p003493","status":"contextual_provisional","paragraph_id":"c-shiji-057-zhou:p005","chapter_id":"c-shiji-057-zhou"}],"relations":[],"title_holdings":[{"id":"th-shiji057-025","person_id":"cbr-p003493","title":"將","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-057-zhou","source_id":"s-shiji-057-zhou","paragraph_id":"c-shiji-057-zhou:p005","quote":"擊陳豨，屠馬邑。所將卒斬豨將軍乘馬絺。擊韓信、陳豨、趙利軍於樓煩，破之。得豨將宋最、鴈門守圂。因轉攻得雲中守遬、丞相箕肆、將勳。定鴈門郡十七縣，雲中郡十二縣。因復擊豨靈丘，破之，斬豨，得豨丞相程縱、將軍陳武、都尉高肆。定代郡九縣。"}],"attestations":[{"id":"th-shiji057-025:a001","paragraph_id":"c-shiji-057-zhou:p005","start":61,"end":62,"surface":"將","person_mention_id":"c-shiji-057-zhou:m005-0062","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授官、爵秩、追稱、承爵與一般用稱分存；相對年數按原段，不換算公曆或推定所有官爵同時終止。未知官員姓名與制度性質不補。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji057-026","person_id":"cbr-p003493","surfaces":["勳"],"scope":"same_chapter","chapter_ids":["c-shiji-057-zhou"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-057-zhou:p005","quote":"擊陳豨，屠馬邑。所將卒斬豨將軍乘馬絺。擊韓信、陳豨、趙利軍於樓煩，破之。得豨將宋最、鴈門守圂。因轉攻得雲中守遬、丞相箕肆、將勳。定鴈門郡十七縣，雲中郡十二縣。因復擊豨靈丘，破之，斬豨，得豨丞相程縱、將軍陳武、都尉高肆。定代郡九縣。"}],"ratio