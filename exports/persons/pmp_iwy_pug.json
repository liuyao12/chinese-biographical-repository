nd":46,"surface":"太史公","kind":"person","person_id":"pmp_iwy_pug","status":"contextual_provisional","paragraph_id":"c-shiji-128-guice:p006","chapter_id":"c-shiji-128-guice"},{"id":"c-shiji-128-guice:m006-0048","start":48,"end":51,"surface":"太史公","kind":"person","person_id":"pmp_iwy_pug","status":"contextual_provisional","paragraph_id":"c-shiji-128-guice:p006","chapter_id":"c-shiji-128-guice"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-128-guice:p001","text":"太史公曰：自古聖王將建國受命，興動事業，何嘗不寶卜筮以助善！唐虞以上，不可記已。自三代之興，各據禎祥。涂山之兆從而夏啟世，飛燕之卜順故殷興，百穀之筮吉故周王。王者決定諸疑，參以卜筮，斷以蓍龜，不易之道也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-128-guice:m001-0000","start":0,"end":3,"surface":"太史公","kind":"person","person_id":"pmp_iwy_pug","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m001-0057","start":57,"end":60,"surface":"夏啟世","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-128-guice:m001-0076","start":76,"end":78,"surface":"周王","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-128-guice","book_id":"b-shiji-128","work_id":"w-shiji","source_id":"s-shiji128-guice"},{"id":"c-shiji-128-guice:p006","text":"褚先生曰：臣以通經術，受業博士，治春秋，以高第為郎，幸得宿衛，出入宮殿中十有餘年。竊好太史公傳。太史公之傳曰：「三王不同龜，四夷各異卜，然各以決吉凶，略闚其要，故作龜策列傳。」臣往來長安中，求龜策列傳不能得，故之大卜官，問掌故文學長老習事者，寫取龜策卜事，編于下方。","annotation_status":"in_progress","text_layer":"witness_appended_chu_note","mentions":[{"id":"c-shiji-128-guice:m006-0000","start":0,"end":3,"surface":"褚先生","kind":"person","person_id":"2xw_63z_xh9","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m006-0043","start":43,"end":46,"surface":"太史公","kind":"person","person_id":"pmp_iwy_pug","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m006-0048","start":48,"end":51,"surface":"太史公","kind":"person","pe