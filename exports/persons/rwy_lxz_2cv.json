iji-112-pingjin:p016","chapter_id":"c-shiji-112-pingjin"},{"id":"c-shiji-112-pingjin:m016-0232","start":232,"end":233,"surface":"康","kind":"person","person_id":"rwy_lxz_2cv","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p016","chapter_id":"c-shiji-112-pingjin"},{"id":"c-shiji-112-pingjin:m018-0015","start":15,"end":16,"surface":"康","kind":"person","person_id":"rwy_lxz_2cv","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p018","chapter_id":"c-shiji-112-pingjin"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-112-pingjin:p016","text":"閒者關東五穀不登，年歲未復，民多窮困，重之以邊境之事，推數循理而觀之，則民且有不安其處者矣。不安故易動。易動者，土崩之勢也。故賢主獨觀萬化之原，明於安危之機，修之廟堂之上，而銷未形之患。其要，期使天下無土崩之勢而已矣。故雖有彊國勁兵，陛下逐走獸，射蜚鳥，弘游燕之囿，淫縱恣之觀，極馳騁之樂，自若也。金石絲竹之聲不絕於耳，帷帳之私俳優侏儒之笑不乏於前，而天下無宿憂。名何必湯武，俗何必成康！雖然，臣竊以為陛下天然之聖，寬仁之資，而誠以天下為務，則湯武之名不難侔，而成康之俗可復興也。此二體者立，然後處尊安之實，揚名廣譽於當世，親天下而服四夷，餘恩遺德為數世隆，南面負扆攝袂而揖王公，此陛下之所服也。臣聞圖王不成，其敝足以安。安則陛下何求而不得，何為而不成，何征而不服乎哉！","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-112-pingjin:m016-0117","start":117,"end":119,"surface":"陛下","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m016-0185","start":185,"end":186,"surface":"湯","kind":"person","person_id":"oil_hwe_l58","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m016-0186","start":186,"end":187,"surface":"武","kind":"person","person_id":"9nw_rct_r8j","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m016-0191","start":191,"end":192,"surface":"成","kind":"person","person_id":"rb8_xqe_j0t","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m016-0192","start":192,"end":193,"surface":"康","kind":"person","person_id":"rwy_lxz_2cv","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m016-0201","start":201,"end":203,"surface":"陛下","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m016-0222","start":222,"end":223,"surface":"湯","kind":"person","person_id":"oil_hwe_l58","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m016-0223","start":223,"end":224,"surface":"武","kind":"person","person_id":"9nw_rct_r8j","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m016-0231","start":231,"end":232,"surface":"成","kind":"person","person_id":"rb8_xqe_j0t","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m016-0232","start":232,"end":233,"surface":"康","kind":"person","person_id":"rwy_lxz_2cv","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m016-0291","start":291,"end":293,"surface":"陛下","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m016-0313","start":313,"end":315,"surface":"陛下","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"}],"chapter_id":"c-shiji-112-pingjin","book_id":"b-shiji-112","work_id":"w-shiji","source_id":"s-shiji112-pingjin"},{"id":"c-shiji-112-pingjin:p018","text":"臣聞周有天下，其治三百餘歲，成康其隆也，刑錯四十餘年而不用。及其衰也，亦三百餘歲，故五伯更起。五伯者，常佐天子興利除害，誅暴禁邪，匡正海內，以尊天子。五伯既沒，賢聖莫續，天子孤弱，號令不行。諸侯恣行，彊陵弱，眾暴寡，田常篡齊，六卿分晉，并為戰國，此民之始苦也。於是彊國務攻，弱國備守，合從連橫，馳車擊轂，介胄生蟣蝨，民無所告愬。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-112-pingjin:m018-0014","start":14,"end":15,"surface":"成","kind":"person","person_id":"rb8_xqe_j0t","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m018-0015","start":15,"end":16,"surface":"康","kind":"person","person_id":"rwy_lxz_2cv","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m018-0042","start":42,"end":44,"surface":"五伯","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-112-pingjin:m018-0047","start":47,"end":49,"surface":"五伯","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji