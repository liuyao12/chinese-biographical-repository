ed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-song047-liujingxuan-顏延","person_id":"uas_7uw_cld","event_type":"death","source_term":"斬","source_anchor":{"paragraph_id":"c-songshu-047-liujingxuan:p002","start":259,"end":260,"surface":"斬"},"date_expression":null,"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-047","chapter_id":"c-songshu-047-liujingxuan","source_id":"s-songshu-047-liujingxuan-ws2190557","paragraph_id":"c-songshu-047-liujingxuan:p002","quote":"隆安二年，王恭起兵於京口，以誅司馬尚之兄弟為名。牢之時為恭前軍司馬、輔國將軍、晉陵太守，置佐領兵。而恭以豪戚自居，甚相陵忽，牢之心不能平。及恭此舉，使牢之為前鋒。太傅會稽王道子與牢之書，備言禍福，使以兵反恭。牢之呼敬宣謂曰：「王恭昔蒙先帝殊恩，今居伯舅之重，義心未彰，唯兵是縱。吾不能審恭事捷之日，必能奉戴天子，緝穆宰相與不。今欲奉國威靈，以明逆順，汝以為何如？」敬宣曰：「朝廷雖無成、康之隆，未有桓、靈之亂，而恭怙亂阻兵，志陵京邑。大人與恭親無骨肉，分非君臣，雖共事少時，意好不協。今日討之，於情何有。」牢之至竹里，斬恭大將顏延，遣敬宣率高雅之等還京襲恭，恭方出城耀軍，馳騎橫擊之，一時散潰。元顯進號後將軍，以敬宣為諮議參軍，加寧朔將軍。","person_mention_id":"c-songshu-047-liujingxuan:p002:m0263"}],"status":"source_attested","interpretation_note":"按同段人物與次第核所屬卒事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"mentions":[{"id":"c-songshu-047-liujingxuan:p002:m0263","start":263,"end":265,"surface":"顏延","kind":"person","person_id":"uas_7uw_cld","status":"contextual_provisional","paragraph_id":"c-songshu-047-liujingxuan:p002","chapter_id":"c-songshu-047-liujingxuan"}],"relations":[],"title_holdings":[{"id":"th-songshu-047-liujingxuan-2-261","title":"大將","kind":"office","mode":"attestation","person_id":"uas_7uw_cld","attestations":[{"id":"th-songshu-047-liujingxuan-2-261:a","paragraph_id":"c-songshu-047-liujingxuan:p002","start":261,"end":263,"surface":"大將","person_mention_id":"c-songshu-047-liujingxuan:p002:m0263","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-047","chapter_id":"c-songshu-047-liujingxuan","source_id":"s-songshu-047-liujingxuan-ws2190557","