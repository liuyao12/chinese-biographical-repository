8-liang","paragraph_id":"c-shiji-058-liang:p010","quote":"長公主"},{"mention_id":"c-shiji-058-liang:m012-0073","chapter_id":"c-shiji-058-liang","paragraph_id":"c-shiji-058-liang:p012","quote":"長公主"},{"mention_id":"c-shiji-108-han:m002-0076","chapter_id":"c-shiji-108-han","paragraph_id":"c-shiji-108-han:p002","quote":"大長公主"},{"mention_id":"c-shiji-108-han:m002-0316","chapter_id":"c-shiji-108-han","paragraph_id":"c-shiji-108-han:p002","quote":"大長公主"},{"mention_id":"c-shiji-108-han:m002-0390","chapter_id":"c-shiji-108-han","paragraph_id":"c-shiji-108-han:p002","quote":"長公主"}],"family_path":{"connection":"father","generation_distance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-049-waiqi","source_id":"s-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p012","quote":"竇太后，趙之清河觀津人也。呂太后時，竇姬以良家子入宮侍太后。太后出宮人以賜諸王，各五人，竇姬與在行中。竇姬家在清河，欲如趙近家，請其主遣宦者吏：「必置我籍趙之伍中。」宦者忘之，誤置其籍代伍中。籍奏，詔可，當行。竇姬涕泣，怨其宦者，不欲往，相彊，乃肯行。至代，代王獨幸竇姬，生女嫖，後生兩男。而代王王后生四男。先代王未入立為帝而王后卒。及代王立為帝，而王后所生四男更病死。孝文帝立數月，公卿請立太子，而竇姬長男最長，立為太子。立竇姬為皇后，女嫖為長公主。其明年，立少子武為代王，已而又徙梁，是為梁孝王。","source_term":"代王獨幸竇姬，生女嫖"}],"source_assertion_id":"a-shiji049-008","interpretation_note":"以此受傳正文的明示近親主張配置局部家族；不合併跨篇候選身份、不補闕名世代，不表示遠祖世系已核實。分支字元不是長幼排行。","reviewer":"Codex（AI 代理）","parent_person_id":"yqp_nlb_p1p_AC"}}],"source_mention_summary":[{"source_id":"s-shiji-011-jingdi","work_id":"w-shiji","book_id":"b-shiji-011","chapter_id":"c-shiji-011-jingdi","mention_count":1,"mention_ids":["c-shiji-011-jingdi:m006-0049"],"paragraph_ids":["c-shiji-011-jingdi:p006"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-011-jingdi"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji011-006","subject_person_id":"dep_bjj_vwe","p