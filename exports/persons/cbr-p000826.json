agraph_id":"c-shiji-009-lvhou:p004","chapter_id":"c-shiji-009-lvhou"},{"id":"c-shiji-011-jingdi:m009-0023","start":23,"end":25,"surface":"周昌","kind":"person","person_id":"cbr-p000826","status":"contextual_provisional","paragraph_id":"c-shiji-011-jingdi:p009","chapter_id":"c-shiji-011-jingdi"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji009-028","person_id":"cbr-p000826","surfaces":["周昌","趙相"],"scope":"same_chapter","chapter_ids":["c-shiji-009-lvhou"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-009-lvhou:p004","quote":"呂后最怨戚夫人及其子趙王，乃令永巷囚戚夫人，而召趙王。使者三反，趙相建平侯周昌謂使者曰：「高帝屬臣趙王，趙王年少。竊聞太后怨戚夫人，欲召趙王并誅之，臣不敢遣王。王且亦病，不能奉詔。」呂后大怒，乃使人召趙相。趙相徵至長安，乃使人復召趙王。王來，未到。孝惠帝慈仁，知太后怒，自迎趙王霸上，與入宮，自挾與趙王起居飲食。太后欲殺之，不得閒。孝惠元年十二月，帝晨出射。趙王少，不能蚤起。太后聞其獨居，使人持酖飲之。犁明，孝惠還，趙王已死。於是乃徙淮陽王友為趙王。夏，詔賜酈侯父追謚為令武侯。太后遂斷戚夫人手足，去眼，煇耳，飲瘖藥，使居廁中，命曰「人彘」。居數日，乃召孝惠帝觀人彘。孝惠見，問，乃知其戚夫人，乃大哭，因病，歲餘不能起。使人請太后曰：「此非人所為。臣為太后子，終不能治天下。」孝惠以此日飲為淫樂，不聽政，故有病也。"}],"rationale":"僅在所列漢初帝后、分封、家族與接任敘事中暫定同指，前卷對讀依相接人物及事件；同名不作全庫替換規則，仍待可靠版本及異源覆核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji011-007","person_id":"cbr-p000826","surfaces":["周昌"],"scope":"cross_chapter","chapter_ids":["c-shiji-009-lvhou","c-shiji-011-jingdi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-009-lvhou:p004","quote":"呂后最怨戚夫人及其子趙王，乃令永巷囚戚夫人，而召趙王。使者三反，趙相建平侯周昌謂使者曰：「高帝屬臣趙王，趙王年少。竊聞太后怨戚夫人，欲召趙王并誅之，臣不敢遣王。王且亦病，不能奉詔。」呂后大怒，乃使人召趙相。趙相徵至長安，乃使人復召趙王。王來，未到。孝惠帝慈仁，知太后怒，自迎趙王霸上，與入宮，自挾與趙王起居飲食。太后欲殺之，不得閒。孝惠元年十二月，帝晨出射。趙王少，不能蚤起。太后聞其獨居，使人持酖飲之。犁明，孝惠還，趙王已死。於是乃徙淮陽王友為趙王。夏，詔賜酈侯父追謚為令武侯。太后遂斷戚夫人手足，去眼，煇耳，飲瘖藥，使居廁中，命曰「人彘」。居數日，乃召孝惠帝觀人彘。孝惠見，問，乃知其戚夫人，乃大哭，因病，歲餘不能起。使人請太后曰：「此非人所為。臣為太后子，終不能治天下。」孝惠以此日飲為淫樂，不聽政，故有病也。"},{"paragraph_id":"c-shiji-011-jingdi:p009","quote":"中元年，封故御史大夫周苛孫平為繩侯，故御史大夫周昌（子）［孫］左車為安陽侯，四月乙巳，赦天下，賜爵一級。除禁錮。地動。衡山、原都雨雹，大者尺八寸。"}],"rationale":"所列景帝朝職事、分封、家族與前卷接任敘事暫定相接；同名不作全庫替換，未名者不補姓名，仍待異源覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji