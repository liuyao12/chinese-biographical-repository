di","work_id":"w-shiji","book_id":"b-shiji-011","chapter_id":"c-shiji-011-jingdi","mention_count":1,"mention_ids":["c-shiji-011-jingdi:m017-0121"],"paragraph_ids":["c-shiji-011-jingdi:p017"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-011-jingdi"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji011-013","subject_person_id":"dtx_aht_hnz","predicate":"brother","object_person_id":"6d6_eg1_o3a_A","status":"source_attested","evidence":[{"chapter_id":"c-shiji-011-jingdi","source_id":"s-shiji-011-jingdi","paragraph_id":"c-shiji-011-jingdi:p017","quote":"後三年十月，日月皆（食）赤五日。十二月晦，雷。日如紫。五星逆行守太微。月貫天廷中。正月甲寅，皇太子冠。甲子，孝景皇帝崩。遺詔賜諸侯王以下至民為父後爵一級，天下戶百錢。出宮人歸其家，復無所與。太子即位，是為孝武皇帝。三月，封皇太后弟蚡為武安侯，弟勝為周陽侯。置陽陵。"}],"qualifiers":{"source_term":"弟","historicity":"historical_tradition"},"interpretation_note":"僅保存來源明示關係，不補未見姓名、闕代或同父同母。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-011-jingdi:m017-0121","start":121,"end":123,"surface":"弟勝","kind":"person","person_id":"dtx_aht_hnz","status":"contextual_provisional","paragraph_id":"c-shiji-011-jingdi:p017","chapter_id":"c-shiji-011-jingdi"}],"relations":[{"id":"a-shiji011-013","subject_person_id":"dtx_aht_hnz","predicate":"brother","object_person_id":"6d6_eg1_o3a_A","status":"source_attested","evidence":[{"chapter_id":"c-shiji-011-jingdi","source_id":"s-shiji-011-jingdi","paragraph_id":"c-shiji-011-jingdi:p017","quote":"後三年十月，日月皆（食）赤五日。十二月晦，雷。日如紫。五星逆行守太微。月貫天廷中。正月甲寅，皇太子冠。甲子，孝景皇帝崩。遺詔賜諸侯王以下至民為父後爵一級，天下戶百錢。出宮人歸其家，復無所與。太子即位，是為孝武皇帝。三月，封皇太后弟蚡為武安侯，弟勝為周陽侯。置陽陵。"}],"qualifiers":{"