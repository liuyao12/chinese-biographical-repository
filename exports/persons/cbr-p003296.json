{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003296","identity_policy":"contextual_provisional","person_ids":["cbr-p003296"],"persons":[{"id":"cbr-p003296","label":"召平（蕭相國世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"召平","mention_ids":["c-shiji-053-xiao:m010-0090","c-shiji-053-xiao:m010-0095","c-shiji-053-xiao:m010-0137","c-shiji-053-xiao:m010-0144"]}],"evidence":[{"mention_id":"c-shiji-053-xiao:m010-0090","chapter_id":"c-shiji-053-xiao","paragraph_id":"c-shiji-053-xiao:p010","quote":"召平"},{"mention_id":"c-shiji-053-xiao:m010-0095","chapter_id":"c-shiji-053-xiao","paragraph_id":"c-shiji-053-xiao:p010","quote":"召平"},{"mention_id":"c-shiji-053-xiao:m010-0137","chapter_id":"c-shiji-053-xiao","paragraph_id":"c-shiji-053-xiao:p010","quote":"召平"},{"mention_id":"c-shiji-053-xiao:m010-0144","chapter_id":"c-shiji-053-xiao","paragraph_id":"c-shiji-053-xiao:p010","quote":"召平"}]}],"mentions":[{"id":"c-shiji-053-xiao:m010-0090","start":90,"end":92,"surface":"召平","kind":"person","person_id":"cbr-p003296","status":"contextual_provisional","paragraph_id":"c-shiji-053-xiao:p010","chapter_id":"c-shiji-053-xiao"},{"id":"c-shiji-053-xiao:m010-0095","start":95,"end":97,"surface":"召平","kind":"person","person_id":"cbr-p003296","status":"contextual_provisional","paragraph_id":"c-shiji-053-xiao:p010","chapter_id":"c-shiji-053-xiao"},{"id":"c-shiji-053-xiao:m010-0137","start":137,"end":139,"surface":"召平","kind":"person","person_id":"cbr-p003296","status":"contextual_provisional","paragraph_id":"c-shiji-053-xiao:p010","chapter_id":"c-shiji-053-xiao"},{"id":"c-shiji-053-xiao:m010-0144","start":144,"end":146,"surface":"召平","kind":"person","person_id":"cbr-p003296","status":"contextual_provisional","paragraph_id":"c-shiji-053-xiao:p010","chapter_id":"c-shiji-053-xiao"}],"relations":[],"title_holdings":[{"id":"th-shiji053-014","person_id":"cbr-p003296","title":"東陵侯","kind":"noble_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-053-xiao","source_id":"s-shiji-053-xiao","paragraph_id":"c-shiji-053-xiao:p010","quote":"漢十一年，陳豨反，高祖自將，至邯鄲。未罷，淮陰侯謀反關中，呂后用蕭何計，誅淮陰侯，語在淮陰事中。上已聞淮陰侯誅，使使拜丞相何為相國，益封五千戶，令卒五百人一都尉為相國衛。諸君皆賀，召平獨吊。召平者，故秦東陵侯。秦破，為布衣，貧，種瓜於長安城東，瓜美，故世俗謂之「東陵瓜」，從召平以為名也。召平謂相國曰：「禍自此始矣。上暴露於外而君守於中，非被矢石之事而益君封置衛者，以今者淮陰侯新反於中，疑君心矣。夫置衛衛君，非以寵君也。原君讓封勿受，悉以家私財佐軍，則上心說。」相國從其計，高帝乃大喜。"}],"attestations":[{"id":"th-shiji053-014:a001","paragraph_id":"c-shiji-053-xiao:p010","start":101,"end":104,"surface":"東陵侯","person_mention_id":"c-shiji-053-xiao:m010-0095","usage":"retrospective"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授封、任事、加封、讓封與死後用稱分開；給泗水卒史事不冒稱正式授職，群體後嗣封續不當蕭何仍在任。爵位時段不由卒日、下獄或赦出推端點。酇侯授封前有歲餘敘事，不將漢五年直接填實封年月。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji053-011","person_id":"cbr-p003296","surfaces":["召平"],"scope":"same_chapter","chapter_ids":["c-shiji-053-xiao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-053-xiao:p010","quote":"漢十一年，陳豨反，高祖自將，至邯鄲。未罷，淮陰侯謀反關中，呂后用蕭何計，誅淮陰侯，語在淮陰事中。上已聞淮陰侯誅，使使拜丞相何為相國，益封五千戶，令卒五百人一都尉為相國衛。諸君皆賀，召平獨吊。召平者，故秦東陵侯。秦破，為布衣，貧，種瓜於長安城東，瓜美，故世俗謂之「東陵瓜」，從召平以為名也。召平謂相國曰：「禍自此始矣。上暴露於外而君守於中，非被矢石之事而益君封置衛者，以今者淮陰侯新反於中，疑君心矣。夫置衛衛君，非以寵君也。原君讓封勿受，悉以家私財佐軍，則上心說。」相國從其計，高帝乃大喜。"}],"rationale":"依明示名與局部丞相、相國及軍事敘事暫接，何字先排疑問詞；秦東陵侯召平不接齊相，未名署稱不補姓名，桀紂為比擬人物不冒稱當時在場。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-053-xiao:p010","text":"漢十一年，陳豨反，高祖自將，至邯鄲。未罷，淮陰侯謀反關中，呂后用蕭何計，誅淮陰侯，語在淮陰事中。上已聞淮陰侯誅，使使拜丞相何為相國，益封五千戶，令卒五百人一都尉為相國衛。諸君皆賀，召平獨吊。召平者，故秦東陵侯。秦破，為布衣，貧，種瓜於長安城東，瓜美，故世俗謂之「東陵瓜」，從召平以為名也。召平謂相國曰：「禍自此始矣。上暴露於外而君守於中，非被矢石之事而益君封置衛者，以今者淮陰侯新反於中，疑君心矣。夫置衛衛君，非以寵君也。原君讓封勿受，悉以家私財佐軍，則上心說。」相國從其計，高帝乃大喜。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-053-xiao:m010-0