{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"6mv_qs6_u86","canonical_person_id":"6mv_qs6_u86","id_aliases":["cbr-p004864"],"identity_policy":"contextual_provisional","person_ids":["6mv_qs6_u86"],"persons":[{"id":"6mv_qs6_u86","label":"宋子主人家丈人未名（刺客列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"其主","mention_ids":["c-shiji-086-cike:m036-0087"]},{"surface":"家丈人","mention_ids":["c-shiji-086-cike:m036-0105"]}],"evidence":[{"mention_id":"c-shiji-086-cike:m036-0087","chapter_id":"c-shiji-086-cike","paragraph_id":"c-shiji-086-cike:p036","quote":"其主"},{"mention_id":"c-shiji-086-cike:m036-0105","chapter_id":"c-shiji-086-cike","paragraph_id":"c-shiji-086-cike:p036","quote":"家丈人"}],"id_aliases":["cbr-p004864"]}],"source_mention_summary":[{"source_id":"s-shiji-086-cike","work_id":"w-shiji","book_id":"b-shiji-086","chapter_id":"c-shiji-086-cike","mention_count":2,"mention_ids":["c-shiji-086-cike:m036-0087","c-shiji-086-cike:m036-0105"],"paragraph_ids":["c-shiji-086-cike:p036"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-086-cike"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-086-cike:m036-0087","start":87,"end":89,"surface":"其主","kind":"person","person_id":"6mv_qs6_u86","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p036","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m036-0105","start":105,"end":108,"surface":"家丈人","kind":"person","person_id":"6mv_qs6_u86","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p036","chapter_id":"c-shiji-086-cike"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji086-053","person_id":"6mv_qs6_u86","scope":"same_chapter","chapter_ids":["c-shiji-086-cike"],"status":"contextual_provisional","rationale":"依刺秦及篇末敘事暫接，蒙嘉之嘉限第34段，與代王嘉分開；燕王暫依第35段燕王喜承接，秦始皇及秦皇帝依第36段立號承接秦王。徐夫人不推定性別，所待客、家丈人與董生保留未名或氏稱；太史公口傳證據未作獨立核實。","reviewer":"Codex（AI 代理）","surfaces":["其主","家丈人"],"evidence":[{"paragraph_id":"c-shiji-086-cike:p036","quote":"其明年，秦并天下，立號爲皇帝。於是秦逐太子丹、荊軻之客，皆亡。髙漸離變名姓爲人庸保，匿作於宋子。久之，作苦，聞其家堂上客撃筑，傍偟不能去。毎出言曰：「彼有善有不善。」從者以告其主，曰：「彼庸乃知音，竊言是非。」家丈人召使前撃筑，一坐稱善，賜酒。而髙漸離念久隱畏約無窮時，乃退，出其裝匣中筑與其善衣，更容貌而前。舉坐客皆驚，下與抗禮，以爲上客。使撃筑而歌，客無不流涕而去者。宋子傳客之，聞於秦始皇。秦始皇召見，人有識者，乃曰：「髙漸離也。」秦皇帝惜其善撃筑，重赦之，乃矐其目。使撃筑，未嘗不稱善。稍益近之，髙漸離乃以鉛置筑中，復進得近，舉筑樸秦皇帝，不中。於是遂誅髙漸離，終身不復近諸侯之人。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-086-cike:p036","text":"其明年，秦并天下，立號爲皇帝。於是秦逐太子丹、荊軻之客，皆亡。髙漸離變名姓爲人庸保，匿作於宋子。久之，作苦，聞其家堂上客撃筑，傍偟不能去。毎出言曰：「彼有善有不善。」從者以告其主，曰：「彼庸乃知音，竊言是非。」家丈人召使前撃筑，一坐稱善，賜酒。而髙漸離念久隱畏約無窮時，乃退，出其裝匣中筑與其善衣，更容貌而前。舉坐客皆驚，下與抗禮，以爲上客。使撃筑而歌，客無不流涕而去者。宋子傳客之，聞於秦始皇。秦始皇召見，人有識者，乃曰：「髙漸離也。」秦皇帝惜其善撃筑，重赦之，乃矐其目。使撃筑，未嘗不稱善。稍益近之，髙漸離乃以鉛置筑中，復進得近，舉筑樸秦皇帝，不中。於是遂誅髙漸離，終身不復近諸侯之人。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-086-cike:m036-0019","start":19,"end":22,"surface":"太子丹","kind":"person","person_id":"v89_58y_qe2","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m036-0023","start":23,"end":25,"surface":"荊軻","kind":"person","person_id":"02z_7va_g33","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m036-0031","start":31,"end":34,"surface":"髙漸離","kind":"person","person_id":"guh_2ns_rmq","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m036-0057","start":57,"end":60,"surface":"堂上客","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名人物或待核稱呼保留未解；未補姓名、性別或親屬名。"},{"id":"c-shiji-086-cike:m036-0083","start":83,"end":85,