055","start":55,"end":56,"surface":"王","kind":"person","person_id":"1c8_u63_bk4_F","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m014-0074","start":74,"end":77,"surface":"二千石","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、未名皇帝或未定指代；不補未見姓名、親屬成員或確定身份。"}],"chapter_id":"c-shiji-059-wuzong","book_id":"b-shiji-059","work_id":"w-shiji","source_id":"s-shiji-059-wuzong"},{"id":"c-shiji-059-wuzong:p015","text":"立四十七年，卒，竟無男代後，國除，地入于漢，為膠西郡。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[],"chapter_id":"c-shiji-059-wuzong","book_id":"b-shiji-059","work_id":"w-shiji","source_id":"s-shiji-059-wuzong"},{"id":"c-shiji-059-wuzong:p039","text":"【索隱述贊】景十三子，五宗親睦。栗姬既廢，臨江折軸。閼於早薨，河間儒服。餘好宮苑，端事馳逐。江都有才，中山禔福。長沙地小，膠東造鏃。仁賢者代，浡亂者族。兒姁四王，分封為六。","annotation_status":"named_mentions_first_pass","text_layer":"witness_appended_suoyin_zan","mentions":[{"id":"c-shiji-059-wuzong:m039-0016","start":16,"end":18,"surface":"栗姬","kind":"person","person_id":"gem_sji_xo8","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m039-0026","start":26,"end":28,"surface":"閼於","kind":"person","person_id":"1c8_u63_bk4_C","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m039-0036","start":36,"end":37,"surface":"餘","kind":"person","person_id":"1c8_u63_bk4_D","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m039-0041","start":41,"end":42,"surface":"端","kind":"person","person_id":"1c8_u63_bk4_F","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m039-0066","start":66,"end":69,"surface":"仁賢者","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、未名皇帝或未定指代；不補未見姓名、親屬成員或確定身份。"},{"id":"c-shiji-059-wuzong:m039-0071","start":71,"end":72,"surface":"浡","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、未名皇帝或未定指代；不補未見姓名、親屬成員或確定身份。"},{"id":"c-shiji-059-wuzong:m039-0076","start":76,"end":78,"surface":"兒姁","kind":"person","person_id":"qms_rcb_628","stat