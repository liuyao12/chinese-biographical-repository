n_id":"0jo_ejm_n20","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m012-0013","start":13,"end":16,"surface":"齊威王","kind":"person","person_id":"ly9_9ul_u6x","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m012-0019","start":19,"end":21,"surface":"優孟","kind":"person","person_id":"3sn_ajy_26l","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m012-0026","start":26,"end":29,"surface":"負薪者","kind":"person","person_id":"fom_gr9_c8v_A","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m012-0032","start":32,"end":34,"surface":"優旃","kind":"person","person_id":"4qb_8ik_19m","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m012-0039","start":39,"end":41,"surface":"陛楯","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-126-huaji","book_id":"b-shiji-126","work_id":"w-shiji","source_id":"s-shiji126-huaji"},{"id":"c-shiji-126-huaji:p021","text":"昔者，齊王使淳于髡獻鵠於楚。出邑門，道飛其鵠，徒揭空籠，造詐成辭，往見楚王曰：「齊王使臣來獻鵠，過於水上，不忍鵠之渴，出而飲之，去我飛亡。吾欲刺腹絞頸而死。恐人之議吾王以鳥獸之故令士自傷殺也。鵠，毛物，多相類者，吾欲買而代之，是不信而欺吾王也。欲赴佗國奔亡，痛吾兩主使不通。故來服過，叩頭受罪大王。」楚王曰：「善，齊王有信士若此哉！」厚賜之，財倍鵠在也。","annotation_status":"in_progress","text_layer":"witness_appended_chu_note","mentions":[{"id":"c-shiji-126-huaji:m021-0003","start":3,"end":5,"surface":"齊王","kind":"person","person_id":"ovs_nhp_dw3","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m021-0006","start":6,"end":9,"surface":"淳于髡","kind":"person","person_id":"0jo_ejm_n20","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m021-0035","start":35,"end":37,"surface":"楚王","kind":"person","person_id":"wfy_80o_l8g","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m021-0040","start":40,"end":42,"surface":"齊王","kind":"person","person_id":"ovs_nhp_dw3","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m021-0082","start":82,"end":84,"surface":"吾王","kind":"person","person_id":"ovs_nhp_dw3","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m021-0118","start":118,"end":120,"surface":"吾王","kind":"person","person_id":"ovs_nhp_dw3","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m021-0131","start":131,"end":133,"surface":"兩主","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-126-huaji:m021-0146","start":146,"end":148,"surface":"大王","kind":"person","person_id":"wfy_80o_l8g","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m021-0150","start":150,"end":152,"surface":"楚王","kind":"person","person_id":"wfy_80o_l8g","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m021-0157","start":157,"end":159,"surface":"齊王","kind":"person","person_id":"ovs_nhp_dw3","status":"contextual_provisional"}],"chapter_id":"c-shiji-126-huaji","book_id":"b-shiji-126","work_id":"w-shiji","source_id":"s-shiji126-huaji"},{"id":"c-shiji-126-huaji:p027","text":"滑稽鴟夷，如脂如韋。敏捷之變，學不失詞。淳于索絕，趙國興師。楚優拒相，寢丘獲祠。偉哉方朔，三章紀之。","annotation_status":"in_progress","text_layer":"witness_appended_suoyin_zan","mentions":[{"id":"c-shiji-126-huaji:m027-0020","start":20,"end":22,"surface":"淳于","kind":"person","person_id":"0jo_ejm_n20","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m027-0030","start":30,"end":32,"surface":"楚優","kind":"person","person_id":"3sn_ajy_26l","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m027-0042","start":42,"end":44,"surface":"方朔","kind":"person","person_id":"s11_z5r_y2z","status":"contextual_provisional"}],"chapter_id":"c-shiji-126-huaji","book_id":"b-shiji-126","work_id":"w-shiji","source_id":"s-shiji126-huaji"}],"sources":[{"chapter_id":"c-shiji-126-huaji","work_id":"w-shiji","book_id":"b-shiji-126","source_id":"s-shiji126-huaji","source":{"title":"史記／卷126","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷126","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷126&oldid=2609358","revision_id":2609358,"accessed_on":"2026-10-11","extent":"固定修訂全文27段；篇文12段、褚少孫補文14段、索隱述贊1段。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativ