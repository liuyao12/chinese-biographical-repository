{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p005392","identity_policy":"contextual_provisional","person_ids":["cbr-p005392"],"persons":[{"id":"cbr-p005392","label":"太史公（張丞相列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"太史公","mention_ids":["c-shiji-096-zhang:m020-0000","c-shiji-096-zhang:m029-0000"]}],"evidence":[{"mention_id":"c-shiji-096-zhang:m020-0000","chapter_id":"c-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p020","quote":"太史公"},{"mention_id":"c-shiji-096-zhang:m029-0000","chapter_id":"c-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p029","quote":"太史公"}]}],"mentions":[{"id":"c-shiji-096-zhang:m020-0000","start":0,"end":3,"surface":"太史公","kind":"person","person_id":"cbr-p005392","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p020","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m029-0000","start":0,"end":3,"surface":"太史公","kind":"person","person_id":"cbr-p005392","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p029","chapter_id":"c-shiji-096-zhang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji096-034","person_id":"cbr-p005392","scope":"same_chapter","chapter_ids":["c-shiji-096-zhang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["太史公"],"evidence":[{"paragraph_id":"c-shiji-096-zhang:p020","quote":"太史公曰：張蒼文學律歷，為漢名相，而絀賈生、公孫臣等言正朔服色事而不遵，明用秦之顓頊歷，何哉？周昌，木彊人也。任敖以舊德用。申屠嘉可謂剛毅守節矣，然無術學，殆與蕭、曹、陳平異矣。"},{"paragraph_id":"c-shiji-096-zhang:p029","quote":"太史公曰：深惟士之游宦所以至封侯者，微甚。然多至御史大夫即去者。諸為大夫而丞相次也，其心冀幸丞相物故也。或乃陰私相毀害，欲代之。然守之日久不得，或為之日少而得之，至於封侯，真命也夫！御史大夫鄭君守之數年不得，匡君居之未滿歲，而韋丞相死，即代之矣，豈可以智巧得哉！多有賢聖之才，困妯囡者眾甚也。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定短稱；韋賢與韋玄成分傳區別，第23段掾陳平另候選，第25段長安相工田文不與孟嘗君合併。趙堯、任敖、申屠嘉、鄧通、晁錯的短名依各段人物語境，王陵夫人與王陵分人。張蒼父長不滿五尺的長為身長敘述，不作父名。王侯與太子未詳名不補名，跨篇同指另待證據。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-096-zhang:p020","text":"太史公曰：張蒼文學律歷，為漢名相，而絀賈生、公孫臣等言正朔服色事而不遵，明用秦之顓頊歷，何哉？周昌，木彊人也。任敖以舊德用。申屠嘉可謂剛毅守節矣，然無術學，殆與蕭、曹、陳平異矣。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhang:m020-0000","start":0,"end":3,"surface":"太史公","kind":"person","person_id":"cbr-p005392","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m020-0005","start":5,"end":7,"surface":"張蒼","kind":"person","person_id":"cbr-p005362","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m020-0019","start":19,"end":21,"surface":"賈生","kind":"person","person_id":"cbr-p005412","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m020-0022","start":22,"end":25,"surface":"公孫臣","kind":"person","person_id":"cbr-p005387","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m020-0047","start":47,"end":49,"surface":"周昌","kind":"person","person_id":"cbr-p005370","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m020-0055","start":55,"end":57,"surface":"任敖","kind":"person","person_id":"cbr-p005395","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m020-0062","start":62,"end":65,"surface":"申屠嘉","kind":"person","person_id":"cbr-p005383","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m020-0080","start":80,"end":81,"surface":"蕭","kind":"person","person_id":"cbr-p005380","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m020-0082","start":82,"end":83,"surface":"曹","kind":"person","person_id":"cbr-p005379","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m020-0084","start":84,"end":86,"surface":"陳平","kind":"person","person_id":"cbr-p005413","status":"contextual_provisional"}],"chapter_id":"c-shiji-096-zhang","book_id":"b-shiji-096","work_id":"w-shiji","source_id":"s-shiji-096-zhang"},{"id":"c-shiji-096-zhang:p029","text":"太史公曰：深惟士之游宦所以至封侯者，微甚。然多至御史大夫即去者。諸為大夫而丞相次也，其心冀幸丞相物故也。或乃陰私相毀害，欲代之。然守之日久不得，或為之日少而得之，至於封侯，真命也夫！御史大夫鄭君守之數年不得，匡君居之未滿歲，而韋丞相死，即代之矣，豈可以智巧得哉！多有賢聖之才，困妯囡者眾甚也。","annotation_statu