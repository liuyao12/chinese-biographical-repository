126,10127,10128,10129,10130,10131,10132,10133,10134,10135,10136,10137,10138,10139,10140,10141,10142,10143,10144,10145],"first_line":126,"last_line":126,"revision_id":2618531,"projection_sha256":"e093f23b1042b6d7f2e8760c333d47f05db8c09dacb1039b49e592f77e815e2f","source_layer":"received_biography"},"chapter_id":"c-jinshu-043-wangcheng","book_id":"b-jinshu-043","work_id":"w-jinshu","source_id":"s-jinshu-043-ws2618531-wangcheng"},{"id":"c-jinshu-069-zhouyi:p002","text":"元帝初鎮江左，請為軍諮祭酒，出為甯遠將軍、荊州刺史、領護南蠻校尉、假節。始到州，而建平流人傅密等叛迎蜀賊杜弢，顗狼狽失據。陶侃遣將吳寄以兵救之，故顗得免，因奔王敦于豫章。敦留之。軍司戴邈曰：「顗雖退敗，未有蒞眾之咎，德望素重，宜還復之。」敦不從。帝召為揚威將軍、兗州刺史。顗還建康，帝留顗不遣，復以為軍諮祭酒，尋轉右長史。中興建，補吏部尚書。頃之，以醉酒為有司所糾，白衣領職。復坐門生斫傷人，免官。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-069-zhouyi:p002:m0000","start":0,"end":2,"surface":"元帝","kind":"person","person_id":"dkn_ge4_286_AAAAAAA","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0045","start":45,"end":47,"surface":"傅密","kind":"person","person_id":"2ek_879_zfk","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0052","start":52,"end":54,"surface":"杜弢","kind":"person","person_id":"7dv_udy_955","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0055","start":55,"end":56,"surface":"顗","kind":"person","person_id":"3xx_gdy_or6_AAA","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0061","start":61,"end":63,"surface":"陶侃","kind":"person","person_id":"twd_erg_kmz","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0065","start":65,"end":67,"surface":"吳寄","kind":"person","person_id":"ns4_a8h_396","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0070","start":70,"end":71,"surface":"之","kind":"person","person_id":"3xx_gdy_or6_AAA","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0073","start":73,"end":74,"surface":"顗","kind":"person","person_id":"3xx_gdy_or6_AAA","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi: