s":"contextual_provisional","interpretation_note":"讀本段前後及對話，所指按此處記。"},{"id":"c-jinshu-043-wangcheng:line124:m0097","start":97,"end":99,"surface":"元帝","kind":"person","person_id":"dkn_ge4_286_AAAAAAA","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line124:m0100","start":100,"end":101,"surface":"澄","kind":"person","person_id":"rlk_lzd_86c","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"source_position":{"first_line":124,"last_line":124,"raw_start":9754,"raw_end":9868,"revision_id":2618531},"chapter_id":"c-jinshu-043-wangcheng","book_id":"b-jinshu-043","work_id":"w-jinshu","source_id":"s-jinshu-043-wangcheng"},{"id":"c-jinshu-043-wangcheng:line126","text":"時王敦為江州，鎮豫章，澄過詣敦。澄夙有盛名，出於敦右，士庶莫不傾慕之。兼勇力絕人，素為敦所憚，澄猶以舊意侮敦。敦益忿怒，請澄入宿，陰欲殺之。而澄左右有二十絕人，持鐵馬鞭為衛，澄手嘗捉玉枕以自防，故敦未之得發。後敦賜澄左右酒，皆醉，借玉枕觀之。因下床而謂澄曰：「何與杜弢通信？」澄曰：「事自可驗。」敦欲入內，澄手引敦衣，至於絕帶。乃登于梁，因罵敦曰：「行事如此，殃將及焉。」敦令力士路戎搤殺之，時年四十四，載屍還其家。劉琨聞澄之死，歎曰：「澄自取之。」及敦平，澄故吏佐著作郎桓稚上表理澄，請加贈諡。詔復澄本官，諡曰憲。長子詹，早卒。次子徽，右軍司馬。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-043-wangcheng:line126:m0001","start":1,"end":3,"surface":"王敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line126:m0011","start":11,"end":12,"surface":"澄","kind":"person","person_id":"rlk_lzd_86c","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line126:m0014","start":14,"end":15,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line126:m0016","start":16,"end":17,"surface":"澄","kind":"person","person_id":"rlk_lzd_86c","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line126:m0024","start":24,"end":25,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","in