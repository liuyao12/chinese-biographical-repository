dv_udy_955","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line015","chapter_id":"c-jinshu-098-jin033-wangji"},{"id":"c-jinshu-098-jin033-wangji:line015:m0066","start":66,"end":67,"surface":"弢","kind":"person","person_id":"7dv_udy_955","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line015","chapter_id":"c-jinshu-098-jin033-wangji"},{"id":"c-jinshu-098-jin033-wangji:line015:m0095","start":95,"end":96,"surface":"弢","kind":"person","person_id":"7dv_udy_955","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line015","chapter_id":"c-jinshu-098-jin033-wangji"},{"id":"c-jinshu-098-jin033-wangji:line015:m0156","start":156,"end":158,"surface":"杜弢","kind":"person","person_id":"7dv_udy_955","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line015","chapter_id":"c-jinshu-098-jin033-wangji"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-jin069-zhouyi-7dv-udy-955","person_id":"7dv_udy_955","surfaces":["杜弢"],"scope":"same_chapter","chapter_ids":["c-jinshu-069-zhouyi"],"status":"contextual_provisional","confidence_level":"moderate","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-069","chapter_id":"c-jinshu-069-zhouyi","source_id":"s-jinshu-069-zhouyi","paragraph_id":"c-jinshu-069-zhouyi:p002","quote":"元帝初鎮江左，請為軍諮祭酒，出為甯遠將軍、荊州刺史、領護南蠻校尉、假節。始到州，而建平流人傅密等叛迎蜀賊杜弢，顗狼狽失據。陶侃遣將吳寄以兵救之，故顗得免，因奔王敦于豫章。敦留之。軍司戴邈曰：「顗雖退敗，未有蒞眾之咎，德望素重，宜還復之。」敦不從。帝召為揚威將軍、兗州刺史。顗還建康，帝留顗不遣，復以為軍諮祭酒，尋轉右長史。中興建，補吏部尚書。頃之，以醉酒為有司所糾，白衣領職。復坐門生斫傷人，免官。"}],"rationale":"親讀完整周顗及附閔單元，依說話受話及人物延續辨識；短字嵇阮限王導對顗引古語境，田蘇與無鹽不補未核外名。周穆及周文與既有古人同字候選分立。先帝／二宮／匿名群體保未決；親屬與為嗣提案未在此形式化。","references":[],"human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-043-wangcheng:line122","text":"澄既至鎮，日夜縱酒，不親庶事，雖寇戎急務，亦不以在懷。擢順陽人郭舒於寒悴之中，以為別駕，委以州府。時京師危逼，澄率眾軍，將赴國難，而飄風折其節柱。會王如寇襄陽，澄前鋒至宜城，遣使詣山簡，為如党嚴嶷所獲。嶷偽使人從襄陽來而問之曰：「襄陽拔未？」答云：「昨旦破城，已獲山簡。」乃陰緩澄使，令得亡去。澄聞襄陽陷，以為信然，散眾而還。既而恥之，托糧運不贍，委罪長史蔣俊而斬之，竟不能進。巴蜀流人散在荊、湘者，與土人忿爭，遂殺縣令，屯聚樂鄉。澄使成都內史王機討之。賊請降，澄偽許之，既而襲之於寵洲，以其妻子為賞，沈八千餘人于江中。於是益、梁流人四五萬家一時俱反，推杜弢為主，，南破零桂，東掠武昌，敗王機于巴陵。澄亦無憂懼之意，但與機日夜縱酒，投壺博戲，數十局俱起。殺富人李才，取其家資以賜郭舒。南平太守應詹驟諫，不納。於是上下離心，內外怨叛。澄望實雖損，猶傲然自得。後出軍擊杜弢，次於作塘。山簡參軍王沖叛於豫州，自稱荊州刺史。澄懼，使杜蕤守江陵。澄遷於孱陵，尋奔遝中。郭舒諫曰：「使君臨州，雖無異政，未失眾心。今西收華容向義之兵，足以擒此小丑，奈何自棄。」澄不能從。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-043-wangcheng:line122:m0000","start":0,"end":1,"surface":"澄","kind":"person","person_id":"rlk_lzd_86c","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line122:m0031","start":31,"end":33,"surface":"郭舒","kind":"person","person_id":"nyu_drp_roe","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line122:m0055","start":55,"end":56,"surface":"澄","kind":"person","person_id":"rlk_lzd_86c","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line122:m0074","start":74,"end":76,"surface":"王如","kind":"person","person_id":"als_c6t_b83","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line122:m0080","start":80,"end":81,"surface":"澄","kind":"person","person_id":"rlk_lzd_86c","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line122:m0090","start":90,"end":92,"surface":"山簡","kind":"person","person_id":"82k_3oi_qf8","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line122:m0094","start":94,"end":95,"surface":"如","kind":"person","person_id":"als_c6t_b83","status":"contextual_provisional","interpretation_note":"讀本段前後及對話，所指按此處記。"},{"id":"c-jinshu-043-wangcheng:line122:m