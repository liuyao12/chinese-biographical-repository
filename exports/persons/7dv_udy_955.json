吏部尚書。頃之，以醉酒為有司所糾，白衣領職。復坐門生斫傷人，免官。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-069-zhouyi:p002:m0000","start":0,"end":2,"surface":"元帝","kind":"person","person_id":"dkn_ge4_286_AAAAAAA","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0045","start":45,"end":47,"surface":"傅密","kind":"person","person_id":"2ek_879_zfk","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0052","start":52,"end":54,"surface":"杜弢","kind":"person","person_id":"7dv_udy_955","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0055","start":55,"end":56,"surface":"顗","kind":"person","person_id":"3xx_gdy_or6_AAA","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0061","start":61,"end":63,"surface":"陶侃","kind":"person","person_id":"twd_erg_kmz","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0065","start":65,"end":67,"surface":"吳寄","kind":"person","person_id":"ns4_a8h_396","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0070","start":70,"end":71,"surface":"之","kind":"person","person_id":"3xx_gdy_or6_AAA","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0073","start":73,"end":74,"surface":"顗","kind":"person","person_id":"3xx_gdy_or6_AAA","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0079","start":79,"end":81,"surface":"王敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0085","start":85,"end":86,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0087","start":87,"end":88,"surface":"之","kind":"person","person_id":"3xx_gdy_or6_AAA","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0091","start":91,"end":93,"surface":"戴邈","kind":"person","person_id":"qxw_ax7_qew","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0096","start":96,"end":97,"surface":"顗","kind":"person","person_id":"3xx_gdy_or6_AAA","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0116","start":116,"end":117,"surface":"之","kind":"person","person_id":"3xx_gdy_or6_AAA","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0119","start":119,"end":120,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0123","start":123,"end":124,"surface":"帝","kind":"person","person_id":"dkn_ge4_286_AAAAAAA","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0136","start":136,"end":137,"surface":"顗","kind":"person","person_id":"3xx_gdy_or6_AAA","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0141","start":141,"end":142,"surface":"帝","kind":"person","person_id":"dkn_ge4_286_AAAAAAA","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0143","start":143,"end":144,"surface":"顗","kind":"person","person_id":"3xx_gdy_or6_AAA","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0178","start":178,"end":180,"surface":"有司","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-jinshu-069-zhouyi:p002:m0190","start":190,"end":192,"surface":"門生","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-jinshu-069-zhouyi:p002:m0194","start":194,"end":195,"surface":"人","kind":"unresolved","person_id":null,"status":"unresolved"}],"source_position":{"first_line":99,"last_line":99,"revision_id":2012453,"editorial_excerpt_boundary":false},"chapter_id":"c-jinshu-069-zhouyi","book_id":"b-jinshu-069","work_id":"w-jinshu","source_id":"s-jinshu-069-zhouyi"},{"id":"c-jinshu-098-jin033-wangji:line015","text":"蜀賊杜弢作亂，荊州刺史周顗退走，敦遣武昌太守陶侃、豫章太守周訪等討韜，而敦進住豫章，為諸軍繼援。及侃破弢，敦上侃為荊州刺史。既而侃為弢將杜曾所敗，敦以處分失所，自貶為廣武將軍，帝不許。侃之滅弢也，敦以元帥進鎮東大將軍、開府儀同三司，加都督江揚荊湘交廣六州諸軍事、江州刺史，封漢安侯。敦始自選置，兼統州郡焉。頃之，杜弢將杜弘南走廣州，求討桂林賊自效，敦許之。陶侃距弘不得進，乃詣零陵太守尹奉降，奉送弘與敦，敦以為將，遂見寵待。南康人何欽所居險固，聚黨數千人，敦就加四品將軍，於是專擅之跡漸彰矣。","annotation_status":"reviewed","text_layer":"received_chapter","mentions":[{"id":"c-jinshu-098-jin033-wangji:line015:m0002","start":2,"end":4,"surface":"杜弢","kind":"person","person_id":"7dv_udy_955","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line015:m0011","start":11,"end":13,"surface":"周顗","kind":"person","person_id":"3xx_gdy_or6_AAA","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line015:m0016","start":16,"end":17,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line015:m0022","start":22,"end":24,"surface":"陶侃","kind":"person","person_id":"twd_erg_kmz","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line015:m0029","start":29,"end":31,"surface":"周訪","kind":"person","person_id":"c6b_s71_vt7","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line015:m0033","start":33,"end":34,"surface":"韜","kind":"person","person_id":"7dv_udy_955","status":"contextual_provisional","interpretation_note":"讀本段前後及對話，所指按此處記。"},{"id":"c-jinshu-098-jin033-wangji:line015:m0036","start":36,"end":37,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line015:m0049","start":49,"end":50,"surface":"侃","kind":"person","person_id":"twd_erg_kmz","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line015:m0051","start":51,"end":52,"surface":"弢","kind":"person","person_id":"7dv_udy_955","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line015:m0053","start":53,"end":54,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinsh