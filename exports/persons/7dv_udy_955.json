3-wangcheng:line122:m0412","start":412,"end":414,"surface":"杜蕤","kind":"person","person_id":"uuj_hen_12i","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line122:m0418","start":418,"end":419,"surface":"澄","kind":"person","person_id":"rlk_lzd_86c","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line122:m0429","start":429,"end":431,"surface":"郭舒","kind":"person","person_id":"nyu_drp_roe","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line122:m0473","start":473,"end":474,"surface":"澄","kind":"person","person_id":"rlk_lzd_86c","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"source_position":{"first_line":122,"last_line":122,"raw_start":9272,"raw_end":9752,"revision_id":2618531},"chapter_id":"c-jinshu-043-wangcheng","book_id":"b-jinshu-043","work_id":"w-jinshu","source_id":"s-jinshu-043-wangcheng"},{"id":"c-jinshu-043-wangcheng:line124","text":"初，澄命武陵諸郡同討杜弢，天門太守扈瑰次於益陽。武陵內史武察為其郡夷所害，瑰以孤軍引還。澄怒，以杜曾代瑰。夷袁遂，瑰故吏也，托為瑰報仇，遂舉兵逐曾，自稱平晉將軍。澄使司馬毌丘邈討之，為遂所敗。會元帝征澄為軍諮祭酒，於是赴召。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-043-wangcheng:line124:m0002","start":2,"end":3,"surface":"澄","kind":"person","person_id":"rlk_lzd_86c","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line124:m0010","start":10,"end":12,"surface":"杜弢","kind":"person","person_id":"7dv_udy_955","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line124:m0017","start":17,"end":19,"surface":"扈瑰","kind":"person","person_id":"g7z_wv3_w7q","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line124:m0028","start":28,"end":30,"surface":"武察","kind":"person","person_id":"tnh_zwd_djo","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng