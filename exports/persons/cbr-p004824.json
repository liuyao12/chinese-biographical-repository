on","aliases":[{"surface":"專諸之子","mention_ids":["c-shiji-086-cike:m007-0157"]}],"evidence":[{"mention_id":"c-shiji-086-cike:m007-0157","chapter_id":"c-shiji-086-cike","paragraph_id":"c-shiji-086-cike:p007","quote":"專諸之子"}]}],"source_mention_summary":[{"source_id":"s-shiji-086-cike","work_id":"w-shiji","book_id":"b-shiji-086","chapter_id":"c-shiji-086-cike","mention_count":1,"mention_ids":["c-shiji-086-cike:m007-0157"],"paragraph_ids":["c-shiji-086-cike:p007"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-086-cike"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-086-cike:m007-0157","start":157,"end":161,"surface":"專諸之子","kind":"person","person_id":"cbr-p004824","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p007","chapter_id":"c-shiji-086-cike"}],"relations":[{"id":"a-shiji086-008","subject_person_id":"cbr-p004824","predicate":"father","object_person_id":"cbr-p004816","status":"source_attested","evidence":[{"chapter_id":"c-shiji-086-cike","source_id":"s-shiji-086-cike","paragraph_id":"c-shiji-086-cike:p007","quote":"四月丙子，光伏甲士於窟室中，而具酒請王僚。王僚使兵陳自宮至光之家，門戸階陛左右，皆王僚之親戚也。夾立侍，皆持長鈹。酒既酣，公子光詳爲足疾，入窟室中，使專諸置匕首魚炙之腹中而進之。既至王前，專諸擘魚，因以匕首刺王僚，王僚立死。左右亦殺專諸，王人擾亂。公子光出其伏甲以攻王僚之徒，盡滅之，遂自立爲王，是爲闔閭。闔閭乃封專諸之子以爲上卿。"}],"qualifiers":{"source_term":"專諸之子","historicity":"historical_tradition"},"interpretation_note":"僅記錄明示父子、母、姊弟、兄弟及局部婚配來源主張；夷眛之子僚等異說尚待跨篇校核，母老子弱與季父不補未名世系。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji086-004","person_id":"cbr-p004824","title":"上卿","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-086-cike","source_id":"s-shiji-086-cike","paragraph_id":"c-shiji-086-cike:p007","quote":"四月丙子，光伏甲士於窟室中，而具酒請王僚。王僚使兵陳自宮至光之家，門戸階陛左右，皆王僚之親戚也。夾立侍，皆持長鈹。酒既酣，公子光詳爲足疾，入窟室中，使專諸置匕首魚炙之腹中而進之。既至王前，專諸擘魚，因以匕首刺王僚，王僚立死。左右亦殺專諸，王人擾亂。公子光出其伏甲以攻王僚之徒，盡滅之，遂自立爲王，是爲闔閭。闔閭乃封專諸之子以爲上卿。"}],"attestations":[{"id":"th-shiji086-004:a001","paragraph_id":"c-shiji-086-cike:p007","start":163,"end":165,"surface":"上卿","person_mention_id":"c-shiji-086-cike:m007-0157","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":"四月丙子","evidence":[{"chapter_id":"c-shiji-086-cike","source_id":"s-shiji-086-cike","paragraph_id":"c-shiji-086-cike:p007","quote":"四月丙子，光伏甲士於窟室中，而具酒請王僚。王僚使兵陳自宮至光之家，門戸階陛左右，皆王僚之親戚也。夾立侍，皆持長鈹。酒既酣，公子光詳爲足疾，入窟室中，使專諸置匕首魚炙之腹中而進之。既至王前，專諸擘魚，因以匕首刺王僚，王僚立死。左右亦殺專諸，王人擾亂。公子光出其伏甲以攻王僚之徒，盡滅之，遂自立爲王，是爲闔閭。闔閭乃封專諸之子以爲上卿。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"實際授任與文獻用稱分存；四月丙子依本段事件，不換算絕對年。皇帝其明年保留相對日期；上客為禮遇。懸賞金邑、職稱首見、死亡、被虜或亡逃不推定任期起訖。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji086-013","person_id":"cbr-p004824","scope":"same_chapter","chapter_ids":["c-shiji-086-cike"],"status":"contextual_provisional","rationale":"依專諸刺僚、公子光自立闔閭與豫讓報智伯敘事暫接。專諸之子、豫讓妻友保持未名；范中行氏與母老子弱未補名，嵌套對話指代待核。","reviewer":"Codex（AI 代理）","surfaces":["專諸之子"],"evidence":[{"paragraph_id":"c-shiji-086-cike:p007","quote":"四月丙子，光伏甲士於窟室中，而具酒請王僚。王僚使兵陳自宮至光之家，門戸階陛左右，皆王僚之親戚也。夾立侍，皆持長鈹。酒既酣，公子光詳爲足疾，入窟室中，使專諸置匕首魚炙之腹中而進之。既至王前，專諸擘魚，因以匕首刺王僚，王僚立死。左右亦殺專諸，王人擾亂。公子光出其伏甲以攻王僚之徒，盡滅之，遂自立爲王，是爲闔閭。闔閭乃封專諸之子以爲上卿。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-086-cike:p007","text":"四月丙子，光伏甲士於窟室中，而具酒請王僚。王僚使兵陳自宮至光之家，門戸階陛左右，皆王僚之親戚也。夾立侍，皆持長鈹。酒既酣，公子光詳爲足疾，入窟室中，使專諸置匕首魚炙之腹中而進之。既至王前，專諸擘魚，因以匕首刺王僚，王僚立死。左右亦殺專諸，王人擾亂。公子光出其伏甲以攻王僚之徒，盡滅之，遂自立爲王，是爲闔閭。闔閭乃封專諸之子以爲上卿。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-086-cike:m007-0005","start":5,"end":6,"surface":"光","kind":"person","person_id":"cbr-p004819","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m007-0007","start":7,"end":9,"surface":"甲士","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名氏稱