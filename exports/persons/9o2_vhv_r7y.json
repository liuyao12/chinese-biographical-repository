ns":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-065-wangdao-family:p001:m0112","start":112,"end":116,"surface":"東海王越","kind":"person","person_id":"9o2_vhv_r7y","status":"contextual_provisional","paragraph_id":"c-jinshu-065-wangdao-family:p001","chapter_id":"c-jinshu-065-wangdao-family"},{"id":"c-songshu-060-xunbozi:p004:m0122","start":122,"end":126,"surface":"東海王越","kind":"person","person_id":"9o2_vhv_r7y","status":"contextual_provisional","paragraph_id":"c-songshu-060-xunbozi:p004","chapter_id":"c-songshu-060-xunbozi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-jinshu065-cross-007","person_id":"9o2_vhv_r7y","surfaces":["東海王越"],"scope":"cross_chapter","chapter_ids":["c-jinshu-065-wangdao-family","c-songshu-060-xunbozi"],"status":"contextual_provisional","confidence_level":"medium","identification_basis":{"kind":"source_context","target_mention_ids":["c-jinshu-065-wangdao-family:p001:m0112","c-songshu-060-xunbozi:p004:m0122"]},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-065","source_id":"s-jinshu-065-wangdao-family","chapter_id":"c-jinshu-065-wangdao-family","paragraph_id":"c-jinshu-065-wangdao-family:p001","quote":"王導，字茂弘，光祿大夫覽之孫也。父裁，鎮軍司馬。導少有風鑒，識量清遠。年十四，陳留高士張公見而奇之，謂其從兄敦曰：「此兒容貌志氣，將相之器也。」初襲祖爵即丘子。司空劉實尋引爲東閣祭酒，遷秘書郎、太子舍人、尚書郎，並不行。後參東海王越軍事。"},{"work_id":"w-songshu","book_id":"b-songshu-060","source_id":"s-songshu-060-xunbozi","chapter_id":"c-songshu-060-xunbozi","paragraph_id":"c-songshu-060-xunbozi:p004","quote":"前散騎常侍江夏公衞璵上表自陳曰：「臣乃祖故太保瓘，於魏咸熙之中，太祖文皇帝為元輔之日，封蕭陽侯，大晉受禪，進爵為公，歷位太保，總錄朝政。于時賈庶人及諸王用事，忌瓘忠節，故楚王瑋矯詔致禍。前朝以瓘秉心忠正，加以伐蜀之勳，故追封蘭陵郡公。永嘉之中，東海王越食蘭陵，換封江夏，戶邑如舊。臣高祖散騎侍郎璪，瓘之嫡孫，纂承封爵。中宗元皇帝以曾祖故右衞將軍崇承襲，逮于臣身。伏聞祠部郎荀伯子表，欲貶降復封蕭陽。夫趙氏之忠，寵延累葉，漢祖開封，誓以山河。伏願陛下錄既往之勳，垂罔極之施，乞出臣表，付外參詳。」潁川陳茂先亦上表曰：「祠部郎荀伯子表臣七世祖太尉准禍加淮南，不應濫賞。尋先臣以剪除賈謐，封海陵公，事在淮南遇禍之前。後廣陵雖在擾攘之際，臣祖乃始蒙殊遇，歷位元、凱。後被遠外，乃作平州，而猶不至除國，良以先勳深重，百世不泯故也。聖明御世，英輔係興，曾無疑議，以為濫賞。臣以微弱，未齒人倫，加始勉視息，封爵兼嗣。伏願陛下遠錄舊勳，特垂矜察。」詔皆付門下，並不施行。"}],"rationale":"卷65參東海王越軍事與宋書荀勗對東海王越的比較，國爵、姓名及晉代背景一致，接現行人物，不憑國號另建重複人。","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-065-wangdao-family:p001","text":"王導，字茂弘，光祿大夫覽之孫也。父裁，鎮軍司馬。導少有風鑒，識量清遠。年十四，陳留高士張公見而奇之，謂其從兄敦曰：「此兒容貌志氣，將相之器也。」初襲祖爵即丘子。司空劉實尋引爲東閣祭酒，遷秘書郎、太子舍人、尚書郎，並不行。後參東海王越軍事。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-065-wangdao-family:p001:m0000","start":0,"end":2,"surface":"王導","kind":"person","person_id":"7r6_k52_qji_ABAA","status":"contextual_provisional"},{"id":"c-jinshu-065-wangdao-family:p001:m0004","start":4,"end":6,"surface":"茂弘","kind":"person","person_id":"7r6_k52_qji_ABAA","status":"contextual_provisional"},{"id":"c-jinshu-065-wangdao-family:p001:m0011","start":11,"end":12,"surface":"覽","kind":"person","person_id":"7r6_k52_qji_AB","status":"contextual_provisional"},{"id":"c-jinshu-065-wangdao-family:p001:m0017","start":17,"end":18,"surface":"裁","kind":"person","person_id":"7r6_k52_qji_ABA","status":"contextual_provisional"},{"id":"c-jinshu-065-wangdao-family:p001:m0024","start":24,"end":25,"surface":"導","kind":"person","person_id":"7r6_k52_qji_ABAA","status":"contextual_provisional"},{"id":"c-jinshu-065-wangdao-family:p001:m0043","start":43,"end":45,"surface":"張公","kind":"person","person_id":"gn6_ept_2w6","status":"contextual_provisional"},{"id":"c-jinshu-065-wangdao-family:p001:m0054","start":54,"end":55,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional"},{"id":"c-jinshu-065-wangdao-family:p001:m0058","start":58,"end":60,"surface":"此兒","kind":"person","person_id":"7r6_k52_qji_ABAA","status":"contextual_provisional"},{"id":"c-jinshu-065-wangdao-family:p001:m0082","start":82,"end":84,"surface":"劉實","kind":"person","person_id":"ohv_l50_sf5","status":"contextual_provisional"},{"id":"c-jinshu-065-wangdao-family:p001:role0087","start":87,"end":91,"surface":"東閣祭酒","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"引及遷官後總言並不行，未赴任。"},{"id":"c-jinshu-065-wangdao-family:p001:role0093","start":93,"end":96,"surface":"秘書郎","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"引及遷官後總言並不行，未赴任。"},{"id":"c-jinshu-065-wangdao-family:p001:role0097","start":97,"end":101,"surface":"太子舍人","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"引及遷官後總言並不行，未赴任。"},{"id":"c-jinshu-065-wangdao-family:p001:role0102","start":102,"end":105,"surface":"尚書郎","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"引及遷官後總言並不行，未赴任。"},{"id":"c-jinshu-065-wangdao-family:p001:m0112","start":112,"end":116,"surface":"東海王越","kind":"person","person_id":"9o2_vhv_r7y","status":"contextual_provisional"}],"source_position":{"first_line":12,"last_line":13,"revision_id":1756144,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-065-wangdao-family","book_id":"b-jinshu-065","work_id":"w-jinshu","source_id":"s-jinshu-065-wangdao-family"},{"id":"c-songshu-060-xunbozi:p004","text":"前散騎常侍江夏公衞璵上表自陳曰：「臣乃祖故太保瓘，於魏咸熙之中，太祖文皇帝為元輔之日，封蕭陽侯，大晉受禪，進爵為公，歷位太保，總錄朝政。于時賈庶人及諸王用事，忌瓘忠節，故楚王瑋矯詔致禍。前朝以瓘秉心忠正，加以伐蜀之勳，故追封蘭陵郡公。永嘉之中，東海王越食蘭陵，換封江夏，戶邑如舊。臣高祖散騎侍郎璪，瓘之嫡孫，纂承封爵。中宗元皇帝以曾祖故右衞將軍崇承襲，逮于臣身。伏聞祠部郎荀伯子表，欲貶降復封蕭陽。夫趙氏之忠，寵延累葉，漢祖開封，誓以山河。伏願陛下錄既往之勳，垂罔極之施，乞出臣表，付外參詳。」潁川陳茂先亦上表曰：「祠部郎荀伯子表臣七世祖太尉准禍加淮南，不應濫賞。尋先臣以剪除賈謐，封海陵公，事在淮南遇禍之前。後廣陵雖在擾攘之際，臣祖乃始蒙殊遇，歷位元、凱。後被遠外，乃作平州，而猶不至除國，良以先勳深重，百世不泯故也。聖明御世，英輔係興，曾無疑議，以為濫賞。臣以微弱，未齒人倫，加始勉視息，封爵兼嗣。伏願陛下遠錄舊勳，特垂矜察。」詔皆付門下，並不施行。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-songshu-060-xunbozi:p004:m0008","start":8,"end":10,"surface":"衞璵","kind":"person","person_id":"u2m_bus_e3h","status":"contextual_provisional"},{"id":"c-songshu-060-xunbozi:p004:m0018","start":18,"end":20,"surface":"乃祖","ki