on_id":"d-nanqi043-xieyue-wangyu","paragraph_id":"c-nanqishu-043-xieyue:p002","chapter_id":"c-nanqishu-043-xieyue"},{"id":"c-nanshi-024-wang-family:line047:m0168","start":168,"end":170,"surface":"王彧","kind":"person","person_id":"1tc_q18_x7v","status":"contextual_provisional","paragraph_id":"c-nanshi-024-wang-family:line047","chapter_id":"c-nanshi-024-wang-family"}],"relations":[],"title_holdings":[],"address_assertions":[{"status":"source_attested","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null,"id":"pa-liang015-xiefei-wang","person_id":"1tc_q18_x7v","relation":"source_locality_designation","place":{"source_name":"琅邪","place_id":null,"modern_identification":null},"source_term":"琅邪王景文","date_expression":null,"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-015","source_id":"s-liangshu015-ws1506954","chapter_id":"c-liangshu-015-xiefei","paragraph_id":"c-liangshu-015-xiefei:p001","quote":"謝朏字敬沖，陳郡陽夏人也。祖弘微，宋太常卿，父莊，右光祿大夫，並有名前代。朏幼聰慧，莊器之，常置左右。年十歲，能屬文。莊游土山賦詩，使朏命篇，朏攬筆便就。琅邪王景文謂莊曰：「賢子足稱神童，復爲後來特達。」莊笑，因撫朏背曰：「真吾家千金。」孝武帝游姑孰，勑莊攜朏從駕，詔使爲《洞井贊》，於坐奏之。帝曰：「雖小，奇童也。」","person_mention_id":"c-liangshu-015-xiefei:p001:m0079"}],"interpretation_note":"地名稱人之原詞，未明籍貫或居所，不改作出生地。","qualifiers":{"designation_kind":"geographical_person_reference","origin_or_residence":null}}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-liang015-xiefei-wangyu","person_id":"1tc_q18_x7v","surfaces":["王景文"],"scope":"cross_chapter","chapter_ids":["c-liangshu-015-xiefei","c-nanshi-024-wang-family"],"status":"contextual_provisional","evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-015","chapter_id":"c-liangshu-015-xiefei","source_id":"s-liangshu015-ws1506954","paragraph_id":"c-liangshu-015-xiefei:p001","quote":"謝朏字敬沖，陳郡陽夏人也。祖弘微，宋太常卿，父莊，右光祿大夫，並有名前代。朏幼聰慧，莊器之，常置左右。年十歲，能屬文。莊游土山賦詩，使朏命篇，朏攬筆便就。琅邪王景文謂莊曰：「賢子足稱神童，復爲後來特達。」莊笑，因撫朏背曰：「真吾家千金。」孝武帝游姑孰，勑莊攜朏從駕，詔使爲《洞井贊》，於坐奏之。帝曰：「雖小，奇童也。」"},{"work_id":"w-nanshi","book_id":"b-nanshi-024","source_id":"s-nanshi-024-wang-family","chapter_id":"c-nanshi-024-wang-family","paragraph_id":"c-nanshi-024-wang-family:line047","quote":"延之與金紫光祿大夫阮韜俱宋領軍將軍劉湛外甥，並有早譽，湛甚愛之，曰：「韜後當爲第一，延之爲次也。」延之甚不平。毎致餉下都，韜與朝士同例，高帝聞之，與延之書曰：「韜雲卿未嘗有別意，當由劉家月旦故邪。」韜字長明，陳留人，晉金紫光祿大夫裕玄孫也。爲南兗州別駕，刺史江夏王義恭逆求資費錢，韜曰：「此朝廷物。」執不與。宋孝武選侍中四人，並以風貌，王彧、謝莊爲一雙，韜與何偃爲一雙。常充兼假，至始興王師，卒。"}],"rationale":"王景文與父莊交遊、向孝武推薦幼朏；固定WYG宋085原253至269行明王景文琅邪臨沂、名與明帝諱同、少與謝莊齊名，與現宋孝武王彧謝莊一雙同人。正文王景文不靜改彧，非魏王凌掾同名王彧。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null,"external_reference_readings":[{"id":"r-song085-wangjingwen","title":"宋書卷85 WYG","revision_id":"e80c057667e3c8684f11d5088251e10244d5a264","url":"https://github.com/kanripo/KR2a0016/blob/e80c057667e3c8684f11d5088251e10244d5a264/KR2a0016_085.txt","raw_path":"source-evidence/liang015-xiefei-reading/external/song085-kanripo-fixed.txt","metadata_path":"source-evidence/liang015-xiefei-reading/external/song085-kanripo-metadata.json","raw_sha256":"ec55e60f6fd810955ca124d6369929c7e49f2092b64977ab85d082e03e9abeea","raw_start":5832,"raw_end":6231,"quote":"王景文琅邪臨沂人也名與明帝諱同祖穆臨海太守¶\n伯父智少簡貴有髙名髙祖甚重之常云見王智使人¶\n思仲祖與劉穆之謀討劉毅而智在焉它日穆之白髙¶\n祖曰伐國重事也公云何乃使王智知髙祖笑曰此人¶\n髙簡豈聞此輩論議其見知如此爲太尉咨議叅軍從¶\n征長安留爲桂陽公義真安西將軍司馬天水太守還¶\n<pb:KR2a0016_WYG_085-15a>¶\n爲宋國五兵尚書晉陵太守加秩中二千石封建陵縣¶\n五等子追贈太常父僧朗亦以謹實見知元嘉中爲侍¶\n中勤於朝直未甞違惰太祖嘉之以爲湘州刺史世祖¶\n大明末爲尚書左僕射太宗初以后父爲特進左光祿¶\n大夫又進開府儀同三司固讓乃加侍中特進尋薨追¶\n贈開府諡曰元公景文出繼智幼爲從叔球所知美風¶\n姿好言理少與陳郡謝莊齊名太祖甚相欽重故爲太¶\n宗娶景文妹而以景文名與太宗同髙祖第五女新安¶\n<pb:KR2a0016_WYG_085-15b>¶\n公主先適太原王景深離絶當以適景文固辭以疾故¶\n","text_layer":"received_chapter","read_scope":"僅王景文獨立傳起首原253至269行（含頁標），核名與明帝諱同及謝莊交遊；並非全卷校讀。","image_verified":false,"human_reviewed":false}]},{"id":"d-qi032-ruantao-wangyu","person_id":"1tc_q18_x7v","surfaces":["王彧"],"scope":"cross_chapter","chapter_ids":["c-nanqishu-032-ruantao","c-nanshi-024-wang-family"],"status":"contextual_provisional","confidence_level":"high","identification_basis":{"kind":"source_context","target_mention_ids":["c-nanqishu-032-ruantao:line094:m0014","c-nanshi-024-wang-family:line047:m0168"]},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-032","chapter_id":"c-nanqishu-032-ruantao","source_id":"s-nanqishu-032-ruantao","paragraph_id":"c-nanqishu-032-ruantao:line094","quote":"宋孝武選侍中四人，竝以風貌。王彧、謝莊爲一雙，韜與何偃爲一雙。常充兼假。泰始末，爲征南江州長史。桂陽王休範在鎮，數出行遊，韜性方峙，未嘗隨從。至散騎常侍，金紫光祿大夫，領始興王師。永明二年，卒。"},{"work_id":"w-nanshi","book_id":"b-nanshi-024","chapter_id":"c-nanshi-024-wang-family","source_id":"s-nanshi-024-wang-family","paragraph_id":"c-nanshi-024-wang-family:line047","quote":"延之與金紫光祿大夫阮韜俱宋領軍將軍劉湛外甥，並有早譽，湛甚愛之，曰：「韜後當爲第一，延之爲次也。」延之甚不平。毎致餉下都，韜與朝士同例，高帝聞之，與延之書曰：「韜雲卿未嘗有別意，當由劉家月旦故邪。」韜字長明，陳留人，晉金紫光祿大夫裕玄孫也。爲南兗州別駕，刺史江夏王義恭逆求資費錢，韜曰：「此朝廷物。」執不與。宋孝武選侍中四人，並以風貌，王彧、謝莊爲一雙，韜與何偃爲一雙。常充兼假，至始興王師，卒。"}],"rationale":"兩書同記宋孝武所選四侍中王彧與謝莊一雙、阮韜與何偃一雙。宋書王景文名與明帝諱同，明帝諱彧，故此王彧屬王景文身份；不與帝彧合人。","references":[{"title":"《宋書》卷85正文","url":"https://zh.wikisource.org/w/index.php?title=%E5%AE%8B%E6%9B%B8%2F%E5%8D%B785&oldid=2069101","source_revision":2069101,"quote":"王景文，琅邪臨沂人也。名與明帝諱同。","source_position":{"first_line":72,"last_line":72},"wikitext_sha256":"69128313de5d9e3a6bec92be7457d6749458b0c862ee563e22cd8e4dcb0392ea","image_verified":false},{"title":"《宋書》卷8正文","url":"https://zh.wikisource.org/w/index.php?oldid=2309997","source_revision":2309997,"quote":"太宗明皇帝諱彧","source_position":{"first_line":2,"last_line":2},"wikitext_sha256":"a4a72e52fc502f1fc8c275a54343ca8c594e57286f51496a6f18eb44425e8a05","image_verified":false}],"human_reviewed":false,"model":null},{"id":"d-nanqi043-xieyue-wangyu","person_id":"1tc_q18_x7v","surfaces":["王彧"],"scope":"cross_chapter","chapter_ids":["c-nanqishu-043-xieyue","c-nanshi-024-wang-family"],"status":"contextual_provisional","evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-043","chapter_id":"c-nanqishu-043-xieyue","source_id":"s-nanqishu043-ws2400356","paragraph_id":"c-nanqishu-043-xieyue:p002","quote":"𤅢年七歲，王彧見而異之，言於宋孝武，孝武召見於稠人廣衆之中，𤅢舉動閑詳，應對合旨，帝甚悅。詔尚公主，值景和敗，事寢。僕射褚淵聞𤅢年少清正不惡，以女結婚，厚爲資送。"},{"work_id":"w-nanshi","book_id":"b-nanshi-024","source_id":"s-nanshi-024-wang-family","chapter_id":"c-nanshi-024-wang-family","paragraph_id":"c-nanshi-024-wang-family:line047","quote":"延之與金紫光祿大夫阮韜俱宋領軍將軍劉湛外甥，並有早譽，湛甚愛之，曰：「韜後當爲第一，延之爲次也。」延之甚不平。毎致餉下都，韜與朝士同例，高帝聞之，與延之書曰：「韜雲卿未嘗有別意，當由劉家月旦故邪。」韜字長明，陳留人，晉金紫光祿大夫裕玄孫也。爲南兗州別駕，刺史江夏王義恭逆求資費錢，韜曰：「此朝廷物。」執不與。宋孝武選侍中四人，並以風貌，王彧、謝莊爲一雙，韜與何偃爲一雙。常充兼假，至始興王師，卒。"}],"rationale":"七歲𤅢獲王彧向宋孝武薦見；既錄南024宋孝武選侍中時王彧與謝莊一雙，正是同一帝朝與父莊交遊的王彧，非魏王凌掾同名王彧。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null}],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-015-xiefei:p001","unit_id":"xiefei-complete","text":"謝朏字敬沖，陳郡陽夏人也。祖弘微，宋太常卿，父莊，右光祿大夫，並有名前代。朏幼聰慧，莊器之，常置左右。年十歲，能屬文。莊游土山賦詩，使朏命篇，朏攬筆便就。琅邪王景文謂莊曰：「賢子足稱神童，復爲後來特達。」莊笑，因撫朏背曰：「真吾家千金。」孝武帝游姑孰，勑莊攜朏從駕，詔使爲《洞井贊》，於坐奏之。帝曰：「雖小，奇童也。」","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","source_position":{"first_line":11,"last_line":11,"revision_id":1506954,"editorial_excerpt_boundary":true},"mentions":[{"id":"c-liangshu-015-xiefei:p001:m0000","start":0,"end":2,"surface":"謝朏","kind":"person","person_id":"aa6_83c_juy_DBABAB","status":"contextual_provisional","interpretation_note":"依完整本傳敘事及身份閱讀記錄逐人辨識；原字不改，非由同字自動合併。","identity_decision_id":"d-liang015-xiefei-fei"},{"id":"c-liangshu-015-xiefei:p001:m0003","start":3,"end":5,"surface":"敬沖","kind":"person","person_id":"aa6_83c_juy_DBABAB","status":"contextual_provisional","interpretation_note":"依完整本傳敘事及身份閱讀記錄逐人辨識；原字不改，非由同字自動合併。","identity_decision_id":"d-liang015-xiefei-fei"},{"id":"c-liangshu-015-xiefei:p001:m0014","start":14,"end":16,"surface":"弘微","kind":"person","person_id":"aa6_83c_juy_DBAB","status":"contextual_provisional","interpretation_note":"依完整本傳敘事及身份閱讀記錄逐人辨識；原字不改，非由同字自動合併。","identity_decision_id":"d-liang015-xiefei-hongwei"},{"id":"c-liangshu-015-xiefei:p001:m0023","start":23,"end":24,"surface":"莊","kind":"person","person_id":"aa6_83c_juy_DBABA","status":"contextual_provisional","interpretation_note":"依完整本傳敘事及身份閱讀記錄逐人辨識；原字不改，非由同字自動合併。","identity_decision_id":"d-liang015-xiefei-zhuang"},{"id":"c-liangshu-01