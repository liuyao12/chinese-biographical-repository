:"1tc_q18_x7v","status":"contextual_provisional"},{"id":"c-nanshi-024-wang-family:line047:m0171","start":171,"end":173,"surface":"謝莊","kind":"person","person_id":"aa6_83c_juy_DBABA","status":"contextual_provisional"},{"id":"c-nanshi-024-wang-family:line047:m0177","start":177,"end":178,"surface":"韜","kind":"person","person_id":"03n_n2r_8rt_***A","status":"contextual_provisional"},{"id":"c-nanshi-024-wang-family:line047:m0179","start":179,"end":181,"surface":"何偃","kind":"person","person_id":"pbz_pni_tco","status":"contextual_provisional"},{"id":"c-nanshi-024-wang-family:line047:m0191","start":191,"end":194,"surface":"始興王","kind":"person","person_id":"el1_amk_djh","status":"contextual_provisional"}],"source_position":{"first_line":47,"last_line":47,"revision_id":1765279,"editorial_excerpt_boundary":false},"chapter_id":"c-nanshi-024-wang-family","book_id":"b-nanshi-024","work_id":"w-nanshi","source_id":"s-nanshi-024-wang-family"}],"sources":[{"chapter_id":"c-liangshu-015-xiefei","work_id":"w-liangshu","book_id":"b-liangshu-015","source_id":"s-liangshu015-ws1506954","source":{"title":"《梁書》卷十五謝朏完整本傳（含子諼、篹附傳）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=梁書/卷15&oldid=1506954","permalink":"https://zh.wikisource.org/w/index.php?title=梁書/卷15&oldid=1506954","revision_id":1506954,"accessed_on":"2026-10-21","extent":"原11至27行九完整段共1953原字，止29行謝覽獨立傳之前；非全卷，不匯入篇末姚察史論及現代校注。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄，保留數位歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，未核底本影像","response_sha256":"73a047d0a44ea0cf7fa9c04fbd63cf0568cd6d1a3616dcf2ac64936942dea064","wikitext_sha256":"0ae55481ce12880db956ce367fee817fd1cd64f07685408996c5f31f080ffff6","normalization":{"character_conversion":{},"extraction_note":"僅展YL連結為顯示年號、去每段兩全形縮排；原𤅢、俁、不治、後五年不改；表題弟子覽為paratext，非此單元正文提及。","verified_blank_line_gaps":[{"source_lines":[26,26],"raw_quote":"","raw_quote_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","revision_id":1506954}]}}},{"chapter_id":"c-nanqishu-032-ruantao","work_id":"w-nanqishu","book_id":"b-nanqishu-032","source_id":"s-nanqishu-032-ruantao","source":{"title":"《南齊書》卷32（阮韜傳）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E5%8D%97%E9%BD%8A%E6%9B%B8%2F%E5%8D%B732&oldid=1513918","permalink":"https://zh.wikisource.org/w/index.php?title=%E5%8D%97%E9%BD%8A%E6%9B%B8%2F%E5%8D%B732&oldid=1513918","revision_id":1513918,"accessed_on":"2026-10-19","extent":"阮韜傳完整兩原段；與同卷王延之傳分開，並非全卷完成。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，未親核底本影像","wikitext_sha256":"cc9c36ced8f64c3c359c76836ae56968c8a13c4a3b3c19a416575737314b0061","normalization":{"character_conversion":{},"extraction_note":"只去排版空白、展開原字形外殼及單參數年號模板及保留顯示字的維基連結外殼；數位ref另列，不改原字或標點，不以節題補姓名。","excerpts":[{"proposed_paragraph_id":"c-nanqishu-032-ruantao:line092","source_lines":[92,92],"raw_quote":"　　阮韜字長明，陳留人，晉金紫光祿大夫裕玄孫也。韜少歷清官，爲南兖州別駕，刺史江夏王劉義恭逆求資費錢，韜曰：「此朝廷物。」執不與。","raw_quote_sha256":"adb1fc0bc00f251d601003d4d3f553e95163bc24cf63e925449ea39243f1f3ec","selected_text_sha256":"61c91b43ee82932ccc015222861da398e638707a0d7dc563ccc5cdcd0fc4c2db","begin_anchor":"阮韜字長明，陳留人，晉金紫光祿大夫裕","end_anchor":"資費錢，韜曰：「此朝廷物。」執不與。"},{"proposed_paragraph_id":"c-nanqishu-032-ruantao:line094","source_lines":[94,94],"raw_quote":"　　宋孝武選侍中四人，竝以風貌。王彧、謝莊爲一雙，韜與何偃爲一雙。常充兼假。泰始末，爲征南江州長史。桂陽王休範在鎮，數出行遊，韜性方峙，未嘗隨從。至散騎常侍，金紫光祿大夫，領始興王師。{{YL|永明二年}}，卒。","raw_quote_sha256":"ab64ae4d39f2f4061eb5ca12a919c03d5bab29c8cacb2a7d192fe1ad51cadd92","selected_text_sha256":"f40955d4b0013c2bf83323217dd29596873bd05d55ab80e95c3f5f4dfe368e96","begin_anchor":"宋孝武選侍中四人，竝以風貌。王彧、謝","end_anchor":"光祿大夫，領始興王師。永明二年，卒。"}]},"response_sha256":"f428c7546fdd70a9eece664401433407aad6e45bcbe711a6d58ef8806c1b4ca0"}},{"chapter_id":"c-nanqishu-043-xieyue","work_id":"w-nanqishu","book_id":"b-nanqishu-043","source_id":"s-nanqishu043-ws2400356","source":{"title":"《南齊書》卷四十三謝𤅢完整本傳（含兄顥附傳）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=南齊書/卷43&oldid=2400356","permalink":"https://zh.wikisource.org/w/index.php?title=南齊書/卷43&oldid=2400356","revision_id":2400356,"accessed_on":"2026-10-21","extent":"原行53至67共八完整段，謝𤅢本傳含顥附傳；止王思遠傳前，非全卷。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留數位歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，未核底本影像","response_sha256":"3a6a97e651528165730c9449870379efdfddd44a36b17e7600fab6060b7b24ae","wikitext_sha256":"7a65e9b58b508ef0dbc64a4a650c99c30dcd94f8f13ea9a23d171f539174baed","normalization":{"character_conversion":{"{{!|𤅢|左「氵」右「𦿈」}}":"𤅢"},"extraction_note":"僅展開字形模板與YL日期連結，去兩全形縮排；不轉瀹、不改鞭除身或爲/爲等原字。"}}},{"chapter_id":"c-nanshi-024-wang-family","work_id":"w-nanshi","book_id":"b-nanshi-024","source_id":"s-nanshi-024-wang-family","source":{"title":"《南史》卷24（王氏跨史家系選段）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E5%8D%97%E5%8F%B2%2F%E5%8D%B724&oldid=1765279","permalink":"https://zh.wikisource.org/w/index.php?title=%E5%8D%97%E5%8F%B2%2F%E5%8D%B724&oldid=1765279","revision_id":1765279,"accessed_on":"2026-10-19","extent":"王裕之（敬弘）及本支子孫二十原段、王鎭之二原段與王弘之三原段；同卷其餘後裔與其他傳文未錄，不代表全卷或影像覆核完成。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，未親核底本影像","response_sha256":"8f93b7091bbe8f3a434fc429eb04f7e342fc7753d9a6b20e573da76a1f2c8a7c","wikitext_sha256":"8fd9281c1d58e066b75c0b6cce86fff07d6e11c8ad6426459f8e0f2139a29499","normalization":{"character_conversion":{},"extraction_note":"只展開維基不轉換字形外殼，保留升、鎭等原字；完整選段不改標點，不取數位節題作正文。","excerpts":[{"proposed_paragraph_id":"c-nanshi-024-wang-family:line015","source_lines":[15,15],"raw_quote":"敬弘少有清尚，起家本國左常侍、衞軍參軍。性恬靜，樂山水，求爲天門太守。及之郡，妻弟荊州刺史桓玄遣信要令過己，敬弘至巴陵，謂人曰：「靈寶正當欲見其姊，我不能爲桓氏贅婿。」乃遣別船送妻往江陵，彌年不迎。山郡無事，恣其遊適，意甚好之。後爲南平太守，去官，居作唐縣界。玄輔政及篡位，屢召不下。宋武帝以爲車騎從事中郎、徐州中從事史、征西將軍道規諮議參軍。時府主簿宗協亦有高趣，道規並以事外相期。嘗共酣飲，敬弘因醉失禮，爲外司所白，道規即更引還，重申初燕。","raw_quote_sha256":"b593cd7b050d4a4290703921b088c7c3b92d366d7eb159da72968bb403364701","selected_text_sha256":"b593cd7b050d4a4290703921b088c7c3b92d366d7eb159da72968bb403364701","begin_anchor":"敬弘少有清尚，起家本國左常侍、衞軍參","end_anchor":"爲外司所白，道規即更引還，重申初燕。"},{"proposed_paragraph_id":"c-nanshi-024-wang-family:line017","source_lines":[17,17],"raw_quote":"永初中，累遷吏部尚書，敬弘毎被召，即便祗奉，既到宜退，旋復解官。武帝嘉其志，不苟違也。除廬陵王師，加散騎常侍。自陳無德，不可師範令王，固讓不拜。","raw_quote_sha256":"6f95ddf518f393f79bf9f41f862ce59fdad399744dc018ab2f4be8f7f20b2504","selected_text_sha256":"6f95ddf518f393f79bf9f41f862ce59fdad399744dc018ab2f4be8f7f20b2504","begin_anchor":"永初中，累遷吏部尚書，敬弘毎被召，即","end_anchor":"。自陳無德，不可師範令王，固讓不拜。"},{"proposed_paragraph_id":"c-nanshi-024-wang-family:line019","source_lines":[19,19],"raw_quote":"元嘉三年，爲尚書僕射，關署文案，初不省讀。嘗豫聽訟，上問疑獄，敬弘不對。上變色問左右：「何故不以訊牒副僕射？」敬弘曰：「臣乃得訊牒讀之，正自不解。」上甚不悅。雖加禮敬，亦不以時務及之。六年，遷尚書令，固讓，表求還東。上不能奪。改授侍中、特進、左光祿大夫，給親信三十人。及東歸，車駕幸冶亭餞送。","raw_quote_sha256":"c91cd7ca80dd7e7829059331722c4dc23869fbbca966dbed3b1b3e86c1ef1e20","selected_text_sha256":"c91cd7ca80dd7e7829059331722c4dc23869fbbca966dbed3b1b3e86c1ef1e20","begin_anchor":"元嘉三年，爲尚書僕射，關署文案，初不","end_anchor":"親信三十人。及東歸，車駕幸冶亭餞送。"},{"proposed_paragraph_id":"c-nanshi-024-wang-family:line021","source_lines":[21,21],"raw_quote":"十二年，徵爲太子少傅，敬弘詣都上表固辭不拜，東歸，上時不豫，自力見焉。十六年，以爲左光祿大夫、開府儀同三司，侍中如故。又詣都表辭，竟不拜東歸。二十三年，復申前命，復辭。明年，薨于余杭之舍亭山，年八十八。順帝-{升}-明三年，追諡文貞公。","raw_quote_sha256":"9c69b34c0b7896e767299bbdfa18877218939268e292fcd3db9cb27c6efae12a","selected_text_sha256":"7bf728f50e9f23a80d1f214a37d5b9f968c4b01133b6cf62e5175de0da37a9c1","begin_anchor":"十二年，徵爲太子少傅，敬弘詣都上表固","end_anchor":"年八十八。順帝升明三年，追諡文貞公。"},{"proposed_paragraph_id":"c-nanshi-024-wang-family:line023","source_lines":[23,23],"raw_quote":"敬弘形狀短而起坐端方，桓玄謂之「彈棋發八勢」。所居舍亭山，林澗環周，備登臨之美，故時人謂之王東山。文帝嘗問爲政得失，對曰：「天下有道，庶人不議。」上高其言。左右嘗使二老婦女，戴五條辮，著青紋絝袼，飾以朱粉。女適尚書僕射何尚之弟述之。敬弘嘗往何氏看女，遇尚之不在，因寄齋中臥。俄頃尚之還，敬弘使二婦女守合，不聽尚之入，云：「正熱不堪相見，君可且去」。尚之於是移於他室。上將爲廬陵王納其女，辭曰：「臣女幼，既許孔淳之息。」子恢之被召爲祕書郎，敬弘爲求奉朝請，與恢之書曰：「彼-{祕}-書有限故有競，朝請無限故無競，吾欲使汝處不競之地。」文帝嘉之，並見許。","raw_quote_sha256":"182767f7fb760843bc8c622395374603be94645bc20efeb978f294079e933a68","selected_text_sha256":"6d87deecb2f748a3ee0fd429bf6ed0897977688140ba29b7396befe2e88822c7","begin_anchor":"敬弘形狀短而起坐端方，桓玄謂之「彈棋","end_anchor":"使汝處不競之地。」文帝嘉之，並見許。"},{"proposed_paragraph_id":"c-nanshi-024-wang-family:line025","source_lines":[25,25],"raw_quote":"敬弘見兒孫，歳中不過一再相見，見輒克日。未嘗教子孫學問，各隨所欲。人或問之，答曰：「丹朱不應乏教，甯越不聞被捶。」恢之位新安太守，嘗請假定省。敬弘克日見之，至日輒不果。假日將盡，恢之求辭，敬弘呼前至合，復不見。恢之於合外拜辭流涕而去。","raw_quote_sha256":"fd35e73d514abb9dbd3b3271e2bab857decfc012e95d7f7067afb53f7dcd9ddf","selected_text_sha256":"fd35e73d514abb9dbd3b3271e2bab857decfc012e95d7f7067afb53f7dcd9ddf","begin_anchor":"敬弘見兒孫，歳中不過一再相見，見輒克","end_anchor":"合，復不見。恢之於合外拜辭流涕而去。"},{"proposed_paragraph_id":"c-nanshi-024-wang-family:line029","source_lines":[29,29],"raw_quote":"恢之弟瓚之，位吏部尚書、金紫光祿大夫，諡貞子。瓚之弟-{升}-之，位都官尚書。瓚之子秀之。","raw_quote_sha256":"3c4dc767c06603f7f15c3bd4ebeac3598f8ff87396d025fee327c71640a4fc5b","selected_text_sha256":"f30c6fc644fb769bf1b6110b2e9c05a932d16ef1d4b40974435585511ae90890","begin_anchor":"恢之弟瓚之，位吏部尚書、金紫光祿大夫","end_anchor":"瓚之弟升之，位都官尚書。瓚之子秀之。"},{"proposed_paragraph_id":"c-nanshi-024-wang-family:line033","source_lines":[33,33],"raw_quote":"秀之字伯奮，幼時，祖父敬弘愛其風采。仕宋爲太子舍人。父卒，廬於墓側，服闋，復職。吏部尚書褚彥回欲與結婚，秀之不肯，以此頻爲兩府外兵參軍。後爲晉平太守，期年求還，或問其故，答曰：「此郡沃壤，珍阜日至，人所昧者財，財生則禍逐，智者不昧財，亦不逐禍。吾山資已足，豈可久留，以妨賢路。」乃上表請代。時人以爲王晉平恐富求歸。","raw_quote_sha256":"507c5227b836872c67cc5506dda16ec53856df397ce938c0ee86d1a38e801ae0","selected_text_sha256":"507c5227b836872c67cc5506dda16ec53856df397ce938c0ee86d1a38e801ae0","begin_anchor":"秀之字伯奮，幼時，祖父敬弘愛其風采。","end_anchor":"乃上表請代。時人以爲王晉平恐富求歸。"},{"proposed_paragraph_id":"c-nanshi-024-wang-family:line035","source_lines":[35,35],"raw_quote":"仕齊爲豫章王嶷驃騎長史。嶷於荊州立學，以秀之領儒林祭酒。武帝即位，累遷侍中祭酒，轉都官尚書。","raw_quote_sha256":"b1e98d5c769050cd6f35e1974b9730cf7acf6323525720540b069df51cb67d40","selected_text_sha256":"b1e98d5c769050cd6f35e1974b9730cf7acf6323525720540b069df51cb67d40","begin_anchor":"仕齊爲豫章王嶷驃騎長史。嶷於荊州立學","end_anchor":"武帝即位，累遷侍中祭酒，轉都官尚書。"},{"proposed_paragraph_id":"c-nanshi-024-wang-family:line037","source_lines":[37,37],"raw_quote":"秀之祖父敬弘性貞正，徐羨之、傅亮當朝，不與來往。及致仕隱呉興，與秀之父瓚之書，深勖以靜退。瓚之爲五兵尚書，未嘗詣一朝貴。江湛謂何偃曰：「王瓚之今便是朝隱。」及柳元景、顏師伯貴要，瓚之竟不侯之。至秀之爲尚書，又不與王儉款接。三世不事權貴，時人稱之。轉侍中，領射聲校尉。","raw_quote_sha256":"f608c519379dd660f741f53e8815b25c8903d09e94c6cf92fbe5f487595b4570","selected_text_sha256":"f608c519379dd660f741f53e8815b25c8903d09e94c6cf92fbe5f487595b4570","begin_anchor":"秀之祖父敬弘性貞正，徐羨之、傅亮當朝","end_anchor":"權貴，時人稱之。轉侍中，領射聲校尉。"},{"proposed_paragraph_id":"c-nanshi-024-wang-family:line039","source_lines":[39,39],"raw_quote":"出爲隨王鎭西長史、南郡內史。後爲輔國將軍、呉興太守。秀之先爲諸王長史、行事，便歎曰：「仲祖之識，見於已多。」便無復仕進，止營理舍亭山宅，有終焉之志。及除呉興郡，隱業所在，心願爲之。到郡修舊山，移置輜重。隆昌元年卒，遺令「朱服不得入棺，祭則酒脯而已。世人以僕妾直靈助哭，當由喪主不能淳至，欲以多聲相亂。魂而有靈，吾當笑之」。諡曰簡子。","raw_quote_sha256":"3aa102c898f2ed3cd656ebe23cb26ae0398ed6d38acee6e892c620ac0989c203","selected_text_sha256":"3aa102c898f2ed3cd656ebe23cb26ae0398ed6d38acee6e892c620ac0989c203","begin_anchor":"出爲隨王鎭西長史、南郡內史。後爲輔國","end_anchor":"亂。魂而有靈，吾當笑之」。諡曰簡子。"},{"proposed_paragraph_id":"c-nanshi-024-wang-family:line043","source_lines":[43,43],"raw_quote":"延之字希季，-{升}-之子也。少靜默，不交人事。仕宋爲司徒左長史。清貧，居宇穿漏，褚彥回以啟宋明帝，即敕材官爲起三間齋屋。曆吏部尚書，尚書左僕射。","raw_quote_sha256":"d4bca4e713ab04f137e941ee1167acd33ce84c45e74dd1633d3ff5394635bf1c","selected_text_sha256":"70b15a7e53cd264e7966913c3076b09ad8ba87a453f480143fcc9cae993e5e0d","begin_anchor":"延之字希季，升之子也。少靜默，不交人","end_anchor":"起三間齋屋。曆吏部尚書，尚書左僕射。"},{"proposed_paragraph_id":"c-nanshi-024-wang-family:line045","source_lines":[45,45],"raw_quote":"宋德既衰，齊高帝輔政，朝野之情，人懷彼此。延之與尚書令王僧虔中立無所去就。時人語曰：「二王居平，不送不迎。」高帝以此善之。-{升}-明三年，出爲江州刺史，加都督。齊建元元年，進號鎭南將軍。","raw_quote_sha256":"6663f3e48315acf22c23c76ab714e09a81707bc087fe37b55c91dc81afee6b79","selected_text_sha256":"482184f4bfd880cff41191e6a1ed6b24d898f9d5518ce5d8fe8198ab7348829e","begin_anchor":"宋德既衰，齊高帝輔政，朝野之情，人懷","end_anchor":"，加都督。齊建元元年，進號鎭南將軍。"},{"proposed_paragraph_id":"c-nanshi-024-wang-family:line047","source_lines":[47,47],"raw_quote":"延之與金紫光祿大夫阮韜俱宋領軍將軍劉湛外甥，並有早譽，湛甚愛之，曰：「韜後當爲第一，延之爲次也。」延之甚不平。毎致餉下都，韜與朝士同例，高帝聞之，與延之書曰：「韜雲卿未嘗有別意，當由劉家月旦故邪。」韜字長明，陳留人，晉金紫光祿大夫裕玄孫也。爲南兗州別駕，刺史江夏王義恭逆求資費錢，韜曰：「此朝廷物。」執不與。宋孝武選侍中四人，並以風貌，王彧、謝莊爲一雙，韜與何偃爲一雙。常充兼假，至始興王師，卒。","raw_quote_sha256":"f8cb8520c91de27727b20e5e2ffe29a1a290dcf0dc0602ea6fc6e5fc16232823","selected_text_sha256":"f8cb8520c91de27727b20e5e2ffe29a1a290dcf0dc0602ea6fc6e5fc16232823","begin_anchor":"延之與金紫光祿大夫阮韜俱宋領軍將軍劉","end_anchor":"偃爲一雙。常充兼假，至始興王師，卒。"},{"proposed_paragraph_id":"c-nanshi-024-wang-family:line049","source_lines":[49,49],"raw_quote":"延之居身簡素，清靜寡-{慾}-，凡所經歷，務存不擾。在江州，祿俸外一無所納。獨處齋內，未嘗出戸，吏人罕得見焉，雖子弟亦不妄前。時時見親舊，未嘗及世事，從容談詠而已。後爲尚書左僕射，尋領竟陵王師，卒諡簡子。","raw_quote_sha256":"6b5837e007de01923d88d407c0263fdeec8a9eeb1fe376035297f30168309f9e","selected_text_sha256":"70f13f22100aefa8921cea02b53ea821126780901763f5d48b0e94e7b92c61f7","begin_anchor":"延之居身簡素，清靜寡慾，凡所經歷，務","end_anchor":"尚書左僕射，尋領竟陵王師，卒諡簡子。"},{"proposed_paragraph_id":"c-nanshi-024-wang-family:line053","source_lines":[53,53],"raw_quote":"子綸之，字元章。爲安成王記室參軍，偃仰召會，退居僚末。司徒袁粲聞而歎曰：「格外之官，便今日爲重。」貴游居此位者，遂以不掌文記爲高，自綸之始也。齊永明中，歷位侍中，出爲豫章太守。下車祭徐孺子、許子將墓，圖畫陳蕃、華歆、謝鯤像於郡朝堂。爲政寬簡，稱良二千石。武帝幸琅邪城，綸之與光祿大夫全景文等二十一人坐不參承，爲有司奏免官。後位侍中、都官尚書，卒。自敬弘至綸之，並方嚴，皆克日乃見子孫，蓋家風也。","raw_quote_sha256":"94d0b66b42d12a0ae03c95ec83f7eaf7ba43c11b6c0bfb61db4996c1313cd57f","selected_text_sha256":"94d0b66b42d12a0ae03c95ec83f7eaf7ba43c11b6c0bfb61db4996c1313cd57f","begin_anchor":"子綸之，字元章。爲安成王記室參軍，偃","end_anchor":"，並方嚴，皆克日乃見子孫，蓋家風也。"},{"proposed_paragraph_id":"c-nanshi-024-wang-family:line057","source_lines":[57,57],"raw_quote":"綸之子昕，有業行，居父憂過禮。謝伷欲遣參之，孔珪曰：「何假參，此豈有全理。」以憂卒。","raw_quote_sha256":"fd44013650344bbfe94c202b136f99e45052bbf2d34ada1baf6726d99884f9b4","selected_text_sha256":"fd44013650344bbfe94c202b136f99e45052bbf2d34ada1baf6726d99884f9b4","begin_anchor":"綸之子昕，有業行，居父憂過禮。謝伷欲","end_anchor":"曰：「何假參，此豈有全理。」以憂卒。"},{"proposed_paragraph_id":"c-nanshi-024-wang-family:line061","source_lines":[61,61],"raw_quote":"峻字茂遠，秀之子也。少美風姿，善容止。仕齊爲桂陽內史。梁天監初，爲中書侍郎。武帝甚悅其風采，與陳郡謝覽同見賞擢。累遷侍中，吏部尚書。處選甚得名譽。","raw_quote_sha256":"69a3ba732fb845825bf5f585afb822ff0503230adc5bc98aabbf0d8f274bac8d","selected_text_sha256":"69a3ba732fb845825bf5f585afb822ff0503230adc5bc98aabbf0d8f274bac8d","begin_anchor":"峻字茂遠，秀之子也。少美風姿，善容止","end_anchor":"。累遷侍中，吏部尚書。處選甚得名譽。"},{"proposed_paragraph_id":"c-nanshi-024-wang-family:line063","source_lines":[63,63],"raw_quote":"峻性詳雅，無趨競心，嘗與謝覽約，官至侍中，不復謀進仕。覽自吏部尚書出爲呉興郡，平心不畏強禦，亦由處俗情薄故也。峻爲侍中已後，雖不退身，亦淡然自守，無所營務。遷金紫光祿大夫，未拜，卒，諡惠子。","raw_quote_sha256":"31bb89a6e0418bcfba786cba17eea9563cef042459b4e12ab5c48f7636985f23","selected_text_sha256":"31bb89a6e0418bcfba786cba17eea9563cef042459b4e12ab5c48f7636985f23","begin_anchor":"峻性詳雅，無趨競心，嘗與謝覽約，官至","end_anchor":"。遷金紫光祿大夫，未拜，卒，諡惠子。"},{"proposed_paragraph_id":"c-nanshi-024-wang-family:line067","source_lines":[67,67],"raw_quote":"子琮爲國子生，尚始興王女繁昌主。琮不慧，爲學生所嗤，遂離婚。峻謝王，王曰：「此自上意，僕極不願如此。」峻曰：「下官曾祖是謝仁祖外孫，亦不藉殿下姻媾爲門戸耳。」","raw_quote_sha256":"77facdc6b11b4769b8087797912799da9475e2b3f212f285f236b63b4f733773","selected_text_sha256":"77facdc6b11b4769b8087797912799da9475e2b3f212f285f236b63b4f733773","begin_anchor":"子琮爲國子生，尚始興王女繁昌主。琮不","end_anchor":"仁祖外孫，亦不藉殿下姻媾爲門戸耳。」"},{"proposed_paragraph_id":"c-nanshi-024-wang-family:line071","source_lines":[71,71],"raw_quote":"王鎭之字伯重，晉司州刺史胡之之從孫、而裕之從祖弟也。祖耆之，位中書郎，父隨之，上虞令。鎭之爲剡、上虞令，並有能名。桓玄輔晉，以爲大將軍録事參軍。時三呉饑荒，遣鎭之銜命賑恤，而會稽內史王愉不奉符旨，鎭之依事糾奏。愉子綏，玄之外甥，當時貴盛，鎭之爲所排抑。以母老求補安成太守，以母憂去職。在官清潔，妻子無以自反，乃棄家致喪還上虞舊墓。葬畢，爲子標之求安復令，隨子之官。服闋，爲征西道規司馬、南平太守。後爲御史中丞，執正不撓，百僚憚之。","raw_quote_sha256":"1663f7671a34ff552f75f8a27c1868d60004b2a923aafec74326deb32ef227eb","selected_text_sha256":"1663f7671a34ff552f75f8a27c1868d60004b2a923aafec74326deb32ef227eb","begin_anchor":"王鎭之字伯重，晉司州刺史胡之之從孫、","end_anchor":"。後爲御史中丞，執正不撓，百僚憚之。"},{"proposed_paragraph_id":"c-nanshi-024-wang-family:line073","source_lines":[73,73],"raw_quote":"出爲建威將軍、平越中郎將、廣州刺史，加都督。宋武帝謂人曰：「鎭之少著清績，必將繼美呉隱，嶺南弊俗，非此不康也。」在鎭不受俸祿，蕭然無營，去官之日，不異初至。武帝初建相國府，爲諮議參軍，領録事。善於吏職，嚴而不殘。遷宋台祠部尚書。武帝踐阼，卒于宣訓衞尉。弟弘之。","raw_quote_sha256":"917243bc095b02d700e1f49de9e82ab71749db532ef6ceb136d343b12b56964a","selected_text_sha256":"917243bc095b02d700e1f49de9e82ab71749db532ef6ceb136d343b12b56964a","begin_anchor":"出爲建威將軍、平越中郎將、廣州刺史，","end_anchor":"書。武帝踐阼，卒于宣訓衞尉。弟弘之。"},{"proposed_paragraph_id":"c-nanshi-024-wang-family:line077","source_lines":[77,77],"raw_quote":"弘之字方平，少孤貧，爲外祖征士何准所撫育，從叔獻之及太原王恭並貴重之。仕晉爲司徒主簿。家貧，性好山水，求爲烏傷令。桓玄輔晉，桓謙以爲衞軍參軍。時殷仲文還姑孰，祖送傾朝，謙要弘之同行，答曰：「凡祖離送別，必在有情，下官與殷風馬不接，無緣扈從。」謙貴其言。母隨兄鎭之之安成郡，弘之解職同行。義熙中，何無忌及宋武帝辟召，一無所就。","raw_quote_sha256":"2cbab424339b2570925ac4d820617613bbac249167e8d18dfdbdf722dd2cf485","selected_text_sha256":"2cbab424339b2570925ac4d820617613bbac249167e8d18dfdbdf722dd2cf485","begin_anchor":"弘之字方平，少孤貧，爲外祖征士何准所","end_anchor":"熙中，何無忌及宋武帝辟召，一無所就。"},{"proposed_paragraph_id":"c-nanshi-024-wang-family:line079","source_lines":[79,79],"raw_quote":"家在會稽上虞，從兄敬弘爲吏部尚書，奏弘之爲太子庶子，不就。文帝即位，敬弘爲尚書左僕射，陳弘之高行，徵爲通直散騎常侍，又不就。敬弘嘗解貂裘與之，即著以采藥。性好釣，上虞江有一處名三石頭，弘之常垂綸於此。經過者不識之，或問漁師得魚賣不？弘之曰：「亦自不得，得亦不賣。」日夕，載魚入上虞郭，經親故門，各以一兩頭置門內而去。始寧沃川有佳山水，弘之又依岩築室。謝靈運、顏延之並相欽重。靈運與廬陵王義真箋曰：「會境既豐山水，是以江左嘉遁，並多居之。至若王弘之拂衣歸耕，踰曆三紀，孔淳之隱約窮岫，自始迄今。阮萬齡辭事就閑，纂戎先業，既遠同羲、唐，亦激貪厲競。若遣一有以相存，真可謂千載盛美也。」","raw_quote_sha256":"d37396fddd4f41ae5854ffe13a0eeabe3af17c2892b2604ef37724948a52afe5","selected_text_sha256":"d37396fddd4f41ae5854ffe13a0eeabe3af17c2892b2604ef37724948a52afe5","begin_anchor":"家在會稽上虞，從兄敬弘爲吏部尚書，奏","end_anchor":"若遣一有以相存，真可謂千載盛美也。」"},{"proposed_paragraph_id":"c-nanshi-024-wang-family:line081","source_lines":[81,81],"raw_quote":"弘之元嘉四年卒，顏延之欲爲作誄，書與其子曇生曰：「君家高世之善，有識歸重，豫染豪翰，所應載述，況僕托慕末風，竊以敘德爲事，但恨短筆不足書美。」誄竟不就。","raw_quote_sha256":"4261000a268bc7dd13002ca82d105045181862b39fd34bde5b058fc08549b1db","selected_text_sha256":"4261000a268bc7dd13002ca82d105045181862b39fd34bde5b058fc08549b1db","begin_anchor":"弘之元嘉四年卒，顏延之欲爲作誄，書與","end_anchor":"爲事，但恨短筆不足書美。」誄竟不就。"}]}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true}}
