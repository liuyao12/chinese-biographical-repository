nanqi043-xieyue-yue"},{"id":"c-nanqishu-043-xieyue:p002:m0072","start":72,"end":73,"surface":"女","kind":"person","person_id":"n21_jh1_wtj","status":"contextual_provisional","interpretation_note":"p002褚淵聞𤅢…以女結婚厚爲資送，女屬褚淵，實際婚配𤅢。前句詔尚公主因景和敗事寢，不是此女或既成配偶。","identity_decision_id":"d-nanqi043-xieyue-wife"}],"chapter_id":"c-nanqishu-043-xieyue","book_id":"b-nanqishu-043","work_id":"w-nanqishu","source_id":"s-nanqishu043-ws2400356"},{"id":"c-nanshi-024-wang-family:line047","text":"延之與金紫光祿大夫阮韜俱宋領軍將軍劉湛外甥，並有早譽，湛甚愛之，曰：「韜後當爲第一，延之爲次也。」延之甚不平。毎致餉下都，韜與朝士同例，高帝聞之，與延之書曰：「韜雲卿未嘗有別意，當由劉家月旦故邪。」韜字長明，陳留人，晉金紫光祿大夫裕玄孫也。爲南兗州別駕，刺史江夏王義恭逆求資費錢，韜曰：「此朝廷物。」執不與。宋孝武選侍中四人，並以風貌，王彧、謝莊爲一雙，韜與何偃爲一雙。常充兼假，至始興王師，卒。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-nanshi-024-wang-family:line047:m0000","start":0,"end":2,"surface":"延之","kind":"person","person_id":"7r6_k52_qji_ABDABAACA","status":"contextual_provisional"},{"id":"c-nanshi-024-wang-family:line047:m0009","start":9,"end":11,"surface":"阮韜","kind":"person","person_id":"03n_n2r_8rt_***A","status":"contextual_provisional"},{"id":"c-nanshi-024-wang-family:line047:m0017","start":17,"end":19,"surface":"劉湛","kind":"person","person_id":"h3c_ulm_pto","status":"contextual_provisional"},{"id":"c-nanshi-024-wang-family:line047:m0027","start":27,"end":28,"surface":"湛","kind":"person","person_id":"h3c_ulm_pto","status":"contextual_provisional"},{"id":"c-nanshi-024-wang-family:line047:m0035","start":35,"end":36,"surface":"韜","kind":"person","person_id":"03n_n2r_8rt_***A","status":"contextual_provisional"},{"id":"c-nanshi-024-wang-family:line047:m0042","start":42,"end":44,"surface":"延之","kind":"person","person_id":"7r6_k52_qji_ABDABAACA","status":"contextual_provisional"},{"id":"c-nanshi-024-wang-family:line047:m0049","start":49,"end":51,"surface":"延之","kind":"person","person_id":"7r6_k52_qji_ABDABAACA","status":"contextual_provisional"},{"id":"c-nanshi-024-wang-family:line047:m0061","start":61,"end":62,"surface":"韜","kind":"person","p