address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji039-202","person_id":"j17_pm7_hng","surfaces":["王子虎"],"scope":"same_chapter","chapter_ids":["c-shiji-039-jin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-039-jin:p070","quote":"五月丁未，獻楚俘於周，駟介百乘，徒兵千。天子使王子虎命晉侯爲伯，賜大輅，彤弓矢百，玈弓矢千，秬鬯一卣，珪瓚，虎賁三百人。晉侯三辭，然后稽首受之。周作晉文侯命：「王若曰：父義和，丕顯文、武，能愼明德，昭登於上，布聞在下，維時上帝集厥命于文、武。恤朕身、繼予一人永其在位。」於是晉文公稱伯。癸亥，王子虎盟諸侯於王庭。"}],"rationale":"按本篇明示名與稱號、晉世系與具體事件暫定所列提及同指；附各段原文，未按同字短名全域合併；紀年與版本差異待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-039-jin:p070","text":"五月丁未，獻楚俘於周，駟介百乘，徒兵千。天子使王子虎命晉侯爲伯，賜大輅，彤弓矢百，玈弓矢千，秬鬯一卣，珪瓚，虎賁三百人。晉侯三辭，然后稽首受之。周作晉文侯命：「王若曰：父義和，丕顯文、武，能愼明德，昭登於上，布聞在下，維時上帝集厥命于文、武。恤朕身、繼予一人永其在位。」於是晉文公稱伯。癸亥，王子虎盟諸侯於王庭。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m070-0020","start":20,"end":22,"surface":"天子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m070-0023","start":23,"end":26,"surface":"王子虎","kind":"person","person_id":"j17_pm7_hng","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m070-0027","start":27,"end":29,"surface":"晉侯","kind":"person","person_id":"6di_ywz_ju4_AAA","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m070-0060","start":60,"end":62,"surface":"晉侯","kind":"person","person_id":"6di_ywz_ju4_AAA","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m070-0084","start":84,"end":87,"surface":"父義和","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m070-0090","start":90,"end":93,"surface":"文、武","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m070-0111","start":111,"end":113,"surface":"上帝","kind":"unresolved","