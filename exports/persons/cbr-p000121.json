_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-003-yin:p017","text":"中宗崩，子帝中丁立。帝中丁遷于隞，河亶甲居相，祖乙遷于邢。帝中丁崩，弟外壬立，是為帝外壬。仲丁書闕不具。帝外壬崩，弟河亶甲立，是為帝河亶甲。河亶甲時，殷復衰。河亶甲崩，子帝祖乙立。帝祖乙立，殷復興。巫賢任職。祖乙崩，子帝祖辛立。帝祖辛崩，弟沃甲立，是為帝沃甲。帝沃甲崩，立沃甲兄祖辛之子祖丁，是為帝祖丁。帝祖丁崩，立弟沃甲之子南庚，是為帝南庚。帝南庚崩，立帝祖丁之子陽甲，是為帝陽甲。帝陽甲之時，殷衰。","mentions":[{"id":"c-shiji-003-yin:m017-0000","start":0,"end":2,"surface":"中宗","kind":"person","person_id":"cbr-p000109","status":"source_identified"},{"id":"c-shiji-003-yin:m017-0005","start":5,"end":8,"surface":"帝中丁","kind":"person","person_id":"cbr-p000112","status":"source_identified"},{"id":"c-shiji-003-yin:m017-0010","start":10,"end":13,"surface":"帝中丁","kind":"person","person_id":"cbr-p000112","status":"source_identified"},{"id":"c-shiji-003-yin:m017-0017","start":17,"end":20,"surface":"河亶甲","kind":"person","person_id":"cbr-p000113","status":"source_identified"},{"id":"c-shiji-003-yin:m017-0023","start":23,"end":25,"surface":"祖乙","kind":"person","person_id":"cbr-p000114","status":"source_identified"},{"id":"c-shiji-003-yin:m017-0029","start":29,"end":32,"surface":"帝中丁","kind":"person","person_id":"cbr-p000112","status":"source_identified"},{"id":"c-shiji-003-yin:m017-0035","start":35,"end":37,"surface":"外壬","kind":"person","person_id":"cbr-p000115","status":"source_identified"},{"id":"c-shiji-003-yin:m017-0041","start":41,"end":44,"surface":"帝外壬","kind":"person","person_id":"cbr-p000115","status":"source_identified"},{"id":"c-shiji-003-yin:m017-0052","start":52,"end":55,"surface":"帝外壬","kind":"person","person_id":"cbr-p000115","status":"source_identified"},{"id":"c-shiji-003-yin:m017-0058","start":58,"end":61,"surface":"河亶甲","kind":"person","person_id":"cbr-p000113","status":"source_identified"},{"id":"c-shiji-003-yin:m017-0065","start":65,"end":69,"surface":"帝河亶甲","kind":"person","person_id":"cbr-p000113","status":"source_identified"},{"id":"c-shiji-003-yin:m017-0070","start":70,"end":73,"surface":"河亶甲","kind":"person","person_id":"cbr-p000113",