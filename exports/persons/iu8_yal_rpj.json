textual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-sanguozhi-052-buzhi-complete:line086-pei01-01","chapter_id":"c-sanguozhi-052-buzhi-complete"}],"relations":[],"title_holdings":[{"id":"th-wu052-bz-10","person_id":"iu8_yal_rpj","title":"征羌令","kind":"office","mode":"attestation","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-052","chapter_id":"c-sanguozhi-052-buzhi-complete","source_id":"s-sanguozhi-052-buzhi-complete","paragraph_id":"c-sanguozhi-052-buzhi-complete:line086-pei01-01","quote":"吳錄曰：征羌名矯，嘗為征羌令。","person_mention_id":"c-sanguozhi-052-buzhi-complete:line086-pei01-01:m0004"}],"attestations":[{"id":"th-wu052-bz-10:a","paragraph_id":"c-sanguozhi-052-buzhi-complete:line086-pei01-01","start":11,"end":14,"surface":"征羌令","person_mention_id":"c-sanguozhi-052-buzhi-complete:line086-pei01-01:m0004","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-052-buzhi-complete:line086","text":"會稽焦征羌，郡之豪族，人客放縱。騭與旌求食其地，懼爲所侵。乃共修刺奉瓜，以獻征羌。征羌方在內臥，駐之移時，旌欲委去。騭止之曰：「本所以來，畏其強也。而今捨去，欲以爲高，只結怨耳。」良久，征羌開牖見之，身隱几坐帳中，設席致地，坐騭、旌於牖外，旌愈恥之，騭辭色自若。征羌作食，身享大案，殽膳重沓，以小盤飯與騭、旌，惟菜茹而已。旌不能食，騭極飯致飽乃辭出。旌怒騭曰：「何能忍此？」騭曰：「吾等貧賤，是以主人以貧賤遇之，固其宜也，當何所恥？」","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-sanguozhi-052-buzhi-complete:line086:m0002","start":2,"end":5,"surface":"焦征羌","kind":"person","person_id":"iu8_yal_rpj","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line086:m0016","start":16,"end":17,"surface"