{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"is4_hi1_0mc","canonical_person_id":"is4_hi1_0mc","id_aliases":["cbr-p000984"],"identity_policy":"contextual_provisional","person_ids":["is4_hi1_0mc"],"persons":[{"id":"is4_hi1_0mc","label":"發根（游水人）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"游水發根","mention_ids":["c-shiji-012-wudi:m014-0026"]}],"evidence":[{"mention_id":"c-shiji-012-wudi:m014-0026","chapter_id":"c-shiji-012-wudi","paragraph_id":"c-shiji-012-wudi:p014","quote":"游水發根"}],"id_aliases":["cbr-p000984"]}],"source_mention_summary":[{"source_id":"s-shiji-012-wudi","work_id":"w-shiji","book_id":"b-shiji-012","chapter_id":"c-shiji-012-wudi","mention_count":1,"mention_ids":["c-shiji-012-wudi:m014-0026"],"paragraph_ids":["c-shiji-012-wudi:p014"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-012-wudi"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-012-wudi:m014-0026","start":26,"end":30,"surface":"游水發根","kind":"person","person_id":"is4_hi1_0mc","status":"contextual_provisional","paragraph_id":"c-shiji-012-wudi:p014","chapter_id":"c-shiji-012-wudi"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-012-wudi:p014","text":"文成死明年，天子病鼎湖甚，巫醫無所不致，（至）不愈。游水發根乃言曰：「上郡有巫，病而鬼下之。」上召置祠之甘泉。及病，使人問神君。神君言曰：「天子毋憂病。病少愈，彊與我會甘泉。」於是病愈，遂幸甘泉，病良已。大赦天下，置壽宮神君。神君最貴者（大夫）［太一］，其佐曰大禁、司命之屬，皆從之。非可得見，聞其音，與人言等。時去時來，來則風肅然也。居室帷中。時晝言，然常以夜。天子祓，然後入。因巫為主人，關飲食。所欲者言行下。又置壽宮、北宮，張羽旗，設供具，以禮神君。神君所言，上使人受書其言，命之曰「畫法」。其所語，世俗之所知也，毋絕殊者，而天子獨喜。其事祕，世莫知也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-012-wudi:m014-0000","start":0,"end":2,"surface":"文成","kind":"person","person_id":"zg6_76t_xid","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m014-0006","start":6,"end":8,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m014-0026","start":26,"end":30,"surface":"游水發根","kind":"person","person_id":"is4_hi1_0mc","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m014-0035","start":35,"end":39,"surface":"上郡有巫","kind":"unresolved","person_id":null,"status":"unresolved","note":"神祇、群體、匿名者或未定指代，保留來源，不補未見姓名與成員。"},{"id":"c-shiji-012-wudi:m014-0061","start":61,"end":63,"surface":"神君","kind":"unresolved","person_id":null,"status":"unresolved","note":"神祇、群體、匿名者或未定指代，保留來源，不補未見姓名與成員。"},{"id":"c-shiji-012-wudi:m014-0064","start":64,"end":66,"surface":"神君","kind":"unresolved","person_id":null,"status":"unresolved","note":"神祇、群體、匿名者或未定指代，保留來源，不補未見姓名與成員。"},{"id":"c-shiji-012-wudi:m014-0070","start":70,"end":72,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m014-0110","start":110,"end":112,"surface":"神君","kind":"unresolved","person_id":null,"status":"unresolved","note":"神祇、群體、匿名者或未定指代，保留來源，不補未見姓名與成員。"},{"id":"c-shiji-012-wudi:m014-0113","start":113,"end":115,"surface":"神君","kind":"unresolved","person_id":null,"status":"unresolved","note":"神祇、群體、匿名者或未定指代，保留來源，不補未見姓名與成員。"},{"id":"c-shiji-012-wudi:m014-0118","start":118,"end":126,"surface":"（大夫）［太一］","kind":"unresolved","person_id":null,"status":"unresolved","note":"神祇、群體、匿名者或未定指代，保留來源，不補未見姓名與成員。"},{"id":"c-shiji-012-wudi:m014-0130","start":130,"end":132,"surface":"大禁","kind":"unresolved","person_id":null,"status":"unresolved","note":"神祇、群體、匿名者或未定指代，保留來源，不補未見姓名與成