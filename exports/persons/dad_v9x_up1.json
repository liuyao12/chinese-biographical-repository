037,2038,2039,2040,2041,2042,2043,2044,2045,2046,2047,2048,2049,2050,2051,2052,2053,2054,2055,2056,2057,2058,2059,2060,2061,2062,2063,2064,2065,2066,2067,2068,2069,2070,2071,2072,2073,2074,2075,2076,2077,2078,2079,2080,2081,2082,2083,2084,2085,2086,2087,2088,2089,2090,2091,2092,2093,2094,2095,2096,2097,2098,2099,2100,2101,2102,2103,2104,2105,2106,2107,2108,2109,2110,2111,2112,2113,2114,2115,2116,2117,2118,2119,2120,2121,2122,2123,2124,2125,2126,2127,2128,2129,2130,2131,2132,2133,2134,2135,2136,2137,2138,2139,2140,2141,2142,2143,2144,2145,2146,2147,2148,2149,2150,2151,2152,2153,2154,2155,2156,2157,2158,2159,2160]},"chapter_id":"c-sanguozhi-051-huan","book_id":"b-sanguozhi-051","work_id":"w-sanguozhi","source_id":"s-sanguozhi-051-huan"},{"id":"c-sanguozhi-051-huan:line027-pei01-01","text":"《江表傳》曰：初權在武昌，欲還都建業，而慮水道溯流二千里，一旦有警，不相赴及，以此懷疑。及至夏口，於塢中大會百官議之，詔曰：「諸將吏勿拘位任，其有計者，為國言之。」諸將或陳宜立柵柵夏口，或言宜重設鐵鎖者，權皆以為非計。時梁為小將，未有知名，乃越席而進曰：「臣聞香餌引泉魚，重幣購勇士，今宜明樹賞罰之信，遣將入沔，與敵爭利，形勢既成，彼不敢干也。使武昌有精兵萬人，付智略者任將，常使嚴整。一旦有警，應聲相赴。作甘水城，輕艦數千，諸所宜用，皆使備具。如此開門延敵，敵自不來矣。」權以梁計為最得，即超增梁位。後稍以功進至沔中督。","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-051-huan:line027-pei01-01:m0008","start":8,"end":9,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-huan:line027-pei01-01:m0102","start":102,"end":103,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-huan:line027-pei01-01:m0110","start":110,"end":111,"surface":"梁","kind":"person","person_id":"dad_v9x_up1","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-huan:line027-pei01-01:m0237","start":237,"end":238,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-huan:line027-pei01-01:m0239","start":239,"end":240,"surface":"梁","kind":"person","person_id":"dad_v9x_up1","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-huan:line027-pei01-01:m0248","start":248,"end":249,"surface":"梁","kind":"person","person_id":"dad_v9x_up1","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"}],"annotation_status":"reviewed","source_position":{"first_line":27,"last_line":27,"revision_id":12758417,"raw_start":2165,"raw_end":2430,"character_positions":[2165,2168,2169,2170,2173,2174,2175,2176,2177,2178,2179,2180,2181,2182,2183,2184,2185,2186,2187,2188,2189,2190,2191,2192,2193,2194,2195,2196,2197,2198,2199,2200,2201,2202,2203,2204,2205,2206,2207,2208,2209,2210,2211,2212,2213,2214,2215,2216,2217,2218,2219,2220,2221,2222,2223,2224,2225,2226,2227,2228,2229,2230,2231,2232,2233,2234,2235,2236,2237,2238,2239,2240,2241,2242,2243,2244,2245,2246,2247,2248,2249,2250,2251,2252,2253,2254,2255,2256,2257,2258,2259,2260,2261,2262,2263,2264,2265,2266,2267,2268,2269,2270,2271,2272,2273,2274,2275,2276,2277,2278,2279,2280,2281,2282,2283,2284,2285,2286,2287,2288,2289,2290,2291,2292,2293,2294,2295,2296,2297,2298,2299,2300,2301,2302,2303,2304,2305,2306,2307,2308,2309,2310,2311,2312,2313,2314,2315,2316,2317,2318,2319,2320,2321,2322,2323,2324,2325,2326,2327,2328,2329,2330,2331,2332,2333,2334,2335,2336,2337,2338,2339,2340,2341,2342,2343,2344,2345,2346,2347,2348,2349,2350,2351,2352,2353,2354,2355,2356,2357,2358,2359,2360,2361,2362,2363,2364,2365,2366,2367,2368,2369,2370,2371,2372,2373,2374,2375,2376,2377,2378,2379,2380,2381,2382,2383,2384,2385,2386,2387,2388,2389,2390,2391,2392,2393,2394,2395,2396,2397,2398,2399,2400,2401,2402,2403,2404,2405,2406,2407,2408,2409,2410,2411,2412,2413,2414,2415,2416,2417,2418,2419,2420,2421,2422,2423,2424,2425,2426,2427,2428,2429]},"attribution":{"annotator":"裴松之","attribution_kind":"quoted_work","source_label":"江表傳","attribution_marker":"《江表傳》曰：","quoted_work":"江表傳"},"attachment":{"received_paragraph_id":"c-sanguozhi-051-huan:line027","received_codepoint":215,"note_ordinal":1,"source_ordinal":1},"chapter_id":"c-sanguozhi-051-huan","book_id":"b-sanguozhi-051","work_id":"w-sanguozhi","source_id":"s-sanguozhi-051-huan"},{"id":"c-sanguozhi-051-jiao:line018","text":"　　孫皎字叔朗，始拜護軍校尉，領眾二千餘人。是時曹公數出濡須，皎每赴拒，號為精銳。遷都護征虜將軍，代程普督夏口。黃蓋及兄瑜卒，又並其軍。賜沙羨、雲杜、南新市、竟陵為奉邑。自置長吏。輕財能施，善於交結，與諸葛瑾至厚。委廬江劉靖以得失，江夏李允以眾事，廣陵吳碩、河南張梁以軍旅，而傾心親待，莫不自盡。皎嘗遣兵候獲魏邊將吏美女以進皎，皎更其衣服送還之，下令曰：「今所誅者曹氏，其百姓何罪？自今以往，不得擊其老弱。」由是江淮間多歸附者。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-051-jiao:line018:m0002","start":2,"end":4,"surface":"孫皎","kind":"person","person_id":"y4x_cmp_976_B","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-jiao:line018:m0005","start":5,"end":7,"surface":"叔朗","kind":"person","person_id":"y4x_cmp_976_B","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-jiao:line018:m0024","start":24,"end":26,"surface":"曹公","kind":"person","person_id":"dad_b77_b38","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-jiao:line018:m0031","start":31,"end":32,"surface":"皎","kind":"person","person_id":"y4x_cmp_976_B","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-jiao:line018:m0050","start":50,"end":52,"surface":"程普","kind":"person","person_id":"p6n_a0q_flh","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-jiao:line018:m0056","start":56,"end":58,"surface":"黃蓋","kind":"person","person_id":"iby_117_6rw","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-jiao:line018:m0060","start":60,"end":61,"surface":"瑜","kind":"person","person_id":"y4x_cmp_976_A","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-jiao:line018:m0101","start":101,"end":104,"surface":"諸葛瑾","kind":"person","person_id":"lpo_z63_vzb","status":"contextual_provisional",