l_provisional"},{"id":"c-shiji-085-lubuwei:m013-0020","start":20,"end":22,"surface":"秦王","kind":"person","person_id":"cbr-p004796","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m013-0023","start":23,"end":25,"surface":"秦王","kind":"person","person_id":"cbr-p004796","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m013-0027","start":27,"end":29,"surface":"太后","kind":"person","person_id":"cbr-p004798","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m013-0039","start":39,"end":42,"surface":"文信侯","kind":"person","person_id":"cbr-p004790","status":"contextual_provisional"}],"chapter_id":"c-shiji-085-lubuwei","book_id":"b-shiji-085","work_id":"w-shiji","source_id":"s-shiji-085-lubuwei"},{"id":"c-shiji-085-lubuwei:p015","text":"始皇十九年，太后薨，謚為帝太后，與莊襄王會葬茝陽。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-085-lubuwei:m015-0000","start":0,"end":2,"surface":"始皇","kind":"person","person_id":"cbr-p004796","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m015-0006","start":6,"end":8,"surface":"太后","kind":"person","person_id":"cbr-p004798","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m015-0012","start":12,"end":15,"surface":"帝太后","kind":"person","person_id":"cbr-p004798","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m015-0017","start":17,"end":20,"surface":"莊襄王","kind":"person","person_id":"cbr-p004794","status":"contextual_provisional"}],"chapter_id":"c-shiji-085-lubuwei","book_id":"b-shiji-085","work_id":"w-shiji","source_id":"s-shiji-085-lubuwei"},{"id":"c-shiji-085-lubuwei:p016","text":"太史公曰：不韋及嫪毐貴，封號文信侯。人之告嫪毐，毐聞之。秦王驗左右，未發。上之雍郊，毐恐禍起，乃與黨謀，矯太后璽發卒以反蘄年宮。發吏攻毐，毐敗亡走，追斬之好畤，遂滅其宗。而呂不韋由此絀矣。孔子之所謂「聞」者，其呂子乎？","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-085-lubuwei:m016-0000","start":0,"end":3,"surface":"太史公","kind":"person","person_id":"cbr-p004810","status":"contextual_provisional"},{"