:true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-059-he:line036:m0110","start":110,"end":112,"surface":"薛珝","kind":"person","person_id":"kpq_tg0_zwl","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-059-he:line036","chapter_id":"c-sanguozhi-059-he"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-059-he:line036","text":"孫休立，封和子皓爲烏程侯，自新都之本國。休薨，皓即阼，其年追謚父和曰文皇帝，改葬明陵，置園邑二百家，令、丞奉守。後年正月，又分吳郡、丹楊九縣爲吳興郡，治烏程，置太守，四時奉祠。有司奏言，宜立廟京邑。寶鼎二年七月，使守大匠薛珝營立寢堂，號曰清廟。十二月，遣守丞相孟仁、太常姚信等備官寮中軍步騎二千人，以靈輿法駕，東迎神於明陵。皓引見仁，親拜送於庭。靈輿當至，使丞相陸凱奉三牲祭於近郊，皓於金城外露宿。明日，望拜於東門之外。其翌日，拜廟薦祭，歔欷悲感。比七日三祭，倡技晝夜娛樂。有司奏言「祭不欲數，數則黷，宜以禮斷情」，然後止。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-059-he:line036:m0000","start":0,"end":2,"surface":"孫休","kind":"person","person_id":"0fo_c5c_4yh","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line036:m0005","start":5,"end":6,"surface":"和","kind":"person","person_id":"572_278_cba_A","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line036:m0007","start":7,"end":8,"surface":"皓","kind":"person","person_id":"05e_9bb_55a","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line036:m0020","start":20,"end":21,"surface":"休","kind":"person","person_id":"0fo_c5c_4yh","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line036:m0023","start":23,"end":24,"surface":"皓","kind":"person","person_id":"05e_9bb_55a","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line036:m0032","start":32,"end":33,"surface":"和","kind":"person","pe