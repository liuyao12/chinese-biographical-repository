:[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"id":"name-jin098-yuquan-literal","person_id":"ft4_s3e_6e3","surname":"鬻","ming":"拳","hao":null,"title":null,"additional_names":[],"chapter_id":"c-jinshu-098-wangdun-comparison","paragraph_id":"c-jinshu-098-wangdun-comparison:p023","person_mention_id":"c-jinshu-098-wangdun-comparison:p023:m0089","source_anchor":{"start":89,"end":91,"surface":"鬻拳"},"quote":"先帝以聖德應運，創業江東，司徒導首居心膂，以道翼讚。故大將軍敦參處股肱，或內或外，夾輔之勳，與有力焉。階緣際會，遂據上宰，杖節專征，委以五州。刁協、劉隗立朝不允，敦抗義致討，情希鬻拳，兵雖犯順，猶嘉乃誠，禮秩優崇，人臣無貳。事解之後，劫掠城邑，放恣兵人，侵及宮省；背違赦信，誅戮大臣；縱凶極逆，不朝而退。六合阻心，人情同憤。先帝含垢忍恥，容而不責，委任如舊，禮秩有加。朕以不天，尋丁酷罰，煢煢在疚，哀悼靡寄。而敦曾無臣子追遠之誠，又無輔孤同獎之操，繕甲聚兵，盛夏來至，輒以天官假授私屬，將以威脅朝廷，傾危宗社。朕湣其狂戾，冀其覺悟，故且含隱以觀其終。而敦矜其不義之強，有侮弱朝廷之志，棄親用羈，背賢任惡。錢鳳豎子，專為謀主，逞其凶慝，誣罔忠良。周嵩亮直，讜言致禍；周劄、周莚累世忠義，聽受讒構，殘夷其宗。秦人之酷，刑不過五。敦之誅戮，傍濫無辜，滅人之族，莫知其罪。天下駭心，道路以目。神怒人怨，篤疾所嬰，昏荒悖逆，日以滋其，輒立兄息以自承代，多樹私黨，莫非同惡，未有宰相繼體而不由王命者也。頑凶相獎，無所顧忌，擅錄冶工，輒割運漕，志騁凶醜，以窺神器。社稷之危，匪夕則旦。天下長奸，敦以隕斃。鳳承凶宄，彌復煽逆。是可忍也，孰不可忍也！","status":"source_attested","human_reviewed":false,"model":null,"work_id":"w-jinshu","book_id":"b-jinshu-098","source_id":"s-jinshu098-wangdun-ws2614273-comparison"}],"mentions":[{"id":"c-jinshu-098-wangdun-comparison:p023:m0089","start":89,"end":91,"surface":"鬻拳","person_id":"ft4_s3e_6e3","kind":"person","paragraph_id":"c-jinshu-098-wangdun-comparison:p023","chapter_id":"c-jinshu-098-wangdun-comparison"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-098-wangdun-comparison:p023","text":"先帝以聖德應運，創業江東，司徒導首居心膂，以道翼讚。故大將軍敦參處股肱，或內或外，夾輔之勳，與有力焉。階緣際會，遂據上宰，杖節專征，委以五州。刁協、劉隗立朝不允，敦抗義致討，情希鬻拳，兵雖犯順，猶嘉乃誠，禮秩優崇，人臣無貳。事解之後，劫掠城邑，放恣兵人，侵及宮省；背違赦信，誅戮大臣；縱凶極逆，不朝而退。六合阻心，人情同憤。先帝含垢忍恥，容而不責，委任如舊，禮秩有加。朕以不天，尋丁酷罰，煢煢在疚，哀悼靡寄。而敦曾無臣子追遠之誠，又無輔孤同獎之操，繕甲聚兵，盛夏來至，輒以天官假授私屬，將以威脅朝廷，傾危宗社。朕湣其狂戾，冀其覺悟，故且含隱以觀其終。而敦矜其不義之強，有侮弱朝廷之志，棄親用羈，背賢任惡。錢鳳豎子，專為謀主，逞其凶慝，誣罔忠良。周嵩亮直，讜言致禍；周劄、周莚累世忠義，聽受讒構，殘夷其宗。秦人之酷，刑不過五。敦之誅戮，傍濫無辜，滅人之族，莫知其罪。天下駭心，道路以目。神怒人怨，篤疾所嬰，昏荒悖逆，日以滋其，輒立兄息以自承代，多樹私黨，莫非同惡，未有宰相繼體而不由王命者也。頑凶相獎，無所顧忌，擅錄冶工，輒割運漕，志騁凶醜，以窺神器。社稷之危，匪夕則旦。天下長奸，敦以隕斃。鳳承凶宄，彌復煽逆。是可忍也，孰不可忍也！","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","source_position":{"first_line":55,"last_line":55,"revision_id":2614273,"raw_projection_ref":"source-evidence/jin098-wangdun-comparison/projection.json","raw_file_sha256":"019eb1b16d5b12d4fac53fe1c94cb23ef4794434faa88ce8222576f948f4ca36","unit_key":"p023","source_layer":"received_chapter"},"mentions":[{"id":"c-jinshu-098-wangdun-comparison:p023:m0000","start":0,"end":2,"surface":"先帝","person_id":"dkn_ge4_286_AAAAAAA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p023:m0015","start":15,"end":16,"surface":"導","person_id":"7r6_k52_qji_ABAA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p023:m0027","start":27,"end":30,"surface":"大將軍","person_id":"7r6_k52_qji_ABBA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p023:m0030","start":30,"end":31,"surface":"敦","person_id":"7r6_k52_qji_ABBA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p023:m0071","start":71,"end":73,"surface":"刁協","person_id":"c20_ec4_36f","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p023:m0074","start":74,"end":76,"surface":"劉隗","person_id":"hnd_3at_h4i","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p023:m0081","start":81,"end":82,"surface":"敦","person_id":"7r6_k52_qji_ABBA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p023:m0089","start":89,"end":91,"surface":"鬻拳","person_id":"ft4_s3e_6e3","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p023:m0162","start":162,"end":164,"surface":"先帝","person_id":"dkn_ge4_286_AAAAAAA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p023:m0184","start":184,"end":185,"surface":"朕","person_id":"dkn_ge4_286_AAAAAAAA","kin