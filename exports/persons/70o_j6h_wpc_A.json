ualifiers":{"source_term":"父旻","nanshi024_wangmeng_reading":"wanqing","lineage":"paternal"},"evidence":[{"work_id":"w-chenshu","book_id":"b-chenshu-014","source_id":"s-chenshu-014-zhengwanqing-father-context-ws2262003","chapter_id":"c-chenshu-014-zhengwanqing-father-context","paragraph_id":"c-chenshu-014-zhengwanqing-father-context:p001","quote":"父旻，梁末入魏。萬頃通達有材幹，","subject_person_mention_id":"c-chenshu-014-zhengwanqing-father-context:p001:m0008","object_person_mention_id":"c-chenshu-014-zhengwanqing-father-context:p001:m0001","relationship_anchor":{"paragraph_id":"c-chenshu-014-zhengwanqing-father-context:p001","surface":"父旻","start":0,"end":2}}],"status":"source_attested","interpretation_note":"鄭萬頃傳。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"title_holdings":[{"id":"th-nanshi024-wangmeng-c1-78","person_id":"70o_j6h_wpc_A","title":"豐州刺史","kind":"office","mode":"attestation","attestations":[{"id":"th-nanshi024-wangmeng-c1-78:a","person_mention_id":"c-chenshu-014-wangyong:p001:m0082","usage":"narrative","date_expression":null,"paragraph_id":"c-chenshu-014-wangyong:p001","surface":"豐州刺史","start":78,"end":82}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-chenshu","book_id":"b-chenshu-014","source_id":"s-chenshu-014-wangyong-ws2262003","chapter_id":"c-chenshu-014-wangyong","paragraph_id":"c-chenshu-014-wangyong:p001","quote":"禎明三年，隋師濟江，〔東〕衡州刺史王勇遣高州刺史戴智烈將五百騎迎方慶，欲令承制總督征討諸軍事。是時隋行軍總管韋洸帥兵度嶺，宣隋文帝敕云：「若嶺南平定，留勇與豐州刺史鄭萬頃且依舊職。」方慶聞之，恐勇賣己，乃不從，率兵以拒智烈。智烈與戰，敗之，斬方慶於廣州，虜其妻子。","person_mention_id":"c-chenshu-014-wangyong:p001:m0082"}],"status":"source_attested","interpretation_note":"按本見證原職名及其所屬人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"th-nanshi024-wangmeng-c2-232","person_id":"70o_j6h_wpc_A","title":"豐州刺史","kind":"office","mode":"attestation","attestations":[{"id":"th-nanshi024-wangmeng-c2-232:a","person_mention_id":"c-chenshu-014-wangyong:p002:m0236","usage":"narrative","date_expression":null,"paragraph_id":"c-chenshu-014-wangyong:p002","surface":"豐州刺史","start":232,"end":236}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-chenshu","book_id":"b-chenshu-014","source_id":"s-chenshu-014-wangyong-ws2262003","chapter_id":"c-chenshu-014-wangyong","paragraph_id":"c-chenshu-014-wangyong:p002","quote":"王勇，太建中為晉陵太守，在職有能名。方慶之襲馬靖也，朝廷以勇為超武將軍、東衡州刺史，領始興內史，以為方慶聲勢。靖誅，以功封龍陽縣子。及隋軍臨江，詔授勇使持節、光勝將軍、總督衡廣交桂武等二十四州諸軍事、平越中郎將，仍入援。會京城陷、勇因移檄管內，徵兵據守，使其同產弟鄧暠將兵五千，頓于嶺上。又遣使迎方慶，欲假以為名，而自執兵要。及方慶敗績，虜其妻子，收其貲產，分賞將帥。又令其將王仲宣、曾孝武迎西衡州刺史衡陽王伯信，伯信懼，奔于清遠郡，孝武追殺之。是時韋洸兵已上嶺，豐州刺史鄭萬頃據州不受勇召，而高梁女子（浩）〔洗〕氏舉兵以應隋軍，攻陷傍郡，勇計無所出，乃以其眾降。行至荊州，道病卒，隋贈大將軍、宋州刺史，歸仁縣公。","person_mention_id":"c-chenshu-014-wangyong:p002:m0236"}],"status":"source_attested","interpretation_note":"按本見證原職名及其所屬人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-chenshu-014-wangyong:p001","text":"禎明三年，隋師濟江，〔東〕衡州刺史王勇遣高州刺史戴智烈將五百騎迎方慶，欲令承制總督征討諸軍事。是時隋行軍總管韋洸帥兵度嶺，宣隋文帝敕云：「若嶺南平定，留勇與豐州刺史鄭萬頃且依舊職。」方慶聞之，恐勇賣己，乃不從，率兵以拒智烈。智烈與戰，敗之，斬方慶於廣州，虜其妻子。","mentions":[{"id":"c-chenshu-014-wangyong:p001:m0017","surface":"王勇","start":17,"end":19,"person_id":"72e_1a7_3ac_AAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-chenshu-014-wangyong:p001:m0024","surface":"戴智烈","start":24,"end":27,"person_id":"094_ia6_xvv","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-chenshu-014-wangyong:p001:m0032","surface":"方慶","start":32,"end":34,"person_id":"eaj_zin_zxy_AB","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-che