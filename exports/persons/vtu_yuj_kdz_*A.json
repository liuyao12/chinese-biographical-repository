:false,"normalized_date":{"era":"BCE","era_year":206,"year":-205,"year_numbering":"astronomical","precision":"year","status":"editorial_provisional","original_quote":"項王既歸，諸侯各就國，田榮使人將兵助陳餘，令反趙地，而榮亦發兵以距擊田都，田都亡走楚。田榮留齊王市，無令之膠東。市之左右曰：「項王彊暴，而王當之膠東，不就國，必危。」市懼，乃亡就國。田榮怒，追擊殺齊王市於即墨，還攻殺濟北王安。於是田榮乃自立為齊王，盡并三齊之地。","evidence":[{"chapter_id":"c-shiji-094-tiandan","source_id":"s-shiji-094-tiandan","paragraph_id":"c-shiji-094-tiandan:p007","person_mention_id":"c-shiji-094-tiandan:m007-0108","quote_passage_ref":"data/corpus/shiji/094.json"}],"references":[{"title":"《史記・秦楚之際月表》死亡事件","url":"https://zh.wikisource.org/w/index.php?title=史記/卷016&oldid=2607007","quote":"六。田榮擊殺安。","scope":"received_parallel_event","image_verified":false,"table_cell_id":"shiji-016-t2-r007-c09"},{"title":"《史記・秦楚之際月表》曆月欄","url":"https://zh.wikisource.org/w/index.php?title=史記/卷016&oldid=2607007","quote":"七月","scope":"received_calendar_month_attestation","image_verified":false,"table_cell_id":"shiji-016-t2-r007-c11"},{"title":"《史記・秦楚之際月表》年首承接","url":"https://zh.wikisource.org/w/index.php?title=史記/卷016&oldid=2607007","quote":"一。義帝元年。諸侯尊懷王為義帝。","scope":"received_regnal_year_attestation","image_verified":false,"table_cell_id":"shiji-016-t2-r001-c01"},{"title":"《史記・秦楚之際月表》數位年欄","url":"https://zh.wikisource.org/w/index.php?title=史記/卷016&oldid=2607007","quote":"206","scope":"digital_editorial_regnal_year_equivalence_only","image_verified":false,"table_cell_id":"shiji-016-t2-r001-c00"}],"rationale":"本篇死亡事件對讀月表同人同事，曆月欄為七月；事件格首數字是在位月序，不作曆月。原年首與月欄分存，所列曆月位於公元前206年；只換算年，不換月日，未核書影。","reviewer":"Codex（AI 代理）","human_reviewed":false,"basis":{"kind":"parallel_event","source_event_quote":"還攻殺濟北王安","reference_url":"https://zh.wikisource.org/w/index.php?title=史記/卷016&oldid=2607007","reference_event_quote":"六。田榮擊殺安。","reference_year_quote":"206","reference_year_url":"https://zh.wikisource.org/w/index.php?title=史記/卷016&oldid=2607007"}}}],"mentions":[{"id":"c-shiji-007-xiangyu:m021-0602","start":602,"end":604,"surface":"田安","kind":"perso