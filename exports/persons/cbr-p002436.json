{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p002436","identity_policy":"contextual_provisional","person_ids":["cbr-p002436"],"persons":[{"id":"cbr-p002436","label":"燕昭王（趙世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"燕昭王","mention_ids":["c-shiji-043-zhao:m083-0141"]}],"evidence":[{"mention_id":"c-shiji-043-zhao:m083-0141","chapter_id":"c-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p083","quote":"燕昭王"}]}],"mentions":[{"id":"c-shiji-043-zhao:m083-0141","start":141,"end":144,"surface":"燕昭王","kind":"person","person_id":"cbr-p002436","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p083","chapter_id":"c-shiji-043-zhao"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji043-207","person_id":"cbr-p002436","surfaces":["燕昭王"],"scope":"same_chapter","chapter_ids":["c-shiji-043-zhao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-043-zhao:p083","quote":"（主父死惠文王立立）五年，與燕鄚、易。八年，城南行唐。九年，趙梁將，與齊合軍攻韓，至魯關下。及十年，秦自置爲西帝。十一年，董叔與魏氏伐宋，得河陽於魏。秦取保陽。十二年，趙梁將攻齊。十三年，韓徐爲將，攻齊。公主死。十四年，相國樂毅將趙、秦、韓、魏、燕攻齊，取靈丘。與秦會中陽。十五年，燕昭王來見。趙與韓、魏、秦共撃齊，齊王敗走，燕獨深入，取臨菑。"}],"rationale":"限本篇人物、連續政治事件及明示生子是為敘事；武靈王／主父、王子何／惠文王及惠后吳娃按本文連接。公子章不與早期敬侯章合併，何不與較早趙何合併；髙信與信期、趙袑與周袑分候選。王賁不按熟知秦將同名接人。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-043-zhao:p083","text":"（主父死惠文王立立）五年，與燕鄚、易。八年，城南行唐。九年，趙梁將，與齊合軍攻韓，至魯關下。及十年，秦自置爲西帝。十一年，董叔與魏氏伐宋，得河陽於魏。秦取保陽。十二年，趙梁將攻齊。十三年，韓徐爲將，攻齊。公主死。十四年，相國樂毅將趙、秦、韓、魏、燕攻齊，取靈丘。與秦會中陽。十五年，燕昭王來見。趙與韓、魏、秦共撃齊，齊王敗走，燕獨深入，取臨菑。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-043-zhao:m083-0001","start":1,"end":3,"surface":"主父","kind":"person","person_id":"cbr-p002380","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m083-0004","start":4,"end":7,"surface":"惠文王","kind":"person","person_id":"cbr-p002424"