:m0087","start":87,"end":88,"surface":"純","kind":"person","person_id":"re7_iu7_ztp","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-060-zhonglimu:line097","chapter_id":"c-sanguozhi-060-zhonglimu"},{"id":"c-sanguozhi-060-zhonglimu:line097:m0275","start":275,"end":277,"surface":"郭純","kind":"person","person_id":"re7_iu7_ztp","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-060-zhonglimu:line097","chapter_id":"c-sanguozhi-060-zhonglimu"},{"id":"c-sanguozhi-060-zhonglimu:line097:m0360","start":360,"end":361,"surface":"純","kind":"person","person_id":"re7_iu7_ztp","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-060-zhonglimu:line097","chapter_id":"c-sanguozhi-060-zhonglimu"}],"relations":[],"title_holdings":[{"id":"t-wu060-t-wu060-zhonglimu23","person_id":"re7_iu7_ztp","kind":"office","title":"漢葭縣長","mode":"attestation","status":"source_attested","effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本句所載職官，任免時間未詳。","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-060","chapter_id":"c-sanguozhi-060-zhonglimu","source_id":"s-sanguozhi-060-zhonglimu","paragraph_id":"c-sanguozhi-060-zhonglimu:line097","quote":"　　永安六年，蜀併於魏，武陵五谿夷與蜀接界。時論懼叛亂，乃以牧為平魏將軍，領武陵太守，往之郡。魏遣漢葭縣長郭純試守武陵太守，率涪陵民入蜀遷陵界，屯於赤沙，誘致諸夷邑君，或起應純，又進攻酉陽縣，郡中震懼。牧問朝吏曰：「西蜀傾覆，邊境見侵，何以禦之？」皆對曰：「今二縣山險，諸夷阻兵，不可以軍驚擾，驚擾則諸夷盤結。宜以漸安，可遣恩信吏宣教慰勞。」牧曰：「不然。外境內侵，誑誘人民，當及其根柢未深而撲取之，此救火貴速之勢也。」敕外趣嚴，掾史沮儀者便行軍法。撫夷將軍高尚說牧曰：「昔潘太常督兵五萬，然後以討五谿夷耳。是時劉氏連和，諸夷率化，今既無往日之援，而郭純已據遷陵，而明府以三千兵深入，尚未見其利也。」牧曰：「非常之事，何得循舊？」即率所領，晨夜進道，緣山險行，垂二千里，從塞上，斬惡民懷異心者魁帥百餘人及其支黨凡於余級，純等散，五谿平。遷公安督、揚武將軍，封都鄉侯，徙濡須督。復以前將軍假節，領武陵太守。","person_mention_id":"c-sanguozhi-060-zhonglimu:line097:m0053"}],"attestations":[{"id":"t-wu060-t-wu060-zhonglimu23:a","paragraph_id":"c-sanguozhi-060-zhonglimu:line097","person_mention_id":"c-sanguozhi-060-zhonglimu:line097:m0053","start":49,"end":53,"surface":"漢葭縣長","usage":"narrative","date_expression":null}],"human_reviewed":false,"reviewer":"Codex（AI 代理）","model":null},{"id":"t-wu060-t-wu060-zhonglimu24","person_id":"re7_iu7_ztp","kind":"office","title":"武陵太守","mode":"attestation","status":"source_attested","effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本句所載職官，任免時間未詳。","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-060","chapter_id":"c-sanguozhi-060-zhonglimu","source_id":"s-sanguozhi-060-zhonglimu","paragraph_id":"c-sanguozhi-060-zhonglimu:line097","quote":"　　永安六年，蜀併於魏，武陵五谿夷與蜀接界。時論懼叛亂，乃以牧為平魏將軍，領武陵太守，往之郡。魏遣漢葭縣長郭純試守武陵太守，率涪陵民入蜀遷陵界，屯於赤沙，誘致諸夷邑君，或起應純，又進攻酉陽縣，郡中震懼。牧問朝吏曰：「西蜀傾覆，邊境見侵，何以禦之？」皆對曰：「今二縣山險，諸夷阻兵，不可以軍驚擾，驚擾則諸夷盤結。宜以漸安，可遣恩信吏宣教慰勞。」牧曰：「不然。外境內侵，誑誘人民，當及其根柢未深而撲取之，此救火貴速之勢也。」敕外趣嚴，掾史沮儀者便行軍法。撫夷將軍高尚說牧曰：「昔潘太常督兵五萬，然後以討五谿夷耳。是時劉氏連和，諸夷率化，今既無往日之援，而郭純已據遷陵，而明府以三千兵深入，尚未見其利也。」牧曰：「非常之事，何得循舊？」即率所領，晨夜進道，緣山險行，垂二千里，從塞上，斬惡民懷異心者魁帥百餘人及其支黨凡於余級，純等散，五谿平。遷公安督、揚武將軍，封都鄉侯，徙濡須督。復以前將軍假節，領武陵太守。","person_mention_id":"c-sanguozhi-060-zhonglimu:line097:m0053"}],"attestations":[{"id":"t-wu060-t-wu060-zhonglimu24:a","paragraph_id":"c-sanguozhi-060-zhonglimu:line097","person_mention_id":"c-sanguozhi-060-zhonglimu:line097:m0053","start":57,"end":61,"surface":"武陵太守","usage":"narrative","date_expression":null}],"human_reviewed":false,"reviewer":"Codex（AI 代理）","model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-060-zhonglimu:line097","text":"　　永安六年，蜀併於魏，武陵五谿夷與蜀接界。時論懼叛亂，乃以牧為平魏將軍，領武陵太守，往之郡。魏遣漢葭縣長郭純試守武陵太守，率涪陵民入蜀遷陵界，屯於赤沙，誘致諸夷邑君，或起應純，又進攻酉陽縣，郡中震懼。牧問朝吏曰：「西蜀傾覆，邊境見侵，何以禦之？」皆對曰：「今二縣山險，諸夷阻兵，不可以軍驚擾，驚擾則諸夷盤結。宜以漸安，可遣恩信吏宣教慰勞。」牧曰：「不然。外境內侵，誑誘人民，當及其根柢未深而撲取之，此救火貴速之勢也。」敕外趣嚴，掾史沮儀者便行軍法。撫夷將軍高尚說牧曰：「昔潘太常督兵五萬，然後以討