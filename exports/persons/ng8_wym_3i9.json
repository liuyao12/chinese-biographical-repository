{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"ng8_wym_3i9","canonical_person_id":"ng8_wym_3i9","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["ng8_wym_3i9"],"persons":[{"id":"ng8_wym_3i9","label":"李根〔白石築壘〕","status":"active","historicity":"historical_tradition","aliases":[{"surface":"李根","mention_ids":["c-jinshu-067-wenqiao:line054:m0035"]}],"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-067","chapter_id":"c-jinshu-067-wenqiao","source_id":"s-jinshu-067-wenqiao","paragraph_id":"c-jinshu-067-wenqiao:line054","mention_id":"c-jinshu-067-wenqiao:line054:m0035","quote":"李根"}],"identity_note":"溫嶠用其計據白石。","review":"ai_provisional"}],"source_mention_summary":[{"source_id":"s-jinshu-067-wenqiao","work_id":"w-jinshu","book_id":"b-jinshu-067","chapter_id":"c-jinshu-067-wenqiao","raw_mention_count":1,"mention_ids":["c-jinshu-067-wenqiao:line054:m0035"],"paragraph_ids":["c-jinshu-067-wenqiao:line054"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-067-wenqiao:line054:m0035","mention_ids":["c-jinshu-067-wenqiao:line054:m0035"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-067-wenqiao"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-067-wenqiao:line054:m0035","start":35,"end":37,"surface":"李根","kind":"person","person_id":"ng8_wym_3i9","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-067-wenqiao:line054","chapter_id":"c-jinshu-067-wenqiao"}],"relations":[],"title_holdings":[{"id":"th-w067-wen-47","person_id":"ng8_wym_3i9","title":"將軍","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-067","chapter_id":"c-jinshu-067-wenqiao","source_id":"s-jinshu-067-wenqiao","paragraph_id":"c-jinshu-067-wenqiao:line054","quote":"峻聞嶠將至，逼大駕幸石頭。時峻軍多馬，南軍杖舟楫，不敢輕與交鋒。用將軍李根計，據白石築壘以自固，使庾亮守之。賊步騎萬餘來攻，不下而退，追斬二百餘級。嶠又於四望磯築壘以逼賊，曰：「賊必爭之，設伏以逸待勞，是制賊之一奇也。」是時義軍屢戰失利，嶠軍食盡，陶侃怒曰：「使君前云不憂無將士，惟得老僕為主耳。今數戰皆北，良將安在？荊州接胡蜀二虜，倉廩當備不虞，若復無食，僕便欲西歸，更思良算。但今歲計，殄賊不為晚也。」嶠曰：「不然。自古成監，師克在和。光武之濟昆陽，曹公之拔官渡，以寡敵眾，杖義故也。峻、約小豎，為海內所患，今日之舉，決在一戰。峻勇而無謀，藉驕勝之勢，自謂無前，今挑之戰，可一鼓而擒也。奈何捨垂立之功，設進退之計！且天子幽逼，社稷危殆，四海臣子，肝腦塗地，嶠等與公並受國恩，是致命之日，事若克濟，則臣主同祚，如其不捷，身雖灰滅，不足以謝責於先帝。今之事勢，義無旋踵，騎猛獸，安可中下哉！公若違眾獨反，人心必沮。沮眾敗事，義旗將廻指於公矣。」侃無以對，遂留不去。","person_mention_id":"c-jinshu-067-wenqiao:line054:m0035"}],"attestations":[{"id":"th-w043-wen-47:a","paragraph_id":"c-jinshu-067-wenqiao:line054","start":33,"end":35,"surface":"將軍","person_mention_id":"c-jinshu-067-wenqiao:line054:m0035","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-067-wenqiao:line054","text":"峻聞嶠將至，逼大駕幸石頭。時峻軍多馬，南軍杖舟楫，不敢輕與交鋒。用將軍李根計，據白石築壘以自固，使庾亮守之。賊步騎萬餘來攻，不下而退，追斬二百餘級。嶠又於四望磯築壘以逼賊，曰：「賊必爭之，設伏以逸待勞，是制賊之一奇也。」是時義軍屢戰失利，嶠軍食盡，陶侃怒曰：「使君前云不憂無將士，惟得老僕為主耳。今數戰皆北，良將安在？荊州接胡蜀二虜，倉廩當備不虞，若復無食，僕便欲西歸，更思良算。但今歲計，殄賊不為晚也。」嶠曰：「不然。自古成監，師克在和。光武之濟昆陽，曹公之拔官渡，以寡敵眾，杖義故也。峻、約小豎，為海內所患，今日之舉，決在一戰。峻勇而無謀，藉驕勝之勢，自謂無前，今挑之戰，可一鼓而擒也。奈何捨垂立之功，設進退之計！且天子幽逼，社稷危殆，四海臣子，肝腦塗地，嶠等與公並受國恩，是致命之日，事若克濟，則臣主同祚，如其不捷，身雖灰滅，不足以謝責於先帝。今之事勢，義無旋踵，騎猛獸，安可中下哉！公若違眾獨反，人心必沮。沮眾敗事，義旗將廻指於公矣。」侃無以對，遂留不去。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-067-wenqiao:line054:m0000","start":0,"end":1,"surface":"峻","kind":"person","person_id":"lrg_cze_g1l","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line054:m0002","start":2,"end":3,"surface":"嶠","kind":"person","person_id":"6v8_pk9_7k5","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line054:m0014","start":14,"end":15,"surface":"峻","kind":"person","person_id":"lrg_cze_g1l","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line054:m0035","start":35,"end":37,"surface":"李根","kind":"person","person_id":"ng8_wym_3i9","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line054:m0049","start":49,"end":51,"surface":"庾亮","kind":"person","person_id":"4qr_wrk_3vd_B","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line054:m0074","start":74,"end":75,"surface":"嶠","kind":"person","person_id":"6v8_pk9_7k5","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line054:m0119","start":119,"end":120,"surface":"嶠","kind":"person","person_id":"6v8_pk9_7k5","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line054:m0124","start":124,"end":126,"surface":"陶侃","kind":"person","person_id":"twd_erg_kmz","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line054:m0203","start":20