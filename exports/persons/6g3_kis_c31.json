art":432,"end":433,"person_id":"dkn_ge4_286_AAAAG","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-lun:p013:m0441","surface":"荂","start":441,"end":442,"person_id":"5js_p45_eky","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-lun:p013:m0484","surface":"倫","start":484,"end":485,"person_id":"dkn_ge4_286_AAAAG","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-lun:p013:m0486","surface":"荂","start":486,"end":487,"person_id":"5js_p45_eky","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-059-prince-lun","book_id":"b-jinshu-059","work_id":"w-jinshu","source_id":"s-jinshu-059-prince-lun-ws2650517"},{"id":"c-jinshu-060-zhangfu:p002","text":"轉御史中丞。時積弩將軍孟觀與明威將軍郝彥不協，而觀因軍事害彥，又賈謐、潘岳、石崇等共相引重，乃義陽王威有詐冒事，輔並糾劾之。梁州刺史楊欣有姊喪，未經旬，車騎長史韓預強聘其女為妻。輔為中正，貶預以清風俗，論者稱之。用孫秀執權，威構輔於秀，秀惑之，將繩輔以法。輔與秀箋曰：「輔徒知希慕古人，當官而行，不復自知小為身計。今義陽王誠弘恕，不以介意。然輔母年七十六，常見憂慮，恐輔將以怨疾獲罪。願明公留神省察輔前後行事，是國之愚臣而已。「秀雖凶狡，知輔雅正，為威所誣，乃止。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":55,"last_line":55,"raw_start":3968,"raw_end":4202,"raw_character_offsets":[3970,3971,3972,3973,3974,3975,3976,3977,3978,3979,3980,3981,3982,3983,3984,3985,3986,3987,3988,3989,3990,3991,3992,3993,3994,3995,3996,3997,3998,3999,4000,4001,4002,4003,4004,4005,4006,4007,4008,4009,4010,4011,4012,4013,4014,4015,4016,4017,4018,4019,4020,4021,4022,4023,4024,4025,4026,4027,4028,4029,4030,4031,4032,4033,4034,4035,4036,4037,4038,4039,4040,4041,4042,4043,4044,4045,4046,4047,4048,4049,4050,4051,4052,4053,4054,4055,4056,4057,4058,4059,4060,4061,4062,4063,4064,4065,4066,4067,4068,4069,4070,4071,4072,4073,4074,4075,4076,4077,4078,4079,4080,4081,4082,4083,4084,4085,4086,4087,4088,4089,4090,4091,4092,4093,4094,4095,4096,4097,4098,4099,4100,4101,4102,4103,4104,4105,4106,4107,4108,4109,4110,4111,4112,4113,4114,4115,4116,4117,4118,4119,4120,4121,4122,4123,4124,4125,4126,4127,4128,4129,4130,4131,4132,4133,4134,4135,4136,4137,413