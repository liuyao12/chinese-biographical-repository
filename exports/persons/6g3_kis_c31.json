ll"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-059-prince-lun:p007:m0113","surface":"義陽王威","start":113,"end":117,"person_id":"6g3_kis_c31","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-059-prince-lun:p007","chapter_id":"c-jinshu-059-prince-lun"},{"id":"c-jinshu-059-prince-lun:p007:m0241","surface":"義陽王威","start":241,"end":245,"person_id":"6g3_kis_c31","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-059-prince-lun:p007","chapter_id":"c-jinshu-059-prince-lun"},{"id":"c-jinshu-059-prince-lun:p013:m0048","surface":"義陽王威","start":48,"end":52,"person_id":"6g3_kis_c31","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-059-prince-lun:p013","chapter_id":"c-jinshu-059-prince-lun"},{"id":"c-jinshu-060-zhangfu:p002:m0047","surface":"義陽王威","start":47,"end":51,"person_id":"6g3_kis_c31","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-060-zhangfu:p002","chapter_id":"c-jinshu-060-zhangfu"},{"id":"c-jinshu-060-zhangfu:p002:m0112","surface":"威","start":112,"end":113,"person_id":"6g3_kis_c31","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-060-zhangfu:p002","chapter_id":"c-jinshu-060-zhangfu"},{"id":"c-jinshu-060-zhangfu:p002:m0225","surface":"威","start":225,"end":226,"person_id":"6g3_kis_c31","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-060-zhangfu:p002","chapter_id":"c-jinshu-060-zhangfu"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-059-prince-lun:p007","text":"倫、秀並惑巫鬼，聽妖邪之說。秀使牙門趙奉詐為宣帝神語，命倫早入西宮。又言宣帝於北芒為趙王佐助，於是別立宣帝廟於芒山。謂逆謀可成。以太子詹事裴劭、左軍將軍卞粹等二十人為從事中郎，掾屬又二十人。秀等部分諸軍，分佈腹心，使散騎常侍、義陽王威兼侍中，出納詔命，矯作禪讓之詔，使使持節、尚書令滿奮，僕射崔隨為副，奉皇帝璽綬以禪位於倫。倫偽讓不受。於是宗室諸王、群公卿士咸假稱符瑞天文以勸進，倫乃許之。左衛王輿與前軍司馬雅等率甲士入殿，譬喻三部司馬，示以威賞，皆莫敢違。其夜，使張林等屯守諸門。義陽王威及駱休等逼奪天子璽綬。夜漏未盡，內外百官以乘輿法駕迎倫。惠帝乘雲母車，鹵簿數百人，自華林西門出居金墉城。尚書和郁，兼侍中、散騎常侍、琅邪王睿，中書侍郎陸機從，到城下而反。使張衡衛帝，實幽之也。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":71,"last_line":71,"raw_start":6595,"raw_end":6938,"raw_character_offsets":[6597,6598,6599,6600,6601,6602,6603,6604,6605,6606,6607,6608,6609,6610,6611,6612,6613,6614,6615,6616,6617,6618,6619,6620,6621,6622,6623,6624,6625,6626,6627,6628,6629,6630,6631,6632,6633,6634,6635,6636,6637,6638,6639,6640,6641,6642,6643,6644,6645,6646,6647,6648,6649,6650,6651,6652,6653,6654,6655,6656,6657,6658,6659,6660,6661,6662,6663,6664,6665,6666,6667,6668,6669,6670,6671,6672,6673,6674,6675,6676,6677,6678,6679,6680,6681,6682,6683,6684,6685,6686,6687,6688,6689,6690,6691,6692,6693,6694,6695,6696,6697,6698,6699,6700,6701,6702,6703,6704,6705,6706,6707,6708,6709,6710,6711,6712,6713,6714,6715,6716,6717,6718,6719,6720,6721,6722,6723,6724,6725,6726,6727,6728,6729,6730,6731,6732,6733,6734,6735,6736,6737,6738,6739,6740,6741,6742,6743,6744,6745,6746,6747,6748,6749,6750,6751,6752,6753,6754,6755,6756,6757,6758,6759,6760,6761,6762,6763,6764,6765,6766,6767,6768,6769,6770,6771,6772,6773,6774,6775,6776,6777,6778,6779,6780,6781,6782,6783,6784,6785,6786,6787,6788,6789,6790,6791,6792,6793,6794,6795,6796,6797,6798,6799,6800,6801,6802,6803,6804,6805,6806,6807,6808,6809,6810,6811,6812,6813,6814,6815,6816,6817,6818,6819,6820,6821,6822,6823,6824,6825,6826,6827,6828,6829,6830,6831,6832,6833,6834,6835,6836,6837,6838,6839,6840,6841,6842,6843,6844,6845,6846,6847,6848,6849,6850,6851,6852,6853,6854,6855,6856,6857,6858,6859,6860,6861,6862,6863,6864,6865,6866,6867,6868,6869,6870,6871,