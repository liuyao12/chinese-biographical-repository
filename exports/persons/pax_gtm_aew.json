e":"annotation_containers_not_independent_witness_passages","count_explanation":"2處獨立位置，2個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-sanguozhi-052-gushao-complete"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-052-gushao-complete:line048:m0174","start":174,"end":176,"surface":"呉粲","kind":"person","person_id":"pax_gtm_aew","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-sanguozhi-052-gushao-complete:line048","chapter_id":"c-sanguozhi-052-gushao-complete"},{"id":"c-sanguozhi-052-gushao-complete:line048:m0304","start":304,"end":305,"surface":"粲","kind":"person","person_id":"pax_gtm_aew","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-sanguozhi-052-gushao-complete:line048","chapter_id":"c-sanguozhi-052-gushao-complete"}],"relations":[],"title_holdings":[{"id":"th-wu052-gs-4","person_id":"pax_gtm_aew","title":"太子少傅","kind":"office","mode":"attestation","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-052","chapter_id":"c-sanguozhi-052-gushao-complete","source_id":"s-sanguozhi-052-gushao-complete","paragraph_id":"c-sanguozhi-052-gushao-complete:line048","quote":"邵字孝則，博覽書傳，好樂人倫。少與舅陸績齊名，而陸遜、張敦、卜靜等皆亞焉。自州郡庶幾及四方人士，往來相見，或言議而去，或結厚而別，風聲流聞，遠近稱之。權妻以策女。年二十七，起家爲豫章太守。下車祀先賢徐孺子之墓。優待其後。禁其淫祀非禮之祭者。小吏資質佳者，輒令就學，擇其先進，擢置右職，舉善以教，風化大行。初，錢唐丁諝出於役伍，陽羨張秉生於庶民。烏程呉粲、雲陽殷禮起乎微賤，邵皆拔而友之，爲立聲譽。秉遭大喪，親爲制服結絰。邵當之豫章，發在近路，值秉疾病，時送者百數。邵辭賓客曰：\"張仲節有疾，苦不能來別，恨不見之，暫還與訣，諸君少時相待。\"其留心下士，惟善所在，皆此類也。諝至典軍中郎，秉雲陽太守，禮零陵太守，粲太子少傅。世以邵爲知人。在郡五年，卒官，子譚、承雲。","person_mention_id":"c-sanguozhi-052-gushao-complete:line048:m0174"}],"attestations":[{"id":"th-wu052-gs-4:a","paragraph_id":"c-sanguozhi-052-gushao-complete:line048","start":305,"end":309,"surface":"太子少傅","person_mention_id":"c-sanguozhi-052-gushao-complete:line048:m0174","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-052-gushao-complete:line048","text":"邵字孝則，博覽書傳，好樂人倫。少與舅陸績齊名，而陸遜、張敦、卜靜等皆亞焉。自州郡庶幾及四方人士，往來相見，或言議而去，或結厚而別，風聲流聞，遠近稱之。權妻以策女。年二十七，起家爲豫章太守。下車祀先賢徐孺子之墓。優待其後。禁其淫祀非禮之祭者。小吏資質佳者，輒令就學，擇其先進，擢置右職，舉善以教，風化大行。初，錢唐丁諝出於役伍，陽羨張秉生於庶民。烏程呉粲、雲陽殷禮起乎微賤，邵皆拔而友之，爲立聲譽。秉遭大喪，親爲制服結絰。邵當之豫章，發在近路，值秉疾病，時送者百數。邵辭賓客曰：\"張仲節有疾，苦不能來別，恨不見之，暫還與訣，諸君少時相待。\"其留心下士，惟善所在，皆此類也。諝至典軍中郎，秉雲陽太守，禮零陵太守，粲太子少傅。世以邵爲知人。在郡五年，卒官，子譚、承雲。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-sanguozhi-052-gushao-complete:line048:m0000","start":0,"end":1,"surface":"邵","kind":"person","person_id":"syc_ik6_bq5_**AA","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-gushao-complete:line048:m0002","start":2,"end":4,"surface":"孝則","kind":"person","person_id":"syc_ik6_bq5_**AA","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-gushao-complete:line048:m0018","start":18,"end":20,"surface":"陸績","kind":"person","person_id":"7ec_qvv_x1c","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"i