rt":275,"end":277,"surface":"吳王","kind":"person","person_id":"cbr-p000434","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m032-0281","start":281,"end":284,"surface":"太宰嚭","kind":"person","person_id":"cbr-p001064","status":"contextual_provisional"}],"chapter_id":"c-shiji-031-wu","book_id":"b-shiji-031","work_id":"w-shiji","source_id":"s-shiji-031-wu"},{"id":"c-shiji-041-yue:p004","text":"越王謂范蠡曰：「以不聽子故至於此，爲之柰何？」蠡對曰：「持滿者與天，定傾者與人，節事者以地。卑辭厚禮以遺之，不許，而身與之市。」句踐曰：「諾。」乃令大夫種行成於呉，膝行頓首曰：「君王亡臣句踐使陪臣種敢告下執事：句踐請爲臣，妻爲妾。」呉王將許之。子胥言於呉王曰：「天以越賜呉，勿許也。」種還，以報句踐。句踐欲殺妻子，燔寶器，觸戰以死。種止句踐曰：「夫呉太宰嚭貪，可誘以利，請閒行言之。」於是句踐以美女寶器令種閒獻呉太宰嚭。嚭受，乃見大夫種於呉王。種頓首言曰：「願大王赦句踐之罪，盡入其寶器。不幸不赦，句踐將盡殺其妻子，燔其寶器，悉五千人觸戰，必有當也。」嚭因説呉王曰：「越以服爲臣，若將赦之，此國之利也。」呉王將許之。子胥進諫曰：「今不滅越，後必悔之。句踐賢君，種、蠡良臣，若反國，將爲亂。」呉王弗聽，卒赦越，罷兵而歸。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-041-yue:m004-0000","start":0,"end":2,"surface":"越王","kind":"person","person_id":"cbr-p002055","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m004-0003","start":3,"end":5,"surface":"范蠡","kind":"person","person_id":"cbr-p002061","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m004-0023","start":23,"end":24,"surface":"蠡","kind":"person","person_id":"cbr-p002061","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m004-0064","start":64,"end":66,"surface":"句踐","kind":"person","person_id":"cbr-p002055","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m004-0074","start":74,"end":77,"surface":"大夫種","kind":"person","person_id":"cbr-p002062","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m004-0089","start":89,"end":91,"surface":"君王","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名、群體、神祇或引語用稱待覆核；不補姓名與成員。"},{"id":"c-shiji-041-yue:m004-0093","start":93,"end":95,"surface":"句踐","kind":"person","person_id":"cbr-p002055","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m004-0098","start":98,"end":99,"surface":"種","kind":"person","person_id":"cbr-p002062","