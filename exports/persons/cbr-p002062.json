0302","start":302,"end":304,"surface":"呉王","kind":"person","person_id":"cbr-p002060","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m004-0308","start":308,"end":310,"surface":"子胥","kind":"person","person_id":"cbr-p002063","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m004-0325","start":325,"end":327,"surface":"句踐","kind":"person","person_id":"cbr-p002055","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m004-0330","start":330,"end":331,"surface":"種","kind":"person","person_id":"cbr-p002062","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m004-0332","start":332,"end":333,"surface":"蠡","kind":"person","person_id":"cbr-p002061","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m004-0345","start":345,"end":347,"surface":"呉王","kind":"person","person_id":"cbr-p002060","status":"contextual_provisional"}],"chapter_id":"c-shiji-041-yue","book_id":"b-shiji-041","work_id":"w-shiji","source_id":"s-shiji-041-yue"},{"id":"c-shiji-041-yue:p005","text":"句踐之困會稽也，喟然嘆曰：「吾終於此乎？」種曰：「湯系夏臺，文王囚羑里，晉重耳奔翟，齊小白奔莒，其卒王霸。由是觀之，何遽不爲福乎？」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-041-yue:m005-0000","start":0,"end":2,"surface":"句踐","kind":"person","person_id":"cbr-p002055","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m005-0021","start":21,"end":22,"surface":"種","kind":"person","person_id":"cbr-p002062","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m005-0025","start":25,"end":26,"surface":"湯","kind":"person","person_id":"cbr-p002065","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m005-0030","start":30,"end":32,"surface":"文王","kind":"person","person_id":"cbr-p002066","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m005-0036","start":36,"end":39,"surface":"晉重耳","kind":"person","person_id":"cbr-p002067","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m005-0042","start":42,"end":45,"surface":"齊小白","kind":"person","person_id":"cbr-p002068","status":"contextual_provisional"}],"chapter_id":"c-shiji-041-yue","book_id":"b-shiji-041","work_id":"w-shiji","source_id":"s-shiji-041-yue"},{"id":"c-shiji-041-yue:p006","text":"呉旣赦越，越王句踐反國，乃苦身焦思，置膽於坐，坐臥卽仰膽，飲食亦嘗膽也。曰：「女忘會稽之恥邪？」身自耕作，夫人自織，食不加肉，衣不重采，折節下賢人，厚遇賓客，振貧弔死，與百姓同其勞。欲使范蠡治國政，蠡對曰：「兵甲之事，種不如蠡；塡撫國家，親附百姓，蠡不如種。」於是舉國政屬大夫種，而使范蠡與大夫柘稽行成，爲質於呉。二歳而呉歸蠡。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-041-yue:m006-0005","start":5,"end":7,"surface":"越王","kind":"person","person_id":"cbr-p002055","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m006-0007","start":7,"end":9,"surface":"句踐","kind":"person","person_id":"cbr-p002055","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m006-0053","start":53,"end":55,"surface":"夫人","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名、群體、神祇或引語用稱待覆核；不補姓名與成員。"},{"id":"c-shiji-041-yue:m006-0093","start":93,"end":95,"surface":"范蠡","kind":"person","person_id":"cbr-p002061","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m006-0099","start":99,"end":100,"surface":"蠡","kind":"person","person_id":"cbr-p002061","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m006-0109","start":109,"end":110,"surface":"種","kind":"person","person_id":"cbr-p002062","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m006-0112","start":112,"end":113,"surface":"蠡","kind":"person","person_id":"cbr-p002061","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m006-0124","start":124,"end":125,"surface":"蠡","kind":"person","person_id":"cbr-p002061","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m006-0127","start":127,"end":128,"surface":"種","kind":"person","person_id":"cbr-p002062","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m006-0136","start":136,"end":139,"surface":"大夫種","kind":"person","person_id":"cbr-p002062","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m006-0142","start":142,"end":144,"surface":"范蠡","kind":"person","person_id":"cbr-p002061","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m006-0145","start":145,"end":149,"surface":"大夫柘稽","kind":"person","person_id":"cbr-p002069","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m006-0162","start":162,"end":163,"surface":"蠡","kind":"person","person_id":"cbr-p002061","status":"contextual_provisional"}],"chapter_id":"c-shiji-041-yue","book_id":"b-shiji-041","work_id":"w-shiji","source_id":"s-shiji-041-yue"},{"id":"c-shiji-041-yue:p008","text":"居二年，呉王將伐齊。子胥諫曰：「未可。臣聞句踐食不重味，與百姓同苦樂。此人不死，必爲國患。呉有越，腹心之疾，齊與呉，疥癬也。願王釋齊先越。」呉王弗聽，遂伐齊，敗之艾陵，虜齊髙、國以歸。讓子胥。子胥曰：「王毋喜！」王怒，子胥欲自殺，王聞而止之。越大夫種曰：「臣觀呉王政驕矣，請試嘗之貸粟，以卜其事。」請貸，呉王欲與，子胥諫勿與，王遂與之，越乃私喜。子胥言曰：「王不聽諫，後三年呉其墟乎！」太宰嚭聞之，乃數與子胥爭越議，因讒子胥曰：「伍員貌忠而實忍人，其父兄不顧，安能顧王？王前欲伐齊，員彊諫，已而有功，用是反怨王。王不備伍員，員必爲亂。」與逢同共謀，讒之王。王始不從，乃使子胥於齊，聞其讬子於鮑氏，王乃大怒，曰：「伍員果欺寡人！」役反，使人賜子胥屬鏤劍以自殺。子胥大笑曰：「我令而父霸，我又立若，若初欲分呉國半予我，我不受，已，今若反以讒誅我。嗟乎，嗟乎，一人固不能獨立！」報使者曰：「必取吾眼置呉東門，以觀越兵入也！」於是呉任嚭政。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-041-yue:m008-0004","start":4,"end":6,"surface":"呉王","kind":"person","person_id":"cbr-p002060","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m008-0010","start":10,"end":12,"surface":"子胥","kind":"person","person_id":"cbr-p002063","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m008-0021","start":21,"end":23,"surface":"句踐","kind":"person","person_id":"cbr-p002055","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m008-0063","start":63,"end":64,"surface":"王","kind":"person","person_id":"cbr-p002060","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m008-0070","start":70,"end":72,"surface":"呉王","kind":"person","person_id":"cbr-p002060","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m008-0085","start":85,"end":87,"surface":"齊髙","kind":"person","person_id":"cbr-p002071","status":"contextual_provisional"},{"id":"c-shiji-041-yue:m008-0088","start":88,"end":89,"surface":"國","kind":"person","person_id":"cbr-p002072"