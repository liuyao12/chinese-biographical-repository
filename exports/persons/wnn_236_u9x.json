{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"wnn_236_u9x","canonical_person_id":"wnn_236_u9x","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["wnn_236_u9x"],"persons":[{"id":"wnn_236_u9x","label":"育（司馬相如列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"育","mention_ids":["c-shiji-117-xiangru:m045-0112"]}],"evidence":[{"mention_id":"c-shiji-117-xiangru:m045-0112","chapter_id":"c-shiji-117-xiangru","paragraph_id":"c-shiji-117-xiangru:p045","quote":"育"}]}],"source_mention_summary":[{"source_id":"s-shiji117-xiangru","work_id":"w-shiji","book_id":"b-shiji-117","chapter_id":"c-shiji-117-xiangru","mention_count":1,"mention_ids":["c-shiji-117-xiangru:m045-0112"],"paragraph_ids":["c-shiji-117-xiangru:p045"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji117-xiangru"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-117-xiangru:m045-0112","start":112,"end":113,"surface":"育","kind":"person","person_id":"wnn_236_u9x","status":"contextual_provisional","paragraph_id":"c-shiji-117-xiangru:p045","chapter_id":"c-shiji-117-xiangru"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-117-xiangru:p045","text":"相如口吃而善著書。常有消渴疾。與卓氏婚，饒於財。其進仕宦，未嘗肯與公卿國家之事，稱病間居，不慕官爵。常從上至長楊獵，是時天子方好自擊熊彘，馳逐野獸，相如上疏諫之。其辭曰：\n臣聞物有同類而殊能者，故力稱烏獲，捷言慶忌，勇期賁、育。臣之愚，竊以為人誠有之，獸亦宜然。今陛下好陵阻險，射猛獸，卒然遇軼材之獸，駭不存之地，犯屬車之清塵，輿不及還轅，人不暇施巧，雖有烏獲、逢蒙之伎，力不得用，枯木朽株盡為害矣。是胡越起於轂下，而羌夷接軫也，豈不殆哉！雖萬全無患，然本非天子之所宜近也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m045-0000","start":0,"end":2,"surface":"相如","kind":"person","person_id":"usb_lgr_ksa","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0016","start":16,"end":18,"surface":"卓氏","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m045-0052","start":52,"end":53,"surface":"上","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0060","start":60,"end":62,"surface":"天子","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0074","start":74,"end":76,"surface":"相如","kind":"person","person_id":"usb_lgr_ksa","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0100","start":100,"end":102,"surface":"烏獲","kind":"person","person_id":"5sw_h4w_dcv","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0105","start":105,"end":107,"surface":"慶忌","kind":"person","person_id":"903_fwd_xdq","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0110","start":110,"end":111,"surface":"賁","kind":"person","person_id":"xne_qdl_46g","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0112","start":112,"end":113,"surface":"育","kind":"person","person_id":"wnn_236_u9x","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0132","start":132,"end":134,"surface":"陛下","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0178","start":178,"end":180,"surface":"烏獲","kind":"person","person_id":"5sw_h4w_dcv","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0181","start":181,"end":183,"surface":"逢蒙","kind":"person","person_id":"11c_i8z_674","status":"context