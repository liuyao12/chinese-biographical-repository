onal"},{"id":"c-shiji-049-waiqi:m007-0207","start":207,"end":209,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m007-0222","start":222,"end":224,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m007-0225","start":225,"end":227,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m007-0232","start":232,"end":234,"surface":"薄姬","kind":"person","person_id":"9zj_vf7_86a_A","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m007-0242","start":242,"end":244,"surface":"薄姬","kind":"person","person_id":"9zj_vf7_86a_A","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m007-0259","start":259,"end":261,"surface":"高帝","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m007-0284","start":284,"end":286,"surface":"代王","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m007-0289","start":289,"end":291,"surface":"薄姬","kind":"person","person_id":"9zj_vf7_86a_A","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m007-0293","start":293,"end":295,"surface":"高祖","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-049-waiqi","book_id":"b-shiji-049","work_id":"w-shiji","source_id":"s-shiji-049-waiqi"},{"id":"c-shiji-057-zhou:p012","text":"條侯亞夫自未侯為河內守時，許負相之，曰：「君後三歲而侯。侯八歲為將相，持國秉，貴重矣，於人臣無兩。其後九歲而君餓死。」亞夫笑曰：「臣之兄已代父侯矣，有如卒，子當代，亞夫何說侯乎？然既已貴如負言，又何說餓死？指示我。」許負指其口曰：「有從理入口，此餓死法也。」居三歲，其兄絳侯勝之有罪，孝文帝擇絳侯子賢者，皆推亞夫，乃封亞夫為條侯，續絳侯後。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-057-zhou:m012-0000","start":0,"end":4,"surface":"條侯亞夫","kind":"person","person_id":"koy_6jg_gcc_C","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m012-0013","start":13,"end":15,"surface":"許負","kind":"person","person_id":"qlu_yvc_mtu","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m012-0059","start":59,"end":61,"surface":"亞夫","kind":"person","person_id":"koy_6jg_gcc_C","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m012-0078","start":78,"end":81,"surface":"子當代","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者、假設侯嗣、職署或未定回指；不補姓名、親屬成員或爵位所指。"},{"id":"c-shiji-057-zhou:m012-0082","start":82,"end":84,"surface":"亞夫","kind":"person","person_id":"koy_6jg_gcc_C","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m012-0094","start":94,"end":95,"surface":"負","kind":"person","person_id":"qlu_yvc_mtu","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m012-0108","start":108,"end":110,"surface":"許負","kind":"person","person_id":"qlu_yvc_mtu","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m012-0135","start":135,"end":139,"surface":"絳侯勝之","kind":"person","person_id":"koy_6jg_gcc_A","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m012-0142","start":142,"end":145,"surface":"孝文帝","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m012-0146","start":146,"end":148,"surface":"絳侯","kind":"person","person_id":"koy_6jg_gcc","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m012-0154","start":154,"end":156,"surface":"亞夫","kind":"person","person_id":"koy_6jg_gcc_C","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m012-0159","start":159,"end":161,"surface":"亞夫","kind":"person","person_id":"koy_6jg_gcc_C","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m012-0162","start":162,"end":164,"surface":"條侯","kind":"person","person_id":"koy_6jg_gcc_C","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m012-0166","start":166,"end":168,"surface":"絳侯","kind":"person","person_id":"koy_6jg_gcc","status":"contextual_provisional"}],"chapter_id":"c-shiji-057-zhou","book_id":"b-shiji-057","work_id":"w-shiji","source_id":"s-shiji-057-zhou"},{"id":"c-shiji-124-youxia:p009","text":"郭解，軹人也，字翁伯，善相人者許負外孫也。解父以任俠，孝文時誅死。解為人短小精悍，不飲酒。少時陰賊，慨不快意，身所殺甚眾。以軀借交報仇，藏命作姦剽攻，不休及鑄錢掘冢，固不可勝數。適有天幸，窘急常得脫，若遇赦。及解年長，更折節為儉，以德報怨，厚施而薄望。然其自喜為俠益甚。既已振人之命，不矜其功，其陰賊著於心，卒發於睚眦如故云。而少年慕其行，亦輒為報仇，不使知也。解姊子負解之勢，與人飲，使之嚼。非其任，彊必灌之。人怒，拔刀刺殺解姊子，亡去。解姊怒曰：「以翁伯之義，人殺吾子，賊不得。」棄其尸於道，弗葬，欲以辱解。解使人微知賊處。賊窘自歸，具以實告解。解曰：「公殺之固當，吾兒不直。」遂去其賊，罪其姊子，乃收而葬之。諸公聞之，皆多解之義，益附焉。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-124-youxia:m009-0000","start":0,"end":2,"surface":"郭解","kind":"person","person_id":"5if_pf6_zos_A","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m009-0008","start":8,"end":10,"surface":"翁伯","kind":"person","person_id":"5if_pf6_zos_A","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m009-0015","start":15,"end":17,"surface":"許負","kind":"person","person_id":"qlu_yvc_mtu","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m009-0021","start":21,"end":23,"surface":"解父","kind":"person","person_id":"5if_pf6_zos","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m009-0027","start":27,"end":29,"surface":"孝文","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m009-0033","start":33,"end":34,"surface":"解","kind":"person","person_id":"5if_pf6_zos_A","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m009-0105","start":105,"end":106,"surface":"解","kind":"person","person_id":"5if_pf6_zos_A","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m009-0181","start":181,"end":184,"surface":"解姊子","kind":"person","person_id":"534_sha_7v7","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m009-0185","start":185,"end":186,"surface":"解","kind":"person","person_id":"5if_pf6_zos_A","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m009-0213","start":213,"end":216,"surface":"解姊子","kind":"person","person_id":"534_sha_7v7","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m009-