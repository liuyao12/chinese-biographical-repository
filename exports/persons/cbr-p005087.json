ragraph_id":"c-shiji-091-qingbu:p008","chapter_id":"c-shiji-091-qingbu"},{"id":"c-shiji-091-qingbu:m008-0056","start":56,"end":57,"surface":"何","kind":"person","person_id":"cbr-p005087","status":"contextual_provisional","paragraph_id":"c-shiji-091-qingbu:p008","chapter_id":"c-shiji-091-qingbu"},{"id":"c-shiji-091-qingbu:m008-0166","start":166,"end":167,"surface":"何","kind":"person","person_id":"cbr-p005087","status":"contextual_provisional","paragraph_id":"c-shiji-091-qingbu:p008","chapter_id":"c-shiji-091-qingbu"},{"id":"c-shiji-091-qingbu:m011-0014","start":14,"end":16,"surface":"隨何","kind":"person","person_id":"cbr-p005087","status":"contextual_provisional","paragraph_id":"c-shiji-091-qingbu:p011","chapter_id":"c-shiji-091-qingbu"},{"id":"c-shiji-091-qingbu:m011-0020","start":20,"end":21,"surface":"何","kind":"person","person_id":"cbr-p005087","status":"contextual_provisional","paragraph_id":"c-shiji-091-qingbu:p011","chapter_id":"c-shiji-091-qingbu"},{"id":"c-shiji-091-qingbu:m011-0033","start":33,"end":35,"surface":"隨何","kind":"person","person_id":"cbr-p005087","status":"contextual_provisional","paragraph_id":"c-shiji-091-qingbu:p011","chapter_id":"c-shiji-091-qingbu"},{"id":"c-shiji-091-qingbu:m011-0084","start":84,"end":86,"surface":"隨何","kind":"person","person_id":"cbr-p005087","status":"contextual_provisional","paragraph_id":"c-shiji-091-qingbu:p011","chapter_id":"c-shiji-091-qingbu"},{"id":"c-shiji-091-qingbu:m011-0092","start":92,"end":93,"surface":"何","kind":"person","person_id":"cbr-p005087","status":"contextual_provisional","paragraph_id":"c-shiji-091-qingbu:p011","chapter_id":"c-shiji-091-qingbu"},{"id":"c-shiji-091-qingbu:m011-0110","start":110,"end":111,"surface":"何","kind":"person","person_id":"cbr-p005087","status":"contextual_provisional","paragraph_id":"c-shiji-091-qingbu:p011","chapter_id":"c-shiji-091-qingbu"},{"id":"c-shiji-091-qingbu:m011-0160","start":160,"end":162,"surface":"隨何","kind":"person","person_id":"cbr-p005087","status":"contextual_provisional","paragraph_id":"c-shiji-091-qingbu:p011","chapter_id":"c-shiji-091-qingbu"}],"relations":[],"title_holdings":[{"id":"th-shiji091-010","person_id":"cbr-p005087","title":"謁者","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-091-qingbu","source_id":"s-shiji-091-qingbu","paragraph_id":"c-shiji-091-qingbu:p007","quote":"漢三年，漢王擊楚，大戰彭城，不利，出梁地，至虞，謂左右曰：「如彼等者，無足與計天下事。」謁者隨何進曰：「不審陛下所謂。」漢王曰：「孰能為我使淮南，令之發兵倍楚，留項王於齊數月，我之取天下可以百全。」隨何曰：「臣請使之。」乃與二十人俱，使淮南。至，因太宰主之，三日不得見。隨何因說太宰曰：「王之不見何，必以楚為彊，以漢為弱，此臣之所以為使。使何得見，言之而是邪，是大王所欲聞也；言之而非邪，使何等二十人伏斧質淮南市，以明王倍漢而與楚也。」太宰乃言之王，王見之。隨何曰：「漢王使臣敬進書大王御者，竊怪大王與楚何親也。」淮南王曰：「寡人北鄉而臣事之。」隨何曰：「大王與項王俱列為諸侯，北鄉而臣事之，必以楚為彊，可以讬國也。項王伐齊，身負板筑，以為士卒先，大王宜悉淮南之眾，身自將之，為楚軍前鋒，今乃發四千人以助楚。夫北面而臣事人者，固若是乎？夫漢王戰於彭城，項王未出齊也，大王宜騷淮南之兵渡淮，日夜會戰彭城下，大王撫萬人之眾，無一人渡淮者，垂拱而觀其孰勝。夫讬國於人者，固若是乎？大王提空名以鄉楚，而欲厚自讬，臣竊為大王不取也。然而大王不背楚者，以漢為弱也。夫楚兵雖彊，天下負之以不義之名，以其背盟約而殺義帝也。然而楚王恃戰勝自彊，漢王收諸侯，還守成皋、滎陽，下蜀、漢之粟，深溝壁壘，分卒守徼乘塞，楚人還兵，閒以梁地，深入敵國八九百里，欲戰則不得，攻城則力不能，老弱轉糧千里之外；楚兵至滎陽、成皋，漢堅守而不動，進則不得攻，退則不得解。故曰楚兵不足恃也。使楚勝漢，則諸侯自危懼而相救。夫楚之彊，適足以致天下之兵耳。故楚不如漢，其勢易見也。今大王不與萬全之漢而自讬於危亡之楚，臣竊為大王惑之。臣非以淮南之兵足以亡楚也。夫大王發兵而倍楚，項王必留；留數月，漢之取天下可以萬全。臣請與大王提劍而歸漢，漢王必裂地而封大王，又況淮南，淮南必大王有也。故漢王敬使使臣進愚計，願大王之留意也。」淮南王曰：「請奉命。」陰許畔楚與漢，未敢泄也。"}],"attestations":[{"id":"th-shiji091-010:a001","paragraph_id":"c-shiji-091-qingbu:p007","start":44,"end":46,"surface":"謁者","person_mention_id":"c-shiji-091-qingbu:m007-0046","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予與用稱分存；常冠軍不作官名，欲為帝不作即帝位，稱病反楚死亡不補官爵終期。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji091-014","person_id":"cbr-p005087","title":"護軍中尉","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-091-qingbu","source_id":"s-shiji-091-qingbu","paragraph_id":"c-shiji-091-qingbu:p011","quote":"項籍死，天下定，上置酒。上折隨何之功，謂何為腐儒，為天下安用腐儒。隨何跪曰：「夫陛下引兵攻彭城，楚王未去齊也，陛下發步卒五萬人，騎五千，能以取淮南乎？」上曰：「不能。」隨何曰：「陛下使何與二十人使淮南，至，如陛下之意，是何之功賢於步卒五萬人騎五千也。然而陛下謂何腐儒，為天下安用腐儒，何也？」上曰：「吾方圖子之功。」乃以隨何為護軍中尉。布遂剖符為淮南王，都六，九江、廬江、衡山、豫章郡皆屬布。"}],"attestations":[{"id":"th-shiji091-014:a001","paragraph_id":"c-shiji-091-qingbu:p011","start":163,"end":167,"surface":"護軍中尉","person_mention_id":"c-shiji-091-qingbu:m011-0160","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-091-qingbu","source_id":"s-shiji-091-qingbu","paragraph_id":"c-shiji-091-qingbu:p011","quote":"項籍死，天下定，上置酒。上折隨何之功，謂何為腐儒，為天下安用腐儒。隨何跪曰：「夫陛下引兵攻彭城，楚王未去齊也，陛下發步卒五萬人，騎五千，能以取淮南乎？」上曰：「不能。」隨何曰：「陛下使何與二十人使淮南，至，如陛下之意，是何之功賢於步卒五萬人騎五千也。然而陛下謂何腐儒，為天下安用腐儒，何也？」上曰：「吾方圖子之功。」乃以隨何為護軍中尉。布遂剖符為淮南王，都六，九江、廬江、衡山、豫章郡皆屬布。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予與用稱分存；常冠軍不作官名，欲為帝不作即帝位，稱病反楚死亡不補官爵終期。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji091-028","person_id":"cbr-p005087","scope":"same_chapter","chapter_ids":["c-shiji-091-qingbu"],"status":"contextual_provisional","rationale":"按本段明示姓名及局部敘事承接；布與兩王號按英布主線暫接。番君與長沙哀王分候選，所幸姬不與番君女合併；皋陶引古疑問不作祖先定論。","reviewer":"Codex（AI 代理）","surfaces":["何","隨何"],"evidence":[{"paragraph_id":"c-shiji-091-qingbu:p007","quote":"漢三年，漢王擊楚，大戰彭城，不利，出梁地，至虞，謂左右曰：「如彼等者，無足與計天下事。」謁者隨何進曰：「不審陛下所謂。」漢王曰：「孰能為我使淮南，令之發兵倍楚，留項王於齊數月，我之取天下可以百全。」隨何曰：「臣請使之。」乃與二十人俱，使淮南。至，因太宰主之，三日不得見。隨何因說太宰曰：「王之不見何，必以楚為彊，以漢為弱，此臣之所以為使。使何得見，言之而是邪，是大王所欲聞也；言之而非邪，使何等二十人伏斧質淮南市，以明王倍漢而與楚也。」太宰乃言之王，王見之。隨何曰：「漢王使臣敬進書大王御者，竊怪大王與楚何親也。」淮南王曰：「寡人北鄉而臣事之。」隨何曰：「大王與項王俱列為諸侯，北鄉而臣事之，必以楚為彊，可以讬國也。項王伐齊，身負板筑，以為士卒先，大王宜悉淮南之眾，身自將之，為楚軍前鋒，今乃發四千人以助楚。夫北面而臣事人者，固若是乎？夫漢王戰於彭城，項王未出齊也，大王宜騷淮南之兵渡淮，日夜會戰彭城下，大王撫萬人之眾，無一人渡淮者，垂拱而觀其孰勝。夫讬國於人者，固若是乎？大王提空名以鄉楚，而欲厚自讬，臣竊為大王不取也。然而大王不背楚者，以漢為弱也。夫楚兵雖彊，天下負之以不義之名，以其背盟約而殺義帝也。然而楚王恃戰勝自彊，漢王收諸侯，還守成皋、滎陽，下蜀、漢之粟，深溝壁壘，分卒守徼乘塞，楚人還兵，閒以梁地，深入敵國八九百里，欲戰則不得，攻城則力不能，老弱轉糧千里之外；楚兵至滎陽、成皋，漢堅守而不動，進則不得攻，退則不得解。故曰楚兵不足恃也。使楚勝漢，則諸侯自危懼而相救。夫楚之彊，適足以致天下之兵耳。故楚不如漢，其勢易見也。今大王不與萬全之漢而自讬於危亡之楚，臣竊為大王惑之。臣非以淮南之兵足以亡楚也。夫大王發兵而倍楚，項王必留；留數月，漢之取天下可以萬全。臣請與大王提劍而歸漢，漢王必裂地而封大王，又況淮南，淮南必大王有也。故漢王敬使使臣進愚計，願大王之留意也。」淮南王曰：「請奉命。」陰許畔楚與漢，未敢泄也。"},{"paragraph_id":"c-shiji-091-qingbu:p008","quote":"楚使者在，方急責英布發兵，舍傳舍。隨何直入，坐楚使者上坐，曰：「九江王已歸漢，楚何以得發兵？」布愕然。楚使者起。何因說布曰：「事已搆，可遂殺楚使者，無使歸，而疾走漢并力。」布曰：「如使者教，因起兵而擊之耳。」於是殺使者，因起兵而攻楚。楚使項聲、龍且攻淮南，項王留而攻下邑。數月，龍且擊淮南，破布軍。布欲引兵走漢，恐楚王殺之，故閒行與何俱歸漢。"},{"paragraph_id":"c-shiji-091-qingbu:p011","quote":"項籍死，天下定，上置酒。上折隨何之功，謂何為腐儒，為天下安用腐儒。隨何跪曰：「夫陛下引兵攻彭城，楚王未去齊也，陛下發步卒五萬人，騎五千，能以取淮南乎？」上曰：「不能。」隨何曰：「陛下使何與二十人使淮南，至，如陛下之意，是何之功賢於步卒五萬人騎五千也。然而陛下謂何腐儒，為天下安用腐儒，何也？」上曰：「吾方圖子之功。」乃以隨何為護軍中尉。布遂剖符為淮南王，都六，九江、廬江、衡山、豫章郡皆屬布。"}]}],"equivalence_decisions":[{"id":"eq-shiji091-sui","person_ids":["cbr-p000777","cbr-p005087"],"canonical_person_id":"cbr-p000777","scope":"cross_chapter","chapter_ids":["c-shiji-008-gaozu","c-shiji-091-qingbu"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-008-gaozu","source_id":"s-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p035","quote":"呂后兄周呂侯為漢將兵，居下邑。漢王從之，稍收士卒，軍碭。漢王乃西過梁地，至虞。使謁者隨何之九江王布所，曰：「公能令布舉兵叛楚，項羽必留擊之。得留數月，吾取天下必矣。」隨何往說九江王布，布果背楚。楚使龍且往擊之。","mention_ids":["c-shiji-008-gaozu:m035-0042","c-shiji-008-gaozu:m035-0083"]},{"chapter_id":"c-shiji-008-gaozu","source_id":"s-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p037","quote":"是時九江王布與龍且戰，不勝，與隨何閒行歸漢。漢王稍收士卒，與諸將及關中卒益出，是以兵大振滎陽，破楚京、索閒。","mention_ids":["c-shiji-008-gaozu:m037-0015"]},{"chapter_id":"c-shiji-091-qingbu","source_id":"s-shiji-091-qingbu","paragraph_id":"c-shiji-091-qingbu:p008","quote":"楚使者在，方急責英布發兵，舍傳舍。隨何直入，坐楚使者上坐，曰：「九江王已歸漢，楚何以得發兵？」布愕然。楚使者起。何因說布曰：「事已搆，可遂殺楚使者，無使歸，而疾走漢并力。」布曰：「如使者教，因起兵而擊之耳。」於是殺使者，因起兵而攻楚。楚使項聲、龍且攻淮南，項王留而攻下邑。數月，龍且擊淮南，破布軍。布欲引兵走漢，恐楚王殺之，故閒行與何俱歸漢。","mention_ids":["c-shiji-091-qingbu:m008-0017","c-shiji-091-qingbu:m008-0056","c-shiji-091-qingbu:m008-0166"]}],"rationale":"隨何說九江王畔楚並同英布閒行歸漢的事件相配。 各篇原字、原文與已發ID保留，同書不視為獨立見證；同指不確證所有紀年、任職、親屬或敘事，不按全域同名批量改號。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-008-gaozu:p035","text":"呂后兄周呂侯為漢將兵，居下邑。漢王從之，稍收士卒，軍碭。漢王乃西過梁地，至虞。使謁者隨何之九江王布所，曰：「公能令布舉兵叛楚，項羽必留擊之。得留數月，吾取天下必矣。」隨何往說九江王布，布果背楚。楚使龍且往擊之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m035-0000","start":0,"end":2,"surface":"呂后","kind":"person","person_id":"cbr-p000717","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m035-0003","start":3,"end":6,"surface":"周呂侯","kind":"person","person_id":"cbr-p000719","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m035-0015","start":15,"end":17,"surface":"漢王","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m035-0028","start":28,"end":30,"surface":"漢王","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m035-0042","start":42,"end":44,"surface":"隨何","kind":"person","person_id":"cbr-p000777","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m035-0045","start":45,"end":49,"surface":"九江王布","kind":"person","person_id":"cbr-p000656","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m035-0057","start":57,"end":58,"surface":"布","kind":"person","person_id":"cbr-p000656","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m035-0063","start":63,"end":65,"surface":"項羽","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m035-0083","start":83,"end":85,"surface":"隨何","kind":"person","person_id":"cbr-p000777","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m035-0087","start":87,"end":91,"surface":"九江王布","kind":"person","person_id":"cbr-p000656","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m035-0092","start":92,"end":93,"surface":"布","kind":"person","person_id":"cbr-p000656","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m035-0099","start":99,"end":101,"surface":"龍且","kind":"person","person_id":"cbr-p000666","status":"contextual_provisional"}],"chapter_id":"c-shiji-008-gaozu","book_id":"b-shiji-008","work_id":"w-shiji","source_id":"s-shiji-008-gaozu"},{"id":"c-shiji-008-gaozu:p037","text":"是時九江王布與龍且戰，不勝，與隨何閒行歸漢。漢王稍收士卒，與諸將及關中卒益出，是以兵大振滎陽，破楚京、索閒。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m037-0002","start":2,"end":6,"surface":"九江王布","kind":"person","person_id":"cbr-p000656","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m037-0007","start":7,"end":9,"surface":"龍且","kind":"person","person_id":"cbr-p000666","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m037-0015","start":15,"end":17,"surface":"隨何","kind":"person","person_id":"cbr-p000777","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m037-0022","start":22,"end":24,"surface":"漢王","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"}],"chapter_id":"c-shiji-008-gaozu","book_id":"b-shiji-008","work_id":"w-shiji","source_id":"s-shiji-008-gaozu"},{"id":"c-shiji-091-qingbu:p007","text":"漢三年，漢王擊楚，大戰彭城，不利，出梁地，至虞，謂左右曰：「如彼等者，無足與計天下事。」謁者隨何進曰：「不審陛下所謂。」漢王曰：「孰能為我使淮南，令之發兵倍楚，留項王於齊數月，我之取天下可以百全。」隨何曰：「臣請使之。」乃與二十人俱，使淮南。至，因太宰主之，三日不得見。隨何因說太宰曰：「王之不見何，必以楚為彊，以漢為弱，此臣之所以為使。使何得見，言之而是邪，是大王所欲聞也；言之而非邪，使何等二十人伏斧質淮南市，以明王倍漢而與楚也。」太宰乃言之王，王見之。隨何曰：「漢王使臣敬進書大王御者，竊怪大王與楚何親也。」淮南王曰：「寡人北鄉而臣事之。」隨何曰：「大王與項王俱列為諸侯，北鄉而臣事之，必以楚為彊，可以讬國也。項王伐齊，身負板筑，以為士卒先，大王宜悉淮南之眾，身自將之，為楚軍前鋒，今乃發四千人以助楚。夫北面而臣事人者，固若是乎？夫漢王戰於彭城，項王未出齊也，大王宜騷淮南之兵渡淮，日夜會戰彭城下，大王撫萬人之眾，無一人渡淮者，垂拱而觀其孰勝。夫讬國於人者，固若是乎？大王提空名以鄉楚，而欲厚自讬，臣竊為大王不取也。然而大王不背楚者，以漢為弱也。夫楚兵雖彊，天下負之以不義之名，以其背盟約而殺義帝也。然而楚王恃戰勝自彊，漢王收諸侯，還守成皋、滎陽，下蜀、漢之粟，深溝壁壘，分卒守徼乘塞，楚人還兵，閒以梁地，深入敵國八九百里，欲戰則不得，攻城則力不能，老弱轉糧千里之外；楚兵至滎陽、成皋，漢堅守而不動，進則不得攻，退則不得解。故曰楚兵不足恃也。使楚勝漢，則諸侯自危懼而相救。夫楚之彊，適足以致天下之兵耳。故楚不如漢，其勢易見也。今大王不與萬全之漢而自讬於危亡之楚，臣竊為大王惑之。臣非以淮南之兵足以亡楚也。夫大王發兵而倍楚，項王必留；留數月，漢之取天下可以萬全。臣請與大王提劍而歸漢，漢王必裂地而封大王，又況淮南，淮南必大王有也。故漢王敬使使臣進愚計，願大王之留意也。」淮南王曰：「請奉命。」陰許畔楚與漢，未敢泄也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-091-qingbu:m007-0004","start":4,"end":6,"surface":"漢王","kind":"person","person_id":"cbr-p005086","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m007-0025","start":25,"end":27,"surface":"左右","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未定指代或匿名者保留原文，不補姓名成員。"},{"id":"c-shiji-091-qingbu:m007-0046","start":46,"end":48,"surface":"隨何","kind":"person","person_id":"cbr-p005087","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m007-0060","start":60,"end":62,"surface":"漢王","kind":"person","person_id":"cbr-p005086","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m007-0081","start":81,"end":83,"surface":"項王","kind":"person","person_id":"cbr-p005074","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m007-0099","start":99,"end":101,"surface":"隨何","kind":"person","person_id":"cbr-p005087","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m007-0112","start":112,"end":115,"surface":"二十人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未定指代或匿名者保留原文，不補姓名成員。"},{"id":"c-shiji-091-qingbu:m007-0124","start":124,"end":126,"surface":"太宰","kind":"person","person_id":"cbr-p005088","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m007-0135","start":135,"end":137,"surface":"隨何","kind":"person","person_id":"cbr-p005087","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m007-0139","start":139,"end":141,"surface":"太宰","kind":"person","person_id":"cbr-p005088","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m007-0148","start":148,"end":149,"surface":"何","kind":"person","person_id":"cbr-p005087","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m007-0170","start":170,"end":171,"surface":"何","kind":"person","person_id":"cbr-p005087","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m007-0195","start":195,"end":196,"surface":"何","kind":"person","person_id":"cbr-p005087","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m007-0197","start":197,"end":200,"surface":"二十人","kind":"unresolved","person_id":null,"status":"unresolved