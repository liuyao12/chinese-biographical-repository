r-p001916","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m054-0174","start":174,"end":176,"surface":"昭王","kind":"person","person_id":"cbr-p001915","status":"contextual_provisional"}],"chapter_id":"c-shiji-040-chu","book_id":"b-shiji-040","work_id":"w-shiji","source_id":"s-shiji-040-chu"},{"id":"c-shiji-040-chu:p055","text":"惠王二年，子西召故平王太子建之子勝於呉，以爲巣大夫，號曰白公。白公好兵而下士，欲報仇。六年，白公請兵令尹子西伐鄭。初，白公父建亡在鄭，鄭殺之，白公亡走呉，子西復召之，故以此怨鄭，欲伐之。子西許而未爲發兵。八年，晉伐鄭，鄭告急楚，楚使子西救鄭，受賂而去。白公勝怒，乃遂與勇力死士石乞等襲殺令尹子西、子綦於朝，因劫惠王，置之髙府，欲弒之。惠王從者屈固負王亡走昭王夫人宮。白公自立爲王。月餘，會葉公來救楚，楚惠王之徒與共攻白公，殺之。惠王乃復位。是歳也，滅陳而縣之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m055-0000","start":0,"end":2,"surface":"惠王","kind":"person","person_id":"cbr-p001916","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m055-0005","start":5,"end":7,"surface":"子西","kind":"person","person_id":"cbr-p001935","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m055-0009","start":9,"end":11,"surface":"平王","kind":"person","person_id":"cbr-p001892","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m055-0011","start":11,"end":14,"surface":"太子建","kind":"person","person_id":"cbr-p001929","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m055-0016","start":16,"end":17,"surface":"勝","kind":"person","person_id":"cbr-p001940","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m055-0028","start":28,"end":30,"surface":"白公","kind":"person","person_id":"cbr-p001940","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m055-0031","start":31,"end":33,"surface":"白公","kind":"person","person_id":"cbr-p001940","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m055-0046","start":46,"end":48,"surface":"白公","kind":"person","person_id":"cbr-p001940","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m055-0052","start":52,"end":54,"surface":"子西","kind":"person","person_id":"cbr-p001935","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m055-0