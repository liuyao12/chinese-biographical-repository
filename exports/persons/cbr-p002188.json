d":"c-shiji-042-zheng:m037-0072","start":72,"end":76,"surface":"公子子孔","kind":"person","person_id":"b5q_cso_92n","status":"contextual_provisional","paragraph_id":"c-shiji-042-zheng:p037","chapter_id":"c-shiji-042-zheng"},{"id":"c-shiji-042-zheng:m037-0087","start":87,"end":89,"surface":"子孔","kind":"person","person_id":"b5q_cso_92n","status":"contextual_provisional","paragraph_id":"c-shiji-042-zheng:p037","chapter_id":"c-shiji-042-zheng"},{"id":"c-shiji-042-zheng:m037-0123","start":123,"end":125,"surface":"子孔","kind":"person","person_id":"b5q_cso_92n","status":"contextual_provisional","paragraph_id":"c-shiji-042-zheng:p037","chapter_id":"c-shiji-042-zheng"},{"id":"c-shiji-042-zheng:m039-0008","start":8,"end":10,"surface":"子孔","kind":"person","person_id":"b5q_cso_92n","status":"contextual_provisional","paragraph_id":"c-shiji-042-zheng:p039","chapter_id":"c-shiji-042-zheng"}],"relations":[],"title_holdings":[{"id":"th-shiji042-017","person_id":"b5q_cso_92n","title":"相","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-042-zheng","source_id":"s-shiji-042-zheng","paragraph_id":"c-shiji-042-zheng:p037","quote":"簡公元年，諸公子謀欲誅相子駟，子駟覺之，反盡誅諸公子。二年，晉伐鄭，鄭與盟，晉去。冬，又與楚盟。子駟畏誅，故兩親晉、楚。三年，相子駟欲自立爲君，公子子孔使尉止殺相子駟而代之。子孔又欲自立。子産曰：「子駟爲不可，誅之，今又效之，是亂無時息也。」於是子孔從之而相鄭簡公。"}],"attestations":[{"id":"th-shiji042-017:a001","paragraph_id":"c-shiji-042-zheng:p037","start":128,"end":129,"surface":"相","person_mention_id":"c-shiji-042-zheng:m037-0123","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授位與既有用稱分開；原相對年份未換算。未知端點不由卒日、入質、逃亡、首次提及或欲自立推造。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji042-094","person_id":"b5q_cso_92n","scope":"same_chapter","chapter_ids":["c-shiji-042-zheng"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["公子子孔","子孔"],"evidence":[{"paragraph_id":"c-shiji-042-zheng:p037","quote":"簡公元年，諸公子謀欲誅相子駟，子駟覺之，反盡誅諸公子。二年，晉伐鄭，鄭與盟，晉去。冬，又與楚盟。子駟畏誅，故兩親晉、楚。三年，相子駟欲自立爲君，公子子孔使尉止殺相子駟而代之。子孔又欲自立。子産曰：「子駟爲不可，誅之，今又效之，是亂無時息也。」於是子孔從之而相鄭簡公。"},{"paragraph_id":"c-shiji-042-zheng:p039","quote":"十二年，簡公怒相子孔專國權，誅之，而以子産爲卿。十九年，簡公如晉請衞君還，而封子産以六邑。子産讓，受其三邑。二十二年，呉使延陵季子於鄭，見子産如舊交，謂子産曰：「鄭之執政者侈，難將至，政將及子。子爲政，必以禮；不然，鄭將敗。」子産厚遇季子。二十三年，諸公子爭寵相殺，又欲殺子産。公子或諫曰：「子産仁人，鄭所以存者子産也，勿殺！」乃止。"}],"rationale":"依本篇名字、是為、世系及連續事件暫接異稱；同諡不同國分開，建子勝與聲公勝不合併，如兄弟為譬喻不作親屬。述贊與正文不算獨立來源，省稱、古字與校勘仍待核。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-042-zheng:p037","text":"簡公元年，諸公子謀欲誅相子駟，子駟覺之，反盡誅諸公子。二年，晉伐鄭，鄭與盟，晉去。冬，又與楚盟。子駟畏誅，故兩親晉、楚。三年，相子駟欲自立爲君，公子子孔使尉止殺相子駟而代之。子孔又欲自立。子産曰：「子駟爲不可，誅之，今又效之，是亂無時息也。」於是子孔從之而相鄭簡公。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-042-zheng:m037-0000","start":0,"end":2,"surface":"簡公","kind":"person","person_id":"gts_42q_flu_AA","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m037-0005","start":5,"end":8,"surface":"諸公子","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名、群體、夢中或神祇指代及提議用稱保留；不補姓名、個人成員或授位事實。"},{"id":"c-shiji-042-zheng:m037-0012","start":12,"end":14,"surface":"子駟","kind":"person","person_id":"7hl_jbv_m5y","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m037-0015","start":15,"end":17,"surface":"子駟","kind":"person","person_id":"7hl_jbv_m5y","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m037-0023","start":23,"end":26,"surface":"諸公子","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名、群體、夢中或神祇指代及提議用稱保留；不補姓名、個人成員或授位事實。"},{"id":"c-shiji-042-zheng:m037-0048","start":48,"end":50,"surface":"子駟","kind":"person","person_id":"7hl_jbv_m5y","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m037-0064","start":64,"end":66,"surface":"子駟","kind":"person","person_id":"7hl_jbv_m5y","status":"contextual_provisional"},{"id":"