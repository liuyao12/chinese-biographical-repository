huinan:p002:m0064","relationship_anchor":{"paragraph_id":"c-nanshi-011-luhuinan:p002","surface":"瓊之及弟休之、茂之","start":64,"end":73}}],"status":"source_attested","interpretation_note":"兩人均為瓊之弟，原文未定休之、茂之彼此長幼。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"a-nanshi011-luhuinan-s-brother-茂之","subject_person_id":"0ej_lsn_fpk_B","object_person_id":"zwn_iir_orb","predicate":"brother","qualifiers":{"source_term":"瓊之及弟休之、茂之","nanshi011_luhuinan_reading":"s-brother-茂之","relative_birth_order":{"older_person_id":"zwn_iir_orb","younger_person_id":"0ej_lsn_fpk_B","operator":"lt","scope":"siblings","older_ordinal":null,"younger_ordinal":null,"siblings_total":null,"source_term":"弟"}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-041","source_id":"s-songshu-041-luhuinan-ws2634831","chapter_id":"c-songshu-041-luhuinan","paragraph_id":"c-songshu-041-luhuinan:p003","quote":"孝建二年，追贈太后父興之散騎常侍，興之妻徐氏餘杭縣廣昌鄉君。大明四年，太后弟子撫軍參軍瓊之上表曰：「先臣故懷安令道慶賦命乖辰，自違明世。敢緣衞戍請名之典，特乞雲雨，微垂灑潤。」詔付門下。有司承旨奏贈給事中。瓊之及弟休之、茂之並超顯職。太后頗豫政事，賜與瓊之等財物，家累千金，居處服器，與帝子相侔。","subject_person_mention_id":"c-songshu-041-luhuinan:p003:m0110","object_person_mention_id":"c-songshu-041-luhuinan:p003:m0103","relationship_anchor":{"paragraph_id":"c-songshu-041-luhuinan:p003","surface":"瓊之及弟休之、茂之","start":103,"end":112}}],"status":"source_attested","interpretation_note":"兩人均為瓊之弟，原文未定休之、茂之彼此長幼。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"title_holdings":[{"id":"th-nanshi011-luhuinan-s8-29","person_id":"0ej_lsn_fpk_B","title":"左軍將軍","kind":"office","mode":"grant","attestations":[{"id":"th-nanshi011-luhuinan-s8-29:a","person_mention_id":"c-songshu-041-luhuinan:p008:m0104","usage":"narrative","date_expression":null,"paragraph_id":"c-songshu-041-luhuinan:p008","surface":"左軍將軍","start":29,"end":33}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-041","source_id":"s-songshu-041-luhuinan-ws2634831","chapter_id":"c-songshu-041-luhuinan","paragraph_id":"c-songshu-041-luhuinan:p008","quote":"瓊之為衡陽內史，先后卒。廢帝景和中，以休之為黃門侍郎，茂之左軍將軍，並封開國縣侯，邑千戶。又追贈興之侍中、金紫光祿大夫，諡曰孝侯；道慶散騎常侍、光祿大夫、開府儀同三司，諡曰敬侯。立道慶女為皇后，以休之為侍中，茂之黃門郎。太宗廢幼主，欲說太后之心，乃下令書曰：「太皇太后蚤垂愛遇，沿情即事，同於天屬。前車騎諮議參軍路休之、前丹陽丞路茂之，崇憲密戚，蚤延榮貫，並懷所勳，宜殊恒飾。休之可黃門侍郎，領步兵校尉；茂之可中書侍郎。」太宗未即位，故稱令書。茂之又遷司徒從事中郎，休之桂陽王休範鎮北諮議參軍。太宗殺世祖諸子，因此陷休之等，宥其諸子。","person_mention_id":"c-songshu-041-luhuinan:p008:m0104"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-041","source_id":"s-songshu-041-luhuinan-ws2634831","chapter_id":"c-songshu-041-luhuinan","paragraph_id":"c-songshu-041-luhuinan:p008","quote":"瓊之為衡陽內史，先后卒。廢帝景和中，以休之為黃門侍郎，茂之左軍將軍，並封開國縣侯，邑千戶。又追贈興之侍中、金紫光祿大夫，諡曰孝侯；道慶散騎常侍、光祿大夫、開府儀同三司，諡曰敬侯。立道慶女為皇后，以休之為侍中，茂之黃門郎。太宗廢幼主，欲說太后之心，乃下令書曰：「太皇太后蚤垂愛遇，沿情即事，同於天屬。前車騎諮議參軍路休之、前丹陽丞路茂之，崇憲密戚，蚤延榮貫，並懷所勳，宜殊恒飾。休之可黃門侍郎，領步兵校尉；茂之可中書侍郎。」太宗未即位，故稱令書。茂之又遷司徒從事中郎，休之桂陽王休範鎮北諮議參軍。太宗殺世祖諸子，因此陷休之等，宥其諸子。","person_mention_id":"c-songshu-041-luhuinan:p008:m0104"}],"status":"source_attested","interpretation_note":"按本見證原職名及其所屬人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"th-nanshi011-luhuinan-s8-106","person_id":"0ej_lsn_fpk_B","title":"黃門郎","kind":"office","mode":"grant","attestations":[{"id":"th-nanshi011-luhuinan-s8-106:a","person_mention_id":"c-songshu-041-luhuinan:p008:m0104","usage":"narrative","date_expression":null,"paragraph_id":"c-songshu-041-luhuinan:p008","surface":"黃門郎","start":106,"end":109}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-041","source_id":"s-songshu-041-luhuinan-ws2634831","chapter_id":"c-songshu-041-luhuinan","paragraph_id":"c-songshu-041-luhuinan:p008","quote":"瓊之為衡陽內史，先后卒。廢帝景和中，以休之為黃門侍郎，茂之左軍將軍，並封開國縣侯，邑千戶。又追贈興之侍中、金紫光祿大夫，諡曰孝侯；道慶散騎常侍、光祿大夫、開府儀同三司，諡曰敬侯。立道慶女為皇后，以休之為侍中，茂之黃門郎。太宗廢幼主，欲說太后之心，乃下令書曰：「太皇太后蚤垂愛遇，沿情即事，同於天屬。前車騎諮議參軍路休之、前丹陽丞路茂之，崇憲密戚，蚤延榮貫，並懷所勳，宜殊恒飾。休之可黃門侍郎，領步兵校尉；茂之可中書侍郎。」太宗未即位