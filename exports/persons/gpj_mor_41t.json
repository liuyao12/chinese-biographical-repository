何能為？此欲以肉餧虎耳。」他日與蒙會，又蚩辱之。蒙大怒，引刀殺吏，出走，逃邑子鄭長家。出因校尉袁雄自首，承間為言，策召見奇之，引置左右。數歲，鄧當死，張昭薦蒙代當，拜別部司馬。權統事，料諸小將兵少而用薄者，欲併合之。蒙陰賒貰，為兵作絳衣行滕，及簡日，陳列赫然，兵人練習，權見之大悅，增其兵。從討丹楊，所向有功，拜平北都尉，領廣德長。從徵黃祖，祖令都督陳就逆以水軍出戰。蒙勒前鋒，親梟就首，將士乘勝，進攻其城。祖聞就死，委城走，兵追禽之。權曰：「事之克，由陳就先獲也。」以蒙為橫野中郎將，賜錢千萬。","person_mention_id":"c-sanguozhi-054-lvmeng:line060:m0303"}],"interpretation_note":"本來源所記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-sanguozhi-054-lvmeng:line060:m0303","start":303,"end":305,"surface":"陳就","kind":"person","person_id":"gpj_mor_41t","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-054-lvmeng:line060","chapter_id":"c-sanguozhi-054-lvmeng"},{"id":"c-sanguozhi-054-lvmeng:line060:m0319","start":319,"end":320,"surface":"就","kind":"person","person_id":"gpj_mor_41t","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-054-lvmeng:line060","chapter_id":"c-sanguozhi-054-lvmeng"},{"id":"c-sanguozhi-054-lvmeng:line060:m0334","start":334,"end":335,"surface":"就","kind":"person","person_id":"gpj_mor_41t","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-054-lvmeng:line060","chapter_id":"c-sanguozhi-054-lvmeng"},{"id":"c-sanguozhi-054-lvmeng:line060:m0355","start":355,"end":357,"surface":"陳就","kind":"person","person_id":"gpj_mor_41t","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-054-lvmeng:line060","chapter_id":"c-sanguozhi-054-lvmeng"}],"relations":[],"title_holdings":[{"id":"t-wu054-t-wu054-lvmeng4","person_id":"gpj_mor_41t","kind":"office","title":"都督","mode":"attestation","status":"source_attested","effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本句所載職官，任免時間未詳。","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-054","chap