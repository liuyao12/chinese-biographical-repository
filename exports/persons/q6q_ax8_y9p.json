ue,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-071-chugan:m001-0008","start":8,"end":11,"surface":"秦惠王","kind":"person","person_id":"q6q_ax8_y9p","status":"contextual_provisional","paragraph_id":"c-shiji-071-chugan:p001","chapter_id":"c-shiji-071-chugan"},{"id":"c-shiji-071-chugan:m001-0016","start":16,"end":18,"surface":"惠王","kind":"person","person_id":"q6q_ax8_y9p","status":"contextual_provisional","paragraph_id":"c-shiji-071-chugan:p001","chapter_id":"c-shiji-071-chugan"},{"id":"c-shiji-071-chugan:m002-0000","start":0,"end":3,"surface":"秦惠王","kind":"person","person_id":"q6q_ax8_y9p","status":"contextual_provisional","paragraph_id":"c-shiji-071-chugan:p002","chapter_id":"c-shiji-071-chugan"},{"id":"c-shiji-071-chugan:m002-0033","start":33,"end":36,"surface":"秦惠王","kind":"person","person_id":"q6q_ax8_y9p","status":"contextual_provisional","paragraph_id":"c-shiji-071-chugan:p002","chapter_id":"c-shiji-071-chugan"},{"id":"c-shiji-071-chugan:m003-0000","start":0,"end":3,"surface":"秦惠王","kind":"person","person_id":"q6q_ax8_y9p","status":"contextual_provisional","paragraph_id":"c-shiji-071-chugan:p003","chapter_id":"c-shiji-071-chugan"},{"id":"c-shiji-071-chugan:m007-0033","start":33,"end":36,"surface":"秦惠王","kind":"person","person_id":"q6q_ax8_y9p","status":"contextual_provisional","paragraph_id":"c-shiji-071-chugan:p007","chapter_id":"c-shiji-071-chugan"},{"id":"c-shiji-071-chugan:m007-0037","start":37,"end":38,"surface":"王","kind":"person","person_id":"q6q_ax8_y9p","status":"contextual_provisional","paragraph_id":"c-shiji-071-chugan:p007","chapter_id":"c-shiji-071-chugan"},{"id":"c-shiji-071-chugan:m008-0000","start":0,"end":2,"surface":"惠王","kind":"person","person_id":"q6q_ax8_y9p","status":"contextual_provisional","paragraph_id":"c-shiji-071-chugan:p008","chapter_id":"c-shiji-071-chugan"},{"id":"c-shiji-071-chugan:m009-0353","start":353,"end":355,"surface":"先王","kind":"person","person_id":"q6q_ax8_y9p","status":"contextual_provisional","paragraph_id":"c-shiji-071-chugan:p009","chapter_id":"c-shiji-071-chugan"},{"id":"c-shiji-071-chugan:m014-0138","start":138,"end":140,"surface":"惠王","kind":"person","person_id":"q6q_ax8_y9p","status":"contextual_provisional","paragraph_id":"c-shiji-071-chugan:p014","chapter_id":"c-shiji-071-chugan"}],"relations":[{"id":"a-shiji071-001","subject_person_id":"fae_ax5_a6k","predicate":"brother","object_person_id":"q6q_ax8_y9p","status":"source_attested","evidence":[{"chapter_id":"c-shiji-071-chugan","source_id":"s-shiji-071-chugan","paragraph_id":"c-shiji-071-chugan:p001","quote":"樗里子者，名疾，秦惠王之弟也，與惠王異母。母，韓女也。樗里子滑稽多智，秦人號曰「智囊」。"}],"qualifiers":{"source_term":"秦惠王之弟也，與惠王異母","historicity":"historical_tradition"},"interpretation_note":"只取明示兄弟、母與孫，異母不補同母、兄弟不補父親、孫不補闕代。曾參故事中的同名殺人者分存，不把誣傳當孝子殺人事實；燕王使太子不單據此補父子。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji071-002","person_id":"q6q_ax8_y9p","surfaces":["先王","惠王","王","秦惠王"],"scope":"same_chapter","chapter_ids":["c-shiji-071-chugan"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-071-chugan:p001","quote":"樗里子者，名疾，秦惠王之弟也，與惠王異母。母，韓女也。樗里子滑稽多智，秦人號曰「智囊」。"},{"paragraph_id":"c-shiji-071-chugan:p002","quote":"秦惠王八年，爵樗里子右更，使將而伐曲沃，盡出其人，取其城，地入秦。秦惠王二十五年，使樗里子為將伐趙，虜趙將軍莊豹，拔藺。明年，助魏章攻楚，敗楚將屈丐，取漢中地。秦封樗里子，號為嚴君。"},{"paragraph_id":"c-shiji-071-chugan:p003","quote":"秦惠王卒，太子武王立，逐張儀、魏章，而以樗里子、甘茂為左右丞相。秦使甘茂攻韓，拔宜陽。使樗里子以車百乘入周。周以卒迎之，意甚敬。楚王怒，讓周，以其重秦客。游騰為周說楚王曰：「知伯之伐仇猶，遺之廣車，因隨之以兵，仇猶遂亡。何則？無備故也。齊桓公伐蔡，號曰誅楚，其實襲蔡。今秦，虎狼之國，使樗里子以車百乘入周，周以仇猶、蔡觀焉，故使長戟居前，彊弩在後，名曰衛疾，而實囚之。且夫周豈能無憂其社稷哉？恐一旦亡國以憂大王。」楚王乃悅。"},{"paragraph_id":"c-shiji-071-chugan:p007","quote":"甘茂者，下蔡人也。事下蔡史舉先生，學百家之說。因張儀、樗里子而求見秦惠王。王見而說之，使將，而佐魏章略定漢中地。"},{"paragraph_id":"c-shiji-071-chugan:p008","quote":"惠王卒，武王立。張儀、魏章去，東之魏。蜀侯煇、相壯反，秦使甘茂定蜀。還，而以甘茂為左丞相，以樗里子為右丞相。"},{"paragraph_id":"c-shiji-071-chugan:p009","quote":"秦武王三年，謂甘茂曰：「寡人欲容車通三川，以窺周室，而寡人死不朽矣。」甘茂曰：「請之魏，約以伐韓，而令向壽輔行。」甘茂至，謂向壽曰：「子歸，言之於王曰『魏聽臣矣，然願王勿伐』。事成，盡以為子功。」向壽歸，以告王，王迎甘茂於息壤。甘茂至，王問其故。對曰：「宜陽，大縣也，上黨、南陽積之久矣。名曰縣，其實郡也。今王倍數險，行千里攻之，難。昔曾參之處費，魯人有與曾參同姓名者殺人，人告其母曰『曾參殺人』，其母織自若也。頃之，一人又告之曰『曾參殺人』，其母尚織自若也。頃又一人告之曰『曾參殺人』，其母投杼下機，踰墻而走。夫以曾參之賢與其母信之也，三人疑之，其母懼焉。今臣之賢不若曾參，王之信臣又不如曾參之母信曾參也，疑臣者非特三人，臣恐大王之投杼也。始張儀西并巴蜀之地，北開西河之外，南取上庸，天下不以多張子而以賢先王。魏文侯令樂羊將而攻中山，三年而拔之。樂羊返而論功，文侯示之謗書一篋。樂羊再拜稽首曰：『此非臣之功也，主君之力也。』今臣，羈旅之臣也。樗里子、公孫奭二人者挾韓而議之，王必聽之，是王欺魏王而臣受公仲侈之怨也。」王曰：「寡人不聽也，請與子盟。」卒使丞相甘茂將兵伐宜陽。五月而不拔，樗里子、公孫奭果爭之。武王召甘茂，欲罷兵。甘茂曰：「息壤在彼。」王曰：「有之。」因大悉起兵，使甘茂擊之。斬首六萬，遂拔宜陽。韓襄王使公仲侈入謝，與秦平。"},{"paragraph_id":"c-shiji-071-chugan:p014","quote":"齊使甘茂於楚，楚懷王新與秦合婚而驩。而秦聞甘茂在楚，使人謂楚王曰：「願送甘茂於秦。」楚王問於范蜎曰：「寡人欲置相於秦，孰可？」對曰：「臣不足以識之。」楚王曰：「寡人欲相甘茂，可乎？」對曰：「不可。夫史舉，下蔡之監門也，大不為事君，小不為家室，以茍賤不廉聞於世，甘茂事之順焉。故惠王之明，武王之察，張儀之辯，而甘茂事之，取十官而無罪。茂誠賢者也，然不可相於秦。夫秦之有賢相，非楚國之利也。且王前嘗用召滑於越，而內行章義之難，越國亂，故楚南塞厲門而郡江東。計王之功所以能如此者，越國亂而楚治也。今王知用諸越而忘用諸秦，臣以王為鉅過矣。然則王若欲置相於秦，則莫若向壽者可。夫向壽之於秦王，親也，少與之同衣，長與之同車，以聽事。王必相向壽於秦，則楚國之利也。」於是使使請秦相向壽於秦。秦卒相向壽。而甘茂竟不得復入秦，卒於魏。"}],"rationale":"依前6段明示名字與局部敘事暫接，樗里子名疾與智囊嚴君明示相配。樗裏只取末句人物比擬，不取陰鄉地名；預言天子不補漢代皇帝。惠王、武王、昭王依卒立分辨；未名韓女、蒲守與衛君不補姓名，異母不補惠王母。游騰引古知伯齊桓公不當同期在場者。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-071-chugan:p001","text":"樗里子者，名疾，秦惠王之弟也，與惠王異母。母，韓女也。樗里子滑稽多智，秦人號曰「智囊」。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-071-chugan:m001-0000","start":0,"end":3,"surface":"樗里子","kind":"person","person_id":"fae_ax5_a6k","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m001-0006","start":6,"end":7,"surface":"疾","kind":"person","person_id":"fae_ax5_a6k","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m001-0008","start":8,"end":11,"surface":"秦惠王","kind":"person","person_id":"q6q_ax8_y9p","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m001-0016","start":16,"end":18,"surface":"惠王","kind":"person","person_id":"q6q_ax8_y9p","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m001-0021","start":21,"end":22,"surface":"母","kind":"person","person_id":"n9g_om6_3cj","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m001-0023","start":23,"end":25,"surface":"韓女","kind":"person","person_id":"n9g_om6_3cj","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m001-0027","start":27,"end":30,"surface":"樗里子","kind":"person","person_id":"fae_ax5_a6k","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m001-0035","start":35,"end":37,"surface":"秦人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、國稱、未名者或預言中的未定指代，不補人物及成員。"},{"id":"c-shiji-071-chugan:m001-0040","start":40,"end":42,"surface":"智囊","kind":"person","person_id":"fae_ax5_a6k","status":"contextual_provisional"}],"chapter_id":"c-shiji-071-chugan","book_id":"b-shiji-071","work_id":"w-shiji","source_id":"s-shiji-071-chugan"},{"id":"c-shiji-071-chugan:p002","text":"秦惠王八年，爵樗里子右更，使將而伐曲沃，盡出其人，取其城，地入秦。秦惠王二十五年，使樗里子為將伐趙，虜趙將軍莊豹，拔藺。明年，助魏章攻楚，敗楚將屈丐，取漢中地。秦封樗里子，號為嚴君。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-071-chugan:m002-0000","start":0,"end":3,"surface":"秦惠王","kind":"person","person_id":"q6q_ax8_y9p","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m002-0007","start":7,"end":10,"surface":"樗里子","kind":"person","person_id":"fae_ax5_a6k","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m002-0033","start":33,"end":36,"surface":"秦惠王","kind":"person","person_id":"q6q_ax8_y9p","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m002-0042","start":42,"end":45,"surface":"樗里子","kind":"person","person_id":"fae_ax5_a6k","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m002-0051","start":51,"end":56,"surface":"趙將軍莊豹","kind":"person","person_id":"yg1_ml2_61c","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m002-0064","start":64,"end":66,"surface":"魏章","kind":"person","person_id":"m1q_tly_ucl","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m002-0070","start":70,"end":74,"surface":"楚將屈丐","kind":"person","person_id":"mrk_rv8_zvi","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m002-0082","start":82,"end":85,"surface":"樗里子","kind":"person","person_id":"fae_ax5_a6k","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m002-0088","start":88,"end":90,"surface":"嚴君","kind":"person","person_id":"fae_ax5_a6k","status":"contextual_provisional"}],"chapter_id":"c-shiji-071-chugan","book_id":"b-shiji-071","work_id":"w-shiji","source_id":"s-shiji-071-chugan"},{"id":"c-shiji-071-chugan:p003","text":"秦惠王卒，太子武王立，逐張儀、魏章，而以樗里子、甘茂為左右丞相。秦使甘茂攻韓，拔宜陽。使樗里子以車百乘入周。周以卒迎之，意甚敬。楚王怒，讓周，以其重秦客。游騰為周說楚王曰：「知伯之伐仇猶，遺之廣車，因隨之以兵，仇猶遂亡。何則？無備故也。齊桓公伐蔡，號曰誅楚，其實襲蔡。今秦，虎狼之國，使樗里子以車百乘入周，周以仇猶、蔡觀焉，故使長戟居前，彊弩在後，名曰衛疾，而實囚之。且夫周豈能無憂其社稷哉？恐一旦亡國以憂大王。」楚王乃悅。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-071-chugan:m003-0000","start":0,"end":3,"surface":"秦惠王","kind":"person","person_id":"q6q_ax8_y9p","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m003-0005","start":5,"end":9,"surface":"太子武王","kind":"person","person_id":"oaj_udd_7d9","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m003-0012","start":12,"end":14,"surface":"張儀","kind":"person","person_id":"0tj_vst_yao","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m003-0015","start":15,"end":17,"surface":"魏章","kind":"person","person_id":"m1q_tly_ucl","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m003-0020","start":20,"end":23,"surface":"樗里子","kind":"person","person_id":"fae_ax5_a6k","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m003-0024","start":24,"end":26,"surface":"甘茂","kind":"person","person_id":"xcr_p13_j7x","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m003-0034","start":34,"end":36,"surface":"甘茂","kind":"person","person_id":"xcr_p13_j7x","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m003-0044","start":44,"end":47,"surface":"樗里子","kind":"person","person_id":"fae_ax5_a6k","status":"contextu