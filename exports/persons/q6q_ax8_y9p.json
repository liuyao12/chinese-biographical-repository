chugan:m007-0027","start":27,"end":30,"surface":"樗里子","kind":"person","person_id":"fae_ax5_a6k","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m007-0033","start":33,"end":36,"surface":"秦惠王","kind":"person","person_id":"q6q_ax8_y9p","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m007-0037","start":37,"end":38,"surface":"王","kind":"person","person_id":"q6q_ax8_y9p","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m007-0048","start":48,"end":50,"surface":"魏章","kind":"person","person_id":"m1q_tly_ucl","status":"contextual_provisional"}],"chapter_id":"c-shiji-071-chugan","book_id":"b-shiji-071","work_id":"w-shiji","source_id":"s-shiji-071-chugan"},{"id":"c-shiji-071-chugan:p008","text":"惠王卒，武王立。張儀、魏章去，東之魏。蜀侯煇、相壯反，秦使甘茂定蜀。還，而以甘茂為左丞相，以樗里子為右丞相。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-071-chugan:m008-0000","start":0,"end":2,"surface":"惠王","kind":"person","person_id":"q6q_ax8_y9p","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m008-0004","start":4,"end":6,"surface":"武王","kind":"person","person_id":"oaj_udd_7d9","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m008-0008","start":8,"end":10,"surface":"張儀","kind":"person","person_id":"0tj_vst_yao","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m008-0011","start":11,"end":13,"surface":"魏章","kind":"person","person_id":"m1q_tly_ucl","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m008-0019","start":19,"end":22,"surface":"蜀侯煇","kind":"person","person_id":"5iu_ut5_0yv","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m008-0023","start":23,"end":25,"surface":"相壯","kind":"person","person_id":"9ae_9vp_6fz","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m008-0029","start":29,"end":31,"surface":"甘茂","kind":"person","person_id":"xcr_p13_j7x","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m008-0038","start":38,"end":40,"surface":"甘茂","kind":"person","person_id":"xcr_p13_j7x","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m008-0046","start":46,"end":49,"surface":"樗里子","kind":"person","person_id":"fae_ax5_a6k","status":"contextual_provisional"}],"chapter_id":"c-shiji-071-chugan","book_id":"b-shiji-071","work_id":"w-shiji","source_id":"s-shiji-071-chugan"},{"id":"c-shiji-071-chugan:p009","text":"秦武王三年，謂甘茂曰：「寡人欲容車通三川，以窺周室，而寡人死不朽矣。」甘茂曰：「請之魏，約以伐韓，而令向壽輔行。」甘茂至，謂向壽曰：「子歸，言之於王曰『魏聽臣矣，然願王勿伐』。事成，盡以為子功。」向壽歸，以告王，王迎甘茂於息壤。甘茂至，王問其故。對曰：「宜陽，大縣也，上黨、南陽積之久矣。名曰縣，其實郡也。今王倍數險，行千里攻之，難。昔曾參之處費，魯人有與曾參同姓名者殺人，人告其母曰『曾參殺人』，其母織自若也。頃之，一人又告之曰『曾參殺人』，其母尚織自若也。頃又一人告之曰『曾參殺人』，其母投杼下機，踰墻而走。夫以曾參之賢與其母信之也，三人疑之，其母懼焉。今臣之賢不若曾參，王之信臣又不如曾參之母信曾參也，疑臣者非特三人，臣恐大王之投杼也。始張儀西并巴蜀之地，北開西河之外，南取上庸，天下不以多張子而以賢先王。魏文侯令樂羊將而攻中山，三年而拔之。樂羊返而論功，文侯示之謗書一篋。樂羊再拜稽首曰：『此非臣之功也，主君之力也。』今臣，羈旅之臣也。樗里子、公孫奭二人者挾韓而議之，王必聽之，是王欺魏王而臣受公仲侈之怨也。」王曰：「寡人不聽也，請與子盟。」卒使丞相甘茂將兵伐宜陽。五月而不拔，樗里子、公孫奭果爭之。武王召甘茂，欲罷兵。甘茂曰：「息壤在彼。」王曰：「有之。」因大悉起兵，使甘茂擊之。斬首六萬，遂拔宜陽。韓襄王使公仲侈入謝，與秦平。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-071-chugan:m009-0000","start":0,"end":3,"surface":"秦武王","kind":"person","person_id":"oaj_udd_7d9","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m009-0007","start":7,"end":9,"surface":"甘茂","kind":"person","person_id":"xcr_p13_j7x","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m009-0035","start":35,"end":37,"surface":"甘茂","kind":"person","person_id":"xcr_p13_j7x","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m009-0051","start":51,"end":53,"surface":"向壽","kind":"person","person_id":"rx6_krw_dmb","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m009-0057","start":57,"end":59,"surface":"甘茂","kind":"person","person_id":"xcr_p13_j7x","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m009-0062","start":62,"end":64,"surface":"向壽","kind":"person","person_id":"rx6_krw_dmb","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m009-0073","start":73,"end":74,"surface":"王","kind