holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji034-100","person_id":"eyc_8y6_02q","surfaces":["郭隗","隗"],"scope":"same_chapter","chapter_ids":["c-shiji-034-yan"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-034-yan:p024","quote":"燕昭王於破燕之後卽位，卑身厚幣以招賢者。謂郭隗曰：「齊因孤之國亂而襲破燕，孤極知燕小力少，不足以報。然誠得賢士以共國，以雪先王之恥，孤之願也。先生視可者，得身事之。」郭隗曰：「王必欲致士，先從隗始。況賢於隗者，豈遠千里哉！」於是昭王爲隗改筑宮而師事之。樂毅自魏往，鄒衍自齊往，劇辛自趙往，士爭趨燕。燕王噲死問孤，與百姓同甘苦。"}],"rationale":"依周初封建、燕君世系、割地救燕、讓國及秦滅諸國的具體語境暫定異稱。繼位不自動證父子；同爵者分國別與前後世代。太子平／燕昭王依本篇明示，不表示年代及世系已校定。作君奭為書名，君奭不説之君奭才暫解召公稱呼。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji080-007","person_id":"py3_55c_1ad","surfaces":["郭隗"],"scope":"same_chapter","chapter_ids":["c-shiji-080-leyi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-080-leyi:p002","quote":"樂毅賢，好兵，趙人舉之。及武靈王有沙丘之亂，乃去趙適魏。聞燕昭王以子之之亂而齊大敗燕，燕昭王怨齊，未嘗一日而忘報齊也。燕國小，辟遠，力不能制，於是屈身下士，先禮郭隗以招賢者。樂毅於是為魏昭王使於燕，燕王以客禮待之。樂毅辭讓，遂委質為臣，燕昭王以為亞卿，久之。"}],"rationale":"樂閒明示為樂毅子，樂叔明示為孫，不補闕代父親；樂乘為樂閒宗不補兄弟。燕王喜來書及趙襄王君序各限本段，曹相國未見名字不回填。河上丈人至蓋公師承不作父子。依本篇明示姓名、君序與來書答書範圍暫接；燕惠王來書寡人指惠王、將軍指樂毅，樂毅答書先王指昭王、足下君王指惠王。伍子胥引古首吳王指闔閭，後吳王在夫差賜鴟夷後指夫差。父兄與群臣不補具體親屬，王齊為反間假說不作授王爵。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji080-guo","person_ids":["eyc_8y6_02q","py3_55c_1ad"],"canonical_person_id":"eyc_8y6_02q","scope":"cross_chapter","chapter_ids":["c-shiji-034-yan","c-shiji-080-leyi"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-034-yan","source_id":"s-shiji-034-yan","paragraph_id":"c-shiji-034-yan:p024","quote":"燕昭王於破燕之後卽位，卑身厚幣以招賢者。謂郭隗曰：「齊因孤之國亂而襲破燕，孤極知燕小力少，不足以報。然誠得賢士以共國，以雪先王之恥，孤之願也。先生視可者，得身事之。」郭隗曰：「王必欲致士，先從隗始。況賢於隗者，豈遠千里哉！」於是昭王爲隗改筑宮而師事之。樂毅自魏往，鄒衍自齊往，劇辛自趙往，士爭趨燕。燕王噲死問孤，與百姓同甘苦。","mention_ids":["c-shiji-034-yan:m024-0021","c-shiji-034-yan:m024-0083","c-shiji-034-yan:m024-0096","c-shiji-034-yan:m024-0102","c-shiji-034-yan:m024-0117"]},{"chapter_id":"c-shiji-080-leyi","source_id":"s-shiji-080-leyi","paragraph_id":"c-shiji-080-leyi:p002","quote":"樂毅賢，好兵，趙人舉之。及武靈王有沙丘之亂，乃去趙適魏。聞燕昭王以子之之亂而齊大敗燕，燕昭王怨齊，未嘗一日而忘報齊也。燕國小，辟遠，力不能制，於是屈身下士，先禮郭隗以招賢者。樂毅於是為魏昭王使於燕，燕王以客禮待之。樂毅辭讓，遂委質為臣，燕昭王以為亞卿，久之。","mention_ids":["c-shiji-080-leyi:m002-0080"]}],"rationale":"兩篇郭隗為燕昭王先禮招賢者且樂毅自魏入燕，姓名、所事王及同一招賢事件支持同指。 各篇原字、原文與已發ID保留，同書不視為獨立見證；同指不確證所有紀年、任職、親屬或敘事，不按全域同名批量改號。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-034-yan:p024","text":"燕昭王於破燕之後卽位，卑身厚幣以招賢者。謂郭隗曰：「齊因孤之國亂而襲破燕，孤極知燕小力少，不足以報。然誠得賢士以共國，以雪先王之恥，孤之願也。先生視可者，得身事之。」郭隗曰：「王必欲致士，先從隗始。況賢於隗者，豈遠千里哉！」於是昭王爲隗改筑宮而師事之。樂毅自魏往，鄒衍自齊往，劇辛自趙往，士爭趨燕。燕王噲死問孤，與百姓同甘苦。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-034-yan:m024-0000","start":0,"end":3,"surface":"燕昭王","kind":"person","person_id":"5pw_05i_uhv","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m024-0017","start":17,"end":19,"surface":"賢者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、未定稱呼、書名或數位疑讀；不補姓名、性別與成員。"},{"id":"c-shiji-034-yan:m024-0021","start":21,"end":23,"surface":"郭隗","kind":"person","person_id":"eyc_8y6_02q","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m024-0053","start":53,"end":55,"surface":"賢士","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、未定稱呼、書名或數位疑讀；不補姓名、性別與成員。"},{"id":"c-shiji-034-yan:m024-0061","start":61,"end":63,"surface":"先王","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、未定稱呼、書名或數位疑讀；不補姓名、性別與成員。"},{"id":"c-shiji-034-yan:m024-0071","start":71,"end":73,"surface":"先生","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、未定稱呼、書名或數位疑讀；不補姓名、性別與成員。"},{"id":"c-shiji-034-yan:m024-0083","start":83,"end":85,"surface":"郭隗","kind":"person","person_id":"eyc_8y6_02q","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m024-0092","start":92,"end":93,"surface":"士","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、未定稱呼、書名或數位疑讀；不補姓名、性別與成員。"},{