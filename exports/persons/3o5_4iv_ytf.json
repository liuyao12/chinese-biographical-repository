_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-016-duji-dushu:unit006","text_layer":"witness_appended_pei_songzhi_note","text":"魏略曰畿少有大志在荆州數嵗繼母亡後以三輔開通負其母喪北歸道為賊所劫略衆人奔走畿獨不去賊射之畿請賊曰卿欲得財耳今我無物用射我何為耶賊乃止畿到鄉里京兆尹張時河東人也與畿有舊署為功曹嘗嫌其闊達不助留意於諸事言此家疏誕不中功曹也畿竊云不中功曹中河東太守也","source_position":{"source_layer":"pei_annotation","first_line":99,"last_line":102,"raw_projection_ref":"source-evidence/sgz016-duji-dushu/fixed-complete-unit.json"},"mentions":[{"id":"c-sanguozhi-016-duji-dushu:unit006:w0000","start":0,"end":2,"surface":"魏略","kind":"work","person_id":null,"work_id":"w-weilue-sgz028-reference","status":"source_explicit"},{"id":"c-sanguozhi-016-duji-dushu:unit006:m0003","start":3,"end":4,"surface":"畿","kind":"person","person_id":"56f_8f7_e9f","status":"contextual_provisional","interpretation_note":"本傳伯侯、京兆杜陵及河東太守/尚書僕射，與已存荀彧薦畿、034祖畿魏尚書僕射同一近系；不把遠祖杜延年報告當已考證家系。"},{"id":"c-sanguozhi-016-duji-dushu:unit006:m0013","start":13,"end":15,"surface":"繼母","kind":"person","person_id":"thu_bi0_j4b","status":"contextual_provisional","interpretation_note":"本傳少孤繼母苦之與魏略繼母亡/負其母喪同一杜畿孝行脈絡；只特定繼母來源身份，不冒生母或補姓名。"},{"id":"c-sanguozhi-016-duji-dushu:unit006:m0023","start":23,"end":25,"surface":"其母","kind":"person","person_id":"thu_bi0_j4b","status":"contextual_provisional","interpretation_note":"本傳少孤繼母苦之與魏略繼母亡/負其母喪同一杜畿孝行脈絡；只特定繼母來源身份，不冒生母或補姓名。"},{"id":"c-sanguozhi-016-duji-dushu:unit006:m0030","start":30,"end":31,"surface":"賊","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"未名劫掠者/群體，未作歷史具名人，不按最近人名配。"},{"id":"c-sanguozhi-016-duji-dushu:unit006:m0038","start":38,"end":39,"surface":"畿","kind":"person","person_id":"56f_8f7_e9f","status":"contextual_provisional","interpretation_note":"本傳伯侯、京兆杜陵及河東太守/尚書僕射，與已存荀彧薦畿、034祖畿魏尚書僕射同一近系；不把遠祖杜延年報告當已考證家系。"},{"id":"c-sanguozhi-016-duji-dushu:unit006:m0042","start":42,"end":43,"surface":"賊","kind":"unresolve