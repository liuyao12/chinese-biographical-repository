798","status":"source_attested","evidence":[{"chapter_id":"c-shiji-065-sun","source_id":"s-shiji-065-sun","paragraph_id":"c-shiji-065-sun:p006","quote":"吳起者，衛人也，好用兵。嘗學於曾子，事魯君。齊人攻魯，魯欲將吳起，吳起取齊女為妻，而魯疑之。吳起於是欲就名，遂殺其妻，以明不與齊也。魯卒以為將。將而攻齊，大破之。"}],"qualifiers":{"source_term":"吳起取齊女為妻","historicity":"historical_tradition"},"interpretation_note":"依明示取妻、母、其子及故事局部父稱保存。孫武後世子孫只記祖先，不補直接父子；病卒家屬不接吳起親屬，公叔公主不接試延吳起公主。引語與來源故事保留範圍，不作獨立史實確證。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji065-026","person_id":"cbr-p003798","surfaces":["其妻","齊女"],"scope":"same_chapter","chapter_ids":["c-shiji-065-sun"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-065-sun:p006","quote":"吳起者，衛人也，好用兵。嘗學於曾子，事魯君。齊人攻魯，魯欲將吳起，吳起取齊女為妻，而魯疑之。吳起於是欲就名，遂殺其妻，以明不與齊也。魯卒以為將。將而攻齊，大破之。"}],"rationale":"依明示姓名、局部短稱及敘事範圍暫接；孫子在闔廬試兵指孫武，在孫臏龐涓敘事指臏。魏相田文不接孟嘗君，未名與公主指代保留待核，故事及史實確證分開，不補姓名或闕代。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-065-sun:p006","text":"吳起者，衛人也，好用兵。嘗學於曾子，事魯君。齊人攻魯，魯欲將吳起，吳起取齊女為妻，而魯疑之。吳起於是欲就名，遂殺其妻，以明不與齊也。魯卒以為將。將而攻齊，大破之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-065-sun:m006-0000","start":0,"end":2,"surface":"吳起","kind":"person","person_id":"cbr-p003782","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m006-0015","start":15,"end":17,"surface":"曾子","kind":"person","person_id":"cbr-p003783","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m006-0019","start":19,"end":21,"surface":"魯君","kind":"person","person_id":"cbr-p003784","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m006-0030","start":30,"end":32,"surface":"吳起","kind":"person","person_id":"cbr-p003782","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m006-0033","start":33,"end":35,"surface":"吳起","kind":"person","person_id":"cbr-p003782","status":"contextual_provisional"},{"id":"c-shiji-065-su