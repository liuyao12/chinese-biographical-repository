:[{"id":"c-shiji-096-zhang:m026-0146","start":146,"end":149,"surface":"于定國","kind":"person","person_id":"tks_56f_4ir","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p026","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m026-0151","start":151,"end":154,"surface":"于丞相","kind":"person","person_id":"tks_56f_4ir","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p026","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m026-0167","start":167,"end":170,"surface":"于丞相","kind":"person","person_id":"tks_56f_4ir","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p026","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m027-0065","start":65,"end":68,"surface":"于丞相","kind":"person","person_id":"tks_56f_4ir","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p027","chapter_id":"c-shiji-096-zhang"}],"relations":[],"title_holdings":[{"id":"th-shiji096-085","person_id":"tks_56f_4ir","title":"御史大夫","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-096-zhang","source_id":"s-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p026","quote":"黃丞相霸者，淮陽人也。以讀書為吏，至潁川太守。治潁川，以禮義條教喻告化之。犯法者，風曉令自殺。化大行，名聲聞。孝宣帝下制曰：「潁川太守霸，以宣布詔令治民，道不拾遺，男女異路，獄中無重囚。賜爵關內侯，黃金百斤。」徵為京兆尹而至丞相，復以禮義為治。以丞相病死。子嗣，後為列侯。黃丞相卒，以御史大夫于定國代。于丞相已有廷尉傳，在張廷尉語中。于丞相去，御史大夫韋玄成代。"}],"attestations":[{"id":"th-shiji096-085:a001","paragraph_id":"c-shiji-096-zhang:p026","start":142,"end":146,"surface":"御史大夫","person_mention_id":"c-shiji-096-zhang:m026-0146","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"原文實授、轉任、用稱與諡稱分存；未明示時任期起訖未知。欲任竇廣國及欲令周苛將皆不作實授；死亡或首次用稱不自動作任期端點。十四年、四年、二年等先保留原語，不擅定年號或西曆。曹窋免職段含（不）異文，未先強定其終點。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji096-086","person_id":"tks_56f_4ir","title":"丞相","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-096-zhang","source_id":"s-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p026","quote":"黃丞相霸者，淮陽人也。以讀書為吏，至潁川太守。治潁川，以禮義條教喻告化之。犯法者，風曉令自殺。化大行，名聲聞。孝宣帝下制曰：「潁川太守霸，以宣布詔令治民，道不拾遺，男女異路，獄中無重囚。賜爵關內侯，黃金百斤。」徵為京兆尹而至丞相，復以禮義為治。以丞相病死。子嗣，後為列侯。黃丞相卒，以御史大夫于定國代。于丞相已有廷尉傳，在張廷尉語中。于丞相去，御史大夫韋玄成代。"}],"attestations":[{"id":"th-shiji096-086:a001","paragraph_id":"c-shiji-096-zhang:p026","start":152,"end":154,"surface":"丞相","person_mention_id":"c-shiji-096-zhang:m026-0151","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"source_event","event_type":"explicit_end","date_expression":null,"evidence":[{"chapter_id":"c-shiji-096-zhang","source_id":"s-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p027","quote":"韋丞相玄成者，即前韋丞相子也。代父，後失列侯。其人少時好讀書，明於詩、論語。為吏至衛尉，徙為太子太傅。御史大夫薛君免，為御史大夫。于丞相乞骸骨免，而為丞相，因封故邑為扶陽侯。數年，病死。孝元帝親臨喪，賜賞甚厚。子嗣後。其治容容隨世俗浮沈，而見謂諂巧。而相工本謂之當為侯代父，而後失之；復自游宦而起，至丞相。父子俱為丞相，世閒美之，豈不命哉！相工其先知之。韋丞相卒，御史大夫匡衡代。"}]}},"interpretation_note":"原文實授、轉任、用稱與諡稱分存；未明示時任期起訖未知。欲任竇廣國及欲令周苛將皆不作實授；死亡或首次用稱不自動作任期端點。十四年、四年、二年等先保留原語，不擅定年號或西曆。曹窋免職段含（不）異文，未先強定其終點。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji096-068","person_id":"tks_56f_4ir","scope":"same_chapter","chapter_ids":["c-shiji-096-zhang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["于丞相","于定國"],"evidence":[{"paragraph_id":"c-shiji-096-zhang:p026","quote":"黃丞相霸者，淮陽人也。以讀書為吏，至潁川太守。治潁川，以禮義條教喻告化之。犯法者，風曉令自殺。化大行，名聲聞。孝宣帝下制曰：「潁川太守霸，以宣布詔令治民，道不拾遺，男女異路，獄中無重囚。賜爵關內侯，黃金百斤。」徵為京兆尹而至丞相，復以禮義為治。以丞相病死。子嗣，後為列侯。黃丞相卒，以御史大夫于定國代。于丞相已有廷尉傳，在張廷尉語中。于丞相去，御史大夫韋玄成代。"},{"paragraph_id":"c-shiji-096-zhang:p027","quote":"韋丞相玄成者，即前韋丞相子也。代父，後失列侯。其人少時好讀書，明於詩、論語。為吏至衛尉，徙為太子太傅。御史大夫薛君免，為御史大夫。于丞相乞骸骨免，而為丞相，因封故邑為扶陽侯。數年，病死。孝元帝親臨喪，賜賞甚厚。子嗣後。其治容容隨世俗浮沈，而見謂諂巧。而相工本謂之當為侯代父，而後失之；復自游宦而起，至丞相。父子俱為丞相，世閒美之，豈不命哉！相工其先知之。韋丞相卒，御史大夫匡衡代。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定短稱；韋賢與韋玄成分傳區別，第23段掾陳平另候選，第25段長安相工田文不與孟嘗君合併。趙堯、任敖、申屠嘉、鄧通、晁錯的短名依各段人物語境，王陵夫人與王陵分人。張蒼父長不滿五尺的長為身長敘述，不作父名。王侯與太子未詳名不補名，跨篇同指另待證據。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-096-zhang:p026","text":"黃丞相霸者，淮陽人也。以讀書為吏，至潁川太守。治潁川，以禮義條教喻告化之。犯法者，風曉令自殺。化大行，名聲聞。孝宣帝下制曰：「潁川太守霸，以宣布詔令治民，道不拾遺，男女異路，獄中無重囚。賜爵關內侯，黃金百斤。」徵為京兆尹而至丞相，復以禮義為治。以丞相病死。子嗣，後為列侯。黃丞相卒，以御史大夫于定國代。于丞相已有廷尉傳，在張廷尉語中。于丞相去，御史大夫韋玄成代。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhang:m026-0000","start":0,"end":4,"surface":"黃丞相霸","kind":"person","person_id":"kmo_vp5_qe1","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m026-0055","start":55,"end":58,"surface":"孝宣帝","kind":"person","person_id":"hmr_3oo_5m5","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m026-0063","start":63,"end":68,"surface":"潁川太守霸","kind":"person","person_id":"kmo_vp5_qe1","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m026-0136","start":136,"end":139,"surface":"黃丞相","kind":"person","person_id":"kmo_vp5_qe1","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m026-0146","start":146,"end":149,"surface":"于定國","kind":"person","person_id":"tks_56f_4ir","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m026-0151","start":151,"end":154,"surface":"于丞相","kind":"person","person_id":"tks_56f_4ir","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m026-0161","start":161,"end":164,"surface":"張廷尉","kind":"person","person_id":"wr1_5wr_sx5","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m026-0167","start":167,"end":170,"surface":"于丞相","kind":"person","person_id":"tks_56f_4ir","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m026-0176","start":176,"end":179,"surface":"韋玄成","kind":"person","person_id":"vna_am7_jn5_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-096-zhang","book_id":"b-shiji-096","work_id":"w-shiji","source_id":"s-shiji-096-zhang"},{"id":"c-shiji-096-zhang:p027","text":"韋丞相玄成者，即前韋丞相子也。代父，後失列侯。其人少時好讀書，明於詩、論語。為吏至衛尉，徙為太子太傅。御史大夫薛君免，為御史大夫。于丞相乞骸骨免，而為丞相，因封故邑為扶陽侯。數年，病死。孝元帝親臨喪，賜賞甚厚。子嗣後。其治容容隨世俗浮沈，而見謂諂巧。而相工本謂之當為侯代父，而後失之；復自游宦而起，至丞相。父子俱為丞相，世閒美之，豈不命哉！相工其先知之。韋丞相卒，御史大夫匡衡代。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhang:m027-0000","start":0,"end":5,"surface":"韋丞相玄成","kind":"person","person_id":"vna_am7_jn5_A","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m027-0055","start":55,"end":57,"surface":"薛君","kind":"person","person_id":"ik4_61m_hqn","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m027-0065","start":65,"end":68,"surface":"于丞相","kind":"person","person_id":"tks_56f_4ir","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m027-0093","start":93,"end":96,"surface":"孝元帝","kind":"person","person_id":"72m_dhb_tf7","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m027-0177","start":177,"end":180,"surface":"韋丞相","kind":"person","person_id":"vna_am7_jn5_A","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m027-0186","start":186,"end":188,"surface":"匡衡","kind":"person","person_id":"484_day_gmv","status":"contextual_provisional"}],"chapter_id":"c-shiji-096-zhang","book_id":"b-shiji-096","work_id":"w-shiji","source_id":"s-shiji-096-zhang"}],"sources":[{"chapter_id":"c-shiji-096-zhang","work_id":"w-shiji","book_id":"b-shiji-096","source_id":"s-shiji-096-zhang","source":{"title":"史記／卷096","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷096","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷096&oldid=8770206","revision_id":8770206,"accessed_on":"2026-10-09","extent":"29段傳世文字含兩處太史公論，另附1段分層索隱述贊；首HTML區塊即正文，不刪頭2段。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"固定HTML一致，只去外緣空白；亨周苛、（不）、困妯囡及邴丞相等原字保留。","note":"全30個HTML區塊已讀，未核底本影像。後段征和以後丞相記述在此見證未署補作者，不冒署褚