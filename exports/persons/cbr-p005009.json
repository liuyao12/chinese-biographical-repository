":"c-shiji-048-chenshe:m007-0101","start":101,"end":103,"surface":"張敖","kind":"person","person_id":"cbr-p002994","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m007-0115","start":115,"end":117,"surface":"趙王","kind":"person","person_id":"cbr-p002984","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m007-0125","start":125,"end":126,"surface":"王","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱、對話或未名者待核；普通動詞、詐稱與矯命不當真實人物身份。"},{"id":"c-shiji-048-chenshe:m007-0210","start":210,"end":212,"surface":"趙王","kind":"person","person_id":"cbr-p002984","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m007-0228","start":228,"end":230,"surface":"韓廣","kind":"person","person_id":"cbr-p002995","status":"contextual_provisional"}],"chapter_id":"c-shiji-048-chenshe","book_id":"b-shiji-048","work_id":"w-shiji","source_id":"s-shiji-048-chenshe"},{"id":"c-shiji-048-chenshe:p013","text":"章邯已破伍徐，擊陳，柱國房君死。章邯又進兵擊陳西張賀軍。陳王出監戰，軍破，張賀死。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-048-chenshe:m013-0000","start":0,"end":2,"surface":"章邯","kind":"person","person_id":"cbr-p002992","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m013-0004","start":4,"end":6,"surface":"伍徐","kind":"person","person_id":"cbr-p003000","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m013-0010","start":10,"end":14,"surface":"柱國房君","kind":"person","person_id":"cbr-p002964","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m013-0016","start":16,"end":18,"surface":"章邯","kind":"person","person_id":"cbr-p002992","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m013-0024","start":24,"end":26,"surface":"張賀","kind":"person","person_id":"cbr-p003005","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m013-0028","start":28,"end":30,"surface":"陳王","kind":"person","person_id":"cbr-p002979","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m013-0037","start":37,"end":39,"surface":"張賀","kind":"person","person_id":"cbr-p003005","status":"contextual_provisional"}],"chapter_id":"c-shiji-048-chenshe","book_id":"b-shiji-048","work_id":"w-shiji","source_id":"s-shiji-048-chenshe"},{"id":"c-shiji-089-zhanger:p011","text":"使人報陳王，陳王大怒，欲盡族武臣等家，而發兵撃趙。陳王相國房君諫曰：「秦未亡而誅武臣等家，此又生一秦也。不如因而賀之，使急引兵西撃秦。」陳王然之，從其計，徙系武臣等家宮中，封張耳子敖爲成都君。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-089-zhanger:m011-0003","start":3,"end":5,"surface":"陳王","kind":"person","person_id":"cbr-p004990","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m011-0006","start":6,"end":8,"surface":"陳王","kind":"person","person_id":"cbr-p004990","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m011-0014","start":14,"end":16,"surface":"武臣","kind":"person","person_id":"cbr-p004981","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m011-0025","start":25,"end":27,"surface":"陳王","kind":"person","person_id":"cbr-p004990","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m011-0029","start":29,"end":31,"surface":"房君","kind":"person","person_id":"cbr-p005009","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m011-0040","start":40,"end":42,"surface":"武臣","kind":"person","person_id":"cbr-p004981","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m011-0068","start":68,"end":70,"surface":"陳王","kind":"person","person_id":"cbr-p004990","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m011-0079","start":79,"end":81,"surface":"武臣","kind":"person","person_id":"cbr-p004981","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m011-0087","start":87,"end":91,"surface":"張耳子敖","kind":"person","person_id":"cbr-p004997","status":"contextual_provisional"}],"chapter_id":"c-shiji-089-zhanger","book_id":"b-shiji-089","work_id":"w-shiji","source_id":"s-shiji-089-zhanger"}],"sources":[{"chapter_id":"c-shiji-048-chenshe","work_id":"w-shiji","b