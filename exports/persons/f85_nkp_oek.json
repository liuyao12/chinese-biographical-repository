058-zhou-fang:p003:m0418","surface":"訪","start":418,"end":419,"person_id":"c6b_s71_vt7","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-fang:p003:m0459","surface":"訪","start":459,"end":460,"person_id":"c6b_s71_vt7","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-fang:p003:m0465","surface":"王敦","start":465,"end":467,"person_id":"39o_b6y_n74","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-058-zhou-fang","book_id":"b-jinshu-058","work_id":"w-jinshu","source_id":"s-jinshu-058-zhou-fang-ws1775463"},{"id":"c-jinshu-066-taokan:p010","text":"先是，廣州人背刺史郭訥，迎長沙人王機為刺史。機復遣使詣王敦，乞為交州。敦從之，而機未發。會杜弘據臨賀，因機乞降，勸弘取廣州，弘遂與溫邵及交州秀才劉沈俱謀反。或勸侃且住始興，觀察形勢。侃不聽，直至廣州。弘遣使偽降。侃知其詐，先於封口起發石車。俄而弘率輕兵而至，知侃有備，乃退。侃追擊破之，執劉沈于小桂。又遣部將許高討機，斬之，傳首京都。諸將皆請乘勝擊溫邵，侃笑曰：「吾威名已著，何事遣兵，但一函紙自足耳。」於是下書諭之。邵懼而走，追獲於始興。以功封柴桑侯，食邑四千戶。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":47,"last_line":47,"raw_start":5564,"raw_end":5799,"raw_character_offsets":[5566,5567,5568,5569,5570,5571,5572,5573,5574,5575,5576,5577,5578,5579,5580,5581,5582,5583,5584,5585,5586,5587,5588,5589,5590,5591,5592,5593,5594,5595,5596,5597,5598,5599,5600,5601,5602,5603,5604,5605,5606,5607,5608,5609,5610,5611,5612,5613,5614,5615,5616,5617,5618,5619,5620,5621,5622,5623,5624,5625,5626,5627,5628,5629,5630,5631,5632,5633,5634,5635,5636,5637,5638,5639,5640,5641,5642,5643,5644,5645,5646,5647,5648,5649,5650,5651,5652,5653,5654,5655,5656,5657,5658,5659,5660,5661,5662,5663,5664,5665,5666,5667,5668,5669,5670,5671,5672,5673,5674,5675,5676,5677,5678,5679,5680,5681,5682,5683,5684,5685,5686,5687,5688,5689,5690,5691,5692,5693,5694,5695,5696,5697,5698,5699,5700,5701,5702,5703,5704,5705,5706,5707,5708,5709,5710,5711,5712,5713,5714,5715,5716,5717,5718,5719,5720,5721,5722,5723,5724,5725,5726,5727,5728,5729,5730,5731,5732,5733,5734,5735,5736,5737,5738,5739,5740,5741,5742,5743,5744,5745,5746,5747,5748,5749,5750,5751,5752,5753,5754,5755,5756,5757,5758,5759,5760,5761,5762,5763,5764,5765,5766,5767,5768,5769,5770,5771,5772,5773,5774,5775,5776,5777,5778,5779,5780,5781,5782,5783,5784,5785,5786,5787,5788,5789,5790,5791,5792,5793,5794,5795,5796,5797,5798],"revision_id":1527632},"mentions":[{"id":"c-jinshu-066-taokan:p010:m0009","surface":"郭訥","start":9,"end":11,"person_id":"bb6_2wx_oge","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p010:m0016","surface":"王機","start":16,"end":18,"person_id":"me9_tr4_2tr","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p010:m0027","surface":"王敦","start":27,"end":29,"person_id":"39o_b6y_n74","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p010:m0045","surface":"杜弘","start":45,"end":47,"person_id":"f85_nkp_oek","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p010:m0065","surface":"溫邵","start":65,"end":67,"person_id":"qc6_99b_nob","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p010:m0072","surface":"劉沈","start":72,"end":74,"person_id":"mm0_tat_kio","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p010:m0091","surface":"侃","start":91,"end":92,"person_id":"twd_erg_kmz","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p010:m0144","surface":"劉沈","start":144,"end":146,"person_id":"mm0_tat_kio","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p010:m0154","surface":"許高","start":154,"end":156,"person_id":"iou_2ho_3wf","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p010:m0174","surface":"溫邵","start":174,"end":176,"person_id":"qc6_99b_nob","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-066-taokan","book_id":"b-jinshu-066","work_id":"w-jinshu","source_id":"s-jinshu-066-taokan-ws1527632"},{"id":"c-jinshu-098-jin033-wangji:line015","text":"蜀賊杜弢作亂，荊州刺史周顗退走，敦遣武昌太守陶侃、豫章太守周訪等討韜，而敦進住豫章，為諸軍繼援。及侃破弢，敦上侃為荊州刺史。既而侃為弢將杜曾所敗，敦以處分失所，自貶為廣武將軍，帝不許。侃之滅弢也，敦以元帥進鎮東大將軍、開府儀同三司，加都督江揚荊湘交廣六州諸軍事、江州刺史，封漢安侯。敦始自選置，兼統州郡焉。頃之，杜弢將杜弘南走廣州，求討桂林賊自效，敦許之。陶侃距弘不得進，乃詣零陵太守尹奉降，奉送弘與敦，敦以為將，遂見寵待。南康人何欽所居險固，聚黨數千人，敦就加四品將軍，於是專擅之跡漸彰矣。","annotation_status":"reviewed","text_layer":"received_chapter","mentions":[{"id":"c-jinshu-098-jin033-wangji:line015:m0002","start":2,"end":4,"surface":"杜弢","kind":"person","person_id":"7dv_udy_955","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line015:m0011","start":11,"end":13,"surface":"周顗","kind":"person","person_id":"3xx_gdy_or6_AAA","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line015:m0016","start":16,"end":17,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line015:m0022","start":22,"end":24,"surface":"陶侃","kind":"person","person_id":"twd_erg_kmz","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line015:m0029","start":29,"end":31,"surface":"周訪","kind":"person","person_id":"c6b_s71_vt7","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line015:m0033","start":33,"end":34,"surface":"韜","kind":"person","person_id":"7dv_udy_955","status":"contextual_provisional","interpretation_note":"讀本段前後及對話，所指按此處記。"},{"id":"c-jinshu-098-jin033-wangji:line015:m0036","start":36,"end":37,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line015:m0049","start":49,"end":50,"surface":"侃","kind":"person","person_id":"twd_erg_kmz","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line015:m0051","start":51,"end":52,"surface":"弢","kind":"person","person_id":"7dv_udy_955","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id