amily_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-098-jin033-wangji:line015:m0159","start":159,"end":161,"surface":"杜弘","kind":"person","person_id":"f85_nkp_oek","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line015","chapter_id":"c-jinshu-098-jin033-wangji"},{"id":"c-jinshu-098-jin033-wangji:line015:m0181","start":181,"end":182,"surface":"弘","kind":"person","person_id":"f85_nkp_oek","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line015","chapter_id":"c-jinshu-098-jin033-wangji"},{"id":"c-jinshu-098-jin033-wangji:line015:m0198","start":198,"end":199,"surface":"弘","kind":"person","person_id":"f85_nkp_oek","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line015","chapter_id":"c-jinshu-098-jin033-wangji"},{"id":"c-jinshu-098-jin033-wangji:line045:m0012","start":12,"end":14,"surface":"杜弘","kind":"person","person_id":"f85_nkp_oek","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line045","chapter_id":"c-jinshu-098-jin033-wangji"},{"id":"c-jinshu-098-jin033-wangji:line045:m0069","start":69,"end":70,"surface":"弘","kind":"person","person_id":"f85_nkp_oek","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line045","chapter_id":"c-jinshu-098-jin033-wangji"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-098-jin033-wangji:line015","text":"蜀賊杜弢作亂，荊州刺史周顗退走，敦遣武昌太守陶侃、豫章太守周訪等討韜，而敦進住豫章，為諸軍繼援。及侃破弢，敦上侃為荊州刺史。既而侃為弢將杜曾所敗，敦以處分失所，自貶為廣武將軍，帝不許。侃之滅弢也，敦以元帥進鎮東大將軍、開府儀同三司，加都督江揚荊湘交廣六州諸軍事、江州刺史，封漢安侯。敦始自選置，兼統州郡焉。頃之，杜弢將杜弘南走廣州，求討桂林賊自效，敦許之。陶侃距弘不得進，乃詣零陵太守尹奉降，奉送弘與敦，敦以為將，遂見寵待。南康人何欽所居險固，聚黨數千人，敦就加四品將軍，於是專擅之跡漸彰矣。","annotation_status":"reviewed","text_layer":"received_chapter","mentions":[{"id":"c-jinshu-098-jin033-wangji:line015:m0002","start":2,"end":4,"surface":"杜弢","kind":"person","person_id":"7dv_udy_955","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line015:m0011","start":11,"end":13,"surface":"周顗","kind":"person","person_id":"3xx_gdy_or6_AAA","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line015:m0016","start":16,"end":17,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line015:m0022","start":22,"end":24,"surface":"陶侃","kind":"person","person_id":"twd_erg_kmz","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line015:m0029","start":29,"end":31,"surface":"周訪","kind":"person","person_id":"c6b_s71_vt7","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line015:m0033","start":33,"end":34,"surface":"韜","kind":"person","person_id":"7dv_udy_955","status":"contextual_provisional","interpretation_note":"讀本段前後及對話，所指按此處記。"},{"id":"c-jinshu-098-jin033-wangji:line015:m0036","start":36,"end":37,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line015:m0049","start":49,"end":50,"surface":"侃","kind":"person","person_id":"twd_erg_kmz","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line015:m0051","start":51,"end":52,"surface":"弢","kind":"person","person_id":"7dv_udy_955","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":