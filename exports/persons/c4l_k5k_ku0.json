{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"c4l_k5k_ku0","canonical_person_id":"c4l_k5k_ku0","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["c4l_k5k_ku0"],"persons":[{"id":"c4l_k5k_ku0","label":"黃季〔庾翼疏所稱〕","status":"active","historicity":"historical_tradition","aliases":[{"surface":"黃季","mention_ids":["c-jinshu-073-yuyi:p006:m0146"]}],"evidence":[{"mention_id":"c-jinshu-073-yuyi:p006:m0146","paragraph_id":"c-jinshu-073-yuyi:p006","chapter_id":"c-jinshu-073-yuyi","quote":"黃季"}],"review":"ai_provisional","identity_note":"黃季〔庾翼疏所稱〕，見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-jinshu-073-yuyi-ws2296501","work_id":"w-jinshu","book_id":"b-jinshu-073","chapter_id":"c-jinshu-073-yuyi","raw_mention_count":1,"mention_ids":["c-jinshu-073-yuyi:p006:m0146"],"paragraph_ids":["c-jinshu-073-yuyi:p006"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-073-yuyi:p006:m0146","mention_ids":["c-jinshu-073-yuyi:p006:m0146"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-073-yuyi-ws2296501"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-073-yuyi:p006:m0146","surface":"黃季","start":146,"end":148,"person_id":"c4l_k5k_ku0","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-073-yuyi:p006","chapter_id":"c-jinshu-073-yuyi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-073-yuyi:p006","text":"賊季龍年已六十，奢淫理盡，丑類怨叛，又欲決死遼東。皝雖驍果，未必能固。若北無掣手之虜，則江南將不異遼左矣。臣所以輒發良人，不顧忿咎。然東西形援未必齊舉，且欲北進，移鎮安陸，人沔五百，溳水通流。輒率南郡太守王愆期、江夏相謝尚、尋陽太守袁真、西陽太守曹據等精銳三萬，風馳上道，並勒平北將軍桓宣撲取黃季，欲並丹水，搖盪秦雍。禦以長轡，用逸待勞，比及數年，興復可冀。臣既臨許洛，竊謂恆溫可渡戍廣陵，何充可移據淮灑赭圻，路永進屯合肥。伏願表禦之日便決聖聽，不可廣詢同異，以乖事會。兵聞拙速，不聞工之久也。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":131,"last_line":131,"raw_start":10365,"raw_end":10622,"raw_character_offsets":[10373,10374,10375,10376,10377,10378,10379,10380,10381,10382,10383,10384,10385,10386,10387,10388,10389,10390,10391,10392,10393,10394,10395,10396,10397,10398,10399,10400,10401,10402,10403,10404,10405,10406,10407,10408,10409,10410,10411,10412,10413,10414,10415,10416,10417,10418,10419,10420,10421,10422,10423,10424,10425,10426,10427,10428,10429,10430,10431,10432,10433,10434,10435,10436,10437,10438,10439,10440,10441,10442,10443,10444,10445,10446,10447,10448,10449,10450,10451,10452,10453,10454,10455,10456,10457,10458,10459,10460,10461,10462,10463,10464,10465,10466,10467,10468,10469,10470,10471,10472,10473,10474,10475,10476,10477,10478,10479,10480,10481,10482,10483,10484,10485,10486,10487,10488,10489,10490,10491,10492,10493,10494,10495,10496,10497,10498,10499,10500,10501,10502,10503,10504,10505,10506,10507,10508,10509,10510,10511,10512,10513,10514,10515,10516,10517,10518,10519,10520,10521,10522,10523,10524,10525,10526,10527,10528,10529,10530,10531,10532,10533,10534,10535,10536,10537,10538,10539,10540,10541,10542,10543,10544,10545,10546,10547,10548,10549,10550,10551,