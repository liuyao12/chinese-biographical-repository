,"start":109,"end":110,"surface":"上","kind":"person","person_id":"av9_5kt_rys","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m003-0116","start":116,"end":118,"surface":"太后","kind":"person","person_id":"zcn_zyw_flp","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m003-0122","start":122,"end":123,"surface":"都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m003-0130","start":130,"end":132,"surface":"郅都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"}],"chapter_id":"c-shiji-122-kuli","book_id":"b-shiji-122","work_id":"w-shiji","source_id":"s-shiji122-kuli"},{"id":"c-shiji-122-kuli:p004","text":"濟南瞯氏宗人三百餘家，豪猾，二千石莫能制，於是景帝乃拜都爲濟南太守。至則族瞯氏首惡，餘皆股栗。居歳餘，郡中不拾遺。旁十餘郡守畏都如大府。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-122-kuli:m004-0002","start":2,"end":6,"surface":"瞯氏宗人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m004-0023","start":23,"end":25,"surface":"景帝","kind":"person","person_id":"av9_5kt_rys","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m004-0027","start":27,"end":28,"surface":"都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m004-0037","start":37,"end":41,"surface":"瞯氏首惡","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m004-0060","start":60,"end":62,"surface":"郡守","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m004-0063","start":63,"end":64,"surface":"都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"}],"chapter_id":"c-shiji-122-kuli","book_id":"b-shiji-122","work_id":"w-shiji","source_id":"s-shiji122-kuli"},{"id":"c-shiji-122-kuli:p007","text":"臨江王徴詣中尉府對簿，臨江王欲得刀筆爲書謝上，而都禁吏不予。魏其侯使人以閒與臨江王。臨江王旣爲書謝上，因自殺。竇太后聞之，怒，以危法中都，都免歸家。孝景帝乃使使持節拜都爲鴈門太守，而便道之官，得以便宜從事。匈奴素聞郅都節，居邊，爲引兵去，竟郅都死不近鴈門。匈奴至爲偶人象郅都，令騎馳射莫能中，見憚如此。匈奴患之。竇太后乃竟中都以漢法。景帝曰：「都忠臣。」欲釋之。竇太后曰：「臨江王獨非忠臣邪？」於是遂斬郅都。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-122-kuli:m007-0000","start":0,"end":3,"surface":"臨江王","kind":"person","person_id":"3sg_5re_qc2","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0011","start":11,"end":14,"surface":"臨江王","kind":"person","person_id":"3sg_5re_qc2","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0021","start":21,"end":22,"surface":"上","kind":"person","person_id":"av9_5kt_rys","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0024","start":24,"end":25,"surface":"都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0026","start":26,"end":27,"surface":"吏","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m007-0030","start":30,"end":33,"surface":"魏其侯","kind":"person","person_id":"oob_8rk_z66","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0038","start":38,"end":41,"surface":"臨江王","kind":"person","person_id":"3sg_5re_qc2","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0042","start":42,"end":45,"surface":"臨江王","kind":"person","person_id":"3sg_5re_qc2","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0049","start":49,"end":50,"surface":"上","kind":"person","person_id":"av9_5kt_rys","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0055","start":55,"end":58,"surface":"竇太后","kind":"person","person_id":"zcn_zyw_flp","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0067","start":67,"end":68,"surface":"都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0069","start":69,"end":70,"surface":"都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0074","start":74,"end":77,"surface":"孝景帝","kind":"person","person_id":"av9_5kt_rys","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0083","start":83,"end":84,"surface":"都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0103","start":103,"end":105,"surface":"匈奴","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m007-0107","start":107,"end":109,"surface":"郅都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0120","start":120,"end":122,"surface":"郅都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0128","start":128,"end":130,"surface":"匈奴","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m007-0135","start":135,"end":137,"surface":"郅都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0151","start":151,"end":153,"surface":"匈奴","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m007-0156","start":156,"end":159,"surface":"竇太后","kind":"person","person_id":"zcn_zyw_flp","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0162","start":162,"end":163,"surface":"都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0167","start":167,"end":169,"surface":"景帝","kind":"person","person_id":"av9_5kt_rys","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0172","start":172,"end":173,"surface":"都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0181","start":181,"end":184,"surface":"竇太后","kind":"person","person_id":"zcn_zyw_flp","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0187","start":187,"end":190,"surface":"臨江王","kind":"person","person_id":"3sg_5re_qc2","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0201","start":201,"end":203,"surface":"郅都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"}],"chapter_id":"c-shiji-122-kuli","book_id":"b-shiji-122","work_id":"w-shiji","source_id":"s-shiji122-kuli"},{"id":"c-shiji-122-kuli:p008","text":"寧成者，穰人也。以郎謁者事景帝。好氣，爲人小吏，必陵其長吏；爲人上，操下如束濕薪。滑賊任威。稍遷至濟南都尉，而郅都爲守。始前數都尉皆歩入府，因吏謁守如縣令，其畏郅都如此。及成往，直陵都出其上。都素聞其聲，於是善遇，與結驩。久之，郅都死，後長安左右宗室多暴犯法，於是上召寧成爲中尉。其治效郅都，其廉弗如，然宗室豪桀皆人人惴恐。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-122-kuli:m008-0000","start":0,"end":2,"surface":"寧成","kind":"person","person_id":"9u9_ae0_0oz","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m008-0013","start":13,"end":15,"surface":"景帝","kind":"person","person_id":"av9_5kt_rys","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m008-0027","start":27,"end":29,"surface":"長吏","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m008-0051","start":51,"end":53,"surface":"都尉","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m008-0055","start":55,"end":57,"surface":"郅都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m008-0063","start":63,"end":65,"surface":"都尉","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m008-0080","start":80,"end":82,"surface":"郅都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m008-0086","start":86,"end":87,"surface":"成","kind":"person","person_id":"9u9_ae0_0oz","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m008-0091","start":91,"end":92,"surface":"都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m008-0096","start":96,"end":97,"surface":"都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m008-0114","start":114,"end":116,"surface":"郅都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m008-0119","start":119,"end":125,"surface":"長安左右宗室","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m008-0132","start":132,"end":133,"surface":"上","kind":"person","person_id":"av9_5kt_rys","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m008-0134","start":134,"end":136,"surface":"寧成","kind":"person","person_id":"9u9_ae0_0oz","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m008-0143","start":143,"end":145,"surface":"郅都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m008-0152","start":152,"end":156,"surface":"宗室豪桀","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-122-kuli","book_id":"b-shiji-122","work_id":"w-shiji","source_id":"s-shiji122-kuli"},{"id":"c-shiji-122-kuli:p010","text":"周陽由者，其父趙兼以淮南王舅父侯周陽，故因姓周陽氏。由以宗家任爲郎，事孝文及景帝。景帝時，由爲郡守。武帝卽位，吏治尚循謹甚，然由居二千石中，最爲暴酷驕恣。所愛者，撓法活之；所憎者，曲法誅滅之。所居郡，必夷其豪。爲守，視都尉如令。爲都尉，必陵太守，奪之治。與汲黯倶爲忮，司馬安之文惡，倶在二千石列，同車未嘗敢均茵伏。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-122-kuli:m010-0000","start":0,"end":3,"surface":"周陽由","kind":"person","person_id":"xgx_g4a_c28_A","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m010-0007","start":7,"end":9,"surface":"趙兼","kind":"person","person_id":"xgx_g4a_c28","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m010-0010","start":10,"end":13,"surface":"淮南王","kind":"person","person_id":"g0j_yhl_z02","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m010-0022","start":22,"end":25,"surface":"周陽氏","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m010-0026","start":26,"end":27,"surface":"由","kind":"person","person_id":"xgx_g4a_c28_A","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m010-0028","start":28,"end":30,"surface":"宗家","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m010-0035","start":35,"end":37,"surface":"孝文","kind":"person","person_id":"9gv_44u_szv","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m010-0038","start":38,"end":40,"surface":"景帝","kind":"person","person_id":"av9_5kt_rys","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m010-0041","start":41,"end":43,"surface":"景帝","kind":"person","person_id":"av9_5kt_rys","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m010-0045","start":45,"end":46,"surface":"由","kind":"person","person_id":"xgx_g4a_c28_A","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m010-0050","start":50,"end":52,"surface":"武帝","kind":"person","person_id":"ln1_tyi_kei","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m010-0063","start":63,"end":64,"surface":"由","kind":"person","person_id":"xgx_g4a_c28_A","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m010-0128","start":128,"end":130,"surface":"汲黯","kind":"person","person_id":"9u7_1oo_f9u","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m010-0134","start":134,"end":137,"surface":"司馬安","kind":"person","person_id":"40l_mfp_yr6","status":"contextual_provisional"}],"chapter_id":"c-shiji-122-kuli","book_id":"b-shiji-122","work_id":"w-shiji","source_id":"s-shiji122-kuli"},{"id":"c-shiji-122-kuli:p019","text":"匈奴來請和親，群臣議上前。博士狄山曰：「和親便。」上問其便，山曰：「兵者凶器，未易數動。髙帝欲伐匈奴，大困平城，乃遂結和親。孝惠、髙后時，天下安樂。及孝文帝欲事匈奴，北邊蕭然苦兵矣。孝景時，呉楚七國反，景帝往來兩宮閒，寒心者數月。呉楚已破，竟景帝不言兵，天下富實。今自陛下舉兵撃匈奴，中國以空虚，邊民大困貧。由此觀之，不如和親。」上問湯，湯曰：「此愚儒，無知。」狄山曰：「臣固愚忠，若御史大夫湯乃詐忠。若湯之治淮南、江都，以深文痛詆諸侯，別疎骨肉，使蕃臣不自安。臣固知湯之爲詐忠。」於是上作色曰：「吾使生居一郡，能無使虜入盜乎？」曰：「不能。」曰：「居一縣？」對曰：「不能。」復曰：「居一障閒？」山自度辯窮且下吏，曰：「能。」於是上遣山乘鄣。至月餘，匈奴斬山頭而去。自是以後，群臣震慴。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-122-kuli:m019-0000","start":0,"end":2,"surface":"匈奴","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m019-0007","start":7,"end":9,"surface":"群臣","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m019-0010","start":10,"end"