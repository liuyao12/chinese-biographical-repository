rson_id":"d81_sg4_39r","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-suochen:p003:m0089","surface":"綝","start":89,"end":90,"person_id":"u3p_4ou_4st","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-suochen:p003:m0094","surface":"李羌","start":94,"end":96,"person_id":"a22_j1p_do5","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-suochen:p003:m0098","surface":"閻鼎","start":98,"end":100,"person_id":"emm_pbx_36w","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-suochen:p003:m0101","surface":"秦王","start":101,"end":103,"person_id":"pss_n95_7x4","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-suochen:p003:m0115","surface":"湣帝","start":115,"end":117,"person_id":"pss_n95_7x4","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-suochen:p003:m0118","surface":"綝","start":118,"end":119,"person_id":"u3p_4ou_4st","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-060-suochen","book_id":"b-jinshu-060","work_id":"w-jinshu","source_id":"s-jinshu-060-suochen-ws2413335"},{"id":"c-jinshu-060-yanding:p001","text":"閻鼎，字臺臣，天水人也。初為太傅東海王越參軍，轉卷令，行豫州刺史事，屯許昌。遭母喪，乃於密縣間鳩聚西州流人數千，欲還鄉里。值京師失守，秦王出奔密中，司空荀籓、籓弟司隸校尉組，及中領軍華恆、河南尹華薈，在密縣建立行臺，以密近賊，南趣許潁。司徒左長史劉疇在密為塢主，中書令李暅、太傅參軍騶捷劉蔚、鎮軍長史周顗、司馬李述皆來赴疇。僉以鼎有才用，且手握強兵，勸籓假鼎冠軍將軍、豫州刺史，蔚等為參佐。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":92,"last_line":92,"raw_start":7750,"raw_end":7947,"raw_character_offsets":[7752,7753,7754,7755,7756,7757,7758,7759,7760,7761,7762,7763,7764,7765,7766,7767,7768,7769,7770,7771,7772,7773,7774,7775,7776,7777,7778,7779,7780,7781,7782,7783,7784,7785,7786,7787,7788,7789,7790,7791,7792,7793,7794,7795,7796,7797,7798,7799,7800,7801,7802,7803,7804,7805,7806,7807,7808,7809,7810,7811,7812,7813,7814,7815,7816,7817,7818,7819,7820,7821,7822,7823,7824,7825,7826,7827,7828,7829,7830,7831,7832,7833,7834,7835,7836,7837,7838,7839,7840,7841,7842,7843,7844,7845,7