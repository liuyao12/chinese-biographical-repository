nshu-060-yanding","book_id":"b-jinshu-060","work_id":"w-jinshu","source_id":"s-jinshu-060-yanding-ws2413335"},{"id":"c-jinshu-060-yanding:p003","text":"梁綜與鼎爭權，鼎殺綜，以王毗為京兆尹。鼎首建大謀，立功天下。始平太守曲允、撫夷護軍索綝並害其功，且欲專權，馮翊太守梁緯、北地太守梁肅，並綜母弟，綝之姻也，謀欲除鼎，乃證其有無君之心，專戮大臣，請討之，遂攻鼎。鼎出奔雍，為氐竇首所殺，傳首長安。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":96,"last_line":96,"raw_start":8259,"raw_end":8382,"raw_character_offsets":[8261,8262,8263,8264,8265,8266,8267,8268,8269,8270,8271,8272,8273,8274,8275,8276,8277,8278,8279,8280,8281,8282,8283,8284,8285,8286,8287,8288,8289,8290,8291,8292,8293,8294,8295,8296,8297,8298,8299,8300,8301,8302,8303,8304,8305,8306,8307,8308,8309,8310,8311,8312,8313,8314,8315,8316,8317,8318,8319,8320,8321,8322,8323,8324,8325,8326,8327,8328,8329,8330,8331,8332,8333,8334,8335,8336,8337,8338,8339,8340,8341,8342,8343,8344,8345,8346,8347,8348,8349,8350,8351,8352,8353,8354,8355,8356,8357,8358,8359,8360,8361,8362,8363,8364,8365,8366,8367,8368,8369,8370,8371,8372,8373,8374,8375,8376,8377,8378,8379,8380,8381],"revision_id":2413335},"mentions":[{"id":"c-jinshu-060-yanding:p003:m0000","surface":"梁綜","start":0,"end":2,"person_id":"e8t_3gt_0gz","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-yanding:p003:m0003","surface":"鼎","start":3,"end":4,"person_id":"emm_pbx_36w","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-yanding:p003:m0007","surface":"鼎","start":7,"end":8,"person_id":"emm_pbx_36w","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-yanding:p003:m0009","surface":"綜","start":9,"end":10,"person_id":"e8t_3gt_0gz","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-yanding:p003:m0012","surface":"王毗","start":12,"end":14,"person_id":"l53_vss_g0u","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-yanding:p003:m0019","surface":"鼎","start":19,"end":20,"person_id":"emm_pbx_36w","kind":"person","status":"contextual_provisional"},{"id":"c-jins