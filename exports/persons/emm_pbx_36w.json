36,"person_id":"iai_g38_90g","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-yanding:p001:m0141","surface":"騶捷","start":141,"end":143,"person_id":"3yh_3v0_2w8","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-yanding:p001:m0143","surface":"劉蔚","start":143,"end":145,"person_id":"k8j_miw_vfz","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-yanding:p001:m0150","surface":"周顗","start":150,"end":152,"person_id":"3xx_gdy_or6_AAA","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-yanding:p001:m0155","surface":"李述","start":155,"end":157,"person_id":"fqk_6t0_6fu","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-yanding:p001:m0160","surface":"疇","start":160,"end":161,"person_id":"n4t_dv5_dyl","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-yanding:p001:m0164","surface":"鼎","start":164,"end":165,"person_id":"emm_pbx_36w","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-yanding:p001:m0176","surface":"籓","start":176,"end":177,"person_id":"yoo_ox0_545_FAAAA","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-yanding:p001:m0178","surface":"鼎","start":178,"end":179,"person_id":"emm_pbx_36w","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-yanding:p001:m0189","surface":"蔚","start":189,"end":190,"person_id":"k8j_miw_vfz","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-060-yanding","book_id":"b-jinshu-060","work_id":"w-jinshu","source_id":"s-jinshu-060-yanding-ws2413335"},{"id":"c-jinshu-060-yanding:p002","text":"鼎少有大志，因西土人思歸，欲立功鄉里，乃與撫軍長史王毗、司馬傳遜懷翼戴秦王之計，謂疇、捷等曰：「山東非霸王處，不如關中。」河陽令傅暢遺鼎書，勸奉秦王過洛陽，謁拜山陵，徑據長安，綏合夷晉，興起義眾，克復宗廟，雪社稷之恥。鼎得書，便欲詣洛，流人謂北道近河，懼有抄截，欲南自武關向長安。疇等皆山東人，咸不願西入，荀籓及疇、捷等並逃散。鼎追籓不及，暅等見殺，唯顗、述走得免。遂奉秦王行，止上洛，為山賊所襲，殺百餘人，率餘眾西至藍田。時劉聰向長安，為雍州刺史賈疋所逐，走還平陽。疋遣人奉迎秦王，遂至長安，而與大司馬南陽王保、衛將軍梁芬、京兆尹梁綜等並同心推戴，立王為皇太子，登壇告天，立社稷宗廟，以鼎為太子詹事，總攝百揆。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":94,"last_line":94,"raw_start":7949,"raw_end":8257,"raw_character_offsets":[7951,7952,7953,7954,7955,7956,7957,7958,7959,7960,7961,7962,7963,7964,7965,7966,7967,7968,7969,7970,7971,7972,7973,7974,7975,7976,7977,7978,7979,7980,7981,7982,7983,7984,7985,7986,7987,7988,7989,7990,7991,7992,7993,7994,7995,7996,7997,7998,7999,8000,8001,8002,8003,8004,8005,8006,8007,8008,8009,8010,8011,8012,8013,8014,8015,8016,8017,8018,8019,8020,8021,8022,8023,8024,8025,8026,8027,8028,8029,8030,8031,8032,8033,8034,8035,8036,8037,8038,8039,8040,8041,8042,8043,8044,8045,8046,8047,8048,8049,8050,8051,8052,8053,8054,8055,8056,8057,8058,8059,8060,8061,8062,8063,8064,8065,8066,8067,8068,8069,8070,8071,8072,8073,8074,8075,8076,8077,8078,8079,8080,8081,8082,8083,8084,8085,8086,8087,8088,8089,8090,8091,8092,8093,8094,8095,8096,8097,8098,8099,8100,8101,8102,8103,8104,8105,8106,8107,8108,8109,8110,8111,8112,8113,8114,8115,8116,8117,8118,8119,8120,8121,8122,8123,8124,8125,8126,8127,8128,8129,8130,8131,8132,8133,8134,8135,8136,8137,8138,8139,8140,8141,8142,8143,8144,8145,8146,8147,8148,8149,8150,8151,8152,8153,8154,8155,8156,8157,8158,8159,8160,8161,8162,8163,8164,8165,8166,8167,8168,8169,8170,8171,8172,8173,8174,8175,8176,8177,8178,8179,8180,8181,8182,8183,8184,8185,8186,8187,8188,8189,8190,8191,8192,8193,8194,8195,8196,8197,8198,8199,8200,8201,8202,8203,8204,8205,8206,8207,8208,8209,8210,8211,8212,8213,8214,8215,8216,8217,8218,8219,8220,8221,8222,8223,8224,8225,8226,8227,8228,8229,8230,8231,8232,8233,8234,8235,8236,8237,8238,8239,8240,8241,8242,8243,8244,8245,8246,8247,8248,8249,8250,8251,8252,8253,8254,8255,8256],"revision_id":2413335},"mentions":[{"id":"c-jinshu-060-yanding:p002:m0000","surface":"鼎","start":0,"end":1,"person_id":"emm_pbx_36w","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-yanding:p002:m0025","surface":"王毗","start":25,"end":27,"person_id":"l53_vss_g0u","kind":"person","status":"contextual_provisional"},{"id":"c-jins