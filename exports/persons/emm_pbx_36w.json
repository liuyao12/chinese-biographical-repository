],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-060-suochen:p003:m0098","mention_ids":["c-jinshu-060-suochen:p003:m0098"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-060-yanding-ws2413335"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-jinshu-060-yanding:source_review1-0","kind":"source_review","person_id":"emm_pbx_36w","source_quote":"閻鼎，字臺臣，天水人也。初為太傅東海王越參軍，轉卷令，行豫州刺史事，屯許昌。遭母喪，乃於密縣間鳩聚西州流人數千，欲還鄉里。值京師失守，秦王出奔密中，司空荀籓、籓弟司隸校尉組，及中領軍華恆、河南尹華薈，在密縣建立行臺，以密近賊，南趣許潁。司徒左長史劉疇在密為塢主，中書令李暅、太傅參軍騶捷劉蔚、鎮軍長史周顗、司馬李述皆來赴疇。僉以鼎有才用，且手握強兵，勸籓假鼎冠軍將軍、豫州刺史，蔚等為參佐。","reading":"閻鼎字臺臣，母喪後合西州流人。荀籓等立密縣行臺，諸人推鼎。","note":"閻鼎字臺臣，母喪後合西州流人。荀籓等立密縣行臺，諸人推鼎。","paragraph_id":"c-jinshu-060-yanding:p001","start_codepoint":0,"end_codepoint":195,"human_reviewed":false,"chapter_id":"c-jinshu-060-yanding","source_id":"s-jinshu-060-yanding-ws2413335"},{"id":"c-jinshu-060-yanding:source_review2-0","kind":"source_review","person_id":"emm_pbx_36w","source_quote":"鼎少有大志，因西土人思歸，欲立功鄉里，乃與撫軍長史王毗、司馬傳遜懷翼戴秦王之計，謂疇、捷等曰：「山東非霸王處，不如關中。」河陽令傅暢遺鼎書，勸奉秦王過洛陽，謁拜山陵，徑據長安，綏合夷晉，興起義眾，克復宗廟，雪社稷之恥。鼎得書，便欲詣洛，流人謂北道近河，懼有抄截，欲南自武關向長安。疇等皆山東人，咸不願西入，荀籓及疇、捷等並逃散。鼎追籓不及，暅等見殺，唯顗、述走得免。遂奉秦王行，止上洛，為山賊所襲，殺百餘人，率餘眾西至藍田。時劉聰向長安，為雍州刺史賈疋所逐，走還平陽。疋遣人奉迎秦王，遂至長安，而與大司馬南陽王保、衛將軍梁芬、京兆尹梁綜等並同心推戴，立王為皇太子，登壇告天，立社稷宗廟，以鼎為太子詹事，總攝百揆。","reading":"傅暢送書、閻鼎奉秦王西行、荀籓等分道。到長安立秦王為皇太子。","note":"傅暢送書、閻鼎奉秦王西行、荀籓等分道。到長安立秦王為皇太子。","paragraph_id":"c-jinshu-060-yanding:p002","start_codepoint":0,"end_codepoint":306,"human_reviewed":false,"chapter_id":"c-jinshu-060-yanding","source_id":"s-jinshu-060-yanding-ws2413335"},{"id":"c-jinshu-060-yanding:source_review3-0","kind":"source_review","person_id":"emm_pbx_36w","source_quote":"梁綜與鼎爭權，鼎殺綜，以王毗為京兆尹。鼎首建大謀，立功天下。始平太守曲允、撫夷護軍索綝並害其功，且欲專權，馮翊太守梁緯、北地太守梁肅，並綜母弟，綝之姻也，謀欲除鼎，乃證其有無君之心，專戮大臣，請討之，遂攻鼎。鼎出奔雍，為氐竇首所殺，傳首長安。","reading":"閻鼎殺梁綜，梁緯、梁肅同母弟，聯曲允、索綝；閻鼎為竇首所殺。","note":"閻鼎殺梁綜，梁緯、梁肅同母弟，聯曲允、索綝；閻鼎為竇首所殺。","paragraph_id":"c-jinshu-060-yanding:p003","start_codepoint":0,"end_codepoint":121,"human_reviewed":false,"chapter_id":"c-jinshu-060-yanding","source_id":"s-jinshu-060-yanding-ws2413335"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-jin060-yanding-death","person_id":"emm_pbx_36w","event_type":"death","source_term":"為氐竇首所殺","source_anchor":{"paragraph_id":"c-jinshu-060-yanding:p003","start":109,"end":115,"surface":"為氐竇首所殺"},"date_expression":null,"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-060","chapter_id":"c-jinshu-060-yanding","source_id":"s-jinshu-060-yanding-ws2413335","paragraph_id":"c-jinshu-060-yanding:p003","quote":"梁綜與鼎爭權，鼎殺綜，以王毗為京兆尹。鼎首建大謀，立功天下。始平太守曲允、撫夷護軍索綝並害其功，且欲專權，馮翊太守梁緯、北地太守梁肅，並綜母弟，綝之姻也，謀欲除鼎，乃證其有無君之心，專戮大臣，請討之，遂攻鼎。鼎出奔雍，為氐竇首所殺，傳首長安。","person_mention_id":"c-jinshu-060-yanding:p003:m0003"}],"status":"source_attested","interpretation_note":"按同段人物與次第核所屬卒事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"mentions":[{"id":"c-jinshu-060-appraisal-second:p001:m0047","surface":"閻鼎","start":47,"end":49,"person_id":"emm_pbx_36w","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-060-appraisal-second:p001","chapter_id":"c-jinshu-060-appraisal-second"},{"id":"c-jinshu-060-eulogy:p001:m0053","surface":"鼎","start":53,"end":54,"person_id":"e