1_wyb_xee","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-054-lvmeng:line079-pei01-01","chapter_id":"c-sanguozhi-054-lvmeng"},{"id":"c-sanguozhi-054-lvmeng:line079-pei01-01:m0213","start":213,"end":214,"surface":"仁","kind":"person","person_id":"1v1_wyb_xee","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-054-lvmeng:line079-pei01-01","chapter_id":"c-sanguozhi-054-lvmeng"},{"id":"c-sanguozhi-054-lvmeng:line079-pei01-01:m0235","start":235,"end":236,"surface":"仁","kind":"person","person_id":"1v1_wyb_xee","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-054-lvmeng:line079-pei01-01","chapter_id":"c-sanguozhi-054-lvmeng"},{"id":"c-sanguozhi-054-lvmeng:line079-pei01-01:m0246","start":246,"end":247,"surface":"仁","kind":"person","person_id":"1v1_wyb_xee","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-054-lvmeng:line079-pei01-01","chapter_id":"c-sanguozhi-054-lvmeng"},{"id":"c-sanguozhi-054-lvmeng:line079-pei01-01:m0262","start":262,"end":263,"surface":"仁","kind":"person","person_id":"1v1_wyb_xee","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-054-lvmeng:line079-pei01-01","chapter_id":"c-sanguozhi-054-lvmeng"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-054-lvmeng:line079","text":"　　後羽討樊，留兵將備公安、南郡。蒙上疏曰：「羽討樊而多留備兵，必恐蒙圖其後故也。蒙常有病，乞分士眾還建業，以治疾為名。羽聞之，必撤備兵，盡赴襄陽。大軍浮江，晝夜馳上，襲其空虛，則南郡可下，而羽可擒也。」遂稱病篤，權乃露檄召蒙還，陰與圖計。羽果信之，稍撤兵以赴樊。魏使于禁救樊，羽盡擒禁等，人馬數萬，託以糧乏，擅取湘關米。權聞之，遂行。先遣蒙在前。蒙至尋陽，盡伏其精兵𦩷𦪇中，使白衣搖櫓，作商賈人服，晝夜兼行，至羽所置江邊屯候，盡收縛之，是故羽不聞知。遂到南郡，士仁、麋芳皆降。蒙入據城，盡得羽及將士家屬，皆撫慰，約令軍中不得乾歷人家，有所求取。蒙麾下士，是汝南人，取民家一笠，以覆官鎧，官鎧雖公，蒙猶以為犯軍令，不可以鄉里故而廢法，遂垂涕斬之。於是軍中震慄，道不拾遺。蒙旦暮使親近存卹耆老，問所不足，疾病者給醫藥，饑寒者賜衣糧。羽府藏財寶，皆封閉以待權至。羽還，在道路，數使人與蒙相聞，蒙輒厚遇其使，周遊城中，家家致問，或手書示信。羽人還，私相參訊，咸知家門無恙，見待過於平時，故羽吏士無鬬心。會權尋至，羽自知孤窮，乃走麥城，西至漳鄉，眾皆委羽而降。權使朱然、潘璋斷其徑路，即父子俱獲，荊州遂定。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-054-lvmeng:line079:m0003","start":3,"end":4,"surface":"羽","kind":"person","person_id":"1c2_03c_9ea","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-lvmeng:line079:m0017","start":17,"end":18,"surface":"蒙","kind":"person","person_id":"ibt_i7u_ykp","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-lvmeng:line079:m0023","start":23,"end":24,"surface":"羽","kind":"person","person_id":"1c2_03c_9ea","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-lvmeng:line079:m0034","start":34,"end":35,"surface":"蒙","kind":"person","person_id":"ibt_i7u_ykp","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-lvmeng:line079:m0041","start":41,"end":42,"surface":"蒙","kind":"person","person_id":"ibt_i7u_ykp","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-lvmeng:line079:m0060","start":60,"end":61,"surface":"羽","kind":"person","person_id":"1c2_03c_9ea","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-lvmeng:line079:m0096","start":96,"end":97,"surface":"羽","kind":"person","person_id":"1c2_03c_9ea","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-lvmeng:line079:m0107","start":107,"end":108,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-lvmeng:line079:m0112","start":112,"end":113,"surface":"蒙","kind":"person","person_id":"ibt_i7u_ykp","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-lvmeng:line079:m0120","start":120