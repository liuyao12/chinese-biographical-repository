:false},"family_paths":[],"mentions":[{"id":"c-shiji-005-qin:m066-0086","start":86,"end":88,"surface":"申差","kind":"person","person_id":"icp_nrn_7pl","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p066","chapter_id":"c-shiji-005-qin"},{"id":"c-shiji-070-zhang:m013-0020","start":20,"end":23,"surface":"韓申差","kind":"person","person_id":"t77_51t_vl7","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p013","chapter_id":"c-shiji-070-zhang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji070-023","person_id":"t77_51t_vl7","scope":"same_chapter","chapter_ids":["c-shiji-070-zhang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["韓申差"],"evidence":[{"paragraph_id":"c-shiji-070-zhang:p013","quote":"明年，齊又來敗魏於觀津。秦復欲攻魏，先敗韓申差軍，斬首八萬，諸侯震恐。而張儀復說魏王曰：「魏地方不至千里，卒不過三十萬。地四平，諸侯四通輻湊，無名山大川之限。從鄭至梁二百餘里，車馳人走，不待力而至。梁南與楚境，西與韓境，北與趙境，東與齊境，卒戍四方，守亭鄣者不下十萬。梁之地勢，固戰場也。梁南與楚而不與齊，則齊攻其東；東與齊而不與趙，則趙攻其北；不合於韓，則韓攻其西；不親於楚，則楚攻其南：此所謂四分五裂之道也。"}],"rationale":"按第1至23段局部明示姓名與引語判讀；魏襄王卒後哀王受話語境分開。楚懷王與秦惠王在出使鄭袖段分辨，不按最近名字或全域王字判讀。擬議秦女、美人與子母不補姓名或婚姻；未名齊王不按年代記憶定名，異稱、史實及時序仍待覆核。"}],"equivalence_decisions":[{"id":"eq-shiji070-shen","person_ids":["icp_nrn_7pl","t77_51t_vl7"],"canonical_person_id":"icp_nrn_7pl","scope":"cross_chapter","chapter_ids":["c-shiji-005-qin","c-shiji-070-zhang"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-005-qin","source_id":"s-shiji-005-qin","paragraph_id":"c-shiji-005-qin:p066","quote":"十四年，更為元年。二年，張儀與齊、楚大臣會齧桑。三年，韓、魏太子來朝。張儀相魏。五年，王游至北河。七年，樂池相秦。韓、趙、魏、燕、齊帥匈奴共攻秦。秦使庶長疾與戰修魚，虜其將申差，敗趙公子渴、韓太子奐，斬首八萬二千。八年，張儀復相秦。九年，司馬錯伐蜀，滅之。伐取趙中都、西陽十年，韓太子蒼來質。伐取韓石章。伐敗趙將泥。伐取義渠二十五城。十一年，摢裏疾攻魏焦，降之。敗韓岸門，斬首萬，其將犀首走。公子通封於蜀。燕君讓其臣子之。十二年，王與梁王會臨晉。庶長疾攻趙，虜趙將莊。張儀相楚。十三年，庶長章擊楚於丹陽，虜其將屈丐，斬首八萬；又攻楚漢中，取地六百里，置漢中郡。楚圍雍氏，秦使庶長疾助韓而東攻齊，到滿助魏攻燕。十四年，伐楚，取召陵。丹、犁臣，蜀相壯殺蜀侯來降。","mention_ids":["c-shiji-005-qin:m066-0086"]},{"chapter_id":"c-shiji-070-zhang","source_id":"s-shiji-070-zhang","paragraph_id":"c-shiji-070-zhang:p013","quote":"明年，齊又來敗魏於觀津。秦復欲攻魏，先敗韓申差軍，斬首八萬，諸侯震恐。而張儀復說魏王曰：「魏地方不至千里，卒不過三十萬。地四平，諸侯四通輻湊，無名山大川之限。從鄭至梁二百餘里，車馳人走，不待力而至。梁南與楚境，西與韓境，北與趙境，東與齊境，卒戍四方，守亭鄣者不下十萬。梁之地勢，固戰場也。梁南與楚而不與齊，則齊攻其東；東與齊而不與趙，則趙攻其北；不合於韓，則韓攻其西；不親於楚，則楚攻其南：此所謂四分五裂之道也。","mention_ids":["c-shiji-070-zhang:m013-0020"]}],"rationale":"兩篇秦攻韓戰事均載申差及斬首八萬上下，姓名國別與事件相配；俘獲、敗軍及數字差異保留，不由同指抹平。 各篇原文與已發ID保留；同書篇章不當獨立見證。同指不確證年代、任職、人物傳說或所有敘事，版本仍待覆核。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-005-qin:p066","text":"十四年，更為元年。二年，張儀與齊、楚大臣會齧桑。三年，韓、魏太子來朝。張儀相魏。五年，王游至北河。七年，樂池相秦。韓、趙、魏、燕、齊帥匈奴共攻秦。秦使庶長疾與戰修魚，虜其將申差，敗趙公子渴、韓太子奐，斬首八萬二千。八年，張儀復相秦。九年，司馬錯伐蜀，滅之。伐取趙中都、西陽十年，韓太子蒼來質。伐取韓石章。伐敗趙將泥。伐取義渠二十五城。十一年，摢裏疾攻魏焦，降之。敗韓岸門，斬首萬，其將犀首走。公子通封於蜀。燕君讓其臣子之。十二年，王與梁王會臨晉。庶長疾攻趙，虜趙將莊。張儀相楚。十三年，庶長章擊楚於丹陽，虜其將屈丐，斬首八萬；又攻楚漢中，取地六百里，置漢中郡。楚圍雍氏，秦使庶長疾助韓而東攻齊，到滿助魏攻燕。十四年，伐楚，取召陵。丹、犁臣，蜀相壯殺蜀侯來降。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m066-0012","start":12,"end":14,"surface":"張儀","kind":"person","person_id":"uq6_74z_vtv","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0027","start":27,"end":32,"surface":"韓、魏太子","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、氏族、群體或未核指代；不補造個人或按熟知世系自動合併。"},{"id":"c-shiji-005-qin:m066-0035","start":35,"end":37,"surface":"張儀","kind":"person","person_id":"uq6_74z_vtv","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0052","start":52,"end":54,"surface":"樂池","kind":"person","person_id":"h40_rtd_6ut","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0075","start":75,"end":78,"surface":"庶長疾","kind":"person","person_id":"r9n_0vc_ywa","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0086","start":86,"end":88,"surface":"申差","kind":"person","person_id":"icp_nrn_7pl","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0090","start":90,"end":94,"surface":"趙公子渴","kind":"person","person_id":"gy6_lx6_eb2","status":"contextual_p