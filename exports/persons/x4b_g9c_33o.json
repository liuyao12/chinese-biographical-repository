hapter_id":"c-shiji-105-bianque"},{"id":"c-shiji-105-bianque:m001-0044","start":44,"end":47,"surface":"長桑君","kind":"person","person_id":"x4b_g9c_33o","status":"contextual_provisional","paragraph_id":"c-shiji-105-bianque:p001","chapter_id":"c-shiji-105-bianque"},{"id":"c-shiji-105-bianque:m049-0005","start":5,"end":7,"surface":"長桑","kind":"person","person_id":"x4b_g9c_33o","status":"contextual_provisional","paragraph_id":"c-shiji-105-bianque:p049","chapter_id":"c-shiji-105-bianque"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji105-002","person_id":"x4b_g9c_33o","surfaces":["長桑","長桑君"],"scope":"same_chapter","chapter_ids":["c-shiji-105-bianque"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-105-bianque:p001","quote":"扁鵲者，勃海郡鄭人也，姓秦氏，名越人。少時為人舍長。舍客長桑君過，扁鵲獨奇之，常謹遇之。長桑君亦知扁鵲非常人也。出入十餘年，乃呼扁鵲私坐，閒與語曰：「我有禁方，年老，欲傳與公，公毋泄。」扁鵲曰：「敬諾。」乃出其懷中藥予扁鵲：「飲是以上池之水，三十日當知物矣。」乃悉取其禁方書盡與扁鵲。忽然不見，殆非人也。扁鵲以其言飲藥三十日，視見垣一方人。以此視病，盡見五藏癥結，特以診脈為名耳。為醫或在齊，或在趙。在趙者名扁鵲。"},{"paragraph_id":"c-shiji-105-bianque:p049","quote":"上池祕術，長桑所傳。始候趙簡，知夢鈞天。言占虢嗣，屍蹶起焉。倉公贖罪，陽慶推賢。效驗多狀，式具於篇。"}],"rationale":"依本篇姓名、原稱及敘事回指暫定；醫案引語與附載注釋分層，未按同名自動跨篇合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-105-bianque:p001","text":"扁鵲者，勃海郡鄭人也，姓秦氏，名越人。少時為人舍長。舍客長桑君過，扁鵲獨奇之，常謹遇之。長桑君亦知扁鵲非常人也。出入十餘年，乃呼扁鵲私坐，閒與語曰：「我有禁方，年老，欲傳與公，公毋泄。」扁鵲曰：「敬諾。」乃出其懷中藥予扁鵲：「飲是以上池之水，三十日當知物矣。」乃悉取其禁方書盡與扁鵲。忽然不見，殆非人也。扁鵲以其言飲藥三十日，視見垣一方人。以此視病，盡見五藏癥結，特以診脈為名耳。為醫或在齊，或在趙。在趙者名扁鵲。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-105-bianque:m001-0000","start":0,"end":2,"surface":"扁鵲","kind":"person","person_id":"6hq_bb2_3rb","status":"contextual_provisional"},{"id":"c-shiji-105-bianque:m001-0016","start":16,"end":18,"surface":"越人","kind":"person","person_id":"6hq_bb2_3rb","status":"contextual_provisional"},{"id":"c-shiji-105-bianque:m0