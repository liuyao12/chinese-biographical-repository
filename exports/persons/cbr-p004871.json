{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004871","identity_policy":"contextual_provisional","person_ids":["cbr-p004871"],"persons":[{"id":"cbr-p004871","label":"秦王辭師未定（李斯列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"秦王","mention_ids":["c-shiji-087-lisi:m002-0066","c-shiji-087-lisi:m002-0171"]}],"evidence":[{"mention_id":"c-shiji-087-lisi:m002-0066","chapter_id":"c-shiji-087-lisi","paragraph_id":"c-shiji-087-lisi:p002","quote":"秦王"},{"mention_id":"c-shiji-087-lisi:m002-0171","chapter_id":"c-shiji-087-lisi","paragraph_id":"c-shiji-087-lisi:p002","quote":"秦王"}]}],"mentions":[{"id":"c-shiji-087-lisi:m002-0066","start":66,"end":68,"surface":"秦王","kind":"person","person_id":"cbr-p004871","status":"contextual_provisional","paragraph_id":"c-shiji-087-lisi:p002","chapter_id":"c-shiji-087-lisi"},{"id":"c-shiji-087-lisi:m002-0171","start":171,"end":173,"surface":"秦王","kind":"person","person_id":"cbr-p004871","status":"contextual_provisional","paragraph_id":"c-shiji-087-lisi:p002","chapter_id":"c-shiji-087-lisi"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji087-004","person_id":"cbr-p004871","surfaces":["秦王"],"scope":"same_chapter","chapter_ids":["c-shiji-087-lisi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-087-lisi:p002","quote":"乃從荀卿學帝王之術。學已成，度楚王不足事，而六國皆弱，無可為建功者，欲西入秦。辭於荀卿曰：「斯聞得時無怠，今萬乘方爭時，遊者主事。今秦王欲吞天下，稱帝而治，此布衣馳騖之時而遊說者之秋也。處卑賤之位而計不為者，此禽鹿視肉，人面而能彊行者耳。故詬莫大於卑賤，而悲莫甚於窮困。久處卑賤之位，困苦之地，非世而惡利，自讬於無為，此非士之情也。故斯將西說秦王矣。」"}],"rationale":"依李斯入秦及諫逐客書局部承接暫接；辭師時秦王未定，與莊襄王卒後所說秦王分開候選，未按同稱全域合併。引古人物與黃帝傳說性分存，短稱斯限李斯敘事。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-087-lisi:p002","text":"乃從荀卿學帝王之術。學已成，度楚王不足事，而六國皆弱，無可為建功者，欲西入秦。辭於荀卿曰：「斯聞得時無怠，今萬乘方爭時，遊者主事。今秦王欲吞天下，稱帝而治，此布衣馳騖之時而遊說者之秋也。處卑賤之位而計不為者，此禽鹿視肉，人面而能彊行者耳。故詬莫大於卑賤，而悲莫甚於窮困。久處卑賤之位，困苦之地，非世而惡利，自讬於無為，此非士之情也。故斯將西說秦王矣。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-087-lisi:m002-0002","start":2,"end":4,"surface":"荀卿","kind":"person","person_id":"cbr-p004869","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m002-0015","start":15,"end":17,"surface":"楚王","kind":"person","person_id":"cbr-p004870","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m002-0041","start":41,"end":43,"surface":"荀卿","kind":"person","person_id":"cbr-p004869","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m002-0046","start":46,"end":47,"surface":"斯","kind":"person","person_id":"cbr-p004868","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m002-0060","start":60,"end":62,"surface":"遊者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、普通類稱或未定對象不補姓名；人犬不當特定人物。"},{"id":"c-shiji-087-lisi:m002-0066","start":66,"end":68,"surface":"秦王","kind":"person","person_id":"cbr-p004871","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m002-0167","start":167,"end":168,"surface":"斯","kind":"person","person_id":"cbr-p004868","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m002-0171","start":171,"end":173,"surface":"秦王","kind":"person","person_id":"cbr-p004871","status":"contextual_provisional"}],"chapter_id":"c-shiji-087-lisi","book_id":"b-shiji-087","work_id":"w-shiji","source_id":"s-shiji-087-lisi"}],"sources":[{"chapter_id":"c-shiji-087-lisi","work_id":"w-shiji","book_id":"b-shiji-087","source_id":"s-shiji-087-lisi","source":{"title":"史記／卷087","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷087","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷087&oldid=2364605","revision_id":2364605,"accessed_on":"2026-10-09","extent":"38個非空正文區塊含兩篇嵌入上書及太史公論，排除導覽、空段、索隱述贊及現代版權。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[