unt":2,"mention_ids":["c-jinshu-070-bianhu:p012:m0158","c-jinshu-070-bianhu:p013:m0345"],"paragraph_ids":["c-jinshu-070-bianhu:p012","c-jinshu-070-bianhu:p013"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-070-bianhu:p012:m0158","mention_ids":["c-jinshu-070-bianhu:p012:m0158"],"kind":"paragraph"},{"canonical_mention_id":"c-jinshu-070-bianhu:p013:m0345","mention_ids":["c-jinshu-070-bianhu:p013:m0345"],"kind":"paragraph"}],"mention_count":2,"duplicate_mention_count":0,"paragraph_occurrence_count":2,"table_occurrence_count":0,"passage_count":2,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"2處獨立位置，2個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-070-bianhu-ws2595540"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin070-bianxu-brother","subject_person_id":"aht_uk9_k7c","object_person_id":"s3q_2k0_k83","predicate":"brother","qualifiers":{"source_term":"眕弟盱奉車都尉"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-070","chapter_id":"c-jinshu-070-bianhu","source_id":"s-jinshu-070-bianhu-ws2595540","paragraph_id":"c-jinshu-070-bianhu:p013","quote":"峻平，朝議贈壼左光祿大夫，加散騎常侍。尚書郎弘訥議以爲「死事之臣古今所重，卞令忠貞之節，當書于竹帛。今之追贈，實未副眾望，謂宜加鼎司之號，以旌忠烈之勳。」司徒王導見議，進贈驃騎將軍，加侍中。訥重議曰：「夫事親莫大於孝，事君莫尚於忠。唯孝也，故能盡敬竭誠；唯忠也，故能見危授命。此在三之大節，臣子之極行也。案壼委質三朝，盡規翼亮，遭世險難，存亡以之。受顧託之重，居端右之任，擁衛至尊，則有保傅之恩；正色在朝，則有匪躬之節。賊峻造逆，戮力致討，身當矢旝，再對賊鋒，父子并命，可謂破家爲國，守死勤事。昔許男疾終，猶蒙二等之贈，況壼伏節國難者乎！夫賞疑從重，況在不疑！謂可上準許穆，下同嵇紹，則允合典謨，克厭眾望。」於是改贈壼侍中、驃騎將軍、開府儀同三司，諡曰忠貞，祠以太牢。贈世子眕散騎侍郎，眕弟盱奉車都尉。眕母裴氏撫二子尸哭曰：「父爲忠臣，汝爲孝子，夫何恨乎！」徵士翟湯聞之歎曰：「父死於君，子死於父，忠孝之道，萃于一門。」眕子誕嗣。","subject_person_mention_id":"c-jinshu-070-bianhu:p013:m0345","object_person_mention_id":"c-jinshu-070-bianhu:p013:m0337"}],"status":"source_attested","interpretation_note":"原文眕弟盱。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-jin070-bianxu","person_id":"aht_uk9_k7c","event_type":"death","source_term":"同時見害","source_anchor":{"paragraph_id":"c-jinshu-070-bianhu:p012","start":168,"end":172,"surface":"同時見害"},"date_expression":null,"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-070","chapter_id":"c-jinshu-070-bianhu","source_id":"s-jinshu-070-bianhu-ws2595540","paragraph_id":"c-jinshu-070-bianhu:p012","quote":"峻至東陵口，詔以壼都督大桁東諸軍事、假節，復加領軍將軍、給事中。壼率郭默、趙胤等與峻大戰於西陵，爲峻所破。壼與鍾雅皆退還，死傷者以千數。壼、雅並還節，詣闕謝罪。峻進攻青溪，壼與諸軍距擊，不能禁。賊放火燒宮寺，六軍敗績。壼時發背創，猶未合，力疾而戰，率厲散眾及左右吏數百人，攻賊麾下，苦戰，遂死之，時年四十八。二子眕、盱見父沒，相隨赴賊，同時見害。","person_mention_id":"c-jinshu-070-bianhu:p012:m0158"}],"status":"source_attested","interpretation_note":"按同段人物與次第核所屬卒事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"mentions":[{"id":"c-jinshu-070-bianhu:p012:m0158","surface":"盱","start":158,"end":159,"person_id":"aht_uk9_k7c","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-070-bianhu:p012","chapter_id":"c-jinshu-070-bianhu"},{"id":"c-jinshu-070-bianhu:p013:m0345","surface":"盱","start":345,"end":346,"person_id":"aht_uk9_k7c","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-070-bianhu:p013","chapter_id":"c-jinshu-070-bianhu"}],"relations":[{"id":"a-jin070-bianxu-brother","subject_person_id":"aht_uk9_k7c","object_person_id":"s3q_2k0_k83","predicate":"brother","qualifiers":{"source_term":"眕弟盱奉車都尉"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-070","chapter_id":"c-jinshu-070-bianhu","source_id":"s-jinshu-070-bianhu-ws2595540","paragraph_id":"c-jinshu-0