anation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-047-sun-quan:p076:m0034","surface":"諸葛直","start":34,"end":37,"kind":"person","person_id":"pv8_vo9_5kr","status":"contextual_provisional","paragraph_id":"c-sanguozhi-047-sun-quan:p076","chapter_id":"c-sanguozhi-047-sun-quan"},{"id":"c-sanguozhi-047-sun-quan:p077:m0027","surface":"諸葛直","start":27,"end":30,"kind":"person","person_id":"pv8_vo9_5kr","status":"contextual_provisional","paragraph_id":"c-sanguozhi-047-sun-quan:p077","chapter_id":"c-sanguozhi-047-sun-quan"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-047-sun-quan:p076","text":"　　二年春正月，魏作合肥新城。詔立都講祭酒，以教學諸子。遣將軍衞溫、諸葛直將甲士萬人，浮海求夷洲及亶洲。亶洲在海中，長老傳言：秦始皇帝遣方士徐福將童男童女數千人入海，求蓬萊神山及仙藥，止此洲不還。世相承有數萬家，其上人民。時有至會稽貨布，會稽東縣人海行，亦有遭風流移至亶洲者。所在絶遠，卒不可得至，但得夷洲數千人還。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":85,"last_line":85,"raw_start":15303,"raw_end":15490,"raw_character_offsets":[15303,15304,15305,15306,15307,15308,15309,15310,15311,15312,15313,15314,15315,15316,15317,15318,15319,15329,15330,15331,15332,15335,15336,15337,15338,15339,15340,15341,15342,15343,15344,15345,15346,15347,15348,15349,15350,15351,15352,15353,15354,15355,15356,15357,15358,15359,15367,15368,15371,15379,15380,15383,15384,15385,15386,15387,15388,15389,15390,15391,15392,15393,15394,15395,15396,15397,15398,15399,1