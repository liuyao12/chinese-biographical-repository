status":"contextual_provisional","paragraph_id":"c-shiji-108-han:p011","chapter_id":"c-shiji-108-han"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-108-han:p011","text":"安國爲人多大略，智足以當世取合，而出於忠厚焉。貪嗜於財。所推舉皆廉士，賢於己者也。於梁舉壺遂、臧固、郅他，皆天下名士，士亦以此稱慕之，唯天子以爲國器。安國爲御史大夫四歳餘，丞相田蚡死，安國行丞相事，奉引墮車蹇。天子議置相，欲用安國，使使視之，蹇甚，乃更以平棘侯薛澤爲丞相。安國病免數月，蹇愈，上復以安國爲中尉。歳餘，徙爲衞尉。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-108-han:m011-0000","start":0,"end":2,"surface":"安國","kind":"person","person_id":"6hy_i1z_hu2","status":"contextual_provisional"},{"id":"c-shiji-108-han:m011-0044","start":44,"end":46,"surface":"壺遂","kind":"person","person_id":"hmj_pm8_38e","status":"contextual_provisional"},{"id":"c-shiji-108-han:m011-0047","start":47,"end":49,"surface":"臧固","kind":"person","person_id":"z6u_kf1_554","status":"contextual_provisional"},{"id":"c-shiji-108-han:m011-0050","start":50,"end":52,"surface":"郅他","kind":"person","person_id":"xqk_r2h_w1e","status":"contextual_provisional"},{"id":"c-shiji-108-han:m011-0068","start":68,"end":70,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-108-han:m011-0075","start":75,"end":77,"surface":"安國","kind":"person","person_id":"6hy_i1z_hu2","status":"contextual_provisional"},{"id":"c-shiji-108-han:m011-0088","start":88,"end":90,"surface":"田蚡","kind":"person","person_id":"7mz_d13_9ka_A","status":"contextual_provisional"},{"id":"c-shiji-108-han:m011-0092","start":92,"end":94,"surface":"安國","kind":"person","person_id":"6hy_i1z_hu2","status":"contextual_provisional"},{"id":"c-shiji-108-han:m011-0105","start":105,"end":107,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-108-han:m011-0113","start":113,"end":