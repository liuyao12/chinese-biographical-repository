{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"xky_ebm_pdy","canonical_person_id":"xky_ebm_pdy","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["xky_ebm_pdy"],"persons":[{"id":"xky_ebm_pdy","label":"薄太后（吳王濞列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"薄太后","mention_ids":["c-shiji-106-wuwang:m004-0248"]}],"evidence":[{"mention_id":"c-shiji-106-wuwang:m004-0248","chapter_id":"c-shiji-106-wuwang","paragraph_id":"c-shiji-106-wuwang:p004","quote":"薄太后"}]}],"source_mention_summary":[{"source_id":"s-shiji-106-wuwang","work_id":"w-shiji","book_id":"b-shiji-106","chapter_id":"c-shiji-106-wuwang","mention_count":1,"mention_ids":["c-shiji-106-wuwang:m004-0248"],"paragraph_ids":["c-shiji-106-wuwang:p004"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-106-wuwang"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-106-wuwang:m004-0248","start":248,"end":251,"surface":"薄太后","kind":"person","person_id":"xky_ebm_pdy","status":"contextual_provisional","paragraph_id":"c-shiji-106-wuwang:p004","chapter_id":"c-shiji-106-wuwang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji106-016","person_id":"xky_ebm_pdy","surfaces":["薄太后"],"scope":"same_chapter","chapter_ids":["c-shiji-106-wuwang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-106-wuwang:p004","quote":"晁錯為太子家令，得幸太子，數從容言吳過可削。數上書說孝文帝，文帝寬，不忍罰，以此吳日益橫。及孝景帝即位，錯為御史大夫，說上曰：「昔高帝初定天下，昆弟少，諸子弱，大封同姓，故王孽子悼惠王王齊七十餘城，庶弟元王王楚四十餘城，兄子濞王吳五十餘城：封三庶孽，分天下半。今吳王前有太子之郄，詐稱病不朝，於古法當誅，文帝弗忍，因賜几杖。德至厚，當改過自新。乃益驕溢，即山鑄錢，煮海水為鹽，誘天下亡人，謀作亂。今削之亦反，不削之亦反。削之，其反亟，禍小；不削，反遲，禍大。」三年冬，楚王朝，晁錯因言楚王戊往年為薄太后服，私姦服舍，請誅之。詔赦，罰削東海郡。因削吳之豫章郡、會稽郡。及前二年趙王有罪，削其河閒郡。膠西王卬以賣爵有姦，削其六縣。"}],"rationale":"依本篇姓名、原稱及敘事回指暫定；書信、制詔與附載述贊保留上下文，未按同名自動跨篇合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-106-wuwang:p004","text":"晁錯為太子家令，得幸太子，數從容言吳過可削。數上書說孝文帝，文帝寬，不忍罰，以此吳日益橫。及孝景帝即位，錯為御史大夫，說上曰：「昔高帝初定天下，昆弟少，諸子弱，大封同姓，故王孽子悼惠王王齊七十餘城，庶弟元王王楚四十餘城，兄子濞王吳五十餘城：封三庶孽，分天下半。今吳王前有太子之郄，詐稱病不朝，於古法當誅，文帝弗忍，因賜几杖。德至厚，當改過自新。乃益驕溢，即山鑄錢，煮海水為鹽，誘天下亡人，謀作亂。今削之亦反，不削之亦反。削之，其反亟，禍小；不削，反遲，禍大。」三年冬，楚王朝，晁錯因言楚王戊往年為薄太后服，私姦服舍，請誅之。詔赦，罰削東海郡。因削吳之豫章郡、會稽郡。及前二年趙王有罪，削其河閒郡。膠西王卬以賣爵有姦，削其六縣。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-106-wuwang:m004-0000","start":0,"end":2,"surface":"晁錯","kind":"person","person_id":"7md_vp9_mh6","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m004-0026","start":26,"end":29,"surface":"孝文帝","kind":"person","person_id":"hji_k07_9z9","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m004-0030","start":30,"end":32,"surface":"文帝","kind":"person","person_id":"hji_k07_9z9","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m004-0046","start":46,"end":49,"surface":"孝景帝","kind":"person","person_id":"l15_49l_ofr","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m004-0052","start":52,"end":53,"surface":"錯","kind":"person","person_id":"7md_vp9_mh6","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m004-0089","start":89,"end":92,"surface":"悼惠王","kind":"person","person_id":"0un_l4f_n8x","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m004-0101","start":101,"end":103,"surface":"元王","kind":"person","person_id":"toa_jp7_ex1","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m004-0131","start":131,"end":133,"surface":"吳王","kind":"person","person_id":"dl