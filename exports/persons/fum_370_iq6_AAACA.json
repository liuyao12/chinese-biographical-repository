6":"a53ae2dbced88decaa460fbf34f87bb5e65a0b37b524480cb362a3bebb1bc19d","accessed_on":"2026-10-22","edition":"維基文庫固定數位轉錄；實際版本底本未確認，未圖校","extent":"固定ws2087998 raw33弟椿至102，止103順弟津前；椿、昱、穎、順及附孝邕/叔良/辯/仲宣/玄就/測/稚卿全部33正文段；另同見證卷末共評。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"license_url":"https://creativecommons.org/licenses/by-sa/4.0/","rights":"古代正文；數位見證及網站校勘署名依維基文庫CC BY-SA4.0與附加條款保留","normalization":{"character_conversion":{},"extraction_note":"保原字與標點；段落按固定raw非空正文行。只分離網站ref校勘，原ref全文連raw位於annotation，逐字映射無摘要。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true},"assembled_identity":{"person_id":"fum_370_iq6_AAACA","representative_source_person_id":"fum_370_iq6_AAACA","source_person_ids":["fum_370_iq6_AAACA"],"identity_equivalence_decision_ids":[],"parent_person_id":"fum_370_iq6_AAAC","source_assertion_id":"a-ws058-chun-shuliang-father-ying","assembly_id":"family-hongnong-yang-jie-close","root_person_id":"fum_370_iq6","status":"contextual_provisional","human_reviewed":false},"name_components":[{"id":"name-weishu058-yangchun-shuliang-contextual","person_id":"fum_370_iq6_AAACA","surname":"楊","ming":"叔良","additional_names":[],"chapter_id":"c-weishu-weishou-058-yangchun","paragraph_id":"c-weishu-weishou-058-yangchun:p027","person_mention_id":"c-weishu-weishou-058-yangchun:p027:m0001","quote":"子叔良，武定中，新安太守。","status":"contextual_provisional","human_reviewed":false,"model":null,"note":"原人物錨只稱叔良；姓楊為同源原全文名及逐步明名兄弟／父子的有資格編輯首選，拼合全名不是原quote，不生成共同父或新親屬。","surname_basis":{"kind":"contextual_surname_from_bounded_named_family_path","status":"contextual_provisional","human_reviewed":false,"rationale":"完整本單元已讀，按有限明名近系承接姓氏；兄弟不動世代，明父子才加一，不把兄弟轉成父子或以ID補姓。","source_name_record_id":"name-weishu058-yangchun-exact","source_full_quote":"北都時，朝法嚴急。太和初，吾兄弟三人並居內職，兄在高祖左右，吾與津在文明太后左右。于時口敕，責諸內官，十日仰密得一事，不列便大瞋嫌。諸人多有依敕密列者，亦有太后、高祖中間傳言構間者。吾兄弟自相誡曰：「今忝二聖近臣，母子間甚難，宜深慎之。又列人事，亦何容易，縱被瞋責，慎勿輕言。」十餘年中，不嘗言一人罪過，當時大被嫌責。答曰：「臣等非不聞人言，正恐不審，仰誤聖聽，是以不敢言。」於後終以不言蒙賞。及二聖間言語，終不敢輒爾傳通。太和二十一年，吾從濟州來朝，在清徽堂豫讌。高祖謂諸王、諸貴曰：「北京之日，太后嚴明，吾每得杖，左右因此有是非言語。和朕母子者唯楊椿兄弟。」遂舉賜四兄及我酒。汝等脫若萬一蒙時主知遇，宜深慎言語，不可輕論人惡也。","seed_frame":{"paragraph_id":"c-weishu-weishou-058-yangchun:p014","paragraph_sha256":"b339c5134376f2d4d93dc8504cb8f2bba7c96a633f8170e7e1cab0a5434282fe","source_revision":2087998,"raw_sha256":"a53ae2dbced88decaa460fbf34f87bb5e65a0b37b524480cb362a3bebb1bc19d"},"steps":[{"assertion_id":"a-ws058-chun-ying-brother-chun","from_person_id":"fum_370_iq6_AAAB","to_person_id":"fum_370_iq6_AAAC","traversal":"older_to_younger","generation_before":0,"generation_after":0,"evidence":[{"work_id":"w-weishu-weishou","book_id":"b-weishu-weishou-058","source_id":"s-weishu-weishou-058-yangchun-ws2087998","chapter_id":"c-weishu-weishou-058-yangchun","paragraph_id":"c-weishu-weishou-058-yangchun:p026","quote":"椿弟穎，字惠哲。本州別駕。","subject_person_mention_id":"c-weishu-weishou-058-yangchun:p026:m0002","object_person_mention_id":"c-weishu-weishou-058-yangchun:p026:m0000"}],"source_frames":[{"paragraph_id":"c-weishu-weishou-058-yangchun:p026","paragraph_sha256":"7d515265c80e0dbcb10392123e1c21d57cbda3cbb2827ddb935e5aaff23476d7","source_revision":2087998,"raw_sha256":"a53ae2dbced88decaa460fbf34f87bb5e65a0b37b524480cb362a3bebb1bc19d"}]},{"assertion_id":"a-ws058-chun-shuliang-father-ying","from_person_id":"fum_370_iq6_AAAC","to_person_id":"fum_370_iq6_AAACA","traversal":"father_to_child","generation_before":0,"generation_after":1,"evidence":[{"work_id":"w-weishu-weishou","book_id":"b-weishu-weishou-058","source_id":"s-weishu-weishou-058-yangchun-ws2087998","chapter_id":"c-weishu-weishou-058-yangchun","paragraph_id":"c-weishu-weishou-058-yangchun:p026","quote":"椿弟穎，字惠哲。本州別駕。","object_person_mention_id":"c-weishu-weis