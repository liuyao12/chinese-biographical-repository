iji-040-chu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji040-118","person_id":"zjm_0fv_ke9","surfaces":["周幽王","幽王"],"scope":"same_chapter","chapter_ids":["c-shiji-040-chu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-040-chu:p010","quote":"若敖二十年，周幽王爲犬戎所弒，周東徙，而秦襄公始列爲諸侯。二十七年，若敖卒，子熊坎立，是爲霄敖。"},{"paragraph_id":"c-shiji-040-chu:p030","quote":"靈王三年六月，楚使使告晉，欲會諸侯。諸侯皆會楚于申。伍舉曰：「昔夏啓有鈞臺之饗，商湯有景亳之命，周武王有盟津之誓，成王有岐陽之閒，康王有豐宮之朝，穆王有涂山之會，齊桓有召陵之師，晉文有踐土之盟，君其何用？」靈王曰：「用桓公。」時鄭子産在焉。於是晉、宋、魯、衞不往。靈王已盟，有驕色。伍舉曰：「桀爲有仍之會，有緡叛之。紂爲黎山之會，東夷叛之。幽王爲太室之盟，戎、翟叛之。君其愼終！」"}],"rationale":"本篇具名角色先保存候選；尚未與他篇同名或同稱人物完成事件、世系與版本比對，不作確定不同人或確定同人的結論。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-040-chu:p010","text":"若敖二十年，周幽王爲犬戎所弒，周東徙，而秦襄公始列爲諸侯。二十七年，若敖卒，子熊坎立，是爲霄敖。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m010-0000","start":0,"end":2,"surface":"若敖","kind":"person","person_id":"ymr_gcs_kii_DAA","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m010-0006","start":6,"end":9,"surface":"周幽王","kind":"person","person_id":"zjm_0fv_ke9","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m010-0020","start":20,"end":23,"surface":"秦襄公","kind":"person","person_id":"k49_idc_dqx","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m010-0034","start":34,"end":36,"surface":"若敖","kind":"person","person_id":"ymr_gcs_kii_DAA","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m010-0039","start":39,"end":41,"surface":"熊坎","kind":"person","person_id":"ymr_gcs_kii_DAAA","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m010-0045","start":45,"end":47,"surface":"霄敖","kind":"person","person_id":"ymr_gcs_kii_DAAA","status":"contextual_provisional"}],"chapter_id":"c-shiji-040-chu","book_id":"b-shiji-040","work_id":"w-shiji","source_id":