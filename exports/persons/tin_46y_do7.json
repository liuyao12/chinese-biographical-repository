:m023-0076","c-shiji-096-zhang:m023-0093","c-shiji-096-zhang:m023-0230","c-shiji-096-zhang:m023-0275","c-shiji-096-zhang:m025-0026"],"paragraph_ids":["c-shiji-096-zhang:p022","c-shiji-096-zhang:p023","c-shiji-096-zhang:p025"],"table_cell_ids":[],"passage_count":3},{"source_id":"s-shiji112-pingjin","work_id":"w-shiji","book_id":"b-shiji-112","chapter_id":"c-shiji-112-pingjin","mention_count":1,"mention_ids":["c-shiji-112-pingjin:m030-0392"],"paragraph_ids":["c-shiji-112-pingjin:p030"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-096-zhang"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-shiji096-010","person_id":"tin_46y_do7","event_type":"death","status":"source_attested","date_expression":null,"source_term":"魏丞相竟以丞相病死","evidence":[{"chapter_id":"c-shiji-096-zhang","source_id":"s-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p023","quote":"魏丞相相者，濟陰人也。以文吏至丞相。其人好武，皆令諸吏帶劍，帶劍前奏事。或有不帶劍者，當入奏事，至乃借劍而敢入奏事。其時京兆尹趙君，丞相奏以免罪，使人執魏丞相，欲求脫罪而不聽。復使人脅恐魏丞相，以夫人賊殺待婢事而私獨奏請驗之，發吏卒至丞相舍，捕奴婢笞擊問之，實不以兵刃殺也。而丞相司直繁君奏京兆尹趙君迫脅丞相，誣以夫人賊殺婢，發吏卒圍捕丞相舍，不道；又得擅屏騎士事，趙京兆坐要斬。又有使掾陳平等劾中尚書，疑以獨擅劫事而坐之，大不敬，長史以下皆坐死，或下蠶室。而魏丞相竟以丞相病死。子嗣。後坐騎至廟，不敬，有詔奪爵一級，為關內侯，失列侯，得食其故國邑。魏丞相卒，以御史大夫邴吉代。","person_mention_id":"c-shiji-096-zhang:m023-0000"}],"interpretation_note":"依本篇明示死亡記載；相對三歲及嗣侯八年等不是公元年，不推未知月日，不以死亡填所有官爵終期。未核書影。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"mentions":[{"id":"c-shiji-096-zhang:m022-0192","start":192,"end":195,"surface":"魏丞相","kind":"person","person_id":"tin_46y_do7","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p022","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m023-0000","start":0,"end":4,"surface":"魏丞相相","kind":"person","person_id":"tin_46y_do7","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p023","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m023-0076","start":76,"end":79,"surface":"魏丞相","kind":"person","person_id":"tin_46y_do7","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p023","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m023-0093","start":93,"end":96,"surface":"魏丞相","kind":"person","person_id":"tin_46y_do7","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p023","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m023-0230","start":230,"end":233,"surface":"魏丞相","kind":"person","person_id":"tin_46y_do7","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p023","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m023-0275","start":275,"end":278,"surface":"魏丞相","kind":"person","person_id":"tin_46y_do7","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p023","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m025-0026","start":26,"end":29,"surface":"魏丞相","kind":"person","person_id":"tin_46y_do7","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p025","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-112-pingjin:m030-0392","start":392,"end":394,"surface":"魏相","kind":"person","person_id":"tin_46y_do7","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p030","chapter_id":"c-shiji-112-pingjin"}],"relations":[],"title_holdings":[{"id":"th-shiji096-072","person_id":"tin_46y_do7","title":"丞相","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-096-zhang","source_id":"s-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p023","quote":"魏丞相相者，濟陰人也。以文吏至丞相。其人好武，皆令諸吏帶劍，帶劍前奏事。或有不帶劍者，當入奏事，至乃借劍而敢入奏事。其時京兆尹趙君，丞相奏以免罪，使人執魏丞相，欲求脫罪而不聽。復使人脅恐魏丞相，以夫人賊殺待婢事而私獨奏請驗之，發吏卒至丞相舍，捕奴婢笞擊問之，實不以兵刃殺也。而丞相司直繁君奏京兆尹趙君迫脅丞相，誣以夫人賊殺婢，發吏卒圍捕丞相舍，不道；又得擅屏騎士事，趙京兆坐要斬。又有使掾陳平等劾中尚書，疑以獨擅劫事而坐之，大不敬，長史以下皆坐死，或下蠶室。而魏丞相竟以丞相病死。子嗣。後坐騎至廟，不敬，有詔奪爵一級，為關內侯，失列侯，得食其故國邑。魏丞相卒，以御史大夫邴吉代。"}],"attestations":[{"id":"th-shiji096-072:a001","paragraph_id":"c-shiji-096-zhang:p023","start":1,"end":3,"surface":"丞相","person_mention_id":"c-shiji-096-zhang:m023-0000","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"原文實授、轉任、用稱與諡稱分存；未明示時任期起訖未知。欲任竇廣國及欲令周苛將皆不作實授；死亡或首次用稱不自動作任期端點。十四年、四年、二年等先保留原語，不擅定年號或西曆。曹窋免職段含（不）異文，未先強定其終點。","reviewer":"Codex（AI 代理）"}],"address_assertions":[{"id":"pa-shiji096-007","person_id":"tin_46y_do7","relation":"biographical_origin","place":{"source_name":"濟陰","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-096-zhang","source_id":"s-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p023","quote":"魏丞相相者，濟陰人也。以文吏至丞相。其人好武，皆令諸吏帶劍，帶劍前奏事。或有不帶劍者，當入奏事，至乃借劍而敢入奏事。其時京兆尹趙君，丞相奏以免罪，使人執魏丞相，欲求脫罪而不聽。復使人脅恐魏丞相，以夫人賊殺待婢事而私獨奏請驗之，發吏卒至丞相舍，捕奴婢笞擊問之，實不以兵刃殺也。而丞相司直繁君奏京兆尹趙君迫脅丞相，誣以夫人賊殺婢，發吏卒圍捕丞相舍，不道；又得擅屏騎士事，趙京兆坐要斬。又有使掾陳平等劾中尚書，疑以獨擅劫事而坐之，大不敬，長史以下皆坐死，或下蠶室。而魏丞相竟以丞相病死。子嗣。後坐騎至廟，不敬，有詔奪爵一級，為關內侯，失列侯，得食其故國邑。魏丞相卒，以御史大夫邴吉代。"}],"source_term":"濟陰人也","interpretation_note":"原文某地人出身地陳述，不推出生地、制度化戶籍或今日行政區。任敖故沛獄吏為任職，未直接記為沛籍。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji096-064","person_id":"tin_46y_do7","scope":"same_chapter","chapter_ids":["c-shiji-096-zhang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["魏丞相","魏丞相相"],"evidence":[{"paragraph_id":"c-shiji-096-zhang:p022","quote":"有車丞相，長陵人也。卒而有韋丞相代。韋丞相賢者，魯人也。以讀書術為吏，至大鴻臚。有相工相之，當至丞相。有男四人，使相工相之，至第二子，其名玄成。相工曰：「此子貴，當封。」韋丞相言曰：「我即為丞相，有長子，是安從得之？」後竟為丞相，病死，而長子有罪論，不得嗣，而立玄成。玄成時佯狂，不肯立，竟立之，有讓國之名。後坐騎至廟，不敬，有詔奪爵一級，為關內侯，失列侯，得食其故國邑。韋丞相卒，有魏丞相代。"},{"paragraph_id":"c-shiji-096-zhang:p023","quote":"魏丞相相者，濟陰人也。以文吏至丞相。其人好武，皆令諸吏帶劍，帶劍前奏事。或有不帶劍者，當入奏事，至乃借劍而敢入奏事。其時京兆尹趙君，丞相奏以免罪，使人執魏丞相，欲求脫罪而不聽。復使人脅恐魏丞相，以夫人賊殺待婢事而私獨奏請驗之，發吏卒至丞相舍，捕奴婢笞擊問之，實不以兵刃殺也。而丞相司直繁君奏京兆尹趙君迫脅丞相，誣以夫人賊殺婢，發吏卒圍捕丞相舍，不道；又得擅屏騎士事，趙京兆坐要斬。又有使掾陳平等劾中尚書，疑以獨擅劫事而坐之，大不敬，長史以下皆坐死，或下蠶室。而魏丞相竟以丞相病死。子嗣。後坐騎至廟，不敬，有詔奪爵一級，為關內侯，失列侯，得食其故國邑。魏丞相卒，以御史大夫邴吉代。"},{"paragraph_id":"c-shiji-096-zhang:p025","quote":"邴丞相卒，黃丞相代。長安中有善相工田文者，與韋丞相、魏丞相、邴丞相微賤時會於客家，田文言曰：「今此三君者，皆丞相也。」其後三人竟更相代為丞相，何見之明也。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定短稱；韋賢與韋玄成分傳區別，第23段掾陳平另候選，第25段長安相工田文不與孟嘗君合併。趙堯、任敖、申屠嘉、鄧通、晁錯的短名依各段人物語境，王陵夫人與王陵分人。張蒼父長不滿五尺的長為身長敘述，不作父名。王侯與太子未詳名不補名，跨篇同指另待證據。"}],"equivalence_decisions":[{"id":"eq-shiji096-continuation-weixiang","person_ids":["tin_46y_do7"],"canonical_person_id":"tin_46y_do7","scope":"cross_chapter","chapter_ids":["c-shiji-096-zhang","c-shiji-112-pingjin"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-096-zhang","source_id":"s-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p023","quote":"魏丞相相者，濟陰人也。以文吏至丞相。其人好武，皆令諸吏帶劍，帶劍前奏事。或有不帶劍者，當入奏事，至乃借劍而敢入奏事。其時京兆尹趙君，丞相奏以免罪，使人執魏丞相，欲求脫罪而不聽。復使人脅恐魏丞相，以夫人賊殺待婢事而私獨奏請驗之，發吏卒至丞相舍，捕奴婢笞擊問之，實不以兵刃殺也。而丞相司直繁君奏京兆尹趙君迫脅丞相，誣以夫人賊殺婢，發吏卒圍捕丞相舍，不道；又得擅屏騎士事，趙京兆坐要斬。又有使掾陳平等劾中尚書，疑以獨擅劫事而坐之，大不敬，長史以下皆坐死，或下蠶室。而魏丞相竟以丞相病死。子嗣。後坐騎至廟，不敬，有詔奪爵一級，為關內侯，失列侯，得食其故國邑。魏丞相卒，以御史大夫邴吉代。","mention_ids":["c-shiji-096-zhang:m023-0000","c-shiji-096-zhang:m023-0076","c-shiji-096-zhang:m023-0093","c-shiji-096-zhang:m023-0230","c-shiji-096-zhang:m023-0275"]},{"chapter_id":"c-shiji-112-pingjin","source_id":"s-shiji112-pingjin","paragraph_id":"c-shiji-112-pingjin:p030","quote":"班固稱曰：公孫弘、卜式、兒寬皆以鴻漸之翼困於燕雀，遠跡羊豕之閒，非遇其時，焉能致此位乎？是時漢興六十餘載，海內乂安，府庫充實，而四夷未賓，制度多闕，上方欲用文武，求之如弗及。始以蒲輪迎枚生，見主父而嘆息。群臣慕向，異人并出。卜式試於芻牧，弘羊擢於賈豎，衛青奮於奴仆，日磾出於降虜，斯亦曩時版筑飯牛之朋矣。漢之得人，於茲為盛。儒雅則公孫弘、董仲舒、兒寬，篤行則石建、石慶，質直則汲黯、卜式，推賢則韓安國、鄭當時，定令則趙禹、張湯，文章則司馬遷、相如，滑稽則東方朔、枚皋，應對則嚴助、朱買臣，歷數則唐都、落下閎，協律則李延年，運籌則桑弘羊，奉使則張騫、蘇武，將帥則衛青、霍去病，受遺則霍光、金日磾。其餘不可勝紀。是以興造功業，制度遺文，後世莫及。孝宣承統，纂修洪業，亦講論六藝，招選茂異，而蕭望之、梁丘賀、夏侯勝、韋玄成、嚴彭祖、尹更始以儒術進，劉向、王褒以文章顯。將相則張安世、趙充國、魏相、邴吉、于定國、杜延年，治民則黃霸、王成、龔遂、鄭弘、邵信臣、韓延壽、尹翁歸、趙廣漢之屬，皆有功跡見述於後。累其名臣，亦其次也。","mention_ids":["c-shiji-112-pingjin:m030-0392"]}],"rationale":"魏丞相相明示姓魏名相及濟陰人，與附載班固稱孝宣將相魏相的時代和官職相接；魏相在此為人名，不當魏國相職或連其後繼邴吉。 附載班固稱與正文層次分存；同書各段不算獨立見證，未核書影。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true}],"passages":[{"id":"c-shiji-096-zhang:p022","text":"有車丞相，長陵人也。卒而有韋丞相代。韋丞相賢者，魯人也。以讀書術為吏，至大鴻臚。有相工相之，當至丞相。有男四人，使相工相之，至第二子，其名玄成。相工曰：「此子貴，當封。」韋丞相言曰：「我即為丞相，有長子，是安從得之？」後竟為丞相，病死，而長子有罪論，不得嗣，而立玄成。玄成時佯狂，不肯立，竟立之，有讓國之名。後坐騎至廟，不敬，有詔奪爵一級，為關內侯，失列侯，得食其故國邑。韋丞相卒，有魏丞相代。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhang:m022-0001","start":1,"end":4,"surface":"車丞相","kind":"person","person_id":"exl_e7q_rma","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m022-0013","start":13,"end":16,"surface":"韋丞相","kind":"person","person_id":"vna_am7_jn5","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m022-0018","start":18,"end":22,"surface":"韋丞相賢","kind":"person","person_id":"vna_am7_jn5","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m022-0069","start":69,"end":71,"surface":"玄成","kind":"person","person_id":"vna_am7_jn5_A","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m022-0085","start":85,"end":88,"surface":"韋丞相","kind":"person","person_id":"vna_am7_jn5","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m022-0099","start":99,"end":101,"surface":"長子","kind":"person","person_id":"vna_am7_jn5_B","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m022-0119","start":119,"end":121,"surface":"長子","kind":"person","person_id":"vna_am7_jn5_B","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m022-0131","start":131,"end":133,"surface":"玄成","kind":"person","person_id":"vna_am7_jn5_A","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m022-0134","start":134,"end":136,"surface":"玄成","ki