tart":194,"end":196,"surface":"陳平","kind":"person","person_id":"rwg_skp_gbq","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m023-0230","start":230,"end":233,"surface":"魏丞相","kind":"person","person_id":"tin_46y_do7","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m023-0275","start":275,"end":278,"surface":"魏丞相","kind":"person","person_id":"tin_46y_do7","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m023-0285","start":285,"end":287,"surface":"邴吉","kind":"person","person_id":"69x_se2_859","status":"contextual_provisional"}],"chapter_id":"c-shiji-096-zhang","book_id":"b-shiji-096","work_id":"w-shiji","source_id":"s-shiji-096-zhang"},{"id":"c-shiji-096-zhang:p025","text":"邴丞相卒，黃丞相代。長安中有善相工田文者，與韋丞相、魏丞相、邴丞相微賤時會於客家，田文言曰：「今此三君者，皆丞相也。」其後三人竟更相代為丞相，何見之明也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhang:m025-0000","start":0,"end":3,"surface":"邴丞相","kind":"person","person_id":"69x_se2_859","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m025-0005","start":5,"end":8,"surface":"黃丞相","kind":"person","person_id":"kmo_vp5_qe1","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m025-0017","start":17,"end":19,"surface":"田文","kind":"person","person_id":"5bm_cbv_s8c","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m025-0022","start":22,"end":25,"surface":"韋丞相","kind":"person","person_id":"vna_am7_jn5","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m025-0026","start":26,"end":29,"surface":"魏丞相","kind":"person","person_id":"tin_46y_do7","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m025-0030","start":30,"end":33,"surface":"邴丞相","kind":"person","person_id":"69x_se2_859","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m025-0041","start":41,"end":43,"surface":"田文","kind":"person","person_id":"5bm_cbv_s8c","status":"contextual_provisional"}],"chapter_id":"c-shiji-096-zhang","book_id":"b-shiji-096","work_id":"w-shiji","source_id":"s-shiji-096-zhang"},{"id":"c-shiji-112-pingjin:p030","text":"班固稱曰：公孫弘、卜式、兒寬皆以鴻漸之翼困於燕雀，遠跡羊豕之閒，非遇其時，焉能致此位乎？是時漢興六十餘載，海內乂安，府庫充實，而四夷未賓，制度多闕，上方欲用文武，求之如弗及。始以蒲輪迎枚生，見主父而嘆息。群臣慕向，異人并出。卜式試於芻牧，弘羊擢於賈豎，衛青奮於奴仆，日磾出於降虜，斯亦曩時版筑飯牛之朋矣。漢之得人，於茲為盛。儒雅則公孫弘、董仲舒、兒寬，篤行則石建、石慶，質直則汲黯、卜式，推賢則韓安國、鄭當時，定令則趙禹、張湯，文章則司馬遷、相如，滑稽則東方朔、枚皋，應對則嚴助、朱買臣，歷數則唐都、落下閎，協律則李延年，運籌則桑弘羊，奉使則張騫、蘇武，將帥則衛青、霍去病，受遺則霍光、金日磾。其餘不可勝紀。是以興造功業，制度遺文，後世莫及。孝宣承統，纂修洪業，亦講論六藝，招選茂異，而蕭望之、梁丘賀、夏侯勝、韋玄成、嚴彭祖、尹更始以儒術進，劉向、王褒以文章顯。將相則張安世、趙充國、魏相、邴吉、于定國、杜延年，治民則黃霸、王成、龔遂、鄭弘、邵信臣、韓延壽、尹翁歸、趙廣漢之屬，皆有功跡見述於後。累其名臣，亦其次也。","annotation_status":"in_progress","text_layer":"witness_appended_bangu_note","mentions":[{"id":"c-shiji-112-pingjin:m030-0000","start":0,"end":2,"surface":"班固","kind":"person","person_id":"gxd_15x_9d0","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0005","start":5,"end":8,"surface":"公孫弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0009","start":9,"end":11,"surface":"卜式","kind":"person","person_id":"h6s_hqj_u6k","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0012","start":12,"end":14,"surface":"兒寬","kind":"person","person_id":"x8r_9sk_d7a","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0074","start":74,"end":75,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0092","start":92,"end":94,"surface":"枚生","kind":"person","person_id":"e1m_xt0_8w7","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0096","start":96,"end":98,"surface":"主父","kind":"person","person_id":"vbr_ff1_yc4","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0112","start":112,"end":114,"surface":"卜式","kind":"person","person_id":"h6s_hqj_u6k","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0119","start":119,"end":121,"surface":"弘羊","kind":"person","person_id":"fi2_2cl_w22","status":"contextual_provisional"},{"id":"c-shiji-112-ping