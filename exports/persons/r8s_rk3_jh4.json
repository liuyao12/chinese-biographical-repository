{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"r8s_rk3_jh4","canonical_person_id":"r8s_rk3_jh4","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["r8s_rk3_jh4"],"persons":[{"id":"r8s_rk3_jh4","label":"趙驤〔成都王穎將〕","status":"active","historicity":"historical_tradition","aliases":[{"surface":"趙驤","mention_ids":["c-jinshu-044-luzhi:line056:m0181"]}],"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-044","chapter_id":"c-jinshu-044-luzhi","source_id":"s-jinshu-044-luzhi","paragraph_id":"c-jinshu-044-luzhi:line056","mention_id":"c-jinshu-044-luzhi:line056:m0181","quote":"趙驤"}],"identity_note":"卷四十四及惠帝紀、成都王傳，穎前鋒。","review":"ai_provisional"}],"source_mention_summary":[{"source_id":"s-jinshu-044-luzhi","work_id":"w-jinshu","book_id":"b-jinshu-044","chapter_id":"c-jinshu-044-luzhi","raw_mention_count":1,"mention_ids":["c-jinshu-044-luzhi:line056:m0181"],"paragraph_ids":["c-jinshu-044-luzhi:line056"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-044-luzhi:line056:m0181","mention_ids":["c-jinshu-044-luzhi:line056:m0181"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-044-luzhi"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-044-luzhi:line056:m0181","start":181,"end":183,"surface":"趙驤","kind":"person","person_id":"r8s_rk3_jh4","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-044-luzhi:line056","chapter_id":"c-jinshu-044-luzhi"}],"relations":[],"title_holdings":[{"id":"th-w044-luzhi-7","person_id":"r8s_rk3_jh4","title":"前鋒都督","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-044","chapter_id":"c-jinshu-044-luzhi","source_id":"s-jinshu-044-luzhi","paragraph_id":"c-jinshu-044-luzhi:line056","quote":"志字子道，初辟公府掾、尚書郎，出為鄴令。成都王穎之鎮鄴也，愛其才量，委以心膂，遂為謀主。齊王冏起義，遣使告穎。穎召志計事，志曰：「趙王無道，肆行篡逆，四海人神，莫不憤怒。今殿下總率三軍，應期電發，子來之眾，不召自至。掃夷凶逆，必有征無戰。然兵事至重，聖人所慎。宜旌賢任才，以收時望。」穎深然之，改選上佐，高辟掾屬，以志為諮議參軍，仍補左長史，專掌文翰。穎前鋒都督趙驤為倫所敗，士眾震駭，議者多欲還保朝歌。志曰：「今我軍失利，敵新得勝，必有輕易陵轢之情，若頓兵不進，三軍畏衄，懼不可用。且戰何能無勝負，宜更選精兵，星行倍道，出賊不意，此用兵之奇也。」穎從之。及倫敗，志勸穎曰：「齊王眾號百萬，與張泓等相持不能決，大王逕得濟河，此之大勳，莫之與比，而齊王今當與大王共輔朝政。志聞兩雄不俱處，功名不並立，今宜因太妃微疾，求還定省，推崇齊王，徐結四海之心，此計之上也。」穎納之，遂以母疾還籓，委重於冏。由是穎獲四海之譽，天下歸心。朝廷封志為武強侯，加散騎常侍。","person_mention_id":"c-jinshu-044-luzhi:line056:m0181"}],"attestations":[{"id":"th-w043-luzhi-7:a","paragraph_id":"c-jinshu-044-luzhi:line056","start":177,"end":181,"surface":"前鋒都督","person_mention_id":"c-jinshu-044-luzhi:line056:m0181","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-044-luzhi:line056","text":"志字子道，初辟公府掾、尚書郎，出為鄴令。成都王穎之鎮鄴也，愛其才量，委以心膂，遂為謀主。齊王冏起義，遣使告穎。穎召志計事，志曰：「趙王無道，肆行篡逆，四海人神，莫不憤怒。今殿下總率三軍，