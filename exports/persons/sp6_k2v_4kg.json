至多非道憐所了太后曰道憐年出五十豈當不如汝十歲兒邪上曰車士雖為刺史事無大小悉由寄奴道憐年長不親其事於聽望不足太后乃無言車士義真小字也三年春高祖不豫加班劍三十人時道憐入朝留司馬陸仲元居守刁逵子彌為亡命率數十人入京城仲元擊斬之先是府史陳豔告彌有異謀至是賜錢二十萬除縣令五月宮車晏駕道憐疾患不堪臨","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-songshu-051-wyd1739-zongshi:p005:m0019","start":19,"end":22,"surface":"廬陵王","kind":"person","person_id":"4ly_56b_ld0","status":"contextual_provisional"},{"id":"c-songshu-051-wyd1739-zongshi:p005:m0022","start":22,"end":24,"surface":"義真","kind":"person","person_id":"4ly_56b_ld0","status":"contextual_provisional"},{"id":"c-songshu-051-wyd1739-zongshi:p005:m0029","start":29,"end":31,"surface":"太后","kind":"person","person_id":"ph1_ms8_hyq_AA","status":"contextual_provisional"},{"id":"c-songshu-051-wyd1739-zongshi:p005:m0032","start":32,"end":33,"surface":"上","kind":"person","person_id":"3qs_nqa_ioa_AAA","status":"contextual_provisional"},{"id":"c-songshu-051-wyd1739-zongshi:p005:m0034","start":34,"end":36,"surface":"道憐","kind":"person","person_id":"3qs_nqa_ioa_AAB","status":"contextual_provisional"},{"id":"c-songshu-051-wyd1739-zongshi:p005:m0036","start":36,"end":37,"surface":"汝","kind":"person","person_id":"3qs_nqa_ioa_AAA","status":"contextual_provisional"},{"id":"c-songshu-051-wyd1739-zongshi:p005:m0046","start":46,"end":47,"surface":"上","kind":"person","person_id":"3qs_nqa_ioa_AAA","status":"contextual_provisional"},{"id":"c-songshu-051-wyd1739-zongshi:p005:m0048","start":48,"end":50,"surface":"寄奴","kind":"person","person_id":"3qs_nqa_ioa_AAA","status":"contextual_provisional"},{"id":"c-songshu-051-wyd1739-zongshi:p005:m0051","start":51,"end":53,"surface":"道憐","kind":"person","person_id":"3qs_nqa_ioa_AAB","status":"contextual_provisional"},{"id":"c-songshu-051-wyd1739-zongshi:p005:m0068","start":68,"end":70,"surface":"道憐","kind":"person","person_id":"3qs_nqa_ioa_AAB","status":"contextual_provisional"},{"id":"c-songshu-051-wyd1739-zongshi:p005:m0072","start":72,"end":74,"surface":"太后","kind":"person","person_id":"ph1_ms8_hyq_AA","status