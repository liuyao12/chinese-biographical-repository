ional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-nanqishu-054-recluses-complete:source_review48-0","kind":"source_review","person_id":"rp9_3uw_714","source_quote":"　　劉虯字靈預，南陽涅陽人也。舊族，徙居江陵。虯少而抗節好學，須得祿便隱。宋泰始中，仕至晉平王驃騎記室，當陽令。罷官歸家，靜處斷穀，餌朮及胡麻。","reading":"劉虯字靈預。南陽涅陽舊族遷江陵，當陽令後歸家。","note":"劉虯字靈預。南陽涅陽舊族遷江陵，當陽令後歸家。","paragraph_id":"c-nanqishu-054-recluses-complete:p048","start_codepoint":0,"end_codepoint":72,"human_reviewed":false,"chapter_id":"c-nanqishu-054-recluses-complete","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:source_review49-0","kind":"source_review","person_id":"rp9_3uw_714","source_quote":"　　建元初，豫章王爲荊州，教辟虯爲別駕，與同郡宗測、新野庾易竝遣書禮請，虯等各修牋答，而不應辟命。永明三年，刺史廬陵王子卿表虯及同郡宗測、宗尚之、庾易、劉昭五人，請加蒲車束帛之命。詔徵爲通直郎，不就。","reading":"建元初嶷所辟三人與永明三年子卿薦五人分別核錄。","note":"建元初嶷所辟三人與永明三年子卿薦五人分別核錄。","paragraph_id":"c-nanqishu-054-recluses-complete:p049","start_codepoint":0,"end_codepoint":100,"human_reviewed":false,"chapter_id":"c-nanqishu-054-recluses-complete","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:source_review50-0","kind":"source_review","person_id":"rp9_3uw_714","source_quote":"　　竟陵王子良致書通意。虯答曰：「虯四節卧病，三時營灌，暢餘陰於山澤，託暮情於魚鳥，寧非唐、虞重恩，周、邵宏施？虯進不研機入玄，無洙泗稷館之辯；退不凝心出累，非冢間樹下之節。遠澤旣灑，仁規先著。謹收樵牧之嫌，敬加軾躔之義。」","reading":"劉虯書答子良，書中四節三時為自敘生活節候。","note":"劉虯書答子良，書中四節三時為自敘生活節候。","paragraph_id":"c-nanqishu-054-recluses-complete:p050","start_codepoint":0,"end_codepoint":112,"human_reviewed":false,"chapter_id":"c-nanqishu-054-recluses-complete","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:source_review51-0","kind":"source_review","person_id":"rp9_3uw_714","source_quote":"　　虯精信釋氏，衣麤布衣，禮佛長齋。注《法華經》，自講佛義。以江陵西沙洲去人遠，乃徙居之。建武二年，詔徵國子博士，不就。其冬虯病，正晝有白雲徘徊檐戶之內，又有香氣及磬聲，其日卒。年五十八。","reading":"建武二年徵國子博士不就，其冬同段記病卒，報年五十八。","note":"建武二年徵國子博士不就，其冬同段記病卒，報年五十八。","paragraph_id":"c-nanqishu-054-recluses-complete:p051","start_codepoint":0,"end_codepoint":94,"human_reviewed":false,"chapter_id":"c-nanqishu-054-recluses-complete","source_id":"s-nanqishu-054-recluses-complete-ws1762878"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-qi054-liuqiu-death","person_id":"rp9_3uw_714","event_type":"death","source_term":"卒","source_anchor":{"paragraph_id":"c-nanqishu-054-recluses-complete:p051","start":87,"end":88,"surface":"卒"},"date_expression":"其冬","evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-054","chapter_id":"c-nanqishu-054-recluses-complete","source_id":"s-nanqishu-054-recluses-complete-ws1762878","paragraph_id":"c-nanqishu-054-recluses-complete:p051","quote":"　　虯精信釋氏，衣麤布衣，禮佛長齋。注《法華經》，自講佛義。以江陵西沙洲去人遠，乃徙居之。建武二年，詔徵國子博士，不就。其冬虯病，正晝有白雲徘徊檐戶之內，又有香氣及磬聲，其日卒。年五十八。","person_mention_id":"c-nanqishu-054-recluses-complete:p051:m0002"}],"status":"source_attested","interpretation_note":"按同段人物與次第核所屬卒事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"age_assertions":[{"id":"age-qi054-liuqiu-death","person_id":"rp9_3uw_714","source_number":"五十八","source_term":"年五十八","value":58,"unit":"source_age_years","counting":"unspecified_source_age","birth_year":null,"date_expression":"其冬","source_anchor":{"paragraph_id":"c-nanqishu-054-recluses-complete:p051","start":89,"end":93,"surface":"年五十八"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-054","chapter_id":"c-nanqishu-054-recluses-complete","source_id":"s-nanqishu-054-recluses-complete-ws1762878","paragraph_id":"c-nanqishu-054-recluses-complete:p051","quote":"　　虯精信釋氏，衣麤布衣，禮佛長齋。注《法華經》，自講佛義。以江陵西沙洲去人遠，乃徙居之。建武二年，詔徵國子博士，不就。其冬虯病，正晝有白雲徘徊檐戶之內，又有香氣及磬聲，其日卒。年五十八。","person_mention_id":"c-nanqishu-054-recluses-complete:p051:m0002"}],"age_context":{"kind":"at_death","life_event_id":"le-qi054-liuqiu-deat