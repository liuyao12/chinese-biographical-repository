"contextual_provisional","paragraph_id":"c-nanqishu-054-recluses-complete:p061","chapter_id":"c-nanqishu-054-recluses-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-054-recluses-complete:p048","text":"　　劉虯字靈預，南陽涅陽人也。舊族，徙居江陵。虯少而抗節好學，須得祿便隱。宋泰始中，仕至晉平王驃騎記室，當陽令。罷官歸家，靜處斷穀，餌朮及胡麻。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":126,"last_line":126,"raw_start":7039,"raw_end":7111,"raw_character_offsets":[7039,7040,7041,7042,7043,7044,7045,7046,7047,7048,7049,7050,7051,7052,7053,7054,7055,7056,7057,7058,7059,7060,7061,7062,7063,7064,7065,7066,7067,7068,7069,7070,7071,7072,7073,7074,7075,7076,7077,7078,7079,7080,7081,7082,7083,7084,7085,7086,7087,7088,7089,7090,7091,7092,7093,7094,7095,7096,7097,7098,7099,7100,7101,7102,7103,7104,7105,7106,7107,7108,7109,7110],"revision_id":1762878},"mentions":[{"id":"c-nanqishu-054-recluses-complete:p048:m0002","start":2,"end":4,"surface":"劉虯","kind":"person","person_id":"rp9_3uw_714","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p048:m0005","start":5,"end":7,"surface":"靈預","kind":"person","person_id":"rp9_3uw_714","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p048:m0023","start":23,"end":24,"surface":"虯","kind":"person","person_id":"rp9_3uw_714","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-054-recluses-complete","book_id":"b-nanqishu-054","work_id":"w-nanqishu","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:p049","text":"　　建元初，豫章王爲荊州，教辟虯爲別駕，與同郡宗測、新野庾易竝遣書禮請，虯等各修牋答，而不應辟命。永明三年，刺史廬陵王子卿表虯及同郡宗測、宗尚之、庾易、劉昭五人，請加蒲車束帛之命。詔徵爲通直郎，不就。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":128,"last_line":128,"raw_start":7113,"raw_end":7213,"raw_character_offsets":[7113,7114,7115,7116,7117,7118,7119,7120,7121,7122,7123,7124,7125,7126,7127,7128,7129,7130,7131,7132,7133,7134,7135,7136,7137,7138,7139,7140,7141,7142,7143,7144,7145,7146,7147,7148,7149,7150,7151,7152,7153,7154,7155,7156,7157,7158,7159,7160,7161,7162,7163,7164,7165,7166,7167,7168,7169,7170,7171,7172,7173,7174,7175,7176,7177,7178,7179,7180,7181,7182,7183,7184,7185,7186,7187,7188,7189,7190,7191,7192,7193,7194,7195,7196,7197,7198,7199,7200,7201,7202,7203,7204,7205,7206,7207,7208,7209,7210,7211,7212],"revision_id":1762878},"mentions":[{"id":"c-nanqishu-054-recluses-complete:p049:m0006","start":6,"end":9,"surface":"豫章王","kind":"person","person_id":"ijh_3fs_6u2","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p049:m0015","start":15,"end":16,"surface":"虯","kind":"person","person_id":"rp9_3uw_714","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p049:m0023","start":23,"end":25,"surface":"宗測","kind":"person","person_id":"ou7_kzk_fb6","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p049:m0028","start":28,"end":30,"surface":"庾易","kind":"person","person_id":"e3g_qwe_o7m","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p049:m0036","start":36,"end":37,"surface":"虯","kind":"person","person_id":"rp9_3uw_714","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p049:m0056","start":56,"end":61,"surface":"廬陵王子卿","kind":"person","person_id":"kix_r92_2ed_E","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p049:m0062","start":62,"end":63,"surface":"虯","kind":"person","person_id":"rp9_3uw_714","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p049:m0066","start":66,"end":68,"surface":"宗測","kind":"person","person_id":"ou7_kzk_fb6","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p049:m0069","start":69,"end":72,"surface":"宗尚之","kind":"person","person_id":"qti_nn7_0v2","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p049:m0073","start":73,"end":75,"surface":"庾易","kind":"person","person_id":"e3g_qwe_o7m","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p049:m0076","start":76,"end":78,"surface":"劉昭","kind":"person","person_id":"0bk_2xn_akj","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-054-recluses-complete","book_id":"b-nanqishu-054","work_id":"w-nanqishu","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:p050","text":"　　竟陵王子良致書通意。虯答曰：「虯四節卧病，三時營灌，暢餘陰於山澤，託暮情於魚鳥，寧非唐、虞重恩，周、邵宏施？虯進不研機入玄，無洙泗稷館之辯；退不凝心出累，非冢間樹下之節。遠澤旣灑，仁規先著。謹收樵牧之嫌，敬加軾躔之義。」","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":130,"last_line":130,"raw_start":7215,"raw_end":7327,"raw_character_offsets":[7215,7216,7217,7218,7219,7220,7221,7222,7223,7224,7225,7226,7227,7228,7229,7230,7231,7232,7233,7234,7235,7236,7237,7238,7239,7240,7241,7242,7243,7244,7245,7246,7247,7248,7249,7250,7251,7252,7253,7254,7255,7256,7257,7258,7259,7260,7261,7262,7263,7264,7265,7266,7267,7268,7269,7270,7271,7272,7273,7274,7275,7276,7277,7278,7279,7280,7281,7282,7283,7284,7285,7286,7287,7288,7289,7290,7291,7292,7293,7294,7295,7296,7297,7298,7299,7300,7301,7302,7303,7304,7305,7306,7307,7308,7309,7310,7311,7312,7313,7314,7315,7316,7317,7318,7319,7320,7321,7322,7323,7324,7325,7326],"revision_id":1762878},"mentions":[{"id":"c-nanqishu-054-recluses-complete:p050:m0002","start":2,"end":7,"surface":"竟陵王子良","kind":"person","person_id":"x3q_cqm_dup","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p050:m0012","start":12,"end":13,"surface":"虯","kind":"person","person_id":"rp9_3uw_714","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p050:m0017","start":17,"end":18,"surface":"虯","kind":"person","person_id":"rp9_3uw_714","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p050:m0056","start":56,"end":57,"surface":"虯","kind":"person","person_id":"rp9_3uw_714","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-054-recluses-complete","book_id":"b-nanqishu-054","work_id":"w-nanqishu","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:p051","text":"　　虯精信釋氏，衣麤布衣，禮佛長齋。注《法華經》，自講佛義。以江陵西沙洲去人遠，乃徙居之。建武二年，詔徵國子博士，不就。其冬虯病，正晝有白雲徘徊檐戶之內，又有香氣及磬聲，其日卒。年五十八。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":132,"last_line":132,"raw_start":7329,"raw_end":7423,"raw_character_offsets":[7329,7330,7331,7332,7333,7334,7335,7336,7337,7338,7339,7340,7341,7342,7343,7344,7345,7346,7347,7348,7349,7350,7351,7352,7353,7354,7355,7356,7357,7358,7359,7360,7361,7362,7363,7364,7365,7366,7367,7368,7369,7370,7371,7372,7373,7374,7375,7376,7377,7378,7379,7380,7381,7382,7383,7384,7385,7386,7387,7388,7389,7390,7391,7392,7393,7394,7395,7396,7397,7398,7399,7400,7401,7402,7403,7404,7405,7406,7407,7408,7409,7410,7411,7412,7413,7414,7415,7416,7417,7418,7419,7420,7421,7422],"revision_id":1762878},"mentions":[{"id":"c-nanqishu-054-recluses-complete:p051:m0002","start":2,"end":3,"surface":"虯","kind":"person","person_id":"rp9_3uw_714","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p051:m0062","start":62,"end":63,"surface":"虯","kind":"person","person_id":"rp9_3uw_714","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-054-recluses-complete","book_id":"b-nanqishu-054","work_id":"w-nanqishu","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:p052","text":"　　劉昭與虯同宗。州辟祭酒從事，不就。隱居山中。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":134,"last_line":134,"raw_start":7425,"raw_end":7449,"raw_character_offsets":[7425,7426,7427,7428,7429,7430,7431,7432,7433,7434,7435,7436,7437,7438,7439,7440,7441,7442,7443,7444,7445,7446,7447,7448],"revision_id":1762878},"mentions":[{"id":"c-nanqishu-054-recluses-complete:p052:m0002","start":2,"end":4,"surface":"劉昭","kind":"person","person_id":"0bk_2xn_akj","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p052:m0005","start":5,"end":6,"surface":"虯","kind":"person","person_id":"rp9_3uw_714","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-054-recluses-complete","book_id":"b-nanqishu-054","work_id":"w-nanqishu","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:p059","text":"　　頃之，測送弟喪還西，仍留舊宅永業寺，絕賔友，唯與同志庾易、劉虯、宗人尚之等往來講說。刺史隨王子隆至鎮，遣別駕宗哲致勞問，測笑曰：「貴賤理隔，何以及此。」竟不答。建武二年，徵爲司徒主簿，不就，卒。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":152,"last_line":152,"raw_start":8160,"raw_end":8259,"raw_character_offsets":[8160,8161,8162,8163,8164,8165,8166,8167,8168,8169,8170,8171,8172,8173,8174,8175,8176,8177,8178,8179,8180,8181,8182,8183,8184,8185,8186,8187,8188,8189,8190,8191,8192,8193,8194,8195,8196,8197,8198,8199,8200,8201,8202,8203,8204,8205,8206,8207,8208,8209,8210,8211,8212,8213,8214,8215,8216,8217,8218,8219,8220,8221,8222,8223,8224,8225,8226,8227,8228,8229,8230,8231,8232,8233,8234,8235,8236,8237,8238,8239,8240,8241,8242,8243,8244,8245,8246,8247,8248,8249,8250,8251,8252,8253,8254,8255,8256,8257,8258],"revision_id":1762878},"mentions":[{"id":"c-nanqishu-054-recluses-complete:p059:m0005","start":5,"end":6,"surface":"測","kind":"person","person_id":"ou7_kzk_fb6","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p059:m0028","start":28,"end":30,"surface":"庾易","kind":"person","person_id":"e3g_qwe_o7m","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p059:m0031","start":31,"end":33,"surface":"劉虯","kind":"person","person_id":"rp9_3uw_714","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p059:m0036","start":36,"end":38,"surface":"尚之","kind":"person","person_id":"qti_nn7_0v2","status":"contextual_provisional"},{"id":"c-n