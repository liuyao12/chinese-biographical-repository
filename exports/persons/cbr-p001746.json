n:m052-0020"],"paragraph_ids":["c-shiji-039-jin:p052"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-039-jin"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-039-jin:m052-0020","start":20,"end":22,"surface":"叔劉","kind":"person","person_id":"cbr-p001746","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p052","chapter_id":"c-shiji-039-jin"}],"relations":[{"id":"a-shiji039-041","subject_person_id":"cbr-p001746","predicate":"father","object_person_id":"cbr-p000252","status":"source_attested","evidence":[{"chapter_id":"c-shiji-039-jin","source_id":"s-shiji-039-jin","paragraph_id":"c-shiji-039-jin:p052","quote":"狄伐咎如，得二女：以長女妻重耳，生伯鯈、叔劉；以少女妻趙衰，生盾。居狄五歳而晉獻公卒，裏克已殺奚齊、悼子，乃使人迎，欲立重耳。重耳畏殺，因固謝，不敢入。已而晉更迎其弟夷吾立之，是爲惠公。惠公七年，畏重耳，乃使宦者履鞮與壯士欲殺重耳。重耳聞之，乃謀趙衰等曰：「始吾奔狄，非以爲可用與，以近易通，故且休足。休足久矣，固願徙之大國。夫齊桓公好善，志在霸王，收恤諸侯。今聞管仲、隰朋死，此亦欲得賢佐，盍往乎？」於是遂行。重耳謂其妻曰：「待我二十五年不來，乃嫁。」其妻笑曰：「犁二十五年，吾冢上柏大矣。雖然，妾待子。」重耳居狄凡十二年而去。"}],"qualifiers":{"source_term":"生伯鯈、叔劉","historicity":"historical_tradition"},"interpretation_note":"保存本段明示親屬或生育敘事；不由繼位補父子，不補闕代。母、女弟、庶孫等依原文；人物暫同指及不同篇主張仍待覆核。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji039-043","subject_person_id":"cbr-p001746","predicate":"mother","object_person_id":"cbr-p001744","status":"source_attested","evidence":[{"chapter_id":"c-shiji-039-jin","source_id":"s-shiji-039-jin","paragraph_id":"c-shiji-039-jin:p052","quote":"狄伐咎如，得二女：以長女妻重耳，生伯鯈、叔劉；以少女妻趙衰，生盾。居狄五歳而晉獻公卒，裏克已殺奚齊、悼子，乃使人迎，欲立重耳。重耳畏殺，因固謝，不敢入。已而晉更迎其弟夷吾立之，是爲惠公。惠公七年，畏重耳，乃使宦者履鞮與壯士欲殺重耳。重耳聞之，乃謀趙衰等曰：「始吾奔狄，非以爲可用與，以近易通，故且休足。休足久矣，固願徙之大國。夫齊桓公好善，志在霸王，收恤諸侯。今聞管仲、隰朋死，此亦欲得賢佐，盍往乎？」於是遂行。重耳謂其妻曰：「待我二十五年不來，乃嫁。」其妻笑曰：「犁二十五年，吾冢上柏大矣。雖然，妾待子。」重耳居狄凡十二年而去。"}],"qualifiers":{"source_term":"生伯鯈、叔劉","historicity":"historical_tradition"},"interpretation_note":"保存本段明示親屬或生育敘事；不由繼位補父子，不補闕代。母、女弟、庶孫等依原文；人物暫同指及不同篇主張仍待覆核。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_asserti