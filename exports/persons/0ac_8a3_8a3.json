ons":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-jin043-guoshu-simabiao","person_id":"0ac_8a3_8a3","surfaces":["司馬彪"],"scope":"cross_chapter","chapter_ids":["c-jinshu-043-guoshu","c-sanguozhi-015-pei-simabiao-xuzhuan"],"status":"contextual_provisional","confidence_level":"moderate","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-043","source_id":"s-jinshu-043-ws2618531-guoshu","chapter_id":"c-jinshu-043-guoshu","paragraph_id":"c-jinshu-043-guoshu:p001","quote":"郭舒，字稚行。幼請其母從師，歲餘便歸，粗識大義。鄉人少府范晷、宗人武陵太守郭景，咸稱舒當為後來之秀，終成國器。始為領軍校尉，坐擅放司馬彪，系廷尉，世多義之。刺史夏侯含辟為西曹，轉主簿。含坐事，舒自系理含，事得釋。刺史宗岱命為治中，喪母去職。劉弘牧荊州，引為治中。弘卒，舒率將士推弘子璠為主，討逆賊郭勱。滅之，保全一州。"},{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-015","source_id":"s-sanguozhi-015-pei-simabiao-xuzhuan","chapter_id":"c-sanguozhi-015-pei-simabiao-xuzhuan","paragraph_id":"c-sanguozhi-015-pei-simabiao-xuzhuan:line023-pei-note","quote":"司馬彪序傳曰：朗祖父雋，字元異，博學好古，倜儻有大度。長八尺三寸，腰帶十圍，儀狀魁岸，與眾有異，鄉黨宗族咸景附焉。位至穎川太守。父防，字建公，性質直公方，雖閑居宴處，威儀不忒。雅好《漢書名臣列傳》，所諷誦者數十萬言。少仕州郡，歷官洛陽令、京兆尹，以年老轉拜騎都尉。養志閭巷，闔門自守。諸子雖冠成人，不命曰進不敢進，不命曰坐不敢坐，不指有所問不敢言，父子之間肅如也。年七十一，建安二十四年終。有子八人，朗最長，次即晉宣皇帝也。"}],"rationale":"既存SGZ015署名司馬彪序傳；另實讀082完整三段史家司馬彪，泰始宮廷任職至惠帝末，與郭舒初仕、劉弘之前受放的西晉同名人物背景相容。首選同人為有資格上下文判斷，082未明擅放事件，不能稱獨立事件證實，不加其父祖或字。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null,"external_reference_file":"source-evidence/jin043-guoshu-source/identity-review.json"},{"id":"d-phase6-kuai-15-0ac_8a3_8a3","person_id":"0ac_8a3_8a3","surfaces":["司馬彪"],"scope":"same_chapter","chapter_ids":["c-sanguozhi-015-pei-simabiao-xuzhuan"],"status":"contextual_provisional","confidence_level":"moderate","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-015","source_id":"s-sanguozhi-015-pei-simabiao-xuzhuan","chapter_id":"c-sanguozhi-015-pei-simabiao-xuzhuan","paragraph_id":"c-sanguozhi-015-pei-simabiao-xuzhuan:line023-pei-note","quote":"司馬彪序傳曰：朗祖父雋，字元異，博學好古，倜儻有大度。長八尺三寸，腰帶十圍，儀狀魁岸，與眾有異，鄉黨宗族咸景附焉。位至穎川太守。父防，字建公，性質直公方，雖閑居宴處，威儀不忒。雅好《漢書名臣列傳》，所諷誦者數十萬言。少仕州郡，歷官洛陽令、京兆尹，以年老轉拜騎都尉。養志閭巷，闔門自守。諸子雖冠成人，不命曰進不敢進，不命曰坐不敢坐，不指有所問不敢言，父子之間肅如也。年七十一，建安二十四年終。有子八人，朗最長，次即晉宣皇帝也。","person_mention_id":"c-sanguozhi-015-pei-simabiao-xuzhuan:line023-pei-note:m0000"}],"rationale":"宣帝字仲達及朗字伯達、安平獻王孚、宣帝弟馗與既有完整原段接合；雋/儁依元異及防父子鏈，保存異字。單字通不是蒯通等其他同名人物。","references":[],"reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-043-guoshu:p001","text":"郭舒，字稚行。幼請其母從師，歲餘便歸，粗識大義。鄉人少府范晷、宗人武陵太守郭景，咸稱舒當為後來之秀，終成國器。始為領軍校尉，坐擅放司馬彪，系廷尉，世多義之。刺史夏侯含辟為西曹，轉主簿。含坐事，舒自系理含，事得釋。刺史宗岱命為治中，喪母去職。劉弘牧荊州，引為治中。弘卒，舒率將士推弘子璠為主，討逆賊郭勱。滅之，保全一州。","text_layer":"received_chapter","mentions":[{"id":"c-jinshu-043-guoshu:p001:m0000","kind":"person","start":0,"end":2,"surface":"郭舒","person_id":"7mp_r23_bds","status":"contextual_provisional","resolution_note":"完整敘事內的具名/省稱/字稱，原字保留；同指理由見逐人identity-review。"},{"id":"c-jinshu-043-guoshu:p001:m0004","kind":"person","start":4,"end":6,"surface":"稚行","person_id":"7mp_r23_bds","status":"contextual_provisional","resolution_note":"完整敘事內的具名/省稱/字稱，原字保留；同指理由見逐人identity-review。"},{"id":"c-jinshu-043-guoshu:p001:m0009","kind":"person","start":9,"end":10,"surface":"其","person_id":"7mp_r23_bds","status":"contextual_provisional","resolution_note":"郭舒幼請其母允從師；其指舒，不說母親自己從師。"},{"id":"c-jinshu-043-guoshu:p001:m0010","kind":"person","start":10,"end":11,"surface":"母","person_id":"rti_58l_owd","status":"contextual_provisional","resolution_note":"完整敘事內的具名/省稱/字稱，原字保留；同指理由見逐人identity-review。"},{"id":"c-jinshu-043-guoshu:p001:m0028","kind":"person","start":28,"end":30,"surface":"范晷","person_id":"l2s_rie_oc9","status":"contextual_provisional","resolution_note":"完整敘事內的具名/省稱/字稱，原字保留；同指理由見逐人identity-review。"},{"id":"c-jinshu-043-guoshu:p001:m0037","kind":"person","start":37,"end":39,"surface":"郭景","person_id":"cwu_1i7_9wa","status":"contextual_provisional","resolution_note":"完整敘事內的具名/省稱/字稱，原字保留；同指理由見逐人identity-review。"},{"id":"c-jinshu-