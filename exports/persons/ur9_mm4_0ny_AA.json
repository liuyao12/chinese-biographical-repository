ons":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-042-jiangshi-near-family-rendered:p003","text":"上寢疾，永泰元年，轉祏爲侍中、中書令，出入殿省。上崩，遺詔轉右僕射，祏弟衞尉祀爲侍中，敬皇后弟劉暄爲衞尉。東昏卽位，參掌選事。高宗雖顧命羣公，而意寄多在祏兄弟。至是更直殿內，動止關諮。永元元年，領太子詹事。劉暄遷散騎常侍，右衞將軍。祏兄弟與暄及始安王遙光、尚書令徐孝嗣、領軍蕭坦之六人，更日帖敕，時呼爲「六貴」。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-nanqishu-042-jiangshi-near-family-rendered:p003:m0001","start":0,"end":1,"surface":"上","kind":"person","person_id":"z5d_9zy_u5h_B","status":"contextual_provisional"},{"id":"c-nanqishu-042-jiangshi-near-family-rendered:p003:m0002","start":10,"end":11,"surface":"祏","kind":"person","person_id":"qfs_t8x_ez4_AA","status":"contextual_provisional"},{"id":"c-nanqishu-042-jiangshi-near-family-rendered:p003:m0003","start":24,"end":25,"surface":"上","kind":"person","person_id":"z5d_9zy_u5h_B","status":"contextual_provisional"},{"id":"c-nanqishu-042-jiangshi-near-family-rendered:p003:m0004","start":34,"end":35,"surface":"祏","kind":"person","person_id":"qfs_t8x_ez4_AA","status":"contextual_provisional"},{"id":"c-nanqishu-042-jiangshi-near-family-rendered:p003:m0005","start":38,"end":39,"surface":"祀","kind":"person","person_id":"qfs_t8x_ez4_AB","status":"contextual_provisional"},{"id":"c-nanqishu-042-jiangshi-near-family-rendered:p003:m0006","start":43,"end":46,"surface":"敬皇后","kind":"person","person_id":"q46_fom_xor_AA","status":"contextual_provisional"},{"id":"c-nanqishu-042-jiangshi-near-family-rendered:p003:m0007","start":47,"end":49,"surface":"劉暄","kind":"person","person_id":"q46_fom_xor_AB","status":"contextual_provisional"},{"id":"c-nanqishu-042-jiangshi-near-family-rendered:p003:m0008","start":53,"end":55,"surface":"東昏","kind":"person","person_id":"z5d_9zy_u5h_BA","status":"contextual_provisional"},{"id":"c-nanqishu-042-jiangshi-near-family-rendered:p003:m0009","start":63,"end":65,"surface":"高宗","kind":"person","person_id":"z5d_9zy_u5h_B","status":"contextual_provisional"},{"id":"c-nanqishu-042-jiangshi-near