d_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"id":"name-chenshu013-guoyuanjian","person_id":"a51_3l4_jsf","surname":"郭","ming":"元建","chapter_id":"c-chenshu-013-xunlang-rendered","paragraph_id":"c-chenshu-013-xunlang-rendered:p002","person_mention_id":"c-chenshu-013-xunlang-rendered:p002:m0025","source_anchor":{"paragraph_id":"c-chenshu-013-xunlang-rendered:p002","start":192,"end":194,"surface":"元建"},"quote":"朗少慷慨，有將帥大略，起家梁廬陵王行參軍。侯景之亂，朗招率徒旅，據巢湖閒，無所屬。臺城陷後，簡文帝密詔授朗雲麾將軍、豫州刺史，令與外藩討景。景使儀同宋子仙、任約等頻往征之，朗據山立砦自守，子仙不能克。時京師大饑，百姓皆於江外就食，朗更招致部曲，解衣推食，以相賑贍，眾至數萬人。侯景敗於巴陵，朗出自濡須截景，破其後軍。王僧辯東討，朗遣其將范寶勝及弟曉領兵二千助之。侯景平後，又別破齊將郭元建於踟躕山。梁承聖二年，率部曲萬餘家濟江，入宣城郡界立頓。梁元帝授朗持節、通直散騎常侍、安南將軍、都督南兗州諸軍事、南兗州刺史。未行而荊州陷。","additional_names":[],"status":"contextual_provisional","human_reviewed":false,"model":null,"work_id":"w-chenshu","book_id":"b-chenshu-013","source_id":"s-chenshu-013-ws1511906-rendered-xunlang"}],"mentions":[{"id":"c-chenshu-013-xunlang-rendered:p002:m0025","kind":"person","person_id":"a51_3l4_jsf","start":191,"end":194,"surface":"郭元建","status":"contextual_provisional","paragraph_id":"c-chenshu-013-xunlang-rendered:p002","chapter_id":"c-chenshu-013-xunlang-rendered"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-chenshu013-guoyuanjian","person_id":"a51_3l4_jsf","scope":"same_chapter","chapter_ids":["c-chenshu-013-xunlang-rendered"],"surfaces":["郭元建"],"status":"contextual_provisional","rationale":"郭元建／元建未召回；原稱齊將與踟躕山事件保存，不接近字元帝等人。","evidence":[{"work_id":"w-chenshu","book_id":"b-chenshu-013","chapter_id":"c-chenshu-013-xunlang-rendered","source_id":"s-chenshu-013-ws1511906-rendered-xunlang","paragraph_id":"c-chenshu-013-xunlang-r