rt":7,"end":9,"surface":"元嗣","kind":"person","person_id":"065_f96_121","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-049-zhangchong","book_id":"b-nanqishu-049","work_id":"w-nanqishu","source_id":"s-nanqishu-049-zhangchong-ws2261984"},{"id":"c-nanqishu-049-zhangchong:p012","text":"東昏以程茂爲督郢司二州、輔國將軍、郢州刺史，元嗣爲督雍梁南北秦四州郢州之竟陵司州之隨郡、冠軍將軍、雍州刺史，竝持節。時郢魯二城已降，死者相積，竟無叛散。時以沖及房僧寄比臧洪之被圍也。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":70,"last_line":70,"raw_start":4741,"raw_end":4832,"raw_character_offsets":[4741,4742,4743,4744,4745,4746,4747,4748,4749,4750,4751,4752,4753,4754,4755,4756,4757,4758,4759,4760,4761,4762,4763,4764,4765,4766,4767,4768,4769,4770,4771,4772,4773,4774,4775,4776,4777,4778,4779,4780,4781,4782,4783,4784,4785,4786,4787,4788,4789,4790,4791,4792,4793,4794,4795,4796,4797,4798,4799,4800,4801,4802,4803,4804,4805,4806,4807,4808,4809,4810,4811,4812,4813,4814,4815,4816,4817,4818,4819,4820,4821,4822,4823,4824,4825,4826,4827,4828,4829,4830,4831],"revision_id":2261984},"mentions":[{"id":"c-nanqishu-049-zhangchong:p012:m0003","start":3,"end":5,"surface":"程茂","kind":"person","person_id":"08a_56f_ca2","status":"contextual_provisional"},{"id":"c-nanqishu-049-zhangchong:p012:m0022","start":22,"end":24,"surface":"元嗣","kind":"person","person_id":"065_f96_121","status":"contextual_provisional"},{"id":"c-nanqishu-049-zhangchong:p012:m0078","start":78,"end":79,"surface":"沖","kind":"person","person_id":"d50_8f5_wul_AAACBB","status":"contextual_provisional"},{"id":"c-nanqishu-049-zhangchong:p012:m0080","start":80,"end":83,"surface":"房僧寄","kind":"person","person_id":"d61_8b9_780","status":"contextual_provisional"},{"id":"c-nanqishu-049-zhangchong:p012:m0084","start":84,"end":86,"surface":"臧洪","kind":"person","person_id":"fru_3sq_vzd","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-049-zhangchong","book_id":"b-nanqishu-049","work_id":"w-nanqishu","source_id":"s-nanqishu-049-zhangchong-ws2261984"}],"sources":[{"cha