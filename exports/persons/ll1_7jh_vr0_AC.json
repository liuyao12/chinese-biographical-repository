_status":"source_attested"},{"person_id":"ll1_7jh_vr0_AC","person_mention_id":"c-jinshu-032-zheng-achun-family:zheng-marriages:p001:m0198","source_term":"第三者","ordinal":3,"position":"unspecified","interpretation_status":"source_attested"},{"person_id":"ll1_7jh_vr0_AD","person_mention_id":"c-jinshu-032-zheng-achun-family:zheng-marriages:p001:m0203","source_term":"小者","ordinal":null,"position":"youngest","interpretation_status":"contextual_provisional"}]},"relative_birth_order":{"older_person_id":"ll1_7jh_vr0_AA","younger_person_id":"ll1_7jh_vr0_AC","operator":"lt","scope":"siblings","older_ordinal":1,"younger_ordinal":3,"ordinal_scope":"reported_sibling_group","group_id":"sg-jinshu032-zheng-four-sisters","older_position":"eldest","younger_position":"unspecified"}},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-032","chapter_id":"c-jinshu-032-zheng-achun-family","source_id":"s-jinshu-032-zheng-achun-family","paragraph_id":"c-jinshu-032-zheng-achun-family:zheng-marriages:p001","quote":"后少孤，無兄弟，唯姊妹四人，后最長。先適渤海田氏，生一男而寡，依于舅濮陽吳氏。元帝為丞相，敬后先崩，將納吳氏女為夫人。后及吳氏女並游後園，或見之，言於帝曰：「鄭氏女雖嫠，賢於吳氏遠矣。」建武元年，納為琅邪王夫人，甚有寵。后雖貴幸，而恒有憂色。帝問其故，對曰：「妾有妹，中者已適長沙王褒，餘二妹未有所適，恐姊為人妾，無復求者。」帝因從容謂劉隗曰：「鄭氏二妹，卿可為求佳對，使不失舊。」隗舉其從子傭娶第三者，以小者適漢中李氏，皆得舊門。帝召王褒為尚書郎，以悅后意。后生琅邪悼王、簡文帝、尋陽公主。帝稱尊號，后雖為夫人，詔太子及東海、武陵王皆母事之。帝崩，后稱建平國夫人。","subject_person_mention_id":"c-jinshu-032-zheng-achun-family:zheng-marriages:p001:m0198","object_person_mention_id":"c-jinshu-032-zheng-achun-family:zheng-marriages:p001:m0000"}],"interpretation_note":"按四姊妹及中者、第三者、小者逐人辨識；父愷由阿春同父姊妹推導，不造獨立父字原句。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"a-jinshu-032-marriage-kin-014","subject_person_id":"ll1_7jh_vr0_AC","predicate":"spouse","object_person_id":"quo_wok_i8z","status":"source_attested","qualifiers":{"source_term":"從子傭娶第三者"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-032","chapter_id":"c-jinshu-032-zheng-achun-family","source_id":"s-jinshu-032-zheng-achun-family","paragraph_id":"c-jinshu-032-zheng-achun-family:zheng-marriages:p001","quote":"后少孤，無兄弟，唯姊妹四人，后最長。先適渤海田氏，生一男而寡，依于舅濮陽吳氏。元帝為丞相，敬后先崩，將納吳氏女為夫人。后及吳氏女並游後園，或見之，言於帝曰：「鄭氏女雖嫠，賢於吳氏遠矣。」建武元年，納為琅邪王夫人，甚有寵。后雖貴幸，而恒有憂色。帝問其故，對曰：「妾有妹，中者已適長沙王褒，餘二妹未有所適，恐姊為人妾，無復求者。」帝因從容謂劉隗曰：「鄭氏二妹，卿可為求佳對，使不失舊。」隗舉其從子傭娶第三者，以小者適漢中李氏，皆得舊門。帝召王褒為尚書郎，以悅后意。后生琅邪悼王、簡文帝、尋陽公主。帝稱尊號，后雖為夫人，詔太子及東海、武陵王皆母事之。帝崩，后稱建平國夫人。","subject_person_mention_id":"c-jinshu-032-zheng-achun-family:zheng-marriages:p001:m0198","object_person_mention_id":"c-jinshu-032-zheng-achun-family:zheng-marriages:p001:m0196"}],"interpretation_note":"適或娶明示實際婚姻；長沙是王褒的地望，不是長沙王爵。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"person_id":"ll1_7jh_vr0_AC","title":null,"surname":"鄭","ming":null,"additional_names":[],"work_id":"w-jinshu","book_id":"b-jinshu-032","chapter_id":"c-jinshu-032-zheng-achun-family","source_id":"s-jinshu-032-zheng-achun-family","paragraph_id":"c-jinshu-032-zheng-achun-family:zheng-marriages:p001","quote":"后少孤，無兄弟，唯姊妹四人，后最長。先適渤海田氏，生一男而寡，依于舅濮陽吳氏。元帝為丞相，敬后先崩，將納吳氏女為夫人。后及吳氏女並游後園，或見之，言於帝曰：「鄭氏女雖嫠，賢於吳氏遠矣。」建武元年，納為琅邪王夫人，甚有寵。后雖貴幸，而恒有憂色。帝問其故，對曰：「妾有妹，中者已適長沙王褒，餘二妹未有所適，恐姊為人妾，無復求者。」帝因從容謂劉隗曰：「鄭氏二妹，卿可為求佳對，使不失舊。」隗舉其從子傭娶第三者，以小者適漢中李氏，皆得舊門。帝召王褒為尚書郎，以悅后意。后生琅邪悼王、簡文帝、尋陽公主。帝稱尊號，后雖為夫人，詔太子及東海、武陵王皆母事之。帝崩，后稱建平國夫人。","status":"editorial_provisional","human_reviewed":false,"model":null,"note":"依鄭阿春姊妹四人敘事，及綁定阿春的鄭氏女原稱暫取鄭氏氏稱；是編輯推導，不冒稱本名或原文明書每妹鄭氏。名、字、年月均未補。","clan_style":{"value":"鄭氏","kind":"source_sibling_group_appellation","source_term":"姊妹四人","assertion_ids":["a-jinshu-032-marriage-kin-013"],"status":"editorial_provisional","rationale":"依鄭阿春姊妹四人敘事，及綁定阿春的鄭氏女原稱暫取鄭氏氏稱；是編輯推導，不冒稱本名或原文明書每妹鄭氏。名、字、年月均未補。","human_reviewed":false}}],"mentions":[{"id":"c-jinshu-032-zheng-achun-family:zheng-marriages:p001:m0198","start":198,"end":201,"surface":"第三者","kind":"person","person_id":"ll1_7jh_vr0_AC","status":"contextual_provisional"