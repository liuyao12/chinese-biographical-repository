{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p002255","identity_policy":"contextual_provisional","person_ids":["cbr-p002255"],"persons":[{"id":"cbr-p002255","label":"驪姬（趙世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"驪姬","mention_ids":["c-shiji-043-zhao:m010-0032"]}],"evidence":[{"mention_id":"c-shiji-043-zhao:m010-0032","chapter_id":"c-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p010","quote":"驪姬"}]}],"mentions":[{"id":"c-shiji-043-zhao:m010-0032","start":32,"end":34,"surface":"驪姬","kind":"person","person_id":"cbr-p002255","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p010","chapter_id":"c-shiji-043-zhao"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji043-026","person_id":"cbr-p002255","surfaces":["驪姬"],"scope":"same_chapter","chapter_ids":["c-shiji-043-zhao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-043-zhao:p010","quote":"趙衰卜事晉獻公及諸公子，莫吉；卜事公子重耳，吉，卽事重耳。重耳以驪姬之亂亡奔翟，趙衰從。翟伐廧咎如，得二女，翟以其少女妻重耳，長女妻趙衰而生盾。初，重耳在晉時，趙衰妻亦生趙同、趙括、趙嬰齊。趙衰從重耳出亡，凡十九年，得反國。重耳爲晉文公，趙衰爲原大夫，居原，任國政。文公所以反國及霸，多趙衰計策，語在晉事中。"}],"rationale":"限本篇明示名字、是為與連續事件暫接異稱；真孤與替代兒分開，馬匹、群體與闕代不當個人，不以模型記憶補熟知姓名。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-043-zhao:p010","text":"趙衰卜事晉獻公及諸公子，莫吉；卜事公子重耳，吉，卽事重耳。重耳以驪姬之亂亡奔翟，趙衰從。翟伐廧咎如，得二女，翟以其少女妻重耳，長女妻趙衰而生盾。初，重耳在晉時，趙衰妻亦生趙同、趙括、趙嬰齊。趙衰從重耳出亡，凡十九年，得反國。重耳爲晉文公，趙衰爲原大夫，居原，任國政。文公所以反國及霸，多趙衰計策，語在晉事中。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-043-zhao:m010-0000","start":0,"end":2,"surface":"趙衰","kind":"person","person_id":"cbr-p002253","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m010-0004","start":4,"end":7,"surface":"晉獻公","kind":"person","person_id":"cbr-p002249","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m010-0008","start":8,"end":11,"surface":"諸公子","kind"