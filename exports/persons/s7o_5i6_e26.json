extual_provisional"},{"id":"c-jinshu-054-lu-ji:p030:m0281","start":281,"end":282,"surface":"穎","kind":"person","person_id":"x4m_ygm_1d3","status":"contextual_provisional"},{"id":"c-jinshu-054-lu-ji:p030:m0322","start":322,"end":323,"surface":"蔚","kind":"person","person_id":"z3d_bhe_ygx","status":"contextual_provisional"},{"id":"c-jinshu-054-lu-ji:p030:m0324","start":324,"end":325,"surface":"夏","kind":"person","person_id":"j36_26z_9ob","status":"contextual_provisional"},{"id":"c-jinshu-054-lu-ji:p030:m0330","start":330,"end":331,"surface":"機","kind":"person","person_id":"69h_uhy_hta","status":"contextual_provisional"}],"chapter_id":"c-jinshu-054-lu-ji","book_id":"b-jinshu-054","work_id":"w-jinshu","source_id":"s-jinshu-054-lu-ji-ws2605147"},{"id":"c-jinshu-059-prince-yong:p004","text":"左衛將軍陳眕奉天子伐穎，顒又遣方率兵二萬救鄴。天子已幸鄴。方屯兵洛陽。及王浚等伐穎，穎挾天子歸洛陽。方將兵入殿中，逼帝幸其壘，掠府庫，將焚宮廟以絕眾心。盧志諫，乃止。方又逼天子幸長安。顒及選置百官，改秦州為定州。及東海王越起兵徐州，西迎大駕，關中大懼，方謂顒曰：「方所領猶有十餘萬眾，奉送大駕還洛宮，使成都王反鄴，公自留鎮關中，方北討博陵。如此，天下可小安，無復舉手者。」顒慮事大難濟，不許。乃假劉喬節，進位鎮東大將軍，遣成都王穎總統樓褒、王闡等諸軍，據河橋以距越。王浚遣督護劉根，將三百騎至河上。闡出戰，為根所殺。穎頓軍張方故壘，范陽王虓遣鮮卑騎與平昌、博陵眾襲河橋，樓褒西走，追騎至新安，道路死者不可勝數。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":176,"last_line":176,"raw_start":17930,"raw_end":18264,"raw_character_offsets":[17932,17933,17934,17935,17936,17937,17938,17939,17940,17941,17942,17943,17944,17945,17946,17947,17948,17949,17950,17951,17952,17953,17954,17955,17956,17957,17958,17959,17960,17961,17962,17963,17964,17965,17966,17967,17968,17969,17970,17971,17972,17973,17974,17975,17976,17977,17978,17979,17980,17981,17982,17983,17984,17985,17986,17987,17988,17989,17990,17991,17992,17993,17994,17995,17996,17997,17998,17999,18000,18001,18002,18003,18004,18005,18006,18007,18008,18009,18010,18011,18012,18013,18014,18015,18016,18017,18018,18019,18020,18021,18022,18023,18024,18025,18026,18027,18028,18029,18030,18031,18032,18033,18034,18035,18036,18037,18038,18039,18040,18041,18042,18043,18044,18045,18046,18047,18048,18049,18050,18051,180