d":"c-shiji-032-qi"},{"id":"c-shiji-032-qi:m039-0238","start":238,"end":240,"surface":"屈完","kind":"person","person_id":"e2m_g41_b73","status":"contextual_provisional","paragraph_id":"c-shiji-032-qi:p039","chapter_id":"c-shiji-032-qi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[{"id":"shiji-014-r186-c07-m000","start":10,"end":12,"surface":"屈完","person_id":"e2m_g41_b73","status":"contextual_provisional","interpretation_note":"依本格國別、事件與本篇時間範圍核讀的完整名字暫定同指；非全域字串配對，省稱與世襲稱號另行核讀。","table_id":"shiji-014","table_fragment_id":"shiji-014-digital-table-1","table_row_id":"shiji-014-r186","table_cell_id":"shiji-014-r186-c07","work_id":"w-shiji","book_id":"b-shiji-014","chapter_id":"table-chapter-shiji-014","source_id":"table-witness-shiji-014","source_revision":"2607001","kind":"table_person_mention","quote":"十六齊伐我，至陘，使屈完盟。"}],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-032-qi:p039","text":"三十年春，齊桓公率諸侯伐蔡，蔡潰。遂伐楚。楚成王興師問曰：「何故涉吾地？」管仲對曰：「昔召康公命我先君太公曰：『五侯九伯，若實征之，以夾輔周室。』賜我先君履，東至海，西至河，南至穆陵，北至無棣。楚貢包茅不入，王祭不具，是以來責。昭王南征不復，是以來問。」楚王曰：「貢之不入，有之，寡人罪也，敢不共乎！昭王之出不復，君其問之水濱。」齊師進次于陘。夏，楚王使屈完將兵捍齊，齊師退次召陵。桓公矜屈完以其眾。屈完曰：「君以道則可；若不，則楚方城以為城，江、漢以為溝，君安能進乎？」乃與屈完盟而去。過陳，陳袁濤涂詐齊，令出東方，覺。秋，齊伐陳。是歲，晉殺太子申生。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-032-qi:m039-0005","start":5,"end":8,"surface":"齊桓公","kind":"person","person_id":"9w2_c77_53m","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m039-0021","start":21,"end":24,"surface":"楚成王","kind":"person","person_id":"2d3_fsd_1dh","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m039-0037","start":37,"end":39,"surface":"管仲","kind":"person","person_id":"h1v_8ap_b9y","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m039-0044","start":44,"end":47,"surface":"召康公","kind":"person","person_id":"7m7_qvm_4oj","status":"contextual_provisional"},{"id":"c-