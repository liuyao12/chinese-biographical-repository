_role","object_person_id":"009_vr4_220","qualifiers":{"source_term":"獨與母留","source_clause_binding":{"kind":"biography_family_clause","rule":"continued_biography_unassumed_named_recipient_stays_with_mother","roles":{"head":"c-liangshu-015-xiefei:p005:m0098","mother":"c-liangshu-015-xiefei:p005:m0031","ruler":"c-liangshu-015-xiefei:p005:m0041"},"clause_start":0,"clause_end":99,"paragraph_sha256":"98c8c5fc35a6503a32b25c6098ee99bc080ff9b289ce9b1f205562b435f7e09f","revision_id":1506954},"role":"mother_unspecified","biological_mother":null,"father_person_id":null},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-015","source_id":"s-liangshu015-ws1506954","chapter_id":"c-liangshu-015-xiefei","paragraph_id":"c-liangshu-015-xiefei:p005","quote":"建武四年，詔徵爲侍中、中書令，遂抗表不應召。遣諸子還京師，獨與母留，築室郡之西郭。明帝下詔曰：「夫超然榮觀，風流自遠；蹈彼幽人，英華罕值。故長揖楚相，見稱南國；高謝漢臣，取貴良史。新除侍中、中書令朏，早藉羽儀，夙標清尚，登朝樹績，出守馳聲。遂斂跡康衢，拂衣林沚，抱箕潁之餘芳，甘憔悴而無悶。撫事懷人，載留欽想。宜加優禮，用旌素概。可賜床帳褥席，俸以卿祿，常出在所。」時國子祭酒廬江何胤亦抗表還會稽。永元二年，詔徵朏爲散騎常侍、中書監，胤爲散騎常侍、太常卿，並不屈。三年，又詔徵朏爲侍中、太子少傅，胤散騎常侍、太子詹事。時東昏皆下在所，使迫遣之，值義師已近，故並得不到。","subject_person_mention_id":"c-liangshu-015-xiefei:p005:m0098","object_person_mention_id":"c-liangshu-015-xiefei:p005:m0031"}],"interpretation_note":"以召命明名朏回綁前不應召與母留，特定朏母不是𤅢母；未明生母、配偶或本名。"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"status":"source_attested","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null,"id":"le-liang015-xiefei-mother","person_id":"009_vr4_220","event_type":"death","source_term":"母憂","date_expression":"其年","evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-015","source_id":"s-liangshu015-ws1506954","chapter_id":"c-liangshu-015-xiefei","paragraph_id":"c-liangshu-015-xiefei:p008","quote":"三年元會，詔朏乘小輿升殿。其年，遭母憂，尋有詔攝職如故。後五年，改授中書監、司徒、衛將軍，並固讓不受。遣謁者敦授，乃拜受焉。是冬薨於府，時年六十六。輿駕出臨哭，詔給東園秘器，朝服一具，衣一襲，錢十萬，布百匹，蠟百斤。贈侍中、司徒。諡曰靖孝。朏所著書及文章，並行於世。","person_mention_id":"c-liangshu-015-xiefei:p008:m0017"}],"interpretation_note":"本傳三年元會後其年母憂；與本紀四年所生母憂資格另存，未改母角色為生母。"}],"mentions":[{"id":"c-liangshu-015-xiefei:p005:m0031","start":31,"end":32,"surface":"母","kind":"person","person_id":"009_vr4_220","status":"contextual_provisional","interpretation_note":"依完整本傳敘事及身份閱讀記錄逐人辨識；原字不改，非由同字自動合併。","identity_decision_id":"d-liang015-xiefei-mother","paragraph_id":"c-liangshu-015-xiefei:p005","chapter_id":"c-liangshu-015-xiefei"},{"id":"c-liangshu-015-xiefei:p007:m0152","start":152,"end":153,"surface":"母","kind":"person","person_id":"009_vr4_220","status":"contextual_provisional","interpretation_note":"依完整本傳敘事及身份閱讀記錄逐人辨識；原字不改，非由同字自動合併。","identity_decision_id":"d-liang015-xiefei-mother","paragraph_id":"c-liangshu-015-xiefei:p007","chapter_id":"c-liangshu-015-xiefei"},{"id":"c-liangshu-015-xiefei:p008:m0017","start":17,"end":18,"surface":"母","kind":"person","person_id":"009_vr4_220","status":"contextual_provisional","interpretation_note":"依完整本傳敘事及身份閱讀記錄逐人辨識；原字不改，非由同字自動合併。","identity_decision_id":"d-liang015-xiefei-mother","paragraph_id":"c-liangshu-015-xiefei:p008","chapter_id":"c-liangshu-015-xiefei"}],"relations":[{"status":"source_attested","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null,"id":"a-liang015-xiefei-mother","subject_person_id":"aa6_83c_juy_DBABAB","predicate":"maternal_role","object_person_id":"009_vr4_220","qualifiers":{"source_term":"獨與母留","source_clause_binding":{"kind":"biography_family_clause","rule":"continued_biography_unassumed_named_recipient_stays_with_mother","roles":{"head":"c-liangshu-015-xiefei:p005:m0098","mother":"c-liangshu-015-xiefei:p005:m0031","ruler":"c-liangshu-015-xiefei:p005:m0041"},"clause_start":0,"clause_end":99,"paragraph_sha256":"98c8c5fc35a6503a32b25c6098ee99bc080ff9b289ce9b1f205562b435f7e09f","revision_id":1506954},"role":"mother_unspecified","biological_mother":null,"father_person_id":null},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-015","source_id":"s-liangshu015-ws1506954","chapter_id":"c-liangshu-015-xiefei","paragraph_id":"c-liangshu-015-xiefei:p005","quote":"建武四年，詔徵爲侍中、中書令，遂抗表不應召。遣諸子還京師，獨與母留，築室郡之西郭。明帝下詔曰：「夫超然榮觀，風流自遠；蹈彼幽人，英華罕值。故長揖楚相，見稱南國；高謝漢臣，取貴良史。新除侍中、中書令朏，早藉羽儀，夙標清尚，登朝樹績，出守馳聲。遂斂跡康衢，拂衣林沚，抱箕潁之餘芳，甘憔悴而無悶。撫事懷人，載留欽想。宜加優禮，用旌素概。可賜床帳褥席，俸以卿祿，常出在所。」時國子祭酒廬江何胤亦抗表還會稽。永元二年，詔徵朏爲散騎常侍、中書監，胤爲散騎常侍、太常卿，並不屈。三年，又詔徵朏爲侍中、太子少傅，胤散騎常侍、太子詹事。時東昏皆下在所，使迫遣之，值義師已近，故並得不到。","subject_person_mention_id":"c-liangshu-015-xiefei:p005:m0098","object_person_mention_id":"c-liangshu-015-xiefei:p005:m0031"}],"interpretation_note":"以召命明名朏回綁前不應召與母留，特定朏母不是𤅢母；未明生母、配偶或本名。"}],"title_holdings":[],"address_assertions":[{"status":"source_attested","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null,"id":"pa-liang015-xiefei-mother-west","person_id":"009_vr4_220","relation":"residence","place":{"source_name":"郡之西郭","place_id":null,"modern_identification":null},"source_term":"獨與母留，築室郡之西郭","date_expression":null,"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-015","source_id":"s-liangshu015-ws1506954","chapter_id":"c-liangshu-015-xiefei","paragraph_id":"c-liangshu-015-xiefei:p005","quote":"建武四年，詔徵爲侍中、中書令，遂抗表不應召。遣諸子還京師，獨與母留，築室郡之西郭。明帝下詔曰：「夫超然榮觀，風流自遠；蹈彼幽人，英華罕值。故長揖楚相，見稱南國；高謝漢臣，取貴良史。新除侍中、中書令朏，早藉羽儀，夙標清尚，登朝樹績，出守馳聲。遂斂跡康衢，拂衣林沚，抱箕潁之餘芳，甘憔悴而無悶。撫事懷人，載留欽想。宜加優禮，用旌素概。可賜床帳褥席，俸以卿祿，常出在所。」時國子祭酒廬江何胤亦抗表還會稽。永元二年，詔徵朏爲散騎常侍、中書監，胤爲散騎常侍、太常卿，並不屈。三年，又詔徵朏爲侍中、太子少傅，胤散騎常侍、太子詹事。時東昏皆下在所，使迫遣之，值義師已近，故並得不到。","person_mention_id":"c-liangshu-015-xiefei:p005:m0031"}],"interpretation_note":"母隨朏留郡西郭，來源相對地稱；吳興為前官上下文，不補今地。"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-liang015-xiefei-mother","person_id":"009_vr4_220","surfaces":["母"],"scope":"same_chapter","chapter_ids":["c-liangshu-015-xiefei"],"status":"contextual_provisional","evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-015","chapter_id":"c-liangshu-015-xiefei","source_id":"s-liangshu015-ws1506954","paragraph_id":"c-liangshu-015-xiefei:p005","quote":"建武四年，詔徵爲侍中、中書令，遂抗表不應召。遣諸子還京師，獨與母留，築室郡之西郭。明帝下詔曰：「夫超然榮觀，風流自遠；蹈彼幽人，英華罕值。故長揖楚相，見稱南國；高謝漢臣，取貴良史。新除侍中、中書令朏，早藉羽儀，夙標清尚，登朝樹績，出守馳聲。遂斂跡康衢，拂衣林沚，抱箕潁之餘芳，甘憔悴而無悶。撫事懷人，載留欽想。宜加優禮，用旌素概。可賜床帳褥席，俸以卿祿，常出在所。」時國子祭酒廬江何胤亦抗表還會稽。永元二年，詔徵朏爲散騎常侍、中書監，胤爲散騎常侍、太常卿，並不屈。三年，又詔徵朏爲侍中、太子少傅，胤散騎常侍、太子詹事。時東昏皆下在所，使迫遣之，值義師已近，故並得不到。"},{"work_id":"w-liangshu","book_id":"b-liangshu-015","chapter_id":"c-liangshu-015-xiefei","source_id":"s-liangshu015-ws1506954","paragraph_id":"c-liangshu-015-xiefei:p007","quote":"高祖踐阼，徵朏爲侍中、左光祿大夫、開府儀同三司，胤散騎常侍、特進、右光祿大夫，又並不屈。仍遣領軍司馬王果宣旨敦譬。明年六月，朏輕舟出，詣闕自陳。旣至，詔以爲侍中、司徒、尚書令。朏辭腳疾不堪拜謁，乃角巾肩輿，詣雲龍門謝。詔見於華林園，乘小車就席。明旦，輿駕出幸朏宅，醼語盡歡。朏固陳本志，不許；因請自還東迎母，乃許之。臨發，輿駕復臨幸，賦詩餞別。王人送迎，相望於道。到京師，勑材官起府於舊宅，高祖臨軒，遣謁者於府拜授，詔停諸公事及朔望朝謁。"},{"work_id":"w-liangshu","book_id":"b-liangshu-015","chapter_id":"c-liangshu-015-xiefei","source_id":"s-liangshu015-ws1506954","paragraph_id":"c-liangshu-015-xiefei:p008","quote":"三年元會，詔朏乘小輿升殿。其年，遭母憂，尋有詔攝職如故。後五年，改授中書監、司徒、衛將軍，並固讓不受。遣謁者敦授，乃拜受焉。是冬薨於府，時年六十六。輿駕出臨哭，詔給東園秘器，朝服一具，衣一襲，錢十萬，布百匹，蠟百斤。贈侍中、司徒。諡曰靖孝。朏所著書及文章，並行於世。"}],"rationale":"建武四年朏獨與母留、梁初請迎母及其年遭母憂，連貫同一朏的特定未名母角色。與𤅢母是否同一未有明示，不因四兄弟而合，不推生母、配偶或本名。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null}],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-015-xiefei:p005","unit_id":"xiefei-complete","text":"建武四年，詔徵爲侍中、中書令，遂抗表不應召。遣諸子還京師，獨與母留，築室郡之西郭。明帝下詔曰：「夫超然榮觀，風流自遠；蹈彼幽人，英華罕值。故長揖楚相，見稱南國；高謝漢臣，取貴良史。新除侍中、中書令朏，早藉羽儀，夙標清尚，登朝樹績，出守馳聲。遂斂跡康衢，拂衣林沚，抱箕潁之餘芳，甘憔悴而無悶。撫事懷人，載留欽想。宜加優禮，用旌素概。可賜床帳褥席，俸以卿祿，常出在所。」時國子祭酒廬江何胤亦抗表還會稽。永元二年，詔徵朏爲散騎常侍、中書監，胤爲散騎常侍、太常卿，並不屈。三年，又詔徵朏爲侍中、太子少傅，胤散騎常侍、太子詹事。時東昏皆下在所，使迫遣之，值義師已近，故並得不到。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","source_position":{"first_line":19,"last_line":19,"revision_id":1506954,"editorial_excerpt_boundary":true},"mentions":[{"id":"c-liangshu-015-xiefei:p005:m0023","start":23,"end":25,"surface":"諸子","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"未名角色／引古或群體，保留來源錨點，候選與限制另見review。"},{"id":"c-liangshu-015-xiefei:p005:m0031","start":31,"end":32,"surface":"母","kind