ll:l112:m0000","quote_passage_ref":"data/corpus/jinshu/039.json"}]}}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[{"era":"CE","era_year":324,"year":324,"year_numbering":"astronomical","precision":"year","calendar":"chinese_civil","source_expression":"太寧二年","status":"editorial_provisional","original_quote":"闓字道明，亦有名稱，京都為之語曰：「洛中英英荀道明。」大司馬、齊王冏辟為掾。冏敗，暴屍已三日，莫敢收葬。闓與冏故吏李述、嵇含等露板請葬，朝議聽之，論者稱焉。為太傅主簿、中書郎。與邃俱渡江，拜丞相軍諮祭酒。中興建，遷右軍將軍，轉少府。明帝嘗從容問王暠曰：「二荀兄弟孰賢？」暠答以闓才明過邃。帝以語庾亮，亮曰：「邃真粹之地，亦闓所不及。」由是議者莫能定其兄弟優劣。歷御史中丞、侍中、尚書，封射陽公。太寧二年卒，追贈衛尉，諡曰定。子達嗣。","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-039","source_id":"s-jinshu-039-wangxun-feng","chapter_id":"c-jinshu-039-wangxun-feng","paragraph_id":"c-jinshu-039-wangxun-feng:xu-full:l112","person_mention_id":"c-jinshu-039-wangxun-feng:xu-full:l112:m0000","quote_passage_ref":"data/corpus/jinshu/039.json"}],"references":[{"title":"教育部《重編國語辭典修訂本》中國歷代年號表","url":"https://dict.revised.moe.edu.tw/appendix.jsp?ID=3&page=2","quote":"太寧","columns":{"dynasty":"晉","period":"東晉","era_name":"太寧","first_year":"323","last_year":"326"},"scope":"modern_era_year_equivalence_only","read_on":"2026-10-19","web_extracted_line":74,"image_verified":false}],"regnal_year_mapping":{"kind":"ce_regnal_era_span","era_name":"太寧","source_number":"二","regnal_year":2,"start_ce_year":323,"end_ce_year":326,"reference_index":0},"rationale":"傳文明載年號年序，參照教育部年號起訖換中國曆年度，不移公曆邊界、不倒出生。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"record_id":"le-jin039-xu30-kai","person_id":"yoo_ox0_545_FAAAAB","date_role":"life_event","event_type":"death"}],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"sources":[{"chapter_id":"c-jinshu-039-wangxun-feng","work_id":"w-jinshu","book_id":"b-jinshu-039","source_id":"s-jinshu-039-wangxun-feng","source_ref":"corpus/jinshu/039.json"},{"chapter_id":"c-jinshu-059-jiong","work_id":"w-jinshu","book_id":"b-jinshu-059","source_id":"s-jinshu-059-ws2650