ngyan:m007-0337","chapter_id":"c-shiji-051-jingyan","paragraph_id":"c-shiji-051-jingyan:p007","quote":"田生"},{"mention_id":"c-shiji-051-jingyan:m007-0435","chapter_id":"c-shiji-051-jingyan","paragraph_id":"c-shiji-051-jingyan:p007","quote":"田生"},{"mention_id":"c-shiji-051-jingyan:m007-0440","chapter_id":"c-shiji-051-jingyan","paragraph_id":"c-shiji-051-jingyan:p007","quote":"田生"},{"mention_id":"c-shiji-051-jingyan:m012-0056","chapter_id":"c-shiji-051-jingyan","paragraph_id":"c-shiji-051-jingyan:p012","quote":"田生"}]}],"mentions":[{"id":"c-shiji-051-jingyan:m007-0097","start":97,"end":100,"surface":"田生子","kind":"person","person_id":"cbr-p003192","status":"contextual_provisional","paragraph_id":"c-shiji-051-jingyan:p007","chapter_id":"c-shiji-051-jingyan"}],"relations":[{"id":"a-shiji051-001","subject_person_id":"cbr-p003192","predicate":"father","object_person_id":"cbr-p003205","status":"source_attested","evidence":[{"chapter_id":"c-shiji-051-jingyan","source_id":"s-shiji-051-jingyan","paragraph_id":"c-shiji-051-jingyan:p007","quote":"高后時，齊人田生游乏資，以畫干營陵侯澤。澤大說之，用金二百斤為田生壽。田生已得金，即歸齊。二年，澤使人謂田生曰：「弗與矣。」田生如長安，不見澤，而假大宅，令其子求事呂后所幸大謁者張子卿。居數月，田生子請張卿臨，親修具。張卿許往。田生盛帷帳共具，譬如列侯。張卿驚。酒酣，乃屏人說張卿曰：「臣觀諸侯王邸弟百餘，皆高祖一切功臣。今呂氏雅故本推轂高帝就天下，功至大，又親戚太后之重。太后春秋長，諸呂弱，太后欲立呂產為［呂］王，王代。太后又重發之，恐大臣不聽。今卿最幸，大臣所敬，何不風大臣以聞太后，太后必喜。諸呂已王，萬戶侯亦卿之有。太后心欲之，而卿為內臣，不急發，恐禍及身矣。」張卿大然之，乃風大臣語太后。太后朝，因問大臣。大臣請立呂產為呂王。太后賜張卿千斤金，張卿以其半與田生。田生弗受，因說之曰：「呂產王也，諸大臣未大服。今營陵侯澤，諸劉，為大將軍，獨此尚觖望。今卿言太后，列十餘縣王之，彼得王，喜去，諸呂王益固矣。」張卿入言，太后然之。乃以營陵侯劉澤為瑯邪王。瑯邪王乃與田生之國。田生勸澤急行，毋留。出關，太后果使人追止之，已出，即還。"}],"qualifiers":{"source_term":"田生子","historicity":"historical_tradition"},"interpretation_note":"明示父、子分型；疏屬不補宗族支系，姬姦與弟妻不自動補婚姻或未名父母，定國案不冒稱獨立核定。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji051-007","person_id":"cbr-p003192","surfaces":["田生子"],"scope":"same_chapter","chapter_ids":["c-shiji-051-jingyan"],"status":"contextual_provisional","evidence":[{"paragraph_id"