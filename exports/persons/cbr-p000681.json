{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000681","identity_policy":"contextual_provisional","person_ids":["cbr-p000681"],"persons":[{"id":"cbr-p000681","label":"蘇角","status":"active","historicity":"historical_tradition","aliases":[{"surface":"蘇角","mention_ids":["c-shiji-007-xiangyu:m012-0113"]}],"evidence":[{"mention_id":"c-shiji-007-xiangyu:m012-0113","chapter_id":"c-shiji-007-xiangyu","paragraph_id":"c-shiji-007-xiangyu:p012","quote":"蘇角"}]}],"mentions":[{"id":"c-shiji-007-xiangyu:m012-0113","start":113,"end":115,"surface":"蘇角","kind":"person","person_id":"cbr-p000681","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p012","chapter_id":"c-shiji-007-xiangyu"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-007-xiangyu:p012","text":"項羽已殺卿子冠軍，威震楚國，名聞諸侯。乃遣當陽君、蒲將軍將卒二萬渡河，救鉅鹿。戰少利，陳餘復請兵。項羽乃悉引兵渡河，皆沈船，破釜甑，燒廬舍，持三日糧，以示士卒必死，無一還心。於是至則圍王離，與秦軍遇，九戰，絕其甬道，大破之，殺蘇角，虜王離。涉閒不降楚，自燒殺。當是時，楚兵冠諸侯。諸侯軍救鉅鹿下者十餘壁，莫敢縱兵。及楚擊秦，諸將皆從壁上觀。楚戰士無不一以當十，楚兵呼聲動天，諸侯軍無不人人惴恐。於是已破秦軍，項羽召見諸侯將，入轅門，無不膝行而前，莫敢仰視。項羽由是始為諸侯上將軍，諸侯皆屬焉。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-007-xiangyu:m012-0000","start":0,"end":2,"surface":"項羽","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m012-0004","start":4,"end":8,"surface":"卿子冠軍","kind":"person","person_id":"cbr-p000671","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m012-0021","start":21,"end":24,"surface":"當陽君","kind":"person","person_id":"cbr-p000680","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m012-0025","start":25,"end":28,"surface":"蒲將軍","kind":"person","person_id":"cbr-p000657","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m012-0043","start":43,"end":45,"surface":"陳餘","kind":"person","person_id":"cbr-p000675","status":"cont