,"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-061-panjun:line014-pei04-01:m0069","start":69,"end":71,"surface":"徐宗","kind":"person","person_id":"we0_tdg_5v4","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-061-panjun:line014-pei04-01","chapter_id":"c-sanguozhi-061-panjun"}],"relations":[],"title_holdings":[{"id":"t-wu061-t-wu061-panjun17","person_id":"we0_tdg_5v4","kind":"office","title":"中郎将","mode":"attestation","status":"source_attested","effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本句所載職官，任免時間未詳。","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-061","chapter_id":"c-sanguozhi-061-panjun","source_id":"s-sanguozhi-061-panjun","paragraph_id":"c-sanguozhi-061-panjun:line014-pei04-01","quote":"吴书曰：骠骑将军步骘屯沤口，求召募诸郡以增兵。权以问濬，濬曰：「豪将在民间，耗乱为害，加骘有名势，在所所媚，不可听也。」权从之。中郎将豫章徐宗，有名士也，尝到京师，与孔融交结，然儒生诞节，部曲宽纵，不奉节度，为众作殿，濬遂斩之。其奉法不惮私议，皆此类也。归义隐蕃，以口辩为豪杰所善，濬子翥亦与周旋，馈饷之。濬闻大怒，疏责翥曰：「吾受国厚恩，志报以命，尔辈在都，当念恭顺，亲贤慕善，何故与降虏交，以粮饷之？在远闻此，心震面热，惆怅累旬。疏到，急就往使受杖一百，促责所饷。」当时人咸怪濬，而蕃果图叛诛夷，众乃归服。","person_mention_id":"c-sanguozhi-061-panjun:line014-pei04-01:m0069"}],"attestations":[{"id":"t-wu061-t-wu061-panjun17:a","paragraph_id":"c-sanguozhi-061-panjun:line014-pei04-01","person_mention_id":"c-sanguozhi-061-panjun:line014-pei04-01:m0069","start":64,"end":67,"surface":"中郎将","usage":"narrative","date_expression":null}],"human_reviewed":false,"reviewer":"Codex（AI 代理）","model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-061-panjun:line014-pei04-01","text":"吴书曰：骠骑将军步骘屯沤口