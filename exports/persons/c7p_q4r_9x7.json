ed":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-044-zhengmo:line022:m0024","start":24,"end":26,"surface":"虞松","kind":"person","person_id":"c7p_q4r_9x7","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-044-zhengmo:line022","chapter_id":"c-jinshu-044-zhengmo"}],"relations":[],"title_holdings":[{"id":"th-w044-zhengm-7","person_id":"c7p_q4r_9x7","title":"中書令","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-044","chapter_id":"c-jinshu-044-zhengmo","source_id":"s-jinshu-044-zhengmo","paragraph_id":"c-jinshu-044-zhengmo:line022","quote":"默字思元。起家秘書郎，考核舊文，刪省浮穢。中書令虞松謂曰：「而今而後，硃紫別矣。」轉尚書考功郎，專典伐蜀事，封關內侯，遷司徒左長史。武帝受禪，與太原郭奕俱為中庶子。朝廷以太子官屬宜稱陪臣。默上言：「皇太子體皇極之尊，無私於天下。宮臣皆受命天朝，不得同之籓國。」事遂施行。出為東郡太守，值歲荒人饑，默輒開倉振給，乃舍都亭，自表待罪。朝廷嘉默憂國，詔書褒歎，比之汲黯。班告天下，若郡縣有此比者，皆聽出給。入為散騎常侍。","person_mention_id":"c-jinshu-044-zhengmo:line022:m0024"}],"attestations":[{"id":"th-w043-zhengm-7:a","paragraph_id":"c-jinshu-044-zhengmo:line022","start":21,"end":24,"surface":"中書令","person_mention_id":"c-jinshu-044-zhengmo:line022:m0024","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-044-zhengmo:line022","text":"默字思元。起家秘書郎，考核舊文，刪省浮穢。中書令虞松謂曰：「而今而後，硃紫別矣。」轉尚書考功郎，專典伐蜀事，封關內侯，遷司徒左長史。武帝受禪，與太原郭奕俱為中庶子。朝廷以太子官屬宜稱陪臣。默上言：「皇太子體皇極之尊，無私於天下。宮臣皆受命天朝，不得同之籓國。」事遂施行。出為東郡太守，值歲荒人饑，默輒開倉振給，乃舍都亭，自表待罪。朝廷嘉默憂國，詔書褒歎，比之汲黯。班告天下，若郡縣有此比者，皆聽出給。入為散騎常侍。","text_layer":"received_chapter","annotation_status":"reviewed","menti