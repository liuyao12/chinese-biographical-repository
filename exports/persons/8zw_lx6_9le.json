"閭豐","start":134,"end":136,"person_id":"06b_kc3_tl6","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-teng-xiu:p001:m0141","surface":"王毅","start":141,"end":143,"person_id":"1ty_4me_l97","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-teng-xiu:p001:m0150","surface":"修","start":150,"end":151,"person_id":"8zw_lx6_9le","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-057-teng-xiu","book_id":"b-jinshu-057","work_id":"w-jinshu","source_id":"s-jinshu-057-teng-xiu-ws2413329"},{"id":"c-jinshu-057-teng-xiu:p002","text":"太康九年卒，請葬京師，帝嘉其意，賜墓田一頃，諡曰聲。修之子並上表曰：「亡父修羈絏吳壤，為所驅馳；幸逢開通，沐浴至化，得從俘虜握戎馬之要；未覲聖顏，委南籓之重，實由勳勞少聞天聽故也。年衰疾篤，屢乞骸骨，未蒙垂哀，奄至薨隕。臣承遺意，輿櫬還都，瞻望雲闕，實懷痛裂。竊聞博士諡修曰聲，直彰流播，不稱行績，不勝愚情，冒昧聞訴。」帝乃賜諡曰忠。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":23,"last_line":23,"raw_start":1320,"raw_end":1494,"raw_character_offsets":[1325,1326,1327,1328,1331,1332,1333,1334,1335,1336,1337,1338,1339,1340,1341,1342,1343,1344,1345,1346,1347,1348,1349,1350,1351,1352,1353,1354,1355,1356,1357,1358,1359,1360,1361,1362,1363,1364,1365,1366,1367,1368,1369,1370,1371,1372,1373,1374,1375,1376,1377,1378,1379,1380,1381,1382,1383,1384,1385,1386,1387,1388,1389,1390,1391,1392,1393,1394,1395,1396,1397,1398,1399,1400,1401,1402,1403,1404,1405,1406,1407,1408,1409,1410,1411,1412,1413,1414,1415,1416,1417,1418,1419,1420,1421,1422,1423,1424,1425,1426,1427,1428,1429,1430,1431,1432,1433,1434,1435,1436,1437,1438,1439,1440,1441,1442,1443,1444,1445,1446,1447,1448,1449,1450,1451,1452,1453,1454,1455,1456,1457,1458,1459,1460,1461,1462,1463,1464,1465,1466,1467,1468,1469,1470,1471,1472,1473,1474,1475,1476,1477,1478,1479,1480,1481,1482,1483,1484,1485,1486,1487,1488,1489,1490,1491,1492,1493],"revision_id":2413329},"mentions":[{"id":"c-jinshu-057-teng-xiu:p002:m0029","surface":"並","start":29,"end":30,"person_id":"mwp_25k_l3w","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-teng-xiu:p002:m0037","surface":"修","start":37,"end":38,"person_id":"8zw_lx6_9le","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-057-teng-xiu","book_id":"b-jinshu-057","work_id":"w-jinshu","source_id":"s-jinshu-057-teng-xiu-ws2413329"},{"id":"c-jinshu-057-teng-xiu:p004","text":"修曾孫恬之，龍驤將軍、魏郡太守，戍黎陽，為翟遼所執，死之。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":27,"last_line":27,"raw_start":1567,"raw_end":1596,"raw_character_offsets":[1567,1568,1569,1570,1571,1572,1573,1574,1575,1576,1577,1578,1579,1580,1581,1582,1583,1584,1585,1586,1587,1588,1589,1590,1591,1592,1593,1594,1595],"revision_id":2413329},"mentions":[{"id":"c-jinshu-057-teng-xiu:p004:m0000","surface":"修","start":0,"end":1,"person_id":"8zw_lx6_9le","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-teng-xiu:p004:m0003","surface":"恬之","start":3,"end":5,"person_id":"f5b_fee_ed6","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-teng-xiu:p004:m0021","surface":"翟遼","start":21,"end":23,"person_id":"3f5_cd6_2ee","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-057-teng-xiu","book_id":"b-jinshu-057","work_id":"w-jinshu","source_id":"s-jinshu-057-teng-xiu-ws2413329"},{"id":"c-sanguozhi-060-lvdai:line053-pei01-01","text":"王隐《交广记》曰：吴后复置广州，以南阳滕脩为刺史。或语脩虾须长一丈，脩不信，其人后故至东海，取虾须长四丈四尺，封以示脩，脩乃服之。","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-060-lvdai:line053-pei01-01:m0000","start":0,"end":2,"surface":"王隐","kind":"person","person_id":"7er_nm9_kan","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-lvdai:line053-pei01-01:m0019","start":19,"end":21,"surface":"滕脩","kind":"person","person_id":"8zw_lx6_9le","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-lvdai:line053-pei01-01:m0027","start":27,"end":28,"surface":"脩","kind":"person","person_id":"8zw_lx6_9le","status":"contextual_provisional","interpret