ids":["s-jinshu-057-teng-xiu-ws2413329","s-sanguozhi-060-lvdai"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-jinshu-057-teng-xiu:source_review1-0","kind":"source_review","person_id":"8zw_lx6_9le","source_quote":"滕修，字顯先，南陽西鄂人也。仕吳為將帥，封西鄂侯。孫皓時，代熊睦為廣州刺史，甚有威惠。徵為執金吾。廣州部曲督郭馬等為亂，皓以修宿有威惠，為嶺表所伏，以為使持節、都督廣州軍事、鎮南將軍、廣州牧以討之。未克而王師伐吳，修率眾赴難。至巴丘而皓已降，乃縞素流涕而還，與廣州刺史閭豐、蒼梧太守王毅各送印綬，詔以修為安南將軍，廣州牧、持節、都督如故，封武當侯，加鼓吹，委以南方事。修在南積年，為邊夷所附。","reading":"滕修字顯先，由吳廣州刺史等職轉歸晉，封武當侯。","note":"滕修字顯先，由吳廣州刺史等職轉歸晉，封武當侯。","paragraph_id":"c-jinshu-057-teng-xiu:p001","start_codepoint":0,"end_codepoint":196,"human_reviewed":false,"chapter_id":"c-jinshu-057-teng-xiu","source_id":"s-jinshu-057-teng-xiu-ws2413329"},{"id":"c-jinshu-057-teng-xiu:source_review2-0","kind":"source_review","person_id":"8zw_lx6_9le","source_quote":"太康九年卒，請葬京師，帝嘉其意，賜墓田一頃，諡曰聲。修之子並上表曰：「亡父修羈絏吳壤，為所驅馳；幸逢開通，沐浴至化，得從俘虜握戎馬之要；未覲聖顏，委南籓之重，實由勳勞少聞天聽故也。年衰疾篤，屢乞骸骨，未蒙垂哀，奄至薨隕。臣承遺意，輿櫬還都，瞻望雲闕，實懷痛裂。竊聞博士諡修曰聲，直彰流播，不稱行績，不勝愚情，冒昧聞訴。」帝乃賜諡曰忠。","reading":"太康九年卒。初諡聲，子並以表請改，乃諡忠。","note":"太康九年卒。初諡聲，子並以表請改，乃諡忠。","paragraph_id":"c-jinshu-057-teng-xiu:p002","start_codepoint":0,"end_codepoint":167,"human_reviewed":false,"chapter_id":"c-jinshu-057-teng-xiu","source_id":"s-jinshu-057-teng-xiu-ws2413329"},{"id":"c-jinshu-057-teng-xiu:source_review3-0","kind":"source_review","person_id":"8zw_lx6_9le","source_quote":"並子含，初為庾冰輕車長史，討蘇峻有功，封夏陽縣開國侯，邑千六百戶，授平南將軍、廣州刺史。在任積年，甚有威惠，卒諡曰戴。含弟子遁，交州刺史。","reading":"滕並子含討蘇峻，任廣州刺史，諡戴。「含弟子遁」照原字分錄。","note":"滕並子含討蘇峻，任廣州刺史，諡戴。「含弟子遁」照原字分錄。","paragraph_id":"c-jinshu-057-teng-xiu:p003","start_codepoint":0,"end_codepoint":69,"human_reviewed":false,"chapter_id":"c-jinshu-057-teng-xiu","source_id":"s-jinshu-057-teng-xiu-ws2413329"},{"id":"c-jinshu-057-teng-xiu:source_review4-0","kind":"source_review","person_id":"8zw_lx6_9le","source_quote":"修曾孫恬之，龍驤將軍、魏郡太守，戍黎陽，為翟遼所執，死之。","reading":"滕修曾孫恬之戍黎陽，為翟遼所執而死。","note":"滕修曾孫恬之戍黎陽，為翟遼所執而死。","paragraph_id":"c-jinshu-057-teng-xiu:p004","start_codepoint":0,"end_codepoint":29,"human_reviewed":false,"chapter_id":"c-jinshu-057-teng-xiu","source_id":"s-jinshu-057-teng-xiu-ws2413329"},{"id":"c-sanguozhi-060-lvdai:line053-pei01-01:reading-000-065","kind":"annotation_sentence","paragraph_id":"c-sanguozhi-060-lvdai:line053-pei01-01","start_codepoint":0,"end_codepoint":65,"source_quote":"王隐《交广记》曰：吴后复置广州，以南阳滕脩为刺史。或语脩虾须长一丈，脩不信，其人后故至东海，取虾须长四丈四尺，封以示脩，脩乃服之。","person_id":"8zw_lx6_9le","related_person_ids":["7er_nm9_kan"],"reading":"王隱交廣記附敘後來的廣州刺史滕脩；未以虾须之類作官物定值。","chapter_id":"c-sanguozhi-060-lvdai","source_id":"s-sanguozhi-060-lvdai"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin057-volume-teng-bing","subject_person_id":"mwp_25k_l3w","object_person_id":"8zw_lx6_9le","predicate":"father","qualifiers":{"source_term":"修之子並"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-057","chapter_id":"c-jinshu-057-teng-xiu","source_id":"s-jinshu-057-teng-xiu-ws2413329","paragraph_id":"c-jinshu-057-teng-xiu:p002","quote":"太康九年卒，請葬京師，帝嘉其意，賜墓田一頃，諡曰聲。修之子並上表曰：「亡父修羈絏吳壤，為所驅馳；幸逢開通，沐浴至化，得從俘虜握戎馬之要；未覲聖顏，委南籓之重，實由勳勞少聞天聽故也。年衰疾篤，屢乞骸骨，未蒙垂哀，奄至薨隕。臣承遺意，輿櫬還都，瞻望雲闕，實懷痛裂。竊聞博士諡修曰聲，直彰流播，不稱行績，不勝愚情，冒昧聞訴。」帝乃賜諡曰忠。","subject_person_mention_id":"c-jinshu-057-teng-xiu:p002:m0029","object_person_mention_id":"c-jinshu-057-teng-xiu:p002:m0037"}],"status":"source_attested","interpretation_note":"上表自稱亡父修，下文並子含可核人名。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-jin057-volume-teng-xiu-death","person_id":"8zw_lx6_9le","event_type":"death"