kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-103-wanshi:m011-0103","start":103,"end":106,"surface":"桑弘羊","kind":"person","person_id":"fi2_2cl_w22","status":"contextual_provisional"},{"id":"c-shiji-103-wanshi:m011-0110","start":110,"end":113,"surface":"王温舒","kind":"person","person_id":"6ym_eva_k4a","status":"contextual_provisional"},{"id":"c-shiji-103-wanshi:m011-0118","start":118,"end":120,"surface":"兒寬","kind":"person","person_id":"x8r_9sk_d7a","status":"contextual_provisional"},{"id":"c-shiji-103-wanshi:m011-0164","start":164,"end":165,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-103-wanshi:m011-0167","start":167,"end":169,"surface":"所忠","kind":"person","person_id":"gns_w0b_kfj","status":"contextual_provisional"},{"id":"c-shiji-103-wanshi:m011-0172","start":172,"end":174,"surface":"咸宣","kind":"person","person_id":"oh2_xep_h3c","status":"contextual_provisional"}],"chapter_id":"c-shiji-103-wanshi","book_id":"b-shiji-103","work_id":"w-shiji","source_id":"s-shiji-103-wanshi"},{"id":"c-shiji-117-xiangru:p056","text":"相如既病免，家居茂陵。天子曰：「司馬相如病甚，可往從悉取其書；若不然，後失之矣。」使所忠往，而相如已死，家無書。問其妻，對曰：「長卿固未嘗有書也。時時著書，人又取去，即空居。長卿未死時，為一卷書，曰有使者來求書，奏之。無他書。」其遺劄書言封禪事，奏所忠。忠奏其書，天子異之。其書曰：","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m056-0000","start":0,"end":2,"surface":"相如","kind":"person","person_id":"usb_lgr_ksa","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m056-0011","start":11,"end":13,"surface":"天子","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m056-0016","start":16,"end":20,"surface":"司馬相如","kind":"person","person_id":"usb_lgr_ksa","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m056-0042","start":42,"end":44,"surface":"所忠","kind":"person","person_id":"gns_w0b_kfj","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m056-