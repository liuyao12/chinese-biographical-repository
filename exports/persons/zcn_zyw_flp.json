:m003-0015","start":15,"end":17,"surface":"孝景","kind":"person","person_id":"av9_5kt_rys","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m003-0019","start":19,"end":20,"surface":"都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m003-0031","start":31,"end":33,"surface":"大臣","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m003-0042","start":42,"end":44,"surface":"賈姬","kind":"person","person_id":"hm5_fxv_gts","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m003-0053","start":53,"end":54,"surface":"上","kind":"person","person_id":"av9_5kt_rys","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m003-0055","start":55,"end":56,"surface":"都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m003-0057","start":57,"end":58,"surface":"都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m003-0061","start":61,"end":62,"surface":"上","kind":"person","person_id":"av9_5kt_rys","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m003-0067","start":67,"end":69,"surface":"賈姬","kind":"person","person_id":"hm5_fxv_gts","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m003-0070","start":70,"end":71,"surface":"都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m003-0072","start":72,"end":73,"surface":"上","kind":"person","person_id":"av9_5kt_rys","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m003-0090","start":90,"end":92,"surface":"賈姬","kind":"person","person_id":"hm5_fxv_gts","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m003-0095","start":95,"end":97,"surface":"陛下","kind":"person","person_id":"av9_5kt_rys","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m003-0104","start":104,"end":106,"surface":"太后","kind":"person","person_id":"zcn_zyw_flp","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m003-0109","start":109,"end":110,"surface":"上","kind":"person","person_id":"av9_5kt_rys","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m003-0116","start":116,"end":118,"surface":"太后","kind":"person","person_id":"zcn_zyw_flp","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m003-0122","start":122,"end":123,"surface":"都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m003-0130","start":130,"end":132,"surface":"郅都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"}],"chapter_id":"c-shiji-122-kuli","book_id":"b-shiji-122","work_id":"w-shiji","source_id":"s-shiji122-kuli"},{"id":"c-shiji-122-kuli:p007","text":"臨江王徴詣中尉府對簿，臨江王欲得刀筆爲書謝上，而都禁吏不予。魏其侯使人以閒與臨江王。臨江王旣爲書謝上，因自殺。竇太后聞之，怒，以危法中都，都免歸家。孝景帝乃使使持節拜都爲鴈門太守，而便道之官，得以便宜從事。匈奴素聞郅都節，居邊，爲引兵去，竟郅都死不近鴈門。匈奴至爲偶人象郅都，令騎馳射莫能中，見憚如此。匈奴患之。竇太后乃竟中都以漢法。景帝曰：「都忠臣。」欲釋之。竇太后曰：「臨江王獨非忠臣邪？」於是遂斬郅都。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-122-kuli:m007-0000","start":0,"end":3,"surface":"臨江王","kind":"person","person_id":"3sg_5re_qc2","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0011","start":11,"end":14,"surface":"臨江王","kind":"person","person_id":"3sg_5re_qc2","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0021","start":21,"end":22,"surface":"上","kind":"person","person_id":"av9_5kt_rys","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0024","start":24,"end":25,"surface":"都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0026","start":26,"end":27,"surface":"吏","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m007-0030","start":30,"end":33,"surface":"魏其侯","kind":"person","person_id":"oob_8rk_z66","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m007-0038","start":38,"end":41,"surface":"臨江王","kind":"person","person_id":"