t":128,"end":129,"surface":"紂","kind":"person","person_id":"cbr-p000136","status":"source_identified"},{"id":"c-shiji-003-yin:m029-0131","start":131,"end":133,"surface":"西伯","kind":"person","person_id":"cbr-p000139","status":"source_identified"},{"id":"c-shiji-003-yin:m029-0134","start":134,"end":136,"surface":"西伯","kind":"person","person_id":"cbr-p000139","status":"source_identified"},{"id":"c-shiji-003-yin:m029-0152","start":152,"end":153,"surface":"紂","kind":"person","person_id":"cbr-p000136","status":"source_identified"},{"id":"c-shiji-003-yin:m029-0169","start":169,"end":171,"surface":"西伯","kind":"person","person_id":"cbr-p000139","status":"source_identified"},{"id":"c-shiji-003-yin:m029-0174","start":174,"end":176,"surface":"費中","kind":"person","person_id":"cbr-p000145","status":"source_identified"},{"id":"c-shiji-003-yin:m029-0179","start":179,"end":181,"surface":"費中","kind":"person","person_id":"cbr-p000145","status":"source_identified"},{"id":"c-shiji-003-yin:m029-0192","start":192,"end":193,"surface":"紂","kind":"person","person_id":"cbr-p000136","status":"source_identified"},{"id":"c-shiji-003-yin:m029-0195","start":195,"end":197,"surface":"惡來","kind":"person","person_id":"cbr-p000146","status":"source_identified"},{"id":"c-shiji-003-yin:m029-0198","start":198,"end":200,"surface":"惡來","kind":"person","person_id":"cbr-p000146","status":"source_identified"}],"chapter_id":"c-shiji-003-yin","book_id":"b-shiji-003","work_id":"w-shiji","source_id":"s-shiji-003-yin"},{"id":"c-shiji-004-zhou:p008","text":"崇侯虎譖西伯於殷紂曰：「西伯積善累德，諸侯皆向之，將不利於帝。」帝紂乃囚西伯於羑里。閎夭之徒患之。乃求有莘氏美女，驪戎之文馬，有熊九駟，他奇怪物，因殷嬖臣費仲而獻之紂。紂大說，曰：「此一物足以釋西伯，況其多乎！」乃赦西伯，賜之弓矢斧鉞，使西伯得征伐。曰：「譖西伯者，崇侯虎也。」西伯乃獻洛西之地，以請紂去炮格之刑。紂許之。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-004-zhou:m008-0000","start":0,"end":3,"surface":"崇侯虎","kind":"person","person_id":"cbr-p000143","status":"source_identified"},{"id":"c-shiji-004-zhou:m008-0004","start":4,"end":6,"surface":"西伯","kind":"person","person_id":"cbr-p0