,"start":95,"end":98,"surface":"髙昭子","kind":"person","person_id":"cbr-p002724","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m009-0099","start":99,"end":102,"surface":"國惠子","kind":"person","person_id":"cbr-p002723","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m009-0151","start":151,"end":154,"surface":"髙昭子","kind":"person","person_id":"cbr-p002724","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m009-0171","start":171,"end":173,"surface":"田乞","kind":"person","person_id":"cbr-p002720","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m009-0174","start":174,"end":176,"surface":"鮑牧","kind":"person","person_id":"cbr-p002742","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m009-0186","start":186,"end":189,"surface":"髙昭子","kind":"person","person_id":"cbr-p002724","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m009-0190","start":190,"end":192,"surface":"昭子","kind":"person","person_id":"cbr-p002724","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m009-0196","start":196,"end":199,"surface":"國惠子","kind":"person","person_id":"cbr-p002723","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m009-0206","start":206,"end":208,"surface":"田乞","kind":"person","person_id":"cbr-p002720","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m009-0211","start":211,"end":214,"surface":"國惠子","kind":"person","person_id":"cbr-p002723","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m009-0215","start":215,"end":217,"surface":"惠子","kind":"person","person_id":"cbr-p002723","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m009-0223","start":223,"end":226,"surface":"髙昭子","kind":"person","person_id":"cbr-p002724","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m009-0227","start":227,"end":235,"surface":"晏（孺子）［圉］","kind":"person","person_id":"cbr-p002752","status":"contextual_provisional"}],"chapter_id":"c-shiji-046-tian","book_id":"b-shiji-046","work_id":"w-shiji","source_id":"s-shiji-046-tian"},{"id":"c-shiji-046-tian:p010","text":"田乞使人之魯，迎陽生。陽生至齊，匿田乞家。請諸大夫曰：「常之母有魚菽之祭，幸而來會飲。」會飲田氏。田乞盛陽生橐中，置坐中央。發橐，出陽生，曰：「此乃齊君矣。」大夫皆伏謁。將盟立之，田乞誣曰：「吾與鮑牧謀共立陽生也。」鮑牧怒曰：「大夫忘景公之命乎？」諸大夫欲悔，陽生乃頓首曰：「可則立之，不可則已。」鮑牧恐禍及己，乃復曰：「皆景公之子，何爲不可！」遂立陽生於田乞之家，是爲悼公。乃使人遷晏孺子於駘，而殺孺子荼。悼公旣立，田乞爲相，專齊政。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-046-tian:m010-0000","start":0,"end":2,"surface":"田乞","kind":"person","person_id":"cbr-p002720","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m010-0008","start":8,"end":10,"surface":"陽生","kind":"person","person_id":"cbr-p002725","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m010-0011","start":11,"end":13,"surface":"陽生","kind":"person","person_id":"cbr-p002725","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m010-0017","start":17,"end":19,"surface":"田乞","kind":"person","person_id":"cbr-p002720","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m010-0028","start":28,"end":31,"surface":"常之母","kind":"person","person_id":"cbr-p002753","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m010-0046","start":46,"end":48,"surface":"田氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"氏族、群體、卜辭或未定指代，未補成員姓名與親屬。"},{"id":"c-shiji-046-tian:m010-0049","start":49,"end":51,"surface":"田乞","kind":"person","person_id":"cbr-p002720","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m010-0052","start":52,"end":54,"surface":"陽生","kind":"person","person_id":"cbr-p002725","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m010-0066","start":66,"end":68,"surface":"陽生","kind":"person","person_id":"cbr-p002725","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m010-0090","start":90,"end":92,"surface":"田乞","kind":"person","person_id":"cbr-p002720","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m010-0098","start":98,"end":100,"surface":"鮑牧","kind":"person","person_id":"cbr-p002742","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m010-0103","start":103,"end":105,"surface":"陽生","kind":"person","person_id":"cbr-p002725","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m010-0108","start":108,"end":110,"surface":"鮑牧","kind":"person","person_id":"cbr-p002742","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m010-0117","start":117,"end":119,"surface":"景公","kind":"person","person_id":"cbr-p002721","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m010-0130","start":130,"end":132,"surface":"陽生","kind":"person","person_id":"cbr-p002725","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m010-0149","start":149,"end":151,"surface":"鮑牧","kind":"person","person_id":"cbr-p002742","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m010-0162","start":162,"end":164,"surface":"景公","kind":"person","person_id":"cbr-p002721","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m010-0175","start":175,"end":177,"surface":"陽生","kind":"person","person_id":"cbr-p002725","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m010-0178","start":178,"end":180,"surface":"田乞","kind":"person","person_id":"cbr-p002720","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m010-0185","start":185,"end":187,"surface":"悼公","kind":"person","person_id":"cbr-p002725","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m010-0192","start":192,"end":195,"surface":"晏孺子","kind":"person","person_id":"cbr-p002722","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m010-0200","start":200,"end":203,"surface":"孺子荼","kind":"person","person_id":"cbr-p002722","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m010-0204","start":204,"end":206,"surface":"悼公","kind":"person","person_id":"cbr-p002725","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m010-0209","start":209,"end":211,"surface":"田乞","kind":"person","person_id":"cbr-p002720","status":"contextual_provisional"}],"chapter_id":"c-shiji-046-tian","book_id":"b-shiji-046","work_id":"w-shiji","source_id":"s-shiji-046-tian"},{"id":"c-shiji-046-tian:p011","text":"四年，田乞卒，子常代立，是爲田成子。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-046-tian:m011-0003","start":3,"end":5,"surface":"田乞","kind":"person","person_id":"cbr-p002720","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m011-0008","start":8,"end":9,"surface":"常","kind":"person","person_id":"cbr-p002726","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m011-0014","start":14,"end":17,"surface":"田成子","kind":"person","person_id":"cbr-p002726","status":"contextual_provisional"}],"chapter_id":"c-shiji-046-tian","book_id":"b-shiji-046","work_id":"w-shiji","source_id":"s-shiji-046-tian"},{"id":"c-shiji-046-tian:p012","text":"鮑牧與齊悼公有郄，弒悼公。齊人共立其子壬，是爲簡公。田常成子與監止倶爲左右相，相簡公。田常心害監止，監止幸於簡公，權弗能去。於是田常復修釐子之政，以大斗出貸，以小斗收。齊人歌之曰：「嫗乎采芑，歸乎田成子！」齊大夫朝，御鞅諫簡公曰：「田、監不可并也，君其擇焉。」君弗聽。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-046-tian:m012-0000","start":0,"end":2,"surface":"鮑牧","kind":"person","person_id":"cbr-p002742","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m012-0003","start":3,"end":6,"surface":"齊悼公","kind":"person","person_id":"cbr-p002725","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m012-0010","start":10,"end":12,"surface":"悼公","kind":"person","person_id":"cbr-p002725","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m012-0019","start":19,"end":20,"surface":"壬","kind":"person","person_id":"cbr-p002743","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m012-0023","start":23,"end":25,"surface":"簡公","kind":"person","person_id":"cbr-p002743","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m012-0026","start":26,"end":30,"surface":"田常成子","kind":"person","person_id":"cbr-p002726","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m012-0031","start":31,"end":33,"surface":"監止","kind":"person","person_id":"cbr-p002744","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m012-0040","start":40,"end":42,"surface":"簡公","kind":"person","person_id":"cbr-p002743","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m012-0043","start":43,"end":45,"surface":"田常","kind":"person","person_id":"cbr-p002726","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m012-0047","start":47,"end":49,"surface":"監止","kind":"person","person_id":"cbr-p002744","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m012-0050","start":50,"end":52,"surface":"監止","kind":"person","person_id":"cbr-p002744","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m012-0054","start":54,"end":56,"surface":"簡公","kind":"person","person_id":"cbr-p002743","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m012-0064","start":64,"end":66,"surface":"田常","kind":"person","person_id":"cbr-p002726","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m012-0068","start":68,"end":70,"surface":"釐子","kind":"person","person_id":"cbr-p002720","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m012-0098","start":98,"end":101,"surface":"田成子","kind":"person","person_id":"cbr-p002726","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m012-0108","start":108,"end":110,"surface":"御鞅","kind":"person","person_id":"cbr-p002745","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m012-0111","start":111,"end":113,"surface":"簡公","kind":"person","person_id":"cbr-p002743","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m012-0116","start":116,"end":119,"surface":"田、監","kind":"unresolved","person_id":null,"status":"unresolved","note":"氏族、群體、卜辭或未定指代，未補成員姓名與親屬。"}],"chapter_id":"c-shiji-046-tian","book_id":"b-shiji-046","work_id":"w-shiji","source_id":"s-shiji-046-tian"},{"id":"c-shiji-046-tian:p055","text":"太史公曰：蓋孔子晩而喜易。易之爲術，幽明遠矣，非通人達才孰能注意焉！笔周太史之卦田敬仲完，占至十世之後；及完奔齊，懿仲卜之亦云。田乞及常所以比犯二君，專齊國之政，非必事勢之漸然也，蓋若遵厭兆祥云。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-046-tian:m055-0000","start":0,"end":3,"surface":"太史公","kind":"person","person_id":"cbr-p002782","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m055-0006","start":6,"end":8,"surface":"孔子","kind":"person","person_id":"cbr-p002821","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m055-0035","start":35,"end":38,"surface":"周太史","kind":"person","person_id":"cbr-p002708","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m055-0040","start":40,"end":44,"surface":"田敬仲完","kind":"person","person_id":"cbr-p002734","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m055-0053","start":53,"end":54,"surface":"完","kind":"person","person_id":"cbr-p002734","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m055-0057","start":57,"end":59,"surface":"懿仲","kind":"person","person_id":"cbr-p002713","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m055-0064","start":64,"end":66,"surface":"田乞","kind":"person","person_id":"cbr-p002720","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m055-0067","start":67,"end":68,"surface":"常","kind":"person","person_id":"cbr-p002726","status":"contextual_provisional"}],"chapter_id":"c-shiji-046-tian","book_id":"b-shiji-046","work_id":"w-shiji","source_id":"s-shiji-046-tian"},{"id":"c-shiji-064-sima:p002","text":"已而大夫鮑氏、高、國之屬害之，譖於景公。景公退穰苴，苴發疾而死。田乞、田豹之徒由此怨高、國等。其後及田常殺簡公，盡滅高子、國子之族。至常曾孫和，因自立為齊威王，用兵行威，大放穰苴之法，而諸侯朝齊。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-064-sima:m002-0004","start":4,"end":6,"surface":"鮑氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、族稱、泛稱或未定指代；不補姓名或成員。"},{"id":"c-shiji-064-sima:m002-0007","start":7,"end":12,"surface":"高、國之屬","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、族稱、泛稱或未定指代；不補姓名或成員。"},{"id":"c-shiji-064-sima:m002-0017","start":17,"end":19,"surface":"景公","kind":"person","person_id":"cbr-p003761","status":"contextual_provisional"},{"id":"c-shiji-064-sima:m002-0020","start":20,"end":22,"surface":"景公","kind":"person","person_id":"cbr-p003761","status":"contextual_provisional"},{"id":"c-shiji-064-sima:m002-0023","start":23,"end":25,"surface":"穰苴","kind":"person","person_id":"cbr-p003759","status":"contextual_provisional"},{"id":"c-shiji-064-sima:m002-0026","start":26,"end":27,"surface":"苴","kind":"person","person_id":"cbr-p003759","status":"contextual_provisional"},{"id":"c-shiji-064-sima:m002-0032","start":32,"end":34,"surface":"田乞","kind":"person","person_id":"cbr-p003767","status":"contextual_provisional"},{"id":"c-shiji-064-sima:m002-0035","start":35,"end":37,"surface":"田豹","kind":"person","person_id":"cbr-p003768","status":"contextual_provisional"},{"id":"c-shiji-064-sima:m002-0042","start":42,"end":46,"surface":"高、國等","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、族稱、泛稱或未定指代；不補姓名或成員。"},{"id":"c-shiji-064-sima:m002-0050","start":50,"end":52,"surface":"田常","kind":"person","person_id":"cbr-p003769","status":"contextual_provisional"},{"id":"c-shiji-064-sima:m002-0053","start":53,"end":55,"surface":"簡公","kind":"person","person_id":"cbr-p003770","status":"contextual_provisional"},{"id":"c-shiji-064-sima:m002-0058","start":58,"end":65,"surface":"高子、國子之族","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、族稱、泛稱或未定指代；不補姓名或成員。"},{"id":"c-shiji-064-sima:m002-0067","start":67,"end":68,"surface":"常","kind":"person","person_id":"cbr-p003769","status":"contextual_provisional"},{"id":"c-shiji-064-sima:m002-0070","start":70,"end":71,"surface":"和","kind":"person","person_id":"cbr-p003771","status":"contextual_provisional"},{"id":"c-shiji-064-sima:m002-0076","start":76,"end":79,"surface":"齊威王","kind":"person","person_id":"cbr-p003771","status":"contextual_provisional"},{"id":"c-shiji-064-sima:m002-0087","start":87,"end":89,"surface":"穰苴","kind":"person","person_id":"cbr-p003759","status":"contextual_provisional"},{"id":"c-shiji-064-sima:m002-0093","start":93,