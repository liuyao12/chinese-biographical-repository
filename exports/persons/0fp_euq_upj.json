"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-059-he:line032-pei01-01:m0166","start":166,"end":168,"surface":"呂據","kind":"person","person_id":"0fp_euq_upj","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-059-he:line032-pei01-01","chapter_id":"c-sanguozhi-059-he"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-059-he:line032-pei01-01","text":"殷基《通語》曰：初權旣立和爲太子，而封霸爲魯王，初拜猶同宮室，禮秩未分。羣公之議，以爲太子、國王上下有序，禮秩宜異，於是分宮別僚，而隙端開矣。自侍御賔客造爲二端，仇黨疑貳，滋延大臣。丞相陸遜、大將軍諸葛恪、太常顧譚、驃騎將軍朱據、會稽太守滕胤、大都督施績、尚書丁密等奉禮而行，宗事太子，驃騎將軍步隲、鎮南將軍呂岱、大司馬全琮、左將軍呂據、中書令孫弘等附魯王，中外官僚將軍大臣舉國中分。權患之，謂侍中孫峻曰：「子弟不睦，臣下分部，將有袁氏之敗，爲天下笑。一人立者，安得不亂？」於是有改嗣之規矣。　","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-059-he:line032-pei01-01:m0000","start":0,"end":2,"surface":"殷基","kind":"person","person_id":"i5r_vby_q00_A","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line032-pei01-01:m0009","start":9,"end":10,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line032-pei01-01:m0012","start":12,"end":13,"surface":"和","kind":"person","person_id":"572_278_cba_A","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line032-pei01-01:m0019","start":19,"end":20,"surface":"霸","kind":"person","person_id":"572_278_cba_B","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line032-pei01-01:m0093","start":93,"end":95,"surface":"陸遜","kind":"person","person_id":"lii_454_vuv","status":"contextual_