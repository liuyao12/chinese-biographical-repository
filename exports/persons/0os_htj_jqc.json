policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"person_id":"0os_htj_jqc","title":null,"surname":"何","ming":"充","additional_names":[],"work_id":"w-jinshu","book_id":"b-jinshu-075","chapter_id":"c-jinshu-075-xunsong-families","source_id":"s-jinshu-075-xunsong-families","paragraph_id":"c-jinshu-075-xunsong-families:xunxian-offices:p001","quote":"驃騎將軍何充出鎮京口，請為參軍。穆帝又以為撫軍參軍，征補太常博士，皆不就。後拜秘書丞、義興太守。征北將軍褚裒以為長史。既到，裒謂佐吏曰：「荀生資逸群之氣，將有沖天之舉，諸君宜善事之。」尋遷建威將軍、吳國內史。除北中郎將、徐州刺史、監徐兗二州揚州之晉陵諸軍事、假節。殷浩以羨在事有能名，故居以重任。時年二十八，中興方伯，未有如羨之少者。羨至鎮，發二州兵，使參軍鄭襲戍准陰。羨尋北鎮准陰，屯田于東陽之石鱉。尋加監青州諸軍事，又領兗州刺史，鎮下邳。羨自鎮來朝，時蔡謨固讓司徒，不起，中軍將軍殷浩欲加大辟，以問於羨。羨曰：「蔡公今日事危，明日必有桓文之舉。」浩乃止。","status":"editorial_provisional","human_reviewed":false,"model":null,"note":"依具名家世及本段上下文暫分姓名；未知字號與年份留空，不以同姓接族。稱號僅為人物辨認，不指定敘事所有時點的任期。"}],"mentions":[{"id":"c-jinshu-075-xunsong-families:xunxian-offices:p001:m0004","start":4,"end":6,"surface":"何充","kind":"person","person_id":"0os_htj_jqc","status":"contextual_provisional","paragraph_id":"c-jinshu-075-xunsong-families:xunxian-offices:p001","chapter_id":"c-jinshu-075-xunsong-families"},{"id":"c-nanqishu-046-wangxiuzhi:line019:m0261","start":261,"end":263,"surface":"驃騎","kind":"person","person_id":"0os_htj_jqc","status":"contextual_provisional","paragraph_id":"c-nanqishu-046-wangxiuzhi:line019","chapter_id":"c-nanqishu-046-wangxiuzhi"}],"relations":[],"title_holdings":[{"id":"th-jinshu075-full-022","person_id":"0os_htj_jqc","title":"驃騎將軍","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-075","chapter_id":"c-jinshu-075-xunsong-families","source_id":"s-jinshu-075-xunsong-families","paragraph_id":"c-jinshu-075-xunsong-families:xunxian-offices:p001","quote":"驃騎將軍何充出鎮京口，請為參軍。穆帝又以為撫軍參軍，征補太常博士，皆不就。後拜秘書丞、義興太守。征北將軍褚裒以為長史。既到，裒謂佐吏曰：「荀生資逸群之氣，將有沖天之舉，諸君宜善事之。」尋遷建威將軍、吳國內史。除北中郎將、徐州刺史、監徐兗二州揚州之晉陵諸軍事、假節。殷浩以羨在事有能名，故居以重任。時年二十八，中興方伯，未有如羨之少者。羨至鎮，發二州兵，使參軍鄭襲戍准陰。羨尋北鎮准陰，屯田于東陽之石鱉。尋加監青州諸軍事，又領兗州刺史，鎮下邳。羨自鎮來朝，時蔡謨固讓司徒，不起，中軍將軍殷浩欲加大辟，以問於羨。羨曰：「蔡公今日事危，明日必有桓文之舉。」浩乃止。","person_mention_id":"c-jinshu-075-xunsong-families:xunxian-offices:p001:m0004"}],"attestations":[{"id":"th-jinshu075-full-022:a001","paragraph_id":"c-jinshu-075-xunsong-families:xunxian-offices:p001","start":0,"end":4,"surface":"驃騎將軍","person_mention_id":"c-jinshu-075-xunsong-families:xunxian-offices:p001:m0004","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"按授任、改封、敘事用稱或追贈分記；未載起訖年份留空，不以死亡日補所有官職終期。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-qi046-piaoqi-hechong","person_id":"0os_htj_jqc","surfaces":["驃騎"],"scope":"same_chapter","chapter_ids":["c-nanqishu-046-wangxiuzhi"],"status":"contextual_provisional","confidence_level":"high","identification_basis":{"kind":"source_context","target_mention_ids":["c-nanqishu-046-wangxiuzhi:line019:m0261"]},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-046","chapter_id":"c-nanqishu-046-wangxiuzhi","source_id":"s-nanqishu-046-wangxiuzhi","paragraph_id":"c-nanqishu-046-wangxiuzhi:line019","quote":"出爲輔國將軍、隨王鎮西長史、南郡內史。州西曹苟平遺秀之交知書，秀之拒不答。平乃遺書曰：「僕聞居《謙》之位，旣刊于《易》；傲不可長，《禮》明其文。是以信陵致夷門之義，燕丹收荊卿之節，皆以禮而然矣。丈夫處世，豈可寂漠恩榮，空爲後代一丘土？足下業潤重光，聲居朝右，不脩高世之績，將何隔於愚夫？僕耿介當年，不通羣品，饑寒白首，望物嗟來。成人之美，《春秋》所善，薦我寸長，開君尺短，故推風期德，規於相益，實非碌碌有求於平原者也。僕與足下，同爲四海國士。夫盛衰迭代，理之恒數，名位參差，運之通塞，豈品德權行爲之者哉？第五之號，旣無易於驃騎；西曹之名，復何推於長史？足下見答書題久之，以君若此非典，何宜施之於國士？如其循禮，禮無不答，謹以相還，亦何犯於逆鱗哉？君子處人，以德不以位，相如不見屈於澠池，毛遂安受辱於郢門，造敵臨事，僕必先於二子。未知足下之貴，足下之威，孰若秦、楚兩王？僕以德爲寶，足下以位爲寶，各寶其寶，於此敬宜。常聞古人交絕，不泄惡言，僕謂之鄙。無以相貽，故薦貧者之贈。」平，潁川人。豫章王嶷爲荊州時，平獻書令減損奢麗，豫章王優教酬答。尚書令王儉當事，平又與儉書曰「足下建高世之名，而不顯高世之迹，將何以書於齊史哉？」至是南郡綱紀啓隨王子隆請罪，平上書自申。"}],"rationale":"此處驃騎承何准第五之名的引古對話，指兄何充。與同傳早段豫章王驃騎長史之驃騎府主分開，不全篇套用同一稱號。","references":[{"title":"《晉書》卷093正文","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7093&oldid=1548000","source_revision":1548000,"quote":"兄充為驃騎將軍","source_position":{"first_line":62,"last_line":62},"wikitext_sha256":"8fc7f8b8a8a5a33a18c016006082a49f92e418f8fba965e1068b3e4e2016ff7e","image_verified":false},{"title":"《晉書》卷093正文","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7093&oldid=1548000","source_revision":1548000,"quote":"第五之名何滅驃騎","source_position":{"first_line":62,"last_line":62},"wikitext_sha256":"8fc7f8b8a8a5a33a18c016006082a49f92e418f8fba965e1068b3e4e2016ff7e","image_verified":false}],"human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-075-xunsong-families:xunxian-offices:p001","text":"驃騎將軍何充出鎮京口，請為參軍。穆帝又以為撫軍參軍，征補太常博士，皆不就。後拜秘書丞、義興太守。征北將軍褚裒以為長史。既到，裒謂佐吏曰：「荀生資逸群之氣，將有沖天之舉，諸君宜善事之。」尋遷建威將軍、吳國內史。除北中郎將、徐州刺史、監徐兗二州揚州之晉陵諸軍事、假節。殷浩以羨在事有能名，故居以重任。時年二十八，中興方伯，未有如羨之少者。羨至鎮，發二州兵，使參軍鄭襲戍准陰。羨尋北鎮准陰，屯田于東陽之石鱉。尋加監青州諸軍事，又領兗州刺史，鎮下邳。羨自鎮來朝，時蔡謨固讓司徒，不起，中軍將軍殷浩欲加大辟，以問於羨。羨曰：「蔡公今日事危，明日必有桓文之舉。」浩乃止。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-075-xunsong-families:xunxian-offices:p001:m0004","start":4,"end":6,"surface":"何充","kind":"person","person_id":"0os_htj_jqc","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunxian-offices:p001:m0016","start":16,"end":18,"surface":"穆帝","kind":"person","person_id":"84i_4jp_gmc","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunxian-offices:p001:role0021","start":21,"end":25,"surface":"撫軍參軍","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"未受或未赴的職稱錨點，不另造人物，亦不列為實任持職。"},{"