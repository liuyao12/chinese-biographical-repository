urce_position":{"raw_projection_ref":"source-evidence/nanshi020-xiehongwei-reading/raw-projection.json","unit_key":"p019","source_layer":"received_chapter","raw_file_sha256":"4a06175b7f645cf3012c5857b8e33abe3b41bb3f4a0a44ce76105b87112714cb","first_line":103,"last_line":107},"mentions":[{"id":"c-nanshi-020-xiehongwei:p019:m0000","start":0,"end":2,"surface":"𢎞微","kind":"person","person_id":"aa6_83c_juy_DBAB","status":"contextual_provisional"},{"id":"c-nanshi-020-xiehongwei:p019:m0005","start":5,"end":7,"surface":"王惠","kind":"person","person_id":"7r6_k52_qji_ABAAEEB","status":"contextual_provisional"},{"id":"c-nanshi-020-xiehongwei:p019:m0007","start":7,"end":9,"surface":"王球","kind":"person","person_id":"3c9_d1d_870_B","status":"contextual_provisional"},{"id":"c-nanshi-020-xiehongwei:p019:m0016","start":16,"end":18,"surface":"沈約","kind":"person","person_id":"p8b_7w1_y3q","status":"contextual_provisional"},{"id":"c-nanshi-020-xiehongwei:p019:m0019","start":19,"end":21,"surface":"王惠","kind":"person","person_id":"7r6_k52_qji_ABAAEEB","status":"contextual_provisional"},{"id":"c-nanshi-020-xiehongwei:p019:m0023","start":23,"end":24,"surface":"約","kind":"person","person_id":"p8b_7w1_y3q","status":"contextual_provisional"},{"id":"c-nanshi-020-xiehongwei:p019:m0025","start":25,"end":27,"surface":"令明","kind":"person","person_id":"7r6_k52_qji_ABAAEEB","status":"contextual_provisional"},{"id":"c-nanshi-020-xiehongwei:p019:m0030","start":30,"end":32,"surface":"王球","kind":"person","person_id":"3c9_d1d_870_B","status":"contextual_provisional"},{"id":"c-nanshi-020-xiehongwei:p019:m0032","start":32,"end":33,"surface":"約","kind":"person","person_id":"p8b_7w1_y3q","status":"contextual_provisional"},{"id":"c-nanshi-020-xiehongwei:p019:m0034","start":34,"end":36,"surface":"倩玉","kind":"person","person_id":"3c9_d1d_870_B","status":"contextual_provisional"},{"id":"c-nanshi-020-xiehongwei:p019:m0040","start":40,"end":42,"surface":"𢎞微","kind":"person","person_id":"aa6_83c_juy_DBAB","status":"contextual_provisional"},{"id":"c-nanshi-020-xiehongwei:p019:m0042","start":42,"end":43,"surface":"約","kind":"person","person_id":"p8b_7w1_y3q","status":"contextual_provisional"},{"id":"c-nanshi-020-xiehongwei:p019:m0058","start":58,"end":60,"surface":"𢎞微","kind":"person","person_id":"aa6_83c_juy_DBAB","status":"contextual_provisional"},{"id":"c-nanshi-020-xiehongwei:p019:m0068","start":68,"end":69,"surface":"莊","kind":"person","person_id":"aa6_83c_juy_DBABA","status":"contextual_provisional"}],"chapter_id":"c-nanshi-020-xiehongwei","book_id":"b-nanshi-020","work_id":"w-nanshi","source_id":"s-nanshi020-kr3c7bdbb"},{"text":"初，子野曾祖松之，宋元嘉中受詔續修何承天宋史，未成而卒，子野常欲繼成先業。及齊永明末，沈約所撰《宋書》稱「松之已後無聞焉」。子野更撰為《宋略》二十卷，其敘事評論多善，而云：「戮淮南太守沈璞，以其不從義師故也」。約懼，徒跣謝之，請兩釋焉。歎其述作曰：「吾弗逮也。」蘭陵蕭琛言其評論可與過秦、王命分路揚鑣。於是吏部尚書徐勉言之于武帝，以為著作郎，掌修國史及起居注。頃之，兼中書通事舍人，尋除通直員外，著作、舍人如故。敕又掌中書詔誥。","source_position":{"start":10542,"end":10760,"raw":"初，子野曾祖松之，宋元嘉中受詔續修何承天宋史，未成而卒，子野常欲繼成先業。及齊永明末，沈約所撰《[[宋書]]》稱「松之已後無聞焉」。子野更撰為《宋略》二十卷，其敘事評論多善，而云：「戮淮南太守沈璞，以其不從義師故也」。約懼，徒跣謝之，請兩釋焉。歎其述作曰：「吾弗逮也。」蘭陵蕭琛言其評論可與過秦、王命分路揚鑣。於是吏部尚書徐勉言之于武帝，以為著作郎，掌修國史及起居注。頃之，兼中書通事舍人，尋除通直員外，著作、舍人如故。敕又掌中書詔誥。","raw_path":"sources/nanshi/wikisource-1554233-raw.wikitext"},"id":"c-nanshi-033-pei-family:p018","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-nanshi-033-pei-family:p018:m0002","start":2,"end":4,"surface":"子野","kind":"person","person_id":"4ni_4t1_4o9_BB*AAAAAA","status":"contextual_provisional","interpretation_note":"字幾原、父昭明、著宋略、掌國史及中大通卒，梁030同字、同家系、同著述與朝事。"},{"id":"c-nanshi-033-pei-family:p018:m0006","start":6,"end":8,"surface":"松之","kind":"person","person_id":"4ni_4t1_4o9_BB*AAA","status":"contextual_provisional","interpretation_note":"裴松之字世期、祖昧父珪、注陳壽三國志及子駰，與宋064同組識別特徵。"},{"id":"c-nanshi-033-pei-family:p018:m0017","start":17,"end":20,"surface":"何承天","kind":"person","person_id":"92h_l93_ixy","status":"contextual_provisional","interpretation_note":"松之受命續何承天國史、未成而卒；宋064與梁030同一續宋史事，何承天為先修史者。"},{"id":"c-nanshi-033-pei-family:p018:m0028","start":28,"en