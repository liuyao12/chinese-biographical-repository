t":532,"end":533,"surface":"術","kind":"person","person_id":"44b_097_e2b"},{"id":"c-jinshu-100-phase5-sujun:line125:m0538","start":538,"end":540,"surface":"溫嶠","kind":"person","person_id":"6v8_pk9_7k5"},{"id":"c-jinshu-100-phase5-sujun:line125:m0549","start":549,"end":550,"surface":"碩","kind":"person","person_id":"lrg_cze_g1l_A"},{"id":"c-jinshu-100-phase5-sujun:line125:m0563","start":563,"end":564,"surface":"碩","kind":"person","person_id":"lrg_cze_g1l_A"},{"id":"c-jinshu-100-phase5-sujun:line125:m0565","start":565,"end":566,"surface":"晃","kind":"person","person_id":"af7_a2c_011"},{"id":"c-jinshu-100-phase5-sujun:line125:m0571","start":571,"end":572,"surface":"其","kind":"unresolved","person_id":null,"status":"unresolved","resolution_note":"韓晃等之眾群體。"},{"id":"c-jinshu-100-phase5-sujun:line125:m0574","start":574,"end":576,"surface":"張健","kind":"person","person_id":"8f5_74b_457"},{"id":"c-jinshu-100-phase5-sujun:line125:m0596","start":596,"end":597,"surface":"逸","kind":"person","person_id":"63b_09a_c6f"},{"id":"c-jinshu-100-phase5-sujun:line125:m0598","start":598,"end":600,"surface":"李湯","kind":"person","person_id":"c69_2e6_8d9"}],"source_position":{"first_line":125,"last_line":125,"revision_id":2614279,"editorial_excerpt_boundary":true},"text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","chapter_id":"c-jinshu-100-phase5-sujun","book_id":"b-jinshu-100","work_id":"w-jinshu","source_id":"s-jinshu-100-phase5"}],"sources":[{"chapter_id":"c-jinshu-100-phase5-sujun","work_id":"w-jinshu","book_id":"b-jinshu-100","source_id":"s-jinshu-100-phase5","source":{"title":"蘇峻亂中逸、碩完整紀事段","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7100&oldid=2614279","permalink":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7100&oldid=2614279","revision_id":2614279,"accessed_on":"2026-10-19","extent":"固定修訂完整一段；非全卷或完整列傳。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文與維基文庫數位轉錄；保留歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，未核底本影像","wikitext_sha256":"24f6c10f4c2d024afbb840c29ca65487326dd437a668ee4c915d9f8ff43e2e07","response_sha256":"2b84d174f2e98723882e438aeff343c626530f9106a2cad3ae4eed2f5dc5ae1f","normalization":{"character_conversion":{},"extraction_note":"僅移除段首縮排，不改正文異體、疑字或標點。","excerpts":[{"source_lines":[125,125],"raw_quote":"時溫嶠、陶侃已唱義于武昌，峻聞兵起，用參軍賈甯計，還據石頭，更分兵距諸義軍，所過無不殘滅。嶠等將至，峻遂遷天子于石頭，逼迫居人，盡聚之後苑，使懷德令匡術守苑城。嶠等既到，乃築壘于白石，峻率眾攻之，幾至陷沒。東西抄掠，多所擒虜，兵威日盛，戰無不克，由是義眾沮衄，人懷異計。朝士之奔義軍者，皆云：「峻狡黠有智力，其徒黨驍勇，所向無敵。惟當以天討有罪，誅滅不久；若以人事言之，未易除也。」溫嶠怒曰：「諸君怯懦，乃是譽賊。」及後累戰不捷，嶠亦深憚之。管商等進攻吳郡，焚吳縣、海監、嘉興，敗諸義軍。韓晃又攻宣城，害太守桓彝。商等又焚余杭，而大敗于武康，退還義興。嶠與趙胤率步兵萬人，從白石南上，欲以臨之。峻與匡孝將八千人逆戰，峻遣子碩與孝以數十騎先薄趙胤，敗之。峻望見胤走，曰：「孝能破賊，我更不如乎！」因舍其眾，與數騎北下突陣，不得入，將回趨白木陂，牙門彭世、李千等投之以矛，墜馬，斬首臠割之，焚其骨，三軍皆稱萬歲。峻司馬任讓等共立峻弟逸為主。求峻屍不獲，碩乃發庾亮父母墓，剖棺焚屍。逸閉城自守。韓晃聞峻死，引兵赴石頭。管商及弘徽進攻庱亭壘，督護李閎及輕車長史滕含擊破之，斬首千級。商率眾走延陵，李閎與庱亭諸軍追之，斬獲數千級。商詣庾亮降，匡術舉苑城降。韓晃與蘇逸等並力攻術，不能陷。溫嶠等選精銳將攻賊營，碩率驍勇數百渡淮而戰，於陣斬碩。晃等震懼，以其眾奔張健于曲阿，門厄不得出，更相蹈藉，死者萬數。逸為李湯所執，斬于車騎府。","raw_sha256":"d22151101f0ca7ea3bb72de52129148c862e55f2e5c5b2fb4dac35bd9fe17486"}]}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true}}
