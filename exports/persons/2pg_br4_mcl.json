intro:p001:m0132","c-jinshu-079-xielang-family:p001:m0073","c-jinshu-079-xielang-family:p001:m0084","c-jinshu-079-xielang-family:p001:m0098"]},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-075","chapter_id":"c-jinshu-075-xunsong-families","source_id":"s-jinshu-075-xunsong-families","paragraph_id":"c-jinshu-075-xunsong-families:xunxian-intro:p001","quote_passage_ref":"data/corpus/jinshu/075.json"},{"work_id":"w-jinshu","book_id":"b-jinshu-079","chapter_id":"c-jinshu-079-xielang-family","source_id":"s-jinshu-079-xielang-family","paragraph_id":"c-jinshu-079-xielang-family:p001","quote_passage_ref":"data/corpus/jinshu/079.json"}],"rationale":"卷79謝安所訪王蒙之子修、敬仁，與卷93王濛之子修字敬仁相合；卷75同儕作太原王濛。共用既有身份，保留蒙與濛各見證原字，太原支不合入琅邪王氏。","references":[{"title":"《晉書》卷93王濛傳首","url":"https://zh.wikisource.org/w/index.php?oldid=1548000","source_revision":1548000,"source_position":{"first_line":69,"last_line":69},"quote":"王濛，字仲祖","raw_context_quote":"　　王濛，字仲祖，哀靖皇后父也。曾祖黯，歷位尚書。祖佑，北軍中候。父訥，新淦令。濛少時放縱不羈，不為鄉曲所齒，晚節始克己勵行，有風流美譽，虛己應物，恕而後行，莫不敬愛焉。事諸母甚謹，奉祿資產常推厚居薄，喜慍不形於色，不修小潔，而以清約見稱。善隸書。美姿容，嘗覽鏡自照，稱其父字曰：「王文開生如此兒邪！」居貧，帽敗，自入市買之，嫗悅其貌，遺以新帽，時人以為達。與沛國劉惔齊名友善，惔常稱濛性至通，而自然有節，濛每云：「劉君知我，勝我自知。」時人以惔方荀奉倩，濛比袁曜卿，凡稱風流者，舉濛、惔為宗焉。","raw_context_quote_sha256":"21d30b25c2abc03dbe50995cb917307f31ab4914a006e32655eea4cd02c16a17","wikitext_sha256":"8fc7f8b8a8a5a33a18c016006082a49f92e418f8fba965e1068b3e4e2016ff7e","scope":"primary_parallel_context_identification","image_verified":false},{"title":"《晉書》卷93王濛二子","url":"https://zh.wikisource.org/w/index.php?oldid=1548000","source_revision":1548000,"source_position":{"first_line":73,"last_line":73},"quote":"有二子：修、蘊","raw_context_quote":"　　簡文帝之為會稽王也，嘗與孫綽商略諸風流人，綽言曰：「劉惔清蔚簡令，王濛溫潤恬和，桓溫高爽邁出。謝尚清易令達，而濛性和暢，能言理，辭簡而有會。」及簡文帝輔政，益貴幸之，與劉惔號為入室之賓。轉司徒左長史。晚求為東陽，不許。及濛病，乃恨不用之。濛聞之曰：「人言會稽王癡，竟癡也！」疾漸篤，於燈下轉麈尾視之，歎曰：「如此人曾不得四十也！」年三十九卒。臨殯，劉惔以犀杷麈尾置棺中，因慟絕久之。謝安亦常稱濛云：「王長史語甚不多，可謂有令音。」有二子：修、蘊。","raw_context_quote_sha256":"aab6edcdca8614c642828a1e84e1061e939f5be2eb13b958964a878167b4e2e2","wikitext_sha256":"8fc7f8b8a8a5a33a18c016006082a49f92e418f8fba965e1068b3e4e2016ff7e","scope":"primary_parallel_context_identification","image_verified":false},{"title":"《晉書》卷93王修傳首","url":"https://zh.wikisource.org/w/index.php?oldid=1548000","source_revision":1548000,"source_position":{"first_line":75,"last_line":75},"quote":"修字敬仁","raw_context_quote":"　　修字敬仁，小字苟子<ref>苟子　各本皆作「荀子」。斠注：世說文學作「苟子」。按：世說文學、賞譽、品藻稱「苟子」者六七見，無作「荀子」者。通志一六五亦作「苟子」，今據改。</ref>。明秀有美稱，善隸書，號曰流奕清舉。年十二，作《賢全論》。濛以示劉惔曰：「敬仁此論，便足以參微言。」起家著作郎、琅邪王文學，轉中軍司馬，未拜而卒，年二十四。臨終，歎曰：「無愧古人，年與之齊矣。」","raw_context_quote_sha256":"92d6ed347065c63d3da452c3c403b23af06e0c40cc42692456084feb30274b12","wikitext_sha256":"8fc7f8b8a8a5a33a18c016006082a49f92e418f8fba965e1068b3e4e2016ff7e","scope":"primary_parallel_context_identification","image_verified":false}],"human_reviewed":false,"model":null},{"id":"d-nanshi024-zhongzu-wangmeng","person_id":"2pg_br4_mcl","surfaces":["仲祖"],"scope":"same_chapter","chapter_ids":["c-nanshi-024-wang-family"],"status":"contextual_provisional","confidence_level":"moderate","identification_basis":{"kind":"source_context","target_mention_ids":["c-nanshi-024-wang-family:line039:m0043"]},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-024","chapter_id":"c-nanshi-024-wang-family","source_id":"s-nanshi-024-wang-family","paragraph_id":"c-nanshi-024-wang-family:line039","quote_passage_ref":"data/corpus/nanshi/024.json"}],"rationale":"南史秀之談仲祖之識，與齊書秀之常云位至司徒左長史可以止足的同段仕退意旨對讀；據王濛字仲祖及該職原事暫辨，不將古人之職當秀之新受任。","references":[{"title":"《晉書》卷093正文","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7093&oldid=1548000","source_revision":1548000,"quote":"王濛，字仲祖，哀靖皇后父也。","source_position":{"first_line":69,"last_line":69},"wikitext_sha256":"8fc7f8b8a8a5a33a18c016006082a49f92e418f8fba965e1068b3e4e2016ff7e","image_verified":false},{"title":"《晉書》卷093正文","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7093&oldid=1548000","source_revision":1548000,"quote":"轉司徒左長史。晚求為東陽，不許。","source_position":{"first_line":73,"last_line":73},"wikitext_sha256":"8fc7f8b8a8a5a33a18c016006082a49f92e418f8fba965e1068b3e4e2016ff7e","image_verified":false},{"work_id":"w-nanqishu","book_id":"b-nanqishu-046","chapter_id":"c-nanqishu-046-wangxiuzhi","source_id":"s-nanqishu-046-wangxiuzhi","paragraph_id":"c-nanqishu-046-wangxiuzhi:line021","scope":"narrative_context_only_not_direct_person_attestation","quote_passage_ref":"data/corpus/nanqishu/046.json"}],"human_reviewed":false,"model":null}],"equivalence_decisions":[],"sources":[{"chapter_id":"c-jinshu-075-xunsong-families","work_id":"w-jinshu","book_id":"b-jinshu-075","source_id":"s-jinshu-075-xunsong-families","source_ref":"corpus/jinshu/075.json"},{"chapter_id":"c-jinshu-077-yinhao","work_id":"w-jinshu","book_id":"b-jinshu-077","source_id":"s-jinshu-077-yinhao","source_ref":"corpus/jinshu/077-yinhao.json"},{"chapter_id":"c-jinshu-079-xielang-family","work_id":"w-jinshu","book_id":"b-jinshu-079","source_id":"s-jinshu-079-xielang-family","source_ref":"corpus/jinshu/079.json"},{"chapter_id":"c-nanshi-024-wang-family","work_id":"w-nanshi","book_id":"b-nanshi-024","source_id":"s-nanshi-024-wang-family","source_ref":"corpus/nanshi/024.json"}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true},"assembled_identity":{"person_id":"2pg_br4_mcl","representative_source_person_id":"2pg_br4_mcl","source_person_ids":["2pg_br4_mcl"],"identity_equivalence_decision_ids":[],"parent_person_id":null,"source_assertion_id":null,"assembly_id":"family-wangmeng-xiean-context","root_person_id":"2pg_br4_mcl","status":"editorial_preferred","human_reviewed":false},"passage_refs":[{"chapter":"corpus/jinshu/075.json","id":"c-jinshu-075-xunsong-families:xunxian-intro:p001"},{"chapter