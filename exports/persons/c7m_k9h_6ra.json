d_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"person_id":"c7m_k9h_6ra","surname":"馮","ming":"嵩","additional_names":[],"chapter_id":"c-jinshu-044-luqin-family-rendered","paragraph_id":"c-jinshu-044-luqin-family-rendered:p009","quote":"及東海王越奉迎大駕，顒啟帝復穎還鄴，以志為魏郡太守，加左將軍，隨穎北鎮。行達洛陽，而平昌公模遣前鋒督護馮嵩距穎。穎還長安，未至而聞顒斬張方，求和於越。穎住華陰，志進長安，詣闕陳謝，即還就穎于武關。奔南陽，復為劉陶所驅，回詣河北。及穎薨，官屬奔散，唯志親自殯送，時人嘉之。越命志為軍諮祭酒，遷衛尉，永嘉末，轉尚書。洛陽沒，志將妻子北投并州刺史劉琨。至陽邑，為劉粲所虜，與次子謐、詵等俱遇害於平陽。長子諶。","note":"本段具名/明姓；名未知留空，不將爵號或親屬稱謂塞入姓名。","status":"editorial_provisional","human_reviewed":false,"model":null,"work_id":"w-jinshu","book_id":"b-jinshu-044","source_id":"s-jinshu044-lu-rendered-oldcapture"}],"mentions":[{"id":"c-jinshu-037-gaomi-nanyang-ws2630018:p018:m0017","start":17,"end":19,"surface":"馮嵩","kind":"person","person_id":"c7m_k9h_6ra","status":"contextual_provisional","source_identity_role":"fengsong","identity_reading_ref":"source-evidence/jin037-gaomi-nanyang/identity-readings.json#fengsong","paragraph_id":"c-jinshu-037-gaomi-nanyang-ws2630018:p018","chapter_id":"c-jinshu-037-gaomi-nanyang-ws2630018"},{"id":"c-jinshu-044-luqin-family-rendered:p009:m0051","start":51,"end":53,"surface":"馮嵩","kind":"person","person_id":"c7m_k9h_6ra","status":"contextual_provisional","resolution_note":"本篇來源內具名角色；跨篇同指未作肯定。身份審讀：fengsong。","source_identity_role":"fengsong","identity_reading_ref":"source-evidence/jin044-lu-rendered/identity-readings.json#fengsong","paragraph_id":"c-jinshu-044-luqin-family-rendered:p009","chapter_id":"c-jinshu-044-luqin-family-rendered"},{"id":"c-jinshu-059-wei-ying-children:p002:m0178","start":178,"end":180,"surface":"馮嵩","kind":"person","person_id":"c7m_k9h_6ra","status":"contextual_provisional","source_role":"fengsong","paragraph_id":"c-jinshu-059-wei-ying-children:p002","chapter_id":"c-jinshu-059-wei-ying-children"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-037-gaomi-nanyang-ws2630018:p018","text":"會惠帝西遷，虓與從兄平昌公模、長史馮嵩等刑白馬喢血而盟，推東海王越為盟主，虓都督河北諸軍事、驃騎將軍、持節，領豫州刺史。劉喬不受越等節度，乘虛破許。虓自拔渡河，王浚表虓領翼州刺史，資以兵馬。虓入翼州發兵，又南濟河，破喬等。河間王顒聞喬敗，斬張方，傳首於越。越與虓西迎帝，而顒出奔。於是奉天子還都，拜虓為司徒。永興三年暴疾薨，時年三十七。無子，養模子黎為嗣，黎隨模就國，于長安遇害。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","voice_scope":"史臣敘事","mentions":[{"id":"c-jinshu-037-gaomi-nanyang-ws2630018:p018:m0001","start":1,"end":3,"surface":"惠帝","kind":"person","person_id":"dkn_ge4_286_AAAAIAA","status":"contextual_provisional","source_identity_role":"hui","identity_reading_ref":"source-evidence/jin037-gaomi-nanyang/identity-readings.json#hui"},{"id":"c-jinshu-037-gaomi-nanyang-ws2630018:p018:m0006","start":6,"end":7,"surface":"虓","kind":"person","person_id":"dkn_ge4_286_AAADCA","status":"contextual_provisional","source_identity_role":"xiao","identity_reading_ref":"source-evidence/jin037-gaomi-nanyang/identity-readings.json#xiao"},{"id":"c-jinshu-037-gaomi-nanyang-ws2630018:p018:m0010","start":10,"end":14,"surface":"平昌公模","kind":"person","person_id":"dkn_ge4_286_AAADBD","status":"contextual_provisional","source_identity_role":"mo","identity_reading_ref":"source-evidence/jin037-gaomi-nanyang/identity-readings.json#mo"},{"id":"c-jinshu-037-gaomi-nanyang-ws2630018:p018:m0017","start":17,"end":19,"surface":"馮嵩","kind":"person","person_id":"c7m_k9h_6ra","status":"contextual_provisional","source_identity_role":"fengsong","identity_reading_ref":"source-evidence/jin037-gaomi-nanyang/identity-readings.json#fengsong"},{"id":"c-jinshu-037-gaomi-nan