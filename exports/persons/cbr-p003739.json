ji-063-laohan:p024","chapter_id":"c-shiji-063-laohan"},{"id":"c-shiji-063-laohan:m024-0177","start":177,"end":178,"surface":"非","kind":"person","person_id":"cbr-p003739","status":"contextual_provisional","paragraph_id":"c-shiji-063-laohan:p024","chapter_id":"c-shiji-063-laohan"},{"id":"c-shiji-063-laohan:m024-0184","start":184,"end":186,"surface":"韓非","kind":"person","person_id":"cbr-p003739","status":"contextual_provisional","paragraph_id":"c-shiji-063-laohan:p024","chapter_id":"c-shiji-063-laohan"},{"id":"c-shiji-063-laohan:m024-0205","start":205,"end":206,"surface":"非","kind":"person","person_id":"cbr-p003739","status":"contextual_provisional","paragraph_id":"c-shiji-063-laohan:p024","chapter_id":"c-shiji-063-laohan"},{"id":"c-shiji-063-laohan:m025-0003","start":3,"end":5,"surface":"韓子","kind":"person","person_id":"cbr-p003739","status":"contextual_provisional","paragraph_id":"c-shiji-063-laohan:p025","chapter_id":"c-shiji-063-laohan"},{"id":"c-shiji-063-laohan:m025-0022","start":22,"end":24,"surface":"韓子","kind":"person","person_id":"cbr-p003739","status":"contextual_provisional","paragraph_id":"c-shiji-063-laohan:p025","chapter_id":"c-shiji-063-laohan"},{"id":"c-shiji-063-laohan:m026-0059","start":59,"end":61,"surface":"韓子","kind":"person","person_id":"cbr-p003739","status":"contextual_provisional","paragraph_id":"c-shiji-063-laohan:p026","chapter_id":"c-shiji-063-laohan"}],"relations":[],"title_holdings":[{"id":"th-shiji063-009","person_id":"cbr-p003739","title":"公子","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-063-laohan","source_id":"s-shiji-063-laohan","paragraph_id":"c-shiji-063-laohan:p012","quote":"韓非者，韓之諸公子也。喜刑名法術之學，而其歸本於黃老。非為人口吃，不能道說，而善著書。與李斯俱事荀卿，斯自以為不如非。"}],"attestations":[{"id":"th-shiji063-009:a001","paragraph_id":"c-shiji-063-laohan:p012","start":7,"end":9,"surface":"公子","person_mention_id":"c-shiji-063-laohan:m012-0000","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"依來源用稱保存，公號與帝稱不當生前已授同字諡稱；引例保留敘事範圍，不據首次用稱或死亡補任期。制度未定用稱保留未分類。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji063-020","person_id":"cbr-p003739","surfaces":["非","韓子","韓非"],"scope":"same_chapter","chapter_ids":["c-shiji-063-laohan"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-063-laohan:p012","quote":"韓非者，韓之諸公子也。喜刑名法術之學，而其歸本於黃老。非為人口吃，不能道說，而善著書。與李斯俱事荀卿，斯自以為不如非。"},{"paragraph_id":"c-shiji-063-laohan:p013","quote":"非見韓之削弱，數以書諫韓王，韓王不能用。於是韓非疾治國不務修明其法制，執勢以御其臣下，富國彊兵而以求人任賢，反舉浮淫之蠹而加之於功實之上。以為儒者用文亂法，而俠者以武犯禁。寬則寵名譽之人，急則用介胄之士。今者所養非所用，所用非所養。悲廉直不容於邪枉之臣，觀往者得失之變，故作《孤憤》、《五蠹》、《內外儲》、《說林》、《說難》十餘萬言。"},{"paragraph_id":"c-shiji-063-laohan:p014","quote":"然韓非知說之難，為《說難》書甚具，終死於秦，不能自脫。"},{"paragraph_id":"c-shiji-063-laohan:p024","quote":"人或傳其書至秦。秦王見《孤憤》、《五蠹》之書，曰：「嗟乎，寡人得見此人與之游，死不恨矣！」李斯曰：「此韓非之所著書也。」秦因急攻韓。韓王始不用非，及急，乃遣非使秦。秦王悅之，未信用。李斯、姚賈害之，毀之曰：「韓非，韓之諸公子也。今王欲并諸侯，非終為韓不為秦，此人之情也。今王不用，久留而歸之，此自遺患也，不如以過法誅之。」秦王以為然，下吏治非。李斯使人遺非藥，使自殺。韓非欲自陳，不得見。秦王後悔之，使人赦之，非已死矣。"},{"paragraph_id":"c-shiji-063-laohan:p025","quote":"申子、韓子皆著書，傳於後世，學者多有。余獨悲韓子為說難而不能自脫耳。"},{"paragraph_id":"c-shiji-063-laohan:p026","quote":"太史公曰：老子所貴道，虛無，因應變化於無為，故著書辭稱微妙難識。莊子散道德，放論，要亦歸之自然。申子卑卑，施之於名實。韓子引繩墨，切事情，明是非，其極慘礉少恩。皆原於道德之意，而老子深遠矣。"}],"rationale":"依開篇姓名與敘事局部短稱暫接，未名引例人物不補名。老萊子及太史儋與老子分候選不表示確定不同，書名與否定非字不當人物提及，故事與身份確證分開。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-063-laohan:p012","text":"韓非者，韓之諸公子也。喜刑名法術之學，而其歸本於黃老。非為人口吃，不能道說，而善著書。與李斯俱事荀卿，斯自以為不如非。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-063-laohan:m012-0000","start":0,"end":2,"surface":"韓非","kind":"person","person_id":"cbr-p003739","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m012-0024","start":24,"end":26,"surface":"黃老","kind":"unresolved","person_id":null,"status":"unresolved","note":"引例、群體、泛稱、學說或未定指代；不補姓名、成員或肯定史實。"},{"id":"c-shiji-063-laohan:m012-0027","start":27,"end":28,"surface":"非","kind":"person","person_id":"cbr-p003739","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m012-0044","start":44,"end":46,"surface":"李斯","kind":"person","person_id":"cbr-p003740","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m012-0048","start":48,"end":50,"surface":"荀卿","kind":"person","person_id":"cbr-p003741","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m012-0051","start":51,"end":52,"surface":"斯","kind":"person","person_id":"cbr-p003740","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m012-0057","start":57,"end":58,"surface":"非","kind":"person","person_id":"cbr-p003739","status":"contextual_provisional"}],"chapter_id":"c-shiji-063-laohan","book_id":"b-shiji-063","work_id":"w-shiji","source_id":"s-shiji-063-laohan"},{"id":"c-shiji-063-laohan:p013","text":"非見韓之削弱，數以書諫韓王，韓王不能用。於是韓非疾治國不務修明其法制，執勢以御其臣下，富國彊兵而以求人任賢，反舉浮淫之蠹而加之於功實之上。以為儒者用文亂法，而俠者以武犯禁。寬則寵名譽之人，急則用介胄之士。今者所養非所用，所用非所養。悲廉直不容於邪枉之臣，觀往者得失之變，故作《孤憤》、《五蠹》、《內外儲》、《說林》、《說難》十餘萬言。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-063-laohan:m013-0000","start":0,"end":1,"surface":"非","kind":"person","person_id":"cbr-p003739","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m013-0011","start":11,"end":13,"surface":"韓王","kind":"person","person_id":"cbr-p003751","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m013-0014","start":14,"end":16,"surface":"韓王","kind":"person","person_id":"cbr-p003751","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m013-0022","start":22,"end":24,"surface":"韓非","kind":"person","person_id":"cbr-p003739","status":"contextual_provisional"},{"id":"c-shiji-063-laohan:m013-0050","start":50,"end":53,"surface":"人任賢","kind":"unresolved","person_id":null,"status":"unresolved","note":"引例、群體、泛稱、學說或未定指代；不補姓名、成員或肯定史實。"},{"id":"c-shiji-063-laohan:m