,"kind":"person","person_id":"otw_1ui_wba_E","status":"contextual_provisional"},{"id":"c-songshu-050-hu-fan-household:p001:m0170","start":170,"end":172,"surface":"寶世","kind":"person","person_id":"otw_1ui_wba_F","status":"contextual_provisional"},{"id":"c-songshu-050-hu-fan-household:p001:m0184","start":184,"end":186,"surface":"乾秀","kind":"person","person_id":"otw_1ui_wba_AA","status":"contextual_provisional"}],"chapter_id":"c-songshu-050-hu-fan-household","book_id":"b-songshu-050","work_id":"w-songshu","source_id":"s-songshu-050-hu-fan-household-ws2371899"},{"id":"c-songshu-050-huzunshi:p001","text":"藩第十四子遵世，為臧質寧遠參軍，去職還家，與孔熙先同逆謀，太祖以藩功臣，不欲顯其事，使江州以他事收殺之。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":26,"last_line":26,"raw_start":1774,"raw_end":1826,"raw_character_offsets":[1774,1775,1776,1777,1778,1779,1780,1781,1782,1783,1784,1785,1786,1787,1788,1789,1790,1791,1792,1793,1794,1795,1796,1797,1798,1799,1800,1801,1802,1803,1804,1805,1806,1807,1808,1809,1810,1811,1812,1813,1814,1815,1816,1817,1818,1819,1820,1821,1822,1823,1824,1825],"revision_id":2371899},"mentions":[{"id":"c-songshu-050-huzunshi:p001:m0000","start":0,"end":1,"surface":"藩","kind":"person","person_id":"otw_1ui_wba","status":"contextual_provisional"},{"id":"c-songshu-050-huzunshi:p001:m0005","start":5,"end":7,"surface":"遵世","kind":"person","person_id":"otw_1ui_wba_B","status":"contextual_provisional"},{"id":"c-songshu-050-huzunshi:p001:m0009","start":9,"end":11,"surface":"臧質","kind":"person","person_id":"0zd_9uz_t7m_ABA","status":"contextual_provisional"},{"id":"c-songshu-050-huzunshi:p001:m0022","start":22,"end":25,"surface":"孔熙先","kind":"person","person_id":"vhw_07a_wzm_ABA","status":"contextual_provisional"},{"id":"c-songshu-050-huzunshi:p001:m0032","start":32,"end":33,"surface":"藩","kind":"person","person_id":"otw_1ui_wba","status":"contextual_provisional"}],"chapter_id":"c-songshu-050-huzunshi","book_id":"b-songshu-050","work_id":"w-songshu","source_id":"s-songshu-050-huzunshi-ws2371899"},{"id":"c-songshu-074-xuanmo-zangzhi:p001","text":"臧質字含文，東莞莒人。父熹字義和，武敬皇后弟也。與兄燾並好經籍。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":11,"last_line":11,"raw_start":189,"raw_end":221,"raw_character_offsets":[189,190,191,192,193,194,195,196,197,198,199,200,201,202,203,204,205,206,207,208,209,210,211,212,213,214,215,216,217,218,219,220],"revision_id":2118597},"mentions":[{"id":"c-songshu-074-xuanmo-zangzhi:p001:m0000","start":0,"end":2,"surface":"臧質","kind":"person","person_id":"0zd_9uz_t7m_ABA","status":"contextual_provisional"},{"id":"c-songshu-074-xuanmo-zangzhi:p001:m0003","start":3,"end":5,"surface":"含文","kind":"person","person_id":"0zd_9uz_t7m_ABA","status":"contextual_provisional"},{"id":"c-songshu-074-xuanmo-zangzhi:p001:m0012","start":12,"end":13,"surface":"熹","kind":"person","person_id":"0zd_9uz_t7m_AB","status":"contextual_provisional"},{"id":"c-songshu-074-xuanmo-zangzhi:p001:m0014","start":14,"end":16,"surface":"義和","kind":"person","person_id":"0zd_9uz_t7m_AB","status":"contextual_provisional"},{"id":"c-songshu-074-xuanmo-zangzhi:p001:m0026","start":26,"end":27,"surface":"燾","kind":"person","person_id":"fx3_a98_dj5","status":"contextual_provisional"}],"chapter_id":"c-songshu-074-xuanmo-zangzhi","book_id":"b-songshu-074","work_id":"w-songshu","source_id":"s-songshu-074-xuanmo-zangzhi-ws2118597"},{"id":"c-songshu-076-wangxuanmo-ws:p005","text":"元凶弒立，玄謨為冀州刺史。孝武伐逆，玄謨遣濟南太守垣護之將兵赴義。事平，除徐州刺史，加都督。及南郡王義宣與江州刺史臧質反，朝庭假玄謨輔國將軍，拜豫州刺史，與柳元景南討，軍屯梁山，夾岸築偃月壘，水陸待之。義宣遣劉諶之就臧質，陳軍城南，玄謨留老弱守城，悉精兵接戰，賊遂大潰。加都督、前將軍，封曲江縣侯。中軍司馬劉沖之白孝武，言：「玄謨在梁山，與義宣通謀。」上意不能明，使有司奏玄謨多取寶貨，虛張戰簿，與徐州刺史垣護之並免官。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":44,"last_line":44,"raw_start":4274,"raw_end":4521,"raw_character_offsets":[4274,4275,4276,4277,4278,4279,4280,4281,4282,4283,4284,4285,4286,4324,4325,4326,4327,4328,4329,4330,4331,4332,4333,4334,4335,4336,4337,4338,4339,4340,4341,4342,4