,"book_id":"b-songshu-074","chapter_id":"c-songshu-074-xuanmo-zangzhi","source_id":"s-songshu-074-xuanmo-zangzhi-ws2118597","paragraph_id":"c-songshu-074-xuanmo-zangzhi:p001","quote":"臧質字含文，東莞莒人。父熹字義和，武敬皇后弟也。與兄燾並好經籍。","subject_person_mention_id":"c-songshu-074-xuanmo-zangzhi:p001:m0000","object_person_mention_id":"c-songshu-074-xuanmo-zangzhi:p001:m0012"}],"status":"source_attested","interpretation_note":"本傳原詞。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"title_holdings":[{"id":"th-songshu-076-wangxuanmo-ws-5-53","title":"江州刺史","kind":"office","mode":"attestation","person_id":"0zd_9uz_t7m_ABA","attestations":[{"id":"th-songshu-076-wangxuanmo-ws-5-53:a","paragraph_id":"c-songshu-076-wangxuanmo-ws:p005","start":53,"end":57,"surface":"江州刺史","person_mention_id":"c-songshu-076-wangxuanmo-ws:p005:m0057","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-076","chapter_id":"c-songshu-076-wangxuanmo-ws","source_id":"s-songshu-076-wangxuanmo-ws-ws1997726","paragraph_id":"c-songshu-076-wangxuanmo-ws:p005","quote":"元凶弒立，玄謨為冀州刺史。孝武伐逆，玄謨遣濟南太守垣護之將兵赴義。事平，除徐州刺史，加都督。及南郡王義宣與江州刺史臧質反，朝庭假玄謨輔國將軍，拜豫州刺史，與柳元景南討，軍屯梁山，夾岸築偃月壘，水陸待之。義宣遣劉諶之就臧質，陳軍城南，玄謨留老弱守城，悉精兵接戰，賊遂大潰。加都督、前將軍，封曲江縣侯。中軍司馬劉沖之白孝武，言：「玄謨在梁山，與義宣通謀。」上意不能明，使有司奏玄謨多取寶貨，虛張戰簿，與徐州刺史垣護之並免官。","person_mention_id":"c-songshu-076-wangxuanmo-ws:p005:m0057"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-041-zhouyong-complete:p006","text":"　　顒於鍾山西立隱舍，休沐則歸之。轉太子僕，兼著作，撰起居注。遷中書郎，兼著作如故。常遊侍東宮。少從外氏車騎將軍臧質家得衞恒散隷書法，學之甚工。文惠太子使顒書玄圃茅齋壁，國子祭酒何胤以倒薤書求就顒換之，顒笑而答曰：「天下有道，丘不與易也。」","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":81,"last_line":81,"raw_start":6684,"raw_end":6804,"raw_character_offsets":[6684,6685,6686,6687,6688,6689,6690,6691,6692,6693,6694,6695,6696,6697,6698,6699,6700,6701,6702,6703,6704,6705,6706,6707,6708,6709,6710,6711,6712,6713,6714,6715,6716,6717,6718,6719,6720,6721,6722,6723,6724,6725,6726,6727,6728,6729,6730,6731,6732,6733,6734,6735,6736,6737,6738,6739,6740,6741,6742,6743,6744,6745,6746,6747,6748,6749,6750,6751,6752,6753,6754,6755,6756,6757,6758,6759,6760,6761,6762,6763,6764,6765,6766,6767,6768,6769,6770,6771,6772,6773,6774,6775,6776,6777,6778,6779,6780,6781,6782,6783,6784,6785,6786,6787,6788,6789,6790,6791,6792,6793,6794,6795,6796,6797,6798,6799,6800,6801,6802,6803],"revision_id":2044621},"mentions":[{"id":"c-nanqishu-041-zhouyong-complete:p006:m0002","start":2,"end":3,"surface":"顒","kind":"person","person_id":"vkd_5ff_i23","status":"contextual_provisional"},{"id":"c-nanqishu-041-zhouyong-complete:p006:m0056","start":56,"end":58,"surface":"臧質","kind":"person","person_id":"0zd_9uz_t7m_ABA","status":"contextual_provisional"},{"id":"c-nanqishu-041-zhouyong-complete:p006:m0060","start":60,"end":62,"surface":"衞恒","kind":"person","person_id":"ukq_xq2_fxj","status":"contextual_provisional"},{"id":"c-nanqishu-041-zhouyong-complete:p006:m0072","start":72,"end":76,"surface":"文惠太子","kind":"person","person_id":"ipq_o9t_wdh","status":"contextual_provisional"},{"id":"c-nanqishu-041-zhouyong-complete:p006:m0077","start":77,"end":78,"surface":"顒","kind":"person","person_id":"vkd_5ff_i23","status":"contextual_provisional"},{"id":"c-nanqishu-041-zhouyong-complete:p006:m0089","start":89,"end":91,"surface":"何胤","kind":"person","person_id":"vb0_ehz_mxj","status":"contextual_provisional"},{"id":"c-nanqishu-041-zhouyong-complete:p006:m0097","start":97,"end":98,"surface":"顒","kind":"person","person_id":"vkd_5ff_i23","status":"contextual_provisional"},{"id":"c-nanqishu-041-zhouyong-complete:p006:m0101","start":101,"end":102,"surface":"顒","kind":"person","person_id":"vkd_5ff_i23","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-041-zhouyong-complete","book_id":"b-nanqishu-041","work_id":"w-nanqishu","source_id":"s-nanqishu-041-zhouyong-complete-ws2044621"},{"id":"c-nanqishu-054-recluses-complete:p040","text":"　　純篤好學，括東西晉爲一書，紀、錄、志、傳百一十卷。隱居京口教授。南徐州辟西曹，舉秀才，不就。太祖爲揚州，徵榮緒爲主簿，不到。司徒褚淵少時嘗命駕尋之。建元中，啟太祖曰：「榮緒，朱方隱者。昔臧質在宋，以國戚出牧彭岱，引爲行佐，非其所好，謝疾求免。蓬廬守志，漏濕是安，灌蔬終老。與友關康之沈深典素，追古著書，撰《晉史》十袠，贊論雖無逸才，亦足彌綸一代。臣歲時往京口，早與之遇。近報其取書，始方送出，庶得備錄渠閣，採異甄善。」上答曰：「公所道臧榮緒者，吾甚志之。其有史翰，欲令入天祿，甚佳。」","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":106,"last_line":106,"raw_start":5842,"raw_end":6086,"raw_character_offsets":[5842,5843,5844,5845,5846,5847,5848,5849,5850,5851,5852,5853,5854,5855,5856,5857,5858,5859,5860,5861,5862,5863,5864,5865,5866,5867,5868,5869,5870,5871,5872,5873,5874,5875,5876,5877,5878,5879,5880,5881,5882,5883,5884,5885,5886,5887,5888,5889,5890,5891,5892,5893,5894,5895,5896,5897,5898,5899,5900,5901,5902,5903,5904,5905,5906,5907,5908,5909,5910,5911,5912,5913,5914,5915,5916,5917,5918,5919,5920,5921,5922,5923,5924,5925,5926,5927,5928,5929,5930,5931,5932,5933,5934,5935,5936,5937,5938,5939,5940,5941,5942,5943,5944,5945,5946,5947,5948,5949,5950,5951,5952,5953,5954,5955,5956,5957,5958,5959,5960,5961,5962,5963,5964,5965,5966,5967,5968,5969,5970,5971,5972,5973,5974,5975,5976,5977,5978,5979,5980,5981,5982,5983,5984,5985,5986,5987,5988,5989,5990,5991,5992,5993,5994,5995,5996,5997,5998,5999,6000,6001,6002,6003,6004,6005,6006,6007,6008,6009,6010,6011,6012,6013,6014,6015,6016,6017,6018,6019,6020,6021,6022,6023,6024,6025,6026,6027,6028,6029,6030,6031,6032,6033,6034,6035,6036,6037,6038,6039,6040,6041,6042,6043,6044,6045,6046,6047,6048,6049,6050,6051,6052,6053,6054,6055,6056,6057,6058,6059,6060,6061,6062,6063,6064,6065,6066,6067,6068,6069,6070,6071,6072,6073,6074,6075,6076,6077,6078,6079,6080,6081,6082,6083,6084,6085],"revision