。服闋，除尚書左丞。三年，昭明太子薨，高祖立晉安王綱爲皇太子，將出詔，唯召尚書左僕射何敬容、宣惠將軍孔休源及徵三人與議。徵時年位尚輕，而任遇已重。四年，累遷中書郎，鴻臚卿、舍人如故。六年，出爲北中郎豫章王長史、南蘭陵太守。大同二年，卒官，時年三十七。友人琅邪王籍集其文爲二十卷。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-liangshu-050-xiezheng:p004:u0015","start":15,"end":16,"surface":"母","person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"謝徵母，傳未具名。"},{"id":"c-liangshu-050-xiezheng:p004:m0055","start":55,"end":56,"surface":"綱","person_id":"rtd_v0b_nyn","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"},{"id":"c-liangshu-050-xiezheng:p004:m0072","start":72,"end":75,"surface":"何敬容","person_id":"8ke_fzu_5pg","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"},{"id":"c-liangshu-050-xiezheng:p004:m0080","start":80,"end":83,"surface":"孔休源","person_id":"g7c_o6p_gu1","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"},{"id":"c-liangshu-050-xiezheng:p004:m0084","start":84,"end":85,"surface":"徵","person_id":"684_eaa_511_AAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"},{"id":"c-liangshu-050-xiezheng:p004:u0085","start":85,"end":87,"surface":"三人","person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"前文明列何敬容、孔休源、謝徵。"},{"id":"c-liangshu-050-xiezheng:p004:m0090","start":90,"end":91,"surface":"徵","person_id":"684_eaa_511_AAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"},{"id":"c-liangshu-050-xiezheng:p004:m0159","start":159,"end":161,"surface":"王籍","person_id":"p93_tgr_t8r_AA","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"}],"source_position":{"first_line":114,"last_line":114,"revision_id":1514482,"source_layer":"received_biography","raw_start":9202,"raw_end":9373,"raw_character_offsets":[9202,9203,9204,9205,9206,9209,9210,9211,9212,9213,9214,9215,9216,9217,9218,9219,922