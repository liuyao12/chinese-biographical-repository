i-022-wangxun:p002","chapter_id":"c-nanshi-022-wangxun"}],"relations":[],"title_holdings":[{"id":"th-liang050-xiezheng-25","person_id":"8ke_fzu_5pg","title":"尚書左僕射","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-050","chapter_id":"c-liangshu-050-xiezheng","source_id":"s-liangshu-050-xiezheng-ws1514482","paragraph_id":"c-liangshu-050-xiezheng:p004","quote":"中大通元年，以父喪去職，續又丁母憂。詔起爲貞威將軍，還攝本任。服闋，除尚書左丞。三年，昭明太子薨，高祖立晉安王綱爲皇太子，將出詔，唯召尚書左僕射何敬容、宣惠將軍孔休源及徵三人與議。徵時年位尚輕，而任遇已重。四年，累遷中書郎，鴻臚卿、舍人如故。六年，出爲北中郎豫章王長史、南蘭陵太守。大同二年，卒官，時年三十七。友人琅邪王籍集其文爲二十卷。","person_mention_id":"c-liangshu-050-xiezheng:p004:m0072"}],"attestations":[{"paragraph_id":"c-liangshu-050-xiezheng:p004","surface":"尚書左僕射","start":67,"end":72,"id":"th-liang050-xiezheng-25:a","person_mention_id":"c-liangshu-050-xiezheng:p004:m0072","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"依本傳原稱，他證何敬容作右僕射，宋景仁的官稱另存。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"th-liang050-xiezheng-25-wyd","person_id":"8ke_fzu_5pg","title":"尚書左僕射","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-050","chapter_id":"c-liangshu-050-xiezheng-wyd","source_id":"s-liangshu-050-xiezheng-wyd1739","paragraph_id":"c-liangshu-050-xiezheng-wyd:p004","quote":"中大通元年以父喪去職續又丁母憂詔起為貞威將軍還攝本任服闋除尚書左丞三年昭明太子薨高祖立晉安王綱為皇太子將出詔唯召尚書左僕射何敬容宣惠將軍孔休源及徵三人與議徵時年位尚輕而任遇已重四年累遷中書郎鴻臚卿舍人如故六年出為北中郎豫章王長史南蘭陵太守大同二年卒官時年三十七友人琅邪王籍集其文為二十卷","person_mention_id":"c-liangshu-050-xiezheng-wyd:p004:m0061"}],"attestations":[{"paragraph_id":"c-liangshu-050-xiezheng-wyd:p004","surface":"尚書左僕射","start":56,"end":61,"id":"th-liang050-xiezheng-25-wyd:a1","person_mention_id":"c-liangshu-050-xiezheng-wyd:p004:m0061","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"依本傳原稱，他證何敬容作右僕射，宋景仁的官稱另存。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"th-nanshi019-xieyu-descendants-94-132","person_id":"8ke_fzu_5pg","title":"尙書右僕射","kind":"office","mode":"attestation","attestations":[{"id":"th-nanshi019-xieyu-descendants-94-132:a","paragraph_id":"c-nanshi-019-xieyu-descendants:p008","start":132,"end":137,"surface":"尙書右僕射","person_mention_id":"c-nanshi-019-xieyu-descendants:p008:m0137","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-019","chapter_id":"c-nanshi-019-xieyu-descendants","source_id":"s-nanshi-019-xieyu-descendants-ws1531762","paragraph_id":"c-nanshi-019-xieyu-descendants:p008","quote":"子微字玄度，美風采，好學善屬文，位兼中書舍人。與河東裴子野、沛國劉顯同官友善。時魏中山王元略還北，梁武帝餞於武德殿，賦詩三十韻，限三刻成。微二刻便就，文甚美，帝再覽焉。又爲臨汝侯猷制放生文，亦見賞於世。後除尙書左丞。及昭明太子薨，帝立晉安王綱爲皇太子，將出詔，唯召尙書右僕射何敬容、宣惠將軍孔休源及微三人與議。微時年位尙輕，而任遇已重。後卒於北中郎豫章王長史、南蘭陵太守。文集二十卷。","person_mention_id":"c-nanshi-019-xieyu-descendants:p008:m0137"}],"status":"source_attested","interpretation_note":"本句所載官名，任期無確切年月。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-chenshu-017-wangtong-complete:p002","text":"通，梁世起家國子生，舉明經，為祕書郎、太子舍人。以帝甥封武陽亭侯。累遷王府主簿、限外記室參軍、司徒主簿、太子中庶子、驃騎廬陵王府給事中郎、中權何敬容府長史、給事黃門侍郎，坐事免。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":29,"last_line":29,"raw_start":1227,"raw_end":1368,"raw_character_offsets":[1227,1228,1229,1230,1231,1232,1233,1234,1235,1236,1237,1238,1239,1240,1241,1242,1243,1244,1245,1246,1247,1248,1249,1250,1251,1252,1253,1254,1255,1256,1257,1258,1259,1260,1261,1262,1263,1264,1265,1266,1267,1268,1269,1270,1271,1272,1273,1274,1275,1276,1277,1278,1279,1280,1281,1282,1283,1284,1285,1286,1287,1288,1289,1290,1291,1292,1293,1294,1295,1348,1349,1350,1351,1352,1353,1354,1355,1356,1357,1358,1359,1360,1361,1362,1363,1364,1365,1366,1367],"revision_id":1544244},"mentions":[{"id":"c-chenshu-017-wangtong-complete:p002:m0000","start":0,"end":1,"surface":"通","kind":"person","person_id":"q7m_r8k_2vn_ABAC","status":"contextual_provisional"},{"id":"c-chenshu-017-wangtong-complete:p002:m0025","start":25,"end":26,"surface":"帝","kind":"person","person_id":"fo7_f8v_rmf","status":"contextual_provisional"},{"id":"c-chenshu-017-wangtong-complete:p002:m0060","start":60,"end":63,"surface":"廬陵王","kind":"person","person_id":"fo7_f8v_rmf_G","status":"contextual_provisional"},{"id":"c-chenshu-017-wangtong-complete:p002:m0071","start":71,"end":74,"surface":"何敬容","kind":"person","person_id":"8ke_fzu_5pg","status":"contextual_provisional"}],"chapter_id":"c-chenshu-017-wangtong-complete","book_id":"b-chenshu-017","work_id":"w-chenshu","source_id":"s-chenshu-017-wangtong-complete-ws1544244"},{"id":"c-liangshu-021-wangxun:p001","text":"訓字懷範，幼聰警有識量，徵士何胤見而奇之。年十三，暕亡憂毀，家人莫之識。十六，召見文德殿，應對爽徹。上目送久之，顧謂朱异曰：「可謂相門有相矣。」補國子生，射策高第，除秘書郎，遷太子舍人、秘書丞。轉宣城王文學、友、太子中庶子，掌管記。俄遷侍中，旣拜入見，高祖從容問何敬容曰：「褚彥回年幾爲宰相？」敬容對曰：「少過三十。」上曰：「今之王訓，無謝彥回。」","mentions":[{"id":"c-liangshu-021-wangxun:p001:m0000","surface":"訓","start":0,"end":1,"person_id":"7r6_k52_qji_ABAAAAEAABC","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-liangshu-021-wangxun:p001:m0002","surface":"懷範","start":2,"end":4,"person_id":"7r6_k52_qji_ABAAAAEAABC","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-liangshu-021-wangxun:p001:m0014","surface":"何胤","start":14,"end":16,"person_id":"vb0_ehz_mxj","kind":"person","status":"contextual_provisional","interpretation_note