g:m021-0024","start":24,"end":27,"surface":"孝惠帝","kind":"person","person_id":"cbr-p005290","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p021","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:m021-0034","start":34,"end":36,"surface":"孝惠","kind":"person","person_id":"cbr-p005290","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p021","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:m021-0066","start":66,"end":69,"surface":"孝惠帝","kind":"person","person_id":"cbr-p005290","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p021","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:m032-0015","start":15,"end":18,"surface":"孝惠帝","kind":"person","person_id":"cbr-p005290","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p032","chapter_id":"c-shiji-095-fankuang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji095-040","person_id":"cbr-p005290","scope":"same_chapter","chapter_ids":["c-shiji-095-fankuang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["孝惠","孝惠帝"],"evidence":[{"paragraph_id":"c-shiji-095-fankuang:p010","quote":"孝惠六年，樊噲卒，謚為武侯。子伉代侯。而伉母呂須亦為臨光侯，高后時用事專權，大臣盡畏之。伉代侯九歲，高后崩。大臣誅諸呂、呂須婘屬，因誅伉。舞陽侯中絕數月。孝文帝既立，乃復封噲他庶子市人為舞陽侯，復故爵邑。市人立二十九歲卒，謚為荒侯。子他廣代侯。六歲，侯家舍人得罪他廣，怨之，乃上書曰：「荒侯市人病不能為人，令其夫人與其弟亂而生他廣，他廣實非荒侯子，不當代後。」詔下吏。孝景中六年，他廣奪侯為庶人，國除。"},{"paragraph_id":"c-shiji-095-fankuang:p014","quote":"商事孝惠、高后時，商病，不治。其子寄，字況，與呂祿善。及高后崩，大臣欲誅諸呂，呂祿為將軍，軍於北軍，太尉勃不得入北軍，於是乃使人劫酈商，令其子況紿呂祿，呂祿信之，故與出游，而太尉勃乃得入據北軍，遂誅諸呂。是歲商卒，謚為景侯。子寄代侯。天下稱酈況賣交也。"},{"paragraph_id":"c-shiji-095-fankuang:p018","quote":"還定三秦，從擊項籍。至彭城，項羽大破漢軍。漢王敗，不利，馳去。見孝惠、魯元，載之。漢王急，馬罷，虜在後，常蹶兩兒欲棄之，嬰常收，竟載之，徐行面雍樹乃馳。漢王怒，行欲斬嬰者十餘，卒得脫，而致孝惠、魯元於豐。"},{"paragraph_id":"c-shiji-095-fankuang:p021","quote":"嬰自上初起沛，常為太僕，竟高祖崩。以太僕事孝惠。孝惠帝及高后德嬰之脫孝惠、魯元於下邑之閒也，乃賜嬰縣北第第一，曰「近我」，以尊異之。孝惠帝崩，以太僕事高后。高后崩，代王之來，嬰以太僕與東牟侯入清宮，廢少帝，以天子法駕迎代王代邸，與大臣共立為孝文皇帝，復為太僕。八歲卒，謚為文侯。子夷侯灶立，七年卒。子共侯賜立，三十一年卒。子侯頗尚平陽公主。立十九歲，元鼎二年，坐與父御婢姦罪，自殺，國除。"},{"paragraph_id":"c-shiji-095-fankuang:p032","quote":"嬰自破布歸，高帝崩，嬰以列侯事孝惠帝及呂太后。太后崩，呂祿等以趙王自置為將軍，軍長安，為亂。齊哀王聞之，舉兵西，且入誅不當為王者。上將軍呂祿等聞之，乃遣嬰為大將，將軍往擊之。嬰行至滎陽，乃與絳侯等謀，因屯兵滎陽，風齊王以誅呂氏事，齊兵止不前。絳侯等既誅諸呂，齊王罷兵歸，嬰亦罷兵自滎陽歸，與絳侯、陳平共立代王為孝文皇帝。孝文皇帝於是益封嬰三千戶，賜黃金千斤，拜為太尉。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定異稱。酈寄字況據第14段；夏侯嬰的嬰限定第16至21段，灌嬰限定第22至33段，桓嬰另人。第6與20、28段楚王信和反韓王信分人；未詳名王侯不補名。同名跨篇同指另待逐項證據。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-095-fankuang:p010","text":"孝惠六年，樊噲卒，謚為武侯。子伉代侯。而伉母呂須亦為臨光侯，高后時用事專權，大臣盡畏之。伉代侯九歲，高后崩。大臣誅諸呂、呂須婘屬，因誅伉。舞陽侯中絕數月。孝文帝既立，乃復封噲他庶子市人為舞陽侯，復故爵邑。市人立二十九歲卒，謚為荒侯。子他廣代侯。六歲，侯家舍人得罪他廣，怨之，乃上書曰：「荒侯市人病不能為人，令其夫人與其弟亂而生他廣，他廣實非荒侯子，不當代後。」詔下吏。孝景中六年，他廣奪侯為庶人，國除。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m010-0000","start":0,"end":2,"surface":"孝惠","kind":"person","person_id":"cbr-p005290","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m010-0005","start":5,"end":7,"surface":"樊噲","kind":"person","person_id":"cbr-p005252","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m010-0015","start":15,"end":16,"surface":"伉","kind":"person","person_id":"cbr-p005295","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m010-0020","start":20,"end":21,"surface":"伉","kind":"person","person_id":"cbr-p005295","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m010-0022","start":22,"end":24,"surface":"呂須","kind":"person","person_id":"cbr-p005286","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m010-0030","start":30,"end":32,"surface":"高后","kind":"person","person_id":"cbr-p005285","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m010-0044","start":44,"end":45,"surface":"伉","kind":"person","person_id":"cbr-p005295","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m010-0050","start":50,"end":52,"surface":"高后","kind":"person","person_id":"cbr-p005285","status":