al"},{"id":"c-shiji-095-fankuang:m010-0166","start":166,"end":168,"surface":"他廣","kind":"person","person_id":"cbr-p005293","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m010-0184","start":184,"end":186,"surface":"孝景","kind":"person","person_id":"cbr-p005291","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m010-0190","start":190,"end":192,"surface":"他廣","kind":"person","person_id":"cbr-p005293","status":"contextual_provisional"}],"chapter_id":"c-shiji-095-fankuang","book_id":"b-shiji-095","work_id":"w-shiji","source_id":"s-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:p014","text":"商事孝惠、高后時，商病，不治。其子寄，字況，與呂祿善。及高后崩，大臣欲誅諸呂，呂祿為將軍，軍於北軍，太尉勃不得入北軍，於是乃使人劫酈商，令其子況紿呂祿，呂祿信之，故與出游，而太尉勃乃得入據北軍，遂誅諸呂。是歲商卒，謚為景侯。子寄代侯。天下稱酈況賣交也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m014-0000","start":0,"end":1,"surface":"商","kind":"person","person_id":"cbr-p005307","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m014-0002","start":2,"end":4,"surface":"孝惠","kind":"person","person_id":"cbr-p005290","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m014-0005","start":5,"end":7,"surface":"高后","kind":"person","person_id":"cbr-p005285","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m014-0009","start":9,"end":10,"surface":"商","kind":"person","person_id":"cbr-p005307","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m014-0017","start":17,"end":18,"surface":"寄","kind":"person","person_id":"cbr-p005314","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m014-0020","start":20,"end":21,"surface":"況","kind":"person","person_id":"cbr-p005314","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m014-0023","start":23,"end":25,"surface":"呂祿","kind":"person","person_id":"cbr-p005315","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m014-0028","start":28,"end":30,"surface":"高后","kind":"person","person_id":"cbr-p005