erson_id":"cbr-p005258","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m018-0014","start":14,"end":16,"surface":"項羽","kind":"person","person_id":"cbr-p005258","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m018-0021","start":21,"end":23,"surface":"漢王","kind":"person","person_id":"cbr-p005253","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m018-0032","start":32,"end":34,"surface":"孝惠","kind":"person","person_id":"cbr-p005290","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m018-0035","start":35,"end":37,"surface":"魯元","kind":"person","person_id":"cbr-p005321","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m018-0041","start":41,"end":43,"surface":"漢王","kind":"person","person_id":"cbr-p005253","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m018-0060","start":60,"end":61,"surface":"嬰","kind":"person","person_id":"cbr-p005305","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m018-0076","start":76,"end":78,"surface":"漢王","kind":"person","person_id":"cbr-p005253","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m018-0083","start":83,"end":84,"surface":"嬰","kind":"person","person_id":"cbr-p005305","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m018-0094","start":94,"end":96,"surface":"孝惠","kind":"person","person_id":"cbr-p005290","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m018-0097","start":97,"end":99,"surface":"魯元","kind":"person","person_id":"cbr-p005321","status":"contextual_provisional"}],"chapter_id":"c-shiji-095-fankuang","book_id":"b-shiji-095","work_id":"w-shiji","source_id":"s-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:p021","text":"嬰自上初起沛，常為太僕，竟高祖崩。以太僕事孝惠。孝惠帝及高后德嬰之脫孝惠、魯元於下邑之閒也，乃賜嬰縣北第第一，曰「近我」，以尊異之。孝惠帝崩，以太僕事高后。高后崩，代王之來，嬰以太僕與東牟侯入清宮，廢少帝，以天子法駕迎代王代邸，與大臣共立為孝文皇帝，復為太僕。八歲卒，謚為文侯。子夷侯灶立，七年卒。子共侯賜立，三十一年卒。子侯頗尚平陽公主。立十九歲，元鼎二年，坐與父御婢姦罪，自殺，國除。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m021-0000","start":0,"end":1,"surface":"嬰","kind":"person","person_id":"cbr-p005305","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0013","start":13,"end":15,"surface":"高祖","kind":"person","person_id":"cbr-p005253","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0021","start":21,"end":23,"surface":"孝惠","kind":"person","person_id":"cbr-p005290","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0024","start":24,"end":27,"surface":"孝惠帝","kind":"person","person_id":"cbr-p005290","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0028","start":28,"end":30,"surface":"高后","kind":"person","person_id":"cbr-p005285","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0031","start":31,"end":32,"surface":"嬰","kind":"person","person_id":"cbr-p005305","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0034","start":34,"end":36,"surface":"孝惠","kind":"person","person_id":"cbr-p005290","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0037","start":37,"end":39,"surface":"魯元","kind":"person","person_id":"cbr-p005321","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0048","start":48,"end":49,"surface":"嬰","kind":"person","person_id":"cbr-p005305","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0066","start":66,"end":69,"surface":"孝惠帝","kind":"person","person_id":"cbr-p005290","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0075","start":75,"end":77,"surface":"高后","kind":"person","person_id":"cbr-p005285","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0078","start":78,"end":80,"surface":"高后","kind":"person","person_id":"cbr-p005285","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0082","start":82,"end":84,"surface":"代王","kind":"person","person_id":"cbr-p005271","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0087","start":87,"end":88,"surface":"嬰","kind":"person","person_id":"cbr-p005305","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0092","start":92,"end":95,"surface":"東牟侯","kind":"person","person_id":"cbr-p005306","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0100","start":100,"end":102,"surface":"少帝","kind":"person","person_id":"cbr-p005324","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0109","start":109,"end":111,"surface":"代王","kind":"person","person_id":"cbr-p005271","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0120","start":120,"end":124,"surface":"孝文皇帝","kind":"person","person_id":"cbr-p005271","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0142","start":142,"end":143,"surface":"灶","kind":"person","person_id":"cbr-p005326","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0152","start":152,"end":154,"surface":"賜立","kind":"person","person_id":"cbr-p005325","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0163","start":163,"end":164,"surface":"頗","kind":"person","person_id":"cbr-p005327","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m021-0165","start":165,"end":169,"surface":"平陽公主","kind":"person","person_id":"cbr-p005299","status":"contextual_provisional"}],"chapter_id":"c-shiji-095-fankuang","book_id":"b-shiji-095","work_id":"w-shiji","source_id":"s-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:p032","text":"嬰自破布歸，高帝崩，嬰以列侯事孝惠帝及呂太后。太后崩，呂祿等以趙王自置為將軍，軍長安，為亂。齊哀王聞之，舉兵西，且入誅不當為王者。上將軍呂祿等聞之，乃遣嬰為大將，將軍往擊之。嬰行至滎陽，乃與絳侯等謀，因屯兵滎陽，風齊王以誅呂氏事，齊兵止不前。絳侯等既誅諸呂，齊王罷兵歸，嬰亦罷兵自滎陽歸，與絳侯、陳平共立代王為孝文皇帝。孝文皇帝於是益封嬰三千戶，賜黃金千斤，拜為太尉。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m032-0000","start":0,"end":1,"surface":"嬰","kind":"person","person_id":"cbr-p005296","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m032-0003","start":3,"end":4,"surface"