n_note":"依本段實名及敘述視點。","start":5,"end":7,"surface":"彥淵"},{"id":"c-nanqishu-039-lucheng-wangjian:p001:m0015","person_id":"77h_id3_a0i","kind":"person","status":"contextual_provisional","interpretation_note":"依本段實名及敘述視點。","start":15,"end":16,"surface":"邵"},{"id":"c-nanqishu-039-lucheng-wangjian:p001:m0023","person_id":"77h_id3_a0i_A","kind":"person","status":"contextual_provisional","interpretation_note":"依本段實名及敘述視點。","start":23,"end":24,"surface":"瑗"}],"source_position":{"revision_id":1545485,"first_line":36,"last_line":36,"raw_start":2054,"raw_end":2083,"line_start":0,"line_end":29,"source_layer":"received_biography"},"chapter_id":"c-nanqishu-039-lucheng-wangjian","book_id":"b-nanqishu-039","work_id":"w-nanqishu","source_id":"s-nanqishu-039-lucheng-wangjian-ws1545485"},{"id":"c-nanshi-022-wangjian:p009","text":"帝幸樂遊宴集，謂儉曰：「卿好音樂，孰與朕同？」儉曰：「沐浴唐風，事兼比屋，亦既在齊，不知肉味。」帝稱善。後幸華林宴集，使各效伎藝。褚彥回彈琵琶，王僧虔、柳世隆彈琴，沈文季歌子夜來，張敬兒舞。儉曰：「臣無所解，唯知誦書。」因跪上前誦相如封禪書。上笑曰：「此盛德之事，吾何以堪之。」後上使陸澄誦孝經，起自「仲尼居」，儉曰：「澄所謂博而寡要。臣請誦之。」乃誦君子之事上章。上曰：「善，張子布更覺非奇也。」於是王敬則脫朝服袒，以絳糾髻，奮臂拍張，叫動左右。上不悅曰：「豈聞三公如此。」答曰：「臣以拍張，故得三公，不可忘拍張。」時以為名答。","mentions":[{"id":"c-nanshi-022-wangjian:p009:m0008","person_id":"7r6_k52_qji_ABAAAAEAA","start":8,"end":9,"surface":"儉","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanshi-022-wangjian:p009:m0023","person_id":"7r6_k52_qji_ABAAAAEAA","start":23,"end":24,"surface":"儉","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanshi-022-wangjian:p009:m0065","person_id":"jyx_72x_8t2","start":65,"end":68,"surface":"褚彥回","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanshi-022-wangjian:p009:m0072","person_id":"7r6_k52_qji_ABAAAAEB","start":72,"end":75,"surface":"王僧虔","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanshi-022-wangjian:p009:m0076","person_id":"5jc_z9b_i2n_AAAA","start":76,"end":79,"surface":"柳世隆","kind":"pers