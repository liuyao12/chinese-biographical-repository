{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"yoc_50k_tps","canonical_person_id":"yoc_50k_tps","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["yoc_50k_tps"],"persons":[{"id":"yoc_50k_tps","label":"晉元帝","status":"active","historicity":"historical_tradition","aliases":[{"surface":"元帝","mention_ids":["c-jinshu-075-xunsong-families:xunsong-cousins:p001:m0000"]},{"surface":"中宗元皇帝","mention_ids":["c-songshu-060-xunbozi:p004:m0159"]}],"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-075","chapter_id":"c-jinshu-075-xunsong-families","source_id":"s-jinshu-075-xunsong-families","paragraph_id":"c-jinshu-075-xunsong-families:xunsong-cousins:p001","mention_id":"c-jinshu-075-xunsong-families:xunsong-cousins:p001:m0000","quote":"元帝"},{"work_id":"w-songshu","book_id":"b-songshu-060","source_id":"s-songshu-060-xunbozi","chapter_id":"c-songshu-060-xunbozi","paragraph_id":"c-songshu-060-xunbozi:p004","mention_id":"c-songshu-060-xunbozi:p004:m0159","quote":"中宗元皇帝"}],"identity_note":"依固定晉書選段與敘事上下文辨識；不補未載本名、日期、父母或婚姻。","review":"ai_provisional"}],"source_mention_summary":[{"source_id":"s-jinshu-075-xunsong-families","work_id":"w-jinshu","book_id":"b-jinshu-075","chapter_id":"c-jinshu-075-xunsong-families","mention_count":1,"mention_ids":["c-jinshu-075-xunsong-families:xunsong-cousins:p001:m0000"],"paragraph_ids":["c-jinshu-075-xunsong-families:xunsong-cousins:p001"],"table_cell_ids":[],"passage_count":1},{"source_id":"s-songshu-060-xunbozi","work_id":"w-songshu","book_id":"b-songshu-060","chapter_id":"c-songshu-060-xunbozi","mention_count":1,"mention_ids":["c-songshu-060-xunbozi:p004:m0159"],"paragraph_ids":["c-songshu-060-xunbozi:p004"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-jinshu-075-xunsong-families","s-songshu-060-xunbozi"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-075-xunsong-families:xunsong-cousins:p001:m0000","start":0,"end":2,"surface":"元帝","kind":"person","person_id":"yoc_50k_tps","status":"contextual_provisional","paragraph_id":"c-jinshu-075-xunsong-families:xunsong-cousins:p001","chapter_id":"c-jinshu-075-xunsong-families"},{"id":"c-songshu-060-xunbozi:p004:m0159","start":159,"end":164,"surface":"中宗元皇帝","kind":"person","person_id":"yoc_50k_tps","status":"contextual_provisional","paragraph_id":"c-songshu-060-xunbozi:p004","chapter_id":"c-songshu-060-xunbozi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-songshu060-cross-002","person_id":"yoc_50k_tps","surfaces":["中宗元皇帝","元帝"],"scope":"cross_chapter","chapter_ids":["c-songshu-060-xunbozi","c-jinshu-075-xunsong-families"],"status":"contextual_provisional","confidence_level":"medium","identification_basis":{"kind":"source_context","target_mention_ids":["c-songshu-060-xunbozi:p004:m0159","c-jinshu-075-xunsong-families:xunsong-cousins:p001:m0000"]},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-060","source_id":"s-songshu-060-xunbozi","chapter_id":"c-songshu-060-xunbozi","paragraph_id":"c-songshu-060-xunbozi:p004","quote":"前散騎常侍江夏公衞璵上表自陳曰：「臣乃祖故太保瓘，於魏咸熙之中，太祖文皇帝為元輔之日，封蕭陽侯，大晉受禪，進爵為公，歷位太保，總錄朝政。于時賈庶人及諸王用事，忌瓘忠節，故楚王瑋矯詔致禍。前朝以瓘秉心忠正，加以伐蜀之勳，故追封蘭陵郡公。永嘉之中，東海王越食蘭陵，換封江夏，戶邑如舊。臣高祖散騎侍郎璪，瓘之嫡孫，纂承封爵。中宗元皇帝以曾祖故右衞將軍崇承襲，逮于臣身。伏聞祠部郎荀伯子表，欲貶降復封蕭陽。夫趙氏之忠，寵延累葉，漢祖開封，誓以山河。伏願陛下錄既往之勳，垂罔極之施，乞出臣表，付外參詳。」潁川陳茂先亦上表曰：「祠部郎荀伯子表臣七世祖太尉准禍加淮南，不應濫賞。尋先臣以剪除賈謐，封海陵公，事在淮南遇禍之前。後廣陵雖在擾攘之際，臣祖乃始蒙殊遇，歷位元、凱。後被遠外，乃作平州，而猶不至除國，良以先勳深重，百世不泯故也。聖明御世，英輔係興，曾無疑議，以為濫賞。臣以微弱，未齒人倫，加始勉視息，封爵兼嗣。伏願陛下遠錄舊勳，特垂矜察。」詔皆付門下，並不施行。"},{"work_id":"w-jinshu","book_id":"b-jinshu-075","source_id":"s-jinshu-075-xunsong-families","chapter_id":"c-jinshu-075-xunsong-families","paragraph_id":"c-jinshu-075-xunsong-families:xunsong-cousins:p001","quote":"元帝踐阼，徵拜尚書僕射，使崧與協共定中興禮儀。從弟馗早亡，二息序、廞，年各數歲，崧迎與共居，恩同其子。太尉、臨淮公荀顗國胤廢絕，朝庭以崧屬近，欲以崧子襲封。崧哀序孤微，乃讓封與序，論者稱焉。"}],"rationale":"引述永嘉後中宗元皇帝命衞崇承襲，屬晉室中興敘事；與晉書荀崧傳元帝踐阼的同一帝稱及時代交叉，不作宋帝。","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-075-xunsong-families:xunsong-cousins:p001","text":"元帝踐阼，徵拜尚書僕射，使崧與協共定中興禮儀。從弟馗早亡，二息序、廞，年各數歲，崧迎與共居，恩同其子。太尉、臨淮公荀顗國胤廢絕，朝庭以崧屬近，欲以崧子襲封。崧哀序孤微，乃讓封與序，論者稱焉。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-075-xunsong-families:xunsong-cousins:p001:m0000","start":0,"end":2,"surface":"元帝","kind":"person","person_id":"yoc_50k_tps","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-cousins:p001:m0013","start":13,"end":14,"surface":"崧","kind":"person","person_id":"yoo_ox0_545_BABAAA","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-cousins:p001:m0015","start":15,"end":16,"surface":"協","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"議禮同事協，待平行傳記核定，未按模型記憶補姓名。"},{"id":"c-jinshu-075-xunsong-families:xunsong-cousins:p001:m0025","start":25,"end":26,"surface":"馗","kind":"person","person_id":"1ay_9qe_u4h","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-cousins:p001:m0031","start":31,"end":32,"surface":"序","kind":"person","person_id":"0k9_2g5_4su","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-cousins:p001:m0033","start":33,"end":34,"surface":"廞","kind":"person","person_id":"5nd_lzj_e9f","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-cousins:p001:m0040","start":40,"end":41,"surface":"崧","kind":"person","person_id":"yoo_ox0_545_BABAAA","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-cousins:p001:m0057","start":57,"end":59,"surface":"荀顗","kind":"person","person_id":"yoo_ox0_545_BAA","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-cousins:p001:m0067","start":67,"end":68,"surface":"崧","kind":"person","person_id":"yoo_ox0_545_BABAAA","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-cousins:p001:m0073","start":73,"end":74,"surface":"崧","kind":"person","person_id":"yoo_ox0_545_BABAAA","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-cousins:p001:m0078","start":78,"end":79,"surface":"崧","kind":"person","person_id":"yoo_ox0_545_BABAAA","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-cousins:p001:m0080","start":80,"end":81,"surface":"序","kind":"person","person_id":"0k9_2g5_4su","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-cousins:p001:m0088","start":88,"end":89,"surface":"序","kind":"person","person_id":"0k9_2g5_4su","status":"contextual_provisional"}],"source_position":{"first_line":130,"last_line":130,"revision_id":2645530,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-075-xunsong-families","book_id":"b-jinshu-075","work_id":"w-jinshu","source_id":"s-jinshu-075-xunsong-families"},{"id":"c-songshu-060-xunbozi:p004","text":"前散騎常侍江夏公衞璵上表自陳曰：「臣乃祖故太保瓘，於魏咸熙之中，太祖文皇帝為元輔之日，封蕭陽侯，大晉受禪，進爵為公，歷位太保，總錄朝政。于時賈庶人及諸王用事，忌瓘忠節，故楚王瑋矯詔致禍。前朝以瓘秉心忠正，加以伐蜀之勳，故追封蘭陵郡公。永嘉之中，東海王越食蘭陵，換封江夏，戶邑如舊。臣高祖散騎侍郎璪，瓘之嫡孫，纂承封爵。中宗元皇帝以曾祖故右衞將軍崇承襲，逮于臣身。伏聞祠部郎荀伯子表，欲貶降復封蕭陽。夫趙氏之忠，寵延累葉，漢祖開封，誓以山河。伏願陛下錄既往之勳，垂罔極之施，乞出臣表，付外參詳。」潁川陳茂先亦上表曰：「祠部郎荀伯子表臣七世祖太尉准禍加淮南，不應濫賞。尋先臣以剪除賈謐，封海陵公，事在淮南遇禍之前。後廣陵雖在擾攘之際，臣祖乃始蒙殊遇，歷位元、凱。後被遠外，乃作平州，而猶不至除國，良以先勳深重，百世不泯故也。聖明御世，英輔係興，曾無疑議，以為濫賞。臣以微弱，未齒人倫，加始勉視息，封爵兼嗣。伏願陛下遠錄舊勳，特垂矜察。」詔皆付門下，並不施行。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-songshu-060-xunbozi:p004:m0008","start":8,"end":10