{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"dk9_ope_ko7","canonical_person_id":"dk9_ope_ko7","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["dk9_ope_ko7"],"persons":[{"id":"dk9_ope_ko7","label":"文王（司馬相如列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"文王","mention_ids":["c-shiji-117-xiangru:m058-0081"]}],"evidence":[{"mention_id":"c-shiji-117-xiangru:m058-0081","chapter_id":"c-shiji-117-xiangru","paragraph_id":"c-shiji-117-xiangru:p058","quote":"文王"}]}],"source_mention_summary":[{"source_id":"s-shiji117-xiangru","work_id":"w-shiji","book_id":"b-shiji-117","chapter_id":"c-shiji-117-xiangru","mention_count":1,"mention_ids":["c-shiji-117-xiangru:m058-0081"],"paragraph_ids":["c-shiji-117-xiangru:p058"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji117-xiangru"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-117-xiangru:m058-0081","start":81,"end":83,"surface":"文王","kind":"person","person_id":"dk9_ope_ko7","status":"contextual_provisional","paragraph_id":"c-shiji-117-xiangru:p058","chapter_id":"c-shiji-117-xiangru"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-117-xiangru:p058","text":"軒轅之前，遐哉邈乎，其詳不可得聞也。五三六經載籍之傳，維見可觀也。書曰「元首明哉，股肱良哉」。因斯以談，君莫盛於唐堯，臣莫賢於后稷。后稷創業於唐，公劉發跡於西戎，文王改制，爰周郅隆，大行越成，而後陵夷衰微，千載無聲，豈不善始善終哉。然無異端，慎所由於前，謹遺教於後耳。故軌跡夷易，易遵也；湛恩濛湧，易豐也；憲度著明，易則也；垂統理順，易繼也。是以業隆於繦褓而崇冠於二后。揆厥所元，終都攸卒，未有殊尤絕跡可考於今者也。然猶躡梁父，登泰山，建顯號，施尊名。大漢之德，逢湧原泉，沕潏漫衍，旁魄四塞，雲尃霧散，上暢九垓，下溯八埏。懷生之類霑濡浸潤，協氣橫流，武節飄逝，邇陝游原，迥闊泳沫，首惡湮沒，闇昧昭晢，昆蟲凱澤，回首面內。然後囿騶虞之珍群，徼麋鹿之怪獸，鰜一莖六穗於庖，犧雙共抵之獸，獲周餘珍收龜於岐，招翠黃乘龍於沼。鬼神接靈圉，賓於間館。奇物譎詭，俶儻窮變。欽哉，符瑞臻茲，猶以為薄，不敢道封禪。蓋周躍魚隕杭，休之以燎，微夫斯之為符也，以登介丘，不亦恧乎！進讓之道，其何爽與？","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m058-0000","start":0,"end":2,"surface":"軒轅","kind":"person","person_id":"zg6_7x0_rlx","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m058-0056","start":56,"end":58,"surface":"唐堯","kind":"person","person_id":"92c_g3l_una","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m058-0063","start":63,"end":65,"surface":"后稷","kind":"person","person_id":"rbd_piw_ehz","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m058-0066","start":66,"end":68,"surface":"后稷","kind":"person","person_id":"rbd_piw_ehz","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m058-0073","start":73,"end":75,"surface":"公劉","kind":"person","person_id":"6wz_jmz_gmc","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m058-0081","start":81,"end":83,"surface":"文王","kind":"person","person_id":"dk9_ope_ko7","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m058-0182","start":182,"end":184,"surface":"二后","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m058-0362","start":362,"end":364,"surface":"靈圉","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-117-xiangru","book_id":"b-shiji-117","work_id":"w-shiji","source_id":"s-shiji117-xiangru"}],"sources":[{"chapter_id":"c-shiji-117-xiangru","work_id":"w-shiji","book_id":"b-shiji-117","source_id":"s-shiji117-xiangru","source":{"title":"史記／卷117","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷117","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷117&oldid=