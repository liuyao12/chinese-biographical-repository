ntly_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-006-shihuang:p043:m0017","start":17,"end":22,"surface":"仆射周青臣","kind":"person","person_id":"cbr-p000591","status":"contextual_provisional","paragraph_id":"c-shiji-006-shihuang:p043","chapter_id":"c-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:p043:m0185","start":185,"end":187,"surface":"青臣","kind":"person","person_id":"cbr-p000591","status":"contextual_provisional","paragraph_id":"c-shiji-006-shihuang:p043","chapter_id":"c-shiji-006-shihuang"},{"id":"c-shiji-087-lisi:m010-0013","start":13,"end":20,"surface":"博士僕射周青臣","kind":"person","person_id":"cbr-p004891","status":"contextual_provisional","paragraph_id":"c-shiji-087-lisi:p010","chapter_id":"c-shiji-087-lisi"},{"id":"c-shiji-087-lisi:m010-0110","start":110,"end":112,"surface":"青臣","kind":"person","person_id":"cbr-p004891","status":"contextual_provisional","paragraph_id":"c-shiji-087-lisi:p010","chapter_id":"c-shiji-087-lisi"}],"relations":[],"title_holdings":[{"id":"th-shiji087-011","person_id":"cbr-p004891","title":"博士僕射","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-087-lisi","source_id":"s-shiji-087-lisi","paragraph_id":"c-shiji-087-lisi:p010","quote":"始皇三十四年，置酒咸陽宮，博士僕射周青臣等頌始皇威德。齊人淳于越進諫曰：「臣聞之，殷周之王千餘歲，封子弟功臣自為支輔。今陛下有海內，而子弟為匹夫，卒有田常、六卿之患，臣無輔弼，何以相救哉？事不師古而能長久者，非所聞也。今青臣等又面諛以重陛下過，非忠臣也。」始皇下其議丞相。丞相謬其說，絀其辭，乃上書曰：「古者天下散亂，莫能相一，是以諸侯並作，語皆道古以害今，飾虛言以亂實，人善其所私學，以非上所建立。今陛下并有天下，別白黑而定一尊；而私學乃相與非法教之制，聞令下，即各以其私學議之，入則心非，出則巷議，非主以為名，異趣以為高，率群下以造謗。如此不禁，則主勢降乎上，黨與成乎下。禁之便。臣請諸有文學詩書百家語者，蠲除去之。令到滿三十日弗去，黥為城旦。所不去者，醫藥卜筮種樹之書。若有欲學者，以吏為師。」始皇可其議，收去詩書百家之語以愚百姓，使天下無以古非今。明法度，定律令，皆以始皇起。同文書。治離宮別館，周遍天下。明年，又巡狩，外攘四夷，斯皆有力焉。"}],"attestations":[{"id":"th-shiji087-011:a001","paragraph_id":"c-shiji-087-lisi:p010","start":13,"end":17,"surface":"博士僕射","person_mention_id":"c-shiji-087-lisi:m010-0013","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"實際授任、引古、追述與文獻用稱分存；未定日期、死亡、下獄與首次用稱不推定任期端點。假御史謁者侍中、擬任蒙恬相與擬裂地王不作實授。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji006-018","person_id":"cbr-p000591","surfaces":["仆射周青臣","青臣"],"scope":"same_chapter","chapter_ids":["c-shiji-006-shihuang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-006-shihuang:p043","quote":"始皇置酒咸陽宮，博士七十人前為壽。仆射周青臣進頌曰：「他時秦地不過千里，賴陛下神靈明聖，平定海內，放逐蠻夷，日月所照，莫不賓服。以諸侯為郡縣，人人自安樂，無戰爭之患，傳之萬世。自上古不及陛下威德。」始皇悅。博士齊人淳于越進曰：「臣聞殷周之王千餘歲，封子弟功臣，自為枝輔。今陛下有海內，而子弟為匹夫，卒有田常、六卿之臣，無輔拂，何以相救哉？事不師古而能長久者，非所聞也。今青臣又面諛以重陛下之過，非忠臣。」始皇下其議。丞相李斯曰：「五帝不相復，三代不相襲，各以治，非其相反，時變異也。今陛下創大業，建萬世之功，固非愚儒所知。且越言乃三代之事，何足法也？異時諸侯并爭，厚招游學。今天下已定，法令出一，百姓當家則力農工，士則學習法令辟禁。今諸生不師今而學古，以非當世，惑亂黔首。丞相臣斯昧死言：古者天下散亂，莫之能一，是以諸侯并作，語皆道古以害今，飾虛言以亂實，人善其所私學，以非上之所建立。今皇帝并有天下，別黑白而定一尊。私學而相與非法教，人聞令下，則各以其學議之，入則心非，出則巷議，夸主以為名，異取以為高，率群下以造謗。如此弗禁，則主勢降乎上，黨與成乎下。禁之便。臣請史官非秦記皆燒之。非博士官所職，天下敢有藏詩、書、百家語者，悉詣守、尉雜燒之。有敢偶語詩書者棄市。以古非今者族。吏見知不舉者與同罪。令下三十日不燒，黥為城旦。所不去者，醫藥卜筮種樹之書。若有欲學法令者，以吏為師。」制曰：「可。」"}],"rationale":"同一酒宴辯論中引入全稱後續用短名；越字只標且越言，不作地名與族名匹配。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji087-024","person_id":"cbr-p004891","scope":"same_chapter","chapter_ids":["c-shiji-087-lisi"],"status":"contextual_provisional","rationale":"依逐客令、李斯任相及焚書議局部承接暫接；第10段丞相按前段以斯為丞相及末斯皆有力焉暫指李斯。周青臣青臣、三川守李由與由按明示姓名承接；田常屬引古，婚配群體不補個人姓名。","reviewer":"Codex（AI 代理）","surfaces":["博士僕射周青臣","青臣"],"evidence":[{"paragraph_id":"c-shiji-087-lisi:p010","quote":"始皇三十四年，置酒咸陽宮，博士僕射周青臣等頌始皇威德。齊人淳于越進諫曰：「臣聞之，殷周之王千餘歲，封子弟功臣自為支輔。今陛下有海內，而子弟為匹夫，卒有田常、六卿之患，臣無輔弼，何以相救哉？事不師古而能長久者，非所聞也。今青臣等又面諛以重陛下過，非忠臣也。」始皇下其議丞相。丞相謬其說，絀其辭，乃上書曰：「古者天下散亂，莫能相一，是以諸侯並作，語皆道古以害今，飾虛言以亂實，人善其所私學，以非上所建立。今陛下并有天下，別白黑而定一尊；而私學乃相與非法教之制，聞令下，即各以其私學議之，入則心非，出則巷議，非主以為名，異趣以為高，率群下以造謗。如此不禁，則主勢降乎上，黨與成乎下。禁之便。臣請諸有文學詩書百家語者，蠲除去之。令到滿三十日弗去，黥為城旦。所不去者，醫藥卜筮種樹之書。若有欲學者，以吏為師。」始皇可其議，收去詩書百家之語以愚百姓，使天下無以古非今。明法度，定律令，皆以始皇起。同文書。治離宮別館，周遍天下。明年，又巡狩，外攘四夷，斯皆有力焉。"}]}],"equivalence_decisions":[{"id":"eq-shiji087-zhou","person_ids":["cbr-p000591","cbr-p004891"],"canonical_person_id":"cbr-p000591","scope":"cross_chapter","chapter_ids":["c-shiji-006-shihuang","c-shiji-087-lisi"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-006-shihuang","source_id":"s-shiji-006-shihuang","paragraph_id":"c-shiji-006-shihuang:p043","quote":"始皇置酒咸陽宮，博士七十人前為壽。仆射周青臣進頌曰：「他時秦地不過千里，賴陛下神靈明聖，平定海內，放逐蠻夷，日月所照，莫不賓服。以諸侯為郡縣，人人自安樂，無戰爭之患，傳之萬世。自上古不及陛下威德。」始皇悅。博士齊人淳于越進曰：「臣聞殷周之王千餘歲，封子弟功臣，自為枝輔。今陛下有海內，而子弟為匹夫，卒有田常、六卿之臣，無輔拂，何以相救哉？事不師古而能長久者，非所聞也。今青臣又面諛以重陛下之過，非忠臣。」始皇下其議。丞相李斯曰：「五帝不相復，三代不相襲，各以治，非其相反，時變異也。今陛下創大業，建萬世之功，固非愚儒所知。且越言乃三代之事，何足法也？異時諸侯并爭，厚招游學。今天下已定，法令出一，百姓當家則力農工，士則學習法令辟禁。今諸生不師今而學古，以非當世，惑亂黔首。丞相臣斯昧死言：古者天下散亂，莫之能一，是以諸侯并作，語皆道古以害今，飾虛言以亂實，人善其所私學，以非上之所建立。今皇帝并有天下，別黑白而定一尊。私學而相與非法教，人聞令下，則各以其學議之，入則心非，出則巷議，夸主以為名，異取以為高，率群下以造謗。如此弗禁，則主勢降乎上，黨與成乎下。禁之便。臣請史官非秦記皆燒之。非博士官所職，天下敢有藏詩、書、百家語者，悉詣守、尉雜燒之。有敢偶語詩書者棄市。以古非今者族。吏見知不舉者與同罪。令下三十日不燒，黥為城旦。所不去者，醫藥卜筮種樹之書。若有欲學法令者，以吏為師。」制曰：「可。」","mention_ids":["c-shiji-006-shihuang:p043:m0017","c-shiji-006-shihuang:p043:m0185"]},{"chapter_id":"c-shiji-087-lisi","source_id":"s-shiji-087-lisi","paragraph_id":"c-shiji-087-lisi:p010","quote":"始皇三十四年，置酒咸陽宮，博士僕射周青臣等頌始皇威德。齊人淳于越進諫曰：「臣聞之，殷周之王千餘歲，封子弟功臣自為支輔。今陛下有海內，而子弟為匹夫，卒有田常、六卿之患，臣無輔弼，何以相救哉？事不師古而能長久者，非所聞也。今青臣等又面諛以重陛下過，非忠臣也。」始皇下其議丞相。丞相謬其說，絀其辭，乃上書曰：「古者天下散亂，莫能相一，是以諸侯並作，語皆道古以害今，飾虛言以亂實，人善其所私學，以非上所建立。今陛下并有天下，別白黑而定一尊；而私學乃相與非法教之制，聞令下，即各以其私學議之，入則心非，出則巷議，非主以為名，異趣以為高，率群下以造謗。如此不禁，則主勢降乎上，黨與成乎下。禁之便。臣請諸有文學詩書百家語者，蠲除去之。令到滿三十日弗去，黥為城旦。所不去者，醫藥卜筮種樹之書。若有欲學者，以吏為師。」始皇可其議，收去詩書百家之語以愚百姓，使天下無以古非今。明法度，定律令，皆以始皇起。同文書。治離宮別館，周遍天下。明年，又巡狩，外攘四夷，斯皆有力焉。","mention_ids":["c-shiji-087-lisi:m010-0013","c-shiji-087-lisi:m010-0110"]}],"rationale":"咸陽宮酒宴周青臣頌德、淳于越反駁及李斯焚書議相配；仆射與博士僕射原稱保留，首次用稱不補任期。 各篇原字、原文與已發ID保留，同書不視為獨立見證；同指不確證所有紀年、任職、親屬或敘事，不按全域同名批量改號。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-006-shihuang:p043","text":"始皇置酒咸陽宮，博士七十人前為壽。仆射周青臣進頌曰：「他時秦地不過千里，賴陛下神靈明聖，