{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"vfs_qnq_mcc","canonical_person_id":"vfs_qnq_mcc","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["vfs_qnq_mcc"],"persons":[{"id":"vfs_qnq_mcc","label":"孫諮（孫吳將軍，滕胤所召）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"孫諮","mention_ids":["c-sanguozhi-064-suncong-complete:p001:m0192"]}],"evidence":[{"mention_id":"c-sanguozhi-064-suncong-complete:p001:m0192","paragraph_id":"c-sanguozhi-064-suncong-complete:p001","chapter_id":"c-sanguozhi-064-suncong-complete","quote":"孫諮"}],"review":"ai_provisional","identity_note":"孫諮（孫吳將軍，滕胤所召），見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-sanguozhi-064-suncong-complete-ws2263487","work_id":"w-sanguozhi","book_id":"b-sanguozhi-064","chapter_id":"c-sanguozhi-064-suncong-complete","raw_mention_count":1,"mention_ids":["c-sanguozhi-064-suncong-complete:p001:m0192"],"paragraph_ids":["c-sanguozhi-064-suncong-complete:p001"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-sanguozhi-064-suncong-complete:p001:m0192","mention_ids":["c-sanguozhi-064-suncong-complete:p001:m0192"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-sanguozhi-064-suncong-complete-ws2263487"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-064-suncong-complete:p001:m0192","surface":"孫諮","start":192,"end":194,"kind":"person","person_id":"vfs_qnq_mcc","status":"contextual_provisional","paragraph_id":"c-sanguozhi-064-suncong-complete:p001","chapter_id":"c-sanguozhi-064-suncong-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-064-suncong-complete:p001","text":"　　孫綝字子通，與峻同祖。綝父綽為安民都尉。綝始為偏將軍，及峻死，為待中武衛將軍，領中外諸軍事，代知朝政。呂據聞之大恐，與諸督將連名，共表薦滕胤為丞相，綝以胤為大司馬，代呂岱駐武昌。據引兵還，使人報胤，欲共廢綝。綝聞之，遣從兄慮將兵逆據於江都，使中使敕文欽、劉纂、唐諮等合眾擊據，遣侍中左將軍華融、中書丞丁晏告胤取據，並喻胤宜速去意，胤自以禍及，因留融、晏，勒兵自衛，召典軍揚崇、將軍孫諮，告以綝為亂，迫融等使有書難綝。綝不聽，表言胤反，許將軍劉丞以封爵，使率兵騎急攻圍胤。胤又劫融等使詐詔發兵。融等不從，胤皆殺之。胤顏色不變，談笑若常。或勸胤引兵至蒼龍門，「將士見公出，必皆委綝就公」。時夜已半，胤恃與據期。又難舉兵向富，乃約令部曲，說呂侯以在近道，故皆為胤盡死，無離散者。時大風，比曉，據不至。綝兵大會，遂殺及將士數十人，夷胤三族。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":78,"last_line":78,"raw_start":10365,"raw_end":10949,"raw_character_offsets":[10365,10366,10367,10368,10369,10370,10371,10372,10373,10374,10375,10376,10377,10378,10379,10380,10381,10382,10383,10384,10385,10386,10387,10388,10389,10390,10391,10392,10393,10394,10395,10396,10397,10398,10399,10400,10401,10402,10403,10404,10405,10406,10407,10408,10409,10410,10411,10412,10413,10414,10415,10416,10417,10418,10419,10420,10421,10422,10423,10424,10425,10426,10427,10428,10429,10430,10431,10432,10433,10434,10435,10436,10437,10438,10439,10440,10441,10442,10443,10444,10445,10446,10447,10448,10449,10450,10451,10452,10453,10454,10455,10456,10457,10458,10459,10460,10461,10462,10463,10464,10465,10466,10467,10468,10469,10470,10471,10472,10473,10474,10475,10476,10477,10478,10479,10480,10481,10482,10483,10