{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004808","identity_policy":"contextual_provisional","person_ids":["cbr-p004808"],"persons":[{"id":"cbr-p004808","label":"主腐者吏未名（呂不韋列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"主腐者吏","mention_ids":["c-shiji-085-lubuwei:m010-0116"]}],"evidence":[{"mention_id":"c-shiji-085-lubuwei:m010-0116","chapter_id":"c-shiji-085-lubuwei","paragraph_id":"c-shiji-085-lubuwei:p010","quote":"主腐者吏"}]}],"source_mention_summary":[{"source_id":"s-shiji-085-lubuwei","work_id":"w-shiji","book_id":"b-shiji-085","chapter_id":"c-shiji-085-lubuwei","mention_count":1,"mention_ids":["c-shiji-085-lubuwei:m010-0116"],"paragraph_ids":["c-shiji-085-lubuwei:p010"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-085-lubuwei"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-085-lubuwei:m010-0116","start":116,"end":120,"surface":"主腐者吏","kind":"person","person_id":"cbr-p004808","status":"contextual_provisional","paragraph_id":"c-shiji-085-lubuwei:p010","chapter_id":"c-shiji-085-lubuwei"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji085-019","person_id":"cbr-p004808","scope":"same_chapter","chapter_ids":["c-shiji-085-lubuwei"],"status":"contextual_provisional","rationale":"依子楚歸秦、孝文莊襄王序與太子政立王的句群暫接，子政母未補姓名，四公子並列不作同時在世證據；養母與真母、仲父號稱各分存。","reviewer":"Codex（AI 代理）","surfaces":["主腐者吏"],"evidence":[{"paragraph_id":"c-shiji-085-lubuwei:p010","quote":"始皇帝益壯，太后淫不止。呂不韋恐覺禍及己，乃私求大陰人嫪毐以為舍人，時縱倡樂，使毐以其陰闕桐輪而行，令太后聞之，以啗太后。太后聞，果欲私得之。呂不韋乃進嫪毐，詐令人以腐罪告之。不韋又陰謂太后曰：「可事詐腐，則得給事中。」太后乃陰厚賜主腐者吏，詐論之，拔其須眉為宦者，遂得侍太后。太后私與通，絕愛之。有身，太后恐人知之，詐卜當避時，徙宮居雍。嫪毐常從，賞賜甚厚，事皆決於嫪毐。嫪毐家僮數千人，諸客求宦為嫪毐舍人千餘人。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-085-lubuwei:p010","text":"始皇帝益壯，太后淫不止。呂不韋恐覺禍及己，乃私求大陰人嫪毐以為舍人，時縱倡樂，使毐以其陰闕桐輪而行，令太后聞之，以啗太后。太后聞，果欲私得之。呂不韋乃進嫪毐，詐令人以腐罪告之。不韋又陰謂太后曰：「可事詐腐，則得給事中。」太后乃陰厚賜主腐者吏，詐論之，拔其須眉為宦者，遂得侍太后。太后私與通，絕愛之。有身，太后恐人知之，詐卜當避時，徙宮居雍。嫪毐常從，賞賜甚厚，事皆決於嫪毐。嫪毐家僮數千人，諸客求宦為嫪毐舍人千餘人。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-085-lubuwei:m010-0000","start":0,"end":3,"surface":"始皇帝","kind":"person","person_id":"cbr-p004796","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m010-0006","start":6,"end":8,"surface":"太后","kind":"person","person_id":"cbr-p004798","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m010-0012","start":12,"end":15,"surface":"呂不韋","kind":"person","person_id":"cbr-p004790","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m010-0027","start":27,"end":29,"surface":"嫪毐","kind":"person","person_id":"cbr-p004806","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m010-0040","start":40,"end":41,"surface":"毐","kind":"person","person_id":"cbr-p004806","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m010-0051","start":51,"end":53,"surface":"太后","kind":"person","person_id":"cbr-p004798","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m010-0058","start":58,"end":60,"surface":"太后","kind":"person","person_id":"cbr-p004798","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m010-0061","start":61,"end":63,"surface":"太后","kind":"person","person_id":"cbr-p004798","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m010-0071","start":71,"end":74,"surface":"呂不韋","kind":"person","person_id":"cbr-p004790","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m010-0076","start":76,"end":78,"surface":"嫪毐","kind":"person","person_id":"cbr-p004806","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m010-0088","start":88,"end":90,"surface":"不韋","kind":"person","person_id":"cbr-p004790","status":"contextual_provisional"},{"id":"c-shiji-085-lubuwei:m010-