nd":"person","person_id":"g0t_7m5_3bk","status":"contextual_provisional","paragraph_id":"c-shiji-106-wuwang:p012","chapter_id":"c-shiji-106-wuwang"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji106-043","person_id":"g0t_7m5_3bk","surfaces":["鄧都尉"],"scope":"same_chapter","chapter_ids":["c-shiji-106-wuwang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-106-wuwang:p012","quote":"條侯將乘六乘傳，會兵滎陽。至雒陽，見劇孟，喜曰：「七國反，吾乘傳至此，不自意全。又以為諸侯已得劇孟，劇孟今無動。吾據滎陽，以東無足憂者。」至淮陽，問父絳侯故客鄧都尉曰：「策安出？」客曰：「吳兵銳甚，難與爭鋒。楚兵輕，不能久。方今為將軍計，莫若引兵東北壁昌邑，以梁委吳，吳必盡銳攻之。將軍深溝高壘，使輕兵絕淮泗口，塞吳馕道。彼吳梁相敝而糧食竭，乃以全彊制其罷極，破吳必矣。」條侯曰：「善。」從其策，遂堅壁昌邑南，輕兵絕吳馕道。"}],"rationale":"依本篇姓名、原稱及敘事回指暫定；書信、制詔與附載述贊保留上下文，未按同名自動跨篇合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-106-wuwang:p012","text":"條侯將乘六乘傳，會兵滎陽。至雒陽，見劇孟，喜曰：「七國反，吾乘傳至此，不自意全。又以為諸侯已得劇孟，劇孟今無動。吾據滎陽，以東無足憂者。」至淮陽，問父絳侯故客鄧都尉曰：「策安出？」客曰：「吳兵銳甚，難與爭鋒。楚兵輕，不能久。方今為將軍計，莫若引兵東北壁昌邑，以梁委吳，吳必盡銳攻之。將軍深溝高壘，使輕兵絕淮泗口，塞吳馕道。彼吳梁相敝而糧食竭，乃以全彊制其罷極，破吳必矣。」條侯曰：「善。」從其策，遂堅壁昌邑南，輕兵絕吳馕道。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-106-wuwang:m012-0000","start":0,"end":2,"surface":"條侯","kind":"person","person_id":"koy_6jg_gcc_C","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m012-0018","start":18,"end":20,"surface":"劇孟","kind":"person","person_id":"5se_9f5_u2q","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m012-0047","start":47,"end":49,"surface":"劇孟","kind":"person","person_id":"5se_9f5_u2q","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m012-0050","start":50,"end":52,"surface":"劇孟","kind":"person","person_id":"5se_9f5_u2q","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m012-0075","start":75,"end":77,"surface":"絳侯","kind":"person","person_id":"koy_6jg_gcc","status":"contextual_provisiona