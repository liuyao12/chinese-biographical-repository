{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"s2h_7ar_ev6","canonical_person_id":"s2h_7ar_ev6","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["s2h_7ar_ev6"],"persons":[{"id":"s2h_7ar_ev6","label":"周虓妻〔被俘、未名〕","status":"active","historicity":"historical_tradition","aliases":[{"surface":"妻","mention_ids":["c-jinshu-058-zhou-xiao:p001:m0058"]}],"evidence":[{"mention_id":"c-jinshu-058-zhou-xiao:p001:m0058","paragraph_id":"c-jinshu-058-zhou-xiao:p001","chapter_id":"c-jinshu-058-zhou-xiao","quote":"妻"}],"review":"ai_provisional","identity_note":"周虓妻〔被俘、未名〕，見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-jinshu-058-zhou-xiao-ws1775463","work_id":"w-jinshu","book_id":"b-jinshu-058","chapter_id":"c-jinshu-058-zhou-xiao","raw_mention_count":1,"mention_ids":["c-jinshu-058-zhou-xiao:p001:m0058"],"paragraph_ids":["c-jinshu-058-zhou-xiao:p001"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-058-zhou-xiao:p001:m0058","mention_ids":["c-jinshu-058-zhou-xiao:p001:m0058"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-058-zhou-xiao-ws1775463"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-jinshu-058-zhou-xiao:source_relationship1-56","kind":"source_relationship","person_id":"s2h_7ar_ev6","source_quote":"送母妻從漢水","reading":"周虓妻隨其母同行被獲，未具名。","note":"周虓妻隨其母同行被獲，未具名。","paragraph_id":"c-jinshu-058-zhou-xiao:p001","start_codepoint":56,"end_codepoint":62,"human_reviewed":false,"related_person_id":"pqa_k01_mx5","chapter_id":"c-jinshu-058-zhou-xiao","source_id":"s-jinshu-058-zhou-xiao-ws1775463"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-058-zhou-xiao:p001:m0058","surface":"妻","start":58,"end":59,"person_id":"s2h_7ar_ev6","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-058-zhou-xiao:p001","chapter_id":"c-jinshu-058-zhou-xiao"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-058-zhou-xiao:p001","text":"虓字孟威。少有節操。州召爲祭酒，後歷位至西夷校尉，領梓潼太守。甯康初，苻堅將揚安寇梓潼，虓固守涪城，遣歩騎數千，送母妻從漢水將抵江陵，爲堅將硃肜邀而獲之，虓遂降於安。堅欲以爲尚書郎，虓曰：「蒙國厚恩，以至今日。但老母見獲，失節於此。母子獲全，秦之惠也。雖公侯之貴，不以爲榮，況郎任乎！」堅乃止。自是毎入見堅，輒箕鋸而坐，呼之爲氐賊。堅不悅。屬元會，威儀甚整，堅因謂虓曰：「晉家元會何如此？」虓攘袂厲聲曰：「戎狄集聚，譬猶犬羊相群，何敢比天子！」及呂光征西域，堅出餞之，戎士二十萬，旌旗數百里，又問虓曰：「朕眾力何如？」虓曰：「戎狄已來，未之有也。」堅黨以虓不遜，屢請除之。堅待之彌厚。虓乃密書與桓沖，説賊奸計。太元三年，虓潛至漢中，堅追得之。後又與堅兄子苞謀襲堅，事泄，堅引虓問其狀，虓曰：「昔漸離、豫讓，燕、智之微臣，猶漆身吞炭，不忘忠節。況虓世荷晉恩，豈敢忘也。生爲晉臣，死爲晉鬼，復何問乎！」堅曰：「今殺之，適成其名矣。」遂撻之，徙於太原。後堅復陷順陽、魏興，獲二守，皆執節不撓，堅歎曰：「周孟威不屈於前，丁彥遠潔己於後，吉祖沖不食而死，皆忠臣也。」","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":94,"last_line":94,"raw_start":8710,"raw_end":9229,"raw_character_offsets":[8712,8713,8714,8715,8716,8717,8718,8719,8720,8721,8722,8723,8724,8725,8726,8727,8730,8733,8734,8735,8736,8737,8738,8739,8740,8741,8742,8743,8744,8745,8746,8747,8748,8749,8750,8751,8752,8753,8754,8755,8756,8757,8758,8759,8760,8761,8762,8763,8764,8765,8766,8767,8768,8769,8770,8771,8772,8773,8774,8775,8776,8777,8778,8779,8780,8781,8782,