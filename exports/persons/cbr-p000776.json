{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000776","identity_policy":"contextual_provisional","person_ids":["cbr-p000776"],"persons":[{"id":"cbr-p000776","label":"新城三老董公","status":"active","historicity":"historical_tradition","aliases":[{"surface":"新城三老董公","mention_ids":["c-shiji-008-gaozu:m033-0040"]}],"evidence":[{"mention_id":"c-shiji-008-gaozu:m033-0040","chapter_id":"c-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p033","quote":"新城三老董公"}]}],"mentions":[{"id":"c-shiji-008-gaozu:m033-0040","start":40,"end":46,"surface":"新城三老董公","kind":"person","person_id":"cbr-p000776","status":"contextual_provisional","paragraph_id":"c-shiji-008-gaozu:p033","chapter_id":"c-shiji-008-gaozu"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-008-gaozu:p033","text":"三月，漢王從臨晉渡，魏王豹將兵從。下河內，虜殷王，置河內郡。南渡平陰津，至雒陽。新城三老董公遮說漢王以義帝死故。漢王聞之，袒而大哭。遂為義帝發喪，臨三日。發使者告諸侯曰：「天下共立義帝，北面事之。今項羽放殺義帝於江南，大逆無道。寡人親為發喪，諸侯皆縞素。悉發關內兵，收三河士，南浮江漢以下，願從諸侯王擊楚之殺義帝者。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m033-0003","start":3,"end":5,"surface":"漢王","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m033-0010","start":10,"end":13,"surface":"魏王豹","kind":"person","person_id":"cbr-p000697","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m033-0022","start":22,"end":24,"surface":"殷王","kind":"person","person_id":"cbr-p000699","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m033-0040","start":40,"end":46,"surface":"新城三老董公","kind":"person","person_id":"cbr-p000776","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m033-0048","start":48,"end":50,"surface":"漢王","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m033-0051","start":51,"end":53,"surface":"義帝","kin