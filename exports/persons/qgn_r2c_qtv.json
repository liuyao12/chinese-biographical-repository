s":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-003-yin:p001","text":"殷契，母曰簡狄，有娀氏之女，為帝嚳次妃。三人行浴，見玄鳥墮其卵，簡狄取吞之，因孕生契。契長而佐禹治水有功。帝舜乃命契曰：「百姓不親，五品不訓，汝為司徒而敬敷五教，五教在寬。」封于商，賜姓子氏。契興於唐、虞、大禹之際，功業著於百姓，百姓以平。","mentions":[{"id":"c-shiji-003-yin:m001-0000","start":0,"end":2,"surface":"殷契","kind":"person","person_id":"ea8_yum_lvj","status":"source_identified"},{"id":"c-shiji-003-yin:m001-0005","start":5,"end":7,"surface":"簡狄","kind":"person","person_id":"qgn_r2c_qtv","status":"source_identified"},{"id":"c-shiji-003-yin:m001-0008","start":8,"end":11,"surface":"有娀氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"氏族、群體、官稱或未定個人指代；不由熟知故事補出姓名。"},{"id":"c-shiji-003-yin:m001-0015","start":15,"end":17,"surface":"帝嚳","kind":"person","person_id":"9qr_quf_02m","status":"source_identified"},{"id":"c-shiji-003-yin:m001-0020","start":20,"end":22,"surface":"三人","kind":"unresolved","person_id":null,"status":"unresolved","note":"氏族、群體、官稱或未定個人指代；不由熟知故事補出姓名。"},{"id":"c-shiji-003-yin:m001-0032","start":32,"end":34,"surface":"簡狄","kind":"person","person_id":"qgn_r2c_qtv","status":"source_identified"},{"id":"c-shiji-003-yin:m001-0041","start":41,"end":42,"surface":"契","kind":"person","person_id":"ea8_yum_lvj","status":"source_identified"},{"id":"c-shiji-003-yin:m001-0043","start":43,"end":44,"surface":"契","kind":"person","person_id":"ea8_yum_lvj","status":"source_identified"},{"id":"c-shiji-003-yin:m001-0047","start":47,"end":48,"surface":"禹","kind":"person","person_id":"6ip_dr3_fbl","status":"source_identified"},{"id":"c-shiji-003-yin:m001-0053","start":53,"end":55,"surface":"帝舜","kind":"person","person_id":"ddb_l4j_4j2","status":"source_identified"},{"id":"c-shiji-003-yin:m001-0057","start":57,"end":58,"surface":"契","kind":"person","person_id":"ea8_yum_lvj","status":"source_identified"},{"id":"c-shiji-003-yin:m001-0096","start":96,"end":97,"surface":"契","kind"