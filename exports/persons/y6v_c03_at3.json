son","person_id":"y6v_c03_at3","status":"contextual_provisional","paragraph_id":"c-shiji-084-qujia:p033","chapter_id":"c-shiji-084-qujia"}],"relations":[],"title_holdings":[{"id":"th-shiji084-005","person_id":"y6v_c03_at3","title":"長沙王太傅","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-084-qujia","source_id":"s-shiji-084-qujia","paragraph_id":"c-shiji-084-qujia:p019","quote":"自屈原沈汨羅後百有餘年，漢有賈生，為長沙王太傅，過湘水，投書以弔屈原。"}],"attestations":[{"id":"th-shiji084-005:a001","paragraph_id":"c-shiji-084-qujia:p019","start":18,"end":23,"surface":"長沙王太傅","person_mention_id":"c-shiji-084-qujia:m019-0014","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"用稱與實際授任分存，未知起訖不補造；長沙太傅第19段為先述、第22段為事件，可能同一任期不當兩次實任。議任公卿不記已授；賈嘉九卿附述層次待覆核。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji084-008","person_id":"y6v_c03_at3","title":"博士","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-084-qujia","source_id":"s-shiji-084-qujia","paragraph_id":"c-shiji-084-qujia:p020","quote":"賈生名誼，雒陽人也。年十八，以能誦詩屬書聞於郡中。吳廷尉為河南守，聞其秀才，召置門下，甚幸愛。孝文皇帝初立，聞河南守吳公治平為天下第一，故與李斯同邑而常學事焉，乃徵為廷尉。廷尉乃言賈生年少，頗通諸子百家之書。文帝召以為博士。"}],"attestations":[{"id":"th-shiji084-008:a001","paragraph_id":"c-shiji-084-qujia:p020","start":109,"end":111,"surface":"博士","person_mention_id":"c-shiji-084-qujia:m020-0090","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-084-qujia","source_id":"s-shiji-084-qujia","paragraph_id":"c-shiji-084-qujia:p020","quote":"賈生名誼，雒陽人也。年十八，以能誦詩屬書聞於郡中。吳廷尉為河南守，聞其秀才，召置門下，甚幸愛。孝文皇帝初立，聞河南守吳公治平為天下第一，故與李斯同邑而常學事焉，乃徵為廷尉。廷尉乃言賈生年少，頗通諸子百家之書。文帝召以為博士。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"用稱與實際授任分存，未知起訖不補造；長沙太傅第19段為先述、第22段為事件，可能同一任期不當兩次實任。議任公卿不記已授；賈嘉九卿附述層次待覆核。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji084-009","person_id":"y6v_c03_at3","title":"太中大夫","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-084-qujia","source_id":"s-shiji-084-qujia","paragraph_id":"c-shiji-084-qujia:p021","quote":"是時賈生年二十餘，最為少。每詔令議下，諸老先生不能言，賈生盡為之對，人人各如其意所欲出。諸生於是乃以為能，不及也。孝文帝說之，超遷，一歲中至太中大夫。"}],"attestations":[{"id":"th-shiji084-009:a001","paragraph_id":"c-shiji-084-qujia:p021","start":70,"end":74,"surface":"太中大夫","person_mention_id":"c-shiji-084-qujia:m021-0027","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-084-qujia","source_id":"s-shiji-084-qujia","paragraph_id":"c-shiji-084-qujia:p021","quote":"是時賈生年二十餘，最為少。每詔令議下，諸老先生不能言，賈生盡為之對，人人各如其意所欲出。諸生於是乃以為能，不及也。孝文帝說之，超遷，一歲中至太中大夫。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"用稱與實際授任分存，未知起訖不補造；長沙太傅第19段為先述、第22段為事件，可能同一任期不當兩次實任。議任公卿不記已授；賈嘉九卿附述層次待覆核。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji084-010","person_id":"y6v_c03_at3","title":"長沙王太傅","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-084-qujia","source_id":"s-shiji-084-qujia","paragraph_id":"c-shiji-084-qujia:p022","quote":"賈生以為漢興至孝文二十餘年，天下和洽，而固當改正朔，易服色，法制度，定官名，興禮樂，乃悉草具其事儀法，色尚黃，數用五，為官名，悉更秦之法。孝文帝初即位，謙讓未遑也。諸律令所更定，及列侯悉就國，其說皆自賈生發之。於是天子議以為賈生任公卿之位。絳、灌、東陽侯、馮敬之屬盡害之，乃短賈生曰：「雒陽之人，年少初學，專欲擅權，紛亂諸事。」於是天子後亦疏之，不用其議，乃以賈生為長沙王太傅。"}],"attestations":[{"id":"th-shiji084-010:a001","paragraph_id":"c-shiji-084-qujia:p022","start":183,"end":188,"surface":"長沙王太傅","person_mention_id":"c-shiji-084-qujia:m022-0180","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-084-qujia","source_id":"s-shiji-084-qujia","paragraph_id":"c-shiji-084-qujia:p022","quote":"賈生以為漢興至孝文二十餘年，天下和洽，而固當改正朔，易服色，法制度，定官名，興禮樂，乃悉草具其事儀法，色尚黃，數用五，為官名，悉更秦之法。孝文帝初即位，謙讓未遑也。諸律令所更定，及列侯悉就國，其說皆自賈生發之。於是天子議以為賈生任公卿之位。絳、灌、東陽侯、馮敬之屬盡害之，乃短賈生曰：「雒陽之人，年少初學，專欲擅權，紛亂諸事。」於是天子後亦疏之，不用其議，乃以賈生為長沙王太傅。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"用稱與實際授任分存，未知起訖不補造；長沙太傅第19段為先述、第22段為事件，可能同一任期不當兩次實任。議任公卿不記已授；賈嘉九卿附述層次待覆核。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji084-011","person_id":"y6v_c03_at3","title":"梁懷王太傅","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-084-qujia","source_id":"s-shiji-084-qujia","paragraph_id":"c-shiji-084-qujia:p030","quote":"後歲餘，賈生徵見。孝文帝方受釐，坐宣室。上因感鬼神事，而問鬼神之本。賈生因具道所以然之狀。至夜半，文帝前席。既罷，曰：「吾久不見賈生，自以為過之，今不及也。」居頃之，拜賈生為梁懷王太傅。梁懷王，文帝之少子，愛，而好書，故令賈生傅之。"}],"attestations":[{"id":"th-shiji084-011:a001","paragraph_id":"c-shiji-084-qujia:p030","start":87,"end":92,"surface":"梁懷王太傅","person_mention_id":"c-shiji-084-qujia:m030-0084","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-084-qujia","source_id":"s-shiji-084-qujia","paragraph_id":"c-shiji-084-qujia:p030","quote":"後歲餘，賈生徵見。孝文帝方受釐，坐宣室。上因感鬼神事，而問鬼神之本。賈生因具道所以然之狀。至夜半，文帝前席。既罷，曰：「吾久不見賈生，自以為過之，今不及也。」居頃之，拜賈生為梁懷王太傅。梁懷王，文帝之少子，愛，而好書，故令賈生傅之。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"用稱與實際授任分存，未知起訖不補造；長沙太傅第19段為先述、第22段為事件，可能同一任期不當兩次實任。議任公卿不記已授；賈嘉九卿附述層次待覆核。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji084-025","person_id":"y6v_c03_at3","scope":"same_chapter","chapter_ids":["c-shiji-084-qujia"],"status":"contextual_provisional","rationale":"依引古原稱與賈生名誼、吳廷尉吳公的同段承接暫定；絳灌短稱未補姓名，泛稱與賦中代詞尚待核定。","reviewer":"Codex（AI 代理）","surfaces":["誼","賈生"],"evidence":[{"paragraph_id":"c-shiji-084-qujia:p019","quote":"自屈原沈汨羅後百有餘年，漢有賈生，為長沙王太傅，過湘水，投書以弔屈原。"},{"paragraph_id":"c-shiji-084-qujia:p020","quote":"賈生名誼，雒陽人也。年十八，以能誦詩屬書聞於郡中。吳廷尉為河南守，聞其秀才，召置門下，甚幸愛。孝文皇帝初立，聞河南守吳公治平為天下第一，故與李斯同邑而常學事焉，乃徵為廷尉。廷尉乃言賈生年少，頗通諸子百家之書。文帝召以為博士。"},{"paragraph_id":"c-shiji-084-qujia:p021","quote":"是時賈生年二十餘，最為少。每詔令議下，諸老先生不能言，賈生盡為之對，人人各如其意所欲出。諸生於是乃以為能，不及也。孝文帝說之，超遷，一歲中至太中大夫。"},{"paragraph_id":"c-shiji-084-qujia:p022","quote":"賈生以為漢興至孝文二十餘年，天下和洽，而固當改正朔，易服色，法制度，定官名，興禮樂，乃悉草具其事儀法，色尚黃，數用五，為官名，悉更秦之法。孝文帝初即位，謙讓未遑也。諸律令所更定，及列侯悉就國，其說皆自賈生發之。於是天子議以為賈生任公卿之位。絳、灌、東陽侯、馮敬之屬盡害之，乃短賈生曰：「雒陽之人，年少初學，專欲擅權，紛亂諸事。」於是天子後亦疏之，不用其議，乃以賈生為長沙王太傅。"},{"paragraph_id":"c-shiji-084-qujia:p023","quote":"賈生既辭往行，聞長沙卑溼，自以壽不得長，又以適去，意不自得。及渡湘水，為賦以弔屈原。其辭曰："},{"paragraph_id":"c-shiji-084-qujia:p026","quote":"賈生為長沙王太傅三年，有鴞飛入賈生舍，止于坐隅。楚人命鴞曰「服」。賈生既以適居長沙，長沙卑溼，自以為壽不得長，傷悼之，乃為賦以自廣。其辭曰："},{"paragraph_id":"c-shiji-084-qujia:p030","quote":"後歲餘，賈生徵見。孝文帝方受釐，坐宣室。上因感鬼神事，而問鬼神之本。賈生因具道所以然之狀。至夜半，文帝前席。既罷，曰：「吾久不見賈生，自以為過之，今不及也。」居頃之，拜賈生為梁懷王太傅。梁懷王，文帝之少子，愛，而好書，故令賈生傅之。"},{"paragraph_id":"c-shiji-084-qujia:p031","quote":"文帝復封淮南厲王子四人皆為列侯。賈生諫，以為患之興自此起矣。賈生數上疏，言諸侯或連數郡，非古之制，可稍削之。文帝不聽。"},{"paragraph_id":"c-shiji-084-qujia:p032","quote":"居數年，懷王騎，墮馬而死，無後。賈生自傷為傅無狀，哭泣歲餘，亦死。賈生之死時年三十三矣。及孝文崩，孝武皇帝立，舉賈生之孫二人至郡守，而賈嘉最好學，世其家，與余通書。至孝昭時，列為九卿。"},{"paragraph_id":"c-shiji-084-qujia:p033","quote":"太史公曰：余讀離騷、天問、招魂、哀郢，悲其志。適長沙，觀屈原所自沈淵，未嘗不垂涕，想見其為人。及見賈生弔之，又怪屈原以彼其材，游諸侯，何國不容，而自令若是。讀服烏賦，同死生，輕去就，又爽然自失矣。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-084-qujia:p019","text":"自屈原沈汨羅後百有餘年，漢有賈生，為長沙王太傅，過湘水，投書以弔屈原。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m019-0001","start":1,"end":3,"surface":"屈原","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m019-0014","start":14,"end":16,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m019-0032","start":32,"end":34,"surface":"屈原","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"},{"id":"c-shiji-084-qujia:p020","text":"賈生名誼，雒陽人也。年十八，以能誦詩屬書聞於郡中。吳廷尉為河南守，聞其秀才，召置門下，甚幸愛。孝文皇帝初立，聞河南守吳公治平為天下第一，故與李斯同邑而常學事焉，乃徵為廷尉。廷尉乃言賈生年少，頗通諸子百家之書。文帝召以為博士。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m020-0000","start":0,"end":2,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m020-0003","start":3,"end":4,"surface":"誼","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m020-0025","start":25,"end":28,"surface":"吳廷尉","kind":"person","person_id":"ogh_zo9_46d","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m020-0047","start":47,"end":51,"surface":"孝文皇帝","kind":"person","person_id":"4ne_woz_rfe","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m020-0058","start":58,"end":60,"surface":"吳公","kind":"person","person_id":"ogh_zo9_46d","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m020-0070","start":70,"end":72,"surface":"李斯","kind":"person","person_id":"9yu_h0u_07p","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m020-0083","start":83,"end":85,"surface":"廷尉","kind":"person","person_id":"ogh_zo9_46d","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m020-0086","start":86,"end":88,"surface":"廷尉","kind":"person","person_id":"ogh_zo9_46d","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m020-0090","start":90,"end":92,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m020-0097","start":97,"end":101,"surface":"諸子百家","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代保持未解。"},{"id":"c-shiji-084-qujia:m020-0104","start":104,"end":106,"surface":"文帝","kind":"person","person_id":"4ne_woz_rfe","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"},{"id":"c-shiji-084-qujia:p021","text":"是時賈生年二十餘，最為少。每詔令議下，諸老先生不能言，賈生盡為之對，人人各如其意所欲出。諸生於是乃以為能，不及也。孝文帝說之，超遷，一歲中至太中大夫。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m021-0002","start":2,"end":4,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m021-0019","start":19,"end":23,"surface":"諸老先生","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代保持未解。"},{"id":"c-shiji-084-qujia:m021-0027","start":27,"end":29,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m021-0044","start":44,"end":46,"surface":"諸生","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代保持未解。"},{"id":"c-shiji-084-qujia:m021-0057","start":57,"end":60,"surface":"孝文帝","kind":"person","person_id":"4ne_woz_rfe","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"},{"id":"c-shiji-084-qujia:p022","text":"賈生以為漢興至孝文二十餘年，天下和洽，而固當改正朔，易服色，法制度，定官名，興禮樂，乃悉草具其事儀法，色尚黃，數用五，為官名，悉更秦之法。孝文帝初即位，謙讓未遑也。諸律令所更定，及列侯悉就國，其說皆自賈生發之。於是天子議以為賈生任公卿之位。絳、灌、東陽侯、馮敬之屬盡害之，乃短賈生曰：「雒陽之人，年少初學，專欲擅權，紛亂諸事。」於是天子後亦疏之，不用其議，乃以賈生為長沙王太傅。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m022-0000","start":0,"end":2,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m022-0069","start":69,"end":72,"surface":"孝文帝","kind":"person","person_id":"4ne_woz_rfe","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m022-0090","start":90,"end":92,"surface":"列侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代保持未解。"},{"id":"c-shiji-084-qujia:m022-0100","start":100,"end":102,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m022-0107","start":107,"end":109,"surface":"天子","kind":"person","person_id":"4ne_woz_rfe","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m022-0112","start":112,"end":114,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m022-0120","start":120,"end":121,"surface":"絳","kind":"person","person_id":"rjw_tpy_t2f","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m022-0122","start":122,"end":123,"surface":"灌","kind":"person","person_id":"t2y_z4k_z0m","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m022-0124","start":124,"end":127,"surface":"東陽侯","kind":"person","person_id":"08j_zgn_g6d","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m022-0128","start":128,"end":130,"surface":"馮敬","kind":"person","person_id":"xp2_dxz_zcn","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m022-0130","start":130,"end":132,"surface":"之屬","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代保持未解。"},{"id":"c-shiji-084-qujia:m022-0138","start":138,"end":140,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m022-0166","start":166,"end":168,"surface":"天子","kind":"person","person_id":"4ne_woz_rfe","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m022-0180","start":180,"end":182,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"},{"id":"c-shiji-084-qujia:p023","text":"賈生既辭往行，聞長沙卑溼，自以壽不得長，又以適去，意不自得。及渡湘水，為賦以弔屈原。其辭曰：","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m023-0000","start":0,"end":2,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m023-0039","start":39,"end":41,"surface":"屈原","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"},{"id":"c-shiji-084-qujia:p026","text":"賈生為長沙王太傅三年，有鴞飛入賈生舍，止于坐隅。楚人命鴞曰「服」。賈生既以適居長沙，長沙卑溼，自以為壽不得長，傷悼之，乃為賦以自廣。其辭曰：","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m026-0000","start":0,"end":2,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m026-0015","start":15,"end":17,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m026-0024","start":24,"end":26,"surface":"楚人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未能逐一辨識的後裔，保留原稱，不補造姓名與闕代。"},{"id":"c-shiji-084-qujia:m026-0033","start":33,"end":35,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"},{"id":"c-shiji-084-qujia:p030","text":"後歲餘，賈生徵見。孝文帝方受釐，坐宣室。上因感鬼神事，而問鬼神之本。賈生因具道所以然之狀。至夜半，文帝前席。既罷，曰：「吾久不見賈生，自以為過之，今不及也。」居頃之，拜賈生為梁懷王太傅。梁懷王，文帝之少子，愛，而好書，故令賈生傅之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m030-0004","start":4,"end":6,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m030-0009","start":9,"end":12,"surface":"孝文帝","kind":"person","person_id":"4ne_woz_rfe","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m030-0034","start":34,"end":36,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m030-0049","start":49,"end":51,"surface":"文帝","kind":"person","person_id":"4ne_woz_rfe","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m030-0064","start":64,"end":66,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m030-0084","start":84,"end":86,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m030-0087","start":87,"end":90,"surface":"梁懷王","kind":"person","person_id":"4ne_woz_rfe_A","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m030-0093","start":93,"end":96,"surface":"梁懷王","kind":"person","person_id":"4ne_woz_rfe_A","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m030-0097","start":97,"end":99,"surface":"文帝","kind":"person","person_id":"4ne_woz_rfe","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m030-0111","start":111,"end":113,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"},{"id":"c-shiji-084-qujia:p031","text":"文帝復封淮南厲王子四人皆為列侯。賈生諫，以為患之興自此起矣。賈生數上疏，言諸侯或連數郡，非古之制，可稍削之。文帝不聽。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m031-0000","start":0,"end":2,"surface":"文帝","kind":"person","person_id":"4ne_woz_rfe","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m031-0004","start":4,"end":8,"surface":"淮南厲王","kind":"person","person_id":"9i1_0jo_8sa","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m031-0008","start":8,"end":11,"surface":"子四人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未能逐一辨識的後裔，保留原稱，不補造姓名與闕代。"},{"id":"c-shiji-084-qujia:m031-0016","start":16,"end":18,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m031-0030","start":30,"end":32,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m031-0037","start":37,"end":39,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未能逐一辨識的後裔，保留原稱，不補造姓名與闕代。"},{"id":"c-shiji-084-qujia:m031-0054","start":54,"end":56,"surface":"文帝","kind":"person","person_id":"4ne_woz_rfe","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"},{"id":"c-shiji-084-qujia:p032","text":"居數年，懷王騎，墮馬而死，無後。賈生自傷為傅無狀，哭泣歲餘，亦死。賈生之死時年三十三矣。及孝文崩，孝武皇帝立，舉賈生之孫二人至郡守，而賈嘉最好學，世其家，與余通書。至孝昭時，列為九卿。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m032-0004","start":4,"end":6,"surface":"懷王","kind":"person","person_id":"4ne_woz_rfe_A","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m032-0016","start":16,"end":18,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m032-0033","start":33,"end":35,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m032-0045","start":45,"end":47,"surface":"孝文","kind":"person","person_id":"4ne_woz_rfe","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m032-0049","start":49,"end":53,"surface":"孝武皇帝","kind":"person","person_id":"7gg_m5f_ub1","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m032-0056","start":56,"end":58,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m032-0058","start":58,"end":62,"surface":"之孫二人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未能逐一辨識的後裔，保留原稱，不補造姓名與闕代。"},{"id":"c-shiji-084-qujia:m032-0067","start":67,"end":69,"surface":"賈嘉","kind":"person","person_id":"0e2_f7l_x0w","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m032-0083","start":83,"end":85,"surface":"孝昭","kind":"person","person_id":"c2i_ybj_ryx","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"},{"id":"c-shiji-084-qujia:p033","text":"太史公曰：余讀離騷、天問、招魂、哀郢，悲其志。適長沙，觀屈原所自沈淵，未嘗不垂涕，想見其為人。及見賈生弔之，又怪屈原以彼其材，游諸侯，何國不容，而自令若是。讀服烏賦，同死生，輕去就，又爽然自失矣。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m033-0000","start":0,"end":3,"surface":"太史公","kind":"person","person_id":"4xh_zzy_gyn","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m033-0028","start":28,"end":30,"surface":"屈原","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m033-0049","start":49,"end":51,"surface":"賈生","kind":"person","person_id":"y6v_c03_at3","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m033-0056","start":56,"end":58,"surface":"屈原","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"}],"sources":[{"chapter_id":"c-shiji-084-qujia","work_id":"w-shiji","book_id":"b-shiji-084","source_id":"s-shiji-084-qujia","source":{"title":"史記／卷084","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷084","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷084&oldid=1568305","revision_id":1568305,"accessed_on":"2026-10-09","extent":"33段正文，屈原、懷沙、賈生及篇末評論；索隱述贊另層待收。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{"铦":"銛","鸮":"鴞"},"editorial_readings":[{"paragraph_id":"c-shiji-084-qujia:p017","witness_form":"（投）［沈］","body_reading":"投","note":"數位增刪改讀提示另存，正文保留增改前形式，未核影像，不當已校定。"},{"paragraph_id":"c-shiji-084-qujia:p025","witness_form":"（微）［徵］","body_reading":"微","note":"數位增刪改讀提示另存，正文保留增改前形式，未核影像，不當已校定。"}],"extraction_note":"固定HTML與取得時版本一致；兩項改讀前形投、微保留。正文去腳註標記[1]，註文另存。括號曰保留，簡體字形轉換明記。 第13至16段懷沙、第24至25段弔屈原賦及第27至29段服鳥賦按傳世正文次序保留，詩賦引古不視為敘事當時人物；第32段孝昭附述傳承仍待覆核。","note":"全33段正文與HTML篇界已核讀，明示姓名首輪已存；未核底本影像與現代研究。"