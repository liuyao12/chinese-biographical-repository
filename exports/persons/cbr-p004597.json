{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004597","identity_policy":"contextual_provisional","person_ids":["cbr-p004597"],"persons":[{"id":"cbr-p004597","label":"毛翕公（樂毅列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"毛翕公","mention_ids":["c-shiji-080-leyi:m020-0071","c-shiji-080-leyi:m020-0075"]}],"evidence":[{"mention_id":"c-shiji-080-leyi:m020-0071","chapter_id":"c-shiji-080-leyi","paragraph_id":"c-shiji-080-leyi:p020","quote":"毛翕公"},{"mention_id":"c-shiji-080-leyi:m020-0075","chapter_id":"c-shiji-080-leyi","paragraph_id":"c-shiji-080-leyi:p020","quote":"毛翕公"}]}],"mentions":[{"id":"c-shiji-080-leyi:m020-0071","start":71,"end":74,"surface":"毛翕公","kind":"person","person_id":"cbr-p004597","status":"contextual_provisional","paragraph_id":"c-shiji-080-leyi:p020","chapter_id":"c-shiji-080-leyi"},{"id":"c-shiji-080-leyi:m020-0075","start":75,"end":78,"surface":"毛翕公","kind":"person","person_id":"cbr-p004597","status":"contextual_provisional","paragraph_id":"c-shiji-080-leyi:p020","chapter_id":"c-shiji-080-leyi"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji080-043","person_id":"cbr-p004597","scope":"same_chapter","chapter_ids":["c-shiji-080-leyi"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["毛翕公"],"evidence":[{"paragraph_id":"c-shiji-080-leyi:p020","quote":"太史公曰：始齊之蒯通及主父偃讀樂毅之報燕王書，未嘗不廢書而泣也。樂臣公學黃帝、老子，其本師號曰河上丈人，不知其所出。河上丈人教安期生，安期生教毛翕公，毛翕公教樂瑕公，樂瑕公教樂臣公，樂臣公教蓋公。蓋公教於齊高密、膠西，為曹相國師。"}],"rationale":"樂閒明示為樂毅子，樂叔明示為孫，不補闕代父親；樂乘為樂閒宗不補兄弟。燕王喜來書及趙襄王君序各限本段，曹相國未見名字不回填。河上丈人至蓋公師承不作父子。依本篇明示姓名、君序與來書答書範圍暫接；燕惠王來書寡人指惠王、將軍指樂毅，樂毅答書先王指昭王、足下君王指惠王。伍子胥引古首吳王指闔閭，後吳王在夫差賜鴟夷後指夫差。父兄與群臣不補具體親屬，王齊為反間假說不作授王爵。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-080-leyi:p020","text":"太史公曰：始齊之蒯通及主父偃讀樂毅之報燕王書，未嘗不廢書而泣也。樂臣公學黃帝、老子，其本師號曰河上丈人，不知其所出。河上丈人教安期生，安期生教毛翕公，毛翕公教樂瑕公，樂瑕公教樂臣公，樂臣公教蓋公。蓋公教於齊高密、膠西，為曹相國師。","a