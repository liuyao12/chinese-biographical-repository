{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p001743","canonical_person_id":"jft_su5_rqv","id_aliases":["cbr-p001743"],"identity_policy":"contextual_provisional","person_ids":["jft_su5_rqv"],"persons":[{"id":"jft_su5_rqv","label":"魏武子（重耳五士）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"魏武子","mention_ids":["c-shiji-039-jin:m051-0048"]}],"evidence":[{"mention_id":"c-shiji-039-jin:m051-0048","chapter_id":"c-shiji-039-jin","paragraph_id":"c-shiji-039-jin:p051","quote":"魏武子"}],"id_aliases":["cbr-p001743"]}],"source_mention_summary":[{"source_id":"s-shiji-039-jin","work_id":"w-shiji","book_id":"b-shiji-039","chapter_id":"c-shiji-039-jin","mention_count":1,"mention_ids":["c-shiji-039-jin:m051-0048"],"paragraph_ids":["c-shiji-039-jin:p051"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-039-jin"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-039-jin:m051-0048","start":48,"end":51,"surface":"魏武子","kind":"person","person_id":"jft_su5_rqv","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p051","chapter_id":"c-shiji-039-jin"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji039-181","person_id":"jft_su5_rqv","surfaces":["魏武子"],"scope":"same_chapter","chapter_ids":["c-shiji-039-jin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-039-jin:p051","quote":"晉文公重耳，晉獻公之子也。自少好士，年十七，有賢士五人：曰趙衰；狐偃咎犯，文公舅也；賈佗；先軫；魏武子。自獻公爲太子時，重耳固已成人矣。獻公卽位，重耳年二十一。獻公十三年，以驪姬故，重耳備蒲城守秦。獻公二十一年，獻公殺太子申生，驪姬讒之，恐，不辭獻公而守蒲城。獻公二十二年，獻公使宦者履鞮趣殺重耳。重耳踰垣，宦者逐斬其衣袪。重耳遂奔狄。狄，其母國也。是時重耳年四十三。從此五士，其餘不名者數十人，至狄。"}],"rationale":"按本篇明示名與稱號、晉世系與具體事件暫定所列提及同指；附各段原文，未按同字短名全域合併；紀年與版本差異待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-039-jin:p051","text":"晉文公重耳，晉獻公之子也。自少好士，年十七，有賢士五人：曰趙衰；狐偃咎犯，文公舅也；賈佗；先軫；魏武子。自獻公爲太子時，重耳固已成人矣。獻公卽位，重耳年二十一。獻公十三年，以驪姬故，重耳備蒲城守秦。獻公二十一年，獻公殺太子申生，驪姬讒之，恐，不辭獻公而守蒲城。獻公二十二年，獻公使宦者履鞮趣殺重耳。重耳踰垣，宦者逐斬其衣袪。重耳遂奔狄。狄，其母國也。是時重耳年四十三。從此五士，其餘不名者數十人，至狄。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m051-0000","start":0,"end":5,"surface":"晉文公重耳","kind":"person","person_id":"6di_ywz_ju4_AAA","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m051-0006","start":6,"end":9,"surface":"晉獻公","kind":"person","person_id":"6di_ywz_ju4_AA","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m051-0029","start":29,"end":31,"surface":"趙衰","kind":"person","person_id":"dm0_58v_50i","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m051-0032","start":32,"end":36,"surface":"狐偃咎犯","kind":"person","person_id":"xxq_5y6_8sr","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m051-0037","start":37,"end":39,"surface":"文公","kind":"person","person_id":"6di_ywz_ju4_AAA","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m051-0042","start":42,"end":44,"surface":"賈佗","kind":"person","person_id":"0g3_cdx_6yo","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m051-0045","start":45,"end":47,"surface":"先軫","kind":"person","person_id":"zql_k3t_8ro","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m051-0048","start":48,"end":51,"surface":"魏武子","kind":"person","person_id":"jft_su5_rqv","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m051-0053","start":53,"end":55,"surface":"獻公","kind":"person","person_id":"6di_ywz_ju4_AA","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m051-0060","start