wed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-057-northern-wei-complete:p029:m0082","start":82,"end":85,"surface":"劉思忌","kind":"person","person_id":"eo0_i57_7we","status":"contextual_provisional","paragraph_id":"c-nanqishu-057-northern-wei-complete:p029","chapter_id":"c-nanqishu-057-northern-wei-complete"},{"id":"c-nanqishu-057-northern-wei-complete:p038:m0020","start":20,"end":23,"surface":"劉思忌","kind":"person","person_id":"eo0_i57_7we","status":"contextual_provisional","paragraph_id":"c-nanqishu-057-northern-wei-complete:p038","chapter_id":"c-nanqishu-057-northern-wei-complete"},{"id":"c-nanqishu-057-northern-wei-complete:p038:m0117","start":117,"end":119,"surface":"思忌","kind":"person","person_id":"eo0_i57_7we","status":"contextual_provisional","paragraph_id":"c-nanqishu-057-northern-wei-complete:p038","chapter_id":"c-nanqishu-057-northern-wei-complete"},{"id":"c-nanqishu-057-northern-wei-complete:p038:m0166","start":166,"end":168,"surface":"思忌","kind":"person","person_id":"eo0_i57_7we","status":"contextual_provisional","paragraph_id":"c-nanqishu-057-northern-wei-complete:p038","chapter_id":"c-nanqishu-057-northern-wei-complete"},{"id":"c-nanqishu-057-northern-wei-complete:p038:m0180","start":180,"end":182,"surface":"思忌","kind":"person","person_id":"eo0_i57_7we","status":"contextual_provisional","paragraph_id":"c-nanqishu-057-northern-wei-complete:p038","chapter_id":"c-nanqishu-057-northern-wei-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-057-northern-wei-complete:p029","text":"宏聞高宗踐阼非正，既新移都，兼欲大示威力。是冬，自率大眾分寇豫、徐、司、梁四州。遣偽荊州刺史薛真度、尚書郗祁阿婆出南陽，向沙堨，築壘開溝，為南陽太守房伯玉、新野太守劉思忌所破。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":66,"last_line":66,"raw_start":7511,"raw_end":7599,"raw_character_offsets":[7511,7512,7513,7514,7515,7516,7517,7518,7519,7520,7521,7522,7523,7524,7525,7526,7527,7528,7529,7530,7531,7532,7533,7534,7535,7536,7537,7538,7539,7540,7541,7542,7543,7544,7545,7546,7547,7548,7549,7550,7551,7552,7553,7554,7555,7556,7557,7558,7559,7560,7561,7562,7563,7564,7565,7566,7567,7568,7569,7570,7571,7572,7573,7574,7575,7576,7577,7578,7579,7580,7581,7582,7583,7584,7585,7586,7587,7588,7589,7590,7591,7592,7593,7594,7595,7596,7597,7598],"revision_id":1999801},"mentions":[{"id":"c-nanqishu-057-northern-wei-complete:p029:m0000","start":0,"end":1,"surface":"宏","kind":"person","person_id":"8dc_745_f37","status":"contextual_provisional"},{"id":"c-nanqishu-057-northern-wei-complete:p029:m0002","start":2,"end":4,"surface":"高宗","kind":"person","person_id":"w4m_9tw_147","status":"contextual_provisional"},{"id":"c-nanqishu-057-northern-wei-complete:p029:m0074","start":74,"end":77,"surface":"房伯玉","kind":"person","person_id":"iwp_oqm_zh8","status":"contextual_provisional"},{"id":"c-nanqishu-057-northern-wei-complete:p029:m0082","start":82,"end":85,"surface":"劉思忌","kind":"person","person_id":"eo0_i57_7we","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-057-northern-wei-complete","book_id":"b-nanqishu-057","work_id":"w-nanqishu","source_id":"s-nanqishu-057-northern-wei-complete-ws1999801"},{"id":"c-nanqishu-057-northern-wei-complete:p038","text":"宏留偽咸陽王憘圍南陽，進向新野，新野太守劉思忌亦拒守。臺先遣軍主直閤將軍胡松助北襄城太守成公期守赭陽城，軍主鮑舉助西汝南、北義陽二郡太守黃瑤起戍舞陰城。宏攻圍新野城，戰鬪不息。遣人謂城中曰：「房伯玉已降，汝南（為）〔何〕獨自取糜碎？」思忌令人對曰：「城中兵食猶多，未暇從汝小虜語也。」雍州刺史曹虎遣軍至均口，不進。永泰元年，城陷，縛思忌，問之曰：「今欲降未？」思忌曰：「寧為南鬼，不為北臣。」乃死。贈冠軍將軍、梁州刺史。於是沔北大震，湖陽戍主蔡道福、赭陽城主成公期及軍主胡松、舞陰城主黃瑤起及軍主鮑舉、從陽太守席謙竝棄城走。虜追軍獲瑤起，王肅募人臠食其肉。追贈冠軍將軍、兖州刺史。數日，房伯玉以城降。伯玉，清河人。既降，虜以為龍驤將軍，伯玉不肯受。高宗知其志，月給其子希哲錢五千，米二十斛。後伯玉就虜求南邊一郡，為馮翊太守，生子幼，便教其騎馬，常欲南歸。永元末，希哲入虜，伯玉大怒曰：「我力屈至此，不能死節，猶望汝在本朝以報國恩。我若從心，亦欲間關求反。汝何為失計？」遂卒虜中。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":84,"last_line":84,"raw_start":10264,"raw_end":