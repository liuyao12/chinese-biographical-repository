ount":8,"table_occurrence_count":0,"passage_count":2,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"8處獨立位置，8個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"},{"source_id":"s-nanqishu-054-recluses-complete-ws1762878","work_id":"w-nanqishu","book_id":"b-nanqishu-054","chapter_id":"c-nanqishu-054-recluses-complete","raw_mention_count":2,"mention_ids":["c-nanqishu-054-recluses-complete:p062:m0057","c-nanqishu-054-recluses-complete:p063:m0122"],"paragraph_ids":["c-nanqishu-054-recluses-complete:p062","c-nanqishu-054-recluses-complete:p063"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-nanqishu-054-recluses-complete:p062:m0057","mention_ids":["c-nanqishu-054-recluses-complete:p062:m0057"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-054-recluses-complete:p063:m0122","mention_ids":["c-nanqishu-054-recluses-complete:p063:m0122"],"kind":"paragraph"}],"mention_count":2,"duplicate_mention_count":0,"paragraph_occurrence_count":2,"table_occurrence_count":0,"passage_count":2,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"2處獨立位置，2個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-nanqishu-055-filial-complete-ws1545598"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-nanqishu-055-filial-complete:source_review37-0","kind":"source_review","person_id":"qil_xxj_ujk","source_quote":"　　杜栖字孟山，吳郡錢唐人，徵士京產子也。同郡張融與京產相友，每相造言論，栖常在側。融指栖曰：「昔陳太丘之召元方，方之爲劣。以今方古，古人何貴。」栖出京師，從儒士劉瓛受學。善清言，能彈琴飲酒，名儒貴遊多敬待之。中書郎周顒與京產書曰：「賢子學業清標，後來之秀。嗟愛之懷，豈知云已。所謂人之英彥，若己有之也。」刺史豫章王聞其名，辟議曹從事，仍轉西曹佐。竟陵王子良數致禮接。國子祭酒何胤治禮，又重栖，以爲學士，掌婚冠儀。","reading":"杜栖字孟山，父杜京產。張融當面評、從劉瓛受學、周顒書和何胤掌禮各有具體行事。","note":"杜栖字孟山，父杜京產。張融當面評、從劉瓛受學、周顒書和何胤掌禮各有具體行事。","paragraph_id":"c-nanqishu-055-filial-complete:p037","start_codepoint":0,"end_codepoint":207,"human_reviewed":false,"chapter_id":"c-nanqishu-055-filial-complete","source_id":"s-nanqishu-055-filial-complete-ws1545598"},{"id":"c-nanqishu-055-filial-complete:source_review38-0","kind":"source_review","person_id":"qil_xxj_ujk","source_quote":"　　以父老歸養，怡情壟畝。栖肥白長壯，及京產疾，旬日閒便皮骨自支。京產亡，水漿不入口七日，晨夕不罷哭，不食鹽菜。每營買祭奠，身自看視，號泣不自持。朔望節歲，絕而復續，吐血數升。時何胤、謝朏竝隱東山，遺書敦譬，誡以毀滅。至祥禫，暮夢見其父，慟哭而絕。初，胤兄點見栖歎曰：「卿風韻如此，雖獲嘉譽，不永年矣。」卒時年三十六。當世咸嗟惜焉。","reading":"京產亡後杜栖守喪，何胤、謝朏勸免毀滅。裡面何點語是前敘，末明杜栖卒三十六。","note":"京產亡後杜栖守喪，何胤、謝朏勸免毀滅。裡面何點語是前敘，末明杜栖卒三十六。","paragraph_id":"c-nanqishu-055-filial-complete:p038","start_codepoint":0,"end_codepoint":166,"human_reviewed":false,"chapter_id":"c-nanqishu-055-filial-complete","source_id":"s-nanqishu-055-filial-complete-ws1545598"},{"id":"c-nanqishu-055-filial-complete:variant_review38-152","kind":"variant_review","person_id":"qil_xxj_ujk","source_quote":"卒時年三十六","reading":"年齡繫杜栖卒，京產疾、喪和杜栖祥禫為前序，末有何點早先的評語。","note":"年齡繫杜栖卒，京產疾、喪和杜栖祥禫為前序，末有何點早先的評語。","paragraph_id":"c-nanqishu-055-filial-complete:p038","start_codepoint":152,"end_codepoint":158,"human_reviewed":false,"chapter_id":"c-nanqishu-055-filial-complete","source_id":"s-nanqishu-055-filial-complete-ws1545598"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-qi054-duqi-father","subject_person_id":"qil_xxj_ujk","object_person_id":"cx3_7fo_lvx","predicate":"father","qualifiers":{"source_term":"至京產及子栖","lineage":"paternal"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-054","chapter_id":"c-nanqishu-054-recluses-complete","source_id":"s-nanqishu-054-recluses-complete-ws1762878","paragraph_id":"c-nanqishu-054-recluses-complete:p062","quote":"　　杜京產字景齊，吳郡錢唐人。杜子恭玄孫也。祖運，爲劉毅衞軍參軍，父道鞠，州從事，善彈棋，世傳五斗米道，至京產及子栖。","subject_person_mention_id":"c-nanqishu-054-recluses-complete:p062:m0057","object_person_mention_id":"c-nanqishu-054-recluses-complete:p062:m0002"}],"status":"source_attested","interpretation_note":"下段亦稱子栖。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"a-qi055-duqi-father","subject_person_id":"qil_xxj_ujk","object_person_id":"cx3_7fo_lvx","predicate":"father","qualifiers":{"source_term":"徵士京產子也"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-055","chapter_id":"c-nanqishu-055-filial-complete","source_id":"s-nanqishu-055-filial-complete-ws1545598","paragraph_id":"c-nanqishu-055-filial-complete:p037","quote":"　　杜栖字孟山，吳郡錢唐人，徵士京產子也。同郡張融與京產相友，每相造言論，栖常在側。融指栖曰：「昔陳太丘之召元方，方之爲劣。以今方古，古人何貴。」栖出京師，從儒士劉瓛受學。善清言，能彈琴飲酒，名儒貴遊多敬待之。中書郎周顒與京產書曰：「賢子學業清標，後來之秀。嗟愛之懷，豈知云已。所謂人之英彥，若己有之也。」刺史豫章王聞其名，辟議曹從事，仍轉西曹佐。竟陵王子良數致禮接。國子祭酒何胤治禮，又重栖，以爲學士，掌婚冠儀。","subject_person_mention_id":"c-nanqishu-055-filial-complete:p037:m0002","object_person_mention_id":"c-nanqishu-055-filial-complete:p037:m0016"}],"status":"source_attested","interpretation_note":"卷五十四京產傳稱子栖。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-qi055-duqi-death","person_id":"qil_xxj_ujk","event_type":"death","source_term":"卒","source_anchor":{"paragraph_id":"c-nanqishu-055-filial-complete:p038","start":152,"end":153,"surface":"卒"},"date_expression":null,"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-055","chapter_id":"c-nanqishu-055-filial-complete","source_id":"s-nanqishu-055-filial-complete-ws1545598","paragraph_id":"c-nanqishu-055-filial-complete:p038","quote":"　　以父老歸養，怡情壟畝。栖肥白長壯，及京產疾，旬日閒便皮骨自支。京產亡，水漿不入口七日，晨夕不罷哭，不食鹽菜。每營買祭奠，身自看視，號泣不自持。朔望節歲，絕而復續，吐血數升。時何胤、謝朏竝隱東山，遺書敦譬，誡以毀滅。至祥禫，暮夢見其父，慟哭而絕。初，胤兄點見栖歎曰：「卿風韻如此，雖獲嘉譽，不永年矣。」卒時年三十六。當世咸嗟惜焉。","person_mention_id":"c-nanqishu-055-filial-complete:p038:m0013"}],"status":"source_attested","interpretation_note":"按同段人物與次第核所屬卒事。","reviewer":"Codex（AI代理）","model":null,"