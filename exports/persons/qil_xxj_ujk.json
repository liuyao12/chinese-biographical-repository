lvx","status":"contextual_provisional"},{"id":"c-nanqishu-055-filial-complete:p037:m0155","start":155,"end":158,"surface":"豫章王","kind":"person","person_id":"ijh_3fs_6u2","status":"contextual_provisional"},{"id":"c-nanqishu-055-filial-complete:p037:m0174","start":174,"end":179,"surface":"竟陵王子良","kind":"person","person_id":"x3q_cqm_dup","status":"contextual_provisional"},{"id":"c-nanqishu-055-filial-complete:p037:m0188","start":188,"end":190,"surface":"何胤","kind":"person","person_id":"vb0_ehz_mxj","status":"contextual_provisional"},{"id":"c-nanqishu-055-filial-complete:p037:m0195","start":195,"end":196,"surface":"栖","kind":"person","person_id":"qil_xxj_ujk","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-055-filial-complete","book_id":"b-nanqishu-055","work_id":"w-nanqishu","source_id":"s-nanqishu-055-filial-complete-ws1545598"},{"id":"c-nanqishu-055-filial-complete:p038","text":"　　以父老歸養，怡情壟畝。栖肥白長壯，及京產疾，旬日閒便皮骨自支。京產亡，水漿不入口七日，晨夕不罷哭，不食鹽菜。每營買祭奠，身自看視，號泣不自持。朔望節歲，絕而復續，吐血數升。時何胤、謝朏竝隱東山，遺書敦譬，誡以毀滅。至祥禫，暮夢見其父，慟哭而絕。初，胤兄點見栖歎曰：「卿風韻如此，雖獲嘉譽，不永年矣。」卒時年三十六。當世咸嗟惜焉。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":149,"last_line":149,"raw_start":5464,"raw_end":5630,"raw_character_offsets":[5464,5465,5466,5467,5468,5469,5470,5471,5472,5473,5474,5475,5476,5477,5478,5479,5480,5481,5482,5483,5484,5485,5486,5487,5488,5489,5490,5491,5492,5493,5494,5495,5496,5497,5498,5499,5500,5501,5502,5503,5504,5505,5506,5507,5508,5509,5510,5511,5512,5513,5514,5515,5516,5517,5518,5519,5520,5521,5522,5523,5524,5525,5526,5527,5528,5529,5530,5531,5532,5533,5534,5535,5536,5537,5538,5539,5540,5541,5542,5543,5544,5545,5546,5547,5548,5549,5550,5551,5552,5553,5554,5555,5556,5557,5558,5559,5560,5561,5562,5563,5564,5565,5566,5567,5568,5569,5570,5571,5572,5573,5574,5575,5576,5577,5578,5579,5580,5581,5582,5583,5584,5585,5586,5587,5588,5589,5590,5591,5592,5593,5594,5595,5596,5597,5598,5599,5600,5601,5602,5603,5604,5605,5606,5607,5608,5609,5610,5611,5612,5613,5614,5