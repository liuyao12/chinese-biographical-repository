{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003748","identity_policy":"contextual_provisional","person_ids":["cbr-p003748"],"persons":[{"id":"cbr-p003748","label":"衛君（老韓列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"衛君","mention_ids":["c-shiji-063-laohan:m022-0008"]}],"evidence":[{"mention_id":"c-shiji-063-laohan:m022-0008","chapter_id":"c-shiji-063-laohan","paragraph_id":"c-shiji-063-laohan:p022","quote":"衛君"}]}],"source_mention_summary":[{"source_id":"s-shiji-063-laohan","work_id":"w-shiji","book_id":"b-shiji-063","chapter_id":"c-shiji-063-laohan","mention_count":1,"mention_ids":["c-shiji-063-laohan:m022-0008"],"paragraph_ids":["c-shiji-063-laohan:p022"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-063-laohan"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-063-laohan:m022-0008","start":8,"end":10,"surface":"衛君","kind":"person","person_id":"cbr-p003748","status":"contextual_provisional","paragraph_id":"c-shiji-063-laohan:p022","chapter_id":"c-shiji-063-laohan"}],"relations":[],"title_holdings":[{"id":"th-shiji063-019","person_id":"cbr-p003748","title":"衛君","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-063-laohan","source_id":"s-shiji-063-laohan","paragraph_id":"c-shiji-063-laohan:p022","quote":"昔者彌子瑕見愛於衛君。衛國之法，竊駕君車者罪至刖。既而彌子之母病，人聞，往夜告之，彌子矯駕君車而出。君聞之而賢之曰：「孝哉，為母之故而犯刖罪！」與君游果園，彌子食桃而甘，不盡而奉君。君曰：「愛我哉，忘其口而念我！」及彌子色衰而愛弛，得罪於君。君曰：「是嘗矯駕吾車，又嘗食我以其餘桃。」故彌子之行未變於初也，前見賢而後獲罪者，愛憎之至變也。故有愛於主，則知當而加親；見憎於主，則罪當而加疏。故諫說之士不可不察愛憎之主而後說之矣。"}],"attestations":[{"id":"th-shiji063-019:a001","paragraph_id":"c-shiji-063-laohan:p022","start":8,"end":10,"surface":"衛君","person_mention_id":"c-shiji-063-laohan:m022-0008","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expres