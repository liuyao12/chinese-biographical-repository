id":"c-shiji-044-wei"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji044-117","person_id":"cbr-p002616","surfaces":["王","秦王"],"scope":"same_chapter","chapter_ids":["c-shiji-044-wei"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-044-wei:p064","quote":"卅年，无忌歸魏，率五國兵攻秦，敗之河外，走蒙驁。魏太子增質於秦，秦怒，欲囚魏太子增。或爲增謂秦王曰：『公孫喜固謂魏相曰「請以魏疾撃秦，秦王怒，必囚增。魏王又怒，撃秦，秦必傷」。今王囚增，是喜之計中也。故不若貴增而合魏，以疑之於齊、韓。』秦乃止增。"}],"rationale":"限本篇明示姓名、封號、繼位與連續對話。无忌／信陵君及增／景湣王按明示語句暫接；公子政不與秦王政按同名合併。太子自相、蘇代扮演梁王與秦王未名時段各保留，不補姓名；中旗馮琴讀法待底本核查。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-044-wei:p064","text":"卅年，无忌歸魏，率五國兵攻秦，敗之河外，走蒙驁。魏太子增質於秦，秦怒，欲囚魏太子增。或爲增謂秦王曰：『公孫喜固謂魏相曰「請以魏疾撃秦，秦王怒，必囚增。魏王又怒，撃秦，秦必傷」。今王囚增，是喜之計中也。故不若貴增而合魏，以疑之於齊、韓。』秦乃止增。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-044-wei:m064-0003","start":3,"end":5,"surface":"无忌","kind":"person","person_id":"cbr-p002609","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m064-0021","start":21,"end":23,"surface":"蒙驁","kind":"person","person_id":"cbr-p002613","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m064-0024","start":24,"end":28,"surface":"魏太子增","kind":"person","person_id":"cbr-p002614","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m064-0037","start":37,"end":41,"surface":"魏太子增","kind":"person","person_id":"cbr-p002614","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m064-0044","start":44,"end":45,"surface":"增","kind":"person","person_id":"cbr-p002614","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m064-0046","start":46,"end":48,"surface":"秦王","kind":"person","person_id":"cbr-p002616","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m064-0051","start":51,"end":54,"surface":"公孫喜","kind":"person","person_id":"cbr-p002615","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m064-0056","start