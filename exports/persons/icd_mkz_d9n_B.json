氏救而獲免，事在叔陵傳。後主即位，尊后為皇太后，宮曰弘範。當是之時，新失淮南之地，隋師臨江，又國遭大喪，後主病瘡不能聽政，其誅叔陵、供大行喪事、邊境防守及百司红務，雖假以後主之命，實皆決之於后。後主瘡愈，乃歸政焉。陳亡入長安，大業十一年薨於東都，年八十三，葬洛陽之邙山。","mentions":[{"id":"c-chenshu-007-liujingyan:p002:m0029","surface":"錢氏","start":29,"end":31,"person_id":"b13_njz_24q","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-chenshu-007-liujingyan:p002:m0083","surface":"叔陵","start":83,"end":85,"person_id":"icd_mkz_d9n_B","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-chenshu-007-liujingyan:p002:m0093","surface":"樂安君吳氏","start":93,"end":98,"person_id":"sfs_3hb_c13","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-chenshu-007-liujingyan:p002:m0105","surface":"叔陵","start":105,"end":107,"person_id":"icd_mkz_d9n_B","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-chenshu-007-liujingyan:p002:m0117","surface":"皇太后","start":117,"end":120,"person_id":"5jc_z9b_i2n_AAAAAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-chenshu-007-liujingyan:p002:m0160","surface":"叔陵","start":160,"end":162,"person_id":"icd_mkz_d9n_B","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":2015446,"source_layer":"received_biography","first_line":39,"last_line":39,"line_start":2,"line_end":288,"raw_start":2380,"raw_end":2666,"raw_character_offsets":[2380,2381,2382,2383,2384,2385,2386,2387,2388,2389,2390,2391,2392,2393,2394,2395,2396,2397,2398,2399,2400,2401,2402,2403,2404,2405,2406,2407,2408,2409,2410,2411,2412,2413,2414,2415,2416,2417,2418,2419,2420,2421,2422,2423,2424,2425,2426,2427,2428,2429,2430,2431,2432,2433,2434,2435,2436,2437,2438,2439,2440,2441,2442,2443,2444,2445,2446,2447,2448,2449,2450,2451,2452,2453,2454,2455,2456,2457,2458,2459,2460,2461,2462,2463,2464,246