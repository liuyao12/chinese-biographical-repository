onal"},{"id":"c-shiji-007-xiangyu:m007-0082","start":82,"end":84,"surface":"項梁","kind":"person","person_id":"cbr-p000603","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m007-0108","start":108,"end":110,"surface":"田榮","kind":"person","person_id":"cbr-p000665","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m007-0115","start":115,"end":117,"surface":"田假","kind":"person","person_id":"cbr-p000667","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m007-0120","start":120,"end":122,"surface":"田角","kind":"person","person_id":"cbr-p000668","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m007-0123","start":123,"end":125,"surface":"田閒","kind":"person","person_id":"cbr-p000669","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m007-0131","start":131,"end":133,"surface":"項梁","kind":"person","person_id":"cbr-p000603","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m007-0136","start":136,"end":138,"surface":"田假","kind":"person","person_id":"cbr-p000667","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m007-0159","start":159,"end":161,"surface":"田角","kind":"person","person_id":"cbr-p000668","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m007-0162","start":162,"end":164,"surface":"田閒","kind":"person","person_id":"cbr-p000669","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m007-0178","start":178,"end":180,"surface":"項梁","kind":"person","person_id":"cbr-p000603","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m007-0181","start":181,"end":183,"surface":"沛公","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m007-0184","start":184,"end":186,"surface":"項羽","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m007-0209","start":209,"end":211,"surface":"沛公","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m007-0212","start":212,"end":214,"surface":"項羽","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m007-0239","start":239,"end":241,"surface":"李由","kind":"person","person_id":"cbr-p000670","status":"contextual_provisional"}],"chapter_id":"c-shiji-007-xiangyu","book_id":"b-shiji-007","work_id":"w-shiji","source_id":"s-shiji-007-xiangyu"},{"id":"c-shiji-007-xiangyu:p035","text":"項王聞淮陰侯已舉河北，破齊、趙，且欲擊楚，乃使龍且往擊之。淮陰侯與戰，騎將灌嬰擊之，大破楚軍，殺龍且。韓信因自立為齊王。項王聞龍且軍破，則恐，使盱台人武涉往說淮陰侯。淮陰侯弗聽。是時，彭越復反，下梁地，絕楚糧。項王乃謂海春侯大司馬曹咎等曰：「謹守成皋，則漢欲挑戰，慎勿與戰，毋令得東而已。我十五日必誅彭越，定梁地，復從將軍。」乃東，行擊陳留、外黃。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-007-xiangyu:m035-0000","start":0,"end":2,"surface":"項王","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m035-0003","start":3,"end":6,"surface":"淮陰侯","kind":"person","person_id":"cbr-p000724","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m035-0023","start":23,"end":25,"surface":"龍且","kind":"person","person_id":"cbr-p000666","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m035-0029","start":29,"end":32,"surface":"淮陰侯","kind":"person","person_id":"cbr-p000724","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m035-0037","start":37,"end":39,"surface":"灌嬰","kind":"person","person_id":"cbr-p000729","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m035-0048","start":48,"end":50,"surface":"龍且","kind":"person","person_id":"cbr-p000666","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m035-0051","start":51,"end":53,"surface":"韓信","kind":"person","person_id":"cbr-p000724","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m035-0060","start":60,"end":62,"surface":"項王","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m035-0063","start":63,"end":65,"surface":"龍且","kind":"person","person_id":"cbr-p000666","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m035-0075","start":75,"end":77,"surface":"武涉","kind":"person","person_id":"cbr-p000730","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m035-0079","start":79,"end":82,"surface":"淮陰侯","kind":"person","person_id":"cbr-p000724","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m035-0083","start":83,"end":86,"surface":"淮陰侯","kind":"person","person_id":"cbr-p000724","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m035-0092","start":92,"end":94,"surface":"彭越","kind":"person","person_id":"cbr-p000707","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m035-0105","start":105,"end":107,"surface":"項王","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m035-0109","start":109,"end":117,"surface":"海春侯大司馬曹咎","kind":"person","person_id":"cbr-p000650","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m035-0150","start":150,"end":152,"surface":"彭越","kind":"person","person_id":"cbr-p000707","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m035-0159","start":159,"end":161,"surface":"將軍","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、匿名者、群體、動物或未定指代保留待核；不補姓名、闕代或個別成員。"}],"chapter_id":"c-shiji-007-xiangyu","book_id":"b-shiji-007","work_id":"w-shiji","source_id":"s-shiji-007-xiangyu"},{"id":"c-shiji-008-gaozu:p035","text":"呂后兄周呂侯為漢將兵，居下邑。漢王從之，稍收士卒，軍碭。漢王乃西過梁地，至虞。使謁者隨何之九江王布所，曰：「公能令布舉兵叛楚，項羽必留擊之。得留數月，吾取天下必矣。」隨何往說九江王布，布果背楚。楚使龍且往擊之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m035-0000","start":0,"end":2,"surface":"呂后","kind":"person","person_id":"cbr-p000717","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m035-0003","start":3,"end":6,"surface":"周呂侯","kind":"person","person_id":"cbr-p000719","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m035-0015","start":15,"end":17,"surface":"漢王","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m035-0028","start":28,"end":30,"surface":"漢王","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m035-0042","start":42,"end":44,"surface":"隨何","kind":"person","person_id":"cbr-p000777","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m035-0045","start":45,"end":49,"surface":"九江王布","kind":"person","person_id":"cbr-p000656","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m035-0057","start":57,"end":58,"surface":"布","kind":"person","person_id":"cbr-p000656","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m035-0063","start":63,"end":65,"surface":"項羽","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m035-0083","start":83,"end":85,"surface":"隨何","kind":"person","person_id":"cbr-p000777","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m035-0087","start":87,"end":91,"surface":"九江王布","kind":"person","person_id":"cbr-p000656","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m035-0092","start":92,"end":93,"surface":"布","kind":"person","person_id":"cbr-p000656","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m035-0099","start":99,"end":101,"surface":"龍且","kind":"person","person_id":"cbr-p000666","status":"contextual_provisional"}],"chapter_id":"c-shiji-008-gaozu","book_id":"b-shiji-008","work_id":"w-shiji","source_id":"s-shiji-008-gaozu"},{"id":"c-shiji-008-gaozu:p037","text":"是時九江王布與龍且戰，不勝，與隨何閒行歸漢。漢王稍收士卒，與諸將及關中卒益出，是以兵大振滎陽，破楚京、索閒。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m037-0002","start":2,"end":6,"surface":"九江王布","kind":"person","person_id":"cbr-p000656","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m037-0007","start":7,"end":9,"surface":"龍且","kind":"person","person_id":"cbr-p000666","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m037-0015","start":15,"end":17,"surface":"隨何","kind":"person","person_id":"cbr-p000777","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m037-0022","start":22,"end":24,"surface":"漢王","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"}],"chapter_id":"c-shiji-008-gaozu","book_id":"b-shiji-008","work_id":"w-shiji","source_id":"s-shiji-008-gaozu"},{"id":"c-shiji-008-gaozu:p044","text":"淮陰已受命東，未渡平原。漢王使酈生往說齊王田廣，廣叛楚，與漢和，共擊項羽。韓信用蒯通計，遂襲破齊。齊王烹酈生，東走高密。項羽聞韓信已舉河北兵破齊、趙，且欲擊楚，則使龍且、周蘭往擊之。韓信與戰，騎將灌嬰擊，大破楚軍，殺龍且。齊王廣奔彭越。當此時，彭越將兵居梁地，往來苦楚兵，絕其糧食。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m044-0000","start":0,"end":2,"surface":"淮陰","kind":"person","person_id":"cbr-p000724","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m044-0012","start":12,"end":14,"surface":"漢王","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m044-0015","start":15,"end":17,"surface":"酈生","kind":"person","person_id":"cbr-p000764","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m044-0019","start":19,"end":21,"surface":"齊王","kind":"person","person_id":"cbr-p000721","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m044-0021","start":21,"end":23,"surface":"田廣","kind":"person","person_id":"cbr-p000721","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m044-0024","start":24,"end":25,"surface":"廣","kind":"person","person_id":"cbr-p000721","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m044-0034","start":34,"end":36,"surface":"項羽","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m044-0037","start":37,"end":39,"surface":"韓信","kind":"person","person_id":"cbr-p000724","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m044-0040","start":40,"end":42,"surface":"蒯通","kind":"person","person_id":"cbr-p000781","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m044-0049","start":49,"end":51,"surface":"齊王","kind":"person","person_id":"cbr-p000721","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m044-0052","start":52,"end":54,"surface":"酈生","kind":"person","person_id":"cbr-p000764","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m044-0060","start":60,"end":62,"surface":"項羽","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m044-0063","start":63,"end":65,"surface":"韓信","kind":"person","person_id":"cbr-p000724","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m044-0082","start":82,"end":84,"surface":"龍且","kind":"person","person_id":"cbr-p000666","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m044-0085","start":85,"end":87,"surface":"周蘭","kind":"person","person_id":"cbr-p000782","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m044-0091","start":91,"end":93,"surface":"韓信","kind":"person","person_id":"cbr-p000724","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m044-0098","start":98,"end":100,"surface":"灌嬰","kind":"person","person_id":"cbr-p000729","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m044-0108","start":108,"end":110,"surface":"龍且","kind":"person","person_id":"cbr-p000666","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m044-0111","start":111,"end":114,"surface":"齊王廣","kind":"person","person_id":"cbr-p000721","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m044-0115","start":115,"end":117,"surface":"彭越","kind":"person","person_id":"cbr-p000707","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m044-0122","start":122,"end":124,"surface":"彭越","kind":"person","person_id":"cbr-p000707","status":"contextual_provisional"}],"chapter_id":"c-shiji-008-gaozu","book_id":"b-shiji-008","work_id":"w-shiji","source_id":"s-shiji-008-gaozu"},{"id":"c-shiji-008-gaozu:p047","text":"項羽聞龍且軍破，則恐，使盱臺人武涉往說韓信。韓信不聽。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m047-0000","start":0,"end":2,"surface":"項羽","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m047-0003","start":3,"end":5,"surface":"龍且","kind":"person","person_id":"cbr-p000666","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m047-0015","start":15,"end":17,"surface":"武涉","kind":"person","person_id":"cbr-p000730","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m047-0019","start":19,"end":21,"surface":"韓信","kind":"person","person_id":"cbr-p000724","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m047-0022","start":22,"end":24,"surface":"韓信","kind":"person","person_id":"cbr-p000724","status":"contextual_provisional"}],"chapter_id":"c-shiji-008-gaozu","book_id":"b-shiji-008","work_id":"w-shiji","source_id":"s-shiji-008-gaozu"},{"id":"c-shiji-091-qingbu:p008","text":"楚使者在，方急責英布發兵，舍傳舍。隨何直入，坐楚使者上坐，曰：「九江王已歸漢，楚何以得發兵？」布愕然。楚使者起。何因說布曰：「事已搆，可遂殺楚使者，無使歸，而疾走漢并力。」布曰：「如使者教，因起兵而擊之耳。」於是殺使者，因起兵而攻楚。楚使項聲、龍且攻淮南，項王留而攻下邑。數月，龍且擊淮南，破布軍。布欲引兵走漢，恐楚王殺之，故閒行與何俱歸漢。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-091-qingbu:m008-0000","start":0,"end":3,"surface":"楚使者","kind":"person","person_id":"cbr-p005081","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m008-0008","start":8,"end":10,"surface":"英布","kind":"person","person_id":"cbr-p005060","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m008-0017","start":17,"end":19,"surface":"隨何","kind":"person","person_id":"cbr-p005087","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m008-0023","start":23,"end":26,"surface":"楚使者","kind":"person","person_id":"cbr-p005081","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m008-0032","start":32,"end":35,"surface":"九江王","kind":"person","person_id":"cbr-p005060","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m008-0047","start":47,"end":48,"surface":"布","kind":"person","person_id":"cbr-p005060","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m008-0051","start":51,"end":54,"surface":"楚使者","kind":"person","person_id":"cbr-p005081","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m008-0056","start":56,"end":57,"surface":"何","kind":"person","person_id":"cbr-p005087","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m008-0059","start":59,"end":60,"surface":"布","kind":"person","person_id":"cbr-p005060","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m008-0070","start":70,"end":73,"surface":"楚使者","kind":"person","person_id":"cbr-p005081","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m008-0086","start":86,"end":87,"surface":"布","kind":"person","person_id":"cbr-p005060","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m008-0119","start":119,"end":121,"surface":"項聲","kind":"person","person_id":"cbr-p005089","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m008-0122","start":122,"end":124,"surface":"龍且","kind":"person","person_id":"cbr-p005090","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m008-0128","start":128,"end":130,"surface":"項王","kind":"person","person_id":"cbr-p005074","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m008-0139","start":139,"end":141,"surface":"龍且","kind":"person","person_id":"cbr-p005090","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m008-0146","start":146,"end":147,"surface":"布","kind":"person","person_id":"cbr-p005060","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m008-0149","start":149,"end":150,"surface":"布","kind":"person","person_id":"cbr-p005060","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m008-0157","start":157,"end":159,"surface":"楚王","kind":"person","person_id":"cbr-p005074","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m008-0166","start":166,"end":167,"surface