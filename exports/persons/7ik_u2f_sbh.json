se,"chapter_id":"c-jinshu-070-yingzhan","source_id":"s-jinshu-070-yingzhan-ws2595540"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-043-wangcheng:line122:m0394","start":394,"end":396,"surface":"王沖","kind":"person","person_id":"7ik_u2f_sbh","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-043-wangcheng:line122","chapter_id":"c-jinshu-043-wangcheng"},{"id":"c-jinshu-066-taokan:p006:m0448","surface":"王沖","start":448,"end":450,"person_id":"7ik_u2f_sbh","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-066-taokan:p006","chapter_id":"c-jinshu-066-taokan"},{"id":"c-jinshu-070-yingzhan:p003:m0288","surface":"王沖","start":288,"end":290,"person_id":"7ik_u2f_sbh","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-070-yingzhan:p003","chapter_id":"c-jinshu-070-yingzhan"}],"relations":[],"title_holdings":[{"id":"th-w043-cheng-122-11","person_id":"7ik_u2f_sbh","title":"參軍","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-043","chapter_id":"c-jinshu-043-wangcheng","source_id":"s-jinshu-043-wangcheng","paragraph_id":"c-jinshu-043-wangcheng:line122","quote":"澄既至鎮，日夜縱酒，不親庶事，雖寇戎急務，亦不以在懷。擢順陽人郭舒於寒悴之中，以為別駕，委以州府。時京師危逼，澄率眾軍，將赴國難，而飄風折其節柱。會王如寇襄陽，澄前鋒至宜城，遣使詣山簡，為如党嚴嶷所獲。嶷偽使人從襄陽來而問之曰：「襄陽拔未？」答云：「昨旦破城，已獲山簡。」乃陰緩澄使，令得亡去。澄聞襄陽陷，以為信然，散眾而還。既而恥之，托糧運不贍，委罪長史蔣俊而斬之，竟不能進。巴蜀流人散在荊、湘者，與土人忿爭，遂殺縣令，屯聚樂鄉。澄使成都內史王機討之。賊請降，澄偽許之，既而襲之於寵洲，以其妻子為賞，沈八千餘人于江中。於是益、梁流人四五萬家一時俱反，推杜弢為主，，南破零桂，東掠武昌，敗王機于巴陵。澄亦無憂懼之意，但與機日夜縱酒，投壺博戲，數十局俱起。殺富人李才，取其家資以賜郭舒。南平太守應詹驟諫，不納。於是上下離心，內外怨叛。澄望實雖損，猶傲然自得。後出軍擊杜弢，次於作塘。山簡參軍王沖叛於豫州，自稱荊州刺史。澄懼，使杜蕤守江陵。澄遷於孱陵，尋奔遝中。郭舒諫曰：「使君臨州，雖無異政，未失眾心。今西收華容向義之兵，足以擒此小丑，奈何自棄。」澄不能從。","person_mention_id":"c-jinshu-043-wangcheng:line122:m0394"}],"attestations":[{"id":"th-w043-cheng-122-11:a","paragraph_id":"c-jinshu-043-wangcheng:line122","start":392,"end":394,"surface":"參軍","person_mention_id":"c-jinshu-043-wangcheng:line122:m0394","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"th-w043-cheng-122-12","person_id":"7ik_u2f_sbh","title":"荊州刺史","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-043","chapter_id":"c-jinshu-043-wangcheng","source_id":"s-jinshu-043-wangcheng","paragraph_id":"c-jinshu-043-wangcheng:line122","quote":"澄既至鎮，日夜縱酒，不親庶事，雖寇戎急務，亦不以在懷。擢順陽人郭舒於寒悴之中，以為別駕，委以州府。時京師危逼，澄率眾軍，將赴國難，而飄風折其節柱。會王如寇襄陽，澄前鋒至宜城，遣使詣山簡，為如党嚴嶷所獲。嶷偽使人從襄陽來而問之曰：「襄陽拔未？」答云：「昨旦破城，已獲山簡。」乃陰緩澄使，令得亡去。澄聞襄陽陷，以為信然，散眾而還。既而恥之，托糧運不贍，委罪長史蔣俊而斬之，竟不能進。巴蜀流人散在荊、湘者，與土人忿爭，遂殺縣令，屯聚樂鄉。澄使成都內史王機討之。賊請降，澄偽許之，既而襲之於寵洲，以其妻子為賞，沈八千餘人于江中。於是益、梁流人四五萬家一時俱反，推杜弢為主，，南破零桂，東掠武昌，敗王機于巴陵。澄亦無憂懼之意，但與機日夜縱酒，投壺博戲，數十局俱起。殺富人李才，取其家資以賜郭舒。南平太守應詹驟諫，不納。於是上下離心，內外怨叛。澄望實雖損，猶傲然自得。後出軍擊杜弢，次於作塘。山簡參軍王沖叛於豫州，自稱荊州刺史。澄懼，使杜蕤守江陵。澄遷於孱陵，尋奔遝中。郭舒諫曰：「使君臨州，雖無異政，未失眾心。今西收華容向義之兵，足以擒此小丑，奈何自棄。」澄不能從。","person_mention_id":"c-jinshu-043-wangcheng:line122:m0394"}],"attestations":[{"id":"th-w043-cheng-122-12:a","paragraph_id":"c-jinshu-043-wangcheng:line122","start":403,"end":407,"surface":"荊州刺史","person_mention_id":"c-jinshu-043-wangcheng:line122:m0394","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"句中明載自稱，記其所稱。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"self_claimed_term":"自稱"}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints"