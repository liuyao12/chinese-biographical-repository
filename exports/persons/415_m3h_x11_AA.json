1:m0000"}],"reviewer":"Codex（AI代理）","human_reviewed":false,"model":null,"interpretation_note":"凱參驃騎軍事，驃騎所指人未明，不擅接同段大司馬齊王或改成具名參軍官銜。","fixed_source_fact_binding":{"kind":"fixed_witness_person_fact_slots","key":"jin043-leguang-finite","slot":"kai-staff"},"chapter_id":"c-jinshu-043-leguang","source_term":"參驃騎軍事","source_anchor":{"paragraph_id":"c-jinshu-043-leguang:p011","start":12,"end":17,"surface":"參驃騎軍事"},"source_revision":2618531,"paragraph_sha256":"c77c8f62870709b292b948446e7b1149664f259b8d4c97adf5e04732ee6d78cd","date_expression":null,"kind":"official_duty","values":{"duty_code":"military_staff_service","organ_source_name":"驃騎軍事","leader_person_id":null,"formal_office_title":null}}],"source_reading_cases":[{"id":"rc-jin043-leguang-kai","classification":"unresolved_cross_chapter_person","person_id":"415_m3h_x11_AA","candidate_person_ids":["051_0bw_d9m"],"status":"unresolved","source_chapter_ids":["c-jinshu-043-leguang","c-jinshu-043-guoshu"],"source_quotes":["凱字弘緒，大司馬齊王掾，參驃騎軍事。肇字弘茂，太傅東海王掾。洛陽陷，兄弟相攜南渡江。謨字弘範，征虜將軍、吳郡內史。","王敦召為參軍，轉從事中郎。襄陽都督周訪卒，敦遣舒監襄陽軍。甘卓至，乃還。朝廷征舒為右丞，敦留不遣。敦謀為逆，舒諫不從，使守武昌。荊州別駕宗澹忌舒才能，數譖之于王暠。暠疑舒與甘卓同謀，密以白敦，敦不受。高官督護繆坦嘗請武昌城西地為營，太守樂凱言於敦曰：「百姓久買此地，種菜自贍，不宜奪之。」敦大怒曰：「王處仲不來江湖，當有武昌地不，而人云是我地邪！」凱懼，不敢言。舒曰：「公聽舒一言。」敦曰：「平子以卿病狂，故掐鼻灸眉頭，舊疢復發邪！」舒曰：「古之狂也直，周昌、汲黯、硃雲不狂也。昔堯立誹謗之木，舜置敢諫之鼓，然後事無枉縱。公為勝堯、舜邪？乃逆折舒，使不得言。何與古人相遠！」敦曰：「卿欲何言？」舒曰：「繆坦可謂小人，疑誤視聽，奪人私地，以強陵弱。晏子稱：君曰其可，臣獻其否，以成其可。是以舒等不敢不言。」敦即使還地，眾咸壯之。敦重舒公亮，給賜轉豐，數詣其家。表為梁州刺史。病卒。"],"interpretation_note":"末兩段廣三子凱、繼敘凱字弘緒為同人。與郭舒篇武昌太守樂凱051_0bw_d9m時代及南渡地域相容，但現已讀兩篇無字、父名或共同事件的橋，暫分來源身份並存未決同指，不宣稱必為異人。","human_reviewed":false,"chapter_id":"c-jinshu-043-leguang","source_id":"s-jinshu-043-ws2618531-leguang"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin043-leguang-kai-father","status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-043","source_id":"s-jinshu-043-ws2618531-leguang","chapter_id":"c-jinshu-043-leguang","paragraph_id":"c-jinshu-043-leguang:p010","quote":"成都王穎，廣之婿也，及與長沙王乂遘難，而廣既處朝望，群小讒謗之。乂以問廣，廣神色不變，徐答曰：「廣豈以五男易一女。」乂猶以為疑，廣竟以憂卒。荀籓聞廣之不免也，為之流涕。三子：凱、肇、謨。","subject_person_mention_id":"c-jinshu-043-leguang:p010:m0087","object_person_mention_id":"c-jinshu-043-leguang:p010:m0005"}],"reviewer":"Codex（AI代理）","human_reviewed":false,"model":null,"interpretation_note":"傳主樂廣的末附三子；只明父，不把名列順序作絕對排行，不補生母。","fixed_source_fact_binding":{"kind":"fixed_witness_person_fact_slots","key":"jin043-leguang-finite","slot":"kai-father"},"predicate":"father","subject_person_id":"415_m3h_x11_AA","object_person_id":"415_m3h_x11_A","qualifiers":{"source_term":"三子：凱、肇、謨","source_interpretation_status":"explicit_source_wording","lineage":"paternal"}}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"id":"nc-jin043-leguang-name-kai","person_id":"415_m3h_x11_AA","status":"contextual_provisional","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-043","source_id":"s-jinshu-043-ws2618531-leguang","chapter_id":"c-jinshu-043-leguang","paragraph_id":"c-jinshu-043-leguang:p011","quote":"凱字弘緒，大司馬齊王掾，參驃騎軍事。肇字弘茂，太傅東海王掾。洛陽陷，兄弟相攜南渡江。謨字弘範，征虜將軍、吳郡內史。","person_mention_id":"c-jinshu-043-leguang:p011:m0000"}],"reviewer":"Codex（AI代理）","human_reviewed":false,"model":null,"interpretation_note":"本名原字不改；姓依同源明父子與已明全名的父系稱姓習慣作有資格編輯推定，不稱原文明載完整姓名。","fixed_source_fact_binding":{"kind":"fixed_witness_person_fact_slots","key":"jin043-leguang-finite","slot":"name-kai"},"surname":"樂","ming":"凱","additional_names":[],"chapter_id":"c-jinshu-043-leguang","paragraph_id":"c-jinshu-043-leguang:p011","person_mention_id":"c-jinshu-043-leguang:p011:m0000","quote":"凱字弘緒，大司馬齊王掾，參驃騎軍事。肇字弘茂，太傅東海王掾。洛陽陷，兄弟相攜南渡江。謨字弘範，征虜將軍、吳郡內史。","fixed_biography_name_binding":{"kind":"fixed_punctuated_biography_name","source_revision":2618531,"paragraph_sha256":"c77c8f62870709b292b948446e7b1149664f259b8d4c97adf5e04732ee6d78cd","mode":"ming_only","name_mention_id":"c-jinshu-043-leguang:p011:m000