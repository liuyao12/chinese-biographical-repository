{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"flz_o6t_45l","canonical_person_id":"flz_o6t_45l","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["flz_o6t_45l"],"persons":[{"id":"flz_o6t_45l","label":"二世（司馬相如列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"二世","mention_ids":["c-shiji-117-xiangru:m048-0016","c-shiji-117-xiangru:m049-0097"]}],"evidence":[{"mention_id":"c-shiji-117-xiangru:m048-0016","chapter_id":"c-shiji-117-xiangru","paragraph_id":"c-shiji-117-xiangru:p048","quote":"二世"},{"mention_id":"c-shiji-117-xiangru:m049-0097","chapter_id":"c-shiji-117-xiangru","paragraph_id":"c-shiji-117-xiangru:p049","quote":"二世"}]}],"source_mention_summary":[{"source_id":"s-shiji117-xiangru","work_id":"w-shiji","book_id":"b-shiji-117","chapter_id":"c-shiji-117-xiangru","mention_count":2,"mention_ids":["c-shiji-117-xiangru:m048-0016","c-shiji-117-xiangru:m049-0097"],"paragraph_ids":["c-shiji-117-xiangru:p048","c-shiji-117-xiangru:p049"],"passage_count":2}],"most_mentioned_source_ids":["s-shiji117-xiangru"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-117-xiangru:m048-0016","start":16,"end":18,"surface":"二世","kind":"person","person_id":"flz_o6t_45l","status":"contextual_provisional","paragraph_id":"c-shiji-117-xiangru:p048","chapter_id":"c-shiji-117-xiangru"},{"id":"c-shiji-117-xiangru:m049-0097","start":97,"end":99,"surface":"二世","kind":"person","person_id":"flz_o6t_45l","status":"contextual_provisional","paragraph_id":"c-shiji-117-xiangru:p049","chapter_id":"c-shiji-117-xiangru"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-117-xiangru:p048","text":"上善之。還過宜春宮，相如奏賦以哀二世行失也。其辭曰：","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m048-0000","start":0,"end":1,"surface":"上","kind":"person","person_id":"7jv_d9q_x7x","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m048-0010","start":10,"end":12,"surface":"相如","kind":"person","person_id":"usb_lgr_ksa","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m048-0016","start":16,"end":18,"surface":"二世","kind":"person","person_id":"flz_o6t_45l","status":"contextual_provisional"}],"chapter_id":"c-shiji-117-xiangru","book_id":"b-shiji-117","work_id":"w-shiji","source_id":"s-shiji117-xiangru"},{"id":"c-shiji-117-xiangru:p049","text":"登陂阤之長阪兮，坌入曾宮之嵳峩。臨曲江之隑州兮，望南山之參差。巖巖深山之谾谾兮，通谷𧯆兮谽𧯋。汩淢噏習以永逝兮，注平臯之廣衍。觀衆樹之塕薆兮，覽竹林之榛榛。東馳土山兮，北揭石瀨。彌節容與兮，曆吊二世。持身不謹兮，亡國失埶。信讒不寤兮，宗廟滅絕。嗚呼哀哉！操行之不得兮，墳墓蕪穢而不脩兮，魂無歸而不食。夐邈絕而不齊兮，彌久遠而愈鬐。精罔閬而飛揚兮，拾九天而永逝。嗚呼哀哉！","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m049-0097","start":97,"end":99,"surface":"二世","kind":"person","person_id":"flz_o6t_45l","status":"contextual_provisional"}],"chapter_id":"c-shiji-117-xiangru","book_id":"b-shiji-117","work_id":"w-shiji","source_id":"s-shiji117-xiangru"}],"sources":[{"chapter_id":"c-shiji-117-xiangru","work_id":"w-shiji","book_id":"b-shiji-117","source_id":"s-shiji117-xiangru","source":{"title":"史記／卷117","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷117","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷117&oldid=10371549","revision_id":10371549,"accessed_on":"2026-10-11","extent":"固定修訂全文71段，包括賦、書與末段索隱述贊。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"去header2、目錄標記及現代節標；quote模板保留全文，br轉段落；罕字模板保留第一參數字形，描述未作正文；連結保留顯示字。未核影像。 移除防轉換控制外殼，保留內字云。","note":"第58段U+E0FA私用字缺字與頌中重句原樣保存，不猜補；末段索隱述贊分層。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical"}}
