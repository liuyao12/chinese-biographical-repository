{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"o1h_uf8_1bw","canonical_person_id":"o1h_uf8_1bw","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["o1h_uf8_1bw"],"persons":[{"id":"o1h_uf8_1bw","label":"任度（孫吳將軍）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"任度","mention_ids":["c-sanguozhi-064-suncong-complete:p005:m0158"]}],"evidence":[{"mention_id":"c-sanguozhi-064-suncong-complete:p005:m0158","paragraph_id":"c-sanguozhi-064-suncong-complete:p005","chapter_id":"c-sanguozhi-064-suncong-complete","quote":"任度"}],"review":"ai_provisional","identity_note":"任度（孫吳將軍），見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-sanguozhi-064-suncong-complete-ws2263487","work_id":"w-sanguozhi","book_id":"b-sanguozhi-064","chapter_id":"c-sanguozhi-064-suncong-complete","raw_mention_count":1,"mention_ids":["c-sanguozhi-064-suncong-complete:p005:m0158"],"paragraph_ids":["c-sanguozhi-064-suncong-complete:p005"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-sanguozhi-064-suncong-complete:p005:m0158","mention_ids":["c-sanguozhi-064-suncong-complete:p005:m0158"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-sanguozhi-064-suncong-complete-ws2263487"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-064-suncong-complete:p005:m0158","surface":"任度","start":158,"end":160,"kind":"person","person_id":"o1h_uf8_1bw","status":"contextual_provisional","paragraph_id":"c-sanguozhi-064-suncong-complete:p005","chapter_id":"c-sanguozhi-064-suncong-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-064-suncong-complete:p005","text":"　　魏大將軍諸葛誕舉壽春叛，保城請降。吳遣文欽、唐諮、全端、全懌等三萬人救之。魏鎮南將軍王基圍入誕。欽等突圍城。魏悉中外軍二十餘萬增誕之圍。朱異帥三萬人屯安豐城，為文欽勢。魏兗州刺史州泰據異於陽淵，異敗退，為泰所追，死傷二干人。林於是大發率出屯鑊裡，復遣異率將軍丁奉、黎斐等五萬人攻魏，留輜重於都陸。異屯黎漿，遣將軍任度、張震等慕勇敢六千人，於屯西六里為浮橋夜渡，築偃月壘。為魏監軍石苞及州泰所破，軍卻退就高。異復作車箱圍趣五木城。苞、泰攻異，異敗歸，而魏太山太守胡烈以奇兵五千詭道襲都陸，盡焚異資糧。綝授兵三萬人使異死戰，異不從，綝斬之於鑊裡，而遣弟恩救。會誕敗引還。綝既不能拔出誕，而喪敗士眾，自戮名將，莫不怨之。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":82,"last_line":82,"raw_start":11043,"raw_end":11352,"raw_character_offsets":[11043,11044,11045,11046,11047,11048,11049,11050,11051,11052,11053,11054,11055,11056,11057,11058,11059,11060,11061,11062,11063,11064,11065,11066,11067,11068,11069,11070,11071,11072,11073,11074,11075,11076,11077,11078,11079,11080,11081,11082,11083,11084,11085,11086,11087,11088,11089,11090,11091,11092,11093,11094,11095,11096,11097,11098,11099,11100,11101,11102,11103,11104,11105,11106,11107,11108,11109,11110,11111,11112,11113,11114,11115,11116,11117,11118,11119,11120,11121,11122,11123,11124,11125,11126,11127,11128,11129,11130,11131,11132,11133,11134,11135,11136,11137,11138,11139,11140,11141,11142,11143,11144,11145,11146,11147,11148,11149,11150,11151,11152,11153,11154,11155,11156,11157,11158,11159,11160,11161,11162,11163,11164,11165,11166,11167,11168,11169,11170,11171,11172,11173