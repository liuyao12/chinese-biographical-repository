us":"contextual_provisional"}],"chapter_id":"c-shiji-034-yan","book_id":"b-shiji-034","work_id":"w-shiji","source_id":"s-shiji-034-yan"},{"id":"c-shiji-034-yan:p020","text":"易王初立，齊宣王因燕喪伐我，取十城；蘇秦説齊，使復歸燕十城。十年，燕君爲王。蘇秦與燕文公夫人私通，懼誅，乃説王使齊爲反閒，欲以亂齊。易王立十二年卒，子燕噲立。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-034-yan:m020-0000","start":0,"end":2,"surface":"易王","kind":"person","person_id":"n4f_fqh_04q","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m020-0005","start":5,"end":8,"surface":"齊宣王","kind":"person","person_id":"hmc_rv2_qxm","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m020-0018","start":18,"end":20,"surface":"蘇秦","kind":"person","person_id":"422_9v5_g9x","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m020-0033","start":33,"end":35,"surface":"燕君","kind":"person","person_id":"n4f_fqh_04q","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m020-0038","start":38,"end":40,"surface":"蘇秦","kind":"person","person_id":"422_9v5_g9x","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m020-0041","start":41,"end":44,"surface":"燕文公","kind":"person","person_id":"6x9_ucz_nl2","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m020-0044","start":44,"end":46,"surface":"夫人","kind":"person","person_id":"5s5_hwm_0gx","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m020-0066","start":66,"end":68,"surface":"易王","kind":"person","person_id":"n4f_fqh_04q","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m020-0075","start":75,"end":77,"surface":"燕噲","kind":"person","person_id":"n4f_fqh_04q_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-034-yan","book_id":"b-shiji-034","work_id":"w-shiji","source_id":"s-shiji-034-yan"}],"table_passages":[{"id":"shiji-015-r116-c07","column":7,"rowspan":1,"colspan":1,"text":"燕文公元年","source_row":117,"source_column":8,"printed_page":null,"person_mentions":[{"id":"shiji-015-r116-c07-m000","start":0,"end":3,"surface":"燕文公","person_id