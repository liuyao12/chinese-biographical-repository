及時事，晏抵掌曰：「公常言晏怯，今定如何？」建武元年，進號驃騎大將軍，給班劍二十人，又加兵百人，領太子少傅，進爵爲公。以魏軍動，給兵千人。","mentions":[{"id":"c-nanshi-024-wangyan:p006:m0011","surface":"晏","start":11,"end":12,"person_id":"i08_s4b_5bb","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangyan:p006:m0013","surface":"徐孝嗣","start":13,"end":16,"person_id":"tvq_5nw_rqn","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangyan:p006:m0034","surface":"晏","start":34,"end":35,"person_id":"i08_s4b_5bb","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangyan:p006:m0080","surface":"蕭諶","start":80,"end":82,"person_id":"wp8_2dc_ric","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangyan:p006:m0093","surface":"晏","start":93,"end":94,"person_id":"i08_s4b_5bb","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangyan:p006:m0100","surface":"諶","start":100,"end":101,"person_id":"wp8_2dc_ric","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangyan:p006:m0113","surface":"晏","start":113,"end":114,"person_id":"i08_s4b_5bb","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangyan:p006:m0121","surface":"晏","start":121,"end":122,"person_id":"i08_s4b_5bb","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangyan:p006:m0130","surface":"晏","start":130,"end":131,"person_id":"i08_s4b_5bb","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":1765279,"source_layer":"received_biography","first_line":103,"last_line":103,"line_start":0,"line_end":186,"raw_start":4414,"raw_end":4600,"raw_