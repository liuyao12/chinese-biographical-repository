hu-063-liju:p001:m0088","surface":"宋胄","start":88,"end":90,"person_id":"2er_i2n_etq","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-063-liju:p001","chapter_id":"c-jinshu-063-liju"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-063-liju:p001","text":"李矩，字世回，平陽人也。童齔時，與群兒聚戲，便為其率，計畫指授，有成人之量。及長，為吏，送故縣令于長安，征西將軍梁王肜以為牙門。伐氐齊萬年有殊功，封東明亭侯。還為本郡督護。太守宋胄欲以所親吳畿代之，矩謝病去。畿恐矩復還，陰使人刺矩，會有人救之，故得免。屬劉元海攻平陽，百姓奔走，矩素為鄉人所愛，乃推為塢主，東屯滎陽，後移新鄭。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":27,"last_line":27,"raw_start":1612,"raw_end":1777,"raw_character_offsets":[1614,1615,1616,1617,1618,1619,1620,1621,1622,1623,1624,1625,1626,1627,1628,1629,1630,1631,1632,1633,1634,1635,1636,1637,1638,1639,1640,1641,1642,1643,1644,1645,1646,1647,1648,1649,1650,1651,1652,1653,1654,1655,1656,1657,1658,1659,1660,1661,1662,1663,1664,1665,1666,1667,1668,1669,1670,1671,1672,1673,1674,1675,1676,1677,1678,1679,1680,1681,1682,1683,1684,1685,1686,1687,1688,1689,1690,1691,1692,1693,1694,1695,1696,1697,1698,1699,1700,1701,1702,1703,1704,1705,1706,1707,1708,1709,1710,1711,1712,1713,1714,1715,1716,1717,1718,1719,1720,1721,1722,1723,1724,1725,1726,1727,1728,1729,1730,1731,1732,1733,1734,1735,1736,1737,1738,1739,1740,1741,1742,1743,1744,1745,1746,1747,1748,1749,1750,1751,1752,1753,1754,1755,1756,1757,1758,1759,1760,1761,1762,1763,1764,1765,1766,1767,1768,1769,1770,1771,1772,1773,1774,1775,1776],"revision_id":2025242},"mentions":[{"id":"c-jinshu-063-liju:p001:m0000","surface":"李矩","start":0,"end":2,"person_id":"tqt_mih_3ao","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-063-liju:p001:m0056","surface":"梁王肜","start":56,"end":59,"person_id":"dkn_ge4_286_AAAAF","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-063-liju