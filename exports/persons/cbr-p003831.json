16-0120","start":120,"end":123,"surface":"大夫種","kind":"person","person_id":"cbr-p003843","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m016-0126","start":126,"end":130,"surface":"吳太宰嚭","kind":"person","person_id":"cbr-p003831","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m016-0138","start":138,"end":140,"surface":"臣妾","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代，未補姓名及成員；鮑氏不直接等同鮑牧。"},{"id":"c-shiji-066-wu:m016-0141","start":141,"end":143,"surface":"吳王","kind":"person","person_id":"cbr-p003840","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m016-0147","start":147,"end":150,"surface":"伍子胥","kind":"person","person_id":"cbr-p003808","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m016-0154","start":154,"end":156,"surface":"越王","kind":"person","person_id":"cbr-p003842","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m016-0163","start":163,"end":164,"surface":"王","kind":"person","person_id":"cbr-p003840","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m016-0173","start":173,"end":175,"surface":"吳王","kind":"person","person_id":"cbr-p003840","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m016-0179","start":179,"end":182,"surface":"太宰嚭","kind":"person","person_id":"cbr-p003831","status":"contextual_provisional"}],"chapter_id":"c-shiji-066-wu","book_id":"b-shiji-066","work_id":"w-shiji","source_id":"s-shiji-066-wu"},{"id":"c-shiji-066-wu:p018","text":"其後四年，吳王將北伐齊，越王句踐用子貢之謀，乃率其眾以助吳，而重寶以獻遺太宰嚭。太宰嚭既數受越賂，其愛信越殊甚，日夜為言於吳王。吳王信用嚭之計。伍子胥諫曰：「夫越，腹心之病，今信其浮辭詐偽而貪齊。破齊，譬猶石田，無所用之。且盤庚之誥曰：『有顛越不恭，劓殄滅之，俾無遺育，無使易種于茲邑。』此商之所以興。願王釋齊而先越；若不然，後將悔之無及。」而吳王不聽，使子胥於齊。子胥臨行，謂其子曰：「吾數諫王，王不用，吾今見吳之亡矣。汝與吳俱亡，無益也。」乃屬其子於齊鮑牧，而還報吳。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-066-wu:m018-0005","start":5,"end":7,"surface":"吳王","kind":"person","person_id":"cbr-p003840","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m018-0012","start":12,"end":16,"surfac