{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003559","identity_policy":"contextual_provisional","person_ids":["cbr-p003559"],"persons":[{"id":"cbr-p003559","label":"茅蘭（梁孝王世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"茅蘭","mention_ids":["c-shiji-058-liang:m010-0015"]}],"evidence":[{"mention_id":"c-shiji-058-liang:m010-0015","chapter_id":"c-shiji-058-liang","paragraph_id":"c-shiji-058-liang:p010","quote":"茅蘭"}]}],"source_mention_summary":[{"source_id":"s-shiji-058-liang","work_id":"w-shiji","book_id":"b-shiji-058","chapter_id":"c-shiji-058-liang","mention_count":1,"mention_ids":["c-shiji-058-liang:m010-0015"],"paragraph_ids":["c-shiji-058-liang:p010"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-058-liang"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-058-liang:m010-0015","start":15,"end":17,"surface":"茅蘭","kind":"person","person_id":"cbr-p003559","status":"contextual_provisional","paragraph_id":"c-shiji-058-liang:p010","chapter_id":"c-shiji-058-liang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji058-020","person_id":"cbr-p003559","surfaces":["茅蘭"],"scope":"same_chapter","chapter_ids":["c-shiji-058-liang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-058-liang:p010","quote":"上怒稍解，因上書請朝。既至關，茅蘭說王，使乘布車，從兩騎入，匿於長公主園。漢使使迎王，王已入關，車騎盡居外，不知王處。太后泣曰：「帝殺吾子！」景帝憂恐。於是梁王伏斧質於闕下，謝罪，然後太后、景帝大喜，相泣，復如故。悉召王從官入關。然景帝益疏王，不同車輦矣。"}],"rationale":"按明示姓名、世系與局部王號暫接。梁武、勝、參、登、義、買、襄等不按同王號合併；梁王勝與羊勝分辨。李太后陳太后分存；主張、指控、泛稱與授職分辨，正文與附述各保留。官爵全史與跨篇身份仍待覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-058-liang:p010","text":"上怒稍解，因上書請朝。既至關，茅蘭說王，使乘布車，從兩騎入，匿於長公主園。漢使使迎王，王已入關，車騎盡居外，不知王處。太后泣曰：「帝殺吾子！」景帝憂恐。於是梁王伏斧質於闕下，謝罪，然後太后、景帝大喜，相泣，復如故。悉召王從官入關。然景帝益疏王，不同車輦矣。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-058-liang:m010-0000","start":0,"end":1,"surface":"上","kind":"person","person_id":"cbr-p003542","status":"contextual_provisional"},{"id":"c-shiji-058-liang:m010-0015","start":15,"end":17,"surface":"茅蘭","kind":"person","person_id":"cbr-p003559","status":"contextual_provisional"},{"id":"c-shiji-058-liang:m010-0018","start":18,"end":19,"surface":"王","kind":"person","person_id":"cbr-p003540","status":"contextual_provisional"},{"id":"c-shiji-058-liang:m010-0026","start":26,"end":28,"surface":"兩騎","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、所舉古事或未定指代；不補來源未見姓名、成員及關係。"},{"id":"c-shiji-058-liang:m010-0032","start":32,"end":35,"surface":"長公主","kind":"person","person_id":"cbr-p003558","status":"contextual_provisional"},{"id":"c-shiji-058-liang:m010-0041","start":41,"end":42,"surface":"王","kind":"person","person_id":"cbr-p003540","status":"contextual_provisional"},{"id":"c-shiji-058-liang:m010-0043","start":43,"end":44,"surface":"王","kind":"person","person_id":"cbr-p003540","status":"contextual_provisional"},{"id":"c-shiji-058-liang:m010-0056","start":56,"end":57,"surface":"王","kind":"person","person_id":"cbr-p003540","status":"contextual_provisional"},{"id":"c-shiji-058-liang:m010-0059","start":59,"end":61,"surface":"太后","kind":"person","person_id":"cbr-p003543","status":"contextual_provisional"},{"id":"c-shiji-058-liang:m010-0065","start":65,"end":66,"surface":"帝","kind":"person","person_id":"cbr-p003542","status":"contextual_provisional"},{"id":"c-shiji-058-liang:m010-0071","start":71,"end":73,"surface":"景帝","kind":"person","person_id":"cbr-p003542","status":"contextual_provisional"},{"id":"c-shiji-058-liang:m010-0078","start":78,"end":80,"surface":"梁王","kind":"person","person_id":"cbr-p003540","status":"contextual_provisional"},{"id":"c-shiji-058-liang:m010-0092","start":92,"end