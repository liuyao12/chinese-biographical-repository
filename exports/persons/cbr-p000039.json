比之三凶。舜賓於四門，乃流四凶族，遷于四裔，以御螭魅，於是四門辟，言毋凶人也。","mentions":[{"id":"c-shiji-001-wudi:m023-0001","start":1,"end":4,"surface":"帝鴻氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"可能為個人、官職、群體、氏族或國號；不憑本篇未明示的外部對應補造身份。"},{"id":"c-shiji-001-wudi:m023-0023","start":23,"end":25,"surface":"渾沌","kind":"person","person_id":"sd1_zvh_sby","status":"source_identified"},{"id":"c-shiji-001-wudi:m023-0026","start":26,"end":29,"surface":"少暤氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"可能為個人、官職、群體、氏族或國號；不憑本篇未明示的外部對應補造身份。"},{"id":"c-shiji-001-wudi:m023-0048","start":48,"end":50,"surface":"窮奇","kind":"person","person_id":"v9o_9nn_wtg","status":"source_identified"},{"id":"c-shiji-001-wudi:m023-0051","start":51,"end":54,"surface":"顓頊氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"可能為個人、官職、群體、氏族或國號；不憑本篇未明示的外部對應補造身份。"},{"id":"c-shiji-001-wudi:m023-0073","start":73,"end":75,"surface":"檮杌","kind":"person","person_id":"ezp_adc_v7h","status":"source_identified"},{"id":"c-shiji-001-wudi:m023-0085","start":85,"end":86,"surface":"堯","kind":"person","person_id":"oho_r3f_c6y","status":"source_identified"},{"id":"c-shiji-001-wudi:m023-0087","start":87,"end":88,"surface":"堯","kind":"person","person_id":"oho_r3f_c6y","status":"source_identified"},{"id":"c-shiji-001-wudi:m023-0092","start":92,"end":95,"surface":"縉雲氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"可能為個人、官職、群體、氏族或國號；不憑本篇未明示的外部對應補造身份。"},{"id":"c-shiji-001-wudi:m023-0114","start":114,"end":116,"surface":"饕餮","kind":"person","person_id":"ezo_kwy_dw4","status":"source_identified"},{"id":"c-shiji-001-wudi:m023-0127","start":127,"end":128,"surface":"舜","kind":"person","person_id":"ddb_l4j_4j2","status":"source_identified"},{"id":"c-shiji-001-wudi:m023-0135","start":135,"end":138,"surface":"四凶族","kind":"unresolved","person_id":null,"status":"unresolved","note":"可能為個人、官職、群體、氏族或國號；不憑本篇未明示的外部對應補造身份。"}],"chapter_id":"c-shiji-001-wudi","book_id":"b-shiji-001","work_id":"w-sh