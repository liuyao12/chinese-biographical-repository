{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"hfw_50q_zd2","canonical_person_id":"hfw_50q_zd2","id_aliases":["cbr-p000752"],"identity_policy":"contextual_provisional","person_ids":["hfw_50q_zd2"],"persons":[{"id":"hfw_50q_zd2","label":"呂媼","status":"active","historicity":"historical_tradition","aliases":[{"surface":"呂媼","mention_ids":["c-shiji-008-gaozu:m004-0223"]}],"evidence":[{"mention_id":"c-shiji-008-gaozu:m004-0223","chapter_id":"c-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p004","quote":"呂媼"}],"id_aliases":["cbr-p000752"]}],"source_mention_summary":[{"source_id":"s-shiji-008-gaozu","work_id":"w-shiji","book_id":"b-shiji-008","chapter_id":"c-shiji-008-gaozu","mention_count":1,"mention_ids":["c-shiji-008-gaozu:m004-0223"],"paragraph_ids":["c-shiji-008-gaozu:p004"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-008-gaozu"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-008-gaozu:m004-0223","start":223,"end":225,"surface":"呂媼","kind":"person","person_id":"hfw_50q_zd2","status":"contextual_provisional","paragraph_id":"c-shiji-008-gaozu:p004","chapter_id":"c-shiji-008-gaozu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-008-gaozu:p004","text":"單父人呂公善沛令，避仇從之客，因家沛焉。沛中豪桀吏聞令有重客，皆往賀。蕭何為主吏，主進，令諸大夫曰：「進不滿千錢，坐之堂下。」高祖為亭長，素易諸吏，乃紿為謁曰「賀錢萬」，實不持一錢。謁入，呂公大驚，起，迎之門。呂公者，好相人，見高祖狀貌，因重敬之，引入坐。蕭何曰：「劉季固多大言，少成事。」高祖因狎侮諸客，遂坐上坐，無所詘。酒闌，呂公因目固留高祖。高祖竟酒，後。呂公曰：「臣少好相人，相人多矣，無如季相，願季自愛。臣有息女，願為季箕帚妾。」酒罷，呂媼怒呂公曰：「公始常欲奇此女，與貴人。沛令善公，求之不與，何自妄許與劉季？」呂公曰：「此非兒女子所知也。」卒與劉季。呂公女乃呂后也，生孝惠帝、魯元公主。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m004-0003","start":3,"end":5,"surface":"呂公","kind":"person","person_id":"i30_mjq_6q8","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m004-0006","start":6,"end":8,"surface":"沛令","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名官稱或傳說指稱尚待覆核；不補姓名或親屬。"},{"id":"c-shiji-008-gaozu:m004-0035","start":35,"end":37,"surface":"蕭何","kind":"person","person_id":"xd8_uww_5ok","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m004-0063","start":63,"end":65,"surface":"高祖","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m004-0094","start":94,"end":96,"surface":"呂公","kind":"person","person_id":"i30_mjq_6q8","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m004-0105","start":105,"end":107,"surface":"呂公","kind":"person","person_id":"i30_mjq_6q8","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m004-0114","start":114,"end":116,"surface":"高祖","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m004-0128","start":128,"end":130,"surface":"蕭何","kind":"person","person_id":"xd8_uww_5ok","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m004-0133","start":133,"end":135,"surface":"劉季","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m004-0145","start":145,"end":147,"surface":"高祖","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m004-0165","start":165,"end":167,"surface":"呂公","kind":"person","person_id":"i30_mjq_6q8","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m004-0171","start":171,"end":173,"surface":"高祖","kind":"person","person_id":"yqp_nlb_p1p_