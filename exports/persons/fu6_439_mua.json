on_containers_not_independent_witness_passages","count_explanation":"2處獨立位置，2個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"},{"source_id":"s-jinshu-076-wangbiaozhi","work_id":"w-jinshu","book_id":"b-jinshu-076","chapter_id":"c-jinshu-076-wangbiaozhi","raw_mention_count":1,"mention_ids":["c-jinshu-076-wangbiaozhi:line071:m0009"],"paragraph_ids":["c-jinshu-076-wangbiaozhi:line071"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-076-wangbiaozhi:line071:m0009","mention_ids":["c-jinshu-076-wangbiaozhi:line071:m0009"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-077-yinhao"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"id":"name-jin077-f51-037","person_id":"fu6_439_mua","title":null,"surname":"梁","ming":"安","additional_names":[],"chapter_id":"c-jinshu-077-yinhao","paragraph_id":"c-jinshu-077-yinhao:p006","person_mention_id":"c-jinshu-077-yinhao:p006:m0136","quote":"及石季龍死，胡中大亂，朝過欲遂蕩平關河，於是以浩為中軍將軍、假節、都督揚豫徐兗青五州軍事。浩既受命，以中原為己任，上疏北征許洛。將發，墜馬，時咸惡之。既而以淮南太守陳逵、兗州刺史蔡裔為前鋒，安西將軍謝尚、北中郎將荀羨為督統，開江西田千餘頃，以為軍儲。師次壽陽，潛誘苻健大臣梁安、雷弱兒等，使殺健，許以關右之任。初，降人魏脫卒，其弟憬代領部曲。姚襄殺憬，以並其眾，浩大惡之，使龍驤將軍劉啟守譙，遷襄于梁。既而魏氏子弟往來壽陽，襄益猜懼。俄而襄部曲有欲歸浩者，襄殺之，浩於是謀誅襄。會苻健殺其大臣，健兄子眉自洛陽西奔，浩以為梁安事捷，意苻健已死，請進屯洛陽，修復園陵，使襄為前驅，冠軍將軍劉洽鎮鹿台，建武將軍劉遁據倉垣，又求解揚州，專鎮洛陽，詔不許。浩既至許昌，會張遇反，謝尚又敗績，浩還壽陽。後復進軍，次山桑，而襄反，浩懼，棄輜重退保譙城，器械軍儲皆為襄所掠，士卒多亡叛。浩遣劉啟、王彬之擊襄于山桑，並為襄所殺。","source_anchor":{"paragraph_id":"c-jinshu-077-yinhao:p006","start":136,"end":138,"surface":"梁安"},"note":"明冠姓名按原字；略名不由父姓或既有label倒填本句未見之姓，保留字形差異。","status":"editorial_provisional","human_reviewed":false,"model":null,"work_id":"w-jinshu","book_id":"b-jinshu-077","source_id":"s-jinshu-077-yinhao"}],"mentions":[{"id":"c-jinshu-076-wangbiaozhi:line071:m0009","start":9,"end":11,"surface":"梁安","kind":"person","person_id":"fu6_439_mua","status":"contextual_provisional","paragraph_id":"c-jinshu-076-wangbiaozhi:line071","chapter_id":"c-jinshu-076-wangbiaozhi"},{"id":"c-jinshu-077-yinhao:p006:m0136","start":136,"end":138,"surface":"梁安","kind":"person","person_id":"fu6_439_mua","status":"contextual_provisional","interpretation_note":"依完整敘事／引語主語逐段辨識；原字不校改。","paragraph_id":"c-jinshu-077-yinhao:p006","chapter_id":"c-jinshu-077-yinhao"},{"id":"c-jinshu-077-yinhao:p006:m0260","start":260,"end":262,"surface":"梁安","kind":"person","person_id":"fu6_439_mua","status":"contextual_provisional","interpretation_note":"依完整敘事／引語主語逐段辨識；原字不校改。","paragraph_id":"c-jinshu-077-yinhao:p006","chapter_id":"c-jinshu-077-yinhao"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-076-wangbiaozhi:line071","text":"既而長安人雷弱兒、梁安等詐云殺苻健、苻眉，請兵應接。時殷浩鎮壽陽，便進據洛，營復山陵。屬彪之疾歸，上簡文帝箋，陳弱兒等容有詐偽，浩未應輕進。尋而弱兒果詐，姚襄反叛，浩大敗，退守譙城。簡文笑謂彪之曰：「果如君言。自頃以來，君謀無遺策，張、陳何以過之！」","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-076-wangbiaozhi:line071:m0005","start":5,"end":8,"surface":"雷弱兒","kind":"person","person_id":"g1b_96g_hmt","status":"contextual_provisional"},{"id":"c-jinshu-076-wangbiaozhi:line071:m0009","start":9,"end":11,"surf