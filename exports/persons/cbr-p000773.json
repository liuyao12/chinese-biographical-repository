d_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m029-0003","start":3,"end":5,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m029-0006","start":6,"end":8,"surface":"韓信","kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m029-0017","start":17,"end":19,"surface":"雍王","kind":"person","person_id":"4jv_qte_5p4","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m029-0019","start":19,"end":21,"surface":"章邯","kind":"person","person_id":"4jv_qte_5p4","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m029-0022","start":22,"end":23,"surface":"邯","kind":"person","person_id":"4jv_qte_5p4","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m029-0049","start":49,"end":51,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m029-0064","start":64,"end":66,"surface":"雍王","kind":"person","person_id":"4jv_qte_5p4","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m029-0087","start":87,"end":89,"surface":"薛歐","kind":"person","person_id":"jit_1ud_8if","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m029-0090","start":90,"end":92,"surface":"王吸","kind":"person","person_id":"6mx_6a9_sa9","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m029-0097","start":97,"end":99,"surface":"王陵","kind":"person","person_id":"5do_703_rfz","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m029-0105","start":105,"end":107,"surface":"太公","kind":"person","person_id":"yqp_nlb_p1p","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m029-0108","start":108,"end":110,"surface":"呂后","kind":"person","person_id":"i30_mjq_6q8_A","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m029-0132","start":132,"end":134,"surface":"鄭昌","kind":"person","person_id":"vxt_uj1_8ym","status":"contextual_provisional"}],"