{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p005272","identity_policy":"contextual_provisional","person_ids":["cbr-p005272"],"persons":[{"id":"cbr-p005272","label":"章平（樊酈滕灌列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"章平","mention_ids":["c-shiji-095-fankuang:m005-0035"]}],"evidence":[{"mention_id":"c-shiji-095-fankuang:m005-0035","chapter_id":"c-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p005","quote":"章平"}]}],"mentions":[{"id":"c-shiji-095-fankuang:m005-0035","start":35,"end":37,"surface":"章平","kind":"person","person_id":"cbr-p005272","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p005","chapter_id":"c-shiji-095-fankuang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji095-022","person_id":"cbr-p005272","scope":"same_chapter","chapter_ids":["c-shiji-095-fankuang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["章平"],"evidence":[{"paragraph_id":"c-shiji-095-fankuang:p005","quote":"還定三秦，別擊西丞白水北，雍輕車騎於雍南，破之。從攻雍、斄城，先登。擊章平軍好畤，攻城，先登陷陣，斬縣令丞各一人，首十一級，虜二十人，遷郎中騎將。從擊秦車騎壤東，卻敵，遷為將軍。攻趙賁，下郿、槐裏、柳中、咸陽；灌廢丘，最。至櫟陽，賜食邑杜之樊鄉。從攻項籍，屠煮棗。擊破王武、程處軍於外黃。攻鄒、魯、瑕丘、薛。項羽敗漢王於彭城，盡復取魯、梁地。噲還至滎陽，益食平陰二千戶，以將軍守廣武。一歲，項羽引而東。從高祖擊項籍，下陽夏，虜楚周將軍卒四千人。圍項籍於陳，大破之。屠胡陵。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定異稱。酈寄字況據第14段；夏侯嬰的嬰限定第16至21段，灌嬰限定第22至33段，桓嬰另人。第6與20、28段楚王信和反韓王信分人；未詳名王侯不補名。同名跨篇同指另待逐項證據。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-095-fankuang:p005","text":"還定三秦，別擊西丞白水北，雍輕車騎於雍南，破之。從攻雍、斄城，先登。擊章平軍好畤，攻城，先登陷陣，斬縣令丞各一人，首十一級，虜二十人，遷郎中騎將。從擊秦車騎壤東，卻敵，遷為將軍。攻趙賁，下郿、槐裏、柳中、咸陽；灌廢丘，最。至櫟陽，賜食邑杜之樊鄉。從攻項籍，屠煮棗。擊破王武、程處軍於外黃。攻鄒、魯、瑕丘、薛。項羽敗漢王於彭城，盡復取魯、梁地。噲還至滎陽，益食平陰二千戶，以將軍守廣武。一歲，項羽引而東。從高祖擊項籍，下陽夏，虜楚周將軍卒四千人。圍項籍於陳，大破之。屠胡陵。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m005-0035","start":35,"end":37,"surface":"章平","kind":"per