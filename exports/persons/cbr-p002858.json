{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p002858","canonical_person_id":"lc5_if4_4x7","id_aliases":["cbr-p002858"],"identity_policy":"contextual_provisional","person_ids":["lc5_if4_4x7"],"persons":[{"id":"lc5_if4_4x7","label":"晏嬰（孔子世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"晏嬰","mention_ids":["c-shiji-047-kong:m008-0021","c-shiji-047-kong:m010-0098"]},{"surface":"晏子","mention_ids":["c-shiji-047-kong:m017-0254"]}],"evidence":[{"mention_id":"c-shiji-047-kong:m008-0021","chapter_id":"c-shiji-047-kong","paragraph_id":"c-shiji-047-kong:p008","quote":"晏嬰"},{"mention_id":"c-shiji-047-kong:m010-0098","chapter_id":"c-shiji-047-kong","paragraph_id":"c-shiji-047-kong:p010","quote":"晏嬰"},{"mention_id":"c-shiji-047-kong:m017-0254","chapter_id":"c-shiji-047-kong","paragraph_id":"c-shiji-047-kong:p017","quote":"晏子"}],"id_aliases":["cbr-p002858"]}],"source_mention_summary":[{"source_id":"s-shiji-047-kong","work_id":"w-shiji","book_id":"b-shiji-047","chapter_id":"c-shiji-047-kong","mention_count":3,"mention_ids":["c-shiji-047-kong:m008-0021","c-shiji-047-kong:m010-0098","c-shiji-047-kong:m017-0254"],"paragraph_ids":["c-shiji-047-kong:p008","c-shiji-047-kong:p010","c-shiji-047-kong:p017"],"passage_count":3}],"most_mentioned_source_ids":["s-shiji-047-kong"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-047-kong:m008-0021","start":21,"end":23,"surface":"晏嬰","kind":"person","person_id":"lc5_if4_4x7","status":"contextual_provisional","paragraph_id":"c-shiji-047-kong:p008","chapter_id":"c-shiji-047-kong"},{"id":"c-shiji-047-kong:m010-0098","start":98,"end":100,"surface":"晏嬰","kind":"person","person_id":"lc5_if4_4x7","status":"contextual_provisional","paragraph_id":"c-shiji-047-kong:p010","chapter_id":"c-shiji-047-kong"},{"id":"c-shiji-047-kong:m017-0254","start":254,"end":256,"surface":"晏子","kind":"person","person_id":"lc5_if4_4x7","status":"contextual_provisional","paragraph_id":"c-shiji-047-kong:p017","chapter_id":"c-shiji-047-kong"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji047-036","person_id":"lc5_if4_4x7","surfaces":["晏嬰","晏子"],"scope":"same_chapter","chapter_ids":["c-shiji-047-kong"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-047-kong:p008","quote":"魯昭公之二十年，而孔子蓋年三十矣。齊景公與晏嬰來適魯，景公問孔子曰：「昔秦穆公國小處辟，其霸何也？」對曰：「秦，國雖小，其志大；處雖辟，行中正。身舉五羖，爵之大夫，起纍紲之中，與語三日，授之以政。以此取之，雖王可也，其霸小矣。」景公說。"},{"paragraph_id":"c-shiji-047-kong:p010","quote":"景公問政孔子，孔子曰：「君君，臣臣，父父，子子。」景公曰：「善哉！信如君不君，臣不臣，父不父，子不子，雖有粟，吾豈得而食諸！」他日又復問政於孔子，孔子曰：「政在節財。」景公說，將欲以尼谿田封孔子。晏嬰進曰：「夫儒者滑稽而不可軌法；倨傲自順，不可以為下；崇喪遂哀，破產厚葬，不可以為俗；游說乞貸，不可以為國。自大賢之息，周室既衰，禮樂缺有間。今孔子盛容飾，繁登降之禮，趨詳之節，累世不能殫其學，當年不能究其禮。君欲用之以移齊俗，非所以先細民也。」後景公敬見孔子，不問其禮。異日，景公止孔子曰：「奉子以季氏，吾不能。」以季孟之間待之。齊大夫欲害孔子，孔子聞之。景公曰：「吾老矣，弗能用也。」孔子遂行，反乎魯。"},{"paragraph_id":"c-shiji-047-kong:p017","quote":"定公十年春，及齊平。夏，齊大夫黎鉏言於景公曰：「魯用孔丘，其勢危齊。」乃使使告魯為好會，會於夾谷。魯定公且以乘車好往。孔子攝相事，曰：「臣聞有文事者必有武備，有武事者必有文備。古者諸侯出疆，必具官以從。請具左右司馬。」定公曰：「諾。」具左右司馬。會齊侯夾谷，為壇位，土階三等，以會遇之禮相見，揖讓而登。獻酬之禮畢，齊有司趨而進曰：「請奏四方之樂。」景公曰：「諾。」於是旍旄羽袚矛戟劍撥鼓噪而至。孔子趨而進，歷階而登，不盡一等，舉袂而言曰：「吾兩君為好會，夷狄之樂何為於此！請命有司！」有司卻之，不去，則左右視晏子與景公。景公心怍，麾而去之。有頃，齊有司趨而進曰：「請奏宮中之樂。」景公曰：「諾。」優倡侏儒為戲而前。孔子趨而進，歷階而登，不盡一等，曰：「匹夫而營惑諸侯者罪當誅！請命有司！」有司加法焉，手足異處。景公懼而動，知義不若，歸而大恐，告其羣臣曰：「魯以君子之道輔其君，而子獨以夷狄之道敎寡人，使得罪於魯君，為之奈何？」有司進對曰：「君子有過則謝以質，小人有過則謝以文。君若悼之，則謝以質。」於是齊侯乃歸所侵魯之鄆、汶陽、龜陰之田以謝過。"}],"rationale":"限本篇明示名、字、對話自稱、世系及附贊局部對應；世系求與冉求分開，武不接漢武帝，今皇帝與高皇帝不補姓名。子路仲由明示同指另存，冉有冉求與秦繆秦穆仍待核；附贊不當獨立作者正文或獨立見證。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-047-kong:p008","text":"魯昭公之二十年，而孔子蓋年三十矣。齊景公與晏嬰來適魯，景公問孔子曰：「昔秦穆公國小處辟，其霸何也？」對曰：「秦，國雖小，其志大；處雖辟，行中正。身舉五羖，爵之大夫，起纍紲之中，與語三日，授之以政。以此取之，雖王可也，其霸小矣。」景公說。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-047-kong:m008-0000","start":0,"end":3,"surface":"魯昭公","kind":"person","person_id":"x06_36x_8rd","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m008-0009","start":9,"end":11,"surface":"孔子","kind":"person","person_id":"f8d_j5p_nop_AAA","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m008-0017","start":17,"end":20,"surface":"齊景公","kind":"person","person_id":"bzo_2h9_2wd","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m008-0021","start":21,"end":23,"surface":"晏嬰","kind":"person","person_id":"lc5_if4_4x7","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m008-0027","start":27,"end":29,"surface":"景公","kind":"person","person_id":"bzo_2h9_2wd","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m008-0030","start":30,"end":32,"surface":"孔子","kind":"person","person_id":"f8d_j5p_nop_AAA","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m008-0036","start":36,"end":39,"surface":"秦穆公","kind":"person","person_id":"910_4xt_rwk","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m008-0074","start":74,"end":76,"surface":"五羖","kind":"person","person_id":"4ck_c0z_a0t","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m008-0114","start":114,"end":116,"surface":"景公","kind":"person","person_id":"bzo_2h9_2wd","status":"contextual_provisional"}],"chapter_id":"c-shiji-047-kong","book_id":"b-shiji-047","work_id":"w-shiji","source_id":"s-shiji-047-kong"},{"id":"c-shiji-047-kong:p010","text":"景公問政孔子，孔子曰：「君君，臣臣，父父，子子。」景公曰：「善哉！信如君不君，臣不臣，父不父，子不子，雖有粟，吾豈得而食諸！」他日又復問政於孔子，孔子曰：「政在節財。」景公說，將欲以尼谿田封孔子。晏嬰進曰：「夫儒者滑稽而不可軌法；倨傲自順，不可以為下；崇喪遂哀，破產厚葬，不可以為俗；游說乞貸，不可以為國。自大賢之息，周室既衰，禮樂缺有間。今孔子盛容飾，繁登降之禮，趨詳之節，累世不能殫其學，當年不能究其禮。君欲用之以移齊俗，非所以先細民也。」後景公敬見孔子，不問