onical_mention_id":"c-songshu-060-xunbozi:p002:m0053","mention_ids":["c-songshu-060-xunbozi:p002:m0053"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-099-huanxuan-ws2644703","s-songshu-060-xunbozi"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-099-huanxuan:p023:m0163","start":163,"end":165,"surface":"徐廣","kind":"person","person_id":"qf8_544_pvp","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。","paragraph_id":"c-jinshu-099-huanxuan:p023","chapter_id":"c-jinshu-099-huanxuan"},{"id":"c-songshu-060-xunbozi:p002:m0053","start":53,"end":55,"surface":"徐廣","kind":"person","person_id":"qf8_544_pvp","status":"contextual_provisional","paragraph_id":"c-songshu-060-xunbozi:p002","chapter_id":"c-songshu-060-xunbozi"}],"relations":[],"title_holdings":[{"id":"th-songshu060-family-006","person_id":"qf8_544_pvp","title":"著作郎","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"work_id":"w-songshu","book_id":"b-songshu-060","source_id":"s-songshu-060-xunbozi","chapter_id":"c-songshu-060-xunbozi","paragraph_id":"c-songshu-060-xunbozi:p002","quote":"伯子少好學，博覽經傳，而通率好為雜戲，遨遊閭里，故以此失清塗。解褐為駙馬都尉，奉朝請，員外散騎侍郎。著作郎徐廣重其才學，舉伯子及王韶之並為佐郎，助撰晉史及著桓玄等傳。遷尚書祠部郎。","person_mention_id":"c-songshu-060-xunbozi:p002:m0053"}],"attestations":[{"id":"th-songshu060-family-006:a001","paragraph_id":"c-songshu-060-xunbozi:p002","start":50,"end":53,"surface":"著作郎","person_mention_id":"c-songshu-060-xunbozi:p002:m0053","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"來源用稱或明示任官；未知始終年保持未知。駙馬都尉不單獨證明尚公主；平陽侯比擬不作本人爵號。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-099-huanxuan:p023","text":"元興三年，玄之永始二年也，尚書答「春蒐」字誤為「春菟」，凡所關署皆被降黜。玄大綱不理，而糾摘纖微，皆此類也。以其妻劉氏為皇后，將修殿宇，乃移入東宮。又開東掖、平昌、廣莫及宮殿諸門，皆為三道。更造大輦，容三千人坐，以二百人舁之。性好畋遊，以體大不堪乘馬，又作徘徊輿，施轉關，令回動無滯。既不追尊祖曾，疑其禮義，問於群臣。散騎常侍徐廣據晉典宜追立七廟，又敬其父則子悅，位彌高者情理得申，道愈廣者納敬必普也。玄曰：「《禮》云三昭、三穆，與太祖為七，然則太祖必居廟之主也，昭穆皆自下之稱，則非逆數可知也。禮，太祖東向，左昭右穆。如晉室之廟，則宣帝在昭穆之列，不得在太祖之位。昭穆既錯，太祖無寄，失之遠矣。」玄曾祖以上名位不顯，故不欲序列，且以王莽九廟見譏于前史，遂以一廟矯之，郊廟齋二日而已。秘書監卞承之曰：「祭不及祖，知楚德之不長也。」又毀晉小廟以廣台榭。其庶母蒸嘗，靡有定所，忌日見賓客遊宴，唯至亡時一哭而已。期服之內，不廢音樂。玄出遊水門，飄風飛其儀蓋。夜，濤水入石頭，大桁流壞，殺人甚多。大風吹硃雀門樓，上層墜地。","source_position":{"kind":"wikitext_codepoint_positions","raw_path":"sources/jinshu/wikisource-2644703-raw.wikitext","raw_start":6796,"raw_end":7269,"character_positions":[6803,6804,6805,6806,6809,6810,6811,6817,6818,6819,6820,6823,6824,6825,6826,6827,6828,6829,6830,6831,6832,6833,6834,6835,6836,6837,6838,6839,6840,6841,6842,6843,6844,6845,6846,6847,6848,6849,6850,6851,6852,6853,6854,6855,6856,6857,6858,6859,6860,6861,6862,6863,6864,6865,6866,6867,6868,6869,6870,6871,6872,6873,6874,6875,6876,6877,6878,6879,6880,6881,6882,6883,6884,6885,6886,6887,6888,6889,6890,6891,6892,6893,6894,6895,6896,6897,6898,6899,6900,6901,6902,6903,