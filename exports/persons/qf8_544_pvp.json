rson","person_id":"u9s_w6j_8mc_AAF","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。"}],"chapter_id":"c-jinshu-099-huanxuan","book_id":"b-jinshu-099","work_id":"w-jinshu","source_id":"s-jinshu-099-huanxuan-ws2644703"},{"id":"c-songshu-060-xunbozi:p002","text":"伯子少好學，博覽經傳，而通率好為雜戲，遨遊閭里，故以此失清塗。解褐為駙馬都尉，奉朝請，員外散騎侍郎。著作郎徐廣重其才學，舉伯子及王韶之並為佐郎，助撰晉史及著桓玄等傳。遷尚書祠部郎。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-songshu-060-xunbozi:p002:m0000","start":0,"end":2,"surface":"伯子","kind":"person","person_id":"yoo_ox0_545_BABAAABAA","status":"contextual_provisional"},{"id":"c-songshu-060-xunbozi:p002:m0053","start":53,"end":55,"surface":"徐廣","kind":"person","person_id":"qf8_544_pvp","status":"contextual_provisional"},{"id":"c-songshu-060-xunbozi:p002:m0061","start":61,"end":63,"surface":"伯子","kind":"person","person_id":"yoo_ox0_545_BABAAABAA","status":"contextual_provisional"},{"id":"c-songshu-060-xunbozi:p002:m0064","start":64,"end":67,"surface":"王韶之","kind":"person","person_id":"yfa_tz5_3ge","status":"contextual_provisional"},{"id":"c-songshu-060-xunbozi:p002:m0078","start":78,"end":80,"surface":"桓玄","kind":"person","person_id":"u9s_w6j_8mc_AAF","status":"contextual_provisional"}],"source_position":{"first_line":93,"last_line":94,"revision_id":1996694,"editorial_excerpt_boundary":true},"chapter_id":"c-songshu-060-xunbozi","book_id":"b-songshu-060","work_id":"w-songshu","source_id":"s-songshu-060-xunbozi"}],"sources":[{"chapter_id":"c-jinshu-099-huanxuan","work_id":"w-jinshu","book_id":"b-jinshu-099","source_id":"s-jinshu-099-huanxuan-ws2644703","source":{"provider":"Wikisource","revision_id":2644703,"permalink":"https://zh.wikisource.org/w/index.php?title=晉書/卷099&oldid=2644703","edition":null,"image_verified":false,"qualification":"固定數位傳世文字見證；未親核底本或影像，校勘ref另層。","selected_raw_start":205,"selected_raw_end":10419,"extent":"完整選定傳記單元 huanxuan；非全書、非全卷","rights":"古代正文公版；維基文庫數位整理保留來源歸屬及CC BY-SA資格。","normalization":{"ch