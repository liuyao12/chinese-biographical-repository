,"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-057-wucan:line085","text":"吾粲字孔休，吳郡烏程人也。孫河為縣長，粲為小吏，河深奇之。河後為將軍，得自選長吏，表粲為曲阿丞，遷為長史，治有名跡。雖起孤微，與同郡陸遜、卜靜等比肩齊聲矣。孫權為車騎將軍，召為主簿，出為山陰令，還為參軍校尉。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-057-wucan:line085:m0001","start":1,"end":2,"surface":"粲","kind":"person","person_id":"pax_gtm_aew","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-wucan:line085:m0003","start":3,"end":5,"surface":"孔休","kind":"person","person_id":"pax_gtm_aew","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-wucan:line085:m0014","start":14,"end":15,"surface":"河","kind":"person","person_id":"07n_fwj_5jn","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-wucan:line085:m0019","start":19,"end":20,"surface":"粲","kind":"person","person_id":"pax_gtm_aew","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-wucan:line085:m0024","start":24,"end":25,"surface":"河","kind":"person","person_id":"07n_fwj_5jn","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-wucan:line085:m0029","start":29,"end":30,"surface":"河","kind":"person","person_id":"07n_fwj_5jn","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-wucan:line085:m0042","start":42,"end":43,"surface":"粲","kind":"person","person_id":"pax_gtm_aew","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-wucan:line085:m0066","start":66,"end":68,"surface":"陸遜","kind":"person","person_id":"lii_454_vuv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-wucan:line085:m0069","start":69,"end":71,"surface":"卜靜","kind":"person","person_id":"14x_ic4_ly3","status":"contextual_provisional","interpretat