ng","c-shiji-042-zheng"],"status":"contextual_provisional","confidence_level":"high","source_context_confidence":"high_contextual","surfaces":["惠王"],"identification_basis":{"kind":"source_context","target_mention_ids":["c-shiji-130-taishigong:m054-0054"]},"evidence":[{"chapter_id":"c-shiji-130-taishigong","paragraph_id":"c-shiji-130-taishigong:p054","quote":"桓公之東，太史是庸。及侵周禾，王人是議。祭仲要盟，鄭久不昌。子產之仁，紹世稱賢。三晉侵伐，鄭納於韓。嘉厲公納惠王，作鄭世家第十二。"},{"chapter_id":"c-shiji-042-zheng","paragraph_id":"c-shiji-042-zheng:p016","quote":"五年，燕、衞與周惠王弟穨伐王，王出奔温，立弟穨爲王。六年，惠王告急鄭，厲公發兵撃周王子穨，弗勝，於是與周惠王歸，王居于櫟。七年春，鄭厲公與虢叔襲殺王子穨而入惠王于周。"}],"prior_source_qualifications":[{"source_mention_ids":["c-shiji-130-taishigong:m054-0054"],"metadata":{"label":"惠王（周）（太史公自序候選）","status":"active","historicity":"historical_tradition"},"original_registry_record_sha256":"25973cbbc7f5a6de1a8e5176eb96ec0692f699cf188aae4b3d321a02c908b267","qualification":"合併前來源限定人物label/status/historicity逐值保留；非對現役人物資格的改寫。"}],"rationale":"子穨亂後鄭厲公助復周惠王；不接秦惠王、魏惠王。 僅辨同一來源人物，保原字、篇題引用、人名錨及頻次；不由此新增親屬或紀年。","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-042-zheng:p016","text":"五年，燕、衞與周惠王弟穨伐王，王出奔温，立弟穨爲王。六年，惠王告急鄭，厲公發兵撃周王子穨，弗勝，於是與周惠王歸，王居于櫟。七年春，鄭厲公與虢叔襲殺王子穨而入惠王于周。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-042-zheng:m016-0007","start":7,"end":10,"surface":"周惠王","kind":"person","person_id":"fq3_1ko_7tz","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m016-0010","start":10,"end":12,"surface":"弟穨","kind":"person","person_id":"4n3_9bj_cuq","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m016-0015","start":15,"end":18,"surface":"王出奔","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名、群體、泛稱或指代待核；不補姓名、成員或親屬關係。"},{"id":"c-shiji-042-zheng:m016-0021","start":21,"end":23,"surface":"弟穨","kind":"person","person_id":"4n3_9bj_cuq","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m016-0029","start":29,"end":31,"surface"