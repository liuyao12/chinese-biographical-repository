_holdings":[],"address_assertions":[],"person_references":[{"id":"c-songshu-048-maoxiu-son-and-marriage:p002:r0006","paragraph_id":"c-songshu-048-maoxiu-son-and-marriage:p002","start":6,"end":7,"surface":"女","person_id":"er7_nw6_n6w_B","referent_role":"third_person","quote":"先是，劉敬宣女嫁，高祖賜錢三百萬，雜綵千匹，時人並以為厚賜。","note":"依本段敘事、稱謂及語者受者定。","chapter_id":"c-songshu-048-maoxiu-son-and-marriage","book_id":"b-songshu-048","work_id":"w-songshu","source_id":"s-songshu-048-maoxiu-son-and-marriage-ws1791560"},{"id":"c-songshu-048-maoxiuzhi:p009:r0108","paragraph_id":"c-songshu-048-maoxiuzhi:p009","start":108,"end":109,"surface":"女","person_id":"er7_nw6_n6w_B","referent_role":"third_person","quote":"高祖將伐羌，先遣脩之復芍陂，起田數千頃。及至彭城，又使營立府舍，轉相國右司馬，將軍如故。時洛陽已平，即本號為河南、河內二郡太守，行司州事，戍洛陽，修治城壘。高祖既至，案行善之，賜衣服玩好，當時計直二千萬。先是，劉敬宣女嫁，高祖賜錢三百萬，雜綵千匹，時人並以為厚賜。王鎮惡死，脩之代為安西司馬，將軍如故。值桂陽公義真已發長安，為佛佛虜所邀，軍敗。脩之與義真相失，走將免矣。始登一岅，岅甚高峻，右衞軍人叛走，已上岅，嘗為脩之所罰者，以戟擲之，傷額，因墜岅，遂為佛佛所擒。佛佛死，其子赫連昌為索虜托跋燾所獲，脩之并沒。","note":"依本段敘事、稱謂及語者受者定。","chapter_id":"c-songshu-048-maoxiuzhi","book_id":"b-songshu-048","work_id":"w-songshu","source_id":"s-songshu-048-maoxiuzhi-ws1791560"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-songshu-048-maoxiu-son-and-marriage:p002","text":"先是，劉敬宣女嫁，高祖賜錢三百萬，雜綵千匹，時人並以為厚賜。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":62,"last_line":62,"raw_start":5246,"raw_end":5276,"raw_character_offsets":[5246,5247,5248,5249,5250,5251,5252,5253,5254,5255,5256,5257,5258,5259,5260,5261,5262,5263,5264,5265,5266,5267,5268,5269,5270,5271,5272,5273,5274,5275],"revision_id":1791560},"mentions":[{"id":"c-songshu-048-maoxiu-son-and-marriage:p002:m0003","start":3,"end":6,"surface":"劉敬宣","kind":"person","person_id":"er7_nw6_n6w","status":"contextual_provisional"}],"chapter_id":"c-songshu-048-maoxiu-son-and-marriage","book_id":"b-songshu-048","work_id":"w-son