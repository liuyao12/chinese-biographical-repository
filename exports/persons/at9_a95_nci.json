{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"at9_a95_nci","canonical_person_id":"at9_a95_nci","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["at9_a95_nci"],"persons":[{"id":"at9_a95_nci","label":"漁陽太守（匈奴列傳第31至32段）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"漁陽太守","mention_ids":["c-shiji-110-xiongnu:m031-0166"]}],"evidence":[{"mention_id":"c-shiji-110-xiongnu:m031-0166","chapter_id":"c-shiji-110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p031","quote":"漁陽太守"}]}],"source_mention_summary":[{"source_id":"s-shiji110-xiongnu","work_id":"w-shiji","book_id":"b-shiji-110","chapter_id":"c-shiji-110-xiongnu","mention_count":1,"mention_ids":["c-shiji-110-xiongnu:m031-0166"],"paragraph_ids":["c-shiji-110-xiongnu:p031"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji110-xiongnu"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-110-xiongnu:m031-0166","start":166,"end":170,"surface":"漁陽太守","kind":"person","person_id":"at9_a95_nci","status":"contextual_provisional","paragraph_id":"c-shiji-110-xiongnu:p031","chapter_id":"c-shiji-110-xiongnu"}],"relations":[],"title_holdings":[{"id":"th-shiji110-083","person_id":"at9_a95_nci","title":"漁陽太守","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-110-xiongnu","source_id":"s-shiji110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p031","quote":"自馬邑軍後五年之秋，漢使四將軍各萬騎擊胡關市下。將軍衛青出上谷，至蘢城，得胡首虜七百人。公孫賀出雲中，無所得。公孫敖出代郡，爲胡所敗七千餘人。李廣出鴈門，爲胡所敗，而匈奴生得廣，廣後得亡歸。漢囚敖、廣，敖、廣贖爲庶人。其冬，匈奴數入盜邊，漁陽尤甚。漢使將軍韓安國屯漁陽備胡。其明年秋，匈奴二萬騎入漢，殺遼西太守，略二千餘人。胡又入敗漁陽太守軍千餘人，圍漢將軍安國，安國時千餘騎亦且盡，會燕救至，匈奴乃去。匈奴又入鴈門，殺略千餘人。於是漢使將軍衛青將三萬騎出鴈門，李息出代郡，擊胡。得首虜數千人。其明年，衛青復出雲中以西至隴西，擊胡之樓煩、白羊王於河南，得胡首虜數千，牛羊百餘萬。於是漢遂取河南地，築朔方，復繕故秦時蒙恬所爲塞，因河爲固。漢亦棄上谷之什辟縣造陽地以予胡。是歳，漢之元朔二年也。"}],"attestations":[{"id":"th-shiji110-083:a001","paragraph_id":"c-shiji-110-xiongnu:p031","start":166,"end":170,"surface":"漁陽太守","person_mention_id":"c-shiji-110-xiongnu:m031-0166","usage":"narrative","date_expression":"其明年秋","normalized_date":{"era":"BCE","era_year":128,"year":-127,"year_numbering":"astronomical","precision":"year","status":"editorial_provisional","original_quote":"自馬邑軍後五年之秋，漢使四將軍各萬騎擊胡關市下。將軍衛青出上谷，至蘢城，得胡首虜七百人。公孫賀出雲中，無所得。公孫敖出代郡，爲胡所敗七千餘人。李廣出鴈門，爲胡所敗，而匈奴生得廣，廣後得亡歸。漢囚敖、廣，敖、廣贖爲庶人。其冬，匈奴數入盜邊，漁陽尤甚。漢使將軍韓安國屯漁陽備胡。其明年秋，匈奴二萬騎入漢，殺遼西太守，略二千餘人。胡又入敗漁陽太守軍千餘人，圍漢將軍安國，安國時千餘騎亦且盡，會燕救至，匈奴乃去。匈奴又入鴈門，殺略千餘人。於是漢使將軍衛青將三萬騎出鴈門，李息出代郡，擊胡。得首虜數千人。其明年，衛青復出雲中以西至隴西，擊胡之樓煩、白羊王於河南，得胡首虜數千，牛羊百餘萬。於是漢遂取河南地，築朔方，復繕故秦時蒙恬所爲塞，因河爲固。漢亦棄上谷之什辟縣造陽地以予胡。是歳，漢之元朔二年也。","evidence":[{"chapter_id":"c-shiji-110-xiongnu","source_id":"s-shiji110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p031","quote":"自馬邑軍後五年之秋，漢使四將軍各萬騎擊胡關市下。將軍衛青出上谷，至蘢城，得胡首虜七百人。公孫賀出雲中，無所得。公孫敖出代郡，爲胡所敗七千餘人。李廣出鴈門，爲胡所敗，而匈奴生得廣，廣後得亡歸。漢囚敖、廣，敖、廣贖爲庶人。其冬，匈奴數入盜邊，漁陽尤甚。漢使將軍韓安國屯漁陽備胡。其明年秋，匈奴二萬騎入漢，殺遼西太守，略二千餘人。胡又入敗漁陽太守軍千餘人，圍漢將軍安國，安國時千餘騎亦且盡，會燕救至，匈奴乃去。匈奴又入鴈門，殺略千餘人。於是漢使將軍衛青將三萬騎出鴈門，李息出代郡，擊胡。得首虜數千人。其明年，衛青復出雲中以西至隴西，擊胡之樓煩、白羊王於河南，得胡首虜數千，牛羊百餘萬。於是漢遂取河南地，築朔方，復繕故秦時蒙恬所爲塞，因河爲固。漢亦棄上谷之什辟縣造陽地以予胡。是歳，漢之元朔二年也。"}],"references":[{"title":"《資治通鑑》卷十八平行事件","url":"https://zh.wikisource.org/w/index.php?title=資治通鑑/卷018&oldid=1511465","quote":"秋，匈奴二萬騎入漢，殺遼西太守","scope":"received_parallel_event","image_verified":false},{"title":"《資治通鑑》卷十八數位編輯紀年標題","url":"https://zh.wikisource.org/w/index.php?title=資治通鑑/卷018&oldid=1511465","quote":"元朔元年（癸丑，公元前一二八年）","scope":"digital_editorial_regnal_year_equivalence_only","image_verified":false}],"rationale":"其明年秋承首場前129年，換前128年、天文年-127；與通鑑遼西太守被殺、圍韓安國及衛青李息出塞同事件相合。","reviewer":"Codex（A