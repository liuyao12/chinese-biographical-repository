nt":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"3處獨立位置，3個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"},{"source_id":"s-jinshu-054-lu-ji-ws2605147","work_id":"w-jinshu","book_id":"b-jinshu-054","chapter_id":"c-jinshu-054-lu-ji","raw_mention_count":1,"mention_ids":["c-jinshu-054-lu-ji:p030:m0071"],"paragraph_ids":["c-jinshu-054-lu-ji:p030"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-054-lu-ji:p030:m0071","mention_ids":["c-jinshu-054-lu-ji:p030:m0071"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-054-sun-zheng-ws2605147","s-sanguozhi-051-huan-shuwu"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-jinshu-054-sun-zheng:source_review1-0","kind":"source_review","person_id":"6k9_dku_2e4_AA","source_quote":"孫拯者，字顯世，吳都富春人也。能屬文，仕吳為黃門郎。孫皓世，侍臣多得罪，惟拯與顧榮以智全。吳平後，為涿令，有稱績。機既為孟玖等所誣收拯考掠，兩踝骨見，終不變辭。門生費慈、宰意二人詣獄明拯，拯譬遣之曰：「吾義不可誣枉知故，卿何宜復爾？」二人曰：「僕亦安得負君！」拯遂死獄中，而慈、意亦死。","reading":"孫拯字顯世、吳官及入晉為涿令。費慈、宰意訴冤及三人結局俱有原句。","note":"孫拯字顯世、吳官及入晉為涿令。費慈、宰意訴冤及三人結局俱有原句。","paragraph_id":"c-jinshu-054-sun-zheng:p001","start_codepoint":0,"end_codepoint":143,"human_reviewed":false,"chapter_id":"c-jinshu-054-sun-zheng","source_id":"s-jinshu-054-sun-zheng-ws2605147"},{"id":"c-sanguozhi-051-huan-shuwu:line056-pei02-02:reading-000-137","kind":"annotation_sentence","paragraph_id":"c-sanguozhi-051-huan-shuwu:line056-pei02-02","start_codepoint":0,"end_codepoint":137,"source_quote":"《文士传》曰：丞好学，有文章，作萤火赋行於世。为黄门侍郎，与顾荣俱为侍臣。归命世内侍多得罪尤，惟荣、丞独获全。常使二人记事，丞答顾问，乃下诏曰：“自今已后，用侍郎皆当如今宗室丞、顾荣畴也。”吴平赴洛，为范阳涿令，甚有称绩。永安中，陆机为成都王大都督，请丞为司马，与机俱被害。","person_id":"6k9_dku_2e4_AA","related_person_ids":["wtz_smr_dwz","05e_9bb_55a","69h_uhy_hta","e81_f09_000"],"reading":"文士傳敘吳黃門侍郎及與陸機遇害；晉書作孫拯，同字顯世，與顧榮、涿令等多重合證。永安中屬引書紀年。","chapter_id":"c-sanguozhi-051-huan-shuwu","source_id":"s-sanguozhi-051-huan-shuwu"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-wu051-huan-shuwu-6","subject_person_id":"6k9_dku_2e4_AA","object_person_id":"6k9_dku_2e4_A","predicate":"father","qualifiers":{"source_term":"慎子丞"},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-051","chapter_id":"c-sanguozhi-051-huan-shuwu","source_id":"s-sanguozhi-051-huan-shuwu","paragraph_id":"c-sanguozhi-051-huan-shuwu:line056-pei02-01","quote":"《吴书》曰：桓弟俊，字叔英，性度恢弘，才经文武，为定武中郎将，屯戍薄落，赤烏十三年卒。长子建袭爵，平虏将军。少子慎，镇南将军。慎子丞，字显世。","subject_person_mention_id":"c-sanguozhi-051-huan-shuwu:line056-pei02-01:m0065","object_person_mention_id":"c-sanguozhi-051-huan-shuwu:line056-pei02-01:m0056"}],"interpretation_note":"以此來源所述兩端為據。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[{"connection":"father","parent_person_id":"6k9_dku_2e4_A","generation_distance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-051","chapter_id":"c-sanguozhi-051-huan-shuwu","source_id":"s-sanguozhi-051-huan-shuwu","paragraph_id":"c-sanguozhi-051-huan-shuwu:line056-pei02-01","quote":"《吴书》曰：桓弟俊，字叔英，性度恢弘，才经文武，为定武中郎将，屯戍薄落，赤烏十三年卒。长子建袭爵，平虏将军。少子慎，镇南将军。慎子丞，字显世。","source_term":"慎子丞"}],"source_assertion_id":"a-wu051-huan-shuwu-6","interpretation_note":"本句所記父子；識別後綴不表示長幼。","reviewer":"Codex（AI 代理）