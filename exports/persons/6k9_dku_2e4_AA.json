-jinshu-054-lu-ji","book_id":"b-jinshu-054","work_id":"w-jinshu","source_id":"s-jinshu-054-lu-ji-ws2605147"},{"id":"c-jinshu-054-sun-zheng:p001","text":"孫拯者，字顯世，吳都富春人也。能屬文，仕吳為黃門郎。孫皓世，侍臣多得罪，惟拯與顧榮以智全。吳平後，為涿令，有稱績。機既為孟玖等所誣收拯考掠，兩踝骨見，終不變辭。門生費慈、宰意二人詣獄明拯，拯譬遣之曰：「吾義不可誣枉知故，卿何宜復爾？」二人曰：「僕亦安得負君！」拯遂死獄中，而慈、意亦死。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":75,"last_line":75,"raw_start":7678,"raw_end":7821,"raw_character_offsets":[7678,7679,7680,7681,7682,7683,7684,7685,7686,7687,7688,7689,7690,7691,7692,7693,7694,7695,7696,7697,7698,7699,7700,7701,7702,7703,7704,7705,7706,7707,7708,7709,7710,7711,7712,7713,7714,7715,7716,7717,7718,7719,7720,7721,7722,7723,7724,7725,7726,7727,7728,7729,7730,7731,7732,7733,7734,7735,7736,7737,7738,7739,7740,7741,7742,7743,7744,7745,7746,7747,7748,7749,7750,7751,7752,7753,7754,7755,7756,7757,7758,7759,7760,7761,7762,7763,7764,7765,7766,7767,7768,7769,7770,7771,7772,7773,7774,7775,7776,7777,7778,7779,7780,7781,7782,7783,7784,7785,7786,7787,7788,7789,7790,7791,7792,7793,7794,7795,7796,7797,7798,7799,7800,7801,7802,7803,7804,7805,7806,7807,7808,7809,7810,7811,7812,7813,7814,7815,7816,7817,7818,7819,7820],"revision_id":2605147},"mentions":[{"id":"c-jinshu-054-sun-zheng:p001:m0000","start":0,"end":2,"surface":"孫拯","kind":"person","person_id":"6k9_dku_2e4_AA","status":"contextual_provisional"},{"id":"c-jinshu-054-sun-zheng:p001:m0005","start":5,"end":7,"surface":"顯世","kind":"person","person_id":"6k9_dku_2e4_AA","status":"contextual_provisional"},{"id":"c-jinshu-054-sun-zheng:p001:m0026","start":26,"end":28,"surface":"孫皓","kind":"person","person_id":"05e_9bb_55a","status":"contextual_provisional"},{"id":"c-jinshu-054-sun-zheng:p001:m0037","start":37,"end":38,"surface":"拯","kind":"person","person_id":"6k9_dku_2e4_AA","status":"contextual_provisional"},{"id":"c-jinshu-054-sun-zheng:p001:m0039","start":39,"end":41,"surface":"顧榮","kind":"person","person_id":"wtz_smr_dwz","status":"contextual_provisional"},{"id":"