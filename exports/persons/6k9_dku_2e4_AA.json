attestations":[{"id":"t-wu051-t-wu051-huan-shuwu8:a","paragraph_id":"c-sanguozhi-051-huan-shuwu:line056-pei02-02","person_mention_id":"c-sanguozhi-051-huan-shuwu:line056-pei02-02:m0007","start":24,"end":28,"surface":"黄门侍郎","usage":"narrative","date_expression":null}],"human_reviewed":false,"reviewer":"Codex（AI 代理）","model":null},{"id":"t-wu051-t-wu051-huan-shuwu9","person_id":"6k9_dku_2e4_AA","kind":"office","title":"涿令","mode":"attestation","status":"source_attested","effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本句所載職官，任免時間未詳。","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-051","chapter_id":"c-sanguozhi-051-huan-shuwu","source_id":"s-sanguozhi-051-huan-shuwu","paragraph_id":"c-sanguozhi-051-huan-shuwu:line056-pei02-02","quote":"《文士传》曰：丞好学，有文章，作萤火赋行於世。为黄门侍郎，与顾荣俱为侍臣。归命世内侍多得罪尤，惟荣、丞独获全。常使二人记事，丞答顾问，乃下诏曰：“自今已后，用侍郎皆当如今宗室丞、顾荣畴也。”吴平赴洛，为范阳涿令，甚有称绩。永安中，陆机为成都王大都督，请丞为司马，与机俱被害。","person_mention_id":"c-sanguozhi-051-huan-shuwu:line056-pei02-02:m0007"}],"attestations":[{"id":"t-wu051-t-wu051-huan-shuwu9:a","paragraph_id":"c-sanguozhi-051-huan-shuwu:line056-pei02-02","person_mention_id":"c-sanguozhi-051-huan-shuwu:line056-pei02-02:m0007","start":103,"end":105,"surface":"涿令","usage":"narrative","date_expression":null}],"human_reviewed":false,"reviewer":"Codex（AI 代理）","model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-054-lu-ji:p030","text":"初，宦人孟玖弟超並為穎所嬖寵。超領萬人為小都督，未戰，縱兵大掠。機錄其主者。超將鐵騎百餘人，直入機麾下奪之，顧謂機曰：「貉奴能作督不！」機司馬孫拯勸機殺之，機不能用。超宣言於眾曰：「陸機將反。」又還書與玖言機持兩端，軍不速決。及戰，超不受機節度，輕兵獨進而沒。玖疑機殺之，遂譖機於穎，言其有異志。將軍王闡、郝昌、公師籓等皆玖所用，與牽秀等共證之。穎大怒，使秀密收機。其夕，機夢黑幰繞車，手決不開，天明而秀兵至。機釋戎服，著白帢，與秀相見，神色自若，謂秀曰：「自吳朝傾覆，吾兄弟宗族蒙國重恩，入侍帷幄，出剖符竹。成都命吾以重任，辭不獲已。今日受誅，豈非命也！」因與穎箋，詞甚淒惻。既而歎曰：「華亭鶴唳，豈可復聞乎！」遂遇害於軍中，時年四十三。二子蔚、夏亦同被害。機既死非其罪，士卒痛之，莫不流涕。是日昏霧晝合，大風折木，平地尺雪，議者以為陸氏之冤。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":70,"last_line":70,"raw_start":7131,"raw_end":7504,"raw_character_offsets":[7131,7132,7133,7134,7135,7136,7137,7138,7139,7140,7141,7142,7143,7144,7145,7146,7147,7148,7149,7150,7151,7152,7153,7154,7155,7156,7157,7158,7159,7160,7161,7162,7163,7164,7165,7166,7167,7168,7169,7170,7171,7172,7173,7174,7175,7176,7177,7178,7179,7180,7181,7182,7183,7184,7185,7186,7187,7188,7189,7190,7191,7192,7193,7194,7195,7196,7197,7198,7199,7200,7201,7202,7203,7204,7205,7206,7207,7208,7209,7210,7211,7212,7213,7214,7215,7216,7217,7218,7219,7220,7221,7222,7223,7224,7225,7226,7227,7228,7229,7230,7231,7232,7233,7234,7235,7236,7237,7238,7239,7240,7241,7242,7243,7244,7245,7246,7247,7248,7249,7250,7251,7252,7253,7254,7255,7256,7257,7258,7259,7260,7261,7262,7263,7264,7265,7266,7267,7268,7269,7270,7271,7272,7273,7274,7275,7276,7277,7278,7279,7280,7281,7282,7283,7284,7285,7286,7287,7288,7289,7290,7291,7292,7293,7294,7295,7296,7297,7298,7299,7300,7301,7302,7303,7304,7305,7306,7307,7308,7309,7310,7311,7312,7313,7314,7315,7316,7317,7318,7319,7320,7321,7322,7323,7324,7325,7326,7327,7328,7329,7330,7331,7332,7333,7334,7335,7336,7337,7338,7339,7340,7341,7342,7343,7344,7345,7346,7347,7348,7349,7350,7351,7352,7353,7354,7355,7356,7357,7358,7359,7360,7361,7362,7363,7364,7365,7366,7367,7368,7369,7370,7371,7372,7373,7374,7375,7376,7377,7378,7379,7380,7381,7382,7383,7384,7385,7386,7387,7388,7389,7390,7391,7392,7393,7394,7395,7396,7397,7398,7399,7400,7401,7402,7403,7404,7405,7406,7407,7408,7409,7410,7411,7412,7413,7414,7415,7416,7417,7418,7419,7420,7421,7422,7423,7424,7425,7426,7427,7428,7429,7430,7431,7432,7433,7434,7435,7436,7437,7438,7439,7440,7441,7442,7443,7444,7445,7446,7447,7448,7449,7450,7451,7452,7453,7454,7455,7456,7457,7458,7459,7460,7461,7462,7463,7464,7465,7466,7467,7468,7469,7470,7471,7472,7473,7474,7475,7476,7477,7478,7479,7480,7481,7482,7483,7484,7485,7486,7487,