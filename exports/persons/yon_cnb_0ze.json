plete:variant_review12-105","kind":"variant_review","person_id":"yon_cnb_0ze","source_quote":"兖州刺史孟次陽典籤","reading":"殿本、四庫作孟吹陽。南史阮佃夫傳註據宋書校孟次陽，並記字崇基。","note":"殿本、四庫作孟吹陽。南史阮佃夫傳註據宋書校孟次陽，並記字崇基。","paragraph_id":"c-nanqishu-056-attendants-complete:p012","start_codepoint":105,"end_codepoint":114,"human_reviewed":false,"chapter_id":"c-nanqishu-056-attendants-complete","source_id":"s-nanqishu-056-attendants-complete-ws1504717"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-056-attendants-complete:p012:m0109","start":109,"end":112,"surface":"孟次陽","kind":"person","person_id":"yon_cnb_0ze","status":"contextual_provisional","paragraph_id":"c-nanqishu-056-attendants-complete:p012","chapter_id":"c-nanqishu-056-attendants-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-056-attendants-complete:p012","text":"　　茹法亮，吳興武康人也。宋大明世，出身爲小史，歷齋幹扶。孝武末年，作酒法，鞭罰過度，校獵江右，選白衣左右百八十人，皆面首富室，從至南州，得鞭者過半。法亮憂懼，因緣啓出家得爲道人。明帝初，罷道，結事阮佃夫，用爲兖州刺史孟次陽典籤。累至太祖冠軍府行參軍。元徽初，除殿中將軍，爲晉熙王郢州典籤，除長兼殿中御史。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":42,"last_line":42,"raw_start":2623,"raw_end":2776,"raw_character_offsets":[2623,2624,2625,2626,2627,2628,2629,2630,2631,2632,2633,2634,2635,2636,2637,2638,2639,2640,2641,2642,2643,2644,2645,2646,2647,2648,2649,2650,2651,2652,2653,2654,2655,2656,2657,2658,2659,2660,2661,2662,2663,2664,2665,2666,2667,2668,2669,2670,2671,2672,2673,2674,2675,2676,2677,2678,2679,2680,2681,2682,2683,2684,2685,2686,2687,2688,2689,2690,2691,2692,2693,2694,2695,2696,2697,2698,2699,2700,2701,2702,2703,2704,2705,27