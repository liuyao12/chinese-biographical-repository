","regnal_year_crosses_ce_year_is_gregorian_projection":true},"assembled_identity":{"person_id":"fum_370_iq6_A","representative_source_person_id":"fum_370_iq6_A","source_person_ids":["fum_370_iq6_A"],"identity_equivalence_decision_ids":[],"parent_person_id":"fum_370_iq6","source_assertion_id":null,"parent_connection":{"type":"parent_between_consecutive_ancestors","interpretation_basis":"punctuated_biography_four_ancestor_office_sequence","chain_subject_person_id":"fum_370_iq6_AAAA","nearer_ancestor_assertion_id":"a-weishu058-yang-003","farther_ancestor_assertion_id":"a-weishu058-yang-004","status":"contextual_provisional","human_reviewed":false,"rationale":"收到同段以楊播為主體明列高祖結、曾祖珍、祖真、父懿，各有仕履節；按相鄰明世距暫接父邊，非來源明言新father，不補更遠弘農譜。太祖時歸國為帝紀時間，不是另一祖先。","references":[{"work_id":"w-weishu-weishou","book_id":"b-weishu-weishou-058","source_id":"s-weishu-weishou-058-yangbo-ws2087998","chapter_id":"c-weishu-weishou-058-yangbo-yangkan","paragraph_id":"c-weishu-weishou-058-yangbo-yangkan:p001","quote":"楊播，字延慶，自云恒農華陰人也。高祖結，仕慕容氏，卒於中山相。曾祖珍，太祖時歸國，卒於上谷太守。祖真，河內、清河二郡太守。父懿，延興末為廣平太守，有稱績。高祖南巡，吏人頌之，加寧遠將軍，賜帛三百匹。徵為選部給事中，有公平之譽。除安南將軍、洛州刺史，未之任而卒。贈以本官，加弘農公，諡曰簡。","subject_person_mention_id":"c-weishu-weishou-058-yangbo-yangkan:p001:m0000","object_person_mention_id":"c-weishu-weishou-058-yangbo-yangkan:p001:m0033","assertion_id":"a-weishu058-yang-003","scope":"同一傳主之四級明祖詞及各自仕履；相鄰父邊僅編者暫接，原祖/曾祖/高祖陳述不改。","url":"https://zh.wikisource.org/w/index.php?title=%E9%AD%8F%E6%9B%B8%2F%E5%8D%B758&oldid=2087998"},{"work_id":"w-weishu-weishou","book_id":"b-weishu-weishou-058","source_id":"s-weishu-weishou-058-yangbo-ws2087998","chapter_id":"c-weishu-weishou-058-yangbo-yangkan","paragraph_id":"c-weishu-weishou-058-yangbo-yangkan:p001","quote":"楊播，字延慶，自云恒農華陰人也。高祖結，仕慕容氏，卒於中山相。曾祖珍，太祖時歸國，卒於上谷太守。祖真，河內、清河二郡太守。父懿，延興末為廣平太守，有稱績。高祖南巡，吏人頌之，加寧遠將軍，賜帛三百匹。徵為選部給事中，有公平之譽。除安南將軍、洛州刺史，未之任而卒。贈以本官，加弘農公，諡曰簡。","subject_person_mention_id":"c-weishu-weishou-058-yangbo-yangkan:p001:m0000","object_person_mention_id":"c-weishu-weishou-058-yangbo-yangkan:p001:m0018","assertion_id":"a-weishu058-yang-004","scope":"同一傳主之四級明祖詞及各自仕履；相鄰父邊僅編者暫接，原祖/曾祖/高祖陳述不改。","url":"https://zh.wikisource.org/w/index.php?title=%E9%AD%8F%E6%9B%B8%2F%E5%8D%B758&oldid=2087998"}],"four_ancestor_frame":{"chapter_id":"c-weishu-weishou-058-yangbo-yangkan","paragraph_id":"c-weishu-weishou-058-yangbo-yangkan:p001","source_revision":2087998,"paragraph_sha256":"a7d7bb3524ecc680581fc887c14cb79fe24834c583089a9221efe7429db43bd8","head_mention_id":"c-weishu-weishou-058-yangbo-yangkan:p001:m0000","entries":[{"assertion_id":"a-weishu058-yang-004","role_anchor":{"start":16,"end":18,"surface":"高祖"},"name_mention_id":"c-weishu-weishou-058-yangbo-yangkan:p001:m0018","career_anchor":{"start":19,"end":31,"surface":"，仕慕容氏，卒於中山相。"}},{"assertion_id":"a-weishu058-yang-003","role_anchor":{"start":31,"end":33,"surface":"曾祖"},"name_mention_id":"c-weishu-weishou-058-yangbo-yangkan:p001:m0033","career_anchor":{"start":34,"end":48,"surface":"，太祖時歸國，卒於上谷太守。"}},{"assertion_id":"a-weishu058-yang-002","role_anchor":{"start":48,"end":49,"surface":"祖"},"name_mention_id":"c-weishu-weishou-058-yangbo-yangkan:p001:m0049","career_anchor":{"start":50,"end":61,"surface":"，河內、清河二郡太守。"}},{"assertion_id":"a-weishu058-yang-001","role_anchor":{"start":61,"end":62,"surface":"父"},"name_mention_id":"c-weishu-weishou-058-yangbo-yangkan:p001:m0062","career_anchor":{"start":63,"end":77,"surface":"，延興末為廣平太守，有稱績。"}}],"ruler_time_anchors":[{"person_mention_id":"c-weishu-weishou-058-yangbo-yangkan:p001:m0035","temporal_anchor":{"start":35,"end":40,"surface":"太祖時歸國"}}]}},"assembly_id":"family-hongnong-yang-jie-close","root_person_id":"fum_370_iq6","status":"contextual_provisional","human_reviewed":false},"assembled_children":[{"person_id":"fum_370_iq6_AA","representative_source_person_id":"fum_370_iq6_AA","source_person_ids":["fum_370_iq6_AA"],"identity_equivalence_decision_ids":[],"parent_person_id":"fum_370_iq6_A","source_assertion_id":null,"parent_connection":{"type":"parent_between_consecutiv