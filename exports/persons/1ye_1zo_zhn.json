ved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-044-zhengmo:line030:m0073","start":73,"end":76,"surface":"雋不疑","kind":"person","person_id":"1ye_1zo_zhn","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-044-zhengmo:line030","chapter_id":"c-jinshu-044-zhengmo"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-044-zhengmo:line030","text":"太康元年卒，時年六十八，諡曰成。尚書令衛瓘奏：「默才行名望，宜居論道，五升九卿，位未稱德，宜贈三司。」而後父楊駿先欲以女妻默子豫，默曰：「吾每讀《雋不疑傳》，常想其人。畏遠權貴，奕世所守。」遂辭之。駿深為恨。至此，駿議不同，遂不施行。默寬沖博愛，謙虛溫謹，不以才地矜物，事上以禮，遇下以和，雖僮豎廝養不加聲色，而猶有嫌怨，故士君子以為居世之難。子球。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-044-zhengmo:line030:m0019","start":19,"end":21,"surface":"衛瓘","kind":"person","person_id":"67b_2b2_4b8","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-zhengmo:line030:m0024","start":24,"end":25,"surface":"默","kind":"person","person_id":"x18_cng_88g","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-zhengmo:line030:m0054","start":54,"end":56,"surface":"楊駿","kind":"person","person_id":"603_131_11e","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-zhengmo:line030:m0061","start":61,"end":62,"surface":"默","kind":"person","person_id":"x18_cng_88g","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-zhengmo:line030:m0063","start":63,"end":64,"surface":"豫","kind":"person","person_id":"x18_cng_88g_B","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-zhengmo:line030:m0065","start":65,"end":66,"surface":"默","kind":"person","person_id":"x18_cng_88g","status":"contextual_provis