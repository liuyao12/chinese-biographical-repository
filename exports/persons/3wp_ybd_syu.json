。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":161,"last_line":161,"raw_start":16414,"raw_end":16695,"raw_character_offsets":[16416,16417,16418,16419,16420,16421,16469,16470,16471,16472,16473,16474,16475,16476,16477,16478,16479,16480,16481,16482,16483,16484,16485,16486,16487,16488,16489,16490,16491,16492,16493,16494,16495,16496,16497,16498,16499,16500,16501,16502,16503,16504,16505,16506,16507,16508,16509,16551,16552,16553,16554,16555,16556,16557,16558,16559,16560,16561,16562,16563,16564,16565,16566,16567,16568,16569,16570,16571,16572,16573,16574,16575,16576,16577,16578,16579,16580,16581,16582,16583,16584,16585,16586,16587,16588,16589,16590,16591,16592,16593,16594,16595,16596,16597,16598,16599,16600,16601,16602,16603,16604,16605,16606,16607,16608,16609,16610,16611,16612,16613,16614,16615,16616,16617,16618,16619,16620,16621,16622,16623,16624,16625,16626,16627,16628,16629,16630,16631,16632,16633,16634,16635,16636,16637,16638,16639,16640,16641,16642,16643,16644,16645,16646,16647,16648,16649,16650,16651,16652,16653,16654,16655,16656,16657,16658,16659,16660,16661,16662,16663,16664,16665,16666,16667,16668,16669,16670,16671,16672,16673,16674,16675,16676,16677,16678,16679,16680,16681,16682,16683,16684,16685,16686,16687,16688,16689,16690,16691,16692,16693,16694],"revision_id":2650517},"mentions":[{"id":"c-jinshu-059-prince-ying:p007:m0004","surface":"王浚","start":4,"end":6,"person_id":"9c1_ff0_1b5","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-ying:p007:m0014","surface":"騰","start":14,"end":15,"person_id":"59u_70h_y1y","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-ying:p007:m0016","surface":"穎","start":16,"end":17,"person_id":"x4m_ygm_1d3","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-ying:p007:m0023","surface":"和演","start":23,"end":25,"person_id":"d16_41a_2bd","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-p