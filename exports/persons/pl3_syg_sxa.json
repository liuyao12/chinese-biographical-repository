zi:m0161"],"paragraph_ids":["c-sanguozhi-013-jin044-huabiao:zi"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-sanguozhi-013-jin044-huabiao:zi:m0161","mention_ids":["c-sanguozhi-013-jin044-huabiao:zi:m0161"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-044-huabiao","s-sanguozhi-013-jin044-huabiao"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-044-huabiao:line077:m0233","start":233,"end":235,"surface":"王宏","kind":"person","person_id":"pl3_syg_sxa","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-044-huabiao:line077","chapter_id":"c-jinshu-044-huabiao"},{"id":"c-sanguozhi-013-jin044-huabiao:zi:m0161","start":161,"end":163,"surface":"王弘","kind":"person","person_id":"pl3_syg_sxa","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-sanguozhi-013-jin044-huabiao:zi","chapter_id":"c-sanguozhi-013-jin044-huabiao"}],"relations":[],"title_holdings":[{"id":"th-w044-huabiao-10","person_id":"pl3_syg_sxa","title":"司隸","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-044","chapter_id":"c-jinshu-044-huabiao","source_id":"s-jinshu-044-huabiao","paragraph_id":"c-jinshu-044-huabiao:line077","quote":"華表，字偉容，平原高唐人也，父歆，清德高行，為魏太尉。表年二十，拜散騎黃門郎，累遷侍中。正元初，石苞來朝，盛稱高貴鄉公，以為魏武更生。時聞者流汗沾背，表懼禍作，頻稱疾歸下舍，故免於大難。後遷尚書。五等建，封觀陽伯。坐供給喪事不整，免。泰始中，拜太子少傅，轉光祿勳。遷太常卿。數歲，以老病乞骸骨。詔曰：「表清貞履素，有老成之美，久幹王事，靜恭匪懈。而以疾固辭，章表懇至。今聽如所上，以為太中大夫，賜錢二十萬，床帳褥席祿賜與卿同，門施行馬。」表以苦節垂名，司徒李胤、司隸王宏等並歎美表清澹退靜，以為不可得貴賤而親疏也。咸寧元年八月卒，時年七十二，諡曰康，詔賜朝服。有六子：廙、岑、嶠、鑒、澹、簡。","person_mention_id":"c-jinshu-044-huabiao:line077:m0233"}],"attestations":[{"id":"th-w043-huabiao-10:a","paragraph_id":"c-jinshu-044-huabiao:line077","start":231,"end":233,"surface":"司隸","person_mention_id":"c-jinshu-044-huabiao:line077:m0233","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"th-w044-huabiao-sg5","person_id":"pl3_syg_sxa","title":"司隷","kind":"office","mode":"attestation","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-013","chapter_id":"c-sanguozhi-013-jin044-huabiao","source_id":"s-sanguozhi-013-jin044-huabiao","paragraph_id":"c-sanguozhi-013-jin044-huabiao:zi","quote":"歆有三子。表字偉容，年二十餘爲散騎侍郎。時同寮諸郎共平尚書事，年少，並兼厲鋒氣，要召名譽。尚書事至，或有不便，故遺漏不視，及傳書者去，即入深文論駮。惟表不然，事來有不便，輒與尚書共論盡其意，主者固執，不得已，然後共奏議。司空陳羣等以此稱之。仕晉，歷太子少傅、太常。稱疾致仕，拜光祿大夫。性清淡，常慮天下退理。司徒李胤、司隷王弘等常稱曰：「若此人者，不可得而貴，不可得而賤，不可得而親，不可得而踈。」中子博，歷三縣內史，治有名跡。少子周，黃門侍郎、常山太守，博學有文思。中年遇疾，終于家。","person_mention_id":"c-sanguozhi-013-jin044-huabiao:zi:m0161"}],"attestations":[{"id":"th-w043-huabiao-sg5:a","paragraph_id":"c-sanguozhi-013-jin044-huabiao:zi","start":159,"end":161,"surface":"司隷","person_mention_id":"c-sanguozhi-013-jin044-huabiao:zi:m0161","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-044-huabiao:line077","text":"華表，字偉容，平原高唐人也，父歆，清德高行，為魏太尉。表年二十，拜散騎黃門郎，累遷侍中。正元初，石苞來朝，盛稱高貴鄉公，以為魏武更生。時聞者流汗沾背，表懼禍作，頻稱疾歸下舍，故免於大難。後遷尚書。五等建，封觀陽伯。坐供給喪事不整，免。泰始中，拜太子少傅，轉光祿勳。遷太常卿。數歲，以老病乞骸骨。詔曰：「表清貞履素，有老成之美，久幹王事，靜恭匪懈。而以疾固辭，章表懇至。今聽如所上，以為太中大夫，賜錢二十萬，床帳褥席祿賜與卿同，門施行馬。」表以苦節垂名，司徒李胤、司隸王宏等並歎美表清澹退靜，以為不可得貴賤而親疏也。咸寧元年八月卒，時年七十二，諡曰康，詔賜朝服。有六子：廙、岑、嶠、鑒、澹、簡。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-044-huabiao:line077:m0000","start":0,"end":2,"surface":"華表","kind":"person","person_id":"7zi_5gs_mq2_A","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-huabiao:line077:m0004","start":4,"end":6,"surface":"偉容","kind":"person","person_id":"7zi_5gs_mq2_A","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-huabiao:line077:m0015","start":15,"end":16,"surface":"歆","kind":"person","person_id":"7zi_5gs_mq2","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-huabiao:line077:m0027","start":27,"end":28,"surface":"表","kind":"person","person_id":"7zi_5gs_mq2_A","status":"contextual_provisional","interpretation_note":"讀本段前後及對話，所指按此處記。"},{"id":"c-jinshu-044-huabiao:line077:m0048","start":48,"end":50,"surface":"石苞","kind":"person","person_id":"d39_856_53f","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-huabiao:line077:m0055","start":55,"end":59,"surface":"高貴鄉公","kind":"person","person_id":"d6b_ea7_928","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-huabiao:line077:m0062","start":62,"end":64,"surface":"魏武","kind":"person","pers