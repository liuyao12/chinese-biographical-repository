4-suncong-complete-ws2263487"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-064-suncong-complete:p011:m0006","surface":"孫耽","start":6,"end":8,"kind":"person","person_id":"umh_wtd_uba","status":"contextual_provisional","paragraph_id":"c-sanguozhi-064-suncong-complete:p011","chapter_id":"c-sanguozhi-064-suncong-complete"},{"id":"c-sanguozhi-064-suncong-complete:p015:m0011","surface":"耽","start":11,"end":12,"kind":"person","person_id":"umh_wtd_uba","status":"contextual_provisional","paragraph_id":"c-sanguozhi-064-suncong-complete:p015","chapter_id":"c-sanguozhi-064-suncong-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-064-suncong-complete:p011","text":"　　綝遣將軍孫耽送亮之國，徙尚於零陵，遷公主於豫章。綝意彌溢，侮慢民神，遂燒大橋頭伍子胥廟，又壞浮屠祠，斬道人。休既即位，稱草莽臣。詣闕上書曰：「臣伏自省，才非干國，因緣肺腑，位極人臣，傷錦敗駕，罪負彰露，尋愆惟闕，夙夜憂懼。臣聞天命棐諶，必就有德，是以幽、厲失度，閡宣中興，陛下聖德，纂承大統，宜得良輔；以協雍熙，雖堯之盛，猶求稷契之佐；以協明聖之德。古人有言：『陳力就列，不能者止。』臣雖自展竭，無益庶政，謹上印綬節鉞，退還田裡，以避賢路。」休引見慰喻。又下詔曰：「朕以不德，守藩於外，值茲際會，群公卿士，暨於朕躬，以奉宗廟。朕用撫然，若涉淵冰。大將軍忠計內發，扶危定傾，安康社稷，功勳赫然。昔漢孝宣踐阼，霍光尊顯，褒德賞功，古今之通義也。其以大將軍為丞相、荊州牧，食五縣。」恩為禦史大夫、衛將軍，據右將軍。皆縣侯。幹雜號將軍、亭侯。闓亦封亭侯。綝一門五侯，皆典禁兵，權傾人主，自吳國朝臣未嘗有也。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":89,"last