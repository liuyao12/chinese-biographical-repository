nd":"person","person_id":"j6b_h03_igz","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m019-0022","start":22,"end":24,"surface":"穆王","kind":"person","person_id":"0va_zus_2zt","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m019-0038","start":38,"end":41,"surface":"六、蓼","kind":"unresolved","person_id":null,"status":"unresolved","note":"皋陶後裔的國／群體稱，未補未見個人成員；後裔不作直接父子。"},{"id":"c-shiji-040-chu:m019-0042","start":42,"end":44,"surface":"皋陶","kind":"person","person_id":"p3l_pp3_n6i","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m019-0060","start":60,"end":63,"surface":"莊王侶","kind":"person","person_id":"q8m_d0c_kq3","status":"contextual_provisional"}],"chapter_id":"c-shiji-040-chu","book_id":"b-shiji-040","work_id":"w-shiji","source_id":"s-shiji-040-chu"},{"id":"c-shiji-040-chu:p097","text":"鬻熊之嗣，周封於楚。僻在荊蠻，蓽路藍縷。及通而霸，僭號曰武。文旣伐申，成亦赦許。子圉篡嫡，商臣殺父。天禍未悔，憑奸自怙。昭困奔亡，懷迫囚虜。頃襄、考烈，祚衰南土。","annotation_status":"named_mentions_first_pass","text_layer":"witness_appended_suoyin_zan","mentions":[{"id":"c-shiji-040-chu:m097-0000","start":0,"end":2,"surface":"鬻熊","kind":"person","person_id":"dhq_jrq_2tw","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m097-0021","start":21,"end":22,"surface":"通","kind":"person","person_id":"1l4_2pq_e7w","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m097-0028","start":28,"end":29,"surface":"武","kind":"person","person_id":"1l4_2pq_e7w","status":"contextual_provisional","note":"前次為未定短稱；本次依正文事件或明示王號暫接，仍待附載層版本與人工覆核。"},{"id":"c-shiji-040-chu:m097-0030","start":30,"end":31,"surface":"文","kind":"person","person_id":"1l4_2pq_e7w_A","status":"contextual_provisional","note":"前次為未定短稱；本次依正文事件或明示王號暫接，仍待附載層版本與人工覆核。"},{"id":"c-shiji-040-chu:m097-0035","start":35,"end":36,"surface":"成","kind":"person","person_id":"osu_yvw_bwr","status":"contextual_provisional","note":"前次為未定短稱；本次依正文事件或明示王號暫接，仍待附載層版本與人工覆核。"},{"id":"c-shiji-040-chu:m097-0040","start":40,"end":42,"surface":"子圉","kind":"unresolved","person_id":null,"status":"unresolv