{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"til_b2q_21t","canonical_person_id":"til_b2q_21t","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["til_b2q_21t"],"persons":[{"id":"til_b2q_21t","label":"李崇（孫吳中書郎）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"李祟","mention_ids":["c-sanguozhi-064-suncong-complete:p006:m0269"]}],"evidence":[{"mention_id":"c-sanguozhi-064-suncong-complete:p006:m0269","paragraph_id":"c-sanguozhi-064-suncong-complete:p006","chapter_id":"c-sanguozhi-064-suncong-complete","quote":"李祟"}],"review":"ai_provisional","identity_note":"李崇（孫吳中書郎），見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-sanguozhi-064-suncong-complete-ws2263487","work_id":"w-sanguozhi","book_id":"b-sanguozhi-064","chapter_id":"c-sanguozhi-064-suncong-complete","raw_mention_count":1,"mention_ids":["c-sanguozhi-064-suncong-complete:p006:m0269"],"paragraph_ids":["c-sanguozhi-064-suncong-complete:p006"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-sanguozhi-064-suncong-complete:p006:m0269","mention_ids":["c-sanguozhi-064-suncong-complete:p006:m0269"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-sanguozhi-064-suncong-complete-ws2263487"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-064-suncong-complete:p006:m0269","surface":"李祟","start":269,"end":271,"kind":"person","person_id":"til_b2q_21t","status":"contextual_provisional","paragraph_id":"c-sanguozhi-064-suncong-complete:p006","chapter_id":"c-sanguozhi-064-suncong-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-064-suncong-complete:p006","text":"　　綝以孫亮始親政事，多所難問，甚懼。還建業，稱疾不朝。築室幹朱雀橋南，使弟威遠將軍據入蒼龍宿衛，弟武衛將軍恩、偏將軍幹、長水校尉闓分屯諸營，欲以專朝自固。亮內嫌綝，乃推魯育見殺本末，責怒虎林督朱熊、熊弟外部督朱損不匡正孫峻，乃令丁奉殺熊於虎林，殺損於建業。綝入諫不從，亮遂與公主魯班、太常全尚、將軍劉承議誅綝。亮妃，綝從姊女也，以其謀告綝。綝率眾夜襲全尚，遣弟恩殺劉承於蒼龍門外，遂圍宮。使光祿勳盂宗告廟廢亮，召群司儀曰：「少帝荒病昏亂，不可以處大位，承宗廟，以告先帝廢之。諸君若有不同者，下異議。」皆震怖。曰：「唯將軍令。」綝遣中書郎李祟奪亮璽綬，以亮罪狀班告遠近。尚書桓彝不肯署名，綝怒殺之。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":84,"last_line":84,"raw_start":11354,"raw_end":12118,"raw_character_offsets":[11354,11355,11356,11357,11358,11359,11360,11361,11362,11363,11364,11365,11366,11367,11368,11369,11370,11371,11372,11373,11374,11375,11376,11377,11378,11379,11380,11381,11382,11383,11384,11385,11386,11387,11388,11389,11390,11391,11392,11393,11394,11395,11396,11397,11398,11399,11400,11401,11402,11403,11404,11405,11406,11407,11408,11409,11410,11411,11412,11413,11414,11415,11416,11417,11418,11419,11420,11421,11422,11423,11424,11425,11426,11427,11428,11429,11430,11431,11432,11433,11434,11435,11436,11437,11438,11439,11440,11441,11442,11443,11444,11445,11446,11447,11448,11449,11450,11451,11452,11453,11454,11455,11456,11457,11458,11459,11460,11461,11462,11463,11464,11465,11466,11467,11468,11469,11470,11471,11472,11473,11474,11475,11476,11477,11478,11479,11480,11481,11482,11483,11484,11485,1