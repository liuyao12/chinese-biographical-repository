line":186,"raw_projection_ref":"source-evidence/song044-wyd1739-xiehui/transcription-projection.json","raw_file_sha256":"8977928c0263cad8f1ab482fbae1e626c9c1f12bed1b45268adbe8f32f112fc2","unit_key":"body-pdf11","source_layer":"received_chapter","column_locations_ref":"source-evidence/song044-wyd1739-xiehui/image-column-locations.json"},"chapter_id":"c-songshu-044-wyd1739-xiehui","book_id":"b-songshu-044","work_id":"w-songshu","source_id":"s-songshu-044-wyd1739-xiehui"},{"id":"c-songshu-044-xiehui-digital:p020","text":"晦至江口，到彥之已到彭城洲。庾登之據巴陵，畏懦不敢進。會霖雨連日，參軍劉和之曰：「彼此共有雨耳，檀征北尋至，東軍方強，唯宜速戰。」登之恇怯，使小將陳祐作大囊，貯茅數千斛，縣於颿檣，云可以焚艦，用火宜須晴，以緩戰期。晦然之，遂停軍十五日。乃攻蕭欣於彭城洲，中兵參軍孔延秀率三千人進戰，甚力。欣於陳後擁楯自衞，又委軍還船，於是大敗。延秀又攻洲口柵陷之，彥之退保隱圻。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-songshu-044-xiehui-digital:p020:m0000","start":0,"end":1,"surface":"晦","person_id":"aa6_83c_juy_AAAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本句具名用字及語境聯繫現役人物。"},{"id":"c-songshu-044-xiehui-digital:p020:m0005","start":5,"end":8,"surface":"到彥之","person_id":"6bo_qfq_pl9","kind":"person","status":"contextual_provisional","interpretation_note":"依本句具名用字及語境聯繫現役人物。"},{"id":"c-songshu-044-xiehui-digital:p020:m0014","start":14,"end":17,"surface":"庾登之","person_id":"4qr_wrk_3vd_DDBA","kind":"person","status":"contextual_provisional","interpretation_note":"依本句具名用字及語境聯繫現役人物。"},{"id":"c-songshu-044-xiehui-digital:p020:m0035","start":35,"end":38,"surface":"劉和之","person_id":"j31_z62_7a0","kind":"person","status":"contextual_provisional","interpretation_note":"依本句具名用字及語境聯繫現役人物。"},{"id":"c-songshu-044-xiehui-digital:p020:m0065","start":65,"end":67,"surface":"登之","person_id":"4qr_wrk_3vd_DDBA","kind":"person","status":"contextual_provisional","interpretation_note":"依本句具名用字及語境聯繫現役人物。"},{"id":"c-songshu-044-xiehui-digital:p020:m0073","start":73,"end":75,"surface":"陳祐","person_id":"dw1_y88_9e8","kind":"person","status":"contextual_provisional","interpretation_note":"依本句具名用字及語境聯繫現