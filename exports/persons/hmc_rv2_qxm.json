t":429,"end":431,"surface":"私者","kind":"person","person_id":"dn5_zej_pi4","status":"contextual_provisional"},{"id":"c-shiji-069-su:m042-0434","start":434,"end":435,"surface":"妻","kind":"person","person_id":"b2q_ckr_hyx","status":"contextual_provisional"},{"id":"c-shiji-069-su:m042-0454","start":454,"end":456,"surface":"其夫","kind":"person","person_id":"5r6_g5i_kd4","status":"contextual_provisional"},{"id":"c-shiji-069-su:m042-0459","start":459,"end":460,"surface":"妻","kind":"person","person_id":"b2q_ckr_hyx","status":"contextual_provisional"},{"id":"c-shiji-069-su:m042-0461","start":461,"end":462,"surface":"妾","kind":"person","person_id":"ltn_go2_3eu","status":"contextual_provisional"},{"id":"c-shiji-069-su:m042-0468","start":468,"end":469,"surface":"妾","kind":"person","person_id":"ltn_go2_3eu","status":"contextual_provisional"},{"id":"c-shiji-069-su:m042-0480","start":480,"end":482,"surface":"主母","kind":"person","person_id":"b2q_ckr_hyx","status":"contextual_provisional"},{"id":"c-shiji-069-su:m042-0493","start":493,"end":495,"surface":"主父","kind":"person","person_id":"5r6_g5i_kd4","status":"contextual_provisional"},{"id":"c-shiji-069-su:m042-0506","start":506,"end":508,"surface":"主父","kind":"person","person_id":"5r6_g5i_kd4","status":"contextual_provisional"},{"id":"c-shiji-069-su:m042-0517","start":517,"end":518,"surface":"妾","kind":"person","person_id":"ltn_go2_3eu","status":"contextual_provisional"},{"id":"c-shiji-069-su:m042-0526","start":526,"end":528,"surface":"主父","kind":"person","person_id":"5r6_g5i_kd4","status":"contextual_provisional"},{"id":"c-shiji-069-su:m042-0531","start":531,"end":533,"surface":"主母","kind":"person","person_id":"b2q_ckr_hyx","status":"contextual_provisional"},{"id":"c-shiji-069-su:m042-0564","start":564,"end":566,"surface":"燕王","kind":"person","person_id":"49x_hsj_tmo","status":"contextual_provisional"},{"id":"c-shiji-069-su:m042-0569","start":569,"end":571,"surface":"先生","kind":"person","person_id":"98y_02x_z6o","status":"contextual_provisional"}],"chapter_id":"c-shiji-069-su","book_id":"b-shiji-069","work_id":"w-shiji","source_id":"s-shiji-069-su"},{"id":"c-shiji-069-su:p043","text":"易王母，文侯夫人也，與蘇秦私通。燕王知之，而事之加厚。蘇秦恐誅，乃說燕王曰：「臣居燕不能使燕重，而在齊則燕必重。」燕王曰：「唯先生之所為。」於是蘇秦詳為得罪於燕而亡走齊，齊宣王以為客卿。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m043-0000","start":0,"end":2,"surface":"易王","kind":"person","person_id":"49x_hsj_tmo","status":"contextual_provisional"},{"id":"c-shiji-069-su:m043-0002","start":2,"end":3,"surface":"母","kind":"person","person_id":"qcs_gl3_9g8","status":"contextual_provisional"},{"id":"c-shiji-069-su:m043-0004","start":4,"end":6,"surface":"文侯","kind":"person","person_id":"xs7_jo2_pjd","status":"contextual_provisional"},{"id":"c-shiji-069-su:m043-0006","start":6,"end":8,"surface":"夫人","kind":"person","person_id":"qcs_gl3_9g8","status":"contextual_provisional"},{"id":"c-shiji-069-su:m043-0011","start":11,"end":13,"surface":"蘇秦","kind":"person","person_id":"98y_02x_z6o","status":"contextual_provisional"},{"id":"c-shiji-069-su:m043-0016","start":16,"end":18,"surface":"燕王","kind":"person","person_id":"49x_hsj_tmo","status":"contextual_provisional"},{"id":"c-shiji-069-su:m043-0027","start":27,"end":29,"surface":"蘇秦","kind":"person","person_id":"98y_02x_z6o","status":"contextual_provisional"},{"id":"c-shiji-069-su:m043-0034","start":34,"end":36,"surface":"燕王","kind":"person","person_id":"49x_hsj_tmo","status":"contextual_provisional"},{"id":"c-shiji-069-su:m043-0057","start":57,"end":59,"surface":"燕王","kind":"person","person_id":"49x_hsj_tmo","status":"contextual_provisional"},{"id":"c-shiji-069-su:m043-0063","start":63,"end":65,"surface":"先生","kind":"person","person_id":"98y_02x_z6o","status":"contextual_provisional"},{"id":"c-shiji-069-su:m043-0072","start":72,"end":74,"surface":"蘇秦","kind":"person","person_id":"98y_02x_z6o","status":"contextual_provisional"},{"id":"c-shiji-069-su:m043-0085","start":85,"end":88,"surface":"齊宣王","kind":"person","person_id":"iqu_pas_2r5","status":"contextual_provisional"}],"chapter_id":"c-shiji-069-su","book_id":"b-shiji-069","work_id":"w-shiji","source_id":"s-shiji-069-su"},{"id":"c-shiji-069-su:p044","text":"齊宣王卒，湣王即位，說湣王厚葬以明孝，高宮室大苑囿以明得意，欲破敝齊而為燕。燕易王卒，燕噲立為王。其後齊大夫多與蘇秦爭寵者，而使人刺蘇秦，不死，殊而走。齊王使人求賊，不得。蘇秦且死，乃謂齊王曰：「臣即死，車裂臣以徇於市，曰『蘇秦為燕作亂於齊』，如此則臣之賊必得矣。」於是如其言，而殺蘇秦者果自出，齊王因而誅之。燕聞之曰：「甚矣，齊之為蘇生報仇也！」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m044-0000","start":0,"end":3,"surface":"齊宣王","kind":"person","person_id":"iqu_pas_2r5","status":"contextual_provisional"},{"id":"c-shiji-069-su:m044-0005","start":5,"end":7,"surface":"湣王","kind":"person","person_id":"6j7_udm_uq6","status":"contextual_provisional"},{"id":"c-shiji-069-su:m044-0011","start":11,"end":13,"surface":"湣王","kind":"person","person_id":"6j7_udm_uq6","status":"contextual_provisional"},{"id":"c-shiji-069-su:m044-0038","start":38,"end":41,"surface":"燕易王","kind":"person","person_id":"49x_hsj_tmo","status":"contextual_provisional"},{"id":"c-shiji-069-su:m044-0043","start":43,"end":45,"surface":"燕噲","kind":"person","person_id":"8tn_cxl_8ru","status":"contextual_provisional"},{"id":"c-shiji-069-su:m044-0051","start":51,"end":54,"surface":"齊大夫","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、氏族、未名者或未定指代，未補成員、姓名及世系。"},{"id":"c-shiji-069-su:m044-0056","start":56,"end":58,"surface":"蘇秦","kind":"person","person_id":"98y_02x_z6o","status":"contextual_provisional"},{"id":"c-shiji-069-su:m044-0063","start":63,"end":65,"surface":"使人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、氏族、未名者或未定指代，未補成員、姓名及世系。"},{"id":"c-shiji-069-su:m044-0066","start":66,"end":68,"surface":"蘇秦","kind":"person","person_id":"98y_02x_z6o","status":"contextual_provisional"},{"id":"c-shiji-069-su:m044-0076","start":76,"end":78,"surface":"齊王","kind":"person","person_id":"6j7_udm_uq6","status":"contextual_provisional"},{"id":"c-shiji-069-su:m044-00