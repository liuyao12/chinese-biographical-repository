rson","person_id":"di2_9rk_bvz","status":"contextual_provisional"},{"id":"c-nanqishu-057-northern-wei-complete:p043:m0144","start":144,"end":145,"surface":"憘","kind":"person","person_id":"rh4_4e1_hq7","status":"contextual_provisional"},{"id":"c-nanqishu-057-northern-wei-complete:p043:m0151","start":151,"end":152,"surface":"恪","kind":"person","person_id":"gm7_r2v_bmx","status":"contextual_provisional"},{"id":"c-nanqishu-057-northern-wei-complete:p043:m0153","start":153,"end":154,"surface":"憘","kind":"person","person_id":"rh4_4e1_hq7","status":"contextual_provisional"},{"id":"c-nanqishu-057-northern-wei-complete:p043:m0175","start":175,"end":176,"surface":"恪","kind":"person","person_id":"gm7_r2v_bmx","status":"contextual_provisional"},{"id":"c-nanqishu-057-northern-wei-complete:p043:m0213","start":213,"end":214,"surface":"憘","kind":"person","person_id":"rh4_4e1_hq7","status":"contextual_provisional"},{"id":"c-nanqishu-057-northern-wei-complete:p043:m0234","start":234,"end":236,"surface":"王肅","kind":"person","person_id":"l1w_swd_dj8","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-057-northern-wei-complete","book_id":"b-nanqishu-057","work_id":"w-nanqishu","source_id":"s-nanqishu-057-northern-wei-complete-ws1999801"},{"id":"c-weishu-weishou-058-yangjin:p002","text":"轉振威將軍，領監曹奏事令，又為直寢，遷太子步兵校尉。高祖南征，以津為都督征南府長史，至懸瓠，徵加直閤將軍。後從駕濟淮，司徒誕薨，高祖以津送柩還都。遷長水校尉，仍直閤。景明中，世宗遊於北邙，津時陪從，太尉、咸陽王禧謀反，世宗馳入華林。時直閤中有同禧謀，皆在從限。及禧平，帝顧謂朝臣曰：「直閤半為逆黨，非至忠者安能不預此謀？」因拜津左中郎將。遷驍騎將軍，仍直閤。","text_layer":"received_chapter","annotation_status":"in_progress","source_position":{"revision_id":2087998,"raw_start":10080,"raw_end":10259,"source_layer":"received_biography","raw_character_offsets":[10080,10081,10082,10083,10084,10085,10086,10087,10088,10089,10090,10091,10092,10093,10094,10095,10096,10097,10098,10099,10100,10101,10102,10103,10104,10105,10106,10107,10108,10109,10110,10111,10112,10113,10114,10115,10116,10117,10118,10119,10120,10121,10122,10123,10124,10125,10126,10127,10128,10129,10130,10131,10132,10