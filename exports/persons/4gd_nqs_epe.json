rce_reading_cases":[{"id":"c-nanqishu-059-western-polities-complete:source_review2-0","kind":"source_review","person_id":"4gd_nqs_epe","source_quote":"宋世其國相希利垔解星筭數術，通胡、漢語，常言南方當有姓名齊者，其人當興。昇明二年，太祖輔政，遣驍騎將軍王洪（軌）〔範〕使芮芮，剋期共伐魏虜。建元元年八月，芮芮主發三十萬騎南侵，去平城七百里，魏虜拒守不敢戰，芮芮主於燕然山下縱獵而歸。上初踐阼，不遑出師。","reading":"希利垔通星數與語言。昇明二年遣王洪範使，建元元年八月芮芮軍進退另有時次。","note":"希利垔通星數與語言。昇明二年遣王洪範使，建元元年八月芮芮軍進退另有時次。","paragraph_id":"c-nanqishu-059-western-polities-complete:p002","start_codepoint":0,"end_codepoint":126,"human_reviewed":false,"chapter_id":"c-nanqishu-059-western-polities-complete","source_id":"s-nanqishu-059-western-polities-complete-ws1748911"},{"id":"c-nanqishu-059-western-polities-complete:variant_review2-51","kind":"variant_review","person_id":"4gd_nqs_epe","source_quote":"王洪（軌）〔範〕","reading":"正文保留軌與範的校改形式。齊書另有王洪軌，臨淄、為太祖所親、使芮芮的王洪範依本段辨識。","note":"正文保留軌與範的校改形式。齊書另有王洪軌，臨淄、為太祖所親、使芮芮的王洪範依本段辨識。","paragraph_id":"c-nanqishu-059-western-polities-complete:p002","start_codepoint":51,"end_codepoint":59,"human_reviewed":false,"chapter_id":"c-nanqishu-059-western-polities-complete","source_id":"s-nanqishu-059-western-polities-complete-ws1748911"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-059-western-polities-complete:p002:m0005","start":5,"end":8,"surface":"希利垔","kind":"person","person_id":"4gd_nqs_epe","status":"contextual_provisional","paragraph_id":"c-nanqishu-059-western-polities-complete:p002","chapter_id":"c-nanqishu-059-western-polities-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-059-western-polities-complete:p002","text":"宋世其國相希利垔解星筭數術，通胡、漢語，常