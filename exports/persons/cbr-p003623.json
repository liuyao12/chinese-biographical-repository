10","c-shiji-059-wuzong:m033-0326","c-shiji-059-wuzong:m033-0345","c-shiji-059-wuzong:m034-0000"],"paragraph_ids":["c-shiji-059-wuzong:p032","c-shiji-059-wuzong:p033","c-shiji-059-wuzong:p034"],"passage_count":3}],"most_mentioned_source_ids":["s-shiji-059-wuzong"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji059-044","subject_person_id":"qsj_qnd_c34","predicate":"mother","object_person_id":"xix_lzk_s92","status":"source_attested","evidence":[{"chapter_id":"c-shiji-059-wuzong","source_id":"s-shiji-059-wuzong","paragraph_id":"c-shiji-059-wuzong:p033","quote":"初，憲王舜有所不愛姬生長男棁。棁以母無寵故，亦不得幸於王。王後修生太子勃。王內多，所幸姬生子平、子商，王后希得幸。及憲王病甚，諸幸姬常侍病，故王后亦以妒媢不常侍病，輒歸舍。醫進藥，太子勃不自嘗藥，又不宿留侍病。及王薨，王后、太子乃至。憲王雅不以長子棁為人數，及薨，又不分與財物。郎或說太子、王后，令諸子與長子棁共分財物，太子、王后不聽。太子代立，又不收恤棁。棁怨王后、太子。漢使者視憲王喪，棁自言憲王病時，王后、太子不侍，及薨，六日出舍，太子勃私姦，飲酒，博戲，擊筑，與女子載馳，環城過市，入牢視囚。天子遣大行騫驗王后及問王勃，請逮勃所與姦諸證左，王又匿之。吏求捕勃大急，使人致擊笞掠，擅出漢所疑囚者。有司請誅憲王後修及王勃。上以修素無行，使棁陷之罪，勃無良師傅，不忍誅。有司請廢王後修，徙王勃以家屬處房陵，上許之。"}],"qualifiers":{"source_term":"王後修生太子勃","historicity":"historical_tradition"},"interpretation_note":"依明示子、生、母與局部世系主語保存，不因繼位或太子稱本身補父子，不補未名成員及同父同母。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-059-wuzong:m032-0051","start":51,"end":54,"surface":"太子勃","kind":"person","person_id":"qsj_qnd_c34","status":"contextual_provisional","paragraph_id":"c-shiji-059-wuzong:p032","chapter_id":"c-shiji-059-wuzong"},{"id":"c-shiji-059-wuzong:m033-0033","start":33,"end":36,"surface":"太子勃","kind":"person","person_id":"qsj_qnd_c34","status":"contextual_provisional","paragraph_id":"c-shiji-059-wuzong:p033","chapter_id":"c-shiji-059-wuzong"},{"id":"c-shiji-059-wuzong