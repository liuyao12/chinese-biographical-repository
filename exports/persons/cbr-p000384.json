005-qin:m025-0215","start":215,"end":217,"surface":"丕鄭","kind":"person","person_id":"cbr-p000384","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m025-0218","start":218,"end":220,"surface":"丕豹","kind":"person","person_id":"cbr-p000387","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m025-0224","start":224,"end":226,"surface":"繆公","kind":"person","person_id":"cbr-p000253","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m025-0229","start":229,"end":231,"surface":"晉君","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、短稱或官稱指代待核；不補造姓名或自動合併。"},{"id":"c-shiji-005-qin:m025-0244","start":244,"end":246,"surface":"繆公","kind":"person","person_id":"cbr-p000253","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m025-0281","start":281,"end":282,"surface":"豹","kind":"person","person_id":"cbr-p000387","status":"contextual_provisional"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-039-jin:p038","text":"二十六年夏，齊桓公大會諸侯於葵丘。晉獻公病，行後，未至，逢周之宰孔。宰孔曰：「齊桓公益驕，不務德而務遠略，諸侯弗平。君弟毋會，毋如晉何。」獻公亦病，復還歸。病甚，乃謂荀息曰：「吾以奚齊爲後，年少，諸大臣不服，恐亂起，子能立之乎？」荀息曰：「能。」獻公曰：「何以爲驗？」對曰：「使死者復生，生者不慚，爲之驗。」於是遂屬奚齊於荀息。荀息爲相，主國政。秋九月，獻公卒。裏克、邳鄭欲内重耳，以三公子之徒作亂，謂荀息曰：「三怨將起，秦、晉輔之，子將何如？」荀息曰：「吾不可負先君言。」十月，裏克殺奚齊于喪次，獻公未葬也。荀息將死之，或曰不如立奚齊弟悼子而傅之，荀息立悼子而葬獻公。十一月，裏克弒悼子于朝，荀息死之。君子曰：「詩所謂『白珪之玷，猶可磨也，斯言之玷，不可爲也』，其荀息之謂乎！不負其言。」初，獻公將伐驪戎，卜曰「齒牙爲禍」。及破驪戎，獲驪姬，愛之，竟以亂晉。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m038-0006","start":6,"end":9,"surface":"齊桓公","kind":"person","person_id":"cbr-p000235","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m038-0017","start":17,"end":20,"surface":"晉獻公","kind":"person","person_id":"cbr-p000374","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m038-0029","start":29,"end":33,"surface":"周之宰孔","kind":"person","person_id":"cbr-p001727","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m038-0034","start":34,"end":36,"surface":"宰孔","kind":"person","person_id":"cbr-p001727","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m038-0039","start":39,"end":42,"surface":"齊桓公","kind":"person","person_id":"cbr-p000235","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m038-0069","start":69,"end":71,"surface":"獻公","kind":"person","person_id":"cbr-p000374","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m038-0083","start":83,"end":85,"surface":"荀息","kind":"person","person_id":"cbr-p000382","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m038-0090","start":90,"end":92,"surface":"奚齊","kind":"person","person_id":"cbr-p000380","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m038-0115","start":115,"end":117,"surface":"荀息","kind":"person","person_id":"cbr-p000382","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m038-0123","start":123,"end":125,"surface":"獻公","kind":"person","person_id":"cbr-p000374","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m038-0158","start":158,"end":160,"surface":"奚齊","kind":"person","person_id":"cbr-p000380","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m038-0161","start":161,"end":163,"surface":"荀息","kind":"person","person_id":"cbr-p000382","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m038-0164","start":164,"end":166,"surface":"荀息","kind":"person","person_id":"cbr-p000382","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m038-0177","start":177,"end":179,"surface":"獻公","kind":"person","person_id":"cbr-p000374","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m038-0181","start":181,"end":183,"surface":"裏克","kind":"person","person_id":"cbr-p000381","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m038-0184","start":184,"end":186,"surface":"邳鄭","kind":"person","person_id":"cbr-p000384","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m038-0192","start":192,"end":197,"surface":"三公子之徒","kind":"unresolved","person_id":null,"status":"unresolved","