atus":"source_attested","evidence":[{"chapter_id":"c-shiji-123-dayuan","source_id":"s-shiji123-dayuan","paragraph_id":"c-shiji-123-dayuan:p004","quote":"留歲餘，還，并南山，欲從羌中歸，復為匈奴所得。留歲餘，單于死，左谷蠡王攻其太子自立，國內亂，騫與胡妻及堂邑父俱亡歸漢。漢拜騫為太中大夫，堂邑父為奉使君。"}],"attestations":[{"id":"th-shiji123-005:a001","paragraph_id":"c-shiji-123-dayuan:p004","start":72,"end":75,"surface":"奉使君","person_mention_id":"c-shiji-123-dayuan:m004-0051","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-123-dayuan","source_id":"s-shiji123-dayuan","paragraph_id":"c-shiji-123-dayuan:p004","quote":"留歲餘，還，并南山，欲從羌中歸，復為匈奴所得。留歲餘，單于死，左谷蠡王攻其太子自立，國內亂，騫與胡妻及堂邑父俱亡歸漢。漢拜騫為太中大夫，堂邑父為奉使君。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"原文授任、繼位與用稱分存；未知起訖保持未知，不因死亡自動終止。從驃侯等原稱不默改。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-123-dayuan:p002","text":"張騫，漢中人。建元中為郎。是時天子問匈奴降者，皆言匈奴破月氏王，以其頭為飲器，月氏遁逃而常怨仇匈奴，無與共擊之。漢方欲事滅胡，聞此言，因欲通使。道必更匈奴中，乃募能使者。騫以郎應募，使月氏，與堂邑氏（故）胡奴甘父俱出隴西。經匈奴，匈奴得之，傳詣單于。單于留之，曰：「月氏在吾北，漢何以得往使？吾欲使越，漢肯聽我乎？」留騫十餘歲，與妻，有子，然騫持漢節不失。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-123-dayuan:m002-0000","start":0,"end":2,"surface":"張騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m002-0015","start":15,"end":17,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m002-0018","start":18,"end":22,"surface":"匈奴降者","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-123-dayuan:m002-0028","start":28,"end":31,"surface":"月氏王","kind":"person","person_id":"vgg_tso_418","status":"contextual_provisional"},{"