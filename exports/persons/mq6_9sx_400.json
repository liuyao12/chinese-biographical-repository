":"c-shiji-005-qin:p067","quote":"惠王卒，子武王立。韓、魏、齊、楚、越皆賓從。","chapter_id":"c-shiji-005-qin","source_id":"s-shiji-005-qin","source_term":"子"}],"source_assertion_id":"a-shiji005-070","interpretation_note":"以此受傳正文的明示近親主張配置局部家族；不合併跨篇候選身份、不補闕名世代，不表示遠祖世系已核實。分支字元不是長幼排行。","reviewer":"Codex（AI 代理）","parent_person_id":"y97_huh_vuz_AAAAAAAAAAAAABAAAAAA"}}],"source_mention_summary":[{"source_id":"s-shiji-005-qin","work_id":"w-shiji","book_id":"b-shiji-005","chapter_id":"c-shiji-005-qin","raw_mention_count":1,"mention_ids":["c-shiji-005-qin:m069-0044"],"paragraph_ids":["c-shiji-005-qin:p069"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-shiji-005-qin:m069-0044","mention_ids":["c-shiji-005-qin:m069-0044"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"},{"source_id":"s-shiji-072-rang","work_id":"w-shiji","book_id":"b-shiji-072","chapter_id":"c-shiji-072-rang","raw_mention_count":1,"mention_ids":["c-shiji-072-rang:m002-0053"],"paragraph_ids":["c-shiji-072-rang:p002"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-shiji-072-rang:m002-0053","mention_ids":["c-shiji-072-rang:m002-0053"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-shiji-005-qin","s-shiji-072-rang"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji072-003","subject_person_id":"y97_huh_vuz_AAAAAAAAAAAAABAAAAAAA","predicate":"mother","object_person_id":"mq6_9sx_400","status":"source_attested","evidence":[{"chapter_id":"c-shiji-072-rang","source_id":"s-shiji-072-rang","paragraph_id":"c-shiji-072-rang:p002","quote":"秦武王卒，無子，立其弟為昭王。昭王母故號為羋八子，及昭王即位，羋八子號為宣太后。宣太后非武王母。武王母號曰惠文后，先武王死。宣太后二弟：其異父長弟曰穰侯，姓魏氏，名冉；同父弟曰羋戎，為華陽君。而昭王同母弟曰高陵君、涇陽君。而魏冉最賢，自惠王、武王時任職用事。武王卒，諸弟爭立，唯魏冉力為能立昭王。昭王即位，以冉為將軍，衛咸陽。誅季君之亂，而逐武王后出之魏，昭王諸兄弟不善者皆滅之，威振秦國。昭王少，宣太后自治，任魏冉為政。"}],"qualifiers":{"source_term":"武王母號曰惠文后","historicity":"historical_tradition"},"interpretation_note":"依明示母與弟保存；異父長弟以宣太后為參照，同父弟亦以宣太后為參照；同母弟以昭王為參照。限定語不轉成未載父親名字或補造母系世次。原文宣太后非武王母保留作反證；兄弟不自動補父母，繼位不作父子。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-shiji005-094","person_id":"mq6_9sx_400","event_type":"death","status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-005-qin","source_id":"s-shiji-005-qin","paragraph_id":"c-shiji-005-qin:p069","quote":"昭襄王元年，嚴君疾為相。甘茂出之魏。二年，彗星見。庶長壯與大臣、諸侯、公子為逆，皆誅，及惠文后皆不得良死。悼武王后出歸魏。三年，王冠。與楚王會黃棘，與楚上庸。四年，取蒲阪。彗星見。五年，魏王來朝應亭，復與魏蒲阪。六年，蜀侯煇反，司馬錯定蜀。庶長奐伐楚，斬首二萬。涇陽君質於齊。日食，晝晦。七年，拔新城。摢裏子卒。八年，使將軍羋戎攻楚，取新市。齊使章子，魏使公孫喜，韓使暴鳶共攻楚方城，取唐眛。趙破中山，其君亡，竟死齊。魏公子勁、韓公子長為諸侯。九年，孟嘗君薛文來相秦。奐攻楚，取八城，殺其將景快。十年，楚懷王入朝秦，秦留之。薛文以金受免。樓緩為丞相。十一年，齊、韓、魏、趙、宋、中山五國共攻秦，至鹽氏而還。秦與韓、魏河北及封陵以和。彗星見。楚懷王走之趙，趙不受，還之秦，即死，歸葬。十二年，樓緩免，穰侯魏冉為相。予楚粟五萬石。","person_mention_id":"c-shiji-005-qin:m069-0044"}],"source_term":"皆不得良死","interpretation_note":"明言卒、死、誅或族誅保存；族孟說不增造未具名族人，惠文后不得良死按死亡敘述存，未指定方式。敗、虜、反不單獨推死亡。","reviewer":"Codex（AI 代理）","human_reviewed":false},{"id":"le-shiji072-002","person_id":"mq6_9sx_400","event_type":"death","status":"source_attested","date_expression":n