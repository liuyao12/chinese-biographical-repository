contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-105-bianque:m043-0032","start":32,"end":34,"surface":"文王","kind":"person","person_id":"7x0_k51_hpv","status":"contextual_provisional","paragraph_id":"c-shiji-105-bianque:p043","chapter_id":"c-shiji-105-bianque"},{"id":"c-shiji-105-bianque:m043-0078","start":78,"end":80,"surface":"文王","kind":"person","person_id":"7x0_k51_hpv","status":"contextual_provisional","paragraph_id":"c-shiji-105-bianque:p043","chapter_id":"c-shiji-105-bianque"},{"id":"c-shiji-105-bianque:m044-0006","start":6,"end":8,"surface":"文王","kind":"person","person_id":"7x0_k51_hpv","status":"contextual_provisional","paragraph_id":"c-shiji-105-bianque:p044","chapter_id":"c-shiji-105-bianque"},{"id":"c-shiji-105-bianque:m044-0026","start":26,"end":28,"surface":"文王","kind":"person","person_id":"7x0_k51_hpv","status":"contextual_provisional","paragraph_id":"c-shiji-105-bianque:p044","chapter_id":"c-shiji-105-bianque"},{"id":"c-shiji-105-bianque:m044-0033","start":33,"end":35,"surface":"文王","kind":"person","person_id":"7x0_k51_hpv","status":"contextual_provisional","paragraph_id":"c-shiji-105-bianque:p044","chapter_id":"c-shiji-105-bianque"},{"id":"c-shiji-105-bianque:m044-0128","start":128,"end":130,"surface":"文王","kind":"person","person_id":"7x0_k51_hpv","status":"contextual_provisional","paragraph_id":"c-shiji-105-bianque:p044","chapter_id":"c-shiji-105-bianque"}],"relations":[],"title_holdings":[{"id":"th-shiji105-030","person_id":"7x0_k51_hpv","title":"文王","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-105-bianque","source_id":"s-shiji-105-bianque","paragraph_id":"c-shiji-105-bianque:p043","quote":"問臣意：「意方能知病死生，論藥用所宜，諸侯王大臣有嘗問意者不？及文王病時，不求意診治，何故？」對曰：「趙王、膠西王、濟南王、吳王皆使人來召臣意，臣意不敢往。文王病時，臣意家貧，欲為人治病，誠恐吏以除拘臣意也，故移名數，左右不修家生，出行游國中，問善為方數者事之久矣，見事數師，悉受其要事，盡其方書意，及解論之。身居陽虛侯國，因事侯。侯入朝，臣意從之長安，以故得診安陵項處等病也。」"}],"attestations":[{"id":"th-shiji105-030:a001","paragraph_id":"c-shiji-105-bianque:p043","start":32,"end":34,"surface":"文王","person_mention_id":"c-shiji-105-bianque:m043-0032","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"依原文保存爵位、王號及身分用稱；齊王故為陽虛侯明示前後用稱，但未據此補起訖年或自行判定封爵終止事件。齊桓侯身分爭議與命婦、美人分類仍待覆核，不以官職中的侯字轉成封爵。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji105-064","person_id":"7x0_k51_hpv","surfaces":["文王"],"scope":"same_chapter","chapter_ids":["c-shiji-105-bianque"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-105-bianque:p043","quote":"問臣意：「意方能知病死生，論藥用所宜，諸侯王大臣有嘗問意者不？及文王病時，不求意診治，何故？」對曰：「趙王、膠西王、濟南王、吳王皆使人來召臣意，臣意不敢往。文王病時，臣意家貧，欲為人治病，誠恐吏以除拘臣意也，故移名數，左右不修家生，出行游國中，問善為方數者事之久矣，見事數師，悉受其要事，盡其方書意，及解論之。身居陽虛侯國，因事侯。侯入朝，臣意從之長安，以故得診安陵項處等病也。」"},{"paragraph_id":"c-shiji-105-bianque:p044","quote":"問臣意：「知文王所以得病不起之狀？」臣意對曰：「不見文王病，然竊聞文王病喘，頭痛，目不明。臣意心論之，以為非病也。以為肥而蓄精，身體不得搖，骨肉不相任，故喘，不當醫治。脈法曰『年二十脈氣當趨，年三十當疾步，年四十當安坐，年五十當安臥，年六十已上氣當大董』。文王年未滿二十，方脈氣之趨也而徐之，不應天道四時。後聞醫灸之即篤，此論病之過也。臣意論之，以為神氣爭而邪氣入，非年少所能復之也，以故死。所謂氣者，當調飲食，擇晏日，車步廣志，以適筋骨肉血脈，以瀉氣。故年二十，是謂『易眢』。法不當砭灸，砭灸至氣逐。」"}],"rationale":"依本篇姓名、原稱及敘事回指暫定；醫案引語與附載注釋分層，未按同名自動跨篇合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-105-bianque:p043","text":"問臣意：「意方能知病死生，論藥用所宜，諸侯王大臣有嘗問意者不？及文王病時，不求意診治，何故？」對曰：「趙王、膠西王、濟南王、吳王皆使人來召臣意，臣意不敢往。文王病時，臣意家貧，欲為人治病，誠恐吏以除拘臣意也，故移名數，左右不修家生，出行游國中，問善為方數者事之久矣，見事數師，悉受其要事，盡其方書意，及解論之。身居陽虛侯國，因事侯。侯入朝，臣意從之長安，以故得診安陵項處等病也。」","annotation_status":"named_mentions_first_pass","text_layer":"rece