{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000349","identity_policy":"contextual_provisional","person_ids":["cbr-p000349"],"persons":[{"id":"cbr-p000349","label":"秦寧公","status":"active","historicity":"historical_tradition","aliases":[{"surface":"寧公","mention_ids":["c-shiji-005-qin:m010-0219","c-shiji-005-qin:m011-0000","c-shiji-005-qin:m011-0058","c-shiji-005-qin:m011-0104"]}],"evidence":[{"mention_id":"c-shiji-005-qin:m010-0219","chapter_id":"c-shiji-005-qin","paragraph_id":"c-shiji-005-qin:p010","quote":"寧公"},{"mention_id":"c-shiji-005-qin:m011-0000","chapter_id":"c-shiji-005-qin","paragraph_id":"c-shiji-005-qin:p011","quote":"寧公"},{"mention_id":"c-shiji-005-qin:m011-0058","chapter_id":"c-shiji-005-qin","paragraph_id":"c-shiji-005-qin:p011","quote":"寧公"},{"mention_id":"c-shiji-005-qin:m011-0104","chapter_id":"c-shiji-005-qin","paragraph_id":"c-shiji-005-qin:p011","quote":"寧公"}],"identity_note":"依本卷特定時代與敘事暫定身份；稱號同字不跨時代合併，未見本名不補造。","review":"ai_provisional"}],"source_mention_summary":[{"source_id":"s-shiji-005-qin","work_id":"w-shiji","book_id":"b-shiji-005","chapter_id":"c-shiji-005-qin","mention_count":4,"mention_ids":["c-shiji-005-qin:m010-0219","c-shiji-005-qin:m011-0000","c-shiji-005-qin:m011-0058","c-shiji-005-qin:m011-0104"],"paragraph_ids":["c-shiji-005-qin:p010","c-shiji-005-qin:p011"],"passage_count":2}],"most_mentioned_source_ids":["s-shiji-005-qin"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-005-qin:m010-0219","start":219,"end":221,"surface":"寧公","kind":"person","person_id":"cbr-p000349","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p010","chapter_id":"c-shiji-005-qin"},{"id":"c-shiji-005-qin:m011-0000","start":0,"end":2,"surface":"寧公","kind":"person","person_id":"cbr-p000349","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p011","chapter_id":"c-shiji-005-qin"},{"id":"c-shiji-005-qin:m011-0058","start":58,"end":60,"surface":"寧公","kind":"person","person_id":"cbr-p000349","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p011","chapter_id":"c-shiji-005-qin"},{"id":"c-shiji-005-qin:m011-0104","start":104,"end":106,"surface":"寧公","kind":"person","person_id":"cbr-p000349","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p011","chapter_id":"c-shiji-005-qin"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-005-qin:p010","text":"文公元年，居西垂宮。三年，文公以兵七百人東獵。四年，至汧渭之會。曰：「昔周邑我先秦嬴於此，後卒獲為諸侯。」乃卜居之，占曰吉，即營邑之。十年，初為鄜畤，用三牢。十三年，初有史以紀事，民多化者。十六年，文公以兵伐戎，戎敗走。於是文公遂收周餘民有之，地至岐，岐以東獻之周。十九年，得陳寶。二十年，法初有三族之罪。二十七年，伐南山大梓，豐大特。四十八年，文公太子卒，賜謚為竫公。竫公之長子為太子，是文公孫也。五十年，文公卒，葬西山。竫公子立，是為寧公。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m010-0000","start":0,"end":2,"surface":"文公","kind":"person","person_id":"cbr-p000347","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m010-0013","start":13,"end":15,"surface":"文公","kind":"person","person_id":"cbr-p000347","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m010-0040","start":40,"end":42,"surface":"秦嬴","kind":"person","person_id":"cbr-p000334","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m010-0099","start":99,"end":101,"surface":"文公","kind":"person","person_id":"cbr-p000347","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m010-0112","start":112,"end":114,"surface":"文公","kind":"person","person_id":"cbr-p000347","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m010-0173","start":173,"end":175,"surface":"文公","kind":"person","person_id":"cbr-p000347","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m010-0182","start":182,"end":184,"surface":"竫公","kind":"person","person_id":"cbr-p000348","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m010-0185","start":185,"end":187,"surface":"竫公","kind":"person","person_id":"cbr-p000348","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m010-0195","start":195,"end":197,"surface":"文公","kind":"person","person_id":"cbr-p000347","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m010-0204","start":204,"end":206,"surface":"文公","kind":"person","person_id":"cbr-p000347","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m010-0212","start":212,"end":214,"surface":"竫公","kind":"person","person_id":"cbr-p000348","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m010-0219","start":219,"end":221,"surface":"寧公","kind":"person","person_id":"cbr-p000349","status":"contextual_provisional"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-005-qin:p011","text":"寧公二年，公徙居平陽。遣兵伐蕩社。三年，與亳戰，亳王奔戎，遂滅蕩社。四年，魯公子翚弒其君隱公。十二年，伐蕩氏，取之。寧公生十歲立，立十二年卒，葬西山。生子三人，長男武公為太子。武公弟德公，同母魯姬子。生出子。寧公卒，大庶長弗忌、威壘、三父廢太子而立出子為君。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m011-0000","start":0,"end":2,"surface":"寧公","kind":"person","person_id":"cbr-p000349","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m011-0024","start":24,"end":26,"surface":"亳王","kind":"person","person_id":"cbr-p000350","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m011-0037","start":37,"end":41,"surface":"魯公子翚","kind":"person","person_id":"cbr-p000351","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m011-0044","start":44,"end":46,"surface":"隱公","kind":"person","person_id":"cbr-p000225","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m011-0058","start":58,"end":60,"surface":"寧公","kind":"person","person_id":"cbr-p000349","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m011-0075","start":75,"end":79,"surface":"生子三人","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或未核定指代；未由熟知世系補造人物。"},{"id":"c-shiji-005-qin