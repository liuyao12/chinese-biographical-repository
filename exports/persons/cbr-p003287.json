3-xiao:m006-0016","start":16,"end":17,"surface":"上","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、官署或未定回指；不補姓名或後嗣成員。"},{"id":"c-shiji-053-xiao:m006-0022","start":22,"end":24,"surface":"丞相","kind":"person","person_id":"cbr-p003286","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m006-0025","start":25,"end":27,"surface":"鮑生","kind":"person","person_id":"cbr-p003291","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m006-0028","start":28,"end":30,"surface":"丞相","kind":"person","person_id":"cbr-p003286","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m006-0061","start":61,"end":65,"surface":"子孫昆弟","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、官署或未定回指；不補姓名或後嗣成員。"},{"id":"c-shiji-053-xiao:m006-0074","start":74,"end":75,"surface":"上","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、官署或未定回指；不補姓名或後嗣成員。"},{"id":"c-shiji-053-xiao:m006-0083","start":83,"end":84,"surface":"何","kind":"person","person_id":"cbr-p003286","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m006-0088","start":88,"end":90,"surface":"漢王","kind":"person","person_id":"cbr-p003287","status":"contextual_provisional"}],"chapter_id":"c-shiji-053-xiao","book_id":"b-shiji-053","work_id":"w-shiji","source_id":"s-shiji-053-xiao"},{"id":"c-shiji-053-xiao:p007","text":"漢五年，既殺項羽，定天下，論功行封。群臣爭功，歲餘功不決。高祖以蕭何功最盛，封為酇侯，所食邑多。功臣皆曰：「臣等身被堅執銳，多者百餘戰，少者數十合，攻城掠地，大小各有差。今蕭何未嘗有汗馬之勞，徒持文墨議論，不戰，顧反居臣等上，何也？」高帝曰：「諸君知獵乎？」曰：「知之。」「知獵狗乎？」曰：「知之。」高帝曰：「夫獵，追殺獸兔者狗也，而發蹤指示獸處者人也。今諸君徒能得走獸耳，功狗也。至如蕭何，發蹤指示，功人也。且諸君獨以身隨我，多者兩三人。今蕭何舉宗數十人皆隨我，功不可忘也。」群臣皆莫敢言。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-053-xiao:m007-0006","start":6,"end":8,"surface":"項羽","kind":"person","person_id":"cbr-p003289","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m007-0018","start":18,"end":20,"surface":"群臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、官署或未定回指；不補姓名或後嗣成員。"},{"id":"c-shiji-053-xiao:m007-0029","start":29,"end":31,"surface":"高祖","kind":"person","person_id":"cbr-p003287","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m007-0032","start":32,"end":34,"surface":"蕭何","kind":"person","person_id":"cbr-p003286","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m007-0048","start":48,"end":50,"surface":"功臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、官署或未定回指；不補姓名或後嗣成員。"},{"id":"c-shiji-053-xiao:m007-0086","start":86,"end":88,"surface":"蕭何","kind":"person","person_id":"cbr-p003286","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m007-0117","start":117,"end":119,"surface":"高帝","kind":"person","person_id":"cbr-p003287","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m007-0150","start":150,"end":152,"surface":"高帝","kind":"person","person_id":"cbr-p003287","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m007-0193","start":193,"end":195,"surface":"蕭何","kind":"person","person_id":"cbr-p003286","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m007-0221","start":221,"end":223,"surface":"蕭何","kind":"person","person_id":"cbr-p003286","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m007-0223","start":223,"end":228,"surface":"舉宗數十人","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、官署或未定回指；不補姓名或後嗣成員。"},{"id":"c-shiji-053-xiao:m007-0239","start":239,"end":241,"surface":"群臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、官署或未定回指；不補姓名或後嗣成員。"}],"chapter_id":"c-shiji-053-xiao","book_id":"b-shiji-053","work_id":"w-shiji","source_id":"s-shiji-053-xiao"},{"id":"c-shiji-053-xiao:p008","text":"列侯畢已受封，及奏位次，皆曰：「平陽侯曹參身被七十創，攻城掠地，功最多，宜第一。」上已橈功臣，多封蕭何，至位次未有以複難之，然心欲何第一。關內侯鄂君進曰：「群臣議皆誤。夫曹參雖有野戰略地之功，此特一時之事。夫上與楚相距五歲，常失軍亡眾，逃身遁者數矣。然蕭何常從關中遣軍補其處，非上所詔令召，而數萬眾會上之乏絕者數矣。夫漢與楚相守滎陽數年，軍無見糧，蕭何轉漕關中，給食不乏。陛下雖數亡山東，蕭何常全關中以待陛下，此萬世之功也。今雖亡曹參等百數，何缺於漢？漢得之不必待以全。奈何欲以一旦之功而加萬世之功哉！蕭何第一，曹參次之。」高祖曰：「善。」於是乃令蕭何，賜帶劍履上殿，入朝不趨。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-053-xiao:m008-0000","start":0,"end":2,"surface":"列侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、官署或未定回指；不補姓名或後嗣成員。"},{"id":"c-shiji-053-xiao:m008-0016","start":16,"end":21,"surface":"平陽侯曹參","kind":"person","person_id":"cbr-p003292","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m008-0041","start":41,"end":42,"surface":"上","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、官署或未定回指；不補姓名或後嗣成員。"},{"id":"c-shiji-053-xiao:m008-0049","start":49,"end":51,"surface":"蕭何","kind":"person","person_id":"cbr-p003286","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m008-0065","start":65,"end":66,"surface":"何","kind":"person","person_id":"cbr-p003286","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m008-0069","start":69,"end":74,"surface":"關內侯鄂君","kind":"person","person_id":"cbr-p003293","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m008-0078","start":78,"end":80,"surface":"群臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、官署或未定回指；不補姓名或後嗣成員。"},{"id":"c-shiji-053-xiao:m008-0085","start":85,"end":87,"surface":"曹參","kind":"person","person_id":"cbr-p003292","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m008-0104","start":104,"end":105,"surface":"上","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、官署或未定回指；不補姓名或後嗣成員。"},{"id":"c-shiji-053-xiao:m008-0126","start":126,"end":128,"surface":"蕭何","kind":"person","person_id":"cbr-p003286","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m008-0139","start":139,"end":140,"surface":"上","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、官署或未定回指；不補姓名或後嗣成員。"},{"id":"c-shiji-053-xiao:m008-0150","start":150,"end":151,"surface":"上","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、官署或未定回指；不補姓名或後嗣成員。"},{"id":"c-shiji-053-xiao:m008-0174","start":174,"end":176,"surface":"蕭何","kind":"person","person_id":"cbr-p003286","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m008-0194","start":194,"end":196,"surface":"蕭何","kind":"person","person_id":"cbr-p003286","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m008-0215","start":215,"end":217,"surface":"曹參","kind":"person","person_id":"cbr-p003292","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m008-0251","start":251,"end":253,"surface":"蕭何","kind":"person","person_id":"cbr-p003286","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m008-0256","start":256,"end":258,"surface":"曹參","kind":"person","person_id":"cbr-p003292","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m008-0262","start":262,"end":264,"surface":"高祖","kind":"person","person_id":"cbr-p003287","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m008-0274","start":274,"end":276,"surface":"蕭何","kind":"person","person_id":"cbr-p003286","status":"contextual_provisional"}],"chapter_id":"c-shiji-053-xiao","book_id":"b-shiji-053","work_id":"w-shiji","source_id":"s-shiji-053-xiao"},{"id":"c-shiji-053-xiao:p010","text":"漢十一年，陳豨反，高祖自將，至邯鄲。未罷，淮陰侯謀反關中，呂后用蕭何計，誅淮陰侯，語在淮陰事中。上已聞淮陰侯誅，使使拜丞相何為相國，益封五千戶，令卒五百人一都尉為相國衛。諸君皆賀，召平獨吊。召平者，故秦東陵侯。秦破，為布衣，貧，種瓜於長安城東，瓜美，故世俗謂之「東陵瓜」，從召平以為名也。召平謂相國曰：「禍自此始矣。上暴露於外而君守於中，非被矢石之事而益君封置衛者，以今者淮陰侯新反於中，疑君心矣。夫置衛衛君，非以寵君也。原君讓封勿受，悉以家私財佐軍，則上心說。」相國從其計，高帝乃大喜。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-053-xiao:m010-0005","start":5,"end":7,"surface":"陳豨","kind":"person","person_id":"cbr-p003294","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m010-0009","start":9,"end":11,"surface":"高祖","kind":"person","person_id":"cbr-p003287","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m010-0021","start":21,"end":24,"surface":"淮陰侯","kind":"person","person_id":"cbr-p003290","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m010-0029","start":29,"end":31,"surface":"呂后","kind"