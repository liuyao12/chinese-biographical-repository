on_id":"cbr-p003296","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m010-0095","start":95,"end":97,"surface":"召平","kind":"person","person_id":"cbr-p003296","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m010-0137","start":137,"end":139,"surface":"召平","kind":"person","person_id":"cbr-p003296","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m010-0144","start":144,"end":146,"surface":"召平","kind":"person","person_id":"cbr-p003296","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m010-0147","start":147,"end":149,"surface":"相國","kind":"person","person_id":"cbr-p003286","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m010-0158","start":158,"end":159,"surface":"上","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、官署或未定回指；不補姓名或後嗣成員。"},{"id":"c-shiji-053-xiao:m010-0186","start":186,"end":189,"surface":"淮陰侯","kind":"person","person_id":"cbr-p003290","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m010-0227","start":227,"end":228,"surface":"上","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、官署或未定回指；不補姓名或後嗣成員。"},{"id":"c-shiji-053-xiao:m010-0232","start":232,"end":234,"surface":"相國","kind":"person","person_id":"cbr-p003286","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m010-0238","start":238,"end":240,"surface":"高帝","kind":"person","person_id":"cbr-p003287","status":"contextual_provisional"}],"chapter_id":"c-shiji-053-xiao","book_id":"b-shiji-053","work_id":"w-shiji","source_id":"s-shiji-053-xiao"},{"id":"c-shiji-053-xiao:p012","text":"上罷布軍歸，民道遮行上書，言相國賤彊買民田宅數千萬。上至，相國謁。上笑曰：「夫相國乃利民！」民所上書皆以與相國，曰：「君自謝民。」相國因為民請曰：「長安地狹，上林中多空地，棄，原令民得入田，毋收槁為禽獸食。」上大怒曰：「相國多受賈人財物，乃為請吾苑！」乃下相國廷尉，械繫之。數日，王衛尉侍，前問曰：「相國何大罪，陛下系之暴也？」上曰：「吾聞李斯相秦皇帝，有善歸主，有惡自與。今相國多受賈豎金而為民請吾苑，以自媚於民，故系治之。」王衛尉曰：「夫職事苟有便於民而請之，真宰相事，陛下奈何乃疑相國受賈人錢乎！且陛下距楚數歲，陳豨、黥布反，陛下自將而往，當是時，相國守關中，搖足則關以西非陛下有也。相國不以此時為利，今乃利賈人之金乎？且秦以不聞其過亡天下，李斯之分過，又何足法哉。陛下何疑宰相之淺也。」高帝不懌。是日，使使持節赦出相國。相國年老，素恭謹，入，徒跣謝。高帝曰：「相國休矣！相國為民請苑，吾不許，我不過為桀紂主，而相國為賢相。吾故系相國，欲令百姓聞吾過也。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-053-xiao:m012-0000","start":0,"end":1,"surface":"上","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、官署或未定回指；不補姓名或後嗣成員。"},{"id":"c-shiji-053-xiao:m012-0002","start":2,"end":3,"surface":"布","kind":"person","person_id":"cbr-p003297","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m012-0006","start":6,"end":7,"surface":"民","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、官署或未定回指；不補姓名或後嗣成員。"},{"id":"c-shiji-053-xiao:m012-0014","start":14,"end":16,"surface":"相國","kind":"person","person_id":"cbr-p003286","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m012-0019","start":19,"end":20,"surface":"民","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、官署或未定回指；不補姓名或後嗣成員。"},{"id":"c-shiji-053-xiao:m012-0026","start":26,"end":27,"surface":"上","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、官署或未定回指；不補姓名或後嗣成員。"},{"id":"c-shiji-053-xiao:m012-0029","start":29,"end":31,"surface":"相國","kind":"person","person_id":"cbr-p003286","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m012-0033","start":33,"end":34,"surface":"上","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、官署或未定回指；不補姓名或後嗣成員。"},{"id":"c-shiji-053-xiao:m012-0039","start":39,"end":41,"surface":"相國","kind":"person","person_id":"cbr-p003286","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m012-0043","start":43,"end":44,"surface":"民","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、官署或未定回指；不補姓名或後嗣成員。"},{"id":"c-shiji-053-xiao:m012-0046","start":46,"end":47,"surface":"民","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、官署或未定回指；不補姓名或後嗣成員。"},{"id":"c-shiji-053-xiao:m012-0053","start":53,"end":55,"surface":"相國","kind":"person","person_id":"cbr-p003286","status":"contextual_provisional"},{"id":"c-shiji-053-xia