","source_position":{"first_line":64,"last_line":64,"revision_id":2086397,"raw_start":7913,"raw_end":7986,"character_positions":[7913,7914,7915,7916,7917,7918,7919,7920,7921,7922,7923,7924,7925,7926,7927,7928,7929,7930,7931,7932,7933,7934,7935,7936,7937,7938,7939,7940,7941,7942,7943,7944,7945,7946,7947,7948,7949,7950,7951,7952,7953,7954,7955,7956,7957,7958,7959,7960,7961,7962,7963,7964,7965,7966,7967,7968,7969,7970,7971,7972,7973,7974,7975,7976,7977,7978,7979,7980,7981,7982,7983,7984,7985]},"chapter_id":"c-sanguozhi-053-xueying","book_id":"b-sanguozhi-053","work_id":"w-sanguozhi","source_id":"s-sanguozhi-053-xueying"},{"id":"c-sanguozhi-058-lukang:line066","text":"時何定弄權，閹官預政。抗上疏曰：","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-058-lukang:line066:m0001","start":1,"end":3,"surface":"何定","kind":"person","person_id":"h6n_ozv_ytl","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-lukang:line066:m0011","start":11,"end":12,"surface":"抗","kind":"person","person_id":"40p_eb9_ggr","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"}],"annotation_status":"reviewed","source_position":{"first_line":66,"last_line":66,"revision_id":2131313,"raw_start":7289,"raw_end":7307,"character_positions":[7291,7292,7293,7294,7295,7296,7297,7298,7299,7300,7301,7302,7303,7304,7305,7306]},"chapter_id":"c-sanguozhi-058-lukang","book_id":"b-sanguozhi-058","work_id":"w-sanguozhi","source_id":"s-sanguozhi-058-lukang"},{"id":"c-sanguozhi-061-lukai:line040","text":"　　時殿上列將何定佞巧便辟，貴幸任事。凱面責定曰：“卿見前後事主不忠，傾亂國政，寧有得以壽終者邪！何以專為佞邪，穢塵天聽？宜自改厲。不然，方見卿有不測之禍矣。”定大恨凱，思中傷之，凱終不以為意，乃心公家，義形於色，表疏皆指事不飾，忠懇內發。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-061-lukai:line040:m0007","start":7,"end":9,"surface":"何定","kind":"person","person_id":"h6n_ozv_ytl","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line040:m0019","start":19,"end":20,"surface":"凱","kind":"person","person_id":"61q_ogq_ueq","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line040:m0022","start":22,"end":23,"surface":"定","kind":"person","person_id":"h6n_ozv_ytl","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line040:m0080","start":80,"end":81,"surface":"定","kind":"person","person_id":"h6n_ozv_ytl","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line040:m0083","start":83,"end":84,"surface":"凱","kind":"person","person_id":"61q_ogq_ueq","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line040:m0090","start":90,"end":91,"surface":"凱","kind":"person","person_id":"61q_ogq_ueq","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"}],"annotation_status":"reviewed","source_position":{"first_line":40,"last_line":40,"revision_id":2085162,"raw_start":3612,"raw_end":3732,"character_positions":[3612,3613,3614,3615,3616,3617,3618,3619,3620,3621,3622,3623,3624,3625,3626,3627,3628,3629,3630,3631,3632,3633,3634,3635,3636,3637,3638,3639,3640,3641,3642,3643,3644,3645,3646,3647,3648,3649,3650,3651,3652,3653,3654,3655,3656,3657,3658,3659,3660,3661,3662,3663,3664,3665,3666,3667,3668,3669,3670,3671,3672,3673,3674,3675,3676,3677,3678,3679,3680,3681,3682,3683,3684,3685,3686,3687,3688,3689,3690,3691,3692,3693,3694,3695,3696,3697,3698,3699,3700,3701,3702,3703,3704,3705,3706,3707,3708,3709,3710,3711,3712,3713,3714,3715,3716,3717,3718,3719,3720,3721,3722,3723,3724,3725,3726,3727,3728,3729,3730,3731]},"chapter_id":"c-sanguozhi-061-lukai","book_id":"b-sanguozhi-061","work_id":"w-sanguozhi","source_id":"s-sanguozhi-061-lukai"},{"id":"c-sanguozhi-061-lukai:line042","text":"　　建衡元年，疾病。皓遣中書令董朝問所欲言，凱陳：“何定不可任用，宣授外任，不宜委以國事。奚熙小吏，建起浦裡田，欲復嚴密故跡，亦不可聽。姚信、樓玄、賀劭、張悌、郭逴、薛瑩、滕脩及族弟喜，抗，或清白忠勤，或姿才卓茂，皆社稷之楨干，國家之良輔。願陛下重留神思，訪以時務，各盡其忠，拾遺萬一。”遂卒，時年七十二。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-061-lukai:line042:m0010","start":10,"end":11,"surface":"皓","kind":"person","person_id":"05e_9bb_55a","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line042:m0015","start":15,"end":17,"surface":"董朝","kind":"person","person_id":"hj9_ig8_998","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line042:m0022","start":22,"end":23,"surface":"凱","kind":"person","person_id":"61q_ogq_ueq","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line042:m0026","start":26,"end":28,"surface":"何定","kind":"person","person_id":"h6n_ozv_ytl","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line042:m0045","start":45,"end":47,"surface":"奚熙","kind":"person","person_id":"vjc_vgm_hc3","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line042:m0068","start":68,"end":70,"surface":"姚信","kind":"person","person_id":"evj_3wb_3l3","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line042:m0071","start":71,"end":73,"surface":"樓玄","kind":"person","person_id":"30b_08l_rxm","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line042:m0074","start":74,"end":76,"surface":"賀劭","kind":"person","person_id":"n40_190_783","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line042:m0077","start":77,"end":79,"surface":"張悌","kind":"person","person_id":"7f2_3a6_5c2","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line042:m0080","start":80,"end":82,"surface":"郭逴","kind":"person","person_id":"dcc_pzp_izk","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line042:m0083","start":83,"end":85,"surface":"薛瑩","kind":"p