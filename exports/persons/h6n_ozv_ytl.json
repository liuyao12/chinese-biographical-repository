d_chapter","mentions":[{"id":"c-sanguozhi-058-lukang:line066:m0001","start":1,"end":3,"surface":"何定","kind":"person","person_id":"h6n_ozv_ytl","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-lukang:line066:m0011","start":11,"end":12,"surface":"抗","kind":"person","person_id":"40p_eb9_ggr","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"}],"annotation_status":"reviewed","source_position":{"first_line":66,"last_line":66,"revision_id":2131313,"raw_start":7289,"raw_end":7307,"character_positions":[7291,7292,7293,7294,7295,7296,7297,7298,7299,7300,7301,7302,7303,7304,7305,7306]},"chapter_id":"c-sanguozhi-058-lukang","book_id":"b-sanguozhi-058","work_id":"w-sanguozhi","source_id":"s-sanguozhi-058-lukang"},{"id":"c-sanguozhi-061-lukai:line040","text":"　　時殿上列將何定佞巧便辟，貴幸任事。凱面責定曰：“卿見前後事主不忠，傾亂國政，寧有得以壽終者邪！何以專為佞邪，穢塵天聽？宜自改厲。不然，方見卿有不測之禍矣。”定大恨凱，思中傷之，凱終不以為意，乃心公家，義形於色，表疏皆指事不飾，忠懇內發。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-061-lukai:line040:m0007","start":7,"end":9,"surface":"何定","kind":"person","person_id":"h6n_ozv_ytl","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line040:m0019","start":19,"end":20,"surface":"凱","kind":"person","person_id":"61q_ogq_ueq","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line040:m0022","start":22,"end":23,"surface":"定","kind":"person","person_id":"h6n_ozv_ytl","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line040:m0080","start":80,"end":81,"surface":"定","kind":"person","person_id":"h6n_ozv_ytl","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line040:m0083","start":83,"end":84,"surface":"凱","kind":"person","person_id":"61q_ogq_ueq","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-lukai:line040:m0090","start":