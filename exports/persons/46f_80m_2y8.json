2"},{"work_id":"w-chenshu","book_id":"b-chenshu-007","source_id":"s-chenshu-007-zhangyaoer-ws2015446","chapter_id":"c-chenshu-007-zhangyaoer","paragraph_id":"c-chenshu-007-zhangyaoer:p001","quote":"女","mention_id":"c-chenshu-007-zhangyaoer:p001:m0134"}],"review":"ai_provisional","identity_note":"早卒，武帝後聘章要兒。","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"46f_80m_2y8","source_assertion_id":"a-nan012-zhangyaoer-m-qian-father","evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-012","source_id":"s-nanshi-012-zhangyaoer-ws2060595","chapter_id":"c-nanshi-012-zhangyaoer","paragraph_id":"c-nanshi-012-zhangyaoer:p001","quote":"陳武宣章皇后，諱要兒，吳興烏程人。本姓鈕，父景明為章氏所養，因改姓焉。后母蘇，嘗遇道士以小龜遺己，光采五色，曰：「三年有征」。及期，后生，紫光照室，因失龜所在。后少聰慧，美容儀，手爪長五寸，色並紅白。每有期功之服，則一爪先折。武帝先娶同郡錢仲方女，早卒，後乃聘后。后善書計，能誦詩及楚辭。帝為長城縣公，后拜夫人。永定元年，立為皇后。追贈后父梁散騎侍郎景明特進、金紫光祿大夫，加金章紫綬。拜后母蘇安吉縣君。二年，安吉君卒，與后父葬吳興。明年，追封后父為廣德縣侯，諡曰溫。","subject_person_mention_id":"c-nanshi-012-zhangyaoer:p001:m0122","object_person_mention_id":"c-nanshi-012-zhangyaoer:p001:m0119","relationship_anchor":{"paragraph_id":"c-nanshi-012-zhangyaoer:p001","surface":"錢仲方女","start":119,"end":123}}],"status":"contextual_provisional","interpretation_note":"高祖前妻是錢仲方女。","human_reviewed":false}}],"source_mention_summary":[{"source_id":"s-chenshu-007-wuying-consorts-1739","work_id":"w-chenshu","book_id":"b-chenshu-007","chapter_id":"c-chenshu-007-wuying-consorts","raw_mention_count":2,"mention_ids":["c-chenshu-007-wuying-consorts:p005:m0006","c-chenshu-007-wuying-consorts:p043:m0006"],"paragraph_ids":["c-chenshu-007-wuying-consorts:p005","c-chenshu-007-wuying-consorts:p043"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-chenshu-007-wuying-consorts:p005:m0006","mention_ids":["c-chenshu-007-wuying-consorts:p005:m0006"],"kind":"paragraph"},{"canonical_mention_id":"c-chenshu-007-wuying-consorts:p043:m0006","mention_ids":["c-chenshu-007-wuying-consorts:p043:m0006"],"kind":"paragraph"}],"mention_count":2,"duplicate_mention_count":0,"