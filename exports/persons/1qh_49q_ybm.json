d_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"id":"name-jin031-ner-chengju-literal","person_id":"1qh_49q_ybm","surname":"程","ming":"據","hao":null,"title":null,"additional_names":[],"chapter_id":"c-jinshu-031-jia-comparison","paragraph_id":"c-jinshu-031-jia-comparison:p005","person_mention_id":"c-jinshu-031-jia-comparison:p005:m0011","source_anchor":{"start":11,"end":13,"surface":"程據"},"quote":"后遂荒淫放恣，與太醫令程據等亂彰內外。洛南有盜尉部小吏，端麗美容止，既給冢役，忽有非常衣服，眾咸疑其竊盜，尉嫌而辯之。賈后疏親欲求盜物，往聽對辭。小吏云：「先行逢一老嫗，說家有疾病，師卜云宜得城南少年厭之，欲暫相煩，必有重報。於是隨去，上車下帷，內簏箱中，行可十餘里，過六七門限，開簏箱，忽見樓闕好屋。問此是何處，云是天上，即以香湯見浴，好衣美食將入。見一婦人，年可三十五六，短形青黑色，眉後有疵。見留數夕，共寢歡宴，臨出贈此眾物。」聽者聞其形狀，知是賈后，慚笑而去，尉亦解意。時他人入者多死，惟此小吏，以后愛之，得全而出。及河東公主有疾，師巫以為宜施寬令，乃稱詔大赦天下。","status":"editorial_provisional","human_reviewed":false,"model":null,"work_id":"w-jinshu","book_id":"b-jinshu-031","source_id":"s-jinshu031-jia-ws2479706-comparison"}],"mentions":[{"start":11,"end":13,"surface":"程據","id":"c-jinshu-031-jia-comparison:p005:m0011","kind":"person","person_id":"1qh_49q_ybm","status":"source_attested","paragraph_id":"c-jinshu-031-jia-comparison:p005","chapter_id":"c-jinshu-031-jia-comparison"}],"relations":[],"title_holdings":[{"id":"th-jin031-chengju","person_id":"1qh_49q_ybm","title":"太醫令","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-031","source_id":"s-jinshu031-jia-ws2479706-comparison","chapter_id":"c-jinshu-031-jia-comparison","paragraph_id":"c-jinshu-031-jia-comparison:p005","quote":"后遂荒淫放恣，與太醫令程據等亂彰內外。洛南有盜尉部小吏，端麗美容止，既給冢役，忽有非常衣服，眾咸疑其竊盜，尉嫌而辯之。賈后疏親欲求盜物，往聽對辭。小吏云：「先行逢一老嫗，說家有疾病，師卜云宜得城南少年厭之，欲暫相煩，必有重報。於是隨去，上車下帷，內簏箱中，行可十餘里，過六七門限，開簏箱，忽見樓闕好屋。問此是何處，云是天上，即以香湯見浴，好衣美食將入。見一婦人，年可三十五六，短形青黑色，眉後有疵。見留數夕，共寢歡宴，臨出贈此眾物。」聽者聞其形狀，知是賈后，慚笑而去，尉亦解意。時他人入者多死，惟此小吏，以后愛之，得全而出。及河東公主有疾，師巫以為宜施寬令，乃稱詔大赦天下。","pers