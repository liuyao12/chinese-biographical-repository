":[{"paragraph_id":"c-shiji-006-shihuang:p081","quote":"惠公享國十年。葬車里（康景）。生悼公。","chapter_id":"c-shiji-006-shihuang","source_id":"s-shiji-006-shihuang"}],"qualifiers":{"source_term":"生","historicity":"historical_tradition"},"interpretation_note":"保存卷末文本明示主張；若與本卷或前卷相反，仍分存，不推定此說較優或修改來源。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-005-qin:p044","text":"哀公八年，楚公子棄疾弒靈王而自立，是為平王。十一年，楚平王來求秦女為太子建妻。至國，女好而自娶之。十五年，楚平王欲誅建，建亡；伍子胥奔吳。晉公室卑而六卿彊，欲內相攻，是以久秦晉不相攻。三十一年，吳王闔閭與伍子胥伐楚，楚王亡奔隨，吳遂入郢。楚大夫申包胥來告急，七日不食，日夜哭泣。於是秦乃發五百乘救楚，敗吳師。吳師歸，楚昭王乃得復入郢。哀公立三十六年卒。太子夷公，夷公蚤死，不得立，立夷公子，是為惠公。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m044-0000","start":0,"end":2,"surface":"哀公","kind":"person","person_id":"cbr-p000420","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m044-0005","start":5,"end":10,"surface":"楚公子棄疾","kind":"person","person_id":"cbr-p000421","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m044-0011","start":11,"end":13,"surface":"靈王","kind":"person","person_id":"cbr-p000417","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m044-0019","start":19,"end":21,"surface":"平王","kind":"person","person_id":"cbr-p000421","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m044-0026","start":26,"end":29,"surface":"楚平王","kind":"person","person_id":"cbr-p000421","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m044-0031","start":31,"end":33,"surface":"秦女","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或待核指代；不由官稱或熟知世系補造個人。"},{"id":"c-shiji-005-qin:m044-0034","start":34,"end":37,"surface":"太子建","kind":"person","person_id":"cbr-p000422","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m044-0042","start":42,"end":43,"surface":"女","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或待核指代；不由官稱或熟知世系補造個人。"},{"id":"c-shiji-005-qin:m044-0053","start":53,"e