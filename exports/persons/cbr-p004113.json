on_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-070-zhang:m038-0030","start":30,"end":33,"surface":"齊湣王","kind":"person","person_id":"718_52s_bo3","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p038","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-070-zhang:m039-0038","start":38,"end":40,"surface":"大王","kind":"person","person_id":"718_52s_bo3","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p039","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-070-zhang:m039-0071","start":71,"end":72,"surface":"王","kind":"person","person_id":"718_52s_bo3","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p039","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-070-zhang:m039-0095","start":95,"end":97,"surface":"大王","kind":"person","person_id":"718_52s_bo3","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p039","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-070-zhang:m040-0000","start":0,"end":2,"surface":"齊王","kind":"person","person_id":"718_52s_bo3","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p040","chapter_id":"c-shiji-070-zhang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji070-030","person_id":"718_52s_bo3","scope":"same_chapter","chapter_ids":["c-shiji-070-zhang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"依第24至45段明示名字與遊說受話範圍暫接。韓王趙王及趙先王不按年代記憶補名；蘇秦謀齊的燕王齊王另存候選，不強與其他王同指或斷為異人。孟賁烏獲是比擬人物，不作在場者；紂為引古。擬議秦楚太子質子與秦女婚姻保留未解。","surfaces":["大王","王","齊湣王","齊王"],"evidence":[{"paragraph_id":"c-shiji-070-zhang:p038","quote":"韓王聽儀計。張儀歸報，秦惠王封儀五邑，號曰武信君。使張儀東說齊湣王曰：「天下彊國無過齊者，大臣父兄殷眾富樂。然而為大王計者，皆為一時之說，不顧百世之利。從人說大王者，必曰『齊西有彊趙，南有韓與梁。齊，負海之國也，地廣民眾，兵彊士勇，雖有百秦，將無柰齊何』。大王賢其說而不計其實。夫從人朋黨比周，莫不以從為可。臣聞之，齊與魯三戰而魯三勝，國以危亡隨其後，雖有戰勝之名，而有亡國之實。是何也？齊大而魯小也。今秦之與齊也，猶齊之與魯也。秦趙戰於河漳之上，再戰而趙再勝秦；戰於番吾之下，再戰又勝秦。四戰之後，趙之亡卒數十萬，邯鄲僅存，雖有戰勝之名而國已破矣。是何也？秦彊而趙弱。"},{"paragraph_id":"c-shiji-070-zhang:p039","quote":"「今秦楚嫁女娶婦，為昆弟之國。韓獻宜陽；梁效河外；趙入朝澠池，割河閒以事秦。大王不事秦，秦驅韓梁攻齊之南地，悉趙兵渡清河，指博關，臨菑、即墨非王之有也。國一日見攻，雖欲事秦，不可得也。是故願大王孰計之也。」"},{"paragraph_id":"c-shiji-070-zhang:p040","quote":"齊王曰：「齊僻陋，隱居東海之上，未嘗聞社稷之長利也。」乃許張儀。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-070-zhang:p038","text":"韓王聽儀計。張儀歸報，秦惠王封儀五邑，號曰武信君。使張儀東說齊湣王曰：「天下彊國無過齊者，大臣父兄殷眾富樂。然而為大王計者，皆為一時之說，不顧百世之利。從人說大王者，必曰『齊西有彊趙，南有韓與梁。齊，負海之國也，地廣民眾，兵彊士勇，雖有百秦，將無柰齊何』。大王賢其說而不計其實。夫從人朋黨比周，莫不以從為可。臣聞之，齊與魯三戰而魯三勝，國以危亡隨其後，雖有戰勝之名，而有亡國之實。是何也？齊大而魯小也。今秦之與齊也，猶齊之與魯也。秦趙戰於河漳之上，再戰而趙再勝秦；戰於番吾之下，再戰又勝秦。四戰之後，趙之亡卒數十萬，邯鄲僅存，雖有戰勝之名而國已破矣。是何也？秦彊而趙弱。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-070-zhang:m038-0000","start":0,"end":2,"surface":"韓王","kind":"person","person_id":"5mj_zds_atm","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m038-0003","start":3,"end":4,"surface":"儀","kind":"person","person_id":"5an_r55_hee","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m038-0006","start":6,"end":8,"surface":"張儀","kind":"person","person_id":"5an_r55_hee","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m038-0011","start":11,"end":14,"surface":"秦惠王","kind":"person","person_id":"x9j_eu1_vck","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m038-0015","start":15,"end":16,"surface":"儀","kind":"person","person_id":"5an_r55_hee","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m038-0026","start":26,"end":28,"surface":"張儀","kind":"person","person_id":"5an_r55_hee","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m038-0030","start":30,"end":33,"surface":"齊湣王","kind":"person","person_id":"718_52s_bo3","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m038-0045","start