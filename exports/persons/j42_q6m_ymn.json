3_bea","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfang:p002:m0008","surface":"方","start":8,"end":9,"person_id":"eti_fp9_fq5","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfang:p002:m0013","surface":"上官已","start":13,"end":16,"person_id":"j42_q6m_ymn","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfang:p002:m0017","surface":"苗願","start":17,"end":19,"person_id":"gid_c8t_usv","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfang:p002:m0028","surface":"清河王覃","start":28,"end":32,"person_id":"2tx_lqb_26u","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfang:p002:m0034","surface":"已","start":34,"end":35,"person_id":"j42_q6m_ymn","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfang:p002:m0036","surface":"願","start":36,"end":37,"person_id":"gid_c8t_usv","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfang:p002:m0038","surface":"已","start":38,"end":39,"person_id":"j42_q6m_ymn","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfang:p002:m0044","surface":"方","start":44,"end":45,"person_id":"eti_fp9_fq5","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfang:p002:m0050","surface":"覃","start":50,"end":51,"person_id":"2tx_lqb_26u","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfang:p002:m0056","surface":"方","start":56,"end":57,"person_id":"eti_fp9_fq5","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfang:p002:m0060","surface":"方","start":60,"end":61,"person_id":"eti_fp9_fq5","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfang:p002:m0072","surface":"皇后羊氏","start":72,"end":76,"person_id":"zyv_z7m_5o6","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfang:p002:m0084","surface":"方","start":84,"end":85,"person_id":"eti_fp9_fq5","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfang:p002:m0087","surface":"羆","start":87,"end":88,"person_id":"aa6_1w4_hbl","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfang:p002:m0100","surface":"方","start":100,"end":101,"person_id":"eti_fp9_fq5","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfang:p002:m0128","surface":"方","start":128,"end":129,"person_id":"eti_fp9_fq5","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfang:p002:m0151","surface":"方","start":151,"end":152,"person_id":"eti_fp9_fq5","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-060-zhangfang","book_id":"b-jinshu-060","work_id":"w-jinshu","source_id":"s-jinshu-060-zhangfang-ws2413335"},{"id":"c-jinshu-061-zhou-family:p021","text":"惠帝幸鄴，成都王穎以馥守河南尹。陳眕、上官已等奉清河王覃為太子，加馥衛將軍、錄尚書，馥辭不受。覃令馥與上官已合軍，馥認已小人縱暴，終為國賊，乃共司隸滿奮等謀共除之，謀泄，為已所襲，奮被害，馥走得免。及已為張方所敗，召馥還攝河南尹。暨東海王越迎大駕，以馥為中領軍，未就，遷司隸校尉，加散騎常侍、假節，都督諸軍事于澠池。帝還宮，出為平東將軍、都督揚州諸軍事，代劉准為鎮東將軍，與周玘等討陳敏，滅之，以功封永甯伯。","source_position":{"raw_start":3436,"raw_end":3642,"raw_text":"　　惠帝幸鄴，成都王穎以馥守河南尹。陳眕、上官已等奉清河王覃為太子，加馥衛將軍、錄尚書，馥辭不受。覃令馥與上官已合軍，馥認已小人縱暴，終為國賊，乃共司隸滿奮等謀共除之，謀泄，為已所襲，奮被害，馥走得免。及已為張方所敗，召馥還攝河南尹。暨東海王越迎大駕，以馥為中領軍，未就，遷司隸校尉，加散騎常侍、假節，都督諸軍事于澠池。帝還宮，出為平東將軍、都督揚州諸軍事，代劉准為鎮東將軍，與周玘等討陳敏，滅之，以功封永甯伯。","display_wrapper_start":0,"display_wrapper_end":0,"raw_path":"sources/jinshu/wikisource-7903772-raw.wikitext"},"mentions":[{"id":"c-jinshu-061-zhou-family:p021:m0000","start":0,"end":2,"surface":"惠帝","kind":"person","person_id":"7e0_f69_1ac","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p021:m0005","start":5,"end":9,"surface":"成都王穎","kind":"person","person_id":"e81_f09_000","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p021:m0010","start":10,"end":11,"surface":"馥","kind":"person","person_id":"3xx_gdy_or6_BA","status":"contextual_provisional","i