s":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin066-taokan-mother","subject_person_id":"twd_erg_kmz","object_person_id":"yc7_yxx_7te","predicate":"mother","qualifiers":{"source_term":"其母乃截髪得雙髲"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-066","chapter_id":"c-jinshu-066-taokan","source_id":"s-jinshu-066-taokan-ws1527632","paragraph_id":"c-jinshu-066-taokan:p001","quote":"陶侃，字士行，本鄱陽人也。吳平，徙家廬江之尋陽。父丹，吳揚武將軍。侃早孤貧，為縣吏。鄱陽孝廉範逵嘗過侃，時倉卒無以待賓，其母乃截髪得雙髲，以易酒肴，樂飲極歡，雖僕從亦過所望。及逵去，侃追送百餘里。逵曰：「卿欲仕郡乎？」侃曰：「欲之，困於無津耳。」逵過廬江太守張夔，稱美之。夔召為督郵，領樅陽令。有能名，遷主簿。會州部從事之郡，欲有所按，侃閉門部勒諸吏，謂從事曰：「若鄙郡有違，自當明憲直繩，不宜相逼。若不以禮，吾能禦之。」從事即退。夔妻有疾，將迎醫於數百里。時正寒雪，諸綱紀皆難之，侃獨曰：「資于事父以事君。小君，猶母也，安有父母之疾而不盡心乎！」乃請行。眾咸服其義。長沙太守萬嗣過廬江，見侃，虛心敬悅，曰：「君終當有大名。」命其子與之結友而去。","subject_person_mention_id":"c-jinshu-066-taokan:p001:m0000","object_person_mention_id":"c-jinshu-066-taokan:p001:m0061"}],"status":"source_attested","interpretation_note":"本段只稱其母；卷九十六與世說識鑒同記剪髮並具母姓湛。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-066-taokan:p001:m0061","surface":"母","start":61,"end":62,"person_id":"yc7_yxx_7te","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-066-taokan:p001","chapter_id":"c-jinshu-066-taokan"},{"id":"c-jinshu-066-taokan:p004:m0026","surface":"母","start":26,"end":27,"person_id":"yc7_yxx_7te","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-066-taokan:p004","chapter_id":"c-jinshu-066-taokan"},{"id":"c-jinshu-066-taokan:p004:m0230","surface":"母","start":230,"end":231,"person_id":"yc7_yxx_7te","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-066-taokan:p004","chapter_id":"c-jinshu-066-taokan"}],"relations":[{"id":"a-jin066-taokan-mother","subject_person_id":"twd_erg_kmz","object_person_id":"yc7_yxx_7te","predicate":"mother","q