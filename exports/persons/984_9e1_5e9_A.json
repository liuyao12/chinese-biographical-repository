on_id":"a-wu052-gt-ji","interpretation_note":"本來源明記世代。後綴只供識別。","reviewer":"Codex（AI 代理）","parent_person_id":"984_9e1_5e9"}}],"source_mention_summary":[{"source_id":"s-sanguozhi-052-gutan-complete","work_id":"w-sanguozhi","book_id":"b-sanguozhi-052","chapter_id":"c-sanguozhi-052-gutan-complete","raw_mention_count":3,"mention_ids":["c-sanguozhi-052-gutan-complete:line058:m0019","c-sanguozhi-052-gutan-complete:line058:m0025","c-sanguozhi-052-gutan-complete:line058:m0166"],"paragraph_ids":["c-sanguozhi-052-gutan-complete:line058"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-sanguozhi-052-gutan-complete:line058:m0019","mention_ids":["c-sanguozhi-052-gutan-complete:line058:m0019"],"kind":"paragraph"},{"canonical_mention_id":"c-sanguozhi-052-gutan-complete:line058:m0025","mention_ids":["c-sanguozhi-052-gutan-complete:line058:m0025"],"kind":"paragraph"},{"canonical_mention_id":"c-sanguozhi-052-gutan-complete:line058:m0166","mention_ids":["c-sanguozhi-052-gutan-complete:line058:m0166"],"kind":"paragraph"}],"mention_count":3,"duplicate_mention_count":0,"paragraph_occurrence_count":3,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"3處獨立位置，3個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"},{"source_id":"s-sanguozhi-058-luxun","work_id":"w-sanguozhi","book_id":"b-sanguozhi-058","chapter_id":"c-sanguozhi-058-luxun","raw_mention_count":2,"mention_ids":["c-sanguozhi-058-luxun:line055:m0082","c-sanguozhi-058-luxun:line055:m0112"],"paragraph_ids":["c-sanguozhi-058-luxun:line055"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-sanguozhi-058-luxun:line055:m0082","mention_ids":["c-sanguozhi-058-luxun:line055:m0082"],"kind":"paragraph"},{"canonical_mention_id":"c-sanguozhi-058-luxun:line055:m0112","mention_ids":["c-sanguozhi-058-luxun:line055:m0112"],"kind":"paragraph"}],"mention_count":2,"duplicate_mention_count":0,"paragraph_occurrence_count":2,"table_occurrence_cou