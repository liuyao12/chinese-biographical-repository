殺，上聞大怒，以為主父劫其王令自殺，乃徵下吏治。主父服受諸侯金，實不劫王令自殺。上欲勿誅，是時公孫弘為御史大夫，乃言曰：「齊王自殺無後，國除為郡，入漢，主父偃本首惡，陛下不誅主父偃，無以謝天下。」乃遂族主父偃。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-112-pingjin:m026-0000","start":0,"end":2,"surface":"主父","kind":"person","person_id":"vbr_ff1_yc4","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m026-0022","start":22,"end":24,"surface":"趙王","kind":"person","person_id":"40o_6pe_hvm","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m026-0039","start":39,"end":40,"surface":"偃","kind":"person","person_id":"vbr_ff1_yc4","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m026-0063","start":63,"end":66,"surface":"主父偃","kind":"person","person_id":"vbr_ff1_yc4","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m026-0084","start":84,"end":86,"surface":"齊王","kind":"person","person_id":"4lf_9lg_slx","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m026-0089","start":89,"end":90,"surface":"上","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m026-0096","start":96,"end":98,"surface":"主父","kind":"person","person_id":"vbr_ff1_yc4","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m026-0099","start":99,"end":101,"surface":"其王","kind":"person","person_id":"4lf_9lg_slx","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m026-0111","start":111,"end":113,"surface":"主父","kind":"person","person_id":"vbr_ff1_yc4","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m026-0127","start":127,"end":128,"surface":"上","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m026-0134","start":134,"end":137,"surface":"公孫弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m026-0148","start":148,"end":150,"surface":"齊王","kind":"person","person_id":"4lf_9lg_slx","status":"contextual_provisional"},{"id":"c-