orial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-074-huan-family:p006:m0040","start":40,"end":41,"surface":"母","kind":"person","person_id":"ywa_wg3_39c","status":"contextual_provisional","interpretation_note":"母稱不推生母，不併孔氏","paragraph_id":"c-jinshu-074-huan-family:p006","chapter_id":"c-jinshu-074-huan-family"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-074-huan-family:p006","text":"雲字雲子。初為驃騎何充參軍、尚書郎，不拜。襲爵萬寧男，歷位建武將軍、義成太守。遭母憂去職。葬畢，起為江州刺史，稱疾，廬於墓次。詔書敦逼，固辭不行，服闋，然後蒞職。加都督司豫二州軍事、領鎮蠻護軍、西陽太守、假節。雲招集眾力，志在足兵，多所枉濫，眾皆嗟怨。時溫執權，有司不敢彈劾。昇平四年卒，贈平南將軍，諡曰貞。子序嗣，官至宣城內史。","source_position":{"kind":"wikitext_codepoint_positions","raw_path":"sources/jinshu/wikisource-1536331-raw.wikitext","raw_start":1335,"raw_end":1565,"character_positions":[1337,1338,1339,1340,1341,1342,1343,1344,1345,1346,1347,1348,1349,1350,1351,1352,1353,1354,1355,1356,1357,1358,1359,1360,1361,1362,1363,1364,1365,1366,1367,1368,1369,1370,1371,1372,1373,1374,1431,1432,1433,1434,1435,1436,1437,1438,1439,1440,1441,1442,1443,1444,1445,1446,1447,1448,1449,1450,1451,1452,1453,1454,1455,1456,1457,1458,1459,1460,1461,1462,1463,1464,1465,1466,1467,1468,1469,1470,1471,1472,1473,1474,1475,1476,1477,1478,1479,1480,1481,1482,1483,1484,1485,1486,1487,1488,1489,1490,1491,1492,1493,1494,1495,1496,1497,1498,1499,1500,1501,1502,1503,1504,1505,1506,1507,1508,1509,1510,1511,1512,1513,1514,1515,1516,1517,1518,1519,1520,1521,1522,1523,1524,1525,1526,1527,1528,1529,1530,1536,1537,1538,1539,1542,1543,1544,1545,1546,1547,1548,1549,1550,1551,1552,1553,1554,1555,1556,1557,1558,1559,1560,1561,1562,1563,1564]},"mentions":[{"id":"c-jinshu-074-huan-family:p006:m0000","start":0,"end":1,"surface":"雲","kind":"person","person_id":"s9