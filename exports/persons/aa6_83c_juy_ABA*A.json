ok_id":"b-songshu-052","source_id":"s-songshu-052-xiechun-ws2190655","chapter_id":"c-songshu-052-xiechun","paragraph_id":"c-songshu-052-xiechun:p001","quote":"純","mention_id":"c-songshu-052-xiechun:p001:m0058"},{"work_id":"w-songshu","book_id":"b-songshu-052","source_id":"s-songshu-052-xiechun-ws2190655","chapter_id":"c-songshu-052-xiechun","paragraph_id":"c-songshu-052-xiechun:p001","quote":"純","mention_id":"c-songshu-052-xiechun:p001:m0084"},{"work_id":"w-songshu","book_id":"b-songshu-052","source_id":"s-songshu-052-xiechun-ws2190655","chapter_id":"c-songshu-052-xiechun","paragraph_id":"c-songshu-052-xiechun:p001","quote":"純","mention_id":"c-songshu-052-xiechun:p001:m0122"},{"work_id":"w-songshu","book_id":"b-songshu-052","source_id":"s-songshu-052-xiechun-ws2190655","chapter_id":"c-songshu-052-xiechun","paragraph_id":"c-songshu-052-xiechun:p001","quote":"純","mention_id":"c-songshu-052-xiechun:p001:m0132"},{"work_id":"w-songshu","book_id":"b-songshu-052","source_id":"s-songshu-052-xiechun-ws2190655","chapter_id":"c-songshu-052-xiechun","paragraph_id":"c-songshu-052-xiechun:p001","quote":"純","mention_id":"c-songshu-052-xiechun:p001:m0149"},{"work_id":"w-songshu","book_id":"b-songshu-052","source_id":"s-songshu-052-xiechun-ws2190655","chapter_id":"c-songshu-052-xiechun","paragraph_id":"c-songshu-052-xiechun:p001","quote":"景懋","mention_id":"c-songshu-052-xiechun:p001:m0005"}],"review":"ai_provisional","identity_note":"《南史》卷十九：字景懋、景仁弟，為劉毅衛軍長史、南平相，江陵兵敗遇害；固定《宋書》卷五十二同官、同字、同事。","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"aa6_83c_juy_AB","source_assertion_id":null,"parent_connection":{"type":"shared_father_through_siblings","sibling_assertion_ids":["a-nanshi019-chun-yu-younger"],"sibling_father_assertion_id":"a-nanshi019-yu-yun-father"},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-019","chapter_id":"c-nanshi-019-xiechun-xiehan","source_id":"s-nanshi-019-xiechun-xiehan-ws1531762","paragraph_id":"c-nanshi-019-xiechun-xiehan:p001","quote":"純字景懋，景仁弟也。劉毅鎮江陵，以爲衛軍長史、南平相。及王鎮惡襲毅，毅時病，佐史聞兵至，馳還入府，左右引車欲還外廨，純叱之曰：「我人吏也，逃欲安之。」及入，毅兵敗眾散，純爲人所殺。","subject_person_mention_id":"c-nanshi-019-xiechun-xiehan:p001:m0000","object_person_mention_id":"c-nanshi-019-xiechun-xiehan:p001:m0005","source_term":"景仁弟也","source_assertion_id":"a-nanshi019-chun-yu-younger"},{"work_id":"w-nanshi","book_id":"b-nanshi-019","chapter_id":"c-nanshi-019-xieyu-descendants","source_id":"s-nanshi-019-xieyu-descendants-ws1531762","paragraph_id":"c-nanshi-019-xieyu-descendants:p001","quote":"謝裕字景仁，朗弟允之子、而晦從父也。名與宋武帝諱同，故以字行。允字令度，位宣城內史。景仁幼爲從祖安所知，始爲前軍行參軍，會稽王世子元顯嬖人張法順權傾一時，內外無不造門，唯景仁不至，年三十而方爲著作佐郎。桓玄誅元顯，見景仁，謂四坐曰：「司馬庶人父子雲何不敗，遂令謝景仁三十而方佐著作郎。」玄建楚臺，以補黃門侍郎。及篡位，領驍騎將軍。","subject_person_mention_id":"c-nanshi-019-xieyu-descendants:p001:m0000","object_person_mention_id":"c-nanshi-019-xieyu-descendants:p001:m0008","source_term":"允之子","source_assertion_id":"a-nanshi019-yu-yun-father"}],"status":"contextual_provisional","human_reviewed":false,"interpretation_note":"具名兄弟句逐步連到其中一人的明父；父系為可撤回編輯組裝。"}},{"id":"aa6_83c_juy_ABA*A","label":"謝沈（謝純孫）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"沈","mention_ids":["c-songshu-052-xiechun:p001:m0151"]}],"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-052","source_id":"s-songshu-052-xiechun-ws2190655","chapter_id":"c-songshu-052-xiechun","paragraph_id":"c-songshu-052-xiechun:p001","quote":"沈","mention_id":"c-songshu-052-xiechun:p001:m0151"}],"review":"ai_provisional","identity_note":"《宋書》卷五十二明書純孫沈，宋明帝泰始初仕於巴陵王休若府。","family_path":{"connection":"grandfather","generation_distance":2,"ancestor_person_id":"aa6_83c_juy_ABA","intermediate_person_ids":[null],"source_assertion_id":"a-song052-xiechun-shen-grandfather","evidence":[{"work_id":"w-songshu","book_id":"b-songshu-052","source_id":"s-songshu-052-xiechun-ws2190655","chapter_id":"c-songshu-052-xiechun","paragraph_id":"c-songshu-052-xiechun:p001","quote":"景仁弟純字景懋，初為劉毅豫州別駕。毅鎮江陵，以為衞軍長史、南平相。王鎮惡率軍襲毅，已至城下，時毅疾病，佐吏皆入參承。純參承畢，已出，聞兵至，馳還入府。左右引車欲還外解，純叱之曰：「我人吏也，逃欲何之！」乃入。及毅兵敗眾散，時已暗夜，司馬毛脩之謂純曰：「君但隨僕。」純不從，扶兩人出，火光中為人所殺。純孫沈，太宗泰始初，為巴陵王休若衞軍錄事參軍、山陰令，坐事誅。","subject_person_mention_id":"c-songshu-052-xiechun:p001:m0151","object_person_mention_id":"c-songshu-052-xiechun:p001:m0149"}],"status":"contextual_provisional","interpretation_note":"謝沈是純之孫，上一代未具名。","human_reviewed":false}}],"source_mention_summary":[{"source_id":"s-songshu-052-xiechun-ws2190655","work_id":"w-songshu","book_id":"b-songshu-052","chapter_id":"c-songshu-052-xiechun","raw_mention_count":1,"mention_ids":["c-songshu-052-xiechun:p001:m0151"],"paragraph_ids":["c-songshu-052-xiechun:p001"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-songshu-052-xiechun:p001:m0151","mention_ids":["c-songshu-052-xiechun:p001:m0151"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-songshu-052-xiechun-ws2190655"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-song052-xiechun-shen-grandfather","subject_person_id":"aa6_83c_juy_ABA*A","object_person_id":"aa6_83c_juy_ABA","predicate":"grandfather","qualifiers":{"source_term":"純孫沈","song052_xiechun_reading":"shen-grandfather","lineage":"paternal"},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-052","source_id":"s-songshu-052-xiechun-ws2190655","chapter_id":"c-songshu-052-xiechun","paragraph_id":"c-songshu-052-xiechun:p001","quote":"景仁弟純字景懋，初為劉毅豫州別駕。毅鎮江陵，以為衞軍長史、南平相。王鎮惡率軍襲毅，已至城下，時毅疾病，佐吏皆入參承。純參承畢，已出，聞兵至，馳還入府。左右引車欲還外解，純叱之曰：「我人吏也，逃欲何之！」乃入。及毅兵敗眾散，時已暗夜，司馬毛脩之謂純曰：「君但隨僕。」純不從，扶兩人出，火光中為人所殺。純孫沈，太宗泰始初，為巴陵王休若衞軍錄事參軍、山陰令，坐事誅。","subject_person_mention_id":"c-songshu-052-xiechun:p001:m0151","object_person_mention_id":"c-songshu-052-xiechun:p001:m0149"}],"status":"source_attested","interpretation_note":"謝沈是純之孫，上一代未具名。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[{"connection":"grandfather","generation_distance":2,"ancestor_person_id":"aa6_83c_juy_ABA","intermediate_person_ids":[null],"source_assertion_id":"a-song052-xiechun-shen-grandfather","evidence":[{"work_id":"w-songshu","book_id":"b-songshu-052","source_id":"s-songshu-052-xiechun-ws2190655","chapter_id":"c-songshu-052-xiechun","paragraph_id":"c-songshu-052-xiechun:p001","quote":"景仁弟純字景懋，初為劉毅豫州別駕。毅鎮江陵，以為衞軍長史、南平相。王鎮惡率軍襲毅，已至城下，時毅疾病，佐吏皆入參承。純參承畢，已出，聞兵至，馳還入府。左右引車欲還外解，純叱之曰：「我人吏也，逃欲何之！」乃入。及毅兵敗眾散，時已暗夜，司馬毛脩之謂純曰：「君但隨僕。」純不從，扶兩人出，火光中為人所殺。純孫沈，太宗泰始初，為巴陵王休若衞軍錄事參軍、山陰令，坐事誅。","subject_person_mention_id":"c-songshu-052-xiechun:p001:m0151","object_person_mention_id":"c-songshu-052-xiechun:p001:m0149"}],"status":"contextual_provisional","interpretation_note":"謝沈是純之孫，上一代未具名。","human_reviewed":false,"person_id":"aa6_83c_juy_ABA*A"}],"name_components":[{"id":"nc-song052-xiechun-沈","person_id":"aa6_83c_juy_ABA*A","ming":"沈","additional_names":[],"chapter_id":"c-songshu-052-xiechun","paragraph_id":"c-songshu-052-xiechun:p001","quote":"景仁弟純字景懋，初為劉毅豫州別駕。毅鎮江陵，以為衞軍長史、南平相。王鎮惡率軍襲毅，已至城下，時毅疾病，佐吏皆入參承。純參承畢，已出，聞兵至，馳還入府。左右引車欲還外解，純叱之曰：「我人吏也，逃欲何之！」乃入。及毅兵敗眾散，時已暗夜，司馬毛脩之謂純曰：「君但隨僕。」純不從，扶兩人出，火光中為人所殺。純孫沈，太宗泰始初，為巴陵王休若衞軍錄事參軍、山陰令，坐事誅。","status":"editorial_provisional","human_reviewed":false,"work_id":"w-songshu","book_id":"b-songshu-052","source_id":"s-songshu-052-xiechun-ws2190655"}],"life_events":[{"id":"le-song052-xiechun-