3","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-004-zhou:m073-0015","start":15,"end":17,"surface":"王赧","kind":"person","person_id":"cbr-p000292","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p073","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-004-zhou:m073-0024","start":24,"end":26,"surface":"王赧","kind":"person","person_id":"cbr-p000292","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p073","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-004-zhou:m079-0000","start":0,"end":2,"surface":"王赧","kind":"person","person_id":"cbr-p000292","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p079","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-004-zhou:m085-0003","start":3,"end":5,"surface":"王赧","kind":"person","person_id":"cbr-p000292","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p085","chapter_id":"c-shiji-004-zhou"}],"relations":[{"id":"a-shiji004-068","subject_person_id":"cbr-p000292","predicate":"father","object_person_id":"cbr-p000291","status":"source_attested","evidence":[{"paragraph_id":"c-shiji-004-zhou:p073","quote":"慎靚王立六年，崩，子赧王延立","chapter_id":"c-shiji-004-zhou","source_id":"s-shiji-004-zhou"}],"qualifiers":{"source_term":"子","historicity":"historical_tradition"},"interpretation_note":"保存本文明示的親屬主張；不是獨立確證，不由繼位推導血緣。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-004-zhou:p073","text":"慎靚王立六年，崩，子赧王延立。王赧時東西周分治。王赧徙都西周。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-004-zhou:m073-0000","start":0,"end":3,"surface":"慎靚王","kind":"person","person_id":"cbr-p000291","status":"source_identified"},{"id":"c-shiji-004-zhou:m073-0010","start":10,"end":13,"surface":"赧王延","kind":"person","person_id":"cbr-p000292","status":"source_identified"},{"id":"c-shiji-004-zhou:m073-0015","start":15,"end":17,"surface":"王赧","kind":"person","person_id":"cbr-p000292","status":"source_identified"},{"id":"c-shiji-004-zhou:m073-0024","start":24,"end":26,"surface":"王赧","kind":"person","person_id":"cbr-p000292","status":"source_identified"}],"chapter_id":"c-shiji-004-zhou","book_id":"b-shiji-004","work_id":"w-shiji","source_id":"s-shiji-004-zhou"},{"id":"c-shiji-004-zhou:p079","text":"王赧謂成君。楚圍雍氏，韓徵甲與粟於東周，東周君恐，召蘇代而告之。代曰：「君何患於是。臣能使韓毋徵甲與粟於周，又能為君得高都。」周君曰：「子茍能，請以國聽子。」代見韓相國曰：「楚圍雍氏，期三月也，今五月不能拔，是楚病也。今相國乃徵甲與粟於周，是告楚病也。」韓相國曰：「善。使者已行矣。」代曰：「何不與周高都？」韓相國大怒曰：「吾毋徵甲與粟於周亦已多矣，何故與周高都也？」代曰：「與周高都，是周折而入於韓也，秦聞之必大怒忿周，即不通周使，是以獘高都得完周也。曷為不與？」相國曰：「善。」果與周高都。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-004-zhou:m079-0000","start":0,"end":2,"surface":"王赧","kind":"person","person_id":"cbr-p000292","status":"source_identified"},{"id":"c-shiji-004-zhou:m079-0003","start":3,"end":5,"surface":"成君","kind":"person","person_id":"cbr-p000301","status":"source_identified"},{"id":"c-shiji-004-zhou:m079-0020","start":20,"end":23,"surface":"東周君","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官號或文字疑讀；保留錨點，不補熟知姓名或假定同指。"},{"id":"c-shiji-004-zhou:m079-0026","start":26,"end":28,"surface":"蘇代","kind":"person","person_id":"cbr-p000298","status":"source_identified"},{"id":"c-shiji-004-zhou:m079-0032","start":32,"end":33,"surface":"代","kind":"person","person_id":"cbr-p000298","status":"contextual_provisional","interpretation_note":"依同段明示人物與敘事暫定短稱，不作其他段落或其他時代的自動識別。"},{"id":"c-shiji-004-zhou:m079-0063","start":63,"end":65,"surface":"周君","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官號或文字疑讀；保留錨點，不補熟知姓名或假定同指。"},{"id":"c-shiji-004-zhou:m079-0079","start":79,"end":80,"surface":"代","kind":"person","person_id":"cbr-p000298","status":"contextual_provisional","interpretation_note":"依同段明示人物與敘事暫定短稱，不作其他段落或其他時代的自動識別。"},{"id":"c-shiji-004-zhou:m079-0081","start":81,"end":84,"surface":"韓相國","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官號或文字疑讀；保留錨點，不補熟知姓名或假定同指。"},{"id":"c-