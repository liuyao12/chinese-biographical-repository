on_id":"c-shiji-009-lvhou:m010-0109","mention_ids":["c-shiji-009-lvhou:m010-0109"],"kind":"paragraph"},{"canonical_mention_id":"c-shiji-009-lvhou:m010-0173","mention_ids":["c-shiji-009-lvhou:m010-0173"],"kind":"paragraph"},{"canonical_mention_id":"c-shiji-009-lvhou:m010-0242","mention_ids":["c-shiji-009-lvhou:m010-0242"],"kind":"paragraph"}],"mention_count":9,"duplicate_mention_count":0,"paragraph_occurrence_count":9,"table_occurrence_count":0,"passage_count":2,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"9處獨立位置，9個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-shiji-009-lvhou"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"unresolved_identity_cases":[{"id":"ic-shiji097-young-emperor","status":"unresolved","candidate_person_ids":["0bm_5gr_a7x","nc4_msq_h8a","zht_ze7_m2d"],"paragraph_ids":["c-shiji-097-luli:p014","c-shiji-009-lvhou:p010","c-shiji-057-zhou:p008"],"note":"本篇少主保留來源局部候選，不代表另有第三位皇帝。已知可比對者為前少帝與後少帝弘；呂后篇於高后四年記置太尉官，周勃篇卻記孝惠六年，尚未核定重置、再任或傳文問題，不能只由太尉絳侯一稱排除前少帝。本篇及漢書相應段均未明年或具名，未將後文及誅諸呂逕當同一時點。保留待考，不宣稱三人已證不同。","references":[{"title":"《史記·呂太后本紀》高后四年置官","url":"https://zh.wikisource.org/w/index.php?title=史記/卷009&oldid=2087062","quote":"宣平侯女為孝惠皇后時，無子，詳為有身，取美人子名之，殺其母，立所名子為太子。孝惠崩，太子立為帝。帝壯，或聞其母死，非真皇后子，乃出言曰：「后安能殺吾母而名我？我未壯，壯即為變。」太后聞而患之，恐其為亂，乃幽之永卷中，言帝病甚，左右莫得見。太后曰：「凡有天下治為萬民命者，蓋之如天，容之如地，上有歡心以安百姓，百姓欣然以事其上，歡欣交通而天下治。今皇帝病久不已，乃失惑惛亂，不能繼嗣奉宗廟祭祀，不可屬天下，其代之。」群臣皆頓首言：「皇太后為天下齊民計所以安宗廟社稷甚深，群臣頓首奉詔。」帝廢位，太后幽殺之。五月丙辰，立常山王義為帝，更名曰弘。不稱元年者，以太后制天下事也。以軹侯朝為常山王。置太尉官，絳侯勃為太尉。五年八月，淮陽王薨，以弟壺關侯武為淮陽王。六年十月，太后曰呂王嘉居處驕恣，廢之，以肅王台弟呂產為呂王。夏，赦天下。封齊悼惠王子興居為東牟侯。","image_verified":false},{"title":"《史記·絳侯周勃世家》孝惠六年置官","url":"https://zh.wikisource.org/w/index.php?title=史記/卷057&oldid=1569360","quote":"勃既定燕而歸，高祖已崩矣，以列侯事孝惠帝。孝惠帝六年，置太尉官，以勃為太尉。十歲，高后崩。呂祿以趙王為漢上將軍，呂產以呂王為漢相國，秉漢權，欲危劉氏。勃為太尉，不得入軍門。陳平為丞相，不得任事。於是勃與平謀，卒誅諸呂而立孝文皇帝。其語在呂后、孝文事中。","image_verified":false},{"title":"《漢書·酈陸朱劉叔孫傳》陸賈相應段","url":"https://zh.wikisource.org/w/index.php?title=漢書/卷043&oldid=7904628","quote":"　　呂太后時，王諸呂，諸呂擅權，欲劫少主，危劉氏。右丞相陳平患之，力不能爭，恐禍及己。平常燕居深念。賈往，不請，直入坐，陳平方念，不見賈。賈曰：「何念深也？」平曰：「生揣我何念？」賈曰：「足下位為上相，食三萬戶侯，可謂極富貴無欲矣。然有憂念，不過患諸呂、少主耳。」陳平曰：「然。為之奈何？」賈曰：「天下安，注意相；天下危，注意將。將相和，則士豫附；士豫附，天下雖有變，則權不分。權不分，為社稷計，在兩君掌握耳。臣常欲謂太尉絳侯，絳侯與我戲，易吾言。君何不交驩太尉，深相結？」為陳平畫呂氏數事。平用其計，乃以五百金為絳侯壽，厚縣樂飲太尉，太尉亦報如之。兩人深相結，呂氏謀益壞。陳平乃以奴婢百人，車馬五十乘，錢五百萬，遺賈為食飲費。賈以此遊漢廷公卿間，名聲籍甚。及誅呂氏，立孝文，賈頗有力。 ","revision_id":7904628,"image_verified":false}],"reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"chapter_id":"c-shiji-097-luli","source_id":"s-shiji-097-luli"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-shiji009-013","person_id":"nc4_msq_h8a","event_type":"death","status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-009-lvhou","source_id":"s-shiji-009-lvhou","paragraph_id":"c-shiji-009-lvhou:p010","person_mention_id":"c-shiji-009-lvhou:m010-0035","quote_passage_ref":"data/corpus/shiji/009.json"}],"source_term":"太后幽殺之","interpretation_note":"太后幽殺已廢帝，五月丙辰屬新帝立，不逕作被殺當日。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"mentions":[{"id":"c-shiji-009-lvhou:m006-0178","start":178,"end":180,"surface":"太子","kind":"person","person_id":"nc4_msq_h8a","status":"contextual_provisional","paragraph_id":"c-shiji-009-lvhou:p006","chapter_id":"c-shiji-009-lvhou"},{"id":"c-shiji-009-lvhou:m006-0183","start":183,"end":184,"surface":"帝","kind":"person","person_id":"nc4_msq_h8a","status":"contextual_provisional","paragraph_id":"c-shiji-009-lvhou:p006"