fied"},{"id":"c-shiji-004-zhou:m046-0045","start":45,"end":47,"surface":"隱公","kind":"person","person_id":"cbr-p000225","status":"source_identified"},{"id":"c-shiji-004-zhou:m046-0049","start":49,"end":51,"surface":"桓公","kind":"person","person_id":"cbr-p000229","status":"source_identified"},{"id":"c-shiji-004-zhou:m046-0062","start":62,"end":64,"surface":"桓王","kind":"person","person_id":"cbr-p000227","status":"source_identified"},{"id":"c-shiji-004-zhou:m046-0065","start":65,"end":67,"surface":"桓王","kind":"person","person_id":"cbr-p000227","status":"source_identified"}],"chapter_id":"c-shiji-004-zhou","book_id":"b-shiji-004","work_id":"w-shiji","source_id":"s-shiji-004-zhou"},{"id":"c-shiji-004-zhou:p047","text":"二十三年，桓王崩，子莊王佗立。莊王四年，周公黑肩欲殺莊王而立王子克。辛伯告王，王殺周公。王子克奔燕。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-004-zhou:m047-0005","start":5,"end":7,"surface":"桓王","kind":"person","person_id":"cbr-p000227","status":"source_identified"},{"id":"c-shiji-004-zhou:m047-0010","start":10,"end":13,"surface":"莊王佗","kind":"person","person_id":"cbr-p000230","status":"source_identified"},{"id":"c-shiji-004-zhou:m047-0015","start":15,"end":17,"surface":"莊王","kind":"person","person_id":"cbr-p000230","status":"source_identified"},{"id":"c-shiji-004-zhou:m047-0020","start":20,"end":24,"surface":"周公黑肩","kind":"person","person_id":"cbr-p000231","status":"source_identified"},{"id":"c-shiji-004-zhou:m047-0026","start":26,"end":28,"surface":"莊王","kind":"person","person_id":"cbr-p000230","status":"source_identified"},{"id":"c-shiji-004-zhou:m047-0030","start":30,"end":33,"surface":"王子克","kind":"person","person_id":"cbr-p000232","status":"source_identified"},{"id":"c-shiji-004-zhou:m047-0034","start":34,"end":36,"surface":"辛伯","kind":"person","person_id":"cbr-p000233","status":"source_identified"},{"id":"c-shiji-004-zhou:m047-0041","start":41,"end":43,"surface":"周公","kind":"person","person_id":"cbr-p000231","status":"source_identified"},{"id":"c-shiji-004-zhou:m047