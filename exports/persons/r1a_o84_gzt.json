":"received_chapter","annotation_status":"named_mentions_first_pass","source_position":{"rendered_tool_line":202,"capture_ref":"source-evidence/jin044-lu-rendered/received-rendered-capture.json","capture_kind":"existing_rendered_text_not_raw","projection":"remove leading ideographic spaces and tool-link wrappers only"},"mentions":[{"id":"c-jinshu-044-luqin-family-rendered:p009:m0001","start":1,"end":5,"surface":"東海王越","kind":"person","person_id":"dkn_ge4_286_AAADBA","status":"contextual_provisional","resolution_note":"依本篇角色及已列原段，首選沿用現役身份；限制另列。身份審讀：yue。","source_identity_role":"yue","identity_reading_ref":"source-evidence/jin044-lu-rendered/identity-readings.json#yue"},{"id":"c-jinshu-044-luqin-family-rendered:p009:m0010","start":10,"end":11,"surface":"顒","kind":"person","person_id":"ed0_313_bea","status":"contextual_provisional","resolution_note":"依本篇角色及已列原段，首選沿用現役身份；限制另列。身份審讀：yong。","source_identity_role":"yong","identity_reading_ref":"source-evidence/jin044-lu-rendered/identity-readings.json#yong"},{"id":"c-jinshu-044-luqin-family-rendered:p009:m0012","start":12,"end":13,"surface":"帝","kind":"person","person_id":"dkn_ge4_286_AAAAIAA","status":"contextual_provisional","resolution_note":"依本篇角色及已列原段，首選沿用現役身份；限制另列。身份審讀：huidi。","source_identity_role":"huidi","identity_reading_ref":"source-evidence/jin044-lu-rendered/identity-readings.json#huidi"},{"id":"c-jinshu-044-luqin-family-rendered:p009:m0014","start":14,"end":15,"surface":"穎","kind":"person","person_id":"dkn_ge4_286_AAAAIAC","status":"contextual_provisional","resolution_note":"依本篇角色及已列原段，首選沿用現役身份；限制另列。身份審讀：ying。","source_identity_role":"ying","identity_reading_ref":"source-evidence/jin044-lu-rendered/identity-readings.json#ying"},{"id":"c-jinshu-044-luqin-family-rendered:p009:m0019","start":19,"end":20,"surface":"志","kind":"person","person_id":"m8n_ntm_79h_ABB","status":"contextual_provisional","resolution_note":"依本篇角色及已列原段，首選沿用現役身份；限制另列。身份審讀：luzhi。","source_identity_role":"luzhi","identity_reading_ref":"source-