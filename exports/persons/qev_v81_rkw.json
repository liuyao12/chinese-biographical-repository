「此誠陛下曲恩，寧可以臣微族，頓廢君臣之義。」固求陪從。至建州，敍行從功臣，自城陽王徽已下凡十人，並增三階。以侃河梁之誠，特加四階。侃固辭，乞同諸人，久乃見許。於是除鎮軍將軍、度支尚書、兼給事黃門侍郎，敷西縣開國公，食邑一千戶。","text_layer":"received_chapter","annotation_status":"in_progress","source_position":{"revision_id":2087998,"raw_start":2085,"raw_end":2341,"source_layer":"received_biography","raw_character_offsets":[2085,2086,2087,2088,2089,2090,2091,2092,2093,2094,2095,2096,2097,2098,2099,2100,2101,2102,2103,2104,2105,2106,2107,2108,2109,2110,2111,2112,2113,2114,2115,2116,2117,2118,2119,2120,2121,2122,2123,2124,2125,2126,2127,2128,2129,2130,2131,2132,2133,2134,2135,2136,2137,2138,2139,2140,2141,2142,2143,2144,2145,2146,2147,2148,2149,2150,2151,2152,2153,2154,2155,2156,2157,2158,2159,2160,2161,2162,2163,2164,2165,2166,2167,2168,2169,2170,2171,2172,2173,2174,2175,2176,2177,2178,2179,2180,2181,2182,2183,2184,2185,2186,2187,2188,2189,2190,2191,2192,2193,2194,2195,2196,2197,2198,2199,2200,2201,2202,2203,2204,2205,2206,2207,2208,2209,2210,2211,2212,2213,2214,2215,2216,2217,2218,2219,2220,2221,2222,2223,2224,2225,2226,2227,2228,2229,2230,2231,2232,2233,2234,2235,2236,2237,2238,2239,2240,2241,2242,2243,2244,2245,2246,2247,2248,2249,2250,2251,2252,2253,2254,2255,2256,2257,2258,2259,2260,2261,2262,2263,2264,2265,2266,2267,2268,2269,2270,2271,2272,2273,2274,2275,2276,2277,2278,2279,2280,2281,2282,2283,2284,2285,2286,2287,2288,2289,2290,2291,2292,2293,2294,2295,2296,2297,2298,2299,2300,2301,2302,2303,2304,2305,2306,2307,2308,2309,2310,2311,2312,2313,2314,2315,2316,2317,2318,2319,2320,2321,2322,2323,2324,2325,2326,2327,2328,2329,2330,2331,2332,2333,2334,2335,2336,2337,2338,2339,2340],"projection_sha256":"b701c5d45b4c714146cd39311d8e1db8cd09942f7208bcd33d0353b1dc2844f3"},"mentions":[{"id":"c-weishu-weishou-058-yangbo-yangkan:p010:m0049","start":49,"end":51,"surface":"元顥","kind":"person","person_id":"m59_oif_ju9","status":"contextual_provisional","interpretation_note":"內逼、據南岸、陳慶之守北中、榮渡河破其子冠受後南走同線；非謝顥或桓顥。"},{"id":"c-weishu-weishou-058-yangbo-yangkan:p010:m0083","start":83,"end":85,"