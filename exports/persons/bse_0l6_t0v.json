fault":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-098-jin033-wangji:head:m0268","start":268,"end":270,"surface":"魯瑤","kind":"person","person_id":"bse_0l6_t0v","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:head","chapter_id":"c-jinshu-098-jin033-wangji"}],"relations":[],"title_holdings":[{"id":"th-w098-dun-early-6","person_id":"bse_0l6_t0v","title":"舍人","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-098","chapter_id":"c-jinshu-098-jin033-wangji","source_id":"s-jinshu-098-jin033-wangji","paragraph_id":"c-jinshu-098-jin033-wangji:head","quote":"王敦，字處仲，司徒導之從父兄也。父基，治書侍御史。敦少有奇人之目，尚武帝女襄城公主，拜駙馬都尉，除太子舍人。時王愷、石崇以豪侈相尚，愷嘗置酒，敦與導俱在坐，有女伎吹笛小失聲韻，愷便驅殺之，一坐改容，敦神色自若。他日，又造愷，愷使美人行酒，以客飲不盡，輒殺之。酒至敦、導所，敦故不肯持，美人悲懼失色，而敦傲然不視。導素不能飲，恐行酒者得罪，遂勉強盡觴。導還，歎曰：「處仲若當世，心懷剛忍，非令終也。」洗馬潘滔見敦而目之曰：「處仲蜂目已露，但豺聲未振，若不噬人，亦當為人所噬。」及太子遷許昌，詔東宮官屬不得送。敦及洗馬江統、潘滔，舍人杜蕤、魯瑤等，冒禁于路側望拜流涕，時論稱之。遷給事黃門侍郎。","person_mention_id":"c-jinshu-098-jin033-wangji:head:m0268"}],"attestations":[{"id":"th-w043-dun-early-6:a","paragraph_id":"c-jinshu-098-jin033-wangji:head","start":263,"end":265,"surface":"舍人","person_mention_id":"c-jinshu-098-jin033-wangji:head:m0268","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-098-jin033-wangji:head","text":"王敦，字處仲，司徒導之從父兄也。父基，治書侍御史。敦少有奇人之目，尚武帝女襄城公主，拜駙馬都尉，除太子舍人。時王愷、石崇以豪侈相尚，愷嘗置酒，敦與導俱在坐，有女伎吹笛小失聲