{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000710","identity_policy":"contextual_provisional","person_ids":["cbr-p000710"],"persons":[{"id":"cbr-p000710","label":"鄭昌","status":"active","historicity":"historical_tradition","aliases":[{"surface":"鄭昌","mention_ids":["c-shiji-007-xiangyu:m024-0037","c-shiji-008-gaozu:m029-0132"]},{"surface":"韓王昌","mention_ids":["c-shiji-008-gaozu:m030-0025"]}],"evidence":[{"mention_id":"c-shiji-007-xiangyu:m024-0037","chapter_id":"c-shiji-007-xiangyu","paragraph_id":"c-shiji-007-xiangyu:p024","quote":"鄭昌"},{"mention_id":"c-shiji-008-gaozu:m029-0132","chapter_id":"c-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p029","quote":"鄭昌"},{"mention_id":"c-shiji-008-gaozu:m030-0025","chapter_id":"c-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p030","quote":"韓王昌"}]}],"mentions":[{"id":"c-shiji-007-xiangyu:m024-0037","start":37,"end":39,"surface":"鄭昌","kind":"person","person_id":"cbr-p000710","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p024","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-008-gaozu:m029-0132","start":132,"end":134,"surface":"鄭昌","kind":"person","person_id":"cbr-p000710","status":"contextual_provisional","paragraph_id":"c-shiji-008-gaozu:p029","chapter_id":"c-shiji-008-gaozu"},{"id":"c-shiji-008-gaozu:m030-0025","start":25,"end":28,"surface":"韓王昌","kind":"person","person_id":"cbr-p000710","status":"contextual_provisional","paragraph_id":"c-shiji-008-gaozu:p030","chapter_id":"c-shiji-008-gaozu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji008-050","person_id":"cbr-p000710","surfaces":["鄭昌","韓王昌"],"scope":"cross_chapter","chapter_ids":["c-shiji-007-xiangyu","c-shiji-008-gaozu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-007-xiangyu:p024","quote":"是時，漢還定三秦。項羽聞漢王皆已并關中，且東，齊、趙叛之：大怒。乃以故吳令鄭昌為韓王，以距漢。令蕭公角等擊彭越。彭越敗蕭公角等。漢使張良徇韓，乃遺項王書曰：「漢王失職，欲得關中，如約即止，不敢東。」又以齊、梁反書遺項王曰：「齊欲與趙并滅楚。」楚以此故無西意，而北擊齊。徵兵九江王布。布稱疾不往，使將將數千人行。項王由此怨布也。漢之二年冬，項羽遂北至城陽，田榮亦將兵會戰。田榮不勝，走至平原，平原民殺之。遂北燒夷齊城郭室屋，皆阬田榮降卒，系虜其老弱婦女。徇齊至北海，多所殘滅。齊人相聚而叛之。於是田榮弟田橫收齊亡卒得數萬人，反城陽。項王因留，連戰未能下。"},{"paragraph_id":"c-shiji-008-gaozu:p029","quote":"八月，漢王用韓信之計，從故道還，襲雍王章邯。邯迎擊漢陳倉，雍兵敗，還走；止戰好畤，又復敗，走廢丘。漢王遂定雍地。東至咸陽，引兵圍雍王廢丘，而遣諸將略定隴西、北地、上郡。令將軍薛歐、王吸出武關，因王陵兵南陽，以迎太公、呂后於沛。楚聞之，發兵距之陽夏，不得前。令故吳令鄭昌為韓王，距漢兵。"},{"paragraph_id":"c-shiji-008-gaozu:p030","quote":"二年，漢王東略地，塞王欣、翟王翳、河南王申陽皆降。韓王昌不聽，使韓信擊破之。於是置隴西、北地、上郡、渭南、河上、中地郡；關外置河南郡。更立韓太尉信為韓王。諸將以萬人若以一郡降者，封萬戶。繕治河上塞。諸故秦苑囿園池，皆令人得田之，正月，虜雍王弟章平。大赦罪人。"}],"rationale":"只在所列原句的秦末楚漢軍事／分封敘事內暫定同指；有前卷錨點時對讀相接事件，不把同名作全庫匹配規則，仍待異源覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-007-xiangyu:p024","text":"是時，漢還定三秦。項羽聞漢王皆已并關中，且東，齊、趙叛之：大怒。乃以故吳令鄭昌為韓王，以距漢。令蕭公角等擊彭越。彭越敗蕭公角等。漢使張良徇韓，乃遺項王書曰：「漢王失職，欲得關中，如約即止，不敢東。」又以齊、梁反書遺項王曰：「齊欲與趙并滅楚。」楚以此故無西意，而北擊齊。徵兵九江王布。布稱疾不往，使將將數千人行。項王由此怨布也。漢之二年冬，項羽遂北至城陽，田榮亦將兵會戰。田榮不勝，走至平原，平原民殺之。遂北燒夷齊城郭室屋，皆阬田榮降卒，系虜其老弱婦女。徇齊至北海，多所殘滅。齊人相聚而叛之。於是田榮弟田橫收齊亡卒得數萬人，反城陽。項王因留，連戰未能下。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-007-xiangyu:m024-0009","start":9,"end":11,"surface":"項羽","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m024-0012","start":12,"end":14,"surface":"漢王","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m024-0037","start":37,"end":39,"surface":"鄭昌","kind":"person","person_id":"cbr-p000710","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m024-0048","start":48,"end":51,"surface":"蕭公角","kind":"person","person_id":"cbr-p000711","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m024-0053","start":53,"end":55,"surface":"彭越","kind":"person","person_id":"cbr-p000707","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m024-0056","start":56,"end":58,"surface":"彭越","kind":"person","person_id":"cbr-p000707","s