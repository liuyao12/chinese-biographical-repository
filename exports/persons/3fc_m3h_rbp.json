in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m002-0001","start":1,"end":3,"surface":"孔子","kind":"person","person_id":"t0d_uf0_f2f","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m002-0006","start":6,"end":11,"surface":"七十子之徒","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m002-0013","start":13,"end":15,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m002-0028","start":28,"end":31,"surface":"士大夫","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m002-0039","start":39,"end":41,"surface":"子路","kind":"person","person_id":"wkl_tds_yi3","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m002-0044","start":44,"end":46,"surface":"子張","kind":"person","person_id":"8bm_lxy_7br","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m002-0049","start":49,"end":53,"surface":"澹臺子羽","kind":"person","person_id":"g0i_iwm_ld0","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m002-0056","start":56,"end":58,"surface":"子夏","kind":"person","person_id":"z8v_0js_a1h","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m002-0062","start":62,"end":64,"surface":"子貢","kind":"person","person_id":"ql4_eg2_psw","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m002-0069","start":69,"end":72,"surface":"田子方","kind":"person","person_id":"qyt_u4y_jsx","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m002-0073","start":73,"end":76,"surface":"段干木","kind":"person","person_id":"3fc_m3h_rbp","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m002-0077","start":77,"end":79,"surface":"吳起","kind":"person","person_id":"t4i_ezb_ooa","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m002-0080","start":80,"end":83,"surface":"禽滑釐","kind":"person","person_id":"tux_am7_z4u","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m002-0090","start":90,"end":92,"surface