"c-shiji-118-huainan:p013","chapter_id":"c-shiji-118-huainan"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-118-huainan:p012","text":"孝文十二年，民有作歌歌淮南厲王曰：「一尺布，尚可縫；一斗粟，尚可舂。兄弟二人不能相容。」上聞之，乃嘆曰：「堯舜放逐骨肉，周公殺管蔡，天下稱聖。何者？不以私害公。天下豈以我為貪淮南王地邪？」乃徙城陽王王淮南故地，而追尊謚淮南王為厲王，置園復如諸侯儀。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-118-huainan:m012-0000","start":0,"end":2,"surface":"孝文","kind":"person","person_id":"wef_drj_j44","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m012-0011","start":11,"end":15,"surface":"淮南厲王","kind":"person","person_id":"brp_v5i_sjg_A","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m012-0034","start":34,"end":38,"surface":"兄弟二人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-118-huainan:m012-0044","start":44,"end":45,"surface":"上","kind":"person","person_id":"wef_drj_j44","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m012-0053","start":53,"end":54,"surface":"堯","kind":"person","person_id":"3rn_zwc_d5j","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m012-0054","start":54,"end":55,"surface":"舜","kind":"person","person_id":"a8k_u91_d8m","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m012-0060","start":60,"end":62,"surface":"周公","kind":"person","person_id":"l6h_c2o_giv","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m012-0063","start":63,"end":64,"surface":"管","kind":"person","person_id":"wkq_pb7_afj","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m012-0064","start":64,"end":65,"surface":"蔡","kind":"person","person_id":"won_vq8_gwj","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m012-0087","start":87,"end":90,"surface":"淮南王","kind":"person","person_id":"brp_v5i_sjg_A","status":"contextual_provi