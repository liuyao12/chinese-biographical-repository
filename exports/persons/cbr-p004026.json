kind":"person","person_id":"il9_kpr_9zz","status":"contextual_provisional"},{"id":"c-shiji-069-su:m018-0039","start":39,"end":41,"surface":"蘇秦","kind":"person","person_id":"98y_02x_z6o","status":"contextual_provisional"},{"id":"c-shiji-069-su:m018-0052","start":52,"end":54,"surface":"張儀","kind":"person","person_id":"7zk_y8t_6l9","status":"contextual_provisional"}],"chapter_id":"c-shiji-069-su","book_id":"b-shiji-069","work_id":"w-shiji","source_id":"s-shiji-069-su"},{"id":"c-shiji-069-su:p040","text":"秦惠王以其女為燕太子婦。是歲，文侯卒，太子立，是為燕易王。易王初立，齊宣王因燕喪伐燕，取十城。易王謂蘇秦曰：「往日先生至燕，而先王資先生見趙，遂約六國從。今齊先伐趙，次至燕，以先生之故為天下笑，先生能為燕得侵地乎？」蘇秦大慚，曰：「請為王取之。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m040-0000","start":0,"end":3,"surface":"秦惠王","kind":"person","person_id":"6oy_t19_ywe","status":"contextual_provisional"},{"id":"c-shiji-069-su:m040-0004","start":4,"end":6,"surface":"其女","kind":"person","person_id":"6oy_t19_ywe_A","status":"contextual_provisional"},{"id":"c-shiji-069-su:m040-0007","start":7,"end":10,"surface":"燕太子","kind":"person","person_id":"49x_hsj_tmo","status":"contextual_provisional"},{"id":"c-shiji-069-su:m040-0010","start":10,"end":11,"surface":"婦","kind":"person","person_id":"6oy_t19_ywe_A","status":"contextual_provisional"},{"id":"c-shiji-069-su:m040-0015","start":15,"end":17,"surface":"文侯","kind":"person","person_id":"xs7_jo2_pjd","status":"contextual_provisional"},{"id":"c-shiji-069-su:m040-0019","start":19,"end":21,"surface":"太子","kind":"person","person_id":"49x_hsj_tmo","status":"contextual_provisional"},{"id":"c-shiji-069-su:m040-0025","start":25,"end":28,"surface":"燕易王","kind":"person","person_id":"49x_hsj_tmo","status":"contextual_provisional"},{"id":"c-shiji-069-su:m040-0029","start":29,"end":31,"surface":"易王","kind":"person","person_id":"49x_hsj_tmo","status":"contextual_provisional"},{"id":"c-shiji-069-su:m040-0034","start":34,"end":37,"surface":"齊宣王","kind":"person","person_id":"iqu_pas_2r5","status":"contextual_provisional"},{"id":"c-shiji-069-su:m040-0047","start":47,"end":49,"surface":"易王","kind":"person","person_id":"49x_hsj_tmo","status":"contextual_provisional"},{"id":"c-shiji-069-su:m040-0050","start":50,"end":52,"surface":"蘇秦","kind":"person","person_id":"98y_02x_z6o","status":"contextual_provisional"},{"id":"c-shiji-069-su:m040-0057","start":57,"end":59,"surface":"先生","kind":"person","person_id":"98y_02x_z6o","status":"contextual_provisional"},{"id":"c-shiji-069-su:m040-0063","start":63,"end":65,"surface":"先王","kind":"person","person_id":"xs7_jo2_pjd","status":"contextual_provisional"},{"id":"c-shiji-069-su:m040-0066","start":66,"end":68,"surface":"先生","kind":"person","person_id":"98y_02x_z6o","status":"contextual_provisional"},{"id":"c-shiji-069-su:m040-0088","start":88,"end":90,"surface":"先生","kind":"person","person_id":"98y_02x_z6o","status":"contextual_provisional"},{"id":"c-shiji-069-su:m040-0097","start":97,"end":99,"surface":"先生","kind":"person","person_id":"98y_02x_z6o","status":"contextual_provisional"},{"id":"c-shiji-069-su:m040-0108","start":108,"end":110,"surface":"蘇秦","kind":"person","person_id":"98y_02x_z6o","status":"contextual_provisional"}],"chapter_id":"c-shiji-069-su","book_id":"b-shiji-069","work_id":"w-shiji","source_id":"s-shiji-069-su"},{"id":"c-shiji-069-su:p041","text":"蘇秦見齊王，再拜，俯而慶，仰而弔。齊王曰：「是何慶弔相隨之速也？」蘇秦曰：「臣聞飢人所以飢而不食烏喙者，為其愈充腹而與餓死同患也。今燕雖弱小，即秦王之少壻也。大王利其十城而長與彊秦為仇。今使弱燕為鴈行而彊秦敝其後，以招天下之精兵，是食烏喙之類也。」齊王愀然變色曰：「然則奈何？」蘇秦曰：「臣聞古之善制事者，轉禍為福，因敗為功。大王誠能聽臣計，即歸燕之十城。燕無故而得十城，必喜；秦王知以己之故而歸燕之十城，亦必喜。此所謂棄仇讎而得石交者也。夫燕、秦俱事齊，則大王號令天下，莫敢不聽。是王以虛辭附秦，以十城取天下。此霸王之業也。」王曰：「善。」於是乃歸燕之十城。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m041-0000","start":0,"end":2,"surface":"蘇秦","kind":"person","person_id":"98y_02x_z6o","status":"contextual_provisional"},{"id":"c-shiji-069-su:m041-0003","start":3,"end":5,"surface":"齊王","kind":"person","person_id":"iqu_pas_2r5","status":"contextual_provisional"},{"id":