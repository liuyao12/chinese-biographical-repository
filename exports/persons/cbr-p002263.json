013-0146","start":146,"end":148,"surface":"趙盾","kind":"person","person_id":"cbr-p002259","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m013-0152","start":152,"end":154,"surface":"宣孟","kind":"person","person_id":"cbr-p002259","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m013-0156","start":156,"end":157,"surface":"朔","kind":"person","person_id":"cbr-p002270","status":"contextual_provisional"}],"chapter_id":"c-shiji-043-zhao","book_id":"b-shiji-043","work_id":"w-shiji","source_id":"s-shiji-043-zhao"},{"id":"c-shiji-043-zhao:p019","text":"趙氏復位十一年，而晉厲公殺其大夫三郤。欒書畏及，乃遂弒其君厲公，更立襄公曾孫周，是爲悼公。晉由此大夫稍彊。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-043-zhao:m019-0009","start":9,"end":12,"surface":"晉厲公","kind":"person","person_id":"cbr-p002280","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m019-0016","start":16,"end":18,"surface":"三郤","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、神祇、馬匹、校勘或未定稱呼保留；不補名字、成員或闕代，故事說詞不作真孤被殺證據。"},{"id":"c-shiji-043-zhao:m019-0019","start":19,"end":21,"surface":"欒書","kind":"person","person_id":"cbr-p002281","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m019-0029","start":29,"end":31,"surface":"厲公","kind":"person","person_id":"cbr-p002280","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m019-0034","start":34,"end":36,"surface":"襄公","kind":"person","person_id":"cbr-p002263","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m019-0036","start":36,"end":39,"surface":"曾孫周","kind":"person","person_id":"cbr-p002282","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m019-0042","start":42,"end":44,"surface":"悼公","kind":"person","person_id":"cbr-p002282","status":"contextual_provisional"}],"chapter_id":"c-shiji-043-zhao","book_id":"b-shiji-043","work_id":"w-shiji","source_id":"s-shiji-043-zhao"},{"id":"c-shiji-043-zhao:p026","text":"趙簡子疾，五日不知人，大夫皆懼。醫扁鵲視之，出，董安于問。扁鵲曰：「血脈治也，而何怪！在昔秦繆公嘗如此，七日而寤。寤之日，告公孫支與子輿曰：『我之帝所甚樂。吾所以久者，適有學也。帝告我：「晉國將大亂，五世不安；其後將霸，未老而死；霸者之子且令而國男女無別。」』公孫支書而藏之，秦讖於是出矣。獻公之亂，文公之霸，而襄公敗秦師於殽而歸縱淫，此子之所聞。今主君之疾與之同，不出三日疾必閒，閒必有言也。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-043-zhao:m026-0000","start":0,"end":3,"surface":"趙簡子","kind":"person","person_id":"cbr-p002292","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m026-0011","start":11,"end":13,"surface":"大夫","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、神異預言、職稱或未定指代；不從夢辭補人物世系，不把范中行氏族字面全域當個人。"},{"id":"c-shiji-043-zhao:m026-0017","start":17,"end":19,"surface":"扁鵲","kind":"person","person_id":"cbr-p002297","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m026-0024","start":24,"end":27,"surface":"董安于","kind":"person","person_id":"cbr-p002298","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m026-0029","start":29,"end":31,"surface":"扁鵲","kind":"person","person_id":"cbr-p002297","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m026-0045","start":45,"end":48,"surface":"秦繆公","kind":"person","person_id":"cbr-p002299","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m026-0062","start":62,"end":65,"surface":"公孫支","kind":"person","person_id":"cbr-p002300","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m026-0066","start":66,"end":68,"surface":"子輿","kind":"person","person_id":"cbr-p002301","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m026-0073","start":73,"end":74,"surface":"帝","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、神異預言、職稱或未定指代；不從夢辭補人物世系，不把范中行氏族字面全域當個人。"},{"id":"c-shiji-043-zhao:m026-0089","start":89,"end":90,"surface":"帝","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、神異預言、職稱或未定指代；不從夢辭補人物世系，不把范中行氏族字面全域當個人。"},{"id":"c-shiji-043-zhao:m026-0115","start":115,"end":119,"surface":"霸者之子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、神異預言、職稱或未定指代；不從夢辭補人物世系，不把范中行氏族字面全域當個人。"},{"id":"c-shiji-043-zhao