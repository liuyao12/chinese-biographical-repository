,{"id":"c-shiji-043-zhao:m012-0108","start":108,"end":110,"surface":"襄公","kind":"person","person_id":"cbr-p002263","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p012","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m013-0088","start":88,"end":90,"surface":"襄公","kind":"person","person_id":"cbr-p002263","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p013","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m019-0034","start":34,"end":36,"surface":"襄公","kind":"person","person_id":"cbr-p002263","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p019","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m026-0156","start":156,"end":158,"surface":"襄公","kind":"person","person_id":"cbr-p002263","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p026","chapter_id":"c-shiji-043-zhao"}],"relations":[{"id":"a-shiji043-022","subject_person_id":"cbr-p002265","predicate":"brother","object_person_id":"cbr-p002263","status":"source_attested","evidence":[{"chapter_id":"c-shiji-043-zhao","source_id":"s-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p012","quote":"趙盾代成季任國政二年而晉襄公卒，太子夷皋年少。盾爲國多難，欲立襄公弟雍。雍時在秦，使使迎之。太子母日夜啼泣，頓首謂趙盾曰：「先君何罪，釋其適子而更求君？」趙盾患之，恐其宗與大夫襲誅之，乃遂立太子，是爲靈公，發兵距所迎襄公弟於秦者。靈公旣立，趙盾益專國政。"}],"qualifiers":{"source_term":"襄公弟雍","historicity":"historical_tradition"},"interpretation_note":"保存明示生、子、妻、兄弟與祖系敘事；闕代不補父子，兄弟不推同母。下宮故事及遺腹命名脈絡是來源主張，未當成已覆核的史實或年代。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji043-024","subject_person_id":"cbr-p002268","predicate":"brother","object_person_id":"cbr-p002263","status":"source_attested","evidence":[{"chapter_id":"c-shiji-043-zhao","source_id":"s-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p013","quote":"靈公立十四年，益驕。趙盾驟諫，靈公弗聽。及食熊蹯，胹不熟，殺宰人，持其尸出，趙盾見之。靈公由此懼，欲殺盾。盾素仁愛人，嘗所食桑下餓人反捍救盾，盾以得亡。未出境，而趙穿弒靈公而立襄公弟黑臀，是爲成公。趙盾復反，任國政。君子譏盾「爲正卿，亡不出境，反不討賊」，故太史書曰「趙盾弒其君」。晉景公時而趙盾卒，諡爲宣孟，子朔嗣。"}],"qualifiers":{"source_term":"襄公弟黑臀","historicity":"historical_tradition"},"interpretation_note":"保存明示生、子、妻、兄弟與祖系敘事；闕代不補父子，兄弟不推同母。下宮故事及遺腹命名脈絡是來源主張，未當成已覆核的史實或年代。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji043-030","subject_person_id":"cbr-p002282","predicate":"great_grandfather","object_person_id":"cbr-p002263","status":"source_attested","evidence":[{"chapter_id":"c-shiji-043-zhao","source_id":"s-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p019","quote":"趙氏復位十一年，而晉厲公殺其大夫三郤。欒書畏及，乃遂弒其君厲公，更立襄公曾孫周，是爲悼公。晉由此大夫稍彊。"}],"qualifiers":{"source_term":"襄公曾孫周","historicity":"historical_tradition"},"interpretation_note":"保存明示生、子、妻、兄弟與祖系敘事；闕代不補父子，兄弟不推同母。下宮故事及遺腹命名脈絡是來源主張，未當成已覆核的史實或年代。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji043-034","person_id":"cbr-p002263","surfaces":["晉襄公","襄公"],"scope":"same_chapter","chapter_ids":["c-shiji-043-zhao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-043-zhao:p011","quote":"趙衰旣反晉，晉之妻固要迎翟妻，而以其子盾爲適嗣，晉妻三子皆下事之。晉襄公之六年，而趙衰卒，諡爲成季。"},{"paragraph_id":"c-shiji-043-zhao:p012","quote":"趙盾代成季任國政二年而晉襄公卒，太子夷皋年少。盾爲國多難，欲立襄公弟雍。雍時在秦，使使迎之。太子母日夜啼泣，頓首謂趙盾曰：「先君何罪，釋其適子而更求君？」趙盾患之，恐其宗與大夫襲誅之，乃遂立太子，是爲靈公，發兵距所迎襄公弟於秦者。靈公旣立，趙盾益專國政。"},{"paragraph_id":"c-shiji-043-zhao:p013","quote":"靈公立十四年，益驕。趙盾驟諫，靈公弗聽。及食熊蹯，胹不熟，殺宰人，持其尸出，趙盾見之。靈公由此懼，欲殺盾。盾素仁愛人，嘗所食桑下餓人反捍救盾，盾以得亡。未出境，而趙穿弒靈公而立襄公弟黑臀，是爲成公。趙盾復反，任國政。君子譏盾「爲正卿，亡不出境，反不討賊」，故太史書曰「趙盾弒其君」。晉景公時而趙盾卒，諡爲宣孟，子朔嗣。"},{"paragraph_id":"c-shiji-043-zhao:p019","quote":"趙氏復位十一年，而晉厲公殺其大夫三郤。欒書畏及，乃遂弒其君厲公，更立襄公曾孫周，是爲悼公。晉由此大夫稍彊。"},{"paragraph_id":"c-shiji-043-zhao:p026","quote":"趙簡子疾，五日不知人，大夫皆懼。醫扁鵲視之，出，董安于問。扁鵲曰：「血脈治也，而何怪！在昔秦繆公嘗如此，七日而寤。寤之日，告公孫支與子輿曰：『我之帝所甚樂。吾所以久者，適有學也。帝告我：「晉國將大亂，五世不安；其後將霸，未老而死；霸者之子且令而國男女無別。」』公孫支書而藏之，秦讖於是出矣。獻公之亂，文公之霸，而襄公敗秦師於殽而歸縱淫，此子之所聞。今主君之疾與之同，不出三日疾必閒，閒必有言也。」"}],"rationale":"限本篇明示名字、是為與連續事件暫接異稱；真孤與替代兒分開，馬匹、群體與闕代不當個人，不以模型記憶補熟知姓名。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-043-zhao:p011","text":"趙衰旣反晉，晉之妻固要迎翟妻，而以其子盾爲適嗣，晉妻三子皆下事之。晉襄公之六年，而趙衰卒，諡爲成季。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-043-zhao:m011-0000","start":0,"end":2,"surface":"趙衰","kind":"person","person_id":"cbr-p002253","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m011-0006","start":6,"end":9,"surface":"晉之妻","kind":"person","person_id":"cbr-p002258","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m011-0012","start":12,"end":14,"surface":"翟妻","kind":"person","person_id":"cbr-p002257","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m011-0019","start":19,"end":20,"surface":"盾","kind":"person","person_id":"cbr-p002259","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m011-0024","start":24,"end":26,"surface":"晉妻","kind":"person","person_id":"cbr-p002258","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m011-0033","start":33,"end":36,"surface":"晉襄公","kind":"person","person_id":"cbr-p002263","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m011-0041","start":41,"end":43,"surface":"趙衰","kind":"person","person_id":"cbr-p002253","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m011-0047","start":47,"end":49,"surface":"成季","kind":"person","person_id":"cbr-p002253","status":"contextual_provisional"}],"chapter_id":"c-shiji-043-zhao","book_id":"b-shiji-043","work_id":"w-shiji","source_id":"s-shiji-043-zhao"},{"id":"c-shiji-043-zhao:p012","text":"趙盾代成季任國政二年而晉襄公卒，太子夷皋年少。盾爲國多難，欲立襄公弟雍。雍時在秦，使使迎之。太子母日夜啼泣，頓首謂趙盾曰：「先君何罪，釋其適子而更求君？」趙盾患之，恐其宗與大夫襲誅之，乃遂立太子，是爲靈公，發兵距所迎襄公弟於秦者。靈公旣立，趙盾益專國政。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-043-zhao:m012-0000","start":0,"end":2,"surface":"趙盾","kind":"person","person_id":"cbr-p002259","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m012-0003","start":3,"end":5,"surface":"成季","kind":"person","person_id":"cbr-p002253","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m012-0011","start":11,"end":14,"surface":"晉襄公","kind":"person","person_id":"c