rial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-062-shiyi:line011:m0215","start":215,"end":217,"surface":"劉邵","kind":"person","person_id":"yrn_4tb_sl4","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-062-shiyi:line011","chapter_id":"c-sanguozhi-062-shiyi"}],"relations":[],"title_holdings":[{"id":"t-wu062-t-wu062-shiyi7","person_id":"yrn_4tb_sl4","kind":"office","title":"將軍","mode":"attestation","status":"source_attested","effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本句所載職官，任免時間未詳。","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-062","chapter_id":"c-sanguozhi-062-shiyi","source_id":"s-sanguozhi-062-shiyi","paragraph_id":"c-sanguozhi-062-shiyi:line011","quote":"　　是儀字子羽，北海營陵人也。本姓氏，初為縣吏，後仕郡。郡相孔融嘲儀，言\"氏\"字\"民\"無上，可改為\"是\"，乃遂改焉。後依劉繇，避亂江東。繇軍改，儀徙會稽。孫權承攝大業，優文征儀。到見親任，專典機密，拜騎都尉。呂蒙圖襲關羽，權以問儀，儀善其計，勸權聽之。從討羽，拜忠義校尉。儀陳謝，權令曰：\"孤雖非趙簡子，卿安得不自屈為周捨邪？\"既定荊州，都武昌，拜裨將軍，後封都亭侯，守侍中。欲復授兵，儀自以非材，固辭不受。黃武中，遣儀之皖就將軍劉邵，欲誘致曹休。休到，大破之，遷偏將軍，入闕省尚書事，外總平諸官，兼領辭訟，又令都諸公於書學。","person_mention_id":"c-sanguozhi-062-shiyi:line011:m0215"}],"attestations":[{"id":"t-wu062-t-wu062-shiyi7:a","paragraph_id":"c-sanguozhi-062-shiyi:line011","person_mention_id":"c-sanguozhi-062-shiyi:line011:m0215","start":213,"end":215,"surface":"將軍","usage":"narrative","date_expression":null}],"human_reviewed":false,"reviewer":"Codex（AI 代理）","model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-062-shiyi:line011","text":"　　是儀字子羽，北海營陵人也。本姓氏，初為縣吏，後仕郡。郡相孔融嘲儀，言\"氏\"字\"民\"無上，可改為\"是\"，乃遂改焉。後依劉繇，避亂江東。繇軍改，儀徙會稽。孫權承攝大業，優文征儀。到見親任，專典機密，拜騎都尉。呂蒙圖襲關羽，權以問儀，儀善其計，勸權聽之。從討羽，拜忠義校尉。儀陳謝，權令曰：\"孤雖非趙簡子，卿安得不自屈為周捨邪？\"既定荊州，都武昌，拜裨將軍，後封都亭侯，守侍中。欲復授兵，儀自以非材，固辭不受。黃武中，遣儀之皖就將軍劉邵，欲誘致曹休。休到，大破之，遷偏將軍，入闕省尚書事，外總平諸官，兼領辭訟，又令都諸公於書學。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-062-shiyi:line011:m0002","start":2,"end":4,"surface":"是儀","kind":"person","person_id":"q6j_1qg_qm2","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-062-shiyi:line011:m0005","surface":"子羽","start":5,"end":7,"kind":"person","person_id":"q6j_1qg_qm2","status":"contextual_provisional","interpretation_note":"按本段具名及前後親稱、官職定位。"},{"id":"c-sanguozhi-062-shiyi:line011:m0030","start":30,"end":32,"surface":"孔融","kind":"person","person_id":"1e4_e5b_007","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-062-shiyi:line011:m0033","start":33,"end":34,"surface":"儀","kind":"person","person_id":"q6j_1qg_qm2","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-062-shiyi:line011:m0060","start":60,"end":62,"surface":"劉繇","kind":"person","person_id":"fvd_gis_x74","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-062-shiyi:line011:m0068","start":68,"end":69,"surface":"繇","kind":"person","person_id":"fvd_gis_x74","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-062-shiyi:line011:m0072","start":72,"end":73,"surface":"儀","kind":"person","person_id":"q6j_1qg_qm2","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-062-shiyi:line011:m0077","start":77,"end":79,"surface":"孫權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-062-shiyi:line011:m0087","start":87,"end":88,"surface":"儀","kind":"person","person_id":"q6j_1qg_qm2","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-062-shiyi:line011:m0104","start":104,"end":106,"surface":"呂蒙","kind