hapter_id":"c-shiji-033-lu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji033-133","person_id":"cbr-p001262","surfaces":["季文子","文子"],"scope":"same_chapter","chapter_ids":["c-shiji-033-lu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-033-lu:p056","quote":"十五年，季文子使於晉。"},{"paragraph_id":"c-shiji-033-lu:p059","quote":"十八年，宣公卒，子成公黑肱立，是爲成公。季文子曰：『使我殺適立庶失大援者，襄仲。』襄仲立宣公，公孫歸父有寵。宣公欲去三桓，與晉謀伐三桓。會宣公卒，季文子怨之，歸父奔齊。"},{"paragraph_id":"c-shiji-033-lu:p061","quote":"十六年，宣伯告晉，欲誅季文子。文子有義，晉人弗許。"},{"paragraph_id":"c-shiji-033-lu:p064","quote":"五年，季文子卒。家無衣帛之妾，廄無食粟之馬，府無金玉，以相三君。君子曰：『季文子廉忠矣。』"},{"paragraph_id":"c-shiji-033-lu:p078","quote":"定公立，趙簡子問史墨曰：『季氏亡乎？』史墨對曰：『不亡。季友有大功於魯，受鄪爲上卿，至于文子、武子，世增其業。魯文公卒，東門遂殺適立庶，魯君於是失國政。政在季氏，於今四君矣。民不知君，何以得國！是以爲君慎器與名，不可以假人。』"}],"rationale":"按文公以後立嗣、昭公出奔、夾谷會盟、徵百牢與魯君世系的具體事件及國別暫定異稱，後期同爵稱不與先君混同。身份、匿名指代與數位疑讀待覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-033-lu:p056","text":"十五年，季文子使於晉。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-033-lu:m056-0004","start":4,"end":7,"surface":"季文子","kind":"person","person_id":"cbr-p001262","status":"contextual_provisional"}],"chapter_id":"c-shiji-033-lu","book_id":"b-shiji-033","work_id":"w-shiji","source_id":"s-shiji-033-lu"},{"id":"c-shiji-033-lu:p059","text":"十八年，宣公卒，子成公黑肱立，是爲成公。季文子曰：『使我殺適立庶失大援者，襄仲。』襄仲立宣公，公孫歸父有寵。宣公欲去三桓，與晉謀伐三桓。會宣公卒，季文子怨之，歸父奔齊。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-033-lu:m059-0004","start":4,"end":6,"surface":"宣公","kind":"person","person_id":"cbr-p001267","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m059-0009","start":9,"end":13,"surface":"成公黑肱","kind":"person","person_id":"cbr-p001270","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m059-0017","start":17,"end":19,"surface":"成公","kind":"person","pers