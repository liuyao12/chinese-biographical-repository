ily_paths":[],"mentions":[{"id":"c-liangshu-027-luxiang-complete:p002:m0139","start":139,"end":141,"surface":"傅昭","kind":"person","person_id":"jmo_mhy_5mr","status":"contextual_provisional","paragraph_id":"c-liangshu-027-luxiang-complete:p002","chapter_id":"c-liangshu-027-luxiang-complete"},{"id":"c-liangshu-030-peiziye:p004:m0099","start":99,"end":101,"surface":"傅昭","kind":"person","person_id":"jmo_mhy_5mr","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。","paragraph_id":"c-liangshu-030-peiziye:p004","chapter_id":"c-liangshu-030-peiziye"},{"start":149,"end":151,"surface":"傅昭","id":"c-nanshi-022-wanggui:p002:m0149","person_id":"jmo_mhy_5mr","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作昭。","paragraph_id":"c-nanshi-022-wanggui:p002","chapter_id":"c-nanshi-022-wanggui"}],"relations":[],"title_holdings":[{"id":"th-nanshi022-wanggui-68-143","person_id":"jmo_mhy_5mr","title":"金紫光祿大夫","kind":"office","mode":"attestation","attestations":[{"id":"th-nanshi022-wanggui-68-143:a","paragraph_id":"c-nanshi-022-wanggui:p002","start":143,"end":149,"surface":"金紫光祿大夫","person_mention_id":"c-nanshi-022-wanggui:p002:m0149","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-022","chapter_id":"c-nanshi-022-wanggui","source_id":"s-nanshi-022-wanggui-ws1477957","paragraph_id":"c-nanshi-022-wanggui:p002","quote":"天監十二年，改造太極殿畢，規獻新殿賦，其辭甚工。後為晉安王綱雲麾諮議參軍，久之，為新安太守。父憂去職，服闋，襲封南昌縣侯。除中書黃門侍郎，敕與陳郡殷芸、琅邪王錫、范陽張緬同侍東宮，俱為昭明太子所禮。湘東王繹時為丹陽尹，與朝士宴集，屬規為酒令。規從容曰：「江左以來，未有茲舉。」特進蕭琛、金紫光祿大夫傅昭在坐，並謂為知言。朱異嘗因酒卿規，規責以無禮。","person_mention_id":"c-nanshi-022-wanggui:p002:m0149"}],"status":"source_attested","interpretation_note":"本句所載官名，任期無確切年月。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-liang030-fuzhao","person_id":"jmo_mhy_5mr","surfaces":["傅昭"],"scope":"same_chapter","status":"contextual_provisional","confidence_level":"medium","identification_basis":{"kind":"source_context","target_mention_ids":["c-liangshu-030-peiziye:p004:m0099"]},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-030","source_id":"s-liang030-ws1508510","chapter_id":"c-liangshu-030-peiziye","paragraph_id":"c-liangshu-030-peiziye:p004","quote":"初，子野曾祖松之，宋元嘉中受詔續修何承天《宋史》，未及成而卒，子野常欲繼成先業。及齊永明末，沈約所撰《宋書》旣行，子野更刪撰爲《宋略》二十卷。其敘事評論多善，約見而歎曰：「吾弗逮也。」蘭陵蕭琛、北地傅昭、汝南周捨咸稱重之。至是，吏部尚書徐勉言之於高祖，以爲著作郎，掌國史及起居注。頃之，兼中書通事舍人，尋除通直正員郎，著作、舍人如故。又敕掌中書詔誥。是時西北徼外有白題及滑國，遣使由岷山道入貢。此二國歷代弗賓，莫知所出。子野曰：「漢潁陰侯斬胡白題將一人。服虔《注》云：『白題，胡名也。』又漢定遠侯擊虜，八滑從之，此其後乎。」時人服其博識。敕仍使撰《方國使圖》，廣述懷來之盛，自要服至于海表，凡二十國。"}],"rationale":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null}],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-027-luxiang-complete:p002","text":"天監三年，都官尚書范岫表薦襄，起家擢拜著作佐郎，除永寧令。秩滿，累遷司空臨川王法曹，外兵，輕車廬陵王記室參軍。昭明太子聞襄業行，啓高祖引與游處，除太子洗馬，遷中舍人，並掌管記。出爲揚州治中，襄父終此官，固辭職，高祖不許，聽與府司馬換廨居之。昭明太子敬耆老，襄母年將八十，與蕭琛、傅昭、陸杲每月常遣存問，加賜珍羞衣服。襄母嘗卒患心痛，醫方須三升粟漿，是時冬月，日又逼暮，求索無所。忽有老人詣門貨漿，量如方劑，始欲酬直，無何失之，時以襄孝感所致也。累遷國子博士，太子家令，復掌管記，母憂去職。襄年已五十，毀頓過禮，太子憂之，日遣使誡喻。服闋，除太子中庶子，復掌管記。中大通三年，昭明太子薨，官屬罷，妃蔡氏別居金華宮，以襄爲中散大夫、領步兵校尉、金華宮家令、知金華宮事。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":63,"last_line":63,"raw_start":4302,"raw_end":4648,"raw_character_offsets":[4307,4308,4309,4310,4313,4314,4315,4316,4317,4318,4319,4320,4321,4322,4323,4324,4325,4326,4327,4328,4329,4330,4331,4332,4333,4334,4335,4336,4337,4338,4339,4340,4341,4342,4343,4344,4345,4346,4347,4348,4349,4350,4351,4352,4353,4354,4355,4356,4357,4358,4359,4360,4361,4362,4363,4364,4365,4366,4367,4368,4369,4370,4371,4372,4373,4374,4375,4376,4377,4378,4379,4380,4381,4382,4383,4384,4385,4386,4387,4388,4389,4390,43