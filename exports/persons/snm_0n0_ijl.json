其利，姦吏并侵漁，於是痛繩以罪。則自公卿以下，至於庶人，咸指湯。湯嘗病，天子至自視病，其隆貴如此。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-122-kuli:m018-0001","start":1,"end":3,"surface":"渾邪","kind":"person","person_id":"snm_0n0_ijl","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m018-0038","start":38,"end":39,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m018-0057","start":57,"end":61,"surface":"富商大賈","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m018-0083","start":83,"end":84,"surface":"湯","kind":"person","person_id":"1ex_se1_yef_A","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m018-0097","start":97,"end":99,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m018-0102","start":102,"end":104,"surface":"丞相","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m018-0114","start":114,"end":115,"surface":"湯","kind":"person","person_id":"1ex_se1_yef_A","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m018-0136","start":136,"end":138,"surface":"姦吏","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m018-0151","start":151,"end":153,"surface":"公卿","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m018-0163","start":163,"end":164,"surface":"湯","kind":"person","person_id":"1ex_se1_yef_A","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m018-0165","start":165,"end":166,"surface":"湯","kind":"person","person_id":"1ex_se1_yef_A","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m018-0169","start":169,"end":171,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"}],"chapter_id":"c-shiji-122-kuli","book_id":"b-shiji-122","work_id":"w-shiji","source_id":"s-shiji122-kuli"}],"sources":[{"chapter_id":"c-shiji-