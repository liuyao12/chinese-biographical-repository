},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-058-southern-and-eastern-complete:p024:m0009","start":9,"end":11,"surface":"范稚","kind":"person","person_id":"hua_ybo_1c4","status":"contextual_provisional","paragraph_id":"c-nanqishu-058-southern-and-eastern-complete:p024","chapter_id":"c-nanqishu-058-southern-and-eastern-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-058-southern-and-eastern-complete:p024","text":"晉建興中，日南夷帥范稚奴文數商賈，見上國制度，教林邑王范逸起城池樓殿。王服天冠如佛冠，身被香纓絡。國人凶悍，習山川，善鬬。吹海蠡為角。人皆裸露。四時暄暖，無霜雪。貴女賤男，謂師君為婆羅門。羣從相姻通，婦先遣娉求婿。女嫁者，迦藍衣橫幅合縫如井闌，首戴花寶。婆羅門牽婿與婦握手相付，呪願吉利。居喪剪髮，謂之孝。燔尸中野以為葬。遠界有靈鷲鳥，知人將死，集其家食死人肉盡，飛去，乃取骨燒灰投海中水葬。人色以黑為美，南方諸國皆然。區栗城建八尺表，日影度南八寸。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":66,"last_line":66,"raw_start":4621,"raw_end":4881,"raw_character_offsets":[4621,4622,4623,4624,4625,4626,4627,4628,4629,4630,4631,4632,4633,4634,4635,4636,4637,4638,4639,4640,4641,4642,4643,4644,4645,4646,4647,4648,4649,4650,4651,4652,4653,4654,4655,4656,4657,4658,4659,4660,4661,4662,4663,4664,4665,4666,4667,4668,4669,4670,4671,4672,4673,4674,4675,4676,4677,4678,4679,4680,4681,4682,4683,4684,4685,4686,4687,4688,4689,4690,4691,4692,4693,4694,4695,4696,4697,4698,4699,4700,4701,4702,4703,4704,4705,4706,4707,4708,4709,4710,4711,4712,4713,4714,4750,4751,4752,4753,4754,4755,4756,4757,4758,4759,4760,4761,4762,4763,4764,4765,4766,4767,4768,4769,4770,4771,4772,4773,4774,4775,4776,4777,4778,4779,4780,4781,4782,4783,4784,4785,4786,4787,4788,4789,4790,4791,4792,4793,4794,4