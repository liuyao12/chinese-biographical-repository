"c-jinshu-067-xijian:line070:m0211"],"kind":"paragraph"},{"canonical_mention_id":"c-jinshu-067-xijian:line070:m0235","mention_ids":["c-jinshu-067-xijian:line070:m0235"],"kind":"paragraph"},{"canonical_mention_id":"c-jinshu-067-xijian:line070:m0278","mention_ids":["c-jinshu-067-xijian:line070:m0278"],"kind":"paragraph"},{"canonical_mention_id":"c-jinshu-067-xijian:line070:m0297","mention_ids":["c-jinshu-067-xijian:line070:m0297"],"kind":"paragraph"}],"mention_count":4,"duplicate_mention_count":0,"paragraph_occurrence_count":4,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"4處獨立位置，4個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-067-xijian"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-067-xijian:line070:m0211","start":211,"end":213,"surface":"陳午","kind":"person","person_id":"dcs_ymm_847","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-067-xijian:line070","chapter_id":"c-jinshu-067-xijian"},{"id":"c-jinshu-067-xijian:line070:m0235","start":235,"end":236,"surface":"午","kind":"person","person_id":"dcs_ymm_847","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-067-xijian:line070","chapter_id":"c-jinshu-067-xijian"},{"id":"c-jinshu-067-xijian:line070:m0278","start":278,"end":279,"surface":"午","kind":"person","person_id":"dcs_ymm_847","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-067-xijian:line070","chapter_id":"c-jinshu-067-xijian"},{"id":"c-jinshu-067-xijian:line070:m0297","start":297,"end":298,"surface":"午","kind":"person","person_id":"dcs_ymm_847","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-067-xijian:line070","chapter_id":"c-jinshu-067-xijian"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-067-xijian:line070","text":"郗鑒，字道徽，高平金鄉人，漢御史大夫慮之玄孫也。少孤貧，博覽經籍，躬耕隴畝，吟詠不倦。以儒雅著名，不應州命。趙王倫辟為掾，知倫有不臣之迹，稱疾去職。及倫篡，其黨皆至大官，而鑒閉門自守，不染逆節。惠帝反正，參司空軍事，累遷太子中舍人、中書侍郎。東海王越辟為主簿，舉賢良，不行。征東大將軍苟晞檄為從事中郎。晞與越方以力爭，鑒不應其召。從兄旭，晞之別駕，恐禍及己，勸之赴召，鑒終不廻，晞亦不之逼也。及京師不守，寇難鋒起，鑒遂陷於陳午賊中。邑人張實先求交於鑒，鑒不許。至是，實於午營來省鑒疾，既而卿鑒。鑒謂實曰：「相與邦壤，義不及通，何可怙亂至此邪！」實大慙而退。午以鑒有名於世，將逼為主，鑒逃而獲免。午尋潰散，鑒得歸鄉里。于時所在饑荒，州中之士素有感其恩義者，相與資贍。鑒復分所得，以賉宗族及鄉曲孤老，賴而全濟者甚多，咸相謂曰：「今天子播越，中原無伯，當歸依仁德，可以後亡。」遂共推鑒為主，舉千餘家俱避難於魯之嶧山。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-067-xijian:line070:m0000","start":0,"end":2,"surface":"郗鑒","kind":"person","person_id":"6lr_zci_i0j","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-xijian:line070:m0004","start":4,"end":6,"surface":"道徽","kind":"person","person_id":"6lr_zci_i0j","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-xijian:line070:m0018","start":18,"end":19,"surface":"慮","kind":"person","person_id":"66f_b00_777","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-xijian:line070:m0054","start":54,"end":57,"surface":"趙王倫","kind":"person","person_id":"dkn_ge4_286_AAAAG","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id"