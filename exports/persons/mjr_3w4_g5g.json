{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"mjr_3w4_g5g","canonical_person_id":"mjr_3w4_g5g","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["mjr_3w4_g5g"],"persons":[{"id":"mjr_3w4_g5g","label":"董洪","status":"active","historicity":"historical_tradition","aliases":[{"surface":"董洪","mention_ids":["c-jinshu-059-prince-ying:p003:m0076"]}],"evidence":[{"mention_id":"c-jinshu-059-prince-ying:p003:m0076","paragraph_id":"c-jinshu-059-prince-ying:p003","chapter_id":"c-jinshu-059-prince-ying","quote":"董洪"}],"review":"ai_provisional","identity_note":"董洪，見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-jinshu-059-prince-ying-ws2650517","work_id":"w-jinshu","book_id":"b-jinshu-059","chapter_id":"c-jinshu-059-prince-ying","raw_mention_count":1,"mention_ids":["c-jinshu-059-prince-ying:p003:m0076"],"paragraph_ids":["c-jinshu-059-prince-ying:p003"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-059-prince-ying:p003:m0076","mention_ids":["c-jinshu-059-prince-ying:p003:m0076"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-059-prince-ying-ws2650517"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-059-prince-ying:p003:m0076","surface":"董洪","start":76,"end":78,"person_id":"mjr_3w4_g5g","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-059-prince-ying:p003","chapter_id":"c-jinshu-059-prince-ying"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-059-prince-ying:p003","text":"至鄴，詔遣兼太尉王粹加九錫殊禮，進位大將軍、都督中外諸軍事、假節、加黃鉞、錄尚書事，入朝不趨，劍履上殿。穎拜受徽號，讓殊禮九錫，表論興義功臣盧志、和演、董洪、王彥、趙驤等五人，皆封開國公侯。又表稱：「大司馬前在陽翟，與強賊相持既久，百姓創痍，饑餓凍餒，宜急振救。乞差發郡縣車，一時運河北邸閣米十五萬斛，以振陽翟饑人。」盧志言於穎曰：「黃橋戰亡者有八千餘人，既經夏暑，露骨中野，可為傷惻。昔周王葬枯骨，故《詩》云'行有死人，尚或墐之'。況此等致死王事乎！」穎乃造棺八千餘枚，以成都國秩為衣服，斂祭，葬于黃橋北，樹枳籬為之塋域。又立都祭堂，刊石立碑，紀其赴義之功，使亡者之家四時祭祀有所。仍表其門閭，加常戰亡二等。又命河內溫縣埋藏趙倫戰死士卒萬四千餘人。穎形美而神昏，不知書，然器性敦厚，委事於志，故得成其美焉。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":153,"last_line":153,"raw_start":15207,"raw_end":15608,"raw_character_offsets":[15209,15210,15211,15212,15213,15214,15215,15216,15217,15218,15219,15220,15221,15222,15223,15224,15225,15226,15227,15228,15229,15230,15231,15232,15233,15234,15235,15236,15237,15238,15239,15240,15241,15242,15243,15244,15245,15246,15247,15248,15249,15250,15251,15252,15253,15254,15255,15256,15257,15258,15259,15260,15261,15262,15263,15264,15265,15266,15267,15268,15269,15270,15271,15272,15273,15274,15275,15276,15277,15278,15279,15280,15281,15282,15283,15284,15285,15286,15287,15288,15289,15290,15291,15292,15293,15294,15295,15296,15297,15298,15299,15300,15301,15302,15303,15304,15305,15306,15307,15308,15309,15310,15311,15312,15313,15314,15315,15316,15317,15318,15319,15320,15321,15322,15323,15324,15325,15326,15327,15328,15329,15330,15331,15332,15333,15334,15335,15336,15337,15338,15339,15340,15341,15342,15343,15344,15345,15346,15347,15348,15349,15350,15351,15352,15353,15354,15