,"surface":"飛","kind":"person","person_id":"40u_3wl_uoa","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-055-ganning:line074-pei01-01","chapter_id":"c-sanguozhi-055-ganning"},{"id":"c-sanguozhi-055-ganning:line074-pei01-01:m0072","start":72,"end":73,"surface":"飛","kind":"person","person_id":"40u_3wl_uoa","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-055-ganning:line074-pei01-01","chapter_id":"c-sanguozhi-055-ganning"},{"id":"c-sanguozhi-055-ganning:line074-pei01-01:m0081","start":81,"end":82,"surface":"飛","kind":"person","person_id":"40u_3wl_uoa","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-055-ganning:line074-pei01-01","chapter_id":"c-sanguozhi-055-ganning"},{"id":"c-sanguozhi-055-ganning:line074-pei01-01:m0100","start":100,"end":101,"surface":"飛","kind":"person","person_id":"40u_3wl_uoa","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-055-ganning:line074-pei01-01","chapter_id":"c-sanguozhi-055-ganning"},{"id":"c-sanguozhi-055-ganning:line074-pei01-01:m0141","start":141,"end":142,"surface":"飛","kind":"person","person_id":"40u_3wl_uoa","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-055-ganning:line074-pei01-01","chapter_id":"c-sanguozhi-055-ganning"}],"relations":[],"title_holdings":[{"id":"t-wu055-t-wu055-ganning3","person_id":"40u_3wl_uoa","kind":"office","title":"都督","mode":"attestation","status":"source_attested","effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本句所載職官，任免時間未詳。","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-055","chapter_id":"c-sanguozhi-055-ganning","source_id":"s-sanguozhi-055-ganning","paragraph_id":"c-sanguozhi-055-ganning:line072-pei03-01","quote":"《吳書》曰：寧將僮客八百人就劉表。表儒人，不習軍事。時諸英豪各各起兵，寧觀表事勢，終必無成，恐一朝土崩，并受其禍，欲東入吳。黃祖在夏口，軍不得過，乃留依祖，三年不禮之。權討祖，祖軍敗奔走，追兵急，寧以善射，將兵在後，射殺校尉凌操。祖旣得免，軍罷還營，待寧如初。祖都督蘇飛數薦寧，祖不用，令人化誘其客，客稍亡。寧欲去，恐不獲免，獨憂悶不知所出。飛知其意，乃要寧，爲之置酒，謂曰：「吾薦子者數矣，主不能用。日月逾邁，人生幾何，宜自遠圖，庶遇知己。」寧良久乃曰：「雖有其志，未知所由。」飛曰：「吾欲白子爲邾長，於是去就，孰與臨阪轉丸乎？」寧曰：「幸甚。」飛白祖，聽寧之縣。招懷亡客并義從者，得數百人。","person_mention_id":"c-sanguozhi-055-ganning:line072-pei03-01:m0133"}],"attestations":[{"id":"t-wu055-t-wu055-ganning3:a","paragraph_id":"c-sanguozhi-055-ganning:line072-pei03-01","person_mention_id":"c-sanguozhi-055-ganning:line072-pei03-01:m0133","start":131,"end":133,"surface":"都督","usage":"narrative","date_expression":null}],"human_reviewed":false,"reviewer":"Codex（AI 代理）","model":null}],"address_assertions":[],"person_references":[{"id":"c-sanguozhi-055-ganning:line072-pei03-01:r0189","paragraph_id":"c-sanguozhi-055-ganning:line072-pei03-01","start":189,"end":190,"surface":"吾","person_id":"40u_3wl_uoa","referent_role":"speaker_self","quote":"置酒，謂曰：「吾薦子者數矣，主","note":"依對話說話者、受書者及上下句定位。","chapter_id":"c-sanguozhi-055-ganning","book_id":"b-sanguozhi-055","work_id":"w-sanguozhi","source_id":"s-sanguozhi-055-ganning"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-055-ganning:line072-pei03-01","text":"《吳書》曰：寧將僮客八百人就劉表。表儒人，不習軍事。時諸英豪各各起兵，寧觀表事勢，終必無成，恐一朝土崩，并受其禍，欲東入吳。黃祖在夏口，軍不得過，乃留依祖，三年不禮之。權討祖，祖軍敗奔走，追兵急，寧以善射，將兵在後，射殺校尉凌操。祖旣得免，軍罷還營，待寧如初。祖都督蘇飛數薦寧，祖不用，令人化誘其客，客稍亡。寧欲去，恐不獲免，獨憂悶不知所出。飛知其意，乃要寧，爲之置酒，謂曰：「吾薦子者數矣，主不能用。日月逾邁，人生幾何，宜自遠圖，庶遇知己。」寧良久乃曰：「雖有其志，未知所由。」飛曰：「吾欲白子爲邾長，於是去就，孰與臨阪轉丸乎？」寧曰：「幸甚。」飛白祖，聽寧之縣。招懷亡客并義從者，得數百人。","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-055-ganning:line072-pei03-01:m0006","start":6,"end":7,"surface":"寧","kind":"person","person_id":"vew_yxo_3j1","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-055-ganning:line072-pei03-01:m0014","start":14,"end":16,