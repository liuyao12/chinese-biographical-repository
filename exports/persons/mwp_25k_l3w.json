_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin057-volume-teng-bing","subject_person_id":"mwp_25k_l3w","object_person_id":"8zw_lx6_9le","predicate":"father","qualifiers":{"source_term":"修之子並"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-057","chapter_id":"c-jinshu-057-teng-xiu","source_id":"s-jinshu-057-teng-xiu-ws2413329","paragraph_id":"c-jinshu-057-teng-xiu:p002","quote":"太康九年卒，請葬京師，帝嘉其意，賜墓田一頃，諡曰聲。修之子並上表曰：「亡父修羈絏吳壤，為所驅馳；幸逢開通，沐浴至化，得從俘虜握戎馬之要；未覲聖顏，委南籓之重，實由勳勞少聞天聽故也。年衰疾篤，屢乞骸骨，未蒙垂哀，奄至薨隕。臣承遺意，輿櫬還都，瞻望雲闕，實懷痛裂。竊聞博士諡修曰聲，直彰流播，不稱行績，不勝愚情，冒昧聞訴。」帝乃賜諡曰忠。","subject_person_mention_id":"c-jinshu-057-teng-xiu:p002:m0029","object_person_mention_id":"c-jinshu-057-teng-xiu:p002:m0037"}],"status":"source_attested","interpretation_note":"上表自稱亡父修，下文並子含可核人名。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"a-jin057-volume-teng-han","subject_person_id":"9ef_a32_155","object_person_id":"mwp_25k_l3w","predicate":"father","qualifiers":{"source_term":"並子含"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-057","chapter_id":"c-jinshu-057-teng-xiu","source_id":"s-jinshu-057-teng-xiu-ws2413329","paragraph_id":"c-jinshu-057-teng-xiu:p003","quote":"並子含，初為庾冰輕車長史，討蘇峻有功，封夏陽縣開國侯，邑千六百戶，授平南將軍、廣州刺史。在任積年，甚有威惠，卒諡曰戴。含弟子遁，交州刺史。","subject_person_mention_id":"c-jinshu-057-teng-xiu:p003:m0002","object_person_mention_id":"c-jinshu-057-teng-xiu:p003:m0000"}],"status":"source_attested","interpretation_note":"並為上文請改諡的滕修之子。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_confl