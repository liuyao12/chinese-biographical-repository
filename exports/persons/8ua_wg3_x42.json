pter_id":"c-songshu-092-duyuan-jiaozhou"},{"id":"c-songshu-092-duyuan-jiaozhou:p001:m0079","start":79,"end":81,"surface":"遯之","kind":"person","person_id":"8ua_wg3_x42","status":"contextual_provisional","paragraph_id":"c-songshu-092-duyuan-jiaozhou:p001","chapter_id":"c-songshu-092-duyuan-jiaozhou"},{"id":"c-songshu-092-duyuan-jiaozhou:p001:m0095","start":95,"end":97,"surface":"遯之","kind":"person","person_id":"8ua_wg3_x42","status":"contextual_provisional","paragraph_id":"c-songshu-092-duyuan-jiaozhou:p001","chapter_id":"c-songshu-092-duyuan-jiaozhou"},{"id":"c-songshu-092-duyuan-jiaozhou:p001:m0126","start":126,"end":128,"surface":"遯之","kind":"person","person_id":"8ua_wg3_x42","status":"contextual_provisional","paragraph_id":"c-songshu-092-duyuan-jiaozhou:p001","chapter_id":"c-songshu-092-duyuan-jiaozhou"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-songshu-092-duyuan-jiaozhou:p001","text":"父瑗字道言，仕州府為日南、九德、交阯太守。初，九真太守李遜父子勇壯有權力，威制交土，聞刺史滕遯之當至，分遣二子斷遏水陸津要，瑗收眾斬遜，州境獲寧。除龍驤將軍。遯之在州十餘年，與林邑累相攻伐。遯之將北還，林邑王范胡達攻破日南、九德、九真三郡，遂圍州城。時遯之去已遠，瑗與第三子玄之悉力固守，多設權策，累戰，大破之。追討於九真、日南，連捷，故胡達走還林邑。乃以瑗為龍驤將軍、交州刺史。義旗進號冠軍將軍。盧循竊據廣州，遣使通好，瑗斬之。義熙六年，年八十四，卒，追贈右將軍，本官如故。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":19,"last_line":19,"raw_start":1425,"raw_end":1699,"raw_character_offsets":[1425,1426,1427,1428,1429,1430,1431,1432,1433,1434,1435,1436,1437,1438,1439,1440,1441,1442,1443,1444,1445,1446,1447,1448,1449,1450,1451,1452,1453,1454,1455,1456,1457,1458,1459,1460,1461,1462,1463,1464,1465,1466,1467,1468,1469,1470,1471,1472,1473,1474,1475,1512,1513,1514,1515,1516,1517,1518,1519,1520,1521,1522,1523,1524,1525,1526,1527,1528,1529,1530,1531,1532,1533,1534,1535,1536,1537,1538,1539,1540,1541,1542,1543,1544,1545,1546,1547,1548,1549,1550,1551,1552,1553,1554,1555,1556,15