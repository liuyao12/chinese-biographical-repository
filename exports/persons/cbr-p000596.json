ontextual_provisional"},{"id":"c-shiji-006-shihuang:p060:m0461","start":461,"end":462,"surface":"劫","kind":"person","person_id":"cbr-p000609","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p060:m0469","start":469,"end":471,"surface":"去疾","kind":"person","person_id":"cbr-p000596","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p060:m0472","start":472,"end":473,"surface":"劫","kind":"person","person_id":"cbr-p000609","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p060:m0485","start":485,"end":486,"surface":"斯","kind":"person","person_id":"cbr-p000537","status":"contextual_provisional"}],"chapter_id":"c-shiji-006-shihuang","book_id":"b-shiji-006","work_id":"w-shiji","source_id":"s-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:p110","text":"始皇既歿，胡亥極愚，酈山未畢，復作阿房，以遂前策。云「凡所為貴有天下者，肆意極欲，大臣至欲罷先君所為」。誅斯、去疾，任用趙高。痛哉言乎！人頭畜鳴。不威不伐惡，不篤不虛亡，距之不得留，殘虐以促期，雖居形便之國，猶不得存。","annotation_status":"named_mentions_first_pass","text_layer":"witness_appended_bangu_note","mentions":[{"id":"c-shiji-006-shihuang:p110:m0000","start":0,"end":2,"surface":"始皇","kind":"person","person_id":"cbr-p000533","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p110:m0005","start":5,"end":7,"surface":"胡亥","kind":"person","person_id":"cbr-p000534","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p110:m0053","start":53,"end":54,"surface":"斯","kind":"person","person_id":"cbr-p000537","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p110:m0055","start":55,"end":57,"surface":"去疾","kind":"person","person_id":"cbr-p000596","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p110:m0060","start":60,"end":62,"surface":"趙高","kind":"person","person_id":"cbr-p000535","status":"contextual_provisional"}],"chapter_id":"c-shiji-006-shihuang","book_id":"b-shiji-006","work_id":"w-shiji","source_id":"s-shiji-006-shihuang"}],"sources":[{"chapter_id":"c-shiji-006-shihuang","work_id":"w-shiji","book_id":"b-shiji-006","source_id":"s-shiji-006-