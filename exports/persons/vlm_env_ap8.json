"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-129-huozhi:p011","text":"烏氏倮牧，及眾，斥賣，求奇繒物，閒獻遺戎王。戎王什倍其償，與之畜，畜至用谷量馬牛。秦始皇帝令倮比封君，以時與列臣朝請。而巴[蜀]寡婦清，其先得丹穴，而擅其利數世，家亦不訾。清，寡婦也，能守其業，用財自衛，不見侵犯。秦皇帝以為貞婦而客之，為筑女懷清臺。夫倮鄙人牧長，清窮鄉寡婦，禮抗萬乘，名顯天下，豈非以富邪？","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-129-huozhi:m011-0000","start":0,"end":3,"surface":"烏氏倮","kind":"person","person_id":"vlm_env_ap8","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m011-0019","start":19,"end":21,"surface":"戎王","kind":"person","person_id":"vzn_byk_trr","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m011-0022","start":22,"end":24,"surface":"戎王","kind":"person","person_id":"vzn_byk_trr","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m011-0041","start":41,"end":45,"surface":"秦始皇帝","kind":"person","person_id":"vjl_m0n_9pl","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m011-0046","start":46,"end":47,"surface":"倮","kind":"person","person_id":"vlm_env_ap8","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m011-0066","start":66,"end":67,"surface":"清","kind":"person","person_id":"jat_ll3_qk6","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m011-0068","start":68,"end":70,"surface":"其先","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-129-huozhi:m011-0086","start":86,"end":87,"surface":"清","kind":"person","person_id":"jat_ll3_qk6","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m011-0107","start":107,"end":110,"surface":"秦皇帝","kind":"person","person_id":"vjl_m0n_9pl","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m011-0126","start":126,"end":127,"surface":"倮","kind":"person","person_id":"vlm_env_ap8","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m011-0132","start":132,"end":133,"surface":"清","kind":"person","person_id":"jat_ll3_qk6","status":"contextual_provisional"}],"chapter_id":"c-shiji-129-huozhi","book_id":"b-shiji-129","work_id":"w-shiji","source_id":"s-shiji129-huozhi"},{"id":"c-shiji-129-huozhi:p043","text":"貨殖之利，工商是營。廢居善積，倚巿邪贏。白圭富國，計然強兵。倮參朝請，女築懷清。素封千戶，卓鄭齊名。","annotation_status":"in_progress","text_layer":"witness_appended_suoyin_zan","mentions":[{"id":"c-shiji-129-huozhi:m043-0020","start":20,"end":22,"surface":"白圭","kind":"person","person_id":"evw_7hk_sqo","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m043-0025","start":25,"end":27,"surface":"計然","kind":"person","person_id":"mge_pi9_fn1","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m043-0030","start":30,"end":31,"surface":"倮","kind":"person","person_id":"vlm_env_ap8","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m043-0035","start":35,"end":36,"surface":"女","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-129-huozhi:m043-0045","start":45,"end":47,"surface":"卓鄭","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-129-huozhi","book_id":"b-shiji-129","work_id":"w-shiji","source_id":"s-shiji129-huozhi"}],"sources":[{"chapter_id":"c-shiji-129-huozhi","work_id":"w-shiji","book_id":"b-shiji-129","source_id":"s-shiji129-huozhi","source":{"title":"史記／卷129","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷129","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷129&oldid=7904128","revision_id":7904128,"accessed_on":"2026-10-11","extent":"固定修訂全文43段，篇文42段、索隱述贊1段。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"去header2、現代節標及索隱述贊層次標籤；保留巴[蜀]、（孝）［德］等來源校讀括號，未核影像。","note":"文獻校讀不當已校定字，氏稱與家族表述逐段分辨。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"c