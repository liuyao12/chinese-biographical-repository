hu-059-prince-yue-ws2650517"},{"id":"c-jinshu-059-prince-yue:p005","text":"尋詔越為丞相，領兗州牧，督兗、豫、司、冀、幽、并六州。越辭丞相不受，自許遷於鄄城。越恐清河王覃終為儲副，矯詔收付金墉城，尋害之。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":191,"last_line":191,"raw_start":19875,"raw_end":19941,"raw_character_offsets":[19877,19878,19879,19880,19881,19882,19883,19884,19885,19886,19887,19888,19889,19890,19891,19892,19893,19894,19895,19896,19897,19898,19899,19900,19901,19902,19903,19904,19905,19906,19907,19908,19909,19910,19911,19912,19913,19914,19915,19916,19917,19918,19919,19920,19921,19922,19923,19924,19925,19926,19927,19928,19929,19930,19931,19932,19933,19934,19935,19936,19937,19938,19939,19940],"revision_id":2650517},"mentions":[{"id":"c-jinshu-059-prince-yue:p005:m0002","surface":"越","start":2,"end":3,"person_id":"9o2_vhv_r7y","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-yue:p005:m0027","surface":"越","start":27,"end":28,"person_id":"9o2_vhv_r7y","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-yue:p005:m0041","surface":"越","start":41,"end":42,"person_id":"9o2_vhv_r7y","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-yue:p005:m0043","surface":"清河王覃","start":43,"end":47,"person_id":"2tx_lqb_26u","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-059-prince-yue","book_id":"b-jinshu-059","work_id":"w-jinshu","source_id":"s-jinshu-059-prince-yue-ws2650517"},{"id":"c-jinshu-060-zhangfang:p002","text":"蕩陰之役，顒又遣方鎮洛陽，上官已、苗願等距之，大敗而退。清河王覃夜襲已、願，已、願出奔，方乃入洛陽。覃于廣陽門迎方而拜，方馳下車扶止之。於是復廢皇后羊氏。及帝自鄴還洛，方遣息羆以三千騎奉迎。將渡河橋，方又以所乘陽燧車、青蓋素升三百人為小鹵簿，迎帝至芒山下。方自帥萬餘騎奉雲母輿及旌旗之飾，衛帝而進。初，方見帝將拜，帝下車自止之。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":81,"last_line":81,"raw_start":6848,"raw_end":7014,"raw_character_offsets":[6850,6851,6852,6853,6854,6855,6856,6857,6858,6859,6860,6861,6862,6863,6864,6865,6866,6867,6868,6869,6870,6871,6872,6873,6874,6875,6876,6877,6878,6879,6880,6881,6882,6883,6884,6885,6886,6887,6888,6889,6890,6891,6892,6893,6894,6895,6896,6897,6898,6899,6900,6901,6902,6903,6904,6905,6906,6907,6908,6909,6910,6911,6912,6913,6914,6915,6916,6917,6918,6919,6920,6921,6922,6923,6924,6925,6926,6927,6928,6929,6930,6931,6932,6933,6934,6935,6936,6937,6938,6939,6940,6941,6942,6943,6944,6945,6946,6947,6948,6949,6950,6951,6952,6953,6954,6955,6956,6957,6958,6959,6960,6961,6962,6963,6964,6965,6966,6967,6968,6969,6970,6971,6972,6973,6974,6975,6976,6977,6978,6979,6980,6981,6982,6983,6984,6985,6986,6987,6988,6989,6990,6991,6992,6993,6994,6995,6996,6997,6998,6999,7000,7001,7002,7003,7004,7005,7006,7007,7008,7009,7010,7011,7012,7013],"revision_id":2413335},"mentions":[{"id":"c-jinshu-060-zhangfang:p002:m0005","surface":"顒","start":5,"end":6,"person_id":"ed0_313_bea","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfang:p002:m0008","surface":"方","start":8,"end":9,"person_id":"eti_fp9_fq5","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfang:p002:m0013","surface":"上官已","start":13,"end":16,"person_id":"j42_q6m_ymn","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfang:p002:m0017","surface":"苗願","start":17,"end":19,"person_id":"gid_c8t_usv","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfang:p002:m0028","surface":"清河王覃","start":28,"end":32,"person_id":"2tx_lqb_26u","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfang:p002:m0034","surface":"已","start":34,"end":35,"person_id":"j42_q6m_ymn","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfang:p002:m0036","surface":"願","start":36,"end":37,"person_id":"gid_c8t_usv","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfang:p002:m0038","surface":"已","start":38,"end":39,"person_id":"j42_q6m_ymn","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfang:p002:m0044","surface":"方","start":44,"end":45,"person_id":"eti_fp9_fq5","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfang:p002:m0050","surface":"覃","start":50,"end":51,"person_id":"2tx_lqb_26u","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfang:p002:m0056","surface":"方","start":56,"end":57,"person_id":"eti_fp9_fq5","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfang:p002:m0060","surface":"方","start":60,"end":61,"person_id":"eti_fp9_fq5","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfang:p002:m0072","surface":"皇后羊氏","start":72,"end":76,"person_id":"zyv_z7m_5o6","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfang:p002:m0084","surface":"方","start":84,"end":85,"person_id":"eti_fp9_fq5","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfang:p002:m0087","surface":"羆","start":87,"end":88,"person_id":"aa6_1w4_hbl","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfang:p002:m0100","surface":"方","start":100,"end":101,"person_id":"eti_fp9_fq5","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfang:p002:m0128","surface":"方","start":128,"end":129,"person_id":"eti_fp9_fq5","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-060-zhangfang:p002:m0151","surface":"方","start":151,"end":152,"person_id":"eti_fp9_fq5","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-060-zhangfang","book_id":"b-jinshu-060","work_id":"w-jinshu","source_id":"s-jinshu-060-zhangfang-ws2413335"},{"id":"c-jinshu-061-zhou-family:p021","text":"惠帝幸鄴，成都王穎以馥守河南尹。陳眕、上官已等奉清河王覃為太子，加馥衛將軍、錄尚書，馥辭不受。覃令馥與上官已合軍，馥認已小人縱暴，終為國賊，乃共司隸滿奮等謀共除之，謀泄，為已所襲，奮被害，馥走得免。及已為張方所敗，召馥還攝河南尹。暨東海王越迎大駕，以馥為中領軍，未就，遷司隸校尉，加散騎常侍、假節，都督諸軍事于澠池。帝還宮，出為平東將軍、都督揚州諸軍事，代劉准為鎮東將軍，與周玘等討陳敏，滅之，以功封永甯伯。","source_position":{"raw_start":3436,"raw_end":3642,"raw_text":"　　惠帝幸鄴，成都王穎以馥守河南尹。陳眕、上官已等奉清河王覃為太子，加馥衛將軍、錄尚書，馥辭不受。覃令馥與上官已合軍，馥認已小人縱暴，終為國賊，乃共司隸滿奮等謀共除之，謀泄，為已所襲，奮被害，馥走得免。及已為張方所敗，召馥還攝河南尹。暨東海王越迎大駕，以馥為中領軍，未就，遷司隸校尉，加散騎常侍、假節，都督諸軍事于澠池。帝還宮，出為平東將軍、都督揚州諸軍事，代劉准為鎮東將軍，與周玘等討陳敏，滅之，以功封永甯伯。","display_wrapper_start":0,"display_wrapper_end":0,"raw_path":"sources/jinshu/wikisource-7903772-raw.wikitext"},"mentions":[{"id":"c-jinshu-061-zhou-family:p021:m0000","start":0,"end":2,"surface":"惠帝","kind":"person","person_id":"7e0_f69_1ac","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p021:m0005","start":5,"end":9,"surface":"成都王穎","kind":"person","person_id":"e81_f09_000","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p021:m0010","start":10,"end":11,"surface":"馥","kind":"person","person_id":"3xx_gdy_or6_BA","status":"contextual_provisional","interpretation_note":"076王廙元帝鎮江左、討周馥脈絡與本段相合；不是只從單字馥匹配韓馥。"},{"id":"c-jinshu-061-zhou-family:p021:m0016","start":16,"end":18,"surface":"陳眕","kind":"person","person_id":"p1n_kla_0x7","status":"contextual_provisional","interpretation_note":"兩固定數位見證同一清河王太子事件，姓氏相異，原字不改；暫不裁定名姓。"},{"id":"c-jinshu-061-zhou-family:p021:m0019","start":19,"end":22,"surface":"上官已","kind":"person","person_id":"j42_q6m_ymn","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p021:m0024","start":24,"end":28,"surface":"清河王覃","kind":"person","person_id":"2tx_lqb_26u","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p021:m0033","start":33,"end":34,"surface":"馥","kind":"person","person_id":"3xx_gdy_or6_BA","status":"contextual_provisional","interpretation_note":"076王廙元帝鎮江左、討周馥脈絡與本段相合；不是只從單字馥匹配韓馥。"},{"id":"c-jinshu-061-zhou-family:p021:m0042","start":42,"end":43,"surface":"馥","kind":"person","person_id":"3xx_gdy_or6_BA","status":"contextual_provisional","interpretation_note":"076王廙元帝鎮江左、討周馥脈絡與本段相合；不是只從單字馥匹配韓馥。"},{"id":"c-jinshu-061-zhou-family:p021:m0047","start":47,"end":48,"surface":"覃","kin