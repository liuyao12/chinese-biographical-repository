ed_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-080-wangxizhi-comparison:p027:m0279","start":279,"end":280,"surface":"母","kind":"person","person_id":"pag_yop_hef","status":"contextual_provisional","interpretation_note":"依完整所選數位比較傳文與此處角色判讀；未圖校，非武英殿底本認證。","paragraph_id":"c-jinshu-080-wangxizhi-comparison:p027","chapter_id":"c-jinshu-080-wangxizhi-comparison"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-080-wangxizhi-comparison:p027","text":"時驃騎將軍王述少有名譽，與羲之齊名，而羲之甚輕之，由是情好不協。述先為會稽，以母喪居郡境，羲之代述，止一吊，遂不重詣。述每聞角聲，謂羲之當候己，輒灑掃而待之。如此者累年，而羲之竟不顧，述深以為恨。及述為揚州刺史，將就征，周行郡界，而不過羲之，臨發，一別而去。先是，羲之常謂賓友曰：「懷祖正當作尚書耳，投老可得僕射。更求會稽，便自邈然。」及述蒙顯授，羲之恥為之下，遣使詣朝廷，求分會稽為越州。行人失辭，大為時賢所笑。既而內懷愧歎，謂其諸子曰：「吾不減懷祖，而位遇懸邈，當由汝等不及坦之故邪！」述後檢察會稽郡，辯其刑政，主者疲于簡對。羲之深恥之，遂稱病去郡，于父母墓前自誓曰：「維永和十一年三月癸卯朔，九日辛亥，小子羲之敢告二尊之靈。羲之不天，夙遭閔凶，不蒙過庭之訓。母兄鞠育，得漸庶幾，遂因人乏，蒙國寵榮。進無忠孝之節，退違推賢之義，每仰詠老氏、周任之誡，常恐死亡無日，憂及宗祀，豈在微身而已！是用寤寐永歎，若墜深谷。止足之分，定之於今。謹以今月吉辰肆筵設席，稽顙歸誠，告誓先靈。自今之後，敢渝此心，貪冒苟進，是有無尊之心而不子也。子而不子，天地所不覆載，名教所不得容。信誓之誠，有如皦日！」","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","source_position":{"first_line":66,"last_line":66,"revision_id":2603570,"raw_projection_ref":"source-evidence/jin080-wangxizhi-comparison/projection.json","raw_file_sha256":"4f3f42dd7d8ab0ca3c45e6524e4977db40332e845080367088be0419a3a0e8a0","unit_key":"p027","source_layer":"received_chapter"},"mentions":[{"id":"c-jinshu-080-wangxizhi-comparison:p027:m0005","start":5,"end":7,"surface":"王述","kind":"person","person_id":"a8f_ec8_e74_AAAA","status":"contextual_provisional","interpretation_note":"依完整所選數位比較傳文與此處角色判讀；未圖校，非武英殿底本認證。"},{"id":"c-jinshu-080-wangxizhi-comparison:p027:m0013","start":13,"