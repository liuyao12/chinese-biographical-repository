{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p001443","identity_policy":"contextual_provisional","person_ids":["cbr-p001443"],"persons":[{"id":"cbr-p001443","label":"宋景公（滅曹記事）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"宋景公","mention_ids":["c-shiji-035-guancai:m039-0005","c-shiji-035-guancai:m042-0025"]}],"evidence":[{"mention_id":"c-shiji-035-guancai:m039-0005","chapter_id":"c-shiji-035-guancai","paragraph_id":"c-shiji-035-guancai:p039","quote":"宋景公"},{"mention_id":"c-shiji-035-guancai:m042-0025","chapter_id":"c-shiji-035-guancai","paragraph_id":"c-shiji-035-guancai:p042","quote":"宋景公"}]}],"mentions":[{"id":"c-shiji-035-guancai:m039-0005","start":5,"end":8,"surface":"宋景公","kind":"person","person_id":"cbr-p001443","status":"contextual_provisional","paragraph_id":"c-shiji-035-guancai:p039","chapter_id":"c-shiji-035-guancai"},{"id":"c-shiji-035-guancai:m042-0025","start":25,"end":28,"surface":"宋景公","kind":"person","person_id":"cbr-p001443","status":"contextual_provisional","paragraph_id":"c-shiji-035-guancai:p042","chapter_id":"c-shiji-035-guancai"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji035-102","person_id":"cbr-p001443","surfaces":["宋景公"],"scope":"same_chapter","chapter_ids":["c-shiji-035-guancai"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-035-guancai:p039","quote":"悼公八年，宋景公立。九年，悼公朝于宋，宋囚之；曹立其弟野，是為聲公。悼公死於宋，歸葬。"},{"paragraph_id":"c-shiji-035-guancai:p042","quote":"公孫彊言霸說於曹伯。十四年，曹伯從之，乃背晉干宋。宋景公伐之，晉人不救。十五年，宋滅曹，執曹伯陽及公孫彊以歸而殺之。曹遂絕其祀。"}],"rationale":"依文王子同母十人、蔡曹君世系、蔡女船中事件、楚公子圍弒其王及城濮／伐曹的具體敘事暫定異稱。郟敖／夾敖按同一事件、釐／僖負羈按本卷論贊暫同指；不同國與同國不同世代的同名者分開。匿名者、校勘及跨篇同指仍待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-035-guancai:p039","text":"悼公八年，宋景公立。九年，悼公朝于宋，宋囚之；曹立其弟野，是為聲公。悼公死於宋，歸葬。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-035-guancai:m039-0000","start":0,"end":2,"surface":"悼公","kind":"person","person_id":"cbr-p001442","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m039-0005","start":5,"end":8,"surface":"宋景公","kind":"person","person_id":"cbr-p001443","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m039-0013","start":13,"end":15,"surface":"悼公","kind":"person","person_id":"cbr-p001442","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m039-0027","start":27,"end":28,"surface":"野","kind":"person","person_id":"cbr-p001444","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m039-0031","start":31,"end":33,"surface":"聲公","kind":"person","person_id":"cbr-p001444","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m039-0034","start":34,"end":36,"surface":"悼公","kind":"person","person_id":"cbr-p001442","status":"contextual_provisional"}],"chapter_id":"c-shiji-035-guancai","book_id":"b-shiji-035","work_id":"w-shiji","source_id":"s-shiji-035-guancai"},{"id":"c-shiji-035-guancai:p042","text":"公孫彊言霸說於曹伯。十四年，曹伯從之，乃背晉干宋。宋景公伐之，晉人不救。十五年，宋滅曹，執曹伯陽及公孫彊以歸而殺之。曹遂絕其祀。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-035-guancai:m042-0000","start":0,"end":3,"surface":"公孫彊","kind":"person","person_id":"cbr-p001448","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m042-0007","start":7,"end":9,"surface":"曹伯","kind":"person","person_id":"cbr-p001447","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m042-0014","start":14,"end":16,"surface":"曹伯","kind":"person","person_id":"cbr-p001447","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m042-0025","start":25,"end":28,"surface":"宋景公","kind":"person","person_id":"cbr-p001443","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m042-0045","start":45,"end":48,"surface":"曹伯陽","kind":"person","person_id":"cbr-p001447","status":"contextual_provisional"},{"id":"c