_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-056-jiang-tong:p021:m0176","surface":"程收","start":176,"end":178,"person_id":"rbl_lvk_bei","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-056-jiang-tong:p021","chapter_id":"c-jinshu-056-jiang-tong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-056-jiang-tong:p021","text":"後為博士、尚書郎，參大司馬、齊王冏軍事。冏驕荒將敗，統切諫，文多不載。遷廷尉正，每州郡疑獄，斷處從輕。成都王穎請為記室，多所箴諫。申論陸雲兄弟，辭甚切至。以母憂去職。服闋，為司徒左長史。東海王越為兗州牧，以統為別駕，委以州事，與統書曰：「昔王子師為豫州，未下車，辟荀慈明；下車，辟孔文舉。貴州人士有堪應此者不？」統舉高平郗鑒為賢良，陳留阮修為直言，濟北程收為方正，時以為知人。尋遷黃門侍郎、散騎常侍，領國子博士。永嘉四年，避難奔于成皋，病卒。凡所造賦頌表奏皆傳於後。二子：虨、惇。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":51,"last_line":51,"raw_start":4953,"raw_end":5202,"raw_character_offsets":[4955,4956,4957,4958,4959,4960,4961,4962,4963,4964,4965,4966,4967,4968,4969,4970,4971,4972,4973,4974,4975,4976,4977,4978,4979,4980,4981,4982,4983,4984,4985,4986,4987,4988,4989,4990,4991,4992,4993,4994,4995,4996,4997,4998,4999,5000,5001,5002,5003,5004,5005,5006,5007,5008,5009,5010,5011,5012,5013,5014,5015,5016,5017,5018,5019,5020,5021,5022,5023,5024,5025,5026,5027,5028,5029,5030,5031,5032,5033,5034,5035,5036,5037,5038,5039,5040,5041,5042,5043,5044,5045,5046,5047,5048,5049,5050,5051,5052,5053,5054,5055,5056,5057,5058,5059,5060,5061,5062,5063,5064,5065,5066,5067,5068,5069,5070,5071,5072,5073,5074,5075,5076,5077,5078,5079,5080,5081,5082,5083,5084,5085,5086,5087,5088,5089,5090,5091,5092,5093,5094,5095,5096,5097,5098,5099,5100,5101,5102,5103,5104,5105,5106,5107,5108,5109,5110,5111,5112,5113,5114,5115,5116,5117,5118,5119,5120,5121,5122,5123,5124,5125,5126,5127,5128,5129,5130,5131,5132,5133,5134,5135,5136,5137,5138,5139,5140,5141,5142,5143,5144,5145,5146,5147,5148,5149,5150,5151,5152