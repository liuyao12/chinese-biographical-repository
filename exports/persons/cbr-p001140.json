{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p001140","identity_policy":"contextual_provisional","person_ids":["cbr-p001140"],"persons":[{"id":"cbr-p001140","label":"衛共姬（雍巫所寵）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"衛共姬","mention_ids":["c-shiji-032-qi:m045-0119"]}],"evidence":[{"mention_id":"c-shiji-032-qi:m045-0119","chapter_id":"c-shiji-032-qi","paragraph_id":"c-shiji-032-qi:p045","quote":"衛共姬"}]}],"mentions":[{"id":"c-shiji-032-qi:m045-0119","start":119,"end":122,"surface":"衛共姬","kind":"person","person_id":"cbr-p001140","status":"contextual_provisional","paragraph_id":"c-shiji-032-qi:p045","chapter_id":"c-shiji-032-qi"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-032-qi:p045","text":"四十三年。初，齊桓公之夫人三：曰王姬、徐姬、蔡姬，皆無子。桓公好內，多內寵，如夫人者六人，長衛姬，生無詭；少衛姬，生惠公元；鄭姬，生孝公昭；葛嬴，生昭公潘；密姬，生懿公商人；宋華子，生公子雍。桓公與管仲屬孝公於宋襄公，以為太子。雍巫有寵於衛共姬，因宦者豎刀以厚獻於桓公，亦有寵，桓公許之立無詭。管仲卒，五公子皆求立。冬十月乙亥，齊桓公卒。易牙入，與豎刀因內寵殺群吏，而立公子無詭為君。太子昭奔宋。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-032-qi:m045-0007","start":7,"end":10,"surface":"齊桓公","kind":"person","person_id":"cbr-p000235","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m045-0016","start":16,"end":18,"surface":"王姬","kind":"person","person_id":"cbr-p001124","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m045-0019","start":19,"end":21,"surface":"徐姬","kind":"person","person_id":"cbr-p001125","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m045-0022","start":22,"end":24,"surface":"蔡姬","kind":"person","person_id":"cbr-p001116","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m045-0029","start":29,"end":31,"surface":"桓公","kind":"person","person_id":"cbr-p000235","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m045-0045","start":45,"end":48,"sur