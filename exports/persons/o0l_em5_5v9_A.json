ations":[{"id":"th-shiji091-027:a001","paragraph_id":"c-shiji-091-qingbu:p017","start":106,"end":110,"surface":"長沙哀王","person_mention_id":"c-shiji-091-qingbu:m017-0106","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予與用稱分存；常冠軍不作官名，欲為帝不作即帝位，稱病反楚死亡不補官爵終期。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[{"id":"shiji-017-t1-r006-c27-review-000","start":0,"end":3,"surface":"成王臣","person_id":"o0l_em5_5v9_A","status":"contextual_provisional","interpretation_note":"依本格封國、紀年、所載親屬及核讀篇文暫定同指；省稱限本格，不設為全域別名。","identity_evidence":[{"work_id":"w-shiji","book_id":"b-shiji-009","chapter_id":"c-shiji-009-lvhou","paragraph_id":"c-shiji-009-lvhou:p003","source_id":"s-shiji-009-lvhou","source_revision":2087062,"person_id":"o0l_em5_5v9_A","quote":"吳芮子臣為長沙王"}],"table_id":"shiji-017","table_fragment_id":"shiji-017-digital-table-1","table_row_id":"shiji-017-t1-r006","table_cell_id":"shiji-017-t1-r006-c27","work_id":"w-shiji","book_id":"b-shiji-017","chapter_id":"table-chapter-shiji-017","source_id":"table-witness-shiji-017","source_revision":"2607010","kind":"table_person_mention","quote":"成王臣元年"}],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji091-021","person_id":"o0l_em5_5v9_A","scope":"same_chapter","chapter_ids":["c-shiji-091-qingbu"],"status":"contextual_provisional","rationale":"按本段明示姓名及局部敘事承接；布與兩王號按英布主線暫接。番君與長沙哀王分候選，所幸姬不與番君女合併；皋陶引古疑問不作祖先定論。","reviewer":"Codex（AI 代理）","surfaces":["長沙哀王"],"evidence":[{"paragraph_id":"c-shiji-091-qingbu:p017","quote":"遂西，與上兵遇蘄西會甀。布兵精甚，上乃壁庸城，望布軍置陳如項籍軍，上惡之。與布相望見，遙謂布曰：「何苦而反？」布曰：「欲為帝耳。」上怒罵之，遂大戰。布軍敗走，渡淮，數止戰，不利，與百餘人走江南。布故與番君婚，以故長沙哀王使人紿布，偽與亡，誘走越，故信而隨之番陽。番陽人殺布茲鄉民田舍，遂滅黥布。"}]}],"equivalence_decisions":[{"id":"eq-shiji091-review-changsha","person_ids":["o0l_em5_5v9_A"],"canonical_person_id":"o0l_em5_5v9_A","sco