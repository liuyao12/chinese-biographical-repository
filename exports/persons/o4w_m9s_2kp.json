y_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-052-buzhi-complete:line088:m0092","start":92,"end":94,"surface":"呉巨","kind":"person","person_id":"o4w_m9s_2kp","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-sanguozhi-052-buzhi-complete:line088","chapter_id":"c-sanguozhi-052-buzhi-complete"}],"relations":[],"title_holdings":[{"id":"th-wu052-bz-9","person_id":"o4w_m9s_2kp","title":"蒼梧太守","kind":"office","mode":"attestation","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-052","chapter_id":"c-sanguozhi-052-buzhi-complete","source_id":"s-sanguozhi-052-buzhi-complete","paragraph_id":"c-sanguozhi-052-buzhi-complete:line088","quote":"孫權爲討虜將軍，召騭爲主記。除海鹽長，還辟車騎將軍東曹掾。建安十五年，出領鄱陽太守。歳中，徙交州刺史、立武中郎將。領武射吏千人，便道南行。明年，追拜使持節、征南中郎將。劉表所置蒼梧太守呉巨陰懷異心，外附內違。騭降意懷誘，請與相見，因斬徇之，威聲大震。士燮兄弟，相率供命，南土之賓，自此始也。益州大姓雍闓等殺蜀所署太守正昂，與燮相聞，求欲內附。騭因承製遣使宣恩撫納，由是加拜平戎將軍，封廣信侯。","person_mention_id":"c-sanguozhi-052-buzhi-complete:line088:m0092"}],"attestations":[{"id":"th-wu052-bz-9:a","paragraph_id":"c-sanguozhi-052-buzhi-complete:line088","start":88,"end":92,"surface":"蒼梧太守","person_mention_id":"c-sanguozhi-052-buzhi-complete:line088:m0092","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-052-buzhi-complete:line088","text":"孫權爲討虜將軍，召騭爲主記。除海鹽長，還辟車騎將軍東曹掾。建安十五年，出領鄱陽太守。歳中，徙交州刺史、立武中郎將。領武