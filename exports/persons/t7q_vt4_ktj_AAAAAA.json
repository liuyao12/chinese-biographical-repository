-040-chu:m040-0002","start":2,"end":4,"surface":"子比","kind":"person","person_id":"q8m_d0c_kq3_AC","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m040-0008","start":8,"end":11,"surface":"韓宣子","kind":"person","person_id":"4rk_808_kn9","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m040-0012","start":12,"end":14,"surface":"叔向","kind":"person","person_id":"7he_05e_e75","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m040-0017","start":17,"end":19,"surface":"子比","kind":"person","person_id":"q8m_d0c_kq3_AC","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m040-0032","start":32,"end":34,"surface":"宣子","kind":"person","person_id":"4rk_808_kn9","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m040-0115","start":115,"end":117,"surface":"子比","kind":"person","person_id":"q8m_d0c_kq3_AC","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m040-0184","start":184,"end":186,"surface":"王虐","kind":"unresolved","person_id":null,"status":"unresolved","note":"叔向引語中的楚王稱，待核事件先後，先保留未定位置。"},{"id":"c-shiji-040-chu:m040-0190","start":190,"end":192,"surface":"子比","kind":"person","person_id":"q8m_d0c_kq3_AC","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m040-0210","start":210,"end":212,"surface":"棄疾","kind":"person","person_id":"q8m_d0c_kq3_AE","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m040-0270","start":270,"end":272,"surface":"子比","kind":"person","person_id":"q8m_d0c_kq3_AC","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m040-0311","start":311,"end":313,"surface":"宣子","kind":"person","person_id":"4rk_808_kn9","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m040-0316","start":316,"end":318,"surface":"齊桓","kind":"person","person_id":"9w2_c77_53m","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m040-0319","start":319,"end":321,"surface":"晉文","kind":"person","person_id":"6di_ywz_ju4_AAA","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m040-0331","start":331,"end":333,"surfa