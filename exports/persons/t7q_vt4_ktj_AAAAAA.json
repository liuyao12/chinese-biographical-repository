":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji032-032","person_id":"t7q_vt4_ktj_AAAAAA","surfaces":["釐公","釐公祿甫"],"scope":"same_chapter","chapter_ids":["c-shiji-032-qi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-032-qi:p019","quote":"六十四年，莊公卒，子釐公祿甫立。"},{"paragraph_id":"c-shiji-032-qi:p020","quote":"釐公九年，魯隱公初立。十九年，魯桓公弒其兄隱公而自立為君。"},{"paragraph_id":"c-shiji-032-qi:p022","quote":"三十二年，釐公同母弟夷仲年死。其子曰公孫無知，釐公愛之，令其秩服奉養比太子。"},{"paragraph_id":"c-shiji-032-qi:p023","quote":"三十三年，釐公卒，太子諸兒立，是為襄公。"},{"paragraph_id":"c-shiji-032-qi:p025","quote":"四年，魯桓公與夫人如齊。齊襄公故嘗私通魯夫人。魯夫人者，襄公女弟也，自釐公時嫁為魯桓公婦，及桓公來而襄公復通焉。魯桓公知之，怒夫人，夫人以告齊襄公。齊襄公與魯君飲，醉之，使力士彭生抱上魯君車，因拉殺魯桓公，桓公下車則死矣。魯人以為讓，而齊襄公殺彭生以謝魯。"},{"paragraph_id":"c-shiji-032-qi:p029","quote":"初，襄公之醉殺魯桓公，通其夫人，殺誅數不當，淫於婦人，數欺大臣，群弟恐禍及，故次弟糾奔魯。其母魯女也。管仲、召忽傅之。次弟小白奔莒，鮑叔傅之。小白母，衛女也，有寵於釐公。小白自少好善大夫高傒。及雍林人殺無知，議立君，高、國先陰召小白於莒。魯聞無知死，亦發兵送公子糾，而使管仲別將兵遮莒道，射中小白帶鉤。小白詳死，管仲使人馳報魯。魯送糾者行益遲，六日至齊，則小白已入，高傒立之，是為桓公。"}],"rationale":"按本篇周初、呂尚／師尚父、齊君世系及魯桓公遇害等明示語境暫定異稱，原字與所列或曰異說保留，不按全庫同名合併。先君太公引語未連到呂尚。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji040-136","person_id":"t7q_vt4_ktj_AAAAAA","surfaces":["釐公"],"scope":"same_chapter","chapter_ids":["c-shiji-040-chu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-040-chu:p040","quote":"初，子比自晉歸，韓宣子問叔向曰：「子比其濟乎？」對曰：「不就。」宣子曰：「同惡相求，如市賈焉，何爲不就？」對曰：「無與同好，誰與同惡？取國有五難：有寵無人，一也；有人無主，二也；有主無謀，三也；有謀而無民，四也；有民而無德，五也。子比在晉十三年矣，晉、楚之從不聞通者，可謂無人矣；族盡親叛，可謂無主矣；無釁而動，可謂無謀矣；爲羈終世，可謂無民矣；亡無愛徴，可謂無德矣。王虐而不忌，子比渉五難以弒君，誰能濟之！有楚國者，其棄疾乎？君陳、蔡，方城外屬焉。苛慝不作，盜賊伏隱，私欲不違，民無怨心。先神命之，國民信之。羋姓有亂，必季實立，楚之常也。子比之官，則右尹也；數其貴寵，則庶子也；以神所命，則又遠之；民無懷焉，將何以立？」宣子曰：「齊桓、晉文不亦是乎？」對曰：「齊桓，衞姬之子也，有寵於釐公。有鮑叔牙、賓須無、隰朋以爲輔，有莒、衞以爲外主，有髙、國以爲内主。從善如流，施惠不倦。有國，不亦宜乎？昔我文公，狐季姬之子也，有寵於獻公。好學不倦。生十七年，有士五人，有先大夫子餘、子犯以爲腹心，有魏犫、賈佗以爲股肱，有齊、宋、秦、楚以爲外主，有欒、郤、狐、先以爲内主。亡十九年，守志彌篤。惠、懷棄民，民從而與之。故文公有國，不亦宜乎？子比無施於民，無援於外，去晉，晉不送；歸楚，楚不迎。何以有國！」子比果不終焉，卒立者棄疾，如叔向言也。"}],"rationale":"本篇具名角色先保存候選；尚未與他篇同名或同稱人物完成事件、世系與版本比對，不作確定不同人或確定同人的結論。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji042-033","person_id":"t7q_vt4_ktj_AAAAAA","surfaces":["齊釐公"],"scope":"same_chapter","chapter_ids":["c-shiji-042-zheng"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-042-zheng:p006","quote":"三十八年，北戎伐齊，齊使求救，鄭遣太子忽將兵救齊。齊釐公欲妻之，忽謝曰：「我小國，非齊敵也。」時祭仲與倶，勸使取之，曰：「君多内寵，太子無大援將不立，三公子皆君也。」所謂三公子者，太子忽，其弟突，次弟子亹也。"}],"rationale":"依本篇名字、是為、世系及連續事件暫接異稱；同諡不同國分開，建子勝與聲公勝不合併，如兄弟為譬喻不作親屬。述贊與正文不算獨立來源，省稱、古字與校勘仍待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji040-ligong","person_ids":["t7q_vt4_ktj_AAAAAA"],"canonical_person_id":"t7q_vt4_ktj_AAAAAA","scope":"cross_chapter","chapter_ids":["c-shiji-032-qi","c-shiji-040-chu"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-032-qi","source_id":"s-shiji-032-qi","paragraph_id":"c-shiji-032-qi:p029","quote":"初，襄公之醉殺魯桓公，通其夫人，殺誅數不當，淫於婦人，數欺大臣，群弟恐禍及，故次弟糾奔魯。其母魯女也。管仲、召忽傅之。次弟小白奔莒，鮑叔傅之。小白母，衛女也，有寵於釐公。小白自少好善大夫高傒。及雍林人殺無知，議立君，高、國先陰召小白於莒。魯聞無知死，亦發兵送公子糾，而使管仲別將兵遮莒道，射中小白帶鉤。小白詳死，管仲使人馳報魯。魯送糾者行益遲，六日至齊，則小白已入，高傒立之，是為桓公。","mention_ids":["c-shiji-032-qi:m029-0082"]},{"chapter_id":"c-shiji-040-chu","source_id":"s-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p040","quote":"初，子比自晉歸，韓宣子問叔向曰：「子比其濟乎？」對曰：「不就。」宣子曰：「同惡相求，如市賈焉，何爲不就？」對曰：「無與同好，誰與同惡？取國有五難：有寵無人，一也；有人無主，二也；有主無謀，三也；有謀而無民，四也；有民而無德，五也。子比在晉十三年矣，晉、楚之從不聞通者，可謂無人矣；族盡親叛，可謂無主矣；無釁而動，可謂無謀矣；爲羈終世，可謂無民矣；亡無愛徴，可謂無德矣。王虐而不忌，子比渉五難以弒君，誰能濟之！有楚國者，其棄疾乎？君陳、蔡，方城外屬焉。苛慝不作，盜賊伏隱，私欲不違，民無怨心。先神命之，國民信之。羋姓有亂，必季實立，楚之常也。子比之官，則右尹也；數其貴寵，則庶子也；以神所命，則又遠之；民無懷焉，將何以立？」宣子曰：「齊桓、晉文不亦是乎？」對曰：「齊桓，衞姬之子也，有寵於釐公。有鮑叔牙、賓須無、隰朋以爲輔，有莒、衞以爲外主，有髙、國以爲内主。從善如流，施惠不倦。有國，不亦宜乎？昔我文公，狐季姬之子也，有寵於獻公。好學不倦。生十七年，有士五人，有先大夫子餘、子犯以爲腹心，有魏犫、賈佗以爲股肱，有齊、宋、秦、楚以爲外主，有欒、郤、狐、先以爲内主。亡十九年，守志彌篤。惠、懷棄民，民從而與之。故文公有國，不亦宜乎？子比無施於民，無援於外，去晉，晉不送；歸楚，楚不迎。何以有國！」子比果不終焉，卒立者棄疾，如叔向言也。","mention_ids":["c-shiji-040-chu:m040-0343"]}],"rationale":"兩篇均述齊桓（小白）及其母受寵於釐公，按同一親屬與立君背景暫同指；不與魯等國同諡釐公合併。 已發ID及所有原證據保留；尚未完成人工及可靠版本覆核。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true},{"id":"eq-shiji110-ancient-qixigong","person_ids":["t7q_vt4_ktj_AAAAAA"],"canonical_person_id":"t7q_vt4_ktj_AAAAAA","status":"contextual_provisional","scope":"cross_chapter","chapter_ids":["c-shiji-110-xiongnu","c-shiji-032-qi","c-shiji-042-zheng"],"rationale":"周東遷後、齊桓公前遭戎攻的齊釐公，對讀卷32祿甫繼位至子襄公承立及卷42北戎伐齊、太子忽救齊。卷32同役稱北戎，卷110稱山戎，原詞與相對年數各存，不混其他國釐公。","evidence":[{"chapter_id":"c-shiji-110-xiongnu","source_id":"s-shiji110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p002","quote":"夏道衰，而公劉失其稷官，變于西戎，邑于豳。其後三百有餘歳，戎狄攻大王亶父，亶父亡走岐下，而豳人悉從亶父而邑焉，作周。其後百有餘歳，周西伯昌伐畎夷氏。後十有餘年，武王伐紂而營雒邑，復居于酆鄗，放逐戎夷涇、洛之北，以時入貢，命曰「荒服」。其後二百有餘年，周道衰，而穆王伐犬戎，得四白狼四白鹿以歸。自是之後，荒服不至。於是周遂作甫刑之辟。穆王之後二百有餘年，周幽王用寵姬褒姒之故，與申侯有卻。申侯怒而與犬戎共攻殺周幽王于驪山之下，遂取周之焦穫，而居于涇渭之閒，侵暴中國。秦襄公救周，於是周平王去酆鄗而東徙雒邑。當是之時，秦襄公伐戎至岐，始列爲諸侯。是後六十有五年，而山戎越燕而伐齊，齊釐公與戰于齊郊。其後四十四年，而山戎伐燕。燕告急于齊，齊桓公北伐山戎，山戎走。其後二十有餘年，而戎狄至洛邑，伐周襄王，襄王奔于鄭之氾邑。初，周襄王欲伐鄭，故娶戎狄女爲后，與戎狄兵共伐鄭。已而黜狄后，狄后怨，而襄王後母曰惠后，有子子帶，欲立之，於是惠后與狄后、子帶爲內應，開戎狄，戎狄以故得入，破逐周襄王，而立子帶爲天子。於是戎狄或居于陸渾，東至於衛，侵盜暴虐中國。中國疾之，故詩人歌之曰「戎狄是應」，「薄伐獫狁，至於大原」，「出輿彭彭，城彼朔方」。周襄王既居外四年，乃使使告急于晉。晉文公初立，欲修霸業，乃興師伐逐戎翟，誅子帶，迎內周襄王，居于雒邑。","mention_ids":["c-shiji-110-xiongnu:m002-0288"]},{"chapter_id":"c-shiji-032-qi","source_id":"s-shiji-032-qi","paragraph_id":"c-shiji-032-qi:p019","quote":"六十四年，莊公卒，子釐公祿甫立。","mention_ids":["c-shiji-032-qi:m019-0010"]},{"chapter_id":"c-shiji-032-qi","source_id":"s-shiji-032-qi","paragraph_id":"c-shiji-032-qi:p020","quote":"釐公九年，魯隱公初立。十九年，魯桓公弒其兄隱公而自立為君。","mention_ids":["c-shiji-032-qi:m020-0000"]},{"chapter_id":"c-shiji-032-qi","source_id":"s-shiji-032-qi","paragraph_id":"c-shiji-032-qi:p023","quote":"三十三年，釐公卒，太子諸兒立，是為襄公。","mention_ids":["c-shiji-032-qi:m023-0005"]},{"chapter_id":"c-shiji-042-zheng","source_id":"s-shiji-042-zheng","paragraph_id":"c-shiji-042-zheng:p006","quote":"三十八年，北戎伐齊，齊使求救，鄭遣太子忽將兵救齊。齊釐公欲妻之，忽謝曰：「我小國，非齊敵也。」時祭仲與倶，勸使取之，曰：「君多内寵，太子無大援將不立，三公子皆君也。」所謂三公子者，太子忽，其弟突，次弟子亹也。","mention_ids":["c-shiji-042-zheng:m006-0025"]}],"reviewer":"Codex（AI 代理）","model":null,"human_reviewed":false,"identity_materialized":true}],"passages":[{"id":"c-shiji-032-qi:p019","text":"六十四年，莊公卒，子釐公祿甫立。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-032-qi:m019-0005","start":5,"end":7,"surface":"莊公","kind":"person","person_id":"t7q_vt4_ktj_AAAAA","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m019-0010","start":10,"end":14,"surface":"釐公祿甫","kind":"person","person_id":"t7q_vt4_ktj_AAAAAA","status":"contextual_provisional"}],"chapter_id":"c-shiji-032-qi","book_id":"b-shiji-032","work_id":"w-shiji","source_id":"s-shiji-032-qi"},{"id":"c-shiji-032-qi:p020","text":"釐公九年，魯隱公初立。十九年，魯桓公弒其兄隱公而自立為君。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-032-qi:m020-0000","start":0,"end":2,"surface":"釐公","kind":"person","person_id":"t7q_vt4_ktj_AAAAAA","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m020-0005","start":5,"end":8,"surface":"魯隱公","kind":"person","person_id":"lc6_cup_v9c_AA","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m020-0015","start":15,"end":18,"surface":"魯桓公","kind":"person","person_id":"lc6_cup_v9c_AB","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m020-0021","start":21,"end":23,"surface":"隱公","kind":"person","person_id":"lc6_cup_v9c_AA","status":"contextual_provisional"}],"chapter_id":"c-shiji-032-qi","book_id":"b-shiji-032","work_id":"w-shiji","source_id":"s-shiji-032-qi"},{"id":"c-shiji-032-qi:p022","text":"三十二年，釐公同母弟夷仲年死。其子曰公孫無知，釐公愛之，令其秩服奉養比太子。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-032-qi:m022-0005","start":5,"end":7,"surface":"釐公","kind":"person","person_id":"t7q_vt4_ktj_AAAAAA","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m022-0010","start":10,"end":13,"surface":"夷仲年","kind":"person","person_id":"1hf_1k0_bnj","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m022-0018","start":18,"end":22,"surface":"公孫無知","kind":"person","person_id":"1hf_1k0_bnj_A","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m022