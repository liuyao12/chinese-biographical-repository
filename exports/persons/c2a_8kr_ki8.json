攻趙。十四年，攻趙軍於平陽，取宜安，破之，殺其將軍。桓齮定平陽、武城。韓非使秦，秦用李斯謀，留非，非死雲陽。韓王請為臣。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:m013-0004","start":4,"end":6,"surface":"桓齮","kind":"person","person_id":"42c_0ck_iry","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m013-0012","start":12,"end":16,"surface":"趙將扈輒","kind":"person","person_id":"c2a_8kr_ki8","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m013-0022","start":22,"end":23,"surface":"王","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官稱或句讀疑問待核；不補造姓名或直接同稱合併。"},{"id":"c-shiji-006-shihuang:m013-0039","start":39,"end":41,"surface":"桓齮","kind":"person","person_id":"42c_0ck_iry","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m013-0063","start":63,"end":66,"surface":"其將軍","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官稱或句讀疑問待核；不補造姓名或直接同稱合併。"},{"id":"c-shiji-006-shihuang:m013-0067","start":67,"end":69,"surface":"桓齮","kind":"person","person_id":"42c_0ck_iry","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m013-0076","start":76,"end":78,"surface":"韓非","kind":"person","person_id":"g2b_tzq_wxz","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m013-0083","start":83,"end":85,"surface":"李斯","kind":"person","person_id":"49g_7az_e4i","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m013-0088","start":88,"end":89,"surface":"非","kind":"person","person_id":"g2b_tzq_wxz","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m013-0090","start":90,"end":91,"surface":"非","kind":"person","person_id":"g2b_tzq_wxz","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m013-0095","start":95,"end":97,"surface":"韓王","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官稱或句讀疑問待核；不補造姓名或直接同稱合併。"}],"chapter_id":"c-shiji-006-shihuang","book_id":"b-shiji-006","work_id":"w-shiji","source_id":"s-shiji-006-shihuang"}],