_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-099-huanxuan:p012:m0194","start":194,"end":196,"surface":"刁暢","kind":"person","person_id":"okk_4oo_lew","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。","paragraph_id":"c-jinshu-099-huanxuan:p012","chapter_id":"c-jinshu-099-huanxuan"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-099-huanxuan:p012","text":"於是遂平荊雍，乃表求領江、荊二州。詔以玄都督荊司雍秦梁益寧七州、後將軍、荊州刺史、假節，以桓脩為江州刺史。玄上疏固爭江州，於是進督八州及楊豫八郡，復領江州刺史。玄又輒以偉為冠軍將軍、雍州刺史。時寇賊未平，朝廷難違其意，許之。玄於是樹用腹心，兵馬日盛，屢上疏求討孫恩，詔輒不許。其後恩逼京都，玄建牙聚眾，外托勤王，實欲觀釁而進，復上疏請討之。會恩已走，玄又奉詔解嚴。以偉為江州，鎮夏口；司馬刁暢為輔國將軍，督八郡，鎮襄陽；遣桓振、皇甫敷、馮該等戍湓口。移沮漳蠻二千戶於江南，立武寧郡；更招集流人，立綏安郡。又置諸郡丞。詔徵廣州刺史刁逵、豫章太守郭昶之，玄皆留不遣。自謂三分有二，知勢運所歸，屢上禎祥以為己瑞。","source_position":{"kind":"wikitext_codepoint_positions","raw_path":"sources/jinshu/wikisource-2644703-raw.wikitext","raw_start":2526,"raw_end":2831,"character_positions":[2528,2529,2530,2531,2532,2533,2534,2535,2536,2537,2538,2539,2540,2541,2542,2543,2544,2545,2546,2547,2548,2549,2550,2551,2552,2553,2554,2555,2556,2557,2558,2559,2560,2561,2562,2563,2564,2565,2566,2567,2568,2569,2570,2571,2572,2573,2574,2575,2576,2577,2578,2579,2580,2581,2582,2583,2584,2585,2586,2587,2588,2589,2590,2591,2592,2593,2594,2595,2596,2597,2598,2599,2600,2601,2602,2603,2604,2605,2606,2607,2608,2609,2610,2611,2612,2613,2614,2615,2616,2617,2618,2619,2620,2621,2622,2623,2624,2625,2626,2627,2628,2629,2630,2631,2632,2633,2634,2635,2636,2637,2638,2639,2640,2641,2642,2643,2644,2645,2646,2647,2648,2649,2650,2651,2652,2653,2654,2655,2656,2657,2658,2659,2660,2661,2662,2663,2664,2665,2666,2667,2668,2669,2670,2671,2672,2673,2674,2675,2676,2677,2678,2679,2680,2681,2682,2683,2684,2685,2686,2687,2688,2