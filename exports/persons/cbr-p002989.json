nd":"person","person_id":"cbr-p002967","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m009-0071","start":71,"end":73,"surface":"陳王","kind":"person","person_id":"cbr-p002979","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m009-0089","start":89,"end":91,"surface":"周市","kind":"person","person_id":"cbr-p002989","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m009-0095","start":95,"end":97,"surface":"周市","kind":"person","person_id":"cbr-p002989","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m009-0105","start":105,"end":107,"surface":"陳王","kind":"person","person_id":"cbr-p002979","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m009-0109","start":109,"end":113,"surface":"甯陵君咎","kind":"person","person_id":"cbr-p002967","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m009-0121","start":121,"end":123,"surface":"周市","kind":"person","person_id":"cbr-p002989","status":"contextual_provisional"}],"chapter_id":"c-shiji-048-chenshe","book_id":"b-shiji-048","work_id":"w-shiji","source_id":"s-shiji-048-chenshe"},{"id":"c-shiji-090-wei:p001","text":"魏豹者，故魏諸公子也。其兄魏咎，故魏時封為寧陵君。秦滅魏，遷咎為家人。陳勝之起王也，咎往從之。陳王使魏人周市徇魏地，魏地已下，欲相與立周市為魏王。周市曰：「天下昏亂，忠臣乃見。今天下共畔秦，其義必立魏王後乃可。」齊、趙使車各五十乘，立周市為魏王。市辭不受，迎魏咎於陳。五反，陳王乃遣立咎為魏王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-090-wei:m001-0000","start":0,"end":2,"surface":"魏豹","kind":"person","person_id":"cbr-p005033","status":"contextual_provisional"},{"id":"c-shiji-090-wei:m001-0005","start":5,"end":9,"surface":"魏諸公子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者與未定指代不補成員姓名。"},{"id":"c-shiji-090-wei:m001-0013","start":13,"end":15,"surface":"魏咎","kind":"person","person_id":"cbr-p005035","status":"contextual_provisional"},{"id":"c-shiji-090-wei:m001-0030","start":30,"end":31,"surface":"咎","kind":"person","person_id":"cbr-p005035","status":"contextual_provisional"},{"id":"c-shiji-090-wei:m001-0035"