ns_of_parent","position":"unspecified","source_term":"第八子","parent_person_id":"fo7_f8v_rmf","interpretation_status":"source_attested"}},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-055","source_id":"s-liangshu-055-xiaoji-wangqian-ws1530936","chapter_id":"c-liangshu-055-xiaoji-wangqian","paragraph_id":"c-liangshu-055-xiaoji-wangqian:p001","quote":"武陵王紀字世詢，高祖第八子也。","subject_person_mention_id":"c-liangshu-055-xiaoji-wangqian:p001:m0003","object_person_reference_id":"c-liangshu-055-xiaoji-wangqian:p001:r0008"}],"status":"source_attested","interpretation_note":"排行按高祖諸子。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"title_holdings":[],"address_assertions":[],"person_references":[{"id":"c-liangshu-021-wangfen:p012:r0188","surface":"武陵王","start":188,"end":191,"person_id":"fo7_f8v_rmf_D","referent_role":"third_person","paragraph_id":"c-liangshu-021-wangfen:p012","quote":"僉字公會，錫第五弟也。八歲丁父憂，哀毀過禮。服闋，召補國子生，祭酒袁昂稱爲通理。策高第，除長史兼秘書郎中，歷尚書殿中郎，太子中舍人，與吳郡陸襄對掌東宮管記。出爲建安太守。山酋方善、謝稀聚徒依險，屢爲民患，僉潛設方略，率衆平之，有詔褒美，頒示州郡。除武威將軍、始興內史，丁所生母憂，固辭不拜。又除寧遠將軍、南康內史，屬盧循作亂，復轉僉爲安成內史，以鎮撫之。還除黃門侍郎，尋爲安西武陵王長史、蜀郡太守。僉憚岨嶮，固以疾辭，因以黜免。久之，除戎昭將軍、尚書左丞，復補黃門侍郎，遷太子中庶子，掌東宮管記。太清二年十二月，卒，時年四十五。贈侍中，給東園秘器，朝服一具，衣一襲。承聖三年，世祖追詔曰：「賢而不伐曰恭，諡恭子。」","note":"梁武帝子紀，加安西將軍督益州。","chapter_id":"c-liangshu-021-wangfen","book_id":"b-liangshu-021","work_id":"w-liangshu","source_id":"s-liangshu-021-wangfen-ws1544250"},{"id":"c-liangshu-055-xiaoji-wangqian:p001:r0000","surface":"武陵王","start":0,"end":3,"person_id":"fo7_f8v_rmf_D","referent_role":"third_person","paragraph_id":"c-liangshu-055-xiaoji-wangqian:p001","quote":"武陵王紀字世詢，高祖第八子也。","note":"依本段敘事及王府原卷。","chapter_id":"c-liangshu-055-xiaoji-wangqian","book_id":"b-liangshu-055","work_id":"w-liangshu","source_id":"s-liangshu-055-xiaoji-wangqian-ws1530936"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[{"ordinal":8,"scope":"sons_of_parent","position":"unspecified","source_term":"第八子","parent_person_id":"fo7_f8v_rmf","interpretation_status":"source_attested","assertion_id":"a-liang021-wangfen-family-xiaoji-father","person_id":"fo7_f8v_rmf_D","evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-055","source_id":"s-liangshu-055-xiaoji-wangqian-ws1530936","chapter_id":"c-liangshu-055-xiaoji-wangqian","paragraph_id":"c-liangshu-055-xiaoji-wangqian:p001","quote":"武陵王紀字世詢，高祖第八子也。","subject_person_mention_id":"c-liangshu-055-xiaoji-wangqian:p001:m0003","object_person_reference_id":"c-liangshu-055-xiaoji-wangqian:p001:r0008"}]}],"preferred_birth_order_constraints":[{"ordinal":8,"scope":"sons_of_parent","position":"unspecified","source_term":"第八子","parent_person_id":"fo7_f8v_rmf","interpretation_status":"source_attested","assertion_id":"a-liang021-wangfen-family-xiaoji-father","person_id":"fo7_f8v_rmf_D","evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-055","source_id":"s-liangshu-055-xiaoji-wangqian-ws1530936","chapter_id":"c-liangshu-055-xiaoji-wangqian","paragraph_id":"c-liangshu-055-xiaoji-wangqian:p001","quote":"武陵王紀字世詢，高祖第八子也。","subject_person_mention_id":"c-liangshu-055-xiaoji-wangqian:p001:m0003","object_person_reference_id":"c-liangshu-055-xiaoji-wangqian:p001:r0008"}]}],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-chenshu-017-wangmai-complete:p001","text":"勱字公濟，通之弟也。美風儀，博涉書史，恬然清簡，未嘗以利欲干懷。梁世為國子周易生，射策舉高第，除祕書郎、太子舍人、宣惠武陵王主簿、輕車河東王功曹史。王出鎮京口，勱將隨之藩，范陽張纘時典選舉，勱造纘言別，纘嘉其風采，乃曰：「王生才地，豈可游外府乎？」奏為太子洗馬。遷中舍人，司徒左西屬。出為南徐州別駕從事史。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":36,"last_line":36,"raw_start":1679,"raw_end":1883,"raw_character_offsets":[1679,1680,1681,1682,1683,1735,1736,1737,1738,1739,1740,1741,1742,1743,1744,1745,1746,1747,1748,1749,1750,1751,1752,1753,1754,1755,1756,1757,1758,1759,1760,1761,1762,1763,1764,1765,1766,1767,1768,1769,1770,1771,1772,1773,1774,1775,1776,1777,1778,1779,1780,1781,1782,1783,1784,1785,1786,1787,1788,1789,1790,1791,1792,1793,1794,1795,1796,1797,1798,1799,1800,1801,1802,1803,1804,1805,1806,1807,1808,1809,1810