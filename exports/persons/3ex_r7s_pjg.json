{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"3ex_r7s_pjg","canonical_person_id":"3ex_r7s_pjg","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["3ex_r7s_pjg"],"persons":[{"id":"3ex_r7s_pjg","label":"拓跋普根","status":"active","historicity":"historical_tradition","aliases":[{"surface":"根","mention_ids":["c-jinshu-062-liukun:p014:m0062"]}],"evidence":[{"mention_id":"c-jinshu-062-liukun:p014:m0062","paragraph_id":"c-jinshu-062-liukun:p014","chapter_id":"c-jinshu-062-liukun","quote":"根"}],"review":"ai_provisional","identity_note":"拓跋普根，見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-jinshu-062-liukun-ws2629226","work_id":"w-jinshu","book_id":"b-jinshu-062","chapter_id":"c-jinshu-062-liukun","raw_mention_count":1,"mention_ids":["c-jinshu-062-liukun:p014:m0062"],"paragraph_ids":["c-jinshu-062-liukun:p014"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-062-liukun:p014:m0062","mention_ids":["c-jinshu-062-liukun:p014:m0062"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-062-liukun-ws2629226"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-062-liukun:p014:m0062","surface":"根","start":62,"end":63,"person_id":"3ex_r7s_pjg","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-062-liukun:p014","chapter_id":"c-jinshu-062-liukun"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-062-liukun:p014","text":"三年，帝遣兼大鴻臚趙廉持節拜琨爲司空、都督並冀幽三州諸軍事。琨上表讓司空，受都督，克期與猗盧討劉聰。尋猗盧父子相圖，盧及兄子根皆病死，部落四散。琨子遵先質于盧，眾皆附之。及是，遵與箕澹等帥盧眾三萬人，馬牛羊十萬，悉來歸琨，琨由是復振，率數百騎自平城撫納之。屬石勒攻樂平，太守韓據請救於琨，而琨自以士眾新合，欲因其銳以威勒。箕澹諫曰：「此雖晉人，久在荒裔，未習恩信，難以法御。今內收鮮卑之餘穀，外抄殘胡之牛羊，且閉關守險，務農息士，既服化感義，然後用之，則功可立也。」琨不從，悉發其眾，命澹領步騎二萬爲前驅，琨自爲後繼。勒先據險要，設伏以擊澹，大敗之，一軍皆沒，並土震駭。尋又炎旱，琨窮蹙不能復守。幽州刺史鮮卑段匹磾數遣信要琨，欲與同獎王室。琨由是率眾赴之，從飛狐人薊。匹磾見之，甚相崇重，與琨結婚，約爲兄弟。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":38,"last_line":38,"raw_start":3222,"raw_end":3582,"raw_character_offsets":[3224,3225,3226,3227,3228,3229,3230,3231,3232,3233,3234,3235,3236,3237,3238,3239,3240,3241,3242,3243,3244,3245,3246,3247,3248,3249,3250,3251,3252,3253,3254,3255,3256,3257,3258,3259,3260,3261,3262,3263,3264,3265,3266,3267,3268,3269,3270,3271,3272,3273,3274,3275,3276,3277,3278,3279,3280,3281,3282,3283,3284,3285,3286,3287,3288,3289,3290,3291,3292,3293,3294,3295,3296,3297,3298,3299,3300,3301,3302,3303,3304,3305,3306,3307,3308,3309,3310,3311,3312,3313,3314,3315,3316,3317,3318,3319,3320,3321,3322,3323,3324,3325,3326,3327,3328,3329,3330,3331,3332,3333,3334,3335,3336,3337,3338,3339,3340,3341,3342,3343,3344,3345,3346,3347,3348,3349,3350,3351,3352,3353,3354,3355,3356,3357,3358,3359,3360,3361,3362,3363,3364,3365,3366,3367,3368,3369,3370,3371,3372,3373,3374,3375,3376,3377,3378,3379,3380,3381,3382,3383,3384,3385,3386,3387,3388,3389,3390,3391,3392,3393,3394,3395,3396,3397,3398,3399,3400,3401,3402,3403,3404,3405,3406,3407,3408,3411,3414,3415,3416,3417,3418,3