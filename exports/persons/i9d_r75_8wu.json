":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-059-he:line028-pei01-01:m0121","start":121,"end":124,"surface":"諸葛壹","kind":"person","person_id":"i9d_r75_8wu","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-059-he:line028-pei01-01","chapter_id":"c-sanguozhi-059-he"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-059-he:line028-pei01-01","text":"《吳書》曰：和少岐嶷有智意，故權尤愛幸，常在左右，衣服禮秩雕玩珍異之賜，諸子莫得比焉。好文學，善騎射，承師涉學，精識聦敏，尊敬師傅，愛好人物。穎等每朝見進賀，和常降意，歡以待之。講校經義，綜察是非，及訪諮朝臣，考績行能，以知優劣，各有條貫。後諸葛壹僞叛以誘魏將諸葛誕，權潛軍待之。和以權暴露外次，又戰者凶事，常憂勞憯怛，不復會同飲食，數上諫，戒令持重，務在全勝，權還，然後敢安。張純字元基，敦之子。","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-059-he:line028-pei01-01:m0006","start":6,"end":7,"surface":"和","kind":"person","person_id":"572_278_cba_A","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line028-pei01-01:m0015","start":15,"end":16,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line028-pei01-01:m0071","start":71,"end":72,"surface":"穎","kind":"person","person_id":"tm1_ycv_sdm","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line028-pei01-01:m0079","start":79,"end":80,"surface":"和","kind":"person","person_id":"572_278_cba_A","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line028-pei01-01:m0121","start":121,"end":124,"surface":"諸葛壹","kind":"person","person_id":"i9d_r75_8wu","status":"contextual_provisional","interpretation_note":"依本段姓名與上