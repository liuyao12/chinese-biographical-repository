":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-121-rulin:p020","text":"董仲舒，廣川人也。以治春秋，孝景時為博士。下帷講誦，弟子傳以久次相受業，或莫見其面，蓋三年董仲舒不觀於舍園，其精如此。進退容止，非禮不行，學士皆師尊之。今上即位，為江都相。以春秋災異之變推陰陽所以錯行，故求雨閉諸陽，縱諸陰，其止雨反是。行之一國，未嘗不得所欲。中廢為中大夫，居舍，著災異之記。是時遼東高廟災，主父偃疾之，取其書奏之天子。天子召諸生示其書，有刺譏。董仲舒弟子呂步舒不知其師書，以為下愚。於是下董仲舒吏，當死，詔赦之。於是董仲舒竟不敢復言災異。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m020-0000","start":0,"end":3,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0014","start":14,"end":16,"surface":"孝景","kind":"person","person_id":"yqp_nlb_p1p_ACA","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0026","start":26,"end":28,"surface":"弟子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m020-0045","start":45,"end":48,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0069","start":69,"end":71,"surface":"學士","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m020-0076","start":76,"end":78,"surface":"今上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0154","start":154,"end":157,"surface":"主父偃","kind":"person","person_id":"vbr_ff1_yc4","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0165","start":165,"end":167,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0168","start":168,"end":170,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0171","start":171,"end":173,"surface":"諸生","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m020-0181","start":181,"end":184,"s