rson","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":2312453,"source_layer":"received_biography","first_line":10,"last_line":10,"line_start":2,"line_end":24,"raw_start":148,"raw_end":170,"raw_character_offsets":[148,149,150,151,152,153,154,155,156,157,158,159,160,161,162,163,164,165,166,167,168,169],"projection_sha256":"001d472fac0658da2bc6f583661b93c7332769c3b9ab16e1b72d17a169ff6dc5","editorial_excerpt_boundary":true},"chapter_id":"c-chenshu-006-wangmeng-houzhu-context","book_id":"b-chenshu-006","work_id":"w-chenshu","source_id":"s-chenshu-006-wangmeng-houzhu-context-ws2312453"},{"id":"c-chenshu-017-yuanjing-complete:p002","text":"敬純孝有風格，幼便篤學，老而無倦。釋褐祕書郎，累遷太子舍人、洗馬、中舍人。江陵淪覆，流寓嶺表。高祖受禪，敬在廣州，依歐陽頠。及頠卒，其子紇據州，將有異志，敬累諫紇，為陳逆順之理，言甚切至，紇終不從。高宗即位，遣章昭達率红討紇，紇將敗之時，恨不納敬言。朝廷義之，其年徵為太子中庶子、通直散騎常侍。俄轉司徒左長史。尋遷左民尚書，轉都官尚書，領豫州大中正。累遷太常卿、散騎常侍、金紫光祿大夫，加特進。至德三年卒，時年七十九，贈左光祿大夫，諡曰靖德。子元友嗣。弟泌自有傳。兄子樞。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":49,"last_line":49,"raw_start":2621,"raw_end":2878,"raw_character_offsets":[2621,2622,2623,2624,2625,2626,2627,2628,2629,2630,2631,2632,2633,2634,2635,2636,2637,2638,2639,2640,2641,2642,2643,2644,2645,2646,2647,2648,2649,2650,2651,2652,2653,2654,2655,2656,2657,2658,2659,2660,2661,2662,2663,2664,2665,2666,2667,2668,2669,2670,2671,2672,2673,2674,2675,2676,2677,2678,2679,2680,2681,2682,2683,2684,2685,2686,2687,2688,2689,2690,2691,2692,2693,2694,2695,2696,2697,2698,2699,2700,2701,2702,2703,2704,2705,2706,2707,2708,2709,2710,2711,2712,2713,2714,2715,2716,2717,2718,2719,2720,2721,2722,2723,2724,2725,2726,2727,2728,2729,2730,2731,2732,2733,2734,2735,2736,2737,2738,2739,2740,2741,2742,2743,2744,2745,2746,2747,2748,2749,2750,2751,2752,2753,2754,2755,2756,2757,2758,2759,2760,2761,2762,2763,2764,2765,2766,2767,2768,2769,2770,2771,2772,2773,2774,2775,2776,2777,2778,2779,2780,2781,2782,2783,2784,2785,2786,278