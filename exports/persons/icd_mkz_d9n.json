，訪之，將加夷滅。母韋氏攜之遁於會稽，遂免。及長勤學不倦，博涉經史，兼習孫、呉兵法。以父遇酷，終文帝之世不聽音樂，蔬食布衣，以喪禮自處。宣帝立，乃始求位。太建初，釋褐鄱陽王府中兵參軍，再遷永陽王府録事參軍。","mentions":[{"id":"c-nanshi-024-wangmeng:p001:m0000","surface":"猛","start":0,"end":1,"person_id":"72e_1a7_3ac_AAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangmeng:p001:m0002","surface":"世雄","start":2,"end":4,"person_id":"72e_1a7_3ac_AAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangmeng:p001:m0007","surface":"勇","start":7,"end":8,"person_id":"72e_1a7_3ac_AAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangmeng:p001:m0013","surface":"清","start":13,"end":14,"person_id":"72e_1a7_3ac_AAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangmeng:p001:m0034","surface":"韋氏","start":34,"end":36,"person_id":"kal_g5t_q4f","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangmeng:p001:m0060","surface":"孫","start":60,"end":61,"person_id":"vax_w2r_0za","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangmeng:p001:m0062","surface":"呉","start":62,"end":63,"person_id":"61h_0sk_4pb","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":1765279,"source_layer":"received_biography","first_line":173,"last_line":173,"line_start":0,"line_end":127,"raw_start":8132,"raw_end":8259,"raw_character_offsets":[8132,8133,8134,8135,8136,8137,8138,8139,8140,8141,8142,8143,8144,8145,8146,8147,8148,8149,8150,8151,8152,8153,8154,8155,8156,8157,8158,8159,8160,8161,8162,8163,8164,8165,8166,8167,8168,8169,8170,8171,8172,8173,8174,8175,8176,8177,8178,8179,8180,8181,8182,8183,8184,8185,8186,8187,8188,8189,8190,8191,8192,