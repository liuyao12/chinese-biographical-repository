,7350,7351,7352,7353,7354,7355,7356,7357,7358,7359,7360,7361,7362,7363,7364],"projection_sha256":"8b8c7c42e2197aeecb818979f719f029cbfacbfb75134f4476fe273991982398"},"chapter_id":"c-nanshi-021-wangyang","book_id":"b-nanshi-021","work_id":"w-nanshi","source_id":"s-nanshi-021-wangyang-ws1752646"},{"id":"c-nanshi-023-wanggu-zijian:p003","text":"廢帝即位，授侍中、金紫光祿大夫。宣帝輔政，固以廢帝外戚，奶媼恒往來禁中，頗宣密旨，事泄，比黨皆誅，宣帝以固本無兵權，且居處清素，止免所居官，禁錮。太建中，卒于太常卿，諡恭子。","mentions":[{"id":"c-nanshi-023-wanggu-zijian:p003:m0021","surface":"固","start":21,"end":22,"person_id":"q7m_r8k_2vn_ABAE","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wanggu-zijian:p003:m0052","surface":"固","start":52,"end":53,"person_id":"q7m_r8k_2vn_ABAE","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":2478204,"source_layer":"received_biography","first_line":185,"last_line":185,"line_start":0,"line_end":87,"raw_start":13412,"raw_end":13499,"raw_character_offsets":[13412,13413,13414,13415,13416,13417,13418,13419,13420,13421,13422,13423,13424,13425,13426,13427,13428,13429,13430,13431,13432,13433,13434,13435,13436,13437,13438,13439,13440,13441,13442,13443,13444,13445,13446,13447,13448,13449,13450,13451,13452,13453,13454,13455,13456,13457,13458,13459,13460,13461,13462,13463,13464,13465,13466,13467,13468,13469,13470,13471,13472,13473,13474,13475,13476,13477,13478,13479,13480,13481,13482,13483,13484,13485,13486,13487,13488,13489,13490,13491,13492,13493,13494,13495,13496,13497,13498],"projection_sha256":"bde03fca9470b1cb9865bb83282a9aaaeb0f1807f9d9f767cb452930398c76f7","editorial_excerpt_boundary":true},"chapter_id":"c-nanshi-023-wanggu-zijian","book_id":"b-nanshi-023","work_id":"w-nanshi","source_id":"s-nanshi-023-wanggu-zijian-ws2478204"},{"id":"c-nanshi-023-wangzhi-zizhen:p003","text":"魏平荊州，侯瑱鎮盆城，與質不協，質率所部依於留異。陳永定二年，武帝命質率所部隨都督周文育討王琳。質與琳素善，或譖雲於軍中潛信交通，武帝命文育殺質，文育啟救之，獲免。文帝嗣位，以為五兵尚書。宣帝輔政，為司徒左長史。坐招聚博徒，免官。後為都官尚書。卒，諡曰安子。弟固。","mentions":[{"id":"c-nanshi-023-wangzhi-zizhen:p003:m0005","surface":"侯瑱","start":5,"end":7,"person_id":"8fx_ugl_pnj_A","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangzhi-zizhen:p003:m0012","surface":"質","start":12,"end":13,"person_id":"q7m_r8k_2vn_ABAD","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangzhi-zizhen:p003:m0016","surface":"質","start":16,"end":17,"person_id":"q7m_r8k_2vn_ABAD","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangzhi-zizhen:p003:m0022","surface":"留異","start":22,"end":24,"person_id":"ops_dvl_l64","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangzhi-zizhen:p003:m0034","surface":"質","start":34,"end":35,"person_id":"q7m_r8k_2vn_ABAD","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangzhi-zizhen:p003:m0041","surface":"周文育","start":41,"end":44,"person_id":"cea_x1n_2b8","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangzhi-zizhen:p003:m0045","surface":"王琳","start":45,"end":47,"person_id":"hu7_m9r_hro","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangzhi-zizhen:p003:m0048","surface":"質","start":48,"end":49,"person_id":"q7m_r8k_2vn_ABAD","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangzhi-zizhen:p003:m0050","surface":"琳","start":50,"end":51,"person_id":"hu7_m9r_hro","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangzhi-zizhen:p003:m0068","surface":"文育","start":68,"end":70,"person_id":"cea_x1n_2b8","kind":"person","status":"contextual_provisional","interpreta