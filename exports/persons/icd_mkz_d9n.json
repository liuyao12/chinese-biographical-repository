predicate":"father","qualifiers":{"source_term":"高宗嫡長子","nanshi024_wangmeng_reading":"shubao","lineage":"paternal","birth_order":{"parent_person_id":"icd_mkz_d9n","scope":"sons_of_parent","ordinal":1,"position":"eldest","interpretation_status":"source_attested"}},"evidence":[{"work_id":"w-chenshu","book_id":"b-chenshu-006","source_id":"s-chenshu-006-wangmeng-houzhu-context-ws2312453","chapter_id":"c-chenshu-006-wangmeng-houzhu-context","paragraph_id":"c-chenshu-006-wangmeng-houzhu-context:p001","quote":"後主諱叔寶，字元秀，小字黃奴，高宗嫡長子也。","subject_person_mention_id":"c-chenshu-006-wangmeng-houzhu-context:p001:m0003","object_person_reference_id":"c-chenshu-006-wangmeng-houzhu-context:p001:r0015","relationship_anchor":{"paragraph_id":"c-chenshu-006-wangmeng-houzhu-context:p001","surface":"高宗嫡長子","start":15,"end":20}}],"status":"source_attested","interpretation_note":"高宗嫡長子。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"title_holdings":[],"address_assertions":[],"person_references":[{"id":"c-chenshu-006-wangmeng-houzhu-context:p001:r0015","surface":"高宗","start":15,"end":17,"person_id":"icd_mkz_d9n","referent_role":"third_person","paragraph_id":"c-chenshu-006-wangmeng-houzhu-context:p001","quote":"後主諱叔寶，字元秀，小字黃奴，高宗嫡長子也。","note":"陳叔寶父。","chapter_id":"c-chenshu-006-wangmeng-houzhu-context","book_id":"b-chenshu-006","work_id":"w-chenshu","source_id":"s-chenshu-006-wangmeng-houzhu-context-ws2312453"},{"start":0,"end":2,"surface":"宣帝","id":"c-nanshi-021-wangyang:p002:r0000","paragraph_id":"c-nanshi-021-wangyang:p002","person_id":"icd_mkz_d9n","referent_role":"third_person","quote":"宣帝即位，曆中書令，吏部尚書。瑒性寬和，務清靜，無所抑揚。遷尚書左僕射，加侍中，參選事。","note":"本句按敘述視點回指陳宣。","chapter_id":"c-nanshi-021-wangyang","book_id":"b-nanshi-021","work_id":"w-nanshi","source_id":"s-nanshi-021-wangyang-ws1752646"},{"id":"c-nanshi-023-wanggu-zijian:p003:r0016","surface":"宣帝","start":16,"end":18,"person_id":"icd_mkz_d9n","referent_role":"third_person","paragraph_id":"c-nanshi-023-wanggu-zijian:p003","quote":"廢帝即位，授侍中、金紫光祿大夫。宣帝輔政，固以廢帝外戚，奶媼恒往來禁中，頗宣密旨，事泄，比黨皆誅，宣帝以固本無兵權，且居處清素，止免所居官，禁錮。太建中，卒于太常卿，諡恭子。","note":"按傳主、各朝年月、明文親稱與皇太子世系。","chapter_id":"c-nanshi-023-wanggu-zijian","book_id":"b-nanshi-023","work_id":"w-nanshi","source_id":"s-nanshi-023-wanggu-zijian-ws2478204"},{"id":"c-nanshi-023-wanggu-zijian:p003:r0049","surface":"宣帝","start":49,"end":51,"person_id":"icd_mkz_d9n","referent_role":"third_person","paragraph_id":"c-nanshi-023-wanggu-zijian:p003","quote":"廢帝即位，授侍中、金紫光祿大夫。宣帝輔政，固以廢帝外戚，奶媼恒往來禁中，頗宣密旨，事泄，比黨皆誅，宣帝以固本無兵權，且居處清素，止免所居官，禁錮。太建中，卒于太常卿，諡恭子。","note":"按傳主、各朝年月、明文親稱與皇太子世系。","chapter_id":"c-nanshi-023-wanggu-zijian","book_id":"b-nanshi-023","work_id":"w-nanshi","source_id":"s-nanshi-023-wanggu-zijian-ws2478204"},{"id":"c-nanshi-023-wangzhi-zizhen:p003:r0094","surface":"宣帝","start":94,"end":96,"person_id":"icd_mkz_d9n","referent_role":"third_person","paragraph_id":"c-nanshi-023-wangzhi-zizhen:p003","quote":"魏平荊州，侯瑱鎮盆城，與質不協，質率所部依於留異。陳永定二年，武帝命質率所部隨都督周文育討王琳。質與琳素善，或譖雲於軍中潛信交通，武帝命文育殺質，文育啟救之，獲免。文帝嗣位，以為五兵尚書。宣帝輔政，為司徒左長史。坐招聚博徒，免官。後為都官尚書。卒，諡曰安子。弟固。","note":"辨梁、陳兩武帝與陳世祖、高宗。","chapter_id":"c-nanshi-023-wangzhi-zizhen","book_id":"b-nanshi-023","work_id":"w-nanshi","source_id":"s-nanshi-023-wangzhi-zizhen-ws2478204"},{"id":"c-nanshi-024-wangmeng:p001:r0092","surface":"宣帝","start":92,"end":94,"person_id":"icd_mkz_d9n","referent_role":"third_person","paragraph_id":"c-nanshi-024-wangmeng:p001","quote":"猛字世雄，本名勇。五歳而父清遇害，陳文帝軍度浙江，訪之，將加夷滅。母韋氏攜之遁於會稽，遂免。及長勤學不倦，博涉經史，兼習孫、呉兵法。以父遇酷，終文帝之世不聽音樂，蔬食布衣，以喪禮自處。宣帝立，乃始求位。太建初，釋褐鄱陽王府中兵參軍，再遷永陽王府録事參軍。","note":"陳頊。","chapter_id":"c-nanshi-024-wangmeng","book_id":"b-nanshi-024","work_id":"w-nanshi","source_id":"s-nanshi-024-wangmeng-ws1765279"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[{"parent_person_id":"icd_mkz_d9n","scope":"sons_of_parent","ordinal":1,"position":"eldest","interpretation_status":"source_attested","assertion_id":"a-nanshi024-wangmeng-shubao","person_id":"icd_mkz_d9n_A","evidence":[{"work_id":"w-chenshu","book_id":