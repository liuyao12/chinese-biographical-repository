4","chapter_id":"c-jinshu-035-peikai-family"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-035-peikai-family:p014","text":"及季龍之世，彌加禮重。憲有二子：挹、㲄，並以文才知名。㲄仕季龍為太子中庶子、散騎常侍。挹、㲄俱豪俠耽酒，好臧否人物。與河間邢魚有隙，魚竊乘㲄馬奔段遼，為人所獲，魚誣㲄使己以季龍當襲鮮卑，告之為備。時季龍適謀伐遼，而與魚辭正合。季龍悉誅挹、㲄，憲亦坐免。未幾，復以為右光祿大夫、司徒、太傅，封安定郡公。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-035-peikai-family:p014:m0001","start":1,"end":3,"surface":"季龍","kind":"person","person_id":"u61_ylg_6av","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p014:m0011","start":11,"end":12,"surface":"憲","kind":"person","person_id":"c6e_8f3_014","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p014:m0016","start":16,"end":17,"surface":"挹","kind":"person","person_id":"kkq_tx8_oyk","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p014:m0018","start":18,"end":19,"surface":"㲄","kind":"person","person_id":"are_vqo_uxb","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p014:m0027","start":27,"end":28,"surface":"㲄","kind":"person","person_id":"are_vqo_uxb","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p014:m0029","start":29,"end":31,"surface":"季龍","kind":"person","person_id":"u61_ylg_6av","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p014:m0043","start":43,"end":44,"surface":"挹","kind":"person","person_id":"kkq_tx8_oyk","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p014:m0045","start":45,"end":46,"surface":"㲄","kind":"person","person_id":"are_vqo_uxb","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p014:m0061","start":61,"end":63,"surface":"邢魚","kind":"person","person_id":"279_4mx_ey9","status":"contextual_provisional"},{"id":"c-jinshu-035-pei