月初詣李安民，語論『張敬兒不應死』。安民道『敬兒書疏，墨迹炳然，卿何忽作此語』？其中多有不遜之言，小人不悉盡羅縷諳憶。」如其辭列，則與風聞符同。超宗罪自已彰，宜附常准。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-nanqishu-036-xiechaozong:p009:m0004","start":4,"end":7,"surface":"王永先","person_id":"tfp_yjk_ts4","kind":"person","status":"contextual_provisional","interpretation_note":"依同句、職稱與說話角色。"},{"id":"c-nanqishu-036-xiechaozong:p009:m0012","start":12,"end":14,"surface":"超宗","person_id":"aa6_83c_juy_CDAABA","kind":"person","status":"contextual_provisional","interpretation_note":"依同句、職稱與說話角色。"},{"id":"c-nanqishu-036-xiechaozong:p009:m0036","start":36,"end":38,"surface":"永先","person_id":"tfp_yjk_ts4","kind":"person","status":"contextual_provisional","interpretation_note":"依同句、職稱與說話角色。"},{"id":"c-nanqishu-036-xiechaozong:p009:m0044","start":44,"end":46,"surface":"超宗","person_id":"aa6_83c_juy_CDAABA","kind":"person","status":"contextual_provisional","interpretation_note":"依同句、職稱與說話角色。"},{"id":"c-nanqishu-036-xiechaozong:p009:m0065","start":65,"end":68,"surface":"張敬兒","person_id":"stv_g27_gl2","kind":"person","status":"contextual_provisional","interpretation_note":"依同句、職稱與說話角色。"},{"id":"c-nanqishu-036-xiechaozong:p009:m0077","start":77,"end":79,"surface":"敬兒","person_id":"stv_g27_gl2","kind":"person","status":"contextual_provisional","interpretation_note":"依同句、職稱與說話角色。"},{"id":"c-nanqishu-036-xiechaozong:p009:m0091","start":91,"end":94,"surface":"李安民","person_id":"4xf_x1f_vsg","kind":"person","status":"contextual_provisional","interpretation_note":"依同句、職稱與說話角色。"},{"id":"c-nanqishu-036-xiechaozong:p009:m0098","start":98,"end":101,"surface":"張敬兒","person_id":"stv_g27_gl2","kind":"person","status":"contextual_provisional","interpretation_note":"依同句、職稱與說話角色。"},{"id":"c-nanqishu-036-xiechaozong:p009:m0106","start":106,"end":108,"surface":"安民","person_id":"4xf_x1f_vsg","kind":"person","status":"contextual_provisional","interpretation_note":"依同句、職稱與說話角色。"},{"id":"c-nanqishu-036-xiechaozong:p009:m0110","start":110,"end":1