":"c-liangshu-007-xuzhaopei","paragraph_id":"c-liangshu-007-xuzhaopei:p001","quote":"世祖徐妃，諱昭佩，東海郯人也。祖孝嗣，太尉、枝江文忠公。父緄，侍中、信武將軍。天監十六年十二月，拜湘東王妃。生世子方等、益昌公主含貞。太清三年五月，被譴死，葬江陵瓦官寺。","subject_person_mention_id":"c-liangshu-007-xuzhaopei:p001:m0006","object_person_mention_id":"c-liangshu-007-xuzhaopei:p001:m0029","relationship_anchor":{"paragraph_id":"c-liangshu-007-xuzhaopei:p001","surface":"父緄","start":28,"end":30}}],"status":"contextual_provisional","interpretation_note":"父緄。","human_reviewed":false}},{"id":"tvq_5nw_rqn_AB","label":"徐君蒨（字懷簡，徐緄子）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"君蒨","mention_ids":["c-nanshi-015-xujunqian-yuhong:p001:m0002"]},{"surface":"懷簡","mention_ids":["c-nanshi-015-xujunqian-yuhong:p001:m0005"]},{"surface":"徐","mention_ids":["c-nanshi-015-xujunqian-yuhong:p002:m0025"]}],"evidence":[{"mention_id":"c-nanshi-015-xujunqian-yuhong:p001:m0002","paragraph_id":"c-nanshi-015-xujunqian-yuhong:p001","chapter_id":"c-nanshi-015-xujunqian-yuhong","quote":"君蒨"},{"mention_id":"c-nanshi-015-xujunqian-yuhong:p001:m0005","paragraph_id":"c-nanshi-015-xujunqian-yuhong:p001","chapter_id":"c-nanshi-015-xujunqian-yuhong","quote":"懷簡"},{"mention_id":"c-nanshi-015-xujunqian-yuhong:p002:m0025","paragraph_id":"c-nanshi-015-xujunqian-yuhong:p002","chapter_id":"c-nanshi-015-xujunqian-yuhong","quote":"徐"}],"review":"ai_provisional","identity_note":"徐君蒨（字懷簡，徐緄子），見本組原文及身份互校。","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"tvq_5nw_rqn_A","source_assertion_id":"a-liang028-junqian-father","evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-015","chapter_id":"c-nanshi-015-xujunqian-yuhong","source_id":"s-nanshi-015-xujunqian-yuhong-ws1659582","paragraph_id":"c-nanshi-015-xujunqian-yuhong:p001","quote":"緄子君蒨字懷簡，幼聰朗好學，尤長丁部書，問無不對。善弦歌，為梁湘東王鎮西諮議參軍。","subject_person_mention_id":"c-nanshi-015-xujunqian-yuhong:p001:m0002","object_person_mention_id":"c-nanshi-015-xujunqian-yuhong:p001:m0000","source_term":"緄子君蒨"}],"stat