{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003553","identity_policy":"contextual_provisional","person_ids":["cbr-p003553"],"persons":[{"id":"cbr-p003553","label":"鄒陽（梁孝王世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"鄒陽","mention_ids":["c-shiji-058-liang:m006-0125"]}],"evidence":[{"mention_id":"c-shiji-058-liang:m006-0125","chapter_id":"c-shiji-058-liang","paragraph_id":"c-shiji-058-liang:p006","quote":"鄒陽"}]}],"mentions":[{"id":"c-shiji-058-liang:m006-0125","start":125,"end":127,"surface":"鄒陽","kind":"person","person_id":"cbr-p003553","status":"contextual_provisional","paragraph_id":"c-shiji-058-liang:p006","chapter_id":"c-shiji-058-liang"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji058-014","person_id":"cbr-p003553","surfaces":["鄒陽"],"scope":"same_chapter","chapter_ids":["c-shiji-058-liang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-058-liang:p006","quote":"孝王，竇太后少子也，愛之，賞賜不可勝道。於是孝王筑東苑，方三百餘里。廣睢陽城七十里。大治宮室，為複道，自宮連屬於平臺三十餘里。得賜天子旌旗，出從千乘萬騎。東西馳獵，擬於天子。出言蹕，入言警。招延四方豪桀，自山以東游說之士。莫不畢至，齊人羊勝、公孫詭、鄒陽之屬。公孫詭多奇邪計，初見王，賜千金，官至中尉，梁號之曰公孫將軍，梁多作兵器弩弓矛數十萬，而府庫金錢且百巨萬，珠玉寶器多於京師。"}],"rationale":"按明示姓名、世系與局部王號暫接。梁武、勝、參、登、義、買、襄等不按同王號合併；梁王勝與羊勝分辨。李太后陳太后分存；主張、指控、泛稱與授職分辨，正文與附述各保留。官爵全史與跨篇身份仍待覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-058-liang:p006","text":"孝王，竇太后少子也，愛之，賞賜不可勝道。於是孝王筑東苑，方三百餘里。廣睢陽城七十里。大治宮室，為複道，自宮連屬於平臺三十餘里。得賜天子旌旗，出從千乘萬騎。東西馳獵，擬於天子。出言蹕，入言警。招延四方豪桀，自山以東游說之士。莫不畢至，齊人羊勝、公孫詭、鄒陽之屬。公孫詭多奇邪計，初見王，賜千金，官至中尉，梁號之曰公孫將軍，梁多作兵器弩弓矛數十萬，而府庫金錢且百巨萬，珠玉寶器多於京師。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-058-liang:m006-0000","start":0,"end":2,"surface":"孝王","kind":"person","person_id":"cbr-p003540","status":"contextual_provisional"},{"id":"c-shiji-058-liang:m006-0003","start":3,"end":6,"surface":"竇太后","kind":"person","person