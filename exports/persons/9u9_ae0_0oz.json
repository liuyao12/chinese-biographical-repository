033","start":33,"end":37,"surface":"侯封之家","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m002-0038","start":38,"end":40,"surface":"孝景","kind":"person","person_id":"yqp_nlb_p1p_ACA","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m002-0042","start":42,"end":44,"surface":"晁錯","kind":"person","person_id":"04u_gq0_nke_A","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m002-0063","start":63,"end":64,"surface":"錯","kind":"person","person_id":"04u_gq0_nke_A","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m002-0065","start":65,"end":66,"surface":"錯","kind":"person","person_id":"04u_gq0_nke_A","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m002-0074","start":74,"end":76,"surface":"郅都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m002-0077","start":77,"end":79,"surface":"寧成","kind":"person","person_id":"9u9_ae0_0oz","status":"contextual_provisional"}],"chapter_id":"c-shiji-122-kuli","book_id":"b-shiji-122","work_id":"w-shiji","source_id":"s-shiji122-kuli"},{"id":"c-shiji-122-kuli:p008","text":"寧成者，穰人也。以郎謁者事景帝。好氣，爲人小吏，必陵其長吏；爲人上，操下如束濕薪。滑賊任威。稍遷至濟南都尉，而郅都爲守。始前數都尉皆歩入府，因吏謁守如縣令，其畏郅都如此。及成往，直陵都出其上。都素聞其聲，於是善遇，與結驩。久之，郅都死，後長安左右宗室多暴犯法，於是上召寧成爲中尉。其治效郅都，其廉弗如，然宗室豪桀皆人人惴恐。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-122-kuli:m008-0000","start":0,"end":2,"surface":"寧成","kind":"person","person_id":"9u9_ae0_0oz","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m008-0013","start":13,"end":15,"surface":"景帝","kind":"person","person_id":"yqp_nlb_p1p_ACA","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m008-0027","start":27,"end":29,"surface":"長吏","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m008-0051","start":51,"end":53,"surface":"都尉","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m008-0055","start":55,"end":57,"surface":"郅都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m008-0063","start":63,"end":65,"surface":"都尉","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m008-0080","start":80,"end":82,"surface":"郅都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m008-0086","start":86,"end":87,"surface":"成","kind":"person","person_id":"9u9_ae0_0oz","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m008-0091","start":91,"end":92,"surface":"都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m008-0096","start":96,"end":97,"surface":"都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m008-0114","start":114,"end":116,"surface":"郅都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m008-0119","start":119,"end":125,"surface":"長安左右宗室","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m008-0132","start":132,"end":133,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_ACA","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m008-0134","start":134,"end":136,"surface":"寧成","kind":"person","person_id":"9u9_ae0_0oz","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m008-0143","start":143,"end":145,"surface":"郅都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m008-0152","start":152,"end":156,"surface":"宗室豪桀","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-122-kuli","book_id":"b-shiji-122","work_id":"w-shiji","source_id":"s-shiji122-kuli"},{"id":"c-shiji-122-kuli:p009","text":"武帝卽位，徙爲内史。外戚多毀成之短，抵罪髡鉗。是時九卿罪死卽死，少被刑，而成極刑，自以爲不復收，於是解脱，詐刻傳出關歸家。稱曰：「仕不至二千石，賈不至千萬，安可比人乎！」乃貰貸買陂田千餘頃，假貧民，役使數千家。數年，會赦。致産數千金，爲任俠，持吏長短，出從數十騎。其使民威重於郡守。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-122-kuli:m009-0000","start":0,"end":2,"surface":"武帝","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m009-0010","start":10,"end":12,"surface":"外戚","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m009-0014","start":14,"end":15,"surface":"成","kind":"person","person_id":"9u9_ae0_0oz","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m009-0037","start":37,"end":38,"surface":"成","kind":"person","person_id":"9u9_ae0_0oz","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m009-0096","start":96,"end":98,"surface":"貧民","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-122-kuli","book_id":"b-shiji-122","work_id":"w-shiji","source_id":"s-shiji122-kuli"},{"id":"c-shiji-122-kuli:p012","text":"自寧成、周陽由之後，事益多，民巧法，大抵吏之治類多成、由等矣。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-122-kuli:m012-0001","start":1,"end":3,"surface":"寧成","kind":"person","person_id":"9u9_ae0_0oz","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m012-0004","start":4,"end":7,"surface":"周陽由","kind":"person","person_id":"xgx_g4a_c28_A","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m012-0025","start":25,"end":26,"surface":"成","kind":"person","person_id":"9u9_ae0_0oz","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m012-0027","start":27,"end":28,"surface":"由","kind":"person","person_id":"xgx_g4a_c28_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-122-kuli","book_id":"b-shiji-122","work_id":"w-shiji","source_id":"s-shiji122-kuli"},{"id":"c-shiji-122-kuli:p015","text":"周陽侯始爲諸卿時，嘗繋長安，湯傾身爲之。及出爲侯，大與湯交，遍見湯貴人。湯給事内史，爲寧成掾，以湯爲無害，言大府，調爲茂陵尉，治方中。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-122-kuli:m015-0000","start":0,"end":3,"surface":"周陽侯","kind":"person","person_id":"rni_3ug_2rn","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m015-0005","start":5,"end":7,"surface":"諸卿","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m015-0014","start":14,"end":15,"surface":"湯","kind":"person","person_id":"1ex_se1_yef_A","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m015-0027","start":27,"end":28,"surface":"湯","kind":"person","person_id":"1ex_se1_yef_A","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m015-0032","start":32,"end":33,"surface":"湯","kind":"person","person_id":"1ex_se1_yef_A","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m015-0033","start":33,"end":35,"surface":"貴人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m015-0036","start":36,"end":37,"surface":"湯","kind":"person","person_id":"1ex_se1_yef_A","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m015-0043","start":43,"end":45,"surface":"寧成","kind":"person","person_id":"9u9_ae0_0oz","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m015-0048","start":48,"end":49,"surface":"湯","kind":"person","person_id":"1ex_se1_yef_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-122-kuli","book_id":"b-shiji-122","work_id":"w-shiji","source_id":"s-shiji122-kuli"},{"id":"c-shiji-122-kuli:p027","text":"寧成家居，上欲以爲郡守。御史大夫弘曰：「臣居山東爲小吏時，寧成爲濟南都尉，其治如狼牧羊。成不可使治民。」上乃拜成爲關都尉。歳餘，關東吏隸郡國出入關者，號曰「寧見乳虎，無値寧成之怒」。義縱自河内遷爲南陽太守，聞寧成家居南陽，及縱至關，寧成側行送迎，然縱氣盛，弗爲禮。至郡，遂案寧氏，盡破碎其家。成坐有罪，及孔、暴之屬皆奔亡，南陽吏民重足一跡。而平氏朱彊、杜衍、杜周爲縱牙爪之吏，任用，遷爲廷史。軍數出定襄，定襄吏民亂敗，於是徙縱爲定襄太守。縱至，掩定襄獄中重罪輕繋二百餘人，及賓客昆弟私入相視亦二百餘人。縱一捕鞠，曰「爲死罪解脱」。是日皆報殺四百餘人。其後郡中不寒而栗，猾民佐吏爲治。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-122-kuli:m027-0000","start":0,"end":2,"surface":"寧成","kind":"person","person_id":"9u9_ae0_0oz","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m027-0005","start":5,"end":6,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m