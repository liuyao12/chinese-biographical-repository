son_id":"sg1_243_d92","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m027-0231","start":231,"end":235,"surface":"二百餘人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m027-0237","start":237,"end":241,"surface":"賓客昆弟","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m027-0246","start":246,"end":250,"surface":"二百餘人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m027-0251","start":251,"end":252,"surface":"縱","kind":"person","person_id":"sg1_243_d92","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m027-0270","start":270,"end":274,"surface":"四百餘人","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-122-kuli","book_id":"b-shiji-122","work_id":"w-shiji","source_id":"s-shiji122-kuli"},{"id":"c-shiji-122-kuli:p031","text":"尹齊者，東郡茌平人。以刀筆稍遷至御史。事張湯，張湯數稱以爲廉武，使督盜賊，所斬伐不避貴戚。遷爲關内都尉，聲甚於寧成。上以爲能，遷爲中尉，吏民益凋敝。尹齊木彊少文，豪惡吏伏匿而善吏不能爲治，以故事多廢，抵罪。上復徙温舒爲中尉，而楊仆以嚴酷爲主爵都尉。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-122-kuli:m031-0000","start":0,"end":2,"surface":"尹齊","kind":"person","person_id":"m6r_c9h_kjq","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m031-0020","start":20,"end":22,"surface":"張湯","kind":"person","person_id":"04o_yps_sg0","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m031-0023","start":23,"end":25,"surface":"張湯","kind":"person","person_id":"04o_yps_sg0","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m031-0055","start":55,"end":57,"surface":"寧成","kind":"person","person_id":"9u9_ae0_0oz","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m031-0058","start":58,"end":59,"surface":"上","kind":"person","person_id":"ln1_tyi_kei","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m031-0074","start":74,"end":76,"surface":"尹齊","kind":"person","person_id":"m6r_c9h_kjq","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m031-0