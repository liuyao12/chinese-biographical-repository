6","start":116,"end":118,"surface":"寧成","kind":"person","person_id":"9u9_ae0_0oz","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p027","chapter_id":"c-shiji-122-kuli"},{"id":"c-shiji-122-kuli:m027-0146","start":146,"end":147,"surface":"成","kind":"person","person_id":"9u9_ae0_0oz","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p027","chapter_id":"c-shiji-122-kuli"},{"id":"c-shiji-122-kuli:m031-0055","start":55,"end":57,"surface":"寧成","kind":"person","person_id":"9u9_ae0_0oz","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p031","chapter_id":"c-shiji-122-kuli"}],"relations":[],"title_holdings":[{"id":"th-shiji122-007","person_id":"9u9_ae0_0oz","title":"郎","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-122-kuli","source_id":"s-shiji122-kuli","paragraph_id":"c-shiji-122-kuli:p008","quote":"寧成者，穰人也。以郎謁者事景帝。好氣，爲人小吏，必陵其長吏；爲人上，操下如束濕薪。滑賊任威。稍遷至濟南都尉，而郅都爲守。始前數都尉皆歩入府，因吏謁守如縣令，其畏郅都如此。及成往，直陵都出其上。都素聞其聲，於是善遇，與結驩。久之，郅都死，後長安左右宗室多暴犯法，於是上召寧成爲中尉。其治效郅都，其廉弗如，然宗室豪桀皆人人惴恐。"}],"attestations":[{"id":"th-shiji122-007:a001","paragraph_id":"c-shiji-122-kuli:p008","start":9,"end":10,"surface":"郎","person_mention_id":"c-shiji-122-kuli:m008-0000","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"依原文區分授任、貶任與用稱；未明日期保持未知，死亡不自動終止官爵。敘事時長不反推公元年。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji122-008","person_id":"9u9_ae0_0oz","title":"謁者","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-122-kuli","source_id":"s-shiji122-kuli","paragraph_id":"c-shiji-122-kuli:p008","quote":"寧成者，穰人也。以郎謁者事景帝。好氣，爲人小吏，必陵其長吏；爲人上，操下如束濕薪。滑賊任威。稍遷至濟南都尉，而郅都爲守。始前數都尉皆歩入府，因吏謁守如縣令，其畏郅都如此。及成往，直陵都出其上。都素聞其聲，於是善遇，與結驩。久之，郅都死，後長安左右宗室多暴犯法，於是上召寧成爲中尉。其治效郅都，其廉弗如，然宗室豪桀皆人人惴恐。"}],"attestations":[{"id":"th-shiji122-008:a001","paragr