ull,"modern_identification":null},"status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-033-lu","source_id":"s-shiji-033-lu","paragraph_id":"c-shiji-033-lu:p057","quote":"十八年二月，文公卒。文公有二妃：長妃齊女爲哀姜，生子惡及視；次妃敬嬴，嬖愛，生子俀。俀私事襄仲，襄仲欲立之，叔仲曰不可。襄仲請齊惠公，惠公新立，欲親魯，許之。冬十月，襄仲殺子惡及視而立俀，是爲宣公。哀姜歸齊，哭而過市，曰：『天乎！襄仲爲不道，殺適立庶！』市人皆哭，魯人謂之『哀姜』。魯由此公室卑，三桓彊。","person_mention_id":"c-shiji-033-lu:m057-0021"}],"source_term":"哀姜歸齊","interpretation_note":"保存原文地名或相對位置，不補今日行政區或座標。出奔、居住、死亡、埋葬分屬不同主張，不以封邑、葬願或請求推定完成遷居。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji033-134","person_id":"wsa_z5d_frx","surfaces":["哀姜"],"scope":"same_chapter","chapter_ids":["c-shiji-033-lu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-033-lu:p057","quote":"十八年二月，文公卒。文公有二妃：長妃齊女爲哀姜，生子惡及視；次妃敬嬴，嬖愛，生子俀。俀私事襄仲，襄仲欲立之，叔仲曰不可。襄仲請齊惠公，惠公新立，欲親魯，許之。冬十月，襄仲殺子惡及視而立俀，是爲宣公。哀姜歸齊，哭而過市，曰：『天乎！襄仲爲不道，殺適立庶！』市人皆哭，魯人謂之『哀姜』。魯由此公室卑，三桓彊。"}],"rationale":"按文公以後立嗣、昭公出奔、夾谷會盟、徵百牢與魯君世系的具體事件及國別暫定異稱，後期同爵稱不與先君混同。身份、匿名指代與數位疑讀待覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"identity_distinctions":[{"id":"d-shiji033-distinct-005","person_ids":["tke_fad_hlp","wsa_z5d_frx"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-033-lu:p045","quote":"莊公有三弟，長曰慶父，次曰叔牙，次曰季友。莊公取齊女爲夫人曰哀姜。哀姜無子。哀姜娣曰叔姜，生子開。莊公無適嗣，愛孟女，欲立其子斑。莊公病，而問嗣於弟叔牙。叔牙曰：『一繼一及，魯之常也。慶父在，可爲嗣，君何憂？』莊公患叔牙欲立慶父，退而問季友。季友曰：『請以死立斑也。』莊公曰：『曩者叔牙欲立慶父，柰何？』季友以莊公命命牙待於鍼巫氏，使鍼季劫飲叔牙以鴆，曰：『飲此則有後奉祀；不然，死且無後。』牙遂飲鴆而死，魯立其子爲叔孫氏。八月癸亥，莊公卒，季友竟立子斑爲君，如莊公命。侍喪，舍于黨氏。","chapter_id":"c-shiji-033-lu","work_id":"w-shiji","book_id":"b-shiji-033","source_id":"s-shiji-033-lu"},{"paragraph_id":"c-shiji-033-lu:p057","quote":"十八年二月，文公卒。文公有二妃：長妃齊女爲哀姜，生子惡及視；次妃敬嬴，嬖愛，生子俀。俀私事襄仲，襄仲欲立之，叔仲曰不可。襄仲請齊惠公，惠公新立，欲親魯，許之。冬十月，襄仲殺子惡及視而立俀，是爲宣公。哀姜歸齊，哭而過市，曰：『天乎！襄仲爲不道，殺適立庶！』市人皆哭，魯人謂之『哀姜』。魯由此公室卑，三桓彊。","chapter_id":"c-shiji-033-lu","work_id":"w-shiji","book_id":"b-shiji-033","source_id":"s-shiji-033-lu"}],"rationale":"一者為莊公夫人，另一者為後文文公長妃；同稱哀姜不代表同一女性。","reviewer":"Codex（AI 代理）"}],"passages":[{"id":"c-shiji-033-lu:p045","text":"莊公有三弟，長曰慶父，次曰叔牙，次曰季友。莊公取齊女爲夫人曰哀姜。哀姜無子。哀姜娣曰叔姜，生子開。莊公無適嗣，愛孟女，欲立其子斑。莊公病，而問嗣於弟叔牙。叔牙曰：『一繼一及，魯之常也。慶父在，可爲嗣，君何憂？』莊公患叔牙欲立慶父，退而問季友。季友曰：『請以死立斑也。』莊公曰：『曩者叔牙欲立慶父，柰何？』季友以莊公命命牙待於鍼巫氏，使鍼季劫飲叔牙以鴆，曰：『飲此則有後奉祀；不然，死且無後。』牙遂飲鴆而死，魯立其子爲叔孫氏。八月癸亥，莊公卒，季友竟立子斑爲君，如莊公命。侍喪，舍于黨氏。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-033-lu:m045-0000","start":0,"end":2,"surface":"莊公","kind":"person","person_id":"x50_1p7_qkk","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m045-0008","start":8,"end":10,"surface":"慶父","kind":"person","person_id":"k6c_jbs_1gw","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m045-0013","start":13,"end":15,"surface":"叔牙","kind":"person","person_id":"a9m_987_rss","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m045-0018","start":18,"end":20,"surface":"季友","kind":"person","person_id":"lc6_cup_v9c_ABA","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m045-0021","start":21,"end":23,"surface":"莊公","kind":"person","person_id":"x50_1p7_qkk","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m045-0030","start":30,"end":32,"surface":"哀姜","kind":"person","person_id":"tke_fad_hlp","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m045-0033","start":33,"end":35,"surface":"哀姜","kind":"person","person_id":"tke_fad_hlp","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m045-0038","start":38,"end":40,"surface":"哀姜","kind":"person","person_id":"tke_fad_hlp","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m045-0042","start":42,"end":44,"surface":"叔姜","kind":"person","person_id":"2vc_12q_w0e","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m045-0046","start":46,"end":48,"surface":"子開","kind":"person","person_id":"x50_1p7_qkk_A","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m045-0049","start":49,"en