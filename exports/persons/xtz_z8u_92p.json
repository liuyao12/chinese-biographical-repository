010-wendi:p027"],"passage_count":1},{"source_id":"s-shiji-103-wanshi","work_id":"w-shiji","book_id":"b-shiji-103","chapter_id":"c-shiji-103-wanshi","mention_count":1,"mention_ids":["c-shiji-103-wanshi:m002-0004"],"paragraph_ids":["c-shiji-103-wanshi:p002"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-102-zhangfeng"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-010-wendi:m027-0124","start":124,"end":127,"surface":"張相如","kind":"person","person_id":"l7w_xfi_scd","status":"contextual_provisional","paragraph_id":"c-shiji-010-wendi:p027","chapter_id":"c-shiji-010-wendi"},{"id":"c-shiji-102-zhangfeng:m002-0128","start":128,"end":134,"surface":"東陽侯張相如","kind":"person","person_id":"xtz_z8u_92p","status":"contextual_provisional","paragraph_id":"c-shiji-102-zhangfeng:p002","chapter_id":"c-shiji-102-zhangfeng"},{"id":"c-shiji-102-zhangfeng:m002-0158","start":158,"end":161,"surface":"東陽侯","kind":"person","person_id":"xtz_z8u_92p","status":"contextual_provisional","paragraph_id":"c-shiji-102-zhangfeng:p002","chapter_id":"c-shiji-102-zhangfeng"},{"id":"c-shiji-103-wanshi:m002-0004","start":4,"end":10,"surface":"東陽侯張相如","kind":"person","person_id":"y8g_kfz_51h","status":"contextual_provisional","paragraph_id":"c-shiji-103-wanshi:p002","chapter_id":"c-shiji-103-wanshi"}],"relations":[],"title_holdings":[{"id":"th-shiji102-008","person_id":"xtz_z8u_92p","title":"東陽侯","kind":"noble_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-102-zhangfeng","source_id":"s-shiji-102-zhangfeng","paragraph_id":"c-shiji-102-zhangfeng:p002","quote":"釋之從行，登虎圈。上問上林尉諸禽獸簿，十餘問，尉左右視，盡不能對。虎圈嗇夫從旁代尉對上所問禽獸簿甚悉，欲以觀其能口對響應無窮者。文帝曰：「吏不當若是邪？尉無賴！」乃詔釋之拜嗇夫爲上林令。釋之久之前曰：「陛下以絳侯周勃何如人也？」上曰：「長者也。」又復問：「東陽侯張相如何如人也？」上復曰：「長者。」釋之曰：「夫絳侯、東陽侯稱爲長者，此兩人言事曾不能出口，豈斅此嗇夫諜諜利口捷給哉！且秦以任刀筆之吏，吏爭以亟疾苛察相高，然其敝徒文具耳，無惻隱之實。以故不聞其過，陵遲而至於二世，天下土崩。今陛下以嗇夫口辯而超遷之，臣恐天下隨風靡靡，爭爲口辯而無其實。且下之化上疾於景響，舉錯不可不審也。」文帝曰：「善。」乃止不拜嗇夫。"}],"attestations":[{"id":"th-shiji102-008:a001","paragraph_id":"c-shiji-102-zhangfeng:p002","start":128,"end":131,"surface":"東陽侯","person_mention_id":"c-shiji-102-zhangfeng:m002-0128","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授官與用稱分存，未以後任或死亡推終點。官（卒）［率］將保留校勘符號，不擇定官名。嗇夫上林令任命諫止，不記已任。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji103-005","person_id":"y8g_kfz_51h","title":"東陽侯","kind":"noble_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-103-wanshi","source_id":"s-shiji-103-wanshi","paragraph_id":"c-shiji-103-wanshi:p002","quote":"文帝時，東陽侯張相如爲太子太傅，免。選可爲傅者，皆推奮，奮爲太子太傅。及孝景即位，以爲九卿；迫近，憚之，徙奮爲諸侯相。奮長子建，次子甲，次子乙，次子慶，皆以馴行孝謹，官皆至二千石。於是景帝曰：「石君及四子皆二千石，人臣尊寵乃集其門。」號奮爲萬石君。"}],"attestations":[{"id":"th-shiji103-005:a001","paragraph_id":"c-shiji-103-wanshi:p002","start":4,"end":7,"surface":"東陽侯","person_mention_id":"c-shiji-103-wanshi:m002-0004","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授官、爵位、俸秩與敘事用稱分存；未知起訖不補造，卒日不自動終止全部稱號，未准乞骸骨不作辭相。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji103-006","person_id":"y8g_kfz_51h","title":"太子太傅","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-103-wanshi","source_id":"s-shiji-103-wanshi","paragraph_id":"c-shiji-103-wanshi:p002","quote":"文帝時，東陽侯張相如爲太子太傅，免。選可爲傅者，皆推奮，奮爲太子太傅。及孝景即位，以爲九卿；迫近，憚之，徙奮爲諸侯相。奮長子建，次子甲，次子乙，次子慶，皆以馴行孝謹，官皆至二千石。於是景帝曰：「石君及四子皆二千石，人臣尊寵乃集其門。」號奮爲萬石君。"}],"attestations":[{"id":"th-shiji103-006:a001","paragraph_id":"c-shiji-103-wanshi:p002","start":11,"end":15,"surface":"太子太傅","person_mention_id":"c-shiji-103-wanshi:m002-0004","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"source_event","event_type":"explicit_end","date_expression":null,"evidence":[{"chapter_id":"c-shiji-103-wanshi","source_id":"s-shiji-103-wanshi","paragraph_id":"c-shiji-103-wanshi:p002","quote":"文帝時，東陽侯張相如爲太子太傅，免。選可爲傅者，皆推奮，奮爲太子太傅。及孝景即位，以爲九卿；迫近，憚之，徙奮爲諸侯相。奮長子建，次子甲，次子乙，次子慶，皆以馴行孝謹，官皆至二千石。於是景帝曰：「石君及四子皆二千石，人臣尊寵乃集其門。」號奮爲萬石君。"}]}},"interpretation_note":"授官、爵位、俸秩與敘事用稱分存；未知起訖不補造，卒日不自動終止全部稱號，未准乞骸骨不作辭相。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji102-001","person_id":"xtz_z8u_92p","surfaces":["東陽侯","東陽侯張相如"],"scope":"same_chapter","chapter_ids":["c-shiji-102-zhangfeng"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-102-zhangfeng:p002","quote":"釋之從行，登虎圈。上問上林尉諸禽獸簿，十餘問，尉左右視，盡不能對。虎圈嗇夫從旁代尉對上所問禽獸簿甚悉，欲以觀其能口對響應無窮者。文帝曰：「吏不當若是邪？尉無賴！」乃詔釋之拜嗇夫爲上林令。釋之久之前曰：「陛下以絳侯周勃何如人也？」上曰：「長者也。」又復問：「東陽侯張相如何如人也？」上復曰：「長者。」釋之曰：「夫絳侯、東陽侯稱爲長者，此兩人言事曾不能出口，豈斅此嗇夫諜諜利口捷給哉！且秦以任刀筆之吏，吏爭以亟疾苛察相高，然其敝徒文具耳，無惻隱之實。以故不聞其過，陵遲而至於二世，天下土崩。今陛下以嗇夫口辯而超遷之，臣恐天下隨風靡靡，爭爲口辯而無其實。且下之化上疾於景響，舉錯不可不審也。」文帝曰：「善。」乃止不拜嗇夫。"}],"rationale":"按本篇姓名、稱號及敘事承接逐處判讀；尚未作同名跨篇合併，身份與官稱回指待覆核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji103-001","person_id":"y8g_kfz_51h","surfaces":["東陽侯張相如"],"scope":"same_chapter","chapter_ids":["c-shiji-103-wanshi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-103-wanshi:p002","quote":"文帝時，東陽侯張相如爲太子太傅，免。選可爲傅者，皆推奮，奮爲太子太傅。及孝景即位，以爲九卿；迫近，憚之，徙奮爲諸侯相。奮長子建，次子甲，次子乙，次子慶，皆以馴行孝謹，官皆至二千石。於是景帝曰：「石君及四子皆二千石，人臣尊寵乃集其門。」號奮爲萬石君。"}],"rationale":"依本篇姓名、稱號、名歐及名仁等明示與敘事承接判讀；來源原字保留，未自動跨篇同名合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji102-zhang-xiangru","person_ids":["xtz_z8u_92p","l7w_xfi_scd"],"canonical_person_id":"l7w_xfi_scd","scope":"cross_chapter","chapter_ids":["c-shiji-010-wendi","c-shiji-102-zhangfeng"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-102-zhangfeng","source_id":"s-shiji-102-zhangfeng","paragraph_id":"c-shiji-102-zhangfeng:p002","quote":"釋之從行，登虎圈。上問上林尉諸禽獸簿，十餘問，尉左右視，盡不能對。虎圈嗇夫從旁代尉對上所問禽獸簿甚悉，欲以觀其能口對響應無窮者。文帝曰：「吏不當若是邪？尉無賴！」乃詔釋之拜嗇夫爲上林令。釋之久之前曰：「陛下以絳侯周勃何如人也？」上曰：「長者也。」又復問：「東陽侯張相如何如人也？」上復曰：「長者。」釋之曰：「夫絳侯、東陽侯稱爲長者，此兩人言事曾不能出口，豈斅此嗇夫諜諜利口捷給哉！且秦以任刀筆之吏，吏爭以亟疾苛察相高，然其敝徒文具耳，無惻隱之實。以故不聞其過，陵遲而至於二世，天下土崩。今陛下以嗇夫口辯而超遷之，臣恐天下隨風靡靡，爭爲口辯而無其實。且下之化上疾於景響，舉錯不可不審也。」文帝曰：「善。」乃止不拜嗇夫。","mention_ids":["c-shiji-102-zhangfeng:m002-0128","c-shiji-102-zhangfeng:m002-0158"]},{"chapter_id":"c-shiji-010-wendi","source_id":"s-shiji-010-wendi","paragraph_id":"c-shiji-010-wendi:p027","quote":"十四年冬，匈奴謀入邊為寇，攻朝那塞，殺北地都尉卬。上乃遣三將軍軍隴西、北地、上郡，中尉周舍為衛將軍，郎中令張武為車騎將軍，軍渭北，車千乘，騎卒十萬。帝親自勞軍，勒兵申教令，賜軍吏卒。帝欲自將擊匈奴，群臣諫，皆不聽。皇太后固要帝，帝乃止。於是以東陽侯張相如為大將軍，成侯赤為內史，欒布為將軍，擊匈奴。匈奴遁走。","mention_ids":["c-shiji-010-wendi:m027-0124"]}],"rationale":"兩篇文帝朝同記東陽侯張相如，明示姓名與爵號共同支持。 原候選ID與原文各自保留；代理暫定判讀，非人工覆核。","reviewer":"Codex（AI 代理）"},{"id":"eq-shiji103-zhang-xiangru","person_ids":["y8g_kfz_51h","l7w_xfi_scd"],"canonical_person_id":"l7w_xfi_scd","scope":"cross_chapter","chapter_ids":["c-shiji-103-wanshi","c-shiji-010-wendi"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-103-wanshi","source_id":"s-shiji-103-wanshi","paragraph_id":"c-shiji-103-wanshi:p002","quote":"文帝時，東陽侯張相如爲太子太傅，免。選可爲傅者，皆推奮，奮爲太子太傅。及孝景即位，以爲九卿；迫近，憚之，徙奮爲諸侯相。奮長子建，次子甲，次子乙，次子慶，皆以馴行孝謹，官皆至二千石。於是景帝曰：「石君及四子皆二千石，人臣尊寵乃集其門。」號奮爲萬石君。","mention_ids":["c-shiji-103-wanshi:m002-0004"]},{"chapter_id":"c-shiji-010-wendi","source_id":"s-shiji-010-wendi","paragraph_id":"c-shiji-010-wendi:p027","quote":"十四年冬，匈奴謀入邊為寇，攻朝那塞，殺北地都尉卬。上乃遣三將軍軍隴西、北地、上郡，中尉周舍為衛將軍，郎中令張武為車騎將軍，軍渭北，車千乘，騎卒十萬。帝親自勞軍，勒兵申教令，賜軍吏卒。帝欲自將擊匈奴，群臣諫，皆不聽。皇太后固要帝，帝乃止。於是以東陽侯張相如為大將軍，成侯赤為內史，欒布為將軍，擊匈奴。匈奴遁走。","mention_ids":["c-shiji-010-wendi:m027-0124"]}],"rationale":"兩篇同處文帝朝，明記東陽侯張相如；姓名、爵號與時代共同支持。太子太傅與大將軍分別保存，不以不同官職否定同指，亦不補造任職接續。 原候選 ID 與原文各自保留；代理判讀，非人工覆核。","reviewer":"Codex（AI 代理）"}],"passages":[{"id":"c-shiji-010-wendi:p027","text":"十四年冬，匈奴謀入邊為寇，攻朝那塞，殺北地都尉卬。上乃遣三將軍軍隴西、北地、上郡，中尉周舍為衛將軍，郎中令張武為車騎將軍，軍渭北，車千乘，騎卒十萬。帝親自勞軍，勒兵申教令，賜軍吏卒。帝欲自將擊匈奴，群臣諫，皆不聽。皇太后固要帝，帝乃止。於是以東陽侯張相如為大將軍，成侯赤為內史，欒布為將軍，擊匈奴。匈奴遁走。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-010-wendi:m027-0019","start":19,"end":24,"surface":"北地都尉卬","kind":"person","person_id":"zn2_vwj_e9n","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m027-0025","start":25,"end":26,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m027-0043","start":43,"end":45,"surface":"周舍","kind":"person","person_id":"3u2_btf_ob4","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m027-0053","start":53,"end":55,"surface":"張武","kind":"person","person_id":"3sp_xmg_o87","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m027-0074","start":74,"end":75,"surface":"帝","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m027-0091","start":91,"end":92,"surface":"帝","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m027-0107","start":107,"end":110,"surface":"皇太后","kind":"person","person_id":"a82_krd_hlg","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m027-0112","start":112,"end":113,"surface":"帝","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m027-0114","start":114,"end":115,"surface":"帝","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m027-0124","start":124,"end":127,"surface":"張相如","kind":"person","person_id":"l7w_xfi_scd","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m027-0132","start":132,"end":135,"su