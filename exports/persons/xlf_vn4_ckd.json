ntioned_source_ids":["s-epitaph-xunyue-chnmus"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-epitaph-xunyue-museum-full:p001:m0008","start":296,"end":298,"surface":"戴璿","kind":"person","person_id":"xlf_vn4_ckd","status":"source_attested","interpretation_note":"詔稱奉命吊祭的謁者。","paragraph_id":"c-epitaph-xunyue-museum-full:p001","chapter_id":"c-epitaph-xunyue-museum-full"},{"id":"c-epitaph-xunyue-museum-full:p001:m0010","start":305,"end":307,"surface":"戴璿","kind":"person","person_id":"xlf_vn4_ckd","status":"source_attested","interpretation_note":"詔稱奉命吊祭的謁者。","paragraph_id":"c-epitaph-xunyue-museum-full:p001","chapter_id":"c-epitaph-xunyue-museum-full"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-epitaph-xunyue-museum-full:p001","text":"晉故中書侍郎潁川潁陰荀君之墓。君以元康五年七月乙丑朔八日丙申歲在乙卯疾病，卒。君樂平府君之第二子，時年五十。先祖世，安措於潁川潁陰縣之北。其年七月十二日，大雨過常，舊墓下濕，崩壞者多。聖諸嘉悼，愍其貧約，特賜墓田一頃，錢十五萬，以供葬事。是以別安措於河南洛陽縣之東，陪附晉文帝陵道之右。其年十月戊午朔廿二日庚辰葬。寫詔書如左：詔中書侍郎荀岳，體量弘簡，思識通濟，不幸喪亡，甚悼愍之。其賜錢十萬以供喪事。詔故中書侍郎荀岳，忠正簡誠，秉心不苟，早喪才志，既愍惜之。聞其家居貧約，喪葬無資，脩素至此，又可嘉悼也。舊墓遇水，欲於此下權葬。其賜葬地一頃，錢十五萬，以供葬事。皇帝聞中書侍郎荀岳卒，遣謁者戴璿弔。皇帝遣謁者戴璿以少牢祭具祠故中書侍郎荀岳。尚饗！","text_layer":"epitaph_as_modernly_transcribed","annotation_status":"named_mentions_first_pass","source_position":{"kind":"institutional_museum_web_epitaph_transcription","face":"題額及正面","source_text_path":"source-evidence/xunyou-ancestor-assembly/museum-transcription.json","editorial_single_paragraph":true,"physical_line_divisions_inferred":false},"mentions":[{"id":"c-epitaph-xunyue-museum-full:p001:m0001","start":10,"end":12,"surface":"荀君","kind":"person","person_id":"696_456_df6_BAA","status":"contextual_provisional","interpretation_note":"墓題荀君即本誌墓主荀岳。"},{"id":"c-epitaph-xunyue-museum-full:p001:m0002","start":40,"end":44,"surface":"樂平府君","kind":"person","person_id":"696_456_df6_BA","status":"contextual_provisional","interpretation_note":"原文只稱樂平府君；依余嘉錫以伯旗推名的考證暫接荀祈，非墓誌明載其名。"},{"id":"c-epitaph-xunyue-museum-full:p001:m0003","start":135,"end":138,"surface":"晉文帝","kind":"person","person_id":"dkn_ge4_286_AAAAI","status":"source_explicit","interpretation_note":"諡號所指司馬昭。"},{"id":"c-epitaph-xunyue-museum-full:p001:m0004","start":168,"end":170,"surface":"荀岳","kind":"person","person_id":"696_456_df6_BAA","status":"source_explicit","interpretation_note":"詔書明具墓主姓名。"},{"id":"c-epitaph-xunyue-museum-full:p001:m0005","start":207,"end":209,"surface":"荀岳","kind":"person","person_id":"696_456_df6_BAA","status":"source_explicit","interpretation_note":"詔書明具墓主姓名。"},{"id":"c-epitaph-xunyue-museum-full:p001:m0006","start":282,"end":284,"surface":"皇帝","kind":"person","person_id":"7e0_f69_1ac","status":"contextual_provisional","interpretation_note":"按元康五年語境暫指晉惠帝；墓誌未書皇帝姓名。"},{"id":"c-epitaph-xunyue-museum-full:p001:m0007","start":289,"end":291,"surface":"荀岳","kind":"person","person_id":"696_456_df6_BAA","status":"source_explicit","interpretation_note":"詔書明具墓主姓名。"},{"id":"c-epitaph-xunyue-museum-full:p001:m0008","start":296,"end":298,"surface":"戴璿","kind":"person","person_id":"xlf_vn4_ckd","status":"source_attested","interpretation_note":"詔稱奉命吊祭的謁者。"},{"id":"c-epitaph-xunyue-museum-full:p001:m0009","start":300,"end":302,"surface":"皇帝","kind":"person","person_id":"7e0_f69_1ac","status":"contextual_provisional","interpr