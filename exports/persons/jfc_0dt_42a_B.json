g-ws2413329","paragraph_id":"c-jinshu-057-tao-huang:p009","quote":"在南三十年，威恩著於殊俗。及卒，舉州號哭，如喪慈親。朝廷乃以員外散騎常侍吾彥代璜。彥卒，又以員外散騎常侍顧秘代彥。秘卒，州人逼秘子參領州事。參尋卒，參弟壽求領州，州人不聽，固求之，遂領州。壽乃殺長史胡肇等，又將殺帳下督梁碩，碩走得免，起兵討壽，禽之，會壽母，令鴆殺之。碩乃迎璜子蒼梧太守威領刺史，在職甚得百姓心，三年卒。威弟淑，子綏，後並為交州。自基至綏四世，為交州者五人。","subject_person_mention_id":"c-jinshu-057-tao-huang:p009:m0065","object_person_mention_id":"c-jinshu-057-tao-huang:p009:m0052"}],"status":"source_attested","interpretation_note":"顧秘卒後州人逼參領州。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"a-jin057-volume-gu-shou","subject_person_id":"2r8_9w6_ahk","object_person_id":"jfc_0dt_42a_B","predicate":"brother","qualifiers":{"source_term":"參弟壽"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-057","chapter_id":"c-jinshu-057-tao-huang","source_id":"s-jinshu-057-tao-huang-ws2413329","paragraph_id":"c-jinshu-057-tao-huang:p009","quote":"在南三十年，威恩著於殊俗。及卒，舉州號哭，如喪慈親。朝廷乃以員外散騎常侍吾彥代璜。彥卒，又以員外散騎常侍顧秘代彥。秘卒，州人逼秘子參領州事。參尋卒，參弟壽求領州，州人不聽，固求之，遂領州。壽乃殺長史胡肇等，又將殺帳下督梁碩，碩走得免，起兵討壽，禽之，會壽母，令鴆殺之。碩乃迎璜子蒼梧太守威領刺史，在職甚得百姓心，三年卒。威弟淑，子綏，後並為交州。自基至綏四世，為交州者五人。","subject_person_mention_id":"c-jinshu-057-tao-huang:p009:m0076","object_person_mention_id":"c-jinshu-057-tao-huang:p009:m0065"}],"status":"source_attested","interpretation_note":"參卒後州人未即肯從。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[{"connection":"father","generation_distance":1,"parent_person_id":"jfc_0dt_42a","status":"contextual_provisional","human_reviewed":false,"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-057","chapter_id":"c-jinshu-057-jin076-guzhong","source_id":"s-jinshu-057-jin076-guzhong","paragraph_id":"c-jinshu-057-jin076-guzhong:succ","quote":"彥卒，又以員外散騎常侍顧秘代彥。秘卒，州人逼秘子參領州事。參尋卒，參弟壽求領州，州人不聽，固求之，遂領州。","source_term":"秘子參"}],"source_assertion_id":"a-w076r-gz-can","interpretation_note":"本句明記父子，分配號不表示長幼。","reviewer":"Codex（A