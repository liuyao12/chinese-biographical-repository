ozhi-051-jiao:line018:m0005","start":5,"end":7,"surface":"叔朗","kind":"person","person_id":"y4x_cmp_976_B","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-jiao:line018:m0024","start":24,"end":26,"surface":"曹公","kind":"person","person_id":"dad_b77_b38","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-jiao:line018:m0031","start":31,"end":32,"surface":"皎","kind":"person","person_id":"y4x_cmp_976_B","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-jiao:line018:m0050","start":50,"end":52,"surface":"程普","kind":"person","person_id":"p6n_a0q_flh","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-jiao:line018:m0056","start":56,"end":58,"surface":"黃蓋","kind":"person","person_id":"iby_117_6rw","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-jiao:line018:m0060","start":60,"end":61,"surface":"瑜","kind":"person","person_id":"y4x_cmp_976_A","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-jiao:line018:m0101","start":101,"end":104,"surface":"諸葛瑾","kind":"person","person_id":"lpo_z63_vzb","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-jiao:line018:m0110","start":110,"end":112,"surface":"劉靖","kind":"person","person_id":"qfh_ozo_ufz","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-jiao:line018:m0118","start":118,"end":120,"surface":"李允","kind":"person","person_id":"yru_r4u_u6m","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-jiao:line018:m0126","start":126,"end":128,"surface":"吳碩","kind":"person","person_id":"lj9_p80_o5s","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-jiao:line018:m0131","start":131,"end":133,"surface":"張梁","ki