非所望於君子哉！」騭於是條於時事業在荊州界者，諸葛瑾、陸遜、朱然、程普、潘浚，斐玄、夏侯承，衞旌，李肅、周條、石干十一人。甄別行狀，因上疏獎勸曰：","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-sanguozhi-052-buzhi-complete:line092:m0000","start":0,"end":1,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line092:m0025","start":25,"end":27,"surface":"陸遜","kind":"person","person_id":"lii_454_vuv","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line092:m0044","start":44,"end":45,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line092:m0047","start":47,"end":48,"surface":"登","kind":"person","person_id":"572_278_cba_C","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line092:m0058","start":58,"end":59,"surface":"騭","kind":"person","person_id":"snv_2iq_jes","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line092:m0168","start":168,"end":169,"surface":"騭","kind":"person","person_id":"snv_2iq_jes","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line092:m0182","start":182,"end":185,"surface":"諸葛瑾","kind":"person","person_id":"lpo_z63_vzb","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line092:m0186","start":186,"end":188,"surface":"陸遜","kind":"person","person_id":"lii_454_vuv","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line092:m0189","start":189,"end":191,"surface":"朱然","kind":"person","person_id":"tut_0t1_tb8","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line092:m0192","start":192