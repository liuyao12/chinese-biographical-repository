7","source_assertion_id":"a-xuanmo-song-shen-father","evidence":[{"work_id":"w-songshu","book_id":"b-songshu-076","chapter_id":"c-songshu-076-wangxuanmo-heirs","source_id":"s-songshu-076-wangxuanmo-heirs-ws1997726","paragraph_id":"c-songshu-076-wangxuanmo-heirs:p001","quote":"玄謨性嚴剋少恩，而將軍宗越御下更苛酷，軍士謂之語曰：「寧作五年徒，不逢王玄謨。玄謨猶自可，宗越更殺我。」年八十一薨，諡曰莊公。子深早卒，深子繢嗣。","subject_person_mention_id":"c-songshu-076-wangxuanmo-heirs:p001:m0064","object_person_mention_id":"c-songshu-076-wangxuanmo-heirs:p001:m0035","source_term":"子深"}],"status":"contextual_provisional","human_reviewed":false,"interpretation_note":"王玄謨傳末於其薨及諡後書子深。"}},{"id":"31b_fd1_f77_AA","label":"王繢（王深子，王玄謨孫）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"繢","mention_ids":["c-songshu-076-wangxuanmo-heirs:p001:m0070","c-nanshi-016-wangxuanmo-heirs:p002:m0007"]}],"evidence":[{"mention_id":"c-songshu-076-wangxuanmo-heirs:p001:m0070","paragraph_id":"c-songshu-076-wangxuanmo-heirs:p001","chapter_id":"c-songshu-076-wangxuanmo-heirs","quote":"繢"},{"mention_id":"c-nanshi-016-wangxuanmo-heirs:p002:m0007","paragraph_id":"c-nanshi-016-wangxuanmo-heirs:p002","chapter_id":"c-nanshi-016-wangxuanmo-heirs","quote":"繢"}],"review":"ai_provisional","identity_note":"王繢（王深子，王玄謨孫），見本組原文及身份互校。","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"31b_fd1_f77_A","source_assertion_id":"a-xuanmo-nan-hui-father","evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-016","chapter_id":"c-nanshi-016-wangxuanmo-heirs","source_id":"s-nanshi-016-wangxuanmo-heirs-ws1963381","paragraph_id":"c-nanshi-016-wangxuanmo-heirs:p002","quote":"子深早卒，深子繢嗣。","subject_person_mention_id":"c-nanshi-016-wangxuanmo-heirs:p002:m0007","object_person_mention_id":"c-nanshi-016-wangxuanmo-heirs:p002:m0005","source_term":"深子繢"}],"status":"contextual_provisional","human_reviewed":false,"interpretation_note":"南史直接明示，宋數位校記明據南史補深，不能重計獨立來源。"}},{"id":"31b_fd1_f77_B","label":"王寬（王玄謨子）","status":"active","historicity":"historical