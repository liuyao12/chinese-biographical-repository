tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-046-xiaohuiji-complete:p008:m0169","start":169,"end":171,"surface":"羊倫","kind":"person","person_id":"fuy_ang_lpy","status":"contextual_provisional","paragraph_id":"c-nanqishu-046-xiaohuiji-complete:p008","chapter_id":"c-nanqishu-046-xiaohuiji-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-046-xiaohuiji-complete:p008","text":"　　弟惠休，永明四年，爲廣州刺史。罷任，獻奉傾資。上敕中書舍人茹法亮曰：「可問蕭惠休。吾先使卿宣敕答其勿以私祿足充獻奉。今段殊覺其下情厚於前後人。問之，故當不侵私邪？吾欲分受之也。」十一年，自輔國將軍、南海太守，爲徐州刺史。鬱林卽位，進號冠軍將軍。建武二年，虜圍鍾離，惠休拒守。虜遣使仲長文真謂城中曰：「聖上方脩文德，何故完城拒命？」參軍羊倫答曰：「獫狁孔熾，我是用急。」虜攻城，惠休拒戰破之。遷侍中，領步兵校尉，封建安縣子，五百戶。永元元年，徙吳興太守。徵爲右僕射。吳興郡項羽神舊酷烈，世人云「惠休事神謹，欲得美遷」。二年，卒。贈金紫光祿大夫。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":82,"last_line":82,"raw_start":6520,"raw_end":6814,"raw_character_offsets":[6520,6521,6522,6523,6524,6525,6531,6532,6533,6534,6537,6538,6539,6540,6541,6542,6543,6544,6545,6546,6547,6548,6549,6550,6551,6552,6553,6554,6555,6556,6557,6558,6559,6560,6561,6562,6563,6564,6565,6566,6567,6568,6569,6570,6571,6572,6573,6574,6575,6576,6577,6578,6579,6580,6581,6582,6583,6584,6585,6586,6587,6588,6589,6590,6591,6592,6593,6594,6595,6596,6597,6598,6599,6600,6601,6602,6603,6604,6605,6606,6607,6608,6609,6610,6611,6612,6613,6614,6615,6616,6617,6618,6619,6620,6621,6622,6623,6624,6625,6626,6627,6628,6629,6630,6631,6632,6633,6634,6635,6636,6637,6638,6639,6640,6641,6642,6643,6644,6645,6646,6647,6648,6649,6650,6656,6657,6658,6659,6662,6663,6664,6665,6666,6667,6668,6669,6670,6671,6672,6673,6674,6675,6676,6677,6678,6679,6680,6681,6682,6683,6684,6685,6686,6687,6688,6689,6690,6691,6692,6693,6694,669