lumn":4},{"line":98,"column":5},{"line":98,"column":6},{"line":98,"column":7},{"line":98,"column":8},{"line":98,"column":9},{"line":98,"column":10},{"line":98,"column":11},{"line":98,"column":12},{"line":98,"column":13},{"line":98,"column":14},{"line":98,"column":15},{"line":98,"column":16},{"line":98,"column":17},{"line":98,"column":18},{"line":98,"column":19},{"line":98,"column":20},{"line":99,"column":0},{"line":99,"column":1},{"line":99,"column":2},{"line":99,"column":3},{"line":99,"column":4},{"line":99,"column":5},{"line":99,"column":6},{"line":99,"column":7},{"line":99,"column":8},{"line":99,"column":9},{"line":99,"column":10},{"line":99,"column":11},{"line":99,"column":12},{"line":99,"column":13},{"line":99,"column":14},{"line":99,"column":15},{"line":99,"column":16},{"line":99,"column":17},{"line":99,"column":18}],"boundary_is_editorial":true,"projected_start":888,"projected_end":1090},"chapter_id":"c-songshu-046-wangyi","book_id":"b-songshu-046","work_id":"w-songshu","source_id":"s-songshu-046-wangyi"},{"id":"c-songshu-092-wangzhenzhi:line014","text":"鎮之初為琅邪王衞軍行參軍，出補剡、上虞令，並有能名。內史謝輶請為山陰令，復有殊績。遷衞軍參軍，本國郎中令，加寧朔將軍。桓玄輔晉，以為大將軍錄事參軍。時三吳飢荒，遣鎮之銜命賑卹，而會稽內史王愉不奉符旨，鎮之依事糾奏。愉子綏，玄之外甥，當時貴盛，鎮之為所排抑，以母老求補安成太守。及玄敗，玄將苻宏寇亂郡境，鎮之拒戰彌年，子弟五人，並臨陣見殺。母憂去職，在官清潔，妻子無以自給，乃棄家致喪還上虞舊墓。葬畢，為子標之求安復令，隨子之官。服闋，為征西道規司馬、南平太守。徐道覆逼江陵，加鎮之建威將軍，統檀道濟、到彥之等討道覆，以不經將帥，固辭，不見聽。既而前軍失利，白衣領職，尋復本官。以討道覆功，封華容縣五等男，徵廷尉。晉穆帝何皇后山陵，領將作大匠。遷御史中丞，秉正不撓，百僚憚之。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-songshu-092-wangzhenzhi:line014:m0000","start":0,"end":2,"surface":"鎮之","kind":"person","person_id":"7r6_k52_qji_ABDACAA","status":"contextual_provisional"},{"id":"c-songshu-092-wangzhenzhi:line014:m0004","start":4,"end":7,"surface":"琅邪王","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"待核首次府主身份"},{"id":"c-songshu-092-wangzhenzhi:line014:m0028","start":28,"end":30,"surface":"謝輶","kind":"person","person_id":"ao0_c0z_ryc","status":"contextual_provisional"},{"id