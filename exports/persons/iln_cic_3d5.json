{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"iln_cic_3d5","canonical_person_id":"iln_cic_3d5","id_aliases":["cbr-p000484"],"identity_policy":"contextual_provisional","person_ids":["iln_cic_3d5"],"persons":[{"id":"iln_cic_3d5","label":"南公揭","status":"active","historicity":"historical_tradition","aliases":[{"surface":"南公揭","mention_ids":["c-shiji-005-qin:m068-0075"]}],"evidence":[{"mention_id":"c-shiji-005-qin:m068-0075","chapter_id":"c-shiji-005-qin","paragraph_id":"c-shiji-005-qin:p068","quote":"南公揭"}],"identity_note":"依本卷特定時代與事件暫定人物；不以同稱、官號或短名全域合併，未見本名不補造。","review":"ai_provisional","id_aliases":["cbr-p000484"]}],"source_mention_summary":[{"source_id":"s-shiji-005-qin","work_id":"w-shiji","book_id":"b-shiji-005","chapter_id":"c-shiji-005-qin","mention_count":1,"mention_ids":["c-shiji-005-qin:m068-0075"],"paragraph_ids":["c-shiji-005-qin:p068"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-005-qin"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-005-qin:m068-0075","start":75,"end":78,"surface":"南公揭","kind":"person","person_id":"iln_cic_3d5","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p068","chapter_id":"c-shiji-005-qin"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-005-qin:p068","text":"武王元年，與魏惠王會臨晉。誅蜀相壯。張儀、魏章皆東出之魏。伐義渠、丹、犁。二年，初置丞相，摢裏疾、甘茂為左右丞相。張儀死於魏。三年，與韓襄王會臨晉外。南公揭卒，摢裏疾相韓。武王謂甘茂曰：「寡人欲容車通三川，窺周室，死不恨矣。」其秋，使甘茂、庶長封伐宜陽。四年，拔宜陽，斬首六萬。涉河，城武遂。魏太子來朝。武王有力好戲，力士任鄙、烏獲、孟說皆至大官。王與孟說舉鼎，絕臏。八月，武王死。族孟說。武王取魏女為后，無子。立異母弟，是為昭襄王。昭襄母楚人，姓羋氏，號宣太后。武王死時，昭襄王為質於燕，燕人送歸，得立。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m068-0000","start":0,"end":2,"surface":"武王","kind":"person","person_id":"y97_huh_vuz_AAAAAAAAAAAAABAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0006","start":6,"end":9,"surface":"魏惠王","kind":"person","person_id":"bhp_5xd_88r","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0014","start":14,"end":17,"surface":"蜀相壯","kind":"person","person_id":"kqe_x0t_s25","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0018","start":18,"end":20,"surface":"張儀","kind":"person","person_id":"uq6_74z_vtv","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0021","start":21,"end":23,"surface":"魏章","kind":"person","person_id":"2pv_dtb_lrw","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0045","start":45,"end":48,"surface":"摢裏疾","kind":"person","person_id":"r9n_0vc_ywa","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0049","start":49,"end":51,"surface":"甘茂","kind":"person","person_id":"8im_m5e_cpy","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0057","start":57,"end":59,"surface":"張儀","kind":"person","person_id":"uq6_74z_vtv","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0067","start":67,"end":70,"surface":"韓襄王","kind":"person","person_id":"a0a_4q4_biw","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0075","start":75,"end":78,"surface":"南公揭","kind":"person","person_id":"iln_cic_3d5","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0080","start":80,"end":83,"surface":"摢裏疾","kind":"person","person_id":"r9n_0vc_ywa","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0086","start":86,"end":88,"surface":"武王","kind":"person","person_id":"y97_huh_vuz_AAAAAAAAAAAAABAAAAAAA","status":"contextual_provision