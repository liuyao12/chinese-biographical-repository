i-101-yuanchao:p002","quote":"呂后"},{"mention_id":"c-shiji-104-tianshu:m002-0293","chapter_id":"c-shiji-104-tianshu","paragraph_id":"c-shiji-104-tianshu:p002","quote":"高后"},{"mention_id":"c-shiji-105-bianque:m010-0030","chapter_id":"c-shiji-105-bianque","paragraph_id":"c-shiji-105-bianque:p010","quote":"高后"},{"mention_id":"c-shiji-105-bianque:m014-0020","chapter_id":"c-shiji-105-bianque","paragraph_id":"c-shiji-105-bianque:p014","quote":"高后"}],"family_path":{"connection":"father","generation_distance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"paragraph_id":"c-shiji-008-gaozu:p004","quote":"單父人呂公善沛令，避仇從之客，因家沛焉。沛中豪桀吏聞令有重客，皆往賀。蕭何為主吏，主進，令諸大夫曰：「進不滿千錢，坐之堂下。」高祖為亭長，素易諸吏，乃紿為謁曰「賀錢萬」，實不持一錢。謁入，呂公大驚，起，迎之門。呂公者，好相人，見高祖狀貌，因重敬之，引入坐。蕭何曰：「劉季固多大言，少成事。」高祖因狎侮諸客，遂坐上坐，無所詘。酒闌，呂公因目固留高祖。高祖竟酒，後。呂公曰：「臣少好相人，相人多矣，無如季相，願季自愛。臣有息女，願為季箕帚妾。」酒罷，呂媼怒呂公曰：「公始常欲奇此女，與貴人。沛令善公，求之不與，何自妄許與劉季？」呂公曰：「此非兒女子所知也。」卒與劉季。呂公女乃呂后也，生孝惠帝、魯元公主。","chapter_id":"c-shiji-008-gaozu","source_id":"s-shiji-008-gaozu","source_term":"女"}],"source_assertion_id":"a-shiji008-003","interpretation_note":"以此受傳正文的明示近親主張配置局部家族；不合併跨篇候選身份、不補闕名世代，不表示遠祖世系已核實。分支字元不是長幼排行。","reviewer":"Codex（AI 代理）","parent_person_id":"i30_mjq_6q8"}},{"id":"j0g_kpf_v3u","label":"呂后長女（外戚世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"長女","mention_ids":["c-shiji-049-waiqi:m004-0002"]}],"evidence":[{"mention_id":"c-shiji-049-waiqi:m004-0002","chapter_id":"c-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p004","quote":"長女"}]}],"source_mention_summary":[{"source_id":"s-shiji-049-waiqi","work_id":"w-shiji","book_id":"b-shiji-049","chapter_id":"c-shiji-049-waiqi","mention_count":1,"mention_ids":["c-shiji-049-waiqi:m004-0002"],"paragraph_ids":["c-shiji-049-waiqi:p004"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-049-waiqi"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional",