r_id":"c-shiji-107-weiqi"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji107-009","person_id":"gni_rru_0gw","surfaces":["太子","今上"],"scope":"same_chapter","chapter_ids":["c-shiji-107-weiqi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-107-weiqi:p006","quote":"武安侯田蚡者，孝景后同母弟也，生長陵。魏其已為大將軍後，方盛，蚡為諸郎，未貴，往來侍酒魏其，跪起如子姓。及孝景晚節，蚡益貴幸，為太中大夫。蚡辯有口，學槃盂諸書，王太后賢之。孝景崩，即日太子立，稱制，所鎮撫多有田蚡賓客計筴，蚡弟田勝，皆以太后弟，孝景後三年封蚡為武安侯，勝為周陽侯。"},{"paragraph_id":"c-shiji-107-weiqi:p013","quote":"潁陰侯言之上，上以夫為中郎將。數月，坐法去。後家居長安，長安中諸公莫弗稱之。孝景時，至代相。孝景崩，今上初即位，以為淮陽天下交，勁兵處，故徙夫為淮陽太守。建元元年，入為太仆。二年，夫與長樂衛尉竇甫飲，輕重不得，夫醉，搏甫。甫，竇太后昆弟也。上恐太后誅夫，徙為燕相。數歲，坐法去官，家居長安。"}],"rationale":"限本篇逐段介紹、事件與說話者的稱呼承接。灌仲孺是灌夫，長孺是韓安國；田蚡與子恬的武安侯按嗣爵前後分開，夫不匹配夫妻、大夫或夫人。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-107-weiqi:p006","text":"武安侯田蚡者，孝景后同母弟也，生長陵。魏其已為大將軍後，方盛，蚡為諸郎，未貴，往來侍酒魏其，跪起如子姓。及孝景晚節，蚡益貴幸，為太中大夫。蚡辯有口，學槃盂諸書，王太后賢之。孝景崩，即日太子立，稱制，所鎮撫多有田蚡賓客計筴，蚡弟田勝，皆以太后弟，孝景後三年封蚡為武安侯，勝為周陽侯。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-107-weiqi:m006-0000","start":0,"end":5,"surface":"武安侯田蚡","kind":"person","person_id":"ubk_etq_ksp","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m006-0007","start":7,"end":10,"surface":"孝景后","kind":"person","person_id":"5u3_i3p_ngq","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m006-0019","start":19,"end":21,"surface":"魏其","kind":"person","person_id":"nuf_tb9_fjs_A","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m006-0031","start":31,"end":32,"surface":"蚡","kind":"person","person_id":"ubk_etq_ksp","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m006-0043","start":43,"end":45,"surface":"魏其","kind":"person","person_id":"nuf_tb9_fjs_A","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m006-0053","start":53,"end":55,"