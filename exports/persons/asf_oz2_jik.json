":"c-nanshi-019-xieyu-descendants:p008:m0001","person_id":"684_eaa_511_AAAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作謝微。"},{"start":3,"end":5,"surface":"玄度","id":"c-nanshi-019-xieyu-descendants:p008:m0003","person_id":"684_eaa_511_AAAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作謝微。"},{"start":26,"end":29,"surface":"裴子野","id":"c-nanshi-019-xieyu-descendants:p008:m0026","person_id":"vpy_180_2oi_AAAAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作裴子野。"},{"start":32,"end":34,"surface":"劉顯","id":"c-nanshi-019-xieyu-descendants:p008:m0032","person_id":"mcd_vna_05k","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作劉顯。"},{"start":44,"end":46,"surface":"元略","id":"c-nanshi-019-xieyu-descendants:p008:m0044","person_id":"ajj_c35_na9","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作元略。"},{"start":69,"end":70,"surface":"微","id":"c-nanshi-019-xieyu-descendants:p008:m0069","person_id":"684_eaa_511_AAAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作謝微。"},{"start":89,"end":90,"surface":"猷","id":"c-nanshi-019-xieyu-descendants:p008:m0089","person_id":"asf_oz2_jik","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作蕭淵猷。"},{"start":120,"end":121,"surface":"綱","id":"c-nanshi-019-xieyu-descendants:p008:m0120","person_id":"rtd_v0b_nyn","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作蕭綱。"},{"start":137,"end":140,"surface":"何敬容","id":"c-nanshi-019-xieyu-descendants:p008:m0137","person_id":"8ke_fzu_5pg","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作何敬容。"},{"start":145,"end":148,"surface":"孔休源","id":"c-nanshi-019-xieyu-descendants:p008:m0145","person_id":"g7c_o6p_gu1","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角