-wyd1739"},{"id":"c-liangshu-050-xiezheng:p003:r0091","start":91,"end":94,"surface":"臨汝侯","person_id":"asf_oz2_jik","paragraph_id":"c-liangshu-050-xiezheng:p003","quote":"臨汝侯淵猷","referent_role":"third_person","note":"南史省名為猷。","chapter_id":"c-liangshu-050-xiezheng","book_id":"b-liangshu-050","work_id":"w-liangshu","source_id":"s-liangshu-050-xiezheng-ws1514482"},{"start":86,"end":89,"surface":"臨汝侯","id":"c-nanshi-019-xieyu-descendants:p008:r0086","paragraph_id":"c-nanshi-019-xieyu-descendants:p008","person_id":"asf_oz2_jik","referent_role":"third_person","quote":"子微字玄度，美風采，好學善屬文，位兼中書舍人。與河東裴子野、沛國劉顯同官友善。時魏中山王元略還北，梁武帝餞於武德殿，賦詩三十韻，限三刻成。微二刻便就，文甚美，帝再覽焉。又爲臨汝侯猷制放生文，亦見賞於世。後除尙書左丞。及昭明太子薨，帝立晉安王綱爲皇太子，將出詔，唯召尙書右僕射何敬容、宣惠將軍孔休源及微三人與議。微時年位尙輕，而任遇已重。後卒於北中郎豫章王長史、南蘭陵太守。文集二十卷。","note":"本句按敘述視點回指蕭淵猷。","chapter_id":"c-nanshi-019-xieyu-descendants","book_id":"b-nanshi-019","work_id":"w-nanshi","source_id":"s-nanshi-019-xieyu-descendants-ws1531762"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-003-xiewei-princes:p002","text":"六月丁未，以前太子詹事蕭淵猷爲中護軍。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-liangshu-003-xiewei-princes:p002:m0011","start":11,"end":14,"surface":"蕭淵猷","kind":"person","person_id":"asf_oz2_jik","status":"contextual_provisional","interpretation_note":"淵猷具姓名。"}],"source_position":{"first_line":206,"last_line":206,"revision_id":2401780,"editorial_excerpt_boundary":true,"raw_line_start_codepoint":0,"raw_line_end_codepoint":19},"chapter_id":"c-liangshu-003-xiewei-princes","book_id":"b-liangshu-003","work_id":"w-liangshu","source_id":"s-liangshu-003-xiewei-princes-ws2401780"},{"id":"c-liangshu-050-xiezheng-wyd:p003","text":"徵與河東裴子野沛國劉顯同官友善子野嘗為寒夜直宿賦以贈徵徵為感友賦以酬之時魏中山王元略還北高祖餞於武德殿賦詩三十韻限三刻成徵二刻便就其辭甚美高祖再覽焉又為臨汝侯淵猷製放生文亦見賞於世","text_layer":"received_chapter","annotation_status":"reviewed","mention