s_assertions":[],"person_references":[{"start":86,"end":89,"surface":"臨汝侯","id":"c-nanshi-019-xieyu-descendants:p008:r0086","paragraph_id":"c-nanshi-019-xieyu-descendants:p008","person_id":"asf_oz2_jik","referent_role":"third_person","quote":"子微字玄度，美風采，好學善屬文，位兼中書舍人。與河東裴子野、沛國劉顯同官友善。時魏中山王元略還北，梁武帝餞於武德殿，賦詩三十韻，限三刻成。微二刻便就，文甚美，帝再覽焉。又爲臨汝侯猷制放生文，亦見賞於世。後除尙書左丞。及昭明太子薨，帝立晉安王綱爲皇太子，將出詔，唯召尙書右僕射何敬容、宣惠將軍孔休源及微三人與議。微時年位尙輕，而任遇已重。後卒於北中郎豫章王長史、南蘭陵太守。文集二十卷。","note":"本句按敘述視點回指蕭淵猷。","chapter_id":"c-nanshi-019-xieyu-descendants","book_id":"b-nanshi-019","work_id":"w-nanshi","source_id":"s-nanshi-019-xieyu-descendants-ws1531762"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-003-xiewei-princes:p002","text":"六月丁未，以前太子詹事蕭淵猷爲中護軍。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-liangshu-003-xiewei-princes:p002:m0011","start":11,"end":14,"surface":"蕭淵猷","kind":"person","person_id":"asf_oz2_jik","status":"contextual_provisional","interpretation_note":"淵猷具姓名。"}],"source_position":{"first_line":206,"last_line":206,"revision_id":2401780,"editorial_excerpt_boundary":true,"raw_line_start_codepoint":0,"raw_line_end_codepoint":19},"chapter_id":"c-liangshu-003-xiewei-princes","book_id":"b-liangshu-003","work_id":"w-liangshu","source_id":"s-liangshu-003-xiewei-princes-ws2401780"},{"id":"c-nanshi-019-xieyu-descendants:p008","text":"子微字玄度，美風采，好學善屬文，位兼中書舍人。與河東裴子野、沛國劉顯同官友善。時魏中山王元略還北，梁武帝餞於武德殿，賦詩三十韻，限三刻成。微二刻便就，文甚美，帝再覽焉。又爲臨汝侯猷制放生文，亦見賞於世。後除尙書左丞。及昭明太子薨，帝立晉安王綱爲皇太子，將出詔，唯召尙書右僕射何敬容、宣惠將軍孔休源及微三人與議。微時年位尙輕，而任遇已重。後卒於北中郎豫章王長史、南蘭陵太守。文集二十卷。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"start":1,"end":2,"surface":"微","id":"c-nanshi-019-xieyu-descendants:p008:m0001","person_id":"684_eaa_511_AAAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作謝微。"},{"start":3,"e