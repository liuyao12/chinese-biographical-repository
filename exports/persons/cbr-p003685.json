{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003685","identity_policy":"contextual_provisional","person_ids":["cbr-p003685"],"persons":[{"id":"cbr-p003685","label":"務光（伯夷列傳候選）","status":"active","historicity":"legendary_tradition","aliases":[{"surface":"務光","mention_ids":["c-shiji-061-boyi:m001-0122"]},{"surface":"光","mention_ids":["c-shiji-061-boyi:m001-0180"]}],"evidence":[{"mention_id":"c-shiji-061-boyi:m001-0122","chapter_id":"c-shiji-061-boyi","paragraph_id":"c-shiji-061-boyi:p001","quote":"務光"},{"mention_id":"c-shiji-061-boyi:m001-0180","chapter_id":"c-shiji-061-boyi","paragraph_id":"c-shiji-061-boyi:p001","quote":"光"}]}],"mentions":[{"id":"c-shiji-061-boyi:m001-0122","start":122,"end":124,"surface":"務光","kind":"person","person_id":"cbr-p003685","status":"contextual_provisional","paragraph_id":"c-shiji-061-boyi:p001","chapter_id":"c-shiji-061-boyi"},{"id":"c-shiji-061-boyi:m001-0180","start":180,"end":181,"surface":"光","kind":"person","person_id":"cbr-p003685","status":"contextual_provisional","paragraph_id":"c-shiji-061-boyi:p001","chapter_id":"c-shiji-061-boyi"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji061-006","person_id":"cbr-p003685","surfaces":["光","務光"],"scope":"same_chapter","chapter_ids":["c-shiji-061-boyi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-061-boyi:p001","quote":"夫學者載籍極博，猶考信於六藝。詩書雖缺，然虞夏之文可知也。堯將遜位，讓於虞舜，舜禹之閒，岳牧咸薦，乃試之於位，典職數十年，功用既興，然後授政。示天下重器，王者大統，傳天下若斯之難也。而說者曰堯讓天下於許由，許由不受，恥之逃隱。及夏之時，有卞隨、務光者。此何以稱焉？太史公曰：余登箕山，其上蓋有許由冢云。孔子序列古之仁聖賢人，如吳太伯、伯夷之倫詳矣。余以所聞由、光義至高，其文辭不少概見，何哉？"}],"rationale":"依明示姓名、局部父稱、西伯卒號文王及孔子顏淵評論語境暫接；由光只取所聞由光處，子曰只標子，不全域按單字替換。傳說敘事、世系數目、源文引語及普通詞分辨，未名人物不補全名。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-061-boyi:p001","text":"夫學者載籍極博，猶考信於六藝。詩書雖缺，然虞夏之文可知也。堯將遜位，讓於虞舜，舜禹之閒，岳牧咸薦，乃試之於位，典職數十年，功用既興，然後授政。示天下重器，王者大統，傳天下若斯之難也。而說者曰堯讓天下於許由，許由不受，恥之逃隱。及夏之時，有卞隨、務光者。此何以稱焉？太史公曰：余登箕山，其上蓋有許由冢云。孔子序列古之仁聖賢人，如吳太伯、伯夷之倫詳矣。余以所聞由、光義至高，其文辭不少概見，何哉？","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-061-boyi:m001-0001","start":1,"end":3,"surface":"學者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、引歌中的虞夏或未定指代；不補姓名、成員或肯定王號所指。"},{"id":"c-shiji-061-boyi:m001-0029","start":29,"end":30,"surface":"堯","kind":"person","person_id":"cbr-p003680","status":"contextual_provisional"},{"id":"c-shiji-061-boyi:m001-0036","start":36,"end":38,"surface":"虞舜","kind":"person","person_id":"cbr-p003681","status":"contextual_provisional"},{"id":"c-shiji-061-boyi:m001-0039","start":39,"end":40,"surface":"舜","kind":"person","person_id":"cbr-p003681","status":"contextual_provisional"},{"id":"c-shiji-061-boyi:m001-0040","start":40,"end":41,"surface":"禹","kind":"person","person_id":"cbr-p003682","status":"contextual_provisional"},{"id":"c-shiji-061-boyi:m001-0044","start":44,"end":46,"surface":"岳牧","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、引歌中的虞夏或未定指代；不補姓名、成員或肯定王號所指。"},{"id":"c-shiji-061-boyi:m001-0077","start":77,"end":79,"surface":"王者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、引歌中的虞夏或未定指代；不補姓名、成員或肯定王號所指。"},{"id":"c-shiji-061-boyi:m001-0092","start":92,"end":94,"surface":"說者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、引歌中的虞夏或未定指代；不補姓名、成員或肯定王號所指。"},{"id":"c-shiji-061-boyi:m001-0095","start":95,"end":96,"surface":"堯","kind":"person","person_id":"cbr-p003680","status":"contextual_provisional"},{"id":"c-shiji-061-boyi:m001-0100","start":100,"end":102,"surface":"許由","kind":"person","person_id":"cbr-p003683","status":"contextual_provisional"},{"id":"c-shiji-061-boyi:m001-0103","start":103,"end":105,"surface":"許由","kind":"person","person_id":"cbr-p003683","status":"contextual_provisional"},{"id":"c-shiji-061-boyi:m001-0119","start":119,"end":121,"surface":"卞隨","kind":"person","person_id":"cbr-p003684","status