bj_z9b","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m071-0069","start":69,"end":72,"surface":"無財者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代，未補姓名、成員或親屬；譬喻與未遂取室不作已確證家屬。"},{"id":"c-shiji-067-disciples:m071-0076","start":76,"end":83,"surface":"學道而不能行者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代，未補姓名、成員或親屬；譬喻與未遂取室不作已確證家屬。"},{"id":"c-shiji-067-disciples:m071-0088","start":88,"end":89,"surface":"憲","kind":"person","person_id":"b26_2bj_z9b","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m071-0098","start":98,"end":100,"surface":"子貢","kind":"person","person_id":"7c4_6v2_yvm","status":"contextual_provisional"}],"chapter_id":"c-shiji-067-disciples","book_id":"b-shiji-067","work_id":"w-shiji","source_id":"s-shiji-067-disciples"},{"id":"c-shiji-124-youxia:p001","text":"韓子曰：「儒以文亂法，而俠以武犯禁。」二者皆譏，而學士多稱於世云。至如以術取宰相卿大夫，輔翼其世主，功名俱著於春秋，固無可言者。及若季次、原憲，閭巷人也，讀書懷獨行君子之德，義不苟合當世，當世亦笑之。故季次、原憲終身空室蓬戶，褐衣疏食不厭。死而已四百餘年，而弟子志之不倦。今遊俠，其行雖不軌於正義，然其言必信，其行必果，已諾必誠，不愛其軀，赴士之阨困，既已存亡死生矣，而不矜其能，羞伐其德，蓋亦有足多者焉。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-124-youxia:m001-0000","start":0,"end":2,"surface":"韓子","kind":"person","person_id":"n2o_l90_fnm","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m001-0066","start":66,"end":68,"surface":"季次","kind":"person","person_id":"v94_2qu_ypp","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m001-0069","start":69,"end":71,"surface":"原憲","kind":"person","person_id":"b26_2bj_z9b","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m001-0101","start":101,"end":103,"surface":"季次","kind":"person","person_id":"v94_2qu_ypp","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m001-0104","start":104,"end":106,"surface":"原憲","kind":"person","person_id":"b26_2bj_z9b","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m001-0129","start":129,"end":131,"surface":"弟子","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-124-youxia","book_id":"b-shiji-124","work_id":"w-shiji","source_id":"s-shiji124-youxia"},{"id":"c-shiji-124-youxia:p004","text":"今拘學或抱咫尺之義，久孤於世，豈若卑論儕俗，與世沈浮而取榮名哉！而布衣之徒，設取予然諾，千里誦義，為死不顧世，此亦有所長，非苟而已也。故士窮窘而得委命，此豈非人之所謂賢豪間者邪？誠使鄉曲之俠，予季次、原憲比權量力，效功於當世，不同日而論矣。要以功見言信，俠客之義又曷可少哉！","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-124-youxia:m004-0097","start":97,"end":99,"surface":"季次","kind":"person","person_id":"v94_2qu_ypp","status":"contextual_provisional"},{"id":"c-shiji-124-youxia:m004-0100","start":100,"end":102,"surface":"原憲","kind":"person","person_id":"b26_2bj_z9b","status":"contextual_provisional"}],"chapter_id":"c-shiji-124-youxia","book_id":"b-shiji-124","work_id":"w-shiji","source_id":"s-shiji124-youxia"},{"id":"c-shiji-129-huozhi:p008","text":"子贛既學於仲尼，退而仕於衛，廢著鬻財於曹、魯之閒，七十子之徒，賜最為饒益。原憲不厭糟糠，匿於窮巷。子貢結駟連騎，束帛之幣以聘享諸侯，所至，國君無不分庭與之抗禮。夫使孔子名布揚於天下者，子貢先後之也。此所謂得埶而益彰者乎？","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-129-huozhi:m008-0000","start":0,"end":2,"surface":"子贛","kind":"person","person_id":"eb7_5lg_w9q","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m008-0005","start":5,"end":7,"surface":"仲尼","kind":"person","person_id":"mil_8wg_ohj","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m008-0031","start":31,"end":32,"surface":"賜","kind":"person","person_id":"eb7_5lg_w9q","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m008-0037","start":37,"end":39,"surface":"原憲","kind":"person","person_id":"b26_2bj_z9b","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m008-0049","start":49,"end":51,"surface":"子貢","kind":"person","person_id":"eb7_5lg_w9q","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m008-0082","start":82,"end":84,"surface":"孔子","kind":"person","person_id":"mil_8wg_ohj","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m008-0092","start":92,"end":94,"surface":"子貢","kind":"person","person_id":"eb7_5lg_w9q","status":"contextual_provisional"}],"chapter_id":"c-shiji-129-huozhi","book_id":"b-shiji-129","work_id":"w-shiji","source_id":"s-shiji129-huozhi"}],"sources":[{"chapter_id":"c-shiji-067-disciples","work_id":"w-shiji","book_id":"b-shiji-067","source_id":"s-shiji-067-disciples","source":{"title":"史記／卷067","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷067","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷067&oldid=7869003","revision_id":7869003,"accessed_on":"2026-10-09","extent":"152段正文，自孔子曰受業身通者至太史公論贊；排除ws-header中的導覽名單、後附索隱述贊及現代版權告示。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"取得時HTML與固定修訂一致，只去外緣空白；保留髙、歳、衞、漆彫、曾蒧等原字。導覽名單與正文異體不混接。","note":"全152段已核讀，人物標註待逐段處理；未核可靠底本、影像或現代研究。"}}},{"chapter_id":"c-shiji-124-youxia","work_id":"w-shiji","book_id":"b-shiji-124","source_id":"s-shiji124-youxia","source":{"title":"史記／卷124","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷124","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷124&oldid=367994","revision_id":367994,"accessed_on":"2026-10-11","extent":"固定修訂全文17段，包括末段索隱述贊。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"去header2、現代節標、Textquality及wikipedia導覽模板；原文字面保留，原字未轉換，未核影像。","note":"末段索隱述贊另分層。"}}},{"chapter_id":"c-shiji-129-huozhi","work_id":"w-shiji","book_id":"b-shiji-129","source_id":"s-shiji129-huozhi","source":{"title":"史記／卷129","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷129","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷129&oldid=7904128","revision_id":7904128,"accessed_on":"2026-10-11","extent":"固定修訂全文43段，篇文42段、索隱述贊1段。","image_verified":fal