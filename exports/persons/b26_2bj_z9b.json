er_id":"c-shiji-067-disciples"},{"id":"c-shiji-067-disciples:m071-0060","start":60,"end":62,"surface":"原憲","kind":"person","person_id":"b26_2bj_z9b","status":"contextual_provisional","paragraph_id":"c-shiji-067-disciples:p071","chapter_id":"c-shiji-067-disciples"},{"id":"c-shiji-067-disciples:m071-0088","start":88,"end":89,"surface":"憲","kind":"person","person_id":"b26_2bj_z9b","status":"contextual_provisional","paragraph_id":"c-shiji-067-disciples:p071","chapter_id":"c-shiji-067-disciples"},{"id":"c-shiji-124-youxia:m001-0069","start":69,"end":71,"surface":"原憲","kind":"person","person_id":"b26_2bj_z9b","status":"contextual_provisional","paragraph_id":"c-shiji-124-youxia:p001","chapter_id":"c-shiji-124-youxia"},{"id":"c-shiji-124-youxia:m001-0104","start":104,"end":106,"surface":"原憲","kind":"person","person_id":"b26_2bj_z9b","status":"contextual_provisional","paragraph_id":"c-shiji-124-youxia:p001","chapter_id":"c-shiji-124-youxia"},{"id":"c-shiji-124-youxia:m004-0100","start":100,"end":102,"surface":"原憲","kind":"person","person_id":"b26_2bj_z9b","status":"contextual_provisional","paragraph_id":"c-shiji-124-youxia:p004","chapter_id":"c-shiji-124-youxia"},{"id":"c-shiji-129-huozhi:m008-0037","start":37,"end":39,"surface":"原憲","kind":"person","person_id":"b26_2bj_z9b","status":"contextual_provisional","paragraph_id":"c-shiji-129-huozhi:p008","chapter_id":"c-shiji-129-huozhi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji067-054","person_id":"b26_2bj_z9b","scope":"same_chapter","chapter_ids":["c-shiji-067-disciples"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["原憲","夫子","子思","憲"],"evidence":[{"paragraph_id":"c-shiji-067-disciples:p068","quote":"原憲字子思。"},{"paragraph_id":"c-shiji-067-disciples:p069","quote":"子思問恥。孔子曰：「國有道，穀。國無道，穀，恥也。」"},{"paragraph_id":"c-shiji-067-disciples:p070","quote":"子思曰：「克、伐、怨、欲不行焉，可以爲仁乎？」孔子曰：「可以爲難矣，仁則吾弗知也。」"},{"paragraph_id":"c-shiji-067-disciples:p071","quote":"孔子卒，原憲遂亡在草澤中。子貢相衞，而結駟連騎，排藜藿入窮閻，過謝原憲。憲攝敝衣冠見子貢。子貢恥之，曰：「夫子豈病乎？」原憲曰：「吾聞之，無財者謂之貧，學道而不能行者謂之病。若憲，貧也，非病也。」子貢慚，不懌而去，終身恥其言之過也。"}],"rationale":"依篇內明示姓名字稱及局部問答暫接。吳越王稱按夫差句踐連續敘事；第71段夫子指原憲，第90段指代未定。傳易短何分田子莊何與楊何，傳授不當父子；引古人物保留傳說性。冉季字子產不接鄭子產，原憲子思不接孔子後世子思；名錄各條同字子徒、子聲、子上、皙等均保留不同候選，鄭國是此條人名。魯昭公夫人孟子不接戰國孟子。全152段明示姓名首輪已存，未名者、代詞、版本及跨篇身份待覆核。"},{"id":"d-shiji124-context-six-002","person_id":"b26_2bj_z9b","scope":"cross_chapter","chapter_ids":["c-shiji-124-youxia","c-shiji-067-disciples"],"status":"contextual_provisional","confidence_level":"high","surfaces":["原憲"],"identification_basis":{"kind":"source_context","target_mention_ids":["c-shiji-124-youxia:m001-0069","c-shiji-124-youxia:m001-0104","c-shiji-124-youxia:m004-0100"]},"evidence":[{"chapter_id":"c-shiji-124-youxia","paragraph_id":"c-shiji-124-youxia:p001","quote":"韓子曰：「儒以文亂法，而俠以武犯禁。」二者皆譏，而學士多稱於世云。至如以術取宰相卿大夫，輔翼其世主，功名俱著於春秋，固無可言者。及若季次、原憲，閭巷人也，讀書懷獨行君子之德，義不苟合當世，當世亦笑之。故季次、原憲終身空室蓬戶，褐衣疏食不厭。死而已四百餘年，而弟子志之不倦。今遊俠，其行雖不軌於正義，然其言必信，其行必果，已諾必誠，不愛其軀，赴士之阨困，既已存亡死生矣，而不矜其能，羞伐其德，蓋亦有足多者焉。"},{"chapter_id":"c-shiji-124-youxia","paragraph_id":"c-shiji-124-youxia:p004","quote":"今拘學或抱咫尺之義，久孤於世，豈若卑論儕俗，與世沈浮而取榮名哉！而布衣之徒，設取予然諾，千里誦義，為死不顧世，此亦有所長，非苟而已也。故士窮窘而得委命，此豈非人之所謂賢豪間者邪？誠使鄉曲之俠，予季次、原憲比權量力，效功於當世，不同日而論矣。要以功見言信，俠客之義又曷可少哉！"},{"chapter_id":"c-shiji-067-disciples","paragraph_id":"c-shiji-067-disciples:p068","quote":"原憲字子思。"}],"rationale":"同為孔門弟子原憲；本篇與季次並舉，記閭巷讀書、弟子志之，並非憑憲一字配人。 只辨同指，保留正文與文字錨，不由本段添加親屬或推算生卒。","prior_source_qualifications":[{"source_mention_ids":["c-shiji-124-youxia:m001-0069","c-shiji-124-youxia:m001-0104","c-shiji-124-youxia:m004-0100"],"metadata":{"label":"原憲（游俠列傳候選）","status":"active","historicity":"historical_tradition"},"original_registry_record_sha256":"76e2b02ee4ad8e1955677ecd2435c12473f0d025e3ad77678e87f7bb8b8d130a","qualification":"原來源候選資格留作判讀背景，非另一現役人物或舊號別名。"}],"human_reviewed":false,"model":null},{"id":"d-shiji-yuanxian-specific-context-crosscha