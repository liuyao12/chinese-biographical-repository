但中人。近守常法，無奇數異術者，則群惡日滋，久遠成害。故國之安危，在於所任，不可不察也。竊懼朝廷忽輕其選，故敢竭愚情，以廣聖思。","person_mention_id":"c-sanguozhi-053-xuezong:line047:m0000"}],"interpretation_note":"本來源所記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-sanguozhi-049-shixie-complete:p008:m0009","surface":"張津","start":9,"end":11,"kind":"person","person_id":"xqp_a2u_qb3","status":"contextual_provisional","paragraph_id":"c-sanguozhi-049-shixie-complete:p008","chapter_id":"c-sanguozhi-049-shixie-complete"},{"id":"c-sanguozhi-049-shixie-complete:p008:m0017","surface":"津","start":17,"end":18,"kind":"person","person_id":"xqp_a2u_qb3","status":"contextual_provisional","paragraph_id":"c-sanguozhi-049-shixie-complete:p008","chapter_id":"c-sanguozhi-049-shixie-complete"},{"id":"c-sanguozhi-049-shixie-complete:p008:m0040","surface":"津","start":40,"end":41,"kind":"person","person_id":"xqp_a2u_qb3","status":"contextual_provisional","paragraph_id":"c-sanguozhi-049-shixie-complete:p008","chapter_id":"c-sanguozhi-049-shixie-complete"},{"id":"c-sanguozhi-049-shixie-complete:p008:m0067","surface":"張津","start":67,"end":69,"kind":"person","person_id":"xqp_a2u_qb3","status":"contextual_provisional","paragraph_id":"c-sanguozhi-049-shixie-complete:p008","chapter_id":"c-sanguozhi-049-shixie-complete"},{"id":"c-sanguozhi-053-xuezong:line045:m0407","start":407,"end":409,"surface":"張津","kind":"person","person_id":"xqp_a2u_qb3","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-053-xuezong:line045","chapter_id":"c-sanguozhi-053-xuezong"},{"id":"c-sanguozhi-053-xuezong:line047:m0000","start":0,"end":1,"surface":"津","kind":"person","person_id":"xqp_a2u_qb3","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-053-xuezong:line047","chapter_id":"c-sanguozhi-053-xuezong"},{"id":"c-sanguozhi-053-xuezong:line047:m0082","start":82,"end":83,"surface":"津","kind":"person","person_id":"xqp_a2u_qb3","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-053-xuezong:line047","chapter_id":"c-sanguozhi-053-xuezong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-049-shixie-complete:p008","text":"　　朱符死後，漢遣張津為交州刺史，津後又為其將區景所殺，而荊州牧劉表遣零陵賴恭代津。是時蒼梧太守史璜死，表又遣吳巨代之，與恭俱至。漢聞張津死，賜燮璽書曰：「交州絕域，南帶江海，上恩不宣，下義壅隔，知逆賊劉表又遣賴恭闚看南土，今以燮為綏南中郎將，董督七郡，領交阯太守如故。」後燮遣吏張旻奉貢詣京都，是時天下喪亂，道路斷絕，而燮不廢貢職，特復下詔拜安遠將軍，封龍度亭侯。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":45,"last_line":45,"raw_start":5743,"raw_end":5926,"raw_character_offsets":[5743,5744,5745,5746,5747,5748,5749,5750,5751,5752,5753,5754,5755,5756,5757,5758,5759,5760,5761,5762,5763,5764,5765,5766,5767,5768,5769,5770,5771,5772,5773,5774,5775,5776,5777,5778,5779,5780,5781,5782,5783,5784,5785,5786,5787,5788,5789,5790,5791,5792,5793,5794,5795,5796,5797,5798,5799,5800,5801,5802,5803,5804,5805,5806,5807,5808,5809,5810,5811,5812,5813,5814,5815,5816,5817,5818,5819,5820,5821,5822,5823,5824,5825,5826,5827,5828,5829,5830,5831,5832,5833,5834,5835,5836,5837,5838,5839,5840,5841,5842,5843,5844,5845,5846,5847,5848,5849,5850,5851,5852,5853,5854,5855,5856,5857,5858,5859,5860,5861,5862,5863,5864,5865,5866,5867,5868,5869,5870,5871,5872,5873,5874,5875,5876,5877,5878,5879,5880,5881,5882,5883,5884,5885,5886,5887,5888,5889,5890,5891,5892,5893,5894,5895,5896,5897,5898,5899,5900,5901,5902,5903,5904,5905,5906,5907,5908,5909,5910,5911,5912,5913,5914,5915,5916,5917,5918,5919,5920,5921,5922,5923,5924,5925],"revision_id":2075209},"mentions":[{"id":"c-sanguozhi-049-shixie-complete:p008:m0002","surface":"朱符","start":2,"end":4,"kind":"person","person_id":"ryw_9jq_sgc","status":"contextual_provisional"},{"id":"c-sanguozhi-049-shixie-complete:p008:m0009","surface":"張津","start":9,"en