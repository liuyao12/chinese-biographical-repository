s":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-130-taishigong:p020","text":"子羽暴虐，漢行功德；憤發蜀漢，還定三秦；誅籍業帝，天下惟寧，改制易俗。作高祖本紀第八。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m020-0000","start":0,"end":2,"surface":"子羽","kind":"person","person_id":"789_h72_iju","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m020-0021","start":21,"end":22,"surface":"籍","kind":"person","person_id":"789_h72_iju","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m020-0036","start":36,"end":38,"surface":"高祖","kind":"person","person_id":"c34_m74_tgb","status":"contextual_provisional"}],"chapter_id":"c-shiji-130-taishigong","book_id":"b-shiji-130","work_id":"w-shiji","source_id":"s-shiji130-taishigong"},{"id":"c-shiji-130-taishigong:p030","text":"維高祖元功，輔臣股肱，剖符而爵，澤流苗裔，忘其昭穆，或殺身隕國。作高祖功臣侯者年表第六。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m030-0001","start":1,"end":3,"surface":"高祖","kind":"person","person_id":"c34_m74_tgb","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m030-0033","start":33,"end":35,"surface":"高祖","kind":"person","person_id":"c34_m74_tgb","status":"contextual_provisional"}],"chapter_id":"c-shiji-130-taishigong","book_id":"b-shiji-130","work_id":"w-shiji","source_id":"s-shiji130-taishigong"},{"id":"c-shiji-130-taishigong:p062","text":"漢既譎謀，禽信於陳；越荊剽輕，乃封弟交為楚王，爰都彭城，以彊淮泗，為漢宗藩。戊溺於邪，禮復紹之。嘉游輔祖，作楚元王世家二十。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m062-0006","start":6,"end":7,"surface":"信","kind":"person","person_id":"5rp_uvg_yrq","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m062-0018","start":18,"end":19,"surface":"交","kind":"person","person_id":"thq_oc7_85d","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m062-0038","start":38,"end":39,"surface":"戊","kind":"person","person_id":"or5_tvn_2wh","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m062-0043","start":43,"end":44,"surface":"禮","kind":"person","person_id":"7id_lmf_6bk","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m062-0049","start":49,"end":50,"surface":"游","kind":"person","person_id":"bek_7by_m23","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m062-0051","start":51,"end":52,"surface":"祖","kind":"person","person_id":"c34_m74_tgb","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m062-0054","start":54,"end":57,"surface":"楚元王","kind":"person","person_id":"thq_oc7_85d","status":"contextual_provisional"}],"chapter_id":"c-shiji-130-taishigong","book_id":"b-shiji-130","work_id":"w-shiji","source_id":"s-shiji130-taishigong"},{"id":"c-shiji-130-taishigong:p063","text":"維祖師旅，劉賈是與；為布所襲，喪其荊、吳。營陵激呂，乃王瑯邪；怵午信齊，往而不歸，遂西入關，遭立孝文，獲復王燕。天下未集，賈、澤以族，為漢藩輔。作荊燕世家第二十一。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m063-0001","start":1,"end":2,"surface":"祖","kind":"person","person_id":"c34_m74_tgb","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m063-0005","start":5,"end":7,"surface":"劉賈","kind":"person","person_id":"6mc_kd4_izc","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m063-0011","start":11,"end":12,"surface":"布","kind":"person","person_id":"gza_lsj_fvb","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m063-0021","start":21,"end":23,"surface":"營陵","kind":"person","person_id":"dgz_u0d_eu0","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m063-0024","start":24,"end":25,"surface":"呂","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-130-taishigong:m063-0032","start":32,"end":33,"surface":"午","kind":"person","person_id":"u9o_qmk_0te","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m063-0048","start":48,"end":50,"surface":"孝文","kind":"person","person_id":"3mw_y37_8sl","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m063-0061","start":61,"end":62,"surface":"賈","kind":"person","person_id":"6mc_kd4_izc","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m063-0063","start":63,"end":64,"surface":"澤","kind":"person","person_id":"ypk_6nq_1yh","status":"contextual_provisional"}],"chapter_id":"c-shiji-130-taishigong","book_id":"b-shiji-130","work_id":"w-shiji","source_id":"s-shiji130-taishigong"},{"id":"c-shiji-130-taishigong:p101","text":"填趙塞常山以廣河內，弱楚權，明漢王之信於天下。作張耳陳餘列傳第二十九。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m101-0015","start":15,"end":17,"surface":"漢王","kind":"person","person_id":"c34_m74_tgb","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m101-0024","start":24,"end":26,"surface":"張耳","kind":"person","person_id":"nm6_7g0_j96","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m101-0026","start":26,"end":28,"surface":"陳餘","kind":"person","person_id":"7m5_v97_we8","status":"contextual_provisional"}],"chapter_id":"c-shiji-130-taishigong","book_id":"b-shiji-130","work_id":"w-shiji","source_id":"s-shiji130-taishigong"},{"id":"c-shiji-130-taishigong:p110","text":"欲詳知秦楚之事，維周緤常從高祖，平定諸侯。作傅靳蒯成列傳第三十八。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m110-0009","start":9,"end":11,"surface":"周緤","kind":"person","person_id":"2j5_bn2_0yj","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m110-0013","start":13,"end":15,"surface":"高祖","kind":"person","person_id":"c34_m74_tgb","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m110-0022","start":22,"end":26,"surface":"傅靳蒯成","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-130-taishigong","book_id":"b-shiji-130","work_id":"w-shiji","source_id":"s-shiji130-taishigong"}],"sources":[{"chapter_id