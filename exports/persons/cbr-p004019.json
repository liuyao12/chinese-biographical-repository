{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004019","identity_policy":"contextual_provisional","person_ids":["cbr-p004019"],"persons":[{"id":"cbr-p004019","label":"客人（商君列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"客人","mention_ids":["c-shiji-068-shang:m010-0042"]}],"evidence":[{"mention_id":"c-shiji-068-shang:m010-0042","chapter_id":"c-shiji-068-shang","paragraph_id":"c-shiji-068-shang:p010","quote":"客人"}]}],"mentions":[{"id":"c-shiji-068-shang:m010-0042","start":42,"end":44,"surface":"客人","kind":"person","person_id":"cbr-p004019","status":"contextual_provisional","paragraph_id":"c-shiji-068-shang:p010","chapter_id":"c-shiji-068-shang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji068-025","person_id":"cbr-p004019","surfaces":["客人"],"scope":"same_chapter","chapter_ids":["c-shiji-068-shang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-068-shang:p010","quote":"後五月而秦孝公卒，太子立。公子虔之徒告商君欲反，發吏捕商君。商君亡至關下，欲舍客舍。客人不知其是商君也，曰：「商君之法，舍人無驗者坐之。」商君喟然嘆曰：「嗟乎，為法自斃一至此哉！」去之魏。魏人怨其欺公子卬而破魏師，弗受。商君欲之他國。魏人曰：「商君，秦之賊。秦彊而賊入魏，弗歸，不可。」遂內秦。商君既復入秦，走商邑，與其徒屬發邑兵北出擊鄭。秦發兵攻商君，殺之於鄭黽池。秦惠王車裂商君以徇，曰：「莫如商鞅反者！」遂滅商君之家。"}],"rationale":"篇首明示商君名鞅公孫氏，入秦段續稱公孫鞅衛鞅，封號段號商君，局部暫接。魏惠王與梁惠王按魏徙都敘事暫接，秦太子立後秦惠王暫接而不補名。趙良對話夫子歸趙良；五羖大夫引古不補未載姓名。公叔座不按公叔與孫吳篇合併；公子驩不當新名，商君開塞耕戰書不作本人錨點。版本、年代及其他代詞仍待覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-068-shang:p010","text":"後五月而秦孝公卒，太子立。公子虔之徒告商君欲反，發吏捕商君。商君亡至關下，欲舍客舍。客人不知其是商君也，曰：「商君之法，舍人無驗者坐之。」商君喟然嘆曰：「嗟乎，為法自斃一至此哉！」去之魏。魏人怨其欺公子卬而破魏師，弗受。商君欲之他國。魏人曰：「商君，秦之賊。秦彊而賊入魏，弗歸，不可。」遂內秦。商君既復入秦，走商邑，與其徒屬發邑兵北出擊鄭。秦發兵攻商君，殺之於鄭黽池。秦惠王車裂商君以徇，曰：「莫如商鞅反者！」遂滅商君之家。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-068-shang:m010-0004","start":4,"end":7,"surface":"秦孝公","kind":"person","person_id":"cbr-p003998","status":"context