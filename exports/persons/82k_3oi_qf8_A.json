n:line056","mention_id":"c-jinshu-043-shanjian:line056:m0217","quote":"遐"},{"work_id":"w-jinshu","book_id":"b-jinshu-073","chapter_id":"c-jinshu-073-jin043-shanxia","source_id":"s-jinshu-073-jin043-shanxia","paragraph_id":"c-jinshu-073-jin043-shanxia:letter","mention_id":"c-jinshu-073-jin043-shanxia:letter:m0000","quote":"山遐"},{"mention_id":"c-jinshu-073-yuyi:p004:m0205","paragraph_id":"c-jinshu-073-yuyi:p004","chapter_id":"c-jinshu-073-yuyi","quote":"山遐"}],"identity_note":"山簡子，為余姚令、東陽太守。","review":"ai_provisional","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"82k_3oi_qf8","status":"contextual_provisional","human_reviewed":false,"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-043","chapter_id":"c-jinshu-043-shanjian","source_id":"s-jinshu-043-shanjian","paragraph_id":"c-jinshu-043-shanjian:line056","quote":"尋加督寧、益軍事。時劉聰入寇，京師危逼。簡遣督護王萬率師赴難，次於涅陽，為宛城賊王如所破，遂嬰城自守。及洛陽陷沒，簡又為賊嚴嶷所逼，乃遷于夏口。招納流亡，江、漢歸附。時華軼以江州作難，或勸簡討之。簡曰：「與彥夏舊友，為之惆悵。簡豈利人之機，以為功伐乎！」其篤厚如此。時樂府伶人避難，多奔沔漢，宴會之日，僚佐或勸奏之。簡曰：「社稷傾覆，不能匡救，有晉之罪人也，何作樂之有！」因流涕慷慨，坐者咸愧焉。年六十卒，追贈征南大將軍、儀同三司。子遐。","source_term":"子遐"}],"source_assertion_id":"a-w043-shanxia-jian","interpretation_note":"直接父子見所引原句。","reviewer":"Codex（AI 代理）"}}],"source_mention_summary":[{"source_id":"s-jinshu-043-shanxia","work_id":"w-jinshu","book_id":"b-jinshu-043","chapter_id":"c-jinshu-043-shanxia","raw_mention_count":8,"mention_ids":["c-jinshu-043-shanxia:line059:m0000","c-jinshu-043-shanxia:line059:m0002","c-jinshu-043-shanxia:line059:m0034","c-jinshu-043-shanxia:line059:m0061","c-jinshu-043-shanxia:line059:m0074","c-jinshu-043-shanxia:line059:m0094","c-jinshu-043-shanxia:line059:m0105","c-jinshu-043-shanxia:line059:m0198"],"paragraph_ids":["c-jinshu-043-shanxia:line059"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-043-shanxia:line059:m0000","mention_ids":["c-jinshu-043-shanxia:line059:m0000"],"kind":"paragraph"},{"canonical_mention_id":"c-jinshu-043-shanxia:line059:m0002","mention_ids":["c-jinshu-04