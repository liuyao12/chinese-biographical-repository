ath":"corpus/songshu/052-xiejingren-near-family-rendered-assertions.json"}]},"work_id":"w-songshu","book_id":"b-songshu-052","source_id":"s-songshu-052-current-rendered-xiejingren-near-family"}],"mentions":[{"id":"c-songshu-052-xiejingren-near-family-rendered:p003:m0020","start":207,"end":208,"surface":"甝","kind":"person","person_id":"aa6_83c_juy_ABD","status":"contextual_provisional","paragraph_id":"c-songshu-052-xiejingren-near-family-rendered:p003","chapter_id":"c-songshu-052-xiejingren-near-family-rendered"},{"id":"c-songshu-052-xiejingren-near-family-rendered:p003:m0023","start":221,"end":222,"surface":"甝","kind":"person","person_id":"aa6_83c_juy_ABD","status":"contextual_provisional","paragraph_id":"c-songshu-052-xiejingren-near-family-rendered:p003","chapter_id":"c-songshu-052-xiejingren-near-family-rendered"}],"relations":[{"id":"a-songshu052-xie-support-han-younger-brother-jingren","subject_person_id":"aa6_83c_juy_ABD","predicate":"brother","object_person_id":"aa6_83c_juy_ABA","status":"source_attested","qualifiers":{"source_term":"景仁愛其第三弟甝","relative_birth_order":{"older_person_id":"aa6_83c_juy_ABA","younger_person_id":"aa6_83c_juy_ABD","operator":"lt","scope":"siblings"}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-052","source_id":"s-songshu-052-current-rendered-xiejingren-near-family","chapter_id":"c-songshu-052-xiejingren-near-family-rendered","paragraph_id":"c-songshu-052-xiejingren-near-family-rendered:p003","quote":"述字景先，少有志行，隨兄純在江陵。純遇害，述奉純喪還都。行至西塞，值暴風，純喪舫流漂，不知所在，述乘小船尋求之。經純妻庾舫過，庾遣人謂述曰：「喪舫存沒，已應有在，風波如此，豈可小船所冒？小郎去必無及，寧可存亡俱盡邪。」述號泣答曰：「若安全至岸，當須營理。如其已致意外，述亦無心獨存。」因冒浪而進，見純喪幾沒，述號叫呼天，幸而獲免，咸以為精誠所致也。高祖聞而嘉之，及臨豫州，諷中正以述為主簿，甚被知器。景仁愛其第三弟甝而憎述，嘗設饌請高祖，希命甝豫坐，而高祖召述。述知非景仁夙意，又慮高祖命之，請急不從。高祖馳遣呼述，須至乃歡。及景仁有疾，述盡心營視，湯藥飲食，必嘗而後進，不解帶、不盥櫛者累旬，景仁深懷感愧。","subject_person_mention_id":"c-songshu-052-xiejingren-near-family-rendered:p003:m0020","object_person_mention_id":"c-songshu-052-xiejingren-near-family-rendered:p003:m0019"}],"interpretation_note":"第三弟原詞全存；只給景仁年長於甝，不把弟群第三名改為父允所有子女的絕對排行。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[{"older_person_id":"aa6_83c_juy_ABA","younger_person_id":"aa6_83c_juy_ABD","operator":"lt","scope":"siblings","assertion_id":"a-songshu052-xie-support-han-younger-brother-jingren","person_id":"aa6_83c_juy_ABD","evidence":[{"work_id":"w-songshu","book_id":"b-songshu-052","source_id":"s-songshu-052-current-rendered-xiejingren-near-family","chapter_id":"c-songshu-052-xiejingren-near-family-rendered","paragraph_id":"c-songshu-052-xiejingren-near-family-rendered:p003","quote":"述字景先，少有志行，隨兄純在江陵。純遇害，述奉純喪還都。行至西塞，值暴風，純喪舫流漂，不知所在，述乘小船尋求之。經純妻庾舫過，庾遣人謂述曰：「喪舫存沒，已應有在，風波如此，豈可小船所冒？小郎去必無及，寧可存亡俱盡邪。」述號泣答曰：「若安全至岸，當須營理。如其已致意外，述亦無心獨存。」因冒浪而進，見純喪幾沒，述號叫呼天，幸而獲免，咸以為精誠所致也。高祖聞而嘉之，及臨豫州，諷中正以述為主簿，甚被知器。景仁愛其第三弟甝而憎述，嘗設饌請高祖，希命甝豫坐，而高祖召述。述知非景仁夙意，又慮高祖命之，請急不從。高祖馳遣呼述，須至乃歡。及景仁有疾，述盡心營視，湯藥飲食，必嘗而後進，不解帶、不盥櫛者累旬，景仁深懷感愧。","subject_person_mention_id":"c-songshu-052-xiejingren-near-family-rendered:p003:m0020","object_person_mention_id":"c-songshu-052-xiejingren-near-family-rendered:p003:m0019"}]}],"preferred_birth_order_constraints":[{"older_person_id":"aa6_83c_juy_ABA","younger_person_id":"aa6_83c_juy_ABD","operator":"lt","scope":"siblings","assertion_id":"a-songshu052-xie-support-han-younger-brother-jingren","person_id":"aa6_83c_juy_ABD","evidence":[{"work_id":"w-songshu","book_id":"b-songshu-052","source_id":"s-songshu-052-current-rendered-xiejingren-near-family","chapter_id":"c-songshu-052-xiejingren-near-family-rendered","paragraph_id":"c-songshu-052-xiejingren-near-family-rendered:p003","quote":"述字景先，少有志行，隨兄純在江陵。純遇害，述奉純喪還都。行至西塞，值暴風，純喪舫流漂，不知所在，述乘小船尋求之。經純妻庾舫過，庾遣人謂述曰：「喪舫存沒，已應有在，風波如此，豈可小船所冒？小郎去必無及，寧可存亡俱盡邪。」述號泣答曰：「若安全至岸，當須營理。如其已致意外，述亦無心獨存。」因冒浪而進，見純喪幾沒，述號叫呼天，幸而獲免，咸以為精誠所致也。高祖聞而嘉之，及臨豫州，諷中正以述為主簿，甚被知器。景仁愛其第三弟甝而憎述，嘗設饌請高祖，希命甝豫坐，而高祖召述。述知非景仁夙意，又慮高祖命之，請急不從。高祖馳遣呼述，須至乃歡。及景仁有疾，述盡心營視，湯藥飲食，必嘗而後進，不解帶、不盥櫛者累旬，景仁深懷感愧。","subject_person_mention_id":"c-songshu-052-xiejingren-near-family-rendered:p003:m0020","object_person_mention_id":"c-songshu-052-xiejingren-near-family-rendered:p003:m0019"}]}],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-songshu-052-xiejingren-near-family-rendered:p003","text":"述字景先，少有志行，隨兄純在江陵。純遇害，述奉純喪還都。行至西塞，值暴風，純喪舫流漂，不知所在，述乘小船尋求之。經純妻庾舫過，庾遣人謂述曰：「喪舫存沒，已應有在，風波如此，豈可小船所冒？小郎去必無及，寧可存亡俱盡邪。」述號泣答曰：「若安全至岸，當須營理。如其已致意外，述亦無心獨存。」因冒浪而進，見純喪幾沒，述號叫呼天，幸而獲免，咸以為精誠所致也。高祖聞而嘉之，及臨豫州，諷中正以述為主簿，甚被知器。景仁愛其第三弟甝而憎述，嘗設饌請高祖，希命甝豫坐，而高祖召述。述知非景仁夙意，又慮高祖命之，請急不從。高祖馳遣呼述，須至乃歡。及景仁有疾，述盡心營視，湯藥飲食，必嘗而後進，不解帶、不盥櫛者累旬，景仁深懷感愧。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-songshu-052-xiejingren-near-family-rendered:p003:m0001","start":0,"end":1,"surface":"述","kind":"person","person_id":"aa6_83c_juy_ABC","status":"contextual_provisional"},{"id":"c-songshu-052-xiejingren-near-family-rendered:p003:m0002","start":2,"end":4,"surface":"景先","kind":"person","person_id":"aa6_83c_juy_ABC","status":"contextual_provisional"},{"id":"c-songshu-052-xiejingren-near-family-rendered:p003:m0003","start":12,"end":13,"surface":"純","kind":"person","person_id":"aa6_83c_juy_ABB","status":"contextual_provisional"},{"id":"c-songshu-052-xiejingren-near-family-rendered:p003:m0004","start":17,"end":18,"surface":"純","kind":"person","person_id":"aa6_83c_juy_ABB","status":"contextual_provisional"},{"id":"c-songshu-052-xiejingren-near-family-rendered:p003:m0005","start":21,"end":22,"surface":"述","kind":"person","person_id":"aa6_83c_juy_ABC","status":"contextual_provisional"},{"id":"c-songshu-052-xiejingren-near-family-rendered:p003:m0006","start":23,"end":24,"surface":"純","kind":"person","person_id":"aa6_83c_juy_ABB","status":"contextual_provisional"},{"id":"c-songshu-052-xiejingren-near-family-rendered:p003:m0007","start":37,"end":38,"surface":"純","kind":"person","person_id":"aa6_83c_juy_ABB","status":"contextual_provisional"},{"id":"c-songshu-052-xiejingren-near-family-rendered:p003:m000