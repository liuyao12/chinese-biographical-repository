137,"surface":"柳","person_id":"5y0_bxq_0ur","kind":"person","status":"contextual_provisional","interpretation_note":"按相連人名、語法及所行之事。","paragraph_id":"c-jinshu-096-xiedaoyun:p003","chapter_id":"c-jinshu-096-xiedaoyun"},{"id":"c-jinshu-096-xiedaoyun:p003:m0154","start":154,"end":155,"surface":"柳","person_id":"5y0_bxq_0ur","kind":"person","status":"contextual_provisional","interpretation_note":"按相連人名、語法及所行之事。","paragraph_id":"c-jinshu-096-xiedaoyun:p003","chapter_id":"c-jinshu-096-xiedaoyun"},{"id":"c-jinshu-096-xiedaoyun:p003:m0196","start":196,"end":197,"surface":"柳","person_id":"5y0_bxq_0ur","kind":"person","status":"contextual_provisional","interpretation_note":"按相連人名、語法及所行之事。","paragraph_id":"c-jinshu-096-xiedaoyun:p003","chapter_id":"c-jinshu-096-xiedaoyun"}],"relations":[{"id":"a-jin061-liuliu-father","subject_person_id":"5y0_bxq_0ur","object_person_id":"mc1_08w_r6l","predicate":"father","qualifiers":{"source_term":"耽子柳"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-061","chapter_id":"c-jinshu-061-liudan","source_id":"s-jinshu-061-liudan-ws7903772","paragraph_id":"c-jinshu-061-liudan:p001","quote":"耽字敬道。少有行檢，以義尚流稱，為宗族所推。博學，明習《詩》、《禮》、三史。曆度支尚書，加散騎常侍。在職公平廉慎，所蒞著績。桓玄，耽女婿也。及玄輔政，以耽為尚書令，加侍中，不拜，改授特進、金紫光祿大夫。尋卒，追贈左光祿大夫、開府。耽子柳。","subject_person_mention_id":"c-jinshu-061-liudan:p001:m0117","object_person_mention_id":"c-jinshu-061-liudan:p001:m0000"}],"status":"source_attested","interpretation_note":"耽子柳接次篇。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"title_holdings":[{"id":"th-jin096-xiedaoyun-2","person_id":"5y0_bxq_0ur","title":"太守","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-096","chapter_id":"c-jinshu-096-xiedaoyun","source_id":"s-jinshu-096-xiedaoyun-ws2625341","paragraph_id":"c-jinshu-096-xiedaoyun:p003","quote":"及遭孫恩之難，舉厝自若，既聞夫及諸子已為賊所害，方命婢肩輿抽刃出門。亂兵稍至，手殺數人，乃被虜。其外孫劉濤時年數歲，賊又欲害之，道韞曰：「事在王門，何關他族！必其如此，寧先見殺。」恩雖毒虐，為之改容，乃不害濤。自爾嫠居會稽，家中莫不嚴肅。太守劉柳聞其名，請與談議。道韞素知柳名，亦不自阻，乃簪髻素褥坐於帳中，柳束脩整帶造於別榻。道韞風韻高邁，敘致清雅，先及家事，慷慨流漣，徐酬問旨，詞理無滯。柳退而歎曰：「實頃所未見，瞻察言氣，使人心形俱服。」道韞亦云：「親從凋亡，始遇此士，聽其所問，殊開人胸府。」","person_mention_id":"c-jinshu-096-xiedaoyun:p003:m0121"}],"attestations":[{"paragraph_id":"c-jinshu-096-xiedaoyun:p003","surface":"太守","start":119,"end":121,"id":"th-jin096-xiedaoyun-2:a","person_mention_id":"c-jinshu-096-xiedaoyun:p003:m0121","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"劉柳在此段的官序。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"th-jin096-xiedaoyun-2-wyd","person_id":"5y0_bxq_0ur","title":"太守","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-096","chapter_id":"c-jinshu-096-xiedaoyun-wyd","source_id":"s-jinshu-096-daoyun-wyd1916","paragraph_id":"c-jinshu-096-xiedaoyun-wyd:p003","quote":"及遭孫恩之難舉厝自若既聞夫及諸子已為賊所害方命婢肩輿抽刃出門亂兵稍至手殺數人乃被虜其外孫劉濤時年數歲賊又欲害之道韞曰事在王門何關他族必其如此寧先見殺恩雖毒虐為之改容乃不害濤自爾嫠居會稽家中莫不嚴肅太守劉柳聞其名請與談議道韞素知柳名亦不自阻乃簪髻素褥坐於帳中柳束脩整帶造于別榻道韞風韻高邁敘致清雅先及家事慷慨流漣徐酬問旨詞理無滯柳退而歎曰實頃所未見瞻察言氣使人心形俱服道韞亦云親從凋亡始遇此士聽其所問殊開人胸府","person_mention_id":"c-jinshu-096-xiedaoyun-wyd:p003:m0100"}],"attestations":[{"paragraph_id":"c-jinshu-096-xiedaoyun-wyd:p003","surface":"太守","start":98,"end":100,"id":"th-jin096-xiedaoyun-2-wyd:a1","person_mention_id":"c-jinshu-096-xiedaoyun-wyd:p003:m0100","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"劉柳在此段的官序。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"person_references":[{"id":"c-jinshu-096-xiedaoyun-wyd:p003:r0098","start":98,"end":100,"surface":"太守","person_id":"5y0_bxq_0ur","paragraph_id":"c-jinshu-096-xiedaoyun-wyd:p003","quote":"太守劉柳","referent_role":"third_person","note":"會稽敘境中之郡守。","ch