},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-039-jin:m041-0012","start":12,"end":14,"surface":"狐突","kind":"person","person_id":"nqp_02x_ekk","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p041","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m041-0055","start":55,"end":57,"surface":"狐突","kind":"person","person_id":"nqp_02x_ekk","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p041","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m050-0054","start":54,"end":56,"surface":"狐突","kind":"person","person_id":"nqp_02x_ekk","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p050","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m050-0076","start":76,"end":78,"surface":"狐突","kind":"person","person_id":"nqp_02x_ekk","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p050","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m050-0079","start":79,"end":80,"surface":"突","kind":"person","person_id":"nqp_02x_ekk","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p050","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m050-0114","start":114,"end":116,"surface":"狐突","kind":"person","person_id":"nqp_02x_ekk","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p050","chapter_id":"c-shiji-039-jin"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji039-168","person_id":"nqp_02x_ekk","surfaces":["狐突","突"],"scope":"same_chapter","chapter_ids":["c-shiji-039-jin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-039-jin:p041","quote":"晉君改葬恭太子申生。秋，狐突之下國，遇申生，申生與載而告之曰：「夷吾無禮，余得請於帝，將以晉與秦，秦將祀余。」狐突對曰：「臣聞神不食非其宗，君其祀毋乃絶乎？君其圖之。」申生曰：「諾，吾將復請帝。後十日，新城西偏將有巫者見我焉。」許之，遂不見。及期而往，復見，申生告之曰：「帝許罰有罪矣，弊於韓。」兒乃謠曰：「恭太子更葬矣，後十四年，晉亦不昌，昌乃在兄。」"},{"paragraph_id":"c-shiji-039-jin:p050","quote":"子圉之亡，秦怨之，乃求公子重耳，欲内之。子圉之立，畏秦之伐也。乃令國中諸從重耳亡者與期，期盡不到者盡滅其家。狐突之子毛及偃從重耳在秦，弗肯召。懷公怒，囚狐突。突曰：「臣子事重耳有年數矣，今召之，是教之反君也。何以教之？」懷公卒殺狐突。秦繆公乃發兵送内重耳，使人告欒、郤之黨爲内應，殺懷公於髙梁，入重耳。重耳立，是爲文公。"}],"rationale":"按本篇明示名與稱號、晉世系與具體事件暫定所列提及同指；附各段原文，未按同字短名全域合併；紀年與版本差異待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-039-jin:p041","text":"晉君改葬恭太子申生。秋，狐突之下國，遇申生，申生與載而告之曰：「夷吾無禮，余得請於帝，將以晉與秦，秦將祀余。」狐突對曰：「臣聞神不食非其宗，君其祀毋乃絶乎？君其圖之。」申生曰：「諾，吾將復請帝。後十日，新城西偏將有巫者見我焉。」許之，遂不見。及期而往，復見，申生告之曰：「帝許罰有罪矣，弊於韓。」兒乃謠曰：「恭太子更葬矣，後十四年，晉亦不昌，昌乃在兄。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m041-0000","start":0,"end":2,"surface":"晉君","kind":"person","person_id":"a9v_t0d_3va","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m041-0004","start":4,"end":9,"surface":"恭太子申生","kind":"person","person_id":"6di_ywz_ju4_AAB","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m041-0012","start":12,"end":14,"surface":"狐突","kind":"person","person_id":"nqp_02x_ekk","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m041-0019","start":19,"end":21,"surface":"申生","kind":"person","person_id":"6di_ywz_ju4_AAB","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m041-0022","start":22,"end":24,"surface":"申生","kind":"person","person_id":"6di_ywz_ju4_AAB","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m041-0032","start":32,"end":34,"surface":"夷吾","kind":"person","person_id":"a9v_t0d_3va","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m041-0041","start":41,"end":42,"surface":"帝","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m041-0055","start":55,"end":57,"surface":"狐突","kind":"person","person_id":"nqp_02x_ekk","statu