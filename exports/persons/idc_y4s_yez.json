nterpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-yufan:line021-pei01-01:m0132","start":132,"end":133,"surface":"翻","kind":"person","person_id":"izi_e36_p1g","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"}],"annotation_status":"reviewed","source_position":{"first_line":21,"last_line":21,"revision_id":2638131,"raw_start":2576,"raw_end":2713,"character_positions":[2576,2577,2578,2579,2580,2581,2582,2583,2584,2585,2586,2587,2588,2589,2590,2591,2592,2593,2594,2595,2596,2597,2598,2599,2600,2601,2602,2603,2604,2605,2606,2607,2608,2609,2610,2611,2612,2613,2614,2615,2616,2617,2618,2619,2620,2621,2622,2623,2624,2625,2626,2627,2628,2629,2630,2631,2632,2633,2634,2635,2636,2637,2638,2639,2640,2641,2642,2643,2644,2645,2646,2647,2648,2649,2650,2651,2652,2653,2654,2655,2656,2657,2658,2659,2660,2661,2662,2663,2664,2665,2666,2667,2668,2669,2670,2671,2672,2673,2674,2675,2676,2677,2678,2679,2680,2681,2682,2683,2684,2685,2686,2687,2688,2689,2690,2691,2692,2693,2694,2695,2696,2697,2698,2699,2700,2701,2702,2703,2704,2705,2706,2707,2708,2709,2710,2711,2712]},"attribution":{"annotator":"裴松之","attribution_kind":"quoted_work","source_label":"吳書","attribution_marker":"《吴书》曰：","quoted_work":"吳書"},"attachment":{"received_paragraph_id":"c-sanguozhi-057-yufan:line021","received_codepoint":105,"note_ordinal":1,"source_ordinal":1},"chapter_id":"c-sanguozhi-057-yufan","book_id":"b-sanguozhi-057","work_id":"w-sanguozhi","source_id":"s-sanguozhi-057-yufan"},{"id":"c-sanguozhi-058-luxun:line018","text":"于禁等見獲，遐邇欣歎，以為將軍之勳足以長世，雖昔晉文城濮之師，淮陰拔趙之略，蔑以尚茲。聞徐晃等少騎駐旌，窺望麾葆。操猾虜也，忿不思難，恐潛增眾，以逞其心。雖雲師老，猶有驍悍。且戰捷之後，常苦輕敵，古人杖術，軍勝彌警，願將軍廣為方計，以全獨克。僕書生疏遲，忝所不堪。喜鄰威德，樂自傾盡。雖未合策，猶可懷也。倘明注仰，有以察之。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-058-luxun:line018:m0000","start":0,"end":2,"surface":"于禁","kind":"person","person_id":"idc_y4s_yez","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line018:m0024","start":24,"end":26,"surface":"晉