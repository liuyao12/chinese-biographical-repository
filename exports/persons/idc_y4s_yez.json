red","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-058-luxun:line018:m0000","start":0,"end":2,"surface":"于禁","kind":"person","person_id":"idc_y4s_yez","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-058-luxun:line018","chapter_id":"c-sanguozhi-058-luxun"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-058-luxun:line018","text":"于禁等見獲，遐邇欣歎，以為將軍之勳足以長世，雖昔晉文城濮之師，淮陰拔趙之略，蔑以尚茲。聞徐晃等少騎駐旌，窺望麾葆。操猾虜也，忿不思難，恐潛增眾，以逞其心。雖雲師老，猶有驍悍。且戰捷之後，常苦輕敵，古人杖術，軍勝彌警，願將軍廣為方計，以全獨克。僕書生疏遲，忝所不堪。喜鄰威德，樂自傾盡。雖未合策，猶可懷也。倘明注仰，有以察之。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-058-luxun:line018:m0000","start":0,"end":2,"surface":"于禁","kind":"person","person_id":"idc_y4s_yez","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line018:m0024","start":24,"end":26,"surface":"晉文","kind":"person","person_id":"6di_ywz_ju4_AAA","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line018:m0031","start":31,"end":33,"surface":"淮陰","kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line018:m0044","start":44,"end":46,"surface":"徐晃","kind":"person","person_id":"662_7a2_a39","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line018:m0057","start":57,"end":58,"surface":"操","kind":"person","person_id":"dad_b77_b38","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"}],"annotation_status":"reviewed","source_position":{"first_line":18,"last_line":18,"revision_id":2131313,"raw_start":1136,"raw_