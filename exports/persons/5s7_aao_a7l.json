y":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-064-simayan-wu:p002:m0087","surface":"祥","start":87,"end":88,"person_id":"5s7_aao_a7l","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-064-simayan-wu:p002","chapter_id":"c-jinshu-064-simayan-wu"},{"id":"c-jinshu-064-simayun:p004:m0151","surface":"祥","start":151,"end":152,"person_id":"5s7_aao_a7l","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-064-simayun:p004","chapter_id":"c-jinshu-064-simayun"}],"relations":[{"id":"a-jin064-xiang-father","subject_person_id":"5s7_aao_a7l","object_person_id":"k08_xhu_k3k","predicate":"father","qualifiers":{"source_term":"吳王晏子祥"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-064","chapter_id":"c-jinshu-064-simayun","source_id":"s-jinshu-064-simayun-ws2622004","paragraph_id":"c-jinshu-064-simayun:p004","quote":"及倫誅，齊王冏上表理允曰：「故淮南王允忠孝篤誠，憂國忘身，討亂奮發，幾於克捷。遭天凶運，奄至隕沒，逆黨進惡，並害三子，冤魂酷毒，莫不悲酸。洎興義兵，淮南國人自相率領，眾過萬人，人懷慷愾，湣國統滅絕，發言流涕。臣輒以息超繼允後，以尉存亡。」有詔改葬，賜以殊禮，追贈司徒。冏敗，超被幽金墉城。後更以吳王晏子祥為嗣，拜散騎常侍。洛京傾覆，為劉聰所害。","subject_person_mention_id":"c-jinshu-064-simayun:p004:m0151","object_person_mention_id":"c-jinshu-064-simayun:p004:m0147"}],"status":"source_attested","interpretation_note":"奉淮南王允之後為另一事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-064-simayan-wu:p002","text":"晏為人恭願，才不及中人，于武帝諸子中最劣。又少有風疾，視瞻不端，後轉增劇，不堪朝覲。及洛京傾覆，晏亦遇害，時年三十一。湣帝即位，追贈太保。五子，長子不顯名，與晏同沒。餘四子：祥、鄴、固、衍。祥嗣淮南王允。鄴即湣帝。固初封漢王，改封濟南。衍初封新都王，改封濟陰，為散騎常侍。皆沒於賊。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":60,"last_line":60,"raw_start":3377,"raw_end":3564,"raw_character_