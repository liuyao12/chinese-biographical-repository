ong:m015-0027","start":27,"end":29,"surface":"高宗","kind":"person","person_id":"9ok_lk8_nks","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m015-0030","start":30,"end":32,"surface":"帝辛","kind":"person","person_id":"y3l_45z_mfp","status":"contextual_provisional"}],"chapter_id":"c-shiji-130-taishigong","book_id":"b-shiji-130","work_id":"w-shiji","source_id":"s-shiji130-taishigong"},{"id":"c-shiji-130-taishigong:p037","text":"非兵不彊，非德不昌，黃帝、湯、武以興，桀、紂、二世以崩，可不慎歟？司馬法所從來尚矣，太公、孫、吳、王子能紹而明之，切近世，極人變。作律書第三。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m037-0010","start":10,"end":12,"surface":"黃帝","kind":"person","person_id":"ocd_ibe_at1","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m037-0013","start":13,"end":14,"surface":"湯","kind":"person","person_id":"0np_0mp_q1l","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m037-0015","start":15,"end":16,"surface":"武","kind":"person","person_id":"a8q_r4j_swi","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m037-0019","start":19,"end":20,"surface":"桀","kind":"person","person_id":"91n_mvc_uix","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m037-0021","start":21,"end":22,"surface":"紂","kind":"person","person_id":"y3l_45z_mfp","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m037-0023","start":23,"end":25,"surface":"二世","kind":"person","person_id":"hem_zeh_251","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m037-0042","start":42,"end":44,"surface":"太公","kind":"person","person_id":"hnu_8zd_5n9","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m037-0045","start":45,"end":46,"surface":"孫","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-130-taishigong:m037-0047","start":47,"end":48,"surface":"吳","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-130-taishigong:m037-0049","start":49,"end":51,"surfac