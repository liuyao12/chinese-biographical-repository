5,"surface":"平","kind":"person","person_id":"uqc_ejd_tc4","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-061-lukai:line046-pei01-01","chapter_id":"c-sanguozhi-061-lukai"},{"id":"c-sanguozhi-061-lukai:line046-pei01-01:m0100","start":100,"end":101,"surface":"平","kind":"person","person_id":"uqc_ejd_tc4","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-061-lukai:line046-pei01-01","chapter_id":"c-sanguozhi-061-lukai"}],"relations":[],"title_holdings":[{"id":"t-wu061-t-wu061-lukai22","person_id":"uqc_ejd_tc4","kind":"office","title":"左將軍","mode":"attestation","status":"source_attested","effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本句所載職官，任免時間未詳。","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-061","chapter_id":"c-sanguozhi-061-lukai","source_id":"s-sanguozhi-061-lukai","paragraph_id":"c-sanguozhi-061-lukai:line046","quote":"　　初，皓常銜凱數犯顏忤旨，加何定譖構非-，既以重臣，難繩以法，又陸抗時為大將在疆場，故以計容忍。抗卒後，竟徙凱家於建安。或曰寶鼎元年十二月，凱與大司馬丁奉、御史大夫丁固謀，因皓謁廟，欲廢皓立孫休子。時左將軍留平領兵先驅，故密語平，平拒而不許，誓以不洩，是以所圖不果。太史郎陳苗奏皓久陰不雨，風氣回逆，將有陰謀，皓深警懼雲。","person_mention_id":"c-sanguozhi-061-lukai:line046:m0104"}],"attestations":[{"id":"t-wu061-t-wu061-lukai22:a","paragraph_id":"c-sanguozhi-061-lukai:line046","person_mention_id":"c-sanguozhi-061-lukai:line046:m0104","start":101,"end":104,"surface":"左將軍","usage":"narrative","date_expression":null}],"human_reviewed":false,"reviewer":"Codex（AI 代理）","model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-060-zhonglimu:line099-pei01-01","text":"会稽典录曰：牧次子盛，亦履恭让，为尚书郎。弟徇领兵为将，拜偏将军，戍西陵，与监军使者唐盛论地形势，谓宜城、信陵为建平援，若不先城，敌将先入。盛以施绩、留平，智略名将，屡经於彼，無云當城之者，不然徇计。后半年，晋果遣将脩信陵城。晋军平吴，徇领水军督，临陈战死。","text_la