_3y8_7ha_A","attestations":[{"id":"th-sanguozhi-064-suncong-complete-2-120:a","paragraph_id":"c-sanguozhi-064-suncong-complete:p002","start":120,"end":123,"surface":"黃門郎","person_mention_id":"c-sanguozhi-064-suncong-complete:p002:m0118","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-064","chapter_id":"c-sanguozhi-064-suncong-complete","source_id":"s-sanguozhi-064-suncong-complete-ws2263487","paragraph_id":"c-sanguozhi-064-suncong-complete:p002","quote":"文士傳曰：華融字德蕤，廣陵江都人。祖父避亂，居山陰蕊山下。時皇象亦寓居山陰，吳郡張溫來就像學，欲得所舍。或告溫曰：「蕊山下有華德蕤者，雖年少，美有令志，可舍也。」溫遂止融家，朝夕談講。俄而溫為選部尚書，乃擢融為太子庶子，遂知名顯達。融子諝，黃門郎，與融並見害。次子譚，以才辯稱，晉秘書監。","person_mention_id":"c-sanguozhi-064-suncong-complete:p002:m0118"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-052-hua-tan:p001","text":"華譚，字令思，廣陵人也。祖融，吳左將軍、錄尚書事。父諝，吳黃門郎。譚期歲而孤，母年十八，便守節鞠養，動勞備至。及長，好學不倦，爽慧有口辯，為鄰里所重。揚州刺史周浚引為從事史，愛其才器，待以賓友之禮。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":58,"last_line":58,"raw_start":5073,"raw_end":5172,"raw_character_offsets":[5073,5074,5075,5076,5077,5078,5079,5080,5081,5082,5083,5084,5085,5086,5087,5088,5089,5090,5091,5092,5093,5094,5095,5096,5097,5098,5099,5100,5101,5102,5103,5104,5105,5106,5107,5108,5109,5110,5111,5112,5113,5114,5115,5116,5117,5118,5119,5120,5121,5122,5123,5124,5125,5126,5127,5128,5129,5130,5131,5132,5133,5134,5135,5136,5137,5138,5139,5140,5141,5142,5143,5144,5145,5146,5147,5148,5149,5150,5151,5152,5153,5154,5155,5156,5157,5158,5159,5160,5161,5162,5163,5164,5165,5166,5167,5