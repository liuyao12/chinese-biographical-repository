t":2,"end":4,"surface":"子夏","kind":"person","person_id":"cbr-p003871","status":"contextual_provisional","paragraph_id":"c-shiji-067-disciples:p054","chapter_id":"c-shiji-067-disciples"},{"id":"c-shiji-067-disciples:m055-0005","start":5,"end":7,"surface":"子夏","kind":"person","person_id":"cbr-p003871","status":"contextual_provisional","paragraph_id":"c-shiji-067-disciples:p055","chapter_id":"c-shiji-067-disciples"}],"relations":[{"id":"a-shiji067-002","subject_person_id":"cbr-p003911","predicate":"father","object_person_id":"cbr-p003871","status":"source_attested","evidence":[{"chapter_id":"c-shiji-067-disciples","source_id":"s-shiji-067-disciples","paragraph_id":"c-shiji-067-disciples:p055","quote":"孔子既沒，子夏居西河教授，爲魏文侯師。其子死，哭之失明。"}],"qualifiers":{"source_term":"其子死","historicity":"historical_tradition"},"interpretation_note":"按明示父母、其子及娶女為夫人保存，未名家屬不補姓名。鯉稱按孔子自述葬子與顏回父子敘事暫定，不以年齡或傳授順序補世系；來源陳述與獨立史實確證分開。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji067-017","person_id":"cbr-p003871","title":"師","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-067-disciples","source_id":"s-shiji-067-disciples","paragraph_id":"c-shiji-067-disciples:p055","quote":"孔子既沒，子夏居西河教授，爲魏文侯師。其子死，哭之失明。"}],"attestations":[{"id":"th-shiji067-017:a001","paragraph_id":"c-shiji-067-disciples:p055","start":17,"end":18,"surface":"師","person_mention_id":"c-shiji-067-disciples:m055-0005","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"保存授予事件與文獻用稱，不以首次用稱、死亡或出奔推定全部任期邊界。閔損不仕、漆彫開未能信而未出仕、孔子可使等評論均不當已任。相魯衞與相衞照原文，未定官名或精確時段；有若共立為師不作官職。楊何元朔中用稱未換算精確日期。諡稱及來源敘事仍待底本與研究覆核。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji067-011","person_id":"cbr-p003871","surfaces":["卜商","商","子夏"],"scope":"same_chapter","chapter_ids":["c-shiji-067-disciples"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-067-disciples:p001","quote":"孔子曰「受業身通者七十有七人」，皆異能之士也。德行：顏淵，閔子騫，冉伯牛，仲弓。政事：冉有，季路。言語：宰我，子貢。文學：子游，子夏。師也辟，參也魯，柴也愚，由也喭，回也屢空。賜不受命而貨殖焉，億則屢中。"},{"paragraph_id":"c-shiji-067-disciples:p051","quote":"卜商字子夏。少孔子四十四歳。"},{"paragraph_id":"c-shiji-067-disciples:p052","quote":"子夏問：「『巧笑倩兮，美目盼兮，素以爲絢兮』，何謂也？」子曰：「繪事後素。」曰：「禮後乎？」孔子曰：「商始可與言詩已矣。」"},{"paragraph_id":"c-shiji-067-disciples:p053","quote":"子貢問：「師與商孰賢？」子曰：「師也過，商也不及。」「然則師愈與？」曰：「過猶不及。」"},{"paragraph_id":"c-shiji-067-disciples:p054","quote":"子謂子夏曰：「汝爲君子儒，無爲小人儒。」"},{"paragraph_id":"c-shiji-067-disciples:p055","quote":"孔子既沒，子夏居西河教授，爲魏文侯師。其子死，哭之失明。"}],"rationale":"依篇內明示姓名字稱及局部問答暫接。吳越王稱按夫差句踐連續敘事；第71段夫子指原憲，第90段指代未定。傳易短何分田子莊何與楊何，傳授不當父子；引古人物保留傳說性。冉季字子產不接鄭子產，原憲子思不接孔子後世子思；名錄各條同字子徒、子聲、子上、皙等均保留不同候選，鄭國是此條人名。魯昭公夫人孟子不接戰國孟子。全152段明示姓名首輪已存，未名者、代詞、版本及跨篇身份待覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-067-disciples:p001","text":"孔子曰「受業身通者七十有七人」，皆異能之士也。德行：顏淵，閔子騫，冉伯牛，仲弓。政事：冉有，季路。言語：宰我，子貢。文學：子游，子夏。師也辟，參也魯，柴也愚，由也喭，回也屢空。賜不受命而貨殖焉，億則屢中。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-067-disciples:m001-0000","start":0,"end":2,"surface":"孔子","kind":"person","person_id":"cbr-p003861","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0004","start":4,"end":9,"surface":"受業身通者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者、氏族或未定指代，尚未補姓名及成員。"},{"id":"c-shiji-067-disciples:m001-0017","start":17,"end":21,"surface":"異能之士","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者、氏族或未定指代，尚未補姓名及成員。"},{"id":"c-shiji-067-disciples:m001-0026","start":26,"end":28,"surface":"顏淵","kind":"person","person_id":"cbr-p003862","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0029","start":29,"end":32,"surface":"閔子騫","kind":"person","person_id":"cbr-p003863","status":"contextual_provisional"},{"id":"c-shiji-067