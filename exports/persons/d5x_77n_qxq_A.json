u","book_id":"b-liangshu-027","source_id":"s-liangshu-027-luxiang-wangqian-ws1511478","chapter_id":"c-liangshu-027-luxiang-wangqian","paragraph_id":"c-liangshu-027-luxiang-wangqian:p001","quote":"陸襄字師卿，吳郡吳人也。父閑，齊始安王遙光揚州治中。","subject_person_mention_id":"c-liangshu-027-luxiang-wangqian:p001:m0000","object_person_mention_id":"c-liangshu-027-luxiang-wangqian:p001:m0013"}],"status":"source_attested","interpretation_note":"陸襄父閑。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-021-wangfen:p012","text":"僉字公會，錫第五弟也。八歲丁父憂，哀毀過禮。服闋，召補國子生，祭酒袁昂稱爲通理。策高第，除長史兼秘書郎中，歷尚書殿中郎，太子中舍人，與吳郡陸襄對掌東宮管記。出爲建安太守。山酋方善、謝稀聚徒依險，屢爲民患，僉潛設方略，率衆平之，有詔褒美，頒示州郡。除武威將軍、始興內史，丁所生母憂，固辭不拜。又除寧遠將軍、南康內史，屬盧循作亂，復轉僉爲安成內史，以鎮撫之。還除黃門侍郎，尋爲安西武陵王長史、蜀郡太守。僉憚岨嶮，固以疾辭，因以黜免。久之，除戎昭將軍、尚書左丞，復補黃門侍郎，遷太子中庶子，掌東宮管記。太清二年十二月，卒，時年四十五。贈侍中，給東園秘器，朝服一具，衣一襲。承聖三年，世祖追詔曰：「賢而不伐曰恭，諡恭子。」","mentions":[{"id":"c-liangshu-021-wangfen:p012:m0000","surface":"僉","start":0,"end":1,"person_id":"q7m_r8k_2vn_ABAF","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-liangshu-021-wangfen:p012:m0002","surface":"公會","start":2,"end":4,"person_id":"q7m_r8k_2vn_ABAF","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-liangshu-021-wangfen:p012:m0005","surface":"錫","start":5,"end":6,"person_id":"q7m_r8k_2vn_ABAB","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-liangshu-021-wangfen:p012:m0033","surface":"袁昂","start":33,"end":35,"person_id":"hb9_2gq_205","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-liangshu-021-wangfen:p012:m0069","surface":"陸襄","start":69,"end":71,"person_id":"d5x_77n_qxq_A","kind":"person","status":"contextual_provisional","inter