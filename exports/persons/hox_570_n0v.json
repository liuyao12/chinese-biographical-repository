ons_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-034-duyu:p009:m0183","start":183,"end":185,"surface":"劉憲","kind":"person","person_id":"hox_570_n0v","status":"source_explicit","paragraph_id":"c-jinshu-034-duyu:p009","chapter_id":"c-jinshu-034-duyu"}],"relations":[],"title_holdings":[{"id":"th-jin034-duyu-career_037","person_id":"hox_570_n0v","status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-034","chapter_id":"c-jinshu-034-duyu","source_id":"s-jinshu-034-ws2567662-duyu","paragraph_id":"c-jinshu-034-duyu:p009","quote":"時帝密有滅吳之計，而朝議多違，唯預、羊祜、張華與帝意合。祜病，舉預自代，因以本官假節行平東將軍，領征南軍司。及祜卒，拜鎮南大將軍、都督荊州諸軍事，給追鋒車，第二駙馬。預既至鎮，繕甲兵，耀威武，乃簡精銳，襲吳西陵督張政，大破之，以功增封三百六十五戶。政，吳之名將也，據要害之地，恥以無備取敗，不以所喪之實告于孫皓。預欲間吳邊將，乃表還其所獲之眾於皓。皓果召政，遣武昌監劉憲代之。故大軍臨至，使其將帥移易，以成傾蕩之勢。","person_mention_id":"c-jinshu-034-duyu:p009:m0183"}],"reviewer":"Codex（AI代理）","human_reviewed":false,"model":null,"interpretation_note":"完整固定本傳逐角色判讀；起終年未知不補、來源用稱不冒授任。","fixed_source_fact_binding":{"kind":"fixed_witness_person_fact_slots","key":"jin034-duyu-kinship","slot":"career_037"},"title":"武昌監","kind":"office","mode":"attestation","source_career_role":{"kind":"fixed_witness_person_fact_slots","key":"jin034-duyu-kinship","slot":"career_037"},"attestations":[{"id":"th-jin034-duyu-career_037:a001","paragraph_id":"c-jinshu-034-duyu:p009","start":180,"end":183,"surface":"武昌監","person_mention_id":"c-jinshu-034-duyu:p009:m0183","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}}}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-034-duyu:p009","text":"時帝密有滅吳之計，而朝議多違，唯預、羊祜、張華與帝意合。祜病，舉預自代，因以本官假節行平東將軍，領征南軍司。及祜卒，拜鎮南大將軍、都督荊州諸軍事，給追鋒車，第二駙馬。預既至鎮，繕甲兵，耀威武，乃簡精銳，襲吳西陵督張政，大破之，以功增封三百六十五戶。政，吳之名將也，據要害之地，恥以無備取敗，不以所喪之實告于孫皓。預欲間吳邊將，乃表還其所獲之眾於皓。皓果召政，遣武昌監劉憲代之。故大軍臨至，使其將帥移易，以成傾蕩之勢。","text_layer":"received_chapter","source_position":{"raw_start":8612,"raw_end":8822,"raw_character_offsets":[8614,8615,8616,8617,8618,8619,8620,8621,8622,8623,8624,8625,8626,8627,8628,8629,8630,8631,8632,8633,8634,8635,8636,8637,8638,8639,8640,8641,8642,8643,8644,8645,8646,8647,8648,8649,8650,8651,8652,8653,8654,8655,8656,8657,8658,8659,8660,8661,8662,8663,8664,8665,8666,8667,8668,8669,8670,8671,8672,8673,8674,8675,8676,8677,8678,8679,8680,8681,8682,8683,8684,8685,8686,8687,8688,8689,8690,8691,8692,8693,8694,8695,8696,8697,8698,8699,8700,8701,8702,8703,8704,8705,8706,8707,8708,8709,8710,8711,8712,8713,8714,8715,8716,8717,8718,8719,8720,8721,8722,8723,8724,8725,8726,8727,8728,8729,8730,8731,8732,8733,8734,8735,8736,8737,8738,8739,8740,8741,8742,8743,8744,8745,8746,8747,8748,8749,8750,8751,8752,8753,8754,8755,8756,8757,8758,8759,8760,8761,8762,8763,8764,8765,8766,8767,8768,8769,8770,8771,8772,8773,8774,8775,8776,8777,8778,8779,8780,8781,8782,8783,8784,8785,8786,8787,8788,8789,8790,8791,8792,8793,8794,8795,8796,8797,8798,8799,8800,8801,8802,8803,8804,8805,8806,8807,8808,8809,8810,8811,8812,8813,8814,8815,8816,8817,8818,8819,8820,8821],"first_line":103,"last_line":103,"revision_id":2567662,"projection_sha256":"e45f572269dc182f3746a50e28ef0f8ef5e22e91b175cba56d266b70d17b05cc","source_layer":"received_biography","editorial_subsection":" [[作者:杜預|杜預]] ","quotation_block_markup":false},"mentions":[{"id":"c-jinshu-034-duyu:p009:m0001","start":1,"end":2,"surface":"帝","kind":"person","person_id":"hgm_jvn_hle","status":"contextual"},{"id":"c-jinshu-034-duyu:p009:m0016","start":16,"end":17,"surface":"預","kind":"person","person_id":"yh6_z1j_fsd","status":"contextual"},{"id":"c-jinshu-034-duyu:p009:m0018","start":18,"end":20,"surface":"羊祜","kind":"person","person_id":"dqd_5q9_pkz_BD","status":"source_explicit"},{"id":"c-jinshu-034-duyu:p009:m0021","sta