"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-058-lukang:line071:m0006","start":6,"end":7,"surface":"胤","kind":"person","person_id":"6se_002_f8d","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-058-lukang:line071","chapter_id":"c-sanguozhi-058-lukang"},{"id":"c-sanguozhi-058-lukang:line071:m0057","start":57,"end":58,"surface":"胤","kind":"person","person_id":"6se_002_f8d","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-058-lukang:line071","chapter_id":"c-sanguozhi-058-lukang"}],"relations":[],"title_holdings":[{"id":"t-wu058-k13","person_id":"6se_002_f8d","kind":"office","title":"巴東監軍","mode":"attestation","status":"source_attested","effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本句所載職官，任免時間未詳。","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-058","chapter_id":"c-sanguozhi-058-lukang","source_id":"s-sanguozhi-058-lukang","paragraph_id":"c-sanguozhi-058-lukang:line071","quote":"晉巴東監軍徐胤率水軍詣建平，荊州刺史楊肇至西陵。抗令張咸固守其城；公安督孫遵巡南岸御祜；水軍督留慮、鎮西將軍朱琬拒胤。身率三軍，憑圍對肇。將軍朱喬、營都督俞贊亡詣肇。抗曰：「贊軍中舊吏，知吾虛實者，吾常慮夷兵素不簡練，若敵攻圍，必先此處。」即夜易夷民，皆以舊將充之。明日，肇果攻故夷兵處，抗命旋軍擊之，矢石雨下，肇眾傷死者相屬。肇至經月。計屈夜遁。抗欲追之，而慮闡畜力項領，伺視間隙，兵不足分，於是但鳴鼓戒眾，若將追者。肇眾兇懼，悉解甲挺走，抗使輕兵躡之，肇大破敗，祜等皆引軍還。抗遂陷西陵城，誅夷闡族及其大將吏，自此以下，所請赦者數萬口。修治城圍，東還樂鄉，貌無矜色，謙沖如常，故得將士歡心。","person_mention_id":"c-sanguozhi-058-lukang:line071:m0006"}],"attestations":[{"id":"t-wu058-k13:a","paragraph_id":"c-sanguozhi-058-lukang:line071","person_mention_id":"c-sanguozhi-058-lukang:line071:m0006","start":1,"end":5,"surface":"巴東監軍","usage":"narrative","date_expression":null}],"human_reviewed":false,"reviewer":"Codex（AI 代理）","model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-058-lukang:line071","text":"晉巴東監軍徐胤率水軍詣建平，荊州刺史楊肇至西陵。抗令張咸固守其城；公安督孫遵巡南岸御祜；水軍督留慮、鎮西將軍朱琬拒胤。身率三軍，憑圍對肇。將軍朱喬、營都督俞贊亡詣肇。抗曰：「贊軍中舊吏，知吾虛實者，吾常慮夷兵素不簡練，若敵攻圍，必先此處。」即夜易夷民，皆以舊將充之。明日，肇果攻故夷兵處，抗命旋軍擊之，矢石雨下，肇眾傷死者相屬。肇至經月。計屈夜遁。抗欲追之，而慮闡畜力項領，伺視間隙，兵不足分，於是但鳴鼓戒眾，若將追者。肇眾兇懼，悉解甲挺走，抗使輕兵躡之，肇大破敗，祜等皆引軍還。抗遂陷西陵城，誅夷闡族及其大將吏，自此以下，所請赦者數萬口。修治城圍，東還樂鄉，貌無矜色，謙沖如常，故得將士歡心。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-058-lukang:line071:m0006","start":6,"end":7,"surface":"胤","kind":"person","person_id":"6se_002_f8d","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-lukang:line071:m0019","start":19,"end":20,"surface":"肇","kind":"person","person_id":"sta_dcm_n53","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-lukang:line071:m0024","start":24,"end":25,"surface":"抗","kind":"person","person_id":"40p_eb9_ggr","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-lukang:line071:m0026","start":26,"end":28,"surface":"張咸","kind":"person","person_id":"qv3_hvy_40s","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-lukang:line071:m0036","start":36,"end":38,"surface":"孫遵","kind":"person","person_id":"sys_aqo_3w7","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-lukang:line071:m0042","start":42,"end":43,"surface":"祜","kind