{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003548","identity_policy":"contextual_provisional","person_ids":["cbr-p003548"],"persons":[{"id":"cbr-p003548","label":"韓安國（梁孝王世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"韓安國","mention_ids":["c-shiji-058-liang:m005-0034","c-shiji-058-liang:m009-0121","c-shiji-058-liang:m009-0156"]}],"evidence":[{"mention_id":"c-shiji-058-liang:m005-0034","chapter_id":"c-shiji-058-liang","paragraph_id":"c-shiji-058-liang:p005","quote":"韓安國"},{"mention_id":"c-shiji-058-liang:m009-0121","chapter_id":"c-shiji-058-liang","paragraph_id":"c-shiji-058-liang:p009","quote":"韓安國"},{"mention_id":"c-shiji-058-liang:m009-0156","chapter_id":"c-shiji-058-liang","paragraph_id":"c-shiji-058-liang:p009","quote":"韓安國"}]}],"mentions":[{"id":"c-shiji-058-liang:m005-0034","start":34,"end":37,"surface":"韓安國","kind":"person","person_id":"cbr-p003548","status":"contextual_provisional","paragraph_id":"c-shiji-058-liang:p005","chapter_id":"c-shiji-058-liang"},{"id":"c-shiji-058-liang:m009-0121","start":121,"end":124,"surface":"韓安國","kind":"person","person_id":"cbr-p003548","status":"contextual_provisional","paragraph_id":"c-shiji-058-liang:p009","chapter_id":"c-shiji-058-liang"},{"id":"c-shiji-058-liang:m009-0156","start":156,"end":159,"surface":"韓安國","kind":"person","person_id":"cbr-p003548","status":"contextual_provisional","paragraph_id":"c-shiji-058-liang:p009","chapter_id":"c-shiji-058-liang"}],"relations":[],"title_holdings":[{"id":"th-shiji058-014","person_id":"cbr-p003548","title":"大將軍","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-058-liang","source_id":"s-shiji-058-liang","paragraph_id":"c-shiji-058-liang:p005","quote":"其春，吳楚齊趙七國反。吳楚先擊梁棘壁，殺數萬人。梁孝王城守睢陽，而使韓安國、張羽等為大將軍，以距吳楚。吳楚以梁為限，不敢過而西，與太尉亞夫等相距三月。吳楚破，而梁所破殺虜略與漢中分。明年，漢立太子。其後梁最親，有功，又為大國，居天下膏腴地。地北界泰山，西至高陽，四十餘城，皆多大縣。"}],"attestations":[{"id":"th-shiji058-014:a001","paragraph_id":"c-shiji-058-liang:p005","start":42,"end":45,"surface":"大將軍","person_mention_id":"c-shiji-058-liang:m005-0034","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-058-liang","source_id":"s-shiji-058-liang","paragraph_id":"c-shiji-058-liang:p005","quote":"其春，吳楚齊趙七國反。吳楚先擊梁棘壁，殺數萬人。梁孝王城守睢陽，而使韓安國、張羽等為大將軍，以距吳楚。吳楚以梁為限，不敢過而西，與太尉亞夫等相距三月。吳楚破，而梁所破殺虜略與漢中分。明年，漢立太子。其後梁最親，有功，又為大國，居天下膏腴地。地北界泰山，西至高陽，四十餘城，皆多大縣。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授封、改封、敘事用稱與諡稱分存；相對年數及來源年號保留，不換算公曆，不從首次用稱或死亡補任期。未名群體不造個別官爵。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji058-023","person_id":"cbr-p003548","title":"內史","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-058-liang","source_id":"s-shiji-058-liang","paragraph_id":"c-shiji-058-liang:p009","quote":"其夏四月，上立膠東王為太子。梁王怨袁盎及議臣，乃與羊勝、公孫詭之屬陰使人刺殺袁盎及他議臣十餘人。逐其賊，未得也。於是天子意梁王，逐賊，果梁使之。乃遣使冠蓋相望於道，覆按梁，捕公孫詭、羊勝。公孫詭、羊勝匿王後宮。使者責二千石急，梁相軒丘豹及內史韓安國進諫王，王乃令勝、詭皆自殺，出之。上由此怨望於梁王。梁王恐，乃使韓安國因長公主謝罪太后，然后得釋。"}],"attestations":[{"id":"th-shiji058-023:a001","paragraph_id":"c-shiji-058-liang:p009","start":119,"end":121,"surface":"內史","person_mention_id":"c-shiji-058-liang:m009-0121","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授封、改封、敘事用稱與諡稱分存；相對年數及來源年號保留，不換算公曆，不從首次用稱或死亡補任期。未名群體不造個別官爵。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji058-009","person_id":"cbr-p003548","surfaces":["韓安國"],"scope":"same_chapter","chapter_ids":["c-shiji-058-liang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-058-liang:p005","quote":"其春，吳楚齊趙七國反。吳楚先擊梁棘壁，殺數萬人。梁孝王城守睢陽，而使韓安國、張羽等為大將軍，以距吳楚。吳楚以梁為限，不敢過而西，與太尉亞夫等相距三月。吳楚破，而梁所破殺虜略與漢中分。明年，漢立太子。其後梁最親，有功，又為大國，居天下膏腴地。地北界泰山，西至高陽，四十餘城，皆多大縣。"},{"paragraph_id":"c-shiji-058-liang:p009","quote":"其夏四月，上立膠東王為太子。梁王怨袁盎及議臣，乃與羊勝、公孫詭之屬陰使人刺殺袁盎及他議臣十餘人。逐其賊，未得也。於是天子意梁王，逐賊，果梁使之。乃遣使冠蓋相望於道，覆按梁，捕公孫詭、羊勝。公孫詭、羊勝匿王後宮。使者責二千石急，梁相軒丘豹及內史韓安國進諫王，王乃令勝、詭皆自殺，出之。上由此怨望於梁王。梁王恐，乃使韓安國因長公主謝罪太后，然后得釋。"}],"rationale":"按明示姓名、世系與局部王號暫接。梁武、勝、參、登、義、買、襄等不按同王號合併；梁王勝與羊勝分辨。李太后陳太后分存；主張、指控、泛稱與授職分辨，正文與附述各保留。官爵全史與跨篇身份仍待覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-058-liang:p005","text":"其春，吳楚齊趙七國反。吳楚先擊梁棘壁，殺數萬人。梁孝王城守睢陽，而使韓安國、張羽等為大將軍，以距吳楚。吳楚以梁為限，不敢過而西，與太尉亞夫等相距三月。吳楚破，而梁所破殺虜略與漢中分。明年，漢立太子。其後梁最親，有功，又為大國，居天下膏腴地。地北界泰山，西至高陽，四十餘城，皆多大縣。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-058-liang:m005-0007","start":7,"end":9,"surface":"七國","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、所舉古事或未定指代；不補來源未見姓名、成員及關係。"},{"id":"c-shiji-058-liang:m005-0024","start":24,"end":27,"surface":"梁孝王","kind":"person","person_id":"cbr-p003540","status":"contextual_provisional"},{"id":"c-shiji-058-liang:m005-0034","start":34,"end":37,"surface":"韓安國","kind":"person","person_id":"cbr-p003548","status":"contextual_provisional"},{"id":"c-shiji-058-liang:m005-0038","start":38,"end":40,"surface":"張羽","kind":"person","person_id":"cbr-p003549","status":"contextual_provisional"},{"id":"c-shiji-058-liang:m005-0040","start":40,"end":41,"surface":"等","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、所舉古事或未定指代；不補來源未見姓名、成員及關係。"},{"id":"c-shiji-058-liang:m005-0065","start":65,"end":69,"surface":"太尉亞夫","kind":"person","person_id":"cbr-p003550","status":"contextual_provisional"},{"id":"c-shiji-058-liang:m005-0069","start":69,"end":70,"surface":"等","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、所舉古事或未定指代；不補來源未見姓名、成員及關係。"},{"id":"c-shiji-058-liang:m005-0096","start":96,"end":98,"surface":"太子","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、所舉古事或未定指代；不補來源未見姓名、成