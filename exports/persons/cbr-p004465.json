{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004465","canonical_person_id":"gzw_egi_c4r","id_aliases":["cbr-p004465"],"identity_policy":"contextual_provisional","person_ids":["gzw_egi_c4r"],"persons":[{"id":"gzw_egi_c4r","label":"齊王求女弟未名（春申君列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"齊王","mention_ids":["c-shiji-078-chunshen:m017-0089"]}],"evidence":[{"mention_id":"c-shiji-078-chunshen:m017-0089","chapter_id":"c-shiji-078-chunshen","paragraph_id":"c-shiji-078-chunshen:p017","quote":"齊王"}],"id_aliases":["cbr-p004465"]}],"source_mention_summary":[{"source_id":"s-shiji-078-chunshen","work_id":"w-shiji","book_id":"b-shiji-078","chapter_id":"c-shiji-078-chunshen","mention_count":1,"mention_ids":["c-shiji-078-chunshen:m017-0089"],"paragraph_ids":["c-shiji-078-chunshen:p017"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-078-chunshen"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-078-chunshen:m017-0089","start":89,"end":91,"surface":"齊王","kind":"person","person_id":"gzw_egi_c4r","status":"contextual_provisional","paragraph_id":"c-shiji-078-chunshen:p017","chapter_id":"c-shiji-078-chunshen"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji078-027","person_id":"gzw_egi_c4r","surfaces":["齊王"],"scope":"same_chapter","chapter_ids":["c-shiji-078-chunshen"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-078-chunshen:p017","quote":"楚考烈王無子，春申君患之，求婦人宜子者進之，甚眾，卒無子。趙人李園持其女弟，欲進之楚王，聞其不宜子，恐久毋寵。李園求事春申君為舍人，已而謁歸，故失期。還謁，春申君問之狀，對曰：「齊王使使求臣之女弟，與其使者飲，故失期。」春申君曰：「娉入乎？」對曰：「未也。」春申君曰：「可得見乎？」曰：「可。」於是李園乃進其女弟，即幸於春申君。知其有身，李園乃與其女弟謀。園女弟承閒以說春申君曰：「楚王之貴幸君，雖兄弟不如也。今君相楚二十餘年，而王無子，即百歲後將更立兄弟，則楚更立君後，亦各貴其故所親，君又安得長有寵乎？非徒然也，君貴用事久，多失禮於王兄弟，兄弟誠立，禍且及身，何以保相印江東之封乎？今妾自知有身矣，而人莫知。妾幸君未久，誠以君之重而進妾於楚王，王必幸妾；妾賴天有子男，則是君之子為王也，楚國盡可得，孰與身臨不測之罪乎？」春申君大然之，乃出李園女弟，謹舍而言之楚王。楚王召入幸之，遂生子男，立為太子，以李園女弟為王后。楚王貴李園，園用事。"}],"rationale":"按全22段明示姓名與局部敘事暫接。太子完考烈王、李園女弟與所生太子楚幽王按明示敘事分存，血緣不當已核定史實。更立君後的君未解，實楚王評論指春申權勢，王長反政與君子為王只作假設；未把方案當實授。秦楚齊王稱分範圍，先君善秦未強接頃襄；朱英郎中未行，伊尹周公引古不補未見身份。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-078-chunshen:p017","text":"楚考烈王無子，春申君患之，求婦人宜子者進之，甚眾，卒無子。趙人李園持其女弟，欲進之楚王，聞其不宜子，恐久毋寵。李園求事春申君為舍人，已而謁歸，故失期。還謁，春申君問之狀，對曰：「齊王使使求臣之女弟，與其使者飲，故失期。」春申君曰：「娉入乎？」對曰：「未也。」春申君曰：「可得見乎？」曰：「可。」於是李園乃進其女弟，即幸於春申君。知其有身，李園乃與其女弟謀。園女弟承閒以說春申君曰：「楚王之貴幸君，雖兄弟不如也。今君相楚二十餘年，而王無子，即百歲後將更立兄弟，則楚更立君後，亦各貴其故所親，君又安得長有寵乎？非徒然也，君貴用事久，多失禮於王兄弟，兄弟誠立，禍且及身，何以保相印江東之封乎？今妾自知有身矣，而人莫知。妾幸君未久，誠以君之重而進妾於楚王，王必幸妾；妾賴天有子男，則是君之子為王也，楚國盡可得，孰與身臨不測之罪乎？」春申君大然之，乃出李園女弟，謹舍而言之楚王。楚王召入幸之，遂生子男，立為太子，以李園女弟為王后。楚王貴李園，園用事。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-078-chunshen:m017-0000","start":0,"end":4,"surface":"楚考烈王","kind":"person","person_id":"7lc_ham_b1m","status":"contextual_provisional"},{"id":"c-shiji-078-chunshen:m017-0004","start":4,"end":6,"surface":"無子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名角色或假設用稱保留，不補姓名、親屬或方案實施；母子血緣敘事仍待另存來源主張與學術覆核。"},{"id":"c-shiji-078-chunshen:m017-0007","start":7,"end":10,"surface":"春申君","kind":"person","person_id":"zun_s94_rgs","status":"contextual_provisional"},{"id":"c-shiji-078-chunshen:m017-0014","start":14,"end":16,"surface":"婦人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名角色或假設用稱保留，不補姓名、親屬或方案實施；母子血緣敘事仍待另存來源主張與學術覆核。"},{"id":"c-shiji-078-chunshen:m017-0026","start":26,"end":28,"surface":"無子","kind":"unresolv