olicy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-056-zhuhuan:line065:m0114","start":114,"end":116,"surface":"李膺","kind":"person","person_id":"ybk_wt8_y8r","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-056-zhuhuan:line065","chapter_id":"c-sanguozhi-056-zhuhuan"}],"relations":[],"title_holdings":[{"id":"t-wu056-t-wu056-zhuhuan16","person_id":"ybk_wt8_y8r","kind":"office","title":"廬江太守","mode":"attestation","status":"source_attested","effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本句所載職官，任免時間未詳。","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-056","chapter_id":"c-sanguozhi-056-zhuhuan","source_id":"s-sanguozhi-056-zhuhuan","paragraph_id":"c-sanguozhi-056-zhuhuan:line065","quote":"　　黃龍元年，拜桓前將軍，領青州牧，假節。嘉禾六年，魏廬江主簿呂習請大兵自迎，欲開門為應。桓與衛將軍全琮俱以師迎。既至，事露，軍當引還。城外有溪水，去城一里所，廣三十餘丈，深者八九尺，淺者半之，諸軍勒兵渡去，桓自斷後。時廬江太守李膺整嚴兵騎，欲須諸軍半渡，因迫擊之。及見桓節蓋在後，卒不敢出，其見憚如此。是時全琮為督，權又令偏將軍胡綜宣傳詔命，參與軍事。琮以軍出無獲，議欲部分諸將，有所掩襲。桓素氣高，恥見部伍，乃往見琮，問行意，感激發怒，與琮校計。琮欲自解，因曰：「上自令胡綜為督，綜意以為宜爾。」桓愈恚恨，還乃使人呼綜。綜至軍門，桓出迎之，顧謂左右曰：「我縱手，汝等各自去。」有一人旁出，語綜使還。","person_mention_id":"c-sanguozhi-056-zhuhuan:line065:m0114"}],"attestations":[{"id":"t-wu056-t-wu056-zhuhuan16:a","paragraph_id":"c-sanguozhi-056-zhuhuan:line065","person_mention_id":"c-sanguozhi-056-zhuhuan:line065:m0114","start":110,"end":114,"surface":"廬江太守","usage":"narrative","date_expression":null}],"human_reviewed":false,"reviewer":"Codex（AI 代理）","model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-056-zhuhuan:line065","text":"　　黃龍元年，拜桓前將軍，領青州牧，假節。嘉禾六年，魏廬江主簿呂習請大兵自迎，欲開門為應。桓與衛將軍全琮俱以師迎。既至，事露，軍當引還。城外有溪水，去城一里所，廣三十餘丈，深者八九尺，淺者半之，諸軍勒兵渡去，桓自斷後。時廬江太守李膺整嚴兵騎，欲須諸軍半渡，因迫擊之。及見桓節蓋在後，卒不敢出，其見憚如此。是時全琮為督，權又令偏將軍胡綜宣傳詔命，參與軍事。琮以軍出無獲，議欲部分諸將，有所掩襲。桓素氣高，恥見部伍，乃往見琮，問行意，感激發怒，與琮校計。琮欲自解，因曰：「上自令胡綜為督，綜意以為宜爾。」桓愈恚恨，還乃使人呼綜。綜至軍門，桓出迎之，顧謂左右曰：「我縱手，汝等各自去。」有一人旁出，語綜使還。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-056-zhuhuan:line065:m0008","start":8,"end":9,"surface":"桓","kind":"person","person_id":"cgf_n3i_i5g","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-056-zhuhuan:line065:m0031","start":31,"end":33,"surface":"呂習","kind":"person","person_id":"rw3_16u_1g3","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-056-zhuhuan:line065:m0045","start":45,"end":46,"surface":"桓","kind":"person","person_id":"cgf_n3i_i5g","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-056-zhuhuan:line065:m0050","start":50,"end":52,"surface":"全琮","kind":"person","person_id":"984_9e1_5e9","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-056-zhuhuan:line065:m0104","start":104,"end":105,"surface":"桓","kind":"person","person_id":"cgf_n3i_i5g","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-056-zhuhuan:line065:m0114","start":114,"end":116,"surface":"李膺","kind":"person","person_id":"ybk_wt8_y8r","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-056-zhuhuan:line065:m0135","start":135,"end":136,"surface":"桓","kind":"person","person_id":"cgf_n3i_i5g","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-056-zhuhuan:line065:m0154","start":154,"end":156,"surface":"全琮","kind":"person","person_id":"984_9e1_5e9","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-056-zhuhuan:line065:m0159","start":159,"end":160,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextua