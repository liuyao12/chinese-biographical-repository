ovisional","paragraph_id":"c-shiji-118-huainan:p017","chapter_id":"c-shiji-118-huainan"},{"id":"c-shiji-118-huainan:m017-0416","start":416,"end":419,"surface":"中尉宏","kind":"person","person_id":"cps_fbf_cig","status":"contextual_provisional","paragraph_id":"c-shiji-118-huainan:p017","chapter_id":"c-shiji-118-huainan"},{"id":"c-shiji-118-huainan:m017-0430","start":430,"end":432,"surface":"中尉","kind":"person","person_id":"cps_fbf_cig","status":"contextual_provisional","paragraph_id":"c-shiji-118-huainan:p017","chapter_id":"c-shiji-118-huainan"},{"id":"c-shiji-118-huainan:m017-0459","start":459,"end":461,"surface":"漢使","kind":"person","person_id":"cps_fbf_cig","status":"contextual_provisional","paragraph_id":"c-shiji-118-huainan:p017","chapter_id":"c-shiji-118-huainan"},{"id":"c-shiji-118-huainan:m017-0480","start":480,"end":482,"surface":"中尉","kind":"person","person_id":"cps_fbf_cig","status":"contextual_provisional","paragraph_id":"c-shiji-118-huainan:p017","chapter_id":"c-shiji-118-huainan"},{"id":"c-shiji-118-huainan:m023-0128","start":128,"end":130,"surface":"中尉","kind":"person","person_id":"cps_fbf_cig","status":"contextual_provisional","paragraph_id":"c-shiji-118-huainan:p023","chapter_id":"c-shiji-118-huainan"}],"relations":[],"title_holdings":[{"id":"th-shiji118-032","person_id":"cps_fbf_cig","title":"中尉","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-118-huainan","source_id":"s-shiji118-huainan","paragraph_id":"c-shiji-118-huainan:p017","quote":"元朔五年，太子學用劍，自以為人莫及，聞郎中雷被巧，乃召與戲。被一再辭讓，誤中太子。太子怒，被恐。此時有欲從軍者輒詣京師，被即願奮擊匈奴。太子遷數惡被於王，王使郎中令斥免，欲以禁后，被遂亡至長安，上書自明。詔下其事廷尉、河南。河南治，逮淮南太子，王、王后計欲無遣太子，遂發兵反，計猶豫，十餘日未定。會有詔，即訊太子。當是時，淮南相怒壽春丞留太子逮不遣，劾不敬。王以請相，相弗聽。王使人上書告相，事下廷尉治。蹤跡連王，王使人候伺漢公卿，公卿請逮捕治王。王恐事發，太子遷謀曰：「漢使即逮王，王令人衣衛士衣，持戟居庭中，王旁有非是，則刺殺之，臣亦使人刺殺淮南中尉，乃舉兵，未晚。」是時上不許公卿請，而遣漢中尉宏即訊驗王。王聞漢使來，即如太子謀計。漢中尉至，王視其顏色和，訊王以斥雷被事耳，王自度無何，不發。中尉還，以聞。公卿治者曰：「淮南王安擁閼奮擊匈奴者雷被等，廢格明詔，當棄市。」詔弗許。公卿請廢勿王，詔弗許。公卿請削五縣，詔削二縣。使中尉宏赦淮南王罪，罰以削地。中尉入淮南界，宣言赦王。王初聞漢公卿請誅之，未知得削地，聞漢使來，恐其捕之，乃與太子謀刺之如前計。及中尉至，即賀王，王以故不發。其後自傷曰：「吾行仁義見削，甚恥之。」然淮南王削地之后，其為反謀益甚。諸使道從長安來，為妄妖言，言上無男，漢不治，即喜；即言漢廷治，有男，王怒，以為妄言，非也。"}],"attestations":[{"id":"th-shiji118-032:a001","paragraph_id":"c-shiji-118-huainan:p017","start":275,"end":277,"surface":"中尉","person_mention_id":"c-shiji-118-huainan:m017-0297","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"明示授封與文獻用稱分存，紀年承接及換算待補；廢勿王明示終點，不以死亡自動終止全部稱號。厲王追謚用稱不等同生前即位。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji118-followup-m017-0308","person_id":"cps_fbf_cig","surfaces":["漢使"],"scope":"same_chapter","chapter_ids":["c-shiji-118-huainan"],"status":"contextual_provisional","confidence_level":"high","identification_basis":{"kind":"source_context","target_mention_ids":["c-shiji-118-huainan:m017-0308"],"antecedent_mention_ids":["c-shiji-118-huainan:m017-0297","c-shiji-118-huainan:m017-0416"]},"evidence":[{"chapter_id":"c-shiji-118-huainan","source_id":"s-shiji118-huainan","paragraph_id":"c-shiji-118-huainan:p017","quote":"元朔五年，太子學用劍，自以為人莫及，聞郎中雷被巧，乃召與戲。被一再辭讓，誤中太子。太子怒，被恐。此時有欲從軍者輒詣京師，被即願奮擊匈奴。太子遷數惡被於王，王使郎中令斥免，欲以禁后，被遂亡至長安，上書自明。詔下其事廷尉、河南。河南治，逮淮南太子，王、王后計欲無遣太子，遂發兵反，計猶豫，十餘日未定。會有詔，即訊太子。當是時，淮南相怒壽春丞留太子逮不遣，劾不敬。王以請相，相弗聽。王使人上書告相，事下廷尉治。蹤跡連王，王使人候伺漢公卿，公卿請逮捕治王。王恐事發，太子遷謀曰：「漢使即逮王，王令人衣衛士衣，持戟居庭中，王旁有非是，則刺殺之，臣亦使人刺殺淮南中尉，乃舉兵，未晚。」是時上不許公卿請，而遣漢中尉宏即訊驗王。王聞漢使來，即如太子謀計。漢中尉至，王視其顏色和，訊王以斥雷被事耳，王自度無何，不發。中尉還，以聞。公卿治者曰：「淮南王安擁閼奮擊匈奴者雷被等，廢格明詔，當棄市。」詔弗許。公卿請廢勿王，詔弗許。公卿請削五縣，詔削二縣。使中尉宏赦淮南王罪，罰以削地。中尉入淮南界，宣言赦王。王初聞漢公卿請誅之，未知得削地，聞漢使來，恐其捕之，乃與太子謀刺之如前計。及中尉至，即賀王，王以故不發。其後自傷曰：「吾行仁義見削，甚恥之。」然淮南王削地之后，其為反謀益甚。諸使道從長安來，為妄妖言，言上無男，漢不治，即喜；即言漢廷治，有男，王怒，以為妄言，非也。","mention_ids":["c-shiji-118-huainan:m017-0308","c-shiji-118-huainan:m017-0297","c-shiji-118-huainan:m017-0416"]}],"rationale":"同段朝廷遣漢中尉宏訊王與赦罪，前後漢使承接具名使者；不把較前假設的任何漢使全部指定宏。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"d-shiji118-followup-m017-0459","person_id":"cps_fbf_cig","surfaces":["漢使"],"scope":"same_chapter","chapter_ids":["c-shiji-118-huainan"],"status":"contextual_provisional","confidence_level":"high","identification_basis":{"kind":"source_context","target_mention_ids":["c-shiji-118-huainan:m017-0459"],"antecedent_mention_ids":["c-shiji-118-huainan:m017-0297","c-shiji-118-huainan:m017-0416"]},"evidence":[{"chapter_id":"c-shiji-118-huainan","source_id":"s-shiji118-huainan","paragraph_id":"c-shiji-118-huainan:p017","quote":"元朔五年，太子學用劍，自以為人莫及，聞郎中雷被巧，乃召與戲。被一再辭讓，誤中太子。太子怒，被恐。此時有欲從軍者輒詣京師，被即願奮擊匈奴。太子遷數惡被於王，王使郎中令斥免，欲以禁后，被遂亡至長安，上書自明。詔下其事廷尉、河南。河南治，逮淮南太子，王、王后計欲無遣太子，遂發兵反，計猶豫，十餘日未定。會有詔，即訊太子。當是時，淮南相怒壽春丞留太子逮不遣，劾不敬。王以請相，相弗聽。王使人上書告相，事下廷尉治。蹤跡連王，王使人候伺漢公卿，公卿請逮捕治王。王恐事發，太子遷謀曰：「漢使即逮王，王令人衣衛士衣，持戟居庭中，王旁有非是，則刺殺之，臣亦使人刺殺淮南中尉，乃舉兵，未晚。」是時上不許公卿請，而遣漢中尉宏即訊驗王。王聞漢使來，即如太子謀計。漢中尉至，王視其顏色和，訊王以斥雷被事耳，王自度無何，不發。中尉還，以聞。公卿治者曰：「淮南王安擁閼奮擊匈奴者雷被等，廢格明詔，當棄市。」詔弗許。公卿請廢勿王，詔弗許。公卿請削五縣，詔削二縣。使中尉宏赦淮南王罪，罰以削地。中尉入淮南界，宣言赦王。王初聞漢公卿請誅之，未知得削地，聞漢使來，恐其捕之，乃與太子謀刺之如前計。及中尉至，即賀王，王以故不發。其後自傷曰：「吾行仁義見削，甚恥之。」然淮南王削地之后，其為反謀益甚。諸使道從長安來，為妄妖言，言上無男，漢不治，即喜；即言漢廷治，有男，王怒，以為妄言，非也。","mention_ids":["c-shiji-118-huainan:m017-0459","c-shiji-118-huainan:m017-0297","c-shiji-118-huainan:m017-0416"]}],"rationale":"同段朝廷遣漢中尉宏訊王與赦罪，前後漢使承接具名使者；不把較前假設的任何漢使全部指定宏。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"d-shiji118-followup-m023-0128","person_id":"cps_fbf_cig","surfaces":["中尉"],"scope":"same_chapter","chapter_ids":["c-shiji-118-huainan"],"status":"contextual_provisional","confidence_level":"moderate","identification_basis":{"kind":"source_context","target_mention_ids":["c-shiji-118-huainan:m023-0128"],"antecedent_mention_ids":["c-shiji-118-huainan:m017-0297","c-shiji-118-huainan:m017-0416"]},"evidence":[{"chapter_id":"c-shiji-118-huainan","source_id":"s-shiji118-huainan","paragraph_id":"c-shiji-118-huainan:p023","quote":"於是廷尉以王孫建辭連淮南王太子遷聞。上遣廷尉監因拜淮南中尉，逮捕太子。至淮南，淮南王聞，與太子謀召相、二千石，欲殺而發兵。召相，相至；內史以出為解。中尉曰：「臣受詔使，不得見王。」王念獨殺相而內史中尉不來，無益也，即罷相。王猶豫，計未決。太子念所坐者謀刺漢中尉，所與謀者已死，以為口絕，乃謂王曰：「群臣可用者皆前繋，今無足與舉事者。王以非時發，恐無功，臣願會逮。」王亦偷欲休，即許太子。太子即自剄，不殊。伍被自詣吏，因告與淮南王謀反，反蹤跡具如此。","mention_ids":["c-shiji-118-huainan:m023-0128"]},{"chapter_id":"c-shiji-118-huainan","source_id":"s-shiji118-huainan","paragraph_id":"c-shiji-118-huainan:p017","quote":"元朔五年，太子學用劍，自以為人莫及，聞郎中雷被巧，乃召與戲。被一再辭讓，誤中太子。太子怒，被恐。此時有欲從軍者輒詣京師，被即願奮擊匈奴。太子遷數惡被於王，王使郎中令斥免，欲以禁后，被遂亡至長安，上書自明。詔下其事廷尉、河南。河南治，逮淮南太子，王、王后計欲無遣太子，遂發兵反，計猶豫，十餘日未定。會有詔，即訊太子。當是時，淮南相怒壽春丞留太子逮不遣，劾不敬。王以請相，相弗聽。王使人上書告相，事下廷尉治。蹤跡連王，王使人候伺漢公卿，公卿請逮捕治王。王恐事發，太子遷謀曰：「漢使即逮王，王令人衣衛士衣，持戟居庭中，王旁有非是，則刺殺之，臣亦使人刺殺淮南中尉，乃舉兵，未晚。」是時上不許公卿請，而遣漢中尉宏即訊驗王。王聞漢使來，即如太子謀計。漢中尉至，王視其顏色和，訊王以斥雷被事耳，王自度無何，不發。中尉還，以聞。公卿治者曰：「淮南王安擁閼奮擊匈奴者雷被等，廢格明詔，當棄市。」詔弗許。公卿請廢勿王，詔弗許。公卿請削五縣，詔削二縣。使中尉宏赦淮南王罪，罰以削地。中尉入淮南界，宣言赦王。王初聞漢公卿請誅之，未知得削地，聞漢使來，恐其捕之，乃與太子謀刺之如前計。及中尉至，即賀王，王以故不發。其後自傷曰：「吾行仁義見削，甚恥之。」然淮南王削地之后，其為反謀益甚。諸使道從長安來，為妄妖言，言上無男，漢不治，即喜；即言漢廷治，有男，王怒，以為妄言，非也。","mention_ids":["c-shiji-118-huainan:m017-0297","c-shiji-118-huainan:m017-0416"]}],"rationale":"太子回述此前謀刺漢中尉之罪，對應第17段宏使淮南及兩次擬刺；本段新任廷尉監另作未名者，不與宏合併。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"d-shiji118-hong-span-boundaries","person_id":"cps_fbf_cig","surfaces":["中尉"],"scope":"same_chapter","chapter_ids":["c-shiji-118-huainan"],"status":"contextual_provisional","confidence_level":"high","identification_basis":{"kind":"source_context","target_mention_ids":["c-shiji-118-huainan:m017-0349","c-shiji-118-huainan:m017-0430","c-shiji-118-huainan:m017-0480"],"span_changes":[{"mention_id":"c-shiji-118-huainan:m017-0349","previous":{"start":349,"end":352,"surface":"中尉還"},"accepted":{"start":349,"end":351,"surface":"中尉"}},{"mention_id":"c-shiji-118-huainan:m017-0430","previous":{"start":430,"end":433,"surface":"中尉入"},"accepted":{"start":430,"end":432,"surface":"中尉"}},{"mention_id":"c-shiji-118-huainan:m017-0480","previous":{"start":480,"end":483,"surface":"中尉至"},"accepted":{"start":480,"end":482,"surface":"中尉"}}]},"evidence":[{"chapte