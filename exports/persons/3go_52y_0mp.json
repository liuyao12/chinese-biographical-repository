art":62,"end":64,"surface":"伯樂","kind":"person","person_id":"3go_52y_0mp","status":"contextual_provisional","paragraph_id":"c-shiji-084-qujia:p016","chapter_id":"c-shiji-084-qujia"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji084-021","person_id":"3go_52y_0mp","scope":"same_chapter","chapter_ids":["c-shiji-084-qujia"],"status":"contextual_provisional","rationale":"依引古原稱與賈生名誼、吳廷尉吳公的同段承接暫定；絳灌短稱未補姓名，泛稱與賦中代詞尚待核定。","reviewer":"Codex（AI 代理）","surfaces":["伯樂"],"evidence":[{"paragraph_id":"c-shiji-084-qujia:p016","quote":"亂曰：浩浩沅、湘兮，分流汨兮。修路幽拂兮，道遠忽兮。曾唫恒悲兮，永嘆慨兮。世既莫吾知兮，人心不可謂兮。懷情抱質兮，獨無匹兮。伯樂既歿兮，驥將焉程兮？人生稟命兮，各有所錯兮。定心廣志，餘何畏懼兮？曾傷爰哀，永嘆喟兮。世溷不吾知，心不可謂兮。知死不可讓兮，願勿愛兮。明以告君子兮，吾將以為類兮。」"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-084-qujia:p016","text":"亂曰：浩浩沅、湘兮，分流汨兮。修路幽拂兮，道遠忽兮。曾唫恒悲兮，永嘆慨兮。世既莫吾知兮，人心不可謂兮。懷情抱質兮，獨無匹兮。伯樂既歿兮，驥將焉程兮？人生稟命兮，各有所錯兮。定心廣志，餘何畏懼兮？曾傷爰哀，永嘆喟兮。世溷不吾知，心不可謂兮。知死不可讓兮，願勿愛兮。明以告君子兮，吾將以為類兮。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m016-0062","start":62,"end":64,"surface":"伯樂","kind":"person","person_id":"3go_52y_0mp","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m016-0134","start":134,"end":136,"surface":"君子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代保持未解。"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"},{"id":"c-shiji-117-xiangru:p007","text":"「『於是乃使專諸之倫，手格此獸。楚王乃駕馴駁之駟，乘雕玉之輿，靡魚須之橈旃，曳明月之珠旗，建干將之雄戟，左烏嗥之雕弓，右夏服之勁箭；陽子驂乘，纖阿為禦；案節未舒，即陵狡獸，轔邛邛，蹵距虛，軼野馬而𨎥騊駼，乘遺風而射遊騏；儵眒淒浰，靁動熛至，星流霆擊，弓不虛發，中必決眥，洞胷達腋，絕乎心繫，獲若雨獸，揜草蔽地。於是楚王乃弭節裴回，翱翔容與，覽乎陰林，觀壯士之暴怒，與猛獸之恐懼，徼𧮬受詘，殫睹衆物之變態。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m007-0006","start":6,"end":8,"surface":"專諸","kind":"person","person_id":"78