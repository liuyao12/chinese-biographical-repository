urce_reference_ids":["jijie117"]}],"references":[{"url":"https://github.com/kanripo/KR2a0007/blob/683113d4baf6febecaf2ccb7913df87c4d68d454/KR2a0007_057.txt#L162-L163","source_commit":"683113d4baf6febecaf2ccb7913df87c4d68d454","source_blob":"44cd0a168123204ab8369c8382018dbaaa846a86","quote":"(曰服盛箭器也夏后氏之良弓名煩弱其矢亦良/即煩弱箭服也故曰夏服○宋祁曰南本勁作良)陽子¶\n驂乘孅阿為御(張揖曰陽子伯樂也秦繆公臣姓孫名/陽郭璞曰孅阿古之善御者孅音纎)¶","read_line_range":[162,163],"cached_response_sha256":"3c62abcaf4adc4a496265bcfe7ddde0d386536b36d8f20a83b60e3207db27573","image_verified":false,"id":"han57","scope":"ancient_commentary_interpretation"},{"url":"https://github.com/kanripo/KR2a0002/blob/73c4d2ba067d99a6de924ac952fd6921a958c7e7/KR2a0002_117.txt#L112-L113","source_commit":"73c4d2ba067d99a6de924ac952fd6921a958c7e7","source_blob":"ccded97eee2542083010172d857d6251a09a126c","quote":"(謂之/服也)陽子驂乘纎阿為御(漢書音義曰陽子僊人陽陵/子纎阿月御也韋昭曰陽子)¶\n(古賢/也)按節未舒即陵狡獸轔卭卭蹵距虚(郭璞曰卭卭/似馬而青距)¶","read_line_range":[112,113],"cached_response_sha256":"15ee75f05d9c9ded49f9b56df8caebfaeb0facd47e5be3b4a762acce856dfda5","image_verified":false,"id":"jijie117","scope":"ancient_commentary_interpretation"}],"note":"候選不窮盡，不將陽陵子與陵陽子明按倒字自動接合；不建立實際同車事件。","reviewer":"Codex（AI 代理）","human_reviewed":false,"source_terms":["陽子"],"work_id":"w-shiji","book_id":"b-shiji-117","chapter_id":"c-shiji-117-xiangru","source_id":"s-shiji117-xiangru"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-016-duji-dushu:unit029:m0724","start":724,"end":725,"surface":"樂","kind":"person","person_id":"3go_52y_0mp","status":"contextual_provisional","interpretation_note":"良樂之選驥足的樂首選伯樂，與已存相馬伯樂典故同指；不把樂字映到樂詳。","paragraph_id":"c-sanguozhi-016-duji-dushu:unit029","chapter_id":"c-sanguozhi-016-duji-dushu"},{"id":"c-shiji-084-qujia:m016-0062","start":62,"end":64,"surface":"伯樂","kind":"person","person_id":"3go_52y_0mp","status":"contextual_provisional","paragraph_id":"c-shiji-084-qujia:p016","chapter_id":"c-shiji-084-qujia"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji084-021","person_id":"3go_52y_0mp","scope":"same_chapter","chapter_ids":["c-shiji-084-qujia"],"status":"contextual_provisional","rationale":"依引古原稱與賈生名誼、吳廷尉吳公的同段承接暫定；絳灌短稱未補姓名，泛稱與賦中代詞尚待核定。","reviewer":"Codex（AI 代理）","surfaces":["伯樂"],"evidence":[{"paragraph_id":"c-shiji-084-qujia:p016","quote":"亂曰：浩浩沅、湘兮，分流汨兮。修路幽拂兮，道遠忽兮。曾唫恒悲兮，永嘆慨兮。世既莫吾知兮，人心不可謂兮。懷情抱質兮，獨無匹兮。伯樂既歿兮，驥將焉程兮？人生稟命兮，各有所錯兮。定心廣志，餘何畏懼兮？曾傷爰哀，永嘆喟兮。世溷不吾知，心不可謂兮。知死不可讓兮，願勿愛兮。明以告君子兮，吾將以為類兮。」"}]}],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-016-duji-dushu:unit029","text_layer":"received_chapter","text":"乃上疏曰帝王之道莫尚乎安民安民之術在於豐財豐財者務本而節用也方今二賊未滅戎車亟駕此自熊虎之士展力之秋也然縉紳之儒橫加榮慕搤腕抗論以孫呉為首州郡牧守咸共忽恤民之術脩將率之事農桑之民競干戈之業不可謂務本帑藏嵗虚而制度嵗廣民力嵗衰而賦役嵗興不可謂節用今大魏奄有十州之地而承喪亂之弊計其户口不如往昔一州之民然而二方僭逆北虜未賓三邊遘難繞天略帀所以統一州之民經營九州之地其為艱難譬䇿羸馬以取道里豈可不加意愛惜其力哉以武皇帝之節儉府藏充實猶不能十州擁兵郡且二十也今荆揚青徐幽并雍涼緣邊諸州皆有兵矣其所恃内充府庫外制四夷者惟兖豫司冀而已臣前以州郡典兵則專心軍功不勤民事宜别置將守以盡治理之務而陛下復以冀州寵秩吕昭冀州户口最多田多墾闢又有桑棗之饒國家徵求之府誠不當復任以兵事也若以北方當須鎭守自可專置大將以鎭安之計所置吏士之費與兼官無覺然昭於人才尚復易中朝茍乏人兼才者勢不獨多以此推之知國家以人擇官不為官擇人也官得其人則政平訟理政平故民富實訟理故囹圄虚空陛下踐祚天下斷獄百數十人嵗嵗增多至五百餘人矣民不益多法不益峻以此推之非政敎陵遲牧守不稱之明效歟往年牛死通率天下十能損二麥不半收秋種未下若二賊游魂於疆場飛芻輓粟千里不及究此之術豈在彊兵乎武士勁卒愈多愈多愈病耳夫天下猶人之體腹心充實四支雖病終無大患今兖豫司冀亦天下之腹心也是以愚臣慺慺實願四州之牧守獨脩務本之業以堪四支之重然孤論難持犯欲難成衆怨難積疑似難分故累載不為明主所察凡言此者類皆疏賤疏賤之言實未易聽若使善䇿必出於親貴固不犯四難以求忠愛此古今之所常患也時又大議考課之制以考内外衆官恕以為用不盡其人雖才且無益所存非所務所務非世要上疏曰書稱明試以功三考黜陟誠帝王之盛制使有能者當其官有功者受其禄譬猶烏獲之舉千鈞良樂之選驥足也雖歴六代而考績之法不著閲七聖而課試之文不垂臣誠以為其法可粗依其詳難備舉故也語曰世有亂人而無亂法若使法可專任則唐虞可不須稷契之佐殷周無貴伊吕之輔矣今奏考功者陳周漢之法為綴京房之本㫖可謂明考課之要矣於以崇揖讓之風興濟濟之治臣以為未盡善也其欲使州郡考士必由四科皆有事效然後察舉試辟公府為親民長吏轉以功次補郡守者或就增秩賜爵此最考課之急務也臣以為便當顯其身用其言使其為課州郡之法法具施行立必信之賞施必行之罰至於公卿及内職大臣亦當俱以其職考課之也古之三公坐而論道内職大臣納言補闕無善不紀無過不舉且天下至大萬幾至衆誠非一明所能徧照故君為元首臣為股肱明其一體相須而成也是以古人稱廊廟之材非一木之枝帝王之業非一士之略由是言之焉有大臣守職辨課可以致雍熙者哉且布衣之交猶有務信誓而蹈水火感知已而披肝膽狥聲名而立節義者况於束帶立朝致位卿相所務者非特匹夫之信所感者非徒知已之惠所狥者豈聲名而已乎諸䝉寵禄受重任者不徒欲舉明主於唐虞之上而已身亦欲厠稷契之列是以古人不患於念治之心不盡患於自任之意不足此誠人主使之然也唐虞之君委任稷契䕫龍而責成功及其罪也殛鯀而放四凶今大臣親奉明詔給事目下其有夙夜在公恪勤特立當官不撓貴勢執平不阿所私危言危行以處朝廷者自明主所察也若尸禄以為髙拱嘿以為智當官茍在於免負立朝不忘於容身潔行遜言以處朝廷者亦明主所察也誠使容身保位無放退之辜而盡節在公抱見疑之勢公義不脩而私議成俗雖仲尼為謀猶不能盡一才又况於世俗之人乎今之學者師商韓而上法術競以儒家為迂闊不周世用此最風俗之流弊創業者之所致愼也後考課竟不行","source_position":{"source_layer":"received_body","first_line":190,"last_line":263,"raw_projection_ref":"source-evidence/sgz016-duji-dushu/fixed-complete-unit.json"},"mentions":[{"id":"c-sanguozhi-016-duji-dushu:unit029:m0032","start":32,"end":34,"surface":"二賊","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"魏之兩敵國/軍政勢力，未明單一君主，不造兩個人。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0065","start":65,"end":66,"surface":"孫","kind":"person","person_id":"vax_w2r_0za","status":"contextual_provisional","interpretation_note":"疏以孫吳為兵學先導，孫首選孫武、吳吳起的兵家併稱；保孫臏可能與學派化用資格，不宣稱本句載全名。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0066","start":66,"end":67,"surface":"呉","kind":"person","person_id":"61h_0sk_4pb","status":"contextual_provisional","interpretation_note":"孫吳與軍事/將率之事併說，吳起為兵學代表的上下文首選，與孫吳列傳本傳人合；不作魏朝受職。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0203","start":203,"end":206,"surface":"武皇帝","kind":"person","person_id":"dad_b77_b38","status":"contextual_provisional","interpretation_note":"太祖河北平高幹、韓遂馬超之叛、魏國建與漢中征伐為曹操；與黃初文帝/太和明帝及司馬宣文王分開。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0261","start":261,"end":262,"surface":"臣","kind":"person","person_id":"56f_8f7_e9f_A","status":"contextual_provisional","interpretation_note":"本傳子恕嗣、務伯及幽州刺史，與034杜預父恕幽州刺史/幽死為具體父子官履橋。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0289","start":289,"end":291,"surface":"陛下","kind":"person","person_id":"932_46f_026","status":"contextual_provisional","interpretation_note":"太和散騎黃門侍郎杜恕疏及明帝崩為曹叡；長疏陛下受話人同此，後嘉平段先帝回指曹叡，不以最近宣王配。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0297","start":297,"end":299,"surface":"吕昭","kind":"person","person_id":"o2j_4j9_rda","status":"contextual_provisional","interpretation_note":"本章字子展/東平、鎮北將軍領冀州；009桓範段明鎮北吕昭及吕子展，是精確職/字共同橋。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0361","start":361,"end":362,"surface":"昭","kind":"person","person_id":"o2j_4j9_rda","status":"contextual_provisional","interpretation_note":"本章字子展/東平、鎮北將軍領冀州；009桓範段明鎮北吕昭及吕子展，是精確職/字共同橋。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0419","start":419,"end":421,"surface":"陛下","kind":"person","person_id":"932_46f_026","status":"contextual_provisional","interpretation_note":"太和散騎黃門侍郎杜恕疏及明帝崩為曹叡；長疏陛下受話人同此，後嘉平段先帝回指曹叡，不以最近宣王配。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0487","start":487,"end":489,"surface":"二賊","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"魏之兩敵國/軍政勢力，未明單一君主，不造兩個人。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0556","start":556,"end":557,"surface":"臣","kind":"person","person_id":"56f_8f7_e9f_A","status":"contextual_provisional","interpretation_note":"本傳子恕嗣、務伯及幽州刺史，與034杜預父恕幽州刺史/幽死為具體父子官履橋。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0660","start":660,"end":661,"surface":"恕","kind":"person","person_id":"56f_8f7_e9f_A","status":"contextual_provisional","interpretation_note":"本傳子恕嗣、務伯及幽州刺史，與034杜預父恕幽州刺史/幽死為具體父子官履橋。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:w0686","start":686,"end":687,"surface":"書","kind":"work","person_id":null,"work_id":"w-shu-sgz022-reference","status":"contextual_provisional","interpretation_note":"書稱明試以功為尚書經文引稱，書字是書名簡稱非動詞。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0717","start":717,"end":719,"surface":"烏獲","kind":"person","person_id":"rzv_0ll_3ty","status":"contextual_provisional","interpretation_note":"烏獲舉千鈞是力士典故，與已有烏獲古代力士身份相合，不取張儀篇同人候選另造。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0723","start":723,"end":724,"surface":"良","kind":"person","person_id":"4dv_h7n_m6i","status":"contextual_provisional","interpretation_note":"與樂併稱選驥足，為良/樂兩位識馬者，王良是編輯首選非明載全名；不補姓氏構件，後續可核經注。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0724","start":724,"end":725,"surface":"樂","kind":"person","person_id":"3go_52y_0mp","status":"contextual_provisional","interpretation_note":"良樂之選驥足的樂首選伯樂，與已存相馬伯樂典故同指；不把樂字映到樂詳。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0751","start":751,"end":752,"surface":"臣","kind":"person","person_id":"56f_8f7_e9f_A","status":"contextual_provisional","interpretation_note":"本傳子恕嗣、務伯及幽州刺史，與034杜預父恕幽州刺史/幽死為具體父子官履橋。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0784","start":784,"end":786,"surface":"唐虞","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"唐虞為古代聖王/王朝連稱，不能把雙人群體標成一個人。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0789","start":789,"end":790,"surface":"稷","kind":"person","person_id":"jqy_1fv_u7v","status":"contextual_provisional","interpretation_note":"詔稷勤百穀、注明周棄，疏稷契相輔同古人后稷；不讀作任職官稱或杜氏人物。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0790","start":790,"end":791,"surface":"契","kind":"person","person_id":"ea8_yum_lvj","status":"contextual_provisional","interpretation_note":"冥為契六世孫及疏稷契佐唐虞，為商先祖契；不按契約普通詞標。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0797","start":797,"end":798,"surface":"伊","kind":"person","person_id":"itn_zi2_il4","status":"contextual_provisional","interpretation_note":"僅疏中殷周無貴伊呂之輔的伊指商湯輔臣伊尹；後迎客之制兩伊尹另未決，不全局通配。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0798","start":798,"end":799,"surface":"吕","kind":"person","person_id":"1g3_02y_oor","status":"contextual_provisional","interpretation_note":"殷周伊呂之輔的呂是周輔臣呂尚，與齊太公望身份同指；不指本章吕昭或軍將。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0814","start":814,"end":816,"surface":"京房","kind":"person","person_id":"pwh_0lj_8em","status":"contextual_provisional","interpretation_note":"考課綴京房本旨與034杜預考課議京房遺意是精確制度引古橋，不增本源官爵。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0839","start":839,"end":840,"surface":"臣","kind":"person","person_id":"56f_8f7_e9f_A","status":"contextual_provisional","interpretation_note":"本傳子恕嗣、務伯及幽州刺史，與034杜預父恕幽州刺史/幽死為具體父子官履橋。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0896","start":896,"end":897,"surface":"臣","kind":"person","person_id":"56f_8f7_e9f_A","status":"contextual_provisional","interpretation_note":"本傳子恕嗣、務伯及幽州刺史，與034杜預父恕幽州刺史/幽死為具體父子官履橋。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m1130","start":1130,"end":1132,"surface":"唐虞","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"唐虞為古代聖王/王朝連稱，不能把雙人群體標成一個人。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m1140","start":1140,"end":1141,"surface":"稷","kind":"person","person_id":"jqy_1fv_u7v","status":"contextual_provisional","interpretation_note":"詔稷勤百穀、注明周棄，疏稷契相輔同古人后稷；不讀作任職官稱或杜氏人物。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m1141","start":1141,"end":1142,"surface":"契","kind":"person","person_id":"ea8_yum_lvj","status":"contextual_provisional","interpretation_note":"冥為契六世孫及疏稷契佐唐虞，為商先祖契；不按契約普通詞標。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m1173","start":1173,"end":1175,"surface":"唐虞","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"唐虞為古代聖王/王朝連稱，不能把雙人群體標成一個人。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m1179","start":1179,"end":1180,"surface":"稷","kind":"person","person_id":"jqy_1fv_u7v","status":"contextual_provisional","interpretation_note":"詔稷勤百穀、注明周棄，疏稷契相輔同古人后稷；不讀作任職官稱或杜氏人物。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m1180","start":1180,"end":1181,"surface":"契","kind":"person","person_id":"ea8_yum_lvj","status":"contextual_provisional","interpretation_note":"冥為契六世孫及疏稷契佐唐虞，為商先祖契；不按契約普通詞標。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m1181","start":1181,"end":1182,"surface":"䕫","kind":"person","person_id":"wfn_d71_zaw","status":"contextual_provisional","interpretation_note":"稷契夔龍為唐虞賢臣連稱，五帝本紀夔掌樂傳統人物，排唐陳氏夔同名字。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m1182","start":1182,"end":1183,"surface":"龍","kind":"person","person_id":"rjb_0hy_dsi","status":"contextual_provisional","interpretation_note":"與稷契夔並唐虞受任，是五帝本紀納言龍而非甘龍/公孫龍。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m1192","start":1192,"end":1193,"surface":"鯀","kind":"person","person_id":"y3u_g30_6et","status":"contextual_provisional","interpretation_note":"唐虞委任/殛鯀放四凶為上古治水鯀典故，源傳說層不當當時事件。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m1195","start":1195,"end":1197,"surface":"四凶","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"傳統四凶群體，未在此逐名，非單人。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m1316","start":1316,"end":1318,"surface":"仲尼","kind":"person","person_id":"fp6_ia6_7yw","status":"contextual_provisional","interpretation_note":"孔子所謂禹吾無間然、仲尼對顏子及疏中雖仲尼為謀均引同一先秦儒者；不用名或字另造人。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m1339","start":1339,"end":1340,"surface":"商","kind":"person","person_id":"2wp_usr_ncd","status":"contextual_provisional","interpretation_note":"師商韓而上法術，商是法家商鞅的上下文首選，與秦變法公孫鞅身份同指；不把商朝國號泛標人。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m1340","start":1340,"end":1341,"surface":"韓","kind":"person","person_id":"n2o_l90_fnm","status":"contextual_provisional","interpretation_note":"法術商韓併稱之韓首選韓非，主本傳法家著述身份；不與韓遂或漢代韓氏牽合。"}],"chapter_id":"c-sanguozhi-016-duji-dushu","book_id":"b-sanguozhi-016","work_id":"w-sanguozhi","source_id":"s-sanguozhi-016-duji-dushu-kr214fcafa"},{"id":"c-shiji-084-qujia:p016","text":"亂曰：浩浩沅、湘兮，分流汨兮。修路幽拂兮，道遠忽兮。曾唫恒悲兮，永嘆慨兮。世既莫吾知兮，人心不可謂兮。懷情抱質兮，獨無匹兮。伯樂既歿兮，驥將焉程兮？人生稟命兮，各有所錯兮。定心廣志，餘何畏懼兮？曾傷爰哀，永嘆喟兮。世溷不吾知，心不可謂兮。知死不可讓兮，願勿愛兮。明以告君子兮，吾將以為類兮。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m016-0062","start":62,"end":64,"surface":"伯樂","kind":"person","person_id":"3go_52y_0mp","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m016-0134","start":134,"end":136,"surface":"君子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代保持未解。"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"},{"id":"c-shiji-117-xiangru:p007","text":"「『於是乃使專諸之倫，手格此獸。楚王乃駕馴駁之駟，乘雕玉之輿，靡魚須之橈旃，曳明月之珠旗，建干將之雄戟，左烏嗥之雕弓，右夏服之勁箭；陽子驂乘，纖阿為禦；案節未舒，即陵狡獸，轔邛邛，蹵距虛，軼野馬而𨎥騊駼，乘遺風而射遊騏；儵眒淒浰，靁動熛至，星流霆擊，弓不虛發，中必決眥，洞胷達腋，絕乎心繫，獲若雨獸，揜草蔽地。於是楚王乃弭節裴回，翱翔容與，覽乎陰林，觀壯士之暴怒，與猛獸之恐懼，徼𧮬受詘，殫睹衆物之變態。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m007-0006","start":6,"end":8,"surface":"專諸","kind":"person","person_id":"78u_8ii_bnr","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m007-0016","start":16,"end":18,"surface":"楚王","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m007-0066","start":66,"end":68,"surface":"陽子","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"候選不窮盡，不將陽陵子與陵陽子明按倒字自動接合；不建立實際同車事件。"},{"id":"c-shiji-117-xiangru:m007-0071","start":71,"end":73,"surface":"纖阿","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"孅、纎、纖為各見證用字，正文不替換；不據月御推定性別或親屬。"},{"id":"c-shiji-117-xiangru:m007-0157","start":157,"end":159,"surface":"楚王","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-117-xiangru","book_id":"b-shiji-117","work_id":"w-shiji","source_id":"s-shiji117-xiangru"}],"sources":[{"chapter_id":"c-sanguozhi-016-duji-dushu","work_id":"w-sanguozhi","book_id":"b-sanguozhi-016","source_id":"s-sanguozhi-016-duji-dushu-kr214fcafa","source":{"title":"《三國志》卷十六杜畿、杜恕完整本傳及全部裴注","provider":"Kanripo","url":"https://github.com/kanripo/KR2a0012/blob/214fcafa79894355909c9d8c2c1533089e7791c6/KR2a0012_016.txt","permalink":"https://github.com/kanripo/KR2a0012/blob/214fcafa79894355909c9d8c2c1533089e7791c6/KR2a0012_016.txt","revision_id":"214fcafa79894355909c9d8c2c1533089e7791c6","source_commit":"214fcafa79894355909c9d8c2c1533089e7791c6","response_sha256":"82e8ba333863c0ad47843c72d6237a2d32b10bff3a28ec7f51d614bcb34c5e7f","accessed_on":"2026-10-23","extent":"固定原檔91–406行：杜畿字伯侯起至阮坦喪官王衍哭之，止鄭渾獨立本傳前；44層次單元，不稱全卷。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"license_url":"https://creativecommons.org/publicdomain/mark/1.0/","rights":"古籍原文；Kanripo固定數位文字見證，保來源歸屬。未核書影或實際古刊。","normalization":{"character_conversion":{},"extraction_note":"只移除版面頁碼、換行¶與外層注括號；正文/裴注依原次序、逐字位置全覆蓋。"}}