rface":"鄭玄","kind":"person","person_id":"95f_p0e_7s8","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0495","start":495,"end":497,"surface":"太后","kind":"person","person_id":"xke_dj3_6ba_AAB","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0506","start":506,"end":507,"surface":"裒","kind":"person","person_id":"xke_dj3_6ba_AA","status":"contextual_provisional"}],"source_position":{"first_line":42,"last_line":42,"revision_id":1543614,"editorial_excerpt_boundary":false},"chapter_id":"c-jinshu-032-chu-suanzi","book_id":"b-jinshu-032","work_id":"w-jinshu","source_id":"s-jinshu-032-chu-suanzi"},{"id":"c-jinshu-075-xunsong-families:xunsong-body-136:p001","text":"伏聞節省之制，皆三分置二。博士舊置十九人，今五經合九人，准古計今，猶未能半，宜及節省之制，以時施行。今九人以外，猶宜增四。願陛下萬機餘暇，時垂省覽。宜為鄭《易》置博士一人，鄭《儀禮》博士一人，《春秋公羊》博士一人，《穀梁》博士一人。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-075-xunsong-families:xunsong-body-136:p001:m0062","start":62,"end":64,"surface":"陛下","kind":"person","person_id":"dkn_ge4_286_AAAAAAA","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-body-136:p001:m0076","start":76,"end":77,"surface":"鄭","kind":"person","person_id":"95f_p0e_7s8","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-body-136:p001:m0086","start":86,"end":87,"surface":"鄭","kind":"person","person_id":"95f_p0e_7s8","status":"contextual_provisional"}],"source_position":{"first_line":136,"last_line":136,"revision_id":2645530,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-075-xunsong-families","book_id":"b-jinshu-075","work_id":"w-jinshu","source_id":"s-jinshu-075-xunsong-families"},{"id":"c-jinshu-075-xunsong-families:xunsong-cousins:p001","text":"元帝踐阼，徵拜尚書僕射，使崧與協共定中興禮儀。從弟馗早亡，二息序、廞，年各數歲，崧迎與共居，恩同其子。太尉、臨淮公荀顗國胤廢絕，朝庭以崧屬近，欲以崧子襲封。崧哀序孤微，乃讓封與序，論者稱焉。轉太常。時方修學校，簡省博士，置《周易》王氏、《尚書》鄭氏、《古文尚書》孔氏、《毛詩》鄭氏、《周官禮記》鄭氏、《春秋左傳》杜氏服氏、《論語》《孝經》鄭氏博士各一人，凡九人，其《儀禮》、《公羊》、《穀梁》及鄭《易》皆省不置。崧以為不可，乃上疏曰：","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-075-xunsong-families:xunsong-cousins:p001:m0000","start":0,"end":2,"surface":"元帝","kind":"person","person_id":"dkn_ge4_286_AAAAAAA","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-cousins:p001:m0013","start":13,"end":14,"surface":"崧","kind":"person","person_id":"yoo_ox0_545_BABAAA","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-cousins:p001:m0015","start":15,"end":16,"surface":"協","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"議禮同事協，待平行傳記核定，未按模型記憶補姓名。"},{"id":"c-jinshu-075-xunsong-families:xunsong-cousins:p001:m0025","start":25,"end":26,"surface":"馗","kind":"person","person_id":"1ay_9qe_u4h","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-cousins:p001:m0031","start":31,"end":32,"surface":"序","kind":"person","person_id":"1ay_9qe_u4h_A","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-cousins:p001:m0033","start":33,"end":34,"surface":"廞","kind":"person","person_id":"1ay_9qe_u4h_B","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-cousins:p001:m0040","start":40,"end":41,"surface":"崧","kind":"person","person_id":"yoo_ox0_545_BABAAA","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-cousins:p001:m0057","start":57,"end":59,"surface":"荀顗","kind":"person","person_id":"yoo_ox0_545_BAA","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-cousins:p001:m0067","start":67,"end":68,"surface":"崧","kind":"person","person_id":"yoo_ox0_545_BABAAA","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-cousins:p001:m0073","start":73,"end":74,"surface":"崧","kind":"person","person_id":"yoo_ox0_545_BABAAA","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-cousins:p001:m0078","start":78,"end":79,"surface":"崧","ki