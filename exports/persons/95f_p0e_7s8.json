le_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-jinshu075-zhengxuan-commentary-author","person_id":"95f_p0e_7s8","surfaces":["鄭"],"scope":"same_chapter","chapter_ids":["c-jinshu-075-xunsong-families"],"status":"contextual_provisional","confidence_level":"high","identification_basis":{"kind":"source_context","target_mention_ids":["c-jinshu-075-xunsong-families:xunsong-body-136:p001:m0076","c-jinshu-075-xunsong-families:xunsong-body-136:p001:m0086","c-jinshu-075-xunsong-families:xunsong-cousins:p001:m0197"]},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-075","chapter_id":"c-jinshu-075-xunsong-families","source_id":"s-jinshu-075-xunsong-families","paragraph_id":"c-jinshu-075-xunsong-families:xunsong-body-136:p001","quote":"伏聞節省之制，皆三分置二。博士舊置十九人，今五經合九人，准古計今，猶未能半，宜及節省之制，以時施行。今九人以外，猶宜增四。願陛下萬機餘暇，時垂省覽。宜為鄭《易》置博士一人，鄭《儀禮》博士一人，《春秋公羊》博士一人，《穀梁》博士一人。"},{"work_id":"w-jinshu","book_id":"b-jinshu-075","chapter_id":"c-jinshu-075-xunsong-families","source_id":"s-jinshu-075-xunsong-families","paragraph_id":"c-jinshu-075-xunsong-families:xunsong-cousins:p001","quote":"元帝踐阼，徵拜尚書僕射，使崧與協共定中興禮儀。從弟馗早亡，二息序、廞，年各數歲，崧迎與共居，恩同其子。太尉、臨淮公荀顗國胤廢絕，朝庭以崧屬近，欲以崧子襲封。崧哀序孤微，乃讓封與序，論者稱焉。轉太常。時方修學校，簡省博士，置《周易》王氏、《尚書》鄭氏、《古文尚書》孔氏、《毛詩》鄭氏、《周官禮記》鄭氏、《春秋左傳》杜氏服氏、《論語》《孝經》鄭氏博士各一人，凡九人，其《儀禮》、《公羊》、《穀梁》及鄭《易》皆省不置。崧以為不可，乃上疏曰："}],"rationale":"經籍志明載周易九卷、儀禮十七卷皆鄭玄注，支持荀崧請立鄭易與鄭儀禮博士的兩處鄭氏指代；不由此把前面經師單姓清單中的所有鄭字一律自動接入。","references":[{"title":"《隋書》卷32經籍志一","url":"https://zh.wikisource.org/w/index.php?oldid=7904811","source_revision":7904811,"source_position":{"first_line":31,"last_line":31},"quote":"《周易》九卷後漢大司農鄭玄注。梁又有漢南郡太守馬融注《周易》一卷，亡。","raw_context_quote":"《周易》九卷後漢大司農鄭玄注。梁又有漢南郡太守馬融注《周易》一卷，亡。","raw_context_quote_sha256":"1a31f6bb88816f4dc1ab4f4d7f280496768ace03206c6f679b411e147027460b","wikitext_sha256":"cedd7d8e6fec362ee3be49a9db3b4dfaa5ab18ad72121ddd8a31d056c15b9f10","scope":"primary_parallel_explicit_commentary_author","image_verified":false},{"title":"《隋書》卷32經籍志一","url":"https://zh.wikisource.org/w/index.php?oldid=7904811","source_revision":7904811,"source_position":{"first_line":354,"last_line":354},"quote":"《儀禮》十七卷鄭玄注。","raw_context_quote":"《儀禮》十七卷鄭玄注。","raw_context_quote_sha256":"5e57d1347e2d21b8955e3dedfb9128d962421280838b196afcfb8e2d889e850e","wikitext_sha256":"cedd7d8e6fec362ee3be49a9db3b4dfaa5ab18ad72121ddd8a31d056c15b9f10","scope":"primary_parallel_explicit_commentary_author","image_verified":false}],"human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-032-chu-suanzi:line042","text":"及穆帝即位，尊后曰皇太后。時帝幼沖，未親國政。領司徒蔡謨等上奏曰：「嗣皇誕哲岐嶷，繼承天統，率土宅心，兆庶蒙賴。陛下體茲坤道，訓隆文母。昔塗山光夏，簡狄熙殷，實由宣哲，以隆休祚。伏惟陛下德侔二媯，淑美關雎，臨朝攝政，以寧天下。今社稷危急，兆庶懸命，臣等章惶，一日萬機，事運之期，天祿所鍾，非復沖虛高讓之日。漢和熹、順烈，並亦臨朝，近明穆故事，以為先制。臣等不勝悲怖，謹伏地上請。乞陛下上順祖宗，下念臣吏，推公弘道，以協天人，則萬邦承慶，群黎更生。」太后詔曰：「帝幼沖，當賴群公卿士將順匡救，以酬先帝禮賢之意，且是舊德世濟之美，則莫重之命不墜，祖宗之基有奉，是其所以欲正位于內而已。所奏懇到，形于翰墨，執省未究，以悲以懼。先后允恭謙抑，思順坤道，所以不距群情，固為國計。豈敢執守沖闇，以違先旨。輒敬從所奏。」於是臨朝稱制。有司奏，謝夫人既封，荀、卞二夫人亦應追贈，皆后之前母也。太后不許。太常殷融議依鄭玄義，衛將軍裒在宮庭則盡臣敬，太后歸寧之日自如家人之禮。太后詔曰：「典禮誠所未詳，如所奏，是情所不能安也，更詳之。」征西將軍翼、南中郎尚議謂「父尊盡於一家，君敬重於天下，鄭玄義合情禮之中」。太后從之。自後朝臣皆敬裒焉。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-032-chu-suanzi:line042:m0001","start":1,"end":3,"surface":"穆帝","kind":"person","person_id":"84i_4jp_gmc","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0009","start":9,"end":12,"surface":"皇太后","kind":"person","person_id":"xke_dj3_6ba_AAB","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0014","start":14,"end":15,"surface":"帝","kind":"person","person_id":"84i_4jp_gmc","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0026","start":26,"end":28,"surface":"蔡謨","kind":"person","person_id":"b98_957_r7h","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0034","start":34,"end":36,"surface":"嗣皇","kind":"person","person_id":"84i_4jp_gmc","status