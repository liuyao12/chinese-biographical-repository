ent_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-104-tianshu","source_id":"s-shiji-104-tianshu","paragraph_id":"c-shiji-104-tianshu:p013","quote":"其後用任安為益州刺史，以田仁為丞相長史。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"正文與褚補分層保存；授官、用稱、俸秩與任務分開，未知年與終點不補造，死亡不自動終止。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji104-030","person_id":"y9g_gi6_sn7","title":"北軍使者護軍","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-104-tianshu","source_id":"s-shiji-104-tianshu","paragraph_id":"c-shiji-104-tianshu:p016","quote":"是時任安為北軍使者護軍，太子立車北軍南門外，召任安，與節令發兵。安拜受節，入，閉門不出。武帝聞之，以為任安為詳邪，不傅事，何也？任安笞辱北軍錢官小吏，小吏上書言之，以為受太子節，言「幸與我其鮮好者」。書上聞，武帝曰：「是老吏也，見兵事起，欲坐觀成敗，見勝者欲合從之，有兩心。安有當死之罪甚眾，吾常活之，今懷詐，有不忠之心。」下安吏，誅死。夫月滿則虧，物盛則衰，天地之常也。知進而不知退，久乘富貴，禍積為祟。故范蠡之去越，辭不受官位，名傳後世，萬歲不忘，豈可及哉！後進者慎戒之。"}],"attestations":[{"id":"th-shiji104-030:a001","paragraph_id":"c-shiji-104-tianshu:p016","start":5,"end":11,"surface":"北軍使者護軍","person_mention_id":"c-shiji-104-tianshu:m016-0002","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"正文與褚補分層保存；授官、用稱、俸秩與任務分開，未知年與終點不補造，死亡不自動終止。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji104-032","person_id":"y9g_gi6_sn7","title":"護北軍","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-104-tianshu","source_id":"s-shiji-104-tianshu","paragraph_id":"c-shiji-104-tianshu:p012","quote":"其後有詔募擇衛將軍舍人以為郎，將軍取舍人中富給者，令具鞌馬絳衣玉具劍，欲入奏之。會賢大夫少府趙禹來過衛將軍，將軍呼所舉舍人以示趙禹。趙禹以次問之，十餘人無一人習事有智略者。趙禹曰：「吾聞之，將門之下必有將類。傳曰『不知其君視其所使，不知其子視其所友』。今有詔舉將軍舍人者，欲以觀將軍而能得賢者文武之士也。今徒取盎人子上之，又無智略，如木偶人衣之綺繡耳，將柰之何？」於是趙禹悉召衛將軍舍人百餘人，以次問之，得田仁、任安，曰：「獨此兩人可耳，餘無可用者。」衛將軍見此兩人貧，意不平。趙禹去，謂兩人曰：「各自具樾象絳衣。」兩人對曰：「家貧無用具也。」將軍怒曰：「今兩君家自為貧，何為出此言？鞅鞅如有移德於我者，何也？」將軍不得已，上籍以聞。有詔召見衛將軍舍人，此二人前見，詔問能略相推第也。田仁對曰；「提桴鼓立軍門，使士大夫樂死戰鬬，仁不及任安。」任安對曰：「夫決嫌疑，定是非，辯治官，使百姓無怨心，安不及仁也。」武帝大笑曰：「善。」使任安護北軍，使田仁護邊田穀於河上。此兩人立名天下。"}],"attestations":[{"id":"th-shiji104-032:a001","paragraph_id":"c-shiji-104-tianshu:p012","start":417,"end":420,"surface":"護北軍","person_mention_id":"c-shiji-104-tianshu:m012-0206","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"正文與褚補分層保存；授官、用稱、俸秩與任務分開，未知年與終點不補造，死亡不自動終止。原文任務字面，不補作正式護軍官名；與第十六段北軍使者護軍分存。","reviewer":"Codex（AI 代理）","qualifiers":{"classification":"assigned_duty"}}],"address_assertions":[{"id":"pa-shiji104-002","person_id":"y9g_gi6_sn7","relation":"native_place","place":{"source_name":"滎陽","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-104-tianshu","source_id":"s-shiji-104-tianshu","paragraph_id":"c-shiji-104-tianshu:p010","quote":"褚先生曰：臣為郎時，聞之曰田仁故與任安相善。任安，滎陽人也。少孤貧困，為人將車之長安，留，求事為小吏，未有因緣也，因占著名數。武功，扶風西界小邑也，谷口蜀道近山。安以為武功小邑，無豪，易高也，安留，代人為求盜亭父。後為亭長。邑中人民俱出獵，任安常為人分麋鹿雉兔，部署老小當壯劇易處，眾人皆喜，曰：「無傷也，任少卿分別平，有智略。」明日復合會，會者數百人。任少卿曰：「某子甲何為不來乎？」諸人皆怪其見之疾也。其後除為三老，舉為親民，出為三百石長，治民。坐上行出游共帳不辦，斥免。"}],"source_term":"任安，滎陽人也。","interpretation_note":"保存本人出身或原文所記留居；不補今日行政區，齊田氏苗裔不作田叔本人齊籍。","reviewer":"Codex（AI 代理）","human_reviewed":false},{"id":"pa-shiji104-003","person_id":"y9g_gi6_sn7","relation":"residence","place":{"source_name":"長安","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-104-tianshu","source_id":"s-shiji-104-tianshu","paragraph_id":"c-shiji-104-tianshu:p010","quote":"褚先生曰：臣為郎時，聞之曰田仁故與任安相善。任安，滎陽人也。少孤貧困，為人將車之長安，留，求事為小吏，未有因緣也，因占著名數。武功，扶風西界小邑也，谷口蜀道近山。安以為武功小邑，無豪，易高也，安留，代人為求盜亭父。後為亭長。邑中人民俱出獵，任安常為人分麋鹿雉兔，部署老小當壯劇易處，眾人皆喜，曰：「無傷也，任少卿分別平，有智略。」明日復合會，會者數百人。任少卿曰：「某子甲何為不來乎？」諸人皆怪其見之疾也。其後除為三老，舉為親民，出為三百石長，治民。坐上行出游共帳不辦，斥免。"}],"source_term":"為人將車之長安，留","interpretation_note":"保存本人出身或原文所記留居；不補今日行政區，齊田氏苗裔不作田叔本人齊籍。","reviewer":"Codex（AI 代理）","human_reviewed":false},{"id":"pa-shiji104-004","person_id":"y9g_gi6_sn7","relation":"residence","place":{"source_name":"武功","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-104-tianshu","source_id":"s-shiji-104-tianshu","paragraph_id":"c-shiji-104-tianshu:p010","quote":"褚先生曰：臣為郎時，聞之曰田仁故與任安相善。任安，滎陽人也。少孤貧困，為人將車之長安，留，求事為小吏，未有因緣也，因占著名數。武功，扶風西界小邑也，谷口蜀道近山。安以為武功小邑，無豪，易高也，安留，代人為求盜亭父。後為亭長。邑中人民俱出獵，任安常為人分麋鹿雉兔，部署老小當壯劇易處，眾人皆喜，曰：「無傷也，任少卿分別平，有智略。」明日復合會，會者數百人。任少卿曰：「某子甲何為不來乎？」諸人皆怪其見之疾也。其後除為三老，舉為親民，出為三百石長，治民。坐上行出游共帳不辦，斥免。"}],"source_term":"安以為武功小邑，無豪，易高也，安留","interpretation_note":"保存本人出身或原文所記留居；不補今日行政區，齊田氏苗裔不作田叔本人齊籍。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji104-025","person_id":"y9g_gi6_sn7","surfaces":["任安","任少卿","安"],"scope":"same_chapter","chapter_ids":["c-shiji-104-tianshu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-104-tianshu:p010","quote":"褚先生曰：臣為郎時，聞之曰田仁故與任安相善。任安，滎陽人也。少孤貧困，為人將車之長安，留，求事為小吏，未有因緣也，因占著名數。武功，扶風西界小邑也，谷口蜀道近山。安以為武功小邑，無豪，易高也，安留，代人為求盜亭父。後為亭長。邑中人民俱出獵，任安常為人分麋鹿雉兔，部署老小當壯劇易處，眾人皆喜，曰：「無傷也，任少卿分別平，有智略。」明日復合會，會者數百人。任少卿曰：「某子甲何為不來乎？」諸人皆怪其見之疾也。其後除為三老，舉為親民，出為三百石長，治民。坐上行出游共帳不辦，斥免。"},{"paragraph_id":"c-shiji-104-tianshu:p011","quote":"乃為衛將軍舍人，與田仁會，俱為舍人，居門下，同心相愛。此二人家貧，無錢用以事將軍家監，家監使養惡齧馬。兩人同床臥，仁竊言曰：「不知人哉家監也！」任安曰：「將軍尚不知人，何乃家監也！」衛將軍從此兩人過平陽主，主家令兩人與騎奴同席而食，此二子拔刀列斷席別坐。主家皆怪而惡之，莫敢呵。"},{"paragraph_id":"c-shiji-104-tianshu:p012","quote":"其後有詔募擇衛將軍舍人以為郎，將軍取舍人中富給者，令具鞌馬絳衣玉具劍，欲入奏之。會賢大夫少府趙禹來過衛將軍，將軍呼所舉舍人以示趙禹。趙禹以次問之，十餘人無一人習事有智略者。趙禹曰：「吾聞之，將門之下必有將類。傳曰『不知其君視其所使，不知其子視其所友』。今有詔舉將軍舍人者，欲以觀將軍而能得賢者文武之士也。今徒取盎人子上之，又無智略，如木偶人衣之綺繡耳，將柰之何？」於是趙禹悉召衛將軍舍人百餘人，以次問之，得田仁、任安，曰：「獨此兩人可耳，餘無可用者。」衛將軍見此兩人貧，意不平。趙禹去，謂兩人曰：「各自具樾象絳衣。」兩人對曰：「家貧無用具也。」將軍怒曰：「今兩君家自為貧，何為出此言？鞅鞅如有移德於我者，何也？」將軍不得已，上籍以聞。有詔召見衛將軍舍人，此二人前見，詔問能略相推第也。田仁對曰；「提桴鼓立軍門，使士大夫樂死戰鬬，仁不及任安。」任安對曰：「夫決嫌疑，定是非，辯治官，使百姓無怨心，安不及仁也。」武帝大笑曰：「善。」使任安護北軍，使田仁護邊田穀於河上。此兩人立名天下。"},{"paragraph_id":"c-shiji-104-tianshu:p013","quote":"其後用任安為益州刺史，以田仁為丞相長史。"},{"paragraph_id":"c-shiji-104-tianshu:p016","quote":"是時任安為北軍使者護軍，太子立車北軍南門外，召任安，與節令發兵。安拜受節，入，閉門不出。武帝聞之，以為任安為詳邪，不傅事，何也？任安笞辱北軍錢官小吏，小吏上書言之，以為受太子節，言「幸與我其鮮好者」。書上聞，武帝曰：「是老吏也，見兵事起，欲坐觀成敗，見勝者欲合從之，有兩心。安有當死之罪甚眾，吾常活之，今懷詐，有不忠之心。」下安吏，誅死。夫月滿則虧，物盛則衰，天地之常也。知進而不知退，久乘富貴，禍積為祟。故范蠡之去越，辭不受官位，名傳後世，萬歲不忘，豈可及哉！後進者慎戒之。"}],"rationale":"依本篇姓名、原稱及敘事回指暫定；褚補與正文分層，未按同名自動跨篇合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-104-tianshu:p010","text":"褚先生曰：臣為郎時，聞之曰田仁故與任安相善。任安，滎陽人也。少孤貧困，為人將車之長安，留，求事為小吏，未有因緣也，因占著名數。武功，扶風西界小邑也，谷口蜀道近山。安以為武功小邑，無豪，易高也，安留，代人為求盜亭父。後為亭長。邑中人民俱出獵，任安常為人分麋鹿雉兔，部署老小當壯劇易處，眾人皆喜，曰：「無傷也，任少卿分別平，有智略。」明日復合會，會者數百人。任少卿曰：「某子甲何為不來乎？」諸人皆怪其見之疾也。其後除為三老，舉為親民，出為三百石長，治民。坐上行出游共帳不辦，斥免。","annotation_status":"named_mentions_first_pass","text_layer":"witness_appended_chu_note","mentions":[{"id":"c-shiji-104-tianshu:m010-0000","start":0,"end":3,"surface":"褚先生","kind":"person","person_id":"h1l_7wr_80t","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m010-0013","start":13,"end":15,"surface":"田仁","kind":"person","person_id":"gyt_axg_s7t_A","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m010-0017","start":17,"end":19,"surface":"任安","kind":"person","person_id":"y9g_gi6_sn7","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m010-0022","start":22,"end":24,"surface":"任安","kind":"person","person_id":"y9g_gi6_sn7","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m010-0081","start":81,"end":82,"surface":"安","kind":"person","person_id":"y9g_gi6_sn7","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m010-0096","start":96,"end":97,"surface":"安","kind":"person","person_id":"y9g_gi6_sn7","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m010-0120","start":120,"end":122,"surface":"任安","kind":"person","person_id":"y9g_gi6_sn7","status":"contextual_provisional"},{"id":"c-shiji-104-tianshu:m010-0153","start":153,"end":156,"surface":"任少卿","kind":"person","pers