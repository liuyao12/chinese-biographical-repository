004:m0310","surface":"繇","start":310,"end":311,"kind":"person","person_id":"fvd_gis_x74","status":"contextual_provisional"},{"id":"c-sanguozhi-049-liuyou-complete:p004:m0327","surface":"笮融","start":327,"end":329,"kind":"person","person_id":"brd_lue_3md","status":"contextual_provisional"},{"id":"c-sanguozhi-049-liuyou-complete:p004:m0335","surface":"朱皓","start":335,"end":337,"kind":"person","person_id":"g3o_1tg_9lu","status":"contextual_provisional"},{"id":"c-sanguozhi-049-liuyou-complete:p004:m0343","surface":"繇","start":343,"end":344,"kind":"person","person_id":"fvd_gis_x74","status":"contextual_provisional"},{"id":"c-sanguozhi-049-liuyou-complete:p004:m0346","surface":"融","start":346,"end":347,"kind":"person","person_id":"brd_lue_3md","status":"contextual_provisional"},{"id":"c-sanguozhi-049-liuyou-complete:p004:m0349","surface":"融","start":349,"end":350,"kind":"person","person_id":"brd_lue_3md","status":"contextual_provisional"},{"id":"c-sanguozhi-049-liuyou-complete:p004:m0362","surface":"融","start":362,"end":363,"kind":"person","person_id":"brd_lue_3md","status":"contextual_provisional"},{"id":"c-sanguozhi-049-liuyou-complete:p004:m0364","surface":"融","start":364,"end":365,"kind":"person","person_id":"brd_lue_3md","status":"contextual_provisional"},{"id":"c-sanguozhi-049-liuyou-complete:p004:m0375","surface":"繇","start":375,"end":376,"kind":"person","person_id":"fvd_gis_x74","status":"contextual_provisional"}],"chapter_id":"c-sanguozhi-049-liuyou-complete","book_id":"b-sanguozhi-049","work_id":"w-sanguozhi","source_id":"s-sanguozhi-049-liuyou-complete-ws2075209"},{"id":"c-sanguozhi-051-ben:line032","text":"　　孫賁字伯陽；父羌字聖〔臺〕，堅同產兄也，賁早失二親，弟輔嬰孩，賁自贍育，友愛甚篤。為郡督郵守長。堅於長沙舉義兵，賁去吏從征伐。堅薨，賁攝帥餘眾，扶送靈柩。後袁術徙壽春，賁又依之。術從兄紹用會稽周昂為九江太守，紹與術不協，術遣賁攻破昂於陰陵。術表賁領豫州刺史，轉丹楊都尉，行征虜將軍，討平山越。為揚州刺史劉繇所迫逐，因將士眾還住歷陽。頃之，術復使賁與吳景共擊樊能、張英等，未能拔。及策東渡，助賁、景破英、能等，遂進擊劉繇。繇走豫章。策遣賁、景還壽春報術，值術僭號，署置百官。除賁九江太守。賁不就，棄妻孥還江南。時策已平吳、會二郡，賁與策征廬江太守劉勳、江夏太守黃祖，軍旋，聞繇病死，過定豫章，上賁領太守，後封都亭侯。建安十三年，使者劉隱奉詔拜賁為征虜將軍，領郡如故。在官十一年卒。子鄰嗣。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-051-ben:line032:m0002","start":2,"end":4,"surface":"孫賁","kind":"person","person_id":"8jx_b5c_t2q","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-ben:line032:m0005","start":5,"end":7,"surface":"伯陽","kind":"person","person_id":"8jx_b5c_t2q","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-ben:line032:m0009","start":9,"end":10,"surface":"羌","kind":"person","person_id":"km0_joi_0ag","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-ben:line032:m0011","surface":"聖〔臺〕","start":11,"end":15,"kind":"person","person_id":"km0_joi_0ag","status":"contextual_provisional","interpretation_note":"按本段具名及前後親稱、官職定位。"},{"id":"c-sanguozhi-051-ben:line032:m0016","start":16,"end":17,"surface":"堅","kind":"person","person_id":"ki7_rgz_3l4","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-ben:line032:m0022","start":22,"end":23,"surface":"賁","kind":"person","person_id":"8jx_b5c_t2q","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-ben:line032:m0029","start":29,"end":30,"surface":"輔","kind":"person","person_id":"e8h_aeo_zy8","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-ben:line032:m0033","start":33,"end":34,"surface":"賁","kind":"person","person_id":"8jx_b5c_t2q","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-ben:line032:m0050","start":50,"end":51,"surface":"堅","kind":"person","person_id":"ki7_rgz_3l4","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-ben:line032:m0058","start":58,"end":59,"surface":"賁","kind":"person","person_id":"8jx_b5c_t2q","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-ben:line032:m0065","start":65,"end":66,"sur