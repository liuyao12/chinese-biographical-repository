,3150,3151,3152,3153,3154,3155,3156,3157,3158,3159,3160,3279,3280,3281,3282,3283,3284,3290,3291,3292,3293,3294,3297,3298,3299,3300,3301,3302,3303,3304,3305,3306,3307,3308,3309,3310,3311,3312,3313,3314,3315,3316,3317,3318,3319,3320,3321,3322,3323,3324,3325,3326,3327]},"chapter_id":"c-sanguozhi-051-ben","book_id":"b-sanguozhi-051","work_id":"w-sanguozhi","source_id":"s-sanguozhi-051-ben"},{"id":"c-sanguozhi-055-chengpu:line014","text":"堅薨，復隨孫策在淮南，從攻廬江，拔之，還俱東渡。策到橫江、當利，破張英、于麋等，轉下秣陵、湖熟、句容、曲阿，普皆有功，增兵二千，騎五十匹。進破烏程、石木、波門、陵傳、餘杭，普功爲多。策入會稽，以普爲吳郡都尉，治錢唐。後徙丹楊都尉，居石城。復討宣城、涇、安吳、陵陽、春穀諸賊，皆破之。策甞攻祖郎，大爲所圍，普與一騎共蔽扞策，驅馬疾呼，以矛突賊，賊披，策因隨出。後拜盪寇中郎將，領零陵太守，從討劉勳於尋陽，進攻黃祖於沙羨，還鎮石城。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-055-chengpu:line014:m0000","start":0,"end":1,"surface":"堅","kind":"person","person_id":"ki7_rgz_3l4","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-055-chengpu:line014:m0005","start":5,"end":7,"surface":"孫策","kind":"person","person_id":"e9c_070_567","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-055-chengpu:line014:m0024","start":24,"end":25,"surface":"策","kind":"person","person_id":"e9c_070_567","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-055-chengpu:line014:m0033","start":33,"end":35,"surface":"張英","kind":"person","person_id":"ql3_zdn_qpd","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-055-chengpu:line014:m0036","start":36,"end":38,"surface":"于麋","kind":"person","person_id":"77h_kqa_ghe","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-055-chengpu:line014:m0054","start":54,"end":55,"surface":"普","kind":"person","person_id":"p6n_a0q_flh","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-055-chengpu:line014:m0086","start":86,"end":87,"surface":"普","kind":"person","person_id":"p6n_a0q_flh","status":"context