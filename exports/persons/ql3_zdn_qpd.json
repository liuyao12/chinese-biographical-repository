13,314,315,316,317,318,319,320,321,322,323,324,325,326,327,328,329,330,331,332,333,334,335,336,337,338,339,340,341,342,343,344,345,346,347,348,349,350,351,352,353,354,355,356,357,358,359,360,361,362,363,364,365,366,367,368,369,370,371,372,373,374,375,376,377,378,379,380,381,382,383,384,385,386,387,388,389,390,391,392,393,394,395,396,397,398,399,400,401,402,403,404,405,406,407,408,409,410,411,412,413,414,415,416,417,418,419,420,421,422,423,424,425,426,427,428,429,430,431,432,433,434,435,436,437,438,439,440,441,442,443,444,445,446,447,448,449,450,451,452,453,454,455,456,457,458,459,460,461,462,463,464,465,466,467,468,469,470,471,472,473,474,475,476,477,478,479,480,481,482,483,484,485,486,487,488,489,490,491,492,493,494,495,496,497,498,499,500,501,502,503,504,505,506,507,508,509,510,511,512,513,514,515,516,517,518,519,520]},"chapter_id":"c-sanguozhi-055-chengpu","book_id":"b-sanguozhi-055","work_id":"w-sanguozhi","source_id":"s-sanguozhi-055-chengpu"},{"id":"c-sanguozhi-056-lvfan:line045","text":"　　呂範字子衡，汝南細陽人也。少為縣吏，有容觀姿貌。邑人劉氏，家富女美，範求之。女母嫌，欲勿與，劉氏曰：「觀呂子衡，寧當久貧者邪?」遂與之婚。後避亂壽春，孫策見而異之，範遂自委暱，將私客百人歸策。時太妃在江都，策遣範迎之。徐州牧陶謙謂範為袁氏覘候，諷縣掠考範，範親客健兒篡取以歸。時唯範與孫河常從策，跨涉辛苦，危難不避，策亦親戚待之，每與升堂飲宴於太妃前。後從策攻破廬江，還俱東渡，到橫江、當利，破長英、於麋，下小丹楊、湖孰，領湖孰相。策定秣陵、曲阿，收笮融，劉繇餘眾，增範兵二千，騎五十匹。後領宛陵令，討破丹楊賊，還吳，遷都督。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-056-lvfan:line045:m0002","start":2,"end":4,"surface":"呂範","kind":"person","person_id":"908_816_219","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-056-lvfan:line045:m0005","start":5,"end":7,"surface":"子衡","kind":"person","person_id":"908_816_219","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-056-lvfan:line045:m0028","start":28,"end":30,"surface":"劉氏","kind":"person","person_id":"9nk_3o3_qkj","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-056-lvfan:line045:m0033","surface":"女","start":33,"end":34,"kind":"person","person_id"