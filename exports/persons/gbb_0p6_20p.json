y":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-shiji122-017","person_id":"gbb_0p6_20p","event_type":"death","status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-122-kuli","source_id":"s-shiji122-kuli","paragraph_id":"c-shiji-122-kuli:p038","quote":"減宣者，楊人也。以佐史無害給事河東守府。衞將軍靑使買馬河東，見宣無害，言上，徴爲大廐丞。官事辨，稍遷至御史及中丞。使治主父偃及治淮南反獄，所以微文深詆，殺者甚衆，稱爲敢決疑。數廢數起，爲御史及中丞者幾二十歳。王温舒免中尉，而宣爲左内史。其治米鹽，事大小皆關其手，自部署縣名曹實物，官吏令丞不得擅搖，痛以重法繩之。居官數年，一切郡中爲小治辨，然獨宣以小致大，能因力行之，難以爲經。中廢。爲右扶風，坐怨成信，信亡藏上林中，宣使郿令格殺信，吏卒格信時，射中上林苑門，宣下吏詆罪，以爲大逆，當族，自殺。而杜周任用。","person_mention_id":"c-shiji-122-kuli:m038-0199"}],"source_term":"格殺信","interpretation_note":"原文明示死亡、執行或自殺；各次回顧未另造死亡事件。未知公元年保持未知，後一歳、十餘年等相對時間保留原文待核。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"mentions":[{"id":"c-shiji-122-kuli:m030-0244","start":244,"end":246,"surface":"成信","kind":"person","person_id":"gbb_0p6_20p","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p030","chapter_id":"c-shiji-122-kuli"},{"id":"c-shiji-122-kuli:m038-0199","start":199,"end":201,"surface":"成信","kind":"person","person_id":"gbb_0p6_20p","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p038","chapter_id":"c-shiji-122-kuli"},{"id":"c-shiji-122-kuli:m038-0202","start":202,"end":203,"surface":"信","kind":"person","person_id":"gbb_0p6_20p","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p038","chapter_id":"c-shiji-122-kuli"},{"id":"c-shiji-122-kuli:m038-0215","start":215,"end":216,"surface":"信","kind":"person","person_id":"gbb_0p6_20p","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p038","chapter_id":"c-shiji-122-kuli"},{"id":"c-shiji-122-kuli:m038-0220","start":220,"end":221,"surface":"信","kind":"person","person_id":"gbb_0p6_20p","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p038","chapter_id":"c-shiji-122-kuli"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-122-kuli:p030","text":"素居廣平時，皆知河内豪姦之家，及往，九月而至。令郡具私馬五十匹，爲驛自河内至長安，部吏如居廣平時方略，捕郡中豪猾，郡中豪猾相連坐千餘家。上書請，大者至族，小者乃死，家盡沒入償臧。奏行不過二三日，得可事。論報，至流血十餘里。河内皆怪其奏，以爲神速。盡十二月，郡中毋聲，毋敢夜行，野無犬吠之盜。其頗不得，失之旁郡國，黎來，會春，温舒頓足嘆曰：「嗟乎，令冬月益展一月，足吾事矣！」其好殺伐行威不愛人如此。天子聞之，以爲能，遷爲中尉。其治復放河内，徙諸名禍猾吏與從事，河内則楊皆、麻戊，關中楊贛、成信等。義縱爲内史，憚未敢恣治。及縱死，張湯敗後，徙爲廷尉，而尹齊爲中尉。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-122-kuli:m030-0052","start":52,"end":56,"surface":"郡中豪猾","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m030-0057","start":57,"end":61,"surface":"郡中豪猾","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m030-0064","start":64,"end":67,"surface":"千餘家","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m030-0162","start":162,"end":164,"surface":"温舒","kind":"person","person_id":"6ym_eva_k4a","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m030-0199","start":199,"end":201,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m030-0222","start":222,"end":226,"surface":"名禍猾吏","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m030-0233","start":233,"end":235,"surface":"楊皆","kind":"person","person_id":"i94_cco_pt9","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m030-0236","start":236,"end":238,"surface":"麻戊","kind":"person","person_id":"jfj_ky5_9lg","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m030-0241","start":241,"end":243,"surface":"楊贛","kind":"person","person_id":"syj_umb_ll5","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m030-0244","start":244,"end":246,"surface":"成信","kind":"person","person_id":