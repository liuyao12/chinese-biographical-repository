face":"左將軍","kind":"person","person_id":"ae4_u22_s8c","status":"contextual_provisional"}],"chapter_id":"c-shiji-115-chaoxian","book_id":"b-shiji-115","work_id":"w-shiji","source_id":"s-shiji115-chaoxian"},{"id":"c-shiji-115-chaoxian:p010","text":"太史公曰：右渠負固，國以絕祀。涉何誣功，為兵發首。樓船將狹，及難離咎。悔失番禺，乃反見疑。荀彘爭勞，與遂皆誅。兩軍俱辱，將率莫侯矣。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-115-chaoxian:m010-0000","start":0,"end":3,"surface":"太史公","kind":"person","person_id":"pme_eis_xqi_*A*AAAAA","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m010-0005","start":5,"end":7,"surface":"右渠","kind":"person","person_id":"f41_ulg_3u1_*A","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m010-0015","start":15,"end":17,"surface":"涉何","kind":"person","person_id":"3rh_ei8_elm","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m010-0025","start":25,"end":27,"surface":"樓船","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m010-0045","start":45,"end":47,"surface":"荀彘","kind":"person","person_id":"ae4_u22_s8c","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m010-0051","start":51,"end":52,"surface":"遂","kind":"person","person_id":"b80_lq9_z00","status":"contextual_provisional"}],"chapter_id":"c-shiji-115-chaoxian","book_id":"b-shiji-115","work_id":"w-shiji","source_id":"s-shiji115-chaoxian"}],"sources":[{"chapter_id":"c-shiji-115-chaoxian","work_id":"w-shiji","book_id":"b-shiji-115","source_id":"s-shiji115-chaoxian","source":{"title":"史記／卷115","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷115","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷115&oldid=439220","revision_id":439220,"accessed_on":"2026-10-11","extent":"固定數位見證10段正文，沒有索隱述贊。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings"