-115-chaoxian:p008","chapter_id":"c-shiji-115-chaoxian"},{"id":"c-shiji-115-chaoxian:m009-0000","start":0,"end":3,"surface":"左將軍","kind":"person","person_id":"ae4_u22_s8c","status":"contextual_provisional","paragraph_id":"c-shiji-115-chaoxian:p009","chapter_id":"c-shiji-115-chaoxian"},{"id":"c-shiji-115-chaoxian:m009-0031","start":31,"end":34,"surface":"左將軍","kind":"person","person_id":"ae4_u22_s8c","status":"contextual_provisional","paragraph_id":"c-shiji-115-chaoxian:p009","chapter_id":"c-shiji-115-chaoxian"},{"id":"c-shiji-115-chaoxian:m010-0045","start":45,"end":47,"surface":"荀彘","kind":"person","person_id":"ae4_u22_s8c","status":"contextual_provisional","paragraph_id":"c-shiji-115-chaoxian:p010","chapter_id":"c-shiji-115-chaoxian"}],"relations":[],"title_holdings":[{"id":"th-shiji115-007","person_id":"ae4_u22_s8c","title":"左將軍","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-115-chaoxian","source_id":"s-shiji115-chaoxian","paragraph_id":"c-shiji-115-chaoxian:p004","quote":"天子募罪人擊朝鮮。其秋，遣樓船將軍楊仆從齊浮渤海；兵五萬人，左將軍荀彘出遼東：討右渠。右渠發兵距險。左將軍卒正多率遼東兵先縱，敗散，多還走，坐法斬。樓船將軍將齊兵七千人先至王險。右渠城守，窺知樓船軍少，即出城擊樓船，樓船軍敗散走。將軍楊仆失其眾，遁山中十餘日，稍求收散卒，復聚。左將軍擊朝鮮浿水西軍，未能破自前。"}],"attestations":[{"id":"th-shiji115-007:a001","paragraph_id":"c-shiji-115-chaoxian:p004","start":30,"end":33,"surface":"左將軍","person_mention_id":"c-shiji-115-chaoxian:m004-0030","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授任與文獻用稱分存，素侍中為追述舊職；日期僅限原段明示紀年，不補月份日或未知任期。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji115-009","person_id":"ae4_u22_s8c","title":"侍中","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-115-chaoxian","source_id":"s-shiji115-chaoxian","paragraph_id":"c-shiji-115-chaoxian:p007","quote":"左將軍素侍中，幸，將燕代卒，悍，乘勝，軍多驕。樓船將齊卒，入海，固已多敗亡；其先與右渠戰，因辱亡卒，卒皆恐，將心慚，其圍右渠，常持和節。左將軍急擊之，朝鮮大臣乃陰閒使人私約降樓船，往來言，尚未肯決。左將軍數與樓船期戰，樓船欲急就其約，不會；左將軍亦使人求閒卻降下朝鮮，朝鮮不肯，心附樓船：以故兩將不相能。左將軍心意樓船前有失軍罪，今與朝鮮私善而又不降，疑其有反計，未敢發。天子曰將率不能，前（及）［乃］使衛山諭降右渠，右渠遣太子，山使不能剸決，與左將軍計相誤，卒沮約。今兩將圍城，又乖異，以故久不決。使濟南太守公孫遂往（征）［正］之，有便宜得以從事。遂至，左將軍曰：「朝鮮當下久矣，不下者有狀。」言樓船數期不會，具以素所意告遂，曰：「今如此不取，恐為大害，非獨樓船，又且與朝鮮共滅吾軍。」遂亦以為然，而以節召樓船將軍入左將軍營計事，即命左將軍麾下執捕樓船將軍，并其軍，以報天子。天子誅遂。"}],"attestations":[{"id":"th-shiji115-009:a001","paragraph_id":"c-shiji-115-chaoxian:p007","start":4,"end":6,"surface":"侍中","person_mention_id":"c-shiji-115-chaoxian:m007-0000","usage":"retrospective","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授任與文獻用稱分存，素侍中為追述舊職；日期僅限原段明示紀年，不補月份日或未知任期。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-115-chaoxian:p004","text":"天子募罪人擊朝鮮。其秋，遣樓船將軍楊仆從齊浮渤海；兵五萬人，左將軍荀彘出遼東：討右渠。右渠發兵距險。左將軍卒正多率遼東兵先縱，敗散，多還走，坐法斬。樓船將軍將齊兵七千人先至王險。右渠城守，窺知樓船軍少，即出城擊樓船，樓船軍敗散走。將軍楊仆失其眾，遁山中十餘日，稍求收散卒，復聚。左將軍擊朝鮮浿水西軍，未能破自前。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-115-chaoxian:m004-0000","start":0,"end":2,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m004-0013","start":13,"end":17,"surface":"樓船將軍","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m004-0017","start":17,"end":19,"surface":"楊仆","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m004-0030","start":30,"end":33,"surface":"左將軍","kind":"person","person_id":"ae4_u22_s8c","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m004-0033","start":33,"end":35,"surface":"荀彘","kind":"person","person_id":"ae4_u22_s8c","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m004-0040","start":40,"end":42,"surface":"右渠","kind":"person","person_id":"f41_ulg_3u1_*A","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m004-0043","start":43,"end":45,"surface":"右渠","kind":"person","person_id":"f41_ulg_3u1_*A","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m004-0050","start":50,"end":53,"surface":"左將軍","kind":"person","person_id":"ae4_u22_s8c","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m004-0053","start":53,"end":56,"surface":"卒正多","kind":"person","person_id":"fg9_0lk_9fy","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m004-0066","start":66,"end":67,"surface":"多","kind":"person","person_id":"fg9_0lk_9fy","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m004-0074","start":74,"end":78,"surface":"樓船將軍","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m004-0089","start":89,"end":91,"surface":"右渠","kind":"person","person_id":"f41_ulg_3u1_*A","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m004-0096","start":96,"end":98,"surface":"樓船","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m004-0105","start":105,"end":107,"surface":"樓船","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m004-0108","start":108,"end":110,"surface":"樓船","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m004-0117","start":117,"end":119,"surface":"楊仆","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m004-0139","start":139,"end":142,"surface":"左將軍","kind":"person","person_id":"ae4_u22_s8c","status":"contextual_provisional"}],"chapter_id":"c-shiji-115-chaoxian","book_id":"b-shiji-115","work_id":"w-shiji","source_id":"s-shiji115-chaoxian"},{"id":"c-shiji-115-chaoxian:p005","text":"天子為兩將未有利，乃使衛山因兵威往諭右渠。右渠見使者頓首謝：「願降，恐兩將詐殺臣；今見信節，請服降。」遣太子入謝，獻馬五千匹，及饋軍糧。人眾萬餘，持兵，方渡浿水，使者及左將軍疑其為變，謂太子已服降，宜命人毋持兵。太子亦疑使者左將軍詐殺之，遂不渡浿水，復引歸。山還報天子，天子誅山。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-115-chaoxian:m005-0000","start":0,"end":2,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m005-0011","start":11,"end":13,"surface":"衛山","kind":"person","person_id":"1a3_sos_b0l","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m005-0018","start":18,"end":20,"surface":"右渠","kind":"person","person_id":"f41_ulg_3u1_*A","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m005-0021","start":21,"end":23,"surface":"右渠","kind":"person","person_id":"f41_ulg_3u1_*A","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m005-0052","start":52,"end":54,"surface":"太子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-115-chaoxian:m005-0084","start":84,"end":87,"surface":"左將軍","kind":"person","person_id":"ae4_u22_s8c","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m005-0093","start":93,"end":95,"surface":"太子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-115-chaoxian:m005-0106","start":106,"end":108,"surface":"太子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-115-chaoxian:m005-0112","start":112,"end":115,"surface":"左將軍","kind":"person","person_id":"ae4_u22_s8c","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m005-0129","start":129,"end":130,"surface":"山","kind":"person","person_id":"1a3_sos_b0l","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m005-0132","start":132,"end":134,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-115-chaoxian:m005-0135","start":135,"end":137,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p