erved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanshi-019-dan19:p002:m0013","start":13,"end":15,"surface":"劉叡","person_id":"vd5_8v5_l9a","kind":"person","status":"contextual_provisional","interpretation_note":"有司之議所擬進璽者，實際改由澹攝。","paragraph_id":"c-nanshi-019-dan19:p002","chapter_id":"c-nanshi-019-dan19"}],"relations":[],"title_holdings":[{"id":"th-nanshi-019-dan19-p002-011","person_id":"vd5_8v5_l9a","title":"侍中","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-019","chapter_id":"c-nanshi-019-dan19","source_id":"s-nanshi-019-dan19-ws1531762","paragraph_id":"c-nanshi-019-dan19:p002","quote":"宋武帝將受禪，有司議使侍中劉叡進璽，帝曰：「此選當須人望。」乃使澹攝。澹嘗侍帝宴，酣飲大言無所屈，鄭鮮之欲按之，帝以爲澹方外士，不宜規矩繩之；然意不說，不以任寄。後復侍飲，醉謂帝曰：「陛下用群臣，但須委屈順者乃見貴，汲黯之徒無用也。」帝大笑。","person_mention_id":"c-nanshi-019-dan19:p002:m0013"}],"attestations":[{"id":"th-nanshi-019-dan19-p002-011:a","paragraph_id":"c-nanshi-019-dan19:p002","start":11,"end":13,"surface":"侍中","person_mention_id":"c-nanshi-019-dan19:p002:m0013","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本傳於此報官名，任期未確。","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanshi-019-dan19:p002","text":"宋武帝將受禪，有司議使侍中劉叡進璽，帝曰：「此選當須人望。」乃使澹攝。澹嘗侍帝宴，酣飲大言無所屈，鄭鮮之欲按之，帝以爲澹方外士，不宜規矩繩之；然意不說，不以任寄。後復侍飲，醉謂帝曰：「陛下用群臣，但須委屈順者乃見貴，汲黯之徒無用也。」帝大笑。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-nanshi-019-dan19:p002:u0007","start":7,"end":9,"surface":"有司","person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"議進璽者未具名。"},{