:102,"raw_start":5758,"raw_end":5787,"raw_character_offsets":[5758,5759,5760,5761,5762,5763,5764,5765,5766,5767,5768,5769,5770,5771,5772,5773,5774,5775,5776,5777,5778,5779,5780,5781,5782,5783,5784,5785,5786],"revision_id":1762878},"mentions":[{"id":"c-nanqishu-054-recluses-complete:p038:m0002","start":2,"end":5,"surface":"臧榮緒","kind":"person","person_id":"nzb_dy0_0ry","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p038:m0013","start":13,"end":15,"surface":"奉先","kind":"person","person_id":"yx6_ao6_2mb","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p038:m0021","start":21,"end":23,"surface":"庸民","kind":"person","person_id":"z6b_99m_p1s","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-054-recluses-complete","book_id":"b-nanqishu-054","work_id":"w-nanqishu","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:p039","text":"　　榮緒幼孤，躬自灌園，以供祭祀。母喪後，乃著《嫡寢論》，掃灑堂宇，置筵席，朔望輙拜薦，甘珍未嘗先食。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":104,"last_line":104,"raw_start":5789,"raw_end":5840,"raw_character_offsets":[5789,5790,5791,5792,5793,5794,5795,5796,5797,5798,5799,5800,5801,5802,5803,5804,5805,5806,5807,5808,5809,5810,5811,5812,5813,5814,5815,5816,5817,5818,5819,5820,5821,5822,5823,5824,5825,5826,5827,5828,5829,5830,5831,5832,5833,5834,5835,5836,5837,5838,5839],"revision_id":1762878},"mentions":[{"id":"c-nanqishu-054-recluses-complete:p039:m0002","start":2,"end":4,"surface":"榮緒","kind":"person","person_id":"nzb_dy0_0ry","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-054-recluses-complete","book_id":"b-nanqishu-054","work_id":"w-nanqishu","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:p040","text":"　　純篤好學，括東西晉爲一書，紀、錄、志、傳百一十卷。隱居京口教授。南徐州辟西曹，舉秀才，不就。太祖爲揚州，徵榮緒爲主簿，不到。司徒褚淵少時嘗命駕尋之。建元中，啟太祖曰：「榮緒，朱方隱者。昔臧質在宋，以國戚出牧彭岱，引爲行佐，非其所好，謝疾求免。蓬廬守志，漏濕是安，灌蔬終老。與友關康之沈深典素，追古著書，撰《晉史》十袠，贊論雖無逸才，亦足彌綸一代。臣歲時往京口，早與之遇。近報其取書，始方送出，庶得備錄渠閣，採異甄善。」上答曰：「公所道臧榮緒者，吾甚志之。其有史翰，欲令入天祿，甚佳。」","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":106,"last_line":106,"raw_start":5842,"raw_end":6086,"raw_character_offsets":[5842,5843,5844,5845,5846,5847,5848,5849,5850,5851,5852,5853,5854,5855,5856,5857,5858,5859,5860,5861,5862,5863,5864,5865,5866,5867,5868,5869,5870,5871,5872,5873,5874,5875,5876,5877,5878,5879,5880,5881,5882,5883,5884,5885,5886,5887,5888,5889,5890,5891,5892,5893,5894,5895,5896,5897,5898,5899,5900,5901,5902,5903,5904,5905,5906,5907,5908,5909,5910,5911,5912,5913,5914,5915,5916,5917,5918,5919,5920,5921,5922,5923,5924,5925,5926,5927,5928,5929,5930,5931,5932,5933,5934,5935,5936,5937,5938,5939,5940,5941,5942,5943,5944,5945,5946,5947,5948,5949,5950,5951,5952,5953,5954,5955,5956,5957,5958,5959,5960,5961,5962,5963,5964,5965,5966,5967,5968,5969,5970,5971,5972,5973,5974,5975,5976,5977,5978,5979,5980,5981,5982,5983,5984,5985,5986,5987,5988,5989,5990,5991,5992,5993,5994,5995,5996,5997,5998,5999,6000,6001,6002,6003,6004,6005,6006,6007,6008,6009,6010,6011,6012,6013,6014,6015,6016,6017,6018,6019,6020,6021,6022,6023,6024,6025,6026,6027,6028,6029,6030,6031,6032,6033,6034,6035,6036,6037,6038,6039,6040,6041,6042,6043,6044,6045,6046,6047,6048,6049,6050,6051,6052,6053,6054,6055,6056,6057,6058,6059,6060,6061,6062,6063,6064,6065,6066,6067,6068,6069,6070,6071,6072,6073,6074,6075,6076,6077,6078,6079,6080,6081,6082,6083,6084,6085],"revision_id":1762878},"mentions":[{"id":"c-nanqishu-054-recluses-complete:p040:m0048","start":48,"end":50,"surface":"太祖","kind":"person","person_id":"47p_kjh_ez7","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p040:m0055","start":55,"end":57,"surface":"榮緒","kind":"person","person_id":"nzb_dy0_0ry","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p040:m0066","start":66,"end":68,"surface":"褚淵","kind":"person","person_id":"jyx_72x_8t2","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p040:m0081","start":81,"end":83,"surface":"太祖","kind":"person","person_id":"47p_kjh_ez7","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p040:m0086","start":86,"end":88,"surface":"榮緒","kind":"person","person_id":"nzb_dy0_0ry","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p040:m0095","start":95,"end":97,"surface":"臧質","kind":"person","person_id":"0zd_9uz_t7m_ABA","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p040:m0140","start":140,"end":143,"surface":"關康之","kind":"person","person_id":"2ds_6kw_g53","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p040:m0220","start":220,"end":222,"surface":"榮緒","kind":"person","person_id":"nzb_dy0_0ry","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-054-recluses-complete","book_id":"b-nanqishu-054","work_id":"w-nanqishu","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:p041","text":"　　榮緒惇愛五經，謂人曰：「昔呂尚奉丹書，武王致齋降位，李、釋教誡，竝有禮敬之儀。因甄明至道，乃著拜《五經序論》。常以宣尼生庚子日，陳《五經》拜之。自號「被褐先生」。又以飲酒亂德，言常爲誡。永明六年，卒。年七十四。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":108,"last_line":108,"raw_start":6088,"raw_end":6195,"raw_character_offsets":[6088,6089,6090,6091,6092,6093,6094,6095,6096,6097,6098,6099,6100,6101,6102,6103,6104,6105,6106,6107,6108,6109,6110,6111,6112,6113,6114,6115,6116,6117,6118,6119,6120,6121,6122,6123,6124,6125,6126,6127,6128,6129,6130,6131,6132,6133,6134,6135,6136,6137,6138,6139,6140,6141,6142,6143,6144,6145,6146,6147,6148,6149,6150,6151,6152,6153,6154,6155,6156,6157,6158,6159,6160,6161,6162,6163,6164,6165,6166,6167,6168,6169,6170,6171,6172,6173,6174,6175,6176,6177,6178,6179,6180,6181,6182,6183,6184,6185,6186,6187,6188,6189,6190,6191,6192,6193,6194],"revision_id":1762878},"mentions":[{"id":"c-nanqishu-054-recluses-complete:p041:m0002","start":2,"end":4,"surface":"榮緒","kind":"person","person_id":"nzb_dy0_0ry","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p041:m0077","start":77,"end":81,"surface":"被褐先生","kind":"person","person_id":"nzb_dy0_0ry","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-054-recluses-complete","book_id":"b-nanqishu-054","work_id":"w-nanqishu","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:p042","text":"　　初，榮緒與關康之俱隱在京口，世號爲「二隱」。康之字伯愉，河東人。世居丹徒。以墳籍爲務。四十年不出門。不應州府辟。宋太始中，徵通直郎，不就。晚以母老家貧，求爲嶺南小縣。性清約，獨處一室，稀與妻子相見。不通賔客。弟子以業傳受。尤善《左氏春秋》。太祖爲領軍，素好此學，送《春秋五經》，康之手自點定，幷得論禮記十餘條。上甚悅，寶愛之。遺詔以經本入玄宮。宋末卒。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":110,"last_line":110,"raw_start":6197,"raw_end":6375,"raw_character_offsets":[6197,6198,6199,6200,6201,6202,6203,6204,6205,6206,6207,6208,6209,6210,6211,6212,6213,6214,6215,6216,6217,6218,6219,6220,6221,6222,6223,6224,6225,6226,6227,6228,6229,6230,6231,6232,6233,6234,6235,6236,6237,6238,6239,6240,6241,6242,6243,6244,6245,6246,6247,6248,6249,6250,6251,6252,6253,6254,6255,6256,6257,6258,6259,6260,6261,6262,6263,6264,6265,6266,6267,6268,6269,6270,6271,6272,6273,6274,6275,6276,6277,6278,6279,6280,6281,6282,6283,6284,6285,6286,6287,6288,6289,6290,6291,6292,6293,6294,6295,6296,6297,6298,6299,6300,6301,6302,6303,6304,6305,6306,6307,6308,6309,6310,6311,6312,6313,6314,6315,6316,6317,6318,6319,6320,6321,6322,6323,6324,6325,6326,6327,6328,6329,6330,6331,6332,6333,6334,6335,6336,6337,6338,6339,6340,6341,6342,6343,6344,6345,6346,6347,6348,6349,6350,6351,6352,6353,6354,6355,6356,6357,6358,6359,6360,6361,6362,6363,6364,6365,6366,6367,6368,6369,6370,6371,6372,6373,6374],"revision_id":1762878},"mentions":[{"id":"c-nanqishu-054-recluses-complete:p042:m0004","start":4,"end":6,"surface":"榮緒","kind":"person","person_id":"nzb_dy0_0ry","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p042:m0007","start":7,"end":10,"surface":"關康之","kind":"person","person_id":"2ds_6kw_g53",