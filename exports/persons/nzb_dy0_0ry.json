tioned_source_ids":["s-nanqishu-054-recluses-complete-ws1762878"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-nanqishu-054-recluses-complete:source_review38-0","kind":"source_review","person_id":"nzb_dy0_0ry","source_quote":"　　臧榮緒，東莞莒人也。祖奉先，建陵令，父庸民，國子助教。","reading":"臧榮緒父庸民、祖奉先各錄所任。","note":"臧榮緒父庸民、祖奉先各錄所任。","paragraph_id":"c-nanqishu-054-recluses-complete:p038","start_codepoint":0,"end_codepoint":29,"human_reviewed":false,"chapter_id":"c-nanqishu-054-recluses-complete","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:source_review39-0","kind":"source_review","person_id":"nzb_dy0_0ry","source_quote":"　　榮緒幼孤，躬自灌園，以供祭祀。母喪後，乃著《嫡寢論》，掃灑堂宇，置筵席，朔望輙拜薦，甘珍未嘗先食。","reading":"臧榮緒以灌園供祭，母喪後撰嫡寢論，母名無載。","note":"臧榮緒以灌園供祭，母喪後撰嫡寢論，母名無載。","paragraph_id":"c-nanqishu-054-recluses-complete:p039","start_codepoint":0,"end_codepoint":51,"human_reviewed":false,"chapter_id":"c-nanqishu-054-recluses-complete","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:source_review40-0","kind":"source_review","person_id":"nzb_dy0_0ry","source_quote":"　　純篤好學，括東西晉爲一書，紀、錄、志、傳百一十卷。隱居京口教授。南徐州辟西曹，舉秀才，不就。太祖爲揚州，徵榮緒爲主簿，不到。司徒褚淵少時嘗命駕尋之。建元中，啟太祖曰：「榮緒，朱方隱者。昔臧質在宋，以國戚出牧彭岱，引爲行佐，非其所好，謝疾求免。蓬廬守志，漏濕是安，灌蔬終老。與友關康之沈深典素，追古著書，撰《晉史》十袠，贊論雖無逸才，亦足彌綸一代。臣歲時往京口，早與之遇。近報其取書，始方送出，庶得備錄渠閣，採異甄善。」上答曰：「公所道臧榮緒者，吾甚志之。其有史翰，欲令入天祿，甚佳。」","reading":"百一十卷及褚淵薦表皆繫榮緒，表中以臧質任彭岱為履歷背景。","note":"百一十卷及褚淵薦表皆繫榮緒，表中以臧質任彭岱為履歷背景。","paragraph_id":"c-nanqishu-054-recluses-complete:p040","start_codepoint":0,"end_codepoint":244,"human_reviewed":false,"chapter_id":"c-nanqishu-054-recluses-complete","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:source_review41-0","kind":"source_review","person_id":"nzb_dy0_0ry","source_quote":"　　榮緒惇愛五經，謂人曰：「昔呂尚奉丹書，武王致齋降位，李、釋教誡，竝有禮敬之儀。因甄明至道，乃著拜《五經序論》。常以宣尼生庚子日，陳《五經》拜之。自號「被褐先生」。又以飲酒亂德，言常爲誡。永明六年，卒。年七十四。","reading":"被褐先生為榮緒自號。永明六年卒，年七十四。","note":"被褐先生為榮緒自號。永明六年卒，年七十四。","paragraph_id":"c-nanqishu-054-recluses-complete:p041","start_codepoint":0,"end_codepoint":107,"human_reviewed":false,"chapter_id":"c-nanqishu-054-recluses-complete","source_id":"s-nanqishu-054-recluses-complete-ws1762878"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-qi054-zang-grandfather","subject_person_id":"nzb_dy0_0ry","object_person_id":"yx6_ao6_2mb","predicate":"grandfather","qualifiers":{"source_term":"祖奉先","lineage":"paternal"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-054","chapter_id":"c-nanqishu-054-recluses-complete","source_id":"s-nanqishu-054-recluses-complete-ws1762878","paragraph_id":"c-nanqishu-054-recluses-complete:p038","quote":"　　臧榮緒，東莞莒人也。祖奉先，建陵令，父庸民，國子助教。","subject_person_mention_id":"c-nanqishu-054-recluses-complete:p038:m0002","object_person_mention_id":"c-nanqishu-054-recluses-complete:p038:m0013"}],"status":"source_attested","interpretation_note":"祖建陵令。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"a-qi054-zang-father","subject_person_id":"nzb_dy0_0ry","object_person_id":"z6b_99m_p1s","predicate":"father","qualifiers":{"source_term":"父庸民","lineage":"paternal"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-054","chapter_id":"c-nanqishu-054-recluses-complete","source_id":"s-nanqishu-054-recluses-complete-ws1762878","paragraph_id":"c-nanqishu-054-recluses-complete:p038","quote":"　　臧榮緒，東莞莒人也。祖奉先，建陵令，父庸民，國子助教。","subject_person_mention_id":"c-nanqishu-054-recluses-complete:p038:m0002","object_person_mention_id":"c-nanqishu-054-recluses-complete:p038:m0021"}],"status":"source_attested","interpretation_note":"父國子助教。","reviewer":"C