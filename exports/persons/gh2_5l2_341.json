{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"gh2_5l2_341","canonical_person_id":"gh2_5l2_341","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["gh2_5l2_341"],"persons":[{"id":"gh2_5l2_341","label":"禹（司馬相如列傳候選）","status":"active","historicity":"legendary_tradition","aliases":[{"surface":"禹","mention_ids":["c-shiji-117-xiangru:m011-0298"]}],"evidence":[{"mention_id":"c-shiji-117-xiangru:m011-0298","chapter_id":"c-shiji-117-xiangru","paragraph_id":"c-shiji-117-xiangru:p011","quote":"禹"}]}],"source_mention_summary":[{"source_id":"s-shiji117-xiangru","work_id":"w-shiji","book_id":"b-shiji-117","chapter_id":"c-shiji-117-xiangru","mention_count":1,"mention_ids":["c-shiji-117-xiangru:m011-0298"],"paragraph_ids":["c-shiji-117-xiangru:p011"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji117-xiangru"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-117-xiangru:m011-0298","start":298,"end":299,"surface":"禹","kind":"person","person_id":"gh2_5l2_341","status":"contextual_provisional","paragraph_id":"c-shiji-117-xiangru:p011","chapter_id":"c-shiji-117-xiangru"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-117-xiangru:p011","text":"烏有先生曰：「是何言之過也！足下不遠千里，來況齊國，王悉發境內之士，而備車騎之眾，以出田，乃欲戮力致獲，以娛左右也，何名為誇哉！問楚地之有無者，原聞大國之風烈，先生之餘論也。今足下不稱楚王之德厚，而盛推雲夢以為高，奢言淫樂而顯侈靡，竊為足下不取也。必若所言，固非楚國之美也。有而言之，是章君之惡；無而言之，是害足下之信。章君之惡而傷私義，二者無一可，而先生行之，必且輕於齊而累於楚矣。且齊東陼巨海，南有琅邪，觀乎成山，射乎之罘，浮勃澥，游孟諸，邪與肅慎為鄰，右以湯穀為界，秋田乎青丘，傍徨乎海外，吞若雲夢者八九，其於胸中曾不蒂芥。若乃俶儻瑰偉，異方殊類，珍怪鳥獸，萬端鱗萃，充仞其中者，不可勝記，禹不能名，契不能計。然在諸侯之位，不敢言遊戲之樂，苑囿之大；先生又見客，是以王辭而不復，何為無用應哉！」","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m011-0000","start":0,"end":4,"surface":"烏有先生","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m011-0092","start":92,"end":94,"surface":"楚王","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m011-0298","start":298,"end":299,"surface":"禹","kind":"person","person_id":"gh2_5l2_341","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m011-0303","start":303,"end":304,"surface":"契","kind":"person","person_id":"jwt_uii_drr","status":"contextual_provisional"}],"chapter_id":"c-shiji-117-xiangru","book_id":"b-shiji-117","work_id":"w-shiji","source_id":"s-shiji117-xiangru"}],"sources":[{"chapter_id":"c-shiji-117-xiangru","work_id":"w-shiji","book_id":"b-shiji-117","source_id":"s-shiji117-xiangru","source":{"title":"史記／卷117","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷117","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷117&oldid=10371549","revision_id":10371549,"accessed_on":"2026-10-11","extent":"固定修訂全文71段，包括賦、書與末段索隱述贊。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"去header2、目錄標記及現代節標；quote模板保留全文，br轉段落；罕字模板保留第一參數字形，描述未作正文；連結保留顯示字。未核影像。 移除防轉換控制外殼，保留內字云。","note":"第58段U+E0FA私用字缺字與頌中重句原樣保存，不猜補；末段索隱述贊分層。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical"}}
