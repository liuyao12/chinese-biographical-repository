e_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-043-wangrong:p006:m0073","start":73,"end":75,"surface":"劉肇","kind":"person","person_id":"du3_ej1_q8i","status":"contextual_provisional","resolution_note":"吳石偉與皓朝/晉武帝評戎分國別與敘事先後。","paragraph_id":"c-jinshu-043-wangrong:p006","chapter_id":"c-jinshu-043-wangrong"}],"relations":[],"title_holdings":[{"id":"th-jin043-010","person_id":"du3_ej1_q8i","title":"南郡太守","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-043","chapter_id":"c-jinshu-043-wangrong","source_id":"s-jinshu-043-ws2618531-wangrong","paragraph_id":"c-jinshu-043-wangrong:p006","quote":"戎渡江，綏慰新附，宣揚威惠。吳光祿勳石偉方直，不容皓朝，稱疾歸家。戎嘉其清節，表薦之。詔拜偉為議郎，以二千石祿終其身。荊土悅服。徵為侍中。南郡太守劉肇賂戎筒中細布五十端，為司隸所糾，以知而未納，故得不坐，然議者尤之。帝謂朝臣曰：「戎之為行，豈懷私苟得，正當不欲為異耳！」帝雖以是言釋之，然為清慎者所鄙，由是損名。","person_mention_id":"c-jinshu-043-wangrong:p006:m0073"}],"attestations":[{"id":"th-jin043-010:a001","paragraph_id":"c-jinshu-043-wangrong:p006","start":69,"end":73,"surface":"南郡太守","person_mention_id":"c-jinshu-043-wangrong:p006:m0073","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"保存本傳用稱與授任動詞語境；無明確起訖年，不以年齡、平吳背景或死亡補任期。","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-043-wangrong:p006","text":"戎渡江，綏慰新附，宣揚威惠。吳光祿勳石偉方直，不容皓朝，稱疾歸家。戎嘉其清節，表薦之。詔拜偉為議郎，以二千石祿終其身。荊土悅服。徵為侍中。南郡太守劉肇賂戎筒中細布五十端，為司隸所糾，以知而未納，故得不坐，然議者尤之。帝謂朝臣曰：「戎之為行，豈懷私苟得，正當不欲為異耳！」帝雖以是言釋之，然為清慎者所鄙，由是損名。","text_layer":"received_chapter","annotation_status":"named_mentions_fir