tle_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji055-040","person_id":"ikp_b3b_9i7","surfaces":["蕭何"],"scope":"same_chapter","chapter_ids":["c-shiji-055-liu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-055-liu:p018","quote":"漢六年正月，封功臣。良未嘗有戰鬬功，高帝曰：「運籌策帷帳中，決勝千里外，子房功也。自擇齊三萬戶。」良曰：「始臣起下邳，與上會留，此天以臣授陛下。陛下用臣計，幸而時中，臣願封留足矣，不敢當三萬戶。」乃封張良為留侯，與蕭何等俱封。"},{"paragraph_id":"c-shiji-055-liu:p026","quote":"留侯從上擊代，出奇計馬邑下，及立蕭何相國，所與上從容言天下事甚衆，非天下所以存亡，故不著。留侯乃稱曰：「家世相韓，及韓滅，不愛萬金之資，為韓報讐彊秦，天下振動。今以三寸舌為帝者師，封萬戶，位列侯，此布衣之極，於良足矣。願棄人間事，欲從赤松子游耳。」乃學辟穀，道引輕身。會高帝崩，呂后德留侯，乃彊食之，曰：「人生一世間，如白駒過隙，何至自苦如此乎！」留侯不得已，彊聽而食。"}],"rationale":"依明示名字、局部任事、授封及引語暫接；良久、每上冢與愛子之上排除人物短稱。老父場景的父不接張良父平；韓悼惠王不接齊王，秦王子嬰不接博浪沙秦皇帝，未名者不補姓名。神異與古代比擬不表示人物當時在場或神蹟已證。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-055-liu:p018","text":"漢六年正月，封功臣。良未嘗有戰鬬功，高帝曰：「運籌策帷帳中，決勝千里外，子房功也。自擇齊三萬戶。」良曰：「始臣起下邳，與上會留，此天以臣授陛下。陛下用臣計，幸而時中，臣願封留足矣，不敢當三萬戶。」乃封張良為留侯，與蕭何等俱封。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-055-liu:m018-0007","start":7,"end":9,"surface":"功臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者、書名署稱、神異所指或代詞待覆核，不補姓名或未見家屬。"},{"id":"c-shiji-055-liu:m018-0010","start":10,"end":11,"surface":"良","kind":"person","person_id":"31t_28w_hda_A","status":"contextual_provisional"},{"id":"c-shiji-055-liu:m018-0018","start":18,"end":20,"surface":"高帝","kind":"person","person_id":"aae_mkd_tas","status":"contextual_provisional"},{"id":"c-shiji-055-liu:m018-0036","start":36,"end":38,"surface":"子房","kind":"person","person_id":"31t_28w_hda_A","status":"contextual_provisional"},{"id":"c-shiji-055-liu:m018-0049","start":49,"end":50,"surface":"良","kind":"person","person_id":"31t_28w_hda_A","status":"contextual_provisional"},{"id":"c-shiji-055-liu:m018-0060","start":60,"end":61,"surface":"上","kind":"person","pe