ths":[],"mentions":[{"id":"c-jinshu-060-suojing:p001:m0045","surface":"索永","start":45,"end":47,"person_id":"77o_mvu_t8k","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-060-suojing:p001","chapter_id":"c-jinshu-060-suojing"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-060-suojing:p001","text":"索靖，字幼安，敦煌人也。累世官族，父湛，北地太守。靖少有逸群之量，與鄉人泛衷、張甝、索紾、索永俱詣太學，馳名海內，號稱「敦煌五龍」。四人並早亡，唯靖該博經史，兼通內緯。州辟別駕，郡舉賢良方正，對策高第。傅玄、張華與靖一面，皆厚與之相結。拜駙馬都尉，出為西域戊己校尉長史。太子僕同郡張勃特表，以靖才藝絕人，宜在臺閣，不宜遠出邊塞。武帝納之，擢為尚書郎。與襄陽羅尚、河南潘岳、吳郡顧榮同官，咸器服焉。靖與尚書令衛瓘俱以善草書知名，帝愛之。瓘筆勝靖，然有楷法，遠不能及靖。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":99,"last_line":99,"raw_start":8391,"raw_end":8626,"raw_character_offsets":[8393,8394,8395,8396,8397,8398,8399,8400,8401,8402,8403,8404,8405,8406,8407,8408,8409,8410,8411,8412,8413,8414,8415,8416,8417,8418,8419,8420,8421,8422,8423,8424,8425,8426,8427,8428,8429,8430,8431,8432,8433,8434,8435,8436,8437,8438,8439,8440,8441,8442,8443,8444,8445,8446,8447,8448,8449,8450,8451,8452,8453,8454,8455,8456,8457,8458,8459,8460,8461,8462,8463,8464,8465,8466,8467,8468,8469,8470,8471,8472,8473,8474,8475,8476,8477,8478,8479,8480,8481,8482,8483,8484,8485,8486,8487,8488,8489,8490,8491,8492,8493,8494,8495,8496,8497,8498,8499,8500,8501,8502,8503,8504,8505,8506,8507,8508,8509,8510,8511,8512,8513,8514,8515,8516,8517,8518,8519,8520,8521,8522,8523,8524,8525,8526,8527,8528,8529,8530,8531,8532,8533,8534,8535,8536,8537,8538,8539,8540,8541,8542,8543,8544,8545,8546,8547,8548,8549,8550,8551,8552,8553,8554,8555,8556,8557,8558,8559,8560,8561,8562,8563,8564,8565,8566,8567,8568,8569,8570,8571,8572,8573,8574,8575,8576,8577,8578,8579,8580,8581,8582,8583,8584,8585,8586,8587,8588,8589,8590,8591,8592,8593,8594,8595,8596,8597,8598,8599,8600,8601,8602,8603,8604,860