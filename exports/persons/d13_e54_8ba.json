_ai_required":false},"family_paths":[],"mentions":[{"id":"c-liangshu-016-zhangji:p002:m0406","start":406,"end":408,"surface":"江淹","kind":"person","person_id":"d13_e54_8ba","status":"contextual_provisional","paragraph_id":"c-liangshu-016-zhangji:p002","chapter_id":"c-liangshu-016-zhangji"},{"start":90,"end":92,"surface":"江淹","kind":"person","person_id":"d13_e54_8ba","status":"contextual_provisional","id":"c-nanqishu-034-yugaozhi:line066:m0090","paragraph_id":"c-nanqishu-034-yugaozhi:line066","chapter_id":"c-nanqishu-034-yugaozhi"},{"id":"c-nanqishu-043-xieyue:p008:m0028","start":28,"end":30,"surface":"江淹","kind":"person","person_id":"d13_e54_8ba","status":"contextual_provisional","interpretation_note":"原文具名或局部代稱；身份依全傳及具體來源橋接，不按同字跨世代配人。","identity_decision_id":"d-nanqi043-xieyue-jiangyan","paragraph_id":"c-nanqishu-043-xieyue:p008","chapter_id":"c-nanqishu-043-xieyue"}],"relations":[],"title_holdings":[{"id":"th-liangshu-016-zhangji-2-403","title":"兼衛尉","kind":"office","mode":"attestation","person_id":"d13_e54_8ba","attestations":[{"id":"th-liangshu-016-zhangji-2-403:a","paragraph_id":"c-liangshu-016-zhangji:p002","start":403,"end":406,"surface":"兼衛尉","person_mention_id":"c-liangshu-016-zhangji:p002:m0406","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-016","chapter_id":"c-liangshu-016-zhangji","source_id":"s-liangshu-016-zhangji-ws1508503","paragraph_id":"c-liangshu-016-zhangji:p002","quote":"齊永明中，爲剡縣令，略不視事，多爲山水遊。會賊唐㝢之作亂，稷率厲縣人，保全縣境。入爲太子洗馬，大司馬東曹掾，建安王友，大司馬從事中郎。武陵王曅爲護軍，轉護軍司馬，尋爲本州治中。明帝領牧，仍爲別駕。時魏寇壽春，以稷爲寧朔將軍、軍主，副尚書僕射沈文季鎮豫州。魏衆稱百萬，圍城累日，時經略處分，文季悉委稷焉。軍退，遷平西司馬、寧朔將軍、南平內史。魏又寇雍州，詔以本號都督荊、雍諸軍事。時雍州刺史曹虎度樊城岸，以稷知州事。魏師退，稷還荊州，就拜黃門侍郎，復爲司馬、新興、永寧二郡太守。郡犯私諱，改永寧爲長寧。尋遷司徒司馬，加輔國將軍。及江州刺史陳顯達舉兵反，以本號鎮歷陽、南譙二郡太守，遷鎮南長史、尋陽太守、輔國將軍、行江州事。尋徵還，爲持節、輔國將軍、都督北徐州諸軍事、北徐州刺史。出次白下，仍遷都督南兗州諸軍事、南兗州刺史。俄進督北徐、徐、兗、青、冀五州諸軍事，將軍並如故。永元末，徵爲侍中，宿衛宮城。義師至，兼衛尉江淹出奔。稷兼衛尉，副王瑩都督城內諸軍事。","person_mention_id":"c-liangshu-016-zhangji:p002:m0406"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-nanqi043-xieyue-jiangyan","person_id":"d13_e54_8ba","surfaces":["江淹"],"scope":"cross_chapter","chapter_ids":["c-nanqishu-043-xieyue","c-nanqishu-034-yugaozhi"],"status":"contextual_provisional","evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-043","chapter_id":"c-nanqishu-043-xieyue","source_id":"s-nanqishu043-ws2400356","paragraph_id":"c-nanqishu-043-xieyue:p008","quote":"世祖嘗問王儉，當今誰能爲五言詩？儉對曰：「謝朏得父膏腴；江淹有意。」上起禪靈寺，勑𤅢撰碑文。"},{"work_id":"w-nanqishu","book_id":"b-nanqishu-034","source_id":"s-nanqishu-034-yugaozhi","chapter_id":"c-nanqishu-034-yugaozhi","paragraph_id":"c-nanqishu-034-yugaozhi:line066","quote":"杲之風範和潤，善音吐。世祖令對虜使，兼侍中。上每嘆其風器之美，王儉在座，曰：「杲之爲蟬冕所照，更生風采。陛下故當與其卽眞。」帝意未用也。永明中，諸王年少，不得妄與人接，敕杲之與濟陽江淹五日一詣諸王，使申游好。尋又遷廬陵王中軍長史，遷尚書吏部郎，參大選事。轉太子右衛率，加通直常侍。"}],"rationale":"末世祖五言詩問答直名江淹，既錄齊034永明中世祖勑庾杲之與濟陽江淹交諸王；同一帝朝具名文士角色，重用江淹。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null}],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-016-zhangji:p002","text":"齊永明中，爲剡縣令，略不視事，多爲山水遊。會賊唐㝢之作亂，稷率厲縣人，保全縣境。入爲太子洗馬，大司馬東曹掾，建安王友，大司馬從事中郎。武陵王曅爲護軍，轉護軍司馬，尋爲本州治中。明帝領牧，仍爲別駕。時魏寇壽春，以稷爲寧朔將軍、軍主，副尚書僕射沈文季鎮豫州。魏衆稱百萬，圍城累日，時經略處分，文季悉委稷焉。軍退，遷平西司馬、寧朔將軍、南平內史。魏又寇雍州，詔以本號都督荊、雍諸軍事。時雍州刺史曹虎度樊城岸，以稷知州事。魏師退，稷還荊州，就拜黃門侍郎，復爲司馬、新興、永寧二郡太守。郡犯私諱，改永寧爲長寧。尋遷司徒司馬，加輔國將軍。及江州刺史陳顯達舉兵反，以本號鎮歷陽、南譙二郡太守，遷鎮南長史、尋陽太守、輔國將軍、行江州事。尋徵還，爲持節、輔國將軍、都督北徐州諸軍事、北徐州刺史。出次白下，仍遷都督南兗州諸軍事、南兗州刺史。俄進督北徐、徐、兗、青、冀五州諸軍事，將軍並如故。永元末，徵爲侍中，宿衛宮城。義師至，兼衛尉江淹出奔。稷兼衛尉，副王瑩都督城內諸軍事。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":32,"last_line":32,"raw_start":1983,"raw_end":2410,"raw_character_offsets":[1983,1984,1985,1