mily_paths":[],"mentions":[{"id":"c-jinshu-054-lu-yun:p006:m0060","start":60,"end":61,"surface":"該","kind":"person","person_id":"r6s_4gs_pdn","status":"contextual_provisional","paragraph_id":"c-jinshu-054-lu-yun:p006","chapter_id":"c-jinshu-054-lu-yun"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-054-lu-yun:p006","text":"伏見令書，以部曲將李咸、馮南、司馬吳定、給使徐泰等覆校諸官市買錢帛簿。臣愚以聖德龍興，光有大國，選眾官材，庶工肄業。中尉該、大農誕皆清廉淑慎，恪居所司，其下眾官，悉州閭一介，疏暗之咎，雖可日聞，至於處義用情，庶無大戾。今咸、南軍旅小人，定、泰士卒廝賤，非有清慎素著，忠公足稱。大臣所關，猶謂未詳，咸等督察，然後得信，既非開國勿用之義，又傷殿下推誠曠蕩之量。雖使咸等能盡節益國，而功利百倍，至於光輔國美，猶未若開懷信士之無失。況所益不過姑息之利，而使小人用事，大道陵替，此臣所以慷慨也。臣備位大臣，職在獻可，苟有管見，敢不盡規。愚以宜發明令，罷此等覆察，眾事一付治書，則大信臨下，人思盡節矣。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":86,"last_line":86,"raw_start":8699,"raw_end":8994,"raw_character_offsets":[8699,8700,8701,8702,8703,8704,8705,8706,8707,8708,8709,8710,8711,8712,8713,8714,8715,8716,8717,8718,8719,8720,8721,8722,8723,8724,8725,8726,8727,8728,8729,8730,8731,8732,8733,8734,8735,8736,8737,8738,8739,8740,8741,8742,8743,8744,8745,8746,8747,8748,8749,8750,8751,8752,8753,8754,8755,8756,8757,8758,8759,8760,8761,8762,8763,8764,8765,8766,8767,8768,8769,8770,8771,8772,8773,8774,8775,8776,8777,8778,8779,8780,8781,8782,8783,8784,8785,8786,8787,8788,8789,8790,8791,8792,8793,8794,8795,8796,8797,8798,8799,8800,8801,8802,8803,8804,8805,8806,8807,8808,8809,8810,8811,8812,8813,8814,8815,8816,8817,8818,8819,8820,8821,8822,8823,8824,8825,8826,8827,8828,8829,8830,8831,8832,8833,8834,8835,8836,8837,8838,8839,8840,8841,8842,8843,8844,8845,8846,8847,8848,8849,8850,8851,8852,8853,8854,8855,8856,8857,8858,8859,8860,8861,8862,8863,8864,8865,8866,8867,8868,8869,8870,8871,8872,8873,8874,8875,8876,8877,8878,8879,8880,8881,8882,8883,8884,8885,8886,8887,8888,8889,8890,8891,8892,8893,8894,8895,8896,8897,8898