ll_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-104-tianshu:m012-0046","start":46,"end":48,"surface":"趙禹","kind":"person","person_id":"3xa_jvi_o6n","status":"contextual_provisional","paragraph_id":"c-shiji-104-tianshu:p012","chapter_id":"c-shiji-104-tianshu"},{"id":"c-shiji-104-tianshu:m012-0063","start":63,"end":65,"surface":"趙禹","kind":"person","person_id":"3xa_jvi_o6n","status":"contextual_provisional","paragraph_id":"c-shiji-104-tianshu:p012","chapter_id":"c-shiji-104-tianshu"},{"id":"c-shiji-104-tianshu:m012-0066","start":66,"end":68,"surface":"趙禹","kind":"person","person_id":"3xa_jvi_o6n","status":"contextual_provisional","paragraph_id":"c-shiji-104-tianshu:p012","chapter_id":"c-shiji-104-tianshu"},{"id":"c-shiji-104-tianshu:m012-0086","start":86,"end":88,"surface":"趙禹","kind":"person","person_id":"3xa_jvi_o6n","status":"contextual_provisional","paragraph_id":"c-shiji-104-tianshu:p012","chapter_id":"c-shiji-104-tianshu"},{"id":"c-shiji-104-tianshu:m012-0184","start":184,"end":186,"surface":"趙禹","kind":"person","person_id":"3xa_jvi_o6n","status":"contextual_provisional","paragraph_id":"c-shiji-104-tianshu:p012","chapter_id":"c-shiji-104-tianshu"},{"id":"c-shiji-104-tianshu:m012-0239","start":239,"end":241,"surface":"趙禹","kind":"person","person_id":"3xa_jvi_o6n","status":"contextual_provisional","paragraph_id":"c-shiji-104-tianshu:p012","chapter_id":"c-shiji-104-tianshu"}],"relations":[],"title_holdings":[{"id":"th-shiji104-023","person_id":"3xa_jvi_o6n","title":"少府","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-104-tianshu","source_id":"s-shiji-104-tianshu","paragraph_id":"c-shiji-104-tianshu:p012","quote":"其後有詔募擇衛將軍舍人以為郎，將軍取舍人中富給者，令具鞌馬絳衣玉具劍，欲入奏之。會賢大夫少府趙禹來過衛將軍，將軍呼所舉舍人以示趙禹。趙禹以次問之，十餘人無一人習事有智略者。趙禹曰：「吾聞之，將門之下必有將類。傳曰『不知其君視其所使，不知其子視其所友』。今有詔舉將軍舍人者，欲以觀將軍而能得賢者文武之士也。今徒取盎人子上之，又無智略，如木偶人衣之綺繡耳，將柰之何？」於是趙禹悉召衛將軍舍人百餘人，以次問之，得田仁、任安，曰：「獨此兩人可耳，餘無可用者。」衛將軍見此兩人貧，意不平。趙禹去，謂兩人曰：「各自具樾象絳衣。」兩人對曰：「家貧無用具也。」將軍怒曰：「今兩君家自為貧，何為出此言？鞅鞅如有移德於我者，何也？」將軍不得已，上籍以聞。有詔召見衛將軍舍人，此二人前見，詔問能略相推第也。田仁對曰；「提桴鼓立軍門，使士大夫樂死戰鬬，仁不及任安。」任安對曰：「夫決嫌疑，定是非，辯治官，使百姓無怨心，安不及仁也。」武帝大笑曰：「善。」使任安護北軍，使田仁護邊田穀於河上。此兩人立名天下。"}],"attestations":[{"id":"th-shiji104-023:a001","paragraph_id":"c-shiji-104-tianshu:p012","start":44,"end":46,"surface":"少府","person_mention_id":"c-shiji-104-tianshu:m012-0046","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"正文與褚補分層保存；授官、用稱、俸秩與任務分開，未知年與終點不補造，死亡不自動終止。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji104-029","person_id":"3xa_jvi_o6n","surfaces":["趙禹"],"scope":"same_chapter","chapter_ids":["c-shiji-104-tianshu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-104-tianshu:p012","quote":"其後有詔募擇衛將軍舍人以為郎，將軍取舍人中富給者，令具鞌馬絳衣玉具劍，欲入奏之。會賢大夫少府趙禹來過衛將軍，將軍呼所舉舍人以示趙禹。趙禹以次問之，十餘人無一人習事有智略者。趙禹曰：「吾聞之，將門之下必有將類。傳曰『不知其君視其所使，不知其子視其所友』。今有詔舉將軍舍人者，欲以觀將軍而能得賢者文武之士也。今徒取盎人子上之，又無智略，如木偶人衣之綺繡耳，將柰之何？」於是趙禹悉召衛將軍舍人百餘人，以次問之，得田仁、任安，曰：「獨此兩人可耳，餘無可用者。」衛將軍見此兩人貧，意不平。趙禹去，謂兩人曰：「各自具樾象絳衣。」兩人對曰：「家貧無用具也。」將軍怒曰：「今兩君家自為貧，何為出此言？鞅鞅如有移德於我者，何也？」將軍不得已，上籍以聞。有詔召見衛將軍舍人，此二人前見，詔問能略相推第也。田仁對曰；「提桴鼓立軍門，使士大夫樂死戰鬬，仁不及任安。」任安對曰：「夫決嫌疑，定是非，辯治官，使百姓無怨心，安不及仁也。」武帝大笑曰：「善。」使任安護北軍，使田仁護邊田穀於河上。此兩人立名天下。"}],"rationale":"依本篇姓名、原稱及敘事回指暫定；褚補與正文分層，未按同名自動跨篇合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-104-tianshu:p012","text":"其後有詔募擇衛將軍舍人以為郎，將軍取舍人中富給者，令具鞌馬絳衣玉具劍，欲入奏之。會賢大夫少府趙禹來過衛將軍，將軍呼所舉舍人以示趙禹。趙禹以次問之，十餘人無一人習事有智略者。趙禹曰：「吾聞之，將門之下必有將類。傳曰『不知其君視其所使，不知其子視其所友』。今有詔舉將軍舍人者，欲以觀將軍而能