{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p002761","canonical_person_id":"s63_f1q_qe0","id_aliases":["cbr-p002761"],"identity_policy":"contextual_provisional","person_ids":["s63_f1q_qe0"],"persons":[{"id":"s63_f1q_qe0","label":"田臣思（田世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"田臣思","mention_ids":["c-shiji-046-tian:m024-0092"]}],"evidence":[{"mention_id":"c-shiji-046-tian:m024-0092","chapter_id":"c-shiji-046-tian","paragraph_id":"c-shiji-046-tian:p024","quote":"田臣思"}],"id_aliases":["cbr-p002761"]}],"source_mention_summary":[{"source_id":"s-shiji-046-tian","work_id":"w-shiji","book_id":"b-shiji-046","chapter_id":"c-shiji-046-tian","mention_count":1,"mention_ids":["c-shiji-046-tian:m024-0092"],"paragraph_ids":["c-shiji-046-tian:p024"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-046-tian"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-046-tian:m024-0092","start":92,"end":95,"surface":"田臣思","kind":"person","person_id":"s63_f1q_qe0","status":"contextual_provisional","paragraph_id":"c-shiji-046-tian:p024","chapter_id":"c-shiji-046-tian"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji046-055","person_id":"s63_f1q_qe0","scope":"same_chapter","chapter_ids":["c-shiji-046-tian"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["田臣思"],"evidence":[{"paragraph_id":"c-shiji-046-tian:p024","quote":"齊侯太公和立二年，和卒，子桓公午立。桓公午五年，秦、魏攻韓，韓求救於齊。齊桓公召大臣而謀曰：「蚤救之孰與晩救之？」騶忌曰：「不若勿救。」段干朋曰：「不救，則韓且折而入於魏，不若救之。」田臣思曰：「過矣君之謀也！秦、魏攻韓、楚，趙必救之，是天以燕予齊也。」桓公曰：「善」。乃陰告韓使者而遣之。韓自以爲得齊之救，因與秦、魏戰。楚、趙聞之，果起兵而救之。齊因起兵襲燕國，取桑丘。"}],"rationale":"限本篇明示姓名、是為、繼位及局部事件暫接；姜齊與田齊桓公、不同時段未名王及同字忌分開。孫子不先補孫臏，子守髙唐不補闕字，索隱短稱與代詞仍待核；未跨篇按同名接人。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-046-tian:p024","text":"齊侯太公和立二年，和卒，子桓公午立。桓公午五年，秦、魏攻韓，韓求救於齊。齊桓公召大臣而謀曰：「蚤救之孰與晩救之？」騶忌曰：「不若勿救。」段干朋曰：「不救，則韓且折而入於魏，不若救之。」田臣思曰：「過矣君之謀也！秦、魏攻韓、楚，趙必救之，是天以燕予齊也。」桓公曰：「善」。乃陰告韓使者而遣之。韓自以爲得齊之救，因與秦、魏戰。楚、趙聞之，果起兵而救之。齊因起兵襲燕國，取桑丘。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-046-tian:m024-0000","start":0,"end":5,"surface":"齊侯太公和","kind":"person","person_id":"zan_qcc_jy5_AAAAAABAAAA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m024-0009","start":9,"end":10,"surface":"和","kind":"person","person_id":"zan_qcc_jy5_AAAAAABAAAA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m024-0013","start":13,"end":16,"surface":"桓公午","kind":"person","person_id":"zan_qcc_jy5_AAAAAABAAAAA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m024-0018","start":18,"end":21,"surface":"桓公午","kind":"person","person_id":"zan_qcc_jy5_AAAAAABAAAAA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m024-0036","start":36,"end":39,"surface":"齊桓公","kind":"person","person_id":"zan_qcc_jy5_AAAAAABAAAAA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m024-0040","start":40,"end":42,"surface":"大臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、對話、稱謂或索隱述贊短稱待核，不補姓名及成員。"},{"id":"c-shiji-046-tian:m024-0057","start":57,"end":59,"surface":"騶忌","kind":"person","person_id":"drb_gcn_28e","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m024-0068","start":68,"end":71,"surface":"段干朋","kind":"person","person_id":"29i_iqg_x15","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m024-0092","start":92,"end":95,"surface":"田臣思","kind":"person","person_id"