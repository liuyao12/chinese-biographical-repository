emain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-108-han:m009-0058","start":58,"end":60,"surface":"李息","kind":"person","person_id":"tmv_5d7_bx2","status":"contextual_provisional","paragraph_id":"c-shiji-108-han:p009","chapter_id":"c-shiji-108-han"},{"id":"c-shiji-108-han:m009-0101","start":101,"end":103,"surface":"李息","kind":"person","person_id":"tmv_5d7_bx2","status":"contextual_provisional","paragraph_id":"c-shiji-108-han:p009","chapter_id":"c-shiji-108-han"},{"id":"c-shiji-110-xiongnu:m031-0231","start":231,"end":233,"surface":"李息","kind":"person","person_id":"gqv_af5_i2r","status":"contextual_provisional","paragraph_id":"c-shiji-110-xiongnu:p031","chapter_id":"c-shiji-110-xiongnu"}],"relations":[],"title_holdings":[{"id":"th-shiji108-029","person_id":"tmv_5d7_bx2","title":"太中大夫","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-108-han","source_id":"s-shiji-108-han","paragraph_id":"c-shiji-108-han:p009","quote":"當是時，漢伏兵車騎材官二十餘萬，匿馬邑旁谷中。衞尉李廣爲驍騎將軍，太仆公孫賀爲輕車將軍，大行王恢爲將屯將軍，太中大夫李息爲材官將軍。御史大夫韓安國爲護軍將軍，諸將皆屬護軍。約單于入馬邑而漢兵縱發。王恢、李息、李廣別從代主擊其輜重。於是單于入漢長城武州塞。未至馬邑百餘里，行掠鹵，徒見畜牧於野，不見一人。單于怪之，攻烽燧，得武州尉史。欲刺問尉史。尉史曰：「漢兵數十萬伏馬邑下。」單于顧謂左右曰：「幾爲漢所賣！」乃引兵還。出塞，曰：「吾得尉史，乃天也。」命尉史爲「天王」。塞下傳言單于已引去。漢兵追至塞，度弗及，即罷。王恢等兵三萬，聞單于不與漢合，度往擊輜重，必與單于精兵戰，漢兵勢必敗，則以便宜罷兵，皆無功。"}],"attestations":[{"id":"th-shiji108-029:a001","paragraph_id":"c-shiji-108-han:p009","start":54,"end":58,"surface":"太中大夫","person_mention_id":"c-shiji-108-han:m009-0058","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"分開既任官稱與本段將軍授任；未明年月及終止事件保持未知。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji108-030","person_id":"tmv_5d7_bx2","title":"材官將軍","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-108-han","source_id":"s-shiji-108-han","paragraph_id":"c-shiji-108-han:p009","quote":"當是時，漢伏兵車騎材官二十餘萬，匿馬邑旁谷中。衞尉李廣爲驍騎將軍，太仆公孫賀爲輕車將軍，大行王恢爲將屯將軍，太中大夫李息爲材官將軍。御史大夫韓安國爲護軍將軍，諸將皆屬護軍。約單于入馬邑而漢兵縱發。王恢、李息、李廣別從代主擊其輜重。於是單于入漢長城武州塞。未至馬邑百餘里，行掠鹵，徒見畜牧於野，不見一人。單于怪之，攻烽燧，得武州尉史。欲刺問尉史。尉史曰：「漢兵數十萬伏馬邑下。」單于顧謂左右曰：「幾爲漢所賣！」乃引兵還。出塞，曰：「吾得尉史，乃天也。」命尉史爲「天王」。塞下傳言單于已引去。漢兵追至塞，度弗及，即罷。王恢等兵三萬，聞單于不與漢合，度往擊輜重，必與單于精兵戰，漢兵勢必敗，則以便宜罷兵，皆無功。"}],"attestations":[{"id":"th-shiji108-030:a001","paragraph_id":"c-shiji-108-han:p009","start":61,"end":65,"surface":"材官將軍","person_mention_id":"c-shiji-108-han:m009-0058","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-108-han","source_id":"s-shiji-108-han","paragraph_id":"c-shiji-108-han:p009","quote":"當是時，漢伏兵車騎材官二十餘萬，匿馬邑旁谷中。衞尉李廣爲驍騎將軍，太仆公孫賀爲輕車將軍，大行王恢爲將屯將軍，太中大夫李息爲材官將軍。御史大夫韓安國爲護軍將軍，諸將皆屬護軍。約單于入馬邑而漢兵縱發。王恢、李息、李廣別從代主擊其輜重。於是單于入漢長城武州塞。未至馬邑百餘里，行掠鹵，徒見畜牧於野，不見一人。單于怪之，攻烽燧，得武州尉史。欲刺問尉史。尉史曰：「漢兵數十萬伏馬邑下。」單于顧謂左右曰：「幾爲漢所賣！」乃引兵還。出塞，曰：「吾得尉史，乃天也。」命尉史爲「天王」。塞下傳言單于已引去。漢兵追至塞，度弗及，即罷。王恢等兵三萬，聞單于不與漢合，度往擊輜重，必與單于精兵戰，漢兵勢必敗，則以便宜罷兵，皆無功。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"分開既任官稱與本段將軍授任；未明年月及終止事件保持未知。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji110-084","person_id":"gqv_af5_i2r","title":"將軍","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-110-xiongnu","source_id":"s-shiji110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p031","quote":"自馬邑軍後五年之秋，漢使四將軍各萬騎擊胡關市下。將軍衛青出上谷，至蘢城，得胡首虜七百人。公孫賀出雲中，無所得。公孫敖出代郡，爲胡所敗七千餘人。李廣出鴈門，爲胡所敗，而匈奴生得廣，廣後得亡歸。漢囚敖、廣，敖、廣贖爲庶人。其冬，匈奴數入盜邊，漁陽尤甚。漢使將軍韓安國屯漁陽備胡。其明年秋，匈奴二萬騎入漢，殺遼西太守，略二千餘人。胡又入敗漁陽太守軍千餘人，圍漢將軍安國，安國時千餘騎亦且盡，會燕救至，匈奴乃去。匈奴又入鴈門，殺略千餘人。於是漢使將軍衛青將三萬騎出鴈門，李息出代郡，擊胡。得首虜數千人。其明年，衛青復出雲中以西至隴西，擊胡之樓煩、白羊王於河南，得胡首虜數千，牛羊百餘萬。於是漢遂取河南地，築朔方，復繕故秦時蒙恬所爲塞，因河爲固。漢亦棄上谷之什辟縣造陽地以予胡。是歳，漢之元朔二年也。"}],"attestations":[{"id":"th-shiji110-084:a001","paragraph_id":"c-shiji-110-xiongnu:p031","start":219,"end":221,"surface":"將軍","person_mention_id":"c-shiji-110-xiongnu:m031-0231","usage":"narrative","date_expression":"其明年秋","normalized_dat