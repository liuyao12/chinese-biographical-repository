ewed":false,"evidence":[{"chapter_id":"c-shiji-060-sanwang","source_id":"s-shiji-060-sanwang","paragraph_id":"c-shiji-060-sanwang:p013","quote":"「維六年四月乙巳，皇帝使御史大夫湯廟立子旦為燕王。曰：於戲，小子旦，受茲玄社！朕承祖考，維稽古，建爾國家，封于北土，世為漢藩輔。於戲！葷粥氏虐老獸心，侵犯寇盜，加以姦巧邊萌。於戲！朕命將率徂征厥罪，萬夫長，千夫長，三十有二君皆來，降期奔師。葷粥徙域，北州以綏。悉爾心，毋作怨，毋卹德，毋乃廢備。非教士不得從徵。於戲，保國艾民，可不敬與！王其戒之。」","source_term":"皇帝使御史大夫湯廟立子旦"}],"source_assertion_id":"a-shiji060-002","interpretation_note":"以此受傳正文的明示近親主張配置局部家族；不合併跨篇候選身份、不補闕名世代，不表示遠祖世系已核實。分支字元不是長幼排行。","reviewer":"Codex（AI 代理）","parent_person_id":"oro_evn_khk"},"id_aliases":["cbr-p003648"]},{"id":"oro_evn_khk_BA","label":"安定侯子（三王世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"安定侯","mention_ids":["c-shiji-060-sanwang:m032-0028"]}],"evidence":[{"mention_id":"c-shiji-060-sanwang:m032-0028","chapter_id":"c-shiji-060-sanwang","paragraph_id":"c-shiji-060-sanwang:p032","quote":"安定侯"}],"family_path":{"connection":"father","generation_distance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-060-sanwang","source_id":"s-shiji-060-sanwang","paragraph_id":"c-shiji-060-sanwang:p032","quote":"宣帝初立，推恩宣德，以本始元年中盡復封燕王旦兩子：一子為安定侯；立燕故太子建為廣陽王，以奉燕王祭祀。","source_term":"封燕王旦兩子：一子為安定侯"}],"source_assertion_id":"a-shiji060-009","interpretation_note":"以此受傳正文的明示近親主張配置局部家族；不合併跨篇候選身份、不補闕名世代，不表示遠祖世系已核實。分支字元不是長幼排行。","reviewer":"Codex（AI 代理）","parent_person_id":"oro_evn_khk_B"},"id_aliases":["cbr-p003678"]}],"source_mention_summary":[{"source_id":"s-shiji-060-sanwang","work_id":"w-shiji","book_id":"b-shiji-060","chapter_id":"c-shiji-060-sanwang","mention_count":1,"mention_ids":["c-shiji-060-sanwang:m032-0028"],"paragraph_ids":["c-shiji-060-sanwang:p032"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-060-sanwang"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_