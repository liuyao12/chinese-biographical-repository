章紫綬，封建城縣侯，諡曰恭。追贈后母高為綏安縣君，諡曰定。廢帝即位，尊后為皇太后，宮曰安德。","subject_person_mention_id":"c-nanshi-012-shenmiaorong:p001:m0005","object_person_mention_id":"c-nanshi-012-shenmiaorong:p001:m0016","relationship_anchor":{"paragraph_id":"c-nanshi-012-shenmiaorong:p001","surface":"父法深，","start":15,"end":19}}],"status":"contextual_provisional","interpretation_note":"后父法深。","human_reviewed":false}}],"source_mention_summary":[{"source_id":"s-chenshu-028-shenmiaorong-bermao-ws2581394","work_id":"w-chenshu","book_id":"b-chenshu-028","chapter_id":"c-chenshu-028-shenmiaorong-bermao","raw_mention_count":3,"mention_ids":["c-chenshu-028-shenmiaorong-bermao:p001:m0016","c-chenshu-028-shenmiaorong-bermao:p002:m0003","c-chenshu-028-shenmiaorong-bermao:p002:m0006"],"paragraph_ids":["c-chenshu-028-shenmiaorong-bermao:p001","c-chenshu-028-shenmiaorong-bermao:p002"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-chenshu-028-shenmiaorong-bermao:p001:m0016","mention_ids":["c-chenshu-028-shenmiaorong-bermao:p001:m0016"],"kind":"paragraph"},{"canonical_mention_id":"c-chenshu-028-shenmiaorong-bermao:p002:m0003","mention_ids":["c-chenshu-028-shenmiaorong-bermao:p002:m0003"],"kind":"paragraph"},{"canonical_mention_id":"c-chenshu-028-shenmiaorong-bermao:p002:m0006","mention_ids":["c-chenshu-028-shenmiaorong-bermao:p002:m0006"],"kind":"paragraph"}],"mention_count":3,"duplicate_mention_count":0,"paragraph_occurrence_count":3,"table_occurrence_count":0,"passage_count":2,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"3處獨立位置，3個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"},{"source_id":"s-chenshu-028-shenjunli-two-princes-ws2581394","work_id":"w-chenshu","book_id":"b-chenshu-028","chapter_id":"c-chenshu-028-shenjunli-two-princes","raw_mention_count":2,"mention_ids":["c-chenshu-028-shenjunli-two-princes:p001:m0003","c-chenshu-028-shenjunli-two-princes:p001:m0006"],"paragraph_ids":["c-chenshu-028-shenjunli-two-princes:p001"],"table_cell_ids":[],"occurrence_gro