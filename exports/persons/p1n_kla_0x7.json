":"b-jinshu-059","chapter_id":"c-jinshu-059-prince-ying","source_id":"s-jinshu-059-prince-ying-ws2650517","paragraph_id":"c-jinshu-059-prince-ying:p006","quote":"永興初，左衛將軍陳眕，殿中中郎褾苞、成輔及長沙故將上官巳等，奉大駕討穎，馳檄四方，赴者雲集。軍次安陽，眾十餘萬，鄴中震懼。穎欲走，其掾步熊有道術，曰：「勿動！南軍必敗。」穎會其眾問計，東安王繇乃曰：「天子親征，宜罷甲，縞素出迎請罪。」司馬王混、參軍崔曠勸穎距戰，穎從之，乃遣奮武將軍石超率眾五萬，次於蕩陰。眕二弟匡、規自鄴赴王師，云：「鄴中皆已離散。」由是不甚設備。超眾奄至，王師敗績，矢及乘輿，侍中嵇紹死於帝側，左右皆奔散，乃棄天子于槁中。超遂奉帝幸鄴。穎改元建武，害東安王繇，署置百官，殺生自己，立郊于鄴南。","subject_person_mention_id":"c-jinshu-059-prince-ying:p006:m0156","object_person_mention_id":"c-jinshu-059-prince-ying:p006:m0008"}],"status":"source_attested","interpretation_note":"原文明言陳眕二弟。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"a-jin059-volume-chen-gui-brother","subject_person_id":"4zn_nq0_ntc","object_person_id":"p1n_kla_0x7","predicate":"brother","qualifiers":{"source_term":"眕二弟匡、規"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-059","chapter_id":"c-jinshu-059-prince-ying","source_id":"s-jinshu-059-prince-ying-ws2650517","paragraph_id":"c-jinshu-059-prince-ying:p006","quote":"永興初，左衛將軍陳眕，殿中中郎褾苞、成輔及長沙故將上官巳等，奉大駕討穎，馳檄四方，赴者雲集。軍次安陽，眾十餘萬，鄴中震懼。穎欲走，其掾步熊有道術，曰：「勿動！南軍必敗。」穎會其眾問計，東安王繇乃曰：「天子親征，宜罷甲，縞素出迎請罪。」司馬王混、參軍崔曠勸穎距戰，穎從之，乃遣奮武將軍石超率眾五萬，次於蕩陰。眕二弟匡、規自鄴赴王師，云：「鄴中皆已離散。」由是不甚設備。超眾奄至，王師敗績，矢及乘輿，侍中嵇紹死於帝側，左右皆奔散，乃棄天子于槁中。超遂奉帝幸鄴。穎改元建武，害東安王繇，署置百官，殺生自己，立郊于鄴南。","subject_person_mention_id":"c-jinshu-059-prince-ying:p006:m0158","object_person_mention_id":"c-jinshu-059-prince-ying:p006:m0008"}],"status":"source_attested","interpretation_note":"原文同列匡、規。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-059-prince-ying:p006:m0008","surface":"陳眕","start":8,"end":10,"person_id":"p1n_kla_0x7","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-059-prince-ying:p006","chapter_id":"c-jinshu-059-prince-ying"},{"id":"