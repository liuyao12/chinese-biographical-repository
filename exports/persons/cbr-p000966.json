ntion_ids":["c-shiji-012-wudi:m006-0135"],"paragraph_ids":["c-shiji-012-wudi:p006"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-011-jingdi","s-shiji-012-wudi"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-011-jingdi:m017-0114","start":114,"end":116,"surface":"弟蚡","kind":"person","person_id":"cbr-p000966","status":"contextual_provisional","paragraph_id":"c-shiji-011-jingdi:p017","chapter_id":"c-shiji-011-jingdi"},{"id":"c-shiji-012-wudi:m006-0135","start":135,"end":138,"surface":"武安侯","kind":"person","person_id":"cbr-p000966","status":"contextual_provisional","paragraph_id":"c-shiji-012-wudi:p006","chapter_id":"c-shiji-012-wudi"}],"relations":[{"id":"a-shiji011-012","subject_person_id":"cbr-p000966","predicate":"brother","object_person_id":"cbr-p000950","status":"source_attested","evidence":[{"chapter_id":"c-shiji-011-jingdi","source_id":"s-shiji-011-jingdi","paragraph_id":"c-shiji-011-jingdi:p017","quote":"後三年十月，日月皆（食）赤五日。十二月晦，雷。日如紫。五星逆行守太微。月貫天廷中。正月甲寅，皇太子冠。甲子，孝景皇帝崩。遺詔賜諸侯王以下至民為父後爵一級，天下戶百錢。出宮人歸其家，復無所與。太子即位，是為孝武皇帝。三月，封皇太后弟蚡為武安侯，弟勝為周陽侯。置陽陵。"}],"qualifiers":{"source_term":"弟","historicity":"historical_tradition"},"interpretation_note":"僅保存來源明示關係，不補未見姓名、闕代或同父同母。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji011-014","person_id":"cbr-p000966","title":"武安侯","kind":"noble_rank","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-011-jingdi","source_id":"s-shiji-011-jingdi","paragraph_id":"c-shiji-011-jingdi:p017","quote":"三月，封皇太后弟蚡為武安侯"}],"attestations":[{"id":"th-shiji011-014:a001","paragraph_id":"c-shiji-011-jingdi:p017","start":117,"end":120,"surface":"武安侯","person_mention_id":"c-shiji-011-jingdi:m017-0114","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":"三月","evidence":[{"chapter_id":"c-shiji-011-jingdi","source_id":"s-shiji-011-jingdi","paragraph_id":"c-shiji-011-jingdi:p017","quote":"三月，封皇太后弟蚡為武安侯"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予／貶降、用稱與有效時段分開；日期原表述未換算，未知端點不當無限延伸，不以死亡補終止。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji012-007","person_id":"cbr-p000966","surfaces":["武安侯"],"scope":"cross_chapter","chapter_ids":["c-shiji-011-jingdi","c-shiji-012-wudi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-011-jingdi:p017","quote":"後三年十月，日月皆（食）赤五日。十二月晦，雷。日如紫。五星逆行守太微。月貫天廷中。正月甲寅，皇太子冠。甲子，孝景皇帝崩。遺詔賜諸侯王以下至民為父後爵一級，天下戶百錢。出宮人歸其家，復無所與。太子即位，是為孝武皇帝。三月，封皇太后弟蚡為武安侯，弟勝為周陽侯。置陽陵。"},{"paragraph_id":"c-shiji-012-wudi:p006","quote":"是時而李少君亦以祠灶、穀道、卻老方見上，上尊之。少君者，故深澤侯入以主方。匿其年及所生長，常自謂七十，能使物，卻老。其游以方遍諸侯。無妻子。人聞其能使物及不死，更饋遺之，常餘金錢帛衣食。人皆以為不治產業而饒給，又不知其何所人，愈信，爭事之。少君資好方，善為巧發奇中。嘗從武安侯飲，坐中有年九十餘老人，少君乃言與其大父游射處，老人為兒時從其大父行，識其處，一坐盡驚。少君見上，上有故銅器，問少君。少君曰：「此器齊桓公十年陳於柏寢。」已而案其刻，果齊桓公器。一宮盡駭，以少君為神，數百歲人也。"}],"rationale":"按開篇景帝子、王太后與皇子分封／繼位敘事，以及本段方士、祠事或飲宴語境暫定異稱；同名不全域合併。平原君另建候選，不與戰國人物合併；神異引語不作史實背書。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-011-jingdi:p017","text":"後三年十月，日月皆（食）赤五日。十二月晦，雷。日如紫。五星逆行守太微。月貫天廷中。正月甲寅，皇太子冠。甲子，孝景皇帝崩。遺詔賜諸侯王以下至民為父後爵一級，天下戶百錢。出宮人歸其家，復無所與。太子即位，是為孝武皇帝。三月，封皇太后弟蚡為武安侯，弟勝為周陽侯。置陽陵。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-011-jingdi:m017-0046","start":46,"end":49,"surface":"皇太子","kind":"person","person_id":"cbr-p000941","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m017-0054","start":54,"end":58,"surface":"孝景皇帝","kind":"person","person_id":"cbr-p000889","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m017-0095","start":95,"end":97,"surface":"太子","kind":"person","person_id":"cbr-p000941","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m017-0102","start":102,"end":106,"surface":"孝武皇帝","kind":"person","person_id":"cbr-p000941","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m017-0111","start":111,"end":114,"surface":"皇太后","kind":"person","person_id":"cbr-p000950","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m017-0114","start":114,"end":116,"surface":"弟蚡","kind":"person","person_id":"cbr-p000966","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m017-0121","start":121,"end":123,"surface":"弟勝","kind":"person","person_id":"cbr-p000967","status":"contextual_provisional"}],"chapter_id":"c-shiji-011-jingdi","book_id":"b-shiji-011","work_id":"w-shiji","source_id":"s-shiji-011-jingdi"},{"id":"c-shiji-012-wudi:p006","text":"是時而李少君亦以祠灶、穀道、卻老方見上，上尊之。少君者，故深澤侯入以主方。匿其年及所生長，常自謂七十，能使物，卻老。其游以方遍諸侯。無妻子。人聞其能使物及不死，更饋遺之，常餘金錢帛衣食。人皆以為不治產業而饒給，又不知其何所人，愈信，爭事之。少君資好方，善為巧發奇中。嘗從武安侯飲，坐中有年九十餘老人，少君乃言與其大父游射處，老人為兒時從其大父行，識其處，一坐盡驚。少君見上，上有故銅器，問少君。少君曰：「此器齊桓公十年陳於柏寢。」已而案其刻，果齊桓公器。一宮盡駭，以少君為神，數百歲人也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-012-wudi:m006-0003","start":3,"end":6,"surface":"李少君","kind":"person","person_id":"cbr-p000975","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m006-0018","start":18,"end":19,"surface":"上","kind":"person","person_id":"cbr-p000941","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m006-0020","start":20,"end":21,"surface":"上","kind":"person","person_id":"cbr-p000941","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m006-0024","start":24,"end":26,"surface":"少君","kind":"person","person_id":"cbr-p000975","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m006-0029","start":29,"end":33,"surface":"深澤侯入","kind":"person","person_id":"cbr-p000976","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m006-0120","start":120,"end":122,"surface":"少君","kind":"person","person_id":"cbr-p000975","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m006-0135","start":135,"end":138,"surface":"武安侯","kind":"person","person