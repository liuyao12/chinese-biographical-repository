","kind":"person","person_id":"jza_af1_m41","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m011-0551","start":551,"end":552,"surface":"盎","kind":"person","person_id":"jza_af1_m41","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m011-0563","start":563,"end":564,"surface":"盎","kind":"person","person_id":"jza_af1_m41","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m011-0576","start":576,"end":577,"surface":"盎","kind":"person","person_id":"jza_af1_m41","status":"contextual_provisional"}],"chapter_id":"c-shiji-106-wuwang","book_id":"b-shiji-106","work_id":"w-shiji","source_id":"s-shiji-106-wuwang"},{"id":"c-shiji-106-wuwang:p021","text":"吳楚輕悍，王濞倍德。富因采山，釁成提局。憍矜貳志，連結七國。嬰命始監，錯誅未塞。天之悔禍，卒取奔北。","annotation_status":"named_mentions_first_pass","text_layer":"witness_appended_suoyin_zan","mentions":[{"id":"c-shiji-106-wuwang:m021-0006","start":6,"end":7,"surface":"濞","kind":"person","person_id":"dlg_vnw_1bi_A","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m021-0030","start":30,"end":31,"surface":"嬰","kind":"person","person_id":"kib_dnn_k5c","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m021-0035","start":35,"end":36,"surface":"錯","kind":"person","person_id":"7md_vp9_mh6","status":"contextual_provisional"}],"chapter_id":"c-shiji-106-wuwang","book_id":"b-shiji-106","work_id":"w-shiji","source_id":"s-shiji-106-wuwang"}],"sources":[{"chapter_id":"c-shiji-011-jingdi","work_id":"w-shiji","book_id":"b-shiji-011","source_id":"s-shiji-011-jingdi","source":{"title":"史記／卷011","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷011","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷011&oldid=2520527","revision_id":2520527,"accessed_on":"2026-10-09","extent":"本篇18個p區塊，自孝景皇帝者至太史公論贊；排除跨站導覽dd、索隱述贊及其後現代版權告示。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],