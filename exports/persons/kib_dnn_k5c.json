on","person_id":"04u_gq0_nke_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m012-0139","start":139,"end":140,"surface":"盎","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m012-0146","start":146,"end":147,"surface":"錯","kind":"person","person_id":"04u_gq0_nke_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m012-0153","start":153,"end":155,"surface":"袁盎","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m012-0164","start":164,"end":165,"surface":"錯","kind":"person","person_id":"04u_gq0_nke_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m012-0170","start":170,"end":171,"surface":"錯","kind":"person","person_id":"04u_gq0_nke_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m012-0190","start":190,"end":192,"surface":"袁盎","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m012-0196","start":196,"end":198,"surface":"竇嬰","kind":"person","person_id":"2uk_ay7_hjf","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m012-0214","start":214,"end":224,"surface":"諸陵長者長安中賢大夫","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、學說合稱、典故或待辨匿名指代，未補成員及姓名。"}],"chapter_id":"c-shiji-101-yuanchao","book_id":"b-shiji-101","work_id":"w-shiji","source_id":"s-shiji-101-yuanchao"},{"id":"c-shiji-101-yuanchao:p019","text":"遷為御史大夫，請諸侯之罪過，削其地，收其枝郡。奏上，上令公卿列侯宗室集議，莫敢難，獨竇嬰爭之，由此與錯有卻。錯所更令三十章，諸侯皆諠譁疾鼂錯。錯父聞之，從潁川來，謂錯曰：「上初即位，公為政用事，侵削諸侯，別疏人骨肉，人口議多怨公者，何也？」鼂錯曰：「固也。不如此，天子不尊，宗廟不安。」錯父曰：「劉氏安矣，而鼂氏危矣，吾去公歸矣！」遂飲藥死，曰：「吾不忍見禍及吾身。」死十餘日，吳楚七國果反，以誅錯為名。及竇嬰、袁盎進說，上令鼂錯衣朝衣斬東市。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-101-yuanchao:m019-0026","start":26,"end":27,"surface":"上","kind":"person","person_id":"etc_iw9_5so","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m019-0028","start":28,"end":34,"surface":"公卿列侯宗室","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、學說合稱、典故或待辨匿名指代，未補成員及姓名。"},{"id":"c-shiji-101-yuanchao:m019-0042","start":42,"end":44,"surface":"竇嬰","kind":"person","person_id":"2uk_ay7_hjf","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m019-0050","start":50,"end":51,"surface":"錯","kind":"person","person_id":"04u_gq0_nke_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m019-0054","start":54,"end":55,"surface":"錯","kind":"person","person_id":"04u_gq0_nke_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m019-0068","start":68,"end":70,"surface":"鼂錯","kind":"person","person_id":"04u_gq0_nke_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m019-0071","start":71,"end":72,"surface":"錯","kind":"person","person_id":"04u_gq0_nke_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m019-0072","start":72,"end":73,"surface":"父","kind":"person","person_id":"04u_gq0_nke","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m019-0082","start":82,"end":83,"surface":"錯","kind":"person","person_id":"04u_gq0_nke_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m019-0086","start":86,"end":87,"surface":"上","kind":"person","person_id":"etc_iw9_5so","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m019-0120","start":120,"end":122,"surface":"鼂錯","kind":"person","person_id":"04u_gq0_nke_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m019-0143","start":143,"end":144,"surface":"錯","kind":"person","person_id":"04u_gq0_nke_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m019-0144","start":144,"end":145,"surface":"父","kind":"person","person_id":"04u_gq0_nke","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m019-0148","start":148,"end":150,"surface":"劉氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、學說合稱、典故或待辨匿名指代，未補成員及姓名。"},{"id":"c-shiji-101-yuanchao:m019-0154","start":154,"end":156,"surface":"鼂氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、學說合稱、典故或待辨匿名指代，未補成員及姓名。"},{"id":"c-shiji-101-yuanchao:m019-0198","start":198,"end":199,"surface":"錯","kind":"person","person_id":"04u_gq0_nke_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m019-0203","start":203,"end":205,"surface":"竇嬰","kind":"person","person_id":"2uk_ay7_hjf","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m019-0206","start":206,"end":208,"surface":"袁盎","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m019-0211","start":211,"end":212,"surface":"上","kind":"person","person_id":"etc_iw9_5so","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m019-0213","start":213,"end":215,"surface":"鼂錯","kind":"person","person_id":"04u_gq0_nke_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-101-yuanchao","book_id":"b-shiji-101","work_id":"w-shiji","source_id":"s-shiji-101-yuanchao"},{"id":"c-shiji-106-wuwang:p010","text":"七國反書聞天子，天子乃遣太尉條侯周亞夫將三十六將軍，往擊吳楚；遣曲周侯酈寄擊趙；將軍欒布擊齊；大將軍竇嬰屯滎陽，監齊趙兵。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-106-wuwang:m010-0014","start":14,"end":16,"surface":"條侯","kind":"person","person_id":"t3i_l5f_u0p_A","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m010-0016","start":16,"end":19,"surface":"周亞夫","kind":"person","person_id":"t3i_l5f_u0p_A","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m010-0035","start":35,"end":37,"surface":"酈寄","kind":"person","person_id":"syn_6p6_j5m","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m010-0042","start":42,"end":44,"surface":"欒布","kind":"person","person_id":"iry_fvs_zxc","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m010-0050","start":50,"end":52,"surface":"竇嬰","kind":"person","person_id":"kib_dnn_k5c","status":"contextual_provisional"}],"chapter_id":"c-shiji-106-wuwang","book_id":"b-shiji-106","work_id":"w-shiji","source_id":"s-shiji-106-wuwang"},{"id":"c-shiji-106-wuwang:p011","text":"吳楚反書聞，兵未發，竇嬰未行，言故吳相袁盎。盎時家居，詔召入見。上方與晁錯調兵笇軍食，上問袁盎曰：「君嘗為吳相，知吳臣田祿伯為人乎？今吳楚反，於公何如？」對曰：「不足憂也，今破矣。」上曰：「吳王即山鑄錢，煮海水為鹽，誘天下豪桀，白頭舉事。若此，其計不百全，豈發乎？何以言其無能為也？」袁盎對曰：「吳有銅鹽利則有之，安得豪桀而誘之！誠令吳得豪桀，亦且輔王為義，不反矣。吳所誘皆無賴子弟，亡命鑄錢姦人，故相率以反。」晁錯曰：「袁盎策之善。」上問曰：「計安出？」盎對曰：「願屏左右。」上屏人，獨錯在。盎曰：「臣所言，人臣不得知也。」乃屏錯。錯趨避東廂，恨甚。上卒問盎，盎對曰：「吳楚相遺書，曰『高帝王子弟各有分地，今賊臣晁錯擅適過諸侯，削奪之地』。故以反為名，西共誅晁錯，復故地而罷。方今計獨斬晁錯，發使赦吳楚七國，復其故削地，則兵可無血刃而俱罷。」於是上嘿然良久，曰：「顧誠何如，吾不愛一人以謝天下。」盎曰：「臣愚計無出此，願上孰計之。」乃拜盎為太常，吳王弟子德侯為宗正。盎裝治行。後十餘日，上使中尉召錯，紿載行東市。錯衣朝衣斬東市。則遣袁盎奉宗廟，宗正輔親戚，使告吳如盎策。至吳，吳楚兵已攻梁壁矣。宗正以親故，先入見，諭吳王使拜受詔。吳王聞袁盎來，亦知其欲說己，笑而應曰：「我已為東帝，尚何誰拜？」不肯見盎而留之軍中，欲劫使將。盎不肯，使人圍守，且殺之，盎得夜出，步亡去，走梁軍，遂歸報。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-106-wuwang:m011-0010","start":10,"end":12,"surface":"竇嬰","kind":"person","person_id":"kib_dnn_k5c","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m011-0019","start":19,"end":21,"surface":"袁盎","kind":"person","person_id":"jza_af1_m41","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m011-0022","start":22,"end":23,"surface":"盎","kind":"person","person_id":"jza_af1_m41","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m011-0035","start":35,"end":37,"surface":"晁錯","kind":"person","person_id":"7md_vp9_mh6","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m011-0045","start":45,"end":47,"surface":"袁盎","kind":"person","person_id":"jza_af1_m41","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m011-0059","start":59,"end":62,"surface":"田祿伯","kind":"person","person_id":"adj_kqv_jh0","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m011-0095","start":95,"end":97,"surface":"吳王","kind":"person","person_id":"dlg_vnw_1bi_A","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m011-0142","start":142,"end":144,"surface":"袁盎","kind":"person","person_id":"jza_af1_m41","status":"contextual_provi