,"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-jin049-role-xu_shu","person_id":"d1c_f9d_yc9","surfaces":["元直"],"scope":"same_chapter","chapter_ids":["c-jinshu-049-jikang-rendered-comparison"],"status":"contextual_provisional","confidence_level":"moderate","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-049","source_id":"s-jinshu049-jikang-web-rendered-comparison","chapter_id":"c-jinshu-049-jikang-rendered-comparison","paragraph_id":"c-jinshu-049-jikang-rendered-comparison:p008","quote":"夫人之相知，貴識其天性，因而濟之。禹不逼伯成子髙，全其長也；仲尼不假蓋于子夏，護其短也。近諸葛孔明不迫元直以入蜀，華子魚不彊幼安以卿相，此可謂能相終始，眞相知者也。自卜已審，若道盡塗殫則已耳，足下無事冤之令轉於溝壑也。","person_mention_id":"c-jinshu-049-jikang-rendered-comparison:p008:m0051"}],"rationale":"來源本單元角色與語境；保原詞，不按名稱近似補全身份或生平。","source_identity_key":"xu_shu","human_reviewed":false,"model":null},{"id":"d-sgz023-fourner-xufu","person_id":"d1c_f9d_yc9","surfaces":["徐福","徐"],"scope":"same_chapter","chapter_ids":["c-sanguozhi-023-peiqian-ws2376966"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-sanguozhi-023-peiqian-ws2376966","paragraph_id":"c-sanguozhi-023-peiqian-ws2376966:p010","quote":"《魏略列傳》以徐福、嚴幹、李義、張既、游楚、梁習、趙儼、裴潛、韓宣、黃朗十人共卷，其既、習、儼、潛四人自有傳，徐福事在《諸葛亮傳》，游楚事在《張既傳》。餘韓等四人載之於後。","mention_ids":["c-sanguozhi-023-peiqian-ws2376966:p010:m0007","c-sanguozhi-023-peiqian-ws2376966:p010:m0055"]},{"chapter_id":"c-sanguozhi-023-peiqian-ws2376966","paragraph_id":"c-sanguozhi-023-peiqian-ws2376966:p014","quote":"魚豢曰：世稱君子之德其猶龍乎，蓋以其善變也。昔長安巿儈有劉仲始者，一爲巿吏所辱，乃感激，蹋其尺折之，遂行學問，經明行脩，流名海內。後以有道徵，不肯就，衆人歸其高。余以爲前世偶有此耳，而今徐、嚴復參之，若皆非似龍之志也，其何能至於此哉？李推至道，張工度主，韓見識異，黃能拔萃，各著根於石上，而垂陰乎千里，亦未爲易也。游翁慷慨，展布腹心，全軀保郡，見延帝王，又放陸生，優遊宴戲，亦一實也。梁、趙及裴，雖張、楊不足，至於檢己，老而益明，亦難能也。","mention_ids":["c-sanguozhi-023-peiqian-ws2376966:p014:m0093"]}],"rationale":"卷023明指諸葛亮傳的徐福；對讀固定卷035明徐庶元直及庶先名福，沿既有元直身份；絕非秦方士徐巿。","human_reviewed":false,"reviewer":"Codex（AI代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-049-jikang-rendered-comparison:p008","text":"夫人之相知，貴識其天性，因而濟之。禹不逼伯成子髙，全其長也；仲尼不假蓋于子夏，護其短也。近諸葛孔明不迫元直以入蜀，華子魚不彊幼安以卿相，此可謂能相終始，眞相知者也。自卜已審，若道盡塗殫則已耳，足下無事冤之令轉於溝壑也。","text_layer":"received_chapter","annotation_status":"in_progress","captured_source_position":{"capture_ref":"source-evidence/jin049-jikang-rendered-comparison/web-rendered-extract.txt","capture_sha256":"29c47ce1cafc7ab2c1318b007e5fd9a4f92bc4c6610cc85d604422533bdfa8eb","projection_ref":"source-evidence/jin049-jikang-rendered-comparison/capture-projection.json","unit_key":"p008","coordinate_scope":"captured_web_tool_output_not_original_or_printed_lines","rendered_reference_line":238},"mentions":[{"id":"c-jinshu-049-jikang-rendered-comparison:p008:m0017","start":17,"end":18,"surface":"禹","kind":"person","person_id":"6ip_dr3_fbl","status":"contextual_provisional","role_key":"yu","source_scope":"quoted_letter"},{"id":"c-jinshu-049-jikang-rendered-comparison:p008:m0020","start":20,"end":24,"surface":"伯成子髙","kind":"person","person_id":"eur_6fo_h2x","status":"contextual_provisional","role_key":"bocheng_zigao","source_scope":"quoted_letter"},{"id":"c-jinshu-049-jikang-rendered-comparison:p008:m0030","start":30,"end":32,"surface":"仲尼","kind":"person","person_id":"fp6_ia6_7yw","status":"contextual_provisional","role_key":"kongzi","source_scope":"quoted_letter"},{"id":"c-jinshu-049-jikang-rendered-comparison:p008:m0036","start":36,"end":38,"surface":"子夏","kind":"person","person_id":"z8l_wje_08d","status":"contextual_provisional","role_key":"zixia","source_scope":"quoted_letter"},{"id":"c-jinshu-049-jikang-rendered-comparison:p008:m0045","start":45,"end":49,"surface":"諸葛孔明","kind":"person","person_id":"11e_f2d_5d2","status":"contextual_provisional","role_key":"zhuge_liang","source_scope":"quoted_letter"},{"id":"c-jinshu-049-jikang-rendered-comparison:p008:m0051","start":51,"end":53,"surface":"元直","kind":"person","person_id":"d1c_f9d_yc9","status":"contextual_provisional","role_key":"xu_shu","source_scope":"quoted_letter"},{"id":"c-jinshu-049-jikang-rendered-comparison:p008:m0057","start":57,"end":60,"surface":"華子魚","kin