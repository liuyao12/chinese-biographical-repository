son_id":"5dm_e40_rqh_AAAAAAAAAAAAAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m024-0304","start":304,"end":306,"surface":"專諸","kind":"person","person_id":"78u_8ii_bnr","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m024-0306","start":306,"end":307,"surface":"子","kind":"person","person_id":"78u_8ii_bnr_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-031-wu","book_id":"b-shiji-031","work_id":"w-shiji","source_id":"s-shiji-031-wu"},{"id":"c-shiji-066-wu:p007","text":"久之，楚平王以其邊邑鐘離與吳邊邑卑梁氏俱蠶，兩女子爭桑相攻，乃大怒，至於兩國舉兵相伐。吳使公子光伐楚，拔其鐘離、居巢而歸。伍子胥說吳王僚曰：「楚可破也。願復遣公子光。」公子光謂吳王曰：「彼伍胥父兄為戮於楚，而勸王伐楚者，欲以自報其讎耳。伐楚未可破也。」伍胥知公子光有內志，欲殺王而自立，未可說以外事，乃進專諸於公子光，退而與太子建之子勝耕於野。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-066-wu:m007-0003","start":3,"end":6,"surface":"楚平王","kind":"person","person_id":"rjl_5bl_0dm","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m007-0022","start":22,"end":25,"surface":"兩女子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代，未補姓名及成員；鮑氏不直接等同鮑牧。"},{"id":"c-shiji-066-wu:m007-0045","start":45,"end":48,"surface":"公子光","kind":"person","person_id":"yb7_umd_09d","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m007-0061","start":61,"end":64,"surface":"伍子胥","kind":"person","person_id":"g9h_5ih_ug1_A","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m007-0065","start":65,"end":68,"surface":"吳王僚","kind":"person","person_id":"l0i_j1y_txo","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m007-0079","start":79,"end":82,"surface":"公子光","kind":"person","person_id":"yb7_umd_09d","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m007-0084","start":84,"end":87,"surface":"公子光","kind":"person","person_id":"yb7_umd_09d","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m007-0088","start":88,"end":90,"surface":"吳王","kind":"person","person_id":"l0i_j1y_txo","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m007-009