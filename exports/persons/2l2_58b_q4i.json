n","paragraph_id":"c-shiji-123-dayuan:p036","quote":"蟬封"}]}],"source_mention_summary":[{"source_id":"s-shiji123-dayuan","work_id":"w-shiji","book_id":"b-shiji-123","chapter_id":"c-shiji-123-dayuan","mention_count":8,"mention_ids":["c-shiji-123-dayuan:m029-0066","c-shiji-123-dayuan:m032-0171","c-shiji-123-dayuan:m033-0171","c-shiji-123-dayuan:m033-0184","c-shiji-123-dayuan:m033-0223","c-shiji-123-dayuan:m033-0364","c-shiji-123-dayuan:m033-0367","c-shiji-123-dayuan:m036-0041"],"paragraph_ids":["c-shiji-123-dayuan:p029","c-shiji-123-dayuan:p032","c-shiji-123-dayuan:p033","c-shiji-123-dayuan:p036"],"passage_count":4}],"most_mentioned_source_ids":["s-shiji123-dayuan"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji123-012","subject_person_id":"h4f_d5f_vdl","predicate":"brother","object_person_id":"2l2_58b_q4i","status":"source_attested","evidence":[{"chapter_id":"c-shiji-123-dayuan","source_id":"s-shiji123-dayuan","paragraph_id":"c-shiji-123-dayuan:p036","quote":"漢已伐宛，立昧蔡為宛王而去。歲餘，宛貴人以為昧蔡善諛，使我國遇屠，乃相與殺昧蔡，立毋寡昆弟曰蟬封為宛王，而遣其子入質於漢。漢因使使賂賜以鎮撫之。"}],"qualifiers":{"source_term":"毋寡昆弟曰蟬封"},"interpretation_note":"昆弟記兄弟關係，未明長幼；不加入相對排行或同母判斷。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-shiji123-008","person_id":"2l2_58b_q4i","event_type":"death","status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-123-dayuan","source_id":"s-shiji123-dayuan","paragraph_id":"c-shiji-123-dayuan:p033","quote":"於是貳師后復行，兵多，而所至小國莫不迎，出食給軍。至侖頭，侖頭不下，攻數日，屠之。自此而西，平行至宛城，漢兵到者三萬人。宛兵迎擊漢兵，漢兵射敗之，宛走入葆乘其城。貳師兵欲行攻郁成，恐留行而令宛益生詐，乃先至宛，決其水源，移之，則宛固已憂困。圍其城，攻之四十餘日，其外城壞，虜宛貴人勇將煎靡。宛大恐，走入中城。宛貴人相與謀曰：「漢所為攻宛，以王毋寡匿善馬而殺漢使。今殺王毋寡而出善馬，漢兵宜解；即不解，乃力戰而死，未晚也。」宛貴人皆以為然，共殺其王毋寡，持其頭遣貴人使貳師，約曰：「漢毋攻我。我盡出善馬，恣所取，而給漢軍食。即不聽，我盡殺善馬，而康居之救且至。至，我居內，康居居外，與漢軍戰。漢軍熟計之，何從？」是時康居候視漢兵，漢兵尚盛，不敢進。貳師與趙始成、李哆等計：「聞宛城中新得秦人，知穿井，而其內食尚多。所為來，誅首惡者毋寡。毋寡頭已至，如此而不許解兵，則堅守，而康居候漢罷而來救宛，破漢軍必矣。」軍吏皆以為然，許宛之約。宛乃出其善馬，令漢自擇之，而多出食食給漢軍。漢軍取其善馬數十匹。中馬以下牡牝三千餘匹，而立宛貴人之故待遇漢使善者名昧蔡以為宛王，與盟而罷兵。終不得入中城。乃罷而引歸。","person_mention_id":"c-shiji-123-dayuan:m033-0171"}],"source_term":"共殺其王毋寡","interpretation_note":"原文明示個人死亡；相對年月未換算公元年，泛論與群體未另造個人事件。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"mentions":[{"id":"c-shiji-123-dayuan:m029-0066","start":66,"end":68,"surface":"宛王","kind":"person","person_id":"2l2_58b_q4i","status":"contextual_provisional","paragraph_id":"c-shiji-123-dayuan:p029","chapter_id":"c-shiji-123-dayuan"},{"id":"c-shiji-123-dayuan:m032-0171","start":171,"end":173,"surface":"宛王","kind":"person","person_id":"2l2_58b_q4i","status":"contextual_provisional","paragraph_id":"c-shiji-123-dayuan:p032","chapter_id":"c-shiji-123-dayuan"},{"id":"c-shiji-123-dayuan:m033-0171","start":171,"end":173,"surface":"毋寡","kind":"person","person_id":"2l2_58b_q4i","status":"contextual_provisional","paragraph_id":"c-shiji-123-dayuan:p033","chapter_id":"c-shiji-123-dayuan"},{"id":"c-shiji-123-dayuan:m033-0184","start":184,"end":186,"surface":"毋寡","kind":"person","person_id":"2l2_58b_q4i","status":"contextual_provisional","paragraph_id":"c-shiji-123-dayuan:p033","chapter_id":"c-shiji-123-dayuan"},{"id":"c-shiji-123-dayuan:m033-0223","start":223,"end":225,"surface":"毋寡","kind":"person","person_id":"2l2_58b_q4i","status":"contextual_provisional","paragraph_id":"c-shiji-123-dayuan:p033","chapter_id":"c-shiji-123-dayuan"},{"id":"c-shiji-123-dayuan:m033-0364","start":364,"end":366,"surface":"毋寡","kind":"person","person_id":"2l2_58b_q4i","status":"contextual_provisional","paragraph_id":"c-shiji-123-dayuan:p033","chapter_id":"c-shiji-123-dayuan"},{"id":"c-shiji-123-dayuan:m033-0367","start":367,"end":369,"surface":"毋寡","kind":"person","person_id":"2l