{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000916","identity_policy":"contextual_provisional","person_ids":["cbr-p000916"],"persons":[{"id":"cbr-p000916","label":"慎夫人","status":"active","historicity":"historical_tradition","aliases":[{"surface":"慎夫人","mention_ids":["c-shiji-010-wendi:m036-0091"]}],"evidence":[{"mention_id":"c-shiji-010-wendi:m036-0091","chapter_id":"c-shiji-010-wendi","paragraph_id":"c-shiji-010-wendi:p036","quote":"慎夫人"}]}],"source_mention_summary":[{"source_id":"s-shiji-010-wendi","work_id":"w-shiji","book_id":"b-shiji-010","chapter_id":"c-shiji-010-wendi","mention_count":1,"mention_ids":["c-shiji-010-wendi:m036-0091"],"paragraph_ids":["c-shiji-010-wendi:p036"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-010-wendi"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-010-wendi:m036-0091","start":91,"end":94,"surface":"慎夫人","kind":"person","person_id":"cbr-p000916","status":"contextual_provisional","paragraph_id":"c-shiji-010-wendi:p036","chapter_id":"c-shiji-010-wendi"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-010-wendi:p036","text":"孝文帝從代來，即位二十三年，宮室苑囿狗馬服御無所增益，有不便，輒弛以利民。嘗欲作露臺，召匠計之，直百金。上曰：「百金中民十家之產，吾奉先帝宮室，常恐羞之，何以臺為！」上常衣綈衣，所幸慎夫人，令衣不得曳地，幃帳不得文繡，以示敦樸，為天下先。治霸陵皆以瓦器，不得以金銀銅錫為飾，不治墳，欲為省，毋煩民。南越王尉佗自立為武帝，然上召貴尉佗兄弟，以德報之，佗遂去帝稱臣。與匈奴和親，匈奴背約入盜，然令邊備守，不發兵深入，惡煩苦百姓。吳王詐病不朝，就賜幾杖。群臣如袁盎等稱說雖切，常假借用之。群臣如張武等受賂遺金錢，覺，上乃發御府金錢賜之，以愧其心，弗下吏。專務以德化民，是以海內殷富，興於禮義。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-010-wendi:m036-0000","start":0,"end":3,"surface":"孝文帝","kind":"person","person_id":"cbr-p000806","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m036-00