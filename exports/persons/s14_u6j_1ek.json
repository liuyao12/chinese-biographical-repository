},{"id":"c-chenshu-017-wangmai-complete:p005:m0196","start":196,"end":197,"surface":"勱","kind":"person","person_id":"q7m_r8k_2vn_ABAG","status":"contextual_provisional"},{"id":"c-chenshu-017-wangmai-complete:p005:m0263","start":263,"end":265,"surface":"廢帝","kind":"person","person_id":"2mj_6rl_6xs","status":"contextual_provisional"},{"id":"c-chenshu-017-wangmai-complete:p005:m0298","start":298,"end":299,"surface":"勱","kind":"person","person_id":"q7m_r8k_2vn_ABAG","status":"contextual_provisional"},{"id":"c-chenshu-017-wangmai-complete:p005:m0325","start":325,"end":326,"surface":"勱","kind":"person","person_id":"q7m_r8k_2vn_ABAG","status":"contextual_provisional"}],"chapter_id":"c-chenshu-017-wangmai-complete","book_id":"b-chenshu-017","work_id":"w-chenshu","source_id":"s-chenshu-017-wangmai-complete-ws1544244"},{"id":"c-chenshu-017-wangtong-complete:p004","text":"江陵陷，敬帝承制以通為吏部尚書。紹泰元年，加侍中，尚書如故。尋為尚書右僕射，吏部如故。高祖受禪，遷左僕射，侍中如故。文帝嗣位，領太子少傅。天康元年，為翊右將軍、右光祿大夫，量置佐史。廢帝即位，號安右將軍，又領南徐州大中正。太建元年，遷左光祿大夫。六年，加特進，侍中、將軍、光祿、佐史嵭如故。未拜卒，時年七十二。詔贈本官，諡曰成，葬日給鼓吹一部。弟質、弟固各有傳。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":33,"last_line":33,"raw_start":1435,"raw_end":1665,"raw_character_offsets":[1435,1436,1437,1438,1439,1440,1441,1442,1443,1444,1445,1446,1447,1448,1449,1450,1456,1457,1458,1459,1462,1463,1464,1465,1466,1467,1468,1469,1470,1471,1472,1473,1474,1475,1476,1477,1478,1479,1480,1481,1482,1483,1484,1485,1486,1487,1488,1489,1490,1491,1492,1493,1494,1495,1496,1497,1498,1499,1500,1501,1502,1503,1504,1505,1506,1507,1508,1509,1510,1516,1517,1518,1519,1522,1523,1524,1525,1526,1527,1528,1529,1530,1531,1532,1533,1534,1535,1536,1537,1538,1539,1540,1541,1542,1543,1544,1545,1546,1547,1548,1549,1550,1551,1552,1553,1554,1555,1556,1557,1558,1559,1565,1566,1567,1568,1571,1572,1573,1574,1575,1576,1577,1578,1579,1580,1581,1582,1583,1584,1585,1586,1587,1588,1589,1590,1591,1592,1593,1594,1595,1596,1597,1598,1599,1600,1601,1602,1603,1604,1605,1606,1607,1608,1609,161