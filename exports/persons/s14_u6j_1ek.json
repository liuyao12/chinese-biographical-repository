rson","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作沖。"},{"start":16,"end":19,"surface":"王僧辯","id":"c-nanshi-021-wangchong:p002:m0016","person_id":"g7w_9tv_iqb","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作僧辯。"},{"start":32,"end":34,"surface":"侯景","id":"c-nanshi-021-wangchong:p002:m0032","person_id":"5d1_8jg_amy","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作侯。"},{"start":55,"end":56,"surface":"沖","id":"c-nanshi-021-wangchong:p002:m0055","person_id":"7r6_k52_qji_ABAAAAAABAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作沖。"}],"source_position":{"revision_id":1752646,"source_layer":"received_biography","raw_start":6964,"raw_end":7061,"raw_character_offsets":[6964,6965,6966,6967,6968,6969,6970,6971,6972,6973,6976,6979,6980,6981,6982,6983,6984,6985,6986,6987,6988,6989,6990,6991,6992,6993,6994,6995,6996,6997,6998,6999,7000,7001,7002,7003,7004,7005,7006,7007,7008,7009,7010,7011,7012,7013,7014,7015,7016,7017,7018,7019,7020,7021,7022,7025,7028,7029,7030,7031,7032,7033,7034,7035,7036,7037,7038,7039,7040,7041,7042,7043,7044,7045,7046,7047,7048,7049,7050,7051,7052,7053,7054,7055,7056,7057,7058,7059,7060],"projection_sha256":"6f9247e393a3906dd1365b55a05b6b743beb5ccb76ed56ea1f09374a76ffb65c"},"chapter_id":"c-nanshi-021-wangchong","book_id":"b-nanshi-021","work_id":"w-nanshi","source_id":"s-nanshi-021-wangchong-ws1752646"},{"id":"c-nanshi-023-wangmai:p005","text":"會魏軍至，元帝征湘州刺史宜豐侯蕭循入援，以勱監湘州。及魏平江陵，敬帝承制，以為中書令，加侍中。曆陳武帝司空、丞相長史，侍中、中書令並如故。","mentions":[{"id":"c-nanshi-023-wangmai:p005:m0015","surface":"蕭循","start":15,"end":17,"person_id":"qvt_eq1_lcf_AAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangmai:p005:m0021","surface":"勱","start":21,"end":22,"person_id":"q7m_r8k_2vn_ABAG","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"}],"text_layer":"receive