{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"s14_u6j_1ek","canonical_person_id":"s14_u6j_1ek","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["s14_u6j_1ek"],"persons":[{"id":"s14_u6j_1ek","label":"梁敬帝方智","status":"active","historicity":"historical_tradition","aliases":[],"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-021","chapter_id":"c-nanshi-021-wangchong","source_id":"s-nanshi-021-wangchong-ws1752646","paragraph_id":"c-nanshi-021-wangchong:p002","quote":"敬帝","kind":"person_reference","mention_id":"c-nanshi-021-wangchong:p002:r0046"}],"review":"ai_provisional","identity_note":"依南史21、陳書本傳及其本紀的具名或稱謂身份，互證檔保留完整固定原證。"}],"source_mention_summary":[],"most_mentioned_source_ids":[],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[],"relations":[],"title_holdings":[],"address_assertions":[],"person_references":[{"start":46,"end":48,"surface":"敬帝","id":"c-nanshi-021-wangchong:p002:r0046","paragraph_id":"c-nanshi-021-wangchong:p002","person_id":"s14_u6j_1ek","referent_role":"third_person","quote":"侯景之亂，元帝承制，沖求解南郡讓王僧辯，並獻女伎十人，以助軍賞。侯景平，授丹陽尹。魏平江陵，敬帝爲太宰承制，以沖爲左長史。紹泰中，累遷左光祿大夫、尚書左僕射、開府儀同三司，給扶。","note":"本句按敘述視點回指敬。","chapter_id":"c-nanshi-021-wangchong","book_id":"b-nanshi-021","work_id":"w-nanshi","source_id":"s-nanshi-021-wangchong-ws1752646"},{"id":"c-nanshi-023-wangmai:p005:r0032","surface":"敬帝","start":32,"end":34,"person_id":"s14_u6j_1ek","referent_role":"third_person","paragraph_id":"c-nanshi-023-wangmai:p005","quote":"會魏軍至，元帝征湘州刺史宜豐侯蕭循入援，以勱監湘州。及魏平江陵，敬帝承制，以為中書令，加侍中。曆陳武帝司空、丞相長史，侍中、中書令並如故。","note":"按王府、敘事時段及陳書平行傳。","chapter_id":"c-nanshi-023-wangmai","book_id":"b-nanshi-023","work_id":"w-nanshi","source_id":"s-nanshi-023-wangmai-ws2478204"},{"id":"c-nanshi-023-wangtong-gongda:p001:r0013","surface":"敬帝","start":13,"end":15,"person_id":"s14_u6j_1ek","referent_role":"third_person","paragraph_id":"c-nanshi-023-wangtong-gongda:p001","quote":"通字公達，仕梁為黃門侍郎。敬帝承制，以為尚書右僕射。陳武帝受禪，遷左僕射。太建元年，為左光祿大夫。六年，加特進，侍中、將軍、光祿、佐史、扶並如故。未拜，卒，諡曰成。弟勱。","note":"梁敬帝方智。","chapter_id":"c-nanshi-023-wangtong-gongda","book_id":"b-nanshi-023","work_id":"w-nanshi","source_id":"s-nanshi-023-wangtong-gongda-ws2478204"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanshi-021-wangchong:p002","text":"侯景之亂，元帝承制，沖求解南郡讓王僧辯，並獻女伎十人，以助軍賞。侯景平，授丹陽尹。魏平江陵，敬帝爲太宰承制，以沖爲左長史。紹泰中，累遷左光祿大夫、尚書左僕射、開府儀同三司，給扶。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"start":0,"end":2,"surface":"侯景","id":"c-nanshi-021-wangchong:p002:m0000","person_id":"5d1_8jg_amy","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作侯。"},{"start":10,"end":11,"surface":"沖","id":"c-nanshi-021-wangchong:p002:m0010","person_id":"7r6_k52_qji_ABAAAAAABAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作沖。"},{"start":16,"end":19,"surface":"王僧辯","id":"c-nanshi-021-wangchong:p002:m0016","person_id":"g7w_9tv_iqb","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作僧辯。"},{"start":32,"end":34,"surface":"侯景","id":"c-nanshi-021-wangchong:p002:m0032","person_id":"5d1_8jg_amy","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作侯。"},{"start":55,"end":56,"surface":"沖","id":"c-nanshi-021-wangchong