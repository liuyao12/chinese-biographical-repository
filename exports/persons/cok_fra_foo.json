tions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-093-hanlu:m015-0007","start":7,"end":9,"surface":"趙相","kind":"person","person_id":"cok_fra_foo","status":"contextual_provisional","paragraph_id":"c-shiji-093-hanlu:p015","chapter_id":"c-shiji-093-hanlu"},{"id":"c-shiji-093-hanlu:m015-0009","start":9,"end":11,"surface":"周昌","kind":"person","person_id":"cok_fra_foo","status":"contextual_provisional","paragraph_id":"c-shiji-093-hanlu:p015","chapter_id":"c-shiji-093-hanlu"},{"id":"c-shiji-093-hanlu:m015-0049","start":49,"end":51,"surface":"周昌","kind":"person","person_id":"cok_fra_foo","status":"contextual_provisional","paragraph_id":"c-shiji-093-hanlu:p015","chapter_id":"c-shiji-093-hanlu"},{"id":"c-shiji-093-hanlu:m016-0055","start":55,"end":57,"surface":"趙相","kind":"person","person_id":"cok_fra_foo","status":"contextual_provisional","paragraph_id":"c-shiji-093-hanlu:p016","chapter_id":"c-shiji-093-hanlu"},{"id":"c-shiji-093-hanlu:m016-0130","start":130,"end":132,"surface":"周昌","kind":"person","person_id":"cok_fra_foo","status":"contextual_provisional","paragraph_id":"c-shiji-093-hanlu:p016","chapter_id":"c-shiji-093-hanlu"},{"id":"c-shiji-093-hanlu:m020-0117","start":117,"end":119,"surface":"周昌","kind":"person","person_id":"cok_fra_foo","status":"contextual_provisional","paragraph_id":"c-shiji-093-hanlu:p020","chapter_id":"c-shiji-093-hanlu"}],"relations":[],"title_holdings":[{"id":"th-shiji093-033","person_id":"cok_fra_foo","title":"趙相","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-093-hanlu","source_id":"s-shiji-093-hanlu","paragraph_id":"c-shiji-093-hanlu:p015","quote":"豨常告歸過趙，趙相周昌見豨賓客隨之者千餘乘，邯鄲官舍皆滿。豨所以待賓客布衣交，皆出客下。豨還之代，周昌乃求入見。見上，具言豨賓客盛甚，擅兵於外數歲，恐有變。上乃令人覆案豨客居代者財物諸不法事，多連引豨。豨恐，陰令客通使王黃、曼丘臣所。及高祖十年七月，太上皇崩，使人召豨，豨稱病甚。九月，遂與王黃等反，自立為代王，劫略趙、代。"}],"attestations":[{"id":"th-shiji093-033:a001","paragraph_id":"c-shiji-093-hanlu:p015","start":7,"end":9,"surface":"趙相","person_mention_id":"c-shiji-093-hanlu:m015-0007","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"按實授、自立與用稱保存；許韓王在先不作已授。明示相對年月保持原文，死亡、降漢、失侯之後裔敘事不替本人任期補終點。虜綰原字保留，以本段盧綰主語承接授爵，未核底本影像。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji093-049","person_id":"cok_fra_foo","scope":"same_chapter","chapter_ids":["c-shiji-093-hanlu"],"status":"contextual_provisional","rationale":"明示姓名及局部敘事承接；引古、未名者及短稱另存候選。臧茶與臧荼、高后與呂后待跨稱判讀，不因近形或熟知姓名自動合併。","reviewer":"Codex（AI 代理）","surfaces":["周昌","趙相"],"evidence":[{"paragraph_id":"c-shiji-093-hanlu:p015","quote":"豨常告歸過趙，趙相周昌見豨賓客隨之者千餘乘，邯鄲官舍皆滿。豨所以待賓客布衣交，皆出客下。豨還之代，周昌乃求入見。見上，具言豨賓客盛甚，擅兵於外數歲，恐有變。上乃令人覆案豨客居代者財物諸不法事，多連引豨。豨恐，陰令客通使王黃、曼丘臣所。及高祖十年七月，太上皇崩，使人召豨，豨稱病甚。九月，遂與王黃等反，自立為代王，劫略趙、代。"},{"paragraph_id":"c-shiji-093-hanlu:p016","quote":"上聞，乃赦趙、代吏人為豨所詿誤劫略者，皆赦之。上自往，至邯鄲，喜曰：「豨不南據漳水，北守邯鄲，知其無能為也。」趙相奏斬常山守、尉，曰：「常山二十五城，豨反，亡其二十城。」上問曰：「守、尉反乎？」對曰：「不反。」上曰：「是力不足也。」赦之，復以為常山守、尉。上問周昌曰：「趙亦有壯士可令將者乎？」對曰：「有四人。」四人謁，上謾罵曰：「豎子能為將乎？」四人慚伏。上封之各千戶，以為將。左右諫曰：「從入蜀、漢，伐楚，功未遍行，今此何功而封？」上曰：「非若所知！陳豨反，邯鄲以北皆豨有，吾以羽檄徵天下兵，未有至者，今唯獨邯鄲中兵耳。吾胡愛四千戶封四人，不以慰趙子弟！」皆曰：「善。」於是上曰：「陳豨將誰？」曰：「王黃、曼丘臣，皆故賈人。」上曰：「吾知之矣。」乃各以千金購黃、臣等。"},{"paragraph_id":"c-shiji-093-hanlu:p020","quote":"太史公曰：韓信、盧綰非素積德累善之世，徼一時權變，以詐力成功，遭漢初定，故得列地，南面稱孤。內見疑彊大，外倚蠻貊以為援，是以日疏自危，事窮智困，卒赴匈奴，豈不哀哉！陳豨，梁人，其少時數稱慕魏公子；及將軍守邊，招致賓客而下士，名聲過實。周昌疑之，疵瑕頗起，懼禍及身，邪人進說，遂陷無道。於戲悲夫！夫計之生孰成敗於人也深矣！"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-093-hanlu:p015","text":"豨常告歸過趙，趙相周昌見豨賓客隨之者千餘乘，邯鄲官舍皆滿。豨所以待賓客布衣交，皆出客下。豨還之代，周昌乃求入見。見上，具言豨賓客盛甚，擅兵於外數歲，恐有變。上乃令人覆案豨客居代者財物諸不法事，多連引豨。豨恐，陰令客通使王黃、曼丘臣所。及高祖十年七月，太上皇崩，使人召豨，豨稱病甚。九月，遂與王黃等反，自立為代王，劫略趙、代。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-093-hanlu:m015-0000","start":0,"end":1,"surface":"豨","kind":"person","person_id":"k12_clz_joc","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m015-0007","start":7,"end":9,"surface":"趙相","kind":"person","person_id":"cok_fra_foo","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m015-0009","start":9,"end":11,"surface":"周昌","kind":"person","person_id":"cok_fra_foo","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m015-0012","start":12,"end":13,"surface":"豨","kind":"person","person_id":"k12_clz_joc","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m015-0029","start":29,"end":30,"surface":"豨","kind":"person","person_id":"k12_clz_joc","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m015-0044","start":44,"end":45,"surface":"豨","kind":"person","person_id":"k12_clz_joc","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m015-0049","start":49,"end":51,"surface":"周昌","kind":"person","person_id":"cok_fra_foo","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m015-0057","start":57,"end":58,"surface":"上","kind":"person","person_id":"moi_ml7_uxh_A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m015-0061","start":61,"end":62,"surface":"豨","kind":"person","person_id":"k12_clz_joc","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m015-0078","start":78,"end":79,"surface":"上","kind":"person","person_id":"moi_ml7_uxh_A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m015-0084","start":84,"end":85,"surface":"豨","kind":"person","person_id":"k12_clz_joc","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m015-0099","start":99,"end":100,"surface":"豨","kind":"person","person_id":"k12_clz_joc","status":"contextual_provisional"},{"id"