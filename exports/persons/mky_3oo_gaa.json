mky_3oo_gaa","status":"contextual_provisional"},{"id":"c-nanqishu-027-wangxuanmiao:p003:m0169","start":169,"end":171,"surface":"玄邈","kind":"person","person_id":"hgq_k4y_crp","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-027-wangxuanmiao","book_id":"b-nanqishu-027","work_id":"w-nanqishu","source_id":"s-nanqishu-027-wangxuanmiao-ws1508012"},{"id":"c-nanqishu-059-western-polities-complete:p019","text":"梁州刺史范柏年被誅，其親將李烏奴懼奔叛，文弘納之。烏奴率亡命千餘人攻梁州，為刺史王玄邈所破，復走還氐中。荊州刺史豫章王嶷遣兵討烏奴，檄梁州能斬送烏奴首，賞本郡，烏奴田宅事業悉賜之。與廣香書曰：","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":49,"last_line":49,"raw_start":3235,"raw_end":3331,"raw_character_offsets":[3235,3236,3237,3238,3239,3240,3241,3242,3243,3244,3245,3246,3247,3248,3249,3250,3251,3252,3253,3254,3255,3256,3257,3258,3259,3260,3261,3262,3263,3264,3265,3266,3267,3268,3269,3270,3271,3272,3273,3274,3275,3276,3277,3278,3279,3280,3281,3282,3283,3284,3285,3286,3287,3288,3289,3290,3291,3292,3293,3294,3295,3296,3297,3298,3299,3300,3301,3302,3303,3304,3305,3306,3307,3308,3309,3310,3311,3312,3313,3314,3315,3316,3317,3318,3319,3320,3321,3322,3323,3324,3325,3326,3327,3328,3329,3330],"revision_id":1748911},"mentions":[{"id":"c-nanqishu-059-western-polities-complete:p019:m0004","start":4,"end":7,"surface":"范柏年","kind":"person","person_id":"w3b_lk9_m4s","status":"contextual_provisional"},{"id":"c-nanqishu-059-western-polities-complete:p019:m0013","start":13,"end":16,"surface":"李烏奴","kind":"person","person_id":"mky_3oo_gaa","status":"contextual_provisional"},{"id":"c-nanqishu-059-western-polities-complete:p019:m0020","start":20,"end":22,"surface":"文弘","kind":"person","person_id":"zdb_1c5_ffp","status":"contextual_provisional"},{"id":"c-nanqishu-059-western-polities-complete:p019:m0025","start":25,"end":27,"surface":"烏奴","kind":"person","person_id":"mky_3oo_gaa","status":"contextual_provisional"},{"id":"c-nanqishu-059-western-polities-complete:p019:m0040","start":40,"end":43,"surface":"王玄邈","kind":"person","person_id":"hgq_k4y_crp","status":"contextual_provisional"},{"id":"c-nanqishu-059-western-polities-complete:p019:m0056","start":56,"end":60,"surface":"豫章王嶷","kind":"person","person_id":"ijh_3fs_6u2","status":"contextual_provisional"},{"id":"c-nanqishu-059-western-polities-complete:p019:m0063","start":63,"end":65,"surface":"烏奴","kind":"person","person_id":"mky_3oo_gaa","status":"contextual_provisional"},{"id":"c-nanqishu-059-western-polities-complete:p019:m0072","start":72,"end":74,"surface":"烏奴","kind":"person","person_id":"mky_3oo_gaa","status":"contextual_provisional"},{"id":"c-nanqishu-059-western-polities-complete:p019:m0080","start":80,"end":82,"surface":"烏奴","kind":"person","person_id":"mky_3oo_gaa","status":"contextual_provisional"},{"id":"c-nanqishu-059-western-polities-complete:p019:m0091","start":91,"end":93,"surface":"廣香","kind":"person","person_id":"rdb_pcr_z28","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-059-western-polities-complete","book_id":"b-nanqishu-059","work_id":"w-nanqishu","source_id":"s-nanqishu-059-western-polities-complete-ws1748911"},{"id":"c-nanqishu-059-western-polities-complete:p020","text":"夫廢興無謬，逆順有恒，古今共貫；賢愚同察。梁州刺史范柏年懷挾詭態，首鼠兩端，既已被伐，盤桓稽命。遂潛遣李烏奴叛。楊文弘扇誘邊疆荒雜。柏年今已梟禽，烏奴頻被摧破，計其餘燼，行自消夷。今遣參軍行晉壽太守王道寶、參軍事行北巴西新巴二郡太守任湜之、行宕渠太守王安會領銳卒三千，遄塗風邁，浮川電掩。又命輔國將軍三巴校尉明惠照、巴郡太守魯休烈、南巴西太守柳弘稱、益州刺史傅琰，竝簡徒競騖，選甲爭馳。雍州水步，行次魏興，并山東僑舊，會于南鄭。或汎舟墊江，或飛旍劍道，腹背飊騰，表裏震擊。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":51,"last_line":51,"raw_start":3333,"raw_end":3609,"raw_character_offsets":[3334,3335,3336,3337,3338,3339,3340,3341,3342,3343,3344,3345,3346,3347,3348,3349,3350,3351,3352,3353,3354,3355,3356,3357,3358,3359,3360,3361,3362,3363,3364,3365,3366,3367,3368,3369,3370,3371,3372,3373,3374,3375,3376,3416,3417,3418,3419,3420,3421,3422,3423,3424,3425,3426,3427,3428,3429,3430,3431,3432,3433,3434,3435,3436,3437,3438,3439,3440,3441,3442,3443,3444,3445,3446,3447,3448,3449,3450,3451,3452,3453,3454,3455,3456,3457,3458,34