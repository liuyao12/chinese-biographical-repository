western-polities-complete"},{"id":"c-nanshi-016-wangxuanmiao:p002:m0007","start":7,"end":10,"surface":"李烏奴","kind":"person","person_id":"mky_3oo_gaa","status":"contextual_provisional","paragraph_id":"c-nanshi-016-wangxuanmiao:p002","chapter_id":"c-nanshi-016-wangxuanmiao"},{"id":"c-nanshi-016-wangxuanmiao:p002:m0021","start":21,"end":23,"surface":"烏奴","kind":"person","person_id":"mky_3oo_gaa","status":"contextual_provisional","paragraph_id":"c-nanshi-016-wangxuanmiao:p002","chapter_id":"c-nanshi-016-wangxuanmiao"},{"id":"c-nanshi-016-wangxuanmiao:p002:m0045","start":45,"end":47,"surface":"烏奴","kind":"person","person_id":"mky_3oo_gaa","status":"contextual_provisional","paragraph_id":"c-nanshi-016-wangxuanmiao:p002","chapter_id":"c-nanshi-016-wangxuanmiao"}],"relations":[],"title_holdings":[],"address_assertions":[],"person_references":[{"id":"c-nanqishu-027-wangxuanmiao:p003:r0087","paragraph_id":"c-nanqishu-027-wangxuanmiao:p003","start":87,"end":88,"surface":"之","person_id":"mky_3oo_gaa","referent_role":"third_person","quote":"出為持節、都督梁南秦二州軍事、征虜將軍、西戎校尉、梁南秦二州刺史，兄弟同時為方伯。封河陽縣侯。建元元年，進號右將軍，侯如故。亡命李烏奴作亂梁部，陷白馬戍。玄邈率東從七八百人討之，不克，慮不自保，乃使人偽降烏奴，告之曰：「王使君兵衆羸弱，棄伎妾於城內，攜愛妾二人去已數日矣。」烏奴喜，輕兵襲州城，玄邈設伏擊破之，烏奴挺身走。太祖聞之，曰：「玄邈果不負吾意遇也。」","note":"依本段敘事、稱謂及語者受者定。","chapter_id":"c-nanqishu-027-wangxuanmiao","book_id":"b-nanqishu-027","work_id":"w-nanqishu","source_id":"s-nanqishu-027-wangxuanmiao-ws1508012"},{"id":"c-nanqishu-027-wangxuanmiao:p003:r0106","paragraph_id":"c-nanqishu-027-wangxuanmiao:p003","start":106,"end":107,"surface":"之","person_id":"mky_3oo_gaa","referent_role":"third_person","quote":"出為持節、都督梁南秦二州軍事、征虜將軍、西戎校尉、梁南秦二州刺史，兄弟同時為方伯。封河陽縣侯。建元元年，進號右將軍，侯如故。亡命李烏奴作亂梁部，陷白馬戍。玄邈率東從七八百人討之，不克，慮不自保，乃使人偽降烏奴，告之曰：「王使君兵衆羸弱，棄伎妾於城內，攜愛妾二人去已數日矣。」烏奴喜，輕兵襲州城，玄邈設伏擊破之，烏奴挺身走。太祖聞之，曰：「玄邈果不負吾意遇也。」","note":"依本段敘事、稱謂及語者受者定。","chapter_id":"c-nanqishu-027-wangxuanmiao","book_id":"b-nanqishu-027","work_id":"w-nanqishu","source_id":"s-nanqishu-027-wangxuanmiao-ws1508012"},{"id":"c-nanqishu-027-wangxuanmiao:p003:r0153","par