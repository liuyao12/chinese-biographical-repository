":"c-nanqishu-059-western-polities-complete:p020:m0125","start":125,"end":128,"surface":"王安會","kind":"person","person_id":"fa3_4yc_4wj","status":"contextual_provisional"},{"id":"c-nanqishu-059-western-polities-complete:p020:m0154","start":154,"end":157,"surface":"明惠照","kind":"person","person_id":"mex_5i1_v70","status":"contextual_provisional"},{"id":"c-nanqishu-059-western-polities-complete:p020:m0162","start":162,"end":165,"surface":"魯休烈","kind":"person","person_id":"4bf_dt3_90t","status":"contextual_provisional"},{"id":"c-nanqishu-059-western-polities-complete:p020:m0171","start":171,"end":174,"surface":"柳弘稱","kind":"person","person_id":"34w_do8_11v","status":"contextual_provisional"},{"id":"c-nanqishu-059-western-polities-complete:p020:m0179","start":179,"end":181,"surface":"傅琰","kind":"person","person_id":"o6u_fls_sgx","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-059-western-polities-complete","book_id":"b-nanqishu-059","work_id":"w-nanqishu","source_id":"s-nanqishu-059-western-polities-complete-ws1748911"},{"id":"c-nanqishu-059-western-polities-complete:p021","text":"文弘容納叛戾，專為淵藪，外侮皇威，內凌國族。君弈世忠款，深識理順，想即起義，應接大軍，共為掎角，討滅烏奴，剋建忠勤，茂立誠節。沈攸之資十年之積，權百旅之眾，師出境而城潰，兵未戰而自屠，朝廷無遺鏃之費，士民靡傷痍之弊。況蕞爾小豎，方之篾如，其取殲殄，豈延漏刻。忝以寡昧，分陝司蕃，清氛蕩穢，諒惟任職。此府器械山積，戈旗林聳，士卒剽勁，蓄銳權威，除難剿寇，豈俟徵習！但以剪伐萌菌，弗勞洪斧，撲彼蚊蚋，無假多力。皇上聖哲應期，恩澤廣被，罪止首惡，餘無所問。賞罰之科，具寫如別。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":53,"last_line":53,"raw_start":3611,"raw_end":3958,"raw_character_offsets":[3612,3613,3614,3615,3616,3617,3618,3619,3620,3621,3622,3623,3624,3625,3626,3627,3628,3629,3630,3631,3632,3633,3666,3667,3668,3669,3670,3671,3672,3673,3674,3675,3676,3677,3678,3679,3680,3681,3682,3683,3684,3685,3686,3687,3688,3689,3690,3691,3692,3693,3694,3695,3696,3697,3698,3699,3700,3701,3702,3703,3704,3705,3706,3707,3708,3709,3710,3711,3712,3713,3714,3715,3716,3717,3718,3719,3720,3721,3722,3723,3724,3725,3726,3727,3728,3729,3730,3731,3732,3733,3734,3735,3736,3737,3738,3739,3740,374