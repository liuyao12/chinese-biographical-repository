d":73,"surface":"帶","kind":"person","person_id":"cbr-p000242","status":"contextual_provisional","paragraph_id":"c-shiji-032-qi:p042","chapter_id":"c-shiji-032-qi"},{"id":"c-shiji-032-qi:m042-0085","start":85,"end":86,"surface":"帶","kind":"person","person_id":"cbr-p000242","status":"contextual_provisional","paragraph_id":"c-shiji-032-qi:p042","chapter_id":"c-shiji-032-qi"},{"id":"c-shiji-039-jin:m062-0037","start":37,"end":39,"surface":"弟帶","kind":"person","person_id":"cbr-p000242","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p062","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m065-0087","start":87,"end":90,"surface":"王弟帶","kind":"person","person_id":"cbr-p000242","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p065","chapter_id":"c-shiji-039-jin"}],"relations":[{"id":"a-shiji004-047","subject_person_id":"cbr-p000242","predicate":"mother","object_person_id":"cbr-p000241","status":"source_attested","evidence":[{"paragraph_id":"c-shiji-004-zhou:p050","quote":"惠后生叔帶","chapter_id":"c-shiji-004-zhou","source_id":"s-shiji-004-zhou"}],"qualifiers":{"source_term":"生","historicity":"historical_tradition"},"interpretation_note":"保存本文明示的親屬主張；不是獨立確證，不由繼位推導血緣。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji005-044","subject_person_id":"cbr-p000242","predicate":"brother","object_person_id":"cbr-p000240","status":"source_attested","evidence":[{"paragraph_id":"c-shiji-005-qin:p031","quote":"周襄王弟帶以翟伐王","chapter_id":"c-shiji-005-qin","source_id":"s-shiji-005-qin"}],"qualifiers":{"source_term":"弟","historicity":"historical_tradition"},"interpretation_note":"保存本文明示親屬主張；母弟原詞保留，不另補母親姓名。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji032-038","person_id":"cbr-p000242","surfaces":["帶"],"scope":"cross_chapter","chapter_ids":["c-shiji-004-zhou","c-shiji-032-qi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-004-zhou:p050","quote":"二十五年，惠王崩，子襄王鄭立。襄王母蚤死，後母曰惠后。惠后生叔帶，有寵於惠王，襄王畏之。三年，叔帶與戎、翟謀伐襄王，襄王欲誅叔帶，叔帶奔齊。齊桓公使管仲平戎于周，使隰朋平戎于晉。王以上卿禮管仲。管仲辭曰：「臣賤有司也，有天子之二守國、高在。若節春秋來承王命，何以禮焉。陪臣敢辭。」王曰：「舅氏，余嘉乃勳，毋逆朕命。」管仲卒受下卿之禮而還。九年，齊桓公卒。十二年，叔帶復歸于周。"},{"paragraph_id":"c-shiji-032-qi:p042","quote":"三十八年，周襄王弟帶與戎、翟合謀伐周，齊使管仲平戎於周。周欲以上卿禮管仲，管仲頓首曰：「臣陪臣，安敢！」三讓，乃受下卿禮以見。三十九年，周襄王弟帶來奔齊。齊使仲孫請王，為帶謝。襄王怒，弗聽。"}],"rationale":"按本篇小白立桓公、管仲任政、葵丘盟會及齊君／母親的明示敘事相接暫定；魯與齊的同號君主、同氏女性分開，不作全庫字串合併。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji039-021","person_id":"cbr-p000242","surfaces":["弟帶","王弟帶"],"scope":"cross_chapter","chapter_ids":["c-shiji-004-zhou","c-shiji-039-jin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-004-zhou:p050","quote":"二十五年，惠王崩，子襄王鄭立。襄王母蚤死，後母曰惠后。惠后生叔帶，有寵於惠王，襄王畏之。三年，叔帶與戎、翟謀伐襄王，襄王欲誅叔帶，叔帶奔齊。齊桓公使管仲平戎于周，使隰朋平戎于晉。王以上卿禮管仲。管仲辭曰：「臣賤有司也，有天子之二守國、高在。若節春秋來承王命，何以禮焉。陪臣敢辭。」王曰：「舅氏，余嘉乃勳，毋逆朕命。」管仲卒受下卿之禮而還。九年，齊桓公卒。十二年，叔帶復歸于周。"},{"paragraph_id":"c-shiji-039-jin:p062","quote":"文公修政，施惠百姓。賞從亡者及功臣，大者封邑，小者尊爵。未盡行賞，周襄王以弟帶難出居鄭地，來告急晉。晉初定，欲發兵，恐他亂起，是以賞從亡未至隱者介子推。推亦不言祿，祿亦不及。推曰：「獻公子九人，唯君在矣。惠、懷無親，外内棄之；天未絶晉，必將有主，主晉祀者，非君而誰？天實開之，二三子以爲己力，不亦誣乎？竊人之財，猶曰是盜，況貪天之功以爲己力乎？下冒其罪，上賞其姦，上下相蒙，難與處矣！」其母曰：「盍亦求之，以死誰懟？」推曰：「尤而效之，罪有甚焉。且出怨言，不食其祿。」母曰：「亦使知之，若何？」對曰：「言，身之文也；身欲隱，安用文之？文之，是求顯也。」其母曰：「能如此乎？與女偕隱。」至死不復見。"},{"paragraph_id":"c-shiji-039-jin:p065","quote":"二年春，秦軍河上，將入王。趙衰曰；「求霸莫如入王尊周。周晉同姓，晉不先入王，後秦入之，毋以令于天下。方今尊王，晉之資也。」三月甲辰，晉乃發兵至陽樊，圍温，入襄王于周。四月，殺王弟帶。周襄王賜晉河内陽樊之地。"}],"rationale":"按本篇明示名與稱號、晉世系與具體事件暫定所列提及同指；附各段原文，未按同字短名全域合併；紀年與版本差異待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-004-zhou:p050","text":"二十五年，惠王崩，子襄王鄭立。襄王母蚤死，後母曰惠后。惠后生叔帶，有寵於惠王，襄王畏之。三年，叔帶與戎、翟謀伐襄王，襄王欲誅叔帶，叔帶奔齊。齊桓公使管仲平戎于周，使隰朋平戎于晉。王以上卿禮管仲。管仲辭曰：「臣賤有司也，有天子之二守國、高在。若節春秋來承王命，何以禮焉。陪臣敢辭。」王曰：「舅氏，余嘉乃勳，毋逆朕命。」管仲卒受下卿之禮而還。九年，齊桓公卒。十二年，叔帶復歸于周。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-004-zhou:m050-0005","start":5,"end":7,"surface":"惠王","kind":"person","person_id":"cbr-p000236","status":"source_identified"},{"id":"c-shiji-004-zhou:m050-0010","st