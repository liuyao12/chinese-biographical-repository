nd":84,"surface":"隰朋","kind":"person","person_id":"cbr-p000244","status":"source_identified"},{"id":"c-shiji-004-zhou:m050-0094","start":94,"end":96,"surface":"管仲","kind":"person","person_id":"cbr-p000243","status":"source_identified"},{"id":"c-shiji-004-zhou:m050-0097","start":97,"end":99,"surface":"管仲","kind":"person","person_id":"cbr-p000243","status":"source_identified"},{"id":"c-shiji-004-zhou:m050-0115","start":115,"end":118,"surface":"國、高","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官號或文字疑讀；保留錨點，不補熟知姓名或假定同指。"},{"id":"c-shiji-004-zhou:m050-0144","start":144,"end":146,"surface":"舅氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官號或文字疑讀；保留錨點，不補熟知姓名或假定同指。"},{"id":"c-shiji-004-zhou:m050-0158","start":158,"end":160,"surface":"管仲","kind":"person","person_id":"cbr-p000243","status":"source_identified"},{"id":"c-shiji-004-zhou:m050-0172","start":172,"end":175,"surface":"齊桓公","kind":"person","person_id":"cbr-p000235","status":"source_identified"},{"id":"c-shiji-004-zhou:m050-0181","start":181,"end":183,"surface":"叔帶","kind":"person","person_id":"cbr-p000242","status":"source_identified"}],"chapter_id":"c-shiji-004-zhou","book_id":"b-shiji-004","work_id":"w-shiji","source_id":"s-shiji-004-zhou"},{"id":"c-shiji-004-zhou:p052","text":"初，惠后欲立王子帶，故以黨開翟人，翟人遂入周。襄王出奔鄭，鄭居王于汜。子帶立為王，取襄王所絀翟后與居溫。十七年，襄王告急于晉，晉文公納王而誅叔帶。襄王乃賜晉文公珪鬯弓矢，為伯，以河內地與晉。二十年，晉文公召襄王，襄王會之河陽、踐土，諸侯畢朝，書諱曰「天王狩于河陽」。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-004-zhou:m052-0002","start":2,"end":4,"surface":"惠后","kind":"person","person_id":"cbr-p000241","status":"source_identified"},{"id":"c-shiji-004-zhou:m052-0006","start":6,"end":9,"surface":"王子帶","kind":"person","person_id":"cbr-p000242","status":"source_identified"},{"id":"c-shiji-004-zhou:m052-0023","start":23,"end":25,"surface":"襄王","kind":"person","person_id":"cbr-p000240","status":"source_identified"},{"id":"c-shiji-004-zhou:m052-0035","start":35,"end":37,"surface":"子帶","kind":"person","person_id":"cbr-p000242","status":"source_identified"},{"id":"c-shiji-004-zhou:m052-0042","start":42,"end":44,"surface":"襄王","kind":"person","person_id":"cbr-p000240","status":"source_identified"},{"id":"c-shiji-004-zhou:m052-0046","start":46,"end":48,"surface":"翟后","kind":"person","person_id":"cbr-p000250","status":"source_identified"},{"id":"c-shiji-004-zhou:m052-0056","start":56,"end":58,"surface":"襄王","kind":"person","person_id":"cbr-p000240","status":"source_identified"},{"id":"c-shiji-004-zhou:m052-0063","start":63,"end":66,"surface":"晉文公","kind":"person","person_id":"cbr-p000252","status":"source_identified"},{"id":"c-shiji-004-zhou:m052-0070","start":70,"end":72,"surface":"叔帶","kind":"person","person_id":"cbr-p000242","status":"source_identified"},{"id":"c-shiji-004-zhou:m052-0073","start":73,"end":75,"surface":"襄王","kind":"person","person_id":"cbr-p000240","status":"source_identified"},{"id":"c-shiji-004-zhou:m052-0077","start":77,"end":80,"surface":"晉文公","kind":"person","person_id":"cbr-p000252","status":"source_identified"},{"id":"c-shiji-004-zhou:m052-0099","start":99,"end":102,"surface":"晉文公","kind":"person","person_id":"cbr-p000252","status":"source_identified"},{"id":"c-shiji-004-zhou:m052-0103","start":103,"end":105,"surface":"襄王","kind":"person","person_id":"cbr-p000240","status":"source_identified"},{"id":"c-shiji-004-zhou:m052-0106","start":106,"end":108,"surface":"襄王","kind":"person","person_id":"cbr-p000240","status":"source_identified"}],"chapter_id":"c-shiji-004-zhou","book_id":"b-shiji-004","work_id":"w-shiji","source_id":"s-shiji-004-zhou"},{"id":"c-shiji-005-qin:p031","text":"其秋，周襄王弟帶以翟伐王，王出居鄭。二十五年，周王使人告難於晉、秦。秦繆公將兵助晉文公入襄王，殺王弟帶。二十八年，晉文公敗楚於城濮。三十年，繆公助晉文公圍鄭。鄭使人言繆公曰：「亡鄭厚晉，於晉而得矣，而秦未有利。晉之彊，秦之憂也。」繆公乃罷兵歸。晉亦罷。三十二年冬，晉文公卒。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m031-0003","start":3,"end":6,"surface":"周襄王","kind":"person","person_id":"cbr-p000240","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m031-0006","start":6,"end":8,"surface":"弟帶","kind":"person","person_id":"cbr-p000242","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m031-0023","start":23,"end":25,"surface":"周王","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或待核指代；不由官稱或熟知世系補造個人。"},{"id":"c-shiji-005-qin:m031-0025","start":25,"end":27,"surface":"使人","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或待核指代；不由官稱或熟知世系補造個人。"},{"id":"c-shiji-005-qin:m031-0034","start":34,"end":37,"surface":"秦繆公","kind":"person","person_id":"cbr-p000253","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m031-0040","start":40,"end":43,"surface":"晉文公","kind":"person","person_id":"cbr-p000252","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m031-0044","start":44,"end":46,"surface":"襄王","kind":"person","person_id":"cbr-p000240","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m031-0049","start":49,"end":51,"surface":"弟帶","kind":"person","person_id":"cbr-p000242","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m031-0057","start":57,"end":60,"surface":"晉文公","kind":"person","person_id":"cbr-p000252","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m031-0070","start":70,"end":72,"surface":"繆公","kind":"person","person_id":"cbr-p000253","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m031-0073","start":73,"end":76,"surface":"晉文公","kind":"person","person_id":"cbr-p000252","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m031-0080","start":80,"end":82,"surface":"使人","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或待核指代；不由官稱或熟知世系補造個人。"},{"id":"c-shiji-005-qin:m031-0083","start":83,"end":85,"surface":"繆公","kind":"person","person_id":"cbr-p000253","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m031-0115","start":115,"end":117,"surface":"繆公","kind":"person","person_id":"cbr-p000253","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m031-0132","start":132,"end":135,"surface":"晉文公","kind":"person","person_id":"cbr-p000252","status":"contextual_provisional"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-032-qi:p042","text":"三十八年，周襄王弟帶與戎、翟合謀伐周，齊使管仲平戎於周。周欲以上卿禮管仲，管仲頓首曰：「臣陪臣，安敢！」三讓，乃受下卿禮以見。三十九年，周襄王弟帶來奔齊。齊使仲孫請王，為帶謝。襄王怒，弗聽。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-032-qi:m042-0005","start":5,"end":8,"surface":"周襄王","kind":"person","person_id":"cbr-p000240","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m042-0009","start":9,"end":10,"surface":"帶","kind":"person","person_id":"cbr-p000242","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m042-0021","start":21,"end":23,"surface":"管仲","kind":"person","person_id":"cbr-p000243","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m042-0031","start":31,"end":33,"surface":"上卿","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、族稱或未定指代，不補未見姓名與成員；官禮等級不直接當授官。"},{"id":"c-shiji-032-qi:m042-0034","start":34,"end":36,"surface":"管仲","kind":"person","person_id":"cbr-p000243","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m042-0037","start":37,"end":39,"surface":"管仲","kind":"person","person_id":"cbr-p000243","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m042-0057","start":57,"end":59,"surface":"下卿","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、族稱或未定指代，不補未見姓名與成員；官禮等級不直接當授官。"},{"id":"c-shiji-032-qi:m042-0068","start":68,"end":71,"surface":"周襄王","kind":"person","person_id":"cbr-p000240","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m042-0072","start":72,"end":73,"surface":"帶","kind":"person","person_id":"cbr-p000242","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m042-0079","start":79,"end":81,"surface":"仲孫","kind":"person","person_id":"cbr-p001120","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m042-0085","start":85,"end":86,"surface":"帶","kind":"person","person_id":"cbr-p000242","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m042-0088","start":88,"end":90,"surface":"襄王","kind":"person","person_id":"cbr-p000240","status":"contextual_provisional"}],"chapter_id":"c-shiji-032-qi","book_id":"b-shiji-032","work_id":"w-shiji","source_id":"s-shiji-032-qi"},{"id":"c-shiji-039-jin:p062","text":"文公修政，施惠百姓。賞從亡者及功臣，大者封邑，小者尊爵。未盡行賞，周襄王以弟帶難出居鄭地，來告急晉。晉初定，欲發兵，恐他亂起，是以賞從亡未至隱者介子推。推亦不言祿，祿亦不及。推曰：「獻公子九人，唯君在矣。惠、懷無親，外内棄之；天未絶晉，必將有主，主晉祀者，非君而誰？天實開之，二三子以爲己力，不亦誣乎？竊人之財，猶曰是盜，況貪天之功以爲己力乎？下冒其罪，上賞其姦，上下相蒙，難與處矣！」其母曰：「盍亦求之，以死誰懟？」推曰：「尤而效之，罪有甚焉。且出怨言，不食其祿。」母曰：「亦使知之，若何？」對曰：「言，身之文也；身欲隱，安用文之？文之，是求顯也。」其母曰：「能如此乎？與女偕隱。」至死不復見。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m062-0000","start":0,"end":2,"surface":"文公","kind":"person","person_id":"cbr-p000252","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m062-0033","start":33,"end":36,"surface":"周襄王","kind":"person","person_id":"cbr-p000240","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m062-0037","start":37,"end":39,"surface":"弟帶","kind":"person","person_id":"cbr-p000242","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m062-0072","start":72,"end":75,"surface":"介子推","kind":"person","person_id":"cbr-p001753","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m062-0076","start":76,"end":77,"surface":"推","kind":"person","person_id":"cbr-p001753","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m062-0087","start":87,"end":88,"surface":"推","kind":"person","person_id":"cbr-p001753","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m062-0091","start":91,"end":93,"surface":"獻公","kind":"person","person_id":"cbr-p000374","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m062-0138","start":138,"end":141,"surface":"二三子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m062-0193","start":193,"end":195,"surface":"其母","kind":"person","person_id":"cbr-p001755","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m062-0209","start":209,"end":210,"surface":"推","kind":"person","person_id":"cbr-p001753","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m062-0234","start":234,"end":235,"surface":"母","kind":"person","person_id":"cbr-p001755","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m062-0276","start":276,"end":278,"surface":"其母","kind":"person","person_id":"cbr-p001755","status":"contextual_provisional"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"},{"id":"c-shiji-039-jin:p065","text":"二年春，秦軍河上，將入王。趙衰曰；「求霸莫如入王尊周。周晉同姓，晉不先入王，後秦入之，毋以令于天下。方今尊王，晉之資也。」三月甲辰，晉乃發兵至陽樊，圍温，入襄王于周。四月，殺王弟帶。周襄王賜晉河内陽樊之地。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m065-0013","start":13,"end":15,"surface":"趙衰","kind":"person","person_id":"cbr-p000329","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m065-0078","start":78,"end":80,"surface":"襄王","kind":"person","person_id":"cbr-p000240","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m065-0087","start":87,"end":90,"surface":"王弟帶","kind":"person","person_id":"cbr-p000242","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m065-0091","start":91,"end":94,"surface":"周襄王","kind":"person","person_id":"cbr-p000240","status":"contextual_provisional"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"}],"sources":[{"chapter_id":"c-shiji-004-zhou","work_id":"w-shiji","book_id":"b-shiji-004","source_id":"s-shiji-004-zhou","source":{"title":"史記／卷004","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷004","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷004&oldid=7909147","revision_id":7909147,"accessed_on":"2026-10-09","extent":"正文全文；排除註釋版導覽、現代節標題與註號；行內校勘標記另存。","image_verified":false,"rights":"古代原文；數位轉錄