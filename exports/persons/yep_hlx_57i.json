n_id":"yep_hlx_57i","status":"contextual_provisional","paragraph_id":"c-shiji-121-rulin:p009","chapter_id":"c-shiji-121-rulin"}],"relations":[],"title_holdings":[{"id":"th-shiji121-021","person_id":"yep_hlx_57i","title":"膠東內史","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-121-rulin","source_id":"s-shiji121-rulin","paragraph_id":"c-shiji-121-rulin:p009","quote":"弟子為博士者十餘人：孔安國至臨淮太守，周霸至膠西內史，夏寬至城陽內史，碭魯賜至東海太守，蘭陵繆生至長沙內史，徐偃為膠西中尉，鄒人闕門慶忌為膠東內史。其治官民皆有廉節，稱其好學。學官弟子行雖不備，而至於大夫、郎中、掌故以百數。言詩雖殊，多本於申公。"}],"attestations":[{"id":"th-shiji121-021:a001","paragraph_id":"c-shiji-121-rulin:p009","start":69,"end":73,"surface":"膠東內史","person_mention_id":"c-shiji-121-rulin:m009-0064","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"依原文區分授任、貶任與用稱；未明日期保持未知，死亡不自動終止官爵。敘事時長不反推公元年。","reviewer":"Codex（AI 代理）"}],"address_assertions":[{"id":"pa-shiji121-006","person_id":"yep_hlx_57i","relation":"biographical_origin","place":{"source_name":"鄒","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-121-rulin","source_id":"s-shiji121-rulin","paragraph_id":"c-shiji-121-rulin:p009","quote":"弟子為博士者十餘人：孔安國至臨淮太守，周霸至膠西內史，夏寬至城陽內史，碭魯賜至東海太守，蘭陵繆生至長沙內史，徐偃為膠西中尉，鄒人闕門慶忌為膠東內史。其治官民皆有廉節，稱其好學。學官弟子行雖不備，而至於大夫、郎中、掌故以百數。言詩雖殊，多本於申公。"}],"source_term":"鄒人闕門慶忌","interpretation_note":"保留人物介紹中的人地原稱，不推定出生地、居住日期或現代轄區。相鄰人物不自動承受同一原籍。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"identity_distinctions":[{"id":"pd-shiji117-qingji-not-rulin","person_ids":["n7l_j5p_4wl","yep_hlx_57i"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-117-xiangru:p045","quote":"相如口吃而善著書。常有消渴疾。與卓氏婚，饒於財。其進仕宦，未嘗肯與公卿國家之事，稱病間居，不慕官爵。常從上至長楊獵，是時天子方好自擊熊彘，馳逐野獸，相如上疏諫之。其辭曰：\n臣聞物有同類而殊能者，故力稱烏獲，捷言慶忌，勇期賁、育。臣之愚，竊以為人誠有之，獸亦宜然。今陛下好陵阻險，射猛獸，卒然遇軼材之獸，駭不存之地，犯屬車之清塵，輿不及還轅，人不暇施巧，雖有烏獲、逢蒙之伎，力不得用，枯木朽株盡為害矣。是胡越起於轂下，而羌夷接軫也，豈不殆哉！雖萬全無患，然本非天子之所宜近也。","chapter_id":"c-shiji-117-xiangru","work_id":"w-shiji","book_id":"b-shiji-117","source_id":"s-shiji117-xiangru"},{"paragraph_id":"c-shiji-121-rulin:p009","quote":"弟子為博士者十餘人：孔安國至臨淮太守，周霸至膠西內史，夏寬至城陽內史，碭魯賜至東海太守，蘭陵繆生至長沙內史，徐偃為膠西中尉，鄒人闕門慶忌為膠東內史。其治官民皆有廉節，稱其好學。學官弟子行雖不備，而至於大夫、郎中、掌故以百數。言詩雖殊，多本於申公。","chapter_id":"c-shiji-121-rulin","work_id":"w-shiji","book_id":"b-shiji-121","source_id":"s-shiji121-rulin"}],"rationale":"本篇以勇捷稱古人慶忌，古注繫吳王僚之子；儒林篇闕門慶忌在申公弟子名單中任膠東內史，人物時代、名號及敘事不同，分開保留。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"passages":[{"id":"c-shiji-117-xiangru:p045","text":"相如口吃而善著書。常有消渴疾。與卓氏婚，饒於財。其進仕宦，未嘗肯與公卿國家之事，稱病間居，不慕官爵。常從上至長楊獵，是時天子方好自擊熊彘，馳逐野獸，相如上疏諫之。其辭曰：\n臣聞物有同類而殊能者，故力稱烏獲，捷言慶忌，勇期賁、育。臣之愚，竊以為人誠有之，獸亦宜然。今陛下好陵阻險，射猛獸，卒然遇軼材之獸，駭不存之地，犯屬車之清塵，輿不及還轅，人不暇施巧，雖有烏獲、逢蒙之伎，力不得用，枯木朽株盡為害矣。是胡越起於轂下，而羌夷接軫也，豈不殆哉！雖萬全無患，然本非天子之所宜近也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m045-0000","start":0,"end":2,"surface":"相如","kind":"person","person_id":"usb_lgr_ksa","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0016","start":16,"end":18,"surface":"卓氏","kind":"person","person_id":"2ph_uqm_vm3","status":"contextual_provisional","interpretation_note":"依開篇文君婚姻與卓王孫女尚長卿的連續敘事暫接；不把所有卓氏都當文君，篇末未名妻另留候選。"},{"id":"c-shiji-117-xiangru:m045-0052","start":52,"end":53,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0060","start":60,"end":62,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0074","start":74,"end":76,"surface":"相如","kind":"person","person_id":"usb_lgr_ksa","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0100"