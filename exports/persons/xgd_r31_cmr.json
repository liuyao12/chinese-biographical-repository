us/shiji/004.json"},{"paragraph_id":"c-shiji-039-jin:p120","quote_passage_ref":"data/corpus/shiji/039.json"}],"rationale":"按本篇明示名與稱號、晉世系與具體事件暫定所列提及同指；附各段原文，未按同字短名全域合併；紀年與版本差異待核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji079-035","person_id":"xgd_r31_cmr","surfaces":["崔杼"],"scope":"same_chapter","chapter_ids":["c-shiji-079-fancai"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-079-fancai:p017","quote_passage_ref":"data/corpus/shiji/079.json"}],"rationale":"按全35段明示姓名與局部引語暫接，范睢張祿范叔范君應侯分說話範圍；蔡澤先生綱成君依具體敘事。越王事大夫種與句踐敘事相配，更新候選標籤保留ID。馬服／馬服子依同段長平角色暫接未補姓名，第32段白公已按四子敘事及集解釋名暫接白起，韓子未強接韓非，喬松不補神仙，范中行族稱不接范睢。王之弟、改讀前止足及引古異說各留，預言與擬議方案不當史實核定。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji079-cuizhu","person_ids":["xgd_r31_cmr"],"canonical_person_id":"xgd_r31_cmr","scope":"cross_chapter","chapter_ids":["c-shiji-079-fancai","c-shiji-032-qi"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-079-fancai","source_id":"s-shiji-079-fancai","paragraph_id":"c-shiji-079-fancai:p017","mention_ids":["c-shiji-079-fancai:m017-0286"],"quote_passage_ref":"data/corpus/shiji/079.json"},{"chapter_id":"c-shiji-032-qi","source_id":"s-shiji-032-qi","paragraph_id":"c-shiji-032-qi:p063","mention_ids":["c-shiji-032-qi:m063-0014","c-shiji-032-qi:m063-0030","c-shiji-032-qi:m063-0046","c-shiji-032-qi:m063-0082","c-shiji-032-qi:m063-0105","c-shiji-032-qi:m063-0118","c-shiji-032-qi:m063-0124","c-shiji-032-qi:m063-0128","c-shiji-032-qi:m063-0135","c-shiji-032-qi:m063-0163","c-shiji-032-qi:m063-0253","c-shiji-032-qi:m063-0314","c-shiji-032-qi:m063-0323"],"quote_passage_ref":"data/corpus/shiji/032.json"},{"chapter_id":"c-shiji-032-qi","source_id":"s-shiji-032-qi","paragraph_id":"c-shiji-032-qi:p064","mention_ids":["c-shiji-032-qi:m064-0003","c-shiji-032-qi:m064-0036","c-shiji-032-qi:m064-0106","c-shiji-032-qi:m064-0125","c-shiji-032-qi:m064-0132","c-shiji-032-qi:m064-0142","c-shiji-032-qi:m064-0153"],"quote_passage_ref":"data/corpus/shiji/032.json"}],"r