:[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"id":"name-jin098-durui-literal","person_id":"t4f_ks6_8r3","surname":"杜","ming":"蕤","hao":null,"title":null,"additional_names":[],"chapter_id":"c-jinshu-098-wangdun-comparison","paragraph_id":"c-jinshu-098-wangdun-comparison:p001","person_mention_id":"c-jinshu-098-wangdun-comparison:p001:m0265","source_anchor":{"start":265,"end":267,"surface":"杜蕤"},"quote":"王敦，字處仲，司徒導之從父兄也。父基，治書侍御史。敦少有奇人之目，尚武帝女襄城公主，拜駙馬都尉，除太子舍人。時王愷、石崇以豪侈相尚，愷嘗置酒，敦與導俱在坐，有女伎吹笛小失聲韻，愷便驅殺之，一坐改容，敦神色自若。他日，又造愷，愷使美人行酒，以客飲不盡，輒殺之。酒至敦、導所，敦故不肯持，美人悲懼失色，而敦傲然不視。導素不能飲，恐行酒者得罪，遂勉強盡觴。導還，歎曰：「處仲若當世，心懷剛忍，非令終也。」洗馬潘滔見敦而目之曰：「處仲蜂目已露，但豺聲未振，若不噬人，亦當為人所噬。」及太子遷許昌，詔東宮官屬不得送。敦及洗馬江統、潘滔，舍人杜蕤、魯瑤等，冒禁于路側望拜流涕，時論稱之。遷給事黃門侍郎。","status":"source_attested","human_reviewed":false,"model":null,"work_id":"w-jinshu","book_id":"b-jinshu-098","source_id":"s-jinshu098-wangdun-ws2614273-comparison"}],"mentions":[{"id":"c-jinshu-098-wangdun-comparison:p001:m0265","start":265,"end":267,"surface":"杜蕤","person_id":"t4f_ks6_8r3","kind":"person","paragraph_id":"c-jinshu-098-wangdun-comparison:p001","chapter_id":"c-jinshu-098-wangdun-comparison"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-098-wangdun-comparison:p001","text":"王敦，字處仲，司徒導之從父兄也。父基，治書侍御史。敦少有奇人之目，尚武帝女襄城公主，拜駙馬都尉，除太子舍人。時王愷、石崇以豪侈相尚，愷嘗置酒，敦與導俱在坐，有女伎吹笛小失聲韻，愷便驅殺之，一坐改容，敦神色自若。他日，又造愷，愷使美人行酒，以客飲不盡，輒殺之。酒至敦、導所，敦故不肯持，美人悲懼失色，而敦傲然不視。導素不能飲，恐行酒者得罪，遂勉強盡觴。導還，歎曰：「處仲若當世，心懷剛忍，非令終也。」洗馬潘滔見敦而目之曰：「處仲蜂目已露，但豺聲未振，若不噬人，亦當為人所噬。」及太子遷許昌，詔東宮官屬不得送。敦及洗馬江統、潘滔，舍人杜蕤、魯瑤等，冒禁于路側望拜流涕，時論稱之。遷給事黃門侍郎。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","source_position":{"first_line":11,"last_line":11,"revision_id"