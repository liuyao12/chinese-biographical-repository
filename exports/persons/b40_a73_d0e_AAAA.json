ge_verified":false}],"calendar_context":{"context_id":"cal-context-phase5-002","event_anchor":{"paragraph_id":"c-zizhitongjian-094-xiyang-kinship:line126","start":127,"end":130,"surface":"彭城王"}},"rationale":"年數依獨立固定來源語境；僅適用精確事件錨點，正文不補字。","reviewer":"Codex","human_reviewed":false,"model":null,"record_id":"th-phase4-t-003","person_id":"b40_a73_d0e_AAAA","attestation_id":"th-phase4-t-003:a001","date_role":"attestation","title":"彭城王"}],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-phase5-037-雄","person_id":"b40_a73_d0e_AAAA","surfaces":["雄"],"scope":"same_chapter","chapter_ids":["c-jinshu-037-phase5-pengcheng"],"status":"contextual_provisional","confidence_level":"moderate","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-037","source_id":"s-jinshu-037-phase5","chapter_id":"c-jinshu-037-phase5-pengcheng","paragraph_id":"c-jinshu-037-phase5-pengcheng:line100","quote":"彭城穆王權，字子輿，宣帝弟魏魯相東武城侯馗之子也。初襲封，拜冗從僕射。武帝受禪，封彭城王，邑二千九百戶。出為北中郎將、都督鄴城守諸軍事。泰始中入朝，賜袞冕之服。咸甯元年薨，子元王植立。歷位後將軍，尋拜國子祭酒、太僕卿、侍中、尚書。出為安東將軍、都督揚州諸軍事，代淮南王允鎮壽春，未發。或云植助允攻趙王倫，遂以憂薨。贈車騎將軍，增封萬五千戶。子康王釋立，官至南中郎將、持節、平南將軍，分魯國蕃、薛二縣以益其國，心二萬三千戶。薨，子雄立，坐奔蘇峻伏誅，更以釋子紘嗣。","person_mention_id":"c-jinshu-037-phase5-pengcheng:line100:m0214"}],"rationale":"依完整同段主語、親屬及事件辨識短稱；已有人物須同一蘇峻亂、彭城王系或相同君主脈絡，不以同名合併。馗、權、植、釋的局部父系獨立於馗接防的跨篇推論。","references":[],"reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"d-phase4-094-091_375_923","person_id":"b40_a73_d0e_AAAA","surfaces":["彭城王雄"],"scope":"same_chapter","chapter_ids":["c-zizhitongjian-094-xiyang-kinship"],"status":"contextual_provisional","confidence_level":"moderate","evidence":[{"work_id":"w-zizhitongjian","book_id":"b-zizhitongjian-094","source_id":"s-zizhitongjian-094-xiyang-kinship","chapter_id":"c-zizhitongjian-094-xiyang-kinship","paragraph_id":"c-zizhitongjian-094-xiyang-kinship:line126","quote":"二月，丙戌，諸軍攻石頭。建成長史滕含擊蘇逸，大破之。蘇碩帥驍勇數百，渡准而戰，溫嶠擊斬之。韓晃等懼，以其眾就張健於曲阿，門隘不得出，更相蹈藉，死者萬數。西軍獲蘇逸，斬之。滕含部將曹據抱帝奔溫嶠船，群臣見帝，頓首號泣請罪。殺西陽王羕，並其二子播、充、孫崧及彭城王雄。陶侃與任讓有舊，為請其死。帝曰：「是殺吾侍中、右衛者，不可赦也。」乃殺之。司徒導入石頭，令取故節，陶侃笑曰：「蘇武節似不如是。」導有慚色。丁亥，大赦。","person_mention_id":"c-zizhitongjian-094-xiyang-kinship:line126:m0127"}],"rationale":"同段明名及敘事主語承接；不擴張其他家系。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-037-phase5-pengcheng:line100","text":"彭城穆王權，字子輿，宣帝弟魏魯相東武城侯馗之子也。初襲封，拜冗從僕射。武帝受禪，封彭城王，邑二千九百戶。出為北中郎將、都督鄴城守諸軍事。泰始中入朝，賜袞冕之服。咸甯元年薨，子元王植立。歷位後將軍，尋拜國子祭酒、太僕卿、侍中、尚書。出為安東將軍、都督揚州諸軍事，代淮南王允鎮壽春，未發。或云植助允攻趙王倫，遂以憂薨。贈車騎將軍，增封萬五千戶。子康王釋立，官至南中郎將、持節、平南將軍，分魯國蕃、薛二縣以益其國，心二萬三千戶。薨，子雄立，坐奔蘇峻伏誅，更以釋子紘嗣。","mentions":[{"id":"c-jinshu-037-phase5-pengcheng:line100:m0000","start":0,"end":5,"surface":"彭城穆王權","kind":"person","person_id":"b40_a73_d0e_A"},{"id":"c-jinshu-037-phase5-pengcheng:line100:m0007","start":7,"end":9,"surface":"子輿","kind":"person","person_id":"b40_a73_d0e_A"},{"id":"c-jinshu-037-phase5-pengcheng:line100:m0010","start":10,"end":12,"surface":"宣帝","kind":"person","person_id":"dkn_ge4_286_AAAA"},{"id":"c-jinshu-037-phase5-pengcheng:line100:m0020","start":20,"end":21,"surface":"馗","kind":"person","person_id":"b40_a73_d0e"},{"id":"c-jinshu-037-phase5-pengcheng:line100:m0035","start":35,"end":37,"surface":"武帝","kind":"person","person_id":"hgm_jvn_hle"},{"id":"c-jinshu-037-phase5-pengcheng:line100:m0087","start":87,"end":90,"surface":"元王植","kind":"person","person_id":"b40_a73_d0e_AA"},{"id":"c-jinshu-037-phase5-pengcheng:line100:m0131","start":131,"end":135,"surface":"淮南王允","kind":"person","person_id":"3ab_c04_e8d"},{"id":"c-jinshu-037-phase5-pengcheng:line100:m0142","start":142,"end":143,"surface":"或","kind":"unresolved","person_id":null,"status":"unresolved","resolution_note":"未名記述者；或云為來源限定詞，不定成具名作者。"},{"id":"c-jinshu-037-phase5-pengcheng:line100:m0144","start":144,"end":145,"surface":"植","kind":"person","person_id":"b40_a73_d0e_AA"},{"id":"c-jinshu-037-phase5-pengcheng:line100:m0146","start":146,"end":147,"surface":"允","kind":"person","person_id":"3ab_c04_e8d"},{"id":"c-jinshu-037-phase5-pengch