["c-jinshu-076-wangyi-family:p002:m0081"],"paragraph_ids":["c-jinshu-076-wangyi-family:p002"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-076-wangyi-family:p002:m0081","mention_ids":["c-jinshu-076-wangyi-family:p002:m0081"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-061-ws7903772","s-jinshu098-wangdun-ws2614273-comparison"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"id":"name-jin098-ganzhuo-literal","person_id":"csn_tgm_oe7","surname":"甘","ming":"卓","hao":null,"title":null,"additional_names":[],"chapter_id":"c-jinshu-098-wangdun-comparison","paragraph_id":"c-jinshu-098-wangdun-comparison:p002","person_mention_id":"c-jinshu-098-wangdun-comparison:p002:m0364","source_anchor":{"start":364,"end":366,"surface":"甘卓"},"quote":"趙王倫篡位，敦叔父彥為兗州刺史，倫遣敦慰勞之。會諸王起義兵；彥被齊王冏檄，懼倫兵強，不敢應命，敦勸彥起兵應諸王，故彥遂立勳績。惠帝反正，敦遷散騎常侍、左衛將軍、大鴻臚、侍中，出除廣武將軍、青州刺史。永嘉初，徵為中書監。于時天下大亂，敦悉以公主時侍婢百餘人配給將士，金銀寶物散之於眾，單車還洛。東海王越自滎陽來朝，敦謂所親曰：「今威權悉在太傅，而選用表情，尚書猶以舊制裁之，太傅今至，必有誅罰。」俄而越收中書令繆播等十餘人殺之。越以敦為揚州刺史，潘滔說越曰：「今樹處仲于江外，使其肆豪強之心，是見賊也。」越不從。其後徵拜尚書，不就。元帝召為安東軍諮祭酒。會揚州刺史劉陶卒，帝復以敦為揚州刺史，加廣武將軍。尋進左將軍、都督征討諸軍事、假節。帝初鎮江東，威名未著，敦與從弟導等同心翼戴，以隆中興，時人為之語曰：「王與馬，共天下。」尋與甘卓等討江州刺史華軼，斬之。","status":"source_attested","human_reviewed":false,"model":null,"work_id":"w-jinshu","book_id":"b-jinshu-098","source_id":"s-jinshu098-wangdun-ws2614273-comparison"}],"mentions":[{"id":"c-jinshu-061-zhou-family:p017:m0122","start":122,"end":124,"surface":"甘卓","kind":"person","person_id":"csn_tgm_oe7","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。","paragraph_id":"c-jinshu-061-zhou-family:p017","chapter_id":"c-jinshu-061-zhou-family"},{"id":"c-jinshu-061-zhou-family:p023:m0098","start":98,"end":100,"surface":"甘卓","kind":"person","person_id":"csn_tgm_oe7","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。","paragraph_id":"c-jinshu-061-zhou-family:p023","chapter_id":"c-jinshu-061-zhou-family"},{"id":"c-jinshu-076-wangyi-family:p002:m0081","start":81,"end":83,"surface":"甘卓","kind":"person","person_id":"csn_tgm_oe7","status":"contextual_provisional","paragraph_id":"c-jinshu-076-wangyi-family:p002","chapter_id":"c-jinshu-076-wangyi-family"},{"id":"c-jinshu-098-wangdun-comparison:p002:m0364","start":364,"end":366,"surface":"甘卓","person_id":"csn_tgm_oe7","kind":"person","paragraph_id":"c-jinshu-098-wangdun-comparison:p002","chapter_id":"c-jinshu-098-wangdun-comparison"},{"id":"c-jinshu-098-wangdun-comparison:p011:m0153","start":153,"end":155,"surface":"甘卓","person_id":"csn_tgm_oe7","kind":"person","paragraph_id":"c-jinshu-098-wangdun-comparison:p011","chapter_id":"c-jinshu-098-wangdun-comparison"}],"relations":[],"title_holdings":[{"id":"th-jinshu076-wang-013","person_id":"csn_tgm_oe7","title":"湘州刺史","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-076","chapter_id":"c-jinshu-076-wangyi-family","source_id":"s-jinshu-076-wangyi-family","paragraph_id":"c-jinshu-076-wangyi-family:p002","quote":"初，王敦左遷陶侃，使廙代為荊州。將吏馬俊、鄭攀等上書請留侃，敦不許。廙為俊等所襲，奔于江安。賊杜曾與俊、攀北迎第五猗以距廙。廙督諸軍討曾，又為曾所敗。敦命湘州刺史甘卓、豫章太守周廣等助廙擊曾，曾衆潰，廙得到州。廙性俊率，嘗從南下，旦自尋陽，迅風飛帆，暮至都，倚舫樓長嘯，神氣甚逸。王導謂庾亮曰：「世將為傷時識事。」亮曰：「正足舒其逸氣耳。」廙在州大誅戮侃時將佐，及征士皇甫方回，於是大失荊土之望，人情乖阻。帝乃征廙為輔國將軍，加散騎常侍。以母喪去職。服闋，拜征虜將軍，進左衛將軍。","person_mention_id":"c-jinshu-076-wangyi-family:p002:m0081"}],"attestations":[{"id":"th-jinshu076-wang-013:a001","paragraph_id":"c-jinshu-076-wangyi-family:p002","start":77,"end":81,"surface":"湘州刺史","person_mention_id":"c-jinshu-076-wangyi-family:p002:m0081","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"只按本段任官、授爵或用稱；未知起訖不補。義熙末保留晚期原語，不選定某一年。未將疑缺平南將領字串補成平南將軍。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-jin098-ganzhuo","person_id":"csn_tgm_oe7","surfaces":["甘卓"],"scope":"cross_chapter","chapter_ids":["c-jinshu-098-wangdun-comparison","c-jinshu-076-wangyi-family"],"status":"contextual_provisional","confidence_level":"moderate","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-098","source_id":"s-jinshu098-wangdun-ws2614273-comparison","chapter_id":"c-jinshu-098-wangdun-comparison","paragraph_id":"c-jinshu-098-wangdun-comparison:p002","quote":"趙王倫篡位，敦叔父彥為兗州刺史，倫遣敦慰勞之。會諸王起義兵；彥被齊王冏檄，懼倫兵強，不敢應命，敦勸彥起兵應諸王，故彥遂立勳績。惠帝反正，敦遷散騎常侍、左衛將軍、大鴻臚、侍中，出除廣武將軍、青州刺史。永嘉初，徵為中書監。于時天下大亂，敦悉以公主時侍婢百餘人配給將士，金銀寶物散之於眾，單車還洛。東海王越自滎陽來朝，敦謂所親曰：「今威權悉在太傅，而選用表情，尚書猶以舊制裁之，太傅今至，必有誅罰。」俄而越收中書令繆播等十餘人殺之。越以敦為揚州刺史，潘滔說越曰：「今樹處仲于江外，使其肆豪強之心，是見賊也。」越不從。其後徵拜尚書，不就。元帝召為安東軍諮祭酒。會揚州刺史劉陶卒，帝復以敦為揚州刺史，加廣武將軍。尋進左將軍、都督征討諸軍事、假節。帝初鎮江東，威名未著，敦與從弟導等同心翼戴，以隆中興，時人為之語曰：「王與馬，共天下。」尋與甘卓等討江州刺史華軼，斬之。","mention_ids":["c-jinshu-098-wangdun-comparison:p002:m0364"]},{"work_id":"w-jinshu","book_id":"b-jinshu-076","source_id":"s-jinshu-076-wangyi-family","chapter_id":"c-jinshu-076-wangyi-family","paragraph_id":"c-jinshu-076-wangyi-family:p002","quote":"初，王敦左遷陶侃，使廙代為荊州。將吏馬俊、鄭攀等上書請留侃，敦不許。廙為俊等所襲，奔于江安。賊杜曾與俊、攀北迎第五猗以距廙。廙督諸軍討曾，又為曾所敗。敦命湘州刺史甘卓、豫章太守周廣等助廙擊曾，曾衆潰，廙得到州。廙性俊率，嘗從南下，旦自尋陽，迅風飛帆，暮至都，倚舫樓長嘯，神氣甚逸。王導謂庾亮曰：「世將為傷時識事。」亮曰：「正足舒其逸氣耳。」廙在州大誅戮侃時將佐，及征士皇甫方回，於是大失荊土之望，人情乖阻。帝乃征廙為輔國將軍，加散騎常侍。以母喪去職。服闋，拜征虜將軍，進左衛將軍。","mention_id":"c-jinshu-076-wangyi-family:p002:m0081"}],"rationale":"完整本源敘事的姓名/稱號、在位階段或往來事件與現役來源角色相合；引古只判同指，不作在場/任職/故事史實已證。","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-061-zhou-family:p017","text":"王敦無君，由來實久，元惡之甚，古今無二。幸賴陛下聖聰神武，故能摧破凶強，撥亂反正，以甯區宇。前軍事之際，聖恩不遺，取顗息閔，得充近侍。臣時面啟，欲令閔還襲臣亡父侯爵。時卞壼、庾亮並侍御坐，壼云：「事了當論顯贈。」時未淹久，言猶在耳。至於譙王承、甘卓，已蒙清復，王澄久遠，猶在論議。況顗忠以衛主，身死王事，雖嵇紹之不違難，何以過之！至今不聞復封加贈褒顯之言。不知顗有餘責，獨負殊恩，為朝廷急於時務，不暇論及？此臣所以痛心疾首，重用哀歎者也。不勝辛酸，冒陳愚款。","source_position":{"raw_start":2965,"raw_end":3198,"raw_text":"　　王敦無君，由來實久，元惡之甚，古今無二。幸賴陛下聖聰神武，故能摧破凶強，撥亂反正，以甯區宇。前軍事之際，聖恩不遺，取顗息閔，得充近侍。臣時面啟，欲令閔還襲臣亡父侯爵。時卞壼、庾亮並侍御坐，壼云：「事了當論顯贈。」時未淹久，言猶在耳。至於譙王承、甘卓，已蒙清復，王澄久遠，猶在論議。況顗忠以衛主，身死王事，雖嵇紹之不違難，何以過之！至今不聞復封加贈褒顯之言。不知顗有餘責，獨負殊恩，為朝廷急於時務，不暇論及？此臣所以痛心疾首，重用哀歎者也。不勝辛酸，冒陳愚款。}}","display_wrapper_start":0,"display_wrapper_end":2,"raw_path":"sources/jinshu/wikisource-7903772-raw.wikitext"},"mentions":[{"id":"c-jinshu-061-zhou-family:p017:m0000","start":0,"end":2,"surface":"王敦","kind":"person","person_id":"7r6_k52_qji_ABBA","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p017:m0022","start":22,"end":24,"surface":"陛下","kind":"person","person_id":"dkn_ge4_286_AAAAAAAA","status":"contextual_provisional","interpretation_note":"謨疏位於王敦死後；其陛下為明帝，先帝則元帝；不以最近帝字全篇套同人。"},{"id":"c-jinshu-061-zhou-family:p017:m0058","start":58,"end":59,"surface":"顗","kind":"person","person_id":"3xx_gdy_or6_AAA","status":"contextual_provisional","interpretation_note":"069完整本傳明父浚、弟嵩、子閔，與061三代脈絡相合。"},{"id":"c-jinshu-061-zhou-family:p017:m0060","start":60,"end":61,"surface":"閔","kind":"person","person_id":"3xx_gdy_or6_AAAA","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p017:m0067","start":67,"end":68,"surface":"臣",