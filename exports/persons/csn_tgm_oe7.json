u-098-wangdun-comparison:p002:m0199","start":199,"end":200,"surface":"越","person_id":"9o2_vhv_r7y","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p002:m0204","start":204,"end":206,"surface":"繆播","person_id":"l3b_6wp_lwb","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p002:m0213","start":213,"end":214,"surface":"越","person_id":"9o2_vhv_r7y","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p002:m0215","start":215,"end":216,"surface":"敦","person_id":"7r6_k52_qji_ABBA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p002:m0222","start":222,"end":224,"surface":"潘滔","person_id":"yir_cmm_s73","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p002:m0225","start":225,"end":226,"surface":"越","person_id":"9o2_vhv_r7y","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p002:m0231","start":231,"end":233,"surface":"處仲","person_id":"7r6_k52_qji_ABBA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p002:m0251","start":251,"end":252,"surface":"越","person_id":"9o2_vhv_r7y","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p002:m0265","start":265,"end":267,"surface":"元帝","person_id":"dkn_ge4_286_AAAAAAA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p002:m0281","start":281,"end":283,"surface":"劉陶","person_id":"3r9_0rs_cnv","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p002:m0285","start":285,"end":286,"surface":"帝","person_id":"dkn_ge4_286_AAAAAAA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p002:m0288","start":288,"end":289,"surface":"敦","person_id":"7r6_k52_qji_ABBA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p002:m0318","start":318,"end":319,"surface":"帝","person_id":"dkn_ge4_286_AAAAAAA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p002:m0329","start":329,"end":330,"surface":"敦","person_id":"7r6_k52_qji_ABBA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p002:m0333","start":333,"end":334,"surface":"導","person_id":"7r6_k52_qji_ABAA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p002:m0364","start":364,"end":366,"surface":"甘卓","person_id":"csn_tgm_oe7","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p002:m0372","start":372,"end":374,"surface":"華軼","person_id":"p86_bh6_jm2","kind":"person"}],"chapter_id":"c-jinshu-098-wangdun-comparison","book_id":"b-jinshu-098","work_id":"w-jinshu","source_id":"s-jinshu098-wangdun-ws2614273-comparison"},{"id":"c-jinshu-098-wangdun-comparison:p011","text":"初，敦務自矯厲，雅尚清談，口不言財色。既素有重名，又立大功于江左，專任閫外，手控強兵，群從貴顯，威權莫貳，遂欲專制朝廷，有問鼎之心。帝畏而惡之，遂引劉隗、刁協等以為心膂。敦益不能平，於是嫌隙始構矣。每酒後輒詠魏武帝樂府歌曰：「老驥伏櫪，志在千里。烈士暮年，壯心不已。」以如意打唾壺為節，壺邊盡缺。及湘州刺史甘卓遷梁州，敦欲以從事中郎陳頒代卓，帝不從，更以譙王承鎮湘州。敦復上表陳古今忠臣見疑于君，而蒼蠅之人交構其間，欲以感動天子。帝愈忌憚之。俄加敦羽葆鼓吹，增從事中郎、掾屬、舍人各二人。帝以劉隗為鎮北將軍，戴若思為征西將軍，悉發揚州奴為兵，外以討胡，實禦敦也。永昌元年，敦率眾內向，以誅隗為名，上疏曰：","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","source_position":{"first_line":31,"last_line":31,"revision_id":2614273,"raw_projection_ref":"source-evidence/jin098-wangdun-comparison/projection.json","raw_file_sha256":"019eb1b16d5b12d4fac53fe1c94cb23ef4794434faa88ce8222576f948f4ca36","unit_key":"p011","source_layer":"received_chapter"},"mentions":[{"id":"c-jinshu-098-wangdun-comparison:p011:m0002","start":2,"end":3,"surface":"敦","person_id":"7r6_k52_qji_ABBA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p011:m0066","start":66,"end":67,"surface":"帝","person_id":"dkn_ge4_286_AAAAAAA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p011:m0074","start":74,"end":76,"surface":"劉隗","person_id":"hnd_3at_h4i","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p011:m0077","start":77,"end":79,"surface":"刁協","person_id":"c20_ec4_36f","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p011:m0085","start":85,"end":86,"surface":"敦","person_id":"7r6_k52_qji_ABBA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p011:m0104","start":104,"end":107,"surface":"魏武帝","person_id":"dad_b77_b38","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p011:m0153","start":153,"end":155,"surface":"甘卓","person_id":"csn_tgm_oe7","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p011:m0159","start":159,"end":160,"surface":"敦","person_id":"7r6_k52_qji_ABBA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p011:m0166","start":166,"end":168,"surface":"陳頒","person_id":"0o6_6rp_1m1","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p011:m0171","start":171,"end":172,"surface":"帝","person_id":"dkn_ge4_286_AAAAAAA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p011:m0177","start":177,"end":180,"surface":"譙王承","person_id":"upd_apd_zqr","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p011:m0184","start":184,"end":185,"surface":"敦","person_id":"7r6_k52_qji_ABBA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p011:m0215","start":215,"end":216,"surface":"帝","person_id":"dkn_ge4_286_AAAAAAA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p011:m0223","start":223,"end":224,"surface":"敦","person_id":"7r6_k52_qji_ABBA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p011:m0244","start":244,"end":245,"surface":"帝","person_id":"dkn_ge4_286_AAAAAAA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p011:m0246","start":246,"end":248,"surface":"劉隗","person_id":"hnd_3at_h4i","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p011:m0254","start":254,"end":257,"surface":"戴若思","person_id":"d9d_ab2_a72","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p011:m0278","start":278,"end":279,"surface":"敦","person_id":"7r6_k52_qji_ABBA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p011:m0286","start":286,"end":287,"surface":"敦","person_id":"7r6_k52_qji_ABBA","kind":"person"}],"chapter_id":"c-jinshu-098-wangdun-comparison","book_id":"b-jinshu-098","work_id":"w-jinshu","source_id":"s-jinshu098-wangdun-ws2614273-comparison"}],"sources":[{"chapter_id":"c-jinshu-061-zhou-family","work_id":"w-jinshu","book_id":"b-jinshu-061","source_id":"s-jinshu-061-ws7903772","source":{"title":"晉書／卷061周浚及附周嵩、周謨、周馥完整單元","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7061&oldid=7903772","permalink":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7061&oldid=7903772","revision_id":7903772,"edition":null,"accessed_on":"2026-10-20","raw_path":"sources/jinshu/wikisource-7903772-raw.wikitext","raw_file_sha256":"6e28403fc85f551b2aab898cac610180884ba0732a24a492f8ca514381b9978d","text_scope":"partial_chapter","review_status":"text_checked","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"description":"保數位原字；僅明示wiki wrappers及排版移除，完整raw與逐碼projection另存；未影像校勘。","omitted_digital_paratext":[]},"extent":"周浚及嵩、謨、馥完整選定單元；固定見證25段4069字，止於成公簡前，不是卷六十一全卷。"}},{"chapter_id":"c-jinshu-076-wangyi-family","work_id":"w-jinshu","book_id":"b-jinshu-076","source_id":"s-jinshu-076-wangyi-family","source":{"title":"《晉書》卷七十六（數位選錄）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7076&oldid=2180533","permalink":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7076&oldid=2180533","revision_id":2180533,"accessed_on":"2026-10-18","extent":"王廙傳首、末段及子嗣共四段，中興賦等中段未錄，非完整列傳。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，未親核底本影像","response_sha256":"c6c7c41bf93c491f6f69b058ecc493e979d65f3e65397d20055284f2e829cd30","wikitext_sha256":"872701db949f6f58ea6f183425617dfa82353177d2cc026037bfad953a60cd71","normalization":{"character_conversion":{},"extraction_note":"去首部空白，宋書ref校勘記另存，正文原字不改；不補平南將領的疑缺字。","excerpts":[{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:p001","source_lines":[27,28],"raw_quote":"王廙，字世將，丞相導從弟，而元帝姨弟也。父正，尚書郎。廙少能屬文，多所通涉，工書畫，善音樂、射御、博弈、雜伎。辟太傅掾，轉參軍。豫迎大駕，封武陵縣侯，拜尚書郎，出為濮陽太守。元帝作鎮江左，廙棄郡過江。帝見之大悅，以為司馬。頻守廬江、鄱陽二郡。豫討周馥、杜韜，以功累增封邑，除冠軍將軍，鎮石頭，領丞相軍諮祭酒。王敦啟為甯遠將軍、荊州刺史。","raw_quote_sha256":"8147d33d3202efaa1adf4a1c6aa137d71d239827b11033011846a53f38708001","selected_text_sha256":"8147d33d3202efaa1adf4a1c6aa137d71d239827b11033011846a53f38708001","begin_anchor":"王廙，字世將，丞相導從弟，而元","end_anchor":"。王敦啟為甯遠將軍、荊州刺史。"},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:p002","source_lines":[39,40],"raw_quote":"初，王敦左遷陶侃，使廙代為荊州。將吏馬俊、鄭攀等上書請留侃，敦不許。廙為俊等所襲，奔于江安。賊杜曾與俊、攀北迎第五猗以距廙。廙督諸軍討曾，又為曾所敗。敦命湘州刺史甘卓、豫章太守周廣等助廙擊曾，曾衆潰，廙得到州。廙性俊率，嘗從南下，旦自尋陽，迅風飛帆，暮至都，倚舫樓長嘯，神氣甚逸。王導謂庾亮曰：「世將為傷時識事。」亮曰：「正足舒其逸氣耳。」廙在州大誅戮侃時將佐，及征士皇甫方回，於是大失荊土之望，人情乖阻。帝乃征廙為輔國將軍，加散騎常侍。以母喪去職。服闋，拜征虜將軍，進左衛將軍。","raw_quote_sha256":"713e46789dcf7fe1c521542418159b142d29f81e58c3e6357597be46caf9c662","selected_text_sha256":"713e46789dcf7fe1c521542418159b142d29f81e58c3e6357597be46caf9c662","begin_anchor":"初，王敦左遷陶侃，使廙代為荊州","end_anchor":"服闋，拜征虜將軍，進左衛將軍。"},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:p003","source_lines":[41,42],"raw_quote":"及王敦構禍，帝遣廙喻敦，既不能諫其悖逆，乃為敦所留，受任助亂。敦得志，以廙為平南將領護南蠻校尉、荊州刺史。尋病卒。帝猶以親故，深痛湣之。喪還京都，皇太子親臨拜柩，如家人之禮。贈侍中、驃騎將軍，諡曰康。明帝與大將軍溫嶠書曰：「痛謝鯤未絕於口，世將復至於此。並盛年雋才，不遂其志，痛切於心。廙明古多通，鯤遠有識致。其言雖未足令人改聽，然味之不倦，近未易有也。坐相視盡，如何！」","raw_quote_sha256":"b2c8c3b975ba6ac7732d8b4a11f0ec1be353f9f1fb577963a649d9140d52c2bb","selected_text_sha256":"b2c8c3b975ba6ac7732d8b4a11f0ec1be353f9f1fb577963a649d9140d52c2bb","begin_anchor":"及王敦構禍，帝遣廙喻敦，既不能","end_anchor":"近未易有也。坐相視盡，如何！」"},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:p004","source_lines":[43,44],"raw_quote":"子頤之嗣，仕至東海內史。頤之弟胡之，字修齡，弱冠有聲譽，歷郡守、侍中、丹陽尹。素有風眩疾，發動甚數，而神明不損。石季龍死，朝廷欲綏輯河洛，以胡之為西中郎將、司州刺史、假節，以疾固辭，未行而卒。子茂之亦有美譽，官至晉陵太守。子敬弘，義熙末為尚書。","raw_quote_sha256":"07b3bbc4071f24625a64510a17080b7ab063923ca9f6d5febeb0893dfefef0c6","selected_text_sha256":"07b3bbc4071f24625a64510a17080b7ab063923ca9f6d5febeb0893dfefef0c6","begin_anchor":"子頤之嗣，仕至東海內史。頤之弟","end_anchor":"陵太守。子敬弘，義熙末為尚書。"}]}}},{"chapter_id":"c-jinshu-098-wangdun-comparison","work_id":"w-jinshu","book_id":"b-jinshu-098","source_id":"s-jinshu098-wangdun-ws2614273-comparison","source":{"title":"《晉書》卷九十八〈王敦傳〉","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=晉書/卷098&oldid=2614273","permalink":"https://zh.wikisource.org/w/index.php?title=晉書/卷098&oldid=2614273","revision_id":2614273,"accessed_on":"2026-10-27","extent":"完整王敦37段、附沈充3段與相接史臣曰1段；41段7827字。原raw202:8177，不含桓溫、孟嘉及卷末合贊，非全卷。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"edition":"固定數位轉錄，底本未核；僅比較，非武英殿本，非首選讀本。","rights":"古代原文與維基文庫固定數位轉錄；原修訂及授權歸屬保留。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","raw_file":"sources/jinshu/wikisource-2614273-raw.wikitext","raw_path":"sources/jinshu/wikisource-2614273-raw.wikitext","raw_file_sha256":"019eb1b16d5b12d4fac53fe1c94cb23ef4794434faa88ce8222576f948f4ca36","wikitext_sha256":"019eb1b16d5b12d4fac53fe1c94cb23ef4794434faa88ce8222576f948f4ca36","normalization":{"character_conversion":{},"extraction_note":"逐碼點投影移除數位節題、段首縮排與連結語法。𩦎保固定模板第一參數；不解原刻。奏表/詔書/引語留正文，史臣曰獨立層。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true}}
