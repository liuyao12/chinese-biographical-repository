:0,"paragraph_occurrence_count":2,"table_occurrence_count":0,"passage_count":2,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"2處獨立位置，2個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"},{"source_id":"s-jinshu-076-wangyi-family","work_id":"w-jinshu","book_id":"b-jinshu-076","chapter_id":"c-jinshu-076-wangyi-family","raw_mention_count":1,"mention_ids":["c-jinshu-076-wangyi-family:p002:m0081"],"paragraph_ids":["c-jinshu-076-wangyi-family:p002"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-076-wangyi-family:p002:m0081","mention_ids":["c-jinshu-076-wangyi-family:p002:m0081"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-061-ws7903772"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-061-zhou-family:p017:m0122","start":122,"end":124,"surface":"甘卓","kind":"person","person_id":"csn_tgm_oe7","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。","paragraph_id":"c-jinshu-061-zhou-family:p017","chapter_id":"c-jinshu-061-zhou-family"},{"id":"c-jinshu-061-zhou-family:p023:m0098","start":98,"end":100,"surface":"甘卓","kind":"person","person_id":"csn_tgm_oe7","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。","paragraph_id":"c-jinshu-061-zhou-family:p023","chapter_id":"c-jinshu-061-zhou-family"},{"id":"c-jinshu-076-wangyi-family:p002:m0081","start":81,"end":83,"surface":"甘卓","kind":"person","person_id":"csn_tgm_oe7","status":"contextual_provisional","paragraph_id":"c-jinshu-076-wangyi-family:p002","chapter_id":"c-jinshu-076-wangyi-family"}],"relations":[],"title_holdings":[{"id":"th-jinshu076-wang-013","person_id":"csn_tgm_oe7","title":"湘州刺史","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-076","chapter_id":"c-jinshu-076-wangyi-family","source_id":"s-jinshu-076-wangyi-family","paragraph_id":"c-jinshu-076-wangyi-family:p002","quote":"初，王敦左遷陶侃，使廙代為荊州。將吏馬俊、鄭攀等上書請留侃，敦不許。廙為俊等所襲，奔于江安。賊杜曾與俊、攀北迎第五猗以距廙。廙督諸軍討曾，又為曾所敗。敦命湘州刺史甘卓、豫章太守周廣等助廙擊曾，曾衆潰，廙得到州。廙性俊率，嘗從南下，旦自尋陽，迅風飛帆，暮至都，倚舫樓長嘯，神氣甚逸。王導謂庾亮曰：「世將為傷時識事。」亮曰：「正足舒其逸氣耳。」廙在州大誅戮侃時將佐，及征士皇甫方回，於是大失荊土之望，人情乖阻。帝乃征廙為輔國將軍，加散騎常侍。以母喪去職。服闋，拜征虜將軍，進左衛將軍。","person_mention_id":"c-jinshu-076-wangyi-family:p002:m0081"}],"attestations":[{"id":"th-jinshu076-wang-013:a001","paragraph_id":"c-jinshu-076-wangyi-family:p002","start":77,"end":81,"surface":"湘州刺史","person_mention_id":"c-jinshu-076-wangyi-family:p002:m0081","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"只按本段任官、授爵或用稱；未知起訖不補。義熙末保留晚期原語，不選定某一年。未將疑缺平南將領字串補成平南將軍。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-061-zhou-family:p017","text":"王敦無君，由來實久，元惡之甚，古今無二。幸賴陛下聖聰神武，故能摧破凶強，撥亂反正，以甯區宇。前軍事之際，聖恩不遺，取顗息閔，得充近侍。臣時面啟，欲令閔還襲臣亡父侯爵。時卞壼、庾亮並侍御坐，壼云：「事了當論顯贈。」時未淹久，言猶在耳。至於譙王承、甘卓，已蒙清復，王澄久遠，猶在論議。況顗忠以衛主，身死王事，雖嵇紹之不違難，何以過之！至今不聞復封加贈褒顯之言。不知顗有餘責，獨負殊恩，為朝廷急於時務，不暇論及？此臣所以痛心疾首，重用哀歎者也。不勝辛酸，冒陳愚款。","source_position":{"raw_start":2965,"raw_end":3198,"raw_text":"　　王敦無君，由來實久，元惡之甚，古今無二。幸賴陛下聖聰神武，故能摧破凶強，撥亂反正，以甯區宇。前軍事之際，聖恩不遺，取顗息閔，得充近侍。臣時面啟，欲令閔還襲臣亡父侯爵。時卞壼、庾亮並侍御坐，壼云：「事了當論顯贈。」時未淹久，言猶在耳。至於譙王承、甘卓，已蒙清復，王澄久遠，猶在論議。況顗忠以衛主，身死王事，雖嵇紹之不違難，何以過之！至今不聞復封加贈褒顯之言。不知顗有餘責，獨負殊恩，為朝廷急於時務，不暇論及？此臣所以痛心疾首，重用哀歎者也。不勝辛酸，冒陳愚款。}}","display_wrapper_start":0,"display_wrapper_end":2,"raw_path":"sources/jinshu/wikisource-7903772-raw.wikitext"},"mentions":[{"id":"c-jinshu-061-zhou-family:p017:m0000","start":0,"end":2,"surface":"王敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p017:m0022","start":22,"end":24,"surface":"陛下","kind":"person","person_id":"dkn_ge4_286_AAAAAAAA","status":"contextual_provisional","interpretation_note":"謨疏位於王敦死後；其陛下為明帝，先帝則元帝；不以最近帝字全篇套同人。"},{"id":"c-jinshu-061-zhou-family:p017:m0058","start":58,"end":59,"surface":"顗","kind":"person","person_id":"3xx_gdy_or6_AAA","status":"contextual_provisional","interpretation_note":"069完整本傳明父浚、弟嵩、子閔，與061三代脈絡相合。"},{"id":"c-jinshu-061-zhou-family:p017:m0060","start":60,"end":61,"surface":"閔","kind":"person","person_id":"3xx_gdy_or6_AAAA","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p017:m0067","start":67,"end":68,"surface":"臣","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"069明顗從弟穆；本061謨列浚三子且自稱顗亡兄。字音近不足合身份，先保跨篇候選與親屬差別。","candidate_person_ids":["e2n_dxb_vmj"]},{"id":"c-jinshu-061-zhou-family:p017:m0074","start":74,"end":75,"surface":"閔","kind":"person","person_id":"3xx_gdy_or6_AAAA","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p017:m0077","start":77,"end":78,"surface":"臣","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"069明顗從弟穆；本061謨列浚三子且自稱顗亡兄。字音近不足合身份，先保跨篇候選與親屬差別。","candidate_person_ids":["e2n_dxb_vmj"]},{"id":"c-jinshu-061-zhou-family:p017:m0078","start":78,"end":80,"surface":"亡父","kind":"person","person_id":"3xx_gdy_or6_AA","status":"contextual_provisional","interpretation_note":"069明顗為安東將軍浚子；本061同父官與三子顗嵩謨脈絡合，與042伐吳周浚亦同事件。"},{"id":"c-jinshu-061-zhou-family:p017:m0084","start":84,"end":86,"surface":"卞壼","kind":"person","person_id":"4z4_ujq_8yo","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p017:m0087","start":87,"end":89,"surface":"庾亮","kind":"person","person_id":"4qr_wrk_3vd_B","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p017:m0094","start":94,"end":95,"surface":"壼","kind":"person","person_id":"4z4_ujq_8yo","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p017:m0118","start":118,"end":121,"surface":"譙王承","kind":"person","person_id":"upd_apd_zqr","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p017:m0122","start":122,"end":124,"surface":"甘卓","kind":"person","person_id":"csn_tgm_oe7","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p017:m0130","start":130,"end":132,"surface":"王澄","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"現有王澄為王渾子／王濟弟；疏中追復人物不可僅同名接合。","candidate_person_ids":["a8f_ec8_e74_ABC"]},{"id":"c-jinshu-061-zhou-family:p017:m0141","start":141,"end":142,"surface":"顗","kind":"person","person_id":"3xx_gdy_or6_AAA","status":"contextual_provisional","interpretation_note":"069完整本傳明父浚、弟嵩、子閔，與061三代脈絡相合。"},{"id":"c-jinshu-061-zhou-family:p017:m0153","start":153,"end":155,"surface":"嵇紹","kind":"person","person_id":"6fg_r6l_5a5_A","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p017:m0180","start":180,"end":181,"surface":"顗","kind":"person","person_id":"3xx_gdy_or6_AAA","status":"contextual_provisional","interpretation_note":"069完整本傳明父浚、弟嵩、子閔，與061三代脈絡相合。"},{"id":"c-jinshu-061-zhou-family:p017:m0204","start":204,"end":205,"surface":"臣","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"069明顗從弟穆；本061謨列浚三子且自稱顗亡兄。字音近不足合身份，先保跨篇候選與親屬差別。","candidate_person_ids":["e2n_dxb_vmj"]}],"chapter_id":"c-jinshu-061-zhou-family","book_id":"b-jinshu-061","work_id":"w-jinshu","source_id":"s-jinshu-061-ws7903772"},{"id":"c-jinshu-061-zhou-family:p023","text":"越與苟晞不協，馥不先白於越，而直上書，越大怒。先是，越召馥及淮南太守裴碩，馥不肯行，而令碩率兵先進。碩貳於馥，乃舉兵稱馥擅命，已奉越密旨圖馥，遂襲之，為馥所敗。碩退保東城，求救於元帝。帝遣揚威將軍甘卓、建威將軍郭逸攻馥于壽春。安豐太守孫惠帥眾應之，使謝摛為檄。摛，馥之故將也。馥見檄，流涕曰：「必謝摛之辭。」摛聞之，遂毀草。旬日而馥眾潰，奔于項，為新蔡王確所拘，憂憤發病卒。","source_position":{"raw_start":4086,"raw_end":4275,"raw_text":"　　越與苟晞不協，馥不先白於越，而直上書，越大怒。先是，越召馥及淮南太守裴碩，馥不肯行，而令碩率兵先進。碩貳於馥，乃舉兵稱馥擅命，已奉越密旨圖馥，遂襲之，為馥所敗。碩退保東城，求救於元帝。帝遣揚威將軍甘卓、建威將軍郭逸攻馥于壽春。安豐太守孫惠帥眾應之，使謝摛為檄。摛，馥之故將也。馥見檄，流涕曰：「必謝摛之辭。」摛聞之，遂毀草。旬日而馥眾潰，奔于項，為新蔡王確所拘，憂憤發病卒。","display_wrapper_start":0,"display_wrapper_end":0,"raw_path":"sources/jinshu/wikisource-7903772-raw.wikitext"},"mentions":[{"id":"c-jinshu-061-zhou-family:p023:m0000","start":0,"end":1,"surface":"越","kind":"person","person_id":"9o2_vhv_r7y","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p023:m0002","start":2,"end":4,"surface":"苟晞","kind":"person","person_id":"v5s_1ew_vh0","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p023:m0007","start":7,"end":8,"surface":"馥","kind":"person","person_id":"3xx_gdy_or6_BA","status":"contextual_provisional","interpretation_note":"076王廙元帝鎮江左、討周馥脈絡與本段相合；不是只從單字馥匹配韓馥。"},{"id":"c-jinshu-061-zhou-family:p023:m0012","start":12,"end":13,"surface":"越","kind":"person","person_id":"9o2_vhv_r7y","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p023:m0019","start":19,"end":20,"surf