u-076-wangyi-family:p002:m0092","start":92,"end":93,"surface":"廙","kind":"person","person_id":"7r6_k52_qji_ABDA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0094","start":94,"end":95,"surface":"曾","kind":"person","person_id":"4vd_pg5_o8x","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0096","start":96,"end":97,"surface":"曾","kind":"person","person_id":"4vd_pg5_o8x","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0100","start":100,"end":101,"surface":"廙","kind":"person","person_id":"7r6_k52_qji_ABDA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0105","start":105,"end":106,"surface":"廙","kind":"person","person_id":"7r6_k52_qji_ABDA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0140","start":140,"end":142,"surface":"王導","kind":"person","person_id":"7r6_k52_qji_ABAA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0143","start":143,"end":145,"surface":"庾亮","kind":"person","person_id":"4qr_wrk_3vd_B","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0148","start":148,"end":150,"surface":"世將","kind":"person","person_id":"7r6_k52_qji_ABDA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0157","start":157,"end":158,"surface":"亮","kind":"person","person_id":"4qr_wrk_3vd_B","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0170","start":170,"end":171,"surface":"廙","kind":"person","person_id":"7r6_k52_qji_ABDA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0176","start":176,"end":177,"surface":"侃","kind":"person","person_id":"twd_erg_kmz","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0184","start":184,"end":188,"surface":"皇甫方回","kind":"person","person_id":"xe3_d7n_iej","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0203","start":203,"end":204,"surface":"帝","kind":"person","person_id":"dkn_ge4_286_AAAAAAA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0206","start":206,"end":207,"surface":"廙","kind":"person","person_id":"7r6_k52_qji_ABDA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0220","start":220,"end":221,"surface":"母","kind":"person","person_id":"7ie_92j_3xk","status":"contextual_provisional"}],"source_position":{"first_line":39,"last_line":40,"revision_id":2180533,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-076-wangyi-family","book_id":"b-jinshu-076","work_id":"w-jinshu","source_id":"s-jinshu-076-wangyi-family"},{"id":"c-jinshu-098-wangdun-comparison:p002","text":"趙王倫篡位，敦叔父彥為兗州刺史，倫遣敦慰勞之。會諸王起義兵；彥被齊王冏檄，懼倫兵強，不敢應命，敦勸彥起兵應諸王，故彥遂立勳績。惠帝反正，敦遷散騎常侍、左衛將軍、大鴻臚、侍中，出除廣武將軍、青州刺史。永嘉初，徵為中書監。于時天下大亂，敦悉以公主時侍婢百餘人配給將士，金銀寶物散之於眾，單車還洛。東海王越自滎陽來朝，敦謂所親曰：「今威權悉在太傅，而選用表情，尚書猶以舊制裁之，太傅今至，必有誅罰。」俄而越收中書令繆播等十餘人殺之。越以敦為揚州刺史，潘滔說越曰：「今樹處仲于江外，使其肆豪強之心，是見賊也。」越不從。其後徵拜尚書，不就。元帝召為安東軍諮祭酒。會揚州刺史劉陶卒，帝復以敦為揚州刺史，加廣武將軍。尋進左將軍、都督征討諸軍事、假節。帝初鎮江東，威名未著，敦與從弟導等同心翼戴，以隆中興，時人為之語曰：「王與馬，共天下。」尋與甘卓等討江州刺史華軼，斬之。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","source_position":{"first_line":13,"last_line":13,"revision_id":2614273,"raw_projection_ref":"source-evidence/jin098-wangdun-comparison/projection.json","raw_file_sha256":"019eb1b16d5b12d4fac53fe1c94cb23ef4794434faa88ce8222576f948f4ca36","unit_key":"p002","source_layer":"received_chapter"},"mentions":[{"id":"c-jinshu-098-wangdun-comparison:p002:m0000","start":0,"end":3,"surface":"趙王倫","person_id":"dkn_ge4_286_AAAAG","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p002:m0006","start":6,"end":7,"surface":"敦","person_id":"7r6_k52_qji_ABBA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p002:m0009","start":9,"end":10,"surface":"彥","person_id":"7r6_k52_qji_ABE","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p002:m0016","start":16,"end":17,"surface":"倫","person_id":"dkn_ge4_286_AAAAG","kind":"person"