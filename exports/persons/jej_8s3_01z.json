id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m004-0084","start":84,"end":86,"surface":"項籍","kind":"person","person_id":"jej_8s3_01z","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p004","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m016-0019","start":19,"end":21,"surface":"項籍","kind":"person","person_id":"jej_8s3_01z","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p016","chapter_id":"c-shiji-096-zhang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji096-014","person_id":"jej_8s3_01z","surfaces":["項籍","項羽"],"scope":"same_chapter","chapter_ids":["c-shiji-096-zhang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-096-zhang:p004","quote":"漢王四年，楚圍漢王滎陽急，漢王遁出去，而使周苛守滎陽城。楚破滎陽城，欲令周苛將。苛罵曰：「若趣降漢王！不然，今為虜矣！」項羽怒，亨周苛。於是乃拜周昌為御史大夫。常從擊破項籍。以六年中與蕭、曹等俱封：封周昌為汾陰侯；周苛子周成以父死事，封為高景侯。"},{"paragraph_id":"c-shiji-096-zhang:p016","quote":"申屠丞相嘉者，梁人，以材官蹶張從高帝擊項籍，遷為隊率。從擊黥布軍，為都尉。孝惠時，為淮陽守。孝文帝元年，舉故吏士二千石從高皇帝者，悉以為關內侯，食邑二十四人，而申屠嘉食邑五百戶。張蒼已為丞相，嘉遷為御史大夫。張蒼免相，孝文帝欲用皇后弟竇廣國為丞相，曰：「恐天下以吾私廣國。」廣國賢有行，故欲相之，念久之不可，而高帝時大臣又皆多死，餘見無可者，乃以御史大夫嘉為丞相，因故邑封為故安侯。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定短稱；韋賢與韋玄成分傳區別，第23段掾陳平另候選，第25段長安相工田文不與孟嘗君合併。趙堯、任敖、申屠嘉、鄧通、晁錯的短名依各段人物語境，王陵夫人與王陵分人。張蒼父長不滿五尺的長為身長敘述，不作父名。王侯與太子未詳名不補名，跨篇同指另待證據。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-096-zhang:p004","text":"漢王四年，楚圍漢王滎陽急，漢王遁出去，而使周苛守滎陽城。楚破滎陽城，欲令周苛將。苛罵曰：「若趣降漢王！不然，今為虜矣！」項羽怒，亨周苛。於是乃拜周昌為御史大夫。常從擊破項籍。以六年中與蕭、曹等俱封：封周昌為汾陰侯；周苛子周成以父死事，封為高景侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhang:m004-0000","start":0,"end":2,"surface":"漢王","kind":"person","person_id":"h8q_zyo_i2l","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m004-0007","start":7,"end":9,"surface":"漢王","kind":"person","person_id":"h8q_zyo_i2l","status":"contextual_provis