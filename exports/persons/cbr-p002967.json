s":"contextual_provisional","paragraph_id":"c-shiji-090-wei:p002","chapter_id":"c-shiji-090-wei"},{"id":"c-shiji-090-wei:m002-0072","start":72,"end":73,"surface":"咎","kind":"person","person_id":"cbr-p005035","status":"contextual_provisional","paragraph_id":"c-shiji-090-wei:p002","chapter_id":"c-shiji-090-wei"},{"id":"c-shiji-090-wei:m007-0171","start":171,"end":174,"surface":"魏王咎","kind":"person","person_id":"cbr-p005035","status":"contextual_provisional","paragraph_id":"c-shiji-090-wei:p007","chapter_id":"c-shiji-090-wei"},{"id":"c-shiji-090-wei:m013-0006","start":6,"end":8,"surface":"魏咎","kind":"person","person_id":"cbr-p005035","status":"contextual_provisional","paragraph_id":"c-shiji-090-wei:p013","chapter_id":"c-shiji-090-wei"}],"relations":[{"id":"a-shiji090-001","subject_person_id":"cbr-p005033","predicate":"brother","object_person_id":"cbr-p005035","status":"source_attested","evidence":[{"chapter_id":"c-shiji-090-wei","source_id":"s-shiji-090-wei","paragraph_id":"c-shiji-090-wei:p001","quote":"魏豹者，故魏諸公子也。其兄魏咎，故魏時封為寧陵君。秦滅魏，遷咎為家人。陳勝之起王也，咎往從之。陳王使魏人周市徇魏地，魏地已下，欲相與立周市為魏王。周市曰：「天下昏亂，忠臣乃見。今天下共畔秦，其義必立魏王後乃可。」齊、趙使車各五十乘，立周市為魏王。市辭不受，迎魏咎於陳。五反，陳王乃遣立咎為魏王。"}],"qualifiers":{"source_term":"其兄魏咎","historicity":"historical_tradition","discrepancy_group_id":"kin-shiji090-wei"},"interpretation_note":"開篇其兄與漢王對話從弟分存為相異主張；從弟不補第一代表親、共同祖父或任何直接父系。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji090-002","subject_person_id":"cbr-p005033","predicate":"agnatic_cousin","object_person_id":"cbr-p005035","status":"source_attested","evidence":[{"chapter_id":"c-shiji-090-wei","source_id":"s-shiji-090-wei","paragraph_id":"c-shiji-090-wei:p007","quote":"沛公之從碭北擊昌邑，彭越助之。昌邑未下，沛公引兵西。彭越亦將其眾居鉅野中，收魏散卒。項籍入關，王諸侯，還歸，彭越眾萬餘人毋所屬。漢元年秋，齊王田榮畔項王，乃使人賜彭越將軍印，使下濟陰以擊楚。楚命蕭公角將兵擊越，越大破楚軍。漢王二年春，與魏王豹及諸侯東擊楚，彭越將其兵三萬餘人歸漢於外黃。漢王曰：「彭將軍收魏地得十餘城，欲急立魏後。今西魏王豹亦魏王咎從弟也，真魏後。」乃拜彭越為魏相國，擅將其兵，略定梁地。"}],"qualifiers":{"source_term":"西魏王豹亦魏王咎從弟也","historicity":"historical_tradition","discrepancy_group_id":"kin-shiji090-wei","degree":"unknown","kinship_structure":{"lineage":"paternal","generation_difference":0,"collateral":true,"distance":null,"common_ancestor_person_id":null,"subject_relative_age":"younger"},"relative_birth_order":{"older_person_id":"cbr-p005035","younger_person_id":"cbr-p005033","operator":"lt","older_ordinal":null,"younger_ordinal":null,"scope":"agnatic_cousins","comparison_basis":"birth_chronology","interpretation_status":"source_attested"}},"interpretation_note":"開篇其兄與漢王對話從弟分存為相異主張；從弟不補第一代表親、共同祖父或任何直接父系。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji048-024","person_id":"cbr-p002967","title":"甯陵君","kind":"noble_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-048-chenshe","source_id":"s-shiji-048-chenshe","paragraph_id":"c-shiji-048-chenshe:p009","quote":"當此之時，諸將之徇地者，不可勝數。周市北徇地至狄，狄人田儋殺狄令，自立為齊王，以齊反擊周市。市軍散，還至魏地，欲立魏後故甯陵君咎為魏王。時咎在陳王所，不得之魏。魏地已定，欲相與立周市為魏王，周市不肯。使者五反，陳王乃立甯陵君咎為魏王，遣之國。周市卒為相。"}],"attestations":[{"id":"th-shiji048-024:a001","paragraph_id":"c-shiji-048-chenshe:p009","start":60,"end":63,"surface":"甯陵君","person_mention_id":"c-shiji-048-chenshe:m009-0060","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予、自立、既有用稱與冒稱分開；未知任期不由戰敗、被殺、歸報或首次提及推端點。詐稱與矯命不證合法或真實身份，制度種類仍待核。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji048-025","person_id":"cbr-p002967","title":"魏王","kind":"royal_rank","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-048-chenshe","source_id":"s-shiji-048-chenshe","paragraph_id":"c-shiji-048-chenshe:p009","quote":"當此之時，諸將之徇地者，不可勝數。周市北徇地至狄，狄人田儋殺狄令，自立為齊王，以齊反擊周市。市軍散，還至魏地，欲立魏後故甯陵君咎為魏王。時咎在陳王所，不得之魏。魏地已定，欲相與立周市為魏王，周市不肯。使者五反，陳王乃立甯陵君咎為魏王，遣之國。周市卒為相。"}],"attestations":[{"id":"th-shiji048-025:a001","paragraph_id":"c-shiji-048-chenshe:p009","start":114,"end":116,"surface":"魏王","person_mention_id":"c-shiji-048-chenshe:m009-0109","usage":"narrative"}],"effective_period":{"start"