er_id":"c-jinshu-066-taokan","source_id":"s-jinshu-066-taokan-ws1527632"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-043-wangcheng:line122:m0222","start":222,"end":224,"surface":"王機","kind":"person","person_id":"me9_tr4_2tr","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-043-wangcheng:line122","chapter_id":"c-jinshu-043-wangcheng"},{"id":"c-jinshu-043-wangcheng:line122:m0294","start":294,"end":296,"surface":"王機","kind":"person","person_id":"me9_tr4_2tr","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-043-wangcheng:line122","chapter_id":"c-jinshu-043-wangcheng"},{"id":"c-jinshu-043-wangcheng:line122:m0310","start":310,"end":311,"surface":"機","kind":"person","person_id":"me9_tr4_2tr","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-043-wangcheng:line122","chapter_id":"c-jinshu-043-wangcheng"},{"id":"c-jinshu-066-taokan:p010:m0016","surface":"王機","start":16,"end":18,"person_id":"me9_tr4_2tr","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-066-taokan:p010","chapter_id":"c-jinshu-066-taokan"}],"relations":[],"title_holdings":[{"id":"th-w043-cheng-122-9","person_id":"me9_tr4_2tr","title":"成都內史","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-043","chapter_id":"c-jinshu-043-wangcheng","source_id":"s-jinshu-043-wangcheng","paragraph_id":"c-jinshu-043-wangcheng:line122","quote":"澄既至鎮，日夜縱酒，不親庶事，雖寇戎急務，亦不以在懷。擢順陽人郭舒於寒悴之中，以為別駕，委以州府。時京師危逼，澄率眾軍，將赴國難，而飄風折其節柱。會王如寇襄陽，澄前鋒至宜城，遣使詣山簡，為如党嚴嶷所獲。嶷偽使人從襄陽來而問之曰：「襄陽拔未？」答云：「昨旦破城，已獲山簡。」乃陰緩澄使，令得亡去。澄聞襄陽陷，以為信然，散眾而還。既而恥之，托糧運不贍，委罪長史蔣俊而斬之，竟不能進。巴蜀流人散在荊、湘者，與土人忿爭，遂殺縣令，屯聚樂鄉。澄使成都內史王機討之。賊請降，澄偽許之，既而襲之於寵洲，以其妻子為賞，沈八千餘人于江中。於是益、梁流人四五萬家一時俱反，推杜弢為主，，南破零桂，東掠武昌，敗王機于巴陵。澄亦無憂懼之意，但與機日夜縱酒，投壺博戲，數十局俱起。殺富人李才，取其家資以賜郭舒。南平太守應詹驟諫，不納。於是上下離心，內外怨叛。澄望實雖損，猶傲然自得。後出軍擊杜弢，次於作塘。山簡參軍王沖叛於豫州，自稱荊州刺史。澄懼，使杜蕤守江陵。澄遷於孱陵，尋奔遝中。郭舒諫曰：「使君臨州，雖無異政，未失眾心。今西收華容向義之兵，足以擒此小丑，奈何自棄。」澄不能從。","person_mention_id":"c-jinshu-043-wangcheng:line122:m0222"}],"attestations":[{"id":"th-w043-cheng-122-9:a","paragraph_id":"c-jinshu-043-wangcheng:line122","start":218,"end":222,"surface":"成都內史","person_mention_id":"c-jinshu-043-wangcheng:line122:m0222","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-043-wangcheng:line122","text":"澄既至鎮，日夜縱酒，不親庶事，雖寇戎急務，亦不以在懷。擢順陽人郭舒於寒悴之中，以為別駕，委以州府。時京師危逼，澄率眾軍，將赴國難，而飄風折其節柱。會王如寇襄陽，澄前鋒至宜城，遣使詣山簡，為如党嚴嶷所獲。嶷偽使人從襄陽來而問之曰：「襄陽拔未？」答云：「昨旦破城，已獲山簡。」乃陰緩澄使，令得亡去。澄聞襄陽陷，以為信然，散眾而還。既而恥之，托糧運不贍，委罪長史蔣俊而斬之，竟不能進。巴蜀流人散在荊、湘者，與土人忿爭，遂殺縣令，屯聚樂鄉。澄使成都內史王機討之。賊請降，澄偽許之，既而襲之於寵洲，以其妻子為賞，沈八千餘人于江中。於是益、梁流人四五萬家一時俱反，推杜弢為主，，南破零桂，東掠武昌，敗王機于巴陵。澄亦無憂懼之意，但與機日夜縱酒，投壺博戲，數十局俱起。殺富人李才，取其家資以賜郭舒。南平太守應詹驟諫，不納。於是上下離心，內外怨叛。澄望實雖損，猶傲然自得。後出軍擊杜弢，次於作塘。山簡參軍王沖叛於豫州，自稱荊州刺史。澄懼，使杜蕤守江陵。澄遷於孱陵，尋奔遝中。郭舒諫曰：「使君臨州，雖無異政，未失眾心。今西收華容向義之兵，足以擒此小丑，奈何自棄。」澄不能從。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-043-wangcheng:line122:m0000","start":0,"end":1,"surface":"澄","kind":"person","person_id":"rlk_lzd_86c","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line122:m0031","start":31,"end":33,"surface":"郭舒","kind":"person","person_id":"nyu_drp_roe","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangchen