:210,"surface":"微","kind":"person","person_id":"5vs_w8w_7t3","status":"contextual_provisional"},{"id":"c-nanqishu-041-zhangrong-complete:p025:m0219","start":219,"end":220,"surface":"融","kind":"person","person_id":"d50_8f5_wul_AAABAC","status":"contextual_provisional"},{"id":"c-nanqishu-041-zhangrong-complete:p025:m0241","start":241,"end":242,"surface":"微","kind":"person","person_id":"5vs_w8w_7t3","status":"contextual_provisional"},{"id":"c-nanqishu-041-zhangrong-complete:p025:m0243","start":243,"end":247,"surface":"豫章王嶷","kind":"person","person_id":"ijh_3fs_6u2","status":"contextual_provisional"},{"id":"c-nanqishu-041-zhangrong-complete:p025:m0251","start":251,"end":253,"surface":"子良","kind":"person","person_id":"x3q_cqm_dup","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-041-zhangrong-complete","book_id":"b-nanqishu-041","work_id":"w-nanqishu","source_id":"s-nanqishu-041-zhangrong-complete-ws2044621"},{"id":"c-songshu-046-zhangchang-complete:p006","text":"及義宣有異圖，蔡超等以暢人望，勸義宣留之，乃解南蠻校尉以授暢，加冠軍將軍，領丞相長史。暢遣門生荀僧寶下都，因顏竣陳義宣釁狀。僧寶有私貨，止巴陵不時下。會義宣起兵，津路斷絕，遂不得前。義宣將為逆，使嬖人翟靈寶告暢，暢陳必無此理，請以死保之。靈寶還白義宣，云暢必不可回，請殺以徇眾，賴丞相司馬竺超民得免。進號撫軍，別立軍部，以收人望。暢雖署文檄，飲酒常醉，不省其事。及義宣敗於梁山，暢為軍人所掠，衣服都盡。遇右將軍王玄謨乘輿出營，暢巳得敗衣，遂排玄謨上輿，玄謨甚不悅。諸將請殺之，隊主張世救之得免。執送都下，付廷尉，見原。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":72,"last_line":72,"raw_start":6236,"raw_end":6668,"raw_character_offsets":[6236,6237,6238,6239,6240,6241,6242,6243,6244,6245,6246,6247,6248,6249,6250,6251,6252,6253,6254,6255,6256,6257,6258,6259,6260,6261,6262,6263,6264,6265,6266,6267,6268,6269,6270,6271,6272,6273,6274,6275,6276,6277,6278,6279,6280,6281,6282,6283,6284,6285,6286,6287,6288,6342,6343,6344,6345,6346,6347,6348,6349,6350,6351,6352,6353,6354,6355,6356,6357,6358,6359,6360,6361,6362,6363,6364,6365,6366,6367,6368,6369,6370,6371,6372,6373,6374,6375,6376,6377,6378,6379,6380,6381,6382,6383,6384,6385,6386,6387,6388,6389,6390,6391,6392,6393,6394,6395,6396,6397,6398,6399,6400,6401,6402,6403,6404,6405