t_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"unresolved_identity_cases":[{"id":"ic-jin044-liutao","status":"unresolved","candidate_person_ids":["icd_he2_xzh","8ew_suo_y03"],"paragraph_ids":["c-jinshu-044-luzhi:line064","c-jinshu-098-jin033-wangji:line013"],"note":"成都王傳稱南中郎將；王敦傳所及的揚州刺史姓名相同，尚缺直接履歷橋接。","chapter_id":"c-jinshu-044-luzhi","source_id":"s-jinshu-044-luzhi"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-w098-dun-early-liu","person_id":"8ew_suo_y03","event_type":"death","source_term":"揚州刺史劉陶卒","date_expression":null,"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-098","chapter_id":"c-jinshu-098-jin033-wangji","source_id":"s-jinshu-098-jin033-wangji","paragraph_id":"c-jinshu-098-jin033-wangji:line013","quote":"趙王倫篡位，敦叔父彥為兗州刺史，倫遣敦慰勞之。會諸王起義兵；彥被齊王冏檄，懼倫兵強，不敢應命，敦勸彥起兵應諸王，故彥遂立勳績。惠帝反正，敦遷散騎常侍、左衛將軍、大鴻臚、侍中，出除廣武將軍、青州刺史。永嘉初，徵為中書監。于時天下大亂，敦悉以公主時侍婢百餘人配給將士，金銀寶物散之於眾，單車還洛。東海王越自滎陽來朝，敦謂所親曰：「今威權悉在太傅，而選用表情，尚書猶以舊制裁之，太傅今至，必有誅罰。」俄而越收中書令繆播等十餘人殺之。越以敦為揚州刺史，潘滔說越曰：「今樹處仲于江外，使其肆豪強之心，是見賊也。」越不從。其後徵拜尚書，不就。元帝召為安東軍諮祭酒。會揚州刺史劉陶卒，帝復以敦為揚州刺史，加廣武將軍。尋進左將軍、都督征討諸軍事、假節。帝初鎮江東，威名未著，敦與從弟導等同心翼戴，以隆中興，時人為之語曰：「王與馬，共天下。」尋與甘卓等討江州刺史華軼，斬之。","person_mention_id":"c-jinshu-098-jin033-wangji:line013:m0281"}],"interpretation_note":"依本來源登記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-jinshu-052-hua-tan:p011:m0066","start":66,"end":68,"surface":"劉陶","kind":"person","person_id":"8ew_suo_y03","status":"contextual_provisional","paragraph_id":"c-jinshu-052-hua-tan:p011","chapter_id":"c-jinshu-052-hua-tan"},{"id":"c-jinshu-069-liuwei:p001:m0349","surface":"劉陶","start":349,"end":351,"person_id":"8ew_suo_y03","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-069-liuwei:p001","chapter_id":"c-jinshu-069-liuwei"},{"id":"c-jinshu-098-jin033-wangji:line013:m0281","start":281,"end":283,"surface":"劉陶","kind":"person","person_id":"8ew_suo_y03","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line013","chapter_id":"c-jinshu-098-jin033-wangji"}],"relations":[],"title_holdings":[{"id":"th-w098-dun-early-9","person_id":"8ew_suo_y03","title":"揚州刺史","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-098","chapter_id":"c-jinshu-098-jin033-wangji","source_id":"s-jinshu-098-jin033-wangji","paragraph_id":"c-jinshu-098-jin033-wangji:line013","quote":"趙王倫篡位，敦叔父彥為兗州刺史，倫遣敦慰勞之。會諸王起義兵；彥被齊王冏檄，懼倫兵強，不敢應命，敦勸彥起兵應諸王，故彥遂立勳績。惠帝反正，敦遷散騎常侍、左衛將軍、大鴻臚、侍中，出除廣武將軍、青州刺史。永嘉初，徵為中書監。于時天下大亂，敦悉以公主時侍婢百餘人配給將士，金銀寶物散之於眾，單車還洛。東海王越自滎陽來朝，敦謂所親曰：「今威權悉在太傅，而選用表情，尚書猶以舊制裁之，太傅今至，必有誅罰。」俄而越收中書令繆播等十餘人殺之。越以敦為揚州刺史，潘滔說越曰：「今樹處仲于江外，使其肆豪強之心，是見賊也。」越不從。其後徵拜尚書，不就。元帝召為安東軍諮祭酒。會揚州刺史劉陶卒，帝復以敦為揚州刺史，加廣武將軍。尋進左將軍、都督征討諸軍事、假節。帝初鎮江東，威名未著，敦與從弟導等同心翼戴，以隆中興，時人為之語曰：「王與馬，共天下。」尋與甘卓等討江州刺史華軼，斬之。","person_mention_id":"c-jinshu-098-jin033-wangji:line013:m0281"}],"attestations":[{"id":"th-w043-dun-early-9:a","paragraph_id":"c-jinshu-098-jin033-wangji:line013","start":217,"end":221,"surface":"揚州刺史","person_mention_id":"c-jinshu-098-jin033-wangji:line013:m0281","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-044-luzhi:line064","text":"及東海王越奉迎大駕，顒啟帝復穎還鄴，以志為魏郡太守，加左將軍，隨穎北鎮。行達洛陽，而平昌公模遣前鋒督護馮嵩距穎。穎還長安，未至而聞顒斬張方，求和於越。穎住華陰，志進長安，詣闕陳謝，即還就穎于武關。奔南陽，復為劉陶所驅，回詣河北。及穎薨，官屬奔散，唯志親自殯送，時人嘉之。越命志為軍諮祭酒，遷衛尉，永嘉末，轉尚書。洛陽沒，志將妻子北投并州刺史劉琨。至陽邑，為劉粲所虜，與次子謐、詵等俱遇害於平陽。長子諶。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-044-luzhi:line064:m0001","start":1,"end":5,"surface":"東海王越","kind":"person","person_id":"9o2_vhv_r7y","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line064:m0010","start":10,"end":11,"surface":"顒","kind":"person","person_id":"ed0_313_bea","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line064:m0014","start":14,"end":15,"surface":"穎","kind":"person","person_id":"e81_f09_000","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line064:m0019","start":19,"end":20,"surface":"志","kind":"person","person_id":"m8n_ntm_79h_ABB","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line064:m0032","start":32,"end":33,"surface":"穎","kind":"person","person_id":"e81_f09_000","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line064:m0042","start":42,"end":46,"surface":"平昌公模","kind":"person","person_id":"a6t_8s4_3jz","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line064:m0051","start":51,"end":53,"surface":"馮嵩","kind":"person","person_id":"4cf_cwf_cdc","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line064:m0054","start":54,"end":55,"surface":"穎","kind":"person","person_id":"e81_f09_000","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line064:m0056","start":56,"end":57