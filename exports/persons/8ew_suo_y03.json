notation_status":"reviewed","mentions":[{"id":"c-jinshu-044-luzhi:line064:m0001","start":1,"end":5,"surface":"東海王越","kind":"person","person_id":"9o2_vhv_r7y","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line064:m0010","start":10,"end":11,"surface":"顒","kind":"person","person_id":"ed0_313_bea","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line064:m0014","start":14,"end":15,"surface":"穎","kind":"person","person_id":"e81_f09_000","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line064:m0019","start":19,"end":20,"surface":"志","kind":"person","person_id":"m8n_ntm_79h_ABB","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line064:m0032","start":32,"end":33,"surface":"穎","kind":"person","person_id":"e81_f09_000","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line064:m0042","start":42,"end":46,"surface":"平昌公模","kind":"person","person_id":"a6t_8s4_3jz","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line064:m0051","start":51,"end":53,"surface":"馮嵩","kind":"person","person_id":"4cf_cwf_cdc","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line064:m0054","start":54,"end":55,"surface":"穎","kind":"person","person_id":"e81_f09_000","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line064:m0056","start":56,"end":57,"surface":"穎","kind":"person","person_id":"e81_f09_000","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line064:m0065","start":65,"end":66,"surface":"顒","kind":"person","person_id":"ed0_313_bea","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line064:m0067","start":67,"end":69,"surface":"張方","kind":"person","person_i