_ids":["s-jinshu-098-jin033-wangji"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"unresolved_identity_cases":[{"id":"ic-jin044-liutao","status":"unresolved","candidate_person_ids":["icd_he2_xzh","8ew_suo_y03"],"paragraph_ids":["c-jinshu-044-luzhi:line064","c-jinshu-098-jin033-wangji:line013"],"note":"成都王傳稱南中郎將；王敦傳所及的揚州刺史姓名相同，尚缺直接履歷橋接。","chapter_id":"c-jinshu-044-luzhi","source_id":"s-jinshu-044-luzhi"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-w098-dun-early-liu","person_id":"8ew_suo_y03","event_type":"death","source_term":"揚州刺史劉陶卒","date_expression":null,"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-098","chapter_id":"c-jinshu-098-jin033-wangji","source_id":"s-jinshu-098-jin033-wangji","paragraph_id":"c-jinshu-098-jin033-wangji:line013","quote":"趙王倫篡位，敦叔父彥為兗州刺史，倫遣敦慰勞之。會諸王起義兵；彥被齊王冏檄，懼倫兵強，不敢應命，敦勸彥起兵應諸王，故彥遂立勳績。惠帝反正，敦遷散騎常侍、左衛將軍、大鴻臚、侍中，出除廣武將軍、青州刺史。永嘉初，徵為中書監。于時天下大亂，敦悉以公主時侍婢百餘人配給將士，金銀寶物散之於眾，單車還洛。東海王越自滎陽來朝，敦謂所親曰：「今威權悉在太傅，而選用表情，尚書猶以舊制裁之，太傅今至，必有誅罰。」俄而越收中書令繆播等十餘人殺之。越以敦為揚州刺史，潘滔說越曰：「今樹處仲于江外，使其肆豪強之心，是見賊也。」越不從。其後徵拜尚書，不就。元帝召為安東軍諮祭酒。會揚州刺史劉陶卒，帝復以敦為揚州刺史，加廣武將軍。尋進左將軍、都督征討諸軍事、假節。帝初鎮江東，威名未著，敦與從弟導等同心翼戴，以隆中興，時人為之語曰：「王與馬，共天下。」尋與甘卓等討江州刺史華軼，斬之。","person_mention_id":"c-jinshu-098-jin033-wangji:line013:m0281"}],"interpretation_note":"依本來源登記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-jinshu-098-jin033-wangji:line013:m0281","start":281,"end":283,"surface":"劉陶","k