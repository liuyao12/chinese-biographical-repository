angji"}],"sources":[{"chapter_id":"c-jinshu-044-luzhi","work_id":"w-jinshu","book_id":"b-jinshu-044","source_id":"s-jinshu-044-luzhi","source":{"title":"晉書卷四十四","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?oldid=1775345","permalink":"https://zh.wikisource.org/w/index.php?oldid=1775345","revision_id":1775345,"accessed_on":"2026-11-21","extent":"固定數位題「珽子志」題下全文。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代本文及維基文庫數位轉錄。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫固定修訂1775345","raw_path":"sources/jinshu/wikisource-1775345-raw.wikitext","wikitext_sha256":"09742e651b479fea881fd24c7734451de2b78b9f0410adda36ba210c31a0b5c8","raw_file_sha256":"09742e651b479fea881fd24c7734451de2b78b9f0410adda36ba210c31a0b5c8","collation_witnesses":["source-evidence/jin044-luzhi/reading.json"]}},{"chapter_id":"c-jinshu-052-hua-tan","work_id":"w-jinshu","book_id":"b-jinshu-052","source_id":"s-jinshu-052-hua-tan-ws2604575","source":{"title":"晉書卷五十二·華譚","provider":"Wikisource","permalink":"https://zh.wikisource.org/w/index.php?oldid=2604575","url":"https://zh.wikisource.org/w/index.php?oldid=2604575","revision_id":2604575,"edition":"維基文庫固定修訂","accessed_on":"2026-11-22","review_status":"text_checked","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫授權。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","extent":"晉書卷五十二·華譚","text_scope":"complete_biography_unit","raw_path":"source-evidence/sanguozhi064-roll/external/jin052-ws2604575.wikitext","raw_file_sha256":"bc23c6fb49d83914c3f16c54b867415d8da7e44bee413a61cefb0c18cac5a212","collation_witnesses":["source-evidence/jin052-roll/volume-reading.json"]}},{"chapter_id":"c-jinshu-069-liuwei","work_id":"w-jinshu","book_id":"b-jinshu-069","source_id":"s-jinshu-069-liuwei-ws2012453","source":{"title":"晉書卷六十九·劉隗","provider":"Wikisource","permalink":"https://zh.wikisource.org/w/index.php?oldid=2012453","url":"https://zh.wikisource.org/w/i