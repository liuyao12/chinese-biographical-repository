_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-070-zhang:m054-0265","start":265,"end":268,"surface":"卞莊子","kind":"person","person_id":"qug_x6h_3tb","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p054","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-070-zhang:m054-0276","start":276,"end":278,"surface":"莊子","kind":"person","person_id":"qug_x6h_3tb","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p054","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-070-zhang:m054-0334","start":334,"end":337,"surface":"卞莊子","kind":"person","person_id":"qug_x6h_3tb","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p054","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-070-zhang:m054-0361","start":361,"end":363,"surface":"莊子","kind":"person","person_id":"qug_x6h_3tb","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p054","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-070-zhang:m054-0415","start":415,"end":417,"surface":"莊子","kind":"person","person_id":"qug_x6h_3tb","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p054","chapter_id":"c-shiji-070-zhang"},{"id":"c-weishu-weishou-035-cuihao:p004:m0251","start":251,"end":253,"surface":"卞莊","kind":"person","person_id":"qug_x6h_3tb","status":"resolved","resolution_note":"完整敘事單元上下文辨識；原字保留，不建立同名字面通用規則。","paragraph_id":"c-weishu-weishou-035-cuihao:p004","chapter_id":"c-weishu-weishou-035-cuihao"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji070-052","person_id":"qug_x6h_3tb","scope":"same_chapter","chapter_ids":["c-shiji-070-zhang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"依末8段附傳及引古故事局部暫接；犀首者名衍姓公孫氏與後文公孫衍明示相配。莊舄楚王與外層秦惠王分辨，卞莊子短稱莊子只取刺虎故事。未名楚魏秦王不依記憶補名，也未確證與本篇其他王同或異。子胥、曾參屬引古，比擬的僕妾與婦不補具體身分；李伯之下為地點，不當人名。","surfaces":["卞莊子","莊子"],"evidence":[{"paragraph_id":"c-shiji-070-zhang:p054","quote":"韓魏相攻，期年不解。秦惠王欲救之，問於左右。左右或曰救之便，或曰勿救便，惠王未能為之決。陳軫適至秦，惠王曰：「子去寡人之楚，亦思寡人不？」陳軫對曰：「王聞夫越人莊舄乎？」王曰：「不聞。」曰：「越人莊舄仕楚執珪，有頃而病。楚王曰：『舄故越之鄙細人也，今仕楚執珪，貴富矣，亦思越不？』中謝對曰：『凡人之思故，在其病也。彼思越則越聲，不思越則楚聲。』使人往聽之，猶尚越聲也。今臣雖棄逐之楚，豈能無秦聲哉！」惠王曰：「善。今韓魏相攻，期年不解，或謂寡人救之便，或曰勿救便，寡人不能決，願子為子主計之餘，為寡人計之。」陳軫對曰：「亦嘗有以夫卞莊子刺虎聞於王者乎？莊子欲刺虎，館豎子止之，曰：『兩虎方且食牛，食甘必爭，爭則必鬬，鬬則大者傷，小者死，從傷而刺之，一舉必有雙虎之名。』卞莊子以為然，立須之。有頃，兩虎果鬬，大者傷，小者死。莊子從傷者而刺之，一舉果有雙虎之功。今韓魏相攻，期年不解，是必大國傷，小國亡，從傷而伐之，一舉必有兩實。此猶莊子刺虎之類也。臣主與王何異也。」惠王曰：「善。」卒弗救。大國果傷，小國亡，秦興兵而伐，大剋之。此陳軫之計也。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-070-zhang:p054","text":"韓魏相攻，期年不解。秦惠王欲救之，問於左右。左右或曰救之便，或曰勿救便，惠王未能為之決。陳軫適至秦，惠王曰：「子去寡人之楚，亦思寡人不？」陳軫對曰：「王聞夫越人莊舄乎？」王曰：「不聞。」曰：「越人莊舄仕楚執珪，有頃而病。楚王曰：『舄故越之鄙細人也，今仕楚執珪，貴富矣，亦思越不？』中謝對曰：『凡人之思故，在其病也。彼思越則越聲，不思越則楚聲。』使人往聽之，猶尚越聲也。今臣雖棄逐之楚，豈能無秦聲哉！」惠王曰：「善。今韓魏相攻，期年不解，或謂寡人救之便，或曰勿救便，寡人不能決，願子為子主計之餘，為寡人計之。」陳軫對曰：「亦嘗有以夫卞莊子刺虎聞於王者乎？莊子欲刺虎，館豎子止之，曰：『兩虎方且食牛，食甘必爭，爭則必鬬，鬬則大者傷，小者死，從傷而刺之，一舉必有雙虎之名。』卞莊子以為然，立須之。有頃，兩虎果鬬，大者傷，小者死。莊子從傷者而刺之，一舉果有雙虎之功。今韓魏相攻，期年不解，是必大國傷，小國亡，從傷而伐之，一舉必有兩實。此猶莊子刺虎之類也。臣主與王何異也。」惠王曰：「善。」卒弗救。大國果傷，小國亡，秦興兵而伐，大剋之。此陳軫之計也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-070-zhang:m054-0010","start":10,"end":13,"surface":"秦惠王","kind":"person","person_id":"y97_huh_vuz_AAAAAAAAAAAAABAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m054-0019","start":19,"end":21,"surface":"左右","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、比擬或未定指代，不補姓名、家屬或成員。"},{"id":"c-shiji-070-zhang:m054-0022","start":22,"end":24,"surface":"左右","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、比擬或未定指代，不補姓名、家屬或成員。"},{"id":"c-shiji-070-zhang:m054-0036","start":36,"end":38,"surface":"惠王","kind":"person","person_id":"y97_huh_vuz_AAAAAAAAAAA