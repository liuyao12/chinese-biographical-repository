其荆州劉裕切齒來久今興死子劣乘其危亡而伐之臣觀其意必欲入闗勁躁之人不顧後患今若塞其西路裕必上岸北侵如此則姚無事而我受敵今蠕蠕内宼民食又乏不可發軍發軍赴南則北宼進擊若其救北則東州復危未若假之水道縱裕西入然後興兵塞其東歸之路所謂卞莊刺虎兩得之勢也使裕勝也必徳我假道之恵令姚氏勝也亦不失救隣之名縱使裕得闗中縣逺難守彼不能守終為我物今不勞兵馬坐觀成敗鬭兩虎而收長久之利上䇿也夫為國之計擇利而為之豈顧婚姻酬一女子之恵哉假令國家棄恒山以南裕必不能發吳越之兵與官軍爭守河北也居然可知議者猶曰裕西入函谷則進退路窮腹背受敵北上岸則姚軍必不出闗助我揚聲西行意在北進其勢然也太宗遂從羣議遣長孫嵩發兵拒之戰於畔城為裕將朱超石所敗師人多傷太宗聞之恨不用浩計","text_layer":"received_chapter","annotation_status":"in_progress","source_position":{"first_line":59,"last_line":84,"revision_id":"17b6525eb5aaa878b9640f5a61e90da934ce5fc4","source_layer":"received_biography","projection_sha256":"3f7e17a43b51df5d9b2822772c5b346d0acae6ed97716e66af236e2d8d3a87ad","raw_character_positions":[{"line":59,"column":18},{"line":59,"column":19},{"line":59,"column":20},{"line":60,"column":0},{"line":60,"column":1},{"line":60,"column":2},{"line":60,"column":3},{"line":60,"column":4},{"line":60,"column":5},{"line":60,"column":6},{"line":60,"column":7},{"line":60,"column":8},{"line":60,"column":9},{"line":60,"column":10},{"line":60,"column":11},{"line":60,"column":12},{"line":60,"column":13},{"line":60,"column":14},{"line":60,"column":15},{"line":60,"column":16},{"line":60,"column":17},{"line":60,"column":18},{"line":60,"column":19},{"line":60,"column":20},{"line":62,"column":0},{"line":62,"column":1},{"line":62,"column":2},{"line":62,"column":3},{"line":62,"column":4},{"line":62,"column":5},{"line":62,"column":6},{"line":62,"column":7},{"line":62,"column":8},{"line":62,"column":9},{"line":62,"column":10},{"line":62,"column":11},{"line":62,"column":12},{"line":62,"column":13},{"line":62,"column":14},{"line":62,"column":15},{"line":62,"column":16},{"line":62,"column":17},{"line":62,"column":18},{"line":62,"column":19},{"line":62,"column":20},{"line":63,"column":0},{"line":63,"column":1},{"line":63,"column":2},{"line":63,"column":3},{"line":63,"column":4},{"line":63,"column":5},{"line":63,"column":6},{"line":63,"column":7},{"line":63,"column":8},{"line":63,"column":9},{"line":63,"column":10},{"line":63,"column":11},{"line":63,"column":12