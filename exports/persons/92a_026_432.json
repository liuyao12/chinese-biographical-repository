wangyi-ws"},{"id":"c-songshu-046-wangyi:p006:m0063","start":63,"end":66,"surface":"朱超石","kind":"person","person_id":"92a_026_432","status":"contextual_provisional","interpretation_note":"完整王懿後補傳單元上下文辨識；AI判讀，未圖校。","paragraph_id":"c-songshu-046-wangyi:p006","chapter_id":"c-songshu-046-wangyi"},{"id":"c-weishu-weishou-035-cuihao:p004:m0436","start":436,"end":439,"surface":"朱超石","kind":"person","person_id":"92a_026_432","status":"resolved","resolution_note":"完整敘事單元上下文辨識；原字保留，不建立同名字面通用規則。","paragraph_id":"c-weishu-weishou-035-cuihao:p004","chapter_id":"c-weishu-weishou-035-cuihao"}],"relations":[],"title_holdings":[{"id":"th-nanshi-025-wangyi-4-212","title":"甯朔將軍","kind":"office","mode":"attestation","person_id":"92a_026_432","attestations":[{"id":"th-nanshi-025-wangyi-4-212:a","paragraph_id":"c-nanshi-025-wangyi:p004","start":212,"end":216,"surface":"甯朔將軍","person_mention_id":"c-nanshi-025-wangyi:p004:m0216","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-025","chapter_id":"c-nanshi-025-wangyi","source_id":"s-nanshi-025-wangyi-ws12757141","paragraph_id":"c-nanshi-025-wangyi:p004","quote":"武帝伐廣固，仲德為前驅，戰輒破之，大小二十餘戰。盧循寇逼，眾議並欲遷都，仲德正色曰：「今天子當陽南面，明公命世作輔，新建大功，威震六合。祅寇豕突，恃我遠征，既聞凱入，將自奔散。今日投草莽則同匹夫，匹夫號令，何以威物？此謀若立，請從此辭。」帝悅。及武帝與循戰于左裏，仲德功冠諸將，封新淦縣侯。義熙十二年北伐，進仲德征虜將軍，加冀州刺史，督前鋒諸軍事。冠軍將軍檀道濟、龍驤將軍王鎮惡向洛陽，甯朔將軍劉遵考、建武將軍沈林子出石門，甯朔將軍朱超石、胡藩向半城，咸受統于仲德。仲德率龍驤將軍朱牧、甯遠將軍竺靈秀、嚴綱等開钜野入河，乃總眾軍進據潼關。長安平，以仲德為太尉諮議參軍。","person_mention_id":"c-nanshi-025-wangyi:p004:m0216"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"th-song046-wangyi-ws-31-67","person_id":"92a_026_432","title":"寧朔將軍","kind":"office","mode":"attestation","attestations":[{"id":"th-song046-wangyi-ws-31-67:a","paragraph_id":"c-songshu-046-wangyi-ws:p006","start":67,"end":71,"surface":"寧朔將軍","person_mention_id":"c-songshu-046-wangyi-ws:p006:m0071","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-046","chapter_id":"c-songshu-046-wangyi-ws","source_id":"s-songshu-046-wangyi-ws-ws2118581","paragraph_id":"c-songshu-046-wangyi-ws:p006","quote":"義熙十二年北伐，進仲德征虜將軍，加冀州刺史，為前鋒諸軍事。冠軍將軍檀道濟、龍驤將軍王鎮惡向洛陽，寧朔將軍劉遵考、建武將軍沈林子出石門，寧朔將軍朱超石、胡藩向半城，咸受統於仲德。仲德率龍驤將軍朱牧、寧遠將軍竺靈秀、嚴綱等開鉅野入河，乃總眾軍，進據潼關。長安平，以仲德為太尉諮議參軍。","person_mention_id":"c-songshu-046-wangyi-ws:p006:m0071"}],"status":"source_attested","interpretation_note":"本句所載官名，任期無確切年月。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanshi-025-wangyi:p004","text":"武帝伐廣固，仲德為前驅，戰輒破之，大小二十餘戰。盧循寇逼，眾議並欲遷都，仲德正色曰：「今天子當陽南面，明公命世作輔，新建大功，威震六合。祅寇豕突，恃我遠征，既聞凱入，將自奔散。今日投草莽則同匹夫，匹夫號令，何以威物？此謀若立，請從此辭。」帝悅。及武帝與循戰于左裏，仲德功冠諸將，封新淦縣侯。義熙十二年北伐，進仲德征虜將軍，加冀州刺史，督前鋒諸軍事。冠軍將軍檀道濟、龍驤將軍王鎮惡向洛陽，甯朔將軍劉遵考、建武將軍沈林子出石門，甯朔將軍朱超石、胡藩向半城，咸受統于仲德。仲德率龍驤將軍朱牧、甯遠將軍竺靈秀、嚴綱等開钜野入河，乃總眾軍進據潼關。長安平，以仲德為太尉諮議參軍。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":19,"last_line":19,"raw_start":694,"raw_end":978,"raw_character_offsets":[694,695,696,697,698,699,700,701,702,703,704,705,706,707,708,709,710,711,712,713,714,715,716,717,718,719,720,721,722,723,724,725,726,727,728,729,730,731,732,733,734,735,736,737,738,739,740,741,742,743,744,745,746,747,748,749,750,751,752,753,754,755,756,757,758,759,760,761,762,763,764,765,766,767,768,769,770,771,772,773,774,775,776,777,778,779,780,781,782,783,784,785,786,787,788,789,790,791,792,793,794,795,796,797,798,799,800,801,802,803,804,805,806,807,808,809,810,811,812,813,814,815,816,817