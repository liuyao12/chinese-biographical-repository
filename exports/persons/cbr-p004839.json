政","kind":"person","person_id":"cbr-p004834","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m019-0033","start":33,"end":35,"surface":"其姊","kind":"person","person_id":"cbr-p004839","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m019-0058","start":58,"end":60,"surface":"姊弟","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未定稱呼保持未解，不補姓名。"},{"id":"c-shiji-086-cike:m019-0074","start":74,"end":77,"surface":"嚴仲子","kind":"person","person_id":"cbr-p004835","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m019-0079","start":79,"end":82,"surface":"嚴仲子","kind":"person","person_id":"cbr-p004835","status":"contextual_provisional"}],"chapter_id":"c-shiji-086-cike","book_id":"b-shiji-086","work_id":"w-shiji","source_id":"s-shiji-086-cike"}],"sources":[{"chapter_id":"c-shiji-086-cike","work_id":"w-shiji","book_id":"b-shiji-086","source_id":"s-shiji-086-cike","source":{"title":"史記／卷086","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷086","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷086&oldid=2388562","revision_id":2388562,"accessed_on":"2026-10-09","extent":"38段正文含太史公論，排除導覽、索隱述贊及現代版權。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"固定HTML與取得時版本一致，只去外緣空白；（衆）按普通括號原文保留；第17段tooltip異文提示另存。","note":"全38段與HTML篇界已核讀，未核底本影像或現代研究。","digital_variant_notes":[{"paragraph_number":17,"body_reading":"縣","witness_tooltip":"一作「購縣」，又作「縣購」。","note":"數位見證未標明異文版本，另存，不代替正文。"}]}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical"}}
