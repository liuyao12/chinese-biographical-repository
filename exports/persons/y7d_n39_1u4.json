"raw_character_offsets":[10174,10175,10176,10177,10178,10179,10180,10181,10182,10183,10184,10185,10186,10187,10188,10189,10190,10191,10192,10193,10194,10195,10196,10197,10198,10199,10200,10201,10202,10203,10204,10205,10206,10207,10208,10209,10210,10211,10212,10213,10214,10215,10216,10217,10218,10219,10220,10221,10222,10223,10224,10225,10226,10227,10228,10229,10230,10231,10232,10233,10234,10235,10236,10237,10238,10239,10240,10241,10242,10243,10244,10245,10246,10247,10248,10249,10250,10251,10252,10253],"first_line":136,"last_line":136,"source_layer":"received_biography"},"chapter_id":"c-jinshu-037-gaomi-nanyang-ws2630018","book_id":"b-jinshu-037","work_id":"w-jinshu","source_id":"s-jinshu037-gaomi-nanyang-ws2630018"},{"id":"c-jinshu-037-gaomi-nanyang-ws2630018:p010","text":"湣帝之蒙塵也，保自稱晉王。時上邽大饑，士眾窘困，張春奉保之南安。陳安自號秦州刺史，稱籓于劉曜。春復奉保奔桑城，將投于張寔。寔使兵迎保，實禦之也。是歲，保病薨，時年二十七。保體質豐偉，嘗自稱重八百斤。喜睡，痿疾，不能禦婦人。無子，張春立宗室司馬瞻奉保後。陳安舉兵攻春，春走，瞻降于安，安送詣劉曜，曜殺之。安迎保喪，以天子禮葬于上邽，諡曰元。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","voice_scope":"史臣敘事","mentions":[{"id":"c-jinshu-037-gaomi-nanyang-ws2630018:p010:m0000","start":0,"end":2,"surface":"湣帝","kind":"person","person_id":"dkn_ge4_286_AAAAIAND","status":"contextual_provisional","source_identity_role":"min","identity_reading_ref":"source-evidence/jin037-gaomi-nanyang/identity-readings.json#min"},{"id":"c-jinshu-037-gaomi-nanyang-ws2630018:p010:m0007","start":7,"end":8,"surface":"保","kind":"person","person_id":"dkn_ge4_286_AAADBDA","status":"contextual_provisional","source_identity_role":"bao","identity_reading_ref":"source-evidence/jin037-gaomi-nanyang/identity-readings.json#bao"},{"id":"c-jinshu-037-gaomi-nanyang-ws2630018:p010:m0024","start":24,"end":26,"surface":"張春","kind":"person","person_id":"qfa_gs9_fjn","status":"contextual_provisional","source_identity_role":"zhangchun","identity_reading_ref":"source-evidence/jin037-gaomi-nanyang/identity-readings.json#zhangchun"},{"id":"c-jinshu-037-gaomi-nanyang-ws2630018:p010:m0