,"status":"contextual_provisional","interpretation_note":"依本段實名及敘述視點。","start":118,"end":119,"surface":"澄"},{"id":"c-nanqishu-023-wangjian:p008:m0151","person_id":"roi_rz4_ute","kind":"person","status":"contextual_provisional","interpretation_note":"依本段實名及敘述視點。","start":151,"end":154,"surface":"張子布"}],"source_position":{"revision_id":1545488,"first_line":77,"last_line":77,"raw_start":5704,"raw_end":5865,"line_start":0,"line_end":161,"source_layer":"received_biography"},"chapter_id":"c-nanqishu-023-wangjian","book_id":"b-nanqishu-023","work_id":"w-nanqishu","source_id":"s-nanqishu-023-wangjian-ws1545488"},{"id":"c-nanqishu-044-shenwenji-wangjian:p001","text":"　　沈文季字仲達，吳興武康人。父慶之，宋司空。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-nanqishu-044-shenwenji-wangjian:p001:m0002","person_id":"408_ce3_5d8_A","kind":"person","status":"contextual_provisional","interpretation_note":"依本段實名及敘述視點。","start":2,"end":5,"surface":"沈文季"},{"id":"c-nanqishu-044-shenwenji-wangjian:p001:m0006","person_id":"408_ce3_5d8_A","kind":"person","status":"contextual_provisional","interpretation_note":"依本段實名及敘述視點。","start":6,"end":8,"surface":"仲達"},{"id":"c-nanqishu-044-shenwenji-wangjian:p001:m0016","person_id":"408_ce3_5d8","kind":"person","status":"contextual_provisional","interpretation_note":"依本段實名及敘述視點。","start":16,"end":18,"surface":"慶之"}],"source_position":{"revision_id":1507959,"first_line":31,"last_line":31,"raw_start":2118,"raw_end":2141,"line_start":0,"line_end":23,"source_layer":"received_biography"},"chapter_id":"c-nanqishu-044-shenwenji-wangjian","book_id":"b-nanqishu-044","work_id":"w-nanqishu","source_id":"s-nanqishu-044-shenwenji-wangjian-ws1507959"},{"id":"c-nanshi-022-wangjian:p009","text":"帝幸樂遊宴集，謂儉曰：「卿好音樂，孰與朕同？」儉曰：「沐浴唐風，事兼比屋，亦既在齊，不知肉味。」帝稱善。後幸華林宴集，使各效伎藝。褚彥回彈琵琶，王僧虔、柳世隆彈琴，沈文季歌子夜來，張敬兒舞。儉曰：「臣無所解，唯知誦書。」因跪上前誦相如封禪書。上笑曰：「此盛德之事，吾何以堪之。」後上使陸澄誦孝經，起自「仲尼居」，儉曰：「澄所謂博而寡要。臣請誦之。」乃誦君子之事上章。上曰：「善，張子布更覺非奇也。」於是王敬則脫朝服袒，以絳糾髻，奮臂拍張，叫動左右。上不悅曰：「豈聞三公如此。」答曰：「臣以拍張，故得三公，不可忘拍張。」時以為名答。","mentions":[{"id":"c-nanshi-022-wangjian:p009:m0008","person_id":"7r6_k52_qji_ABAAAAEAA","start":8,"end":9,"surface":"儉","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanshi-022-wangjian:p009:m0023","person_id":"7r6_k52_qji_ABAAAAEAA","start":23,"end":24,"surface":"儉","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanshi-022-wangjian:p009:m0065","person_id":"jyx_72x_8t2","start":65,"end":68,"surface":"褚彥回","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanshi-022-wangjian:p009:m0072","person_id":"7r6_k52_qji_ABAAAAEB","start":72,"end":75,"surface":"王僧虔","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanshi-022-wangjian:p009:m0076","person_id":"5jc_z9b_i2n_AAAA","start":76,"end":79,"surface":"柳世隆","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanshi-022-wangjian:p009:m0082","person_id":"408_ce3_5d8_A","start":82,"end":85,"surface":"沈文季","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanshi-022-wangjian:p009:m0090","person_id":"stv_g27_gl2","start":90,"end":93,"surface":"張敬兒","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanshi-022-wangjian:p009:m0095","person_id":"7r6_k52_qji_ABAAAAEAA","start":95,"end":96,"surface":"儉","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanshi-022-wangjian:p009:m0115","person_id":"usb_lgr_ksa","start":115,"end":117,"surface":"相如","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanshi-022-wangjian:p009:m0142","person_id":"77h_id3_a0i_AA","start":142,"end":144,"surface":"陸澄","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanshi-022-wangjian:p009:m0151","per