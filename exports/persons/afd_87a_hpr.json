kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-058-zhou-fang:p003:m0097","surface":"李恆","start":97,"end":99,"person_id":"afd_87a_hpr","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-058-zhou-fang:p003","chapter_id":"c-jinshu-058-zhou-fang"},{"id":"c-jinshu-058-zhou-fang:p004:m0211","surface":"李恆","start":211,"end":213,"person_id":"afd_87a_hpr","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-058-zhou-fang:p004","chapter_id":"c-jinshu-058-zhou-fang"},{"id":"c-jinshu-058-zhou-zha:p002:m0347","surface":"李恆","start":347,"end":349,"person_id":"afd_87a_hpr","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-058-zhou-zha:p002","chapter_id":"c-jinshu-058-zhou-zha"},{"id":"c-jinshu-098-jin033-wangji:line049:m0109","start":109,"end":111,"surface":"李恆","kind":"person","person_id":"afd_87a_hpr","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line049","chapter_id":"c-jinshu-098-jin033-wangji"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-058-zhou-fang:p003","text":"帝以訪爲振武將軍、尋陽太守，加鼓吹、曲蓋。復命訪與諸軍共征杜弢。弢作桔槔打官軍船艦，訪作長岐棖以距之，桔槔不得爲害。而賊從青草湖密抄官軍，又遣其將張彥陷豫章，焚燒城邑。王敦時鎮湓口，遣督護繆蕤、李恆受訪節度，共擊彥。蕤於豫章、石頭，與彥交戰，彥軍退走，訪率悵下將李午等追彥，破之，臨陣斬彥。時訪爲流矢所中，折前兩齒，形色不變。及暮，訪與賊隔水，賊眾數倍，自知力不能敵，乃密遣人如樵采者而出，於是結陣鳴鼓而來，大呼曰：「左軍至！」士卒皆稱萬歳。至夜，令軍中多布火而食，賊謂官軍益至，未曉而退。訪謂諸將曰：「賊必引退，然終知我無救軍，當還掩人，宜促渡水北。」既渡，斷橋訖，而賊果至，隔水不得進，於是遂歸湘州。訪復以舟師造湘城，軍達富口，而弢遣杜弘出海昏。時湓口騷動，訪歩上柴桑，偷渡，與賊戰，斬首數百。賊退保廬陵，訪追擊敗之，賊嬰城處自守。尋而軍糧爲賊所掠，退住巴丘。糧廩既至，復圍弘於廬陵。弘大擲寶物於城外，軍人競拾之，弘因陣亂突圍而出。訪率軍追之，獲鞍馬鎧杖不可勝數。弘入南康，太守將率兵逆擊，又破之，奔於臨賀。帝又進訪龍驤將軍。王敦表爲豫章太守。加征討都督，賜爵尋陽縣侯。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":72,"last_line":72,"raw_start":6006,"raw_end":6511,"raw_character_offsets":[6008,6009,6010,6011,6012,6013,6014,6015,6016,6017,6018,6019,6020,6021,6022,6023,6024,6025,6026,6027,6028,6029,6030,6031,6032,6033,6034,6035,6038,6041,6042,6043,6044,6045,6046,6047,6048,6049,6050,6051,6052,6053,6054,6055,6056,6057,6058,6059,6060,6061,6062,6063,6064,6065,6066,6067,6068,6069,6070,6071,6072,6073,6074,6075,6076,6077,6078,6079,6080,6081,6082,6083,6084,6085,6086,6087,6088,6089,6090,6091,6092,6093,6094,6095,6096,6097,6098,6099,6100,6101,6102,6103,6104,6105,6106,6107,6108,6109,6110,6111,6112,6113,6114,6115,6116,6117,6118,6119,6120,6123,6126,6127,6128,6129,6130,6131,6132,6133,6134,6135,6136,6137,6138,6139,6140,6141,6142,6143,6144,6145,6146,6147,6148,6149,6150,6151,6152,6153,6154,6155,6156,6157,6158,6159,6160,6161,6162,6163,6164,6165,6166,6167,6168,6169,6170,6171,6172,6173,6174,6175,6176,6177,6178,6179,6180,6181,6182,6183,6184,6185,6186,6187,6188,6189,6190,6191,6192,6193,6194,6195,6196,6197,6198,6199,6200,6201,6202,6203,6204,6205,6206,6207,6208,6209,6210,6211,6212,6213,6214,6215,6216,6217,6218,6219,6220,6221,6222,6223,6224,6225,6226,6227,6228,6229,6230,6231,6232,6233,6234,6235,6236,6237,6238,6239,6240,6241,6242,6243,6244,6245,6246,6247,6248,6249,6250,6251,6252,6253,6254,6255,6256,6257,6258,6259,6260,6261,6262,6263,6264,6265,6266,6267,6268,6269,6270,6271,6272,6273,6274,6275,6276,6277,6278,6279,6280,6281,6282,6283,6284,6285,6286,6287,6288,6289,6290,6291,6292,6293,6294,6295,6296,6297,6298,6299,6300,6301,6302,6303,6304,6305,6306,6307,6308,6309,6310,6311,6312,6313,6314,6315,6316,6317,6318,6319,6320,6321,6322,6323,6324,6325,6326,6327,6328,6329,6330,6331,6332,6333,6334,6335,6336,6337,6338,6339,6340,6341,6342,6343,6344,6345,6346,6347,6348,6349,6350,6351,6352,6353,6354,6355,6356,6357,6358,6359,6360,6361,6362,6363,6364,6365,6366,6367