iji","source_id":"s-shiji-064-sima"},{"id":"c-shiji-130-taishigong:p058","text":"完子避難，適齊為援，陰施五世，齊人歌之。成子得政，田和為侯。王建動心，乃遷于共。嘉威、宣能撥濁世而獨宗周，作田敬仲完世家第十六。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m058-0000","start":0,"end":2,"surface":"完子","kind":"person","person_id":"lmu_nbm_rzo_AAA","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m058-0020","start":20,"end":22,"surface":"成子","kind":"person","person_id":"lmu_nbm_rzo_AAAAAAABA","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m058-0025","start":25,"end":27,"surface":"田和","kind":"person","person_id":"lmu_nbm_rzo_AAAAAAABAAAA","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m058-0030","start":30,"end":32,"surface":"王建","kind":"person","person_id":"1h3_vs7_t8h_AA","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m058-0041","start":41,"end":42,"surface":"威","kind":"person","person_id":"lmu_nbm_rzo_AAAAAAABAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m058-0043","start":43,"end":44,"surface":"宣","kind":"person","person_id":"lmu_nbm_rzo_AAAAAAABAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m058-0054","start":54,"end":58,"surface":"田敬仲完","kind":"person","person_id":"lmu_nbm_rzo_AAA","status":"contextual_provisional"}],"chapter_id":"c-shiji-130-taishigong","book_id":"b-shiji-130","work_id":"w-shiji","source_id":"s-shiji130-taishigong"}],"sources":[{"chapter_id":"c-shiji-046-tian","work_id":"w-shiji","book_id":"b-shiji-046","source_id":"s-shiji-046-tian","source":{"title":"史記／卷046","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷046","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷046&oldid=2560838","revision_id":2560838,"accessed_on":"2026-10-09","extent":"55段正文（含太史公論贊）及1段索隱述贊，後者另標witness_appended_suoyin_zan；排除2個dd導覽及現代分節標題。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://cre