p025","chapter_id":"c-shiji-052-qidaohui"},{"id":"c-shiji-052-qidaohui:m025-0118","start":118,"end":122,"surface":"路中大夫","kind":"person","person_id":"cbr-p003251","status":"contextual_provisional","paragraph_id":"c-shiji-052-qidaohui:p025","chapter_id":"c-shiji-052-qidaohui"},{"id":"c-shiji-052-qidaohui:m025-0142","start":142,"end":146,"surface":"路中大夫","kind":"person","person_id":"cbr-p003251","status":"contextual_provisional","paragraph_id":"c-shiji-052-qidaohui:p025","chapter_id":"c-shiji-052-qidaohui"},{"id":"c-shiji-052-qidaohui:m025-0171","start":171,"end":175,"surface":"路中大夫","kind":"person","person_id":"cbr-p003251","status":"contextual_provisional","paragraph_id":"c-shiji-052-qidaohui:p025","chapter_id":"c-shiji-052-qidaohui"},{"id":"c-shiji-052-qidaohui:m025-0227","start":227,"end":231,"surface":"路中大夫","kind":"person","person_id":"cbr-p003251","status":"contextual_provisional","paragraph_id":"c-shiji-052-qidaohui:p025","chapter_id":"c-shiji-052-qidaohui"},{"id":"c-shiji-052-qidaohui:m026-0018","start":18,"end":22,"surface":"路中大夫","kind":"person","person_id":"cbr-p003251","status":"contextual_provisional","paragraph_id":"c-shiji-052-qidaohui:p026","chapter_id":"c-shiji-052-qidaohui"}],"relations":[],"title_holdings":[{"id":"th-shiji052-041","person_id":"cbr-p003251","title":"路中大夫","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-052-qidaohui","source_id":"s-shiji-052-qidaohui","paragraph_id":"c-shiji-052-qidaohui:p025","quote":"齊孝王十一年，吳王濞、楚王戊反，興兵西，告諸侯曰「將誅漢賊臣晁錯以安宗廟」。膠西、膠東、菑川、濟南皆擅發兵應吳楚。欲與齊，齊孝王狐疑，城守不聽，三國兵共圍齊。齊王使路中大夫告於天子。天子復令路中大夫還告齊王：「善堅守，吾兵今破吳楚矣。」路中大夫至，三國兵圍臨菑數重，無從入。三國將劫與路中大夫盟，曰：「若反言漢已破矣，齊趣下三國，不且見屠。」路中大夫既許之，至城下，望見齊王，曰：「漢已發兵百萬，使太尉周亞夫擊破吳楚，方引兵救齊，齊必堅守無下！」三國將誅路中大夫。"}],"attestations":[{"id":"th-shiji052-041:a001","paragraph_id":"c-shiji-052-qidaohui:p025","start":82,"end":86,"surface":"路中大夫","person_mention_id":"c-shiji-052-qidaohui:m025-0082","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予、任事、提議、回敘及用稱分開；年號僅留原語，不反算公曆起訖。朱虛、東牟許封趙梁而未實現不記實授，死亡不自動終止全部稱號。章與興居授王兩處年表述各留原段，不擅調和。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji052-038","person_id":"cbr-p003251","surfaces":["路中大夫"],"scope":"same_chapter","chapter_ids":["c-shiji-052-qidaohui"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-052-qidaohui:p025","quote":"齊孝王十一年，吳王濞、楚王戊反，興兵西，告諸侯曰「將誅漢賊臣晁錯以安宗廟」。膠西、膠東、菑川、濟南皆擅發兵應吳楚。欲與齊，齊孝王狐疑，城守不聽，三國兵共圍齊。齊王使路中大夫告於天子。天子復令路中大夫還告齊王：「善堅守，吾兵今破吳楚矣。」路中大夫至，三國兵圍臨菑數重，無從入。三國將劫與路中大夫盟，曰：「若反言漢已破矣，齊趣下三國，不且見屠。」路中大夫既許之，至城下，望見齊王，曰：「漢已發兵百萬，使太尉周亞夫擊破吳楚，方引兵救齊，齊必堅守無下！」三國將誅路中大夫。"},{"paragraph_id":"c-shiji-052-qidaohui:p026","quote":"齊初圍急，陰與三國通謀，約未定，會聞路中大夫從漢來，喜，及其大臣乃復勸王毋下三國。居無何，漢將欒布、平陽侯等兵至齊，擊破三國兵，解齊圍。已而復聞齊初與三國有謀，將欲移兵伐齊。齊孝王懼，乃飲藥自殺。景帝聞之，以為齊首善，以迫劫有謀，非其罪也，乃立孝王太子壽為齊王，是為懿王，續齊後。而膠西、膠東、濟南、菑川王咸誅滅，地入于漢。徙濟北王王菑川。齊懿王立二十二年卒，子次景立，是為厲王。"}],"rationale":"依明示名與王國、世次的局部敘事暫接；齊、城陽與菑川同諡者分開，興居與志分開。校勘建延及內史勳士未擅選讀法，未名帝后不補姓名，案件只保存來源敘事。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-052-qidaohui:p025","text":"齊孝王十一年，吳王濞、楚王戊反，興兵西，告諸侯曰「將誅漢賊臣晁錯以安宗廟」。膠西、膠東、菑川、濟南皆擅發兵應吳楚。欲與齊，齊孝王狐疑，城守不聽，三國兵共圍齊。齊王使路中大夫告於天子。天子復令路中大夫還告齊王：「善堅守，吾兵今破吳楚矣。」路中大夫至，三國兵圍臨菑數重，無從入。三國將劫與路中大夫盟，曰：「若反言漢已破矣，齊趣下三國，不且見屠。」路中大夫既許之，至城下，望見齊王，曰：「漢已發兵百萬，使太尉周亞夫擊破吳楚，方引兵救齊，齊必堅守無下！」三國將誅路中大夫。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-052-qidaohui:m025-0000","start":0,"end":3,"surface":"齊孝王","kind":"person","person_id":"cbr-p003236","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m025-0007","start":7,"end":10,"surface":"吳王濞","kind":"person","person_id":"cbr-p003249","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m025-0011","start":11,"end":14,"surface":"楚王戊","kind":"person","person_id":"cbr-p003250","status":"contextual_provisional"},{"id"