entioned_source_ids":["s-jinshu-064-simadaosheng-ws2622004"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin064-xunzhi-ancestor","subject_person_id":"1gr_agz_a4h","object_person_id":"tph_dpd_6m5","predicate":"ancestor","qualifiers":{"source_term":"西陽王錄玄孫珣之"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-064","chapter_id":"c-jinshu-064-simadaosheng","source_id":"s-jinshu-064-simadaosheng-ws2622004","paragraph_id":"c-jinshu-064-simadaosheng:p001","quote":"會稽思世子道生，字延長。帝為會稽王，立道生為世子，拜散騎侍郎、給事中。性疏躁，不修行業，多失禮度，竟以幽廢而卒，時年二十四，無後。及孝武帝即位，嘗晝日見道生及臨川獻王郁，鬱曰：「大郎饑乏辛苦。」言竟不見。帝傷感，因以西陽王錄玄孫珣之為後。珣之曆吳興太守。劉裕之伐關中，以為諮議參軍。時帝道方謝，珣之為宗室之美，與梁王珍之俱被害。","subject_person_mention_id":"c-jinshu-064-simadaosheng:p001:m0114","object_person_mention_id":"c-jinshu-064-simadaosheng:p001:m0111"}],"status":"source_attested","interpretation_note":"原詞玄孫；中間代未由本句點名。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-064-simadaosheng:p001:m0111","surface":"錄","start":111,"end":112,"person_id":"tph_dpd_6m5","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-064-simadaosheng:p001","chapter_id":"c-jinshu-064-simadaosheng"}],"relations":[{"id":"a-jin064-xunzhi-ancestor","subject_person_id":"1gr_agz_a4h","object_person_id":"tph_dpd_6m5","predicate":"ancestor","qualifiers":{"source_term":"西陽王錄玄孫珣之"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-064","chapter_id":"c-ji