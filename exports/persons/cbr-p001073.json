,"start":14,"end":16,"surface":"哀公","kind":"person","person_id":"cbr-p001073","status":"contextual_provisional"}],"chapter_id":"c-shiji-033-lu","book_id":"b-shiji-033","work_id":"w-shiji","source_id":"s-shiji-033-lu"},{"id":"c-shiji-033-lu:p082","text":"哀公五年，齊景公卒。六年，齊田乞弒其君孺子。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-033-lu:m082-0000","start":0,"end":2,"surface":"哀公","kind":"person","person_id":"cbr-p001073","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m082-0005","start":5,"end":8,"surface":"齊景公","kind":"person","person_id":"cbr-p001072","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m082-0013","start":13,"end":16,"surface":"齊田乞","kind":"person","person_id":"cbr-p000431","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m082-0019","start":19,"end":21,"surface":"孺子","kind":"person","person_id":"cbr-p000432","status":"contextual_provisional"}],"chapter_id":"c-shiji-033-lu","book_id":"b-shiji-033","work_id":"w-shiji","source_id":"s-shiji-033-lu"},{"id":"c-shiji-033-lu:p085","text":"齊伐魯。季氏用冉有有功，思孔子，孔子自衛歸魯。齊田常弒其君簡公於俆州。孔子請伐之，哀公不聽。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-033-lu:m085-0004","start":4,"end":6,"surface":"季氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未指名者、論贊署稱、地點氏稱或未定指代；不補姓名、爵位與成員。"},{"id":"c-shiji-033-lu:m085-0007","start":7,"end":9,"surface":"冉有","kind":"person","person_id":"cbr-p001298","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m085-0013","start":13,"end":15,"surface":"孔子","kind":"person","person_id":"cbr-p000056","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m085-0016","start":16,"end":18,"surface":"孔子","kind":"person","person_id":"cbr-p000056","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m085-0023","start":23,"end":26,"surface":"齊田常","kind":"person","person_id":"cbr-p000270","status":"contextual_provisional"},{"id":"c-shiji-033-lu: