ntified","paragraph_id":"c-shiji-004-zhou:p003","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-004-zhou:m027-0169","start":169,"end":171,"surface":"不窋","kind":"person","person_id":"cbr-p000160","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p027","chapter_id":"c-shiji-004-zhou"}],"relations":[{"id":"a-shiji004-003","subject_person_id":"cbr-p000160","predicate":"father","object_person_id":"cbr-p000046","status":"source_attested","evidence":[{"paragraph_id":"c-shiji-004-zhou:p003","quote":"后稷卒，子不窋立","chapter_id":"c-shiji-004-zhou","source_id":"s-shiji-004-zhou"}],"qualifiers":{"source_term":"子","historicity":"historical_tradition"},"interpretation_note":"僅記本文明示關係，不由繼位推導父子。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji004-004","subject_person_id":"cbr-p000161","predicate":"father","object_person_id":"cbr-p000160","status":"source_attested","evidence":[{"paragraph_id":"c-shiji-004-zhou:p003","quote":"不窋卒，子鞠立","chapter_id":"c-shiji-004-zhou","source_id":"s-shiji-004-zhou"}],"qualifiers":{"source_term":"子","historicity":"historical_tradition"},"interpretation_note":"僅記本文明示關係，不由繼位推導父子。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-004-zhou:p003","text":"后稷卒，子不窋立。不窋末年，夏后氏政衰，去稷不務，不窋以失其官而犇戎狄之間。不窋卒，子鞠立。鞠卒，子公劉立。公劉雖在戎狄之間，復修后稷之業，務耕種，行地宜，自漆、沮度渭，取材用，行者有資，居者有畜積，民賴其慶。百姓懷之，多徙而保歸焉。周道之興自此始，故詩人歌樂思其德。公劉卒，子慶節立，國於豳。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-004-zhou:m003-0000","start":0,"end":2,"surface":"后稷","kind":"person","person_id":"cbr-p000046","status":"source_identified"},{"id":"c-shiji-004-zhou:m003-0005","start":5,"end":7,"surface":"不窋","kind":"person","person_id":"cbr-p000160","status":"source_identified"},{"id":"c-shiji-004-zhou:m003-0009","start":9,"end":11,"surface":"不窋","kind":"person","person_id":"cbr-p000160","status":"source_identified"},{"id":"c-shiji-004-zhou:m003-0014","start":14,"end":17,"surface":"夏后氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"未定個人、群體或氏族稱謂；不推造個別姓名與成員數目。"},{"id":"c-shiji-004-zhou:m003-0025","start":25,"end":27,"surface":"不窋","kind":"person","person_id":"cbr-p000160","status":"source_identified"},{"id":"c-shiji-004-zhou:m003-0038","start":38,"end":40,"surface":"不窋","kind":"person","person_id":"cbr-p000160","status":"source_identified"},{"id":"c-shiji-004-zhou:m003-0043","start":43,"end":44,"surface":"鞠","kind":"person","person_id":"cbr-p000161","status":"source_identified"},{"id":"c-shiji-004-zhou:m003-0046","start":46,"end":47,"surface":"鞠","kind":"person","person_id":"cbr-p000161","status":"source_identified"},{"id":"c-shiji-004-zhou:m003-0050","start":50,"end":52,"surface":"公劉","kind":"person","person_id":"cbr-p000162","status":"source_identified"},{"id":"c-shiji-004-zhou:m003-0054","start":54,"end":56,"surface":"公劉","kind":"person","person_id":"cbr-p000162","status":"source_identified"},{"id":"c-shiji-004-zhou:m003-0065","start":65,"end":67,"surface":"后稷","kind":"person","person_id":"cbr-p000046","status":"source_identified"},{"id":"c-shiji-004-zhou:m003-0134","start":134,"end":136,"surface":"公劉","kind":"person","person_id":"cbr-p000162","status":"source_identified"},{"id":"c-shiji-004-zhou:m003-0139","start":139,"end":141,"surface":"慶節","kind":"person","person_id":"cbr-p000163","status":"source_identified"}],"chapter_id":"c-shiji-004-zhou","book_id":"b-shiji-004","work_id":"w-shiji","source_id":"s-shiji-004-zhou"},{"id":"c-shiji-004-zhou:p027","text":"穆王將征犬戎，祭公謀父諫曰：「不可。先王燿德不觀兵。夫兵戢而時動，動則威，觀則玩，玩則無震。是故周文公之頌曰：『載戢干戈，載櫜弓矢，我求懿德，肆于時夏，允王保之。』先王之於民也，茂正其德而厚其性，阜其財求而利其器用，明利害之鄉，以文修之，使之務利而辟害，懷德而畏威，故能保世以滋大。昔我先王世后稷以服事虞、夏。及夏之衰也，棄稷不務，我先王不窋用失其官，而自竄於戎狄之閒。不敢怠業，時序其德，遵修其緒，修其訓典，朝夕恪勤，守以敦篤，奉以忠信。奕世載德，不忝前人。至于文王、武王，昭前之光明而加之以慈和，事神保民，無不欣喜。商王帝辛大惡于民，庶民不忍，訢載武王，以致戎于商牧。是故先王非務武也，勸恤民隱而除其害也。夫先王之制，邦內甸服，邦外侯服，侯衛賓服，夷蠻要服，戎翟荒服。甸服者祭，侯服者祀，賓服者享，要服者貢，荒服者王。日祭，月祀，時享，歲貢，終王。先王之順祀也，有不祭則修意，有不祀則修言，有不享則修文，有不貢則修名，有不王則修德，序成而有不至則修刑。於是有刑不祭，伐不祀，征不享，讓不貢，告不王。於是有刑罰之辟，有攻伐之兵，有征討之備，有威讓之命，有文告之辭。布令陳辭而有不至，則增修於德，無勤民於遠。是以近無不聽，遠無不服。今自大畢、伯士之終也，犬戎氏以其職來王，天子曰『予必以不享征之，且觀之兵』，無乃廢先王之訓，而王幾頓乎？吾聞犬戎樹敦，率舊德而守終純固，其有以御我矣。」王遂征之，得四白狼四白鹿以歸。自是荒服者不至。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-004-zhou:m027-0000","start":0,"end":2,"surface":"穆王","kind":"person","person_id":"cbr-p000197","status":"source_identified"},{"id":"c-shiji-004-zhou:m027-0007","start":7,"end":11,"surface":"祭公謀父","kind":"person","person_id":"cbr-p000199","status":"source_identified"},{"id":"c-shiji-004-zhou:m027-0018","start":18,"end":20,"surface":"先王","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官號或文字疑讀；保留錨點，不補熟知姓名或假定同指。"},{"id":"c-shiji-004-zhou:m027-0048","start":48,"end":51,"surface":"周文公","kind":"person","person_id":"cbr-p000156","status":"contextual_provisional","interpretation_note":"依同段明示人物與敘事暫定短稱，不作其他段落或其他時代的自動識別。"},{"id":"c-shiji-004-zhou:m027-0082","start":82,"end":84,"surface":"先王","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官號或文字疑讀；保留錨點，不補熟知姓名或假定同指。"},{"id":"c-shiji-004-zhou:m027-0143","start":143,"end":145,"surface":"先王","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官號或文字疑讀；保留錨點，不補熟知姓名或假定同指。"},{"id":"c-shiji-004-zhou:m027-0146","start":146,"end":148,"surface":"后稷","kind":"person","person_id":"cbr-p000046","status":"source_identified"},{"id":"c-shiji-004-zhou:m027-0167","start":167,"end":169,"surface":"先王","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官號或文字疑讀；保留錨點，不補熟知姓名或假定同指。"},{"id":"c-shiji-004-zhou:m027-0169","start":169,"end":171,"surface":"不窋","kind":"person","person_id":"cbr-p000160","status":"source_identified"},{"id":"c-shiji-004-zhou:m027-0232","start":232,"end":234,"surface":"文王","kind":"person","person_id":"cbr-p000139","status":"source_identified"},{"id":"c-shiji-004-zhou:m027-0235","start":235,"end":237,"surface":"武王","kind":"person","person_id":"cbr-p000150","status":"source_identified"},{"id":