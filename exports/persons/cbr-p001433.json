qh_AAAAA","status":"source_attested","evidence":[{"chapter_id":"c-shiji-035-guancai","source_id":"s-shiji-035-guancai","paragraph_id":"c-shiji-035-guancai:p037","quote":"二十五年，晉文公卒。三十五年，共公卒，子文公壽立。文公二十三年卒，子宣公彊立。宣公十七年卒，弟成公負芻立。"}],"qualifiers":{"source_term":"子","historicity":"historical_tradition"},"interpretation_note":"保存本篇明示親屬稱呼，不由繼位推父子，不補闕代、無名者名字或原文未見的同父同母。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji035-039","person_id":"vs4_n7e_1qh_AAAAA","title":"共公","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-035-guancai","source_id":"s-shiji-035-guancai","paragraph_id":"c-shiji-035-guancai:p035","quote":"昭公六年，齊桓公敗蔡，遂至楚召陵。九年，昭公卒，子共公襄立。"}],"attestations":[{"id":"th-shiji035-039:a001","paragraph_id":"c-shiji-035-guancai:p035","start":25,"end":27,"surface":"共公","person_mention_id":"c-shiji-035-guancai:m035-0025","usage":"retrospective"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"侯、公及諡號等暫作敘事追稱，不把繼位當當時授予諡號；未知曆日與終點不按卒日補造。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji035-092","person_id":"vs4_n7e_1qh_AAAAA","surfaces":["共公","共公襄","曹共公","曹君"],"scope":"same_chapter","chapter_ids":["c-shiji-035-guancai"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-035-guancai:p035","quote":"昭公六年，齊桓公敗蔡，遂至楚召陵。九年，昭公卒，子共公襄立。"},{"paragraph_id":"c-shiji-035-guancai:p036","quote":"共公十六年，初，晉公子重耳其亡過曹，曹君無禮，欲觀其駢脅。釐負羈諫，不聽，私善於重耳。二十一年，晉文公重耳伐曹，虜共公以歸，令軍毋入釐負羈之宗族閭。或說晉文公曰：「昔齊桓公會諸侯，復異姓；今君囚曹君，滅同姓，何以令於諸侯？」晉乃復歸共公。"},{"paragraph_id":"c-shiji-035-guancai:p037","quote":"二十五年，晉文公卒。三十五年，共公卒，子文公壽立。文公二十三年卒，子宣公彊立。宣公十七年卒，弟成公負芻立。"},{"paragraph_id":"c-shiji-035-guancai:p043","quote":"太史公曰：余尋曹共公之不用僖負羈，乃乘軒者三百人，知唯德之不建。及振鐸之夢，豈不欲引曹之祀者哉？如公孫彊不修厥政，叔鐸之祀忽諸。"}],"rationale":"依文王子同母十人、蔡曹君世系、蔡女船中事件、楚公子圍弒其王及城濮／伐曹的具體敘事暫定異稱。郟敖／夾敖按同一事件、釐／僖負羈按本卷論贊暫同指；不同國與同國不同世代的同名者分開。匿名者、校勘及跨篇同指仍待核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji039-111","person_id":"vs4_n7e_1qh_AAAAA","surfaces":["共公","曹伯","曹共公"],"scope":"cross_chapter","chapter_ids":["c-shiji-035-guancai","c-shiji-039-jin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-035-guancai:p035","quote":"昭公六年，齊桓公敗蔡，遂至楚召陵。九年，昭公卒，子共公襄立。"},{"paragraph_id":"c-shiji-039-jin:p055","quote":"過曹，曹共公不禮，欲觀重耳駢脅。曹大夫釐負羈曰：「晉公子賢，又同姓，窮來過我，柰何不禮！」共公不從其謀。負羈乃私遺重耳食，置璧其下。重耳受其食，還其璧。"},{"paragraph_id":"c-shiji-039-jin:p067","quote":"五年春，晉文公欲伐曹，假道於衞，衞人弗許。還自河南度，侵曹，伐衞。正月，取五鹿。二月，晉侯、齊侯盟于斂盂。衞侯請盟晉，晉人不許。衞侯欲與楚，國人不欲，故出其君以説晉。衞侯居襄牛，公子買守衞。楚救衞，不卒。晉侯圍曹。三月丙午，晉師入曹，數之以其不用釐負羈言，而用美女乘軒者三百人也。令軍毋入僖負羈宗家以報德。楚圍宋，宋復告急晉。文公欲救則攻楚，爲楚嘗有德，不欲伐也；欲釋宋，宋又嘗有德於晉：患之。先軫曰：「執曹伯，分曹、衞地以與宋，楚急曹、衞，其勢宜釋宋。」於是文公從之，而楚成王乃引兵歸。"},{"paragraph_id":"c-shiji-039-jin:p074","quote":"丁丑，諸侯圍許。曹伯臣或説晉侯曰：「齊桓公合諸侯而國異姓，今君爲會而滅同姓。曹，叔振鐸之後；晉，唐叔之後。合諸侯而滅兄弟，非禮。」晉侯説，復曹伯。"}],"rationale":"按本篇明示名與稱號、晉世系與具體事件暫定所列提及同指；附各段原文，未按同字短名全域合併；紀年與版本差異待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-035-guancai:p035","text":"昭公六年，齊桓公敗蔡，遂至楚召陵。九年，昭公卒，子共公襄立。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-035-guancai:m035-0000","start":0,"end":2,"surface":"昭公","kind":"person","person_id":"vs4_n7e_1qh_AAAA","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m035-0005","start":5,"end":8,"surface":"齊桓公","kind":"person","person_id":"9w2_c77_53m","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m035-0020","start":20,"end":22,"surface":"昭公","kind":"person","person_id":"vs4_n7e_1qh_AAAA","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m035-0025","start":25,"end":28,"surface":"共公襄","kind":"person","person_id":"vs4_n7e_1qh_AAAAA","status":"contextual_provisional"}],"chapter_id":"c-shiji-035-guancai","book_id":"b-shiji-035","work_id":"w-shiji","source_id":"s-shiji-035-guancai"},{"i