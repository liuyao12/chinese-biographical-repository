"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-052-buzhi-complete:line092:m0201","start":201,"end":204,"surface":"夏侯承","kind":"person","person_id":"cyu_y85_svw","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-sanguozhi-052-buzhi-complete:line092","chapter_id":"c-sanguozhi-052-buzhi-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-052-buzhi-complete:line092","text":"權稱尊號，拜驃騎將軍，領冀州牧。是歳，都督西陵。代陸遜撫二境，頃以冀州在蜀分，解牧職。時權太子登駐武昌，愛人好善，與騭書曰：「夫賢人君子，所以興隆大化，佐理時務者也。受性暗蔽，不達道數，雖實區區欲盡心於明德，歸分於君子，至於遠近士人，先後之宜，猶或緬焉，未之能詳。《傳》曰：『愛之能勿勞乎？忠焉能勿誨乎？』斯其義也，豈非所望於君子哉！」騭於是條於時事業在荊州界者，諸葛瑾、陸遜、朱然、程普、潘浚，斐玄、夏侯承，衞旌，李肅、周條、石干十一人。甄別行狀，因上疏獎勸曰：","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-sanguozhi-052-buzhi-complete:line092:m0000","start":0,"end":1,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line092:m0025","start":25,"end":27,"surface":"陸遜","kind":"person","person_id":"lii_454_vuv","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line092:m0044","start":44,"end":45,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line092:m0047","start":47,"end":48,"surface":"登","kind":"person","person_id":"572_278_cba_C","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line092:m0058","start":58,