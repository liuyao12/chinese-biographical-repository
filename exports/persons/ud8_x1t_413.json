y-wyd:p002:m0165","start":165,"end":167,"surface":"興道","person_id":"gm4_alk_hn7_AB","kind":"person","status":"contextual_provisional","interpretation_note":"據本段稱謂、親屬與互見紀傳。"},{"id":"c-nanqishu-020-liuzhirong-ancestry-wyd:p002:m0170","start":170,"end":172,"surface":"文蔚","person_id":"gm4_alk_hn7_AC","kind":"person","status":"contextual_provisional","interpretation_note":"據本段稱謂、親屬與互見紀傳。"},{"id":"c-nanqishu-020-liuzhirong-ancestry-wyd:p002:m0176","start":176,"end":178,"surface":"義徽","person_id":"gm4_alk_hn7_AD","kind":"person","status":"contextual_provisional","interpretation_note":"據本段稱謂、親屬與互見紀傳。"},{"id":"c-nanqishu-020-liuzhirong-ancestry-wyd:p002:m0182","start":182,"end":184,"surface":"義倫","person_id":"gm4_alk_hn7_AE","kind":"person","status":"contextual_provisional","interpretation_note":"據本段稱謂、親屬與互見紀傳。"}],"source_position":{"revision_id":"cbr-ai-transcription-sha256:6284922e1941e437d1f811b09c49d6fc1c312b155cd552a31aa40634cdfafd5b","source_layer":"received_biography","column_projection":[{"pdf_page":3,"half":"左","leaf":"二上","column_from_right":7,"start":1,"end":21,"text":"后母桓氏夢吞玉勝生后時有紫光滿室以告壽之"},{"pdf_page":3,"half":"左","leaf":"二上","column_from_right":8,"start":0,"end":21,"text":"壽之曰恨非是男桓曰雖女亦足興家矣后每寢臥家"},{"pdf_page":3,"half":"左","leaf":"二上","column_from_right":9,"start":0,"end":21,"text":"人常見上如有雲氣焉年十餘歲歸太祖嚴正有禮法"},{"pdf_page":3,"half":"左","leaf":"二上","column_from_right":10,"start":0,"end":21,"text":"家庭肅然宋泰豫元年殂年五十歸葬宣帝墓側今泰"},{"pdf_page":4,"half":"右","leaf":"二下","column_from_right":1,"start":0,"end":21,"text":"安陵也門生王清與墓工始下鍤有白兔跳起尋之不"},{"pdf_page":4,"half":"右","leaf":"二下","column_from_right":2,"start":0,"end":21,"text":"得及墳成兔還棲其上昇明二年贈竟陵公國夫人三"},{"pdf_page":4,"half":"右","leaf":"二下","column_from_right":3,"start":0,"end":21,"text":"年贈齊國妃印綬如太妃建元元年尊諡昭皇后三年"},{"pdf_page":4,"half":"右","leaf":"二下","column_from_right":4,"start":0,"end":21,"text":"贈后父金紫光祿大夫母桓氏上都鄉君壽之子興道"},{"pdf_page":4,"half":"右","leaf":"二下","column_from_right":5,"start":0,"end":20,"text":"司徒屬文蔚豫章內史義徽光祿大夫義倫通直郎"}]},"chapter_id":"c-nanqishu-020-liuzhirong-ancestry-wyd","book_id":"b-nanqishu-020","work_id":"w-nanqishu","source_id":"s-nanqishu-020-liuzhirong-wyd"},{"id":"c-nanqishu-020-liuzhirong-ancestry:p002","text":"后母桓氏夢吞玉勝生后，時有紫光滿室，以告壽之，壽之曰：「恨非是男。」桓曰：「雖女，亦足興家矣。」后每寢臥，家人常見上如有雲氣焉。年十餘歲，歸太祖，嚴正有禮法，家庭肅然。宋泰豫元年殂，年五十。歸葬宣帝墓側，今泰安陵也。門生王清與墓工始下鍤，有白兔跳起，尋之不得，及墳成，兔還栖其上。昇明二年，贈竟陵公國夫人。三年，贈齊國妃，印綬如太妃。建元元年，尊諡昭皇后。三年，贈后父金紫光祿大夫，母桓氏上〔虞〕都鄉君；壽之子興道司徒屬，文蔚豫章內史，義徽光祿大夫，義倫通直郎。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-nanqishu-020-liuzhirong-ancestry:p002:m0002","start":2,"end":4,"surface":"桓氏","person_id":"tob_4dh_0fe","kind":"person","status":"contextual_provisional","interpretation_note":"據本段稱謂、親屬與互見紀傳。"},{"id":"c-nanqishu-020-liuzhirong-ancestry:p002:m0009","start":9,"end":10,"surface":"后","person_id":"gm4_alk_hn7_AA","kind":"person","status":"contextual_provisional","interpretation_note":"據本段稱謂、親屬與互見紀傳。"},{"id":"c-nanqishu-020-liuzhirong-ancestry:p002:m0020","start":20,"end":22,"surface":"壽之","person_id":"gm4_alk_hn7_A","kind":"person","status":"contextual_provisional","interpretation_note":"據本段稱謂、親屬與互見紀傳。"},{"id":"c-nanqishu-020-liuzhirong-ancestry:p002:m0023","start":23,"end":25,"surface":"壽之","person_id":"gm4_alk_hn7_A","kind":"person","status":"contextual_provisional","interpretation_note":"據本段稱謂、親屬與互見紀傳。"},{"id":"c-nanqishu-020-liuzhirong-ancestry:p002:m0034","start":34,"end":35,"surface":"桓","person_id":"tob_4dh_0fe","kind":"person","status":"contextual_provisional","interpretation_note":"據本段稱謂、親屬與互見紀傳。"},{"id":"c-nanqishu-020-liuzhirong-ancestry:p002:u0053","start":53,"end":55,"surface":"家人","person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"據本段稱謂、親屬與互見紀傳。"},{"id":"c-nanqishu-020-liuzhirong-ancestry:p002:m0070","start":70,"end":72,"surface":"太祖","person_id":"47p_kjh_ez7","kind":"person","status":"contextual_provisional","interpretation_note":"據本段稱謂、親屬與互見紀傳。"},{"id":"c-nanqishu-020-liuzhirong-ancestry:p002:m0097","start":97,"end":99,