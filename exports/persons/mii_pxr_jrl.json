0045","start":45,"end":47,"surface":"破石","kind":"person","person_id":"mii_pxr_jrl","status":"contextual_provisional","paragraph_id":"c-shiji-105-bianque:p035","chapter_id":"c-shiji-105-bianque"},{"id":"c-shiji-105-bianque:m035-0061","start":61,"end":63,"surface":"破石","kind":"person","person_id":"mii_pxr_jrl","status":"contextual_provisional","paragraph_id":"c-shiji-105-bianque:p035","chapter_id":"c-shiji-105-bianque"}],"relations":[],"title_holdings":[{"id":"th-shiji105-012","person_id":"mii_pxr_jrl","title":"中郎","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-105-bianque","source_id":"s-shiji-105-bianque","paragraph_id":"c-shiji-105-bianque:p035","quote":"齊中郎破石病，臣意診其脈，告曰：「肺傷，不治，當後十日丁亥溲血死。」即後十一日，溲血而死。破石之病，得之墮馬僵石上。所以知破石之病者，切其脈，得肺陰氣，其來散，數道至而不一也。色又乘之。所以知其墮馬者，切之得番陰脈。番陰脈入虛里，乘肺脈。肺脈散者，固色變也乘也。所以不中期死者，師言曰：「病者安穀即過期，不安穀則不及期」。其人嗜黍，黍主肺，故過期。所以溲血者，診脈法曰「病養喜陰處者順死，養喜陽處者逆死」。其人喜自靜，不躁，又久安坐，伏几而寐，故血下泄。"}],"attestations":[{"id":"th-shiji105-012:a001","paragraph_id":"c-shiji-105-bianque:p035","start":1,"end":3,"surface":"中郎","person_mention_id":"c-shiji-105-bianque:m035-0003","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"保存原文用稱；唐安除為齊王侍醫記任命事件，其餘不以用稱推定任期起點。不以死亡補終點。王禹與高期依並列語法共繫太醫，陽虛侯相與家丞是官職而非本人封侯。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji105-059","person_id":"mii_pxr_jrl","surfaces":["破石"],"scope":"same_chapter","chapter_ids":["c-shiji-105-bianque"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-105-bianque:p035","quote":"齊中郎破石病，臣意診其脈，告曰：「肺傷，不治，當後十日丁亥溲血死。」即後十一日，溲血而死。破石之病，得之墮馬僵石上。所以知破石之病者，切其脈，得肺陰氣，其來散，數道至而不一也。色又乘之。所以知其墮馬者，切之得番陰脈。番陰脈入虛里，乘肺脈。肺脈散者，固色變也乘也。所以不中期死者，師言曰：「病者安穀即過期，不安穀則不及期」。其人嗜黍，黍主肺，故過期。所以溲血者，診脈法曰「病養喜陰處者順死，養喜陽處者逆死」。其人喜自靜，不躁，又久安坐