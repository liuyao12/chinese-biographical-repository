10,16611,16612,16613,16614,16615,16616,16617,16618,16619,16620,16621,16622,16623,16624,16625,16626,16627,16628,16629,16630,16631,16632,16633,16634,16635,16636,16637,16638,16639,16640,16641,16642,16643,16644,16645,16646,16647,16648,16649,16650,16651,16652,16653,16654,16655,16656,16657,16658,16659,16660,16661,16662,16663,16664,16665,16666,16667,16668,16669,16670,16671,16672,16673,16674,16675],"revision_id":2085142},"mentions":[{"id":"c-sanguozhi-048-sun-hao:p045:m0055","surface":"岑昏","start":55,"end":57,"kind":"person","person_id":"2a7_4oz_qij","status":"contextual_provisional"},{"id":"c-sanguozhi-048-sun-hao:p045:m0087","surface":"昏","start":87,"end":88,"kind":"person","person_id":"2a7_4oz_qij","status":"contextual_provisional"}],"chapter_id":"c-sanguozhi-048-sun-hao","book_id":"b-sanguozhi-048","work_id":"w-sanguozhi","source_id":"s-sanguozhi-048-sun-hao-ws2085142"},{"id":"c-sanguozhi-053-zhanghong:line018-pei04-01","text":"環氏《吳紀》曰：皓嘗問：「詩云『汎彼栢舟』，惟栢中舟乎？」尚對曰：「詩言『檜楫松舟』，則松亦中舟也。」又問：「鳥之大者惟鶴，小者惟雀乎？」尚對曰：「大者有禿鶖，小者有鷦鷯。」皓性忌勝己，而尚談論每出其表，積以致恨。後問：「孤飲酒以方誰？」尚對曰：「陛下有百觚之量。」皓云：「尚知孔丘之不王，而以孤方之！」因此發怒收尚。尚書岑昬率公卿已下百餘人，詣宮叩頭請，尚罪得減死。","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-053-zhanghong:line018-pei04-01:m0008","start":8,"end":9,"surface":"皓","kind":"person","person_id":"05e_9bb_55a","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-zhanghong:line018-pei04-01:m0029","start":29,"end":30,"surface":"尚","kind":"person","person_id":"6bz_2xv_ow3_BA","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-zhanghong:line018-pei04-01:m0069","start":69,"end":70,"surface":"尚","kind":"person","person_id":"6bz_2xv_ow3_BA","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-zhanghong:line018-pei04-01:m0087","start":87,"end":88,"surface":"皓","kind":"person","person_id":"05e_9bb_55a","status":"contextual_provisional","interpretation_note":"依本段姓名與