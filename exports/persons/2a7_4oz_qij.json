:"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-048-sun-hao:p040:m0121","surface":"岑昬","start":121,"end":123,"kind":"person","person_id":"2a7_4oz_qij","status":"contextual_provisional","paragraph_id":"c-sanguozhi-048-sun-hao:p040","chapter_id":"c-sanguozhi-048-sun-hao"},{"id":"c-sanguozhi-048-sun-hao:p044:m0017","surface":"岑昏","start":17,"end":19,"kind":"person","person_id":"2a7_4oz_qij","status":"contextual_provisional","paragraph_id":"c-sanguozhi-048-sun-hao:p044","chapter_id":"c-sanguozhi-048-sun-hao"},{"id":"c-sanguozhi-048-sun-hao:p045:m0055","surface":"岑昏","start":55,"end":57,"kind":"person","person_id":"2a7_4oz_qij","status":"contextual_provisional","paragraph_id":"c-sanguozhi-048-sun-hao:p045","chapter_id":"c-sanguozhi-048-sun-hao"},{"id":"c-sanguozhi-048-sun-hao:p045:m0087","surface":"昏","start":87,"end":88,"kind":"person","person_id":"2a7_4oz_qij","status":"contextual_provisional","paragraph_id":"c-sanguozhi-048-sun-hao:p045","chapter_id":"c-sanguozhi-048-sun-hao"},{"id":"c-sanguozhi-053-zhanghong:line018-pei04-01:m0161","start":161,"end":163,"surface":"岑昬","kind":"person","person_id":"2a7_4oz_qij","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-053-zhanghong:line018-pei04-01","chapter_id":"c-sanguozhi-053-zhanghong"}],"relations":[],"title_holdings":[{"id":"t-wu053-t-wu053-zhanghong19","person_id":"2a7_4oz_qij","kind":"office","title":"尚書","mode":"attestation","status":"source_attested","effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本句所載職官，任免時間未詳。","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-053","chapter_id":"c-sanguozhi-053-zhanghong","source_id":"s-sanguozhi-053-zhanghong","paragraph_id":"c-sanguozhi-053-zhanghong:line018-pei04-01","quote":"環氏《吳紀》曰：皓嘗問：「詩云『汎彼栢舟』，惟栢中舟乎？」尚對曰：「詩言『檜楫松舟』，則松亦中舟也。」又問：「鳥之大者惟鶴，小者惟雀乎？」尚對曰：「大者有禿鶖，小者有鷦鷯。」皓性忌勝己，而尚談論每出其表，積以致恨。後問：「孤飲酒以方誰？」尚對曰：「陛下有百觚之量。」皓云：「尚知孔丘之不王，而以孤方之！」因此發怒收尚。尚書岑昬率公卿已下百餘人，詣宮叩頭請，尚罪得減死。","person_mention_id":"c-sanguozhi-053-zhanghong:line018-pei04-01:m0161"}],"attestations":[{"id":"t-wu053-t-wu053-zhanghong19:a","paragraph_id":"c-sanguozhi-053-zhanghong:line018-pei04-01","person_mention_id":"c-sanguozhi-053-zhanghong:line018-pei04-01:m0161","start":159,"end":161,"surface":"尚書","usage":"narrative","date_expression":null}],"human_reviewed":false,"reviewer":"Codex（AI 代理）","model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-048-sun-hao:p040","text":"初，皓每宴會羣臣，無不咸令沈醉。置黃門郎十人，特不與酒，侍立終日，爲司過之吏。宴罷之後，各奏其闕失，迕視之咎，謬言之愆，罔有不舉。大者即加威刑，小者輒以爲罪。後宮數千，而採擇無已。又激水入宮，宮人有不合意者，輒殺流之。或剥人之面，或鑿人之眼。岑昬險諛貴幸，致位九列，好興功役，衆所患苦。是以上下離心，莫爲皓盡力，蓋積惡已極，不復堪命故也。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":92,"last_line":92,"raw_start":14559,"raw_end":15076,"raw_character_offsets":[14566,14567,14568,14569,14570,14571,14572,14573,14574,14575,14576,14577,14578,14579,14580,14581,14582,14583,14584,14585,14586,14587,14588,14589,14590,14591,14592,14593,14594,14595,14596,14597,14598,14599,14600,14601,14602,14603,14604,14605,14606,14607,14608,14609,14610,14611,14612,14613,14614,14615,14616,14617,14618,14619,14620,14621,14622,14623,14624,14625,14626,14627,14628,14629,14630,14631,14632,14633,14634,14635,14636,14637,14638,14639,14640,14641,14642,14643,14644,14645,14646,14647,14648,14649,14650,14651,14652,14653,14654,14655,14656,14657,14658,14659,14660,14661,14662,14663,14664,14665,14666,14667,14668,14669,