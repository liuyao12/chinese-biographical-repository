{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"nkl_jcm_gr2","canonical_person_id":"nkl_jcm_gr2","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["nkl_jcm_gr2"],"persons":[{"id":"nkl_jcm_gr2","label":"鹿樹生（北魏移書人）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"鹿樹生","mention_ids":["c-nanqishu-057-northern-wei-complete:p027:m0070"]}],"evidence":[{"mention_id":"c-nanqishu-057-northern-wei-complete:p027:m0070","paragraph_id":"c-nanqishu-057-northern-wei-complete:p027","chapter_id":"c-nanqishu-057-northern-wei-complete","quote":"鹿樹生"}],"review":"ai_provisional","identity_note":"鹿樹生（北魏移書人），見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-nanqishu-057-northern-wei-complete-ws1999801","work_id":"w-nanqishu","book_id":"b-nanqishu-057","chapter_id":"c-nanqishu-057-northern-wei-complete","raw_mention_count":1,"mention_ids":["c-nanqishu-057-northern-wei-complete:p027:m0070"],"paragraph_ids":["c-nanqishu-057-northern-wei-complete:p027"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-nanqishu-057-northern-wei-complete:p027:m0070","mention_ids":["c-nanqishu-057-northern-wei-complete:p027:m0070"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-nanqishu-057-northern-wei-complete-ws1999801"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-nanqishu-057-northern-wei-complete:source_review27-0","kind":"source_review","person_id":"nkl_jcm_gr2","source_quote":"會世祖崩，宏聞關中危急，乃稱聞喪退師。太和十七年八月，使持節、安南大將軍、都督徐青齊三州諸軍事、南中郎將、徐州刺史、廣陵侯府長史、帶淮陽太守鹿樹生移齊兖州府長史府：「奉被行所尚書符騰詔：『皇師雷舉，搖旆南指，誓清江祲，志廓衡靄。以去月下旬，濟次河洛。會前使人邢巒等至，審知彼有大艾。以春秋之義，聞喪寢伐。爰勑有司，輟鑾止軔，休馬華陽，戢戈嵩北。便肇經周制，光宅中區，永皇基于無窮，恢盛業乎萬祀。（辰）〔宸〕居重正，鴻化增新，四海承休，莫不銘慶。』故以往示如律令。」并遣使弔國諱。遣偽大將楊大眼、張聰明等數萬人攻酉，酉、廣等竝見殺。","reading":"世祖崩、魏名稱退兵。鹿樹生移文的長官銜、敕語及送達對象同檢，太和十七年為文寫年。","note":"世祖崩、魏名稱退兵。鹿樹生移文的長官銜、敕語及送達對象同檢，太和十七年為文寫年。","paragraph_id":"c-nanqishu-057-northern-wei-complete:p027","start_codepoint":0,"end_codepoint":265,"human_reviewed":false,"chapter_id":"c-nanqishu-057-northern-wei-complete","source_id":"s-nanqishu-057-northern-wei-complete-ws1999801"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-057-northern-wei-complete:p027:m0070","start":70,"end":73,"surface":"鹿樹生","kind":"person","person_id":"nkl_jcm_gr2","status":"contextual_provisional","paragraph_id":"c-nanqishu-057-northern-wei-complete:p027","chapter_id":"c-nanqishu-057-northern-wei-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-057-northern-wei-complete:p027","text":"會世祖崩，宏聞關中危急，乃稱聞喪退師。太和十七年八月，使持節、安南大將軍、都督徐青齊三州諸軍事、南中郎將、徐州刺史、廣陵侯府長史、帶淮陽太守鹿樹生移齊兖州府長史府：「奉被行所尚書符騰詔：『皇師雷舉，搖旆南指，誓清江祲，志廓衡靄。以去月下旬，濟次河洛。會前使人邢巒等至，審知彼有大艾。以春秋之義，聞喪寢伐。爰勑有司，輟鑾止軔，休馬華陽，戢戈嵩北。便肇經周制，光宅中區，永皇基于無窮，恢盛業乎萬祀。（辰）〔宸〕居重正，鴻化增新，四海承休，莫不銘慶。』故以往示如律令。」并遣使弔國諱。遣偽大將楊大眼、張聰明等數萬人攻酉，酉、廣等竝見殺。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":62,"last_line":62,"raw_start":6942,"raw_end":7364,"raw_character_offsets":[6942,6943