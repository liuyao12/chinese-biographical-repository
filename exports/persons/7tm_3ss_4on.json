rface":"項羽","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m042-0071","start":71,"end":73,"surface":"彭越","kind":"person","person_id":"9qt_orl_5f2","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m042-0075","start":75,"end":77,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m042-0093","start":93,"end":95,"surface":"周苛","kind":"person","person_id":"7tm_3ss_4on","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m042-0096","start":96,"end":98,"surface":"樅公","kind":"person","person_id":"hy4_7ra_i67","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m042-0101","start":101,"end":104,"surface":"韓王信","kind":"person","person_id":"hm1_rqr_l9u","status":"contextual_provisional"}],"chapter_id":"c-shiji-008-gaozu","book_id":"b-shiji-008","work_id":"w-shiji","source_id":"s-shiji-008-gaozu"},{"id":"c-shiji-011-jingdi:p009","text":"中元年，封故御史大夫周苛孫平為繩侯，故御史大夫周昌（子）［孫］左車為安陽侯，四月乙巳，赦天下，賜爵一級。除禁錮。地動。衡山、原都雨雹，大者尺八寸。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-011-jingdi:m009-0010","start":10,"end":12,"surface":"周苛","kind":"person","person_id":"7tm_3ss_4on","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m009-0012","start":12,"end":14,"surface":"孫平","kind":"person","person_id":"7tm_3ss_4on_*A","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m009-0023","start":23,"end":25,"surface":"周昌","kind":"person","person_id":"gfr_55l_72s","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m009-0031","start":31,"end":33,"surface":"左車","kind":"person","person_id":"89q_9ev_4g6","status":"contextual_provisional"}],"chapter_id":"c-shiji-011-jingdi","book_id":"b-shiji-011","work_id":"w-shiji","source_id":"s-shiji-011-jingdi"},{"id":"c-shiji-096-zhang:p003","text":"周昌者，沛人也。其從兄曰周苛，秦時皆為泗水卒史。及高祖起沛，擊破泗水守監，於是周昌、周苛自卒史從沛公，沛公以周昌為職志，周苛為客。從入關，破秦。沛公立為漢王，以周苛為御史大夫，周昌為中尉。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhang:m003-0000","start":0,"end":2,"surface":"周昌","kind":"person","person_id":"u7w_vak_29r","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m003-0012","start":12,"end":14,"surface":"周苛","kind":"person","person_id":"anb_2wd_5ci","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m003-0025","start":25,"end":27,"surface":"高祖","kind":"person","person_id":"h8q_zyo_i2l","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m003-0039","start":39,"end":41,"surface":"周昌","kind":"person","person_id":"u7w_vak_29r","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m003-0042","start":42,"end":44,"surface":"周苛","kind":"person","person_id":"anb_2wd_5ci","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m003-0048","start":48,"end":50,"surface":"沛公","kind":"person","person_id":"h8q_zyo_i2l","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m003-0051","start":51,"end":53,"surface":"沛公","kind":"person","person_id":"h8q_zyo_i2l","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m003-0054","start":54,"end":56,"surface":"周昌","kind":"person","person_id":"u7w_vak_29r","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m003-0060","start":60,"end":62,"surface":"周苛","kind":"person","person_id":"anb_2wd_5ci","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m003-0072","start":72,"end":74,"surface":"沛公","kind":"person","person_id":"h8q_zyo_i2l","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m003-0076","start":76,"end":78,"surface":"漢王","kind":"person","person_id":"h8q_zyo_i2l","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m003-0080","start":80,"end":82,"surface":"周苛","kind":"person","person_id":"anb_2wd_5ci","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m003-0088","start":88,"end":90,"surface":"周昌","kind":"person","person_id":"u7w_vak_29r","status":"contextual_provisional"}],"chapter_id":"c-shiji-096-zhang","book_id":"b-shiji-096","work_id":"w-shiji","source_id":"s-shiji-096-zhang"},{"id":"c-shiji-096-zhang:p004","text":"漢王四年，楚圍漢王滎陽急，漢王遁出去，而使周苛守滎陽城。楚破滎陽城，欲令周苛將。苛罵曰：「若趣降漢王！不然，今為虜矣！」項羽怒，亨周苛。於是乃拜周昌為御史大夫。常從擊破項籍。以六年中與蕭、曹等俱封：封周昌為汾陰侯；周苛子周成以父死事，封為高景侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhang:m004-0000","start":0,"end":2,"surface":"漢王","kind":"person","person_id":"h8q_zyo_i2l","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m004-0007","start":7,"end":9,"surface":"漢王","kind":"person","person_id":"h8q_zyo_i2l","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m004-0013","start":13,"end":15,"surface":"漢王","kind":"person","person_id":"h8q_zyo_i2l","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m004-0021","start":21,"end":23,"surface":"周苛","kind":"person","person_id":"anb_2wd_5ci","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m004-0036","start":36,"end":38,"surface":"周苛","kind":"person","person_id":"anb_2wd_5ci","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m004-0040","start":40,"end":41,"surface":"苛","kind":"person","person_id":"anb_2wd_5ci","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m004-0048","start":48,"end":50,"surface":"漢王","kind":"person","person_id":"h8q_zyo_i2l","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m004-0060","start":60,"end":62,"surface":"項羽","kind":"person","person_id":"jej_8s3_01z","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m004-0065","start":65,"end":67,"surface":"周苛","kind":"person","person_id":"anb_2wd_5ci","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m004-0072","start":72,"end":74,"surface":"周昌","kind":"person","person_id":"u7w_vak_29r","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m004-0084","start":84,"end":86,"surface":"項籍","kind":"person","person_id":"jej_8s3_01z","status":"contextual_provisional