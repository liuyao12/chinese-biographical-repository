nd":"person","person_id":"42a_nv5_urq","status":"source_identified"},{"id":"c-shiji-003-yin:m031-0170","start":170,"end":172,"surface":"箕子","kind":"person","person_id":"8a9_tj8_6i7","status":"source_identified"},{"id":"c-shiji-003-yin:m031-0176","start":176,"end":178,"surface":"比干","kind":"person","person_id":"xtq_oi8_w82","status":"source_identified"},{"id":"c-shiji-003-yin:m031-0182","start":182,"end":184,"surface":"商容","kind":"person","person_id":"xhs_wj2_zbt","status":"source_identified"},{"id":"c-shiji-003-yin:m031-0188","start":188,"end":189,"surface":"紂","kind":"person","person_id":"lwx_9yq_ad7","status":"source_identified"},{"id":"c-shiji-003-yin:m031-0190","start":190,"end":194,"surface":"武庚祿父","kind":"person","person_id":"lwx_9yq_ad7_A","status":"source_identified"},{"id":"c-shiji-003-yin:m031-0203","start":203,"end":205,"surface":"盤庚","kind":"person","person_id":"5k7_otk_r9v","status":"source_identified"},{"id":"c-shiji-003-yin:m031-0215","start":215,"end":218,"surface":"周武王","kind":"person","person_id":"y4i_pjk_4gn_AA","status":"source_identified"},{"id":"c-shiji-003-yin:m031-0235","start":235,"end":237,"surface":"殷後","kind":"unresolved","person_id":null,"status":"unresolved","note":"氏族、群體、官稱或未定個人指代；不由熟知故事補出姓名。"}],"chapter_id":"c-shiji-003-yin","book_id":"b-shiji-003","work_id":"w-shiji","source_id":"s-shiji-003-yin"},{"id":"c-shiji-031-wu:p034","text":"九年，爲騶伐魯，至與魯盟乃去。十年，因伐齊而歸。十一年，復北伐齊，越王句踐率其衆以朝吳，厚獻遺之，吳王喜。唯子胥懼，曰：「是棄吳也。」諫曰：「越在腹心，今得志於齊，猶石田，無所用。且盤庚之誥有顛越勿遺，商之以興。」吳王不聽，使子胥於齊，子胥屬其子於齊鮑氏，還報吳王。吳王聞之，大怒，賜子胥屬鏤之劍以死。將死，曰：「樹吾墓上以梓，令可爲器。抉吾眼置之吳東門，以觀越之滅吳也。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-031-wu:m034-0033","start":33,"end":37,"surface":"越王句踐","kind":"person","person_id":"i7a_22p_qda","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m034-0049","start":49,"end":51,"surface":"吳王","kind":"person","person_id":"5dm_e40_rqh_AAAAAAAAAAAAAAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-03