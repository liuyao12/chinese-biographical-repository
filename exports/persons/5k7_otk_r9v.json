tus":"source_identified"},{"id":"c-shiji-003-yin:m020-0016","start":16,"end":19,"surface":"帝小辛","kind":"person","person_id":"drr_o13_0jb","status":"source_identified"},{"id":"c-shiji-003-yin:m020-0028","start":28,"end":30,"surface":"盤庚","kind":"person","person_id":"5k7_otk_r9v","status":"source_identified"},{"id":"c-shiji-003-yin:m020-0038","start":38,"end":41,"surface":"帝小辛","kind":"person","person_id":"drr_o13_0jb","status":"source_identified"},{"id":"c-shiji-003-yin:m020-0044","start":44,"end":46,"surface":"小乙","kind":"person","person_id":"blo_hqh_iqg","status":"source_identified"},{"id":"c-shiji-003-yin:m020-0050","start":50,"end":53,"surface":"帝小乙","kind":"person","person_id":"blo_hqh_iqg","status":"source_identified"}],"chapter_id":"c-shiji-003-yin","book_id":"b-shiji-003","work_id":"w-shiji","source_id":"s-shiji-003-yin"},{"id":"c-shiji-003-yin:p031","text":"紂愈淫亂不止。微子數諫不聽，乃與大師、少師謀，遂去。比干曰：「為人臣者，不得不以死爭。」迺強諫紂。紂怒曰：「吾聞聖人心有七竅。」剖比干，觀其心。箕子懼，乃詳狂為奴，紂又囚之。殷之大師、少師乃持其祭樂器奔周。周武王於是遂率諸侯伐紂。紂亦發兵距之牧野。甲子日，紂兵敗。紂走，入登鹿臺，衣其寶玉衣，赴火而死。周武王遂斬紂頭，縣之大白旗。殺妲己。釋箕子之囚，封比干之墓，表商容之閭。封紂子武庚祿父，以續殷祀，令修行盤庚之政。殷民大說。於是周武王為天子。其後世貶帝號，號為王。而封殷後為諸侯，屬周。","mentions":[{"id":"c-shiji-003-yin:m031-0000","start":0,"end":1,"surface":"紂","kind":"person","person_id":"lwx_9yq_ad7","status":"source_identified"},{"id":"c-shiji-003-yin:m031-0007","start":7,"end":9,"surface":"微子","kind":"person","person_id":"buv_igi_gpn_A","status":"source_identified"},{"id":"c-shiji-003-yin:m031-0016","start":16,"end":18,"surface":"大師","kind":"unresolved","person_id":null,"status":"unresolved","note":"氏族、群體、官稱或未定個人指代；不由熟知故事補出姓名。"},{"id":"c-shiji-003-yin:m031-0019","start":19,"end":21,"surface":"少師","kind":"unresolved","person_id":null,"status":"unresolved","note":"氏族、群體、官稱或未定個人指代；不由熟知故事補出姓名。"},{"id":"c-shiji-003-yin:m031-0026","start":26,"end":28,"surface":"比干","kind":"person","person_id":"xtq_oi8_w82","status":"source_identified"},{"id":"c-shiji-003-yin:m031-0047","start":47,"end":48,"surface":"紂","kind":"person","person_id":"lwx_9yq_ad7","s