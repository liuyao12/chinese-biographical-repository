哉！何足數哉！","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-122-kuli:m043-0000","start":0,"end":3,"surface":"太史公","kind":"person","person_id":"42d_lp1_gxc","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m043-0006","start":6,"end":8,"surface":"郅都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m043-0009","start":9,"end":11,"surface":"杜周","kind":"person","person_id":"dxx_6m8_7o6","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m043-0011","start":11,"end":13,"surface":"十人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m043-0024","start":24,"end":26,"surface":"郅都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m043-0039","start":39,"end":41,"surface":"張湯","kind":"person","person_id":"1ex_se1_yef_A","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m043-0065","start":65,"end":67,"surface":"趙禹","kind":"person","person_id":"vkr_lkp_dme","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m043-0073","start":73,"end":75,"surface":"杜周","kind":"person","person_id":"dxx_6m8_7o6","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m043-0085","start":85,"end":87,"surface":"張湯","kind":"person","person_id":"1ex_se1_yef_A","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m043-0104","start":104,"end":106,"surface":"九卿","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m043-0128","start":128,"end":130,"surface":"十人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m043-0186","start":186,"end":188,"surface":"馮當","kind":"person","person_id":"5p9_b8m_8bf","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m043-0193","start":193,"end":195,"surface":"李貞","kind":"person","person_id":"3yu_1d6_ex4","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m043-0201","start":20