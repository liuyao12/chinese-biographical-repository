061-zhou-family:p021:m0178","start":178,"end":180,"surface":"劉准","kind":"person","person_id":"8ed_06d_3eb","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p021:m0187","start":187,"end":189,"surface":"周玘","kind":"person","person_id":"i1w_a4z_a3g","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p021:m0191","start":191,"end":193,"surface":"陳敏","kind":"person","person_id":"kok_m7n_tux","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p021:m0195","start":195,"end":196,"surface":"之","kind":"person","person_id":"kok_m7n_tux","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"}],"chapter_id":"c-jinshu-061-zhou-family","book_id":"b-jinshu-061","work_id":"w-jinshu","source_id":"s-jinshu-061-ws7903772"},{"id":"c-jinshu-076-yutan:line097","text":"虞潭，字思奧，會稽餘姚人，吳騎都尉翻之孫也。父忠，仕至宜都太守。吳之亡也，堅壁不降，遂死之。潭清貞有檢操，州辟從事、主簿，舉秀才，大司馬、齊王冏請為祭酒，除祁鄉令，徙醴陵令。值張昌作亂，郡縣多從之，潭獨起兵斬昌別率鄧穆等。襄陽太守華恢上潭領建平太守，以疾固辭。遂周旋征討，以軍功賜爵都亭侯。陳敏反，潭東下討敏弟贊于江州。廣州刺史王矩上潭領廬陵太守。綏撫荒餘，咸得其所。又與諸軍共平陳恢，仍轉南康太守，進爵東鄉侯。尋被元帝檄，使討江州刺史華軼。潭至廬陵，會軼已平，而湘川賊杜弢猶盛。江州刺史衛展上潭並領安成太守。時甘卓屯宜陽，為杜弢所逼。潭進軍救卓，卓上潭領長沙太守，固辭不就。王敦版潭為湘東太守，復以疾辭。弢平後，元帝召補丞相軍諮祭酒，轉琅邪國中尉。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-076-yutan:line097:m0000","start":0,"end":2,"surface":"虞潭","kind":"person","person_id":"9v9_cj5_dor","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-076-yutan:line097:m0004","start":4,"end":6,"surface":"思奧","kind":"person","person_id":"9v9_cj5_dor","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-076-yutan:line097:m0017","start":17,"end":18,"surface":"翻","kind":"person","person_id":"izi_e36_p1g","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-076-yutan:line097:m0023","start":23,"end":24,"surface":"忠","kind":"person","person_id"