,"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-w076r-yt-zan","subject_person_id":"2l4_w65_rrf","object_person_id":"kok_m7n_tux","predicate":"brother","qualifiers":{"source_term":"敏弟贊"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-076","chapter_id":"c-jinshu-076-yutan","source_id":"s-jinshu-076-yutan","paragraph_id":"c-jinshu-076-yutan:line097","quote":"虞潭，字思奧，會稽餘姚人，吳騎都尉翻之孫也。父忠，仕至宜都太守。吳之亡也，堅壁不降，遂死之。潭清貞有檢操，州辟從事、主簿，舉秀才，大司馬、齊王冏請為祭酒，除祁鄉令，徙醴陵令。值張昌作亂，郡縣多從之，潭獨起兵斬昌別率鄧穆等。襄陽太守華恢上潭領建平太守，以疾固辭。遂周旋征討，以軍功賜爵都亭侯。陳敏反，潭東下討敏弟贊于江州。廣州刺史王矩上潭領廬陵太守。綏撫荒餘，咸得其所。又與諸軍共平陳恢，仍轉南康太守，進爵東鄉侯。尋被元帝檄，使討江州刺史華軼。潭至廬陵，會軼已平，而湘川賊杜弢猶盛。江州刺史衛展上潭並領安成太守。時甘卓屯宜陽，為杜弢所逼。潭進軍救卓，卓上潭領長沙太守，固辭不就。王敦版潭為湘東太守，復以疾辭。弢平後，元帝召補丞相軍諮祭酒，轉琅邪國中尉。","subject_person_mention_id":"c-jinshu-076-yutan:line097:m0155","object_person_mention_id":"c-jinshu-076-yutan:line097:m0145"}],"interpretation_note":"此條按本句所明言。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-061-zhou-family:p021:m0191","start":191,"end":193,"surface":"陳敏","kind":"person","person_id":"kok_m7n_tux","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。","paragraph_id":"c-jinshu-061-zhou-family:p021","chapter_id":"c-jinshu-061-zhou-family"},{"id":"c-jinshu-061-zhou-family:p021:m0195","start":195,"end":196,"surface":"之","kind":"person","person_id":"kok_m7n_tux","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。","paragraph_id":"c-jinshu-061-zhou-family:p021","chapter_id":"c-jinshu-061-zhou-family"},{"id":"c-jinshu-076-yutan:line097:m0145","start":145,"end":147,"surface":"陳敏","kind":"person","person_id":"kok_m7n_tux","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-076-yutan:line097","chapter_id":"c-jinshu-076-yutan"},{"id":"c-jinshu-076-yutan:line097:m0153","start":153,"end":154,"surface":"敏","kind":"person","person_id":"kok_m7n_tux","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-076-yutan:line097","chapter_id":"c-jinshu-076-yutan"},{"id":"c-sanguozhi-065-heshao-complete:p009:m0263","surface":"陈敏","start":263,"end":265,"kind":"person","person_id":"kok_m7n_tux","status":"contextual_provisional","paragraph_id":"c-sanguozhi-065-heshao-complete:p009","chapter_id":"c-sanguozhi-065-heshao-complete"},{"id":"c-sanguozhi-065-heshao-complete:p009:m0282","surface":"敏","start":282,"end":283,"kind":"person","person_id":"kok_m7n_tux","status":"contextual_provisional","paragraph_id":"c-sanguozhi-065-heshao-complete:p009","chapter_id":"c-sanguozhi-065-heshao-complete"},{"id":"c-sanguozhi-065-heshao-complete:p009:m0296","surface":"敏","start":296,"end":297,"kind":"person","person_id":"kok_m7n_tux","status":"contextual_provisional","paragraph_id":"c-sanguozhi-065-heshao-complete:p009","chapter_id":"c-sanguozhi-065-heshao-complete"}],"relations":[{"id":"a-w076r-yt-zan","subject_person_id":"2l4_w65_rrf","object_person_id":"kok_m7n_tux","predicate":"brother","qualifiers":{"source_term":"敏弟贊"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-076","chapter_id":"c-jinshu-076-yutan","source_id":"s-jinshu-076-yutan","paragraph_id":"c-jinshu-076-yutan:line097","quote":"虞潭，字思奧，會稽餘姚人，吳騎都尉翻之孫也。父忠，仕至宜都太守。吳之亡也，堅壁不降，遂死之。潭清貞有檢操，州辟從事、主簿，舉秀才，大司馬、齊王冏請為祭酒，除祁鄉令，徙醴陵令。值張昌作亂，郡縣多從之，潭獨起兵斬昌別率鄧穆等。襄陽太守華恢上潭領建平太守，以疾固辭。遂周旋征討，以軍功賜爵都亭侯。陳敏反，潭東下討敏弟贊于江州。廣州刺史王矩上潭領廬陵太守。綏撫荒餘，咸得其所。又與諸軍共平陳恢，仍轉南康太守，進爵東鄉侯。尋被元帝檄，使討江州刺史華軼。潭至廬陵，會軼已平，而湘川賊杜弢猶盛。江州刺史衛展上潭並領安成太守。時甘卓屯宜陽，為杜弢所逼。潭進軍救卓，卓上潭領長沙太守，固辭不就。王敦版潭為湘東太守，復以疾辭。弢平後，元帝召補丞相軍諮祭酒，轉琅邪國中尉。","subject_person_mention_id":"c-jinshu-076-yutan:line097:m0155","object_person_mention_id":"c-jinshu-076-yutan:line097:m0145"}],"interpretation_note":"此條按本句所明言。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-061-zhou-family:p021","text":"惠帝幸鄴，成都王穎以馥守河南尹。陳眕、上官已等奉清河王覃為太子，加馥衛將軍、錄尚書，馥辭不受。覃令馥與上官已合軍，馥認已小人縱暴，終為國賊，乃共司隸滿奮等謀共除之，謀泄，為已所襲，奮被害，馥走得免。及已為張方所敗，召馥還攝河南尹。暨東海王越迎大駕，以馥為中領軍，未就，遷司隸校尉，加散騎常侍、假節，都督諸軍事于澠池。帝還宮，出為平東將軍、都督揚州諸軍事，代劉准為鎮東將軍，與周玘等討陳敏，滅之，以功封永甯伯。","source_position":{"raw_start":3436,"raw_end":3642,"raw_text":"　　惠帝幸鄴，成都王穎以馥守河南尹。陳眕、上官已等奉清河王覃為太子，加馥衛將軍、錄尚書，馥辭不受。覃令馥與上官已合軍，馥認已小人縱暴，終為國賊，乃共司隸滿奮等謀共除之，謀泄，為已所襲，奮被害，馥走得免。及已為張方所敗，召馥還攝河南尹。暨東海王越迎大駕，以馥為中領軍，未就，遷司隸校尉，加散騎常侍、假節，都督諸軍事于澠池。帝還宮，出為平東將軍、都督揚州諸軍事，代劉准為鎮東將軍，與周玘等討陳敏，滅之，以功封永甯伯。","display_wrapper_start":0,"display_wrapper_end":0,"raw_path":"sources/jinshu/wikisource-7903772-raw.wikitext"},"mentions":[{"id":"c-jinshu-061-zhou-family:p021:m0000","start":0,"end":2,"surface":"惠帝","kind":"person","person_id":"7e0_f69_1ac","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p021:m0005","start":5,"end":9,"surface":"成都王穎","kind":"person","person_id":"e81_f09_000","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p021:m0010","start":10,"end":11,"surface":"馥","kind":"person","person_id":"3xx_gdy_or6_BA","status":"contextual_provisional","interpretation_note":"076王廙元帝鎮江左、討周馥脈絡與本段相合；不是只從單字馥匹配韓馥。"},{"id":"c-jinshu-061-zhou-family:p021:m0016","start":16,"end":18,"surface":"陳眕","kind":"person","person_id":"p1n_kla_0x7","status":"contextual_provisional","interpretation_note":"兩固定數位見證同一清河王太子事件，姓氏相異，原字不改；暫不裁定名姓。"},{"id":"c-jinshu-061-zhou-family:p021:m0019","start":19,"end":22,"surface":"上官已","kind":"person","person_id":"j42_q6m_ymn","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p021:m0024","start":24,"end":28,"surface":"清河王覃","kind":"person