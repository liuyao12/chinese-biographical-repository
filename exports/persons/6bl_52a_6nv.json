ntence","paragraph_id":"c-sanguozhi-052-zhangcheng-complete:line032-pei01-02","person_id":"6bl_52a_6nv","related_person_ids":["572_278_cba_C"],"start_codepoint":0,"end_codepoint":10,"source_quote":"谢景事在〈孙登传〉。","reading":"裴注轉指卷五十九孫登傳，有謝景字叔發、南陽宛人及卒官。","chapter_id":"c-sanguozhi-052-zhangcheng-complete","source_id":"s-sanguozhi-052-zhangcheng-complete"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-052-gutan-complete:line052-pei01-01:m0072","start":72,"end":74,"surface":"谢景","kind":"person","person_id":"6bl_52a_6nv","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-sanguozhi-052-gutan-complete:line052-pei01-01","chapter_id":"c-sanguozhi-052-gutan-complete"},{"id":"c-sanguozhi-052-zhangcheng-complete:line032:m0106","start":106,"end":108,"surface":"謝景","kind":"person","person_id":"6bl_52a_6nv","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-sanguozhi-052-zhangcheng-complete:line032","chapter_id":"c-sanguozhi-052-zhangcheng-complete"},{"id":"c-sanguozhi-052-zhangcheng-complete:line032:m0125","start":125,"end":126,"surface":"景","kind":"person","person_id":"6bl_52a_6nv","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-sanguozhi-052-zhangcheng-complete:line032","chapter_id":"c-sanguozhi-052-zhangcheng-complete"},{"id":"c-sanguozhi-052-zhangcheng-complete:line032-pei01-02:m0000","start":0,"end":2,"surface":"谢景","kind":"person","person_id":"6bl_52a_6nv","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-sanguozhi-052-zhangcheng-complete:line032-pei01-02","chapter_id":"c-sanguozhi-052-zhangcheng-complete"},{"id":"c-sanguozhi-058-luxun:line035:m0135","start":135,"end":136,"surface":"景","kind":"person","person_id":"6bl_52a_6nv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-058-luxun:line035","chapter_id":"c-sanguozhi-058-luxun"},{"id":"c-sanguozhi-058-luxun:line035:m0148","start":148,"end":149,"surface":"景","kind":"person","person_id":"6bl_52a_6nv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-058-luxun:line035","chapter_id":"c-sanguozhi-058-luxun"}],"relations":[],"title_holdings":[{"id":"th-wu052-zc-8","person_id":"6bl_52a_6nv","title":"豫章太守","kind":"office","mode":"attestation","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-052","chapter_id":"c-sanguozhi-052-zhangcheng-complete","source_id":"s-sanguozhi-052-zhangcheng-complete","paragraph_id":"c-sanguozhi-052-zhangcheng-complete:line032","quote":"承字仲嗣，少以才學知名，與諸葛瑾、歩騭、嚴畯相友善。權爲驃騎將軍，辟西曹掾，出爲長沙西部都尉。討平山寇，得精兵萬五千人。後爲濡須都督、奮威將軍，封都鄕侯，領部曲五千人。承爲人壯毅忠讜，能甄識人物，拔彭城蔡款、南陽謝景於孤微童幼，後並爲國士，款至衞尉，景豫章太守。又諸葛恪年少時，眾人奇其英才。承言終敗諸葛氏者，元遜也。勤於長進，篤於物類，凡在庶幾之流，無不造門，年六十七，赤烏七年卒，謚曰定侯。子震嗣。初，承喪妻，昭欲爲索諸葛瑾女，承以相與有好，難之，權聞而勸焉，遂爲婿。生女，權爲子和納之。權數令和修敬於承，執子婿之禮。震諸葛恪誅時亦死。","person_mention_id":"c-sanguozhi-052-zhangcheng-complete:line032:m0106"}],"attestations":[{"id":"th-wu052-zc-8:a","paragraph_id":"c-sanguozhi-052-zhangcheng-complete:line032","start":126,"end":130,"surface":"豫章太守","person_mention_id":"c-sanguozhi-052-zhangcheng-complete:line032:m0106","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-052-gutan-complete:line052-pei01-01","text":"陆机为谭传曰：宣太子正位东宫，天子方隆训导之义，妙简俊彦，讲学左右。时四方之杰毕集，太傅诸葛恪等雄奇盖众，而谭以清识绝伦，独见推重。自太尉范慎、谢景、羊徽之徒，皆以秀称其名，而悉在谭下。","text_layer":"witness_appended_pei_songzhi_note","annotation_status":"reviewed","mentions":[{"id":"c-sanguozhi-052-gutan-complete:line052-pei01-01:m0000","start":0,"end":2,"surface":"陆机","kind":"person","person_id":"69h_uhy_hta","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-gutan-complete:line052-pei01-01:m0003","start":3,"end":4,"surface":"谭","kind":"person","person_id":"syc_ik6_bq5_**AAA","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-gutan-complete:line052-pei01-01:m0007","start":7,"end":10,"surface":"宣太子","kind":"person","person_id":"572_278_cba_C","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-gutan-complete:line052-pei01-01:m0015","start":15,"end":17,"surface":"天子","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-gutan-complete:line052-pei01-01:m0044","start":44,"end":47,"surface":"诸葛恪","kind":"person","person_id":"512_1cd_a4b","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-gutan-complete:line052-pei01-01:m0054","start":54,"end":55,"surface":"谭","kind":"person","person_id":"syc_ik6_bq5_**AAA","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-gutan-complete:line052-pei01-01:m0069","start":69,"end":71,"surface":"范慎","kind":"person","person_id":"6nu_h6f_w7t","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-gutan-complete:line052-pei01-01:m0072","start":72,"end":74,"surface":"谢景","kind":"person","person_id":"6bl_52a_6nv","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-gutan-complete:line052-pei01-01:m0075","start":75,"end":77,"surface":"羊徽","kind":"person","person_id":"cze_e76_40a","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-gutan-complete:line052-pei01-01:m0090","start":90,"end":91,"surface":"谭","kind":"person","person_id":"syc_ik6_bq5_**AAA","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"source_position":{"first_line":52,"last_line":52,"revision_id":2085149,"raw_start":7172,"raw_end":7265,"character_positions":[7172,7173,7174,7175,7176,7177,7178,7179,7180,7181,7182,7183,7184,7185,7186,7187,7188,7189,7190,7191,7192,7193,7194,7195,7196,7197,7198,7199,7200,7201,7202,7203,7204,7205,7206,7207,7208,7209,7210,7211,7212,7213,7214,7215,7216,7217,7218,7219,7220,7221,7222,7223,7224,7225,7226,7227,7228,7229,7230,7231,7232,7233,7234,7235,7236,7237,7238,7239,7240,7241,7242,7243,7244,7245,7246,7247,7248,7249,7250,7251,7252,7253,7254,7255,7256,7257,7258,7259,7260,7261,7262,7263,7264]},"attribution":{"annotator":"裴松之","attribution_kind":"quoted_work","source_label":"陸機作顧譚傳","attribution_marker":"陆机为谭传曰","reading":"裴注明列所引文獻。","quoted_work":"陸機作顧譚傳"},"attachment":{"received_paragraph_id":"c-sanguozhi-052-gutan-complete:line052","received_codepoint":28,"note_ordinal":1,"source_ordinal":1},"chapter_id":"c-sanguozhi-052-gutan-complete","book_id":"b-sanguozhi-052","work_id":"w-sanguozhi","source_id":"s-sanguozhi-052-gutan-complete"},{"id":"c-sanguozhi-052-zhangcheng-complete:line032","text":"承字仲嗣，少以才學知名，與諸葛瑾、歩騭、嚴畯相友善。權爲驃騎將軍，辟西曹掾，出爲長沙西部都尉。討平山寇，得精兵萬五千人。後爲濡須都督、奮威將軍，封都鄕侯，領部曲五千人。承爲人壯毅忠讜，能甄識人物，拔彭城蔡款、南陽謝景於孤微童幼，後並爲國士，款至衞尉，景豫章太守。又諸葛恪年少時，眾人奇其英才。承言終敗諸葛氏者，元遜也。勤於長進，篤於物類，凡在庶幾之流，無不造門，年六十七，赤烏七年卒，謚曰定侯。子震嗣。初，承喪妻，昭欲爲索諸葛瑾女，承以相與有好，難之，權聞而勸焉，遂爲婿。生女，權爲子和納之。權數令和修敬於承，執子婿之禮。震諸葛恪誅時亦死。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-sanguozhi-052-zhangcheng-complete:line032:m0000","start":0,"end":1,"surface":"承","kind":"person","person_id":"roi_rz4_ute_B","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhangcheng-complete:line032:m0002","start":2,"end":4,"surface":"仲嗣","kind":"