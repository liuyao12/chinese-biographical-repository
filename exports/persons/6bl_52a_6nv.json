_positions":[3697,3698,3699,3700,3701,3712,3713,3714,3717,3718]},"attribution":{"annotator":"裴松之","attribution_kind":"cross_reference","source_label":"裴注互見","attribution_marker":"谢景事在","reading":"另指本書孫登傳。"},"attachment":{"received_paragraph_id":"c-sanguozhi-052-zhangcheng-complete:line032","received_codepoint":131,"note_ordinal":1,"source_ordinal":2},"chapter_id":"c-sanguozhi-052-zhangcheng-complete","book_id":"b-sanguozhi-052","work_id":"w-sanguozhi","source_id":"s-sanguozhi-052-zhangcheng-complete"},{"id":"c-sanguozhi-058-luxun:line035","text":"黃龍元年，拜上大將軍、右都護。是歲，權東巡建業，留太子，皇子及尚書九官，征遜輔太子，並掌荊州及豫章三郡事，董督軍國。時建昌侯慮於堂前作斗鴨欄，頗施小巧。遜正色曰：「君候宜勤覽經典以自新益，用此何為？」慮即時毀徹之。射聲校尉松於公子中最親，戲兵不整，遜對之髡其職吏。南陽謝景善劉廙先刑後禮之論，遜呵景曰：「禮之長於刑久矣，廙以細辯而詭先聖之教，皆非也。君今侍東宮，宜遵仁義以彰德音，若彼之談，不須講也。」遜雖身在外，乃心於國。上疏陳時事曰：","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-058-luxun:line035:m0018","start":18,"end":19,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line035:m0025","start":25,"end":27,"surface":"太子","kind":"person","person_id":"572_278_cba_C","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line035:m0037","start":37,"end":38,"surface":"遜","kind":"person","person_id":"lii_454_vuv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line035:m0039","start":39,"end":41,"surface":"太子","kind":"person","person_id":"572_278_cba_C","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line035:m0062","start":62,"end":63,"surface":"慮","kind":"person","person_id":"572_278_cba_D","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line035:m0076","start":76,"end":77,"surface":"遜","kind":"person","person_id":"lii_454_vuv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058