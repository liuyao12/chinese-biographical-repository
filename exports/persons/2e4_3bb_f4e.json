e_decisions":[],"preferred_relations":[{"id":"a-song056-xiezhan-002","subject_person_id":"2e4_3bb_f4e","predicate":"sister","object_person_id":"20b_ca7_fa8","status":"source_attested","qualifiers":{"source_term":"劉弟柳為吴郡将姊俱行","relative_birth_order":{"older_person_id":"2e4_3bb_f4e","younger_person_id":"20b_ca7_fa8","operator":"lt","scope":"siblings","older_ordinal":null,"younger_ordinal":null}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-056","chapter_id":"c-songshu-056-xiezhan","source_id":"s-songshu-056-xiezhan","paragraph_id":"c-songshu-056-xiezhan:p001","quote":"謝瞻字宣逺一名檐字通逺陳郡陽夏人衛將軍晦第三兄也年六嵗能屬文為紫石英讚果然詩當時才士莫不歎異初為桓偉安西叅軍楚臺祕書郎瞻幼孤叔母劉撫養有恩紀兄弟事之同於至親劉弟柳為吴郡将姊俱行瞻不能違解職隨從為柳建威長史尋為髙祖鎮軍琅邪王大司馬參軍轉主簿安成相中書侍郎宋國中書黄門侍郎相國從事中郎弟晦時為宋臺右衛權遇己重於彭城還都迎家賔客輻輳門巷填咽時瞻在家驚駭謂晦曰汝名位未多而人歸趣乃爾吾家素以退為業不願干豫時事交遊不過親朋而汝遂勢傾朝野此豈門户之福邪乃籬隔門庭曰吾不忍見此及還彭城言於髙祖曰臣本素士父祖位不過二千石弟年始三十志用凡近榮冠臺府位任顯密福過災生其應無逺特乞降黜以保衰門前後屢陳髙祖以瞻為吴興郡又自陳請乃為豫章太守晦或以朝廷密事語瞻瞻輙向親舊陳説以為笑戲以絶其言晦遂建佐命之功任寄隆重瞻愈憂懼永初二年在郡遇疾不肯自治幸於不永晦聞疾奔往瞻見之曰汝為國大臣又總戎重萬里逺出必生疑謗時果有訴告晦反者瞻疾篤還都髙祖以晦典禁旅不得出宿使瞻居于晉南郡公主婚羊賁故第在領軍府東門瞻曰吾有先人敝廬何為於此臨終遺晦書曰吾得啓體幸全歸骨山足亦何所多恨弟思自勉厲為國為家遂卒時年三十五","relationship_anchor":{"paragraph_id":"c-songshu-056-xiezhan:p001","start":78,"end":88,"surface":"劉弟柳為吴郡将姊俱行"},"subject_person_mention_id":"c-songshu-056-xiezhan:p001:m0064","object_person_mention_id":"c-songshu-056-xiezhan:p001:m0080"}],"interpretation_note":"柳帶姊同行；姊為先言叔母劉，無劉丈夫或瞻出繼。","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"id":"name-song056-f20-005","person_id":"2e4_3bb_f4e","title":null,"surname":"劉","ming":null,"additional_names":[],"chapter_id":"c-songshu-056-xiezhan","paragraph_id":"c-songshu-056-xiezhan:p001","person_mention_id":"c-songshu-056-xiezhan:p001:m0064","quote":"謝瞻字宣逺一名檐字通逺陳郡陽夏人衛將軍晦第三兄也年六嵗能屬文為紫石英讚果然詩當時才士莫不歎異初為桓偉安西叅軍楚臺祕書郎瞻幼孤叔母劉撫養有恩紀兄弟事之同於至親劉弟柳為吴郡将姊俱行瞻不能違解職隨從為柳建威長史尋為髙祖鎮軍琅邪王大司馬參軍轉主簿安成相中書侍郎宋國