nyan:m002-0074","start":74,"end":76,"surface":"鮑叔","kind":"person","person_id":"cbr-p003702","status":"contextual_provisional","paragraph_id":"c-shiji-062-guanyan:p002","chapter_id":"c-shiji-062-guanyan"},{"id":"c-shiji-062-guanyan:m002-0097","start":97,"end":99,"surface":"鮑叔","kind":"person","person_id":"cbr-p003702","status":"contextual_provisional","paragraph_id":"c-shiji-062-guanyan:p002","chapter_id":"c-shiji-062-guanyan"},{"id":"c-shiji-062-guanyan:m002-0127","start":127,"end":129,"surface":"鮑叔","kind":"person","person_id":"cbr-p003702","status":"contextual_provisional","paragraph_id":"c-shiji-062-guanyan:p002","chapter_id":"c-shiji-062-guanyan"},{"id":"c-shiji-062-guanyan:m002-0162","start":162,"end":164,"surface":"鮑子","kind":"person","person_id":"cbr-p003702","status":"contextual_provisional","paragraph_id":"c-shiji-062-guanyan:p002","chapter_id":"c-shiji-062-guanyan"},{"id":"c-shiji-062-guanyan:m003-0000","start":0,"end":2,"surface":"鮑叔","kind":"person","person_id":"cbr-p003702","status":"contextual_provisional","paragraph_id":"c-shiji-062-guanyan:p003","chapter_id":"c-shiji-062-guanyan"},{"id":"c-shiji-062-guanyan:m003-0043","start":43,"end":45,"surface":"鮑叔","kind":"person","person_id":"cbr-p003702","status":"contextual_provisional","paragraph_id":"c-shiji-062-guanyan:p003","chapter_id":"c-shiji-062-guanyan"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji032-057","person_id":"cbr-p001103","surfaces":["叔牙","鮑叔","鮑叔牙"],"scope":"same_chapter","chapter_ids":["c-shiji-032-qi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-032-qi:p029","quote":"初，襄公之醉殺魯桓公，通其夫人，殺誅數不當，淫於婦人，數欺大臣，群弟恐禍及，故次弟糾奔魯。其母魯女也。管仲、召忽傅之。次弟小白奔莒，鮑叔傅之。小白母，衛女也，有寵於釐公。小白自少好善大夫高傒。及雍林人殺無知，議立君，高、國先陰召小白於莒。魯聞無知死，亦發兵送公子糾，而使管仲別將兵遮莒道，射中小白帶鉤。小白詳死，管仲使人馳報魯。魯送糾者行益遲，六日至齊，則小白已入，高傒立之，是為桓公。"},{"paragraph_id":"c-shiji-032-qi:p030","quote":"桓公之中鉤，詳死以誤管仲，已而載溫車中馳行，亦有高、國內應，故得先入立，發兵距魯。秋，與魯戰于乾時，魯兵敗走，齊兵掩絕魯歸道。齊遺魯書曰：「子糾兄弟，弗忍誅，請魯自殺之。召忽、管仲讎也，請得而甘心醢之。不然，將圍魯。」魯人患之，遂殺子糾于笙瀆。召忽自殺，管仲請囚。桓公之立，發兵攻魯，心欲殺管仲。鮑叔牙曰：「臣幸得從君，君竟以立。君之尊，臣無以增君。君將治齊，即高傒與叔牙足也。君且欲霸王，非管夷吾不可。夷吾所居國國重，不可失也。」於是桓公從之。乃詳為召管仲欲甘心，實欲用之。管仲知之，故請往。鮑叔牙迎受管仲，及堂阜而脫桎梏，齋祓而見桓公。桓公厚禮以為大夫，任政。"},{"paragraph_id":"c-shiji-032-qi:p031","quote":"桓公既得管仲，與鮑叔、隰朋、高傒修齊國政，連五家之兵，設輕重魚鹽之利，以贍貧窮，祿賢能，齊人皆說。"}],"rationale":"按本篇小白立桓公、管仲任政、葵丘盟會及齊君／母親的明示敘事相接暫定；魯與齊的同號君主、同氏女性分開，不作全庫字串合併。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji040-137","person_id":"cbr-p002013","surfaces":["鮑叔牙"],"scope":"same_chapter","chapter_ids":["c-shiji-040-chu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-040-chu:p040","quote":"初，子比自晉歸，韓宣子問叔向曰：「子比其濟乎？」對曰：「不就。」宣子曰：「同惡相求，如市賈焉，何爲不就？」對曰：「無與同好，誰與同惡？取國有五難：有寵無人，一也；有人無主，二也；有主無謀，三也；有謀而無民，四也；有民而無德，五也。子比在晉十三年矣，晉、楚之從不聞通者，可謂無人矣；族盡親叛，可謂無主矣；無釁而動，可謂無謀矣；爲羈終世，可謂無民矣；亡無愛徴，可謂無德矣。王虐而不忌，子比渉五難以弒君，誰能濟之！有楚國者，其棄疾乎？君陳、蔡，方城外屬焉。苛慝不作，盜賊伏隱，私欲不違，民無怨心。先神命之，國民信之。羋姓有亂，必季實立，楚之常也。子比之官，則右尹也；數其貴寵，則庶子也；以神所命，則又遠之；民無懷焉，將何以立？」宣子曰：「齊桓、晉文不亦是乎？」對曰：「齊桓，衞姬之子也，有寵於釐公。有鮑叔牙、賓須無、隰朋以爲輔，有莒、衞以爲外主，有髙、國以爲内主。從善如流，施惠不倦。有國，不亦宜乎？昔我文公，狐季姬之子也，有寵於獻公。好學不倦。生十七年，有士五人，有先大夫子餘、子犯以爲腹心，有魏犫、賈佗以爲股肱，有齊、宋、秦、楚以爲外主，有欒、郤、狐、先以爲内主。亡十九年，守志彌篤。惠、懷棄民，民從而與之。故文公有國，不亦宜乎？子比無施於民，無援於外，去晉，晉不送；歸楚，楚不迎。何以有國！」子比果不終焉，卒立者棄疾，如叔向言也。"}],"rationale":"本篇具名角色先保存候選；尚未與他篇同名或同稱人物完成事件、世系與版本比對，不作確定不同人或確定同人的結論。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji062-002","person_id":"cbr-p003702","surfaces":["鮑叔","鮑叔牙","鮑子"],"scope":"same_chapter","chapter_ids":["c-shiji-062-guanyan"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-062-guanyan:p001","quote":"管仲夷吾者，潁上人也。少時常與鮑叔牙游，鮑叔知其賢。管仲貧困，常欺鮑叔，鮑叔終善遇之，不以為言。已而鮑叔事齊公子小白，管仲事公子糾。及小白立為桓公，公子糾死，管仲囚焉。鮑叔遂進管仲。管仲既用，任政於齊，齊桓公以霸，九合諸侯，一匡天下，管仲之謀也。"},{"paragraph_id":"c-shiji-062-guanyan:p002","quote":"管仲曰：「吾始困時，嘗與鮑叔賈，分財利多自與，鮑叔不以我為貪，知我貧也。吾嘗為鮑叔謀事而更窮困，鮑叔不以我為愚，知時有利不利也。吾嘗三仕三見逐於君，鮑叔不以我為不肖，知我不遭時也。吾嘗三戰三走，鮑叔不以我怯，知我有老母也。公子糾敗，召忽死之，吾幽囚受辱，鮑叔不以我為無恥，知我不羞小節而恥功名不顯于天下也。生我者父母，知我者鮑子也。」"},{"paragraph_id":"c-shiji-062-guanyan:p003","quote":"鮑叔既進管仲，以身下之。子孫世祿於齊，有封邑者十餘世，常為名大夫。天下不多管仲之賢而多鮑叔能知人也。"}],"rationale":"依明示姓名、齊公子小白立桓公、晏平仲嬰與對話說話者及御者妻敘事局部暫接；不全域按短字匹配，不把書名當人名，未名人物不補全名。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji040-baoshu","person_ids":["cbr-p001103","cbr-p002013"],"canonical_person_id":"cbr-p001103","scope":"cross_chapter","chapter_ids":["c-shiji-032-qi","c-shiji-040-chu"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-032-qi","source_id":"s-shiji-032-qi","paragraph_id":"c-shiji-032-qi:p030","quote":"桓公之中鉤，詳死以誤管仲，已而載溫車中馳行，亦有高、國內應，故得先入立，發兵距魯。秋，與魯戰于乾時，魯兵敗走，齊兵掩絕魯歸道。齊遺魯書曰：「子糾兄弟，弗忍誅，請魯自殺之。召忽、管仲讎也，請得而甘心醢之。不然，將圍魯。」魯人患之，遂殺子糾于笙瀆。召忽自殺，管仲請囚。桓公之立，發兵攻魯，心欲殺管仲。鮑叔牙曰：「臣幸得從君，君竟以立。君之尊，臣無以增君。君將治齊，即高傒與叔牙足也。君且欲霸王，非管夷吾不可。夷吾所居國國重，不可失也。」於是桓公從之。乃詳為召管仲欲甘心，實欲用之。管仲知之，故請往。鮑叔牙迎受管仲，及堂阜而脫桎梏，齋祓而見桓公。桓公厚禮以為大夫，任政。","mention_ids":["c-shiji-032-qi:m030-0148","c-shiji-032-qi:m030-0184","c-shiji-032-qi:m030-0247"]},{"chapter_id":"c-shiji-040-chu","source_id":"s-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p040","quote":"初，子比自晉歸，韓宣子問叔向曰：「子比其濟乎？」對曰：「不就。」宣子曰：「同惡相求，如市賈焉，何爲不就？」對曰：「無與同好，誰與同惡？取國有五難：有寵無人，一也；有人無主，二也；有主無謀，三也；有謀而無民，四也；有民而無德，五也。子比在晉十三年矣，晉、楚之從不聞通者，可謂無人矣；族盡親叛，可謂無主矣；無釁而動，可謂無謀矣；爲羈終世，可謂無民矣；亡無愛徴，可謂無德矣。王虐而不忌，子比渉五難以弒君，誰能濟之！有楚國者，其棄疾乎？君陳、蔡，方城外屬焉。苛慝不作，盜賊伏隱，私欲不違，民無怨心。先神命之，國民信之。羋姓有亂，必季實立，楚之常也。子比之官，則右尹也；數其貴寵，則庶子也；以神所命，則又遠之；民無懷焉，將何以立？」宣子曰：「齊桓、晉文不亦是乎？」對曰：「齊桓，衞姬之子也，有寵於釐公。有鮑叔牙、賓須無、隰朋以爲輔，有莒、衞以爲外主，有髙、國以爲内主。從善如流，施惠不倦。有國，不亦宜乎？昔我文公，狐季姬之子也，有寵於獻公。好學不倦。生十七年，有士五人，有先大夫子餘、子犯以爲腹心，有魏犫、賈佗以爲股肱，有齊、宋、秦、楚以爲外主，有欒、郤、狐、先以爲内主。亡十九年，守志彌篤。惠、懷棄民，民從而與之。故文公有國，不亦宜乎？子比無施於民，無援於外，去晉，晉不送；歸楚，楚不迎。何以有國！」子比果不終焉，卒立者棄疾，如叔向言也。","mention_ids":["c-shiji-040-chu:m040-0347"]}],"rationale":"齊篇鮑叔牙自述從君使桓公立並推薦管仲，楚篇鮑叔牙為齊桓輔；按姓名、所輔國君與立國敘事暫同指，不由同名泛接其他時代。 已發ID及所有原證據保留；尚未完成人工及可靠版本覆核。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"eq-shiji062-bao","person_ids":["cbr-p001103","cbr-p003702"],"canonical_person_id":"cbr-p001103","scope":"cross_chapter","chapter_ids":["c-shiji-032-qi","c-shiji-062-guanyan"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-032-qi","source_id":"s-shiji-032-qi","paragraph_id":"c-shiji-032-qi:p029","quote":"初，襄公之醉殺魯桓公，通其夫人，殺誅數不當，淫於婦人，數欺大臣，群弟恐禍及，故次弟糾奔魯。其母魯女也。管仲、召忽傅之。次弟小白奔莒，鮑叔傅之。小白母，衛女也，有寵於釐公。小白自少好善大夫高傒。及雍林人殺無知，議立君，高、國先陰召小白於莒。魯聞無知死，亦發兵送公子糾，而使管仲別將兵遮莒道，射中小白帶鉤。小白詳死，管仲使人馳報魯。魯送糾者行益遲，六日至齊，則小白已入，高傒立之，是為桓公。","mention_ids":["c-shiji-032-qi:m029-0066"]},{"chapter_id":"c-shiji-062-guanyan","source_id":"s-shiji-062-guanyan","paragraph_id":"c-shiji-062-guanyan:p001","quote":"管仲夷吾者，潁上人也。少時常與鮑叔牙游，鮑叔知其賢。管仲貧困，常欺鮑叔，鮑叔終善遇之，不以為言。已而鮑叔事齊公子小白，管仲事公子糾。及小白立為桓公，公子糾死，管仲囚焉。鮑叔遂進管仲。管仲既用，任政於齊，齊桓公以霸，九合諸侯，一匡天下，管仲之謀也。","mention_ids":["c-shiji-062-guanyan:m001-0015","c-shiji-062-guanyan:m001-0020","c-shiji-062-guanyan:m001-0033","c-shiji-062-guanyan:m001-0036","c-shiji-062-guanyan:m001-0050","c-shiji-062-guanyan:m001-0084"]}],"rationale":"鮑叔在兩篇同為事小白、與管仲公子糾相對的輔佐者，本篇鮑叔牙與鮑叔在同段接續。 已發ID與各篇原文保留，同書各篇不當獨立見證；身份暫接不確證史實或任期。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-032-qi:p029","text":"初，襄公之醉殺魯桓公，通其夫人，殺誅數不當，淫於婦人，數欺大臣，群弟恐禍及，故次弟糾奔魯。其母魯女也。管仲、召忽傅之。次弟小白奔莒，鮑叔傅之。小白母，衛女也，有寵於釐公。小白自少好善大夫高傒。及雍林人殺無知，議立君，高、國先陰召小白於莒。魯聞無知死，亦發兵送公子糾，而使管仲別將兵遮莒道，射中小白帶鉤。小白詳死，管仲使人馳報魯。魯送糾者行益遲，六日至齊，則小白已入，高傒立之，是為桓公。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-032-qi:m029-0002","start":2,"end":4,"surface":"襄公","kind":"person","person_id":"cbr-p000363","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m029-0007","start":7,"end":10,"surface":"魯桓公","kind":"person","person_id":"cbr-p000229","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m029-0012","start":12,"end":15,"surface":"其夫人","kind":"person","person_id":"cbr-p001098","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m029-0032","start":32,"end":34,"surface":"群弟","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、族稱或未定指代，不補未見姓名與成員；官禮等級不直接當授官。"},{"id":"c-shiji-032-qi:m029-0041","start":41,"end":42,"surface":"糾","kind":"person","person_id":"cbr-p001101","status":"contextual_provis