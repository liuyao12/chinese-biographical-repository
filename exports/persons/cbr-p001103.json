shiji-032-qi:m030-0196","start":196,"end":199,"surface":"管夷吾","kind":"person","person_id":"cbr-p000243","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m030-0202","start":202,"end":204,"surface":"夷吾","kind":"person","person_id":"cbr-p000243","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m030-0218","start":218,"end":220,"surface":"桓公","kind":"person","person_id":"cbr-p000235","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m030-0227","start":227,"end":229,"surface":"管仲","kind":"person","person_id":"cbr-p000243","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m030-0238","start":238,"end":240,"surface":"管仲","kind":"person","person_id":"cbr-p000243","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m030-0247","start":247,"end":250,"surface":"鮑叔牙","kind":"person","person_id":"cbr-p001103","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m030-0252","start":252,"end":254,"surface":"管仲","kind":"person","person_id":"cbr-p000243","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m030-0267","start":267,"end":269,"surface":"桓公","kind":"person","person_id":"cbr-p000235","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m030-0270","start":270,"end":272,"surface":"桓公","kind":"person","person_id":"cbr-p000235","status":"contextual_provisional"}],"chapter_id":"c-shiji-032-qi","book_id":"b-shiji-032","work_id":"w-shiji","source_id":"s-shiji-032-qi"},{"id":"c-shiji-032-qi:p031","text":"桓公既得管仲，與鮑叔、隰朋、高傒修齊國政，連五家之兵，設輕重魚鹽之利，以贍貧窮，祿賢能，齊人皆說。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-032-qi:m031-0000","start":0,"end":2,"surface":"桓公","kind":"person","person_id":"cbr-p000235","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m031-0004","start":4,"end":6,"surface":"管仲","kind":"person","person_id":"cbr-p000243","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m031-0008","start":8,"end":10,"surface":"鮑叔","kind":"person","person_id":"cbr-p001103","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m031-0011","start":11,"end":13,"surface":"隰朋","kind":"person","person_id":"cbr-p000244","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m031-0014","start":14,"end":16,"surface":"高傒","kind":"person","person_id":"cbr-p001104","status":"contextual_provisional"}],"chapter_id":"c-shiji-032-qi","book_id":"b-shiji-032","work_id":"w-shiji","source_id":"s-shiji-032-qi"},{"id":"c-shiji-040-chu:p040","text":"初，子比自晉歸，韓宣子問叔向曰：「子比其濟乎？」對曰：「不就。」宣子曰：「同惡相求，如市賈焉，何爲不就？」對曰：「無與同好，誰與同惡？取國有五難：有寵無人，一也；有人無主，二也；有主無謀，三也；有謀而無民，四也；有民而無德，五也。子比在晉十三年矣，晉、楚之從不聞通者，可謂無人矣；族盡親叛，可謂無主矣；無釁而動，可謂無謀矣；爲羈終世，可謂無民矣；亡無愛徴，可謂無德矣。王虐而不忌，子比渉五難以弒君，誰能濟之！有楚國者，其棄疾乎？君陳、蔡，方城外屬焉。苛慝不作，盜賊伏隱，私欲不違，民無怨心。先神命之，國民信之。羋姓有亂，必季實立，楚之常也。子比之官，則右尹也；數其貴寵，則庶子也；以神所命，則又遠之；民無懷焉，將何以立？」宣子曰：「齊桓、晉文不亦是乎？」對曰：「齊桓，衞姬之子也，有寵於釐公。有鮑叔牙、賓須無、隰朋以爲輔，有莒、衞以爲外主，有髙、國以爲内主。從善如流，施惠不倦。有國，不亦宜乎？昔我文公，狐季姬之子也，有寵於獻公。好學不倦。生十七年，有士五人，有先大夫子餘、子犯以爲腹心，有魏犫、賈佗以爲股肱，有齊、宋、秦、楚以爲外主，有欒、郤、狐、先以爲内主。亡十九年，守志彌篤。惠、懷棄民，民從而與之。故文公有國，不亦宜乎？子比無施於民，無援於外，去晉，晉不送；歸楚，楚不迎。何以有國！」子比果不終焉，卒立者棄疾，如叔向言也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m040-0002","start":2,"end":4,"surface":"子比","kind":"person","person_id":"cbr-p001890","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m040-0008","start":8,"end":11,"surface":"韓宣子","kind":"person","person_id":"cbr-p002009","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m040-0012","start":12,"end":14,"surface":"叔向","kind":"person","person_id":"cbr-p002010","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m040-0017","start":17,"end":19,"surface":"子比","kind":"person","person_id":"cbr-p001890","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m040-0032","start":32,"end":34,"surface":"宣子","kind":"person","person_id":"cbr-p002009","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m040-0115","start":115,"end":117,"surface":"子比","kind":"person","person_id":"cbr-p001890","status":"contextual_provisional"},{"i