"s-jinshu-071-chenyun-ws2595541"},{"id":"c-jinshu-071-chenyun:source_review7-42","kind":"source_review","person_id":"35g_kzq_9ef","source_quote":"宜漸循舊，搜揚隱逸，試以經策","reading":"通鑑九十另錄此議及施行。","note":"通鑑九十另錄此議及施行。","paragraph_id":"c-jinshu-071-chenyun:p007","start_codepoint":42,"end_codepoint":56,"human_reviewed":false,"chapter_id":"c-jinshu-071-chenyun","source_id":"s-jinshu-071-chenyun-ws2595541"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin071-chenxin-father","subject_person_id":"35g_kzq_9ef","object_person_id":"tq8_cse_vib","predicate":"father","qualifiers":{"source_term":"父訢立宅起門"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-071","chapter_id":"c-jinshu-071-chenyun","source_id":"s-jinshu-071-chenyun-ws2595541","paragraph_id":"c-jinshu-071-chenyun:p001","quote":"陳頵，字延思，陳國苦人也。少好學，有文義。父訢立宅起門，頵曰：「當使容馬車。」訢笑而從之。仕為郡督郵，檢獲隱匿者三千人，為一州尤最。太守劉享拔為主簿，州辟部從事，乘馬車還家，宗党榮之。","subject_person_mention_id":"c-jinshu-071-chenyun:p001:m0000","object_person_mention_id":"c-jinshu-071-chenyun:p001:m0022"}],"status":"source_attested","interpretation_note":"同段有父子立門的敘事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-jin071-chenyun","person_id":"35g_kzq_9ef","event_type":"death","source_term":"年六十九卒","source_anchor":{"paragraph_id":"c-jinshu-071-chenyun:p008","start":105,"end":110,"surface":"年六十九卒"},"date_expression":null,"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-071","chapter_id":"c-jinshu-071-chenyun","source_id":"s-jinshu-071-chenyun-ws2595541","paragraph_id":"c-jinshu-071-chenyun:p008","quote":"後拜天門太守，殊俗安之。選腹心之吏為荊州參軍，若有調發，動靜馳白，故恆得宿辦。陶侃征還，頵先至巴陵上禮。侃以為能，表為梁州刺史。綏懷荒弊，甚有威惠。梁州大姓互相嫉妒，說頵年老耳聾，侃召頵還，以西陽太守蔣巽代之。年六十九卒。","person_mention_id":"c-jinshu-071-chenyun:p008:m0084"}],"status":"source_attested","interpretation_note":"按同段人物與次第核所屬卒