tatus":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m009-0000","start":0,"end":2,"surface":"襄公","kind":"person","person_id":"y97_huh_vuz","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0008","start":8,"end":10,"surface":"繆嬴","kind":"person","person_id":"p7v_f2l_8l5","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0011","start":11,"end":13,"surface":"豐王","kind":"person","person_id":"73a_qx5_k2c","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0015","start":15,"end":17,"surface":"襄公","kind":"person","person_id":"y97_huh_vuz","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0025","start":25,"end":27,"surface":"世父","kind":"person","person_id":"r9u_j0z_xtb_AAAA","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0041","start":41,"end":43,"surface":"世父","kind":"person","person_id":"r9u_j0z_xtb_AAAA","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0048","start":48,"end":51,"surface":"周幽王","kind":"person","person_id":"fd5_uxa_0c9","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0052","start":52,"end":54,"surface":"褒姒","kind":"person","person_id":"rkn_3l3_3j3","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0055","start":55,"end":57,"surface":"太子","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或未核定指代；未由熟知世系補造人物。"},{"id":"c-shiji-005-qin:m009-0059","start":59,"end":61,"surface":"褒姒","kind":"person","person_id":"rkn_3l3_3j3","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0080","start":80,"end":82,"surface":"申侯","kind":"person","person_id":"1ag_0z1_mlq","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0086","start":86,"end":88,"surface":"幽王","kind":"person","person_id":"fd5_uxa_0c9","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0093","start":93,"end":96,"surface":"秦襄公","kind":"person","person_id":"y97_huh_vuz","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0