ind":"person","person_id":"yqp_nlb_p1p_CA","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m017-0280","start":280,"end":282,"surface":"吳王","kind":"person","person_id":"yqp_nlb_p1p_CA","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m017-0283","start":283,"end":285,"surface":"子華","kind":"person","person_id":"yqp_nlb_p1p_CAD","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m017-0286","start":286,"end":288,"surface":"子駒","kind":"person","person_id":"yqp_nlb_p1p_CAE","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m017-0293","start":293,"end":295,"surface":"吳王","kind":"person","person_id":"yqp_nlb_p1p_CA","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m017-0310","start":310,"end":312,"surface":"太尉","person_id":"koy_6jg_gcc_C","kind":"person","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m017-0316","start":316,"end":319,"surface":"楚王戊","kind":"person","person_id":"yqp_nlb_p1p_DCA","status":"contextual_provisional"}],"chapter_id":"c-shiji-106-wuwang","book_id":"b-shiji-106","work_id":"w-shiji","source_id":"s-shiji-106-wuwang"},{"id":"c-shiji-108-han:p001","text":"御史大夫韓安國者，梁成安人也，後徙睢陽。嘗受韓子、雜家説於騶田生所。事梁孝王爲中大夫。呉楚反時，孝王使安國及張羽爲將，捍呉兵於東界。張羽力戰，安國持重，以故呉不能過梁。呉楚已破，安國、張羽名由此顯。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-108-han:m001-0004","start":4,"end":7,"surface":"韓安國","kind":"person","person_id":"6hy_i1z_hu2","status":"contextual_provisional"},{"id":"c-shiji-108-han:m001-0030","start":30,"end":32,"surface":"田生","kind":"person","person_id":"x9n_lwg_op5","status":"contextual_provisional"},{"id":"c-shiji-108-han:m001-0035","start":35,"end":38,"surface":"梁孝王","kind":"person","person_id":"yqp_nlb_p1p_ACG","status":"contextual_provisional"},{"id":"c-shiji-108-han:m001-0048","start":48,"end":50,"surface":"孝王","kind":"person","person_id":"yqp_nlb_p1p_ACG","status":"contextual_provisional"},{"id":"c-shiji-108-han:m001-0051","start":51,"end":53,"surface":"安國","kind":"person","person_id":"6hy_i1z_hu2","status":"contextual_provisional"},{"id":"c-shiji-108-han:m001-0054","start":54,"end":56,"surface":"張羽","kind":"person","person_id":"o6h_ba5_gno","status":"contextual_provisional"},{"id":"c-shiji-108-han:m001-0066","start":66,"end":68,"surface":"張羽","kind":"person","person_id":"o6h_ba5_gno","status":"contextual_provisional"},{"id":"c-shiji-108-han:m001-0071","start":71,"end":73,"surface":"安國","kind":"person","person_id":"6hy_i1z_hu2","status":"contextual_provisional"},{"id":"c-shiji-108-han:m001-0089","start":89,"end":91,"surface":"安國","kind":"person","person_id":"6hy_i1z_hu2","status":"contextual_provisional"},{"id":"c-shiji-108-han:m001-0092","start":92,"end":94,"surface":"張羽","kind":"person","person_id":"o6h_ba5_gno","status":"contextual_provisional"}],"chapter_id":"c-shiji-108-han","book_id":"b-shiji-108","work_id":"w-shiji","source_id":"s-shiji-108-han"},{"id":"c-shiji-120-jizheng:p016","text":"鄭莊以任俠自喜，脫張羽於緦聲聞梁楚之閒。孝景時，為太子舍人。每五日洗沐，常置驛馬安諸郊，存諸故人，請謝賓客，夜以繼日，至其明旦，常恐不遍。莊好黃老之言，其慕長者如恐不見。年少官薄，然其游知交皆其大父行，天下有名之士也。武帝立，莊稍遷為魯中尉、濟南太守、江都相，至九卿為右內史。以武安侯魏其時議，貶秩為詹事，遷為大農令。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-120-jizheng:m016-0000","start":0,"end":2,"surface":"鄭莊","kind":"person","person_id":"jws_b08_hob","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m016-0009","start":9,"end":11,"surface":"張羽","kind":"person","person_id":"o6h_ba5_gno","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m016-0020","start":20,"end":22,"surface":"孝景","kind":"person","person_id":"yqp_nlb_p1p_ACA","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m016-0046","start":46,"end":48,"surface":"故人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-120-jizheng:m016-0051","start":51,"end":53,"surface":"賓客","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-120-jizheng:m016-0069","start":69,"end":70,"surface":"莊","kind":"person","person_id":"jws_b08_hob","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m016-0101","start":101,"end":107,"surface":"天下有名之士","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-120-jizheng:m016-0109","start":109,"end":111,"surface":"武帝","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m016-0113","start":113,"end":114,"surface":"莊","kind":"person","person_id":"jws_b08_hob","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m016-0139","start":139,"end":142,"surface":"武安侯","kind":"person","person_id":"7mz_d13_9ka_A","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m016-0142","start":142,"end":144,"surface":"魏其","kind":"person","person_id":"nuf_tb9_fjs_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-120-jizheng","book_id":"b-shiji-120","work_id":"w-shiji","source_id":"s-shiji120-jizheng"}],"sources":[{"chapter_id":"c-hanshu-035-jingyanwu","work_id":"w-hanshu","book_id":"b-hanshu-035","source_id":"s-hanshu-035-jingyanwu","source":{"title":"漢書／卷035","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/漢書/卷035","permalink":"https://zh.wikisource.org/w/index.php?title=漢書/卷035&oldid=2605377","revision_id":2605377,"accessed_on":"2026-10-15","extent":"目前錄吳王傳八個不連續段落；荊王、燕王、其他吳王段及贊未錄，不代表全卷完成。","text_scope":"partial_chapter","image_verified":false,"review_status":"text_checked","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"固定HTML的p元素，去段首尾空白、解碼HTML實體，不合併原段，不改古字。"},"html_sha256":"2e018b66d35e2de08408e9123eeb1e48966d649e98c66f2b89d4e11ef4811f9f","included_sections":["吳王傳八個不連續段落"],"license_url":"https://creativecommons.org/licenses/by-sa/4.0/","rights":"古代原文；維基文庫數位轉錄依CC BY-SA 4.0，保留貢獻者署名及固定修訂連結。","edition":null,"revision_timestamp":null}},{"chapter_id":"c-shiji-058-liang","work_id":"w-shiji","book_id":"b-shiji-058","source_id":"s-shiji-058-liang","source":{"title":"史記／卷058","provider":"維基文庫","url":"https://zh.wikiso