r_id":"c-shiji-108-han","mention_count":3,"mention_ids":["c-shiji-108-han:m001-0054","c-shiji-108-han:m001-0066","c-shiji-108-han:m001-0092"],"paragraph_ids":["c-shiji-108-han:p001"],"table_cell_ids":[],"passage_count":1},{"source_id":"s-shiji-058-liang","work_id":"w-shiji","book_id":"b-shiji-058","chapter_id":"c-shiji-058-liang","mention_count":1,"mention_ids":["c-shiji-058-liang:m005-0038"],"paragraph_ids":["c-shiji-058-liang:p005"],"table_cell_ids":[],"passage_count":1},{"source_id":"s-shiji-106-wuwang","work_id":"w-shiji","book_id":"b-shiji-106","chapter_id":"c-shiji-106-wuwang","mention_count":1,"mention_ids":["c-shiji-106-wuwang:m017-0100"],"paragraph_ids":["c-shiji-106-wuwang:p017"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-108-han"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji106-010","subject_person_id":"o6h_ba5_gno","predicate":"brother","object_person_id":"i8p_f0y_kea","status":"source_attested","evidence":[{"chapter_id":"c-shiji-106-wuwang","source_id":"s-shiji-106-wuwang","paragraph_id":"c-shiji-106-wuwang:p017","quote":"初，吳王之度淮，與楚王遂西敗棘壁，乘勝前，銳甚。梁孝王恐，遣六將軍擊吳，又敗梁兩將，士卒皆還走梁。梁數使使報條侯求救，條侯不許。又使使惡條侯於上，上使人告條侯救梁，復守便宜不行。梁使韓安國及楚死事相弟張羽為將軍，乃得頗敗吳兵。吳兵欲西，梁城守堅，不敢西，即走條侯軍，會下邑。欲戰，條侯壁，不肯戰。吳糧絕，卒饑，數挑戰，遂夜奔條侯壁，驚東南。條侯使備西北，果從西北入。吳大敗，士卒多饑死，乃畔散。於是吳王乃與其麾下壯士數千人夜亡去，度江走丹徒，保東越。東越兵可萬餘人，乃使人收聚亡卒。漢使人以利啗東越，東越即紿吳王，吳王出勞軍，即使人鏦殺吳王，盛其頭，馳傳以聞。吳王子子華、子駒亡走閩越。吳王之棄其軍亡也，軍遂潰，往往稍降太尉、梁軍。楚王戊軍敗，自殺。"}],"qualifiers":{"source_term":"楚死事相弟張羽","historicity":"historical_tradition","relative_birth_order":{"older_person_id":"i8p_f0y_kea","younger_person_id":"o6h_ba5_gno","operator":"lt","older_ordinal":null,"younger_ordinal":null,"scope":"siblings","interpretation_status":"source_attested","comparison_basis":"birth_chronology"}},"interpretation_note":"明稱弟張羽，不補楚死事相姓名或共同父母。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-058-liang:m005-0038","start":38,"end":40,"surface":"張羽","kind":"person","person_id":"o6h_ba5_gno","status":"contextual_provisional","paragraph_id":"c-shiji-058-liang:p005","chapter_id":"c-shiji-058-liang"},{"id":"c-shiji-106-wuwang:m017-0100","start":100,"end":102,"surface":"張羽","kind":"person","person_id":"o6h_ba5_gno","status":"contextual_provisional","paragraph_id":"c-shiji-106-wuwang:p017","chapter_id":"c-shiji-106-wuwang"},{"id":"c-shiji-108-han:m001-0054","start":54,"end":56,"surface":"張羽","kind":"person","person_id":"o6h_ba5_gno","status":"contextual_provisional","paragraph_id":"c-shiji-108-han:p001","chapter_id":"c-shiji-108-han"},{"id":"c-shiji-108-han:m001-0066","start":66,"end":68,"surface":"張羽","kind":"person","person_id":"o6h_ba5_gno","status":"contextual_provisional","paragraph_id":"c-shiji-108-han:p001","chapter_id":"c-shiji-108-han"},{"id":"c-shiji-108-han:m001-0092","start":92,"end":94,"surface":"張羽","kind":"person","person_id":"o6h_ba5_gno","status":"contextual_provisional","paragraph_id":"c-shiji-108-han:p001","chapter_id":"c-shiji-108-han"}],"relations":[{"id":"a-shiji106-010","subject_person_id":"o6h_ba5_gno","predicate":"brother","object_person_id":"i8p_f0y_kea","status":"source_attested","evidence":[{"chapter_id":"c-shiji-106-wuwang","source_id":"s-shiji-106-wuwang","paragraph_id":"c-shiji-106-wuwang:p017","quote":"初，吳王之度淮，與楚王遂西敗棘壁，乘勝前，銳甚。梁孝王恐，遣六將軍擊吳，又敗梁兩將，士卒皆還走梁。梁數使使報條侯求救，條侯不許。又使使惡條侯於上，上使人告條侯救梁，復守便宜不行。梁使韓安國及楚死事相弟張羽為將軍，乃得頗敗吳兵。吳兵欲西，梁城守堅，不敢西，即走條侯軍，會下邑。欲戰，條侯壁，不肯戰。吳糧絕，卒饑，數挑戰，遂夜奔條侯壁，驚東南。條侯使備西北，果從西北入。吳大敗，士卒多饑死，乃畔散。於是吳王乃與其麾下壯士數千人夜亡去，度江走丹徒，保東越。東越兵可萬餘人，乃使人收聚亡卒。漢使人以利啗東越，東越即紿吳王，吳王出勞軍，即使人鏦殺吳王，盛其頭，馳傳以聞。吳王子子華、子駒亡走閩越。吳王之棄其軍亡也，軍遂潰，往往稍降太尉、梁軍。楚王戊軍敗，自殺。"}],"qualifiers":{"source_term":"楚死事相弟張羽","historicity":"historical_tradition","relative_birth_order":{"older_person_id":"i8p_f0y_kea","younger_person_id":"o6h_ba5_gno","operator":"lt","older_ordinal":null,"younger_ordinal":null,"scope":"siblings","interpretation_status":"source_attested","comparison_basis":"birth_chronology"}},"interpretation_note":"明稱弟張羽，不補楚死事相姓名或共同父母。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji058-015","person_id":"o6h_ba5_gno","title":"大將軍","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-058-liang","source_id":"s-shiji-058-liang","paragraph_id":"c-shiji-058-liang:p005","quote":"其春，吳楚齊趙七國反。吳楚先擊梁棘壁，殺數萬人。梁孝王城守睢陽，而使韓安國、張羽等為大將軍，以距吳楚。吳楚以梁為限，不敢過而西，與太尉亞夫等相距三月。吳楚破，而梁所破殺虜略與漢中分。明年，漢立太子。其後梁最親，有功，又為大國，居天下膏腴地。地北界泰山，西至高陽，四十餘城，皆多大縣。"}],"attestations":[{"id":"th-shiji058-015:a001","paragraph_id":"c-shiji-058-liang:p005","start":42,"end":45,"surface":"大將軍","person_mention_id":"c-shiji-058-liang:m005-0038","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-058-liang","source_id":"s-shiji-058-liang","paragraph_id":"c-shiji-058-liang:p005","quote":"其春，吳楚齊趙七國反。吳楚先擊梁棘壁，殺數萬人。梁孝王城守睢陽，而使韓安國、張羽等為大將軍，以距吳楚。吳楚以梁為限，不敢過而西，與太尉亞夫等相距三月。吳楚破，而梁所破殺虜略與漢中分。明年，漢立太子。其後梁最親，有功，又為大國，居天下膏腴地。地北界泰山，西至高陽，四十餘城，皆多大縣。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授封、改封、敘事用稱與諡稱分存；相對年數及來源年號保留，不換算公曆，不從首次用稱或死亡補任期。未名群體不造個別官爵。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji106-029","person_id":"o6h_ba5_gno","title":"將軍","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-106-wuwang","source_id":"s-shiji-106-wuwang","paragraph_id":"c-shiji-106-wuwang:p017","quote":"初，吳王之度淮，與楚王遂西敗棘壁，乘勝前，銳甚。梁孝王恐，遣六將軍擊吳，又敗梁兩將，士卒皆還走梁。梁數使使報條侯求救，條侯不許。又使使惡條侯於上，上使人告條侯救梁，復守便宜不行。梁使韓安國及楚死事相弟張羽為將軍，乃得頗敗吳兵。吳兵欲西，梁城守堅，不敢西，即走條侯軍，會下邑。欲戰，條侯壁，不肯戰。吳糧絕，卒饑，數挑戰，遂夜奔條侯壁，驚東南。條侯使備西北，果從西北入。吳大敗，士卒多饑死，乃畔散。於是吳王乃與其麾下壯士數千人