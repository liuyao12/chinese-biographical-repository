ace":"吳王","kind":"person","person_id":"yqp_nlb_p1p_CA","status":"contextual_provisional"},{"id":"c-hanshu-035-jingyanwu:wuwang:m018-0274","start":274,"end":279,"surface":"吳王太子駒","kind":"person","person_id":"yqp_nlb_p1p_CAE","status":"contextual_provisional"},{"id":"c-hanshu-035-jingyanwu:wuwang:m018-0284","start":284,"end":286,"surface":"吳王","kind":"person","person_id":"yqp_nlb_p1p_CA","status":"contextual_provisional"},{"id":"c-hanshu-035-jingyanwu:wuwang:m018-0300","start":300,"end":304,"surface":"太尉條侯","kind":"person","person_id":"koy_6jg_gcc_C","status":"contextual_provisional"},{"id":"c-hanshu-035-jingyanwu:wuwang:m018-0308","start":308,"end":311,"surface":"楚王戊","kind":"person","person_id":"yqp_nlb_p1p_DCA","status":"contextual_provisional"}],"chapter_id":"c-hanshu-035-jingyanwu","book_id":"b-hanshu-035","work_id":"w-hanshu","source_id":"s-hanshu-035-jingyanwu"},{"id":"c-shiji-058-liang:p005","text":"其春，吳楚齊趙七國反。吳楚先擊梁棘壁，殺數萬人。梁孝王城守睢陽，而使韓安國、張羽等為大將軍，以距吳楚。吳楚以梁為限，不敢過而西，與太尉亞夫等相距三月。吳楚破，而梁所破殺虜略與漢中分。明年，漢立太子。其後梁最親，有功，又為大國，居天下膏腴地。地北界泰山，西至高陽，四十餘城，皆多大縣。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-058-liang:m005-0007","start":7,"end":9,"surface":"七國","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、所舉古事或未定指代；不補來源未見姓名、成員及關係。"},{"id":"c-shiji-058-liang:m005-0024","start":24,"end":27,"surface":"梁孝王","kind":"person","person_id":"yqp_nlb_p1p_ACG","status":"contextual_provisional"},{"id":"c-shiji-058-liang:m005-0034","start":34,"end":37,"surface":"韓安國","kind":"person","person_id":"6hy_i1z_hu2","status":"contextual_provisional"},{"id":"c-shiji-058-liang:m005-0038","start":38,"end":40,"surface":"張羽","kind":"person","person_id":"o6h_ba5_gno","status":"contextual_provisional"},{"id":"c-shiji-058-liang:m005-0040","start":40,"end":41,"surface":"等","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、所舉古事或未定指代；不補來源未見姓名、成員及關係。"},{"id":"c-shiji-058-liang:m005-0065","start":65,"end":69,"surface":"太尉亞夫","kind":"person","person_id":"koy_6jg_gcc_C","status":"contextual_provisional"},{"id":"c-shiji-058-liang:m005-0069","start":69,"end":70,"surface":"等","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、所舉古事或未定指代；不補來源未見姓名、成員及關係。"},{"id":"c-shiji-058-liang:m005-0096","start":96,"end":98,"surface":"太子","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、所舉古事或未定指代；不補來源未見姓名、成員及關係。"}],"chapter_id":"c-shiji-058-liang","book_id":"b-shiji-058","work_id":"w-shiji","source_id":"s-shiji-058-liang"},{"id":"c-shiji-106-wuwang:p017","text":"初，吳王之度淮，與楚王遂西敗棘壁，乘勝前，銳甚。梁孝王恐，遣六將軍擊吳，又敗梁兩將，士卒皆還走梁。梁數使使報條侯求救，條侯不許。又使使惡條侯於上，上使人告條侯救梁，復守便宜不行。梁使韓安國及楚死事相弟張羽為將軍，乃得頗敗吳兵。吳兵欲西，梁城守堅，不敢西，即走條侯軍，會下邑。欲戰，條侯壁，不肯戰。吳糧絕，卒饑，數挑戰，遂夜奔條侯壁，驚東南。條侯使備西北，果從西北入。吳大敗，士卒多饑死，乃畔散。於是吳王乃與其麾下壯士數千人夜亡去，度江走丹徒，保東越。東越兵可萬餘人，乃使人收聚亡卒。漢使人以利啗東越，東越即紿吳王，吳王出勞軍，即使人鏦殺吳王，盛其頭，馳傳以聞。吳王子子華、子駒亡走閩越。吳王之棄其軍亡也，軍遂潰，往往稍降太尉、梁軍。楚王戊軍敗，自殺。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-106-wuwang:m017-0002","start":2,"end":4,"surface":"吳王","kind":"person","person_id":"yqp_nlb_p1p_CA","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m017-0009","start":9,"end":11,"surface":"楚王","person_id":"yqp_nlb_p1p_DCA","kind":"person","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m017-0024","start":24,"end":27,"surface":"梁孝王","kind":"person","person_id":"yqp_nlb_p1p_ACG","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m017-0054","start":54,"end":56,"surface":"條侯","kind":"person","person_id":"koy_6jg_gcc_C","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m017-0059","start":59,"end":61,"surface":"條侯","kind":"person","person_id":"koy_6jg_gcc_C","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m017-0068","start":68,"end":70,"surface":"條侯","kind":"person","person_id":"koy_6jg_gcc_C","status":"contextual_provisional"},{"id":"c-shiji-106-wuwang:m017-0071","start":71,"end":72,