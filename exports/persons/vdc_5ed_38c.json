e":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line116:m0101","start":101,"end":102,"surface":"衍","kind":"person","person_id":"b0c_13f_c3a","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line116:m0112","start":112,"end":114,"surface":"平子","kind":"person","person_id":"rlk_lzd_86c","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"source_position":{"first_line":116,"last_line":116,"raw_start":8847,"raw_end":8966,"revision_id":2618531},"chapter_id":"c-jinshu-043-wangcheng","book_id":"b-jinshu-043","work_id":"w-jinshu","source_id":"s-jinshu-043-wangcheng"},{"id":"c-jinshu-043-wangcheng:line118","text":"少曆顯位，累遷成都王穎從事中郎。穎嬖豎孟玖譖殺陸機兄弟，天下切齒。澄發玖私奸，勸穎殺玖，穎乃誅之，士庶莫不稱善。及穎敗，東海王越請為司空長史。以迎大駕勳，封南鄉侯。遷建威將軍、雍州刺史，不之職。時王敦、謝鯤、庾敳、阮修皆為衍所親善，號為四友，而亦與澄狎，又有光逸、胡毋輔之等亦豫焉。酣宴縱誕，窮歡極娛。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-043-wangcheng:line118:m0007","start":7,"end":11,"surface":"成都王穎","kind":"person","person_id":"e81_f09_000","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line118:m0016","start":16,"end":17,"surface":"穎","kind":"person","person_id":"e81_f09_000","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line118:m0019","start":19,"end":21,"surface":"孟玖","kind":"person","person_id":"bmo_6e2_cfl","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line118:m0023","start":23,"end":25,"surface":"陸機","kind":"person","person_id":"69h_uhy_hta","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line118:u0025","start":25,"end":27,"surface":"兄弟","kind":"unresolved","person_id":null,"status":"unresolved","unresolved_kind":"unresolved_source_person","interpretation_note":"此處以兄弟統稱同遭誅者，字面未列個別弟名。"},{"id":"c-jinshu-043-wangcheng:line118:m0033","start":33,"end":34,"surface":"澄","kind":"person","person_id"