e":150,"column":17},{"line":150,"column":18},{"line":150,"column":19},{"line":150,"column":20},{"line":151,"column":0},{"line":151,"column":1},{"line":151,"column":2},{"line":151,"column":3},{"line":151,"column":4},{"line":151,"column":5},{"line":151,"column":6},{"line":151,"column":7},{"line":151,"column":8},{"line":151,"column":9},{"line":151,"column":10},{"line":151,"column":11},{"line":151,"column":12},{"line":151,"column":13},{"line":151,"column":14},{"line":151,"column":15},{"line":151,"column":16},{"line":151,"column":17},{"line":151,"column":18},{"line":151,"column":19},{"line":151,"column":20},{"line":153,"column":0},{"line":153,"column":1},{"line":153,"column":2},{"line":153,"column":3},{"line":153,"column":4},{"line":153,"column":5},{"line":153,"column":6},{"line":153,"column":7},{"line":153,"column":8},{"line":153,"column":9},{"line":153,"column":10}],"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-009-huan-annal-ningkang1","book_id":"b-jinshu-009","work_id":"w-jinshu","source_id":"s-jinshu-009-huan-annal-ningkang1"},{"id":"c-jinshu-074-huan-family:p009","text":"太元初，遷征西大將軍、開府。豁上疏固讓曰：「臣聞三臺麗天，辰極以之增耀；論道作弼，王猷以之時邕。必將仰參神契，對揚成務，弘易簡以翼化，暢玄風于宗極。故宜明揚仄陋，登庸賢俊，使版築有沖天之舉，渭濱無垂竿之逸。用乃功濟蒼生，道光千載。是以德非時望，成典所不虛授；功微賞厚，賢達不以擬心。臣實凡人，量無遠致，階藉門寵，遂叨非據。進不能闡揚皇風，贊明其政道；退不能宣力所蒞，混一華戎。屍素積載，庸績莫紀。是以敢冒成命，歸陳丹款。伏願陛下回神玄覽，追收謬眷，則具瞻革望，臣知所免。」竟不許。及苻堅陷仇池，豁以新野太守吉挹行魏興太守、督護梁州五郡軍事，戍梁州。堅陷涪城，梁州刺史楊亮、益州刺史周仲孫並委戍奔潰。豁以威略不振，所在覆敗，又上疏陳謝，固辭，不拜開府。尋卒，時年五十八。贈司空，本官如故，諡曰敬。贈錢五十萬，布五百匹，使者持節監護喪事。豁時譽雖不及沖，而甚有器度。但遇強寇，故功業不建。","source_position":{"kind":"wikitext_codepoint_positions","raw_path":"sources/jinshu/wikisource-1536331-raw.wikitext","raw_start":2133,"raw_end":2536,"character_positions":[2135,2136,2137,2138,2139,2140,2141,2142,2143,2144,2145,2146,2147,2148,2149,2150,2151,2152,2153,2154,2155,2156,2164,2165,2166,2167,2168,2169,2170,2171,2172,2173,2174,2175,2176,2177,2178,2179,2180,2181,2182,2183,2184,2185,2186,2187,2188,2189,2190,2191,2192,2193,2194,2195,2196,2197,2198,2199,2200,2201,2202,2203,2204,2205,2206,2207,220