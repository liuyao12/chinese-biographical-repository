ter_offsets":[9740,9741,9742,9743,9744,9745,9746,9747,9748,9749,9750,9751,9752,9753,9754,9755,9756,9757,9758,9759,9760,9761,9762,9763,9764,9765,9766,9767,9768,9769,9770,9771,9772,9773,9774,9775,9776,9777,9778,9779,9780,9781,9782,9783,9784,9785,9786,9787,9788,9789,9790,9791,9792,9793,9794,9795,9796,9797,9798,9799,9800,9801,9802,9803,9804,9805,9806,9807,9808,9809,9810,9811,9812,9813,9814,9815,9816,9817,9818,9819,9820,9823,9826,9827,9828,9829,9830,9831,9832,9833],"revision_id":1775463},"mentions":[{"id":"c-jinshu-058-zhou-zhongsun:p001:m0001","surface":"仲孫","start":1,"end":3,"person_id":"dam_7i0_s9b","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-zhongsun:p001:m0033","surface":"桓溫","start":33,"end":35,"person_id":"u9s_w6j_8mc_AA","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-zhongsun:p001:m0051","surface":"仲孫","start":51,"end":53,"person_id":"dam_7i0_s9b","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-zhongsun:p001:m0068","surface":"楊安","start":68,"end":70,"person_id":"mta_jet_l8e","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-zhongsun:p001:m0073","surface":"仲孫","start":73,"end":75,"person_id":"dam_7i0_s9b","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-058-zhou-zhongsun","book_id":"b-jinshu-058","work_id":"w-jinshu","source_id":"s-jinshu-058-zhou-zhongsun-ws1775463"},{"id":"c-jinshu-074-huan-family:p009","text":"太元初，遷征西大將軍、開府。豁上疏固讓曰：「臣聞三臺麗天，辰極以之增耀；論道作弼，王猷以之時邕。必將仰參神契，對揚成務，弘易簡以翼化，暢玄風于宗極。故宜明揚仄陋，登庸賢俊，使版築有沖天之舉，渭濱無垂竿之逸。用乃功濟蒼生，道光千載。是以德非時望，成典所不虛授；功微賞厚，賢達不以擬心。臣實凡人，量無遠致，階藉門寵，遂叨非據。進不能闡揚皇風，贊明其政道；退不能宣力所蒞，混一華戎。屍素積載，庸績莫紀。是以敢冒成命，歸陳丹款。伏願陛下回神玄覽，追收謬眷，則具瞻革望，臣知所免。」竟不許。及苻堅陷仇池，豁以新野太守吉挹行魏興太守、督護梁州五郡軍事，戍梁州。堅陷涪城，梁州刺史楊亮、益州刺史周仲孫並委戍奔潰。豁以威略不振，所在覆敗，又上疏陳謝，固辭，不拜開府。尋卒，時年五十八。贈司空，本官如故，諡曰敬。贈錢五十萬，布五百匹，使者持節監護喪事。豁時譽雖不及沖，而甚有器度。但遇強寇，故功業不建。","source_position":{"kind":"wikitext_codepoint_positions","raw_path":"sources/jinshu/wikisource-1536331-raw.wikitext","raw_start"