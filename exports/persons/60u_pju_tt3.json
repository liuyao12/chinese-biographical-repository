":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-029","chapter_id":"c-liangshu-029-huili-complete","source_id":"s-liangshu-029-huili-complete-ws1538079","paragraph_id":"c-liangshu-029-huili-complete:p002","quote":"二年，侯景圍京邑，會理治嚴將入援，會北徐州刺史封山侯正表將應其兄正德，外託赴援，實謀襲廣陵，會理擊破之。方得進路，臺城陷，侯景遣前臨江太守董紹先以高祖手敕召會理，其僚佐咸勸距之。會理曰：「諸君心事，與我不同，天子年尊，受制賊虜，今有手敕召我入朝，臣子之心，豈得違背。且遠處江北，功業難成，不若身赴京都，圖之肘腋。吾計決矣。」遂席捲而行，以城輸紹先。至京，景以爲侍中、司空、兼中書令。雖在寇手，每思匡復，與西鄉侯勸等潛布腹心，要結壯士。時范陽祖皓斬紹先，據廣陵城起義，期以會理爲內應。皓敗，辭相連及，景矯詔免會理官，猶以白衣領尚書令。","person_mention_id":"c-liangshu-029-huili-complete:p002:m0069"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-029-huili-complete:p002","text":"二年，侯景圍京邑，會理治嚴將入援，會北徐州刺史封山侯正表將應其兄正德，外託赴援，實謀襲廣陵，會理擊破之。方得進路，臺城陷，侯景遣前臨江太守董紹先以高祖手敕召會理，其僚佐咸勸距之。會理曰：「諸君心事，與我不同，天子年尊，受制賊虜，今有手敕召我入朝，臣子之心，豈得違背。且遠處江北，功業難成，不若身赴京都，圖之肘腋。吾計決矣。」遂席捲而行，以城輸紹先。至京，景以爲侍中、司空、兼中書令。雖在寇手，每思匡復，與西鄉侯勸等潛布腹心，要結壯士。時范陽祖皓斬紹先，據廣陵城起義，期以會理爲內應。皓敗，辭相連及，景矯詔免會理官，猶以白衣領尚書令。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":19,"last_line":19,"raw_start":915,"raw_end":1181,"raw_character_offsets":[915,916,917,918,919,920,921,922,923,924,925,926,927,928,929,930,931,932,933,934,935,936,937,938,939,940,941,942,943,944,945,946,947,948,949,950,951,952,953,954,955,956,957,958,959,960,961,962,963,964,965,966,967,968,969,970,971,972,973,974,975,976,977,978,979,980,981,982,983,984,985,986,987,988,989,990,991,992,993,994,995,996,997,998,999,1000,1001,1002,1003,1004,1005,1006,1007,1008,1009,1010,1011,1012,1013,1014,1015,1016,1017,1018,1019,1020,1021,1022,1023,1024,1