ance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-052","chapter_id":"c-sanguozhi-052-gushao-complete","source_id":"s-sanguozhi-052-gushao-complete","paragraph_id":"c-sanguozhi-052-gushao-complete:line048","quote":"邵字孝則，博覽書傳，好樂人倫。少與舅陸績齊名，而陸遜、張敦、卜靜等皆亞焉。自州郡庶幾及四方人士，往來相見，或言議而去，或結厚而別，風聲流聞，遠近稱之。權妻以策女。年二十七，起家爲豫章太守。下車祀先賢徐孺子之墓。優待其後。禁其淫祀非禮之祭者。小吏資質佳者，輒令就學，擇其先進，擢置右職，舉善以教，風化大行。初，錢唐丁諝出於役伍，陽羨張秉生於庶民。烏程呉粲、雲陽殷禮起乎微賤，邵皆拔而友之，爲立聲譽。秉遭大喪，親爲制服結絰。邵當之豫章，發在近路，值秉疾病，時送者百數。邵辭賓客曰：\"張仲節有疾，苦不能來別，恨不見之，暫還與訣，諸君少時相待。\"其留心下士，惟善所在，皆此類也。諝至典軍中郎，秉雲陽太守，禮零陵太守，粲太子少傅。世以邵爲知人。在郡五年，卒官，子譚、承雲。","source_term":"子譚、承雲"}],"source_assertion_id":"a-wu052-gu-shao-cheng","interpretation_note":"本來源明記世代。後綴只供識別。","reviewer":"Codex（AI 代理）","parent_person_id":"syc_ik6_bq5_**AA"}}],"source_mention_summary":[{"source_id":"s-sanguozhi-057-zhangwen","work_id":"w-sanguozhi","book_id":"b-sanguozhi-057","chapter_id":"c-sanguozhi-057-zhangwen","raw_mention_count":1,"mention_ids":["c-sanguozhi-057-zhangwen:line058-pei01-03:m0031"],"paragraph_ids":["c-sanguozhi-057-zhangwen:line058-pei01-03"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-sanguozhi-057-zhangwen:line058-pei01-03:m0031","mention_ids":["c-sanguozhi-057-zhangwen:line058-pei01-03:m0031"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-sanguozhi-057-zhangwen"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-sanguozhi-057-zhangwen:line058-pei01-03:reading-000-071","kind":"annotation_sentence","paragraph_id":"c-sanguozhi-057-zhangwen:line058-pei01-03","start_codepoint":0,"end_codepoint":71,"source_quote":"《文士传》曰：温姊妹三人皆有节行，为温事，已嫁者皆见录夺。其中妹先適顾承，官以许嫁丁氏，成婚有日，遂饮药而死。吴朝嘉叹，乡人图画，为之赞颂云。","person_id":"qcl_3n3_fbn","related_person_ids":["xuu_do0_zbf","syc_ik6_bq5_**AAB","340_4sm_9ft"],"reading":"裴引文士傳記三姊妹，詳記先嫁顧承的妹妹。官許嫁丁氏，未成婚而死。","chapter_id":"c-sanguozhi-057-zhangwen","source_id":"s-sanguozhi-057-zhangwen"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-wu057-zhangwen-3","subject_person_id":"qcl_3n3_fbn","object_person_id":"syc_ik6_bq5_**AAB","predicate":"spouse","qualifiers":{"source_term":"妹先適顾承"},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-057","chapter_id":"c-sanguozhi-057-zhangwen","source_id":"s-sanguozhi-057-zhangwen","paragraph_id":"c-sanguozhi-057-zhangwen:line058-pei01-03","quote":"《文士传》曰：温姊妹三人皆有节行，为温事，已嫁者皆见录夺。其中妹先適顾承，官以许嫁丁氏，成婚有日，遂饮药而死。吴朝嘉叹，乡人图画，为之赞颂云。","subject_person_mention_id":"c-sanguozhi-057-zhangwen:line058-pei01-03:m0031","object_person_mention_id":"c-sanguozhi-057-zhangwen:line058-pei01-03:m0034"}],"interpretation_note":"以此來源所述兩端為據。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-wu057-zhangwen3","person_id":"qcl_3n3_fbn","event_type":"death","source_term":"遂饮药而死","date_expression":null,"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-057","chapter_id":"c-sanguozhi-057-zhangwen","source_id":"s-sanguozhi-057-zhangwen","paragraph_id":"c-sanguozhi-057-zhangwen:line058-pei01-03","quote":"《文士传》曰：温姊妹三人皆有节行，为温事，已嫁者皆见录夺。其中妹先適顾承，官以许嫁丁氏，成婚有日，遂饮药而死。吴朝嘉叹，乡人图画，为之赞颂云。","person_mention_id":"c-sanguozhi-057-zhangwen:line058-pei01-03:m0031"}