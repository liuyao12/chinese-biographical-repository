司請逮治衡山王。天子不許，為置吏二百石以上。衡山王以此恚，與奚慈、張廣昌謀，求能為兵法候星氣者，日夜從容王密謀反事。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-118-huainan:m026-0005","start":5,"end":8,"surface":"衡山王","kind":"person","person_id":"yqp_nlb_p1p_AFC","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m026-0014","start":14,"end":16,"surface":"衛慶","kind":"person","person_id":"ygk_y1u_niv","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m026-0024","start":24,"end":26,"surface":"天子","kind":"person","person_id":"nds_eog_ibo","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m026-0032","start":32,"end":33,"surface":"慶","kind":"person","person_id":"ygk_y1u_niv","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m026-0041","start":41,"end":45,"surface":"衡山內史","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-118-huainan:m026-0060","start":60,"end":62,"surface":"內史","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-118-huainan:m026-0063","start":63,"end":65,"surface":"內史","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-118-huainan:m026-0092","start":92,"end":95,"surface":"衡山王","kind":"person","person_id":"yqp_nlb_p1p_AFC","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m026-0096","start":96,"end":98,"surface":"天子","kind":"person","person_id":"nds_eog_ibo","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m026-0110","start":110,"end":113,"surface":"衡山王","kind":"person","person_id":"yqp_nlb_p1p_AFC","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m026-0118","start":118,"end":120,"surface":"奚慈","kind":"person","person_id":"f5z_kgb_853","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m026-0121","start":121,"end":124,"surface":"張廣昌","kind":"person","person_id":"n28_twg_d1m","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m026-0127","start":127,"end":135,"surface":"能為兵法候星氣者","kind":"unr