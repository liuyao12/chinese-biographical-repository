n_id":"840_l2v_yep","relation":"migration_destination","place":{"source_name":"宋","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-038-song","source_id":"s-shiji-038-song","paragraph_id":"c-shiji-038-song:p046","quote":"四年春，（鄭）［楚］命（楚）［鄭］伐宋。宋使華元將，鄭敗宋，囚華元。華元之將戰，殺羊以食士，其御羊羹不及，故怨，馳入鄭軍，故宋師敗，得囚華元。宋以兵車百乘文馬四百匹贖華元。未盡入，華元亡歸宋。","person_mention_id":"c-shiji-038-song:m046-0022"}],"source_term":"華元亡歸宋","interpretation_note":"被囚後逃歸目的地，非死亡。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji038-090","person_id":"840_l2v_yep","surfaces":["大夫華元","華元"],"scope":"same_chapter","chapter_ids":["c-shiji-038-song"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-038-song:p044","quote":"九年，昭公无道，國人不附。昭公弟鮑革賢而下士。先，襄公夫人欲通於公子鮑，不可，乃助之施於國，因大夫華元爲右師。昭公出獵，夫人王姬使衛伯攻殺昭公杵臼。弟鮑革立，是爲文公。"},{"paragraph_id":"c-shiji-038-song:p046","quote":"四年春，（鄭）［楚］命（楚）［鄭］伐宋。宋使華元將，鄭敗宋，囚華元。華元之將戰，殺羊以食士，其御羊羹不及，故怨，馳入鄭軍，故宋師敗，得囚華元。宋以兵車百乘文馬四百匹贖華元。未盡入，華元亡歸宋。"},{"paragraph_id":"c-shiji-038-song:p048","quote":"十六年，楚使過宋，宋有歬仇，執楚使。九月，楚莊王圍宋。十七年，楚以圍宋五月不解，宋城中急，无食，華元乃夜私見楚將子反。子反告莊王。王問：「城中何如？」曰：「析骨而炊，易子而食。」莊王曰：「誠哉言！我軍亦有二日糧。」以信故，遂罷兵去。"},{"paragraph_id":"c-shiji-038-song:p049","quote":"二十二年，文公卒，子共公瑕立。始厚葬。君子譏華元不臣矣。"},{"paragraph_id":"c-shiji-038-song:p050","quote":"共公十年，華元善楚將子重，又善晉將欒書，兩盟晉楚。十三年，共公卒。華元爲右師，魚石爲左師。司馬唐山攻殺太子肥，欲殺華元，華元犇晉，魚石止之，至河乃還，誅唐山。乃立共公少子戌，是爲平公。"}],"rationale":"按本篇明示名與稱號、宋國世系及具體事件暫同指；未把同字短名全域合併，所有引句與未定處保留。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji040-177","person_id":"840_l2v_yep","surfaces":["宋華元"],"scope":"cross_chapter","chapter_ids":["c-shiji-038-song","c-shiji-040-chu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-038-song:p048","quote":"十六年，楚使過宋，宋有歬仇，執楚使。九月，楚莊王圍宋。十七年，楚以圍宋五月不解，宋城中急，无食，華元乃夜私見楚將子反。子反告莊王。王問：「城中何如？」曰：「析骨而炊，易子而食。」莊王曰：「誠哉言！我軍亦有二日糧。」以信故，遂罷兵去。"},{"paragraph_id":"c-shiji-040-chu:p025","quote":"二十年，圍宋，以殺楚使也。圍宋五月，城中食盡，易子而食，析骨而炊。宋華元出告以情。莊王曰：「君子哉！」遂罷兵去。二十三年，莊王卒，子共王審立。"}],"rationale":"楚篇圍宋五月、析骨而炊易子而食、華元告情而罷兵，與宋篇華元見子反、子反告莊王後罷兵的事件暫同指；兩篇對話層次各自保留。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji042-069","person_id":"840_l2v_yep","scope":"same_chapter","chapter_ids":["c-shiji-042-zheng"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["元","宋華元","華元"],"evidence":[{"paragraph_id":"c-shiji-042-zheng:p024","quote":"往年楚太子商臣弒其父成王代立。二十一年，與宋華元伐鄭。華元殺羊食士，不與其御羊斟，怒以馳鄭，鄭囚華元。宋贖華元，元亦亡去。晉使趙穿以兵伐鄭。"},{"paragraph_id":"c-shiji-042-zheng:p027","quote":"襄公元年，楚怒鄭受宋賂縱華元，伐鄭。鄭背楚，與晉親。五年，楚復伐鄭，晉來救之。六年，子家卒，國人復逐其族，以其弒靈公也。"}],"rationale":"依本篇名字、是為、世系及連續事件暫接異稱；同諡不同國分開，建子勝與聲公勝不合併，如兄弟為譬喻不作親屬。述贊與正文不算獨立來源，省稱、古字與校勘仍待核。"}],"equivalence_decisions":[{"id":"eq-shiji042-huayuan","person_ids":["840_l2v_yep"],"canonical_person_id":"840_l2v_yep","scope":"cross_chapter","chapter_ids":["c-shiji-038-song","c-shiji-042-zheng"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-038-song","source_id":"s-shiji-038-song","paragraph_id":"c-shiji-038-song:p046","quote":"四年春，（鄭）［楚］命（楚）［鄭］伐宋。宋使華元將，鄭敗宋，囚華元。華元之將戰，殺羊以食士，其御羊羹不及，故怨，馳入鄭軍，故宋師敗，得囚華元。宋以兵車百乘文馬四百匹贖華元。未盡入，華元亡歸宋。","mention_ids":["c-shiji-038-song:m046-0022","c-shiji-038-song:m046-0031","c-shiji-038-song:m046-0034","c-shiji-038-song:m046-0068","c-shiji-038-song:m046-0083","c-shiji-038-song:m046-0090"]},{"chapter_id":"c-shiji-042-zheng","source_id":"s-shiji-042-zheng","paragraph_id":"c-shiji-042-zheng:p024","quote":"往年楚太子商臣弒其父成王代立。二十一年，與宋華元伐鄭。華元殺羊食士，不與其御羊斟，怒以馳鄭，鄭囚華元。宋贖華元，元亦亡去。晉使趙穿以兵伐鄭。","mention_ids":["c-shiji-042-zheng:m024-0021","c-shiji-042-zheng:m024-0027","c-shiji-042-zheng:m024-0048","c-shiji-042-zheng:m024-0053","c-shiji-042-zheng:m024-0056"]}],"rationale":"同記華元分羊未及御者、御者馳鄭而華元被囚、宋贖而華元亡歸的同一事件，暫同指；羊羹／羊斟讀法未解，不合併御者候選。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true}],"passages":[{"id":"c-jinshu-034-yanghu:p013","text":"祜與陸抗相對，使命交通，抗稱祜之德量，雖樂毅、諸葛孔明不能過也。抗嘗病，祜饋之藥，抗服之無疑心。人多諫抗，抗曰：「羊祜豈鴆人者！」時談以為華元、子反復見於今日。抗每告其戍曰：「彼專為德，我專為暴，是不戰而自服也。各保分界而已，無求細利。」孫皓聞二境交和，以詰抗。抗曰：「一邑一鄉，不可以無信義，況大國乎！臣不如此，正是彰其德，於祜無傷也。」","text_layer":"received_chapter","source_position":{"raw_start":2250,"raw_end":2422,"raw_character_offsets":[2252,2253,2254,2255,2256,2257,2258,2259,2260,2261,2262,2263,2264,2265,2266,2267,2268,2269,2270,2271,2272,2273,2274,2275,2276,2277,2278,2279,2280,2281,2282,2283,2284,2285,2286,2287,2288,2289,2290,2291,2292,2293,2294,2295,2296,2297,2298,2299,2300,2301,2302,2303,2304,2305,2306,2307,2308,2309,2310,2311,2312,2313,2314,2315,2316,2317,2318,2319,2320,2321,2322,2323,2324,2325,2326,2327,2328,2329,2330,2331,2332,2333,2334,2335,2336,2337,2338,2339,2340,2341,2342,2343,2344,2345,2346,2347,2348,2349,2350,2351,2352,2353,2354,2355,2356,2357,2358,2359,2360,2361,2362,2363,2364,2365,2366,2367,2368,2369,2370,2371,2372,2373,2374,2375,2376,2377,2378,2379,2380,2381,2382,2383,2384,2385,2386,2387,2388,2389,2390,2391,2392,2393,2394,2395,2396,2397,2398,2399,2400,2401,2402,2403,2404,2405,2406,2407,2408,2409,2410,2411,2412,2413,2414,2415,2416,2417,2418,2419,2420,2421],"first_line":34,"last_line":34,"revision_id":2567662,"projection_sha256":"c9a62acdfaeae945c60fde07055b39060188f1602fd0abe0bacd2764b2ccb0d8","source_layer":"received_biography","editorial_subsection":" [[作者:羊祜|羊祜]] ","quotation_block_markup":false},"mentions":[{"id":"c-jinshu-034-yanghu:p013:m0000","start":0,"end":1,"surface":"祜","kind":"person","person_id":"dqd_5q9_pkz_BD","status":"contextual"},{"id":"c-jinshu-034-yanghu:p013:m0002","start":2,"end":4,"surface":"陸抗","kind":"person","person_id":"sg1_98i_aw9","status":"source_explicit"},{"id":"c-jinshu-034-yanghu:p013:m0012","start":12,"end":13,"surface":"抗","kind":"person","person_id":"sg1_98i_aw9","status":"contextual"},{"id":"c-jinshu-034-yanghu:p013:m0014","start":14,"end":15,"surface":"祜","kind":"person","person_id":"dqd_5q9_pkz_BD","status":"contextual"},{"id":"c-jinshu-034-yanghu:p013:m0020","start":20,"end":22,"surface":"樂毅","kind":"person","person_id":"gz0_xuu_ont","status":"source_explicit"},{"id":"c-jinshu-034-yanghu:p013:m0023","start":23,"end":27,"surface":"諸葛孔明","kind":"person","person_id":"11e_f2d_5d2","status":"source_explicit"},{"id":"c-jinshu-034-yanghu:p013:m0032","start":32,"end":33,"surface":"抗","kind":"person","person_id":"sg1_98i_aw9","status":"contextual"},{"id":"c-jinshu-034-yanghu:p013:m0036","start":36,"end":37,"surface":"祜","kind":"person","person_id":"dqd_5q9_pkz_BD","status":"contextual"},{"id":"c-jinshu-034-yanghu:p013:m0041","start":41,"end":42,"surface":"抗","kind":"person","person_id":"sg1_98i_aw9","status":"contextual"},{"id":"c-jinshu-034-yanghu:p013:m0051","start":51,"end":52,"surface":"抗","kind":"person","person_id":"sg1_98i_aw9","status":"contextual"},{"id":"c-jinshu-034-yanghu:p013:m0053","start":53,"end":54,"surface":"抗","kind":"person","person_id":"sg1_98i_aw9","status":"contextual"},{"id":"c-jinshu-034-yanghu:p013:m0057","start":57,"end":59,"surface":"羊祜","kind":"person","person_id":"dqd_5q9_pkz_BD","status":"source_explicit"},{"id":"c-jinshu-034-yanghu:p013:m0069","start":69,"end":71,"surface":"華元","kind":"person","person_id":"840_l2v_yep","status":"source_explicit"},{"id":"c-jinshu-034-yanghu:p013:m0072","start":72,"end":74,"surface":"子反","kind":"person","person_id":"4bx_elr_66i","status":"source_explicit"},{"id":"c-jinshu-034-yanghu:p013:m0080","start":80,"end":81,"surface":"抗","kind":"person","person_id":"sg1_98i_aw9","status":"contextual"},{"id":"c-jinshu-034-yanghu:p013:m0119","start":119,"end":121,"surface":"孫皓","kind":"person","person_id":"05e_9bb_55a","status":"source_explicit"},{"id":"c-jinshu-034-yanghu:p013:m0129","start":129,"end":130,"surface":"抗","kind":"person","person_id":"sg1_98i_aw9","status":"contextual"},{"id":"c-jinshu-034-yanghu:p013:m0131","start":131,"end":132,"surface":"抗","kind":"person","person_id":"sg1_98i_aw9","status":"contextual"},{"id":"c-jinshu-034-yanghu:p013:m0164","start":164,"end":165,"surface":"祜","kind":"person","person_id":"dqd_5q9_pkz_BD","status":"contextual"}],"chapter_id":"c-jinshu-034-yanghu","book_id":"b-jinshu-034","work_id":"w-jinshu","source_id":"s-jinshu-034-ws2567662-yanghu"},{"id":"c-shiji-038-song:p044","text":"九年，昭公无道，國人不附。昭公弟鮑革賢而下士。先，襄公夫人欲通於公子鮑，不可，乃助之施於國，因大夫華元爲右師。昭公出獵，夫人王姬使衛伯攻殺昭公杵臼。弟鮑革立，是爲文公。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-038-song:m044-0003","start":3,"end":5,"surface":"昭公","kind":"person","person_id":"l3c_zg4_f7z_AA","status":"contextual_provisional"},{"id":"c-shiji-038-song:m044-0013","start":13,"end":15,"surface":"昭公","kind":"person","person_id":"l3c_zg4_f7z_AA","status":"contextual_provisional"},{"id":"c-shiji-038-song:m044-0016","start":16,"end":18,"surface":"鮑革","kind":"person","person_id":"rex_cs0_mfo","status":"contextual_provisional"},{"id":"c-shiji-038-song:m044-0025","start":25,"end":27,"surface":"襄公","kind":"person","person_id":"l3c_zg4_f7z","status":"contextual_provisional"},{"id":"c-shiji-038-song:m044-0027","start":27,"end":29,"surface":"夫人","kind":"person","person_id":"tmi_4aq_99e","status":"contextual_provisional"},{"id":"c-shiji-038-song:m044-0032","start":32,"end":35,"surface":"公子鮑","kind":"person","person_id":"rex_cs0_mfo","status":"contextual_provisional"},{"id":"c-shiji-038-song:m044-0047","start":47,"end":51,"surface":"大夫華元","kind":"person","person_id":"840_l2v_yep","status":"contextual_provisional"},{"id":"c-shiji-038-song:m044-0055","start":55,"end":57,"surface":"昭公","kind":"person","person_id":"l3c_zg4_f7z_AA","status":"contextual_provisional"},{"id":"c-shiji-038-song:m044-0060","start":60,"end":64,"surface":"夫人王姬","kind":"person","person_id":"tmi_4aq_99e","status":"contextual_provisional"},{"id":"c-shiji-038-song:m044-0065","start":65,"end":67,"surface":"衛伯","kind":"person","person_id":"2aw_0yj_oei","status":"contextual_provisional"},{"id":"c-shiji-038-song:m044-0069","start":69,"end":73,"surface":"昭公杵臼","kind":"person","person_id":"l3c_zg4_f7z_AA","status":"contextual_provisional"},{"id":"c-shiji-038-song:m044-0075","start":75,"end":77,"surface":"鮑革","kind":"person","person_id":"rex_cs0_mfo","status":"contextual_provisional"},{"id":"c-shiji-038-song:m044-0081","start":81,"end":83,"surface":"文公","kind":"person","person_id":"rex_cs0_mfo","status":"contextual_provisional"}],"chapter_id":"c-shiji-038-song","book_id":"b-shiji-038","work_id":"w-shiji","source_id":"s-shiji-038-song"},{"id":"c-shiji-038-song:p046","text":"四年春，（鄭）［楚］命（楚）［鄭］伐宋。宋使華元將，鄭敗宋，囚華元。華元之將戰，殺羊以食士，其御羊羹不及，故怨，馳入鄭軍，故宋師敗，得囚華元。宋以兵車百乘文馬四百匹贖華元。未盡入，華元亡歸宋。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-038-song:m046-0022","start":22,"end":24,"surface":"華元","kind":"person","person_id":"840_l2v_yep","status":"contextual_provisional"},{"id":"c-shiji-038-song:m046-0031","start":31,"end":33,"surface":"華元","kind":"person","person_id":"840_l2v_yep","status":"contextual_provisional"},{"id":"c-shiji-038-song:m046-0034","start":34,"end":36,"surface":"華元","kind":"person","person_id":"840_l2v_yep","status":"contextual_provisional"},{"id":"c-shiji-038-song:m046-0044","start":44,"end":45,"surface":"士","kind":"unresolved","person_id":null,"status":"unresolved","note":"泛稱、政制、群體、神異、匿名者或未定指代；不補未見人名、闕代、制度爵等或成員。"},{"id":"c-shiji-038-song:m046-0048","start":48,"end":50,"surface":"羊羹","kind":"person","person_id":"nu2_ttq_hq0","status":"contextual_provisional"},{"id":"c-shiji-038-song:m046-0068","start":68,"end":70,"surface":"華元","kind":"person","person_id":"840_l2v_yep","status":"contextual_provisional"},{"id":"c-shiji-038-song:m046-0083","start":83,"end":85,"surface":"華元","kind":"person","person_id":"840_l2v_yep","status":"contextual_provisional"},{"id":"c-shiji-038-song:m046-0090","start":90,"end":92,"surface":"華元","kind":"person","person_id":"840_l2v_yep","status":"contextual_provisional"}],"chapter_id":"c-shiji-038-song","book_id":"b-shiji-038","work_id":"w-shiji","source_id":"s-shiji-038-song"},{"id":"c-shiji-038-song:p048","text":"十六年，楚使過宋，宋有歬仇，執楚使。九月，楚莊王圍宋。十七年，楚以圍宋五月不解，宋城中急，无食，華元乃夜私見楚將子反。子反告莊王。王問：「城中何如？」曰：「析骨而炊，易子而食。」莊王曰：「誠哉言！我軍亦有二日糧。」以信故，遂罷兵去。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-038-song:m048-0004","start":4,"end":6,"surface":"楚使","kind":"unresolved","person_id":null,"status":"unresolved","note":"泛稱、政制、群體、神異、匿名者或未定指代；不補未見人名、闕代、制度爵等或成員。"},{"id":"c-shiji-038-song:m048-0015","start":15,"end":17,"surface":"楚使","kind":"unresolved","person_id":null,"status":"unresolved","note":"泛稱、政制、群體、神異、匿名者或未定指代；不補未見人名、闕代、制度爵等或成員。"},{"id":"c-shiji-038-song:m048-0021","start":21,"end":24,"surface":"楚莊王","kind":"person","person_id":"q8m_d0c_kq3","status":"contextual_provisional"},{"id":"c-shiji-038-song:m048-0048","start":48,"end":50,"surface":"華元","kind":"person","person_id":"840_l2v_yep","status":"contextual_provisional"},{"id":"c-shiji-038-song:m048-0054","start":54,"end":58,"surface":"楚將子反","kind":"person","person_id":"4bx_elr_66i","status":"contextual_provisional"},{"id":"c-shiji-038-song:m048-0059","start":59,"end":61,"surface":"子反","kind":"person","person_id":"4bx_elr_66i","status":"contextual_provisional"},{"id":"c-shiji-038-song:m048-0062","start":62,"end":64,"surface":"莊王","kind":"person","person_id":"q8m_d0c_kq3","status":"contextual_provisional"},{"id":"c-shiji-038-song:m048-0078","start":78,"end":82,"surface":"析骨而炊","kind":"unresolved","person_id":null,"status":"unresolved","note":"泛稱、政制、群體、神異、匿名者或未定指代；不補未見人名、闕代、制度爵等或成員。"},{"id":"c-shiji-038-song:m048-0083","start":83,"end":87,"surface":"易子而食","kind":"unresolved","person_id":null,"status":"unresolved","note":"泛稱、政制、群體、神異、匿名者或未定指代；不補未見人名、闕代、制度爵等或成員。"},{"id":"c-shiji-038-song:m048-0089","start":89,"end":91,"surface":"莊王","kind":"person","person_id":"q8m_d0c_kq3","status":"contextual_provisional"}],"chapter_id":"c-shiji-038-song","book_id":"b-shiji-038","work_id":"w-shiji","source_id":"s-shiji-038-song"},{"id":"c-shiji-038-song:p049","text":"二十二年，文公卒，子共公瑕立。始厚葬。君子譏華元不臣矣。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-038-song:m049-0005","start":5,"end":7,"surface":"文公","kind":"person","person_id":"rex_cs0_mfo","status":"contextual_provisional"},{"id":"c-shiji-038-song:m049-0010","start":10,"end":13,"surface":"共公瑕","kind":"person","person_id":"rex_cs0_mfo_A","status":"contextual_provisional"},{"id":"c-shiji-038-song:m049-0022","start":22,"end":24,"surface":"華元","kind":"person","person_id":"840_l2v_yep","status":"contextual_provisional"}],"chapter_id":"c-shiji-038-song","book_id":"b-shiji-038","work_id":"w-shiji","source_id":"s-shiji-038-song"},{"id":"c-shiji-038-song:p050","text":"共公十年，華元善楚將子重，又善晉將欒書，兩盟晉楚。十三年，共公卒。華元爲右師，魚石爲左師。司馬唐山攻殺太子肥，欲殺華元，華元犇晉，魚石止之，至河乃還，誅唐山。乃立共公少子戌，是爲平公。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-038-song:m050-0000","start":0,"end":2,"surface":"共公","kind":"person","person_id":"rex_cs0_mfo_A","status":"contextual_provisional"},{"id":"c-shiji-038-song:m050-0005","start":5,"end":7,"surface":"華元","kind":"person","person_id":"840_l2v_yep","status":"contextual_provisional"},{"id":"c-shiji-038-song:m050-0008","start":8,"end":12,"surface":"楚將子重","kind":"person","person_id":"5lh_q1k_9qg","status":"contextual_provisional"},{"id":"c-shiji-038-song:m050-0015","start":15,"end":19,"surface":"晉將欒書","kind":"person","person_id":"c8b_f8t_ylf","status":"contextual_provisional"},{"id":"c-shiji-038-song:m050-0029","start":29,"end":31,"surface":"共公","kind":"person","person_id":"rex_cs0_mfo_A","status":"contextual_provisional"},{"id":"c-shiji-038-song:m050-0033","start":33,"end":35,"surface":"華元","kind":"person","person_id":"840_l2v_yep","status":"contextual_provisional"},{"id":"c-shiji-038-song:m050-0039","start":39,"end":41,"surface":"魚石","kind":"person","person_id":"z2t_a1a_pjw","status":"contextual_provisional"},{"id":"c-shiji-038-song:m050-0045","start":45,"end":49,"surface":"司馬唐山","kind":"person","person_id":"95o_n0j_io3","status":"contextual_provisional"},{"id":"c-shiji-038-song:m050-0051","start":51,"end":54,"surface":"太子肥","kind":"person","person_id":"zir_4c6_exy","status":"contextual_provisional"},{"id":"c-shiji-038-song:m050-0057","start":57,"end":59,"surface":"華元","kind":"person","person_id":"840_l2v_yep","status":"contextual_provisional"},{"id":"c-shiji-038-song:m050-0060","start":60,"end":62,"surface":"華元","kind":"person","person_id":"840_l2v_yep","status":"contextual_provisional"},{"id":"c-shiji-038-song:m050-0065","start":65,"end":67,"surface":"魚石","kind":"person","person_id":"z2t_a1a_pjw","status":"contextual_provisional"},{"id":"c-shiji-038-song:m050-0076","start":76,"end":78,"surface":"唐山","kind":"person","person_id":"95o_n0j_io3","status":"contextual_provisional"},{"id":"c-shiji-038-song:m050-0081","start":81,"end":83,"surface":"共公","kind":"person","person_id":"rex_cs0_mfo_A","status":"contextual_provisional"},{"id":"c-shiji-038-song:m050-0085","start":85,"end":86,"surface":"戌","kind":"person","person_id":"rex_cs0_mfo_AA","status":"contextual_provisional"},{"id":"c-shiji-038-song:m050-0089","start":89,"end":91,"surface":"平公","kind":"person","person_id":"rex_cs0_mfo_AA","status":"contextual_provisional"}],"chapter_id":"c-shiji-038-song","book_id":"b-shiji-038","work_id":"w-shiji","source_id":"s-shiji-038-song"},{"id":"c-shiji-040-chu:p025","text":"二十年，圍宋，以殺楚使也。圍宋五月，城中食盡，易子而食，析骨而炊。宋華元出告以情。莊王曰：「君子哉！」遂罷兵去。二十三年，莊王卒，子共王審立。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m025-0009","start":9,"end":11,"surface":"楚使","kind":"unresolved","person_id":null,"status":"unresolved","note":"因殺楚使而圍宋的未名使者，待與宋篇核對，不補姓名。"},{"id":"c-shiji-040-chu:m025-0033","start":33,"end":36,"surface":"宋華元","kind":"person","person_id":"840_l2v_yep","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m025-0041","start":41,"end":43,"surface":"莊王","kind":"person","person_id":"q8m_d0c_kq3","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m025-0061","start":61,"end":63,"surface":"莊王","kind":"person","person_id":"q8m_d0c_kq3","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m025-0066","start":66,"end":69,"surface":"共王審","kind":"person","person_id":"q8m_d0c_kq3_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-040-chu","book_id":"b-shiji-040","work_id":"w-shiji","source_id":"s-shiji-040-chu"},{"id":"c-shiji-042-zheng:p024","text":"往年楚太子商臣弒其父成王代立。二十一年，與宋華元伐鄭。華元殺羊食士，不與其御羊斟，怒以馳鄭，鄭囚華元。宋贖華元，元亦亡去。晉使趙穿以兵伐鄭。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-042-zheng:m024-0002","start":2,"end":7,"surface":"楚太子商臣","kind":"person","person_id":"jru_oiq_x0q_A","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m024-0010","start":10,"end":12,"surface":"成王","kind":"person","person_id":"jru_oiq_x0q","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m024-0021","start":21,"end":24,"surface":"宋華元","kind":"person","person_id":"840_l2v_yep","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m024-0027","start":27,"end":29,"surface":"華元","kind":"person","person_id":"840_l2v_yep","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m024-0038","start":38,"end":40,"surface":"羊斟","kind":"person","person_id":"9w2_rfm_964","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m024-0048","start":48,"end":50,"surface":"華元","kind":"person","person_id":"840_l2v_yep","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m024-0053","start":53,"end":55,"surface":"華元","kind":"person","person_id":"840_l2v_yep","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m024-0056","start":56,"end":57,"surface":"元","kind":"person","person_id":"840_l2v_yep","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m024-0063","start":63,"end":65,"surface":"趙穿","kind":"person","person_id":"mfu_22v_exx","status":"contextual_provisional"}],"chapter_id":"c-shiji-042-zheng","book_id":"b-shiji-042","work_id":"w-shiji","source_id":"s-shiji-042-zheng"},{"id":"c-shiji-042-zheng:p027","text":"襄公元年，楚怒鄭受宋賂縱華元，伐鄭。鄭背楚，與晉親。五年，楚復伐鄭，晉來救之。六年，子家卒，國人復逐其族，以其弒靈公也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-042-zheng:m027-0000","start":0,"end":2,"surface":"襄公","kind":"person","person_id":"9oa_4bh_lmd","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m027-0002","start":2,"end":3,"surface":"元","kind":"person","person_id":"840_l2v_yep","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m027-0012","start":12,"end":14,"surface":"華元","kind":"person","person_id":"840_l2v_yep","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m027-0042","start":42,"end":44,"surface":"子家","kind":"person","person_id":"16c_ysj_x0r","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m027-0056","start":56,"end":58,"surface":"靈公","kind":"person","person_id":"v64_zpv_387","status":"contextual_provisional"}],"chapter_id":"c-shiji-042-zheng","book_id":"b-shiji-042","work_id":"w-shiji","source_id":"s-shiji-042-zheng"}],"sources":[{"chapter_id":"c-jinshu-034-yanghu","work_id":"w-jinshu","book_id":"b-jinshu-034","source_id":"s-jinshu-034-ws2567662-yanghu","source":{"title":"《晉書》卷三十四羊祜完整本傳及家屬續敘","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=晉書/卷034&oldid=2567662","permalink":"https://zh.wikisource.org/w/index.php?title=晉書/卷034&oldid=2567662","revision_id":2567662,"accessed_on":"2026-10-22","extent":"羊祜節題至下一同級杜預節題前，41完整原行，含家屬、承嗣與引錄文書；非全卷，卷末共評未重複匯入。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文公版；維基文庫數位文字保來源歸屬並依CC BY-SA4.0。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":null,"raw_file":"sources/witnesses/jin034-ws2567662.wikitext","raw_path":"sources/witnesses/jin034-ws2567662.wikitext","wikitext_sha256":"0dc292f7743a95456ac8fa2977ba82bcaa35e1dd9cebe32fb2ecfab2f21f7a71","raw_file_sha256":"0dc292f7743a