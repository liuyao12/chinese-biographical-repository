"person","person_id":"mws_e02_g1o","status":"contextual_provisional","paragraph_id":"c-shiji-123-dayuan:p035","chapter_id":"c-shiji-123-dayuan"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-123-dayuan:p002","text":"張騫，漢中人。建元中為郎。是時天子問匈奴降者，皆言匈奴破月氏王，以其頭為飲器，月氏遁逃而常怨仇匈奴，無與共擊之。漢方欲事滅胡，聞此言，因欲通使。道必更匈奴中，乃募能使者。騫以郎應募，使月氏，與堂邑氏（故）胡奴甘父俱出隴西。經匈奴，匈奴得之，傳詣單于。單于留之，曰：「月氏在吾北，漢何以得往使？吾欲使越，漢肯聽我乎？」留騫十餘歲，與妻，有子，然騫持漢節不失。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-123-dayuan:m002-0000","start":0,"end":2,"surface":"張騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m002-0015","start":15,"end":17,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m002-0018","start":18,"end":22,"surface":"匈奴降者","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-123-dayuan:m002-0028","start":28,"end":31,"surface":"月氏王","kind":"person","person_id":"vgg_tso_418","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m002-0085","start":85,"end":86,"surface":"騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m002-0096","start":96,"end":99,"surface":"堂邑氏","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-123-dayuan:m002-0104","start":104,"end":106,"surface":"甘父","kind":"person","person_id":"sj0_vco_zfv","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m002-0122","start":122,"end":124,"surface":"單于","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-123-dayuan:m002-0125","start":125,"end":127,"surface":"單于","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-123-dayuan:m002-0159","start":159,"end":160,"surface":"騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m002-0165","start":165,"end":166,"surface":"妻","kind":"person","person_id":"bq1_qxf_lzp","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m002-0168","start":168,"end":169,"surface":"子","kind":"person","person_id":"gqj_xdu_8rf_A","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m002-0171","start":171,"end":172,"surface":"騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"}],"chapter_id":"c-shiji-123-dayuan","book_id":"b-shiji-123","work_id":"w-shiji","source_id":"s-shiji123-dayuan"},{"id":"c-shiji-123-dayuan:p006","text":"騫身所至者大宛、大月氏、大夏、康居，而傳聞其旁大國五六，具為天子言之。曰：","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-123-dayuan:m006-0000","start":0,"end":1,"surface":"騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m006-0030","start":30,"end":32,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"}],"chapter_id":"c-shiji-123-dayuan","book_id":"b-shiji-123","work_id":"w-shiji","source_id":"s-shiji123-dayuan"},{"id":"c-shiji-123-dayuan:p015","text":"騫曰：「臣在大夏時，見邛竹杖、蜀布。問曰：『安得此？』大夏國人曰：『吾賈人往市之身毒。身毒在大夏東南可數千里。其俗土著，大與大夏同，而卑溼暑熱云。其人民乘象以戰。其國臨大水焉。』以騫度之，大夏去漢萬二千里，居漢西南。今身毒國又居大夏東南數千里，有蜀物，此其去蜀不遠矣。今使大夏，從羌中，險，羌人惡之；少北，則為匈奴所得；從蜀宜徑，又無寇。」天子既聞大宛及大夏、安息之屬皆大國，多奇物，土著，頗與中國同業，而兵弱，貴漢財物；其北有大月氏、康居之屬，兵彊，可以賂遺設利朝也。且誠得而以義屬之，則廣地萬里，重九譯，致殊俗，威德遍於四海。天子欣然，以騫言為然，乃令騫因蜀犍為發閒使，四道并出：出駹，出冉，出徙，出邛、僰，皆各行一二千里。其北方閉氐、筰，南方閉巂、昆明。昆明之屬無君長，善寇盜，輒殺略漢使，終莫得通。然聞其西可千餘里有乘象國，名曰滇越，而蜀賈姦出物者或至焉，於是漢以求大夏道始通滇國。初，漢欲通西南夷，費多，道不通，罷之。及張騫言可以通大夏，乃復事西南夷。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-123-dayuan:m015-0000","start":0,"end":1,"surface":"騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m015-0027","start":27,"end":31,"surface":"大夏國人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-123-dayuan:m015-0034","start":34,"end":37,"surface":"吾賈人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-123-dayuan:m015-0090","start":90,"end":91,"surface":"騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m015-0170","start":170,"end":172,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m015-0265","start":265,"end":267,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m015-0271","start":271,"end":272,"surface":"騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m015-0278","start":278,"end":279,"surface":"騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m015-0415","start":415,"end":417,"surface":"張騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"}],"chapter_id":"c-shiji-123-dayuan","book_id":"b-shiji-123","work_id":"w-shiji","source_id":"s-shiji123-dayuan"},{"id":"c-shiji-123-dayuan:p017","text":"是後天子數問騫大夏之屬。騫既失侯，因言曰：「臣居匈奴中，聞烏孫王號昆莫，昆莫之父，匈奴西邊小國也。匈奴攻殺其父，而昆莫生棄於野。烏嗛肉蜚其上，狼往乳之。單于怪以為神，而收長之。及壯，使將兵，數有功，單于復以其父之民予昆莫，令長守於西（城）［域］。昆莫收養其民，攻旁小邑，控弦數萬，習攻戰。單于死，昆莫乃率其眾遠徙，中立，不肯朝會匈奴。匈奴遣奇兵擊，不勝，以為神而遠之，因羈屬之，不大攻。今單于新困於漢，而故渾邪地空無人。蠻夷俗貪漢財物，今誠以此時而厚幣賂烏孫，招以益東，居故渾邪之地，與漢結昆弟，其勢宜聽，聽則是斷匈奴右臂也。既連烏孫，自其西大夏之屬皆可招來而為外臣。」天子以為然，拜騫為中郎將，將三百人，馬各二匹，牛羊以萬數，齎金幣帛直數千巨萬，多持節副使，道可使，使遺之他旁國。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-123-dayuan:m017-0002","start":2,"end":4,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m017-0006","start":6,"end":7,"surface":"騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m017-0012","start":12,"end":13,"surface":"騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m017-0033","start":33,"end":35,"surface":"昆莫","kind":"person","person_id":"3jf_ce1_jy2_A","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m017-0036","start":36,"end":40,"surface":"昆莫之父","kind":"person","person_id":"3jf_ce1_jy2","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m017-0053","start":53,"end":55,"surface":"其父","kind":"person","person_id":"3jf_ce1_jy2","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m017-0057","start":57,"end":59,"surface":"昆莫","kind":"person","person_id":"3jf_ce1_jy2_A","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m017-0076","start":76,"end":78,"surface":"單于","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-123-dayuan:m017-0099","start":99,"end":101,"surface":"單于","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-123-dayuan:m017-0103","start":103,"end":105,"surface":"其父","kind":"person","person_id":"3jf_ce1_jy2","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m017-0108","start":108,"end":110,"surface":"昆莫","kind":"person","person_id":"3jf_ce1_jy2_A","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m017-0123","start":123,"end":125,"surface":"昆莫","kind":"person","person_id":"3jf_ce1_jy2_A","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m017-0144","start":144,"end":146,"surface":"單于","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-123-dayuan:m017-0148","start":148,"end":150,"surface":"昆莫","kind":"person","person_id":"3jf_ce1_jy2_A","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m017-0194","start":194,"end":196,"surface":"單于","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-123-dayuan:m017-0203","start":203,"end":205,"surface":"渾邪","kind":"person","person_id":"20n_l53_kkr","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m017-0237","start":237,"end":239,"surface":"渾邪","kind":"person","person_id":"20n_l53_kkr","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m017-0242","start":242,"end":247,"surface":"與漢結昆弟","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-123-dayuan:m017-0285","start":285,"end":287,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m017-0292","start":292,"end":293,"surface":"騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"}],"chapter_id":"c-shiji-123-dayuan","book_id":"b-shiji-123","work_id":"w-shiji","source_id":"s-shiji123-dayuan"},{"id":"c-shiji-123-dayuan:p018","text":"騫既至烏孫，烏孫王昆莫見漢使如單于禮，騫大慚，知蠻夷貪，乃曰：「天子致賜，王不拜則還賜。」昆莫起拜賜，其他如故。騫諭使指曰：「烏孫能東居渾邪地，則漢遣翁主為昆莫夫人。」烏孫國分，王老，而遠漢，未知其大小，素服屬匈奴日久矣，且又近之，其大臣皆畏胡，不欲移徙，王不能專制。騫不得其要領。昆莫有十餘子，其中子曰大祿，彊，善將眾，將眾別居萬餘騎。大祿兄為太子，太子有子曰岑娶，而太子蚤死。臨死謂其父昆莫曰：「必以岑娶為太子，無令他人代之。」昆莫哀而許之，卒以岑娶為太子。大祿怒其不得代太子也，乃收其諸昆弟，將其眾畔，謀攻岑娶及昆莫。昆莫老，常恐大祿殺岑娶，予岑娶萬餘騎別居，而昆莫有萬餘騎自備，國眾分為三，而其大總取羈屬昆莫，昆莫亦以此不敢專約於騫。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-123-dayuan:m018-0000","start":0,"end":1,"surface":"騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m018-0009","start":9,"end":11,"surface":"昆莫","kind":"person","person_id":"3jf_ce1_jy2_A","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m018-0015","start":15,"end":18,"surface":"單于禮","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-123-dayuan:m018-0019","start":19,"end":20,"surface":"騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m018-0032","start":32,"end":34,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m018-0045","start":45,"end":47,"surface":"昆莫","kind":"person","person_id":"3jf_ce1_jy2_A","status":"contextual_pro