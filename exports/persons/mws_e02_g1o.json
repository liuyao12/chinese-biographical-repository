atus":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m018-0275","start":275,"end":277,"surface":"岑娶","kind":"person","person_id":"3jf_ce1_jy2_ABA","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m018-0284","start":284,"end":286,"surface":"昆莫","kind":"person","person_id":"3jf_ce1_jy2_A","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m018-0306","start":306,"end":308,"surface":"昆莫","kind":"person","person_id":"3jf_ce1_jy2_A","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m018-0309","start":309,"end":311,"surface":"昆莫","kind":"person","person_id":"3jf_ce1_jy2_A","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m018-0319","start":319,"end":320,"surface":"騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"}],"chapter_id":"c-shiji-123-dayuan","book_id":"b-shiji-123","work_id":"w-shiji","source_id":"s-shiji123-dayuan"},{"id":"c-shiji-123-dayuan:p022","text":"自博望侯騫死後，匈奴聞漢通烏孫，怒，欲擊之。及漢使烏孫，若出其南，抵大宛、大月氏相屬，烏孫乃恐，使使獻馬，願得尚漢女翁主為昆弟。天子問群臣議計，皆曰「必先納聘，然後乃遣女」。初，天子發書易，云「神馬當從西北來」。得烏孫馬好，名曰「天馬」。及得大宛汗血馬，益壯，更名烏孫馬曰「西極」，名大宛馬曰「天馬」云。而漢始筑令居以西，初置酒泉郡以通西北國。因益發使抵安息、奄蔡、黎軒、條枝、身毒國。而天子好宛馬，使者相望於道。諸使外國一輩大者數百，少者百餘人，人所齎操大放博望侯時。其后益習而衰少焉。漢率一歲中使多者十餘，少者五六輩，遠者八九歲，近者數歲而反。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-123-dayuan:m022-0001","start":1,"end":4,"surface":"博望侯","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m022-0004","start":4,"end":5,"surface":"騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m022-0056","start":56,"end":60,"surface":"漢女翁主","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-123-dayuan:m022-0064","start":64,"end":66,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m022-0089","start":89,"end":91,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m022-0194","start":194,"end":196,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m022-0230","start":230,"end":233,"surface":"博望侯","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"}],"chapter_id":"c-shiji-123-dayuan","book_id":"b-shiji-123","work_id":"w-shiji","source_id":"s-shiji123-dayuan"},{"id":"c-shiji-123-dayuan:p024","text":"自博望侯開外國道以尊貴，其後從吏卒皆爭上書言外國奇怪利害，求使。天子為其絕遠，非人所樂往，聽其言，予節，募吏民毋問所從來，為具備人眾遣之，以廣其道。來還不能毋侵盜幣物，及使失指，天子為其習之，輒覆案致重罪，以激怒令贖，復求使。使端無窮，而輕犯法。其吏卒亦輒復盛推外國所有，言大者予節，言小者為副，故妄言無行之徒皆爭效之。其使皆貧人子，私縣官齎物，欲賤市以私其利外國。外國亦厭漢使人人有言輕重，度漢兵遠不能至，而禁其食物以苦漢使。漢使乏絕積怨，至相攻擊。而樓蘭、姑師小國耳，當空道，攻劫漢使王恢等尤甚。而匈奴奇兵時時遮擊使西國者。使者爭遍言外國災害，皆有城邑，兵弱易擊。於是天子以故遣從驃侯破奴將屬國騎及郡兵數萬，至匈河水，欲以擊胡，胡皆去。其明年，擊姑師，破奴與輕騎七百餘先至，虜樓蘭王，遂破姑師。因舉兵威以困烏孫、大宛之屬。還，封破奴為浞野侯。王恢數使，為樓蘭所苦，言天子，天子發兵令恢佐破奴擊破之，封恢為浩侯。於是酒泉列亭鄣至玉門矣。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-123-dayuan:m024-0001","start":1,"end":4,"surface":"博望侯","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m024-0032","start":32,"end":34,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m024-0089","start":89,"end":91,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m024-0244","start":244,"end":246,"surface":"王恢","kind":"person","person_id":"4qp_wu1_qhe","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m024-0286","start":286,"end":288,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m024-0294","start":294,"end":296,"surface":"破奴","kind":"person","person_id":"z0l_1wp_de1","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m024-0328","start":328,"end":330,"surface":"破奴","kind":"person","person_id":"z0l_1wp_de1","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m024-0340","start":340,"end":343,"surface":"樓蘭王","kind":"person","person_id":"lx3_ne1_5h4","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m024-0366","start":366,"end":368,"surface":"破奴","kind":"person","person_id":"z0l_1wp_de1","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m024-0373","start":373,"end":375,"surface":"王恢","kind":"person","person_id":"4qp_wu1_qhe","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m024-0385","start":385,"end":387,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m024-0388","start":388,"end":390,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m024-0393","start":393,"end":394,"surface":"恢","kind":"person","person_id":"4qp_wu1_qhe","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m024-0395","start":395,"end":397,"surface":"破奴","kind":"person","person_id":"z0l_1wp_de1","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m024-0402","start":402,"end":403,"surface":"恢","kind":"person","person_id":"4qp_wu1_qhe","status":"contextual_provisional"}],"chapter_id":"c-shiji-123-dayuan","book_id":"b-shiji-123","work_id":"w-shiji","source_id":"s-shiji123-dayuan"},{"id":"c-shiji-123-dayuan:p026","text":"初，漢使至安息，安息王令將二萬騎迎於東界。東界去王都數千里。行比至，過數十城，人民相屬甚多。漢使還，而後發使隨漢使來觀漢廣大，以大鳥卵及黎軒善眩人獻于漢。及宛西小國驩潛、大益，宛東姑師、扜穼、蘇薤之屬，皆隨漢使獻見天子，天子大悅；而漢使窮河源，河源出于窴，其山多玉石，采來，天子案古圖書，名河所出山曰崑崙云。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-123-dayuan:m026-0008","start":8,"end":11,"surface":"安息王","kind":"person","person_id":"jue_7li_s3h","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m026-0068","start":68,"end":73,"surface":"黎軒善眩人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-123-dayuan:m026-0107","start":107,"end":109,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m026-0110","start":110,"end":112,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m026-0137","start":137,"end":139,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"}],"chapter_id":"c-shiji-123-dayuan","book_id":"b-shiji-123","work_id":"w-shiji","source_id":"s-shiji123-dayuan"},{"id":"c-shiji-123-dayuan:p027","text":"是時上方數巡狩海上，乃悉從外國客，大都多人則過之，散財帛以賞賜，厚具以饒給之，以覽示漢富厚焉。於是大觳抵，出奇戲諸怪物，多聚觀者，行賞賜，酒池肉林，令外國客遍觀（名）［各］倉庫府藏之積，見漢之廣大，傾駭之。及加其眩者之工，而觳抵奇戲歲增變，甚盛益興，自此始。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-123-dayuan:m027-0002","start":2,"end":3,"surface":"上","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m027-0008","start":8,"end":9,"surface":"上","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m027-0013","start":13,"end":16,"surface":"外國客","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-123-dayuan:m027-0075","start":75,"end":78,"surface":"外國客","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-123-dayuan","book_id":"b-shiji-123","work_id":"w-shiji","source_id":"s-shiji123-dayuan"},{"id":"c-shiji-123-dayuan:p028","text":"西北外國使，更來更去。宛以西，皆自以遠，尚驕恣晏然，未可詘以禮羈縻而使也。自烏孫以西至安息，以近匈奴，匈奴困月氏也，匈奴使持單于一信，則國國傳送食，不敢留苦；及至漢使，非出幣帛不得食，不市畜不得騎用。所以然者，遠漢，而漢多財物，故必市乃得所欲，然以畏匈奴於漢使焉。宛左右以蒲陶為酒，富人藏酒至萬餘石，久者數十歲不敗。俗嗜酒，馬嗜苜蓿。漢使取其實來，於是天子始種苜蓿、蒲陶肥饒地。及天馬多，外國使來眾，則離宮別觀旁盡種蒲萄、苜蓿極望。自大宛以西至安息，國雖頗異言，然大同俗，相知言。其人皆深眼，多須髯，善市賈，爭分銖。俗貴女子，女子所言而丈夫乃決正。其地皆無絲漆，不知鑄錢器。及漢使亡卒降，教鑄作他兵器。得漢黃白金，輒以為器，不用為幣。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-123-dayuan:m028-0062","start":62,"end":64,"surface":"單于","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-123-dayuan:m028-0176","start":176,"end":178,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m028-0240","start":240,"end":242,"surface":"其人","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-123-dayuan","book_id":"b-shiji-123","work_id":"w-shiji","source_id":"s-shiji123-dayuan"},{"id":"c-shiji-123-dayuan:p029","text":"而漢使者往既多，其少從率多進熟於天子，言曰：「宛有善馬在貳師城，匿不肯與漢使。」天子既好宛馬，聞之甘心，使壯士車令等持千金及金馬以請宛王貳師城善馬。宛國饒漢物，相與謀曰：「漢去我遠，而鹽水中數敗，出其北有胡寇，出其南乏水草。又且往往而絕邑，乏食者多。漢使數百人為輩來，而常乏食，死者過半，是安能致大軍乎？無柰我何。且貳師馬，宛寶馬也。」遂不肯予漢使。漢使怒，妄言，椎金馬而去。宛貴人怒曰：「漢使至輕我！」遣漢使去，令其東邊郁成遮攻殺漢使，取其財物。於是天子大怒。諸嘗使宛姚定漢等言宛兵弱，誠以漢兵不過三千人，彊弩射之，即盡虜破宛矣。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-123-dayuan:m029-0016","start":16,"end":18,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m029-0040","start":40,"end":42,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m029-0055","start":55,"end":57,"surface":"車令","kind":"person","person_id":"l7y_ed2_wom","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m029-0066","start":66,"end":68,"surface":"宛王","kind":"person","person_id":"2l2_58b_q4i","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m029-0188","start":188,"end":191,"surface":"宛貴人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-123-dayuan:m029-0226","start":226,"end":228,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m029-0235","start":235,"end":238,"surface":"姚定漢","kind":"person","person_id":"pbn_4mh_7ix","status":"contextual_provisional"}],"chapter_id":"c-shiji-123-dayuan","book_id":"b-shiji-123","work_id":"w-shiji","source_id":"s-shiji123-dayuan"},{"id":"c-shiji-123-dayuan:p030","text":"天子已嘗使浞野侯攻樓蘭，以七百騎先至，虜其王，以定漢等言為然，而欲侯寵姬李氏，拜李廣利為貳師將軍，發屬國六千騎，及郡國惡少年數萬人，以往伐宛。期至貳師城取善馬，故號「貳師將軍」。趙始成為軍正，故浩侯王恢使導軍，而李哆為校尉，制軍事。是歲太初元年也。而關東蝗大起，蜚西至敦煌。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-123-dayuan:m030-0000","start":0,"end":2,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0005","start":5,"end":8,"surface":"浞野侯","kind":"person","person_id":"z0l_1wp_de1","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0020","start":20,"end":22,"surface":"其王","kind":"person","person_id":"lx3_ne1_5h4","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0024","start":24,"end":26,"surface":"定漢","kind":"person","person_id":"pbn_4mh_7ix","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0034","start":34,"end":38,"surface":"寵姬李氏","kind":"person","person_id":"z3p_px0_z7c","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0040","start":40,"end":43,"surface":"李廣利","kind":"person","person_id":"pez_8dn_r76","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0044","start":44,"end":48,"surface":"貳師將軍","kind":"person","person_id":"pez_8dn_r76","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0083","start":83,"end":87,"surface":"貳師將軍","kind":"person","person_id":"pez_8dn_r76","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0089","start":89,"end":92,"surface":"趙始成","kind":"person","person_id":"zpc_ufe_fc2","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0099","start":99,"end":101,"surface":"王恢","kind":"person","person_id":"4qp_wu1_qhe","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0106","start":106,"end":108,"surface":"李哆","kind":"person","person_id":"ey5_6f2_7to","status":"contextual_provisional"}],"chapter_id":"c-shiji-123-dayuan","book_id":"b-shiji-123","work_id":"w-shiji","source_id":"s-shiji123-dayuan"},{"id":"c-shiji-123-dayuan:p031","text":"貳師將軍軍既西過鹽水，當道小國恐，各堅城守，不肯給食。攻之不能下。下者得食，不下者數日則去。比至郁成，士至者不過數千，皆饑罷。攻郁成，郁成大破之，所殺傷甚眾。貳師將軍與哆、始成等計：「至郁成尚不能舉，況至其王都乎？」引兵而還。往來二歲。還至敦煌，士不過什一二。使使上書言：「道遠多乏食；且士卒不患戰，患饑。人少，不足以拔宛。願且罷兵，益發而復往。」天子聞之，大怒，而使使遮玉門，曰軍有敢入者輒斬之！貳師恐，因留敦煌。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-123-dayuan:m031-0000","start":0,"end":4,"surface":"貳師將軍","kind":"person","person_id":"pez_8dn_r76","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m031-0079","start":79,"end":83,"surface":"貳師將軍","kind":"person","person_id":"pez_8dn_r76","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m031-0084","start":84,"end":85,"surface":"哆","kind":"person","person_id":"ey5_6f2_7to","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m031-0086","start":86,"end":88,"surface":"始成","kind":"person","person_id":"zpc_ufe_fc2","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m031-0174","start":174,"end":176,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m031-0199","start":199,"end":201,"surface":"貳師","kind":"person","person_id":"pez_8dn_r76","status":"contextual_provisional"}],"chapter_id":"c-shiji-123-dayuan","book_id":"b-shiji-123","work_id":"w-shiji","source_id":"s-shiji123-dayuan"},{"id":"c-shiji-123-dayuan:p032","text":"其夏，漢亡浞野之兵二萬餘於匈奴。公卿及議者皆願罷擊宛軍，專力攻胡。天子已業誅宛，宛小國而不能下，則大夏之屬輕漢，而宛善馬絕不來，烏孫、侖頭易苦漢使矣，為外國笑。乃案言伐宛尤不便者鄧光等，赦囚徒材官，益發惡少年及邊騎，歲餘而出敦煌者六萬人，負私從者不與。牛十萬，馬三萬餘匹，驢騾橐它以萬數。多齎糧，兵弩甚設，天下騷動，傳相奉伐宛，凡五十餘校尉。宛王城中無井，皆汲城外流水，於是乃遣水工徙其城下水空以空其城。益發戍甲卒十八萬，酒泉、張掖北，置居延、休屠以衛酒泉，而發天下七科適，及載糒給貳師。轉車人徒相連屬至敦煌。而拜習馬者二人為執驅校尉，備破宛擇取其善馬云。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-123-dayuan:m032-0005","start":5,"end":7,"surface":"浞野","kind":"person","person_id":"z0l_1wp_de1","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m032-0033","start":33,"end":35,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m032-0089","start":89,"end":91,"surface":"鄧光","kind":"person","person_id":"o5r_zwu_65v","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m032-0171","start":171,"end":173,"surface":"宛王","kind":"person","person_id":"2l2_58b_q4i","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m032-0257","start":257,"end":262,"surface":"習馬者二人","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-123-dayuan","book_id":"b-shiji-123","work_id":"w-shiji","source_id":"s-shiji123-dayuan"},{"id":"c-shiji-123-dayuan:p035","text":"初，貳師后行，天子使使告烏孫，大發兵并力擊宛。烏孫發二千騎往，持兩端，不肯前。貳師將軍之東，諸所過小國聞宛破，皆使其子弟從軍入獻，見天子，因以為質焉。貳師之伐宛也，而軍正趙始成力戰，功最多；及上官桀敢深入，李哆為謀計，軍入玉門者萬餘人，軍馬千餘匹。貳師后行，軍非乏食，戰死不能多，而將吏貪，多不愛士卒，侵牟之，以此物故眾。天子為萬里而伐宛，不錄過，封廣利為海西侯。又封身斬郁成王者騎士趙弟為新畤侯。軍正趙始成為光祿大夫，上官桀為少府，李哆為上黨太守。軍官吏為九卿者三人，諸侯相、郡守、二千石者百餘人，千石以下千餘人。奮行者官過其望，以適過行者皆絀其勞。士卒賜直四萬金。伐宛再反，凡四歲而得罷焉。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-123-dayuan:m035-0002","start":2,"end":4,"surface":"貳師","kind":"person","person_id":"pez_8dn_r76","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m035-0007","start":7,"end":9,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m035-0039","start":39,"end":43,"surface":"貳師將軍","kind":"person","person_id":"pez_8dn_r76","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m035-0057","start":57,"end":60,"surface":"其子弟","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-123-dayuan:m035-0066","start":66,"end":68,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m035-0075","start":75,"end":77,"surface":"貳師","kind":"person","person_id":"pez_8dn_r76","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m035-0085","start":85,"end":88,"surface":"趙始成","kind":"person","person_id":"zpc_ufe_fc2","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m035-0096","start":96,"end":99,"surface":"上官桀","kind":"person","person_id":"yxe_llo_9h7","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m035-0103","start":103,"end":105,"surface":"李哆","kind":"person","person_id":"ey5_6f2_7to","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m035-0124","start":124,"end":126,"surface":"貳師","kind":"person","person_id":"pez_8dn_r76","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m035-0161","start":161,"end":163,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m035-0175","start":175,"end":177,"surface":"廣利","kind":"person","person_id":"pez_8dn_r76","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m035-0186","start":186,"end":189,"surface":"郁成王","kind":"person","person_id":"gmy_6so_66g","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m035-0192","start":192,"end":194,"surface":"趙弟","kind":"person","person_id":"p4m_8ib_fwo","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m035-0201","start":201,"end":204,"surface":"趙始成","kind":"person","person_id":"zpc_ufe_fc2","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m035-0210","start":210,"end":213,"surface":"上官桀","kind":"person","person_id":"yxe_llo_9h7","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m035-0217","start":217,"end":219,"surface":"李哆","kind":"person","person_id":"ey5_6f2_7to","status":"contextual_provisional"}],"chapter_id":"c-shiji-123-dayuan","book_id":"b-shiji-123","work_id":"w-shiji","source_id":"s-shiji123-dayuan"}],"sources":[{"chapter_id":"c-shiji-123-dayuan","work_id":"w-shiji","book_id":"b-shiji-123","source_id":"s-shiji123-dayuan","source":{"title":"史記／卷123","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷123","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷123&oldid=8736799","revision_id":8736799,"accessed_on":"2026-10-11","extent":"固定修訂全文39段，包括末段索隱述贊。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版