{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"jp5_stj_l4j","canonical_person_id":"jp5_stj_l4j","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["jp5_stj_l4j"],"persons":[{"id":"jp5_stj_l4j","label":"鄭雄","status":"active","historicity":"historical_tradition","aliases":[{"surface":"鄭雄","mention_ids":["c-jinshu-063-liju:p008:m0045"]}],"evidence":[{"mention_id":"c-jinshu-063-liju:p008:m0045","paragraph_id":"c-jinshu-063-liju:p008","chapter_id":"c-jinshu-063-liju","quote":"鄭雄"}],"review":"ai_provisional","identity_note":"鄭雄，見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-jinshu-063-liju-ws2025242","work_id":"w-jinshu","book_id":"b-jinshu-063","chapter_id":"c-jinshu-063-liju","raw_mention_count":1,"mention_ids":["c-jinshu-063-liju:p008:m0045"],"paragraph_ids":["c-jinshu-063-liju:p008"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-063-liju:p008:m0045","mention_ids":["c-jinshu-063-liju:p008:m0045"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-063-liju-ws2025242"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-063-liju:p008:m0045","surface":"鄭雄","start":45,"end":47,"person_id":"jp5_stj_l4j","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-063-liju:p008","chapter_id":"c-jinshu-063-liju"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-063-liju:p008","text":"郭默欲侵祖約，矩禁之不可，遂為約所破。石勒遣其養子匆襲默，默懼後患未已，將降于劉曜，遣參軍鄭雄詣矩謀之，矩距而不許。後勒遣其將石良率精兵五千襲矩，矩逆擊不利。郭誦弟元復為賊所執，賊遣元以書說矩曰：「去年東平曹嶷，西賓猗盧，矩如牛角，何不歸命？」矩以示誦，誦曰：「昔王陵母在賊，猶不改意，弟當何論！」勒復遺誦麈尾馬鞭，以示殷勤，誦不答。勒將石生屯洛陽，大掠河南，矩、默大饑，默因復說矩降曜。矩既為石良所破,遂從默計，遣使於曜。曜遣從弟岳軍于河陰，欲與矩謀攻石生。勒遣將圍岳，嶽閉門不敢出。默後為石匆所敗，自密南奔建康。矩聞之大怒，遣其將郭誦等齎書與默，又敕誦曰：「汝識脣亡之談不？迎接郭默，皆由於卿，臨難逃走，其必留之。」誦追及襄城，默自知負矩，棄妻子而遁。誦擁其餘眾而歸，矩待其妻子如初。劉嶽以外援不至，降于石季龍。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":41,"last_line":41,"raw_start":3382,"raw_end":3742,"raw_character_offsets":[3384,3385,3386,3387,3388,3389,3390,3391,3392,3393,3394,3395,3396,3397,3398,3399,3400,3401,3402,3403,3404,3405,3406,3407,3408,3409,3410,3411,3412,3413,3414,3415,3416,3417,3418,3419,3420,3421,3422,3423,3424,3425,3426,3427,3428,3429,3430,3431,3432,3433,3434,3435,3436,3437,3438,3439,3440,3441,3442,3443,3444,3445,3446,3447,3448,3449,3450,3451,3452,3453,3454,3455,3456,3457,3458,3459,3460,3461,3462,3463,3464,3465,3466,3467,3468,3469,3470,3471,3472,3473,3474,3475,3476,3477,3478,3479,3480,3481,3482,3483,3484,3485,3486,3487,3488,3489,3490,3491,3492,3493,3494,3495,3496,3497,3498,3499,3500,3501,3502,3503,3504,3505,3506,3507,3508,3509,3510,3511,3512,3513,3514,3515,3516,3517,3518,3519,3520,3521,3522,3523,3524,3525,3526,3527,3528,3529,3530,3531,3532,3533,3534,3535,3536,3537,3538,3539,3540,3541,3542,3543,3544,3545,3546,3547,3548,3549,3550,3551,3552,3553,3554,3555,3556,3557,3558,3559,3560,3561,3562,3563,3564,3565,3566,3567,3568,3569,3570,3571,3572,3573,3574,3575,3576,3577,3578,3579,358