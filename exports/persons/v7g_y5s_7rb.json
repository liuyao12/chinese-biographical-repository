l"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-058-zhou-fu:p001:m0195","surface":"向蠶","start":195,"end":197,"person_id":"v7g_y5s_7rb","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-058-zhou-fu:p001","chapter_id":"c-jinshu-058-zhou-fu"},{"id":"c-jinshu-058-zhou-fu:p001:m0223","surface":"蠶","start":223,"end":224,"person_id":"v7g_y5s_7rb","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-058-zhou-fu:p001","chapter_id":"c-jinshu-058-zhou-fu"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-058-zhou-fu:p001","text":"撫字道和。強毅有父風，而將禦不及。元帝辟爲丞相掾，父喪去官。服闋，襲爵，除鷹揚將軍、武昌太守。王敦命爲從事中郎，與鄧嶽俱爲敦爪牙。甘卓遇害。敦以撫爲沔北諸軍事、南中郎將，鎮沔中。及敦作逆，撫領二千人從之。敦敗，撫與嶽俱亡走。撫弟光將資遺其兄，而陰欲取嶽。撫怒曰：「我與伯山同亡，何不先斬我！」會嶽至，撫出門遙謂之曰：「何不速去！今骨肉尚欲相危，況他人乎！」嶽回船而走，撫遂共入西陽蠻中，蠻酋向蠶納之。初，岳爲西陽，欲伐諸蠻，及是諸蠻皆怨，將殺之。蠶不聽，曰：「鄧府君窮來歸我，我何忍殺之！」由是俱得免。明年，詔原敦党，嶽、撫詣闕請罪，有詔禁錮之。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":82,"last_line":82,"raw_start":7663,"raw_end":7938,"raw_character_offsets":[7665,7666,7667,7668,7669,7670,7671,7672,7673,7674,7675,7676,7677,7678,7679,7680,7681,7682,7683,7684,7685,7686,7687,7688,7689,7690,7691,7692,7693,7694,7695,7696,7697,7698,7699,7700,7701,7702,7703,7704,7705,7706,7707,7708,7709,7710,7711,7712,7713,7714,7715,7716,7717,7718,7719,7720,7721,7722,7723,7724,7725,7726,7727,7728,7729,7730,7731,7732,7733,7734,7735,7736,7737,7738,7739,7740,7741,7742,7743,7744,7745,7746