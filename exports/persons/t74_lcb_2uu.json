ue,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-liangshu-016-zhangji:p003:m0040","start":40,"end":42,"surface":"張齊","kind":"person","person_id":"t74_lcb_2uu","status":"contextual_provisional","paragraph_id":"c-liangshu-016-zhangji:p003","chapter_id":"c-liangshu-016-zhangji"}],"relations":[],"title_holdings":[{"id":"th-liangshu-016-zhangji-3-38","title":"直閤","kind":"office","mode":"attestation","person_id":"t74_lcb_2uu","attestations":[{"id":"th-liangshu-016-zhangji-3-38:a","paragraph_id":"c-liangshu-016-zhangji:p003","start":38,"end":40,"surface":"直閤","person_mention_id":"c-liangshu-016-zhangji:p003:m0040","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-016","chapter_id":"c-liangshu-016-zhangji","source_id":"s-liangshu-016-zhangji-ws1508503","paragraph_id":"c-liangshu-016-zhangji:p003","quote":"時東昏淫虐，義師圍城已久，城內思亡而莫有先發。北徐州刺史王珍國就稷謀之，乃使直閤張齊害東昏于含德殿。稷召尚書右僕射王亮等列坐殿前西鐘下，謂曰：「昔桀有昏德，鼎遷于殷；商紂暴虐，鼎遷于周。今獨夫自絕于天，四海已歸聖主，斯實微子去殷之時，項伯歸漢之日，可不勉哉！」乃遣國子博士范雲、舍人裴長穆等使石頭城詣高祖，高祖以稷爲侍中、左衛將軍。高祖總百揆，遷大司馬左司馬。梁臺建，爲散騎常侍、中書令。高祖受禪，以功封江安縣侯，邑一千戶。又爲侍中、國子祭酒，領驍騎將軍，遷護軍將軍、揚州大中正，以事免。尋爲度支尚書、前將軍、太子右衛率，又以公事免。俄爲祠部尚書，轉散騎常侍、都官尚書、揚州大中正，以本職知領軍事。尋遷領軍將軍，中正、侯如故。","person_mention_id":"c-liangshu-016-zhangji:p003:m0040"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-016-zhangji:p003","text":"時東昏淫虐，義師圍城已久，城內思亡而莫有先發。北徐州刺史王珍國就稷謀之，乃使直閤張齊害東昏于含德殿。稷召尚書右僕射王亮等列坐殿前西鐘下，謂曰：「昔桀有昏德，鼎遷于殷；商紂暴虐，鼎遷于周。今獨夫自絕于天，四海已歸聖主，斯實微子去殷之時，項伯歸漢之日，可不勉哉！」乃遣國子博士范雲、舍人裴長穆等使石頭城詣高祖，高祖以稷爲侍中、左衛將軍。高祖總百揆，遷大司馬左司馬。梁臺建，爲散騎常侍、中書令。高祖受禪，以功封江安縣侯，邑一千戶。又爲侍中、國子祭酒，領驍騎將軍，遷護軍將軍、揚州大中正，以事免。尋爲度支尚書、前將軍、太子右衛率，又以公事免。俄爲祠部尚書，轉散騎常侍、都官尚書、揚州大中正，以本職知領軍事。尋遷領軍將軍，中正、侯如故。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":34,"last_line":34,"raw_start":2414,"raw_end":2727,"raw_character_offsets":[2414,2415,2416,2417,2418,2419,2420,2421,2422,2423,2424,2425,2426,2427,2428,2429,2430,2431,2432,2433,2434,2435,2436,2437,2438,2439,2440,2441,2442,2443,2444,2445,2446,2447,2448,2449,2450,2451,2452,2453,2454,2455,2456,2457,2458,2459,2460,2461,2462,2463,2464,2465,2466,2467,2468,2469,2470,2471,2472,2473,2474,2475,2476,2477,2478,2479,2480,2481,2482,2483,2484,2485,2486,2487,2488,2489,2490,2491,2492,2493,2494,2495,2496,2497,2498,2499,2500,2501,2502,2503,2504,2505,2506,2507,2508,2509,2510,2511,2512,2513,2514,2515,2516,2517,2518,2519,2520,2521,2522,2523,2524,2525,2526,2527,2528,2529,2530,2531,2532,2533,2534,2535,2536,2537,2538,2539,2540,2541,2542,2543,2544,2545,2546,2547,2548,2549,2550,2551,2552,2553,2554,2555,2556,2557,2558,2559,2560,2561,2562,2563,2564,2565,2566,2567,2568,2569,2570,2571,2572,2573,2574,2575,2576,2577,2578,2579,2580,2581,2582,2583,2584,2585,2586,2587,2588,2589,2590,2591,2592,2593,2594,2595,2596,2597,2598,2599,2600,2601,2602,2603,2604,2605,2606,2607,2608,2609,2610,2611,2612,2613,2614,2615,2616,2617,2618,2619,2620,2621,2622,2623,2624,2625,2626,2627,2628,2629,2630,2631,2632,2633,2634,2635,2636,2637,2638,2639,2640,2641,2642,2643,2644,2645,2646,2647,2648,2649,2650,2651,2652,2653,2654,2655,2656,2657,2658,2659,2660,2661,2662,2663,2664,2665,2666,2667,2668,2669,2670,2671,2672,2673,2674,2675,2676,2677,2678,2679,2680,2681,2682,2683,2684,2685,2686,2687,2688,2689,2690,2691,2692,2693,2694,2695,2696,2697,2698,2699,2700,2701,2702,2703,2704,2705,2706,2707,2708,2709,2710,2711,2712,2713,2714,2715,2716,2717,2718,2719,2720,2721,2722,2723,2724,2725,2726],"revision_id":1508503},"mentions":[{"id":"c-liangshu-016-zhangji:p003:m0028","start":28,"end":31,"surface":"王珍國","kind":"person","person_id":"m4d_lon_pyg_A","status":"