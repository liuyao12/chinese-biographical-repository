{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004242","identity_policy":"contextual_provisional","person_ids":["cbr-p004242"],"persons":[{"id":"cbr-p004242","label":"趙孝成王（白起王翦列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"趙孝成王","mention_ids":["c-shiji-073-baiwang:m002-0100"]},{"surface":"趙王","mention_ids":["c-shiji-073-baiwang:m004-0131","c-shiji-073-baiwang:m004-0183"]}],"evidence":[{"mention_id":"c-shiji-073-baiwang:m002-0100","chapter_id":"c-shiji-073-baiwang","paragraph_id":"c-shiji-073-baiwang:p002","quote":"趙孝成王"},{"mention_id":"c-shiji-073-baiwang:m004-0131","chapter_id":"c-shiji-073-baiwang","paragraph_id":"c-shiji-073-baiwang:p004","quote":"趙王"},{"mention_id":"c-shiji-073-baiwang:m004-0183","chapter_id":"c-shiji-073-baiwang","paragraph_id":"c-shiji-073-baiwang:p004","quote":"趙王"}]}],"mentions":[{"id":"c-shiji-073-baiwang:m002-0100","start":100,"end":104,"surface":"趙孝成王","kind":"person","person_id":"cbr-p004242","status":"contextual_provisional","paragraph_id":"c-shiji-073-baiwang:p002","chapter_id":"c-shiji-073-baiwang"},{"id":"c-shiji-073-baiwang:m004-0131","start":131,"end":133,"surface":"趙王","kind":"person","person_id":"cbr-p004242","status":"contextual_provisional","paragraph_id":"c-shiji-073-baiwang:p004","chapter_id":"c-shiji-073-baiwang"},{"id":"c-shiji-073-baiwang:m004-0183","start":183,"end":185,"surface":"趙王","kind":"person","person_id":"cbr-p004242","status":"contextual_provisional","paragraph_id":"c-shiji-073-baiwang:p004","chapter_id":"c-shiji-073-baiwang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji073-011","person_id":"cbr-p004242","surfaces":["趙孝成王","趙王"],"scope":"same_chapter","chapter_ids":["c-shiji-073-baiwang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-073-baiwang:p002","quote":"四十五年，伐韓之野王。野王降秦，上黨道絕。其守馮亭與民謀曰：「鄭道已絕，韓必不可得為民。秦兵日進，韓不能應，不如以上黨歸趙。趙若受我，秦怒，必攻趙。趙被兵，必親韓。韓趙為一，則可以當秦。」因使人報趙。趙孝成王與平陽君、平原君計之。平陽君曰：「不如勿受。受之，禍大於所得。」平原君曰：「無故得一郡，受之便。」趙受之，因封馮亭為華陽君。"},{"paragraph_id":"c-shiji-073-baiwang:p004","quote":"四十七年，秦使左庶長王龁攻韓，取上黨。上黨民走趙。趙軍長平，以按據上黨民。四月，龁因攻趙。趙使廉頗將。趙軍士卒犯秦斥兵，秦斥兵斬趙裨將茄。六月，陷趙軍，取二鄣四尉。七月，趙軍筑壘壁而守之。秦又攻其壘，取二尉，敗其陣，奪西壘壁。廉頗堅壁以待秦，秦數挑戰，趙兵不出。趙王數以為讓。而秦相應侯又使人行千金於趙為反閒，曰：「秦之所惡，獨畏馬服子趙括將耳，廉頗易與，且降矣。」趙王既怒廉頗軍多失亡，軍數敗，又反堅壁不敢戰，而又聞秦反閒之言，因使趙括代廉頗將以擊秦。秦聞馬服子將，乃陰使武安君白起為上將軍。而王龁為尉裨將，令軍中有敢泄武安君將者斬。趙括至，則出兵擊秦軍。秦軍詳敗而走，張二奇兵以劫之。趙軍逐勝，追造秦壁。壁堅拒不得入，而秦奇兵二萬五千人絕趙軍後，又一軍五千騎絕趙壁閒，趙軍分而為二，糧道絕。而秦出輕兵擊之。趙戰不利，因筑壁堅守，以待救至。秦王聞趙食道絕，王自之河內，賜民爵各一級，發年十五以上悉詣長平，遮絕趙救及糧食。"}],"rationale":"依前3段明示稱名與本地敘事暫接，白起武安君、馮亭華陽君按明示相配；平陽君、平原君、穰侯與客卿錯不由記憶補姓名。東徙陳楚王保存未名候選，不全域接同國王稱；三晉將群體不補成員。華陽斬首數保留本篇，不因同名消除他篇差異。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-073-baiwang:p002","text":"四十五年，伐韓之野王。野王降秦，上黨道絕。其守馮亭與民謀曰：「鄭道已絕，韓必不可得為民。秦兵日進，韓不能應，不如以上黨歸趙。趙若受我，秦怒，必攻趙。趙被兵，必親韓。韓趙為一，則可以當秦。」因使人報趙。趙孝成王與平陽君、平原君計之。平陽君曰：「不如勿受。受之，禍大於所得。」平原君曰：「無故得一郡，受之便。」趙受之，因封馮亭為華陽君。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-073-baiwang:m002-0021","start":21,"end":23,"surface":"其守","kind":"person","person_id":"cbr-p004241","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m002-0023","start":23,"end":25,"surface":"馮亭","kind":"person","person_id":"cbr-p004241","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m002-0100","start":100,"end":104,"surface":"趙孝成王","kind":"person","person_id":"cbr-p004242","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m002-0105","start":105,"end":108,"surface":"平陽君","kind":"person","person_id":"cbr-p004243","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m002-0109","start":109,"end":112,"surface":"平原君","kind":"person","person_id":"cbr-p004244","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m002-0115","start":115,"end":118,"surface":"平陽君","kind":"person","person_id":"cbr-p004243","status":"contextual_provisional"},{"id":"