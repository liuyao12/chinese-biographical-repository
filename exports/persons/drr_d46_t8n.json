戲立，是爲懿公。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-033-lu:m023-0000","start":0,"end":2,"surface":"武公","kind":"person","person_id":"0s7_r72_j8q","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m023-0006","start":6,"end":8,"surface":"武公","kind":"person","person_id":"0s7_r72_j8q","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m023-0009","start":9,"end":12,"surface":"長子括","kind":"person","person_id":"0s7_r72_j8q_A","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m023-0013","start":13,"end":16,"surface":"少子戲","kind":"person","person_id":"0s7_r72_j8q_B","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m023-0019","start":19,"end":22,"surface":"周宣王","kind":"person","person_id":"lt5_gcv_iqh","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m023-0023","start":23,"end":25,"surface":"宣王","kind":"person","person_id":"lt5_gcv_iqh","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m023-0026","start":26,"end":27,"surface":"戲","kind":"person","person_id":"0s7_r72_j8q_B","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m023-0030","start":30,"end":31,"surface":"戲","kind":"person","person_id":"0s7_r72_j8q_B","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m023-0032","start":32,"end":35,"surface":"魯太子","kind":"person","person_id":"0s7_r72_j8q_B","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m023-0038","start":38,"end":42,"surface":"樊仲山父","kind":"person","person_id":"drr_d46_t8n","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m023-0043","start":43,"end":45,"surface":"宣王","kind":"person","person_id":"lt5_gcv_iqh","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m023-0116","start":116,"end":118,"surface":"天子","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或未定稱謂，少昊傳說稱呼未另核；不補姓名與成員。"},{"id":"c-shiji-033-lu:m023-0119","start":119,"end":121,"surface":"諸矦","kind":"unresolved","person_id":null,"status":"unresol