/projection.json","unit_key":"p009","revision_id":"214fcafa79894355909c9d8c2c1533089e7791c6","source_unit_id":"sgz009-caozhen-full","biography_subject_person_id":"30k_jzz_tpd_A","annotator":"裴松之","attribution":"裴注轉引或案語，非陳壽正文；未親見所引原書。","cited_work":"魏書","projected_start":1032,"projected_end":1613,"attached_note_to_paragraph_id":"c-sanguozhi-009-caozhen:p008","reported_attributions":[{"offset":0,"literal":"魏書曰"}]},"chapter_id":"c-sanguozhi-009-caozhen","book_id":"b-sanguozhi-009","work_id":"w-sanguozhi","source_id":"s-sanguozhi-009-caozhen"},{"id":"c-shiji-033-lu:p023","text":"武公九年春，武公與長子括，少子戲，西朝周宣王。宣王愛戲，欲立戲爲魯太子。周之樊仲山父諫宣王曰：『廢長立少，不順；不順，必犯王命；犯王命，必誅之：故出令不可不順也。令之不行，政之不立；行而不順，民將棄上。夫下事上，少事長，所以爲順。今天子建諸矦，立其少，是教民逆也。若魯從之，諸矦效之，王命將有所壅；若弗從而誅之，是自誅王命也。誅之亦失，不誅亦失，王其圖之。』宣王弗聽，卒立戲爲魯太子。夏，武公歸而卒，戲立，是爲懿公。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-033-lu:m023-0000","start":0,"end":2,"surface":"武公","kind":"person","person_id":"0s7_r72_j8q","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m023-0006","start":6,"end":8,"surface":"武公","kind":"person","person_id":"0s7_r72_j8q","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m023-0009","start":9,"end":12,"surface":"長子括","kind":"person","person_id":"0s7_r72_j8q_A","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m023-0013","start":13,"end":16,"surface":"少子戲","kind":"person","person_id":"0s7_r72_j8q_B","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m023-0019","start":19,"end":22,"surface":"周宣王","kind":"person","person_id":"lt5_gcv_iqh","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m023-0023","start":23,"end":25,"surface":"宣王","kind":"person","person_id":"lt5_gcv_iqh","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m023-0026","start":26,"end":27,"surface":"戲","kind":"person","person_id":"0s7_r72_j8q_B","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m023-0030","start":30,"end":31,"surface":"戲","kind":"person","person_id":"0s7_r72_j8q_B","