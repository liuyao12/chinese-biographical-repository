passage_count":1}],"most_mentioned_source_ids":["s-shiji-006-shihuang","s-shiji-048-chenshe"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"unresolved_identity_cases":[{"id":"u-ningyue-learning-and-guoqin","candidate_person_ids":["hhx_c6e_0lx","ccx_50c_ssi"],"paragraph_ids":["c-nanshi-024-wang-family:line025","c-shiji-006-shihuang:p064:block05","c-shiji-048-chenshe:p023"],"unknown_identity_possible":false,"status":"unresolved","note":"本段甯越為勤學引古，另有呂氏春秋博志故事；兩篇過秦論的寧越／甯越已依平行名單接合。徐廣對過秦論名指明言「或自別有此人，不必甯越也」，故兩語境暫分，不以同名或字形互換推成同人。","references":[{"title":"徐廣《集解》所引寧越辨名疑義","url":"https://zh.wikisource.org/w/index.php?title=%E5%8F%B2%E8%A8%98%E4%B8%89%E5%AE%B6%E8%A8%BB%2F%E5%8D%B7006&oldid=2514684","source_revision":2514684,"quote":"越，一作『經』。或自別有此人，不必甯越也。","scope":"ancient_commentary_identity_caution_for_guoqin_passage","source_position":{"first_line":215,"last_line":215},"wikitext_sha256":"cb2a327cbf1166d03083d6b120a53f7202be4a083ab1c63fab48fdb5f503a48c","image_verified":false}],"chapter_id":"c-nanshi-024-wang-family","source_id":"s-nanshi-024-wang-family"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-006-shihuang:p064:block05:m0163","start":163,"end":165,"surface":"寧越","kind":"person","person_id":"ccx_50c_ssi","status":"contextual_provisional","paragraph_id":"c-shiji-006-shihuang:p064:block05","chapter_id":"c-shiji-006-shihuang"},{"id":"c-shiji-048-chenshe:m023-0164","start":164,"end":166,"surface":"甯越","kind":"person","person_id":"ccx_50c_ssi","status":"contextual_provisional","paragraph_id":"c-shiji-048-chenshe:p023","chapter_id":"c-shiji-048-chenshe"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji048-061","person_id":"ccx_50c_ssi","surfaces":["甯越"],"scope":"same_chapter","chapter_ids":["c-shiji-048-chenshe"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-048-chenshe:p023","quote":"孝公既沒，惠文王、武王、昭王蒙故業，因遺策，南取漢中，西舉巴蜀，東割膏腴之地，收要害之郡。諸侯恐懼，會盟而謀弱秦。不愛珍器重寶肥饒之地，以致天下之士。合從締交，相與為一。當此之時，齊有孟嘗，趙有平原，楚有春申，魏有信陵：此四君者，皆明知而忠信，寬厚而愛人，尊賢而重士。約從連衡，兼韓、魏、燕、趙、宋、衛、中山之眾。於是六國之士有甯越、徐尚、蘇秦、杜赫之屬為之謀，齊明、周聚、陳軫、邵滑、樓緩、翟景、蘇厲、樂毅之徒通其意，吳起、孫臏、帶他、兒良、王廖、田忌、廉頗、趙奢之倫制其兵。嘗以什倍之地，百萬之師，仰關而攻秦。秦人開關而延敵，九國之師遁逃而不敢進。秦無亡矢遺鏃之費，而天下固已困矣。於是從散約敗，爭割地而賂秦。秦有余力而制其獘，追亡逐北，伏尸百萬，流血漂櫓，因利乘便，宰割天下，分裂山河，彊國請服，弱國入朝。"}],"rationale":"限明示名、字及局部軍事角色；陳勝涉、吳廣叔、蔡賜房君與周文周章暫接，吳廣韓廣分開。引文四君短稱及比擬人物另留候選，詐稱扶蘇項燕不合陳吳，褚賈署稱不補姓名。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-guoqin-ningyue-parallel","person_ids":["ccx_50c_ssi"],"canonical_person_id":"ccx_50c_ssi","identity_materialized":true,"scope":"cross_chapter","chapter_ids":["c-shiji-006-shihuang","c-shiji-048-chenshe"],"status":"contextual_provisional","evidence":[{"work_id":"w-shiji","book_id":"b-shiji-006","chapter_id":"c-shiji-006-shihuang","source_id":"s-shiji-006-shihuang","paragraph_id":"c-shiji-006-shihuang:p064:block05","quote":"孝公既沒，惠王、武王蒙故業，因遺冊，南兼漢中，西舉巴、蜀，東割膏腴之地，收要害之郡。諸侯恐懼，會盟而謀弱秦，不愛珍器重寶肥美之地，以致天下之士，合從締交，相與為一。當是時，齊有孟嘗，趙有平原，楚有春申，魏有信陵。此四君者，皆明知而忠信，寬厚而愛人，尊賢重士，約從離衡，并韓、魏、燕、楚、齊、趙、宋、衛、中山之眾。於是六國之士有寧越、徐尚、蘇秦、杜赫之屬為之謀，齊明、周最、陳軫、昭滑、樓緩、翟景、蘇厲、樂毅之徒通其意，吳起、孫臏、帶佗、兒良、王廖、田忌、廉頗、趙奢之朋制其兵。常以十倍之地，百萬之眾，叩關而攻秦。秦人開關延敵，九國之師逡巡遁逃而不敢進。秦無亡矢遺鏃之費，而天下諸侯已困矣。於是從散約解，爭割地而奉秦。秦有餘力而制其敝，追亡逐北，伏尸百萬，流血漂櫓。因利乘便，宰割天下，分裂河山，彊國請服，弱國入朝。延及孝文王、莊襄王，享國日淺，國家無事。","mention_ids":["c-shiji-006-shihuang:p064:block05:m0163"]},{"work_id":"w-shiji","book_id":"b-shiji-048","chapter_id":"c-shiji-048-chenshe","source_id":"s-shiji-048-chenshe","paragraph_id":"c-shiji-048-chenshe:p023","quote":"孝公既沒，惠文王、武王、昭王蒙故業，因遺策，南取漢中，西舉巴蜀，東割膏腴之地，收要害之郡。諸侯恐懼，會盟而謀弱秦。不愛珍器重寶肥饒之地，以致天下之士。合從締交，相與為一。當此之時，齊有孟嘗，趙有平原，楚有春申，魏有信陵：此四君者，皆明知而忠信，寬厚而愛人，尊賢而重士。約從連衡，兼韓、魏、燕、趙、宋、衛、中山之眾。於是六國之士有甯越、徐尚、蘇秦、杜赫之屬為之謀，齊明、周聚、陳軫、邵滑、樓緩、翟景、蘇厲、樂毅之徒通其意，吳起、孫臏、帶他、兒良、王廖、田忌、廉頗、趙奢之倫制其兵。嘗以什倍之地，百萬之師，仰關而攻秦。秦人開關而延敵，九國之師遁逃而不敢進。秦無亡矢遺鏃之費，而天下固已困矣。於是從散約敗，爭割地而賂秦。秦有余力而制其獘，追亡逐北，伏尸百萬，流血漂櫓，因利乘便，宰割天下，分裂山河，彊國請服，弱國入朝。","mention_ids":["c-shiji-048-chenshe:m023-0164"]}],"rationale":"兩篇均收過秦論同一六國謀士名單，寧越／甯越相鄰徐尚、蘇秦、杜赫，依平行原文接合同一名指；不由此證明與勤學故事甯越同人。原字、位置與提及錨點不改，不發布舊新ID對照。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-nanshi-024-wang-family:line025","text":"敬弘見兒孫，歳中不過一再相見，見輒克日。未嘗教子孫學問，各隨所欲。人或問之，答曰：「丹朱不應乏教，甯越不聞被捶。」恢之位新安太守，嘗請假定省。敬弘克日見之，至日輒不果。假日將盡，恢之求辭，敬弘呼前至合，復不見。恢之於合外拜辭流涕而去。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-nanshi-024-wang-family:line025:m0000","start":0,"end":2,"surface":"敬弘","kind":"person","person_id":"7r6_k52_qji_ABDABAA","status":"contextual_provisional"},{"id":"c-nanshi-024-wang-family:line025:m0042","start":42,"end":44,"surface":"丹朱","kind":"person","person_id":"dpx_453_4rt","status":"contextual_provisional"},{"id":"c-nanshi-024-wang-family:line025:m0049","start":49,"end":51,"surface":"甯越","kind":"person","person_id":"hhx_c6e_0lx","status":"contextual_provisional"},{"id":"c-nanshi-024-wang-family:line025:m0057","start":57,"end":59,"surface":"恢之","kind":"person","person_id":"7r6_k52_qji_ABDABAAA","status":"contextual_provisional"},{"id":"c-nanshi-024-wang-family:line025:m0071","start":71,"end":73,"surface":"敬弘","kind":"person","person_id":"7r6_k52_qji_ABDABAA","status":"contextual_provisional"},{"id":"c-nanshi-024-wang-family:line025:m0089","start":89,"end":91,"surface":"恢之","kind":"person","person_id":"7r6_k52_qji_ABDABAAA","status":"contextual_provisional"},{"id":"c-nanshi-024-wang-family:line025:m0094","start":94,"end":96,"surface":"敬弘","kind":"person","person_id":"7r6_k52_qji_ABDABAA","status":"contextual_provisional"},{"id":"c-nanshi-024-wang-family:line025:m0105","start"