erson_id":"995_xas_r98","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m018-0073","start":73,"end":75,"surface":"蔡侯","kind":"person","person_id":"995_xas_r98","status":"contextual_provisional"}],"chapter_id":"c-shiji-035-guancai","book_id":"b-shiji-035","work_id":"w-shiji","source_id":"s-shiji-035-guancai"},{"id":"c-shiji-035-guancai:p019","text":"十三年春，與衛靈公會邵陵。蔡侯私於周萇弘以求長於衛；衛使史言康叔之功德，乃長衛。夏，為晉滅沈，楚怒，攻蔡。蔡昭侯使其子為質於吳，以共伐楚。冬，與吳王闔閭遂破楚入郢。蔡怨子常，子常恐，奔鄭。十四年，吳去而楚昭王復國。十六年，楚令尹為其民泣以謀蔡，蔡昭侯懼。二十六年，孔子如蔡。楚昭王伐蔡，蔡恐，告急於吳。吳為蔡遠，約遷以自近，易以相救；昭侯私許，不與大夫計。吳人來救蔡，因遷蔡于州來。二十八年，昭侯將朝于吳，大夫恐其復遷，乃令賊利殺昭侯；已而誅賊利以解過，而立昭侯子朔，是為成侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-035-guancai:m019-0006","start":6,"end":9,"surface":"衛靈公","kind":"person","person_id":"72v_2mg_72h","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m019-0013","start":13,"end":15,"surface":"蔡侯","kind":"person","person_id":"995_xas_r98","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m019-0017","start":17,"end":20,"surface":"周萇弘","kind":"person","person_id":"2jv_fri_ifh","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m019-0028","start":28,"end":29,"surface":"史","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未定稱呼、國別指代或數位校勘字樣；不補人名、成員與闕代。"},{"id":"c-shiji-035-guancai:m019-0030","start":30,"end":32,"surface":"康叔","kind":"person","person_id":"y4i_pjk_4gn_AE","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m019-0053","start":53,"end":56,"surface":"蔡昭侯","kind":"person","person_id":"995_xas_r98","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m019-0058","start":58,"end":59,"surface":"子","kind":"person","person_id":"995_xas_r98_B","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m019-0072","start":72,"end":76,"surface":"吳王闔閭","kind":"person","person_id":"5dm_e40_rqh_AAAAAAAAAAAAAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m019-0084","start":84,"e