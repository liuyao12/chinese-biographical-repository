29_dz7_9t4","status":"contextual_provisional","paragraph_id":"c-shiji-035-guancai:p018","chapter_id":"c-shiji-035-guancai"},{"id":"c-shiji-035-guancai:m018-0062","start":62,"end":64,"surface":"子常","kind":"person","person_id":"c29_dz7_9t4","status":"contextual_provisional","paragraph_id":"c-shiji-035-guancai:p018","chapter_id":"c-shiji-035-guancai"},{"id":"c-shiji-035-guancai:m019-0084","start":84,"end":86,"surface":"子常","kind":"person","person_id":"c29_dz7_9t4","status":"contextual_provisional","paragraph_id":"c-shiji-035-guancai:p019","chapter_id":"c-shiji-035-guancai"},{"id":"c-shiji-035-guancai:m019-0087","start":87,"end":89,"surface":"子常","kind":"person","person_id":"c29_dz7_9t4","status":"contextual_provisional","paragraph_id":"c-shiji-035-guancai:p019","chapter_id":"c-shiji-035-guancai"}],"relations":[],"title_holdings":[{"id":"th-shiji035-060","person_id":"c29_dz7_9t4","title":"相","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-035-guancai","source_id":"s-shiji-035-guancai","paragraph_id":"c-shiji-035-guancai:p018","quote":"楚相子常欲之，不與。"}],"attestations":[{"id":"th-shiji035-060:a001","paragraph_id":"c-shiji-035-guancai:p018","start":28,"end":29,"surface":"相","person_mention_id":"c-shiji-035-guancai:m018-0029","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"楚相用稱，不把欲裘事件當任職起點。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji031-036","person_id":"c29_dz7_9t4","surfaces":["子常","子常囊瓦"],"scope":"same_chapter","chapter_ids":["c-shiji-031-wu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-031-wu:p027","quote":"三年，吳王闔廬與子胥、伯嚭將兵伐楚，拔舒，殺吳亡將二公子。光謀欲入郢，將軍孫武曰：「民勞，未可，待之。」四年，伐楚，取六與灊。五年，伐越，敗之。六年，楚使子常囊瓦伐吳。迎而撃之，大敗楚軍於豫章，取楚之居巣而還。"},{"paragraph_id":"c-shiji-031-wu:p028","quote":"九年，吳王闔廬請伍子胥、孫武曰：「始子之言郢未可入，今果如何？」二子對曰：「楚將子常貪，而唐、蔡皆怨之。王必欲大伐，必得唐、蔡乃可。」闔廬從之，悉興師，與唐、蔡西伐楚，至於漢水。楚亦發兵拒吳，夾水陳。吳王闔廬弟夫槩欲戰，闔廬弗許。夫槩曰：「王已屬臣兵，兵以利爲上，尚何待焉？」遂以其部五千人襲冒楚，楚兵大敗，走。於是吳王遂縱兵追之。比至郢，五戰，楚五敗。楚昭王亡出郢，奔鄖。鄖公弟欲弑昭王，昭王與鄖公犇隨。而吳兵遂入郢。子胥、伯嚭鞭平王之屍以報父讎。"}],"rationale":"按本卷弑僚代立、伐楚入郢、吳越戰事或所引夏史的敘事語境暫定異稱；光／闔廬、伍員／子胥及子常／囊瓦有具體事件相接。前卷闔閭與本卷闔廬原字並存；來源記載不等於已校定史實。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji035-032","person_id":"c29_dz7_9t4","surfaces":["子常"],"scope":"cross_chapter","chapter_ids":["c-shiji-031-wu","c-shiji-035-guancai"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-031-wu:p027","quote":"三年，吳王闔廬與子胥、伯嚭將兵伐楚，拔舒，殺吳亡將二公子。光謀欲入郢，將軍孫武曰：「民勞，未可，待之。」四年，伐楚，取六與灊。五年，伐越，敗之。六年，楚使子常囊瓦伐吳。迎而撃之，大敗楚軍於豫章，取楚之居巣而還。"},{"paragraph_id":"c-shiji-035-guancai:p018","quote":"昭侯十年，朝楚昭王，持美裘二，獻其一於昭王而自衣其一。楚相子常欲之，不與。子常讒蔡侯，留之楚三年。蔡侯知之，乃獻其裘於子常；子常受之，乃言歸蔡侯。蔡侯歸而之晉，請與晉伐楚。"},{"paragraph_id":"c-shiji-035-guancai:p019","quote":"十三年春，與衛靈公會邵陵。蔡侯私於周萇弘以求長於衛；衛使史言康叔之功德，乃長衛。夏，為晉滅沈，楚怒，攻蔡。蔡昭侯使其子為質於吳，以共伐楚。冬，與吳王闔閭遂破楚入郢。蔡怨子常，子常恐，奔鄭。十四年，吳去而楚昭王復國。十六年，楚令尹為其民泣以謀蔡，蔡昭侯懼。二十六年，孔子如蔡。楚昭王伐蔡，蔡恐，告急於吳。吳為蔡遠，約遷以自近，易以相救；昭侯私許，不與大夫計。吳人來救蔡，因遷蔡于州來。二十八年，昭侯將朝于吳，大夫恐其復遷，乃令賊利殺昭侯；已而誅賊利以解過，而立昭侯子朔，是為成侯。"}],"rationale":"依文王子同母十人、蔡曹君世系、蔡女船中事件、楚公子圍弒其王及城濮／伐曹的具體敘事暫定異稱。郟敖／夾敖按同一事件、釐／僖負羈按本卷論贊暫同指；不同國與同國不同世代的同名者分開。匿名者、校勘及跨篇同指仍待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-031-wu:p027","text":"三年，吳王闔廬與子胥、伯嚭將兵伐楚，拔舒，殺吳亡將二公子。光謀欲入郢，將軍孫武曰：「民勞，未可，待之。」四年，伐楚，取六與灊。五年，伐越，敗之。六年，楚使子常囊瓦伐吳。迎而撃之，大敗楚軍於豫章，取楚之居巣而還。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-031-wu:m027-0005","start":5,"end":7,"surface":"闔廬","kind":"person","person_id":"5dm_e40_rqh_AAAAAAAAAAAAAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m027-0008","start":8,"end":10,"surface":"子胥","kind":"person","person_id":"kk7_tis_vis","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m027-0011","start":11,"end":13,"surface":"伯嚭","kind":"person","person