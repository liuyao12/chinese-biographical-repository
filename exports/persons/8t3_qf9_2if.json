frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-shiji122-007","person_id":"8t3_qf9_2if","event_type":"death","status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-122-kuli","source_id":"s-shiji122-kuli","paragraph_id":"c-shiji-122-kuli:p019","quote":"匈奴來請和親，群臣議上前。博士狄山曰：「和親便。」上問其便，山曰：「兵者凶器，未易數動。髙帝欲伐匈奴，大困平城，乃遂結和親。孝惠、髙后時，天下安樂。及孝文帝欲事匈奴，北邊蕭然苦兵矣。孝景時，呉楚七國反，景帝往來兩宮閒，寒心者數月。呉楚已破，竟景帝不言兵，天下富實。今自陛下舉兵撃匈奴，中國以空虚，邊民大困貧。由此觀之，不如和親。」上問湯，湯曰：「此愚儒，無知。」狄山曰：「臣固愚忠，若御史大夫湯乃詐忠。若湯之治淮南、江都，以深文痛詆諸侯，別疎骨肉，使蕃臣不自安。臣固知湯之爲詐忠。」於是上作色曰：「吾使生居一郡，能無使虜入盜乎？」曰：「不能。」曰：「居一縣？」對曰：「不能。」復曰：「居一障閒？」山自度辯窮且下吏，曰：「能。」於是上遣山乘鄣。至月餘，匈奴斬山頭而去。自是以後，群臣震慴。","person_mention_id":"c-shiji-122-kuli:m019-0015"}],"source_term":"匈奴斬山頭而去","interpretation_note":"原文明示死亡、執行或自殺；各次回顧未另造死亡事件。未知公元年保持未知，後一歳、十餘年等相對時間保留原文待核。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"mentions":[{"id":"c-shiji-122-kuli:m019-0015","start":15,"end":17,"surface":"狄山","kind":"person","person_id":"8t3_qf9_2if","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p019","chapter_id":"c-shiji-122-kuli"},{"id":"c-shiji-122-kuli:m019-0030","start":30,"end":31,"surface":"山","kind":"person","person_id":"8t3_qf9_2if","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p019","chapter_id":"c-shiji-122-kuli"},{"id":"c-shiji-122-kuli:m019-0181","start":181,"end":183,"surface":"狄山","kind":"person","person_id":"8t3_qf9_2if","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p019","chapter_id":"c-shiji-122-kuli"},{"id":"c-shiji-122-kuli:m019-0298","start":298,"end":299,"surface":"山","kind":"person","person_id":"8t3_qf9_2if","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p019","chapter_id":"c-sh