{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000458","identity_policy":"contextual_provisional","person_ids":["cbr-p000458"],"persons":[{"id":"cbr-p000458","label":"公子少官","status":"active","historicity":"historical_tradition","aliases":[{"surface":"公子少官","mention_ids":["c-shiji-005-qin:m059-0120"]}],"evidence":[{"mention_id":"c-shiji-005-qin:m059-0120","chapter_id":"c-shiji-005-qin","paragraph_id":"c-shiji-005-qin:p059","quote":"公子少官"}],"identity_note":"依本卷特定時代與事件暫定人物；不以同稱、官號或短名全域合併，未見本名不補造。","review":"ai_provisional"}],"mentions":[{"id":"c-shiji-005-qin:m059-0120","start":120,"end":124,"surface":"公子少官","kind":"person","person_id":"cbr-p000458","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p059","chapter_id":"c-shiji-005-qin"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-005-qin:p059","text":"七年，與魏惠王會杜平。八年，與魏戰元裏，有功。十年，衛鞅為大良造，將兵圍魏安邑，降之。十二年，作為咸陽，筑冀闕，秦徙都之。并諸小鄉聚，集為大縣，縣一令，四十一縣。為田開阡陌。東地渡洛。十四年，初為賦。十九年，天子致伯。二十年，諸侯畢賀。秦使公子少官率師會諸侯逢澤，朝天子。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m059-0004","start":4,"end":7,"surface":"魏惠王","kind":"person","person_id":"cbr-p000450","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m059-0026","start":26,"end":28,"surface":"衛鞅","kind":"person","person_id":"cbr-p000454","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m059-0104","start":104,"end":106,"surface":"天子","kind":"unresolved","person_id":null,"status":"unresolved","note":"未定指代、群體或官稱；商君語為篇章指引，不當作獨立個人。"},{"id":"c-shiji-005-qin:m059-0120","start":120,"end":124,"surface":"公子少官","kind":"person","person_id":"cbr-p000458","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m059-0133","start":133,"end":135,"surface":"天子","kind":"unresolved","person_id":null,"status":"unresolved","note":"未定指代、群體或官稱；商君語為篇章指引，不當作獨立個人。"}],"chapte