_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-074-huan-family:p018:m0145","start":145,"end":147,"surface":"苟操","kind":"person","person_id":"63o_l4h_6ej","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。","paragraph_id":"c-jinshu-074-huan-family:p018","chapter_id":"c-jinshu-074-huan-family"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-074-huan-family:p018","text":"初，沖遣竟陵太守趙統伐襄陽。至是，石民復遣兵助之。尋而苻堅敗於淮肥，石民遣南陽太守高茂衙山陵。時堅雖破敗，而慕容垂等復盛。石民遣將軍晏謙伐弘農，賊東中郎將慕容夔降之。始置湖陝二戍。獲關中擔幢伎，以充太樂。時苻堅子丕僭號于河北，謀襲洛陽。石民遣將軍馮該討之，臨隈斬丕，及其左僕射王孚、吏部尚書苟操等，傳首京都。而丁零翟遼復侵逼山陵，石民使河南太守馮遵討之。時乞活黃淮自稱并州刺史，與遼共攻長社，眾數千人。石民復遣南平太守郭銓、松滋太守王遐之擊淮，斬之，遼走河北。以前後功，進左將軍。卒，無子。","source_position":{"kind":"wikitext_codepoint_positions","raw_path":"sources/jinshu/wikisource-1536331-raw.wikitext","raw_start":4396,"raw_end":4662,"character_positions":[4398,4399,4400,4401,4402,4403,4404,4405,4406,4407,4408,4409,4410,4411,4412,4413,4414,4415,4416,4417,4418,4419,4420,4421,4422,4423,4424,4425,4426,4427,4428,4429,4430,4431,4432,4433,4434,4435,4436,4437,4438,4439,4440,4441,4442,4443,4444,4445,4446,4447,4448,4449,4450,4451,4452,4453,4454,4455,4456,4457,4458,4459,4460,4461,4462,4463,4464,4465,4466,4467,4468,4469,4470,4471,4472,4473,4474,4475,4476,4477,4478,4479,4480,4481,4482,4483,4484,4485,4486,4487,4488,4489,4490,4491,4492,4493,4494,4495,4496,4497,4498,4499,4500,4501,4502,4503,4504,4505,4506,4507,4508,4509,4510,4511,4512,4513,4514,4515,4516,4517,4518,4519,4520,4521,4522,4523,4524,4525,4526,4527,4528,4529,4530,4531,4532,4533,4534,4535,4536,4537,4538,4539,4540,4541,4542,4543,4544,4545,4546,4547,4548,4549,4550,4551,4552,4553,4554,4555,4556,4557,4558,4559,4560,4561,4581,4582,4583,4584,4585,4586,45