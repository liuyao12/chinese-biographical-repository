{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003347","identity_policy":"contextual_provisional","person_ids":["cbr-p003347"],"persons":[{"id":"cbr-p003347","label":"蓋公（曹相國世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"蓋公","mention_ids":["c-shiji-054-cao:m009-0087","c-shiji-054-cao:m009-0105","c-shiji-054-cao:m009-0108","c-shiji-054-cao:m009-0137"]}],"evidence":[{"mention_id":"c-shiji-054-cao:m009-0087","chapter_id":"c-shiji-054-cao","paragraph_id":"c-shiji-054-cao:p009","quote":"蓋公"},{"mention_id":"c-shiji-054-cao:m009-0105","chapter_id":"c-shiji-054-cao","paragraph_id":"c-shiji-054-cao:p009","quote":"蓋公"},{"mention_id":"c-shiji-054-cao:m009-0108","chapter_id":"c-shiji-054-cao","paragraph_id":"c-shiji-054-cao:p009","quote":"蓋公"},{"mention_id":"c-shiji-054-cao:m009-0137","chapter_id":"c-shiji-054-cao","paragraph_id":"c-shiji-054-cao:p009","quote":"蓋公"}]}],"mentions":[{"id":"c-shiji-054-cao:m009-0087","start":87,"end":89,"surface":"蓋公","kind":"person","person_id":"cbr-p003347","status":"contextual_provisional","paragraph_id":"c-shiji-054-cao:p009","chapter_id":"c-shiji-054-cao"},{"id":"c-shiji-054-cao:m009-0105","start":105,"end":107,"surface":"蓋公","kind":"person","person_id":"cbr-p003347","status":"contextual_provisional","paragraph_id":"c-shiji-054-cao:p009","chapter_id":"c-shiji-054-cao"},{"id":"c-shiji-054-cao:m009-0108","start":108,"end":110,"surface":"蓋公","kind":"person","person_id":"cbr-p003347","status":"contextual_provisional","paragraph_id":"c-shiji-054-cao:p009","chapter_id":"c-shiji-054-cao"},{"id":"c-shiji-054-cao:m009-0137","start":137,"end":139,"surface":"蓋公","kind":"person","person_id":"cbr-p003347","status":"contextual_provisional","paragraph_id":"c-shiji-054-cao:p009","chapter_id":"c-shiji-054-cao"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji054-041","person_id":"cbr-p003347","surfaces":["蓋公"],"scope":"same_chapter","chapter_ids":["c-shiji-054-cao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-054-cao:p009","quote":"孝惠帝元年，除諸侯相國法，更以參為齊丞相。參之相齊，齊七十城。天下初定，悼惠王富於春秋，參盡召長老諸生，問所以安集百姓，如齊故［俗］諸儒以百數，言人人殊，參未知所定。聞膠西有蓋公，善治黃老言，使人厚幣請之。既見蓋公，蓋公為言治道貴清靜而民自定，推此類具言之。參於是避正堂，舍蓋公焉。其治要用黃老術，故相齊九年，齊國安集，大稱賢相。"}],"rationale":"依本篇明示姓名與局部軍事、任官及子嗣敘事暫接；曹氏時、襄不按單字全域配對。未名者不補姓名，秦司馬夷字待底本核定，田既與田溉不擅同指。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-054-cao:p009","text":"孝惠帝元年，除諸侯相國法，更以參為齊丞相。參之相齊，齊七十城。天下初定，悼惠王富於春秋，參盡召長老諸生，問所以安集百姓，如齊故［俗］諸儒以百數，言人人殊，參未知所定。聞膠西有蓋公，善治黃老言，使人厚幣請之。既見蓋公，蓋公為言治道貴清靜而民自定，推此類具言之。參於是避正堂，舍蓋公焉。其治要用黃老術，故相齊九年，齊國安集，大稱賢相。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-054-cao:m009-0000","start":0,"end":3,"surface":"孝惠帝","kind":"person","person_id":"cbr-p003346","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m009-0015","start":15,"end":16,"surface":"參","kind":"person","person_id":"cbr-p003307","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m009-0021","start":21,"end":22,"surface":"參","kind":"person","person_id":"cbr-p003307","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m009-0036","start":36,"end":39,"surface":"悼惠王","kind":"person","person_id":"cbr-p003342","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m009-0044","start":44,"end":45,"surface":"參","kind":"person","person_id":"cbr-p003307","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m009-0047","start":47,"end":51,"surface":"長老諸生","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名署稱、群體、學說合稱或代詞待核，不補姓名、親屬成員或全域帝號。"},{"id":"c-shiji-054-cao:m009-0077","start":77,"end":78,"surface":"參","kind":"person","person_id":"cbr-p003307","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m009-0087","start":87,"end":89,"surface":"蓋公","kind":"person","person_id":"cbr-p003347","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m009-0092","star