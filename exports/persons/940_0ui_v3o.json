e_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-054-recluses-complete:p069:m0065","start":65,"end":68,"surface":"孔山士","kind":"person","person_id":"940_0ui_v3o","status":"contextual_provisional","paragraph_id":"c-nanqishu-054-recluses-complete:p069","chapter_id":"c-nanqishu-054-recluses-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-054-recluses-complete:p069","text":"　　或勸驎士仕，答曰：「魚縣獸檻，天下一契，聖人玄悟，所以每履吉先。吾誠未能景行坐忘，何爲不希企日損。」乃作《玄散賦》以絕世。太守孔山士辟，不應。宗人徐州刺史曇慶、侍中懷文、左率勃來候之，驎士未嘗答也。隱居餘不吳差山，講經教授，從學者數十百人，各營屋宇，依止其側。驎士重陸機《連珠》，每爲諸生講之。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":176,"last_line":176,"raw_start":9118,"raw_end":9267,"raw_character_offsets":[9118,9119,9120,9121,9122,9123,9124,9125,9126,9127,9128,9129,9130,9131,9132,9133,9134,9135,9136,9137,9138,9139,9140,9141,9142,9143,9144,9145,9146,9147,9148,9149,9150,9151,9152,9153,9154,9155,9156,9157,9158,9159,9160,9161,9162,9163,9164,9165,9166,9167,9168,9169,9170,9171,9172,9173,9174,9175,9176,9177,9178,9179,9180,9181,9182,9183,9184,9185,9186,9187,9188,9189,9190,9191,9192,9193,9194,9195,9196,9197,9198,9199,9200,9201,9202,9203,9204,9205,9206,9207,9208,9209,9210,9211,9212,9213,9214,9215,9216,9217,9218,9219,9220,9221,9222,9223,9224,9225,9226,9227,9228,9229,9230,9231,9232,9233,9234,9235,9236,9237,9238,9239,9240,9241,9242,9243,9244,9245,9246,9247,9248,9249,9250,9251,9252,9253,9254,9255,9256,9257,9258,9259,9260,9261,9262,9263,9264,9265,9266],"revision_id":1762878},"mentions":[{"id":"c-nanqishu-054-recluses-complete:p069:m0004","start":4,"end":6,"surface":"驎士","kind":"person","person_id":"46f_sl6_8ou","status":"contextual_provision