itness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-058-luxun:line021:m0019","start":19,"end":20,"surface":"晏","kind":"person","person_id":"4k0_imy_q8w","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-058-luxun:line021","chapter_id":"c-sanguozhi-058-luxun"},{"id":"c-sanguozhi-058-luxun:line021:m0041","start":41,"end":42,"surface":"晏","kind":"person","person_id":"4k0_imy_q8w","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-058-luxun:line021","chapter_id":"c-sanguozhi-058-luxun"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-058-luxun:line021","text":"遜遣將軍李異、謝旌等將三千人，攻蜀將詹晏、陳鳳。異將水軍，旌將步兵，斷色險要，即破晏等，生降得鳳。又攻房陵太守鄧輔、南鄉太守郭睦，大破之。秭歸大姓文布、鄧凱等合夷兵數千人，首尾西方。遜復部旌討破布、凱。布凱脫走，蜀以為將。遜令人誘之，布帥眾還降。前後斬獲招納，凡數萬計。權以遜為右護軍、鎮西將軍，進封婁侯。時荊州士人新還，仕進或未得所，遜上疏曰：「昔漢高受命，招延英異，光武中興，群俊畢至，苟可以熙隆道教者，未必遠近。今荊州始定，人物未達，臣愚慺慺，乞普加覆載抽拔之恩。令並獲自進，然後四海延頸，思歸大化。」權敬納其言。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-058-luxun:line021:m0000","start":0,"end":1,"surface":"遜","kind":"person","person_id":"lii_454_vuv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line021:m0005","start":5,"end":6,"surface":"異","kin