ers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-075-zhangping-ws2645530"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin075-zhang-zhen","subject_person_id":"f0w_avr_fi9","object_person_id":"gfs_esp_5ef","predicate":"grandfather","qualifiers":{"source_term":"祖鎮，蒼梧太守"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-075","chapter_id":"c-jinshu-075-zhangping","source_id":"s-jinshu-075-zhangping-ws2645530","paragraph_id":"c-jinshu-075-zhangping:p001","quote":"張憑，字長宗。祖鎮，蒼梧太守。憑年數歲。鎮謂其父曰：「我不如汝有佳兒。」憑曰：「阿翁豈宜以子戲父邪！」及長，有志氣，為鄉閭所稱。舉孝廉，負其才，自謂必參時彥。初，欲詣惔，鄉里及同舉者共笑之。既至，惔處之下坐，神意不接，憑欲自發而無端。會王就濛惔清言，有所不通，憑於末坐判之，言旨深遠，足暢彼我之懷，一坐皆驚。惔延之上坐，清言彌日，留宿至旦遣之。憑既還船，須臾，惔遣傳教覓張孝廉船，便召與同載，遂言之于簡文帝。帝召與語，歎曰：「張憑勃窣為理窟。」官至吏部郎、御史中丞。","subject_person_mention_id":"c-jinshu-075-zhangping:p001:m0000","object_person_mention_id":"c-jinshu-075-zhangping:p001:m0008"}],"status":"source_attested","interpretation_note":"中間一代姓名未具。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-075-zhangping:p001:m0008","surface":"鎮","start":8,"end":9,"person_id":"gfs_esp_5ef","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-075-zhangping:p001","chapter_id":"c-jinshu-075-zhangping"}],"relations":[{"id":"a-jin075-zhang-zhen","subject_person_id":"f0w_avr_fi9","object_person_id":"gfs_esp_5ef","predicate