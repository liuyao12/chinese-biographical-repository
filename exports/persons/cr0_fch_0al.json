{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cr0_fch_0al","canonical_person_id":"cr0_fch_0al","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["cr0_fch_0al"],"persons":[{"id":"cr0_fch_0al","label":"高璉（高麗國王）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"高璉","mention_ids":["c-nanqishu-058-southern-and-eastern-complete:p012:m0022","c-nanqishu-058-southern-and-eastern-complete:p015:m0000"]}],"evidence":[{"mention_id":"c-nanqishu-058-southern-and-eastern-complete:p012:m0022","paragraph_id":"c-nanqishu-058-southern-and-eastern-complete:p012","chapter_id":"c-nanqishu-058-southern-and-eastern-complete","quote":"高璉"},{"mention_id":"c-nanqishu-058-southern-and-eastern-complete:p015:m0000","paragraph_id":"c-nanqishu-058-southern-and-eastern-complete:p015","chapter_id":"c-nanqishu-058-southern-and-eastern-complete","quote":"高璉"}],"review":"ai_provisional","identity_note":"高璉（高麗國王），見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-nanqishu-058-southern-and-eastern-complete-ws2638629","work_id":"w-nanqishu","book_id":"b-nanqishu-058","chapter_id":"c-nanqishu-058-southern-and-eastern-complete","raw_mention_count":2,"mention_ids":["c-nanqishu-058-southern-and-eastern-complete:p012:m0022","c-nanqishu-058-southern-and-eastern-complete:p015:m0000"],"paragraph_ids":["c-nanqishu-058-southern-and-eastern-complete:p012","c-nanqishu-058-southern-and-eastern-complete:p015"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-nanqishu-058-southern-and-eastern-complete:p012:m0022","mention_ids":["c-nanqishu-058-southern-and-eastern-complete:p012:m0022"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-058-southern-and-eastern-complete:p015:m0000","mention_ids":["c-nanqishu-058-southern-and-eastern-complete:p015:m0000"],"kind":"paragraph"}],"mention_count":2,"duplicate_mention_count":0,"paragraph_occurrence_count":2,"table_occurrence_count":0,"passage_count":2,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"2處獨立位置，2個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-nanqishu-058-southern-and-eastern-complete-ws2638629"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-nanqishu-058-southern-and-eastern-complete:source_review12-0","kind":"source_review","person_id":"cr0_fch_0al","source_quote":"東夷高麗國，西與魏虜接界。宋末，高麗王樂浪公高璉為使持節、散騎常侍、都督營平二州諸軍事、車騎大將軍、開府儀同三司。太祖建元元年，進號驃騎大將軍。三年，遣使貢獻，乘舶汎海，使驛常通，亦使魏虜，然彊盛不受制。","reading":"高璉在宋末與齊初的使節、軍號按歷朝。建元元年進號在本紀系二年四月。","note":"高璉在宋末與齊初的使節、軍號按歷朝。建元元年進號在本紀系二年四月。","paragraph_id":"c-nanqishu-058-southern-and-eastern-complete:p012","start_codepoint":0,"end_codepoint":102,"human_reviewed":false,"chapter_id":"c-nanqishu-058-southern-and-eastern-complete","source_id":"s-nanqishu-058-southern-and-eastern-complete-ws2638629"},{"id":"c-nanqishu-058-southern-and-eastern-complete:source_review15-0","kind":"source_review","person_id":"cr0_fch_0al","source_quote":"高璉年百餘歲卒。隆昌元年，以高麗王樂浪公高雲為使持節、散騎常侍、都督營平二州諸軍事、征東大將軍、高麗王、樂浪公。建武三年，報功勞勤，實存名烈。假行寧朔將軍臣姐瑾等四人，振竭忠効，攘除國難，志勇果毅，等威名將，可謂扞城，固蕃社稷，論功料勤，宜在甄顯。今依例輒假行職。伏願恩愍，聽除所假。寧朔將軍、面中王姐瑾，歷贊時務，武功竝列，今假行冠軍將軍、都將軍、都漢王。建威將軍、八中侯餘古，弱冠輔佐，忠効夙著，今假行寧朔將軍、阿錯王。建威將軍餘歷，忠款有素，文武列顯，今假行龍驤將軍、邁盧王。廣武將軍餘固，忠効時務，光宣國政，今假行建威將軍、弗斯侯。」","reading":"高璉卒、高雲受任後有先於百濟表的古本缺頁。殿本以空欄示缺，本文註引三種旁證。","note":"高璉卒、高雲受任後有先於百濟表的古本缺頁。殿本以空欄示缺，本文註引三種旁證。","paragraph_id":"c-nanqishu-058-southern-and-eastern-complete:p015","start_codepoint":0,"end_codepoint":271,"human_reviewed":false,"chapter_id":"c-nanqishu-058-southern-and-eastern-complete","source_id":"s-nanqishu-058-southern-and-eastern-complete-ws2638629"},{"id":"c-nanqishu-058-southern-and-eastern-complete:variant_review12-57","kind":"variant_review","person_id":"cr0_fch_0al","source_quote":"太祖建元元年，進號驃騎大將軍","reading":"本傳建元元年。注明本紀繫建元二年四月，官名相合、紀年並存。","note":"本傳建元元年。注明本紀繫建元二年四月，官名相合、紀年並存。","paragraph_id":"c-nanqishu-058-southern-and-eastern-complete:p012","start_codepoint":57,"end_codepoint":71,"human_reviewed":false,"chapter_id":"c-nanqishu-058-southern-and-eastern-complete","source_id":"s-nanqishu-058-southern-and-eastern-complete-ws2638629"},{"id":"c-nanqishu-058-southern-and-eastern-complete:variant_review15-56","kind":"variant_review","person_id":"cr0_fch_0al","source_quote":"建武三年，","reading":"武英殿本第80頁左第3欄作建武三年下小字「此下缺文」，留空欄。第81頁右第9欄以「報功勞勤」逕接百濟表的中段。","note":"武英殿本第80頁左第3欄作建武三年下小字「此下缺文」，留空欄。第81頁右第9欄以「報功勞勤」逕接百濟表的中段。","paragraph_id":"c-nanqishu-058-southern-and-eastern-complete:p015","start_codepoint":56,"end_codepoint":61,"human_reviewed":false,"chapter_id":"c-nanqishu-058-southern-and-eastern-complete","source_id":"s-nanqishu-058-southern-and-eastern-complete-ws2638629"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-qi058-gao-lian-death","person_id":"cr0_fch_0al","event_type":"death","source_term":"卒","source_anchor":{"paragraph_id":"c-nanqishu-058-southern-and-eastern-complete:p015","start":6,"end":7,"surface":"卒"},"date_expression":null,"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-058","chapter_id":"c-nanqishu-058-southern-and-eastern-complete","source_id":"s-nanqishu-058-southern-and-eastern-complete-ws2638629","paragraph_id":"c-nanqishu-058-southern-and-eastern-complete:p015","quote":"高璉年百餘歲卒。隆昌元年，以高麗王樂浪公高雲為使持節、散騎常侍、都督營平二州諸軍事、征東大將軍、高麗王、樂浪公。建武三年，報功勞勤，實存名烈。假行寧朔將軍臣姐瑾等四人，振竭忠効，攘除國難，志勇果毅，等威名將，可謂扞城，固蕃社稷，論功料勤，宜在甄顯。今依例輒假行職。伏願恩愍，聽除所假。寧朔將軍、面中王姐瑾，歷贊時務，武功竝列，今假行冠軍將軍、都將軍、都漢王。建威將軍、八中侯餘古，弱冠輔佐，忠効夙著，今假行寧朔將軍、阿錯王。建威將軍餘歷