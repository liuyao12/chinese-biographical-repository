rpretation_note":"保存本篇明示子、生、妻、兄弟及祖先原稱；不由繼位補父子，不把舜／禹之後改直接父親，不補世系闕代或同父同母。未核底本與現代研究，來源主張不表示已確證史實。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji036-064","person_id":"tjg_uab_cmw","surfaces":["蔡女"],"scope":"same_chapter","chapter_ids":["c-shiji-036-chenqi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-036-chenqi:p006","quote":"文公元年，取蔡女，生子佗。十年，文公卒，長子桓公鮑立。"},{"paragraph_id":"c-shiji-036-chenqi:p008","quote":"三十八年正月甲戌己丑，桓公鮑卒。桓公弟佗，其母蔡女，故蔡人為佗殺五父及桓公太子免而立佗，是為厲公。桓公病而亂作，國人分散，故再赴。"}],"rationale":"文公取蔡女所生佗及桓公弟佗之母蔡女的同一生母記事相接；厲公另取蔡女是另一婚姻角色，兩女分候選，亦不按蔡女字樣連齊桓公蔡姬。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-036-chenqi:p006","text":"文公元年，取蔡女，生子佗。十年，文公卒，長子桓公鮑立。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-036-chenqi:m006-0000","start":0,"end":2,"surface":"文公","kind":"person","person_id":"lmu_nbm_rzo_A","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m006-0006","start":6,"end":8,"surface":"蔡女","kind":"person","person_id":"tjg_uab_cmw","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m006-0011","start":11,"end":12,"surface":"佗","kind":"person","person_id":"lmu_nbm_rzo_AA","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m006-0016","start":16,"end":18,"surface":"文公","kind":"person","person_id":"lmu_nbm_rzo_A","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m006-0022","start":22,"end":25,"surface":"桓公鮑","kind":"person","person_id":"lmu_nbm_rzo_AB","status":"contextual_provisional"}],"chapter_id":"c-shiji-036-chenqi","book_id":"b-shiji-036","work_id":"w-shiji","source_id":"s-shiji-036-chenqi"},{"id":"c-shiji-036-chenqi:p008","text":"三十八年正月甲戌己丑，桓公鮑卒。桓公弟佗，其母蔡女，故蔡人為佗殺五父及桓公太子免而立佗，是為厲公。桓公病而亂作，國人分散，故再赴。","annotation_status":"named_mentions_first_pass","text_layer":"receiv