,"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-064-puyangxing-complete:p003:m0009","surface":"嚴密","start":9,"end":11,"kind":"person","person_id":"xnc_bzn_tt4","status":"contextual_provisional","paragraph_id":"c-sanguozhi-064-puyangxing-complete:p003","chapter_id":"c-sanguozhi-064-puyangxing-complete"}],"relations":[],"title_holdings":[{"id":"th-sanguozhi-064-puyangxing-complete-3-7","title":"都尉","kind":"office","mode":"attestation","person_id":"xnc_bzn_tt4","attestations":[{"id":"th-sanguozhi-064-puyangxing-complete-3-7:a","paragraph_id":"c-sanguozhi-064-puyangxing-complete:p003","start":7,"end":9,"surface":"都尉","person_mention_id":"c-sanguozhi-064-puyangxing-complete:p003:m0009","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-064","chapter_id":"c-sanguozhi-064-puyangxing-complete","source_id":"s-sanguozhi-064-puyangxing-complete-ws2263487","paragraph_id":"c-sanguozhi-064-puyangxing-complete:p003","quote":"　　永安三年，都尉嚴密建丹楊湖田，作浦裡塘。詔百官會議，咸以為用功多而田不保成，唯興以為可成。遂會諸兵民就作，功傭之費不可勝數，士卒死亡，或自賊殺，百姓大怨之。興遷為丞相，與休寵臣左將軍張共布相表裡，邦內失望。七年七月，休薨。左典軍萬彧素與烏程侯孫皓善，乃勸興、布，於是興、布廢休適子而迎立皓。皓既踐阼，加興侍中，領青州牧。俄彧譖興、布追悔前事。十一月朔入朝，皓因收興、布，徙廣州，道追殺之，夷三族。","person_mention_id":"c-sanguozhi-064-puyangxing-complete:p003:m0009"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-064-puyangxing-complete:p003","text":"　　永安三年，都尉嚴密建丹楊湖田，作浦裡塘。詔百官會議，咸以為用功多而田不保成，唯興以為可成。遂會諸兵民就作，功傭之費不可勝數，士卒死亡，或自賊殺，百姓大怨之。興遷為丞相，與休寵臣左將軍張共布相表裡，邦內失望。七年七月，休薨。左典軍萬彧素與烏程侯孫皓善，乃勸興、布，於是興、布廢休適子而迎立皓。皓既踐阼，加興侍中，領青州牧。俄彧譖興、布追悔前事。十一月朔入朝，皓因收興、布，徙廣州，道追殺之，夷三族。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":100,"last_line":100,"raw_start":13674,"raw_end":13896,"raw_character_offsets":[13674,13675,13681,13682,13683,13684,13692,13693,13694,13695,13696,13697,13698,13699,13700,13701,13702,13703,13704,13705,13706,13707,13708,13709,13710,13711,13712,13713,13714,13715,13716,13717,13718,13719,13720,13721,13722,13723,13724,13725,13726,13727,13728,13729,13730,13731,13732,13733,13734,13735,13736,13737,13738,13739,13740,13741,13742,13743,13744,13745,13746,13747,13748,13749,13750,13751,13752,13753,13754,13755,13756,13757,13758,13759,13760,13761,13762,13763,13764,13765,13766,13767,13768,13769,13770,13771,13772,13773,13774,13775,13776,13777,13778,13779,13780,13781,13782,13783,13784,13785,13786,13787,13788,13789,13790,13791,13792,13793,13794,13795,13796,13797,13798,13799,13800,13801,13802,13803,13804,13805,13806,13807,13808,13809,13810,13811,13812,13813,13814,13815,13816,13817,13818,13819,13820,13821,13822,13823,13824,13825,13826,13827,13828,13829,13830,13831,13832,13833,13834,13835,13836,13837,13838,13839,13840,13841,13842,13843,13844,13845,13846,13847,13848,13849,13850,13851,13852,13853,13854,13855,13856,13857,13858,13859,13860,13865,13872,13873,13874,13875,13876,13877,13878,13879,13880,13881,13882,13883,13884,13885,13886,13887,13888,13889,13890,13891,13892,13893,13894,13895],"revision_id":2263487},"mentions":[{"id":"c-sanguozhi-064-puyangxing-complete:p003:m0009","surface":"嚴密","start":9,"end":11,"kind":"person","person_id":"xnc_bzn_tt4","status":"contextual_provisional"},{"id":"c-sanguozhi-064-puyangxing-complete:p003:m0041","surface":"興","start":41,"end":42,"kind":"person","person_id":"u44_7nr_99a","status":"contextual_provisional"},{"id":"c-sanguozhi-064-puyangxing-complete:p003:m0080","surface":"興","start":80,"