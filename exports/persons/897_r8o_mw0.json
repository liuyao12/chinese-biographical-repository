retation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-shiji052-034","person_id":"897_r8o_mw0","event_type":"death","status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-052-qidaohui","source_id":"s-shiji-052-qidaohui","paragraph_id":"c-shiji-052-qidaohui:p008","quote":"朱虛侯年二十，有氣力，忿劉氏不得職。嘗入待高后燕飲，高后令朱虛侯劉章為酒吏。章自請曰：「臣，將種也，請得以軍法行酒。」高后曰：「可。」酒酣，章進飲歌舞。已而曰：「請為太后言耕田歌。」高后兒子畜之，笑曰：「顧而父知田耳。若生而為王子，安知田乎？」章曰：「臣知之。」太后曰：「試為我言田。」章曰：「深耕穊種，立苗欲疏，非其種者，鉏而去之。」呂后默然。頃之，諸呂有一人醉，亡酒，章追，拔劍斬之，而還報曰：「有亡酒一人，臣謹行法斬之。」太后左右皆大驚。業已許其軍法，無以罪也。因罷。自是之後，諸呂憚朱虛侯，雖大臣皆依朱虛侯，劉氏為益彊。","person_mention_id":"c-shiji-052-qidaohui:m008-0179"}],"source_term":"章追，拔劍斬之","interpretation_note":"諸呂有一人醉亡酒、後稱亡酒一人為同一未名單指；群體諸呂不全部拆分。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"mentions":[{"id":"c-shiji-052-qidaohui:m008-0179","start":179,"end":181,"surface":"一人","kind":"person","person_id":"897_r8o_mw0","status":"contextual_provisional","paragraph_id":"c-shiji-052-qidaohui:p008","chapter_id":"c-shiji-052-qidaohui"},{"id":"c-shiji-052-qidaohui:m008-0203","start":203,"end":205,"surface":"一人","kind":"person","person_id":"897_r8o_mw0","status":"contextual_provisional","paragraph_id":"c-shiji-052-qidaohui:p008","chapter_id":"c-shiji-052-qidaohui"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-052-qidaohui:p008","text":"朱虛侯年二十，有氣力，忿劉氏不得職。嘗入待高后燕飲，高后令朱虛侯劉章為酒吏。章自請曰：「臣，將種也，請得以軍法行酒。」高后曰：「可。」酒酣，章進飲歌舞。已而曰：「請為太后言耕田歌。」高后兒子畜之，笑曰：「顧而父知田耳。若生而為王子，安知田乎？」章曰：「臣知之。」太后曰：「試為我言田。」章曰：「深耕穊種，立苗欲疏，非其種者，鉏而去之。」呂后默然。頃之，諸呂有一人醉，亡酒，章追，拔劍斬之，而還報曰：「有亡酒一人，臣謹行法斬之。」太后左右皆大驚。業已許其軍法，無以罪也。因罷。自是之後，諸呂憚朱