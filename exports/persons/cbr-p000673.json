-007","subject_person_id":"cbr-p000673","predicate":"father","object_person_id":"cbr-p000678","status":"source_attested","evidence":[{"paragraph_id":"c-shiji-007-xiangyu:p010","quote":"以呂臣為司徒，以其父呂青為令尹","chapter_id":"c-shiji-007-xiangyu","source_id":"s-shiji-007-xiangyu"}],"qualifiers":{"source_term":"父","historicity":"historical_tradition"},"interpretation_note":"只保存本文明示親屬陳述；不推導闕代、同父同母或未見姓名。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji008-007","subject_person_id":"cbr-p000673","predicate":"father","object_person_id":"cbr-p000678","status":"source_attested","evidence":[{"paragraph_id":"c-shiji-008-gaozu:p016","quote":"呂臣為司徒，其父呂青為令尹","chapter_id":"c-shiji-008-gaozu","source_id":"s-shiji-008-gaozu"}],"qualifiers":{"source_term":"父","historicity":"historical_tradition"},"interpretation_note":"僅記原文明示關係，不推導闕代、同父同母或未見姓名。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji007-005","person_id":"cbr-p000673","title":"司徒","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-007-xiangyu","source_id":"s-shiji-007-xiangyu","paragraph_id":"c-shiji-007-xiangyu:p010","quote":"以呂臣為司徒"}],"attestations":[{"id":"th-shiji007-005:a001","paragraph_id":"c-shiji-007-xiangyu:p010","start":34,"end":36,"surface":"司徒","person_mention_id":"c-shiji-007-xiangyu:m010-0031","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-007-xiangyu","source_id":"s-shiji-007-xiangyu","paragraph_id":"c-shiji-007-xiangyu:p010","quote":"以呂臣為司徒"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"保存授號／用稱與有效時段證據；敘事位置不是確定曆日，未知端點不當無限延伸，亦不以卒日補終止。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji008-027","person_id":"cbr-p000673","surfaces":["呂將軍","呂臣"],"scope":"cross_chapter","chapter_ids":["c-shiji-007-xiangyu","c-shiji-008-gaozu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-007-xiangyu:p008","quote":"項梁起東阿，西，（北）［比］至定陶，再破秦軍，項羽等又斬李由，益輕秦，有驕色。宋義乃諫項梁曰：「戰勝而將驕卒惰者敗。今卒少惰矣，秦兵日益，臣為君畏之。」項梁弗聽。乃使宋義使於齊。道遇齊使者高陵君顯，曰：「公將見武信君乎？」曰：「然。」曰：「臣論武信君軍必敗。公徐行即免死，疾行則及禍。」秦果悉起兵益章邯，擊楚軍，大破之定陶，項梁死。沛公、項羽去外黃攻陳留，陳留堅守不能下。沛公、項羽相與謀曰：「今項梁軍破，士卒恐。」乃與呂臣軍俱引兵而東。呂臣軍彭城東，項羽軍彭城西，沛公軍碭。"},{"paragraph_id":"c-shiji-008-gaozu:p014","quote":"項梁再破秦軍，有驕色。宋義諫，不聽。秦益章邯兵，夜銜枚擊項梁，大破之定陶，項梁死。沛公與項羽方攻陳留，聞項梁死，引兵與呂將軍俱東。呂臣軍彭城東，項羽軍彭城西，沛公軍碭。"},{"paragraph_id":"c-shiji-008-gaozu:p016","quote":"秦二世三年，楚懷王見項梁軍破，恐，徙盱臺都彭城，并呂臣、項羽軍自將之。以沛公為碭郡長，封為武安侯，將碭郡兵。封項羽為長安侯，號為魯公。呂臣為司徒，其父呂青為令尹。"}],"rationale":"第14段呂將軍俱東後接呂臣軍彭城東，依軍事行動暫定，不能當成呂姓全域規則。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-007-xiangyu:p008","text":"項梁起東阿，西，（北）［比］至定陶，再破秦軍，項羽等又斬李由，益輕秦，有驕色。宋義乃諫項梁曰：「戰勝而將驕卒惰者敗。今卒少惰矣，秦兵日益，臣為君畏之。」項梁弗聽。乃使宋義使於齊。道遇齊使者高陵君顯，曰：「公將見武信君乎？」曰：「然。」曰：「臣論武信君軍必敗。公徐行即免死，疾行則及禍。」秦果悉起兵益章邯，擊楚軍，大破之定陶，項梁死。沛公、項羽去外黃攻陳留，陳留堅守不能下。沛公、項羽相與謀曰：「今項梁軍破，士卒恐。」乃與呂臣軍俱引兵而東。呂臣軍彭城東，項羽軍彭城西，沛公軍碭。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-007-xiangyu:m008-0000","start":0,"end":2,"surface":"項梁","kind":"person","person_id":"cbr-p000603","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m008-0023","start":23,"end":25,"surface":"項羽","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m008-0028","start":28,"end":30,"surface":"李由","kind":"person","person_id":"cbr-p000670","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m008-0039","start":39,"end":41,"surface":"宋義","kind":"person","person_id":"cbr-p000671","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m008-0043","start":43,"end":45,"surface":"項梁","kind":"person","person_id":"cbr-p000603","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m008-0076","start":76,"end":78,"surface":"項梁","kind":"person","person_id":"cbr-p000603","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m008-0083","start":83,"end":85,"surface":"宋義","kind":"person","person_id":"cbr-p000671","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m008-0091","start":91,"end":94,"surface":"齊使者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱或短稱尚待逐處覆核；不補姓名或推造個別成員。"},{"id":"c-shiji-007-xiangyu:m008-0094","start":94,"end":98,"surface":"高陵君顯","kind":"person","person_id":"cbr-p000672","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m008-0105","start":105,"end":108,"surface":"武信君","kind":"person","person_id":"cbr-p000603","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m008-0122","start":122,"end":125,"surface":"武信君","kind":"person","person_id":"cbr-p000603","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m008-0149","start":149,"end":151,"surface":"章邯","kind":"person","person_id":"cbr-p000605","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m008-0162","start":162,"end":164,"surface":"項梁","kind":"person","person_id":"cbr-p000603","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m008-0166","start":166,"end":168,"surface":"沛公","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m008-0169","start":169,"end":171,"surface":"項羽","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m008-0186","start":186,"end":188,"surface":"沛公","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m008-0189","start":189,"end":191,"surface":"項羽","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m008-0198","start":198,"end":200,"surface":"項梁","kind":"person","person_id":"cbr-p000603","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m008-0210","start":210,"end":212,"surface":"呂臣","kind":"person","person_id":"cbr-p000673","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m008-0219","start":219,"end":221,"surface":"呂臣","kind":"person","person_id":"cbr-p000673","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m008-0226","start":226,"end":228,"surface":"項羽","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m008-0233","start":233,"end":235,"surface":"沛公","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"}],"chapter_id":"c-shiji-007-xiangyu","book_id":"b-shiji-007","work_id":"w-shiji","source_id":"s-shiji-007-xiangyu"},{"id":"c-shiji-007-xiangyu:p010","text":"楚兵已破於定陶，懷王恐，從盱台之彭城，并項羽、呂臣軍自將之。以呂臣為司徒，以其父呂青為令尹。以沛公為碭郡長，封為武安侯，將碭郡兵。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-007-xiangyu:m010-0008","start":8,"end":10,"surface":"懷王","kind":"person","person_id":"cbr-p000682","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m010-0020","start":20,"end":22,"surface":"項羽","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m010-0023","start":23,"end":25,"surface":"呂臣","kind":"person","person_id":"cbr-p000673","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m010-0031","start":31,"end":33,"surface":"呂臣","kind":"person","person_id":"cbr-p000673","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m010-0040","start":40,"end":42,"surface":"呂青","kind":"person","person_id":"cbr-p000678","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m010-0047","start":47,"end":49,"surface":"沛公","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"}],"chapter_id":"c-shiji-007-xiangyu","book_id":"b-shiji-007","work_id":"w-shiji","source_id":"s-shiji-007-xiangyu"},{"id":"c-shiji-008-gaozu:p014","text":"項梁再破秦軍，有驕色。宋義諫，不聽。秦益章邯兵，夜銜枚擊項梁，大破之定陶，項梁死。沛公與項羽方攻陳留，聞項梁死，引兵與呂將軍俱東。呂臣軍彭城東，項羽軍彭城西，沛公軍碭。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-sh