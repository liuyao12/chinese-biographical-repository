","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p044","chapter_id":"c-shiji-005-qin"}],"relations":[{"id":"a-shiji005-055","subject_person_id":"cbr-p000420","predicate":"father","object_person_id":"cbr-p000414","status":"source_attested","evidence":[{"paragraph_id":"c-shiji-005-qin:p043","quote":"景公立四十年卒，子哀公立","chapter_id":"c-shiji-005-qin","source_id":"s-shiji-005-qin"}],"qualifiers":{"source_term":"子","historicity":"historical_tradition"},"interpretation_note":"保存本文明示親屬主張；母弟原詞保留，不另補母親姓名。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji005-056","subject_person_id":"cbr-p000427","predicate":"father","object_person_id":"cbr-p000420","status":"source_attested","evidence":[{"paragraph_id":"c-shiji-005-qin:p044","quote":"哀公立三十六年卒。太子夷公","chapter_id":"c-shiji-005-qin","source_id":"s-shiji-005-qin"}],"qualifiers":{"source_term":"太子","historicity":"historical_tradition"},"interpretation_note":"保存本文明示親屬主張；母弟原詞保留，不另補母親姓名。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-005-qin:p043","text":"景公四年，晉欒書弒其君厲公。十五年，救鄭，敗晉兵於櫟。是時晉悼公為盟主。十八年，晉悼公彊，數會諸侯，率以伐秦，敗秦軍。秦軍走，晉兵追之，遂渡涇，至棫林而還。二十七年，景公如晉，與平公盟，已而背之。三十六年，楚公子圍弒其君而自立，是為靈王。景公母弟後子鍼有寵，景公母弟富，或譖之，恐誅，乃奔晉，車重千乘。晉平公曰：「后子富如此，何以自亡？」對曰：「秦公無道，畏誅，欲待其後世乃歸。」三十九年，楚靈王彊，會諸侯於申，為盟主，殺齊慶封。景公立四十年卒，子哀公立。后子復來歸秦。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m043-0000","start":0,"end":2,"surface":"景公","kind":"person","person_id":"cbr-p000414","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0005","start":5,"end":8,"surface":"晉欒書","kind":"person","person_id":"cbr-p000415","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0009","start":9,"end":11,"surface":"其君","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或待核指代；不由官稱或熟知世系補造個人。"},{"id":"c-shiji-005-qin:m043-0011","start":11,"end":13,"surface":"厲公","kind":"person","person_id":"cbr-p000260","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0029","start":29,"end":32,"surface":"晉悼公","kind":"person","person_id":"cbr-p000261","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0040","start":40,"end":43,"surface":"晉悼公","kind":"person","person_id":"cbr-p000261","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0083","start":83,"end":85,"surface":"景公","kind":"person","person_id":"cbr-p000414","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0089","start":89,"end":91,"surface":"平公","kind":"person","person_id":"cbr-p000416","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0103","start":103,"end":107,"surface":"楚公子圍","kind":"person","person_id":"cbr-p000417","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0108","start":108,"end":110,"surface":"其君","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或待核指代；不由官稱或熟知世系補造個人。"},{"id":"c-shiji-005-qin:m043-0116","start":116,"end":118,"surface":"靈王","kind":"person","person_id":"cbr-p000417","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0119","start":119,"end":121,"surface":"景公","kind":"person","person_id":"cbr-p000414","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0123","start":123,"end":126,"surface":"後子鍼","kind":"person","person_id":"cbr-p000418","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0129","start":129,"end":131,"surface":"景公","kind":"person","person_id":"cbr-p000414","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0151","start":151,"end":154,"surface":"晉平公","kind":"person","person_id":"cbr-p000416","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0157","start":157,"end":159,"surface":"后子","kind":"person","person_id":"cbr-p000418","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0173","start":173,"end":175,"surface":"秦公","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或待核指代；不由官稱或熟知世系補造個人。"},{"id":"c-shiji-005-qin:m043-0195","start":195,"end":198,"surface":"楚靈王","kind":"person","person_id":"cbr-p000417","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0211","start":211,"end":214,"surface":"齊慶封","kind":"person","person_id":"cbr-p000419","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0215","start":215,"end":217,"surface":"景公","kind":"person","person_id":"cbr-p000414","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0224","start":224,"end":226,"surface":"哀公","kind":"person","person_id":"cbr-p000420","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0228","start":228,"end":230,"surface":"后子","kind":"person","person_id":"cbr-p000418","status":"contextual_provisional"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-005-qin:p044","text":"哀公八年，楚公子棄疾弒靈王而自立，是為平王。十一年，楚平王來求秦女為太子建妻。至國，女好而自娶之。十五年，楚平王欲誅建，建亡；伍子胥奔吳。晉公室卑而六卿彊，欲內相攻，是以久秦晉不相攻。三十一年，吳王闔閭與伍子胥伐楚，楚王亡奔隨，吳遂入郢。楚大夫申包胥來告急，七日不食，日夜哭泣。於是秦乃發五百乘救楚，敗吳師。吳師歸，楚昭王乃得復入郢。哀公立三十六年卒。太子夷公，夷公蚤死，不得立，立夷公子，是為惠公。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m044-0000","start":0,"end":2,"surface":"哀公","kind":"person","person_id":"cbr-p000420","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m044-0005","start":5,"end":10,"surface":"楚公子棄疾","kind":"person","person_id":"cbr-p000421","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m044-0011","start":11,"end":13,"surface":"靈王","kind":"person","person_id":"cbr-p000417","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m044-0019","start":19,"end":21,"surface":"平王","kind":"person","person_id":"cbr-p000421","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m044-0026","start":26,"end":29,"surface":"楚平王","kind":"person","person_id":"cbr-p000421","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m044-0031","start":31,"end":33,"surface":"秦女","kind":"unresolved","person_i