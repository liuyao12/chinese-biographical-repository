":[{"id":"c-shiji-039-jin:m124-0000","start":0,"end":2,"surface":"昭公","kind":"person","person_id":"0ad_dbw_97q","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m124-0015","start":15,"end":19,"surface":"頃公去疾","kind":"person","person_id":"1wp_coh_osw","status":"contextual_provisional"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"},{"id":"c-shiji-039-jin:p133","text":"出公十七年，知伯與趙、韓、魏共分范、中行地以爲邑。出公怒，告齊、魯，欲以伐四卿。四卿恐，遂反攻出公。出公奔齊，道死。故知伯乃立昭公曾孫驕爲晉君，是爲哀公。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m133-0000","start":0,"end":2,"surface":"出公","kind":"person","person_id":"6zc_puw_3ua","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m133-0006","start":6,"end":8,"surface":"知伯","kind":"person","person_id":"fks_8ov_okp","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m133-0009","start":9,"end":14,"surface":"趙、韓、魏","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m133-0025","start":25,"end":27,"surface":"出公","kind":"person","person_id":"6zc_puw_3ua","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m133-0037","start":37,"end":39,"surface":"四卿","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m133-0040","start":40,"end":42,"surface":"四卿","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m133-0047","start":47,"end":49,"surface":"出公","kind":"person","person_id":"6zc_puw_3ua","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m133-0050","start":50,"end":52,"surface":"出公","kind":"person","person_id":"6zc_puw_3ua","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m133-0059","start":59,"end":61,"surface":"知伯","kind":"person","person_id":"fks_8ov_okp","status":"contextual_provisional