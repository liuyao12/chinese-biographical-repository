":"c-nanqishu-041-zhouyong-complete:p002:m0023","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-041","chapter_id":"c-nanqishu-041-zhouyong-complete","source_id":"s-nanqishu-041-zhouyong-complete-ws2044621","paragraph_id":"c-nanqishu-041-zhouyong-complete:p002","quote":"　　顒少爲族祖朗所知。解褐海陵國侍郎。益州刺史蕭惠開賞異顒，攜入蜀，爲厲鋒將軍，帶肥郷、成都二縣令。轉惠開輔國府參軍，將軍、令如故。仍爲府主簿。常謂惠開性太險峻，每致諫，惠開不悅，答顒曰：「天險地險，王公設險，但問用險何如耳。」隨惠開還都。","person_mention_id":"c-nanqishu-041-zhouyong-complete:p002:m0023"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-041-zhouyong-complete:p002","text":"　　顒少爲族祖朗所知。解褐海陵國侍郎。益州刺史蕭惠開賞異顒，攜入蜀，爲厲鋒將軍，帶肥郷、成都二縣令。轉惠開輔國府參軍，將軍、令如故。仍爲府主簿。常謂惠開性太險峻，每致諫，惠開不悅，答顒曰：「天險地險，王公設險，但問用險何如耳。」隨惠開還都。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":73,"last_line":73,"raw_start":5844,"raw_end":5964,"raw_character_offsets":[5844,5845,5846,5847,5848,5849,5850,5851,5852,5853,5854,5855,5856,5857,5858,5859,5860,5861,5862,5863,5864,5865,5866,5867,5868,5869,5870,5871,5872,5873,5874,5875,5876,5877,5878,5879,5880,5881,5882,5883,5884,5885,5886,5887,5888,5889,5890,5891,5892,5893,5894,5895,5896,5897,5898,5899,5900,5901,5902,5903,5904,5905,5906,5907,5908,5909,5910,5911,5912,5913,5914,5915,5916,5917,5918,5919,5920,5921,5922,5923,5924,5925,5926,5927,5928,5929,5930,5931,5932,5933,5934,5935,5936,5937,5938,5939,5940,5941,5942,5943,5944,5945,5946,5947,5948,5949,5950,5951,5952,5953,5954,5955,5956,5957,5958,5959,5960,5961,5962,5963],"revision_id":2044621},"mentions":[{"id":"c-nanqishu-041-