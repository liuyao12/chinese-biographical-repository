rt":0,"end":3,"surface":"孝文帝","kind":"person","person_id":"cbr-p003460","status":"contextual_provisional","paragraph_id":"c-shiji-056-chen:p026","chapter_id":"c-shiji-056-chen"}],"relations":[],"title_holdings":[{"id":"th-shiji056-047","person_id":"cbr-p003460","title":"孝文皇帝","kind":"royal_rank","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-056-chen","source_id":"s-shiji-056-chen","paragraph_id":"c-shiji-056-chen:p023","quote":"呂太后立諸呂爲王，陳平僞聽之。及呂太后崩，平與太尉勃合謀，卒誅諸呂，立孝文皇帝，陳平本謀也。審食其免相。"}],"attestations":[{"id":"th-shiji056-047:a001","paragraph_id":"c-shiji-056-chen:p023","start":35,"end":39,"surface":"孝文皇帝","person_mention_id":"c-shiji-056-chen:m023-0035","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-056-chen","source_id":"s-shiji-056-chen","paragraph_id":"c-shiji-056-chen:p023","quote":"呂太后立諸呂爲王，陳平僞聽之。及呂太后崩，平與太尉勃合謀，卒誅諸呂，立孝文皇帝，陳平本謀也。審食其免相。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"楚漢授官、爵秩、任事、左右丞相與死後用稱分存；未知端點不由首見、死亡或獨當相職推定。行事與兼職性質、古稱及來源差異仍待制度與版本覆核。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji056-043","person_id":"cbr-p003460","surfaces":["上","孝文帝","孝文皇帝"],"scope":"same_chapter","chapter_ids":["c-shiji-056-chen"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-056-chen:p023","quote":"呂太后立諸呂爲王，陳平僞聽之。及呂太后崩，平與太尉勃合謀，卒誅諸呂，立孝文皇帝，陳平本謀也。審食其免相。"},{"paragraph_id":"c-shiji-056-chen:p024","quote":"孝文帝立，以爲太尉勃親以兵誅呂氏，功多；陳平欲讓勃尊位，乃謝病。孝文帝初立，怪平病，問之。平曰：「高祖時，勃功不如臣平。及誅諸呂，臣功亦不如勃。願以右丞相讓勃。」於是孝文帝乃以絳侯勃爲右丞相，位次第一；平徙爲左丞相，位次第二。賜平金千斤，益封三千戸。"},{"paragraph_id":"c-shiji-056-chen:p025","quote":"居頃之，孝文皇帝既益明習國家事，朝而問右丞相勃曰：「天下一歳決獄幾何？」勃謝曰：「不知。」問：「天下一歳錢穀出入幾何？」勃又謝不知，汗出沾背，愧不能對。於是上亦問左丞相平。平曰：「有主者。」上曰：「主者謂誰？」平曰：「陛下即問決獄，責廷尉；問錢穀，責治粟內史。」上曰：「苟各有主者，而君所主者何事也？」平謝曰：「主臣！陛下不知其駑下，使待罪宰相。宰相者，上佐天子理陰陽，順四時，下育萬物之宜，外鎮撫四夷諸侯，內親附百姓，使卿大夫各得任其職焉。」孝文帝乃稱善。右丞相大慚，出而讓陳平曰：「君獨不素教我對！」陳平笑曰：「君居其位，不知其任邪？且陛下即問長安中盜賊數，君欲彊對邪？」於是絳侯自知其能不如平遠矣。居頃之，絳侯謝病請免相，陳平專爲一丞相。"},{"paragraph_id":"c-shiji-056-chen:p026","quote":"孝文帝二年，丞相陳平卒，諡爲獻侯。子共侯買代侯。二年卒，子簡侯恢代侯。二十三年卒，子何代侯。二十三年，何坐略人妻，棄市，國除。"}],"rationale":"依本篇明示名字、局部主語、授官爵與家世暫接。平城與負郭不作短名，韓王信與淮陰侯韓信、審食其與酈食其分開。上依高帝與孝文帝敘事換主語，指控與古代比擬不當已驗史實；未名者不補全名，女孫父親不由婚議推定。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-056-chen:p023","text":"呂太后立諸呂爲王，陳平僞聽之。及呂太后崩，平與太尉勃合謀，卒誅諸呂，立孝文皇帝，陳平本謀也。審食其免相。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-056-chen:m023-0000","start":0,"end":3,"surface":"呂太后","kind":"person","person_id":"cbr-p003451","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m023-0004","start":4,"end":6,"surface":"諸呂","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、泛稱官職、氏族或代詞待覆核，不補姓名或未見家屬。"},{"id":"c-shiji-056-chen:m023-0009","start":9,"end":11,"surface":"陳平","kind":"person","person_id":"cbr-p003418","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m023-0016","start":16,"end":19,"surface":"呂太后","kind":"person","person_id":"cbr-p003451","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m023-0021","start":21,"end":22,"surface":"平","kind":"person","person_id":"cbr-p003418","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m023-0023","start":23,"end":26,"surface":"太尉勃","kind":"person","person_id":"cbr-p003434","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m023-0031","start":31,"end":33,"surface":"諸呂","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、泛稱官職、氏族或代詞待覆核，不補姓名或未見家屬。"},{"id":"c-shiji-056-chen:m023-0035","start":35,"end":39,"surface":"孝文皇帝","kind":"person","person_id":"cbr-p003460","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m023-0040","start":40,"end":42,"surface":"陳平","kind":"person","person_id":"cbr-p003418","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m023-0046","s