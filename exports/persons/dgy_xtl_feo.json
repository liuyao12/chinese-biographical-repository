editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-songshu-059-zhangchang:p008:m0467","start":467,"end":470,"surface":"程天福","kind":"person","person_id":"dgy_xtl_feo","status":"contextual_provisional","interpretation_note":"完整張暢本傳及對話語境判讀；同字不跨篇自動合人，未圖校。","paragraph_id":"c-songshu-059-zhangchang:p008","chapter_id":"c-songshu-059-zhangchang"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-songshu-059-zhangchang:p008","text":"燾復遣使令孝伯傳語曰魏主有詔語太尉安北近以騎至車兩在後今端坐無為有博具可見借暢曰博具當為申啟但向語二王已非遜辭且有詔之言政可施於彼國何得稱之於此孝伯曰詔之與語朕之與我並有何異暢曰若辭以通可如来談既言有所施則貴賤有等向所稱詔非所敢聞孝伯又曰太尉安北是人臣與非暢曰是也孝伯曰隣國之君何為不稱詔於隣國之臣暢曰君之此稱尚不可聞於中華况在諸王之貴而猶曰隣國之君邪孝伯曰魏主言太尉鎮軍並皆年少乆濶南信殊當憂邑若欲遣信者當為䕶送脫須騎者亦當以馬送之暢曰此方間路甚多使命日夕往来不復以此勞魏主孝伯曰亦知有水路似為白賊所斷暢曰君著白衣故稱白賊邪孝伯大笑曰今之白賊亦不異黄巾赤眉暢曰黄巾赤眉似不在江南孝伯曰雖不在江南亦不在青徐也暢曰今者青徐實為有賊但非白賊耳虜使云向借博具何故不出暢曰二王貴逺啟聞難徹孝伯曰周公握髮吐哺二王何獨貴逺暢曰握髪吐飡本施中國耳孝伯曰賔有禮主則擇之暢曰昨見衆賔至門未為有禮俄頃送博具出因以與之燾又遣人云魏王致意安北程天祚一介常人誠知非宋朝之羙近於汝陽身𬒳九創落在殿外我手牽而出之凡人骨肉分張並思集聚輙已語之但其弟苦辭今令與来使相見程天福謂使人曰兄受命汝陽不能死節各在一國何煩相見","mentions":[{"id":"c-songshu-059-zhangchang:p008:m0000","start":0,"end":1,"surface":"燾","kind":"person","person_id":"d10_1e6_850","status":"contextual_provisional","interpretation_note":"完整張暢本傳及對話語境判讀；同字不跨篇自動合人，未圖校。"},{"id":"c-songshu-059-zhangchang:p008:m0005","start":5,"end":7,"surface":"孝伯","kind":"person","person_id":"ecc_b5b_2f4","status":"contextual_provisional","interpretation_note":"完整張暢本傳及對話語境判讀；同字不跨篇自動合人，未圖校。"},{"id":"c-songshu-059-zhangchang:p008:m0010","start":10,"end":12,"surface":"魏主","kind":"person","person_id":"d10_1e6_850","status":"contextual_provisional","interpretation_note":"完整張暢本傳及對話語境判讀；同字不跨篇自動合人，未圖校。"},{"id":"c-songshu-059-zhangchang:p008:m0015","start":15,"end":17,"surface":"太尉","kind":"person","person_id":"2n6_7xk_5ov","status":"co