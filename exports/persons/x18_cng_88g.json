sertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"kind":"person","person_id":"x18_cng_88g","start":157,"end":159,"surface":"鄭默","id":"c-jinshu-045-guoyi:p001:m0024","status":"contextual_provisional","resolution_note":"依本傳完整敘事、引語與039共同事件辨識；泛稱官署/引書篇本未定者留未解。","paragraph_id":"c-jinshu-045-guoyi:p001","chapter_id":"c-jinshu-045-guoyi"}],"relations":[],"title_holdings":[{"id":"th-jin045-guoyi-005","person_id":"x18_cng_88g","title":"中庶子","kind":"office","mode":"grant","appointment_role":"paired_appointment","status":"source_attested","source_career_role":{"kind":"punctuated_biography_career_frame","rule":"paired_and_promoted","paragraph_id":"c-jinshu-045-guoyi:p001","source_revision":2595687,"paragraph_sha256":"04aac0d8f0b77dae77c7c9739473a61a894296ddac84273c62300f7167fc2bad","head_mention_id":"c-jinshu-045-guoyi:p001:m0000","scope_anchor":{"paragraph_id":"c-jinshu-045-guoyi:p001","start":144,"end":180,"surface":"武帝踐阼，初建東宮，以奕及鄭默並為中庶子。遷右衛率、驍騎將軍，封平陵男。"},"roles":{"ruler":"c-jinshu-045-guoyi:p001:m0022","subject":"c-jinshu-045-guoyi:p001:m0023","colleague":"c-jinshu-045-guoyi:p001:m0024"},"fields":{"office":{"paragraph_id":"c-jinshu-045-guoyi:p001","start":161,"end":164,"surface":"中庶子"},"office2":{"paragraph_id":"c-jinshu-045-guoyi:p001","start":166,"end":169,"surface":"右衛率"},"office3":{"paragraph_id":"c-jinshu-045-guoyi:p001","start":170,"end":174,"surface":"驍騎將軍"},"rank":{"paragraph_id":"c-jinshu-045-guoyi:p001","start":176,"end":179,"surface":"平陵男"}},"human_reviewed":false,"slot":"office","recipient_role":"colleague"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-045","source_id":"s-jinshu-045-ws2595687-guoyi","chapter_id":"c-jinshu-045-guoyi","paragraph_id":"c-jinshu-045-guoyi:p001","quote":"郭奕，字大業，太原陽曲人也。少有重名，山濤稱其高簡有雅量。初為野王令，羊祜常過之，奕歎曰：「羊叔子何必減郭大業！」少選復往，又歎曰：「羊叔子去人遠矣。」遂送祜出界數百里，坐此免官。咸熙末，為文帝相國主薄。時鍾會反于蜀，荀勖即會之從甥，少長會家，勖為文帝掾，奕啟出之。帝雖不用，然知其雅正。武帝踐阼，初建東宮，以奕及鄭默並為中庶子。遷右衛率、驍騎將軍，封平陵男。咸寧初，遷雍州刺史、鷹揚將軍，尋假赤幢曲蓋、鼓吹。奕有寡姊，隨奕之官，姊下僮僕多有奸犯，而為人所糾。奕省按畢，曰：「大丈夫豈當以老姊求名？」遂遣而不問。時亭長李含有俊才，而門寒為豪族所排，奕用為別駕，含後果有名位，時以奕為知人。","person_mention_id":"c-jinshu-045-guoyi:p001:m0024"}],"attestations":[{"id":"th-jin045-guoyi-005:a001","paragraph_id":"c-jinshu-045-guoyi:p001","start":161,"end":164,"surface":"中庶子","person_mention_id":"c-jinshu-045-guoyi:p001:m0024","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-045","source_id":"s-jinshu-045-ws2595687-guoyi","chapter_id":"c-jinshu-045-guoyi","paragraph_id":"c-jinshu-045-guoyi:p001","quote":"郭奕，字大業，太原陽曲人也。少有重名，山濤稱其高簡有雅量。初為野王令，羊祜常過之，奕歎曰：「羊叔子何必減郭大業！」少選復往，又歎曰：「羊叔子去人遠矣。」遂送祜出界數百里，坐此免官。咸熙末，為文帝相國主薄。時鍾會反于蜀，荀勖即會之從甥，少長會家，勖為文帝掾，奕啟出之。帝雖不用，然知其雅正。武帝踐阼，初建東宮，以奕及鄭默並為中庶子。遷右衛率、驍騎將軍，封平陵男。咸寧初，遷雍州刺史、鷹揚將軍，尋假赤幢曲蓋、鼓吹。奕有寡姊，隨奕之官，姊下僮僕多有奸犯，而為人所糾。奕省按畢，曰：「大丈夫豈當以老姊求名？」遂遣而不問。時亭長李含有俊才，而門寒為豪族所排，奕用為別駕，含後果有名位，時以奕為知人。","person_mention_id":"c-jinshu-045-guoyi:p001:m0024"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"按完整官序原角色及原字保存。任終未知，不借卒年；咸熙末未推鍾會反日期；儀仗為許可而非官爵；簡為實賜，景穆另存提議。","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-045-guoyi:p001","text":"郭奕，字大業，太原陽曲人也。少有重名，山濤稱其高簡有雅量。初為野王令，羊祜常過之，奕歎曰：「羊叔子何必減郭大業！」少選復往，又歎曰：「羊叔子去人遠矣。」遂送祜出界數百里，坐此免官。咸熙末，為文帝相國主薄。時鍾會反于蜀，荀勖即會之從甥，少長會家，勖為文帝掾，奕啟出之。帝雖不用，然知其雅正。武帝踐阼，初建東宮，以奕及鄭默並為中庶子。遷右衛率、驍騎將軍，封平陵男。咸寧初，遷雍州刺史、鷹揚將軍，尋假赤幢曲蓋、鼓吹。奕有寡姊，隨奕之官，姊下僮僕多有奸犯，而為人所糾。奕省按畢，曰：「大丈夫豈當以老姊求名？」遂遣而不問。時亭長李含有俊才，而門寒為豪族所排，奕用為別駕，含後果有名位，時以奕為知人。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"kind":"person","person_id":"64e_ce8_aba","start":0,"end":2,"surface":"郭奕","id":"c-jinshu-045-guoyi:p001:m0000","status":"contextual_provisional","resol