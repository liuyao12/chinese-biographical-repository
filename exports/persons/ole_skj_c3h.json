{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"ole_skj_c3h","canonical_person_id":"ole_skj_c3h","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["ole_skj_c3h"],"persons":[{"id":"ole_skj_c3h","label":"應誕","aliases":[{"surface":"應誕","mention_ids":["c-jinshu-073-yuyi-ws2296501-rendered:p011:m0228"]}],"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-073","chapter_id":"c-jinshu-073-yuyi-ws2296501-rendered","source_id":"s-jinshu073-yuyi-ws2296501-rendered","paragraph_id":"c-jinshu-073-yuyi-ws2296501-rendered:p011","mention_id":"c-jinshu-073-yuyi-ws2296501-rendered:p011:m0228","quote":"應誕"}],"status":"active","identity_note":"本篇來源角色：翼司馬，襄陽太守；原字及異文分層，不補未知父母/生年。","review":"ai_provisional"}],"source_mention_summary":[{"source_id":"s-jinshu073-yuyi-ws2296501-rendered","work_id":"w-jinshu","book_id":"b-jinshu-073","chapter_id":"c-jinshu-073-yuyi-ws2296501-rendered","raw_mention_count":1,"mention_ids":["c-jinshu-073-yuyi-ws2296501-rendered:p011:m0228"],"paragraph_ids":["c-jinshu-073-yuyi-ws2296501-rendered:p011"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-073-yuyi-ws2296501-rendered:p011:m0228","mention_ids":["c-jinshu-073-yuyi-ws2296501-rendered:p011:m0228"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu073-yuyi-ws2296501-rendered"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"id":"name-jin073-yuyi-yingdan","person_id":"ole_skj_c3h","surname":"應","ming":"誕","additional_names":[],"chapter_id":"c-jinshu-073-yuyi-ws2296501-rendered","paragraph_id":"c-jinshu-073-yuyi-ws2296501-rendered:p011","person_mention_id":"c-jinshu-073-yuyi-ws2296501-rendered:p011:m0228","source_anchor":{"paragraph_id":"c-jinshu-073-yuyi-ws2296501-rendered:p011","start":228,"end":230,"surface":"應誕"},"quote":"翼時有眾四萬，詔加都督征討軍事。師次襄陽，大會僚佐，陳旌甲，親授弧矢，曰：「我之行也，若此射矣。」遂三起三疊，徒眾屬目，其氣十倍。初，翼遷襄陽，舉朝謂之不可，議者或謂避衰，唯兄冰意同，桓溫及譙王無忌贊成其計。至是，冰求鎮武昌，為翼繼援。朝議謂冰不宜出，冰乃止。又進翼征西將軍，領南蠻校尉。胡賊五六百騎出樊城，翼遣冠軍將軍曹據追擊於撓溝北，破之，死者近半，獲馬百匹。翼綏來荒遠，務盡招納之宜，立客館，置典賓參軍。桓宣卒，翼以長子方之為義成太守，代領宣眾，司馬應誕為龍驤將軍、襄陽太守，參軍司勳為建威將軍、梁州刺史，戍西城。康帝崩，兄冰卒，以家國情事，留方之戍襄陽，還鎮夏口，悉取冰所領兵自配，以兄子統為尋陽太守。詔使翼還督江州，又領豫州刺史，辭豫州。復欲移鎮樂鄉，詔不許。繕修軍器，大佃積穀，欲圖後舉。遣益州刺史周撫、西陽太守曹據伐蜀，破蜀將李桓于江陽。","status":"editorial_provisional","human_reviewed":false,"model":null,"note":"literal source name; title/role is not ming; no unsupported courtesy name.","work_id":"w-jinshu","book_id":"b-jinshu-073","source_id":"s-jinshu073-yuyi-ws2296501-rendered"}],"mentions":[{"id":"c-jinshu-073-yuyi-ws2296501-rendered:p011:m0228","start":228,"end":230,"surface":"應誕","kind":"person","person_id":"ole_skj_c3h","status":"contextual_provisional","source_identity_role":"yingdan","identity_reading_ref":"source-evidence/jin073-yuyi-ws2296501/textual-decisions.json#yingdan","paragraph_id":"c-jinshu-073-yuyi-ws2296501-rendered:p011","chapter_id":"c-jinshu-073-yuyi-ws2296501-rendered"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-jin073-yuyi-yingdan","person_id":"ole_skj_c3h","scope":"same_chapter","sur