:"c-shiji-046-tian:m054-0014","start":14,"end":16,"surface":"后勝","kind":"person","person_id":"9oc_37g_jlc","status":"contextual_provisional","paragraph_id":"c-shiji-046-tian:p054","chapter_id":"c-shiji-046-tian"},{"id":"c-shiji-046-tian:m054-0117","start":117,"end":119,"surface":"后勝","kind":"person","person_id":"9oc_37g_jlc","status":"contextual_provisional","paragraph_id":"c-shiji-046-tian:p054","chapter_id":"c-shiji-046-tian"},{"id":"c-shiji-088-mengtian:m008-0050","start":50,"end":52,"surface":"后勝","kind":"person","person_id":"9oc_37g_jlc","status":"contextual_provisional","paragraph_id":"c-shiji-088-mengtian:p008","chapter_id":"c-shiji-088-mengtian"}],"relations":[],"title_holdings":[{"id":"th-shiji046-051","person_id":"9oc_37g_jlc","title":"相","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-046-tian","source_id":"s-shiji-046-tian","paragraph_id":"c-shiji-046-tian:p054","quote":"四十四年，秦兵撃齊。齊王聽相后勝計，不戰，以兵降秦。秦虜王建，遷之共。遂滅齊爲郡。天下壹并於秦，秦王政立號爲皇帝。始，君王后賢，事秦謹，與諸侯信，齊亦東邊海上，秦日夜攻三晉、燕、楚，五國各自救於秦，以故王建立四十餘年不受兵。君王后死，后勝相齊，多受秦閒金，多使賓客入秦，秦又多予金，客皆爲反閒，勸王去從朝秦，不修攻戰之備，不助五國攻秦，秦以故得滅五國。五國已亡，秦兵卒入臨淄，民莫敢格者。王建遂降，遷於共。故齊人怨王建不蚤與諸侯合從攻秦，聽姦臣賓客以亡其國，歌之曰：「松耶柏耶？住建共者客耶？」疾建用客之不詳也。"}],"attestations":[{"id":"th-shiji046-051:a001","paragraph_id":"c-shiji-046-tian:p054","start":13,"end":14,"surface":"相","person_mention_id":"c-shiji-046-tian:m054-0014","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予、任事與文獻用稱分存；欲使為卿且辭未當已任，諡稱不當生前任職，死亡或首次用稱不補任期。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji046-114","person_id":"9oc_37g_jlc","scope":"same_chapter","chapter_ids":["c-shiji-046-tian"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["后勝"],"evidence":[{"paragraph_id":"c-shiji-046-tian:p054","quote":"四十四年，秦兵撃齊。齊王聽相后勝計，不戰，以兵降秦。秦虜王建，遷之共。遂滅齊爲郡。天下壹并於秦，秦王政立號爲皇帝。始，君王后賢，事秦謹，與諸侯信，齊亦東邊海上，秦日夜攻三晉、燕、楚，五國各自救於秦，以故王建立四十餘年不受兵。君王后死，后勝相齊，多受秦閒金，多使賓客入秦，秦又多予金，客皆爲反閒，勸王去從朝秦，不修攻戰之備，不助五國攻秦，秦以故得滅五國。五國已亡，秦兵卒入臨淄，民莫敢格者。王建遂降，遷於共。故齊人怨王建不蚤與諸侯合從攻秦，聽姦臣賓客以亡其國，歌之曰：「松耶柏耶？住建共者客耶？」疾建用客之不詳也。"}],"rationale":"限本篇明示姓名、是為、繼位及局部事件暫接；姜齊與田齊桓公、不同時段未名王及同字忌分開。孫子不先補孫臏，子守髙唐不補闕字，索隱短稱與代詞仍待核；未跨篇按同名接人。"},{"id":"d-shiji088-024","person_id":"9oc_37g_jlc","scope":"same_chapter","chapter_ids":["c-shiji-088-mengtian"],"status":"contextual_provisional","rationale":"按本段明示姓名及局部承接暫定；引古人物只記正文所述，不補他書事件或年代。未名使者依不同奉命事件分置，曲宮段落使者與大夫按同段承接。","reviewer":"Codex（AI 代理）","surfaces":["后勝"],"evidence":[{"paragraph_id":"c-shiji-088-mengtian:p008","quote":"子嬰進諫曰：「臣聞故趙王遷殺其良臣李牧而用顏聚，燕王喜陰用荊軻之謀而倍秦之約，齊王建殺其故世忠臣而用后勝之議。此三君者，皆各以變古者失其國而殃及其身。今蒙氏，秦之大臣謀士也，而主欲一旦棄去之，臣竊以為不可。臣聞輕慮者不可以治國，獨智者不可以存君。誅殺忠臣而立無節行之人，是內使群臣不相信而外使鬬士之意離也，臣竊以為不可。」"}]}],"equivalence_decisions":[{"id":"eq-shiji088-review-housheng","person_ids":["9oc_37g_jlc"],"canonical_person_id":"9oc_37g_jlc","scope":"cross_chapter","chapter_ids":["c-shiji-088-mengtian","c-shiji-046-tian"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-088-mengtian","source_id":"s-shiji-088-mengtian","paragraph_id":"c-shiji-088-mengtian:p008","quote":"子嬰進諫曰：「臣聞故趙王遷殺其良臣李牧而用顏聚，燕王喜陰用荊軻之謀而倍秦之約，齊王建殺其故世忠臣而用后勝之議。此三君者，皆各以變古者失其國而殃及其身。今蒙氏，秦之大臣謀士也，而主欲一旦棄去之，臣竊以為不可。臣聞輕慮者不可以治國，獨智者不可以存君。誅殺忠臣而立無節行之人，是內使群臣不相信而外使鬬士之意離也，臣竊以為不可。」","mention_ids":["c-shiji-088-mengtian:m008-0050"]},{"chapter_id":"c-shiji-046-tian","source_id":"s-shiji-046-tian","paragraph_id":"c-shiji-046-tian:p054","quote":"四十四年，秦兵撃齊。齊王聽相后勝計，不戰，以兵降秦。秦虜王建，遷之共。遂滅齊爲郡。天下壹并於秦，秦王政立號爲皇帝。始，君王后賢，事秦謹，與諸侯信，齊亦東邊海上，秦日夜攻三晉、燕、楚，五國各自救於秦，以故王建立四十餘年不受兵。君王后死，后勝相齊，多受秦閒金，多使賓客入秦，秦又多予金，客皆爲反閒，勸王去從朝秦，不修攻戰之備，不助五國攻秦，秦以故得滅五國。五國已亡，秦兵卒入臨淄，民莫敢格者。王建遂降，遷於共。故齊人怨王建不蚤與諸侯合從攻秦，聽姦臣賓客以亡其國，歌之曰：「松耶柏耶？住建共者客耶？」疾建用客之不詳也。","mention_ids":["c-shiji-046-tian:m054-0014","c-shiji-046-tian:m054-0117"]}],"rationale":"齊王建用后勝及后勝相齊受秦間金的具體君臣配置支持同人，不補未知姓名分拆。 同書各