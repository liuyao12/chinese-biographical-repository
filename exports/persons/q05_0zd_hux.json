吾彥，逸足齊驅，毛炅屈其深謀，陸抗奇其茂略。薪楢之任，清規自遠；鼙鼓之臣，厥聲彌劭。景武，南楚秀士；元孫，累葉將門，赴死喻於登仙。效誠陳於上策，竟而俱斃，貞則斯存。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":98,"last_line":98,"raw_start":8133,"raw_end":8346,"raw_character_offsets":[8133,8134,8135,8136,8137,8138,8139,8140,8141,8142,8143,8144,8145,8146,8147,8148,8149,8150,8151,8152,8153,8154,8155,8156,8157,8158,8159,8160,8161,8162,8163,8164,8165,8166,8167,8168,8169,8170,8171,8172,8173,8174,8175,8176,8177,8178,8179,8180,8181,8182,8183,8184,8185,8186,8187,8188,8189,8190,8191,8192,8193,8194,8195,8196,8197,8198,8199,8200,8201,8202,8203,8204,8205,8206,8207,8208,8209,8210,8211,8212,8213,8214,8215,8216,8217,8218,8219,8220,8221,8222,8223,8224,8225,8226,8227,8228,8229,8230,8231,8232,8233,8234,8235,8236,8237,8238,8239,8240,8241,8242,8243,8244,8245,8246,8247,8248,8249,8250,8251,8252,8253,8254,8255,8256,8257,8258,8259,8260,8261,8262,8263,8264,8265,8266,8267,8268,8269,8270,8271,8272,8273,8274,8275,8276,8277,8278,8279,8280,8281,8282,8283,8284,8285,8286,8287,8288,8289,8290,8291,8292,8293,8294,8295,8296,8297,8298,8299,8300,8301,8302,8303,8304,8305,8306,8307,8308,8309,8310,8311,8312,8313,8314,8315,8316,8317,8318,8319,8320,8321,8322,8323,8324,8325,8326,8327,8328,8329,8330,8331,8332,8333,8334,8335,8336,8337,8338,8339,8340,8341,8342,8343,8344,8345],"revision_id":2413329},"mentions":[{"id":"c-jinshu-057-appraisal:p001:m0028","surface":"羅憲","start":28,"end":30,"person_id":"q05_0zd_hux","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-appraisal:p001:m0031","surface":"滕修","start":31,"end":33,"person_id":"8zw_lx6_9le","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-appraisal:p001:m0088","surface":"孝興","start":88,"end":90,"person_id":"5d6_771_0f2","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-appraisal:p001:m0094","surface":"玄威","start":94,"end":96,"person_id":"z0n_1jd_fda","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-appraisal:p001:m0115","surface":"楊欣","start":115,"end":117,"person_id":"79f_cx1_308","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-appraisal:p001:m0122","surface":"楊駿","start":122,"end":124,"person_id":"603_131_11e","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-appraisal:p001:m0128","surface":"陶璜","start":128,"end":130,"person_id":"kjg_7m2_c09","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-appraisal:p001:m0131","surface":"吾彥","start":131,"end":133,"person_id":"zv2_5nr_ili","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-appraisal:p001:m0139","surface":"毛炅","start":139,"end":141,"person_id":"s9b_8tl_ce1","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-appraisal:p001:m0146","surface":"陸抗","start":146,"end":148,"person_id":"40p_eb9_ggr","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-appraisal:p001:m0173","surface":"景武","start":173,"end":175,"person_id":"72h_bvx_bj5","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-appraisal:p001:m0181","surface":"元孫","start":181,"end":183,"person_id":"bfr_z7f_dfk","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-057-appraisal","book_id":"b-jinshu-057","work_id":"w-jinshu","source_id":"s-jinshu-057-appraisal-ws2413329"},{"id":"c-jinshu-057-appraisal:p002","text":"贊曰：憲居玉疊，才博流譽。修赴石門，惠政攸著。孝興、玄威，操履無違。愚墳畢禮，楊門致譏。璜謀超絕，彥材雄傑。潛師襲董，觀兵歎薛。惟趙與張，神略多方。作尉北地，立功西湘。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":100,"last_line":100,"raw_start":8348,"raw_end":8432,"raw_character_offsets":[8348,8349,8350,8351,8352,8353,8354,8355,8356,8357,8358,8359,8360,8361,8362,8363,8364,8365,8366,8367,8368,8369,8370,8371,8372,8373,8374,8375,8376,8377,8378,8379,8380,8381,8382,8383,8384,8385,8386,8387,8388,8389,8390,8391,8392,8393,8394,8395,8396,8397,8398,8399,8400,8401,8402,8403,8404,8405,8406,8407,8408,8409,8410,8411,8412,8413,8414,8415,8416,8417,8418,8419,8420,8421,8422,8423,8424,8425,8426,8427,8428,8429,8430,8431],"revision_id":2413329},"mentions":[{"id":"c-jinshu-057-appraisal:p002:m0003","surface":"憲","start":3,"end":4,"person_id":"q05_0zd_hux","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-appraisal:p002:m0013","surface":"修","start":13,"end":14,"person_id":"8zw_lx6_9le","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-appraisal:p002:m0023","surface":"孝興","start":23,"end":25,"person_id":"5d6_771_0f2","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-appraisal:p002:m0026","surface":"玄威","start":26,"end":28,"person_id":"z0n_1jd_fda","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-appraisal:p002:m0044","surface":"璜","start":44,"end":45,"person_id":"kjg_7m2_c09","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-appraisal:p002:m0049","surface":"彥","start":49,"end":50,"person_id":"zv2_5nr_ili","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-appraisal:p002:m0057","surface":"董","start":57,"end":58,"person_id":"34k_uqq_jlg","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-appraisal:p002:m0062","surface":"薛","start":62,"end":63,"person_id":"kpq_tg0_zwl","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-057-appraisal","book_id":"b-jinshu-057","work_id":"w-jinshu","source_id":"s-jinshu-057-appraisal-ws2413329"},{"id":"c-jinshu-057-luo-shang:p001","text":"尚字敬之，一名仲。父式，牂柯太守。尚少孤，依叔父憲。善屬文。荊州刺史王戎以尚及劉喬為參軍，並委任之。太康末，為梁州刺史。及趙廞反于蜀，尚表曰：「廞非雄才，必無所成，計日聽其敗耳。」乃假尚節為平西將軍、益州刺史、西戎校尉。性貪，少斷，蜀人言曰：「尚之所愛，非邪則佞，尚之所憎，非忠則正。富擬魯、衛，家成市里；貪如豺狼，無復極已。」又曰：「蜀賊尚可，羅尚殺我。平西將軍，反更為禍。」時李特亦起於蜀，攻蜀，殺趙廞。又攻尚于成都，尚退保江陽，初，尚乞師方岳，荊州刺史宗岱率建平太守孫阜救之，次於江州，岱、阜兵盛，諸為寇所逼者，人有奮志。尚乃使兵曹從事任銳偽降，因出密宣告於外，克日俱擊，遂大破之，斬李特，傳首洛陽。特子雄僭號，都於郫城。尚遣將軍隗伯攻之，不克。俄而尚卒，雄遂據有蜀土。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":18,"last_line":18,"raw_start":775,"raw_end":1113,"raw_