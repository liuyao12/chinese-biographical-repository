{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000919","canonical_person_id":"yre_3um_pha","id_aliases":["cbr-p000919"],"identity_policy":"contextual_provisional","person_ids":["yre_3um_pha"],"persons":[{"id":"yre_3um_pha","label":"悍（屬國）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"屬國悍","mention_ids":["c-shiji-010-wendi:m037-0442"]}],"evidence":[{"mention_id":"c-shiji-010-wendi:m037-0442","chapter_id":"c-shiji-010-wendi","paragraph_id":"c-shiji-010-wendi:p037","quote":"屬國悍"}],"id_aliases":["cbr-p000919"]}],"source_mention_summary":[{"source_id":"s-shiji-010-wendi","work_id":"w-shiji","book_id":"b-shiji-010","chapter_id":"c-shiji-010-wendi","mention_count":1,"mention_ids":["c-shiji-010-wendi:m037-0442"],"paragraph_ids":["c-shiji-010-wendi:p037"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-010-wendi"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-010-wendi:m037-0442","start":442,"end":445,"surface":"屬國悍","kind":"person","person_id":"yre_3um_pha","status":"contextual_provisional","paragraph_id":"c-shiji-010-wendi:p037","chapter_id":"c-shiji-010-wendi"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-010-wendi:p037","text":"後七年六月己亥，帝崩於未央宮。遺詔曰：「朕聞蓋天下萬物之萌生，靡不有死。死者天地之理，物之自然者，奚可甚哀。當今之時，世咸嘉生而惡死，厚葬以破業，重服以傷生，吾甚不取。且朕既不德，無以佐百姓；今崩，又使重服久臨，以離寒暑之數，哀人之父子，傷長幼之志，損其飲食，絕鬼神之祭祀，以重吾不德也，謂天下何！朕獲保宗廟，以眇眇之身讬于天下君王之上，二十有餘年矣。賴天地之靈，社稷之福，方內安寧，靡有兵革。朕既不敏，常畏過行，以羞先帝之遺德；維年之久長，懼于不終。今乃幸以天年，得復供養于高廟。朕之不明與嘉之，其奚哀悲之有！其令天下吏民，令到出臨三日，皆釋服。毋禁取婦嫁女祠祀飲酒食肉者。自當給喪事服臨者，皆無踐。絰帶無過三寸，毋布車及兵器，毋發民男女哭臨宮殿。宮殿中當臨者，皆以旦夕各十五舉聲，禮畢罷。非旦夕臨時，禁毋得擅哭。已下，服大紅十五日，小紅十四日，纖七日，釋服。佗不在令中者，皆以此令比率從事。布告天下，使明知朕意。霸陵山川因其故，毋有所改。歸夫人以下至少使。」令中尉亞夫為車騎將軍，屬國悍為將屯將軍，郎中令武為復土將軍，發近縣見卒萬六千人，發內史卒萬五千人，藏郭穿復土屬將軍武。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-010-wendi:m037-0008","start":8,"end":9,"surface":"帝","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m037-0209","start":209,"end":211,"surface":"先帝","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、群體或神祇指稱未定；不補未見姓名或血親。"},{"id":"c-shiji-010-wendi:m037-0381","start":381,"end":386,"surface":"佗不在令中","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、群體或神祇指稱未定；不補未見姓名或血親。"},{"id":"c-shiji-010-wendi:m037-0422","start":422,"end":429,"surface":"夫人以下至少使","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、群體或神祇指稱未定；不補未見姓名或血親。"},{"id":"c-shiji-010-wendi:m037-0434","start":434,"end":436,"surface":"亞夫","kind":"person","person_id":"nwx_f88_xfu","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m037-0442","start":442,"end":445,"surface":"屬國悍","kind":"person","person_id":"yre_3um_pha","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m037-0451","start":451,"end":455,"surface":"郎中令武","kind":"person","person_id":"3sp_xmg_o87","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m037-0486","start":486,"end":489,"surface":"將軍武","kind":"person","person_id":"3sp_xmg_o87","status":"contextual_provisional"}],"chapter_id":"c-shiji-010-wendi","book_id":"b-shiji-010","work_id":"w-shiji","source_id":"s-shiji-010-wendi"}],"sources":[{"chapter_id":"c-shiji-010-wendi","work_id":"w-shiji","book_id":"b-shiji-010","source_id":"s-shiji-010-wendi","source":{"title":"史記／卷010","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記