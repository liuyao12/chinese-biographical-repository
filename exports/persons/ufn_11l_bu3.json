rted_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-weishu-weishou-058-yangchun:p023:m0109","start":109,"end":113,"surface":"西河王悰","kind":"person","person_id":"ufn_11l_bu3","status":"contextual_provisional","interpretation_note":"完整單元逐段敘述及引語角色覆核；原稱不改，具體判讀見reading-review。","paragraph_id":"c-weishu-weishou-058-yangchun:p023","chapter_id":"c-weishu-weishou-058-yangchun"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-weishu-weishou-058-yangchun:p023","text":"未幾，屬元顥侵逼大梁，除昱征東將軍、右光祿大夫，加散騎常侍、使持節、假車騎將軍，為南道大都督，鎮滎陽。顥既擒濟陰王暉業，乘虛徑進，大兵集於城下，遣其左衞劉業、王道安等招昱，令降，昱不從，顥遂攻之。城陷，都督元恭，太守、西河王悰並踰城而走，俱被擒縶。昱與弟息五人，在門樓上，須臾顥至，執昱下城，面責昱曰：「楊昱，卿今死甘心否？卿自負我，非我負卿也。」昱答曰：「分不望生，向所以不下樓者，正慮亂兵耳。但恨八十老父，無人供養，負病黃泉，求乞小弟一命，便死不朽也。」顥乃拘之。明旦，顥將陳慶之、胡光等三百餘人伏顥帳前，請曰：「陛下渡江三千里，無遺鏃之費，昨日一朝殺傷五百餘人，求乞楊昱以快意。」顥曰：「我在江東，嘗聞梁主言，初下都日，袁昂為吳郡不降，稱其忠節。奈何殺楊昱？自此之外，任卿等所請。」於是斬昱下統帥三十七人，皆令蜀兵刳腹取心食之。顥既入洛，除昱名為民。","text_layer":"received_chapter","annotation_status":"in_progress","source_position":{"revision_id":2087998,"raw_start":8777,"raw_end":9155,"source_layer":"received_biography","raw_character_offsets":[8777,8778,8779,8780,8781,8782,8783,8784,8785,8786,8787,8788,8789,8790,8791,8792,8793,8794,8795,8796,8797,8798,8799,8800,8801,8802,8803,8804,8805,8806,8807,8808,8809,8810,8811,8812,8813,8814,8815,8816,8817,8818,8819,8820,8821,8822,8823,8824,8825,8826,8827,8828,8829,8830,8831,8832,8833,8834,8835,8836,8837,8838,8839,8840,8841,8842,8843,8844,8845,8846,8847,8848,8849,8850,8851,8852,8853,8854,8855,8856,8857,8858,8859,8860,8861,8862,8863,8864,8865,8866,8867,8868,8869,8870,8871,8872,8873,8874,8875,8876,8877,8878,8879,8880,8881,8882,8883,8884,888