{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"ccd_af3_98e","canonical_person_id":"ccd_af3_98e","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["ccd_af3_98e"],"persons":[{"id":"ccd_af3_98e","label":"建平王宏","status":"active","historicity":"historical_tradition","aliases":[{"surface":"建平王","mention_ids":["c-nanqishu-032-wangyanzhi:line079:m0056"]}],"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-032","chapter_id":"c-nanqishu-032-wangyanzhi","source_id":"s-nanqishu-032-wangyanzhi","paragraph_id":"c-nanqishu-032-wangyanzhi:line079","mention_id":"c-nanqishu-032-wangyanzhi:line079:m0056","quote":"建平王"}],"identity_note":"王延之傳完整原段人物；跨史帝王／府主稱號依固定平行文本及敘事時序辨識，紀年異說與出繼另錄。粲之不只依字近合為瓚之。","review":"ai_provisional"}],"source_mention_summary":[{"source_id":"s-nanqishu-032-wangyanzhi","work_id":"w-nanqishu","book_id":"b-nanqishu-032","chapter_id":"c-nanqishu-032-wangyanzhi","mention_count":1,"mention_ids":["c-nanqishu-032-wangyanzhi:line079:m0056"],"paragraph_ids":["c-nanqishu-032-wangyanzhi:line079"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-nanqishu-032-wangyanzhi"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-032-wangyanzhi:line079:m0056","start":56,"end":59,"surface":"建平王","kind":"person","person_id":"ccd_af3_98e","status":"contextual_provisional","paragraph_id":"c-nanqishu-032-wangyanzhi:line079","chapter_id":"c-nanqishu-032-wangyanzhi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-nanqishu032-jianping","person_id":"ccd_af3_98e","surfaces":["建平王"],"scope":"same_chapter","chapter_ids":["c-nanqishu-032-wangyanzhi"],"status":"contextual_provisional","confidence_level":"high","identification_basis":{"kind":"source_context","target_mention_ids":["c-nanqishu-032-wangyanzhi:line079:m0056"]},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-032","chapter_id":"c-nanqishu-032-wangyanzhi","source_id":"s-nanqishu-032-wangyanzhi","paragraph_id":"c-nanqishu-032-wangyanzhi:line079","quote":"延之少而靜默，不交人事。州辟主簿，不就。舉秀才。除北中郎法曹行參軍，轉署外兵尚書外兵部，司空主簿，竝不就。除中軍建平王主簿、記室，仍度司空、北中郎二府，轉祕書丞，西陽王撫軍諮議，州別駕，尋陽王冠軍、安陸王後軍司馬，加振武將軍，出爲安遠護軍，武陵內史，不拜。宋明帝爲衞軍，延之轉爲長史，加宣威將軍。司徒建安王休仁征赭圻，轉延之爲左長史，加寧朔將軍。"}],"rationale":"本傳早期中軍建平王府與宏的爵號及中軍職號相合，早於宋明帝時段，不套後代建平王；中軍異文為數位校注所報，未親校印本。府主任期不轉填延之精確任職年。","references":[{"title":"《宋書》卷72正文","url":"https://zh.wikisource.org/w/index.php?oldid=1997159","source_revision":1997159,"source_position":{"first_line":31,"last_line":31},"quote":"建平宣簡王宏字休度，文帝第七子也。","wikitext_sha256":"cd2c4382536683f029cb539b03761e815ddbacd14695a3aedcf4ef51b559ebb3","image_verified":false,"scope":"parallel_primary_named_identity","note":"固定數位正文；未親核底本影像，數位校注所報異本不冒充親核。"},{"title":"《宋書》卷72正文","url":"https://zh.wikisource.org/w/index.php?oldid=1997159","source_revision":1997159,"source_position":{"first_line":33,"last_line":33},"quote":"事平，以為尚書左僕射，使奉迎太后，還加中軍將軍，","wikitext_sha256":"cd2c4382536683f029cb539b03761e815ddbacd14695a3aedcf4ef51b559ebb3","image_verified":false,"scope":"parallel_primary_named_identity","note":"固定數位正文；未親核底本影像，數位校注所報異本不冒充親核。"}],"human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-032-wangyanzhi:line079","text":"延之少而靜默，不交人事。州辟主簿，不就。舉秀才。除北中郎法曹行參軍，轉署外兵尚書外兵部，司空主簿，竝不就。除中軍建平王主簿、記室，仍度司空、北中郎二府，轉祕書丞，西陽王撫軍諮議，州別駕，尋陽王冠軍、安陸王後軍司馬，加振武將軍，出爲安遠護軍，武陵內史，不拜。宋明帝爲衞軍，延之轉爲長史，加宣威將軍。司徒建安王休仁征赭圻，轉延之爲左長史，加寧朔將軍。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-nanqishu-032-wangyanzhi:line079:m0000","start":0,"end":2,"surface":"延之","kind":"person","person_id":"7r6_k52_qji_ABDABAACA","status":"contextual_provisional"},{"id":"c-nanqishu-032-wangyanzhi:line079:m0056","start":56,"end":59,"surface":"建平王","kind":"person","person_id":"ccd_af3_98e","status":"contextual_provisional"},{"id":"c-nanqishu-032-wangyanzhi:line079:m0081","start":81,"end":84,"surface":"西陽王","kind":"person","person_id":"y7i_swu_xgh","status":"contextual_provisional"},{"id":"c-nanqishu-032-wangyanzhi:line079:m0093","start":93,"end":96,"surface":"尋陽王","kind":"person","person_id":"jdy_ejj_3vj","status":"contextual_provisional"},{"id":"c-nanqishu-032-wangyanzhi:line079:m0099","start":99,"end":102,"surface":"安陸王","kind":"person","person_id":"31w_r7m_389","status":"contextual_provisional"},{"id":"c-nanqishu-032-wangyanzhi:line079:m0128","start":128,"end":131,"surface":"宋明帝","kind":"person","person_id":"cti_o52_4nz","status":"contextual_provisional"},{"id":"c-nanqishu-032-wangyanzhi:line079:m0135","start":135,"end":137,"surface":"延之","kind":"person","person_id":"7r6_k52_qji_ABDABAACA","status":"contextual_provisional"},{"id":"c-nanqishu-032-wangyanzhi:line079:m0150","start":150,"end":155,"surface":"建安王休仁","kind":"person","person_id":"n6r_wpb_2ov","status":"contextual_provisional"},{"id":"c-nanqishu-032-wangyanzhi:line079:m0160","start":160,"end":162,"surface":"延之","kind":"person","person_id":"7r6_k52_qji_ABDABAACA","status":"contextual_provisional"}],"source_position":{"first_line":79,"last_line":79,"revision_id":1513918,"editorial_excerpt_boundary":false},"chapter_id":"c-nanqishu-032-wangyanzhi","book_id":"b-nanqishu-032","work_id":"w-nanqishu","source_id":"s-nanqishu-032-wangyanzhi"}],"sources":[{"chapter_id":"c-nanqishu-032-wangyanzhi","work_id":"w-nanqishu","book_id":"b-nanqishu-032","source_id":"s-nanqishu-032-wangyanzhi","source":{"title":"《南齊書》卷32（王延之傳）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E5%8D%97%E9%BD%8A%E6%9B%B8%2F%E5%8D%B732&oldid=1513918","permalink":"https://zh.wikisource.org/w/index.php?title=%E5%8D%97%E9%BD%8A%E6%9B%B8%2F%E5%8D%B732&oldid=1513918","revision_id":1513918,"accessed_on":"2026-10-19","extent":"王延之傳及子倫之附傳完整七原段；未錄同卷其他本傳。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，未親核底本影像","response_sha256":"f428c7546fdd70a9eece664401433407aad6e45bcbe711a6d58ef8806c1b4ca0","wikitext_sha256":"cc9c36ced8f64c3c359c76836ae56968c8a13c4a3b3c19a416575737314b0061","normalization":{"character_conversion":{},"extraction_note":"只去段首排版空白、展開單參數年號模板；原字不作簡繁或異體替換。","excerpts":[{"proposed_paragraph_id":"c-nanqishu-032-wangyanzhi:line077","source_lines":[77,77],"raw_quote":"　　王延之字希季，琅邪臨沂人也。祖裕，宋左光祿儀同三司。父昇之，都官尚書。延之出繼伯父秀才粲之。","raw_quote_sha256":"63309c01db8bf8d6b5f83bb589c818356474dc0c389aa17435d5c9adc71c951b","selected_text_sha256":"5190227dee6f7bb18e8210dd652ad8fdc41e010edd497de276a9bd0d34e01224","begin_anchor":"王延之字希季，琅邪臨沂人也。祖裕，宋","end_anchor":"之，都官尚書。延之出繼伯父秀才粲之。"},{"proposed_paragraph_id":"c-nanqishu-032-wangyanzhi:line079","source_lines":[79,79],"raw_quote":"　　延之少而靜默，不交人事。州辟主簿，不就。舉秀才。除北中郎法曹行參軍，轉署外兵尚書外兵部，司空主簿，竝不就。除中軍建平王主簿、記室，仍度司空、北中郎二府，轉祕書丞，西陽王撫軍諮議，州別駕，尋陽王冠軍、安陸王後軍司馬，加振武將軍，出爲安遠護軍，武陵內史，不拜。宋明帝爲衞軍，延之轉爲長史，加宣威將軍。司徒建安王休仁征赭圻，轉延之爲左長史，加寧朔將軍。","raw_quote_sha256":"65dbf92687392816270499d64b3b3f76669ef41d680d8463027ded366be3be20","selected_text_sha256":"debc76a5cc02e53dcb238a4a8c76e6863282a68a59b11477f6f7f66b00b5e843","begin_anchor":"延之少而靜默，不交人事。州辟主簿，不","end_anchor":"征赭圻，轉延之爲左長史，加寧朔將軍。"},{"proposed_paragraph_id":"c-nanqishu-032-wangyanzhi:line081","source_lines":[81,81],"raw_quote":"　　延之清貧，居宇穿漏。褚淵往候之，見其如此，具啓明帝，帝卽敕材官爲起三閒齋屋。遷侍中，領射聲校尉，未拜，出爲吳郡太守。罷郡還，家產無所增益。除吏部尚書，侍中，領右軍，竝不拜。復爲吏部尚書，領驍騎將軍，出爲後軍將軍、吳興太守。遷都督浙東五郡、會稽太守。轉侍中，祕書監，晉熙王師。遷中書令，師如故，未拜，轉右僕射。{{YL|昇明二年}}，轉左僕射。","raw_quote_sha256":"9ca43034f43d6d2aa684144449f398b4160a868f311a0735a24990a2063d77ce","selected_text_sha256":"58b8ffd38c297992f6d74e43e4f321eeb4c7885b70ba017250113c7f5cc8d849","begin_anchor":"延之清貧，居宇穿漏。褚淵往候之，見其","end_anchor":"未拜，轉右僕射。昇明二年，轉左僕射。"},{"proposed_paragraph_id":"c-nanqishu-032-wangyanzhi:line083","source_lines":[83,83],"raw_quote":"　　宋德旣衰，太祖輔政，朝野之情，人懷彼此。延之與尚書令王僧虔中立無所去就，時人爲之語曰：「二王持平，不送不迎。」太祖以此善之。三年，出爲使持節、都督江州豫州之新蔡晉熙二郡諸軍事、安南將軍、江州刺史。{{YL|建元二年}}，進號鎮南將軍。","raw_quote_sha256":"0cd884fa9eb1203fb545131432a7d48211f9d992426485fd8b5b45330090963e","selected_text_sha256":"ea7c152f4e5a264eb70b2e46add02732d7f7a4915e5df75bbd6dc721f5c2d5ab","begin_anchor":"宋德旣衰，太祖輔政，朝野之情，人懷彼","end_anchor":"、江州刺史。建元二年，進號鎮南將軍。"},{"proposed_paragraph_id":"c-nanqishu-032-wangyanzhi:line085","source_lines":[85,85],"raw_quote":"　　延之與金紫光祿大夫阮韜，俱宋領軍劉湛外甥，竝有早譽。湛甚愛之，曰：「韜後當爲第一，延之爲次也。」延之甚不平。每致餉下都，韜與朝士同例。太祖聞其如此，與延之書曰：「韜云卿未嘗有別意，當緣劉家月旦故邪？」在州祿俸以外，一無所納，獨處齋內，吏民罕得見者。","raw_quote_sha256":"1b62157340ff787ebef58d5c05857a2b7104fd16ee3c1d3f38064ea29f5d3a5f","selected_text_sha256":"90909962f1db802e4a30a46ab7a5cb67214e9a90572e891e287cff72fa8b6ee0","begin_anchor":"延之與金紫光祿大夫阮韜，俱宋領軍劉湛","end_anchor":"，一無所納，獨處齋內，吏民罕得見者。"},{"proposed_paragraph_id":"c-nanqishu-032-wangyanzhi:line087","source_lines":[87,87],"raw_quote":"　　四年，遷中書令，右光祿大夫，本州大中正。轉左僕射，光祿、中正如故。尋領竟陵王師。永明二年，陳疾解職，世祖許之。轉特進，右光祿大夫，王師、中正如故。其年卒，年六十四。追贈散騎常侍，右光祿大夫、特進如故。諡簡子。","raw_quote_sha256":"748493c1959b643774874ba6bac9520e23f70d42b43e50c0d5c8ca10373a185a","selected_text_sha256":"cc17b4ba7f4714e314638e533f6a50993fa06f0b9d08799957fd0284b9a5955a","begin_anchor":"四年，遷中書令，右光祿大夫，本州大中","end_anchor":"常侍，右光祿大夫、特進如故。諡簡子。"},{"proposed_paragraph_id":"c-nanqishu-032-wangyanzhi:line089","source_lines":[89,89],"raw_quote":"　　延之家訓方嚴，不妄見子弟，雖節歲問訊，皆先克日。子倫之，見兒子亦然。永明中，爲侍中。世祖幸琅邪城，倫之與光祿大夫全景文等二十一人坐不參承，爲有司所奏。詔倫之親爲陪侍之職，而同外惰慢，免官，景文等贖論。建武中，至侍中，領前軍將軍，都官尚書，領游擊將軍，卒。","raw_quote_sha256":"38237b355b070140f7c7665ebb14b1b640966bac3ad6a6c8afb031283de0c536","selected_text_sha256":"49405af16fd46e757a1419ca1a21f4ecd0c4aec760759c6727ed53bbcb362ce5","begin_anchor":"延之家訓方嚴，不妄見子弟，雖節歲問訊","end_anchor":"前軍將軍，都官尚書，領游擊將軍，卒。"}]}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true}}
