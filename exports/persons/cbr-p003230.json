al"},{"id":"c-shiji-052-qidaohui:m016-0105","start":105,"end":107,"surface":"魏勃","kind":"person","person_id":"cbr-p003240","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m016-0107","start":107,"end":108,"surface":"父","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、未名者、未核官稱或代詞，不補姓名及家屬成員。"},{"id":"c-shiji-052-qidaohui:m016-0113","start":113,"end":116,"surface":"秦皇帝","kind":"person","person_id":"cbr-p003234","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m016-0118","start":118,"end":120,"surface":"魏勃","kind":"person","person_id":"cbr-p003240","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m016-0128","start":128,"end":130,"surface":"曹參","kind":"person","person_id":"cbr-p003242","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m016-0145","start":145,"end":148,"surface":"相舍人","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、未名者、未核官稱或代詞，不補姓名及家屬成員。"},{"id":"c-shiji-052-qidaohui:m016-0151","start":151,"end":154,"surface":"相舍人","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、未名者、未核官稱或代詞，不補姓名及家屬成員。"},{"id":"c-shiji-052-qidaohui:m016-0166","start":166,"end":167,"surface":"勃","kind":"person","person_id":"cbr-p003240","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m016-0168","start":168,"end":169,"surface":"勃","kind":"person","person_id":"cbr-p003240","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m016-0196","start":196,"end":197,"surface":"勃","kind":"person","person_id":"cbr-p003240","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m016-0197","start":197,"end":199,"surface":"曹參","kind":"person","person_id":"cbr-p003242","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m016-0208","start":208,"end":209,"surface":"參","kind":"person","person_id":"cbr-p003242","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m016-0214","start":214,"end":215,"surface":"參","kind":"person","person_id":"cbr-p003242","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m016-0221","start":221,"end":225,"surface":"齊悼惠王","kind":"person","person_id":"cbr-p003214","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m016-0226","start":226,"end":229,"surface":"悼惠王","kind":"person","person_id":"cbr-p003214","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m016-0240","start":240,"end":243,"surface":"悼惠王","kind":"person","person_id":"cbr-p003214","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m016-0251","start":251,"end":254,"surface":"悼惠王","kind":"person","person_id":"cbr-p003214","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m016-0256","start":256,"end":258,"surface":"哀王","kind":"person","person_id":"cbr-p003220","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m016-0260","start":260,"end":261,"surface":"勃","kind":"person","person_id":"cbr-p003240","status":"contextual_provisional"}],"chapter_id":"c-shiji-052-qidaohui","book_id":"b-shiji-052","work_id":"w-shiji","source_id":"s-shiji-052-qidaohui"},{"id":"c-shiji-052-qidaohui:p037","text":"孝文帝二年，以齊之濟北郡立興居為濟北王，與城陽王俱立。立二年，反。始大臣誅呂氏時，朱虛侯功尤大，許盡以趙地王朱虛侯，盡以梁地王東牟侯。及孝文帝立，聞朱虛、東牟之初欲立齊王，故絀其功。及二年，王諸子，乃割齊二郡以王章、興居。章、興居自以失職奪功。章死，而興居聞匈奴大入漢，漢多發兵，使丞相灌嬰擊之，文帝親幸太原，以為天子自擊胡，遂發兵反於濟北。天子聞之，罷丞相及行兵，皆歸長安。使棘蒲侯柴將軍擊破虜濟北王，王自殺，地入于漢，為郡。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-052-qidaohui:m037-0000","start":0,"end":3,"surface":"孝文帝","kind":"person","person_id":"cbr-p003233","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m037-0013","start":13,"end":15,"surface":"興居","kind":"person","person_id":"cbr-p003224","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m037-0016","start":16,"end":19,"surface":"濟北王","kind":"person","person_id":"cbr-p003224","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m037-0021","start":21,"end":24,"surface":"城陽王","kind":"person","person_id":"cbr-p003222","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m037-0041","start":41,"end":44,"surface":"朱虛侯","kind":"person","person_id":"cbr-p003222","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m037-0054","start":54,"end":57,"surface":"朱虛侯","kind":"person","person_id":"cbr-p003222","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m037-0063","start":63,"end":66,"surface":"東牟侯","kind":"person","person_id":"cbr-p003224","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m037-0068","start":68,"end":71,"surface":"孝文帝","kind":"person","person_id":"cbr-p003233","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m037-0106","start":106,"end":107,"surface":"章","kind":"person","person_id":"cbr-p003222","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m037-0108","start":108,"end":110,"surface":"興居","kind":"person","person_id":"cbr-p003224","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m037-0111","start":111,"end":112,"surface":"章","kind":"person","person_id":"cbr-p003222","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m037-0113","start":113,"end":115,"surface":"興居","kind":"person","person_id":"cbr-p003224","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m037-0122","start":122,"end":123,"surface":"章","kind":"person","person_id":"cbr-p003222","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m037-0126","start":126,"end":128,"surface":"興居","kind":"person","person_id":"cbr-p003224","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m037-0141","start":141,"end":145,"surface":"丞相灌嬰","kind":"person","person_id":"cbr-p003230","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m037-0148","start":148,"end":150,"surface":"文帝","kind":"person","person_id":"cbr-p003233","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m037-0157","start":157,"end":159,"surface":"天子","kind":"unresolved","person_id":null,"status":"unresol