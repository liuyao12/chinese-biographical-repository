straints":[],"identity_decisions":[{"id":"d-shiji004-030","person_id":"sx2_wyn_nhr","surfaces":["滿","穆王"],"scope":"same_chapter","chapter_ids":["c-shiji-004-zhou"],"status":"source_explicit","evidence":[{"paragraph_id":"c-shiji-004-zhou:p025","quote":"康王卒，子昭王瑕立。昭王之時，王道微缺。昭王南巡狩不返，卒於江上。其卒不赴告，諱之也。立昭王子滿，是為穆王。"}],"rationale":"本文同段明示即位稱號或在同一事件中使用全稱與簡稱；判斷僅適用此處，不作全庫字串匹配。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji005-019","person_id":"sx2_wyn_nhr","surfaces":["周繆王","繆王"],"scope":"cross_chapter","chapter_ids":["c-shiji-004-zhou","c-shiji-005-qin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-004-zhou:p025","quote":"康王卒，子昭王瑕立。昭王之時，王道微缺。昭王南巡狩不返，卒於江上。其卒不赴告，諱之也。立昭王子滿，是為穆王。"},{"paragraph_id":"c-shiji-005-qin:p003","quote":"其玄孫曰中潏，在西戎，保西垂。生蜚廉。蜚廉生惡來。惡來有力，蜚廉善走，父子俱以材力事殷紂。周武王之伐紂，并殺惡來。是時蜚廉為紂石北方，還，無所報，為壇霍太山而報，得石棺，銘曰「帝令處父不與殷亂，賜爾石棺以華氏」。死，遂葬於霍太山。蜚廉復有子曰季勝。季勝生孟增。孟增幸於周成王，是為宅皋狼。皋狼生衡父，衡父生造父。造父以善御幸於周繆王，得驥、溫驪、驊騮、騄耳之駟，西巡狩，樂而忘歸。徐偃王作亂，造父為繆王御，長驅歸周，一日千里以救亂。繆王以趙城封造父，造父族由此為趙氏。自蜚廉生季勝已下五世至造父，別居趙。趙衰其後也。惡來革者，蜚廉子也，蚤死。有子曰女防。女防生旁皋，旁皋生太幾，太幾生大駱，大駱生非子。以造父之寵，皆蒙趙城，姓趙氏。"}],"rationale":"依王朝、敘事時代及特定事件暫定跨卷同指；同名與職稱不能單獨支持合併。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji040-179","person_id":"sx2_wyn_nhr","surfaces":["穆王"],"scope":"cross_chapter","chapter_ids":["c-shiji-004-zhou","c-shiji-040-chu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-004-zhou:p025","quote":"康王卒，子昭王瑕立。昭王之時，王道微缺。昭王南巡狩不返，卒於江上。其卒不赴告，諱之也。立昭王子滿，是為穆王。"},{"paragraph_id":"c-shiji-040-chu:p030","quote":"靈王三年六月，楚使使告晉，欲會諸侯。諸侯皆會楚于申。伍舉曰：「昔夏啓有鈞臺之饗，商湯有景亳之命，周武王有盟津之誓，成王有岐陽之閒，康王有豐宮之朝，穆王有涂山之會，齊桓有召陵之師，晉文有踐土之盟，君其何用？」靈王曰：「用桓公。」時鄭子産在焉。於是晉、宋、魯、衞不往。靈王已盟，有驕色。伍舉曰：「桀爲有仍之會，有緡叛之。紂爲黎山之會，東夷叛之。幽王爲太室之盟，戎、翟叛之。君其愼終！」"}],"rationale":"伍舉引語成、康、穆為周王的連續舊會舉例，與周篇昭王子滿是為穆王暫接；不與楚穆王商臣相接，未據此核定涂山之會。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-004-zhou:p025","text":"康王卒，子昭王瑕立。昭王之時，王道微缺。昭王南巡狩不返，卒於江上。其卒不赴告，諱之也。立昭王子滿，是為穆王。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-004-zhou:m025-0000","start":0,"end":2,"surface":"康王","kind":"person","person_id":"nek_dsn_nih","status":"source_identified"},{"id":"c-shiji-004-zhou:m025-0005","start":5,"end":8,"surface":"昭王瑕","kind":"person","person_id":"voy_rog_jbw","status":"source_identified"},{"id":"c-shiji-004-zhou:m025-0010","start":10,"end":12,"surface":"昭王","kind":"person","person_id":"voy_rog_jbw","status":"source_identified"},{"id":"c-shiji-004-zhou:m025-0020","start":20,"end":22,"surface":"昭王","kind":"person","person_id":"voy_rog_jbw","status":"source_identified"},{"id":"c-shiji-004-zhou:m025-0044","start":44,"end":46,"surface":"昭王","kind":"person","person_id":"voy_rog_jbw","status":"source_identified"},{"id":"c-shiji-004-zhou:m025-0047","start":47,"end":48,"surface":"滿","kind":"person","person_id":"sx2_wyn_nhr","status":"contextual_provisional","interpretation_note":"依同段明示人物與敘事暫定短稱，不作其他段落或其他時代的自動識別。"},{"id":"c-shiji-004-zhou:m025-0051","start":51,"end":53,"surface":"穆王","kind":"person","person_id":"sx2_wyn_nhr","status":"source_identified"}],"chapter_id":"c-shiji-004-zhou","book_id":"b-shiji-004","work_id":"w-shiji","source_id":"s-shiji-004-zhou"},{"id":"c-shiji-004-zhou:p026","text":"穆王即位，春秋已五十矣。王道衰微，穆王閔文武之道缺，乃命伯臩申誡太仆國之政，作《臩命》。復寧。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-004-zhou:m026-0000","start":0,"end":2,"surface":"穆王","kind":"person","person_id":"sx2_wyn_nhr","status":"source_identified"},{"id":"c-shiji-004-zhou:m026-0017","start":17,"end":19,"surface":"穆王","kind":"person","person_id":"sx2_wyn_nhr","status":"source_identified"},{"id":"c-shiji-004-zhou:m026-0020","start":20,"end":22,"surface":"文武","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官號或文字疑讀；保留錨點，不補熟知姓名或假定同指。"},{"id":"c-shiji-004-zhou:m026-0028","start":28,"end":30,"surface":"伯臩","kind":"person","person_id":"1xd_b3z_bfz","status":"source_identified"}],"chapter_id":"c-shiji-004-zhou","book_id":"b-shiji-004","work_id":"w-shiji","source_id":"s-shiji-004-zhou"},{"id":"c-shiji-004-zhou:p027","text":"穆王將征犬戎，祭公謀父諫曰：「不可。先王燿德不觀兵。夫兵戢而時動，動則威，觀則玩，玩則無震。是故周文公之頌曰：『載戢干戈，載櫜弓矢，我求懿德，肆于時夏，允王保之。』先王之於民也，茂正其德而厚其性，阜其財求而利其器用，明利害之鄉，以文修之，使之務利而辟害，懷德而畏威，故能保世以滋大。昔我先王世后稷以服事虞、夏。及夏之衰也，棄稷不務，我先王不窋用失其官，而自竄於戎狄之閒。不敢怠業，時序其德，遵修其緒，修其訓典，朝夕恪勤，守以敦篤，奉以忠信。奕世載德，不忝前人。至于文王、武王，昭前之光明而加之以慈和，事神保民，無不欣喜。商王帝辛大惡于民，庶民不忍，訢載武王，以致戎于商牧。是故先王非務武也，勸恤民隱而除其害也。夫先王之制，邦內甸服，邦外侯服，侯衛賓服，夷蠻要服，戎翟荒服。甸服者祭，侯服者祀，賓服者享，要服者貢，荒服者王。日祭，月祀，時享，歲貢，終王。先王之順祀也，有不祭則修意，有不祀則修言，有不享則修文，有不貢則修名，有不王則修德，序成而有不至則修刑。於是有刑不祭，伐不祀，征不享，讓不貢，告不王。於是有刑罰之辟，有攻伐之兵，有征討之備，有威讓之命，有文告之辭。布令陳辭而有不至，則增修於德，無勤民於遠。是以近無不聽，遠無不服。今自大畢、伯士之終也，犬戎氏以其職來王，天子曰『予必以不享征之，且觀之兵』，無乃廢先王之訓，而王幾頓乎？吾聞犬戎樹敦，率舊德而守終純固，其有以御我矣。」王遂征之，得四白狼四白鹿以歸。自是荒服者不至。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-004-zhou:m027-0000","start":0,"end":2,"surface":"穆王","kind":"person","person_id":"sx2_wyn_nhr","status":"source_identified"},{"id":"c-shiji-004-zhou:m027-0007","start":7,"end":11,"surface":"祭公謀父","kind":"person","person_id":"aml_745_t4f","status":"source_identified"},{"id":"c-shiji-004-zhou:m027-0018","start":18,"end":20,"surface":"先王","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官號或文字疑讀；保留錨點，不補熟知姓名或假定同指。"},{"id":"c-shiji-004-zhou:m027-0048","start":48,"end":51,"surface":"周文公","kind":"person","person_id":"y4i_pjk_4gn_AD","status":"contextual_provisional","interpretation_note":"依同段明示人物與敘事暫定短稱，不作其他段落或其他時代的自動識別。"},{"id":"c-shiji-004-zhou:m027-0082","start":82,"end":84,"surface":"先王","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官號或文字疑讀；保留錨點，不補熟知姓名或假定同指。"},{"id":"c-shiji-004-zhou:m027-0143","start":143,"end":145,"surface":"先王","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官號或文字疑讀；保留錨點，不補熟知姓名或假定同指。"},{"id":"c-shiji-004-zhou:m027-0146","start":146,"end":148,"surface":"后稷","kind":"person","person_id":"jqy_1fv_u7v","status":"source_identified"},{"id":"c-shiji-004-zhou:m027-0167","start":167,"end":169,"surface":"先王","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官號或文字