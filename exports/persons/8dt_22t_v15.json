ds":["c-shiji-107-weiqi:m008-0118"],"kind":"paragraph"},{"canonical_mention_id":"c-shiji-107-weiqi:m008-0157","mention_ids":["c-shiji-107-weiqi:m008-0157"],"kind":"paragraph"},{"canonical_mention_id":"c-shiji-107-weiqi:m008-0175","mention_ids":["c-shiji-107-weiqi:m008-0175"],"kind":"paragraph"}],"mention_count":4,"duplicate_mention_count":0,"paragraph_occurrence_count":4,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"4處獨立位置，4個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-shiji121-rulin"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-shiji121-006","person_id":"8dt_22t_v15","event_type":"death","status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-121-rulin","source_id":"s-shiji121-rulin","paragraph_id":"c-shiji-121-rulin:p008","quote":"蘭陵王臧既受詩，以事孝景帝為太子少傅，免去。今上初即位，臧乃上書宿衛上，累遷，一歲中為郎中令。及代趙綰亦嘗受詩申公，綰為御史大夫。綰、臧請天子，欲立明堂以朝諸侯，不能就其事，乃言師申公。於是天子使使束帛加璧安車駟馬迎申公，弟子二人乘軺傳從。至，見天子。天子問治亂之事，申公時已八十餘，老，對曰：「為治者不在多言，顧力行何如耳。」是時天子方好文詞，見申公對，默然。然已招致，則以為太中大夫，舍魯邸，議明堂事。太皇竇太后好老子言，不說儒術，得趙綰、王臧之過以讓上，上因廢明堂事，盡下趙綰、王臧吏，後皆自殺。申公亦疾免以歸，數年卒。","person_mention_id":"c-shiji-121-rulin:m008-0049"}],"interpretation_note":"原文明示卒或後皆自殺；數年及帝號時段不直接反推公元年。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"mentions":[{"id":"c-shiji-107-weiqi:m008-0012","start":12,"end":14,"surface":"趙綰",