b-chenshu-023","work_id":"w-chenshu","source_id":"s-chenshu-023-wangyang-complete-ws1514496"},{"id":"c-liangshu-006-peizhiheng-dongguan:p001","text":"三月，齊遣其上黨王高渙送貞陽侯蕭淵明來主梁嗣，至東關，遣吳興太守裴之橫與戰，敗績，之橫死。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":12,"last_line":12,"raw_start":392,"raw_end":437,"raw_character_offsets":[392,393,394,395,396,397,398,399,400,401,402,403,404,405,406,407,408,409,410,411,412,413,414,415,416,417,418,419,420,421,422,423,424,425,426,427,428,429,430,431,432,433,434,435,436],"revision_id":2311629},"mentions":[{"id":"c-liangshu-006-peizhiheng-dongguan:p001:m0006","start":6,"end":11,"surface":"上黨王高渙","kind":"person","person_id":"2c0_xgj_5n3","status":"contextual_provisional"},{"id":"c-liangshu-006-peizhiheng-dongguan:p001:m0012","start":12,"end":18,"surface":"貞陽侯蕭淵明","kind":"person","person_id":"qvt_eq1_lcf_ACA","status":"contextual_provisional"},{"id":"c-liangshu-006-peizhiheng-dongguan:p001:m0032","start":32,"end":35,"surface":"裴之橫","kind":"person","person_id":"4kt_0ar_aqo_AAD","status":"contextual_provisional"},{"id":"c-liangshu-006-peizhiheng-dongguan:p001:m0041","start":41,"end":43,"surface":"之橫","kind":"person","person_id":"4kt_0ar_aqo_AAD","status":"contextual_provisional"}],"chapter_id":"c-liangshu-006-peizhiheng-dongguan","book_id":"b-liangshu-006","work_id":"w-liangshu","source_id":"s-liangshu-006-peizhiheng-dongguan-ws2311629"},{"id":"c-liangshu-028-peizhiheng-complete:p003","text":"後江陵陷，齊遣上黨王高渙挾貞陽侯攻東關，晉安王方智承制，以之橫爲使持節、鎮北將軍、徐州刺史，都督衆軍，給鼓吹一部，出守蘄城。之橫營壘未周，而齊軍大至，兵盡矢窮，遂於陣沒，時年四十一。贈侍中、司空公，諡曰忠壯。子鳳寶嗣。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":48,"last_line":48,"raw_start":2890,"raw_end":2999,"raw_character_offsets":[2890,2891,2892,2893,2894,2895,2896,2897,2898,2899,2900,2901,2902,2903,2904,2905,2906,2907,2908,2909,2910,2911,2912,2913,2914,2915,2916,2917,2918,2919,2920,2921,2922,2923,2924,2925,2926,2927,2928,2929,2930,2931,2932,2933,2934,2935,2936,293