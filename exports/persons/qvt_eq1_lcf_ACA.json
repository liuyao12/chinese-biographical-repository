g-shangrou-yixing-ws2060595","chapter_id":"c-nanshi-012-zhang-shangrou-yixing","paragraph_id":"c-nanshi-012-zhang-shangrou-yixing:p001","quote":"梁文獻張皇后諱尚柔，范陽方城人也。父穆之娶文帝從姑而生后。后以宋元嘉中嬪於文帝，生長沙宣武王懿、永陽昭王敷，次生武帝。方孕，忽見庭前昌蒲花，光采非常，驚報，侍者皆云不見。后曰：「常聞見昌蒲花者當富貴。」因取吞之，是月生武帝。將產之夕，后見庭內若有衣冠陪列焉。次生衡陽宣王暢、義興昭長公主令嫕。","subject_person_mention_id":"c-nanshi-012-zhang-shangrou-yixing:p001:m0046","object_person_reference_id":"c-nanshi-012-zhang-shangrou-yixing:p001:r0037"}]}},{"id":"qvt_eq1_lcf_ACA","label":"蕭淵明（梁貞陽侯，長沙宣武王懿子）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"貞陽侯","mention_ids":["c-chenshu-023-wangyang-complete:p001:m0119"]},{"surface":"淵明","mention_ids":["c-zizhitongjian-160-wangyang-yuanming:p001:m0000"]}],"evidence":[{"mention_id":"c-chenshu-023-wangyang-complete:p001:m0119","paragraph_id":"c-chenshu-023-wangyang-complete:p001","chapter_id":"c-chenshu-023-wangyang-complete","quote":"貞陽侯"},{"mention_id":"c-zizhitongjian-160-wangyang-yuanming:p001:m0000","paragraph_id":"c-zizhitongjian-160-wangyang-yuanming:p001","chapter_id":"c-zizhitongjian-160-wangyang-yuanming","quote":"淵明"}],"review":"ai_provisional","identity_note":"蕭淵明（梁貞陽侯，長沙宣武王懿子），見本組原文及身份互校。","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"qvt_eq1_lcf_AC","source_assertion_id":"a-chen023-yuanming-father","evidence":[{"work_id":"w-zizhitongjian","book_id":"b-zizhitongjian-160","chapter_id":"c-zizhitongjian-160-wangyang-yuanming","source_id":"s-zizhitongjian-160-wangyang-yuanming-ws803200","paragraph_id":"c-zizhitongjian-160-wangyang-yuanming:p001","quote":"淵明，懿之子","subject_person_mention_id":"c-zizhitongjian-160-wangyang-yuanming:p001:m0000","object_person_mention_id":"c-zizhitongjian-160-wangyang-yuanming:p001:m0003","source_term":"懿之子"}],"status":"contextual_provisional","human_reviewed":false,"interpretation_note":"通鑑將淵明與會理的父親分敘，淵明父為懿。"}}],"source_mention_summary":[{"source_id":"s-chenshu-023-wangyang-complete-ws1514496","work_id":"w-chenshu","book_id":"b-c