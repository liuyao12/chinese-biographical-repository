g-shangrou-yixing-ws2060595","chapter_id":"c-nanshi-012-zhang-shangrou-yixing","paragraph_id":"c-nanshi-012-zhang-shangrou-yixing:p001","quote":"梁文獻張皇后諱尚柔，范陽方城人也。父穆之娶文帝從姑而生后。后以宋元嘉中嬪於文帝，生長沙宣武王懿、永陽昭王敷，次生武帝。方孕，忽見庭前昌蒲花，光采非常，驚報，侍者皆云不見。后曰：「常聞見昌蒲花者當富貴。」因取吞之，是月生武帝。將產之夕，后見庭內若有衣冠陪列焉。次生衡陽宣王暢、義興昭長公主令嫕。","subject_person_mention_id":"c-nanshi-012-zhang-shangrou-yixing:p001:m0046","object_person_reference_id":"c-nanshi-012-zhang-shangrou-yixing:p001:r0037"}]}},{"id":"qvt_eq1_lcf_ACA","label":"蕭淵明（梁貞陽侯，長沙宣武王懿子）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"貞陽侯","mention_ids":["c-chenshu-023-wangyang-complete:p001:m0119","c-liangshu-028-peizhiheng-complete:p003:m0013"]},{"surface":"淵明","mention_ids":["c-zizhitongjian-160-wangyang-yuanming:p001:m0000","c-liangshu-028-xiahoukui-complete:p005:m0047","c-liangshu-028-xiahoukui-complete:p005:m0101","c-liangshu-028-xiahoukui-complete:p005:m0122"]},{"surface":"貞陽侯蕭淵明","mention_ids":["c-liangshu-006-peizhiheng-dongguan:p001:m0012"]},{"surface":"梁王蕭明","mention_ids":["c-beiqishu-010-gaohuan-peizhiheng:p002:m0006"]},{"surface":"蕭淵明","mention_ids":["c-liangshu-028-xiahoukui-complete:p005:m0038"]}],"evidence":[{"mention_id":"c-chenshu-023-wangyang-complete:p001:m0119","paragraph_id":"c-chenshu-023-wangyang-complete:p001","chapter_id":"c-chenshu-023-wangyang-complete","quote":"貞陽侯"},{"mention_id":"c-zizhitongjian-160-wangyang-yuanming:p001:m0000","paragraph_id":"c-zizhitongjian-160-wangyang-yuanming:p001","chapter_id":"c-zizhitongjian-160-wangyang-yuanming","quote":"淵明"},{"mention_id":"c-liangshu-028-peizhiheng-complete:p003:m0013","paragraph_id":"c-liangshu-028-peizhiheng-complete:p003","chapter_id":"c-liangshu-028-peizhiheng-complete","quote":"貞陽侯"},{"mention_id":"c-liangshu-006-peizhiheng-dongguan:p001:m0012","paragraph_id":"c-liangshu-006-peizhiheng-dongguan:p001","chapter_id":"c-liangshu-006-peizhiheng-dongguan","quote":"貞陽侯蕭淵明"},{"mention_id":"c-beiqishu-010-gaohuan-peizhiheng:p002:m0006","paragraph_id":"c-be