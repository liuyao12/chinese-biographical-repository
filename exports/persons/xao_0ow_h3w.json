{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"xao_0ow_h3w","canonical_person_id":"xao_0ow_h3w","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["xao_0ow_h3w"],"persons":[{"id":"xao_0ow_h3w","label":"讓（列侯）（淮南衡山列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"臣讓","mention_ids":["c-shiji-118-huainan:m024-0134"]}],"evidence":[{"mention_id":"c-shiji-118-huainan:m024-0134","chapter_id":"c-shiji-118-huainan","paragraph_id":"c-shiji-118-huainan:p024","quote":"臣讓"}]}],"source_mention_summary":[{"source_id":"s-shiji118-huainan","work_id":"w-shiji","book_id":"b-shiji-118","chapter_id":"c-shiji-118-huainan","mention_count":1,"mention_ids":["c-shiji-118-huainan:m024-0134"],"paragraph_ids":["c-shiji-118-huainan:p024"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji118-huainan"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-118-huainan:m024-0134","start":134,"end":136,"surface":"臣讓","kind":"person","person_id":"xao_0ow_h3w","status":"contextual_provisional","paragraph_id":"c-shiji-118-huainan:p024","chapter_id":"c-shiji-118-huainan"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-118-huainan:p024","text":"吏因捕太子、王后，圍王宮，盡求捕王所與謀反賓客在國中者，索得反具以聞。上下公卿治，所連引與淮南王謀反列侯二千石豪傑數千人，皆以罪輕重受誅。衡山王賜，淮南王弟也，當坐收，有司請逮捕衡山王。天子曰：「諸侯各以其國為本，不當相坐。與諸侯王列侯會肄丞相諸侯議。」趙王彭祖、列侯臣讓等四十三人議，皆曰：「淮南王安甚大逆無道，謀反明白，當伏誅。」膠西王臣端議曰：「淮南王安廢法行邪，懷詐偽心，以亂天下，熒惑百姓，倍畔宗廟，妄作妖言。春秋曰『臣無將，將而誅』。安罪重於將，謀反形已定。臣端所見其書節印圖及他逆無道事驗明白，甚大逆無道，當伏其法。而論國吏二百石以上及比者，宗室近幸臣不在法中者，不能相教，當皆免官削爵為士伍，毋得宦為吏。其非吏，他贖死金二斤八兩。以章臣安之罪，使天下明知臣子之道，毋敢復有邪僻倍畔之意。」丞相弘、廷尉湯等以聞，天子使宗正以符節治王。未至，淮南王安自剄殺。王后荼、太子遷諸所與謀反者皆族。天子以伍被雅辭多引漢之美，欲勿誅。廷尉湯曰：「被首為王畫反謀，被罪無赦。」遂誅被。國除為九江郡。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-118-huainan:m024-0003","start":3,"end":5,"surface":"太子","kind":"person","person_id":"yqp_nlb_p1p_AFAC","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m024-0006","start":6,"end":8,"surface":"王后","kind":"person","person_id":"8ie_pfa_02i","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m024-0021","start":21,"end":23,"surface":"賓客","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-118-huainan:m024-0037","start":37,"end":39,"surface":"公卿","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-118-huainan:m024-0045","start":45,"end":48,"surface":"淮南王","kind":"person","person_id":"yqp_nlb_p1p_AFA","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m024-0050","start":50,"end":57,"surface":"列侯二千石豪傑","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-118-huainan:m024-0069","start":69,"end":73,"surface":"衡山王賜","kind":"person","person_id":"yqp_nlb_p1p_AFC","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m024-0074","start":74,"end":77,"surface":"淮南王","kind":"person","person_id":"yqp_nlb_p1p_AFA","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m024-0089","start":89,"end":92,"surface":"衡山王","kind":"person","person_id":"yqp_nlb_p1p_AFC","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m024-0093","start":93,"end":95,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m024-0127","start":127,"end":131,"surface":"趙王彭祖