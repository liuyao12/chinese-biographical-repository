{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004234","canonical_person_id":"hya_7qu_m25","id_aliases":["cbr-p004234"],"identity_policy":"contextual_provisional","person_ids":["hya_7qu_m25"],"persons":[{"id":"hya_7qu_m25","label":"穰侯（白起王翦列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"穰侯","mention_ids":["c-shiji-073-baiwang:m001-0042"]}],"evidence":[{"mention_id":"c-shiji-073-baiwang:m001-0042","chapter_id":"c-shiji-073-baiwang","paragraph_id":"c-shiji-073-baiwang:p001","quote":"穰侯"}],"id_aliases":["cbr-p004234"]}],"source_mention_summary":[{"source_id":"s-shiji-073-baiwang","work_id":"w-shiji","book_id":"b-shiji-073","chapter_id":"c-shiji-073-baiwang","mention_count":1,"mention_ids":["c-shiji-073-baiwang:m001-0042"],"paragraph_ids":["c-shiji-073-baiwang:p001"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-073-baiwang"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-073-baiwang:m001-0042","start":42,"end":44,"surface":"穰侯","kind":"person","person_id":"hya_7qu_m25","status":"contextual_provisional","paragraph_id":"c-shiji-073-baiwang:p001","chapter_id":"c-shiji-073-baiwang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji073-003","person_id":"hya_7qu_m25","surfaces":["穰侯"],"scope":"same_chapter","chapter_ids":["c-shiji-073-baiwang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-073-baiwang:p001","quote":"白起者，郿人也。善用兵，事秦昭王。昭王十三年，而白起為左庶長，將而擊韓之新城。是歲，穰侯相秦，舉任鄙以為漢中守。其明年，白起為左更，攻韓、魏於伊闕，斬首二十四萬，又虜其將公孫喜，拔五城。起遷為國尉。涉河取韓安邑以東，到乾河。明年，白起為大良造。攻魏，拔之，取城小大六十一。明年，起與客卿錯攻垣城，拔之。後五年，白起攻趙，拔光狼城。後七年，白起攻楚，拔鄢、鄧五城。其明年，攻楚，拔郢，燒夷陵，遂東至竟陵。楚王亡去郢，東走徙陳。秦以郢為南郡。白起遷為武安君。武安君因取楚，定巫、黔中郡。昭王三十四年，白起攻魏，拔華陽，走芒卯，而虜三晉將，斬首十三萬。與趙將賈偃戰，沈其卒二萬人於河中。昭王四十三年，白起攻韓陘城，拔五城，斬首五萬。四十四年，白起攻南陽太行道，絕之。"}],"rationale":"依前3段明示稱名與本地敘事暫接，白起武安君、馮亭華陽君按明示相配；平陽君、平原君、穰侯與客卿錯不由記憶補姓名。東徙陳楚王保存未名候選，不全域接同國王稱；三晉將群體不補成員。華陽斬首數保留本篇，不因同名消除他篇差異。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-073-baiwang:p001","text":"白起者，郿人也。善用兵，事秦昭王。昭王十三年，而白起為左庶長，將而擊韓之新城。是歲，穰侯相秦，舉任鄙以為漢中守。其明年，白起為左更，攻韓、魏於伊闕，斬首二十四萬，又虜其將公孫喜，拔五城。起遷為國尉。涉河取韓安邑以東，到乾河。明年，白起為大良造。攻魏，拔之，取城小大六十一。明年，起與客卿錯攻垣城，拔之。後五年，白起攻趙，拔光狼城。後七年，白起攻楚，拔鄢、鄧五城。其明年，攻楚，拔郢，燒夷陵，遂東至竟陵。楚王亡去郢，東走徙陳。秦以郢為南郡。白起遷為武安君。武安君因取楚，定巫、黔中郡。昭王三十四年，白起攻魏，拔華陽，走芒卯，而虜三晉將，斬首十三萬。與趙將賈偃戰，沈其卒二萬人於河中。昭王四十三年，白起攻韓陘城，拔五城，斬首五萬。四十四年，白起攻南陽太行道，絕之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-073-baiwang:m001-0000","start":0,"end":2,"surface":"白起","kind":"person","person_id":"0xk_jpf_0xw","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m001-0013","start":13,"end":16,"surface":"秦昭王","kind":"person","person_id":"935_1k9_x7t","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m001-0017","start":17,"end":19,"surface":"昭王","kind":"person","person_id":"935_1k9_x7t","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m001-0024","start":24,"end":26,"surface":"白起","kind":"person","person_id":"0xk_jpf_0xw","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m001-0042","start":42,"end":44,"surface":"穰侯","kind":"person","person_id":"hya_7qu_m25","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m001-0048","start":48,"end":50,"surface":"任鄙","kind":"person","person_id":"0y8_25d_hrm","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m001-0060","start":60,"end":62,"surface":"白起","kind":"person","person_id":"