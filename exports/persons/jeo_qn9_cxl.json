ntion_ids":["c-sanguozhi-060-zhonglimu:line099:m0016"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-sanguozhi-060-zhonglimu"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-wu060-zhongliyi-father","subject_person_id":"jeo_qn9_cxl","object_person_id":"2ue_nmk_m3s_A","predicate":"father","qualifiers":{"source_term":"子褘嗣，代領兵"},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-060","chapter_id":"c-sanguozhi-060-zhonglimu","source_id":"s-sanguozhi-060-zhonglimu","paragraph_id":"c-sanguozhi-060-zhonglimu:line097","quote":"　　永安六年，蜀併於魏，武陵五谿夷與蜀接界。時論懼叛亂，乃以牧為平魏將軍，領武陵太守，往之郡。魏遣漢葭縣長郭純試守武陵太守，率涪陵民入蜀遷陵界，屯於赤沙，誘致諸夷邑君，或起應純，又進攻酉陽縣，郡中震懼。牧問朝吏曰：「西蜀傾覆，邊境見侵，何以禦之？」皆對曰：「今二縣山險，諸夷阻兵，不可以軍驚擾，驚擾則諸夷盤結。宜以漸安，可遣恩信吏宣教慰勞。」牧曰：「不然。外境內侵，誑誘人民，當及其根柢未深而撲取之，此救火貴速之勢也。」敕外趣嚴，掾史沮儀者便行軍法。撫夷將軍高尚說牧曰：「昔潘太常督兵五萬，然後以討五谿夷耳。是時劉氏連和，諸夷率化，今既無往日之援，而郭純已據遷陵，而明府以三千兵深入，尚未見其利也。」牧曰：「非常之事，何得循舊？」即率所領，晨夜進道，緣山險行，垂二千里，從塞上，斬惡民懷異心者魁帥百餘人及其支黨凡於余級，純等散，五谿平。遷公安督、揚武將軍，封都鄉侯，徙濡須督。復以前將軍假節，領武陵太守。","object_person_mention_id":"c-sanguozhi-060-zhonglimu:line097:m0030"},{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-060","chapter_id":"c-sanguozhi-060-zhonglimu","source_id":"s-sanguozhi-060-zhonglimu","paragraph_id":"c-sanguozhi-060-zhonglimu:line099","quote":"　　卒官。家無餘財，士民思之。子褘嗣，代領兵。","subject_person_mention_id":"c-sanguozhi-060-zhonglimu:line099:m0016"}],"interpretation_note":"