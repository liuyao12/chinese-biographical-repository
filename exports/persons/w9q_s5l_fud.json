nce_groups":[{"canonical_mention_id":"c-jinshu-069-liuwei:p005:m0297","mention_ids":["c-jinshu-069-liuwei:p005:m0297"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-069-liuwei-ws2012453"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin069-liusui-father","subject_person_id":"w9q_s5l_fud","object_person_id":"hnd_3at_h4i","predicate":"father","qualifiers":{"source_term":"子綏，初舉秀才"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-069","chapter_id":"c-jinshu-069-liuwei","source_id":"s-jinshu-069-liuwei-ws2012453","paragraph_id":"c-jinshu-069-liuwei:p005","quote":"初，隗以王敦威權太盛，終不可制，勸帝出腹心以鎮方隅，故以譙王承為湘州，續用隗及戴若思為都督。敦甚惡之，與隗書曰：「頃承聖上顧眄足下，今大賊未滅，中原鼎沸，欲與足下周生之徒戮力王室，共靜海內。若其泰也，則帝祚於是乎隆；若其否也，則天下永無望矣。」隗答曰：「魚相忘於江湖，人相忘於道術。竭股肱之力，效之以忠貞，吾之志也。」敦得書甚怒。及敦作亂，以討隗為名，詔征隗還京師，百官迎之於道，隗岸幘大言，意氣自若。及入見，與刁協奏請誅王氏。不從，有懼色，率眾屯金城。及敦克石頭，隗攻之不拔，入宮告辭，帝雪涕與之別。隗至淮陰，為劉遐所襲，攜妻子及親信二百餘人奔于石勒，勒以為從事中郎、太子太傅。卒年六十一。子綏，初舉秀才，除駙馬都尉、奉朝請。隨隗奔勒，卒。孫波嗣。","subject_person_mention_id":"c-jinshu-069-liuwei:p005:m0297","object_person_mention_id":"c-jinshu-069-liuwei:p005:m0002"}],"status":"source_attested","interpretation_note":"隨父奔石勒，另載子綏卒。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"fami