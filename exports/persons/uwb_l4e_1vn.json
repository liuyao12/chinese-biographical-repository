s":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m042-0000","start":0,"end":3,"surface":"人有毀","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、氏族、未名者或未定指代，未補成員、姓名及世系。"},{"id":"c-shiji-069-su:m042-0003","start":3,"end":5,"surface":"蘇秦","kind":"person","person_id":"98y_02x_z6o","status":"contextual_provisional"},{"id":"c-shiji-069-su:m042-0024","start":24,"end":26,"surface":"蘇秦","kind":"person","person_id":"98y_02x_z6o","status":"contextual_provisional"},{"id":"c-shiji-069-su:m042-0032","start":32,"end":34,"surface":"燕王","kind":"person","person_id":"49x_hsj_tmo","status":"contextual_provisional"},{"id":"c-shiji-069-su:m042-0039","start":39,"end":41,"surface":"蘇秦","kind":"person","person_id":"98y_02x_z6o","status":"contextual_provisional"},{"id":"c-shiji-069-su:m042-0042","start":42,"end":44,"surface":"燕王","kind":"person","person_id":"49x_hsj_tmo","status":"contextual_provisional"},{"id":"c-shiji-069-su:m042-0128","start":128,"end":131,"surface":"忠信者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、氏族、未名者或未定指代，未補成員、姓名及世系。"},{"id":"c-shiji-069-su:m042-0138","start":138,"end":141,"surface":"進取者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、氏族、未名者或未定指代，未補成員、姓名及世系。"},{"id":"c-shiji-069-su:m042-0152","start":152,"end":154,"surface":"齊王","kind":"person","person_id":"iqu_pas_2r5","status":"contextual_provisional"},{"id":"c-shiji-069-su:m042-0163","start":163,"end":165,"surface":"老母","kind":"person","person_id":"bj5_9k5_t5c","status":"contextual_provisional"},{"id":"c-shiji-069-su:m042-0183","start":183,"end":185,"surface":"曾參","kind":"person","person_id":"uy7_vln_q60","status":"contextual_provisional"},{"id":"c-shiji-069-su:m042-0188","start":188,"end":190,"surface":"伯夷","kind":"person","person_id":"joz_coh_yfm","status":"contextual_provisional"},{"id":"c-shiji-069-su:m042-0193","start":193,"end":195,"surface":"尾生","kind":"person","person_id":"l3n_6lt_37x","stat