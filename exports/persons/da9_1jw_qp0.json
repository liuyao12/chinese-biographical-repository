da9_1jw_qp0","status":"contextual_provisional","paragraph_id":"c-shiji-108-han:p012","chapter_id":"c-shiji-108-han"},{"id":"c-shiji-108-han:m013-0026","start":26,"end":28,"surface":"衞青","kind":"person","person_id":"da9_1jw_qp0","status":"contextual_provisional","paragraph_id":"c-shiji-108-han:p013","chapter_id":"c-shiji-108-han"}],"relations":[],"title_holdings":[{"id":"th-shiji108-040","person_id":"da9_1jw_qp0","title":"車騎將軍","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-108-han","source_id":"s-shiji-108-han","paragraph_id":"c-shiji-108-han:p012","quote":"車騎將軍衞青擊匈奴，出上谷，破胡蘢城。將軍李廣爲匈奴所得，復失之；公孫敖大亡卒：皆當斬，贖爲庶人。明年，匈奴大入邊，殺遼西太守，及入鴈門，所殺略數千人。車騎將軍衞青擊之，出鴈門。衞尉安國爲材官將軍，屯於漁陽。安國捕生虜，言匈奴遠去。即上書言方田作時，請且罷軍屯。罷軍屯月餘，匈奴大入上谷、漁陽。安國壁乃有七百餘人，出與戰，不勝，復入壁。匈奴虜略千餘人及畜產而去。天子聞之，怒，使使責讓安國。徒安國益東，屯右北平。是時匈奴虜言當入東方。"}],"attestations":[{"id":"th-shiji108-040:a001","paragraph_id":"c-shiji-108-han:p012","start":0,"end":4,"surface":"車騎將軍","person_mention_id":"c-shiji-108-han:m012-0004","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"記來源任官或用稱；未明年月及終止事件保持未知，篇末附載評論不作獨立任官證據。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji108-045","person_id":"da9_1jw_qp0","title":"將軍","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-108-han","source_id":"s-shiji-108-han","paragraph_id":"c-shiji-108-han:p013","quote":"安國始爲御史大夫及護軍，後稍斥疎，下遷；而新幸壯將軍衞青等有功，益貴。安國既疎遠，默默也；將屯又爲匈奴所欺，失亡多，甚自愧。幸得罷歸，乃益東徙屯，意忽忽不樂。數月，病歐血死。安國以元朔二年中卒。"}],"attestations":[{"id":"th-shiji108-045:a001","paragraph_id":"c-shiji-108-han:p013","start":24,"end":26,"surface":"將軍","person_mention_id":"c-shiji-108-han:m013-0026","usage":"retrospective"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"記來源任官或用稱；未明年月及終止事件保