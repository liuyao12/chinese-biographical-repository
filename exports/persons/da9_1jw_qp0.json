atus":"contextual_provisional"},{"id":"c-shiji-108-han:m012-0196","start":196,"end":198,"surface":"安國","kind":"person","person_id":"adb_4so_0qm","status":"contextual_provisional"}],"chapter_id":"c-shiji-108-han","book_id":"b-shiji-108","work_id":"w-shiji","source_id":"s-shiji-108-han"},{"id":"c-shiji-108-han:p013","text":"安國始爲御史大夫及護軍，後稍斥疎，下遷；而新幸壯將軍衞青等有功，益貴。安國既疎遠，默默也；將屯又爲匈奴所欺，失亡多，甚自愧。幸得罷歸，乃益東徙屯，意忽忽不樂。數月，病歐血死。安國以元朔二年中卒。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-108-han:m013-0000","start":0,"end":2,"surface":"安國","kind":"person","person_id":"adb_4so_0qm","status":"contextual_provisional"},{"id":"c-shiji-108-han:m013-0026","start":26,"end":28,"surface":"衞青","kind":"person","person_id":"da9_1jw_qp0","status":"contextual_provisional"},{"id":"c-shiji-108-han:m013-0035","start":35,"end":37,"surface":"安國","kind":"person","person_id":"adb_4so_0qm","status":"contextual_provisional"},{"id":"c-shiji-108-han:m013-0087","start":87,"end":89,"surface":"安國","kind":"person","person_id":"adb_4so_0qm","status":"contextual_provisional"}],"chapter_id":"c-shiji-108-han","book_id":"b-shiji-108","work_id":"w-shiji","source_id":"s-shiji-108-han"}],"sources":[{"chapter_id":"c-shiji-108-han","work_id":"w-shiji","book_id":"b-shiji-108","source_id":"s-shiji-108-han","source":{"title":"史記／卷108","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷108","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷108&oldid=1765317","revision_id":1765317,"accessed_on":"2026-10-11","extent":"13段正文、1段太史公論、1段索隱述贊。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"去介面模板與現代節標題；數位見證的單字語言轉換包裹符號解除，包裹內原字不變。其餘原字、標點與段落次序保留。","note":"未核底本影像。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalizat