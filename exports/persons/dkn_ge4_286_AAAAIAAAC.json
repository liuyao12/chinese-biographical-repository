_id":"dkn_ge4_286_AAAAIAAA","status":"contextual_provisional","source_role":"yu"},{"id":"c-jinshu-053-minhuai-family:p002:m0048","start":48,"end":49,"surface":"虨","kind":"person","person_id":"dkn_ge4_286_AAAAIAAAA","status":"contextual_provisional","source_role":"bin"},{"id":"c-jinshu-053-minhuai-family:p002:m0050","start":50,"end":51,"surface":"臧","kind":"person","person_id":"dkn_ge4_286_AAAAIAAAB","status":"contextual_provisional","source_role":"zang"},{"id":"c-jinshu-053-minhuai-family:p002:m0052","start":52,"end":53,"surface":"尚","kind":"person","person_id":"dkn_ge4_286_AAAAIAAAC","status":"contextual_provisional","source_role":"shang"}],"chapter_id":"c-jinshu-053-minhuai-family","book_id":"b-jinshu-053","work_id":"w-jinshu","source_id":"s-jinshu-053-ws2595666-rendered-family"},{"id":"c-jinshu-053-minhuai-family:p005","text":"尚字敬仁。永康元年四月，封為襄陽王。永寧元年八月，立為皇太孫。太安元年三月癸卯，薨，帝服齊衰期，諡曰沖太孫。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","source_position":{"acquisition":"current_rendered_tool_text","reported_revision_id":2595666,"fixed_body_obtained":false,"tool_line":154},"mentions":[{"id":"c-jinshu-053-minhuai-family:p005:m0000","start":0,"end":1,"surface":"尚","kind":"person","person_id":"dkn_ge4_286_AAAAIAAAC","status":"contextual_provisional","source_role":"shang"},{"id":"c-jinshu-053-minhuai-family:p005:m0002","start":2,"end":4,"surface":"敬仁","kind":"person","person_id":"dkn_ge4_286_AAAAIAAAC","status":"contextual_provisional","source_role":"shang"},{"id":"c-jinshu-053-minhuai-family:p005:m0014","start":14,"end":17,"surface":"襄陽王","kind":"person","person_id":"dkn_ge4_286_AAAAIAAAC","status":"contextual_provisional","source_role":"shang"},{"id":"c-jinshu-053-minhuai-family:p005:m0027","start":27,"end":30,"surface":"皇太孫","kind":"person","person_id":"dkn_ge4_286_AAAAIAAAC","status":"contextual_provisional","source_role":"shang"},{"id":"c-jinshu-053-minhuai-family:p005:m0042","start":42,"end":43,"surface":"帝","kind":"person","person_id":"dkn_ge4_286_AAAAIAA","status":"contextual_provisional","source_role":"hui"},{"id":"c-jinshu-053-minhuai-family:p005:m0050","start":50,"end":53,"surface":"沖太孫","kind":"person","person_id":"dkn_ge4_286_AAAAIAAAC","status":"contextual_provisional","source_role":"shang"}],"chapter_id":"c-jinshu-053-minhuai-family","book_id":"b-jinshu-053","work_id":"w-jinshu","source_id":"s-jinshu-053-ws2595666-rendered-family"},{"id":"c-jinshu-064-wudi-sons-rendered:p014","text":"及沖太孫薨，齊王冏表曰：「東宮曠然，塚嗣莫繼。天下大業，帝王神器，必建儲副，以固洪基。今者後宮未有孕育，不可庶幸將來而虛天緒，非祖宗之遺志，社稷之長計也。禮，兄弟之子猶子，故漢成無嗣，繼由定陶；孝和之絕，安以紹興。此先王之令典，往代之成式也。清河王覃神姿岐嶷，慧智早成，康王正妃周氏所生，先帝眾孫之中，於今為嫡。昔薄姬賢明，文則承位。覃外祖恢世載名德，覃宜奉宗廟之重，統無窮之祚，以甯四海顒顒之望。覃兄弟雖並出紹，可簡令淑還為國胤，不替其嗣。輒諮大將軍穎及群公卿士，咸同大願。請具禮儀，擇日迎拜。」遂立覃為皇太子。既而河間王顒協遷大駕，表成都王穎為皇太弟，廢覃復為清河王。初，覃為清河世子，所佩金鈴欻生隱起如麻粟，祖母陳太妃以為不祥，毀而賣之。占者以金是晉行大興之祥，覃為皇胤，是其瑞也。毀而賣之，象覃見廢不終之驗也。永嘉初，前北軍中候任城呂雍、度支校尉陳顏等謀立覃為太子，事覺，幽于金墉城。未幾，被害，時年十四，葬以庶人禮。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","source_position":{"acquisition":"current_rendered_tool_text","reported_revision_id":2622004,"fixed_body_obtained":false,"tool_line":192},"mentions":[{"id":"c-jinshu-064-wudi-sons-rendered:p014:m0001","start":1,"end":4,"surface":"沖太孫","kind":"person","person_id":"dkn_ge4_286_AAAAIAAAC","status":"contextual_provisional","source_role":"shang"},{"id":"c-jinshu-064-wudi-sons-rendered:p014:m0006","start":6,"end":9,"surface":"齊王冏","kind":"person","person_id":"dkn_ge4_286_AAAAIBD","status":"contextual_provisional","source_role":"jiong"},{"id":"c-jinshu-064-wudi-sons-rendered:p014:m0087","start":87,"end":89,"surface":"漢成","kind":"person","person_id":"1r1_4hp_csg","status":"contextual_provisional","source_role":"hancheng"},{"id":"c-jinshu-064-wudi-sons-rendered:p014:m0094","start":94,"end":96,"surface":"定陶","kind":"person","person_id":"fst_enp_ln8","status":"contextual_provisional","source_role":"han_aidi"},{"id":"c-jinshu-064-wudi-sons-rendered:p014:m0097","start":97,"end":99,"surface":"孝和","kind":"person","person_id":"3e7_rht_k5z","