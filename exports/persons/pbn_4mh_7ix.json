{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"pbn_4mh_7ix","canonical_person_id":"pbn_4mh_7ix","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["pbn_4mh_7ix"],"persons":[{"id":"pbn_4mh_7ix","label":"姚定漢（大宛列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"姚定漢","mention_ids":["c-shiji-123-dayuan:m029-0235"]},{"surface":"定漢","mention_ids":["c-shiji-123-dayuan:m030-0024"]}],"evidence":[{"mention_id":"c-shiji-123-dayuan:m029-0235","chapter_id":"c-shiji-123-dayuan","paragraph_id":"c-shiji-123-dayuan:p029","quote":"姚定漢"},{"mention_id":"c-shiji-123-dayuan:m030-0024","chapter_id":"c-shiji-123-dayuan","paragraph_id":"c-shiji-123-dayuan:p030","quote":"定漢"}]}],"source_mention_summary":[{"source_id":"s-shiji123-dayuan","work_id":"w-shiji","book_id":"b-shiji-123","chapter_id":"c-shiji-123-dayuan","mention_count":2,"mention_ids":["c-shiji-123-dayuan:m029-0235","c-shiji-123-dayuan:m030-0024"],"paragraph_ids":["c-shiji-123-dayuan:p029","c-shiji-123-dayuan:p030"],"passage_count":2}],"most_mentioned_source_ids":["s-shiji123-dayuan"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-123-dayuan:m029-0235","start":235,"end":238,"surface":"姚定漢","kind":"person","person_id":"pbn_4mh_7ix","status":"contextual_provisional","paragraph_id":"c-shiji-123-dayuan:p029","chapter_id":"c-shiji-123-dayuan"},{"id":"c-shiji-123-dayuan:m030-0024","start":24,"end":26,"surface":"定漢","kind":"person","person_id":"pbn_4mh_7ix","status":"contextual_provisional","paragraph_id":"c-shiji-123-dayuan:p030","chapter_id":"c-shiji-123-dayuan"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-123-dayuan:p029","text":"而漢使者往既多，其少從率多進熟於天子，言曰：「宛有善馬在貳師城，匿不肯與漢使。」天子既好宛馬，聞之甘心，使壯士車令等持千金及金馬以請宛王貳師城善馬。宛國饒漢物，相與謀曰：「漢去我遠，而鹽水中數敗，出其北有胡寇，出其南乏水草。又且往往而絕邑，乏食者多。漢使數百人為輩來，而常乏食，死者過半，是安能致大軍乎？無柰我何。且貳師馬，宛寶馬也。」遂不肯予漢使。漢使怒，妄言，椎金馬而去。宛貴人怒曰：「漢使至輕我！」遣漢使去，令其東邊郁成遮攻殺漢使，取其財物。於是天子大怒。諸嘗使宛姚定漢等言宛兵弱，誠以漢兵不過三千人，彊弩射之，即盡虜破宛矣。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-123-dayuan:m029-0016","start":16,"end":18,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m029-0040","start":40,"end":42,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m029-0055","start":55,"end":57,"surface":"車令","kind":"person","person_id":"l7y_ed2_wom","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m029-0066","start":66,"end":68,"surface":"宛王","kind":"person","person_id":"2l2_58b_q4i","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m029-0188","start":188,"end":191,"surface":"宛貴人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-123-dayuan:m029-0226","start":226,"end":228,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m029-0235","start":235,"end":238,"surface":"姚定漢","kind":"person","person_id":"pbn_4mh_7ix","status":"contextual_provisional"}],"chapter_id":"c-shiji-123-dayuan","book_id":"b-shiji-123","work_id":"w-shiji","source_id":"s-shiji123-dayuan"},{"id":"c-shiji-123-dayuan:p030","text":"天子已嘗使浞野侯攻樓蘭，以七百騎先至，虜其王，以定漢等言為然，而欲侯寵姬李氏，拜李廣利為貳師將軍，發屬國六千騎，及郡國惡少年數萬人，以往伐宛。期至貳師城取善馬，故號「貳師將軍」。趙始成為軍正，故浩侯王恢使導軍，而李哆為校尉，制軍事。是歲太初元年也。而關東蝗大起，蜚西至敦煌。","annotation_status":"in_progress","t