ji-081-lianlin:m016-0142"],"paragraph_ids":["c-shiji-081-lianlin:p014","c-shiji-081-lianlin:p015","c-shiji-081-lianlin:p016"],"passage_count":3},{"source_id":"s-shiji-043-zhao","work_id":"w-shiji","book_id":"b-shiji-043","chapter_id":"c-shiji-043-zhao","mention_count":3,"mention_ids":["c-shiji-043-zhao:m104-0012","c-shiji-043-zhao:m104-0020","c-shiji-043-zhao:m104-0023"],"paragraph_ids":["c-shiji-043-zhao:p104"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-081-lianlin"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji081-002","subject_person_id":"6zt_fca_se8_A","predicate":"father","object_person_id":"6zt_fca_se8","status":"source_attested","evidence":[{"chapter_id":"c-shiji-081-lianlin","source_id":"s-shiji-081-lianlin","paragraph_id":"c-shiji-081-lianlin:p014","quote":"後四年，趙惠文王卒，子孝成王立。七年，秦與趙兵相距長平，時趙奢已死，而藺相如病篤，趙使廉頗將攻秦，秦數敗趙軍，趙軍固壁不戰。秦數挑戰，廉頗不肯。趙王信秦之間。秦之間言曰：「秦之所惡，獨畏馬服君趙奢之子趙括爲將耳。」趙王因以括爲將，代廉頗。藺相如曰：「王以名使括，若膠柱而鼓瑟耳。括徒能讀其父書傳，不知合變也。」趙王不聽，遂將之。"}],"qualifiers":{"source_term":"馬服君趙奢之子趙括","historicity":"historical_tradition"},"interpretation_note":"只保存明示子與母的來源主張；括母未名不補姓名，事其父及妾自稱不單憑字面推婚姻身分，繼位本身不作父子證據。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji081-003","subject_person_id":"6zt_fca_se8_A","predicate":"mother","object_person_id":"rsp_dwj_xp6","status":"source_attested","evidence":[{"chapter_id":"c-shiji-081-lianlin","source_id":"s-shiji-081-lianlin","paragraph_id":"c-shiji-081-lianlin:p015","quote":"趙括自少時學兵法，言兵事，以天下莫能當。嘗與其父奢言兵事，奢不能難，然不謂善。括母問奢其故，奢曰：「兵，死地也，而括易言之。使趙不將括即已，若必將之，破趙軍者必括也。」及括將行，其母上書言於王曰：「括不可使將。」王曰：「何以？」對曰：「始妾事其父，時爲將，身所奉飯飲而進食者以十數，所友者以百數，大王及宗室所賞賜者盡以予軍吏士大夫，受命之日，不問家事。今括一旦爲將，東向而朝，軍吏無敢仰視之者，王所賜金帛，歸藏於家，而日視便利田宅可買者買之。王以爲何如其父？父子異心，原王勿遣。」王曰：「母置之，吾已決矣。」括母因曰：「王終遣之，即有如不稱，妾得無隨坐乎？」王許諾。"}],"qualifiers":{"source_term":"括母問奢其故","historicity":"historical_tradition"},"interpretation_note":"只保存明示子與母的來源主張；括母未名不補姓名，事其父及妾自稱不單憑字面推婚姻身分，繼位本身不作父子證據。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[{"connection":"father","generation_distance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-081-lianlin","source_id":"s-shiji-081-lianlin","paragraph_id":"c-shiji-081-lianlin:p014","quote":"後四年，趙惠文王卒，子孝成王立。七年，秦與趙兵相距長平，時趙奢已死，而藺相如病篤，趙使廉頗將攻秦，秦數敗趙軍，趙軍固壁不戰。秦數挑戰，廉頗不肯。趙王信秦之間。秦之間言曰：「秦之所惡，獨畏馬服君趙奢之子趙括爲將耳。」趙王因以括爲將，代廉頗。藺相如曰：「王以名使括，若膠柱而鼓瑟耳。括徒能讀其父書傳，不知合變也。」趙王不聽，遂將之。","source_term":"馬服君趙奢之子趙括"}],"source_assertion_id":"a-shiji081-002","interpretation_note":"以此受傳正文的明示近親主張配置局部家族；不合併跨篇候選身份、不補闕名世代，不表示遠祖世系已核實。分支字元不是長幼排行。","reviewer":"Codex（AI 代理）","parent_person_id":"6zt_fca_se8","person_id":"6zt_fca_se8_A"}],"mentions":[{"id":"c-shiji-043-zhao:m104-0012","start":12,"end":14,"surface":"趙括","kind":"person","person_id":"ja0_1pr_vhk","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p104","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m104-0020","start":20,"end":22,"surface":"趙括","kind":"person","person_id":"ja0_1pr_vhk","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p104","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m104-0023","start":23,"end":25,"surface":"趙括","kind":"person","person_id":"ja0_1pr_vhk","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p104","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-081-lianlin:m014-0100","start":100,"end":102,"surface":"趙括","kind":"person","person_id":"6zt_fca_se8_A","status":"contextual_provisional","paragraph_id":"c-shiji-081-lianlin:p014","chapter_id":"c-shiji-081-lianlin"},{"id":"c-shiji-081-lianlin:m014-0111","start":111,"end":112,"surface":"括","kind":"person","person_id":"6zt_fca_se8_A","status":"contextual_provisional","paragraph_id"