rsp_dwj_xp6","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m015-0260","start":260,"end":261,"surface":"王","kind":"person","person_id":"d9b_5t4_9eb_A","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m015-0271","start":271,"end":272,"surface":"妾","kind":"person","person_id":"rsp_dwj_xp6","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m015-0279","start":279,"end":280,"surface":"王","kind":"person","person_id":"d9b_5t4_9eb_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-081-lianlin","book_id":"b-shiji-081","work_id":"w-shiji","source_id":"s-shiji-081-lianlin"},{"id":"c-shiji-081-lianlin:p016","text":"趙括既代廉頗，悉更約束，易置軍吏。秦將白起聞之，縱奇兵，詳敗走，而絶其糧道，分斷其軍爲二，士卒離心。四十餘日，軍餓，趙括出鋭卒自博戰，秦軍射殺趙括。括軍敗，數十萬之衆遂降秦，秦悉阬之。趙前後所亡凡四十五萬。明年，秦兵遂圍邯鄲，歳餘，幾不得脱。賴楚、魏諸侯來救，乃得解邯鄲之圍。趙王亦以括母先言，竟不誅也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-081-lianlin:m016-0000","start":0,"end":2,"surface":"趙括","kind":"person","person_id":"6zt_fca_se8_A","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m016-0004","start":4,"end":6,"surface":"廉頗","kind":"person","person_id":"we8_3f9_z9b","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m016-0014","start":14,"end":16,"surface":"軍吏","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未定角色或複數指代保存，不補姓名。"},{"id":"c-shiji-081-lianlin:m016-0017","start":17,"end":21,"surface":"秦將白起","kind":"person","person_id":"lu3_ob9_3ri","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m016-0058","start":58,"end":60,"surface":"趙括","kind":"person","person_id":"6zt_fca_se8_A","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m016-0071","start":71,"end":73,"surface":"趙括","kind":"person","person_id":"6zt_fca_se8_A","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m016-0074","start":74,"end":75,"surface":"括","kind":"person","person_id":"6zt_fca_se8_A","status":"contextual_provisional"},{"id":"c-shiji-081-lianli