ed":false},"family_paths":[],"mentions":[{"id":"c-songshu-047-liuhuaisu-received:p002:m0359","start":359,"end":361,"surface":"符嗣","kind":"person","person_id":"n7s_oah_7fe","status":"contextual_provisional","paragraph_id":"c-songshu-047-liuhuaisu-received:p002","chapter_id":"c-songshu-047-liuhuaisu-received"},{"id":"c-songshu-047-liuhuaisu:p002:m0264","start":264,"end":266,"surface":"符嗣","kind":"person","person_id":"n7s_oah_7fe","status":"contextual_provisional","interpretation_note":"依完整單元上下文辨指；AI暫定，未核影像。","paragraph_id":"c-songshu-047-liuhuaisu:p002","chapter_id":"c-songshu-047-liuhuaisu"},{"id":"c-songshu-047-tanzhi:p001:m0144","start":144,"end":146,"surface":"苻嗣","kind":"person","person_id":"n7s_oah_7fe","status":"contextual_provisional","paragraph_id":"c-songshu-047-tanzhi:p001","chapter_id":"c-songshu-047-tanzhi"}],"relations":[],"title_holdings":[{"id":"th-songshu-047-liuhuaisu-received-2-354","title":"偽輔國將軍","kind":"office","mode":"attestation","person_id":"n7s_oah_7fe","attestations":[{"id":"th-songshu-047-liuhuaisu-received-2-354:a","paragraph_id":"c-songshu-047-liuhuaisu-received:p002","start":354,"end":359,"surface":"偽輔國將軍","person_mention_id":"c-songshu-047-liuhuaisu-received:p002:m0359","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-047","chapter_id":"c-songshu-047-liuhuaisu-received","source_id":"s-songshu-047-liuhuaisu-received-ws2190557","paragraph_id":"c-songshu-047-liuhuaisu-received:p002","quote":"初為劉敬宣寧朔府司馬，東征孫恩，有戰功，又為龍驤司馬、費令。聞高祖起義，棄縣來奔。京邑平定，振武將軍道規追桓玄，以懷肅為司馬。玄留何澹之、郭銓等戍桑落洲，進擊破之。潁川太守劉統平，除高平太守。玄既死，從子振大破義軍於楊林，義軍退尋陽。懷肅與江夏相張暢之攻澹之於西塞，破之。偽鎮東將軍馮該戍夏口東岸，孟山圖據魯山城，桓仙客守偃月壘，皆連壁相望。懷肅與道規攻之，躬擐甲冑，陷二城，馮該走石城，生擒仙客。義熙元年正月，振敗走，道規遣懷肅平石城，斬馮該及其子山靖。三月，桓振復襲江陵，荊州刺史司馬休之出奔，懷肅自雲杜馳赴，日夜兼行，七日而至。振勒兵三萬，旗幟蔽野，躍馬橫矛，躬自突陳。流矢傷懷肅額，眾懼欲奔，懷肅瞋目奮戰，士氣益壯。於是士卒爭先，臨陣斬振首。江陵既平，休之反鎮，執懷肅手曰：「微子之力，吾無所歸矣。」偽輔國將軍符嗣、馬孫、偽龍驤將軍金符青、樂志等屯結江夏，懷肅又討之，梟樂志等。道規加懷肅督江夏九郡，權鎮夏口。","person_mention_id":"c-songshu-047-liuhuaisu-received:p002:m0359"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"th-song047-011","person_id":"n7s_oah_7fe","title":"輔國將軍","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"work_id":"w-songshu","book_id":"b-songshu-047","source_id":"s-songshu-047-liuhuaisu","chapter_id":"c-songshu-047-liuhuaisu","paragraph_id":"c-songshu-047-liuhuaisu:p002","quote":"振武將軍道規追桓𤣥以懷肅為司馬𤣥留何澹之郭銓等戌桑落洲進擊破之潁川太守劉統平除髙平太守𤣥既死從子振大破義軍於楊林義軍退尋陽懷肅與江夏相張暢之攻澹之於西塞破之偽鎮東將軍馮該戍夏口東岸孟山圖據曾山城桓仙客守月壘皆連壁相望懷肅與道規攻之躬擐甲胄䧟二城馮該走石城生擒仙客義熙元年正月振敗走道規遣懷肅平石城斬馮該及其子山靖子月神振復襲江陵荆州刺史司馬休之出奔懷肅自雲杜馳赴日夜兼行七日而至振勒兵三萬旗幟蔽野躍馬横矛躬自突陳流矢傷懷肅頟衆懼欲奔懷肅瞋目奮戰士氣益壯於是士卒争先臨陣斬振首江陵既平休之反鎮執懷肅手曰微子之力吾無所歸矣偽輔國將軍符嗣馬孫偽龍驤將軍金符青樂志等屯結江夏懷肅又討之梟樂志等道規加懷肅督江夏九郡權鎮夏口","person_mention_id":"c-songshu-047-liuhuaisu:p002:m0264"}],"attestations":[{"id":"th-song047-011:a001","start":260,"end":264,"surface":"輔國將軍","paragraph_id":"c-songshu-047-liuhuaisu:p002","person_mention_id":"c-songshu-047-liuhuaisu:p002:m0264","usage":"narrative","date_expression":"義熙元年","normalized_date":{"era":"CE","era_year":405,"year":405,"calendar":"chinese_civil","year_numbering":"astronomical","precision":"year","status":"editorial_provisional","source_expression":"義熙元年","original_quote":"振武將軍道規追桓𤣥以懷肅為司馬𤣥留何澹之郭銓等戌桑落洲進擊破之潁川太守劉統平除髙平太守𤣥既死從子振大破義軍於楊林義軍退尋陽懷肅與江夏相張暢之攻澹之於西塞破之偽鎮東將軍馮該戍夏口東岸孟山圖據曾山城桓仙客守月壘皆連壁相望懷肅與道規攻之躬擐甲胄䧟二城馮該走石城生擒仙客義熙元年正月振敗走道規遣懷肅平石城斬馮該及其子山靖子月神振復襲江陵荆州刺史司馬休之出奔懷肅自雲杜馳赴日夜兼行七日而至振勒兵三萬旗幟蔽野躍馬横矛躬自突陳流矢傷懷肅頟衆懼欲奔懷肅瞋目奮戰士氣益壯於是士卒争先臨陣斬振首江陵既平休之反鎮執懷肅手曰微子之力吾無所歸矣偽輔國將軍符嗣馬孫偽龍驤將軍金符青樂志等屯結江夏懷肅又討之梟樂志等道規加懷肅督江夏九郡權鎮夏口","evidence":[{"work_id":"w-songshu","book_id":"b-songshu-047","source_id":"s-songshu-047-liuhuaisu","chapter_id":"c-songshu-047-liuhuaisu","paragraph_id":"c-songshu-047-liuhuaisu:p002","quote":"振武將軍道規追桓𤣥以懷肅為司馬𤣥留何澹之郭銓等戌桑落洲進擊破之潁川太守劉統平除髙平太守𤣥既死從子振大破義軍於楊林義軍退尋陽懷肅與江夏相張暢之攻澹之於西塞破之偽鎮東將軍馮該戍夏口東岸孟山圖據曾山城桓仙客守月壘皆連壁相望懷肅與道規攻之躬擐甲