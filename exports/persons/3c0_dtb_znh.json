xtual_provisional","paragraph_id":"c-jinshu-058-zhou-qi:p004","chapter_id":"c-jinshu-058-zhou-qi"},{"id":"c-jinshu-058-zhou-qi:p004:m0095","surface":"璯","start":95,"end":96,"person_id":"3c0_dtb_znh","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-058-zhou-qi:p004","chapter_id":"c-jinshu-058-zhou-qi"},{"id":"c-jinshu-058-zhou-qi:p004:m0183","surface":"璯","start":183,"end":184,"person_id":"3c0_dtb_znh","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-058-zhou-qi:p004","chapter_id":"c-jinshu-058-zhou-qi"},{"id":"c-jinshu-058-zhou-zha:p001:m0075","surface":"錢璯","start":75,"end":77,"person_id":"3c0_dtb_znh","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-058-zhou-zha:p001","chapter_id":"c-jinshu-058-zhou-zha"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-058-zhou-qi:p004","text":"初，呉興人錢璯亦起義兵討陳敏，越命爲建武將軍，使率其屬會於京都。璯至廣陵，聞劉聰逼洛陽，畏懦不敢進。帝促以軍期，璯乃謀反。時王敦遷尚書，當應徵與璯俱西。璯陰欲殺敦，藉以舉事，敦聞之，奔告帝。璯遂殺度支校尉陳豐，焚燒邸閣，自號平西大將軍、八州都督，劫孫皓子充，立爲呉王，既而殺之。來寇圮縣。帝遣將軍郭逸、郡尉宋典等討之，並以兵少未敢前。玘復率合鄕里義眾，與逸等俱進，討璯，斬之，傳首於建康。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":28,"last_line":28,"raw_start":2337,"raw_end":2537,"raw_character_offsets":[2339,2340,2341,2342,2343,2344,2345,2346,2347,2348,2349,2350,2351,2352,2353,2354,2355,2356,2357,2358,2359,2360,2361,2362,2363,2364,2365,2366,2367,2368,2369,2370,2371,2372,2373,2374,2375,2376,2377,2378,2379,2380,2381,2382,2383,2384,2385,2386,2387,2388,2389,2390,2391,2392,2393,2394,2395,2396,2397,2398,2399,2400,2401,2402,2403,2404,2405,2406,2407,2408,2409,2410,2411,2412,2413,2414,2415,2416,2417,2418,2419,2420,2421,2422,2423,2424,2425,2426,2427,2428,2429,2430,2431,2432,2433,2434,2435,2436,2437,2438,2439,2440,2441,2442,2443,2444,2445,2446,2447,2448,2449,245