p002614","status":"contextual_provisional","paragraph_id":"c-shiji-044-wei:p067","chapter_id":"c-shiji-044-wei"}],"relations":[{"id":"a-shiji044-018","subject_person_id":"cbr-p002618","predicate":"father","object_person_id":"cbr-p002614","status":"source_attested","evidence":[{"chapter_id":"c-shiji-044-wei","source_id":"s-shiji-044-wei","paragraph_id":"c-shiji-044-wei:p067","quote":"景湣王元年，秦拔我廿城，以爲秦東郡。二年，秦拔我朝謌。衞徙野王。三年，秦拔我汲。五年，秦拔我垣、蒲陽、衍。十五年，景湣王卒，子王假立。"}],"qualifiers":{"source_term":"景湣王卒，子王假立","historicity":"historical_tradition"},"interpretation_note":"保存明示子與繼位語句，不單憑太子繼位推生父；魏王紀年與世系仍待版本及研究覆核。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji044-048","person_id":"cbr-p002614","title":"魏太子","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-044-wei","source_id":"s-shiji-044-wei","paragraph_id":"c-shiji-044-wei:p064","quote":"卅年，无忌歸魏，率五國兵攻秦，敗之河外，走蒙驁。魏太子增質於秦，秦怒，欲囚魏太子增。或爲增謂秦王曰：『公孫喜固謂魏相曰「請以魏疾撃秦，秦王怒，必囚增。魏王又怒，撃秦，秦必傷」。今王囚增，是喜之計中也。故不若貴增而合魏，以疑之於齊、韓。』秦乃止增。"}],"attestations":[{"id":"th-shiji044-048:a001","paragraph_id":"c-shiji-044-wei:p064","start":24,"end":27,"surface":"魏太子","person_mention_id":"c-shiji-044-wei:m064-0024","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予、文獻用稱及明示去號分開。罷兵或終身不見不推所有爵位終止；移除相位、出質與失兵各不同，未知端點不補曆日。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji044-115","person_id":"cbr-p002614","surfaces":["增","太子增","景湣王","魏太子增"],"scope":"same_chapter","chapter_ids":["c-shiji-044-wei"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-044-wei:p064","quote":"卅年，无忌歸魏，率五國兵攻秦，敗之河外，走蒙驁。魏太子增質於秦，秦怒，欲囚魏太子增。或爲增謂秦王曰：『公孫喜固謂魏相曰「請以魏疾撃秦，秦王怒，必囚增。魏王又怒，撃秦，秦必傷」。今王囚增，是喜之計中也。故不若貴增而合魏，以疑之於齊、韓。』秦乃止增。"},{"paragraph_id":"c-shiji-044-wei:p066","quote":"卅四年，安釐王卒，太子增立，是爲景湣王。信陵君无忌卒。"},{"paragraph_id":"c-shiji-044-wei:p067","quote":"景湣王元年，秦拔我廿城，以爲秦東郡。二年，秦拔我朝謌。衞徙野王。三年，秦拔我汲。五年，秦拔我垣、蒲陽、衍。十五年，景湣王卒，子王假立。"}],"rationale":"限本篇明示姓名、封號、繼位與連續對話。无忌／信陵君及增／景湣王按明示語句暫接；公子政不與秦王政按同名合併。太子自相、蘇代扮演梁王與秦王未名時段各保留，不補姓名；中旗馮琴讀法待底本核查。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-044-wei:p064","text":"卅年，无忌歸魏，率五國兵攻秦，敗之河外，走蒙驁。魏太子增質於秦，秦怒，欲囚魏太子增。或爲增謂秦王曰：『公孫喜固謂魏相曰「請以魏疾撃秦，秦王怒，必囚增。魏王又怒，撃秦，秦必傷」。今王囚增，是喜之計中也。故不若貴增而合魏，以疑之於齊、韓。』秦乃止增。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-044-wei:m064-0003","start":3,"end":5,"surface":"无忌","kind":"person","person_id":"cbr-p002609","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m064-0021","start":21,"end":23,"surface":"蒙驁","kind":"person","person_id":"cbr-p002613","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m064-0024","start":24,"end":28,"surface":"魏太子增","kind":"person","person_id":"cbr-p002614","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m064-0037","start":37,"end":41,"surface":"魏太子增","kind":"person","person_id":"cbr-p002614","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m064-0044","start":44,"end":45,"surface":"增","kind":"person","person_id":"cbr-p002614","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m064-0046","start":46,"end":48,"surface":"秦王","kind":"person","person_id":"cbr-p002616","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m064-0051","start":51,"end":54,"surface":"公孫喜","kind":"person","person_id":"cbr-p002615","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m064-0056","start":56,"end":58,"surface":"魏相","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱、假設人稱與未名者保留；游説中扮演梁王不當昭魚本人身份，安陵氏與阿衡不補熟知姓名。"},{"id":"c-shiji-044-wei:m064-0067","start":67,"end":69,"surface":"秦王","kind":"person","person_id":"cbr-p002616","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m064-0073","start":73,"end":74,"surface":"增","kind":"person","p