pretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"id":"nc-jin040-jiachong-084","person_id":"q8m_ncx_b8h","surname":"荀","ming":"熙","additional_names":[],"chapter_id":"c-jinshu-040-jiachong-family","paragraph_id":"c-jinshu-040-jiachong-family:p021","person_mention_id":"c-jinshu-040-jiachong-family:p021:m0185","quote":"歷位散騎常侍、後軍將軍。廣城君薨，去職。喪未終。起爲秘書監，掌國史。先是，朝廷議立晉書限斷，中書監荀勖謂宜以魏正始起年，著作郎王瓚欲引嘉平已下朝臣盡入晉史，於時依違未有所決。惠帝立，更使議之。謐上議，請從泰始爲斷。於是事下三府，司徒王戎、司空張華、領軍將軍王衍、侍中樂廣、黃門侍郎嵇紹、國子博士謝衡皆從謐議。騎都尉濟北侯荀畯、侍中荀籓、黃門侍郎華混以爲宜用正始開元。博士荀熙、刁協謂宜嘉平起年。謐重執奏戎、華之議，事遂施行。","status":"editorial_provisional","human_reviewed":false,"model":null,"note":"本源所見稱名；按中古姓氏用法分讀，保原字及逐名錨，不作全庫權威選字。","fixed_biography_name_binding":{"kind":"fixed_punctuated_biography_name","source_revision":2606035,"paragraph_sha256":"a43e5b83a1f91fd241e6f22a4864f12ef6b3d89fd6bf7429fdda3dffc1b4d632","mode":"full_name","name_mention_id":"c-jinshu-040-jiachong-family:p021:m0185","zi_mention_id":null,"alias_bindings":[],"title_prefix":null,"title_suffix":null},"work_id":"w-jinshu","book_id":"b-jinshu-040","source_id":"s-jinshu-040-ws2606035-jiachong-family"}],"mentions":[{"id":"c-jinshu-040-jiachong-family:p021:m0185","kind":"person","person_id":"q8m_ncx_b8h","surface":"荀熙","start":185,"end":187,"status":"contextual_provisional","resolution_note":"依本傳完整敘事與本段角色辨識；逐人理由另存身份閱讀記錄。","paragraph_id":"c-jinshu-040-jiachong-family:p021","chapter_id":"c-jinshu-040-jiachong-family"}],"relations":[],"title_holdings":[{"id":"th-jin040-jiachong-family-holding_174","person_id":"q8m_ncx_b8h","status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-040","source_id":"s-jinshu-040-ws2606035-jiachong-family","chapter_id":"c-jinshu-040-jiachong-family","paragraph_id":"c-jinshu-040-jiachong-family:p021","quote"