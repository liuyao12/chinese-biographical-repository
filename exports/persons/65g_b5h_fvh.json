":36,"surface":"田何","kind":"person","person_id":"aly_3ph_2la","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m019-0040","start":40,"end":42,"surface":"王同","kind":"person","person_id":"yuy_gbn_g7e","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m019-0042","start":42,"end":44,"surface":"子仲","kind":"person","person_id":"yuy_gbn_g7e","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m019-0045","start":45,"end":47,"surface":"子仲","kind":"person","person_id":"yuy_gbn_g7e","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m019-0051","start":51,"end":53,"surface":"楊何","kind":"person","person_id":"rpk_mne_stx","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m019-0054","start":54,"end":55,"surface":"何","kind":"person","person_id":"rpk_mne_stx","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m019-0072","start":72,"end":75,"surface":"即墨成","kind":"person","person_id":"ji8_x93_yhn","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m019-0085","start":85,"end":87,"surface":"孟但","kind":"person","person_id":"gyn_ff7_fsv","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m019-0098","start":98,"end":100,"surface":"周霸","kind":"person","person_id":"57o_eji_ods","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m019-0103","start":103,"end":105,"surface":"衡胡","kind":"person","person_id":"fze_new_7ft","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m019-0109","start":109,"end":112,"surface":"主父偃","kind":"person","person_id":"65g_b5h_fvh","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m019-0128","start":128,"end":130,"surface":"楊何","kind":"person","person_id":"rpk_mne_stx","status":"contextual_provisional"}],"chapter_id":"c-shiji-121-rulin","book_id":"b-shiji-121","work_id":"w-shiji","source_id":"s-shiji121-rulin"},{"id":"c-shiji-121-rulin:p020","text":"董仲舒，廣川人也。以治春秋，孝景時為博士。下帷講誦，弟子傳以久次相受業，或莫見其面，蓋三年董仲舒不觀於舍園，其精如此。進退容止，非禮不行，學士皆師尊之。今上即位，為江都相。以春秋災異之變推陰陽所以錯行，故求雨閉諸陽，縱諸陰，其止雨反是。行之一國，未嘗不得所欲。中廢為中大夫，居舍，著災異之記。是時遼東高廟災，主父偃疾之，取其書奏之天子。天子召諸生示其書，有刺譏。董仲舒弟子呂步舒不知其師書，以為下愚。於是下董仲舒吏，當死，詔赦之。於是董仲舒竟不敢復言災異。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m020-0000","start":0,"end":3,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0014","start":14,"end":16,"surface":"孝景","kind":"person","person_id":"8s8_8m3_upb","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0026","start":26,"end":28,"surface":"弟子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m020-0045","start":45,"end":48,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0069","start":69,"end":71,"surface":"學士","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m020-0076","start":76,"end":78,"surface":"今上","kind":"person","person_id":"o7s_89o_zka","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0154","start":154,"end":157,"surface":"主父偃","kind":"person","person_id":"65g_b5h_fvh","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0165","start":165,"end":167,"surface":"天子","kind":"person","person_id":"o7s_89o_zka","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0168","start":168,"end":170,"surface":"天子","kind":"person","person_id":"o7s_89o_zka","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0171","start":171,"end":173,"surface":"諸生","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m020-0181","start":181,"end":184,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0184","start":184,"end":186,"surface":"弟子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m020-0186","start":186,"end":189,"surface":"呂步舒","kind":"person