{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"25p_3tl_9xn","canonical_person_id":"25p_3tl_9xn","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["25p_3tl_9xn"],"persons":[{"id":"25p_3tl_9xn","label":"田順〔漢武牙將軍〕","status":"active","historicity":"historical_tradition","aliases":[{"surface":"田順","mention_ids":["c-jinshu-044-shijian:line117:m0164"]}],"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-044","chapter_id":"c-jinshu-044-shijian","source_id":"s-jinshu-044-shijian","paragraph_id":"c-jinshu-044-shijian:line117","mention_id":"c-jinshu-044-shijian:line117:m0164","quote":"田順"}],"identity_note":"武帝詔援引武牙將軍田順增虜獲自殺故事。","review":"ai_provisional"}],"source_mention_summary":[{"source_id":"s-jinshu-044-shijian","work_id":"w-jinshu","book_id":"b-jinshu-044","chapter_id":"c-jinshu-044-shijian","raw_mention_count":1,"mention_ids":["c-jinshu-044-shijian:line117:m0164"],"paragraph_ids":["c-jinshu-044-shijian:line117"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-044-shijian:line117:m0164","mention_ids":["c-jinshu-044-shijian:line117:m0164"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-044-shijian"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-w044-shijian-tian","person_id":"25p_3tl_9xn","event_type":"death","source_term":"以詐增虜獲自殺","date_expression":null,"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-044","chapter_id":"c-jinshu-044-shijian","source_id":"s-jinshu-044-shijian","paragraph_id":"c-jinshu-044-shijian:line117","quote":"石鑒，字林伯，樂陵厭次人也。出自寒素，雅志公亮。仕魏，曆尚書郎、侍御史、尚書左丞、御史中丞，多所糾正，朝廷憚之，出為并州刺史、假節、護匈奴中郎將。武帝受禪，封堂陽子。入為司隸校尉，轉尚書。時秦、涼為虜所敗，遣鑒都督隴右諸軍事，坐論功虛偽免官。後為鎮南將軍、豫州刺史，坐討吳賊虛張首級。詔曰：「昔雲中守魏尚以斬首不實受刑，武牙將軍田順以詐增虜獲自殺，誣罔敗法，古今所疾。鑒備大臣，吾所取信。往者西事，公欺朝廷，以敗為得，竟不推究。中間黜免未久，尋復授用，冀能補過，而乃與下同詐。所謂大臣，義得爾乎！有司奏是也，顧未忍耳。今遣歸田里，終身不得復用，勿削爵土也。」久之，拜光祿勳，復為司隸校尉，稍加特進，遷右光祿大夫、開府，領司徒。前代三公冊拜，皆設小會，所以崇宰輔之制也。自魏末已後，廢不復行。至鑒，有詔令會，遂以為常。太康末，拜司空，領太子太傅。","person_mention_id":"c-jinshu-044-shijian:line117:m0164"}],"interpretation_note":"依本來源登記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-jinshu-044-shijian:line117:m0164","start":164,"end":166,"surface":"田順","kind":"person","person_id":"25p_3tl_9xn","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-044-shijian:line117","chapter_id":"c-jinshu-044-shijian"}],"relations":[],"title_holdings":[{"id":"th-w044-shijian-22","person_id":"25p_3tl_9xn","title":"武牙將軍","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-044","chapter_id":"c-jinshu-044-shijian","source_id":"s-jinshu-044-shijian","paragraph_id":"c-jinshu-044-shijian:line117","quote":"石鑒，字林伯，樂陵厭次人也。出自寒素，雅志公亮。仕魏，曆尚書郎、侍御史、尚書左丞、御史中丞，多所糾正，朝廷憚之，出為并州刺史、假節、護匈奴中郎將。武帝受禪，封堂陽子。入為司隸校尉，轉尚書。時秦、涼為虜所敗，遣鑒都督隴右諸軍事，坐論功虛偽免官。後為鎮南將軍、豫州刺史，坐討吳賊虛張首級。詔曰：「昔雲中守魏尚以斬首不實受刑，武牙將軍田順以詐增虜獲自殺，誣罔敗法，古今所疾。鑒備大臣，吾所取信。往者西事，公欺朝廷，以敗為得，竟不推究。中間黜免未久，尋復授用，冀能補過，而乃與下同詐。所謂大臣，義得爾乎！有司奏是也，顧未忍耳。今遣歸田里，終身不得復用，勿削爵土也。」久之，拜光祿勳，復為司隸校尉，稍加特進，遷右光祿大夫、開府，領司徒。前代三公冊拜，皆設小會，所以崇宰輔之制也。自魏末已後，廢不復行。至鑒，有詔令會，遂以為常。太康末，拜司空，領太子太傅。","person_mention_id":"c-jinshu-044-shijian:line117:m0164"}],"attestations":[{"id":"th-w043-shijian-22:a","paragraph_id":"c-jinshu-044-shijian:line117","start":160,"end":164,"surface":"武牙將軍","person_mention_id":"c-jinshu-044-shijian:line117:m0164","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-044-shijian:line117","text":"石鑒，字林伯，樂陵厭次人也。出自寒素，雅志公亮。仕魏，曆尚書郎、侍御史、尚書左丞、御史中丞，多所糾正，朝廷憚之，出為并州刺史、假節、護匈奴中郎將。武帝受禪，封堂陽子。入為司隸校尉，轉尚書。時秦、涼為虜所敗，遣鑒都督隴右諸軍事，坐論功虛偽免官。後為鎮南將軍、豫州刺史，坐討吳賊虛張首級。詔曰：「昔雲中守魏尚以斬首不實受刑，武牙將軍田順以詐增虜獲自殺，誣罔敗法，古今所疾。鑒備大臣，吾所取信。往者西事，公欺朝廷，以敗為得，竟不推究。中間黜免未久，尋復授用，冀能補過，而乃與下同詐。所謂大臣，義得爾乎！有司奏是也，顧未忍耳。今遣歸田里，終身不得復用，勿削爵土也。」久之，拜光祿勳，復為司隸校尉，稍加特進，遷右光祿大夫、開府，領司徒。前代三公冊拜，皆設小會，所以崇宰輔之制也。自魏末已後，廢不復行。至鑒，有詔令會，遂以為常。太康末，拜司空，領太子太傅。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-044-shijian:line117:m0000","start":0,"end":2,"surface":"石鑒","kind":"person","person_id":"77n_qzq_xi3","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-shijian:line117:m0004","start":4,"end":6,"surface":"林伯","kind":"person","person_id":"77n_qzq_xi3","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-shijian:line117:m0073","start":73,"end":75,"surface":"武帝","kind":"person","person_id":"hgm_jvn_hle","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-shijian:line117:m0104","start":104,"end":105,"surface":"鑒","kind":"person","person_id":"77n_qzq_xi3","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044