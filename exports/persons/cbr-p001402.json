ntextual_provisional"}],"chapter_id":"c-shiji-036-chenqi","book_id":"b-shiji-036","work_id":"w-shiji","source_id":"s-shiji-036-chenqi"},{"id":"c-shiji-036-chenqi:p021","text":"招之殺悼太子也，太子之子名吳，出奔晉。晉平公問太史趙曰：「陳遂亡乎？」對曰：「陳，顓頊之族。陳氏得政於齊，乃卒亡。自幕至于瞽瞍，無違命。舜重之以明德。至於遂，世世守之。及胡公，周賜之姓，使祀虞帝。且盛德之後，必百世祀。虞之世未也，其在齊乎？」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-036-chenqi:m021-0000","start":0,"end":1,"surface":"招","kind":"person","person_id":"cbr-p001402","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m021-0003","start":3,"end":6,"surface":"悼太子","kind":"person","person_id":"cbr-p001497","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m021-0008","start":8,"end":10,"surface":"太子","kind":"person","person_id":"cbr-p001497","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m021-0013","start":13,"end":14,"surface":"吳","kind":"person","person_id":"cbr-p001499","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m021-0019","start":19,"end":22,"surface":"晉平公","kind":"person","person_id":"cbr-p000416","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m021-0023","start":23,"end":26,"surface":"太史趙","kind":"person","person_id":"cbr-p001500","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m021-0041","start":41,"end":43,"surface":"顓頊","kind":"person","person_id":"cbr-p000013","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m021-0046","start":46,"end":48,"surface":"陳氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、引語角色、國別、校勘或未定指代；不補未見人名、闕代或成員。"},{"id":"c-shiji-036-chenqi:m021-0058","start":58,"end":59,"surface":"幕","kind":"person","person_id":"cbr-p001501","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m021-0061","start":61,"end":63,"surface":"瞽瞍","kind":"person","person_id":"cbr-p001502","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m021-0068","start":68,"end":69,"surface":"舜","kind":"person","person_id":