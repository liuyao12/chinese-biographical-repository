r_id":"c-shiji-036-chenqi"},{"id":"c-shiji-036-chenqi:m020-0062","start":62,"end":63,"surface":"招","kind":"person","person_id":"cbr-p001402","status":"contextual_provisional","paragraph_id":"c-shiji-036-chenqi:p020","chapter_id":"c-shiji-036-chenqi"},{"id":"c-shiji-036-chenqi:m020-0080","start":80,"end":81,"surface":"招","kind":"person","person_id":"cbr-p001402","status":"contextual_provisional","paragraph_id":"c-shiji-036-chenqi:p020","chapter_id":"c-shiji-036-chenqi"},{"id":"c-shiji-036-chenqi:m020-0082","start":82,"end":83,"surface":"招","kind":"person","person_id":"cbr-p001402","status":"contextual_provisional","paragraph_id":"c-shiji-036-chenqi:p020","chapter_id":"c-shiji-036-chenqi"},{"id":"c-shiji-036-chenqi:m020-0096","start":96,"end":97,"surface":"招","kind":"person","person_id":"cbr-p001402","status":"contextual_provisional","paragraph_id":"c-shiji-036-chenqi:p020","chapter_id":"c-shiji-036-chenqi"},{"id":"c-shiji-036-chenqi:m021-0000","start":0,"end":1,"surface":"招","kind":"person","person_id":"cbr-p001402","status":"contextual_provisional","paragraph_id":"c-shiji-036-chenqi:p021","chapter_id":"c-shiji-036-chenqi"}],"relations":[{"id":"a-shiji036-037","subject_person_id":"cbr-p001402","predicate":"brother","object_person_id":"cbr-p001403","status":"source_attested","evidence":[{"chapter_id":"c-shiji-036-chenqi","source_id":"s-shiji-036-chenqi","paragraph_id":"c-shiji-036-chenqi:p020","quote":"三十四年，初，哀公娶鄭，長姬生悼太子師，少姬生偃。二嬖妾，長妾生留，少妾生勝。留有寵哀公，哀公屬之其弟司徒招。哀公病，三月，招殺悼太子，立留為太子。哀公怒，欲誅招，招發兵圍守哀公，哀公自經殺。招卒立留為陳君。四月，陳使使赴楚。楚靈王聞陳亂，乃殺陳使者，使公子棄疾發兵伐陳，陳君留奔鄭。九月，楚圍陳。十一月，滅陳。使棄疾為陳公。"}],"qualifiers":{"source_term":"其弟司徒招","historicity":"historical_tradition"},"interpretation_note":"保存本篇明示子、生、妻、兄弟及祖先原稱；不由繼位補父子，不把舜／禹之後改直接父親，不補世系闕代或同父同母。未核底本與現代研究，來源主張不表示已確證史實。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji035-059","person_id":"cbr-p001402","title":"司徒","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-035-guancai","source_id":"s-shiji-035-guancai","paragraph_id":"c-shiji-035-guancai:p015","quote":"九年，陳司徒招弒其君哀公。"}],"attestations":[{"id":"th-shiji035-059:a001","paragraph_id":"c-shiji-035-guancai:p015","start":26,"end":28,"surface":"司徒","person_mention_id":"c-shiji-035-guancai:m015-0025","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"陳司徒用稱，九年是記事日期而非初任。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji036-057","person_id":"cbr-p001402","title":"司徒","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-036-chenqi","source_id":"s-shiji-036-chenqi","paragraph_id":"c-shiji-036-chenqi:p020","quote":"留有寵哀公，哀公屬之其弟司徒招。"}],"attestations":[{"id":"th-shiji036-057:a001","paragraph_id":"c-shiji-036-chenqi:p020","start":51,"end":53,"surface":"司徒","person_mention_id":"c-shiji-036-chenqi:m020-0051","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"司徒招用稱，不把哀公付託留當司徒初任。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji035-061","person_id":"cbr-p001402","surfaces":["陳司徒招"],"scope":"same_chapter","chapter_ids":["c-shiji-035-guancai"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-035-guancai:p015","quote":"靈侯二年，楚公子圍弒其王郟敖而自立，為靈王。九年，陳司徒招弒其君哀公。楚使公子棄疾滅陳而有之。十二年，楚靈王以靈侯弒其父，誘蔡靈侯于申，伏甲飲之，醉而殺之，刑其士卒七十人。令公子棄疾圍蔡。十一月，滅蔡，使棄疾為蔡公。"}],"rationale":"依文王子同母十人、蔡曹君世系、蔡女船中事件、楚公子圍弒其王及城濮／伐曹的具體敘事暫定異稱。郟敖／夾敖按同一事件、釐／僖負羈按本卷論贊暫同指；不同國與同國不同世代的同名者分開。匿名者、校勘及跨篇同指仍待核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji036-050","person_id":"cbr-p001402","surfaces":["司徒招","招"],"scope":"cross_chapter","chapter_ids":["c-shiji-035-guancai","c-shiji-036-chenqi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-035-guancai:p015","quote":"靈侯二年，楚公子圍弒其王郟敖而自立，為靈王。九年，陳司徒招弒其君哀公。楚使公子棄疾滅陳而有之。十二年，楚靈王以靈侯弒其父，誘蔡靈侯于申，伏甲飲之，醉而殺之，刑其士卒七十人。令公子棄疾圍蔡。十一月，滅蔡，使棄疾為蔡公。"},{"paragraph_id":"c-shiji-036-chenqi:p020","quote":"三十四年，初，哀公娶鄭，長姬生悼太子師，少姬生偃。二嬖妾，長妾生留，少妾生勝。留有寵哀公，哀公屬之其弟司徒招。哀公病，三月，招殺悼太子，立留為太子。哀公怒，欲誅招，招發兵圍守哀公，哀公自經殺。招卒立留為陳君。四月，陳使使赴楚。楚靈王聞陳亂，乃殺陳使者，使公子棄疾發兵伐陳，陳君留奔鄭。九月，楚圍陳。十一月，滅陳。使棄疾為陳公。"},{"paragraph_id":"c-shiji-036-chenqi:p021","quote":"招之殺悼太子也，太子之子名吳，出奔晉。晉平公問太史趙曰：「陳遂亡乎？」對曰：「陳，顓頊之族。陳氏得政於齊，乃卒亡。自幕至于瞽瞍，無違命。舜重之以明德。至於遂，世世守之。及胡公，周賜之姓，使祀虞帝。且盛德之後，必百世祀。虞之世未也，其在齊乎？」"}],"rationale":"本篇楚公子棄疾滅陳前的陳哀公、司徒招之亂，與管蔡篇招弒哀公及棄疾滅陳事件暫續同指。自經殺與弒君表述並存，未指定優先。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-035-guancai:p015","text":"靈侯二年，楚公子圍弒其王郟敖而自立，為靈王。九年，陳司徒招弒其君哀公。楚使公子棄疾滅陳而有之。十二年，楚靈王以靈侯弒其父，誘蔡靈侯于申，伏甲飲之，醉而殺之，刑其士卒七十人。令公子棄疾圍蔡。十一月，滅蔡，使棄疾為蔡公。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-035-guancai:m015-0000","start":0,"end":2,"surface":"靈侯","kind":"person","person_id":"cbr-p001401","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m015-0005","start":5,"end":9,"surface":"楚公子圍","kind":"person","person_id":"cbr-p000417","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m015-0012","start":12,"end":14,"surface":"郟敖","kind":"person","person_id":"cbr-p001058","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m015-0019","start":19,"end":21,"surface":"靈王","kind":"person","person_id":"cbr-p000417","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m015-0025","start":25,"end":29,"surface":"陳司徒招","kind":"person","person_id":"cbr-p001402","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m015-0032","start":32,"end":34,"surface":"哀公","kind":"person","person_id":"cbr-p001403","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m015-0037","start":37,"end":41,"surface":"公子棄疾","kind":"person","person_id":"cbr-p000421","status":"contextual_provisional"},{"id":"c-shiji-035-guanc