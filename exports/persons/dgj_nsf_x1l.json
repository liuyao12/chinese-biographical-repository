{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"dgj_nsf_x1l","canonical_person_id":"dgj_nsf_x1l","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["dgj_nsf_x1l"],"persons":[{"id":"dgj_nsf_x1l","label":"庾珉","status":"active","historicity":"historical_tradition","aliases":[{"surface":"庾珉","mention_ids":["c-jinshu-070-bianhu:p009:m0246"]}],"evidence":[{"mention_id":"c-jinshu-070-bianhu:p009:m0246","paragraph_id":"c-jinshu-070-bianhu:p009","chapter_id":"c-jinshu-070-bianhu","quote":"庾珉"}],"review":"ai_provisional","identity_note":"庾珉，見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-jinshu-070-bianhu-ws2595540","work_id":"w-jinshu","book_id":"b-jinshu-070","chapter_id":"c-jinshu-070-bianhu","raw_mention_count":1,"mention_ids":["c-jinshu-070-bianhu:p009:m0246"],"paragraph_ids":["c-jinshu-070-bianhu:p009"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-070-bianhu:p009:m0246","mention_ids":["c-jinshu-070-bianhu:p009:m0246"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-070-bianhu-ws2595540"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-070-bianhu:p009:m0246","surface":"庾珉","start":246,"end":248,"person_id":"dgj_nsf_x1l","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-070-bianhu:p009","chapter_id":"c-jinshu-070-bianhu"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-070-bianhu:p009","text":"明帝不豫，領尚書令，與王導等俱受顧命輔幼主。復拜右將軍，加給事中、尚書令。帝崩，成帝即位，群臣進璽，司徒王導以疾不至。壼正色於朝曰：「王公豈社稷之臣邪！大行在殯，嗣皇未立，寧是人臣辭疾之時！」導聞之，乃輿疾而至。皇太后臨朝，壼與庾亮對直省中，共參機要。時召南陽樂謨爲郡中正，潁川庾怡爲廷尉評。謨、怡各稱父命不就。壼奏曰：「人無非父而生，職無非事而立。有父必有命，居職必有悔。有家各私其子，此爲王者無人，職不軌物，官不立政。如此則先聖之言廢，五教之訓塞，君臣之道散，上下之化替矣。樂廣以平夷稱，庾珉以忠篤顯，受寵聖世，身非己有，況及後嗣而可專哉！所居之職若順夫群心，則戰戍者之父母皆當以命子，不以處也。若順謨父之意，則人皆不爲郡中正，人倫廢矣。順怡父之意，人皆不爲獄官，則刑辟息矣。凡如是者，其可聽歟？若不可聽，何以許謨、怡之得稱父命乎！此爲謨以名父子可以虧法，怡是親戚可以自專。以此二塗服人示世，臣所未悟也。宜一切班下，不得以私廢公。絕其表疏，以爲永制。」朝議以爲然。謨、怡不得已，各居所職。是時王導稱疾不朝，而私送車騎將軍郗鑒，壼奏以導虧法從私，無大臣之節。御史中丞鍾雅阿撓王典，不加準繩，並請免官。雖事寢不行，舉朝震肅。壼斷裁切直，不畏強禦，皆此類也。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":76,"last_line":76,"raw_start":7403,"raw_end":7947,"raw_character_offsets":[7410,7411,7412,7413,7414,7415,7416,7417,7418,7419,7420,7421,7422,7423,7424,7425,7426,7427,7428,7429,7430,7431,7432,7433,7434,7435,7436,7437,7438,7439,7440,7441,7442,7443,7444,7445,7446,7447,7448,7449,7450,7451,7452,7453,7454,7455,7456,7457,7458,7459,7460,7461,7462,7463,7464,7465,7466,7467,7468,7469,7470,7471,7472,7473,7474,7475,7476,7477,7478,7479,7480,7481,7482,7483,7484,7485,7486,7487,7488,7489,7490,7491,7492,7493,7494,7495,7496,7497,7498,7499,7500,7501,7502,7503,7504,7505,7506,7507,7508,7509,7510,7511,7512,7513,7514,7515,7516,7517,7518,7519,7520,7521,7522,7523,7524,7525,7526,7527,7528,7529,7530,7531,7532,7533,7534,7535,7536,7537,7538,7539,7540,7541,7542,7543,7544,7545,7546,7547,7548,7549,7550,7551,7552,7553,7554,7555,7556,7557,7558,7559,7560,7561,7562,7563,7564,7565,7