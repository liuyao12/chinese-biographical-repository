":"source-evidence/jin098-wangdun-comparison/projection.json","raw_file_sha256":"019eb1b16d5b12d4fac53fe1c94cb23ef4794434faa88ce8222576f948f4ca36","unit_key":"p005","source_layer":"received_chapter"},"mentions":[{"id":"c-jinshu-098-wangdun-comparison:p005:m0001","start":1,"end":3,"surface":"漢祖","person_id":"yqp_nlb_p1p_A","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p005:m0016","start":16,"end":18,"surface":"文帝","person_id":"yqp_nlb_p1p_AC","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p005:m0033","start":33,"end":34,"surface":"成","person_id":"qna_m75_pj8","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p005:m0034","start":34,"end":35,"surface":"康","person_id":"nek_dsn_nih","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p005:m0036","start":36,"end":38,"surface":"賈誼","person_id":"y6v_c03_at3","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p005:m0071","start":71,"end":74,"surface":"段匹磾","person_id":"7yp_ujo_thl","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p005:m0094","start":94,"end":96,"surface":"靳明","person_id":"oit_dz6_jxs","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p005:m0190","start":190,"end":192,"surface":"晉文","person_id":"6di_ywz_ju4_AAA","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p005:m0204","start":204,"end":206,"surface":"襄王","person_id":"gt1_z7d_s3u","kind":"person"},{"id":"c-jinshu-098-wangdun-comparison:p005:m0316","start":316,"end":318,"surface":"陛下","person_id":"dkn_ge4_286_AAAAAAA","kind":"person"}],"chapter_id":"c-jinshu-098-wangdun-comparison","book_id":"b-jinshu-098","work_id":"w-jinshu","source_id":"s-jinshu098-wangdun-ws2614273-comparison"}],"sources":[{"chapter_id":"c-jinshu-044-luqin-family-rendered","work_id":"w-jinshu","book_id":"b-jinshu-044","source_id":"s-jinshu044-lu-rendered-oldcapture","source":{"title":"《晉書》卷四十四盧欽傳","provider":"Wikisource","url":"https://zh.wikisource.org/wiki/晉書/卷044","permalink":"https://zh.wikisource.org/w/index.php?oldid=1775345&ti