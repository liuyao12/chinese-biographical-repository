_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-044-wei:m013-0027","start":27,"end":30,"surface":"田子方","kind":"person","person_id":"3lq_wm9_1ov","status":"contextual_provisional","paragraph_id":"c-shiji-044-wei:p013","chapter_id":"c-shiji-044-wei"},{"id":"c-shiji-044-wei:m013-0041","start":41,"end":44,"surface":"田子方","kind":"person","person_id":"3lq_wm9_1ov","status":"contextual_provisional","paragraph_id":"c-shiji-044-wei:p013","chapter_id":"c-shiji-044-wei"},{"id":"c-shiji-044-wei:m013-0071","start":71,"end":73,"surface":"子方","kind":"person","person_id":"3lq_wm9_1ov","status":"contextual_provisional","paragraph_id":"c-shiji-044-wei:p013","chapter_id":"c-shiji-044-wei"},{"id":"c-shiji-044-wei:m019-0461","start":461,"end":464,"surface":"田子方","kind":"person","person_id":"3lq_wm9_1ov","status":"contextual_provisional","paragraph_id":"c-shiji-044-wei:p019","chapter_id":"c-shiji-044-wei"},{"id":"c-shiji-121-rulin:m002-0069","start":69,"end":72,"surface":"田子方","kind":"person","person_id":"3lq_wm9_1ov","status":"contextual_provisional","paragraph_id":"c-shiji-121-rulin:p002","chapter_id":"c-shiji-121-rulin"}],"relations":[],"title_holdings":[{"id":"th-shiji044-010","person_id":"3lq_wm9_1ov","title":"師","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-044-wei","source_id":"s-shiji-044-wei","paragraph_id":"c-shiji-044-wei:p013","quote":"十七年，伐中山，使子撃守之，趙倉唐傅之。子撃逢文侯之師田子方於朝謌，引車避，下謁。田子方不爲禮。子撃因問曰：『富貴者驕人乎？且貧賤者驕人乎？』子方曰：『亦貧賤者驕人耳。夫諸侯而驕人則失其國，大夫而驕人則失其家。貧賤者，行不合，言不用，則去之楚、越，若脱屣然，柰何其同之哉！』子撃不懌而去。西攻秦，至鄭而還，筑雒陰、合陽。"}],"attestations":[{"id":"th-shiji044-010:a001","paragraph_id":"c-shiji-044-wei:p013","start":26,"end":27,"surface":"師","person_mention_id":"c-shiji-044-wei:m013-0027","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予、任事及死後用稱分存；右、御、國政、傅與守鄴保留原用語，制度種類待核。未知端點不由卒、出亡或首次用稱推造。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji044-034","person_id":"3lq_wm9_1ov","surfaces":["子方","田子方"],"scope":"same_chapter","chapter_ids":["c-shiji-044-wei"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-044-wei:p013","quote":"十七年，伐中山，使子撃守之，趙倉唐傅之。子撃逢文侯之師田子方於朝謌，引車避，下謁。田子方不爲禮。子撃因問曰：『富貴者驕人乎？且貧賤者驕人乎？』子方曰：『亦貧賤者驕人耳。夫諸侯而驕人則失其國，大夫而驕人則失其家。貧賤者，行不合，言不用，則去之楚、越，若脱屣然，柰何其同之哉！』子撃不懌而去。西攻秦，至鄭而還，筑雒陰、合陽。"},{"paragraph_id":"c-shiji-044-wei:p019","quote":"魏文侯謂李克曰：『先生嘗教寡人曰「家貧則思良妻，國亂則思良相」。今所置非成則璜，二子何如？』李克對曰：『臣聞之，卑不謀尊，疎不謀戚。臣在闕門之外，不敢當命。』文侯曰：『先生臨事勿讓。』李克曰：『君不察故也。居視其所親，富視其所與，達視其所舉，窮視其所不爲，貧視其所不取，五者足以定之矣，何待克哉！』文侯曰：『先生就舍，寡人之相定矣。』李克趨而出，過翟璜之家。翟璜曰：『今者聞君召先生而卜相，果誰爲之？』李克曰：『魏成子爲相矣。』翟璜忿然作色曰：『以耳目之所睹記，臣何負於魏成子？西河之守，臣之所進也。君内以鄴爲憂，臣進西門豹。君謀欲伐中山，臣進樂羊。中山以拔，无使守之，臣進先生。君之子无傅，臣進屈侯鮒。臣何以負於魏成子！』李克曰：『且子之言克於子之君者，豈將比周以求大官哉？君問而置相「非成則璜，二子何如」？克對曰：「君不察故也。居視其所親，富視其所與，達視其所舉，窮視其所不爲，貧視其所不取，五者足以定之矣，何待克哉！」是以知魏成子之爲相也。且子安得與魏成子比乎？魏成子以食祿千鐘，什九在外，什一在内，是以東得卜子夏、田子方、段干木。此三人者，君皆師之。子之所進五人者，君皆臣之。子惡得與魏成子比也？』翟璜逡巡再拜曰：『璜，鄙人也，失對，願卒爲弟子。』"}],"rationale":"限本篇明示姓名、諡稱與連續事件暫接；同名不跨篇自動合併，苗裔、祖孫與父子分開，原字及版本疑讀尚待底本覆核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji121-scholars-07","person_id":"3lq_wm9_1ov","surfaces":["田子方"],"scope":"cross_chapter","chapter_ids":["c-shiji-121-rulin","c-shiji-044-wei"],"status":"contextual_provisional","confidence_level":"high","identification_basis":{"kind":"source_context","target_mention_ids":["c-shiji-121-rulin:m002-0069"]},"evidence":[{"work_id":"w-shiji","book_id":"b-shiji-121","chapter_id":"c-shiji-121-rulin","source_id":"s-shiji121-rulin","paragraph_id":"c-shiji-121-rulin:p002","quote":"自孔子卒後，七十子之徒散游諸侯，大者為師傅卿相，小者友教士大夫，或隱而不見。故子路居衛，子張居陳，澹臺子羽居楚，子夏居西河，子貢終於齊。如田子方、段干木、吳起、禽滑釐之屬，皆受業於子夏之倫，為王者師。是時獨魏文侯好學。后陵遲以至于始皇，天下并爭於戰國，懦術既絀焉，然齊魯之閒，學者獨不廢也。於威、宣之際，孟子、荀卿之列，咸遵夫子之業而潤色之，以學顯於當世。"},{"work_id":"w-shiji","book_id":"b-shiji-044","chapter_id":"c-shiji-044-wei","source_id":"s-shiji-044-wei","paragraph_id":"c-shiji-044-wei:p013","quote":"十七年，伐中山，使子撃守之，趙倉唐傅之。子撃逢文侯之師田子方於朝謌，引車避，下謁。田子方不爲禮。子撃因問曰：『富貴者驕人乎？且貧賤者驕人乎？』子方曰：『亦貧賤者驕人耳。夫諸侯而驕人則失其國，大夫而驕人則失其家。貧賤者，行不合，言不用，則去之楚、越，若脱屣然，柰何其同之哉！』子撃不懌而去。西攻秦，至鄭而還，筑雒陰、合陽。"}],"rationale":"魏文侯學術脈絡中的田子方，對讀文侯之師田子方；不因師稱補父子。","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-044-wei:p013","text":"十七年，伐中山，使子撃守之，趙倉唐傅之。子撃逢文侯之師田子方於朝謌，引車避，下謁。田子方不爲禮。子撃因問曰：『富貴者驕人乎？且貧賤者驕人乎？』子方曰：『亦貧賤者驕人耳。夫諸侯而驕人則失其國，大夫而驕人則失其家。貧賤者，行不合，言不用，則去之楚、越，若脱屣然，柰何其同之哉！』子撃不懌而去。西攻秦，至鄭而還，筑雒陰、合陽。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-044-wei:m013-0009","start":9,"end":11,"surface":"子撃","kind":"person","person_id":"eva_gs1_9n5_A","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m013-0014","start":14,"end":17,"surface":"趙倉唐","kind":"person","person_id":"f2n_1g8_h3m","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m013-0020","start":20,"end":22,"surface":"子撃","kind":"person","person_id":"eva_gs1_9n5_A","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m013-0023","start":23,"end":25,"surface":"文侯","kind":"person","person_id":"nxl_qt6_cpl_AAAAAA*A*A","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m013-0027","start":27,"end":30,"surface":"田子方","kind":"person","person_id":"3lq_wm9_1ov","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m013-0041","start":41,"end":44,"surface":"田子方","kind":"person","person_id":"3lq_wm9_1ov","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m013-0048","start":48,"end":50,"surface":"子撃","kind":"person","person_id":"eva_gs1_9n5_A","