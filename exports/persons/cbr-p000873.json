{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000873","identity_policy":"contextual_provisional","person_ids":["cbr-p000873"],"persons":[{"id":"cbr-p000873","label":"賈壽","status":"active","historicity":"historical_tradition","aliases":[{"surface":"賈壽","mention_ids":["c-shiji-009-lvhou:m027-0027"]}],"evidence":[{"mention_id":"c-shiji-009-lvhou:m027-0027","chapter_id":"c-shiji-009-lvhou","paragraph_id":"c-shiji-009-lvhou:p027","quote":"賈壽"}]}],"source_mention_summary":[{"source_id":"s-shiji-009-lvhou","work_id":"w-shiji","book_id":"b-shiji-009","chapter_id":"c-shiji-009-lvhou","mention_count":1,"mention_ids":["c-shiji-009-lvhou:m027-0027"],"paragraph_ids":["c-shiji-009-lvhou:p027"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-009-lvhou"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-009-lvhou:m027-0027","start":27,"end":29,"surface":"賈壽","kind":"person","person_id":"cbr-p000873","status":"contextual_provisional","paragraph_id":"c-shiji-009-lvhou:p027","chapter_id":"c-shiji-009-lvhou"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-009-lvhou:p027","text":"八月庚申旦，平陽侯窋行御史大夫事，見相國產計事。郎中令賈壽使從齊來，因數產曰：「王不蚤之國，今雖欲行，尚可得邪？」具以灌嬰與齊楚合從，欲誅諸呂告產，乃趣產急入宮。平陽侯頗聞其語，乃馳告丞相、太尉。太尉欲入北軍，不得入。襄平侯通尚符節。乃令持節矯內太尉北軍。太尉復令酈寄與典客劉揭先說呂祿曰：「帝使太尉守北軍，欲足下之國，急歸將印辭去，不然，禍且起。」呂祿以為酈兄不欺己，遂解印屬典客，而以兵授太尉。太尉將之入軍門，行令軍中曰：「為呂氏右袒，為劉氏左袒。」軍中皆左袒為劉氏。太尉行至，將軍呂祿亦已解上將印去，太尉遂將北軍。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-009-lvhou:m027-0006","start":6,"end":10,"surface":"平陽侯窋","kind":"person","person_id":"cbr-p000872","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m027-0018","start":18,"end":21,"surface":"