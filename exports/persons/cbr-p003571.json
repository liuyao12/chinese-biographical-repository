]}],"evidence":[{"mention_id":"c-shiji-058-liang:m017-0201","chapter_id":"c-shiji-058-liang","paragraph_id":"c-shiji-058-liang:p017","quote":"無傷"}],"family_path":{"connection":"father","generation_distance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-058-liang","source_id":"s-shiji-058-liang","paragraph_id":"c-shiji-058-liang:p017","quote":"元朔中，睢陽人類犴反者，人有辱其父，而與淮陽太守客出同車。太守客出下車，類犴反殺其仇於車上而去。淮陽太守怒，以讓梁二千石。二千石以下求反甚急，執反親戚。反知國陰事，乃上變事，具告知王與大母爭樽狀。時丞相以下見知之，欲以傷梁長吏，其書聞天子。天子下吏驗問，有之。公卿請廢襄為庶人。天子曰：「李太后有淫行，而梁王襄無良師傅，故陷不義。」乃削梁八城，梟任王后首于市。梁餘尚有十城。襄立三十九年卒，謚為平王。子無傷立為梁王也。","source_term":"子無傷立"}],"source_assertion_id":"a-shiji058-019","interpretation_note":"以此受傳正文的明示近親主張配置局部家族；不合併跨篇候選身份、不補闕名世代，不表示遠祖世系已核實。分支字元不是長幼排行。","reviewer":"Codex（AI 代理）","parent_person_id":"82d_8vl_8i1_AAA"},"id_aliases":["cbr-p003571"]}],"source_mention_summary":[{"source_id":"s-shiji-058-liang","work_id":"w-shiji","book_id":"b-shiji-058","chapter_id":"c-shiji-058-liang","mention_count":1,"mention_ids":["c-shiji-058-liang:m017-0201"],"paragraph_ids":["c-shiji-058-liang:p017"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-058-liang"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji058-019","subject_person_id":"82d_8vl_8i1_AAAA","predicate":"father","object_person_id":"82d_8vl_8i1_AAA","status":"source_attested","evidence":[{"chapter_id":"c-shiji-058-liang","source_id":"s-shiji-058-liang","paragraph_id":"c-shiji-058-liang:p017","quote":"元朔中，睢陽人類犴反者，人有辱其父，而與淮陽太守客出同車。太守客出下車，類犴反殺其仇於車上而去。淮陽太守怒，以讓梁二千石。二千石以下求反甚急，執反親戚。反知國陰事，乃上變事，具告知王與大母爭樽狀。時丞相以下見知之，欲以傷梁長吏，其書聞天子。天子下吏驗問，有之。公卿請廢襄為庶人。天子曰：「李太后有淫行，而梁王襄無良師傅，故陷不義。」乃削梁八城，梟任王后首于市。梁餘尚有十城。襄立三十九年卒，謚為平王。子無傷立為梁王也。"}],"qualifiers":{"source_term":"子無傷立","historicity":"historical_tradition"},"interpretatio