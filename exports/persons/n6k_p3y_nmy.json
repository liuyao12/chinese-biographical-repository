rpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhangzhao-complete:line022:m0002","start":2,"end":5,"surface":"公孫淵","kind":"person","person_id":"z0r_ri5_noq","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhangzhao-complete:line022:m0009","start":9,"end":11,"surface":"張彌","kind":"person","person_id":"n6k_p3y_nmy","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhangzhao-complete:line022:m0012","start":12,"end":14,"surface":"許晏","kind":"person","person_id":"6z7_c02_5vd","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhangzhao-complete:line022:m0018","start":18,"end":19,"surface":"淵","kind":"person","person_id":"z0r_ri5_noq","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhangzhao-complete:line022:m0023","start":23,"end":24,"surface":"昭","kind":"person","person_id":"roi_rz4_ute","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhangzhao-complete:line022:m0028","start":28,"end":29,"surface":"淵","kind":"person","person_id":"z0r_ri5_noq","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhangzhao-complete:line022:m0045","start":45,"end":46,"surface":"淵","kind":"person","person_id":"z0r_ri5_noq","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhangzhao-complete:line022:m0070","start":70,"end":71,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhangzhao-complete:line022:m0076","start":76,"end":77,"surface":"昭","kind":"person","person_id":"roi_rz4_ute","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhangzhao-complete:line022:m0081","start":81,"end":82,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisi