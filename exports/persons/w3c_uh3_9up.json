","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null}],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-006-jianwu1-nov:p001","unit_id":"jianwu1-nov:u001","text":"十一月癸酉以西中郎長史始安王遥光為揚州刺史晉夀太守王洪範為青冀二州刺史尚書令王晏領太子少傅甲戌大司馬尋陽公王敬則等十三人進爵邑各有差詔省新林苑先是民地悉以還主原責本直庚辰立皇子寳義為晉安王寳𤣥為江夏王寳源為廬陵王寳寅為建安王寳融為随郡王寳攸為南平王甲申詔曰邑宰禄薄俸微不足代耕雖任土恒貢亦為勞費自今悉斷又詔宣城國五品以上悉與滿叙自此以下皆聽解遣其欲仕適所樂乙酉追尊始安貞王為景皇妃為懿后丙戌以輔國将軍聞喜公遥欣為荆州刺史寧朔将軍豐城公遥昌為豫州刺史丁亥詔細作中署材官車府凡諸工可悉開番假逓令休息戊子立皇太子寳卷賜天下為父後者爵一級孝子順孫義夫節婦普加甄賜眀揚表其衡閭賚以束帛己丑詔東宫肇建逺近或有慶禮可悉斷之壬辰以新除征虜将軍江夏王寳𤣥為郢州刺史永眀中御史中丞沈淵表百官年登七十皆令致仕竝窮困私門庚子詔曰日者百司耆齒許以自陳東西二省猶沾微俸辭事私庭榮禄兼謝興言愛老實有矜懐自縉紳年及可一遵永眀七年以前銓叙之科上輔政所誅諸王是月復屬籍各封子為侯","text_layer":"received_chapter","annotation_status":"in_progress","source_position":{"unit_key":"jianwu1-nov:u001","first_line":65,"last_line":87,"revision_id":"787dd9a7da495542e8f17c26c96900ce37b2c211","source_layer":"received_chapter","raw_projection_ref":"source-evidence/nanqi006-jianwu1-nov/projection.json","editorial_excerpt_boundary":true},"mentions":[{"id":"c-nanqishu-006-jianwu1-nov:p001:m0014","start":14,"end":16,"surface":"遥光","kind":"person","person_id":"nnf_opw_w90","status":"contextual_provisional"},{"id":"c-nanqishu-006-jianwu1-nov:p001:m0025","start":25,"end":28,"surface":"王洪範","kind":"person","person_id":"x5x_efh_1m8","status":"contextual_provisional"},{"id":"c-nanqishu-006-jianwu1-nov:p001:m0038","start":38,"end":40,"surface":"王晏","kind":"person","person_id":"i08_s4b_5bb","status":"contextual_provisional"},{"id":"c-nanqishu-006-jianwu1-nov:p001:m0053","start":53,"end":56,"surface":"王敬則","kind":"person","person_id":"w3c_uh3_9up","status":"contextual_provisional"},{"id":"c-nanqishu-006-jianwu1-nov:p001:m0088","start":88,"end":90,"surface":"寳義","kind":"person","person_id":"w4m_9tw_147_A","status":"contextual_provisional"},{"id":"c-nanqishu-006-jianwu1-nov:p001:m0094","start":94,"end":96,"surface":"寳𤣥","kind":"person","person_id":"w4m_9tw_147_B","status":"contextual_provisional"},{"id":"c-nanqishu-006-jianwu1-nov:p001:m0100","start":100,"end":102,"surface":"寳源"