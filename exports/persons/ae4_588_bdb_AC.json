,"ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-w044-zhengmao-sons-詡","subject_person_id":"ae4_588_bdb_AC","object_person_id":"ae4_588_bdb_A","predicate":"father","qualifiers":{"source_term":"有子六人，長子默嗣，次質、舒、詡、稱、予"},"context":{"kind":"adjacent_paragraphs","paragraph_ids":["c-jinshu-044-zhengmao:line017","c-jinshu-044-zhengmao:line019"]},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-044","chapter_id":"c-jinshu-044-zhengmao","source_id":"s-jinshu-044-zhengmao","paragraph_id":"c-jinshu-044-zhengmao:line017","quote":"武帝踐阼，進爵為侯。雖寢疾十餘年，而時賢並相推薦。泰始中，詔曰：「光祿密陵侯袤，履行純正，守道沖粹，退有清和之風，進有素絲之節，宜登三階之曜，補袞職之闕。今以袤為司空。」天子臨軒，遣五官中郎將國坦就第拜授。袤前後辭讓，遣息稱上送印綬，至於十數。謂坦曰：「魏以徐景山為司空，吾時為侍中，受詔譬旨。徐公語吾曰：'三公當上應天心，苟非其人，實傷和氣，不敢以垂死之年，累辱朝廷也。'終於不就。遵大雅君子之跡，可不務乎！」固辭，久之見許，以侯就第，拜儀同三司，置舍人官騎，賜床帳簟褥、錢五十萬。","object_person_mention_id":"c-jinshu-044-zhengmao:line017:m0038"},{"work_id":"w-jinshu","book_id":"b-jinshu-044","chapter_id":"c-jinshu-044-zhengmao","source_id":"s-jinshu-044-zhengmao","paragraph_id":"c-jinshu-044-zhengmao:line019","quote":"九年薨，時年八十五。帝於東堂發哀，賜秘器、朝服一具、衣一襲、錢三十萬、絹布各百匹，以供喪事。諡曰元。有子六人，長子默嗣，次質、舒、詡、稱、予，位並列卿。","subject_person_mention_id":"c-jinshu-044-zhengmao:line019:m0065"}],"interpretation_note":"承鄭袤本傳卒後六子原句；默明稱長子，其餘只存列名。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[{"connection":"father","generation_distance":1,"parent_person_id":"ae4_588_bdb_A","status":"contextual_provisional","human_reviewed":false,"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-044","chapter_id":"c-jinshu-044-zhengmao","source_id":"s-jinshu-044-zhengmao","paragraph_id":"c-jinshu-044-zhengmao:line019","quote":"九年薨，時年八十五。帝於東堂發哀，賜秘器、朝服一具、衣一襲、錢三十萬、絹布各百匹，以供喪事。諡曰元。有子六人，長子默嗣，次質、舒、詡、稱、予，位並列卿