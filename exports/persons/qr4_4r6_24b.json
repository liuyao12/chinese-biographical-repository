弟前始安內史欣時密謀結太子右率胡松、前南譙太守王靈秀、直閤將軍鴻選、含德主帥苟勵、直後劉靈運等十餘人，竝同契會。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":101,"last_line":101,"raw_start":7853,"raw_end":8020,"raw_character_offsets":[7853,7854,7855,7856,7857,7858,7859,7860,7861,7862,7863,7864,7865,7866,7867,7868,7869,7870,7871,7872,7873,7874,7875,7876,7877,7878,7879,7880,7881,7882,7883,7884,7885,7886,7887,7888,7889,7890,7891,7892,7893,7894,7895,7896,7897,7898,7899,7900,7901,7902,7903,7904,7905,7906,7907,7908,7909,7910,7911,7912,7913,7914,7915,7916,7917,7918,7919,7920,7921,7922,7923,7924,7925,7926,7927,7928,7929,7930,7931,7932,7933,7934,7935,7936,7937,7938,7939,7940,7941,7942,7943,7944,7945,7946,7947,7948,7949,7950,7951,7952,7953,7954,7955,7956,7957,7958,7959,7960,7961,7962,7963,7964,7965,7966,7967,7968,7969,7970,7971,7972,7973,7974,7975,7976,7977,7978,7979,7980,7981,7982,7983,7984,7985,7986,7987,7988,7989,7990,7991,7992,7993,7994,7995,7996,7997,7998,7999,8000,8001,8002,8003,8004,8005,8006,8007,8008,8009,8010,8011,8012,8013,8014,8015,8016,8017,8018,8019],"revision_id":1504716},"mentions":[{"id":"c-nanqishu-051-pei-cui-zhang-complete:p044:m0019","start":19,"end":22,"surface":"崔慧景","kind":"person","person_id":"tvq_7my_nqh","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p044:m0025","start":25,"end":27,"surface":"欣泰","kind":"person","person_id":"sv8_7js_9wz","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p044:m0045","start":45,"end":48,"surface":"廬陵王","kind":"person","person_id":"w4m_9tw_147_E","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p044:m0058","start":58,"end":60,"surface":"欣泰","kind":"person","person_id":"sv8_7js_9wz","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p044:m0096","start":96,"end":98,"surface":"少帝","kind":"person","person_id":"w4m_9tw_147_A","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p044:m0108","start":108,"end":110,"surface":"欣泰","kind":"person","person_id":"sv8_7js_9wz","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p044:m0117","start":117,"end":119,"surface":"欣時","kind":"person","person_id":"orv_pqg_sww","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p044:m0126","start":126,"end":128,"surface":"胡松","kind":"person","person_id":"qr4_4r6_24b","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p044:m0134","start":134,"end":137,"surface":"王靈秀","kind":"person","person_id":"zkn_eny_te7","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-051-pei-cui-zhang-complete","book_id":"b-nanqishu-051","work_id":"w-nanqishu","source_id":"s-nanqishu-051-pei-cui-zhang-complete-ws1504716"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p045","text":"　　帝遣中書舍人馮元嗣監軍救郢，茹法珍、梅蟲兒及太子右率李居士、制局監楊明泰等十餘人相送中興堂。欣泰等使人懷刀於座斫元嗣，頭墜果柈中，又斫明泰，破其腹，蟲兒傷刺數瘡，手指皆墮。居士踰牆得出，茹法珍亦散走還臺。靈秀仍往石頭迎建安王寶夤，率文武數百，唱警蹕，至杜姥宅。欣泰初聞事發，馳馬入宮，冀法珍等在外，城內處分，必盡見委，表裏相應，因行廢立。旣而法珍得反，處分閉門上仗，不配欣泰兵，鴻選在殿內亦不敢發。城外衆尋散。少日事覺，詔收欣泰、胡松等，皆伏誅。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":103,"last_line":103,"raw_start":8022,"raw_end":8247,"raw_character_offsets":[8022,8023,8024,8025,8026,8027,8028,8029,8030,8031,8032,8033,8034,8035,8036,8037,8038,8039,8040,8041,8042,8043,8044,8045,8046,8047,8048,8049,8050,8051,8052,8053,8054,8055,8056,8057,8058,8059,8060,8061,8062,8063,8064,8065,8066,8067,8068,8069,8070,8071,8072,8073,8074,8075,8076,8077,8078,8079,8080,8081,8082,8083,8084,8085,8086,8087,8088,8089,8090,8091,8092,8093,8094,8095,8096,8097,8098,8099,8100,8101,8102,8103,8104,8105,8106,8107,8108,8109,8110,8111,8112,8113,8114,8115,8116,8117,8118,8119,8120,8121,8122,8123,8124,8125,8126,8127,8128,8129,8130,8131,8132,8133,8134,8135,8136,8137,8138,8139,8140,8141,8142,8143,8144,8145,8146,8147,8148,8149,8150,8151,8152,8153,8154,8155,8156,8157,8158,8159,8160,8161,8162,8163,8164,8165,8166,8167,8168,816