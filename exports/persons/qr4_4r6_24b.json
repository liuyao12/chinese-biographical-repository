hou"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p020:m0039","start":39,"end":41,"surface":"胡松","kind":"person","person_id":"qr4_4r6_24b","status":"contextual_provisional","paragraph_id":"c-nanqishu-051-pei-cui-zhang-complete:p020","chapter_id":"c-nanqishu-051-pei-cui-zhang-complete"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p044:m0126","start":126,"end":128,"surface":"胡松","kind":"person","person_id":"qr4_4r6_24b","status":"contextual_provisional","paragraph_id":"c-nanqishu-051-pei-cui-zhang-complete:p044","chapter_id":"c-nanqishu-051-pei-cui-zhang-complete"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p045:m0217","start":217,"end":219,"surface":"胡松","kind":"person","person_id":"qr4_4r6_24b","status":"contextual_provisional","paragraph_id":"c-nanqishu-051-pei-cui-zhang-complete:p045","chapter_id":"c-nanqishu-051-pei-cui-zhang-complete"}],"relations":[],"title_holdings":[{"id":"th-nanqi040-zhaozhou-m3-65","person_id":"qr4_4r6_24b","title":"臺軍主","kind":"office","mode":"attestation","attestations":[{"id":"th-nanqi040-zhaozhou-m3-65:a","person_mention_id":"c-nanqishu-040-zhaozhou:p003:m0068","usage":"narrative","date_expression":null,"paragraph_id":"c-nanqishu-040-zhaozhou:p003","surface":"臺軍主","start":65,"end":68}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-040","source_id":"s-nanqishu-040-zhaozhou-ws2272748","chapter_id":"c-nanqishu-040-zhaozhou","paragraph_id":"c-nanqishu-040-zhaozhou:p003","quote":"及陳顯達起事，王侯復入宮。昭冑懲往時之懼，與弟永新侯昭穎逃奔江西，變形爲道人。崔慧景舉兵，昭冑兄弟出投之。慧景事敗，昭冑兄弟首出投臺軍主胡松，各以王侯還第。不自安，謀爲身計。子良故防閤桑偃爲梅蟲兒軍副，結前巴西太守蕭寅，謀立昭冑。昭冑許事克用寅爲尚書左僕射、護軍將軍。以寅有部曲，大事皆委之。時胡松領軍在新亭，寅遣人說之，云「須昏人出，寅等便率兵奉昭冑入臺，閉城號令。昏人必還就將軍，將軍但閉壘不應，則三公不足得也。」松又許諾。會東昏新起芳樂苑，月許日不復出遊，偃等議募健兒百餘人從萬春門入突取之，昭冑以爲不可。偃同黨王山沙慮事久無成，以事告御刀徐僧重。寅遣人殺山沙於路，吏於麝中得其事迹，昭冑兄弟與同黨皆伏誅。昭穎官至寧朔將軍、彭城太守。梁王定京邑，追贈昭冑散騎常侍、撫軍將軍，昭穎黃門郎。梁受禪，降封昭冑子周監利侯。","person_mention_id":"c-nanqishu-040-zhaozhou:p003:m0068"}],"status":"source_attested","interpretation_note":"按本見證原職名及其所屬人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"person_references":[{"id":"c-nanqishu-040-zhaozhou:p003:r0189","surface":"將軍","start":189,"end":191,"person_id":"qr4_4r6_24b","referent_role":"third_person","paragraph_id":"c-nanqishu-040-zhaozhou:p003","quote":"及陳顯達起事，王侯復入宮。昭冑懲往時之懼，與弟永新侯昭穎逃奔江西，變形爲道人。崔慧景舉兵，昭冑兄弟出投之。慧景事敗，昭冑兄弟首出投臺軍主胡松，各以王侯還第。不自安，謀爲身計。子良故防閤桑偃爲梅蟲兒軍副，結前巴西太守蕭寅，謀立昭冑。昭冑許事克用寅爲尚書左僕射、護軍將軍。以寅有部曲，大事皆委之。時胡松領軍在新亭，寅遣人說之，云「須昏人出，寅等便率兵奉昭冑入臺，閉城號令。昏人必還就將軍，將軍但閉壘不應，則三公不足得也。」松又許諾。會東昏新起芳樂苑，月許日不復出遊，偃等議募健兒百餘人從萬春門入突取之，昭冑以爲不可。偃同黨王山沙慮事久無成，以事告御刀徐僧重。寅遣人殺山沙於路，吏於麝中得其事迹，昭冑兄弟與同黨皆伏誅。昭穎官至寧朔將軍、彭城太守。梁王定京邑，追贈昭冑散騎常侍、撫軍將軍，昭穎黃門郎。梁受禪，降封昭冑子周監利侯。","note":"依同段姓名、引者及所答者。","chapter_id":"c-nanqishu-040-zhaozhou","book_id":"b-nanqishu-040","work_id":"w-nanqishu","source_id":"s-nanqishu-040-zhaozhou-ws2272748"},{"id":"c-nanqishu-040-zhaozhou:p003:r0192","surface":"將軍","start":192,"end":194,"person_id":"qr4_4r6_24b","referent_role":"addressee","paragraph_id":"c-nanqishu-040-zhaozhou:p003","quote":"及陳顯達起事，王侯復入宮。昭冑懲往時之懼，與弟永新侯昭穎逃奔江西，變形爲道人。崔慧景舉兵，昭冑兄弟出投之。慧景事敗，昭冑兄弟首出投臺軍主胡松，各以王侯還第。不自安，謀爲身計。子良故防閤桑偃爲梅蟲兒軍副，結前巴西太守蕭寅，謀立昭冑。昭冑許事克用寅爲尚書左僕射、護軍將軍。以寅有部曲，大事皆委之。時胡松領軍在新亭，寅遣人說之，云「須昏人出，寅等便率兵奉昭冑入臺，閉城號令。昏人必還就將軍，將軍但閉壘不應，則三公不足得也。」松又許諾。會東昏新起芳樂苑，月許日不復出遊，偃等議募健兒百餘人從萬春門入突取之，昭冑以爲不可。偃同黨王山沙慮事久無成，以事告御刀徐僧重。寅遣人殺山沙於路，吏於麝中得其事迹，昭冑兄弟與同黨皆伏誅。昭穎官至寧朔將軍、彭城太守。梁王定京邑，追贈昭冑散騎常侍、撫軍將軍，昭穎黃門郎。梁受禪，降封昭冑子周監利侯。","note":"依同段姓名、引者及所答者。","chapter_id":"c-nanqishu-040-zhaozhou","book_id":"b-nanqishu-040","work_id":"w-nanqishu","source_id":"s-nanqishu-040-zhaozhou-ws2272748"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-040-zhaozhou:p003","text":"及陳顯達起事，王侯復入宮。昭冑懲往時之懼，與弟永新侯昭穎逃奔江西，變形爲道人。崔慧景舉兵，昭冑兄弟出投之。慧景事敗，昭冑兄弟首出投臺軍主胡松，各以王侯還第。不自安，謀爲身計。子良故防閤桑偃爲梅蟲兒軍副，結前巴西太守蕭寅，謀立昭冑。昭冑許事克用寅爲尚書左僕射、護軍將軍。以寅有部曲，大事皆委之。時胡松領軍在新亭，寅遣人