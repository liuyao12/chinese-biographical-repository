ints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-032-qi:p078","text":"夏五月壬申，成子兄弟四乘如公。子我在幄，出迎之，遂入，閉門。宦者御之，子行殺宦者。公與婦人飲酒於檀臺，成子遷諸寢。公執戈將擊之，太史子餘曰：「非不利也，將除害也。」成子出舍于庫，聞公猶怒，將出，曰：「何所無君！」子行拔劍曰：「需，事之賊也。誰非田宗？所不殺子者有如田宗。」乃止。子我歸，屬徒攻闈與大門，皆弗勝，乃出。田氏追之。豐丘人執子我以告，殺之郭關。成子將殺大陸子方，田逆請而免之。以公命取車於道，出雍門。田豹與之車，弗受，曰：「逆為余請，豹與余車，余有私焉。事子我而有私於其讎，何以見魯、衛之士？」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-032-qi:m078-0006","start":6,"end":8,"surface":"成子","kind":"person","person_id":"cbr-p000270","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m078-0015","start":15,"end":17,"surface":"子我","kind":"person","person_id":"cbr-p001199","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m078-0030","start":30,"end":32,"surface":"宦者","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、族稱或未定指代；齊秉意茲等疑讀待版本校勘，不補熟知姓名。"},{"id":"c-shiji-032-qi:m078-0035","start":35,"end":37,"surface":"子行","kind":"person","person_id":"cbr-p001202","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m078-0038","start":38,"end":40,"surface":"宦者","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、族稱或未定指代；齊秉意茲等疑讀待版本校勘，不補熟知姓名。"},{"id":"c-shiji-032-qi:m078-0043","start":43,"end":45,"surface":"婦人","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、族稱或未定指代；齊秉意茲等疑讀待版本校勘，不補熟知姓名。"},{"id":"c-shiji-032-qi:m078-0051","start":51,"end":53,"surface":"成子","kind":"person","person_id":"cbr-p000270","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m078-0064","start":64,"end":68,"surface":"太史子餘","kind":"person","person_id":"cbr-p001203","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m078-0082","start":82,"end":84,"surface":"成子","kind":"person","person_id":"cbr-p000270","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m078-0106","start":106,"end":108,"surface":"子行","kind":"person","person_id":"cbr-p001202","status":"contextual_provisional"},{"id":"c-s