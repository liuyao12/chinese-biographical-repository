:m108-0005","chapter_id":"c-shiji-039-jin","paragraph_id":"c-shiji-039-jin:p108","quote":"景公"},{"mention_id":"c-shiji-039-jin:m108-0027","chapter_id":"c-shiji-039-jin","paragraph_id":"c-shiji-039-jin:p108","quote":"景公"}]}],"mentions":[{"id":"c-shiji-032-qi:m058-0024","start":24,"end":27,"surface":"晉景公","kind":"person","person_id":"cbr-p001155","status":"contextual_provisional","paragraph_id":"c-shiji-032-qi:p058","chapter_id":"c-shiji-032-qi"},{"id":"c-shiji-032-qi:m058-0028","start":28,"end":31,"surface":"晉景公","kind":"person","person_id":"cbr-p001155","status":"contextual_provisional","paragraph_id":"c-shiji-032-qi:p058","chapter_id":"c-shiji-032-qi"},{"id":"c-shiji-033-lu:m060-0040","start":40,"end":43,"surface":"晉景公","kind":"person","person_id":"cbr-p001155","status":"contextual_provisional","paragraph_id":"c-shiji-033-lu:p060","chapter_id":"c-shiji-033-lu"},{"id":"c-shiji-033-lu:m060-0069","start":69,"end":72,"surface":"晉景公","kind":"person","person_id":"cbr-p001155","status":"contextual_provisional","paragraph_id":"c-shiji-033-lu:p060","chapter_id":"c-shiji-033-lu"},{"id":"c-shiji-039-jin:m093-0054","start":54,"end":57,"surface":"景公據","kind":"person","person_id":"cbr-p001155","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p093","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m094-0000","start":0,"end":2,"surface":"景公","kind":"person","person_id":"cbr-p001155","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p094","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m095-0185","start":185,"end":187,"surface":"景公","kind":"person","person_id":"cbr-p001155","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p095","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m099-0083","start":83,"end":85,"surface":"景公","kind":"person","person_id":"cbr-p001155","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p099","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m103-0014","start":14,"end":17,"surface":"晉景公","kind":"person","person_id":"cbr-p001155","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p103","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m103-0020","start":20,"end":22,"surface":"景公","kind":"person","person_id":"cbr-p001155","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p103","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m108-0005","start":5,"end":7,"surface":"景公","kind":"person","person_id":"cbr-p001155","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p108","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m108-0027","start":27,"end":29,"surface":"景公","kind":"person","person_id":"cbr-p001155","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p108","chapter_id":"c-shiji-039-jin"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji033-127","person_id":"cbr-p001155","surfaces":["晉景公"],"scope":"cross_chapter","chapter_ids":["c-shiji-032-qi","c-shiji-033-lu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-032-qi:p058","quote":"十一年，晉初置六卿，賞鞌之功。齊頃公朝晉，欲尊王晉景公，晉景公不敢受，乃歸。歸而頃公弛苑囿，薄賦斂，振孤問疾，虛積聚以救民，民亦大說。厚禮諸侯。竟頃公卒，百姓附，諸侯不犯。"},{"paragraph_id":"c-shiji-033-lu:p060","quote":"成公二年春，齊伐取我隆。夏，公與晉郤克敗齊頃公於砹齊復歸我侵地。四年，成公如晉，晉景公不敬魯。魯欲背晉合於楚，或諫，乃不。十年，成公如晉。晉景公卒，因留成公送葬，魯諱之。十五年，始與吳王壽夢會鐘離。"}],"rationale":"按文公以後立嗣、昭公出奔、夾谷會盟、徵百牢與魯君世系的具體事件及國別暫定異稱，後期同爵稱不與先君混同。身份、匿名指代與數位疑讀待覆核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji039-101","person_id":"cbr-p001155","surfaces":["晉景公","景公","景公據"],"scope":"cross_chapter","chapter_ids":["c-shiji-032-qi","c-shiji-039-jin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-032-qi:p058","quote":"十一年，晉初置六卿，賞鞌之功。齊頃公朝晉，欲尊王晉景公，晉景公不敢受，乃歸。歸而頃公弛苑囿，薄賦斂，振孤問疾，虛積聚以救民，民亦大說。厚禮諸侯。竟頃公卒，百姓附，諸侯不犯。"},{"paragraph_id":"c-shiji-039-jin:p093","quote":"七年，成公與楚莊王爭彊，會諸侯于扈。陳畏楚，不會。晉使中行桓子伐陳，因救鄭，與楚戰，敗楚師。是年，成公卒，子景公據立。"},{"paragraph_id":"c-shiji-039-jin:p094","quote":"景公元年春，陳大夫夏徴舒弒其君靈公。二年，楚莊王伐陳，誅徴舒。"},{"paragraph_id":"c-shiji-039-jin:p095","quote":"三年，楚莊王圍鄭，鄭告急晉。晉使荀林父將中軍，隨會將上軍，趙朔將下軍，郤克、欒書、先縠、韓厥、鞏朔佐之。六月，至河。聞楚已服鄭，鄭伯肉袒與盟而去，荀林父欲還。先縠曰：「凡來救鄭，不至不可，將率離心。」卒度河。楚已服鄭，欲飲馬于河爲名而去。楚與晉軍大戰。鄭新附楚，畏之，反助楚攻晉。晉軍敗，走河，爭度，船中人指甚衆。楚虜我將智罃。歸而林父曰：「臣爲督將，軍敗當誅，請死。」景公欲許之。隨會曰：「昔文公之與楚戰城濮，成王歸殺子玉，而文公乃喜。今楚已敗我師，又誅其將，是助楚殺仇也。」乃止。"},{"paragraph_id":"c-shiji-039-jin:p099","quote":"八年，使郤克於齊。齊頃公母從樓上觀而笑之。所以然者，郤克僂，而魯使蹇，衞使眇，故齊亦令人如之以導客。郤克怒，歸至河上，曰：「不報齊者，河伯視之！」至國，請君，欲伐齊。景公問知其故，曰：「子之怨，安足以煩國！」弗聽。魏文子請老休，辟郤克，克執政。"},{"paragraph_id":"c-shiji-039-jin:p103","quote":"十二年冬，齊頃公如晉，欲上尊晉景公爲王，景公讓不敢。晉始作六（卿）［軍］，韓厥、鞏朔、趙穿、荀騅、趙括、趙旃皆爲卿。智罃自楚歸。"},{"paragraph_id":"c-shiji-039-jin:p108","quote":"十九年夏，景公病，立其太子壽曼爲君，是爲厲公。後月餘，景公卒。"}],"rationale":"按本篇明示名與稱號、晉世系與具體事件暫定所列提及同指；附各段原文，未按同字短名全域合併；紀年與版本差異待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-032-qi:p058","text":"十一年，晉初置六卿，賞鞌之功。齊頃公朝晉，欲尊王晉景公，晉景公不敢受，乃歸。歸而頃公弛苑囿，薄賦斂，振孤問疾，虛積聚以救民，民亦大說。厚禮諸侯。竟頃公卒，百姓附，諸侯不犯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-032-qi:m058-0015","start":15,"end":18,"surface":"齊頃公","kind":"person","person_id":"cbr-p001145","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m058-0024","start":24,"end":27,"surface":"晉景公","kind":"person","person_id":"cbr-p001155","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m058-0028","start":28,"end":31,"surface":"晉景公","kind":"person","person_id":"cbr-p001155","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m058-0040","start":40,"end":42,"surface":"頃公","kind":"person","person_id":"cbr-p001145","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m058-0073","start":73,"end":75,"surface":"頃公","kind":"person","person_id":"cbr-p001145","status":"contextual_provisional"}],"chapter_id":"c-shiji-032-qi","book_id":"b-shiji-032","work_id":"w-shiji","source_id":"s-shiji-032-qi"},{"id":"c-shiji-033-lu:p060","text":"成公二年春，齊伐取我隆。夏，公與晉郤克敗齊頃公於砹齊復歸我侵地。四年，成公如晉，晉景公不敬魯。魯欲背晉合於楚，或諫，乃不。十年，成公如晉。晉景公卒，因留成公送葬，魯諱之。十五年，始與吳王壽夢會鐘離。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-033-lu:m060-0000","start":0,"end":2,"surface":"成公","kind":"person","person_id":"cbr-p001270","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m060-0014","start":14,"end":15,"surface":"公","kind":"person","person_id":"cbr-p001270","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m060-0016","start":16,"end":19,"surface":"晉郤克","kind":"person","person_id":"cbr-p001149","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m060-0020","start":20,"end":23,"surface":"齊頃公","kind":"person","person_id":"cbr-p001145","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m060-0035","start":35,"end":37,"surface":"成公","kind":"person","person_id":"cbr-p001270","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m060-0040","start":40,"end":43,"surface":"晉景公","kind":"person","person_id":"cbr-p001155","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m060-0055","start":55,"end":57,"surface":"或諫","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未指名者、論贊署稱、地點氏稱或未定指代；不補姓名、爵位與成員。"},{"id":"c-shiji-033-lu:m060-0064","start":64,"end":66,"surface":"成公","kind":"person","person_id":"cbr-p001270","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m060-0069","start":69,"end":72,"surface":"晉景公","kind":"person","person_id":"cbr-p001155","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m060-0076","start":76,"end":78,"surface":"成公","kind":"person","person_id":"cbr-p001270","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m060-0091","start":91,"end":95,"surface":"吳王壽夢","kind":"person","person_id":"cbr-p001029","status":"contextual_provisional"}],"chapter_id":"c-shiji-033-lu","book_id":"b-shiji-033","work_id":"w-shiji","source_id":"s-shiji-033-lu"},{"id":"c-shiji-039-jin:p093","text":"七年，成公與楚莊王爭彊，會諸侯于扈。陳畏楚，不會。晉使中行桓子伐陳，因救鄭，與楚戰，敗楚師。是年，成公卒，子景公據立。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m093-0003","start":3,"end":5,"surface":"成公","kind":"person","person_id":"cbr-p001780","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m093-0006","start":6,"end":9,"surface":"楚莊王","kind":"person","person_id":"cbr-p000257","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m093-0027","start":27,"end":31,"surface":"中行桓子","kind":"person","person_id":"cbr-p001760","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m093-0049","start":49,"end":51,"surface":"成公","kind":"person","person_id":"cbr-p001780","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m093-0054","start":54,"end":57,"surface":"景公據","kind":"person","person_id":"cbr-p001155","status":"contextual_provisional"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"},{"id":"c-shiji-039-jin:p094","text":"景公元年春，陳大夫夏徴舒弒其君靈公。二年，楚莊王伐陳，誅徴舒。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m094-0000","start":0,"end":2,"surface":"景公","kind":"person","person_id":"cbr-p001155","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m094-0006","start":6,"end":12,"surface":"陳大夫夏徴舒","kind":"person","person_id":"cbr-p001399","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m094-0015","start":15,"end":17,"surface":"靈公","kind":"person","person_id":"cbr-p001485","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m094-0021","start":21,"end":24,"surface":"楚莊王","kind":"person","person_id":"cbr-p000257","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m094-0028","start":28,"end":30,"surface":"徴舒","kind":"person","person_id":"cbr-p001399","status":"contextual_provisional"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"},{"id":"c-shiji-039-jin:p095","text":"三年，楚莊王圍鄭，鄭告急晉。晉使荀林父將中軍，隨會將上軍，趙朔將下軍，郤克、欒書、先縠、韓厥、鞏朔佐之。六月，至河。聞楚已服鄭，鄭伯肉袒與盟而去，荀林父欲還。先縠曰：「凡來救鄭，不至不可，將率離心。」卒度河。楚已服鄭，欲飲馬于河爲名而去。楚與晉軍大戰。鄭新附楚，畏之，反助楚攻晉。晉軍敗，走河，爭度，船中人指甚衆。楚虜我將智罃。歸而林父曰：「臣爲督將，軍敗當誅，請死。」景公欲許之。隨會曰：「昔文公之與楚戰城濮，成王歸殺子玉，而文公乃喜。今楚已敗我師，又誅其將，是助楚殺仇也。」乃止。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m095-0005","start":5,"end":6,"surface":"王","kind":"person","person_id":"cbr-p000257","status":"contextual_provisional","note":"覆核更正：原連cbr-p000398楚成王；本提及是同句楚莊王的王，改連cbr-p000257。提及ID、字位及原文不變。"},{"id":"c-shiji-039-jin:m095-0016","start":16,"end":19,"surface":"荀林父","kind":"person","person_id":"cbr-p001760","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m095-0023","start":23,"end":25,"surface":"隨會","kind":"person","person_id":"cbr-p000408","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m095-0029","start":29,"end":31,"surface":"趙朔","kind":"person","person_id":"cbr-p001783","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m095-0035","start":35,"end":37,"surface":"郤克","kind":"person","person_id":"cbr-p001149","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m095-0038","start":38,"end":40,"surface":"欒書","kind":"person","person_id":"cbr-p000415","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m095-0041","start":41,"end":43,"surface":"先縠","kind":"person","person_id":"cbr-p001765","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m095-0044","start":44,"end":46,"surface":"韓厥","kind":"person","person_id":"cbr-p001153","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m095-0047","start":47,"end":49,"surface":"鞏朔","kind":"person","person_id":"cbr-p001784","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m095-0064","start":64,"end":66,"surface":"鄭伯","kind":"person","person_id":"cbr-p001148","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m095-0073","start":73,"end":76,"surface":"荀林父","kind":"person","person_id":"cbr-p001760","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m095-0079","start":79,"end":81,"surface":"先縠","kind":"person","person_id":"cbr-p001765","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m095-0150","start":150,"end":156,"surface":"船中人指甚衆","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m095-0161","start":161,"end":163,"surface":"智罃","kind":"person","person_id":"cbr-p001785","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m095-0166","start":166,"end":168,"surface":"林父","kind":"person","person_id":"cbr-p001760","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m095-0185","start":185,"end":187,"surface":"景公","kind":"person","person_id":"cbr-p001155","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m095-0191","start":191,"end":193,"surface":"隨會","kind":"person","person_id":"cbr-p000408","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m095-0197","start":197,"end":199,"surface":"文公","kind":"person","person_id":"cbr-p000252","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m095-0206","start":206,"end":208,"surface":"成王","kind":"person","person_id":"cbr-p000398","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m095-0210","start":210,"end":212,"surface":"子玉","kind":"person","person_id":"cbr-p001751","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m095-0214","start":214,"end":216,"surface":"文公","kind":"person","person_id":"cbr-p000252","status":"contextual_provisional"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"},{"id":"c-shiji-039-jin:p099","text":"八年，使郤克於齊。齊頃公母從樓上觀而笑之。所以然者，郤克僂，而魯使蹇，衞使眇，故齊亦令人如之以導客。郤克怒，歸至河上，曰：「不報齊者，河伯視之！」至國，請君，欲伐齊。景公問知其故，曰：「子之怨，安足以煩國！」弗聽。魏文子請老休，辟郤克，克執政。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m099-0004","start":4,"end":6,"surface":"郤克","kind":"person","person_id":"cbr-p001149","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m099-0009","start":9,"end":12,"surface":"齊頃公","kind":"person","person_id":"cbr-p001145","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m099-0026","start":26,"end":28,"surface":"郤克","kind":"person","person_id":"cbr-p001149","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m099-0031","start":31,"end":33,"surface":"魯使","kind":"person","person_id":"cbr-p001789","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m099-0035","start":35,"end":37,"surface":"衞使","kind":"person","person_id":"cbr-p001790","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m099-0047","start":47,"end":49,"surface":"導客","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m099-0050","start":50,"end":52,"surface":"郤克","kind":"person","person_id":"cbr-p001149","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m099-0083","start":83,"end":85,"surface":"景公","kind":"person","person_id":"cbr-p001155","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m099-0107","start":107,"end":110,"surface":"魏文子","kind":"person","person_id":"cbr-p001791","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m099-0115","start":115,"end":117,"surface":"郤克","kind":"person","person_id":"cbr-p001149","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m099-0118","start":118,"end":119,"surface":"克","kind":"person","person_id":"cbr-p001149","status":"contextual_provisional"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"},{"id":"c-shiji-039-jin:p103","text":"十二年冬，齊頃公如晉，欲上尊晉景公爲王，景公讓不敢。晉始作六（卿）［軍］，韓厥、鞏朔、趙穿、荀騅、趙括、趙旃皆爲卿。智罃自楚歸。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m103-0005","start":5,"end":8,"surface":"齊頃公","kind":"person","person_id":"cbr-p001145","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m103-0014","start":14,"end":17,"surface":"晉景公","kind":"person","person_id":"cbr-p001155","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m103-0020","start":20,"end":22,"surface":"景公","kind":"person","person_id":"cbr-p001155","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m103-0029","start":29,"end":36,"surface":"六（卿）［軍］","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m103-0037","start":37,"end":39,"surface":"韓厥","kind":"person","person_id":"cbr-p001153","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m103-0040","start":40,"end":42,"surface":"鞏朔","kind":"person","person_id":"cbr-p001784","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m103-0043","start":43,"end":45,"surface":"趙穿","kind":"person","person_id":"cbr-p000411","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m103-0046","start":46,"end":48,"surface":"荀騅","kind":"person","person_id":"cbr-p001793","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m103-0049","start":49,"end":51,"surface":"趙括","kind":"person","person_id":"cbr-p001794","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m103-0052","start":52,"end":54,"surface":"趙旃","kind":"person","person_id":"cbr-p001795","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m103-0058","start":58,"end":60,"surface":"智罃","kind":"person","person_id":"cbr-p001785","status":"contextual_provisional"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"},{"id":"c-shiji-039-jin:p108","text":"十九年夏，景公病，立其太子壽曼爲君，是爲厲公。後月餘，景公卒。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m108-0005","start":5,"end":7,"surface":"景公","kind":"person","person_id":"cbr-p001155","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m108-0011","start":11,"end":15,"surface":"太子壽曼","kind":"person","person_id":"cbr-p000260","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m108-0020","start":20,"end":22,