erson_id":"cbr-p000235","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m040-0158","start":158,"end":160,"surface":"隰朋","kind":"person","person_id":"cbr-p000244","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m040-0161","start":161,"end":163,"surface":"晉君","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、族稱或未定指代，不補未見姓名與成員；官禮等級不直接當授官。"}],"chapter_id":"c-shiji-032-qi","book_id":"b-shiji-032","work_id":"w-shiji","source_id":"s-shiji-032-qi"},{"id":"c-shiji-032-qi:p043","text":"四十一年，秦穆公虜晉惠公，復歸之。是歲，管仲、隰朋皆卒。管仲病，桓公問曰：「群臣誰可相者？」管仲曰：「知臣莫如君。」公曰：「易牙如何？」對曰：「殺子以適君，非人情，不可。」公曰：「開方如何？」對曰：「倍親以適君，非人情，難近。」公曰：「豎刀如何？」對曰：「自宮以適君，非人情，難親。」管仲死，而桓公不用管仲言，卒近用三子，三子專權。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-032-qi:m043-0005","start":5,"end":8,"surface":"秦穆公","kind":"person","person_id":"cbr-p000253","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m043-0009","start":9,"end":12,"surface":"晉惠公","kind":"person","person_id":"cbr-p000379","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m043-0020","start":20,"end":22,"surface":"管仲","kind":"person","person_id":"cbr-p000243","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m043-0023","start":23,"end":25,"surface":"隰朋","kind":"person","person_id":"cbr-p000244","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m043-0028","start":28,"end":30,"surface":"管仲","kind":"person","person_id":"cbr-p000243","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m043-0032","start":32,"end":34,"surface":"桓公","kind":"person","person_id":"cbr-p000235","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m043-0046","start":46,"end":48,"surface":"管仲","kind":"person","person_id":"cbr-p000243","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m043-0062","start":62,"end":64,"surface":"易牙","kind":"person","person_id":"cbr-p001121","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m043-0090","start":90,"end":92,"surf