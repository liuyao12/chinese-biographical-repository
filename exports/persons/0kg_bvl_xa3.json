nreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-089-jishao:p005:m0158","start":158,"end":160,"surface":"葛旗","kind":"person","person_id":"0kg_bvl_xa3","status":"contextual_provisional","interpretation_note":"依完整本傳敘事／引語主語辨識，不以最近姓名機械延續。","paragraph_id":"c-jinshu-089-jishao:p005","chapter_id":"c-jinshu-089-jishao"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-089-jishao:p005","text":"齊王冏既輔政，大興第舍，驕奢滋甚，紹以書諫曰：「夏禹以卑室稱美，唐虞以茅茨顯德，豐屋蔀家，無益危亡。竊承毀敗太樂以廣第舍，興造功力為三王立宅，此豈今日之先急哉！今大事始定，萬姓顒，咸待覆潤，宜省起造之煩，深思謙損之理。復主之勳不可棄矣，矢石之殆不可忘也。」冏雖謙順以報之，而卒不能用。紹嘗詣炯諮事，遇炯宴會，召董艾、葛旗等共論時政。艾言於炯曰：「嵇侍中善於絲竹，公可令操之。」左右進琴，紹推不受。冏曰：「今日為歡，卿何吝此邪！」紹對曰：「公匡復社稷，當軌物作則，垂之於後。紹雖虛鄙，忝備常伯，腰紱冠冕，鳴玉殿省，豈可操執絲竹，以為伶人之事！若釋公服從私宴，所不敢辭也。」冏大慚。艾等不自得而退。頃之，以公事免，冏以為左司馬。旬日，冏被誅。初，兵交，紹奔散赴宮，有持弩在東閣下者，將射之，遇有殿中將兵蕭隆，見紹姿容長者，疑非凡人，趣前拔箭，於此得免。遂還滎陽舊宅。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-jinshu-089-jishao:p005:m0000","start":0,"end":3,"surface":"齊王冏","kind":"person","person_id":"ee0_b2a_68e","status":"contextual_provisional","interpretation_note":"依完整本傳敘事／引語主語辨識，不以最近姓名機械延續。"},{"id":"c-jinshu-089-jishao:p005:m0017","start":17,"end":18,"surface":"紹","kind":"person","person_id":"6fg_r6l_5a5_A","status":"contextual_provisional","interpretation_note":"依完整本傳敘事／引語主語辨識，不以最近姓名機械延續。"},{"id":"c-jinshu-089-jishao:p005:m0024","start":24,"end":26,"surface":"夏禹","kind":"person","person_id":"6ip_dr3_fbl","status":"contextual_provisional","interpretation_note":"依完整本傳敘事／引語主語辨識，不以最近姓名機械延續。"},{"id":"c-jinshu-089-jishao:p005:m0032","start":32,"end":34,"surface":"唐虞","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"引古堯舜合稱，不造一人。"},{"id":"c-jinshu-089-jishao:p005:m0066","start":66,"end":68,"surface":"三王","kind":"unresolved","person_id"