d":"c-jinshu-035-peikai-family"},{"id":"c-sanguozhi-022-luyu:p002:m0207","start":207,"end":209,"surface":"商容","kind":"person","person_id":"xhs_wj2_zbt","status":"contextual_provisional","paragraph_id":"c-sanguozhi-022-luyu:p002","chapter_id":"c-sanguozhi-022-luyu"},{"id":"c-shiji-003-yin:m030-0044","start":44,"end":46,"surface":"商容","kind":"person","person_id":"xhs_wj2_zbt","status":"source_identified","paragraph_id":"c-shiji-003-yin:p030","chapter_id":"c-shiji-003-yin"},{"id":"c-shiji-003-yin:m031-0182","start":182,"end":184,"surface":"商容","kind":"person","person_id":"xhs_wj2_zbt","status":"source_identified","paragraph_id":"c-shiji-003-yin:p031","chapter_id":"c-shiji-003-yin"},{"id":"c-shiji-004-zhou:m018-0058","start":58,"end":60,"surface":"商容","kind":"person","person_id":"xhs_wj2_zbt","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p018","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-080-leyi:m016-0041","start":41,"end":43,"surface":"商容","kind":"person","person_id":"xhs_wj2_zbt","status":"contextual_provisional","paragraph_id":"c-shiji-080-leyi:p016","chapter_id":"c-shiji-080-leyi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji004-018","person_id":"xhs_wj2_zbt","surfaces":["商容"],"scope":"cross_chapter","chapter_ids":["c-shiji-003-yin","c-shiji-004-zhou"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-003-yin:p031","quote":"表商容之閭"},{"paragraph_id":"c-shiji-004-zhou:p018","quote":"表商容之閭"}],"rationale":"依前後本紀相同人物職事、事件或敘事脈絡暫定同指；不將同名、官稱或字形用作全庫自動匹配。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji080-028","person_id":"xhs_wj2_zbt","scope":"same_chapter","chapter_ids":["c-shiji-080-leyi"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["商容"],"evidence":[{"paragraph_id":"c-shiji-080-leyi:p016","quote":"燕王恨不用樂閒，樂閒既在趙，乃遺樂閒書曰：「紂之時，箕子不用，犯諫不怠，以冀其聽；商容不達，身祇辱焉，以冀其變。及民志不入，獄囚自出，然後二子退隱。故紂負桀暴之累，二子不失忠聖之名。何者？其憂患之盡矣。今寡人雖愚，不若紂之暴也；燕民雖亂，不若殷民之甚也。室有語，不相盡，以告鄰里。二者，寡人不為君取也。」"}],"rationale":"樂閒明示為樂毅子，樂叔明示為孫，不補闕代父親；樂乘為樂閒宗不補兄弟。燕王喜來書及趙襄王君序各限本段，曹相國未見名字不回填。河上丈人至蓋公師承不作父子。依本篇明示姓名、君序與來書答書範圍暫接；燕惠王來書寡人指惠王、將軍指樂毅，樂毅答書先王指昭王、足下君王指惠王。伍子胥引古首吳王指闔閭，後吳王在夫差賜鴟夷後指夫差。父兄與群臣不補具體親屬，王齊為反間假說不作授王爵。"}],"equivalence_decisions":[{"id":"eq-shiji080-shangrong","person_ids":["xhs_wj2_zbt"],"canonical_person_id":"xhs_wj2_zbt","scope":"cross_chapter","chapter_ids":["c-shiji-080-leyi","c-shiji-003-yin"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-080-leyi","source_id":"s-shiji-080-leyi","paragraph_id":"c-shiji-080-leyi:p016","quote":"燕王恨不用樂閒，樂閒既在趙，乃遺樂閒書曰：「紂之時，箕子不用，犯諫不怠，以冀其聽；商容不達，身祇辱焉，以冀其變。及民志不入，獄囚自出，然後二子退隱。故紂負桀暴之累，二子不失忠聖之名。何者？其憂患之盡矣。今寡人雖愚，不若紂之暴也；燕民雖亂，不若殷民之甚也。室有語，不相盡，以告鄰里。二者，寡人不為君取也。」","mention_ids":["c-shiji-080-leyi:m016-0041"]},{"chapter_id":"c-shiji-003-yin","source_id":"s-shiji-003-yin","paragraph_id":"c-shiji-003-yin:p030","quote":"西伯歸，乃陰修德行善，諸侯多叛紂而往歸西伯。西伯滋大，紂由是稍失權重。王子比干諫，弗聽。商容賢者，百姓愛之，紂廢之。及西伯伐飢國，滅之，紂之臣祖伊聞之而咎周，恐，奔告紂曰：「天既訖我殷命，假人元龜，無敢知吉，非先王不相我後人，維王淫虐用自絕，故天棄我，不有安食，不虞知天性，不迪率典。今我民罔不欲喪，曰『天曷不降威，大命胡不至』？今王其柰何？」紂曰：「我生不有命在天乎！」祖伊反，曰：「紂不可諫矣。」西伯既卒，周武王之東伐，至盟津，諸侯叛殷會周者八百。諸侯皆曰：「紂可伐矣。」武王曰：「爾未知天命。」乃復歸。","mention_ids":["c-shiji-003-yin:m030-0044"]},{"chapter_id":"c-shiji-003-yin","source_id":"s-shiji-003-yin","paragraph_id":"c-shiji-003-yin:p031","quote":"紂愈淫亂不止。微子數諫不聽，乃與大師、少師謀，遂去。比干曰：「為人臣者，不得不以死爭。」迺強諫紂。紂怒曰：「吾聞聖人心有七竅。」剖比干，觀其心。箕子懼，乃詳狂為奴，紂又囚之。殷之大師、少師乃持其祭樂器奔周。周武王於是遂率諸侯伐紂。紂亦發兵距之牧野。甲子日，紂兵敗。紂走，入登鹿臺，衣其寶玉衣，赴火而死。周武王遂斬紂頭，縣之大白旗。殺妲己。釋箕子之囚，封比干之墓，表商容之閭。封紂子武庚祿父，以續殷祀，令修行盤庚之政。殷民大說。於是周武王為天子。其後世貶帝號，號為王。而封殷後為諸侯，屬周。","mention_ids":["c-shiji-003-yin:m031-0182"]}],"rationale":"本篇信中商容不達受辱作殷臣典型，殷本紀明示商容賢者為紂所廢、周武王表其閭，同名、所事君及遭廢情境支持暫接。原文差異分存，不補退隱日期或生卒。 原文及錨點保留，同書不當獨立見證，未核底本影像。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true}],"passages":[{"id":"c-houhanshu-064-luzhi:p008","text":"建安中曹操北討栁城過涿郡告守令曰故北中郎將盧植名著海内學為儒宗士之楷模國之楨幹也昔武王入殷封商容之閭鄭喪子産仲尼隕涕孤到此州嘉其餘風春秋之義賢者之後宜有殊禮亟遣丞掾除其墳墓存其子孫并致薄醊以彰厥徳子毓知名","annotation_status":"in_progress","mentions":[{"id":"c-houhanshu-064-luzhi:p008:m0003","start":3,"end":5,"surface":"曹操","kind":"person","person_id":"dad_b77_b38","status":"contextual_provisional","interpretation_note":"依本段敘事及引語主客辨識；原字與來源層保留。"},{"id":"c-houhanshu-064-luzhi:p008:m0021","start":21,"end":23,"surface":"盧植","kind":"person","person_id":"m8n_ntm_79h","status":"contextual_provisional","interpretation_note":"依本段敘事及引語主客辨識；原字與來源層保留。"},{"id":"c-houhanshu-064-luzhi:p008:m0041","start":41,"end":43,"surface":"武王","kind":"person","person_id":"y4i_pjk_4gn_AA","status":"contextual_provisional","interpretation_note":"依本段敘事及引語主客辨識；原字與來源層保留。"},{"id":"c-houhanshu-064-luzhi:p008:m0046","start":46,"end":48,"surface":"商容","kind":"person","person_id":"xhs_wj2_zbt","status":"contextual_provisional","interpretation_note":"依本段敘事及引語主客辨識；原字與來源層保留。"},{"id":"c-houhanshu-064-luzhi:p008:m0052","start":52,"end":54,"surface":"子産","kind":"person","person_id":"qjs_3hl_6ck_A","status":"contextual_provisional","interpretation_note":"依本段敘事及引語主客辨識；原字與來源層保留。"},{"id":"c-houhanshu-064-luzhi:p008:m0054","start":54,"end":56,"surface":"仲尼","kind":"person","person_id":"fp6_ia6_7yw","status":"contextual_provisional","interpretation_note":"依本段敘事及引語主客辨識；原字與來源層保留。"},{"id":"c-houhanshu-064-luzhi:p008:m0058","start":58,"end":59,"surface":"孤","kind":"person","person_id":"dad_b77_b38","status":"contextual_provisional","interpretation_note":"依本段敘事及引語主客辨識；原字與來源層保留。"},{"id":"c-houhanshu-064-luzhi:p008:w0066","start":66,"end":68,"surface":"春秋","kind":"work","work_id":"w-chunqiu-hhs064-luzhi-reference","person_id":null,"status":"contextual_provisional","interpretation_note":"原稱春秋之義、春秋共相表裏；經義指稱，不因同字與左氏傳或公羊傳併一作品。"},{"id":"c-houhanshu-064-luzhi:p008:m0083","start":83,"end":84,"surface":"其","kind":"person","person_id":"m8n_ntm_79h","status":"contextual_provisional","interpretation_note":"依本段敘事及引語主客辨識；原字與來源層保留。"},{"id":"c-houhanshu-064-luzhi:p008:m0087","start":87,"end":88,"surface":"其","kind":"person","person_id":"m8n_ntm_79h","status":"contextual_provisional","interpretation_note":"依本段敘事及引語主客辨識；原字與來源層保留。"},{"id":"c-houhanshu-064-luzhi:p008:m0099","start":99,"end":100,"surface":"毓","kind":"person","person_id":"m8n_ntm_79h_A","status":"contextual_provisional","interpretation_note":"依本段敘事及引語主客辨識；原字與來源層保留。"}],"source_position":{"source_layer":"received_biography","first_line":338,"last_line":346,"raw_projection_ref":"source-evidence/houhan064-luzhi/projection.json","editorial_paragraph_boundary":true,"first_page_id":"KR2a0009_WYG_094-19a","last_page_id":"KR2a0009_WYG_094-19b"},"chapter_id":"c-houhanshu-064-luzhi","book_id":"b-houhanshu-064","work_id":"w-houhanshu","source_id":"s-houhanshu-064-luzhi"},{"id":"c-jinshu-035-peikai-family:p013","text":"初，侍講東宮，曆黃門吏部郎、侍中。東海王越以為豫州刺史、北中郎將、假節。王浚承制，以憲為尚書。永嘉末，王浚為石勒所破，棗嵩等莫不謝罪軍門，貢賂交錯，惟憲及荀綽恬然私室。勒素聞其名，召而謂之曰：「王浚虐暴幽州，人鬼同疾。孤恭行乾憲，拯茲黎元，羈舊咸歡，慶謝交路。二君齊惡傲威，誠信岨絕，防風之戮，將誰歸乎？」憲神色侃然，泣而對曰：「臣等世荷晉榮，恩遇隆重。王浚凶粗醜正，尚晉之遺籓。雖欣聖化，義岨誠心。且武王伐紂，表商容之閭，未聞商容在倒戈之例也。明公既不欲以道化厲物，必于刑忍為治者，防風之戮，臣之分也。請就辟有司。」不拜而出。勒深嘉之，待以賓禮。勒乃簿王浚官寮親屬，皆貲至巨萬，惟憲與荀綽家有書百餘帙，鹽米各十數斛而已。勒聞之，謂其長史張賓曰：「名不虛也。吾不喜得幽州，喜獲二子。」署從事中郎，出為長樂太守。及勒僭號，未遑制度，與王波為之撰朝儀，於是憲章文物，擬于王者。勒大悅，署太中大夫，遷司徒。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-035-peikai-family:p013:m0017","start":17,"end":21,"surface":"東海王越","kind":"person","person_id":"9o2_vhv_r7y","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p013:m0036","start":36,"end":38,"surface":"王浚","kind":"person","person_id":"9c1_ff0_1b5","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p013:m0042","start":42,"end":43,"surface":"憲","kind":"person","person_id":"c6e_8f3_014","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p013:m0051","start":51,"end":53,"surface":"王浚","kind":"person","person_id":"9c1_ff0_1b5","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p013:m0054","start":54,"end":56,"surface":"石勒","kind":"person","person_id":