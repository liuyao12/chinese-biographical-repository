onal"},{"id":"c-shiji-069-su:m044-0005","start":5,"end":7,"surface":"湣王","kind":"person","person_id":"cbr-p004052","status":"contextual_provisional"},{"id":"c-shiji-069-su:m044-0011","start":11,"end":13,"surface":"湣王","kind":"person","person_id":"cbr-p004052","status":"contextual_provisional"},{"id":"c-shiji-069-su:m044-0038","start":38,"end":41,"surface":"燕易王","kind":"person","person_id":"cbr-p004047","status":"contextual_provisional"},{"id":"c-shiji-069-su:m044-0043","start":43,"end":45,"surface":"燕噲","kind":"person","person_id":"cbr-p004053","status":"contextual_provisional"},{"id":"c-shiji-069-su:m044-0051","start":51,"end":54,"surface":"齊大夫","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、氏族、未名者或未定指代，未補成員、姓名及世系。"},{"id":"c-shiji-069-su:m044-0056","start":56,"end":58,"surface":"蘇秦","kind":"person","person_id":"cbr-p004022","status":"contextual_provisional"},{"id":"c-shiji-069-su:m044-0063","start":63,"end":65,"surface":"使人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、氏族、未名者或未定指代，未補成員、姓名及世系。"},{"id":"c-shiji-069-su:m044-0066","start":66,"end":68,"surface":"蘇秦","kind":"person","person_id":"cbr-p004022","status":"contextual_provisional"},{"id":"c-shiji-069-su:m044-0076","start":76,"end":78,"surface":"齊王","kind":"person","person_id":"cbr-p004052","status":"contextual_provisional"},{"id":"c-shiji-069-su:m044-0078","start":78,"end":80,"surface":"使人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、氏族、未名者或未定指代，未補成員、姓名及世系。"},{"id":"c-shiji-069-su:m044-0081","start":81,"end":82,"surface":"賊","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、氏族、未名者或未定指代，未補成員、姓名及世系。"},{"id":"c-shiji-069-su:m044-0086","start":86,"end":88,"surface":"蘇秦","kind":"person","person_id":"cbr-p004022","status":"contextual_provisional"},{"id":"c-shiji-069-su:m044-0093","start":93,"end":95,"surface":"齊王","kind":"person","person_id":"cbr-p004052","status":"contextual_provisional"},{"id":"c-shiji-069-su:m044-0112","start":112,"end":114,"surface":"蘇秦","kind":"person","person_id":"cbr-p004022","status":"contextual_provisional"},{"id":"c-shiji-069-su:m044-0127","start":127,"end":128,"surface":"賊","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、氏族、未名者或未定指代，未補成員、姓名及世系。"},{"id":"c-shiji-069-su:m044-0141","start":141,"end":143,"surface":"蘇秦","kind":"person","person_id":"cbr-p004022","status":"contextual_provisional"},{"id":"c-shiji-069-su:m044-0148","start":148,"end":150,"surface":"齊王","kind":"person","person_id":"cbr-p004052","status":"contextual_provisional"},{"id":"c-shiji-069-su:m044-0167","start":167,"end":169,"surface":"蘇生","kind":"person","person_id":"cbr-p004022","status":"contextual_provisional"}],"chapter_id":"c-shiji-069-su","book_id":"b-shiji-069","work_id":"w-shiji","source_id":"s-shiji-069-su"},{"id":"c-shiji-069-su:p046","text":"燕相子之與蘇代婚，而欲得燕權，乃使蘇代侍質子於齊。齊使代報燕，燕王噲問曰：「齊王其霸乎？」曰：「不能。」曰：「何也？」曰：「不信其臣。」於是燕王專任子之，已而讓位，燕大亂。齊伐燕，殺王噲、子之。燕立昭王，而蘇代、蘇厲遂不敢入燕，皆終歸齊，齊善待之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m046-0002","start":2,"end":4,"surface":"子之","kind":"person","person_id":"cbr-p004069","status":"contextual_provisional"},{"id":"c-shiji-069-su:m046-0005","start":5,"end":7,"surface":"蘇代","kind":"person","person_id":"cbr-p004065","status":"contextual_provisional"},{"id":"c-shiji-069-su:m046-0017","start":17,"end":19,"surface":"蘇代","kind":"person","person_id":"cbr-p004065","status":"contextual_provisional"},{"id":"c-shiji-069-su:m046-0020","start":20,"end":22,"surface":"質子","kind":"person","person_id":"cbr-p004068","status":"contextual_provisional"},{"id":"c-shiji-069-su:m046-0027","start":27,"end":28,"surface":"代","kind":"person","person_id":"cbr-p004065","status":"contextual_provisional"},{"id":"c-shiji-069-su:m046-0031","start":31,"end":34,"surface":"燕王噲","kind":"person","person_id":"cbr-p004053","status":"contextual_provisional"},{"id":"c-shiji-069-su:m046-0038","start":38,"end":40,"s