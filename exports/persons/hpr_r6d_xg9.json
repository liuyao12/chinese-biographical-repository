d_xg9","event_type":"death","status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-124-youxia","source_id":"s-shiji124-youxia","paragraph_id":"c-shiji-124-youxia:p014","quote":"解入關，關中賢豪知與不知，聞其聲，爭交驩解。解為人短小，不飲酒，出未嘗有騎。已又殺楊季主。楊季主家上書，人又殺之闕下。上聞，乃下吏捕解。解亡，置其母家室夏陽，身至臨晉。臨晉籍少公素不知解，解冒，因求出關。籍少公已出解，解轉入太原，所過輒告主人家。吏逐之，跡至籍少公。少公自殺，口絕。久之，乃得解。窮治所犯，為解所殺，皆在赦前。軹有儒生侍使者坐，客譽郭解，生曰：「郭解專以姦犯公法，何謂賢！」解客聞，殺此生，斷其舌。吏以此責解，解實不知殺者。殺者亦竟絕，莫知為誰。吏奏解無罪。御史大夫公孫弘議曰：「解布衣為任俠行權，以睚眥殺人，解雖弗知，此罪甚於解殺之。當大逆無道。」遂族郭解翁伯。","person_mention_id":"c-shiji-124-youxia:m014-0086"}],"source_term":"少公自殺","interpretation_note":"明示死亡敘述連個人與原句；概數及朝代範圍不換算單一年，誅族不據此逐一補造家屬死亡。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"mentions":[{"id":"c-shiji-124-youxia:m014-0086","start":86,"end":89,"surface":"籍少公","kind":"person","person_id":"hpr_r6d_xg9","status":"contextual_provisional","paragraph_id":"c-shiji-124-youxia:p014","chapter_id":"c-shiji-124-youxia"},{"id":"c-shiji-124-youxia:m014-0102","start":102,"end":105,"surface":"籍少公","kind":"person","person_id":"hpr_r6d_xg9","status":"contextual_provisional","paragraph_id":"c-shiji-124-youxia:p014","chapter_id":"c-shiji-124-youxia"},{"id":"c-shiji-124-youxia:m014-0129","start":129,"end":132,"surface":"籍少公","kind":"person","person_id":"hpr_r6d_xg9","status":"contextual_provisional","paragraph_id":"c-shiji-124-youxia:p014","chapter_id":"c-shiji-124-youxia"},{"id":"c-shiji-124-youxia:m014-0133","start":133,"end":135,"surface":"少公","kind":"person","person_id":"hpr_r6d_xg9","status":"contextual_provisional","paragraph_id":"c-shiji-124-youxia:p014","chapter_id":"c-shiji-124-youxia"}],"relations":[],"title_holdings":[],"address_assertions":[{"id":"pa-shiji124-011","person_id":"hpr_r6d_xg9","relation":"biographical_origin","place":{"source_name":"臨晉","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-124-youxia","source_id":"s-shiji124-youxia","paragraph_id":"c-shiji-124-youxia:p014","quote":