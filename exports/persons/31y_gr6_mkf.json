":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m026-0005","start":5,"end":7,"surface":"韓信","kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0014","start":14,"end":15,"surface":"嬰","kind":"person","person_id":"sj9_pfu_fwh","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0020","start":20,"end":22,"surface":"公杲","kind":"person","person_id":"p3e_kto_76o","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0080","start":80,"end":82,"surface":"項羽","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0083","start":83,"end":85,"surface":"項聲","kind":"person","person_id":"myr_tln_x5c","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0086","start":86,"end":88,"surface":"薛公","kind":"person","person_id":"1wy_ygt_gre","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0089","start":89,"end":91,"surface":"郯公","kind":"person","person_id":"bhy_6ln_wvi","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0096","start":96,"end":97,"surface":"嬰","kind":"person","person_id":"sj9_pfu_fwh","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0103","start":103,"end":105,"surface":"項聲","kind":"person","person_id":"myr_tln_x5c","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0106","start":106,"end":108,"surface":"郯公","kind":"person","person_id":"bhy_6ln_wvi","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0112","start":112,"end":114,"surface":"薛公","kind":"person","person_id":"1wy_ygt_gre","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0135","start":135,"end":137,"surface":"項佗","kind":"person","person_id":"9pq_9wn_9y1","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m026-0160","start":160,"end":162,"surface":"周蘭","kind":"person","person_id":"639_jt7_ns0","status":"contextual_provisional"