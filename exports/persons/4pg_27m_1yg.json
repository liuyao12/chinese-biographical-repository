":"annotation_containers_not_independent_witness_passages","count_explanation":"2處獨立位置，2個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu080-ws2603570-comparison"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-080-wangxizhi-comparison:p026:m0055","start":55,"end":58,"surface":"一道士","kind":"person","person_id":"4pg_27m_1yg","status":"contextual_provisional","interpretation_note":"依完整所選數位比較傳文與此處角色判讀；未圖校，非武英殿底本認證。","paragraph_id":"c-jinshu-080-wangxizhi-comparison:p026","chapter_id":"c-jinshu-080-wangxizhi-comparison"},{"id":"c-jinshu-080-wangxizhi-comparison:p026:m0078","start":78,"end":80,"surface":"道士","kind":"person","person_id":"4pg_27m_1yg","status":"contextual_provisional","interpretation_note":"依完整所選數位比較傳文與此處角色判讀；未圖校，非武英殿底本認證。","paragraph_id":"c-jinshu-080-wangxizhi-comparison:p026","chapter_id":"c-jinshu-080-wangxizhi-comparison"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-080-wangxizhi-comparison:p026","text":"性愛鵝，會稽有孤居姥養一鵝，善鳴，求市未能得，遂攜親友命駕就觀。姥聞羲之將至，烹以待之，羲之嘆惜彌日。又山陰有一道士，養好鵝，羲之往觀焉，意甚悅，固求市之。道士云：「為寫《道德經》，當舉群相贈耳。」羲之欣然寫畢，籠鵝而歸，甚以為樂。其任率如此。嘗詣門生家，見棐幾滑淨，因書之，真草相半。後為其父誤刮去之，門生驚懊者累日。又嘗在蕺山見一老姥，持六角竹扇賣之。羲之書其扇，各為五字。姥初有慍色。因謂姥曰：「但言是王右軍書，以求百錢邪。」姥如其言，人競買之。他日，姥又持扇來，羲之笑而不答。其書為世所重，皆此類也。每自稱「我書比鐘繇，當抗行；比張芝草，猶當雁行也」。曾與人書云：「張芝臨池學書，池水盡黑，使人耽之若是，未必後之也。」羲之書初不勝庾翼、郗愔，及其暮年方妙。嘗以章草答庾亮，而翼深歎伏，因與羲之書云：「吾昔有伯英章草十紙，過江顛狽，遂乃亡失，常歎妙跡永絕。忽見足下答家兄書，煥若神明，頓還舊觀。」","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","source_position":{"first_line":64,"last_line":64,"revision_id":2603570,"raw_projection_ref":"source-evidence/jin080-wangxizhi-comparison/projection.json","raw_file_sha256":"4f3f42dd7d8ab0ca3c45e6524e4977db40332e845080367088be0419a3a0e8a0","unit_key":"p026","source_layer":"received_chapter"},"mentions":[{"id":"c-jinshu-080-wangxizhi-comparison:p026:m0007","start":7,"end":10,"surface":"孤居姥","kind":"person","person_id":"m4x_b2h_nnj","status":"contextual_provisional","interpretation_note":"依完整所選數位比較傳文與此處角色判讀；未圖校，非武英殿底本認證。"},{"id":"c-jinshu-080-wangxizhi-comparison:p026:m0032","start":32,"end":33,"surface":"姥","kind":"person","person_id":"m4x_b2h_nnj","status":"contextual_provisional","interpretation_note":"依完整所選數位比較傳文與此處角色判讀；未圖校，非武英殿底本認證。"},{"id":"c-jinshu-080-wangxizhi-comparison:p026:m0034","start":34,"end":36,"surface":"羲之","kind":"person","person_id":"7r6_k52_qji_ABDCA","status":"contextual_provisional","interpretation_note":"依完整所選數位比較傳文與此處角色判讀；未圖校，非武英殿底本認證。"},{"id":"c-jinshu-080-wangxizhi-comparison:p026:m0044","start":44,"end":46,"surface":"羲之","kind":"person","person_id":"7r6_k52_qji_ABDCA","status":"contextual_provisional","interpretation_note":"依完整所選數位比較傳文與此處角色判讀；未圖校，非武英殿底本認證。"},{"id":"c-jinshu-080-wangxizhi-comparison:p026:m0055","start":55,"end":58,"surface":"一道士","kind":"person","person_id":"4pg_27m_1yg","status":"contextual_provisional","interpretation_note":"依完整所選數位比較傳文與此處角色判讀；未圖校，非武英殿底本認證。"},{"id":"c-jinshu-080-wangxizhi-comparison:p026:m0063","start":63,"end":65,"surface":"羲之","kind":"person","person_id":"7r6_k52_qji_ABDCA","status":"contextual_provisional","interpretation_note":"依完整所選數位比較傳文與此處角色判讀；未圖校，非武英殿底本認證。"},{"id":"c-jinshu-080-wangxizhi-comparison:p026:m0078","start":78,"end":80,"surface":"道士","