distance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-050-chuyuan","source_id":"s-shiji-050-chuyuan","paragraph_id":"c-shiji-050-chuyuan:p006","quote":"文王立三年卒，子安王道立。安王二十二年卒，子襄王注立。襄王立十四年卒，子王純代立。王純立，地節二年，中人上書告楚王謀反，王自殺，國除，入漢為彭城郡。","source_term":"子安王道立"}],"source_assertion_id":"a-shiji050-008","interpretation_note":"以此受傳正文的明示近親主張配置局部家族；不合併跨篇候選身份、不補闕名世代，不表示遠祖世系已核實。分支字元不是長幼排行。","reviewer":"Codex（AI 代理）","parent_person_id":"n7i_i5n_lay_B"},"id_aliases":["cbr-p003159"]},{"id":"zju_pdu_xge","label":"劉交","status":"active","historicity":"historical_tradition","aliases":[{"surface":"劉交","mention_ids":["c-shiji-008-gaozu:m071-0028"]},{"surface":"交","mention_ids":["c-shiji-008-gaozu:m063-0041","c-shiji-008-gaozu:m078-0025","c-shiji-009-lvhou:m003-0102"]},{"surface":"楚元王","mention_ids":["c-shiji-009-lvhou:m005-0003","c-shiji-011-jingdi:m004-0118","c-shiji-011-jingdi:m004-0141"]},{"surface":"楚王","mention_ids":["c-shiji-010-wendi:m009-0125"]}],"evidence":[{"mention_id":"c-shiji-008-gaozu:m071-0028","chapter_id":"c-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p071","quote":"劉交"},{"mention_id":"c-shiji-008-gaozu:m063-0041","chapter_id":"c-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p063","quote":"交"},{"mention_id":"c-shiji-008-gaozu:m078-0025","chapter_id":"c-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p078","quote":"交"},{"mention_id":"c-shiji-009-lvhou:m003-0102","chapter_id":"c-shiji-009-lvhou","paragraph_id":"c-shiji-009-lvhou:p003","quote":"交"},{"mention_id":"c-shiji-009-lvhou:m005-0003","chapter_id":"c-shiji-009-lvhou","paragraph_id":"c-shiji-009-lvhou:p005","quote":"楚元王"},{"mention_id":"c-shiji-010-wendi:m009-0125","chapter_id":"c-shiji-010-wendi","paragraph_id":"c-shiji-010-wendi:p009","quote":"楚王"},{"mention_id":"c-shiji-011-jingdi:m004-0118","chapter_id":"c-shiji-011-jingdi","paragraph_id":"c-shiji-011-jingdi:p004","quote":"楚元王"},{"mention_id":"c-shiji-011-jingdi:m004-0141","chapter_id":"c-shiji-011-jingdi"