true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-023-peiqian-ws2376966:p004:m0183","start":183,"end":185,"surface":"郝溫","kind":"person","person_id":"47o_y0u_5jq","status":"contextual_provisional","interpretation_note":"依完整裴潛單元及具體上下文辨識；原字及見證層次保留。","paragraph_id":"c-sanguozhi-023-peiqian-ws2376966:p004","chapter_id":"c-sanguozhi-023-peiqian-ws2376966"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-sgz023-fourner-haowen","person_id":"47o_y0u_5jq","surfaces":["郝溫"],"scope":"same_chapter","chapter_ids":["c-sanguozhi-023-peiqian-ws2376966"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-sanguozhi-023-peiqian-ws2376966","paragraph_id":"c-sanguozhi-023-peiqian-ws2376966:p004","quote":"時代郡大亂，以潛爲代郡太守。烏丸王及其大人，凡三人，各自稱單于，專制郡事。前太守莫能治正，太祖欲授潛精兵以鎮討之。潛辭曰：「代郡戶口殷衆，士馬控弦，動有萬數。單于自知放橫日久，內不自安。今多將兵往，必懼而拒境，少將則不見憚。宜以計謀圖之，不可以兵威迫也。」遂單車之郡。單于驚喜。潛撫之以靜。單于以下脫帽稽顙，悉還前後所掠婦女、器械、財物。潛案誅郡中大吏與單于爲表裏者郝溫、郭端等十餘人，北邊大震，百姓歸心。在代三年，還爲丞相理曹掾，太祖褒稱治代之功，潛曰：「潛於百姓雖寬，於諸胡爲峻。今計者必以潛爲理過嚴，而事加寬惠；彼素驕恣，過寬必弛，既弛又將攝之以法，此訟爭所由生也。以勢料之，代必復叛。」於是太祖深悔還潛之速。後數十日，三單于反問至，乃遣鄢陵侯彰爲驍騎將軍征之。","mention_ids":["c-sanguozhi-023-peiqian-ws2376966:p004:m0183"]}],"rationale":"依完整裴潛單元及具體上下文辨識；原字及見證層次保留。","human_reviewed":false,"reviewer":"Codex（AI代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-023-peiqian-ws2376966:p004","text":"時代郡大亂，以潛爲代郡太守。烏丸王及其大人，凡三人，各自稱單于，專制郡事。前太守莫能治正，太祖欲授潛精兵以鎮討之。潛辭曰：「代郡戶口殷衆，士馬控弦，動有萬數。單于自知放橫日久，內不自安。今多將兵往，必懼而拒境，少將則不見憚。宜以計謀圖之，不可以兵威迫也。」遂單車之郡。單于驚喜。潛撫之以靜。單于以下脫帽稽顙，悉還前後所掠婦女、器械、財物。潛案誅郡中大吏與單于爲表裏者郝溫、郭端等十餘人，北邊大震，百姓歸心。在代三年，還爲丞相理曹掾，太祖褒稱治代之功，潛曰：「潛於百姓雖寬，於諸胡爲峻。今計者必以潛爲理過嚴，而事加寬惠；彼素驕恣，過寬必弛，既弛又將攝之以法