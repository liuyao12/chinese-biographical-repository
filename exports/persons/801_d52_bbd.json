age_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"person_id":"801_d52_bbd","title":null,"surname":"蕭","ming":"斌","additional_names":[],"chapter_id":"c-weishu-weishou-038-wanghuilong","paragraph_id":"c-weishu-weishou-038-wanghuilong:unit004","quote":"其後劉義隆將到彦之檀道濟等頻頓淮潁大相侵掠慧龍力戰屢摧其鋒彦之與友人蕭斌書曰魯軌頽鈍馬楚麤狂亡人之中唯王慧龍及韓延之可為深憚不意儒生懦夫乃令老子訝之劉義隆縱反間云慧龍自以功髙而位不至欲引寇入邊因執安南大將軍司馬楚之以叛世祖聞曰此必不然是齊人忌樂毅耳乃賜慧龍璽書曰義隆畏將軍如虎欲相中害朕自知之風塵之言想不足介意也劉義隆計既不行復遣刺客呂𤣥伯購慧龍首二百户男絹一千匹𤣥伯偽為反間來求屏人有所論慧龍疑之使人探其懐有尺刀𤣥伯叩頭請死慧龍曰各為其主也吾不忍害此人左右皆言義隆賊心未已不殺𤣥伯無以制將來慧龍曰死生有命彼亦安能害我且吾方以仁義為干鹵又何憂乎刺客遂捨之時人服其寛恕","note":"僅此固定來源明文構件，保原𤣥／夀等字，不回覆既有其他來源。僧彬只存法名，不補俗姓。","status":"editorial_provisional","human_reviewed":false,"source_proposal_id":"wf44-196","work_id":"w-weishu-weishou","book_id":"b-weishu-weishou-038","source_id":"s-weishu-weishou-038-wanghuilong"}],"mentions":[{"id":"c-songshu-076-wangxuanmo-ws:p004:m0025","start":25,"end":27,"surface":"蕭斌","kind":"person","person_id":"801_d52_bbd","status":"contextual_provisional","paragraph_id":"c-songshu-076-wangxuanmo-ws:p004","chapter_id":"c-songshu-076-wangxuanmo-ws"},{"id":"c-songshu-076-wangxuanmo-ws:p004:m0203","start":203,"end":205,"surface":"蕭斌","kind":"person","person_id":"801_d52_bbd","status":"contextual_provisional","paragraph_id":"c-songshu-076-wangxuanmo-ws:p004","chapter_id":"c-songshu-076-wangxuanmo-ws"},{"id":"c-songshu-076-wangxuanmo-ws:p004:m0250","start":250,"end":251,"surface":"斌","kind":"person","person_id":"801_d52_bbd","status":"contextual_provisional","paragraph_id":"c-songshu-076-wangxuanmo-ws:p004","chapter_id":"c-songshu-076-wangxuanmo-ws"},{"id":"c-weishu-weishou-038-wanghuilong:unit004:m0032","start":32,"end":34,"surface":"友人","kind":"person","person_id":"801_d52_bbd","status":"contextual_provisional","interpretation_note":"逐句scope與受話稱呼判讀，不把鄰近人物當通用主語。","paragraph_id":"c-weishu-weishou-038-wanghuilong:unit004","chapter_id":"c-weishu-weishou-038-wanghuilong"},{"id":"c-weishu-weishou-038-wanghuilong:unit004:m0034","start":34,"end":36,"surface":"蕭斌","kind":"person","person_id":"801_d52_bbd","status":"contextual_provisional","interpretation_note":"依完整敘事、發言者／受話人與時間辨識，不按nearest person。","paragraph_id":"c-weishu-weishou-038-wanghuilong:unit004","chapter_id":"c-weishu-weishou-038-wanghuilong"}],"relations":[],"title_holdings":[{"id":"th-songshu-076-wangxuanmo-ws-4-21","title":"輔國將軍","kind":"office","mode":"attestation","person_id":"801_d52_bbd","attestations":[{"id":"th-songshu-076-wangxuanmo-ws-4-21:a","paragraph_id":"c-songshu-076-wangxuanmo-ws:p004","start":21,"end":25,"surface":"輔國將軍","person_mention_id":"c-songshu-076-wangxuanmo-ws:p004:m0025","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-076","chapter_id":"c-songshu-076-wangxuanmo-ws","source_id":"s-songshu-076-wangxuanmo-ws-ws1997726","paragraph_id":"c-songshu-076-wangxuanmo-ws:p004","quote":"及大舉北征，以玄謨為寧朔將軍，前鋒入河，受輔國將軍蕭斌節度。玄謨向碻磝，戍主奔走，遂圍滑臺，積旬不克。虜主託跋燾率大眾號百萬，鞞鼓之聲，震動天地。玄謨軍眾亦盛，器械甚精，而玄謨專依所見，多行殺戮。初圍城，城內多茅屋，眾求以火箭燒之，玄謨恐損亡軍實，不從。城中即撤壞之，空地以為窟室。及魏救將至，眾請發車為營，又不從，將士多離怨。又營貨利，一匹布責人八百梨，以此倍失人心。及託跋燾軍至，乃奔退，麾下散亡略盡。蕭斌將斬之，沈慶之固諫曰：「佛狸威震天下，控弦百萬，豈玄謨所能當。且殺戰將以自弱，非良計也。」斌乃止。初，玄謨始將見殺，夢人告曰：「誦觀音經千遍，則免。」既覺，誦之得千遍，明日將刑，誦之不輟，忽傳呼停刑。遣代守碻磝，江夏王義恭為征討都督，以為碻磝不可守，召令還，為魏軍所追，大破之，流矢中臂。二十八年正月，還至歷城，義恭與玄謨書曰：「聞因敗為成，臂上金瘡，得非金印之徵也。」","person_mention_id":"c-songshu-076-wangxuanmo-ws:p004:m0025"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-songshu-076-wangxuanmo-ws:p004","text":"及大舉北征，以玄謨為寧朔將軍，前鋒入河，受輔國將軍蕭斌節度。玄謨向碻磝，戍主奔走，遂圍滑臺，積旬不克。虜主託跋燾率大眾號百萬，鞞鼓之聲，震動天地。玄謨軍眾亦盛，器械甚精，而玄謨專依所見，多行殺戮。初圍城，城內多茅屋，眾求以火箭燒之，玄謨恐損亡軍實，不從。城中即撤壞之，空地以為窟室。及魏救將至，眾請發車為營，又不從，將士多離怨。又營貨利，一匹布責人八百梨，以此倍失人心。及託跋燾軍至，乃奔退，麾下散亡略盡。蕭斌將斬之，沈慶之固諫曰：「佛狸威震天下，控弦百萬，豈玄謨所能當。且殺戰將以自弱，非良計也。」斌乃止。初，玄謨始將見殺，夢人告曰：「誦觀音經千遍，則免。」既覺，誦之得千遍，明日將刑，誦之不輟，忽傳呼停刑。遣代守碻磝，江夏王義恭為征討都督，以為碻磝不可守，召令還，為魏軍所追，大破之，流矢中臂。二十八年正月，還至歷城，義恭與玄謨書曰：「聞因敗為成，臂上金瘡，得非金印之徵也。」","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":42,"last_line":42,"raw_start":3813,"raw_end":4272,"raw_character_offsets":[3813,3814,3815,3816,3817,3818,3819,3820,3821,3822,3823,3824,3825,3826,3827,3828,3829,3830,3831,3832,3833,3834,3835,3836,3837,3838,3839,3840,3841,3842,3843,3844,3845,3846,3847,3848,3849,3850,3851,3852,3853,3854,3855,3856,3857,3858,3859,3860,3861,3862,3863,3864,3865,3866,3867,3868,3869,3870,3871,3872,3873,3874,3875,3876,3877,3878,3879,3880,3881,3882,3883,3884,3885,3886,3887,3888,3889,3890,3891,3892,3893,3894,3895,3896,3897,3898,3899,3900,3901,3902,3903,3904,3905,3906,3907,3908,3909,3910,3911,3912,3913,3914,3915,3916,3917,3918,3919,3920,3921,3922,3923,3924,3925,3926,3927,3928,3929,3930,3931,3932,3933,3934,3935,3936,3937,3938,3939,3940,3941,3942,3943,3944,3945,3946,3947,3948,3949,3950,3951,3952,3953,3954,3955,3956,3957,3958,3959,3960,3961,3962,3963,3964,3965,3966,3967,3968,3969,3970,3971,3972,3973,3974,3975,3976,3977,3978,3979,3980,3981,3982,3983,3984,3985,3986,3987,3988,3989,3990,3991,3992,3993,3994,3995,3996,3997,3998,3999,4000,4001,4002,4003,4004,4005,4006,4007,4008,4009,4010,4011,4012,4013,4014,4015,4016,4017,4018,4019,4020,4021,4022,4023,4024,4025,4026,4027,4028,4029,4030,4031,4032,4033,4034,4035,4036,4037,