mily_paths":[],"mentions":[{"id":"c-shiji-057-zhou:m005-0096","start":96,"end":98,"surface":"程縱","kind":"person","person_id":"hot_99a_5vc","status":"contextual_provisional","paragraph_id":"c-shiji-057-zhou:p005","chapter_id":"c-shiji-057-zhou"}],"relations":[],"title_holdings":[{"id":"th-shiji057-026","person_id":"hot_99a_5vc","title":"丞相","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-057-zhou","source_id":"s-shiji-057-zhou","paragraph_id":"c-shiji-057-zhou:p005","quote":"擊陳豨，屠馬邑。所將卒斬豨將軍乘馬絺。擊韓信、陳豨、趙利軍於樓煩，破之。得豨將宋最、鴈門守圂。因轉攻得雲中守遬、丞相箕肆、將勳。定鴈門郡十七縣，雲中郡十二縣。因復擊豨靈丘，破之，斬豨，得豨丞相程縱、將軍陳武、都尉高肆。定代郡九縣。"}],"attestations":[{"id":"th-shiji057-026:a001","paragraph_id":"c-shiji-057-zhou:p005","start":94,"end":96,"surface":"丞相","person_mention_id":"c-shiji-057-zhou:m005-0096","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授官、爵秩、追稱、承爵與一般用稱分存；相對年數按原段，不換算公曆或推定所有官爵同時終止。未知官員姓名與制度性質不補。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji057-027","person_id":"hot_99a_5vc","surfaces":["程縱"],"scope":"same_chapter","chapter_ids":["c-shiji-057-zhou"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-057-zhou:p005","quote":"擊陳豨，屠馬邑。所將卒斬豨將軍乘馬絺。擊韓信、陳豨、趙利軍於樓煩，破之。得豨將宋最、鴈門守圂。因轉攻得雲中守遬、丞相箕肆、將勳。定鴈門郡十七縣，雲中郡十二縣。因復擊豨靈丘，破之，斬豨，得豨丞相程縱、將軍陳武、都尉高肆。定代郡九縣。"}],"rationale":"按明示姓名、軍事近接、父子承爵與局部皇帝敘事暫接。周勃和勝之的絳侯分開，亞夫條侯與平曲支不混；代地韓信依韓王信近接而不接淮陰侯。未名人物、單名官員不補姓，校勘字不作定本，相術預言不作史實已驗。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-057-zhou:p005","text":"擊陳豨，屠馬邑。所將卒斬豨將軍乘馬絺。擊韓信、陳豨、趙利軍於樓煩，破之。得豨將宋最、鴈門守圂。因轉攻得雲中守遬、丞相箕肆、將勳。定鴈門郡十七縣，雲中郡十二縣。因復擊豨靈丘，破之，斬豨，得豨丞相程縱、將軍陳武、都尉高肆。定代郡九縣。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mention