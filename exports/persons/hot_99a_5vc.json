,"surface":"豨","kind":"person","person_id":"1xx_s1v_svn","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m005-0090","start":90,"end":91,"surface":"豨","kind":"person","person_id":"1xx_s1v_svn","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m005-0093","start":93,"end":94,"surface":"豨","kind":"person","person_id":"1xx_s1v_svn","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m005-0096","start":96,"end":98,"surface":"程縱","kind":"person","person_id":"hot_99a_5vc","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m005-0101","start":101,"end":103,"surface":"陳武","kind":"person","person_id":"r4z_qa6_vhk","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m005-0106","start":106,"end":108,"surface":"高肆","kind":"person","person_id":"25f_g5k_wae","status":"contextual_provisional"}],"chapter_id":"c-shiji-057-zhou","book_id":"b-shiji-057","work_id":"w-shiji","source_id":"s-shiji-057-zhou"},{"id":"c-shiji-095-fankuang:p013","text":"項羽既已死，漢王為帝。其秋，燕王臧荼反，商以將軍從擊荼，戰龍脫，先登陷陣，破荼軍易下，卻敵，遷為右丞相，賜爵列侯，與諸侯剖符，世世勿絕，食邑涿五千戶，號曰涿侯。以右丞相別定上谷，因攻代，受趙相國印。以右丞相趙相國別與絳侯等定代、鴈門，得代丞相程縱、守相郭同、將軍已下至六百石十九人。還，以將軍為太上皇衛一歲七月。以右丞相擊陳豨，殘東垣。又以右丞相從高帝擊黥布，攻其前拒，陷兩陳，得以破布軍，更食曲周五千一百戶，除前所食，凡別破軍三，降定郡六，縣七十三，得丞相、守相、大將各一人，小將二人，二千石已下至六百石十九人。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m013-0000","start":0,"end":2,"surface":"項羽","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m013-0006","start":6,"end":8,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m013-0016","start":16,"end":18,"surface":"臧荼","kind":"person","person_id":"xaa_ewn_4ro","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m013-0020","start":20,"end":21,"surface":"商","kind":"person","person_id":"xny_prn_zyi","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m013-0026","start":26,"end":27,"surface"