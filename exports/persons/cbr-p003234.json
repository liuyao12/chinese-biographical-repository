{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003234","canonical_person_id":"afy_rj9_84r","id_aliases":["cbr-p003234"],"identity_policy":"contextual_provisional","person_ids":["afy_rj9_84r"],"persons":[{"id":"afy_rj9_84r","label":"秦皇帝（齊悼惠王世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"秦皇帝","mention_ids":["c-shiji-052-qidaohui:m016-0113"]}],"evidence":[{"mention_id":"c-shiji-052-qidaohui:m016-0113","chapter_id":"c-shiji-052-qidaohui","paragraph_id":"c-shiji-052-qidaohui:p016","quote":"秦皇帝"}],"id_aliases":["cbr-p003234"]}],"source_mention_summary":[{"source_id":"s-shiji-052-qidaohui","work_id":"w-shiji","book_id":"b-shiji-052","chapter_id":"c-shiji-052-qidaohui","mention_count":1,"mention_ids":["c-shiji-052-qidaohui:m016-0113"],"paragraph_ids":["c-shiji-052-qidaohui:p016"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-052-qidaohui"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-052-qidaohui:m016-0113","start":113,"end":116,"surface":"秦皇帝","kind":"person","person_id":"afy_rj9_84r","status":"contextual_provisional","paragraph_id":"c-shiji-052-qidaohui:p016","chapter_id":"c-shiji-052-qidaohui"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji052-021","person_id":"afy_rj9_84r","surfaces":["秦皇帝"],"scope":"same_chapter","chapter_ids":["c-shiji-052-qidaohui"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-052-qidaohui:p016","quote":"灌嬰在滎陽，聞魏勃本教齊王反，既誅呂氏，罷齊兵，使使召責問魏勃。勃曰：「失火之家，豈暇先言大人而後救火乎！」因退立，股戰而栗，恐不能言者，終無他語。灌將軍熟視笑曰：「人謂魏勃勇，妄庸人耳，何能為乎！」乃罷魏勃。魏勃父以善鼓琴見秦皇帝。及魏勃少時，欲求見齊相曹參，家貧無以自通，乃常獨早夜埽齊相舍人門外。相舍人怪之，以為物，而伺之，得勃。勃曰：「願見相君，無因，故為子埽，欲以求見。」於是舍人見勃曹參，因以為舍人。一為參御，言事，參以為賢，言之齊悼惠王。悼惠王召見，則拜為內史。始，悼惠王得自置二千石。及悼惠王卒而哀王立，勃用事，重於齊相。"}],"rationale":"依明示名與王國、世次的局部敘事暫接；齊、城陽與菑川同諡者分開，興居與志分開。校勘建延及內史勳士未擅選讀法，未名帝后不補姓名，案件只保存來源敘事。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-052-qidaohui:p016","text":"灌嬰在滎陽，聞魏勃本教齊王反，既誅呂氏，罷齊兵，使使召責問魏勃。勃曰：「失火之家，豈暇先言大人而後救火乎！」因退立，股戰而栗，恐不能言者，終無他語。灌將軍熟視笑曰：「人謂魏勃勇，妄庸人耳，何能為乎！」乃罷魏勃。魏勃父以善鼓琴見秦皇帝。及魏勃少時，欲求見齊相曹參，家貧無以自通，乃常獨早夜埽齊相舍人門外。相舍人怪之，以為物，而伺之，得勃。勃曰：「願見相君，無因，故為子埽，欲以求見。」於是舍人見勃曹參，因以為舍人。一為參御，言事，參以為賢，言之齊悼惠王。悼惠王召見，則拜為內史。始，悼惠王得自置二千石。及悼惠王卒而哀王立，勃用事，重於齊相。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-052-qidaohui:m016-0000","start":0,"end":2,"surface":"灌嬰","kind":"person","person_id":"ju6_1ic_2zu","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m016-0007","start":7,"end":9,"surface":"魏勃","kind":"person","person_id":"wse_abc_uqy","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m016-0011","start":11,"end":13,"surface":"齊王","kind":"person","person_id":"byp_ks5_71a_AA","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m016-0029","start":29,"end":31,"surface":"魏勃","kind":"person","person_id":"wse_abc_uqy","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m016-0032","start":32,"end":33,"surface":"勃","kind":"person","person_id":"wse_abc_uqy","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m016-0074","start":74,"end":77,"surface":"灌將軍","kind":"person","person_id":"ju6_1ic_2zu","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m016-0085","start":85,"end":87,"surface":"魏勃","kind":"person","person_id":"wse_abc_uqy","status":"contextual_provisional"},{"id":"c-shiji-052-qidaohui:m016-0102","start":102,"end":104,"surface":"魏勃","kin