廙為輔國將軍，加散騎常侍。以母喪去職。服闋，拜征虜將軍，進左衛將軍。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-076-wangyi-family:p002:m0002","start":2,"end":4,"surface":"王敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0006","start":6,"end":8,"surface":"陶侃","kind":"person","person_id":"twd_erg_kmz","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0010","start":10,"end":11,"surface":"廙","kind":"person","person_id":"7r6_k52_qji_ABDA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0018","start":18,"end":20,"surface":"馬俊","kind":"person","person_id":"0w5_r48_tfo","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0021","start":21,"end":23,"surface":"鄭攀","kind":"person","person_id":"200_oqy_d7c","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0028","start":28,"end":29,"surface":"侃","kind":"person","person_id":"twd_erg_kmz","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0030","start":30,"end":31,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0034","start":34,"end":35,"surface":"廙","kind":"person","person_id":"7r6_k52_qji_ABDA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0036","start":36,"end":37,"surface":"俊","kind":"person","person_id":"0w5_r48_tfo","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0047","start":47,"end":49,"surface":"杜曾","kind":"person","person_id":"4vd_pg5_o8x","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0050","start":50,"end":51,"surface":"俊","kind":"person","person_id":"0w5_r48_tfo","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0052","start":52,"end":53,"surface":"攀","kind":"person","person_id":"200_oqy_d7c","status":"contextual_provisio