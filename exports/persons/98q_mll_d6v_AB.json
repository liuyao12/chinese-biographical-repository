":"豐城公","person_mention_id":"c-nanqishu-049-zhangchong:p004:m0025","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-049","chapter_id":"c-nanqishu-049-zhangchong","source_id":"s-nanqishu-049-zhangchong-ws2261984","paragraph_id":"c-nanqishu-049-zhangchong:p004","quote":"其年，遷廬陵王北中郎司馬、加冠軍將軍。未拜，豐城公遙昌爲豫州，上慮寇難未已，徙沖爲征虜長史、南梁郡太守。永泰元年，除江夏王前軍長史。東昏卽位，出爲建安王征虜長史、輔國將軍、江夏內史，行郢州府州事。永元元年，遷持節、督豫州軍事、豫州刺史，代裴叔業。竟不行。明年，遷督南兖兖徐青冀五州、輔國將軍、南兖州刺史，持節如故。會司州刺史申希祖卒，以沖爲督司州軍事、冠軍將軍、司州刺史。裴叔業以壽春降虜，又遷沖爲督南兖兖徐青冀五州、南兖州刺史，持節、將軍如故。竝未拜。崔慧景事平，徵建安王寶夤還都，以沖爲督郢司二州、郢州刺史，持節、將軍如故。一歲之中，頻授四州，至此受任。其冬，進征虜將軍。封定襄侯，食邑千戶。","person_mention_id":"c-nanqishu-049-zhangchong:p004:m0025"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"person_references":[{"id":"c-nanqishu-049-zhangchong:p004:r0022","paragraph_id":"c-nanqishu-049-zhangchong:p004","start":22,"end":25,"surface":"豐城公","person_id":"98q_mll_d6v_AB","referent_role":"third_person","quote":"豐城公遙昌","note":"依句內語法、說話對象及本段承接辨識。","chapter_id":"c-nanqishu-049-zhangchong","book_id":"b-nanqishu-049","work_id":"w-nanqishu","source_id":"s-nanqishu-049-zhangchong-ws2261984"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-028-peisui-complete:p002","text":"邃十歲能屬文，善《左氏春秋》。齊建武初，刺史蕭遙昌引爲府主簿。壽陽有八公山廟，遙昌爲立碑，使邃爲文，甚見稱賞。舉秀才，對策高第，奉朝請。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":14,"last_line":14,"raw_start":427,"raw_end":499,"raw_character_offsets":[427,428,429,430,431,432,433,434,435,438,439,440,441,444,445,446,447,448,449,450,451,452,453,454,455,456,457,458,459,460,461,462,463,464,465,466,467,468,469,470,471,472,473,474,475,476,477,478,479,480,481,482,483,484,485,486,487,488,489,490,491,492,493,494,495,496,497,498],"revision_id":1511902},"mentions":[{"id":"c-liangshu-028-peisui-complete:p002:m0000","start":0,"end":1,"surface":"邃","kind":"person","person_id":"vtp_lo9_0af","status":"contextual_provisional"},{"id":"c-liangshu-028-peisui-complete:p002:m0022","start":22,"end":25,"surface":"蕭遙昌","kind":"person","person_id":"98q_mll_d6v_AB","status":"contextual_provisional"},{"id":"c-liangshu-028-peisui-complete:p002:m0039","start":39,"end":41,"surface":"遙昌","kind":"person","person_id":"98q_mll_d6v_AB","status":"contextual_provisional"},{"id":"c-liangshu-028-peisui-complete:p002:m0046","start":46,"end":47,"surface":"邃","kind":"person","person_id":"vtp_lo9_0af","status":"contextual_provisional"}],"chapter_id":"c-liangshu-028-peisui-complete","book_id":"b-liangshu-028","work_id":"w-liangshu","source_id":"s-liangshu-028-peisui-complete-ws1511902"},{"id":"c-nanqishu-044-shenwenji-complete:p012","text":"　　明帝卽位，加領太子詹事，增邑五百戶。尚書令王晏嘗戲文季爲吳興僕射。文季答曰：「琅邪執法，似不出卿門。」尋加散騎常侍，僕射如故。建武二年，虜寇壽春，豫州刺史豐城公遙昌嬰城固守，數遣輕兵相抄擊，明帝以爲憂，詔文季領兵鎮壽春。文季入城，止游兵不聽出，洞開城門，嚴加備守，虜軍尋退，百姓無所傷損。增封爲千九百戶。尋加護軍將軍，僕射、常侍如故。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":53,"last_line":53,"raw_start":4462,"raw_end":4638,"raw_character_offsets":[4462,4463,4464,4465,4466,4467,4468,4469,4470,4471,4472,4473,4474,4475,4476,4477,4478,4479,4480,4481,4482,4483,4484,4485,4486,4487,4488,4489,4490,4491,4492,4493,4494,4495,4496,4497,4498,4499,4500,4501,4502,4503,4504,4505,4506,4507,4508,4509,4510,4511,4512,4513,4514,4515,4516,4517,4518,4519,4520,4521,4522,4523,4524,4525,4526,4532,4533,4534,4535,4538,4539,4540,4541,4542,4543,4544,4545,4546,4547,4548,4549,4550,4551,4552,4553,4554,4555,4556,4557,4558,4559,4560,4561,4562,4563,4564,4565,4566,4567,4568,4569,4570,4571,4572,4573,4574,4575,4576,4577,4578,4579,4580,4581,4582,4583,4584,4585,4586,4587,4588,4589,4590,4591,4592,4593,4594,4595,4596,