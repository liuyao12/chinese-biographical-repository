raph_ids":["c-jinshu-033-wanglan-family:p002","c-jinshu-033-wanglan-family:p003","c-jinshu-033-wanglan-family:p004"],"table_cell_ids":[],"passage_count":3}],"most_mentioned_source_ids":["s-jinshu-033-wanglan-family"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jinshu033-wang-004","subject_person_id":"7r6_k52_qji_AA","predicate":"stepmother","object_person_id":"p8y_56i_5gn","status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-033","source_id":"s-jinshu-033-wanglan-family","chapter_id":"c-jinshu-033-wanglan-family","paragraph_id":"c-jinshu-033-wanglan-family:p002","quote":"祥性至孝。早喪親，繼母朱氏不慈，數譖之，由是失愛於父。每使掃除牛下，祥愈恭謹。父母有疾，衣不解帶，湯藥必親嘗。母常欲生魚，時天寒冰凍，祥解衣將剖冰求之，冰忽自解，雙鯉躍出，持之而歸。母又思黃雀灸，復有黃雀數十飛入其幕，復以供母。鄕里驚歎，以爲孝感所致焉。有丹柰結實，母命守之，每風雨，祥輒抱樹而泣。其篤孝純至如此。"}],"qualifiers":{"source_term":"繼母"},"interpretation_note":"按本傳原句及具名人物語境保存；不填未載年歲、共同生母或絕對排行。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"a-jinshu033-wang-005","subject_person_id":"7r6_k52_qji_AB","predicate":"mother","object_person_id":"p8y_56i_5gn","status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-033","source_id":"s-jinshu-033-wanglan-family","chapter_id":"c-jinshu-033-wanglan-family","paragraph_id":"c-jinshu-033-wanglan-family:p004","quote":"覽字玄通。母朱，遇祥無道。覽年數歲，見祥被楚撻，輒涕泣抱持。至於成童，每諫其母，其母少止凶虐。朱屢以非理使祥，覽輒與祥俱。又虐使祥妻，覽妻亦趨而共之。朱患之，乃止。祥喪父之後，漸有時譽。朱深疾之，密使鴆祥。覽知之，徑起取酒。祥疑其有毒，爭而不與，朱遽奪反之。自後朱賜祥饌，覽輒先嘗。朱懼覽致斃，遂止。"}],"qualifiers":{"source_term":"母朱"},"interpretation_note":"按本傳原句及具名人物語境保存；不填未載年歲、共同生母或絕對排行。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"a-jinshu033-wang-006","subject_person_id":"p8y_56i_5gn","predicate":"spouse","object_person_id":"7r6_k52_qji_A","status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-033","source_id":"s-jinshu-033-wanglan-family","chapter_id":"c-jinshu-033-wanglan-family","paragraph_id":"c-jinshu-033-wanglan-family:p002","quote":"祥性至孝。早喪親，繼母朱氏不慈，數譖之，由是失愛於父。每使掃除牛下，祥愈恭謹。父母有疾，衣不解帶，湯藥必親嘗。母常欲生魚，時天寒冰凍，祥解衣將剖冰求之，冰忽自解，雙鯉躍出，持之而歸。母又思黃雀灸，復有黃雀數十飛入其幕，復以供母。鄕里驚歎，以爲孝感所致焉。有丹柰結實，母命守之，每風雨，祥輒抱樹而泣。其篤孝純至如此。"}],"qualifiers":{"source_term":"繼母"},"interpretation_note":"繼母朱氏與本段父承王祥父融，保存繼母的婚姻角色，不改為王祥生母；婚期、是否原配及朱氏本名均未知。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"person_id":"p8y_56i_5gn","title":null,"surname":"朱","ming":null,"additional_names":[],"work_id":"w-jinshu","book_id":"b-jinshu-033","chapter_id":"c-jinshu-033-wanglan-family","source_id":"s-jinshu-033-wanglan-family","paragraph_id":"c-jinshu-033-wanglan-family:p002","quote":"祥性至孝。早喪親，繼母朱氏不慈，數譖之，由是失愛於父。每使掃除牛下，祥愈恭謹。父母有疾，衣不解帶，湯藥必親嘗。母常欲生魚，時天寒冰凍，祥解衣將剖冰求之，冰忽自解，雙鯉躍出，持之而歸。母又思黃雀灸，復有黃雀數十飛入其幕，復以供母。鄕里驚歎，以爲孝感所致焉。有丹柰結實，母命守之，每風雨，祥輒抱樹而泣。其篤孝純至如此。","note":"姓名與字分開；同一家世單名依王姓傳主及親屬語境暫分，不把字當本名。頂部稱號為辨認用稱，不表示所有時點均有效。","status":"editorial_provisional","human_reviewed":false,"model":null,"clan_style":{"kind":"received_clan_appellation","value":"朱氏","source_term":"朱氏","assertion_ids":[],"status":"source_attested","rationale":"原文朱氏，本名未知；對王覽是母，對王祥是繼母。","human_reviewed":false}}],"life_events":[{"id":"le-jinshu033-wang-zhu-death","person_id":"p8y_56i_5gn","event_type":"death","status":"source_attested","date_expression":null,"source_term":"母終","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-033","source_id":"s-jinshu-033-wanglan-family","chapter_id":"c-jinshu-033-wanglan-family","paragraph_id":"c-jinshu-033-wanglan-family:p003","person_mention_id":"c-jinshu-033-wanglan-family:p003:m0006","quote":"漢未遭亂，扶母攜弟覽避地廬江，隱居三十餘年，不應州郡之命。母終，居喪毀瘁，杖而後起。徐州刺史呂虔檄爲別駕，祥年垂耳順，固辭不受。覽勸之，爲具車牛，祥乃應召，虔委以州事。於時寇盜充斥，祥率勵兵士，頻討破之。州界清靜，政化大行。時人歌之曰：「海沂之康，實賴王祥。邦國不空，別駕之功。」"}],"interpretation_note":"原文喪父或母終記死亡；父承王祥父融，母承前述繼母朱氏。未記年份不補，附傳回顧幼年不按段落順序強排日期。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-jinshu-033-wanglan-family:p002:m0011","start":11,"end":13,"surface":"朱氏","kind":"person","person_id":"p8y_56i_5gn","status":"contextual_provisional","paragraph_id":"c-jinshu-033-wanglan-family:p002","chapter_id":"c-jinshu-033-wanglan-family"},{"id":"c-jinshu-033-wanglan-family:p002:m0055","start":55,"end":56,"surface":"母","kind":"person","person_id":"p8y_56i_5gn","status":"contextual_provisional","paragraph_id":"c-jinshu-033-wanglan-family:p002","chapter_id":"c-jinshu-033-wanglan-family"},{"id":"c-jinshu-033-wanglan-family:p002:m0091","start":91,"end":92,"surface":"母","kind":"person","person_id":"p8y_56i_5gn","status":"contextual_provisional","paragraph_id":"c-jinshu-033-wanglan-family:p002","chapter_id":"c-jinshu-033-wanglan-family"},{"id":"c-jinshu-033-wanglan-family:p002:m0112","start":112,"end":113,"surface":"母","kind":"person","person_id":"p8y_56i_5gn","status":"contextual_provisional","paragraph_id":"c-jinshu-033-wanglan-family:p002","chapter_id":"c-jinshu-033-wanglan-family"},{"id":"c-jinshu-033-wanglan-family:p002:m0133","start":133,"end":134,"surface":"母","kind":"person","person_id":"p8y_56i_5gn","status":"contextual_provisional","paragraph_id":"c-jinshu-033-wanglan-family:p002","chapter_id":"c-jinshu-033-wanglan-family"},{"id":"c-jinshu-033-wanglan-family:p003:m0006","start":6,"end":7,"surface":"母","kind":"person","person_id":"p8y_56i_5gn","status":"contextual_provisional","paragraph_id":"c-jinshu-033-wanglan-family:p003","chapter_id":"c-jinshu-033-wanglan-family"},{"id":"c-jinshu-033-wanglan-family:p003:m0029","start":29,"end":30,"surface":"母","kind":"person","person_id":"p8y_56i_5gn","status":"contextual_provisional","paragraph_id":"c-jinshu-033-wanglan-family:p003","chapter_id":"c-jinshu-033-wanglan-family"},{"id":"c-jinshu-033