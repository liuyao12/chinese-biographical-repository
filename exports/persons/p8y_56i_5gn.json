hu-033-wanglan-family:p004:m0131","start":131,"end":132,"surface":"朱","kind":"person","person_id":"p8y_56i_5gn","status":"contextual_provisional","paragraph_id":"c-jinshu-033-wanglan-family:p004","chapter_id":"c-jinshu-033-wanglan-family"},{"id":"c-jinshu-033-wanglan-family:p004:m0141","start":141,"end":142,"surface":"朱","kind":"person","person_id":"p8y_56i_5gn","status":"contextual_provisional","paragraph_id":"c-jinshu-033-wanglan-family:p004","chapter_id":"c-jinshu-033-wanglan-family"}],"relations":[{"id":"a-jinshu033-wang-004","subject_person_id":"7r6_k52_qji_AA","predicate":"stepmother","object_person_id":"p8y_56i_5gn","status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-033","source_id":"s-jinshu-033-wanglan-family","chapter_id":"c-jinshu-033-wanglan-family","paragraph_id":"c-jinshu-033-wanglan-family:p002","quote":"祥性至孝。早喪親，繼母朱氏不慈，數譖之，由是失愛於父。每使掃除牛下，祥愈恭謹。父母有疾，衣不解帶，湯藥必親嘗。母常欲生魚，時天寒冰凍，祥解衣將剖冰求之，冰忽自解，雙鯉躍出，持之而歸。母又思黃雀灸，復有黃雀數十飛入其幕，復以供母。鄕里驚歎，以爲孝感所致焉。有丹柰結實，母命守之，每風雨，祥輒抱樹而泣。其篤孝純至如此。"}],"qualifiers":{"source_term":"繼母"},"interpretation_note":"按本傳原句及具名人物語境保存；不填未載年歲、共同生母或絕對排行。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"a-jinshu033-wang-005","subject_person_id":"7r6_k52_qji_AB","predicate":"mother","object_person_id":"p8y_56i_5gn","status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-033","source_id":"s-jinshu-033-wanglan-family","chapter_id":"c-jinshu-033-wanglan-family","paragraph_id":"c-jinshu-033-wanglan-family:p004","quote":"覽字玄通。母朱，遇祥無道。覽年數歲，見祥被楚撻，輒涕泣抱持。至於成童，每諫其母，其母少止凶虐。朱屢以非理使祥，覽輒與祥俱。又虐使祥妻，覽妻亦趨而共之。朱患之，乃止。祥喪父之後，漸有時譽。朱深疾之，密使鴆祥。覽知之，徑起取酒。祥疑其有毒，爭而不與，朱遽奪反之。自後朱賜祥饌，覽輒先嘗。朱懼覽致斃，遂止。"}],"qualifiers":{"source_term":"母朱"},"interpretation_note":"按本傳原句及具名人物語境保存；不填未載年歲、共同生母或絕對排行。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"a-jinshu033-wang-006","subject_person_id":"p8y_56i_5gn","predicate":"spouse","object_person_id":"7r6_k52_qji_A","status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-033","source_id":"s-jinshu-033-wanglan-family","chapter_id":"c-jinshu-033-wanglan-family","paragraph_id":"c-jinshu-033-wanglan-family:p002","quote":"祥性至孝。早喪親，繼母朱氏不慈，數譖之，由是失愛於父。每使掃除牛下，祥愈恭謹。父母有疾，衣不解帶，湯藥必親嘗。母常欲生魚，時天寒冰凍，祥解衣將剖冰求之，冰忽自解，雙鯉躍出，持之而歸。母又思黃雀灸，復有黃雀數十飛入其幕，復以供母。鄕里驚歎，以爲孝感所致焉。有丹柰結實，母命守之，每風雨，祥輒抱樹而泣。其篤孝純至如此。"}],"qualifiers":{"source_term":"繼母"},"interpretation_note":"繼母朱氏與本段父承王祥父融，保存繼母的婚姻角色，不改為王祥生母；婚期、是否原配及朱氏本名均未知。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"title_holdings":[],"address_assertions":[{"id":"pa-jinshu033-lujiang-3","person_id":"p8y_56i_5gn","relation":"migration_destination","place":{"source_name":"廬江","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"source_term":"避地廬江","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-033","source_id":"s-jinshu-033-wanglan-family","chapter_id":"c-jinshu-033-wanglan-family","paragraph_id":"c-jinshu-033-wanglan-family:p003","person_mention_id":"c-jinshu-033-wanglan-family:p003:m0006","quote":"漢未遭亂，扶母攜弟覽避地廬江，隱居三十餘年，不應州郡之命。母終，居喪毀瘁，杖而後起。徐州刺史呂虔檄爲別駕，祥年垂耳順，固辭不受。覽勸之，爲具車牛，祥乃應召，虔委以州事。於時寇盜充斥，祥率勵兵士，頻討破之。州界清靜，政化大行。時人歌之曰：「海沂之康，實賴王祥。邦國不空，別駕之功。」"}],"interpretation_note":"扶母攜弟覽避地廬江的同行人物，分錄遷居目的地，不作出生地或傳首籍貫。漢未原字未修，未知確年不填。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-jinshu033-zhu-stepmother-and-mother","person_id":"p8y_56i_5gn","surfaces":["朱氏","朱","母"],"scope":"same_chapter","chapter_ids":["c-jinshu-033-wanglan-family"],"status":"contextual_provisional","confidence_level":"high","identification_basis":{"kind":"source_context","target_mention_ids":["c-jinshu-033-wanglan-family:p002:m0011","c-jinshu-033-wanglan-family:p002:m0055","c-jinshu-033-wanglan-family:p002:m0091","c-jinshu-033-wanglan-family:p002:m0112","c-jinshu-033-wanglan-family:p002:m0133","c-jinshu-033-wanglan-family:p003:m0006","c-jinshu-033-wanglan-family:p003:m0029","c-jinshu-033-wanglan-family:p004:m0005","c-jinshu-033-wanglan-family:p004:m0006","c-jinshu-033-wanglan-family:p004:m0038","c-jinshu-033-wanglan-family:p004:m0041","c-jinshu-033-wanglan-family:p004:m0047","c-jinshu-033-wanglan-family:p004:m0075","c-jinshu-033-wanglan-family:p004:m0093","c-jinshu-033-wanglan-family:p004:m0123","c-jinshu-033-wanglan-family:p004:m0131","c-jinshu-033-wanglan-family:p004:m0141"]},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-033","source_id":"s-jinshu-033-wanglan-family","chapter_id":"c-jinshu-033-wanglan-family","paragraph_id":"c-jinshu-033-wanglan-family:p002","quote":"祥性至孝。早喪親，繼母朱氏不慈，數譖之，由是失愛於父。每使掃除牛下，祥愈恭謹。父母有疾，衣不解帶，湯藥必親嘗。母常欲生魚，時天寒冰凍，祥解衣將剖冰求之，冰忽自解，雙鯉躍出，持之而歸。母又思黃雀灸，復有黃雀數十飛入其幕，復以供母。鄕里驚歎，以爲孝感所致焉。有丹柰結實，母命守之，每風雨，祥輒抱樹而泣。其篤孝純至如此。"},{"work_id":"w-jinshu","book_id":"b-jinshu-033","source_id":"s-jinshu-033-wanglan-family","chapter_id":"c-jinshu-033-wanglan-family","paragraph_id":"c-jinshu-033-wanglan-family:p003","quote":"漢未遭亂，扶母攜弟覽避地廬江，隱居三十餘年，不應州郡之命。母終，居喪毀瘁，杖而後起。徐州刺史呂虔檄爲別駕，祥年垂耳順，固辭不受。覽勸之，爲具車牛，祥乃應召，虔委以州事。於時寇盜充斥，祥率勵兵士，頻討破之。州界清靜，政化大行。時人歌之曰：「海沂之康，實賴王祥。邦國不空，別駕之功。」"},{"work_id":"w-jinshu","book_id":"b-jinshu-033","source_id":"s-jinshu-033-wanglan-family","chapter_id":"c-jinshu-033-wanglan-family","paragraph_id":"c-jinshu-033-wanglan-family:p004","quote":"覽字玄通。母朱，遇祥無道。覽年數歲，見祥被楚撻，輒涕泣抱持。至於成童，每諫其母，其母少止凶虐。朱屢以非理使祥，覽輒與祥俱。又虐使祥妻，覽妻亦趨而共之。朱患之，乃止。祥喪父之後，漸有時譽。朱深疾之，密使鴆祥。覽知之，徑起取酒。祥疑其有毒，爭而不與，朱遽奪反之。自後朱賜祥饌，覽輒先嘗。朱懼覽致斃，遂止。"}],"rationale":"王祥傳繼母朱氏，王覽附傳母朱；相同兄弟家庭及虐祥、覽勸止的敘事交叉，同一朱氏對兩兄弟的角色分開。王祥傳母終後，附傳回顧幼年仍述母在世，不按段落順序造第二朱氏或捏造年代。","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-033-wanglan-family:p002","text":"祥性至孝。早喪親，繼母朱氏不慈，數譖之，由是失愛於父。每使掃除牛下，祥愈恭謹。父母有疾，衣不解帶，湯藥必親嘗。母常欲生魚，時天寒冰凍，祥解衣將剖冰求之，冰忽自解，雙鯉躍出，持之而歸。母又思黃雀灸，復有黃雀數十飛入其幕，復以供母。鄕里驚歎，以爲孝感所致焉。有丹柰結實，母命守之，每風雨，祥輒抱樹而泣。其篤孝純至如此。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-033-wanglan-family:p002:m0000","start":0,"end":1,"surface":"祥","kind":"person","person_id":"7r6_k52_qji_AA","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p002:m0011","start":11,"end":13,"surface":"朱氏","kind":"person","person_id":"p8y_56i_5gn","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p002:m0025","start":25,"end":26,"surface":"父","kind":"person","person_id":"7r6_k52_qji_A","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p002:m0034","start":34,"end":35,"surface":"祥","kind":"person","person_id":"7r6_k52_qji_AA","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p002:m0039","start":39,"end":41,"surface":"父母","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"父及本段繼母的合稱，非一個人物，不把繼母朱氏改作王祥生母。"},{"id":"c-jinshu-033-wanglan-family:p002:m0055","start":55,"end":56,"surface":"母","kind":"person","person_id":"p8y_56i_5gn","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p002:m0067","start":67,"end":68,"surface":"祥","kind":"person","person_id":"7r6_k52_qji_AA","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p002:m0091","start":91,"end":92,"surface":"母","kind":"person","person_id":"p8y_56i_5gn","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p002:m0112","start":112,"end":113,"surface":"母","kind":"person","person_id":"p8y_56i_5gn","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p002:m0133","start":133,"end":134,"surface":"母","kind":"person","person_id":"p8y_56i_5gn","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p002:m0142","start":142,"end":143,"surface":"祥","kind":"person","person_id":"7r6_k52_qji_AA","status":"contextual_provisional"}],"source_position":{"first_line":16,"last_line":17,"revision_id":2650519,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-033-wanglan-family","book_id":"b-jinshu-033","work_id":"w-jinshu","source_id":"s-jinshu-033-wanglan-family"},{"id":"c-jinshu-033-wanglan-family:p003","text":"漢未遭亂，扶母攜弟覽避地廬江，隱居三十餘年，不應州郡之命。母終，居喪毀瘁，杖而後起。徐州刺史呂虔檄爲別駕，祥年垂耳順，固辭不受。覽勸之，爲具車牛，祥乃應召，虔委以州事。於時寇盜充斥，祥率勵兵士，頻討破之。州界清靜，政化大行。時人歌之曰：「海沂之康，實賴王祥。邦國不空，別駕之功。」","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-033-wanglan-family:p003:m0006","start":6,"end":7,"surface":"母","kind":"person","person_id":"p8y_56i_5gn","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p003:m0009","start":9,"end":10,"surface":"覽","kind":"person","person_id":"7r6_k52_qji_AB","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p003:m0029","start":29,"end":30,"surface":"母","kind":"person","person_id":"p8y_56i_5gn","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p003:m0046","start":46,"end":48,"surface":"呂虔","kind":"person","person_id":"kwp_npr_9ix","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p003:m0053","start":53,"end":54,"surface":"祥","kind":"person","person_id":"7r6_k52_qji_AA","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p003:m0064","start":64,"end":65,"surface":"覽","kind":"person","person_id":"7r6_k52_qji_AB","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p003:m0073","start":73,"end":74,"surface":"祥","kind":"person","person_id":"7r6_k52_qji_AA","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p003:m0078","start":78,"end":79,"surface":"虔","kind":"person","person_id":"kwp_npr_9ix","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p003:m0091","start":91,"end":92,"surface":"祥","kind":"person","person_id":"7r6_k52_qji_AA","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p003:m0127","start":127,"end":128,"surface":"祥","kind":"person","person_id":"7r6_k52_qji_AA","status":"contextual_provisional"}],"source_position":{"first_line":18,"last_line":19,"revision_id":2650519,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-033-wanglan-family","book_id":"b-jinshu-033","work_id":"w-jinshu","source_id":"s-jinshu-033-wanglan-family"},{"id":"c-jinshu-033-wanglan-family:p004","text":"覽字玄通。母朱，遇祥無道。覽年數歲，見祥被楚撻，輒涕泣抱持。至於成童，每諫其母，其母少止凶虐。朱屢以非理使祥，覽輒與祥俱。又虐使祥妻，覽妻亦趨而共之。朱患之，乃止。祥喪父之後，漸有時譽。朱深疾之，密使鴆祥。覽知之，徑起取酒。祥疑其有毒，爭而不與，朱遽奪反之。自後朱賜祥饌，覽輒先嘗。朱懼覽致斃，遂止。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-033-wanglan-family:p004:m0000","start":0,"end":1,"surface":"覽","kind":"person","person_id":"7r6_k52_qji_AB","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p004:m0002","start":2,"end":4,"surface":"玄通","kind":"person","person_id":"7r6_k52_qji_AB","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p004:m0005","start":5,"end":6,"surface":"母","kind":"person","person_id":"p8y_56i_5gn","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p004:m0006","start":6,"end":7,"surface":"朱","kind":"person","person_id":"p8y_56i_5gn","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p004:m0009","start":9,"end":10,"surface":"祥","kind":"person","person_id":"7r6_k52_qji_AA","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p004:m0013","start":13,"end":14,"surface":"覽","kind":"person","person_id":"7r6_k52_qji_AB","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p004:m0019","start":19,"end":20,"surface":"祥","kind":"person","person_id":"7r6_k52_qji_AA","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p004:m0038","start":38,"end":39,"surface":"母","kind":"person","person_id":"p8y_56i_5gn","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p004:m0041","start":41,"end":42,"surface":"母","kind":"person","person_id":"p8y_56i_5gn","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p004:m0047","start":47,"end":48,"surface":"朱","kind":"person","person_id":"p8y_56i_5gn","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p004:m0053","start":53,"end":54,"surface":"祥","kind":"person","person_id":"7r6_k52_qji_AA","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p004:m0055","start":55,"end":56,"surface":"覽","kind":"person","person_id":"7r6_k52_qji_AB","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p004:m0058","start":58,"end":59,"surface":"祥","kind":"person","person_id":"7r6_k52_qji_AA","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p004:m0064","start":64,"end":66,"surface":"祥妻","kind":"person","person_id":"5n0_ptc_2it","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p004:m0067","start":67,"end":69,"surface":"覽妻","kind":"person","person_id":"jmt_uha_exg","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p004:m0075","start":75,"end":76,"surface":"朱","kind":"person","person_id":"p8y_56i_5gn","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p004:m0082","start":82,"end":83,"surface":"祥","kind":"person","person_id":"7r6_k52_qji_AA","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p004:m0084","start":84,"end":85,"surface":"父","kind":"person","person_id":"7r6_k52_qji_A","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p004:m0093","start":93,"end":94,"surface":"朱","kind":"person","person_id":"p8y_56i_5gn","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p004:m0101","start":101,"end":102,"surface":"祥","kind":"person","person_id":"7r6_k52_qji_AA","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p004:m0103","start":103,"end":104,"surface":"覽","kind":"person","person_id":"7r6_k52_qji_AB","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p004:m0112","start":112,"end":113,"surface":"祥","kind":"person","person_id":"7r6_k52_qji_AA","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p004:m0123","start":123,"end":124,"surface":"朱","kind":"person","person_id":"p8y_56i_5gn","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p004:m0131","start":131,"end":132,"surface":"朱","kind":"person","person_id":"p8y_56i_5gn","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p004:m0133","start":133,"end":134,"surface":"祥","kind":"person","person_id":"7r6_k52_qji_AA","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p004:m0136","start":136,"end":137,"surface":"覽","kind":"person","person_id":"7r6_k52_qji_AB","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p004:m0141","start":141,"end":142,"surface":"朱","kind":"person","person_id":"p8y_56i_5gn","status":"contextual_provisional"},{"id":"c-jinshu-033-wanglan-family:p004:m0143","start":143,"end":144,"surface":"覽","kind":"person","person_id":"7r6_k52_qji_AB","status":"contextual_provisional"}],"source_position":{"first_line":39,"last_line":40,"revision_id":2650519,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-033-wanglan-family","book_id":"b-jinshu-033","work_id":"w-jinshu","source_id":"s-jinshu-033-wanglan-family"}],"sources":[{"chapter_id":"c-jinshu-033-wanglan-family","work_id":"w-jinshu","book_id":"b-jinshu-033","source_id":"s-jinshu-033-wanglan-family","source":{"title":"《晉書》卷三十三（數位選錄）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7033&oldid=2650519","permalink":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7033&oldid=2650519","revision_id":2650519,"accessed_on":"2026-10-18","extent":"王祥開篇三段及王覽完整附傳五段；不是全卷。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，未親核底本影像","response_sha256":"15791b8bdf731793ef02dbe27caed43b97631ae988fec2592c751dd3e7b5434a","wikitext_sha256":"2b422c350bf028f5d9b50e9791cc1b0caacd543dec80ad6fac445d99ae168721","normalization":{"character_conversion":{},"extraction_note":"去首部排版空白、展開連結顯示字、去單字-{字}-顯示語法、展開YL日期模板，不改漢未、乙太中大夫等見證原字；數位小標題不作正文證據。","excerpts":[{"proposed_paragraph_id":"c-jinshu-033-wanglan-family:p001","source_lines":[14,15],"raw_quote":"　　王祥，字休-{徵}-，琅邪臨沂人，漢諫議大夫吉之-{後}-也。祖仁，青州刺史。父融，公府-{辟}-不就。","raw_quote_sha256":"bbf3dd7ae2f5ab69161265874e14fa45662b17d748b0ed9dfb4277f51673ead8","selected_text_sha256":"2606dc497056559dfc79b2f4306effd4edc63587573a624f0c635c9a7f933c31","begin_anchor":"王祥，字休徵，琅邪臨沂人，漢諫","end_anchor":"，青州刺史。父融，公府辟不就。"},{"proposed_paragraph_id":"c-jinshu-033-wanglan-family:p002","source_lines":[16,17],"raw_quote":"　　祥性至孝。早喪親，繼母朱氏不慈，數譖之，由是失愛-{於}-父。每使掃除牛下，祥愈恭謹。父母有疾，衣不解帶，湯藥必親嘗。母常欲生魚，時天寒冰凍，祥解衣將剖冰求之，冰忽自解，雙鯉躍出，持之而歸。母又思黃雀灸，復有黃雀數十飛入其幕，復以供母。鄕里驚歎，以爲孝感所致焉。有丹柰結實，母命守之，每風雨，祥輒抱樹而泣。其篤孝純至如此。","raw_quote_sha256":"dc9ce1d26c53c2956277a237beac6ec091d02d12f4606c6b73b296e1bc2ed704","selected_text_sha256":"2c688093a5217867f6e7925af5ae73722c0240557d6321d8a26953b0a416c14d","begin_anchor":"祥性至孝。早喪親，繼母朱氏不慈","end_anchor":"祥輒抱樹而泣。其篤孝純至如此。"},{"proposed_paragraph_id":"c-jinshu-033-wanglan-family:p003","source_lines":[18,19],"raw_quote":"　　漢未遭亂，扶母攜弟覽避地廬江，隱居三十餘年，不應州郡之命。母終，居喪毀瘁，杖而-{後}-起。徐州刺史呂虔檄爲別駕，祥年垂耳順，固辭不受。覽勸之，爲具車牛，祥乃應召，虔委以州事。-{於}-時寇盜充斥，祥率勵兵士，頻討破之。州界清靜，政化大行。時人歌之曰：「海沂之康，實賴王祥。邦國不空，別駕之功。」","raw_quote_sha256":"be7909ef408ce89591e54a8b243d6e39e557934ae40e27ee69e51e7c14dd5fe7","selected_text_sha256":"49c4e1966467f962ddb1b0209c8b1574fc0e4528d48774c223f602768ad8c03f","begin_anchor":"漢未遭亂，扶母攜弟覽避地廬江，","end_anchor":"賴王祥。邦國不空，別駕之功。」"},{"proposed_paragraph_id":"c-jinshu-033-wanglan-family:p004","source_lines":[39,40],"raw_quote":"　　覽字玄通。母朱，遇祥無道。覽年數歲，見祥被楚撻，輒涕泣抱持。至-{於}-成童，每諫其母，其母少止凶虐。朱屢以非理使祥，覽輒與祥俱。又虐使祥妻，覽妻亦趨而共之。朱患之，乃止。祥喪父之-{後}-，漸有時譽。朱深疾之，密使鴆祥。覽知之，徑起取酒。祥疑其有毒，爭而不與，朱遽奪反之。自-{後}-朱賜祥饌，覽輒先嘗。朱懼覽致斃，遂止。","raw_quote_sha256":"64f4e0b8e61d56fdb63938babaa9bcfd88586084f2d432448f1ba052757a7b48","selected_text_sha256":"314bb9c6889d6f15a84853e4a5d0c19a45fb4b62c31e33688f473d06c21e4f8d","begin_anchor":"覽字玄通。母朱，遇祥無道。覽年","end_anchor":"，覽輒先嘗。朱懼覽致斃，遂止。"},{"proposed_paragraph_id":"c-jinshu-033-wanglan-family:p005","source_lines":[41,42],"raw_quote":"　　覽孝友恭恪，名亞-{於}-祥。及祥仕進，覽亦應本郡之召，稍遷司徒西曹掾、清河太守。五等建，封即丘子，邑六百戸。泰始末，除弘訓少府。職省，轉太中大夫，祿賜與卿同。咸甯初，詔曰：「覽少篤至行，服仁履義，貞素之操，長而彌固。其以覽爲宗正卿。」頃之，以疾上疏乞骸骨。詔聽之，乙太中大夫歸老，賜錢二十萬，床帳薦褥，遣殿中醫療疾給藥。-{後}-轉光祿大夫，門施行馬。","raw_quote_sha256":"40419a8eb7ece09dddabc61f0bd52c592e894e00ff14dcf36cdcc4135176b321","selected_text_sha256":"0236e27239e1247db380e51e73fef7d1df04e1132d77d32644b7c8e24878789a","begin_anchor":"覽孝友恭恪，名亞於祥。及祥仕進","end_anchor":"給藥。後轉光祿大夫，門施行馬。"},{"proposed_paragraph_id":"c-jinshu-033-wanglan-family:p006","source_lines":[43,44],"raw_quote":"　　{{YL|咸寧四年}}卒，時年七十三，諡曰貞。有六子：裁、基、會、正、彥、琛。","raw_quote_sha256":"1b676a2f07bf1dcf5ca27b5af4d9912c1d31377fc3a8e6ce355ff58306231c0b","selected_text_sha256":"e490f9134a325ad7545ba632b20b15665e49864e2da4018e00c8bae8b0ea31b7","begin_anchor":"咸寧四年卒，時年七十三，諡曰貞","end_anchor":"六子：裁、基、會、正、彥、琛。"},{"proposed_paragraph_id":"c-jinshu-033-wanglan-family:p007","source_lines":[45,46],"raw_quote":"　　裁字士初，撫軍長史。[[晉書/卷098#王敦|基]]字士先，治書御史。[[晉書/卷076#王舒|會]]字士和，侍御史。正字士則，尚書郎。彥字士治，中護軍。琛字士瑋，國子祭酒。","raw_quote_sha256":"46758aedb5388938223c2d591ce503993c0f591832c8a420457d713e3e252407","selected_text_sha256":"242d4aeb39a37bc009c4fdb993964b5808dc99a4da29a349c17e8d9c5ba3342c","begin_anchor":"裁字士初，撫軍長史。基字士先，","end_anchor":"，中護軍。琛字士瑋，國子祭酒。"},{"proposed_paragraph_id":"c-jinshu-033-wanglan-family:p008","source_lines":[47,48],"raw_quote":"　　初，呂虔有佩刀，工相之，以爲必登三公，可服此刀。虔謂祥曰：「苟非其人，刀或爲害。卿有公輔之量，故以相與。」祥固辭，強之乃受。祥臨薨，以刀授覽，曰：「汝-{後}-必興，足稱此刀。」覽-{後}-奕世多賢才，興-{於}-江左矣。裁子導，[[晉書/卷065|別有傳]]。","raw_quote_sha256":"a43f33c97b30853834d357d68a90d5e08fd1668a05e8469de66623b9d3c5efbe","selected_text_sha256":"19ba4970c1e7d6440a46690f3e567bf0af4efe92c07358ffca2a20c540acb2d0","begin_anchor":"初，呂虔有佩刀，工相之，以爲必","end_anchor":"，興於江左矣。裁子導，別有傳。"}]}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true}}
