:[{"id":"c-songshu-093-recluses:line080:m0055","start":55,"end":58,"surface":"釋法崇","kind":"person","person_id":"g8f_kxd_bhs","status":"contextual_provisional","paragraph_id":"c-songshu-093-recluses:line080","chapter_id":"c-songshu-093-recluses"},{"id":"c-songshu-093-recluses:line080:m0069","start":69,"end":71,"surface":"法崇","kind":"person","person_id":"g8f_kxd_bhs","status":"contextual_provisional","paragraph_id":"c-songshu-093-recluses:line080","chapter_id":"c-songshu-093-recluses"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-songshu-093-recluses:line080","text":"淳之少有髙尚，愛好墳籍，爲太原王恭所稱。居會稽剡縣，性好山水，毎有所游，必窮其幽峻，或旬日忘歸。嘗游山，遇沙門釋法崇，因留共止，遂停三載。法崇嘆曰：「緬想人外，三十年矣，今乃傾蓋于茲，不覺老之將至也。」及淳之還反，不告以姓。除著作佐郎，太尉參軍，並不就。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-songshu-093-recluses:line080:m0000","start":0,"end":2,"surface":"淳之","kind":"person","person_id":"vhw_07a_wzm_AA","status":"contextual_provisional"},{"id":"c-songshu-093-recluses:line080:m0015","start":15,"end":17,"surface":"王恭","kind":"person","person_id":"50j_txw_zn0","status":"contextual_provisional"},{"id":"c-songshu-093-recluses:line080:m0055","start":55,"end":58,"surface":"釋法崇","kind":"person","person_id":"g8f_kxd_bhs","status":"contextual_provisional"},{"id":"c-songshu-093-recluses:line080:m0069","start":69,"end":71,"surface":"法崇","kind":"person","person_id":"g8f_kxd_bhs","status":"contextual_provisional"},{"id":"c-songshu-093-recluses:line080:m0102","start":102,"end":104,"surface":"淳之","kind":"person","person_id":"vhw_07a_wzm_AA","status":"contextual_provisional"}],"source_position":{"first_line":80,"last_line":80,"revision_id":1962755,"editorial_excerpt_boundary":false},"chapter_id":"c-songshu-093-recluses","book_id":"b-songshu-093","work_id":"w-songshu","source_id":"s-songshu-093-recluses"}],"sources":[{"chapter_id":"c-songshu-093-recluses","work_id":"w-songshu","book_id":"b-songshu-093","source_id":"s-songshu-093-recluses","source":{"title":"《宋書》卷93（孔淳之傳）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E5%AE%8B%E6%9B%B8%2F%E5%8D%B793&oldid=1962755","permalink":"https://zh.wikisource.org/w/index.php?title=%E5%AE%8B%E6%9B%B8%2F%E5%8D%B793&oldid=1962755","revision_id":1962755,"accessed_on":"2026-10-19","extent":"孔淳之本傳完整四原段；同卷其他隱逸傳文尚未錄，不代表全卷完成。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，未親核底本影像","wikitext_sha256":"006115bbb0fa72042b9926f19b6ffbc952b7955b7f3a9fdf9c6fb3be71cb98aa","normalization":{"character_conversion":{},"extraction_note":"只去排版空白、展開原字形外殼及單參數年號模板及保留顯示字的維基連結外殼；數位ref另列，不改原字或標點，不以節題補姓名。","excerpts":[{"proposed_paragraph_id":"c-songshu-093-recluses:line078","source_lines":[78,78],"raw_quote":"孔淳之字彦深，魯郡魯人也。祖惔，尚書祠部郎。父粲，祕書監-{徴}-，不就。","raw_quote_sha256":"e08c332904a4263abf24d68123effc7e91eb997d0dbb823d6267f592a180ce9d","selected_text_sha256":"e91afa096164f2f1d11d56487cdfc4433017fcfffc8a478318771a93701e5f27","begin_anchor":"孔淳之字彦深，魯郡魯人也。祖惔，尚書","end_anchor":"，尚書祠部郎。父粲，祕書監徴，不就。"},{"proposed_paragraph_id":"c-songshu-093-recluses:line080","source_lines":[80,80],"raw_quote":"淳之少有髙尚，愛好墳籍，爲太原王恭所稱。居會稽剡縣，性好山水，毎有所-{游}-，必窮其幽峻，或旬日忘歸。嘗-{游}-山，遇沙門釋法崇，因留共止，遂停三載。法崇嘆曰：「緬想人外，三十年矣，今乃傾蓋-{于}-茲，不覺老之將至也。」及淳之還反，不告以姓。除著作佐郎，太尉參軍，-{並}-不就。","raw_quote_sha256":"930341c337dbeecd9d8b216daa7189b76145cbb8643eb87b59c6bf6978ae1c41","selected_text_sha256":"bb58aefe079d98c9bd867b70ad3dd715329619bc4f330d2efd9e356b44e6dd4a","begin_anchor":"淳之少有髙尚，愛好墳籍，爲太原王恭所","end_anchor":"以姓。除著作佐郎，太尉參軍，並不就。"},{"proposed_paragraph_id":"c-songshu-093-recluses:line082","source_lines":[82,82],"raw_quote":"居喪至孝，廬-{于}-墓側。服闋，與-{徴}-士戴顒、王弘之及王敬弘等共爲人外之-{游}-。敬弘以女-{適}-淳之子尚。會稽太守謝方明苦要入郡，終不肯往。茅室蓬戸，庭草蕪逕，唯牀上有數巻書。元嘉初，-{復}--{徴}-爲散騎侍郎，乃逃-{于}-上虞縣界，家人莫知所之。弟默之爲廣州刺史，出都與別。司徒王弘要淳之集冶城，即日命駕東歸，遂不顧也。元嘉七年，卒，時年五十九。默之儒學，注-{穀}-梁春秋。","raw_quote_sha256":"73c664d828d9e0764d966cd39cd7142c7a72b29f1ef9838c9d8634d0d2ba931b","selected_text_sha256":"cf11977a38578aa5cd8bbd507915a88d95d2224b01716b291291fcba8991d6a7","begin_anchor":"居喪至孝，廬于墓側。服闋，與徴士戴顒","end_anchor":"，時年五十九。默之儒學，注穀梁春秋。"},{"proposed_paragraph_id":"c-songshu-093-recluses:line084","source_lines":[84,84],"raw_quote":"默之子熙先，事在-{范}-曄傳。","raw_quote_sha256":"37b3392ab143e5b7b6f3432d3bf2deab473549a21a82ada3841c15a08a22570e","selected_text_sha256":"fa4cadbde259d1c7f84f4b90f20828d9a568b83907295532e6b46ab7fceb9e81","begin_anchor":"默之子熙先，事在范曄傳。","end_anchor":"默之子熙先，事在范曄傳。"}]},"response_sha256":"e715e1ac86b592e0b9f1ff085b7018abc415de6b534dceb093ab0d2e9e5cdd7d"}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true}}
