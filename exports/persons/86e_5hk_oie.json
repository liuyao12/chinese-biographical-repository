policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-064-suncong-complete:p012:m0204","surface":"施朔","start":204,"end":206,"kind":"person","person_id":"86e_5hk_oie","status":"contextual_provisional","paragraph_id":"c-sanguozhi-064-suncong-complete:p012","chapter_id":"c-sanguozhi-064-suncong-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-064-suncong-complete:p012","text":"　　綝奉牛酒詣休，休不受，齎詣左將軍張布。酒酣，出怨言曰：「徹廢少主時，多勸吾自為之者。吾以陛下賢明，故迎之。帝非我不立，今上禮見拒，是與凡臣無異，當復改圖耳。」布以言聞休，休銜之。鞏其有變，數加賞賜，又復加恩侍中，與綝分省文書。或有告綝懷怨侮上欲圖反者，休執以付綝，綝殺之。由是愈懼，因孟宗求出屯武昌，休許焉，盡敕所督中營精兵萬餘人，皆令裝載，所取武庫兵器，咸令給與。將軍魏邈說休曰「綝居外必有變」，武衛士施朔又告「綝欲反有徵」休密問張布，布與丁奉謀於會殺綝。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":91,"last_line":91,"raw_start":12851,"raw_end":13134,"raw_character_offsets":[12851,12852,12853,12854,12855,12856,12857,12858,12859,12860,12861,12862,12863,12864,12865,12866,12867,12868,12869,12870,12871,12872,12873,12874,12875,12876,12877,12878,12879,12880,12881,12882,12883,12884,12885,12886,12887,12888,12889,12890,12891,12892,12893,12894,12895,12896,12897,12898,12899,12900,12901,12902,12903,12904,12905,12906,12907,12908,12909,12910,12911,12912,12913,12914,12915,12916,12917,12918,12919,12920,12921,12922,12923,12924,12925,12926,12927,12928,12929,12930,12931,12932,12933,12934,12935,12936,12937,12938,12939,12940,12941,12942,12943,12944,12945,12946,12947,12948,12949,12950,12951,12952,12953,12954,12955,12956,12957,12958,12959,12960,12961,12962,12963,12964,12965,12966,12967,12968,12969,12970,12971,12972,12973,12974,12975,12976,12977,12978,12979,12980,12981,12982,12983,12984,12985,12986,12987,12988,12989,12990,12991,12992,12993