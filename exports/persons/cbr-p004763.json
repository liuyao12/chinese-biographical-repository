":["重華"],"evidence":[{"paragraph_id":"c-shiji-084-qujia:p015","quote":"任重載盛兮，陷滯而不濟；懷瑾握瑜兮，窮不得余所示。邑犬群吠兮，吠所怪也；誹駿疑桀兮，固庸態也。文質疏內兮，眾不知吾之異采；材樸委積兮，莫知余之所有。重仁襲義兮，謹厚以為豐；重華不可牾兮，孰知余之從容！迸固有不并兮，豈知其故也？湯禹久遠兮，邈不可慕也。懲違改忿兮，抑心而自彊；離湣而不遷兮，願志之有象。進路北次兮，日昧昧其將暮；含憂虞哀兮，限之以大故。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-084-qujia:p015","text":"任重載盛兮，陷滯而不濟；懷瑾握瑜兮，窮不得余所示。邑犬群吠兮，吠所怪也；誹駿疑桀兮，固庸態也。文質疏內兮，眾不知吾之異采；材樸委積兮，莫知余之所有。重仁襲義兮，謹厚以為豐；重華不可牾兮，孰知余之從容！迸固有不并兮，豈知其故也？湯禹久遠兮，邈不可慕也。懲違改忿兮，抑心而自彊；離湣而不遷兮，願志之有象。進路北次兮，日昧昧其將暮；含憂虞哀兮，限之以大故。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m015-0053","start":53,"end":54,"surface":"眾","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代保持未解。"},{"id":"c-shiji-084-qujia:m015-0086","start":86,"end":88,"surface":"重華","kind":"person","person_id":"m77_em2_28k","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m015-0113","start":113,"end":114,"surface":"湯","kind":"person","person_id":"vvt_6h5_czb","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m015-0114","start":114,"end":115,"surface":"禹","kind":"person","person_id":"69v_q1z_72c","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"}],"sources":[{"chapter_id":"c-shiji-084-qujia","work_id":"w-shiji","book_id":"b-shiji-084","source_id":"s-shiji-084-qujia","source":{"title":"史記／卷084","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷084","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷084&oldid=1568305","revision_id":1568305,"accessed_on":"2026-10-09","extent":"33段正文，屈原、懷沙、賈生及篇末評論；索隱述贊另層待收。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{"铦":"銛","鸮":"鴞"},"editorial_readings":[{"paragraph_id":"c-shiji-084-qujia:p017","witness_form":"（投）［沈］","body_reading":"投","not