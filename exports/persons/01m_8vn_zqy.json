{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"01m_8vn_zqy","canonical_person_id":"01m_8vn_zqy","id_aliases":["01m_8vn_zqy-"],"identity_policy":"contextual_provisional","person_ids":["01m_8vn_zqy"],"persons":[{"id":"01m_8vn_zqy","label":"陳勝（劉敬叔孫通列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"陳勝","mention_ids":["c-shiji-099-liushu:m008-0024"]}],"evidence":[{"mention_id":"c-shiji-099-liushu:m008-0024","chapter_id":"c-shiji-099-liushu","paragraph_id":"c-shiji-099-liushu:p008","quote":"陳勝"}],"id_aliases":["01m_8vn_zqy-"]}],"source_mention_summary":[{"source_id":"s-shiji-099-liushu","work_id":"w-shiji","book_id":"b-shiji-099","chapter_id":"c-shiji-099-liushu","mention_count":1,"mention_ids":["c-shiji-099-liushu:m008-0024"],"paragraph_ids":["c-shiji-099-liushu:p008"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-099-liushu"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-099-liushu:m008-0024","start":24,"end":26,"surface":"陳勝","kind":"person","person_id":"01m_8vn_zqy","status":"contextual_provisional","paragraph_id":"c-shiji-099-liushu:p008","chapter_id":"c-shiji-099-liushu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji099-023","person_id":"01m_8vn_zqy","surfaces":["陳勝"],"scope":"same_chapter","chapter_ids":["c-shiji-099-liushu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-099-liushu:p008","quote":"叔孫通者，薛人也。秦時以文學徵，待詔博士。數歲，陳勝起山東，使者以聞，二世召博士諸儒生問曰：「楚戍卒攻蘄入陳，於公如何？」博士諸生三十餘人前曰：「人臣無將，將即反，罪死無赦。願陛下急發兵擊之。」二世怒，作色。叔孫通前曰：「諸生言皆非也。夫天下合為一家，毀郡縣城，鑠其兵，示天下不復用。且明主在其上，法令具於下，使人人奉職，四方輻輳，安敢有反者！此特群盜鼠竊狗盜耳，何足置之齒牙閒。郡守尉今捕論，何足憂。」二世喜曰：「善。」盡問諸生，諸生或言反，或言盜。於是二世令御史案諸生言反者下吏，非所宜言。諸言盜者皆罷之。乃賜叔孫通帛二十匹，衣一襲，拜為博士。叔孫通已出宮，反舍，諸生曰：「先生何言之諛也？」通曰：「公不知也，我幾不脫於虎口！」乃亡去，之薛，薛已降楚矣。及項梁之薛，叔孫通從之。敗於定陶，從懷王。懷王為義帝，徙長沙，叔孫通留事項王。漢二年，漢王從五諸侯入彭城，叔孫通降漢王。漢王敗而西，因竟從漢。"}],"rationale":"依婁敬賜姓劉氏及叔孫通叔孫生敘事承接；各引語依人物事件範圍定位。從遠祖不補父系，和親假設不當實際生育，太子未定錨點留待逐項整理。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-099-liushu:p008","text":"叔孫通者，薛人也。秦時以文學徵，待詔博士。數歲，陳勝起山東，使者以聞，二世召博士諸儒生問曰：「楚戍卒攻蘄入陳，於公如何？」博士諸生三十餘人前曰：「人臣無將，將即反，罪死無赦。願陛下急發兵擊之。」二世怒，作色。叔孫通前曰：「諸生言皆非也。夫天下合為一家，毀郡縣城，鑠其兵，示天下不復用。且明主在其上，法令具於下，使人人奉職，四方輻輳，安敢有反者！此特群盜鼠竊狗盜耳，何足置之齒牙閒。郡守尉今捕論，何足憂。」二世喜曰：「善。」盡問諸生，諸生或言反，或言盜。於是二世令御史案諸生言反者下吏，非所宜言。諸言盜者皆罷之。乃賜叔孫通帛二十匹，衣一襲，拜為博士。叔孫通已出宮，反舍，諸生曰：「先生何言之諛也？」通曰：「公不知也，我幾不脫於虎口！」乃亡去，之薛，薛已降楚矣。及項梁之薛，叔孫通從之。敗於定陶，從懷王。懷王為義帝，徙長沙，叔孫通留事項王。漢二年，漢王從五諸侯入彭城，叔孫通降漢王。漢王敗而西，因竟從漢。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-099-liushu:m008-0000","start":0,"end":3,"surface":"叔孫通","kind":"person","person_id":"x8f_fyc_zvc","status":"contextual_provisional"},{"id":"c-shiji-099-liushu:m008-0024","start":24,"end":26,"surface":"陳勝","kind":"person","person_id":"01m_8vn_zqy","status":"contextual_provisional"},{"id":"c-shiji-099-liushu:m008-0035","start":35,"end":37,"surface":"二世","kind":"person","person_id":"r5o_rck_hff","status":"contextual_provisional"},{"id":"c-shiji-099-liushu:m008-0038","start":38,"end":43,"surface":"博士諸儒生","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、合稱或待辨稱名；和親條件及建議中的未來子孫不當實際人物。"},{"id":"c-shiji-099-liushu:m008-0061","start":61,"end":69,"surface":"博士諸生三十餘人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、合稱或待辨稱名；和親條件及建議中的未來子孫不當實際人物。"},{"id":"c-shiji-099-liushu:m008-0097","start":97,"end":99,"surface":"二世","kind":"person","person_id":"r5o_rck_hff","