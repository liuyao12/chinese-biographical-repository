{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"dx5_hf8_1l4","canonical_person_id":"dx5_hf8_1l4","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["dx5_hf8_1l4"],"persons":[{"id":"dx5_hf8_1l4","label":"蔡秀成（壽陽之役後軍）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"蔡秀成","mention_ids":["c-liangshu-028-peisui-complete:p007:m0066"]}],"evidence":[{"mention_id":"c-liangshu-028-peisui-complete:p007:m0066","paragraph_id":"c-liangshu-028-peisui-complete:p007","chapter_id":"c-liangshu-028-peisui-complete","quote":"蔡秀成"}],"review":"ai_provisional","identity_note":"蔡秀成（壽陽之役後軍），見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-liangshu-028-peisui-complete-ws1511902","work_id":"w-liangshu","book_id":"b-liangshu-028","chapter_id":"c-liangshu-028-peisui-complete","raw_mention_count":1,"mention_ids":["c-liangshu-028-peisui-complete:p007:m0066"],"paragraph_ids":["c-liangshu-028-peisui-complete:p007"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-liangshu-028-peisui-complete:p007:m0066","mention_ids":["c-liangshu-028-peisui-complete:p007:m0066"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-liangshu-028-peisui-complete-ws1511902"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-liangshu-028-peisui-complete:p007:m0066","start":66,"end":69,"surface":"蔡秀成","kind":"person","person_id":"dx5_hf8_1l4","status":"contextual_provisional","paragraph_id":"c-liangshu-028-peisui-complete:p007","chapter_id":"c-liangshu-028-peisui-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-028-peisui-complete:p007","text":"四年，進號宣毅將軍。是歲，大軍將北伐，以邃督征討諸軍事，率騎三千，先襲壽陽。九月壬戌，夜至壽陽，攻其郛，斬關而入，一日戰九合，爲後軍蔡秀成失道不至，邃以援絕拔還。於是邃復整兵，收集士卒，令諸將各以服色相別。邃自爲黃袍騎，先攻狄丘、甓城、黎漿等城，皆拔之。屠安成、馬頭、沙陵等戍。是冬，始修芍陂。明年，復破魏新蔡郡，略地至於鄭城，汝潁之間，所在回應。魏壽陽守將長孫稚、河間王元琛率衆五萬，出城挑戰。邃勒諸將爲四甄以待之，令直閤將軍李祖憐偽遁以引稚，稚等悉衆追之，四甄競發，魏衆大敗。斬首萬餘級。稚等奔走，閉門自固，不敢復出。其年五月，卒於軍中。追贈侍中、左衛將軍，給鼓吹一部，進爵爲侯，增邑七百戶。諡曰烈。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":24,"last_line":24,"raw_start":1269,"raw_end":1571,"raw_character_offsets":[1269,1270,1271,1272,1273,1274,1275,1276,1277,1278,1279,1280,1281,1282,1283,1284,1285,1286,1287,1288,1289,1290,1291,1292,1293,1294,1295,1296,1297,1298,1299,1300,1301,1302,1303,1304,1305,1306,1307,1308,1309,1310,1311,1312,1313,1314,1315,1316,1317,1318,1319,1320,1321,1322,1323,1324,1325,1326,1327,1328,1329,1330,1331,1332,1333,1334,1335,1336,1337,1338,1339,1340,1341,1342,1343,1344,1345,1346,1347,1348,1349,1350,1351,1352,1353,1354,1355,1356,1357,1358,1359,1360,1361,1362,1363,1364,1365,1366,1367,1368,1369,1370,1371,1372,1373,1374,1375,1376,1377,1378,1379,1380,1381,1382,1383,1384,1385,1386,1387,1388,1389,1390,1391,1392,1393,1394,1395,1396,1397,1398,1399,1400,1401,1402,1403,1404,1405,1406,1407,1408,1409,1410,1411,1412,1413,1414,1415,1416,1417,1418,1419,1420,1421,1422,1423,1424,1425,1426,1427,1428,1429,1430,1431,1432