ragraph_id":"c-shiji-057-zhou:p018","chapter_id":"c-shiji-057-zhou"},{"id":"c-shiji-057-zhou:m018-0097","start":97,"end":98,"surface":"信","kind":"person","person_id":"cbr-p003524","status":"contextual_provisional","paragraph_id":"c-shiji-057-zhou:p018","chapter_id":"c-shiji-057-zhou"},{"id":"c-shiji-057-zhou:m018-0156","start":156,"end":157,"surface":"信","kind":"person","person_id":"cbr-p003524","status":"contextual_provisional","paragraph_id":"c-shiji-057-zhou:p018","chapter_id":"c-shiji-057-zhou"},{"id":"c-shiji-057-zhou:m023-0013","start":13,"end":15,"surface":"王信","kind":"person","person_id":"cbr-p003524","status":"contextual_provisional","paragraph_id":"c-shiji-057-zhou:p023","chapter_id":"c-shiji-057-zhou"}],"relations":[{"id":"a-shiji057-010","subject_person_id":"cbr-p003524","predicate":"brother","object_person_id":"cbr-p003523","status":"source_attested","evidence":[{"chapter_id":"c-shiji-057-zhou","source_id":"s-shiji-057-zhou","paragraph_id":"c-shiji-057-zhou:p018","quote":"竇太后曰：「皇后兄王信可侯也。」景帝讓曰：「始南皮、章武侯先帝不侯，及臣即位乃侯之。信未得封也。」竇太后曰：「人主各以時行耳。自竇長君在時，竟不得侯，死後乃［封］其子彭祖顧得侯。吾甚恨之。帝趣侯信也！」景帝曰：「請得與丞相議之。」丞相議之，亞夫曰：「高皇帝約『非劉氏不得王，非有功不得侯。不如約，天下共擊之』。今信雖皇后兄，無功，侯之，非約也。」景帝默然而止。"}],"qualifiers":{"source_term":"皇后兄王信","historicity":"historical_tradition"},"interpretation_note":"依明示子、兄、女、尚、夫人與局部主語保存，不由承爵本身補父子，不補未見姓名、同母或排行；文帝女公主與亞夫家屬保留本篇未名稱呼。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji057-081","person_id":"cbr-p003524","title":"蓋侯","kind":"noble_rank","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-057-zhou","source_id":"s-shiji-057-zhou","paragraph_id":"c-shiji-057-zhou:p023","quote":"條侯果餓死。死後，景帝乃封王信為蓋侯。"}],"attestations":[{"id":"th-shiji057-081:a001","paragraph_id":"c-shiji-057-zhou:p023","start":16,"end":18,"surface":"蓋侯","person_mention_id":"c-shiji-057-zhou:m023-0013","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-057-zhou","source_id":"s-shiji-057-zhou","paragraph_id":"c-shiji-057-zhou:p023","quote":"條侯果餓死。死後，景帝乃封王信為蓋侯。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授官、爵秩、追稱、承爵與一般用稱分存；相對年數按原段，不換算公曆或推定所有官爵同時終止。未知官員姓名與制度性質不補。 條侯死後實封與第18段勸封提議分辨，不把可侯當已封。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji057-057","person_id":"cbr-p003524","surfaces":["信","王信"],"scope":"same_chapter","chapter_ids":["c-shiji-057-zhou"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-057-zhou:p018","quote":"竇太后曰：「皇后兄王信可侯也。」景帝讓曰：「始南皮、章武侯先帝不侯，及臣即位乃侯之。信未得封也。」竇太后曰：「人主各以時行耳。自竇長君在時，竟不得侯，死後乃［封］其子彭祖顧得侯。吾甚恨之。帝趣侯信也！」景帝曰：「請得與丞相議之。」丞相議之，亞夫曰：「高皇帝約『非劉氏不得王，非有功不得侯。不如約，天下共擊之』。今信雖皇后兄，無功，侯之，非約也。」景帝默然而止。"},{"paragraph_id":"c-shiji-057-zhou:p023","quote":"條侯果餓死。死後，景帝乃封王信為蓋侯。"}],"rationale":"按明示姓名、軍事近接、父子承爵與局部皇帝敘事暫接。周勃和勝之的絳侯分開，亞夫條侯與平曲支不混；代地韓信依韓王信近接而不接淮陰侯。未名人物、單名官員不補姓，校勘字不作定本，相術預言不作史實已驗。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-057-zhou:p018","text":"竇太后曰：「皇后兄王信可侯也。」景帝讓曰：「始南皮、章武侯先帝不侯，及臣即位乃侯之。信未得封也。」竇太后曰：「人主各以時行耳。自竇長君在時，竟不得侯，死後乃［封］其子彭祖顧得侯。吾甚恨之。帝趣侯信也！」景帝曰：「請得與丞相議之。」丞相議之，亞夫曰：「高皇帝約『非劉氏不得王，非有功不得侯。不如約，天下共擊之』。今信雖皇后兄，無功，侯之，非約也。」景帝默然而止。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-057-zhou:m018-0000","start":0,"end":3,"surface":"竇太后","kind":"person","person_id":"cbr-p003522","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m018-0006","start":6,"end":8,"surface":"皇后","kind":"person","person_id":"cbr-p003523","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m018-0009","start":9,"end":11,"surface":"王信","kind":"person","person_id":"cbr-p003524","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m018-0016","start":16,"end":18,"surface":"景帝","kind":"person","person_id":"cbr-p003517","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m018-0023","start":23