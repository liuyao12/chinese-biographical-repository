age":null,"person_mentions":[{"id":"shiji-020-t1-r067-c06-m000","start":8,"end":13,"surface":"朝鮮相韓陰","person_id":"466_pwj_snr","status":"contextual_provisional","interpretation_note":"同列封國、朝鮮官稱與降漢功事，與本傳同人暫接；表內原稱、字元位置及異文保留。子最之子為路人之子，不是姓名子最。","identity_evidence":[{"work_id":"w-shiji","book_id":"b-shiji-115","chapter_id":"c-shiji-115-chaoxian","source_id":"s-shiji115-chaoxian","source_revision":439220,"paragraph_id":"c-shiji-115-chaoxian:p008","person_id":"466_pwj_snr","quote":"左將軍已并兩軍，即急擊朝鮮。朝鮮相路人、相韓陰、尼谿相參、將軍王唊相與謀曰：「始欲降樓船，樓船今執，獨左將軍并將，戰益急，恐不能與，（戰）王又不肯降。」陰、唊、路人皆亡降漢。路人道死。元封三年夏，尼谿相參乃使人殺朝鮮王右渠來降。王險城未下，故右渠之大臣成巳又反，復攻吏。左將軍使右渠子長降、相路人之子最告諭其民，誅成巳，以故遂定朝鮮，為四郡。封參為澅清侯，陰為荻苴侯，唊為平州侯，長［降］為幾侯。最以父死頗有功，為溫陽侯。"}]}],"table_id":"shiji-020","table_fragment_id":"shiji-020-digital-table-1","table_row_id":"shiji-020-t1-r067","table_cell_id":"shiji-020-t1-r067-c06","work_id":"w-shiji","book_id":"b-shiji-020","chapter_id":"table-chapter-shiji-020","source_id":"table-witness-shiji-020","source_revision":"2607036","source_header":["國名","侯功","元光","元朔","元狩","元鼎","元封","太初已後"],"row_year":null},{"id":"shiji-020-t1-r067-c00","column":0,"rowspan":1,"colspan":1,"text":"荻苴。","source_row":68,"source_column":1,"printed_page":null,"person_mentions":[],"table_id":"shiji-020","table_fragment_id":"shiji-020-digital-table-1","table_row_id":"shiji-020-t1-r067","table_cell_id":"shiji-020-t1-r067-c00","work_id":"w-shiji","book_id":"b-shiji-020","chapter_id":"table-chapter-shiji-020","source_id":"table-witness-shiji-020","source_revision":"2607036","source_header":["國名","侯功","元光","元朔","元狩","元鼎","元封","太初已後"],"row_year":null,"citation_role":"native_table_title_reference"},{"id":"shiji-022-t1-r097-c01","column":1,"rowspan":1,"colspan":1,"text":"元封元年。","source_row":98,"source_column":2,"printed_page":null,"person_mentions":[],"table_id":"shiji-022","table_fragment_id":"shiji-022-digital-table-1","table_row_id":"shiji-022-t1-r097","table_cell_id":"shiji-022-t1-r097-c01","work_id":"w-shiji","book_id":"b-shiji-022","chapter_id":"