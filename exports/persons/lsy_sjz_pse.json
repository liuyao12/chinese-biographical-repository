5,718,722,723,724,725,726,730,731,732,735,738,739,740,741,742,743,744,745,746,747,748,749,750,751,752,766,767,768,769,770,771,772,775]},"chapter_id":"c-sanguozhi-051-jing","book_id":"b-sanguozhi-051","work_id":"w-sanguozhi","source_id":"s-sanguozhi-051-jing"},{"id":"c-sanguozhi-051-jing:line011-pei03-01","text":"《會稽典錄》曰：昕字大明。少游京師，師事太傅陳蕃，博覽群書，明於風角，善推災異。辟太尉府，舉高第，稍遷丹楊太守。曹公起義兵，昕前後遣兵萬餘人助公征伐。袁術之在淮南也，昕惡其淫虐，絕不與通。","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-051-jing:line011-pei03-01:m0008","start":8,"end":9,"surface":"昕","kind":"person","person_id":"lsy_sjz_pse","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-jing:line011-pei03-01:m0010","start":10,"end":12,"surface":"大明","kind":"person","person_id":"lsy_sjz_pse","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-jing:line011-pei03-01:m0022","start":22,"end":24,"surface":"陳蕃","kind":"person","person_id":"7tn_3cc_phw","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-jing:line011-pei03-01:m0056","start":56,"end":58,"surface":"曹公","kind":"person","person_id":"dad_b77_b38","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-jing:line011-pei03-01:m0062","start":62,"end":63,"surface":"昕","kind":"person","person_id":"lsy_sjz_pse","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-jing:line011-pei03-01:m0075","start":75,"end":77,"surface":"袁術","kind":"person","person_id":"865_b69_cb0","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-jing:line011-pei03-01:m0083","start":83,"end":84,"surface":"昕","kind":"person","person_id":"lsy_sjz_pse","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"}],"annotation_status":"reviewed","source_position":{"first_line":11,"last_line":11,"revision_id":12758417,"raw_start":501,"raw_e