576,577,578,579,580,581,582,583,584,585,586,587,588,589,590,591,592,593,594,595,596,597,598,599,600,601,602,603,604,605,606,607,608,609,610,611,612,613,614,615,616,617,618,619,620,621,622,623,624,625,626,627,628,629,630,631,632,633,634,635,636,646,647,648,649,650,651,652,653,654,655,656,657,658,659,660,661,662,663]},"chapter_id":"c-sanguozhi-050-wu","book_id":"b-sanguozhi-050","work_id":"w-sanguozhi","source_id":"s-sanguozhi-050-wu"},{"id":"c-sanguozhi-051-jing:line011","text":"　　孫靜字幼臺，堅季弟也。堅始舉事，靜糾合鄉曲及宗室五六百人以為保障，眾咸附焉。策破劉繇，定諸縣。進攻會稽，遣人請靜，靜將家屬與策會於錢唐。是時太守王朗拒策於固陵，策數渡水戰，不能克。靜說策曰：「朗負阻城守，難可卒拔。查瀆南去此數十里，而道之要徑也，宜從彼據其內，所謂攻其無備、出其不意者也。吾當自帥眾為軍前隊，破之必矣。」策曰：「善。」乃詐令軍中曰：「頃連雨水濁，兵飲之多腹痛，令促具罌缶數百口澄水。」至昏暮，羅以然火誑朗，便分軍夜投查瀆道，襲高遷屯。朗大驚。遣故丹楊太守周昕等帥兵前戰。策破昕等，斬之，遂定會稽。表拜靜為奮武校尉，欲授之重任，靜戀墳墓宗族，不樂出仕，求留鎮守。策從之。權統事，就遷昭義中郎將，終於家。有五子，暠、瑜、皎、奐、謙。暠三子：綽、超、恭。超為偏將軍。恭生峻。綽生綝。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-051-jing:line011:m0002","start":2,"end":4,"surface":"孫靜","kind":"person","person_id":"y4x_cmp_976","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-jing:line011:m0005","start":5,"end":7,"surface":"幼臺","kind":"person","person_id":"y4x_cmp_976","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-jing:line011:m0008","start":8,"end":9,"surface":"堅","kind":"person","person_id":"ki7_rgz_3l4","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-jing:line011:m0013","start":13,"end":14,"surface":"堅","kind":"person","person_id":"ki7_rgz_3l4","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-jing:line011:m0018","start":18,"end":19,"surface":"靜","kind":"person","person_id":"y4x_cmp_976","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-051-jing:line011:m0040","start":40,"end":41,"surface":"策","kind":"person","person_id":"e9c_070_567","status":"contextual_provisional","interpretation_not