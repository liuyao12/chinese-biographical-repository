"preferred_relations":[{"id":"a-wu051-zhou-teacher","subject_person_id":"lsy_sjz_pse","object_person_id":"7tn_3cc_phw","predicate":"teacher","qualifiers":{"source_term":"師事太傅陳蕃","relationship_basis":"teaching"},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-051","chapter_id":"c-sanguozhi-051-jing","source_id":"s-sanguozhi-051-jing","paragraph_id":"c-sanguozhi-051-jing:line011-pei03-01","quote":"《會稽典錄》曰：昕字大明。少游京師，師事太傅陳蕃，博覽群書，明於風角，善推災異。辟太尉府，舉高第，稍遷丹楊太守。曹公起義兵，昕前後遣兵萬餘人助公征伐。袁術之在淮南也，昕惡其淫虐，絕不與通。","subject_person_mention_id":"c-sanguozhi-051-jing:line011-pei03-01:m0008","object_person_mention_id":"c-sanguozhi-051-jing:line011-pei03-01:m0022"}],"interpretation_note":"會稽典錄明記昕師事陳蕃。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-wu051-jing1","person_id":"lsy_sjz_pse","event_type":"death","source_term":"策破昕等，斬之","date_expression":null,"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-051","chapter_id":"c-sanguozhi-051-jing","source_id":"s-sanguozhi-051-jing","paragraph_id":"c-sanguozhi-051-jing:line011","quote":"　　孫靜字幼臺，堅季弟也。堅始舉事，靜糾合鄉曲及宗室五六百人以為保障，眾咸附焉。策破劉繇，定諸縣。進攻會稽，遣人請靜，靜將家屬與策會於錢唐。是時太守王朗拒策於固陵，策數渡水戰，不能克。靜說策曰：「朗負阻城守，難可卒拔。查瀆南去此數十里，而道之要徑也，宜從彼據其內，所謂攻其無備、出其不意者也。吾當自帥眾為軍前隊，破之必矣。」策曰：「善。」乃詐令軍中曰：「頃連雨水濁，兵飲之多腹痛，令促具罌缶數百口澄水。」至昏暮，羅以然火誑朗，便分軍夜投查瀆道，襲高遷屯。朗大驚。遣故丹楊太守周昕等帥兵前戰。策破昕等，斬之，遂定會稽。表拜靜為奮武校尉，欲授之重任，靜戀墳墓宗族，不樂出仕，求留鎮守。策從之。權統事，就遷昭義中郎將，終於家。有五子，暠、瑜、皎、奐、謙。暠三子：綽、超、恭。超為偏將軍。恭生峻。綽生綝。","person_mention_id":"c-sanguozhi-051-jing:line011:m0237"}],"interpretation_note":"本來源所記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-sanguozhi-050-wu:line014:m0028","start":28,"end":30,"surface":"周昕","kind":"person","person_id":"lsy_sjz_pse","status":"contextual_provisional","interpretation_note"