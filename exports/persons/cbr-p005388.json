{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p005388","identity_policy":"contextual_provisional","person_ids":["cbr-p005388"],"persons":[{"id":"cbr-p005388","label":"漢景帝（張丞相列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"孝景","mention_ids":["c-shiji-096-zhang:m014-0124"]},{"surface":"孝景帝","mention_ids":["c-shiji-096-zhang:m018-0012"]},{"surface":"景帝","mention_ids":["c-shiji-096-zhang:m018-0134","c-shiji-096-zhang:m018-0149","c-shiji-096-zhang:m019-0008"]}],"evidence":[{"mention_id":"c-shiji-096-zhang:m014-0124","chapter_id":"c-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p014","quote":"孝景"},{"mention_id":"c-shiji-096-zhang:m018-0012","chapter_id":"c-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p018","quote":"孝景帝"},{"mention_id":"c-shiji-096-zhang:m018-0134","chapter_id":"c-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p018","quote":"景帝"},{"mention_id":"c-shiji-096-zhang:m018-0149","chapter_id":"c-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p018","quote":"景帝"},{"mention_id":"c-shiji-096-zhang:m019-0008","chapter_id":"c-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p019","quote":"景帝"}]}],"mentions":[{"id":"c-shiji-096-zhang:m014-0124","start":124,"end":126,"surface":"孝景","kind":"person","person_id":"cbr-p005388","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p014","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m018-0012","start":12,"end":15,"surface":"孝景帝","kind":"person","person_id":"cbr-p005388","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p018","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m018-0134","start":134,"end":136,"surface":"景帝","kind":"person","person_id":"cbr-p005388","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p018","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m018-0149","start":149,"end":151,"surface":"景帝","kind":"person","person_id":"cbr-p005388","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p018","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m019-0008","start":8,"end":10,"surface":"景帝","kind":"person","person_id":"cbr-p005388","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p019","chapter_id":"c-shiji-096-zhang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji096-030","person_id":"cbr-p005388","scope":"same_chapter","chapter_ids":["c-shiji-096-zhang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["孝景","孝景帝","景帝"],"evidence":[{"paragraph_id":"c-shiji-096-zhang:p014","quote":"蒼為丞相十餘年，魯人公孫臣上書言漢土德時，其符有黃龍當見。詔下其議張蒼，張蒼以為非是，罷之。其後黃龍見成紀，於是文帝召公孫臣以為博士，草土德之歷制度，更元年。張丞相由此自絀，謝病稱老。蒼任人為中候，大為姦利，上以讓蒼，蒼遂病免。蒼為丞相十五歲而免。孝景前五年，蒼卒，謚為文侯。子康侯代，八年卒。子類代為侯，八年，坐臨諸侯喪後就位不敬，國除。"},{"paragraph_id":"c-shiji-096-zhang:p018","quote":"嘉為丞相五歲，孝文帝崩，孝景帝即位。二年，晁錯為內史，貴幸用事，諸法令多所請變更，議以謫罰侵削諸侯。而丞相嘉自絀所言不用，疾錯。錯為內史，門東出，不便，更穿一門南出。南出者，太上皇廟堧垣。嘉聞之，欲因此以法錯擅穿宗廟垣為門，奏請誅錯。錯客有語錯，錯恐，夜入宮上謁，自歸景帝。至朝，丞相奏請誅內史錯。景帝曰：「錯所穿非真廟垣，乃外堧垣，故他官居其中，且又我使為之，錯無罪。」罷朝，嘉謂長史曰：「吾悔不先斬錯，乃先請之，為錯所賣。」至舍，因歐血而死。謚為節侯。子共侯蔑代，三年卒。子侯去病代，三十一年卒。子侯臾代，六歲，坐為九江太守受故官送有罪，國除。"},{"paragraph_id":"c-shiji-096-zhang:p019","quote":"自申屠嘉死之後，景帝時開封侯陶青、桃侯劉舍為丞相。及今上時，柏至侯許昌、平棘侯薛澤、武彊侯莊青翟、高陵侯趙周等為丞相。皆以列侯繼嗣，娖娖廉謹，為丞相備員而已，無所能發明功名有著於當世者。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定短稱；韋賢與韋玄成分傳區別，第23段掾陳平另候選，第25段長安相工田文不與孟嘗君合併。趙堯、任敖、申屠嘉、鄧通、晁錯的短名依各段人物語境，王陵夫人與王陵分人。張蒼父長不滿五尺的長為身長敘述，不作父名。王侯與太子未詳名不補名，跨篇同指另待證據。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-096-zhang:p014","text":"蒼為丞相十餘年，魯人公孫臣上書言漢土德時，其符有黃龍當見。詔下其議張蒼，張蒼以為非是，罷之。其後黃龍見成紀，於是文帝召公孫臣以為博士，草土德之歷制度，更元年。張丞相由此自絀，謝病稱老。蒼任人為中候，大為姦利，上以讓蒼，蒼遂病免。蒼為丞相十五歲而免。孝景前五年，蒼卒，謚為文侯。子康侯代，八年卒。子類代為侯，八年，坐臨諸侯喪後就位不敬，國除。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhang:m014-0000","start":0,"end":1,"surface":"蒼","kind":"person","person_id":"cbr-p005362","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m014-0010","start":10,"end":13,"surface":"公孫臣","kind":"person","person_id":"cbr-p005387","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m014-0033","start":33,"end":35,"surface":"張蒼","kind":"person","person_id":"cbr-p005362","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m014-0036","start":36,"end":38,"surface":"張蒼","kind":"person","person_id":"cbr-p005362","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m014-0056","start":56,"end":58,"surface":"文帝","kind":"person","person_id":"cbr-p005384","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m014-0059","start":59,"end":62,"surface":"公孫臣","kind":"person","person_id":"cbr-p005387","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m014-0079","start":79,"end":82,"surface":"張丞相","kind":"person","person_id":"cbr-p005362","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m014-0092","start":92,"end":93,"surface":"蒼","kind":"person","person_id":"cbr-p005362","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m014-0107","start":107,"end":108,"surface":"蒼","kind":"person","person_id":"cbr-p005362","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m014-0109","start":109,"end":110,"surface":"蒼","kind":"person","person_id":"cbr-p005362","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m014-0114","start":114,"end":115,"surface":"蒼","kind":"person","person_id":"cbr-p005362","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m014-0124","start":124,"end":126,"surface":"孝景","kind":"person","person_id":"cbr-p005388","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m014-0130","start":130,"end":131,"surface":"蒼","kind":"person","person_id":"cbr-p005362","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m014-0139","start":139,"end":141,"surface":"康侯","kind":"person","person_id":"cbr-p005400","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m014-0148","start":148,