{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"rqd_jt6_qdp","canonical_person_id":"rqd_jt6_qdp","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["rqd_jt6_qdp"],"persons":[{"id":"rqd_jt6_qdp","label":"甄法崇","status":"active","historicity":"historical_tradition","aliases":[{"surface":"甄法崇","mention_ids":["c-songshu-064-peisongzhi:p004:m0056","c-songshu-045-wyd1739-liucui:p013:m0160"]}],"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-064","chapter_id":"c-songshu-064-peisongzhi","source_id":"s-song064-ws1748217","paragraph_id":"c-songshu-064-peisongzhi:p004","mention_id":"c-songshu-064-peisongzhi:p004:m0056","quote":"甄法崇"},{"work_id":"w-songshu","book_id":"b-songshu-045","source_id":"s-songshu-045-wyd1739-liucui","chapter_id":"c-songshu-045-wyd1739-liucui","paragraph_id":"c-songshu-045-wyd1739-liucui:p013","mention_id":"c-songshu-045-wyd1739-liucui:p013:m0160","quote":"甄法崇"}],"review":"ai_provisional","identity_note":"本單元元嘉三年奉使名單具名，暫發來源局部身份；不因同姓/相近名與別篇人強合。"}],"source_mention_summary":[{"source_id":"s-song064-ws1748217","work_id":"w-songshu","book_id":"b-songshu-064","chapter_id":"c-songshu-064-peisongzhi","raw_mention_count":1,"mention_ids":["c-songshu-064-peisongzhi:p004:m0056"],"paragraph_ids":["c-songshu-064-peisongzhi:p004"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-songshu-064-peisongzhi:p004:m0056","mention_ids":["c-songshu-064-peisongzhi:p004:m0056"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"},{"source_id":"s-songshu-045-wyd1739-liucui","work_id":"w-songshu","book_id":"b-songshu-045","chapter_id":"c-songshu-045-wyd1739-liucui","raw_mention_count":1,"mention_ids":["c-songshu-045-wyd1739-liucui:p013:m0160"],"paragraph_ids":["c-songshu-045-wyd1739-liucui:p013"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-songshu-045-wyd1739-liucui:p013:m0160","mention_ids":["c-songshu-045-wyd1739-liucui:p013:m0160"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-song064-ws1748217","s-songshu-045-wyd1739-liucui"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-songshu-045-wyd1739-liucui:p013:m0160","start":160,"end":163,"surface":"甄法崇","kind":"person","person_id":"rqd_jt6_qdp","paragraph_id":"c-songshu-045-wyd1739-liucui:p013","chapter_id":"c-songshu-045-wyd1739-liucui"},{"id":"c-songshu-064-peisongzhi:p004:m0056","start":56,"end":59,"surface":"甄法崇","kind":"person","person_id":"rqd_jt6_qdp","status":"contextual_provisional","interpretation_note":"本單元元嘉三年奉使名單具名，暫發來源局部身份；不因同姓/相近名與別篇人強合。","paragraph_id":"c-songshu-064-peisongzhi:p004","chapter_id":"c-songshu-064-peisongzhi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-song064-zhenfa","person_id":"rqd_jt6_qdp","surfaces":["甄法崇"],"scope":"same_chapter","status":"contextual_provisional","confidence_level":"medium","identification_basis":{"kind":"source_context","target_mention_ids":["c-songshu-064-peisongzhi:p004:m0056"]},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-064","chapter_id":"c-songshu-064-peisongzhi","source_id":"s-song064-ws1748217","paragraph_id":"c-songshu-064-peisongzhi:p004","quote":"太祖元嘉三年，誅司徒徐羨之等，分遣大使，巡行天下。通直散騎常侍袁渝、司徒左西掾孔邈使揚州，尚書三公郎陸子真、起部甄法崇使荊州，員外散騎常侍范雍、司徒主簿龐遵使南兗州，前尚書右丞孔默使南、北二豫州，撫軍參軍王歆之使徐州，冗從僕射車宗使青兗州，松之使湘州，尚書殿中郎阮長之使雍州，前竟陵太守殷道鸞使益州，員外散騎常侍李耽之使廣州，郎中殷斌使梁州、南秦州，前員外散騎侍郎阮園客使交州，駙馬都尉、奉朝請潘思先使寧州，並兼散騎常侍。班宣詔書曰：「昔王者巡功，群后述職，不然則有存省之禮，聘眺之規。所以觀民立政，命事考績，上下偕通，遐邇咸被，故能功昭長世，道歷遠年。朕以寡闇，屬承洪業，夤畏在位，昧於治道，夕惕惟憂，如臨淵谷。懼國俗陵頹，民風凋僞，眚厲違和，水旱傷業。雖躬勤庶事，思弘攸宜，而機務惟殷，顧循多闕，政刑乖謬，未獲具聞。豈誠素弗孚，使群心莫盡，納隍之愧，在予一人。以歳時多難，王道未壹，卜徵之禮，廢而未修，眷彼氓庶，無忘攸恤。今使兼散騎常侍渝等申令四方，周行郡邑，親見刺史二千石官長，申述至誠，廣詢治要，觀察吏政，訪求民隱，旌舉操行，存問所疾。禮俗得失，一依周典，每各爲書，還具條奏，俾朕昭然，若親覽焉。大夫君子，其各悉心敬事，無惰乃力。其有咨謀遠圖，謹言中誠，陳之使者，無或隱遺。方將敬納良規，以補其闕。勉哉勖之，稱朕意焉。」"}],"rationale":"本單元元嘉三年奉使名單具名，暫發來源局部身份；不因同姓/相近名與別篇人強合。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null}],"equivalence_decisions":[],"passages":[{"id":"c-songshu-045-wyd1739-liucui:p013","text":"開逕邀之戰敗退還郫縣廣等又移營屯箭牽橋方明等破其六營乘勝追奔逕至廣漢廣等走還涪及五城四月十日發道濟喪五月方進軍向涪城張尋唐頻渡水拒戰方明擊破之生擒僞驃騎將軍雍秦二州刺史司馬龍伸斬之龍伸道助也州吏嚴道度斬嚴遐首廣等並奔散涪蜀皆平俄而張尋攻破陰平復與道養合帛氏奴攻廣漢費淡督將軍种松等與戰斬其梁州刺史杜承等百餘級九月益州刺史甄法崇至成都誅費謙之道濟喪及方明等並東反道養等領二千餘家逃於郪山其餘羣賊亦各擁戶藏竄出為寇盜不絕十二","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-songshu-045-wyd1739-liucui:p013:m0010","start":10,"end":11,"surface":"廣","kind":"person","person_id":"n7b_moy_zp3"},{"id":"c-songshu-045-wyd1739-liucui:p013:m0019","start":19,"end":21,"surface":"方明","kind":"person","person_id":"l26_15v_yeo"},{"id":"c-songshu-045-wyd1739-liucui:p013:m0034","start":34,"end":35,"surface":"廣","kind":"person","person_id":"n7b_moy_zp3"},{"id":"c-songshu-045-wyd1739-liucui:p013:m0047","start":47,"end":49,"surface":"道濟","kind":"person","person_id":"8lh_jgi_l6a_*B"},{"id":"c-songshu-045-wyd1739-liucui:p013:m0058","start":58,"end":60,"surface":"張尋","kind":"person","person_id":"g9b_qdj_bh3"},{"id":"c-songshu-045-wyd1739-liucui:p013:m0060","start":60,"end":62,"surface":"唐頻","kind":"person","person_id":"06f_y7r_4z1"},{"id":"c-songshu-045-wyd1739-liucui:p013:m0066","start":66,"end":68,"surface":"方明","kind":"person","person_id":"l26_15v_yeo"},{"id":"c-songshu-045-wyd1739-liucui:p013:m0084","start":84,"end":88,"surface":"司馬龍伸","kind":"person","person_id":"g5q_uxb_7wo_B","resolution_note":"原文明龍伸道助也；司馬是僭號/冒稱語境，不推晉皇室真父系。","interpretation_note":"原文明龍伸道助也；司馬是僭號/冒稱語境，不推晉皇室真父系。"},{"id":"c-songshu-045-wyd1739-liucui:p013:m0090","start":90,"end":92,"surface":"龍伸","kind":"person","person_id":"g5q_uxb_7wo_B"},{"id":"c-songshu-045-wyd1739-liucui:p013:m0092","start":92,"end":94,"surface":"道助","kind":"person","person_id":"g5q_uxb_7wo_B"},{"id":"c-songshu-045-wyd1739-liucui:p013:m0097","start":97,"end":100,"surface":"嚴道度","kind":"person","person_id":"i6r_7ea_ffc"},{"id":"c-songshu-045-wyd1739-liucui:p013:m0101","start":101,"end":103,"surface":"嚴遐","kind":"person","person_id":"0ev_maj_4fc"},{"id":"c-songshu-045-wyd1739-liucui:p013:m0104","start":104,"end":105,"surface":"廣","kind":"person","person_id":"n7b_moy_zp3"},{"id":"c-songshu-045-wyd1739-liucui:p013:m0115","start":115,"end":117,"surface":"張尋","kind":"person","person_id":"g9b_qdj_bh3"},{"id":"c-songshu-045-wyd1739-liucui:p013:m0123","start":123,"end":125,"surface":"道養","kind":"person","person_id":"g5q_uxb_7wo_A"},{"id":"c-songshu-045-wyd1739-liucui:p013:m0126","start":126,"end":129,"surface":"帛氏奴","kind":"person","person_id":"a75_u9k_m93"},{"id":"c-songshu-045-wyd1739-liucui:p013:m0132","start":132,"end":134,"surface":"費淡","kind":"person","person_id":"d9m_f5u_pjf"},{"id":"c-songshu-045-wyd1739-liucui:p013:m0137","start":137,"end":139,"surface":"种松","kind":"person","person_id":"9wc_0x7_wcc"},{"id":"c-songshu-045-wyd1739-liucui:p013:m0148","start":148,"end":150,"surface":"杜承","kind":"person","person_id":"8tn_ac8_lsl"},{"id":"c-songshu-045-wyd1739-liucui:p013:m0160","start":160,"end":163,"surface":"甄法崇","kind":"person","person_id":"rqd_jt6_qdp"},{"id":"c-songshu-045-wyd1739-liucui:p013:m0167","start":167,"end":169,"surface":"費謙","kind":"person","person_id":"jm0_moa_yl8"},{"id":"c-songshu-045-wyd1739-liucui:p013:m0170","start":170,"end":172,"surface":"道濟","kind":"person","person_id":"8lh_jgi_l6a_*B"},{"id":"c-songshu-045-wyd1739-liucui:p013:m0174","start":174,"end":176,"surface":"方明","kind":"person","person_id":"l26_15v_yeo"},{"id":"c-songshu-045-wyd1739-liucui:p013:m0180","start":180,"end":182,"surface":"道養","kind":"person","person_id":"g5q_uxb_7wo_A"}],"source_position":{"raw_projection_ref":"source-evidence/song045-wyd1739-liucui/transcription-projection.json","raw_file_sha256":"ad4c7d261c6ab397efdbf2933f34c491be371368986212d7854860bc96e514e2","unit_key":"unit013","source_layer":"received_chapter","first_line":117,"last_line":126},"chapter_id":"c-songshu-045-wyd1739-liucui","book_id":"b-songshu-045","work_id":"w-songshu","source_id":"s-songshu-045-wyd1739-liucui"},{"text":"太祖元嘉三年，誅司徒徐羨之等，分遣大使，巡行天下。通直散騎常侍袁渝、司徒左西掾孔邈使揚州，尚書三公郎陸子真、起部甄法崇使荊州，員外散騎常侍范雍、司徒主簿龐遵使南兗州，前尚書右丞孔默使南、北二豫州，撫軍參軍王歆之使徐州，冗從僕射車宗使青兗州，松之使湘州，尚書殿中郎阮長之使雍州，前竟陵太守殷道鸞使益州，員外散騎常侍李耽之使廣州，郎中殷斌使梁州、南秦州，前員外散騎侍郎阮園客使交州，駙馬都尉、奉朝請潘思先使寧州，並兼散騎常侍。班宣詔書曰：「昔王者巡功，群后述職，不然則有存省之禮，聘眺之規。所以觀民立政，命事考績，上下偕通，遐邇咸被，故能功昭長世，道歷遠年。朕以寡闇，屬承洪業，夤畏在位，昧於治道，夕惕惟憂，如臨淵谷。懼國俗陵頹，民風凋僞，眚厲違和，水旱傷業。雖躬勤庶事，思弘攸宜，而機務惟殷，顧循多闕，政刑乖謬，未獲具聞。豈誠素弗孚，使群心莫盡，納隍之愧，在予一人。以歳時多難，王道未壹，卜徵之禮，廢而未修，眷彼氓庶，無忘攸恤。今使兼散騎常侍渝等申令四方，周行郡邑，親見刺史二千石官長，申述至誠，廣詢治要，觀察吏政，訪求民隱，旌舉操行，存問所疾。禮俗得失，一依周典，每各爲書，還具條奏，俾朕昭然，若親覽焉。大夫君子，其各悉心敬事，無惰乃力。其有咨謀遠圖，謹言中誠，陳之使者，無或隱遺。方將敬納良規，以補其闕。勉哉勖之，稱朕意焉。」","source_position":{"start":9458,"end":11577,"raw":"　　{{ProperNoun|太祖}}{{YL|元嘉三年}}，誅司徒{{ProperNoun|徐羨之}}等，分遣大使，巡行天下。通直散騎常侍{{ProperNoun|袁渝}}、司徒左西掾<ref>'''左西掾：'''各本並作「左司掾」，{{ProperNoun|張森楷}}校勘記-{云}-：「『司』當作『西』。」按{{ProperNoun|張}}校是，今改正。</ref>{{ProperNoun|孔邈}}使{{ProperNoun|揚州}}，尚書三公郎{{ProperNoun|陸子真}}<ref>'''尚書三公郎{{ProperNoun|陸子真}}：'''{{ProperNoun|孫虨}}{{WavyBookMark|宋書考論}}-{云}-：「所使諸州無{{ProperNoun|江州}}、{{ProperNoun|南徐州}}，蓋{{ProperNoun|陸子真}}使{{ProperNoun|江州}}，{{ProperNoun|-{范}-雍}}使{{ProperNoun|南徐州}}，而史文脫去。{{WavyBookMark|建康實録}}：『{{ProperNoun|元嘉}}四年，散騎常侍{{ProperNoun|陸子真}}薦{{ProperNoun|豫章}}{{ProperNoun|雷次宗}}、{{ProperNoun|尋陽}}{{ProperNoun|陶潛}}。』二郡並{{ProperNoun|江州}}屬，可證也。」</ref>、起部{{ProperNoun|甄法崇}}使{{ProperNoun|荊州}}，員外散騎常侍{{ProperNoun|-{范}-雍}}<ref>'''員外散騎常侍{{ProperNoun|-{范}-雍}}：'''{{ProperNoun|孫虨}}{{WavyBookMark|宋書考論}}-{云}-：「{{ProperNoun|-{范}-雍}}使{{ProperNoun|南徐州}}」，説見前條。</ref>、司徒主簿{{ProperNoun|龐遵}}使{{ProperNoun|南兗州}}，前尚書右丞{{ProperNoun|孔默}}使南、北二{{ProperNoun|豫州}}<ref>'''前尚書右丞{{ProperNoun|孔默}}使南、北二{{ProperNoun|豫州}}：'''{{ProperNoun|孔默}}即{{WavyBookMark|文帝紀}}及{{WavyBookMark|-{范}-曄傳}}之{{ProperNoun|孔默之}}。東晉南北朝人名後之「之」字，有時可省去。</ref>，撫軍參軍{{ProperNoun|王歆之}}使{{ProperNoun|徐州}}，冗從-{僕}-射{{ProperNoun|車宗}}使{{ProperNoun|青}}{{ProperNoun|兗}}州，{{ProperNoun|-{松}-之}}使{{ProperNoun|湘州}}，尚書殿中郎{{ProperNoun|阮長之}}使{{ProperNoun|雍州}}，前{{ProperNoun|竟陵}}太守{{ProperNoun|殷道鸞}}使{{ProperNoun|益州}}，員外散騎常侍{{ProperNoun|李耽之}}使{{ProperNoun|廣州}}，郎中{{ProperNoun|殷斌}}使{{ProperNoun|梁州}}、{{ProperNoun|南秦州}}，前員外散騎侍郎{{ProperNoun|阮園客}}使{{ProperNoun|交州}}，駙馬都尉、奉朝請{{ProperNoun|潘思先}}使{{ProperNoun|寧州}}，並兼散騎常侍。班宣詔書曰：「昔王者巡功，群-{后}-述職，不然則有存省之禮，聘眺之規。所以觀民立政，命事考績，上下偕通，遐邇咸被，故能功昭長世，道歷遠年。朕以寡闇，屬承洪業，夤畏在位，昧-{於}-治道，夕惕惟憂，如臨淵-{谷}-。懼國俗陵頹，民風凋僞，眚厲違和，水旱傷業。雖躬勤庶事<ref>'''雖躬勤庶事：'''「躬勤」各本並作「勤躬」，據{{WavyBookMark|元龜}}二一三乙正。</ref>，思弘攸宜，而機務惟殷，顧循多闕，政刑乖謬，未獲具聞。豈誠素弗孚，使群心莫盡，納隍之愧，在予一人。以歳時多難，王道未壹，卜-{徵}-之禮，廢而未修，眷彼氓庶<ref>'''眷彼氓庶：'''「彼」各本並作「被」。{{ProperNoun|張元濟}}、{{ProperNoun|張森楷}}校勘記-{云}-：「『被』當作『彼』。」按二{{ProperNoun|張}}校是，今改正。</ref>，無忘攸恤<ref>'''無忘攸恤：'''「攸」各本並作「欽」，據{{WavyBookMark|元龜}}二一三改。</ref>。今使兼散騎常侍渝等申令四方，周行郡邑，親見刺史二千石官長，申述至誠，廣詢治要，觀察吏政，訪求民隱，旌舉操行，存問所疾。禮俗得失，一依周典，每各爲書，還具條奏，俾朕昭然，若親覽焉。大夫君子，其各悉心敬事，無惰乃力。其有咨謀遠圖，謹言中誠，陳之使者，無或隱遺。方將敬納良規，以補其闕。勉哉勖之，稱朕意焉。」","raw_path":"sources/songshu/wikisource-1748217-raw.wikitext"},"id":"c-songshu-064-peisongzhi:p004","mentions":[{"id":"c-songshu-064-peisongzhi:p004:m0000","start":0,"end":2,"surface":"太祖","kind":"person","person_id":"3qs_nqa_ioa_AAAA","status":"contextual_provisional","interpretation_note":"元嘉三年誅徐羨之、後注三國志及十四年致仕二十八年卒，宋太祖義隆；詔朕/予及奉使奏陛下皆同在位者，不接晉孝武。"},{"id":"c-songshu-064-peisongzhi:p004:m0010","start":10,"end":13,"surface":"徐羨之","kind":"person","person_id":"4y6_myv_ojh","status":"contextual_provisional","interpretation_note":"元嘉三年誅司徒徐羨之，同既有宋書人物及事件。"},{"id":"c-songshu-064-peisongzhi:p004:m0031","start":31,"end":33,"surface":"袁渝","kind":"person","person_id":"9lx_kao_hgu","status":"contextual_provisional","interpretation_note":"本單元元嘉三年奉使名單具名，暫發來源局部身份；不因同姓/相近名與別篇人強合。"},{"id":"c-songshu-064-peisongzhi:p004:m0039","start":39,"end":41,"surface":"孔邈","kind":"person","person_id":"jna_8qn_a7p","status":"contextual_provisional","interpretation_note":"本單元元嘉三年奉使名單具名，暫發來源局部身份；不因同姓/相近名與別篇人強合。"},{"id":"c-songshu-064-peisongzhi:p004:m0050","start":50,"end":53,"surface":"陸子真","kind":"person","person_id":"bwi_et2_b4c","status":"contextual_provisional","interpretation_note":"本單元元嘉三年奉使名單具名，暫發來源局部身份；不因同姓/相近名與別篇人強合。"},{"id":"c-songshu-064-peisongzhi:p004:m0056","start":56,"end":59,"surface":"甄法崇","kind":"person","person_id":"rqd_jt6_qdp","status":"contextual_provisional","interpretation_note":"本單元元嘉三年奉使名單具名，暫發來源局部身份；不因同姓/相近名與別篇人強合。"},{"id":"c-songshu-064-peisongzhi:p004:m0069","start":69,"end":71,"surface":"范雍","kind":"person","person_id":"frb_s6a_c0v","status":"contextual_provisional","interpretation_note":"本單元元嘉三年奉使名單具名，暫發來源局部身份；不因同姓/相近名與別篇人強合。"},{"id":"c-songshu-064-peisongzhi:p004:m0076","start":76,"end":78,"surface":"龐遵","kind":"person","person_id":"vhu_38t_vkn","status":"contextual_provisional","interpretation_note":"本單元元嘉三年奉使名單具名，暫發來源局部身份；不因同姓/相近名與別篇人強合。"},{"id":"c-songshu-064-peisongzhi:p004:m0088","start":88,"end":90,"surface":"孔默","kind":"person","person_id":"vhw_07a_wzm_AB","status":"contextual_provisional","interpretation_note":"正文孔默，數位校注指孔默之；既有宋093默之元嘉儒學/朝臣相合，暫定同人；「之」省稱不改原字，校注作編者reference而非冒正文。"},{"id":"c-songshu-064-peisongzhi:p004:m0102","start":102,"end":105,"surface":"王歆之","k