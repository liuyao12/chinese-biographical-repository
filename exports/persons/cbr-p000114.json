v_rm5_7gw","status":"contextual_provisional","paragraph_id":"c-shiji-034-yan:p002","chapter_id":"c-shiji-034-yan"}],"relations":[{"id":"a-shiji003-023","subject_person_id":"k2v_rm5_7gw","predicate":"father","object_person_id":"fr3_x62_cai","status":"source_attested","evidence":[{"paragraph_id":"c-shiji-003-yin:p017","quote":"河亶甲崩，子帝祖乙立","chapter_id":"c-shiji-003-yin","source_id":"s-shiji-003-yin"}],"qualifiers":{"source_term":"子","historicity":"historical_tradition"},"interpretation_note":"保存原文明示關係；不把繼位本身當作父子證據，未與出土材料對讀。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji003-024","subject_person_id":"xx9_ni7_l9f","predicate":"father","object_person_id":"k2v_rm5_7gw","status":"source_attested","evidence":[{"paragraph_id":"c-shiji-003-yin:p017","quote":"祖乙崩，子帝祖辛立","chapter_id":"c-shiji-003-yin","source_id":"s-shiji-003-yin"}],"qualifiers":{"source_term":"子","historicity":"historical_tradition"},"interpretation_note":"保存原文明示關係；不把繼位本身當作父子證據，未與出土材料對讀。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji034-011","person_id":"k2v_rm5_7gw","surfaces":["祖乙"],"scope":"cross_chapter","chapter_ids":["c-shiji-003-yin","c-shiji-034-yan"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-003-yin:p017","quote":"中宗崩，子帝中丁立。帝中丁遷于隞，河亶甲居相，祖乙遷于邢。帝中丁崩，弟外壬立，是為帝外壬。仲丁書闕不具。帝外壬崩，弟河亶甲立，是為帝河亶甲。河亶甲時，殷復衰。河亶甲崩，子帝祖乙立。帝祖乙立，殷復興。巫賢任職。祖乙崩，子帝祖辛立。帝祖辛崩，弟沃甲立，是為帝沃甲。帝沃甲崩，立沃甲兄祖辛之子祖丁，是為帝祖丁。帝祖丁崩，立弟沃甲之子南庚，是為帝南庚。帝南庚崩，立帝祖丁之子陽甲，是為帝陽甲。帝陽甲之時，殷衰。"},{"paragraph_id":"c-shiji-034-yan:p002","quote":"其在成王時，召王爲三公：自陜以西，召公主之；自陜以東，周公主之。成王旣幼，周公攝政，當國踐祚，召公疑之，作君奭。君奭不説周公。周公乃稱「湯時有伊尹，假于皇天；在太戊時，則有若伊陟、臣扈，假于上帝，巫咸治王家；在祖乙時，則有若巫賢；在武丁時，則有若甘般：率維茲有陳，保乂有殷」。於是召公乃説。"}],"rationale":"依周初封建、燕君世系、割地救燕、讓國及秦滅諸國的具體語境暫定異稱。繼位不自動證父子；同爵者分國別與前後世代。太子平／燕昭王依本篇明示，不表示年代及世系已校定。作君奭為書名，君奭不説之君奭才暫解召公稱呼。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-003-yin:p017","text":"中宗崩，子帝中丁立。帝中丁遷于隞，河亶甲居相，祖乙遷于邢。帝中丁崩，弟外壬立，是為帝外壬。仲丁書闕不具。帝外壬崩，弟河亶甲立，是為帝河亶甲。河亶甲時，殷復衰。河亶甲崩，子帝祖乙立。帝祖乙立，殷復興。巫賢任職。祖乙崩，子帝祖辛立。帝祖辛崩，弟沃甲立，是為帝沃甲。帝沃甲崩，立沃甲兄祖辛之子祖丁，是為帝祖丁。帝祖丁崩，立弟沃甲之子南庚，是為帝南庚。帝南庚崩，立帝祖丁之子陽甲，是為帝陽甲。帝陽甲之時，殷衰。","mentions":[{"id":"c-shiji-003-yin:m017-0000","start":0,"end":2,"surface":"中宗","kind":"person","person_id":"ta6_n0m_glj","status":"source_identified"},{"id":"c-shiji-003-yin:m017-0005","start":5,"end":8,"surface":"帝中丁","kind":"person","person_id":"xt7_zq6_tu6","status":"source_identified"},{"id":"c-shiji-003-yin:m017-0010","start":10,"end":13,"surface":"帝中丁","kind":"person","person_id":"xt7_zq6_tu6","status":"source_identified"},{"id":"c-shiji-003-yin:m017-0017","start":17,"end":20,"surface":"河亶甲","kind":"person","person_id":"fr3_x62_cai","status":"source_identified"},{"id":"c-shiji-003-yin:m017-0023","start":23,"end":25,"surface":"祖乙","kind":"person","person_id":"k2v_rm5_7gw","status":"source_identified"},{"id":"c-shiji-003-yin:m017-0029","start":29,"end":32,"surface":"帝中丁","kind":"person","person_id":"xt7_zq6_tu6","status":"source_identified"},{"id":"c-shiji-003-yin:m017-0035","start":35,"end":37,"surface":"外壬","kind":"person","person_id":"6pj_g2n_v7a","status":"source_identified"},{"id":"c-shiji-003-yin:m017-0041","start":41,"end":44,"surface":"帝外壬","kind":"person","person_id":"6pj_g2n_v7a","status":"source_identified"},{"id":"c-shiji-003-yin:m017-0052","start":52,"end":55,"surface":"帝外壬","kind":"person","person_id":"6pj_g2n_v7a","status":"source_identified"},{"id":"c-shiji-003-yin:m017-0058","start":58,"end":61,"surface":"河亶甲","kind":"person","person_id":"fr3_x62_cai","status":"source_identified"},{"id":"c-shiji-003-yin:m017-0065","start":65,"end":69,"surface":"帝河亶甲","kind":"person","person_id":"fr3_x62_cai","status":"source_identified"},{"id":"c-shiji-003-yin:m017-0070","start":70,"end":73,"surface":"河亶甲","kind":"person","person_id":"fr3_x62_cai","status":"source_identified"},{"id":"c-shiji-003-yin:m017-0079","start":79,"end":82,"surface":"河亶甲","kind":"person","pe