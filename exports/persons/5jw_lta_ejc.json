ns":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-weishu-weishou-024-cuidaogu:p004:m0082","start":82,"end":85,"surface":"崔啟之","kind":"person","person_id":"5jw_lta_ejc","identification_status":"contextual_provisional","interpretation_note":"據本段發言、親屬或任事語境辨識。","paragraph_id":"c-weishu-weishou-024-cuidaogu:p004","chapter_id":"c-weishu-weishou-024-cuidaogu"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-weishu-weishou-024-cuidaogu:p004","text":"皇興初，顯祖詔征南大將軍慕容白曜固築長圍以守之。及白曜攻其城東郭，道固面縛請罪，表曰：「臣資生南境，限隔大化，本朝不以卑末，委授藩任。而劉氏蕭牆內侮，懼貽大戮，前遣崔啟之奉表歸誠，幸蒙陛下過垂矜納，并賜爵寵，慶佩罔極，應奔闕庭。但劉彧尋續遣使，恕臣百死。愚以世奉劉氏，深愆蒙宥，若猶違背，則是不忠於本朝，而欲求忠於大魏。雖曰希生，懼大魏之所不許。是用迷回，孤負天日，冒萬死之艱，固執拒守。僕臣白曜，振曜威靈，漸經二載，大將臨城，以今月十四日，臣東郭失守，於臣款彧之誠，庶可以彰於大魏矣。臣勢窮力屈，以十七日面縛請罪，白曜奉宣皇恩，恕臣生命。斯實陛下起臣死尸，肉臣朽骨，天地造物所不能行，而陛下育之。雖虞舜之貸有苗，姬文之宥崇壘，方之聖澤，未足以喻。既未奉朝旨，無由親馳道路，謹遣大息景徽，束骸歸闕，伏聽刑斧。」","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-weishu-weishou-024-cuidaogu:p004:m0012","start":12,"end":16,"surface":"慕容白曜","kind":"person","person_id":"bm0_pqc_ydf","identification_status":"contextual_provisional","interpretation_note":"據本段發言、親屬或任事語境辨識。"},{"id":"c-weishu-weishou-024-cuidaogu:p004:m0025","start":25,"end":27,"surface":"白曜","kind":"person","person_id":"bm0_pqc_ydf","identification_status":"contextual_provisional","interpretation_note":"據本段發言、親屬或任事語境辨識。"},{"id":"c-weishu-weishou-024-cuidaogu:p004:m0033","start":33,"end":35,"surface":"道固","kind":"person","person_id":"23q_wcp_hny","identification_status":"contextual_provisional","interpretation_note":"據本段發言、親屬或任事語境辨識。"},{"id":"c-weishu-weishou-024-cuidaogu:p004:m0082","start":82,"end":85,"surface":"崔啟之","