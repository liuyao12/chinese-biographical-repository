licy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-105-bianque:m018-0000","start":0,"end":6,"surface":"齊中御府長信","kind":"person","person_id":"afe_vxj_iuk","status":"contextual_provisional","paragraph_id":"c-shiji-105-bianque:p018","chapter_id":"c-shiji-105-bianque"},{"id":"c-shiji-105-bianque:m018-0056","start":56,"end":57,"surface":"信","kind":"person","person_id":"afe_vxj_iuk","status":"contextual_provisional","paragraph_id":"c-shiji-105-bianque:p018","chapter_id":"c-shiji-105-bianque"},{"id":"c-shiji-105-bianque:m018-0088","start":88,"end":89,"surface":"信","kind":"person","person_id":"afe_vxj_iuk","status":"contextual_provisional","paragraph_id":"c-shiji-105-bianque:p018","chapter_id":"c-shiji-105-bianque"},{"id":"c-shiji-105-bianque:m018-0104","start":104,"end":105,"surface":"信","kind":"person","person_id":"afe_vxj_iuk","status":"contextual_provisional","paragraph_id":"c-shiji-105-bianque:p018","chapter_id":"c-shiji-105-bianque"},{"id":"c-shiji-105-bianque:m018-0117","start":117,"end":118,"surface":"信","kind":"person","person_id":"afe_vxj_iuk","status":"contextual_provisional","paragraph_id":"c-shiji-105-bianque:p018","chapter_id":"c-shiji-105-bianque"},{"id":"c-shiji-105-bianque:m018-0194","start":194,"end":195,"surface":"信","kind":"person","person_id":"afe_vxj_iuk","status":"contextual_provisional","paragraph_id":"c-shiji-105-bianque:p018","chapter_id":"c-shiji-105-bianque"}],"relations":[],"title_holdings":[{"id":"th-shiji105-006","person_id":"afe_vxj_iuk","title":"中御府長","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-105-bianque","source_id":"s-shiji-105-bianque","paragraph_id":"c-shiji-105-bianque:p018","quote":"齊中御府長信病，臣意入診其脈，告曰：「熱病氣也。然暑汗，脈少衰，不死。」曰：「此病得之當浴流水而寒甚，已則熱。」信曰：「唯，然！往冬時，為王使於楚，至莒縣陽周水，而莒橋梁頗壞，信則擥車轅未欲渡也，馬驚，即墮，信身入水中，幾死，吏即來救信，出之水中，衣盡濡，有閒而身寒，已熱如火，至今不可以見寒。」臣意即為之液湯火齊逐熱，一飲汗盡，再飲熱去，三飲病已。即使服藥，出入二十日，身無病者。所以知信之病者，切其脈時，并陰。脈法曰「熱病陰陽交者死」。切之不交，并陰。并陰者，脈順清而愈，其熱雖未盡，猶活也。腎氣有時閒濁，在太陰脈口而希，是水氣也。腎固主水，故以此知之。失治一時，即轉為寒熱。"}],"attestations":[{"id":"th-shiji105-006:a001","paragraph_id":"c-shiji-105-bianque:p018","start":1,"end":5,"surface":"中御府長","person_mention_id":"c-shiji-105-bianque:m018-0000","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"保存原文用稱；唐安除為齊王侍醫記任命事件，其餘不以用稱推定任期起點。不以死亡補終點。王禹與高期依並列語法共繫太醫，陽虛侯相與家丞是官職而非本人封侯。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji105-030","person_id":"afe_vxj_iuk","surfaces":["信","齊中御府長信"],"scope":"same_chapter","chapter_ids":["c-shiji-105-bianque"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-105-bianque:p018","quote":"齊中御府長信病，臣意入診其脈，告曰：「熱病氣也。然暑汗，脈少衰，不死。」曰：「此病得之當浴流水而寒甚，已則熱。」信曰：「唯，然！往冬時，為王使於楚，至莒縣陽周水，而莒橋梁頗壞，信則擥車轅未欲渡也，馬驚，即墮，信身入水中，幾死，吏即來救信，出之水中，衣盡濡，有閒而身寒，已熱如火，至今不可以見寒。」臣意即為之液湯火齊逐熱，一飲汗盡，再飲熱去，三飲病已。即使服藥，出入二十日，身無病者。所以知信之病者，切其脈時，并陰。脈法曰「熱病陰陽交者死」。切之不交，并陰。并陰者，脈順清而愈，其熱雖未盡，猶活也。腎氣有時閒濁，在太陰脈口而希，是水氣也。腎固主水，故以此知之。失治一時，即轉為寒熱。"}],"rationale":"依本篇姓名、原稱及敘事回指暫定；醫案引語與附載注釋分層，未按同名自動跨篇合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-105-bianque:p018","text":"齊中御府長信病，臣意入診其脈，告曰：「熱病氣也。然暑汗，脈少衰，不死。」曰：「此病得之當浴流水而寒甚，已則熱。」信曰：「唯，然！往冬時，為王使於楚，至莒縣陽周水，而莒橋梁頗壞，信則擥車轅未欲渡也，馬驚，即墮，信身入水中，幾死，吏即來救信，出之水中，衣盡濡，有閒而身寒，已熱如火，至今不可以見寒。」臣意即為之液湯火齊逐熱，一飲汗盡，再飲熱去，三飲病已。即使服藥，出入二十日，身無病者。所以知信之病者，切其脈時，并陰。脈法曰「熱病陰陽交者死」。切之不交，并陰。并陰者，脈順清而愈，其熱雖未盡，猶活也。腎氣有時閒濁，在太陰脈口而希，是水氣也。腎固主水，故以此知之。失治一時，即轉為寒熱。","annotation_status":"named_mentions_first_pass","text_layer":"rece