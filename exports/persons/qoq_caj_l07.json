n_id":"qoq_caj_l07","status":"contextual"},{"id":"c-jinshu-034-duyu:p005:m0126","start":126,"end":127,"surface":"預","kind":"person","person_id":"56f_8f7_e9f_AA","status":"contextual"},{"id":"c-jinshu-034-duyu:p005:m0150","start":150,"end":151,"surface":"預","kind":"person","person_id":"56f_8f7_e9f_AA","status":"contextual"},{"id":"c-jinshu-034-duyu:p005:m0152","start":152,"end":153,"surface":"主","kind":"person","person_id":"962_748_fr2","status":"contextual"},{"id":"c-jinshu-034-duyu:p005:m0172","start":172,"end":173,"surface":"預","kind":"person","person_id":"56f_8f7_e9f_AA","status":"contextual"}],"chapter_id":"c-jinshu-034-duyu","book_id":"b-jinshu-034","work_id":"w-jinshu","source_id":"s-jinshu-034-ws2567662-duyu"},{"id":"c-jinshu-034-duyu:p006","text":"是時朝廷皆以預明於籌略，會匈奴帥劉猛舉兵反，自并州西及河東、平陽，詔預以散侯定計省闥，俄拜度支尚書。預乃奏立藉田，建安邊，論處軍國之要。又作人排新器，興常平倉，定穀價，較鹽運，制課調，內以利國外以救邊者五十餘條，皆納焉。石鑒自軍還，論功不實，為預所糾，遂相仇恨，言論喧嘩，並坐免官，以侯兼本職。數年，復拜度支尚書。","text_layer":"received_chapter","source_position":{"raw_start":8121,"raw_end":8280,"raw_character_offsets":[8123,8124,8125,8126,8127,8128,8129,8130,8131,8132,8133,8134,8135,8136,8137,8138,8139,8140,8141,8142,8143,8144,8145,8146,8147,8148,8149,8150,8151,8152,8153,8154,8155,8156,8157,8158,8159,8160,8161,8162,8163,8164,8165,8166,8167,8168,8169,8170,8171,8172,8173,8174,8175,8176,8177,8178,8179,8180,8181,8182,8183,8184,8185,8186,8187,8188,8189,8190,8191,8192,8193,8194,8195,8196,8197,8198,8199,8200,8201,8202,8203,8204,8205,8206,8207,8208,8209,8210,8211,8212,8213,8214,8215,8216,8217,8218,8219,8220,8221,8222,8223,8224,8225,8226,8227,8228,8229,8230,8231,8232,8233,8234,8235,8236,8237,8238,8239,8240,8241,8242,8243,8244,8245,8246,8247,8248,8249,8250,8251,8252,8253,8254,8255,8256,8257,8258,8259,8260,8261,8262,8263,8264,8265,8266,8267,8268,8269,8270,8271,8272,8273,8274,8275,8276,8277,8278,8279],"first_line":97,"last_line":97,"revision_id":2567662,"projection_sha256":"b4be271ac703e26c004f3373a8f9b155926beaafd6400c5541fd033dc6a5c108","source_layer":"received_biography","edit