:null,"interpretation_note":"與預同段並坐免官。","fixed_source_fact_binding":{"kind":"fixed_witness_person_fact_slots","key":"jin034-duyu-kinship","slot":"career_025"},"chapter_id":"c-jinshu-034-duyu","kind":"removal_report","source_term":"並坐免官","source_anchor":{"paragraph_id":"c-jinshu-034-duyu:p006","start":136,"end":140,"surface":"並坐免官"},"source_revision":2567662,"paragraph_sha256":"0db32a90dad6b26c10c97d2acba8b845ac88ac1e5dd3464676086d81a94997a2","values":{"report_code":"received_career_context","tenure_boundary":false,"all_offices_ended":false,"which_prior_offices_ended":"not_normalized"}}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-034-duyu:p005:m0004","start":4,"end":6,"surface":"石鑒","kind":"person","person_id":"qoq_caj_l07","status":"contextual","paragraph_id":"c-jinshu-034-duyu:p005","chapter_id":"c-jinshu-034-duyu"},{"id":"c-jinshu-034-duyu:p005:m0070","start":70,"end":72,"surface":"石鑒","kind":"person","person_id":"qoq_caj_l07","status":"contextual","paragraph_id":"c-jinshu-034-duyu:p005","chapter_id":"c-jinshu-034-duyu"},{"id":"c-jinshu-034-duyu:p005:m0120","start":120,"end":121,"surface":"鑒","kind":"person","person_id":"qoq_caj_l07","status":"contextual","paragraph_id":"c-jinshu-034-duyu:p005","chapter_id":"c-jinshu-034-duyu"},{"id":"c-jinshu-034-duyu:p006:m0110","start":110,"end":112,"surface":"石鑒","kind":"person","person_id":"qoq_caj_l07","status":"contextual","paragraph_id":"c-jinshu-034-duyu:p006","chapter_id":"c-jinshu-034-duyu"},{"id":"c-jinshu-043-shantao:p002:m0031","start":31,"end":33,"surface":"石鑒","kind":"person","person_id":"qoq_caj_l07","status":"contextual_provisional","resolution_note":"按本段主體、引語發受話人及完整附傳範圍辨識；非全域同字匹配。","paragraph_id":"c-jinshu-043-shantao:p002","chapter_id":"c-jinshu-043-shantao"},{"id":"c-jinshu-043