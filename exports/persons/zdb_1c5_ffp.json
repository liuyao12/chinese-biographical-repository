n-polities-complete:p021","c-nanqishu-059-western-polities-complete:p022","c-nanqishu-059-western-polities-complete:p023"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-nanqishu-059-western-polities-complete:p017:m0105","mention_ids":["c-nanqishu-059-western-polities-complete:p017:m0105"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-059-western-polities-complete:p019:m0020","mention_ids":["c-nanqishu-059-western-polities-complete:p019:m0020"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-059-western-polities-complete:p020:m0056","mention_ids":["c-nanqishu-059-western-polities-complete:p020:m0056"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-059-western-polities-complete:p021:m0000","mention_ids":["c-nanqishu-059-western-polities-complete:p021:m0000"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-059-western-polities-complete:p022:m0022","mention_ids":["c-nanqishu-059-western-polities-complete:p022:m0022"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-059-western-polities-complete:p022:m0101","mention_ids":["c-nanqishu-059-western-polities-complete:p022:m0101"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-059-western-polities-complete:p023:m0003","mention_ids":["c-nanqishu-059-western-polities-complete:p023:m0003"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-059-western-polities-complete:p023:m0033","mention_ids":["c-nanqishu-059-western-polities-complete:p023:m0033"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-059-western-polities-complete:p023:m0046","mention_ids":["c-nanqishu-059-western-polities-complete:p023:m0046"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-059-western-polities-complete:p023:m0108","mention_ids":["c-nanqishu-059-western-polities-complete:p023:m0108"],"kind":"paragraph"}],"mention_count":10,"duplicate_mention_count":0,"paragraph_occurrence_count":10,"table_occurrence_count":0,"passage_count":6,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"10處獨立位置，10個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-nanqishu-059-western-polities-complete-ws1748911"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-nanqishu-059-western-polities-complete:source_review21-0","kind":"source_review","person_id":"zdb_1c5_ffp","source_quote":"文弘容納叛戾，專為淵藪，外侮皇威，內凌國族。君弈世忠款，深識理順，想即起義，應接大軍，共為掎角，討滅烏奴，剋建忠勤，茂立誠節。沈攸之資十年之積，權百旅之眾，師出境而城潰，兵未戰而自屠，朝廷無遺鏃之費，士民靡傷痍之弊。況蕞爾小豎，方之篾如，其取殲殄，豈延漏刻。忝以寡昧，分陝司蕃，清氛蕩穢，諒惟任職。此府器械山積，戈旗林聳，士卒剽勁，蓄銳權威，除難剿寇，豈俟徵習！但以剪伐萌菌，弗勞洪斧，撲彼蚊蚋，無假多力。皇上聖哲應期，恩澤廣被，罪止首惡，餘無所問。賞罰之科，具寫如別。","reading":"續書責楊文弘並促廣香相應。所舉沈攸之為書中比較；權威和徵習異字附注。","note":"續書責楊文弘並促廣香相應。所舉沈攸之為書中比較；權威和徵習異字附注。","paragraph_id":"c-nanqishu-059-western-polities-complete:p021","start_codepoint":0,"end_codepoint":235,"human_reviewed":false,"chapter_id":"c-nanqishu-059-western-polities-complete","source_id":"s-nanqishu-059-western-polities-complete-ws1748911"},{"id":"c-nanqishu-059-western-polities-complete:source_review23-0","kind":"source_review","person_id":"zdb_1c5_ffp","source_quote":"三年，文弘歸降，復以為征西將軍、北秦州刺史。先是廣香病死，氐眾半奔文弘，半詣梁州刺史崔慧景。文弘遣從子後起進據白水。白水居晉壽上流，西接涪界，東帶益路，北連陰平、茄蘆，為形勝之地。晉壽太守楊公則啟經略之宜，上答曰：「文弘罪不可恕，事中政應且加恩耳。卿若能襲破白水，必加厚賞。」","reading":"文弘復降、楊廣香病死、部眾分往及後起居白水分述，崔慧景是梁州刺史。","note":"文弘復降、楊廣香病死、部眾分往及後起居白水分述，崔慧景是梁州刺史。","paragraph_id":"c-nanqishu-059-western-polities-complete:p023","start_codepoint":0,"end_codepoint":138,"human_reviewed":false,"chapter_id":"c-nanqishu-059-western-polities-complete","source_id":"s-nanqishu-059-western-polities-complete-ws1748911"},{"id":"c-nanqishu-059-western-polities-complete:source_review32-0","kind":"source_review","person_id":"zdb_1c5_ffp","source_quote":"自虜陷仇池以後，或得或失。宋以仇池為郡，故以氐封焉。","reading":"史家總結仇池自宋以來得失及設郡、封爵緣由。","note":"史家總結仇池自宋以來得失及設郡、封爵緣由。","paragraph_id":"c-nanqishu-059-western-polities-complete:p032","start_codepoint":0,"end_codepoint":26,"human_reviewed":false,"chapter_id":"c-nanqishu-059-western-polities-complete","source_id":"s-nanqishu-059-western-polities-complete-ws1748911"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-059-western-polities-complete:p017:m0105","start":105,"end":107,"surface":"文弘","kind":"person","person_id":"zdb_1c5_ffp","status":"contextual_provisional","paragraph_id":"c-nanqishu-059-western-polities-complete:p017","chapter_id":"c-nanqishu-059-western-polities-complete"},{"id":"c-nanqishu-059-western-polities-complete:p019:m0020","start":20,"end":22,"surface":"文弘","kind":"person","person_id":"zdb_1c5_ffp","status":"contextual_provisional","paragraph_id":"c-nanqishu-059-western-polities-complete:p019","chapter_id":"c-nanqishu-059-western-polities-complete"},{"id":"c-nanqishu-059-western-polities-complete:p020:m0056","start":56,"end":59,"surface":"楊文弘","kind":"person","person_id":"zdb_1c5_ffp","status":"contextual_provisional","paragraph_id":"c-nanqishu-059-western-polities-complete:p020","chapter_id":"c-nanqishu-059-western-polities-complete"},{"id":"c-nanqishu-059-western-polities-complete:p021:m0000","start":0,"end":2,"surface":"文弘","kind":"person","person_id":"zdb_1c5_ffp","status":"contextual_provisional","paragraph_id":"c-nanqishu-059-western-polities-complete:p021","chapter_id":"c-nanqishu-059-western-polities-complete"},{"id":"c-nanqishu-059-western-polities-complete:p022:m0022","start":22,"end":24,"surface":"文弘","kind":"person","person_id":"zdb_1c5_ffp","status":"contextual_provisional","paragraph_id":"c