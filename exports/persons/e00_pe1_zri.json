_ids":["c-shiji-114-dongyue:p001","c-shiji-114-dongyue:p004"],"table_cell_ids":[],"passage_count":2}],"most_mentioned_source_ids":["s-shiji114-dongyue"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji114-001","subject_person_id":"e00_pe1_zri","predicate":"ancestor","object_person_id":"i7a_22p_qda","status":"source_attested","evidence":[{"chapter_id":"c-shiji-114-dongyue","source_id":"s-shiji114-dongyue","paragraph_id":"c-shiji-114-dongyue:p001","quote":"閩越王無諸及越東海王搖者，其先皆越王句踐之後也，姓騶氏。秦已并天下，皆廢為君長，以其地為閩中郡。及諸侯畔秦，無諸、搖率越歸鄱陽令吳芮，所謂鄱君者也，從諸侯滅秦。當是之時，項籍主命，弗王，以故不附楚。漢擊項籍，無諸、搖率越人佐漢。漢五年，復立無諸為閩越王，王閩中故地，都東冶。孝惠三年，舉高帝時越功，曰閩君搖功多，其民便附，乃立搖為東海王，都東甌，世俗號為東甌王。"}],"qualifiers":{"source_term":"其先皆越王句踐之後"},"interpretation_note":"正文後裔主張，世代未知，不作直接父親或據此預接長系譜。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji114-004","subject_person_id":"e00_pe1_zri_*A","predicate":"grandfather","object_person_id":"e00_pe1_zri","status":"source_attested","evidence":[{"chapter_id":"c-shiji-114-dongyue","source_id":"s-shiji114-dongyue","paragraph_id":"c-shiji-114-dongyue:p004","quote":"至建元六年，閩越擊南越。南越守天子約，不敢擅發兵擊而以聞。上遣大行王恢出豫章，大農韓安國出會稽，皆為將軍。兵未踰嶺，閩越王郢發兵距險。其弟餘善乃與相、宗族謀曰：「王以擅發兵擊南越，不請，故天子兵來誅。今漢兵眾彊，今即幸勝之，后來益多，終滅國而止。今殺王以謝天子。天子聽，罷兵，固一國完；不聽，乃力戰；不勝，即亡入海。」皆曰「善」。即鏦殺王，使使奉其頭致大行。大行曰：「所為來者誅王。今王頭至，謝罪，不戰而耘，利莫大焉。」乃以便宜案兵告大農軍，而使使奉王頭馳報天子。詔罷兩將兵，曰：「郢等首惡，獨無諸孫繇君丑不與謀焉。」乃使郎中將立丑為越繇王，奉閩越先祭祀。"}],"qualifiers":{"source_term":"無諸孫繇君丑"},"interpretation_note":"明記孫，保留兩代距離與未名父親，不與居股同爵合併。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-114-dongyue:m001-0003","start":3,"end":5,"surface":"無諸","kind":"person","perso