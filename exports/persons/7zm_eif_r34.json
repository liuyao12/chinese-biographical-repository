nguozhi-053-xueying"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-wu053-xueying2","person_id":"7zm_eif_r34","event_type":"death","source_term":"昭、廣先亡","date_expression":null,"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-053","chapter_id":"c-sanguozhi-053-xueying","source_id":"s-sanguozhi-053-xueying","paragraph_id":"c-sanguozhi-053-xueying:line066","quote":"臣聞五帝三王皆立史官，敘錄功美，垂之無窮。漢時司馬遷、班固，咸命世大才，所撰精妙，與六經俱傳。大吳受命，建國南土。大皇帝末年，命太史令丁孚、郎中項峻始撰《吳書》。孚、峻俱非史才，其所撰作，不足紀錄。至少帝時，更差韋曜、周昭、薛瑩、梁廣及臣五人，訪求往事，所共撰立，備有本末。昭、廣先亡，曜負恩蹈罪，瑩出為將，復以過徙，其書遂委滯，迄今末撰奏。臣愚淺才劣，適可為瑩等記注而已，若使撰合，必襲孚、峻之跡，懼墜大皇帝之元功，損當世之盛美。瑩涉學既博，文章尤妙，同寮之中，瑩為冠首。今者見吏，雖多經學，記述之才，如瑩者少，是以慺慺為國惜之。實欲使卒垂成之功，編於前史之末。奏上之後，退填溝壑，無所復恨。","person_mention_id":"c-sanguozhi-053-xueying:line066:m0115"}],"interpretation_note":"本來源所記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-sanguozhi-053-xueying:line066:m0115","start":115,"end":117,"surface":"梁廣","kind":"person","person_id":"7zm_eif_r34","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-053-xueying:line066","chapter_id":"c-sanguozhi-053-xueying"},{"id":"c-sanguozhi-053-xueying:line066:m0139","start":139,"end":140,"surface":"廣","kind":"person","person_id":"7zm_eif_r34","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-053-xueying:lin