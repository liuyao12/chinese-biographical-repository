詳擇所宜，以時敷奏。歡近已加旍賁，思效可付選銓序，以顯讜言。」歡東歸，上賜麈尾、素琴。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":52,"last_line":52,"raw_start":2607,"raw_end":2741,"raw_character_offsets":[2607,2608,2609,2610,2611,2612,2613,2614,2615,2616,2617,2618,2619,2620,2621,2622,2623,2624,2625,2626,2627,2628,2629,2630,2631,2632,2633,2634,2635,2636,2637,2638,2639,2640,2641,2642,2643,2644,2645,2646,2647,2648,2649,2650,2651,2652,2653,2654,2655,2656,2657,2658,2659,2660,2661,2662,2663,2664,2665,2666,2667,2668,2669,2670,2671,2672,2673,2674,2675,2676,2677,2678,2679,2680,2681,2682,2683,2684,2685,2686,2687,2688,2689,2690,2691,2692,2693,2694,2695,2696,2697,2698,2699,2700,2701,2702,2703,2704,2705,2706,2707,2708,2709,2710,2711,2712,2713,2714,2715,2716,2717,2718,2719,2720,2721,2722,2723,2724,2725,2726,2727,2728,2729,2730,2731,2732,2733,2734,2735,2736,2737,2738,2739,2740],"revision_id":1762878},"mentions":[{"id":"c-nanqishu-054-recluses-complete:p014:m0040","start":40,"end":42,"surface":"顧歡","kind":"person","person_id":"bn8_cdi_hv9","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p014:m0046","start":46,"end":49,"surface":"劉思效","kind":"person","person_id":"z7a_nhg_u1e","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p014:m0101","start":101,"end":102,"surface":"歡","kind":"person","person_id":"bn8_cdi_hv9","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p014:m0108","start":108,"end":110,"surface":"思效","kind":"person","person_id":"z7a_nhg_u1e","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p014:m0122","start":122,"end":123,"surface":"歡","kind":"person","person_id":"bn8_cdi_hv9","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-054-recluses-complete","book_id":"b-nanqishu-054","work_id":"w-nanqishu","source_id":"s-nanqishu-054-recluses-complete-ws1762878"}],"sources":[{"chapter_id":"c-nanqishu-054-recluses-complete","work_id":"w-nanqishu","book_id":"b-