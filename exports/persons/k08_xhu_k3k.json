-yun:p003:m0002","start":2,"end":5,"surface":"吳王晏","kind":"person","person_id":"k08_xhu_k3k","status":"contextual_provisional"},{"id":"c-jinshu-054-lu-yun:p003:m0009","start":9,"end":10,"surface":"晏","kind":"person","person_id":"k08_xhu_k3k","status":"contextual_provisional"},{"id":"c-jinshu-054-lu-yun:p003:m0018","start":18,"end":19,"surface":"雲","kind":"person","person_id":"40p_eb9_ggr_D","status":"contextual_provisional"}],"chapter_id":"c-jinshu-054-lu-yun","book_id":"b-jinshu-054","work_id":"w-jinshu","source_id":"s-jinshu-054-lu-yun-ws2605147"},{"id":"c-jinshu-054-lu-yun:p005","text":"時晏信任部將，使覆察諸官錢帛，雲又陳曰：","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":85,"last_line":85,"raw_start":8670,"raw_end":8690,"raw_character_offsets":[8670,8671,8672,8673,8674,8675,8676,8677,8678,8679,8680,8681,8682,8683,8684,8685,8686,8687,8688,8689],"revision_id":2605147},"mentions":[{"id":"c-jinshu-054-lu-yun:p005:m0001","start":1,"end":2,"surface":"晏","kind":"person","person_id":"k08_xhu_k3k","status":"contextual_provisional"},{"id":"c-jinshu-054-lu-yun:p005:m0015","start":15,"end":16,"surface":"雲","kind":"person","person_id":"40p_eb9_ggr_D","status":"contextual_provisional"}],"chapter_id":"c-jinshu-054-lu-yun","book_id":"b-jinshu-054","work_id":"w-jinshu","source_id":"s-jinshu-054-lu-yun-ws2605147"},{"id":"c-sanguozhi-058-lukang:line087-pei02-02","text":"《机云别传》曰：晋太康末，俱入洛，造司空张华，华一见而奇之，曰：「伐吴之役，利在获二俊。」遂为之延誉，荐之诸公。太傅杨骏辟机为祭酒，转太子洗马、尚书著作郎。云为吴王郎中令，出宰浚仪，甚有惠政，吏民怀之，生为立祠。后并历显位。机天才绮练，文藻之美，独冠於时。云亦善属文，清新不及机，而口辩持论过之。于时朝廷多故，机、云并自结於成都王颖。颖用机为平原相，云清河内史。寻转云右司马，甚见委仗。无几而与长沙王构隙，遂举兵攻洛，以机行后将军，督王粹、牵秀等诸军二十万，士龙著南征赋以美其事。机吴人，羁旅单宦，顿居群士之右，多不厌服。机屡战失利，死散过半。初，宦人孟玖，颖所嬖幸，乘宠豫权，云数言其短，颖不能纳，玖又从而毁之。是役也，玖弟超亦领众配机，不奉军令。机绳之以法，超宣言曰陆机将反。及牵秀等谮机於颖，以为持两端，玖又构之於内，颖信之，遣收机，并收云及弟耽，并伏法。机兄弟既江南之秀，亦著名诸夏，并以无罪夷灭，天下痛惜之。机文章为世所重，云所著亦传於世。","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-058-lukang:line087-pei02-02:m0020","start":20,"end":22,"surface":"张华","kind":"person"