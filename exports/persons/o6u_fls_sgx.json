23,324,325,326,327,328,329,330,331,332,333,334,335,336,337,338,339,340,341,342,343,344,345,346],"revision_id":1501803},"mentions":[{"id":"c-nanqishu-053-preface:p001:m0002","start":2,"end":4,"surface":"太祖","kind":"person","person_id":"47p_kjh_ez7","status":"contextual_provisional"},{"id":"c-nanqishu-053-preface:p001:m0034","start":34,"end":36,"surface":"傅琰","kind":"person","person_id":"o6u_fls_sgx","status":"contextual_provisional"},{"id":"c-nanqishu-053-preface:p001:m0142","start":142,"end":144,"surface":"明帝","kind":"person","person_id":"w4m_9tw_147","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-053-preface","book_id":"b-nanqishu-053","work_id":"w-nanqishu","source_id":"s-nanqishu-053-preface-ws1501803"},{"id":"c-nanqishu-059-western-polities-complete:p020","text":"夫廢興無謬，逆順有恒，古今共貫；賢愚同察。梁州刺史范柏年懷挾詭態，首鼠兩端，既已被伐，盤桓稽命。遂潛遣李烏奴叛。楊文弘扇誘邊疆荒雜。柏年今已梟禽，烏奴頻被摧破，計其餘燼，行自消夷。今遣參軍行晉壽太守王道寶、參軍事行北巴西新巴二郡太守任湜之、行宕渠太守王安會領銳卒三千，遄塗風邁，浮川電掩。又命輔國將軍三巴校尉明惠照、巴郡太守魯休烈、南巴西太守柳弘稱、益州刺史傅琰，竝簡徒競騖，選甲爭馳。雍州水步，行次魏興，并山東僑舊，會于南鄭。或汎舟墊江，或飛旍劍道，腹背飊騰，表裏震擊。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":51,"last_line":51,"raw_start":3333,"raw_end":3609,"raw_character_offsets":[3334,3335,3336,3337,3338,3339,3340,3341,3342,3343,3344,3345,3346,3347,3348,3349,3350,3351,3352,3353,3354,3355,3356,3357,3358,3359,3360,3361,3362,3363,3364,3365,3366,3367,3368,3369,3370,3371,3372,3373,3374,3375,3376,3416,3417,3418,3419,3420,3421,3422,3423,3424,3425,3426,3427,3428,3429,3430,3431,3432,3433,3434,3435,3436,3437,3438,3439,3440,3441,3442,3443,3444,3445,3446,3447,3448,3449,3450,3451,3452,3453,3454,3455,3456,3457,3458,3459,3460,3461,3462,3463,3464,3465,3466,3467,3468,3469,3470,3471,3472,3473,3474,3475,3476,3477,3478,3479,3480,3481,3482,3483,3484,3485,3486,3487,3488,3489,3490,3491,3492,3493,3494,3495,3496,3497,3498,3499,3500,3501,3502,3503,3504,3505,3506,3507,3508,3509,3510,3511,3512,3513,3514,3515,3516,3517,3518,3519,3520,3521,3522,3523,3524,3525,3526,3527,3528,3529,3530,3531,3532,