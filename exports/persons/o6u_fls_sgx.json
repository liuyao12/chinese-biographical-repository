l-officials-complete:p001:m0002","object_person_mention_id":"c-nanqishu-053-local-officials-complete:p001:m0023"}],"status":"source_attested","interpretation_note":"原文又記父子同有山陰治名。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"a-qi053-fuhui-father","subject_person_id":"048_fbe_cy2","object_person_id":"o6u_fls_sgx","predicate":"father","qualifiers":{"source_term":"琰子翽","lineage":"paternal"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-053","chapter_id":"c-nanqishu-053-local-officials-complete","source_id":"s-nanqishu-053-local-officials-complete-ws1501803","paragraph_id":"c-nanqishu-053-local-officials-complete:p007","quote":"　　臨淮劉玄明亦有吏能，爲山陰令，大著名績。琰子翽問之，玄明曰：「我臨去當告卿。」將別，謂之曰：「作縣唯日食一升飰，而莫飲酒。」","subject_person_mention_id":"c-nanqishu-053-local-officials-complete:p007:m0024","object_person_mention_id":"c-nanqishu-053-local-officials-complete:p007:m0022"}],"status":"source_attested","interpretation_note":"與劉玄明問縣法時見父子稱。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-053-local-officials-complete:p001","text":"　　傅琰字季珪，北地靈州人也。祖邵，員外郎。父僧祐，安東錄事參軍。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":18,"last_line":18,"raw_start":494,"raw_end":527,"raw_character_offsets":[494,495,496,497,498,499,500,501,502,503,504,505,506,507,508,509,510,511,512,513,514,515,516,517,518,519,520,521,522,523,524,525,526],"revision_id":1501803},"mentions":[{"id":"c-nanqishu-053-local-officials-complete:p001:m0002","start":2,"end":4,"surface":"傅琰","kind":"person","person_id":"o6u_fls_sgx","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p001:m0005","start":5,"end":7,"surface":"季珪","kind":"person","person_id":"o6u_fls_sgx","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p001:m0016","start":16,"end":17,"surface":"邵","kind":"person","person_id":"w4y_obj_5qk","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p001:m0023","start":23,"end":25,"surface":"僧祐","kind":"person","person_id":"5rm_iwc_x07","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-053-local-officials-complete","book_id":"b-nanqishu-053","work_id":"w-nanqishu","source_id":"s-nanqishu-053-local-officials-complete-ws1501803"},{"id":"c-nanqishu-053-local-officials-complete:p002","text":"　　琰美姿儀，解褐寧蠻參軍，本州主簿，寧蠻功曹。宋永光元年，補諸暨武康令，廣威將軍，除尚書左民郎，又爲武康令，將軍如故。除吳興郡丞。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":20,"last_line":20,"raw_start":529,"raw_end":602,"raw_character_offsets":[529,530,531,532,533,534,535,536,537,538,539,540,541,542,543,544,545,546,547,548,549,550,551,552,553,559,560,561,562,565,566,567,568,569,570,571,572,573,574,575,576,577,578,579,580,581,582,583,584,585,586,587,588,589,590,591,592,593,594,595,596,597,598,599,600,601],"revision_id":1501803},"mentions":[{"id":"c-nanqishu-053-local-officials-complete:p002:m0002","start":2,"end":3,"surface":"琰","kind":"person","person_id":"o6u_fls_sgx","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-053-local-officials-complete","book_id":"b-nanqishu-053","work_id":"w-nanqishu","source_id":"s-nanqishu-053-local-officials-complete-ws1501803"},{"id":"c-nanqishu-053-local-officials-complete:p003","text":"　　泰始六年，遷山陰令。山陰，東土大縣，難爲長官，僧祐在縣有稱，琰尤明察，又著能名。其年爵新亭侯。元徽初，遷尚書右丞。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":22,"last_line":22,"raw_start":604,"raw_end":670,"raw_character_offsets":[604,605,611,612,613,614,617,618,619,620,621,622,623,624,625,626,627,628,629,630,631,632,633,634,635,636,637,638,639,640,641,642,643,644,645,646,647,648,649,650,651,652,653,654,655,656,657,658,659,660,661,662,663,664,665,666,667,668,669],"revision_id":1501803},"mentions":[{"id":"c-nanqishu-053-local-officials-complete:p003:m0025","start":25,"end":27,"surface":"僧祐","kind":"person","person_id":"5rm_iwc_x07","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p003:m0032","start":32,"end":33,"surface":"琰","kind":"person","person_id":"o6u_fls_sgx","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-053-local-officials-complete","book_id":"b-nanqishu-053","work_id":"w-nanqishu","source_id":"s-nanqishu-053-local-officials-complete-ws1501803"},{"id":"c-nanqishu-053-local-officials-complete:p004","text":"　　遭母喪，居南岸，隣家失火，延燒琰屋，琰抱柩不動，隣人競來赴救，乃得俱全。琰股髀之閒，已被煙焰。服闋，除邵陵王左軍諮議，江夏王錄事參軍。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":24,"last_line":24,"raw_start":672,"raw_end":741,"raw_character_offsets":[672,673,674,675,676,677,678,679,680,681,682,683,684,685,686,687,688,689,690,691,692,693,694,695,696,697,698,699,700,701,702,703,704,705,706,707,708,709,710,711,712,713,714,715,716,717,718,719,720,721,722,723,724,725,726,727,728,729,730,731,732,733,734,735,736,737,738,739,740],"revision_id":1501803},"mentions":[{"id":"c-nanqishu-053-local-officials-complete:p004:m0017","start":17,"end":18,"surface":"琰","kind":"person","person_id":"o6u_fls_sgx","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p004:m0020","start":20,"end":21,"surface":"琰","kind":"person","person_id":"o6u_fls_sgx","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p004:m0038","start":38,"end":39,"surface":"琰","kind":"person","person_id":"o6u_fls_sgx","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-053-local-officials-complete","book_id":"b-nanqishu-053","work_id":"w-nanqishu","source_id":"s-nanqishu-053-local-officials-complete-ws1501803"},{"id":"c-nanqishu-053-local-officials-complete:p005","text":"　　太祖輔政，以山陰獄訟煩積，復以琰爲山陰令。賣針賣糖老姥爭團絲，來詣琰，琰不辨覈，縳團絲於柱鞭之，密視有鐵屑，乃罰賣糖者。二野父爭雞，琰各問「何以食雞」，一人云「粟」，一人云「豆」，乃破雞得粟，罪言豆者。縣內稱神明，無敢復爲偷盜。琰父子竝著奇績，江左鮮有。世云「諸傅有《治縣譜》，子孫相傳，不以示人」。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":26,"last_line":26,"raw_start":743,"raw_end":895,"raw_character_offsets":[743,744,745,746,747,748,749,750,751,752,753,754,755,756,757,758,759,760,761,762,763,764,765,766,767,768,769,770,771,772,773,774,775,776,777,778,779,780,781,782,783,784,785,786,787,788,789,790,791,792,793,794,795,796,797,798,799,800,801,802,803,804,805,806,807,808,809,810,811,812,813,814,815,816,817,818,819,820,821,822,823,824,825,826,827,828,829,830,831,832,833,834,835,836,837,838,839,840,841,842,843,844,845,846,847,848,849,850,851,852,853,854,855,856,857,858,859,860,861,862,863,864,865,866,867,868,869,870,871,872,873,874,875,876,877,878,879,880,881,882,883,884,885,886,887,888,889,890,891,892,893,894],"revision_id":1501803},"mentions":[{"id":"c-nanqishu-053-local-officials-complete:p005:m0002","start":2,"end":4,"surface":"太祖","kind":"person","person_id":"47p_kjh_ez7","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p005:m0017","start":17,"end":18,"surface":"琰","kind":"person","person_id":"o6u_fls_sgx","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p005:m0035","start":35,"end":36,"surface":"琰","kind":"person","person_id":"o6u_fls_sgx","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p005:m0037","start":37,"end":38,"surface":"琰","kind":"person","person_id":"o6u_fls_sgx","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p005:m0068","start":68,"end":69,"surface":"琰","kind":"person","person_id":"o6u_fls_sgx","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p005:m0116","start":116,"end":117,"surface":"琰","kind":"person","person_id":"o6u_fls_sgx","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-053-local-officials-complete","book_id":"b-nanqishu-053","work_id":"w-nanqishu","source_id":"s-nanqishu-053-local-officials-complete-ws1501803"},{"id":"c-nanqishu-053-local-officials-complete:p006","text":"　　昇明二年，太祖擢爲假節、督益寧二州軍事、建威將軍、益州刺史、宋寧太守。建元元年，進號寧朔將軍。四年，徵驍騎將軍，黃門郎。永明二年，遷建威將軍、安陸王北中郎長史，改寧朔將軍。明年，徙廬陵王安西長史、南郡內史，行荊州事。五年，卒。琰喪西還，有詔出臨。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":28,"last_line":28,"raw_start":897,"raw_end":1029,"raw_character_offsets":[897,898,904,905,906,907,910,911,912,913,914,915,916,917,918,919,920,921,922,923,924,925,926,927,928,929,930,931,932,933,934,935,936,937,938,939,940,941,942,943,944,945,946,947,948,949,950,951,952,953,954,955,956,957,958,959,960,961,962,963,964,965,966,967,968,969,970,971,972,973,974,975,976,977,978,979,980,981,982,983,984,985,986,987,988,989,990,991,992,993,994,995,996,997,998,999,1000,1001,1002,1003,1004,1005,1006,1007,1008,1009,1010,1011,1012,1013,1014,1015,1016,1017,1018,1019,1020,1021,1022,1023,1024,1025,1026,1027,1028],"revision_id":1501803},"mentions":[{"id":"c-nanqishu-053-local-officials-complete:p006:m0007","start":7,"end":9,"surface":"太祖","kind":"person","person_id":"47p_kjh_ez7","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p006:m0115","start":115,"end":116,"surface":"琰","kind":"person","person_id":"o6u_fls_sgx","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-053-local-officials-complete","book_id":"b-nanqishu-053","work_id":"w-nanqishu","source_id":"s-nanqishu-053-local-officials-complete-ws1501803"},{"id":"c-nanqishu-053-local-officials-complete:p007","text":"　　臨淮劉玄明亦有吏能，爲山陰令，大著名績。琰子翽問之，玄明曰：「我臨去當告卿。」將別，謂之曰：「作縣唯日食一升飰，而莫飲酒。」","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":30,"last_line":30,"raw_start":1031,"raw_end":1095,"raw_character_offsets":[1031,1032,1033,1034,1035,1036,1037,1038,1039,1040,1041,1042,1043,1044,1045,1046,1047,1048,1049,1050,1051,1052,1053,1054,1055,1056,1057,1058,1059,1060,1061,1062,1063,1064,1065,1066,1067,1068,1069,1070,1071,1072,1073,10