h_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-nanqishu-053-local-officials-complete-ws1501803"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-nanqishu-053-appraisal:source_review1-0","kind":"source_review","person_id":"o6u_fls_sgx","source_quote":"　　史臣曰：琴瑟不調，必解而更張也。魏晉爲吏，稍與漢乖，苛猛之風雖衰，而仁愛之情亦減。局以峻法，限以常條，以必世之仁未及宣理，而朞月之望已求治術。先公後私，在己未易，割民奉國，於物非難，期之救過，所利苟免。且目見可欲，嗜好方流，貪以敗官，取與違義，吏之不臧，罔非由此。擿姦辯偽，誠俟異識，垂名著績，唯有廉平。今世之治民，未有出於此也。","reading":"卷末論吏治寬猛、官民及廉節；首引琴瑟改弦。","note":"卷末論吏治寬猛、官民及廉節；首引琴瑟改弦。","paragraph_id":"c-nanqishu-053-appraisal:p001","start_codepoint":0,"end_codepoint":167,"human_reviewed":false,"chapter_id":"c-nanqishu-053-appraisal","source_id":"s-nanqishu-053-appraisal-ws1501803"},{"id":"c-nanqishu-053-appraisal:source_review2-0","kind":"source_review","person_id":"o6u_fls_sgx","source_quote":"　　贊曰：蒸蒸小民，吏職長親。棼亂須理，卹隱歸仁。枉直交瞀，寬猛代陳。伊何導物，貴在清身。","reading":"贊記吏職與仁清，固定數位的校本小註存於見證。","note":"贊記吏職與仁清，固定數位的校本小註存於見證。","paragraph_id":"c-nanqishu-053-appraisal:p002","start_codepoint":0,"end_codepoint":45,"human_reviewed":false,"chapter_id":"c-nanqishu-053-appraisal","source_id":"s-nanqishu-053-appraisal-ws1501803"},{"id":"c-nanqishu-053-local-officials-complete:source_review1-0","kind":"source_review","person_id":"o6u_fls_sgx","source_quote":"　　傅琰字季珪，北地靈州人也。祖邵，員外郎。父僧祐，安東錄事參軍。","reading":"傅琰字季珪，祖邵、父僧祐。南史祖劭字彥先，父僧佑；官與身份照同處校讀。","note":"傅琰字季珪，祖邵、父僧祐。南史祖劭字彥先，父僧佑；官與身份照同處校讀。","paragraph_id":"c-nanqishu-053-local-officials-complete:p001","start_codepoint":0,"end_codepoint":33,"human_reviewed":false,"chapter_id":"c-nanqishu-053-local-officials-complete","source_id":"s-nanqishu-053-local-officials-complete-ws1501803"},{"id":"c-nanqishu-053-local-officials-complete:source_review2-0","kind":"source_review","person_id":"o6u_fls_sgx","source_quote":"　　琰美姿儀，解褐寧蠻參軍，本州主簿，寧蠻功曹。宋永光元年，補諸暨武康令，廣威將軍，除尚書左民郎，又爲武康令，將軍如故。除吳興郡丞。","reading":"宋永光元年起列傅琰令履，「諸暨武康令」保留原次。","note":"宋永光元年起列傅琰令履，「諸暨武康令」保留原次。","paragraph_id":"c-nanqishu-053-local-officials-complete:p002","start_codepoint":0,"end_codepoint":66,"human_reviewed":false,"chapter_id":"c-nanqishu-053-local-officials-complete","source_id":"s-nanqishu-053-local-officials-complete-ws1501803"},{"id":"c-nanqishu-053-local-officials-complete:source_review3-0","kind":"source_review","person_id":"o6u_fls_sgx","source_quote":"　　泰始六年，遷山陰令。山陰，東土大縣，難爲長官，僧祐在縣有稱，琰尤明察，又著能名。其年爵新亭侯。元徽初，遷尚書右丞。","reading":"泰始六年遷山陰，僧祐與琰並有治名。元徽初本傳任尚書右丞，南史作左丞。","note":"泰始六年遷山陰，僧祐與琰並有治名。元徽初本傳任尚書右丞，南史作左丞。","paragraph_id":"c-nanqishu-053-local-officials-complete:p003","start_codepoint":0,"end_codepoint":59,"human_reviewed":false,"chapter_id":"c-nanqishu-053-local-officials-complete","source_id":"s-nanqishu-053-local-officials-complete-ws1501803"},{"id":"c-nanqishu-053-local-officials-complete:source_review4-0","kind":"source_review","person_id":"o6u_fls_sgx","source_quote":"　　遭母喪，居南岸，隣家失火，延燒琰屋，琰抱柩不動，隣人競來赴救，乃得俱全。琰股髀之閒，已被煙焰。服闋，除邵陵王左軍諮議，江夏王錄事參軍。","reading":"母喪鄰火抱柩，母未具名，服闋後再任僚佐。","note":"母喪鄰火抱柩，母未具名，服闋後再任僚佐。","paragraph_id":"c-nanqishu-053-local-officials-complete:p004","start_codepoint":0,"end_codepoint":69,"human_reviewed":false,"chapter_id":"c-nanqishu-053-local-officials-complete","source_id":"s-nanqishu-053-local-officials-complete-ws1501803"},{"id":"c-nanqishu-053-local-officials-complete:source_review5-0","kind":"source_review","person_id":"o6u_fls_sgx","source_quote":"　　太祖輔政，以山陰獄訟煩積，復以琰爲山陰令。賣針賣糖老姥爭團絲，來詣琰，琰不辨覈，縳團絲於柱鞭之，密視有鐵屑，乃罰賣糖者。二野父爭雞，琰各問「何以食雞」，一人云「粟」，一人云「豆」，乃破雞得粟，罪言豆者。縣內稱神明，無敢復爲偷盜。琰父子竝著奇績，江左鮮有。世云「諸傅有《治縣譜》，子孫相傳，不以示人」。","reading":"傅琰辦團絲與雞爭兩事。《治縣譜》是傳稱父子所承的治縣著作。","note":"傅琰辦團絲與雞爭兩事。《治縣譜》是傳稱父子所承的治縣著作。","paragraph_id":"c-nanqishu-053-local-officials-complete:p005","start_codepoint":0,"end_codepoint":152,"human_reviewed":false,"chapter_id":"c-nanqishu-053-local-officials-complete","source_id":"s-nanqishu-053-local-officials-complete-ws1501803"},{"id":"c-nanqishu-053-local-officials-complete:source_review6-0","kind":"source_review","person_id":"o6u_fls_sgx","source_quote":"　　昇明二年，太祖擢爲假節、督益寧二州軍事、建威將軍、益州刺史、宋寧太守。建元元年，進號寧朔將軍。四年，徵驍騎將軍，黃門郎。永明二年，遷建威將軍、安陸王北中郎長史，改寧朔將軍。明年，徙廬陵王安西長史、南郡內史，行荊州事。五年，卒。琰喪西還，有詔出臨。","reading":"昇明二年升益州，建元和永明歷官連續。五年卒承上永明，喪西還。","note":"昇明二年升益州，建元和永明歷官連續。五年卒承上永明，喪西還。","paragraph_id":"c-nanqishu-053-local-officials-complete:p006","start_codepoint":0,"end_codepoint":125,"human_reviewed":false,"chapter_id":"c-nanqishu-053-local-officials-complete","source_id":"s-nanqishu-053-local-officials-complete-ws1501803"},{"id":"c-nanqishu-053-local-officials-complete:variant_review3-54","kind":"variant_review","person_id":"o6u_fls_sgx","source_quote":"尚書右丞","reading":"武英殿本及本文右丞，《南史》作左丞。","note":"武英殿本及本文右丞，《南史》作左丞。","paragraph_id":"c-nanqishu-053-local-officials-complete:p003","start_codepoint":54,"end_codepoint":58,"human_reviewed":false,"chapter_id":"c-nanqishu-053-local-officials-complete","source_id":"s-nanqishu-053-local-officials-complete-ws1501803"},{"id":"c-nanqishu-053-preface:source_review1-0","kind":"source_review","person_id":"o6u_fls_sgx","source_quote":"　　太祖承宋氏奢縱，風移百城，輔立幼主，思振民瘼。爲政未朞，擢山陰令傅琰爲益州刺史。乃捐華反樸，恭己南面，導民以躬，意存勿擾。以山陰大邑，獄訟繁滋，建元三年，別置獄丞，與建康爲比。永明繼運，垂心治術。杖威善斷，猶多漏網，長吏犯法，封刃行誅。郡縣居職，以三周爲小滿。水旱之災，輙加賑卹。明帝自在布衣，曉達吏事，君臨億兆，專務刀筆，未嘗枉法申恩，守宰以之肅震。","reading":"序列建元置獄丞、永明治郡縣及明帝斷事，各是史家卷首概說。","note":"序列建元置獄丞、永明治郡縣及明帝斷事，各是史家卷首概說。","paragraph_id":"c-nanqishu-053-preface:p001","start_codepoint":0,"end_codepoint":178,"human_reviewed":false,"chapter_id":"c-nanqishu-053-preface","source_id":"s-nanqishu-053-preface-ws1501803"},{"id":"c-nanqishu-053-preface:source_review2-0","kind":"source_review","person_id":"o6u_fls_sgx","source_quote":"　　永明之世，十許年中，百姓無雞鳴犬吠之警，都邑之盛，士女富逸，歌聲舞節，袨服華粧，桃花綠水之間，秋月春風之下，蓋以百數。及建武之興，虜難猋急，征役連歲，不遑啓居，軍國糜耗，從此衰矣。","reading":"以永明風俗與建武徵役相對敘，不立人物傳目。","note":"以永明風俗與建武徵役相對敘，不立人物傳目。","paragraph_id":"c-nanqishu-053-preface:p002","start_codepoint":0,"end_codepoint":92,"human_reviewed":false,"chapter_id":"c-nanqishu-053-preface","source_id":"s-nanqishu-053-preface-ws1501803"},{"id":"c-nanqishu-053-preface:source_review3-0","kind":"source_review","person_id":"o6u_fls_sgx","source_quote":"　　齊世善政著名表績無幾焉，位次遷升，非直止乎城邑。今取其清察有迹者，餘則隨以附焉。","reading":"史家交代良政篇取材及傳中旁附的範圍。","note":"史家交代良政篇取材及傳中旁附的範圍。","paragraph_id":"c-nanqishu-053-preface:p003","start_codepoint":0,"end_codepoint":42,"human_reviewed":false,"chapter_id":"c-nanqishu-053-preface","source_id":"s-nanqishu-053-preface-ws1501803"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-qi053-fuyan-grandfather","subject_person_id":"o6u_fls_sgx","object_person_id":"w4y_obj_5qk","predicate":"grandfather","qualifiers":{"source_term":"祖邵","lineage":"paternal"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-053","chapter_id":"c-nanqishu-053-local-officials-complete","source_id":"s-nanqishu-053-local-officials-complete-ws1501803","paragraph_id":"c-nanqishu-053-local-officials-complete:p001","quote":"　　傅琰字季珪，北地靈州人也。祖邵，員外郎。父僧祐，安東錄事參軍。","subject_person_mention_id":"c-nanqishu-053-local-officials-complete:p001:m0002","object_person_mention_id":"c-nanqishu-053-local-officials-complete:p001:m0016"}],"status":"source_attested","interpretation_note":"南史劭字彥先。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"a-qi053-fuyan-father","subject_person_id":"o6u_fls_sgx","object_person_id":"5rm_iwc_x07","predicate":"father","qualifiers":{"source_term":"父僧祐","lineage":"paternal"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-053","chapter_id":"c-nanqishu-053-local-officials-complete","source_id":"s-nanqishu-053-local-officials-complete-ws1501803","paragraph_id":"c-nanqishu-053-local-officials-complete:p001","quote":"　　傅琰字季珪，北地靈州人也。祖邵，員外郎。父僧祐，安東錄事參軍。","subject_person_mention_id":"c-nanqishu-053-local-officials-complete:p001:m0002","object_person_mention_id":"c-nanqishu-053-local-officials-complete:p001:m0023"}],"status":"source_attested","interpretation_note":"原文又記父子同有山陰治名。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"a-qi053-fuhui-father","subject_person_id":"048_fbe_cy2","object_person_id":"o6u_fls_sgx","predicate":"father","qualifiers":{"source_term":"琰子翽","lineage":"paternal"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-053","chapter_id":"c-nanqishu-053-local-officials-complete","source_id":"s-nanqishu-053-local-officials-complete-ws1501803","paragraph_id":"c-nanqishu-053-local-officials-complete:p007","quote":"　　臨淮劉玄明亦有吏能，爲山陰令，大著名績。琰子翽問之，玄明曰：「我臨去當告卿。」將別，謂之曰：「作縣唯日食一升飰，而莫飲酒。」","subject_person_mention_id":"c-nanqishu-053-local-officials-complete:p007:m0024","object_person_mention_id":"c-nanqishu-053-local-officials-complete:p007:m0022"}],"status":"source_attested","interpretation_note":"與劉玄明問縣法時見父子稱。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-qi053-fuyan-death","person_id":"o6u_fls_sgx","event_type":"death","source_term":"卒","source_anchor":{"paragraph_id":"c-nanqishu-053-local-officials-complete:p006","start":113,"end":114,"surface":"卒"},"date_expression":"五年","evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-053","chapter_id":"c-nanqishu-053-local-officials-complete","source_id":"s-nanqishu-053-local-officials-complete-ws1501803","paragraph_id":"c-nanqishu-053-local-officials-complete:p006","quote":"　　昇明二年，太祖擢爲假節、督益寧二州軍事、建威將軍、益州刺史、宋寧太守。建元元年，進號寧朔將軍。四年，徵驍騎將軍，黃門郎。永明二年，遷建威將軍、安陸王北中郎長史，改寧朔將軍。明年，徙廬陵王安西長史、南郡內史，行荊州事。五年，卒。琰喪西還，有詔出臨。","person_mention_id":"c-nanqishu-053-local