{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004521","identity_policy":"contextual_provisional","person_ids":["cbr-p004521"],"persons":[{"id":"cbr-p004521","label":"廉頗（范睢蔡澤列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"廉頗","mention_ids":["c-shiji-079-fancai:m026-0027"]}],"evidence":[{"mention_id":"c-shiji-079-fancai:m026-0027","chapter_id":"c-shiji-079-fancai","paragraph_id":"c-shiji-079-fancai:p026","quote":"廉頗"}]}],"mentions":[{"id":"c-shiji-079-fancai:m026-0027","start":27,"end":29,"surface":"廉頗","kind":"person","person_id":"cbr-p004521","status":"contextual_provisional","paragraph_id":"c-shiji-079-fancai:p026","chapter_id":"c-shiji-079-fancai"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji079-050","person_id":"cbr-p004521","surfaces":["廉頗"],"scope":"same_chapter","chapter_ids":["c-shiji-079-fancai"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-079-fancai:p026","quote":"後五年，昭王用應侯謀，縱反閒賣趙，趙以其故，令馬服子代廉頗將。秦大破趙於長平，遂圍邯鄲。已而與武安君白起有隙，言而殺之。任鄭安平，使擊趙。鄭安平為趙所圍，急，以兵二萬人降趙。應侯席槁請罪。秦之法，任人而所任不善者，各以其罪罪之。於是應侯罪當收三族。秦昭王恐傷應侯之意，乃下令國中：「有敢言鄭安平事者，以其罪罪之。」而加賜相國應侯食物日益厚，以順適其意。後二歲，王稽為河東守，與諸侯通，坐法誅。而應侯日益以不懌。"}],"rationale":"按全35段明示姓名與局部引語暫接，范睢張祿范叔范君應侯分說話範圍；蔡澤先生綱成君依具體敘事。越王事大夫種與句踐敘事相配，更新候選標籤保留ID。馬服／馬服子依同段長平角色暫接未補姓名，白公仍未定，韓子未強接韓非，喬松不補神仙，范中行族稱不接范睢。王之弟、改讀前止足及引古異說各留，預言與擬議方案不當史實核定。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-079-fancai:p026","text":"後五年，昭王用應侯謀，縱反閒賣趙，趙以其故，令馬服子代廉頗將。秦大破趙於長平，遂圍邯鄲。已而與武安君白起有隙，言而殺之。任鄭安平，使擊趙。鄭安平為趙所圍，急，以兵二萬人降趙。應侯席槁請罪。秦之法，任人而所任不善者，各以其罪罪之。於是應侯罪當收三族。秦昭王恐傷應侯之意，乃下令國中：「有敢言鄭安平事者，以其罪罪之。」而加賜相國應侯食物日益厚，以順適其意。後二歲，王稽為河東守，與諸侯通，坐法誅。而應侯日益以不懌。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-079-fancai:m026-0004","start":4,"end":6,"surface":"昭王","kind":"person","person_id":"cbr-p004480","statu