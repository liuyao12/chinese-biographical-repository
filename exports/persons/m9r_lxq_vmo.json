tatus":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。"},{"id":"c-jinshu-099-huanxuan:p023:m0345","start":345,"end":348,"surface":"卞承之","kind":"person","person_id":"gve_ody_ccq","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。"},{"id":"c-jinshu-099-huanxuan:p023:m0376","start":376,"end":378,"surface":"庶母","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"與馬氏不得依母稱自動同人","candidate_person_ids":[]},{"id":"c-jinshu-099-huanxuan:p023:m0413","start":413,"end":414,"surface":"玄","kind":"person","person_id":"lf6_f95_379","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。"}],"chapter_id":"c-jinshu-099-huanxuan","book_id":"b-jinshu-099","work_id":"w-jinshu","source_id":"s-jinshu-099-huanxuan-ws2644703"},{"id":"c-jinshu-099-huanxuan:p031","text":"魏詠之破桓歆于曆陽，諸葛長民又敗歆於芍陂，歆單馬渡淮。毅率道規及下邳太守孟懷玉與玄戰于崢嶸洲。于時義軍數千，玄兵甚盛，而玄懼有敗衄，常漾輕舸於舫側，故其眾莫有鬥心。義軍乘風縱火，盡銳爭先，玄眾大潰，燒輜重夜遁，郭銓歸降。玄故將劉統、馮稚等聚黨四百人，襲破尋陽城，毅遣建威將軍劉懷肅討平之。玄留永安皇后及皇后于巴陵。殷仲文時在玄艦，求出別船收集散軍，因叛玄，奉二後奔于夏口。玄入江陵城，馮該勸使更下戰，玄不從，欲出漢川，投梁州刺史桓希，而人情乖阻，制令不行。玄乘馬出城，至門，左右於暗中斫之，不中，前後相殺交橫，玄僅得至船。於是荊州別駕王康產奉帝入南郡府舍，太守王騰之率文武營衛。","source_position":{"kind":"wikitext_codepoint_positions","raw_path":"sources/jinshu/wikisource-2644703-raw.wikitext","raw_start":8917,"raw_end":9208,"character_positions":[8919,8920,8921,8922,8923,8924,8925,8926,8927,8928,8929,8930,8931,8932,8933,8934,8935,8936,8937,8938,8939,8940,8941,8942,8943,8944,8945,8946,8947,8948,8949,8950,8951,8952,8953,8954,8955,8956,8957,8958,8959,8960,8961,8962,8963,8964,8965,8966,8967,8968,8969,8970,8971,8972,8973,8974,8975,8976,8977,8978,8979,8980,8981,8982,8983,8984,8985,8986,8987,8988,8989,8990,8991,8992,8993,8994,8995,8996,8997,8998,8999,9000,9001,9002,9003,9004,9005,9006,9007,9008,9009,9010,9011,9012,9013,9014,9015,9016,9017,9018,9019,9020,9021,9022,9023,9024,9025,9026,9027,9028,9029,9030,9031,9032,9033,9034,9035,9036,9037,9038,9039,9040,9041,9042,9043,9044,9045,9046,9047,9048,9049,9050,905