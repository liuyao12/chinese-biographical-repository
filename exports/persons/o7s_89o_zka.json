"o7s_89o_zka","status":"contextual_provisional","paragraph_id":"c-shiji-121-rulin:p020","chapter_id":"c-shiji-121-rulin"},{"id":"c-shiji-121-rulin:m021-0055","start":55,"end":56,"surface":"上","kind":"person","person_id":"o7s_89o_zka","status":"contextual_provisional","paragraph_id":"c-shiji-121-rulin:p021","chapter_id":"c-shiji-121-rulin"},{"id":"c-shiji-121-rulin:m024-0060","start":60,"end":62,"surface":"天子","kind":"person","person_id":"o7s_89o_zka","status":"contextual_provisional","paragraph_id":"c-shiji-121-rulin:p024","chapter_id":"c-shiji-121-rulin"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-121-rulin:p005","text":"及今上即位，趙綰、王臧之屬明儒學，而上亦鄉之，於是招方正賢良文學之士。自是之后，言詩於魯則申培公，於齊則轅固生，於燕則韓太傅。言尚書自濟南伏生。言禮自魯高堂生。言易自菑川田生。言春秋於齊魯自胡毋生，於趙自董仲舒。及竇太后崩，武安侯田蚡為丞相，絀黃老、刑名百家之言，延文學儒者數百人，而公孫弘以春秋白衣為天子三公，封以平津侯。天下之學士靡然鄉風矣。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m005-0001","start":1,"end":3,"surface":"今上","kind":"person","person_id":"o7s_89o_zka","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0006","start":6,"end":8,"surface":"趙綰","kind":"person","person_id":"8dt_22t_v15","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0009","start":9,"end":11,"surface":"王臧","kind":"person","person_id":"fhl_wxh_rfr","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0018","start":18,"end":19,"surface":"上","kind":"person","person_id":"o7s_89o_zka","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0026","start":26,"end":34,"surface":"方正賢良文學之士","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m005-0045","start":45,"end":48,"surface":"申培公","kind":"person","person_id":"wxo_k8i_1it","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0052","start":52,"end":55,"surface":"轅固生","kind":"person","person_id":"b1w_3li_mim","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0059","start":59,"end":62,"surface":"韓太傅","kind":"person","person_id":"r6c_fhk_jo9","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0069","start":69,"end":71,"surface":"伏生","kind":"person","person_id":"t6q_oe6_hom","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0076","start":76,"end":79,"surface":"高堂生","kind":"person","person_id":"5sy_nhd_r99","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0085","start":85,"end":87,"surface":"田生","kind":"person","person_id":"m9h_k61_29i","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0095","start":95,"end":98,"surface":"胡毋生","kind":"person","person_id":"08q_8bd_lr8","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0102","start":102,"end":105,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0107","start":107,"end":110,"surface":"竇太后","kind":"person","person_id":"r4k_my1_3w5","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0115","start":115,"end":117,"surface":"田蚡","kind":"person","person_id":"aax_0zm_3jf","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0133","start":133,"end":137,"surface":"文學儒者","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m005-0142","start":142,"end":145,"surface":"公孫弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0151","start":151,"end":153,"surface":"天子","kind":"person","person_id":"o7s_89o_zka","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0162","start":162,"end":167,"surface":"天下之學士","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-121-rulin","book_id":"b-shiji-121","work_id":"w-shiji","source_id":"s-shiji121-rulin"},{"id":"c-shiji-121-rulin:p006","text":"公孫弘為學官，悼道之郁滯，乃請曰：「丞相御史言：制曰『蓋聞導民以禮，風之以樂。婚姻者，居屋之大倫也。今禮廢樂崩，朕甚愍焉。故詳延天下方正博聞之士，咸登諸朝。其令禮官勸學，講議洽聞興禮，以為天下先。太常議，與博士弟子，崇鄉里之化，以廣賢材焉』。謹與太常臧、博士平等議曰：聞三代之道，鄉里有教，夏曰校，殷曰序，周曰庠。其勸善也，顯之朝廷；其懲惡也，加之刑罰。故教化之行也，建首善自京師始，由內及外。今陛下昭至德，開大明，配天地，本人倫，勸學修禮，崇化厲賢，以風四方，太平之原也。古者政教未洽，不備其禮，請因舊官而興焉。為博士官置弟子五十人，復其身。太常擇民年十八已上，儀狀端正者，補博士弟子。郡國縣道邑有好文學，敬長上，肅政教，順鄉里，出入不悖所聞者，令相長丞上屬所二千石，二千石謹察可者，當與計偕，詣太常，得受業如弟子。一歲皆輒試，能通一藝以上，補文學掌故缺；其高弟可以為郎中者，太常籍奏。即有秀才異等，輒以名聞。其不事學若下材及不能通一藝，輒罷之，而請諸不稱者罰。臣謹案詔書律令下者，明天人分際，通古今之義，文章爾雅，訓辭深厚，恩施甚美。小吏淺聞，不能究宣，無以明布諭下。治禮次治掌故，以文學禮義為官，遷留滯。請選擇其秩比二百石以上，及吏百石通一藝以上，補左右內史、大行卒史；比百石已下，補郡太守卒史：皆各二人，邊郡一人。先用誦多者，若不足，乃擇掌故補中二千石屬，文學掌故補郡屬，備員。請著功令。佗如律令。」制曰：「可。」自此以來，則公卿大夫士吏斌斌多文學之士矣。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m006-0000","start":0,"end":3,"surface":"公孫弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m006-0018","start":18,"end":22,"surface":"丞相御史","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m006-0064","start":64,"end":72,"surface":"天下方正博聞之士","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m006-0103","start":103,"end":107,"surface":"博士弟子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m006-0123","start":123,"end":126,"surface":"太常臧","kind":"person","person_id":"bt2_5iy_rhq","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m006-0127","start":127,"end":130,"surface":"博士平","kind":"person","person_id":"skz_4qz_xg0","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m006-0198","start":198,"end":200,"surface":"陛下","kind":"person","person_id":"o7s_89o_zka","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m006-0289","start":289,"end":293,"surface":"博士弟子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m006-0617","start":617,"end":623,"surface":"公卿大夫士吏","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-121-rulin","book_id":"b-shiji-121","work_id":"w-shiji","source_id":"s-shiji121-rulin"},{"id":"c-shiji-121-rulin:p008","text":"蘭陵王臧既受詩，以事孝景帝為太子少傅，免去。今上初即位，臧乃上書宿衛上，累遷，一歲中為郎中令。及代趙綰亦嘗受詩申公，綰為御史大夫。綰、臧請天子，欲立明堂以朝諸侯，不能就其事，乃言師申公。於是天子使使束帛加璧安車駟馬迎申公，弟子二人乘軺傳從。至，見天子。天子問治亂之事，申公時已八十餘，老，對曰：「為治者不在多言，顧力行何如耳。」是時天子方好文詞，見申公對，默然。然已招致，則以為太中大夫，舍魯邸，議明堂事。太皇竇太后好老子言，不說儒術，得趙綰、王臧之過以讓上，上因廢明堂事，盡下趙綰、王臧吏，後皆自殺。申公亦疾免以歸，數年卒。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m008-0002","start":2,"end":4,"surface":"王臧","kind":"person","person_id":"fhl_wxh_rfr","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m008-0010","start":10,"end":13,"surface":"孝景帝","kind":"person","person_id":"8s8_8m3_upb","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m008-0022","start":22,"end":24,"surface":"今上","kind":"person","person_id":"o7s_89o_zka","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m008-0028","start":28,"end":29,"surface":"臧","kind":"person","person_id":"fhl_wxh_rfr","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m008-0034","start":34,"end":35,"surface":"上","kind":"person","person_id":"o7s_89o_zka","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m008-0049","start":49,"end":51,"surface":"趙綰","kind":"person","person_id":"8dt_22t_v15","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m008-0055","start":55,"end":57,"surface":"申公","kind":"person","person_id":"wxo_k8i_1it","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m008-0058","start":58,"end":59,"surface":"綰","kind":"person","person_id":"8dt_22t_v15","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m008-0065","start":65,"end":66,"surface":"綰","kind":"person","person_id":"8dt_22t_v15","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m008-0067","start":67,"end":68,"surface":"臧","kind":"person","person_id":"fhl_wxh_rfr","status":"contextual_provisional"},{"id":"c-shiji-