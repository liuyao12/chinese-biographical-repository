t_22t_v15","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m008-0222","start":222,"end":224,"surface":"王臧","kind":"person","person_id":"fhl_wxh_rfr","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m008-0228","start":228,"end":229,"surface":"上","kind":"person","person_id":"o7s_89o_zka","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m008-0230","start":230,"end":231,"surface":"上","kind":"person","person_id":"o7s_89o_zka","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m008-0239","start":239,"end":241,"surface":"趙綰","kind":"person","person_id":"8dt_22t_v15","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m008-0242","start":242,"end":244,"surface":"王臧","kind":"person","person_id":"fhl_wxh_rfr","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m008-0251","start":251,"end":253,"surface":"申公","kind":"person","person_id":"wxo_k8i_1it","status":"contextual_provisional"}],"chapter_id":"c-shiji-121-rulin","book_id":"b-shiji-121","work_id":"w-shiji","source_id":"s-shiji121-rulin"},{"id":"c-shiji-121-rulin:p012","text":"今上初即位，復以賢良徵固。諸諛儒多疾毀固，曰「固老」，罷歸之。時固已九十餘矣。固之徵也，薛人公孫弘亦徵，側目而視固。固曰：「公孫子，務正學以言，無曲學以阿世！」自是之後，齊言詩皆本轅固生也。諸齊人以詩顯貴，皆固之弟子也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m012-0000","start":0,"end":2,"surface":"今上","kind":"person","person_id":"o7s_89o_zka","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m012-0011","start":11,"end":12,"surface":"固","kind":"person","person_id":"b1w_3li_mim","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m012-0013","start":13,"end":16,"surface":"諸諛儒","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m012-0019","start":19,"end":20,"surface":"固","kind":"person","person_id":"b1w_3li_mim","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m012-0023","start":23,"end":24,"surface":"固","kind":"person","person_id":"b1w_3li_mim","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m012-0032","start":32,"end":33,"surface":"固","kind":"person","person_id":"b1w_3li_mim","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m012-0039","start":39,"end":40,"surface":"固","kind":"person","person_id":"b1w_3li_mim","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m012-0046","start":46,"end":49,"surface":"公孫弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m012-0056","start":56,"end":57,"surface":"固","kind":"person","person_id":"b1w_3li_mim","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m012-0058","start":58,"end":59,"surface":"固","kind":"person","person_id":"b1w_3li_mim","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m012-0062","start":62,"end":65,"surface":"公孫子","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m012-0090","start":90,"end":93,"surface":"轅固生","kind":"person","person_id":"b1w_3li_mim","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m012-0095","start":95,"end":98,"surface":"諸齊人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m012-0104","start":104,"end":105,"surface":"固","kind":"person","person_id":"b1w_3li_mim","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m012-0106","start":106,"end":108,"surface":"弟子","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-121-rulin","book_id":"b-shiji-121","work_id":"w-shiji","source_id":"s-shiji121-rulin"},{"id":"c-shiji-121-rulin:p013","text":"韓生者，燕人也。孝文帝時為博士，景帝時為常山王太傅。韓生推詩之意而為內外傳數萬言，其語頗與齊魯閒殊，然其歸一也。淮南賁生受之。自是之後，而燕趙閒言詩者由韓生。韓生孫商為今上博士。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m013-0000","start":0,"end":2,"surface":"韓生","kind":"person","person_id":"r6c_fhk_jo9","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m013-0008","start":8,"end":11,"surface":"孝文帝","kind":"person","person_id":"vz8_68e_j99","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m013-0016","start":16,"end":18,"surface":"景帝","kind":"person","person_id":"8s8_8m3_upb","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m013-0026","start":26,"end":28,"surface":"韓生","kind":"person","person_id":"r6c_fhk_jo9","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m013-0058","start":58,"end":60,"surface":"賁生","kind":"person","person_id":"lls_je1_d6d","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m013-0076","start":76,"end":78,"surface":"韓生","kind":"person","person_id":"r6c_fhk_jo9","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m013-0079","start":79,"end":81,"surface":"韓生","kind":"person","person_id":"r6c_fhk_jo9","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m013-0082","start":82,"end":83,"surface":"商","kind":"person","person_id":"r6c_fhk_jo9_*A","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m013-0084","start":84,"end":86,"surface":"今上","kind":"person","person_id":"o7s_89o_zka","status":"contextual_provisional"}],"chapter_id":"c-shiji-121-rulin","book_id":"b-shiji-121","work_id":"w-shiji","source_id":"s-shiji121-rulin"},{"id":"c-shiji-121-rulin:p015","text":"伏生教濟南張生及歐陽生，歐陽生教千乘兒寬。兒寬既通尚書，以文學應郡舉，詣博士受業，受業孔安國。兒寬貧無資用，常為弟子都養，及時時閒行傭賃，以給衣食。行常帶經，止息則誦習之。以試第次，補廷尉史。是時張湯方鄉學，以為奏讞掾，以古法議決疑大獄，而愛幸寬。寬為人溫良，有廉智，自持，而善著書、書奏，敏於文，口不能發明也。湯以為長者，數稱譽之。及湯為御史大夫，以兒寬為掾，薦之天子。天子見問，說之。張湯死后六年，兒寬位至御史大夫。九年而以官卒。寬在三公位，以和良承意從容得久，然無有所匡諫；於官，官屬易之，不為盡力。張生亦為博士。而伏生孫以治尚書徵，不能明也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m015-0000","start":0,"end":2,"surface":"伏生","kind":"person","person_id":"t6q_oe6_hom","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m015-0005","start":5,"end":7,"surface":"張生","kind":"person","person_id":"aqd_hcr_hzk","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m015-0008","start":8,"end":11,"surface":"歐陽生","kind":"person","person_id":"47o_xhl_8u1","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m015-0012","start":12,"end":15,"surface":"歐陽生","kind":"person","person_id":"47o_xhl_8u1","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m015-0018","start":18,"end":20,"surface":"兒寬","kind":"person","person_id":"x8r_9sk_d7a","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m015-0021","start":21,"end":23,"surface":"兒寬","kind":"person","person_id":"x8r_9sk_d7a","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m015-0043","start":43,"end":46,"surface":"孔安國","kind":"person","person_id":"9dt_8rh_m9a","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m015-0047","start":47,"end":49,"surface":"兒寬","kind":"person","person_id":"x8r_9sk_d7a","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m015-0056","start":56,"end":58,"surface":"弟子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m015-0098","start":98,"end":100,"surface":"張湯","kind":"person","person_id":"04o_yps_sg0","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m015-0122","start":122,"end":123,"surface":"寬","kind":"person","person_id":"x8r_9sk_d7a","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m015-0124","start":124,"end":125,"surface":"寬","kind":"person","person_id":"x8r_9sk_d7a","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m015-0156","start":156,"end":157,"surface":"湯","kind":"person","person_id":"04o_yps_sg0","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m015-0168","start":168,"end":169,"surface":"湯","kind":"person","person_id":"04o_yps_sg0","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m015-0176","start":176,"end":178,"surface":"兒寬","kind":"person","person_id":"x8r_9sk_d7a","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m015-0183","start":183,"end":185,"surface":"天子","kind":"person","person_id":"o7s_89o_zka","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m015-0186","start":186,"end":188,"surface":"天子","kind":"person","person_id":"o7s_89o_zka","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m015-0194","start":194,"end":196,"surface":"張湯","kind":"person","person_id":"04o_yps_sg0","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m015-0201","start":201,"end":203,"surface":"兒寬","kind":"person","person_id":"x8r_9sk_d7a","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m015-0217","start":217,"end":218,"surface":"寬","kind":"person","person_id":"x8r_9sk_d7a","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m015-0243","start":243,"end":245,"surface":"官屬","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m015-0253","start":253,"end":255,"surface":"張生","kind":"person","person_id":"aqd_hcr_hzk","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m015-0261","start":261,"end":264,"surface":"伏生孫","kind":"person","person_id":"t6q_oe6_hom_*A","status":"contextual_provisional"}],"chapter_id":"c-shiji-121-rulin","book_id":"b-shiji-121","work_id":"w-shiji","source_id":"s-shiji121-rulin"},{"id":"c-shiji-121-rulin:p020","text":"董仲舒，廣川人也。以治春秋，孝景時為博士。下帷講誦，弟子傳以久次相受業，或莫見其面，蓋三年董仲舒不觀於舍園，其精如此。進退容止，非禮不行，學士皆師尊之。今上即位，為江都相。以春秋災異之變推陰陽所以錯行，故求雨閉諸陽，縱諸陰，其止雨反是。行之一國，未嘗不得所欲。中廢為中大夫，居舍，著災異之記。是時遼東高廟災，主父偃疾之，取其書奏之天子。天子召諸生示其書，有刺譏。董仲舒弟子呂步舒不知其師書，以為下愚。於是下董仲舒吏，當死，詔赦之。於是董仲舒竟不敢復言災異。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m020-0000","start":0,"end":3,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0014","start":14,"end":16,"surface":"孝景","kind":"person","person_id":"8s8_8m3_upb","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0026","start":26,"end":28,"surface":"弟子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m020-0045","start":45,"end":48,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0069","start":69,"end":71,"surface":"學士","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m020-0076","start":76,"end":78,"surface":"今上","kind":"person","person_id":"o7s_89o_zka","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0154","start":154,"end":157,"surface":"主父偃","kind":"person","person_id":"65g_b5h_fvh","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0165","start":165,"end":167,"surface":"天子","kind":"person","person_id":"o7s_89o_zka","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0168","start":168,"end":170,"surface":"天子","kind":"person","person_id":"o7s_89o_zka","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0171","start":171,"end":173,"surface":"諸生","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m020-0181","start":181,"end":184,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0184","start":184,"end":186,"surface":"弟子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m020-0186","start":186,"end":189,"surface":"呂步舒","kind":"person","person_id":"r6k_uj1_o5h","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0203","start":203,"end":206,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0217","start":217,"end":220,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"}],"chapter_id":"c-shiji-121-rulin","book_id":"b-shiji-121","work_id":"w-shiji","source_id":"s-shiji121-rulin"},{"id":"c-shiji-121-rulin:p021","text":"董仲舒為人廉直。是時方外攘四夷，公孫弘治春秋不如董仲舒，而弘希世用事，位至公卿。董仲舒以弘為從諛。弘疾之，乃言上曰：「獨董仲舒可使相繆西王。」膠西王素聞董仲舒有行，亦善待之。董仲舒恐久獲罪，疾免居家。至卒，終不治產業，以修學著書為事。故漢興至于五世之閒，唯董仲舒名為明於春秋，其傳公羊氏也。","annotation_status":"in_progress","text_layer":"received_chapter","mentio