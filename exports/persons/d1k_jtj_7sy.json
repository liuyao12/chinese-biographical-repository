icy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-119-xunli:m010-0004","start":4,"end":7,"surface":"楚昭王","kind":"person","person_id":"d1k_jtj_7sy","status":"contextual_provisional","paragraph_id":"c-shiji-119-xunli:p010","chapter_id":"c-shiji-119-xunli"},{"id":"c-shiji-119-xunli:m010-0051","start":51,"end":52,"surface":"王","kind":"person","person_id":"d1k_jtj_7sy","status":"contextual_provisional","paragraph_id":"c-shiji-119-xunli:p010","chapter_id":"c-shiji-119-xunli"},{"id":"c-shiji-119-xunli:m010-0089","start":89,"end":90,"surface":"王","kind":"person","person_id":"d1k_jtj_7sy","status":"contextual_provisional","paragraph_id":"c-shiji-119-xunli:p010","chapter_id":"c-shiji-119-xunli"},{"id":"c-shiji-119-xunli:m010-0135","start":135,"end":136,"surface":"王","kind":"person","person_id":"d1k_jtj_7sy","status":"contextual_provisional","paragraph_id":"c-shiji-119-xunli:p010","chapter_id":"c-shiji-119-xunli"},{"id":"c-shiji-119-xunli:m012-0044","start":44,"end":46,"surface":"楚昭","kind":"person","person_id":"d1k_jtj_7sy","status":"contextual_provisional","paragraph_id":"c-shiji-119-xunli:p012","chapter_id":"c-shiji-119-xunli"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-119-xunli:p010","text":"石奢者，楚昭王相也。堅直廉正，無所阿避。行縣，道有殺人者，相追之，乃其父也。縱其父而還自繋焉。使人言之王曰：「殺人者，臣之父也。夫以父立政，不孝也；廢法縱罪，非忠也；臣罪當死。」王曰：「追而不及，不當伏罪，子其治事矣。」石奢曰：「不私其父，非孝子也；不奉主法，非忠臣也。王赦其罪，上惠也；伏誅而死，臣職也。」遂不受令，自刎而死。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-119-xunli:m010-0000","start":0,"end":2,"surface":"石奢","kind":"person","person_id":"ufr_eoj_xit_A","status":"contextual_provisional"},{"id":"c-shiji-119-xunli:m010-0004","start":4,"end":7,"surface":"楚昭王","kind":