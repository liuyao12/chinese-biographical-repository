person","person_id":"sg1_243_d92","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m026-0083","start":83,"end":84,"surface":"上","kind":"person","person_id":"ln1_tyi_kei","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m026-0129","start":129,"end":131,"surface":"太后","kind":"person","person_id":"py9_839_ut6","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m026-0133","start":133,"end":136,"surface":"修成君","kind":"person","person_id":"vx6_rh0_1ao","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m026-0137","start":137,"end":138,"surface":"仲","kind":"person","person_id":"fiy_rdu_4os","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m026-0139","start":139,"end":140,"surface":"上","kind":"person","person_id":"ln1_tyi_kei","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m026-0157","start":157,"end":161,"surface":"穰氏之屬","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m026-0170","start":170,"end":173,"surface":"張次公","kind":"person","person_id":"y3y_neg_36e","status":"contextual_provisional"}],"chapter_id":"c-shiji-122-kuli","book_id":"b-shiji-122","work_id":"w-shiji","source_id":"s-shiji122-kuli"},{"id":"c-shiji-122-kuli:p027","text":"寧成家居，上欲以爲郡守。御史大夫弘曰：「臣居山東爲小吏時，寧成爲濟南都尉，其治如狼牧羊。成不可使治民。」上乃拜成爲關都尉。歳餘，關東吏隸郡國出入關者，號曰「寧見乳虎，無値寧成之怒」。義縱自河内遷爲南陽太守，聞寧成家居南陽，及縱至關，寧成側行送迎，然縱氣盛，弗爲禮。至郡，遂案寧氏，盡破碎其家。成坐有罪，及孔、暴之屬皆奔亡，南陽吏民重足一跡。而平氏朱彊、杜衍、杜周爲縱牙爪之吏，任用，遷爲廷史。軍數出定襄，定襄吏民亂敗，於是徙縱爲定襄太守。縱至，掩定襄獄中重罪輕繋二百餘人，及賓客昆弟私入相視亦二百餘人。縱一捕鞠，曰「爲死罪解脱」。是日皆報殺四百餘人。其後郡中不寒而栗，猾民佐吏爲治。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-122-kuli:m027-0000","start":0,"end":2,"surface":"寧成","kind":"person","person_id":"9u9_ae0_0oz","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m027-0005","start":5,"end":6,"surface":"上","kind":"person","person_id":"ln1_tyi_kei","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m027-0012","start":12,"end":17,"surface":"御史大夫弘","kind":"person","person_id"