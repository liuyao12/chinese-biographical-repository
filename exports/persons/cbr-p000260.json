on_id":"4lj_xrf_bsl","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m108-0011","start":11,"end":15,"surface":"太子壽曼","kind":"person","person_id":"f42_zl0_lkq","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m108-0020","start":20,"end":22,"surface":"厲公","kind":"person","person_id":"f42_zl0_lkq","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m108-0027","start":27,"end":29,"surface":"景公","kind":"person","person_id":"4lj_xrf_bsl","status":"contextual_provisional"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"},{"id":"c-shiji-039-jin:p109","text":"厲公元年，初立，欲和諸侯，與秦桓公夾河而盟。歸而秦倍盟，與翟謀伐晉。三年，使呂相讓秦，因與諸侯伐秦。至涇，敗秦於麻隧，虜其將成差。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m109-0000","start":0,"end":2,"surface":"厲公","kind":"person","person_id":"f42_zl0_lkq","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m109-0014","start":14,"end":17,"surface":"秦桓公","kind":"person","person_id":"y97_huh_vuz_AAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m109-0038","start":38,"end":40,"surface":"呂相","kind":"person","person_id":"ou9_l91_4py","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m109-0062","start":62,"end":64,"surface":"成差","kind":"person","person_id":"07v_jz5_mnd","status":"contextual_provisional"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"},{"id":"c-shiji-039-jin:p110","text":"五年，三郤讒伯宗，殺之。伯宗以好直諫得此禍，國人以是不附厲公。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m110-0003","start":3,"end":5,"surface":"三郤","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m110-0006","start":6,"end":8,"surface":"伯宗","kind":"person","person_id":"3rj_an2_t19","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m110-0012","start":12,"end":14,"surface":"伯宗","kind":"person","person_id":"3rj_an2_t19","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m110-0028","start":28,"end":30,"surface":"厲公","kind":"person","person_id":"f42_zl0_lkq","status":"contextual_provisional"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"},{"id":"c-shiji-039-jin:p111","text":"六年春，鄭倍晉與楚盟，晉怒。欒書曰：「不可以當吾世而失諸侯。」乃發兵。厲公自將，五月度河。聞楚兵來救，范文子請公欲還。郤至曰：「發兵誅逆，見彊辟之，無以令諸侯。」遂與戰。癸巳，射中楚共王目，楚兵敗於鄢陵。子反收餘兵，拊循欲復戰，晉患之。共王召子反，其侍者豎陽穀進酒，子反醉，不能見。王怒，讓子反，子反死。王遂引兵歸。晉由此威諸侯，欲以令天下求霸。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m111-0035","start":35,"end":37,"surface":"厲公","kind":"person","person_id":"f42_zl0_lkq","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m111-0051","start":51,"end":54,"surface":"范文子","kind":"person","person_id":"rm7_r3k_g21","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m111-0059","start":59,"end":61,"surface":"郤至","kind":"person","person_id":"6cy_2mz_me0","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m111-0090","start":90,"end":93,"surface":"楚共王","kind":"person","person_id":"mwy_yd6_bo5","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m111-0102","start":102,"end":104,"surface":"子反","kind":"person","person_id":"k41_zyq_5ik","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m111-0118","start":118,"end":120,"surface":"共王","kind":"person","person_id":"mwy_yd6_bo5","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m111-0121","start":121,"end":123,"surface":"子反","kind":"person","person_id":"k41_zyq_5ik","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m111-0124","start":124,"end":127,"surface":"其侍者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m111-0127","start":127,"end":130,"surface":"豎陽穀","kind":"person","person_id":"onr_3p7_3bc","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m111-0133","start":133,"end":135,"surface":"子反","kind":"person","person_id":"k41_zyq_5ik","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m111-0141","start":141,"end":142,"surface":"王","kind":"person","person_id":"mwy_yd6_bo5","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m111-0145","start":145,"end":147,"surface":"子反","kind":"person","person_id":"k41_zyq_5ik","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m111-0148","start":148,"end":150,"surface":"子反","kind":"person","person_id":"k41_zyq_5ik","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m111-0152","start":152,"end":153,"surface":"王","kind":"person","person_id":"mwy_yd6_bo5","status":"contextual_provisional"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"},{"id":"c-shiji-039-jin:p112","text":"厲公多外嬖姬，歸，欲盡去群大夫而立諸姬兄弟。寵姬兄曰胥童，嘗與郤至有怨，及欒書又怨郤至不用其計而遂敗楚，乃使人閒謝楚。楚來詐厲公曰：「鄢陵之戰，實至召楚，欲作亂，内子周立之。會與國不具，是以事不成。」厲公告欒書。欒書曰：「其殆有矣！願公試使人之周微考之。」果使郤至於周。欒書又使公子周見郤至，郤至不知見賣也。厲公驗之，信然，遂怨郤至，欲殺之。八年，厲公獵，與姬飲，郤至殺豕奉進，宦者奪之。郤至射殺宦者。公怒，曰：「季子欺予！」將誅三郤，未發也。郤鉤欲攻公，曰：「我雖死，公亦病矣。」郤至曰：「信不反君，智不害民，勇不作亂。失此三者，誰與我？我死耳！」十二月壬午，公令胥童以兵八百人襲攻殺三郤。胥童因以劫欒書、中行偃于朝，曰：「不殺二子，患必及公。」公曰：「一旦殺三卿，寡人不忍益也。」對曰：「人將忍君。」公弗聽，謝欒書等以誅郤氏罪：「大夫復位。」二子頓首曰：「幸甚幸甚！」公使胥童爲卿。閏月乙卯，厲公游匠驪氏，欒書、中行偃以其黨襲捕厲公，囚之，殺胥童，而使人迎公子周于周而立之，是爲悼公。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m112-0000","start":0,"end":2,"surface":"厲公","kind":"person","person_id":"f42_zl0_lkq","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m112-0003","start":3,"end":6,"surface":"外嬖姬","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m112-0017","start":17,"end":21,"surface":"諸姬兄弟","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m112-0022","start":22,"end":25,"s