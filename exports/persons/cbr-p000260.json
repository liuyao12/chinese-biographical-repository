sional"},{"id":"c-shiji-032-qi:m060-0011","start":11,"end":13,"surface":"厲公","kind":"person","person_id":"f42_zl0_lkq","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m060-0017","start":17,"end":20,"surface":"晉悼公","kind":"person","person_id":"kat_48c_thr_AAA","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m060-0025","start":25,"end":28,"surface":"公子光","kind":"person","person_id":"9w2_c77_53m_AAAA","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m060-0036","start":36,"end":38,"surface":"子光","kind":"person","person_id":"9w2_c77_53m_AAAA","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m060-0042","start":42,"end":44,"surface":"高厚","kind":"person","person_id":"yti_e9l_fle","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m060-0063","start":63,"end":67,"surface":"中行獻子","kind":"person","person_id":"xoj_ji6_85j","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m060-0074","start":74,"end":76,"surface":"靈公","kind":"person","person_id":"9w2_c77_53m_AAA","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m060-0081","start":81,"end":83,"surface":"晏嬰","kind":"person","person_id":"jcn_rp4_qap","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m060-0084","start":84,"end":86,"surface":"靈公","kind":"person","person_id":"9w2_c77_53m_AAA","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m060-0087","start":87,"end":89,"surface":"靈公","kind":"person","person_id":"9w2_c77_53m_AAA","status":"contextual_provisional"}],"chapter_id":"c-shiji-032-qi","book_id":"b-shiji-032","work_id":"w-shiji","source_id":"s-shiji-032-qi"},{"id":"c-shiji-033-lu:p063","text":"襄公元年，晉立悼公。往年冬，晉欒書弒其君厲公。四年，襄公朝晉。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-033-lu:m063-0000","start":0,"end":2,"surface":"襄公","kind":"person","person_id":"x50_1p7_qkk_BACAA","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m063-0007","start":7,"end":9,"surface":"悼公","kind":"person","person_id":"kat_48c_thr_AAA","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m063-0014","start":14,"end":17,"surface":"晉欒書","kind":"person","person_id":"c8b_f8t_ylf","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m063-0020","start":20,"end":22,"surface":"厲公","kind":"person","person_id":"f42_zl0_lkq","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m063-0026","start":26,"end":28,"surface":"襄公","kind":"person","person_id":"x50_1p7_qkk_BACAA","status":"contextual_provisional"}],"chapter_id":"c-shiji-033-lu","book_id":"b-shiji-033","work_id":"w-shiji","source_id":"s-shiji-033-lu"},{"id":"c-shiji-035-guancai:p038","text":"成公三年，晉厲公伐曹，虜成公以歸，已復釋之。五年，晉欒書、中行偃使程滑弒其君厲公。二十三年，成公卒，子武公勝立。武公二十六年，楚公子棄疾弒其君靈王代立。二十七年，武公卒，子平公（頃）［須］立。平公四年卒，子悼公午立。是歲，宋、衛、陳、鄭皆火。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-035-guancai:m038-0000","start":0,"end":2,"surface":"成公","kind":"person","person_id":"rr8_o9c_jc1","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m038-0005","start":5,"end":8,"surface":"晉厲公","kind":"person","person_id":"f42_zl0_lkq","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m038-0012","start":12,"end":14,"surface":"成公","kind":"person","person_id":"rr8_o9c_jc1","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m038-0025","start":25,"end":28,"surface":"晉欒書","kind":"person","person_id":"c8b_f8t_ylf","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m038-0029","start":29,"end":32,"surface":"中行偃","kind":"person","person_id":"rk0_huv_709","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m038-0033","start":33,"end":35,"surface":"程滑","kind":"person","person_id":"ox6_lqa_iko","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m038-0038","start":38,"end":40,"surface":"厲公","kind":"person","person_id":"f42_zl0_lkq","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m038-0046","start":46,"end":48,"surface":"成公","kind":"person","person_