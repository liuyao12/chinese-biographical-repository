-060-zhonglimu:line093-pei03-01:m0264"],"kind":"paragraph"}],"mention_count":2,"duplicate_mention_count":0,"paragraph_occurrence_count":2,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"2處獨立位置，2個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"},{"source_id":"s-shiji-069-su","work_id":"w-shiji","book_id":"b-shiji-069","chapter_id":"c-shiji-069-su","raw_mention_count":2,"mention_ids":["c-shiji-069-su:m042-0193","c-shiji-069-su:m042-0315"],"paragraph_ids":["c-shiji-069-su:p042"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-shiji-069-su:m042-0193","mention_ids":["c-shiji-069-su:m042-0193"],"kind":"paragraph"},{"canonical_mention_id":"c-shiji-069-su:m042-0315","mention_ids":["c-shiji-069-su:m042-0315"],"kind":"paragraph"}],"mention_count":2,"duplicate_mention_count":0,"paragraph_occurrence_count":2,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"2處獨立位置，2個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-sanguozhi-060-zhonglimu","s-shiji-069-su"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-shiji069-006","person_id":"l3n_6lt_37x","event_type":"death","status":"source_attested","date_expression":null,"source_term":"抱柱而死","evidence":[{"chapter_id":"c-shiji-069-su","source_id":"s-shiji-069-su","paragraph_id":"c-shiji-069-su:p042","quote":"人有毀蘇秦者曰：「左右賣國反覆之臣也，將作亂。」蘇秦恐得罪歸，而燕王不復官也。蘇秦見燕王曰：「臣，東周之鄙人也，無有分寸之功，而王親拜之於廟而禮之於廷。今臣為王卻齊之兵而攻得十城，宜以益親。今來而王不官臣者，人必有以不信傷臣於王者。臣之不信，王之福也。臣聞忠信者，所以自為也；進取者，所以為人也。且臣之說齊王，曾非欺之也。臣棄老母於東周，固去自為而行進取也。今有孝如曾參，廉如伯夷，信如尾生。得此三人者以事大王，何若？」王曰：「足矣。」蘇秦曰：「孝如曾參，義不離其親一宿於外，王又安能使之步行千里而事弱燕之危王哉？廉如伯夷，義不為孤竹君之嗣，不肯為武王臣，不受封侯而餓死首陽山下。有廉如此，王又安能使之步行千里而行進取於齊哉？信如尾生，與女子期於梁下，女子不來，水至不去，抱柱而死。有信如此，王又安能使之步行千里卻齊之彊兵哉？臣所謂以忠信得罪於上者也。」燕王曰：「若不忠信耳，豈有以忠信而得罪者乎？」蘇秦曰：「不然。臣聞客有遠為吏而其妻私於人者，其夫將來，其私者憂之，妻曰『勿憂，吾已作藥酒待之矣』。居三日，其夫果至，妻使妾舉藥酒進之。妾欲言酒之有藥，則恐其逐主母也，欲勿言乎，則恐其殺主父也。於是乎詳僵而棄酒。主父大怒，笞之五十。故妾一僵而覆酒，上存主父，下存主母，然而不免於笞，惡在乎忠信之無罪也？夫臣之過，不幸而類是乎！」燕王曰：「先生復就故官。」益厚遇之。","person_mention_id":"c-shiji-069-su:m042-0315"}],"interpretation_note":"蘇秦對燕王說辭所引伯夷或尾生故事；來源確實有死亡詞，不等於獨立核實其歷史性。未定年代，不用本篇蘇秦敘事年代作死年。","reviewer":"Codex（AI 代理）","human_reviewed":false,"qualifiers":{"narrative_scope":"embedded_speech","speaker_person_id":"422_9v5_g9x","historicity":"historical_tradition"}}],"mentions":[{"id":"c-sanguozhi-060-zhonglimu:line093-pei03-01:m0196","start":196,"end":198,"surface":"尾生","kind":"person","person_id":"l3n_6lt_37x","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-060-zhonglimu:line093-pei03-01","chapter_id":"c-sanguozhi-060-zhonglimu"},{"id":"c-sanguozhi-060-zhonglimu:line093-pei03-01:m0264","start":264,"end":266,"surface":"尾生","kind":"person","person_id":"l3n_6lt_37x","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-060-zhonglimu:line093-pei03-01","chapter_id":"c-sanguozhi-060-zhonglimu"},{"id":"c-shiji-069-su:m042-0193","start":193,"end":195,"surface":"尾生","kind":"person","person_id":"l3n_6lt_37x","status":"contextual_provisional","paragraph_id":"c-shiji-069-su:p042","chapter_id":"c-shiji-069-su"},{"id":"c-shiji-069-su:m042-0315","start":315,"end":317,"surface":"尾生","kind":"person","person_id":"l3n_6lt_37x","status":"contextual_provisional","paragraph_id":"c-shiji-069-su:p042","chapter_id":"c-sh