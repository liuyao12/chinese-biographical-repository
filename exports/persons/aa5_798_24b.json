"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"person_id":"aa5_798_24b","title":null,"surname":"全","ming":"熙","additional_names":[],"chapter_id":"c-sanguozhi-027-wangchang","paragraph_id":"c-sanguozhi-027-wangchang:unit017","quote":"若引而伸之觸類而長之汝其庶㡬舉一隅耳及其用財先九族其施舎務周急其出入存故老其論議貴無貶其進仕尚忠節其取人務道實其處勢戒驕滛其貧賤慎無戚其進退念合宜其行事加九思如此而已吾復何憂哉青龍四年詔欲得有才智文章謀慮淵深料逺若近視昧而察籌不虛運策弗徒發端一小心清修宻静乾乾不解志尚在公者無限年齒勿拘貴賤卿校已上各舉一人太尉司馬宣王以昶應選正始中轉在徐州封武觀亭侯遷征南將軍假節都督荆豫諸軍事昶以為國有常衆戰無常勝地有常險守無常勢今屯苑去襄陽三百餘里諸軍散屯船在宣池有急不足相赴乃表徙治新野習水軍於三州廣農墾殖倉榖盈積嘉平初太傅司馬宣王既誅曹爽乃奏博問大臣得失昶陳治畧五事其一欲崇道篤學抑絶浮華使國子入太學而修庠序其二欲用考試考試猶凖繩也未有舎凖繩而意正曲直廢黜陟而空論能否也其三欲令居官者乆於其職有治績則就増位賜爵其四欲約官實祿勵以廉耻不使與百姓爭利其五欲絶侈靡務崇節儉令衣服有章上下有叙儲榖畜帛反民於樸詔書褒讚因使撰百官考課事昶以為唐虞雖有黜陟之文而考課之法不垂周制冡宰之職大計羣吏之治而誅賞又無校比之制由此言之聖主眀於任賢畧舉黜陟之體以委達官之長而摠其統紀故能否可得而知也其大指如此二年昶奏孫權流放良臣適庶分爭可乗釁而制吳蜀白帝夷陵之間黔巫秭歸房陵皆在江北民夷與新城郡接可襲取也乃遣新城太守州㤗襲巫秭歸房陵荆州刺史王基詣夷陵昶詣江陵兩岸引竹絙為橋渡水擊之賊奔南岸鑿七道並來攻於是昶使積弩同時俱發賊大將施績夜遁入江陵城追斬數百級昶欲引致平地與合戰乃先遣五軍案大道發還使賊望見以喜之以所獲鎧馬甲首馳環城以怒之設伏兵以待之績果追軍與戰克之績遁走斬其將鍾離茂許旻收其甲首旗鼓珍寳器仗振旅而還王基州㤗皆有功於是遷昶征南大將軍儀同三司進封京陵侯毌邱儉文欽作亂引兵拒儉欽有功封二子亭侯關内侯進位驃騎將軍諸葛誕反昶據夾石以逼江陵持施績全熙使不得東誕既誅詔曰昔孫臏佐趙直湊大梁西兵驟進亦所以成東征之勢也増邑千戸并前四千七百户遷司空持節都督如故甘露四年薨諡曰穆侯子渾嗣咸熙中為越騎校尉","note":"本源姓名構件追加出處，不覆寫既有主名、姓或字；異體各存。","status":"editorial_provisional","human_reviewed":false,"source_proposal_id":"proposal-wang34-022","work_id":"w-sanguozhi","book_id":"b-sanguozhi-027","source_id":"s-sanguozhi-027-wangchang"}],"life_events":[{"id":"le-wu050-quan-0","person_id":"aa5_798_24b","event_type":"death","source_term":"全熙謀洩見殺","date_expression":null,"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-050","chapter_id":"c-sanguozhi-050-quan","source_id":"s-sanguozhi-050-quan","paragraph_id":"c-sanguozhi-050-quan:line050","quote":"孫亮全夫人，全尚女也。（尚）從祖母公主愛之，每進見輒與俱。及潘夫人母子有寵，全主自以與孫和母有隙，乃勸權為潘氏男亮納夫人，亮遂為嗣。夫人立為皇后，以尚為城門校尉，封都亭侯，代滕胤為太常、衛將軍，進封永平侯，錄尚書事。時全氏侯有五人，並典兵馬。其餘為侍郎、騎都尉，宿衛左右，自吳興，外戚貴盛莫及。及魏大將諸葛誕以壽春來附，而全懌、全端、全禕、全儀等並因此際降魏。全熙謀洩見殺，由是諸全衰弱。會孫綝廢亮為會稽王，後又黜為候官侯。夫人隨之國，居候官，尚將家屬徙零陵，追見殺。","person_mention_id":"c-sanguozhi-050-quan:line050:m0180"}],"interpretation_note":"本來源所記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-sanguozhi-027-wangchang:unit017:m0755","start":755,"end":757,"surface":"全熙","kind":"person","person_id":"aa5_798_24b","status":"contextual_provisional","interpretation_note":"依本完整敘事與固定平行語境辨識；原稱保留。","paragraph_id":"c-sanguozhi-027-wangchang:unit017","chapter_id":"c-sanguozhi-027-wangchang"},{"id":"c-sanguozhi-050-quan:line050:m0180","start":180,"end":182,"surface":"全熙","kind":"person","person_id":"aa5_798_24b","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-050-quan:line050","chapter_id":"c-sanguozhi-050-quan"},{"id":"c-sanguozhi-052-zhugerong-complete:line080:m0207","start":207,"end":209,"surface":"全熙","kind":"person","person_id":"aa5_798_24b","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-sanguozhi-052-zhugerong-complete:line080","chapter_id":"c-sanguozhi-052-zhugerong-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-027-wangchang:unit017","text":"若引而伸之觸類而長之汝其庶㡬舉一隅耳及其用財先九族其施舎務周急其出入存故老其論議貴無貶其進仕尚忠節其取人務道實其處勢戒驕滛其貧賤慎無戚其進退念合宜其行事加九思如此而已吾復何憂哉青龍四年詔欲得有才智文章謀慮淵深料逺若近視昧而察籌不虛運策弗徒發端一小心清修宻静乾乾不解志尚在公者無限年齒勿拘貴賤卿校已上各舉一人太尉司馬宣王以昶應選正始中轉在徐州封武觀亭侯遷征南將軍假節都督荆豫諸軍事昶以為國有常衆戰無常勝地有常險守無常勢今屯苑去襄陽三百餘里諸軍散屯船在宣池有急不足相赴乃表徙治新野習水軍於三州廣農墾殖倉榖盈積嘉平初太傅司馬宣王既誅曹爽乃奏博問大臣得失昶陳治畧五事其一欲崇道篤學抑絶浮華使國子入太學而修庠序其二欲用考試考試猶凖繩也未有舎凖繩而意正曲直廢黜陟而空論能否也其三欲令居官者乆於其職有治績則就増位賜爵其四欲約官實祿勵以廉耻不使與百姓爭利其五欲絶侈靡務崇節儉令衣服有章上下有叙儲榖畜帛反民於樸詔書褒讚因使撰百官考課事昶以為唐虞雖有黜陟之文而考課之法不垂周制冡宰之職大計羣吏之治而誅賞又無校比之制由此言之聖主眀於任賢畧舉黜陟之體以委達官之長而摠其統紀故能否可得而知也其大指如此二年昶奏孫權流放良臣適庶分爭可乗釁而制吳蜀白帝夷陵之間黔巫秭歸房陵皆在江北民夷與新城郡接可襲取也乃遣新城太守州㤗襲巫秭歸房陵荆州刺史王基詣夷陵昶詣江陵兩岸引竹絙為橋渡水擊之賊奔南岸鑿七道並來攻於是昶使積弩同時俱發賊大將施績夜遁入江陵城追斬數百級昶欲引致平地與合戰乃先遣五軍案大道發還使賊望見以喜之以所獲鎧馬甲首馳環城以怒之設伏兵以待之績果追軍與戰克之績遁走斬其將鍾離茂許旻收其甲首旗鼓珍寳器仗振旅而還王基州㤗皆有功於是遷昶征南大將軍儀同三司進封京陵侯毌邱儉文欽作亂引兵拒儉欽有功封二子亭侯關内侯進位驃騎將軍諸葛誕反昶據夾石以逼江陵持施績全熙使不得東誕既誅詔曰昔孫臏佐趙直湊大梁西兵驟進亦所以成東征之勢也増邑千戸并前四千七百户遷司空持節都督如故甘露四年薨諡曰穆侯子渾嗣咸熙中為越騎校尉","text_layer":"received_chapter","annotation_status":"in_progress","source_position":{"first_line":212,"last_line":255,"revision_id":"214fcafa79894355909c9d8c2c1533089e7791c6","projection_sha256":"76ede52e80167e1d16ab77e9a310cc3c2f2245c2d0592b10caa502edd9c7a055","source_fragments":[{"line":212,"raw_start":25,"raw_end":34,"text":"若引而伸之觸類而長"},{"line":213,"raw_start":0,"raw_end":21,"text":"之汝其庶㡬舉一隅耳及其用財先九族其施舎務周"},{"line":214,"raw_start":0,"raw_end":21,"text":"急其出入存故老其論議貴無貶其進仕尚忠節其取"},{"line":215,"raw_start":0,"raw_end":21,"text":"人務道實其處勢戒驕滛其貧賤慎無戚其進退念合"},{"line":216,"raw_start":0,"raw_end":21,"text":"宜其行事加九思如此而已吾復何憂哉青龍四年詔"},{"line":217,"raw_start":0,"raw_end":21,"text":"欲得有才智文章謀慮淵深料逺若近視昧而察籌不"},{"line":218,"raw_start":0,"raw_end":21,"text":"虛運策弗徒發端一小心清修宻静乾乾不解志尚在"},{"line":219,"raw_start":0,"raw_end":21,"text":"公者無限年齒勿拘貴賤卿校已上各舉一人太尉司"},{"line":220,"raw_start":0,"raw_end":21,"text":"馬宣王以昶應選正始中轉在徐州封武觀亭侯遷征"},{"line":222,"raw_start":0,"raw_end":21,"text":"南將軍假節都督荆豫諸軍事昶以為國有常衆戰無"},{"line":223,"raw_start":0,"raw_end":21,"text":"常勝地有常險守無常勢今屯苑去襄陽三百餘里諸"},{"line":224,"raw_start":0,"raw_end":21,"text":"軍散屯船在宣池有急不足相赴乃表徙治新野習水"},{"line":225,"raw_start":0,"raw_end":21,"text":"軍於三州廣農墾殖倉榖盈積嘉平初太傅司馬宣王"},{"line":226,"raw_start":0,"raw_end":21,"text":"既誅曹爽乃奏博問大臣得失昶陳治畧五事其一欲"},{"line":227,"raw_start":0,"raw_end":21,"text":"崇道篤學抑絶浮華使國子入太學而修庠序其二欲"},{"line":228,"raw_start":0,"raw_end":21,"text":"用考試考試猶凖繩也未有舎凖繩而意正曲直廢黜"},{"line":230,"raw_start":0,"raw_end":21,"text":"陟而空論能否也其三欲令居官者乆於其職有治績"},{"line":231,"raw_start":0,"raw_end":21,"text":"則就増位賜爵其四欲約官實祿勵以廉耻不使與百"},{"line":232,"raw_start":0,"raw_end":21,"text":"姓爭利其五欲絶侈靡務崇節儉令衣服有章上下有"},{"line":233,"raw_start":0,"raw_end":21,"text":"叙儲榖畜帛反民於樸詔書褒讚因使撰百官考課事"},{"line":234,"raw_start":0,"raw_end":21,"text":"昶以為唐虞雖有黜陟之文而考課之法不垂周制冡"},{"line":235,"raw_start":0,"raw_end":21,"text":"宰之職大計羣吏之治而誅賞又無校比之制由此言"},{"line":236,"raw_start":0,"raw_end":21,"text":"之聖主眀於任賢畧舉黜陟之體以委達官之長而摠"},{"line":237,"raw_start":0,"raw_end":21,"text":"其統紀故能否可得而知也其大指如此二年昶奏孫"},{"line":238,"raw_start":0,"raw_end":21,"text":"權流放良臣適庶分爭可乗釁而制吳蜀白帝夷陵之"},{"line":240,"raw_start":0,"raw_end":21,"text":"間黔巫秭歸房陵皆在江北民夷與新城郡接可襲取"},{"line":241,"raw_start":0,"raw_end":21,"text":"也乃遣新城太守州㤗襲巫秭歸房陵荆州刺史王基"},{"line":242,"raw_start":0,"raw_end":21,"text":"詣夷陵昶詣江陵兩岸引竹絙為橋渡水擊之賊奔南"},{"line":243,"raw_start":0,"raw_end":21,"text":"岸鑿七道並來攻於是昶使積弩同時俱發賊大將施"},{"line":244,"raw_start":0,"raw_end":21,"text":"績夜遁入江陵城追斬數百級昶欲引致平地與合戰"},{"line":245,"raw_start":0,"raw_end":21,"text":"乃先遣五軍案大道發還使賊望見以喜之以所獲鎧"},{"line":246,"raw_start":0,"raw_end":21,"text":"馬甲首馳環城以怒之設伏兵以待之績果追軍與戰"},{"line":248,"raw_start":0,"raw_end":21,"text":"克之績遁走斬其將鍾離茂許旻收其甲首旗鼓珍寳"},{"line":249,"raw_start":0,"raw_end":21,"text":"器仗振旅而還王基州㤗皆有功於是遷昶征南大將"},{"line":250,"raw_start":0,"raw_end":21,"text":"軍儀同三司進封京陵侯毌邱儉文欽作亂引兵拒儉"},{"line":251,"raw_start":0,"raw_end":21,"text":"欽有功封二子亭侯關内侯進位驃騎將軍諸葛誕反"},{"line":252,"raw_start":0,"raw_end":21,"text":"昶據夾石以逼江陵持施績全熙使不得東誕既誅詔"},{"line":253,"raw_start":0,"raw_end":21,"text":"曰昔孫臏佐趙直湊大梁西兵驟進亦所以成東征之"},{"line":254,"raw_start":0,"raw_end":21,"text":"勢也増邑千戸并前四千七百户遷司空持節都督如"},{"line":255,"raw_start":0,"raw_end":21,"text":"故甘露四年薨諡曰穆侯子渾嗣咸熙中為越騎校尉"}],"source_layer":"received_biography"},"mentions":[{"id":"c-sanguozhi-027-wangchang:unit017:m0010","start":10,"end":11,"surface":"汝","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"未決指稱；不以最近人物、同姓或同名強配。"},{"id":"c-sanguozhi-027-wangchang:unit017:m0083","start":83,"end":84,"surface":"吾","kind":"person","person_id":"a8f_ec8_e74_A","status":"contextual_provisional","interpretation_note":"依本完整敘事與固定平行語境辨識；原稱保留。"},{"id":"c-sanguozhi-027-wangchang:unit017:m0153","start":153,"end":159,"surface":"太尉司馬宣王","kind":"person","person_id":"dkn_ge4_286_AAAA","status":"contextual_provisional","interpretation_n