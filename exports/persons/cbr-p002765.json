son_id":"29i_iqg_x15","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m031-0066","start":66,"end":68,"surface":"威王","kind":"person","person_id":"zan_qcc_jy5_AAAAAABAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m031-0132","start":132,"end":134,"surface":"威王","kind":"person","person_id":"zan_qcc_jy5_AAAAAABAAAAAA","status":"contextual_provisional"}],"chapter_id":"c-shiji-046-tian","book_id":"b-shiji-046","work_id":"w-shiji","source_id":"s-shiji-046-tian"},{"id":"c-shiji-046-tian:p038","text":"七年，與魏王會平阿南。明年，復會甄。魏惠王卒。明年，與魏襄王會徐州，諸侯相王也。十年，楚圍我徐州。十一年，與魏伐趙，趙決河水灌齊、魏，兵罷。十八年，秦惠王称王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-046-tian:m038-0004","start":4,"end":6,"surface":"魏王","kind":"person","person_id":"nht_c38_x7o","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m038-0018","start":18,"end":21,"surface":"魏惠王","kind":"person","person_id":"nht_c38_x7o","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m038-0027","start":27,"end":30,"surface":"魏襄王","kind":"person","person_id":"i8j_sze_ft5","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m038-0074","start":74,"end":77,"surface":"秦惠王","kind":"person","person_id":"an9_1k7_get","status":"contextual_provisional"}],"chapter_id":"c-shiji-046-tian","book_id":"b-shiji-046","work_id":"w-shiji","source_id":"s-shiji-046-tian"}],"sources":[{"chapter_id":"c-shiji-046-tian","work_id":"w-shiji","book_id":"b-shiji-046","source_id":"s-shiji-046-tian","source":{"title":"史記／卷046","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷046","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷046&oldid=2560838","revision_id":2560838,"accessed_on":"2026-10-09","extent":"55段正文（含太史公論贊）及1段索隱述贊，後者另標witness_appended_suoyin_zan；排除2個dd導覽及現代分節標題。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{