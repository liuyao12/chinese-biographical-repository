{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003059","identity_policy":"contextual_provisional","person_ids":["cbr-p003059"],"persons":[{"id":"cbr-p003059","label":"管夫人（外戚世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"管夫人","mention_ids":["c-shiji-049-waiqi:m007-0149","c-shiji-049-waiqi:m007-0172"]}],"evidence":[{"mention_id":"c-shiji-049-waiqi:m007-0149","chapter_id":"c-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p007","quote":"管夫人"},{"mention_id":"c-shiji-049-waiqi:m007-0172","chapter_id":"c-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p007","quote":"管夫人"}]}],"mentions":[{"id":"c-shiji-049-waiqi:m007-0149","start":149,"end":152,"surface":"管夫人","kind":"person","person_id":"cbr-p003059","status":"contextual_provisional","paragraph_id":"c-shiji-049-waiqi:p007","chapter_id":"c-shiji-049-waiqi"},{"id":"c-shiji-049-waiqi:m007-0172","start":172,"end":175,"surface":"管夫人","kind":"person","person_id":"cbr-p003059","status":"contextual_provisional","paragraph_id":"c-shiji-049-waiqi:p007","chapter_id":"c-shiji-049-waiqi"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji049-011","person_id":"cbr-p003059","surfaces":["管夫人"],"scope":"same_chapter","chapter_ids":["c-shiji-049-waiqi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-049-waiqi:p007","quote":"及諸侯畔秦，魏豹立為魏王，而魏媼內其女於魏宮。媼之許負所相，相薄姬，云當生天子。是時項羽方與漢王相距滎陽，天下未有所定。豹初與漢擊楚，及聞許負言，心獨喜，因背漢而畔，中立，更與楚連和。漢使曹參等擊虜魏王豹，以其國為郡，而薄姬輸織室。豹已死，漢王入織室，見薄姬有色，詔內後宮，歲餘不得幸。始姬少時，與管夫人、趙子兒相愛，約曰：「先貴無相忘。」已而管夫人、趙子兒先幸漢王。漢王坐河南宮成皋臺，此兩美人相與笑薄姬初時約。漢王聞之，問其故，兩人具以實告漢王。漢王心慘然，憐薄姬，是日召而幸之。薄姬曰：「昨暮夜妾夢蒼龍據吾腹。」高帝曰：「此貴徵也，吾為女遂成之。」一幸生男，是為代王。其後薄姬希見高祖。"}],"rationale":"按明示名、字及各帝后局部親屬敘事暫接；王夫人分景帝皇后與武帝趙妃，代王分文帝與後來少子武。未名者不補姓名，褚氏附載另留原語。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-049-waiqi:p007","text":"及諸侯畔秦，魏豹立為魏王，而魏媼內其女於魏宮。媼之許負所相，相薄姬，云當生天子。是時項羽方與漢王相距滎陽，天下未有所定。豹初與漢擊楚，及聞許負言，心獨喜，因背漢而畔，中立，更與楚連和。漢使曹參等擊虜魏王豹，以其國為郡，而薄姬輸織室。豹已死，漢王入織室，見薄姬有色，詔內後宮，歲餘不得幸。始姬少時，與管夫人、趙子兒相愛，約曰：「先貴無相忘。」已而管夫人、趙子兒先幸漢王。漢王坐河南宮成皋臺，此兩美人相與笑薄姬初時約。漢王聞之，問其故，兩人具以實告漢王。漢王心慘然，憐薄姬，是日召而幸之。薄姬曰：「昨暮夜妾夢蒼龍據吾腹。」高帝曰：「此貴徵也，吾為女遂成之。」一幸生男，是為代王。其後薄姬希見高祖。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-049-waiqi:m007-0006","start":6,"end":8,"surface":"魏豹","kind":"person","person_id":"cbr-p003058","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m007-0014","start":14,"end":16,"surface":"魏媼","kind":"person","person_id":"cbr-p003084","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m007-0023","start":23,"end":24,"surface":"媼","kind":"person","person_id":"cbr-p003084","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m007-0025","start":25,"end":27,"surface":"許負","kind":"person","person_id":"cbr-p003086","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m007-0031","start":31,"end":33,"surface":"薄姬","kind":"person","person_id":"cbr-p003056","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m007-0042","start":42,"end":44,"surface":"項羽","kind":"person","person_id":"cbr-p003087","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m007-0046","start":46,"end":48,"surface":"漢王","kind":"person","person_id":"cbr-p003079","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m007-0060","start":60,"end":61,"surface":"豹","kind":"person","person_id":"cbr-p003058","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m007-0069","start":69,"end":71,"surface":"許負","kind":"person","person_id":"cbr-p003086","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m007-0094","start":94,"end":96,"surface":"曹參","kind":"person","person_id":"cbr-p003088","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m007-0099","start":99,"end":102,"surface":"魏王豹","kind":"person","person_id":"cbr-p003058","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m007-0110","start":1