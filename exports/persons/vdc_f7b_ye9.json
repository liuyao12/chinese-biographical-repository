,"table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-058-zhou-fang:p004:m0048","surface":"胡混","start":48,"end":50,"person_id":"vdc_f7b_ye9","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-058-zhou-fang:p004","chapter_id":"c-jinshu-058-zhou-fang"},{"id":"c-jinshu-058-zhou-fang:p004:m0558","surface":"胡混","start":558,"end":560,"person_id":"vdc_f7b_ye9","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-058-zhou-fang:p004","chapter_id":"c-jinshu-058-zhou-fang"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-058-zhou-fang:p004","text":"時梁州刺史張光卒，湣帝以侍中第五猗爲征南大將軍，監荊、梁、益、寧四州，出自武關。賊率杜曾、摯瞻、胡混等並迎猗，奉之，聚兵數萬，破陶侃於石城，攻平南將軍荀崧於宛，不克，引兵向江陵。王敦以從弟暠爲荊州刺史，令督護征虜將軍趙誘、襄陽太守硃軌、陵江將軍黃峻等討曾，而大敗於女觀湖，誘、軌並遇害。曾遂逐暠，徑造沔口，大爲寇害，威震江、沔。元帝命訪擊之。訪有眾八千，進至沌陽。曾等銳氣甚盛，訪曰：「先人有奪人之心，軍之善謀也。」使將軍李恆督左甄，許朝督右甄，訪自領中軍，高張旗幟。曾果畏訪，先攻左右甄。曾勇冠三軍，訪甚惡之，自於陣後射雉以安眾心。令其眾曰：「一甄敗，鳴三鼓；兩甄敗，鳴六鼓。」趙胤領其父余兵屬左甄，力戰，敗而復合。胤馳馬告訪，訪怒，叱令更進。胤號哭還戰，自旦至申，兩甄皆敗。訪聞鼓音，選精銳八百人，自行酒飲之，敕不得妄動，聞鼓音乃進。賊未至三十歩，訪親鳴鼓，將士皆騰躍奔赴，曾遂大潰，殺千餘人。訪夜追之，諸將請待明日，訪曰：「曾驍勇能戰，向之敗也，彼勞我逸，是以克之。宜及其衰乘之，可滅。」鼓行而進，遂定漢、沔。曾等走固武當。訪以功遷南中郎將、督梁州諸軍、梁州刺史，屯襄陽。訪謂其僚佐曰：「昔城濮之役，晉文以得臣不死而有憂色，今不斬曾，禍難未已。」於是出其不意，又擊破之，曾遁走。訪部將蘇溫收曾詣軍，並獲第五猗、胡混、摯瞻等，送於王敦。又白敦，説猗逼於曾，不宜殺。敦不從而斬之。進位安南將軍、持節，都督、刺史如故。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":74,"last_line":74,"raw_start":6513,"raw_end":7148,"raw_character_offsets":[6515,6516,6517,6518,6519,6520,6521,6522,6523,6524