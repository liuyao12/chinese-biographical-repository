id":"c-shiji-098-fujin:p010","chapter_id":"c-shiji-098-fujin"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji098-002","person_id":"5k8_ms4_y3k","surfaces":["淮陰","淮陰侯"],"scope":"same_chapter","chapter_ids":["c-shiji-098-fujin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-098-fujin:p002","quote":"屬淮陰，擊破齊歷下軍，擊田解。屬相國參，殘博，益食邑。因定齊地，剖符世世勿絕，封為陽陵侯，二千六百戶，除前所食。為齊右丞相，備齊。五歲為齊相國。"},{"paragraph_id":"c-shiji-098-fujin:p010","quote":"蒯成侯緤者，沛人也，姓周氏。常為高祖參乘，以舍人從起沛。至霸上，西入蜀、漢，還定三秦，食邑池陽。東絕甬道，從出度平陰，遇淮陰侯兵襄國，軍乍利乍不利，終無離上心。以緤為信武侯，食邑三千三百戶。高祖十二年，以緤為蒯成侯，除前所食邑。"}],"rationale":"依傅寬、靳歙、周緤分段敘事及明示姓名定位；楚王信與平城下韓信分存，單稱參勃哙敞不補姓，兩位信武侯分持有人，周昌不按同名跨篇合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-098-fujin:p002","text":"屬淮陰，擊破齊歷下軍，擊田解。屬相國參，殘博，益食邑。因定齊地，剖符世世勿絕，封為陽陵侯，二千六百戶，除前所食。為齊右丞相，備齊。五歲為齊相國。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-098-fujin:m002-0001","start":1,"end":3,"surface":"淮陰","kind":"person","person_id":"5k8_ms4_y3k","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m002-0012","start":12,"end":14,"surface":"田解","kind":"person","person_id":"hr1_cou_3hm","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m002-0018","start":18,"end":19,"surface":"參","kind":"person","person_id":"ebz_s7c_pds","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m002-0057","start":57,"end":61,"surface":"齊右丞相","kind":"person","person_id":"w8j_vnd_rs4","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m002-0068","start":68,"end":71,"surface":"齊相國","kind":"person","person_id":"w8j_vnd_rs4","status":"contextual_provisional"}],"chapter_id":"c-shiji-098-fujin","book_id":"b-shiji-098","work_id":"w-shiji","source_id":"s-shiji-098-fujin"},{"id":"c-shiji-098-fujin:p010","text":"蒯成侯緤者，沛人也，姓周氏。常為高祖參乘，以舍人從起沛。至霸上，西入蜀、漢，還定三秦，食邑池陽。東絕甬道，從出度平陰，遇淮陰侯兵襄國，軍乍利乍不利，終無離上心。以緤為信武侯，食邑三千三百戶。高祖十二年，以緤為蒯成侯，除前所食邑。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-098-fujin:m010-0000","start":0,"end":3,"surface":"蒯成侯","kind":"person","person_id":"fvm_66f_0k3","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m010-0003","start":3,"end":4,"surface":"緤","kind":"person","person_id":"fvm_66f_0k3","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m010-0016","start":16,"end":18,"surface":"高祖","kind":"person","person_id":"5kd_jn4_se8","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m010-0060","start":60,"end":63,"surface":"淮陰侯","kind":"person","person_id":"5k8_ms4_y3k","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m010-0081","start":81,"end":82,"surface":"緤","kind":"person","person_id":"fvm_66f_0k3","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m010-0083","start":83,"end":86,"surface":"信武侯","kind":"person","person_id":"fvm_66f_0k3","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m010-0095","start":95,"end":97,"surface":"高祖","kind":"person","person_id":"5kd_jn4_se8","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m010-0102","start":102,"end":103,"surface":"緤","kind":"person","person_id":"fvm_66f_0k3","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m010-0104","start":104,"end":107,"surface":"蒯成侯","kind":"person","person_id":"fvm_66f_0k3","status":"contextual_provisional"}],"chapter_id":"c-shiji-098-fujin","book_id":"b-shiji-098","work_id":"w-shiji","source_id":"s-shiji-098-fujin"}],"sources":[{"chapter_id":"c-shiji-098-fujin","work_id":"w-shiji","book_id":"b-shiji-098","source_id":"s-shiji-098-fujin","source":{"title":"史記／卷098","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷098","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷098&oldid=1490318","revision_id":1490318,"accessed_on":"2026-10-10","extent":"13段傳世正文含太史公論；排除導覽及空白，無索隱附贊。","image_verified