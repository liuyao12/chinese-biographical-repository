red_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-007-xiangyu:m018-0182","start":182,"end":184,"surface":"項莊","kind":"person","person_id":"nsa_bp5_1dk","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p018","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-007-xiangyu:m018-0232","start":232,"end":233,"surface":"莊","kind":"person","person_id":"nsa_bp5_1dk","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p018","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-007-xiangyu:m018-0272","start":272,"end":274,"surface":"項莊","kind":"person","person_id":"nsa_bp5_1dk","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p018","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-007-xiangyu:m018-0295","start":295,"end":296,"surface":"莊","kind":"person","person_id":"nsa_bp5_1dk","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p018","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-007-xiangyu:m018-0334","start":334,"end":336,"surface":"項莊","kind":"person","person_id":"nsa_bp5_1dk","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p018","chapter_id":"c-shiji-007-xiangyu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji007-033","person_id":"nsa_bp5_1dk","surfaces":["莊","項莊"],"scope":"same_chapter","chapter_ids":["c-shiji-007-xiangyu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-007-xiangyu:p018","quote":"沛公旦日從百餘騎來見項王，至鴻門，謝曰：「臣與將軍戮力而攻秦，將軍戰河北，臣戰河南，然不自意能先入關破秦，得復見將軍於此。今者有小人之言，令將軍與臣有郤。」項王曰：「此沛公左司馬曹無傷言之；不然，籍何以至此。」項王即日因留沛公與飲。項王、項伯東嚮坐。亞父南嚮坐。亞父者，范增也。沛公北嚮坐，張良西向侍。范增數目項王，舉所佩玉珪以示之者三，項王默然不應。范增起，出召項莊，謂曰：「君王為人不忍，若入前為壽，壽畢，請以劍舞，因擊沛公於坐，殺之。不者，若屬皆且為所虜。」莊則入為壽，壽畢，曰：「君王與沛公飲，軍中無以為樂，請以劍舞。」項王曰：「諾。」項莊拔劍起舞，項伯亦拔劍起舞，常以身翼蔽沛公，莊不得擊。於是張良至軍門，見樊噲。樊噲曰：「今日之事何如？」良曰：「甚急。今者項莊拔劍舞，其意常在沛公也。」噲曰：「此迫矣，臣請入，與之同命。」噲即帶劍擁盾入軍門。交戟之衛士欲止不內，樊噲側其盾以撞，衛士仆地，噲遂入，披帷西向立，瞋目視項王，頭髪上指，目眥盡裂。項王按劍而跽曰：「客何為者？」張良曰：「沛公之參乘樊噲者也。」項王曰：「壯士，賜之巵酒。」則與斗巵酒。噲拜謝，起，立而飲之。項王曰：「賜之彘肩。」則與一生彘肩。樊噲覆其盾於地，加彘肩上，拔劍切而㗖之。項王曰：「壯士，能復飲乎？」樊噲曰：「臣死且不避，巵酒安足辭！夫秦王有虎狼之心，殺人如不能舉，刑人如恐不勝，天下皆叛之。懷王與諸將約曰『先破秦入咸陽者王之』。今沛公先破秦入咸陽，豪毛不敢有所近，封閉宮室，還軍霸上，以待大王來。故遣將守關者，備他盜出入與非常也。勞苦而功高如此，未有封侯之賞，而聽細說，欲誅有功之人。此亡秦之續耳，竊為大王不取也。」項王未有以應，曰：「坐。」樊噲從良坐。坐須臾，沛公起如廁，因招樊噲出。"}],"rationale":"項莊入舞後省稱莊，沿同一鴻門敘事。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-007-xiangyu:p018","text":"沛公旦日從百餘騎來見項王，至鴻門，謝曰：「臣與將軍戮力而攻秦，將軍戰河北，臣戰河南，然不自意能先入關破秦，得復見將軍於此。今者有小人之言，令將軍與臣有郤。」項王曰：「此沛公左司馬曹無傷言之；不然，籍何以至此。」項王即日因留沛公與飲。項王、項伯東嚮坐。亞父南嚮坐。亞父者，范增也。沛公北嚮坐，張良西向侍。范增數目項王，舉所佩玉珪以示之者三，項王默然不應。范增起，出召項莊，謂曰：「君王為人不忍，若入前為壽，壽畢，請以劍舞，因擊沛公於坐，殺之。不者，若屬皆且為所虜。」莊則入為壽，壽畢，曰：「君王與沛公飲，軍中無以為樂，請以劍舞。」項王曰：「諾。」項莊拔劍起舞，項伯亦拔劍起舞，常以身翼蔽沛公，莊不得擊。於是張良至軍門，見樊噲。樊噲曰：「今日之事何如？」良曰：「甚急。今者項莊拔劍舞，其意常在沛公也。」噲曰：「此迫矣，臣請入，與之同命。」噲即帶劍擁盾入軍門。交戟之衛士欲止不內，樊噲側其盾以撞，衛士仆地，噲遂入，披帷西向立，瞋目視項王，頭髪上指，目眥盡裂。項王按劍而跽曰：「客何為者？」張良曰：「沛公之參乘樊噲者也。」項王曰：「壯士，賜之巵酒。」則與斗巵酒。噲拜謝，起，立而飲之。項王曰：「賜之彘肩。」則與一生彘肩。樊噲覆其盾於地，加彘肩上，拔劍切而㗖之。項王曰：「壯士，能復飲乎？」樊噲曰：「臣死且不避，巵酒安足辭！夫秦王有虎狼之心，殺人如不能舉，刑人如恐不勝，天下皆叛之。懷王與諸將約曰『先破秦入咸陽者王之』。今沛公先破秦入咸陽，豪毛不敢有所近，封閉宮室，還軍霸上，以待大王來。故遣將守關者，備他盜出入與非常也。勞苦而功高如此，未有封侯之賞，而聽細說，欲誅有功之人。此亡秦之續耳，竊為大王不取也。」項王未有以應，曰：「坐。」樊噲從良坐。坐須臾，沛公起如廁，因招樊噲出。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-007-xiangyu:m018-0000","start":0,"end":2,"surface":"沛公","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m018-0010","start":10,"end":12,"surface":"項王","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m018-0023","start":23,"end":25,"surface":"將軍","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、匿名者、群體、動物或未定指代保留待核；不補姓名、闕代或個別成員。"},{"id":"c-shiji-007-xiangyu:m018-0031","start":31,"end":33,"su