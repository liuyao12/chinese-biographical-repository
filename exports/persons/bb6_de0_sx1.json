,"mention_ids":["c-nanshi-012-zhangyaoer:p001:m0008","c-chenshu-007-zhangyaoer:p001:m0009"]},{"surface":"宣太后","mention_ids":["c-chenshu-007-zhangyaoer:p002:m0301"]},{"surface":"皇太后","mention_ids":["c-chenshu-005-zhangyaoer-annal:p001:m0005"]}],"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-012","source_id":"s-nanshi-012-zhangyaoer-ws2060595","chapter_id":"c-nanshi-012-zhangyaoer","paragraph_id":"c-nanshi-012-zhangyaoer:p001","quote":"要兒","mention_id":"c-nanshi-012-zhangyaoer:p001:m0008"},{"work_id":"w-nanshi","book_id":"b-nanshi-012","source_id":"s-nanshi-012-zhangyaoer-ws2060595","chapter_id":"c-nanshi-012-zhangyaoer","paragraph_id":"c-nanshi-012-zhangyaoer:p003","quote":"后","mention_id":"c-nanshi-012-zhangyaoer:p003:m0005"},{"work_id":"w-chenshu","book_id":"b-chenshu-007","source_id":"s-chenshu-007-zhangyaoer-ws2015446","chapter_id":"c-chenshu-007-zhangyaoer","paragraph_id":"c-chenshu-007-zhangyaoer:p001","quote":"要兒","mention_id":"c-chenshu-007-zhangyaoer:p001:m0009"},{"work_id":"w-chenshu","book_id":"b-chenshu-007","source_id":"s-chenshu-007-zhangyaoer-ws2015446","chapter_id":"c-chenshu-007-zhangyaoer","paragraph_id":"c-chenshu-007-zhangyaoer:p002","quote":"宣太后","mention_id":"c-chenshu-007-zhangyaoer:p002:m0301"},{"work_id":"w-chenshu","book_id":"b-chenshu-005","source_id":"s-chenshu-005-zhangyaoer-annal-ws2374950","chapter_id":"c-chenshu-005-zhangyaoer-annal","paragraph_id":"c-chenshu-005-zhangyaoer-annal:p001","quote":"皇太后","mention_id":"c-chenshu-005-zhangyaoer-annal:p001:m0005"}],"review":"ai_provisional","identity_note":"原稱本姓鈕，父為章氏所養而改姓。","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"bb6_de0_sx1","source_assertion_id":"a-nan012-zhangyaoer-m-father","evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-012","source_id":"s-nanshi-012-zhangyaoer-ws2060595","chapter_id":"c-nanshi-012-zhangyaoer","paragraph_id":"c-nanshi-012-zhangyaoer:p001","quote":"陳武宣章皇后，諱要兒，吳興烏程人。本姓鈕，父景明為章氏所養，因改姓焉。后母蘇，嘗遇道士以小龜遺己，光采五色，曰：「三年有征」。及期，后生，紫光照室，因失龜所在。后少聰慧，美容儀，手爪長五寸，色並紅白。每有期功之服，則一爪先折。武帝先娶同郡錢仲方女，早卒，後乃聘后。后善書計，能誦詩及楚辭。帝為長城縣公，后拜夫人。永定元年，立為皇后。追贈后父梁散騎侍郎景明特進、金紫光祿大夫，加金章紫綬。拜后母蘇安吉縣君。二年，安吉君卒，與后父葬吳興。明年，追封后父為廣德縣侯，諡曰溫。","subject_person_mention_id":"c-nanshi-012-zhangyaoer:p001:m0008","object_person_mention_id":"c-nanshi-012-zhangyaoer:p001:m0022","relationship_anchor":{"paragraph_id":"c-nanshi-012-zhangyaoer:p001","surface":"父景明","start":21,"end":24}}],"status":"contextual_provisional","interpretation_note":"章后之父景明。","human_reviewed":false}}],"source_mention_summary":[{"source_id":"s-chenshu-007-zhangyaoer-ws2015446","work_id":"w-chenshu","book_id":"b-chenshu-007","chapter_id":"c-chenshu-007-zhangyaoer","raw_mention_count":3,"mention_ids":["c-chenshu-007-zhangyaoer:p001:m0024","c-chenshu-007-zhangyaoer:p001:m0036","c-chenshu-007-zhangyaoer:p002:m0082"],"paragraph_ids":["c-chenshu-007-zhangyaoer:p001","c-chenshu-007-zhangyaoer:p002"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-chenshu-007-zhangyaoer:p001:m0024","mention_ids":["c-chenshu-007-zhangyaoer:p001:m0024"],"kind":"paragraph"},{"canonical_mention_id":"c-chenshu-007-zhangyaoer:p001:m0036","mention_ids":["c-chenshu-007-zhangyaoer:p001:m0036"],"kind":"paragraph"},{"canonical_mention_id":"c-chenshu-007-zhangyaoer:p002:m0082","mention_ids":["c-chenshu-007-zhangyaoer:p002:m0082"],"kind":"paragraph"}],"mention_count":3,"duplicate_mention_count":0,"paragraph_occurrence_count":3,"table_occurrence_count":0,"passage_count":2,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"3處獨立位置，3個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"},{"source_id":"s-nanshi-012-zhangyaoer-ws2060595","work_id":"w-nanshi","book_id":"b-nanshi-012","chapter_id":"c-nanshi-012-zhangyaoer","raw_mention_count":2,"mention_ids":["c-nanshi-012-zhangyaoer:p001:m0022","c-nanshi-012-zhangyaoer:p001:m0175"],"paragraph_ids":["c-nanshi-012-zhangyaoer:p001"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-nanshi-012-zhangyaoer:p001:m0022",