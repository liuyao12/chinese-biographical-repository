:p003:m0061","start":61,"end":63,"surface":"其母","kind":"person","person_id":"fog_r7x_1uh","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p003:m0063","start":63,"end":65,"surface":"王氏","kind":"person","person_id":"fog_r7x_1uh","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p003:m0071","start":71,"end":72,"surface":"安","kind":"person","person_id":"aa6_83c_juy_B","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p003:m0079","start":79,"end":81,"surface":"王氏","kind":"person","person_id":"fog_r7x_1uh","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p003:m0086","start":86,"end":88,"surface":"新婦","kind":"person","person_id":"fog_r7x_1uh","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p003:m0099","start":99,"end":101,"surface":"此兒","kind":"person","person_id":"aa6_83c_juy_AA","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p003:m0107","start":107,"end":108,"surface":"朗","kind":"person","person_id":"aa6_83c_juy_AA","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p003:m0110","start":110,"end":111,"surface":"安","kind":"person","person_id":"aa6_83c_juy_B","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p003:m0117","start":117,"end":119,"surface":"家嫂","kind":"person","person_id":"fog_r7x_1uh","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p003:m0133","start":133,"end":134,"surface":"朗","kind":"person","person_id":"aa6_83c_juy_AA","status":"contextual_provisional"}],"source_position":{"first_line":125,"last_line":126,"revision_id":2645985,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-079-xielang-family","book_id":"b-jinshu-079","work_id":"w-jinshu","source_id":"s-jinshu-079-xielang-family"},{"id":"c-jinshu-079-xielang-family:p004","text":"子重，字景重，明秀有才名，為會稽王道子驃騎長史。嘗因侍坐，于時月夜明淨，道子歎以為佳。重率爾曰：「意謂乃不如微雲點綴。」道子因戲重曰：「卿居心不淨，乃復強欲滓穢太清邪！」","text_layer":"received_chapter","annotation_stat