{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"xop_byp_p7d","canonical_person_id":"xop_byp_p7d","id_aliases":["cbr-p002410"],"identity_policy":"contextual_provisional","person_ids":["xop_byp_p7d"],"persons":[{"id":"xop_byp_p7d","label":"虙戲（趙世家引語候選）","status":"active","historicity":"legendary_tradition","aliases":[{"surface":"虙戲","mention_ids":["c-shiji-043-zhao:m071-0050"]}],"evidence":[{"mention_id":"c-shiji-043-zhao:m071-0050","chapter_id":"c-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p071","quote":"虙戲"}],"id_aliases":["cbr-p002410"]}],"source_mention_summary":[{"source_id":"s-shiji-043-zhao","work_id":"w-shiji","book_id":"b-shiji-043","chapter_id":"c-shiji-043-zhao","mention_count":1,"mention_ids":["c-shiji-043-zhao:m071-0050"],"paragraph_ids":["c-shiji-043-zhao:p071"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-043-zhao"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-043-zhao:m071-0050","start":50,"end":52,"surface":"虙戲","kind":"person","person_id":"xop_byp_p7d","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p071","chapter_id":"c-shiji-043-zhao"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji043-181","person_id":"xop_byp_p7d","surfaces":["虙戲"],"scope":"same_chapter","chapter_ids":["c-shiji-043-zhao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-043-zhao:p071","quote":"趙文、趙造、周袑、趙俊皆諫止王毋胡服，如故法便。王曰：「先王不同俗，何古之法？帝王不相襲，何禮之循？虙戲、神農教而不誅，黃帝、堯、舜誅而不怒。及至三王，隨時制法，因事制禮。法度制令各順其宜，衣服器械各便其用。故禮也不必一道，而便國不必古。聖人之興也不相襲而王，夏、殷之衰也不易禮而滅。然則反古未可非，而循禮未足多也。且服奇者志淫，則是鄒、魯無奇行也；俗辟者民易，則是吳、越無秀士也。且聖人利身謂之服，便事謂之禮。夫進退之節，衣服之制者，所以齊常民也，非所以論賢者也。故齊民與俗流，賢者與變倶。故諺曰『以書御者不盡馬之情，以古制今者不達事之變』。循法之功，不足以髙世；法古之學，不足以制今。子不及也。」遂胡服招騎射。"}],"rationale":"限本篇人物、連續政治事件及明示生子是為敘事；武靈王／主父、王子何／惠文王及惠后吳娃按本文連接。公子章不與早期敬侯章合併，何不與較早趙何合併；髙信與信期、趙袑與周袑分候選。王賁不按熟知秦將同名接人。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-043-zhao:p071","text":"趙文、趙造、周袑、趙俊皆諫止王毋胡服，如故法便。王曰：「先王不同俗，何古之法？帝王不相襲，何禮之循？虙戲、神農教而不誅，黃帝、堯、舜誅而不怒。及至三王，隨時制法，因事制禮。法度制令各順其宜，衣服器械各便其用。故禮也不必一道，而便國不必古。聖人之興也不相襲而王，夏、殷之衰也不易禮而滅。然則反古未可非，而循禮未足多也。且服奇者志淫，則是鄒、魯無奇行也；俗辟者民易，則是吳、越無秀士也。且聖人利身謂之服，便事謂之禮。夫進退之節，衣服之制者，所以齊常民也，非所以論賢者也。故齊民與俗流，賢者與變倶。故諺曰『以書御者不盡馬之情，以古制今者不達事之變』。循法之功，不足以髙世；法古之學，不足以制今。子不及也。」遂胡服招騎射。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-043-zhao:m071-0000","start":0,"end":2,"surface":"趙文","kind":"person","person_id":"ue1_qha_ehn","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m071-0003","start":3,"end":5,"surface":"趙造","kind":"person","person_id":"bfv_clh_n6y","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m071-0006","start":6,"end":8,"surface":"周袑","kind":"person","person_id":"0q2_ioh_psy","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m071-0009","start":9,"end":11,"surface":"趙俊","kind":"person","person_id":"ybw_y4h_z69","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m071-0014","start":14,"end":15,"surface":"王","kind":"person","person_id":"txj_z8z_5me_A","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m071-0024","start":24,"end":25,"surface":"王","kind":"person","person_id":"txj_z8z_5me_A","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m071-0028","start":28,"end":30,"surface":"先王","kind":"unresolved","person_id":null,"status":"unresolved","note":"先王泛稱，不連當前武靈王。"},{"id":"c-shiji-043-zhao:m071-0039","start":39,"end":41,"surface":"帝王","ki