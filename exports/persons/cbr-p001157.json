"person_id":"yti_e9l_fle","status":"contextual_provisional","paragraph_id":"c-shiji-032-qi:p061","chapter_id":"c-shiji-032-qi"},{"id":"c-shiji-032-qi:m061-0168","start":168,"end":170,"surface":"高厚","kind":"person","person_id":"yti_e9l_fle","status":"contextual_provisional","paragraph_id":"c-shiji-032-qi:p061","chapter_id":"c-shiji-032-qi"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-032-qi:p060","text":"靈公九年，晉欒書弒其君厲公。十年，晉悼公伐齊，齊令公子光質晉。十九年，立子光為太子，高厚傅之，令會諸侯盟於鐘離。二十七年，晉使中行獻子伐齊。齊師敗，靈公走入臨菑。晏嬰止靈公，靈公弗從。曰：「君亦無勇矣！」晉兵遂圍臨菑，臨菑城守不敢出，晉焚郭中而去。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-032-qi:m060-0000","start":0,"end":2,"surface":"靈公","kind":"person","person_id":"9w2_c77_53m_AAA","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m060-0006","start":6,"end":8,"surface":"欒書","kind":"person","person_id":"c8b_f8t_ylf","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m060-0011","start":11,"end":13,"surface":"厲公","kind":"person","person_id":"f42_zl0_lkq","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m060-0017","start":17,"end":20,"surface":"晉悼公","kind":"person","person_id":"kat_48c_thr_AAA","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m060-0025","start":25,"end":28,"surface":"公子光","kind":"person","person_id":"9w2_c77_53m_AAAA","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m060-0036","start":36,"end":38,"surface":"子光","kind":"person","person_id":"9w2_c77_53m_AAAA","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m060-0042","start":42,"end":44,"surface":"高厚","kind":"person","person_id":"yti_e9l_fle","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m060-0063","start":63,"end":67,"surface":"中行獻子","kind":"person","person_id":"xoj_ji6_85j","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m060-0074","start":74,"end":76,"surface":"靈公","kind":"person","person_id":"9w2_c77_53m_AAA","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m060-0081","start":81,"end":83,"surface":"晏嬰","kind":"person","person_id":"jcn_rp4_qap","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m060-0084","start":84,"end":86,"surface":"靈公","kind":"person","person_id":"9w2_c77_53m_AAA","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m060-0087","start":87,"end":89,"surface":"靈公","kind":"person","person_id":"9w2_c77_53m_AAA","status":"contextual_provisional"}],"chapter_id":"c-shiji-032-qi","book_id":"b-shiji-032","work_id":"w-shiji","source_id":"s-shiji-032-qi"},{"id":"c-shiji-032-qi:p061","text":"二十八年，初，靈公取魯女，生子光，以為太子。仲姬，戎姬。戎姬嬖，仲姬生子牙，屬之戎姬。戎姬請以為太子，公許之。仲姬曰：「不可。光之立，列於諸侯矣，今無故廢之，君必悔之。」公曰：「在我耳。」遂東太子光，使高厚傅牙為太子。靈公疾，崔杼迎故太子光而立之，是為莊公。莊公殺戎姬。五月壬辰，靈公卒，莊公即位，執太子牙於句竇之丘，殺之。八月，崔杼殺高厚。晉聞齊亂，伐齊，至高唐。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-032-qi:m061-0007","start":7,"end":9,"surface":"靈公","kind":"person","person_id":"9w2_c77_53m_AAA","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m061-0010","start":10,"end":12,"surface":"魯女","kind":"person","person_id":"91b_436_pst","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m061-0014","start":14,"end":16,"surface":"子光","kind":"person","person_id":"9w2_c77_53m_AAAA","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m061-0019","start":19,"end":21,"surface":"太子","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、族稱或未定指代；齊秉意茲等疑讀待版本校勘，不補熟知姓名。"},{"id":"c-shiji-032-qi:m061-0022","start":22,"end":24,"surface":"仲姬","kind":"person","person_id":"m0l_71n_b8f","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m061-0025","start":25,"end":27,"surface":"戎姬","kind":"person","person_id":"o0m_w07_a7p","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m061-0028","start":28,"end":30,"surface":"戎姬","kind":"person","person_id"