e_role_fields":{},"human_reviewed":false,"slot":"career-041","recipient_role":"r14"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-043","source_id":"s-jinshu-043-ws2618531-shantao","chapter_id":"c-jinshu-043-shantao","paragraph_id":"c-jinshu-043-shantao:p013","quote":"後拜司徒，濤復固讓。」詔曰：「郡年耆德茂，朝之碩老，是以授君台輔之位。而遠崇克讓，至於反覆，良用於邑。君當終始朝政，翼輔朕躬。」濤又表曰：「臣事天朝三十餘年，卒無毫釐以崇大化。陛下私臣無已，猥授三司。臣聞德薄位高，力少任重，上有折足之凶，下有廟門之咎，願陛下垂累世之恩，乞臣骸骨。詔曰：「君翼贊朝政，保乂皇家，匡佐之勳，朕所倚賴。司徒之職，實掌幫教，故用敬授，以答群望。豈宜沖讓以自抑損邪！」已敕斷章表，使者乃臥加章綬。濤曰：「垂沒之人，豈可汙官府乎！」輿疾歸家。乙太康四年薨，時年七十九，詔賜東園秘器、朝服一具、衣一襲、錢五十萬、布百匹，以供喪事，策贈司徒，蜜印紫綬，侍中貂蟬，新遝伯蜜印青硃綬，祭乙太牢，諡曰康。將葬，賜錢四十萬、布百匹。左長史範晷等上言：「濤舊第屋十間，子孫不相容。」帝為之立室。","person_mention_id":"c-jinshu-043-shantao:p013:m0324"}],"attestations":[{"id":"th-jin043-shantao-career-041:a001","paragraph_id":"c-jinshu-043-shantao:p013","start":321,"end":324,"surface":"左長史","person_mention_id":"c-jinshu-043-shantao:p013:m0324","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"原任命/用稱按本句角色；未知任終，不借卒年，日期只綁明示同授事件。","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-043-shantao:p013","text":"後拜司徒，濤復固讓。」詔曰：「郡年耆德茂，朝之碩老，是以授君台輔之位。而遠崇克讓，至於反覆，良用於邑。君當終始朝政，翼輔朕躬。」濤又表曰：「臣事天朝三十餘年，卒無毫釐以崇大化。陛下私臣無已，猥授三司。臣聞德薄位高，力少任重，上有折足之凶，下有廟門之咎，願陛下垂累世之恩，乞臣骸骨。詔曰：「君翼贊朝政，保乂皇家，匡佐之勳，朕所倚賴。司徒之職，實掌幫教，故用敬授，以答群望。豈宜沖讓以自抑損邪！」已敕斷章表，使者乃臥加章綬。濤曰：「垂沒之人，豈可汙官府乎！」輿疾歸家。乙太康四年薨，時年七十九，詔賜東園秘器、朝服一具、衣一襲、錢五十萬、布百匹，以供喪事，策贈司徒，蜜印紫綬，侍中貂蟬，新遝伯蜜印青硃綬，祭乙太牢，諡曰康。將葬，賜錢四十萬、布百匹。左長史範晷等上言：「濤舊第屋十間，子孫不相容。」帝為之立室。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-043-shantao:p013:m0005","start":5,"end":6,"surface":"濤","kind":"person","person_id":"0uv_x8k_mfc_A