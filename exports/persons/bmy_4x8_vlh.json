on","person_id":"bmy_4x8_vlh","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-061-lukai:line052","chapter_id":"c-sanguozhi-061-lukai"},{"id":"c-sanguozhi-061-lukai:line052:m0310","start":310,"end":311,"surface":"彧","kind":"person","person_id":"bmy_4x8_vlh","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-061-lukai:line052","chapter_id":"c-sanguozhi-061-lukai"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-055-dingfeng:line138","text":"休薨，奉與丞相濮陽興等從萬彧之言，共迎立孫皓，遷右大司馬左軍師。寶鼎三年，皓命奉與諸葛靚攻合肥。奉與晉大將石苞書，搆而間之，苞以徵還。建衡元年，奉復帥衆治徐塘，因攻晉穀陽。穀陽民知之，引去，奉無所獲。皓怒，斬奉導軍。三年，卒。奉貴而有功，漸以驕矜，或有毀之者，皓追以前出軍事，徙奉家於臨川。奉弟封，官至後將軍，先奉死。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-055-dingfeng:line138:m0000","start":0,"end":1,"surface":"休","kind":"person","person_id":"0fo_c5c_4yh","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-055-dingfeng:line138:m0003","start":3,"end":4,"surface":"奉","kind":"person","person_id":"nd1_eoc_wrb","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-055-dingfeng:line138:m0007","start":7,"end":10,"surface":"濮陽興","kind":"person","person_id":"u44_7nr_99a","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-055-dingfeng:line138:m0012","start":12,"end":14,"surface":"萬彧","kind":"person","person_id":"bmy_4x8_vlh","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-055-dingfeng:line138:m0020","start":20,"end":22,"surface":"孫皓","kind":"person","person_id":"05e_9bb_55a","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-055-dingfeng:line138:m0037","start":37,"end":38,"s