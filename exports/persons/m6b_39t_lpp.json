_summary":[{"source_id":"s-shiji-005-qin","work_id":"w-shiji","book_id":"b-shiji-005","chapter_id":"c-shiji-005-qin","mention_count":1,"mention_ids":["c-shiji-005-qin:m069-0006"],"paragraph_ids":["c-shiji-005-qin:p069"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-005-qin"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"unresolved_identity_cases":[{"id":"u-shiji005-yangu-chuli","candidate_person_ids":["m6b_39t_lpp","r9n_0vc_ywa"],"paragraph_ids":["c-shiji-005-qin:p068","c-shiji-005-qin:p069"],"status":"unresolved","note":"稱號與名字可能同指，仍待專門證據，不因疾字相同直接合併。","chapter_id":"c-shiji-005-qin","source_id":"s-shiji-005-qin"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-005-qin:m069-0006","start":6,"end":9,"surface":"嚴君疾","kind":"person","person_id":"m6b_39t_lpp","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p069","chapter_id":"c-shiji-005-qin"}],"relations":[],"title_holdings":[{"id":"th-shiji005-069","person_id":"m6b_39t_lpp","title":"相","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-005-qin","source_id":"s-shiji-005-qin","paragraph_id":"c-shiji-005-qin:p069","quote":"昭襄王元年，嚴君疾為相。甘茂出之魏。二年，彗星見。庶長壯與大臣、諸侯、公子為逆，皆誅，及惠文后皆不得良死。悼武王后出歸魏。三年，王冠。與楚王會黃棘，與楚上庸。四年，取蒲阪。彗星見。五年，魏王來朝應亭，復與魏蒲阪。六年，蜀侯煇反，司馬錯定蜀。庶長奐伐楚，斬首二萬。涇陽君質於齊。日食，晝晦。七年，拔新城。摢裏子卒。八年，使將軍羋戎攻楚，取新市。齊使章子，魏使公孫喜，韓使暴鳶共攻楚方城，取唐眛。趙破中山，其君亡，竟死齊。魏公子勁、韓公子長為諸侯。九年，孟嘗君薛文來相秦。奐攻楚，取八城，殺其將景快。十年，楚懷王入朝秦，秦留之。薛文以金受免。樓緩為丞相。十一年，齊、韓、魏、趙、宋、中山五國共攻秦，至鹽氏而還。秦與韓、魏河北及封陵以和。彗星見。楚懷王走之趙，趙不受，還之秦，即死，歸葬。十二年，樓緩免，穰侯魏冉為相。予楚粟五萬石。"}],"attestations":[{"id":"th-shiji005-069:a001","paragraph_id":"c-shiji-005-qin:p069","start":10,"end":11,"surface":"相","person_mention_id":"c-shiji-005-qin:m069-0006","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"相魏、相秦、相楚各按來源分記；左右丞相只確定二人皆任丞相，不推誰左誰右。未據死亡自動設定官職終點；樓緩與魏冉免相另待期間整理。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-005-qin:p068","text":"武王元年，與魏惠王會臨晉。誅蜀相壯。張儀、魏章皆東出之魏。伐義渠、丹、犁。二年，初置丞相，摢裏疾、甘茂為左右丞相。張儀死於魏。三年，與韓襄王會臨晉外。南公揭卒，摢裏疾相韓。武王謂甘茂曰：「寡人欲容車通三川，窺周室，死不恨矣。」其秋，使甘茂、庶長封伐宜陽。四年，拔宜陽，斬首六萬。涉河，城武遂。魏太子來朝。武王有力好戲，力士任鄙、烏獲、孟說皆至大官。王與孟說舉鼎，絕臏。八月，武王死。族孟說。武王取魏女為后，無子。立異母弟，是為昭襄王。昭襄母楚人，姓羋氏，號宣太后。武王死時，昭襄王為質於燕，燕人送歸，得立。","annotation_status":"in_progress","mentions":[{"id":"c-shiji-005-qin:m068-0000","start":0,"end":2,"surface":"武王","kind":"person","person_id":"y97_huh_vuz_AAAAAAAAAAAAABAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0006","start":6,"end":9,"surface":"魏惠王","kind":"person","person_id":"bhp_5xd_88r","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0014","start":14,"end":17,"surface":"蜀相壯","kind":"person","person_id":"kqe_x0t_s25","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0018","start":18,"end":20,"surface":"張儀","kind":"person","person_id":"uq6_74z_vtv","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0021","start":21,"end":23,"surface":"魏章","kind":"person","person_id":"2pv_dtb_lrw","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0045","start":45,"end":48,"surface":"摢裏疾","kind":"person","person_id":"r9n_0vc_ywa","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0049","start":49,"end":51,"surface":"甘茂","kind":"person","person_id":"8im_m5e_cpy","