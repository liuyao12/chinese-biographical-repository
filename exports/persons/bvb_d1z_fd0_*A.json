-001","subject_person_id":"bvb_d1z_fd0_*AA","predicate":"father","object_person_id":"bvb_d1z_fd0_*A","status":"source_attested","evidence":[{"work_id":"w-zizhitongjian","book_id":"b-zizhitongjian-020","chapter_id":"c-zizhitongjian-020-han12","source_id":"s-zizhitongjian-020-han12","paragraph_id":"c-zizhitongjian-020-han12:p-nanyue-001","quote":"初南越文王遣其子嬰齊入宿衛在長安取邯鄲樛氏女生子興文王薨嬰齊立乃蔵其先武帝璽上書請立樛氏女為后興為嗣"}],"qualifiers":{"source_term":"南越文王遣其子嬰齊"},"interpretation_note":"明其子，不僅因太子或代立推父子。文王與胡的身份對讀另記。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[{"connection":"grandfather","generation_distance":2,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-113-nanyue","source_id":"s-shiji113-nanyue","paragraph_id":"c-shiji-113-nanyue:p004","quote":"佗孫胡為南越王。此時閩越王郢興兵擊南越邊邑，胡使人上書曰：「兩越俱為藩臣，毋得擅興兵相攻擊。今閩越興兵侵臣，臣不敢興兵，唯天子詔之。」於是天子多南越義，守職約，為興師，遣兩將軍往討閩越。兵未踰嶺，閩越王弟餘善殺郢以降，於是罷兵。"}],"source_assertion_id":"a-shiji113-001","interpretation_note":"分支字元不表排行；只接明示父系來源，闕代不造父親。","reviewer":"Codex（AI 代理）","ancestor_person_id":"bvb_d1z_fd0","parent_person_id":null,"intermediate_person_ids":[null],"person_id":"bvb_d1z_fd0_*A"}],"life_events":[{"id":"le-shiji113-p005-bvb_d1z_fd0_*A","person_id":"bvb_d1z_fd0_*A","event_type":"death","status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-113-nanyue","source_id":"s-shiji113-nanyue","paragraph_id":"c-shiji-113-nanyue:p005","quote":"天子使莊助往諭意南越王，胡頓首曰：「天子乃為臣興兵討閩越，死無以報德！」遣太子嬰齊入宿衛。謂助曰：「國新被寇，使者行矣。胡方日夜裝入見天子。」助去後，其大臣諫胡曰：「漢興兵誅郢，亦行以驚動南越。且先王昔言，事天子期無失禮，要之不可以說好語入見。入見則不得復歸，亡國之勢也。」於是胡稱病，竟不入見。後十餘歲，胡實病甚，太子嬰齊請歸。胡薨，謚為文王。","person_mention_id":"c-shiji-113-nanyue:m005-0012"}],"interpretation_note":"胡薨明記死亡，後十餘歲不硬算整年。 不補死亡地點、葬地或全部官爵終點。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"mentions":[{"id":"c-shiji-113-nanyue:m004-0002",