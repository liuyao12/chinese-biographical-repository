王遣其子嬰齊入¶\n宿衛(南越王胡薨謚文王嬰齊入/宿衛見十七卷建元元年)在長安取邯鄲樛氏¶\n女(取讀曰娶邯鄲屬趙/國師古曰樛居虯翻)生子興文王薨嬰齊立乃蔵其¶\n先武帝璽(趙佗自號南越武帝/李竒曰去其僣號)上書請立樛氏女為后¶\n興為嗣漢數使使者風諭嬰齊入朝(數所角翻師古曰/風讀曰諷諷諭令)¶\n(入/朝)嬰齊尚樂擅殺生自恣懼入見要用漢法比内諸侯¶","scope":"commentary_identifies_wenwang_as_hu","source_blob_sha":"71c9f2f93a06f0869cbe807edf3f42524a9ea2a3","response_sha256":"f21e05fe0f13c21e1e437b8f793cdf79a9fc0a2daecea645135f9696d940d8c6","response_extent":{"first_line":201,"last_line":350,"partial_file":true},"image_verified":false,"note":"古注與正文分源，不把注所述建元元年冒作正文全部事件日期。"}],"rationale":"史記胡謚文王、同遣嬰齊入宿衛及嗣立事件，通鑑古注也指胡；不混趙佗先武帝。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"equivalence_decisions":[],"sources":[{"chapter_id":"c-shiji-113-nanyue","work_id":"w-shiji","book_id":"b-shiji-113","source_id":"s-shiji113-nanyue","source_ref":"corpus/shiji/113.json"},{"chapter_id":"c-shiji-116-xinanyi","work_id":"w-shiji","book_id":"b-shiji-116","source_id":"s-shiji116-xinanyi","source_ref":"corpus/shiji/116.json"},{"chapter_id":"c-zizhitongjian-020-han12","work_id":"w-zizhitongjian","book_id":"b-zizhitongjian-020","source_id":"s-zizhitongjian-020-han12","source_ref":"corpus/zizhitongjian/020.json"}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true},"passage_refs":[{"chapter":"corpus/shiji/113.json","id":"c-shiji-113-nanyue:p004"},{"chapter":"corpus/shiji/113.json","id":"c-shiji-113-nanyue:p005"},{"chapter":"corpus/shiji/116.json","id":"c-shiji-116-xinanyi:p003"},{"chapter":"corpus/zizhitongjian/020.json","id":"c-zizhitongjian-020-han12:p-nanyue-001"}]}
