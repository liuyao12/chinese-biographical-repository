_sha256":"cf85ec7d57e3a89d3ebfbd0a248c4532540182822edf586539e46ffb85f7868c","source_layer":"received_biography","editorial_excerpt_boundary":false},"chapter_id":"c-nanshi-011-zangqiyuan","book_id":"b-nanshi-011","work_id":"w-nanshi","source_id":"s-nanshi-011-zangqiyuan-ws2288359"},{"id":"c-songshu-041-yuanqigui:p011","text":"大明五年，世祖詔曰：「昔漢道既靈，博平煇絕，魏國方安，嘉憲啟策，皆因心所弘，酌典沿誥。亡外祖親王夫人柔德淑範，光啟坤載。屬內位闕正，攝饋閨庭，儀被芳闈，聞宣戚里。永言感遠，思追榮秩，宜式傍鴻則，敬登徽序。」乃追贈豫章郡新淦縣平樂鄉君。后之所生母也。又詔：「趙、蕭、臧光祿、袁敬公、平樂鄉君墓，先未給塋戶。加世數已遠，胤嗣衰陵。外戚尊屬，不宜使墳塋蕪穢。可各給蠻戶三，以供灑掃。」","mentions":[{"id":"c-songshu-041-yuanqigui:p011:u0017","start":17,"end":19,"surface":"博平","person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"追贈詔所引漢魏故實，人物和所指封邑另待逐篇核。"},{"id":"c-songshu-041-yuanqigui:p011:u0027","start":27,"end":29,"surface":"嘉憲","person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"追贈詔所引漢魏故實，人物和所指封邑另待逐篇核。"},{"id":"c-songshu-041-yuanqigui:p011:m0047","start":47,"end":48,"surface":"王","person_id":"qdb_j43_v9b","kind":"person","status":"contextual_provisional","interpretation_note":"祭墓稱號或姓氏與本傳、后妃本傳互證。"},{"id":"c-songshu-041-yuanqigui:p011:m0128","start":128,"end":129,"surface":"趙","person_id":"r5n_x7v_cwf_A","kind":"person","status":"contextual_provisional","interpretation_note":"祭墓稱號或姓氏與本傳、后妃本傳互證。"},{"id":"c-songshu-041-yuanqigui:p011:m0130","start":130,"end":131,"surface":"蕭","person_id":"ph1_ms8_hyq_A","kind":"person","status":"contextual_provisional","interpretation_note":"祭墓稱號或姓氏與本傳、后妃本傳互證。"},{"id":"c-songshu-041-yuanqigui:p011:m0132","start":132,"end":133,"surface":"臧","person_id":"0zd_9uz_t7m_A","kind":"person","status":"contextual_provisional","interpretation_note":"祭墓稱號或姓氏與本傳、后妃本傳互證。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":2634831,"first_line":213,"last_line":213,"raw_start":5958,"raw_end":6231,"raw_character_offsets":[5963,5964,5965,5966,5969,5970,5971,5972,5973,5974,5975,5976,5977,5978,5979,5980,5981,5982,5983,5984,598