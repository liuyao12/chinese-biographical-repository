der_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanshi-011-yuanqigui:p002","text":"后亡後，常有小小靈應。明帝所生沈美人嘗以非罪見責，應賜死，從後昔所住徽音殿前度。此殿有五間，自后崩後常閉。美人至殿前流涕大言曰：「今日無罪就死，先後若有靈當知之。」殿戶應聲豁然開，職掌者遽白文帝，驚往視之，美人乃得釋。大明五年，孝武乃詔追后之所生外祖親王夫人為豫章郡新淦平樂鄉君，又詔趙、蕭、臧光祿、袁敬公、平樂鄉君墓，先未給塋戶，各給蠻戶三以供灑掃。後公湛之自有傳。","mentions":[{"id":"c-nanshi-011-yuanqigui:p002:m0015","start":15,"end":16,"surface":"沈","person_id":"eis_6fq_q7u","kind":"person","status":"contextual_provisional","interpretation_note":"祭墓稱號或姓氏與本傳、后妃本傳互證。"},{"id":"c-nanshi-011-yuanqigui:p002:m0126","start":126,"end":127,"surface":"王","person_id":"qdb_j43_v9b","kind":"person","status":"contextual_provisional","interpretation_note":"祭墓稱號或姓氏與本傳、后妃本傳互證。"},{"id":"c-nanshi-011-yuanqigui:p002:m0142","start":142,"end":143,"surface":"趙","person_id":"r5n_x7v_cwf_A","kind":"person","status":"contextual_provisional","interpretation_note":"祭墓稱號或姓氏與本傳、后妃本傳互證。"},{"id":"c-nanshi-011-yuanqigui:p002:m0144","start":144,"end":145,"surface":"蕭","person_id":"ph1_ms8_hyq_A","kind":"person","status":"contextual_provisional","interpretation_note":"祭墓稱號或姓氏與本傳、后妃本傳互證。"},{"id":"c-nanshi-011-yuanqigui:p002:m0146","start":146,"end":147,"surface":"臧","person_id":"0zd_9uz_t7m_A","kind":"person","status":"contextual_provisional","interpretation_note":"祭墓稱號或姓氏與本傳、后妃本傳互證。"},{"id":"c-nanshi-011-yuanqigui:p002:m0178","start":178,"end":179,"surface":"湛","person_id":"3tt_4ey_uti","kind":"person","status":"contextual_provisional","interpretation_note":"本行原作後公湛之，宋41本傳末作后父湛，本卷首句明稱左光祿大夫湛之庶女。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":2288359,"first_line":37,"last_line":37,"raw_start":2595,"raw_end":2790,"raw_character_offsets":[2597,2600,2601,2602,2603,2604,2605,2606,2607,2608,2609,2610,2611,2612,2613,2614,2615,2616,2617,2618,2619,2620,2621,2622,2623,2624,2625,2626,2627,2628,2629,2630,2631,2632,2633,2634,2635,2636,2637,2638,2639,2640,2641,2642,2643,2644,264