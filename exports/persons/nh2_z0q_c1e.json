:"person","person_id":"nh2_z0q_c1e","status":"contextual_provisional","paragraph_id":"c-shiji-126-huaji:p025","chapter_id":"c-shiji-126-huaji"},{"id":"c-shiji-126-huaji:m026-0025","start":25,"end":28,"surface":"西門豹","kind":"person","person_id":"nh2_z0q_c1e","status":"contextual_provisional","paragraph_id":"c-shiji-126-huaji:p026","chapter_id":"c-shiji-126-huaji"}],"relations":[],"title_holdings":[{"id":"th-shiji126-029","person_id":"nh2_z0q_c1e","title":"鄴令","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-126-huaji","source_id":"s-shiji126-huaji","paragraph_id":"c-shiji-126-huaji:p023","quote":"魏文侯時，西門豹為鄴令。豹往到鄴，會長老，問之民所疾苦。長老曰：「苦為河伯娶婦，以故貧。」豹問其故，對曰：「鄴三老、廷掾常歲賦斂百姓，收取其錢得數百萬，用其二三十萬為河伯娶婦，與祝巫共分其餘錢持歸。當其時，巫行視小家女好者，云是當為河伯婦，即娉取。洗沐之，為治新繒綺縠衣，閒居齋戒；為治齋宮河上，張緹絳帷，女居其中。為具牛酒飯食，行十餘日。共粉飾之，如嫁女床席，令女居其上，浮之河中。始浮，行數十里乃沒。其人家有好女者，恐大巫祝為河伯取之，以故多持女遠逃亡。以故城中益空無人，又困貧，所從來久遠矣。民人俗語曰『即不為河伯娶婦，水來漂沒，溺其人民』云。」西門豹曰：「至為河伯娶婦時，願三老、巫祝、父老送女河上，幸來告語之，吾亦往送女。」皆曰：「諾。」"}],"attestations":[{"id":"th-shiji126-029:a001","paragraph_id":"c-shiji-126-huaji:p023","start":9,"end":11,"surface":"鄴令","person_mention_id":"c-shiji-126-huaji:m023-0005","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"明示封拜與文獻用稱分開；未知授任年及終點保持未知，不以死亡自動終止官爵。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-126-huaji:p023","text":"魏文侯時，西門豹為鄴令。豹往到鄴，會長老，問之民所疾苦。長老曰：「苦為河伯娶婦，以故貧。」豹問其故，對曰：「鄴三老、廷掾常歲賦斂百姓，收取其錢得數百萬，用其二三十萬為河伯娶婦，與祝巫共分其餘錢持歸。當其時，巫行視小家女好者，云是當為河伯婦，即娉取。洗沐之，為治新繒綺縠衣，閒居齋戒；為治齋宮河上，張緹絳帷，女居其中。為具牛酒飯食，行十餘日。共粉飾之，如嫁女床席，令女居其上，浮之河中。始浮，行數十里乃沒。其人家有好女者，恐大巫祝為河伯取之，以故多持女遠逃亡。以故城中益空無人，又困貧，所從來久遠矣。民人俗語曰『即不為河伯娶婦，水來漂沒，溺其人民』云。」西門豹曰：「至為河伯娶婦時，願三老、巫祝、父老送女河上，幸來告語之，吾亦往送女。」皆曰：「諾。」","annotation_status":"in_progress","text_layer":"witness_appended_chu_note","mentions":[{"id":"c-shiji-126-huaji:m023-0000","start":0,"end":3,"surface":"魏文侯","kind":"person","person_id":"sm1_lvu_yv1","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m023-0005","start":5,"end":8,"surface":"西門豹","kind":"person","person_id":"nh2_z0q_c1e","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m023-0012","start":12,"end":13,"surface":"豹","kind":"person","person_id":"nh2_z0q_c1e","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m023-0018","start":18,"end":20,"surface":"長老","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-126-huaji:m023-0028","start":28,"end":30,"surface":"長老","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-126-huaji:m023-0035","start":35,"end":37,"surface":"河伯","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-126-huaji:m023-0045","start":45,"end":46,"surface":"豹","kind":"person","person_id":"nh2_z0q_c1e","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m023-0055","start":55,"end":57,"surface":"三老","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-126-huaji:m023-0058","start":58,"end":60,"surface":"廷掾","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-126-huaji:m023-0083","start":83,"end":85,"surface":"河伯","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-126-huaji:m023-0106","start":106,"end":109,"surface":"小家女","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-126-huaji:m023-0116","start":116,"end":118,"surface":"河伯","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-126-huaji:m023-0212","start":212,"end":214,"surface":"巫祝","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-126-huaji:m023-0215","start":215,"end":217,"surface":"河伯","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-126-huaji:m023-0258","start":258,"end":260,"surface":"河伯","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-126-huaji:m023-0276","start":276,"end":279,"surface":"西門豹","kind":"person","person_id":"nh2_z0q_c1e","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m023-0284","start":284,"end":286,"surface":"河伯","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-126-huaji:m023-0291","start":291,"end":293,"surface":"三老","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-126-huaji:m023-0294","start":294,"end":296,"surface":"巫祝","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-126-huaji:m023-0297","start":297,"end":299,"surface":"父老","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-126-huaji","book_id":"b-shiji-126","work_id":"w-shiji","source_id":"s-shiji126-huaji"},{"id":"c-shiji-126-huaji:p024","text":"至其時，西門豹往會之河上。三老、官屬、豪長者、裏父老皆會，以人民往觀之者三二千人。其巫，老女子也，已年七十。從弟子女十人所，皆衣繒單衣，立大巫后。西門豹曰：「呼河伯婦來，視其好醜。」即將女出帷中，來至前。豹視之，顧謂三老、巫祝、父老曰：「是女子不好，煩大巫嫗為入報河伯，得更求好女，后日送之。」即使吏卒共抱大巫嫗投之河中。有頃，曰：「巫嫗何久也？弟子趣之！」復以弟子一人投河中。有頃，曰：「弟子何久也？復使一人趣之！」復投一弟子河中。凡投三弟子。西門豹曰：「巫嫗弟子是女子也，不能白事，煩三老為入白之。」復投三老河中。西門豹簪筆磬折，向河立待良久。長老、吏傍觀者皆驚恐。西門豹顧曰：「巫嫗、三老不來還，柰之何？」欲復使廷掾與豪長者一人入趣之。皆叩頭，叩頭且破，額血流地，色如死灰。西門豹曰：「諾，且留待之須臾。」須臾，豹曰：「廷掾起矣。狀河伯留客之久，若皆罷去歸矣。」鄴吏民大驚恐，從是以後，不敢復言為河伯娶婦。","annotation_status":"in_progress","text_layer":"witness_appended_chu_note","mentions":[{"id":"c-shiji-126-huaji:m024-0004","start":4,"end":7,"surface":"西門豹","kind":"person","person_id":"nh2_z0q_c1e","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m024-0013","start":13,"end":15,"surface":"三老","kind":"person","person_id":"ksm_7il_w8n","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m024-0024","start":24,"end":26,"surface":"父老","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-126-huaji:m024-0041","start":41,"end":43,"surface":"其巫","kind":"person","person_id":"msq_cc5_was","sta