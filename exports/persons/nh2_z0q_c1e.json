rson_id":"msq_cc5_was","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m024-0295","start":295,"end":297,"surface":"三老","kind":"person","person_id":"ksm_7il_w8n","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m024-0309","start":309,"end":311,"surface":"廷掾","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-126-huaji:m024-0340","start":340,"end":343,"surface":"西門豹","kind":"person","person_id":"nh2_z0q_c1e","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m024-0359","start":359,"end":360,"surface":"豹","kind":"person","person_id":"nh2_z0q_c1e","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m024-0363","start":363,"end":365,"surface":"廷掾","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-126-huaji:m024-0369","start":369,"end":371,"surface":"河伯","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-126-huaji:m024-0401","start":401,"end":403,"surface":"河伯","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-126-huaji","book_id":"b-shiji-126","work_id":"w-shiji","source_id":"s-shiji126-huaji"},{"id":"c-shiji-126-huaji:p025","text":"西門豹即發民鑿十二渠，引河水灌民田，田皆溉。當其時，民治渠少煩苦，不欲也。豹曰：「民可以樂成，不可與慮始。今父老子弟雖患苦我，然百歲後期令父老子孫思我言。」至今皆得水利，民人以給足富。十二渠經絕馳道，到漢之立，而長吏以為十二渠橋絕馳道，相比近，不可。欲合渠水，且至馳道合三渠為一橋。鄴民人父老不肯聽長吏，以為西門君所為也，賢君之法式不可更也。長吏終聽置之。故西門豹為鄴令，名聞天下，澤流後世，無絕已時，幾可謂非賢大夫哉！","annotation_status":"in_progress","text_layer":"witness_appended_chu_note","mentions":[{"id":"c-shiji-126-huaji:m025-0000","start":0,"end":3,"surface":"西門豹","kind":"person","person_id":"nh2_z0q_c1e","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m025-0037","start":37,"end":38,"surface":"豹","kind":"person","person_id":"nh2_z0q_c1e","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m025-0054","start":54,"end":58,"surface":"父老子弟","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-126-huaji:m025-0069","start":69,"end":73,"surface":"父老子孫","kind":"unre