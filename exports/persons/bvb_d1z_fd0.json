shiji-010-wendi:m036-0164","start":164,"end":166,"surface":"尉佗","kind":"person","person_id":"bvb_d1z_fd0","status":"contextual_provisional","paragraph_id":"c-shiji-010-wendi:p036","chapter_id":"c-shiji-010-wendi"},{"id":"c-shiji-010-wendi:m036-0174","start":174,"end":175,"surface":"佗","kind":"person","person_id":"bvb_d1z_fd0","status":"contextual_provisional","paragraph_id":"c-shiji-010-wendi:p036","chapter_id":"c-shiji-010-wendi"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji010-035","person_id":"bvb_d1z_fd0","surfaces":["佗","尉佗"],"scope":"same_chapter","chapter_ids":["c-shiji-010-wendi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-010-wendi:p036","quote":"孝文帝從代來，即位二十三年，宮室苑囿狗馬服御無所增益，有不便，輒弛以利民。嘗欲作露臺，召匠計之，直百金。上曰：「百金中民十家之產，吾奉先帝宮室，常恐羞之，何以臺為！」上常衣綈衣，所幸慎夫人，令衣不得曳地，幃帳不得文繡，以示敦樸，為天下先。治霸陵皆以瓦器，不得以金銀銅錫為飾，不治墳，欲為省，毋煩民。南越王尉佗自立為武帝，然上召貴尉佗兄弟，以德報之，佗遂去帝稱臣。與匈奴和親，匈奴背約入盜，然令邊備守，不發兵深入，惡煩苦百姓。吳王詐病不朝，就賜幾杖。群臣如袁盎等稱說雖切，常假借用之。群臣如張武等受賂遺金錢，覺，上乃發御府金錢賜之，以愧其心，弗下吏。專務以德化民，是以海內殷富，興於禮義。"}],"rationale":"所列文帝朝分封、任官、軍事與接任敘事中暫定同指；跨卷依相接事件，短名不作全庫替換，同名候選及未名者仍待異源覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-010-wendi:p036","text":"孝文帝從代來，即位二十三年，宮室苑囿狗馬服御無所增益，有不便，輒弛以利民。嘗欲作露臺，召匠計之，直百金。上曰：「百金中民十家之產，吾奉先帝宮室，常恐羞之，何以臺為！」上常衣綈衣，所幸慎夫人，令衣不得曳地，幃帳不得文繡，以示敦樸，為天下先。治霸陵皆以瓦器，不得以金銀銅錫為飾，不治墳，欲為省，毋煩民。南越王尉佗自立為武帝，然上召貴尉佗兄弟，以德報之，佗遂去帝稱臣。與匈奴和親，匈奴背約入盜，然令邊備守，不發兵深入，惡煩苦百姓。吳王詐病不朝，就賜幾杖。群臣如袁盎等稱說雖切，常假借用之。群臣如張武等受賂遺金錢，覺，上乃發御府金錢賜之，以愧其心，弗下吏。專務以德化民，是以海內殷富，興於禮義。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-010-wendi:m036-0000","start":0,"end":3,"surface":"孝文帝","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m036-0052","start":52,"end":53,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"