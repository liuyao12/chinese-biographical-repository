{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"yg3_wq7_tpj","canonical_person_id":"yg3_wq7_tpj","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["yg3_wq7_tpj"],"persons":[{"id":"yg3_wq7_tpj","label":"武王（貨殖列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"武王","mention_ids":["c-shiji-129-huozhi:m013-0049"]}],"evidence":[{"mention_id":"c-shiji-129-huozhi:m013-0049","chapter_id":"c-shiji-129-huozhi","paragraph_id":"c-shiji-129-huozhi:p013","quote":"武王"}]}],"source_mention_summary":[{"source_id":"s-shiji129-huozhi","work_id":"w-shiji","book_id":"b-shiji-129","chapter_id":"c-shiji-129-huozhi","mention_count":1,"mention_ids":["c-shiji-129-huozhi:m013-0049"],"paragraph_ids":["c-shiji-129-huozhi:p013"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji129-huozhi"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-129-huozhi:m013-0049","start":49,"end":51,"surface":"武王","kind":"person","person_id":"yg3_wq7_tpj","status":"contextual_provisional","paragraph_id":"c-shiji-129-huozhi:p013","chapter_id":"c-shiji-129-huozhi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-129-huozhi:p013","text":"關中自汧、雍以東至河、華，膏壤沃野千里，自虞夏之貢以為上田，而公劉適邠，大王、王季在岐，文王作豐，武王治鎬，故其民猶有先王之遺風，好稼穡，殖五穀，地重，重為邪。及秦文、（孝）［德］、繆居雍，隙隴蜀之貨物而多賈。獻（孝）公徙櫟邑，櫟邑北卻戎翟，東通三晉，亦多大賈。（武）［孝］、昭治咸陽，因以漢都，長安諸陵，四方輻湊并至而會，地小人眾，故其民益玩巧而事末也。南則巴蜀。巴蜀亦沃野，地饒炧、薑、丹沙、石、銅、鐵、竹、木之器。南御滇僰，僰僮。西近邛笮，笮馬、旄牛。然四塞，棧道千里，無所不通，唯褒斜綰轂其口，以所多易所鮮。天水、隴西、北地、上郡與關中同俗，然西有羌中之利，北有戎翟之畜，畜牧為天下饒。然地亦窮險，唯京師要其道。故關中之地，於天下三分之一，而人眾不過什三；然量其富，什居其六。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-129-huozhi:m013-0031","start":31,"end":33,"surface":"公劉","kind":"person","person_id":"ys7_623_44n","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m013-0036","start":36,"end":38,"surface":"大王","kind":"person","person_id":"jgg_b2r_m0g","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m013-0039","start":39,"end":41,"surface":"王季","kind":"person","person_id":"gnd_f77_icz","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m013-0044","start":44,"end":46,"surface":"文王","kind":"person","person_id":"row_ke9_k5j","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m013-0049","start":49,"end":51,"surface":"武王","kind":"person","person_id":"yg3_wq7_tpj","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m013-0081","start":81,"end":83,"surface":"秦文","kind":"person","person_id":"eaa_jij_k8j","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m013-0084","start":84,"end":90,"surface":"（孝）［德］","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-129-huozhi:m013-0091","start":91,"end":92,"surface":"繆","kind":"person","person_id":"s1i_t3j_lne","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m013-0105","start":105,"end":110,"surface":"獻（孝）公","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-129-huozhi:m013-0131","start":131,"end":137,"surface":"（武）［孝］","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-129-huozhi:m013-0138","start":138,"end":139,"surface":"昭","kind":"person","person_id":"uhy_p4j_wc6","status":"contextual_provisional"}],"chapter_id":"c-shiji-129-huozhi","book_id":"b-shiji-129","work_id":"w-shiji","