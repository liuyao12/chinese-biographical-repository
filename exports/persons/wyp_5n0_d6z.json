ue},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-song047-chumao-he","subject_person_id":"wyp_5n0_d6z","object_person_id":"npr_j6b_2hn","predicate":"mother","qualifiers":{"source_term":"文處茂母何","lineage":"maternal"},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-047","chapter_id":"c-songshu-047-liujingxuan","source_id":"s-songshu-047-liujingxuan-ws2190557","paragraph_id":"c-songshu-047-liujingxuan:p012","quote":"假敬宣節，監征蜀諸軍事，郡如故。既入峽，分遣振武將軍、巴東太守溫祚以二千人揚聲外水，自率益州刺史鮑陋、輔國將軍文處茂、龍驤將軍時延祖由墊江而進。敬宣率先士卒，轉戰而前，達遂寧郡之黃虎，去成都五百里。偽輔國將軍譙道福等悉眾距險，相持六十餘日，大小十餘戰，賊固守不敢出。敬宣不得進，食糧盡，軍中多疾疫，死者太半，引軍還。譙縱送毛璩一門諸喪，其妻女、文處茂母何，并諸士人喪柩，浮之中流，敬宣皆拯接致歸。為有司所奏，免官，削封三分之一。","subject_person_mention_id":"c-songshu-047-liujingxuan:p012:m0055","object_person_mention_id":"c-songshu-047-liujingxuan:p012:m0176"}],"status":"source_attested","interpretation_note":"母僅著姓何；與毛氏妻女並列。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-099-huanxuan:p035:m0289","start":289,"end":292,"surface":"文處茂","kind":"person","person_id":"wyp_5n0_d6z","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。","paragraph_id":"c-jinshu-099-huanxuan:p035","chapter_id":"c-jinshu-099-huanxuan"},{"id":"c-jinshu-099-huanxuan:p035:m0308","start":308,"end":310,"surface":"處茂","kind":"person","person_id":"wyp_5n0_d6z","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。","paragraph_id":"c-jinshu-099-huanxuan:p035","chapter_id":"c-jinshu-099-huanxuan"},{"id":"c-songshu-047-liujingxuan:p012:m0055","start":55,"end":58,"surface":"文處茂","kind":"person","person_id":"wyp_5n0_d6z","status":"contextual_provisional","paragraph_id":"c-songshu-047-liujingxuan:p012","chapter_id":"c-songshu-047-liujingxuan"},{"id":"c-song