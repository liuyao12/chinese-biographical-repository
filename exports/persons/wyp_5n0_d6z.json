將軍孔隆及穆之等追真蘭走奔相城又追躡至炎林溝斬劉該虜衆見殺及赴水死略盡高祖鎮京口進道憐號龍驤將軍又領堂邑太守戍石頭明年加使持節監征蜀諸軍事率冠軍將軍劉敬宣等伐譙縱而文處茂温祚據險不得進故不果行以義勳封新興縣五等侯四年代諸葛長民為并州刺史義昌太守將軍內史如故猶戍石頭時鮮卑侵逼自彭城以南民皆保聚山陽淮陰諸戍並","status":"editorial_provisional","component_source_binding":{"kind":"fixed_wyd_song051_yixin_name_component","role":"dl_wenchumao","name_form":"source_full_name","raw_sha256":"8d2ae0cd97228ef9a252a07a5886f2f0c3d445e305f311e484b38a97f462fcad"},"human_reviewed":false,"model":null,"work_id":"w-songshu","book_id":"b-songshu-051","source_id":"s-songshu-051-wyd1739-zongshi"}],"mentions":[{"id":"c-jinshu-099-huanxuan:p035:m0289","start":289,"end":292,"surface":"文處茂","kind":"person","person_id":"wyp_5n0_d6z","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。","paragraph_id":"c-jinshu-099-huanxuan:p035","chapter_id":"c-jinshu-099-huanxuan"},{"id":"c-jinshu-099-huanxuan:p035:m0308","start":308,"end":310,"surface":"處茂","kind":"person","person_id":"wyp_5n0_d6z","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。","paragraph_id":"c-jinshu-099-huanxuan:p035","chapter_id":"c-jinshu-099-huanxuan"},{"id":"c-songshu-051-wyd1739-zongshi:p002:m0139","start":139,"end":142,"surface":"文處茂","kind":"person","person_id":"wyp_5n0_d6z","status":"contextual_provisional","paragraph_id":"c-songshu-051-wyd1739-zongshi:p002","chapter_id":"c-songshu-051-wyd1739-zongshi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-song051-daolian-wenchumao","person_id":"wyp_5n0_d6z","surfaces":["文處茂"],"scope":"cross_chapter","chapter_ids":["c-songshu-051-wyd1739-zongshi","c-jinshu-099-huanxuan"],"status":"contextual_provisional","confidence_level":"high","identification_basis":{"kind":"source_context","target_mention_ids":["c-songshu-051-wyd1739-zongshi:p002:m0139"]},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-051","source_id":"s-songshu-051-wyd1739-zongshi","chapter_id":"c-songshu-051-wyd1739-zongshi","paragraph_id":"c-songshu-051-wyd1739-zongshi:p002","quote":"蘭寇徐州攻相縣執鉅鹿太守賀申進圍寧朔將軍羊穆之於彭城穆之告急道憐率衆救之軍次陵柵斬全進至彭城真蘭退走道憐率寧孟龍驤將軍孔隆及穆之等追真蘭走奔相城又追躡至炎林溝斬劉該虜衆見殺及赴水死略盡高祖鎮京口進道憐號龍驤將軍又領堂邑太守戍石頭明年加使持節監征蜀諸軍事率冠軍將軍劉敬宣等伐譙縱而文處茂温祚據險不得進故不果行以義勳封新興縣五等侯四年代諸葛長民為并州刺史義昌太守將軍內史如故猶戍石頭時鮮卑侵逼自彭城以南民皆保聚山陽淮陰諸戍並"},{"work_id":"w-jinshu","book_id":"b-jinshu-099","source_id":"s-jinshu-099-huanxuan-ws2644703","chapter_id":"c-jinshu-099-huanxuan","paragraph_id":"c-jinshu-099-huanxuan:p035","quote":"何無忌等攻桓謙於馬頭，桓蔚于龍洲，皆破之。義軍乘勝競進，振、該等距戰於靈溪，道規等敗績，死沒者千餘人。義軍退次尋陽，更繕舟甲。毛璩自領梁州，遣將攻漢中，殺桓希。江夏相張暢之、高平太守劉懷肅攻何澹之於西塞磯，破之。振遣桓蔚代王曠守襄陽。道規進討武昌，破偽太守王旻。魏詠之、劉籓破桓石綏于白茅。義軍發尋陽。桓亮自號江州刺史，侵豫章，江州刺史劉敬宣討走之。義軍進次夏口。偽鎮東將軍馮該等守夏口，揚武將軍孟山圖據魯城，輔國將軍桓山客守偃月壘。劉毅攻魯城，道規攻偃月壘，無忌與檀祗列艦中流，以防越逸。義軍騰赴，叫聲動山谷，自辰及午，二城俱潰，馮該散走，生擒山客。毅等平巴陵。毛璩遣涪陵太守文處茂東下，振遣桓放之為益州，屯夷陵，處茂距戰，放之敗走，還江陵。"}],"rationale":"晉099p035具名涪陵太守文處茂/毛璩蜀事，與本源阻征蜀相容；時序正證非同字。","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-099-huanxuan:p035","text":"何無忌等攻桓謙於馬頭，桓蔚于龍洲，皆破之。義軍乘勝競進，振、該等距戰於靈溪，道規等敗績，死沒者千餘人。義軍退次尋陽，更繕舟甲。毛璩自領梁州，遣將攻漢中，殺桓希。江夏相張暢之、高平太守劉懷肅攻何澹之於西塞磯，破之。振遣桓蔚代王曠守襄陽。道規進討武昌，破偽太守王旻。魏詠之、劉籓破桓石綏于白茅。義軍發尋陽。桓亮自號江州刺史，侵豫章，江州刺史劉敬宣討走之。義軍進次夏口。偽鎮東將軍馮該等守夏口，揚武將軍孟山圖據魯城，輔國將軍桓山客守偃月壘。劉毅攻魯城，道規攻偃月壘，無忌與檀祗列艦中流，以防越逸。義軍騰赴，叫聲動山谷，自辰及午，二城俱潰，馮該散走，生擒山客。毅等平巴陵。毛璩遣涪陵太守文處茂東下，振遣桓放之為益州，屯夷陵，處茂距戰，放之敗走，還江陵。","source_position":{"kind":"wikitext_codepoint_positions","raw_path":"sources/jinshu/wikisource-2644703-raw.wikitext","raw_start":9612,"raw_end":9936,"character_positions":[9614,9615,9616,9617,9618,9619,9620,9621,9622,9623,9624,9625,9626,9627,9628,9629,9630,9631,9632,9633,9634,9635,9636,9637,9638,9639,9640,9641,9642,9643,9644,9645,9646,9647,9648,9649,9650,9651,9652,9653,9654,9655,9656,9657,9658,9659,9660,9661,9662,9663,9664,9665,9666,9667,9668,9669,9670,9671,9672,9673,9674,9675,9676,9677,9678,9679,9680,9681,9682,9683,9684,9685,9686,9687,9688,9689,9690,9691,9692,9693,9694,9695,9696,9697,9698,9699,9700,9701,9702,9703,9704,9705,9706,970