_id":"c-shiji-114-dongyue"},{"id":"c-shiji-114-dongyue:m009-0033","start":33,"end":35,"surface":"吳陽","kind":"person","person_id":"bxw_vv0_1t3","status":"contextual_provisional","paragraph_id":"c-shiji-114-dongyue:p009","chapter_id":"c-shiji-114-dongyue"},{"id":"c-shiji-114-dongyue:m009-0147","start":147,"end":149,"surface":"吳陽","kind":"person","person_id":"bxw_vv0_1t3","status":"contextual_provisional","paragraph_id":"c-shiji-114-dongyue:p009","chapter_id":"c-shiji-114-dongyue"}],"relations":[],"title_holdings":[{"id":"th-shiji114-024","person_id":"bxw_vv0_1t3","title":"越衍侯","kind":"noble_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-114-dongyue","source_id":"s-shiji114-dongyue","paragraph_id":"c-shiji-114-dongyue:p009","quote":"故越衍侯吳陽前在漢，漢使歸諭餘善，餘善弗聽。及橫海將軍先至，越衍侯吳陽以其邑七百人反，攻越軍於漢陽。從建成侯敖，與其率，從繇王居股謀曰：「餘善首惡，劫守吾屬。今漢兵至，眾彊，計殺餘善，自歸諸將，儻幸得脫。」乃遂俱殺餘善，以其眾降橫海將軍，故封繇王居股為東成侯，萬戶；封建成侯敖為開陵侯；封越衍侯吳陽為北石侯；封橫海將軍說為案道侯；封橫海校尉福為繚嫈侯。福者，成陽共王子，故為海常侯，坐法失侯。舊從軍無功，以宗室故侯。諸將皆無成功，莫封。東越將多軍，漢兵至，棄其軍降，封為無錫侯。"}],"attestations":[{"id":"th-shiji114-024:a001","paragraph_id":"c-shiji-114-dongyue:p009","start":1,"end":4,"surface":"越衍侯","person_mention_id":"c-shiji-114-dongyue:m009-0004","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授受、文獻用稱與任期端點分存；日期限所屬敘事，未跨段套用。故侯與失侯保留原文事件，不以死亡自動終止所有爵位。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji114-029","person_id":"bxw_vv0_1t3","title":"北石侯","kind":"noble_rank","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-114-dongyue","source_id":"s-shiji114-dongyue","paragraph_id":"c-shiji-114-dongyue:p009","quote":"故越衍侯吳陽前在漢，漢使歸諭餘善，餘善弗聽。及橫海將軍先至，越衍侯吳陽以其邑七百人反，攻越軍於漢陽。從建成侯敖，與其率，從繇王居股謀曰：「餘善首惡，劫守吾屬。今漢兵至，眾彊，計殺餘善，自歸諸將，儻幸得脫。」乃遂俱殺餘善，以其眾降橫海將軍，故封繇王居股為東成侯，萬戶；封建成侯敖為開陵侯；封越衍侯吳陽為北石侯；封橫海將軍說為案道侯；封橫海校尉福為繚嫈侯。福者，成陽共王子，故為海常侯，坐法失侯。舊從軍無功，以宗室故侯。諸將皆無成功，莫封。東越將多軍，漢兵至，棄其軍降，封為無錫侯。"}]