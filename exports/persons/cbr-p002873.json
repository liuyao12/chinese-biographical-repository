002851","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m023-0157","start":157,"end":159,"surface":"靈公","kind":"person","person_id":"cbr-p002873","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m023-0160","start":160,"end":162,"surface":"夫人","kind":"person","person_id":"cbr-p002877","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m023-0167","start":167,"end":169,"surface":"雍渠","kind":"person","person_id":"cbr-p002898","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m023-0175","start":175,"end":177,"surface":"孔子","kind":"person","person_id":"cbr-p002851","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m023-0187","start":187,"end":189,"surface":"孔子","kind":"person","person_id":"cbr-p002851","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m023-0218","start":218,"end":221,"surface":"魯定公","kind":"person","person_id":"cbr-p002842","status":"contextual_provisional"}],"chapter_id":"c-shiji-047-kong","book_id":"b-shiji-047","work_id":"w-shiji","source_id":"s-shiji-047-kong"},{"id":"c-shiji-047-kong:p030","text":"衞靈公聞孔子來，喜，郊迎。問曰：「蒲可伐乎？」對曰：「可。」靈公曰：「吾大夫以為不可。今蒲，衞之所以待晉楚也，以衞伐之，無乃不可乎？」孔子曰：「其男子有死之志，婦人有保西河之志。吾所伐者不過四五人。」靈公曰：「善。」然不伐蒲。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-047-kong:m030-0000","start":0,"end":3,"surface":"衞靈公","kind":"person","person_id":"cbr-p002873","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m030-0004","start":4,"end":6,"surface":"孔子","kind":"person","person_id":"cbr-p002851","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m030-0030","start":30,"end":32,"surface":"靈公","kind":"person","person_id":"cbr-p002873","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m030-0036","start":36,"end":38,"surface":"大夫","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、神怪、對話、廟稱合稱或親屬指代待核，不補姓名、成員及闕代。"},{"id":"c-shiji-047-kong:m030-0067","start":67,"end":69,"surface":"孔子","kind":"person","person_id":"cbr-p002851","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m030-0095","start":95,"end":98,"surface":"四五人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、神怪、對話、廟稱合稱或親屬指代待核，不補姓名、成員及闕代。"},{"id":"c-shiji-047-kong:m030-0100","start":100,"end":102,"surface":"靈公","kind":"person","person_id":"cbr-p002873","status":"contextual_provisional"}],"chapter_id":"c-shiji-047-kong","book_id":"b-shiji-047","work_id":"w-shiji","source_id":"s-shiji-047-kong"},{"id":"c-shiji-047-kong:p031","text":"靈公老，怠於政，不用孔子。孔子喟然歎曰：「苟有用我者，朞月而已，三年有成。」孔子行。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-047-kong:m031-0000","start":0,"end":2,"surface":"靈公","kind":"person","person_id":"cbr-p002873","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m031-0010","start":10,"end":12,"surface":"孔子","kind":"person","person_id":"cbr-p002851","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m031-0013","start":13,"end":15,"surface":"孔子","kind":"person","person_id":"cbr-p002851","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m031-0038","start":38,"end":40,"surface":"孔子","kind":"person","person_id":"cbr-p002851","status":"contextual_provisional"}],"chapter_id":"c-shiji-047-kong","book_id":"b-shiji-047","work_id":"w-shiji","source_id":"s-shiji-047-kong"},{"id":"c-shiji-047-kong:p036","text":"他日，靈公問兵陳。孔子曰：「俎豆之事則嘗聞之，軍旅之事未之學也。」明日，與孔子語，見蜚鴈，仰視之，色不在孔子。孔子遂行，復如陳。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-047-kong:m036-0003","start":3,"end":5,"surface":"靈公","kind":"person","person_id":"cbr-p002873","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m036-0009","start":9,"end":11,"surface":"孔子","kind":"person","person_id":"cbr-p002851","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m036-0037","start":37,"end":39,"surface":"孔子","kind":"person","person_id":"cbr-p002851","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m036-0052","start":52,"end":54,"surface":"孔子","kind":"person","person_id":"cbr-p002851","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m036-0055","start":55,"end":57,"surface":"孔子","kind":"person","person_id":"cbr-p002851","status":"contextual_provisional"}],"chapter_id":"c-shiji-047-kong","book_id":"b-shiji-047","work_id":"w-shiji","source_id":"s-shiji-047-kong"},{"id":"c-shiji-047-kong:p037","text":"夏，衞靈公卒，立孫輒，是為衞出公。六月，趙鞅內太子蒯聵于戚。陽虎使太子絻，八人衰絰，偽自衞迎者，哭而入，遂居焉。冬，蔡遷于州來。是歲魯哀公三年，而孔子年六十矣。齊助衞圍戚，以衞太子蒯聵在故也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-047-kong:m037-0002","start":2,"end":5,"surface":"衞靈公","kind":"person","person_id":"cbr-p002873","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m037-0008","start":8,"end":10,"surface":"孫輒","kind":"person","person_id":"cbr-p002889","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m037-0013","start":13,"end":16,"surface":"衞出公","kind":"person","person_id":"cbr-p002889","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m037-0020","start":20,"end":22,"surface":"趙鞅","kind":"person","person_id":"cbr-p002904","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m037-0023","start":23,"end":27,"surface":"太子蒯聵","kind":"person","person_id":"cbr-p002890","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m037-0030","start":30,"end":32,"surface":"陽虎","kind":"person","person_id":"cbr-p002853","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m037-0033","start":33,"end":35,"surface":"太子","kind":"person","person_id":"cbr-p002890","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m037-0037","start":37,"end":39,"surface":"八人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、神怪、對話、廟稱合稱或親屬指代待核，不補姓名、成員及闕代。"},{"id":"c-shiji-047-kong:m037-0045","start":45,"end":47,"surface":"迎者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、神怪、對話、廟稱合稱或親屬指代待核，不補姓名、成員及闕代。"},{"id":"c-shi