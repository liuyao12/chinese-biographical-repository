time_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-083-luzou:m012-0227","start":227,"end":229,"surface":"墨翟","kind":"person","person_id":"06s_zyx_maw","status":"contextual_provisional","paragraph_id":"c-shiji-083-luzou:p012","chapter_id":"c-shiji-083-luzou"},{"id":"c-shiji-083-luzou:m019-0240","start":240,"end":242,"surface":"墨翟","kind":"person","person_id":"06s_zyx_maw","status":"contextual_provisional","paragraph_id":"c-shiji-083-luzou:p019","chapter_id":"c-shiji-083-luzou"},{"id":"c-shiji-083-luzou:m019-0247","start":247,"end":248,"surface":"墨","kind":"person","person_id":"06s_zyx_maw","status":"contextual_provisional","paragraph_id":"c-shiji-083-luzou:p019","chapter_id":"c-shiji-083-luzou"},{"id":"c-shiji-083-luzou:m025-0040","start":40,"end":42,"surface":"墨子","kind":"person","person_id":"06s_zyx_maw","status":"contextual_provisional","paragraph_id":"c-shiji-083-luzou:p025","chapter_id":"c-shiji-083-luzou"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji083-026","person_id":"06s_zyx_maw","scope":"same_chapter","chapter_ids":["c-shiji-083-luzou"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"依本段明示稱名與嵌套引古範圍暫定；未名者不以他篇或記憶直接補名。","surfaces":["墨","墨子","墨翟"],"evidence":[{"paragraph_id":"c-shiji-083-luzou:p012","quote":"且楚攻齊之南陽，魏攻平陸，而齊無南面之心，以為亡南陽之害小，不如得濟北之利大，故定計審處之。今秦人下兵，魏不敢東面；衡秦之勢成，楚國之形危；齊棄南陽，斷右壤，定濟北，計猶且為之也。且夫齊之必決於聊城，公勿再計。今楚魏交退於齊，而燕救不至。以全齊之兵，無天下之規，與聊城共據期年之敝，則臣見公之不能得也。且燕國大亂，君臣失計，上下迷惑，栗腹以十萬之眾五折於外，以萬乘之國被圍於趙，壤削主困，為天下僇笑。國敝而禍多，民無所歸心。今公又以敝聊之民距全齊之兵，是墨翟之守也。食人炊骨，士無反外之心，是孫臏之兵也。能見於天下。雖然，為公計者，不如全車甲以報於燕。車甲全而歸燕，燕王必喜；身全而歸於國，士民如見父母，交游攘臂而議於世，功業可明。上輔孤主以制群臣，下養百姓以資說士，矯國更俗，功名可立也。亡意亦捐燕棄世，東游於齊乎？裂地定封，富比乎陶、衛，世世稱孤，與齊久存，又一計也。此兩計者，顯名厚實也，願公詳計而審處一焉。"},{"paragraph_id":"c-shiji-083-luzou:p019","quote":"故女無美惡，入宮見妒；士無賢不肖，入朝見嫉。昔者司馬喜髕腳於宋，卒相中山；范睢摺脅折齒於魏，卒為應侯。此二人者，皆信必然之畫，捐朋黨之私，挾孤獨之位，故不能自免於嫉妒之人也。是以申徒狄自沈於河，徐衍負石入海。不容於世，義不茍取，比周於朝，以移主上之心。故百里奚乞食於路，繆公委之以政；甯戚飯牛車下，而桓公任之以國。此二人者，豈借宦於朝，假譽於左右，然後二主用之哉？感於心，合於行，親於膠漆，昆弟不能離，豈惑於眾口哉？故偏聽生姦，獨任成亂。昔者魯聽季孫之說而逐孔子，宋信子罕之計而囚墨翟。夫以孔、墨之辯，不能自免於讒諛，而二國以危。何則？眾口鑠金，積毀銷骨也。是以秦用戎人由余而霸中國，齊用越人蒙而彊威、宣。此二國，豈拘於俗，牽於世，系阿偏之辭哉？公聽并觀，垂名當世。故意合則胡越為昆弟，由余、越人蒙是矣；不合，則骨肉出逐不收，朱、象、管、蔡是矣。今人主誠能用齊、秦之義，後宋、魯之聽，則五伯不足稱，三王易為也。"},{"paragraph_id":"c-shiji-083-luzou:p025","quote":"臣聞盛飾入朝者不以利汙義，砥厲名號者不以欲傷行，故縣名勝母而曾子不入，邑號朝歌而墨子回車。今欲使天下寥廓之士，攝於威重之權，主於位勢之貴，故回面汙行以事諂諛之人而求親近於左右，則士伏死堀穴巖巖之中耳，安肯有盡忠信而趨闕下者哉！"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-083-luzou:p012","text":"且楚攻齊之南陽，魏攻平陸，而齊無南面之心，以為亡南陽之害小，不如得濟北之利大，故定計審處之。今秦人下兵，魏不敢東面；衡秦之勢成，楚國之形危；齊棄南陽，斷右壤，定濟北，計猶且為之也。且夫齊之必決於聊城，公勿再計。今楚魏交退於齊，而燕救不至。以全齊之兵，無天下之規，與聊城共據期年之敝，則臣見公之不能得也。且燕國大亂，君臣失計，上下迷惑，栗腹以十萬之眾五折於外，以萬乘之國被圍於趙，壤削主困，為天下僇笑。國敝而禍多，民無所歸心。今公又以敝聊之民距全齊之兵，是墨翟之守也。食人炊骨，士無反外之心，是孫臏之兵也。能見於天下。雖然，為公計者，不如全車甲以報於燕。車甲全而歸燕，燕王必喜；身全而歸於國，士民如見父母，交游攘臂而議於世，功業可明。上輔孤主以制群臣，下養百姓以資說士，矯國更俗，功名可立也。亡意亦捐燕棄世，東游於齊乎？裂地定封，富比乎陶、衛，世世稱孤，與齊久存，又一計也。此兩計者，顯名厚實也，願公詳計而審處一焉。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-083-luzou:m012-0100","start":100,"end":101,"surface":"公","kind":"person","person_id":"6i8_efe_yzr","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m012-0144","start":144,"end":145,"surface":"公","kind":"person","person_id":"6i8_efe_yzr","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m012-0167","start":167,"end":169,"surface":"栗腹","kind":"person","person_id":"2rk_my8_sbg","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m012-0213","start":213,"end":214,"surface":"公","kind":"person","person_id":"6i8_efe_yzr","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m012-0227","start":227,"end":229,"surface":"墨翟","kind":"person","person_id":"06s_zyx_maw","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m012-0246","start":246,"end":248,"surface":"孫臏","kind":"person","person_id":"n82_e6r_7z2","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m012-0262","start":262,"end":263,"surfa