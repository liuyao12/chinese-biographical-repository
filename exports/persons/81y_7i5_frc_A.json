3-xiaolun-sons-brothers","quote":"堅"},{"mention_id":"c-nanshi-053-xiaolun-sons-brothers:p001:m0053","paragraph_id":"c-nanshi-053-xiaolun-sons-brothers:p001","chapter_id":"c-nanshi-053-xiaolun-sons-brothers","quote":"堅"},{"mention_id":"c-nanshi-053-xiaolun-sons-brothers:p001:m0055","paragraph_id":"c-nanshi-053-xiaolun-sons-brothers:p001","chapter_id":"c-nanshi-053-xiaolun-sons-brothers","quote":"堅"},{"mention_id":"c-nanshi-053-xiaolun-sons-brothers:p001:m0083","paragraph_id":"c-nanshi-053-xiaolun-sons-brothers:p001","chapter_id":"c-nanshi-053-xiaolun-sons-brothers","quote":"堅"},{"mention_id":"c-nanshi-053-xiaolun-sons-brothers:p001:m0129","paragraph_id":"c-nanshi-053-xiaolun-sons-brothers:p001","chapter_id":"c-nanshi-053-xiaolun-sons-brothers","quote":"堅"},{"mention_id":"c-nanshi-053-xiaolun-sons-brothers:p001:m0141","paragraph_id":"c-nanshi-053-xiaolun-sons-brothers:p001","chapter_id":"c-nanshi-053-xiaolun-sons-brothers","quote":"堅"},{"mention_id":"c-nanshi-053-xiaolun-sons-brothers:p001:m0170","paragraph_id":"c-nanshi-053-xiaolun-sons-brothers:p001","chapter_id":"c-nanshi-053-xiaolun-sons-brothers","quote":"堅"}],"review":"ai_provisional","identity_note":"蕭堅（字長白，邵陵王綸長子），見本組原文及身份互校。","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"81y_7i5_frc","source_assertion_id":null,"parent_connection":{"type":"shared_father_through_siblings","sibling_assertion_ids":["a-liang029-que-jian"],"sibling_father_assertion_id":"a-liang029-que-father-nan"},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-053","chapter_id":"c-nanshi-053-xiaolun-sons-brothers","source_id":"s-nanshi-053-xiaolun-sons-brothers-ws1518868","paragraph_id":"c-nanshi-053-xiaolun-sons-brothers:p001","quote":"長子堅字長白，大同元年，以例封汝南侯。亦善草隸，性頗庸短，嘗與所親書，題云：「嗣王」。其人得書大駭，執以諫堅，堅曰：「前言戲耳。」人曰：「不願以此為戲耳。」侯景圍城，堅屯太陽門，終日蒱飲，不撫軍政。吏士有功，未嘗申理，疫癘所加，亦不存恤，士咸憤怨。太清三年，堅書佐董勳華、白曇朗等以堅私室醞釀，亟有烹宰，不相沾及，忿恨，夜遣賊登樓，城遂陷，堅遇害。弟確。","subject_person_mention_id":"c-nanshi-053-xiaolun-sons-brothers:p001:m0175","object_person_mention_id":"c-nanshi-053-xiaolun-sons-brothers:p001:m0002","source_assertion_id":"a-liang029-que-jian","source_term":"弟確"},{"work_id":"w-nanshi","book_id":"b-nanshi-053","chapter_id":"c-nanshi-053-xiaolun-sons-brothers","source_id":"s-nanshi-053-xiaolun-sons-brothers-ws1518868","paragraph_id":"c-nanshi-053-xiaolun-sons-brothers:p002","quote":"綸聞之，逼確使入。確猶不肯，綸流涕謂曰：「汝欲反邪！」時台使周石珍在坐，確曰：「侯景雖云欲去，而不解長圍，以意而推，其事可見。今召我入，未見益也。」石珍曰：「敕旨如此，侯豈得辭。」確執意猶堅，綸大怒，謂趙伯超曰：「譙州，卿為我斬之。當齎首赴闕。」伯超揮刃眄曰：「我識君耳，刀豈識君。」","subject_person_mention_id":"c-nanshi-053-xiaolun-sons-brothers:p002:m0005","object_person_mention_id":"c-nanshi-053-xiaolun-sons-brothers:p002:m0000","source_assertion_id":"a-liang029-que-father-nan","source_term":"綸聞之，逼確使入"}],"status":"contextual_provisional","human_reviewed":false,"interpretation_note":"依南史具名的堅弟確與確父蕭綸，梁書堅段首明長子。"}},{"id":"81y_7i5_frc_B","label":"蕭確（字仲正，永安侯）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"確","mention_ids":["c-liangshu-029-xiaojian-xiaoque:p002:m0001","c-liangshu-029-xiaojian-xiaoque:p002:m0063","c-liangshu-029-xiaojian-xiaoque:p003:m0005","c-liangshu-029-xiaojian-xiaoque:p003:m0019","c-liangshu-029-xiaojian-xiaoque:p003:m0064","c-liangshu-029-xiaojian-xiaoque:p003:m0076","c-liangshu-029-xiaojian-xiaoque:p003:m0083","c-liangshu-029-xiaojian-xiaoque:p003:m0101","c-liangshu-029-xiaojian-xiaoque:p003:m0124","c-liangshu-029-xiaojian-xiaoque:p003:m0128","c-liangshu-029-xiaojian-xiaoque:p003:m0156","c-liangshu-029-xiaojian-xiaoque:p003:m0214","c-liangshu-029-xiaojian-xiaoque:p003:m0253","c-liangshu-029-xiaojian-xiaoque:p003:m0268","c-liangshu-029-xiaojian-xiaoque:p003:m0291","c-liangshu-029-xiaojian-xiaoque:p003:m0374","c-liangshu-029-xiaojian-xiaoque:p004:m0000","c-liangshu-029-xiaojian-xiaoque:p004:m0036","c-liangshu-029-xiaojian-xiaoque:p004:m0063","c-liangshu-029-xiaojian-xiaoque:p004:m0065","c-liangshu-029-xiaojian-xiaoque:p004:m0083","c-nanshi-053-xiaolun-sons-brothers:p001:m0175","c-nanshi-053-xiaolun-sons-brothers:p002:m0005