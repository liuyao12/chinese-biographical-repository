e-ws1538079"},{"id":"c-liangshu-029-xiaojian-xiaoque:received_sentence1-81","kind":"received_sentence","person_id":"81y_7i5_frc_A","source_quote":"太清三年三月，堅書佐董勛華、白曇朗等以繩引賊登樓，城遂陷，堅遇害。","reading":"太清三年三月，書佐董勛華、白曇朗引侯景兵入，堅被害。","note":"太清三年三月，書佐董勛華、白曇朗引侯景兵入，堅被害。","paragraph_id":"c-liangshu-029-xiaojian-xiaoque:p001","start_codepoint":81,"end_codepoint":114,"human_reviewed":false,"chapter_id":"c-liangshu-029-xiaojian-xiaoque","source_id":"s-liangshu-029-xiaojian-xiaoque-ws1538079"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-liang029-que-jian","subject_person_id":"81y_7i5_frc_B","object_person_id":"81y_7i5_frc_A","predicate":"brother","qualifiers":{"source_term":"弟確"},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-053","chapter_id":"c-nanshi-053-xiaolun-sons-brothers","source_id":"s-nanshi-053-xiaolun-sons-brothers-ws1518868","paragraph_id":"c-nanshi-053-xiaolun-sons-brothers:p001","quote":"長子堅字長白，大同元年，以例封汝南侯。亦善草隸，性頗庸短，嘗與所親書，題云：「嗣王」。其人得書大駭，執以諫堅，堅曰：「前言戲耳。」人曰：「不願以此為戲耳。」侯景圍城，堅屯太陽門，終日蒱飲，不撫軍政。吏士有功，未嘗申理，疫癘所加，亦不存恤，士咸憤怨。太清三年，堅書佐董勳華、白曇朗等以堅私室醞釀，亟有烹宰，不相沾及，忿恨，夜遣賊登樓，城遂陷，堅遇害。弟確。","subject_person_mention_id":"c-nanshi-053-xiaolun-sons-brothers:p001:m0175","object_person_mention_id":"c-nanshi-053-xiaolun-sons-brothers:p001:m0002"}],"status":"source_attested","interpretation_note":"南史堅傳末接「弟確」，梁書同一段次。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[{"connection":"father","generation_distance":1,"parent_person_id":"81y_7i5_frc","source_assertion_id":null,"parent_connection":{"type":"shared_father_through_siblings","sibling_assertion_ids":["a-liang029-que-jian"],"sibling_father_assertion_id":"a-liang029-que-father-nan"},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-053","chapter_id":"c-nanshi-053-xiaolun-sons-brothers","source_id":"s-nanshi-053-xiaolun-sons-brothers-ws1518868","paragraph_id":"c-nanshi-053-xiaolun-sons-brothers:p001","quote":"長子堅字長白，大同元年，以例封汝南侯。亦善草隸，性頗庸短，嘗與所親書，題云：「嗣王」。其人得書大駭，執以諫堅，堅曰：「前言戲耳。」人曰：「不願以此為戲耳。」侯景圍城，堅屯太陽門，終日蒱飲，不撫軍政。吏士有功，未嘗申理，疫癘所加，亦不存恤，士咸憤怨。太清三年，堅書佐董勳華、白曇朗等以堅私室醞釀，亟有烹宰，不相沾及，忿恨，夜遣賊登樓，城遂陷，堅遇害。弟確。","subject_person_mention_id":"c-nanshi-053-xiaolun-sons-brothers:p001:m0175","object_person_mention_id":"c-nanshi-053-xiaolun-sons-brothers:p001:m0002","source_assertion_id":"a-liang029-que-jian","source_term":"弟確"},{"work_id":"w-nanshi","book_id":"b-nanshi-053","chapter_id":"c-nanshi-053-xiaolun-sons-brothers","source_id":"s-nanshi-053-xiaolun-sons-brothers-ws1518868","paragraph_id":"c-nanshi-053-xiaolun-sons-brothers:p002","quote":"綸聞之，逼確使入。確猶不肯，綸流涕謂曰：「汝欲反邪！」時台使周石珍在坐，確曰：「侯景雖云欲去，而不解長圍，以意而推，其事可見。今召我入，未見益也。」石珍曰：「敕旨如此，侯豈得辭。」確執意猶堅，綸大怒，謂趙伯超曰：「譙州，卿為我斬之。當齎首赴闕。」伯超揮刃眄曰：「我識君耳，刀豈識君。」","subject_person_mention_id":"c-nanshi-053-xiaolun-sons-brothers:p002:m0005","object_person_mention_id":"c-nanshi-053-xiaolun-sons-brothers:p002:m0000","source_assertion_id":"a-liang029-que-father-nan","source_term":"綸聞之，逼確使入"}],"status":"contextual_provisional","human_reviewed":false,"interpretation_note":"依南史具名的堅弟確與確父蕭綸，梁書堅段首明長子。","person_id":"81y_7i5_frc_A"}],"life_events":[{"id":"le-liang029-jian-death","person_id":"81y_7i5_frc_A","event_type":"death","source_term":"遇害","source_anchor":{"paragraph_id":"c-liangshu-029-xiaojian-xiaoque:p001","start":111,"end":113,"surface":"遇害"},"date_expression":"太清三年三月","evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-029","chapter_id":"c-liangshu-029-xiaojian-xiaoque","source_id":"s-liangshu-029-xiaojian-xiaoque-ws1538079","paragraph_id":"c-liangshu-029-xiaojian-xiaoque:p001","quote":"長子堅，字長白。大同元年，以例封汝南侯，邑五百戶。亦善草隸，性頗庸短。侯景圍城，堅屯太陽門，終日蒲飲，不撫軍政。吏士有功，未嘗申理，疫癘所加，亦不存卹，士咸憤怨。太清三年三月，堅書佐董勛華、白曇朗等以繩引賊登樓，城遂陷，堅遇害。","person_mention_id":"c-liangshu-029-xiaojian-xiaoque:p001:m0002"}],"status":"source_attested","interpretation_note":"按同段人物與次第核所屬卒事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":fa