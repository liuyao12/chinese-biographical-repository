ojian-xiaoque-ws1538079","paragraph_id":"c-liangshu-029-xiaojian-xiaoque:p003","quote":"君","kind":"person_reference","mention_id":"c-liangshu-029-xiaojian-xiaoque:p003:r0259"},{"work_id":"w-liangshu","book_id":"b-liangshu-029","chapter_id":"c-liangshu-029-xiaojian-xiaoque","source_id":"s-liangshu-029-xiaojian-xiaoque-ws1538079","paragraph_id":"c-liangshu-029-xiaojian-xiaoque:p003","quote":"君","kind":"person_reference","mention_id":"c-liangshu-029-xiaojian-xiaoque:p003:r0265"},{"work_id":"w-liangshu","book_id":"b-liangshu-029","chapter_id":"c-liangshu-029-xiaojian-xiaoque","source_id":"s-liangshu-029-xiaojian-xiaoque-ws1538079","paragraph_id":"c-liangshu-029-xiaojian-xiaoque:p003","quote":"臣","kind":"person_reference","mention_id":"c-liangshu-029-xiaojian-xiaoque:p003:r0327"}],"review":"ai_provisional","identity_note":"蕭確（字仲正，永安侯），見本組原文及身份互校。","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"81y_7i5_frc","source_assertion_id":"a-liang029-que-father-main","evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-029","chapter_id":"c-liangshu-029-xiaojian-xiaoque","source_id":"s-liangshu-029-xiaojian-xiaoque-ws1538079","paragraph_id":"c-liangshu-029-xiaojian-xiaoque:p003","quote":"鐘山之役，確苦戰，所向披靡，羣虜憚之。確每臨陣對敵，意氣詳贍。帶甲據鞍，自朝及夕，馳驟往反，不以爲勞，諸將服其壯勇。及侯景乞盟，確在外，慮爲後患，啓求召確入城。詔乃召確爲南中郎將、廣州刺史，增封二千戶。確知此盟多貳，城必淪沒，因欲南奔。攜王聞之，逼確使入，確猶不肯。攜王流涕謂曰：「汝欲反邪！」時臺使周石珍在坐，確謂石珍曰：「侯景雖云欲去，而不解長圍，以意而推，其事可見。今召我入，未見其益也。」石珍曰：「敕旨如此，侯豈得辭？」確執意猶堅，攜王大怒，謂趙伯超曰：「譙州，卿爲我斬之，當賚首赴闕。」伯超揮刃眄確曰：「我識君耳，刀豈識君？」確於是流涕而出，遂入城。及景背盟復圍城，城陷，確排闥入，啓高祖曰：「城已陷矣。」高祖曰：「猶可一戰不？」對曰：「不可。臣向者親格戰，勢不能禁，自縋下城，僅得至此。」高祖歎曰：「自我得之，自我失之，亦復何恨。」乃使確爲慰勞文。","subject_person_mention_id":"c-liangshu-029-xiaojian-xiaoque:p003:m0005","object_person_mention_id":"c-liangshu-029-xiaojian-xiaoque:p003:m0118","source_term":"攜王聞之"}],"status":"contextual_provisional","human_reviewed":false,"interpretation_note":"確的父親為前段本傳邵陵攜王綸，對語為父逼子入城。"}}],"source_mention_summary":[{"source_id":"s-nanshi-053-xiaolun-sons-brothers-ws1518868","work_id":"w-nanshi","book