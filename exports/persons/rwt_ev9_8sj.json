hu-063-liju:p002:m0034","surface":"袁孚","start":34,"end":36,"person_id":"rwt_ev9_8sj","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-063-liju:p002","chapter_id":"c-jinshu-063-liju"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-063-liju:p002","text":"矩勇毅多權略，志在立功，東海王越以為汝陰太守。永嘉初，使矩與汝南太守袁孚率眾修洛陽千金堨，以利運漕。及洛陽不守，太尉荀籓奔陽城，衛將軍華薈奔成皋。時大饑，賊帥侯都等每略人而食之，籓、薈部曲多為所啖。矩討都等滅之，乃營護籓、薈，各為立屋宇，輸穀以給之。及籓承制，建行臺，假矩滎陽太守。矩招懷離散，遠近多附之。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":29,"last_line":29,"raw_start":1779,"raw_end":1934,"raw_character_offsets":[1781,1782,1783,1784,1785,1786,1787,1788,1789,1790,1791,1792,1793,1794,1795,1796,1797,1798,1799,1800,1801,1802,1803,1804,1805,1806,1807,1808,1809,1810,1811,1812,1813,1814,1815,1816,1817,1818,1819,1820,1821,1822,1823,1824,1825,1826,1827,1828,1829,1830,1831,1832,1833,1834,1835,1836,1837,1838,1839,1840,1841,1842,1843,1844,1845,1846,1847,1848,1849,1850,1851,1852,1853,1854,1855,1856,1857,1858,1859,1860,1861,1862,1863,1864,1865,1866,1867,1868,1869,1870,1871,1872,1873,1874,1875,1876,1877,1878,1879,1880,1881,1882,1883,1884,1885,1886,1887,1888,1889,1890,1891,1892,1893,1894,1895,1896,1897,1898,1899,1900,1901,1902,1903,1904,1905,1906,1907,1908,1909,1910,1911,1912,1913,1914,1915,1916,1917,1918,1919,1920,1921,1922,1923,1924,1925,1926,1927,1928,1929,1930,1931,1932,1933],"revision_id":2025242},"mentions":[{"id":"c-jinshu-063-liju:p002:m0000","surface":"矩","start":0,"end":1,"person_id":"tqt_mih_3ao","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-063-liju:p002:m0012","surface":"東海王越","start":12,"end":16,"person_id":"9o2_vhv_r7y","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-063-liju:p002:m0028","surface":"矩","start":28,"end":29,"person_id":"tqt_mi