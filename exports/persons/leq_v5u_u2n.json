{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"leq_v5u_u2n","canonical_person_id":"leq_v5u_u2n","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["leq_v5u_u2n"],"persons":[{"id":"leq_v5u_u2n","label":"周文仁（佞幸列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"周文仁","mention_ids":["c-shiji-125-ningxing:m002-0451"]},{"surface":"仁","mention_ids":["c-shiji-125-ningxing:m002-0455"]}],"evidence":[{"mention_id":"c-shiji-125-ningxing:m002-0451","chapter_id":"c-shiji-125-ningxing","paragraph_id":"c-shiji-125-ningxing:p002","quote":"周文仁"},{"mention_id":"c-shiji-125-ningxing:m002-0455","chapter_id":"c-shiji-125-ningxing","paragraph_id":"c-shiji-125-ningxing:p002","quote":"仁"}]}],"source_mention_summary":[{"source_id":"s-shiji125-ningxing","work_id":"w-shiji","book_id":"b-shiji-125","chapter_id":"c-shiji-125-ningxing","mention_count":2,"mention_ids":["c-shiji-125-ningxing:m002-0451","c-shiji-125-ningxing:m002-0455"],"paragraph_ids":["c-shiji-125-ningxing:p002"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji125-ningxing"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-125-ningxing:m002-0451","start":451,"end":454,"surface":"周文仁","kind":"person","person_id":"leq_v5u_u2n","status":"contextual_provisional","paragraph_id":"c-shiji-125-ningxing:p002","chapter_id":"c-shiji-125-ningxing"},{"id":"c-shiji-125-ningxing:m002-0455","start":455,"end":456,"surface":"仁","kind":"person","person_id":"leq_v5u_u2n","status":"contextual_provisional","paragraph_id":"c-shiji-125-ningxing:p002","chapter_id":"c-shiji-125-ningxing"}],"relations":[],"title_holdings":[{"id":"th-shiji125-005","person_id":"leq_v5u_u2n","title":"郎中令","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-125-ningxing","source_id":"s-shiji125-ningxing","paragraph_id":"c-shiji-125-ningxing:p002","quote":"鄧通，蜀郡南安人也，以濯舩為黃頭郎。孝文帝夢欲上天，不能，有一黃頭郎從後推之上天，顧見其衣裻帶后穿。覺而之漸臺，以夢中陰目求推者郎，即見鄧通，其衣后穿，夢中所見也。召問其名姓，姓鄧氏，名通，文帝說焉，尊幸之日異。通亦願謹，不好外交，雖賜洗沐，不欲出。於是文帝賞賜通巨萬以十數，官至上大夫。文帝時時如鄧通家遊戲。然鄧通無他能，不能有所薦士，獨自謹其身以媚上而已。上使善相者相通，曰「當貧餓死」。文帝曰：「能富通者在我也。何謂貧乎？」於是賜鄧通蜀嚴道銅山，得自鑄錢，「鄧氏錢」布天下。其富如此。文帝嘗病癰，鄧通常為帝唶吮之。文帝不樂，從容問通曰：「天下誰最愛我者乎？」通曰：「宜莫如太子。」太子入問病，文帝使唶癰，唶癰而色難之。已而聞鄧通常為帝唶吮之，心慚，由此怨通矣。及文帝崩，景帝立，鄧通免，家居。居無何，人有告鄧通盜出徼外鑄錢。下吏驗問，頗有之，遂竟案，盡沒入鄧通家，尚負責數巨萬。長公主賜鄧通，吏輒隨沒入之，一簪不得著身。於是長公主乃令假衣食。竟不得名一錢，寄死人家。孝景帝時，中無寵臣，然獨郎中令周文仁，仁寵最過庸，乃不甚篤。今天子中寵臣，士人則韓王孫嫣，宦者則李延年。"}],"attestations":[{"id":"th-shiji125-005:a001","paragraph_id":"c-shiji-125-ningxing:p002","start":448,"end":451,"surface":"郎中令","person_mention_id":"c-shiji-125-ningxing:m002-0451","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"明示官爵或稱號用語按原字存錄；官至不作初任年，用稱不作授予，未知起訖保持未知。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-125-ningxing:p002","text":"鄧通，蜀郡南安人也，以濯舩為黃頭郎。孝文帝夢欲上天，不能，有一黃頭郎從後推之上天，顧見其衣裻帶后穿。覺而之漸臺，以夢中陰目求推者郎，即見鄧通，其衣后穿，夢中所見也。召問其名姓，姓鄧氏，名通，文帝說焉，尊幸之日異。通亦願謹，不好外交，雖賜洗沐，不欲出。於是文帝賞賜通巨萬以十數，官至上大夫。文帝時時如鄧通家遊戲。然鄧通無他能，不能有所薦士，獨自謹其身以媚上而已。上使善相者相通，曰「當貧餓死」。文帝曰：「能富通者在我也。何謂貧乎？」於是賜鄧通蜀嚴道銅山，得自鑄錢，「鄧氏錢」布天下。其富如此。文帝嘗病癰，鄧通常為帝唶吮之。文帝不樂，從容問通曰：「天下誰最愛我者乎？」通曰：「宜莫如太子。」太子入問病，文帝使唶癰，唶癰而色難之。已而聞鄧通常為帝唶吮之，心慚，由此怨通矣。及文帝崩，景帝立，鄧通免，家居。居無何，人有告鄧通盜出徼外鑄錢。下吏驗問，頗有之，遂竟案，盡沒入鄧通家，尚負責數巨萬。長公主賜鄧通，吏輒隨沒入之，一簪不得著身。於是長公主乃令假衣食。竟不得名一錢，寄死人家。孝景帝時，中無寵臣，然獨郎中令周文仁，仁寵最過庸，乃不甚篤。今天子中寵臣