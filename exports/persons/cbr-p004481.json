-fancai:m003-0116","start":116,"end":118,"surface":"先生","kind":"person","person_id":"9mw_pdn_ati","status":"contextual_provisional"}],"chapter_id":"c-shiji-079-fancai","book_id":"b-shiji-079","work_id":"w-shiji","source_id":"s-shiji-079-fancai"},{"id":"c-shiji-079-fancai:p004","text":"王稽辭魏去，過載范睢入秦。至湖，望見車騎從西來。范睢曰：「彼來者為誰？」王稽曰：「秦相穰侯東行縣邑。」范睢曰：「吾聞穰侯專秦權，惡內諸侯客，此恐辱我，我寧且匿車中。」有頃，穰侯果至，勞王稽，因立車而語曰：「關東有何變？」曰：「無有。」又謂王稽曰：「謁君得無與諸侯客子俱來乎？無益，徒亂人國耳。」王稽曰：「不敢。」即別去。范睢曰：「吾聞穰侯智士也，其見事遲，鄉者疑車中有人，忘索之。」於是范睢下車走，曰：「此必悔之。」行十餘里，果使騎還索車中，無客，乃已。王稽遂與范睢入咸陽。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-079-fancai:m004-0000","start":0,"end":2,"surface":"王稽","kind":"person","person_id":"rmu_iss_4in","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m004-0008","start":8,"end":10,"surface":"范睢","kind":"person","person_id":"9mw_pdn_ati","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m004-0019","start":19,"end":20,"surface":"騎","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名角色或泛論保存，文武合稱不補個人錨點；韓盧犬喻不當人物，王者泛論不套秦昭王。"},{"id":"c-shiji-079-fancai:m004-0024","start":24,"end":26,"surface":"范睢","kind":"person","person_id":"9mw_pdn_ati","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m004-0036","start":36,"end":38,"surface":"王稽","kind":"person","person_id":"rmu_iss_4in","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m004-0041","start":41,"end":45,"surface":"秦相穰侯","kind":"person","person_id":"xqf_p8o_1g5","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m004-0051","start":51,"end":53,"surface":"范睢","kind":"person","person_id":"9mw_pdn_ati","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m004-0058","start":58,"end":60,"surface":"穰侯","kind":"person","person_id":"xqf_p8o_1g5","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m004-0066","start":66,"end":69,"surface":"諸侯客","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名角色或泛論保存，文武合稱不補個人錨點；韓盧犬喻不當人物，王者泛論不套秦昭王。"},{"id":"c-shiji-079-fancai:m004-0086","start":86,"end":88,"surface":"穰侯","kind":"person","person_id":"xqf_p8o_1g5","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m004-0092","start":92,"end":94,"surface":"王稽","kind":"person","person_id":"rmu_iss_4in","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m004-0119","start":119,"end":121,"surface":"王稽","kind":"person","person_id":"rmu_iss_4in","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m004-0124","start":124,"end":126,"surface":"謁君","kind":"person","person_id":"rmu_iss_4in","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m004-0129","start":129,"end":132,"surface":"諸侯客","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名角色或泛論保存，文武合稱不補個人錨點；韓盧犬喻不當人物，王者泛論不套秦昭王。"},{"id":"c-shiji-079-fancai:m004-0147","start":147,"end":149,"surface":"王稽","kind":"person","person_id":"rmu_iss_4in","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m004-0160","start":160,"end":162,"surface":"范睢","kind":"person","person_id":"9mw_pdn_ati","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m004-0167","start":167,"end":169,"surface":"穰侯","kind":"person","person_id":"xqf_p8o_1g5","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m004-0193","start":193,"end":195,"surface":"范睢","kind":"person","person_id":"9mw_pdn_ati","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m004-0215","start":215,"end":216,"surface":"騎","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名角色或泛論保存，文武合稱不補個人錨點；韓盧犬喻不當人物，王者泛論不套秦昭王。"},{"id":"c-shiji-079-fancai:m004-0227","start":227,"end":229,"surface":"王稽","kind":"person","person_id":"rmu_iss_4in","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m004-0231","start":231,"end":233,"surface":"范睢","kind":"person","person_id":"9mw_pdn_ati","status":"contextual_provisional"}],"chapter_id":"c-shiji-079-fancai","book_id":"b-shiji-079","work_id":"w-shiji","source_id":"s-shiji-079-fancai"},{"id":"c-shiji-079-fancai:p005","text":"已報使，因言曰：「魏有張祿先生，天下辯士也。曰『秦王之國危於累卵，得臣則安。然不可以書傳也』。臣故載來。」秦王弗信，使舍食草具。待命歲餘。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-079-fancai:m005-0011","start":11,"end":15,"surface":"張祿先生","kind":"person","person_id":"9mw_pdn_ati","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m005-0024","start":24,"end":26,"surface":"秦王","kind":"person","person_id":"cn8_id5_95v","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m005-0034","start":34,"end":35,"surface":"臣","kind":"person","person_id":"9mw_pdn_ati","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m005-0047","start":47,"end":48,"surface":"臣","kind":"person","person_id":"rmu_iss_4in","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m005-0053","start":53,"end":55,"surface":"秦王","kind":"person","person_id":"cn8_id5_95v","status":"contextual_provisional"}],"chapter_id":"c-shiji-079-fancai","book_id":"b-shiji-079","work_id":"w-shiji","source_id":"s-shiji-079-fancai"},{"id":"c-shiji-079-fancai:p011","text":"於是秦昭王大說，乃謝王稽，使以傳車召范睢。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-079-fancai:m011-0002","start":2,"end":5,"surface":"秦昭王","kind":"person","person_id":"cn8_id5_95v","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m011-0010","start":10,"end":12,"surface":"王稽","kind":"person","person_id":"rmu_iss_4in","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m011-0018","start":18,"end":20,"surface":"范睢","kind":"person","person_id":"9mw_pdn_ati","status":"contextual_provisional"}],"chapter_id":"c-shiji-079-fancai","book_id":"b-shiji-079","work_id":"w-shiji","source_id":"s-shiji-079-fancai"},{"id":"c-shiji-079-fancai:p022","text":"范睢既相，王稽謂范睢曰：「事有不可知者三，有不柰何者亦三。宮車一日晏駕，是事之不可知者一也。君卒然捐館舍，是事之不可知者二也。使臣卒然填溝壑，是事之不可知者三也。宮車一日晏駕，君雖恨於臣，無可柰何。君卒然捐館舍，君雖恨於臣，亦無可柰何。使臣卒然填溝壑，君雖恨於臣，亦無可柰何。」范睢不懌，乃入言於王曰：「非王稽之忠，莫能內臣於函谷關；非大王之賢聖，莫能貴臣。今臣官至於相，爵在列侯，王稽之官尚止於謁者，非其內臣之意也。」昭王召王稽，拜為河東守，三歲不上計。又任鄭安平，昭王以為將軍。范睢於是散家財物，盡以報所嘗困戹者。一飯之德必償，睚眥之怨必報。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-079-fancai:m022-0000","start":0,"end":2,"surface":"范睢","kind":"person","person_id":"9mw_pdn_ati","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m022-0005","start":5,"end":7,"surface":"王稽","kind":"person","person_id":"rmu_iss_4in","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m022-0008","start":8,"end":10,"surface":"范睢","kind":"person","person_id":"9mw_pdn_ati","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m022-0029","start":29,"end":31,"surface":"宮車","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名角色或擬托身分保留，不補姓名；主人翁是范睢微行語境未核角色，先人不補父親。"},{"id":"c-shiji-079-fancai:m022-0046","start":46,"end":47,"surface":"君","kind":"person","person_id":"9mw_pdn_ati","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m022-0064","start":64,"end":65,"surface":"臣","kind":"person","person_id":"rmu_iss_4in","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m022-0081","start":81,"end":83,"surface":"宮車","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名角色或擬托身分保留，不補姓名；主人翁是范睢微行語境未核角色，先人不補父親。"},{"id":"c-shiji-079-fancai:m022-0088","start":88,"end":89,"surface":"君","kind":"person","person_id":"9mw_pdn_ati","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m022-0092","start":92,"end":93,"surface":"臣","kind":"person","person_id":"rmu_iss_4in","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m022-0099","start":99,"end":100,"surface":"君","kind":"person","person_id":"9mw_pdn_ati","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m022-0106","start":106,"end":107,"surface":"君","kind":"person","person_id":"9mw_pdn_ati","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m022-0110","start":110,"end":111,"surface":"臣","kind":"person","perso