{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p005003","identity_policy":"contextual_provisional","person_ids":["cbr-p005003"],"persons":[{"id":"cbr-p005003","label":"趙養卒未名（張耳陳餘列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"廝養卒","mention_ids":["c-shiji-089-zhanger:m013-0077"]},{"surface":"趙養卒","mention_ids":["c-shiji-089-zhanger:m013-0206"]},{"surface":"養卒","mention_ids":["c-shiji-089-zhanger:m013-0394"]}],"evidence":[{"mention_id":"c-shiji-089-zhanger:m013-0077","chapter_id":"c-shiji-089-zhanger","paragraph_id":"c-shiji-089-zhanger:p013","quote":"廝養卒"},{"mention_id":"c-shiji-089-zhanger:m013-0206","chapter_id":"c-shiji-089-zhanger","paragraph_id":"c-shiji-089-zhanger:p013","quote":"趙養卒"},{"mention_id":"c-shiji-089-zhanger:m013-0394","chapter_id":"c-shiji-089-zhanger","paragraph_id":"c-shiji-089-zhanger:p013","quote":"養卒"}]}],"source_mention_summary":[{"source_id":"s-shiji-089-zhanger","work_id":"w-shiji","book_id":"b-shiji-089","chapter_id":"c-shiji-089-zhanger","mention_count":3,"mention_ids":["c-shiji-089-zhanger:m013-0077","c-shiji-089-zhanger:m013-0206","c-shiji-089-zhanger:m013-0394"],"paragraph_ids":["c-shiji-089-zhanger:p013"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-089-zhanger"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-089-zhanger:m013-0077","start":77,"end":80,"surface":"廝養卒","kind":"person","person_id":"cbr-p005003","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p013","chapter_id":"c-shiji-089-zhanger"},{"id":"c-shiji-089-zhanger:m013-0206","start":206,"end":209,"surface":"趙養卒","kind":"person","person_id":"cbr-p005003","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p013","chapter_id":"c-shiji-089-zhanger"},{"id":"c-shiji-089-zhanger:m013-0394","start":394,"end":396,"surface":"養卒","kind":"person","person_id":"cbr-p005003","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p013","chapter_id":"c-shiji-089-zhanger"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji089-026","person_id":"cbr-p005003","scope":"same_chapter","chapter_ids":["c-shiji-089-zhanger"],"status":"contextual_provisional","rationale":"按明示姓名及局部語境承接；武臣與趙歇、張敖的趙王用稱限各段，張黡張黶按同行事件暫接但原字分存。未名者不補姓名。","reviewer":"Codex（AI 代理）","surfaces":["廝養卒","趙養卒","養卒"],"evidence":[{"paragraph_id":"c-shiji-089-zhanger:p013","quote":"韓廣至燕，燕人因立廣爲燕王。趙王乃與張耳、陳餘北略地燕界。趙王閒出，爲燕軍所得。燕將囚之，欲與分趙地半，乃歸王。使者往，燕輒殺之以求地。張耳、陳餘患之。有廝養卒謝其舍中曰：「吾爲公説燕，與趙王載歸。」舍中皆笑曰：「使者往十餘輩，輒死，若何以能得王？」乃走燕壁。燕將見之，問燕將曰：「知臣何欲？」燕將曰：「若欲得趙王耳。」曰：「君知張耳、陳餘何如人也？」燕將曰：「賢人也。」曰：「知其志何欲？」曰：「欲得其王耳。」趙養卒乃笑曰：「君未知此兩人所欲也。夫武臣、張耳、陳餘杖馬箠下趙數十城，此亦各欲南面而王，豈欲爲卿相終己邪？夫臣與主豈可同日而道哉，顧其勢初定，未敢參分而王，且以少長先立武臣爲王，以持趙心。今趙地已服，此兩人亦欲分趙而王，時未可耳。今君乃囚趙王。此兩人名爲求趙王，實欲燕殺之，此兩人分趙自立。夫以一趙尚易燕，況以兩賢王左提右挈，而責殺王之罪，滅燕易矣。」燕將以爲然，乃歸趙王，養卒爲御而歸。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-089-zhanger:p013","text":"韓廣至燕，燕人因立廣爲燕王。趙王乃與張耳、陳餘北略地燕界。趙王閒出，爲燕軍所得。燕將囚之，欲與分趙地半，乃歸王。使者往，燕輒殺之以求地。張耳、陳餘患之。有廝養卒謝其舍中曰：「吾爲公説燕，與趙王載歸。」舍中皆笑曰：「使者往十餘輩，輒死，若何以能得王？」乃走燕壁。燕將見之，問燕將曰：「知臣何欲？」燕將曰：「若欲得趙王耳。」曰：「君知張耳、陳餘何如人也？」燕將曰：「賢人也。」曰：「知其志何欲？」曰：「欲得其王耳。」趙養卒乃笑曰：「君未知此兩人所欲也。夫武臣、張耳、陳餘杖馬箠下趙數十城，此亦各欲南面而王，豈欲爲卿相終己邪？夫臣與主豈可同日而道哉，顧其勢初定，未敢參分而王，且以少長先立武臣爲王，以持趙心。今趙地已服，此兩人亦欲分趙而王，時未可耳。今君乃囚趙王。此兩人名爲求趙王，實欲燕殺之，此兩人分趙自立。夫以一趙尚易燕，況以兩賢王左提右挈，而責殺王之罪，滅燕易矣。」燕將以爲然，乃歸趙王，養卒爲御而歸。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-089-zhanger:m013-0000","start":0,"end":2,"surface":"韓廣","kind":"person","person_id":"cbr-p005010","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m013-0009","start":9,"end":10,"surface":"廣","kind":"person","person_id":"cbr-p005010","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m013-0014","start":14,"end":16,"surface":"