{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"vlp_yy3_ufh","canonical_person_id":"vlp_yy3_ufh","id_aliases":["cbr-p005298"],"identity_policy":"contextual_provisional","person_ids":["vlp_yy3_ufh"],"persons":[{"id":"vlp_yy3_ufh","label":"平（泗水監）（樊酈滕灌列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"泗水監平","mention_ids":["c-shiji-095-fankuang:m017-0057"]}],"evidence":[{"mention_id":"c-shiji-095-fankuang:m017-0057","chapter_id":"c-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p017","quote":"泗水監平"}],"id_aliases":["cbr-p005298"]}],"source_mention_summary":[{"source_id":"s-shiji-095-fankuang","work_id":"w-shiji","book_id":"b-shiji-095","chapter_id":"c-shiji-095-fankuang","mention_count":1,"mention_ids":["c-shiji-095-fankuang:m017-0057"],"paragraph_ids":["c-shiji-095-fankuang:p017"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-095-fankuang"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-095-fankuang:m017-0057","start":57,"end":61,"surface":"泗水監平","kind":"person","person_id":"vlp_yy3_ufh","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p017","chapter_id":"c-shiji-095-fankuang"}],"relations":[],"title_holdings":[{"id":"th-shiji095-070","person_id":"vlp_yy3_ufh","title":"泗水監","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-095-fankuang","source_id":"s-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p017","quote":"高祖之初與徒屬欲攻沛也，嬰時以縣令史為高祖使。上降沛一日，高祖為沛公，賜嬰爵七大夫，以為太僕。從攻胡陵，嬰與蕭何降泗水監平，平以胡陵降，賜嬰爵五大夫。從擊秦軍碭東，攻濟陽，下戶牖，破李由軍雍丘下，以兵車趣攻戰疾，賜爵執帛。常以太僕奉車從擊章邯軍東阿、濮陽下，以兵車趣攻戰疾，破之，賜爵執珪。復常奉車從擊趙賁軍開封，楊熊軍曲遇。嬰從捕虜六十八人，降卒八百五十人，得印一匱。因復常奉車從擊秦軍雒陽東，以兵車趣攻戰疾，賜爵封轉為滕公。因復奉車從攻南陽，戰於藍田、芷陽，以兵車趣攻戰疾，至霸上。項羽至，滅秦，立沛公為漢王。漢王賜嬰爵列侯，號昭平侯，復為太僕，從入蜀、漢。"}],"attestations":[{"id":"th-shiji095-070:a001","paragraph_id":"c-shiji-095-fankuang:p017","start":57,"end":60,"surface":"泗水監","person_mention_id":"c-shiji-095-fankuang:m017-0057","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"原文實授、敘事用稱及諡稱分存；未明示時任期起訖未知。爵號用字不擅自補足，單稱侯不自動展開爵邑名；死亡、被捕、罷兵不自動作所有官爵終點。欲拜李必駱甲為騎將未作實授，左右校尉據實際令授。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji095-048","person_id":"vlp_yy3_ufh","scope":"same_chapter","chapter_ids":["c-shiji-095-fankuang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["泗水監平"],"evidence":[{"paragraph_id":"c-shiji-095-fankuang:p017","quote":"高祖之初與徒屬欲攻沛也，嬰時以縣令史為高祖使。上降沛一日，高祖為沛公，賜嬰爵七大夫，以為太僕。從攻胡陵，嬰與蕭何降泗水監平，平以胡陵降，賜嬰爵五大夫。從擊秦軍碭東，攻濟陽，下戶牖，破李由軍雍丘下，以兵車趣攻戰疾，賜爵執帛。常以太僕奉車從擊章邯軍東阿、濮陽下，以兵車趣攻戰疾，破之，賜爵執珪。復常奉車從擊趙賁軍開封，楊熊軍曲遇。嬰從捕虜六十八人，降卒八百五十人，得印一匱。因復常奉車從擊秦軍雒陽東，以兵車趣攻戰疾，賜爵封轉為滕公。因復奉車從攻南陽，戰於藍田、芷陽，以兵車趣攻戰疾，至霸上。項羽至，滅秦，立沛公為漢王。漢王賜嬰爵列侯，號昭平侯，復為太僕，從入蜀、漢。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定異稱。酈寄字況據第14段；夏侯嬰的嬰限定第16至21段，灌嬰限定第22至33段，桓嬰另人。第6與20、28段楚王信和反韓王信分人；未詳名王侯不補名。同名跨篇同指另待逐項證據。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-095-fankuang:p017","text":"高祖之初與徒屬欲攻沛也，嬰時以縣令史為高祖使。上降沛一日，高祖為沛公，賜嬰爵七大夫，以為太僕。從攻胡陵，嬰與蕭何降泗水監平，平以胡陵降，賜嬰爵五大夫。從擊秦軍碭東，攻濟陽，下戶牖，破李由軍雍丘下，以兵車趣攻戰疾，賜爵執帛。常以太僕奉車從擊章邯軍東阿、濮陽下，以兵車趣攻戰疾，破之，賜爵執珪。復常奉車從擊趙賁軍開封，楊熊軍曲遇。嬰從捕虜六十八人，降卒八百五十人，得印一匱。因復常奉車從擊秦軍雒陽東，以兵車趣攻戰疾，賜爵封轉為滕公。因復奉車從攻南陽，戰於藍田、芷陽，以兵車趣攻戰疾，至霸上。項羽至，滅秦，立沛公為漢王。漢王賜嬰爵列侯，號昭平侯，復為太僕，從入蜀、漢。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m017-0