0236","start":236,"end":238,"surface":"單于","kind":"person","person_id":"wop_txs_2xf","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m012-0246","start":246,"end":248,"surface":"漢王","kind":"person","person_id":"388_xm1_emw","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m012-0252","start":252,"end":254,"surface":"單于","kind":"person","person_id":"wop_txs_2xf","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m012-0258","start":258,"end":260,"surface":"冒頓","kind":"person","person_id":"wop_txs_2xf","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m012-0261","start":261,"end":264,"surface":"韓王信","kind":"person","person_id":"knh_bst_pgv","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m012-0266","start":266,"end":268,"surface":"王黃","kind":"person","person_id":"0gq_xwo_hu8","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m012-0269","start":269,"end":271,"surface":"趙利","kind":"person","person_id":"rhb_v4p_ofs","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m012-0274","start":274,"end":275,"surface":"黃","kind":"person","person_id":"0gq_xwo_hu8","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m012-0276","start":276,"end":277,"surface":"利","kind":"person","person_id":"rhb_v4p_ofs","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m012-0291","start":291,"end":293,"surface":"閼氏","kind":"person","person_id":"32k_yr7_5kv","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m012-0305","start":305,"end":307,"surface":"高帝","kind":"person","person_id":"388_xm1_emw","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m012-0330","start":330,"end":332,"surface":"冒頓","kind":"person","person_id":"wop_txs_2xf","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m012-0346","start":346,"end":348,"surface":"劉敬","kind":"person","person_id":"bp1_owy_cdq","status":"contextual_provisional"}],"chapter_id":"c-shiji-110-xiongnu","book_id":"b-shiji-110","work_id":"w-shiji","source_id":"s-shiji110-xiongnu"},{"id":"c-shiji-110-xiongnu:p013","text":"是後韓王信爲匈奴將，及趙利、王黃等數倍約，侵盜代、雲中。居無幾何，陳豨反，又與韓信合謀擊代。漢使樊噲往擊之，復拔代、鴈門、雲中郡縣，不出塞。是時匈奴以漢將眾往降，故冒頓常往來侵盜代地。於是漢患之，高帝乃使劉敬奉宗室女公主爲單于閼氏，歳奉匈奴絮繒酒米食物各有數，約爲昆弟以和親，冒頓乃少止。後燕王盧綰反，率其黨數千人降匈奴，往來苦上谷以東。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-110-xiongnu:m013-0002","start":2,"end":5,"surface":"韓王信","kind":"person","person_id":"knh_bst_pgv","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m013-0011","start":11,"end":13,"surface":"趙利","kind":"person","person_id":"rhb_v4p_ofs","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m013-0014","start":14,"end":16,"surface":"王黃","kind":"person","person_id":"0gq_xwo_hu8","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m013-0033","start":33,"end":35,"surface":"陳豨","kind":"person","person_id":"o43_qz5_cr6","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m013-0039","start":39,"end":41,"surface":"韓信","kind":"person","person_id":"knh_bst_pgv","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m013-0048","start":48,"end":50,"surface":"樊噲","kind":"person","person_id":"u2y_dhn_kh3","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m013-0082","start":82,"end":84,"surface":"冒頓","kind":"person","person_id":"wop_txs_2xf","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m013-0098","start":98,"end":100,"surface":"高帝","kind":"person","person_id":"388_xm1_emw","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m013-0102","start":102,"end":104,"surface":"劉敬","kind":"person","person_id":"bp1_owy_cdq","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m013-0105","start":105,"end":110,"surface":"宗室女公主","kind":"person","person_id":"brk_sg8_oe9","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m013-0111","start":111,"end":113,"surface":"單于","kind":"person","person_id":"wop_txs_2xf","status":"contextual_provisio