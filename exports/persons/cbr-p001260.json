{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p001260","identity_policy":"contextual_provisional","person_ids":["cbr-p001260"],"persons":[{"id":"cbr-p001260","label":"簡如（鄋瞞記事）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"簡如","mention_ids":["c-shiji-033-lu:m055-0082"]}],"evidence":[{"mention_id":"c-shiji-033-lu:m055-0082","chapter_id":"c-shiji-033-lu","paragraph_id":"c-shiji-033-lu:p055","quote":"簡如"}]}],"source_mention_summary":[{"source_id":"s-shiji-033-lu","work_id":"w-shiji","book_id":"b-shiji-033","chapter_id":"c-shiji-033-lu","mention_count":1,"mention_ids":["c-shiji-033-lu:m055-0082"],"paragraph_ids":["c-shiji-033-lu:p055"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-033-lu"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-033-lu:m055-0082","start":82,"end":84,"surface":"簡如","kind":"person","person_id":"cbr-p001260","status":"contextual_provisional","paragraph_id":"c-shiji-033-lu:p055","chapter_id":"c-shiji-033-lu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji033-094","person_id":"cbr-p001260","surfaces":["簡如"],"scope":"same_chapter","chapter_ids":["c-shiji-033-lu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-033-lu:p055","quote":"初，宋武公之世，鄋瞞伐宋，司徒皇父帥師御之，以敗翟于長丘，獲長翟緣斯。晉之滅路，獲喬如弟棼如。齊惠公二年，鄋瞞伐齊，齊王子城父獲其弟榮如，埋其首於北門。衛人獲其季弟簡如。鄋瞞由是遂亡。"}],"rationale":"按懿公被弒至魯文公的敘事角色、同段明示子／弟與柯盟、齊襄公殺魯桓公、晉立惠公等具體事件暫定異稱；同字爵稱依國別分開。公子揮不與前篇公子翚、晉襄父不與晉襄公、宣伯不與叔孫宣伯自動合併。數位疑讀與親屬異說仍待核對。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-033-lu:p055","text":"初，宋武公之世，鄋瞞伐宋，司徒皇父帥師御之，以敗翟于長丘，獲長翟緣斯。晉之滅路，獲喬如弟棼如。齊惠公二年，鄋瞞伐齊，齊王子城父獲其弟榮如，埋其首於北門。衛人獲其季弟簡如。鄋瞞由是遂亡。","annotation_status":"named_mentions_first_pass","te