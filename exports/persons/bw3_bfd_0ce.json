{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"bw3_bfd_0ce","canonical_person_id":"bw3_bfd_0ce","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["bw3_bfd_0ce"],"persons":[{"id":"bw3_bfd_0ce","label":"楊璋","status":"active","historicity":"historical_tradition","aliases":[{"surface":"楊璋","mention_ids":["c-jinshu-063-liju:p004:m0335"]}],"evidence":[{"mention_id":"c-jinshu-063-liju:p004:m0335","paragraph_id":"c-jinshu-063-liju:p004","chapter_id":"c-jinshu-063-liju","quote":"楊璋"}],"review":"ai_provisional","identity_note":"楊璋，見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-jinshu-063-liju-ws2025242","work_id":"w-jinshu","book_id":"b-jinshu-063","chapter_id":"c-jinshu-063-liju","raw_mention_count":1,"mention_ids":["c-jinshu-063-liju:p004:m0335"],"paragraph_ids":["c-jinshu-063-liju:p004"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-063-liju:p004:m0335","mention_ids":["c-jinshu-063-liju:p004:m0335"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-063-liju-ws2025242"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-063-liju:p004:m0335","surface":"楊璋","start":335,"end":337,"person_id":"bw3_bfd_0ce","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-063-liju:p004","chapter_id":"c-jinshu-063-liju"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-063-liju:p004","text":"時劉琨所假河內太守郭默為劉元海所逼，乞歸於矩，矩將使其甥郭誦迎致之，而不敢進。會劉琨遣參軍張肇，率鮮卑範勝等五百餘騎往長安，屬默被圍，道路不通，將還依邵續，行至矩營，矩謂肇曰：「默是劉公所授，公家之事，知無不為。」屠各舊畏鮮卑，遂邀肇為聲援，肇許之。賊望見鮮卑，不戰而走。誦潛遣輕舟濟河，使勇士夜襲懷城，掩賊留營，又大破之。默遂率其屬歸於矩。後劉聰遣從弟暢步騎三萬討矩，屯于韓王故壘，相去七里，遣使招矩。時暢卒至，矩未暇為備，遣使奉牛酒詐降於暢，潛匿精勇，見其老弱。暢不以為虞，大饗渠帥，人皆醉飽。矩謀夜襲之，兵士以賊眾，皆有懼色。矩令郭誦禱鄭子產祠曰：「君昔相鄭，惡鳥不鳴。凶胡臭羯，何得過庭！」使巫揚言：「東裏有教，當遣神兵相助。」將士聞之，皆踴躍爭進。乃使誦及督護楊璋等選勇敢千人，夜掩暢營，獲鎧馬甚多，斬首數千級，暢僅以身免。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":33,"last_line":33,"raw_start":2126,"raw_end":2495,"raw_character_offsets":[2128,2129,2130,2131,2132,2133,2134,2135,2136,2137,2138,2139,2140,2141,2142,2143,2144,2145,2146,2147,2148,2149,2150,2151,2152,2153,2154,2155,2156,2157,2158,2159,2160,2161,2162,2163,2164,2165,2166,2167,2168,2169,2170,2171,2172,2173,2174,2175,2176,2177,2178,2179,2180,2181,2182,2183,2184,2185,2186,2187,2188,2189,2190,2191,2192,2193,2194,2195,2196,2197,2198,2199,2200,2201,2202,2203,2204,2205,2206,2207,2208,2209,2210,2211,2212,2213,2214,2215,2216,2217,2218,2219,2220,2221,2222,2223,2224,2225,2226,2227,2228,2229,2230,2231,2232,2233,2234,2235,2236,2237,2238,2239,2240,2241,2242,2243,2244,2245,2246,2247,2248,2249,2250,2251,2252,2253,2254,2255,2256,2257,2258,2259,2260,2261,2262,2263,2264,2265,2266,2267,2268,2269,2270,2271,2272,2273,2274,2275,2276,2277,2278,2279,2280,2281,2282,2283,2284,2285,2286,2287,2288,2289,2290,2291,2292,2293,2294,2295,2296,2297,2298,2299,2300,2301,2302,2303,2304,2305,2306,2307,2308,2309,2310,2311,2312,2313,2314,2315,2316,2317,2318,2319,2320,2321,23