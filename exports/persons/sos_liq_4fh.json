onflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-052-ruan-zhong:p008:m0006","start":6,"end":10,"surface":"東平王康","kind":"person","person_id":"sos_liq_4fh","status":"contextual_provisional","paragraph_id":"c-jinshu-052-ruan-zhong:p008","chapter_id":"c-jinshu-052-ruan-zhong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-052-ruan-zhong:p008","text":"時種與郤詵及東平王康俱居上第，即除尚書郎。然毀譽之徒，或言對者因緣假託，帝乃更延群士，庭以問之。詔曰：「前者對策各指答所問，未盡子大夫所欲言，故復延見，其具陳所懷。又比年連有水旱災眚，雖戰戰兢兢，未能究天人之理，當何修以應其變？人遇水旱饑饉者，何以救之？中間多事，未得寧靜，思以省息煩務，令百姓不失其所。若人有所患苦者，有宜損益，使公私兩濟者，委曲陳之。又政在得人，而知之至難，唯有因人視聽耳。若有文武隱逸之士，各舉所知，雖幽賤負俗，勿有所限。故虛心思聞事實，勿務華辭，莫有所諱也。」","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":49,"last_line":49,"raw_start":4281,"raw_end":4523,"raw_character_offsets":[4281,4282,4283,4284,4285,4286,4287,4288,4289,4290,4291,4292,4293,4294,4295,4296,4297,4298,4299,4300,4301,4302,4303,4304,4305,4306,4307,4308,4309,4310,4311,4312,4313,4314,4315,4316,4317,4318,4319,4320,4321,4322,4323,4324,4325,4326,4327,4328,4329,4330,4331,4332,4333,4334,4335,4336,4337,4338,4339,4340,4341,4342,4343,4344,4345,4346,4347,4348,4349,4350,4351,4352,4353,4354,4355,4356,4357,4358,4359,4360,4361,4362,4363,4364,4365,4366,4367,4368,4369,4370,4371,4372,4373,4374,4375,4376,4377,4378,4379,4380,4381,4382,4383,4384,4385,4386,4387,4388,4389,4390,4391,4392,4393,4394,4395,4396,4397,4398,4399,4400,4401,4402,4403,4404,4405,4406,4407,4408,4409,4410,4411,4412,4413,4414,4415,4416,4417,4418,4419,4420,4421,4422,4423,4424,4425,4426,4427,4428,4429,4430,4431,4432,4433,4434,4435,4436,4437,4438,4439,4440,4441,4442,4443,4444,4445,4446,4447,4448,4449,4450,4451,4452,4453,4454,4455,4456,4457,4458,4459,4460,4461,4462,4463,4464,4465,4466,4467,4468,4469,4470,4471,4472,4473,4474,4475,4