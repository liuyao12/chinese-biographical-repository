raph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-qi057-luhuan-father","subject_person_id":"qu3_uh2_995","object_person_id":"tze_8ng_ef5","predicate":"father","qualifiers":{"source_term":"盧紹之遣子奐"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-057","chapter_id":"c-nanqishu-057-northern-wei-complete","source_id":"s-nanqishu-057-northern-wei-complete-ws1999801","paragraph_id":"c-nanqishu-057-northern-wei-complete:p011","quote":"宏又遣偽南部尚書托跋等向司州，分兵出兖、青界，十萬眾圍朐山，戍主玄元度嬰城固守。青冀二州刺史盧紹之遣子奐領兵助之。城中無食，紹之出頓州南石頭亭，隔海運糧柴供給城內。虜圍斷海道，緣岸攻城，會潮水大至，虜渰溺，元度出兵奮擊，大破之。臺遣軍主崔靈建、楊法持、房靈民萬餘人從淮入海，船艦至夜各舉兩火，虜眾望見，謂是南軍大至，一時奔退。","subject_person_mention_id":"c-nanqishu-057-northern-wei-complete:p011:m0051","object_person_mention_id":"c-nanqishu-057-northern-wei-complete:p011:m0046"}],"status":"source_attested","interpretation_note":"奉父命領援軍。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-057-northern-wei-complete:p011:m0051","start":51,"end":52,"surface":"奐","kind":"person","person_id":"qu3_uh2_995","status":"contextual_provisional","paragraph_id":"c-nanqishu-057-northern-wei-complete:p011","chapter_id":"c-nanqishu-057-northern-wei-complete"}],"relations":[{"id":"a-qi057-luhuan-father","subject_person_id":"qu3_uh2_995","object_person_id":"tze_8ng_ef5","predicate":"father","qualifiers":{"source_term":"盧紹之遣子奐"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-057","chapter_id":"c-nanqishu-057-northern-wei-complete","source_id":"s-nanqishu-057-northern-wei-complete-ws1999801","paragraph_id":"c-nanqishu-057-northern-wei-complete:p011","quote":"宏又遣偽南部尚書托跋等向司州，分兵出兖、青界，十萬眾圍朐山，戍主玄元度嬰城固守。青冀二州刺史盧紹之遣