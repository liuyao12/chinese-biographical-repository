_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin063-guomo-wife-brother","subject_person_id":"893_fgb_17c","object_person_id":"q4z_63v_7u3","predicate":"sister","qualifiers":{"source_term":"默婦兄同郡陸嘉"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-063","chapter_id":"c-jinshu-063-guomo","source_id":"s-jinshu-063-guomo-ws2025242","paragraph_id":"c-jinshu-063-guomo:p001","quote":"郭默，河內懷人。少微賤，以壯勇事太守裴整，為督將。永嘉之亂，默率遺眾自為塢主，以漁舟抄東歸行旅，積年遂致巨富，流人依附者漸眾。撫循將士，甚得其歡心。默婦兄同郡陸嘉取官米數石餉妹，默以為違制，將殺嘉，嘉懼，奔石勒。默乃自射殺婦，以明無私。遣使謁劉琨，琨加默河內太守。劉元海遣從子曜討默，曜列三屯圍之，欲使餓死。默送妻子為質，並請糴焉，糴畢，設守。曜怒，沈默妻子于河而攻之。默遣弟芝求救于劉琨，琨知默狡猾，留之而緩其救。默更遣人告急。會芝出城浴馬，使強與俱歸。默乃遣芝質于石勒，勒以默多詐，封默書與劉曜。默使人伺得勒書，便突圍投李矩。後與矩並力距劉、石，事見矩傳。","subject_person_mention_id":"c-jinshu-063-guomo:p001:m0087","object_person_mention_id":"c-jinshu-063-guomo:p001:m0079"}],"status":"source_attested","interpretation_note":"夫妻稱婦；兄陸嘉，婦未名。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-063-guomo:p001:m0079","surface":"陸嘉","start":79,"end":81,"person_id":"q4z_63v_7u3","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-063-guomo:p001","chapter_id":"c-jinshu-063-guomo"}],"relations":[{"id":"a-jin063-guomo-wife-brother","subject_person_id":"893_fgb_17c","object_person_id":"q4z_63v_7u3","predicate":"sister","qualifiers":{"source_term":"默婦兄同郡陸嘉"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-063","chapter_id":"c-jinshu-063-guomo","source_id":"s-jinshu-063-guomo-ws2025242","pa