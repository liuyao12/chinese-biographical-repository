e_id":"s-liangshu-022-wangchong-ancheng-ws1513347","paragraph_id":"c-liangshu-022-wangchong-ancheng:p001","quote":"秀稱心受之，亦弗辭多也。昆弟之睦，時議歸之。故吏夏侯稟等表立墓碑，詔許焉。當世高才游王門者，東海王僧孺、吳郡陸倕、彭城劉孝綽、河東裴子野，各制其文，古未之有也。世子機嗣。","subject_person_mention_id":"c-liangshu-022-wangchong-ancheng:p001:m0082","object_person_mention_id":"c-liangshu-022-wangchong-ancheng:p001:m0000"}],"status":"source_attested","interpretation_note":"秀傳之末載立碑及世子機嗣。緊接本卷記機襲封安成郡王、為湘州刺史、薨于州。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-liangshu-022-wangchong-ancheng:p001:m0000","start":0,"end":1,"surface":"秀","kind":"person","person_id":"z8c_kq5_fri","status":"contextual_provisional","paragraph_id":"c-liangshu-022-wangchong-ancheng:p001","chapter_id":"c-liangshu-022-wangchong-ancheng"},{"id":"c-liangshu-030-peiziye:p002:m0165","start":165,"end":168,"surface":"安成王","kind":"person","person_id":"z8c_kq5_fri","status":"contextual_provisional","interpretation_note":"梁022安成康王秀明天監元封安成、三年右將軍，且傳末明裴子野為王門撰文；與梁030右軍安成王脈絡相符。右軍/右將軍字面差與年份不矯原字，不據此授子野實任年。","paragraph_id":"c-liangshu-030-peiziye:p002","chapter_id":"c-liangshu-030-peiziye"}],"relations":[{"id":"a-chen017-ji-father","subject_person_id":"z8c_kq5_fri_A","object_person_id":"z8c_kq5_fri","predicate":"father","qualifiers":{"source_term":"世子機嗣","lineage":"paternal"},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-022","chapter_id":"c-liangshu-022-wangchong-ancheng","source_id":"s-liangshu-022-wangchong-ancheng-ws1513347","paragraph_id":"c-liangshu-022-wangchong-ancheng:p001","quote":"秀稱心受之，亦弗辭多也。昆弟之睦，時議歸之。故吏夏侯稟等表立墓碑，詔許焉。當世高才游王門者，東海王僧孺、吳郡陸倕、彭城劉孝綽、河東裴子野，各制其文，古未之有也。世子機嗣。","subject_person_mention_id":"c-liangshu-022-wangchong-ancheng:p001:m0082","object_person_mention_id":"c-liangshu-022-wangchong-ancheng:p001:m0000"}],"status":"source_attested","interpretation_note":"秀傳之末載立碑及世子機嗣。緊接本卷記機襲封安成郡王、為湘州刺史、薨于州。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"title_holdings":[],"address_assertions":[],"person_references":[{"id":"c-liangshu-021-wangjun-wangcong:p003:r0044","surface":"安成王","start":44,"end":47,"person_id":"z8c_kq5_fri","referent_role":"third_person","paragraph_id":"c-liangshu-021-wangjun-wangcong:p003","quote":"天監初，還，除中書侍郎。高祖甚悅其風采，與陳郡謝覽同見賞擢。俄遷吏部，當官不稱職，轉征虜安成王長史，又爲太子中庶子、遊擊將軍。出爲宣城太守，爲政清和，吏民安之。視事三年，徵拜侍中，遷度支尚書。又以本官兼起部尚書，監起太極殿。事畢，出爲征遠將軍、平西長史、南郡太守。尋爲智武將軍、鎮西長史、蜀郡太守。還爲左民尚書，領步兵校尉。遷吏部尚書，處選甚得名譽。","note":"梁書卷二十二明書秀進號征虜將軍、封安成郡王。","chapter_id":"c-liangshu-021-wangjun-wangcong","book_id":"b-liangshu-021","work_id":"w-liangshu","source_id":"s-liangshu-021-wangjun-wangcong-ws1544250"},{"id":"c-liangshu-033-wangsengru:p012:r0007","surface":"安成王","start":7,"end":10,"person_id":"z8c_kq5_fri","referent_role":"third_person","paragraph_id":"c-liangshu-033-wangsengru:p012","quote":"久之，起爲安西安成王參軍，累遷鎮右始興王中記室，北中郎南康王諮議參軍，入直西省，知撰譜事。普通三年，卒，時年五十八。","note":"依原有文體、發言者、受話人、王府或本傳前後文。","chapter_id":"c-liangshu-033-wangsengru","book_id":"b-liangshu-033","work_id":"w-liangshu","source_id":"s-liangshu-033-wangsengru-ws1514481"},{"start":68,"end":71,"surface":"安成王","id":"c-liangshu-050-wangji:p002:r0068","paragraph_id":"c-liangshu-050-wangji:p002","person_id":"z8c_kq5_fri","referent_role":"third_person","quote":"籍七歲能屬文。及長，好學博涉，有才氣，樂安任昉見而稱之。嘗於沈約坐賦得《詠燭》，甚爲約賞。齊末，爲冠軍行參軍，累遷外兵、記室。天監初，除安成王主簿、尚書三公郎、廷尉正。歷餘姚、錢塘令，並以放免。久之，除輕車湘東王諮議參軍，隨府會稽。郡境有雲門、天柱山，籍嘗遊之，或累月不反。至若邪溪賦詩，其略云：「蟬噪林逾靜，鳥鳴山更幽。」當時以爲文外獨絕。還爲大司馬從事中郎，遷中散大夫，尤不得志，遂徒行市道，不擇交遊。湘東王爲荊州，引爲安西府諮議參軍，帶作塘令。不理縣事，日飲酒，人有訟者，鞭而遣之。少時，卒。文集行於世。","note":"本句按敘述視點回指秀。","chapter_id":"c-liangshu-050-wangji","book_id":"b-liangshu-050","work_id":"w-liangshu","source_id":"s-liangshu-050-wangji-ws1514482"},{"id":"c-liangshu-050-xiezheng-wyd:p002:r0044","start":44,"end":47,"surface":"安成王","person_id":"z8c_kq5_fri","paragraph_id":"c-liangshu-050-xiezheng-wyd:p002","quote":"安西安成王法曹","referent_role":"third_person","note":"梁宗室蕭秀，以安西將軍在荊、郢。","chapter_id":"c-liangshu-050-xiezheng-wyd","book_id":"b-liangshu-050","work_id":"w-liangshu","source_id":"s-liangshu-050-xiezheng-wyd1739"},{"id":"c-liangshu-050-xiezheng:p002:r0056","start":56,"end":59,"surface":"安成王","person_id":"z8c_kq5_fri","paragraph_id":"c-liangshu-050-xiezheng:p002","quote":"安西安成王法曹","referent_role":"third_person","note":"梁宗室蕭秀，以安西將軍在荊、郢。","chapter_id":"c-liangshu-050-xiezheng","book_id":"b-liangshu-050","work_id":"w-liangshu","source_id":"s-liangshu-050-xiezheng-ws1514482"},{"id":"c-nanshi-059-wangsengru:p005:r0166","surface":"安成王","start":166,"end":169,"person_id":"z8c_kq5_fri","referent_role":"third_person","paragraph_id":"c-nanshi-059-wangsengru:p005","quote":"時武帝制春景明志詩五百字，敕沈約以下辭人同作，帝以僧孺為工。曆少府卿，尚書吏部郎，參大選，請謁不行。出為仁威南康王長史、蘭陵太守，行府、州、國事。初，帝問僧孺妾媵之數，對曰：「臣室無傾視。」及在南徐州，友人以妾寓之，行還，妾遂懷孕。為王典簽湯道湣所糾，逮詣南司，坐免官，久之不調。友人廬江何炯猶為王府記室，僧孺乃與炯書以見其意。後為安成王參軍事，鎮右中記室參軍。","note":"從本段發言者、受話人或所記府主覆核。","chapter_id":"c-nanshi-059-wangsengru","book_id":"b-nanshi-059","work_id":"w-nanshi","source_id":"s-nanshi-059-wangsengru-ws1553912"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-liang030-ancheng","person_id":"z8c_kq5_fri","surfaces":["安成王"],"scope":"same_chapter","status":"contextual_provisional","confidence_level":"medium","identification_basis":{"kind":"source_context","target_mention_ids":["c-liangshu-030-peiziye:p002:m0165"]},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-030","source_id":"s-liang030-ws1508510","chapter_id":"c-liangshu-030-peiziye","paragraph_id":"c-liangshu-030-peiziye:p002","quote":"子野生而偏孤，爲祖母所養，年九歲，祖母亡，泣血哀慟，家人異之。少好學，善屬文。起家齊武陵王國左常侍，右軍江夏王參軍，遭父憂去職。居喪盡禮，每之墓所，哭泣處草爲之枯，有白兔馴擾其側。天監初，尚書僕射范雲嘉其行，將表奏之，會雲卒，不果。樂安任昉有盛名，爲後進所慕，遊其門者，昉必相薦達。子野於昉爲從中表，獨不至，昉亦恨焉。久之，除右軍安成王參軍，俄遷兼廷尉正。時三官通署獄牒，子野嘗不在，同僚輒署其名，奏有不允，子野從坐免職。或勸言諸有司，可得無咎。子野笑而答曰：「雖慚柳季之道，豈因訟以受服。」自此免黜久之，終無恨意。"}],"rationale":"梁022安成康王秀明天監元封安成、三年右將軍，且傳末明裴子野為王門撰文；與梁030右軍安成王脈絡相符。右軍/右將軍字面差與年份不矯原字，不據此授子野實任年。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null}],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-021-wangjun-wangcong:p003","text":"天監初，還，除中書侍郎。高祖甚悅其風采，與陳郡謝覽同見賞擢。俄遷吏部，當官不稱職，轉征虜安成王長史，又爲太子中庶子、遊擊將軍。出爲宣城太守，爲政清和，吏民安之。視事三年，徵拜侍中，遷度支尚書。又以本官兼起部尚書，監起太極殿。事畢，出爲征遠將軍、平西長史、南郡太守。尋爲智武將軍、鎮西長史、蜀郡太守。還爲左民尚書，領步兵校尉。遷吏部尚書，處選甚得名譽。","mentions":[{"id":"c-liangshu-021-wangjun-wangcong:p003:m0023","surface":"謝覽","start":23,"end":25,"person_id":"g2h_mgn_tvz","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":1544250,"source_layer":"received_biography","first_line":37,"last_line":37,"line_start":2,"line_end":177,"raw_start":1975,"raw_end":2150,"raw_character_offsets":[1975,1976,1977,1978,1979,1980,1981,1982,1983,1984,1985,1986,1987,1988,1989,1990,1991,1992,1993,1994,1995,1996,1997,1998,1999,2000,2001,2002,2003,2004,2005,2006,2007,2008,2009,2010,2011,2012,2013,2014,2015,2016,2017,2018,2019,2020,2021,2022,2023,2024,2025,2026,2027,2028,2029,2030,2031,2032,2033,2034,2035,2036,2037,2038,2039,2040,2041,2042,2043,2044,2045,2046,2047,2048,2049,2050,2051,2052,2053,2054,2055,2056,2057,2058,2059,2060,2061,2062,2063,2064,2065,2066,2067,2068,2069,2070,2071,2072,2073,2074,2075,2076,2077,2078,2079,2080,2081,2082,2083,2084,2085,2086,2087,2088,2089,2090,2091,2092,2093,2094,2095,2096,2097,2098,2099,2100,2101,2102,2103,2104,2105,2106,2107,2108,2109,2110,2111,2112,2113,2114,2115,2116,2117,2118,2119,2120,2121,2122,2123,2124,2125,2126,2127,2128,2129,2130,2131,2132,2133,2134,2135,2136,2137,2138,2139,2140,2141,2142,2143,2144,2145,2146,2147,2148,2149],"projection_sha256":"304cae71dd52b1125a2e8e351e810b60ff6596c95513f6bdd50cc25e66b424c5"},"chapter_id":"c-liangshu-021-wangjun-wangcong","book_id":"b-liangshu-021","work_id":"w-liangshu","source_id":"s-liangshu-021-wangjun-wangcong-ws1544250"},{"id":"c-liangshu-022-wangchong-ancheng:p001","text":"秀稱心受之，亦弗辭多也。昆弟之睦，時議歸之。故吏夏侯稟等表立墓碑，詔許焉。當世高才游王門者，東海王僧孺、吳郡陸倕、彭城劉孝綽、河東裴子野，各制其文，古未之有也。世子機嗣。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":41,"last_line":41,"raw_start":3480,"raw_end":3565,"raw_character_offsets":[3480,3481,3482,3483,3484,3485,3486,3487,3488,3489,3490,3491,3492,3493,3494,3495,3496,3497,3498,3499,3500,3501,3502,3503,3504,3505,3506,3507,3508,3509,3510,3511,3512,3513,3514,3515,3516,3517,3518,3519,3520,3521,3522,3523,3524,3525,3526,3527,3528,3529,3530,3531,3532,3533,3534,3535,3536,3537,3538,3539,3540,3541,3542,3543,3544,3545,3546,3547,3548,3549,3550,3551,3552,3553,3554,3555,3556,3557,3558,3559,3560,3561,3562,3563,3564],"revision_id":1513347},"mentions":[{"id":"c-liangshu-022-wangchong-ancheng:p001:m0000","start":0,"end":1,"surface":"秀","kind":"person","person_id":"z8c_kq5_fri","status":"contextual_provisional"},{"id":"c-liangshu-022-wangchong-ancheng:p001:m0024","start":24,"end":27,"surface":"夏侯稟","kind":"person","person_id":"fko_55z_or0","status":"contextual_provisional"},{"id":"c-liangshu-022-wangchong-ancheng:p001:m0048","start":48,"end":51,"surface":"王僧孺","kind":"person","person_id":"59d_72d_924_AAA","status":"contextual_provisional"},{"id":"c-liangshu-022-wangchong-ancheng:p001:m0054","start":54,"end":56,"surface":"陸倕","kind":"person","person_id":"war_qdw_fs5","status":"contextual_provisional"},{"id":"c-liangshu-022-wangchong-ancheng:p001:m0059","start":59,"end":62,"surface":"劉孝綽","kind":"person","person_id":"di1_zqb_t0f","status":"contextual_provisional"},{"id":"c-liangshu-022-wangchong-ancheng:p001:m0065","start":65,"end":68,"surface":"裴子野","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional"},{"id":"c-liangshu-022-wangchong-ancheng:p001:m0082","start":82,"end":83,"surface":"機","kind":"person","person_id":"z8c_kq5_fri_A","status":"contextual_provisional"}],"chapter_id":"c-liangshu-022-wangchong-ancheng","book_id":"b-liangshu-022","work_id":"w-liangshu","source_id":"s-liangshu-022-wangchong-ancheng-ws1513347"},{"id":"c-liangshu-030-peiziye:p002","text":"子野生而偏孤，爲祖母所養，年九歲，祖母亡，泣血哀慟，家人異之。少好學，善屬文。起家齊武陵王國左常侍，右軍江夏王參軍，遭父憂去職。居喪盡禮，每之墓所，哭泣處草爲之枯，有白兔馴擾其側。天監初，尚書僕射范雲嘉其行，將表奏之，會雲卒，不果。樂安任昉有盛名，爲後進所慕，遊其門者，昉必相薦達。子野於昉爲從中表，獨不至，昉亦恨焉。久之，除右軍安成王參軍，俄遷兼廷尉正。時三官通署獄牒，子野嘗不在，同僚輒署其名，奏有不允，子野從坐免職。或勸言諸有司，可得無咎。子野笑而答曰：「雖慚柳季之道，豈因訟以受服。」自此免黜久之，終無恨意。","source_position":{"start":275,"end":535,"raw":"　　子野生而偏孤，爲祖母所養，年九歲，祖母亡，泣血哀慟，家人異之。少好學，善屬文。起家齊武陵王國左常侍，右軍江夏王參軍，遭父憂去職。居喪盡禮，每之墓所，哭泣處草爲之枯，有白兔馴擾其側。天監初，尚書僕射范雲嘉其行，將表奏之，會雲卒，不果。樂安任昉有盛名，爲後進所慕，遊其門者，昉必相薦達。子野於昉爲從中表，獨不至，昉亦恨焉。久之，除右軍安成王參軍，俄遷兼廷尉正。時三官通署獄牒，子野嘗不在，同僚輒署其名，奏有不允，子野從坐免職。或勸言諸有司，可得無咎。子野笑而答曰：「雖慚柳季之道，豈因訟以受服。」自此免黜久之，終無恨意。","raw_path":"sources/liangshu/wikisource-1508510-raw.wikitext"},"mentions":[{"id":"c-liangshu-030-peiziye:p002:m0000","start":0,"end":2,"surface":"子野","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p002:m0008","start":8,"end":10,"surface":"祖母","kind":"person","person_id":"f3f_bze_579","status":"contextual_provisional","interpretation_note":"梁明祖母養且年九祖母亡；南史同事件明殷氏。保祖母／哺養，不在本包推她與祖駰婚姻或生父母。"},{"id":"c-liangshu-030-peiziye:p002:m0017","start":17,"end":19,"surface":"祖母","kind":"person","person_id":"f3f_bze_579","status":"contextual_provisional","interpretation_note":"梁明祖母養且年九祖母亡；南史同事件明殷氏。保祖母／哺養，不在本包推她與祖駰婚姻或生父母。"},{"id":"c-liangshu-030-peiziye:p002:m0041","start":41,"end":45,"surface":"齊武陵王","kind":"person","person_id":"i1v_ajd_qr0","status":"contextual_provisional","interpretation_note":"齊武陵王爵號與南齊035武陵昭王曄完整傳及時代相符，暫定同人，非晉武陵王晞；尚未以直接府屬名單交核。"},{"id":"c-liangshu-030-peiziye:p002:m0052","start":52,"end":55,"surface":"江夏王","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"齊世江夏有南齊035鋒、050寶玄兩王完整傳，所讀均未明本句右軍府與子野，不任選；排除宋義恭，保兩正史候選、不創第三人。","candidate_person_ids":[]},{"id":"c-liangshu-030-peiziye:p002:m0059","start":59,"end":60,"surface":"父","kind":"person","person_id":"vpy_180_2oi_AAAA","status":"contextual_provisional","interpretation_note":"梁父昭明，南史駰子昭明／昭明子子野。不得套史記殷祖昭明。"},{"id":"c-liangshu-030-peiziye:p002:m0098","start":98,"end":100,"surface":"范雲","kind":"person","person_id":"nln_ldz_i3j","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p002:m0110","start":110,"end":111,"surface":"雲","kind":"person","person_id":"nln_ldz_i3j","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p002:m0118","start":118,"end":120,"surface":"任昉","kind":"person","person_id":"tvc_q3c_t7w","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p002:m0135","start":135,"end":136,"surface":"昉","kind":"person","person_id":"tvc_q3c_t7w","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p002:m0141","start":141,"end":143,"surface":"子野","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p002:m0144","start":144,"end":145,"surface":"昉","kind":"person","person_id":"tvc_q3c_t7w","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p002:m0154","start":154,"end":155,"surface":"昉","kind":"person","person_id":"tvc_q3c_t7w","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p002:m0165","start":165,"end":168,"surface":"安成王","kind":"person","person_id":"z8c_kq5_fri","status":"contextual_provisional","interpretation_note":"梁022安成康王秀明天監元封安成、三年右將軍，且傳末明裴子野為王門撰文；與梁030右軍安成王脈絡相符。右軍/右將軍字面差與年份不矯原字，不據此授子野實任年。"},{"id":"c-liangshu-030-peiziye:p002:m0186","start":186,"end":188,"surface":"子野","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p002:m0196","start":196,"end":197,"surface":"其","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p002:m0204","start":204,"end":206,"surface":"子野","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p002:m0223","start":223,"end":225,"surface":"子野","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p002:m0233","start":233,"end":235,"surface":"柳季","kind":"person","person_id":"myy_zdg_6b6","status":"contextual_provisional","interpretation_note":"固定《論語註疏》卷15孔注明柳下惠展禽，疏並及柳下季；卷18士師三黜直道不枉之章對上子野兼廷尉正受代署牽連而免職、拒向有司申訟且終無恨意之完整語境。判同柳季，保原稱；不是依同名或單一候選自動配人。古注二十字五十字不作年齡資料。"}],"chapter_id":"c-liangshu-030-peiziye","book_id":"b-liangshu-030","work_id":"w-liangshu","source_id":"s-liang030-ws1508510"},{"id":"c-liangshu-033-wangsengru:p012","text":"久之，起爲安西安成王參軍，累遷鎮右始興王中記室，北中郎南康王諮議參軍，入直西省，知撰譜事。普通三年，卒，時年五十八。","mentions":[],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":1514481,"source_layer":"received_biography","first_line":35,"last_line":35,"line_start":2,"line_end":60,"raw_start":2980,"raw_end":3038,"raw_character_offsets":[2980,2981,2982,2983,2984,2985,2986,2987,2988,2989,2990,2991,2992,2993,2994,2995,2996,2997,2998,2999,3000,3001,3002,3003,3004,3005,3006,3007,3008,3009,3010,3011,3012,3013,3014,3015,3016,3017,3018,3019,3020,3021,3022,3023,3024,3025,3026,3027,3028,3029,3030,3031,3032,3033,3034,3035,3036,3037],"projection_sha256":"20858d94d6b5f618128daccc24cd0d45bffe1c8d06e60348a2170d17142f8573","editorial_excerpt_boundary":true},"chapter_id":"c-liangshu-033-wangsengru","book_id":"b-liangshu-033","work_id":"w-liangshu","source_id":"s-liangshu-033-wangsengru-ws1514481"},{"id":"c-liangshu-050-wangji:p002","text":"籍七歲能屬文。及長，好學博涉，有才氣，樂安任昉見而稱之。嘗於沈約坐賦得《詠燭》，甚爲約賞。齊末，爲冠軍行參軍，累遷外兵、記室。天監初，除安成王主簿、尚書三公郎、廷尉正。歷餘姚、錢塘令，並以放免。久之，除輕車湘東王諮議參軍，隨府會稽。郡境有雲門、天柱山，籍嘗遊之，或累月不反。至若邪溪賦詩，其略云：「蟬噪林逾靜，鳥鳴山更幽。」當時以爲文外獨絕。還爲大司馬從事中郎，遷中散大夫，尤不得志，遂徒行市道，不擇交遊。湘東王爲荊州，引爲安西府諮議參軍，帶作塘令。不理縣事，日飲酒，人有訟者，鞭而遣之。少時，卒。文集行於世。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"start":0,"end":1,"surface":"籍","id":"c-liangshu-050-wangji:p002:m0000","person_id":"p93_tgr_t8r_AA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作籍。"},{"start":21,"end":23,"surface":"任昉","id":"c-liangshu-050-wangji:p002:m0021","person_id":"tvc_q3c_t7w","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作昉。"},{"start":30,"end":32,"surface":"沈約","id":"c-liangshu-050-wangji:p002:m0030","person_id":"p8b_7w1_y3q","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作約。"},{"start":42,"end":43,"surface":"約","id":"c-liangshu-050-wangji:p002:m0042","person_id":"p8b_7w1_y3q","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作約。"},{"start":126,"end":127,"surface":"籍","id":"c-liangshu-050-wangji:p002:m0126","person_id":"p93_tgr_t8r_AA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作籍。"},{"start":234,"end":238,"surface":"人有訟者","id":"c-liangshu-050-wangji:p002:u0234","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"泛指來訟人，未具名。"},{"start":242,"end":243,"surface":"之","id":"c-liangshu-050-wangji:p002:u0242","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"回指同句訟人，史文沒有姓名。"}],"source_position":{"first_line":79,"last_line":79,"revision_id":1514482,"source_layer":"received_biography","raw_start":6399,"raw_end":6656,"raw_character_offsets":[6401,6402,6403,6404,6405,6406,6407,6408,6409,6410,641