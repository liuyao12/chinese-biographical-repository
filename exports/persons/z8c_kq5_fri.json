y_path":{"connection":"father","generation_distance":1,"parent_person_id":"z8c_kq5_fri","source_assertion_id":"a-chen017-ji-father","evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-022","chapter_id":"c-liangshu-022-wangchong-ancheng","source_id":"s-liangshu-022-wangchong-ancheng-ws1513347","paragraph_id":"c-liangshu-022-wangchong-ancheng:p001","quote":"秀稱心受之，亦弗辭多也。昆弟之睦，時議歸之。故吏夏侯稟等表立墓碑，詔許焉。當世高才游王門者，東海王僧孺、吳郡陸倕、彭城劉孝綽、河東裴子野，各制其文，古未之有也。世子機嗣。","subject_person_mention_id":"c-liangshu-022-wangchong-ancheng:p001:m0082","object_person_mention_id":"c-liangshu-022-wangchong-ancheng:p001:m0000","source_term":"世子機嗣"}],"status":"contextual_provisional","human_reviewed":false,"interpretation_note":"秀傳之末載立碑及世子機嗣。緊接本卷記機襲封安成郡王、為湘州刺史、薨于州。"}}],"source_mention_summary":[{"source_id":"s-liang030-ws1508510","work_id":"w-liangshu","book_id":"b-liangshu-030","chapter_id":"c-liangshu-030-peiziye","raw_mention_count":1,"mention_ids":["c-liangshu-030-peiziye:p002:m0165"],"paragraph_ids":["c-liangshu-030-peiziye:p002"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-liangshu-030-peiziye:p002:m0165","mention_ids":["c-liangshu-030-peiziye:p002:m0165"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"},{"source_id":"s-liangshu-022-wangchong-ancheng-ws1513347","work_id":"w-liangshu","book_id":"b-liangshu-022","chapter_id":"c-liangshu-022-wangchong-ancheng","raw_mention_count":1,"mention_ids":["c-liangshu-022-wangchong-ancheng:p001:m0000"],"paragraph_ids":["c-liangshu-022-wangchong-ancheng:p001"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-liangshu-022-wangchong-ancheng:p001:m0000","mention_ids":["c-liangshu-022-wangchong-ancheng:p001:m0000"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_oc