{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"z8c_kq5_fri","canonical_person_id":"z8c_kq5_fri","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["z8c_kq5_fri"],"persons":[{"id":"z8c_kq5_fri","label":"安成康王秀〔梁〕","status":"active","historicity":"historical_tradition","aliases":[{"surface":"安成王","mention_ids":["c-liangshu-030-peiziye:p002:m0165"]}],"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-030","chapter_id":"c-liangshu-030-peiziye","source_id":"s-liang030-ws1508510","paragraph_id":"c-liangshu-030-peiziye:p002","mention_id":"c-liangshu-030-peiziye:p002:m0165","quote":"安成王"}],"review":"ai_provisional","identity_note":"梁022安成康王秀明天監元封安成、三年右將軍，且傳末明裴子野為王門撰文；與梁030右軍安成王脈絡相符。右軍/右將軍字面差與年份不矯原字，不據此授子野實任年。"}],"source_mention_summary":[{"source_id":"s-liang030-ws1508510","work_id":"w-liangshu","book_id":"b-liangshu-030","chapter_id":"c-liangshu-030-peiziye","raw_mention_count":1,"mention_ids":["c-liangshu-030-peiziye:p002:m0165"],"paragraph_ids":["c-liangshu-030-peiziye:p002"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-liangshu-030-peiziye:p002:m0165","mention_ids":["c-liangshu-030-peiziye:p002:m0165"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-liang030-ws1508510"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-liangshu-030-peiziye:p002:m0165","start":165,"end":168,"surface":"安成王","kind":"person","person_id":"z8c_kq5_fri","status":"contextual_provisional","interpretation_note":"梁022安成康王秀明天監元封安成、三年右將軍，且傳末明裴子野為王門撰文；與梁030右軍安成王脈絡相符。右軍/右將軍字面差與年份不矯原字，不據此授子野實任年。","paragraph_id":"c-liangshu-030-peiziye:p002","chapter_id":"c-liangshu-030-peiziye"}],"relations":[],"title_holdings":[],"address_assertions":[],"person_references":[{"id":"c-liangshu-021-wangjun-wangcong:p003:r0044","surface":"安成王","start":44,"end":47,"person_id":"z8c_kq5_fri","referent_role":"third_person","paragraph_id":"c-liangshu-021-wangjun-wangcong:p003","quote":"天監初，還，除中書侍郎。高祖甚悅其風采，與陳郡謝覽同見賞擢。俄遷吏部，當官不稱職，轉征虜安成王長史，又爲太子中庶子、遊擊將軍。出爲宣城太守，爲政清和，吏民安之。視事三年，徵拜侍中，遷度支尚書。又以本官兼起部尚書，監起太極殿。事畢，出爲征遠將軍、平西長史、南郡太守。尋爲智武將軍、鎮西長史、蜀郡太守。還爲左民尚書，領步兵校尉。遷吏部尚書，處選甚得名譽。","note":"梁書卷二十二明書秀進號征虜將軍、封安成郡王。","chapter_id":"c-liangshu-021-wangjun-wangcong","book_id":"b-liangshu-021","work_id":"w-liangshu","source_id":"s-liangshu-021-wangjun-wangcong-ws1544250"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-liang030-ancheng","person_id":"z8c_kq5_fri","surfaces":["安成王"],"scope":"same_chapter","status":"contextual_provisional","confidence_level":"medium","identification_basis":{"kind":"source_context","target_mention_ids":["c-liangshu-030-peiziye:p002:m0165"]},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-030","source_id":"s-liang030-ws1508510","chapter_id":"c-liangshu-030-peiziye","paragraph_id":"c-liangshu-030-peiziye:p002","quote":"子野生而偏孤，爲祖母所養，年九歲，祖母亡，泣血哀慟，家人異之。少好學，善屬文。起家齊武陵王國左常侍，右軍江夏王參軍，遭父憂去職。居喪盡禮，每之墓所，哭泣處草爲之枯，有白兔馴擾其側。天監初，尚書僕射范雲嘉其行，將表奏之，會雲卒，不果。樂安任昉有盛名，爲後進所慕，遊其門者，昉必相薦達。子野於昉爲從中表，獨不至，昉亦恨焉。久之，除右軍安成王參軍，俄遷兼廷尉正。時三官通署獄牒，子野嘗不在，同僚輒署其名，奏有不允，子野從坐免職。或勸言諸有司，可得無咎。子野笑而答曰：「雖慚柳季之道，豈因訟以受服。」自此免黜久之，終無恨意。"}],"rationale":"梁022安成康王秀明天監元封安成、三年右將軍，且傳末明裴子野為王門撰文；與梁030右軍安成王脈絡相符。右軍/右將軍字面差與年份不矯原字，不據此授子野實任年。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null}],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-021-wangjun-wangcong:p003","text":"天監初，還，除中書侍郎。高祖甚悅其風采，與陳郡謝覽同見賞擢。俄遷吏部，當官不稱職，轉征虜安成王長史，又爲太子中庶子、遊擊將軍。出爲宣城太守，爲政清和，吏民安之。視事三年，徵拜侍中，遷度支尚書。又以本官兼起部尚書，監起太極殿。事畢，出爲征遠將軍、平西長史、南郡太守。尋爲智武將軍、鎮西長史、蜀郡太守。還爲左民尚書，領步兵校尉。遷吏部尚書，處選甚得名譽。","mentions":[{"id":"c-liangshu-021-wangjun-wangcong:p003:m0023","surface":"謝覽","start":23,"end":25,"person_id":"g2h_mgn_tvz","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":1544250,"source_layer":"received_biography","first_line":37,"last_line":37,"line_start":2,"line_end":177,"raw_start":1975,"raw_end":2150,"raw_character_offsets":[1975,1976,1977,1978,1979,1980,1981,1982,1983,1984,1985,1986,1987,1988,1989,1990,1991,1992,1993,1994,1995,1996,1997,1998,1999,2000,2001,2002,2003,2004,2005,2006,2007,2008,2009,2010,2011,2012,2013,2014,2015,2016,2017,2018,2019,2020,2021,2022,2023,2024,2025,2026,2027,2028,2029,2030,2031,2032,2033,2034,2035,2036,2037,2038,2039,2040,2041,2042,2043,2044,2045,2046,2047,2048,2049,2050,2051,2052,2053,2054,2055,2056,2057,2058,2059,2060,2061,2062,2063,2064,2065,2066,2067,2068,2069,2070,2071,2072,2073,2074,2075,2076,2077,2078,2079,2080,2081,2082,2083,2084,2085,2086,2087,2088,2089,2090,2091,2092,2093,2094,2095,2096,2097,2098,2099,2100,2101,2102,2103,2104,2105,2106,2107,2108,2109,2110,2111,2112,2113,2114,2115,2116,2117,2118,2119,2120,2121,2122,2123,2124,2125,2126,2127,2128,2129,2130,2131,2132,2133,2134,2135,2136,2137,2138,2139,2140,2141,2142,2143,2144,2145,2146,2147,2148,2149],"projection_sha256":"304cae71dd52b1125a2e8e351e810b60ff6596c95513f6bdd50cc25e66b424c5"},"chapter_id":"c-liangshu-021-wangjun-wangcong","book_id":"b-liangshu-021","work_id":"w-liangshu","source_id":"s-liangshu-021-wangjun-wangcong-ws1544250"},{"id":"c-liangshu-030-peiziye:p002","text":"子野生而偏孤，爲祖母所養，年九歲，祖母亡，泣血哀慟，家人異之。少好學，善屬文。起家齊武陵王國左常侍，右軍江夏王參軍，遭父憂去職。居喪盡禮，每之墓所，哭泣處草爲之枯，有白兔馴擾其側。天監初，尚書僕射范雲嘉其行，將表奏之，會雲卒，不果。樂安任昉有盛名，爲後進所慕，遊其門者，昉必相薦達。子野於昉爲從中表，獨不至，昉亦恨焉。久之，除右軍安成王參軍，俄遷兼廷尉正。時三官通署獄牒，子野嘗不在，同僚輒署其名，奏有不允，子野從坐免職。或勸言諸有司，可得無咎。子野笑而答曰：「雖慚柳季之道，豈因訟以受服。」自此免黜久之，終無恨意。","source_position":{"start":275,"end":535,"raw":"　　子野生而偏孤，爲祖母所養，年九歲，祖母亡，泣血哀慟，家人異之。少好學，善屬文。起家齊武陵王國左常侍，右軍江夏王參軍，遭父憂去職。居喪盡禮，每之墓所，哭泣處草爲之枯，有白兔馴擾其側。天監初，尚書僕射范雲嘉其行，將表奏之，會雲卒，不果。樂安任昉有盛名，爲後進所慕，遊其門者，昉必相薦達。子野於昉爲從中表，獨不至，昉亦恨焉。久之，除右軍安成王參軍，俄遷兼廷尉正。時三官通署獄牒，子野嘗不在，同僚輒署其名，奏有不允，子野從坐免職。或勸言諸有司，可得無咎。子野笑而答曰：「雖慚柳季之道，豈因訟以受服。」自此免黜久之，終無恨意。","raw_path":"sources/liangshu/wikisource-1508510-raw.wikitext"},"mentions":[{"id":"c-liangshu-030-peiziye:p002:m0000","start":0,"end":2,"surface":"子野","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p002:m0008","start":8,"end":10,"surface":"祖母","kind":"person","person_id":"f3f_bze_579","status":"contextual_provisional","interpretation_note":"梁明祖母養且年九祖母亡；南史同事件明殷氏。保祖母／哺養，不在本包推她與祖駰婚姻或生父母。"},{"id":"c-liangshu-030-peiziye:p002:m0017","start":17,"end":19,"surface":"祖母","kind":"person","person_id":"f3f_bze_579","status":"contextual_provisional","interpretation_note":"梁明祖母養且年九祖母亡；南史同事件明殷氏。保祖母／哺養，不在本包推她與祖駰婚姻或生父母。"},{"id":"c-liangshu-030-peiziye:p002:m0041","start":41,"end":45,"surface":"齊武陵王","kind":"person","person_id":"i1v_ajd_qr0","status":"contextual_provisional","interpretation_note":"齊武陵王爵號與南齊035武陵昭王曄完整傳及時代相符，暫定同人，非晉武陵王晞；尚未以直接府屬名單交核。"},{"id":"c-liangshu-030-peiziye:p002:m0052","start":52,"end":55,"surface":"江夏王","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"齊世江夏有南齊035鋒、050寶玄兩王完整傳，所讀均未明本句右軍府與子野，不任選；排除宋義恭，保兩正史候選、不創第三人。","candidate_person_ids":[]},{"id":"c-liangshu-030-peiziye:p002:m0059","start":59,"end":60,"surface":"父","kind":"person","person_id":"vpy_180_2oi_AAAA","status":"contextual_provisional","interpretation_note":"梁父昭明，南史駰子昭明／昭明子子野。不得套史記殷祖昭明。"},{"id":"c-liangshu-030-peiziye:p002:m0098","start":98,"end":100,"surface":"范雲","kind":"person","person_id":"nln_ldz_i3j","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p002:m0110","start":110,"end":111,"surface":"雲","kind":"person","person_id":"nln_ldz_i3j","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p002:m0118","start":118,"end":120,"surface":"任昉","kind":"person","person_id":"tvc_q3c_t7w","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p002:m0135","start":135,"end":136,"surface":"昉","kind":"person","person_id":"tvc_q3c_t7w","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p002:m0141","start":141,"end":143,"surface":"子野","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p002:m0144","start":144,"end":145,"surface":"昉","kind":"person","person_id":"tvc_q3c_t7w","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p002:m0154","start":154,"end":155,"surface":"昉","kind":"person","person_id":"tvc_q3c_t7w","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p002:m0165","start":165,"end":168,"surface":"安成王","kind":"person","person_id":"z8c_kq5_fri","status":"contextual_provisional","interpretation_note":"梁022安成康王秀明天監元封安成、三年右將軍，且傳末明裴子野為王門撰文；與梁030右軍安成王脈絡相符。右軍/右將軍字面差與年份不矯原字，不據此授子野實任年。"},{"id":"c-liangshu-030-peiziye:p002:m0186","start":186,"end":188,"surface":"子野","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p002:m0196","start":196,"end":197,"surface":"其","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p002:m0204","start":204,"end":206,"surface":"子野","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p002:m0223","start":223,"end":225,"surface":"子野","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p002:m0233","start":233,"end":235,"surface":"柳季","kind":"person","person_id":"myy_zdg_6b6","status":"contextual_provisional","interpretation_note":"固定《論語註疏》卷15孔注明柳下惠展禽，疏並及柳下季；卷18士師三黜直道不枉之章對上子野兼廷尉正受代署牽連而免職、拒向有司申訟且終無恨意之完整語境。判同柳季，保原稱；不是依同名或單一候選自動配人。古注二十字五十字不作年齡資料。"}],"chapter_id":"c-liangshu-030-peiziye","book_id":"b-liangshu-030","work_id":"w-liangshu","source_id":"s-liang030-ws1508510"}],"sources":[{"chapter_id":"c-liangshu-021-wangjun-wangcong","work_id":"w-liangshu","book_id":"b-liangshu-021","source_id":"s-liangshu-021-wangjun-wangcong-ws1544250","source":{"title":"梁書卷21·王峻傳（附王琮）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?oldid=1544250","permalink":"https://zh.wikisource.org/w/index.php?oldid=1544250","revision_id":1544250,"accessed_on":"2026-11-21","edition":"維基文庫固定數位轉錄","extent":"數位原第33、35、37、39、41行。末段兼載子玩、子琮婚姻、離婚及王峻與王對答。","text_scope":"complete_biography_unit","image_verified":false,"review_status":"text_checked","raw_path":"source-evidence/nanshi022-wangci/external/liang021-ws1544250.wikitext","raw_file_sha256":"d547d5b8e194f36e62b748cdfb6f18366378bb372ffb8d5b82e721ca2ccb3fab","rights":"古代原典及維基文庫數位轉錄。","license_url":"https://zh.wikisource.o