erred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-047-xietiao:p003:m0062","start":62,"end":64,"surface":"虞雲","person_id":"rzp_pbq_1c0","kind":"person","status":"contextual_provisional","interpretation_note":"本句具名，按上下文讀作虞雲。","paragraph_id":"c-nanqishu-047-xietiao:p003","chapter_id":"c-nanqishu-047-xietiao"}],"relations":[],"title_holdings":[{"id":"th-qi047-xietiao-63-60","person_id":"rzp_pbq_1c0","title":"侍讀","kind":"office","mode":"attestation","attestations":[{"id":"th-qi047-xietiao-63-60:a","paragraph_id":"c-nanqishu-047-xietiao:p003","start":60,"end":62,"surface":"侍讀","person_mention_id":"c-nanqishu-047-xietiao:p003:m0062","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-047","chapter_id":"c-nanqishu-047-xietiao","source_id":"s-nanqishu-047-xietiao-ws1492435","paragraph_id":"c-nanqishu-047-xietiao:p003","quote":"　　子隆在荊州，好辭賦，數集僚友，朓以文才，尤被賞愛，流連晤對，不捨日夕。長史王秀之以朓年少相動，密以啓聞。世祖敕曰：「侍讀虞雲自宜恒應侍接。朓可還都。」朓道中爲詩寄西府曰：「常恐鷹隼擊，秋菊委嚴霜。寄言罻羅者，寥廓已高翔。」遷新安王中軍記室。朓牋辭子隆曰：「朓聞潢汙之水，思朝宗而每竭；駑蹇之乘，希沃若而中疲。何則？皐壤搖落，對之惆悵；岐路東西，或以嗚悒。況乃服義徒擁，歸志莫從，邈若墜雨，飄似秋蔕。朓實庸流，行能無算，屬天地休明，山川受納，褒採一介，搜揚小善，捨耒場圃，奉筆菟園。東亂三江，西浮七澤，契闊戎旃，從容讌語。長裾日曳，後乘載脂，榮立府廷，恩加顏色。沐髮晞陽，未測涯涘；撫臆論報，早誓肌骨。不悟滄溟未運，波臣自蕩；渤澥方春，旅翮先謝。清切蕃房，寂寥舊蓽。輕舟反泝，弔影獨留，白雲在天，龍門不見。去德滋永，思德滋深。唯待青江可望，候歸艎於春渚；朱邸方開，效蓬心於秋實。如其簪履或存，衽席無改，雖復身填溝壑，猶望妻子知歸。攬涕告辭，悲來橫集。」","person_mention_id":"c-nanqishu-047-xietiao:p003:m0062"}],"status":"source_attested","interpretation_note":"本句所載官名，任期無確切年月。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-047-xietiao:p003","t