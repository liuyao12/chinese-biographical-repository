{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004124","canonical_person_id":"vma_jxj_3e9","id_aliases":["cbr-p004124"],"identity_policy":"contextual_provisional","person_ids":["vma_jxj_3e9"],"persons":[{"id":"vma_jxj_3e9","label":"馮喜（張儀列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"其舍人馮喜","mention_ids":["c-shiji-070-zhang:m050-0227"]}],"evidence":[{"mention_id":"c-shiji-070-zhang:m050-0227","chapter_id":"c-shiji-070-zhang","paragraph_id":"c-shiji-070-zhang:p050","quote":"其舍人馮喜"}],"id_aliases":["cbr-p004124"]}],"source_mention_summary":[{"source_id":"s-shiji-070-zhang","work_id":"w-shiji","book_id":"b-shiji-070","chapter_id":"c-shiji-070-zhang","mention_count":1,"mention_ids":["c-shiji-070-zhang:m050-0227"],"paragraph_ids":["c-shiji-070-zhang:p050"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-070-zhang"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-070-zhang:m050-0227","start":227,"end":232,"surface":"其舍人馮喜","kind":"person","person_id":"vma_jxj_3e9","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p050","chapter_id":"c-shiji-070-zhang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji070-041","person_id":"vma_jxj_3e9","scope":"same_chapter","chapter_ids":["c-shiji-070-zhang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"依第46至51段明示名字與引語範圍暫接，趙襄子姊與代王的故事另存未名；秦武王與秦惠王依卒立語境分開。韓王趙王及趙先王不按年代記憶補名；蘇秦謀齊的燕王齊王另存候選，不強與其他王同指或斷為異人。孟賁烏獲是比擬人物，不作在場者；紂為引古。擬議秦楚太子質子與秦女婚姻保留未解。","surfaces":["其舍人馮喜"],"evidence":[{"paragraph_id":"c-shiji-070-zhang:p050","quote":"秦武王元年，群臣日夜惡張儀未已，而齊讓又至。張儀懼誅，乃因謂秦武王曰：「儀有愚計，願效之。」王曰：「柰何？」對曰：「為秦社稷計者，東方有大變，然後王可以多割得地也。今聞齊王甚憎儀，儀之所在，必興師伐之。故儀願乞其不肖之身之梁，齊必興師而伐梁。梁齊之兵連於城下而不能相去，王以其閒伐韓，入三川，出兵函谷而毋伐，以臨周，祭器必出。挾天子，按圖籍，此王業也。」秦王以為然，乃具革車三十乘，入儀之梁。齊果興師伐之。梁哀王恐。張儀曰：「王勿患也，請令罷齊兵。」乃使其舍人馮喜之楚，借使之齊，謂齊王曰：「王甚憎張儀；雖然，亦厚矣王之託儀於秦也！」齊王曰：「寡人憎儀，儀之所在，必興師伐之，何以託儀？」對曰：「是乃王之託儀也。夫儀之出也，固與秦王約曰：『為王計者，東方有大變，然後王可以多割得地。今齊王甚憎儀，儀之所在，必興師伐之。故儀願乞其不肖之身之梁，齊必興師伐之。齊梁之兵連於城下而不能相去，王以其閒伐韓，入三川，出兵函谷而無伐，以臨周，祭器必出。挾天子，案圖籍，此王業也。』秦王以為然，故具革車三十乘而入之梁也。今儀入梁，王果伐之，是王內罷國而外伐與國，廣鄰敵以內自臨，而信儀於秦王也。此臣之所謂『託儀』也。」齊王曰：「善。」乃使解兵。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-070-zhang:p050","text":"秦武王元年，群臣日夜惡張儀未已，而齊讓又至。張儀懼誅，乃因謂秦武王曰：「儀有愚計，願效之。」王曰：「柰何？」對曰：「為秦社稷計者，東方有大變，然後王可以多割得地也。今聞齊王甚憎儀，儀之所在，必興師伐之。故儀願乞其不肖之身之梁，齊必興師而伐梁。梁齊之兵連於城下而不能相去，王以其閒伐韓，入三川，出兵函谷而毋伐，以臨周，祭器必出。挾天子，按圖籍，此王業也。」秦王以為然，乃具革車三十乘，入儀之梁。齊果興師伐之。梁哀王恐。張儀曰：「王勿患也，請令罷齊兵。」乃使其舍人馮喜之楚，借使之齊，謂齊王曰：「王甚憎張儀；雖然，亦厚矣王之託儀於秦也！」齊王曰：「寡人憎儀，儀之所在，必興師伐之，何以託儀？」對曰：「是乃王之託儀也。夫儀之出也，固與秦王約曰：『為王計者，東方有大變，然後王可以多割得地。今齊王甚憎儀，儀之所在，必興師伐之。故儀願乞其不肖之身之梁，齊必興師伐之。齊梁之兵連於城下而不能相去，王以其閒伐韓，入三川，出兵函谷而無伐，以臨周，祭器必出。挾天子，案圖籍，此王業也。』秦王以為然，故具革車三十乘而入之梁也。今儀入梁，王果伐之，是王內罷國而外伐與國，廣鄰敵以內自臨，而信儀於秦王也。此臣之所謂『託儀』也。」齊王曰：「善。」乃使解兵。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-070-zhang:m050-0000","start":0,"end":3,"surface":"秦武王","kind":"person","person_id":"6mm_1pn_fhf","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m050-0006","start":6,"end":8,"surface":"群臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名故事人物或群體，未補姓名及成員。"},{"id":"c-shiji-070-zhang:m050-0011","start":11,"end":13,"surface":"張儀","kind":"person","person_id":"5an_r55_hee","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m050-0022","start":22,"end":24,"surface":"張儀","kind":"person","person_id":"5an_r55_hee","status":"contextual_provisional"},{"id":"c-shiji-070-zha