774,1775,1776,1777,1778,1779,1780,1781,1782,1783,1784,1785,1786,1787,1788,1789,1790,1791,1792,1793,1794,1795,1796,1797,1798,1799],"projection_sha256":"d1cc48860d157f50480ca719f3b3ecd53ebe6415a75719b72e4936a6205365be","editorial_excerpt_boundary":true},"chapter_id":"c-chenshu-007-shenmiaorong","book_id":"b-chenshu-007","work_id":"w-chenshu","source_id":"s-chenshu-007-shenmiaorong-ws2015446"},{"id":"c-chenshu-017-yuanshu-complete:p004","text":"天嘉元年，守吏部尚書。三年，即真。尋領右軍將軍，又領丹陽尹，本官如故。五年，以葬父，拜表自解，詔賜絹布五十匹，錢十萬，令葬訖停宅視郡事，(葬)服闋，還復本職。其年秩滿，解尹，加散騎常侍，將軍、尚書嵭如故。是時，僕射到仲舉雖參掌選事，銓衡汲引，嵭出於樞，其所舉薦，多會上旨。謹慎周密，清白自居，文武職司，鮮有遊其門者。廢帝即位，遷尚書左僕射。光大元年卒，時年五十一。贈侍中、左光祿大夫，諡曰簡懿。有集十卷行於世。弟憲自有傳。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":58,"last_line":58,"raw_start":3879,"raw_end":4142,"raw_character_offsets":[3884,3885,3886,3887,3890,3891,3892,3893,3894,3895,3896,3897,3898,3899,3900,3901,3902,3903,3904,3905,3906,3907,3908,3909,3910,3911,3912,3913,3914,3915,3916,3917,3918,3919,3920,3921,3922,3923,3924,3925,3926,3927,3928,3929,3930,3931,3932,3933,3934,3935,3936,3937,3938,3939,3940,3941,3942,3943,3944,3945,3946,3947,3948,3949,3950,3951,3952,3953,3954,3955,3956,3957,3958,3959,3984,3985,3986,3987,3988,3989,3990,3991,3992,3993,3994,3995,3996,3997,3998,3999,4000,4001,4002,4003,4004,4005,4006,4007,4008,4009,4010,4011,4012,4013,4014,4015,4016,4017,4018,4019,4020,4021,4022,4023,4024,4025,4026,4027,4028,4029,4030,4031,4032,4033,4034,4035,4036,4037,4038,4039,4040,4041,4042,4043,4044,4045,4046,4047,4048,4049,4050,4051,4052,4053,4054,4055,4056,4057,4058,4059,4060,4061,4062,4063,4064,4065,4066,4067,4068,4069,4070,4071,4072,4073,4074,4075,4076,4077,4078,4079,4085,4086,4087,4088,4091,4092,4093,4094,4095,4096,4097,4098,4099,4100,4101,4102,4103,4104,4105,4106,4107,4108,4109,4110,4111,4112,4113,4114,4115,4116,4117,4118,4119,4120,4121,4122,4123,4136,4137,4138,4141],"revision_id":1544244},"mentions":[{"id":"c-chenshu-017-yuanshu-complete:p004:m0107","start":107,"end":110,"surface":"到仲舉","kind":"person","person_id":"4mr_j4p_k5h_A","status":"contextual_provisional"},{"id":"c-chenshu-017-yuanshu-complete:p004:m0124","start":124,"end":125,"surface":"樞","kind":"person","person_id":"hb9_2gq_205_AA","status":"contextual_provisional"},{"id":"c-chenshu-017-yuanshu-complete:p004:m0158","start":158,"end":160,"surface":"廢帝","kind":"person","person_id":"2mj_6rl_6xs","status":"contextual_provisional"},{"id":"c-chenshu-017-yuanshu-complete:p004:m0206","start":206,"end":207,"surface":"憲","kind":"person","person_id":"6qj_3sw_6fo","status":"contextual_provisional"}],"chapter_id":"c-chenshu-017-yuanshu-complete","book_id":"b-chenshu-017","work_id":"w-chenshu","source_id":"s-chenshu-017-yuanshu-complete-ws1544244"},{"id":"c-chenshu-020-yuanshu-dao-zhongju:p001","text":"到仲舉字德言，彭城武原人也。祖坦，齊中書侍郎。父洽，梁侍中。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":12,"last_line":12,"raw_start":180,"raw_end":210,"raw_character_offsets":[180,181,182,183,184,185,186,187,188,189,190,191,192,193,194,195,196,197,198,199,200,201,202,203,204,205,206,207,208,209],"revision_id":1514499},"mentions":[{"id":"c-chenshu-020-yuanshu-dao-zhongju:p001:m0000","start":0,"end":3,"surface":"到仲舉","kind":"person","person_id":"4mr_j4p_k5h_A","status":"contextual_provisional"},{"id":"c-chenshu-020-yuanshu-dao-zhongju:p001:m0004","start":4,"end":6,"surface":"德言","kind":"person","person_id":"4mr_j4p_k5h_A","status":"contextual_provisional"},{"id":"c-chenshu-020-yuanshu-dao-zhongju:p001:m0024","start":24,"end":25,"surface":"洽","kind":"person","person_id":"4mr_j4p_k5h","status":"contextual_provisional"}],"chapter_id":"c-chenshu-020-yuanshu-dao-zhongju","book_id":"b-chenshu-020","work_id":"w-chenshu","source_id":"s-chenshu-020-yuanshu-dao-zhongju-ws1514499"},{"id":"c-nanshi-012-shenmiaorong:p002","text":"時宣帝與僕射到仲舉、舍人劉師知等，並受遺輔政。師知與仲舉恒居禁中，參決眾事，而宣帝為揚州刺史，與左右三百人，入居尚書省。師知忌宣帝權重，矯敕令還東府理州務。宣帝將出，毛喜止帝曰：「今若出外，便受制於人，如曹爽願作富家公不可得也。」宣帝乃稱疾，召師知留與語，使毛喜先入，言之於后。后曰：「今伯宗年幼，政事並委二郎，此非我意。」喜又言於廢帝，廢帝曰：「此自師知等所為，非朕意也。」喜出報宣帝，帝因囚師知。自入見后及帝，極陳師知之短。仍自草敕請畫，以師知付廷尉，其夜於獄賜死。自是政歸宣帝。后憂悶，計無所出，乃密賂宦者蔣裕，令誘建安人張安國使據郡反，冀因此圖帝。安國事發被誅，時后左右近侍頗知其事，后恐連逮黨與，並殺之。","mentions":[{"id":"c-nanshi-012-shenmiaorong:p002:m0006","surface":"到仲舉","start":6,"end":9,"person_id":"4mr_j4p_k5h_A","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-012-shenmiaorong:p002:m0012","surface":"劉師知","start":12,"end":15,"person_id":"tpj_u6z_dq1_A","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-012-shenmiaorong:p002:m0083","surface":"毛喜","start":83,"end":85,"person_id":"1ld_xob_aav_A","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-012-shenmiaorong:p002:m0102","surface":"曹爽","start":102,"end":104,"person_id":"30k_jzz_tpd_AA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-012-shenmiaorong:p002:m0129","surface":"毛喜","start":129,"end":131,"person_id":"1ld_xob_aav_A","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-012-shenmiaorong:p002:m0144","surface":"伯宗","start":144,"end":146,"person_id":"2mj_6rl_6xs","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-012-shenmiaorong:p002:m0256","surface":"蔣裕","start":256,"end":258,"person_id":"bbc_dzp_4t5","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-012-shenmiaorong:p002:m0264","surface":"張安國","start":264,"end":267,"person_id":"3in_24x_xph","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":2060595,"source_layer":"received_biography","first_line":78,"last_line":78,"line_start":0,"line_end":331,"raw_start":3731,"raw_end":4062,"raw_character_offsets":[3731,3732,3733,3734,3735,3736