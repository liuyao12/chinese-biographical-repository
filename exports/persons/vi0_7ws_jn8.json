{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"vi0_7ws_jn8","canonical_person_id":"vi0_7ws_jn8","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["vi0_7ws_jn8"],"persons":[{"id":"vi0_7ws_jn8","label":"申公（魏其武安侯列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"申公","mention_ids":["c-shiji-107-weiqi:m008-0029"]}],"evidence":[{"mention_id":"c-shiji-107-weiqi:m008-0029","chapter_id":"c-shiji-107-weiqi","paragraph_id":"c-shiji-107-weiqi:p008","quote":"申公"}]}],"source_mention_summary":[{"source_id":"s-shiji-107-weiqi","work_id":"w-shiji","book_id":"b-shiji-107","chapter_id":"c-shiji-107-weiqi","mention_count":1,"mention_ids":["c-shiji-107-weiqi:m008-0029"],"paragraph_ids":["c-shiji-107-weiqi:p008"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-107-weiqi"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-107-weiqi:m008-0029","start":29,"end":31,"surface":"申公","kind":"person","person_id":"vi0_7ws_jn8","status":"contextual_provisional","paragraph_id":"c-shiji-107-weiqi:p008","chapter_id":"c-shiji-107-weiqi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-107-weiqi:p008","text":"魏其、武安俱好儒術，推轂趙綰為御史大夫，王臧為郎中令。迎魯申公，欲設明堂，令列侯就國，除關，以禮為服制，以興太平。舉適諸竇宗室毋節行者，除其屬籍。時諸外家為列侯，列侯多尚公主，皆不欲就國，以故毀日至竇太后。太后好黃老之言，而魏其、武安、趙綰、王臧等務隆推儒術，貶道家言，是以竇太后滋不說魏其等。及建元二年，御史大夫趙綰請無奏事東宮。竇太后大怒，乃罷逐趙綰、王臧等，而免丞相、太尉，以柏至侯許昌為丞相，武彊侯莊青翟為御史大夫。魏其、武安由此以侯家居。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-107-weiqi:m008-0000","start":0,"end":2,"surface":"魏其","kind":"person","person_id":"nuf_tb9_fjs_A","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m008-0003","start":3,"end":5,"surface":"武安","kind":"person","person_id":"7mz_d13_9ka_A","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m008-0012","start":12,"end":14,"surface":"趙綰","kind":"person","person_id":"btq_wmp_kuw","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m008-0020","start":20,"end":22,"surface":"王臧","kind":"person","person_id":"6qw_s6t_pib","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m008-0029","start":29,"end":31,"surface":"申公","kind":"person","person_id":"vi0_7ws_jn8","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m008-0099","start":99,"end":102,"surface":"竇太后","kind":"person","person_id":"l26_mjw_rwe","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m008-0103","start":103,"end":105,"surface":"太后","kind":"person","person_id":"l26_mjw_rwe","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m008-0112","start":112,"end":114,"surface":"魏其","kind":"person","person_id":"nuf_tb9_fjs_A","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m008-0115","start":115,"end":117,"surface":"武安","kind":"person","person_id":"7mz_d13_9ka_A","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m008-0118","start":118,"end":120,"surface":"趙綰","kind":"person","person_id":"btq_wmp_kuw","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m008-0121","start":121,"end":123,"surface":"王臧","kind":"person","person_id":"6qw_s6t_pib","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m008-0137","start":137,"end":140,"surface":"竇太后","kind":"person","person_id":"l26_mjw_rwe","status":"contextual_provisional"},{"id":"c-shiji