{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p002363","identity_policy":"contextual_provisional","person_ids":["cbr-p002363"],"persons":[{"id":"cbr-p002363","label":"魏惠王（趙世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"魏惠王","mention_ids":["c-shiji-043-zhao:m052-0107","c-shiji-043-zhao:m054-0007","c-shiji-043-zhao:m054-0062","c-shiji-043-zhao:m055-0020","c-shiji-043-zhao:m055-0116"]}],"evidence":[{"mention_id":"c-shiji-043-zhao:m052-0107","chapter_id":"c-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p052","quote":"魏惠王"},{"mention_id":"c-shiji-043-zhao:m054-0007","chapter_id":"c-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p054","quote":"魏惠王"},{"mention_id":"c-shiji-043-zhao:m054-0062","chapter_id":"c-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p054","quote":"魏惠王"},{"mention_id":"c-shiji-043-zhao:m055-0020","chapter_id":"c-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p055","quote":"魏惠王"},{"mention_id":"c-shiji-043-zhao:m055-0116","chapter_id":"c-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p055","quote":"魏惠王"}]}],"mentions":[{"id":"c-shiji-043-zhao:m052-0107","start":107,"end":110,"surface":"魏惠王","kind":"person","person_id":"cbr-p002363","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p052","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m054-0007","start":7,"end":10,"surface":"魏惠王","kind":"person","person_id":"cbr-p002363","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p054","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m054-0062","start":62,"end":65,"surface":"魏惠王","kind":"person","person_id":"cbr-p002363","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p054","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m055-0020","start":20,"end":23,"surface":"魏惠王","kind":"person","person_id":"cbr-p002363","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p055","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m055-0116","start":116,"end":119,"surface":"魏惠王","kind":"person","person_id":"cbr-p002363","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p055","chapter_id":"c-shiji-043-zhao"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji043-134","person_id":"cbr-p002363","surfaces":["魏惠王"],"scope":"same_chapter","chapter_ids":["c-shiji-043-zhao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-043-zhao:p052","quote":"成侯元年，公子勝與成侯爭立，爲亂。二年六月，雨雪。三年，太戊午爲相。伐衞，取鄕邑七十三。魏敗我藺。四年，與秦戰髙安，敗之。五年，伐齊于鄄。魏敗我懷。攻鄭，敗之，以與韓，韓與我長子。六年，中山筑長城。伐魏，敗湪澤，圍魏惠王。七年，侵齊，至長城。與韓攻周。八年，與韓分周以爲兩。九年，與齊戰阿下。十年，攻衞，取甄。十一年，秦攻魏，趙救之石阿。十二年，秦攻魏少梁，趙救之。十三年，秦獻公使庶長國伐魏少梁，虜其太子、痤。魏敗我澮，取皮牢。成侯與韓昭侯遇上黨。十四年，與韓攻秦。十五年，助魏攻齊。"},{"paragraph_id":"c-shiji-043-zhao:p054","quote":"十七年，成侯與魏惠王遇葛孽。十九年，與齊、宋會平陸，與燕會阿。二十年，魏獻榮椽，因以爲檀臺。二十一年，魏圍我邯鄲。二十二年，魏惠王拔我邯鄲，齊亦敗魏於桂陵。二十四年，魏歸我邯鄲，與魏盟漳水上。秦攻我藺。二十五年，成侯卒。公子紲太子肅侯爭立，紲敗亡奔韓。"},{"paragraph_id":"c-shiji-043-zhao:p055","quote":"肅侯元年，奪晉君端氏，徙處屯留。二年，與魏惠王遇於陰晉。三年，公子范襲邯鄲，不勝而死。四年，朝天子。六年，攻齊，拔髙唐。七年，公子刻攻魏首垣。十一年，秦孝公使商君伐魏，虜其將公子卬。趙伐魏。十二年，秦孝公卒，商君死。十五年，起壽陵。魏惠王卒。"}],"rationale":"限本篇明示姓名、是為與連續事件；太戊午／大戊午暫接但字形待底本核查。娃嬴／孟姚／惠后按本段明示暫接，不與先前夢辭孟姚按同名合併；王紲與較早公子紲分候選。君王職稱按各國上下文辨別，不全域匹配。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-043-zhao:p052","text":"成侯元年，公子勝與成侯爭立，爲亂。二年六月，雨雪。三年，太戊午爲相。伐衞，取鄕邑七十三。魏敗我藺。四年，與秦戰髙安，敗之。五年，伐齊于鄄。魏敗我懷。攻鄭，敗之，以與韓，韓與我長子。六年，中山筑長城。伐魏，敗湪澤，圍魏惠王。七年，侵齊，至長城。與韓攻周。八年，與韓分周以爲兩。九年，與齊戰阿下。十年，攻衞，取甄。十一年，秦攻魏，趙救之石阿。十二年，秦攻魏少梁，趙救之。十三年，秦獻公使庶長國伐魏少梁，虜其太子、痤。魏敗我澮，取皮牢。成侯與韓昭侯遇上黨。十四年，與韓攻秦。十五年，助魏攻齊。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-043-zhao:m052-0000","start":0,"end":2,"surface":"成侯","kind":"person","person_id":"cbr-p002360","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m052-0005","start":5,"end":8,"surface":"公子勝","kind":"person","person_id":"cbr-p002361","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m052-0009","start":9,"end":11,"surface":"成侯","kind":"person","person_id":"cbr-p002360","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m052-0028","start":28,"end":31,"surface":"太戊午","kind":"person","person_id":"cbr-p002362","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m052-0107","start":107,"end":110,"surface":"魏惠王","kind":"person","person_id":"cbr-p002363","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m052-0187","start":187,"end":190,"surface":"秦獻公","kind":"person","person_id":"cbr-p002364","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m052-0191","start":191,"end":194,"surface":"庶長國","kind":"person","person_id":"cbr-p002365","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m052-0200","start":200,"end":203,"surface":"其太子","kind":"person","person_id":"cbr-p002366","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m052-0204","start":204,"end":205,"surface":"痤","kind":"person","person_id":"cbr-p002367","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m052-0215","start":215,"end":217,"surface":"成侯","kind":"person","person_id":"cbr-p002360","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m052-0218","start":218,"end":221,"surface":"韓昭侯","kind":"person","person_id":"cbr-p002368","status":"contextual_provisional"}],"chapter_id":"c-shiji-043-zhao","book_id":"b-shiji-043","work_id":"w-shiji","source_id":"s-shiji-043-zhao"},{"id":"c-shiji-043-zhao:p054","text":"十七年，成侯與魏惠王遇葛孽。十九年，與齊、宋會平陸，與燕會阿。二十年，魏獻榮椽，因以爲檀臺。二十一年，魏圍我邯鄲。二十二年，魏惠王拔我邯鄲，齊亦敗魏於桂陵。二十四年，魏歸我邯鄲，與魏盟漳水上。秦攻我藺。二十五年，成侯卒。公子紲太子肅侯爭立，紲敗亡奔韓。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-043-zhao:m054-0004","start":4,"end":6,"surface":"成侯","kind":"person","person_id":"cbr-p002360","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m054-0007","start":7,"end":10,"surface":"魏惠王","kind":"person","person_id":"cbr-p002363","status":"contextual_prov