tle_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji055-028","person_id":"k1p_er4_ei4","surfaces":["田榮"],"scope":"same_chapter","chapter_ids":["c-shiji-055-liu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-055-liu:p011","quote":"良至韓，韓王成以良從漢王故，項王不遣成之國，從與俱東。良說項王曰：「漢王燒絕棧道，無還心矣。」乃以齊王田榮反，書告項王。項王以此無西憂漢心，而發兵北擊齊。"},{"paragraph_id":"c-shiji-055-liu:p012","quote":"項王竟不肯遣韓王，乃以為侯，又殺之彭城。良亡，間行歸漢王，漢王亦已還定三秦矣。復以良為成信侯，從東擊楚。至彭城，漢敗而還。至下邑，漢王下馬踞鞍而問曰：「吾欲捐關以東等棄之，誰可與共功者？」良進曰：「九江王黥布，楚梟將，與項王有郄；彭越與齊王田榮反梁地：此兩人可急使。而漢王之將獨韓信可屬大事，當一面。即欲捐之，捐之此三人，則楚可破也。」漢王乃遣隨何說九江王布，而使人連彭越。及魏王豹反，使韓信將兵擊之，因舉燕、代、齊、趙。然卒破楚者，此三人力也。"}],"rationale":"依明示名字、局部任事、授封及引語暫接；良久、每上冢與愛子之上排除人物短稱。老父場景的父不接張良父平；韓悼惠王不接齊王，秦王子嬰不接博浪沙秦皇帝，未名者不補姓名。神異與古代比擬不表示人物當時在場或神蹟已證。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-055-liu:p011","text":"良至韓，韓王成以良從漢王故，項王不遣成之國，從與俱東。良說項王曰：「漢王燒絕棧道，無還心矣。」乃以齊王田榮反，書告項王。項王以此無西憂漢心，而發兵北擊齊。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-055-liu:m011-0000","start":0,"end":1,"surface":"良","kind":"person","person_id":"31t_28w_hda_A","status":"contextual_provisional"},{"id":"c-shiji-055-liu:m011-0004","start":4,"end":7,"surface":"韓王成","kind":"person","person_id":"suq_hns_wuy","status":"contextual_provisional"},{"id":"c-shiji-055-liu:m011-0008","start":8,"end":9,"surface":"良","kind":"person","person_id":"31t_28w_hda_A","status":"contextual_provisional"},{"id":"c-shiji-055-liu:m011-0010","start":10,"end":12,"surface":"漢王","kind":"person","person_id":"aae_mkd_tas","status":"contextual_provisional"},{"id":"c-shiji-055-liu:m011-0014","start":14,"end":16,"surface":"項王","kind":"person","person_id":"g70_oq8_1fb","status":"contextual_provisional"},{"id":"c-shiji-055-liu:m011-0018","start":18,"end":19,"surface":"成","kind":"person","person_id":"suq_hns_wuy","status":"contextual_provisional"},{"id":"