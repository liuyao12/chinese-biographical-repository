start":12,"end":15,"surface":"魏獻子","kind":"person","person_id":"8f2_m4v_3el","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m014-0023","start":23,"end":25,"surface":"三家","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、族稱或未定指代；有虞等不直接補作熟知個人，仍待覆核。"},{"id":"c-shiji-031-wu:m014-0032","start":32,"end":34,"surface":"叔向","kind":"person","person_id":"edm_4zm_yh1","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m014-0056","start":56,"end":58,"surface":"三家","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、族稱或未定指代；有虞等不直接補作熟知個人，仍待覆核。"}],"chapter_id":"c-shiji-031-wu","book_id":"b-shiji-031","work_id":"w-shiji","source_id":"s-shiji-031-wu"},{"id":"c-shiji-032-qi:p067","text":"九年，景公使晏嬰之晉，與叔向私語曰：「齊政卒歸田氏。田氏雖無大德，以公權私，有德於民，民愛之。」十二年，景公如晉，見平公，欲與伐燕。十八年，公復如晉，見昭公。二十六年，獵魯郊，因入魯，與晏嬰俱問魯禮。三十一年，魯昭公辟季氏難，奔齊。齊欲以千社封之，子家止昭公，昭公乃請齊伐魯，取鄆以居昭公。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-032-qi:m067-0003","start":3,"end":5,"surface":"景公","kind":"person","person_id":"wuz_yxe_b9k","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m067-0006","start":6,"end":8,"surface":"晏嬰","kind":"person","person_id":"jcn_rp4_qap","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m067-0012","start":12,"end":14,"surface":"叔向","kind":"person","person_id":"edm_4zm_yh1","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m067-0052","start":52,"end":54,"surface":"景公","kind":"person","person_id":"wuz_yxe_b9k","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m067-0058","start":58,"end":60,"surface":"平公","kind":"person","person_id":"0p8_ug5_eja","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m067-0076","start":76,"end":78,"surface":"昭公","kind":"person","person_id":"0ad_dbw_97q","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m067-0093","start":93,"end":95,"surface":"晏嬰","kind":"person","person_id":"jcn_rp4_qap","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m0