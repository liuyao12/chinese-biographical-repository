mplete:p001:m0010","source_term":"君正之子"}],"status":"contextual_provisional","human_reviewed":false,"interpretation_note":"君正為樞父，兩傳均明記。"}}],"source_mention_summary":[{"source_id":"s-chenshu-024-yuanshu-xian-ws1494985","work_id":"w-chenshu","book_id":"b-chenshu-024","chapter_id":"c-chenshu-024-yuanshu-xian","raw_mention_count":3,"mention_ids":["c-chenshu-024-yuanshu-xian:p001:m0000","c-chenshu-024-yuanshu-xian:p001:m0003","c-chenshu-024-yuanshu-xian:p002:m0000"],"paragraph_ids":["c-chenshu-024-yuanshu-xian:p001","c-chenshu-024-yuanshu-xian:p002"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-chenshu-024-yuanshu-xian:p001:m0000","mention_ids":["c-chenshu-024-yuanshu-xian:p001:m0000"],"kind":"paragraph"},{"canonical_mention_id":"c-chenshu-024-yuanshu-xian:p001:m0003","mention_ids":["c-chenshu-024-yuanshu-xian:p001:m0003"],"kind":"paragraph"},{"canonical_mention_id":"c-chenshu-024-yuanshu-xian:p002:m0000","mention_ids":["c-chenshu-024-yuanshu-xian:p002:m0000"],"kind":"paragraph"}],"mention_count":3,"duplicate_mention_count":0,"paragraph_occurrence_count":3,"table_occurrence_count":0,"passage_count":2,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"3處獨立位置，3個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"},{"source_id":"s-chenshu-023-wangyu-complete-ws1514496","work_id":"w-chenshu","book_id":"b-chenshu-023","chapter_id":"c-chenshu-023-wangyu-complete","raw_mention_count":2,"mention_ids":["c-chenshu-023-wangyu-complete:p001:m0050","c-chenshu-023-wangyu-complete:p001:m0107"],"paragraph_ids":["c-chenshu-023-wangyu-complete:p001"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-chenshu-023-wangyu-complete:p001:m0050","mention_ids":["c-chenshu-023-wangyu-complete:p001:m0050"],"kind":"paragraph"},{"canonical_mention_id":"c-chenshu-023-wangyu-complete:p001:m0107","mention_ids":["c-chenshu-023-wangyu-complete:p001:m0107"],"kind":"paragraph"}],"mention_count":2,"duplicate_mention_count":0,"paragraph_occurren