依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-chen017-shu-brother","subject_person_id":"hb9_2gq_205_AA","object_person_id":"6qj_3sw_6fo","predicate":"brother","qualifiers":{"source_term":"弟憲"},"evidence":[{"work_id":"w-chenshu","book_id":"b-chenshu-017","chapter_id":"c-chenshu-017-yuanshu-complete","source_id":"s-chenshu-017-yuanshu-complete-ws1544244","paragraph_id":"c-chenshu-017-yuanshu-complete:p004","quote":"天嘉元年，守吏部尚書。三年，即真。尋領右軍將軍，又領丹陽尹，本官如故。五年，以葬父，拜表自解，詔賜絹布五十匹，錢十萬，令葬訖停宅視郡事，(葬)服闋，還復本職。其年秩滿，解尹，加散騎常侍，將軍、尚書嵭如故。是時，僕射到仲舉雖參掌選事，銓衡汲引，嵭出於樞，其所舉薦，多會上旨。謹慎周密，清白自居，文武職司，鮮有遊其門者。廢帝即位，遷尚書左僕射。光大元年卒，時年五十一。贈侍中、左光祿大夫，諡曰簡懿。有集十卷行於世。弟憲自有傳。","subject_person_mention_id":"c-chenshu-017-yuanshu-complete:p004:m0124","object_person_mention_id":"c-chenshu-017-yuanshu-complete:p004:m0206"}],"status":"source_attested","interpretation_note":"樞之弟憲，與卷二十四首呼應。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"a-chen017-xian-father","subject_person_id":"6qj_3sw_6fo","object_person_id":"hb9_2gq_205_A","predicate":"father","qualifiers":{"source_term":"憲父君正","lineage":"paternal"},"evidence":[{"work_id":"w-chenshu","book_id":"b-chenshu-024","chapter_id":"c-chenshu-024-yuanshu-xian","source_id":"s-chenshu-024-yuanshu-xian-ws1494985","paragraph_id":"c-chenshu-024-yuanshu-xian:p002","quote":"憲父君正曰：","subject_person_mention_id":"c-chenshu-024-yuanshu-xian:p002:m0000","object_person_mention_id":"c-chenshu-024-yuanshu-xian:p002:m0002"}],"status":"source_attested","interpretation_note":"明書憲父君正，與袁樞傳互校。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":