":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-gaosengzhuan","book_id":"b-gaosengzhuan-010","source_id":"s-gaosengzhuan-010-baozhi-wangyun-cbeta2026r2","chapter_id":"c-gaosengzhuan-010-baozhi-wangyun","paragraph_id":"c-gaosengzhuan-010-baozhi-wangyun:p002","quote":"誌知名顯奇四十餘載，士女恭事者數不可稱。至天監十三年冬，於臺後堂謂人曰：「菩薩將去。」未及旬日，無疾而終。屍骸香軟，形貌熙悅。臨亡然一燭，以付後閣舍人吳慶。慶即啟聞。上歎曰：「大師不復留矣。燭者，將以後事屬我乎？」因厚加殯送，葬于鍾山獨龍之阜。仍於墓所立開善精舍。勅陸倕製銘辭於塚內，王筠勒碑文於寺門。傳其遺像，處處存焉。","person_mention_id":"c-gaosengzhuan-010-baozhi-wangyun:p002:m0075"}],"status":"source_attested","interpretation_note":"臨亡受燭啟聞者當時官稱。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-gaosengzhuan-010-baozhi-wangyun:p002","text":"誌知名顯奇四十餘載，士女恭事者數不可稱。至天監十三年冬，於臺後堂謂人曰：「菩薩將去。」未及旬日，無疾而終。屍骸香軟，形貌熙悅。臨亡然一燭，以付後閣舍人吳慶。慶即啟聞。上歎曰：「大師不復留矣。燭者，將以後事屬我乎？」因厚加殯送，葬于鍾山獨龍之阜。仍於墓所立開善精舍。勅陸倕製銘辭於塚內，王筠勒碑文於寺門。傳其遺像，處處存焉。","mentions":[{"id":"c-gaosengzhuan-010-baozhi-wangyun:p002:m0000","person_id":"bpy_73i_0yy","start":0,"end":1,"surface":"誌","kind":"person","status":"contextual_provisional","interpretation_note":"依原句明名及所屬傳文。"},{"id":"c-gaosengzhuan-010-baozhi-wangyun:p002:m0075","person_id":"en2_l97_t8b","start":75,"end":77,"surface":"吳慶","kind":"person","status":"contextual_provisional","interpretation_note":"依原句明名及所屬傳文。"},{"id":"c-gaosengzhuan-010-baozhi-wangyun:p002:m0078","person_id":"en2_l97_t8b","start":78,"end":79,"surface":"慶","kind":"person","status":"contextual_provisional","interpretation_note":"依原句明名及所屬傳文。"},{"id":"c-gaosengzhuan-010-baozhi-wangyun:p002:m0133","person_id":"war_qdw_fs5","start":133,"end":135,"surface":"陸倕","kind":"person","status":"contextual_provisional","interpretation_note":"依原句明名及所屬傳文。"},{"id":"c-gaosengzhuan-010-baozhi-wangyun:p002:m0142","person_id":"mxz_qw8_acd_A","start":142,"end":