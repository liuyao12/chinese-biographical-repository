[{"chapter_id":"c-shiji-038-song","source_id":"s-shiji-038-song","paragraph_id":"c-shiji-038-song:p048","quote":"宋城中急，无食，華元乃夜私見楚將子反。"}],"attestations":[{"id":"th-shiji038-054:a001","paragraph_id":"c-shiji-038-song:p048","start":55,"end":56,"surface":"將","person_mention_id":"c-shiji-038-song:m048-0054","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"楚將子反本段用稱，與吳篇子反另候選待對讀，不推初任。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji038-094","person_id":"4bx_elr_66i","surfaces":["子反","楚將子反"],"scope":"same_chapter","chapter_ids":["c-shiji-038-song"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-038-song:p048","quote":"十六年，楚使過宋，宋有歬仇，執楚使。九月，楚莊王圍宋。十七年，楚以圍宋五月不解，宋城中急，无食，華元乃夜私見楚將子反。子反告莊王。王問：「城中何如？」曰：「析骨而炊，易子而食。」莊王曰：「誠哉言！我軍亦有二日糧。」以信故，遂罷兵去。"}],"rationale":"按本篇明示名與稱號、宋國世系及具體事件暫同指；未把同字短名全域合併，所有引句與未定處保留。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-034-yanghu:p013","text":"祜與陸抗相對，使命交通，抗稱祜之德量，雖樂毅、諸葛孔明不能過也。抗嘗病，祜饋之藥，抗服之無疑心。人多諫抗，抗曰：「羊祜豈鴆人者！」時談以為華元、子反復見於今日。抗每告其戍曰：「彼專為德，我專為暴，是不戰而自服也。各保分界而已，無求細利。」孫皓聞二境交和，以詰抗。抗曰：「一邑一鄉，不可以無信義，況大國乎！臣不如此，正是彰其德，於祜無傷也。」","text_layer":"received_chapter","source_position":{"raw_start":2250,"raw_end":2422,"raw_character_offsets":[2252,2253,2254,2255,2256,2257,2258,2259,2260,2261,2262,2263,2264,2265,2266,2267,2268,2269,2270,2271,2272,2273,2274,2275,2276,2277,2278,2279,2280,2281,2282,2283,2284,2285,2286,2287,2288,2289,2290,2291,2292,2293,2294,2295,2296,2297,2298,2299,2300,2301,2302,2303,2304,2305,2306,2307,2308,2309,2310,2311,2312,2313,2314,2315,2316,2317,2318,2319,2320,2321,2322,2323,2324,2325,2326,2327,2328,2329,2330,2331,2332,2333,2334,2335,2336,2337,2338,2339,2340,2341,2342,2343,2344,2345,2346,2347,2348,234