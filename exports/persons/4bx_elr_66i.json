-song"}],"relations":[],"title_holdings":[{"id":"th-shiji038-054","person_id":"4bx_elr_66i","title":"將","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-038-song","source_id":"s-shiji-038-song","paragraph_id":"c-shiji-038-song:p048","quote":"宋城中急，无食，華元乃夜私見楚將子反。"}],"attestations":[{"id":"th-shiji038-054:a001","paragraph_id":"c-shiji-038-song:p048","start":55,"end":56,"surface":"將","person_mention_id":"c-shiji-038-song:m048-0054","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"楚將子反本段用稱，與吳篇子反另候選待對讀，不推初任。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-jin034-zi-fan-ancient","person_id":"4bx_elr_66i","surfaces":["子反"],"scope":"cross_chapter","chapter_ids":["c-jinshu-034-yanghu-comparison","c-shiji-038-song"],"status":"contextual_provisional","confidence_level":"high","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-034","source_id":"s-jinshu-034-yanghu-ws2567662-rendered-comparison","chapter_id":"c-jinshu-034-yanghu-comparison","paragraph_id":"c-jinshu-034-yanghu-comparison:p013","quote":"祜與陸抗相對，使命交通，抗稱祜之德量，雖樂毅、諸葛孔明不能過也。抗嘗病，祜饋之藥，抗服之無疑心。人多諫抗，抗曰：「羊祜豈鴆人者！」時談以為華元、子反復見於今日。抗每告其戍曰：「彼專為德，我專為暴，是不戰而自服也。各保分界而已，無求細利。」孫皓聞二境交和，以詰抗。抗曰：「一邑一鄉，不可以無信義，況大國乎！臣不如此，正是彰其德，於祜無傷也。」","mention_ids":["c-jinshu-034-yanghu-comparison:p013:m0072"]},{"work_id":"w-shiji","book_id":"b-shiji-038","source_id":"s-shiji-038-song","chapter_id":"c-shiji-038-song","paragraph_id":"c-shiji-038-song:p048","quote":"十六年，楚使過宋，宋有歬仇，執楚使。九月，楚莊王圍宋。十七年，楚以圍宋五月不解，宋城中急，无食，華元乃夜私見楚將子反。子反告莊王。王問：「城中何如？」曰：「析骨而炊，易子而食。」莊王曰：「誠哉言！我軍亦有二日糧。」以信故，遂罷兵去。","mention_ids":["c-shiji-038-song:m048-0054"]}],"rationale":"按完整本傳敘事/發言人與時層分流；本源角色與現役完整來源錨作有資格首選，不以相同單字或同稱號跨朝代自動合併。","human_reviewed":false