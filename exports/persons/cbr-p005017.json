92,"end":94,"surface":"王離","kind":"person","person_id":"cbr-p000575","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p012","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-007-xiangyu:m012-0117","start":117,"end":119,"surface":"王離","kind":"person","person_id":"cbr-p000575","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p012","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-008-gaozu:m015-0042","start":42,"end":44,"surface":"王離","kind":"person","person_id":"cbr-p000575","status":"contextual_provisional","paragraph_id":"c-shiji-008-gaozu:p015","chapter_id":"c-shiji-008-gaozu"},{"id":"c-shiji-008-gaozu:m018-0218","start":218,"end":220,"surface":"王離","kind":"person","person_id":"cbr-p000575","status":"contextual_provisional","paragraph_id":"c-shiji-008-gaozu:p018","chapter_id":"c-shiji-008-gaozu"},{"id":"c-shiji-008-gaozu:m021-0034","start":34,"end":36,"surface":"王離","kind":"person","person_id":"cbr-p000575","status":"contextual_provisional","paragraph_id":"c-shiji-008-gaozu:p021","chapter_id":"c-shiji-008-gaozu"},{"id":"c-shiji-089-zhanger:m015-0032","start":32,"end":34,"surface":"王離","kind":"person","person_id":"cbr-p005017","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p015","chapter_id":"c-shiji-089-zhanger"},{"id":"c-shiji-089-zhanger:m015-0071","start":71,"end":73,"surface":"王離","kind":"person","person_id":"cbr-p005017","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p015","chapter_id":"c-shiji-089-zhanger"},{"id":"c-shiji-089-zhanger:m015-0074","start":74,"end":76,"surface":"王離","kind":"person","person_id":"cbr-p005017","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p015","chapter_id":"c-shiji-089-zhanger"},{"id":"c-shiji-089-zhanger:m016-0052","start":52,"end":54,"surface":"王離","kind":"person","person_id":"cbr-p005017","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p016","chapter_id":"c-shiji-089-zhanger"},{"id":"c-shiji-089-zhanger:m016-0091","start":91,"end":93,"surface":"王離","kind":"person","person_id":"cbr-p005017","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p016","chapter_id":"c-shiji-089-zhanger"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji007-010","person_id":"cbr-p000575","surfaces":["王離"],"scope":"cross_chapter","chapter_ids":["c-shiji-006-shihuang","c-shiji-007-xiangyu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-006-shihuang:p030","quote":"維秦王兼有天下，立名為皇帝，乃撫東土，至于瑯邪。列侯武城侯王離、列侯通武侯王賁、倫侯建成侯趙亥、倫侯昌武侯成、倫侯武信侯馮毋擇、丞相隗林、丞相王綰、卿李斯、卿王戊、五大夫趙嬰、五大夫楊樛從，與議於海上。曰：「古之帝者，地不過千里，諸侯各守其封域，或朝或否，相侵暴亂，殘伐不止，猶刻金石，以自為紀。古之五帝三王，知教不同，法度不明，假威鬼神，以欺遠方，實不稱名，故不久長。其身未歿，諸侯倍叛，法令不行。今皇帝并一海內，以為郡縣，天下和平。昭明宗廟，體道行德，尊號大成。群臣相與誦皇帝功德，刻于金石，以為表經。」"},{"paragraph_id":"c-shiji-007-xiangyu:p009","quote":"章邯已破項梁軍，則以為楚地兵不足憂，乃渡河擊趙，大破之。當此時，趙歇為王，陳餘為將，張耳為相，皆走入鉅鹿城。章邯令王離、涉閒圍鉅鹿，章邯軍其南，筑甬道而輸之粟。陳餘為將，將卒數萬人而軍鉅鹿之北，此所謂河北之軍也。"},{"paragraph_id":"c-shiji-007-xiangyu:p012","quote":"項羽已殺卿子冠軍，威震楚國，名聞諸侯。乃遣當陽君、蒲將軍將卒二萬渡河，救鉅鹿。戰少利，陳餘復請兵。項羽乃悉引兵渡河，皆沈船，破釜甑，燒廬舍，持三日糧，以示士卒必死，無一還心。於是至則圍王離，與秦軍遇，九戰，絕其甬道，大破之，殺蘇角，虜王離。涉閒不降楚，自燒殺。當是時，楚兵冠諸侯。諸侯軍救鉅鹿下者十餘壁，莫敢縱兵。及楚擊秦，諸將皆從壁上觀。楚戰士無不一以當十，楚兵呼聲動天，諸侯軍無不人人惴恐。於是已破秦軍，項羽召見諸侯將，入轅門，無不膝行而前，莫敢仰視。項羽由是始為諸侯上將軍，諸侯皆屬焉。"}],"rationale":"前卷鉅鹿秦將王離與本卷圍城及被虜敘事相接。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji008-012","person_id":"cbr-p000575","surfaces":["王離"],"scope":"cross_chapter","chapter_ids":["c-shiji-006-shihuang","c-shiji-008-gaozu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-006-shihuang:p030","quote":"維秦王兼有天下，立名為皇帝，乃撫東土，至于瑯邪。列侯武城侯王離、列侯通武侯王賁、倫侯建成侯趙亥、倫侯昌武侯成、倫侯武信侯馮毋擇、丞相隗林、丞相王綰、卿李斯、卿王戊、五大夫趙嬰、五大夫楊樛從，與議於海上。曰：「古之帝者，地不過千里，諸侯各守其封域，或朝或否，相侵暴亂，殘伐不止，猶刻金石，以自為紀。古之五帝三王，知教不同，法度不明，假威鬼神，以欺遠方，實不稱名，故不久長。其身未歿，諸侯倍叛，法令不行。今皇帝并一海內，以為郡縣，天下和平。昭明宗廟，體道行德，尊號大成。群臣相與誦皇帝功德，刻于金石，以為表經。」"},{"paragraph_id":"c-shiji-008-gaozu:p015","quote":"章邯已破項梁軍，則以為楚地兵不足憂，乃渡河，北擊趙，大破之。當是之時，趙歇為王，秦將王離圍之鉅鹿城，此所謂河北之軍也。"},{"paragraph_id":"c-shiji-008-gaozu:p018","quote":"當是時，秦兵彊，常乘勝逐北，諸將莫利先入關。獨項羽怨秦破項梁軍，奮，願與沛公西入關。懷王諸老將皆曰：「項羽為人彊悍猾賊。項羽嘗攻襄城，襄城無遺類，皆阬之，諸所過無不殘滅。且楚數進取，前陳王、項梁皆敗。不如更遣長者扶義而西，告諭秦父兄。秦父兄苦其主久矣，今誠得長者往，毋侵暴，宜可下。今項羽彊悍，今不可遣。獨沛公素寬大長者，可遣。」卒不許項羽，而遣沛公西略地，收陳王、項梁散卒。乃道碭至成陽，與杠裏秦軍夾壁，破（魏）［秦］二軍。楚軍出兵擊王離，大破之。"},{"paragraph_id":"c-shiji-008-gaozu:p021","quote":"初，項羽與宋義北救趙，及項羽殺宋義，代為上將軍，諸將黥布皆屬，破秦將王離軍，降章邯，諸侯皆附。及趙高已殺二世，使人來，欲約分王關中。沛公以為詐，乃用張良計，使酈生、陸賈往說秦將，啗以利，因襲攻武關，破之。又與秦軍戰於藍田南，益張疑兵旗幟，諸所過毋得掠鹵，秦人喜，秦軍解，因大破之。又戰其北，大破之。乘勝，遂破之。"}],"rationale":"只在所列原句的秦末楚漢軍事／分封敘事內暫定同指；有前卷錨點時對讀相接事件，不把同名作全庫匹配規則，仍待異源覆核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji089-040","person_id":"cbr-p005017","scope":"same_chapter","chapter_ids":["c-shiji-089-zhanger"],"status":"contextual_provisional","rationale":"按明示姓名及局部語境承接；武臣與趙歇、張敖的趙王用稱限各段，張黡張黶按同行事件暫接但原字分存。未名者不補姓名。","reviewer":"Codex（AI 代理）","surfaces":["王離"],"evidence":[{"paragraph_id":"c-shiji-089-zhanger:p015","quote":"章邯引兵至邯鄲，皆徙其民河内，夷其城郭。張耳與趙王歇走入鉅鹿城，王離圍之。陳餘北收常山兵，得數萬人，軍鉅鹿北。章邯軍鉅鹿南棘原，筑甬道屬河，餉王離。王離兵食多，急攻鉅鹿。鉅鹿城中食盡兵少，張耳數使人召前陳餘，陳餘自度兵少，不敵秦，不敢前。數月，張耳大怒，怨陳餘，使張黶、陳澤往讓陳餘曰：「始吾與公爲刎頸交，今王與耳旦暮且死，而公擁兵數萬，不肯相救，安在其相爲死！茍必信，胡不赴秦軍倶死？且有十一二相全。」陳餘曰：「吾度前終不能救趙，徒盡亡軍。且餘所以不倶死，欲爲趙王、張君報秦。今必倶死，如以肉委餓虎，何益？」張黶、陳澤曰：「事已急，要以倶死立信，安知後慮！」陳餘曰：「吾死顧以爲無益。必如公言。」乃使五千人令張黶、陳澤先嘗秦軍，至皆沒。"},{"paragraph_id":"c-shiji-089-zhanger:p016","quote":"當是時，燕、齊、楚聞趙急，皆來救。張敖亦北收代兵，得萬餘人，來，皆壁餘旁，未敢撃秦。項羽兵數絶章邯甬道，王離軍乏食，項羽悉引兵渡河，遂破章邯。章邯引兵解，諸侯軍乃敢撃圍鉅鹿秦軍，遂虜王離。渉閒自殺。卒存鉅鹿者，楚力也。"}]}],"equivalence_decisions":[{"id":"eq-shiji089-wang","person_ids":["cbr-p000575","cbr-p005017"],"canonical_person_id":"cbr-p000575","scope":"cross_chapter","chapter_ids":["c-shiji-007-xiangyu","c-shiji-089-zhanger"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-007-xiangyu","source_id":"s-shiji-007-xiangyu","paragraph_id":"c-shiji-007-xiangyu:p012","quote":"項羽已殺卿子冠軍，威震楚國，名聞諸侯。乃遣當陽君、蒲將軍將卒二萬渡河，救鉅鹿。戰少利，陳餘復請兵。項羽乃悉引兵渡河，皆沈船，破釜甑，燒廬舍，持三日糧，以示士卒必死，無一還心。於是至則圍王離，與秦軍遇，九戰，絕其甬道，大破之，殺蘇角，虜王離。涉閒不降楚，自燒殺。當是時，楚兵冠諸侯。諸侯軍救鉅鹿下者十餘壁，莫敢縱兵。及楚擊秦，諸將皆從壁上觀。楚戰士無不一以當十，楚兵呼聲動天，諸侯軍無不人人惴恐。於是已破秦軍，項羽召見諸侯將，入轅門，無不膝行而前，莫敢仰視。項羽由是始為諸侯上將軍，諸侯皆屬焉。","mention_ids":["c-shiji-007-xiangyu:m012-0092","c-shiji-007-xiangyu:m012-0117"]},{"chapter_id":"c-shiji-089-zhanger","source_id":"s-shiji-089-zhanger","paragraph_id":"c-shiji-089-zhanger:p016","quote":"當是時，燕、齊、楚聞趙急，皆來救。張敖亦北收代兵，得萬餘人，來，皆壁餘旁，未敢撃秦。項羽兵數絶章邯甬道，王離軍乏食，項羽悉引兵渡河，遂破章邯。章邯引兵解，諸侯軍乃敢撃圍鉅鹿秦軍，遂虜王離。渉閒自殺。卒存鉅鹿者，楚力也。","mention_ids":["c-shiji-089-zhanger:m016-0052","c-shiji-089-zhanger:m016-0091"]}],"rationale":"王離鉅鹿受圍戰敗為諸侯所虜的事件相配。 各篇原字、原文與已發ID保留，同書不視為獨立見證；同指不確證所有紀年、任職、親屬或敘事，不按全域同名批量改號。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-006-shihuang:p030","text":"維秦王兼有天下，立名為皇帝，乃撫東土，至于瑯邪。列侯武城侯王離、列侯通武侯王賁、倫侯建成侯趙亥、倫侯昌武侯成、倫侯武信侯馮毋擇、丞相隗林、丞相王綰、卿李斯、卿王戊、五大夫趙嬰、五大夫楊樛從，與議於海上。曰：「古之帝者，地不過千里，諸侯各守其封域，或朝或否，相侵暴亂，殘伐不止，猶刻金石，以自為紀。古之五帝三王，知教不同，法度不明，假威鬼神，以欺遠方，實不稱名，故不久長。其身未歿，諸侯倍叛，法令不行。今皇帝并一海內，以為郡縣，天下和平。昭明宗廟，體道行德，尊號大成。群臣相與誦皇帝功德，刻于金石，以為表經。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:p030:m0011","start":11,"end":13,"surface":"皇帝","kind":"person","person_id":"cbr-p000533","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p030:m0024","start":24,"end":31,"surface":"列侯武城侯王離","kind":"person","person_id":"cbr-p000575","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p030:m0032","start":32,"end":39,"surface":"列侯通武侯王賁","kind":"person","person_id":"cbr-p000567","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p030:m0040","start":40,"end":47,"surface":"倫侯建成侯趙亥","kind":"person","person_id":"cbr-p000576","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p030:m0048","start":48,"end":54,"surface":"倫侯昌武侯成","kind":"person","person_id":"cbr-p000577","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p030:m0055","start":55,"end":63,"surface":"倫侯武信侯馮毋擇","kind":"person","person_id":"cbr-p000578","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p030:m0064","start":64,"end":68,"surface":"丞相隗林","kind":"person","person_id":"cbr-p000579","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p030:m0069","start":69,"end":73,"surface":"丞相王綰","kind":"person","person_id":"cbr-p000573","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p030:m0074","start":74,"end":77,"surface":"卿李斯","kind":"person","person_id":"cbr-p000537","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p030:m0078","start":78,"end":81,"surface":"卿王戊","kind":"person","person_id":"cbr-p000580","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p030:m0082","start":82,"end":87,"surface":"五大夫趙嬰","kind":"person","person_id":"cbr-p000581","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p030:m0088","start":88,"end":93,"surface":"五大夫楊樛","kind":"person","person_id":"cbr-p000582","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p030:m0150","start":150,"end":154,"surface":"五帝三王","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官號、神祇或未定指代；不補造人物或已知姓名。"},{"id":"c-shiji-006-shihuang:p030:m0201","start":201,"end":203,"surface":"皇帝","kind":"person","person_id":"cbr-p000533","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p030:m0238","start":238,"end":240,"surface":"皇帝","kind":"person","person_id":"cbr-p000533","status":"contextual_provisional"}],"chapter_id":"c-shiji-006-shihuang","book_id":"b-shiji-006","work_id":"w-shiji","source_id":"s-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:p061","text":"三年，章邯等將其卒圍鉅鹿，楚上將軍項羽將楚卒往救鉅鹿。冬，趙高為丞相，竟案李斯殺之。夏，章邯等戰數卻，二世使人讓邯，邯恐，使長史欣請事。趙高弗見，又弗信。欣恐，亡去，高使人捕追不及。欣見邯曰：「趙高用事於中，將軍有功亦誅，無功亦誅。」項羽急擊秦軍，虜王離，邯等遂以兵降諸侯。八月己亥，趙高欲為亂，恐群臣不聽，乃先設驗，持鹿獻於二世，曰：「馬也。」二世笑曰：「丞相誤邪？謂鹿為馬。」問左右，左右或默，或言馬以阿順趙高。或言鹿，高因陰中諸言鹿者以法。後群臣皆畏高。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:p061:m0003","start":3,"end":5,"surface":"章邯","kind":"person","person_id":"cbr-p000605","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p061:m0013","start":13,"end":19,"surface":"楚上將軍項羽","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p061:m0029","start":29,"end":31,"surface":"趙高","kind":"person","person_id":"cbr-p000535","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p061:m0037","start":37,"end":39,"surface":"李斯","kind":"person","person_id":"cbr-p000537","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p061:m0044","start":44,"end":46,"surface":"章邯","kind":"person","person_id":"cbr-p000605","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p061:m0051","start":51,"end":53,"surface":"二世","kind":"person","person_id":"cbr-p000534","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p061:m0056","start":56,"end":57,"surface":"邯","kind":"person","person_id":"cbr-p000605","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p061:m0058","start":58,"end":59,"surface":"邯","kind":"person","person_id":"cbr-p000605","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p061:m0064","start":64,"end":65,"surface":"欣","kind":"person","person_id":"cbr-p000606","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p061:m0068","start":68,"end":70,"surface":"趙高","kind":"person","person_id":"cbr-p000535","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p061:m0077","start":77,"end":78,"surface":"欣","kind":"person","person_id":"cbr-p000606","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p061:m0083","start":83,"end":84,"surface":"高","kind":"person","person_id":"cbr-p000535","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p061:m0091","start":91,"end":92,"surface":"欣","kind":"person","person_id":"cbr-p000606","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p061:m0093","start":93,"end":94,"surface":"邯","kind":"person","person_id":"cbr-p000605","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p061:m0097","start":97,"end":99,"surface":"趙高","kind":"person","person_id":"cbr-p000535","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p061:m0117","start":117,"end":119,"surface":"項羽","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p061:m0125","start":125,"end":127,"surface":"王離","kind":"person","person_id":"cbr-p000575","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p061:m0128","start":128,"end":129,"surface":"邯","kind":"person","person_id":"cbr-p000605","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p061:m0142","start":142,"end":144,"surface":"趙高","kind":"person","person_id":"cbr-p000535","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p061:m0163","start":163,"end":165,"surface":"二世","kind":"person","person_id":"cbr-p000534","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p061:m0173","start":173,"end":175,"surface":"二世","kind":"person","person_id":"cbr-p000534","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p061:m0191","start":191,"end":193,"surface":"左右","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、官稱或待核指代；未補姓名、闕代與親屬成員。"},{"id":"c-shiji-006-shihuang:p061:m0194","start":194,"end":196,"surface":"左右","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、官稱或待核指代；未補姓名、闕代與親屬成員。"},{"id":"c-shiji-006-shihuang:p061:m0205","start":205,"end":207,"surface":"趙高","kind":"person","person_id":"cbr-p000535","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p061:m0212","start":212,"end":213,"surface":"高","kind":"person","person_id":"cbr-p000535","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p061:m0228","start":228,"end":229,"surface":"高","kind":"person","person_id":"cbr-p000535","status":"contextual_provisional"}],"chapter_id":"c-shiji-006-shihuang","book_id":"b-shiji-006","work_id":"w-shiji","source_id":"s-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:p062","text":"高前數言「關東盜毋能為也」，及項羽虜秦將王離等鉅鹿下而前，章邯等軍數卻，上書請益助，燕、趙、齊、楚、韓、魏皆立為王，自關以東，大氐盡畔秦吏應諸侯，諸侯咸率其眾西鄉。沛公將數萬人已屠武關，使人私於高，高恐二世怒，誅及其身，乃謝病不朝見。二世夢白虎齧其左驂馬，殺之，心不樂，怪問占夢。卜曰：「涇水為祟。」二世乃齋於望夷宮，欲祠涇，沈四白馬。使使責讓高以盜賊事。高懼，乃陰與其婿咸陽令閻樂、其弟趙成謀曰：「上不聽諫，今事急，欲歸禍於吾宗。吾欲易置上，更立公子嬰。子嬰仁儉，百姓皆載其言。」使郎中令為內應，詐為有大賊，令樂召吏發卒，追劫樂母置高舍。遣樂將吏卒千餘人至望夷宮殿門，縛衛令仆射，曰：「賊入此，何不止？」衛令曰：「周廬設卒甚謹，安得賊敢入宮？」樂遂斬衛令，直將吏入，行射，郎宦者大驚，或走或格，格者輒死，死者數十人。郎中令與樂俱入，射上幄坐幃。二世怒，召左右，左右皆惶擾不鬬。旁有宦者一人，侍不敢去。二世入內，謂曰：「公何不蚤告我？乃至於此！」宦者曰：「臣不敢言，故得全。使臣蚤言，皆已誅，安得至今？」閻樂前即二世數曰：「足下驕恣，誅殺無道，天下共畔足下，足下其自為計。」二世曰：「丞相可得見否？」樂曰：「不可。」二世曰：「吾願得一郡為王。」弗許。又曰：「願為萬戶侯。」弗許。曰：「願與妻子為黔首，比諸公子。」閻樂曰：「臣受命於丞相，為天下誅足下，足下雖多言，臣不敢報。」麾其兵進。二世自殺。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:p062:m0000","start":0,"end":1,"surface":"高","kind":"person","person_id":"cbr-p000535","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p062:m0015","start":15,"end":17,"surface":"項羽","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p062:m0018","start":18,"end":22,"surface":"秦將王離","kind":"person","person_id":"cbr-p000575","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p062:m0029","start":29,"end":31,"surface":"章邯","kind":"person","person_id":"cbr-p000605","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p062:m0082","start":82,"end":84,"surface":"沛公","kind":"person","person_id":"cbr-p000602","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p062:m0097","start":97,"end":98,"surface":"高","kind":"person","person_id":"cbr-p000535","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p062:m0099","start":99,"end":100,"surface":"高","kind":"person","person_id":"cbr-p000535","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p062:m0101","start":101,"end":103,"surface":"二世","kind":"person","person_id":"cbr-p000534","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p062:m0117","start":117,"end":119,"surface":"二世","kind":"person","person_id":"cbr-p000534","status