tions":[],"title_holdings":[{"id":"th-shiji105-010","person_id":"nvm_7kp_nle","title":"陽虛侯相","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-105-bianque","source_id":"s-shiji-105-bianque","paragraph_id":"c-shiji-105-bianque:p022","quote":"陽虛侯相趙章病，召臣意。眾醫皆以為寒中，臣意診其脈曰：「迵風。」迵風者，飲食下嗌而輒出不留。法曰「五日死」，而後十日乃死。病得之酒。所以知趙章之病者，臣意切其脈，脈來滑，是內風氣也。飲食下嗌而輒出不留者，法五日死，皆為前分界法。後十日乃死，所以過期者，其人嗜粥，故中藏實，中藏實故過期。師言曰「安穀者過期，不安穀者不及期」。"}],"attestations":[{"id":"th-shiji105-010:a001","paragraph_id":"c-shiji-105-bianque:p022","start":0,"end":4,"surface":"陽虛侯相","person_mention_id":"c-shiji-105-bianque:m022-0004","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"保存原文用稱；唐安除為齊王侍醫記任命事件，其餘不以用稱推定任期起點。不以死亡補終點。王禹與高期依並列語法共繫太醫，陽虛侯相與家丞是官職而非本人封侯。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji105-037","person_id":"nvm_7kp_nle","surfaces":["趙章"],"scope":"same_chapter","chapter_ids":["c-shiji-105-bianque"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-105-bianque:p022","quote":"陽虛侯相趙章病，召臣意。眾醫皆以為寒中，臣意診其脈曰：「迵風。」迵風者，飲食下嗌而輒出不留。法曰「五日死」，而後十日乃死。病得之酒。所以知趙章之病者，臣意切其脈，脈來滑，是內風氣也。飲食下嗌而輒出不留者，法五日死，皆為前分界法。後十日乃死，所以過期者，其人嗜粥，故中藏實，中藏實故過期。師言曰「安穀者過期，不安穀者不及期」。"}],"rationale":"依本篇姓名、原稱及敘事回指暫定；醫案引語與附載注釋分層，未按同名自動跨篇合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-105-bianque:p022","text":"陽虛侯相趙章病，召臣意。眾醫皆以為寒中，臣意診其脈曰：「迵風。」迵風者，飲食下嗌而輒出不留。法曰「五日死」，而後十日乃死。病得之酒。所以知趙章之病者，臣意切其脈，脈來滑，是內風氣也。飲食下嗌而輒出不留者，法五日死，皆為前分界法。後十日乃死，所以過期者，其人嗜粥，故中藏實，中藏實故過期。師言曰「安穀者過期，不安穀者不及期」。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-105-bianque:m022-0004","start":4,"end":6,"surface":"趙章","kind":"person","person_id":"nvm_7kp_nle","status"