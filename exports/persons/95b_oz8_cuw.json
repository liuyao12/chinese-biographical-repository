iginal_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-043-shanjian:line056:m0024","start":24,"end":26,"surface":"王萬","kind":"person","person_id":"95b_oz8_cuw","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-043-shanjian:line056","chapter_id":"c-jinshu-043-shanjian"}],"relations":[],"title_holdings":[{"id":"th-w043-shanjian-20","person_id":"95b_oz8_cuw","title":"督護","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-043","chapter_id":"c-jinshu-043-shanjian","source_id":"s-jinshu-043-shanjian","paragraph_id":"c-jinshu-043-shanjian:line056","quote":"尋加督寧、益軍事。時劉聰入寇，京師危逼。簡遣督護王萬率師赴難，次於涅陽，為宛城賊王如所破，遂嬰城自守。及洛陽陷沒，簡又為賊嚴嶷所逼，乃遷于夏口。招納流亡，江、漢歸附。時華軼以江州作難，或勸簡討之。簡曰：「與彥夏舊友，為之惆悵。簡豈利人之機，以為功伐乎！」其篤厚如此。時樂府伶人避難，多奔沔漢，宴會之日，僚佐或勸奏之。簡曰：「社稷傾覆，不能匡救，有晉之罪人也，何作樂之有！」因流涕慷慨，坐者咸愧焉。年六十卒，追贈征南大將軍、儀同三司。子遐。","person_mention_id":"c-jinshu-043-shanjian:line056:m0024"}],"attestations":[{"id":"th-w043-shanjian-20:a","paragraph_id":"c-jinshu-043-shanjian:line056","start":22,"end":24,"surface":"督護","person_mention_id":"c-jinshu-043-shanjian:line056:m0024","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-043-shanjian:line056","text":"尋加督寧、益軍事。時劉聰入寇，京師危逼。簡遣督護王萬率師赴難，次於涅陽，為宛城賊王如所破，遂嬰城自守。及洛陽陷沒，簡又為賊嚴嶷所逼，乃遷于夏口。招納流亡，江、漢歸附。時華軼以江州作難，或勸簡討之。簡曰：「與彥夏舊友，為之惆悵。簡豈利人之機，以為功伐乎！」其篤厚如此。時樂府伶人避難，多奔沔漢，宴會之日，僚佐或勸奏之。簡曰：「社稷傾覆，不能匡救，有晉之罪人也，何作樂之有！」因流涕慷慨，坐者咸愧焉。年六十卒，追贈征南大將軍、儀同三司。子遐。","text_