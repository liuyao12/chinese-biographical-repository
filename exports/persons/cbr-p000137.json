{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000137","canonical_person_id":"42a_nv5_urq","id_aliases":["cbr-p000137"],"identity_policy":"contextual_provisional","person_ids":["42a_nv5_urq"],"persons":[{"id":"42a_nv5_urq","label":"妲己","status":"active","historicity":"historical_tradition","aliases":[{"surface":"妲己","mention_ids":["c-shiji-003-yin:m028-0065","c-shiji-003-yin:m028-0068","c-shiji-003-yin:m031-0166"]}],"evidence":[{"mention_id":"c-shiji-003-yin:m028-0065","chapter_id":"c-shiji-003-yin","paragraph_id":"c-shiji-003-yin:p028","quote":"妲己"},{"mention_id":"c-shiji-003-yin:m028-0068","chapter_id":"c-shiji-003-yin","paragraph_id":"c-shiji-003-yin:p028","quote":"妲己"},{"mention_id":"c-shiji-003-yin:m031-0166","chapter_id":"c-shiji-003-yin","paragraph_id":"c-shiji-003-yin:p031","quote":"妲己"}],"identity_note":"依《殷本紀》的特定敘事建立；個別史實及出土材料對應尚未覆核，不按同名跨卷合併。","review":"ai_provisional","id_aliases":["cbr-p000137"]}],"source_mention_summary":[{"source_id":"s-shiji-003-yin","work_id":"w-shiji","book_id":"b-shiji-003","chapter_id":"c-shiji-003-yin","mention_count":3,"mention_ids":["c-shiji-003-yin:m028-0065","c-shiji-003-yin:m028-0068","c-shiji-003-yin:m031-0166"],"paragraph_ids":["c-shiji-003-yin:p028","c-shiji-003-yin:p031"],"passage_count":2}],"most_mentioned_source_ids":["s-shiji-003-yin"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-003-yin:m028-0065","start":65,"end":67,"surface":"妲己","kind":"person","person_id":"42a_nv5_urq","status":"source_identified","paragraph_id":"c-shiji-003-yin:p028","chapter_id":"c-shiji-003-yin"},{"id":"c-shiji-003-yin:m028-0068","start":68,"end":70,"surface":"妲己","kind":"person","person_id":"42a_nv5_urq","status":"source_identified","paragraph_id":"c-shiji-003-yin:p028","chapter_id":"c-shiji-003-yin"},{"id":"c-shiji-003-yin:m031-0166","start":166,"end":168,"surface":"妲己","kind":"person","person_id":"42a_nv5_urq","status":"source_identified","paragraph_id":"c-shiji-003-yin:p031","chapter_id":"c-shiji-003-yin"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-003-yin:p028","text":"帝紂資辨捷疾，聞見甚敏；材力過人，手格猛獸；知足以距諫，言足以飾非；矜人臣以能，高天下以聲，以為皆出己之下。好酒淫樂，嬖於婦人。愛妲己，妲己之言是從。於是使師涓作新淫聲，北里之舞，靡靡之樂。厚賦稅以實鹿臺之錢，而盈鉅橋之粟。益收狗馬奇物，充仞宮室。益廣沙丘苑臺，多取野獸蜚鳥置其中。慢於鬼神。大㝡樂戲於沙丘，以酒為池，縣肉為林，使男女倮相逐其閒，為長夜之飲。","mentions":[{"id":"c-shiji-003-yin:m028-0000","start":0,"end":2,"surface":"帝紂","kind":"person","person_id":"lwx_9yq_ad7","status":"source_identified"},{"id":"c-shiji-003-yin:m028-0065","start":65,"end":67,"surface":"妲己","kind":"person","person_id":"42a_nv5_urq","status":"source_identified"},{"id":"c-shiji-003-yin:m028-0068","start":68,"end":70,"surface":"妲己","kind":"person","person_id":"42a_nv5_urq","status":"source_identified"},{"id":"c-shiji-003-yin:m028-0078","start":78,"end":80,"surface":"師涓","kind":"person","person_id":"pda_eev_m2h","status":"source_identified"}],"chapter_id":"c-shiji-003-yin","book_id":"b-shiji-003","work_id":"w-shiji","source_id":"s-shiji-003-yin"},{"id":"c-shiji-003-yin:p031","text":"紂愈淫亂不止。微子數諫不聽，乃與大師、少師謀，遂去。比干曰：「為人臣者，不得不以死爭。」迺強諫紂。紂怒曰：「吾聞聖人心有七竅。」剖比干，觀其心。箕子懼，乃詳狂為奴，紂又囚之。殷之大師、少師乃持其祭樂器奔周。周武王於是遂率諸侯伐紂。紂亦發兵距之牧野。甲子日，紂兵敗。紂走，入登鹿臺，衣其寶玉衣，赴火而死。周武王遂斬紂頭，縣之大白旗。殺妲己。釋箕子之囚，封比干之墓，表商容之閭。封紂子武庚祿父，以續殷祀，令修行盤庚之政。殷民大說。於是周武王為天子。其後世貶帝號，號為王。而封殷後為諸侯，屬周。","mentions":[{"id":"c-shiji-003-yin:m031-0000","start":0,"end":1,"surface":"紂","kind":"person","person_id":"lwx_9yq_ad7","status":"source_identified"},{"id":"c-shiji-003-yin:m031-0007","start":7,"end":9,"surface":"微子","kind":"person","person_id":"buv_igi_gpn_A","status":"source_identified"},{"id":"c-shiji-003-yin:m031-0016","start":16,"end":18,"surface":"大師","kind":"unresolved","person_id":null,"status":"unresolved","note":"氏族、群體、官稱或未定個人指代；不由熟知故事補出姓名。"},{"id":"c-shiji-003-yin:m031-0019","start":19,"end":21,"surface":"少師","kind":"unresolved","person_id":null,"status":"unresolved","note":"氏族、群體、官稱或未定個人指代；不由熟知故事補出姓名。"},{"id":"c-shiji-003-yin:m031-0026","start":26,"end":28,"surface":"比干","kind":"person","person_id":"xtq_oi8_w82","status":"source_identified"},{"id":"c-shiji-003-yin:m031-0047","start":47,"end":48,"surface":"紂","kind":"person","person_id":"lwx_9yq_ad7","status":"source_identified"},{"id":"c-shiji-003-yin:m031-0049","start":49,"end":50,"surface":"紂","kind":"person","person_id":"lwx_9yq_ad7","status":"source_identified"},{"id":"c-shiji-003-yin:m031-0065","start":65,"end":67,"surface":"比干","kind":"person","person_id":"xtq_oi8_w82","status":"source_identified"},{"id":"c-shiji-003-yin:m031-0072","start":72,"end":74,"surface":"箕子","kind":"person","person_id":"8a9_tj8_6i7","status":"source_identified"},{"id":"c-shiji-003-yin:m031-0082","start":82,"end":83,"surface":"紂","kind":"person","person_id":"lwx_9yq_ad7","status":"source_identified"},{"id":"c-shiji-003-yin:m031-0089","start":89,"end":91,"surface":"大師","kind":"unresolved","person_id":null,"status":"unresolved","note":"氏族、群體、官稱或未定個人指代；不由熟知故事補出姓名。"},{"id":"c-shiji-003-yin:m031-0092","start":92,"end":94,"surface":"少師","kind":"unresolved","person_id":null,"status":"unresolved","note":"氏族、群體、官稱或未定個人指代；不由熟知故事補出姓名。"},{"id":"c-shiji-003-yin:m031-0103","start":103,"end":106,"surface":"周武王","kind":"person","person_id":"y4i_pjk_4gn_AA","status":"source_identified"},{"id":"c-shiji-003-yin:m031-0113","start":113,"end":114,"surface":"紂","kind":"person","person_id":"lwx_9yq_ad7","status":"source_identified"},{"id":"c-shiji-003-yin:m031-0115","start":115,"end":116,"surface":"紂","kind":