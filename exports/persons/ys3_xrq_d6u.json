發兵距險，使徇北將軍守武林，敗樓船軍數校尉，殺長吏。樓船將軍率錢唐轅終古斬徇北將軍，為御兒侯。自兵未往。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-114-dongyue:m008-0000","start":0,"end":2,"surface":"餘善","kind":"person","person_id":"ub3_zen_skw","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m008-0004","start":4,"end":6,"surface":"武帝","person_id":"ub3_zen_skw","kind":"person","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m008-0019","start":19,"end":21,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m008-0026","start":26,"end":28,"surface":"韓說","kind":"person","person_id":"l9e_fbr_36a_*AB*B","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m008-0039","start":39,"end":43,"surface":"樓船將軍","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m008-0043","start":43,"end":45,"surface":"楊仆","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m008-0051","start":51,"end":54,"surface":"王溫舒","kind":"person","person_id":"6ym_eva_k4a","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m008-0061","start":61,"end":63,"surface":"戈船","kind":"person","person_id":"ys3_xrq_d6u","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m008-0064","start":64,"end":66,"surface":"下瀨","kind":"person","person_id":"905_rao_ff0","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m008-0096","start":96,"end":100,"surface":"徇北將軍","kind":"person","person_id":"u5g_scl_2bs","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m008-0105","start":105,"end":107,"surface":"樓船","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m008-0116","start":116,"end":120,"surface":"樓船將軍","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-114-dongyue:m008-0123","start":123