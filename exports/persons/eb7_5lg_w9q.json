":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-129-huozhi:p008","text":"子贛既學於仲尼，退而仕於衛，廢著鬻財於曹、魯之閒，七十子之徒，賜最為饒益。原憲不厭糟糠，匿於窮巷。子貢結駟連騎，束帛之幣以聘享諸侯，所至，國君無不分庭與之抗禮。夫使孔子名布揚於天下者，子貢先後之也。此所謂得埶而益彰者乎？","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-129-huozhi:m008-0000","start":0,"end":2,"surface":"子贛","kind":"person","person_id":"eb7_5lg_w9q","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m008-0005","start":5,"end":7,"surface":"仲尼","kind":"person","person_id":"mil_8wg_ohj","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m008-0031","start":31,"end":32,"surface":"賜","kind":"person","person_id":"eb7_5lg_w9q","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m008-0037","start":37,"end":39,"surface":"原憲","kind":"person","person_id":"fuq_l6p_4ly","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m008-0049","start":49,"end":51,"surface":"子貢","kind":"person","person_id":"eb7_5lg_w9q","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m008-0082","start":82,"end":84,"surface":"孔子","kind":"person","person_id":"mil_8wg_ohj","status":"contextual_provisional"},{"id":"c-shiji-129-huozhi:m008-0092","start":92,"end":94,"surface":"子貢","kind":"person","person_id":"eb7_5lg_w9q","status":"contextual_provisional"}],"chapter_id":"c-shiji-129-huozhi","book_id":"b-shiji-129","work_id":"w-shiji","source_id":"s-shiji129-huozhi"}],"sources":[{"chapter_id":"c-shiji-129-huozhi","work_id":"w-shiji","book_id":"b-shiji-129","source_id":"s-shiji129-huozhi","source":{"title":"史記／卷129","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷129","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷129&oldid=7904128","revision_id":7904128,"accessed_on":"2026-10-11","extent":"固定修訂全文43段，篇文42段、索隱述贊1段。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversi