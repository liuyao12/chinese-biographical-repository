{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004836","identity_policy":"contextual_provisional","person_ids":["cbr-p004836"],"persons":[{"id":"cbr-p004836","label":"韓哀侯（刺客列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"韓哀侯","mention_ids":["c-shiji-086-cike:m014-0009"]}],"evidence":[{"mention_id":"c-shiji-086-cike:m014-0009","chapter_id":"c-shiji-086-cike","paragraph_id":"c-shiji-086-cike:p014","quote":"韓哀侯"}]}],"source_mention_summary":[{"source_id":"s-shiji-086-cike","work_id":"w-shiji","book_id":"b-shiji-086","chapter_id":"c-shiji-086-cike","mention_count":1,"mention_ids":["c-shiji-086-cike:m014-0009"],"paragraph_ids":["c-shiji-086-cike:p014"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-086-cike"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-086-cike:m014-0009","start":9,"end":12,"surface":"韓哀侯","kind":"person","person_id":"cbr-p004836","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p014","chapter_id":"c-shiji-086-cike"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji086-025","person_id":"cbr-p004836","scope":"same_chapter","chapter_ids":["c-shiji-086-cike"],"status":"contextual_provisional","rationale":"依聶政事與政姊榮明示姊弟承接，母與榮夫保留未名；韓君與哀侯暫不全域合併。臣妾君等對話指代仍待逐處核定。","reviewer":"Codex（AI 代理）","surfaces":["韓哀侯"],"evidence":[{"paragraph_id":"c-shiji-086-cike:p014","quote":"久之，濮陽嚴仲子事韓哀侯，與韓相俠累有卻。嚴仲子恐誅，亡去，游求人可以報俠累者。至齊，齊人或言聶政勇敢士也，避仇隱於屠者之閒。嚴仲子至門請，數反，然後具酒自暢聶政母前。酒酣，嚴仲子奉黃金百溢，前爲聶政母壽。聶政驚怪其厚，固謝嚴仲子。嚴仲子固進，而聶政謝曰：「臣幸有老母，家貧，客游以爲狗屠，可以旦夕得甘毳以養親。親供養備，不敢當仲子之賜。」嚴仲子辟人，因爲聶政言曰：「臣有仇，而行游諸侯衆矣；然至齊，竊聞足下義甚髙，故進百金者，將用爲大人麤糲之費，得以交足下之驩，豈敢以有求望邪！」聶政曰：「臣所以降志辱身居市井屠者，徒幸以養老母；老母在，政身未敢以許人也。」嚴仲子固讓，聶政竟不肯受也。然嚴仲子卒備賓主之禮而去。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-086-cike:p014","text":"久之，濮陽嚴仲子事韓哀侯，與韓相俠累有卻。嚴仲子恐誅，亡去，游求人可以報俠累者。至齊，齊人或言聶政勇敢士也，避仇隱於屠者之閒。嚴仲子至門請，數反，然後具酒自暢聶政母前。酒酣，嚴仲子奉黃金百溢，前爲聶政母壽。聶政驚怪其厚，固謝嚴仲子。嚴仲子固進，而聶政謝曰：「臣幸有老母，家貧，客游以爲狗屠，可以旦夕得甘毳以養親。親供養備，不敢當仲子之賜。」嚴仲子辟人，因爲聶政言曰：「臣有仇，而行游諸侯衆矣；然至齊，竊聞足下義甚髙，故進百金者，將用爲大人麤糲之費，得以交足下之驩，豈敢以有求望邪！」聶政曰：「臣所以降志辱身居市井屠者，徒幸以養老母；老母在，政身未敢以許人也。」嚴仲子固讓，聶政竟不肯受也。然嚴仲子卒備賓主之禮而去。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-086-cike:m014-0003","start":3,"end":8,"surface":"濮陽嚴仲子","kind":"person","person_id":"cbr-p004835","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m014-0009","start":9,"end":12,"surface":"韓哀侯","kind":"person","person_id":"cbr-p004836","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m014-0014","start":14,"end":18,"surface":"韓相俠累","kind":"person","person_id":"cbr-p004837","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m014-0021","start":21,"end":24,"surface":"嚴仲子","kind":"person","person_id":"cbr-p004835","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m014-0036","start":36,"end":38,"surface":"俠累","kind":"person","person_id":"cbr-p004837","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m014-0043","start":43,"end":45,"surface":"齊人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未定稱呼保持未解，不補姓名。"},{"id":"c-shiji-086-cike:m014-0047","start":47,"end":49,"surface":"聶政","kind":"person","person_id":"cbr-p004834","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m014-0063","start":63,"end":66,"surface":"嚴仲子","kind":"person","person_id":"cbr-p004835","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m014-0079","start":79,"end":82,"surface":"聶政母","kind":"person","person_id":"cbr-p004833","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m014-0087","start":87,"end":90,"surface":"嚴仲子","kind":"person","person_id":"cbr-p004835","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m014-0098","start":98,"end":101,"sur