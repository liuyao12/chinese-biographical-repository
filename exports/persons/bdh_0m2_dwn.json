entions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-059-he:line032:m0231","start":231,"end":233,"surface":"陳正","kind":"person","person_id":"bdh_0m2_dwn","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-059-he:line032","chapter_id":"c-sanguozhi-059-he"},{"id":"c-sanguozhi-059-he:line032:m0275","start":275,"end":276,"surface":"正","kind":"person","person_id":"bdh_0m2_dwn","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-059-he:line032","chapter_id":"c-sanguozhi-059-he"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-059-he:line032","text":"是後王夫人與全公主有隙。權嘗寢疾，和祠祭於廟，和妃叔父張休居近廟，邀和過所居。全公主使人覘視，因言太子不在廟中，專就妃家計議；又言王夫人見上寢疾，有喜色。權由是發怒，夫人憂死，而和寵稍損，懼於廢黜。魯王霸覬覦滋甚，陸遜、吾粲、顧譚等數陳適庶之義，理不可奪，全寄、楊笁爲魯王霸支黨，譖愬日興。粲遂下獄誅，譚徙交州。權沈吟者歷年，後遂幽閉和。於是驃騎將軍朱據、尚書僕射屈晃率諸將吏泥頭自縛，連日詣闕請和。權登白爵觀見，甚惡之，勑據、晃等無事忩忩。權欲廢和立亮，無難督陳正、五營督陳象上書，稱引晉獻公殺申生，立奚齊，晉國擾亂，又據、晃固諫不止。權大怒，族誅正、象，據、晃牽入殿，杖一百，竟徙和於故鄣，羣司坐諫誅放者十數。衆咸冤之。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-059-he:line032:m0002","start":2,"end":5,"surface":"王夫人","kind":"person","person_id":"rtv_1n1_nx2","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line032:m0006","start":6,"end":9,"surface":"全