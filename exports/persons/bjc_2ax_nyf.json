cal_mention_id":"c-nanqishu-058-southern-and-eastern-complete:p016:m0346","mention_ids":["c-nanqishu-058-southern-and-eastern-complete:p016:m0346"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-058-southern-and-eastern-complete:p016:m0350","mention_ids":["c-nanqishu-058-southern-and-eastern-complete:p016:m0350"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-058-southern-and-eastern-complete:p017:m0019","mention_ids":["c-nanqishu-058-southern-and-eastern-complete:p017:m0019"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-058-southern-and-eastern-complete:p017:m0054","mention_ids":["c-nanqishu-058-southern-and-eastern-complete:p017:m0054"],"kind":"paragraph"}],"mention_count":6,"duplicate_mention_count":0,"paragraph_occurrence_count":6,"table_occurrence_count":0,"passage_count":2,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"6處獨立位置，6個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-nanqishu-058-southern-and-eastern-complete-ws2638629"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-nanqishu-058-southern-and-eastern-complete:source_review16-0","kind":"source_review","person_id":"bjc_2ax_nyf","source_quote":"牟大又表曰：「臣所遣行建威將軍、廣陽太守、兼長史臣高達，行建威將軍、朝鮮太守、兼司馬臣楊茂，行宣威將軍、兼參軍臣會邁等三人，志行清亮，忠款夙著。往泰始中，比使宋朝，今任臣使，冒涉波險，尋其至効，宜在進爵，謹依先例，各假行職。且玄澤靈休，萬里所企，況親趾天庭，乃不蒙賴。伏願天監特愍除正。達邊効夙著，勤勞公務，今假行龍驤將軍、帶方太守。茂志行清壹，公務不廢，今假行建威將軍、廣陵太守。（萬）〔邁〕執志周密，屢致勤効，今假行廣武將軍、清河太守。」詔可，竝賜軍號，除太守。為使持節、都督百濟諸軍事、鎮東大將軍。使兼謁者僕射孫副策命大襲亡祖父牟都為百濟王。曰：「於戲！惟爾世襲忠懃，誠著遐表，滄路肅澄，要貢無替。式循彝典，用纂顯命。往欽哉！其敬膺休業，可不慎歟！制詔行都督百濟諸軍事、鎮東大將軍百濟王牟大今以大襲祖父牟都為百濟王，即位章綬等玉銅虎竹符四。〔王〕其拜受，不亦休乎！」","reading":"牟大第二表所舉三人假署與朝廷詔可分辨。其襲祖父牟都的策命另有孫副及文書。","note":"牟大第二表所舉三人假署與朝廷詔可分辨。其襲祖父牟都的策命另有孫副及文書。","paragraph_id":"c-nanqishu-058-southern-and-eastern-complete:p016","start_codepoint":0,"end_codepoint":386,"human_reviewed":false,"chapter_id":"c-nanqishu-058-southern-and-eastern-complete","source_id":"s-nanqishu-058-southern-and-eastern-complete-ws2638629"},{"id":"c-nanqishu-058-southern-and-eastern-complete:source_review17-0","kind":"source_review","person_id":"bjc_2ax_nyf","source_quote":"是歲，魏虜又發騎數十萬攻百濟，入其界，牟大遣將沙法名、贊首流、解禮昆、木干那率眾襲擊虜軍，大破之。建武二年，牟大遣使上表曰：「臣自昔受封，世被朝榮，忝荷節鉞，剋攘列辟。往姐瑾等竝蒙光除，臣庶咸泰。去庚午年，獫狁弗悛，舉兵深逼。臣遣沙法名等領軍逆討，宵襲霆擊，匈梨張惶，崩若海蕩。乘奔追斬，僵尸丹野。由是摧其銳氣，鯨暴韜凶。今邦宇謐靜，實名等之略，尋其功勳，宜在褒顯。今假沙法名行征虜將軍、邁羅王，贊首流為行安國將軍、辟中王，解禮昆為行武威將軍、弗中侯，木干那前有軍功，又拔臺舫，為行廣威將軍、面中侯。伏願天恩特愍聽除。」又表曰：「臣所遣行龍驤將軍、樂浪太守兼長史臣慕遺，行建武將軍、城陽太守兼司馬臣王茂，兼參軍、行振武將軍、朝鮮太守臣張塞，行揚武將軍陳明，在官忘私，唯公是務，見危授命，蹈難弗顧。今任臣使，冒涉波險，盡其至誠。實宜進爵，各假行署。伏願聖朝特賜除正。」詔可，竝賜軍號。","reading":"建武二年表回述庚午之戰。四將戰功與後一表使臣假署是不同人組。","note":"建武二年表回述庚午之戰。四將戰功與後一表使臣假署是不同人組。","paragraph_id":"c-nanqishu-058-southern-and-eastern-complete:p017","start_codepoint":0,"end_codepoint":391,"human_reviewed":false,"chapter_id":"c-nanqishu-058-southern-and-eastern-complete","source_id":"s-nanqishu-058-southern-and-eastern-complete-ws2638629"},{"id":"c-nanqishu-058-southern-and-eastern-complete:variant_review15-61","kind":"variant_review","person_id":"bjc_2ax_nyf","source_quote":"報功勞勤，實存名烈","reading":"缺頁之後才是百濟殘表，姐瑾、餘古、餘歷、餘固各按假署，不和前文高麗封爵相串。","note":"缺頁之後才是百濟殘表，姐瑾、餘古、餘歷、餘固各按假署，不和前文高麗封爵相串。","paragraph_id":"c-nanqishu-058-southern-and-eastern-complete:p015","start_codepoint":61,"end_codepoint":70,"human_reviewed":false,"chapter_id":"c-nanqishu-058-southern-and-eastern-complete","source_id":"s-nanqishu-058-southern-and-eastern-complete-ws2638629"},{"id":"c-nanqishu-058-southern-and-eastern-complete:variant_review16-252","kind":"variant_review","person_id":"bjc_2ax_nyf","source_quote":"使兼謁者僕射孫副策命大襲亡祖父牟都為百濟王","reading":"牟大與牟都祖孫按策書；文中假署與朝廷所授分辨。注引冊府元龜作牟太。","note":"牟大與牟都祖孫按策書；文中假署與朝廷所授分辨。注引冊府元龜作牟太。","paragraph_id":"c-nanqishu-058-southern-and-eastern-complete:p016","start_codepoint":252,"end_codepoint":273,"human_reviewed":false,"chapter_id":"c-nanqishu-058-southern-and-eastern-complete","source_id":"s-nanqishu-058-southern-and-eastern-complete-ws2638629"},{"id":"c-nanqishu-058-southern-and-eastern-complete:variant_review17-98","kind":"variant_review","person_id":"bjc_2ax_nyf","source_quote":"去庚午年","reading":"建武二年百濟表所追記；只繫表文回述，勿當寫表當年。","note":"建武二年百濟表所追記；只繫表文回述，勿當寫表當年。","paragraph_id":"c-nanqishu-058-southern-and-eastern-complete:p017","start_codepoint":98,"end_codepoint":102,"human_reviewed":false,"chapter_id":"c-nanqishu-058-southern-and-eastern-complete","source_id":"s-nanqishu-058-southern-and-eastern-complete-ws2638629"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-qi058-mo-grandfather","subject_person_id":"bjc_2ax_nyf","object_person_id":"54i_377_f12","predicate":"grandfather","qualifiers":{"source_term":"亡祖父牟都","lineage":"paternal"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-058","chapter_id":"c-nanqishu-058-southern-and-eastern-complete","source_id":"s-nanqishu-058-southern-and-eastern-complete-ws2638629","paragraph_id":"c-nanqishu-058-southern-and-eastern-complete:p016","quote":"牟大又表曰：「臣所遣行建威將軍、廣陽太守、兼長史臣高達，行建威將軍、朝鮮太守、兼司馬臣楊茂，行宣威將軍、兼參軍臣會邁等三人，志行清亮，忠款夙著。往泰始中，比使宋朝，今任臣使，冒涉波險，尋其至効，宜在進爵，謹依先例，各假行職。且玄澤靈休，萬里所企，況親趾天庭，乃不蒙賴。伏願天監特愍除正。達邊効夙著，勤勞公務，今假行龍驤將軍、帶方太守。茂志行清壹，公務不廢，今假行建威將軍、廣陵太守。（萬）〔邁〕執志周密，屢致勤効，今假行廣武將軍、清河太守。」詔可，竝賜軍號，除太守。為使持節、都督百濟諸軍事、鎮東大將軍。使兼謁者僕射孫副策命大襲亡祖父牟都為百濟王。曰：「於戲！惟爾世襲忠懃，誠著遐表，滄路肅澄，要貢無替。式循彝典，用纂顯命。往欽哉！其敬膺休業，可不慎歟！制詔行都督百濟諸軍事、鎮東大將軍百濟王牟大今以大襲祖父牟都為百濟王，即位章綬等玉銅虎竹符四。〔王〕其拜受，不亦休乎！」","subject_person_mention_id":"c-nanqishu-058-southern-and-eastern-complete:p016:m0000","object_person_mention_id":"c-nanqishu-058-southern-and-eastern-complete:p016:m0267"}],"status":"source_attested","interpretation_note":"策書同段直稱亡祖父。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"