_id":"bjc_2ax_nyf","status":"contextual_provisional"},{"id":"c-nanqishu-058-southern-and-eastern-complete:p016:m0025","start":25,"end":27,"surface":"高達","kind":"person","person_id":"3e0_1zy_wg1","status":"contextual_provisional"},{"id":"c-nanqishu-058-southern-and-eastern-complete:p016:m0043","start":43,"end":45,"surface":"楊茂","kind":"person","person_id":"8nv_3pi_qo3","status":"contextual_provisional"},{"id":"c-nanqishu-058-southern-and-eastern-complete:p016:m0056","start":56,"end":58,"surface":"會邁","kind":"person","person_id":"k4l_cvo_3ze","status":"contextual_provisional"},{"id":"c-nanqishu-058-southern-and-eastern-complete:p016:m0258","start":258,"end":260,"surface":"孫副","kind":"person","person_id":"fkt_40p_ox2","status":"contextual_provisional"},{"id":"c-nanqishu-058-southern-and-eastern-complete:p016:m0262","start":262,"end":263,"surface":"大","kind":"person","person_id":"bjc_2ax_nyf","status":"contextual_provisional"},{"id":"c-nanqishu-058-southern-and-eastern-complete:p016:m0267","start":267,"end":269,"surface":"牟都","kind":"person","person_id":"54i_377_f12","status":"contextual_provisional"},{"id":"c-nanqishu-058-southern-and-eastern-complete:p016:m0346","start":346,"end":348,"surface":"牟大","kind":"person","person_id":"bjc_2ax_nyf","status":"contextual_provisional"},{"id":"c-nanqishu-058-southern-and-eastern-complete:p016:m0350","start":350,"end":351,"surface":"大","kind":"person","person_id":"bjc_2ax_nyf","status":"contextual_provisional"},{"id":"c-nanqishu-058-southern-and-eastern-complete:p016:m0354","start":354,"end":356,"surface":"牟都","kind":"person","person_id":"54i_377_f12","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-058-southern-and-eastern-complete","book_id":"b-nanqishu-058","work_id":"w-nanqishu","source_id":"s-nanqishu-058-southern-and-eastern-complete-ws2638629"},{"id":"c-nanqishu-058-southern-and-eastern-complete:p017","text":"是歲，魏虜又發騎數十萬攻百濟，入其界，牟大遣將沙法名、贊首流、解禮昆、木干那率眾襲擊虜軍，大破之。建武二年，牟大遣使上表曰：「臣自昔受封，世被朝榮，忝荷節鉞，剋攘列辟。往姐瑾等竝蒙光除，臣庶咸泰。去庚午年，獫狁弗悛，舉兵深逼。臣遣沙法名等領軍逆討，宵襲霆擊，匈梨張惶，崩若海蕩。乘奔追斬，僵尸丹野。由是摧其銳氣，鯨暴韜凶。今邦宇謐靜，實名等之略，尋其功勳，宜在褒顯。今假沙法名行征虜將軍、邁羅王，贊首流為行安國將軍、辟中王，解禮昆為行武威將軍、弗中侯，木干那前有軍功，又拔臺舫，為行廣威將軍、面中侯。伏願天恩特愍聽除。」又表曰：「臣所遣行龍驤將軍、樂浪太守兼長史臣慕遺，行建武將軍、城陽太守兼司馬臣王茂，兼參軍、行振武將軍、朝鮮太守臣張塞，行揚武將軍陳明，在官忘私，唯公是務，見危授命，蹈難弗顧。今任臣使，冒涉波險，盡其至誠。實宜進爵，各假行署。伏願聖朝特賜除正。」詔可，竝賜軍號。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":47,"last_line":47,"raw_start":3179,"raw_end":3653,"raw_character_offsets":[3179,3180,3181,3182,3183,3184,3185,3186,3187,3188,3189,3190,3191,3192,3193,3194,3195,3196,3197,3198,3199,3200,3201,3202,3203,3204,3205,3206,3207,3208,3209,3210,3211,3212,3213,3214,3215,3216,3217,3218,3219,3220,3221,3222,3223,3224,3225,3226,3227,3228,3229,3230,3231,3232,3233,3234,3235,3236,3237,3238,3239,3240,3241,3242,3243,3244,3245,3246,3247,3248,3249,3250,3251,3252,3253,3254,3255,3256,3257,3258,3259,3260,3261,3262,3263,3264,3265,3266,3267,3268,3269,3270,3271,3272,3273,3274,3275,3276,3277,3278,3279,3280,3281,3282,3283,3284,3285,3286,3287,3288,3289,3290,3291,3292,3293,3294,3295,3296,3297,3298,3299,3300,3301,3302,3303,3304,3305,3306,3307,3308,3309,3310,3311,3312,3396,3397,3398,3399,3400,3401,3402,3403,3404,3405,3406,3407,3408,3409,3410,3411,3412,3413,3414,3415,3416,3417,3418,3419,3420,3421,3422,3423,3424,3425,3426,3427,3428,3429,3430,3431,3432,3433,3434,3435,3436,3437,3438,3439,3440,3441,3442,3443,3444,3445,3446,3447,3448,3449,3450,3451,3452,3453,3454,3455,3456,3457,3458,3459,3460,3461,3462,3463,3464,3465,3466,3467,3468,3469,3470,3471,3472,3473,3474,3475,3476,3477,3478,3479,3480,3481,3482,3483,3484,3485,3486,3487,3488,3489,3490,3491,3492,3493,3494,3495,3496,3497,3498,3499,3500,3501,3502,3503,3504,3505,3506,3507,3508,3509,3510,3511,3512,3513,3514,3515,3516,3517,3518,3519,3520,3521,3522,3523,3524,3525,3526,3527,3528,3529,3530,3531,3532,3533,3534,3535,3536,3537,3538,3539,3540,3541,3542,3543,3544,3545,3546,3547,3548,3549,3550,3551,3552,3553,3554,3555,3556,3557,3558,3559,3560,3561,3562,3563,3564,3565,3566,3567,3568,3569,35