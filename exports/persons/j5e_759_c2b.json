{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"j5e_759_c2b","canonical_person_id":"j5e_759_c2b","id_aliases":["cbr-p003482"],"identity_policy":"contextual_provisional","person_ids":["j5e_759_c2b"],"persons":[{"id":"j5e_759_c2b","label":"姚卬（絳侯周勃世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"姚卬","mention_ids":["c-shiji-057-zhou:m003-0075"]}],"evidence":[{"mention_id":"c-shiji-057-zhou:m003-0075","chapter_id":"c-shiji-057-zhou","paragraph_id":"c-shiji-057-zhou:p003","quote":"姚卬"}],"id_aliases":["cbr-p003482"]}],"source_mention_summary":[{"source_id":"s-shiji-057-zhou","work_id":"w-shiji","book_id":"b-shiji-057","chapter_id":"c-shiji-057-zhou","mention_count":1,"mention_ids":["c-shiji-057-zhou:m003-0075"],"paragraph_ids":["c-shiji-057-zhou:p003"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-057-zhou"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-057-zhou:m003-0075","start":75,"end":77,"surface":"姚卬","kind":"person","person_id":"j5e_759_c2b","status":"contextual_provisional","paragraph_id":"c-shiji-057-zhou:p003","chapter_id":"c-shiji-057-zhou"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji057-015","person_id":"j5e_759_c2b","surfaces":["姚卬"],"scope":"same_chapter","chapter_ids":["c-shiji-057-zhou"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-057-zhou:p003","quote":"項羽至，以沛公為漢王。漢王賜勃爵為威武侯。從入漢中，拜為將軍。還定三秦，至秦，賜食邑懷德。攻槐裏、好畤，最。擊趙賁、內史保於咸陽，最。北攻漆。擊章平、姚卬軍。西定汧。還下郿、頻陽。圍章邯廢丘。破西丞。擊盜巴軍，破之。攻上邽。東守峣關。轉擊項籍。攻曲逆，最。還守敖倉，追項籍。籍已死，因東定楚地泗（川）［水］、東海郡，凡得二十二縣。還守雒陽、櫟陽，賜與潁（陽）［陰］侯共食鐘離。以將軍從高帝反者燕王臧荼，破之易下。所將卒當馳道為多。賜爵列侯，剖符世世勿絕。食絳八千一百八十戶，號絳侯。"}],"rationale":"按明示姓名、軍事近接、父子承爵與局部皇帝敘事暫接。周勃和勝之的絳侯分開，亞夫條侯與平曲支不混；代地韓信依韓王信近接而不接淮陰侯。未名人物、單名官員不補姓，校勘字不作定本，相術預言不作史實已驗。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-057-zhou:p003","text":"項羽至，以沛公為漢王。漢王賜勃爵為威武侯。從入漢中，拜為將軍。還定三秦，至秦，賜食邑懷德。攻槐裏、好畤，最。擊趙賁、內史保於咸陽，最。北攻漆。擊章平、姚卬軍。西定汧。還下郿、頻陽。圍章邯廢丘。破西丞。擊盜巴軍，破之。攻上邽。東守峣關。轉擊項籍。攻曲逆，最。還守敖倉，追項籍。籍已死，因東定楚地泗（川）［水］、東海郡，凡得二十二縣。還守雒陽、櫟陽，賜與潁（陽）［陰］侯共食鐘離。以將軍從高帝反者燕王臧荼，破之易下。所將卒當馳道為多。賜爵列侯，剖符世世勿絕。食絳八千一百八十戶，號絳侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-057-zhou:m003-0000","start":0,"end":2,"surface":"項羽","kind":"person","person_id":"qi8_m09_rfs","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m003-0005","start":5,"end":7,"surface":"沛公","kind":"person","person_id":"b9r_kwz_tnw","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m003-0008","start":8,"end":10,"surface":"漢王","kind":"person","person_id":"b9r_kwz_tnw","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m003-0011","start":11,"end":13,"surface":"漢王","kind":"person","person_id":"b9r_kwz_tnw","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m003-0014","start":14,"end":15,"surface":"勃","kind":"person","person_id":"ycd_ixa_ovp","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m003-0055","start":55,"end":57,"surface":"趙賁","kind":"person","person_id":"ha5_pra_1p1","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m003-0058","start":58,"end":61,"surface":"內史保","kind":"person","person_id":"rw2_ntu_kgz","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m003-0072","start":72,"end":74,"surface":"章平","kind":"person","person_id":"3zw_02o_knb","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m003-0075","start":75,"end":77,"surface"