ount":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-057-zhang-guang-ws2413329","s-jinshu-059-prince-yue-ws2650517"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-057-zhang-guang:p004:m0056","surface":"錢端","start":56,"end":58,"person_id":"q4l_0g7_9ay","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-057-zhang-guang:p004","chapter_id":"c-jinshu-057-zhang-guang"},{"id":"c-jinshu-059-prince-yue:p009:m0119","surface":"錢端","start":119,"end":121,"person_id":"q4l_0g7_9ay","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-059-prince-yue:p009","chapter_id":"c-jinshu-059-prince-yue"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-057-zhang-guang:p004","text":"陳敏作亂，除光順陽太守，加陵江將軍，率步騎五千詣荊州討之。刺史劉弘雅敬重光，稱為南楚之秀。時江夏太守陶侃與敏大將錢端相距於長岐，將戰，襄陽太守皮初為步軍，使光設伏以待之，武陵太守苗光為水軍，藏舟艦于沔水。皮初等與賊交戰，光發伏兵應之，水陸同奮，賊眾大敗。弘表光有殊勳，遷材官將軍，梁州刺史。先是，秦州人鄧定等二千餘家，饑餓流入漢中，保于成固，漸為抄盜，梁州刺史張殷遣巴西太守張燕討之。定窘急，偽乞降于燕，並饋燕金銀，燕喜，為之緩師。定密結李雄，雄遣眾救定，燕退，定遂進逼漢中。太守杜正沖東奔魏興，殷亦棄官而遁。光不得赴州，止于魏興，乃結諸郡守共謀進取。燕唱言曰：「漢中荒敗，迫近大賊，克復之事，當俟英雄。」正沖曰：「張燕受賊金銀，不時進討，阻兵緩寇，致喪漢中，實燕之罪也。」光於是發怒，呵燕令出，斬之以徇。綏撫荒殘，百姓悅服。光於是卻鎮漢中。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":86,"last_line":86,"raw_start":6747,"raw_end":7118,"raw_character_offsets":[6747,6748,6749,6750,6751,6752,6753,6754,6755,6756,6757,6758,6759,6760,6761,6762,6763,6764,6765,6766,6767,6768,6769,6770,6771,6772,6773,6774,6775,6776,6777,6778,6779,6780,6781,6782,6783,6784,6785,6786,6787,6788,6789,6790,6791,6792,6793,6794,6795,6796,6797,6798,6799,6800,6801,6802,6803,6804,6805,6806,6807,6808,6809,6810,6811,6812,6813,6814,6815,6816,6817,6818,6819,6820,6821,6822,6823,6824,6825,6826,6827,6828,6829,6830,6831,6832,6833,6834,6835,6836,6837,6838,6839,6840,6841,6842,6843,6844,6845,6846,6847,6848,6849,6850,6851,6852,6853,6854,6855,6856,6857,6858,6859,6860,6861,6862,6863,6864,6865,6866,6867,6868,6869,6870,6871,6872,6873,6874,6875,6876,6877,6878,6879,6880,6881,6882,6883,6884,6885,6886,6887,6888,6889,6890,6891,6892,6893,6894,6895,6896,6897,6898,6899,6900,6901,6902,6903,6904,6905,6906,6907,6908,6909,6910,6911,6912,6913,6914,6915,6916,6917,6918,6919,6920,6921,6922,6923,6924,6925,6926,6927,6928,6929,6930,6931,6932,6933,6934,6935,6936,6937,6938,6939,6940,6941,6942,6943,6944,6945,6946,6947,6948,6949,6950,6951,6952,6953,6954,6955,6956,6957,6958,6959,6960,6961,6962,6963,6964,6965,6966,6967,6968,6969,6970,6971,6972,6973,6974,6975,6976,6977,6978,6979,6980,6981,6982,6983,6984,6985,6986,6987,6988,6989,6990,6991,6992,6993,6994,6995,6996,6997,6998,6999,7000,7001,7002,7003,7004,7005,7006,7007,7008,7009,7010,7011,7012,7013,7014,7015,7016,7017,7018,7019,7020,7021,7022,7023,7024,7025,7026,7027,7028,7029,7030,7031,7032,7033,7034,7035,7036,7037,7038,7039,7040,7041,7042,7043,7044,7045,7046,7047,7048,7049,7050,7051,7052,7053,7054,7055,7056,7057,7058,7059,7060,7061,7062,7063,7064,7065,7066,7067,7068,7069,7070,7071,7072,7073,7074,7075,7076,7077,7078,7079,7080,7081,7082,7083,7084,708