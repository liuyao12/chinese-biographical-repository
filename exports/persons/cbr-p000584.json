c-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:p046:m0002","start":2,"end":4,"surface":"盧生","kind":"person","person_id":"cbr-p000584","status":"contextual_provisional","paragraph_id":"c-shiji-006-shihuang:p046","chapter_id":"c-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:p046:m0293","start":293,"end":295,"surface":"盧生","kind":"person","person_id":"cbr-p000584","status":"contextual_provisional","paragraph_id":"c-shiji-006-shihuang:p046","chapter_id":"c-shiji-006-shihuang"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-006-shihuang:p039","text":"三十二年，始皇之碣石，使燕人盧生求羨門、高誓。刻碣石門。壞城郭，決通隄防。其辭曰：","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:p039:m0005","start":5,"end":7,"surface":"始皇","kind":"person","person_id":"cbr-p000533","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p039:m0012","start":12,"end":16,"surface":"燕人盧生","kind":"person","person_id":"cbr-p000584","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p039:m0017","start":17,"end":19,"surface":"羨門","kind":"person","person_id":"cbr-p000585","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p039:m0020","start":20,"end":22,"surface":"高誓","kind":"person","person_id":"cbr-p000586","status":"contextual_provisional"}],"chapter_id":"c-shiji-006-shihuang","book_id":"b-shiji-006","work_id":"w-shiji","source_id":"s-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:p040","text":"因使韓終、侯公、石生求僊人不死之藥。始皇巡北邊，從上郡入。燕人盧生使入海還，以鬼神事，因奏錄圖書，曰「亡秦者胡也」。始皇乃使將軍蒙恬發兵三十萬人北擊胡，略取河南地。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:p040:m0002","start":2,"end":4,"surface":"韓終","kind":"person","person_id":"cbr-p000587","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p040:m0005","start":5,"end":7,"surface":"侯公","kind":"person","person_id":"cbr-p000588","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p040:m0008","start":8,"end":10,"surface":"石生","kind":"person","person_id":"cbr-p000589","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p040:m0011","start":11,"end":13,"surface":"僊人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱、神祇或未核指代，不能以後世故事補造姓名或合併。"},{"id":"c-shiji-006-shihuang:p040:m0018","start":18,"end":20,"surface":"始皇","kind":"person","person_id":"cbr-p000533","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p040:m0029","start":29,"end":33,"surface":"燕人盧生","kind":"person","person_id":"cbr-p000584","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p040:m0051","start":51,"end":55,"surface":"亡秦者胡","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱、神祇或未核指代，不能以後世故事補造姓名或合併。"},{"id":"c-shiji-006-shihuang:p040:m0058","start":58,"end":60,"surface":"始皇","kind":"person","person_id":"cbr-p000533","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p040:m0062","start":62,"end":66,"surface":"將軍蒙恬","kind":"person","person_id":"cbr-p000590","status":"contextual_provisional"}],"chapter_id":"c-shiji-006-shihuang","book_id":"b-shiji-006","work_id":"w-shiji","source_id":"s-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:p045","text":"盧生說始皇曰：「臣等求芝奇藥僊者常弗遇，類物有害之者。方中，人主時為微行以辟惡鬼，惡鬼辟，真人至。人主所居而人臣知之，則害於神。真人者，入水不濡，入火不爇，陵雲氣，與天地久長。今上治天下，未能恬倓。願上所居宮毋令人知，然後不死之藥殆可得也。」於是始皇曰：「吾慕真人，自謂『真人』，不稱『朕』。」乃令咸陽之旁二百里內宮觀二百七十復道甬道相連，帷帳鐘鼓美人充之，各案署不移徙。行所幸，有言其處者，罪死。始皇帝幸梁山宮，從山上見丞相車騎眾，弗善也。中人或告丞相，丞相後損車騎。始皇怒曰：「此中人泄吾語。」案問莫服。當是時，詔捕諸時在旁者，皆殺之。自是後莫知行之所在。聽事，群臣受決事，悉於咸陽宮。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:p045:m0000","start":0,"end":2,"surface":"盧生","kind":"person","person_id":"cbr-p000584","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p045:m0003","start":3,"end":5,"surface":"始皇","kind":"person","person_id":"cbr-p000533","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p045:m0045","start":45,"end":47,"surface":"真人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱、神祇或未核指代，不能以後世故事補造姓名或合併。"},{"id":"c-shiji-006-shihuang:p045:m0064","start":64,"end":66,"surface":"真人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱、神祇或未核指代，不能以後世故事補造姓名或合併。"},{"id":"c-shiji-006-shihuang:p045:m0088","start":88,"end":90,"surface":"今上","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱、神祇或未核指代，不能以後世故事補造姓名或合併。"},{"id":"c-shiji-006-shihuang:p045:m0099","start":99,"end":101,"surface":"願上","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱、神祇或未核指代，不能以後世故事補造姓名或合併。"},{"id":"c-shiji-006-shihuang:p045:m0123","start":123,"end":125,"surface":"始皇","kind":"person","person_id":"cbr-p000533","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p045:m0130","start":130,"end":132,"surface":"真人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱、神祇或未核指代，不能以後世故事補造姓名或合併。"},{"id":"c-shiji-006-shihuang:p045:m0136","start":136,"end":138,"surface":"真人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱、神祇或未核指代，不能以後世故事補造姓名或合併。"},{"id":"c-shiji-006-shihuang:p045:m0199","start":199,"end":202,"surface":"始皇帝","kind":"person","person_id":"cbr-p000533","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p045:m0211","start":211,"end":213,"surface":"丞相","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱、神祇或未核指代，不能以後世故事補造姓名或合併。"},{"id":"c-shiji-006-shihuang:p045:m0221","start":221,"end":223,"surface":"中人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱、神祇或未核指代，不能以後世故事補造姓名或合併。"},{"id":"c-shiji-006-shihuang:p045:m0225","start":225,"end":227,"surface":"丞相","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱、神祇或未核指代，不能以後世故事補造姓名或合併。"},{"id":"c-shiji-006-shihuang:p045:m0228","start":228,"end":230,"surface":"丞相","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱、神祇或未核指代，不能以後世故事補造姓名或合併。"},{"id":"c-shiji-006-shihuang:p045:m0235","start":235,"end":237,"surface":"始皇","kind":"person","person_id":"cbr-p000533","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p045:m0242","start":242,"end":244,"surface":"中人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱、神祇或未核指代，不能以後世故事補造姓名或合併。"}],"chapter_id":"c-shiji-006-shihuang","book_id":"b-shiji-006","work_id":"w-shiji","source_id":"s-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:p046","text":"侯生盧生相與謀曰：「始皇為人，天性剛戾自用，起諸侯，并天下，意得欲從，以為自古莫及己。專任獄吏，獄吏得親幸。博士雖七十人，特備員弗用。丞相諸大臣皆受成事，倚辨於上。上樂以刑殺為威，天下畏罪持祿，莫敢盡忠。上不聞過而日驕，下懾伏謾欺以取容。秦法，不得兼方不驗，輒死。然候星氣者至三百人，皆良士，畏忌諱諛，不敢端言其過。天下之事無小大皆決於上，上至以衡石量書，日夜有呈，不中呈不得休息。貪於權勢至如此，未可為求僊藥。」於是乃亡去。始皇聞亡，乃大怒曰：「吾前收天下書不中用者盡去之。悉召文學方術士甚眾，欲以興太平，方士欲練以求奇藥。今聞韓眾去不報，徐巿等費以巨萬計，終不得藥，徒姦利相告日聞。盧生等吾尊賜之甚厚，今乃誹謗我，以重吾不德也。諸生在咸陽者，吾使人廉問，或為訞言以亂黔首。」於是使御史悉案問諸生，諸生傳相告引，乃自除犯禁者四百六十餘人，皆阬之咸陽，使天下知之，以懲後。益發謫徙邊。始皇長子扶蘇諫曰：「天下初定，遠方黔首未集，諸生皆誦法孔子，今上皆重法繩之，臣恐天下不安。唯上察之。」始皇怒，使扶蘇北監蒙恬於上郡。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:p046:m0000","start":0,"end":2,"surface":"侯生","kind":"person","person_id":"cbr-p000593","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p046:m0002","start":2,"end":4,"surface":"盧生","kind":"person","person_id":"cbr-p000584","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p046:m0010","start":10,"end":12,"surface":"始皇","kind":"person","person_id":"cbr-p000533","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p046:m0213","start":213,"end":215,"surface":"始皇","kind":"person","person_id":"cbr-p000533","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p046:m0254","start":254,"end":256,"surface":"方士","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱、神祇或未核指代，不能以後世故事補造姓名或合併。"},{"id":"c-shiji-006-shihuang:p046:m0265","start":265,"end":267,"surface":"韓眾","kind":"person","per