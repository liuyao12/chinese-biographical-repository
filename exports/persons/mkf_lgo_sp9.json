29,6830,6831,6832,6833,6834,6835,6836,6837,6838,6839,6840,6841,6842,6843,6849,6850,6851,6852,6855,6856,6857,6858,6859,6860,6861,6862,6863,6864,6865,6866,6867,6868,6869,6870,6871,6872,6873,6874,6875,6876,6877,6878,6879,6880,6881,6882,6883,6884,6885,6886,6887,6888,6889],"revision_id":1511897},"mentions":[{"id":"c-nanqishu-046-xiaohuiji-complete:p009:m0002","start":2,"end":4,"surface":"惠休","kind":"person","person_id":"mkf_lgo_sp9","status":"contextual_provisional"},{"id":"c-nanqishu-046-xiaohuiji-complete:p009:m0005","start":5,"end":7,"surface":"惠朗","kind":"person","person_id":"17y_zsq_etz","status":"contextual_provisional"},{"id":"c-nanqishu-046-xiaohuiji-complete:p009:m0018","start":18,"end":20,"surface":"太祖","kind":"person","person_id":"47p_kjh_ez7","status":"contextual_provisional"},{"id":"c-nanqishu-046-xiaohuiji-complete:p009:m0050","start":50,"end":53,"surface":"何益孫","kind":"person","person_id":"e9n_6l7_60j","status":"contextual_provisional"},{"id":"c-nanqishu-046-xiaohuiji-complete:p009:m0061","start":61,"end":63,"surface":"惠朗","kind":"person","person_id":"17y_zsq_etz","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-046-xiaohuiji-complete","book_id":"b-nanqishu-046","work_id":"w-nanqishu","source_id":"s-nanqishu-046-xiaohuiji-complete-ws1511897"},{"id":"c-nanqishu-057-northern-wei-complete:p030","text":"建武二年春，高宗遣鎮南將軍王廣之出司州，右僕射沈文季出豫州，左衞將軍崔慧景出徐州。宏自率眾至壽陽，軍中有黑氈行殿，容二十人坐，輦邊皆三郎曷剌真，槊多白真毦，鐵騎為羣，前後相接。步軍皆烏楯槊，綴接以黑蝦蟆幡。牛車及驢駱駞載軍資妓女，三十許萬人。不攻城，登八公山，賦詩而去。別圍鍾離城，徐州刺史蕭惠休、輔國將軍申希祖拒守，出兵奮擊，宏眾敗，多赴淮死。乃分軍據邵陽州，柵斷水路，夾築二城。右衞將軍蕭坦之遣軍主裴叔業攻二城，拔之。惠休又募人出燒虜攻城車，虜力竭不能剋。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":68,"last_line":68,"raw_start":7601,"raw_end":7838,"raw_character_offsets":[7606,7607,7608,7609,7612,7613,7614,7615,7616,7617,7618,7619,7620,7621,7622,7623,7624,7625,7626,7627,7628,7629,7630,7631,7632,7633,7634,7635,7636,7637,7638,7639,7640,7641,7642,7643,7644,7645,7646,7647,7648,7649,7650,7651,7652,7653,7654,7655,7656,7657,7658,