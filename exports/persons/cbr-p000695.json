t_mentioned_source_ids":["s-shiji-007-xiangyu"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-007-xiangyu:m019-0192","start":192,"end":194,"surface":"紀信","kind":"person","person_id":"cbr-p000695","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p019","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-007-xiangyu:m029-0002","start":2,"end":4,"surface":"紀信","kind":"person","person_id":"cbr-p000695","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p029","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-007-xiangyu:m029-0055","start":55,"end":57,"surface":"紀信","kind":"person","person_id":"cbr-p000695","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p029","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-007-xiangyu:m029-0106","start":106,"end":108,"surface":"紀信","kind":"person","person_id":"cbr-p000695","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p029","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-007-xiangyu:m029-0132","start":132,"end":134,"surface":"紀信","kind":"person","person_id":"cbr-p000695","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p029","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-008-gaozu:m040-0029","start":29,"end":31,"surface":"紀信","kind":"person","person_id":"cbr-p000695","status":"contextual_provisional","paragraph_id":"c-shiji-008-gaozu:p040","chapter_id":"c-shiji-008-gaozu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji008-038","person_id":"cbr-p000695","surfaces":["紀信"],"scope":"cross_chapter","chapter_ids":["c-shiji-007-xiangyu","c-shiji-008-gaozu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-007-xiangyu:p019","quote":"沛公已出，項王使都尉陳平召沛公。沛公曰：「今者出，未辭也，為之柰何？」樊噲曰：「大行不顧細謹，大禮不辭小讓。如今人方為刀俎，我為魚肉，何辭為。」於是遂去。乃令張良留謝。良問曰：「大王來何操？」曰：「我持白璧一雙，欲獻項王，玉斗一雙，欲與亞父，會其怒，不敢獻。公為我獻之」張良曰：「謹諾。」當是時，項王軍在鴻門下，沛公軍在霸上，相去四十里。沛公則置車騎，脫身獨騎，與樊噲、夏侯嬰、靳彊、紀信等四人持劍盾步走，從酈山下，道芷陽閒行。沛公謂張良曰：「從此道至吾軍，不過二十里耳。度我至軍中，公乃入。」沛公已去，閒至軍中，張良入謝，曰：「沛公不勝桮杓，不能辭。謹使臣良奉白璧一雙，再拜獻大王足下；玉斗一雙，再拜奉大將軍足下。」項王曰：「沛公安在？」良曰：「聞大王有意督過之，脫身獨去，已至軍矣。」項王則受璧，置之坐上。亞父受玉斗，置之地，拔劍撞而破之，曰：「唉！豎子不足與謀。奪項王天下者，必沛公也，吾屬今為之虜矣。」沛公至軍，立誅殺曹無傷。"},{"paragraph_id":"c-shiji-008-gaozu:p040","quote":"漢軍絕食，乃夜出女子東門二千餘人，被甲，楚因四面擊之。將軍紀信乃乘王駕，詐為漢王，誑楚，楚皆呼萬歲，之城東觀，以故漢王得與數十騎出西門遁。令御史大夫周苛、魏豹、樅公守滎陽。諸將卒不能從者，盡在城中。周苛、樅公相謂曰：「反國之王，難與守城。」因殺魏豹。"}],"rationale":"只在所列原句的秦末楚漢軍事／分封敘事內暫定同指；有前卷錨點時對讀相接事件，不把同名作全庫匹配規則，仍待異源覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-007-xiangyu:p019","text":"沛公已出，項王使都尉陳平召沛公。沛公曰：「今者出，未辭也，為之柰何？」樊噲曰：「大行不顧細謹，大禮不辭小讓。如今人方為刀俎，我為魚肉，何辭為。」於是遂去。乃令張良留謝。良問曰：「大王來何操？」曰：「我持白璧一雙，欲獻項王，玉斗一雙，欲與亞父，會其怒，不敢獻。公為我獻之」張良曰：「謹諾。」當是時，項王軍在鴻門下，沛公軍在霸上，相去四十里。沛公則置車騎，脫身獨騎，與樊噲、夏侯嬰、靳彊、紀信等四人持劍盾步走，從酈山下，道芷陽閒行。沛公謂張良曰：「從此道至吾軍，不過二十里耳。度我至軍中，公乃入。」沛公已去，閒至軍中，張良入謝，曰：「沛公不勝桮杓，不能辭。謹使臣良奉白璧一雙，再拜獻大王足下；玉斗一雙，再拜奉大將軍足下。」項王曰：「沛公安在？」良曰：「聞大王有意督過之，脫身獨去，已至軍矣。」項王則受璧，置之坐上。亞父受玉斗，置之地，拔劍撞而破之，曰：「唉！豎子不足與謀。奪項王天下者，必沛公也，吾屬今為之虜矣。」沛公至軍，立誅殺曹無傷。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-007-xiangyu:m019-0000","start":0,"end":2,"surface":"沛公","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m019-0005","start":5,"end":7,"surface":"項王","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m019-0010","start":10,"end":12,"surface":"陳平","kind":"person","person_id":"cbr-p000692","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m019-0013","start":13,"end":15,"surface":"沛公","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m019-0016","start":16,"end":18,"surface":"沛公","kind":"person","person_id":"cbr-p000662","status":"contextu