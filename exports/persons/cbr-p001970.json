{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p001970","identity_policy":"contextual_provisional","person_ids":["cbr-p001970"],"persons":[{"id":"cbr-p001970","label":"屈原（楚篇使齊者）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"屈原","mention_ids":["c-shiji-040-chu:m074-0178"]}],"evidence":[{"mention_id":"c-shiji-040-chu:m074-0178","chapter_id":"c-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p074","quote":"屈原"}]}],"mentions":[{"id":"c-shiji-040-chu:m074-0178","start":178,"end":180,"surface":"屈原","kind":"person","person_id":"cbr-p001970","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p074","chapter_id":"c-shiji-040-chu"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji040-068","person_id":"cbr-p001970","surfaces":["屈原"],"scope":"same_chapter","chapter_ids":["c-shiji-040-chu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-040-chu:p074","quote":"至，懷王不見，因而囚張儀，欲殺之。儀私於靳尚，靳尚爲請懷王曰：「拘張儀，秦王必怒。天下見楚無秦，必輕王矣。」又謂夫人鄭袖曰：「秦王甚愛張儀，而王欲殺之，今將以上庸之地六縣賂楚，以美人聘楚王，以宮中善歌者爲之媵。楚王重地，秦女必貴，而夫人必斥矣。夫人不若言而出之。」鄭袖卒言張儀於王而出之。儀出，懷王因善遇儀，儀因説楚王以叛從約而與秦合親，約婚姻。張儀已去，屈原使從齊來，諫王曰：「何不誅張儀？」懷王悔，使人追儀，弗及。是歳，秦惠王卒。"}],"rationale":"本篇具名出使、合秦或說楚事件內暫接，未與他篇同名候選批量合併；短稱及未見名字仍待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-040-chu:p074","text":"至，懷王不見，因而囚張儀，欲殺之。儀私於靳尚，靳尚爲請懷王曰：「拘張儀，秦王必怒。天下見楚無秦，必輕王矣。」又謂夫人鄭袖曰：「秦王甚愛張儀，而王欲殺之，今將以上庸之地六縣賂楚，以美人聘楚王，以宮中善歌者爲之媵。楚王重地，秦女必貴，而夫人必斥矣。夫人不若言而出之。」鄭袖卒言張儀於王而出之。儀出，懷王因善遇儀，儀因説楚王以叛從約而與秦合親，約婚姻。張儀已去，屈原使從齊來，諫王曰：「何不誅張儀？」懷王悔，使人追儀，弗及。是歳，秦惠王卒。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m074-0002","start":2,"end":4,"surface":"懷王","kind":"person","person_id":"cbr-p001923","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m074-0010","start":10,"end":12,"surface":"張儀","kind":"person","person_id":"cbr-p000464","statu