able_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-song047-tanzhi-憑之","person_id":"4qy_2ah_8ga","event_type":"death","source_term":"戰沒","source_anchor":{"paragraph_id":"c-songshu-047-tanzhi:p001","start":73,"end":75,"surface":"戰沒"},"date_expression":null,"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-047","chapter_id":"c-songshu-047-tanzhi","source_id":"s-songshu-047-tanzhi-ws2190557","paragraph_id":"c-songshu-047-tanzhi:p001","quote":"檀祗字恭叔，高平金鄉人，左將軍韶第二弟也。少為孫無終輔國參軍，隨無終東征孫恩，屢有戰功。復為王誕龍驤參軍。從高祖克京城，參建武軍事。至羅落，檀憑之戰沒之後，仍以憑之所領兵配祗。京邑既平，參鎮軍事，加振武將軍，隸振武大將軍道規追討桓玄，每戰克捷。江陵平定，道規遣祗征溳、沔亡命桓道兒、張靖、苻嗣等，皆悉平之。除龍驤將軍、秦郡太守、北陳留內史，又為寧朔將軍、竟陵太守，不拜。破桓亮於長沙，苻宏於湘東。武陵內史庾悅疾病，道規以祗代悅，加寧朔將軍，封西昌縣侯，食邑千戶。五年，入為中書侍郎。","person_mention_id":"c-songshu-047-tanzhi:p001:m0070"}],"status":"source_attested","interpretation_note":"按同段人物與次第核所屬卒事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"mentions":[{"id":"c-songshu-047-tanzhi:p001:m0070","start":70,"end":73,"surface":"檀憑之","kind":"person","person_id":"4qy_2ah_8ga","status":"contextual_provisional","paragraph_id":"c-songshu-047-tanzhi:p001","chapter_id":"c-songshu-047-tanzhi"},{"id":"c-songshu-047-tanzhi:p001:m0080","start":80,"end":82,"surface":"憑之","kind":"person","person_id":"4qy_2ah_8ga","status":"contextual_provisional","paragraph_id":"c-songshu-047-tanzhi:p001","chapter_id":"c-songshu-047-tanzhi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-songshu-047-tanzhi:p001","text