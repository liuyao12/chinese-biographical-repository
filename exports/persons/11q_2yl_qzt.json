患匈奴隔其道，誠通蜀，身毒國道便近，有利無害。於是天子乃令王然于、柏始昌、呂越人等，使閒出西夷西，指求身毒國。至滇，滇王嘗羌乃留，為求道西十餘輩。歲餘，皆閉昆明，莫能通身毒國。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-116-xinanyi:m005-0009","start":9,"end":11,"surface":"張騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m005-0070","start":70,"end":71,"surface":"騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m005-0110","start":110,"end":112,"surface":"天子","kind":"person","person_id":"nvi_c32_k29","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m005-0114","start":114,"end":117,"surface":"王然于","kind":"person","person_id":"hpw_2ip_uqk","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m005-0118","start":118,"end":121,"surface":"柏始昌","kind":"person","person_id":"11q_2yl_qzt","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m005-0122","start":122,"end":125,"surface":"呂越人","kind":"person","person_id":"miw_t0v_k64","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m005-0145","start":145,"end":147,"surface":"嘗羌","kind":"person","person_id":"h0h_wsl_1nf","status":"contextual_provisional"}],"chapter_id":"c-shiji-116-xinanyi","book_id":"b-shiji-116","work_id":"w-shiji","source_id":"s-shiji116-xinanyi"}],"sources":[{"chapter_id":"c-shiji-116-xinanyi","work_id":"w-shiji","book_id":"b-shiji-116","source_id":"s-shiji116-xinanyi","source":{"title":"史記／卷116","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷116","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷116&oldid=7903636","revision_id":7903636,"accessed_on":"2026-10-11","extent":"固定數位修訂全文12段，末段索隱述贊另層。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"去header2與現代節標題；YL紀年模板保留第一參數，第二參數編輯年標不納正文。正文原字不改，未核影像。",