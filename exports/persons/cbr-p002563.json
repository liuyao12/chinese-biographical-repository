us":"contextual_provisional"},{"id":"c-shiji-065-sun:m002-0010","start":10,"end":12,"surface":"孫臏","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m002-0013","start":13,"end":14,"surface":"臏","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m002-0020","start":20,"end":21,"surface":"臏","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m002-0022","start":22,"end":24,"surface":"孫武","kind":"person","person_id":"vax_w2r_0za","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m002-0031","start":31,"end":33,"surface":"孫臏","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m002-0035","start":35,"end":37,"surface":"龐涓","kind":"person","person_id":"id5_d3k_vsc","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m002-0042","start":42,"end":44,"surface":"龐涓","kind":"person","person_id":"id5_d3k_vsc","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m002-0050","start":50,"end":52,"surface":"惠王","kind":"person","person_id":"t8k_az0_xk2","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m002-0062","start":62,"end":64,"surface":"孫臏","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m002-0069","start":69,"end":71,"surface":"孫臏","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m002-0072","start":72,"end":73,"surface":"臏","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m002-0075","start":75,"end":77,"surface":"龐涓","kind":"person","person_id":"id5_d3k_vsc","status":"contextual_provisional"}],"chapter_id":"c-shiji-065-sun","book_id":"b-shiji-065","work_id":"w-shiji","source_id":"s-shiji-065-sun"},{"id":"c-shiji-065-sun:p005","text":"後十三歲，魏與趙攻韓，韓告急於齊。齊使田忌將而往，直走大梁。魏將龐涓聞之，去韓而歸，齊軍既已過而西矣。孫子謂田忌曰：「彼三晉之兵素悍勇而輕齊，齊號為怯，善戰者因其勢而利導之。兵法，百里而趣利者蹶上將，五十里而趣利者軍半至。使齊軍入魏地為十萬灶，明日為五萬灶，又明日為三萬灶。」龐涓行三日，大喜，曰：「我固知齊軍怯，入吾地三日，士卒亡者過半矣。」乃棄其步軍，與其輕銳倍日并行逐之。孫子度其行，暮當至馬陵。馬陵道陜，而旁多阻隘，可伏兵，乃斫大樹白而書之曰「龐涓死于此樹之下」。於是令齊軍善射者萬弩，夾道而伏，期曰「暮見火舉而俱發」。龐涓果夜至斫木下，見白書，乃鉆火燭之。讀其書未畢，齊軍萬弩俱發，魏軍大亂相失。龐涓自知智窮兵敗，乃自剄，曰：「遂成豎子之名！」齊因乘勝盡破其軍，虜魏太子申以歸。孫臏以此名顯天下，世傳其兵法。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-065-sun:m005-0019","start":19,"end":21,"surface":"田忌","kind":"person","person_id":"vns_z44_maf","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m005-0032","start":32,"end":34,"surface":"龐涓","kind":"person","person_id":"id5_d3k_vsc","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m005-0051","start":51,"end":53,"surface":"孫子","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m005-0054","start":54,"end":56,"surface":"田忌","kind":"person","person_id":"vns_z44_maf","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m005-0138","start":138,"end":140,"surface":"龐涓","kind":"person","person_id":"id5_d3k_vsc","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m005-0163","start":163,"end":165,"surface":"士卒","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代；不補姓名、成員或肯定公主同一性。"},{"id":"c-shiji-065-sun:m005-0189","start":189,"end":191,"surface":"孫子","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m005-0226","start":226,"end":228,"surface":"龐涓","kind":"person","person_id":"id5_d3k_vsc","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m005-0241","start":241,"end":244,"surface":"善射者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代；不補姓名、成員或肯定公主同一性。"},{"id":"c-shiji-065-sun:m005-0264","start":264,"end":266,"surface":"龐涓","kind":"person","person_id":"id5_d3k_vsc","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m005-0303","start":303,"end":305,"surface":"龐涓","kind":"person","person_id":"id5_d3k_vsc","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m005-0337","start":337,"end":341,"surface":"魏太子申","kind":"person","person_id":"yh1_ob5_1qm","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m005-0344","start":344,"end":346,"surface":"孫臏","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"}],"chapter_id":"c-shiji-065-sun","book_id":"b-shiji-065","work_id":"w-shiji","source_id":"s-shiji-065-sun"},{"id":"c-shiji-065-sun:p014","text":"太史公曰：世俗所稱師旅，皆道孫子十三篇，吳起兵法，世多有，故弗論，論其行事所施設者。語曰：「能行之者未必能言，能言之者未必能行。」孫子籌策龐涓明矣，然不能蚤救患於被刑。吳起說武侯以形勢不如德，然行之於楚，以刻暴少恩亡其軀。悲夫！","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-065-sun:m014-0000","start":0,"end":3,"surface":"太史公","kind":"person","person_id":"fy2_9h4_gdt","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m014-0020","start":20,"end":22,"surface":"吳起","kind":"person","person_id":"61h_0sk_4pb","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m014-0065","start":65,"end":67,"surface":"孫子","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m014-0069","start":69,"end":71,"surface":"龐涓","kind":"person","person_id":"id5_d3k_vsc","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m014-0084","start":84,"end":86,"surface":"吳起","kind":"person","person_id":"61h_0sk_4pb","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m014-0087","start":87,"end":89,"surface":"武侯","kind":"person","person_id":"p9l_wy7_y7m_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-065-sun","book_id":"b-shiji-065","work_id":"w-shiji","source_id":"s-shiji-065-sun"},{"id":"c-shiji-075-mengchang:p001","text":"孟嘗君名文，姓田氏。文之父曰靖郭君田嬰。田嬰者，齊威王少子而齊宣王庶弟也。田嬰自威王時任職用事，與成侯鄒忌及田忌將而救韓伐魏。成侯與田忌爭寵，成侯賣田忌。田忌懼，襲齊之邊邑，不勝，亡走。會威王卒，宣王立，知成侯賣田忌，乃復召田忌以爲將。宣王二年，田忌與孫臏、田嬰倶伐魏，敗之馬陵，虜魏太子申而殺魏將龐涓。宣王七年，田嬰使於韓、魏，韓、魏服於齊。嬰與韓昭侯、魏惠王會齊宣王東阿南，盟而去。明年，復與梁惠王會甄。是歳，梁惠王卒。宣王九年，田嬰相齊。齊宣王與魏襄王會徐州而相王也。楚威王聞之，怒田嬰。明年，楚伐敗齊師於徐州，而使人逐田嬰。田嬰使張丑説楚威王，威王乃止。田嬰相齊十一年，宣王卒，湣王即位。即位三年，而封田嬰於薛。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-075-mengchang:m001-0000","start":0,"end":3,"surface":"孟嘗君","kind":"person","person_id":"7s4_7ac_lhn_AA","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m001-0004","start":4,"end":5,"surface":"文","kind":"person","person_id":"7s4_7ac_lhn_AA","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m001-0007","start":7,"end":9,"surface":"田氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"姓氏形式、群體、未定親屬回指或祖孫定義對話，未作已知個別人物；母因兄弟未補兄弟所屬及成員，定義孫玄孫不補真實後裔。"},{"id":"c-shiji-075-mengchang:m001-0010","start":10,"end":11,"surface":"文","kind":"person","person_id":"7s4_7ac_lhn_AA","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m001-0014","start":14,"end":19,"surface":"靖郭君田嬰","kind":"person","person_id":"7s4_7ac_lhn_A","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m001-0020","start":20,"end":22,"surface":"田嬰","kind":"person","person_id":"7s4_7ac_lhn_A","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m001-0024","start":24,"end":27,"surface":"齊威王","kind":"person","person_id":"7s4_7ac_lhn","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m001-0030","start":30,"end":33,"surface":"齊宣王","kind":"person","person_id":"oa0_nm7_e6f","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m001-0037","start":37,"end":39,"surface":"田嬰","kind":"person","person_id":"7s4_7ac_lhn_A","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m001-0040","start":40,"end":42,"surface":"威王","kind":"person","person_id":"7s4_7ac_lhn","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m001-0049","start":49,"end":53,"surface":"成侯鄒忌","kind":"person","person_id":"m8t_rxr_0s8","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m001-0054","start":54,"end":56,"surface":"田忌","kind":"person","person_id":"0wg_3ra_wdt","status":"contextual_provi