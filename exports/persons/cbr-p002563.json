end":209,"surface":"其御","kind":"person","person_id":"o9t_t9k_rc2","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m036-0222","start":222,"end":224,"surface":"太子","kind":"person","person_id":"egy_txn_xs1","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m036-0237","start":237,"end":241,"surface":"魏太子申","kind":"person","person_id":"egy_txn_xs1","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m036-0245","start":245,"end":246,"surface":"涓","kind":"person","person_id":"gv0_6h6_ek6","status":"contextual_provisional"}],"chapter_id":"c-shiji-044-wei","book_id":"b-shiji-044","work_id":"w-shiji","source_id":"s-shiji-044-wei"},{"id":"c-shiji-046-tian:p037","text":"二年，魏伐趙。趙與韓親，共撃魏。趙不利，戰於南梁。宣王召田忌復故位。韓氏請救於齊。宣王召大臣而謀曰：「蚤救孰與晩救？」騶忌子曰：「不如勿救。」田忌曰：「弗救，則韓且折而入於魏，不如蚤救之。」孫子曰：「夫韓、魏之兵未獘而救之，是吾代韓受魏之兵，顧反聽命於韓也。且魏有破國之志，韓見亡，必東面而愬於齊矣。吾因深結韓之親而晩承魏之獘，則可重利而得尊名也。」宣王曰：「善。」乃陰告韓之使者而遣之。韓因恃齊，五戰不勝，而東委國於齊。齊因起兵，使田忌、田嬰將，孫子爲（帥）［師］，救韓、趙以撃魏，大敗之馬陵，殺其將龐涓，虜魏太子申。其後三晉之王皆因田嬰朝齊王於博望，盟而去。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-046-tian:m037-0025","start":25,"end":27,"surface":"宣王","kind":"person","person_id":"zan_qcc_jy5_AAAAAABAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m037-0028","start":28,"end":30,"surface":"田忌","kind":"person","person_id":"16n_czk_thg","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m037-0041","start":41,"end":43,"surface":"宣王","kind":"person","person_id":"zan_qcc_jy5_AAAAAABAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m037-0059","start":59,"end":62,"surface":"騶忌子","kind":"person","person_id":"drb_gcn_28e","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m037-0071","start":71,"end":73,"surface":"田忌","kind":"person","person_id":"16n_czk_thg","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m037-0095","start":95,"end":97,"surface":"孫子","kind":"person","person_id":"u4r_ktr_4qm","status":"contextual_provisional"},{"id":"c-shiji-046-ti