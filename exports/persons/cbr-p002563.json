nd":"person","person_id":"id5_d3k_vsc","status":"contextual_provisional","paragraph_id":"c-shiji-065-sun:p002","chapter_id":"c-shiji-065-sun"},{"id":"c-shiji-065-sun:m005-0032","start":32,"end":34,"surface":"龐涓","kind":"person","person_id":"id5_d3k_vsc","status":"contextual_provisional","paragraph_id":"c-shiji-065-sun:p005","chapter_id":"c-shiji-065-sun"},{"id":"c-shiji-065-sun:m005-0138","start":138,"end":140,"surface":"龐涓","kind":"person","person_id":"id5_d3k_vsc","status":"contextual_provisional","paragraph_id":"c-shiji-065-sun:p005","chapter_id":"c-shiji-065-sun"},{"id":"c-shiji-065-sun:m005-0226","start":226,"end":228,"surface":"龐涓","kind":"person","person_id":"id5_d3k_vsc","status":"contextual_provisional","paragraph_id":"c-shiji-065-sun:p005","chapter_id":"c-shiji-065-sun"},{"id":"c-shiji-065-sun:m005-0264","start":264,"end":266,"surface":"龐涓","kind":"person","person_id":"id5_d3k_vsc","status":"contextual_provisional","paragraph_id":"c-shiji-065-sun:p005","chapter_id":"c-shiji-065-sun"},{"id":"c-shiji-065-sun:m005-0303","start":303,"end":305,"surface":"龐涓","kind":"person","person_id":"id5_d3k_vsc","status":"contextual_provisional","paragraph_id":"c-shiji-065-sun:p005","chapter_id":"c-shiji-065-sun"},{"id":"c-shiji-065-sun:m014-0069","start":69,"end":71,"surface":"龐涓","kind":"person","person_id":"id5_d3k_vsc","status":"contextual_provisional","paragraph_id":"c-shiji-065-sun:p014","chapter_id":"c-shiji-065-sun"},{"id":"c-shiji-075-mengchang:m001-0147","start":147,"end":151,"surface":"魏將龐涓","kind":"person","person_id":"0p4_7a4_vvh","status":"contextual_provisional","paragraph_id":"c-shiji-075-mengchang:p001","chapter_id":"c-shiji-075-mengchang"}],"relations":[],"title_holdings":[{"id":"th-shiji044-022","person_id":"gv0_6h6_ek6","title":"將","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-044-wei","source_id":"s-shiji-044-wei","paragraph_id":"c-shiji-044-wei:p036","quote":"卅年，魏伐趙，趙告急齊。齊宣王用孫子計，救趙撃魏。魏遂大興師，使龐涓將，而令太子申爲上將軍。過外黃，外黃徐子謂太子曰：『臣有百戰百勝之術。』太子曰：『可得聞乎？』客曰：『固願效之。』曰：『太子自將攻齊，大勝并莒，則富不過有魏，貴不益爲王。若戰不勝齊，則萬世无魏矣。此臣之百戰百勝之術也。』太子曰：『諾，請必從公之言而還矣。』客曰：『太子雖欲還，不得矣。彼勸太子戰攻，欲啜汁者衆。太子雖欲還，恐不得矣。』太子因欲還，其御曰：『將出而還，與北同。』太子果與齊人戰，敗於馬陵。齊虜魏太子申，殺將軍涓，軍遂大破。"}],"attestations":[{"id":"th-shiji044-022:a001","paragraph_id":"c-shiji-044-wei:p036","start":34,"end":35,"surface":"將","person_mention_id":"c-shiji-044-wei:m036-0032","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"用稱、授予、追尊與任事分存；爭太子、俘虜與死亡不推持有或全部有效終點。原紀年未換算，惠王敘事與追尊王號並存，版本及制度種類待核。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji044-023","person_id":"gv0_6h6_ek6","title":"將軍","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-044-wei","source_id":"s-shiji-044-wei","paragraph_id":"c-shiji-044-wei:p036","quote":"卅年，魏伐趙，趙告急齊。齊宣王用孫子計，救趙撃魏。魏遂大興師，使龐涓將，而令太子申爲上將軍。過外黃，外黃徐子謂太子曰：『臣有百戰百勝之術。』太子曰：『可得聞乎？』客曰：『固願效之。』曰：『太子自將攻齊，大勝并莒，則富不過有魏，貴不益爲王。若戰不勝齊，則萬世无魏矣。此臣之百戰百勝之術也。』太子曰：『諾，請必從公之言而還矣。』客曰：『太子雖欲還，不得矣。彼勸太子戰攻，欲啜汁者衆。太子雖欲還，恐不得矣。』太子因欲還，其御曰：『將出而還，與北同。』太子果與齊人戰，敗於馬陵。齊虜魏太子申，殺將軍涓，軍遂大破。"}],"attestations":[{"id":"th-shiji044-023:a001","paragraph_id":"c-shiji-044-wei:p036","start":243,"end":245,"surface":"將軍","person_mention_id":"c-shiji-044-wei:m036-0245","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"用稱、授予、追尊與任事分存；爭太子、俘虜與死亡不推持有或全部有效終點。原紀年未換算，惠王敘事與追尊王號並存，版本及制度種類待核。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji065-003","person_id":"id5_d3k_vsc","title":"將軍","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-065-sun","source_id":"s-shiji-065-sun","paragraph_id":"c-shiji-065-sun:p002","quote":"孫武既死，後百餘歲有孫臏。臏生阿鄄之閒，臏亦孫武之後世子孫也。孫臏嘗與龐涓俱學兵法。龐涓既事魏，得為惠王將軍，而自以為能不及孫臏，乃陰使召孫臏。臏至，龐涓恐其賢於己，疾之，則以法刑斷其兩足而黥之，欲隱勿見。"}],"attestations":[{"id":"th-shiji065-003:a001","paragraph_id":"c-shiji-065-sun:p002","start":52,"end":54,"surface":"將軍","person_mention_id":"c-shiji-065-sun:m002-0042","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授任與來源用稱分存，制度未定者保留未分類；死亡、首次提及或被刑不補有效任期，諡稱不當生前已授同字稱號。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji075-007","person_id":"0p4_7a4_vvh","title":"魏將","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-075-mengchang","source_id":"s-shiji-075-mengchang","paragraph_id":"c-shiji-075-mengchang:p001","quote":"孟嘗君名文，姓田氏。文之父曰靖郭君田嬰。田嬰者，齊威王少子而齊宣王庶弟也。田嬰自威王時任職用事，與成侯鄒忌及田忌將而救韓伐魏。成侯與田忌爭寵，成侯賣田忌。田忌懼，襲齊之邊邑，不勝，亡走。會威王卒，宣王立，知成侯賣田忌，乃復召田忌以爲將。宣王二年，田忌與孫臏、田嬰倶伐魏，敗之馬陵，虜魏太子申而殺魏將龐涓。宣王七年，田嬰使於韓、魏，韓、魏服於齊。嬰與韓昭侯、魏惠王會齊宣王東阿南，盟而去。明年，復與梁惠王會甄。是歳，梁惠王卒。宣王九年，田嬰相齊。齊宣王與魏襄王會徐州而相王也。楚威王聞之，怒田嬰。明年，楚伐敗齊師於徐州，而使人逐田嬰。田嬰使張丑説楚威王，威王乃止。田嬰相齊十一年，宣王卒，湣王即位。即位三年，而封田嬰於薛。"}],"attestations":[{"id":"th-shiji075-007:a001","paragraph_id":"c-shiji-075-mengchang:p001","start":147,"end":149,"surface":"魏將","person_mention_id":"c-shiji-075-mengchang:m001-0147","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授官、授稱、文獻用稱與諡稱分存；未知日期與終點不補。初馮驩段落為回述，不把跨段順序當連續任期，擬請相秦與許以所得封子不當實授；囚、出關或死亡不直接終止全部官爵。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji044-064","person_id":"gv0_6h6_ek6","surfaces":["涓","龐涓"],"scope":"same_chapter","chapter_ids":["c-shiji-044-wei"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-044-wei:p036","quote":"卅年，魏伐趙，趙告急齊。齊宣王用孫子計，救趙撃魏。魏遂大興師，使龐涓將，而令太子申爲上將軍。過外黃，外黃徐子謂太子曰：『臣有百戰百勝之術。』太子曰：『可得聞乎？』客曰：『固願效之。』曰：『太子自將攻齊，大勝并莒，則富不過有魏，貴不益爲王。若戰不勝齊，則萬世无魏矣。此臣之百戰百勝之術也。』太子曰：『諾，請必從公之言而還矣。』客曰：『太子雖欲還，不得矣。彼勸太子戰攻，欲啜汁者衆。太子雖欲還，恐不得矣。』太子因欲還，其御曰：『將出而還，與北同。』太子果與齊人戰，敗於馬陵。齊虜魏太子申，殺將軍涓，軍遂大破。"}],"rationale":"限本篇明示姓名、是為及同段連續語境；外黃徐子／客按同一勸還對話暫接，龐涓／涓按同一馬陵戰暫接。孫子與孫臏、公子赫與襄王、齊王與齊宣王仍分候選；武下將識國別待核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji046-087","person_id":"5v8_amk_emn","scope":"same_chapter","chapter_ids":["c-shiji-046-tian"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["龐涓"],"evidence":[{"paragraph_id":"c-shiji-046-tian:p037","quote":"二年，魏伐趙。趙與韓親，共撃魏。趙不利，戰於南梁。宣王召田忌復故位。韓氏請救於齊。宣王召大臣而謀曰：「蚤救孰與晩救？」騶忌子曰：「不如勿救。」田忌曰：「弗救，則韓且折而入於魏，不如蚤救之。」孫子曰：「夫韓、魏之兵未獘而救之，是吾代韓受魏之兵，顧反聽命於韓也。且魏有破國之志，韓見亡，必東面而愬於齊矣。吾因深結韓之親而晩承魏之獘，則可重利而得尊名也。」宣王曰：「善。」乃陰告韓之使者而遣之。韓因恃齊，五戰不勝，而東委國於齊。齊因起兵，使田忌、田嬰將，孫子爲（帥）［師］，救韓、趙以撃魏，大敗之馬陵，殺其將龐涓，虜魏太子申。其後三晉之王皆因田嬰朝齊王於博望，盟而去。"}],"rationale":"限本篇明示姓名、是為、繼位及局部事件暫接；姜齊與田齊桓公、不同時段未名王及同字忌分開。孫子不先補孫臏，子守髙唐不補闕字，索隱短稱與代詞仍待核；未跨篇按同名接人。"},{"id":"d-shiji065-004","person_id":"id5_d3k_vsc","surfaces":["龐涓"],"scope":"same_chapter","chapter_ids":["c-shiji-065-sun"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-065-sun:p002","quote":"孫武既死，後百餘歲有孫臏。臏生阿鄄之閒，臏亦孫武之後世子孫也。孫臏嘗與龐涓俱學兵法。龐涓既事魏，得為惠王將軍，而自以為能不及孫臏，乃陰使召孫臏。臏至，龐涓恐其賢於己，疾之，則以法刑斷其兩足而黥之，欲隱勿見。"},{"paragraph_id":"c-shiji-065-sun:p005","quote":"後十三歲，魏與趙攻韓，韓告急於齊。齊使田忌將而往，直走大梁。魏將龐涓聞之，去韓而歸，齊軍既已過而西矣。孫子謂田忌曰：「彼三晉之兵素悍勇而輕齊，齊號為怯，善戰者因其勢而利導之。兵法，百里而趣利者蹶上將，五十里而趣利者軍半至。使齊軍入魏地為十萬灶，明日為五萬灶，又明日為三萬灶。」龐涓行三日，大喜，曰：「我固知齊軍怯，入吾地三日，士卒亡者過半矣。」乃棄其步軍，與其輕銳倍日并行逐之。孫子度其行，暮當至馬陵。馬陵道陜，而旁多阻隘，可伏兵，乃斫大樹白而書之曰「龐涓死于此樹之下」。於是令齊軍善射者萬弩，夾道而伏，期曰「暮見火舉而俱發」。龐涓果夜至斫木下，見白書，乃鉆火燭之。讀其書未畢，齊軍萬弩俱發，魏軍大亂相失。龐涓自知智窮兵敗，乃自剄，曰：「遂成豎子之名！」齊因乘勝盡破其軍，虜魏太子申以歸。孫臏以此名顯天下，世傳其兵法。"},{"paragraph_id":"c-shiji-065-sun:p014","quote":"太史公曰：世俗所稱師旅，皆道孫子十三篇，吳起兵法，世多有，故弗論，論其行事所施設者。語曰：「能行之者未必能言，能言之者未必能行。」孫子籌策龐涓明矣，然不能蚤救患於被刑。吳起說武侯以形勢不如德，然行之於楚，以刻暴少恩亡其軀。悲夫！"}],"rationale":"依明示姓名、局部短稱及敘事範圍暫接；孫子在闔廬試兵指孫武，在孫臏龐涓敘事指臏。魏相田文不接孟嘗君，未名與公主指代保留待核，故事及史實確證分開，不補姓名或闕代。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji075-009","person_id":"0p4_7a4_vvh","surfaces":["魏將龐涓"],"scope":"same_chapter","chapter_ids":["c-shiji-075-mengchang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-075-mengchang:p001","quote":"孟嘗君名文，姓田氏。文之父曰靖郭君田嬰。田嬰者，齊威王少子而齊宣王庶弟也。田嬰自威王時任職用事，與成侯鄒忌及田忌將而救韓伐魏。成侯與田忌爭寵，成侯賣田忌。田忌懼，襲齊之邊邑，不勝，亡走。會威王卒，宣王立，知成侯賣田忌，乃復召田忌以爲將。宣王二年，田忌與孫臏、田嬰倶伐魏，敗之馬陵，虜魏太子申而殺魏將龐涓。宣王七年，田嬰使於韓、魏，韓、魏服於齊。嬰與韓昭侯、魏惠王會齊宣王東阿南，盟而去。明年，復與梁惠王會甄。是歳，梁惠王卒。宣王九年，田嬰相齊。齊宣王與魏襄王會徐州而相王也。楚威王聞之，怒田嬰。明年，楚伐敗齊師於徐州，而使人逐田嬰。田嬰使張丑説楚威王，威王乃止。田嬰相齊十一年，宣王卒，湣王即位。即位三年，而封田嬰於薛。"}],"rationale":"依前3段明示姓名與局部敘事暫接，孟嘗君名文、文父靖郭君田嬰及鄒忌成侯按本篇相配。齊威王用事與卒、楚威王受張丑說而止按局部敘事分辨，魏惠王與梁惠王暫留兩個候選待另存對應證據，不當確證不同人。孟嘗君母其賤妾其母回指按生文明示暫接，妾不作配偶主張；祖孫定義不補後裔，兄弟群體不補所屬。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji046-pangjuan","person_ids":["gv0_6h6_ek6","5v8_amk_emn"],"canonical_person_id":"gv0_6h6_ek6","scope":"cross_chapter","chapter_ids":["c-shiji-044-wei","c-shiji-046-tian"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-044-wei","source_id":"s-shiji-044-wei","paragraph_id":"c-shiji-044-wei:p036","quote":"卅年，魏伐趙，趙告急齊。齊宣王用孫子計，救趙撃魏。魏遂大興師，使龐涓將，而令太子申爲上將軍。過外黃，外黃徐子謂太子曰：『臣有百戰百勝之術。』太子曰：『可得聞乎？』客曰：『固願效之。』曰：『太子自將攻齊，大勝并莒，則富不過有魏，貴不益爲王。若戰不勝齊，則萬世无魏矣。此臣之百戰百勝之術也。』太子曰：『諾，請必從公之言而還矣。』客曰：『太子雖欲還，不得矣。彼勸太子戰攻，欲啜汁者衆。太子雖欲還，恐不得矣。』太子因欲還，其御曰：『將出而還，與北同。』太子果與齊人戰，敗於馬陵。齊虜魏太子申，殺將軍涓，軍遂大破。","mention_ids":["c-shiji-044-wei:m036-0032","c-shiji-044-wei:m036-0245"]},{"chapter_id":"c-shiji-046-tian","source_id":"s-shiji-046-tian","paragraph_id":"c-shiji-046-tian:p037","quote":"二年，魏伐趙。趙與韓親，共撃魏。趙不利，戰於南梁。宣王召田忌復故位。韓氏請救於齊。宣王召大臣而謀曰：「蚤救孰與晩救？」騶忌子曰：「不如勿救。」田忌曰：「弗救，則韓且折而入於魏，不如蚤救之。」孫子曰：「夫韓、魏之兵未獘而救之，是吾代韓受魏之兵，顧反聽命於韓也。且魏有破國之志，韓見亡，必東面而愬於齊矣。吾因深結韓之親而晩承魏之獘，則可重利而得尊名也。」宣王曰：「善。」乃陰告韓之使者而遣之。韓因恃齊，五戰不勝，而東委國於齊。齊因起兵，使田忌、田嬰將，孫子爲（帥）［師］，救韓、趙以撃魏，大敗之馬陵，殺其將龐涓，虜魏太子申。其後三晉之王皆因田嬰朝齊王於博望，盟而去。","mention_ids":["c-shiji-046-tian:m037-0251"]}],"rationale":"兩篇同記馬陵齊擊魏、龐涓被殺與魏太子申被虜，依角色與配對事件暫同指。各已發ID保留，兩篇不是已證實獨立見證，不選定情節、紀年或來源優先。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"eq-shiji065-pang","person_ids":["gv0_6h6_ek6","id5_d3k_vsc"],"canonical_person_id":"gv0_6h6_ek6","s