{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"ngj_d5e_402","canonical_person_id":"ngj_d5e_402","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["ngj_d5e_402"],"persons":[{"id":"ngj_d5e_402","label":"曲城侯（淮南衡山列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"曲城侯","mention_ids":["c-shiji-118-huainan:m014-0074"]}],"evidence":[{"mention_id":"c-shiji-118-huainan:m014-0074","chapter_id":"c-shiji-118-huainan","paragraph_id":"c-shiji-118-huainan:p014","quote":"曲城侯"}]}],"source_mention_summary":[{"source_id":"s-shiji118-huainan","work_id":"w-shiji","book_id":"b-shiji-118","chapter_id":"c-shiji-118-huainan","mention_count":1,"mention_ids":["c-shiji-118-huainan:m014-0074"],"paragraph_ids":["c-shiji-118-huainan:p014"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji118-huainan"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-118-huainan:m014-0074","start":74,"end":77,"surface":"曲城侯","kind":"person","person_id":"ngj_d5e_402","status":"contextual_provisional","paragraph_id":"c-shiji-118-huainan:p014","chapter_id":"c-shiji-118-huainan"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-118-huainan:p014","text":"孝景三年，吳楚七國反，吳使者至淮南，淮南王欲發兵應之。其相曰：「大王必欲發兵應吳，臣願為將。」王乃屬相兵。淮南相已將兵，因城守，不聽王而為漢；漢亦使曲城侯將兵救淮南：淮南以故得完。吳使者至廬江，廬江王弗應，而往來使越。吳使者至衡山，衡山王堅守無二心。孝景四年，吳楚已破，衡山王朝，上以為貞信，乃勞苦之曰：「南方卑溼。」徙衡山王王濟北，所以褒之。及薨，遂賜謚為貞王。廬江王邊越，數使使相交，故徙為衡山王，王江北。淮南王如故。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-118-huainan:m014-0000","start":0,"end":2,"surface":"孝景","kind":"person","person_id":"amr_ua3_4f4","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m014-0011","start":11,"end":14,"surface":"吳使者","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-118-huainan:m014-0018","start":18,"end":21,"surface":"淮南王","kind":"person","person_id":"yqp_nlb_p1p_AFA","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m014-0027","start":27,"end":29,"surface":"其相","kind":"person","person_id":"vyj_swb_or9","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m014-0032","start":32,"end":34,"surface":"大王","kind":"person","person_id":"yqp_nlb_p1p_AFA","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m014-0047","start":47,"end":48,"surface":"王","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-118-huainan:m014-0050","start":50,"end":51,"surface":"相","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-118-huainan:m014-0053","start":53,"end":56,"surface":"淮南相","kind":"person","person_id":"vyj_swb_or9","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m014-0066","start":66,"end":67,"surface":"王","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-118-huainan:m014-0074","start":74,"end":77,"surface":"曲城侯","kind":"person","person_id":"ngj_d5e_402","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m014-0090","start":90,"end":93,"surface":"吳使者","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-118-huainan:m014-0097","start":97,"end":100,"surface":"廬江王","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-118-huainan:m014-0109","start":109,"end":112,"surface":"吳使者","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-118-huainan:m014-0116",