ind":"person","status":"contextual_provisional"},{"id":"c-jinshu-063-liju:p009:m0073","surface":"李瑰","start":73,"end":75,"person_id":"xk8_im6_nmj","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-063-liju:p009:m0076","surface":"段秀","start":76,"end":78,"person_id":"fyy_m5e_hv2","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-063-liju:p009:m0085","surface":"矩","start":85,"end":86,"person_id":"tqt_mih_3ao","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-063-liju:p009:m0093","surface":"矩","start":93,"end":94,"person_id":"tqt_mih_3ao","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-063-liju","book_id":"b-jinshu-063","work_id":"w-jinshu","source_id":"s-jinshu-063-liju-ws2025242"},{"id":"c-jinshu-068-hexun:p002","text":"趙王倫篡位，轉侍御史，辭疾去職。後除南中郎長史，不就，會逆賊李辰起兵江夏，征鎮不能討，皆望塵奔走。辰別帥石冰略有揚州，逐會稽相張景，以前寧遠護軍程超代之，以其長史宰與領山陰令。前南平內史王矩、吳興內史顧秘、前秀才周圮等唱義，傳檄州郡以討之，循亦合眾應之。冰大將抗寵有眾數千，屯郡講堂。循移檄於寵，為陳逆順，寵遂遁走，超、與皆降，一郡悉平。循迎景還郡，即謝遣兵士，杜門不出，論功報賞，一無豫焉。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":77,"last_line":77,"raw_start":8003,"raw_end":8201,"raw_character_offsets":[8005,8006,8007,8008,8009,8010,8011,8012,8013,8014,8015,8016,8017,8018,8019,8020,8021,8022,8023,8024,8025,8026,8027,8028,8029,8030,8031,8032,8033,8034,8035,8036,8037,8038,8039,8040,8041,8042,8043,8044,8045,8046,8047,8048,8049,8050,8051,8052,8053,8054,8055,8056,8057,8058,8059,8060,8061,8062,8063,8064,8065,8066,8067,8068,8069,8070,8071,8072,8073,8074,8075,8076,8077,8078,8079,8080,8081,8082,8083,8084,8085,8086,8087,8088,8089,8090,8091,8092,8093,8094,8095,8096,8097,8098,8099,8100,8101,8102,8103,8104,8105,8106,8107,8108,8109,8110,8111,8112,8113,8114,8115,8116,8117,8118,8119,8120,8121,8122,8123,8124,8125,8126,8127,8128,8129,8130,8131,8132,8133,8134,8135,8136,8137,8138,8139,8140,8141,8142,8143,8144,8145,8146,8147,8148,8149,8150,8151,8152,8153,8154,8155,8156,8157,8158,8159,8160,8161,8162,8163,8164,8165,8166,8167,8168,8169,8