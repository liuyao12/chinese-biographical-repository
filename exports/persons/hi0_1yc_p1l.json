ntions":[{"id":"c-jinshu-068-gurong:p003:m0039","surface":"馮熊","start":39,"end":41,"person_id":"hi0_1yc_p1l","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-068-gurong:p003","chapter_id":"c-jinshu-068-gurong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-068-gurong:p003","text":"齊王冏召為大司馬主簿。冏擅權驕恣，榮懼及禍，終日昏酣，不綜府事，以情告友人長樂馮熊。熊謂冏長史葛旟曰：「以顧榮為主簿，所以甄拔才望，委以事機，不復計南北親疏，欲平海內之心也。今府大事殷，非酒客之政。」旟曰：「榮江南望士，且居職日淺，不宜輕代易之。」熊曰：「可轉為中書侍郎，榮不失清顯，而府更收實才。」旟然之，白冏，以為中書侍郎。在職不復飲酒。人或問之曰：「何前醉而後醒邪？」榮懼罪，乃復更飲。與州里楊彥明書曰：「吾為齊王主簿，恆慮禍及，見刀與繩，每欲自殺，但人不知耳。」及旟誅，榮以討葛旟功，封喜興伯，轉太子中庶子。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":15,"last_line":15,"raw_start":438,"raw_end":698,"raw_character_offsets":[440,441,442,443,444,445,446,447,448,449,450,451,452,453,454,455,456,457,458,459,460,461,462,463,464,465,466,467,468,469,470,471,472,473,474,475,476,477,478,479,480,481,482,483,484,485,486,487,488,489,490,491,492,493,494,495,496,497,498,499,500,501,502,503,504,505,506,507,508,509,510,511,512,513,514,515,516,517,518,519,520,521,522,523,524,525,526,527,528,529,530,531,532,533,534,535,536,537,538,539,540,541,542,543,544,545,546,547,548,549,550,551,552,553,554,555,556,557,558,559,560,561,562,563,564,565,566,567,568,569,570,571,572,573,574,575,576,577,578,579,580,581,582,583,584,585,586,587,588,589,590,591,592,593,594,595,596,597,598,599,600,601,602,603,604,605,606,607,608,609,610,611,612,613,614,615,616,617,618,619,620,621,622,623,624,625,626,627,628,629,630,631,632,633,634,635,636,637,638,639,640,641,642,643,644,645,646,647,648,649,650,651,652,653,654,655,656,657,658,659,660,661,662,663,664,665,666,667,668,669,670,671,672,673,674,675,676,677,678,679,680,681,682,683,684,685,686,687,688,689,690,691,692,693,694,695,696,697],"revision_id":2581578}