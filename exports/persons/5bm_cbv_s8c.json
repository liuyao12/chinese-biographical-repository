"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji096-075","person_id":"5bm_cbv_s8c","scope":"same_chapter","chapter_ids":["c-shiji-096-zhang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["田文"],"evidence":[{"paragraph_id":"c-shiji-096-zhang:p025","quote":"邴丞相卒，黃丞相代。長安中有善相工田文者，與韋丞相、魏丞相、邴丞相微賤時會於客家，田文言曰：「今此三君者，皆丞相也。」其後三人竟更相代為丞相，何見之明也。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定短稱；韋賢與韋玄成分傳區別，第23段掾陳平另候選，第25段長安相工田文不與孟嘗君合併。趙堯、任敖、申屠嘉、鄧通、晁錯的短名依各段人物語境，王陵夫人與王陵分人。張蒼父長不滿五尺的長為身長敘述，不作父名。王侯與太子未詳名不補名，跨篇同指另待證據。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-096-zhang:p025","text":"邴丞相卒，黃丞相代。長安中有善相工田文者，與韋丞相、魏丞相、邴丞相微賤時會於客家，田文言曰：「今此三君者，皆丞相也。」其後三人竟更相代為丞相，何見之明也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhang:m025-0000","start":0,"end":3,"surface":"邴丞相","kind":"person","person_id":"69x_se2_859","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m025-0005","start":5,"end":8,"surface":"黃丞相","kind":"person","person_id":"kmo_vp5_qe1","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m025-0017","start":17,"end":19,"surface":"田文","kind":"person","person_id":"5bm_cbv_s8c","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m025-0022","start":22,"end":25,"surface":"韋丞相","kind":"person","person_id":"vna_am7_jn5","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m025-0026","start":26,"end":29,"surface":"魏丞相","kind":"person","person_id":"tin_46y_do7","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m025-0030","start":30,"end":33,"surface":"邴丞相","kind":"person","person_id":"69x_se2_859","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m025-0041","start":41,"end":43,"surface":"田文","kind":"person","person_id":"5bm_cbv_s8c","status":"contextual_provisional"}],"chapter_id":"c-shiji-096-zhang","book_id":"b-shiji