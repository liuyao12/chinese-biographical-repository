end":116,"surface":"衡陽王鈞","kind":"person","person_id":"47p_kjh_ez7_G","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-052-later-literature-complete","book_id":"b-nanqishu-052","work_id":"w-nanqishu","source_id":"s-nanqishu-052-later-literature-complete-ws2371079"},{"id":"c-nanqishu-052-later-literature-complete:p004","text":"　　初，智深爲司徒袁粲所接，及撰宋紀，意常依依。粲幼孤，祖母名其爲愍孫，後慕荀粲，自改名，會稽賀喬譏之，智深於是著論。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":82,"last_line":82,"raw_start":3943,"raw_end":4002,"raw_character_offsets":[3943,3944,3945,3946,3947,3948,3949,3950,3951,3952,3953,3954,3955,3956,3957,3958,3959,3960,3961,3962,3963,3964,3965,3966,3967,3968,3969,3970,3971,3972,3973,3974,3975,3976,3977,3978,3979,3980,3981,3982,3983,3984,3985,3986,3987,3988,3989,3990,3991,3992,3993,3994,3995,3996,3997,3998,3999,4000,4001],"revision_id":2371079},"mentions":[{"id":"c-nanqishu-052-later-literature-complete:p004:m0004","start":4,"end":6,"surface":"智深","kind":"person","person_id":"587_zrm_ktu","status":"contextual_provisional"},{"id":"c-nanqishu-052-later-literature-complete:p004:m0009","start":9,"end":11,"surface":"袁粲","kind":"person","person_id":"ez7_i28_72u","status":"contextual_provisional"},{"id":"c-nanqishu-052-later-literature-complete:p004:m0024","start":24,"end":25,"surface":"粲","kind":"person","person_id":"ez7_i28_72u","status":"contextual_provisional"},{"id":"c-nanqishu-052-later-literature-complete:p004:m0033","start":33,"end":35,"surface":"愍孫","kind":"person","person_id":"ez7_i28_72u","status":"contextual_provisional"},{"id":"c-nanqishu-052-later-literature-complete:p004:m0052","start":52,"end":54,"surface":"智深","kind":"person","person_id":"587_zrm_ktu","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-052-later-literature-complete","book_id":"b-nanqishu-052","work_id":"w-nanqishu","source_id":"s-nanqishu-052-later-literature-complete-ws2371079"}],"sources":[{"chapter_id":"c-nanqishu-052-later-literature-complete",