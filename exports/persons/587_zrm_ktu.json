ntion_ids":["c-nanqishu-052-later-literature-complete:p001:m0006"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-052-later-literature-complete:p001:m0055","mention_ids":["c-nanqishu-052-later-literature-complete:p001:m0055"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-052-later-literature-complete:p003:m0004","mention_ids":["c-nanqishu-052-later-literature-complete:p003:m0004"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-052-later-literature-complete:p003:m0025","mention_ids":["c-nanqishu-052-later-literature-complete:p003:m0025"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-052-later-literature-complete:p003:m0061","mention_ids":["c-nanqishu-052-later-literature-complete:p003:m0061"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-052-later-literature-complete:p003:m0092","mention_ids":["c-nanqishu-052-later-literature-complete:p003:m0092"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-052-later-literature-complete:p004:m0004","mention_ids":["c-nanqishu-052-later-literature-complete:p004:m0004"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-052-later-literature-complete:p004:m0052","mention_ids":["c-nanqishu-052-later-literature-complete:p004:m0052"],"kind":"paragraph"}],"mention_count":9,"duplicate_mention_count":0,"paragraph_occurrence_count":9,"table_occurrence_count":0,"passage_count":3,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"9處獨立位置，9個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-nanqishu-052-later-literature-complete-ws2371079"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-nanqishu-052-later-literature-complete:source_review1-0","kind":"source_review","person_id":"587_zrm_ktu","source_quote":"　　王智深字雲才，琅邪臨沂人也。少從陳郡謝超宗學屬文。好飲酒，拙澀乏風儀。宋建平王景素爲南徐州，作《觀法篇》，智深和之，見賞，辟爲西曹書佐。貧無衣，未到職而景素敗。後解褐爲州祭酒。太祖爲鎮軍時，丘巨源薦之於太祖，板爲府行參軍，除豫章王國常侍，遷太學博士，豫章王大司馬參軍，兼記室。","reading":"王智深字雲才，從謝超宗學文。景素辟而未到，丘巨源後薦於太祖。","note":"王智深字雲才，從謝超宗學文。景素辟而未到，丘巨源後薦於太祖。","paragraph_id":"c-nanqishu-052-later-literature-complete:p001","start_codepoint":0,"end_codepoint":140,"human_reviewed":false,"chapter_id":"c-nanqishu-052-later-literature-complete","source_id":"s-nanqishu-052-later-literature-complete-ws2371079"},{"id":"c-nanqishu-052-later-literature-complete:source_review2-0","kind":"source_review","person_id":"587_zrm_ktu","source_quote":"　　世祖使太子家令沈約撰《宋書》，擬立《袁粲傳》，以審世祖。世祖曰：「袁粲自是宋家忠臣。」約又多載孝武、明帝諸鄙瀆事，上遣左右謂約曰：「孝武事迹不容頓爾。我昔經事宋明帝，卿可思諱惡之義。」於是多所省除。","reading":"沈約編宋書與袁粲傳的討論作智深受詔之前的文史背景。","note":"沈約編宋書與袁粲傳的討論作智深受詔之前的文史背景。","paragraph_id":"c-nanqishu-052-later-literature-complete:p002","start_codepoint":0,"end_codepoint":101,"human_reviewed":false,"chapter_id":"c-nanqishu-052-later-literature-complete","source_id":"s-nanqishu-052-later-literature-complete-ws2371079"},{"id":"c-nanqishu-052-later-literature-complete:source_review3-0","kind":"source_review","person_id":"587_zrm_ktu","source_quote":"　　又敕智深撰《宋紀》，召見芙蓉堂，賜衣服，給宅。智深告貧於豫章王，王曰：「須卿書成，當相論以祿。」書成三十卷，世祖後召見智深於璿明殿，令拜表奏上。表未奏而世祖崩。隆昌元年，敕索其書，智深遷爲竟陵王司徒參軍，坐事免。江夏王鋒衡陽王鈞竝善待之。","reading":"智深《宋紀》三十卷。表未奏而世祖崩，隆昌元年索書。蕭鋒與蕭鈞各見。","note":"智深《宋紀》三十卷。表未奏而世祖崩，隆昌元年索書。蕭鋒與蕭鈞各見。","paragraph_id":"c-nanqishu-052-later-literature-complete:p003","start_codepoint":0,"end_codepoint":121,"human_reviewed":false,"chapter_id":"c-nanqishu-052-later-literature-complete","source_id":"s-nanqishu-052-later-literature-complete-ws2371079"},{"id":"c-nanqishu-052-later-literature-complete:source_review4-0","kind":"source_review","person_id":"587_zrm_ktu","source_quote":"　　初，智深爲司徒袁粲所接，及撰宋紀，意常依依。粲幼孤，祖母名其爲愍孫，後慕荀粲，自改名，會稽賀喬譏之，智深於是著論。","reading":"袁粲祖母取名愍孫、後自名粲。荀粲是所慕前人。該小敘由智深作論接續。","note":"袁粲祖母取名愍孫、後自名粲。荀粲是所慕前人。該小敘由智深作論接續。","paragraph_id":"c-nanqishu-052-later-literature-complete:p004","start_codepoint":0,"end_codepoint":59,"human_reviewed":false,"chapter_id":"c-nanqishu-052-later-literature-complete","source_id":"s-nanqishu-052-later-literature-complete-ws2371079"},{"id":"c-nanqishu-052-later-literature-complete:source_review5-0","kind":"source_review","person_id":"587_zrm_ktu","source_quote":"　　家貧無人事，嘗餓五日不得食，掘莧根食之。司空王僧虔及子志分其衣食。卒於家。","reading":"王僧虔及其子王志分給衣食。末「卒於家」仍回到智深。","note":"王僧虔及其子王志分給衣食。末「卒於家」仍回到智深。","paragraph_id":"c-nanqishu-052-later-literature-complete:p005","start_codepoint":0,"end_codepoint":39,"human_reviewed":false,"chapter_id":"c-nanqishu-052-later-literature-complete","source_id":"s-nanqishu-052-later-literature-complete-ws2371079"},{"id":"c-nanqishu-052-later-literature-complete:source_review5-35","kind":"source_review","person_id":"587_zrm_ktu","source_quote":"卒於家","reading":"承前段王智深；此段王僧虔及子志只分與衣食。","note":"承前段王智深；此段王僧虔及子志只分與衣食。","paragraph_id":"c-nanqishu-052-later-literature-complete:p005","start_codepoint":35,"end_codepoint":38,"human_reviewed":false,"chapter_id":"c-nanqishu-052-later-literature-complete","source_id":"s-nanqishu-052-later-literature-complete-ws2371079"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-052-later-literature-complete:p001:m0002","start":2,"end":5,"surface":"王智深","kind":"person","person_id":"587_zrm_ktu","status":"contextual_provisional","paragraph_id":"c-nanqishu-052-later-literature-complete:p001","chapter_id":"c-nanqishu-052-later-literature-complete"},{"id":"c-nanqishu-052-later-literature-complete:p001:m0006","start":6,"end":8,"surface":"雲才","kind":"person","person_id":"587_zrm_ktu","status":"contextual_provisional","paragraph_id":"c-nanqishu-052-later-literature-