":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-099-huanxuan:p003:m0032","start":32,"end":34,"surface":"蘇公","kind":"person","person_id":"hrl_307_u5r","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。","paragraph_id":"c-jinshu-099-huanxuan:p003","chapter_id":"c-jinshu-099-huanxuan"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-099-huanxuan:p003","text":"臣聞周公大聖而四國流言，樂毅王佐而被謗騎劫，《巷伯》有豺獸之慨，蘇公興飄風之刺，惡直醜正，何代無之！先臣蒙國殊遇，姻婭皇極，常欲以身報德，投袂乘機，西平巴蜀，北清伊洛，使竊號之寇系頸北闕，園陵修復，大恥載雪，飲馬灞滻懸旌趙魏，勤王之師，功非一捷。太和之末，皇基有潛移之懼，遂乃奉順天人，翼登聖朝，明離既朗，四凶兼澄。向使此功不建，此事不成，宗廟之事豈可孰念！昔太甲雖迷，商祚無憂；昌邑雖昏，弊無三孽。因茲而言，晉室之機危于殷漢，先臣之功高於伊霍矣。而負重既往，蒙謗清時，聖世明王黜陟之道，不聞廢忽顯明之功，探射冥冥之心，啟嫌謗之塗，開邪枉之路者也。先臣勤王艱難之勞，匡復克平之勳，朝廷若其遺之，臣亦不復計也。至於先帝龍飛九五，陛下之所以繼明南面，請問談者，誰之由邪？誰之德邪？豈惟晉室永安，祖宗血食，于陛下一門，實奇功也。","source_position":{"kind":"wikitext_codepoint_positions","raw_path":"sources/jinshu/wikisource-2644703-raw.wikitext","raw_start":547,"raw_end":910,"character_positions":[549,550,551,552,553,554,555,556,557,558,559,560,561,562,563,564,565,566,567,568,569,570,571,572,573,574,575,576,577,578,579,580,581,582,583,584,585,586,587,588,589,590,591,592,593,594,595,596,597,598,599,600,601,602,603,604,605,606,607,608,609,610,611,612,613,614,615,616,617,618,619,620,621,622,623,624,625,626,627,628,629,630,631,632,633,634,635,636,637,638,639,640,641,642,643,644,645,646,647,648,649,650,651,652,653,654,655,656,657,658,659,660,661,662,663,664,665,666,667,668,669,670,671,672,673,674,675,676,677,678,679,680,681,682,683,684,685,686,687,688,689,690,691,692,693,694,695,696,697,698,699,700,701,702,703,704,705,706,707,708,709,710,711,712,713,714,715,716,717,718,719,720,721,722,723,724,725,726,727,728,729,730,731,732,733,