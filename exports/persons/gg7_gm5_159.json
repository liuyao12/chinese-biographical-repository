{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"gg7_gm5_159","canonical_person_id":"gg7_gm5_159","id_aliases":["cbr-p004683"],"identity_policy":"contextual_provisional","person_ids":["gg7_gm5_159"],"persons":[{"id":"gg7_gm5_159","label":"管夷吾引古（魯仲連鄒陽列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"管夷吾","mention_ids":["c-shiji-083-luzou:m013-0027"]},{"surface":"管子","mention_ids":["c-shiji-083-luzou:m013-0077","c-shiji-083-luzou:m013-0121"]}],"evidence":[{"mention_id":"c-shiji-083-luzou:m013-0027","chapter_id":"c-shiji-083-luzou","paragraph_id":"c-shiji-083-luzou:p013","quote":"管夷吾"},{"mention_id":"c-shiji-083-luzou:m013-0077","chapter_id":"c-shiji-083-luzou","paragraph_id":"c-shiji-083-luzou:p013","quote":"管子"},{"mention_id":"c-shiji-083-luzou:m013-0121","chapter_id":"c-shiji-083-luzou","paragraph_id":"c-shiji-083-luzou:p013","quote":"管子"}],"id_aliases":["cbr-p004683"]}],"source_mention_summary":[{"source_id":"s-shiji-083-luzou","work_id":"w-shiji","book_id":"b-shiji-083","chapter_id":"c-shiji-083-luzou","mention_count":3,"mention_ids":["c-shiji-083-luzou:m013-0027","c-shiji-083-luzou:m013-0077","c-shiji-083-luzou:m013-0121"],"paragraph_ids":["c-shiji-083-luzou:p013"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-083-luzou"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-083-luzou:m013-0027","start":27,"end":30,"surface":"管夷吾","kind":"person","person_id":"gg7_gm5_159","status":"contextual_provisional","paragraph_id":"c-shiji-083-luzou:p013","chapter_id":"c-shiji-083-luzou"},{"id":"c-shiji-083-luzou:m013-0077","start":77,"end":79,"surface":"管子","kind":"person","person_id":"gg7_gm5_159","status":"contextual_provisional","paragraph_id":"c-shiji-083-luzou:p013","chapter_id":"c-shiji-083-luzou"},{"id":"c-shiji-083-luzou:m013-0121","start":121,"end":123,"surface":"管子","kind":"person","person_id":"gg7_gm5_159","status":"contextual_provisional","paragraph_id":"c-shiji-083-luzou:p013","chapter_id":"c-shiji-083-luzou"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji083-028","person_id":"gg7_gm5_159","scope":"same_chapter","chapter_ids":["c-shiji-083-luzou"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"依本段明示稱名與嵌套引古範圍暫定；未名者不以他篇或記憶直接補名。","surfaces":["管夷吾","管子"],"evidence":[{"paragraph_id":"c-shiji-083-luzou:p013","quote":"且吾聞之，規小睗者不能成榮名，惡小恥者不能立大功。昔者管夷吾射桓公中其鉤，篡也；遺公子糾不能死，怯也；束縛桎梏，辱也。若此三行者，世主不臣而鄉里不通。鄉使管子幽囚而不出，身死而不反於齊，則亦名不免為辱人賤行矣。臧獲且羞與之同名矣，況世俗乎！故管子不恥身在縲紲之中而恥天下之不治，不恥不死公子糾而恥威之不信於諸侯，故兼三行之過而為五霸首，名高天下而光燭鄰國。曹子為魯將，三戰三北，而亡地五百里。鄉使曹子計不反顧，議不還踵，刎頸而死，則亦名不免為敗軍禽將矣。曹子棄三北之恥，而退與魯君計。桓公朝天下，會諸侯，曹子以一劍之任，枝桓公之心於壇坫之上，顏色不變，辭氣不悖，三戰之所亡一朝而復之，天下震動，諸侯驚駭，威加吳、越。若此二士者，非不能成小廉而行小睗也，以為殺身亡軀，絕世滅後，功名不立，非智也。故去感忿之怨，立終身之名；棄忿悁之節，定累世之功。是以業與三王爭流，而名與天壤相獘也。願公擇一而行之。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-083-luzou:p013","text":"且吾聞之，規小睗者不能成榮名，惡小恥者不能立大功。昔者管夷吾射桓公中其鉤，篡也；遺公子糾不能死，怯也；束縛桎梏，辱也。若此三行者，世主不臣而鄉里不通。鄉使管子幽囚而不出，身死而不反於齊，則亦名不免為辱人賤行矣。臧獲且羞與之同名矣，況世俗乎！故管子不恥身在縲紲之中而恥天下之不治，不恥不死公子糾而恥威之不信於諸侯，故兼三行之過而為五霸首，名高天下而光燭鄰國。曹子為魯將，三戰三北，而亡地五百里。鄉使曹子計不反顧，議不還踵，刎頸而死，則亦名不免為敗軍禽將矣。曹子棄三北之恥，而退與魯君計。桓公朝天下，會諸侯，曹子以一劍之任，枝桓公之心於壇坫之上，顏色不變，辭氣不悖，三戰之所亡一朝而復之，天下震動，諸侯驚駭，威加吳、越。若此二士者，非不能成小廉而行小睗也，以為殺身亡軀，絕世滅後，功名不立，非智也。故去感忿之怨，立終身之名；棄忿悁之節，定累世之功。是以業與三王爭流，而名與天壤相獘也。願公擇一而行之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-083-luzou:m013-0027","start":27,"end":30,"surface":"管夷吾","kind":"person","person_id