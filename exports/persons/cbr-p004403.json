cbr-p004392","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m015-0007","start":7,"end":8,"surface":"王","kind":"person","person_id":"cbr-p004376","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m015-0016","start":16,"end":17,"surface":"王","kind":"person","person_id":"cbr-p004376","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m015-0022","start":22,"end":24,"surface":"樓緩","kind":"person","person_id":"cbr-p004403","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m015-0029","start":29,"end":30,"surface":"王","kind":"person","person_id":"cbr-p004376","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m015-0031","start":31,"end":32,"surface":"王","kind":"person","person_id":"cbr-p004376","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m015-0034","start":34,"end":36,"surface":"虞卿","kind":"person","person_id":"cbr-p004392","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m015-0039","start":39,"end":41,"surface":"樓緩","kind":"person","person_id":"cbr-p004403","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m015-0042","start":42,"end":44,"surface":"樓緩","kind":"person","person_id":"cbr-p004403","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m015-0051","start":51,"end":53,"surface":"虞卿","kind":"person","person_id":"cbr-p004392","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m015-0162","start":162,"end":164,"surface":"虞卿","kind":"person","person_id":"cbr-p004392","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m015-0174","start":174,"end":175,"surface":"王","kind":"person","person_id":"cbr-p004376","status":"contextual_provisional"}],"chapter_id":"c-shiji-076-pingyu","book_id":"b-shiji-076","work_id":"w-shiji","source_id":"s-shiji-076-pingyu"},{"id":"c-shiji-076-pingyu:p016","text":"虞卿聞之，往見王曰：「危哉樓子之所以爲秦者，是愈疑天下，而何慰秦之心哉？獨不言其示天下弱乎？且臣言勿予者，非固勿予而已也。秦索六城於王，而王以六城賂齊。齊，秦之深讎也，得王之六城，并力西擊秦，齊之聽王，不待辭之畢也。則是王失之於齊而取償於秦也。而齊、趙之深讎可以報矣，而示天下有能爲也。王以此發聲，兵未窺於境，臣見秦之重賂至趙而反媾於王也。從秦爲媾，韓、魏聞之，必盡重王；重王，必出重寶以先於王。則是王一舉而結三國之親，而與秦易道也。」趙王曰：「善。」則使虞卿東見齊王，與之謀秦。虞卿未返，秦使者已在趙矣。樓緩聞之，亡去。趙於是封虞卿以一城。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-076-pingyu:m016-0000","start":0,"end":2,"surface":"虞卿","kind":"person","person_id":"cbr-p004392","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m016-0007","start":7,"end":8,"surface":"王","kind":"person","person_id":"cbr-p004376","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m016-0013","start":13,"end":15,"surface":"樓子","kind":"person","person_id":"cbr-p004403","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m016-0066","start":66,"end":67,"surface":"王","kind":"person","person_id":"cbr-p004376","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m016-0069","start":69,"end":70,"surface":"王","kind":"person","person_id":"cbr-p004376","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m016-0085","start":85,"end":86,"surface":"王","kind":"person","person_id":"cbr-p004376","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m016-0099","start":99,"end":100,"surface":"王","kind":"person","person_id":"cbr-p004376","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m016-0110","start":110,"end":111,"surface":"王","kind":"person","person_id":"cbr-p004376","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m016-0143","start":143,"end":144,"surface":"王","kind":"person","person_id":"cbr-p004376","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m016-0167","start":167,"end":168,"surface":"王","kind":"person","person_id":"cbr-p004376","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m016-0184","start":184,"end":185,"surface":"王","kind":"person","person_id":"cbr-p004376","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m016-0187","start":187,"end":188,"surface":"王","kind":"person","person_id":"cbr-p004376","status":"contextual_provisional"},{"id":"c-shij