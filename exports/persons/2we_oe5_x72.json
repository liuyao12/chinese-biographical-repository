,"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-064-zhugeke-complete:p030:m0161","surface":"承","start":161,"end":162,"kind":"person","person_id":"2we_oe5_x72","status":"contextual_provisional","paragraph_id":"c-sanguozhi-064-zhugeke-complete:p030","chapter_id":"c-sanguozhi-064-zhugeke-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-064-zhugeke-complete:p030","text":"　　先是，童謠曰：「諸葛恪，蘆葦單衣蔑鉤落，於何相求成子閣。」成子閣者，反語石子岡也。建業面有長陵，名曰石子岡，葬者依焉。鉤落者，校飾革帶，世謂之鉤絡帶。恪果以葦席裹其身而篾束其腰，投之於此岡。恪長子綽，騎都尉，以交關魯王事，權遣付恪，令更教誨，恪鴆殺之。中子辣，長水校尉。少子建，步兵校尉。聞恪誅，車載其母而走。峻遣騎督承追斬竦於白都。建得渡江，欲北走魏，行數千里，為追兵所逮。恪外甥都鄉侯張震及常侍朱恩等，皆夷三族。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":53,"last_line":53,"raw_start":7261,"raw_end":7490,"raw_character_offsets":[7261,7262,7263,7264,7265,7266,7267,7268,7269,7270,7271,7272,7273,7274,7275,7276,7277,7278,7279,7280,7281,7282,7283,7284,7285,7286,7287,7288,7289,7290,7291,7292,7293,7294,7295,7296,7297,7298,7299,7300,7301,7302,7303,7304,7305,7306,7307,7308,7309,7310,7311,7312,7313,7314,7315,7316,7317,7318,7319,7320,7321,7322,7323,7324,7325,7326,7327,7328,7329,7330,7331,7332,7333,7334,7335,7336,7337,7338,7339,7340,7341,7342,7343,7344,7345,7346,7347,7348,7349,7350,7351,7352,7353,7354,7355,7356,7357,7377,7378,7379,7380,7381,7382,7383,7384,7385,7386,7387,7388,7389,7390,7391,7392,7393,7394,7395,7396,7397,7398,7399,7400,7401,7402,7403,7404,7405,7406,7407,7408,7409,7410,7411,7412,7413,7414,7415,7416,7417,7418,7419,7420,7421,7422,7423,7424,7425,7426,7427,7428,7429,7430,7431,7432,7433,7434,7435,7436,7437,7438,7439,7440,7441,7442,7443,7444,7445,7446,7447,7448,7449,7450,7451,7452,74