{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p005071","identity_policy":"contextual_provisional","person_ids":["cbr-p005071"],"persons":[{"id":"cbr-p005071","label":"秦嘉（黥布列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"秦嘉","mention_ids":["c-shiji-091-qingbu:m003-0011"]}],"evidence":[{"mention_id":"c-shiji-091-qingbu:m003-0011","chapter_id":"c-shiji-091-qingbu","paragraph_id":"c-shiji-091-qingbu:p003","quote":"秦嘉"}]}],"mentions":[{"id":"c-shiji-091-qingbu:m003-0011","start":11,"end":13,"surface":"秦嘉","kind":"person","person_id":"cbr-p005071","status":"contextual_provisional","paragraph_id":"c-shiji-091-qingbu:p003","chapter_id":"c-shiji-091-qingbu"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji091-012","person_id":"cbr-p005071","surfaces":["秦嘉"],"scope":"same_chapter","chapter_ids":["c-shiji-091-qingbu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-091-qingbu:p003","quote":"項梁涉淮而西，擊景駒、秦嘉等，布常冠軍。項梁至薛，聞陳王定死，迺立楚懷王。項梁號為武信君，英布為當陽君。項梁敗死定陶，懷王徙都彭城，諸將英布亦皆保聚彭城。當是時，秦急圍趙，趙數使人請救。懷王使宋義為上將，范曾為末將，項籍為次將，英布、蒲將軍皆為將軍，悉屬宋義，北救趙。及項籍殺宋義於河上，懷王因立籍為上將軍，諸將皆屬項籍。項籍使布先渡河擊秦，布數有利，籍迺悉引兵涉河從之，遂破秦軍，降章邯等。楚兵常勝，功冠諸侯。諸侯兵皆以服屬楚者，以布數以少敗眾也。"}],"rationale":"按明示姓名、姓氏與局部敘事暫接，短名不全域替換；番君及蒲將軍不補未見姓名，范曾原字保留。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-091-qingbu:p003","text":"項梁涉淮而西，擊景駒、秦嘉等，布常冠軍。項梁至薛，聞陳王定死，迺立楚懷王。項梁號為武信君，英布為當陽君。項梁敗死定陶，懷王徙都彭城，諸將英布亦皆保聚彭城。當是時，秦急圍趙，趙數使人請救。懷王使宋義為上將，范曾為末將，項籍為次將，英布、蒲將軍皆為將軍，悉屬宋義，北救趙。及項籍殺宋義於河上，懷王因立籍為上將軍，諸將皆屬項籍。項籍使布先渡河擊秦，布數有利，籍迺悉引兵涉河從之，遂破秦軍，降章邯等。楚兵常勝，功冠諸侯。諸侯兵皆以服屬楚者，以布數以少敗眾也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-091-qingbu:m003-0000","start":0,"end":2,"surface":"項梁","kind":"person","person_id":"cbr-p005068","status":"contextual_provisional"},{"id":"c-shiji-091-qingbu:m003-0008","start":8,"end":10,"surface":"