se},"family_paths":[],"mentions":[{"id":"c-jinshu-057-ma-long:p003:m0051","surface":"成奚","start":51,"end":53,"person_id":"71d_7ws_kvr","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-057-ma-long:p003","chapter_id":"c-jinshu-057-ma-long"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-057-ma-long:p003","text":"太康初，朝廷以西平荒毀，宜時興復，以隆為平虜護軍、西平太守，將所領精兵，又給牙門一軍，屯據西平。時南虜成奚每為邊患，隆至，帥軍討之。虜據險距守，隆令軍士皆負農器，將若田者。虜以隆無征討意，禦眾稍怠。隆因其無備，進兵擊破之。畢隆之政，不敢為寇。太熙初，封奉高縣侯，加授東羌校尉。積十餘年，威信震於隴右。時略陽太守馮翊嚴舒與楊駿通親，蜜圖代隆，毀隆年老謬耄，不宜服戎，於是征隆，以舒代鎮。氏、羌聚結，百姓驚懼。朝廷恐關隴復擾，乃免舒，遣隆復職，竟卒於官。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":34,"last_line":34,"raw_start":2546,"raw_end":2771,"raw_character_offsets":[2546,2547,2548,2549,2550,2551,2552,2553,2554,2555,2556,2557,2558,2559,2560,2561,2562,2563,2564,2565,2566,2567,2568,2569,2570,2571,2572,2573,2574,2575,2576,2577,2578,2579,2580,2581,2582,2583,2584,2585,2586,2587,2588,2589,2590,2591,2592,2593,2594,2595,2596,2597,2598,2599,2600,2601,2602,2603,2604,2605,2606,2607,2608,2609,2610,2611,2612,2613,2614,2615,2616,2617,2618,2619,2620,2621,2622,2623,2624,2625,2626,2627,2628,2629,2630,2631,2632,2633,2634,2635,2636,2637,2638,2639,2640,2641,2642,2643,2644,2645,2646,2647,2648,2649,2650,2651,2652,2653,2654,2655,2656,2657,2658,2659,2660,2661,2662,2663,2664,2665,2666,2667,2668,2669,2670,2671,2672,2673,2674,2675,2676,2677,2678,2679,2680,2681,2682,2683,2684,2685,2686,2687,2688,2689,2690,2691,2692,2693,2694,2695,2696,2697,2698,2699,2700,2701,2702,2703,2704,2705,2706,2707,2708,2709,2710,2711,2712,2713,2714,2715,2716,2717,2718,2719,2720,2721,2722,2723,2724,2725,2726,2727,2728,2729,2730,2731,2732,2733,2734,2735,2736,2737,2738,2739,2740,2741,2742,2743,2744,2745,2746,2747,2748,2749,2750,2751,2752,2753,2754,2755,2756,27