gyaoer-cai:p001:m0000","object_person_mention_id":"c-chenshu-016-zhangyaoer-cai:p001:m0015","relationship_anchor":{"paragraph_id":"c-chenshu-016-zhangyaoer-cai:p001","surface":"祖點","start":14,"end":16}}],"status":"source_attested","interpretation_note":"蔡景歷祖點。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"a-nan012-zhangyaoer-p-father","subject_person_id":"3iw_d6v_459_A","object_person_id":"3iw_d6v_459","predicate":"father","qualifiers":{"source_term":"父大同","nan012_zhangyaoer_reading":"p-father","lineage":"paternal"},"evidence":[{"work_id":"w-chenshu","book_id":"b-chenshu-016","source_id":"s-chenshu-016-zhangyaoer-cai-ws2261985","chapter_id":"c-chenshu-016-zhangyaoer-cai","paragraph_id":"c-chenshu-016-zhangyaoer-cai:p001","quote":"蔡景歷字茂世，濟陽考城人也。祖點，梁尚書左民侍郎。父大同，輕車岳陽王記室參軍，掌京邑行選。","subject_person_mention_id":"c-chenshu-016-zhangyaoer-cai:p001:m0000","object_person_mention_id":"c-chenshu-016-zhangyaoer-cai:p001:m0026","relationship_anchor":{"paragraph_id":"c-chenshu-016-zhangyaoer-cai:p001","surface":"父大同","start":25,"end":28}}],"status":"source_attested","interpretation_note":"蔡景歷本傳明載父大同。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-chenshu-007-zhangyaoer:p002","text":"高祖自廣州南征交阯，命后與衡陽王昌隨世祖由海道歸于長城。侯景之亂，高祖下至豫章，后為景所囚。景平，而高祖為長城縣公，后拜夫人。及高祖踐祚，永定元年立為皇后。追贈后父景明特進、金紫光祿大夫，加金章紫綬，拜后母蘇安吉縣君。二年，安吉君卒，與后父合葬吳興。明年，追封后父為廣德縣侯，邑五百戶，謚曰溫。高祖崩，后與中書舍人蔡景歷定計，祕不發喪，召世祖入纂，事在蔡景歷及侯安都傳。世祖即位，尊后為皇太后，宮曰慈訓。廢帝即位，尊后為太皇太后。光大二年，后下令黜廢帝為臨海王，命高宗嗣位。太建元年，尊后為皇太后。二年三月景申，崩于紫極殿，時年六十五。遺令喪事所須，並從儉約，諸有饋奠，不得用牲牢。其年四月，羣臣上謚曰宣太后，祔葬萬安陵。","mentions":[{"id":"c-chenshu-007-zhangyaoer:p002:m0016","surface":"昌","start":16,"end":17,"person_id":"3eu_ixs_h1w_B","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-chenshu-007-zha