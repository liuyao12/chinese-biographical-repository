,11611,11612,11613,11614,11615,11616,11617,11618,11619,11620,11621,11622,11623,11624,11625,11626,11629,11632,11633,11634,11635,11636,11637,11638,11639,11640,11641,11642,11643,11644,11645,11646,11647,11648,11649,11650,11651,11652,11653,11654,11655,11656,11657,11658,11659,11660,11661,11662,11663,11664,11665,11666,11667,11668,11669,11670,11671,11672,11673,11674,11675,11676,11677,11678,11679,11680,11681,11682,11683,11684,11685,11686,11687,11688,11689,11690,11691,11692,11693,11694,11695,11696,11697,11698,11699,11700,11701,11702,11703,11704,11705,11706,11707,11708,11709,11710,11711,11712,11713,11714,11715,11716,11717,11718,11719,11720,11721,11722,11723,11724,11725,11726,11727,11728,11729,11730,11731,11732,11733,11734,11735,11736,11737,11738,11739,11740,11741,11742,11743,11744,11745,11746,11747,11748]},"chapter_id":"c-sanguozhi-052-buzhi-complete","book_id":"b-sanguozhi-052","work_id":"w-sanguozhi","source_id":"s-sanguozhi-052-buzhi-complete"},{"id":"c-sanguozhi-053-chengbing:line027","text":"　　程秉字德樞，汝南南頓人也。逮事鄭玄，後避亂交州，與劉熙考論大義，遂博通五經。士燮命為長史。權聞其名儒，以禮徵，秉既到，拜太子太傅。黃武四年，權為太子登娉周瑜女，秉守太常，迎妃於吳，權親幸秉船，深見優禮。既還，秉從容進說登曰：「婚姻人倫之始，王教之基，是以聖王重之，所以率先眾庶，風化天下，故《詩》美《關睢》，以為稱首。願太子尊禮教於閨房，存《周南》之所詠，則道化隆於上，頌聲作於下矣。」登笑曰：「將順其美，匡救其惡，誠所賴於傅君也。」病卒官。著《周易摘》《尚書駁》《論語弼》，凡三萬餘言。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-053-chengbing:line027:m0002","start":2,"end":4,"surface":"程秉","kind":"person","person_id":"eus_x4z_ogu","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-chengbing:line027:m0005","start":5,"end":7,"surface":"德樞","kind":"person","person_id":"eus_x4z_ogu","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-chengbing:line027:m0017","start":17,"end":19,"surface":"鄭玄","kind":"person","person_id":"95f_p0e_7s8","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-chengbing:line027:m0027","start":27,"end":29,"surface":"劉熙","kind":"person","person_id":"4j2_9t6_